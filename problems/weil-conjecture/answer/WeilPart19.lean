      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [← hω_a, ← hω_a', h_ω_split_a, h_ω_split_a',
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_aw_eq]

  
  let 𝒜_amb := MvPolynomial.homogeneousSubmodule (Fin (m + 3)) k
  let _ : GradedAlgebra 𝒜_amb := MvPolynomial.gradedAlgebra
  let ι₂ : Fin 2 → Fin (m + 3) := Fin.cases 0 (fun _ => 1)
  let a₀ : Fin (m + 3) := ι₂ c
  let c' : Fin 2 := 1 - c
  let a₁ : Fin (m + 3) := ι₂ c'
  have hc' : c' ≠ c := by
    dsimp only [c']
    fin_cases c <;> decide
  have hj_eq_c' : ∀ j : {j : Fin 2 // j ≠ c}, j.1 = c' := by
    rintro ⟨j, hj⟩
    dsimp only [c']
    revert hj
    fin_cases c <;> fin_cases j <;> decide
  have hι₂_0_val : (ι₂ 0).val = 0 := rfl
  have hι₂_1_val : (ι₂ 1).val = 1 := by
    have h1 : (1 : Fin 2) = Fin.succ 0 := rfl
    rw [h1]
    dsimp only [ι₂]
    rw [Fin.cases_succ, Fin.val_one', Nat.mod_eq_of_lt (by omega)]
  have hι₂_inj : Function.Injective ι₂ := by
    intro i₁ i₂ h
    have hv := congrArg Fin.val h
    fin_cases i₁ <;> fin_cases i₂
    · rfl
    · simp [hι₂_0_val, hι₂_1_val] at hv
    · simp [hι₂_0_val, hι₂_1_val] at hv
    · rfl
  have ha₁₀ : a₁ ≠ a₀ := fun h => hc' (hι₂_inj h)

  let D_c : P_amb.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X a₀)
  let R_c := MvPolynomial {j : Fin 2 // j ≠ c} k
  let S_c := AlgebraicGeometry.Spec (CommRingCat.of R_c)
  let π_Rc : S_c ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
  let e_Wc : (W_c : AlgebraicGeometry.Scheme.{u}) ≅ S_c := iso_proj 1 c
  have hWc_hom : W_c.ι ≫ P_1.hom = e_Wc.hom ≫ π_Rc := (h_proj_spec 1 c).2.2.2.2.1

  obtain ⟨h_pre_pr, h_le, g_hom, hsub, hX_amb, hX_1, hg_ring, h_chart⟩ := hPr.2 c
  have h_le' : D_c ≤ U_k := h_le
  have h_range_γ : Set.range ((γ_k ⁻¹ᵁ Q_c).ι ≫ U_k.ι).base = Set.range D_c.ι.base := by
    ext x
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    constructor
    · rintro ⟨v, rfl⟩
      have hv1 : (γ_k ≫ CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom).base v.1 ∈ W_c := v.2
      rw [CategoryTheory.Limits.pullback.lift_snd] at hv1
      have hv2 : v.1 ∈ (TopologicalSpace.Opens.map pr_k.base).obj W_c := hv1
      rw [h_pre_pr] at hv2
      exact hv2
    · intro hxD
      have hxU : x ∈ U_k := h_le' hxD
      let u : ↥(U_k : AlgebraicGeometry.Scheme.{u}) := ⟨x, hxU⟩
      have hu1 : u ∈ (TopologicalSpace.Opens.map U_k.ι.base).obj D_c := hxD
      rw [← h_pre_pr] at hu1
      have hu2 : u ∈ γ_k ⁻¹ᵁ Q_c := by
        change (γ_k ≫ CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom).base u ∈ W_c
        rw [CategoryTheory.Limits.pullback.lift_snd]
        exact hu1
      exact ⟨⟨u, hu2⟩, rfl⟩
  let e_γ : ((γ_k ⁻¹ᵁ Q_c) : AlgebraicGeometry.Scheme.{u}) ≅
      (D_c : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ((γ_k ⁻¹ᵁ Q_c).ι ≫ U_k.ι) D_c.ι h_range_γ
  have he_γ_fac : e_γ.inv ≫ (γ_k ⁻¹ᵁ Q_c).ι ≫ U_k.ι = D_c.ι :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac
      ((γ_k ⁻¹ᵁ Q_c).ι ≫ U_k.ι) D_c.ι h_range_γ
  have he_γ_le : e_γ.inv ≫ (γ_k ⁻¹ᵁ Q_c).ι = P_amb.left.homOfLE h_le' := by
    rw [← CategoryTheory.cancel_mono U_k.ι, CategoryTheory.Category.assoc, he_γ_fac]
    exact (P_amb.left.homOfLE_ι h_le').symm
  have hγ_fst : e_γ.inv ≫ (γ_k ∣_ Q_c) ≫ Q_c.ι ≫
      CategoryTheory.Limits.pullback.fst P_amb.hom P_1.hom = D_c.ι := by
    rw [← CategoryTheory.Category.assoc (γ_k ∣_ Q_c),
      AlgebraicGeometry.morphismRestrict_ι γ_k Q_c,
      CategoryTheory.Category.assoc (γ_k ⁻¹ᵁ Q_c).ι,
      CategoryTheory.Limits.pullback.lift_fst, he_γ_fac]
  let P_a₀ := MvPolynomial {b : Fin (m + 3) // b ≠ a₀} k
  let iso_Dc : (D_c : AlgebraicGeometry.Scheme.{u}) ≅
      AlgebraicGeometry.Spec (CommRingCat.of P_a₀) :=
    iso_proj (m + 2) a₀
  let κ_c : R_c →+* P_a₀ :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (fun j => MvPolynomial.X ⟨ι₂ j.1, fun h => j.2 (hι₂_inj h)⟩)
  have hγ_snd : e_γ.inv ≫ (γ_k ∣_ Q_c) ≫
      ((CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ∣_ W_c) ≫ e_Wc.hom =
      iso_Dc.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_c) := by
    let iso0_amb : (D_c : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_amb (MvPolynomial.X a₀))) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X a₀) hX_amb zero_lt_one
    let iso0_1 : (W_c : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X c))) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X c) hX_1 zero_lt_one
    have h_mid : e_γ.inv ≫ (γ_k ∣_ Q_c) ≫
        ((CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ∣_ W_c) =
        iso0_amb.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map g_hom hsub)) ≫
          iso0_1.inv := by
      rw [← CategoryTheory.cancel_mono W_c.ι]
      calc (e_γ.inv ≫ (γ_k ∣_ Q_c) ≫
              ((CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ∣_ W_c)) ≫ W_c.ι
          = e_γ.inv ≫ (γ_k ∣_ Q_c) ≫
              (((CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ∣_ W_c) ≫ W_c.ι) := by
            simp only [CategoryTheory.Category.assoc]
        _ = e_γ.inv ≫ ((γ_k ∣_ Q_c) ≫ Q_c.ι) ≫
              CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom := by
            rw [AlgebraicGeometry.morphismRestrict_ι
              (CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) W_c,
              CategoryTheory.Category.assoc (γ_k ∣_ Q_c)]
        _ = (e_γ.inv ≫ (γ_k ⁻¹ᵁ Q_c).ι) ≫ pr_k := by
            rw [AlgebraicGeometry.morphismRestrict_ι γ_k Q_c,
              CategoryTheory.Category.assoc (γ_k ⁻¹ᵁ Q_c).ι,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc]
        _ = P_amb.left.homOfLE h_le' ≫ pr_k := by rw [he_γ_le]
        _ = (iso0_amb.hom ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.map g_hom hsub)) ≫
              iso0_1.inv) ≫ W_c.ι := by
            simp only [CategoryTheory.Category.assoc]
            exact h_chart
    obtain ⟨hC_1, hX_1_eq, hhom_1, _, _, _⟩ := h_proj_spec 1 c
    obtain ⟨hC_amb, hX_amb_eq, hhom_amb, _, _, _⟩ := h_proj_spec (m + 2) a₀
    have h_eWc_hom : e_Wc.hom =
        iso0_1.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_proj 1 c).toRingHom) :=
      hhom_1
    have h_iso_amb_hom : iso_Dc.hom =
        iso0_amb.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_proj (m + 2) a₀).toRingHom) :=
      hhom_amb
    calc e_γ.inv ≫ (γ_k ∣_ Q_c) ≫
            ((CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ∣_ W_c) ≫ e_Wc.hom
        = (e_γ.inv ≫ (γ_k ∣_ Q_c) ≫
            ((CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ∣_ W_c)) ≫ e_Wc.hom := by
          simp only [CategoryTheory.Category.assoc]
      _ = (iso0_amb.hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.map g_hom hsub)) ≫
            iso0_1.inv) ≫
          (iso0_1.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_proj 1 c).toRingHom)) := by
          rw [h_mid, h_eWc_hom]
      _ = iso0_amb.hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                ((HomogeneousLocalization.map g_hom hsub).comp (e_proj 1 c).toRingHom)) := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc iso0_1.inv, iso0_1.inv_hom_id,
            CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp]
      _ = iso0_amb.hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((e_proj (m + 2) a₀).toRingHom.comp κ_c)) := by
          congr 3
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro x
            apply HomogeneousLocalization.val_injective
            change ((HomogeneousLocalization.map g_hom hsub)
                ((hProjChart 1 c).choose (MvPolynomial.C x))).val =
              ((hProjChart (m + 2) a₀).choose (κ_c (MvPolynomial.C x))).val
            have hκC : κ_c (MvPolynomial.C x) = MvPolynomial.C x := by
              dsimp only [κ_c]; rw [MvPolynomial.eval₂Hom_C]
            rw [hκC, hC_1 x, hC_amb x]
            change ((HomogeneousLocalization.map g_hom hsub) (HomogeneousLocalization.mk _)).val =
              (HomogeneousLocalization.mk _).val
            rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
              HomogeneousLocalization.val_mk]
            dsimp only
            congr 1
            · change g_hom.toRingHom (MvPolynomial.C x) = MvPolynomial.C x
              rw [hg_ring]
              exact MvPolynomial.rename_C _ x
            · apply Subtype.ext
              exact map_one g_hom.toRingHom
          · intro j
            apply HomogeneousLocalization.val_injective
            change ((HomogeneousLocalization.map g_hom hsub)
                ((hProjChart 1 c).choose (MvPolynomial.X j))).val =
              ((hProjChart (m + 2) a₀).choose (κ_c (MvPolynomial.X j))).val
            have hκX : κ_c (MvPolynomial.X j) =
                MvPolynomial.X ⟨ι₂ j.1, fun h => j.2 (hι₂_inj h)⟩ := by
              dsimp only [κ_c]; rw [MvPolynomial.eval₂Hom_X']
            rw [hκX, hX_1_eq j, hX_amb_eq ⟨ι₂ j.1, fun h => j.2 (hι₂_inj h)⟩]
            dsimp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.mk]
            rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
              HomogeneousLocalization.val_mk]
            dsimp only
            congr 1
            · change g_hom.toRingHom (MvPolynomial.X j.1 ^ 1) = MvPolynomial.X (ι₂ j.1) ^ 1
              rw [hg_ring, map_pow]
              exact congrArg (· ^ 1) (MvPolynomial.rename_X _ j.1)
            · apply Subtype.ext
              dsimp only
              change g_hom.toRingHom (MvPolynomial.X c ^ 1) = MvPolynomial.X a₀ ^ 1
              rw [hg_ring, map_pow]
              exact congrArg (· ^ 1) (MvPolynomial.rename_X _ c)
      _ = iso_Dc.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_c) := by
          rw [h_iso_amb_hom, CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  
  let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hPullChart : ∀ {X : AlgebraicGeometry.Scheme.{u}} (f_X : X ⟶ S₀)
      (U : X.Opens) {σ : Type}
      (eU : (U : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ k)))
      (hU_hom : U.ι ≫ f_X =
        eU.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)),
      let W : (CategoryTheory.Limits.pullback π_Rc f_X).Opens :=
        (CategoryTheory.Limits.pullback.snd π_Rc f_X) ⁻¹ᵁ U
      ∃ eW : (W : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R_c)),
        (eW.inv ≫ W.ι ≫ CategoryTheory.Limits.pullback.fst π_Rc f_X =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
        (eW.inv ≫ W.ι ≫ CategoryTheory.Limits.pullback.snd π_Rc f_X =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
            eU.inv ≫ U.ι) := by
    intro X f_X U σ eU hU_hom
    let W : (CategoryTheory.Limits.pullback π_Rc f_X).Opens :=
      (CategoryTheory.Limits.pullback.snd π_Rc f_X) ⁻¹ᵁ U
    have sq_top :=
      AlgebraicGeometry.isPullback_morphismRestrict
        (CategoryTheory.Limits.pullback.snd π_Rc f_X) U
    have sq_bot := (CategoryTheory.IsPullback.of_hasPullback π_Rc f_X).flip
    have sq_W : CategoryTheory.IsPullback
        ((CategoryTheory.Limits.pullback.snd π_Rc f_X) ∣_ U)
        (W.ι ≫ CategoryTheory.Limits.pullback.fst π_Rc f_X)
        (U.ι ≫ f_X) π_Rc :=
      sq_top.paste_vert sq_bot
    let π_σ : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ k)) ⟶ S₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial σ k)))
    have hU_hom' : eU.hom ≫ π_σ = (U.ι ≫ f_X) ≫ 𝟙 S₀ := by
      rw [CategoryTheory.Category.comp_id]
      exact hU_hom.symm
    have _ : CategoryTheory.IsIso eU.hom := eU.isIso_hom
    have sq_eU : CategoryTheory.IsPullback eU.hom (U.ι ≫ f_X) π_σ (𝟙 S₀) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨hU_hom'⟩
    have sq_pasted := sq_W.paste_horiz sq_eU
    rw [CategoryTheory.Category.comp_id] at sq_pasted
    have sq_aff : CategoryTheory.IsPullback
        (W.ι ≫ CategoryTheory.Limits.pullback.fst π_Rc f_X)
        (((CategoryTheory.Limits.pullback.snd π_Rc f_X) ∣_ U) ≫ eU.hom)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_c)))
        π_σ := sq_pasted.flip
    let iso_pb := sq_aff.isoPullback
    let iso_spec := AlgebraicGeometry.pullbackSpecIso k R_c (MvPolynomial σ k)
    let algEq := MvPolynomial.algebraTensorAlgEquiv k R_c (σ := σ)
    let iso_alg : AlgebraicGeometry.Spec
          (CommRingCat.of (TensorProduct k R_c (MvPolynomial σ k))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R_c)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h1 : algEq.symm.toRingHom.comp algEq.toRingHom = RingHom.id _ :=
            RingHom.ext algEq.symm_apply_apply
          rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h1 : algEq.toRingHom.comp algEq.symm.toRingHom = RingHom.id _ :=
            RingHom.ext algEq.apply_symm_apply
          rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let eW := iso_pb ≪≫ iso_spec ≪≫ iso_alg
    have heW_fst : eW.inv ≫ W.ι ≫ CategoryTheory.Limits.pullback.fst π_Rc f_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      dsimp only [eW, Iso.trans_inv, iso_alg]
      calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              (iso_spec.inv ≫ iso_pb.inv) ≫ W.ι ≫ CategoryTheory.Limits.pullback.fst π_Rc f_X
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              iso_spec.inv ≫ (iso_pb.inv ≫ (W.ι ≫ CategoryTheory.Limits.pullback.fst π_Rc f_X)) := by
            simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              (iso_spec.inv ≫
                CategoryTheory.Limits.pullback.fst
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_c))) π_σ) := by
            rw [sq_aff.isoPullback_inv_fst]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
            rw [AlgebraicGeometry.pullbackSpecIso_inv_fst]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            congr 2
            apply RingHom.ext
            intro r
            change algEq (r ⊗ₜ[k] (1 : MvPolynomial σ k)) = MvPolynomial.C r
            rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_one, Algebra.smul_def]
            simp [MvPolynomial.algebraMap_eq]
    have heW_snd : eW.inv ≫ W.ι ≫ CategoryTheory.Limits.pullback.snd π_Rc f_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
          eU.inv ≫ U.ι := by
      have hW_snd : W.ι ≫ CategoryTheory.Limits.pullback.snd π_Rc f_X =
          (((CategoryTheory.Limits.pullback.snd π_Rc f_X) ∣_ U) ≫ eU.hom) ≫ eU.inv ≫ U.ι := by
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc eU.hom,
          eU.hom_inv_id, CategoryTheory.Category.id_comp,
          AlgebraicGeometry.morphismRestrict_ι]
      dsimp only [eW, Iso.trans_inv, iso_alg]
      calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              (iso_spec.inv ≫ iso_pb.inv) ≫ W.ι ≫ CategoryTheory.Limits.pullback.snd π_Rc f_X
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              iso_spec.inv ≫
                (iso_pb.inv ≫ (((CategoryTheory.Limits.pullback.snd π_Rc f_X) ∣_ U) ≫ eU.hom)) ≫
                eU.inv ≫ U.ι := by
            rw [hW_snd]
            simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              (iso_spec.inv ≫
                CategoryTheory.Limits.pullback.snd
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_c))) π_σ) ≫
              eU.inv ≫ U.ι := by
            rw [sq_aff.isoPullback_inv_snd, ← CategoryTheory.Category.assoc iso_spec.inv]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)) ≫
              eU.inv ≫ U.ι := by
            rw [AlgebraicGeometry.pullbackSpecIso_inv_snd,
              ← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom algEq.toRingHom))]
            rfl
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
              eU.inv ≫ U.ι := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            congr 3
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro x
              change algEq ((1 : R_c) ⊗ₜ[k] MvPolynomial.C x) =
                (MvPolynomial.map MvPolynomial.C) (MvPolynomial.C x)
              rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul, MvPolynomial.map_C,
                MvPolynomial.map_C]
              rfl
            · intro s
              change algEq ((1 : R_c) ⊗ₜ[k] MvPolynomial.X s) =
                (MvPolynomial.map MvPolynomial.C) (MvPolynomial.X s)
              rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul, MvPolynomial.map_X,
                MvPolynomial.map_X]
    exact ⟨eW, heW_fst, heW_snd⟩

  
  have hLocIso : ∀ {X : AlgebraicGeometry.Scheme.{u}} (V U : X.Opens) (hUV : U ≤ V)
      {R : Type u} [CommRing R]
      (eV : (V : AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec (CommRingCat.of R))
      (f : R)
      (hmem : ∀ p : AlgebraicGeometry.Spec (CommRingCat.of R),
        (eV.inv ≫ V.ι).base p ∈ U ↔ f ∉ p.asIdeal),
      ∃ eU : (U : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)),
        eU.inv ≫ U.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f))) ≫
            eV.inv ≫ V.ι := by
    intro X V U hUV R _ eV f hmem
    let locMap : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f)))
    have _ : AlgebraicGeometry.IsOpenImmersion locMap :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization f
    let j_f : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) ⟶ X :=
      locMap ≫ eV.inv ≫ V.ι
    have _ : AlgebraicGeometry.IsOpenImmersion j_f := by
      dsimp only [j_f]
      infer_instance
    have h_range : Set.range U.ι.base = Set.range j_f.base := by
      ext x
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      constructor
      · intro hxU
        have hxV : x ∈ V := hUV hxU
        let p : AlgebraicGeometry.Spec (CommRingCat.of R) := eV.hom.base ⟨x, hxV⟩
        have hp_inv : eV.inv.base p = ⟨x, hxV⟩ := by
          dsimp only [p]
          exact ConcreteCategory.congr_hom (eV.hom_inv_id ▸ rfl :
            (eV.hom ≫ eV.inv).base = 𝟙 _) ⟨x, hxV⟩
        have hp_base : (eV.inv ≫ V.ι).base p = x := by
          change V.ι.base (eV.inv.base p) = x
          rw [hp_inv]
          rfl
        let p' : PrimeSpectrum R := p
        have hf_p : p' ∈ (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)) := by
          rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
          change f ∉ p.asIdeal
          rw [← hmem p, hp_base]
          exact hxU
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away f) f] at hf_p
        obtain ⟨q, hq⟩ := hf_p
        refine ⟨q, ?_⟩
        change (eV.inv ≫ V.ι).base (PrimeSpectrum.comap (algebraMap R (Localization.Away f)) q) = x
        rw [hq]
        exact hp_base
      · rintro ⟨q, rfl⟩
        change (eV.inv ≫ V.ι).base (locMap.base q) ∈ U
        rw [hmem (locMap.base q)]
        intro hf_mem
        have h_unit_mem : algebraMap R (Localization.Away f) f ∈ q.asIdeal := hf_mem
        exact q.isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem q.asIdeal h_unit_mem
            (IsLocalization.Away.algebraMap_isUnit f))
    let eU := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq U.ι j_f h_range
    exact ⟨eU, AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac U.ι j_f h_range⟩

  
  let E'_c := CategoryTheory.Limits.pullback π_Rc P_fib.hom
  let Q'_c := CategoryTheory.Limits.pullback π_Rc P_amb.hom
  let A : Fin (m + 2) → Type u := fun q => MvPolynomial {p : Fin (m + 2) // p ≠ q} R_c
  let B_ring : Fin (m + 3) → Type u := fun a => MvPolynomial {b : Fin (m + 3) // b ≠ a} R_c
  let 𝒜_fib := MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k
  let _ : GradedAlgebra 𝒜_fib := MvPolynomial.gradedAlgebra
  let U_fib : Fin (m + 2) → P_fib.left.Opens :=
    fun q => AlgebraicGeometry.Proj.basicOpen 𝒜_fib (MvPolynomial.X q)
  let U_amb : Fin (m + 3) → P_amb.left.Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X a)
  let V' : Fin (m + 2) → E'_c.Opens :=
    fun q => (CategoryTheory.Limits.pullback.snd π_Rc P_fib.hom) ⁻¹ᵁ U_fib q
  let W_tilde : Fin (m + 3) → Q'_c.Opens :=
    fun a => (CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom) ⁻¹ᵁ U_amb a

  have hU_fib_cov : (⨆ q : Fin (m + 2), U_fib q) = (⊤ : P_fib.left.Opens) :=
    hProjCov (m + 1)
  have hU_amb_cov : (⨆ a : Fin (m + 3), U_amb a) = (⊤ : P_amb.left.Opens) :=
    hProjCov (m + 2)

  have hV'_cov : (⨆ q : Fin (m + 2), V' q) = ⊤ := by
    ext z
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hz : (CategoryTheory.Limits.pullback.snd π_Rc P_fib.hom).base z ∈
        (⨆ q : Fin (m + 2), U_fib q) := by
      rw [hU_fib_cov]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hz
    exact TopologicalSpace.Opens.mem_iSup.mpr hz

  have hV'_mem : ∀ z : E'_c, ∃ q : Fin (m + 2), z ∈ V' q := by
    intro z
    have hz : z ∈ (⨆ q : Fin (m + 2), V' q) := by
      rw [hV'_cov]
      trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hz

  have hW_cov : (⨆ a : Fin (m + 3), W_tilde a) = ⊤ := by
    ext z
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hz : (CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom).base z ∈
        (⨆ a : Fin (m + 3), U_amb a) := by
      rw [hU_amb_cov]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hz
    exact TopologicalSpace.Opens.mem_iSup.mpr hz

  let hV_data (q : Fin (m + 2)) :=
    hPullChart P_fib.hom (U_fib q) (iso_proj (m + 1) q)
      (h_proj_spec (m + 1) q).2.2.2.2.1
  let e_V (q : Fin (m + 2)) :
      (V' q : AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec (CommRingCat.of (A q)) :=
    (hV_data q).choose
  have he_V_fst (q : Fin (m + 2)) :
      (e_V q).inv ≫ (V' q).ι ≫ CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
    (hV_data q).choose_spec.1
  have he_V_snd (q : Fin (m + 2)) :
      (e_V q).inv ≫ (V' q).ι ≫ CategoryTheory.Limits.pullback.snd π_Rc P_fib.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
          (iso_proj (m + 1) q).inv ≫ (U_fib q).ι :=
    (hV_data q).choose_spec.2

  let hW_data (a : Fin (m + 3)) :=
    hPullChart P_amb.hom (U_amb a) (iso_proj (m + 2) a)
      (h_proj_spec (m + 2) a).2.2.2.2.1
  let e_W (a : Fin (m + 3)) :
      (W_tilde a : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (B_ring a)) :=
    (hW_data a).choose
  have he_W_fst (a : Fin (m + 3)) :
      (e_W a).inv ≫ (W_tilde a).ι ≫ CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
    (hW_data a).choose_spec.1
  have he_W_snd (a : Fin (m + 3)) :
      (e_W a).inv ≫ (W_tilde a).ι ≫ CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
          (iso_proj (m + 2) a).inv ≫ (U_amb a).ι :=
    (hW_data a).choose_spec.2

  have hV'_pre : ∀ (q₁ q₂ : Fin (m + 2)) (hq : q₂ ≠ q₁)
      (p : AlgebraicGeometry.Spec (CommRingCat.of (A q₁))),
      ((e_V q₁).inv ≫ (V' q₁).ι).base p ∈ V' q₂ ↔
        MvPolynomial.X ⟨q₂, hq⟩ ∉ p.asIdeal := by
    intro q₁ q₂ hq p
    change ((e_V q₁).inv ≫ (V' q₁).ι ≫
        CategoryTheory.Limits.pullback.snd π_Rc P_fib.hom).base p ∈ U_fib q₂ ↔ _
    rw [he_V_snd q₁]
    let mapC := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom
        (MvPolynomial.map (MvPolynomial.C : k →+* R_c) :
          MvPolynomial {p : Fin (m + 2) // p ≠ q₁} k →+* A q₁))
    change ((iso_proj (m + 1) q₁).inv ≫
        (AlgebraicGeometry.Proj.basicOpen 𝒜_fib (MvPolynomial.X q₁) :
          (weilProjectiveSpaceOver k (m + 1)).left.Opens).ι).base (mapC.base p) ∈
      (AlgebraicGeometry.Proj.basicOpen 𝒜_fib (MvPolynomial.X q₂) :
        (weilProjectiveSpaceOver k (m + 1)).left.Opens) ↔ _
    rw [(h_proj_spec (m + 1) q₁).2.2.2.2.2 q₂ hq (mapC.base p)]
    dsimp only [mapC]
    rw [hSpecNotMem, MvPolynomial.map_X]

  have hV'_trans : ∀ (q₁ q₂ : Fin (m + 2)) (hq : q₂ ≠ q₁),
      let x_q₂ : A q₁ := MvPolynomial.X ⟨q₂, hq⟩
      let τ_E : A q₂ →+* Localization.Away x_q₂ :=
        MvPolynomial.eval₂Hom ((algebraMap (A q₁) (Localization.Away x_q₂)).comp MvPolynomial.C)
          (fun p => if hp : p.1 = q₁ then
            IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂
          else
            algebraMap (A q₁) (Localization.Away x_q₂) (MvPolynomial.X ⟨p.1, hp⟩) *
              IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂)
      AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (A q₁) (Localization.Away x_q₂))) ≫
        (e_V q₁).inv ≫ (V' q₁).ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_E) ≫
        (e_V q₂).inv ≫ (V' q₂).ι := by
    intro q₁ q₂ hq
    dsimp only
    let x_q₂ : A q₁ := MvPolynomial.X ⟨q₂, hq⟩
    let τ_E : A q₂ →+* Localization.Away x_q₂ :=
      MvPolynomial.eval₂Hom ((algebraMap (A q₁) (Localization.Away x_q₂)).comp MvPolynomial.C)
        (fun p => if hp : p.1 = q₁ then
          IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂
        else
          algebraMap (A q₁) (Localization.Away x_q₂) (MvPolynomial.X ⟨p.1, hp⟩) *
            IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂)
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        he_V_fst q₁, he_V_fst q₂,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro r
      change algebraMap (A q₁) (Localization.Away x_q₂) (MvPolynomial.C r) =
        τ_E (MvPolynomial.C r)
      dsimp only [τ_E]
      rw [MvPolynomial.eval₂Hom_C]
      rfl
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        he_V_snd q₁, he_V_snd q₂]
      let P_q₁ := MvPolynomial {p : Fin (m + 2) // p ≠ q₁} k
      let y_q₂ : P_q₁ := MvPolynomial.X ⟨q₂, hq⟩
      let g_lift : P_q₁ →+* Localization.Away x_q₂ :=
        (algebraMap (A q₁) (Localization.Away x_q₂)).comp (MvPolynomial.map MvPolynomial.C)
      have hg_y : g_lift y_q₂ = algebraMap (A q₁) (Localization.Away x_q₂) x_q₂ := by
        change algebraMap (A q₁) (Localization.Away x_q₂)
          ((MvPolynomial.map MvPolynomial.C) (MvPolynomial.X ⟨q₂, hq⟩)) = _
        rw [MvPolynomial.map_X]
      have hu_y : IsUnit (g_lift y_q₂) := by
        rw [hg_y]
        exact IsLocalization.Away.algebraMap_isUnit x_q₂
      obtain ⟨μ, hμ_alg, hμ_inv0⟩ := hAwayLift y_q₂ g_lift hu_y
      have hμ_inv : μ (IsLocalization.Away.invSelf (S := Localization.Away y_q₂) y_q₂) =
          IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂ := by
        rw [hμ_inv0]
        apply hu_y.mul_right_inj.mp
        rw [IsUnit.mul_val_inv, hg_y, IsLocalization.Away.mul_invSelf]
      have hg_fac : g_lift = μ.comp (algebraMap P_q₁ (Localization.Away y_q₂)) :=
        RingHom.ext fun P => (hμ_alg P).symm
      let τ_fib : MvPolynomial {p : Fin (m + 2) // p ≠ q₂} k →+* Localization.Away y_q₂ :=
        MvPolynomial.eval₂Hom ((algebraMap P_q₁ (Localization.Away y_q₂)).comp MvPolynomial.C)
          (fun b => if hb : b.1 = q₁ then
            IsLocalization.Away.invSelf (S := Localization.Away y_q₂) y_q₂
          else
            algebraMap P_q₁ (Localization.Away y_q₂) (MvPolynomial.X ⟨b.1, hb⟩) *
              IsLocalization.Away.invSelf (S := Localization.Away y_q₂) y_q₂)
      have h_tr_fib :
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap P_q₁ (Localization.Away y_q₂))) ≫
            (iso_proj (m + 1) q₁).inv ≫ (U_fib q₁).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_fib) ≫
            (iso_proj (m + 1) q₂).inv ≫ (U_fib q₂).ι :=
        hProjTrans (m + 1) q₁ q₂ hq
      calc AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (A q₁) (Localization.Away x_q₂))) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
              (iso_proj (m + 1) q₁).inv ≫ (U_fib q₁).ι
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_lift) ≫
              (iso_proj (m + 1) q₁).inv ≫ (U_fib q₁).ι := by
            rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ) ≫
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap P_q₁ (Localization.Away y_q₂))) ≫
              (iso_proj (m + 1) q₁).inv ≫ (U_fib q₁).ι) := by
            rw [hg_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_fib) ≫
              (iso_proj (m + 1) q₂).inv ≫ (U_fib q₂).ι) := by
            rw [h_tr_fib]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_E) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
              (iso_proj (m + 1) q₂).inv ≫ (U_fib q₂).ι := by
            rw [← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ)),
              ← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_E)),
              ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            congr 3
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro x
              change μ (τ_fib (MvPolynomial.C x)) =
                τ_E ((MvPolynomial.map MvPolynomial.C) (MvPolynomial.C x))
              dsimp only [τ_fib]
              rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hμ_alg, MvPolynomial.map_C]
              dsimp only [g_lift, τ_E]
              rw [RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
              rfl
            · intro p
              change μ (τ_fib (MvPolynomial.X p)) =
                τ_E ((MvPolynomial.map MvPolynomial.C) (MvPolynomial.X p))
              dsimp only [τ_fib, τ_E]
              rw [MvPolynomial.eval₂Hom_X', MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
              split_ifs with hp
              · exact hμ_inv
              · rw [map_mul, hμ_alg, hμ_inv]
                dsimp only [g_lift]
                rw [RingHom.comp_apply, MvPolynomial.map_X]

  
  let σ_c : Fin (m + 2) → Fin (m + 3) := Fin.cases a₀ (fun r => r.succ.succ)
  let π_idx : Fin (m + 3) → Fin (m + 2) := Fin.cases 0 (Fin.cases 0 (fun r => r.succ))
  have hc_cases : c = 0 ∨ c = 1 := by
    fin_cases c
    · exact Or.inl rfl
    · exact Or.inr rfl
  have h1_eq_succ0 : (1 : Fin (m + 3)) = Fin.succ 0 := by
    ext
    rw [Fin.val_one', Nat.mod_eq_of_lt (by omega), Fin.val_succ, Fin.val_zero]
  have hι₂_1_eq : ι₂ 1 = 1 := by
    have h1 : (1 : Fin 2) = Fin.succ 0 := rfl
    rw [h1]
    dsimp only [ι₂]
    rw [Fin.cases_succ]
  have hπ_σ : ∀ p : Fin (m + 2), π_idx (σ_c p) = p := by
    intro p
    refine Fin.cases ?_ (fun r => ?_) p
    · change π_idx (ι₂ c) = 0
      rcases hc_cases with h_c0 | h_c1
      · rw [h_c0]; rfl
      · rw [h_c1, hι₂_1_eq, h1_eq_succ0]
        dsimp only [π_idx]
        rw [Fin.cases_succ, Fin.cases_zero]
    · dsimp only [σ_c, π_idx]
      rw [Fin.cases_succ, Fin.cases_succ, Fin.cases_succ]
  have hσ_inj : Function.Injective σ_c := Function.LeftInverse.injective hπ_σ
  have ha₁_lt : a₁.val < 2 := by
    change (ι₂ (1 - c)).val < 2
    rcases hc_cases with h_c0 | h_c1
    · rw [h_c0]
      have hsub0 : (1 - (0 : Fin 2)) = 1 := rfl
      rw [hsub0, hι₂_1_val]
      omega
    · rw [h_c1]
      have hsub1 : (1 - (1 : Fin 2)) = 0 := rfl
      rw [hsub1, hι₂_0_val]
      omega
  have hσ_ne_a₁ : ∀ p : Fin (m + 2), σ_c p ≠ a₁ := by
    intro p
    refine Fin.cases ?_ (fun r => ?_) p
    · exact ha₁₀.symm
    · intro h
      have hv := congrArg Fin.val h
      dsimp only [σ_c] at hv
      rw [Fin.cases_succ, Fin.val_succ, Fin.val_succ] at hv
      omega
  have h_dichot : ∀ b : Fin (m + 3), b = a₁ ∨ σ_c (π_idx b) = b := by
    intro b
    refine Fin.cases ?_ (fun b₁ => Fin.cases ?_ (fun r => ?_) b₁) b
    · dsimp only [π_idx]
      rw [Fin.cases_zero]
      change (0 : Fin (m + 3)) = ι₂ (1 - c) ∨ ι₂ c = 0
      rcases hc_cases with h_c0 | h_c1
      · rw [h_c0]; exact Or.inr rfl
      · rw [h_c1]; exact Or.inl rfl
    · dsimp only [π_idx]
      rw [Fin.cases_succ, Fin.cases_zero, ← h1_eq_succ0]
      change (1 : Fin (m + 3)) = ι₂ (1 - c) ∨ ι₂ c = 1
      rcases hc_cases with h_c0 | h_c1
      · rw [h_c0]
        have hsub0 : (1 - (0 : Fin 2)) = 1 := rfl
        rw [hsub0, hι₂_1_eq]
        exact Or.inl rfl
      · rw [h_c1, hι₂_1_eq]
        exact Or.inr rfl
    · dsimp only [π_idx, σ_c]
      rw [Fin.cases_succ, Fin.cases_succ, Fin.cases_succ]
      exact Or.inr rfl

  let u_c : R_c := MvPolynomial.X ⟨c', hc'⟩
  let ξ (q p : Fin (m + 2)) : A q :=
    if hp : p = q then 1 else MvPolynomial.X ⟨p, hp⟩
  let θ (q : Fin (m + 2)) :
      MvPolynomial {b : Fin (m + 3) // b ≠ σ_c q} k →+* A q :=
    MvPolynomial.eval₂Hom (MvPolynomial.C.comp MvPolynomial.C)
      (fun b => if b.1 = a₁ then MvPolynomial.C u_c * ξ q 0 else ξ q (π_idx b.1))
  have hθ_C : ∀ (q : Fin (m + 2)) (x : k),
      θ q (MvPolynomial.C x) = MvPolynomial.C (MvPolynomial.C x) := by
    intro q x; dsimp only [θ]; rw [MvPolynomial.eval₂Hom_C]; rfl
  have hθ_X : ∀ (q : Fin (m + 2)) (b : {b : Fin (m + 3) // b ≠ σ_c q}),
      θ q (MvPolynomial.X b) =
        if b.1 = a₁ then MvPolynomial.C u_c * ξ q 0 else ξ q (π_idx b.1) := by
    intro q b; dsimp only [θ]; rw [MvPolynomial.eval₂Hom_X']

  let φ'_chart (q : Fin (m + 2)) : (V' q : AlgebraicGeometry.Scheme.{u}) ⟶ P_amb.left :=
    (e_V q).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ q)) ≫
      (iso_proj (m + 2) (σ_c q)).inv ≫ (U_amb (σ_c q)).ι

  have hφ'_chart_hom : ∀ q : Fin (m + 2),
      φ'_chart q ≫ P_amb.hom =
        (V' q).ι ≫ CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom ≫ π_Rc := by
    intro q
    have _ : CategoryTheory.IsIso (e_V q).inv := (e_V q).isIso_inv
    rw [← CategoryTheory.cancel_epi (e_V q).inv]
    let e_amb : (U_amb (σ_c q) : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec
          (CommRingCat.of (MvPolynomial {b : Fin (m + 3) // b ≠ σ_c q} k)) :=
      iso_proj (m + 2) (σ_c q)
    have h_amb_hom0 : (U_amb (σ_c q)).ι ≫ P_amb.hom =
        e_amb.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
      (h_proj_spec (m + 2) (σ_c q)).2.2.2.2.1
    have h_amb_hom1 : (e_amb.inv ≫ (U_amb (σ_c q)).ι) ≫ P_amb.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      rw [CategoryTheory.Category.assoc, h_amb_hom0,
        ← CategoryTheory.Category.assoc, e_amb.inv_hom_id,
        CategoryTheory.Category.id_comp]
    have h_amb_hom :
        ((iso_proj (m + 2) (σ_c q)).inv ≫ (U_amb (σ_c q)).ι) ≫ P_amb.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
      h_amb_hom1
    calc (e_V q).inv ≫ φ'_chart q ≫ P_amb.hom
        = ((e_V q).inv ≫ (e_V q).hom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ q)) ≫
            (((iso_proj (m + 2) (σ_c q)).inv ≫ (U_amb (σ_c q)).ι) ≫ P_amb.hom) := by
          dsimp only [φ'_chart]
          simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((θ q).comp MvPolynomial.C)) := by
          rw [(e_V q).inv_hom_id, CategoryTheory.Category.id_comp, h_amb_hom,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = ((e_V q).inv ≫ (V' q).ι ≫ CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom) ≫ π_Rc := by
          rw [he_V_fst q]
          dsimp only [π_Rc]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          congr 2
          apply RingHom.ext
          intro x
          exact hθ_C q x
      _ = (e_V q).inv ≫ (V' q).ι ≫ CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom ≫ π_Rc := by
          simp only [CategoryTheory.Category.assoc]

  
  let 𝒰_E := E'_c.openCoverOfIsOpenCover V' (TopologicalSpace.IsOpenCover.mk hV'_cov)
  have hφ'_ov : ∀ q₁₀ q₂₀ : 𝒰_E.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰_E.f q₁₀) (𝒰_E.f q₂₀) ≫ φ'_chart q₁₀ =
        CategoryTheory.Limits.pullback.snd (𝒰_E.f q₁₀) (𝒰_E.f q₂₀) ≫ φ'_chart q₂₀ := by
    intro q₁₀ q₂₀
    let q₁ : Fin (m + 2) := q₁₀
    let q₂ : Fin (m + 2) := q₂₀
    change CategoryTheory.Limits.pullback.fst (V' q₁).ι (V' q₂).ι ≫ φ'_chart q₁ =
      CategoryTheory.Limits.pullback.snd (V' q₁).ι (V' q₂).ι ≫ φ'_chart q₂
    by_cases hq_eq : q₂ = q₁
    · subst hq_eq
      have h_fst_snd :
          CategoryTheory.Limits.pullback.fst (V' q₂).ι (V' q₂).ι =
            CategoryTheory.Limits.pullback.snd (V' q₂).ι (V' q₂).ι :=
        (CategoryTheory.cancel_mono (V' q₂).ι).mp CategoryTheory.Limits.pullback.condition
      rw [h_fst_snd]
    · let x_q₂ : A q₁ := MvPolynomial.X ⟨q₂, hq_eq⟩
      let V_inter : E'_c.Opens := V' q₁ ⊓ V' q₂
      have h_inter_mem : ∀ p : AlgebraicGeometry.Spec (CommRingCat.of (A q₁)),
          ((e_V q₁).inv ≫ (V' q₁).ι).base p ∈ V_inter ↔ x_q₂ ∉ p.asIdeal := by
        intro p
        have hp_q₁ : ((e_V q₁).inv ≫ (V' q₁).ι).base p ∈ V' q₁ := by
          rw [← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨(e_V q₁).inv.base p, rfl⟩
        change ((e_V q₁).inv ≫ (V' q₁).ι).base p ∈ V' q₁ ∧
          ((e_V q₁).inv ≫ (V' q₁).ι).base p ∈ V' q₂ ↔ _
        rw [and_iff_right hp_q₁]
        exact hV'_pre q₁ q₂ hq_eq p
      obtain ⟨e_inter, he_inter_ι⟩ :=
        hLocIso (V' q₁) V_inter inf_le_left (e_V q₁) x_q₂ h_inter_mem
      let pb_ι : CategoryTheory.Limits.pullback (V' q₁).ι (V' q₂).ι ⟶ E'_c :=
        CategoryTheory.Limits.pullback.fst (V' q₁).ι (V' q₂).ι ≫ (V' q₁).ι
      have h_pb_range : Set.range pb_ι.base = Set.range V_inter.ι.base := by
        ext z
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        constructor
        · rintro ⟨w, rfl⟩
          have hz1 : pb_ι.base w ∈ V' q₁ := by
            rw [← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨(CategoryTheory.Limits.pullback.fst (V' q₁).ι (V' q₂).ι).base w, rfl⟩
          have hz2 : pb_ι.base w ∈ V' q₂ := by
            have hcond : pb_ι =
                CategoryTheory.Limits.pullback.snd (V' q₁).ι (V' q₂).ι ≫ (V' q₂).ι :=
              CategoryTheory.Limits.pullback.condition
            rw [hcond, ← SetLike.mem_coe, ← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨(CategoryTheory.Limits.pullback.snd (V' q₁).ι (V' q₂).ι).base w, rfl⟩
          exact ⟨hz1, hz2⟩
        · intro hz
          let i₁ : (V_inter : AlgebraicGeometry.Scheme.{u}) ⟶ (V' q₁ : AlgebraicGeometry.Scheme.{u}) :=
            E'_c.homOfLE (inf_le_left : V_inter ≤ V' q₁)
          let i₂ : (V_inter : AlgebraicGeometry.Scheme.{u}) ⟶ (V' q₂ : AlgebraicGeometry.Scheme.{u}) :=
            E'_c.homOfLE (inf_le_right : V_inter ≤ V' q₂)
          have hi_comm : i₁ ≫ (V' q₁).ι = i₂ ≫ (V' q₂).ι := by
            rw [AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι]
          let lift_inter := CategoryTheory.Limits.pullback.lift i₁ i₂ hi_comm
          refine ⟨lift_inter.base ⟨z, hz⟩, ?_⟩
          have h_comp : lift_inter ≫ pb_ι = V_inter.ι := by
            dsimp only [pb_ι]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              AlgebraicGeometry.Scheme.homOfLE_ι]
          exact congrArg (fun f : (V_inter : AlgebraicGeometry.Scheme.{u}) ⟶ E'_c =>
            f.base ⟨z, hz⟩) h_comp
      let e_pb := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq pb_ι V_inter.ι h_pb_range
      let e_ov := e_pb ≪≫ e_inter
      have _ : CategoryTheory.IsIso e_ov.inv := e_ov.isIso_inv
      rw [← CategoryTheory.cancel_epi e_ov.inv]
      have he_ov_ι : e_ov.inv ≫ pb_ι =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (A q₁) (Localization.Away x_q₂))) ≫
            (e_V q₁).inv ≫ (V' q₁).ι := by
        dsimp only [e_ov, Iso.trans_inv]
        rw [CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac pb_ι V_inter.ι h_pb_range,
          he_inter_ι]
      have he_ov_fst : e_ov.inv ≫ CategoryTheory.Limits.pullback.fst (V' q₁).ι (V' q₂).ι =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (A q₁) (Localization.Away x_q₂))) ≫
            (e_V q₁).inv := by
        rw [← CategoryTheory.cancel_mono (V' q₁).ι, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc]
        exact he_ov_ι
      let τ_E : A q₂ →+* Localization.Away x_q₂ :=
        MvPolynomial.eval₂Hom ((algebraMap (A q₁) (Localization.Away x_q₂)).comp MvPolynomial.C)
          (fun p => if hp : p.1 = q₁ then
            IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂
          else
            algebraMap (A q₁) (Localization.Away x_q₂) (MvPolynomial.X ⟨p.1, hp⟩) *
              IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂)
      have he_ov_snd : e_ov.inv ≫ CategoryTheory.Limits.pullback.snd (V' q₁).ι (V' q₂).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_E) ≫ (e_V q₂).inv := by
        rw [← CategoryTheory.cancel_mono (V' q₂).ι, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition]
        have htr := hV'_trans q₁ q₂ hq_eq
        dsimp only at htr
        exact he_ov_ι.trans htr
      have hτ_ξ : ∀ p : Fin (m + 2),
          τ_E (ξ q₂ p) =
            algebraMap (A q₁) (Localization.Away x_q₂) (ξ q₁ p) *
              IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂ := by
        intro p
        dsimp only [ξ]
        by_cases hp₂ : p = q₂
        · rw [hp₂]
          simp only [eq_self, ↓reduceDIte, hq_eq, map_one]
          exact (IsLocalization.Away.mul_invSelf x_q₂).symm
        · simp only [hp₂, ↓reduceDIte]
          dsimp only [τ_E]
          rw [MvPolynomial.eval₂Hom_X']
          split_ifs with hp₁
          · rw [map_one, one_mul]
          · rfl
      have hσ_neq : σ_c q₂ ≠ σ_c q₁ := fun h => hq_eq (hσ_inj h)
      let P_σ₁ := MvPolynomial {b : Fin (m + 3) // b ≠ σ_c q₁} k
      let z_σ₂ : P_σ₁ := MvPolynomial.X ⟨σ_c q₂, hσ_neq⟩
      let g_amb : P_σ₁ →+* Localization.Away x_q₂ :=
        (algebraMap (A q₁) (Localization.Away x_q₂)).comp (θ q₁)
      have hg_amb_z : g_amb z_σ₂ = algebraMap (A q₁) (Localization.Away x_q₂) x_q₂ := by
        change algebraMap (A q₁) (Localization.Away x_q₂)
          (θ q₁ (MvPolynomial.X ⟨σ_c q₂, hσ_neq⟩)) = _
        rw [hθ_X q₁]
        simp only [hσ_ne_a₁ q₂, ↓reduceIte, hπ_σ q₂, ξ, hq_eq, ↓reduceDIte]
        rfl
      have hu_amb_z : IsUnit (g_amb z_σ₂) := by
        rw [hg_amb_z]
        exact IsLocalization.Away.algebraMap_isUnit x_q₂
      obtain ⟨μ_amb, hμ_amb_alg, hμ_amb_inv0⟩ := hAwayLift z_σ₂ g_amb hu_amb_z
      have hμ_amb_inv :
          μ_amb (IsLocalization.Away.invSelf (S := Localization.Away z_σ₂) z_σ₂) =
            IsLocalization.Away.invSelf (S := Localization.Away x_q₂) x_q₂ := by
        rw [hμ_amb_inv0]
        apply hu_amb_z.mul_right_inj.mp
        rw [IsUnit.mul_val_inv, hg_amb_z, IsLocalization.Away.mul_invSelf]
      have hg_amb_fac : g_amb = μ_amb.comp (algebraMap P_σ₁ (Localization.Away z_σ₂)) :=
        RingHom.ext fun P => (hμ_amb_alg P).symm
      let τ_amb : MvPolynomial {b : Fin (m + 3) // b ≠ σ_c q₂} k →+*
          Localization.Away z_σ₂ :=
        MvPolynomial.eval₂Hom ((algebraMap P_σ₁ (Localization.Away z_σ₂)).comp MvPolynomial.C)
          (fun b => if hb : b.1 = σ_c q₁ then
            IsLocalization.Away.invSelf (S := Localization.Away z_σ₂) z_σ₂
          else
            algebraMap P_σ₁ (Localization.Away z_σ₂) (MvPolynomial.X ⟨b.1, hb⟩) *
              IsLocalization.Away.invSelf (S := Localization.Away z_σ₂) z_σ₂)
      have h_tr_amb :
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap P_σ₁ (Localization.Away z_σ₂))) ≫
            (iso_proj (m + 2) (σ_c q₁)).inv ≫ (U_amb (σ_c q₁)).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_amb) ≫
            (iso_proj (m + 2) (σ_c q₂)).inv ≫ (U_amb (σ_c q₂)).ι :=
        hProjTrans (m + 2) (σ_c q₁) (σ_c q₂) hσ_neq
      rw [← CategoryTheory.Category.assoc e_ov.inv,
        ← CategoryTheory.Category.assoc e_ov.inv, he_ov_fst, he_ov_snd]
      dsimp only [φ'_chart]
      calc (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (A q₁) (Localization.Away x_q₂))) ≫
              (e_V q₁).inv) ≫
              (e_V q₁).hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ q₁)) ≫
              (iso_proj (m + 2) (σ_c q₁)).inv ≫ (U_amb (σ_c q₁)).ι
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_amb) ≫
              (iso_proj (m + 2) (σ_c q₁)).inv ≫ (U_amb (σ_c q₁)).ι := by
            rw [CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc (e_V q₁).inv, (e_V q₁).inv_hom_id,
              CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_amb) ≫
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap P_σ₁ (Localization.Away z_σ₂))) ≫
              (iso_proj (m + 2) (σ_c q₁)).inv ≫ (U_amb (σ_c q₁)).ι) := by
            rw [hg_amb_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_amb) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_amb) ≫
              (iso_proj (m + 2) (σ_c q₂)).inv ≫ (U_amb (σ_c q₂)).ι) := by
            rw [h_tr_amb]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_E) ≫ (e_V q₂).inv) ≫
              (e_V q₂).hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ q₂)) ≫
              (iso_proj (m + 2) (σ_c q₂)).inv ≫ (U_amb (σ_c q₂)).ι := by
            rw [CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_E)),
              ← CategoryTheory.Category.assoc (e_V q₂).inv, (e_V q₂).inv_hom_id,
              CategoryTheory.Category.id_comp,
              ← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_amb)),
              ← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_E)),
              ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            congr 3
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro x
              change μ_amb (τ_amb (MvPolynomial.C x)) =
                τ_E (θ q₂ (MvPolynomial.C x))
              dsimp only [τ_amb]
              rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hμ_amb_alg, hθ_C q₂]
              dsimp only [g_amb, τ_E]
              rw [RingHom.comp_apply, hθ_C q₁, MvPolynomial.eval₂Hom_C]
              rfl
            · intro b
              change μ_amb (τ_amb (MvPolynomial.X b)) =
                τ_E (θ q₂ (MvPolynomial.X b))
              dsimp only [τ_amb]
              rw [MvPolynomial.eval₂Hom_X', hθ_X q₂]
              by_cases hb_a₁ : b.1 = a₁
              · have hb_ne_σ₁ : b.1 ≠ σ_c q₁ := by
                  rw [hb_a₁]
                  exact (hσ_ne_a₁ q₁).symm
                simp only [hb_ne_σ₁, ↓reduceDIte]
                simp only [hb_a₁, ↓reduceIte, map_mul, hμ_amb_alg, hμ_amb_inv, hτ_ξ 0]
                dsimp only [g_amb, τ_E]
                rw [RingHom.comp_apply, hθ_X q₁]
                simp only [↓reduceIte, map_mul, mul_assoc]
                rw [MvPolynomial.eval₂Hom_C]
                rfl
              · simp only [hb_a₁, ↓reduceIte]
                have hb_σ : σ_c (π_idx b.1) = b.1 :=
                  (h_dichot b.1).resolve_left hb_a₁
                split_ifs with hb_σ₁
                · have hp_q₁ : π_idx b.1 = q₁ := by
                    rw [hb_σ₁, hπ_σ]
                  rw [hμ_amb_inv, hp_q₁, hτ_ξ q₁]
                  dsimp only [ξ]
                  simp only [↓reduceDIte, map_one, one_mul]
                · rw [map_mul, hμ_amb_alg, hμ_amb_inv, hτ_ξ (π_idx b.1)]
                  dsimp only [g_amb]
                  rw [RingHom.comp_apply, hθ_X q₁]
                  simp only [hb_a₁, ↓reduceIte]

  let φ'_c : E'_c ⟶ P_amb.left := 𝒰_E.glueMorphisms φ'_chart hφ'_ov
  have hφ'_ι : ∀ q : Fin (m + 2), (V' q).ι ≫ φ'_c = φ'_chart q :=
    fun q => 𝒰_E.ι_glueMorphisms φ'_chart hφ'_ov q
  have hφ'_hom : CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom ≫ π_Rc =
      φ'_c ≫ P_amb.hom := by
    apply 𝒰_E.hom_ext
    intro q
    change (V' q).ι ≫ (CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom ≫ π_Rc) =
      (V' q).ι ≫ (φ'_c ≫ P_amb.hom)
    rw [← CategoryTheory.Category.assoc (V' q).ι φ'_c, hφ'_ι q, hφ'_chart_hom q]

  let Φ'_c : E'_c ⟶ Q'_c :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom) φ'_c hφ'_hom
  have hΦ'_fst : Φ'_c ≫ CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom =
      CategoryTheory.Limits.pullback.fst π_Rc P_fib.hom :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΦ'_snd : Φ'_c ≫ CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom = φ'_c :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  
  let θ_0 : P_a₀ →+* A 0 := θ 0
  have hθ0_C : ∀ x : k, θ_0 (MvPolynomial.C x) = MvPolynomial.C (MvPolynomial.C x) :=
    hθ_C 0
  have hθ0_X : ∀ b : {b : Fin (m + 3) // b ≠ a₀},
      θ_0 (MvPolynomial.X b) =
        if b.1 = a₁ then MvPolynomial.C u_c * ξ 0 0 else ξ 0 (π_idx b.1) :=
    hθ_X 0
  let θ_0_inv : A 0 →+* P_a₀ :=
    MvPolynomial.eval₂Hom κ_c
      (fun p => MvPolynomial.X ⟨σ_c p.1, fun h => p.2 (hσ_inj h)⟩)
  have hθ0_left : θ_0_inv.comp θ_0 = RingHom.id P_a₀ := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro x
      change θ_0_inv (θ_0 (MvPolynomial.C x)) = MvPolynomial.C x
      rw [hθ0_C]
      dsimp only [θ_0_inv, κ_c]
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
    · intro b
      change θ_0_inv (θ_0 (MvPolynomial.X b)) = MvPolynomial.X b
      rw [hθ0_X]
      by_cases hb_a₁ : b.1 = a₁
      · simp only [hb_a₁, ↓reduceIte, ξ, ↓reduceDIte, mul_one]
        dsimp only [θ_0_inv, u_c, κ_c]
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
        congr 1
        exact Subtype.ext hb_a₁.symm
      · simp only [hb_a₁, ↓reduceIte]
        have hb_σ : σ_c (π_idx b.1) = b.1 := (h_dichot b.1).resolve_left hb_a₁
        have hp_ne : π_idx b.1 ≠ 0 := by
          intro hp0
          apply b.2
          rw [← hb_σ, hp0]
          rfl
        dsimp only [ξ]
        simp only [hp_ne, ↓reduceDIte]
        dsimp only [θ_0_inv]
        rw [MvPolynomial.eval₂Hom_X']
        congr 1
        exact Subtype.ext hb_σ
  have hθ0_right : θ_0.comp θ_0_inv = RingHom.id (A 0) := by
    apply MvPolynomial.ringHom_ext'
    · apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro x
        change θ_0 (θ_0_inv (MvPolynomial.C (MvPolynomial.C x))) =
          MvPolynomial.C (MvPolynomial.C x)
        dsimp only [θ_0_inv, κ_c]
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C, hθ0_C]
      · intro j
        change θ_0 (θ_0_inv (MvPolynomial.C (MvPolynomial.X j))) =
          MvPolynomial.C (MvPolynomial.X j)
        have hj_eq : j = ⟨c', hc'⟩ := Subtype.ext (hj_eq_c' j)
        rw [hj_eq]
        dsimp only [θ_0_inv, κ_c]
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', hθ0_X]
        have h_eq_a₁ : ι₂ (⟨c', hc'⟩ : {j : Fin 2 // j ≠ c}).1 = a₁ := rfl
        simp only [h_eq_a₁, ↓reduceIte, ξ, u_c, ↓reduceDIte, mul_one]
    · intro p
      change θ_0 (θ_0_inv (MvPolynomial.X p)) = MvPolynomial.X p
      dsimp only [θ_0_inv]
      rw [MvPolynomial.eval₂Hom_X', hθ0_X]
      have h_ne_a₁ : (⟨σ_c p.1, fun h => p.2 (hσ_inj h)⟩ : {b : Fin (m + 3) // b ≠ a₀}).1 ≠ a₁ :=
        hσ_ne_a₁ p.1
      have h_pi_eq : π_idx (⟨σ_c p.1, fun h => p.2 (hσ_inj h)⟩ :
          {b : Fin (m + 3) // b ≠ a₀}).1 = p.1 := hπ_σ p.1
      simp only [h_ne_a₁, ↓reduceIte, h_pi_eq, ξ, p.2, ↓reduceDIte]
  let iso_θ0 : AlgebraicGeometry.Spec (CommRingCat.of P_a₀) ≅
      AlgebraicGeometry.Spec (CommRingCat.of (A 0)) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0_inv)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          hθ0_left, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          hθ0_right, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  let β_c : (D_c : AlgebraicGeometry.Scheme.{u}) ≅
      (V' 0 : AlgebraicGeometry.Scheme.{u}) :=
    iso_Dc ≪≫ iso_θ0 ≪≫ (e_V 0).symm
  have hφ'_0 : φ'_chart 0 =
      (e_V 0).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0) ≫
        iso_Dc.inv ≫ D_c.ι := rfl
  have hβ_snd : β_c.hom ≫ (V' 0).ι ≫ Φ'_c ≫
      CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom = D_c.ι := by
    rw [hΦ'_snd, hφ'_ι 0, hφ'_0]
    dsimp only [β_c, Iso.trans_hom, Iso.symm_hom, iso_θ0]
    have h_cancel_V : (e_V 0).inv ≫ (e_V 0).hom = 𝟙 _ := (e_V 0).inv_hom_id
    have h_cancel_θ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0_inv) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0) = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        hθ0_left, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    calc (iso_Dc.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0_inv) ≫ (e_V 0).inv) ≫
            (e_V 0).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0) ≫
            iso_Dc.inv ≫ D_c.ι
        = iso_Dc.hom ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0_inv) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_0)) ≫
            iso_Dc.inv ≫ D_c.ι := by
          simp only [CategoryTheory.Category.assoc]
          rw [← CategoryTheory.Category.assoc (e_V 0).inv, h_cancel_V,
            CategoryTheory.Category.id_comp]
      _ = (iso_Dc.hom ≫ iso_Dc.inv) ≫ D_c.ι := by
          rw [h_cancel_θ, CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc]
      _ = D_c.ι := by rw [iso_Dc.hom_inv_id, CategoryTheory.Category.id_comp]
  have hβ_fst : β_c.hom ≫ (V' 0).ι ≫ Φ'_c ≫
      CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom =
      iso_Dc.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_c) := by
    rw [hΦ'_fst]
    dsimp only [β_c, Iso.trans_hom, Iso.symm_hom, iso_θ0]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_V_fst 0,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 3
    apply RingHom.ext
    intro r
    dsimp only [θ_0_inv]
    rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]

  
  have hClosedOnChart : ∀ (a : Fin (m + 3)) {R_src : Type u} [CommRing R_src]
      (e_src : ((Φ'_c ⁻¹ᵁ W_tilde a) : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of R_src))
      (Ψ : B_ring a →+* R_src)
      (_ : Function.Surjective Ψ),
      (e_src.inv ≫ (Φ'_c ⁻¹ᵁ W_tilde a).ι ≫ Φ'_c ≫
          CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ψ.comp MvPolynomial.C))) →
      (e_src.inv ≫ (Φ'_c ⁻¹ᵁ W_tilde a).ι ≫ Φ'_c ≫
          CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom =
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Ψ.comp (MvPolynomial.map MvPolynomial.C))) ≫
          (iso_proj (m + 2) a).inv ≫ (U_amb a).ι) →
      AlgebraicGeometry.IsClosedImmersion (Φ'_c ∣_ W_tilde a) := by
    intro a R_src _ e_src Ψ hΨ_surj h1 h2
    have h_eq_mor : Φ'_c ∣_ W_tilde a =
        e_src.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) ≫ (e_W a).inv := by
      have _ : CategoryTheory.IsIso e_src.inv := e_src.isIso_inv
      rw [← CategoryTheory.cancel_epi e_src.inv,
        ← CategoryTheory.cancel_mono (W_tilde a).ι]
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc ((e_src.inv ≫ (Φ'_c ∣_ W_tilde a)) ≫ (W_tilde a).ι) ≫
                CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom
            = e_src.inv ≫ ((Φ'_c ∣_ W_tilde a) ≫ (W_tilde a).ι) ≫
                CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom := by
              simp only [CategoryTheory.Category.assoc]
          _ = e_src.inv ≫ (Φ'_c ⁻¹ᵁ W_tilde a).ι ≫ Φ'_c ≫
                CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom := by
              rw [AlgebraicGeometry.morphismRestrict_ι Φ'_c (W_tilde a),
                CategoryTheory.Category.assoc (Φ'_c ⁻¹ᵁ W_tilde a).ι]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) ≫
                ((e_W a).inv ≫ (W_tilde a).ι ≫
                  CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom) := by
              rw [h1, he_W_fst a, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp]
          _ = ((e_src.inv ≫ e_src.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) ≫
                (e_W a).inv) ≫ (W_tilde a).ι) ≫
                CategoryTheory.Limits.pullback.fst π_Rc P_amb.hom := by
              simp only [CategoryTheory.Category.assoc]
              rw [← CategoryTheory.Category.assoc e_src.inv, e_src.inv_hom_id,
                CategoryTheory.Category.id_comp]
      · calc ((e_src.inv ≫ (Φ'_c ∣_ W_tilde a)) ≫ (W_tilde a).ι) ≫
                CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom
            = e_src.inv ≫ ((Φ'_c ∣_ W_tilde a) ≫ (W_tilde a).ι) ≫
                CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom := by
              simp only [CategoryTheory.Category.assoc]
          _ = e_src.inv ≫ (Φ'_c ⁻¹ᵁ W_tilde a).ι ≫ Φ'_c ≫
                CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom := by
              rw [AlgebraicGeometry.morphismRestrict_ι Φ'_c (W_tilde a),
                CategoryTheory.Category.assoc (Φ'_c ⁻¹ᵁ W_tilde a).ι]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) ≫
                ((e_W a).inv ≫ (W_tilde a).ι ≫
                  CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom) := by
              rw [h2, he_W_snd a,
                ← CategoryTheory.Category.assoc
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ)),
                ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          _ = ((e_src.inv ≫ e_src.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) ≫
                (e_W a).inv) ≫ (W_tilde a).ι) ≫
                CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom := by
              simp only [CategoryTheory.Category.assoc]
              rw [← CategoryTheory.Category.assoc e_src.inv, e_src.inv_hom_id,
                CategoryTheory.Category.id_comp]
    have _ : CategoryTheory.IsIso e_src.hom := e_src.isIso_hom
    have _ : CategoryTheory.IsIso (e_W a).inv := (e_W a).isIso_inv
    have _ : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ)) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom Ψ) hΨ_surj
    rw [h_eq_mor]
    infer_instance

  have hΦ'_pre_chart : ∀ (q : Fin (m + 2)) (a : Fin (m + 3)) (ha : a ≠ σ_c q)
      (p : AlgebraicGeometry.Spec (CommRingCat.of (A q))),
      ((e_V q).inv ≫ (V' q).ι).base p ∈ Φ'_c ⁻¹ᵁ W_tilde a ↔
        θ q (MvPolynomial.X ⟨a, ha⟩) ∉ p.asIdeal := by
    intro q a ha p
    change ((e_V q).inv ≫ (V' q).ι ≫ Φ'_c ≫
        CategoryTheory.Limits.pullback.snd π_Rc P_amb.hom).base p ∈ U_amb a ↔ _
    rw [hΦ'_snd, hφ'_ι q]
    dsimp only [φ'_chart]
    rw [← CategoryTheory.Category.assoc (e_V q).inv, (e_V q).inv_hom_id,
      CategoryTheory.Category.id_comp]
    let mapθ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ q))
    change ((iso_proj (m + 2) (σ_c q)).inv ≫
        (AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X (σ_c q)) :
          (weilProjectiveSpaceOver k (m + 2)).left.Opens).ι).base (mapθ.base p) ∈
      (AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X a) :
        (weilProjectiveSpaceOver k (m + 2)).left.Opens) ↔ _
    rw [(h_proj_spec (m + 2) (σ_c q)).2.2.2.2.2 a ha (mapθ.base p)]
    dsimp only [mapθ]
    exact hSpecNotMem (θ q) p (MvPolynomial.X ⟨a, ha⟩)

  have hCl_Φ' : AlgebraicGeometry.IsClosedImmersion Φ'_c := by
    apply AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top W_tilde hW_cov
    intro a
    rcases h_dichot a with rfl | ha_σ
    · 
      let u_tilde : A 0 := MvPolynomial.C u_c
      have h_le_V0 : Φ'_c ⁻¹ᵁ W_tilde a₁ ≤ V' 0 := by
        intro z hz
        obtain ⟨q, hz_q⟩ := hV'_mem z
        by_cases hq0 : q = 0
        · subst hq0; exact hz_q
        · let p : AlgebraicGeometry.Spec (CommRingCat.of (A q)) := (e_V q).hom.base ⟨z, hz_q⟩
          have hp_inv : (e_V q).inv.base p = ⟨z, hz_q⟩ :=
            ConcreteCategory.congr_hom ((e_V q).hom_inv_id ▸ rfl :
              ((e_V q).hom ≫ (e_V q).inv).base = 𝟙 _) ⟨z, hz_q⟩
          have hp_z : ((e_V q).inv ≫ (V' q).ι).base p = z := by
            change (V' q).ι.base ((e_V q).inv.base p) = z
            rw [hp_inv]; rfl
          have hp_pre : ((e_V q).inv ≫ (V' q).ι).base p ∈ Φ'_c ⁻¹ᵁ W_tilde a₁ := by
            rw [hp_z]; exact hz
          rw [hΦ'_pre_chart q a₁ (hσ_ne_a₁ q).symm p, hθ_X q] at hp_pre
          simp only [↓reduceIte, ξ, Ne.symm hq0, ↓reduceDIte] at hp_pre
          have h0_notMem : MvPolynomial.X ⟨0, Ne.symm hq0⟩ ∉ p.asIdeal :=
            fun hmem => hp_pre (Ideal.mul_mem_left p.asIdeal _ hmem)
          rw [← hV'_pre q 0 (Ne.symm hq0) p, hp_z] at h0_notMem
          exact h0_notMem
      have h_mem_B : ∀ p : AlgebraicGeometry.Spec (CommRingCat.of (A 0)),
          ((e_V 0).inv ≫ (V' 0).ι).base p ∈ Φ'_c ⁻¹ᵁ W_tilde a₁ ↔
            u_tilde ∉ p.asIdeal := by
        intro p
        rw [hΦ'_pre_chart 0 a₁ ha₁₀ p]
        change θ_0 (MvPolynomial.X ⟨a₁, ha₁₀⟩) ∉ p.asIdeal ↔ _
        rw [hθ0_X]
        simp only [↓reduceIte, ξ, u_tilde, ↓reduceDIte, mul_one]
      obtain ⟨e_src, he_src_ι⟩ :=
        hLocIso (V' 0) (Φ'_c ⁻¹ᵁ W_tilde a₁) h_le_V0 (e_V 0) u_tilde h_mem_B
      let z_a₁ : P_a₀ := MvPolynomial.X ⟨a₁, ha₁₀⟩
      let g_B : P_a₀ →+* Localization.Away u_tilde :=
        (algebraMap (A 0) (Localization.Away u_tilde)).comp θ_0
      have hg_B_z : g_B z_a₁ = algebraMap (A 0) (Localization.Away u_tilde) u_tilde := by
        change algebraMap (A 0) (Localization.Away u_tilde)
          (θ_0 (MvPolynomial.X ⟨a₁, ha₁₀⟩)) = _
        rw [hθ0_X]
        simp only [↓reduceIte, ξ, u_tilde, ↓reduceDIte, mul_one]
      have hu_B_z : IsUnit (g_B z_a₁) := by
        rw [hg_B_z]
        exact IsLocalization.Away.algebraMap_isUnit u_tilde
      obtain ⟨μ_B, hμ_B_alg, hμ_B_inv0⟩ := hAwayLift z_a₁ g_B hu_B_z
      have hμ_B_inv : μ_B (IsLocalization.Away.invSelf (S := Localization.Away z_a₁) z_a₁) =
          IsLocalization.Away.invSelf (S := Localization.Away u_tilde) u_tilde := by
        rw [hμ_B_inv0]
        apply hu_B_z.mul_right_inj.mp
        rw [IsUnit.mul_val_inv, hg_B_z, IsLocalization.Away.mul_invSelf]
      have hg_B_fac : g_B = μ_B.comp (algebraMap P_a₀ (Localization.Away z_a₁)) :=
        RingHom.ext fun P => (hμ_B_alg P).symm
      let τ_a₁ : MvPolynomial {b : Fin (m + 3) // b ≠ a₁} k →+* Localization.Away z_a₁ :=
        MvPolynomial.eval₂Hom ((algebraMap P_a₀ (Localization.Away z_a₁)).comp MvPolynomial.C)
          (fun b => if hb : b.1 = a₀ then
            IsLocalization.Away.invSelf (S := Localization.Away z_a₁) z_a₁
          else
            algebraMap P_a₀ (Localization.Away z_a₁) (MvPolynomial.X ⟨b.1, hb⟩) *
              IsLocalization.Away.invSelf (S := Localization.Away z_a₁) z_a₁)
      let θ_a₁ : MvPolynomial {b : Fin (m + 3) // b ≠ a₁} k →+* Localization.Away u_tilde :=
        μ_B.comp τ_a₁
      let Ψ_B : B_ring a₁ →+* Localization.Away u_tilde :=
        MvPolynomial.eval₂Hom
          ((algebraMap (A 0) (Localization.Away u_tilde)).comp MvPolynomial.C)
          (fun b => θ_a₁ (MvPolynomial.X b))
      have hΨ_B_C : Ψ_B.comp MvPolynomial.C =
          (algebraMap (A 0) (Localization.Away u_tilde)).comp MvPolynomial.C := by
        apply RingHom.ext
        intro r
        dsimp only [Ψ_B]
        rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      have hΨ_B_map : Ψ_B.comp (MvPolynomial.map MvPolynomial.C) = θ_a₁ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro x
          change Ψ_B ((MvPolynomial.map MvPolynomial.C) (MvPolynomial.C x)) =
            μ_B (τ_a₁ (MvPolynomial.C x))
          rw [MvPolynomial.map_C]
          dsimp only [Ψ_B, τ_a₁]
          rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
            RingHom.comp_apply, hμ_B_alg]
          dsimp only [g_B]
          rw [RingHom.comp_apply, hθ0_C]
        · intro b
          change Ψ_B ((MvPolynomial.map MvPolynomial.C) (MvPolynomial.X b)) =
            θ_a₁ (MvPolynomial.X b)
          rw [MvPolynomial.map_X]
          dsimp only [Ψ_B]
          rw [MvPolynomial.eval₂Hom_X']
      have hΨ_B_surj : Function.Surjective Ψ_B := by
        let η_B : A 0 →+* B_ring a₁ :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun p => MvPolynomial.C u_c * MvPolynomial.X ⟨σ_c p.1, hσ_ne_a₁ p.1⟩)
        have hΨ_η : Ψ_B.comp η_B = algebraMap (A 0) (Localization.Away u_tilde) := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            change Ψ_B (η_B (MvPolynomial.C r)) =
              algebraMap (A 0) (Localization.Away u_tilde) (MvPolynomial.C r)
            dsimp only [η_B, Ψ_B]
            rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
            rfl
          · intro p
            change Ψ_B (η_B (MvPolynomial.X p)) =
              algebraMap (A 0) (Localization.Away u_tilde) (MvPolynomial.X p)
            have hp_ne_a₀ : σ_c p.1 ≠ a₀ := fun h => p.2 (hσ_inj h)
            dsimp only [η_B]
            rw [MvPolynomial.eval₂Hom_X', map_mul]
            dsimp only [Ψ_B]
            rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
            dsimp only [θ_a₁]
            rw [RingHom.comp_apply, RingHom.comp_apply]
            dsimp only [τ_a₁]
            rw [MvPolynomial.eval₂Hom_X']
            simp only [hp_ne_a₀, ↓reduceDIte, map_mul, hμ_B_alg, hμ_B_inv]
            dsimp only [g_B]
            rw [RingHom.comp_apply, hθ0_X]
            have h_ne1 : (⟨σ_c p.1, hp_ne_a₀⟩ : {b : Fin (m + 3) // b ≠ a₀}).1 ≠ a₁ :=
              hσ_ne_a₁ p.1
            have h_pi1 : π_idx (⟨σ_c p.1, hp_ne_a₀⟩ : {b : Fin (m + 3) // b ≠ a₀}).1 = p.1 :=
              hπ_σ p.1
            simp only [h_ne1, ↓reduceIte, h_pi1, ξ, p.2, ↓reduceDIte]
            change algebraMap (A 0) (Localization.Away u_tilde) u_tilde *
              (algebraMap (A 0) (Localization.Away u_tilde) (MvPolynomial.X p) *
                IsLocalization.Away.invSelf u_tilde) = _
            calc algebraMap (A 0) (Localization.Away u_tilde) u_tilde *
                    (algebraMap (A 0) (Localization.Away u_tilde) (MvPolynomial.X p) *
                      IsLocalization.Away.invSelf u_tilde)
                = algebraMap (A 0) (Localization.Away u_tilde) (MvPolynomial.X p) *
                    (algebraMap (A 0) (Localization.Away u_tilde) u_tilde *
                      IsLocalization.Away.invSelf u_tilde) := by ring
              _ = algebraMap (A 0) (Localization.Away u_tilde) (MvPolynomial.X p) := by
                    rw [IsLocalization.Away.mul_invSelf, mul_one]
        have hΨ_Xa₀ : Ψ_B (MvPolynomial.X ⟨a₀, ha₁₀.symm⟩) =
            IsLocalization.Away.invSelf (S := Localization.Away u_tilde) u_tilde := by
          dsimp only [Ψ_B]
          rw [MvPolynomial.eval₂Hom_X']
          dsimp only [θ_a₁]
          rw [RingHom.comp_apply]
          dsimp only [τ_a₁]
          rw [MvPolynomial.eval₂Hom_X']
          simp only [↓reduceDIte, hμ_B_inv]
        intro z
        obtain ⟨⟨P, ⟨_, ⟨n, rfl⟩⟩⟩, hz_eq⟩ :=
          IsLocalization.surj (Submonoid.powers u_tilde) z
        dsimp only at hz_eq
        refine ⟨η_B P * (MvPolynomial.X ⟨a₀, ha₁₀.symm⟩) ^ n, ?_⟩
        rw [map_mul, map_pow, hΨ_Xa₀]
        have hP_val : Ψ_B (η_B P) = algebraMap (A 0) (Localization.Away u_tilde) P :=
          DFunLike.congr_fun hΨ_η P
        have hmul_n : algebraMap (A 0) (Localization.Away u_tilde) (u_tilde ^ n) *
            (IsLocalization.Away.invSelf (S := Localization.Away u_tilde) u_tilde) ^ n = 1 := by
          rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
        rw [hP_val, ← hz_eq, mul_assoc, hmul_n, mul_one]
      have h_tr_B :
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap P_a₀ (Localization.Away z_a₁))) ≫
            (iso_proj (m + 2) a₀).inv ≫ (U_amb a₀).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_a₁) ≫
            (iso_proj (m + 2) a₁).inv ≫ (U_amb a₁).ι :=
        hProjTrans (m + 2) a₀ a₁ ha₁₀
      apply hClosedOnChart a₁ e_src Ψ_B hΨ_B_surj
      · rw [← CategoryTheory.Category.assoc, he_src_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hΦ'_fst,
          he_V_fst 0,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hΨ_B_C]
      · rw [← CategoryTheory.Category.assoc, he_src_ι,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hΦ'_snd, hφ'_ι 0, hφ'_0]
        dsimp only [iso_Dc]
        rw [← CategoryTheory.Category.assoc (e_V 0).inv, (e_V 0).inv_hom_id,
          CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_B) ≫
            (iso_proj (m + 2) a₀).inv ≫ (U_amb a₀).ι = _
        rw [hg_B_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, h_tr_B,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hΨ_B_map]
    · 
      let q₀ : Fin (m + 2) := π_idx a
      have ha_eq : σ_c q₀ = a := ha_σ
      rw [← ha_eq]
      have h_open_eq : Φ'_c ⁻¹ᵁ W_tilde (σ_c q₀) = V' q₀ := by
        ext z
        constructor
        · intro hz
          obtain ⟨q, hz_q⟩ := hV'_mem z
          by_cases hq : q₀ = q
          · subst hq; exact hz_q
          · let p : AlgebraicGeometry.Spec (CommRingCat.of (A q)) := (e_V q).hom.base ⟨z, hz_q⟩
