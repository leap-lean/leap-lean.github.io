        dsimp only [α_open]
        rw [← CategoryTheory.Category.assoc e_γ.inv,
          ← CategoryTheory.Category.assoc e_γ.inv, e_γ.inv_hom_id,
          CategoryTheory.Category.id_comp]
      rw [hα_cancel]
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [g', iso_Q]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, hγ_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hβ_fst]
      · dsimp only [g', iso_Q]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, hγ_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hβ_snd]
    have hKer_g' : AlgebraicGeometry.Scheme.Hom.ker g' =
        AlgebraicGeometry.Scheme.Hom.ker Φ'_c := by
      rw [hg'_fac, AlgebraicGeometry.Scheme.Hom.ker_comp_of_isIso,
        AlgebraicGeometry.Scheme.Hom.ker_comp, hKer_V0,
        AlgebraicGeometry.Scheme.IdealSheafData.map_bot]
    have hg'_inv : g' ≫ iso_Q.inv = γ_k ∣_ Q_c := by
      dsimp only [g']
      rw [CategoryTheory.Category.assoc, iso_Q.hom_inv_id, CategoryTheory.Category.comp_id]
    calc AlgebraicGeometry.Scheme.Hom.ker (γ_k ∣_ Q_c)
        = AlgebraicGeometry.Scheme.Hom.ker (g' ≫ iso_Q.inv) := by rw [hg'_inv]
      _ = (AlgebraicGeometry.Scheme.Hom.ker g').map iso_Q.inv :=
            AlgebraicGeometry.Scheme.Hom.ker_comp g' iso_Q.inv
      _ = (AlgebraicGeometry.Scheme.Hom.ker Φ'_c).map iso_Q.inv := by rw [hKer_g']
      _ = AlgebraicGeometry.Scheme.Hom.ker (Φ'_c ≫ iso_Q.inv) :=
            (AlgebraicGeometry.Scheme.Hom.ker_comp Φ'_c iso_Q.inv).symm
      _ = AlgebraicGeometry.Scheme.Hom.ker Φ_c := by
            dsimp only [Φ_c]
            exact (AlgebraicGeometry.Scheme.Hom.ker_comp_of_isIso iso_E.hom (Φ'_c ≫ iso_Q.inv)).symm

  exact ⟨Φ_c, hCl_Φ, hΦ_proj, hKer_eq⟩

theorem weil_projSpace_relative_incidence_blowup (k : Type u) [Field k]
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))) :
    CategoryTheory.IsIso
      (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom) ∧
    ∀ (N : ℕ), 2 ≤ N →
      let X_N := CategoryTheory.Over.mk
        (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom ≫ B.hom)
      let p_N : X_N ⟶ B :=
        CategoryTheory.Over.homMk
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) rfl
      let X_1 := CategoryTheory.Over.mk
        (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom ≫ B.hom)
      let p_1 : X_1 ⟶ B :=
        CategoryTheory.Over.homMk
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom) rfl
      let X_sub := CategoryTheory.Over.mk
        (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k (N - 2)).hom ≫ B.hom)
      let p_sub : X_sub ⟶ B :=
        CategoryTheory.Over.homMk
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k (N - 2)).hom) rfl
      ∃ (U_B : X_N.left.Opens) (i_B : X_sub ⟶ X_N)
        (P_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (π_B : P_bar ⟶ X_N) (a_B : P_bar ⟶ X_1) (W_B : Fin 2 → X_1.left.Opens),
        (i_B ≫ p_N = p_sub ∧
          AlgebraicGeometry.IsClosedImmersion i_B.left ∧
          Set.range i_B.left.base = (U_B : Set X_N.left)ᶜ) ∧
        (AlgebraicGeometry.IsProper π_B.left ∧
          CategoryTheory.IsIso (π_B.left ∣_ U_B) ∧
          π_B ≫ p_N = a_B ≫ p_1) ∧
        (AlgebraicGeometry.IsProper a_B.left ∧
          (⨆ c : Fin 2, W_B c) = ⊤ ∧
          ∀ c : Fin 2, AlgebraicGeometry.QuasiCompact (W_B c).ι) ∧
        (∀ c : Fin 2,
          ∃ (g_c : CategoryTheory.Limits.pullback ((W_B c).ι ≫ X_1.hom)
              (weilProjectiveSpaceOver k (N - 1)).hom ⟶ P_bar.left),
            CategoryTheory.IsPullback g_c
              (CategoryTheory.Limits.pullback.fst ((W_B c).ι ≫ X_1.hom)
                (weilProjectiveSpaceOver k (N - 1)).hom)
              a_B.left (W_B c).ι) :=
by
  refine ⟨?_, ?_⟩
  · 
    have hIsoP0 : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom :=
      (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k 0).2.2.2 rfl
    exact @CategoryTheory.IsPullback.isIso_fst_of_isIso _ _ _ _ _ _ _ _ _ _
      (CategoryTheory.IsPullback.of_hasPullback B.hom (weilProjectiveSpaceOver k 0).hom) hIsoP0
  · 
    intro N hN
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, N = m + 2 := ⟨N - 2, (Nat.sub_add_cancel hN).symm⟩
    intro X_N p_N X_1 p_1 X_sub p_sub

    
    have hProperProj :
        ∀ (M : ℕ), AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k M).hom := by
      intro M
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (M + 1)) k) :=
        ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (M + 1)) k) p⟩
      have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (M + 1)) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (M + 1)) k)
      have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
        intro z
        have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0 := z.2
        rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
        obtain ⟨c, hc⟩ := hz0
        exact ⟨c, Subtype.ext hc⟩
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) hSurj0
      dsimp [weilProjectiveSpaceOver]
      infer_instance

    let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P_amb := weilProjectiveSpaceOver k (m + 2)
    let P_sub := weilProjectiveSpaceOver k m
    let P_1 := weilProjectiveSpaceOver k 1
    let P_fib := weilProjectiveSpaceOver k (m + 1)
    let U_k := weilCodimTwoComplOpen k m
    let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let _ : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
    let W_1 : Fin 2 → P_1.left.Opens := fun c =>
      AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X c)

    have _ : AlgebraicGeometry.IsProper P_amb.hom := hProperProj (m + 2)
    have _ : AlgebraicGeometry.IsProper P_1.hom := hProperProj 1

    
    obtain ⟨hCovW, hQcW, hNeU, hCompU, ⟨i_k, hi_cl, hi_range⟩, ⟨pr_k, hPr⟩⟩ :=
      weil_projSpace_codimTwo_center_and_line_projection k m
    have hCovW' : (⨆ c : Fin 2, W_1 c) = (⊤ : P_1.left.Opens) := hCovW
    have hi_f : i_k.left ≫ P_amb.hom = P_sub.hom := CategoryTheory.Over.w i_k
    have hg_comm : U_k.ι ≫ P_amb.hom = pr_k ≫ P_1.hom := hPr.1

    
    have hIntP : AlgebraicGeometry.IsIntegral P_amb.left :=
      (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k (m + 2)).1
    have _ : AlgebraicGeometry.IsIntegral P_amb.left := hIntP
    have _ : IrreducibleSpace ↥P_amb.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral P_amb.left
    have _ : AlgebraicGeometry.IsReduced P_amb.left :=
      AlgebraicGeometry.isReduced_of_isIntegral P_amb.left
    have _ : AlgebraicGeometry.IsReduced (U_k : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion U_k.ι
    have hPreU : IsPreirreducible (Set.univ : Set ↥(U_k : AlgebraicGeometry.Scheme.{u})) := by
      have huniv : (Set.univ : Set ↥(U_k : AlgebraicGeometry.Scheme.{u})) =
          U_k.ι.base ⁻¹' (Set.univ : Set ↥P_amb.left) := rfl
      rw [huniv]
      exact PreirreducibleSpace.isPreirreducible_univ.preimage U_k.ι.isOpenEmbedding
    have _ : IrreducibleSpace ↥(U_k : AlgebraicGeometry.Scheme.{u}) :=
      { isPreirreducible_univ := hPreU
        toNonempty := hNeU }
    have hIntU : AlgebraicGeometry.IsIntegral (U_k : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced
        (U_k : AlgebraicGeometry.Scheme.{u})

    
    let Q_k := CategoryTheory.Limits.pullback P_amb.hom P_1.hom
    let γ_k : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ Q_k :=
      CategoryTheory.Limits.pullback.lift U_k.ι pr_k hg_comm
    let P_bar_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.image γ_k
    let ι_inc : P_bar_k ⟶ Q_k := AlgebraicGeometry.Scheme.Hom.imageι γ_k
    have _ : AlgebraicGeometry.IsClosedImmersion ι_inc := by
      dsimp [ι_inc]
      infer_instance
    let π_k : P_bar_k ⟶ P_amb.left :=
      ι_inc ≫ CategoryTheory.Limits.pullback.fst P_amb.hom P_1.hom
    let a_k : P_bar_k ⟶ P_1.left :=
      ι_inc ≫ CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom
    let f_bar : P_bar_k ⟶ S₀ := π_k ≫ P_amb.hom
    have ha_f : a_k ≫ P_1.hom = f_bar := by
      dsimp [a_k, f_bar, π_k]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition]

    have _ : CompactSpace ↥(U_k : AlgebraicGeometry.Scheme.{u}) := hCompU
    obtain ⟨_, hProp_πk, hProp_ak, hKerRestr, hIso_πk, _⟩ :=
      weil_schematicImage_graph_openIso_and_isIntegral S₀ P_amb.left P_1.left
        P_amb.hom P_1.hom U_k hIntU pr_k hg_comm
    have _ : CategoryTheory.IsIso (π_k ∣_ U_k) := hIso_πk

    
    have hUnivChart : ∀ c : Fin 2,
        ∃ (g_kc : CategoryTheory.Limits.pullback ((W_1 c).ι ≫ P_1.hom) P_fib.hom ⟶ P_bar_k),
          CategoryTheory.IsPullback g_kc
            (CategoryTheory.Limits.pullback.fst ((W_1 c).ι ≫ P_1.hom) P_fib.hom)
            a_k (W_1 c).ι := by
      intro c
      obtain ⟨Φ_c, hCl_Φ, hΦ_snd, hKer_c⟩ :=
        weil_codimTwo_blowup_chart_trivialization k m pr_k hPr hg_comm c
      have _ : AlgebraicGeometry.IsClosedImmersion Φ_c := hCl_Φ
      let Q_c : Q_k.Opens := (CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ⁻¹ᵁ W_1 c
      let E_kc := CategoryTheory.Limits.pullback ((W_1 c).ι ≫ P_1.hom) P_fib.hom
      have hKerEq : AlgebraicGeometry.Scheme.Hom.ker (ι_inc ∣_ Q_c) =
          AlgebraicGeometry.Scheme.Hom.ker Φ_c :=
        (hKerRestr Q_c).trans hKer_c
      let L_c0 := AlgebraicGeometry.IsClosedImmersion.lift (ι_inc ∣_ Q_c) Φ_c hKerEq.le
      have hIso_Lc0 : CategoryTheory.IsIso L_c0 :=
        AlgebraicGeometry.IsClosedImmersion.isIso_lift (ι_inc ∣_ Q_c) Φ_c hKerEq
      have hLc_fac : L_c0 ≫ (ι_inc ∣_ Q_c) = Φ_c :=
        AlgebraicGeometry.IsClosedImmersion.lift_fac (ι_inc ∣_ Q_c) Φ_c hKerEq.le
      let L_c : E_kc ⟶ (a_k ⁻¹ᵁ W_1 c : AlgebraicGeometry.Scheme.{u}) := L_c0
      have _ : CategoryTheory.IsIso L_c := hIso_Lc0
      have hLc_ak : L_c ≫ (a_k ∣_ W_1 c) =
          CategoryTheory.Limits.pullback.fst ((W_1 c).ι ≫ P_1.hom) P_fib.hom := by
        rw [← CategoryTheory.cancel_mono (W_1 c).ι]
        have h1 : L_c ≫ ((a_k ∣_ W_1 c) ≫ (W_1 c).ι) =
            L_c0 ≫ (((ι_inc ⁻¹ᵁ Q_c).ι ≫ ι_inc) ≫
              CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) := by
          rw [AlgebraicGeometry.morphismRestrict_ι a_k (W_1 c), CategoryTheory.Category.assoc]
          rfl
        calc (L_c ≫ (a_k ∣_ W_1 c)) ≫ (W_1 c).ι
            = L_c ≫ ((a_k ∣_ W_1 c) ≫ (W_1 c).ι) := CategoryTheory.Category.assoc _ _ _
          _ = L_c0 ≫ (((ι_inc ⁻¹ᵁ Q_c).ι ≫ ι_inc) ≫
                CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) := h1
          _ = L_c0 ≫ (((ι_inc ∣_ Q_c) ≫ Q_c.ι) ≫
                CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) := by
              rw [← AlgebraicGeometry.morphismRestrict_ι ι_inc Q_c]
          _ = (L_c0 ≫ (ι_inc ∣_ Q_c)) ≫
                (Q_c.ι ≫ CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) := by
              rw [CategoryTheory.Category.assoc (ι_inc ∣_ Q_c),
                ← CategoryTheory.Category.assoc L_c0]
          _ = (Φ_c ≫ (CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom ∣_ W_1 c)) ≫
                (W_1 c).ι := by
              rw [hLc_fac, ← AlgebraicGeometry.morphismRestrict_ι
                (CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) (W_1 c),
                CategoryTheory.Category.assoc]
          _ = CategoryTheory.Limits.pullback.fst ((W_1 c).ι ≫ P_1.hom) P_fib.hom ≫ (W_1 c).ι := by
              rw [hΦ_snd]
      let g_kc : E_kc ⟶ P_bar_k := L_c ≫ (a_k ⁻¹ᵁ W_1 c).ι
      have sq_L : CategoryTheory.IsPullback L_c
          (CategoryTheory.Limits.pullback.fst ((W_1 c).ι ≫ P_1.hom) P_fib.hom)
          (a_k ∣_ W_1 c) (𝟙 (W_1 c : AlgebraicGeometry.Scheme.{u})) :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [hLc_ak, CategoryTheory.Category.comp_id]⟩
      have sq_ak : CategoryTheory.IsPullback (a_k ⁻¹ᵁ W_1 c).ι (a_k ∣_ W_1 c) a_k (W_1 c).ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict a_k (W_1 c)).flip
      have sq_paste := sq_L.paste_horiz sq_ak
      rw [CategoryTheory.Category.id_comp] at sq_paste
      exact ⟨g_kc, sq_paste⟩

    
    let p_N1 : X_N.left ⟶ B.left := CategoryTheory.Limits.pullback.fst B.hom P_amb.hom
    let p_N2 : X_N.left ⟶ P_amb.left := CategoryTheory.Limits.pullback.snd B.hom P_amb.hom
    let p_11 : X_1.left ⟶ B.left := CategoryTheory.Limits.pullback.fst B.hom P_1.hom
    let p_12 : X_1.left ⟶ P_1.left := CategoryTheory.Limits.pullback.snd B.hom P_1.hom
    let p_sub1 : X_sub.left ⟶ B.left := CategoryTheory.Limits.pullback.fst B.hom P_sub.hom
    let p_sub2 : X_sub.left ⟶ P_sub.left := CategoryTheory.Limits.pullback.snd B.hom P_sub.hom

    let P_bar_B : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback B.hom f_bar
    let q_1 : P_bar_B ⟶ B.left := CategoryTheory.Limits.pullback.fst B.hom f_bar
    let q_2 : P_bar_B ⟶ P_bar_k := CategoryTheory.Limits.pullback.snd B.hom f_bar
    let P_bar : CategoryTheory.Over S₀ := CategoryTheory.Over.mk (q_1 ≫ B.hom)

    let U_B : X_N.left.Opens := p_N2 ⁻¹ᵁ U_k
    let W_B : Fin 2 → X_1.left.Opens := fun c => p_12 ⁻¹ᵁ W_1 c

    have hi_B_cond : p_sub1 ≫ B.hom = (p_sub2 ≫ i_k.left) ≫ P_amb.hom := by
      rw [CategoryTheory.Category.assoc, hi_f]
      exact CategoryTheory.Limits.pullback.condition
    let i_B0 : X_sub.left ⟶ X_N.left :=
      CategoryTheory.Limits.pullback.lift p_sub1 (p_sub2 ≫ i_k.left) hi_B_cond
    have hi_B0_fst : i_B0 ≫ p_N1 = p_sub1 :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hi_B0_snd : i_B0 ≫ p_N2 = p_sub2 ≫ i_k.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hi_B_w : i_B0 ≫ X_N.hom = X_sub.hom := by
      change i_B0 ≫ (p_N1 ≫ B.hom) = p_sub1 ≫ B.hom
      rw [← CategoryTheory.Category.assoc, hi_B0_fst]
    let i_B : X_sub ⟶ X_N := CategoryTheory.Over.homMk i_B0 hi_B_w

    have hπ_B_cond : q_1 ≫ B.hom = (q_2 ≫ π_k) ≫ P_amb.hom := by
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.Limits.pullback.condition
    let π_B0 : P_bar_B ⟶ X_N.left :=
      CategoryTheory.Limits.pullback.lift q_1 (q_2 ≫ π_k) hπ_B_cond
    have hπ_B0_fst : π_B0 ≫ p_N1 = q_1 :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hπ_B0_snd : π_B0 ≫ p_N2 = q_2 ≫ π_k :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hπ_B_w : π_B0 ≫ X_N.hom = P_bar.hom := by
      change π_B0 ≫ (p_N1 ≫ B.hom) = q_1 ≫ B.hom
      rw [← CategoryTheory.Category.assoc, hπ_B0_fst]
    let π_B : P_bar ⟶ X_N := CategoryTheory.Over.homMk π_B0 hπ_B_w

    have ha_B_cond : q_1 ≫ B.hom = (q_2 ≫ a_k) ≫ P_1.hom := by
      rw [CategoryTheory.Category.assoc, ha_f]
      exact CategoryTheory.Limits.pullback.condition
    let a_B0 : P_bar_B ⟶ X_1.left :=
      CategoryTheory.Limits.pullback.lift q_1 (q_2 ≫ a_k) ha_B_cond
    have ha_B0_fst : a_B0 ≫ p_11 = q_1 :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have ha_B0_snd : a_B0 ≫ p_12 = q_2 ≫ a_k :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have ha_B_w : a_B0 ≫ X_1.hom = P_bar.hom := by
      change a_B0 ≫ (p_11 ≫ B.hom) = q_1 ≫ B.hom
      rw [← CategoryTheory.Category.assoc, ha_B0_fst]
    let a_B : P_bar ⟶ X_1 := CategoryTheory.Over.homMk a_B0 ha_B_w

    
    have sq_XN : CategoryTheory.IsPullback p_N1 p_N2 B.hom P_amb.hom :=
      CategoryTheory.IsPullback.of_hasPullback B.hom P_amb.hom
    have sq_X1 : CategoryTheory.IsPullback p_11 p_12 B.hom P_1.hom :=
      CategoryTheory.IsPullback.of_hasPullback B.hom P_1.hom

    have sq_i : CategoryTheory.IsPullback i_B0 p_sub2 p_N2 i_k.left := by
      rw [← CategoryTheory.IsPullback.paste_horiz_iff sq_XN hi_B0_snd, hi_B0_fst, hi_f]
      exact CategoryTheory.IsPullback.of_hasPullback B.hom P_sub.hom

    have sq_π : CategoryTheory.IsPullback π_B0 q_2 p_N2 π_k := by
      rw [← CategoryTheory.IsPullback.paste_horiz_iff sq_XN hπ_B0_snd, hπ_B0_fst]
      exact CategoryTheory.IsPullback.of_hasPullback B.hom f_bar

    have sq_a : CategoryTheory.IsPullback a_B0 q_2 p_12 a_k := by
      rw [← CategoryTheory.IsPullback.paste_horiz_iff sq_X1 ha_B0_snd, ha_B0_fst, ha_f]
      exact CategoryTheory.IsPullback.of_hasPullback B.hom f_bar

    
    have hi_comp : i_B ≫ p_N = p_sub := by
      ext : 1
      exact hi_B0_fst

    have hi_B_cl : AlgebraicGeometry.IsClosedImmersion i_B.left :=
      CategoryTheory.MorphismProperty.of_isPullback sq_i.flip hi_cl

    have hi_B_range : Set.range i_B.left.base = (U_B : Set X_N.left)ᶜ := by
      let e_sub : X_sub.left ≅ CategoryTheory.Limits.pullback p_N2 i_k.left := sq_i.isoPullback
      have he_fst : e_sub.hom ≫ CategoryTheory.Limits.pullback.fst p_N2 i_k.left = i_B0 :=
        sq_i.isoPullback_hom_fst
      have hsurj : Function.Surjective e_sub.hom.base :=
        (AlgebraicGeometry.Scheme.homeoOfIso e_sub).surjective
      have hcomp_base : ⇑i_B0.base =
          ⇑(CategoryTheory.Limits.pullback.fst p_N2 i_k.left).base ∘ ⇑e_sub.hom.base := by
        rw [← he_fst]
        rfl
      change Set.range ⇑i_B0.base = (U_B : Set X_N.left)ᶜ
      rw [hcomp_base, Set.range_comp, hsurj.range_eq, Set.image_univ]
      have hrfst : Set.range ⇑(CategoryTheory.Limits.pullback.fst p_N2 i_k.left).base =
          ⇑p_N2.base ⁻¹' Set.range ⇑i_k.left.base :=
        AlgebraicGeometry.Scheme.Pullback.range_fst p_N2 i_k.left
      rw [hrfst, hi_range]
      rfl

    have hπ_B_prop : AlgebraicGeometry.IsProper π_B.left :=
      CategoryTheory.MorphismProperty.of_isPullback sq_π.flip hProp_πk

    have hπ_B_iso : CategoryTheory.IsIso (π_B.left ∣_ U_B) := by
      change CategoryTheory.IsIso (π_B0 ∣_ U_B)
      have sq_UB : CategoryTheory.IsPullback (π_B0 ⁻¹ᵁ U_B).ι (π_B0 ∣_ U_B) π_B0 U_B.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict π_B0 U_B).flip
      have sq_Uk : CategoryTheory.IsPullback (π_k ⁻¹ᵁ U_k).ι (π_k ∣_ U_k) π_k U_k.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict π_k U_k).flip
      have sq_big : CategoryTheory.IsPullback ((π_B0 ⁻¹ᵁ U_B).ι ≫ q_2) (π_B0 ∣_ U_B)
          π_k (U_B.ι ≫ p_N2) :=
        sq_UB.paste_horiz sq_π.flip
      have h_bot_U : (p_N2 ∣_ U_k) ≫ U_k.ι = U_B.ι ≫ p_N2 :=
        AlgebraicGeometry.morphismRestrict_ι p_N2 U_k
      have hu_U_cond : ((π_B0 ⁻¹ᵁ U_B).ι ≫ q_2) ≫ π_k =
          ((π_B0 ∣_ U_B) ≫ (p_N2 ∣_ U_k)) ≫ U_k.ι := by
        rw [CategoryTheory.Category.assoc (π_B0 ∣_ U_B), h_bot_U]
        exact sq_big.w
      let u_U := sq_Uk.lift ((π_B0 ⁻¹ᵁ U_B).ι ≫ q_2) ((π_B0 ∣_ U_B) ≫ (p_N2 ∣_ U_k)) hu_U_cond
      have hu_U_fst : u_U ≫ (π_k ⁻¹ᵁ U_k).ι = (π_B0 ⁻¹ᵁ U_B).ι ≫ q_2 :=
        sq_Uk.lift_fst _ _ _
      have hu_U_snd : u_U ≫ (π_k ∣_ U_k) = (π_B0 ∣_ U_B) ≫ (p_N2 ∣_ U_k) :=
        sq_Uk.lift_snd _ _ _
      have sq_restr : CategoryTheory.IsPullback u_U (π_B0 ∣_ U_B) (π_k ∣_ U_k) (p_N2 ∣_ U_k) := by
        rw [← CategoryTheory.IsPullback.paste_horiz_iff sq_Uk hu_U_snd, hu_U_fst, h_bot_U]
        exact sq_big
      exact @CategoryTheory.IsPullback.isIso_fst_of_isIso _ _ _ _ _ _ _ _ _ _
        sq_restr.flip hIso_πk

    have hπa_comp : π_B ≫ p_N = a_B ≫ p_1 := by
      ext : 1
      change π_B0 ≫ p_N1 = a_B0 ≫ p_11
      rw [hπ_B0_fst, ha_B0_fst]

    have ha_B_prop : AlgebraicGeometry.IsProper a_B.left :=
      CategoryTheory.MorphismProperty.of_isPullback sq_a.flip hProp_ak

    have hWB_top : (⨆ c : Fin 2, W_B c) = ⊤ := by
      ext x
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      have hx : p_12.base x ∈ (⊤ : P_1.left.Opens) := trivial
      rw [← hCovW', TopologicalSpace.Opens.mem_iSup] at hx
      exact TopologicalSpace.Opens.mem_iSup.mpr hx

    have hWB_qc : ∀ c : Fin 2, AlgebraicGeometry.QuasiCompact (W_B c).ι := fun c =>
      CategoryTheory.MorphismProperty.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict p_12 (W_1 c)) (hQcW c)

    have hWB_pb : ∀ c : Fin 2,
        ∃ (g_c : CategoryTheory.Limits.pullback ((W_B c).ι ≫ X_1.hom) P_fib.hom ⟶ P_bar.left),
          CategoryTheory.IsPullback g_c
            (CategoryTheory.Limits.pullback.fst ((W_B c).ι ≫ X_1.hom) P_fib.hom)
            a_B.left (W_B c).ι := by
      intro c
      obtain ⟨g_kc, sq_gkc⟩ := hUnivChart c
      let f_wc : (W_B c : AlgebraicGeometry.Scheme.{u}) ⟶ S₀ := (W_B c).ι ≫ X_1.hom
      let Y_c := CategoryTheory.Limits.pullback f_wc P_fib.hom
      let π_Y1 := CategoryTheory.Limits.pullback.fst f_wc P_fib.hom
      let π_Y2 := CategoryTheory.Limits.pullback.snd f_wc P_fib.hom
      let E_kc := CategoryTheory.Limits.pullback ((W_1 c).ι ≫ P_1.hom) P_fib.hom
      let π_E1 := CategoryTheory.Limits.pullback.fst ((W_1 c).ι ≫ P_1.hom) P_fib.hom
      let π_E2 := CategoryTheory.Limits.pullback.snd ((W_1 c).ι ≫ P_1.hom) P_fib.hom
      let w_c : (W_B c : AlgebraicGeometry.Scheme.{u}) ⟶ (W_1 c : AlgebraicGeometry.Scheme.{u}) :=
        p_12 ∣_ W_1 c
      have hw_ι : w_c ≫ (W_1 c).ι = (W_B c).ι ≫ p_12 :=
        AlgebraicGeometry.morphismRestrict_ι p_12 (W_1 c)
      have hf_wc : w_c ≫ ((W_1 c).ι ≫ P_1.hom) = f_wc := by
        rw [← CategoryTheory.Category.assoc, hw_ι, CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition]
        rfl
      have hw_tilde_cond : (π_Y1 ≫ w_c) ≫ ((W_1 c).ι ≫ P_1.hom) = π_Y2 ≫ P_fib.hom := by
        rw [CategoryTheory.Category.assoc, hf_wc]
        exact CategoryTheory.Limits.pullback.condition
      let w_tilde : Y_c ⟶ E_kc :=
        CategoryTheory.Limits.pullback.lift (π_Y1 ≫ w_c) π_Y2 hw_tilde_cond
      have hw_tilde_fst : w_tilde ≫ π_E1 = π_Y1 ≫ w_c :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hw_tilde_snd : w_tilde ≫ π_E2 = π_Y2 :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have sq_E_flip : CategoryTheory.IsPullback π_E2 π_E1 P_fib.hom ((W_1 c).ι ≫ P_1.hom) :=
        (CategoryTheory.IsPullback.of_hasPullback ((W_1 c).ι ≫ P_1.hom) P_fib.hom).flip
      have sq_A : CategoryTheory.IsPullback w_tilde π_Y1 π_E1 w_c := by
        rw [← CategoryTheory.IsPullback.paste_horiz_iff sq_E_flip hw_tilde_fst,
          hw_tilde_snd, hf_wc]
        exact (CategoryTheory.IsPullback.of_hasPullback f_wc P_fib.hom).flip
      have sq_AB : CategoryTheory.IsPullback (w_tilde ≫ g_kc) π_Y1 a_k (w_c ≫ (W_1 c).ι) :=
        sq_A.paste_horiz sq_gkc
      have sq_a_flip : CategoryTheory.IsPullback q_2 a_B0 a_k p_12 := sq_a.flip
      have hgc_cond : (w_tilde ≫ g_kc) ≫ a_k = (π_Y1 ≫ (W_B c).ι) ≫ p_12 := by
        rw [CategoryTheory.Category.assoc π_Y1, ← hw_ι]
        exact sq_AB.w
      let g_c : Y_c ⟶ P_bar_B := sq_a_flip.lift (w_tilde ≫ g_kc) (π_Y1 ≫ (W_B c).ι) hgc_cond
      have hgc_fst : g_c ≫ q_2 = w_tilde ≫ g_kc := sq_a_flip.lift_fst _ _ _
      have hgc_snd : g_c ≫ a_B0 = π_Y1 ≫ (W_B c).ι := sq_a_flip.lift_snd _ _ _
      have sq_gc : CategoryTheory.IsPullback g_c π_Y1 a_B0 (W_B c).ι := by
        rw [← CategoryTheory.IsPullback.paste_horiz_iff sq_a_flip hgc_snd, hgc_fst, ← hw_ι]
        exact sq_AB
      exact ⟨g_c, sq_gc⟩

    exact ⟨U_B, i_B, P_bar, π_B, a_B, W_B,
      ⟨hi_comp, hi_B_cl, hi_B_range⟩,
      ⟨hπ_B_prop, hπ_B_iso, hπa_comp⟩,
      ⟨ha_B_prop, hWB_top, hWB_qc⟩,
      hWB_pb⟩

theorem weil_etale_proper_constructible_pushforward (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hP1 : WeilP1ConstructiblePushforwardHolds k ℓ)
    (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    [AlgebraicGeometry.QuasiCompact S.hom]
    [AlgebraicGeometry.IsSeparated S.hom]
    (f : X ⟶ S) (hf : AlgebraicGeometry.IsProper f.left)
    (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
    (hF : WeilIsConstructibleModPrimeSheaf ℓ X.left F) (q : ℕ) :
    WeilIsConstructibleModPrimeSheaf ℓ S.left (weilEtaleHigherDirectImage f.left q F) :=
by
  have hSerre : WeilConstructibleModPrimeSerreHolds k ℓ :=
    weil_etale_constructible_mod_prime_serre_and_local k ℓ
  obtain ⟨hTorsPush, hIsoPush, hClosedPush, hModExc⟩ :=
    weil_etale_closed_immersion_and_modification_excision k ℓ hPBC hSerre
  obtain ⟨hSplitW, hRelChow⟩ :=
    weil_relative_chow_and_noetherian_closed_split k
  have hProjProper : ∀ M : ℕ, AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k M).hom := by
    intro M
    dsimp [weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have _ : IsScalarTower k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
      @IsScalarTower.of_algebraMap_eq k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) _ _ _ _ _ _
        fun _ => rfl
    have _ : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k)
    have hbij : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      refine ⟨fun a b hab => MvPolynomial.C_injective (Fin (M + 1)) k (congrArg Subtype.val hab),
        fun x => ⟨x.1.coeff 0, Subtype.ext ?_⟩⟩
      have hx : MvPolynomial.IsHomogeneous x.1 0 :=
        (MvPolynomial.mem_homogeneousSubmodule 0 x.1).mp x.2
      have hdeg : x.1.totalDegree = 0 := by
        by_cases hx0 : x.1 = 0
        · simp [hx0]
        · exact hx.totalDegree hx0
      exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hdeg).symm
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective
        (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))).mpr hbij
    infer_instance
  have hProjPush : ∀ (N : ℕ)
      (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType B.hom]
      [AlgebraicGeometry.QuasiCompact B.hom]
      [AlgebraicGeometry.IsSeparated B.hom]
      (G : CategoryTheory.Sheaf
        (CategoryTheory.Limits.pullback B.hom (weilProjectiveSpaceOver k N).hom).smallEtaleTopology
        AddCommGrpCat.{u})
      (q' : ℕ),
      WeilIsConstructibleModPrimeSheaf ℓ
        (CategoryTheory.Limits.pullback B.hom (weilProjectiveSpaceOver k N).hom) G →
      WeilIsConstructibleModPrimeSheaf ℓ B.left
        (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) q' G) := by
    intro N
    induction N using Nat.strongRecOn with
    | ind N ihN =>
      intro B _ _ _ G q' hG
      rcases N with _ | _ | m
      · have hIso0 : CategoryTheory.IsIso
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom) :=
          (weil_projSpace_relative_incidence_blowup k B).1
        let X_0 := CategoryTheory.Over.mk
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom ≫ B.hom)
        let p_0 : X_0 ⟶ B :=
          CategoryTheory.Over.homMk
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom) rfl
        exact hIsoPush X_0 B p_0 hIso0 G q' hG
      · exact hP1 B G q' hG
      · have hN2 : 2 ≤ m + 2 := by omega
        obtain ⟨U_B, i_B, P_bar, π_B, a_B, W_B,
            ⟨hi_comp, hi_cl, hi_range⟩,
            ⟨hπ_prop, hπ_iso, hπa_comp⟩,
            ⟨ha_prop, hW_top, hW_qc⟩,
            hW_pb⟩ :=
          (weil_projSpace_relative_incidence_blowup k B).2 (m + 2) hN2
        have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k (m + 2)).hom :=
          hProjProper (m + 2)
        have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k (m + 1)).hom :=
          hProjProper (m + 1)
        have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom :=
          hProjProper 1
        let X_N := CategoryTheory.Over.mk
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k (m + 2)).hom ≫
            B.hom)
        let p_N : X_N ⟶ B :=
          CategoryTheory.Over.homMk
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k (m + 2)).hom) rfl
        let X_1 := CategoryTheory.Over.mk
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom ≫ B.hom)
        let p_1 : X_1 ⟶ B :=
          CategoryTheory.Over.homMk
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom) rfl
        let X_sub := CategoryTheory.Over.mk
          (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k m).hom ≫ B.hom)
        let p_sub : X_sub ⟶ B :=
          CategoryTheory.Over.homMk
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k m).hom) rfl
        have hpN_prop : AlgebraicGeometry.IsProper p_N.left := by
          change AlgebraicGeometry.IsProper
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k (m + 2)).hom)
          infer_instance
        have hp1_prop : AlgebraicGeometry.IsProper p_1.left := by
          change AlgebraicGeometry.IsProper
            (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom)
          infer_instance
        have _ : AlgebraicGeometry.LocallyOfFiniteType X_1.hom := by
          dsimp [X_1]
          infer_instance
        have _ : AlgebraicGeometry.QuasiCompact X_1.hom := by
          dsimp [X_1]
          infer_instance
        have _ : AlgebraicGeometry.IsSeparated X_1.hom := by
          dsimp [X_1]
          infer_instance
        have _ : AlgebraicGeometry.IsProper a_B.left := ha_prop
        have _ : AlgebraicGeometry.IsSeparated P_bar.hom := by
          rw [← CategoryTheory.Over.w a_B]
          infer_instance
        have hPush_a : ∀ (F_bar : CategoryTheory.Sheaf P_bar.left.smallEtaleTopology
              AddCommGrpCat.{u}) (b : ℕ),
            WeilIsConstructibleModPrimeSheaf ℓ P_bar.left F_bar →
            WeilIsConstructibleModPrimeSheaf ℓ X_1.left
              (weilEtaleHigherDirectImage a_B.left b F_bar) := by
          intro F_bar b hF_bar
          apply hSerre.2.2.2.1 X_1.left (weilEtaleHigherDirectImage a_B.left b F_bar)
            (hTorsPush a_B.left F_bar b hF_bar.1) 2 W_B hW_top
          intro c
          obtain ⟨g_c, hpb_c⟩ := hW_pb c
          have _ : AlgebraicGeometry.QuasiCompact (W_B c).ι := hW_qc c
          let B_c := CategoryTheory.Over.mk ((W_B c).ι ≫ X_1.hom)
          have _ : AlgebraicGeometry.LocallyOfFiniteType B_c.hom := by
            dsimp [B_c]
            infer_instance
          have _ : AlgebraicGeometry.QuasiCompact B_c.hom := by
            dsimp [B_c]
            infer_instance
          have _ : AlgebraicGeometry.IsSeparated B_c.hom := by
            dsimp [B_c]
            infer_instance
          let Y_c := CategoryTheory.Over.mk
            (CategoryTheory.Limits.pullback.fst B_c.hom
              (weilProjectiveSpaceOver k (m + 1)).hom ≫ B_c.hom)
          have _ : AlgebraicGeometry.QuasiCompact Y_c.hom := by
            dsimp [Y_c]
            infer_instance
          have hg_c_w : g_c ≫ P_bar.hom = Y_c.hom :=
            (congrArg (g_c ≫ ·) (CategoryTheory.Over.w a_B).symm).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ X_1.hom) hpb_c.w).trans
                  (CategoryTheory.Category.assoc _ _ _)))
          let g_c_over : Y_c ⟶ P_bar := CategoryTheory.Over.homMk g_c hg_c_w
          obtain ⟨F_c, hPull_c, hConst_c⟩ :=
            hSerre.2.2.1 Y_c P_bar g_c_over F_bar
          have hFc : WeilIsConstructibleModPrimeSheaf ℓ Y_c.left F_c := hConst_c hF_bar
          let g_Bc : B_c ⟶ X_1 := CategoryTheory.Over.homMk (W_B c).ι rfl
          let f'_Bc : Y_c ⟶ B_c := CategoryTheory.Over.homMk
            (CategoryTheory.Limits.pullback.fst B_c.hom
              (weilProjectiveSpaceOver k (m + 1)).hom) rfl
          have hPBC_c : WeilIsEtaleSheafPullback (W_B c).ι
              (weilEtaleHigherDirectImage a_B.left b F_bar)
              (weilEtaleHigherDirectImage f'_Bc.left b F_c) :=
            hPBC P_bar X_1 B_c Y_c a_B g_Bc f'_Bc g_c_over ha_prop hpb_c
              F_bar F_c hF_bar.1 hPull_c b
          have hIH_c : WeilIsConstructibleModPrimeSheaf ℓ B_c.left
              (weilEtaleHigherDirectImage f'_Bc.left b F_c) :=
            ihN (m + 1) (by omega) B_c F_c b hFc
          exact ⟨weilEtaleHigherDirectImage f'_Bc.left b F_c, hPBC_c, hIH_c⟩
        have hPush_πpN : ∀ (G_bar : CategoryTheory.Sheaf P_bar.left.smallEtaleTopology
              AddCommGrpCat.{u}) (b : ℕ),
            WeilIsConstructibleModPrimeSheaf ℓ P_bar.left G_bar →
            WeilIsConstructibleModPrimeSheaf ℓ B.left
              (weilEtaleHigherDirectImage (π_B.left ≫ p_N.left) b G_bar) := by
          intro G_bar b hG_bar
          have hcomp_eq : π_B.left ≫ p_N.left = a_B.left ≫ p_1.left :=
            congrArg CategoryTheory.CommaMorphism.left hπa_comp
          rw [hcomp_eq]
          exact weil_etale_proper_composition_constructible k ℓ hSerre P_bar X_1 B
            a_B ha_prop p_1 hp1_prop hPush_a (fun G₁ a₁ hG₁ => hP1 B G₁ a₁ hG₁)
            G_bar hG_bar b
        have hPush_ipN : ∀ (G_Y : CategoryTheory.Sheaf X_sub.left.smallEtaleTopology
              AddCommGrpCat.{u}) (b : ℕ),
            WeilIsConstructibleModPrimeSheaf ℓ X_sub.left G_Y →
            WeilIsConstructibleModPrimeSheaf ℓ B.left
              (weilEtaleHigherDirectImage (i_B.left ≫ p_N.left) b G_Y) := by
          intro G_Y b hG_Y
          have hcomp_eq : i_B.left ≫ p_N.left = p_sub.left :=
            congrArg CategoryTheory.CommaMorphism.left hi_comp
          rw [hcomp_eq]
          exact ihN m (by omega) B G_Y b hG_Y
        exact hModExc X_N P_bar X_sub B p_N π_B U_B i_B hpN_prop hπ_prop hπ_iso hi_cl hi_range
          hPush_πpN hPush_ipN G q' hG
  have hEmptyPush : ∀ {W : AlgebraicGeometry.Scheme.{u}} [IsEmpty ↥W]
      (h : W ⟶ S.left)
      (G : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) (q' : ℕ),
      WeilIsConstructibleModPrimeSheaf ℓ S.left (weilEtaleHigherDirectImage h q' G) := by
    intro W _ h G q'
    apply (hSerre.1 S.left _).2
    have hZeroG : CategoryTheory.Limits.IsZero G := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext E : 3
      let hEW : E.unop.left ⟶ W := E.unop.hom
      have _ : IsEmpty ↥E.unop.left := ⟨fun x => IsEmpty.false (hEW.base x)⟩
      have hbot : ⊥ ∈ W.smallEtaleTopology E.unop := by
        let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
          @AlgebraicGeometry.Etale
        let E' : P.Over ⊤ W := E.unop
        change (⊥ : CategoryTheory.Sieve E') ∈
          ((CategoryTheory.MorphismProperty.Over.forget P ⊤ W).restrictedTopology
            (AlgebraicGeometry.Scheme.overGrothendieckTopology P W)) E'
        rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
        exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
          (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
            (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
      exact (G.isTerminalOfBotCover E.unop hbot).isZero.eq_of_src _ _
    dsimp [weilEtaleHigherDirectImage]
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S.left.Etale W.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hZeroBP : CategoryTheory.Limits.IsZero
        (CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf G q')) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext U : 2
      have hZeroObj : CategoryTheory.Limits.IsZero
          ((CategoryTheory.Sheaf.cohomologyPresheaf G q').obj (Opposite.op (B.obj U.unop))) := by
        dsimp [CategoryTheory.Sheaf.cohomologyPresheaf,
          CategoryTheory.Sheaf.cohomologyPresheafFunctor, CategoryTheory.Abelian.extFunctor]
        exact (CategoryTheory.Abelian.extFunctorObj _ q').map_isZero hZeroG
      exact hZeroObj.eq_of_src _ _
    exact (CategoryTheory.presheafToSheaf S.left.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
      hZeroBP
  have _ : AlgebraicGeometry.IsProper f.left := hf
  have _ : AlgebraicGeometry.LocallyOfFiniteType X.hom := by
    rw [← CategoryTheory.Over.w f]
    infer_instance
  have _ : AlgebraicGeometry.QuasiCompact X.hom := by
    rw [← CategoryTheory.Over.w f]
    infer_instance
  have _ : AlgebraicGeometry.IsLocallyNoetherian X.left :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian X.hom
  have _ : CompactSpace ↥X.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
  have _ : AlgebraicGeometry.IsNoetherian X.left := ⟨⟩
  have _ : WellFoundedGT X.left.Opens :=
    AlgebraicGeometry.IsNoetherian.noetherianSpace
  have hClosedInd : ∀ (O : X.left.Opens)
      (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (iW : W ⟶ X),
      AlgebraicGeometry.IsClosedImmersion iW.left →
      (O : Set X.left) = (Set.range iW.left.base)ᶜ →
      ∀ (G : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}) (q' : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ W.left G →
        WeilIsConstructibleModPrimeSheaf ℓ S.left
          (weilEtaleHigherDirectImage (iW.left ≫ f.left) q' G) := by
    intro O
    refine WellFoundedGT.induction
      (motive := fun O : X.left.Opens =>
        ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (iW : W ⟶ X),
          AlgebraicGeometry.IsClosedImmersion iW.left →
          (O : Set X.left) = (Set.range iW.left.base)ᶜ →
          ∀ (G : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}) (q' : ℕ),
            WeilIsConstructibleModPrimeSheaf ℓ W.left G →
            WeilIsConstructibleModPrimeSheaf ℓ S.left
              (weilEtaleHigherDirectImage (iW.left ≫ f.left) q' G))
      O fun O ihO W iW hiW hO_eq G q' hG => ?_
    have _ : AlgebraicGeometry.IsClosedImmersion iW.left := hiW
    rcases hSplitW W.left with hEmpW | ⟨W_red, i_red, hi_red_cl, hi_red_range, _, hIntOrSplit⟩
    · exact @hEmptyPush W.left hEmpW (iW.left ≫ f.left) G q'
    · have _ : AlgebraicGeometry.IsClosedImmersion i_red := hi_red_cl
      let W_red_over := CategoryTheory.Over.mk (i_red ≫ W.hom)
      let i_red_over : W_red_over ⟶ W := CategoryTheory.Over.homMk i_red rfl
      let U_bot : W.left.Opens := ⊥
      let W_bot_over := CategoryTheory.Over.mk (U_bot.ι ≫ W.hom)
      let π_bot : W_bot_over ⟶ W := CategoryTheory.Over.homMk U_bot.ι rfl
      have hEmpBot : IsEmpty ↥U_bot.toScheme := ⟨fun x => x.2⟩
      have hiWf_prop : AlgebraicGeometry.IsProper (iW ≫ f).left := by
        change AlgebraicGeometry.IsProper (iW.left ≫ f.left)
        infer_instance
      have hπ_bot_prop : AlgebraicGeometry.IsProper π_bot.left := by
        change AlgebraicGeometry.IsProper U_bot.ι
        infer_instance
      have hπ_bot_iso : CategoryTheory.IsIso (π_bot.left ∣_ U_bot) :=
        AlgebraicGeometry.isIso_of_isEmpty (U_bot.ι ∣_ U_bot)
      have hi_red_compl : Set.range i_red_over.left.base = (U_bot : Set W.left)ᶜ := by
        change Set.range i_red.base = (∅ : Set W.left)ᶜ
        rw [hi_red_range]
        exact Set.compl_empty.symm
      refine hModExc W W_bot_over W_red_over S (iW ≫ f) π_bot U_bot i_red_over
        hiWf_prop hπ_bot_prop hπ_bot_iso hi_red_cl hi_red_compl
        (fun G_bot b _ => @hEmptyPush W_bot_over.left hEmpBot
          (π_bot.left ≫ (iW ≫ f).left) G_bot b)
        (?_) G q' hG
      intro G_red b hG_red
      let j_over : W_red_over ⟶ X := i_red_over ≫ iW
      let f_W : W_red_over ⟶ S := j_over ≫ f
      have hj_cl : AlgebraicGeometry.IsClosedImmersion j_over.left := by
        change AlgebraicGeometry.IsClosedImmersion (i_red ≫ iW.left)
        infer_instance
      have hfW_prop : AlgebraicGeometry.IsProper f_W.left := by
        change AlgebraicGeometry.IsProper ((i_red ≫ iW.left) ≫ f.left)
        infer_instance
      have hj_range : Set.range j_over.left.base = Set.range iW.left.base := by
        have hbase : ⇑j_over.left.base = ⇑iW.left.base ∘ ⇑i_red.base := rfl
        rw [hbase, Set.range_comp, hi_red_range, Set.image_univ]
      have hSubStrict : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (k_Z : Z ⟶ W_red)
          [AlgebraicGeometry.IsClosedImmersion k_Z],
          (∃ w : W_red, w ∉ Set.range k_Z.base) →
          ∀ (G_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (b' : ℕ),
            WeilIsConstructibleModPrimeSheaf ℓ Z G_Z →
            WeilIsConstructibleModPrimeSheaf ℓ S.left
              (weilEtaleHigherDirectImage (k_Z ≫ f_W.left) b' G_Z) := by
        intro Z k_Z _ ⟨w, hw⟩ G_Z b' hG_Z
        let Z_over := CategoryTheory.Over.mk (k_Z ≫ W_red_over.hom)
        let k_over : Z_over ⟶ X :=
          (CategoryTheory.Over.homMk k_Z rfl : Z_over ⟶ W_red_over) ≫ j_over
        have hk_cl : AlgebraicGeometry.IsClosedImmersion k_over.left := by
          change AlgebraicGeometry.IsClosedImmersion (k_Z ≫ j_over.left)
          infer_instance
        let O_Z : X.left.Opens :=
          ⟨(Set.range k_over.left.base)ᶜ,
            (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding k_over.left).isClosed_range.isOpen_compl⟩
        have hlt : O < O_Z := by
          rw [SetLike.lt_iff_le_and_exists]
          have hk_base : ⇑k_over.left.base = ⇑j_over.left.base ∘ ⇑k_Z.base := rfl
          refine ⟨?_, j_over.left.base w, ?_, ?_⟩
          · intro x hx
            change x ∈ (O : Set X.left) at hx
            rw [hO_eq, ← hj_range] at hx
            change x ∈ (Set.range k_over.left.base)ᶜ
            rw [hk_base]
            rintro ⟨z, rfl⟩
            exact hx ⟨k_Z.base z, rfl⟩
          · change j_over.left.base w ∈ (Set.range k_over.left.base)ᶜ
            rw [hk_base]
            rintro ⟨z, hz⟩
            exact hw ⟨z, (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding
              j_over.left).injective hz⟩
          · change j_over.left.base w ∉ (O : Set X.left)
            rw [hO_eq, ← hj_range]
            exact fun h => h ⟨w, rfl⟩
        have hcomp_Z : k_Z ≫ f_W.left = k_over.left ≫ f.left := by
          change k_Z ≫ (j_over.left ≫ f.left) = (k_Z ≫ j_over.left) ≫ f.left
          exact (CategoryTheory.Category.assoc _ _ _).symm
        rw [hcomp_Z]
        exact ihO O_Z hlt Z_over k_over hk_cl rfl G_Z b' hG_Z
      change WeilIsConstructibleModPrimeSheaf ℓ S.left
        (weilEtaleHigherDirectImage f_W.left b G_red)
      rcases hIntOrSplit with hIntW | ⟨O₁, W₁, W₂, i₁, i₂, hO₁_ne, hW₂_compl_ne,
          hi₁_cl, hi₂_cl, hi₁_range, hi₂_iso⟩
      · obtain ⟨V₀, π₀, U₀, N, ι_S, _, hπ₀_prop, _, hU₀_ne, hπ₀_iso, hιS_cl, hιS_comp⟩ :=
          hRelChow W_red_over S f_W hfW_prop hIntW
        have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := hProjProper N
        let X_NS := CategoryTheory.Over.mk
          (CategoryTheory.Limits.pullback.fst S.hom (weilProjectiveSpaceOver k N).hom ≫ S.hom)
        let p_NS : X_NS ⟶ S := CategoryTheory.Over.homMk
          (CategoryTheory.Limits.pullback.fst S.hom (weilProjectiveSpaceOver k N).hom) rfl
        have hpNS_prop : AlgebraicGeometry.IsProper p_NS.left := by
          change AlgebraicGeometry.IsProper
            (CategoryTheory.Limits.pullback.fst S.hom (weilProjectiveSpaceOver k N).hom)
          infer_instance
        have hιS_w : ι_S ≫ X_NS.hom = V₀.hom :=
          (CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ S.hom) hιS_comp).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (π₀.left ≫ ·) (CategoryTheory.Over.w f_W)).trans
                  (CategoryTheory.Over.w π₀))))
        let ι_S_over : V₀ ⟶ X_NS := CategoryTheory.Over.homMk ι_S hιS_w
        have hPush_π₀ : ∀ (G_V : CategoryTheory.Sheaf V₀.left.smallEtaleTopology
              AddCommGrpCat.{u}) (b' : ℕ),
            WeilIsConstructibleModPrimeSheaf ℓ V₀.left G_V →
            WeilIsConstructibleModPrimeSheaf ℓ S.left
              (weilEtaleHigherDirectImage (π₀.left ≫ f_W.left) b' G_V) := by
          intro G_V b' hG_V
          rw [← hιS_comp]
          exact hClosedPush V₀ X_NS S ι_S_over p_NS hιS_cl hpNS_prop
            (fun G_P b'' hG_P => hProjPush N S G_P b'' hG_P) G_V b' hG_V
        let Z_cl : TopologicalSpace.Closeds ↥W_red_over.left :=
          ⟨(U₀ : Set W_red_over.left)ᶜ, U₀.isOpen.isClosed_compl⟩
        let I₀ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_cl
        let Y₀_over := CategoryTheory.Over.mk (I₀.subschemeι ≫ W_red_over.hom)
        let i₀_over : Y₀_over ⟶ W_red_over := CategoryTheory.Over.homMk I₀.subschemeι rfl
        have hi₀_cl : AlgebraicGeometry.IsClosedImmersion i₀_over.left := by
          change AlgebraicGeometry.IsClosedImmersion I₀.subschemeι
          infer_instance
        have hi₀_range : Set.range I₀.subschemeι.base = (U₀ : Set W_red_over.left)ᶜ := by
          rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
            AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
          rfl
        obtain ⟨u₀⟩ := hU₀_ne
        have hu₀_not : u₀.1 ∉ Set.range I₀.subschemeι.base := by
          rw [hi₀_range]
          exact fun h => h u₀.2
        exact hModExc W_red_over V₀ Y₀_over S f_W π₀ U₀ i₀_over
          hfW_prop hπ₀_prop hπ₀_iso hi₀_cl hi₀_range hPush_π₀
          (hSubStrict I₀.subscheme I₀.subschemeι ⟨u₀.1, hu₀_not⟩) G_red b hG_red
      · have _ : AlgebraicGeometry.IsClosedImmersion i₁ := hi₁_cl
        have _ : AlgebraicGeometry.IsClosedImmersion i₂ := hi₂_cl
        have hi₂_prop : AlgebraicGeometry.IsProper i₂ := inferInstance
        let W₁_over := CategoryTheory.Over.mk (i₁ ≫ W_red_over.hom)
        let i₁_over : W₁_over ⟶ W_red_over := CategoryTheory.Over.homMk i₁ rfl
        let W₂_over := CategoryTheory.Over.mk (i₂ ≫ W_red_over.hom)
        let i₂_over : W₂_over ⟶ W_red_over := CategoryTheory.Over.homMk i₂ rfl
        obtain ⟨o₁⟩ := hO₁_ne
        have ho₁_not : o₁.1 ∉ Set.range i₁.base := by
          rw [hi₁_range]
          exact fun h => h o₁.2
        obtain ⟨w₂⟩ := hW₂_compl_ne
        exact hModExc W_red_over W₂_over W₁_over S f_W i₂_over O₁ i₁_over
          hfW_prop hi₂_prop hi₂_iso hi₁_cl hi₁_range
          (hSubStrict W₂ i₂ ⟨w₂.1, w₂.2⟩)
          (hSubStrict W₁ i₁ ⟨o₁.1, ho₁_not⟩)
          G_red b hG_red
  have hId_cl : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.CategoryStruct.id X : X ⟶ X).left := by
    change AlgebraicGeometry.IsClosedImmersion (𝟙 X.left)
    infer_instance
  have hBot_eq : ((⊥ : X.left.Opens) : Set X.left) =
      (Set.range (CategoryTheory.CategoryStruct.id X : X ⟶ X).left.base)ᶜ :=
    Set.ext fun x => ⟨False.elim, fun hx => hx ⟨x, rfl⟩⟩
  have hId_comp : (CategoryTheory.CategoryStruct.id X : X ⟶ X).left ≫ f.left = f.left :=
    CategoryTheory.Category.id_comp f.left
  rw [← hId_comp]
  exact hClosedInd ⊥ X (𝟙 X) hId_cl hBot_eq F q hF

theorem weil_etale_proper_torsion_finiteness (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Z.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K) (i r : ℕ) :
    Finite (weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i) :=
by
  classical
  let k : Type u := AlgebraicClosure K
  let S_over := weilBaseChangeOver K k Z
  have hPropS : AlgebraicGeometry.IsProper S_over.hom := by
    dsimp [S_over, weilBaseChangeOver]
    infer_instance
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hℓ_prime.pos
  have hℓ_k : (ℓ : k) ≠ 0 := by
    intro h0
    have hK0 : (ℓ : K) = 0 := by
      apply (algebraMap K k).injective
      rw [map_natCast, map_zero]
      exact h0
    have hdvd : ringChar K ∣ ℓ := (ringChar.spec K ℓ).mp hK0
    rcases CharP.char_is_prime_or_zero K (ringChar K) with hp | hp0
    · exact hℓ ((Nat.Prime.dvd_iff_eq hℓ_prime hp.ne_one).mp hdvd)
    · rw [hp0, zero_dvd_iff] at hdvd
      exact hℓ_prime.ne_zero hdvd
  let B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
  have : AlgebraicGeometry.LocallyOfFiniteType B₀.hom := by
    dsimp [B₀]
    infer_instance
  have : AlgebraicGeometry.QuasiCompact B₀.hom := by
    dsimp [B₀]
    infer_instance
  have : AlgebraicGeometry.IsSeparated B₀.hom := by
    dsimp [B₀]
    infer_instance
  let f₀ : S_over ⟶ B₀ :=
    CategoryTheory.Over.homMk S_over.hom (CategoryTheory.Category.comp_id S_over.hom)
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ_k
  have hP1 : WeilP1ConstructiblePushforwardHolds k ℓ :=
    weil_etale_p1_constructible_pushforward k ℓ hℓ_k
      (fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
        weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀)
      hPBC
  obtain ⟨hConstSheaf, hExtract⟩ :=
    weil_etale_constructible_mod_prime_extraction_over_algClosed k S_over ℓ i
  have hPrime : Finite (weilEtaleTorsionH (weilGeomScheme K Z) ℓ i) :=
    hExtract (weil_etale_proper_constructible_pushforward k ℓ hℓ_k hPBC hP1
      S_over B₀ f₀ hPropS (weilEtaleTorsionSheaf S_over.left ℓ) hConstSheaf i)
  let S := weilGeomScheme K Z
  let C := CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let U := AddCommGrpCat.uliftFunctor.{u, 0}
  induction r with
  | zero =>
    change Finite ((weilEtaleTorsionSheaf S 1).H i)
    let A₁ := U.obj (AddCommGrpCat.of (ZMod 1))
    have hZeroA₁ : CategoryTheory.Limits.IsZero A₁ := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext ⟨x⟩
      exact ULift.ext _ _ (Subsingleton.elim _ _)
    have hZeroSh : CategoryTheory.Limits.IsZero (weilEtaleTorsionSheaf S 1) :=
      C.map_isZero hZeroA₁
    have hSub : Subsingleton ((weilEtaleTorsionSheaf S 1).H i) :=
      CategoryTheory.Sheaf.subsingleton_H_of_isZero hZeroSh i
    exact Finite.of_subsingleton
  | succ r ih =>
    have : NeZero ℓ := ⟨hℓ_prime.ne_zero⟩
    have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hℓ_prime.ne_zero⟩
    have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_prime.ne_zero⟩
    let ι_hom : ZMod (ℓ ^ r) →+ ZMod (ℓ ^ (r + 1)) :=
      { toFun := fun x => ((ℓ * x.val : ℕ) : ZMod (ℓ ^ (r + 1)))
        map_zero' := by simp
        map_add' := fun x y => by
          have hdiv := Nat.div_add_mod (x.val + y.val) (ℓ ^ r)
          rw [ZMod.val_add]
          have hmul : ℓ * (x.val + y.val) =
              ℓ ^ (r + 1) * ((x.val + y.val) / ℓ ^ r) + ℓ * ((x.val + y.val) % ℓ ^ r) := by
            calc
              ℓ * (x.val + y.val) =
                  ℓ * (ℓ ^ r * ((x.val + y.val) / ℓ ^ r) + (x.val + y.val) % ℓ ^ r) :=
                congrArg (ℓ * ·) hdiv.symm
              _ = (ℓ * ℓ ^ r) * ((x.val + y.val) / ℓ ^ r) + ℓ * ((x.val + y.val) % ℓ ^ r) := by
                ring
              _ = ℓ ^ (r + 1) * ((x.val + y.val) / ℓ ^ r) + ℓ * ((x.val + y.val) % ℓ ^ r) := by
                rw [pow_succ']
          have hcast : ((ℓ * (x.val + y.val) : ℕ) : ZMod (ℓ ^ (r + 1))) =
              ((ℓ * ((x.val + y.val) % ℓ ^ r) : ℕ) : ZMod (ℓ ^ (r + 1))) := by
            rw [hmul, Nat.cast_add, Nat.cast_mul, CharP.cast_eq_zero, zero_mul, zero_add]
          rw [← hcast, mul_add, Nat.cast_add] }
    let ρ_hom : ZMod (ℓ ^ (r + 1)) →+ ZMod ℓ :=
      (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)).toAddMonoidHom
    have hι_inj : Function.Injective ι_hom := by
      intro x y hxy
      have hx_lt : ℓ * x.val < ℓ ^ (r + 1) := by
        rw [pow_succ']
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt x) hℓ_pos
      have hy_lt : ℓ * y.val < ℓ ^ (r + 1) := by
        rw [pow_succ']
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt y) hℓ_pos
      have hval : (ι_hom x).val = (ι_hom y).val := congrArg ZMod.val hxy
      dsimp [ι_hom] at hval
      rw [ZMod.val_natCast_of_lt hx_lt, ZMod.val_natCast_of_lt hy_lt] at hval
      exact ZMod.val_injective _ (Nat.mul_left_cancel hℓ_pos hval)
    have hρ_surj : Function.Surjective ρ_hom :=
      ZMod.castHom_surjective (dvd_pow_self ℓ (Nat.succ_ne_zero r))
    have hcomp0 : ∀ x : ZMod (ℓ ^ r), ρ_hom (ι_hom x) = 0 := by
      intro x
      change ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)
        ((ℓ * x.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0
      rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero, zero_mul]
    have hexact0 : ∀ z : ZMod (ℓ ^ (r + 1)), ρ_hom z = 0 → ∃ x : ZMod (ℓ ^ r), ι_hom x = z := by
      intro z hz
      have hz_cast : (z.val : ZMod ℓ) = 0 := by
        have h1 : ρ_hom ((z.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 := by
          rwa [ZMod.natCast_zmod_val]
        change ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)
          ((z.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 at h1
        rwa [map_natCast] at h1
      obtain ⟨q, hq⟩ := (ZMod.natCast_eq_zero_iff z.val ℓ).mp hz_cast
      have hq_lt : q < ℓ ^ r := by
        have hz_lt : z.val < ℓ * ℓ ^ r := by
          rw [← pow_succ']
          exact ZMod.val_lt z
        rw [hq] at hz_lt
        exact (Nat.mul_lt_mul_left hℓ_pos).mp hz_lt
      refine ⟨(q : ZMod (ℓ ^ r)), ?_⟩
      dsimp [ι_hom]
      rw [ZMod.val_natCast_of_lt hq_lt, ← hq, ZMod.natCast_zmod_val]
    let fU : U.obj (AddCommGrpCat.of (ZMod (ℓ ^ r))) ⟶
        U.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1)))) :=
      U.map (AddCommGrpCat.ofHom ι_hom)
    let gU : U.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1)))) ⟶
        U.obj (AddCommGrpCat.of (ZMod ℓ)) :=
      U.map (AddCommGrpCat.ofHom ρ_hom)
    have hfgU : fU ≫ gU = 0 := by
      ext ⟨x⟩
      exact ULift.ext _ _ (hcomp0 x)
    let SC₀ : CategoryTheory.ShortComplex AddCommGrpCat.{u} :=
      CategoryTheory.ShortComplex.mk fU gU hfgU
    have : CategoryTheory.Mono SC₀.f := by
      rw [AddCommGrpCat.mono_iff_injective]
      intro ⟨x⟩ ⟨y⟩ hxy
      exact congrArg ULift.up (hι_inj (congrArg ULift.down hxy))
    have : CategoryTheory.Epi SC₀.g := by
      rw [AddCommGrpCat.epi_iff_surjective]
      intro ⟨z⟩
      obtain ⟨y, hy⟩ := hρ_surj z
      exact ⟨ULift.up y, ULift.ext _ _ hy⟩
    have hSC₀_exact : SC₀.Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff_range_eq_ker]
      ext w
      constructor
      · rintro ⟨⟨x⟩, rfl⟩
        exact ULift.ext _ _ (hcomp0 x)
      · intro hw
        obtain ⟨x, hx⟩ := hexact0 w.down (congrArg ULift.down hw)
        exact ⟨ULift.up x, ULift.ext _ _ hx⟩
    have hSE₀ : SC₀.ShortExact :=
      { exact := hSC₀_exact }
    have : CategoryTheory.Limits.PreservesFiniteLimits C := by
      dsimp [C, CategoryTheory.constantSheaf]
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteColimits C := by
      dsimp [C]
      infer_instance
    have : C.Additive := by
      dsimp [C]
      infer_instance
    have hSE : (SC₀.map C).ShortExact := hSE₀.map_of_exact C
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let f_ext : weilEtaleTorsionH S (ℓ ^ r) i →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) i :=
      (CategoryTheory.Abelian.Ext.mk₀ (SC₀.map C).f).postcomp Fℤ (Nat.add_zero i)
    let g_ext : weilEtaleTorsionH S (ℓ ^ (r + 1)) i →+ weilEtaleTorsionH S ℓ i :=
      (CategoryTheory.Abelian.Ext.mk₀ (SC₀.map C).g).postcomp Fℤ (Nat.add_zero i)
    have hexact_H : ∀ b : weilEtaleTorsionH S (ℓ ^ (r + 1)) i,
        g_ext b = 0 → ∃ a : weilEtaleTorsionH S (ℓ ^ r) i, f_ext a = b := by
      intro b hb
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE b hb
    have : Finite (weilEtaleTorsionH S (ℓ ^ r) i) := ih
    have : Finite (weilEtaleTorsionH S ℓ i) := hPrime
    have : Finite (Set.range g_ext) := Subtype.finite
    let Φ : weilEtaleTorsionH S (ℓ ^ r) i × Set.range g_ext →
        weilEtaleTorsionH S (ℓ ^ (r + 1)) i :=
      fun p => f_ext p.1 + p.2.2.choose
    have hΦ_surj : Function.Surjective Φ := by
      intro b
      let q : Set.range g_ext := ⟨g_ext b, ⟨b, rfl⟩⟩
      have hq : g_ext q.2.choose = g_ext b := q.2.choose_spec
      have hsub : g_ext (b - q.2.choose) = 0 := by
        rw [map_sub, hq, sub_self]
      obtain ⟨a, ha⟩ := hexact_H (b - q.2.choose) hsub
      refine ⟨(a, q), ?_⟩
      dsimp [Φ]
      rw [ha, sub_add_cancel]
    exact Finite.of_surjective Φ hΦ_surj

theorem weil_etale_model_of_torsion_finite (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ)
    (hFin : ∀ r : ℕ, Finite (weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i)) :
    Nonempty (WeilEllAdicCohomologyModel K Z ℓ i) :=
by
  classical
  
  have hPillar1 :
      ∃ frobTorsion : ∀ r : ℕ, weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i →+
          weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) i,
        (∀ r : ℕ, WeilIsTorsionGeomFrobAction K Z (ℓ ^ r) i (frobTorsion r)) ∧
        (∀ (r : ℕ) (w : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) i),
          weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r i (frobTorsion (r + 1) w) =
            frobTorsion r (weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r i w)) := by
    let S := weilGeomScheme K Z
    let g := weilGeomFrobHom K Z
    let φ := @FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
      (AlgebraicClosure K) _ _ _
    let ψ := φ.symm
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    let i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
    let i₂' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom)
    have hcomp' : CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
        (CommRingCat.ofHom φ.toRingHom) =
        CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)) :=
      (CommRingCat.ofHom_comp _ _).symm.trans (congrArg CommRingCat.ofHom (RingHom.ext φ.commutes))
    let g_inv : S ⟶ S :=
      CategoryTheory.Limits.pullback.map Z.hom f₂ Z.hom f₂
        (𝟙 Z.left) i₂' (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)))
        ((CategoryTheory.Category.comp_id Z.hom).trans (CategoryTheory.Category.id_comp Z.hom).symm)
        ((CategoryTheory.Category.comp_id f₂).trans
          ((congrArg AlgebraicGeometry.Spec.map hcomp'.symm).trans
            (AlgebraicGeometry.Spec.map_comp _ _)))
    have hi₂_comp : i₂ ≫ i₂' = 𝟙 _ := by
      dsimp [i₂, i₂']
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h1 : RingHom.comp (ψ : AlgebraicClosure K →+* AlgebraicClosure K)
          (φ : AlgebraicClosure K →+* AlgebraicClosure K) = RingHom.id _ := by
        ext x; exact φ.symm_apply_apply x
      rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have hi₂'_comp : i₂' ≫ i₂ = 𝟙 _ := by
      dsimp [i₂, i₂']
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h1 : RingHom.comp (φ : AlgebraicClosure K →+* AlgebraicClosure K)
          (ψ : AlgebraicClosure K →+* AlgebraicClosure K) = RingHom.id _ := by
        ext x; exact φ.apply_symm_apply x
      rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    let fstS : S ⟶ Z.left := CategoryTheory.Limits.pullback.fst Z.hom f₂
    let sndS : S ⟶ AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K)) :=
      CategoryTheory.Limits.pullback.snd Z.hom f₂
    have hg_fst : g ≫ fstS = fstS ≫ 𝟙 Z.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hg_snd : g ≫ sndS = sndS ≫ i₂ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hginv_fst : g_inv ≫ fstS = fstS ≫ 𝟙 Z.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hginv_snd : g_inv ≫ sndS = sndS ≫ i₂' :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hg_inv : g ≫ g_inv = 𝟙 S := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (g ≫ g_inv) ≫ fstS = 𝟙 S ≫ fstS
        rw [Category.assoc, hginv_fst, Category.comp_id, hg_fst, Category.comp_id, Category.id_comp]
      · change (g ≫ g_inv) ≫ sndS = 𝟙 S ≫ sndS
        rw [Category.assoc, hginv_snd, ← Category.assoc, hg_snd, Category.assoc, hi₂_comp,
            Category.comp_id, Category.id_comp]
    have hinv_g : g_inv ≫ g = 𝟙 S := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (g_inv ≫ g) ≫ fstS = 𝟙 S ≫ fstS
        rw [Category.assoc, hg_fst, Category.comp_id, hginv_fst, Category.comp_id, Category.id_comp]
      · change (g_inv ≫ g) ≫ sndS = 𝟙 S ≫ sndS
        rw [Category.assoc, hg_snd, ← Category.assoc, hginv_snd, Category.assoc, hi₂'_comp,
            Category.comp_id, Category.id_comp]
    letI : CategoryTheory.IsIso g := ⟨⟨g_inv, hg_inv, hinv_g⟩⟩
    letI : CategoryTheory.IsIso g_inv := ⟨⟨g, hinv_g, hg_inv⟩⟩
    have hg_et : AlgebraicGeometry.Etale g := inferInstance
    have hginv_et : AlgebraicGeometry.Etale g_inv := inferInstance
    let PEt : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    haveI : PEt.IsStableUnderComposition := inferInstance
    haveI : PEt.IsStableUnderBaseChange := inferInstance
    haveI : PEt.IsMultiplicative := inferInstance
    haveI : PEt.RespectsIso := inferInstance
    haveI : PEt.HasOfPostcompProperty PEt := inferInstance
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    have etale_hom_ext : ∀ {A B : S.Etale} {u v : A ⟶ B},
        (Fgt.map u).left = (Fgt.map v).left → u = v := by
      intro A B u v h
      exact Fgt.map_injective (CategoryTheory.Over.OverMorphism.ext h)
    have etale_w : ∀ {A B : S.Etale} (u : A ⟶ B),
        (Fgt.map u).left ≫ (Fgt.obj B).hom = (Fgt.obj A).hom := by
      intro A B u
      exact CategoryTheory.Over.w (Fgt.map u)
    let mkPost (h : S ⟶ S) (hh : AlgebraicGeometry.Etale h) : S.Etale ⥤ S.Etale :=
      { obj := fun U => CategoryTheory.MorphismProperty.Over.mk (P := PEt) ⊤ ((Fgt.obj U).hom ≫ h)
          (CategoryTheory.MorphismProperty.comp_mem PEt (Fgt.obj U).hom h U.prop hh)
        map := fun {U₁ U₂} u => CategoryTheory.MorphismProperty.Over.homMk (P := PEt) (Q := ⊤)
          (Fgt.map u).left
          (by
            change (Fgt.map u).left ≫ ((Fgt.obj U₂).hom ≫ h) = (Fgt.obj U₁).hom ≫ h
            rw [← Category.assoc, etale_w u])
        map_id := fun U => etale_hom_ext rfl
        map_comp := fun f₁ f₂ => etale_hom_ext rfl }
    let G : S.Etale ⥤ S.Etale := mkPost g hg_et
    let G_inv : S.Etale ⥤ S.Etale := mkPost g_inv hginv_et
    let η_G : 𝟭 S.Etale ≅ G ⋙ G_inv :=
      NatIso.ofComponents
        (fun U => CategoryTheory.MorphismProperty.Over.isoMk (P := PEt) (Q := ⊤)
          (Iso.refl (Fgt.obj U).left)
          (by
            change 𝟙 (Fgt.obj U).left ≫ (((Fgt.obj U).hom ≫ g) ≫ g_inv) = (Fgt.obj U).hom
            rw [Category.id_comp, Category.assoc, hg_inv, Category.comp_id]))
        (fun {U₁ U₂} u => etale_hom_ext (by
          change (Fgt.map u).left ≫ 𝟙 (Fgt.obj U₂).left = 𝟙 (Fgt.obj U₁).left ≫ (Fgt.map u).left
          rw [Category.comp_id, Category.id_comp]))
    let ε_G : G_inv ⋙ G ≅ 𝟭 S.Etale :=
      NatIso.ofComponents
        (fun U => CategoryTheory.MorphismProperty.Over.isoMk (P := PEt) (Q := ⊤)
          (Iso.refl (Fgt.obj U).left)
          (by
            change 𝟙 (Fgt.obj U).left ≫ (Fgt.obj U).hom = ((Fgt.obj U).hom ≫ g_inv) ≫ g
            rw [Category.id_comp, Category.assoc, hinv_g, Category.comp_id]))
        (fun {U₁ U₂} u => etale_hom_ext (by
          change (Fgt.map u).left ≫ 𝟙 (Fgt.obj U₂).left = 𝟙 (Fgt.obj U₁).left ≫ (Fgt.map u).left
          rw [Category.comp_id, Category.id_comp]))
    let e_site : S.Etale ≌ S.Etale :=
      { functor := G
        inverse := G_inv
        unitIso := η_G
        counitIso := ε_G
        functor_unitIso_comp := fun U => etale_hom_ext (by
          change 𝟙 (Fgt.obj U).left ≫ 𝟙 (Fgt.obj U).left = 𝟙 (Fgt.obj U).left
          rw [Category.comp_id]) }
    let J := S.smallEtaleTopology
    have hJ_pre : AlgebraicGeometry.Scheme.smallGrothendieckTopology PEt S =
        (AlgebraicGeometry.Scheme.smallPretopology PEt PEt (S := S)).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
        (le_refl PEt)
    have hmemJ : ∀ (V : PEt.Over ⊤ S) (R : CategoryTheory.Sieve V),
        R ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology PEt S) V ↔
          ∀ (x : ↥V.left), ∃ (Y : PEt.Over ⊤ S) (f : Y ⟶ V) (y : ↥Y.left),
            R.arrows f ∧ PEt f.left ∧ f.left.base y = x := by
      intro V R
      rw [hJ_pre]
      exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology V R
    have hCocont : ∀ (h₁ h₂ : S ⟶ S) (hh₁ : AlgebraicGeometry.Etale h₁)
        (hh₂ : AlgebraicGeometry.Etale h₂) (h12 : h₁ ≫ h₂ = 𝟙 S) (h21 : h₂ ≫ h₁ = 𝟙 S),
        (mkPost h₁ hh₁).IsCocontinuous J J := by
      intro h₁ h₂ hh₁ hh₂ h12 h21
      let F₁ := mkPost h₁ hh₁
      let F₂ := mkPost h₂ hh₂
      refine ⟨fun {U R} hR => ?_⟩
      have hR' := (hmemJ (F₁.obj U) R).mp hR
      refine (hmemJ U (CategoryTheory.Sieve.functorPullback F₁ R)).mpr fun x => ?_
      obtain ⟨Y, f, y, hfR, hfEt, hfy⟩ := hR' x
      let Y_et : S.Etale := Y
      let f_et : Y_et ⟶ F₁.obj U := f
      let f_left : (Fgt.obj Y_et).left ⟶ (Fgt.obj U).left := (Fgt.map f_et).left
      let u_hom : (Fgt.obj U).left ⟶ S := (Fgt.obj U).hom
      let y_hom : (Fgt.obj Y_et).left ⟶ S := (Fgt.obj Y_et).hom
      let Y' : S.Etale := F₂.obj Y_et
      let f' : Y' ⟶ U := CategoryTheory.MorphismProperty.Over.homMk (P := PEt) (Q := ⊤)
        f_left (by
          have hw : f_left ≫ (u_hom ≫ h₁) = y_hom := etale_w f_et
          change f_left ≫ u_hom = y_hom ≫ h₂
          calc
            f_left ≫ u_hom = f_left ≫ u_hom ≫ (h₁ ≫ h₂) := by rw [h12, Category.comp_id]
            _ = (f_left ≫ (u_hom ≫ h₁)) ≫ h₂ := by simp only [Category.assoc]
            _ = y_hom ≫ h₂ := by rw [hw])
      let isoY : F₁.obj Y' ⟶ Y_et := CategoryTheory.MorphismProperty.Over.homMk (P := PEt) (Q := ⊤)
        (𝟙 (Fgt.obj Y_et).left) (by
          change 𝟙 (Fgt.obj Y_et).left ≫ y_hom = (y_hom ≫ h₂) ≫ h₁
          rw [Category.id_comp, Category.assoc, h21, Category.comp_id])
      have hfac : F₁.map f' = isoY ≫ f_et := etale_hom_ext (by
        change f_left = 𝟙 (Fgt.obj Y_et).left ≫ f_left
        rw [Category.id_comp])
      refine ⟨Y', f', y, ?_, hfEt, hfy⟩
      change R.arrows (F₁.map f')
      rw [hfac]
      exact R.downward_closed hfR isoY
    letI : G.IsCocontinuous J J := hCocont g g_inv hg_et hginv_et hg_inv hinv_g
    letI : G_inv.IsCocontinuous J J := hCocont g_inv g hginv_et hg_et hinv_g hg_inv
    letI : G.IsDenseSubsite J J :=
      CategoryTheory.Equivalence.isDenseSubsite_functor_of_isCocontinuous J J e_site
    letI : G_inv.IsDenseSubsite J J :=
      CategoryTheory.Equivalence.isDenseSubsite_inverse_of_isCocontinuous J J e_site
    letI hG_cont : G.IsContinuous J J := inferInstance
    letI hGinv_cont : G_inv.IsContinuous J J := inferInstance
    let D := AddCommGrpCat.{u}
    let P := G.sheafPushforwardContinuous D J J
    let P_inv := G_inv.sheafPushforwardContinuous D J J
    let eqvSheaf : CategoryTheory.Sheaf J D ≌ CategoryTheory.Sheaf J D :=
      CategoryTheory.Equivalence.sheafCongr J J e_site D
    have hP_eq : P = eqvSheaf.inverse := rfl
    letI : P.IsEquivalence := by rw [hP_eq]; infer_instance
    letI hP_lim : CategoryTheory.Limits.PreservesFiniteLimits P := inferInstance
    letI hP_colim : CategoryTheory.Limits.PreservesFiniteColimits P := inferInstance
    letI hP_add : P.Additive := P.additive_of_preserves_binary_products
    let counitP : P_inv ⋙ P ≅ 𝟭 (CategoryTheory.Sheaf J D) :=
      NatIso.ofComponents
        (fun ℱ =>
          { hom := CategoryTheory.ObjectProperty.homMk
              { app := fun U => ℱ.obj.map ((η_G.app U.unop).hom.op)
                naturality := fun {U₁ U₂} u => by
                  change ℱ.obj.map (G_inv.map (G.map u.unop)).op ≫ ℱ.obj.map (η_G.app U₂.unop).hom.op =
                    ℱ.obj.map (η_G.app U₁.unop).hom.op ≫ ℱ.obj.map u
                  rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                  congr 1 }
            inv := CategoryTheory.ObjectProperty.homMk
              { app := fun U => ℱ.obj.map ((η_G.app U.unop).inv.op)
                naturality := fun {U₁ U₂} u => by
                  change ℱ.obj.map u ≫ ℱ.obj.map (η_G.app U₂.unop).inv.op =
                    ℱ.obj.map (η_G.app U₁.unop).inv.op ≫ ℱ.obj.map (G_inv.map (G.map u.unop)).op
                  rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                  congr 1 }
            hom_inv_id := by
              apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext U
              change ℱ.obj.map (η_G.app U.unop).hom.op ≫ ℱ.obj.map (η_G.app U.unop).inv.op =
                𝟙 (ℱ.obj.obj (Opposite.op (G_inv.obj (G.obj U.unop))))
              rw [← ℱ.obj.map_comp, ← op_comp, (η_G.app U.unop).inv_hom_id, op_id, ℱ.obj.map_id]
              rfl
            inv_hom_id := by
              apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext U
              change ℱ.obj.map (η_G.app U.unop).inv.op ≫ ℱ.obj.map (η_G.app U.unop).hom.op =
                𝟙 (ℱ.obj.obj U)
              rw [← ℱ.obj.map_comp, ← op_comp, (η_G.app U.unop).hom_inv_id, op_id, ℱ.obj.map_id]
              rfl })
        (fun {ℱ₁ ℱ₂} f => by
          apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext U
          exact (f.hom.naturality ((η_G.app U.unop).hom.op)).symm)
    let unitP : 𝟭 (CategoryTheory.Sheaf J D) ≅ P ⋙ P_inv :=
      NatIso.ofComponents
        (fun ℱ =>
          { hom := CategoryTheory.ObjectProperty.homMk
              { app := fun U => ℱ.obj.map ((ε_G.app U.unop).hom.op)
                naturality := fun {U₁ U₂} u => by
                  change ℱ.obj.map u ≫ ℱ.obj.map (ε_G.app U₂.unop).hom.op =
                    ℱ.obj.map (ε_G.app U₁.unop).hom.op ≫ ℱ.obj.map (G.map (G_inv.map u.unop)).op
                  rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                  congr 1 }
            inv := CategoryTheory.ObjectProperty.homMk
              { app := fun U => ℱ.obj.map ((ε_G.app U.unop).inv.op)
                naturality := fun {U₁ U₂} u => by
                  change ℱ.obj.map (G.map (G_inv.map u.unop)).op ≫ ℱ.obj.map (ε_G.app U₂.unop).inv.op =
                    ℱ.obj.map (ε_G.app U₁.unop).inv.op ≫ ℱ.obj.map u
                  rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
                  congr 1 }
            hom_inv_id := by
              apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext U
              change ℱ.obj.map (ε_G.app U.unop).hom.op ≫ ℱ.obj.map (ε_G.app U.unop).inv.op =
                𝟙 (ℱ.obj.obj U)
              rw [← ℱ.obj.map_comp, ← op_comp, (ε_G.app U.unop).inv_hom_id, op_id, ℱ.obj.map_id]
              rfl
            inv_hom_id := by
              apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext U
              change ℱ.obj.map (ε_G.app U.unop).inv.op ≫ ℱ.obj.map (ε_G.app U.unop).hom.op =
                𝟙 (ℱ.obj.obj (Opposite.op (G.obj (G_inv.obj U.unop))))
              rw [← ℱ.obj.map_comp, ← op_comp, (ε_G.app U.unop).hom_inv_id, op_id, ℱ.obj.map_id]
              rfl })
        (fun {ℱ₁ ℱ₂} f => by
          apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext U
          exact (f.hom.naturality ((ε_G.app U.unop).hom.op)).symm)
    have hTriP : ∀ ℱ : CategoryTheory.Sheaf J D,
        counitP.hom.app (P.obj ℱ) = P.map (unitP.inv.app ℱ) := by
      intro ℱ
      apply CategoryTheory.Sheaf.hom_ext; apply NatTrans.ext; funext U
      change ℱ.obj.map (G.map (η_G.app U.unop).hom).op = ℱ.obj.map (ε_G.app (G.obj U.unop)).inv.op
      congr 1
    let T : S.Etale := CategoryTheory.MorphismProperty.Over.mk (P := PEt) ⊤ (𝟙 S) inferInstance
    have hT : CategoryTheory.Limits.IsTerminal T :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U => CategoryTheory.MorphismProperty.Over.homMk (P := PEt) (Q := ⊤) (Fgt.obj U).hom
          (Category.comp_id (Fgt.obj U).hom))
        (fun U m => etale_hom_ext (by
          let m_left : (Fgt.obj U).left ⟶ S := (Fgt.map m).left
          have hw : m_left ≫ 𝟙 S = (Fgt.obj U).hom := etale_w m
          rw [Category.comp_id] at hw
          exact hw))
    let μ : G.obj T ⟶ T := CategoryTheory.MorphismProperty.Over.homMk (P := PEt) (Q := ⊤) g
      (by
        change g ≫ 𝟙 S = 𝟙 S ≫ g
        rw [Category.comp_id, Category.id_comp])
    let μ_inv : G_inv.obj T ⟶ T := CategoryTheory.MorphismProperty.Over.homMk (P := PEt) (Q := ⊤) g_inv
      (by
        change g_inv ≫ 𝟙 S = 𝟙 S ≫ g_inv
        rw [Category.comp_id, Category.id_comp])
    let C := CategoryTheory.constantSheaf J D
    let adj := CategoryTheory.constantSheafAdj J D hT
    let α : ∀ A : D, C.obj A ⟶ P.obj (C.obj A) := fun A =>
      (adj.homEquiv A (P.obj (C.obj A))).symm (adj.unit.app A ≫ (C.obj A).obj.map μ.op)
    let α' : ∀ A : D, C.obj A ⟶ P_inv.obj (C.obj A) := fun A =>
      (adj.homEquiv A (P_inv.obj (C.obj A))).symm (adj.unit.app A ≫ (C.obj A).obj.map μ_inv.op)
    let β : ∀ A : D, P.obj (C.obj A) ⟶ C.obj A := fun A =>
      P.map (α' A) ≫ counitP.hom.app (C.obj A)
