        let E₂ := Y₀.1; let e₂ := Y₀.2
        let h₁ : E₁.left ⟶ W := E₁.hom
        let h₂ : E₂.left ⟶ W := E₂.hom
        let P_sch := CategoryTheory.Limits.pullback h₁ h₂
        let p₁ : P_sch ⟶ E₁.left := CategoryTheory.Limits.pullback.fst h₁ h₂
        let p₂ : P_sch ⟶ E₂.left := CategoryTheory.Limits.pullback.snd h₁ h₂
        have : AlgebraicGeometry.Etale p₁ := inferInstance
        have : AlgebraicGeometry.Etale h₁ := E₁.prop
        have : AlgebraicGeometry.Etale (p₁ ≫ h₁) := inferInstance
        let E₃ : W.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ h₁) inferInstance
        let e₃_hom : S_Ω ⟶ P_sch := CategoryTheory.Limits.pullback.lift e₁.1 e₂.1 (e₁.2.trans e₂.2.symm)
        have he₃_w : e₃_hom ≫ E₃.hom = w :=
          (CategoryTheory.Limits.pullback.lift_fst_assoc e₁.1 e₂.1 _ h₁).trans e₁.2
        let Z_el : fib.Elements := fib.elementsMk E₃ ⟨e₃_hom, he₃_w⟩
        let u₁ : E₃ ⟶ E₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        let u₂ : E₃ ⟶ E₂ := CategoryTheory.MorphismProperty.Over.homMk p₂
          CategoryTheory.Limits.pullback.condition.symm trivial
        refine ⟨Z_el,
          ⟨u₁, Subtype.ext (CategoryTheory.Limits.pullback.lift_fst e₁.1 e₂.1 _)⟩,
          ⟨u₂, Subtype.ext (CategoryTheory.Limits.pullback.lift_snd e₁.1 e₂.1 _)⟩, trivial⟩
      · let E₁ := X₀.1; let e₁ := X₀.2
        let E₂ := Y₀.1; let e₂ := Y₀.2
        let h₁ : E₁.left ⟶ W := E₁.hom
        let h₂ : E₂.left ⟶ W := E₂.hom
        have : AlgebraicGeometry.Etale h₁ := E₁.prop
        have : AlgebraicGeometry.Etale h₂ := E₂.prop
        let Δ : E₂.left ⟶ CategoryTheory.Limits.pullback h₂ h₂ :=
          CategoryTheory.Limits.pullback.diagonal h₂
        have : AlgebraicGeometry.IsOpenImmersion Δ :=
          AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal h₂
        let fg : E₁.left ⟶ CategoryTheory.Limits.pullback h₂ h₂ :=
          CategoryTheory.Limits.pullback.lift f.1.left g.1.left
            ((CategoryTheory.MorphismProperty.Over.w f.1).trans
              (CategoryTheory.MorphismProperty.Over.w g.1).symm)
        let E₀_sch := CategoryTheory.Limits.pullback Δ fg
        let q_left : E₀_sch ⟶ E₂.left := CategoryTheory.Limits.pullback.fst Δ fg
        let q_right : E₀_sch ⟶ E₁.left := CategoryTheory.Limits.pullback.snd Δ fg
        have : AlgebraicGeometry.Etale q_right := inferInstance
        have : AlgebraicGeometry.Etale (q_right ≫ h₁) := inferInstance
        let E₀ : W.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (q_right ≫ h₁) inferInstance
        have hf_eq : e₁.1 ≫ f.1.left = e₂.1 := congrArg Subtype.val f.2
        have hg_eq : e₁.1 ≫ g.1.left = e₂.1 := congrArg Subtype.val g.2
        have he_diag : e₂.1 ≫ Δ = e₁.1 ≫ fg := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, hf_eq]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, hg_eq]
        let e₀_hom : S_Ω ⟶ E₀_sch := CategoryTheory.Limits.pullback.lift e₂.1 e₁.1 he_diag
        have he₀_w : e₀_hom ≫ E₀.hom = w :=
          (CategoryTheory.Limits.pullback.lift_snd_assoc e₂.1 e₁.1 he_diag h₁).trans e₁.2
        let Z_el : fib.Elements := fib.elementsMk E₀ ⟨e₀_hom, he₀_w⟩
        let u₀ : E₀ ⟶ E₁ := CategoryTheory.MorphismProperty.Over.homMk q_right rfl trivial
        have hq_eq : q_right ≫ f.1.left = q_right ≫ g.1.left := by
          have hcond : q_left ≫ Δ = q_right ≫ fg := CategoryTheory.Limits.pullback.condition
          have hfst := congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₂ h₂) hcond
          have hsnd := congrArg (· ≫ CategoryTheory.Limits.pullback.snd h₂ h₂) hcond
          dsimp [Δ, fg] at hfst hsnd
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst] at hfst
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd] at hsnd
          exact hfst.symm.trans hsnd
        refine ⟨Z_el, ⟨u₀, Subtype.ext (CategoryTheory.Limits.pullback.lift_snd e₂.1 e₁.1 he_diag)⟩, ?_⟩
        ext : 1
        exact CategoryTheory.MorphismProperty.Comma.Hom.ext hq_eq (Subsingleton.elim _ _)
    have hSmall : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        CategoryTheory.InitiallySmall.{u} (fibOf W Ω w).Elements := by
      intro W Ω _ _ w
      have := hCof W Ω w
      let fib := fibOf W Ω w
      let ι_aff := AlgebraicGeometry.Scheme.AffineEtale.Spec W
      let eqv_sm := CategoryTheory.equivSmallModel.{u} W.AffineEtale
      let Idx := Σ (m : CategoryTheory.SmallModel.{u} W.AffineEtale),
        fib.obj (ι_aff.obj (eqv_sm.inverse.obj m))
      let emb : Idx → fib.Elements := fun p => fib.elementsMk (ι_aff.obj (eqv_sm.inverse.obj p.1)) p.2
      let s : Set fib.Elements := Set.range emb
      have : Small.{u} ↥s := small_range emb
      refine CategoryTheory.initiallySmall_of_small_weakly_initial_set s ?_
      intro X₀
      have hcov : CategoryTheory.Sieve.coverByImage ι_aff X₀.1 ∈ W.smallEtaleTopology X₀.1 :=
        CategoryTheory.Functor.IsCoverDense.is_cover X₀.1
      obtain ⟨E', u, hu, y, hy⟩ := hJoint W Ω w (CategoryTheory.Sieve.coverByImage ι_aff X₀.1) hcov X₀.2
      let ⟨A_aff, g_et, f_aff, hfac⟩ := hu
      let m : CategoryTheory.SmallModel.{u} W.AffineEtale := eqv_sm.functor.obj A_aff
      let iso_A : ι_aff.obj (eqv_sm.inverse.obj m) ≅ ι_aff.obj A_aff :=
        ι_aff.mapIso (eqv_sm.unitIso.symm.app A_aff)
      let y_aff : fib.obj (ι_aff.obj A_aff) :=
        (CategoryTheory.ConcreteCategory.hom (fib.map g_et)) y
      let y_m : fib.obj (ι_aff.obj (eqv_sm.inverse.obj m)) :=
        (CategoryTheory.ConcreteCategory.hom (fib.map iso_A.inv)) y_aff
      have hy_m : (CategoryTheory.ConcreteCategory.hom (fib.map (iso_A.hom ≫ f_aff))) y_m = X₀.2 := by
        have h1 : (CategoryTheory.ConcreteCategory.hom (fib.map iso_A.hom)) y_m = y_aff := by
          change (CategoryTheory.ConcreteCategory.hom (fib.map (iso_A.inv ≫ iso_A.hom))) y_aff = y_aff
          rw [iso_A.inv_hom_id, fib.map_id]
          rfl
        have h2 : (CategoryTheory.ConcreteCategory.hom (fib.map f_aff)) y_aff = X₀.2 := by
          change (CategoryTheory.ConcreteCategory.hom (fib.map (g_et ≫ f_aff))) y = X₀.2
          rw [hfac, hy]
        rw [fib.map_comp]
        change (CategoryTheory.ConcreteCategory.hom (fib.map f_aff))
          ((CategoryTheory.ConcreteCategory.hom (fib.map iso_A.hom)) y_m) = X₀.2
        rw [h1, h2]
      exact ⟨emb ⟨m, y_m⟩, ⟨⟨m, y_m⟩, rfl⟩, ⟨⟨iso_A.hom ≫ f_aff, hy_m⟩⟩⟩
