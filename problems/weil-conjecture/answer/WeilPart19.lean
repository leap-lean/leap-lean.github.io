    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget W₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget W₂
    have hEqFgt : B_h.comp Fgt₁ = Fgt₂.comp (CategoryTheory.Over.pullback h) := rfl
