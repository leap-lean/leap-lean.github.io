theorem weil_etale_ordinary_godement_resolution (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (hm : 1 ≤ m) :
    WeilHasOrdinaryGodementResolution S m :=
by
  classical
  let _ := hm
  
  have hPillar1 : WeilOrdGodGeomPkg S := by
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    let ptOf : ∀ x : ↥S, ↥(AlgebraicGeometry.Spec (CommRingCat.of (weilOrdGodGeomField S x))) :=
      fun x => (⟨⊥, inferInstance⟩ : PrimeSpectrum (weilOrdGodGeomField S x))
    have hPtEq : ∀ (x : ↥S) (q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (weilOrdGodGeomField S x)))),
        q = ptOf x := by
      intro x q
      apply PrimeSpectrum.ext
      ext a
      change a ∈ q.asIdeal ↔ a ∈ (⊥ : Ideal (weilOrdGodGeomField S x))
      simp only [Ideal.mem_bot]
      constructor
      · intro ha
        by_contra h0
        exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ ha (IsUnit.mk0 a h0))
      · rintro rfl
        exact q.asIdeal.zero_mem
    have hGeomBase : ∀ (x : ↥S), (weilOrdGodGeomHom S x).base (ptOf x) = x := by
      intro x
      dsimp [weilOrdGodGeomHom]
      exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply x _
    have hLiftEtale : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (f : Y₁ ⟶ Y₂)
        [AlgebraicGeometry.Etale f] (x : ↥S)
        (α : AlgebraicGeometry.Spec (CommRingCat.of (weilOrdGodGeomField S x)) ⟶ Y₂)
        (w : ↥Y₁),
        f.base w = α.base (ptOf x) →
        ∃ α_tilde : AlgebraicGeometry.Spec (CommRingCat.of (weilOrdGodGeomField S x)) ⟶ Y₁,
          α_tilde ≫ f = α ∧ α_tilde.base (ptOf x) = w := by
      intro Y₁ Y₂ f _ x α w hw
      let Ω := weilOrdGodGeomField S x
      obtain ⟨q₀, hq₁, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w (ptOf x) hw
      obtain ⟨V, hV, hqV, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q₀) (U := ⊤) trivial
      let F_pb := CategoryTheory.Limits.pullback f α
      let p₁ : F_pb ⟶ Y₁ := CategoryTheory.Limits.pullback.fst f α
      let p₂ : F_pb ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
        CategoryTheory.Limits.pullback.snd f α
      let B_ring : CommRingCat.{u} := F_pb.presheaf.obj (Opposite.op V)
      let j_V : AlgebraicGeometry.Spec B_ring ⟶ F_pb := hV.fromSpec
      have hq_range : q₀ ∈ Set.range j_V.base := by
        rw [hV.range_fromSpec]
        exact hqV
      obtain ⟨𝔭, h𝔭⟩ := hq_range
      have : AlgebraicGeometry.Etale p₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback f α) inferInstance
      let g_B : AlgebraicGeometry.Spec B_ring ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) := j_V ≫ p₂
