  obtain ⟨η_F, r_Y, hRet_Y⟩ := hUnitSplit i.left F F_Y hCont_i hRA_i ⟨e_Y⟩
  have hηF_pts : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X.left),
      Function.Surjective (CategoryTheory.ConcreteCategory.hom ((𝒮 X.left Ω x_bar).map η_F)) ∧
      (x_bar.base (default : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))) ∉ U →
        Function.Injective (CategoryTheory.ConcreteCategory.hom ((𝒮 X.left Ω x_bar).map η_F))) := by
    intro Ω _ _ x_bar
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let pt₀ : ↥S_Ω := default
    by_cases hx : x_bar.base pt₀ ∈ U
    · refine ⟨?_, fun hnot => False.elim (hnot hx)⟩
      let P_x := CategoryTheory.Limits.pullback i.left x_bar
      let g'_x := CategoryTheory.Limits.pullback.fst i.left x_bar
      let f'_x := CategoryTheory.Limits.pullback.snd i.left x_bar
      have hEmpP : IsEmpty ↥P_x := by
        refine ⟨fun p => ?_⟩
        have heq_p : i.left.base (g'_x.base p) = x_bar.base pt₀ := by
          have hc := congrArg (fun f => f.base p)
            (CategoryTheory.Limits.pullback.condition (f := i.left) (g := x_bar))
          exact hc.trans (congrArg x_bar.base (Subsingleton.elim (f'_x.base p) pt₀))
        have hmem : x_bar.base pt₀ ∈ Set.range i.left.base := ⟨g'_x.base p, heq_p⟩
        rw [hi_range] at hmem
        exact hmem hx
      let S'_ov := CategoryTheory.Over.mk (x_bar ≫ X.hom)
      have : AlgebraicGeometry.QuasiCompact S'_ov.hom := by
        change AlgebraicGeometry.QuasiCompact (x_bar ≫ X.hom)
        exact AlgebraicGeometry.QuasiCompact.mk (fun _ _ _ => (Set.toFinite _).isCompact)
      let P_ov := CategoryTheory.Over.mk (f'_x ≫ S'_ov.hom)
      have : AlgebraicGeometry.QuasiCompact f'_x := inferInstance
      have : AlgebraicGeometry.QuasiCompact P_ov.hom := by
        dsimp [P_ov]; infer_instance
      have hg'_w : g'_x ≫ Y.hom = P_ov.hom := by
        dsimp [P_ov, S'_ov]
        rw [← CategoryTheory.Over.w i, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
      let g'_ov : P_ov ⟶ Y := CategoryTheory.Over.homMk g'_x hg'_w
      let g_ov : S'_ov ⟶ X := CategoryTheory.Over.homMk x_bar rfl
      let f'_ov : P_ov ⟶ S'_ov := CategoryTheory.Over.homMk f'_x rfl
      obtain ⟨FY_x, hPull_g', -⟩ := hSerre.2.2.1 P_ov Y g'_ov F_Y
      have hPBC_i : WeilIsEtaleSheafPullback x_bar Q
          (weilEtaleHigherDirectImage f'_x 0 FY_x) :=
        hPBC Y X S'_ov P_ov i g_ov f'_ov g'_ov hi_prop
          (CategoryTheory.IsPullback.of_hasPullback i.left x_bar) F_Y FY_x hFY_const.1 hPull_g' 0
      have hZ_f' : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f'_x 0 FY_x) :=
        @hEmptyVanish P_x S_Ω hEmpP f'_x FY_x 0
      have hZ_Q : CategoryTheory.Limits.IsZero ((𝒮 X.left Ω x_bar).obj Q) :=
        hStalkZeroOfPullZero Q Ω x_bar _ hPBC_i hZ_f'
      intro y
      exact ⟨0, (map_zero _).trans (hEqZeroOfIsZero hZ_Q y).symm⟩
    · have hx_in : Set.range x_bar.base ⊆ Set.range i.left.base := by
        rw [hi_range]
        rintro _ ⟨q, rfl⟩
        rw [Subsingleton.elim q pt₀]
        exact hx
      obtain ⟨x_tilde, hx_tilde, hpb_i⟩ := hClosedLift i.left Ω x_bar hx_in
      have hbij := hUnitBij Y i hi_prop F hF F_Y hFY_const.1 hCont_i hRA_i e_Y η_F r_Y hRet_Y
        Ω x_bar x_tilde hx_tilde hpb_i
      exact ⟨hbij.2, fun _ => hbij.1⟩
  have : CategoryTheory.Epi η_F :=
    (hMorphCrit X.left η_F).1 (fun Ω _ _ x_bar => (hηF_pts Ω x_bar).1)
  let K := CategoryTheory.Limits.kernel η_F
  let ι_K := CategoryTheory.Limits.kernel.ι η_F
  let SC := CategoryTheory.ShortComplex.mk ι_K η_F (CategoryTheory.Limits.kernel.condition η_F)
  have hSE : SC.ShortExact :=
    { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel SC
        (CategoryTheory.Limits.kernelIsKernel η_F) }
  have hK_zero_out : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X.left),
      x_bar.base (default : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))) ∉ U →
      CategoryTheory.Limits.IsZero ((𝒮 X.left Ω x_bar).obj K) :=
    fun Ω _ _ x_bar hx => (hMorphCrit X.left η_F).2.2 Ω x_bar ((hηF_pts Ω x_bar).2 hx)
  have hQ_const : WeilIsConstructibleModPrimeSheaf ℓ X.left Q := hClosed0 F_Y hFY_const
  have hK_const : WeilIsConstructibleModPrimeSheaf ℓ X.left K :=
    ((hSerre.2.2.2.2 X).1 F Q η_F hF hQ_const).1
  obtain ⟨K_bar, hPull_π, hKbar_imp⟩ := hSerre.2.2.1 X_bar X π K
  have hKbar_const : WeilIsConstructibleModPrimeSheaf ℓ X_bar.left K_bar := hKbar_imp hK_const
  rcases hPull_π with ⟨hCont_π, hRA_π, ⟨e_π⟩⟩
  obtain ⟨ε_K, r_π, hRet_π⟩ := hUnitSplit π.left K K_bar hCont_π hRA_π ⟨e_π⟩
  have hπ_pts : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X.left),
      Function.Bijective (CategoryTheory.ConcreteCategory.hom ((𝒮 X.left Ω x_bar).map ε_K)) ∧
      (∀ b : ℕ, CategoryTheory.Limits.IsZero
        ((𝒮 X.left Ω x_bar).obj (weilEtaleHigherDirectImage π.left (b + 1) K_bar))) := by
    intro Ω _ _ x_bar
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let pt₀ : ↥S_Ω := default
    by_cases hx : x_bar.base pt₀ ∈ U
    · have hx_sub : Set.range x_bar.base ⊆ (U : Set X.left) := by
        rintro _ ⟨q, rfl⟩
        rw [Subsingleton.elim q pt₀]
        exact hx
      have : CategoryTheory.IsIso (π.left ∣_ U) := hπ_iso
      obtain ⟨x_tilde, hx_tilde, hpb_π⟩ := hOpenIsoLift π.left U Ω x_bar hx_sub
      have hbij0 := hUnitBij X_bar π hπ K hK_const K_bar hKbar_const.1 hCont_π hRA_π e_π
        ε_K r_π hRet_π Ω x_bar x_tilde hx_tilde hpb_π
      refine ⟨hbij0, fun b => ?_⟩
      let S'_ov := CategoryTheory.Over.mk (x_bar ≫ X.hom)
      have : AlgebraicGeometry.QuasiCompact S'_ov.hom := by
        change AlgebraicGeometry.QuasiCompact (x_bar ≫ X.hom)
        exact AlgebraicGeometry.QuasiCompact.mk (fun _ _ _ => (Set.toFinite _).isCompact)
      let g_ov : S'_ov ⟶ X := CategoryTheory.Over.homMk x_bar rfl
      have hg'_w : x_tilde ≫ X_bar.hom = S'_ov.hom := by
        dsimp [S'_ov]
        rw [← CategoryTheory.Over.w π, ← CategoryTheory.Category.assoc, hx_tilde]
      let g'_ov : S'_ov ⟶ X_bar := CategoryTheory.Over.homMk x_tilde hg'_w
      obtain ⟨G₀, hPull_xt, -⟩ := hSerre.2.2.1 S'_ov X_bar g'_ov K_bar
      have hPBC_b : WeilIsEtaleSheafPullback x_bar
          (weilEtaleHigherDirectImage π.left (b + 1) K_bar)
          (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id S_Ω) (b + 1) G₀) :=
        hPBC X_bar X S'_ov S'_ov π g_ov (CategoryTheory.CategoryStruct.id S'_ov) g'_ov
          hπ hpb_π K_bar G₀ hKbar_const.1 hPull_xt (b + 1)
      exact hStalkZeroOfPullZero _ Ω x_bar _ hPBC_b (hIdVanish S_Ω G₀ b)
    · let P_x := CategoryTheory.Limits.pullback π.left x_bar
      let g'_x := CategoryTheory.Limits.pullback.fst π.left x_bar
      let f'_x := CategoryTheory.Limits.pullback.snd π.left x_bar
      let S'_ov := CategoryTheory.Over.mk (x_bar ≫ X.hom)
      have : AlgebraicGeometry.QuasiCompact S'_ov.hom := by
        change AlgebraicGeometry.QuasiCompact (x_bar ≫ X.hom)
        exact AlgebraicGeometry.QuasiCompact.mk (fun _ _ _ => (Set.toFinite _).isCompact)
      let P_ov := CategoryTheory.Over.mk (f'_x ≫ S'_ov.hom)
      have : AlgebraicGeometry.QuasiCompact f'_x := inferInstance
      have : AlgebraicGeometry.QuasiCompact P_ov.hom := by
        dsimp [P_ov]; infer_instance
      have hg'_w : g'_x ≫ X_bar.hom = P_ov.hom := by
        dsimp [P_ov, S'_ov]
        rw [← CategoryTheory.Over.w π, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
      let g'_ov : P_ov ⟶ X_bar := CategoryTheory.Over.homMk g'_x hg'_w
      let g_ov : S'_ov ⟶ X := CategoryTheory.Over.homMk x_bar rfl
      let f'_ov : P_ov ⟶ S'_ov := CategoryTheory.Over.homMk f'_x rfl
      obtain ⟨Kbar_x, hPull_g', -⟩ := hSerre.2.2.1 P_ov X_bar g'_ov K_bar
      have hZero_Kbar_x : CategoryTheory.Limits.IsZero Kbar_x := by
        apply hCons P_x Kbar_x
        intro Ω' _ _ p_bar
        let pt₀' : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω')) := default
        let y_bar := p_bar ≫ f'_x ≫ x_bar
        have hy_notU : y_bar.base pt₀' ∉ U := by
          have hy_eq : y_bar.base pt₀' = x_bar.base pt₀ :=
            congrArg x_bar.base (Subsingleton.elim (f'_x.base (p_bar.base pt₀')) pt₀)
          rwa [hy_eq]
        have hZ_Ky : CategoryTheory.Limits.IsZero ((𝒮 X.left Ω' y_bar).obj K) :=
          hK_zero_out Ω' y_bar hy_notU
        obtain ⟨e1⟩ := hStalkIsoOfPull g'_x K_bar Kbar_x hPull_g' Ω' p_bar (p_bar ≫ g'_x) rfl
        have h_py : (p_bar ≫ g'_x) ≫ π.left = y_bar := by
          dsimp [y_bar]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
        obtain ⟨e2⟩ := hStalkIsoOfPull π.left K K_bar ⟨hCont_π, hRA_π, ⟨e_π⟩⟩ Ω'
          (p_bar ≫ g'_x) y_bar h_py
        exact CategoryTheory.Limits.IsZero.of_iso hZ_Ky (e1.trans e2)
      have hAllQ : ∀ q : ℕ,
          CategoryTheory.Limits.IsZero
            ((𝒮 X.left Ω x_bar).obj (weilEtaleHigherDirectImage π.left q K_bar)) := by
        intro q
        have hPBC_q : WeilIsEtaleSheafPullback x_bar
            (weilEtaleHigherDirectImage π.left q K_bar)
            (weilEtaleHigherDirectImage f'_x q Kbar_x) :=
          hPBC X_bar X S'_ov P_ov π g_ov f'_ov g'_ov hπ
            (CategoryTheory.IsPullback.of_hasPullback π.left x_bar) K_bar Kbar_x
            hKbar_const.1 hPull_g' q
        exact hStalkZeroOfPullZero _ Ω x_bar _ hPBC_q (hZeroPush f'_x Kbar_x q hZero_Kbar_x)
      have hZ_K : CategoryTheory.Limits.IsZero ((𝒮 X.left Ω x_bar).obj K) :=
        hK_zero_out Ω x_bar hx
      have hZ_R0 : CategoryTheory.Limits.IsZero
          ((𝒮 X.left Ω x_bar).obj (weilEtaleHigherDirectImage π.left 0 K_bar)) :=
        hAllQ 0
      have hbij_zero : Function.Bijective
          (CategoryTheory.ConcreteCategory.hom ((𝒮 X.left Ω x_bar).map ε_K)) :=
        ⟨fun a b _ => (hEqZeroOfIsZero hZ_K a).trans (hEqZeroOfIsZero hZ_K b).symm,
          fun y => ⟨0, (map_zero _).trans (hEqZeroOfIsZero hZ_R0 y).symm⟩⟩
      exact ⟨hbij_zero, fun b => hAllQ (b + 1)⟩
  have : CategoryTheory.IsIso ε_K :=
    (hMorphCrit X.left ε_K).2.1 (fun Ω _ _ x_bar => (hπ_pts Ω x_bar).1)
  refine ⟨SC, F_Y, K_bar, hSE, rfl, rfl, hFY_const, hKbar_const,
    ⟨CategoryTheory.asIso ε_K⟩, fun b => ?_⟩
  exact hCons X.left (weilEtaleHigherDirectImage π.left (b + 1) K_bar)
    (fun Ω _ _ x_bar => (hπ_pts Ω x_bar).2 b)

theorem weil_etale_closed_immersion_and_modification_excision (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hSerre : WeilConstructibleModPrimeSerreHolds k ℓ) :
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage h q F) = 0) ∧
    (∀ (X₀ B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType B.hom]
      [AlgebraicGeometry.QuasiCompact B.hom]
      [AlgebraicGeometry.IsSeparated B.hom]
      (h : X₀ ⟶ B),
      CategoryTheory.IsIso h.left →
      ∀ (F : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ X₀.left F →
        WeilIsConstructibleModPrimeSheaf ℓ B.left (weilEtaleHigherDirectImage h.left q F)) ∧
    (∀ (Y X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType S.hom]
      [AlgebraicGeometry.QuasiCompact S.hom]
      [AlgebraicGeometry.IsSeparated S.hom]
      (i : Y ⟶ X) (f : X ⟶ S),
      AlgebraicGeometry.IsClosedImmersion i.left →
      AlgebraicGeometry.IsProper f.left →
      (∀ (G : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ X.left G →
        WeilIsConstructibleModPrimeSheaf ℓ S.left (weilEtaleHigherDirectImage f.left q G)) →
      ∀ (F_Y : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ Y.left F_Y →
        WeilIsConstructibleModPrimeSheaf ℓ S.left
          (weilEtaleHigherDirectImage (i.left ≫ f.left) q F_Y)) ∧
    (∀ (X X_bar Y S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType S.hom]
      [AlgebraicGeometry.QuasiCompact S.hom]
      [AlgebraicGeometry.IsSeparated S.hom]
      (f : X ⟶ S) (π : X_bar ⟶ X) (U : X.left.Opens) (i : Y ⟶ X),
      AlgebraicGeometry.IsProper f.left →
      AlgebraicGeometry.IsProper π.left →
      CategoryTheory.IsIso (π.left ∣_ U) →
      AlgebraicGeometry.IsClosedImmersion i.left →
      Set.range i.left.base = (U : Set X.left)ᶜ →
      (∀ (G_bar : CategoryTheory.Sheaf X_bar.left.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ X_bar.left G_bar →
        WeilIsConstructibleModPrimeSheaf ℓ S.left
          (weilEtaleHigherDirectImage (π.left ≫ f.left) q G_bar)) →
      (∀ (G_Y : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ Y.left G_Y →
        WeilIsConstructibleModPrimeSheaf ℓ S.left
          (weilEtaleHigherDirectImage (i.left ≫ f.left) q G_Y)) →
      ∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ X.left F →
        WeilIsConstructibleModPrimeSheaf ℓ S.left (weilEtaleHigherDirectImage f.left q F)) :=
by
  let T_sh : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (q : ℕ),
      CategoryTheory.Functor
        (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun {X₁ X₂} h q =>
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B : CategoryTheory.Functor X₂.Etale X₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₁.smallEtaleTopology q).comp
        (((CategoryTheory.Functor.whiskeringLeft (Opposite X₂.Etale) (Opposite X₁.Etale)
          AddCommGrpCat.{u}).obj B.op).comp
          (CategoryTheory.presheafToSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}))
  have hTors : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage h q F) = 0 := by
    intro X₁ X₂ h F q hF
    have _ : (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₁.smallEtaleTopology q).Additive :=
      ⟨fun {_ _} _ _ => by ext U : 2; exact (CategoryTheory.Abelian.extFunctorObj _ q).map_add⟩
    have _ : (T_sh h q).Additive := by dsimp [T_sh]; infer_instance
    change ℓ • CategoryTheory.CategoryStruct.id ((T_sh h q).obj F) = 0
    rw [← (T_sh h q).map_id, ← (T_sh h q).map_nsmul, hF, (T_sh h q).map_zero]
  have hIsoMap : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₁ F₂ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Nonempty (F₁ ≅ F₂) →
      Nonempty (weilEtaleHigherDirectImage h q F₁ ≅ weilEtaleHigherDirectImage h q F₂) := by
    intro X₁ X₂ h F₁ F₂ q ⟨e⟩
    exact ⟨(T_sh h q).mapIso e⟩
  have hEmptyVanish : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} [IsEmpty ↥W₁] (h : W₁ ⟶ W₂)
      (H : CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h q H) := by
    intro W₁ W₂ _ h H q
    have hZeroH : CategoryTheory.Limits.IsZero H := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext E : 3
      let hEW : E.unop.left ⟶ W₁ := E.unop.hom
      have _ : IsEmpty ↥E.unop.left := ⟨fun x => IsEmpty.false (hEW.base x)⟩
      have hbot : ⊥ ∈ W₁.smallEtaleTopology E.unop := by
        let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
          @AlgebraicGeometry.Etale
        let E' : P.Over ⊤ W₁ := E.unop
        change (⊥ : CategoryTheory.Sieve E') ∈
          ((CategoryTheory.MorphismProperty.Over.forget P ⊤ W₁).restrictedTopology
            (AlgebraicGeometry.Scheme.overGrothendieckTopology P W₁)) E'
        rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
        exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
          (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
            (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
      exact (H.isTerminalOfBotCover E.unop hbot).isZero.eq_of_src _ _
    dsimp [weilEtaleHigherDirectImage]
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hZeroBP : CategoryTheory.Limits.IsZero
        (CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf H q)) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext U : 2
      have hZeroObj : CategoryTheory.Limits.IsZero
          ((CategoryTheory.Sheaf.cohomologyPresheaf H q).obj (Opposite.op (B.obj U.unop))) := by
        dsimp [CategoryTheory.Sheaf.cohomologyPresheaf,
          CategoryTheory.Sheaf.cohomologyPresheafFunctor, CategoryTheory.Abelian.extFunctor]
        exact (CategoryTheory.Abelian.extFunctorObj _ q).map_isZero hZeroH
      exact hZeroObj.eq_of_src _ _
    exact (CategoryTheory.presheafToSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
      hZeroBP
  obtain ⟨hIdVanish, hIsoPush, hShortExt⟩ :=
    weil_etale_higherDirectImage_idVanish_isoPush_and_shortExact k ℓ hSerre
  obtain ⟨hZeroTest, hAcycComp⟩ :=
    weil_etale_acyclic_pushforward_composition_and_stalk_zero.{u}
  refine ⟨hTors, hIsoPush, ?_, ?_⟩
  · intro Y X S _ _ _ i f hi hf hPush_f F_Y q hF_Y
