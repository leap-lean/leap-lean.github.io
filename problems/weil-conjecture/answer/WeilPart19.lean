        have hEx_ε₁ : (CategoryTheory.ShortComplex.mk ε₁ (K.d 1 2) hε₁).Exact := by
          let S_src := CategoryTheory.ShortComplex.mk (K.d 0 1) (K.d 1 2) (K.d_comp_d 0 1 2)
          let S_tgt := CategoryTheory.ShortComplex.mk ε₁ (K.d 1 2) hε₁
          let φ : S_src ⟶ S_tgt :=
            { τ₁ := π₀
