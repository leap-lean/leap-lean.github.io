  have h_s2 : ∀ (V₀ : AlgebraicGeometry.Scheme.{u})
      {F G : CategoryTheory.Sheaf V₀.smallEtaleTopology AddCommGrpCat.{u}}
      (g : F ⟶ G) [CategoryTheory.Epi g]
      (E₀ : V₀.Etale) (hE₀ : Nonempty ↥E₀.left)
      (L : List ↥(G.obj.obj (Opposite.op E₀))),
      ∃ (E : V₀.Etale) (u : E ⟶ E₀),
        Nonempty ↥E.left ∧
        ∀ t ∈ L, ∃ s : ↥(F.obj.obj (Opposite.op E)),
          (g.hom.app (Opposite.op E)).hom s = (G.obj.map u.op).hom t := by
    intro V₀ F G g _ E₀ hE₀ L
    have : CategoryTheory.Presheaf.IsLocallySurjective V₀.smallEtaleTopology g.hom :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (A := AddCommGrpCat.{u}) g).mpr inferInstance
    induction L with
    | nil =>
      exact ⟨E₀, 𝟙 E₀, hE₀, fun _ h => False.elim (List.not_mem_nil h)⟩
    | cons t₀ L' ih =>
      obtain ⟨E', u', ⟨w'⟩, hLift'⟩ := ih
      let t'_0 : ↥(G.obj.obj (Opposite.op E')) := (G.obj.map u'.op).hom t₀
      have hS₀ : CategoryTheory.Presheaf.imageSieve g.hom t'_0 ∈ V₀.smallEtaleTopology E' :=
        CategoryTheory.Presheaf.imageSieve_mem V₀.smallEtaleTopology g.hom t'_0
      obtain ⟨E, u₀, w, hu₀, -, -⟩ := (h_mem_etale V₀ E' _).mp hS₀ w'
      refine ⟨E, u₀ ≫ u', ⟨w⟩, ?_⟩
      intro t ht
      rcases List.mem_cons.mp ht with rfl | ht'
      · obtain ⟨s₀, hs₀⟩ := hu₀
        refine ⟨s₀, ?_⟩
        have hs₀' : (g.hom.app (Opposite.op E)).hom s₀ = (G.obj.map u₀.op).hom t'_0 := hs₀
        rw [hs₀']
        change (G.obj.map u₀.op).hom ((G.obj.map u'.op).hom t) =
          (G.obj.map (u'.op ≫ u₀.op)).hom t
        rw [G.obj.map_comp]
        rfl
      · obtain ⟨s', hs'⟩ := hLift' t ht'
        refine ⟨(F.obj.map u₀.op).hom s', ?_⟩
        have hnat := congrArg (fun φ => φ.hom s') (g.hom.naturality u₀.op)
        change (g.hom.app (Opposite.op E)).hom ((F.obj.map u₀.op).hom s') =
          (G.obj.map u₀.op).hom ((g.hom.app (Opposite.op E')).hom s') at hnat
        rw [hnat, hs']
        change (G.obj.map u₀.op).hom ((G.obj.map u'.op).hom t) =
          (G.obj.map (u'.op ≫ u₀.op)).hom t
        rw [G.obj.map_comp]
        rfl

  
  have h_s3 : ∀ (V₀ : AlgebraicGeometry.Scheme.{u}) (E : V₀.Etale) (A₁ A₃ : AddCommGrpCat.{u})
