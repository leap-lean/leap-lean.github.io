            change (W₁₂ x).ι.base y ∈ (W₁₂ x : Set ↥U.left)
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
            exact ⟨y, rfl⟩
          exact hy.1
        have hc₂ : ∀ y : ↥(Y₁₂ x).left, s₂ ((k₁₂ x).left.base y) = s₂ x := by
          intro y
          have hy : (k₁₂ x).left.base y ∈ (W₁₂ x : Set ↥U.left) := by
