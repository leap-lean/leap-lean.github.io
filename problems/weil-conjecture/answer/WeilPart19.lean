        fun X => (F_ev X).mapCocone c
      have hc_X : ∀ X : S.AffineEtale, CategoryTheory.Limits.IsColimit (c_X X) :=
        fun X => CategoryTheory.Limits.isColimitOfPreserves (F_ev X) hc
      have hP_j : ∀ j : Λ, CategoryTheory.Presieve.IsSheaf J_aff
          ((D.obj j).obj ⋙ CategoryTheory.forget A) :=
        fun j => (modulePresheaf_isSheaf_iff_forget J_aff (D.obj j).obj).mp (D.obj j).property
      have h_ι_nat : ∀ (j : Λ) {X Y : S.AffineEtale} (f : Y ⟶ X)
          (v : ↥((D.obj j).obj.obj (Opposite.op X))),
          ((c.ι.app j).app (Opposite.op Y)).hom (((D.obj j).obj.map f.op).hom v) =
            (c.pt.map f.op).hom (((c.ι.app j).app (Opposite.op X)).hom v) := by
        intro j X Y f v
