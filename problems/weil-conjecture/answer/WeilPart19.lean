          _ = 0 ≫ SC.f := by
            rw [hTorsX₂, Limits.comp_zero, Limits.zero_comp]
      exact hQ_iso SC.X₂ G ⟨e⟩ (hQ_ext_tors SC hSE hTorsX₂ (ih SC.X₁ hX₁ hTorsX₁) hX₃)
  have hExtract : ∀ G : C, WeilEllPrimaryConstructible ℓ Y.left G → ℓ • 𝟙 G = 0 → 𝒬 G :=
    fun G ⟨m, hm⟩ hTors => hExtractStep m G hm hTors
  have hP_ext_step : ∀ (m₃ : ℕ) {SC : ShortComplex C},
      SC.ShortExact →
      WeilEllPrimaryConstructible ℓ Y.left SC.X₁ →
      WeilEllPrimaryConstructibleStep ℓ Y.left m₃ SC.X₃ →
      WeilEllPrimaryConstructible ℓ Y.left SC.X₂ := by
    intro m₃
    induction m₃ with
    | zero =>
      intro SC hSE hPX₁ hm₃
      have hg0 : SC.g = 0 := hm₃.eq_of_tgt SC.g 0
      have _ : Epi SC.f := (SC.exact_iff_epi hg0).mp hSE.exact
      have _ : Mono SC.f := hSE.mono_f
      have _ : IsIso SC.f := isIso_of_mono_of_epi SC.f
      exact hP_iso SC.X₁ SC.X₂ ⟨asIso SC.f⟩ hPX₁
    | succ m₃ ih =>
      intro SC hSE hPX₁ ⟨SC₃, hSE₃, hIso₃, hA₃, hQ₃⟩
      obtain ⟨E, u₁, v₁, h₁, u₂, v₂, h₂, hSE₁, hSE₂⟩ := hSplice hSE hSE₃ hIso₃
      obtain ⟨m_E, hm_E⟩ := ih hSE₁ hPX₁ hA₃
      exact ⟨m_E + 1, ShortComplex.mk u₂ v₂ h₂, hSE₂, ⟨Iso.refl SC.X₂⟩, hm_E, hQ₃⟩
  have hP_ext : ∀ {SC : ShortComplex C},
      SC.ShortExact →
      WeilEllPrimaryConstructible ℓ Y.left SC.X₁ →
      WeilEllPrimaryConstructible ℓ Y.left SC.X₃ →
      WeilEllPrimaryConstructible ℓ Y.left SC.X₂ :=
    fun hSE hX₁ ⟨m₃, hm₃⟩ => hP_ext_step m₃ hSE hX₁ hm₃
  have hKC_Q : ∀ (m₂ : ℕ) {F₁ M₂ : C} (φ : F₁ ⟶ M₂),
      𝒬 F₁ → WeilEllPrimaryConstructibleStep ℓ Y.left m₂ M₂ →
      WeilEllPrimaryConstructible ℓ Y.left (Limits.kernel φ) ∧
      WeilEllPrimaryConstructible ℓ Y.left (Limits.cokernel φ) := by
    intro m₂
    induction m₂ with
    | zero =>
      intro F₁ M₂ φ hQF₁ hm₂
      obtain ⟨⟨eK⟩, hZeroC⟩ := hR_zero φ hm₂
      exact ⟨hP_iso F₁ _ ⟨eK.symm⟩ (hP_of_Q F₁ hQF₁), hP_zero _ hZeroC⟩
    | succ m₂ ih =>
      intro F₁ M₂ φ hQF₁ ⟨SC, hSE, ⟨e₂⟩, hA, hB⟩
      let φ' : F₁ ⟶ SC.X₂ := φ ≫ e₂.inv
      have hφ_eq : φ = φ' ≫ e₂.hom := by
        dsimp [φ']
        rw [Category.assoc, e₂.inv_hom_id, Category.comp_id]
      obtain ⟨⟨eK₀⟩, ⟨eC₀⟩⟩ := hR_iso φ' e₂
      obtain ⟨α, u, v, huv, ⟨eKα⟩, hSE_coker⟩ := hR_comp hSE φ'
      obtain ⟨hQ_ker, hQ_coker⟩ := hQ_ker_coker F₁ SC.X₃ (φ' ≫ SC.g) hQF₁ hB
      obtain ⟨hP_ker_α, hP_coker_α⟩ := ih α hQ_ker hA
      have hP_ker_φ' : WeilEllPrimaryConstructible ℓ Y.left (Limits.kernel φ') :=
        hP_iso _ _ ⟨eKα.symm⟩ hP_ker_α
      have hP_coker_φ' : WeilEllPrimaryConstructible ℓ Y.left (Limits.cokernel φ') :=
        hP_ext hSE_coker hP_coker_α (hP_of_Q _ hQ_coker)
      rw [hφ_eq]
      exact ⟨hP_iso _ _ ⟨eK₀.symm⟩ hP_ker_φ', hP_iso _ _ ⟨eC₀.symm⟩ hP_coker_φ'⟩
  have hKC_P : ∀ (m₁ : ℕ) {M₁ M₂ : C} (φ : M₁ ⟶ M₂),
      WeilEllPrimaryConstructibleStep ℓ Y.left m₁ M₁ →
      WeilEllPrimaryConstructible ℓ Y.left M₂ →
      WeilEllPrimaryConstructible ℓ Y.left (Limits.kernel φ) ∧
      WeilEllPrimaryConstructible ℓ Y.left (Limits.cokernel φ) := by
    intro m₁
    induction m₁ with
    | zero =>
      intro M₁ M₂ φ hm₁ hPM₂
      obtain ⟨hZeroK, ⟨eC⟩⟩ := hL_zero φ hm₁
      exact ⟨hP_zero _ hZeroK, hP_iso M₂ _ ⟨eC.symm⟩ hPM₂⟩
    | succ m₁ ih =>
      intro M₁ M₂ φ ⟨SC, hSE, ⟨e₁⟩, hX₁, hX₃⟩ hPM₂
      let φ' : SC.X₂ ⟶ M₂ := e₁.hom ≫ φ
      have hφ_eq : φ = e₁.symm.hom ≫ φ' := by
        dsimp [φ']
        rw [e₁.inv_hom_id_assoc]
      obtain ⟨⟨eK₀⟩, ⟨eC₀⟩⟩ := hL_iso e₁.symm φ'
      obtain ⟨β, u, v, huv, ⟨eCβ⟩, hSE_ker⟩ := hL_comp hSE φ'
      obtain ⟨hP_ker_comp, ⟨m_c, hm_c⟩⟩ := ih (SC.f ≫ φ') hX₁ hPM₂
      obtain ⟨hP_ker_β, hP_coker_β⟩ := hKC_Q m_c β hX₃ hm_c
      have hP_ker_φ' : WeilEllPrimaryConstructible ℓ Y.left (Limits.kernel φ') :=
        hP_ext hSE_ker hP_ker_comp hP_ker_β
      have hP_coker_φ' : WeilEllPrimaryConstructible ℓ Y.left (Limits.cokernel φ') :=
        hP_iso _ _ ⟨eCβ.symm⟩ hP_coker_β
      rw [hφ_eq]
      exact ⟨hP_iso _ _ ⟨eK₀.symm⟩ hP_ker_φ', hP_iso _ _ ⟨eC₀.symm⟩ hP_coker_φ'⟩
  refine ⟨hP_zero, hP_of_Q, hP_iso, hExtract, ?_⟩
  intro N₁ N₂ N₃ N₄ N₅ f₁ f₂ f₃ f₄ h₁₂ h₂₃ h₃₄ hex₁₂ hex₂₃ hex₃₄ ⟨m₁, hm₁⟩ hPN₂ ⟨m₄, hm₄⟩ hPN₅
  have hP_cok : WeilEllPrimaryConstructible ℓ Y.left (Limits.cokernel f₁) :=
    (hKC_P m₁ f₁ hm₁ hPN₂).2
  have hP_ker : WeilEllPrimaryConstructible ℓ Y.left (Limits.kernel f₄) :=
    (hKC_P m₄ f₄ hm₄ hPN₅).1
  obtain ⟨u, v, huv, hSE_mid⟩ := hFiveFactor f₁ f₂ f₃ f₄ h₁₂ h₂₃ h₃₄ hex₁₂ hex₂₃ hex₃₄
  exact hP_ext hSE_mid hP_cok hP_ker

theorem weil_abelian_injective_cochain_pushforward_serre (A_cat : Type u₁) [CategoryTheory.Category.{v₁} A_cat] [CategoryTheory.Abelian A_cat]
    [CategoryTheory.HasInjectiveResolutions A_cat]
    (B_cat : Type u₂) [CategoryTheory.Category.{v₂} B_cat] [CategoryTheory.Abelian B_cat]
    (F : CategoryTheory.Functor A_cat B_cat)
    [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
    (P_A : A_cat → Prop) (P_B : B_cat → Prop)
    (hPA_iso : ∀ {X₁ X₂ : A_cat}, Nonempty (CategoryTheory.Iso X₁ X₂) → P_A X₁ → P_A X₂)
    (hPB_zero : ∀ {Y : B_cat}, CategoryTheory.Limits.IsZero Y → P_B Y)
    (hPB_iso : ∀ {Y₁ Y₂ : B_cat}, Nonempty (CategoryTheory.Iso Y₁ Y₂) → P_B Y₁ → P_B Y₂)
    (hPB_five : ∀ {N₁ N₂ N₃ N₄ N₅ : B_cat}
        (f₁ : Quiver.Hom N₁ N₂) (f₂ : Quiver.Hom N₂ N₃)
        (f₃ : Quiver.Hom N₃ N₄) (f₄ : Quiver.Hom N₄ N₅)
        (h₁₂ : CategoryTheory.CategoryStruct.comp f₁ f₂ = 0)
        (h₂₃ : CategoryTheory.CategoryStruct.comp f₂ f₃ = 0)
        (h₃₄ : CategoryTheory.CategoryStruct.comp f₃ f₄ = 0),
      (CategoryTheory.ShortComplex.mk f₁ f₂ h₁₂).Exact →
      (CategoryTheory.ShortComplex.mk f₂ f₃ h₂₃).Exact →
      (CategoryTheory.ShortComplex.mk f₃ f₄ h₃₄).Exact →
      P_B N₁ → P_B N₂ → P_B N₄ → P_B N₅ → P_B N₃)
    (hF_res : ∀ (H : A_cat), P_A H → ∀ (J : CategoryTheory.InjectiveResolution H) (a : ℕ),
      P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology a))
    (K : CochainComplex A_cat ℕ)
    (hK_inj : ∀ n : ℕ, CategoryTheory.Injective (K.X n))
    (hK_coh : ∀ b : ℕ, P_A (K.homology b))
    (q : ℕ) :
    P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q) :=
by
  have h_s1 :
      (∀ (X : CochainComplex A_cat ℕ),
        Nonempty (CategoryTheory.Iso
          (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj X).homology 0)
          (F.obj (X.homology 0)))) ∧
      (∀ (H : A_cat) (J : CategoryTheory.InjectiveResolution H),
        Nonempty (CategoryTheory.Iso (J.cocomplex.homology 0) H)) := by
    refine ⟨?_, ?_⟩
    · intro X
      let FX := (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj X
      let hcX := X.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)
      let hcFX_map := CategoryTheory.Limits.KernelFork.mapIsLimit _ hcX F
      let hcFX := FX.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)
      let e_cyc : FX.cycles 0 ≅ F.obj (X.cycles 0) := hcFX.conePointUniqueUpToIso hcFX_map
      exact ⟨(CochainComplex.isoHomologyπ₀ FX).symm.trans
        (e_cyc.trans (F.mapIso (CochainComplex.isoHomologyπ₀ X)))⟩
    · intro H J
      let hcJ := J.cocomplex.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)
      exact ⟨(CochainComplex.isoHomologyπ₀ J.cocomplex).symm.trans
        (hcJ.conePointUniqueUpToIso J.isLimitKernelFork)⟩
  have h_s3 : ∀ (X : CochainComplex A_cat ℕ),
      (∀ n : ℕ, CategoryTheory.Injective (X.X n)) →
      CategoryTheory.Limits.IsZero (X.homology 0) →
      ∃ (X' : CochainComplex A_cat ℕ),
        (∀ n : ℕ, CategoryTheory.Injective (X'.X n)) ∧
        (∀ m : ℕ, Nonempty (CategoryTheory.Iso (X.homology (m + 1)) (X'.homology m))) ∧
        CategoryTheory.Limits.IsZero
          (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj X).homology 0) ∧
        (∀ m : ℕ, Nonempty (CategoryTheory.Iso
          (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj X).homology (m + 1))
          (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj X').homology m))) := by
    intro X hX_inj hX_zero
    have hSc0_zero : CategoryTheory.Limits.IsZero (X.sc' 0 0 1).homology :=
      hX_zero.of_iso (X.homologyIsoSc' 0 0 1 CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0)).symm
    have hSc0_ex : (X.sc' 0 0 1).Exact :=
      ((X.sc' 0 0 1).exact_iff_isZero_homology).mpr hSc0_zero
    have hd00 : (X.sc' 0 0 1).f = 0 := X.shape 0 0 (by simp)
    let d₀ : X.X 0 ⟶ X.X 1 := X.d 0 1
    have hd0_mono : CategoryTheory.Mono d₀ :=
      ((X.sc' 0 0 1).exact_iff_mono hd00).mp hSc0_ex
    let L₀ : A_cat := CategoryTheory.Limits.cokernel d₀
    let p₀ : X.X 1 ⟶ L₀ := CategoryTheory.Limits.cokernel.π d₀
    let SC₀ : CategoryTheory.ShortComplex A_cat :=
      CategoryTheory.ShortComplex.mk d₀ p₀ (CategoryTheory.Limits.cokernel.condition d₀)
    have hSE₀ : SC₀.ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_cokernel d₀
        mono_f := hd0_mono
        epi_g := inferInstance }
    have : CategoryTheory.Injective SC₀.X₁ := hX_inj 0
    let split₀ : SC₀.Splitting := hSE₀.splittingOfInjective
    have : CategoryTheory.Injective (X.X 1) := hX_inj 1
    have hL₀_inj : CategoryTheory.Injective L₀ :=
      (CategoryTheory.Retract.mk split₀.s p₀ split₀.s_g).injective
    let d'₀ : L₀ ⟶ X.X 2 := CategoryTheory.Limits.cokernel.desc d₀ (X.d 1 2) (X.d_comp_d 0 1 2)
    have hp₀_d'₀ : p₀ ≫ d'₀ = X.d 1 2 :=
      CategoryTheory.Limits.cokernel.π_desc d₀ (X.d 1 2) (X.d_comp_d 0 1 2)
    have hd'₀_sq : d'₀ ≫ X.d 2 3 = 0 := by
      rw [← CategoryTheory.cancel_epi p₀, CategoryTheory.Limits.comp_zero,
        ← CategoryTheory.Category.assoc, hp₀_d'₀, X.d_comp_d 1 2 3]
    let X'_obj : ℕ → A_cat
      | 0 => L₀
      | m + 1 => X.X (m + 2)
    let X'_d : ∀ n : ℕ, X'_obj n ⟶ X'_obj (n + 1)
      | 0 => d'₀
      | m + 1 => X.d (m + 2) (m + 3)
    have X'_sq : ∀ n : ℕ, X'_d n ≫ X'_d (n + 1) = 0 := by
      intro n
      cases n with
      | zero => exact hd'₀_sq
      | succ m => exact X.d_comp_d (m + 2) (m + 3) (m + 4)
    let X' : CochainComplex A_cat ℕ := CochainComplex.of X'_obj X'_d X'_sq
    have hX'_d0 : X'.d 0 1 = d'₀ := CochainComplex.of_d _ _ (0 : ℕ)
    have hX'_d_succ : ∀ m : ℕ, X'.d (m + 1) (m + 2) = X.d (m + 2) (m + 3) :=
      fun m => CochainComplex.of_d _ _ (m + 1)
    have hX'_inj : ∀ n : ℕ, CategoryTheory.Injective (X'.X n) := by
      intro n
      cases n with
      | zero => exact hL₀_inj
      | succ m => exact hX_inj (m + 2)
    let FX := (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj X
    let FX' := (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj X'
    let splitF : (SC₀.map F).Splitting := split₀.map F
    have hSEF : (SC₀.map F).ShortExact := splitF.shortExact
    have : CategoryTheory.Mono (F.map d₀) := hSEF.mono_f
    have : CategoryTheory.Epi (F.map p₀) := hSEF.epi_g
    refine ⟨X', hX'_inj, ?_, ?_, ?_⟩
    · intro m
      rcases m with _ | _ | k
      · let S₁ := X.sc' 0 1 2
        let p_iso : CategoryTheory.Limits.cokernel S₁.f ≅ X'.X 0 := CategoryTheory.Iso.refl L₀
        let q_iso : S₁.X₃ ≅ X'.X 1 := CategoryTheory.Iso.refl (X.X 2)
        have hw : CategoryTheory.Limits.cokernel.desc S₁.f S₁.g S₁.zero ≫ q_iso.hom =
            p_iso.hom ≫ X'.d 0 1 :=
          (CategoryTheory.Category.comp_id _).trans
            (hX'_d0.symm.trans (CategoryTheory.Category.id_comp _).symm)
        let e_ker : CategoryTheory.Limits.kernel (CategoryTheory.Limits.cokernel.desc S₁.f S₁.g S₁.zero) ≅
            CategoryTheory.Limits.kernel (X'.d 0 1) :=
          CategoryTheory.Limits.kernel.mapIso _ _ p_iso q_iso hw
        let e_cyc : CategoryTheory.Limits.kernel (X'.d 0 1) ≅ X'.cycles 0 :=
          (CategoryTheory.Limits.kernelIsKernel (X'.d 0 1)).conePointUniqueUpToIso
            (X'.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0))
        exact ⟨(X.homologyIsoSc' 0 1 2 (CochainComplex.prev_nat_succ 0) (CochainComplex.next ℕ 1)).trans
          (S₁.homologyIsoKernelDesc.trans (e_ker.trans (e_cyc.trans (CochainComplex.isoHomologyπ₀ X'))))⟩
      · let S₂ := X.sc' 1 2 3
        let S'₁ := X'.sc' 0 1 2
        let φ₁ : S₂ ⟶ S'₁ :=
          { τ₁ := p₀
            τ₂ := 𝟙 (X.X 2)
            τ₃ := 𝟙 (X.X 3)
            comm₁₂ := by
              change p₀ ≫ X'.d 0 1 = X.d 1 2 ≫ 𝟙 (X.X 2)
              rw [CategoryTheory.Category.comp_id, hX'_d0, hp₀_d'₀]
            comm₂₃ := by
              change 𝟙 (X.X 2) ≫ X'.d 1 2 = X.d 2 3 ≫ 𝟙 (X.X 3)
              rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp, hX'_d_succ 0] }
        have : CategoryTheory.IsIso (CategoryTheory.ShortComplex.homologyMap φ₁) :=
          CategoryTheory.ShortComplex.isIso_homologyMap_of_epi_of_isIso_of_mono' φ₁
            (inferInstanceAs (CategoryTheory.Epi p₀))
            (inferInstanceAs (CategoryTheory.IsIso (𝟙 (X.X 2))))
            (inferInstanceAs (CategoryTheory.Mono (𝟙 (X.X 3))))
        exact ⟨(X.homologyIsoSc' 1 2 3 (CochainComplex.prev_nat_succ 1) (CochainComplex.next ℕ 2)).trans
          ((CategoryTheory.asIso (CategoryTheory.ShortComplex.homologyMap φ₁)).trans
            (X'.homologyIsoSc' 0 1 2 (CochainComplex.prev_nat_succ 0) (CochainComplex.next ℕ 1)).symm)⟩
      · let S_X := X.sc' (k + 2) (k + 3) (k + 4)
        let S_X' := X'.sc' (k + 1) (k + 2) (k + 3)
        let e_sc : S_X ≅ S_X' := CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by
            change 𝟙 _ ≫ X'.d (k + 1) (k + 2) = X.d (k + 2) (k + 3) ≫ 𝟙 _
            rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id, hX'_d_succ k])
          (by
            change 𝟙 _ ≫ X'.d (k + 2) (k + 3) = X.d (k + 3) (k + 4) ≫ 𝟙 _
            rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id, hX'_d_succ (k + 1)])
        exact ⟨(X.homologyIsoSc' (k + 2) (k + 3) (k + 4)
            (CochainComplex.prev_nat_succ (k + 2)) (CochainComplex.next ℕ (k + 3))).trans
          ((CategoryTheory.ShortComplex.homologyMapIso e_sc).trans
            (X'.homologyIsoSc' (k + 1) (k + 2) (k + 3)
              (CochainComplex.prev_nat_succ (k + 1)) (CochainComplex.next ℕ (k + 2))).symm)⟩
    · have hFX_d00 : (FX.sc' 0 0 1).f = 0 := FX.shape 0 0 (by simp)
      have hFX_mono : CategoryTheory.Mono (FX.sc' 0 0 1).g := by
        change CategoryTheory.Mono (F.map d₀)
        infer_instance
      have hFX_ex : (FX.sc' 0 0 1).Exact := ((FX.sc' 0 0 1).exact_iff_mono hFX_d00).mpr hFX_mono
      have hFX_sc_z : CategoryTheory.Limits.IsZero (FX.sc' 0 0 1).homology :=
        ((FX.sc' 0 0 1).exact_iff_isZero_homology).mp hFX_ex
      exact hFX_sc_z.of_iso
        (FX.homologyIsoSc' 0 0 1 CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0))
    · intro m
      rcases m with _ | _ | k
      · let S₁ := FX.sc' 0 1 2
        let hcok_std := CategoryTheory.Limits.cokernelIsCokernel S₁.f
        let hcokF := splitF.gIsCokernel
        let e_cok : CategoryTheory.Limits.cokernel S₁.f ≅ FX'.X 0 :=
          hcok_std.coconePointUniqueUpToIso hcokF
        let q_iso : S₁.X₃ ≅ FX'.X 1 := CategoryTheory.Iso.refl (F.obj (X.X 2))
        have hπ_ecok : CategoryTheory.Limits.cokernel.π S₁.f ≫ e_cok.hom = F.map p₀ :=
          hcok_std.comp_coconePointUniqueUpToIso_hom hcokF
            CategoryTheory.Limits.WalkingParallelPair.one
        have hecok_d : e_cok.hom ≫ FX'.d 0 1 =
            CategoryTheory.Limits.cokernel.desc S₁.f S₁.g S₁.zero :=
          (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π S₁.f)).mp <|
            (CategoryTheory.Category.assoc _ _ _).symm.trans <|
              (congrArg (· ≫ FX'.d 0 1) hπ_ecok).trans <|
                (congrArg (fun g => F.map p₀ ≫ F.map g) hX'_d0).trans <|
                  (F.map_comp p₀ d'₀).symm.trans <|
                    (congrArg F.map hp₀_d'₀).trans
                      (CategoryTheory.Limits.cokernel.π_desc S₁.f S₁.g S₁.zero).symm
        have hw : CategoryTheory.Limits.cokernel.desc S₁.f S₁.g S₁.zero ≫ q_iso.hom =
            e_cok.hom ≫ FX'.d 0 1 :=
          (CategoryTheory.Category.comp_id _).trans hecok_d.symm
        let e_ker : CategoryTheory.Limits.kernel (CategoryTheory.Limits.cokernel.desc S₁.f S₁.g S₁.zero) ≅
            CategoryTheory.Limits.kernel (FX'.d 0 1) :=
          CategoryTheory.Limits.kernel.mapIso _ _ e_cok q_iso hw
        let e_cyc : CategoryTheory.Limits.kernel (FX'.d 0 1) ≅ FX'.cycles 0 :=
          (CategoryTheory.Limits.kernelIsKernel (FX'.d 0 1)).conePointUniqueUpToIso
            (FX'.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0))
        exact ⟨(FX.homologyIsoSc' 0 1 2 (CochainComplex.prev_nat_succ 0) (CochainComplex.next ℕ 1)).trans
          (S₁.homologyIsoKernelDesc.trans (e_ker.trans (e_cyc.trans (CochainComplex.isoHomologyπ₀ FX'))))⟩
      · let S₂ := FX.sc' 1 2 3
        let S'₁ := FX'.sc' 0 1 2
        let φ₁ : S₂ ⟶ S'₁ :=
          { τ₁ := F.map p₀
            τ₂ := 𝟙 (F.obj (X.X 2))
