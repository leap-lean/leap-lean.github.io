      have h_left : (h ≫ ι.map g).left = h.left ≫ (ι.map g).left := rfl
      rw [h_left] at hfz
      change ((h.left ≫ (ι.map g).left).base) z = x at hfz
      rw [AlgebraicGeometry.Scheme.Hom.comp_base] at hfz
