        (fun u v _ _ hu hv => W_v.toSubring.add_mem hu hv)
        (fun u v _ _ hu hv => W_v.toSubring.mul_mem hu hv) hz
      rw [Finset.mem_coe, Finset.mem_union] at hy
      rcases hy with hyL | hyR
      · rw [Finset.mem_image] at hyL
        obtain ⟨r, _, rfl⟩ := hyL
        change algebraMap R₁ K₁ r ∈ W_v.toSubring
        rw [← hι_W_val]
        exact (ι_W r).2
      · rw [Finset.mem_image] at hyR
        obtain ⟨x, _, rfl⟩ := hyR
        exact (q_x x).2
    let j_W : ↥B₁ →+* W_v :=
      { toFun := fun z => ⟨z.1, hB₁_in_W z.1 z.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hjW_comp : j_W.comp j₁.toRingHom = ι_W := by
      ext r
      exact (hι_W_val r).symm
    let q_W : Ideal ↥B₁ := Ideal.comap j_W (IsLocalRing.maximalIdeal W_v)
    have : q_W.IsPrime := Ideal.comap_isPrime j_W (IsLocalRing.maximalIdeal W_v)
    have hx₀_qW : j₁ x₀ ∈ q_W := by
      change j_W (j₁ x₀) ∈ IsLocalRing.maximalIdeal W_v
      have h1 : j_W (j₁ x₀) = ι_W x₀ := congrFun (congrArg DFunLike.coe hjW_comp) x₀
      rw [h1]
      change x₀ ∈ Ideal.comap ι_W (IsLocalRing.maximalIdeal W_v)
      rwa [hcomap_ιW]
    have hspan_le_qW : Ideal.span {j₁ x₀} ≤ q_W :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx₀_qW)
    obtain ⟨p₁, hp₁_min, hp₁_le_qW⟩ := Ideal.exists_minimalPrimes_le hspan_le_qW
    have hp₁_prime : p₁.IsPrime := hp₁_min.1.1
    have hx₀_p₁ : j₁ x₀ ∈ p₁ := hp₁_min.1.2 (Ideal.subset_span rfl)
    have hj₁x₀_ne : j₁ x₀ ≠ 0 := fun h0 => hx₀_ne (hj₁_inj (h0.trans (map_zero j₁).symm))
    have hp₁_ne_bot : p₁ ≠ ⊥ := by
      intro hbot
      rw [hbot, Ideal.mem_bot] at hx₀_p₁
      exact hj₁x₀_ne hx₀_p₁
    have hcomap_p₁ : Ideal.comap j₁.toRingHom p₁ = p₀ := by
      apply le_antisymm
      · calc
          Ideal.comap j₁.toRingHom p₁ ≤ Ideal.comap j₁.toRingHom q_W := Ideal.comap_mono hp₁_le_qW
          _ = Ideal.comap (j_W.comp j₁.toRingHom) (IsLocalRing.maximalIdeal W_v) := rfl
          _ = p₀ := by rw [hjW_comp, hcomap_ιW]
      · rw [← hG, Ideal.span_le]
        intro x hx
        rw [SetLike.mem_coe, Ideal.mem_comap]
        let xg : G := ⟨x, hx⟩
        have hqx_mem : (q_x xg : K₁) ∈ B₁ :=
          Algebra.subset_adjoin
            (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_attach G xg))))
        have hfac : (j₁ x : ↥B₁) = j₁ x₀ * ⟨(q_x xg : K₁), hqx_mem⟩ := by
          ext
          change algebraMap R₁ K₁ x = algebraMap R₁ K₁ x₀ * (q_x xg : K₁)
          rw [← hι_W_val x, ← hι_W_val x₀]
          exact congrArg Subtype.val (hq_x xg)
        change j₁ x ∈ p₁
        rw [hfac]
        exact p₁.mul_mem_right _ hx₀_p₁
    have hp₁_ht : p₁.height ≤ ((1 : ℕ) : ℕ∞) :=
      Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {j₁ x₀}) p₁ hp₁_min
    have hno_between : ∀ (q : Ideal ↥B₁), q.IsPrime → ⊥ < q → ¬(q < p₁) := by
      intro q hq_prime hbot_lt hq_lt
      have hq_ht : q.height < ((1 : ℕ) : ℕ∞) :=
        (Ideal.height_le_iff (n := 1)).mp hp₁_ht q hq_prime hq_lt
      have hq_le0 : q.height ≤ ((0 : ℕ) : ℕ∞) := by
        cases h : q.height with
        | top => rw [h] at hq_ht; exact absurd hq_ht (not_top_lt)
        | coe m =>
          rw [h] at hq_ht
          have hm : m < 1 := Nat.cast_lt.mp hq_ht
          have hm0 : m = 0 := by omega
          simp [hm0]
      have hbot_ht : (⊥ : Ideal ↥B₁).height < ((0 : ℕ) : ℕ∞) :=
        (Ideal.height_le_iff (n := 0)).mp hq_le0 ⊥ hbot_prime hbot_lt
      exact not_lt_bot hbot_ht
    obtain ⟨hFin_norm, hIC_norm⟩ := hStage1 ↥B₁
    let B1_norm := integralClosure (↥B₁) (FractionRing (↥B₁))
    have : Module.Finite (↥B₁) ↥B1_norm := hFin_norm
    have : IsIntegrallyClosed ↥B1_norm := hIC_norm
    have : IsNoetherianRing ↥B1_norm := IsNoetherianRing.of_finite (↥B₁) ↥B1_norm
    have : Algebra.IsIntegral (↥B₁) ↥B1_norm := ⟨integralClosure.isIntegral⟩
    have hB₁_norm_inj : Function.Injective (algebraMap (↥B₁) ↥B1_norm) := by
      intro a b hab
      exact IsFractionRing.injective (↥B₁) (FractionRing (↥B₁)) (congrArg Subtype.val hab)
    have hunder_bot_le : Ideal.under (↥B₁) (⊥ : Ideal ↥B1_norm) ≤ p₁ := by
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_bot] at hx
      have hx0 : x = 0 := hB₁_norm_inj (hx.trans (map_zero _).symm)
      rw [hx0]
      exact p₁.zero_mem
    obtain ⟨p1_norm, _, hp1_norm_prime, hp1_norm_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral (R := ↥B₁) (S := ↥B1_norm) p₁ (⊥ : Ideal ↥B1_norm) hunder_bot_le
    have : p1_norm.IsPrime := hp1_norm_prime
    have hp1_norm_ne_bot : p1_norm ≠ ⊥ := by
      intro hbot
      apply hp₁_ne_bot
      rw [← hp1_norm_under, hbot, eq_bot_iff]
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_bot] at hx
      rw [Ideal.mem_bot]
      exact hB₁_norm_inj (hx.trans (map_zero _).symm)
    have hno_between_tilde : ∀ (Q : Ideal ↥B1_norm), Q.IsPrime → Q ≤ p1_norm → Q = ⊥ ∨ Q = p1_norm := by
      intro Q hQ_prime hQ_le
      by_cases hQ_bot : Q = ⊥
      · exact Or.inl hQ_bot
      · right
        by_contra hQ_ne
        have hbot_lt_Q : (⊥ : Ideal ↥B1_norm) < Q := lt_of_le_of_ne bot_le (Ne.symm hQ_bot)
        have hQ_lt : Q < p1_norm := lt_of_le_of_ne hQ_le hQ_ne
        have hlt1 : Ideal.under (↥B₁) (⊥ : Ideal ↥B1_norm) < Ideal.under (↥B₁) Q :=
          @Ideal.IsIntegral.under_lt_under (↥B₁) _ ↥B1_norm _ _ _ ⊥ Q hbot_prime hbot_lt_Q
        have hlt2 : Ideal.under (↥B₁) Q < Ideal.under (↥B₁) p1_norm :=
          @Ideal.IsIntegral.under_lt_under (↥B₁) _ ↥B1_norm _ _ _ Q p1_norm hQ_prime hQ_lt
        have hunder_bot : Ideal.under (↥B₁) (⊥ : Ideal ↥B1_norm) = ⊥ := by
          rw [eq_bot_iff]
          intro x hx
          rw [Ideal.mem_comap, Ideal.mem_bot] at hx
          rw [Ideal.mem_bot]
          exact hB₁_norm_inj (hx.trans (map_zero _).symm)
        rw [hunder_bot] at hlt1
        rw [hp1_norm_under] at hlt2
        exact hno_between (Ideal.under (↥B₁) Q) (Ideal.comap_isPrime _ Q) hlt1 hlt2
    have hLocDVR : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsNoetherianRing D]
        [IsIntegrallyClosed D] (P_D : Ideal D) [P_D.IsPrime],
        P_D ≠ ⊥ →
        (∀ Q : Ideal D, Q.IsPrime → Q ≤ P_D → Q = ⊥ ∨ Q = P_D) →
        ∃ (R₀ : Type u) (_ : CommRing R₀) (_ : IsDomain R₀) (_ : IsDiscreteValuationRing R₀)
          (α_loc : D →+* R₀),
          Function.Injective α_loc ∧
          Ideal.comap α_loc (IsLocalRing.maximalIdeal R₀) = P_D := by
      intro D _ _ _ _ P_D _ hPD_ne hPD_min
      let L_D : Type u := Localization.AtPrime P_D
      have : IsIntegrallyClosed L_D :=
        isIntegrallyClosed_of_isLocalization L_D P_D.primeCompl
          (Ideal.primeCompl_le_nonZeroDivisors P_D)
      have hunder_m : Ideal.comap (algebraMap D L_D) (IsLocalRing.maximalIdeal L_D) = P_D :=
        IsLocalization.AtPrime.under_maximalIdeal L_D P_D
      have hinj_D : Function.Injective (algebraMap D L_D) :=
        IsLocalization.injective L_D (Ideal.primeCompl_le_nonZeroDivisors P_D)
      have hm_ne_bot : IsLocalRing.maximalIdeal L_D ≠ ⊥ := by
        intro hbot
        apply hPD_ne
        rw [← hunder_m, hbot, eq_bot_iff]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_bot] at hx
        rw [Ideal.mem_bot]
        exact hinj_D (hx.trans (map_zero _).symm)
      have hNotField : ¬IsField L_D := by
        intro hF
        have hex_nz : ∃ x ∈ IsLocalRing.maximalIdeal L_D, x ≠ 0 := by
          by_contra! hall
          exact hm_ne_bot (eq_bot_iff.mpr fun x hx => Ideal.mem_bot.mpr (hall x hx))
        obtain ⟨x, hx_mem, hx_ne⟩ := hex_nz
        obtain ⟨y, hy⟩ := hF.mul_inv_cancel hx_ne
        exact (IsLocalRing.maximalIdeal.isMaximal L_D).ne_top
          (Ideal.eq_top_of_isUnit_mem _ hx_mem (isUnit_iff_exists_inv.mpr ⟨y, hy⟩))
      let ePrime := IsLocalization.orderIsoOfPrime P_D.primeCompl L_D
      have hCodom_two : ∀ q : { Q : Ideal D // Q.IsPrime ∧ Disjoint (P_D.primeCompl : Set D) Q },
          q.1 = ⊥ ∨ q.1 = P_D := by
        rintro ⟨Q, hQ_pr, hQ_disj⟩
        refine hPD_min Q hQ_pr (fun x hx => ?_)
        by_contra hx_not
        exact Set.disjoint_left.mp hQ_disj hx_not hx
      have hUniqueP : ∀ P : Ideal L_D, P ≠ ⊥ ∧ P.IsPrime → P = IsLocalRing.maximalIdeal L_D := by
        rintro P ⟨hP_ne, hP_pr⟩
        let pBot : { Q : Ideal L_D // Q.IsPrime } := ⟨⊥, hbot_prime⟩
        let pMax : { Q : Ideal L_D // Q.IsPrime } := ⟨IsLocalRing.maximalIdeal L_D, inferInstance⟩
        let pCur : { Q : Ideal L_D // Q.IsPrime } := ⟨P, hP_pr⟩
        have hlt_cur : ePrime pBot < ePrime pCur :=
          ePrime.lt_iff_lt.mpr (lt_of_le_of_ne (show pBot.1 ≤ pCur.1 from bot_le)
            (fun h => hP_ne (congrArg Subtype.val h).symm))
        have hlt_max : ePrime pBot < ePrime pMax :=
          ePrime.lt_iff_lt.mpr (lt_of_le_of_ne (show pBot.1 ≤ pMax.1 from bot_le)
            (fun h => hm_ne_bot (congrArg Subtype.val h).symm))
        have hcur_eq : (ePrime pCur).1 = P_D := by
          rcases hCodom_two (ePrime pCur) with hbot | hp
          · exfalso
            have hle : (ePrime pCur).1 ≤ (ePrime pBot).1 := by rw [hbot]; exact bot_le
            exact not_le_of_gt hlt_cur hle
          · exact hp
        have hmax_eq : (ePrime pMax).1 = P_D := by
          rcases hCodom_two (ePrime pMax) with hbot | hp
          · exfalso
            have hle : (ePrime pMax).1 ≤ (ePrime pBot).1 := by rw [hbot]; exact bot_le
            exact not_le_of_gt hlt_max hle
          · exact hp
        have heq_sub : pCur = pMax :=
          ePrime.injective (Subtype.ext (hcur_eq.trans hmax_eq.symm))
        exact congrArg Subtype.val heq_sub
      have hIC_uniq : IsIntegrallyClosed L_D ∧ ∃! P : Ideal L_D, P ≠ ⊥ ∧ P.IsPrime :=
        ⟨inferInstance, ⟨IsLocalRing.maximalIdeal L_D, ⟨hm_ne_bot, inferInstance⟩, hUniqueP⟩⟩
      have hDVR : IsDiscreteValuationRing L_D :=
        ((IsDiscreteValuationRing.TFAE L_D hNotField).out 4 1).mp hIC_uniq
      exact ⟨L_D, inferInstance, inferInstance, hDVR, algebraMap D L_D, hinj_D, hunder_m⟩
    obtain ⟨R₀, hCR_R₀, hDom_R₀, hDVR_R₀, α_Bnorm_R₀, hinj_loc, hunder_mR₀⟩ :=
      hLocDVR ↥B1_norm p1_norm hp1_norm_ne_bot hno_between_tilde
    let _ := hCR_R₀
    let _ := hDom_R₀
    let _ := hDVR_R₀
    let φ_ring : R₁ →+* R₀ := α_Bnorm_R₀.comp ((algebraMap (↥B₁) ↥B1_norm).comp j₁.toRingHom)
    let alg_k_R₀ : Algebra k R₀ :=
      (α_Bnorm_R₀.comp ((algebraMap (↥B₁) ↥B1_norm).comp (algebraMap k (↥B₁)))).toAlgebra
    let _ : Algebra k R₀ := alg_k_R₀
    let φ₀ : R₁ →ₐ[k] R₀ :=
      { φ_ring with
        commutes' := fun c => by
          change α_Bnorm_R₀ (algebraMap (↥B₁) ↥B1_norm (j₁ (algebraMap k R₁ c))) =
            α_Bnorm_R₀ (algebraMap (↥B₁) ↥B1_norm (algebraMap k (↥B₁) c))
          rw [AlgHom.commutes] }
    have hφ₀_inj : Function.Injective φ₀ := hinj_loc.comp (hB₁_norm_inj.comp hj₁_inj)
    have hφ₀_comap : Ideal.comap φ₀.toRingHom (IsLocalRing.maximalIdeal R₀) = p₀ := by
      change Ideal.comap j₁.toRingHom
        (Ideal.comap (algebraMap (↥B₁) ↥B1_norm)
          (Ideal.comap α_Bnorm_R₀ (IsLocalRing.maximalIdeal R₀))) = p₀
      rw [hunder_mR₀]
      change Ideal.comap j₁.toRingHom (Ideal.under (↥B₁) p1_norm) = p₀
      rw [hp1_norm_under, hcomap_p₁]
    exact ⟨R₀, hCR_R₀, hDom_R₀, alg_k_R₀, hDVR_R₀, φ₀, hφ₀_inj, hφ₀_comap⟩
  have hStage3 : ∀ (R₀ : Type u) [CommRing R₀] [IsDomain R₀] [IsDiscreteValuationRing R₀],
      ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R)
        (_ : IsDiscreteValuationRing R) (_ : HenselianLocalRing R)
        (_ : IsSepClosed (IsLocalRing.ResidueField R))
        (j : R₀ →+* R),
        Function.Injective j ∧
        Ideal.comap j (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R₀ := by
    intro R₀ _ _ _
    classical
    obtain ⟨π₀, hπ₀_irr⟩ := IsDiscreteValuationRing.exists_irreducible R₀
    have hπ₀_ne : π₀ ≠ 0 := hπ₀_irr.ne_zero
    have hm₀_eq : IsLocalRing.maximalIdeal R₀ = Ideal.span {π₀} :=
      (IsLocalRing.eq_maximalIdeal (PrincipalIdealRing.isMaximal_of_irreducible hπ₀_irr)).symm
    have hex_amb : ∃ (K_sep : Type u) (_ : Field K_sep) (_ : IsSepClosed K_sep)
        (V : Type u) (_ : CommRing V) (_ : IsDomain V) (_ : IsLocalRing V)
        (ι_V : R₀ →+* V) (val_V : V →+* K_sep),
        Function.Injective ι_V ∧
        Function.Injective val_V ∧
        Ideal.comap ι_V (IsLocalRing.maximalIdeal V) = IsLocalRing.maximalIdeal R₀ ∧
        ∀ (P : Polynomial K_sep), P.Monic → (∀ n : ℕ, P.coeff n ∈ Set.range val_V) →
          ∀ y : K_sep, P.eval y = 0 → y ∈ Set.range val_V := by
      let K₀ : Type u := FractionRing R₀
      let Ks : Type u := SeparableClosure K₀
      have : IsSepClosed Ks := SeparableClosure.isSepClosed K₀
      let ι_sep : R₀ →+* Ks := (algebraMap K₀ Ks).comp (algebraMap R₀ K₀)
      have hι_sep_inj : Function.Injective ι_sep :=
        (RingHom.injective (algebraMap K₀ Ks)).comp (IsFractionRing.injective R₀ K₀)
      obtain ⟨Vs, hV_mem, hV_loc⟩ := IsLocalRing.exists_factor_valuationRing ι_sep
      let ι_Vs : R₀ →+* Vs := ι_sep.codRestrict Vs.toSubring hV_mem
      have : IsLocalHom ι_Vs := hV_loc
      have hι_Vs_inj : Function.Injective ι_Vs := fun a b hab =>
        hι_sep_inj (congrArg Subtype.val hab)
      have hcomap : Ideal.comap ι_Vs (IsLocalRing.maximalIdeal Vs) = IsLocalRing.maximalIdeal R₀ := by
        ext r
        simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
      refine ⟨Ks, inferInstance, inferInstance, ↥Vs, inferInstance, inferInstance, inferInstance,
        ι_Vs, Vs.subtype, hι_Vs_inj, Subtype.val_injective, hcomap, ?_⟩
      intro P hP_monic hP_coeff y hy_eval
      have hrange_eq : ∀ z : Ks, (z ∈ Set.range Vs.subtype) ↔ z ∈ Vs :=
        fun z => ⟨fun ⟨u, hu⟩ => hu ▸ u.2, fun hz => ⟨⟨z, hz⟩, rfl⟩⟩
      rw [hrange_eq]
      by_contra hy_not
      have hy_ne : y ≠ 0 := fun h0 => hy_not (h0 ▸ Vs.zero_mem)
      have hy_inv_mem : y⁻¹ ∈ Vs := (ValuationSubring.mem_or_inv_mem Vs y).resolve_left hy_not
      let d := P.natDegree
      have hd_pos : 0 < d := by
        by_contra hd0
        have hd_eq : P.natDegree = 0 := Nat.eq_zero_of_not_pos hd0
        have hP1 : P = 1 := Polynomial.eq_one_of_monic_natDegree_zero hP_monic hd_eq
        rw [hP1, Polynomial.eval_one] at hy_eval
        exact one_ne_zero hy_eval
      have hsum0 : (∑ i ∈ Finset.range d, P.coeff i * y ^ i) + y ^ d = 0 := by
        have h1 := hy_eval
        rw [Polynomial.eval_eq_sum_range, Finset.sum_range_succ, hP_monic.coeff_natDegree, one_mul] at h1
        exact h1
      have hmul0 := congrArg (· * (y⁻¹) ^ (d - 1)) hsum0
      rw [zero_mul, add_mul, Finset.sum_mul] at hmul0
      have htop_term : y ^ d * (y⁻¹) ^ (d - 1) = y := by
        have hd_pow : y ^ d = y * y ^ (d - 1) := by
          conv_lhs => rw [← Nat.sub_add_cancel hd_pos]
          rw [pow_succ']
        calc
          y ^ d * (y⁻¹) ^ (d - 1) = (y * y ^ (d - 1)) * (y⁻¹) ^ (d - 1) := by rw [hd_pow]
          _ = y * (y * y⁻¹) ^ (d - 1) := by rw [mul_assoc, ← mul_pow]
          _ = y := by rw [mul_inv_cancel₀ hy_ne, one_pow, mul_one]
      rw [htop_term] at hmul0
      have hy_eq : y = - ∑ i ∈ Finset.range d, P.coeff i * (y ^ i * (y⁻¹) ^ (d - 1)) := by
        have h2 := eq_neg_of_add_eq_zero_right hmul0
        simpa [mul_assoc] using h2
      apply hy_not
      rw [hy_eq]
      refine Vs.toSubring.neg_mem (Vs.toSubring.sum_mem fun i hi =>
        Vs.toSubring.mul_mem ((hrange_eq _).mp (hP_coeff i)) ?_)
      have hi_lt : i < d := Finset.mem_range.mp hi
      have hsub : d - 1 = i + (d - 1 - i) := by omega
      have hpow_eq : (y⁻¹) ^ (d - 1) = (y⁻¹) ^ i * (y⁻¹) ^ (d - 1 - i) := by
        rw [← pow_add, ← hsub]
      have heq : y ^ i * (y⁻¹) ^ (d - 1) = (y⁻¹) ^ (d - 1 - i) := by
        rw [hpow_eq, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ hy_ne, one_pow, one_mul]
      rw [heq]
      exact Vs.toSubring.pow_mem hy_inv_mem _
    obtain ⟨K_sep, hFieldK, hSepK, V, hCR_V, hDom_V, hLoc_V, ι_V, val_V,
      hι_V_inj, hval_V_inj, hcomap_mV, hMonicRoot_in_V⟩ := hex_amb
    let _ := hFieldK
    let _ := hSepK
    let _ := hCR_V
    let _ := hDom_V
    let _ := hLoc_V
    let _ : Algebra R₀ V := ι_V.toAlgebra
    have hmV_max : (IsLocalRing.maximalIdeal V).IsMaximal := IsLocalRing.maximalIdeal.isMaximal V
    have hmV_prime : (IsLocalRing.maximalIdeal V).IsPrime := hmV_max.isPrime
    have hmV_ne_top : IsLocalRing.maximalIdeal V ≠ ⊤ := hmV_max.ne_top
    have hmV_one_notMem : (1 : V) ∉ IsLocalRing.maximalIdeal V :=
      fun h1 => hmV_ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    have hπ_V_mem : algebraMap R₀ V π₀ ∈ IsLocalRing.maximalIdeal V := by
      change π₀ ∈ Ideal.comap ι_V (IsLocalRing.maximalIdeal V)
      rw [hcomap_mV, hm₀_eq]
      exact Ideal.subset_span rfl
    have hπ_V_ne : algebraMap R₀ V π₀ ≠ 0 := fun h0 =>
      hπ₀_ne (hι_V_inj (h0.trans (map_zero ι_V).symm))
    have hFT_of_finset : ∀ t : Finset V, Algebra.FiniteType R₀ ↥(Algebra.adjoin R₀ (t : Set V)) := by
      intro t
      let s_t : Finset ↥(Algebra.adjoin R₀ (t : Set V)) :=
        t.attach.image (fun z => ⟨z.1, Algebra.subset_adjoin z.2⟩)
      refine ⟨⟨s_t, eq_top_iff.mpr ?_⟩⟩
      intro x _
      have hmem : ∀ z ∈ Algebra.adjoin R₀ (t : Set V),
          ∀ w : ↥(Algebra.adjoin R₀ (t : Set V)), w.1 = z →
          w ∈ Algebra.adjoin R₀ (s_t : Set ↥(Algebra.adjoin R₀ (t : Set V))) := by
        intro z hz
        refine Algebra.adjoin_induction
          (fun y hy w hw => by
            have hwy : w = ⟨y, Algebra.subset_adjoin hy⟩ := Subtype.ext hw
            rw [hwy]
            exact Algebra.subset_adjoin
              (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_attach t ⟨y, hy⟩))))
          (fun r w hw => by
            have hwr : w = algebraMap R₀ _ r := Subtype.ext hw
            rw [hwr]
            exact Subalgebra.algebraMap_mem _ r)
          (fun u v hu hv ihu ihv w hw => by
            have hwu : w = ⟨u, hu⟩ + ⟨v, hv⟩ := Subtype.ext hw
            rw [hwu]
            exact Subalgebra.add_mem _ (ihu _ rfl) (ihv _ rfl))
          (fun u v hu hv ihu ihv w hw => by
            have hwu : w = ⟨u, hu⟩ * ⟨v, hv⟩ := Subtype.ext hw
            rw [hwu]
            exact Subalgebra.mul_mem _ (ihu _ rfl) (ihv _ rfl)) hz
      exact hmem x.1 x.2 x rfl
    have hAdjoin_of_FT : ∀ {A : Subalgebra R₀ V}, Algebra.FiniteType R₀ ↥A →
        ∃ t : Finset V, Algebra.adjoin R₀ (t : Set V) = A := by
      intro A hFT
      obtain ⟨s_fg, hs⟩ := hFT.out
      refine ⟨s_fg.image A.val, le_antisymm ?_ ?_⟩
      · rw [Algebra.adjoin_le_iff]
        intro z hz
        rw [Finset.mem_coe, Finset.mem_image] at hz
        obtain ⟨u, _, rfl⟩ := hz
        exact u.2
      · intro z hz
        have hz' : (⟨z, hz⟩ : ↥A) ∈ Algebra.adjoin R₀ (s_fg : Set ↥A) := by rw [hs]; trivial
        have hmem : ∀ x ∈ Algebra.adjoin R₀ (s_fg : Set ↥A),
            x.1 ∈ Algebra.adjoin R₀ ((s_fg.image A.val : Finset V) : Set V) := by
          intro x hx
          refine Algebra.adjoin_induction
            (fun u hu => Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hu)))
            (fun r => (Algebra.adjoin R₀ _).algebraMap_mem r)
            (fun _ _ _ _ hu hv => (Algebra.adjoin R₀ _).add_mem hu hv)
            (fun _ _ _ _ hu hv => (Algebra.adjoin R₀ _).mul_mem hu hv) hx
        exact hmem ⟨z, hz⟩ hz'
    have hFT_sup : ∀ {A₁ A₂ : Subalgebra R₀ V},
        Algebra.FiniteType R₀ ↥A₁ → Algebra.FiniteType R₀ ↥A₂ →
        Algebra.FiniteType R₀ ↥(A₁ ⊔ A₂) := by
      intro A₁ A₂ h₁ h₂
      obtain ⟨t₁, rfl⟩ := hAdjoin_of_FT h₁
      obtain ⟨t₂, rfl⟩ := hAdjoin_of_FT h₂
      have heq : Algebra.adjoin R₀ (t₁ : Set V) ⊔ Algebra.adjoin R₀ (t₂ : Set V) =
          Algebra.adjoin R₀ ((t₁ ∪ t₂ : Finset V) : Set V) := by
        rw [Finset.coe_union, Algebra.adjoin_union]
      rw [heq]
      exact hFT_of_finset (t₁ ∪ t₂)
    have hFT_adjoin_singleton : ∀ {A : Subalgebra R₀ V} (y : V),
        Algebra.FiniteType R₀ ↥A →
        Algebra.FiniteType R₀ ↥(Algebra.adjoin R₀ ((A : Set V) ∪ {y})) := by
      intro A y hA
      obtain ⟨t, rfl⟩ := hAdjoin_of_FT hA
      have heq : Algebra.adjoin R₀ ((Algebra.adjoin R₀ (t : Set V) : Set V) ∪ {y}) =
          Algebra.adjoin R₀ ((insert y t : Finset V) : Set V) := by
        apply le_antisymm
        · rw [Algebra.adjoin_le_iff, Set.union_subset_iff]
          refine ⟨?_, Set.singleton_subset_iff.mpr (Algebra.subset_adjoin (by simp))⟩
          change Algebra.adjoin R₀ (t : Set V) ≤ Algebra.adjoin R₀ ((insert y t : Finset V) : Set V)
          exact Algebra.adjoin_mono (by intro z hz; simp [hz])
        · rw [Algebra.adjoin_le_iff]
          intro z hz
          rw [Finset.mem_coe, Finset.mem_insert] at hz
          rcases hz with rfl | hzt
          · exact Algebra.subset_adjoin (Or.inr rfl)
          · exact Algebra.subset_adjoin (Or.inl (Algebra.subset_adjoin hzt))
      rw [heq]
      exact hFT_of_finset (insert y t)
    have hex_Sof : ∃ S_of : Subalgebra R₀ V → Subalgebra R₀ V,
        ∀ (A : Subalgebra R₀ V) (x : V),
          x ∈ S_of A ↔ ∃ a ∈ A, ∃ s_den ∈ A, s_den ∉ IsLocalRing.maximalIdeal V ∧ x * s_den = a := by
      refine ⟨fun A =>
        { carrier := { x : V | ∃ a ∈ A, ∃ s_den ∈ A, s_den ∉ IsLocalRing.maximalIdeal V ∧ x * s_den = a }
          one_mem' := ⟨1, A.one_mem, 1, A.one_mem, hmV_one_notMem, mul_one 1⟩
          zero_mem' := ⟨0, A.zero_mem, 1, A.one_mem, hmV_one_notMem, zero_mul 1⟩
          add_mem' := by
            rintro x₁ x₂ ⟨a₁, ha₁, s₁, hs₁, hsm₁, hx₁⟩ ⟨a₂, ha₂, s₂, hs₂, hsm₂, hx₂⟩
            refine ⟨a₁ * s₂ + a₂ * s₁, A.add_mem (A.mul_mem ha₁ hs₂) (A.mul_mem ha₂ hs₁),
              s₁ * s₂, A.mul_mem hs₁ hs₂, hmV_prime.mul_notMem hsm₁ hsm₂, ?_⟩
            calc
              (x₁ + x₂) * (s₁ * s₂) = (x₁ * s₁) * s₂ + (x₂ * s₂) * s₁ := by ring
              _ = a₁ * s₂ + a₂ * s₁ := by rw [hx₁, hx₂]
          mul_mem' := by
            rintro x₁ x₂ ⟨a₁, ha₁, s₁, hs₁, hsm₁, hx₁⟩ ⟨a₂, ha₂, s₂, hs₂, hsm₂, hx₂⟩
            refine ⟨a₁ * a₂, A.mul_mem ha₁ ha₂, s₁ * s₂, A.mul_mem hs₁ hs₂,
              hmV_prime.mul_notMem hsm₁ hsm₂, ?_⟩
            calc
              (x₁ * x₂) * (s₁ * s₂) = (x₁ * s₁) * (x₂ * s₂) := by ring
              _ = a₁ * a₂ := by rw [hx₁, hx₂]
          algebraMap_mem' := fun r =>
            ⟨algebraMap R₀ V r, A.algebraMap_mem r, 1, A.one_mem, hmV_one_notMem, mul_one _⟩ },
        fun _ _ => Iff.rfl⟩
    obtain ⟨S_of, hS_mem⟩ := hex_Sof
    have hA_le_S : ∀ A : Subalgebra R₀ V, A ≤ S_of A := fun A a ha =>
      (hS_mem A a).mpr ⟨a, ha, 1, A.one_mem, hmV_one_notMem, mul_one a⟩
    have hS_mono : ∀ {A₁ A₂ : Subalgebra R₀ V}, A₁ ≤ A₂ → S_of A₁ ≤ S_of A₂ :=
      fun {A₁ A₂} h x hx => by
        obtain ⟨a, ha, s_den, hs, hsm, hxs⟩ := (hS_mem A₁ x).mp hx
        exact (hS_mem A₂ x).mpr ⟨a, h ha, s_den, h hs, hsm, hxs⟩
    have hS_div_mem : ∀ (A : Subalgebra R₀ V) {a s_den : V},
        a ∈ A → s_den ∈ A → s_den ∉ IsLocalRing.maximalIdeal V →
        ∃ z : ↥(S_of A), z.1 * s_den = a := by
      intro A a s_den ha hs hsm
      obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp hsm
      have hmul : (a * ↑(u⁻¹)) * s_den = a := by
        rw [← hu, mul_assoc, Units.inv_mul, mul_one]
      exact ⟨⟨a * ↑(u⁻¹), (hS_mem A _).mpr ⟨a, ha, s_den, hs, hsm, hmul⟩⟩, hmul⟩
    have hS_unit_iff : ∀ (A : Subalgebra R₀ V) (z : ↥(S_of A)),
        IsUnit z ↔ z.1 ∉ IsLocalRing.maximalIdeal V := by
      intro A z
      constructor
      · rintro ⟨u, rfl⟩ hm
        exact hmV_ne_top
          (Ideal.eq_top_of_isUnit_mem _ hm ((u.map (S_of A).val.toMonoidHom).isUnit))
      · intro hzm
        obtain ⟨a, ha, s_den, hs, hsm, hzs⟩ := (hS_mem A z.1).mp z.2
        have ham : a ∉ IsLocalRing.maximalIdeal V := by
          rw [← hzs]
          exact hmV_prime.mul_notMem hzm hsm
        obtain ⟨w, hwa⟩ := hS_div_mem A hs ha ham
        refine isUnit_iff_exists_inv.mpr ⟨w, Subtype.ext ?_⟩
        have h_ne_s : s_den ≠ 0 := fun h0 => hsm (h0 ▸ (IsLocalRing.maximalIdeal V).zero_mem)
        apply mul_right_cancel₀ h_ne_s
        calc
          (z * w).1 * s_den = w.1 * (z.1 * s_den) := by change (z.1 * w.1) * s_den = _; ring
          _ = w.1 * a := by rw [hzs]
          _ = 1 * s_den := by rw [hwa, one_mul]
    have instLocalS : ∀ A : Subalgebra R₀ V, IsLocalRing ↥(S_of A) := fun A =>
      IsLocalRing.of_nonunits_add fun z₁ z₂ hz₁ hz₂ => by
        rw [mem_nonunits_iff, hS_unit_iff, not_not] at hz₁ hz₂ ⊢
        exact (IsLocalRing.maximalIdeal V).add_mem hz₁ hz₂
    let _ : ∀ A : Subalgebra R₀ V, IsLocalRing ↥(S_of A) := instLocalS
    have hmS_mem : ∀ (A : Subalgebra R₀ V) (z : ↥(S_of A)),
        z ∈ IsLocalRing.maximalIdeal ↥(S_of A) ↔ z.1 ∈ IsLocalRing.maximalIdeal V := by
      intro A z
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hS_unit_iff, not_not]
    have hLocalHom_alg : ∀ A : Subalgebra R₀ V, IsLocalHom (algebraMap R₀ ↥(S_of A)) := fun A =>
      ⟨fun r hr => by
        rw [← IsLocalRing.notMem_maximalIdeal, ← hcomap_mV, Ideal.mem_comap]
        exact (hS_unit_iff A _).mp hr⟩
    have hNoethS : ∀ (A : Subalgebra R₀ V), Algebra.FiniteType R₀ ↥A →
        IsNoetherianRing ↥(S_of A) := by
      intro A hFT
      have : IsNoetherianRing ↥A := Algebra.FiniteType.isNoetherianRing R₀ ↥A
      let _ : Algebra ↥A ↥(S_of A) := (Subalgebra.inclusion (hA_le_S A)).toAlgebra
      let p_A : Ideal ↥A := Ideal.comap A.val (IsLocalRing.maximalIdeal V)
      have : p_A.IsPrime := Ideal.comap_isPrime A.val (IsLocalRing.maximalIdeal V)
      have hLoc : IsLocalization p_A.primeCompl ↥(S_of A) :=
        { map_units := fun ⟨s_den, hs⟩ => (hS_unit_iff A _).mpr hs
          surj := fun z => by
            obtain ⟨a, ha, s_den, hs, hsm, hzs⟩ := (hS_mem A z.1).mp z.2
            exact ⟨(⟨a, ha⟩, ⟨⟨s_den, hs⟩, hsm⟩), Subtype.ext hzs⟩
          exists_of_eq := fun {x y} hxy =>
            ⟨1, Subtype.ext (by
              rw [OneMemClass.coe_one, one_mul, one_mul]
              exact congrArg (fun z : ↥(S_of A) => z.1) hxy)⟩ }
      exact @IsLocalization.isNoetherianRing ↥A _ p_A.primeCompl ↥(S_of A) _ _ hLoc inferInstance
    have hAlgFT_of_modFin : ∀ (F E : Type u) [Field F] [CommRing E] [Algebra F E]
        [Module.Finite F E], Algebra.FiniteType F E := by
      intro F E _ _ _ hFin
      rcases hFin with ⟨⟨s_fg, hs⟩⟩
      refine ⟨⟨s_fg, eq_top_iff.mpr ?_⟩⟩
      intro x _
      have hx_span : x ∈ Submodule.span F (s_fg : Set E) := by rw [hs]; trivial
      have hle : Submodule.span F (s_fg : Set E) ≤ (Algebra.adjoin F (s_fg : Set E)).toSubmodule :=
        Submodule.span_le.mpr (Algebra.subset_adjoin (R := F) (s := (s_fg : Set E)))
      exact hle hx_span
    let inD : Subalgebra R₀ V → Prop := fun A =>
      Algebra.FiniteType R₀ ↥A ∧
      IsLocalRing.maximalIdeal ↥(S_of A) = Ideal.span {algebraMap R₀ ↥(S_of A) π₀} ∧
      Module.Finite (IsLocalRing.ResidueField R₀) (IsLocalRing.ResidueField ↥(S_of A)) ∧
      Algebra.IsSeparable (IsLocalRing.ResidueField R₀) (IsLocalRing.ResidueField ↥(S_of A))
    let quotMap_κ₀ : ∀ B : Subalgebra R₀ V,
        IsLocalRing.ResidueField R₀ →+* (↥(S_of B) ⧸ Ideal.span {algebraMap R₀ ↥(S_of B) π₀}) := fun B =>
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal R₀)
        ((Ideal.Quotient.mk (Ideal.span {algebraMap R₀ ↥(S_of B) π₀})).comp (algebraMap R₀ ↥(S_of B)))
        (fun r hr => by
          rw [hm₀_eq, Ideal.mem_span_singleton] at hr
          obtain ⟨c, rfl⟩ := hr
          simp only [RingHom.comp_apply]
          rw [Ideal.Quotient.eq_zero_iff_mem, map_mul]
          exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl))
    have hUpgrade : ∀ (B : Subalgebra R₀ V), Algebra.FiniteType R₀ ↥B →
        ∀ (E : Type u) [Field E] [Algebra (IsLocalRing.ResidueField R₀) E]
          [Module.Finite (IsLocalRing.ResidueField R₀) E]
          [Algebra.IsSeparable (IsLocalRing.ResidueField R₀) E]
          (θ : E →+* (↥(S_of B) ⧸ Ideal.span {algebraMap R₀ ↥(S_of B) π₀})),
          θ.comp (algebraMap (IsLocalRing.ResidueField R₀) E) = quotMap_κ₀ B →
          Function.Surjective θ →
          inD B := by
      intro B hFT_B E _ _ _ _ θ hθ_comm hθ_surj
      let π_B : ↥(S_of B) := algebraMap R₀ ↥(S_of B) π₀
      let I_B : Ideal ↥(S_of B) := Ideal.span {π_B}
      have hπ_B_mem : π_B ∈ IsLocalRing.maximalIdeal ↥(S_of B) :=
        (hmS_mem B π_B).mpr hπ_V_mem
      have hI_le_m : I_B ≤ IsLocalRing.maximalIdeal ↥(S_of B) :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_B_mem)
      have hI_ne_top : I_B ≠ ⊤ :=
        ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top hI_le_m
      have : Nontrivial (↥(S_of B) ⧸ I_B) := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
      let e_ring : E ≃+* (↥(S_of B) ⧸ I_B) :=
        RingEquiv.ofBijective θ ⟨θ.injective, hθ_surj⟩
      have hIsField_Q : IsField (↥(S_of B) ⧸ I_B) :=
        { exists_pair_ne := ⟨0, 1, zero_ne_one⟩
          mul_comm := mul_comm
          mul_inv_cancel := fun {x} hx => by
            have hx' : e_ring.symm x ≠ 0 := fun h0 =>
              hx (by rw [← e_ring.apply_symm_apply x, h0, map_zero])
            refine ⟨e_ring (e_ring.symm x)⁻¹, ?_⟩
            rw [← e_ring.apply_symm_apply x, ← map_mul, RingEquiv.symm_apply_apply,
              mul_inv_cancel₀ hx', map_one] }
      have hMax_I : I_B.IsMaximal := ⟨⟨hI_ne_top, fun J hIJ => by
        obtain ⟨x, hxJ, hxI⟩ := SetLike.exists_of_lt hIJ
        have hqx_ne : Ideal.Quotient.mk I_B x ≠ 0 := fun h0 =>
          hxI (Ideal.Quotient.eq_zero_iff_mem.mp h0)
        obtain ⟨y, hy⟩ := hIsField_Q.mul_inv_cancel hqx_ne
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hmem : x * z - 1 ∈ I_B := Ideal.Quotient.eq.mp (by rwa [map_mul])
        have h1J : (1 : ↥(S_of B)) ∈ J := by
          simpa using J.sub_mem (J.mul_mem_right z hxJ) (le_of_lt hIJ hmem)
        exact Ideal.eq_top_of_isUnit_mem J h1J isUnit_one⟩⟩
      have hm_eq : IsLocalRing.maximalIdeal ↥(S_of B) = I_B :=
        (IsLocalRing.eq_maximalIdeal hMax_I).symm
      let e_res : (↥(S_of B) ⧸ I_B) ≃+* IsLocalRing.ResidueField ↥(S_of B) :=
        Ideal.quotEquivOfEq hm_eq.symm
      let e_tot : E ≃+* IsLocalRing.ResidueField ↥(S_of B) := e_ring.trans e_res
      have he_comm : ∀ c : IsLocalRing.ResidueField R₀,
          e_tot (algebraMap _ E c) = algebraMap _ _ c := by
        intro c
        obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective (R := R₀) c
        have h1 : θ (algebraMap _ E (IsLocalRing.residue R₀ r)) =
            quotMap_κ₀ B (IsLocalRing.residue R₀ r) :=
          congrFun (congrArg DFunLike.coe hθ_comm) (IsLocalRing.residue R₀ r)
        change e_res (θ (algebraMap _ E (IsLocalRing.residue R₀ r))) =
          IsLocalRing.ResidueField.map (algebraMap R₀ ↥(S_of B)) (IsLocalRing.residue R₀ r)
        rw [h1]
        change e_res (Ideal.Quotient.mk I_B (algebraMap R₀ ↥(S_of B) r)) =
          IsLocalRing.ResidueField.map (algebraMap R₀ ↥(S_of B)) (IsLocalRing.residue R₀ r)
        rw [IsLocalRing.ResidueField.map_residue]
        rfl
      let e_alg : E ≃ₐ[IsLocalRing.ResidueField R₀] IsLocalRing.ResidueField ↥(S_of B) :=
        { e_tot with commutes' := he_comm }
      have hFin_res : Module.Finite (IsLocalRing.ResidueField R₀) (IsLocalRing.ResidueField ↥(S_of B)) :=
        Module.Finite.equiv e_alg.toLinearEquiv
      have hSep_res : Algebra.IsSeparable (IsLocalRing.ResidueField R₀) (IsLocalRing.ResidueField ↥(S_of B)) :=
        AlgEquiv.Algebra.isSeparable e_alg
      exact ⟨hFT_B, hm_eq, hFin_res, hSep_res⟩
    have hBot_inD : inD ⊥ := by
      have hFT_bot : Algebra.FiniteType R₀ ↥(⊥ : Subalgebra R₀ V) := by
        have hbot_eq : (⊥ : Subalgebra R₀ V) = Algebra.adjoin R₀ ((∅ : Finset V) : Set V) := by
          rw [Finset.coe_empty, Algebra.adjoin_empty]
        rw [hbot_eq]
        exact hFT_of_finset ∅
      refine hUpgrade ⊥ hFT_bot (IsLocalRing.ResidueField R₀) (quotMap_κ₀ ⊥) (RingHom.ext fun _ => rfl) ?_
      intro q
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨a, ha, s_den, hs, hsm, hzs⟩ := (hS_mem ⊥ z.1).mp z.2
      rw [Algebra.mem_bot] at ha hs
      obtain ⟨ra, rfl⟩ := ha
      obtain ⟨rs, rfl⟩ := hs
      have hrs_not_m₀ : rs ∉ IsLocalRing.maximalIdeal R₀ := by
        rw [← hcomap_mV]; exact hsm
      obtain ⟨us, hus⟩ := IsLocalRing.notMem_maximalIdeal.mp hrs_not_m₀
      have hz_eq : z = algebraMap R₀ ↥(S_of ⊥) (ra * ↑(us⁻¹)) := by
        apply Subtype.ext
        have hs_ne : algebraMap R₀ V rs ≠ 0 := fun h0 =>
          hsm (h0 ▸ (IsLocalRing.maximalIdeal V).zero_mem)
        apply mul_right_cancel₀ hs_ne
        rw [hzs]
        change algebraMap R₀ V ra = algebraMap R₀ V (ra * ↑(us⁻¹)) * algebraMap R₀ V rs
        rw [← map_mul, mul_assoc, ← hus, Units.inv_mul, mul_one]
      refine ⟨IsLocalRing.residue R₀ (ra * ↑(us⁻¹)), ?_⟩
      rw [hz_eq]
      rfl
    have hDVR_of_inD : ∀ {A : Subalgebra R₀ V}, inD A →
        IsDiscreteValuationRing ↥(S_of A) ∧ Irreducible (algebraMap R₀ ↥(S_of A) π₀) := by
      rintro A ⟨hFT, hm_eq, _, _⟩
      have : IsNoetherianRing ↥(S_of A) := hNoethS A hFT
      let π_A : ↥(S_of A) := algebraMap R₀ ↥(S_of A) π₀
      have hπ_A_ne : π_A ≠ 0 := fun h0 => hπ_V_ne (congrArg Subtype.val h0)
      have hπ_A_mem : π_A ∈ IsLocalRing.maximalIdeal ↥(S_of A) :=
        (hmS_mem A π_A).mpr hπ_V_mem
      have hNotField : ¬IsField ↥(S_of A) := by
        intro hF
        obtain ⟨inv_π, hinv⟩ := hF.mul_inv_cancel hπ_A_ne
        exact (IsLocalRing.maximalIdeal.isMaximal ↥(S_of A)).ne_top
          (Ideal.eq_top_of_isUnit_mem _ hπ_A_mem (isUnit_iff_exists_inv.mpr ⟨inv_π, hinv⟩))
      have hPrinc : (IsLocalRing.maximalIdeal ↥(S_of A)).IsPrincipal := ⟨⟨π_A, hm_eq⟩⟩
      have hDVR : IsDiscreteValuationRing ↥(S_of A) :=
        ((IsDiscreteValuationRing.TFAE ↥(S_of A) hNotField).out 5 1).mp hPrinc
      have hIrr_πA : Irreducible π_A := by
        refine ⟨fun hu => (IsLocalRing.maximalIdeal.isMaximal ↥(S_of A)).ne_top
          (Ideal.eq_top_of_isUnit_mem _ hπ_A_mem hu), ?_⟩
        intro a b hab
        by_contra! hboth
        have ha_m : a ∈ IsLocalRing.maximalIdeal ↥(S_of A) :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hboth.1)
        have hb_m : b ∈ IsLocalRing.maximalIdeal ↥(S_of A) :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hboth.2)
        rw [hm_eq, Ideal.mem_span_singleton] at ha_m hb_m
        obtain ⟨ca, rfl⟩ := ha_m
        obtain ⟨cb, rfl⟩ := hb_m
        have h1 : π_A * 1 = π_A * (π_A * (ca * cb)) := by
          calc
            π_A * 1 = π_A := mul_one π_A
            _ = (π_A * ca) * (π_A * cb) := hab
            _ = π_A * (π_A * (ca * cb)) := by ring
        have h2 : π_A * (ca * cb) = 1 := (mul_left_cancel₀ hπ_A_ne h1).symm
