          hGenCard Ω_R Ω₀ (η_R ≫ g_R) η hDense_comp hDense_η 1
  | 2 =>
    rw [h2_s, h2_η]
  | m + 3 =>
    have hSub1 : Subsingleton (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ (m + 3)) :=
      hSub_s (m + 3) (by omega)
    have hSub2 : Subsingleton (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left η) ℓ (m + 3)) :=
      hSub_η (m + 3) (by omega)
    have hCard1 : Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ (m + 3)) = 1 :=
      @Nat.card_unique _ ⟨0⟩ hSub1
    have hCard2 : Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left η) ℓ (m + 3)) = 1 :=
      @Nat.card_unique _ ⟨0⟩ hSub2
    rw [hCard1, hCard2]

theorem weil_etale_p1_constructible_pushforward (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hCurve : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
      AlgebraicGeometry.IsIntegral C.left →
      IsProjectiveOverField k₀ C →
      (ℓ : k₀) ≠ 0 →
      (∀ q : ℕ, Finite (weilEtaleTorsionH C.left ℓ q)) ∧
      (∀ q : ℕ, 3 ≤ q → Subsingleton (weilEtaleTorsionH C.left ℓ q)) ∧
      Nat.card (weilEtaleTorsionH C.left ℓ 0) = ℓ ∧
      Nat.card (weilEtaleTorsionH C.left ℓ 2) = ℓ)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ) :
    WeilP1ConstructiblePushforwardHolds k ℓ :=
by
  let P₁ := weilProjectiveSpaceOver k 1
  have : AlgebraicGeometry.IsProper P₁.hom := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (1 + 1)) k)
        (fun _ => rfl)
    let : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k)
    let φ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
    have hφ_bij : Function.Bijective φ := by
      constructor
      · intro a b hab
        exact MvPolynomial.C_injective (Fin (1 + 1)) k (congrArg Subtype.val hab)
      · intro x
        have hx : x.1 ∈ (1 : Submodule k (MvPolynomial (Fin (1 + 1)) k)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero]
          exact x.2
        rw [Submodule.mem_one] at hx
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, Subtype.ext hr⟩
    have : CategoryTheory.IsIso (CommRingCat.ofHom φ) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom φ)).mpr hφ_bij
    dsimp [P₁, weilProjectiveSpaceOver]
    infer_instance
  obtain ⟨hRedB, hClosure⟩ := weil_etale_p1_baseChange_and_genFLC_exact_closure k ℓ hPBC
  apply hRedB
  intro Z₀ _ _ hIntZ₀ F₀ q hF₀
  let p₁₀ := CategoryTheory.Limits.pullback.fst Z₀.hom P₁.hom
  have : AlgebraicGeometry.IsProper p₁₀ := inferInstance
  have : AlgebraicGeometry.IsAffineHom Z₀.hom := inferInstance
  have : AlgebraicGeometry.IsSeparated Z₀.hom :=
    AlgebraicGeometry.IsSeparated.of_isAffineHom Z₀.hom
  let X₀_over := CategoryTheory.Over.mk (p₁₀ ≫ Z₀.hom)
  have : AlgebraicGeometry.LocallyOfFiniteType X₀_over.hom := by
    dsimp [X₀_over]
    infer_instance
  have : AlgebraicGeometry.QuasiCompact X₀_over.hom := by
    dsimp [X₀_over]
    infer_instance
  have : AlgebraicGeometry.IsSeparated X₀_over.hom := by
    dsimp [X₀_over]
    infer_instance
  obtain ⟨hZero, hRetract, hExact⟩ := hClosure Z₀ hIntZ₀ X₀_over.left p₁₀
  have hFinGen : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (π : Y ⟶ X₀_over.left),
      AlgebraicGeometry.IsIntegral Y →
      AlgebraicGeometry.IsFinite π →
      ∀ q' : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
        (weilEtaleHigherDirectImage p₁₀ q'
          (weilEtaleHigherDirectImage π 0 (weilEtaleTorsionSheaf Y ℓ))) :=
    fun Y π hIntY hFinπ =>
      weil_etale_p1_finite_cover_to_smooth_proj_curve_reduction k ℓ hℓ hPBC
        (weil_etale_smooth_proj_curve_family_genFLC k ℓ hℓ hCurve hPBC)
        Z₀ hIntZ₀ Y π hIntY hFinπ
  exact weil_etale_sylow_trace_constructible_devissage k ℓ hPBC X₀_over
    (fun G₀ => ∀ q' : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
      (weilEtaleHigherDirectImage p₁₀ q' G₀))
    hZero hRetract hExact hFinGen F₀ hF₀ q

theorem weil_etale_constantSheaf_connected_hom_and_torsion_split (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (V : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥V] [PreconnectedSpace ↥V]
        (A₁ A₂ : AddCommGrpCat.{u})
        (ψ : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₁ ⟶
          (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₂),
      ∃ (α : A₁ ⟶ A₂),
        Nonempty (CategoryTheory.Limits.kernel ψ ≅
          (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj
            (CategoryTheory.Limits.kernel α)) ∧
        Nonempty (CategoryTheory.Limits.cokernel ψ ≅
          (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj
            (CategoryTheory.Limits.cokernel α))) ∧
    (∀ (V₀ : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥V₀] (A₁ A₃ : AddCommGrpCat.{u})
        (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf V₀.smallEtaleTopology AddCommGrpCat.{u})),
      SC.ShortExact →
      SC.X₁ = (CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₁ →
      SC.X₃ = (CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₃ →
      Finite A₁ →
      ℓ • CategoryTheory.CategoryStruct.id A₁ = 0 →
      Finite A₃ →
      ℓ • CategoryTheory.CategoryStruct.id A₃ = 0 →
      ℓ • CategoryTheory.CategoryStruct.id SC.X₂ = 0 →
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (v : W ⟶ V₀) (A₂ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale v ∧
        Nonempty ↥W ∧
        Finite A₂ ∧
        ℓ • CategoryTheory.CategoryStruct.id A₂ = 0 ∧
        WeilIsEtaleSheafPullback v SC.X₂
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₂)) :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  
  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  
  have h_mor_etale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    intro S Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
    have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      u.left Y₂.hom Y₂.prop hcomp

  
  have h_s1 : ∀ (V : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥V] [PreconnectedSpace ↥V]
      (A : AddCommGrpCat.{u})
      (hT_V : CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V))),
      CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT_V).unit.app A) := by
    intro V _ _ A hT_V
    let P_A : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun {E₁ E₂} f =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A) f.unop.left.base.hom)
        map_id := fun _ => by
          apply AddCommGrpCat.ext
          intro g
          ext x
          rfl
        map_comp := fun _ _ => by
          apply AddCommGrpCat.ext
          intro h
          ext x
          rfl }
    let θ_A : (CategoryTheory.Functor.const (Opposite V.Etale)).obj A ⟶ P_A :=
      { app := fun E =>
          AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun _ _ _ => by
          apply AddCommGrpCat.ext
          intro a
          ext x
          rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf V.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (h_mem_etale V E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
        fun c w m => (c.π.app (Opposite.op w)).hom m
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m y₁ = eval_c c w₂ m y₂ := by
        intro c w₁ w₂ m y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := h_mor_etale u₂
        let Z_sch := CategoryTheory.Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : V.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget V).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m (p₂.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥A := fun m x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            eval_c c w_x m y_x
          have hg_eq : ∀ (m : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
              g_fn m (w.obj.hom.left.base y) = eval_c c w m y := by
            intro m w y
            let x := w.obj.hom.left.base y
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            exact h_ov c w_x w m y_x y hy_x
          have hg_lc : ∀ m : ↥c.pt, IsLocallyConstant (g_fn m) := by
            intro m
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥A := eval_c c w_x m
            let O : Set ↥Y_x.left := f_x ⁻¹' {a}
            have hO_open : IsOpen O := f_x.isLocallyConstant {a}
            have : AlgebraicGeometry.Etale u_x.left := hEt_x
            have hu_open : IsOpen (u_x.left.base '' O) := u_x.left.isOpenMap O hO_open
            refine ⟨u_x.left.base '' O, ?_, hu_open, ⟨y_x, ?_, hy_x⟩⟩
            · rintro _ ⟨y', hy', rfl⟩
              change g_fn m (w_x.obj.hom.left.base y') = a
              rw [hg_eq m w_x y']
              exact hy'
            · change f_x y_x = a
              have hfx : f_x y_x = g_fn m x := rfl
              rw [hfx]
              exact hx
          AddCommGrpCat.ofHom
            { toFun := fun m => ⟨g_fn m, hg_lc m⟩
              map_zero' := by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have h0 : eval_c c w_x 0 = 0 := map_zero (c.π.app (Opposite.op w_x)).hom
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) h0
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have hadd : eval_c c w_x (m₁ + m₂) = eval_c c w_x m₁ + eval_c c w_x m₂ :=
                  map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) hadd }
        fac := fun c j => by
          apply AddCommGrpCat.ext
          intro m
          change _ = eval_c c j.unop m
          ext y
          let x := j.unop.obj.hom.left.base y
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          exact h_ov c w_x j.unop m y_x y hy_x
        uniq := fun c k hk => by
          apply AddCommGrpCat.ext
          intro m
          let km : LocallyConstant ↥E.left ↥A := k.hom m
          change km = _
          apply LocallyConstant.ext
          intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg
            (fun φ => (φ.hom m : LocallyConstant ↥w_x.obj.left.left ↥A) y_x)
            (hk (Opposite.op w_x))
          change km (u_x.left.base y_x) = eval_c c w_x m y_x at hkx
          rw [hy_x] at hkx
          exact hkx
      }⟩
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective V.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · have hbot : ⊥ ∈ V.smallEtaleTopology E.unop := by
          let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
            @AlgebraicGeometry.Etale
          let E' : P.Over ⊤ V := E.unop
          change (⊥ : CategoryTheory.Sieve E') ∈
            ((CategoryTheory.MorphismProperty.Over.forget P ⊤ V).restrictedTopology
              (AlgebraicGeometry.Scheme.overGrothendieckTopology P V)) E'
          rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
          exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
            (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
              (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
        exact V.smallEtaleTopology.superset_covering bot_le hbot
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun f : LocallyConstant ↥E.unop.left ↥A => f x₀) ha
        subst ha_eq
        have htop : CategoryTheory.Presheaf.equalizerSieve
            (F := (CategoryTheory.Functor.const (Opposite V.Etale)).obj A)
            (X := E) a₁ a₁ = ⊤ := by
          apply CategoryTheory.Sieve.id_mem_iff_eq_top.mp
          rfl
        rw [htop]
        exact V.smallEtaleTopology.top_mem E.unop
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective V.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E f
      refine (h_mem_etale V E (CategoryTheory.Presheaf.imageSieve θ_A f)).mpr ?_
      intro x
      let f_lc : LocallyConstant ↥E.left ↥A := f
      let a : ↥A := f_lc x
      let O_a : E.left.Opens := ⟨f_lc ⁻¹' {a}, f_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_a.ι E.hom inferInstance E.prop
      let Y_a : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ?_, inferInstance, rfl⟩
      refine ⟨a, ?_⟩
      ext y
      exact y.2.symm
    have hW_θ : V.smallEtaleTopology.W θ_A :=
      (V.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
      (V.smallEtaleTopology.W_iff θ_A).mp hW_θ
    let ℒ_A : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}
    let P_const := (CategoryTheory.Functor.const (Opposite V.Etale)).obj A
    let Υ_A : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ ℒ_A :=
      (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_A =
        (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A := by
      dsimp [Υ_A]
      exact CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app ℒ_A) := inferInstance
    have : CategoryTheory.IsIso Υ_A := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V)
    let Γ_V := (CategoryTheory.sheafSections V.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T_V)
    have : CategoryTheory.IsIso (Γ_V.map Υ_A) := inferInstance
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ_A.hom = θ_A := by
      have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    let adj_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT_V
    have h_adjV_comp : adj_V.unit.app A ≫ Γ_V.map Υ_A = θ_A.app (Opposite.op T_V) := by
      have heval := congrArg (fun η => η.app (Opposite.op T_V)) h_unit_Υ
      dsimp [adj_V, CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app]
      have hpresheaf_unit :
          (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_V).unit.app A = 𝟙 A := rfl
      rw [hpresheaf_unit, CategoryTheory.Category.id_comp]
      exact heval
    have h_bij : Function.Bijective ⇑(θ_A.app (Opposite.op T_V)).hom := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        let v₀ : ↥T_V.left := Classical.arbitrary ↥V
        exact congrArg (fun f : LocallyConstant ↥T_V.left ↥A => f v₀) ha
      · intro f
