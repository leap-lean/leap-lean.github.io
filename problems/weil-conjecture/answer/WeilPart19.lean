      exact ⟨fun ⟨z, hz⟩ => hz ▸ congrArg η_R.base (Subsingleton.elim z pt₀),
        fun hy => ⟨pt₀, hy.symm⟩⟩
    have hClos : closure ({η_R.base pt₀} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) =
        Set.univ := by
      rw [← hRange_η]
      exact hDense.closure_eq
    let fst := CategoryTheory.Limits.pullback.fst f_R η_R
    have hConnRange : _root_.IsConnected (Set.range ⇑fst.base) :=
      isConnected_range fst.continuous
    have hDenseRange : closure (Set.range ⇑fst.base) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      have hSpec : η_R.base pt₀ ⤳ f_R.base x := by
        rw [specializes_iff_mem_closure, hClos]
        trivial
      obtain ⟨x_η, hx_spec, hx_eq⟩ := hGen hSpec
      have hx_mem : x_η ∈ Set.range ⇑fst.base := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
        exact ⟨pt₀, hx_eq.symm⟩
      exact closure_mono (Set.singleton_subset_iff.mpr hx_mem)
        (specializes_iff_mem_closure.mp hx_spec)
    rw [connectedSpace_iff_univ, ← hDenseRange]
    exact hConnRange.closure
  have hSepRes : ∀ (F : Type u) [Field F] [IsSepClosed F],
      IsSepClosed (IsLocalRing.ResidueField F) := by
    intro F _ _
    let e : F ≃+* IsLocalRing.ResidueField F :=
      RingEquiv.ofBijective (IsLocalRing.residue F)
        ⟨RingHom.injective (IsLocalRing.residue F), IsLocalRing.residue_surjective⟩
    refine ⟨fun p hp => ?_⟩
    have hp' : (p.map e.symm.toRingHom).Separable := hp.map
    have hsp' : (p.map e.symm.toRingHom).Splits :=
      IsSepClosed.splits_of_separable (p.map e.symm.toRingHom) hp'
    have hmap : (p.map e.symm.toRingHom).map e.toRingHom = p := by
      rw [Polynomial.map_map, RingEquiv.toRingHom_comp_symm_toRingHom, Polynomial.map_id]
    rw [← hmap]
    exact hsp'.map e.toRingHom
  obtain ⟨Ω₀, hFieldΩ₀, hAlgΩ₀, η, hDense_η, hInt_η⟩ := hGenInt
  let _ : Field Ω₀ := hFieldΩ₀
  let _ : IsAlgClosed Ω₀ := hAlgΩ₀
  obtain ⟨hIsoH, hHensCard, hCrit⟩ :=
    weil_etale_pbc_henselian_card_and_genFLC_criterion k ℓ hPBC
  obtain ⟨hConnIff, hSmInt, hFibProj⟩ :=
    weil_smooth_proj_curve_fiber_integral_and_projective k ℓ
  have hFieldCard : ∀ (k₀ k₁ : Type u) [Field k₀] [IsAlgClosed k₀] [Field k₁] [IsAlgClosed k₁]
      (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left)
      (u₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k₀)) (q : ℕ),
      Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left (u₀ ≫ s)) ℓ q) =
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ q) := by
    intro k₀ k₁ _ _ _ _ s u₀ q
    have : HenselianLocalRing k₀ := Field.henselian k₀
    have : IsSepClosed (IsLocalRing.ResidueField k₀) := hSepRes k₀
    exact hHensCard Z₁ C f hProp_f k₀ s k₁ u₀
      (fun pt => Subsingleton.elim (u₀.base pt) (IsLocalRing.closedPoint k₀)) q
  have hGenCard : ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] [IsAlgClosed Ω₂]
      (η₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ Z₁.left)
      (η₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω₂) ⟶ Z₁.left),
      DenseRange η₁.base → DenseRange η₂.base →
      ∀ (q : ℕ),
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left η₁) ℓ q) =
          Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left η₂) ℓ q) := by
    intro Ω₁ Ω₂ _ _ _ _ η₁ η₂ hDense₁ hDense₂ q
    let R₁ : Type u := ↑(Z₁.left.presheaf.obj (Opposite.op ⊤))
    have : IsDomain R₁ := by
      dsimp [R₁]
      infer_instance
    let e_Z : Z₁.left ≅ AlgebraicGeometry.Spec (CommRingCat.of R₁) := Z₁.left.isoSpec
    let K₁ : Type u := FractionRing R₁
    let A : Type u := SeparableClosure K₁
    have : HenselianLocalRing A := Field.henselian A
    have : IsSepClosed (IsLocalRing.ResidueField A) := hSepRes A
    let g_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Z₁.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap K₁ A).comp (algebraMap R₁ K₁))) ≫
        e_Z.inv
    have hFactor : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (η_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z₁.left),
        DenseRange η_Ω.base →
        ∃ (u_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of A)),
          u_Ω ≫ g_A = η_Ω := by
      intro Ω _ _ η_Ω hDense_Ω
      let η'_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R₁) := η_Ω ≫ e_Z.hom
      let φ : R₁ →+* Ω := (AlgebraicGeometry.Spec.preimage η'_Ω).hom
      have hφ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = η'_Ω :=
        AlgebraicGeometry.Spec.map_preimage η'_Ω
      have hDense' : DenseRange η'_Ω.base :=
        (AlgebraicGeometry.Scheme.homeoOfIso e_Z).surjective.denseRange.comp
          hDense_Ω (AlgebraicGeometry.Scheme.homeoOfIso e_Z).continuous
      let pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := (⊥ : PrimeSpectrum Ω)
      have hRange_pt : Set.range ⇑η'_Ω.base = {η'_Ω.base pt} := by
        ext y
        simp only [Set.mem_range, Set.mem_singleton_iff]
        exact ⟨fun ⟨z, hz⟩ => hz ▸ congrArg η'_Ω.base (Subsingleton.elim z pt),
          fun hy => ⟨pt, hy.symm⟩⟩
      have hBotMem : (⊥ : PrimeSpectrum R₁) ∈
          closure ({η'_Ω.base pt} : Set (PrimeSpectrum R₁)) := by
        change (⊥ : PrimeSpectrum R₁) ∈
          closure ({η'_Ω.base pt} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₁)))
        rw [← hRange_pt, hDense'.closure_eq]
        trivial
      erw [PrimeSpectrum.closure_singleton] at hBotMem
      have hIdealBot : (η'_Ω.base pt).asIdeal = ⊥ :=
        le_bot_iff.mp hBotMem
      have hKer : RingHom.ker φ = ⊥ := by
        have hcomap : PrimeSpectrum.comap φ pt = η'_Ω.base pt := by
          rw [← hφ_map]
          rfl
        have hker_eq : (PrimeSpectrum.comap φ pt).asIdeal = RingHom.ker φ := rfl
        rw [← hker_eq, hcomap, hIdealBot]
      have hφ_inj : Function.Injective φ := by
        intro a b hab
        have hmem : a - b ∈ RingHom.ker φ := by
          rw [RingHom.mem_ker, map_sub, hab, sub_self]
        rw [hKer, Ideal.mem_bot] at hmem
        exact sub_eq_zero.mp hmem
      let _ : Algebra R₁ Ω := φ.toAlgebra
      let ψ_K : K₁ →+* Ω := IsFractionRing.lift hφ_inj
      have hψ_comp : ψ_K.comp (algebraMap R₁ K₁) = φ := by
        ext r
        exact IsFractionRing.lift_algebraMap hφ_inj r
      let _ : Algebra K₁ Ω := ψ_K.toAlgebra
      let σ_A : A →ₐ[K₁] Ω := IsSepClosed.lift
      have hσ_comp : σ_A.toRingHom.comp ((algebraMap K₁ A).comp (algebraMap R₁ K₁)) = φ := by
        rw [← RingHom.comp_assoc]
        have h1 : σ_A.toRingHom.comp (algebraMap K₁ A) = ψ_K := σ_A.comp_algebraMap
        rw [h1, hψ_comp]
      have hhom_eq :
          CommRingCat.ofHom ((algebraMap K₁ A).comp (algebraMap R₁ K₁)) ≫
            CommRingCat.ofHom σ_A.toRingHom =
          CommRingCat.ofHom φ :=
        (CommRingCat.ofHom_comp _ _).symm.trans (congrArg CommRingCat.ofHom hσ_comp)
      refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_A.toRingHom), ?_⟩
      dsimp only [g_A]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        hhom_eq, hφ_map]
      dsimp only [η'_Ω]
      rw [CategoryTheory.Category.assoc, e_Z.hom_inv_id, CategoryTheory.Category.comp_id]
    obtain ⟨u₁, hu₁⟩ := hFactor Ω₁ η₁ hDense₁
    obtain ⟨u₂, hu₂⟩ := hFactor Ω₂ η₂ hDense₂
    rw [← hu₁, ← hu₂,
      hHensCard Z₁ C f hProp_f A g_A Ω₁ u₁
        (fun pt => Subsingleton.elim (u₁.base pt) (IsLocalRing.closedPoint A)) q,
      hHensCard Z₁ C f hProp_f A g_A Ω₂ u₂
        (fun pt => Subsingleton.elim (u₂.base pt) (IsLocalRing.closedPoint A)) q]
  have hCard0_η : Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left η) ℓ 0) = ℓ := by
    have hIrr : IrreducibleSpace ↥(CategoryTheory.Limits.pullback f.left η) :=
      ((AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced _).mp hInt_η).1
    exact (hConnIff (CategoryTheory.Limits.pullback f.left η)).mp
      (@IrreducibleSpace.connectedSpace _ _ hIrr)
  have hCurveAt : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left),
      AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f.left s) ∧
      (∀ q : ℕ, Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ q)) ∧
      (∀ q : ℕ, 3 ≤ q →
        Subsingleton (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ q)) ∧
      Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ 0) = ℓ ∧
      Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ 2) = ℓ := by
    intro k₀ _ _ s
    have hCard0_s :
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left s) ℓ 0) = ℓ := by
      rcases weil_geom_point_generic_or_strictly_henselian_dvr k Z₁ hIntZ₁ k₀ s with
        hDense_s | ⟨R, hCR, hDomR, hAlgR, hDVR, hHensR, hSepR, g_R,
          Ω_R, hFieldΩR, hAlgΩR, η_R, k₁, hFieldk₁, hAlgk₁, u₀, u_R,
          hDense_ηR, hDense_comp, hu_R, hComm_u⟩
      · rw [hGenCard k₀ Ω₀ s η hDense_s hDense_η 0, hCard0_η]
      · let _ : CommRing R := hCR
        let _ : IsDomain R := hDomR
        let _ : Algebra k R := hAlgR
        let _ : IsDiscreteValuationRing R := hDVR
        let _ : HenselianLocalRing R := hHensR
        let _ : IsSepClosed (IsLocalRing.ResidueField R) := hSepR
        let _ : Field Ω_R := hFieldΩR
        let _ : IsAlgClosed Ω_R := hAlgΩR
        let _ : Field k₁ := hFieldk₁
        let _ : IsAlgClosed k₁ := hAlgk₁
        let f_R := CategoryTheory.Limits.pullback.snd f.left g_R
        have : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_R := hSmPull g_R
        let e_pb : CategoryTheory.Limits.pullback f_R η_R ≅
            CategoryTheory.Limits.pullback f.left (η_R ≫ g_R) :=
          ((CategoryTheory.IsPullback.of_hasPullback f_R η_R).paste_horiz
            (CategoryTheory.IsPullback.of_hasPullback f.left g_R)).isoPullback
        obtain ⟨e_add0⟩ := hIsoH e_pb 0
        have hCard0_genR :
            Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_R η_R) ℓ 0) = ℓ := by
          rw [Nat.card_congr e_add0.toEquiv,
            hGenCard Ω_R Ω₀ (η_R ≫ g_R) η hDense_comp hDense_η 0, hCard0_η]
        have hConn_genR : ConnectedSpace ↥(CategoryTheory.Limits.pullback f_R η_R) :=
          (hConnIff (CategoryTheory.Limits.pullback f_R η_R)).mpr hCard0_genR
        have hConn_R : ConnectedSpace ↥(CategoryTheory.Limits.pullback f.left g_R) :=
          hFlatConn R (CategoryTheory.Limits.pullback f.left g_R) f_R Ω_R η_R hDense_ηR hConn_genR
        have hCard0_R :
            Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left g_R) ℓ 0) = ℓ :=
          (hConnIff (CategoryTheory.Limits.pullback f.left g_R)).mp hConn_R
        rw [← hFieldCard k₀ k₁ s u₀ 0, hComm_u,
          hHensCard Z₁ C f hProp_f R g_R k₁ u_R hu_R 0, hCard0_R]
    let C_s := CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f.left s)
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_s.hom := hSmPull s
    have : AlgebraicGeometry.IsProper C_s.hom := by
      dsimp [C_s]
      infer_instance
    have hConn_Cs : ConnectedSpace ↥C_s.left :=
      (hConnIff (CategoryTheory.Limits.pullback f.left s)).mpr hCard0_s
    have hInt_Cs : AlgebraicGeometry.IsIntegral C_s.left := hSmInt k₀ C_s hConn_Cs
    have hProj_Cs : IsProjectiveOverField k₀ C_s := hFibProj Z₁ C f hProj k₀ s
    have hℓ₀ : (ℓ : k₀) ≠ 0 := by
      let σ₀ : k →+* k₀ := (AlgebraicGeometry.Spec.preimage (s ≫ Z₁.hom)).hom
      intro h0
      apply hℓ
      apply σ₀.injective
      rw [map_natCast, map_zero]
      exact h0
    exact ⟨hInt_Cs, hCurve k₀ C_s hInt_Cs hProj_Cs hℓ₀⟩
  intro q
  apply hCrit Z₁ C hIntZ₁ f hProp_f Ω₀ η hDense_η q
  intro k₀ _ _ s
  obtain ⟨_, hFin_s, hSub_s, h0_s, h2_s⟩ := hCurveAt k₀ s
  obtain ⟨_, _, hSub_η, h0_η, h2_η⟩ := hCurveAt Ω₀ η
  refine ⟨hFin_s q, ?_⟩
  match q with
  | 0 =>
    rw [h0_s, h0_η]
  | 1 =>
    rcases weil_geom_point_generic_or_strictly_henselian_dvr k Z₁ hIntZ₁ k₀ s with
      hDense_s | ⟨R, hCR, hDomR, hAlgR, hDVR, hHensR, hSepR, g_R,
        Ω_R, hFieldΩR, hAlgΩR, η_R, k₁, hFieldk₁, hAlgk₁, u₀, u_R,
        hDense_ηR, hDense_comp, hu_R, hComm_u⟩
    · exact le_of_eq (hGenCard k₀ Ω₀ s η hDense_s hDense_η 1)
    · let _ : CommRing R := hCR
      let _ : IsDomain R := hDomR
      let _ : Algebra k R := hAlgR
      let _ : IsDiscreteValuationRing R := hDVR
      let _ : HenselianLocalRing R := hHensR
      let _ : IsSepClosed (IsLocalRing.ResidueField R) := hSepR
      let _ : Field Ω_R := hFieldΩR
      let _ : IsAlgClosed Ω_R := hAlgΩR
      let _ : Field k₁ := hFieldk₁
      let _ : IsAlgClosed k₁ := hAlgk₁
      let f_R := CategoryTheory.Limits.pullback.snd f.left g_R
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_R := hSmPull g_R
      have : AlgebraicGeometry.IsProper f_R := by
        dsimp [f_R]
        infer_instance
      let e_pb : CategoryTheory.Limits.pullback f_R η_R ≅
          CategoryTheory.Limits.pullback f.left (η_R ≫ g_R) :=
        ((CategoryTheory.IsPullback.of_hasPullback f_R η_R).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback f.left g_R)).isoPullback
      obtain ⟨hInt_comp, hFin_comp, _, _, _⟩ := hCurveAt Ω_R (η_R ≫ g_R)
      have hInt_genR : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f_R η_R) := by
        have : AlgebraicGeometry.IsIntegral
            (CategoryTheory.Limits.pullback f.left (η_R ≫ g_R)) := hInt_comp
        have hIrr_comp : IrreducibleSpace
            ↥(CategoryTheory.Limits.pullback f.left (η_R ≫ g_R)) :=
          ((AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced _).mp hInt_comp).1
        let ⟨y⟩ := hIrr_comp.toNonempty
        have hne : Nonempty ↥(CategoryTheory.Limits.pullback f_R η_R) := ⟨e_pb.inv.base y⟩
        exact @AlgebraicGeometry.isIntegral_of_isOpenImmersion _ _ e_pb.hom _ _ hne
      obtain ⟨e_add1⟩ := hIsoH e_pb 1
      have hFin_genR : Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_R η_R) ℓ 1) := by
        have : Finite (weilEtaleTorsionH
            (CategoryTheory.Limits.pullback f.left (η_R ≫ g_R)) ℓ 1) := hFin_comp 1
        exact Finite.of_equiv _ e_add1.symm.toEquiv
      have hLe := weil_smooth_proper_curve_dvr_h1_cospecialization_card_le
        k ℓ hℓ R (CategoryTheory.Limits.pullback f.left g_R) f_R Ω_R η_R
        hDense_ηR hInt_genR hFin_genR
      rw [← hFieldCard k₀ k₁ s u₀ 1, hComm_u,
        hHensCard Z₁ C f hProp_f R g_R k₁ u_R hu_R 1]
      calc
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f.left g_R) ℓ 1)
          ≤ Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_R η_R) ℓ 1) := hLe
        _ = Nat.card (weilEtaleTorsionH
            (CategoryTheory.Limits.pullback f.left (η_R ≫ g_R)) ℓ 1) :=
          Nat.card_congr e_add1.toEquiv
