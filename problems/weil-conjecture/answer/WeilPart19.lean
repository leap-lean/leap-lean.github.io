    have _ : AlgebraicGeometry.QuasiCompact fP_α := hQC_fPα
    obtain ⟨h_α, hh_α_ne, h_α_spread⟩ :=
      hConj1 (O_α : AlgebraicGeometry.Scheme.{u}) P_α (O_αK : AlgebraicGeometry.Scheme.{u}) P_αK
