      have hh_rel_ne : h_rel ≠ 0 := Finset.prod_ne_zero_iff.mpr fun α _ => hm_α_ne α
      refine ⟨c, hc_ne, y, h_rel, hh_rel_ne, hy_spec, ?_⟩
      intro S _ _ hc_S hrel_S
      let TS := TensorProduct R₀ S A₂_dst
      let ιS : A₂_dst →ₐ[R₀] TS := Algebra.TensorProduct.includeRight
      let uS_base : S := ↑(hc_S.unit⁻¹)
      let uS : TS := uS_base ⊗ₜ[R₀] 1
      have hcuS : algebraMap R₀ TS c * uS = 1 := by
        change (algebraMap R₀ S c ⊗ₜ[R₀] (1 : A₂_dst)) * (uS_base ⊗ₜ[R₀] 1) = 1
        rw [Algebra.TensorProduct.tmul_mul_tmul, hc_S.mul_val_inv, mul_one]
        rfl
