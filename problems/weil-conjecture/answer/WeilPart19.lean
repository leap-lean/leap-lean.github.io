      have hdeg_ne : (Polynomial.X ^ (q ^ e) - Polynomial.C a : Polynomial k).degree ≠ 0 := by
        rw [Polynomial.degree_X_pow_sub_C hqe_pos a]
        intro h0
        exact Nat.pos_iff_ne_zero.mp hqe_pos (WithBot.coe_eq_coe.mp h0)
