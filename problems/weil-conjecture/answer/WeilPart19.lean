          exact ⟨(S_fn W₂).map δ_psh,
            by change (S_fn W₂).map ((T_pre h n).map SC.f) ≫
                 (S_fn W₂).map ((T_pre h n).map SC.g) = 0
               rw [← (S_fn W₂).map_comp, hfg₀, (S_fn W₂).map_zero],
            by change (S_fn W₂).map ((T_pre h n).map SC.g) ≫ (S_fn W₂).map δ_psh = 0
               rw [← (S_fn W₂).map_comp, hgδ₀, (S_fn W₂).map_zero],
            by change (S_fn W₂).map δ_psh ≫ (S_fn W₂).map ((T_pre h (n + 1)).map SC.f) = 0
               rw [← (S_fn W₂).map_comp, hδf₀, (S_fn W₂).map_zero],
            hex1.map (S_fn W₂), hex2.map (S_fn W₂), hex3.map (S_fn W₂)⟩
        refine ⟨hInjVan, ?_, ?_⟩
        · intro SC hSE
          obtain ⟨δ, hfg, hgδ, hδf, hex1, hex2, hex3⟩ := hLES SC 0 hSE
          have hd := hSheafDiagram ((T₀' h).map SC.f) ((T₀' h).map SC.g) δ ((T_sh' h 1).map SC.f)
            hfg hgδ hδf hex1 hex2 hex3
          exact ⟨fun hMono hZ1 => ⟨hfg, hd.1 hMono hZ1⟩, hd.2.1⟩
        · intro SC b hSE hZ1 hZ2
          obtain ⟨δ, hfg, hgδ, hδf, hex1, hex2, hex3⟩ := hLES SC (b + 1) hSE
          exact (hSheafDiagram ((T_sh' h (b + 1)).map SC.f) ((T_sh' h (b + 1)).map SC.g) δ
            ((T_sh' h (b + 1 + 1)).map SC.f) hfg hgδ hδf hex1 hex2 hex3).2.2 hZ1 hZ2
      intro X₁ X₂ X₃ p f G hAcycG q
      have _ := hCont p
      have _ := hCont f
      have _ := hCont (p ≫ f)
      let pf_p := (weilCompEtaleSitePullback p).sheafPushforwardContinuous
        AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology
      let pf_f := (weilCompEtaleSitePullback f).sheafPushforwardContinuous
        AddCommGrpCat.{u} X₃.smallEtaleTopology X₂.smallEtaleTopology
      let pf_pf := (weilCompEtaleSitePullback (p ≫ f)).sheafPushforwardContinuous
        AddCommGrpCat.{u} X₃.smallEtaleTopology X₁.smallEtaleTopology
      have _ : CategoryTheory.Limits.PreservesFiniteLimits pf_p := (hPushProps p).2.1
      have hInj_p := (hPushProps p).2.2
      obtain ⟨e_comp⟩ := hPushComp p f
      obtain ⟨e_p0⟩ := hT0'_natIso p
      obtain ⟨e_f0⟩ := hT0'_natIso f
      obtain ⟨e_pf0⟩ := hT0'_natIso (p ≫ f)
      let θ₀ : (T₀' p).comp (T₀' f) ≅ T₀' (p ≫ f) :=
        CategoryTheory.Functor.isoWhiskerRight e_p0 (T₀' f) ≪≫
          CategoryTheory.Functor.isoWhiskerLeft pf_p e_f0 ≪≫
          e_comp.symm ≪≫
          e_pf0.symm
      have hMainT : ∀ (M : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
          (∀ b : ℕ, CategoryTheory.Limits.IsZero ((T_sh' p (b + 1)).obj M)) →
          Nonempty ((T_sh' f q).obj ((T₀' p).obj M) ≅ (T_sh' (p ≫ f) q).obj M) := by
        rcases q with _ | m
        · intro M _
          exact ⟨θ₀.app M⟩
        · induction m with
          | zero =>
            intro M hAcycM
            let I := CategoryTheory.Injective.under M
            let ι := CategoryTheory.Injective.ι M
            let Q := CategoryTheory.Limits.cokernel ι
            let π := CategoryTheory.Limits.cokernel.π ι
            let SC := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
            have hSE : SC.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
            have hInj_TpI : CategoryTheory.Injective ((T₀' p).obj I) :=
              CategoryTheory.Injective.of_iso (e_p0.app I).symm (hInj_p I inferInstance)
            have _ : CategoryTheory.Mono (pf_p.map ι) := inferInstance
            have hMono_Tpι : CategoryTheory.Mono ((T₀' p).map ι) := by
              have hnat : (T₀' p).map ι = e_p0.hom.app M ≫ pf_p.map ι ≫ e_p0.inv.app I := by
                rw [← CategoryTheory.Category.assoc, ← e_p0.hom.naturality ι,
                  CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_app,
                  CategoryTheory.Category.comp_id]
              rw [hnat]
              exact mono_comp _ _
            obtain ⟨h0_p, hSE_p⟩ := ((hShift p).2.1 SC hSE).1 hMono_Tpι (hAcycM 0)
            let SC_p := CategoryTheory.ShortComplex.mk ((T₀' p).map ι) ((T₀' p).map π) h0_p
            have hZ_fI : CategoryTheory.Limits.IsZero ((T_sh' f 1).obj SC_p.X₂) :=
              (hShift f).1 ((T₀' p).obj I) hInj_TpI 0
            obtain ⟨e_cok1⟩ := ((hShift f).2.1 SC_p hSE_p).2 hZ_fI
            have hZ_pfI : CategoryTheory.Limits.IsZero ((T_sh' (p ≫ f) 1).obj SC.X₂) :=
              (hShift (p ≫ f)).1 I inferInstance 0
            obtain ⟨e_cok2⟩ := ((hShift (p ≫ f)).2.1 SC hSE).2 hZ_pfI
            have _ := hHasCo X₃
            let e_mid : CategoryTheory.Limits.cokernel ((T₀' f).map ((T₀' p).map π)) ≅
                CategoryTheory.Limits.cokernel ((T₀' (p ≫ f)).map π) :=
              CategoryTheory.Limits.cokernel.mapIso ((T₀' f).map ((T₀' p).map π))
                ((T₀' (p ≫ f)).map π) (θ₀.app I) (θ₀.app Q) (θ₀.hom.naturality π)
            exact ⟨e_cok1.symm ≪≫ e_mid ≪≫ e_cok2⟩
          | succ m ih =>
            intro M hAcycM
            let I := CategoryTheory.Injective.under M
            let ι := CategoryTheory.Injective.ι M
            let Q := CategoryTheory.Limits.cokernel ι
            let π := CategoryTheory.Limits.cokernel.π ι
            let SC := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
            have hSE : SC.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
            have hInj_TpI : CategoryTheory.Injective ((T₀' p).obj I) :=
              CategoryTheory.Injective.of_iso (e_p0.app I).symm (hInj_p I inferInstance)
            have _ : CategoryTheory.Mono (pf_p.map ι) := inferInstance
            have hMono_Tpι : CategoryTheory.Mono ((T₀' p).map ι) := by
              have hnat : (T₀' p).map ι = e_p0.hom.app M ≫ pf_p.map ι ≫ e_p0.inv.app I := by
                rw [← CategoryTheory.Category.assoc, ← e_p0.hom.naturality ι,
                  CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_app,
                  CategoryTheory.Category.comp_id]
              rw [hnat]
              exact mono_comp _ _
            obtain ⟨h0_p, hSE_p⟩ := ((hShift p).2.1 SC hSE).1 hMono_Tpι (hAcycM 0)
            let SC_p := CategoryTheory.ShortComplex.mk ((T₀' p).map ι) ((T₀' p).map π) h0_p
            have hAcycQ : ∀ b : ℕ, CategoryTheory.Limits.IsZero ((T_sh' p (b + 1)).obj Q) := by
              intro b
              obtain ⟨e_pQ⟩ := (hShift p).2.2 SC b hSE
                ((hShift p).1 I inferInstance b) ((hShift p).1 I inferInstance (b + 1))
              exact e_pQ.isZero_iff.mpr (hAcycM (b + 1))
            obtain ⟨e_shift1⟩ := (hShift f).2.2 SC_p m hSE_p
              ((hShift f).1 ((T₀' p).obj I) hInj_TpI m)
              ((hShift f).1 ((T₀' p).obj I) hInj_TpI (m + 1))
            obtain ⟨e_shift2⟩ := (hShift (p ≫ f)).2.2 SC m hSE
              ((hShift (p ≫ f)).1 I inferInstance m) ((hShift (p ≫ f)).1 I inferInstance (m + 1))
            obtain ⟨e_ih⟩ := ih Q hAcycQ
            exact ⟨e_shift1.symm ≪≫ e_ih ≪≫ e_shift2⟩
      obtain ⟨e_main⟩ := hMainT G (fun b => (hBridge p (b + 1) G).isZero_iff.mpr (hAcycG b))
      exact ⟨(hBridge f q _).symm ≪≫
        (T_sh' f q).mapIso (hBridge p 0 G).symm ≪≫
        e_main ≪≫
        hBridge (p ≫ f) q G⟩
    intro X₁ X₂ X₃ p f G hAcycG q
    exact hCore S_of (@hT0_natIso) p f G hAcycG q

theorem weil_etale_closed_immersion_pushforward_constructible_and_acyclic (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hSerre : WeilConstructibleModPrimeSerreHolds k ℓ)
    (hTors : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage h q F) = 0)
    (hZeroTest : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        ∃ (G₀ : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback w G G₀ ∧ CategoryTheory.Limits.IsZero G₀) →
      CategoryTheory.Limits.IsZero G)
    (hIdVanish : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (H : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) (b : ℕ),
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id W) (b + 1) H))
    (hEmptyVanish : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} [IsEmpty ↥W₁] (h : W₁ ⟶ W₂)
      (H : CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h q H))
    (Y X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.IsSeparated X.hom]
    (i : Y ⟶ X)
    (hi : AlgebraicGeometry.IsClosedImmersion i.left)
    (F_Y : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u})
    (hF_Y : WeilIsConstructibleModPrimeSheaf ℓ Y.left F_Y) :
    WeilIsConstructibleModPrimeSheaf ℓ X.left (weilEtaleHigherDirectImage i.left 0 F_Y) ∧
    (∀ b : ℕ, CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage i.left (b + 1) F_Y)) :=
by
  have _ : AlgebraicGeometry.IsClosedImmersion i.left := hi
  have _ : AlgebraicGeometry.IsSeparated Y.hom := by
    rw [← CategoryTheory.Over.w i]
    infer_instance
  have hPullIso : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ F₂' : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ F₁' : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₂ F₁ →
      Nonempty (F₂ ≅ F₂') →
      Nonempty (F₁ ≅ F₁') →
      WeilIsEtaleSheafPullback h F₂' F₁' := by
    intro X₁ X₂ h F₂ F₂' F₁ F₁' ⟨hCont, hAdj, ⟨e⟩⟩ ⟨e₂⟩ ⟨e₁⟩
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have := hCont
    have := hAdj
    exact ⟨hCont, hAdj,
      ⟨((B.sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology).mapIso e₂.symm).trans (e.trans e₁)⟩⟩
  have hIdZeroIso : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (M : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id W) 0 M ≅ M) := by
    intro W M
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.HasPullbacksAlong (CategoryTheory.CategoryStruct.id W) :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : P_et.IsStableUnderBaseChangeAlong (CategoryTheory.CategoryStruct.id W) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_id : CategoryTheory.Functor W.Etale W.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ (CategoryTheory.CategoryStruct.id W)
    let e_B : B_id ≅ CategoryTheory.Functor.id W.Etale :=
      CategoryTheory.NatIso.ofComponents
        (fun E => by
          have h_id_comm : CategoryTheory.CategoryStruct.id E.left ≫ E.hom =
              E.hom ≫ CategoryTheory.CategoryStruct.id W :=
            (CategoryTheory.Category.id_comp E.hom).trans (CategoryTheory.Category.comp_id E.hom).symm
          let iso_left :
              CategoryTheory.Limits.pullback E.hom (CategoryTheory.CategoryStruct.id W) ≅ E.left :=
            { hom := CategoryTheory.Limits.pullback.fst E.hom (CategoryTheory.CategoryStruct.id W)
              inv := CategoryTheory.Limits.pullback.lift
                (CategoryTheory.CategoryStruct.id E.left) E.hom h_id_comm
              hom_inv_id := by
                apply CategoryTheory.Limits.pullback.hom_ext
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                    CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                    CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
                    CategoryTheory.Category.id_comp]
              inv_hom_id := CategoryTheory.Limits.pullback.lift_fst _ _ _ }
          refine CategoryTheory.MorphismProperty.Over.isoMk iso_left ?_
          change CategoryTheory.Limits.pullback.fst E.hom (CategoryTheory.CategoryStruct.id W) ≫ E.hom =
            CategoryTheory.Limits.pullback.snd E.hom (CategoryTheory.CategoryStruct.id W)
          rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id])
        (fun {E₁ E₂} u => by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _)
    let J := W.smallEtaleTopology
    have e_counit : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj M.obj ≅ M :=
      CategoryTheory.asIso ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).counit.app M)
    let adj_tot :=
      (AddCommGrpCat.adj.whiskerRight W.Etaleᵒᵖ).comp
        (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u})
    let F_adj :=
      ((CategoryTheory.Functor.whiskeringRight W.Etaleᵒᵖ (Type u) AddCommGrpCat.{u}).obj
        AddCommGrpCat.free).comp (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u})
    let G_adj :=
      (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).comp
        ((CategoryTheory.Functor.whiskeringRight W.Etaleᵒᵖ AddCommGrpCat.{u} (Type u)).obj
          (CategoryTheory.forget AddCommGrpCat.{u}))
    have hadj : F_adj ⊣ G_adj := adj_tot
    let evEquiv : ∀ V : W.Etale, (F_adj.obj (CategoryTheory.yoneda.obj V) ⟶ M) ≃
        ↥(M.obj.obj (Opposite.op V)) :=
      fun V => (hadj.homEquiv (CategoryTheory.yoneda.obj V) M).trans CategoryTheory.yonedaEquiv
    have hev_apply : ∀ (V : W.Etale) (φ : F_adj.obj (CategoryTheory.yoneda.obj V) ⟶ M),
        evEquiv V φ =
          φ.hom.app (Opposite.op V)
            (((hadj.unit.app (CategoryTheory.yoneda.obj V)).app (Opposite.op V)) (𝟙 V)) := by
      intro V φ
      dsimp [evEquiv, CategoryTheory.yonedaEquiv]
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    let compAddEquiv : ∀ U : W.Etaleᵒᵖ,
        CategoryTheory.Abelian.Ext (F_adj.obj (CategoryTheory.yoneda.obj U.unop)) M 0 ≃+
          ↥(M.obj.obj U) :=
      fun U =>
        { toEquiv := CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans (evEquiv U.unop)
          map_add' := fun x y => by
            dsimp
            rw [CategoryTheory.Abelian.Ext.addEquiv₀.map_add, hev_apply, hev_apply, hev_apply]
            rfl }
    have e_coh : CategoryTheory.Sheaf.cohomologyPresheaf M 0 ≅ M.obj := by
      refine CategoryTheory.NatIso.ofComponents
        (fun U => AddEquiv.toAddCommGrpIso (compAddEquiv U))
        (fun {U₁ U₂} u => by
          apply AddCommGrpCat.ext
          intro (x : CategoryTheory.Abelian.Ext (F_adj.obj (CategoryTheory.yoneda.obj U₁.unop)) M 0)
          change evEquiv U₂.unop (CategoryTheory.Abelian.Ext.addEquiv₀
              ((CategoryTheory.Abelian.Ext.mk₀ (F_adj.map (CategoryTheory.yoneda.map u.unop))).comp
                x (Nat.zero_add 0))) =
            (G_adj.obj M).map u (evEquiv U₁.unop (CategoryTheory.Abelian.Ext.addEquiv₀ x))
          have hx : CategoryTheory.Abelian.Ext.addEquiv₀
              ((CategoryTheory.Abelian.Ext.mk₀ (F_adj.map (CategoryTheory.yoneda.map u.unop))).comp
                x (Nat.zero_add 0)) =
              F_adj.map (CategoryTheory.yoneda.map u.unop) ≫
                CategoryTheory.Abelian.Ext.addEquiv₀ x := by
            let g := F_adj.map (CategoryTheory.yoneda.map u.unop) ≫
              CategoryTheory.Abelian.Ext.homEquiv₀ x
            change CategoryTheory.Abelian.Ext.homEquiv₀ _ = g
            conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x]
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
            have hg := CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply
              (CategoryTheory.Abelian.Ext.homEquiv₀.symm g)
            rw [Equiv.apply_symm_apply] at hg
            rw [hg, Equiv.apply_symm_apply]
          rw [hx]
          dsimp [evEquiv]
          rw [CategoryTheory.Adjunction.homEquiv_naturality_left]
          let ψ := (hadj.homEquiv (CategoryTheory.yoneda.obj U₁.unop) M)
            (CategoryTheory.Abelian.Ext.addEquiv₀ x)
          change CategoryTheory.yonedaEquiv (CategoryTheory.yoneda.map u.unop ≫ ψ) =
            (G_adj.obj M).map u (CategoryTheory.yonedaEquiv ψ)
          exact (CategoryTheory.yonedaEquiv_naturality ψ u.unop).symm)
    exact ⟨((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).mapIso
      ((CategoryTheory.Functor.isoWhiskerLeft B_id.op e_coh).trans
        ((CategoryTheory.Functor.isoWhiskerRight (CategoryTheory.NatIso.op e_B.symm) M.obj).trans
          (CategoryTheory.Functor.leftUnitor M.obj)))).trans e_counit⟩
  have hClosedLiftAndDisj :
      (∀ {Z₀ : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsReduced Z₀]
        (g : Z₀ ⟶ X.left) [AlgebraicGeometry.QuasiCompact g],
        Set.range g.base ⊆ Set.range i.left.base →
        ∃ (g_lift : Z₀ ⟶ Y.left),
          g_lift ≫ i.left = g ∧
          CategoryTheory.IsPullback g_lift (CategoryTheory.CategoryStruct.id Z₀) i.left g ∧
          (AlgebraicGeometry.IsClosedImmersion g → AlgebraicGeometry.IsClosedImmersion g_lift)) ∧
      (∀ {W : AlgebraicGeometry.Scheme.{u}} (u : W ⟶ X.left),
        Disjoint (Set.range u.base) (Set.range i.left.base) →
        IsEmpty ↥(CategoryTheory.Limits.pullback i.left u)) := by
    refine ⟨?_, ?_⟩
    · intro Z₀ _ g _ hSub
      have h_rad_g : g.ker.radical ≤ g.ker := by
        rw [AlgebraicGeometry.Scheme.IdealSheafData.le_def]
        intro U s hs
        rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal] at hs
        rcases hs with ⟨n, hn⟩
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at hn ⊢
        rw [RingHom.mem_ker] at hn ⊢
        rw [map_pow] at hn
        exact eq_zero_of_pow_eq_zero hn
      have hSuppSub : (g.ker.support : Set ↥X.left) ⊆ (i.left.ker.support : Set ↥X.left) := by
        rw [AlgebraicGeometry.Scheme.Hom.support_ker, AlgebraicGeometry.Scheme.Hom.support_ker]
        exact closure_mono hSub
      have h_van : AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal i.left.ker.support ≤
          AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal g.ker.support :=
        (@AlgebraicGeometry.Scheme.IdealSheafData.gc X.left).monotone_u
          (OrderDual.toDual_le_toDual.mpr (SetLike.coe_subset_coe.mp hSuppSub))
      have h_ker_le : i.left.ker ≤ g.ker := by
        calc
          i.left.ker ≤ i.left.ker.radical :=
            AlgebraicGeometry.Scheme.IdealSheafData.le_radical i.left.ker
          _ = AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal i.left.ker.support :=
            AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support.symm
          _ ≤ AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal g.ker.support := h_van
          _ = g.ker.radical := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support
          _ ≤ g.ker := h_rad_g
      let g_lift : Z₀ ⟶ Y.left := AlgebraicGeometry.IsClosedImmersion.lift i.left g h_ker_le
      have h_fac : g_lift ≫ i.left = g :=
