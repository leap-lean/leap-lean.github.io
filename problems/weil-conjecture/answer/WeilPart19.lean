theorem weil_scheme_zmod_torsor_clopen_splitting_and_no_frame_idempotent (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X Y : AlgebraicGeometry.Scheme.{u}) (h : Y ⟶ X)
    (T : AlgebraicGeometry.Scheme.{u}) (τ : T ⟶ X)
    (ρ : ZMod ℓ → (T ⟶ T)) (hρ_over : ∀ γ : ZMod ℓ, ρ γ ≫ τ = τ)
    (hFin : AlgebraicGeometry.IsFinite τ)
    (hEt : AlgebraicGeometry.Etale τ)
    (hSurj : AlgebraicGeometry.Surjective τ)
    (hρ0 : ρ 0 = 𝟙 T)
    (hρ_add : ∀ γ₁ γ₂ : ZMod ℓ, ρ (γ₁ + γ₂) = ρ γ₁ ≫ ρ γ₂)
    (hShearDisj : ∀ γ₁ γ₂ : ZMod ℓ, γ₁ ≠ γ₂ →
      Disjoint
        (Set.range (CategoryTheory.Limits.pullback.lift (𝟙 T) (ρ γ₁) (hρ_over γ₁).symm).base)
        (Set.range (CategoryTheory.Limits.pullback.lift (𝟙 T) (ρ γ₂) (hρ_over γ₂).symm).base))
    (hShearCov : (⋃ γ : ZMod ℓ,
      Set.range (CategoryTheory.Limits.pullback.lift (𝟙 T) (ρ γ) (hρ_over γ).symm).base) =
      Set.univ) :
    ((∃ e₀ : ↑(T.presheaf.obj (Opposite.op ⊤)),
        e₀ * e₀ = e₀ ∧
        (∑ γ : ZMod ℓ, (ρ γ).appTop.hom e₀) = 1 ∧
        (∀ γ : ZMod ℓ, γ ≠ 0 → e₀ * (ρ γ).appTop.hom e₀ = 0)) →
      ∃ σ : X ⟶ T, σ ≫ τ = 𝟙 X) ∧
    (∀ (u_Y : LocallyConstant ↥(CategoryTheory.Limits.pullback τ h) (ZMod ℓ)),
      (∀ (γ : ZMod ℓ) (z : ↥(CategoryTheory.Limits.pullback τ h)),
        u_Y ((CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst τ h ≫ ρ γ)
          (CategoryTheory.Limits.pullback.snd τ h)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.fst τ h ≫ ·) (hρ_over γ)).trans
              CategoryTheory.Limits.pullback.condition))).base z) = u_Y z + γ) →
      ∃ (e_triv : ↑((CategoryTheory.Limits.pullback τ h).presheaf.obj (Opposite.op ⊤)) ≃+*
          (ZMod ℓ → ↑(Y.presheaf.obj (Opposite.op ⊤)))),
        (∀ (a : ↑(Y.presheaf.obj (Opposite.op ⊤))) (δ : ZMod ℓ),
          e_triv ((CategoryTheory.Limits.pullback.snd τ h).appTop.hom a) δ = a) ∧
        (∀ (γ : ZMod ℓ)
           (x : ↑((CategoryTheory.Limits.pullback τ h).presheaf.obj (Opposite.op ⊤)))
           (δ : ZMod ℓ),
          e_triv ((CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst τ h ≫ ρ γ)
            (CategoryTheory.Limits.pullback.snd τ h)
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (CategoryTheory.Limits.pullback.fst τ h ≫ ·) (hρ_over γ)).trans
                CategoryTheory.Limits.pullback.condition))).appTop.hom x) δ =
          e_triv x (δ + γ))) :=
by
  classical
  let _ := hShearDisj
  have hZeroFiberIsIso : ∀ (S W : AlgebraicGeometry.Scheme.{u}) (π : W ⟶ S),
      AlgebraicGeometry.IsFinite π →
      AlgebraicGeometry.Etale π →
      AlgebraicGeometry.Surjective π →
      ∀ (α : ZMod ℓ → (W ⟶ W)) (hα_over : ∀ γ : ZMod ℓ, α γ ≫ π = π),
        α 0 = 𝟙 W →
        (∀ γ₁ γ₂ : ZMod ℓ, α (γ₁ + γ₂) = α γ₁ ≫ α γ₂) →
        (⋃ γ : ZMod ℓ,
          Set.range (CategoryTheory.Limits.pullback.lift (𝟙 W) (α γ) (hα_over γ).symm).base) =
          Set.univ →
        ∀ (u : LocallyConstant ↥W (ZMod ℓ)),
          (∀ (γ : ZMod ℓ) (z : ↥W), u ((α γ).base z) = u z + γ) →
          CategoryTheory.IsIso
            (AlgebraicGeometry.Scheme.Opens.ι
              (⟨u ⁻¹' {0}, u.isLocallyConstant.isOpen_fiber 0⟩ : W.Opens) ≫ π) := by
    intro S W π hFinπ hEtπ hSurjπ α hα_over hα0 _hα_add hCov u hu
    have : AlgebraicGeometry.IsFinite π := hFinπ
    have : AlgebraicGeometry.Etale π := hEtπ
    have : AlgebraicGeometry.Surjective π := hSurjπ
    let U₀ : W.Opens := ⟨u ⁻¹' {0}, u.isLocallyConstant.isOpen_fiber 0⟩
    let g₀ : U₀.toScheme ⟶ S := U₀.ι ≫ π
    have hCl : IsClosed (U₀ : Set ↥W) := by
      rw [← isOpen_compl_iff]
      exact u.isLocallyConstant ({0}ᶜ)
    have hClEmb : Topology.IsClosedEmbedding (⇑U₀.ι) := hCl.isClosedEmbedding_subtypeVal
    have : AlgebraicGeometry.QuasiCompact U₀.ι :=
