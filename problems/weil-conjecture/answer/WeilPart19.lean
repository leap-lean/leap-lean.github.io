      let _ : Fact (Irreducible G_bar) := ⟨hGbar_irr⟩
      have : Module.Finite (IsLocalRing.ResidueField ↥(S_of A)) (AdjoinRoot G_bar) :=
        (AdjoinRoot.powerBasis hGbar_irr.ne_zero).finite
      have : Module.Finite (IsLocalRing.ResidueField R₀) (AdjoinRoot G_bar) :=
        Module.Finite.trans (IsLocalRing.ResidueField ↥(S_of A)) (AdjoinRoot G_bar)
      let rt : AdjoinRoot G_bar := AdjoinRoot.root G_bar
      have hmin_rt : minpoly (IsLocalRing.ResidueField ↥(S_of A)) rt = G_bar := by
        rw [AdjoinRoot.minpoly_root hGbar_irr.ne_zero, hGbar_monic.leadingCoeff,
          inv_one, Polynomial.C_1, mul_one]
      have hSep_rt : IsSeparable (IsLocalRing.ResidueField ↥(S_of A)) rt := by
        change (minpoly (IsLocalRing.ResidueField ↥(S_of A)) rt).Separable
        rw [hmin_rt]; exact hGbar_sep
      have hadj_top : IntermediateField.adjoin (IsLocalRing.ResidueField ↥(S_of A))
          ({rt} : Set (AdjoinRoot G_bar)) = ⊤ := by
        rw [eq_top_iff]
        intro z _
        obtain ⟨pol, rfl⟩ := AdjoinRoot.mk_surjective z
        refine Polynomial.induction_on' pol
          (fun p₁ p₂ hp₁ hp₂ => by rw [map_add]; exact Subfield.add_mem _ hp₁ hp₂)
          (fun n c => ?_)
        have hmon : AdjoinRoot.mk G_bar (Polynomial.monomial n c) =
            algebraMap (IsLocalRing.ResidueField ↥(S_of A)) (AdjoinRoot G_bar) c * rt ^ n := by
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
          rfl
        rw [hmon]
        exact IntermediateField.mul_mem _
          (IntermediateField.algebraMap_mem _ c)
          ((IntermediateField.adjoin _ _).toSubalgebra.pow_mem
            (IntermediateField.subset_adjoin _ ({rt} : Set (AdjoinRoot G_bar)) rfl) n)
      have : Algebra.IsSeparable (IsLocalRing.ResidueField ↥(S_of A))
          ↥(IntermediateField.adjoin (IsLocalRing.ResidueField ↥(S_of A))
            ({rt} : Set (AdjoinRoot G_bar))) :=
        (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable
          (IsLocalRing.ResidueField ↥(S_of A)) (AdjoinRoot G_bar)).mpr hSep_rt
      have : Algebra.IsSeparable (IsLocalRing.ResidueField ↥(S_of A)) (AdjoinRoot G_bar) :=
        AlgEquiv.Algebra.isSeparable
          ((IntermediateField.equivOfEq hadj_top).trans IntermediateField.topEquiv)
      have : Algebra.IsSeparable (IsLocalRing.ResidueField R₀) (AdjoinRoot G_bar) :=
        Algebra.IsSeparable.trans (IsLocalRing.ResidueField R₀)
          (IsLocalRing.ResidueField ↥(S_of A)) (AdjoinRoot G_bar)
      let π_A' : ↥(S_of A') := algebraMap R₀ ↥(S_of A') π₀
      let I_A' : Ideal ↥(S_of A') := Ideal.span {π_A'}
      let q' : ↥(S_of A') →+* (↥(S_of A') ⧸ I_A') := Ideal.Quotient.mk I_A'
      let θ₀ : IsLocalRing.ResidueField ↥(S_of A) →+* (↥(S_of A') ⧸ I_A') :=
        Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥(S_of A))
          (q'.comp incl_AA') (fun z hz => by
            rw [hA_inD.2.1, Ideal.mem_span_singleton] at hz
            obtain ⟨c, rfl⟩ := hz
            simp only [RingHom.comp_apply, map_mul]
            have hπ : incl_AA' (algebraMap R₀ ↥(S_of A) π₀) = π_A' := Subtype.ext rfl
            rw [hπ, show q' π_A' = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl), zero_mul])
      have heval_θ₀ : Polynomial.eval₂ θ₀ (q' y') G_bar = 0 := by
        dsimp [G_bar]
        rw [Polynomial.eval₂_map]
        have hcomp : θ₀.comp (IsLocalRing.residue ↥(S_of A)) = q'.comp incl_AA' := rfl
        rw [hcomp, ← Polynomial.hom_eval₂, ← Polynomial.eval_map, hG1_eval_y', map_zero]
      let θ : AdjoinRoot G_bar →+* (↥(S_of A') ⧸ I_A') := AdjoinRoot.lift θ₀ (q' y') heval_θ₀
      have hθ_comm : θ.comp (algebraMap (IsLocalRing.ResidueField R₀) (AdjoinRoot G_bar)) =
          quotMap_κ₀ A' := by
        ext c
        obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective (R := R₀) c
        change θ (AdjoinRoot.of G_bar
          (IsLocalRing.ResidueField.map (algebraMap R₀ ↥(S_of A)) (IsLocalRing.residue R₀ r))) =
          quotMap_κ₀ A' (IsLocalRing.residue R₀ r)
        rw [AdjoinRoot.lift_of, IsLocalRing.ResidueField.map_residue]
        exact congrArg q' (Subtype.ext rfl)
      have hA'_in_range : ∀ (b : V) (hb : b ∈ A'), q' ⟨b, hA_le_S A' hb⟩ ∈ θ.range := by
        have haux : ∀ b ∈ A', ∀ z : ↥(S_of A'), z.1 = b → q' z ∈ θ.range := by
          intro b hb
          refine Algebra.adjoin_induction
            (fun w hw z hz => by
              rcases hw with hwA | rfl
              · have hzw : z = ⟨w, hA_le_S A' (hA_le_A' hwA)⟩ := Subtype.ext hz
                rw [hzw]
                refine ⟨AdjoinRoot.of G_bar (IsLocalRing.residue ↥(S_of A) ⟨w, hA_le_S A hwA⟩), ?_⟩
                change θ (AdjoinRoot.of G_bar _) = _
                rw [AdjoinRoot.lift_of]
                exact congrArg q' (Subtype.ext rfl)
              · have hzy : z = y' := Subtype.ext hz
                rw [hzy]
                exact ⟨rt, AdjoinRoot.lift_root heval_θ₀⟩)
            (fun r z hz => by
              have hzr : z = algebraMap R₀ ↥(S_of A') r := Subtype.ext hz
              rw [hzr]
              refine ⟨AdjoinRoot.of G_bar (IsLocalRing.residue ↥(S_of A) (algebraMap R₀ ↥(S_of A) r)), ?_⟩
              change θ (AdjoinRoot.of G_bar _) = _
              rw [AdjoinRoot.lift_of]
              exact congrArg q' (Subtype.ext rfl))
            (fun u v hu hv ihu ihv z hz => by
              have hzu : z = ⟨u, hA_le_S A' hu⟩ + ⟨v, hA_le_S A' hv⟩ := Subtype.ext hz
              rw [hzu, map_add]
              exact θ.range.add_mem (ihu _ rfl) (ihv _ rfl))
            (fun u v hu hv ihu ihv z hz => by
              have hzu : z = ⟨u, hA_le_S A' hu⟩ * ⟨v, hA_le_S A' hv⟩ := Subtype.ext hz
              rw [hzu, map_mul]
              exact θ.range.mul_mem (ihu _ rfl) (ihv _ rfl)) hb
        intro b hb
        exact haux b hb _ rfl
      have hθ_surj : Function.Surjective θ := by
        intro q_elem
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective q_elem
        obtain ⟨b, hb, s_den, hs, hsm, hzs⟩ := (hS_mem A' z.1).mp z.2
        let b' : ↥(S_of A') := ⟨b, hA_le_S A' hb⟩
        let s' : ↥(S_of A') := ⟨s_den, hA_le_S A' hs⟩
        have hzs' : z * s' = b' := Subtype.ext hzs
        obtain ⟨cb, hcb⟩ := hA'_in_range b hb
        obtain ⟨cs, hcs⟩ := hA'_in_range s_den hs
        have hπ_A'_mem : π_A' ∈ IsLocalRing.maximalIdeal ↥(S_of A') :=
          (hmS_mem A' π_A').mpr hπ_V_mem
        have : Nontrivial (↥(S_of A') ⧸ I_A') :=
          Ideal.Quotient.nontrivial_iff.mpr
            (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top
              (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_A'_mem)))
        have hus' : IsUnit (q' s') := ((hS_unit_iff A' s').mpr hsm).map q'
        have hcs_ne : cs ≠ 0 := fun h0 => hus'.ne_zero (by rw [← hcs, h0, map_zero])
        refine ⟨cb * cs⁻¹, ?_⟩
        apply hus'.mul_left_inj.mp
        calc
          θ (cb * cs⁻¹) * q' s' = θ cb * (θ cs⁻¹ * θ cs) := by
            rw [map_mul, hcs, mul_assoc]
          _ = θ cb * θ (cs⁻¹ * cs) := by rw [← map_mul]
          _ = q' b' := by rw [inv_mul_cancel₀ hcs_ne, map_one, mul_one, hcb]
          _ = q' z * q' s' := by rw [← map_mul, hzs']
      have hA'_inD : inD A' :=
        hUpgrade A' hFT_A' (AdjoinRoot G_bar) θ hθ_comm hθ_surj
      let i' : ι := ⟨A', hA'_inD⟩
      let y_R : R := incl_R i' y'
      refine ⟨IsLocalRing.residue R y_R, ?_⟩
      rw [← hPR_map, Polynomial.eval_map_apply]
      have hinc_comp : (incl_R i').comp incl_AA' = incl_R i := by
        ext z
        apply hval_R_inj
        simp only [RingHom.comp_apply]
        rw [hincl_val, hincl_val]
        rfl
      have hPR_eq : P_R = (G.map incl_AA').map (incl_R i') := by
        rw [← hG_map, Polynomial.map_map, hinc_comp]
      have hyR_eval : P_R.eval y_R = 0 := by
        rw [hPR_eq, Polynomial.eval_map_apply, hG1_eval_y', map_zero]
      rw [hyR_eval, map_zero]
    exact ⟨R, hCR_R, hDom_R, hDVR_R, hHens_R, hSep_R, j, hj_inj, hj_comap⟩
  have hDom : ∀ (R₁ : Type u) [CommRing R₁] [IsDomain R₁] [Algebra k R₁] [Algebra.FiniteType k R₁]
      (p₀ : Ideal R₁) [p₀.IsPrime], p₀ ≠ ⊥ →
      ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : Algebra k R)
        (_ : IsDiscreteValuationRing R) (_ : HenselianLocalRing R)
        (_ : IsSepClosed (IsLocalRing.ResidueField R))
        (φ : R₁ →+* R),
        Function.Injective φ ∧
        Ideal.comap φ (IsLocalRing.maximalIdeal R) = p₀ := by
    intro R₁ _ _ _ _ p₀ _ hp₀
    obtain ⟨R₀, hCR₀, hDom₀, hAlg₀, hDVR₀, φ₀, hφ₀_inj, hφ₀_comap⟩ := hStage2 R₁ p₀ hp₀
    let _ := hCR₀
    let _ := hDom₀
    let _ := hAlg₀
    let _ := hDVR₀
    obtain ⟨R, hCR, hDomR, hDVR, hHens, hSep, j, hj_inj, hj_comap⟩ := hStage3 R₀
    let _ := hCR
    let _ := hDomR
    let _ := hDVR
    let alg_k_R : Algebra k R := (j.comp (algebraMap k R₀)).toAlgebra
    let φ : R₁ →+* R := j.comp φ₀.toRingHom
    have hφ_inj : Function.Injective φ := hj_inj.comp hφ₀_inj
    have hφ_comap : Ideal.comap φ (IsLocalRing.maximalIdeal R) = p₀ := by
      change Ideal.comap φ₀.toRingHom (Ideal.comap j (IsLocalRing.maximalIdeal R)) = p₀
      rw [hj_comap, hφ₀_comap]
    exact ⟨R, hCR, hDomR, alg_k_R, hDVR, hHens, hSep, φ, hφ_inj, hφ_comap⟩
  have hDense_of_ker_bot : ∀ {A Ω : Type u} [CommRing A] [Field Ω]
      (θ : A →+* Ω), RingHom.ker θ = ⊥ →
      DenseRange (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ)).base := by
    intro A Ω _ _ θ hker
    rw [denseRange_iff_closure_range]
    apply Set.eq_univ_of_forall
    intro y
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := (⊥ : PrimeSpectrum Ω)
    let x₀ : PrimeSpectrum A := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ)).base pt₀
    have hx₀_mem : x₀ ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ)).base :=
      ⟨pt₀, rfl⟩
    have hx₀_ideal : x₀.asIdeal = ⊥ := by
      change Ideal.comap θ ⊥ = ⊥
      rwa [← RingHom.ker_eq_comap_bot]
    have hy_mem : y ∈ closure ({x₀} : Set (PrimeSpectrum A)) := by
      rw [PrimeSpectrum.closure_singleton, hx₀_ideal]
      intro z hz
      rw [Set.mem_singleton_iff.mp hz]
      exact y.asIdeal.zero_mem
    exact closure_mono (Set.singleton_subset_iff.mpr hx₀_mem) hy_mem
  let R₁ : Type u := ↑(Z₁.left.presheaf.obj (Opposite.op ⊤))
  have : IsDomain R₁ := by
    dsimp [R₁]
    infer_instance
  let e_Z : Z₁.left ≅ AlgebraicGeometry.Spec (CommRingCat.of R₁) := Z₁.left.isoSpec
  let α_k : CommRingCat.of k ⟶ CommRingCat.of R₁ :=
    AlgebraicGeometry.Spec.preimage (e_Z.inv ≫ Z₁.hom)
  have hα_k_map : AlgebraicGeometry.Spec.map α_k = e_Z.inv ≫ Z₁.hom :=
    AlgebraicGeometry.Spec.map_preimage (e_Z.inv ≫ Z₁.hom)
  have hLFT_spec : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map α_k) := by
    rw [hα_k_map]
    infer_instance
  have hFT_hom : RingHom.FiniteType α_k.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
      hLFT_spec
  let _ : Algebra k R₁ := α_k.hom.toAlgebra
  have : Algebra.FiniteType k R₁ := hFT_hom
  let s' : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R₁) := s ≫ e_Z.hom
  let ψ_s : R₁ →+* k₀ := (AlgebraicGeometry.Spec.preimage s').hom
  have hψ_s_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) = s' :=
    AlgebraicGeometry.Spec.map_preimage s'
  have hs_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫ e_Z.inv = s := by
    rw [hψ_s_map]
    dsimp [s']
    rw [CategoryTheory.Category.assoc, e_Z.hom_inv_id, CategoryTheory.Category.comp_id]
  let p₀ : Ideal R₁ := RingHom.ker ψ_s
  have hp₀_prime : p₀.IsPrime := RingHom.ker_isPrime ψ_s
  by_cases hp₀ : p₀ = ⊥
  · left
    have hDense_s' : DenseRange (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s)).base :=
      hDense_of_ker_bot ψ_s hp₀
    rw [← hs_eq]
    exact (AlgebraicGeometry.Scheme.homeoOfIso e_Z.symm).surjective.denseRange.comp
      hDense_s' (AlgebraicGeometry.Scheme.homeoOfIso e_Z.symm).continuous
  · right
    obtain ⟨R, hCR, hDomR, hAlgR, hDVR, hHensR, hSepR, φ, hφ_inj, hφ_comap⟩ :=
      hDom R₁ p₀ hp₀
    let _ : CommRing R := hCR
    let _ : IsDomain R := hDomR
    let _ : Algebra k R := hAlgR
    let _ : IsDiscreteValuationRing R := hDVR
    let _ : HenselianLocalRing R := hHensR
    let _ : IsSepClosed (IsLocalRing.ResidueField R) := hSepR
    let g_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Z₁.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ e_Z.inv
    let K_R : Type u := FractionRing R
    let Ω_R : Type u := AlgebraicClosure K_R
    let σ_Ω : R →+* Ω_R := (algebraMap K_R Ω_R).comp (algebraMap R K_R)
    have hσ_inj : Function.Injective σ_Ω :=
      (RingHom.injective (algebraMap K_R Ω_R)).comp (IsFractionRing.injective R K_R)
    have hker_σ : RingHom.ker σ_Ω = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      rw [Ideal.mem_bot]
      exact hσ_inj ((RingHom.mem_ker.mp hx).trans (map_zero σ_Ω).symm)
    let η_R : AlgebraicGeometry.Spec (CommRingCat.of Ω_R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_Ω)
    have hDense_η : DenseRange η_R.base := hDense_of_ker_bot σ_Ω hker_σ
    have hker_σφ : RingHom.ker (σ_Ω.comp φ) = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      rw [Ideal.mem_bot]
      exact (hσ_inj.comp hφ_inj)
        ((RingHom.mem_ker.mp hx).trans (map_zero (σ_Ω.comp φ)).symm)
    have hη_comp_eq : η_R ≫ g_R =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_Ω.comp φ)) ≫ e_Z.inv := by
      dsimp [η_R, g_R]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    have hDense_comp : DenseRange (η_R ≫ g_R).base := by
      rw [hη_comp_eq]
      exact (AlgebraicGeometry.Scheme.homeoOfIso e_Z.symm).surjective.denseRange.comp
        (hDense_of_ker_bot (σ_Ω.comp φ) hker_σφ)
        (AlgebraicGeometry.Scheme.homeoOfIso e_Z.symm).continuous
    let Q₀ : Type u := R₁ ⧸ p₀
    let _ : IsDomain Q₀ := Ideal.Quotient.isDomain p₀
    let κ_R : Type u := IsLocalRing.ResidueField R
    let ρ_R : R₁ →+* κ_R := (IsLocalRing.residue R).comp φ
    have hker_res : RingHom.ker (IsLocalRing.residue R) = IsLocalRing.maximalIdeal R :=
      IsLocalRing.ker_residue
    have hker_ρ : RingHom.ker ρ_R = p₀ := by
      rw [← hφ_comap]
      ext r
      simp only [ρ_R, RingHom.mem_ker, RingHom.comp_apply, Ideal.mem_comap, ← hker_res]
    let α_Q₀_k₀ : Q₀ →+* k₀ := RingHom.kerLift ψ_s
    have hα_k₀_inj : Function.Injective α_Q₀_k₀ := RingHom.kerLift_injective ψ_s
    let α_Q₀_κ : Q₀ →+* κ_R :=
      Ideal.Quotient.lift p₀ ρ_R (fun a ha => by rw [← hker_ρ] at ha; exact ha)
    have hα_κ_inj : Function.Injective α_Q₀_κ := by
      intro x y hxy
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [Ideal.Quotient.eq]
      change a - b ∈ p₀
      rw [← hker_ρ, RingHom.mem_ker, map_sub, sub_eq_zero]
      exact hxy
    let _ : Algebra Q₀ k₀ := α_Q₀_k₀.toAlgebra
    let _ : Algebra Q₀ κ_R := α_Q₀_κ.toAlgebra
    have : Nontrivial (TensorProduct Q₀ k₀ κ_R) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain Q₀ k₀ κ_R
        hα_k₀_inj hα_κ_inj
    obtain ⟨m_star, hm_star⟩ := Ideal.exists_maximal (TensorProduct Q₀ k₀ κ_R)
    have : m_star.IsMaximal := hm_star
    let F_star : Type u := TensorProduct Q₀ k₀ κ_R ⧸ m_star
    let _ : Field F_star := Ideal.Quotient.field m_star
    let k₁ : Type u := AlgebraicClosure F_star
    let π_star : TensorProduct Q₀ k₀ κ_R →+* k₁ :=
      (algebraMap F_star k₁).comp (Ideal.Quotient.mk m_star)
    let β₀ : k₀ →+* k₁ := π_star.comp Algebra.TensorProduct.includeLeftRingHom
    let β_κ : κ_R →+* k₁ := π_star.comp Algebra.TensorProduct.includeRight.toRingHom
    let τ_R : R →+* k₁ := β_κ.comp (IsLocalRing.residue R)
    let u₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀)
    let u_R : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R)
    have hu_R : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)),
        u_R.base pt = IsLocalRing.closedPoint R := by
      intro pt
      apply PrimeSpectrum.ext
      have hpt_bot : pt.asIdeal = ⊥ := by
        rcases Ideal.eq_bot_or_top pt.asIdeal with hbot | htop
        · exact hbot
        · exact False.elim (pt.isPrime.ne_top htop)
      change Ideal.comap τ_R pt.asIdeal = IsLocalRing.maximalIdeal R
      rw [hpt_bot, ← RingHom.ker_eq_comap_bot]
      ext r
      simp only [τ_R, RingHom.mem_ker, RingHom.comp_apply,
        map_eq_zero_iff β_κ (RingHom.injective β_κ)]
      rw [← RingHom.mem_ker, hker_res]
    have hComm_ring : β₀.comp ψ_s = τ_R.comp φ := by
      ext r
      let q : Q₀ := Ideal.Quotient.mk p₀ r
      have h1 : ψ_s r = algebraMap Q₀ k₀ q := rfl
      have h2 : IsLocalRing.residue R (φ r) = algebraMap Q₀ κ_R q := rfl
      change π_star (Algebra.TensorProduct.includeLeftRingHom (ψ_s r)) =
        π_star (Algebra.TensorProduct.includeRight (IsLocalRing.residue R (φ r)))
      rw [h1, h2]
      congr 1
      change algebraMap Q₀ k₀ q ⊗ₜ[Q₀] (1 : κ_R) = (1 : k₀) ⊗ₜ[Q₀] algebraMap Q₀ κ_R q
      rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
    have hComm_spec : u₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) =
        u_R ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) := by
      dsimp [u₀, u_R]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hComm_ring]
    have hComm : u₀ ≫ s = u_R ≫ g_R := by
      rw [← hs_eq, ← CategoryTheory.Category.assoc, hComm_spec, CategoryTheory.Category.assoc]
    exact ⟨R, hCR, hDomR, hAlgR, hDVR, hHensR, hSepR, g_R,
      Ω_R, inferInstance, inferInstance, η_R,
      k₁, inferInstance, inferInstance, u₀, u_R,
      hDense_η, hDense_comp, hu_R, hComm⟩

theorem weil_etale_sitePullback_exact_and_locallyConstant (X Y : AlgebraicGeometry.Scheme.{u}) (h : Y ⟶ X) :
    (∀ (W : AlgebraicGeometry.Scheme.{u}) {T_W : W.Etale}
        (hT_W : CategoryTheory.Limits.IsTerminal T_W) (A : AddCommGrpCat.{u}),
      let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
      let adj_W := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT_W
      ∃ (θ_W : ∀ E : W.Etale,
          ↥((C_W.obj A).obj.obj (Opposite.op E)) ≃+ LocallyConstant ↥E.left ↥A),
        (∀ {E' E : W.Etale} (u : E' ⟶ E) (s : ↥((C_W.obj A).obj.obj (Opposite.op E)))
            (z : ↥E'.left),
          θ_W E' (((C_W.obj A).obj.map u.op).hom s) z = θ_W E s (u.left.base z)) ∧
        (∀ (a : ↥A) (z : ↥T_W.left),
          θ_W T_W ((adj_W.unit.app A).hom a) z = a)) ∧
    (∃ (hCont : (weilEtaleSitePullback h).IsContinuous X.smallEtaleTopology Y.smallEtaleTopology),
      letI := hCont
      let P_push := (weilEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} X.smallEtaleTopology Y.smallEtaleTopology
      ∃ (hAdj : P_push.IsRightAdjoint),
        letI := hAdj
        let P_pull := (weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} X.smallEtaleTopology Y.smallEtaleTopology
        P_pull.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits P_pull ∧
        CategoryTheory.Limits.PreservesFiniteColimits P_pull ∧
        ∀ {T_Y : Y.Etale} (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
          {T_X : X.Etale} (hT_X : CategoryTheory.Limits.IsTerminal T_X)
          (A : AddCommGrpCat.{u}),
          CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT_Y hT_X A)) :=
by
  have hEtMor : ∀ {W : AlgebraicGeometry.Scheme.{u}} {V E : W.Etale} (g : V ⟶ E),
      AlgebraicGeometry.Etale g.left := by
    intro W V E g
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale) g.left E.hom E.prop
      ((CategoryTheory.MorphismProperty.Over.w g).symm ▸ V.prop)
  have hMemSmallEtale : ∀ {W : AlgebraicGeometry.Scheme.{u}} {E : W.Etale}
      (S : CategoryTheory.Sieve E),
      S ∈ W.smallEtaleTopology E ↔ ∀ (x : ↥E.left),
        ∃ (V : W.Etale) (f : V ⟶ E) (y : ↥V.left),
          S.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro W E S
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme := @AlgebraicGeometry.Etale
    haveI : P_et.IsStableUnderComposition :=
      ⟨fun _ _ hf hg => by
        haveI : AlgebraicGeometry.Etale _ := hf
        haveI : AlgebraicGeometry.Etale _ := hg
        infer_instance⟩
    have hJ : W.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      @AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        P_et P_et W _ inferInstance inferInstance inferInstance inferInstance (le_refl P_et)
    exact (Eq.to_iff
      (congrArg (fun T : CategoryTheory.GrothendieckTopology W.Etale => S ∈ T E) hJ)).trans
      (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        P_et P_et W _ inferInstance inferInstance inferInstance inferInstance E S)
  constructor
  · intro W T_W hT_W A
    let J := W.smallEtaleTopology
    let C_W := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let adj_W := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_W
    let ℱ_A := C_W.obj A
    have hOpenMor : ∀ {V E : W.Etale} (g : V ⟶ E), IsOpenMap ⇑g.left.base := by
      intro V E g
      haveI : AlgebraicGeometry.Etale g.left := hEtMor g
      haveI : AlgebraicGeometry.UniversallyOpen g.left :=
        AlgebraicGeometry.UniversallyOpen.of_flat g.left
      exact AlgebraicGeometry.Scheme.Hom.isOpenMap g.left
    let L_pre : CategoryTheory.Functor (W.Etale)ᵒᵖ AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun {E₁ E₂} u =>
          AddCommGrpCat.ofHom
            { toFun := fun g =>
                { toFun := fun z => g (u.unop.left.base z)
                  isLocallyConstant := fun s =>
                    u.unop.left.continuous.isOpen_preimage _ (g.isLocallyConstant s) }
              map_zero' := LocallyConstant.ext (fun _ => rfl)
              map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
        map_id := fun _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
        map_comp := fun _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }
    have hL_sheaf : CategoryTheory.Presheaf.IsSheaf J L_pre := by
      apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J L_pre
        (CategoryTheory.forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
      intro E S hS fam hfam
      have hCov := (hMemSmallEtale S).mp hS
      let famL : ∀ {V : W.Etale} (g : V ⟶ E), S.arrows g → LocallyConstant ↥V.left ↥A :=
        fun g hg => fam g hg
      have hAgree : ∀ {V₁ V₂ : W.Etale} (g₁ : V₁ ⟶ E) (g₂ : V₂ ⟶ E)
          (hg₁ : S.arrows g₁) (hg₂ : S.arrows g₂) (v₁ : ↥V₁.left) (v₂ : ↥V₂.left),
          g₁.left.base v₁ = g₂.left.base v₂ →
          famL g₁ hg₁ v₁ = famL g₂ hg₂ v₂ := by
        intro V₁ V₂ g₁ g₂ hg₁ hg₂ v₁ v₂ hv
        let E_sch : AlgebraicGeometry.Scheme.{u} := E.left
        let V₁_sch : AlgebraicGeometry.Scheme.{u} := V₁.left
        let V₂_sch : AlgebraicGeometry.Scheme.{u} := V₂.left
        let g₁_l : V₁_sch ⟶ E_sch := g₁.left
        let g₂_l : V₂_sch ⟶ E_sch := g₂.left
        haveI : AlgebraicGeometry.Etale V₁.hom := V₁.prop
        haveI : AlgebraicGeometry.Etale g₁_l := hEtMor g₁
        haveI : AlgebraicGeometry.Etale g₂_l := hEtMor g₂
        let fst : CategoryTheory.Limits.pullback g₁_l g₂_l ⟶ V₁_sch :=
          CategoryTheory.Limits.pullback.fst g₁_l g₂_l
        let snd : CategoryTheory.Limits.pullback g₁_l g₂_l ⟶ V₂_sch :=
          CategoryTheory.Limits.pullback.snd g₁_l g₂_l
        haveI : AlgebraicGeometry.Etale (fst ≫ V₁.hom) := inferInstance
        let W₁₂ : W.Etale := AlgebraicGeometry.Scheme.Etale.mk (fst ≫ V₁.hom)
        let π₁ : W₁₂ ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk fst rfl
        have hg₁_w : g₁_l ≫ E.hom = V₁.hom := CategoryTheory.MorphismProperty.Over.w g₁
        have hg₂_w : g₂_l ≫ E.hom = V₂.hom := CategoryTheory.MorphismProperty.Over.w g₂
        have hπ₂_w : snd ≫ V₂.hom = W₁₂.hom := by
          change snd ≫ V₂.hom = fst ≫ V₁.hom
          rw [← hg₂_w, ← CategoryTheory.Category.assoc,
            ← CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc, hg₁_w]
        let π₂ : W₁₂ ⟶ V₂ := CategoryTheory.MorphismProperty.Over.homMk snd hπ₂_w
        have hπ_comm : π₁ ≫ g₁ = π₂ ≫ g₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        obtain ⟨w, hw₁, hw₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := g₁_l) (g := g₂_l) v₁ v₂ hv
        have hcomp_eq := hfam π₁ π₂ hg₁ hg₂ hπ_comm
        have heval := congrArg (fun k : LocallyConstant ↥W₁₂.left ↥A => k w) hcomp_eq
        change famL g₁ hg₁ (fst.base w) = famL g₂ hg₂ (snd.base w) at heval
        rwa [hw₁, hw₂] at heval
      let f₀ : ↥E.left → ↥A := fun x =>
        let f := (hCov x).choose_spec.choose
        let y := (hCov x).choose_spec.choose_spec.choose
        let hf := (hCov x).choose_spec.choose_spec.choose_spec.1
        famL f hf y
      have hf₀_apply : ∀ {V : W.Etale} (g : V ⟶ E) (hg : S.arrows g) (v : ↥V.left),
          f₀ (g.left.base v) = famL g hg v := by
        intro V g hg v
        let x := g.left.base v
        exact hAgree _ g (hCov x).choose_spec.choose_spec.choose_spec.1 hg _ v
          (hCov x).choose_spec.choose_spec.choose_spec.2.2
      have hf₀_lc : IsLocallyConstant f₀ := by
        intro s
        have hpre : f₀ ⁻¹' s =
            ⋃ (V : W.Etale) (g : V ⟶ E) (hg : S.arrows g),
              ⇑g.left.base '' ((famL g hg) ⁻¹' s) := by
          ext x
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
          constructor
          · intro hx
            obtain ⟨V, g, v, hg, _, hv⟩ := hCov x
            refine ⟨V, g, hg, v, ?_, hv⟩
            rw [← hf₀_apply g hg v, hv]
            exact hx
          · rintro ⟨V, g, hg, v, hv_mem, rfl⟩
            rw [hf₀_apply g hg v]
            exact hv_mem
        rw [hpre]
        refine isOpen_iUnion fun V => isOpen_iUnion fun g => isOpen_iUnion fun hg => ?_
        exact hOpenMor g _ ((famL g hg).isLocallyConstant s)
      let t₀ : LocallyConstant ↥E.left ↥A := ⟨f₀, hf₀_lc⟩
      refine ⟨t₀, ?_, ?_⟩
      · intro V g hg
        exact LocallyConstant.ext (fun v => hf₀_apply g hg v)
      · intro t' ht'
        let t'L : LocallyConstant ↥E.left ↥A := t'
        change t'L = t₀
        apply LocallyConstant.ext
        intro x
        obtain ⟨V, g, v, hg, _, hv⟩ := hCov x
        have h_eq := congrArg (fun k : LocallyConstant ↥V.left ↥A => k v) (ht' g hg)
        change t'L (g.left.base v) = famL g hg v at h_eq
        rw [← hv, h_eq]
        exact (hf₀_apply g hg v).symm
    let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨L_pre, hL_sheaf⟩
    let ι_A : A ⟶ L_sh.obj.obj (Opposite.op T_W) :=
      AddCommGrpCat.ofHom
        { toFun := fun a => LocallyConstant.const ↥T_W.left a
          map_zero' := LocallyConstant.ext (fun _ => rfl)
          map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
    let η_A : A ⟶ ℱ_A.obj.obj (Opposite.op T_W) := adj_W.unit.app A
    let Φ : ℱ_A ⟶ L_sh := (adj_W.homEquiv A L_sh).symm ι_A
    have hΦ_unit : η_A ≫ Φ.hom.app (Opposite.op T_W) = ι_A := by
      have h1 : (adj_W.homEquiv A L_sh) Φ = ι_A := (adj_W.homEquiv A L_sh).apply_symm_apply ι_A
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    have hℱ_sheaf : CategoryTheory.Presieve.IsSheaf J
        (ℱ_A.obj.comp (CategoryTheory.forget AddCommGrpCat.{u})) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J _).mp
        (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf ℱ_A.obj ℱ_A.2)
    have hℱ_arrows : ∀ {E : W.Etale} {I : Type u} (X_cov : I → W.Etale)
        (π_cov : ∀ i : I, X_cov i ⟶ E),
        (∀ z : ↥E.left, ∃ (i : I) (y : ↥(X_cov i).left), (π_cov i).left.base y = z) →
        ∀ (sec : ∀ i : I, ↥(ℱ_A.obj.obj (Opposite.op (X_cov i)))),
          (∀ (i₁ i₂ : I) {Z : W.Etale} (g₁ : Z ⟶ X_cov i₁) (g₂ : Z ⟶ X_cov i₂),
            g₁ ≫ π_cov i₁ = g₂ ≫ π_cov i₂ →
            (ℱ_A.obj.map g₁.op).hom (sec i₁) = (ℱ_A.obj.map g₂.op).hom (sec i₂)) →
          ∃! t : ↥(ℱ_A.obj.obj (Opposite.op E)),
            ∀ i : I, (ℱ_A.obj.map (π_cov i).op).hom t = sec i := by
      intro E I X_cov π_cov hSurj sec hComp
      have hGen : CategoryTheory.Sieve.generate
          (CategoryTheory.Presieve.ofArrows X_cov π_cov) ∈ J E := by
        rw [hMemSmallEtale]
        intro z
        obtain ⟨i, y, hy⟩ := hSurj z
        exact ⟨X_cov i, π_cov i, y,
          ⟨X_cov i, 𝟙 (X_cov i), π_cov i, ⟨i⟩, CategoryTheory.Category.id_comp _⟩,
          hEtMor (π_cov i), hy⟩
      have hFor := hℱ_sheaf.isSheafFor (CategoryTheory.Presieve.ofArrows X_cov π_cov) hGen
      rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hFor
      exact hFor sec (fun i₁ i₂ Z g₁ g₂ hcomm => hComp i₁ i₂ g₁ g₂ hcomm)
    have hEmptySub : ∀ (Z : W.Etale), IsEmpty ↥Z.left →
        Subsingleton ↥(ℱ_A.obj.obj (Opposite.op Z)) := by
      intro Z hEmp
      obtain ⟨t, -, ht_uniq⟩ := hℱ_arrows
        (fun i : PEmpty.{u + 1} => PEmpty.elim i)
        (fun i : PEmpty.{u + 1} => PEmpty.elim i)
        (fun z => IsEmpty.elim hEmp z)
        (fun i => PEmpty.elim i)
        (fun i => PEmpty.elim i)
      exact ⟨fun s₁ s₂ =>
        (ht_uniq s₁ (fun i => PEmpty.elim i)).trans (ht_uniq s₂ (fun i => PEmpty.elim i)).symm⟩
    let fiberOpen : ∀ (E : W.Etale), LocallyConstant ↥E.left ↥A → ↥A → E.left.Opens :=
      fun _ f a => ⟨f ⁻¹' {a}, f.isLocallyConstant {a}⟩
    let fiberEtale : ∀ (E : W.Etale), LocallyConstant ↥E.left ↥A → ↥A → W.Etale :=
      fun E f a =>
        haveI : AlgebraicGeometry.Etale E.hom := E.prop
        AlgebraicGeometry.Scheme.Etale.mk ((fiberOpen E f a).ι ≫ E.hom)
    let fiberHom : ∀ (E : W.Etale) (f : LocallyConstant ↥E.left ↥A) (a : ↥A),
        fiberEtale E f a ⟶ E :=
      fun E f a => CategoryTheory.MorphismProperty.Over.homMk (fiberOpen E f a).ι rfl
    have hGlueEx : ∀ (E : W.Etale) (f : LocallyConstant ↥E.left ↥A),
        ∃! t : ↥(ℱ_A.obj.obj (Opposite.op E)),
          ∀ a : ↥A, (ℱ_A.obj.map (fiberHom E f a).op).hom t =
            (ℱ_A.obj.map (hT_W.from (fiberEtale E f a)).op).hom (η_A.hom a) := by
      intro E f
      refine hℱ_arrows (fiberEtale E f) (fiberHom E f) ?_ _ ?_
      · intro z
        have hz : z ∈ Set.range ⇑(fiberOpen E f (f z)).ι := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rfl
        obtain ⟨y, hy⟩ := hz
        exact ⟨f z, y, hy⟩
      · intro a₁ a₂ Z g₁ g₂ hcomm
        by_cases hne : Nonempty ↥Z.left
        · obtain ⟨z₀⟩ := hne
          have hbase : (g₁.left ≫ (fiberOpen E f a₁).ι).base z₀ =
              (g₂.left ≫ (fiberOpen E f a₂).ι).base z₀ :=
            congrArg (fun k : Z ⟶ E => k.left.base z₀) hcomm
          have hmem₁ : (fiberOpen E f a₁).ι (g₁.left z₀) ∈
              Set.range ⇑(fiberOpen E f a₁).ι := ⟨g₁.left z₀, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hmem₁
          have hmem₂ : (fiberOpen E f a₂).ι (g₂.left z₀) ∈
              Set.range ⇑(fiberOpen E f a₂).ι := ⟨g₂.left z₀, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hmem₂
          have ha₁ : f ((g₁.left ≫ (fiberOpen E f a₁).ι).base z₀) = a₁ :=
            (congrArg f (AlgebraicGeometry.Scheme.Hom.comp_apply
              g₁.left (fiberOpen E f a₁).ι z₀)).trans hmem₁
          have ha₂ : f ((g₂.left ≫ (fiberOpen E f a₂).ι).base z₀) = a₂ :=
            (congrArg f (AlgebraicGeometry.Scheme.Hom.comp_apply
              g₂.left (fiberOpen E f a₂).ι z₀)).trans hmem₂
          have ha_eq : a₁ = a₂ := ha₁.symm.trans ((congrArg f hbase).trans ha₂)
          subst ha_eq
          have hterm : g₁ ≫ hT_W.from (fiberEtale E f a₁) =
              g₂ ≫ hT_W.from (fiberEtale E f a₁) := hT_W.hom_ext _ _
          change ((ℱ_A.obj.map (hT_W.from (fiberEtale E f a₁)).op ≫ ℱ_A.obj.map g₁.op).hom)
              (η_A.hom a₁) =
            ((ℱ_A.obj.map (hT_W.from (fiberEtale E f a₁)).op ≫ ℱ_A.obj.map g₂.op).hom)
              (η_A.hom a₁)
          rw [← ℱ_A.obj.map_comp, ← ℱ_A.obj.map_comp, ← op_comp, ← op_comp, hterm]
        · haveI : Subsingleton ↥(ℱ_A.obj.obj (Opposite.op Z)) :=
            hEmptySub Z (not_nonempty_iff.mp hne)
          exact Subsingleton.elim _ _
    let ψ_fun : ∀ (E : W.Etale), LocallyConstant ↥E.left ↥A → ↥(ℱ_A.obj.obj (Opposite.op E)) :=
      fun E f => (hGlueEx E f).choose
    have hψ_spec : ∀ (E : W.Etale) (f : LocallyConstant ↥E.left ↥A) (a : ↥A),
        (ℱ_A.obj.map (fiberHom E f a).op).hom (ψ_fun E f) =
          (ℱ_A.obj.map (hT_W.from (fiberEtale E f a)).op).hom (η_A.hom a) :=
      fun E f => (hGlueEx E f).choose_spec.1
    have hConstRes : ∀ {V E : W.Etale} (g : V ⟶ E) (f : LocallyConstant ↥E.left ↥A) (a₀ : ↥A),
        (∀ v : ↥V.left, f (g.left.base v) = a₀) →
        (ℱ_A.obj.map g.op).hom (ψ_fun E f) =
          (ℱ_A.obj.map (hT_W.from V).op).hom (η_A.hom a₀) := by
      intro V E g f a₀ hconst
      have hsub : Set.range ⇑g.left ⊆ Set.range ⇑(fiberOpen E f a₀).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨v, rfl⟩
        exact hconst v
      let hOpen_ι : AlgebraicGeometry.IsOpenImmersion (fiberOpen E f a₀).ι :=
        AlgebraicGeometry.Scheme.Opens.instIsOpenImmersionι (fiberOpen E f a₀)
      let l : V.left ⟶ (fiberEtale E f a₀).left :=
        @AlgebraicGeometry.IsOpenImmersion.lift _ _ _ (fiberOpen E f a₀).ι g.left hOpen_ι hsub
      have hl : l ≫ (fiberOpen E f a₀).ι = g.left :=
        @AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _ (fiberOpen E f a₀).ι g.left hOpen_ι hsub
      let g' : V ⟶ fiberEtale E f a₀ := CategoryTheory.MorphismProperty.Over.homMk l
        ((CategoryTheory.Category.assoc l (fiberOpen E f a₀).ι E.hom).symm.trans
          ((congrArg (· ≫ E.hom) hl).trans (CategoryTheory.MorphismProperty.Over.w g)))
      have hg' : g' ≫ fiberHom E f a₀ = g :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hl
      rw [← hg', op_comp, ℱ_A.obj.map_comp]
      change (ℱ_A.obj.map g'.op).hom ((ℱ_A.obj.map (fiberHom E f a₀).op).hom (ψ_fun E f)) = _
      rw [hψ_spec E f a₀]
      change ((ℱ_A.obj.map (hT_W.from (fiberEtale E f a₀)).op ≫ ℱ_A.obj.map g'.op).hom)
          (η_A.hom a₀) = _
      rw [← ℱ_A.obj.map_comp, ← op_comp, hT_W.hom_ext (g' ≫ hT_W.from _) (hT_W.from V)]
    have hψ_zero : ∀ (E : W.Etale), ψ_fun E 0 = 0 := by
      intro E
      have h1 := hConstRes (𝟙 E) 0 0 (fun _ => rfl)
      rw [op_id, ℱ_A.obj.map_id, map_zero, map_zero] at h1
      exact h1
    have hψ_add : ∀ (E : W.Etale) (f₁ f₂ : LocallyConstant ↥E.left ↥A),
        ψ_fun E (f₁ + f₂) = ψ_fun E f₁ + ψ_fun E f₂ := by
      intro E f₁ f₂
      haveI : AlgebraicGeometry.Etale E.hom := E.prop
      let pairOpen : ↥A × ↥A → E.left.Opens := fun p => fiberOpen E f₁ p.1 ⊓ fiberOpen E f₂ p.2
      let pairEtale : ↥A × ↥A → W.Etale := fun p =>
        AlgebraicGeometry.Scheme.Etale.mk ((pairOpen p).ι ≫ E.hom)
      let pairHom : ∀ p : ↥A × ↥A, pairEtale p ⟶ E := fun p =>
        CategoryTheory.MorphismProperty.Over.homMk (pairOpen p).ι rfl
      have hSurjP : ∀ z : ↥E.left, ∃ (p : ↥A × ↥A) (y : ↥(pairEtale p).left),
          (pairHom p).left.base y = z := by
        intro z
        have hz : z ∈ Set.range ⇑(pairOpen (f₁ z, f₂ z)).ι := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨rfl, rfl⟩
        obtain ⟨y, hy⟩ := hz
        exact ⟨(f₁ z, f₂ z), y, hy⟩
      have hMemP : ∀ (p : ↥A × ↥A) (v : ↥(pairEtale p).left),
          f₁ ((pairHom p).left.base v) = p.1 ∧ f₂ ((pairHom p).left.base v) = p.2 := by
        intro p v
