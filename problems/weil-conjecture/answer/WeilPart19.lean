            rw [h1]
            change (algebraMap R₀ S (m_α α) ⊗ₜ[R₀] (1 : A₂_dst)) * ((1 : S) ⊗ₜ[R₀] q_α α) = 0
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
              show algebraMap R₀ S (m_α α) = m_α α • (1 : S) by rw [Algebra.smul_def, mul_one],
