      erw [hj_zero]
      rw [adj_sh.homEquiv_unit]
      have h_map0 : (CategoryTheory.sheafToPresheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).map
          (0 : (CategoryTheory.presheafToSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj K_pre ⟶ ℱ) = 0 := by
        ext U_op x
        rfl
      rw [h_map0, CategoryTheory.Limits.comp_zero]
    have hj_sh_zero : j_sh = 0 :=
      (CategoryTheory.cancel_mono ι).mp (hj_sh_comp.trans CategoryTheory.Limits.zero_comp.symm)
    have hj_pre_zero : j_pre = 0 := by
      calc
        j_pre = adj_sh.homEquiv K_pre 𝒢 j_sh := (Equiv.apply_symm_apply _ _).symm
        _ = adj_sh.homEquiv K_pre 𝒢 0 := by rw [hj_sh_zero]
        _ = 0 := by
          rw [adj_sh.homEquiv_unit]
          have h_map0 : (CategoryTheory.sheafToPresheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).map
              (0 : (CategoryTheory.presheafToSheaf Z.smallEtaleTopology (ModuleCat.{u, u} R)).obj K_pre ⟶ 𝒢) = 0 := by
            ext U_op x
            rfl
          rw [h_map0, CategoryTheory.Limits.comp_zero]
    intro s₁ s₂ hs
    have hsub_ker : s₁ - s₂ ∈ LinearMap.ker (ι.hom.app (Opposite.op W)).hom := by
      rw [LinearMap.mem_ker, map_sub, hs, sub_self]
    have hval0 := congrArg
      (fun (η : K_pre ⟶ 𝒢.obj) => (η.app (Opposite.op W)).hom ⟨s₁ - s₂, hsub_ker⟩) hj_pre_zero
    exact sub_eq_zero.mp hval0
  have etale_map_left_etale_aux : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      {U₁ U₂ : Z.Etale} (f : U₁ ⟶ U₂),
      AlgebraicGeometry.Etale (((AlgebraicGeometry.Scheme.Etale.forget Z).map f).left) := by
    intro Z U₁ U₂ f
