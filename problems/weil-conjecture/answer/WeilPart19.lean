theorem weil_commAlg_domain_etale_product_splitting (A : Type u) [CommRing A] [IsDomain A] (r : ℕ)
    (B : Fin r → Type u) [∀ t : Fin r, CommRing (B t)]
    [∀ t : Fin r, Algebra A (B t)] [∀ t : Fin r, Algebra.Etale A (B t)] :
    ∃ (f₁ : A), f₁ ≠ 0 ∧
      ∃ (C₁ : Type u) (_ : CommRing C₁) (_ : IsDomain C₁)
        (_ : Algebra (Localization.Away f₁) C₁) (N : Fin r → ℕ),
        Module.Finite (Localization.Away f₁) C₁ ∧
        Algebra.IsIntegral (Localization.Away f₁) C₁ ∧
        Algebra.Etale (Localization.Away f₁) C₁ ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap (Localization.Away f₁) C₁)) ∧
        ∀ t : Fin r,
          letI : Algebra A C₁ :=
            RingHom.toAlgebra ((algebraMap (Localization.Away f₁) C₁).comp
              (algebraMap A (Localization.Away f₁)))
          Nonempty (AlgEquiv C₁ (TensorProduct A C₁ (B t)) (Fin (N t) → C₁)) :=
by
  classical
  
  have h_s1 : ∀ (K E : Type u) [Field K] [CommRing E] [Algebra K E] [Algebra.Etale K E],
      ∃ (m : ℕ) (p : Fin m → Polynomial K),
        (∀ i : Fin m, (p i).Monic ∧ Irreducible (p i) ∧ (p i).Separable) ∧
        ∀ (L : Type u) [Field L] [Algebra K L],
          (∀ i : Fin m, (Polynomial.map (algebraMap K L) (p i)).Splits) →
          Nonempty (AlgEquiv L (TensorProduct K L E)
            (Fin (∑ i : Fin m, (p i).natDegree) → L)) := by
    intro K E _ _ _ _
    have hEt := (Algebra.Etale.iff_exists_algEquiv_prod K E).mp inferInstance
    rcases hEt with ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e₀, hFinSepAi⟩
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i : I, Field (Ai i) := hFieldAi
    let _ : ∀ i : I, Algebra K (Ai i) := hAlgAi
    let m : ℕ := Fintype.card I
    let σ : I ≃ Fin m := Fintype.equivFin I
    let F : Fin m → Type u := fun i => Ai (σ.symm i)
    have hFinF : ∀ i : Fin m, Module.Finite K (F i) := fun i => (hFinSepAi (σ.symm i)).1
    have hSepF : ∀ i : Fin m, Algebra.IsSeparable K (F i) := fun i => (hFinSepAi (σ.symm i)).2
    let e₁ : E ≃ₐ[K] ∀ i : Fin m, F i :=
      e₀.trans (AlgEquiv.piCongrLeft K Ai σ.symm).symm
    have hPrim : ∀ i : Fin m, ∃ α : F i, IntermediateField.adjoin K ({α} : Set (F i)) = ⊤ :=
      fun i => by
        have := hFinF i
        have := hSepF i
        exact Field.exists_primitive_element K (F i)
    let α : ∀ i : Fin m, F i := fun i => Classical.choose (hPrim i)
    have hα_top : ∀ i : Fin m, IntermediateField.adjoin K ({α i} : Set (F i)) = ⊤ :=
      fun i => Classical.choose_spec (hPrim i)
    have hα_int : ∀ i : Fin m, _root_.IsIntegral K (α i) := fun i => by
      have := hFinF i
      exact Algebra.IsIntegral.isIntegral (R := K) (α i)
    let p : Fin m → Polynomial K := fun i => minpoly K (α i)
    have hp_props : ∀ i : Fin m, (p i).Monic ∧ Irreducible (p i) ∧ (p i).Separable := fun i => by
      have := hSepF i
      exact ⟨minpoly.monic (hα_int i),
        minpoly.irreducible (hα_int i),
        Algebra.IsSeparable.isSeparable K (α i)⟩
    have hF_equiv : ∀ i : Fin m, Nonempty (F i ≃ₐ[K] AdjoinRoot (p i)) := by
      intro i
      have h_alg : IsAlgebraic K (α i) := (hα_int i).isAlgebraic
      have h_adj : Algebra.adjoin K ({α i} : Set (F i)) = ⊤ :=
        (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic h_alg).mp (hα_top i)
      let e_top : F i ≃ₐ[K] ↥(Algebra.adjoin K ({α i} : Set (F i))) :=
        Subalgebra.topEquiv.symm.trans (Subalgebra.equivOfEq _ _ h_adj.symm)
      exact ⟨e_top.trans (AlgEquiv.adjoinSingletonEquivAdjoinRootMinpoly K (α i))⟩
    let eF : ∀ i : Fin m, F i ≃ₐ[K] AdjoinRoot (p i) := fun i => Classical.choice (hF_equiv i)
    let e_prod : E ≃ₐ[K] ∀ i : Fin m, AdjoinRoot (p i) :=
      e₁.trans (AlgEquiv.piCongrRight eF)
    refine ⟨m, p, hp_props, ?_⟩
    intro L _ _ hSplits
    have hComp : ∀ i : Fin m,
        Nonempty (AlgEquiv L (TensorProduct K L (AdjoinRoot (p i)))
          (Fin (p i).natDegree → L)) := by
      intro i
      let q : Polynomial L := Polynomial.map (algebraMap K L) (p i)
      have hq_monic : q.Monic := (hp_props i).1.map (algebraMap K L)
      have hq_deg : q.natDegree = (p i).natDegree := (hp_props i).1.natDegree_map (algebraMap K L)
      have hq_sep : q.Separable := (hp_props i).2.2.map
      have hq_splits : q.Splits := hSplits i
      have h_root_q : Polynomial.aeval (AdjoinRoot.root q) (p i) = 0 := by
        rw [Polynomial.aeval_def, IsScalarTower.algebraMap_eq K L (AdjoinRoot q),
          ← Polynomial.eval₂_map]
        exact AdjoinRoot.eval₂_root q
      let φ_rhs : AdjoinRoot (p i) →ₐ[K] AdjoinRoot q :=
        AdjoinRoot.liftAlgHom (p i) (Algebra.ofId K (AdjoinRoot q)) (AdjoinRoot.root q) h_root_q
      let α_bc : TensorProduct K L (AdjoinRoot (p i)) →ₐ[L] AdjoinRoot q :=
        Algebra.TensorProduct.lift (Algebra.ofId L (AdjoinRoot q)) φ_rhs (fun _ _ => Commute.all _ _)
      have h_root_tp : Polynomial.aeval ((1 : L) ⊗ₜ[K] AdjoinRoot.root (p i)) q = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        have h1 : (algebraMap L (TensorProduct K L (AdjoinRoot (p i)))).comp (algebraMap K L) =
            (Algebra.TensorProduct.includeRight (R := K) (A := L) (B := AdjoinRoot (p i))).toRingHom.comp
              (algebraMap K (AdjoinRoot (p i))) := by
          ext k
          simp [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_one_eq_one_tmul]
        rw [h1]
        change Polynomial.eval₂
            ((Algebra.TensorProduct.includeRight (R := K) (A := L) (B := AdjoinRoot (p i))).toRingHom.comp
              (algebraMap K (AdjoinRoot (p i))))
            ((Algebra.TensorProduct.includeRight (R := K) (A := L) (B := AdjoinRoot (p i))).toRingHom
              (AdjoinRoot.root (p i))) (p i) = 0
        rw [← Polynomial.hom_eval₂]
        change Algebra.TensorProduct.includeRight (Polynomial.aeval (AdjoinRoot.root (p i)) (p i)) = 0
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, map_zero]
      let β_bc : AdjoinRoot q →ₐ[L] TensorProduct K L (AdjoinRoot (p i)) :=
        AdjoinRoot.liftAlgHom q (Algebra.ofId L _) ((1 : L) ⊗ₜ[K] AdjoinRoot.root (p i)) h_root_tp
      have h_β_root : β_bc (AdjoinRoot.root q) = (1 : L) ⊗ₜ[K] AdjoinRoot.root (p i) :=
        AdjoinRoot.liftAlgHom_root q (Algebra.ofId L _) _ h_root_tp
      have h_φ_root : φ_rhs (AdjoinRoot.root (p i)) = AdjoinRoot.root q :=
        AdjoinRoot.liftAlgHom_root (p i) (Algebra.ofId K (AdjoinRoot q)) _ h_root_q
      have h_αβ : α_bc.comp β_bc = AlgHom.id L (AdjoinRoot q) := by
        apply AdjoinRoot.algHom_ext
        rw [AlgHom.comp_apply, h_β_root]
        simp [α_bc, h_φ_root]
      have h_βα : β_bc.comp α_bc = AlgHom.id L (TensorProduct K L (AdjoinRoot (p i))) := by
        apply Algebra.TensorProduct.ext
        · ext
        · apply AdjoinRoot.algHom_ext
          simp [α_bc, h_φ_root, h_β_root]
      let e_bc : TensorProduct K L (AdjoinRoot (p i)) ≃ₐ[L] AdjoinRoot q :=
        AlgEquiv.ofAlgHom α_bc β_bc h_αβ h_βα
      have hq_nodup : q.roots.Nodup := Polynomial.nodup_roots hq_sep
      let s : Finset L := q.roots.toFinset
      have hs_card : s.card = (p i).natDegree := by
        rw [Multiset.toFinset_card_of_nodup hq_nodup, ← hq_splits.natDegree_eq_card_roots, hq_deg]
      have h_eval_zero : ∀ ρ : ↥s, Polynomial.aeval (ρ : L) q = 0 := by
        intro ρ
        have hmem : (ρ : L) ∈ q.roots := Multiset.mem_toFinset.mp ρ.2
        simpa using (Polynomial.mem_roots hq_monic.ne_zero).mp hmem
      let ev : AdjoinRoot q →ₐ[L] (↥s → L) :=
        AlgHom.pi (fun ρ : ↥s =>
          AdjoinRoot.liftAlgHom q (Algebra.ofId L L) (ρ : L) (h_eval_zero ρ))
      have h_ev_inj : Function.Injective ev := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        rcases AdjoinRoot.mk_surjective x with ⟨f, rfl⟩
        have h_dvd_lin : ∀ ρ ∈ s, (Polynomial.X - Polynomial.C ρ) ∣ f := by
          intro ρ hρ
          rw [Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def]
          have hρ0 := congrFun hx ⟨ρ, hρ⟩
          simpa [ev] using hρ0
        have h_cop : Set.Pairwise (↑s : Set L)
            (fun ρ₁ ρ₂ => IsCoprime (Polynomial.X - Polynomial.C ρ₁) (Polynomial.X - Polynomial.C ρ₂)) := by
          intro ρ₁ _ ρ₂ _ hne
          exact Polynomial.isCoprime_X_sub_C_of_isUnit_sub (sub_ne_zero.mpr hne).isUnit
        have h_prod_dvd : (∏ ρ ∈ s, (Polynomial.X - Polynomial.C ρ)) ∣ f :=
          Finset.prod_dvd_of_coprime h_cop h_dvd_lin
        have h_prod_eq : (∏ ρ ∈ s, (Polynomial.X - Polynomial.C ρ)) = q := by
          rw [Finset.prod_eq_multiset_prod, Multiset.toFinset_val,
            Multiset.dedup_eq_self.mpr hq_nodup]
          exact (hq_splits.eq_prod_roots_of_monic hq_monic).symm
        rw [h_prod_eq] at h_prod_dvd
        exact AdjoinRoot.mk_eq_zero.mpr h_prod_dvd
      let pb_q := AdjoinRoot.powerBasis' hq_monic
      have : FiniteDimensional L (AdjoinRoot q) := pb_q.finite
      have h_dim_eq : Module.finrank L (AdjoinRoot q) = Module.finrank L (↥s → L) := by
        rw [pb_q.finrank, AdjoinRoot.powerBasis'_dim, Module.finrank_pi, Fintype.card_coe,
          hs_card, hq_deg]
      have h_ev_surj : Function.Surjective ev := by
        change Function.Surjective ev.toLinearMap
        exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank h_dim_eq).mp h_ev_inj
      let e_ev : AdjoinRoot q ≃ₐ[L] (↥s → L) := AlgEquiv.ofBijective ev ⟨h_ev_inj, h_ev_surj⟩
      have h_card_s : Fintype.card ↥s = Fintype.card (Fin (p i).natDegree) := by
        rw [Fintype.card_coe, Fintype.card_fin, hs_card]
      let e_fin_s : ↥s ≃ Fin (p i).natDegree := Fintype.equivOfCardEq h_card_s
      exact ⟨e_bc.trans (e_ev.trans (AlgEquiv.piCongrLeft L (fun _ => L) e_fin_s))⟩
    let e_comp : ∀ i : Fin m,
        AlgEquiv L (TensorProduct K L (AdjoinRoot (p i))) (Fin (p i).natDegree → L) :=
      fun i => Classical.choice (hComp i)
    let e_step1 : TensorProduct K L E ≃ₐ[L] TensorProduct K L (∀ i : Fin m, AdjoinRoot (p i)) :=
      Algebra.TensorProduct.congr AlgEquiv.refl e_prod
    let e_step2 : TensorProduct K L (∀ i : Fin m, AdjoinRoot (p i)) ≃ₐ[L]
        ∀ i : Fin m, TensorProduct K L (AdjoinRoot (p i)) :=
      Algebra.TensorProduct.piRight K L L (fun i : Fin m => AdjoinRoot (p i))
    let e_step3 : (∀ i : Fin m, TensorProduct K L (AdjoinRoot (p i))) ≃ₐ[L]
        (∀ i : Fin m, Fin (p i).natDegree → L) :=
      AlgEquiv.piCongrRight e_comp
    let e_step4 : (∀ i : Fin m, Fin (p i).natDegree → L) ≃ₐ[L]
        ((Σ i : Fin m, Fin (p i).natDegree) → L) :=
      { toFun := fun f x => f x.1 x.2
        invFun := fun g i j => g ⟨i, j⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => funext fun ⟨_, _⟩ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    let e_step5 : ((Σ i : Fin m, Fin (p i).natDegree) → L) ≃ₐ[L]
        (Fin (∑ i : Fin m, (p i).natDegree) → L) :=
      AlgEquiv.piCongrLeft L (fun _ => L) finSigmaFinEquiv
    exact ⟨(((e_step1.trans e_step2).trans e_step3).trans e_step4).trans e_step5⟩

  
  have h_s2 : ∀ (K : Type u) [Field K] (m : Fin r → ℕ)
      (p : ∀ t : Fin r, Fin (m t) → Polynomial K),
      (∀ (t : Fin r) (i : Fin (m t)), (p t i).Monic ∧ Irreducible (p t i) ∧ (p t i).Separable) →
      ∃ (g_K : Polynomial K),
        g_K.Monic ∧
        Irreducible g_K ∧
        g_K.Separable ∧
        ∀ (t : Fin r) (i : Fin (m t)),
          (Polynomial.map (algebraMap K (AdjoinRoot g_K)) (p t i)).Splits := by
    intro K _ m p hp
    let S : Finset (Polynomial K) :=
      Finset.univ.biUnion (fun t : Fin r => Finset.univ.image (p t))
    have hS : ∀ q ∈ S, q.Monic ∧ Irreducible q ∧ q.Separable := by
      intro q hq
      simp only [S, Finset.mem_biUnion, Finset.mem_univ, Finset.mem_image, true_and] at hq
      rcases hq with ⟨t, i, rfl⟩
      exact hp t i
    have hProd_gen : ∀ T : Finset (Polynomial K),
        (∀ q ∈ T, q.Monic ∧ Irreducible q ∧ q.Separable) →
        (∏ q ∈ T, q).Monic ∧ (∏ q ∈ T, q).Separable := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro _
        simp [Polynomial.monic_one, Polynomial.separable_one]
      | @insert q₀ S' hq₀_not ih =>
        intro hT
        have hq₀ := hT q₀ (Finset.mem_insert_self q₀ S')
        have hS' : ∀ q ∈ S', q.Monic ∧ Irreducible q ∧ q.Separable :=
          fun q hq => hT q (Finset.mem_insert_of_mem hq)
        obtain ⟨ih_monic, ih_sep⟩ := ih hS'
        rw [Finset.prod_insert hq₀_not]
        refine ⟨hq₀.1.mul ih_monic, ?_⟩
        have h_cop_each : ∀ q ∈ S', IsCoprime q₀ q := by
          intro q hq
          have hq_prop := hS' q hq
          have hne : q₀ ≠ q := fun hEq => hq₀_not (hEq ▸ hq)
          rw [Irreducible.coprime_iff_not_dvd hq₀.2.1]
          intro hdvd
          rcases hdvd with ⟨c, hc⟩
          have hc_unit : IsUnit c :=
            (hq_prop.2.1.isUnit_or_isUnit hc).resolve_left hq₀.2.1.not_isUnit
          rcases Polynomial.isUnit_iff.mp hc_unit with ⟨u, _, rfl⟩
          have hlead : q.leadingCoeff = q₀.leadingCoeff * (Polynomial.C u).leadingCoeff := by
            rw [hc, Polynomial.leadingCoeff_mul]
          rw [hq_prop.1.leadingCoeff, hq₀.1.leadingCoeff, one_mul, Polynomial.leadingCoeff_C] at hlead
          subst hlead
          simp only [map_one, mul_one] at hc
          exact hne hc.symm
        exact hq₀.2.2.mul ih_sep (IsCoprime.prod_right h_cop_each)
    have hProd := hProd_gen S hS
    let P_sep : Polynomial K := ∏ q ∈ S, q
    let L₀ : Type u := P_sep.SplittingField
    have : FiniteDimensional K L₀ := Polynomial.IsSplittingField.finiteDimensional L₀ P_sep
    have : IsGalois K L₀ := IsGalois.of_separable_splitting_field hProd.2
    have : Algebra.IsSeparable K L₀ := IsGalois.to_isSeparable
    obtain ⟨θ, hθ_top⟩ := Field.exists_primitive_element K L₀
    have hθ_int : _root_.IsIntegral K θ := Algebra.IsIntegral.isIntegral (R := K) θ
    let g_K : Polynomial K := minpoly K θ
    have hg_monic : g_K.Monic := minpoly.monic hθ_int
    have hg_irr : Irreducible g_K := minpoly.irreducible hθ_int
    have hg_sep : g_K.Separable := Algebra.IsSeparable.isSeparable K θ
    have h_adj : Algebra.adjoin K ({θ} : Set L₀) = ⊤ :=
      (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hθ_int.isAlgebraic).mp hθ_top
    let e_top : L₀ ≃ₐ[K] ↥(Algebra.adjoin K ({θ} : Set L₀)) :=
      Subalgebra.topEquiv.symm.trans (Subalgebra.equivOfEq _ _ h_adj.symm)
    let e_L : L₀ ≃ₐ[K] AdjoinRoot g_K :=
      e_top.trans (AlgEquiv.adjoinSingletonEquivAdjoinRootMinpoly K θ)
    refine ⟨g_K, hg_monic, hg_irr, hg_sep, ?_⟩
    intro t i
    have hmem : p t i ∈ S := by
      simp only [S, Finset.mem_biUnion, Finset.mem_univ, Finset.mem_image, true_and]
      exact ⟨t, i, rfl⟩
    have hdvd : p t i ∣ P_sep := Finset.dvd_prod_of_mem _ hmem
    have hdvd_map : Polynomial.map (algebraMap K L₀) (p t i) ∣
        Polynomial.map (algebraMap K L₀) P_sep :=
      Polynomial.map_dvd (algebraMap K L₀) hdvd
    have hP_splits : (Polynomial.map (algebraMap K L₀) P_sep).Splits :=
      Polynomial.IsSplittingField.splits L₀ P_sep
    have hP_ne : Polynomial.map (algebraMap K L₀) P_sep ≠ 0 :=
      (hProd.1.map (algebraMap K L₀)).ne_zero
    have hp_splits_L₀ : (Polynomial.map (algebraMap K L₀) (p t i)).Splits :=
      hP_splits.of_dvd hP_ne hdvd_map
    have hp_splits_L := hp_splits_L₀.map e_L.toRingHom
    rw [Polynomial.map_map] at hp_splits_L
    have h_alg_eq : e_L.toRingHom.comp (algebraMap K L₀) = algebraMap K (AdjoinRoot g_K) := by
      ext k
      exact e_L.commutes k
    rwa [h_alg_eq] at hp_splits_L

  
  have h_s3 : ∀ (T_K : Finset (FractionRing A)) (g_K : Polynomial (FractionRing A)),
      g_K.Monic → g_K.Separable →
      ∃ (f₁ : A), f₁ ≠ 0 ∧
        let A₁ := Localization.Away f₁
        IsDomain A₁ ∧
        ∃ (ι_A₁ : A₁ →ₐ[A] FractionRing A) (g₀ : Polynomial A₁),
          Function.Injective ι_A₁ ∧
          (∀ c ∈ T_K, c ∈ Set.range ι_A₁) ∧
          g₀.Monic ∧
          Polynomial.map ι_A₁.toRingHom g₀ = g_K ∧
          (∃ u₀ v₀ : Polynomial A₁, Polynomial.derivative g₀ * u₀ + g₀ * v₀ = 1) := by
    intro T_K g_K hgK_monic hgK_sep
    let K := FractionRing A
    let M := nonZeroDivisors A
    obtain ⟨v_K, u_K, huv_K⟩ := (Polynomial.separable_def g_K).mp hgK_sep
    have h_bezout_K : Polynomial.derivative g_K * u_K + g_K * v_K = 1 := by
      linear_combination huv_K
    let T_all : Finset K :=
      T_K ∪ g_K.support.image g_K.coeff ∪ u_K.support.image u_K.coeff ∪ v_K.support.image v_K.coeff
    let f₁ : A := ∏ c ∈ T_all, ((IsLocalization.sec M c).2 : A)
    have hf₁_mem : f₁ ∈ M :=
      Submonoid.prod_mem M (fun c _ => (IsLocalization.sec M c).2.2)
    have hf₁_ne : f₁ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hf₁_mem
    let A₁ := Localization.Away f₁
    have hDomA₁ : IsDomain A₁ :=
      IsLocalization.isDomain_of_le_nonZeroDivisors A₁ (Submonoid.powers_le.mpr hf₁_mem)
    have hf₁_K_ne : algebraMap A K f₁ ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hf₁_mem
    have hf₁_unit : IsUnit (algebraMap A K f₁) := hf₁_K_ne.isUnit
    let ι_ring : A₁ →+* K := IsLocalization.Away.lift f₁ hf₁_unit
    let ι_A₁ : A₁ →ₐ[A] K :=
      { ι_ring with
        commutes' := IsLocalization.Away.lift_eq f₁ hf₁_unit }
    have h_inj : Function.Injective ι_A₁ := by
      change Function.Injective ι_ring
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers f₁) z
      have h1 : ι_ring (z * algebraMap A A₁ (s : A)) = ι_ring (algebraMap A A₁ a) :=
        congrArg ι_ring hzs
      rw [map_mul, hz, zero_mul, IsLocalization.Away.lift_eq f₁ hf₁_unit] at h1
      have ha0 : a = 0 := IsFractionRing.injective A K (h1.symm.trans (map_zero _).symm)
      rw [ha0, map_zero] at hzs
      rcases IsLocalization.map_units A₁ s with ⟨u_s, hu_s⟩
      rw [← hu_s] at hzs
      have hz0 := congrArg (· * (↑(u_s⁻¹) : A₁)) hzs
      simpa using hz0
    have h_range_all : ∀ c ∈ T_all, c ∈ Set.range ι_A₁ := by
      intro c hc
      let p_sec := IsLocalization.sec M c
      have hdvd : (p_sec.2 : A) ∣ f₁ := Finset.dvd_prod_of_mem (fun x => ((IsLocalization.sec M x).2 : A)) hc
      rcases hdvd with ⟨q, hq⟩
      rcases IsLocalization.Away.algebraMap_isUnit (S := A₁) f₁ with ⟨u_f, hu_f⟩
      let w : A₁ := algebraMap A A₁ q * ↑(u_f⁻¹)
      have hw : algebraMap A A₁ (p_sec.2 : A) * w = 1 := by
        dsimp [w]
        rw [← mul_assoc, ← map_mul, ← hq, ← hu_f, Units.mul_inv]
      let z : A₁ := algebraMap A A₁ p_sec.1 * w
      have hzw : z * algebraMap A A₁ (p_sec.2 : A) = algebraMap A A₁ p_sec.1 := by
        calc
          z * algebraMap A A₁ (p_sec.2 : A)
            = algebraMap A A₁ p_sec.1 * (algebraMap A A₁ (p_sec.2 : A) * w) := by
                dsimp [z]; ring
          _ = algebraMap A A₁ p_sec.1 := by rw [hw, mul_one]
      refine ⟨z, ?_⟩
      have hd_ne : algebraMap A K (p_sec.2 : A) ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors p_sec.2.2
      apply mul_right_cancel₀ hd_ne
      calc
        ι_A₁ z * algebraMap A K (p_sec.2 : A)
          = ι_A₁ z * ι_A₁ (algebraMap A A₁ (p_sec.2 : A)) := by rw [ι_A₁.commutes]
        _ = ι_A₁ (z * algebraMap A A₁ (p_sec.2 : A)) := (map_mul ι_A₁ _ _).symm
        _ = ι_A₁ (algebraMap A A₁ p_sec.1) := by rw [hzw]
        _ = algebraMap A K p_sec.1 := ι_A₁.commutes p_sec.1
        _ = c * algebraMap A K (p_sec.2 : A) := (IsLocalization.sec_spec M c).symm
    have h_lift_poly : ∀ P : Polynomial K,
        (∀ d ∈ P.support, P.coeff d ∈ T_all) →
        ∃ P₀ : Polynomial A₁, Polynomial.map ι_A₁.toRingHom P₀ = P := by
      intro P hP
      have h_ex : ∀ d : ↥P.support, ∃ a : A₁, ι_A₁ a = P.coeff d.1 :=
        fun d => h_range_all (P.coeff d.1) (hP d.1 d.2)
      let P₀ : Polynomial A₁ :=
        ∑ d ∈ P.support.attach, Polynomial.monomial d.1 (Classical.choose (h_ex d))
      refine ⟨P₀, ?_⟩
      dsimp [P₀]
      rw [Polynomial.map_sum]
      refine Eq.trans (b := ∑ d ∈ P.support.attach, Polynomial.monomial d.1 (P.coeff d.1)) ?_ ?_
      · refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [Polynomial.map_monomial]
        congr 1
        exact Classical.choose_spec (h_ex d)
      · rw [Finset.sum_attach P.support (fun d => Polynomial.monomial d (P.coeff d))]
        exact (Polynomial.as_sum_support P).symm
    obtain ⟨g₀, hg₀_map⟩ := h_lift_poly g_K (fun d hd => by
      simp only [T_all, Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inl (Or.inr ⟨d, hd, rfl⟩)))
    obtain ⟨u₀, hu₀_map⟩ := h_lift_poly u_K (fun d hd => by
      simp only [T_all, Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inr ⟨d, hd, rfl⟩))
    obtain ⟨v₀, hv₀_map⟩ := h_lift_poly v_K (fun d hd => by
      simp only [T_all, Finset.mem_union, Finset.mem_image]
      exact Or.inr ⟨d, hd, rfl⟩)
    have hg₀_monic : g₀.Monic := by
      rw [Polynomial.Monic.def]
      apply h_inj
      have h_lc := Polynomial.leadingCoeff_map_of_injective (f := ι_A₁.toRingHom) h_inj g₀
      change (Polynomial.map ι_A₁.toRingHom g₀).leadingCoeff = ι_A₁ g₀.leadingCoeff at h_lc
      rw [← h_lc, hg₀_map, hgK_monic.leadingCoeff, map_one]
    have h_bezout₀ : Polynomial.derivative g₀ * u₀ + g₀ * v₀ = 1 := by
      apply Polynomial.map_injective ι_A₁.toRingHom h_inj
      rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_one,
        ← Polynomial.derivative_map, hg₀_map, hu₀_map, hv₀_map]
      exact h_bezout_K
    refine ⟨f₁, hf₁_ne, hDomA₁, ι_A₁, g₀, h_inj, ?_, hg₀_monic, hg₀_map, ⟨u₀, v₀, h_bezout₀⟩⟩
    intro c hc
    apply h_range_all c
    simp only [T_all, Finset.mem_union]
    exact Or.inl (Or.inl (Or.inl hc))

  
  have h_s4 : ∀ (A₁ K : Type u) [CommRing A₁] [IsDomain A₁] [Field K]
      (ι_A₁ : A₁ →+* K), Function.Injective ι_A₁ →
      ∀ (g₀ : Polynomial A₁) (g_K : Polynomial K)
        (hg₀_monic : g₀.Monic) (hgK_monic : g_K.Monic),
        Polynomial.map ι_A₁ g₀ = g_K →
        (∃ u₀ v₀ : Polynomial A₁, Polynomial.derivative g₀ * u₀ + g₀ * v₀ = 1) →
        Irreducible g_K →
        let C₁ := AdjoinRoot g₀
        IsDomain C₁ ∧
        Module.Finite A₁ C₁ ∧
        Algebra.IsIntegral A₁ C₁ ∧
        Algebra.Etale A₁ C₁ ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap A₁ C₁)) ∧
        ∃ (ι_C₁ : C₁ →+* AdjoinRoot g_K),
          Function.Injective ι_C₁ ∧
          (∀ a₁ : A₁, ι_C₁ (algebraMap A₁ C₁ a₁) = algebraMap K (AdjoinRoot g_K) (ι_A₁ a₁)) ∧
          (∀ x : AdjoinRoot g_K,
            (∀ i : Fin g_K.natDegree,
              (AdjoinRoot.powerBasis' hgK_monic).basis.repr x i ∈ Set.range ι_A₁) →
            x ∈ Set.range ι_C₁) := by
    intro A₁ K _ _ _ ι_A₁ h_inj g₀ g_K hg₀_monic hgK_monic hg_map h_bezout hgK_irr
    subst hg_map
    let C₁ := AdjoinRoot g₀
    let L := AdjoinRoot (Polynomial.map ι_A₁ g₀)
    let _ : Fact (Irreducible (Polynomial.map ι_A₁ g₀)) := ⟨hgK_irr⟩
    let pb₀ := AdjoinRoot.powerBasis' hg₀_monic
    have hFinC₁ : Module.Finite A₁ C₁ := pb₀.finite
    have hIntC₁ : Algebra.IsIntegral A₁ C₁ := Algebra.IsIntegral.of_finite A₁ C₁
    have hEtC₁ : Algebra.Etale A₁ C₁ := by
      rcases h_bezout with ⟨u₀, v₀, huv⟩
      let P : StandardEtalePair A₁ :=
        StandardEtalePair.mk g₀ hg₀_monic 1 ⟨u₀, v₀, 1, by simp [huv]⟩
      have h_map_root : P.HasMap (AdjoinRoot.root g₀) := by
        refine ⟨?_, ?_⟩
        · simp [P, AdjoinRoot.aeval_eq]
        · simp [P]
      let φ : P.Ring →ₐ[A₁] C₁ := P.lift (AdjoinRoot.root g₀) h_map_root
      have h_X : Polynomial.aeval P.X g₀ = 0 := (StandardEtalePair.hasMap_X (P := P)).1
      let ψ : C₁ →ₐ[A₁] P.Ring :=
        AdjoinRoot.liftAlgHom g₀ (Algebra.ofId A₁ P.Ring) P.X h_X
      have h_ψ_root : ψ (AdjoinRoot.root g₀) = P.X :=
        AdjoinRoot.liftAlgHom_root g₀ (Algebra.ofId A₁ P.Ring) P.X h_X
      have h_φ_X : φ P.X = AdjoinRoot.root g₀ := P.lift_X (AdjoinRoot.root g₀) h_map_root
      have h_φψ : φ.comp ψ = AlgHom.id A₁ C₁ := by
        apply AdjoinRoot.algHom_ext
        rw [AlgHom.comp_apply, h_ψ_root, h_φ_X, AlgHom.id_apply]
      have h_ψφ : ψ.comp φ = AlgHom.id A₁ P.Ring := by
        apply P.homEquiv.injective
        apply Subtype.ext
        rw [P.homEquiv_apply_coe, P.homEquiv_apply_coe, AlgHom.comp_apply, h_φ_X, h_ψ_root,
          AlgHom.id_apply]
      let e_std : P.Ring ≃ₐ[A₁] C₁ := AlgEquiv.ofAlgHom φ ψ h_φψ h_ψφ
      exact Algebra.Etale.of_equiv e_std
    have h_eval_L : Polynomial.eval₂ ((AdjoinRoot.of (Polynomial.map ι_A₁ g₀)).comp ι_A₁)
        (AdjoinRoot.root (Polynomial.map ι_A₁ g₀)) g₀ = 0 := by
      rw [← Polynomial.eval₂_map]
      exact AdjoinRoot.eval₂_root (Polynomial.map ι_A₁ g₀)
    let ι_C₁ : C₁ →+* L :=
      AdjoinRoot.lift ((AdjoinRoot.of (Polynomial.map ι_A₁ g₀)).comp ι_A₁)
        (AdjoinRoot.root (Polynomial.map ι_A₁ g₀)) h_eval_L
    have h_comm : ∀ a₁ : A₁, ι_C₁ (algebraMap A₁ C₁ a₁) = algebraMap K L (ι_A₁ a₁) := by
      intro a₁
      exact AdjoinRoot.lift_of h_eval_L
    have h_root : ι_C₁ (AdjoinRoot.root g₀) = AdjoinRoot.root (Polynomial.map ι_A₁ g₀) :=
      AdjoinRoot.lift_root h_eval_L
    let pb_K := AdjoinRoot.powerBasis' hgK_monic
    have h_deg : g₀.natDegree = (Polynomial.map ι_A₁ g₀).natDegree :=
      (hg₀_monic.natDegree_map ι_A₁).symm
    have h_pb_dim : pb₀.dim = pb_K.dim := by
      rw [AdjoinRoot.powerBasis'_dim, AdjoinRoot.powerBasis'_dim, h_deg]
    have h_map_basis : ∀ i : Fin pb₀.dim, ∀ a₁ : A₁,
        ι_C₁ (a₁ • pb₀.basis i) = (ι_A₁ a₁) • pb_K.basis (finCongr h_pb_dim i) := by
      intro i a₁
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, h_comm,
        PowerBasis.basis_eq_pow, PowerBasis.basis_eq_pow,
        AdjoinRoot.powerBasis'_gen, AdjoinRoot.powerBasis'_gen, map_pow, h_root]
      rfl
    have h_inj_C₁ : Function.Injective ι_C₁ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      have hz_sum := (pb₀.basis.sum_repr z).symm
      have h0 : ι_C₁ (∑ i : Fin pb₀.dim, pb₀.basis.repr z i • pb₀.basis i) = 0 := by
        rw [← hz_sum, hz]
      rw [map_sum] at h0
      simp_rw [h_map_basis] at h0
      have h0_reidx : (∑ j : Fin pb_K.dim,
          ι_A₁ (pb₀.basis.repr z ((finCongr h_pb_dim).symm j)) • pb_K.basis j) = 0 := by
        rw [← Equiv.sum_comp (finCongr h_pb_dim)]
        simpa using h0
      have h_lin := Fintype.linearIndependent_iff.mp pb_K.basis.linearIndependent
        (fun j => ι_A₁ (pb₀.basis.repr z ((finCongr h_pb_dim).symm j))) h0_reidx
      rw [hz_sum]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      have hi0 : pb₀.basis.repr z i = 0 := by
        apply h_inj
        have hspec := h_lin (finCongr h_pb_dim i)
        simpa using hspec
      rw [hi0, zero_smul]
    have hDomC₁ : IsDomain C₁ := Function.Injective.isDomain ι_C₁ h_inj_C₁
    have h_algMap_inj : Function.Injective (algebraMap A₁ C₁) := by
      intro a₁ a₂ ha
      apply h_inj
      apply (algebraMap K L).injective
      rw [← h_comm, ← h_comm, ha]
    have hSurjSpec : Function.Surjective (PrimeSpectrum.comap (algebraMap A₁ C₁)) := by
      intro P_spec
      have h_ker : RingHom.ker (algebraMap A₁ C₁) ≤ P_spec.asIdeal := by
        rw [(RingHom.injective_iff_ker_eq_bot _).mp h_algMap_inj]
        exact bot_le
      have : P_spec.asIdeal.IsPrime := P_spec.isPrime
      obtain ⟨Q, hQ_prime, hQ_under⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain P_spec.asIdeal h_ker
      refine ⟨⟨Q, hQ_prime⟩, ?_⟩
      ext x
      exact Ideal.ext_iff.mp hQ_under x
    have h_range : ∀ x : L,
        (∀ i : Fin (Polynomial.map ι_A₁ g₀).natDegree, pb_K.basis.repr x i ∈ Set.range ι_A₁) →
        x ∈ Set.range ι_C₁ := by
      intro x hx
      let c : Fin pb_K.dim → A₁ := fun j => Classical.choose (hx j)
      have hc : ∀ j : Fin pb_K.dim, ι_A₁ (c j) = pb_K.basis.repr x j :=
        fun j => Classical.choose_spec (hx j)
      let z : C₁ := ∑ i : Fin pb₀.dim, c (finCongr h_pb_dim i) • pb₀.basis i
      refine ⟨z, ?_⟩
      dsimp [z]
      rw [map_sum]
      have h_terms : (∑ i : Fin pb₀.dim, ι_C₁ (c (finCongr h_pb_dim i) • pb₀.basis i)) =
          ∑ i : Fin pb₀.dim, pb_K.basis.repr x (finCongr h_pb_dim i) • pb_K.basis (finCongr h_pb_dim i) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [h_map_basis, hc]
      rw [h_terms]
      have h_reidx : (∑ i : Fin pb₀.dim,
          pb_K.basis.repr x (finCongr h_pb_dim i) • pb_K.basis (finCongr h_pb_dim i)) =
          ∑ j : Fin pb_K.dim, pb_K.basis.repr x j • pb_K.basis j :=
        Equiv.sum_comp (finCongr h_pb_dim) (fun j => pb_K.basis.repr x j • pb_K.basis j)
      rw [h_reidx]
      exact pb_K.basis.sum_repr x
    exact ⟨hDomC₁, hFinC₁, hIntC₁, hEtC₁, hSurjSpec, ι_C₁, h_inj_C₁, h_comm, h_range⟩

  
  have h_s5 : ∀ (B₀ C₁ L : Type u) [CommRing B₀] [Algebra A B₀] [Module.Flat A B₀]
      [CommRing C₁] [Algebra A C₁] [CommRing L] [Algebra A L]
      (ι : C₁ →ₐ[A] L), Function.Injective ι →
      ∀ (N : ℕ) (Ψ : AlgEquiv L (TensorProduct A L B₀) (Fin N → L))
        (S_gen : Finset B₀),
        Algebra.adjoin A (↑S_gen : Set B₀) = ⊤ →
        (∀ b ∈ S_gen, ∀ j : Fin N, Ψ (1 ⊗ₜ[A] b) j ∈ Set.range ι) →
        (∀ j : Fin N, Ψ.symm (Pi.single j 1) ∈
          Set.range (Algebra.TensorProduct.map ι (AlgHom.id A B₀))) →
        Nonempty (AlgEquiv C₁ (TensorProduct A C₁ B₀) (Fin N → C₁)) := by
    intro B₀ C₁ L _ _ _ _ _ _ _ ι h_inj N Ψ S_gen hS_gen h_fwd h_idemp
    let j_B : TensorProduct A C₁ B₀ →ₐ[A] TensorProduct A L B₀ :=
      Algebra.TensorProduct.map ι (AlgHom.id A B₀)
    have hj_B_eq : (j_B : TensorProduct A C₁ B₀ → TensorProduct A L B₀) =
        ⇑(LinearMap.rTensor B₀ ι.toLinearMap) := by
      ext z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul c b => simp [j_B]
      | add x y ihx ihy => simp [map_add, ihx, ihy]
    have h_inj_B : Function.Injective j_B := by
      rw [hj_B_eq]
      exact Module.Flat.rTensor_preserves_injective_linearMap ι.toLinearMap h_inj
    let j_Pi : (Fin N → C₁) →ₐ[A] (Fin N → L) :=
      AlgHom.pi (fun j : Fin N => ι.comp (Pi.evalAlgHom A (fun _ : Fin N => C₁) j))
    have hj_Pi_apply : ∀ (v : Fin N → C₁) (j : Fin N), j_Pi v j = ι (v j) := fun _ _ => rfl
    have h_inj_Pi : Function.Injective j_Pi := by
      intro v₁ v₂ hv
      ext j
      exact h_inj (congrFun hv j)
    let φ_B : B₀ →ₐ[A] (Fin N → L) :=
      { toFun := fun b => Ψ ((1 : L) ⊗ₜ[A] b)
        map_one' := by rw [← Algebra.TensorProduct.one_def, map_one]
        map_mul' := fun b₁ b₂ => by
          have : ((1 : L) ⊗ₜ[A] (b₁ * b₂)) = ((1 : L) ⊗ₜ[A] b₁) * ((1 : L) ⊗ₜ[A] b₂) := by simp
          rw [this, map_mul]
        map_zero' := by simp
        map_add' := fun b₁ b₂ => by rw [TensorProduct.tmul_add, map_add]
        commutes' := fun a => by
          have h_eq : ((1 : L) ⊗ₜ[A] algebraMap A B₀ a) =
              algebraMap L (TensorProduct A L B₀) (algebraMap A L a) := by
            rw [Algebra.TensorProduct.algebraMap_apply, ← Algebra.TensorProduct.tmul_one_eq_one_tmul]
            simp
          rw [h_eq, Ψ.commutes]
          rfl }
    let B_sub : Subalgebra A B₀ := j_Pi.range.comap φ_B
    have hS_sub : (↑S_gen : Set B₀) ⊆ (B_sub : Set B₀) := by
      intro b hb
      let v : Fin N → C₁ := fun j => Classical.choose (h_fwd b hb j)
      refine ⟨v, ?_⟩
      ext j
      exact Classical.choose_spec (h_fwd b hb j)
    have hB_top : B_sub = ⊤ := top_unique (hS_gen ▸ Algebra.adjoin_le hS_sub)
    have h_all_b : ∀ b : B₀, Ψ (1 ⊗ₜ[A] b) ∈ Set.range j_Pi := by
      intro b
      have hb : b ∈ B_sub := hB_top.symm ▸ (trivial : b ∈ (⊤ : Subalgebra A B₀))
      exact hb
    have h_im : ∀ z : TensorProduct A C₁ B₀, Ψ (j_B z) ∈ Set.range j_Pi := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        exact ⟨0, by simp⟩
      | tmul c b =>
        obtain ⟨v, hv⟩ := h_all_b b
        refine ⟨c • v, ?_⟩
        have h_tmul : j_B (c ⊗ₜ[A] b) = (ι c) • ((1 : L) ⊗ₜ[A] b) := by
          simp [j_B, TensorProduct.smul_tmul']
        rw [h_tmul, _root_.map_smul Ψ, ← hv]
        ext j
        simp [hj_Pi_apply, Algebra.smul_def]
      | add x y ihx ihy =>
        obtain ⟨vx, hvx⟩ := ihx
        obtain ⟨vy, hvy⟩ := ihy
        refine ⟨vx + vy, ?_⟩
        rw [map_add, map_add, map_add, hvx, hvy]
    let f₀ : TensorProduct A C₁ B₀ → (Fin N → C₁) := fun z => Classical.choose (h_im z)
    have hf₀ : ∀ z : TensorProduct A C₁ B₀, j_Pi (f₀ z) = Ψ (j_B z) :=
      fun z => Classical.choose_spec (h_im z)
    let Φ_C₁ : TensorProduct A C₁ B₀ →ₐ[C₁] (Fin N → C₁) :=
      { toFun := f₀
        map_one' := h_inj_Pi (by rw [hf₀, map_one, map_one, map_one])
        map_mul' := fun x y => h_inj_Pi (by rw [hf₀, map_mul, map_mul, map_mul, hf₀, hf₀])
        map_zero' := h_inj_Pi (by rw [hf₀, map_zero, map_zero, map_zero])
        map_add' := fun x y => h_inj_Pi (by rw [hf₀, map_add, map_add, map_add, hf₀, hf₀])
        commutes' := fun c => h_inj_Pi (by
          rw [hf₀]
          have hc_alg : j_B (algebraMap C₁ (TensorProduct A C₁ B₀) c) =
              algebraMap L (TensorProduct A L B₀) (ι c) := by
            simp [j_B, Algebra.TensorProduct.algebraMap_apply]
          rw [hc_alg, Ψ.commutes]
          ext j
          simp [hj_Pi_apply]) }
    let e : Fin N → TensorProduct A C₁ B₀ := fun j => Classical.choose (h_idemp j)
    have he : ∀ j : Fin N, j_B (e j) = Ψ.symm (Pi.single j 1) :=
      fun j => Classical.choose_spec (h_idemp j)
    let Θ : (Fin N → C₁) → TensorProduct A C₁ B₀ :=
      fun v => ∑ j : Fin N, algebraMap C₁ (TensorProduct A C₁ B₀) (v j) * e j
    have hΘ : ∀ v : Fin N → C₁, j_B (Θ v) = Ψ.symm (j_Pi v) := by
      intro v
      dsimp only [Θ]
      rw [map_sum]
      have h_term : ∀ j : Fin N,
          j_B (algebraMap C₁ (TensorProduct A C₁ B₀) (v j) * e j) =
            Ψ.symm ((ι (v j)) • Pi.single j (1 : L)) := by
        intro j
        rw [map_mul, he, _root_.map_smul Ψ.symm, Algebra.smul_def]
        simp [j_B, Algebra.TensorProduct.algebraMap_apply]
      rw [Finset.sum_congr rfl (fun j _ => h_term j), ← map_sum]
      congr 1
      ext k
      simp [hj_Pi_apply, Pi.single_apply]
    have h_left : Function.LeftInverse Θ Φ_C₁ := by
      intro z
      apply h_inj_B
      change j_B (Θ (f₀ z)) = j_B z
      rw [hΘ, hf₀, Ψ.symm_apply_apply]
    have h_right : Function.RightInverse Θ Φ_C₁ := by
      intro v
      apply h_inj_Pi
      change j_Pi (f₀ (Θ v)) = j_Pi v
      rw [hf₀, hΘ, Ψ.apply_symm_apply]
    exact ⟨AlgEquiv.ofBijective Φ_C₁ ⟨h_left.injective, h_right.surjective⟩⟩

  
  let K : Type u := FractionRing A
  have h_dec := fun t : Fin r => h_s1 K (TensorProduct A K (B t))
  let m : Fin r → ℕ := fun t => Classical.choose (h_dec t)
  let p : ∀ t : Fin r, Fin (m t) → Polynomial K :=
    fun t => Classical.choose (Classical.choose_spec (h_dec t))
  have hp_spec := fun t : Fin r => Classical.choose_spec (Classical.choose_spec (h_dec t))
  obtain ⟨g_K, hgK_monic, hgK_irr, hgK_sep, hSplits⟩ :=
    h_s2 K m p (fun t i => (hp_spec t).1 i)
  let L : Type u := AdjoinRoot g_K
  let _ : Fact (Irreducible g_K) := ⟨hgK_irr⟩
  let N : Fin r → ℕ := fun t => ∑ i : Fin (m t), (p t i).natDegree
  let Ψ : ∀ t : Fin r, AlgEquiv L (TensorProduct A L (B t)) (Fin (N t) → L) :=
    fun t =>
      (Algebra.TensorProduct.cancelBaseChange A K L L (B t)).symm.trans
        (Classical.choice ((hp_spec t).2 L (hSplits t)))
  have h_fg : ∀ t : Fin r, ∃ S_gen : Finset (B t), Algebra.adjoin A (↑S_gen : Set (B t)) = ⊤ := by
    intro t
    obtain ⟨s_set, hs_fin, hs_adj⟩ := Subalgebra.fg_def.mp (Algebra.FiniteType.out (R := A) (A := B t))
    exact ⟨hs_fin.toFinset, by rwa [Set.Finite.coe_toFinset]⟩
  let S_gen : ∀ t : Fin r, Finset (B t) := fun t => Classical.choose (h_fg t)
  have hS_gen : ∀ t : Fin r, Algebra.adjoin A (↑(S_gen t) : Set (B t)) = ⊤ :=
    fun t => Classical.choose_spec (h_fg t)
  have h_tmul_sum : ∀ (t : Fin r) (z : TensorProduct A L (B t)),
      ∃ (q : ℕ) (l : Fin q → L) (w : Fin q → B t),
        z = ∑ k : Fin q, l k ⊗ₜ[A] w k := by
    intro t z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
    | tmul l₀ b₀ => exact ⟨1, fun _ => l₀, fun _ => b₀, by simp⟩
    | add x y ihx ihy =>
      rcases ihx with ⟨qx, lx, wx, rfl⟩
      rcases ihy with ⟨qy, ly, wy, rfl⟩
      refine ⟨qx + qy, Fin.addCases lx ly, Fin.addCases wx wy, ?_⟩
      rw [Fin.sum_univ_add]
      simp [Fin.addCases_left, Fin.addCases_right]
  have h_id_decomp := fun (t : Fin r) (j : Fin (N t)) =>
    h_tmul_sum t ((Ψ t).symm (Pi.single j 1))
  let q_id : ∀ t : Fin r, Fin (N t) → ℕ :=
    fun t j => Classical.choose (h_id_decomp t j)
  let l_id : ∀ (t : Fin r) (j : Fin (N t)), Fin (q_id t j) → L :=
    fun t j => Classical.choose (Classical.choose_spec (h_id_decomp t j))
  let w_id : ∀ (t : Fin r) (j : Fin (N t)), Fin (q_id t j) → B t :=
    fun t j => Classical.choose (Classical.choose_spec (Classical.choose_spec (h_id_decomp t j)))
  have hw_id : ∀ (t : Fin r) (j : Fin (N t)),
      (Ψ t).symm (Pi.single j 1) = ∑ k : Fin (q_id t j), l_id t j k ⊗ₜ[A] w_id t j k :=
    fun t j => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (h_id_decomp t j)))
  let pb_K := AdjoinRoot.powerBasis' hgK_monic
  let coords : L → Finset K :=
    fun x => Finset.univ.image (fun i : Fin g_K.natDegree => pb_K.basis.repr x i)
  have h_mem_coords : ∀ (x : L) (i : Fin g_K.natDegree), pb_K.basis.repr x i ∈ coords x :=
    fun x i => Finset.mem_image_of_mem _ (Finset.mem_univ i)
  let T_fwd : Finset K :=
    Finset.univ.biUnion (fun t : Fin r =>
      (S_gen t).biUnion (fun b =>
        Finset.univ.biUnion (fun j : Fin (N t) => coords ((Ψ t) ((1 : L) ⊗ₜ[A] b) j))))
  let T_idemp : Finset K :=
    Finset.univ.biUnion (fun t : Fin r =>
      Finset.univ.biUnion (fun j : Fin (N t) =>
        Finset.univ.biUnion (fun k : Fin (q_id t j) => coords (l_id t j k))))
  let T_K : Finset K := T_fwd ∪ T_idemp
  obtain ⟨f₁, hf₁_ne, hDomA₁, ι_A₁, g₀, h_inj_A₁, hT_K, hg₀_monic, hg₀_map, h_bezout₀⟩ :=
    h_s3 T_K g_K hgK_monic hgK_sep
  let A₁ : Type u := Localization.Away f₁
  have : IsDomain A₁ := hDomA₁
  obtain ⟨hDomC₁, hFinC₁, hIntC₁, hEtC₁, hSurjSpec, ι_C₁_ring, h_inj_C₁, h_comm_A₁, h_range_C₁⟩ :=
    h_s4 A₁ K ι_A₁.toRingHom h_inj_A₁ g₀ g_K hg₀_monic hgK_monic hg₀_map h_bezout₀ hgK_irr
  have h_final : ∀ (C₁_ty : Type u) [CommRing C₁_ty] [Algebra A₁ C₁_ty]
      (ι_ring : C₁_ty →+* L),
      Function.Injective ι_ring →
      (∀ a₁ : A₁, ι_ring (algebraMap A₁ C₁_ty a₁) = algebraMap K L (ι_A₁ a₁)) →
      (∀ x : L,
        (∀ i : Fin g_K.natDegree, pb_K.basis.repr x i ∈ Set.range ι_A₁) →
        x ∈ Set.range ι_ring) →
      ∀ t : Fin r,
        letI : Algebra A C₁_ty :=
          RingHom.toAlgebra ((algebraMap A₁ C₁_ty).comp (algebraMap A A₁))
        Nonempty (AlgEquiv C₁_ty (TensorProduct A C₁_ty (B t)) (Fin (N t) → C₁_ty)) := by
    intro C₁_ty _ _ ι_ring h_inj_ring h_comm_ring h_range_ring t
    let _ : Algebra A C₁_ty :=
      RingHom.toAlgebra ((algebraMap A₁ C₁_ty).comp (algebraMap A A₁))
    let ι_C₁ : C₁_ty →ₐ[A] L :=
      { ι_ring with
        commutes' := fun a => by
          change ι_ring (algebraMap A₁ C₁_ty (algebraMap A A₁ a)) = algebraMap A L a
          rw [h_comm_ring, ι_A₁.commutes, IsScalarTower.algebraMap_eq A K L]
          rfl }
    have h_fwd_t : ∀ b ∈ S_gen t, ∀ j : Fin (N t), (Ψ t) ((1 : L) ⊗ₜ[A] b) j ∈ Set.range ι_C₁ := by
      intro b hb j
      change (Ψ t) ((1 : L) ⊗ₜ[A] b) j ∈ Set.range ι_ring
      apply h_range_ring
      intro i
      apply hT_K
      rw [Finset.mem_union]
      left
      simp only [T_fwd, Finset.mem_biUnion, Finset.mem_univ, true_and]
      exact ⟨t, b, hb, j, h_mem_coords _ i⟩
    have h_idemp_t : ∀ j : Fin (N t), (Ψ t).symm (Pi.single j 1) ∈
        Set.range (Algebra.TensorProduct.map ι_C₁ (AlgHom.id A (B t))) := by
      intro j
      have h_coeff : ∀ k : Fin (q_id t j), ∃ c : C₁_ty, ι_C₁ c = l_id t j k := by
        intro k
        change l_id t j k ∈ Set.range ι_ring
        apply h_range_ring
        intro i
        apply hT_K
        rw [Finset.mem_union]
        right
        simp only [T_idemp, Finset.mem_biUnion, Finset.mem_univ, true_and]
        exact ⟨t, j, k, h_mem_coords _ i⟩
      let c_id : Fin (q_id t j) → C₁_ty := fun k => Classical.choose (h_coeff k)
      have hc_id : ∀ k : Fin (q_id t j), ι_C₁ (c_id k) = l_id t j k :=
        fun k => Classical.choose_spec (h_coeff k)
      refine ⟨∑ k : Fin (q_id t j), c_id k ⊗ₜ[A] w_id t j k, ?_⟩
      rw [hw_id t j, map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      change ι_C₁ (c_id k) ⊗ₜ[A] w_id t j k = l_id t j k ⊗ₜ[A] w_id t j k
      rw [hc_id k]
    exact h_s5 (B t) C₁_ty L ι_C₁ h_inj_ring (N t) (Ψ t) (S_gen t) (hS_gen t) h_fwd_t h_idemp_t
  exact ⟨f₁, hf₁_ne, AdjoinRoot g₀, inferInstance, hDomC₁, inferInstance, N,
    hFinC₁, hIntC₁, hEtC₁, hSurjSpec,
    h_final (AdjoinRoot g₀) ι_C₁_ring h_inj_C₁ h_comm_A₁ h_range_C₁⟩

theorem weil_spec_domain_etale_fibre_trivialization_and_shrinking (A : Type u) [CommRing A] [IsDomain A] (r : ℕ)
    (W : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of A)).Etale)
    (_hAff : ∀ t : Fin r,
      AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget
          (AlgebraicGeometry.Spec (CommRingCat.of A))).obj (W t)).left) :
    ∃ (B : Fin r → Type u) (_ : ∀ t : Fin r, CommRing (B t))
      (_ : ∀ t : Fin r, Algebra A (B t)),
      (∀ t : Fin r, Algebra.Etale A (B t)) ∧
      ∀ (f₁ : A), f₁ ≠ 0 →
        ∀ (C₁ : Type u) [CommRing C₁] [IsDomain C₁] [Algebra (Localization.Away f₁) C₁]
          (N : Fin r → ℕ),
          Module.Finite (Localization.Away f₁) C₁ →
          Algebra.IsIntegral (Localization.Away f₁) C₁ →
          Algebra.Etale (Localization.Away f₁) C₁ →
          Function.Surjective (PrimeSpectrum.comap (algebraMap (Localization.Away f₁) C₁)) →
          (∀ t : Fin r,
            letI : Algebra A C₁ :=
              RingHom.toAlgebra ((algebraMap (Localization.Away f₁) C₁).comp
                (algebraMap A (Localization.Away f₁)))
            Nonempty (AlgEquiv C₁ (TensorProduct A C₁ (B t)) (Fin (N t) → C₁))) →
          let S_A := AlgebraicGeometry.Spec (CommRingCat.of A)
          letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
              CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
            fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
          letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
              CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
            fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
              (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
          ∃ (U₁ : S_A.Opens) (_ : Nonempty U₁)
            (V₁ : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral V₁)
            (p₁ : Quiver.Hom V₁ (U₁ : AlgebraicGeometry.Scheme.{u})),
            AlgebraicGeometry.IsFinite p₁ ∧
            AlgebraicGeometry.Etale p₁ ∧
            AlgebraicGeometry.Surjective p₁ ∧
            (∀ t : Fin r,
              let B_map : CategoryTheory.Functor S_A.Etale V₁.Etale :=
                CategoryTheory.MorphismProperty.Over.pullback
                  (@AlgebraicGeometry.Etale) ⊤ (CategoryTheory.CategoryStruct.comp p₁ U₁.ι)
              ∃ e_t : CategoryTheory.Iso
                  ((AlgebraicGeometry.Scheme.Etale.forget V₁).obj (B_map.obj (W t))).left
                  (CategoryTheory.Limits.sigmaObj (fun _ : ULift.{u, 0} (Fin (N t)) => V₁)),
                CategoryTheory.CategoryStruct.comp e_t.inv
                    ((AlgebraicGeometry.Scheme.Etale.forget V₁).obj (B_map.obj (W t))).hom =
                  CategoryTheory.Limits.Sigma.desc
                    (fun _ : ULift.{u, 0} (Fin (N t)) => CategoryTheory.CategoryStruct.id V₁)) ∧
            (∀ (O : V₁.Opens), Nonempty O →
              ∃ (U : S_A.Opens) (_ : Nonempty U) (hUU₁ : U ≤ U₁)
                (V : AlgebraicGeometry.Scheme.{u})
                (j_O : Quiver.Hom V (O : AlgebraicGeometry.Scheme.{u}))
                (p : Quiver.Hom V (U : AlgebraicGeometry.Scheme.{u})),
                AlgebraicGeometry.IsFinite p ∧
                AlgebraicGeometry.Etale p ∧
                AlgebraicGeometry.Surjective p ∧
                CategoryTheory.CategoryStruct.comp j_O
                    (CategoryTheory.CategoryStruct.comp O.ι p₁) =
                  CategoryTheory.CategoryStruct.comp p (S_A.homOfLE hUU₁)) :=
by
  classical
  let S_A := AlgebraicGeometry.Spec (CommRingCat.of A)
  let X : Fin r → AlgebraicGeometry.Scheme.{u} := fun t => (W t).left
  have hXAff : ∀ t : Fin r, AlgebraicGeometry.IsAffine (X t) := _hAff
  let w : ∀ t : Fin r, X t ⟶ S_A := fun t => (W t).hom
  have hwEt : ∀ t : Fin r, AlgebraicGeometry.Etale (w t) := fun t => (W t).prop
  let B : Fin r → Type u := fun t => ↑((X t).presheaf.obj (Opposite.op ⊤))
  let instRingB : ∀ t : Fin r, CommRing (B t) := fun _ => inferInstance
  let φ_alg : ∀ t : Fin r, CommRingCat.of A ⟶ (X t).presheaf.obj (Opposite.op ⊤) :=
    fun t => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ (w t).appTop
  let instAlgB : ∀ t : Fin r, Algebra A (B t) :=
    fun t => RingHom.toAlgebra (CommRingCat.Hom.hom (φ_alg t))
  let _ := instAlgB
  have hφ_eq : ∀ t : Fin r,
      (CommRingCat.ofHom (algebraMap A (B t)) : CommRingCat.of A ⟶ CommRingCat.of (B t)) =
        φ_alg t := by
    intro t
    have halg : algebraMap A (B t) = CommRingCat.Hom.hom (φ_alg t) := rfl
    rw [halg]
    exact CommRingCat.ofHom_hom (φ_alg t)
  have hw_eq : ∀ t : Fin r,
      w t =
        (@AlgebraicGeometry.Scheme.isoSpec (X t) (hXAff t)).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B t))) := by
    intro t
    have : AlgebraicGeometry.IsAffine (X t) := hXAff t
    symm
    calc
      (X t).isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B t)))
        = (X t).isoSpec.hom ≫ AlgebraicGeometry.Spec.map (φ_alg t) := by rw [hφ_eq t]
      _ = (X t).isoSpec.hom ≫
            (AlgebraicGeometry.Spec.map (w t).appTop ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv) := by
          dsimp [φ_alg]
          rw [AlgebraicGeometry.Spec.map_comp]
      _ = ((X t).isoSpec.hom ≫ AlgebraicGeometry.Spec.map (w t).appTop) ≫
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv := by
          rw [CategoryTheory.Category.assoc]
      _ = (w t ≫ S_A.isoSpec.hom) ≫
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv := by
          rw [AlgebraicGeometry.Scheme.isoSpec_hom_naturality (w t)]
      _ = w t ≫
            (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv) := by
          dsimp [S_A]
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoSpec_Spec_hom]
      _ = w t ≫
            AlgebraicGeometry.Spec.map
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom) := by
          rw [← AlgebraicGeometry.Spec.map_comp]
      _ = w t := by
          rw [CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id,
            CategoryTheory.Category.comp_id]
  have hEtB : ∀ t : Fin r, Algebra.Etale A (B t) := by
    intro t
    have : AlgebraicGeometry.IsAffine (X t) := hXAff t
    have : AlgebraicGeometry.Etale (w t) := hwEt t
    have hSpec_eq :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B t))) =
          (X t).isoSpec.inv ≫ w t := by
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B t)))
          = ((X t).isoSpec.inv ≫ (X t).isoSpec.hom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B t))) := by
            rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = (X t).isoSpec.inv ≫ w t := by
            rw [CategoryTheory.Category.assoc, ← hw_eq t]
    have hEtSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B t)))) := by
      rw [hSpec_eq]
      infer_instance
    exact RingHom.etale_algebraMap.mp
      ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEtSpec)
  refine ⟨B, instRingB, instAlgB, hEtB, ?_⟩
  intro f₁ hf₁ C₁ _ _ _ N hFinC₁ hIntC₁ hEtC₁ hSurjC₁ hSplit
  let _ : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let A₁ := Localization.Away f₁
  have hSub_nzd : Submonoid.powers f₁ ≤ nonZeroDivisors A :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf₁)
  have : IsDomain A₁ :=
    IsLocalization.isDomain_localization (M := Submonoid.powers f₁) hSub_nzd
  let S_A₁ := AlgebraicGeometry.Spec (CommRingCat.of A₁)
  let φ₁ : S_A₁ ⟶ S_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A A₁))
  let U₁ : S_A.Opens := φ₁.opensRange
  let e_U₁ : S_A₁ ≅ (U₁ : AlgebraicGeometry.Scheme.{u}) := φ₁.isoOpensRange
  have hU₁_ne : Nonempty U₁ :=
    ⟨⟨φ₁ (⊥ : PrimeSpectrum A₁), ⟨(⊥ : PrimeSpectrum A₁), rfl⟩⟩⟩
  let V₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₁)
  have hIntV₁ : AlgebraicGeometry.IsIntegral V₁ :=
    (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of C₁)).mpr inferInstance
  let π₁ : V₁ ⟶ S_A₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ C₁))
  have : AlgebraicGeometry.IsFinite π₁ :=
    (AlgebraicGeometry.IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr hFinC₁)
  have : AlgebraicGeometry.Etale π₁ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr hEtC₁)
  have : AlgebraicGeometry.Surjective π₁ := by
    rw [AlgebraicGeometry.surjective_iff]
    intro y
    obtain ⟨x, hx⟩ := hSurjC₁ y
    exact ⟨x, (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap A₁ C₁)) x).trans hx⟩
  let p₁ : V₁ ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}) := π₁ ≫ e_U₁.hom
  have hFin_p₁ : AlgebraicGeometry.IsFinite p₁ := inferInstance
  have hEt_p₁ : AlgebraicGeometry.Etale p₁ := inferInstance
  have hSurj_p₁ : AlgebraicGeometry.Surjective p₁ := inferInstance
  have hp₁_φ₁ : p₁ ≫ U₁.ι = π₁ ≫ φ₁ := by
    dsimp [p₁, e_U₁, U₁]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι]
  let _ : Algebra A C₁ :=
    RingHom.toAlgebra ((algebraMap A₁ C₁).comp (algebraMap A A₁))
  have hp₁_ι : p₁ ≫ U₁.ι = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C₁)) := by
    rw [hp₁_φ₁]
    dsimp [π₁, φ₁]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
  refine ⟨U₁, hU₁_ne, V₁, hIntV₁, p₁, hFin_p₁, hEt_p₁, hSurj_p₁, ?_, ?_⟩
  · intro t
    have : AlgebraicGeometry.IsAffine (X t) := hXAff t
    let g₁ : V₁ ⟶ S_A := p₁ ≫ U₁.ι
    let g_C₁ : V₁ ⟶ S_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C₁))
    let g_Bt : AlgebraicGeometry.Spec (CommRingCat.of (B t)) ⟶ S_A :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (B t)))
    let ι_t := ULift.{u, 0} (Fin (N t))
    let i₁ : CategoryTheory.Limits.pullback (w t) g₁ ≅ CategoryTheory.Limits.pullback g₁ (w t) :=
      CategoryTheory.Limits.pullbackSymmetry (w t) g₁
    have h₁ : i₁.inv ≫ CategoryTheory.Limits.pullback.snd (w t) g₁ =
        CategoryTheory.Limits.pullback.fst g₁ (w t) :=
      CategoryTheory.Limits.pullbackSymmetry_inv_comp_snd (w t) g₁
    let hom₂ : CategoryTheory.Limits.pullback g₁ (w t) ⟶
        CategoryTheory.Limits.pullback g_C₁ g_Bt :=
      CategoryTheory.Limits.pullback.map g₁ (w t) g_C₁ g_Bt
        (𝟙 V₁) (X t).isoSpec.hom (𝟙 S_A)
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]; exact hp₁_ι)
        (by rw [CategoryTheory.Category.comp_id, ← hw_eq t])
    have : CategoryTheory.IsIso hom₂ := inferInstance
    let i₂ : CategoryTheory.Limits.pullback g₁ (w t) ≅
        CategoryTheory.Limits.pullback g_C₁ g_Bt :=
      CategoryTheory.asIso hom₂
    have h₂ : i₂.inv ≫ CategoryTheory.Limits.pullback.fst g₁ (w t) =
        CategoryTheory.Limits.pullback.fst g_C₁ g_Bt := by
      have h₂_hom : i₂.hom ≫ CategoryTheory.Limits.pullback.fst g_C₁ g_Bt =
          CategoryTheory.Limits.pullback.fst g₁ (w t) := by
        dsimp [i₂, hom₂, CategoryTheory.Limits.pullback.map]
        rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
      calc
        i₂.inv ≫ CategoryTheory.Limits.pullback.fst g₁ (w t)
          = i₂.inv ≫ (i₂.hom ≫ CategoryTheory.Limits.pullback.fst g_C₁ g_Bt) := by rw [h₂_hom]
        _ = (i₂.inv ≫ i₂.hom) ≫ CategoryTheory.Limits.pullback.fst g_C₁ g_Bt := by
          rw [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst g_C₁ g_Bt := by
          rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
    let i₃ : CategoryTheory.Limits.pullback g_C₁ g_Bt ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A C₁ (B t))) :=
      AlgebraicGeometry.pullbackSpecIso A C₁ (B t)
    have h₃ : i₃.inv ≫ CategoryTheory.Limits.pullback.fst g_C₁ g_Bt =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap C₁ (TensorProduct A C₁ (B t)))) :=
      AlgebraicGeometry.pullbackSpecIso_inv_fst' A C₁ (B t)
    obtain ⟨φ_t⟩ := hSplit t
    let ψ_t : AlgEquiv C₁ (TensorProduct A C₁ (B t)) (ι_t → C₁) :=
      φ_t.trans (AlgEquiv.piCongrLeft' C₁ (fun _ : Fin (N t) => C₁) Equiv.ulift.{u, 0}.symm)
    let i₄ : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A C₁ (B t))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (ι_t → C₁)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_t.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_t.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have heq : ψ_t.symm.toRingHom.comp ψ_t.toRingHom = RingHom.id _ :=
            RingHom.ext fun x => ψ_t.symm_apply_apply x
          rw [heq]
          exact AlgebraicGeometry.Spec.map_id _
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have heq : ψ_t.toRingHom.comp ψ_t.symm.toRingHom = RingHom.id _ :=
            RingHom.ext fun x => ψ_t.apply_symm_apply x
          rw [heq]
          exact AlgebraicGeometry.Spec.map_id _ }
    have h₄ : i₄.inv ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap C₁ (TensorProduct A C₁ (B t)))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₁ (ι_t → C₁))) := by
      dsimp [i₄]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      exact RingHom.ext fun c => ψ_t.commutes c
    let σ_t := AlgebraicGeometry.sigmaSpec (fun _ : ι_t => CommRingCat.of C₁)
    let i₅ : AlgebraicGeometry.Spec (CommRingCat.of (ι_t → C₁)) ≅
        CategoryTheory.Limits.sigmaObj (fun _ : ι_t => V₁) :=
      (CategoryTheory.asIso σ_t).symm
    have h₅ : i₅.inv ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₁ (ι_t → C₁))) =
        CategoryTheory.Limits.Sigma.desc (fun _ : ι_t => 𝟙 V₁) := by
      apply CategoryTheory.Limits.Sigma.hom_ext
      intro k
      rw [CategoryTheory.Limits.Sigma.ι_comp_desc]
      dsimp [i₅, σ_t, V₁]
      rw [AlgebraicGeometry.ι_sigmaSpec_assoc (fun _ : ι_t => CommRingCat.of C₁) k,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have heval : (Pi.evalRingHom (fun _ : ι_t => C₁) k).comp (algebraMap C₁ (ι_t → C₁)) =
          RingHom.id C₁ :=
        RingHom.ext fun _ => rfl
      rw [heval]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of C₁)
    refine ⟨i₁ ≪≫ i₂ ≪≫ i₃ ≪≫ i₄ ≪≫ i₅, ?_⟩
    change (i₅.inv ≫ i₄.inv ≫ i₃.inv ≫ i₂.inv ≫ i₁.inv) ≫
        CategoryTheory.Limits.pullback.snd (w t) g₁ =
      CategoryTheory.Limits.Sigma.desc (fun _ : ι_t => 𝟙 V₁)
    simp only [CategoryTheory.Category.assoc]
    rw [h₁, h₂, h₃, h₄, h₅]
  · intro O hO
    obtain ⟨⟨x_O, hx_O⟩⟩ := hO
    have hbot_spec : (⊥ : PrimeSpectrum C₁) ⤳ x_O :=
      (PrimeSpectrum.le_iff_specializes (⊥ : PrimeSpectrum C₁) x_O).mp bot_le
    have hbot_O : (⊥ : PrimeSpectrum C₁) ∈ O :=
      hbot_spec.mem_open O.isOpen hx_O
    let Z₁ : Set ↥V₁ := (O : Set ↥V₁)ᶜ
    let F₁ : Set (PrimeSpectrum A₁) := PrimeSpectrum.comap (algebraMap A₁ C₁) '' Z₁
    have hClosed_F₁ : IsClosed F₁ :=
      PrimeSpectrum.isClosedMap_comap_of_isIntegral (algebraMap A₁ C₁)
        (algebraMap_isIntegral_iff.mpr hIntC₁) Z₁ O.isOpen.isClosed_compl
    let W₀ : S_A₁.Opens := ⟨F₁ᶜ, hClosed_F₁.isOpen_compl⟩
    have hbot_W₀ : (⊥ : PrimeSpectrum A₁) ∈ W₀ := by
      intro hmem
      obtain ⟨q, hqZ₁, hq_comap⟩ := hmem
      have hunder : Ideal.under A₁ q.asIdeal = ⊥ := congrArg PrimeSpectrum.asIdeal hq_comap
      have : Algebra.IsIntegral A₁ C₁ := hIntC₁
      have hq_bot : q.asIdeal = ⊥ := by
        by_contra hq_ne
        exact Ideal.under_ne_bot A₁ hq_ne hunder
      have hq_eq : q = (⊥ : PrimeSpectrum C₁) := PrimeSpectrum.ext hq_bot
      exact hqZ₁ (hq_eq ▸ hbot_O)
    let u_W : (W₀ : AlgebraicGeometry.Scheme.{u}) ⟶ S_A := W₀.ι ≫ φ₁
    let U : S_A.Opens := u_W.opensRange
    have hU_ne : Nonempty U :=
      ⟨⟨u_W ⟨(⊥ : PrimeSpectrum A₁), hbot_W₀⟩, ⟨⟨(⊥ : PrimeSpectrum A₁), hbot_W₀⟩, rfl⟩⟩⟩
    have hUU₁ : U ≤ U₁ := by
      intro y hy
      obtain ⟨w₀, rfl⟩ := hy
      change (W₀.ι ≫ φ₁) w₀ ∈ Set.range ⇑φ₁
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact ⟨W₀.ι w₀, rfl⟩
    let V : AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.Limits.pullback p₁ (S_A.homOfLE hUU₁)
    let p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.Limits.pullback.snd p₁ (S_A.homOfLE hUU₁)
    let fst_V : V ⟶ V₁ :=
      CategoryTheory.Limits.pullback.fst p₁ (S_A.homOfLE hUU₁)
    have hFin_p : AlgebraicGeometry.IsFinite p := inferInstance
    have hEt_p : AlgebraicGeometry.Etale p := inferInstance
    have hSurj_p : AlgebraicGeometry.Surjective p := inferInstance
    have h_sub : Set.range ⇑fst_V ⊆ Set.range ⇑O.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨v, rfl⟩
      have hpath : fst_V ≫ (π₁ ≫ φ₁) = p ≫ U.ι := by
        calc
          fst_V ≫ (π₁ ≫ φ₁) = (fst_V ≫ p₁) ≫ U₁.ι := by
            rw [← hp₁_φ₁, ← CategoryTheory.Category.assoc]
          _ = (p ≫ S_A.homOfLE hUU₁) ≫ U₁.ι := by
            rw [CategoryTheory.Limits.pullback.condition]
          _ = p ≫ U.ι := by
            rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      have hpt : φ₁ (π₁ (fst_V v)) = U.ι (p v) := by
        have h1 := congrArg (fun f : V ⟶ S_A => f v) hpath
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using h1
      have hmemU : U.ι (p v) ∈ (U : Set ↥S_A) := (p v).2
      rw [← hpt] at hmemU
      obtain ⟨w₀, hw₀⟩ := hmemU
      change (W₀.ι ≫ φ₁) w₀ = φ₁ (π₁ (fst_V v)) at hw₀
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at hw₀
      have hπ_eq : W₀.ι w₀ = π₁ (fst_V v) := φ₁.isOpenEmbedding.injective hw₀
      have hmemW₀ : π₁ (fst_V v) ∈ (W₀ : Set ↥S_A₁) := by
        rw [← hπ_eq]
        exact w₀.2
      by_contra hnotO
      apply hmemW₀
      have hπ_app : π₁ (fst_V v) = PrimeSpectrum.comap (algebraMap A₁ C₁) (fst_V v) :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap A₁ C₁)) (fst_V v)
      rw [hπ_app]
      exact ⟨fst_V v, hnotO, rfl⟩
    let j_O : V ⟶ (O : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift O.ι fst_V h_sub
    have hcomm : j_O ≫ (O.ι ≫ p₁) = p ≫ S_A.homOfLE hUU₁ := by
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι fst_V h_sub]
      exact CategoryTheory.Limits.pullback.condition
    exact ⟨U, hU_ne, hUU₁, V, j_O, p, hFin_p, hEt_p, hSurj_p, hcomm⟩

theorem weil_etale_integral_constantSheaf_subobject_generic_open (V₁ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral V₁]
    (m : ℕ) (_hm : 1 ≤ m)
    (M : ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) [Finite M] :
    let R := ULift.{u, 0} (ZMod m)
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
