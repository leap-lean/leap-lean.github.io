            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B))) →
          (AlgebraicGeometry.SmoothOfRelativeDimension d f_VB ↔
            ∀ i : 𝒰.I₀,
              letI : Algebra R ↑(D_i i) := algRDi i
              RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
                (algebraMap B (TensorProduct R B ↑(D_i i)))) := by
      intro B _ _ V_B q_VB f_VB hpB
      let W_B : 𝒰.I₀ → V_B.Opens := fun i => (TopologicalSpace.Opens.map q_VB.base).obj (U i)
      have hWB_cov : (⨆ i : 𝒰.I₀, W_B i) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        rw [TopologicalSpace.Opens.mem_iSup]
        have hx : q_VB.base x ∈ (⊤ : V.Opens) := trivial
        rw [← hU_cov, TopologicalSpace.Opens.mem_iSup] at hx
        exact hx
      have hLocal := AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_iSup_eq_top
        (P := P_sm) (f := f_VB) W_B hWB_cov
      change P_sm f_VB ↔ _
      rw [hLocal]
      refine forall_congr' fun i => ?_
      letI : Algebra R ↑(D_i i) := algRDi i
      have hθ_alg : CommRingCat.ofHom (algebraMap R ↑(D_i i)) = θ_i i := rfl
      have hp_res : CategoryTheory.IsPullback (q_VB ∣_ U i) (W_B i).ι (U i).ι q_VB :=
        AlgebraicGeometry.isPullback_morphismRestrict q_VB (U i)
      have hp_tot : CategoryTheory.IsPullback (q_VB ∣_ U i) ((W_B i).ι ≫ f_VB)
          ((U i).ι ≫ f_V) (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B))) :=
        hp_res.paste_vert hpB
      have hp_left : CategoryTheory.IsPullback
          ((q_VB ∣_ U i) ≫ (hU_aff i).isoSpec.hom) ((W_B i).ι ≫ f_VB)
          (AlgebraicGeometry.Spec.map (θ_i i))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B))) := by
        refine CategoryTheory.IsPullback.of_iso hp_tot (CategoryTheory.Iso.refl _)
          (hU_aff i).isoSpec (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ ?_ ?_
        · simp
        · simp
        · simp [hθ_map i]
        · simp
      have hPush : CategoryTheory.IsPushout (CommRingCat.ofHom (algebraMap R B)) (θ_i i)
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := B) (B := ↑(D_i i))))
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := R) (A := B) (B := ↑(D_i i))).toRingHom) := by
        rw [← hθ_alg]
        exact CommRingCat.isPushout_tensorProduct R B ↑(D_i i)
      have hp_right : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight (R := R) (A := B) (B := ↑(D_i i))).toRingHom))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := B) (B := ↑(D_i i)))))
          (AlgebraicGeometry.Spec.map (θ_i i))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B))) :=
        (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush).flip
      let e_WB : (W_B i : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R B ↑(D_i i))) :=
        hp_left.isoIsPullback _ _ hp_right
      have he_snd : e_WB.inv ≫ (W_B i).ι ≫ f_VB =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (TensorProduct R B ↑(D_i i)))) := by
        rw [CategoryTheory.Iso.inv_comp_eq]
        exact (hp_left.isoIsPullback_hom_snd _ _ hp_right).symm
      have h_iso_iff : P_sm (e_WB.inv ≫ ((W_B i).ι ≫ f_VB)) ↔ P_sm ((W_B i).ι ≫ f_VB) :=
        CategoryTheory.MorphismProperty.cancel_left_of_respectsIso P_sm e_WB.inv ((W_B i).ι ≫ f_VB)
      rw [← h_iso_iff, he_snd]
      exact AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_sm)
    have hK_charts := (hPullbackIff K q_V f_VK hpV).mp hSm_K
    have h_spread_each : ∀ i : 𝒰.I₀,
        ∃ (h_i : R), h_i ≠ 0 ∧
          ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
            IsUnit (φ_RS h_i) →
            letI : Algebra R S := φ_RS.toAlgebra
            letI : Algebra R ↑(D_i i) := algRDi i
            RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
              (algebraMap S (TensorProduct R S ↑(D_i i))) := by
      intro i
      letI : Algebra R ↑(D_i i) := algRDi i
      haveI : Algebra.FiniteType R ↑(D_i i) := hFT_Di i
      exact hChartSpread ↑(D_i i) (hK_charts i)
    choose h_i hh_i_ne hh_i_spec using h_spread_each
    let h_sm : R := ∏ i : 𝒰.I₀, h_i i
    have hh_sm_ne : h_sm ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hh_i_ne i
    refine ⟨h_sm, hh_sm_ne, ?_⟩
    intro S _ φ_RS hUnit_hsm V_S q_VS f_VS hpVS
    letI : Algebra R S := φ_RS.toAlgebra
    refine (hPullbackIff S q_VS f_VS hpVS).mpr fun i => ?_
    have hu_i : IsUnit (φ_RS (h_i i)) :=
      isUnit_of_dvd_unit (map_dvd φ_RS (Finset.dvd_prod_of_mem _ (Finset.mem_univ i))) hUnit_hsm
    exact hh_i_spec i S φ_RS hu_i
  intro S_init ξ₁
  have hNoethA₁ : IsNoetherianRing A₁ := Algebra.FiniteType.isNoetherianRing k A₁
  rcases hProj with ⟨N, ι_K₁, hCl_K₁⟩
  have : AlgebraicGeometry.IsClosedImmersion ι_K₁.left := hCl_K₁
  have hι_hom : ι_K₁.left ≫ (weilProjectiveSpaceOver K₁ N).hom = V_K₁.hom :=
    CategoryTheory.Over.w ι_K₁
  let P_k := weilProjectiveSpaceOver k N
  let P_K₁ := weilProjectiveSpaceOver K₁ N
  let φ_kK₁ : k →+* K₁ := (algebraMap A₁ K₁).comp (algebraMap k A₁)
  obtain ⟨hProp_Pk, hProjBC⟩ := hPillar1 k N
  have : AlgebraicGeometry.IsProper P_k.hom := hProp_Pk
  obtain ⟨π, sqProj⟩ := hProjBC K₁ φ_kK₁
  let P_A₁ := CategoryTheory.Limits.pullback S_init.hom P_k.hom
  let fst_A₁ : P_A₁ ⟶ S_init.left := CategoryTheory.Limits.pullback.fst S_init.hom P_k.hom
  let snd_A₁ : P_A₁ ⟶ P_k.left := CategoryTheory.Limits.pullback.snd S_init.hom P_k.hom
  have hξ_S : ξ₁ ≫ S_init.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_kK₁) := by
    dsimp [ξ₁, S_init, φ_kK₁]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
  let q_P : P_K₁.left ⟶ P_A₁ :=
    CategoryTheory.Limits.pullback.lift (P_K₁.hom ≫ ξ₁) π
      (by rw [CategoryTheory.Category.assoc, hξ_S]; exact sqProj.w.symm)
  have hpP : CategoryTheory.IsPullback q_P P_K₁.hom fst_A₁ ξ₁ := by
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback S_init.hom P_k.hom).flip
    have h_snd : q_P ≫ snd_A₁ = π := CategoryTheory.Limits.pullback.lift_snd _ _ _
    rw [h_snd, hξ_S]
    exact sqProj
  let V_init := AlgebraicGeometry.Scheme.Hom.image (ι_K₁.left ≫ q_P)
  let ι_init : V_init ⟶ P_A₁ := AlgebraicGeometry.Scheme.Hom.imageι (ι_K₁.left ≫ q_P)
  let f_V_init : V_init ⟶ S_init.left := ι_init ≫ fst_A₁
  have : AlgebraicGeometry.IsProper fst_A₁ := inferInstance
  have : AlgebraicGeometry.IsProper f_V_init := inferInstance
  obtain ⟨q_V, hpV_sub⟩ :=
    hPillar2 A₁ K₁ P_A₁ P_K₁.left fst_A₁ q_P P_K₁.hom hpP V_K₁.left ι_K₁.left
  have hpV : CategoryTheory.IsPullback q_V V_K₁.hom f_V_init ξ₁ := by
    have hp := hpV_sub.paste_vert hpP
    rwa [hι_hom] at hp
  obtain ⟨h_sm, hh_sm_ne, hSm_transfer⟩ :=
    hPillar3 A₁ K₁ d V_init V_K₁.left f_V_init q_V V_K₁.hom hpV hSm
  refine ⟨N, V_init, ι_init, q_V, h_sm, hh_sm_ne, inferInstance, hpV, ?_⟩
  intro h hh_ne hdvd j_h Z₁ V_h q_Vh f_Vh hpVh
  let S_h := Localization.Away h
  have hUnit_hsm : IsUnit (algebraMap A₁ S_h h_sm) :=
    isUnit_of_dvd_unit (map_dvd (algebraMap A₁ S_h) hdvd)
      (IsLocalization.Away.algebraMap_isUnit h)
  have hSm_Vh : AlgebraicGeometry.SmoothOfRelativeDimension d f_Vh :=
    hSm_transfer S_h (algebraMap A₁ S_h) hUnit_hsm V_h q_Vh f_Vh hpVh
  refine ⟨hSm_Vh, ?_, ?_⟩
  · let P_Z₁ := CategoryTheory.Limits.pullback Z₁.hom P_k.hom
    let fst_Z₁ : P_Z₁ ⟶ Z₁.left := CategoryTheory.Limits.pullback.fst Z₁.hom P_k.hom
    let snd_Z₁ : P_Z₁ ⟶ P_k.left := CategoryTheory.Limits.pullback.snd Z₁.hom P_k.hom
    let q_Ph : P_Z₁ ⟶ P_A₁ :=
      CategoryTheory.Limits.pullback.lift (fst_Z₁ ≫ j_h) snd_Z₁
        (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    have hpP_h : CategoryTheory.IsPullback q_Ph fst_Z₁ fst_A₁ j_h := by
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback S_init.hom P_k.hom).flip
      have h_snd : q_Ph ≫ snd_A₁ = snd_Z₁ := CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [h_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback Z₁.hom P_k.hom).flip
    let ι_h : V_h ⟶ P_Z₁ :=
      hpP_h.lift (q_Vh ≫ ι_init) f_Vh (by rw [CategoryTheory.Category.assoc]; exact hpVh.w)
    have hι_h_fst : ι_h ≫ fst_Z₁ = f_Vh := hpP_h.lift_snd _ _ _
    have hp_ιh : CategoryTheory.IsPullback ι_h q_Vh q_Ph ι_init := by
      refine CategoryTheory.IsPullback.of_right ?_ (hpP_h.lift_fst _ _ _) hpP_h.flip
      rw [hι_h_fst]
      exact hpVh.flip
    have hCl_ιh : AlgebraicGeometry.IsClosedImmersion ι_h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_ιh.flip
        (inferInstance : AlgebraicGeometry.IsClosedImmersion ι_init)
    exact ⟨ι_h, hCl_ιh, hι_h_fst⟩
  · have hh_K₁_ne : algebraMap A₁ K₁ h ≠ 0 :=
      (map_ne_zero_iff (algebraMap A₁ K₁) (IsFractionRing.injective A₁ K₁)).mpr hh_ne
    have hUnit_h_K₁ : IsUnit (algebraMap A₁ K₁ h) := IsUnit.mk0 _ hh_K₁_ne
    let ℓ_h : S_h →+* K₁ := IsLocalization.Away.lift h hUnit_h_K₁
    have hℓ_eq : ∀ a : A₁, ℓ_h (algebraMap A₁ S_h a) = algebraMap A₁ K₁ a :=
      fun a => IsLocalization.Away.lift_eq h hUnit_h_K₁ a
    have hℓ_inj : Function.Injective ℓ_h := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      obtain ⟨⟨a, d_pow⟩, had⟩ := IsLocalization.surj (Submonoid.powers h) r
      have ha_K₁ : algebraMap A₁ K₁ a = 0 := by
        rw [← hℓ_eq a, ← had, map_mul, hr, zero_mul]
      have ha0 : a = 0 :=
        (map_eq_zero_iff (algebraMap A₁ K₁) (IsFractionRing.injective A₁ K₁)).mp ha_K₁
      rw [ha0, map_zero] at had
      exact (IsLocalization.map_units S_h d_pow).mul_left_eq_zero.mp had
    let ψ : S_h →+* Ω₀ := τ.comp ℓ_h
    have hψ_inj : Function.Injective ψ := τ.injective.comp hℓ_inj
    let η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z₁.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
    have hDense : DenseRange η.base := by
      rw [denseRange_iff_closure_range]
      change closure (Set.range (PrimeSpectrum.comap ψ)) = Set.univ
      have hker : RingHom.ker ψ = ⊥ := by
        ext x
        simp only [RingHom.mem_ker, Ideal.mem_bot]
        exact map_eq_zero_iff ψ hψ_inj
      rw [PrimeSpectrum.closure_range_comap, hker, PrimeSpectrum.zeroLocus_bot]
    have hη_fac : η ≫ j_h = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ) ≫ ξ₁ := by
      dsimp [η, j_h, ξ₁, ψ]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      ext a
      exact congrArg τ (hℓ_eq a)
    let s_τ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ)
    have hp_left : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_Vh η ≫ q_Vh)
        (CategoryTheory.Limits.pullback.snd f_Vh η)
        f_V_init (s_τ ≫ ξ₁) := by
      rw [← hη_fac]
      exact (CategoryTheory.IsPullback.of_hasPullback f_Vh η).paste_horiz hpVh
    have hp_right : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst V_K₁.hom s_τ ≫ q_V)
        (CategoryTheory.Limits.pullback.snd V_K₁.hom s_τ)
        f_V_init (s_τ ≫ ξ₁) :=
      (CategoryTheory.IsPullback.of_hasPullback V_K₁.hom s_τ).paste_horiz hpV
    let e_int : CategoryTheory.Limits.pullback f_Vh η ≅
        CategoryTheory.Limits.pullback V_K₁.hom s_τ :=
      hp_left.isoIsPullback _ _ hp_right
    have : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback V_K₁.hom s_τ) := hGeomInt
    have hne_0 : Nonempty ↥(CategoryTheory.Limits.pullback V_K₁.hom s_τ) := inferInstance
    have : Nonempty ↥(CategoryTheory.Limits.pullback f_Vh η) :=
      ⟨e_int.inv.base (Classical.choice hne_0)⟩
    have hInt_Vh : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f_Vh η) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion e_int.hom
    exact ⟨Ω₀, inferInstance, inferInstance, η, hDense, hInt_Vh⟩

theorem weil_spread_out_proper_surjective_and_conductor_partition (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
    (Y_R Y_K : AlgebraicGeometry.Scheme.{u})
    (fY : Y_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    [AlgebraicGeometry.IsProper fY]
    (q_Y : Y_K ⟶ Y_R) (f_YK : Y_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hpY : CategoryTheory.IsPullback q_Y f_YK fY
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))))
    (s : ℕ)
    (C_R C_K : Fin s → AlgebraicGeometry.Scheme.{u})
    (fC : ∀ j : Fin s, C_R j ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    [∀ j : Fin s, AlgebraicGeometry.IsProper (fC j)]
    (q_C : ∀ j : Fin s, C_K j ⟶ C_R j)
    (f_CK : ∀ j : Fin s, C_K j ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hpC : ∀ j : Fin s, CategoryTheory.IsPullback (q_C j) (f_CK j) (fC j)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))))
    (μ_R : ∀ j : Fin s, C_R j ⟶ Y_R)
    (hμR_comp : ∀ j : Fin s, μ_R j ≫ fY = fC j)
    (μ_K : ∀ j : Fin s, C_K j ⟶ Y_K)
    (hμK_comm : ∀ j : Fin s, μ_K j ≫ q_Y = q_C j ≫ μ_R j)
    (hμK_comp : ∀ j : Fin s, μ_K j ≫ f_YK = f_CK j)
    (U_K : Fin s → Y_K.Opens)
    (hUniv_K : (⋃ j : Fin s, Set.range (μ_K j).base) = Set.univ)
    (hFin_badK : ((⋃ j : Fin s, (U_K j : Set Y_K))ᶜ).Finite)
    (hDisj_UK : ∀ i j : Fin s, i ≠ j → Disjoint (U_K i) (U_K j))
    (hEmpty_preK : ∀ i j : Fin s, i ≠ j →
      ((μ_K j).base) ⁻¹' (U_K i : Set Y_K) = ∅) :
    let ξ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))
    ∃ (W_R : AlgebraicGeometry.Scheme.{u})
      (i_WR : W_R ⟶ Y_R)
      (U_R : Fin s → Y_R.Opens)
      (h₄ : R) (_ : h₄ ≠ 0),
      AlgebraicGeometry.IsClosedImmersion i_WR ∧
      ((i_WR ≫ fY).base ⁻¹' (Set.range ξ.base)).Finite ∧
      (∀ j : Fin s, (TopologicalSpace.Opens.map q_Y.base).obj (U_R j) = U_K j) ∧
      ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
        IsUnit (φ_RS h₄) →
        ∀ (Y_S : AlgebraicGeometry.Scheme.{u})
          (q_YS : Y_S ⟶ Y_R) (f_YS : Y_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
          (C_S : Fin s → AlgebraicGeometry.Scheme.{u})
          (q_CS : ∀ j : Fin s, C_S j ⟶ C_R j)
          (f_CS : ∀ j : Fin s, C_S j ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
          (μ_S : ∀ j : Fin s, C_S j ⟶ Y_S),
          CategoryTheory.IsPullback q_YS f_YS fY
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
          (∀ j : Fin s, CategoryTheory.IsPullback (q_CS j) (f_CS j) (fC j)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS))) →
          (∀ j : Fin s, μ_S j ≫ q_YS = q_CS j ≫ μ_R j) →
          (∀ j : Fin s, μ_S j ≫ f_YS = f_CS j) →
          let W_S := CategoryTheory.Limits.pullback q_YS i_WR
          let i_WS : W_S ⟶ Y_S := CategoryTheory.Limits.pullback.fst q_YS i_WR
          let U_S : Fin s → Y_S.Opens :=
            fun j => (TopologicalSpace.Opens.map q_YS.base).obj (U_R j)
          AlgebraicGeometry.IsClosedImmersion i_WS ∧
          (⋃ j : Fin s, Set.range (μ_S j).base) = Set.univ ∧
          (∀ j : Fin s, (U_S j : Set Y_S) ⊆ (Set.range i_WS.base)ᶜ) ∧
          ((Set.range i_WS.base)ᶜ : Set Y_S) ⊆ (⋃ j : Fin s, (U_S j : Set Y_S)) ∧
          (∀ i j : Fin s, i ≠ j → Disjoint (U_S i) (U_S j)) ∧
          (∀ i j : Fin s, i ≠ j → ((μ_S j).base) ⁻¹' (U_S i : Set Y_S) = ∅) :=
by
  classical
  have _ := hDisj_UK
  intro ξ
  let : Unique ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := PrimeSpectrum.instUnique
  let η_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := default
  let η_R : ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) := ξ.base η_K
  have hRange_ξ : Set.range ξ.base = {η_R} := by
    ext p
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨z, rfl⟩
      rw [Subsingleton.elim z η_K]
    · rintro rfl
      exact ⟨η_K, rfl⟩
  have hηR_ideal : (η_R : PrimeSpectrum R).asIdeal = ⊥ := by
    ext r
    simp only [Submodule.mem_bot]
    constructor
    · intro hr
      have h_eq : (η_R : PrimeSpectrum R) = PrimeSpectrum.comap (algebraMap R K) η_K := by
        dsimp [η_R, ξ]
        rw [AlgebraicGeometry.Spec.map_base]
        rfl
      have hrK : algebraMap R K r ∈ (η_K : PrimeSpectrum K).asIdeal := by
        rw [h_eq] at hr
        exact hr
      have hrK0 : algebraMap R K r = 0 := by
        by_contra hne
        exact (η_K : PrimeSpectrum K).isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ hrK (isUnit_iff_ne_zero.mpr hne))
      exact (map_eq_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mp hrK0
    · rintro rfl
      exact Ideal.zero_mem _
  have hPre_ξ : AlgebraicGeometry.IsPreimmersion ξ :=
    AlgebraicGeometry.IsPreimmersion.of_isLocalization (R := R) (S := K) (nonZeroDivisors R)
  have hPre_qY : AlgebraicGeometry.IsPreimmersion q_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpY.flip hPre_ξ
  have hEmb_qY : Topology.IsEmbedding q_Y.base := hPre_qY.isEmbedding
  have hProp_μR : ∀ j : Fin s, AlgebraicGeometry.IsProper (μ_R j) := by
    intro j
    have hcomp : AlgebraicGeometry.IsProper (μ_R j ≫ fY) := by
      rw [hμR_comp j]
      infer_instance
    exact (AlgebraicGeometry.IsProper.comp_iff (f := μ_R j) (g := fY)).mp hcomp
  let M : Fin s → Set ↥Y_R := fun j => Set.range (μ_R j).base
  have hCl_Mj : ∀ j : Fin s, IsClosed (M j) := by
    intro j
    have : AlgebraicGeometry.IsProper (μ_R j) := hProp_μR j
    exact (μ_R j).isClosedMap.isClosed_range
  let M_all : Set ↥Y_R := ⋃ j : Fin s, M j
  have hCl_Mall : IsClosed M_all := isClosed_iUnion_of_finite hCl_Mj
  have hRange_qY : Set.range q_Y.base = fY.base ⁻¹' (Set.range ξ.base) := by
    ext y
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨y_K, rfl⟩
      exact ⟨f_YK.base y_K,
        congrArg (fun φ : Y_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) => φ.base y_K)
          hpY.w.symm⟩
    · rintro ⟨z_K, hz⟩
      obtain ⟨y_K, hy, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpY y z_K hz.symm
      exact ⟨y_K, hy⟩
  have hRange_μ_pullback :
      ∀ {B Y_B : AlgebraicGeometry.Scheme.{u}}
        (g : B ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (q_YB : Y_B ⟶ Y_R) (f_YB : Y_B ⟶ B)
        (C_B : Fin s → AlgebraicGeometry.Scheme.{u})
        (q_CB : ∀ j : Fin s, C_B j ⟶ C_R j)
        (f_CB : ∀ j : Fin s, C_B j ⟶ B)
        (μ_B : ∀ j : Fin s, C_B j ⟶ Y_B),
        CategoryTheory.IsPullback q_YB f_YB fY g →
        (∀ j : Fin s, CategoryTheory.IsPullback (q_CB j) (f_CB j) (fC j) g) →
        (∀ j : Fin s, μ_B j ≫ q_YB = q_CB j ≫ μ_R j) →
        (∀ j : Fin s, μ_B j ≫ f_YB = f_CB j) →
        ∀ j : Fin s, Set.range (μ_B j).base = q_YB.base ⁻¹' (M j) := by
    intro B Y_B g q_YB f_YB C_B q_CB f_CB μ_B hpYB hpCB hμB_comm hμB_comp j
    have hp_tot : CategoryTheory.IsPullback (μ_B j ≫ f_YB) (q_CB j) g (μ_R j ≫ fY) := by
      rw [hμB_comp j, hμR_comp j]
      exact (hpCB j).flip
    have hp_μB : CategoryTheory.IsPullback (μ_B j) (q_CB j) q_YB (μ_R j) :=
      CategoryTheory.IsPullback.of_right hp_tot (hμB_comm j) hpYB.flip
    ext y_B
    simp only [M, Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨c_B, rfl⟩
      exact ⟨(q_CB j).base c_B,
        congrArg (fun φ : C_B j ⟶ Y_R => φ.base c_B) (hμB_comm j).symm⟩
    · rintro ⟨c_R, hc⟩
      obtain ⟨c_B, hy, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hp_μB y_B c_R hc.symm
      exact ⟨c_B, hy⟩
  have hRange_μK : ∀ j : Fin s, Set.range (μ_K j).base = q_Y.base ⁻¹' (M j) :=
    hRange_μ_pullback ξ q_Y f_YK C_K q_C f_CK μ_K hpY hpC hμK_comm hμK_comp
  let B_K : Set ↥Y_K := (⋃ j : Fin s, (U_K j : Set ↥Y_K))ᶜ
  have hCl_BK : IsClosed B_K :=
    (isOpen_iUnion (fun j => (U_K j).isOpen)).isClosed_compl
  let IdxPair := {p : Fin s × Fin s // p.1 ≠ p.2}
  let Z_bad : Set ↥Y_R :=
    closure (q_Y.base '' B_K) ∪ ⋃ p : IdxPair, (M p.1.1 ∩ M p.1.2)
  have hCl_Zbad : IsClosed Z_bad :=
    isClosed_closure.union
      (isClosed_iUnion_of_finite (fun p : IdxPair => (hCl_Mj p.1.1).inter (hCl_Mj p.1.2)))
  let Z_cl : TopologicalSpace.Closeds ↥Y_R := ⟨Z_bad, hCl_Zbad⟩
  let I_WR : Y_R.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_cl
  let W_R : AlgebraicGeometry.Scheme.{u} := I_WR.subscheme
  let i_WR : W_R ⟶ Y_R := I_WR.subschemeι
  have hClImm_iWR : AlgebraicGeometry.IsClosedImmersion i_WR := inferInstance
  have hRange_iWR : Set.range i_WR.base = Z_bad := by
    dsimp [i_WR, I_WR]
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hPre_Zbad : q_Y.base ⁻¹' Z_bad = B_K := by
    have hPre_cl : q_Y.base ⁻¹' closure (q_Y.base '' B_K) = B_K :=
      (hEmb_qY.toIsInducing.closure_eq_preimage_closure_image B_K).symm.trans hCl_BK.closure_eq
    ext y
    simp only [Z_bad, Set.preimage_union, Set.mem_union]
    rw [hPre_cl]
    constructor
    · rintro (hy | hy)
      · exact hy
      · simp only [Set.preimage_iUnion, Set.mem_iUnion] at hy
        rcases hy with ⟨⟨⟨i₁, i₂⟩, hne⟩, hy₁, hy₂⟩
        change q_Y.base y ∈ M i₁ at hy₁
        change q_Y.base y ∈ M i₂ at hy₂
        have hy₁' : y ∈ Set.range (μ_K i₁).base := by rwa [hRange_μK i₁]
        have hy₂' : y ∈ Set.range (μ_K i₂).base := by rwa [hRange_μK i₂]
        rcases hy₁' with ⟨c₁, hc₁⟩
        rcases hy₂' with ⟨c₂, hc₂⟩
        change y ∈ (⋃ k : Fin s, (U_K k : Set ↥Y_K))ᶜ
        rw [Set.mem_compl_iff, Set.mem_iUnion]
        rintro ⟨k, hyk⟩
        by_cases hk : k = i₁
        · subst hk
          have hc₂_mem : c₂ ∈ ((μ_K i₂).base) ⁻¹' (U_K k : Set ↥Y_K) := by
            change (μ_K i₂).base c₂ ∈ (U_K k : Set ↥Y_K)
            rwa [hc₂]
          rw [hEmpty_preK k i₂ hne] at hc₂_mem
          exact hc₂_mem
        · have hc₁_mem : c₁ ∈ ((μ_K i₁).base) ⁻¹' (U_K k : Set ↥Y_K) := by
            change (μ_K i₁).base c₁ ∈ (U_K k : Set ↥Y_K)
            rwa [hc₁]
          rw [hEmpty_preK k i₁ hk] at hc₁_mem
          exact hc₁_mem
    · intro hy
      exact Or.inl hy
  have hFin_genWR : ((i_WR ≫ fY).base ⁻¹' (Set.range ξ.base)).Finite := by
    have hPre_iWR : AlgebraicGeometry.IsPreimmersion i_WR := inferInstance
    have hInj_iWR : Function.Injective i_WR.base := hPre_iWR.isEmbedding.injective
    refine ((hFin_badK.image q_Y.base).preimage hInj_iWR.injOn).subset ?_
    intro w hw
    simp only [Set.mem_preimage] at hw ⊢
    have hw_range : i_WR.base w ∈ Set.range q_Y.base := by
      rw [hRange_qY]
      exact hw
    rcases hw_range with ⟨y_K, hy_K⟩
    have hy_Z : q_Y.base y_K ∈ Z_bad := by
      rw [hy_K, ← hRange_iWR]
      exact ⟨w, rfl⟩
    have hy_BK : y_K ∈ B_K := by
      rw [← hPre_Zbad]
      exact hy_Z
    exact ⟨y_K, hy_BK, hy_K⟩
  let OtherIdx : Fin s → Type := fun i => {j : Fin s // j ≠ i}
  let F_R : Fin s → Set ↥Y_R :=
    fun i => Z_bad ∪ ⋃ j : OtherIdx i, M j.1
  have hCl_FR : ∀ i : Fin s, IsClosed (F_R i) :=
    fun i => hCl_Zbad.union (isClosed_iUnion_of_finite (fun j : OtherIdx i => hCl_Mj j.1))
  let U_R : Fin s → Y_R.Opens :=
    fun i => ⟨(F_R i)ᶜ, (hCl_FR i).isOpen_compl⟩
  have hU_RK : ∀ i : Fin s, (TopologicalSpace.Opens.map q_Y.base).obj (U_R i) = U_K i := by
    intro i
    ext y
    change q_Y.base y ∈ (F_R i)ᶜ ↔ y ∈ (U_K i : Set ↥Y_K)
    simp only [F_R, Set.mem_compl_iff, Set.mem_union, Set.mem_iUnion, not_or, not_exists]
    constructor
    · rintro ⟨hy_not_Z, hy_not_other⟩
      have hy_not_BK : y ∉ B_K := by
        intro hy_BK
        rw [← hPre_Zbad] at hy_BK
        exact hy_not_Z hy_BK
      have hy_univ : y ∈ ⋃ k : Fin s, Set.range (μ_K k).base := by
        rw [hUniv_K]
        trivial
      rw [Set.mem_iUnion] at hy_univ
      rcases hy_univ with ⟨k, hk⟩
      have hki : k = i := by
        by_contra hne
        apply hy_not_other ⟨k, hne⟩
        rw [hRange_μK k] at hk
        exact hk
      have hi_range : y ∈ Set.range (μ_K i).base := hki ▸ hk
      rcases hi_range with ⟨c_i, hc_i⟩
      dsimp only [B_K] at hy_not_BK
      rw [Set.mem_compl_iff, not_not, Set.mem_iUnion] at hy_not_BK
      rcases hy_not_BK with ⟨l, hyl⟩
      by_cases hli : l = i
      · rwa [← hli]
      · exfalso
        have hc_mem : c_i ∈ ((μ_K i).base) ⁻¹' (U_K l : Set ↥Y_K) := by
          change (μ_K i).base c_i ∈ (U_K l : Set ↥Y_K)
          rwa [hc_i]
        rw [hEmpty_preK l i hli] at hc_mem
        exact hc_mem
    · intro hy_Ui
      refine ⟨?_, ?_⟩
      · intro hy_Z
        have hy_BK : y ∈ B_K := by
          rw [← hPre_Zbad]
          exact hy_Z
        apply hy_BK
        exact Set.mem_iUnion.mpr ⟨i, hy_Ui⟩
      · rintro ⟨j, hji⟩ hy_Mj
        have hy_range : y ∈ Set.range (μ_K j).base := by
          rwa [hRange_μK j]
        rcases hy_range with ⟨c_j, hc_j⟩
        have hc_mem : c_j ∈ ((μ_K j).base) ⁻¹' (U_K i : Set ↥Y_K) := by
          change (μ_K j).base c_j ∈ (U_K i : Set ↥Y_K)
          rwa [hc_j]
        rw [hEmpty_preK i j hji.symm] at hc_mem
        exact hc_mem
  have hNoeth_YR : TopologicalSpace.NoetherianSpace ↥Y_R := by
    have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Spec (CommRingCat.of R)) :=
      inferInstance
    have : AlgebraicGeometry.IsLocallyNoetherian Y_R :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian fY
    have : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) :=
      ((AlgebraicGeometry.isNoetherian_iff _).mp inferInstance).2
    have : CompactSpace ↥Y_R :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace fY
    have : AlgebraicGeometry.IsNoetherian Y_R :=
      (AlgebraicGeometry.isNoetherian_iff Y_R).mpr ⟨inferInstance, inferInstance⟩
    exact inferInstance
  let S_bad : Set (Set ↥Y_R) :=
    {E ∈ irreducibleComponents ↥Y_R | ¬ (E ⊆ M_all)}
  have hFin_Sbad : S_bad.Finite :=
    (@TopologicalSpace.NoetherianSpace.finite_irreducibleComponents ↥Y_R _ hNoeth_YR).subset
      (fun _ h => h.1)
  let F_vert : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) :=
    ⋃ E ∈ S_bad, fY.base '' E
  have hCl_Fvert : IsClosed F_vert :=
    hFin_Sbad.isClosed_biUnion (fun E hE =>
      fY.isClosedMap E (isClosed_of_mem_irreducibleComponents E hE.1))
  have hηR_not_Fvert : η_R ∉ F_vert := by
    intro hmem
    simp only [F_vert, Set.mem_iUnion, exists_prop] at hmem
    rcases hmem with ⟨E, ⟨hE_comp, hE_not_sub⟩, y₁, hy₁_E, hy₁_eq⟩
    have hCl_E : IsClosed E := isClosed_of_mem_irreducibleComponents E hE_comp
    have hIrr_E : IsIrreducible E := hE_comp.1
    let η_E : ↥Y_R := hIrr_E.genericPoint
    have hCl_ηE : closure ({η_E} : Set ↥Y_R) = E :=
      hIrr_E.genericPoint_closure_eq.trans hCl_E.closure_eq
    have hy₁_cl : y₁ ∈ closure ({η_E} : Set ↥Y_R) := by
      rwa [hCl_ηE]
    have h_img_cl :
        η_R ∈ closure ({fY.base η_E} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) := by
      have hsub :=
        image_closure_subset_closure_image (AlgebraicGeometry.Scheme.Hom.continuous fY)
          (s := ({η_E} : Set ↥Y_R))
      rw [Set.image_singleton] at hsub
      apply hsub
      rw [← hy₁_eq]
      exact ⟨y₁, hy₁_cl, rfl⟩
    let q₀ : PrimeSpectrum R := fY.base η_E
    let q₁ : PrimeSpectrum R := η_R
    have h_le : q₀.asIdeal ≤ q₁.asIdeal :=
      (PrimeSpectrum.le_iff_mem_closure q₀ q₁).mpr h_img_cl
    have h_fηE_eq : fY.base η_E = η_R := by
      apply PrimeSpectrum.ext
      exact le_antisymm h_le (by rw [hηR_ideal]; exact bot_le)
    have hηE_range : η_E ∈ Set.range q_Y.base := by
      rw [hRange_qY, Set.mem_preimage, h_fηE_eq, hRange_ξ]
      exact Set.mem_singleton η_R
    rcases hηE_range with ⟨z_K, hz_K⟩
    have hzK_univ : z_K ∈ ⋃ j : Fin s, Set.range (μ_K j).base := by
      rw [hUniv_K]
      trivial
    rw [Set.mem_iUnion] at hzK_univ
    rcases hzK_univ with ⟨j, hzj⟩
    have hηE_Mj : η_E ∈ M j := by
      rw [← hz_K]
      rwa [hRange_μK j] at hzj
    have hηE_Mall : η_E ∈ M_all := Set.mem_iUnion.mpr ⟨j, hηE_Mj⟩
    have hE_sub : E ⊆ M_all := by
      rw [← hCl_ηE]
      exact closure_minimal (Set.singleton_subset_iff.mpr hηE_Mall) hCl_Mall
    exact hE_not_sub hE_sub
  let U_good : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens :=
    ⟨F_vertᶜ, hCl_Fvert.isOpen_compl⟩
  have hηR_good : η_R ∈ U_good := hηR_not_Fvert
  obtain ⟨V_b, ⟨h₄, hh₄_eq⟩, hηR_basic, hbasic_le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hηR_good
  subst hh₄_eq
  have hh₄_ne : (h₄ : R) ≠ 0 := by
    intro hh₄0
    have hmem : (η_R : PrimeSpectrum R) ∈ PrimeSpectrum.basicOpen (0 : R) :=
      hh₄0 ▸ hηR_basic
    exact (PrimeSpectrum.mem_basicOpen (0 : R) η_R).mp hmem (Ideal.zero_mem _)
  refine ⟨W_R, i_WR, U_R, h₄, hh₄_ne, hClImm_iWR, hFin_genWR, hU_RK, ?_⟩
  intro S _ φ_RS hUnit_h₄ Y_S q_YS f_YS C_S q_CS f_CS μ_S hpYS hpCS hμS_comm hμS_comp W_S i_WS U_S
  let g_S : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)
  have hRange_μS : ∀ j : Fin s, Set.range (μ_S j).base = q_YS.base ⁻¹' (M j) :=
    hRange_μ_pullback g_S q_YS f_YS C_S q_CS f_CS μ_S hpYS hpCS hμS_comm hμS_comp
  have hClImm_iWS : AlgebraicGeometry.IsClosedImmersion i_WS := by
    dsimp [i_WS]
    infer_instance
  have hRange_iWS : Set.range i_WS.base = q_YS.base ⁻¹' Z_bad := by
    ext y_S
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨w_S, rfl⟩
      rw [← hRange_iWR]
      exact ⟨(CategoryTheory.Limits.pullback.snd q_YS i_WR).base w_S,
        congrArg (fun φ : W_S ⟶ Y_R => φ.base w_S)
          CategoryTheory.Limits.pullback.condition.symm⟩
    · intro hy_Z
      rw [← hRange_iWR] at hy_Z
      rcases hy_Z with ⟨w_R, hw_R⟩
      obtain ⟨w_S, hy_S, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback q_YS i_WR) y_S w_R hw_R.symm
      exact ⟨w_S, hy_S⟩
  have hUniv_S : (⋃ j : Fin s, Set.range (μ_S j).base) = Set.univ := by
    ext y_S
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    let y_R : ↥Y_R := q_YS.base y_S
    let p_S : ↥(AlgebraicGeometry.Spec (CommRingCat.of S)) := f_YS.base y_S
    have hp_eq : fY.base y_R = g_S.base p_S :=
      congrArg (fun φ : Y_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) => φ.base y_S) hpYS.w
    have hp_comap : (fY.base y_R : PrimeSpectrum R) = PrimeSpectrum.comap φ_RS p_S := by
      rw [hp_eq]
      dsimp [g_S]
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    have hyR_basic : (fY.base y_R : PrimeSpectrum R) ∈ PrimeSpectrum.basicOpen (h₄ : R) := by
      refine (PrimeSpectrum.mem_basicOpen (h₄ : R) (fY.base y_R)).mpr ?_
      intro hh₄_mem
      rw [hp_comap] at hh₄_mem
      have hφ_mem : φ_RS h₄ ∈ (p_S : PrimeSpectrum S).asIdeal := hh₄_mem
      exact (p_S : PrimeSpectrum S).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem _ hφ_mem hUnit_h₄)
    have hyR_not_Fvert : fY.base y_R ∉ F_vert := hbasic_le hyR_basic
    let E : Set ↥Y_R := irreducibleComponent y_R
    have hyR_E : y_R ∈ E := mem_irreducibleComponent
    have hE_comp : E ∈ irreducibleComponents ↥Y_R :=
      irreducibleComponent_mem_irreducibleComponents y_R
    have hE_sub : E ⊆ M_all := by
      by_contra hnot_sub
      apply hyR_not_Fvert
      simp only [F_vert, Set.mem_iUnion, exists_prop]
      exact ⟨E, ⟨hE_comp, hnot_sub⟩, y_R, hyR_E, rfl⟩
    have hyR_Mall : y_R ∈ M_all := hE_sub hyR_E
    rw [Set.mem_iUnion] at hyR_Mall
    rcases hyR_Mall with ⟨j, hyR_Mj⟩
    refine ⟨j, ?_⟩
    rw [hRange_μS j]
    exact hyR_Mj
  refine ⟨hClImm_iWS, hUniv_S, ?_, ?_, ?_, ?_⟩
  · intro j y_S hy_US
    rw [Set.mem_compl_iff, hRange_iWS, Set.mem_preimage]
    change q_YS.base y_S ∈ (F_R j)ᶜ at hy_US
    intro hy_Z
    exact hy_US (Or.inl hy_Z)
  · intro y_S hy_compl
    rw [Set.mem_compl_iff, hRange_iWS, Set.mem_preimage] at hy_compl
    have hy_univ : y_S ∈ ⋃ i : Fin s, Set.range (μ_S i).base := by
      rw [hUniv_S]
      trivial
    rw [Set.mem_iUnion] at hy_univ
    rcases hy_univ with ⟨i, hy_Mi⟩
    rw [hRange_μS i] at hy_Mi
    rw [Set.mem_iUnion]
    refine ⟨i, ?_⟩
    change q_YS.base y_S ∈ (F_R i)ᶜ
    simp only [F_R, Set.mem_compl_iff, Set.mem_union, Set.mem_iUnion, not_or, not_exists]
    refine ⟨hy_compl, ?_⟩
    rintro ⟨j, hji⟩ hy_Mj
    apply hy_compl
    exact Or.inr (Set.mem_iUnion.mpr ⟨⟨(i, j), hji.symm⟩, ⟨hy_Mi, hy_Mj⟩⟩)
  · intro i j hij
    rw [disjoint_iff_inf_le]
    intro y_S ⟨hy_Ui, hy_Uj⟩
    change q_YS.base y_S ∈ (F_R i)ᶜ at hy_Ui
    change q_YS.base y_S ∈ (F_R j)ᶜ at hy_Uj
    have hy_univ : y_S ∈ ⋃ k : Fin s, Set.range (μ_S k).base := by
      rw [hUniv_S]
      trivial
    rw [Set.mem_iUnion] at hy_univ
    rcases hy_univ with ⟨k, hy_Mk⟩
    rw [hRange_μS k] at hy_Mk
    by_cases hki : k = i
    · apply hy_Uj
      refine Or.inr (Set.mem_iUnion.mpr ⟨⟨i, hij⟩, ?_⟩)
      dsimp only
      exact hki ▸ hy_Mk
    · apply hy_Ui
      exact Or.inr (Set.mem_iUnion.mpr ⟨⟨k, hki⟩, hy_Mk⟩)
  · intro i j hij
    ext c_S
    simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]
    intro hc_Ui
    change q_YS.base ((μ_S j).base c_S) ∈ (F_R i)ᶜ at hc_Ui
    have hy_Mj : q_YS.base ((μ_S j).base c_S) ∈ M j := by
      change (μ_S j).base c_S ∈ q_YS.base ⁻¹' (M j)
      rw [← hRange_μS j]
      exact ⟨c_S, rfl⟩
    exact hc_Ui (Or.inr (Set.mem_iUnion.mpr ⟨⟨j, hij.symm⟩, hy_Mj⟩))

theorem weil_spread_out_p1_finite_of_generic_finite_fiber (k : Type u) [Field k] [IsAlgClosed k]
    (R : Type u) [CommRing R] [IsDomain R] [Algebra k R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
    (W : AlgebraicGeometry.Scheme.{u})
    (π_W : W ⟶ CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
      (weilProjectiveSpaceOver k 1).hom)
    [AlgebraicGeometry.IsFinite π_W]
    (hFinGen : ((π_W ≫ CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
        (weilProjectiveSpaceOver k 1).hom).base ⁻¹'
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))).base).Finite) :
    ∃ (h₆ : R) (_ : h₆ ≠ 0),
