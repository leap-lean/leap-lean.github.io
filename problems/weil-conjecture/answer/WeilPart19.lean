          (CategoryTheory.asIso (δ (q' + 1))).symm
        obtain ⟨iso_IH⟩ := ih (q' + 1) (by omega) Z₁ K_shift ε₁ hε₁
          (fun n => hK_inj (n + 1)) hε₁_mono hEx_ε₁ (fun n => hEx_succ (n + 1))
        let GK_shift : CochainComplex (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}) ℕ :=
          (h_push.mapHomologicalComplex (ComplexShape.up ℕ)).obj K_shift
        let iso_sc : GK_shift.sc' q' (q' + 1) (q' + 2) ≅ GK.sc' (q' + 1) (q' + 2) (q' + 3) :=
