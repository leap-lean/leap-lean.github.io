    obtain ⟨b, hb⟩ := e.surjective ⟨x₀, hx₀⟩
    have hb_val : (e b).1 = x₀ := congrArg Subtype.val hb
    rw [← hb_val] at hmemO
    rcases hmemO with ⟨y₀, hy₀⟩
    exact ⟨b, y₀, hy₀⟩
  have hAff : CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
