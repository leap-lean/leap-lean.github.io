        have : CategoryTheory.Epi u₁ :=
          (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift _).mp hEx_ε₁
        have : CategoryTheory.IsIso u₁ := CategoryTheory.isIso_of_mono_of_epi u₁
        let φ_Z : h_push.obj Z₁ ≅ S₁.cycles :=
          (h_push.mapIso (CategoryTheory.asIso u₁)).trans
            ((CategoryTheory.Limits.PreservesKernel.iso h_push (K.d 1 2)).trans S₁.cyclesIsoKernel.symm)
        have hφZ_i : φ_Z.hom ≫ S₁.iCycles = h_push.map ε₁ := by
          dsimp only [φ_Z, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
