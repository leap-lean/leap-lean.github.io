          apply hs_uniq_local V R_UV w_V hEt_wV (q₀ ≫ G.map f) (e_P.inv ≫ p₁) hw_lhs hw_rhs
          let _ := hEt_comp w_V V.1.ι hEt_wV (hEt_ι V)
          let E_wV : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w_V ≫ V.1.ι)
          let e_wV : E_wV ⟶ E_wP :=
            CategoryTheory.MorphismProperty.Over.homMk (𝟙 (AlgebraicGeometry.Spec R_UV))
              ((CategoryTheory.Category.id_comp _).trans
                ((congrArg (w_P ≫ ·) (hF_X_w f)).symm.trans
                  (CategoryTheory.Category.assoc _ _ _).symm))
          let m_lhs : E_wV ⟶ E_U V :=
            CategoryTheory.MorphismProperty.Over.homMk (q₀ ≫ G.map f)
              ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ V.1.ι) hw_lhs))
          let m_rhs : E_wV ⟶ E_U V :=
            CategoryTheory.MorphismProperty.Over.homMk (e_P.inv ≫ p₁)
              ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ V.1.ι) hw_rhs))
          let m_q₀ : E_wP ⟶ E_U U :=
            CategoryTheory.MorphismProperty.Over.homMk q₀
              ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.1.ι) hq₀_over))
          have hcomm_gf : G.map f ≫ τ_U V ≫ V.1.ι = τ_U U ≫ U.1.ι := by
            dsimp [G]
            rw [← CategoryTheory.Category.assoc, hg_over f, CategoryTheory.Category.assoc, hF_X_w f]
          let m_gf : E_U U ⟶ E_U V :=
            CategoryTheory.MorphismProperty.Over.homMk (G.map f) hcomm_gf
          have hm_lhs_eq : m_lhs = e_wV ≫ m_q₀ ≫ m_gf := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact (CategoryTheory.Category.id_comp _).symm
          have hm_rhs_eq : m_rhs = e_wV ≫ m_p₁ := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact (CategoryTheory.Category.id_comp _).symm
          change P.obj.map m_lhs.op (s_U V) = P.obj.map m_rhs.op (s_U V)
          rw [hm_lhs_eq, hm_rhs_eq]
          simp only [op_comp, P.obj.map_comp, types_comp_apply]
          rw [hg_sec f hcomm_gf, hq₀_sec]
        rw [CategoryTheory.Category.assoc, hq₀_gf, ← CategoryTheory.Category.assoc,
          e_P.hom_inv_id, CategoryTheory.Category.id_comp]
      · change (e_P.hom ≫ q₀) ≫ lift_UV ≫ p₂ = 𝟙 P_UV ≫ p₂
        rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.assoc, hq₀_over]
        dsimp [w_P]
        rw [← CategoryTheory.Category.assoc, e_P.hom_inv_id, CategoryTheory.Category.id_comp]
    let iso_UV : G.obj U ≅ P_UV :=
      { hom := lift_UV
        inv := inv_UV
        hom_inv_id := h_left_inv
        inv_hom_id := h_right_inv }
    exact CategoryTheory.IsPullback.of_iso_pullback ⟨hg_over f⟩ iso_UV
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  let ρ_G : ZMod ℓ → (G ⟶ G) := fun γ =>
    { app := fun U => ρ_U U γ
      naturality := fun {U V} f => by
        let w_f : AlgebraicGeometry.Spec (B_U U) ⟶ V.1.toScheme := τ_U U ≫ j_map f
        have hEt_wf : AlgebraicGeometry.Etale w_f :=
          hEt_comp (τ_U U) (j_map f) (hEt_U U) (hEt_j f)
        have hw_lhs : (G.map f ≫ ρ_U V γ) ≫ τ_U V = w_f := by
          dsimp [G, w_f]
          rw [CategoryTheory.Category.assoc, hρ_U_over V γ, hg_over f]
        have hw_rhs : (ρ_U U γ ≫ G.map f) ≫ τ_U V = w_f := by
          dsimp [G, w_f]
          rw [CategoryTheory.Category.assoc, hg_over f, ← CategoryTheory.Category.assoc,
            hρ_U_over U γ]
        apply hs_uniq_local V (B_U U) w_f hEt_wf (G.map f ≫ ρ_U V γ) (ρ_U U γ ≫ G.map f)
          hw_lhs hw_rhs
        let _ := hEt_comp w_f V.1.ι hEt_wf (hEt_ι V)
        let E_wf : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w_f ≫ V.1.ι)
        let e_u : E_wf ⟶ E_U U :=
          CategoryTheory.MorphismProperty.Over.homMk (𝟙 (AlgebraicGeometry.Spec (B_U U)))
            ((CategoryTheory.Category.id_comp _).trans
              ((congrArg (τ_U U ≫ ·) (hF_X_w f)).symm.trans
                (CategoryTheory.Category.assoc _ _ _).symm))
        let m_lhs : E_wf ⟶ E_U V :=
          CategoryTheory.MorphismProperty.Over.homMk (G.map f ≫ ρ_U V γ)
            ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ V.1.ι) hw_lhs))
        let m_rhs : E_wf ⟶ E_U V :=
          CategoryTheory.MorphismProperty.Over.homMk (ρ_U U γ ≫ G.map f)
            ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ V.1.ι) hw_rhs))
        let m_ρU : E_U U ⟶ E_U U :=
          CategoryTheory.MorphismProperty.Over.homMk (ρ_U U γ)
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ U.1.ι) (hρ_U_over U γ)))
        let m_ρV : E_U V ⟶ E_U V :=
          CategoryTheory.MorphismProperty.Over.homMk (ρ_U V γ)
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ V.1.ι) (hρ_U_over V γ)))
        have hcomm_gf : G.map f ≫ τ_U V ≫ V.1.ι = τ_U U ≫ U.1.ι := by
          dsimp [G]
          rw [← CategoryTheory.Category.assoc, hg_over f, CategoryTheory.Category.assoc, hF_X_w f]
        let m_gf : E_U U ⟶ E_U V :=
          CategoryTheory.MorphismProperty.Over.homMk (G.map f) hcomm_gf
        have hm_lhs_eq : m_lhs = e_u ≫ m_gf ≫ m_ρV := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact (CategoryTheory.Category.id_comp _).symm
        have hm_rhs_eq : m_rhs = e_u ≫ m_ρU ≫ m_gf := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact (CategoryTheory.Category.id_comp _).symm
        change P.obj.map m_lhs.op (s_U V) = P.obj.map m_rhs.op (s_U V)
        rw [hm_lhs_eq, hm_rhs_eq]
        simp only [op_comp, P.obj.map_comp, types_comp_apply]
        rw [hg_sec f hcomm_gf, hs_equiv U γ, hs_equiv V γ]
        congr 1
        have hnat := CategoryTheory.ConcreteCategory.congr_hom
