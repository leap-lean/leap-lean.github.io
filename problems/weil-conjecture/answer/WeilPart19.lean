        rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
        exact (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply α).symm
      have hcomp_mk :
          CategoryTheory.Abelian.Ext.homEquiv₀
            ((CategoryTheory.Abelian.Ext.mk₀ (F_free.map u)).comp α (Nat.zero_add 0)) =
          F_free.map u ≫ CategoryTheory.Abelian.Ext.homEquiv₀ α := by
        conv_lhs => rw [hα]
        rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
          CategoryTheory.Abelian.Ext.homEquiv₀.apply_symm_apply]
      rw [hcomp_mk]
      have hFmap : F_free.map u = L_sh.map (CategoryTheory.yoneda.map u) := rfl
      rw [hFmap, CategoryTheory.Adjunction.homEquiv_naturality_left,
        CategoryTheory.yonedaEquiv_naturality]
    refine ⟨?_, ?_, ?_⟩
    · intro W₁ W₂ h H q hZeroH
