    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hpC j).flip hSurj_β
  have hFlat_pC : ∀ j : Fin s, AlgebraicGeometry.Flat (p_C j) := fun j =>
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hpC j).flip hFlat_β
  
  have hSpecΓ_inv_hom : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S),
      (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫
        (AlgebraicGeometry.Spec.map f).appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso S).hom = f := by
    intro R S f
    rw [AlgebraicGeometry.Scheme.ΓSpecIso_naturality f, CategoryTheory.Iso.inv_hom_id_assoc]
  have hToSpecΓ_struct : ∀ {X : AlgebraicGeometry.Scheme.{u}} {F : Type u} [CommRing F]
      (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of F)),
      X.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ g.appTop) = g := by
    intro X F _ g
    rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Scheme.toSpecΓ_naturality g, CategoryTheory.Category.assoc,
