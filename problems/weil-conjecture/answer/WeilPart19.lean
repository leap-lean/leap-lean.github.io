    have : Module.Flat A (Localization.Away r) :=
      IsLocalization.flat (Localization.Away r) (Submonoid.powers r)
    let Eq_r : Subalgebra (Localization.Away r)
        (TensorProduct A (Localization.Away r) (ZMod ℓ → D)) :=
      (Algebra.TensorProduct.map
        (AlgHom.id (Localization.Away r) (Localization.Away r)) d₁).equalizer
        (Algebra.TensorProduct.map
          (AlgHom.id (Localization.Away r) (Localization.Away r)) d₂)
    let E_loc : TensorProduct A (Localization.Away r) ↥B ≃ₐ[Localization.Away r] ↥Eq_r :=
      AlgHom.tensorEqualizerEquiv (Localization.Away r) (Localization.Away r) d₁ d₂
    let π_Ar : TensorProduct A (Localization.Away r) (ZMod ℓ → D) ≃ₐ[Localization.Away r]
        (ZMod ℓ → TensorProduct A (Localization.Away r) D) :=
      Algebra.TensorProduct.piRight A (Localization.Away r) (Localization.Away r)
        (fun _ : ZMod ℓ => D)
    let π_Ar_DD : TensorProduct A (Localization.Away r) (ZMod ℓ → TensorProduct A D D)
        ≃ₐ[Localization.Away r]
        (ZMod ℓ → TensorProduct A (Localization.Away r) (TensorProduct A D D)) :=
      Algebra.TensorProduct.piRight A (Localization.Away r) (Localization.Away r)
        (fun _ : ZMod ℓ => TensorProduct A D D)
    let L_DD : TensorProduct A (Localization.Away r) (TensorProduct A D D)
        ≃ₗ[Localization.Away r]
        TensorProduct (Localization.Away r)
          (TensorProduct A (Localization.Away r) D)
          (TensorProduct A (Localization.Away r) D) :=
      TensorProduct.AlgebraTensorModule.distribBaseChange A (Localization.Away r) D D
    have hL_DD : ∀ (x : Localization.Away r) (t : TensorProduct A D D),
        L_DD (TensorProduct.tmul A x t) = x • ψ_DD t := by
      intro x t
      induction t using TensorProduct.induction_on with
      | zero =>
        rw [TensorProduct.tmul_zero, L_DD.map_zero, ψ_DD.map_zero, smul_zero]
      | tmul d₁' d₂' =>
        dsimp only [L_DD]
        rw [hψ_DD d₁' d₂', TensorProduct.smul_tmul', TensorProduct.smul_tmul',
          smul_eq_mul, mul_one]
        simp
      | add t₁ t₂ ht₁ ht₂ =>
        rw [TensorProduct.tmul_add, L_DD.map_add, ψ_DD.map_add, smul_add, ht₁, ht₂]
    have hEq_r_lhs : ∀ (z_r : TensorProduct A (Localization.Away r) (ZMod ℓ → D)) (γ : ZMod ℓ),
        L_DD (π_Ar_DD ((Algebra.TensorProduct.map
          (AlgHom.id (Localization.Away r) (Localization.Away r)) d₁) z_r) γ) =
          Algebra.TensorProduct.includeRight (R := Localization.Away r) (π_Ar z_r γ) := by
      intro z_r γ
      induction z_r using TensorProduct.induction_on with
      | zero =>
        rw [map_zero, map_zero π_Ar_DD, Pi.zero_apply, L_DD.map_zero,
          map_zero π_Ar, Pi.zero_apply, map_zero]
      | tmul x f =>
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
        have hπ1 : π_Ar_DD (TensorProduct.tmul A x (d₁ f)) γ =
            TensorProduct.tmul A x (TensorProduct.tmul A (1 : D) (f γ)) :=
          rfl
        have hπ2 : π_Ar (TensorProduct.tmul A x f) γ = TensorProduct.tmul A x (f γ) :=
          rfl
        rw [hπ1, hπ2, hL_DD, hψ_DD, TensorProduct.smul_tmul', TensorProduct.smul_tmul,
          TensorProduct.smul_tmul', smul_eq_mul, mul_one,
          Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.one_def]
      | add z₁ z₂ hz₁ hz₂ =>
        rw [map_add, map_add π_Ar_DD, Pi.add_apply, L_DD.map_add, hz₁, hz₂,
          map_add π_Ar, Pi.add_apply, map_add]
    have hEq_r_rhs : ∀ (z_r : TensorProduct A (Localization.Away r) (ZMod ℓ → D)) (γ : ZMod ℓ),
        L_DD (π_Ar_DD ((Algebra.TensorProduct.map
          (AlgHom.id (Localization.Away r) (Localization.Away r)) d₂) z_r) γ) =
          ∑ δ : ZMod ℓ,
            Algebra.TensorProduct.includeLeft (R := Localization.Away r)
              (S := Localization.Away r) (π_Ar z_r (γ + δ)) * ψ_DD (e₁₂ δ) := by
      intro z_r γ
      induction z_r using TensorProduct.induction_on with
      | zero =>
        rw [map_zero, map_zero π_Ar_DD, Pi.zero_apply, L_DD.map_zero, map_zero π_Ar]
        simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero]
      | tmul x f =>
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
        have hπ1 : π_Ar_DD (TensorProduct.tmul A x (d₂ f)) γ =
            TensorProduct.tmul A x
              (∑ δ : ZMod ℓ,
                TensorProduct.tmul A (f (γ + δ)) (1 : D) * e₁₂ δ) :=
          rfl
        rw [hπ1, hL_DD, map_sum, Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro δ _
        have hπ2 : π_Ar (TensorProduct.tmul A x f) (γ + δ) =
            TensorProduct.tmul A x (f (γ + δ)) :=
          rfl
        rw [hπ2, ψ_DD.map_mul, ← smul_mul_assoc, hψ_DD, TensorProduct.smul_tmul',
          TensorProduct.smul_tmul', smul_eq_mul, mul_one,
          Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.one_def]
      | add z₁ z₂ hz₁ hz₂ =>
        rw [map_add, map_add π_Ar_DD, Pi.add_apply, L_DD.map_add, hz₁, hz₂,
          ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro δ _
        rw [map_add π_Ar, Pi.add_apply, map_add, add_mul]
    have hz_iff : ∀ z_r : TensorProduct A (Localization.Away r) (ZMod ℓ → D),
        z_r ∈ Eq_r ↔ π_Ar z_r ∈ B_r := by
      intro z_r
      rw [AlgHom.mem_equalizer, hB_r]
      constructor
      · intro hz γ
        rw [← hEq_r_lhs z_r γ, ← hEq_r_rhs z_r γ, hz]
      · intro hz
        apply π_Ar_DD.injective
        funext γ
        apply L_DD.injective
        rw [hEq_r_lhs z_r γ, hEq_r_rhs z_r γ, hz γ]
    let E_Br : ↥Eq_r ≃ₐ[Localization.Away r] ↥B_r :=
      { toFun := fun u => ⟨π_Ar u.1, (hz_iff u.1).mp u.2⟩
        invFun := fun v =>
          ⟨π_Ar.symm v.1, (hz_iff (π_Ar.symm v.1)).mpr (by rw [π_Ar.apply_symm_apply]; exact v.2)⟩
        left_inv := fun u => Subtype.ext (π_Ar.symm_apply_apply u.1)
        right_inv := fun v => Subtype.ext (π_Ar.apply_symm_apply v.1)
        map_mul' := fun u₁ u₂ => Subtype.ext (map_mul π_Ar u₁.1 u₂.1)
        map_add' := fun u₁ u₂ => Subtype.ext (map_add π_Ar u₁.1 u₂.1)
        commutes' := fun x => Subtype.ext (π_Ar.commutes x) }
    let Theta_r : TensorProduct A (Localization.Away r) ↥B ≃ₐ[Localization.Away r] ↥B_r :=
      E_loc.trans E_Br
    let φ_loc : ↥B →+* ↥B_r :=
      Theta_r.toRingHom.comp
        (Algebra.TensorProduct.includeRight :
          ↥B →ₐ[A] TensorProduct A (Localization.Away r) ↥B).toRingHom
    have hE_loc_coe : ∀ (x : Localization.Away r) (b : ↥(AlgHom.equalizer d₁ d₂)),
        ((AlgHom.tensorEqualizerEquiv (Localization.Away r) (Localization.Away r) d₁ d₂)
          (TensorProduct.tmul A x b)).1 = TensorProduct.tmul A x b.1 := by
      intro x b
      simp [AlgHom.tensorEqualizerEquiv_apply]
    have hφ_loc : ∀ (b : ↥B) (γ : ZMod ℓ),
        (φ_loc b).1 γ = TensorProduct.tmul A (1 : Localization.Away r) (b.1 γ) := by
      intro b γ
      change (π_Ar ((AlgHom.tensorEqualizerEquiv (Localization.Away r) (Localization.Away r) d₁ d₂)
        (TensorProduct.tmul A (1 : Localization.Away r) b)).1) γ =
        TensorProduct.tmul A (1 : Localization.Away r) (b.1 γ)
      rw [hE_loc_coe (1 : Localization.Away r) b]
      simp [π_Ar]
    let _ : Algebra ↥B ↥B_r := φ_loc.toAlgebra
    have hLoc1 : IsLocalization (Algebra.algebraMapSubmonoid ↥B (Submonoid.powers r))
        (TensorProduct A ↥B (Localization.Away r)) := inferInstance
    have hSub : Algebra.algebraMapSubmonoid ↥B (Submonoid.powers r) =
        Submonoid.powers (algebraMap A ↥B r) :=
      Submonoid.map_powers (algebraMap A ↥B) r
    rw [hSub] at hLoc1
    let e_B_ring : TensorProduct A ↥B (Localization.Away r) ≃+* ↥B_r :=
      (Algebra.TensorProduct.comm A ↥B (Localization.Away r)).toRingEquiv.trans
        Theta_r.toRingEquiv
    let e_B_alg : TensorProduct A ↥B (Localization.Away r) ≃ₐ[↥B] ↥B_r :=
      AlgEquiv.ofRingEquiv (f := e_B_ring) (fun b => by
        change Theta_r ((Algebra.TensorProduct.comm A ↥B (Localization.Away r))
          (TensorProduct.tmul A b (1 : Localization.Away r))) =
          Theta_r (TensorProduct.tmul A (1 : Localization.Away r) b)
        rw [Algebra.TensorProduct.comm_tmul])
    have hIsLoc : @IsLocalization.Away _ _ (algebraMap A ↥B r) ↥B_r _ φ_loc.toAlgebra :=
      IsLocalization.isLocalization_of_algEquiv (Submonoid.powers (algebraMap A ↥B r)) e_B_alg
    exact ⟨φ_loc, hφ_loc, hIsLoc⟩

theorem weil_affineOpen_etale_torsor_descent_and_affine_universal_property (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : AlgebraicGeometry.Scheme.{u})
    (hIdempFrame :
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) (f : LocallyConstant ↥Z (ZMod ℓ)),
        ∃ (e : ZMod ℓ → ↑(Z.presheaf.obj (Opposite.op ⊤))),
          (∀ δ : ZMod ℓ, e δ * e δ = e δ) ∧
          (∀ δ₁ δ₂ : ZMod ℓ, δ₁ ≠ δ₂ → e δ₁ * e δ₂ = 0) ∧
          (∑ δ : ZMod ℓ, e δ) = 1 ∧
          (∀ δ : ZMod ℓ,
            Z.basicOpen (e δ) = ⟨{z : ↥Z | f z = δ}, f.isLocallyConstant.isOpen_fiber δ⟩)) ∧
      (∀ (R : CommRingCat.{u}) (e₁ e₂ : ↑R),
        e₁ * e₁ = e₁ → e₂ * e₂ = e₂ →
        (AlgebraicGeometry.Spec R).basicOpen ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom e₁) =
          (AlgebraicGeometry.Spec R).basicOpen ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom e₂) →
        e₁ = e₂) ∧
      (∀ (R : CommRingCat.{u}) (c : ZMod ℓ → ↑R),
        (∀ δ : ZMod ℓ, c δ * c δ = c δ) →
        (∀ δ₁ δ₂ : ZMod ℓ, δ₁ ≠ δ₂ → c δ₁ * c δ₂ = 0) →
        (∑ δ : ZMod ℓ, c δ) = 1 →
        ∃ (u : LocallyConstant ↥(AlgebraicGeometry.Spec R) (ZMod ℓ)),
          ∀ δ : ZMod ℓ,
            ⟨{z : ↥(AlgebraicGeometry.Spec R) | u z = δ}, u.isLocallyConstant.isOpen_fiber δ⟩ =
              (AlgebraicGeometry.Spec R).basicOpen
                ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom (c δ))))
    (hAlg : ∀ (A D : Type u) [CommRing A] [CommRing D] [Algebra A D],
      (algebraMap A D).FaithfullyFlat →
      Algebra.Etale A D →
      ∀ (e₁₂ : ZMod ℓ → TensorProduct A D D),
      (∀ δ : ZMod ℓ, e₁₂ δ * e₁₂ δ = e₁₂ δ) →
      (∀ δ₁ δ₂ : ZMod ℓ, δ₁ ≠ δ₂ → e₁₂ δ₁ * e₁₂ δ₂ = 0) →
      (∑ δ : ZMod ℓ, e₁₂ δ) = 1 →
      Algebra.TensorProduct.lmul' A (S := D) (e₁₂ 0) = 1 →
      (∀ γ : ZMod ℓ,
        let ι₁₂ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A D D) D :=
          Algebra.TensorProduct.includeLeft
        let ι₂₃ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A D D) D :=
          (Algebra.TensorProduct.assoc A A A D D D).symm.toAlgHom.comp
            Algebra.TensorProduct.includeRight
        let ι₁₃ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A D D) D :=
          (Algebra.TensorProduct.assoc A A A D D D).symm.toAlgHom.comp
            (Algebra.TensorProduct.map (AlgHom.id A D) Algebra.TensorProduct.includeRight)
        ι₁₃ (e₁₂ γ) = ∑ α : ZMod ℓ, ι₁₂ (e₁₂ α) * ι₂₃ (e₁₂ (γ - α))) →
      (∀ (R : Type u) [CommRing R] [Algebra A R] (y : TensorProduct A R D),
        let p₁ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
          Algebra.TensorProduct.includeLeft
        let p₂ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
          (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
            (Algebra.TensorProduct.map (AlgHom.id A R) Algebra.TensorProduct.includeRight)
        p₁ y = p₂ y → ∃! r : R, TensorProduct.tmul A r (1 : D) = y) ∧
      ∃ (B : Subalgebra A (ZMod ℓ → D)),
        (∀ b : ZMod ℓ → D, b ∈ B ↔
          ∀ γ : ZMod ℓ, Algebra.TensorProduct.includeRight (b γ) =
            ∑ δ : ZMod ℓ, Algebra.TensorProduct.includeLeft (S := A) (b (γ + δ)) * e₁₂ δ) ∧
        (algebraMap A ↥B).Finite ∧
        (algebraMap A ↥B).Etale ∧
        (∃ (e_triv_D : TensorProduct A D ↥B ≃ₐ[D] (ZMod ℓ → D)),
          ∀ (d : D) (b : ↥B) (γ : ZMod ℓ),
            e_triv_D (TensorProduct.tmul A d b) γ = d * b.1 γ))
    (P : CategoryTheory.Sheaf X.smallEtaleTopology (Type u))
    (actP : ZMod ℓ → (P ⟶ P))
    (hact0 : actP 0 = 𝟙 P)
    (hact_add : ∀ γ₁ γ₂ : ZMod ℓ, actP (γ₁ + γ₂) = actP γ₁ ≫ actP γ₂)
    (hLocTriv : ∀ (U : X.affineOpens),
      ∃ (D : CommRingCat.{u}) (p_V : AlgebraicGeometry.Spec D ⟶ U.1.toScheme)
        (hEt_V : AlgebraicGeometry.Etale p_V),
        letI := hEt_V
        AlgebraicGeometry.Surjective p_V ∧
        Nonempty (P.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (p_V ≫ U.1.ι)))))
    (hTwist : ∀ (E : X.Etale) (s : P.obj.obj (Opposite.op E)) (f : LocallyConstant ↥E.left (ZMod ℓ)),
      letI : AlgebraicGeometry.Etale E.hom := E.prop
      ∃ (s' : P.obj.obj (Opposite.op E)),
        ∀ (γ : ZMod ℓ),
          let O_γ : E.left.Opens := ⟨{x | f x = γ}, f.isLocallyConstant.isOpen_fiber γ⟩
          let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
          let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
          P.obj.map j_γ.op s' = P.obj.map j_γ.op ((actP γ).hom.app (Opposite.op E) s))
    (hTrans : ∀ (E : X.Etale) (s s' : P.obj.obj (Opposite.op E)),
      letI : AlgebraicGeometry.Etale E.hom := E.prop
      ∃! (f : LocallyConstant ↥E.left (ZMod ℓ)),
        ∀ (γ : ZMod ℓ),
          let O_γ : E.left.Opens := ⟨{x | f x = γ}, f.isLocallyConstant.isOpen_fiber γ⟩
          let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
          let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
          P.obj.map j_γ.op s' = P.obj.map j_γ.op ((actP γ).hom.app (Opposite.op E) s))
    (U : X.affineOpens) :
    ∃ (B_U : CommRingCat.{u})
      (τ_U : AlgebraicGeometry.Spec B_U ⟶ U.1.toScheme)
      (_ : AlgebraicGeometry.IsFinite τ_U)
      (hEt_U : AlgebraicGeometry.Etale τ_U)
      (_ : AlgebraicGeometry.Surjective τ_U)
      (ρ_U : ZMod ℓ → (AlgebraicGeometry.Spec B_U ⟶ AlgebraicGeometry.Spec B_U))
      (hρ_U_over : ∀ γ : ZMod ℓ, ρ_U γ ≫ τ_U = τ_U),
      letI := hEt_U
      let E_U : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (τ_U ≫ U.1.ι)
      ρ_U 0 = 𝟙 (AlgebraicGeometry.Spec B_U) ∧
      (∀ γ₁ γ₂ : ZMod ℓ, ρ_U (γ₁ + γ₂) = ρ_U γ₁ ≫ ρ_U γ₂) ∧
      ∃ (s_U : P.obj.obj (Opposite.op E_U)),
        (∀ γ : ZMod ℓ,
          let m_γ : E_U ⟶ E_U :=
            CategoryTheory.MorphismProperty.Over.homMk (ρ_U γ)
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ U.1.ι) (hρ_U_over γ)))
          P.obj.map m_γ.op s_U = (actP γ).hom.app (Opposite.op E_U) s_U) ∧
        (∀ (R : CommRingCat.{u}) (w : AlgebraicGeometry.Spec R ⟶ U.1.toScheme)
            (hEt_w : AlgebraicGeometry.Etale w),
          letI := hEt_w
          let E_w : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι)
          ∀ (s : P.obj.obj (Opposite.op E_w)),
            ∃! (g : AlgebraicGeometry.Spec R ⟶ AlgebraicGeometry.Spec B_U),
              ∃ (hg : g ≫ τ_U = w),
                let m_g : E_w ⟶ E_U :=
                  CategoryTheory.MorphismProperty.Over.homMk g
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      (congrArg (· ≫ U.1.ι) hg))
                P.obj.map m_g.op s_U = s) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  rcases hIdempFrame with ⟨hIdemp1, hIdemp2, hIdemp3⟩
  have hSheaf : CategoryTheory.Presieve.IsSheaf X.smallEtaleTopology P.obj :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type X.smallEtaleTopology P.obj).mp P.property
  have hMemSmallEtale : ∀ (E : X.Etale) (S : CategoryTheory.Sieve E),
      S ∈ X.smallEtaleTopology E ↔
        ∀ (x : ↥E.left), ∃ (W : X.Etale) (f : W ⟶ E) (y : ↥W.left),
          S.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro E S
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale.{u}) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hSmallEq : X.smallEtaleTopology = X.smallEtalePretopology.toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale.{u}) (Q := @AlgebraicGeometry.Etale.{u}) X le_rfl
    rw [hSmallEq]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology E S

  
  have hmap_id : ∀ (E : X.Etale) (s : P.obj.obj (Opposite.op E)),
      P.obj.map (𝟙 E).op s = s := by
    intro E s; rw [op_id, P.obj.map_id]; rfl
  have hmap_comp : ∀ {E₁ E₂ E₃ : X.Etale} (u : E₁ ⟶ E₂) (v : E₂ ⟶ E₃)
      (s : P.obj.obj (Opposite.op E₃)),
      P.obj.map (u ≫ v).op s = P.obj.map u.op (P.obj.map v.op s) := by
    intro E₁ E₂ E₃ u v s; rw [op_comp, P.obj.map_comp]; rfl
  have hact_zero_app : ∀ (E : X.Etale) (s : P.obj.obj (Opposite.op E)),
      (actP 0).hom.app (Opposite.op E) s = s := by
    intro E s; rw [hact0]; rfl
  have hact_add_app : ∀ (γ₁ γ₂ : ZMod ℓ) (E : X.Etale) (s : P.obj.obj (Opposite.op E)),
      (actP (γ₁ + γ₂)).hom.app (Opposite.op E) s =
        (actP γ₂).hom.app (Opposite.op E) ((actP γ₁).hom.app (Opposite.op E) s) := by
    intro γ₁ γ₂ E s; rw [hact_add]; rfl
  have hact_nat : ∀ (γ : ZMod ℓ) {E₁ E₂ : X.Etale} (u : E₁ ⟶ E₂)
      (s : P.obj.obj (Opposite.op E₂)),
      P.obj.map u.op ((actP γ).hom.app (Opposite.op E₂) s) =
        (actP γ).hom.app (Opposite.op E₁) (P.obj.map u.op s) := by
    intro γ E₁ E₂ u s
    have h := CategoryTheory.ConcreteCategory.congr_hom ((actP γ).hom.naturality u.op) s
    simp only [types_comp_apply] at h
    exact h.symm

  
  have hSubEmpty : ∀ (E₀ : X.Etale), IsEmpty ↥E₀.left →
      Subsingleton (P.obj.obj (Opposite.op E₀)) := by
    intro E₀ hEmp
    have hcov : CategoryTheory.Sieve.generate (⊥ : CategoryTheory.Presieve E₀) ∈
        X.smallEtaleTopology E₀ := by
      rw [hMemSmallEtale]
      intro x
      exact (hEmp.false x).elim
    have hsep := (hSheaf.isSheafFor (⊥ : CategoryTheory.Presieve E₀) hcov).isSeparatedFor
    exact ⟨fun s₁ s₂ => hsep.ext fun Y g hg => False.elim hg⟩

  let IsDiff : ∀ (E : X.Etale), P.obj.obj (Opposite.op E) → P.obj.obj (Opposite.op E) →
      LocallyConstant ↥E.left (ZMod ℓ) → Prop :=
    fun E s s' f =>
      letI : AlgebraicGeometry.Etale E.hom := E.prop
      ∀ (γ : ZMod ℓ),
        let O_γ : E.left.Opens := ⟨{x | f x = γ}, f.isLocallyConstant.isOpen_fiber γ⟩
        let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
        let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
        P.obj.map j_γ.op s' = P.obj.map j_γ.op ((actP γ).hom.app (Opposite.op E) s)
  let diff : ∀ (E : X.Etale), P.obj.obj (Opposite.op E) → P.obj.obj (Opposite.op E) →
      LocallyConstant ↥E.left (ZMod ℓ) :=
    fun E s s' => (hTrans E s s').choose
  have hdiff_spec : ∀ E s s', IsDiff E s s' (diff E s s') :=
    fun E s s' => (hTrans E s s').choose_spec.1
  have hdiff_eq : ∀ E s s' f, IsDiff E s s' f → diff E s s' = f :=
    fun E s s' f hf => ((hTrans E s s').choose_spec.2 f hf).symm

  have hdiff_act_right : ∀ (E : X.Etale) (s : P.obj.obj (Opposite.op E)) (δ : ZMod ℓ),
      diff E s ((actP δ).hom.app (Opposite.op E) s) = LocallyConstant.const ↥E.left δ := by
    intro E s δ
    apply hdiff_eq
    letI : AlgebraicGeometry.Etale E.hom := E.prop
    intro γ
    by_cases hδ : δ = γ
    · subst hδ; rfl
    · let O_γ : E.left.Opens :=
        ⟨{x | LocallyConstant.const ↥E.left δ x = γ},
          (LocallyConstant.const ↥E.left δ).isLocallyConstant.isOpen_fiber γ⟩
      let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
      have hEmp : IsEmpty ↥U_γ.left := by
        refine ⟨fun x => hδ ?_⟩
        have hx : O_γ.ι.base x ∈ Set.range ⇑O_γ.ι := ⟨x, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hx
        exact hx
      haveI : Subsingleton (P.obj.obj (Opposite.op U_γ)) := hSubEmpty U_γ hEmp
      exact Subsingleton.elim _ _

  have hdiff_self : ∀ (E : X.Etale) (s : P.obj.obj (Opposite.op E)), diff E s s = 0 := by
    intro E s
    have h0 := hdiff_act_right E s 0
    rw [hact_zero_app] at h0
    exact h0.trans (by ext; rfl)

  have heq_of_diff_zero : ∀ (E : X.Etale) (s₁ s₂ : P.obj.obj (Opposite.op E)),
      diff E s₁ s₂ = 0 → s₁ = s₂ := by
    intro E s₁ s₂ h0
    letI : AlgebraicGeometry.Etale E.hom := E.prop
    have hspec := hdiff_spec E s₁ s₂
    rw [h0] at hspec
    have h0_eq := hspec 0
    let O₀ : E.left.Opens :=
      ⟨{x | (0 : LocallyConstant ↥E.left (ZMod ℓ)) x = 0},
        (0 : LocallyConstant ↥E.left (ZMod ℓ)).isLocallyConstant.isOpen_fiber 0⟩
    let U₀ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O₀.ι ≫ E.hom)
    let j₀ : U₀ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O₀.ι rfl
    change P.obj.map j₀.op s₂ = P.obj.map j₀.op ((actP 0).hom.app (Opposite.op E) s₁) at h0_eq
    rw [hact_zero_app] at h0_eq
    have hrange : Set.range ⇑(𝟙 E.left) ⊆ Set.range ⇑O₀.ι := by
      rintro x -
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rfl
    let inv₀ : E.left ⟶ O₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O₀.ι (𝟙 E.left) hrange
    have hfac₀ : inv₀ ≫ O₀.ι = 𝟙 E.left :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O₀.ι (𝟙 E.left) hrange
    have hcomm₀ : inv₀ ≫ U₀.hom = E.hom := by
      change inv₀ ≫ O₀.ι ≫ E.hom = E.hom
      rw [← CategoryTheory.Category.assoc, hfac₀, CategoryTheory.Category.id_comp]
    let j₀_inv : E ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk inv₀ hcomm₀
    have hj_id : j₀_inv ≫ j₀ = 𝟙 E := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hfac₀
    have h1 := congrArg (P.obj.map j₀_inv.op) h0_eq
    rw [← hmap_comp, ← hmap_comp, hj_id, hmap_id, hmap_id] at h1
    exact h1.symm

  have hdiff_map : ∀ {E' E : X.Etale} (u : E' ⟶ E)
      (s₁ s₂ : P.obj.obj (Opposite.op E)),
      diff E' (P.obj.map u.op s₁) (P.obj.map u.op s₂) =
        (diff E s₁ s₂).comap ⟨u.left.base, u.left.continuous⟩ := by
    intro E' E u s₁ s₂
    apply hdiff_eq
    letI : AlgebraicGeometry.Etale E.hom := E.prop
    letI : AlgebraicGeometry.Etale E'.hom := E'.prop
    let f := diff E s₁ s₂
    let f' := f.comap ⟨u.left.base, u.left.continuous⟩
    intro γ
    let O_γ : E.left.Opens := ⟨{x | f x = γ}, f.isLocallyConstant.isOpen_fiber γ⟩
    let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
    let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
    let O'_γ : E'.left.Opens := ⟨{y | f' y = γ}, f'.isLocallyConstant.isOpen_fiber γ⟩
    let U'_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O'_γ.ι ≫ E'.hom)
    let j'_γ : U'_γ ⟶ E' := CategoryTheory.MorphismProperty.Over.homMk O'_γ.ι rfl
    have hrange : Set.range ⇑(O'_γ.ι ≫ u.left) ⊆ Set.range ⇑O_γ.ι := by
      rintro _ ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      have hy : O'_γ.ι.base y ∈ Set.range ⇑O'_γ.ι := ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hy
      exact hy
    let u_γ : O'_γ.toScheme ⟶ O_γ.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O_γ.ι (O'_γ.ι ≫ u.left) hrange
    have hfac_γ : u_γ ≫ O_γ.ι = O'_γ.ι ≫ u.left :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O_γ.ι (O'_γ.ι ≫ u.left) hrange
    have hcomm_γ : u_γ ≫ U_γ.hom = U'_γ.hom := by
      change u_γ ≫ O_γ.ι ≫ E.hom = O'_γ.ι ≫ E'.hom
      rw [← CategoryTheory.Category.assoc, hfac_γ, CategoryTheory.Category.assoc,
        CategoryTheory.MorphismProperty.Over.w u]
    let m_γ : U'_γ ⟶ U_γ := CategoryTheory.MorphismProperty.Over.homMk u_γ hcomm_γ
    have hm_eq : m_γ ≫ j_γ = j'_γ ≫ u := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hfac_γ
    change P.obj.map j'_γ.op (P.obj.map u.op s₂) =
      P.obj.map j'_γ.op ((actP γ).hom.app (Opposite.op E') (P.obj.map u.op s₁))
    rw [← hact_nat γ u s₁, ← hmap_comp, ← hmap_comp, ← hm_eq, hmap_comp, hmap_comp]
    exact congrArg (P.obj.map m_γ.op) (hdiff_spec E s₁ s₂ γ)

  have heq_of_pointwise : ∀ {E : X.Etale} (s₁ s₂ : P.obj.obj (Opposite.op E)),
      (∀ x : ↥E.left, ∃ (E' : X.Etale) (u : E' ⟶ E) (y : ↥E'.left),
        u.left.base y = x ∧ P.obj.map u.op s₁ = P.obj.map u.op s₂) → s₁ = s₂ := by
    intro E s₁ s₂ hpt
    apply heq_of_diff_zero E s₁ s₂
    ext x
    obtain ⟨E', u, y, hy, heq⟩ := hpt x
    have hm := congrArg (fun g => g y) (hdiff_map u s₁ s₂)
    rw [heq, hdiff_self] at hm
    change (0 : ZMod ℓ) = diff E s₁ s₂ (u.left.base y) at hm
    rw [hy] at hm
    exact hm.symm

  have hdiff_trans : ∀ (E : X.Etale) (s₁ s₂ s₃ : P.obj.obj (Opposite.op E)),
      diff E s₁ s₃ = diff E s₁ s₂ + diff E s₂ s₃ := by
    intro E s₁ s₂ s₃
    apply hdiff_eq
    let _ : AlgebraicGeometry.Etale E.hom := E.prop
    let f₁₂ := diff E s₁ s₂
    let f₂₃ := diff E s₂ s₃
    let f₁₃ := f₁₂ + f₂₃
    intro γ
    let O_γ : E.left.Opens := ⟨{x | f₁₃ x = γ}, f₁₃.isLocallyConstant.isOpen_fiber γ⟩
    let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
    let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
    let O_αβ : ZMod ℓ → E.left.Opens := fun α =>
      ⟨{x | f₁₂ x = α ∧ f₂₃ x = γ - α},
        (f₁₂.isLocallyConstant.isOpen_fiber α).inter
          (f₂₃.isLocallyConstant.isOpen_fiber (γ - α))⟩
    let U_αβ : ZMod ℓ → X.Etale := fun α =>
      AlgebraicGeometry.Scheme.Etale.mk ((O_αβ α).ι ≫ E.hom)
    have hrange_γ : ∀ α : ZMod ℓ, Set.range ⇑(O_αβ α).ι ⊆ Set.range ⇑O_γ.ι := by
      rintro α _ ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      have hy : (O_αβ α).ι.base y ∈ Set.range ⇑(O_αβ α).ι := ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hy
      change f₁₂ ((O_αβ α).ι.base y) + f₂₃ ((O_αβ α).ι.base y) = γ
      rw [hy.1, hy.2, add_sub_cancel]
    let k_left : ∀ α : ZMod ℓ, (O_αβ α).toScheme ⟶ O_γ.toScheme := fun α =>
      AlgebraicGeometry.IsOpenImmersion.lift O_γ.ι (O_αβ α).ι (hrange_γ α)
    have hk_fac : ∀ α : ZMod ℓ, k_left α ≫ O_γ.ι = (O_αβ α).ι := fun α =>
      AlgebraicGeometry.IsOpenImmersion.lift_fac O_γ.ι (O_αβ α).ι (hrange_γ α)
    let k_α : ∀ α : ZMod ℓ, U_αβ α ⟶ U_γ := fun α =>
      CategoryTheory.MorphismProperty.Over.homMk (k_left α)
        (by change k_left α ≫ O_γ.ι ≫ E.hom = (O_αβ α).ι ≫ E.hom
            rw [← CategoryTheory.Category.assoc, hk_fac α])
    apply heq_of_pointwise
    intro z
    have hz_mem : O_γ.ι.base z ∈ Set.range ⇑O_γ.ι := ⟨z, rfl⟩
    rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hz_mem
    change f₁₂ (O_γ.ι.base z) + f₂₃ (O_γ.ι.base z) = γ at hz_mem
    let α := f₁₂ (O_γ.ι.base z)
    have hx_mem : O_γ.ι.base z ∈ Set.range ⇑(O_αβ α).ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact ⟨rfl, eq_sub_of_add_eq' hz_mem⟩
    obtain ⟨y, hy⟩ := hx_mem
    have hy_eq : (k_α α).left.base y = z := by
      apply O_γ.ι.isOpenEmbedding.injective
      have hcomp := congrArg (fun g : (O_αβ α).toScheme ⟶ E.left => g.base y) (hk_fac α)
      exact hcomp.trans hy
    refine ⟨U_αβ α, k_α α, y, hy_eq, ?_⟩
    let O₁ : E.left.Opens := ⟨{x | f₁₂ x = α}, f₁₂.isLocallyConstant.isOpen_fiber α⟩
    let U₁ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O₁.ι ≫ E.hom)
    let j₁ : U₁ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O₁.ι rfl
    let O₂ : E.left.Opens :=
      ⟨{x | f₂₃ x = γ - α}, f₂₃.isLocallyConstant.isOpen_fiber (γ - α)⟩
    let U₂ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O₂.ι ≫ E.hom)
    let j₂ : U₂ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O₂.ι rfl
    let j_αβ : U_αβ α ⟶ E := CategoryTheory.MorphismProperty.Over.homMk (O_αβ α).ι rfl
    have hj_k : k_α α ≫ j_γ = j_αβ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hk_fac α
    have hr₁ : Set.range ⇑(O_αβ α).ι ⊆ Set.range ⇑O₁.ι := by
      rintro _ ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      have hy : (O_αβ α).ι.base y ∈ Set.range ⇑(O_αβ α).ι := ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hy
      exact hy.1
    let q₁_left := AlgebraicGeometry.IsOpenImmersion.lift O₁.ι (O_αβ α).ι hr₁
    have hq₁_fac : q₁_left ≫ O₁.ι = (O_αβ α).ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O₁.ι (O_αβ α).ι hr₁
    let q₁ : U_αβ α ⟶ U₁ := CategoryTheory.MorphismProperty.Over.homMk q₁_left
      (by change q₁_left ≫ O₁.ι ≫ E.hom = (O_αβ α).ι ≫ E.hom
          rw [← CategoryTheory.Category.assoc, hq₁_fac])
    have hq₁_eq : q₁ ≫ j₁ = j_αβ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hq₁_fac
    have hr₂ : Set.range ⇑(O_αβ α).ι ⊆ Set.range ⇑O₂.ι := by
      rintro _ ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      have hy : (O_αβ α).ι.base y ∈ Set.range ⇑(O_αβ α).ι := ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hy
      exact hy.2
    let q₂_left := AlgebraicGeometry.IsOpenImmersion.lift O₂.ι (O_αβ α).ι hr₂
    have hq₂_fac : q₂_left ≫ O₂.ι = (O_αβ α).ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O₂.ι (O_αβ α).ι hr₂
    let q₂ : U_αβ α ⟶ U₂ := CategoryTheory.MorphismProperty.Over.homMk q₂_left
      (by change q₂_left ≫ O₂.ι ≫ E.hom = (O_αβ α).ι ≫ E.hom
          rw [← CategoryTheory.Category.assoc, hq₂_fac])
    have hq₂_eq : q₂ ≫ j₂ = j_αβ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hq₂_fac
    calc
      P.obj.map (k_α α).op (P.obj.map j_γ.op s₃)
        = P.obj.map j_αβ.op s₃ := by rw [← hmap_comp, hj_k]
      _ = P.obj.map q₂.op (P.obj.map j₂.op s₃) := by rw [← hq₂_eq, hmap_comp]
      _ = P.obj.map q₂.op (P.obj.map j₂.op ((actP (γ - α)).hom.app (Opposite.op E) s₂)) := by
          exact congrArg (P.obj.map q₂.op) (hdiff_spec E s₂ s₃ (γ - α))
      _ = P.obj.map j_αβ.op ((actP (γ - α)).hom.app (Opposite.op E) s₂) := by
          rw [← hmap_comp, hq₂_eq]
      _ = (actP (γ - α)).hom.app (Opposite.op (U_αβ α)) (P.obj.map j_αβ.op s₂) :=
          hact_nat (γ - α) j_αβ s₂
      _ = (actP (γ - α)).hom.app (Opposite.op (U_αβ α)) (P.obj.map q₁.op (P.obj.map j₁.op s₂)) := by
          rw [← hmap_comp, hq₁_eq]
      _ = (actP (γ - α)).hom.app (Opposite.op (U_αβ α))
            (P.obj.map q₁.op (P.obj.map j₁.op ((actP α).hom.app (Opposite.op E) s₁))) := by
          rw [congrArg (P.obj.map q₁.op) (hdiff_spec E s₁ s₂ α)]
      _ = (actP (γ - α)).hom.app (Opposite.op (U_αβ α))
            (P.obj.map j_αβ.op ((actP α).hom.app (Opposite.op E) s₁)) := by
          rw [← hmap_comp, hq₁_eq]
      _ = P.obj.map j_αβ.op
            ((actP (γ - α)).hom.app (Opposite.op E) ((actP α).hom.app (Opposite.op E) s₁)) :=
          (hact_nat (γ - α) j_αβ ((actP α).hom.app (Opposite.op E) s₁)).symm
      _ = P.obj.map j_αβ.op ((actP γ).hom.app (Opposite.op E) s₁) := by
          rw [← hact_add_app α (γ - α), add_sub_cancel]
      _ = P.obj.map (k_α α).op (P.obj.map j_γ.op ((actP γ).hom.app (Opposite.op E) s₁)) := by
          rw [← hmap_comp, hj_k]

  have hdiff_symm : ∀ (E : X.Etale) (s₁ s₂ : P.obj.obj (Opposite.op E)),
      diff E s₂ s₁ = - diff E s₁ s₂ := by
    intro E s₁ s₂
    have h := hdiff_trans E s₁ s₂ s₁
    rw [hdiff_self] at h
    exact eq_neg_of_add_eq_zero_right h.symm

  
  let IsIdempFrame : ∀ {S : Type u} [CommRing S], (ZMod ℓ → S) → Prop :=
    fun c => (∀ δ : ZMod ℓ, c δ * c δ = c δ) ∧
      (∀ δ₁ δ₂ : ZMod ℓ, δ₁ ≠ δ₂ → c δ₁ * c δ₂ = 0) ∧
      (∑ δ : ZMod ℓ, c δ) = 1

  let specBasicOpen : ∀ (R₀ : CommRingCat.{u}), ↑R₀ → (AlgebraicGeometry.Spec R₀).Opens :=
    fun R₀ r => (AlgebraicGeometry.Spec R₀).basicOpen
      ((AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv.hom r)

  have hbo_mul : ∀ (R₀ : CommRingCat.{u}) (r₁ r₂ : ↑R₀),
      specBasicOpen R₀ (r₁ * r₂) = specBasicOpen R₀ r₁ ⊓ specBasicOpen R₀ r₂ := by
    intro R₀ r₁ r₂
    dsimp [specBasicOpen]
    rw [map_mul, (AlgebraicGeometry.Spec R₀).basicOpen_mul]

  have hbo_zero : ∀ (R₀ : CommRingCat.{u}), specBasicOpen R₀ 0 = ⊥ := by
    intro R₀
    dsimp [specBasicOpen]
    rw [map_zero, (AlgebraicGeometry.Spec R₀).basicOpen_zero]

  have hbo_one : ∀ (R₀ : CommRingCat.{u}), specBasicOpen R₀ 1 = ⊤ := by
    intro R₀
    dsimp [specBasicOpen]
    rw [map_one]
    exact (AlgebraicGeometry.Spec R₀).basicOpen_of_isUnit isUnit_one

  let frameOfLocConst : ∀ (R₀ : CommRingCat.{u}),
      LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ) → (ZMod ℓ → ↑R₀) :=
    fun R₀ u δ =>
      (AlgebraicGeometry.Scheme.ΓSpecIso R₀).hom.hom
        ((hIdemp1 (AlgebraicGeometry.Spec R₀) u).choose δ)

  have hframe_spec : ∀ (R₀ : CommRingCat.{u})
      (u : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ)),
      IsIdempFrame (frameOfLocConst R₀ u) ∧
      ∀ δ : ZMod ℓ, specBasicOpen R₀ (frameOfLocConst R₀ u δ) =
        ⟨{z : ↥(AlgebraicGeometry.Spec R₀) | u z = δ}, u.isLocallyConstant.isOpen_fiber δ⟩ := by
    intro R₀ u
    rcases (hIdemp1 (AlgebraicGeometry.Spec R₀) u).choose_spec with
      ⟨he_idem, he_orth, he_sum, he_bo⟩
    refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
    · intro δ
      dsimp [frameOfLocConst]
      rw [← map_mul, he_idem δ]
    · intro δ₁ δ₂ hne
      dsimp [frameOfLocConst]
      rw [← map_mul, he_orth δ₁ δ₂ hne, map_zero]
    · dsimp [frameOfLocConst]
      rw [← map_sum, he_sum, map_one]
    · intro δ
      dsimp [specBasicOpen, frameOfLocConst]
      have hinv : (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso R₀).hom.hom
            ((hIdemp1 (AlgebraicGeometry.Spec R₀) u).choose δ)) =
          (hIdemp1 (AlgebraicGeometry.Spec R₀) u).choose δ :=
        CategoryTheory.ConcreteCategory.congr_hom
          (AlgebraicGeometry.Scheme.ΓSpecIso R₀).hom_inv_id _
      rw [hinv, he_bo δ]

  have hframe_eq_of_mem : ∀ (R₀ : CommRingCat.{u})
      (u : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ))
      (c : ZMod ℓ → ↑R₀),
      IsIdempFrame c →
      (∀ (δ : ZMod ℓ) (z : ↥(AlgebraicGeometry.Spec R₀)),
        z ∈ specBasicOpen R₀ (c δ) ↔ u z = δ) →
      frameOfLocConst R₀ u = c := by
    intro R₀ u c hc hmem
    obtain ⟨hfu_frame, hfu_bo⟩ := hframe_spec R₀ u
    funext δ
    apply hIdemp2 R₀ _ _ (hfu_frame.1 δ) (hc.1 δ)
    ext z
    change z ∈ specBasicOpen R₀ (frameOfLocConst R₀ u δ) ↔ z ∈ specBasicOpen R₀ (c δ)
    rw [hfu_bo δ]
    exact (hmem δ z).symm

  have hframe_inj : ∀ (R₀ : CommRingCat.{u})
      (u₁ u₂ : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ)),
      frameOfLocConst R₀ u₁ = frameOfLocConst R₀ u₂ → u₁ = u₂ := by
    intro R₀ u₁ u₂ heq
    ext z
    have h₁ := (hframe_spec R₀ u₁).2 (u₁ z)
    have h₂ := (hframe_spec R₀ u₂).2 (u₁ z)
    have hz : z ∈ specBasicOpen R₀ (frameOfLocConst R₀ u₁ (u₁ z)) := by
      rw [h₁]; exact rfl
    rw [heq, h₂] at hz
    exact hz.symm

  have hframe_surj : ∀ (R₀ : CommRingCat.{u}) (c : ZMod ℓ → ↑R₀),
      IsIdempFrame c →
      ∃ u : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ),
        frameOfLocConst R₀ u = c := by
    intro R₀ c hc
    obtain ⟨u, hu⟩ := hIdemp3 R₀ c hc.1 hc.2.1 hc.2.2
    refine ⟨u, hframe_eq_of_mem R₀ u c hc ?_⟩
    intro δ z
    dsimp [specBasicOpen]
    rw [← hu δ]
    rfl

  have hframe_zero_eval : ∀ (R₀ : CommRingCat.{u}),
      frameOfLocConst R₀ 0 0 = 1 := by
    intro R₀
    let c₀ : ZMod ℓ → ↑R₀ := fun δ => if δ = 0 then 1 else 0
    have hc₀ : IsIdempFrame c₀ := by
      refine ⟨?_, ?_, ?_⟩
      · intro δ; dsimp [c₀]; split_ifs <;> simp
      · intro δ₁ δ₂ hne; dsimp [c₀]; split_ifs with h₁ h₂
        · exact (hne (h₁.trans h₂.symm)).elim
        · simp
        · simp
        · simp
      · dsimp [c₀]; simp
    have h := hframe_eq_of_mem R₀ 0 c₀ hc₀ (by
      intro δ z
      dsimp [c₀]
      split_ifs with hδ
      · subst hδ
        rw [hbo_one]
        exact ⟨fun _ => rfl, fun _ => trivial⟩
      · rw [hbo_zero]
        exact ⟨fun hz => False.elim hz, fun hz => (hδ hz.symm).elim⟩)
    simpa [c₀] using congrFun h 0

  have hframe_comap : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
      (φ : R₁ →+* R₂)
      (u : LocallyConstant ↥(AlgebraicGeometry.Spec (CommRingCat.of R₁)) (ZMod ℓ))
      (δ : ZMod ℓ),
      let g := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
      frameOfLocConst (CommRingCat.of R₂) (u.comap ⟨g.base, g.continuous⟩) δ =
        φ (frameOfLocConst (CommRingCat.of R₁) u δ) := by
    intro R₁ R₂ _ _ φ u δ g
    obtain ⟨hc₁, hbo₁⟩ := hframe_spec (CommRingCat.of R₁) u
    let c₂ : ZMod ℓ → R₂ := fun α => φ (frameOfLocConst (CommRingCat.of R₁) u α)
    have hc₂ : IsIdempFrame c₂ := by
      refine ⟨fun α => ?_, fun α₁ α₂ hne => ?_, ?_⟩
      · dsimp [c₂]; rw [← map_mul, hc₁.1 α]
      · dsimp [c₂]; rw [← map_mul, hc₁.2.1 α₁ α₂ hne, map_zero]
      · dsimp [c₂]; rw [← map_sum, hc₁.2.2, map_one]
    have heq := hframe_eq_of_mem (CommRingCat.of R₂) (u.comap ⟨g.base, g.continuous⟩) c₂ hc₂ (by
      intro α z
      dsimp [c₂, specBasicOpen]
      have hnat := CategoryTheory.ConcreteCategory.congr_hom
        (AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ))
        (frameOfLocConst (CommRingCat.of R₁) u α)
      have hpre := AlgebraicGeometry.Scheme.Hom.preimage_basicOpen_top g
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₁)).inv.hom
          (frameOfLocConst (CommRingCat.of R₁) u α))
      have hbo_eq : (AlgebraicGeometry.Spec (CommRingCat.of R₂)).basicOpen
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₂)).inv.hom
            (φ (frameOfLocConst (CommRingCat.of R₁) u α))) =
          g ⁻¹ᵁ specBasicOpen (CommRingCat.of R₁) (frameOfLocConst (CommRingCat.of R₁) u α) := by
        dsimp [specBasicOpen]
        rw [hpre]
        exact congrArg (AlgebraicGeometry.Spec (CommRingCat.of R₂)).basicOpen hnat
      rw [hbo_eq]
      change g.base z ∈ specBasicOpen (CommRingCat.of R₁)
        (frameOfLocConst (CommRingCat.of R₁) u α) ↔ u (g.base z) = α
      rw [hbo₁ α]
      rfl)
    exact congrFun heq δ

  have hframe_add_const : ∀ (R₀ : CommRingCat.{u})
      (u : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ)) (γ α : ZMod ℓ),
      frameOfLocConst R₀ (u + LocallyConstant.const _ γ) α =
        frameOfLocConst R₀ u (α - γ) := by
    intro R₀ u γ α
    obtain ⟨hc, hbo⟩ := hframe_spec R₀ u
    let c' : ZMod ℓ → ↑R₀ := fun β => frameOfLocConst R₀ u (β - γ)
    have hc' : IsIdempFrame c' := by
      refine ⟨fun β => hc.1 (β - γ), fun β₁ β₂ hne => hc.2.1 _ _ ?_, ?_⟩
      · intro hsub; exact hne (sub_left_inj.mp hsub)
      · exact (Equiv.sum_comp (Equiv.subRight γ) (frameOfLocConst R₀ u)).trans hc.2.2
    have heq := hframe_eq_of_mem R₀ (u + LocallyConstant.const _ γ) c' hc' (by
      intro β z
      dsimp [c']
      rw [hbo (β - γ)]
      change u z = β - γ ↔ u z + γ = β
      exact eq_sub_iff_add_eq)
    exact congrFun heq α

  have hframe_neg : ∀ (R₀ : CommRingCat.{u})
      (u : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ)) (α : ZMod ℓ),
      frameOfLocConst R₀ (-u) α = frameOfLocConst R₀ u (-α) := by
    intro R₀ u α
    obtain ⟨hc, hbo⟩ := hframe_spec R₀ u
    let c' : ZMod ℓ → ↑R₀ := fun β => frameOfLocConst R₀ u (-β)
    have hc' : IsIdempFrame c' := by
      refine ⟨fun β => hc.1 (-β), fun β₁ β₂ hne => hc.2.1 _ _ (neg_inj.ne.mpr hne), ?_⟩
      exact (Equiv.sum_comp (Equiv.neg (ZMod ℓ)) (frameOfLocConst R₀ u)).trans hc.2.2
    have heq := hframe_eq_of_mem R₀ (-u) c' hc' (by
      intro β z
      dsimp [c']
      rw [hbo (-β)]
      change u z = -β ↔ - u z = β
      exact ⟨fun h => by rw [h, neg_neg], fun h => by rw [← h, neg_neg]⟩)
    exact congrFun heq α

  have hframe_add : ∀ (R₀ : CommRingCat.{u})
      (u₁ u₂ : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ)) (γ : ZMod ℓ),
      frameOfLocConst R₀ (u₁ + u₂) γ =
        ∑ α : ZMod ℓ, frameOfLocConst R₀ u₁ α * frameOfLocConst R₀ u₂ (γ - α) := by
    intro R₀ u₁ u₂ γ
    let c₁ := frameOfLocConst R₀ u₁
    let c₂ := frameOfLocConst R₀ u₂
    obtain ⟨hc₁, hbo₁⟩ := hframe_spec R₀ u₁
    obtain ⟨hc₂, hbo₂⟩ := hframe_spec R₀ u₂
    change IsIdempFrame c₁ at hc₁
    change IsIdempFrame c₂ at hc₂
    let w : ZMod ℓ → ZMod ℓ → ↑R₀ := fun β α => c₁ α * c₂ (β - α)
    have hw_mul : ∀ (β₁ β₂ α₁ α₂ : ZMod ℓ),
        w β₁ α₁ * w β₂ α₂ = if β₁ = β₂ ∧ α₁ = α₂ then w β₁ α₁ else 0 := by
      intro β₁ β₂ α₁ α₂
      dsimp [w]
      have hcomm : (c₁ α₁ * c₂ (β₁ - α₁)) * (c₁ α₂ * c₂ (β₂ - α₂)) =
          (c₁ α₁ * c₁ α₂) * (c₂ (β₁ - α₁) * c₂ (β₂ - α₂)) := by ring
      rw [hcomm]
      by_cases hα : α₁ = α₂
      · subst hα
        rw [hc₁.1 α₁]
        by_cases hβ : β₁ = β₂
        · subst hβ
          rw [hc₂.1 (β₁ - α₁)]
          simp
        · have hsub : β₁ - α₁ ≠ β₂ - α₁ := fun h => hβ (sub_left_inj.mp h)
          rw [hc₂.2.1 _ _ hsub, mul_zero]
          simp [hβ]
      · rw [hc₁.2.1 _ _ hα, zero_mul]
        simp [hα]
    let b : ZMod ℓ → ↑R₀ := fun β => ∑ α : ZMod ℓ, w β α
    have hb : IsIdempFrame b := by
      refine ⟨?_, ?_, ?_⟩
      · intro β
        dsimp [b]
        rw [Finset.sum_mul_sum]
        apply Finset.sum_congr rfl
        intro α₁ _
        rw [Finset.sum_eq_single α₁]
        · simp [hw_mul]
        · intro α₂ _ hne; simp [hw_mul, Ne.symm hne]
        · intro h; exact (h (Finset.mem_univ α₁)).elim
      · intro β₁ β₂ hne
        dsimp [b]
        rw [Finset.sum_mul_sum]
        apply Finset.sum_eq_zero
        intro α₁ _
        apply Finset.sum_eq_zero
        intro α₂ _
        simp [hw_mul, hne]
      · dsimp [b, w]
        rw [Finset.sum_comm]
        calc
          (∑ α : ZMod ℓ, ∑ β : ZMod ℓ, c₁ α * c₂ (β - α))
            = ∑ α : ZMod ℓ, c₁ α * (∑ β : ZMod ℓ, c₂ (β - α)) := by
                apply Finset.sum_congr rfl
                intro α _; rw [← Finset.mul_sum]
          _ = ∑ α : ZMod ℓ, c₁ α * 1 := by
                apply Finset.sum_congr rfl
                intro α _
                congr 1
                exact (Equiv.sum_comp (Equiv.subRight α) c₂).trans hc₂.2.2
          _ = 1 := by
                simp only [mul_one]
                exact hc₁.2.2
    have heq := hframe_eq_of_mem R₀ (u₁ + u₂) b hb (by
      intro β z
      let α₀ := u₁ z
      let δ₀ := u₂ z
      have hz₁ : z ∈ specBasicOpen R₀ (c₁ α₀) := by rw [hbo₁ α₀]; rfl
      have hz₂ : z ∈ specBasicOpen R₀ (c₂ δ₀) := by rw [hbo₂ δ₀]; rfl
      constructor
      · intro hzb
        by_contra hsum
        have hzero : (c₁ α₀ * c₂ δ₀) * b β = 0 := by
          dsimp [b, w]
          rw [Finset.mul_sum]
          apply Finset.sum_eq_zero
          intro α _
          have hr : (c₁ α₀ * c₂ δ₀) * (c₁ α * c₂ (β - α)) =
              (c₁ α₀ * c₁ α) * (c₂ δ₀ * c₂ (β - α)) := by ring
          rw [hr]
          by_cases hα : α₀ = α
          · subst hα
            have hδ : δ₀ ≠ β - α₀ := fun h => hsum (by change α₀ + δ₀ = β; rw [h, add_sub_cancel])
            rw [hc₁.1 α₀, hc₂.2.1 _ _ hδ, mul_zero]
          · rw [hc₁.2.1 _ _ hα, zero_mul]
        have hz0 : z ∈ specBasicOpen R₀ ((c₁ α₀ * c₂ δ₀) * b β) := by
          rw [hbo_mul, hbo_mul]
          exact ⟨⟨hz₁, hz₂⟩, hzb⟩
        rw [hzero, hbo_zero] at hz0
        exact hz0
      · intro hsum
        change α₀ + δ₀ = β at hsum
        have hδ : δ₀ = β - α₀ := eq_sub_of_add_eq' hsum
        have hwb : w β α₀ * b β = w β α₀ := by
          dsimp [b]
          rw [Finset.mul_sum, Finset.sum_eq_single α₀]
          · simp [hw_mul]
          · intro α _ hne; simp [hw_mul, Ne.symm hne]
          · intro h; exact (h (Finset.mem_univ α₀)).elim
        have hzw : z ∈ specBasicOpen R₀ (w β α₀) := by
          dsimp [w]
          rw [← hδ, hbo_mul]
          exact ⟨hz₁, hz₂⟩
        rw [← hwb, hbo_mul] at hzw
        exact hzw.2)
    exact congrFun heq γ

  have hframe_sub : ∀ (R₀ : CommRingCat.{u})
      (u₁ u₂ : LocallyConstant ↥(AlgebraicGeometry.Spec R₀) (ZMod ℓ)) (γ : ZMod ℓ),
      frameOfLocConst R₀ (u₁ - u₂) γ =
        ∑ δ : ZMod ℓ, frameOfLocConst R₀ u₁ (γ + δ) * frameOfLocConst R₀ u₂ δ := by
    intro R₀ u₁ u₂ γ
    rw [sub_eq_add_neg, hframe_add]
    calc
      (∑ α : ZMod ℓ, frameOfLocConst R₀ u₁ α * frameOfLocConst R₀ (-u₂) (γ - α))
        = ∑ α : ZMod ℓ, frameOfLocConst R₀ u₁ α * frameOfLocConst R₀ u₂ (α - γ) := by
            apply Finset.sum_congr rfl
            intro α _
            rw [hframe_neg, neg_sub]
      _ = ∑ δ : ZMod ℓ, frameOfLocConst R₀ u₁ (γ + δ) * frameOfLocConst R₀ u₂ δ := by
            rw [← Equiv.sum_comp (Equiv.addLeft γ)]
            apply Finset.sum_congr rfl
            intro δ _
            simp [Equiv.addLeft]

  
  let A₀ : CommRingCat.{u} := X.presheaf.obj (Opposite.op U.1)
  let A : Type u := ↑A₀
  let e_U : U.1.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of A) := U.2.isoSpec
  obtain ⟨D₀, p_V, hEt_V, hSurj_V, ⟨s_V⟩⟩ := hLocTriv U
  let D : Type u := ↑D₀
  let α_D : CommRingCat.of A ⟶ CommRingCat.of D :=
    AlgebraicGeometry.Spec.preimage (p_V ≫ e_U.hom)
  letI : Algebra A D := α_D.hom.toAlgebra
  have hα_D_eq : CommRingCat.ofHom (algebraMap A D) = α_D := rfl
  have hp_V_hom : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A D)) =
      p_V ≫ e_U.hom := by
    rw [hα_D_eq]
    exact AlgebraicGeometry.Spec.map_preimage (p_V ≫ e_U.hom)
  have hp_V : p_V = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A D)) ≫ e_U.inv := by
    rw [hp_V_hom, CategoryTheory.Category.assoc, e_U.hom_inv_id, CategoryTheory.Category.comp_id]

  have hEt_SpecAD : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A D))) := by
    rw [hp_V_hom]
    letI := hEt_V
    infer_instance
  have hFlat_SpecAD : AlgebraicGeometry.Flat
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A D))) := by
    letI := hEt_SpecAD
    infer_instance
  have hSurj_SpecAD : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A D))) := by
    rw [hp_V_hom]
    letI := hSurj_V
    infer_instance
  have hFF : (algebraMap A D).FaithfullyFlat :=
    (AlgebraicGeometry.flat_and_surjective_SpecMap_iff
      (CommRingCat.ofHom (algebraMap A D))).mp ⟨hFlat_SpecAD, hSurj_SpecAD⟩
  have hEt_AD : Algebra.Etale A D :=
    RingHom.etale_algebraMap.mp
      ((AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mp hEt_SpecAD)
  haveI : Algebra.Etale A D := hEt_AD
  haveI : Module.FaithfullyFlat A D := RingHom.faithfullyFlat_algebraMap_iff.mp hFF

  letI : AlgebraicGeometry.Etale p_V := hEt_V
  let E_V : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (p_V ≫ U.1.ι)
  let W₂₀ : CommRingCat.{u} := CommRingCat.of (TensorProduct A D D)
  let W₂ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec W₂₀
  let π₁ : W₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of D) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
  let π₂ : W₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of D) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
  have hEt_π₁ : AlgebraicGeometry.Etale π₁ := by
    haveI : Algebra.Etale D (TensorProduct A D D) := Algebra.Etale.baseChange A D D
    have hring : Algebra.TensorProduct.includeLeftRingHom =
        algebraMap D (TensorProduct A D D) := rfl
    dsimp [π₁]
    rw [hring]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  haveI : AlgebraicGeometry.Etale π₁ := hEt_π₁
  have hπ_comm : π₂ ≫ p_V = π₁ ≫ p_V := by
    rw [hp_V, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
    congr 1
    dsimp [π₁, π₂]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.Hom.ext
    exact Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap.symm
  let E_W₂ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (π₁ ≫ p_V ≫ U.1.ι)
  let m₁ : E_W₂ ⟶ E_V := CategoryTheory.MorphismProperty.Over.homMk π₁ rfl
  let m₂ : E_W₂ ⟶ E_V := CategoryTheory.MorphismProperty.Over.homMk π₂
    (by change π₂ ≫ p_V ≫ U.1.ι = π₁ ≫ p_V ≫ U.1.ι
        rw [← CategoryTheory.Category.assoc, hπ_comm, CategoryTheory.Category.assoc])
  let f₁₂ : LocallyConstant ↥W₂ (ZMod ℓ) :=
    diff E_W₂ (P.obj.map m₁.op s_V) (P.obj.map m₂.op s_V)
  let e₁₂ : ZMod ℓ → TensorProduct A D D := frameOfLocConst W₂₀ f₁₂
  obtain ⟨⟨he_idem, he_orth, he_sum⟩, _⟩ := hframe_spec W₂₀ f₁₂

  have he_diag : Algebra.TensorProduct.lmul' A (S := D) (e₁₂ 0) = 1 := by
    let μ_D := Algebra.TensorProduct.lmul' A (S := D)
    let Δ : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ W₂ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_D.toRingHom)
    have hΔ₁ : Δ ≫ π₁ = 𝟙 _ := by
      dsimp [Δ, π₁]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
      congr 1
      ext d
      exact Algebra.TensorProduct.lmul'_apply_tmul d 1 |>.trans (mul_one d)
    have hΔ₂ : Δ ≫ π₂ = 𝟙 _ := by
      dsimp [Δ, π₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
      congr 1
      ext d
      exact Algebra.TensorProduct.lmul'_apply_tmul 1 d |>.trans (one_mul d)
    let m_Δ : E_V ⟶ E_W₂ := CategoryTheory.MorphismProperty.Over.homMk Δ
      (by change Δ ≫ π₁ ≫ p_V ≫ U.1.ι = p_V ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc, hΔ₁, CategoryTheory.Category.id_comp])
    have hm_Δ₁ : m_Δ ≫ m₁ = 𝟙 E_V := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hΔ₁
    have hm_Δ₂ : m_Δ ≫ m₂ = 𝟙 E_V := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hΔ₂
    have hf_Δ : f₁₂.comap ⟨Δ.base, Δ.continuous⟩ = 0 := by
      change (diff E_W₂ (P.obj.map m₁.op s_V) (P.obj.map m₂.op s_V)).comap
        ⟨m_Δ.left.base, m_Δ.left.continuous⟩ = 0
      rw [← hdiff_map m_Δ, ← hmap_comp, ← hmap_comp, hm_Δ₁, hm_Δ₂, hmap_id, hdiff_self]
    have hcom := hframe_comap μ_D.toRingHom f₁₂ 0
    change frameOfLocConst (CommRingCat.of D) (f₁₂.comap ⟨Δ.base, Δ.continuous⟩) 0 =
      μ_D (e₁₂ 0) at hcom
    rw [hf_Δ, hframe_zero_eval] at hcom
    exact hcom.symm

  have he_cocycle : ∀ γ : ZMod ℓ,
      let ι₁₂ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A D D) D :=
        Algebra.TensorProduct.includeLeft
      let ι₂₃ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A D D) D :=
        (Algebra.TensorProduct.assoc A A A D D D).symm.toAlgHom.comp
          Algebra.TensorProduct.includeRight
      let ι₁₃ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A D D) D :=
        (Algebra.TensorProduct.assoc A A A D D D).symm.toAlgHom.comp
          (Algebra.TensorProduct.map (AlgHom.id A D) Algebra.TensorProduct.includeRight)
      ι₁₃ (e₁₂ γ) = ∑ α : ZMod ℓ, ι₁₂ (e₁₂ α) * ι₂₃ (e₁₂ (γ - α)) := by
    intro γ ι₁₂ ι₂₃ ι₁₃
    let W₃₀ : CommRingCat.{u} := CommRingCat.of (TensorProduct A (TensorProduct A D D) D)
    let W₃ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec W₃₀
    let p₁₂ : W₃ ⟶ W₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₂.toRingHom)
    let p₂₃ : W₃ ⟶ W₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂₃.toRingHom)
    let p₁₃ : W₃ ⟶ W₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₃.toRingHom)
    have hEt_p₁₂ : AlgebraicGeometry.Etale p₁₂ := by
      have hEt_alg : Algebra.Etale (TensorProduct A D D)
          (TensorProduct A (TensorProduct A D D) D) :=
        Algebra.Etale.baseChange A D (TensorProduct A D D)
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hEt_alg)
    haveI : AlgebraicGeometry.Etale p₁₂ := hEt_p₁₂
    have hp_13_1 : p₁₃ ≫ π₁ = p₁₂ ≫ π₁ := by
      dsimp [p₁₃, p₁₂, π₁]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    have hp_23_1 : p₂₃ ≫ π₁ = p₁₂ ≫ π₂ := by
      dsimp [p₂₃, p₁₂, π₁, π₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    have hp_13_2 : p₁₃ ≫ π₂ = p₂₃ ≫ π₂ := by
      dsimp [p₁₃, p₂₃, π₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    let E_W₃ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (p₁₂ ≫ π₁ ≫ p_V ≫ U.1.ι)
    let m_p₁₂ : E_W₃ ⟶ E_W₂ := CategoryTheory.MorphismProperty.Over.homMk p₁₂ rfl
    let m_p₂₃ : E_W₃ ⟶ E_W₂ := CategoryTheory.MorphismProperty.Over.homMk p₂₃
      (by change p₂₃ ≫ π₁ ≫ p_V ≫ U.1.ι = p₁₂ ≫ π₁ ≫ p_V ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc p₂₃, hp_23_1,
            CategoryTheory.Category.assoc p₁₂ π₂, ← CategoryTheory.Category.assoc π₂,
            hπ_comm, CategoryTheory.Category.assoc])
    let m_p₁₃ : E_W₃ ⟶ E_W₂ := CategoryTheory.MorphismProperty.Over.homMk p₁₃
      (by change p₁₃ ≫ π₁ ≫ p_V ≫ U.1.ι = p₁₂ ≫ π₁ ≫ p_V ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc p₁₃, hp_13_1, CategoryTheory.Category.assoc])
    have hm_13_1 : m_p₁₃ ≫ m₁ = m_p₁₂ ≫ m₁ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hp_13_1
    have hm_23_1 : m_p₂₃ ≫ m₁ = m_p₁₂ ≫ m₂ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hp_23_1
    have hm_13_2 : m_p₁₃ ≫ m₂ = m_p₂₃ ≫ m₂ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hp_13_2
    let t₁ := P.obj.map m_p₁₂.op (P.obj.map m₁.op s_V)
    let t₂ := P.obj.map m_p₁₂.op (P.obj.map m₂.op s_V)
    let t₃ := P.obj.map m_p₂₃.op (P.obj.map m₂.op s_V)
    have hd₁₃ : diff E_W₃ t₁ t₃ = f₁₂.comap ⟨p₁₃.base, p₁₃.continuous⟩ := by
      change diff E_W₃ (P.obj.map m_p₁₂.op (P.obj.map m₁.op s_V))
        (P.obj.map m_p₂₃.op (P.obj.map m₂.op s_V)) = _
      rw [← hmap_comp m_p₁₂ m₁, ← hmap_comp m_p₂₃ m₂, ← hm_13_1, ← hm_13_2,
        hmap_comp m_p₁₃ m₁, hmap_comp m_p₁₃ m₂]
      exact hdiff_map m_p₁₃ _ _
    have hd₁₂ : diff E_W₃ t₁ t₂ = f₁₂.comap ⟨p₁₂.base, p₁₂.continuous⟩ :=
      hdiff_map m_p₁₂ _ _
    have hd₂₃ : diff E_W₃ t₂ t₃ = f₁₂.comap ⟨p₂₃.base, p₂₃.continuous⟩ := by
      change diff E_W₃ (P.obj.map m_p₁₂.op (P.obj.map m₂.op s_V))
        (P.obj.map m_p₂₃.op (P.obj.map m₂.op s_V)) = _
      rw [← hmap_comp m_p₁₂ m₂, ← hm_23_1, hmap_comp m_p₂₃ m₁]
      exact hdiff_map m_p₂₃ _ _
    have hcoc_lc : f₁₂.comap ⟨p₁₃.base, p₁₃.continuous⟩ =
        f₁₂.comap ⟨p₁₂.base, p₁₂.continuous⟩ + f₁₂.comap ⟨p₂₃.base, p₂₃.continuous⟩ := by
      rw [← hd₁₃, ← hd₁₂, ← hd₂₃]
      exact hdiff_trans E_W₃ t₁ t₂ t₃
    have hlhs := hframe_comap ι₁₃.toRingHom f₁₂ γ
    change frameOfLocConst W₃₀ (f₁₂.comap ⟨p₁₃.base, p₁₃.continuous⟩) γ = ι₁₃ (e₁₂ γ) at hlhs
    rw [hcoc_lc, hframe_add] at hlhs
    rw [← hlhs]
    apply Finset.sum_congr rfl
    intro α _
    have hc₁ := hframe_comap ι₁₂.toRingHom f₁₂ α
    have hc₂ := hframe_comap ι₂₃.toRingHom f₁₂ (γ - α)
    exact congrArg₂ (· * ·) hc₁ hc₂

  obtain ⟨hAmitsur, B, hB_mem, hFin_B, hEt_B, ⟨e_triv_D, he_triv_D⟩⟩ :=
    hAlg A D hFF hEt_AD e₁₂ he_idem he_orth he_sum he_diag he_cocycle

  
  let σ : ZMod ℓ → (↥B →ₐ[A] ↥B) := fun γ =>
    { toFun := fun b => ⟨fun α => b.1 (α + γ), by
        rw [hB_mem]
        intro α
        have hb := (hB_mem b.1).mp b.2 (α + γ)
        rw [hb]
        apply Finset.sum_congr rfl
        intro δ _
        rw [add_right_comm]⟩
      map_one' := by ext α; rfl
      map_mul' := fun x y => by ext α; rfl
      map_zero' := by ext α; rfl
      map_add' := fun x y => by ext α; rfl
      commutes' := fun a => by ext α; rfl }

  have hσ0 : σ 0 = AlgHom.id A ↥B := by
    ext b α
    change b.1 (α + 0) = b.1 α
    rw [add_zero]

  have hσ_add : ∀ γ₁ γ₂ : ZMod ℓ, σ (γ₁ + γ₂) = (σ γ₁).comp (σ γ₂) := by
    intro γ₁ γ₂
    ext b α
    change b.1 (α + (γ₁ + γ₂)) = b.1 ((α + γ₁) + γ₂)
    rw [add_assoc]

  have heq_on_ZModD : ∀ {M : Type u} [AddCommMonoid M]
      (F₁ F₂ : (ZMod ℓ → D) →+ M),
      (∀ (d : D) (b : ↥B), F₁ ((fun _ => d) * b.1) = F₂ ((fun _ => d) * b.1)) →
      ∀ f : ZMod ℓ → D, F₁ f = F₂ f := by
    intro M _ F₁ F₂ hdb f
    have hkey : ∀ z : TensorProduct A D ↥B, F₁ (e_triv_D z) = F₂ (e_triv_D z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul d b =>
          have htriv : e_triv_D (TensorProduct.tmul A d b) = (fun _ => d) * b.1 := by
            funext γ; exact he_triv_D d b γ
          rw [htriv]
          exact hdb d b
      | add x y ihx ihy =>
          rw [map_add, map_add, map_add, ihx, ihy]
    rw [← e_triv_D.apply_symm_apply f]
    exact hkey (e_triv_D.symm f)

  let Ψ : ∀ {R : Type u} [CommRing R] [Algebra A R],
      (↥B →ₐ[A] R) → ((ZMod ℓ → D) →+* TensorProduct A R D) :=
    fun φ => (Algebra.TensorProduct.map φ (AlgHom.id A D)).toRingHom.comp
      ((Algebra.TensorProduct.comm A D ↥B).toRingHom.comp e_triv_D.symm.toRingHom)

  let c_of : ∀ {R : Type u} [CommRing R] [Algebra A R],
      (↥B →ₐ[A] R) → (ZMod ℓ → TensorProduct A R D) :=
    fun φ α => Ψ φ (Pi.single α 1)

  have hΨ_db : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (φ : ↥B →ₐ[A] R) (d : D) (b : ↥B),
      Ψ φ ((fun _ => d) * b.1) = TensorProduct.tmul A (φ b) d := by
    intro R _ _ φ d b
    have htriv : e_triv_D (TensorProduct.tmul A d b) = (fun _ => d) * b.1 := by
      funext γ; exact he_triv_D d b γ
    change (Algebra.TensorProduct.map φ (AlgHom.id A D))
      ((Algebra.TensorProduct.comm A D ↥B) (e_triv_D.symm ((fun _ => d) * b.1))) =
      TensorProduct.tmul A (φ b) d
    rw [← htriv, e_triv_D.symm_apply_apply]
    rfl

  have hΨ_b : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (φ : ↥B →ₐ[A] R) (b : ↥B),
      Ψ φ b.1 = TensorProduct.tmul A (φ b) (1 : D) := by
    intro R _ _ φ b
    have h1 : (fun _ : ZMod ℓ => (1 : D)) * b.1 = b.1 := by funext γ; exact one_mul (b.1 γ)
    rw [← h1, hΨ_db]

  have hΨ_const : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (φ : ↥B →ₐ[A] R) (d : D),
      Ψ φ (fun _ => d) = Algebra.TensorProduct.includeRight d := by
    intro R _ _ φ d
    have h1 : (fun _ : ZMod ℓ => d) * (1 : ↥B).1 = (fun _ => d) := by
      funext γ; exact mul_one d
    rw [← h1, hΨ_db, map_one]
    rfl

  have hΨ_expand : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (φ : ↥B →ₐ[A] R) (f : ZMod ℓ → D),
      Ψ φ f = ∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (f α) * c_of φ α := by
    intro R _ _ φ f
    have hdecomp : f = ∑ α : ZMod ℓ, (fun _ => f α) * Pi.single α (1 : D) := by
      funext γ
      simp [Finset.sum_apply, Pi.single_apply]
    conv_lhs => rw [hdecomp]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro α _
    rw [map_mul, hΨ_const]

  have hB_sum_eq : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (c : ZMod ℓ → TensorProduct A R D)
      (b : ↥B),
      let p₁ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        Algebra.TensorProduct.includeLeft
      let θ₁₂ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
          Algebra.TensorProduct.includeRight
      (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) *
          (∑ δ : ZMod ℓ, p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ))) =
        p₁ (∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (b.1 α) * c α) := by
    intro R _ _ c b p₁ θ₁₂
    have hθ_left : ∀ d : D,
        θ₁₂ (Algebra.TensorProduct.includeLeft (S := A) d) =
          p₁ (Algebra.TensorProduct.includeRight d) := fun _ => rfl
    calc
      (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) *
          (∑ δ : ZMod ℓ, p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ)))
        = ∑ γ : ZMod ℓ, ∑ δ : ZMod ℓ,
            p₁ (Algebra.TensorProduct.includeRight (b.1 (γ + δ)) * c (γ + δ)) *
              θ₁₂ (e₁₂ δ) := by
            apply Finset.sum_congr rfl
            intro γ _
            rw [(hB_mem b.1).mp b.2 γ, map_sum, Finset.sum_mul_sum, Finset.sum_comm]
            apply Finset.sum_congr rfl
            intro δ _
            rw [Finset.sum_eq_single δ]
            · rw [map_mul, hθ_left, map_mul]
              have hr : (p₁ (Algebra.TensorProduct.includeRight (b.1 (γ + δ))) * θ₁₂ (e₁₂ δ)) *
                  (p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ)) =
                  (p₁ (Algebra.TensorProduct.includeRight (b.1 (γ + δ))) * p₁ (c (γ + δ))) *
                    θ₁₂ (e₁₂ δ * e₁₂ δ) := by
                rw [map_mul]; ring
              rw [hr, he_idem δ]
            · intro α _ hne
              rw [map_mul]
              have hr : (θ₁₂ (Algebra.TensorProduct.includeLeft (S := A) (b.1 (γ + α))) *
                    θ₁₂ (e₁₂ α)) * (p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ)) =
                  (θ₁₂ (Algebra.TensorProduct.includeLeft (S := A) (b.1 (γ + α))) *
                    p₁ (c (γ + δ))) * θ₁₂ (e₁₂ α * e₁₂ δ) := by
                rw [map_mul]; ring
              rw [hr, he_orth α δ hne, map_zero, mul_zero]
            · intro h; exact (h (Finset.mem_univ δ)).elim
      _ = ∑ δ : ZMod ℓ, (∑ γ : ZMod ℓ,
            p₁ (Algebra.TensorProduct.includeRight (b.1 (γ + δ)) * c (γ + δ))) *
              θ₁₂ (e₁₂ δ) := by
            rw [Finset.sum_comm]
            apply Finset.sum_congr rfl
            intro δ _; rw [← Finset.sum_mul]
      _ = ∑ δ : ZMod ℓ,
            p₁ (∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (b.1 α) * c α) *
              θ₁₂ (e₁₂ δ) := by
            apply Finset.sum_congr rfl
            intro δ _
            congr 1
            rw [map_sum, ← Equiv.sum_comp (Equiv.subRight δ)]
            apply Finset.sum_congr rfl
            intro α _
            simp [Equiv.subRight]
      _ = p₁ (∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (b.1 α) * c α) := by
            rw [← Finset.mul_sum, ← map_sum, he_sum, map_one, mul_one]

  have hc_of_valid : ∀ (R : Type u) [CommRing R] [Algebra A R] (φ : ↥B →ₐ[A] R),
      let p₁ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        Algebra.TensorProduct.includeLeft
      let p₂ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
          (Algebra.TensorProduct.map (AlgHom.id A R) Algebra.TensorProduct.includeRight)
      let θ₁₂ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
          Algebra.TensorProduct.includeRight
      IsIdempFrame (c_of φ) ∧
      (∀ γ : ZMod ℓ, p₂ (c_of φ γ) = ∑ δ : ZMod ℓ, p₁ (c_of φ (γ + δ)) * θ₁₂ (e₁₂ δ)) := by
    intro R _ _ φ p₁ p₂ θ₁₂
    have hframe : IsIdempFrame (c_of φ) := by
      refine ⟨?_, ?_, ?_⟩
      · intro δ
        dsimp [c_of]
        rw [← map_mul]
        congr 1
        funext α
        by_cases hα : α = δ <;> simp [Pi.single_apply, hα]
      · intro δ₁ δ₂ hne
        dsimp [c_of]
        rw [← map_mul]
        have h0 : (Pi.single δ₁ (1 : D) : ZMod ℓ → D) * (Pi.single δ₂ (1 : D) : ZMod ℓ → D) = 0 := by
          funext α
          by_cases h1 : α = δ₁
          · subst h1; simp [Pi.single_apply, hne]
          · simp [Pi.single_apply, h1]
        rw [h0, map_zero]
      · dsimp [c_of]
        rw [← map_sum]
        have h1 : (∑ δ : ZMod ℓ, (Pi.single δ (1 : D) : ZMod ℓ → D)) = 1 := by
          funext α; simp [Finset.sum_apply, Pi.single_apply]
        rw [h1, map_one]
    refine ⟨hframe, ?_⟩
    intro γ₀
    let F₁ : (ZMod ℓ → D) →+ TensorProduct A (TensorProduct A R D) D :=
      { toFun := fun f => ∑ γ : ZMod ℓ,
          θ₁₂ (Algebra.TensorProduct.includeRight (f γ)) * p₂ (c_of φ γ)
        map_zero' := by simp
        map_add' := fun x y => by
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro γ _
          rw [Pi.add_apply, map_add, map_add, add_mul] }
    let F₂ : (ZMod ℓ → D) →+ TensorProduct A (TensorProduct A R D) D :=
      { toFun := fun f => ∑ γ : ZMod ℓ,
          θ₁₂ (Algebra.TensorProduct.includeRight (f γ)) *
            (∑ δ : ZMod ℓ, p₁ (c_of φ (γ + δ)) * θ₁₂ (e₁₂ δ))
        map_zero' := by simp
        map_add' := fun x y => by
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro γ _
          rw [Pi.add_apply, map_add, map_add, add_mul] }
    have hFb : ∀ b : ↥B, F₁ b.1 = F₂ b.1 := by
      intro b
      have hθ_right : ∀ d : D,
          θ₁₂ (Algebra.TensorProduct.includeRight d) =
            p₂ (Algebra.TensorProduct.includeRight d) := fun _ => rfl
      have hlhs : F₁ b.1 =
          TensorProduct.tmul A (TensorProduct.tmul A (φ b) (1 : D)) (1 : D) := by
        calc
          (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) * p₂ (c_of φ γ))
            = p₂ (∑ γ : ZMod ℓ, Algebra.TensorProduct.includeRight (b.1 γ) * c_of φ γ) := by
                rw [map_sum]
                apply Finset.sum_congr rfl
                intro γ _; rw [map_mul, hθ_right]
          _ = p₂ (Ψ φ b.1) := by rw [← hΨ_expand]
          _ = TensorProduct.tmul A (TensorProduct.tmul A (φ b) (1 : D)) (1 : D) := by
                rw [hΨ_b]; rfl
      have hrhs : F₂ b.1 =
          TensorProduct.tmul A (TensorProduct.tmul A (φ b) (1 : D)) (1 : D) := by
        change (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) *
          (∑ δ : ZMod ℓ, p₁ (c_of φ (γ + δ)) * θ₁₂ (e₁₂ δ))) =
          TensorProduct.tmul A (TensorProduct.tmul A (φ b) (1 : D)) (1 : D)
        rw [hB_sum_eq (c_of φ) b, ← hΨ_expand, hΨ_b]
        rfl
      exact hlhs.trans hrhs.symm
    have hF_eq : ∀ f : ZMod ℓ → D, F₁ f = F₂ f := by
      apply heq_on_ZModD F₁ F₂
      intro d b
      have hpull₁ : F₁ ((fun _ => d) * b.1) =
          θ₁₂ (Algebra.TensorProduct.includeRight d) * F₁ b.1 := by
        change (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (d * b.1 γ)) *
            p₂ (c_of φ γ)) =
          θ₁₂ (Algebra.TensorProduct.includeRight d) *
            (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) * p₂ (c_of φ γ))
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro γ _
        rw [map_mul, map_mul, mul_assoc]
      have hpull₂ : F₂ ((fun _ => d) * b.1) =
          θ₁₂ (Algebra.TensorProduct.includeRight d) * F₂ b.1 := by
        change (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (d * b.1 γ)) *
            (∑ δ : ZMod ℓ, p₁ (c_of φ (γ + δ)) * θ₁₂ (e₁₂ δ))) =
          θ₁₂ (Algebra.TensorProduct.includeRight d) *
            (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) *
              (∑ δ : ZMod ℓ, p₁ (c_of φ (γ + δ)) * θ₁₂ (e₁₂ δ)))
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro γ _
        rw [map_mul, map_mul, mul_assoc]
      rw [hpull₁, hpull₂, hFb b]
    have heval := hF_eq (Pi.single γ₀ (1 : D))
    change (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight
          ((Pi.single γ₀ (1 : D) : ZMod ℓ → D) γ)) * p₂ (c_of φ γ)) =
      (∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight
          ((Pi.single γ₀ (1 : D) : ZMod ℓ → D) γ)) *
        (∑ δ : ZMod ℓ, p₁ (c_of φ (γ + δ)) * θ₁₂ (e₁₂ δ))) at heval
    rw [Finset.sum_eq_single γ₀, Finset.sum_eq_single γ₀] at heval
    · rw [Pi.single_eq_same, map_one, map_one, one_mul, one_mul] at heval
      exact heval
    · intro γ _ hne
      rw [Pi.single_eq_of_ne hne, map_zero, map_zero, zero_mul]
    · intro h; exact (h (Finset.mem_univ γ₀)).elim
    · intro γ _ hne
      rw [Pi.single_eq_of_ne hne, map_zero, map_zero, zero_mul]
    · intro h; exact (h (Finset.mem_univ γ₀)).elim

  have hc_of_bij : ∀ (R : Type u) [CommRing R] [Algebra A R]
      (c : ZMod ℓ → TensorProduct A R D),
      let p₁ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        Algebra.TensorProduct.includeLeft
      let p₂ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
          (Algebra.TensorProduct.map (AlgHom.id A R) Algebra.TensorProduct.includeRight)
      let θ₁₂ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
          Algebra.TensorProduct.includeRight
      IsIdempFrame c →
      (∀ γ : ZMod ℓ, p₂ (c γ) = ∑ δ : ZMod ℓ, p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ)) →
      ∃! (φ : ↥B →ₐ[A] R), c_of φ = c := by
    intro R _ _ c p₁ p₂ θ₁₂ hc hc_star
    let Φ_c : (ZMod ℓ → D) →ₐ[A] TensorProduct A R D :=
      { toFun := fun f => ∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (f α) * c α
        map_one' := by
          simp only [Pi.one_apply, map_one, one_mul]
          exact hc.2.2
        map_mul' := fun x y => by
          calc
            (∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (x α * y α) * c α)
              = ∑ α : ZMod ℓ, (Algebra.TensorProduct.includeRight (x α) * c α) *
                  (Algebra.TensorProduct.includeRight (y α) * c α) := by
                    apply Finset.sum_congr rfl
                    intro α _
                    rw [map_mul]
                    have hr : Algebra.TensorProduct.includeRight (x α) *
                        Algebra.TensorProduct.includeRight (y α) * c α =
                        Algebra.TensorProduct.includeRight (x α) *
                        Algebra.TensorProduct.includeRight (y α) * (c α * c α) := by
                      rw [hc.1 α]
                    rw [hr]; ring
            _ = (∑ α₁ : ZMod ℓ, Algebra.TensorProduct.includeRight (x α₁) * c α₁) *
                  (∑ α₂ : ZMod ℓ, Algebra.TensorProduct.includeRight (y α₂) * c α₂) := by
                    rw [Finset.sum_mul_sum]
                    apply Finset.sum_congr rfl
                    intro α₁ _
                    rw [Finset.sum_eq_single α₁]
                    · intro α₂ _ hne
                      have hr : (Algebra.TensorProduct.includeRight (x α₁) * c α₁) *
                          (Algebra.TensorProduct.includeRight (y α₂) * c α₂) =
                          (Algebra.TensorProduct.includeRight (x α₁) *
                            Algebra.TensorProduct.includeRight (y α₂)) * (c α₁ * c α₂) := by ring
                      rw [hr, hc.2.1 _ _ (Ne.symm hne), mul_zero]
                    · intro h; exact (h (Finset.mem_univ α₁)).elim
        map_zero' := by simp
        map_add' := fun x y => by
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro α _
          rw [Pi.add_apply, map_add, add_mul]
        commutes' := fun a => by
          calc
            (∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (algebraMap A D a) * c α)
              = Algebra.TensorProduct.includeRight (algebraMap A D a) * ∑ α : ZMod ℓ, c α := by
                  rw [Finset.mul_sum]
            _ = algebraMap A (TensorProduct A R D) a := by
                  rw [hc.2.2, mul_one, Algebra.TensorProduct.includeRight.commutes] }
    have hΦ_apply : ∀ f : ZMod ℓ → D,
        Φ_c f = ∑ α : ZMod ℓ, Algebra.TensorProduct.includeRight (f α) * c α := fun _ => rfl
    have hΦ_amitsur : ∀ b : ↥B, p₁ (Φ_c b.1) = p₂ (Φ_c b.1) := by
      intro b
      have hθ_right : ∀ d : D,
          θ₁₂ (Algebra.TensorProduct.includeRight d) =
            p₂ (Algebra.TensorProduct.includeRight d) := fun _ => rfl
      calc
        p₁ (Φ_c b.1)
          = ∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) *
              (∑ δ : ZMod ℓ, p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ)) :=
              (hB_sum_eq c b).symm
        _ = ∑ γ : ZMod ℓ, θ₁₂ (Algebra.TensorProduct.includeRight (b.1 γ)) * p₂ (c γ) := by
              apply Finset.sum_congr rfl
              intro γ _; rw [← hc_star γ]
        _ = p₂ (Φ_c b.1) := by
              rw [hΦ_apply, map_sum]
              apply Finset.sum_congr rfl
              intro γ _; rw [map_mul, hθ_right]
    let φ_fun : ↥B → R := fun b => (hAmitsur R (Φ_c b.1) (hΦ_amitsur b)).choose
    have hφ_spec : ∀ b : ↥B, TensorProduct.tmul A (φ_fun b) (1 : D) = Φ_c b.1 :=
      fun b => (hAmitsur R (Φ_c b.1) (hΦ_amitsur b)).choose_spec.1
    have hφ_uniq_elem : ∀ (b : ↥B) (r : R),
        TensorProduct.tmul A r (1 : D) = Φ_c b.1 → r = φ_fun b :=
      fun b r hr => (hAmitsur R (Φ_c b.1) (hΦ_amitsur b)).choose_spec.2 r hr
    let φ_c : ↥B →ₐ[A] R :=
      { toFun := φ_fun
        map_one' := (hφ_uniq_elem 1 1 (by change (1 : TensorProduct A R D) = Φ_c 1; rw [map_one])).symm
        map_mul' := fun x y => (hφ_uniq_elem (x * y) (φ_fun x * φ_fun y) (by
          have hm : TensorProduct.tmul A (φ_fun x * φ_fun y) (1 : D) =
              TensorProduct.tmul A (φ_fun x) (1 : D) * TensorProduct.tmul A (φ_fun y) (1 : D) := by
            simp
          rw [hm, hφ_spec x, hφ_spec y]
          exact (map_mul Φ_c x.1 y.1).symm)).symm
        map_zero' := (hφ_uniq_elem 0 0 (by simp)).symm
        map_add' := fun x y => (hφ_uniq_elem (x + y) (φ_fun x + φ_fun y) (by
          rw [TensorProduct.add_tmul, hφ_spec x, hφ_spec y]
          exact (map_add Φ_c x.1 y.1).symm)).symm
        commutes' := fun a => (hφ_uniq_elem (algebraMap A ↥B a) (algebraMap A R a) (by
          change algebraMap A (TensorProduct A R D) a = Φ_c (algebraMap A (ZMod ℓ → D) a)
          exact (Φ_c.commutes a).symm)).symm }
    refine ⟨φ_c, ?_, ?_⟩
    · have hΨΦ : ∀ f : ZMod ℓ → D, Ψ φ_c f = Φ_c f := by
        apply heq_on_ZModD (Ψ φ_c).toAddMonoidHom Φ_c.toRingHom.toAddMonoidHom
        intro d b
        change Ψ φ_c ((fun _ => d) * b.1) = Φ_c ((fun _ => d) * b.1)
        rw [hΨ_db]
        have hconst : Φ_c (fun _ => d) = Algebra.TensorProduct.includeRight d := by
          rw [hΦ_apply, ← Finset.mul_sum, hc.2.2, mul_one]
        rw [map_mul, hconst]
        change TensorProduct.tmul A (φ_fun b) d =
          Algebra.TensorProduct.includeRight d * Φ_c b.1
        rw [← hφ_spec b]
        change TensorProduct.tmul A (φ_fun b) d =
          TensorProduct.tmul A 1 d * TensorProduct.tmul A (φ_fun b) 1
        simp
      funext α
      dsimp [c_of]
      rw [hΨΦ (Pi.single α (1 : D)), hΦ_apply, Finset.sum_eq_single α]
      · rw [Pi.single_eq_same, map_one, one_mul]
      · intro β _ hne; rw [Pi.single_eq_of_ne hne, map_zero, zero_mul]
      · intro h; exact (h (Finset.mem_univ α)).elim
    · intro φ' hφ'
      ext b
      apply hφ_uniq_elem b (φ' b)
      rw [← hΨ_b φ' b, hΨ_expand φ' b.1, hφ']
      rfl

  have hc_of_nat : ∀ {R₁ R₂ : Type u} [CommRing R₁] [Algebra A R₁] [CommRing R₂] [Algebra A R₂]
      (ψ : R₁ →ₐ[A] R₂) (φ : ↥B →ₐ[A] R₁) (α : ZMod ℓ),
      c_of (ψ.comp φ) α = Algebra.TensorProduct.map ψ (AlgHom.id A D) (c_of φ α) := by
    intro R₁ R₂ _ _ _ _ ψ φ α
    have hmap : Algebra.TensorProduct.map (ψ.comp φ) (AlgHom.id A D) =
        (Algebra.TensorProduct.map ψ (AlgHom.id A D)).comp
          (Algebra.TensorProduct.map φ (AlgHom.id A D)) := by
      apply Algebra.TensorProduct.ext <;> (ext x; rfl)
    dsimp [c_of, Ψ]
    rw [hmap]
    rfl

  have hc_of_equiv : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (φ : ↥B →ₐ[A] R) (γ α : ZMod ℓ),
      c_of (φ.comp (σ γ)) α = c_of φ (α - γ) := by
    intro R _ _ φ γ α
    let sh : (ZMod ℓ → D) →+ (ZMod ℓ → D) :=
      { toFun := fun f β => f (β + γ)
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hΨ_sh : ∀ f : ZMod ℓ → D,
        Ψ (φ.comp (σ γ)) f = Ψ φ (sh f) := by
      apply heq_on_ZModD (Ψ (φ.comp (σ γ))).toAddMonoidHom
        ((Ψ φ).toAddMonoidHom.comp sh)
      intro d b
      change Ψ (φ.comp (σ γ)) ((fun _ => d) * b.1) = Ψ φ (sh ((fun _ => d) * b.1))
      have hsh : sh ((fun _ => d) * b.1) = (fun _ => d) * (σ γ b).1 := rfl
      rw [hΨ_db, hsh, hΨ_db]
      rfl
    dsimp [c_of]
    rw [hΨ_sh]
    congr 1
    funext β
    dsimp [sh]
    by_cases hβ : β + γ = α
    · have hβ' : β = α - γ := eq_sub_of_add_eq hβ
      simp [Pi.single_apply, hβ, hβ']
    · have hβ' : β ≠ α - γ := fun h => hβ (by rw [h, sub_add_cancel])
      simp [Pi.single_apply, hβ, hβ']

  
  let q_R_hom : ∀ (R : Type u) [CommRing R] [Algebra A R],
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A R D)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
    fun R _ _ => AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
  let q_D_hom : ∀ (R : Type u) [CommRing R] [Algebra A R],
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A R D)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of D) :=
    fun R _ _ => AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)

  have hEt_qR : ∀ (R : Type u) [CommRing R] [Algebra A R],
      AlgebraicGeometry.Etale (q_R_hom R) := by
    intro R _ _
    haveI : Algebra.Etale R (TensorProduct A R D) := Algebra.Etale.baseChange A D R
    have hring : Algebra.TensorProduct.includeLeftRingHom =
        algebraMap R (TensorProduct A R D) := rfl
    dsimp [q_R_hom]
    rw [hring]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)

  have hSurj_qR : ∀ (R : Type u) [CommRing R] [Algebra A R],
      AlgebraicGeometry.Surjective (q_R_hom R) := by
    intro R _ _
    haveI : Module.FaithfullyFlat R (TensorProduct A R D) :=
      Module.FaithfullyFlat.instTensorProduct A D R
    have hFF_R : (algebraMap R (TensorProduct A R D)).FaithfullyFlat :=
      RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
    have hring : Algebra.TensorProduct.includeLeftRingHom =
        algebraMap R (TensorProduct A R D) := rfl
    dsimp [q_R_hom]
    rw [hring]
    exact ((AlgebraicGeometry.flat_and_surjective_SpecMap_iff
      (CommRingCat.ofHom (algebraMap R (TensorProduct A R D)))).mpr hFF_R).2

  have hq_comm : ∀ (R : Type u) [CommRing R] [Algebra A R]
      (w : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U.1.toScheme),
      w = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)) ≫ e_U.inv →
      q_D_hom R ≫ p_V = q_R_hom R ≫ w := by
    intro R _ _ w hw
    rw [hp_V, hw, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
    congr 1
    dsimp [q_R_hom, q_D_hom]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.Hom.ext
    exact Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap.symm

  let Ξ : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (w : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U.1.toScheme),
      w = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)) ≫ e_U.inv →
      ∀ (hEt_w : AlgebraicGeometry.Etale w),
        letI := hEt_w
        P.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι))) →
          (ZMod ℓ → TensorProduct A R D) :=
    fun {R} _ _ w hw hEt_w s =>
      letI := hEt_w
      letI := hEt_qR R
      let E_w : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι)
      let E_RD : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (q_R_hom R ≫ w ≫ U.1.ι)
      let m_qR : E_RD ⟶ E_w := CategoryTheory.MorphismProperty.Over.homMk (q_R_hom R) rfl
      let m_qD : E_RD ⟶ E_V := CategoryTheory.MorphismProperty.Over.homMk (q_D_hom R)
        (by change q_D_hom R ≫ p_V ≫ U.1.ι = q_R_hom R ≫ w ≫ U.1.ι
            rw [← CategoryTheory.Category.assoc, hq_comm R w hw, CategoryTheory.Category.assoc])
      frameOfLocConst (CommRingCat.of (TensorProduct A R D))
        (diff E_RD (P.obj.map m_qD.op s_V) (P.obj.map m_qR.op s))

  have hΞ_descent : ∀ (R : Type u) [CommRing R] [Algebra A R]
      (w : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U.1.toScheme)
      (hw : w = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)) ≫ e_U.inv)
      (hEt_w : AlgebraicGeometry.Etale w),
      letI := hEt_w
      let E_w : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι)
      let p₁ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        Algebra.TensorProduct.includeLeft
      let p₂ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
          (Algebra.TensorProduct.map (AlgHom.id A R) Algebra.TensorProduct.includeRight)
      let θ₁₂ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
        (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
          Algebra.TensorProduct.includeRight
      (∀ s : P.obj.obj (Opposite.op E_w),
        IsIdempFrame (Ξ w hw hEt_w s) ∧
        ∀ γ : ZMod ℓ, p₂ (Ξ w hw hEt_w s γ) =
          ∑ δ : ZMod ℓ, p₁ (Ξ w hw hEt_w s (γ + δ)) * θ₁₂ (e₁₂ δ)) ∧
      (∀ c : ZMod ℓ → TensorProduct A R D,
        IsIdempFrame c →
        (∀ γ : ZMod ℓ, p₂ (c γ) = ∑ δ : ZMod ℓ, p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ)) →
        ∃! s : P.obj.obj (Opposite.op E_w), Ξ w hw hEt_w s = c) := by
    intro R _ _ w hw hEt_w
    letI := hEt_w
    letI := hEt_qR R
    letI := hSurj_qR R
    let E_w : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι)
    let RD₀ : CommRingCat.{u} := CommRingCat.of (TensorProduct A R D)
    let E_RD : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (q_R_hom R ≫ w ≫ U.1.ι)
    let m_qR : E_RD ⟶ E_w := CategoryTheory.MorphismProperty.Over.homMk (q_R_hom R) rfl
    let m_qD : E_RD ⟶ E_V := CategoryTheory.MorphismProperty.Over.homMk (q_D_hom R)
      (by change q_D_hom R ≫ p_V ≫ U.1.ι = q_R_hom R ≫ w ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc, hq_comm R w hw, CategoryTheory.Category.assoc])
    let s_base := P.obj.map m_qD.op s_V
    let p₁ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
      Algebra.TensorProduct.includeLeft
    let p₂ : TensorProduct A R D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
      (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
        (Algebra.TensorProduct.map (AlgHom.id A R) Algebra.TensorProduct.includeRight)
    let θ₁₂ : TensorProduct A D D →ₐ[A] TensorProduct A (TensorProduct A R D) D :=
      (Algebra.TensorProduct.assoc A A A R D D).symm.toAlgHom.comp
        Algebra.TensorProduct.includeRight
    let RDD₀ : CommRingCat.{u} := CommRingCat.of (TensorProduct A (TensorProduct A R D) D)
    let S_RDD : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec RDD₀
    let p1_sch : S_RDD ⟶ AlgebraicGeometry.Spec RD₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁.toRingHom)
    let p2_sch : S_RDD ⟶ AlgebraicGeometry.Spec RD₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₂.toRingHom)
    let theta12_sch : S_RDD ⟶ W₂ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁₂.toRingHom)
    have hEt_p1_sch : AlgebraicGeometry.Etale p1_sch := by
      have hEt_alg : Algebra.Etale (TensorProduct A R D)
          (TensorProduct A (TensorProduct A R D) D) :=
        Algebra.Etale.baseChange A D (TensorProduct A R D)
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hEt_alg)
    haveI : AlgebraicGeometry.Etale p1_sch := hEt_p1_sch
    have hp_sch_qR : p2_sch ≫ q_R_hom R = p1_sch ≫ q_R_hom R := by
      dsimp [p1_sch, p2_sch, q_R_hom]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    have hp1_sch_θ : p1_sch ≫ q_D_hom R = theta12_sch ≫ π₁ := by
      dsimp [p1_sch, q_D_hom, theta12_sch, π₁]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    have hp2_sch_θ : p2_sch ≫ q_D_hom R = theta12_sch ≫ π₂ := by
      dsimp [p2_sch, q_D_hom, theta12_sch, π₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    let E_RDD : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (p1_sch ≫ q_R_hom R ≫ w ≫ U.1.ι)
    let m_p₁ : E_RDD ⟶ E_RD := CategoryTheory.MorphismProperty.Over.homMk p1_sch rfl
    let m_p₂ : E_RDD ⟶ E_RD := CategoryTheory.MorphismProperty.Over.homMk p2_sch
      (by change p2_sch ≫ q_R_hom R ≫ w ≫ U.1.ι = p1_sch ≫ q_R_hom R ≫ w ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc p2_sch, hp_sch_qR, CategoryTheory.Category.assoc])
    let m_θ₁₂ : E_RDD ⟶ E_W₂ := CategoryTheory.MorphismProperty.Over.homMk theta12_sch
      (by change theta12_sch ≫ π₁ ≫ p_V ≫ U.1.ι = p1_sch ≫ q_R_hom R ≫ w ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc theta12_sch, ← hp1_sch_θ,
            CategoryTheory.Category.assoc p1_sch, ← CategoryTheory.Category.assoc (q_D_hom R),
            hq_comm R w hw, CategoryTheory.Category.assoc])
    have hm_p_qR : m_p₁ ≫ m_qR = m_p₂ ≫ m_qR := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hp_sch_qR.symm
    have hm_p₁_θ : m_p₁ ≫ m_qD = m_θ₁₂ ≫ m₁ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hp1_sch_θ
    have hm_p₂_θ : m_p₂ ≫ m_qD = m_θ₁₂ ≫ m₂ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hp2_sch_θ

    
    have hcov_qR : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton m_qR) ∈
        X.smallEtaleTopology E_w := by
      rw [hMemSmallEtale]
      intro x
      obtain ⟨y, hy⟩ := (q_R_hom R).surjective x
      exact ⟨E_RD, m_qR, y,
        CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.singleton m_qR) E_RD m_qR
          CategoryTheory.Presieve.singleton.mk,
        hEt_qR R, hy⟩
    have hSheaf_qR : ∀ s_tilde : P.obj.obj (Opposite.op E_RD),
        (∀ {Z : X.Etale} (a₁ a₂ : Z ⟶ E_RD),
          a₁ ≫ m_qR = a₂ ≫ m_qR → P.obj.map a₁.op s_tilde = P.obj.map a₂.op s_tilde) →
        ∃! s : P.obj.obj (Opposite.op E_w), P.obj.map m_qR.op s = s_tilde :=
      CategoryTheory.Presieve.isSheafFor_singleton.mp
        (hSheaf.isSheafFor (CategoryTheory.Presieve.singleton m_qR) hcov_qR)

    
    have hker_iff : ∀ s_tilde : P.obj.obj (Opposite.op E_RD),
        (∀ {Z : X.Etale} (a₁ a₂ : Z ⟶ E_RD),
          a₁ ≫ m_qR = a₂ ≫ m_qR → P.obj.map a₁.op s_tilde = P.obj.map a₂.op s_tilde) ↔
        P.obj.map m_p₁.op s_tilde = P.obj.map m_p₂.op s_tilde := by
      intro s_tilde
      constructor
      · intro h; exact h m_p₁ m_p₂ hm_p_qR
      · intro heq12 Z a₁ a₂ ha
        let _ : AlgebraicGeometry.Etale Z.hom := Z.prop
        apply heq_of_pointwise
        intro z
        let 𝒰 := Z.left.affineCover
        let i := 𝒰.idx z
        obtain ⟨y₀, hy₀⟩ := 𝒰.covers z
        let W_i := 𝒰.X i
        let S_i₀ : CommRingCat.{u} := W_i.presheaf.obj (Opposite.op ⊤)
        let S_i : Type u := ↑S_i₀
        let e_W : W_i ≅ AlgebraicGeometry.Spec (CommRingCat.of S_i) := W_i.isoSpec
        let v_left : AlgebraicGeometry.Spec (CommRingCat.of S_i) ⟶ Z.left :=
          e_W.inv ≫ 𝒰.f i
        let Z_i : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (v_left ≫ Z.hom)
        let v_i : Z_i ⟶ Z := CategoryTheory.MorphismProperty.Over.homMk v_left rfl
        let y : ↥(AlgebraicGeometry.Spec (CommRingCat.of S_i)) := e_W.hom.base y₀
        have hy : v_i.left.base y = z := by
          have hinv := congrArg (fun g : W_i ⟶ W_i => g.base y₀) e_W.hom_inv_id
          change e_W.inv.base (e_W.hom.base y₀) = y₀ at hinv
          change (𝒰.f i).base (e_W.inv.base (e_W.hom.base y₀)) = z
          rw [hinv]
          exact hy₀
        refine ⟨Z_i, v_i, y, hy, ?_⟩
        let g₁ : AlgebraicGeometry.Spec (CommRingCat.of S_i) ⟶ AlgebraicGeometry.Spec RD₀ :=
          v_left ≫ a₁.left
        let g₂ : AlgebraicGeometry.Spec (CommRingCat.of S_i) ⟶ AlgebraicGeometry.Spec RD₀ :=
          v_left ≫ a₂.left
        let φ₁ : TensorProduct A R D →+* S_i := (AlgebraicGeometry.Spec.preimage g₁).hom
        let φ₂ : TensorProduct A R D →+* S_i := (AlgebraicGeometry.Spec.preimage g₂).hom
        have hg_qR : g₁ ≫ q_R_hom R = g₂ ≫ q_R_hom R :=
          (CategoryTheory.Category.assoc v_left a₁.left (q_R_hom R)).trans
            ((congrArg (v_left ≫ ·)
                (congrArg (fun m => m.left) ha)).trans
              (CategoryTheory.Category.assoc v_left a₂.left (q_R_hom R)).symm)
        have hφ_left : ∀ r : R,
            φ₁ (Algebra.TensorProduct.includeLeftRingHom r) =
              φ₂ (Algebra.TensorProduct.includeLeftRingHom r) := by
          intro r
          have hpre := congrArg AlgebraicGeometry.Spec.preimage hg_qR
          dsimp [q_R_hom] at hpre
          rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
            AlgebraicGeometry.Spec.preimage_map] at hpre
          exact CategoryTheory.ConcreteCategory.congr_hom hpre r
        letI algS : Algebra A S_i :=
          (φ₁.comp (algebraMap A (TensorProduct A R D))).toAlgebra
        let φ₁_alg : TensorProduct A R D →ₐ[A] S_i :=
          { φ₁ with commutes' := fun _ => rfl }
        let φ₂_D : D →ₐ[A] S_i :=
          { φ₂.comp Algebra.TensorProduct.includeRight.toRingHom with
            commutes' := fun a => by
              change φ₂ (Algebra.TensorProduct.includeRight (algebraMap A D a)) =
                φ₁ (algebraMap A (TensorProduct A R D) a)
              rw [Algebra.TensorProduct.includeRight.commutes]
              exact (hφ_left (algebraMap A R a)).symm }
        let Φ : TensorProduct A (TensorProduct A R D) D →ₐ[A] S_i :=
          Algebra.TensorProduct.lift φ₁_alg φ₂_D (fun _ _ => Commute.all _ _)
        have hΦ₁ : CommRingCat.ofHom p₁.toRingHom ≫ CommRingCat.ofHom Φ.toRingHom =
            AlgebraicGeometry.Spec.preimage g₁ := by
          apply CommRingCat.Hom.ext
          apply RingHom.ext
          intro z
          change Φ (p₁ z) = φ₁ z
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul r d =>
              change φ₁ (TensorProduct.tmul A r d) *
                φ₂ (Algebra.TensorProduct.includeRight (1 : D)) =
                φ₁ (TensorProduct.tmul A r d)
              rw [map_one, map_one, mul_one]
          | add x y ihx ihy =>
              rw [map_add, map_add, map_add, ihx, ihy]
        have hΦ₂ : CommRingCat.ofHom p₂.toRingHom ≫ CommRingCat.ofHom Φ.toRingHom =
            AlgebraicGeometry.Spec.preimage g₂ := by
          apply CommRingCat.Hom.ext
          apply RingHom.ext
          intro z
          change Φ (p₂ z) = φ₂ z
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul r d =>
              change φ₁ (Algebra.TensorProduct.includeLeftRingHom r) *
                φ₂ (Algebra.TensorProduct.includeRight d) =
                φ₂ (TensorProduct.tmul A r d)
              rw [hφ_left r, ← map_mul]
              congr 1
              change TensorProduct.tmul A r (1 : D) * TensorProduct.tmul A (1 : R) d =
                TensorProduct.tmul A r d
              simp
          | add x y ihx ihy =>
              rw [map_add, map_add, map_add, ihx, ihy]
        let h_i : AlgebraicGeometry.Spec (CommRingCat.of S_i) ⟶ S_RDD :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom)
        have hh₁ : h_i ≫ p1_sch = g₁ := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁.toRingHom) = g₁
          rw [← AlgebraicGeometry.Spec.map_comp, hΦ₁, AlgebraicGeometry.Spec.map_preimage]
        have hh₂ : h_i ≫ p2_sch = g₂ := by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₂.toRingHom) = g₂
          rw [← AlgebraicGeometry.Spec.map_comp, hΦ₂, AlgebraicGeometry.Spec.map_preimage]
        let m_hi : Z_i ⟶ E_RDD := CategoryTheory.MorphismProperty.Over.homMk h_i
          (((CategoryTheory.Category.assoc h_i p1_sch E_RD.hom).symm.trans
              (congrArg (· ≫ E_RD.hom) hh₁)).trans
            ((CategoryTheory.Category.assoc v_left a₁.left E_RD.hom).trans
              (congrArg (v_left ≫ ·) (CategoryTheory.MorphismProperty.Over.w a₁))))
        have hm_hi₁ : m_hi ≫ m_p₁ = v_i ≫ a₁ := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hh₁
        have hm_hi₂ : m_hi ≫ m_p₂ = v_i ≫ a₂ := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hh₂
        rw [← hmap_comp, ← hmap_comp, ← hm_hi₁, ← hm_hi₂, hmap_comp, hmap_comp, heq12]

    
    have hstar_iff : ∀ s_tilde : P.obj.obj (Opposite.op E_RD),
        let u := diff E_RD s_base s_tilde
        let c := frameOfLocConst RD₀ u
        P.obj.map m_p₁.op s_tilde = P.obj.map m_p₂.op s_tilde ↔
          (∀ γ : ZMod ℓ, p₂ (c γ) = ∑ δ : ZMod ℓ, p₁ (c (γ + δ)) * θ₁₂ (e₁₂ δ)) := by
      intro s_tilde u c
      let s_ref := P.obj.map m_p₂.op s_base
      have hd_base : diff E_RDD s_ref (P.obj.map m_p₁.op s_base) =
          - f₁₂.comap ⟨theta12_sch.base, theta12_sch.continuous⟩ := by
        dsimp [s_ref, s_base]
        rw [← hmap_comp, ← hmap_comp, hm_p₂_θ, hm_p₁_θ, hmap_comp, hmap_comp,
          hdiff_map m_θ₁₂, hdiff_symm]
        ext z; rfl
      have hd_lhs : diff E_RDD s_ref (P.obj.map m_p₁.op s_tilde) =
          u.comap ⟨p1_sch.base, p1_sch.continuous⟩ -
            f₁₂.comap ⟨theta12_sch.base, theta12_sch.continuous⟩ := by
        rw [hdiff_trans E_RDD s_ref (P.obj.map m_p₁.op s_base) (P.obj.map m_p₁.op s_tilde),
          hd_base, hdiff_map m_p₁]
        ext z
        change - f₁₂ (theta12_sch.base z) + u (p1_sch.base z) =
          u (p1_sch.base z) - f₁₂ (theta12_sch.base z)
        abel
      have hd_rhs : diff E_RDD s_ref (P.obj.map m_p₂.op s_tilde) =
          u.comap ⟨p2_sch.base, p2_sch.continuous⟩ := hdiff_map m_p₂ s_base s_tilde
      have heq_sec : P.obj.map m_p₁.op s_tilde = P.obj.map m_p₂.op s_tilde ↔
          u.comap ⟨p2_sch.base, p2_sch.continuous⟩ =
            u.comap ⟨p1_sch.base, p1_sch.continuous⟩ -
              f₁₂.comap ⟨theta12_sch.base, theta12_sch.continuous⟩ := by
        constructor
        · intro heq
          rw [← hd_rhs, ← hd_lhs, heq]
        · intro hdu
          apply heq_of_diff_zero
          have htr := hdiff_trans E_RDD s_ref (P.obj.map m_p₁.op s_tilde)
            (P.obj.map m_p₂.op s_tilde)
          rw [hd_lhs, hd_rhs, hdu] at htr
          exact add_left_cancel (htr.symm.trans (add_zero _).symm)
      rw [heq_sec]
      constructor
      · intro hlc γ
        have hf₂ := hframe_comap p₂.toRingHom u γ
        change frameOfLocConst RDD₀ (u.comap ⟨p2_sch.base, p2_sch.continuous⟩) γ =
          p₂ (c γ) at hf₂
        rw [hlc, hframe_sub] at hf₂
        rw [← hf₂]
        apply Finset.sum_congr rfl
        intro δ _
        exact congrArg₂ (· * ·) (hframe_comap p₁.toRingHom u (γ + δ))
          (hframe_comap θ₁₂.toRingHom f₁₂ δ)
      · intro hstar
        apply hframe_inj RDD₀
        funext γ
        rw [hframe_comap p₂.toRingHom u γ, hframe_sub]
        change p₂ (c γ) = _
        rw [hstar γ]
        apply Finset.sum_congr rfl
        intro δ _
        exact (congrArg₂ (· * ·) (hframe_comap p₁.toRingHom u (γ + δ))
          (hframe_comap θ₁₂.toRingHom f₁₂ δ)).symm

    refine ⟨?_, ?_⟩
    · intro s
      have hc_frame := (hframe_spec RD₀ (diff E_RD s_base (P.obj.map m_qR.op s))).1
      have hp12 : P.obj.map m_p₁.op (P.obj.map m_qR.op s) =
          P.obj.map m_p₂.op (P.obj.map m_qR.op s) := by
        rw [← hmap_comp, ← hmap_comp, hm_p_qR]
      exact ⟨hc_frame, (hstar_iff (P.obj.map m_qR.op s)).mp hp12⟩
    · intro c hc hstar
      obtain ⟨u, hu⟩ := hframe_surj RD₀ c hc
      obtain ⟨s_tilde, hs_tilde_spec⟩ := hTwist E_RD s_base u
      have hs_tilde_diff : diff E_RD s_base s_tilde = u :=
        hdiff_eq E_RD s_base s_tilde u hs_tilde_spec
      have hp12 : P.obj.map m_p₁.op s_tilde = P.obj.map m_p₂.op s_tilde := by
        apply (hstar_iff s_tilde).mpr
        rw [hs_tilde_diff, hu]
        exact hstar
      obtain ⟨s, hs_eq, hs_uniq⟩ := hSheaf_qR s_tilde ((hker_iff s_tilde).mpr hp12)
      refine ⟨s, ?_, ?_⟩
      · dsimp [Ξ]
        rw [hs_eq, hs_tilde_diff, hu]
      · intro s' hs'
        apply hs_uniq s'
        apply heq_of_diff_zero E_RD
        have hdiff_eq' : diff E_RD s_base (P.obj.map m_qR.op s') = u := by
          apply hframe_inj RD₀
          dsimp [Ξ] at hs'
          rw [hs', hu]
        have htr := hdiff_trans E_RD s_base (P.obj.map m_qR.op s') s_tilde
        rw [hdiff_eq', hs_tilde_diff] at htr
        exact add_left_cancel (htr.symm.trans (add_zero _).symm)

  have hΞ_nat : ∀ {R₁ R₂ : Type u} [CommRing R₁] [Algebra A R₁] [CommRing R₂] [Algebra A R₂]
      (w₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ U.1.toScheme)
      (hw₁ : w₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R₁)) ≫ e_U.inv)
      (hEt_w₁ : AlgebraicGeometry.Etale w₁)
      (w₂ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶ U.1.toScheme)
      (hw₂ : w₂ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R₂)) ≫ e_U.inv)
      (hEt_w₂ : AlgebraicGeometry.Etale w₂)
      (ψ : R₁ →ₐ[A] R₂)
      (g : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₁))
      (_ : g = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom))
      (hg : g ≫ w₁ = w₂)
      (s₁ :
        letI := hEt_w₁
        P.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (w₁ ≫ U.1.ι))))
      (α : ZMod ℓ),
      letI := hEt_w₁
      letI := hEt_w₂
      let E_w₁ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w₁ ≫ U.1.ι)
      let E_w₂ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w₂ ≫ U.1.ι)
      let m_g : E_w₂ ⟶ E_w₁ :=
        CategoryTheory.MorphismProperty.Over.homMk g
          ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.1.ι) hg))
      Ξ w₂ hw₂ hEt_w₂ (P.obj.map m_g.op s₁) α =
        Algebra.TensorProduct.map ψ (AlgHom.id A D) (Ξ w₁ hw₁ hEt_w₁ s₁ α) := by
    intro R₁ R₂ _ _ _ _ w₁ hw₁ hEt_w₁ w₂ hw₂ hEt_w₂ ψ g hg_def hg s₁ α
    letI := hEt_w₁
    letI := hEt_w₂
    letI := hEt_qR R₁
    letI := hEt_qR R₂
    let E_w₁ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w₁ ≫ U.1.ι)
    let E_w₂ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w₂ ≫ U.1.ι)
    let m_g : E_w₂ ⟶ E_w₁ :=
      CategoryTheory.MorphismProperty.Over.homMk g
        ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.1.ι) hg))
    let E_RD₁ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (q_R_hom R₁ ≫ w₁ ≫ U.1.ι)
    let E_RD₂ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (q_R_hom R₂ ≫ w₂ ≫ U.1.ι)
    let m_qR₁ : E_RD₁ ⟶ E_w₁ := CategoryTheory.MorphismProperty.Over.homMk (q_R_hom R₁) rfl
    let m_qR₂ : E_RD₂ ⟶ E_w₂ := CategoryTheory.MorphismProperty.Over.homMk (q_R_hom R₂) rfl
    let m_qD₁ : E_RD₁ ⟶ E_V := CategoryTheory.MorphismProperty.Over.homMk (q_D_hom R₁)
      (by change q_D_hom R₁ ≫ p_V ≫ U.1.ι = q_R_hom R₁ ≫ w₁ ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc, hq_comm R₁ w₁ hw₁, CategoryTheory.Category.assoc])
    let m_qD₂ : E_RD₂ ⟶ E_V := CategoryTheory.MorphismProperty.Over.homMk (q_D_hom R₂)
      (by change q_D_hom R₂ ≫ p_V ≫ U.1.ι = q_R_hom R₂ ≫ w₂ ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc, hq_comm R₂ w₂ hw₂, CategoryTheory.Category.assoc])
    let ψ_RD := Algebra.TensorProduct.map ψ (AlgHom.id A D)
    let g_tilde := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_RD.toRingHom)
    have hg_tilde_R : g_tilde ≫ q_R_hom R₁ = q_R_hom R₂ ≫ g := by
      rw [hg_def]
      dsimp [g_tilde, q_R_hom]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    have hg_tilde_D : g_tilde ≫ q_D_hom R₁ = q_D_hom R₂ := by
      dsimp [g_tilde, q_D_hom]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext d
      change ψ 1 ⊗ₜ[A] d = 1 ⊗ₜ[A] d
      rw [map_one]
    let m_g_tilde : E_RD₂ ⟶ E_RD₁ := CategoryTheory.MorphismProperty.Over.homMk g_tilde
      (by change g_tilde ≫ q_R_hom R₁ ≫ w₁ ≫ U.1.ι = q_R_hom R₂ ≫ w₂ ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc g_tilde, hg_tilde_R, CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc g, hg])
    have hm_g_tilde_R : m_g_tilde ≫ m_qR₁ = m_qR₂ ≫ m_g := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hg_tilde_R
    have hm_g_tilde_D : m_g_tilde ≫ m_qD₁ = m_qD₂ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext; exact hg_tilde_D
    have hd_nat : diff E_RD₂ (P.obj.map m_qD₂.op s_V)
        (P.obj.map m_qR₂.op (P.obj.map m_g.op s₁)) =
        (diff E_RD₁ (P.obj.map m_qD₁.op s_V) (P.obj.map m_qR₁.op s₁)).comap
          ⟨g_tilde.base, g_tilde.continuous⟩ := by
      rw [← hmap_comp m_qR₂ m_g, ← hm_g_tilde_R, ← hm_g_tilde_D, hmap_comp m_g_tilde m_qD₁,
        hmap_comp m_g_tilde m_qR₁]
      exact hdiff_map m_g_tilde _ _
    dsimp [Ξ]
    rw [hd_nat]
    exact hframe_comap ψ_RD.toRingHom _ α

  have hΞ_equiv : ∀ {R : Type u} [CommRing R] [Algebra A R]
      (w : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U.1.toScheme)
      (hw : w = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)) ≫ e_U.inv)
      (hEt_w : AlgebraicGeometry.Etale w)
      (s :
        letI := hEt_w
        P.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι))))
      (γ α : ZMod ℓ),
      letI := hEt_w
      let E_w : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι)
      Ξ w hw hEt_w ((actP γ).hom.app (Opposite.op E_w) s) α =
        Ξ w hw hEt_w s (α - γ) := by
    intro R _ _ w hw hEt_w s γ α
    letI := hEt_w
    letI := hEt_qR R
    let E_w : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (w ≫ U.1.ι)
    let E_RD : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (q_R_hom R ≫ w ≫ U.1.ι)
    let m_qR : E_RD ⟶ E_w := CategoryTheory.MorphismProperty.Over.homMk (q_R_hom R) rfl
    let m_qD : E_RD ⟶ E_V := CategoryTheory.MorphismProperty.Over.homMk (q_D_hom R)
      (by change q_D_hom R ≫ p_V ≫ U.1.ι = q_R_hom R ≫ w ≫ U.1.ι
          rw [← CategoryTheory.Category.assoc, hq_comm R w hw, CategoryTheory.Category.assoc])
    have hd_act : diff E_RD (P.obj.map m_qD.op s_V)
        (P.obj.map m_qR.op ((actP γ).hom.app (Opposite.op E_w) s)) =
        diff E_RD (P.obj.map m_qD.op s_V) (P.obj.map m_qR.op s) +
          LocallyConstant.const _ γ := by
      rw [hact_nat γ m_qR s, hdiff_trans E_RD _ (P.obj.map m_qR.op s) _, hdiff_act_right]
    dsimp [Ξ]
    rw [hd_act]
    exact hframe_add_const _ _ γ α

  
  let B_U : CommRingCat.{u} := CommRingCat.of ↥B
  let τ_U : AlgebraicGeometry.Spec B_U ⟶ U.1.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A ↥B)) ≫ e_U.inv

  have hFin_τ : AlgebraicGeometry.IsFinite τ_U := by
    haveI : AlgebraicGeometry.IsFinite
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A ↥B))) :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff
        (CommRingCat.ofHom (algebraMap A ↥B))).mpr hFin_B
    dsimp [τ_U]
    infer_instance

  have hEt_U : AlgebraicGeometry.Etale τ_U := by
    haveI : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A ↥B))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mpr hEt_B
    dsimp [τ_U]
    infer_instance

  have hSurj_τ : AlgebraicGeometry.Surjective τ_U := by
    let ψ₀ : ↥B →ₐ[A] D := (Pi.evalAlgHom A (fun _ : ZMod ℓ => D) 0).comp B.val
    have hψ₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom) ≫ τ_U = p_V := by
      dsimp [τ_U]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hp_V]
      congr 2
    haveI : AlgebraicGeometry.Surjective
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom) ≫ τ_U) := by
      rw [hψ₀]; exact hSurj_V
    exact AlgebraicGeometry.Surjective.of_comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom)) τ_U

  let ρ_U : ZMod ℓ → (AlgebraicGeometry.Spec B_U ⟶ AlgebraicGeometry.Spec B_U) :=
    fun γ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ γ).toRingHom)

  have hρ_U_over : ∀ γ : ZMod ℓ, ρ_U γ ≫ τ_U = τ_U := by
    intro γ
    dsimp [ρ_U, τ_U]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 2

  have hρ_U0 : ρ_U 0 = 𝟙 (AlgebraicGeometry.Spec B_U) := by
    dsimp [ρ_U]
    rw [hσ0]
    exact AlgebraicGeometry.Spec.map_id B_U

  have hρ_U_add : ∀ γ₁ γ₂ : ZMod ℓ, ρ_U (γ₁ + γ₂) = ρ_U γ₁ ≫ ρ_U γ₂ := by
    intro γ₁ γ₂
    dsimp [ρ_U]
    rw [hσ_add γ₁ γ₂, ← AlgebraicGeometry.Spec.map_comp]
    congr 1

  let _ := hEt_U
  let E_U : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (τ_U ≫ U.1.ι)
  obtain ⟨hc_id_frame, hc_id_star⟩ := hc_of_valid ↥B (AlgHom.id A ↥B)
  obtain ⟨s_U, hs_U, hs_U_uniq⟩ :=
    (hΞ_descent ↥B τ_U rfl hEt_U).2 (c_of (AlgHom.id A ↥B)) hc_id_frame hc_id_star

  refine ⟨B_U, τ_U, hFin_τ, hEt_U, hSurj_τ, ρ_U, hρ_U_over, hρ_U0, hρ_U_add, s_U, ?_, ?_⟩
  · 
    intro γ m_γ
    have hXi_lhs : Ξ τ_U rfl hEt_U (P.obj.map m_γ.op s_U) =
        fun α => c_of (AlgHom.id A ↥B) (α - γ) := by
      funext α
      rw [hΞ_nat τ_U rfl hEt_U τ_U rfl hEt_U (σ γ) (ρ_U γ) rfl (hρ_U_over γ) s_U α,
        hs_U, ← hc_of_nat (σ γ) (AlgHom.id A ↥B) α]
      have hcomp : (σ γ).comp (AlgHom.id A ↥B) = (AlgHom.id A ↥B).comp (σ γ) := rfl
      rw [hcomp, hc_of_equiv (AlgHom.id A ↥B) γ α]
    have hXi_rhs : Ξ τ_U rfl hEt_U ((actP γ).hom.app (Opposite.op E_U) s_U) =
        fun α => c_of (AlgHom.id A ↥B) (α - γ) := by
      funext α
      rw [hΞ_equiv τ_U rfl hEt_U s_U γ α, hs_U]
    obtain ⟨hc_lhs_f, hc_lhs_s⟩ := (hΞ_descent ↥B τ_U rfl hEt_U).1 (P.obj.map m_γ.op s_U)
    obtain ⟨_, _, huniq⟩ :=
      (hΞ_descent ↥B τ_U rfl hEt_U).2 (Ξ τ_U rfl hEt_U (P.obj.map m_γ.op s_U))
        hc_lhs_f hc_lhs_s
    exact (huniq _ rfl).trans (huniq _ (hXi_rhs.trans hXi_lhs.symm)).symm
  · 
    intro R₀ w hEt_w E_w s
    let _ := hEt_w
    let R : Type u := ↑R₀
    let α_R : CommRingCat.of A ⟶ CommRingCat.of R :=
      AlgebraicGeometry.Spec.preimage (w ≫ e_U.hom)
    letI : Algebra A R := α_R.hom.toAlgebra
    have hα_R_eq : CommRingCat.ofHom (algebraMap A R) = α_R := rfl
    have hw_hom : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)) =
        w ≫ e_U.hom := by
      rw [hα_R_eq]
      exact AlgebraicGeometry.Spec.map_preimage (w ≫ e_U.hom)
    have hw : w = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)) ≫ e_U.inv := by
      rw [hw_hom, CategoryTheory.Category.assoc, e_U.hom_inv_id, CategoryTheory.Category.comp_id]
    obtain ⟨hc_s_frame, hc_s_star⟩ := (hΞ_descent R w hw hEt_w).1 s
    obtain ⟨φ, hφ_eq, hφ_uniq⟩ := hc_of_bij R (Ξ w hw hEt_w s) hc_s_frame hc_s_star
    let g : AlgebraicGeometry.Spec R₀ ⟶ AlgebraicGeometry.Spec B_U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom)
    have hg : g ≫ τ_U = w := by
      dsimp [g, τ_U]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hw]
      congr 2
      ext a
      exact φ.commutes a
    have hsec :
        let m_g : E_w ⟶ E_U :=
          CategoryTheory.MorphismProperty.Over.homMk g
            ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.1.ι) hg))
        P.obj.map m_g.op s_U = s := by
      intro m_g
      have hXi_mg : Ξ w hw hEt_w (P.obj.map m_g.op s_U) = Ξ w hw hEt_w s := by
        funext α
        rw [hΞ_nat τ_U rfl hEt_U w hw hEt_w φ g rfl hg s_U α, hs_U,
          ← hc_of_nat φ (AlgHom.id A ↥B) α]
        have hcomp : φ.comp (AlgHom.id A ↥B) = φ := AlgHom.comp_id φ
        rw [hcomp, hφ_eq]
      obtain ⟨_, _, huniq_s⟩ :=
        (hΞ_descent R w hw hEt_w).2 (Ξ w hw hEt_w s) hc_s_frame hc_s_star
      exact (huniq_s (P.obj.map m_g.op s_U) hXi_mg).trans (huniq_s s rfl).symm
    refine ⟨g, ⟨hg, hsec⟩, ?_⟩
    rintro g' ⟨hg', hsec'⟩
    let β' : B_U ⟶ R₀ := AlgebraicGeometry.Spec.preimage g'
    have hβ'_comm : ∀ a : A, β'.hom (algebraMap A ↥B a) = algebraMap A R a := by
      intro a
      have h1 : g' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A ↥B)) =
          w ≫ e_U.hom := by
        have h2 := congrArg (· ≫ e_U.hom) hg'
        dsimp [τ_U] at h2
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          e_U.inv_hom_id, CategoryTheory.Category.comp_id] at h2
        exact h2
      have hpre := congrArg AlgebraicGeometry.Spec.preimage h1
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map] at hpre
      exact CategoryTheory.ConcreteCategory.congr_hom hpre a
    let φ' : ↥B →ₐ[A] R :=
      { β'.hom with commutes' := hβ'_comm }
    have hg'_def : g' = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ'.toRingHom) :=
      (AlgebraicGeometry.Spec.map_preimage g').symm
    have hφ'_c : c_of φ' = Ξ w hw hEt_w s := by
      funext α
      have hnat := hΞ_nat τ_U rfl hEt_U w hw hEt_w φ' g' hg'_def hg' s_U α
      dsimp only at hnat hsec'
      rw [hsec', hs_U, ← hc_of_nat φ' (AlgHom.id A ↥B) α, AlgHom.comp_id] at hnat
      exact hnat.symm
    have hφ'_eq : φ' = φ := hφ_uniq φ' hφ'_c
    rw [hg'_def, hφ'_eq]

theorem weil_relativeGluing_finite_etale_zmod_cover_of_affine_charts (ℓ : ℕ) (X : AlgebraicGeometry.Scheme.{u})
    (G : CategoryTheory.Functor X.AffineZariskiSite AlgebraicGeometry.Scheme.{u})
    (π_G : G ⟶ (AlgebraicGeometry.Scheme.AffineZariskiSite.directedCover X).functorOfLocallyDirected)
    (hEquifib : CategoryTheory.NatTrans.Equifibered π_G)
    (hFin : ∀ U : X.AffineZariskiSite, AlgebraicGeometry.IsFinite (π_G.app U))
    (hEt : ∀ U : X.AffineZariskiSite, AlgebraicGeometry.Etale (π_G.app U))
    (hSurj : ∀ U : X.AffineZariskiSite, AlgebraicGeometry.Surjective (π_G.app U))
    (ρ_G : ZMod ℓ → (G ⟶ G))
    (hρ_G_over : ∀ γ : ZMod ℓ, ρ_G γ ≫ π_G = π_G)
    (hρ_G0 : ρ_G 0 = 𝟙 G)
    (hρ_G_add : ∀ γ₁ γ₂ : ZMod ℓ, ρ_G (γ₁ + γ₂) = ρ_G γ₁ ≫ ρ_G γ₂) :
    ∃ (T : AlgebraicGeometry.Scheme.{u})
      (τ : T ⟶ X)
      (_ : AlgebraicGeometry.IsFinite τ)
      (_ : AlgebraicGeometry.Etale τ)
      (_ : AlgebraicGeometry.Surjective τ)
      (ρ : ZMod ℓ → (T ⟶ T))
      (hρ_over : ∀ γ : ZMod ℓ, ρ γ ≫ τ = τ)
      (ι_T : ∀ U : X.AffineZariskiSite, G.obj U ⟶ T)
      (_ : ∀ U : X.AffineZariskiSite, AlgebraicGeometry.IsOpenImmersion (ι_T U)),
      ρ 0 = 𝟙 T ∧
      (∀ γ₁ γ₂ : ZMod ℓ, ρ (γ₁ + γ₂) = ρ γ₁ ≫ ρ γ₂) ∧
      (⋃ U : X.AffineZariskiSite, Set.range (ι_T U).base) = Set.univ ∧
      (∀ {U V : X.AffineZariskiSite} (hUV : U ≤ V),
        G.map (CategoryTheory.homOfLE hUV) ≫ ι_T V = ι_T U) ∧
      (∀ U : X.AffineZariskiSite,
        CategoryTheory.IsPullback (π_G.app U) (ι_T U) U.1.ι τ) ∧
      (∀ (U : X.AffineZariskiSite) (γ : ZMod ℓ),
        ι_T U ≫ ρ γ = (ρ_G γ).app U ≫ ι_T U) :=
by
  have hfin_cancel_map_eqToHom :
      ∀ {X_top : TopCat.{u}} (F : TopCat.Presheaf CommRingCat.{u} X_top)
        {A B : TopologicalSpace.Opens X_top} (h : A = B) {R : CommRingCat.{u}}
        (a : R ⟶ F.obj (Opposite.op B)),
        (a ≫ F.map (eqToHom h).op).hom.Finite → a.hom.Finite := by
    intro X_top F A B h R a hab
    subst h
    rwa [eqToHom_refl, op_id, CategoryTheory.Functor.map_id,
      CategoryTheory.Category.comp_id] at hab
  have hMorProps : ∀ (T : AlgebraicGeometry.Scheme.{u}) (τ : T ⟶ X)
      (ι_T : ∀ U : X.AffineZariskiSite, G.obj U ⟶ T),
      (∀ U : X.AffineZariskiSite, AlgebraicGeometry.IsOpenImmersion (ι_T U)) →
      (∀ U : X.AffineZariskiSite,
        CategoryTheory.IsPullback (π_G.app U) (ι_T U) U.1.ι τ) →
      AlgebraicGeometry.IsFinite τ ∧
      AlgebraicGeometry.Etale τ ∧
      AlgebraicGeometry.Surjective τ := by
    intro T τ ι_T hOpen_ι hPB_ι
    have hSurj_τ : AlgebraicGeometry.Surjective τ := by
      refine ⟨fun x => ?_⟩
      obtain ⟨U₀, hU₀, hxU₀, _⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens X)
          (show x ∈ (⊤ : X.Opens) by trivial)
      let U : X.AffineZariskiSite := ⟨U₀, hU₀⟩
      obtain ⟨y, hy⟩ := (hSurj U).surj ⟨x, hxU₀⟩
      refine ⟨(ι_T U).base y, ?_⟩
      change (ι_T U ≫ τ).base y = x
      rw [← (hPB_ι U).w]
      change U.1.ι.base ((π_G.app U).base y) = x
      rw [hy]
      rfl
    have hex_iso : ∀ (U₀ : X.Opens) (hU₀ : AlgebraicGeometry.IsAffineOpen U₀),
        let U : X.AffineZariskiSite := ⟨U₀, hU₀⟩
        let p_U : G.obj U ⟶ U₀.toScheme := π_G.app U
        ∃ (e : (τ ⁻¹ᵁ U₀ : AlgebraicGeometry.Scheme.{u}) ≅ G.obj U),
          e.hom ≫ p_U = τ ∣_ U₀ := by
      intro U₀ hU₀
      let U : X.AffineZariskiSite := ⟨U₀, hU₀⟩
      let p_U : G.obj U ⟶ U₀.toScheme := π_G.app U
      have hPB_U : CategoryTheory.IsPullback p_U (ι_T U) U₀.ι τ := hPB_ι U
      have hPB_res := AlgebraicGeometry.isPullback_morphismRestrict τ U₀
      let φ : (τ ⁻¹ᵁ U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ G.obj U :=
        hPB_U.lift (τ ∣_ U₀) (τ ⁻¹ᵁ U₀).ι hPB_res.w
      let ψ : G.obj U ⟶ (τ ⁻¹ᵁ U₀ : AlgebraicGeometry.Scheme.{u}) :=
        hPB_res.lift p_U (ι_T U) hPB_U.w
      have hφ_fst : φ ≫ p_U = τ ∣_ U₀ := hPB_U.lift_fst _ _ _
      have hφ_snd : φ ≫ ι_T U = (τ ⁻¹ᵁ U₀).ι := hPB_U.lift_snd _ _ _
      have hψ_snd : ψ ≫ (τ ⁻¹ᵁ U₀).ι = ι_T U := hPB_res.lift_snd _ _ _
      have : AlgebraicGeometry.IsOpenImmersion (ι_T U) := hOpen_ι U
      have h_hom_inv : φ ≫ ψ = 𝟙 _ := by
        apply (CategoryTheory.cancel_mono (τ ⁻¹ᵁ U₀).ι).mp
        rw [CategoryTheory.Category.assoc, hψ_snd, hφ_snd, CategoryTheory.Category.id_comp]
      have h_inv_hom : ψ ≫ φ = 𝟙 _ := by
        apply (CategoryTheory.cancel_mono (ι_T U)).mp
        rw [CategoryTheory.Category.assoc, hφ_snd, hψ_snd, CategoryTheory.Category.id_comp]
      exact ⟨{ hom := φ, inv := ψ, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom }, hφ_fst⟩
    have hFin_res : ∀ (U₀ : X.Opens) (hU₀ : AlgebraicGeometry.IsAffineOpen U₀),
        AlgebraicGeometry.IsFinite (τ ∣_ U₀) := by
      intro U₀ hU₀
      let U : X.AffineZariskiSite := ⟨U₀, hU₀⟩
      let p_U : G.obj U ⟶ U₀.toScheme := π_G.app U
      have : AlgebraicGeometry.IsFinite p_U := hFin U
      obtain ⟨e_U, he_U⟩ := hex_iso U₀ hU₀
      have hres_eq : τ ∣_ U₀ = e_U.hom ≫ p_U := he_U.symm
      rw [hres_eq]
      infer_instance
    have hFin_τ : AlgebraicGeometry.IsFinite τ := by
      rw [AlgebraicGeometry.isFinite_iff]
      refine ⟨?_, ?_⟩
      · apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
        intro x
        obtain ⟨U₀, hU₀, hxU₀, _⟩ :=
          TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens X)
            (show x ∈ (⊤ : X.Opens) by trivial)
        let W₀ : X.Opens := U₀
        have hW₀ : AlgebraicGeometry.IsAffineOpen W₀ := hU₀
        have : AlgebraicGeometry.IsFinite (τ ∣_ W₀) := hFin_res W₀ hW₀
        have : AlgebraicGeometry.IsAffine W₀.toScheme := hW₀
        have hAff_pre : AlgebraicGeometry.IsAffineOpen (τ ⁻¹ᵁ W₀) :=
          AlgebraicGeometry.isAffine_of_isAffineHom (τ ∣_ W₀)
        exact ⟨W₀, hxU₀, hW₀, hAff_pre⟩
      · intro U₀ hU₀
        have : AlgebraicGeometry.IsFinite (τ ∣_ U₀) := hFin_res U₀ hU₀
        have : AlgebraicGeometry.IsAffine U₀.toScheme := hU₀
        have hfin_top : ((τ ∣_ U₀).appTop).hom.Finite :=
          AlgebraicGeometry.IsFinite.finite_app (τ ∣_ U₀) ⊤ (isAffineOpen_top _)
        rw [AlgebraicGeometry.morphismRestrict_appTop τ U₀] at hfin_top
        have hfin_img : (τ.app (U₀.ι ''ᵁ ⊤)).hom.Finite :=
          hfin_cancel_map_eqToHom T.presheaf _ _ hfin_top
        rwa [U₀.ι_image_top] at hfin_img
    have hEt_τ : AlgebraicGeometry.Etale τ := by
      rw [AlgebraicGeometry.etale_iff]
      intro U₀ hU₀ V hV hle
      let U : X.AffineZariskiSite := ⟨U₀, hU₀⟩
      let p_U : G.obj U ⟶ U₀.toScheme := π_G.app U
      have : AlgebraicGeometry.Etale p_U := hEt U
      obtain ⟨e_U, he_U⟩ := hex_iso U₀ hU₀
      have hres_eq : τ.resLE U₀ V hle = T.homOfLE hle ≫ e_U.hom ≫ p_U := by
        apply (CategoryTheory.cancel_mono U₀.ι).mp
        rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
        calc
          V.ι ≫ τ = (T.homOfLE hle ≫ (τ ⁻¹ᵁ U₀).ι) ≫ τ := by rw [T.homOfLE_ι hle]
          _ = T.homOfLE hle ≫ ((τ ⁻¹ᵁ U₀).ι ≫ τ) := CategoryTheory.Category.assoc _ _ _
          _ = T.homOfLE hle ≫ ((τ ∣_ U₀) ≫ U₀.ι) := by rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = T.homOfLE hle ≫ ((e_U.hom ≫ p_U) ≫ U₀.ι) := by rw [he_U]
          _ = (T.homOfLE hle ≫ e_U.hom ≫ p_U) ≫ U₀.ι := by
              simp only [CategoryTheory.Category.assoc]
      have : AlgebraicGeometry.Etale (τ.resLE U₀ V hle) := by
        rw [hres_eq]
        infer_instance
      have : AlgebraicGeometry.IsAffine U₀.toScheme := hU₀
      have : AlgebraicGeometry.IsAffine V.toScheme := hV
      have htop_le : (⊤ : V.toScheme.Opens) ≤ (τ.resLE U₀ V hle) ⁻¹ᵁ ⊤ :=
        fun _ _ => trivial
      have het_top : ((τ.resLE U₀ V hle).appLE ⊤ ⊤ htop_le).hom.Etale :=
        (AlgebraicGeometry.etale_iff (τ.resLE U₀ V hle)).mp inferInstance
          (isAffineOpen_top _) (isAffineOpen_top _) htop_le
      rw [AlgebraicGeometry.Scheme.Hom.resLE_appLE] at het_top
      exact (AlgebraicGeometry.Scheme.Hom.appLE_congr τ _
        U₀.ι_image_top V.ι_image_top (fun φ => φ.hom.Etale)).mp het_top
    exact ⟨hFin_τ, hEt_τ, hSurj_τ⟩
  let 𝒰_X := AlgebraicGeometry.Scheme.AffineZariskiSite.directedCover X
  let d : AlgebraicGeometry.Scheme.Cover.RelativeGluingData 𝒰_X :=
    AlgebraicGeometry.Scheme.Cover.RelativeGluingData.mk G π_G hEquifib
  have : CategoryTheory.Limits.HasColimit d.functor :=
    @AlgebraicGeometry.Scheme.IsLocallyDirected.instHasColimit _ _ d.functor
      (fun {_ _} f =>
        AlgebraicGeometry.Scheme.Cover.RelativeGluingData.instIsOpenImmersionMapI₀Functor d f)
      (AlgebraicGeometry.Scheme.Cover.RelativeGluingData.instIsLocallyDirectedI₀CompFunctorForgetOfIsThin d)
      inferInstance inferInstance
  let T : AlgebraicGeometry.Scheme.{u} := d.glued
  let τ : T ⟶ X := d.toBase
  let ι_T : ∀ U : X.AffineZariskiSite, G.obj U ⟶ T := fun U => d.cover.f U
  have hOpen_ι : ∀ U : X.AffineZariskiSite, AlgebraicGeometry.IsOpenImmersion (ι_T U) :=
    fun U => d.cover.map_prop U
  have hcf : ∀ U : X.AffineZariskiSite, ι_T U = CategoryTheory.Limits.colimit.ι d.functor U :=
    fun U => d.cover_f U
  have hCov_ι : (⋃ U : X.AffineZariskiSite, Set.range (ι_T U).base) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro t
    exact Set.mem_iUnion.mpr ⟨d.cover.idx t, d.cover.covers t⟩
  have hMap_ι : ∀ {U V : X.AffineZariskiSite} (hUV : U ≤ V),
      G.map (CategoryTheory.homOfLE hUV) ≫ ι_T V = ι_T U := by
    intro U V hUV
    rw [hcf V, hcf U]
    exact CategoryTheory.Limits.colimit.w d.functor (CategoryTheory.homOfLE hUV)
  have hPB_ι : ∀ U : X.AffineZariskiSite,
      CategoryTheory.IsPullback (π_G.app U) (ι_T U) U.1.ι τ := by
    intro U
    rw [hcf U]
    exact d.isPullback_natTrans_ι_toBase U
  let c_cocone : ZMod ℓ → CategoryTheory.Limits.Cocone d.functor := fun γ =>
    { pt := T
      ι :=
        { app := fun U => (ρ_G γ).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U
          naturality := fun {U V} f => by
            dsimp
            rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc]
            change (G.map f ≫ (ρ_G γ).app V) ≫ CategoryTheory.Limits.colimit.ι d.functor V = _
            rw [(ρ_G γ).naturality f, CategoryTheory.Category.assoc]
            congr 1
            exact CategoryTheory.Limits.colimit.w d.functor f } }
  let ρ : ZMod ℓ → (T ⟶ T) := fun γ =>
    CategoryTheory.Limits.colimit.desc d.functor (c_cocone γ)
  have hEquiv_ι : ∀ (U : X.AffineZariskiSite) (γ : ZMod ℓ),
      ι_T U ≫ ρ γ = (ρ_G γ).app U ≫ ι_T U := by
    intro U γ
    rw [hcf U]
    exact CategoryTheory.Limits.colimit.ι_desc (c_cocone γ) U
  have hρ_over : ∀ γ : ZMod ℓ, ρ γ ≫ τ = τ := by
    intro γ
    apply CategoryTheory.Limits.colimit.hom_ext
    intro U
    have hover_U : (ρ_G γ).app U ≫ d.natTrans.app U = d.natTrans.app U :=
      congrArg (fun η => η.app U) (hρ_G_over γ)
    calc
      CategoryTheory.Limits.colimit.ι d.functor U ≫ (ρ γ ≫ τ)
        = (CategoryTheory.Limits.colimit.ι d.functor U ≫ ρ γ) ≫ d.toBase :=
          (CategoryTheory.Category.assoc _ _ _).symm
      _ = ((ρ_G γ).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U) ≫ d.toBase := by
          rw [CategoryTheory.Limits.colimit.ι_desc (c_cocone γ) U]
      _ = (ρ_G γ).app U ≫ (CategoryTheory.Limits.colimit.ι d.functor U ≫ d.toBase) :=
          CategoryTheory.Category.assoc _ _ _
      _ = (ρ_G γ).app U ≫ (d.natTrans.app U ≫ 𝒰_X.f U) := by rw [d.ι_toBase U]
      _ = ((ρ_G γ).app U ≫ d.natTrans.app U) ≫ 𝒰_X.f U :=
          (CategoryTheory.Category.assoc _ _ _).symm
      _ = d.natTrans.app U ≫ 𝒰_X.f U := by rw [hover_U]
      _ = CategoryTheory.Limits.colimit.ι d.functor U ≫ τ := (d.ι_toBase U).symm
  have hρ0 : ρ 0 = 𝟙 T := by
    apply CategoryTheory.Limits.colimit.hom_ext
    intro U
    have h0_U : (ρ_G 0).app U = 𝟙 (G.obj U) :=
      congrArg (fun η => η.app U) hρ_G0
    calc
      CategoryTheory.Limits.colimit.ι d.functor U ≫ ρ 0
        = (ρ_G 0).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U :=
          CategoryTheory.Limits.colimit.ι_desc (c_cocone 0) U
      _ = 𝟙 (G.obj U) ≫ CategoryTheory.Limits.colimit.ι d.functor U := by rw [h0_U]
      _ = CategoryTheory.Limits.colimit.ι d.functor U := CategoryTheory.Category.id_comp _
      _ = CategoryTheory.Limits.colimit.ι d.functor U ≫ 𝟙 T :=
          (CategoryTheory.Category.comp_id _).symm
  have hρ_add : ∀ γ₁ γ₂ : ZMod ℓ, ρ (γ₁ + γ₂) = ρ γ₁ ≫ ρ γ₂ := by
    intro γ₁ γ₂
    apply CategoryTheory.Limits.colimit.hom_ext
    intro U
    have hadd_U : (ρ_G (γ₁ + γ₂)).app U = (ρ_G γ₁).app U ≫ (ρ_G γ₂).app U :=
      congrArg (fun η => η.app U) (hρ_G_add γ₁ γ₂)
    have h1 : CategoryTheory.Limits.colimit.ι d.functor U ≫ ρ γ₁ =
        (ρ_G γ₁).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U :=
      CategoryTheory.Limits.colimit.ι_desc (c_cocone γ₁) U
    have h2 : CategoryTheory.Limits.colimit.ι d.functor U ≫ ρ γ₂ =
        (ρ_G γ₂).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U :=
      CategoryTheory.Limits.colimit.ι_desc (c_cocone γ₂) U
    calc
      CategoryTheory.Limits.colimit.ι d.functor U ≫ ρ (γ₁ + γ₂)
        = (ρ_G (γ₁ + γ₂)).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U :=
          CategoryTheory.Limits.colimit.ι_desc (c_cocone (γ₁ + γ₂)) U
      _ = ((ρ_G γ₁).app U ≫ (ρ_G γ₂).app U) ≫ CategoryTheory.Limits.colimit.ι d.functor U := by
          rw [hadd_U]
      _ = (ρ_G γ₁).app U ≫ ((ρ_G γ₂).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U) :=
          CategoryTheory.Category.assoc _ _ _
      _ = (ρ_G γ₁).app U ≫ (CategoryTheory.Limits.colimit.ι d.functor U ≫ ρ γ₂) := by
          rw [← h2]
      _ = ((ρ_G γ₁).app U ≫ CategoryTheory.Limits.colimit.ι d.functor U) ≫ ρ γ₂ :=
          (CategoryTheory.Category.assoc _ _ _).symm
      _ = (CategoryTheory.Limits.colimit.ι d.functor U ≫ ρ γ₁) ≫ ρ γ₂ := by
          rw [← h1]
      _ = CategoryTheory.Limits.colimit.ι d.functor U ≫ (ρ γ₁ ≫ ρ γ₂) :=
          CategoryTheory.Category.assoc _ _ _
  obtain ⟨hFin_τ, hEt_τ, hSurj_τ⟩ := hMorProps T τ ι_T hOpen_ι hPB_ι
  exact ⟨T, τ, hFin_τ, hEt_τ, hSurj_τ, ρ, hρ_over, ι_T, hOpen_ι,
    hρ0, hρ_add, hCov_ι, hMap_ι, hPB_ι, hEquiv_ι⟩

theorem weil_etale_torsor_global_section_and_shear_partition_of_local_charts (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : AlgebraicGeometry.Scheme.{u})
    (P : CategoryTheory.Sheaf X.smallEtaleTopology (Type u))
    (actP : ZMod ℓ → (P ⟶ P))
    (hact0 : actP 0 = 𝟙 P)
    (hact_add : ∀ γ₁ γ₂ : ZMod ℓ, actP (γ₁ + γ₂) = actP γ₁ ≫ actP γ₂)
    (hTrans : ∀ (E : X.Etale) (s s' : P.obj.obj (Opposite.op E)),
      letI : AlgebraicGeometry.Etale E.hom := E.prop
      ∃! (f : LocallyConstant ↥E.left (ZMod ℓ)),
        ∀ (γ : ZMod ℓ),
          let O_γ : E.left.Opens := ⟨{x | f x = γ}, f.isLocallyConstant.isOpen_fiber γ⟩
          let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
          let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
          P.obj.map j_γ.op s' = P.obj.map j_γ.op ((actP γ).hom.app (Opposite.op E) s))
    (T : AlgebraicGeometry.Scheme.{u})
    (τ : T ⟶ X)
    (hEt_τ : AlgebraicGeometry.Etale τ)
    (ρ : ZMod ℓ → (T ⟶ T))
