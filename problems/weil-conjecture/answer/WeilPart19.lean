  have hIso_μ₁ : ∀ j : Fin s,
      CategoryTheory.IsIso
        ((μ₁ j) ∣_
          ((TopologicalSpace.Opens.map Y₁.left.nilradical.subschemeι.base).obj
            (U_tilde₁ j))) := by
    intro j
    have hComm_μ_red : p_C j ≫ μ₁ j = μ_bar j ≫ p_Y_red := by
      rw [← CategoryTheory.cancel_mono i₁]
      rw [CategoryTheory.Category.assoc, hLift₁ j, hComm_μ j,
        CategoryTheory.Category.assoc, hpY_red_comm, ← CategoryTheory.Category.assoc, hLift_bar j]
    have hHom_μ₁ : μ₁ j ≫ (i₁ ≫ Y₁.hom) = (C₁ j).hom := by
      rw [← CategoryTheory.Category.assoc, hLift₁ j]
      exact CategoryTheory.Over.w (μ_tilde₁ j)
    have hHom_μ_bar : μ_bar j ≫ (i_bar ≫ Y_bar.hom) = (C_bar j).hom := by
      rw [← CategoryTheory.Category.assoc, hLift_bar j]
      exact CategoryTheory.Over.w (μ_tilde_bar j)
    have hp_μ_red : CategoryTheory.IsPullback (p_C j) (μ_bar j) (μ₁ j) p_Y_red := by
      have hpC_rect : CategoryTheory.IsPullback (p_C j)
          (μ_bar j ≫ (i_bar ≫ Y_bar.hom)) (μ₁ j ≫ (i₁ ≫ Y₁.hom)) β := by
        rw [hHom_μ_bar, hHom_μ₁]
        exact hpC j
      exact CategoryTheory.IsPullback.of_bot hpC_rect hComm_μ_red hpY_red
    let U₁ : Y₁_red.Opens := (TopologicalSpace.Opens.map i₁.base).obj (U_tilde₁ j)
    let U_bar_red : Y_bar_red.Opens :=
      (TopologicalSpace.Opens.map i_bar.base).obj
        ((TopologicalSpace.Opens.map p_Y.base).obj (U_tilde₁ j))
    have hU_eq : (TopologicalSpace.Opens.map p_Y_red.base).obj U₁ = U_bar_red := by
      ext z
      change i₁.base (p_Y_red.base z) ∈ U_tilde₁ j ↔ p_Y.base (i_bar.base z) ∈ U_tilde₁ j
      have hpt := congrArg (fun h => h.base z) hpY_red_comm
      simpa using Eq.to_iff (congrArg (· ∈ U_tilde₁ j) hpt)
    have hRange_U : Set.range (U_bar_red.ι ≫ p_Y_red).base ⊆ Set.range U₁.ι.base := by
      rintro _ ⟨z, rfl⟩
      simp only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp,
        Function.comp_apply, AlgebraicGeometry.Scheme.Opens.range_ι]
      let y : ↥Y_bar_red := z.1
      have hy : y ∈ U_bar_red := z.2
      rw [← hU_eq] at hy
      exact hy
    let q_U : (U_bar_red : AlgebraicGeometry.Scheme.{u}) ⟶ (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift U₁.ι (U_bar_red.ι ≫ p_Y_red) hRange_U
    have hq_U_fac : U_bar_red.ι ≫ p_Y_red = q_U ≫ U₁.ι :=
      (AlgebraicGeometry.IsOpenImmersion.lift_fac U₁.ι (U_bar_red.ι ≫ p_Y_red) hRange_U).symm
    have hp_qU : CategoryTheory.IsPullback q_U U_bar_red.ι U₁.ι p_Y_red := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback _ _ _ _ hq_U_fac
      ext z
      change p_Y_red.base z ∈ Set.range U₁.ι.base ↔ z ∈ Set.range U_bar_red.ι.base
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι]
      change z ∈ (TopologicalSpace.Opens.map p_Y_red.base).obj U₁ ↔ z ∈ U_bar_red
      rw [hU_eq]
    let W₁ : (C₁ j).left.Opens := (TopologicalSpace.Opens.map (μ₁ j).base).obj U₁
    let W_bar_red : (C_bar j).left.Opens :=
      (TopologicalSpace.Opens.map (μ_bar j).base).obj U_bar_red
    have hW_eq : (TopologicalSpace.Opens.map (p_C j).base).obj W₁ = W_bar_red := by
      ext c
      change (μ₁ j).base ((p_C j).base c) ∈ U₁ ↔ (μ_bar j).base c ∈ U_bar_red
      rw [← hU_eq]
      change (μ₁ j).base ((p_C j).base c) ∈ U₁ ↔ p_Y_red.base ((μ_bar j).base c) ∈ U₁
      have hpt := congrArg (fun h => h.base c) hComm_μ_red
      simpa using Eq.to_iff (congrArg (· ∈ U₁) hpt)
    have hRange_W : Set.range (W_bar_red.ι ≫ p_C j).base ⊆ Set.range W₁.ι.base := by
      rintro _ ⟨c, rfl⟩
      simp only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp,
        Function.comp_apply, AlgebraicGeometry.Scheme.Opens.range_ι]
      let x : ↥(C_bar j).left := c.1
      have hx : x ∈ W_bar_red := c.2
      rw [← hW_eq] at hx
      exact hx
    let q_W : (W_bar_red : AlgebraicGeometry.Scheme.{u}) ⟶ (W₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift W₁.ι (W_bar_red.ι ≫ p_C j) hRange_W
    have hq_W_fac : W_bar_red.ι ≫ p_C j = q_W ≫ W₁.ι :=
      (AlgebraicGeometry.IsOpenImmersion.lift_fac W₁.ι (W_bar_red.ι ≫ p_C j) hRange_W).symm
    have hp_qW : CategoryTheory.IsPullback q_W W_bar_red.ι W₁.ι (p_C j) := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback _ _ _ _ hq_W_fac
      ext c
      change (p_C j).base c ∈ Set.range W₁.ι.base ↔ c ∈ Set.range W_bar_red.ι.base
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι]
      change c ∈ (TopologicalSpace.Opens.map (p_C j).base).obj W₁ ↔ c ∈ W_bar_red
      rw [hW_eq]
    have hp_res_rect : CategoryTheory.IsPullback q_W
        (((μ_bar j) ∣_ U_bar_red) ≫ U_bar_red.ι)
        (((μ₁ j) ∣_ U₁) ≫ U₁.ι) p_Y_red := by
      rw [AlgebraicGeometry.morphismRestrict_ι, AlgebraicGeometry.morphismRestrict_ι]
      exact hp_qW.paste_vert hp_μ_red
    have hRes_comm : q_W ≫ ((μ₁ j) ∣_ U₁) = ((μ_bar j) ∣_ U_bar_red) ≫ q_U := by
      rw [← CategoryTheory.cancel_mono U₁.ι]
      calc
        (q_W ≫ ((μ₁ j) ∣_ U₁)) ≫ U₁.ι
            = q_W ≫ (((μ₁ j) ∣_ U₁) ≫ U₁.ι) := CategoryTheory.Category.assoc _ _ _
        _ = (q_W ≫ W₁.ι) ≫ μ₁ j := by
          rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        _ = W_bar_red.ι ≫ (p_C j ≫ μ₁ j) := by
          rw [← hq_W_fac, CategoryTheory.Category.assoc]
        _ = (W_bar_red.ι ≫ μ_bar j) ≫ p_Y_red := by
          rw [hComm_μ_red, CategoryTheory.Category.assoc]
        _ = ((μ_bar j) ∣_ U_bar_red) ≫ (U_bar_red.ι ≫ p_Y_red) := by
          rw [← AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        _ = (((μ_bar j) ∣_ U_bar_red) ≫ q_U) ≫ U₁.ι := by
          rw [hq_U_fac, CategoryTheory.Category.assoc]
    have hp_res : CategoryTheory.IsPullback q_W
        ((μ_bar j) ∣_ U_bar_red) ((μ₁ j) ∣_ U₁) q_U :=
      CategoryTheory.IsPullback.of_bot hp_res_rect hRes_comm hp_qU
    have hp_qU_tot := (hp_qU.paste_vert hpY_red).flip
    have hSurj_qU : AlgebraicGeometry.Surjective q_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_qU_tot hSurj_β
    have hFlat_qU : AlgebraicGeometry.Flat q_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_qU_tot hFlat_β
    have hQC_qU : AlgebraicGeometry.QuasiCompact q_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_qU_tot hQC_β
    have hIso_bar_j : (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
        ((μ_bar j) ∣_ U_bar_red) :=
      hIso_bar j
    exact @CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback _ _
      (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
      (@AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓ @AlgebraicGeometry.QuasiCompact)
      AlgebraicGeometry.descendsAlong_isomorphisms_surjective_inf_flat_inf_quasicompact
      _ _ _ _ _ _ _ _ hp_res.flip ⟨⟨hSurj_qU, hFlat_qU⟩, hQC_qU⟩ hIso_bar_j
  exact ⟨μ₁, hInt₁, hLift₁, hFin_μ₁, hUniv₁, hIso_μ₁⟩

theorem weil_p1_flat_generic_fiber_curve_resolution_over_ext (K₀ : Type u) [Field K₀]
    (Y_K₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
    (π_K₀ : Y_K₀ ⟶ weilProjectiveSpaceOver K₀ 1)
    (hFin : AlgebraicGeometry.IsFinite π_K₀.left)
    (hFlat : AlgebraicGeometry.Flat π_K₀.left)
    (hSurj : AlgebraicGeometry.Surjective π_K₀.left) :
    ∃ (K₁ : Type u) (_ : Field K₁) (_ : Algebra K₀ K₁) (_ : FiniteDimensional K₀ K₁)
      (Ω₀ : Type u) (_ : Field Ω₀) (_ : IsAlgClosed Ω₀) (τ : K₁ →+* Ω₀)
      (s : ℕ)
      (C_K₁ : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₁)))
      (μ_K₁ : ∀ j : Fin s,
        (C_K₁ j).left ⟶ (weilBaseChangeOver K₀ K₁ Y_K₀).left.nilradical.subscheme)
      (U_comp_K₁ : Fin s → (weilBaseChangeOver K₀ K₁ Y_K₀).left.nilradical.subscheme.Opens),
      (∀ j : Fin s, AlgebraicGeometry.IsIntegral (C_K₁ j).left) ∧
      (∀ j : Fin s, IsProjectiveOverField K₁ (C_K₁ j)) ∧
      (∀ j : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension 1 (C_K₁ j).hom) ∧
      (∀ j : Fin s,
        AlgebraicGeometry.IsIntegral
          (CategoryTheory.Limits.pullback (C_K₁ j).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ)))) ∧
      (∀ j : Fin s, AlgebraicGeometry.IsFinite (μ_K₁ j)) ∧
      (∀ j : Fin s,
        μ_K₁ j ≫ (weilBaseChangeOver K₀ K₁ Y_K₀).left.nilradical.subschemeι ≫
          (weilBaseChangeOver K₀ K₁ Y_K₀).hom = (C_K₁ j).hom) ∧
      (⋃ j : Fin s, Set.range (μ_K₁ j).base) = Set.univ ∧
      ((⋃ j : Fin s,
        (U_comp_K₁ j : Set (weilBaseChangeOver K₀ K₁ Y_K₀).left.nilradical.subscheme))ᶜ).Finite ∧
      (∀ i j : Fin s, i ≠ j → Disjoint (U_comp_K₁ i) (U_comp_K₁ j)) ∧
      (∀ i j : Fin s, i ≠ j →
        ((μ_K₁ j).base) ⁻¹'
          (U_comp_K₁ i : Set (weilBaseChangeOver K₀ K₁ Y_K₀).left.nilradical.subscheme) = ∅) ∧
      (∀ j : Fin s, CategoryTheory.IsIso ((μ_K₁ j) ∣_ (U_comp_K₁ j))) :=
by
  let P₁ := weilProjectiveSpaceOver K₀ 1
  have hPropP₁ : AlgebraicGeometry.IsProper P₁.hom := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K₀
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let : IsScalarTower K₀ ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) K₀) :=
      IsScalarTower.of_algebraMap_eq (R := K₀) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (1 + 1)) K₀)
        (fun _ => rfl)
    let : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) K₀) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K₀ ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) K₀)
    let φ : K₀ →+* ↥(𝒜 0) := algebraMap K₀ ↥(𝒜 0)
    have hφ_bij : Function.Bijective φ := by
      constructor
      · intro a b hab
        exact MvPolynomial.C_injective (Fin (1 + 1)) K₀ (congrArg Subtype.val hab)
      · intro x
        have hx : x.1 ∈ (1 : Submodule K₀ (MvPolynomial (Fin (1 + 1)) K₀)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero]
          exact x.2
        rw [Submodule.mem_one] at hx
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, Subtype.ext hr⟩
    have : CategoryTheory.IsIso (CommRingCat.ofHom φ) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom φ)).mpr hφ_bij
    dsimp [P₁, weilProjectiveSpaceOver]
    infer_instance
  letI : AlgebraicGeometry.IsProper P₁.hom := hPropP₁
  letI : AlgebraicGeometry.IsFinite π_K₀.left := hFin
  have hPropYK₀ : AlgebraicGeometry.IsProper Y_K₀.hom := by
    have hEq : π_K₀.left ≫ P₁.hom = Y_K₀.hom := CategoryTheory.Over.w π_K₀
    rw [← hEq]
    infer_instance
  letI : AlgebraicGeometry.IsProper Y_K₀.hom := hPropYK₀
  obtain ⟨s, C_bar, μ_tilde_bar, μ_bar, U_bar,
    hInt_bar, hProj_bar, hSm_bar, hFin_bar, hLift_bar,
    hUniv_bar, hFinCompl_bar, hDisj_bar, hEmpty_bar, hIso_bar⟩ :=
    weil_algClosed_p1_baseChange_flat_cover_curve_resolution K₀ Y_K₀ π_K₀ hFin hFlat hSurj
  obtain ⟨L₁, hFinDimL₁, C_L₁, μ_tilde_L₁, p_C, U_tilde_L₁,
    hProj_L₁, hSm_L₁, hpC, hComm_μ, hU_eq⟩ :=
    weil_finite_tuple_curve_model_descent_over_algClosure K₀ Y_K₀ s C_bar μ_tilde_bar U_bar
      hProj_bar hSm_bar
  letI : FiniteDimensional K₀ ↥L₁ := hFinDimL₁
  let Ω₀ : Type u := AlgebraicClosure K₀
  let τ : ↥L₁ →+* Ω₀ := algebraMap ↥L₁ Ω₀
  let Y₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₁)) :=
    weilBaseChangeOver K₀ ↥L₁ Y_K₀
  let Y_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) :=
    weilBaseChangeOver K₀ Ω₀ Y_K₀
  have hPropY₁ : AlgebraicGeometry.IsProper Y₁.hom := by
    dsimp [Y₁, weilBaseChangeOver]
    infer_instance
  letI : AlgebraicGeometry.IsProper Y₁.hom := hPropY₁
  let p_Y : Y_bar.left ⟶ Y₁.left := weilBaseChangeMap K₀ ↥L₁ Ω₀ Y_K₀
  let β : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥L₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ)
  have hpY : CategoryTheory.IsPullback p_Y Y_bar.hom Y₁.hom β := by
    let e_L₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ ↥L₁))
    let e_Ω₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ Ω₀))
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom e_L₁)
    have h_fst : p_Y ≫ CategoryTheory.Limits.pullback.fst Y_K₀.hom e_L₁ =
        CategoryTheory.Limits.pullback.fst Y_K₀.hom e_Ω₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have h_bot : β ≫ e_L₁ = e_Ω₀ := by
      dsimp [β, τ, e_L₁, e_Ω₀]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq K₀ ↥L₁ Ω₀]
    rw [h_fst, h_bot]
    exact CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom e_Ω₀
  have hIso_bar' : ∀ j : Fin s,
      CategoryTheory.IsIso
        ((μ_bar j) ∣_
          ((TopologicalSpace.Opens.map Y_bar.left.nilradical.subschemeι.base).obj
            ((TopologicalSpace.Opens.map p_Y.base).obj (U_tilde_L₁ j)))) := by
    intro j
    rw [hU_eq j]
    exact hIso_bar j
  obtain ⟨μ₁, hInt_L₁, hLift₁, hFin_μ₁, hUniv_μ₁, hIso_μ₁⟩ :=
    weil_field_ext_nilradical_curve_cover_fpqc_descent ↥L₁ Ω₀ Y₁ Y_bar p_Y hpY
      s C_L₁ C_bar p_C hpC hProj_L₁ hInt_bar μ_tilde_L₁ μ_tilde_bar hComm_μ
      hFin_bar hUniv_bar μ_bar hLift_bar U_tilde_L₁ hIso_bar'
  let i₁ := Y₁.left.nilradical.subschemeι
  let U_comp_K₁ : Fin s → Y₁.left.nilradical.subscheme.Opens :=
    fun j => (TopologicalSpace.Opens.map i₁.base).obj (U_tilde_L₁ j)
  have hSurj_β : AlgebraicGeometry.Surjective β :=
    ⟨fun x => ⟨default, Subsingleton.elim _ _⟩⟩
  have hSurj_pY : AlgebraicGeometry.Surjective p_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpY.flip hSurj_β
  have hSurj_pC : ∀ j : Fin s, AlgebraicGeometry.Surjective (p_C j) := fun j =>
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hpC j).flip hSurj_β
  have hInj_i₁ : Function.Injective i₁.base :=
    ((AlgebraicGeometry.isClosedImmersion_iff i₁).mp inferInstance).2.injective
  refine ⟨↥L₁, inferInstance, inferInstance, hFinDimL₁, Ω₀, inferInstance, inferInstance, τ,
    s, C_L₁, μ₁, U_comp_K₁,
    hInt_L₁, hProj_L₁, hSm_L₁, ?_, hFin_μ₁, ?_, hUniv_μ₁, ?_, ?_, ?_, hIso_μ₁⟩
  · intro j
    let e_j : (C_bar j).left ≅ CategoryTheory.Limits.pullback (C_L₁ j).hom β :=
      (hpC j).isoPullback
    letI : AlgebraicGeometry.IsIntegral (C_bar j).left := hInt_bar j
    haveI : Nonempty ↥(CategoryTheory.Limits.pullback (C_L₁ j).hom β) :=
      Nonempty.map e_j.hom.base inferInstance
    exact AlgebraicGeometry.isIntegral_of_isOpenImmersion e_j.inv
  · intro j
    rw [← CategoryTheory.Category.assoc, hLift₁ j]
    exact CategoryTheory.Over.w (μ_tilde_L₁ j)
  · let S_bar : Set Y_bar.left := (⋃ j : Fin s, (U_bar j : Set Y_bar.left))ᶜ
    let S₁ : Set Y₁.left := (⋃ j : Fin s, (U_tilde_L₁ j : Set Y₁.left))ᶜ
    have hSub_S₁ : S₁ ⊆ p_Y.base '' S_bar := by
      intro y₁ hy₁
      obtain ⟨y_bar, hy_bar⟩ := hSurj_pY.surj y₁
      refine ⟨y_bar, ?_, hy_bar⟩
      intro hMem
      rw [Set.mem_iUnion] at hMem
      obtain ⟨j, hj⟩ := hMem
      have hj' : y_bar ∈ (TopologicalSpace.Opens.map p_Y.base).obj (U_tilde_L₁ j) := by
        rw [hU_eq j]
        exact hj
      have hy₁_mem : y₁ ∈ (U_tilde_L₁ j : Set Y₁.left) := by
        rw [← hy_bar]
        exact hj'
      exact hy₁ (Set.mem_iUnion.mpr ⟨j, hy₁_mem⟩)
    have hFin_S₁ : S₁.Finite := (hFinCompl_bar.image p_Y.base).subset hSub_S₁
    have hSub_red : ((⋃ j : Fin s, (U_comp_K₁ j : Set Y₁.left.nilradical.subscheme))ᶜ) ⊆
        i₁.base ⁻¹' S₁ := by
      intro z hz hMem
      rw [Set.mem_iUnion] at hMem
      obtain ⟨j, hj⟩ := hMem
      exact hz (Set.mem_iUnion.mpr ⟨j, hj⟩)
    exact (hFin_S₁.preimage hInj_i₁.injOn).subset hSub_red
  · intro i j hij
    rw [disjoint_iff_inf_le]
    intro z ⟨hzi, hzj⟩
    obtain ⟨y_bar, hy_bar⟩ := hSurj_pY.surj (i₁.base z)
    have hyi : y_bar ∈ U_bar i := by
      rw [← hU_eq i]
      show p_Y.base y_bar ∈ U_tilde_L₁ i
      rw [hy_bar]
      exact hzi
    have hyj : y_bar ∈ U_bar j := by
      rw [← hU_eq j]
      show p_Y.base y_bar ∈ U_tilde_L₁ j
      rw [hy_bar]
      exact hzj
    exact False.elim (disjoint_iff_inf_le.mp (hDisj_bar i j hij) ⟨hyi, hyj⟩)
  · intro i j hij
    rw [Set.eq_empty_iff_forall_notMem]
    intro c₁ hc₁
    obtain ⟨c_bar, hc_bar⟩ := (hSurj_pC j).surj c₁
    have hEq_pt : p_Y.base ((μ_tilde_bar j).left.base c_bar) = i₁.base ((μ₁ j).base c₁) := by
      calc
        p_Y.base ((μ_tilde_bar j).left.base c_bar)
            = ((μ_tilde_bar j).left ≫ p_Y).base c_bar := by simp
        _ = (p_C j ≫ (μ_tilde_L₁ j).left).base c_bar := by rw [hComm_μ j]
        _ = (μ_tilde_L₁ j).left.base ((p_C j).base c_bar) := by simp
        _ = (μ_tilde_L₁ j).left.base c₁ := by rw [hc_bar]
        _ = (μ₁ j ≫ i₁).base c₁ := by rw [hLift₁ j]
        _ = i₁.base ((μ₁ j).base c₁) := by simp
    have hMem_bar : (μ_tilde_bar j).left.base c_bar ∈ (U_bar i : Set Y_bar.left) := by
      show (μ_tilde_bar j).left.base c_bar ∈ U_bar i
      rw [← hU_eq i]
      show p_Y.base ((μ_tilde_bar j).left.base c_bar) ∈ U_tilde_L₁ i
      rw [hEq_pt]
      exact hc₁
    have hMem_pre : c_bar ∈ ((μ_tilde_bar j).left.base) ⁻¹' (U_bar i : Set Y_bar.left) :=
      hMem_bar
    rw [hEmpty_bar i j hij] at hMem_pre
    exact hMem_pre

theorem weil_smooth_affine_model_of_finite_fraction_ext (k : Type u) [Field k] [IsAlgClosed k]
    (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine Z₀.left]
    [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
    (hIntZ₀ : AlgebraicGeometry.IsIntegral Z₀.left)
    (K₀ : Type u) [Field K₀]
    (ι₀ : ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)) →+* K₀)
    (hFrac₀ : @IsFractionRing ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)) _ K₀ _ ι₀.toAlgebra)
    (K₁ : Type u) [Field K₁] [Algebra K₀ K₁] [FiniteDimensional K₀ K₁] :
    ∃ (A₁ : Type u) (_ : CommRing A₁) (_ : IsDomain A₁)
      (_ : Algebra k A₁) (_ : Algebra.FiniteType k A₁)
      (d₁ : ℕ)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension d₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁))))
      (_ : Algebra A₁ K₁) (_ : IsFractionRing A₁ K₁)
      (g_init : CategoryTheory.Over.mk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁))) ⟶ Z₀),
      (∀ (h : A₁), h ≠ 0 →
        let j_h : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of A₁) :=
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A₁ (Localization.Away h)))
        Function.Injective
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left))) ∧
        ∀ x : ↑((AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h))).presheaf.obj
            (Opposite.op ⊤)),
          ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
            p ≠ 0 ∧
            Polynomial.eval₂
              (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left)))
              x p = 0) ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ K₁)) ≫ g_init.left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K₁)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀) ≫ Z₀.left.isoSpec.inv :=
by
  classical
  
  have _ : AlgebraicGeometry.IsIntegral Z₀.left := hIntZ₀
  let R_cat : CommRingCat.{u} := Z₀.left.presheaf.obj (Opposite.op ⊤)
  let R₀ : Type u := ↑R_cat
  have _ : IsDomain R₀ := inferInstance
  let φ_kR₀ : CommRingCat.of k ⟶ R_cat :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appTop Z₀.hom
  let _ : Algebra k R₀ := (CommRingCat.Hom.hom φ_kR₀).toAlgebra
  have hφ_kR₀_eq : CommRingCat.ofHom (algebraMap k R₀) = φ_kR₀ := by
    ext x
    rfl
  have hZ₀_hom : Z₀.left.isoSpec.inv ≫ Z₀.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₀)) := by
    calc
      Z₀.left.isoSpec.inv ≫ Z₀.hom
        = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.appTop Z₀.hom) ≫
            (AlgebraicGeometry.Spec (CommRingCat.of k)).isoSpec.inv :=
          (AlgebraicGeometry.Scheme.isoSpec_inv_naturality Z₀.hom).symm
      _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.appTop Z₀.hom) ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
          rw [AlgebraicGeometry.Scheme.isoSpec_Spec_inv]
      _ = AlgebraicGeometry.Spec.map φ_kR₀ :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₀)) := by
          rw [hφ_kR₀_eq]
  have hLft_R₀ : AlgebraicGeometry.LocallyOfFiniteType
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₀))) := by
    rw [← hZ₀_hom]
    infer_instance
  have hFT_kR₀ : Algebra.FiniteType k R₀ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLft_R₀
  have hZ₀_appTop : AlgebraicGeometry.Scheme.Hom.appTop Z₀.left.isoSpec.inv =
      (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv := by
    have hcomp := congrArg AlgebraicGeometry.Scheme.Hom.appTop
      (AlgebraicGeometry.Scheme.isoSpec_inv_toSpecΓ Z₀.left)
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
      AlgebraicGeometry.Scheme.toSpecΓ_appTop] at hcomp
    have hid : AlgebraicGeometry.Scheme.Hom.appTop
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec R_cat)) =
        CategoryTheory.CategoryStruct.id _ := by
      simp
    rw [hid] at hcomp
    calc
      AlgebraicGeometry.Scheme.Hom.appTop Z₀.left.isoSpec.inv
        = (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv ≫
            ((AlgebraicGeometry.Scheme.ΓSpecIso R_cat).hom ≫
              AlgebraicGeometry.Scheme.Hom.appTop Z₀.left.isoSpec.inv) := by
          simp
      _ = (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv := by
          rw [hcomp, CategoryTheory.Category.comp_id]

  
  have h_appTop_spec : ∀ (B : Type u) [CommRing B] (ψ : R₀ →+* B),
      ∃ e_top : ↑((AlgebraicGeometry.Spec (CommRingCat.of B)).presheaf.obj (Opposite.op ⊤)) →+* B,
        Function.Injective e_top ∧
        e_top.comp
          (CommRingCat.Hom.hom
            (AlgebraicGeometry.Scheme.Hom.appTop
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ Z₀.left.isoSpec.inv))) = ψ := by
    intro B _ ψ
    let e_iso := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)
    let e_top : ↑((AlgebraicGeometry.Spec (CommRingCat.of B)).presheaf.obj (Opposite.op ⊤)) →+* B :=
      CommRingCat.Hom.hom e_iso.hom
    have he_top_inj : Function.Injective e_top := by
      intro u v huv
      have h_inv := congrArg (CommRingCat.Hom.hom e_iso.inv) huv
      have h1 : CommRingCat.Hom.hom (e_iso.hom ≫ e_iso.inv) u = u := by
        rw [e_iso.hom_inv_id]
        rfl
      have h2 : CommRingCat.Hom.hom (e_iso.hom ≫ e_iso.inv) v = v := by
        rw [e_iso.hom_inv_id]
        rfl
      exact h1.symm.trans (h_inv.trans h2)
    have happTop_eq : AlgebraicGeometry.Scheme.Hom.appTop
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ Z₀.left.isoSpec.inv) =
        CommRingCat.ofHom ψ ≫ e_iso.inv := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, hZ₀_appTop]
      exact (AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ψ)).symm
    have h_cat : AlgebraicGeometry.Scheme.Hom.appTop
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ Z₀.left.isoSpec.inv) ≫ e_iso.hom =
        CommRingCat.ofHom ψ := by
      rw [happTop_eq, CategoryTheory.Category.assoc, e_iso.inv_hom_id,
        CategoryTheory.Category.comp_id]
    refine ⟨e_top, he_top_inj, ?_⟩
    ext r
    exact congrArg (fun f => CommRingCat.Hom.hom f r) h_cat

  
  let _ : Algebra R₀ K₀ := ι₀.toAlgebra
  have _ : IsFractionRing R₀ K₀ := hFrac₀
  let φ₀ : R₀ →+* K₁ := (algebraMap K₀ K₁).comp ι₀
  have hφ₀_inj : Function.Injective φ₀ :=
    (RingHom.injective (algebraMap K₀ K₁)).comp (IsFractionRing.injective R₀ K₀)
  have h_inj_and_alg : ∀ (B : Type u) [CommRing B] (β : B →+* K₁),
      Function.Injective β →
      ∀ (ψ : R₀ →+* B), β.comp ψ = (algebraMap K₀ K₁).comp ι₀ →
        Function.Injective ψ ∧
        ∀ x : B, ∃ p : Polynomial R₀, p ≠ 0 ∧ Polynomial.eval₂ ψ x p = 0 := by
    intro B _ β hβ ψ hcomm
    have hψ_inj : Function.Injective ψ := by
      apply Function.Injective.of_comp (f := β)
      change Function.Injective (β.comp ψ)
      rw [hcomm]
      exact hφ₀_inj
    refine ⟨hψ_inj, fun x => ?_⟩
    let z : K₁ := β x
    have hz_int : IsIntegral K₀ z := Algebra.IsIntegral.isIntegral z
    let q : Polynomial K₀ := minpoly K₀ z
    have hq_ne : q ≠ 0 := minpoly.ne_zero hz_int
    have hq_ev : Polynomial.eval₂ (algebraMap K₀ K₁) z q = 0 := by
      rw [← Polynomial.aeval_def]
      exact minpoly.aeval K₀ z
    let p : Polynomial R₀ :=
      IsLocalization.integerNormalization (nonZeroDivisors R₀) q
    have hp_ne : p ≠ 0 :=
      mt (IsFractionRing.integerNormalization_eq_zero_iff (A := R₀) (K := K₀) (p := q)).mp hq_ne
    have hp_evK₁ : Polynomial.eval₂ ((algebraMap K₀ K₁).comp ι₀) z p = 0 :=
      IsLocalization.integerNormalization_eval₂_eq_zero
        (nonZeroDivisors R₀) (algebraMap K₀ K₁) q hq_ev
    refine ⟨p, hp_ne, ?_⟩
    apply hβ
    rw [map_zero, Polynomial.hom_eval₂ p ψ β x, hcomm]
    exact hp_evK₁

  
  have h_finish : ∀ (A : Type u) [CommRing A] [IsDomain A]
      [Algebra k A] [Algebra.FiniteType k A]
      (d : ℕ)
      [AlgebraicGeometry.SmoothOfRelativeDimension d
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))]
      [Algebra A K₁] [IsFractionRing A K₁]
      (φ : R₀ →ₐ[k] A),
      (algebraMap A K₁).comp φ.toRingHom = (algebraMap K₀ K₁).comp ι₀ →
      ∃ (A₁ : Type u) (_ : CommRing A₁) (_ : IsDomain A₁)
        (_ : Algebra k A₁) (_ : Algebra.FiniteType k A₁)
        (d₁ : ℕ)
        (_ : AlgebraicGeometry.SmoothOfRelativeDimension d₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁))))
        (_ : Algebra A₁ K₁) (_ : IsFractionRing A₁ K₁)
        (g_init : CategoryTheory.Over.mk
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁))) ⟶ Z₀),
        (∀ (h : A₁), h ≠ 0 →
          let j_h : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶
              AlgebraicGeometry.Spec (CommRingCat.of A₁) :=
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap A₁ (Localization.Away h)))
          Function.Injective
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left))) ∧
          ∀ x : ↑((AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h))).presheaf.obj
              (Opposite.op ⊤)),
            ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
              p ≠ 0 ∧
              Polynomial.eval₂
                (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left)))
                x p = 0) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ K₁)) ≫ g_init.left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K₁)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀) ≫ Z₀.left.isoSpec.inv := by
    intro A _ _ _ _ d _ _ _ φ hφ_K₁
    let g_left : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Z₀.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Z₀.left.isoSpec.inv
    have h_over : g_left ≫ Z₀.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) := by
      dsimp only [g_left]
      rw [CategoryTheory.Category.assoc, hZ₀_hom, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext c
      exact φ.commutes c
    let g_init : CategoryTheory.Over.mk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))) ⟶ Z₀ :=
      CategoryTheory.Over.homMk g_left h_over
    have hg_init_left : g_init.left = g_left := rfl
    refine ⟨A, inferInstance, inferInstance, inferInstance, inferInstance, d, inferInstance,
      inferInstance, inferInstance, g_init, ?_, ?_⟩
    · intro h hh_ne j_h
      let ψ_h : R₀ →+* Localization.Away h :=
        (algebraMap A (Localization.Away h)).comp φ.toRingHom
      have hjg_eq : j_h ≫ g_init.left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_h) ≫ Z₀.left.isoSpec.inv := by
        rw [hg_init_left]
        change AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A (Localization.Away h))) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Z₀.left.isoSpec.inv) = _
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        rfl
      obtain ⟨e_top, he_top_inj, he_top_comp⟩ := h_appTop_spec (Localization.Away h) ψ_h
      have he_comp_jh : e_top.comp
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left))) =
          ψ_h := by
        rw [hjg_eq]
        exact he_top_comp
      have _ : IsDomain (Localization.Away h) :=
        IsLocalization.isDomain_localization
          (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hh_ne))
      have hh_K₁_ne : algebraMap A K₁ h ≠ 0 := by
        intro h0
        apply hh_ne
        exact IsFractionRing.injective A K₁ (h0.trans (map_zero _).symm)
      have hh_unit : IsUnit (algebraMap A K₁ h) := IsUnit.mk0 _ hh_K₁_ne
      let lift_h : Localization.Away h →+* K₁ := IsLocalization.Away.lift h hh_unit
      let _ : Algebra (Localization.Away h) K₁ := lift_h.toAlgebra
      have _ : IsScalarTower A (Localization.Away h) K₁ :=
        IsScalarTower.of_algebraMap_eq (R := A) (S := Localization.Away h) (A := K₁)
          (fun a => (IsLocalization.Away.lift_eq h hh_unit a).symm)
      have _ : IsFractionRing (Localization.Away h) K₁ :=
        IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
          (Submonoid.powers h) (Localization.Away h) K₁
      have hlift_h_inj : Function.Injective lift_h :=
        IsFractionRing.injective (Localization.Away h) K₁
      let β := lift_h.comp e_top
      have hβ_inj : Function.Injective β := hlift_h_inj.comp he_top_inj
      have hβ_comm : β.comp
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left))) =
          (algebraMap K₀ K₁).comp ι₀ := by
        calc
          β.comp (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left)))
            = lift_h.comp (e_top.comp
                (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left)))) :=
              RingHom.comp_assoc _ _ _
          _ = lift_h.comp ψ_h := by rw [he_comp_jh]
          _ = (algebraMap A K₁).comp φ.toRingHom := by
              ext r
              change lift_h (algebraMap A (Localization.Away h) (φ r)) = algebraMap A K₁ (φ r)
              exact IsLocalization.Away.lift_eq h hh_unit (φ r)
          _ = (algebraMap K₀ K₁).comp ι₀ := hφ_K₁
      exact h_inj_and_alg _ β hβ_inj
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (j_h ≫ g_init.left))) hβ_comm
    · rw [hg_init_left]
      dsimp only [g_left]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      congr 2
      ext r
      exact RingHom.congr_fun hφ_K₁ r

  
  let _ : Algebra R₀ K₁ := φ₀.toAlgebra
  have _ : IsScalarTower R₀ K₀ K₁ := IsScalarTower.of_algebraMap_eq' rfl
  let _ : Algebra k K₁ := (φ₀.comp (algebraMap k R₀)).toAlgebra
  have _ : IsScalarTower k R₀ K₁ := IsScalarTower.of_algebraMap_eq' rfl
  let b := Module.Basis.ofVectorSpace K₀ K₁
  let S₀ : Subalgebra R₀ K₁ := Algebra.adjoin R₀ (Set.range b)
  let A₀ : Type u := ↥S₀
  have hFT_R₀A₀ : Algebra.FiniteType R₀ A₀ :=
    Algebra.FiniteType.adjoin_of_finite (Set.finite_range b)
  have hFT_kA₀ : Algebra.FiniteType k A₀ :=
    Algebra.FiniteType.trans hFT_kR₀ hFT_R₀A₀
  let _ : Algebra A₀ K₁ :=
    { S₀.val.toRingHom.toAlgebra with
      smul := (· • ·)
      smul_def' := fun _ _ => rfl }
  have _ : IsScalarTower k A₀ K₁ := IsScalarTower.of_algebraMap_eq' rfl
  have _ : IsScalarTower R₀ A₀ K₁ := IsScalarTower.of_algebraMap_eq' rfl
  let α₀ : R₀ →ₐ[k] A₀ := IsScalarTower.toAlgHom k R₀ A₀
  have hα₀_comm : (algebraMap A₀ K₁).comp α₀.toRingHom = (algebraMap K₀ K₁).comp ι₀ := by
    ext r
    rfl
  have hFracA₀ : IsFractionRing A₀ K₁ := by
    refine
      { map_units := fun y => ?_
        surj := fun z => ?_
        exists_of_eq := fun {x y} hxy => ?_ }
    · have hy0 : (y : A₀) ≠ 0 := nonZeroDivisors.ne_zero y.2
      have hyK₁ : (algebraMap A₀ K₁ (y : A₀)) ≠ 0 := by
        intro h0
        apply hy0
        exact Subtype.ext h0
      exact IsUnit.mk0 _ hyK₁
    · let _ : Fintype (Module.Basis.ofVectorSpaceIndex K₀ K₁) := Fintype.ofFinite _
      have hz_sum : ∑ i, b.repr z i • b i = z := b.sum_repr z
      let s_fin : Finset K₀ := Finset.univ.image (fun i => b.repr z i)
      obtain ⟨d₀, hd₀⟩ :=
        IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors R₀) s_fin
      have hd₀_mem : ∀ i, IsLocalization.IsInteger R₀ ((d₀ : R₀) • b.repr z i) := fun i =>
        hd₀ (b.repr z i) (Finset.mem_image_of_mem _ (Finset.mem_univ i))
      let r_fn : Module.Basis.ofVectorSpaceIndex K₀ K₁ → R₀ := fun i => (hd₀_mem i).choose
      have hr_fn : ∀ i, algebraMap R₀ K₀ (r_fn i) =
          algebraMap R₀ K₀ (d₀ : R₀) * b.repr z i := fun i =>
        (hd₀_mem i).choose_spec.trans (Algebra.smul_def (d₀ : R₀) (b.repr z i))
      let x₀ : A₀ :=
        ⟨∑ i, φ₀ (r_fn i) * b i,
          S₀.sum_mem fun i _ =>
            S₀.mul_mem (S₀.algebraMap_mem (r_fn i)) (Algebra.subset_adjoin ⟨i, rfl⟩)⟩
      let y₀ : A₀ := algebraMap R₀ A₀ (d₀ : R₀)
      have hy₀_ne : y₀ ≠ 0 := by
        intro hy0
        have hd0_ne : (d₀ : R₀) ≠ 0 := nonZeroDivisors.ne_zero d₀.2
        apply hd0_ne
        apply hφ₀_inj
        rw [map_zero]
        exact congrArg Subtype.val hy0
      have hy₀_nzd : y₀ ∈ nonZeroDivisors A₀ := mem_nonZeroDivisors_of_ne_zero hy₀_ne
      refine ⟨⟨x₀, ⟨y₀, hy₀_nzd⟩⟩, ?_⟩
      change z * y₀.1 = x₀.1
      have hx₀_val : x₀.1 = ∑ i, φ₀ (r_fn i) * b i := rfl
      have hy₀_val : y₀.1 = algebraMap K₀ K₁ (algebraMap R₀ K₀ (d₀ : R₀)) := rfl
      rw [hx₀_val, hy₀_val, ← hz_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def]
      calc
        (algebraMap K₀ K₁ (b.repr z i) * b i) *
            algebraMap K₀ K₁ (algebraMap R₀ K₀ (d₀ : R₀))
          = (algebraMap K₀ K₁ (algebraMap R₀ K₀ (d₀ : R₀)) *
              algebraMap K₀ K₁ (b.repr z i)) * b i := by ring
        _ = algebraMap K₀ K₁ (algebraMap R₀ K₀ (d₀ : R₀) * b.repr z i) * b i := by
            rw [← map_mul]
        _ = φ₀ (r_fn i) * b i := by
            rw [← hr_fn i]
            rfl
    · have h_eq : x = y := Subtype.ext hxy
      exact ⟨1, by simp [h_eq]⟩

  
  have h_compl : (⊥ : Ideal A₀).primeCompl = nonZeroDivisors A₀ := by
    ext x
    simp [Ideal.primeCompl, mem_nonZeroDivisors_iff_ne_zero]
  have _ : IsLocalization (⊥ : Ideal A₀).primeCompl K₁ := by
    rw [h_compl]
    exact hFracA₀
  let e_gen : K₁ ≃ₐ[k] Localization.AtPrime (⊥ : Ideal A₀) :=
    (IsLocalization.algEquiv (⊥ : Ideal A₀).primeCompl K₁
      (Localization.AtPrime (⊥ : Ideal A₀))).restrictScalars k
  have _ : Algebra.EssFiniteType A₀ K₁ :=
    Algebra.EssFiniteType.of_isLocalization K₁ (nonZeroDivisors A₀)
  have _ : Algebra.EssFiniteType k K₁ :=
    Algebra.EssFiniteType.comp k A₀ K₁
  have _ : PerfectField k := IsAlgClosed.perfectField k
  have _ : Algebra.FormallySmooth k K₁ := Algebra.FormallySmooth.of_perfectField
  have _ : Algebra.FormallySmooth k (Localization.AtPrime (⊥ : Ideal A₀)) :=
    Algebra.FormallySmooth.of_equiv e_gen
  have _ : Algebra.IsSmoothAt k (⊥ : Ideal A₀) := inferInstance
  have _ : Algebra.FinitePresentation k A₀ :=
    Algebra.FinitePresentation.of_finiteType.mp hFT_kA₀
  obtain ⟨f₀, hf₀_notMem, hStd⟩ :=
    Algebra.IsSmoothAt.exists_notMem_isStandardSmooth k (⊥ : Ideal A₀)
  have hf₀_ne : f₀ ≠ 0 := by
    simpa [Submodule.mem_bot] using hf₀_notMem
  rcases hStd.out with ⟨ι_sm, σ_sm, hσ_fin, hι_fin, ⟨P_sm⟩⟩
  let d₁ : ℕ := P_sm.dimension
  have hStdDim : Algebra.IsStandardSmoothOfRelativeDimension d₁ k (Localization.Away f₀) :=
    @Algebra.SubmersivePresentation.isStandardSmoothOfRelativeDimension
      d₁ k (Localization.Away f₀) ι_sm σ_sm _ _ _ hσ_fin hι_fin P_sm rfl
  have hRingStdDim : RingHom.IsStandardSmoothOfRelativeDimension d₁
      (algebraMap k (Localization.Away f₀)) :=
    (RingHom.isStandardSmoothOfRelativeDimension_algebraMap d₁).mpr hStdDim
  have hLocStdDim : RingHom.Locally (@RingHom.IsStandardSmoothOfRelativeDimension d₁)
      (algebraMap k (Localization.Away f₀)) :=
    RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
      (algebraMap k (Localization.Away f₀)) hRingStdDim
  have hSm_A₁ : AlgebraicGeometry.SmoothOfRelativeDimension d₁
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap k (Localization.Away f₀)))) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension d₁)).mpr hLocStdDim

  
  let A₁ : Type u := Localization.Away f₀
  have _ : IsDomain A₁ :=
    IsLocalization.isDomain_localization
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf₀_ne))
  have hFT_A₀A₁ : Algebra.FiniteType A₀ A₁ :=
    IsLocalization.finiteType_of_monoid_fg (Submonoid.powers f₀) A₁
  have _ : Algebra.FiniteType k A₁ :=
    Algebra.FiniteType.trans hFT_kA₀ hFT_A₀A₁
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension d₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁))) := hSm_A₁
  have hf₀_K₁_ne : algebraMap A₀ K₁ f₀ ≠ 0 := by
    intro h0
    apply hf₀_ne
    exact IsFractionRing.injective A₀ K₁ (h0.trans (map_zero _).symm)
  have hf₀_unit : IsUnit (algebraMap A₀ K₁ f₀) := IsUnit.mk0 _ hf₀_K₁_ne
  let lift₀ : A₁ →+* K₁ := IsLocalization.Away.lift f₀ hf₀_unit
  let _ : Algebra A₁ K₁ := lift₀.toAlgebra
  have _ : IsScalarTower A₀ A₁ K₁ :=
    IsScalarTower.of_algebraMap_eq (R := A₀) (S := A₁) (A := K₁)
      (fun a => (IsLocalization.Away.lift_eq f₀ hf₀_unit a).symm)
  have _ : IsFractionRing A₁ K₁ :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers f₀) A₁ K₁
  let φ₁ : R₀ →ₐ[k] A₁ := (IsScalarTower.toAlgHom k A₀ A₁).comp α₀
  have hφ₁_K₁ : (algebraMap A₁ K₁).comp φ₁.toRingHom = (algebraMap K₀ K₁).comp ι₀ := by
    ext r
    change lift₀ (algebraMap A₀ A₁ (α₀ r)) = algebraMap K₀ K₁ (ι₀ r)
    rw [IsLocalization.Away.lift_eq f₀ hf₀_unit (α₀ r)]
    exact RingHom.congr_fun hα₀_comm r
  exact h_finish A₁ d₁ φ₁ hφ₁_K₁

theorem weil_schematicClosure_and_nilradical_over_fractionRing (R : Type u) [CommRing R] [IsDomain R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K] :
    let ξ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))
    (∀ (Y Y_K : AlgebraicGeometry.Scheme.{u})
        (f : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (p : Y_K ⟶ Y)
        (h_K : Y_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
      CategoryTheory.IsPullback p h_K f ξ →
      ∃ (e_red : CategoryTheory.Limits.pullback Y.nilradical.subschemeι p ≅
          Y_K.nilradical.subscheme),
        e_red.hom ≫ Y_K.nilradical.subschemeι =
          CategoryTheory.Limits.pullback.snd Y.nilradical.subschemeι p) ∧
    (∀ (P P_K : AlgebraicGeometry.Scheme.{u})
        (f_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (q_P : P_K ⟶ P)
        (f_PK : P_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
      CategoryTheory.IsPullback q_P f_PK f_P ξ →
      Function.Injective q_P.base ∧
      Set.range q_P.base = f_P.base ⁻¹' (Set.range ξ.base) ∧
      ∀ (W_K : AlgebraicGeometry.Scheme.{u}) (ι_K : W_K ⟶ P_K)
          [AlgebraicGeometry.IsClosedImmersion ι_K],
        ∃ (q_W : W_K ⟶ AlgebraicGeometry.Scheme.Hom.image (ι_K ≫ q_P)),
          CategoryTheory.IsPullback q_W ι_K
            (AlgebraicGeometry.Scheme.Hom.imageι (ι_K ≫ q_P)) q_P) :=
by
  intro ξ
  have hAff_ξ : AlgebraicGeometry.IsAffineHom ξ :=
    AlgebraicGeometry.isAffineHom_of_isAffine ξ
  have hAffPullback :
      ∀ {X X_K : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (q : X_K ⟶ X)
        (f_K : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
        CategoryTheory.IsPullback q f_K f ξ →
        AlgebraicGeometry.IsAffineHom q := by
    intro X X_K f q f_K hp
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp.flip hAff_ξ
  have hCover :
      ∀ {X X_K : AlgebraicGeometry.Scheme.{u}}
        (q : X_K ⟶ X) [AlgebraicGeometry.IsAffineHom q],
        (⨆ (U : X.affineOpens),
          (((TopologicalSpace.Opens.map q.base).obj U.1 : X_K.Opens))) = ⊤ := by
    intro X X_K q _
    rw [eq_top_iff]
    intro x _
    have hx : q.base x ∈ (⨆ (U : X.affineOpens), (U : X.Opens)) := by
      rw [AlgebraicGeometry.iSup_affineOpens_eq_top X]
      trivial
    rcases TopologicalSpace.Opens.mem_iSup.mp hx with ⟨U, hU⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨U, hU⟩
  have hLocalLoc :
      ∀ {X X_K : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (q : X_K ⟶ X)
        (f_K : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (hp : CategoryTheory.IsPullback q f_K f ξ)
        [AlgebraicGeometry.IsAffineHom q]
        (U : X.affineOpens),
        let U₀ : X.Opens := U.1
        let hU : AlgebraicGeometry.IsAffineOpen U₀ := U.2
        let V₀ : X_K.Opens := (TopologicalSpace.Opens.map q.base).obj U₀
        let hV : AlgebraicGeometry.IsAffineOpen V₀ :=
          AlgebraicGeometry.IsAffineHom.isAffine_preimage U₀ hU
        (hV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (q.app U₀) =
          (q ∣_ U₀) ≫ hU.isoSpec.hom) ∧
        (∃ (M_U : Submonoid ↑(X.presheaf.obj (Opposite.op U₀))),
          @IsLocalization ↑(X.presheaf.obj (Opposite.op U₀)) _ M_U
            ↑(X_K.presheaf.obj (Opposite.op V₀)) _
            (CommRingCat.Hom.hom (q.app U₀)).toAlgebra) := by
    intro X X_K f q f_K hp _ U U₀ hU V₀ hV
    have h_comm :
        hV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (q.app U₀) =
          (q ∣_ U₀) ≫ hU.isoSpec.hom := by
      have h0 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE q U₀ V₀ le_rfl
      rw [AlgebraicGeometry.Scheme.Hom.appLE_eq_app,
        AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict,
        ← hV.isoSpec_hom, ← hU.isoSpec_hom] at h0
      exact h0
    refine ⟨h_comm, ?_⟩
    have hp_res : CategoryTheory.IsPullback (q ∣_ U₀) (V₀.ι ≫ f_K) (U₀.ι ≫ f) ξ :=
      ((AlgebraicGeometry.isPullback_morphismRestrict q U₀).flip.paste_horiz hp.flip).flip
    let D_cat : CommRingCat.{u} := X.presheaf.obj (Opposite.op U₀)
    let B_cat : CommRingCat.{u} := X_K.presheaf.obj (Opposite.op V₀)
    let φ_RD : CommRingCat.of R ⟶ D_cat :=
      AlgebraicGeometry.Spec.preimage (hU.isoSpec.inv ≫ U₀.ι ≫ f)
    let φ_KB : CommRingCat.of K ⟶ B_cat :=
      AlgebraicGeometry.Spec.preimage (hV.isoSpec.inv ≫ V₀.ι ≫ f_K)
    have hφ_RD : hU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_RD = U₀.ι ≫ f := by
      dsimp [φ_RD]
      rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Iso.hom_inv_id_assoc]
    have hφ_KB : hV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_KB = V₀.ι ≫ f_K := by
      dsimp [φ_KB]
      rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Iso.hom_inv_id_assoc]
    have hp_Spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (q.app U₀))
        (AlgebraicGeometry.Spec.map φ_KB)
        (AlgebraicGeometry.Spec.map φ_RD) ξ :=
      hp_res.of_iso hV.isoSpec hU.isoSpec (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        h_comm.symm
        ((CategoryTheory.Category.comp_id _).trans hφ_KB.symm)
        ((CategoryTheory.Category.comp_id _).trans hφ_RD.symm)
        ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
    let algRD : Algebra R (↑D_cat) := (CommRingCat.Hom.hom φ_RD).toAlgebra
    let T_cat : CommRingCat.{u} := CommRingCat.of (TensorProduct R (↑D_cat) K)
    let inl_hom : D_cat ⟶ T_cat :=
      CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : (↑D_cat) →+* TensorProduct R (↑D_cat) K)
    let inr_hom : CommRingCat.of K ⟶ T_cat :=
      CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight.toRingHom : K →+* TensorProduct R (↑D_cat) K)
    have h_algRD_hom : CommRingCat.ofHom (algebraMap R (↑D_cat)) = φ_RD := rfl
    have hp_ten : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_hom)
        (AlgebraicGeometry.Spec.map inr_hom)
        (AlgebraicGeometry.Spec.map φ_RD) ξ := by
      rw [← h_algRD_hom]
      exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct R (↑D_cat) K)
    let e_ten : AlgebraicGeometry.Spec T_cat ≅
        CategoryTheory.Limits.pullback (AlgebraicGeometry.Spec.map φ_RD) ξ :=
      hp_ten.isoPullback
    have h_ten_fst :
        e_ten.hom ≫ CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map φ_RD) ξ =
          AlgebraicGeometry.Spec.map inl_hom :=
      hp_ten.isoPullback_hom_fst
    let e_pb : AlgebraicGeometry.Spec B_cat ≅ AlgebraicGeometry.Spec T_cat :=
      hp_Spec.isoPullback ≪≫ e_ten.symm
    have h_inv_fst :
        e_ten.inv ≫ AlgebraicGeometry.Spec.map inl_hom =
          CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map φ_RD) ξ := by
      rw [← h_ten_fst, CategoryTheory.Iso.inv_hom_id_assoc]
    have he_pb_fst :
        e_pb.hom ≫ AlgebraicGeometry.Spec.map inl_hom =
          AlgebraicGeometry.Spec.map (q.app U₀) := by
      calc
        e_pb.hom ≫ AlgebraicGeometry.Spec.map inl_hom
          = hp_Spec.isoPullback.hom ≫
              (e_ten.inv ≫ AlgebraicGeometry.Spec.map inl_hom) :=
            CategoryTheory.Category.assoc _ _ _
        _ = hp_Spec.isoPullback.hom ≫
              CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map φ_RD) ξ := by
            rw [h_inv_fst]
        _ = AlgebraicGeometry.Spec.map (q.app U₀) := hp_Spec.isoPullback_hom_fst
    let φ_TB : T_cat ⟶ B_cat := AlgebraicGeometry.Spec.preimage e_pb.hom
    let φ_BT : B_cat ⟶ T_cat := AlgebraicGeometry.Spec.preimage e_pb.inv
    have h_TB_BT : φ_TB ≫ φ_BT = 𝟙 T_cat := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id]
      dsimp [φ_TB, φ_BT]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage,
        e_pb.inv_hom_id]
    have h_BT_TB : φ_BT ≫ φ_TB = 𝟙 B_cat := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id]
      dsimp [φ_TB, φ_BT]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage,
        e_pb.hom_inv_id]
    have h_inl_TB : inl_hom ≫ φ_TB = q.app U₀ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp]
      dsimp [φ_TB]
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact he_pb_fst
    let algDB : Algebra (↑D_cat) (↑B_cat) := (CommRingCat.Hom.hom (q.app U₀)).toAlgebra
    let re : TensorProduct R (↑D_cat) K ≃+* (↑B_cat) :=
      { toFun := CommRingCat.Hom.hom φ_TB
        invFun := CommRingCat.Hom.hom φ_BT
        left_inv := fun x =>
          congrArg (fun g : T_cat ⟶ T_cat => CommRingCat.Hom.hom g x) h_TB_BT
        right_inv := fun y =>
          congrArg (fun g : B_cat ⟶ B_cat => CommRingCat.Hom.hom g y) h_BT_TB
        map_mul' := map_mul (CommRingCat.Hom.hom φ_TB)
        map_add' := map_add (CommRingCat.Hom.hom φ_TB) }
    let ae : TensorProduct R (↑D_cat) K ≃ₐ[↑D_cat] (↑B_cat) :=
      AlgEquiv.ofRingEquiv (f := re) (fun d => by
        change CommRingCat.Hom.hom φ_TB (algebraMap (↑D_cat) (TensorProduct R (↑D_cat) K) d) =
          CommRingCat.Hom.hom (q.app U₀) d
        have h_am : algebraMap (↑D_cat) (TensorProduct R (↑D_cat) K) d =
            CommRingCat.Hom.hom inl_hom d := by
          rw [Algebra.TensorProduct.algebraMap_apply]
          rfl
        rw [h_am]
        exact congrArg (fun g : D_cat ⟶ B_cat => CommRingCat.Hom.hom g d) h_inl_TB)
    have hLocTen : IsLocalization
        (Algebra.algebraMapSubmonoid (↑D_cat) (nonZeroDivisors R))
        (TensorProduct R (↑D_cat) K) :=
      IsLocalization.tensor (S := ↑D_cat) K (nonZeroDivisors R)
    exact ⟨Algebra.algebraMapSubmonoid (↑D_cat) (nonZeroDivisors R),
      @IsLocalization.isLocalization_of_algEquiv (↑D_cat) _
        (Algebra.algebraMapSubmonoid (↑D_cat) (nonZeroDivisors R))
        (TensorProduct R (↑D_cat) K) _ _ (↑B_cat) _ algDB hLocTen ae⟩
  have hNilIdeal :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.affineOpens),
        Z.nilradical.ideal W =
          (⊥ : Ideal ↑(Z.presheaf.obj (Opposite.op W.1))).radical := by
    intro Z W
    rw [← AlgebraicGeometry.Scheme.IdealSheafData.radical_bot,
      AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal,
      AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot]
    rfl
  refine ⟨?_, ?_⟩
  · intro Y Y_K f p h_K hp
    have : AlgebraicGeometry.IsAffineHom p := hAffPullback f p h_K hp
    let V_aff : Y.affineOpens → Y_K.affineOpens :=
      fun U => ⟨(TopologicalSpace.Opens.map p.base).obj U.1,
        AlgebraicGeometry.IsAffineHom.isAffine_preimage U.1 U.2⟩
    have h_cov : (⨆ (U : Y.affineOpens), (V_aff U : Y_K.Opens)) = ⊤ := hCover p
    let 𝒩_Y : Y.IdealSheafData := Y.nilradical
    let 𝒩_K : Y_K.IdealSheafData := Y_K.nilradical
    let ℒ : Y_K.IdealSheafData := 𝒩_Y.comap p
    have h_le₁ : ℒ ≤ 𝒩_K := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.le_map_iff_comap_le,
        AlgebraicGeometry.Scheme.IdealSheafData.le_def]
      intro U d hd
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_map_of_isAffineHom]
      change CommRingCat.Hom.hom (p.app U.1) d ∈ 𝒩_K.ideal (V_aff U)
      rw [hNilIdeal Y U, Ideal.mem_radical_iff] at hd
      rcases hd with ⟨n, hn⟩
      rw [Ideal.mem_bot] at hn
      rw [hNilIdeal Y_K (V_aff U), Ideal.mem_radical_iff]
      refine ⟨n, ?_⟩
      rw [Ideal.mem_bot, ← map_pow, hn, map_zero]
    have h_unit_ℒ : 𝒩_Y ≤ ℒ.map p :=
      AlgebraicGeometry.Scheme.IdealSheafData.le_map_iff_comap_le.mpr le_rfl
    have h_nil_eq : ℒ = 𝒩_K := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.ext_of_iSup_eq_top V_aff h_cov
      intro U
      obtain ⟨-, M_U, hLocU⟩ := hLocalLoc f p h_K hp U
      let ψ_U := CommRingCat.Hom.hom (p.app U.1)
      let algU : Algebra ↑(Y.presheaf.obj (Opposite.op U.1))
          ↑(Y_K.presheaf.obj (Opposite.op (V_aff U).1)) := ψ_U.toAlgebra
      have : IsLocalization M_U ↑(Y_K.presheaf.obj (Opposite.op (V_aff U).1)) := hLocU
      rw [← IsLocalization.map_under M_U _ (ℒ.ideal (V_aff U)),
        ← IsLocalization.map_under M_U _ (𝒩_K.ideal (V_aff U))]
      congr 1
      apply le_antisymm
      · exact Ideal.comap_mono
          (AlgebraicGeometry.Scheme.IdealSheafData.le_def.mp h_le₁ (V_aff U))
      · intro d hd
        change ψ_U d ∈ 𝒩_K.ideal (V_aff U) at hd
        rw [hNilIdeal Y_K (V_aff U), Ideal.mem_radical_iff] at hd
        rcases hd with ⟨n, hn⟩
        rw [Ideal.mem_bot] at hn
        have h_map0 :
            (algebraMap ↑(Y.presheaf.obj (Opposite.op U.1))
              ↑(Y_K.presheaf.obj (Opposite.op (V_aff U).1))) (d ^ n) = 0 := by
          change ψ_U (d ^ n) = 0
          rwa [map_pow]
        obtain ⟨m, hm⟩ :=
          (IsLocalization.map_eq_zero_iff M_U
            ↑(Y_K.presheaf.obj (Opposite.op (V_aff U).1)) (d ^ n)).mp h_map0
        have h_md_nil : (↑m * d) ∈ 𝒩_Y.ideal U := by
          rw [hNilIdeal Y U, Ideal.mem_radical_iff]
          refine ⟨n + 1, ?_⟩
          rw [Ideal.mem_bot]
          calc
            (↑m * d) ^ (n + 1) = (↑m) ^ n * d * (↑m * d ^ n) := by ring
            _ = (↑m) ^ n * d * 0 := by rw [hm]
            _ = 0 := mul_zero _
        have h_md_in : (↑m * d) ∈ (ℒ.map p).ideal U :=
          AlgebraicGeometry.Scheme.IdealSheafData.le_def.mp h_unit_ℒ U h_md_nil
        rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_map_of_isAffineHom] at h_md_in
        change ψ_U (↑m * d) ∈ ℒ.ideal (V_aff U) at h_md_in
        rw [map_mul] at h_md_in
        have hu : IsUnit (ψ_U ↑m) :=
          IsLocalization.map_units ↑(Y_K.presheaf.obj (Opposite.op (V_aff U).1)) m
        have h_mul_inv := (ℒ.ideal (V_aff U)).mul_mem_left (↑hu.unit⁻¹) h_md_in
        have h_cancel : (↑hu.unit⁻¹) * (ψ_U ↑m * ψ_U d) = ψ_U d := by
          rw [← mul_assoc, hu.val_inv_mul, one_mul]
        rw [h_cancel] at h_mul_inv
        exact h_mul_inv
    let s₀ : CategoryTheory.Limits.pullback 𝒩_Y.subschemeι p ≅
        CategoryTheory.Limits.pullback p 𝒩_Y.subschemeι :=
      CategoryTheory.Limits.pullbackSymmetry 𝒩_Y.subschemeι p
    let e₀ : ℒ.subscheme ≅ CategoryTheory.Limits.pullback p 𝒩_Y.subschemeι :=
      𝒩_Y.comapIso p
    have he₀_inv_fst :
        e₀.inv ≫ ℒ.subschemeι = CategoryTheory.Limits.pullback.fst p 𝒩_Y.subschemeι := by
      dsimp [e₀, ℒ]
      rw [← 𝒩_Y.comapIso_hom_fst p, CategoryTheory.Iso.inv_hom_id_assoc]
    have h_ker_eq : 𝒩_K.subschemeι.ker = ℒ.subschemeι.ker := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι, h_nil_eq]
    let φ₁ : ℒ.subscheme ⟶ 𝒩_K.subscheme :=
      AlgebraicGeometry.IsClosedImmersion.lift 𝒩_K.subschemeι ℒ.subschemeι h_ker_eq.le
    have : CategoryTheory.IsIso φ₁ :=
      AlgebraicGeometry.IsClosedImmersion.isIso_lift 𝒩_K.subschemeι ℒ.subschemeι h_ker_eq
    let e_red : CategoryTheory.Limits.pullback 𝒩_Y.subschemeι p ≅ 𝒩_K.subscheme :=
      s₀ ≪≫ e₀.symm ≪≫ CategoryTheory.asIso φ₁
    refine ⟨e_red, ?_⟩
    dsimp [e_red]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsClosedImmersion.lift_fac, he₀_inv_fst,
      CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst]
  · intro P P_K f_P q_P f_PK hpP
    have : AlgebraicGeometry.IsAffineHom q_P := hAffPullback f_P q_P f_PK hpP
    refine ⟨?_, ?_, ?_⟩
    · intro x₁ x₂ hxy
      obtain ⟨U₀, hU₀, hx₁U, -⟩ :=
        @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset P (q_P.base x₁) ⊤ trivial
      let U : P.affineOpens := ⟨U₀, hU₀⟩
      let V₀ : P_K.Opens := (TopologicalSpace.Opens.map q_P.base).obj U₀
      let hV₀ : AlgebraicGeometry.IsAffineOpen V₀ :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage U₀ hU₀
      have hx₁V : x₁ ∈ Set.range V₀.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hx₁U
      have hx₂V : x₂ ∈ Set.range V₀.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        change q_P.base x₂ ∈ U₀
        rwa [← hxy]
      rcases hx₁V with ⟨z₁, hz₁⟩
      rcases hx₂V with ⟨z₂, hz₂⟩
      have h_res_w := (AlgebraicGeometry.isPullback_morphismRestrict q_P U₀).w
      have h_u_eq : U₀.ι.base ((q_P ∣_ U₀).base z₁) = U₀.ι.base ((q_P ∣_ U₀).base z₂) := by
        have h₁ := congrArg (fun g : V₀.toScheme ⟶ P => g.base z₁) h_res_w
        have h₂ := congrArg (fun g : V₀.toScheme ⟶ P => g.base z₂) h_res_w
        dsimp at h₁ h₂
        rw [h₁, hz₁, hxy, ← hz₂, ← h₂]
      have h_res_eq : (q_P ∣_ U₀).base z₁ = (q_P ∣_ U₀).base z₂ :=
        (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding U₀.ι).injective h_u_eq
      obtain ⟨h_spec_comm, M_U, hLocU⟩ := hLocalLoc f_P q_P f_PK hpP U
      have h_spec_eq :
          (AlgebraicGeometry.Spec.map (q_P.app U₀)) (hV₀.isoSpec.hom z₁) =
            (AlgebraicGeometry.Spec.map (q_P.app U₀)) (hV₀.isoSpec.hom z₂) := by
        have h₁ := congrArg
          (fun g : V₀.toScheme ⟶ AlgebraicGeometry.Spec (P.presheaf.obj (Opposite.op U₀)) => g z₁)
          h_spec_comm
        have h₂ := congrArg
          (fun g : V₀.toScheme ⟶ AlgebraicGeometry.Spec (P.presheaf.obj (Opposite.op U₀)) => g z₂)
          h_spec_comm
        dsimp at h₁ h₂
        change (AlgebraicGeometry.Spec.map (q_P.app U₀)) (hV₀.isoSpec.hom z₁) =
            hU₀.isoSpec.hom ((q_P ∣_ U₀) z₁) at h₁
        change (AlgebraicGeometry.Spec.map (q_P.app U₀)) (hV₀.isoSpec.hom z₂) =
            hU₀.isoSpec.hom ((q_P ∣_ U₀) z₂) at h₂
        have h_res_eq' : (q_P ∣_ U₀) z₁ = (q_P ∣_ U₀) z₂ := h_res_eq
        rw [h₁, h₂, h_res_eq']
      let ψ_U := CommRingCat.Hom.hom (q_P.app U₀)
      let algU : Algebra ↑(P.presheaf.obj (Opposite.op U₀))
          ↑(P_K.presheaf.obj (Opposite.op V₀)) := ψ_U.toAlgebra
      have : IsLocalization M_U ↑(P_K.presheaf.obj (Opposite.op V₀)) := hLocU
      have h_comap_eq :
          PrimeSpectrum.comap (CommRingCat.Hom.hom (q_P.app U₀)) (hV₀.isoSpec.hom z₁) =
            PrimeSpectrum.comap (CommRingCat.Hom.hom (q_P.app U₀)) (hV₀.isoSpec.hom z₂) := by
        rw [← AlgebraicGeometry.Spec.map_apply (q_P.app U₀) (hV₀.isoSpec.hom z₁),
          ← AlgebraicGeometry.Spec.map_apply (q_P.app U₀) (hV₀.isoSpec.hom z₂)]
        exact h_spec_eq
      have h_inj_comap :
          Function.Injective (PrimeSpectrum.comap (CommRingCat.Hom.hom (q_P.app U₀))) :=
        PrimeSpectrum.localization_comap_injective
          ↑(P_K.presheaf.obj (Opposite.op V₀)) M_U
      have h_iso_eq : hV₀.isoSpec.hom z₁ = hV₀.isoSpec.hom z₂ :=
        h_inj_comap h_comap_eq
      have hz_eq : z₁ = z₂ := by
        have hi₁ := congrArg
          (fun g : V₀.toScheme ⟶ V₀.toScheme => g z₁) hV₀.isoSpec.hom_inv_id
        have hi₂ := congrArg
          (fun g : V₀.toScheme ⟶ V₀.toScheme => g z₂) hV₀.isoSpec.hom_inv_id
        change hV₀.isoSpec.inv (hV₀.isoSpec.hom z₁) = z₁ at hi₁
        change hV₀.isoSpec.inv (hV₀.isoSpec.hom z₂) = z₂ at hi₂
        rw [← hi₁, ← hi₂, h_iso_eq]
      rw [← hz₁, ← hz₂, hz_eq]
    · let e_P : P_K ≅ CategoryTheory.Limits.pullback f_P ξ := hpP.isoPullback
      have he_P : e_P.hom ≫ CategoryTheory.Limits.pullback.fst f_P ξ = q_P :=
        hpP.isoPullback_hom_fst
      have h_range_eq :
          Set.range q_P.base = Set.range (CategoryTheory.Limits.pullback.fst f_P ξ).base := by
        rw [← he_P]
        ext y
        constructor
        · rintro ⟨x, rfl⟩
          exact ⟨e_P.hom.base x, rfl⟩
        · rintro ⟨w, rfl⟩
          refine ⟨e_P.inv.base w, ?_⟩
          have hw := congrArg
            (fun g : CategoryTheory.Limits.pullback f_P ξ ⟶
              CategoryTheory.Limits.pullback f_P ξ => g.base w) e_P.inv_hom_id
          dsimp at hw ⊢
          rw [hw]
      rw [h_range_eq]
      exact AlgebraicGeometry.Scheme.Pullback.range_fst f_P ξ
    · intro W_K ι_K _
      let V_aff : P.affineOpens → P_K.affineOpens :=
        fun U => ⟨(TopologicalSpace.Opens.map q_P.base).obj U.1,
          AlgebraicGeometry.IsAffineHom.isAffine_preimage U.1 U.2⟩
      have h_cov : (⨆ (U : P.affineOpens), (V_aff U : P_K.Opens)) = ⊤ := hCover q_P
      let ℐ_K : P_K.IdealSheafData := ι_K.ker
      let 𝒥 : P.IdealSheafData := (ι_K ≫ q_P).ker
      let ℒ : P_K.IdealSheafData := 𝒥.comap q_P
      have h𝒥_eq : 𝒥 = ℐ_K.map q_P :=
        (AlgebraicGeometry.Scheme.IdealSheafData.map_ker ι_K q_P).symm
      have h_map_eq : ℒ.map q_P = ℐ_K.map q_P := by
        apply le_antisymm
        · apply (AlgebraicGeometry.Scheme.IdealSheafData.map_gc q_P).monotone_u
          dsimp [ℒ]
          rw [h𝒥_eq]
          exact AlgebraicGeometry.Scheme.IdealSheafData.comap_map_le ℐ_K q_P
        · rw [← h𝒥_eq]
          exact AlgebraicGeometry.Scheme.IdealSheafData.le_map_iff_comap_le.mpr le_rfl
      have h_id_eq : ℒ = ℐ_K := by
        apply AlgebraicGeometry.Scheme.IdealSheafData.ext_of_iSup_eq_top V_aff h_cov
        intro U
        obtain ⟨-, M_U, hLocU⟩ := hLocalLoc f_P q_P f_PK hpP U
        let ψ_U := CommRingCat.Hom.hom (q_P.app U.1)
        let algU : Algebra ↑(P.presheaf.obj (Opposite.op U.1))
            ↑(P_K.presheaf.obj (Opposite.op (V_aff U).1)) := ψ_U.toAlgebra
        have : IsLocalization M_U ↑(P_K.presheaf.obj (Opposite.op (V_aff U).1)) := hLocU
        have h_comap_U :
            Ideal.under ↑(P.presheaf.obj (Opposite.op U.1)) (ℒ.ideal (V_aff U)) =
              Ideal.under ↑(P.presheaf.obj (Opposite.op U.1)) (ℐ_K.ideal (V_aff U)) := by
          have hm := congrArg (fun D : P.IdealSheafData => D.ideal U) h_map_eq
          rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_map_of_isAffineHom,
            AlgebraicGeometry.Scheme.IdealSheafData.ideal_map_of_isAffineHom] at hm
          exact hm
        rw [← IsLocalization.map_under M_U _ (ℒ.ideal (V_aff U)),
          ← IsLocalization.map_under M_U _ (ℐ_K.ideal (V_aff U)), h_comap_U]
      have h_sub_le : 𝒥 ≤ ℒ.map q_P :=
        AlgebraicGeometry.Scheme.IdealSheafData.le_map_iff_comap_le.mpr le_rfl
      let e_comap : ℒ.subscheme ≅ CategoryTheory.Limits.pullback q_P 𝒥.subschemeι :=
        𝒥.comapIso q_P
      have he_comap_fst :
          e_comap.inv ≫ ℒ.subschemeι =
            CategoryTheory.Limits.pullback.fst q_P 𝒥.subschemeι := by
        dsimp [e_comap, ℒ]
        rw [← 𝒥.comapIso_hom_fst q_P, CategoryTheory.Iso.inv_hom_id_assoc]
      have he_comap_snd :
          e_comap.inv ≫ ℒ.subschemeMap 𝒥 q_P h_sub_le =
            CategoryTheory.Limits.pullback.snd q_P 𝒥.subschemeι := by
        dsimp [e_comap, ℒ]
        rw [← 𝒥.comapIso_hom_snd q_P, CategoryTheory.Iso.inv_hom_id_assoc]
      have hp_ℒ : CategoryTheory.IsPullback
          (ℒ.subschemeMap 𝒥 q_P h_sub_le) ℒ.subschemeι 𝒥.subschemeι q_P :=
        ((CategoryTheory.IsPullback.of_hasPullback q_P 𝒥.subschemeι).of_iso
          e_comap.symm (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _)
          ((CategoryTheory.Category.comp_id _).trans he_comap_fst.symm)
          ((CategoryTheory.Category.comp_id _).trans he_comap_snd.symm)
          ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
          ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)).flip
      have h_ker_WL : ℒ.subschemeι.ker = ι_K.ker := by
        rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι, h_id_eq]
      let ψ_WL : W_K ⟶ ℒ.subscheme :=
        AlgebraicGeometry.IsClosedImmersion.lift ℒ.subschemeι ι_K h_ker_WL.le
      have : CategoryTheory.IsIso ψ_WL :=
        AlgebraicGeometry.IsClosedImmersion.isIso_lift ℒ.subschemeι ι_K h_ker_WL
      let e_WL : W_K ≅ ℒ.subscheme := CategoryTheory.asIso ψ_WL
      have he_WL_hom : e_WL.hom ≫ ℒ.subschemeι = ι_K :=
        AlgebraicGeometry.IsClosedImmersion.lift_fac ℒ.subschemeι ι_K h_ker_WL.le
      have he_WL_inv : e_WL.inv ≫ ι_K = ℒ.subschemeι := by
        rw [← he_WL_hom, CategoryTheory.Iso.inv_hom_id_assoc]
      let q_W : W_K ⟶ AlgebraicGeometry.Scheme.Hom.image (ι_K ≫ q_P) :=
        e_WL.hom ≫ ℒ.subschemeMap 𝒥 q_P h_sub_le
      refine ⟨q_W, ?_⟩
      exact hp_ℒ.of_iso e_WL.symm (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _)
        ((CategoryTheory.Category.comp_id _).trans
          (CategoryTheory.Iso.inv_hom_id_assoc e_WL _).symm)
        ((CategoryTheory.Category.comp_id _).trans he_WL_inv.symm)
        ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
        ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)

theorem weil_spread_out_isIso_and_isFinite_of_fractionRing (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K] :
    let ξ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K))
    (∀ (X W X_K W_K : AlgebraicGeometry.Scheme.{u})
        (fX : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (fW : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        [AlgebraicGeometry.LocallyOfFiniteType fX]
        [AlgebraicGeometry.LocallyOfFiniteType fW]
        [AlgebraicGeometry.QuasiCompact fX]
        [AlgebraicGeometry.QuasiCompact fW]
        (ψ : X ⟶ W) (_ : ψ ≫ fW = fX)
        (q_X : X_K ⟶ X) (f_XK : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (q_W : W_K ⟶ W) (f_WK : W_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (ψ_K : X_K ⟶ W_K),
      CategoryTheory.IsPullback q_X f_XK fX ξ →
      CategoryTheory.IsPullback q_W f_WK fW ξ →
      ψ_K ≫ q_W = q_X ≫ ψ →
      ψ_K ≫ f_WK = f_XK →
      CategoryTheory.IsIso ψ_K →
      ∃ (h : R) (_ : h ≠ 0),
        ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
          IsUnit (φ_RS h) →
          ∀ (X_S W_S : AlgebraicGeometry.Scheme.{u})
            (q_XS : X_S ⟶ X) (f_XS : X_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
            (q_WS : W_S ⟶ W) (f_WS : W_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
            (ψ_S : X_S ⟶ W_S),
            CategoryTheory.IsPullback q_XS f_XS fX
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
            CategoryTheory.IsPullback q_WS f_WS fW
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
            ψ_S ≫ q_WS = q_XS ≫ ψ →
            ψ_S ≫ f_WS = f_XS →
            CategoryTheory.IsIso ψ_S) ∧
    (∀ (C_R Y_R C_K Y_K : AlgebraicGeometry.Scheme.{u})
        (fC : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (fY : Y_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        [AlgebraicGeometry.LocallyOfFiniteType fC]
        [AlgebraicGeometry.LocallyOfFiniteType fY]
        [AlgebraicGeometry.QuasiCompact fC]
        [AlgebraicGeometry.QuasiCompact fY]
        (μ_R : C_R ⟶ Y_R) (_ : μ_R ≫ fY = fC)
        (U_R : Y_R.Opens)
        (q_C : C_K ⟶ C_R) (f_CK : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (q_Y : Y_K ⟶ Y_R) (f_YK : Y_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (μ_K : C_K ⟶ Y_K) (U_K : Y_K.Opens),
      CategoryTheory.IsPullback q_C f_CK fC ξ →
      CategoryTheory.IsPullback q_Y f_YK fY ξ →
      μ_K ≫ q_Y = q_C ≫ μ_R →
      μ_K ≫ f_YK = f_CK →
      (TopologicalSpace.Opens.map q_Y.base).obj U_R = U_K →
      CategoryTheory.IsIso (μ_K ∣_ U_K) →
      ∃ (h : R) (_ : h ≠ 0),
        ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
          IsUnit (φ_RS h) →
          ∀ (C_S Y_S : AlgebraicGeometry.Scheme.{u})
            (q_CS : C_S ⟶ C_R) (f_CS : C_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
            (q_YS : Y_S ⟶ Y_R) (f_YS : Y_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
            (μ_S : C_S ⟶ Y_S) (U_S : Y_S.Opens),
            CategoryTheory.IsPullback q_CS f_CS fC
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
            CategoryTheory.IsPullback q_YS f_YS fY
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
            μ_S ≫ q_YS = q_CS ≫ μ_R →
            μ_S ≫ f_YS = f_CS →
            (TopologicalSpace.Opens.map q_YS.base).obj U_R = U_S →
            CategoryTheory.IsIso (μ_S ∣_ U_S)) ∧
    (∀ (C_R Y_R C_K Y_K : AlgebraicGeometry.Scheme.{u})
        (fC : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (fY : Y_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        [AlgebraicGeometry.IsProper fC]
        [AlgebraicGeometry.IsProper fY]
        (μ_R : C_R ⟶ Y_R) (_ : μ_R ≫ fY = fC)
        (q_C : C_K ⟶ C_R) (f_CK : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (q_Y : Y_K ⟶ Y_R) (f_YK : Y_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (μ_K : C_K ⟶ Y_K),
      CategoryTheory.IsPullback q_C f_CK fC ξ →
      CategoryTheory.IsPullback q_Y f_YK fY ξ →
      μ_K ≫ q_Y = q_C ≫ μ_R →
      μ_K ≫ f_YK = f_CK →
      AlgebraicGeometry.IsFinite μ_K →
      ∃ (h : R) (_ : h ≠ 0),
        ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
          IsUnit (φ_RS h) →
          ∀ (C_S Y_S : AlgebraicGeometry.Scheme.{u})
            (q_CS : C_S ⟶ C_R) (f_CS : C_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
            (q_YS : Y_S ⟶ Y_R) (f_YS : Y_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S))
            (μ_S : C_S ⟶ Y_S),
            CategoryTheory.IsPullback q_CS f_CS fC
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
            CategoryTheory.IsPullback q_YS f_YS fY
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
            μ_S ≫ q_YS = q_CS ≫ μ_R →
            μ_S ≫ f_YS = f_CS →
            AlgebraicGeometry.IsFinite μ_S) :=
by
  classical
  have isAffineHom_specMap :
      ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
        AlgebraicGeometry.IsAffineHom (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) :=
    fun _ => inferInstance
  intro ξ
  have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of R)) :=
    AlgebraicGeometry.isLocallyNoetherian_Spec.mpr ‹IsNoetherianRing R›
  
  have toSpecΓ_comp_specMap_inv_appTop :
      ∀ {X : AlgebraicGeometry.Scheme.{u}} {R₀ : CommRingCat.{u}}
        (g : X ⟶ AlgebraicGeometry.Spec R₀),
        X.toSpecΓ ≫ AlgebraicGeometry.Spec.map ((AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv ≫ g.appTop) = g := by
    intro X R₀ g
    rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Scheme.toSpecΓ_naturality g, CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.SpecMap_ΓSpecIso_hom R₀, ← AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
  
  have app_open_base_ring_comm :
      ∀ {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] (φ_RS : R₀ →+* S₀)
        {Z Z_S : AlgebraicGeometry.Scheme.{u}}
        (fZ : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀))
        (q_ZS : Z_S ⟶ Z)
        (f_ZS : Z_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S₀)),
        q_ZS ≫ fZ = f_ZS ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS) →
        ∀ (D : Z.Opens) (x : R₀),
          let D_S : Z_S.Opens := (TopologicalSpace.Opens.map q_ZS.base).obj D
          let r_D : R₀ →+* ↑(Z.presheaf.obj (Opposite.op D)) :=
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫ fZ.appTop ≫
              Z.presheaf.map (CategoryTheory.homOfLE (le_top : D ≤ ⊤)).op).hom
          let r_DS : S₀ →+* ↑(Z_S.presheaf.obj (Opposite.op D_S)) :=
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S₀)).inv ≫ f_ZS.appTop ≫
              Z_S.presheaf.map (CategoryTheory.homOfLE (le_top : D_S ≤ ⊤)).op).hom
          (q_ZS.app D).hom (r_D x) = r_DS (φ_RS x) := by
    intro R₀ S₀ _ _ φ_RS Z Z_S fZ q_ZS f_ZS hw D x D_S r_D r_DS
    suffices h_eq :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫ fZ.appTop ≫
          Z.presheaf.map (CategoryTheory.homOfLE (le_top : D ≤ ⊤)).op) ≫ q_ZS.app D =
        CommRingCat.ofHom φ_RS ≫
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S₀)).inv ≫ f_ZS.appTop ≫
            Z_S.presheaf.map (CategoryTheory.homOfLE (le_top : D_S ≤ ⊤)).op) by
      exact CategoryTheory.ConcreteCategory.congr_hom h_eq x
    have h_nat : Z.presheaf.map (CategoryTheory.homOfLE (le_top : D ≤ ⊤)).op ≫ q_ZS.app D =
        q_ZS.appTop ≫ Z_S.presheaf.map (CategoryTheory.homOfLE (le_top : D_S ≤ ⊤)).op :=
      q_ZS.naturality (CategoryTheory.homOfLE (le_top : D ≤ ⊤)).op
    have h_comp_app : fZ.appTop ≫ q_ZS.appTop =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)).appTop ≫ f_ZS.appTop := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hw, AlgebraicGeometry.Scheme.Hom.comp_appTop]
    have h_spec_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)).appTop =
        CommRingCat.ofHom φ_RS ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S₀)).inv := by
      rw [CategoryTheory.Iso.inv_comp_eq, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
        CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id]
    simp only [CategoryTheory.Category.assoc]
    rw [h_nat, ← CategoryTheory.Category.assoc fZ.appTop, h_comp_app, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso _).inv,
      h_spec_nat, CategoryTheory.Category.assoc]
  
  have affineOpen_generic_localization :
      ∀ {Z Z_K : AlgebraicGeometry.Scheme.{u}}
        (fZ : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (q_Z : Z_K ⟶ Z)
        (f_ZK : Z_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
        CategoryTheory.IsPullback q_Z f_ZK fZ ξ →
        ∀ (D : Z.Opens), AlgebraicGeometry.IsAffineOpen D →
          let D_K : Z_K.Opens := (TopologicalSpace.Opens.map q_Z.base).obj D
          let r_D : R →+* ↑(Z.presheaf.obj (Opposite.op D)) :=
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ fZ.appTop ≫
              Z.presheaf.map (CategoryTheory.homOfLE (le_top : D ≤ ⊤)).op).hom
          let r_DK : K →+* ↑(Z_K.presheaf.obj (Opposite.op D_K)) :=
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ f_ZK.appTop ≫
              Z_K.presheaf.map (CategoryTheory.homOfLE (le_top : D_K ≤ ⊤)).op).hom
          let φ_D : ↑(Z.presheaf.obj (Opposite.op D)) →+* ↑(Z_K.presheaf.obj (Opposite.op D_K)) :=
            (q_Z.app D).hom
          (∀ y : ↑(Z_K.presheaf.obj (Opposite.op D_K)),
            ∃ (s : R) (_ : s ≠ 0) (a : ↑(Z.presheaf.obj (Opposite.op D))),
              φ_D a = r_DK (algebraMap R K s) * y) ∧
          (∀ a : ↑(Z.presheaf.obj (Opposite.op D)),
            φ_D a = 0 → ∃ (t : R) (_ : t ≠ 0), r_D t * a = 0) := by
    intro Z Z_K fZ q_Z f_ZK hpZ D hD D_K r_D r_DK φ_D
    let A_cat : CommRingCat.{u} := Z.presheaf.obj (Opposite.op D)
    let A : Type u := ↑A_cat
    let AK_cat : CommRingCat.{u} := Z_K.presheaf.obj (Opposite.op D_K)
    let _ : Algebra R A := r_D.toAlgebra
    have h_rD : CommRingCat.ofHom (algebraMap R A) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ fZ.appTop ≫
          Z.presheaf.map (CategoryTheory.homOfLE (le_top : D ≤ ⊤)).op := rfl
    have hD_fZ : D.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A)) =
        D.ι ≫ fZ := by
      rw [h_rD, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc,
        ← AlgebraicGeometry.Spec.map_comp, toSpecΓ_comp_specMap_inv_appTop fZ]
    have _ : AlgebraicGeometry.IsAffineHom ξ := isAffineHom_specMap (algebraMap R K)
    have _ : AlgebraicGeometry.IsAffineHom q_Z :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpZ.flip inferInstance
    have hDK : AlgebraicGeometry.IsAffineOpen D_K := hD.preimage q_Z
    have hDK_fZK : D_K.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom r_DK) =
        D_K.ι ≫ f_ZK := by
      change D_K.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          f_ZK.appTop ≫ Z_K.presheaf.map (CategoryTheory.homOfLE (le_top : D_K ≤ ⊤)).op) =
        D_K.ι ≫ f_ZK
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc,
        ← AlgebraicGeometry.Spec.map_comp, toSpecΓ_comp_specMap_inv_appTop f_ZK]
    have hqD_comm : (q_Z ∣_ D) ≫ D.toSpecΓ = D_K.toSpecΓ ≫ AlgebraicGeometry.Spec.map (q_Z.app D) := by
      have h := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc q_Z D D_K le_rfl (𝟙 _)
      simp only [CategoryTheory.Category.comp_id] at h
      have happ : q_Z.appLE D D_K le_rfl = q_Z.app D := by
        simp only [AlgebraicGeometry.Scheme.Hom.appLE, CategoryTheory.homOfLE_refl,
          CategoryTheory.op_id]
        rw [Z_K.presheaf.map_id, CategoryTheory.Category.comp_id]
      have hres : AlgebraicGeometry.Scheme.Hom.resLE q_Z D D_K le_rfl = (q_Z ∣_ D) :=
        (CategoryTheory.cancel_mono D.ι).mp
          (by rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, AlgebraicGeometry.morphismRestrict_ι])
      rw [happ, hres] at h
      exact h.symm
    have hpD : CategoryTheory.IsPullback (q_Z ∣_ D) (D_K.ι ≫ f_ZK) (D.ι ≫ fZ) ξ :=
      (AlgebraicGeometry.isPullback_morphismRestrict q_Z D).paste_vert hpZ
    have hpD_spec : CategoryTheory.IsPullback ((q_Z ∣_ D) ≫ hD.isoSpec.hom) (D_K.ι ≫ f_ZK)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A))) ξ := by
      have h_iso_pb : CategoryTheory.IsPullback hD.isoSpec.hom (D.ι ≫ fZ)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A))) (𝟙 _) := by
        refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
        rw [CategoryTheory.Category.comp_id, AlgebraicGeometry.IsAffineOpen.isoSpec_hom, hD_fZ]
      have hp := hpD.paste_horiz h_iso_pb
      simpa only [CategoryTheory.Category.comp_id] using hp
    let pb_iso : ↑D_K ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R A K)) :=
      hpD_spec.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso R A K
    have h_pb_fst : pb_iso.inv ≫ (q_Z ∣_ D) ≫ hD.isoSpec.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
      dsimp [pb_iso]
      rw [CategoryTheory.Category.assoc, hpD_spec.isoPullback_inv_fst,
        CategoryTheory.Iso.inv_comp_eq, AlgebraicGeometry.pullbackSpecIso_hom_fst R A K]
    have h_pb_snd : pb_iso.inv ≫ D_K.ι ≫ f_ZK =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) := by
      dsimp [pb_iso]
      rw [CategoryTheory.Category.assoc, hpD_spec.isoPullback_inv_snd,
        CategoryTheory.Iso.inv_comp_eq, AlgebraicGeometry.pullbackSpecIso_hom_snd R A K]
    let α : AK_cat ⟶ CommRingCat.of (TensorProduct R A K) :=
      AlgebraicGeometry.Spec.preimage (pb_iso.inv ≫ hDK.isoSpec.hom)
    let β : CommRingCat.of (TensorProduct R A K) ⟶ AK_cat :=
      AlgebraicGeometry.Spec.preimage (hDK.isoSpec.inv ≫ pb_iso.hom)
    have hαβ : α ≫ β = 𝟙 AK_cat := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id,
        AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc,
        CategoryTheory.Iso.inv_hom_id]
    have hα_left : q_Z.app D ≫ α =
        CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        CategoryTheory.Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
        ← hqD_comm, ← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hD, h_pb_fst]
    have hα_right : CommRingCat.ofHom r_DK ≫ α =
        CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        CategoryTheory.Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
        hDK_fZK, h_pb_snd]
    have hβ_left : ∀ a : A, β.hom (algebraMap A (TensorProduct R A K) a) = φ_D a := by
      intro a
      have h1 : α.hom (φ_D a) = Algebra.TensorProduct.includeLeftRingHom a :=
        CategoryTheory.ConcreteCategory.congr_hom hα_left a
      have h2 := CategoryTheory.ConcreteCategory.congr_hom hαβ (φ_D a)
      change β.hom (α.hom (φ_D a)) = φ_D a at h2
      rwa [h1] at h2
    have hβ_right : ∀ c : K, β.hom (Algebra.TensorProduct.includeRight c) = r_DK c := by
      intro c
      have h1 : α.hom (r_DK c) = Algebra.TensorProduct.includeRight c :=
        CategoryTheory.ConcreteCategory.congr_hom hα_right c
      have h2 := CategoryTheory.ConcreteCategory.congr_hom hαβ (r_DK c)
      change β.hom (α.hom (r_DK c)) = r_DK c at h2
      rwa [h1] at h2
    let M : Submonoid R := nonZeroDivisors R
    let M_A : Submonoid A := Algebra.algebraMapSubmonoid A M
    have _ : IsLocalization M_A (TensorProduct R A K) := IsLocalization.tensor K M
    constructor
    · intro y
      obtain ⟨p, hsurj⟩ := IsLocalization.surj M_A (α.hom y)
      rcases p with ⟨a, mA⟩
      dsimp only at hsurj
      rcases mA with ⟨_, s, hsM, rfl⟩
      have hs_ne : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hsM
      refine ⟨s, hs_ne, a, ?_⟩
      have hm_eq : (algebraMap A (TensorProduct R A K)) ((algebraMap R A) s) =
          Algebra.TensorProduct.includeRight (algebraMap R K s) := by
        change (algebraMap R A s) ⊗ₜ[R] (1 : K) = (1 : A) ⊗ₜ[R] (algebraMap R K s)
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one]
      have hsurj' : α.hom y * (algebraMap A (TensorProduct R A K)) ((algebraMap R A) s) =
          (algebraMap A (TensorProduct R A K)) a := hsurj
      have hβ_eq := congrArg β.hom hsurj'
      rw [map_mul, hm_eq, hβ_right, hβ_left] at hβ_eq
      have hy : β.hom (α.hom y) = y := CategoryTheory.ConcreteCategory.congr_hom hαβ y
      rw [hy, mul_comm] at hβ_eq
      exact hβ_eq.symm
    · intro a ha0
      have h0 : (algebraMap A (TensorProduct R A K)) a = 0 := by
        have h1 : α.hom (φ_D a) = (algebraMap A (TensorProduct R A K)) a :=
          CategoryTheory.ConcreteCategory.congr_hom hα_left a
        rw [← h1, ha0, map_zero]
      obtain ⟨⟨_, t, htM, rfl⟩, hta⟩ :=
        (IsLocalization.map_eq_zero_iff M_A (TensorProduct R A K) a).mp h0
      exact ⟨t, mem_nonZeroDivisors_iff_ne_zero.mp htM, hta⟩
  
  have affineOpen_bezout_spread_out :
      ∀ {Z Z_K : AlgebraicGeometry.Scheme.{u}}
        (fZ : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (q_Z : Z_K ⟶ Z)
        (f_ZK : Z_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
        CategoryTheory.IsPullback q_Z f_ZK fZ ξ →
        ∀ (D : Z.Opens), AlgebraicGeometry.IsAffineOpen D →
          ∀ (d : ℕ) (u : Fin d → ↑(Z.presheaf.obj (Opposite.op D))),
            (⨆ δ : Fin d, (TopologicalSpace.Opens.map q_Z.base).obj (Z.basicOpen (u δ))) =
              (TopologicalSpace.Opens.map q_Z.base).obj D →
            ∃ (w : R) (_ : w ≠ 0),
              ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
                IsUnit (φ_RS w) →
                ∀ (Z_S : AlgebraicGeometry.Scheme.{u})
                  (q_ZS : Z_S ⟶ Z) (f_ZS : Z_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S)),
                  CategoryTheory.IsPullback q_ZS f_ZS fZ
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
                  (⨆ δ : Fin d, (TopologicalSpace.Opens.map q_ZS.base).obj (Z.basicOpen (u δ))) =
                    (TopologicalSpace.Opens.map q_ZS.base).obj D := by
    intro Z Z_K fZ q_Z f_ZK hpZ D hD d u hCovK
    let D_K : Z_K.Opens := (TopologicalSpace.Opens.map q_Z.base).obj D
    let r_D : R →+* ↑(Z.presheaf.obj (Opposite.op D)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ fZ.appTop ≫
        Z.presheaf.map (CategoryTheory.homOfLE (le_top : D ≤ ⊤)).op).hom
    let r_DK : K →+* ↑(Z_K.presheaf.obj (Opposite.op D_K)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ f_ZK.appTop ≫
        Z_K.presheaf.map (CategoryTheory.homOfLE (le_top : D_K ≤ ⊤)).op).hom
    let φ_D : ↑(Z.presheaf.obj (Opposite.op D)) →+* ↑(Z_K.presheaf.obj (Opposite.op D_K)) :=
      (q_Z.app D).hom
    obtain ⟨hSurjK, hKerK⟩ := affineOpen_generic_localization fZ q_Z f_ZK hpZ D hD
    have _ : AlgebraicGeometry.IsAffineHom ξ := isAffineHom_specMap (algebraMap R K)
    have _ : AlgebraicGeometry.IsAffineHom q_Z :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpZ.flip inferInstance
    have hDK : AlgebraicGeometry.IsAffineOpen D_K := hD.preimage q_Z
    let v : Fin d → ↑(Z_K.presheaf.obj (Opposite.op D_K)) := fun δ => φ_D (u δ)
    have hSpanK : Ideal.span (Set.range v) = ⊤ := by
      rw [← hDK.iSup_basicOpen_eq_self_iff]
      have hCovK' : (⨆ δ : Fin d, Z_K.basicOpen (v δ)) = D_K := by
        simpa only [AlgebraicGeometry.Scheme.preimage_basicOpen] using hCovK
      refine (le_antisymm ?_ ?_).trans hCovK'
      · refine iSup_le (fun f => ?_)
        rcases f.2 with ⟨δ, hδ⟩
        rw [← hδ]
        exact le_iSup (fun δ : Fin d => Z_K.basicOpen (v δ)) δ
      · refine iSup_le (fun δ => ?_)
        exact le_iSup (fun f : Set.range v => Z_K.basicOpen f.1) ⟨v δ, ⟨δ, rfl⟩⟩
    have hOneMem : (1 : ↑(Z_K.presheaf.obj (Opposite.op D_K))) ∈ Ideal.span (Set.range v) := by
      rw [hSpanK]; trivial
    obtain ⟨cf, hcf⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hOneMem
    let c : Fin d → ↑(Z_K.presheaf.obj (Opposite.op D_K)) := fun δ => cf δ
    have hc : ∑ δ : Fin d, c δ * v δ = 1 := by
      rw [Finsupp.sum_fintype _ _ (fun _ => by simp)] at hcf
      simpa only [smul_eq_mul] using hcf
    choose s hs_ne a ha using fun δ : Fin d => hSurjK (c δ)
    let s_tot : R := ∏ δ : Fin d, s δ
    have hs_tot_ne : s_tot ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun δ _ => hs_ne δ)
    let s_hat : Fin d → R := fun δ => ∏ δ' ∈ Finset.univ.erase δ, s δ'
    have hs_mul : ∀ δ : Fin d, s δ * s_hat δ = s_tot :=
      fun δ => Finset.mul_prod_erase Finset.univ s (Finset.mem_univ δ)
    let a_tilde : Fin d → ↑(Z.presheaf.obj (Opposite.op D)) := fun δ => r_D (s_hat δ) * a δ
    have hφ_sum : φ_D ((∑ δ : Fin d, a_tilde δ * u δ) - r_D s_tot) = 0 := by
      have hr_comm : ∀ x : R, φ_D (r_D x) = r_DK (algebraMap R K x) :=
        app_open_base_ring_comm (algebraMap R K) fZ q_Z f_ZK hpZ.w D
      rw [map_sub, map_sum, hr_comm s_tot]
      have hterm : ∀ δ : Fin d,
          φ_D (a_tilde δ * u δ) = r_DK (algebraMap R K s_tot) * (c δ * v δ) := by
        intro δ
        dsimp [a_tilde, v]
        rw [map_mul, map_mul, hr_comm (s_hat δ), ha δ]
        calc
          r_DK (algebraMap R K (s_hat δ)) * (r_DK (algebraMap R K (s δ)) * c δ) * φ_D (u δ) =
              (r_DK (algebraMap R K (s δ)) * r_DK (algebraMap R K (s_hat δ))) *
                (c δ * φ_D (u δ)) := by ring
          _ = r_DK (algebraMap R K s_tot) * (c δ * φ_D (u δ)) := by
            rw [← map_mul, ← map_mul, hs_mul δ]
      simp_rw [hterm, ← Finset.mul_sum, hc, mul_one, sub_self]
    obtain ⟨t₀, ht₀_ne, ht₀_kill⟩ := hKerK _ hφ_sum
    let w : R := t₀ * s_tot
    have hw_ne : w ≠ 0 := mul_ne_zero ht₀_ne hs_tot_ne
    have hb_eq : ∑ δ : Fin d, (r_D t₀ * a_tilde δ) * u δ = r_D w := by
      have h1 : r_D t₀ * (∑ δ : Fin d, a_tilde δ * u δ) = r_D t₀ * r_D s_tot :=
        sub_eq_zero.mp (by rw [mul_sub] at ht₀_kill; exact ht₀_kill)
      have h2 : r_D t₀ * r_D s_tot = r_D w := by
        dsimp [w]; rw [map_mul]
      rw [h2] at h1
      rw [← h1, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun δ _ => by ring)
    refine ⟨w, hw_ne, ?_⟩
    intro S _ φ_RS hUnitw Z_S q_ZS f_ZS hpZS
    let D_S : Z_S.Opens := (TopologicalSpace.Opens.map q_ZS.base).obj D
    let r_DS : S →+* ↑(Z_S.presheaf.obj (Opposite.op D_S)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫ f_ZS.appTop ≫
        Z_S.presheaf.map (CategoryTheory.homOfLE (le_top : D_S ≤ ⊤)).op).hom
    let φ_DS : ↑(Z.presheaf.obj (Opposite.op D)) →+* ↑(Z_S.presheaf.obj (Opposite.op D_S)) :=
      (q_ZS.app D).hom
    have hw_S : φ_DS (r_D w) = r_DS (φ_RS w) :=
      app_open_base_ring_comm φ_RS fZ q_ZS f_ZS hpZS.w D w
    have hUnit_DS : IsUnit (φ_DS (r_D w)) := by
      rw [hw_S]
      exact hUnitw.map r_DS
    obtain ⟨u_inv, hu_inv⟩ := hUnit_DS.exists_left_inv
    have hSpanS : Ideal.span (Set.range (fun δ : Fin d => φ_DS (u δ))) = ⊤ := by
      rw [Ideal.eq_top_iff_one]
      have hsumS : u_inv * φ_DS (∑ δ : Fin d, (r_D t₀ * a_tilde δ) * u δ) = u_inv * φ_DS (r_D w) :=
        congrArg (fun z => u_inv * φ_DS z) hb_eq
      rw [hu_inv, map_sum, Finset.mul_sum] at hsumS
      rw [← hsumS]
      refine Submodule.sum_mem _ (fun δ _ => ?_)
      rw [map_mul, ← mul_assoc]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨δ, rfl⟩)
    have hiSupS := AlgebraicGeometry.iSup_basicOpen_of_span_eq_top D_S
      (Set.range (fun δ : Fin d => φ_DS (u δ))) hSpanS
    rw [iSup_range] at hiSupS
    simpa only [AlgebraicGeometry.Scheme.preimage_basicOpen] using hiSupS
  
  have exists_finite_affineOpen_cover_of_isCompact :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} (K_open : Z.Opens),
        IsCompact (K_open : Set Z) →
        ∃ (n : ℕ) (O : Fin n → Z.Opens),
          (∀ i : Fin n, AlgebraicGeometry.IsAffineOpen (O i)) ∧
          (⨆ i : Fin n, O i) = K_open := by
    intro Z K_open hComp
    have h_nbhd : ∀ z : ↥K_open,
        ∃ U : Z.Opens, AlgebraicGeometry.IsAffineOpen U ∧ z.1 ∈ U ∧ U ≤ K_open := by
      intro z
      obtain ⟨U, hU_aff, hzU, hU_le⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens Z) z.2
      exact ⟨U, hU_aff, hzU, hU_le⟩
    choose U_z hAff_z hz_mem hU_le using h_nbhd
    obtain ⟨t, ht⟩ := hComp.elim_finite_subcover (fun z : ↥K_open => (U_z z : Set Z))
      (fun z => (U_z z).isOpen)
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hz_mem ⟨x, hx⟩⟩)
    let e_fin := (Fintype.equivFin ↥t).symm
    refine ⟨Fintype.card ↥t, fun i => U_z (e_fin i).1, fun i => hAff_z (e_fin i).1, ?_⟩
    apply le_antisymm
    · exact iSup_le (fun i => hU_le (e_fin i).1)
    · intro x hx
      have hx_u := ht hx
      rw [Set.mem_iUnion₂] at hx_u
      rcases hx_u with ⟨z, hzt, hxz⟩
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨e_fin.symm ⟨z, hzt⟩,
        by simpa only [Equiv.apply_symm_apply] using SetLike.mem_coe.mp hxz⟩
  
  have pullback_resLE_and_morphismRestrict_over_base :
      ∀ (B B' X W X' W' : AlgebraicGeometry.Scheme.{u})
        (g : B' ⟶ B)
        (fX : X ⟶ B) (fW : W ⟶ B)
        (ψ : X ⟶ W) (_ : ψ ≫ fW = fX)
        (q_X : X' ⟶ X) (f_X' : X' ⟶ B')
        (q_W : W' ⟶ W) (f_W' : W' ⟶ B')
        (ψ' : X' ⟶ W'),
        CategoryTheory.IsPullback q_X f_X' fX g →
        CategoryTheory.IsPullback q_W f_W' fW g →
        ψ' ≫ q_W = q_X ≫ ψ →
        ψ' ≫ f_W' = f_X' →
        ∀ (U : W.Opens) (O : X.Opens)
          (hO : O ≤ (TopologicalSpace.Opens.map ψ.base).obj U),
          ∃ (hO' : (TopologicalSpace.Opens.map q_X.base).obj O ≤
              (TopologicalSpace.Opens.map ψ'.base).obj ((TopologicalSpace.Opens.map q_W.base).obj U)),
            let U' : W'.Opens := (TopologicalSpace.Opens.map q_W.base).obj U
            let O' : X'.Opens := (TopologicalSpace.Opens.map q_X.base).obj O
            let φ : (O : AlgebraicGeometry.Scheme.{u}) ⟶ (U : AlgebraicGeometry.Scheme.{u}) :=
              AlgebraicGeometry.Scheme.Hom.resLE ψ U O hO
            let φ' : (O' : AlgebraicGeometry.Scheme.{u}) ⟶ (U' : AlgebraicGeometry.Scheme.{u}) :=
              AlgebraicGeometry.Scheme.Hom.resLE ψ' U' O' hO'
            φ ≫ (U.ι ≫ fW) = O.ι ≫ fX ∧
            CategoryTheory.IsPullback (q_X ∣_ O) (O'.ι ≫ f_X') (O.ι ≫ fX) g ∧
