      ext w
      obtain ⟨c, rfl⟩ := hΘ_surj w
      change frob (c • v₀) = eV ((1 : Module.End (Padic ℓ₀) (Padic ℓ₀)) (eV.symm (eV c)))
      rw [map_smul, hfrob_v₀, eV.symm_apply_apply, Module.End.one_apply]
      rfl
    have hchar : frob.charpoly = Polynomial.X - Polynomial.C (1 : Padic ℓ₀) := by
      rw [hfrob_eq, LinearEquiv.charpoly_conj, LinearMap.charpoly_one,
        Module.finrank_self, pow_one, map_one]
    rw [hchar, Polynomial.aroots_X_sub_C, map_one]

  
  have hmem_gen : ∀ (S₀ : AlgebraicGeometry.Scheme.{u})
      (y : ∀ r : ℕ, weilEtaleTorsionH S₀ (ℓ ^ r) 0),
      y ∈ weilEtaleIntegralSystem S₀ ℓ 0 ↔
        ∀ r : ℕ, weilEtaleTorsionTransition S₀ ℓ r 0 (y (r + 1)) = y r := by
    clear hℓ M0 hPart2 hPart3 hPart4
    intro S₀ y
    change (AddMonoidHom.pi fun r =>
        (weilEtaleTorsionTransition S₀ ℓ r 0).comp
          (Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S₀ (ℓ ^ k) 0) (r + 1)) -
        Pi.evalAddMonoidHom (fun k => weilEtaleTorsionH S₀ (ℓ ^ k) 0) r) y = 0 ↔ _
    refine ⟨fun h r => sub_eq_zero.mp (congrFun h r), fun h => funext fun r => sub_eq_zero.mpr (h r)⟩
  obtain ⟨e, hTrans, hFrobAll⟩ := hPart3
  have hFrobId : ∀ (r : ℕ) (x : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) 0),
      M0.frobTorsion r x = x :=
    fun r => hFrobAll r (M0.frobTorsion r) (M0.hfrobTorsion r)
  exact hPart4 ℓ
    (fun r => weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) 0)
    (fun r => weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r 0)
    (weilEtaleIntegralSystem (weilGeomScheme K Z) ℓ 0)
    (hmem_gen (weilGeomScheme K Z))
    e hTrans M0.V M0.frob M0.frobTorsion hFrobId M0.equiv M0.hsmul M0.hfrob

theorem weil_etale_module_ext_comparison : (∀ (S : AlgebraicGeometry.Scheme.{u}) (m k : ℕ),
      (∃ θ : weilEtaleModuleH S m k →+ weilEtaleTorsionH S m k,
        WeilIsModuleToTorsionComparison S m k θ ∧ Function.Bijective θ) ∧
      (∀ θ₁ θ₂ : weilEtaleModuleH S m k →+ weilEtaleTorsionH S m k,
        WeilIsModuleToTorsionComparison S m k θ₁ →
        WeilIsModuleToTorsionComparison S m k θ₂ →
        θ₁ = θ₂)) ∧
    (∀ (S : AlgebraicGeometry.Scheme.{u}) (ℓ r i j c : ℕ) (hc : i + j = c)
      (θ_i1 : weilEtaleModuleH S (ℓ ^ (r + 1)) i →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) i)
      (θ_i0 : weilEtaleModuleH S (ℓ ^ r) i →+ weilEtaleTorsionH S (ℓ ^ r) i)
      (θ_j1 : weilEtaleModuleH S (ℓ ^ (r + 1)) j →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) j)
      (θ_j0 : weilEtaleModuleH S (ℓ ^ r) j →+ weilEtaleTorsionH S (ℓ ^ r) j)
      (θ_c1 : weilEtaleModuleH S (ℓ ^ (r + 1)) c →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) c)
      (θ_c0 : weilEtaleModuleH S (ℓ ^ r) c →+ weilEtaleTorsionH S (ℓ ^ r) c),
      WeilIsModuleToTorsionComparison S (ℓ ^ (r + 1)) i θ_i1 →
      WeilIsModuleToTorsionComparison S (ℓ ^ r) i θ_i0 →
      WeilIsModuleToTorsionComparison S (ℓ ^ (r + 1)) j θ_j1 →
      WeilIsModuleToTorsionComparison S (ℓ ^ r) j θ_j0 →
      WeilIsModuleToTorsionComparison S (ℓ ^ (r + 1)) c θ_c1 →
      WeilIsModuleToTorsionComparison S (ℓ ^ r) c θ_c0 →
      ∀ (a : weilEtaleModuleH S (ℓ ^ (r + 1)) i)
        (b : weilEtaleModuleH S (ℓ ^ (r + 1)) j)
        (a₀ : weilEtaleModuleH S (ℓ ^ r) i)
        (b₀ : weilEtaleModuleH S (ℓ ^ r) j),
        weilEtaleTorsionTransition S ℓ r i (θ_i1 a) = θ_i0 a₀ →
        weilEtaleTorsionTransition S ℓ r j (θ_j1 b) = θ_j0 b₀ →
        weilEtaleTorsionTransition S ℓ r c (θ_c1 (CategoryTheory.Abelian.Ext.comp a b hc)) =
          θ_c0 (CategoryTheory.Abelian.Ext.comp a₀ b₀ hc)) ∧
    (∀ (K : Type u) [Finite K] [Field K]
      (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K))),
      (∀ (m k : ℕ),
        ∃ f : weilEtaleTorsionH (weilGeomScheme K Z) m k →+
          weilEtaleTorsionH (weilGeomScheme K Z) m k,
          WeilIsTorsionGeomFrobAction K Z m k f) ∧
      (∀ (ℓ r k : ℕ)
        (f₁ : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) k →+
          weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) k)
        (f₀ : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) k →+
          weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ r) k),
        WeilIsTorsionGeomFrobAction K Z (ℓ ^ (r + 1)) k f₁ →
        WeilIsTorsionGeomFrobAction K Z (ℓ ^ r) k f₀ →
        ∀ u : weilEtaleTorsionH (weilGeomScheme K Z) (ℓ ^ (r + 1)) k,
          weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r k (f₁ u) =
            f₀ (weilEtaleTorsionTransition (weilGeomScheme K Z) ℓ r k u)) ∧
      (∀ (m i j c : ℕ) (hc : i + j = c)
        (f_i : weilEtaleTorsionH (weilGeomScheme K Z) m i →+
          weilEtaleTorsionH (weilGeomScheme K Z) m i)
        (f_j : weilEtaleTorsionH (weilGeomScheme K Z) m j →+
          weilEtaleTorsionH (weilGeomScheme K Z) m j)
        (f_c : weilEtaleTorsionH (weilGeomScheme K Z) m c →+
          weilEtaleTorsionH (weilGeomScheme K Z) m c)
        (θ_i : weilEtaleModuleH (weilGeomScheme K Z) m i →+
          weilEtaleTorsionH (weilGeomScheme K Z) m i)
        (θ_j : weilEtaleModuleH (weilGeomScheme K Z) m j →+
          weilEtaleTorsionH (weilGeomScheme K Z) m j)
        (θ_c : weilEtaleModuleH (weilGeomScheme K Z) m c →+
          weilEtaleTorsionH (weilGeomScheme K Z) m c),
        WeilIsTorsionGeomFrobAction K Z m i f_i →
        WeilIsTorsionGeomFrobAction K Z m j f_j →
        WeilIsTorsionGeomFrobAction K Z m c f_c →
        WeilIsModuleToTorsionComparison (weilGeomScheme K Z) m i θ_i →
        WeilIsModuleToTorsionComparison (weilGeomScheme K Z) m j θ_j →
        WeilIsModuleToTorsionComparison (weilGeomScheme K Z) m c θ_c →
        ∀ (a : weilEtaleModuleH (weilGeomScheme K Z) m i)
          (b : weilEtaleModuleH (weilGeomScheme K Z) m j)
          (a' : weilEtaleModuleH (weilGeomScheme K Z) m i)
          (b' : weilEtaleModuleH (weilGeomScheme K Z) m j),
          f_i (θ_i a) = θ_i a' →
          f_j (θ_j b) = θ_j b' →
          f_c (θ_c (CategoryTheory.Abelian.Ext.comp a b hc)) =
            θ_c (CategoryTheory.Abelian.Ext.comp a' b' hc))) :=
by
  
  
  
  have hasSheafCompose_of_adj : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {L : B ⥤ A} {F : A ⥤ B} (_ : L ⊣ F), J.HasSheafCompose F := by
    intro C _ J A B _ _ L F adj
    refine ⟨fun P hP E => ?_⟩
    let isoE : (P ⋙ F) ⋙ coyoneda.obj (Opposite.op E) ≅
        P ⋙ coyoneda.obj (Opposite.op (L.obj E)) :=
      NatIso.ofComponents
        (fun W => (adj.homEquiv E (P.obj W)).symm.toIso)
        (fun {W₁ W₂} u => by
          ext g
          exact Adjunction.homEquiv_naturality_right_symm adj g (P.map u))
    exact Presieve.isSheaf_iso J isoE.symm (hP (L.obj E))

  let sheafComposeAdjRight : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {F : A ⥤ B} {G : B ⥤ A} (adj : F ⊣ G) [J.HasSheafCompose F] [J.HasSheafCompose G],
      sheafCompose J F ⊣ sheafCompose J G := fun {C} _ J {A B} _ _ {F G} adj _ _ =>
    let liftEquiv (P : Cᵒᵖ ⥤ A) (Q : Cᵒᵖ ⥤ B) : (P ⋙ F ⟶ Q) ≃ (P ⟶ Q ⋙ G) :=
      { toFun := fun φ =>
          { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
            naturality := fun {W₁ W₂} u => by
              have hnat : F.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
              change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
                adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ G.map (Q.map u)
              rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
                ← Adjunction.homEquiv_naturality_left adj] }
        invFun := fun ψ =>
          { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
            naturality := fun {W₁ W₂} u => by
              have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ G.map (Q.map u) := ψ.naturality u
              change F.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
                (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
              rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
                ← Adjunction.homEquiv_naturality_right_symm adj] }
        left_inv := fun φ => by ext W; exact (adj.homEquiv _ _).symm_apply_apply _
        right_inv := fun ψ => by ext W; exact (adj.homEquiv _ _).apply_symm_apply _ }
    Adjunction.mkOfHomEquiv
      { homEquiv := fun ℱ 𝒢 =>
          { toFun := fun φ => ⟨liftEquiv ℱ.obj 𝒢.obj φ.hom⟩
            invFun := fun ψ => ⟨(liftEquiv ℱ.obj 𝒢.obj).symm ψ.hom⟩
            left_inv := fun φ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).symm_apply_apply φ.hom
            right_inv := fun ψ => by ext1; exact (liftEquiv ℱ.obj 𝒢.obj).apply_symm_apply ψ.hom }
        homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} h ψ => by
          ext W
          exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
        homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} φ k => by
          ext W
          exact Adjunction.homEquiv_naturality_right adj (φ.hom.app W) (k.hom.app W) }

  let sheafComposeAdjLeft : ∀ {C : Type (u + 1)} [Category.{u} C]
      (J : GrothendieckTopology C) {A B : Type (u + 1)} [Category.{u} A] [Category.{u} B]
      {L : B ⥤ A} {F : A ⥤ B} (adj : L ⊣ F) [J.HasSheafCompose F] [HasWeakSheafify J A],
      (sheafToPresheaf J B ⋙
          { obj := fun P => P ⋙ L
            map := fun f => Functor.whiskerRight f L } ⋙
          presheafToSheaf J A) ⊣
        sheafCompose J F := fun {C} _ J {A B} _ _ {L F} adj _ _ =>
    let liftTo (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (φ : P ⋙ L ⟶ Q) : P ⟶ Q ⋙ F :=
      { app := fun W => adj.homEquiv (P.obj W) (Q.obj W) (φ.app W)
        naturality := fun {W₁ W₂} u => by
          have hnat : L.map (P.map u) ≫ φ.app W₂ = φ.app W₁ ≫ Q.map u := φ.naturality u
          change P.map u ≫ adj.homEquiv (P.obj W₂) (Q.obj W₂) (φ.app W₂) =
            adj.homEquiv (P.obj W₁) (Q.obj W₁) (φ.app W₁) ≫ F.map (Q.map u)
          rw [← Adjunction.homEquiv_naturality_right adj, ← hnat,
            ← Adjunction.homEquiv_naturality_left adj] }
    let liftInv (P : Cᵒᵖ ⥤ B) (Q : Cᵒᵖ ⥤ A) (ψ : P ⟶ Q ⋙ F) : P ⋙ L ⟶ Q :=
      { app := fun W => (adj.homEquiv (P.obj W) (Q.obj W)).symm (ψ.app W)
        naturality := fun {W₁ W₂} u => by
          have hnat : P.map u ≫ ψ.app W₂ = ψ.app W₁ ≫ F.map (Q.map u) := ψ.naturality u
          change L.map (P.map u) ≫ (adj.homEquiv (P.obj W₂) (Q.obj W₂)).symm (ψ.app W₂) =
            (adj.homEquiv (P.obj W₁) (Q.obj W₁)).symm (ψ.app W₁) ≫ Q.map u
          rw [← Adjunction.homEquiv_naturality_left_symm adj, hnat,
            ← Adjunction.homEquiv_naturality_right_symm adj] }
    Adjunction.mkOfHomEquiv
      { homEquiv := fun 𝒢 ℱ =>
          { toFun := fun φ =>
              ⟨liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ)⟩
            invFun := fun ψ =>
              ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ).symm
                (liftInv 𝒢.obj ℱ.obj ψ.hom)
            left_inv := fun φ => by
              have h : liftInv 𝒢.obj ℱ.obj
                  (liftTo 𝒢.obj ℱ.obj ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ)) =
                  (sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ φ := by
                ext W
                exact (adj.homEquiv _ _).symm_apply_apply _
              exact (congrArg ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ).symm h).trans
                (Equiv.symm_apply_apply _ φ)
            right_inv := fun ψ => by
              ext W
              have h := Equiv.apply_symm_apply
                ((sheafificationAdjunction J A).homEquiv (𝒢.obj ⋙ L) ℱ)
                (liftInv 𝒢.obj ℱ.obj ψ.hom)
              have hW := congrArg (fun α => α.app W) h
              exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ.obj.obj W)) hW).trans
                ((adj.homEquiv _ _).apply_symm_apply (ψ.hom.app W)) }
        homEquiv_naturality_left_symm := fun {𝒢' 𝒢 ℱ} h ψ => by
          have h1 : liftInv 𝒢'.obj ℱ.obj ((h ≫ ψ).hom) =
              Functor.whiskerRight h.hom L ≫ liftInv 𝒢.obj ℱ.obj ψ.hom := by
            ext W
            exact Adjunction.homEquiv_naturality_left_symm adj (h.hom.app W) (ψ.hom.app W)
          exact (congrArg ((sheafificationAdjunction J A).homEquiv (𝒢'.obj ⋙ L) ℱ).symm h1).trans
            (Adjunction.homEquiv_naturality_left_symm
              (sheafificationAdjunction J A) (Functor.whiskerRight h.hom L)
              (liftInv 𝒢.obj ℱ.obj ψ.hom))
        homEquiv_naturality_right := fun {𝒢 ℱ ℱ'} φ k => by
          ext W
          have h1 := Adjunction.homEquiv_naturality_right (sheafificationAdjunction J A) φ k
          have h1W := congrArg (fun α => α.app W) h1
          exact (congrArg (adj.homEquiv (𝒢.obj.obj W) (ℱ'.obj.obj W)) h1W).trans
            (Adjunction.homEquiv_naturality_right adj _ (k.hom.app W)) }

  have sheaf_eq_of_obj_eq : ∀ {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
      {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : Sheaf J A},
      ℱ₁.obj = ℱ₂.obj → ℱ₁ = ℱ₂ := by
    intro C _ J A _ ℱ₁ ℱ₂ h
    rcases ℱ₁ with ⟨o₁, p₁⟩
    rcases ℱ₂ with ⟨o₂, p₂⟩
    change o₁ = o₂ at h
    subst h
    rfl

  have etale_obj_eq : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U₁ U₂ : S.Etale),
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).left =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).left →
      HEq ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).hom
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom →
      U₁ = U₂ := by
    intro S U₁ U₂ hl hh
    rcases U₁ with ⟨⟨l₁, r₁, h₁⟩, p₁⟩
    rcases U₂ with ⟨⟨l₂, r₂, h₂⟩, p₂⟩
    cases r₁; cases r₂
    change l₁ = l₂ at hl
    subst hl
    change HEq h₁ h₂ at hh
    cases eq_of_heq hh
    rfl

  have mapExactFunctor_comp_apply :
      ∀ {A B D : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A] [EnoughInjectives A]
        [Category.{u + 1} B] [Abelian B] [HasExt.{u} B]
        [Category.{u + 1} D] [Abelian D] [HasExt.{u} D]
        (F : A ⥤ B) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
        (G : B ⥤ D) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
        {X Y : A} {n : ℕ} (x : Abelian.Ext X Y n),
        let _ : Limits.PreservesFiniteLimits (F ⋙ G) := Limits.comp_preservesFiniteLimits F G
        let _ : Limits.PreservesFiniteColimits (F ⋙ G) := Limits.comp_preservesFiniteColimits F G
        Abelian.Ext.mapExactFunctor (F ⋙ G) x =
          Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor F x) := by
    intro A B D _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _
    let _ : Limits.PreservesFiniteLimits (F ⋙ G) := Limits.comp_preservesFiniteLimits F G
    let _ : Limits.PreservesFiniteColimits (F ⋙ G) := Limits.comp_preservesFiniteColimits F G
    intro X Y n
    induction n generalizing Y with
    | zero =>
      intro x
      dsimp only
      rw [← Abelian.Ext.mk₀_addEquiv₀_apply x,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ n ih =>
      intro x
      let ι : Y ⟶ Injective.under Y := Injective.ι Y
      let S_Y : ShortComplex A :=
        ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS_Y : S_Y.ShortExact := { exact := ShortComplex.exact_cokernel ι }
      have h_zero : x.comp (Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (n + 1)) = 0 := by
        have hIdim : HasInjectiveDimensionLT (Injective.under Y) 1 := inferInstance
        exact (hasInjectiveDimensionLT_iff (Injective.under Y) 1).mp hIdim (n + 1)
          (Nat.le_add_left 1 n) _
      obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS_Y x h_zero rfl
      dsimp only
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, ih z,
        Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_extClass]

  have ext_vanish_of_effaceable :
      ∀ {D : Type (u + 1)} [Category.{u + 1} D] [Abelian D] [HasExt.{u} D] [EnoughInjectives D]
        (T_pred : D → Prop),
        (∀ {K' P : D} (ι : K' ⟶ P) [Mono ι], T_pred P → T_pred K') →
        (∀ E : D, ∃ (P : D) (q : P ⟶ E), T_pred P ∧ Epi q) →
        ∀ (Y : D),
          (∀ (SC : ShortComplex D), SC.ShortExact → T_pred SC.X₃ →
            ∀ (g₀ : SC.X₁ ⟶ Y), ∃ h : SC.X₂ ⟶ Y, SC.f ≫ h = g₀) →
          ∀ (p : ℕ) {K : D}, T_pred K → ∀ (e : Abelian.Ext K Y (p + 1)), e = 0 := by
    intro D _ _ _ _ T_pred hSub hCover Y hExt
    let R_Y := InjectiveResolution.of Y
    have hPull : ∀ (q : ℕ) (K : D) (f : K ⟶ R_Y.cocomplex.X (q + 1))
        (_ : f ≫ R_Y.cocomplex.d (q + 1) (q + 2) = 0),
        ∃ (P : D) (π : P ⟶ K) (g : P ⟶ R_Y.cocomplex.X q),
          T_pred P ∧ Epi π ∧ g ≫ R_Y.cocomplex.d q (q + 1) = π ≫ f := by
      intro q K f hf
      let SC_q : ShortComplex D :=
        ShortComplex.mk (R_Y.cocomplex.d q (q + 1)) (R_Y.cocomplex.d (q + 1) (q + 2))
          (R_Y.cocomplex.d_comp_d q (q + 1) (q + 2))
      have hEx_q : SC_q.Exact := R_Y.exact_succ q
      have _ : Epi SC_q.toCycles := (ShortComplex.exact_iff_epi_toCycles SC_q).mp hEx_q
      let f_cyc : K ⟶ SC_q.cycles := SC_q.liftCycles f hf
      let E_pb := Limits.pullback SC_q.toCycles f_cyc
      let p_pb : E_pb ⟶ K := Limits.pullback.snd SC_q.toCycles f_cyc
      have _ : Epi p_pb := Abelian.epi_pullback_of_epi_f SC_q.toCycles f_cyc
      let g_pb : E_pb ⟶ R_Y.cocomplex.X q := Limits.pullback.fst SC_q.toCycles f_cyc
      obtain ⟨P, q_P, hTP, hEpi_q⟩ := hCover E_pb
      refine ⟨P, q_P ≫ p_pb, q_P ≫ g_pb, hTP, epi_comp q_P p_pb, ?_⟩
      change (q_P ≫ g_pb) ≫ SC_q.f = (q_P ≫ p_pb) ≫ f
      rw [← SC_q.toCycles_i, Category.assoc, ← Category.assoc g_pb, Limits.pullback.condition,
        Category.assoc, SC_q.liftCycles_i, Category.assoc]
    intro p
    induction p with
    | zero =>
      intro K hTK e
      obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e 2 rfl
      obtain ⟨P, π, g, hTP, hEpi_π, hg⟩ := hPull 0 K f hf
      let ι := Limits.kernel.ι π
      let S_π : ShortComplex D := ShortComplex.mk ι π (Limits.kernel.condition π)
      have hS_π : S_π.ShortExact := { exact := ShortComplex.exact_kernel π }
      have h_ig : (ι ≫ g) ≫ R_Y.cocomplex.d 0 1 = 0 := by
        rw [Category.assoc, hg, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
      have _ : Mono (R_Y.ι.f 0) := inferInstance
      let ι₀ : Y ⟶ R_Y.cocomplex.X 0 := R_Y.ι.f 0
      let getZero {SC : ShortComplex D} (_ : SC.Exact) : SC.f ≫ SC.g = 0 := SC.zero
      have hι₀_d : ι₀ ≫ R_Y.cocomplex.d 0 1 = 0 := getZero R_Y.exact₀
      let g₀ : Limits.kernel π ⟶ Y :=
        (R_Y.exact₀).fIsKernel.lift (Limits.KernelFork.ofι (ι ≫ g) h_ig)
      have hg₀ : g₀ ≫ ι₀ = ι ≫ g :=
        (R_Y.exact₀).fIsKernel.fac (Limits.KernelFork.ofι (ι ≫ g) h_ig)
          Limits.WalkingParallelPair.zero
      obtain ⟨h, hh⟩ := hExt S_π hS_π hTK g₀
      have h_sub_ker : ι ≫ (g - h ≫ ι₀) = 0 := by
        rw [Preadditive.comp_sub, ← Category.assoc]
        change ι ≫ g - (S_π.f ≫ h) ≫ ι₀ = 0
        rw [hh, hg₀, sub_self]
      let s : K ⟶ R_Y.cocomplex.X 0 :=
        hS_π.exact.gIsCokernel.desc (Limits.CokernelCofork.ofπ (g - h ≫ ι₀) h_sub_ker)
      have hs : π ≫ s = g - h ≫ ι₀ :=
        hS_π.exact.gIsCokernel.fac (Limits.CokernelCofork.ofπ (g - h ≫ ι₀) h_sub_ker)
          Limits.WalkingParallelPair.one
      have hs_d : s ≫ R_Y.cocomplex.d 0 1 = f := by
        apply (cancel_epi π).mp
        rw [← Category.assoc, hs, Preadditive.sub_comp, hg, Category.assoc, hι₀_d,
          Limits.comp_zero, sub_zero]
      exact (R_Y.extMk_eq_zero_iff f 2 rfl hf 0 rfl).mpr ⟨s, hs_d⟩
    | succ p' ih =>
      intro K hTK e
      obtain ⟨f, hf, rfl⟩ := R_Y.extMk_surjective e (p' + 3) rfl
      obtain ⟨P, π, g, hTP, hEpi_π, hg⟩ := hPull (p' + 1) K f hf
      have h_pull_zero :
          (Abelian.Ext.mk₀ π).comp (R_Y.extMk f (p' + 3) rfl hf) (Nat.zero_add (p' + 2)) = 0 := by
        rw [R_Y.mk₀_comp_extMk]
        exact (R_Y.extMk_eq_zero_iff (π ≫ f) (p' + 3) rfl _ (p' + 1) rfl).mpr ⟨g, hg⟩
      let ι := Limits.kernel.ι π
      let S_π : ShortComplex D := ShortComplex.mk ι π (Limits.kernel.condition π)
      have hS_π : S_π.ShortExact := { exact := ShortComplex.exact_kernel π }
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS_π Y
        (R_Y.extMk f (p' + 3) rfl hf) h_pull_zero (Nat.add_comm 1 (p' + 1))
      rw [← hx₁, ih (hSub ι hTP) x₁, Abelian.Ext.comp_zero]

  have ext_comparison_bijective_of_acyclic :
      ∀ {A D : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A] [EnoughInjectives A]
        [Category.{u + 1} D] [Abelian D] [HasExt.{u} D]
        (U : A ⥤ D) [U.Additive] [Limits.PreservesFiniteLimits U] [Limits.PreservesFiniteColimits U]
        (X₀ : A) (Z₀ : D) (η : Z₀ ⟶ U.obj X₀),
        (∀ ℱ : A, Function.Bijective (fun x : Abelian.Ext X₀ ℱ 0 =>
          (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U x) (Nat.zero_add 0))) →
        (∀ (ℐ : A) [Injective ℐ] (p : ℕ) (e : Abelian.Ext Z₀ (U.obj ℐ) (p + 1)), e = 0) →
        ∀ (k : ℕ) (ℱ : A), Function.Bijective (fun x : Abelian.Ext X₀ ℱ k =>
          (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U x) (Nat.zero_add k)) := by
    intro A D _ _ _ _ _ _ _ U _ _ _ X₀ Z₀ η hBase hAcyc
    let Θ (ℱ : A) (k : ℕ) : Abelian.Ext X₀ ℱ k →+ Abelian.Ext Z₀ (U.obj ℱ) k :=
      ((Abelian.Ext.mk₀ η).precomp (U.obj ℱ) (Nat.zero_add k)).comp (U.mapExtAddHom X₀ ℱ k)
    change ∀ (k : ℕ) (ℱ : A), Function.Bijective (Θ ℱ k)
    intro k
    induction k with
    | zero =>
      intro ℱ
      exact hBase ℱ
    | succ k ih =>
      intro ℱ
      let ℐ := Injective.under ℱ
      let i_ℱ : ℱ ⟶ ℐ := Injective.ι ℱ
      let Q := Limits.cokernel i_ℱ
      let p_ℱ : ℐ ⟶ Q := Limits.cokernel.π i_ℱ
      let S_ℱ : ShortComplex A := ShortComplex.mk i_ℱ p_ℱ (Limits.cokernel.condition i_ℱ)
      have hS_ℱ : S_ℱ.ShortExact := { exact := ShortComplex.exact_cokernel i_ℱ }
      have hUS_ℱ : (S_ℱ.map U).ShortExact := hS_ℱ.map_of_exact U
      have hΘ_p : ∀ y : Abelian.Ext X₀ ℐ k,
          Θ Q k (y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k)) =
            (Θ ℐ k y).comp (Abelian.Ext.mk₀ (S_ℱ.map U).g) (Nat.add_zero k) := by
        intro y
        change (Abelian.Ext.mk₀ η).comp
            (Abelian.Ext.mapExactFunctor U (y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k)))
            (Nat.zero_add k) =
          ((Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U y) (Nat.zero_add k)).comp
            (Abelian.Ext.mk₀ (U.map S_ℱ.g)) (Nat.add_zero k)
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) (Abelian.Ext.mapExactFunctor U y)
            (Abelian.Ext.mk₀ (U.map S_ℱ.g)) (Nat.zero_add k) (Nat.add_zero k) (Nat.zero_add k)]
      have hΘ_δ : ∀ z : Abelian.Ext X₀ Q k,
          Θ ℱ (k + 1) (z.comp hS_ℱ.extClass rfl) =
            (Θ Q k z).comp hUS_ℱ.extClass rfl := by
        intro z
        change (Abelian.Ext.mk₀ η).comp
            (Abelian.Ext.mapExactFunctor U (z.comp hS_ℱ.extClass rfl))
            (Nat.zero_add (k + 1)) =
          ((Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor U z) (Nat.zero_add k)).comp
            hUS_ℱ.extClass rfl
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) (Abelian.Ext.mapExactFunctor U z)
            hUS_ℱ.extClass (Nat.zero_add k) rfl (Nat.zero_add (k + 1))]
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro x hx
        have hx0 : x.comp (Abelian.Ext.mk₀ S_ℱ.f) (Nat.add_zero (k + 1)) = 0 := by
          have hIdim : HasInjectiveDimensionLT ℐ 1 := inferInstance
          exact (hasInjectiveDimensionLT_iff ℐ 1).mp hIdim (k + 1) (Nat.le_add_left 1 k) _
        obtain ⟨z, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X₀ hS_ℱ x hx0 rfl
        have hz0 : (Θ Q k z).comp hUS_ℱ.extClass rfl = 0 := by
          rw [← hΘ_δ z, hx]
        obtain ⟨y', hy'⟩ := Abelian.Ext.covariant_sequence_exact₃ Z₀ hUS_ℱ (Θ Q k z) rfl hz0
        obtain ⟨y, rfl⟩ := (ih ℐ).surjective y'
        have hz_eq : z = y.comp (Abelian.Ext.mk₀ S_ℱ.g) (Nat.add_zero k) :=
          (ih Q).injective ((hΘ_p y).trans hy').symm
        rw [hz_eq, Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ S_ℱ.g) hS_ℱ.extClass
          (Nat.add_zero k) (Nat.zero_add 1) rfl, hS_ℱ.comp_extClass, Abelian.Ext.comp_zero]
      · intro w
        have hw0 : w.comp (Abelian.Ext.mk₀ (S_ℱ.map U).f) (Nat.add_zero (k + 1)) = 0 :=
          hAcyc ℐ k _
        obtain ⟨z', rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ Z₀ hUS_ℱ w hw0 rfl
        obtain ⟨z, rfl⟩ := (ih Q).surjective z'
        exact ⟨z.comp hS_ℱ.extClass rfl, hΘ_δ z⟩

  have ext_postcomp_apply :
      ∀ {A : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A]
        {X Y Z : A} {a b ab : ℕ} (y : Abelian.Ext Y Z b) (h : a + b = ab)
        (x : Abelian.Ext X Y a),
        (y.postcomp X h) x = x.comp y h :=
    fun _ _ _ => rfl

  have ext_precomp_apply :
      ∀ {A : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A]
        {X Y Z : A} {a b ab : ℕ} (x : Abelian.Ext X Y a) (h : a + b = ab)
        (y : Abelian.Ext Y Z b),
        (x.precomp Z h) y = x.comp y h :=
    fun _ _ _ => rfl

  have mapExtAddHom_apply :
      ∀ {A B : Type (u + 1)} [Category.{u + 1} A] [Abelian A] [HasExt.{u} A]
        [Category.{u + 1} B] [Abelian B] [HasExt.{u} B]
        (F : A ⥤ B) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
        (X Y : A) (n : ℕ) (x : Abelian.Ext X Y n),
        (F.mapExtAddHom X Y n) x = Abelian.Ext.mapExactFunctor F x := by
    intros; rfl

  have sheaf_hom_eq :
      ∀ {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
        {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J A}
        (f₁ f₂ : ℱ₁ ⟶ ℱ₂),
        (∀ W : Cᵒᵖ, f₁.hom.app W = f₂.hom.app W) → f₁ = f₂ := by
    intro C _ J A _ ℱ₁ ℱ₂ ⟨h₁⟩ ⟨h₂⟩ h
    congr 1
    exact CategoryTheory.NatTrans.ext (funext h)

  let pushEquiv {C_site : Type (u + 1)} [Category.{u} C_site]
      (J_site : GrothendieckTopology C_site) (e_site : C_site ≌ C_site)
      [e_site.functor.IsContinuous J_site J_site] [e_site.inverse.IsContinuous J_site J_site]
      (D : Type (u + 1)) [Category.{u} D]
      (ℱ 𝒢 : CategoryTheory.Sheaf J_site D) :
      ((e_site.functor.sheafPushforwardContinuous D J_site J_site).obj ℱ ⟶ 𝒢) ≃
        (ℱ ⟶ (e_site.inverse.sheafPushforwardContinuous D J_site J_site).obj 𝒢) :=
    let G₀ := e_site.functor
    let G₀_inv := e_site.inverse
    let φApp (φ : (G₀.sheafPushforwardContinuous D J_site J_site).obj ℱ ⟶ 𝒢) (U : C_site) :
        ℱ.obj.obj (Opposite.op (G₀.obj U)) ⟶ 𝒢.obj.obj (Opposite.op U) :=
      φ.hom.app (Opposite.op U)
    let ψApp (ψ : ℱ ⟶ (G₀_inv.sheafPushforwardContinuous D J_site J_site).obj 𝒢) (U : C_site) :
        ℱ.obj.obj (Opposite.op U) ⟶ 𝒢.obj.obj (Opposite.op (G₀_inv.obj U)) :=
      ψ.hom.app (Opposite.op U)
    { toFun := fun φ =>
        ⟨{ app := fun W =>
             ℱ.obj.map (e_site.counitIso.hom.app W.unop).op ≫ φApp φ (G₀_inv.obj W.unop)
           naturality := fun {W₁ W₂} u => by
             have hnat : ℱ.obj.map (G₀.map (G₀_inv.map u.unop)).op ≫
                 φApp φ (G₀_inv.obj W₂.unop) =
                 φApp φ (G₀_inv.obj W₁.unop) ≫ 𝒢.obj.map (G₀_inv.map u.unop).op :=
               φ.hom.naturality (G₀_inv.map u.unop).op
             have hc : G₀.map (G₀_inv.map u.unop) ≫ e_site.counitIso.hom.app W₁.unop =
                 e_site.counitIso.hom.app W₂.unop ≫ u.unop :=
               e_site.counitIso.hom.naturality u.unop
             have hc_op : u.unop.op ≫ (e_site.counitIso.hom.app W₂.unop).op =
                 (e_site.counitIso.hom.app W₁.unop).op ≫ (G₀.map (G₀_inv.map u.unop)).op := by
               rw [← op_comp, ← op_comp, hc]
             have hu_eq : ℱ.obj.map u = ℱ.obj.map u.unop.op := rfl
             change ℱ.obj.map u ≫
                 (ℱ.obj.map (e_site.counitIso.hom.app W₂.unop).op ≫ φApp φ (G₀_inv.obj W₂.unop)) =
               (ℱ.obj.map (e_site.counitIso.hom.app W₁.unop).op ≫ φApp φ (G₀_inv.obj W₁.unop)) ≫
                 𝒢.obj.map (G₀_inv.map u.unop).op
             rw [hu_eq, ← Category.assoc, ← ℱ.obj.map_comp, hc_op,
               ℱ.obj.map_comp, Category.assoc, hnat, ← Category.assoc] }⟩
      invFun := fun ψ =>
        ⟨{ app := fun W =>
             ψApp ψ (G₀.obj W.unop) ≫ 𝒢.obj.map (e_site.unitIso.hom.app W.unop).op
           naturality := fun {W₁ W₂} u => by
             have hnat : ℱ.obj.map (G₀.map u.unop).op ≫ ψApp ψ (G₀.obj W₂.unop) =
                 ψApp ψ (G₀.obj W₁.unop) ≫ 𝒢.obj.map (G₀_inv.map (G₀.map u.unop)).op :=
               ψ.hom.naturality (G₀.map u.unop).op
             have hu : u.unop ≫ e_site.unitIso.hom.app W₁.unop =
                 e_site.unitIso.hom.app W₂.unop ≫ G₀_inv.map (G₀.map u.unop) :=
               e_site.unitIso.hom.naturality u.unop
             have hu_op : (G₀_inv.map (G₀.map u.unop)).op ≫ (e_site.unitIso.hom.app W₂.unop).op =
                 (e_site.unitIso.hom.app W₁.unop).op ≫ u.unop.op := by
               rw [← op_comp, ← op_comp, hu]
             have hu_eq : 𝒢.obj.map u = 𝒢.obj.map u.unop.op := rfl
             change ℱ.obj.map (G₀.map u.unop).op ≫
                 (ψApp ψ (G₀.obj W₂.unop) ≫ 𝒢.obj.map (e_site.unitIso.hom.app W₂.unop).op) =
               (ψApp ψ (G₀.obj W₁.unop) ≫ 𝒢.obj.map (e_site.unitIso.hom.app W₁.unop).op) ≫
                 𝒢.obj.map u
             rw [hu_eq, ← Category.assoc, hnat, Category.assoc, Category.assoc]
             congr 1
             rw [← 𝒢.obj.map_comp, hu_op, 𝒢.obj.map_comp] }⟩
      left_inv := fun φ => by
        apply sheaf_hom_eq; intro W
        let u_W := e_site.unitIso.hom.app W.unop
        let c_GW := e_site.counitIso.hom.app (G₀.obj W.unop)
        have hnat : ℱ.obj.map (G₀.map u_W).op ≫ φApp φ W.unop =
            φApp φ (G₀_inv.obj (G₀.obj W.unop)) ≫ 𝒢.obj.map u_W.op :=
          φ.hom.naturality u_W.op
        have htri_map : ℱ.obj.map c_GW.op ≫ ℱ.obj.map (G₀.map u_W).op =
            𝟙 (ℱ.obj.obj (Opposite.op (G₀.obj W.unop))) :=
          (ℱ.obj.map_comp c_GW.op (G₀.map u_W).op).symm.trans
            ((congrArg ℱ.obj.map
              (op_comp.symm.trans
                (congrArg Quiver.Hom.op (e_site.functor_unitIso_comp W.unop)))).trans
              (ℱ.obj.map_id (Opposite.op (G₀.obj W.unop))))
        exact (Category.assoc (ℱ.obj.map c_GW.op) _ (𝒢.obj.map u_W.op)).trans
          ((congrArg (fun k => ℱ.obj.map c_GW.op ≫ k) hnat.symm).trans
            ((Category.assoc (ℱ.obj.map c_GW.op) (ℱ.obj.map (G₀.map u_W).op)
              (φApp φ W.unop)).symm.trans
              ((congrArg (fun k => k ≫ φApp φ W.unop) htri_map).trans
                (Category.id_comp (φApp φ W.unop)))))
      right_inv := fun ψ => by
        apply sheaf_hom_eq; intro W
        let c_W := e_site.counitIso.hom.app W.unop
        let u_GW := e_site.unitIso.hom.app (G₀_inv.obj W.unop)
        have hnat : ℱ.obj.map c_W.op ≫ ψApp ψ (G₀.obj (G₀_inv.obj W.unop)) =
            ψApp ψ W.unop ≫ 𝒢.obj.map (G₀_inv.map c_W).op :=
          ψ.hom.naturality c_W.op
        have htri_map : 𝒢.obj.map (G₀_inv.map c_W).op ≫ 𝒢.obj.map u_GW.op =
            𝟙 (𝒢.obj.obj (Opposite.op (G₀_inv.obj W.unop))) :=
          (𝒢.obj.map_comp (G₀_inv.map c_W).op u_GW.op).symm.trans
            ((congrArg 𝒢.obj.map
              (op_comp.symm.trans
                (congrArg Quiver.Hom.op (e_site.unit_inverse_comp W.unop)))).trans
              (𝒢.obj.map_id (Opposite.op (G₀_inv.obj W.unop))))
        exact (Category.assoc (ℱ.obj.map c_W.op) _ (𝒢.obj.map u_GW.op)).symm.trans
          ((congrArg (fun k => k ≫ 𝒢.obj.map u_GW.op) hnat).trans
            ((Category.assoc (ψApp ψ W.unop) (𝒢.obj.map (G₀_inv.map c_W).op)
              (𝒢.obj.map u_GW.op)).trans
              ((congrArg (fun k => ψApp ψ W.unop ≫ k) htri_map).trans
                (Category.comp_id (ψApp ψ W.unop))))) }

  
  
  
  have hHasSC_fgt : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      S.smallEtaleTopology.HasSheafCompose
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    exact hasSheafCompose_of_adj S.smallEtaleTopology
      (eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R)))

  let U_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) ⥤
        CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    let _ := hHasSC_fgt S m
    CategoryTheory.sheafCompose S.smallEtaleTopology
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u})

  have hAdd_U : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ), (U_of S m).Additive := by
    intro S m
    exact { map_add := by intros; ext W x; rfl }

  have hLim_U : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      Limits.PreservesFiniteLimits (U_of S m) ∧
      Limits.PreservesFiniteColimits (U_of S m) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let adjModL : (eZ.inverse ⋙ ModuleCat.extendScalars (Int.castRingHom R)) ⊣
        CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u} :=
      eZ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R))
    let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      eZ.inverse ⋙ ModuleCat.coextendScalars (Int.castRingHom R)
    let adjModR : CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u} ⊣ C_mod :=
      (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
    have _ : J.HasSheafCompose C_mod := hasSheafCompose_of_adj J adjModR
    have _ : (U_of S m).IsLeftAdjoint := ⟨sheafCompose J C_mod, ⟨sheafComposeAdjRight J adjModR⟩⟩
    have _ : (U_of S m).IsRightAdjoint := ⟨_, ⟨sheafComposeAdjLeft J adjModL⟩⟩
    exact ⟨inferInstance, inferInstance⟩

  have hExtMod : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      HasExt.{u} (CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))) := fun _ _ => inferInstance

  have hExtAb : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      HasExt.{u} (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun _ => inferInstance

  let T_of (S : AlgebraicGeometry.Scheme.{u}) : S.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : AlgebraicGeometry.Etale (𝟙 S))

  let hT_of (S : AlgebraicGeometry.Scheme.{u}) : Limits.IsTerminal (T_of S) :=
    let FgtFF := AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful S
    Limits.IsTerminal.ofUniqueHom
      (fun W => FgtFF.preimage
        (Over.mkIdTerminal.from ((AlgebraicGeometry.Scheme.Etale.forget S).obj W)))
      (fun W f => FgtFF.map_injective (Over.mkIdTerminal.hom_ext _ _))

  let ιM_of (m : ℕ) :
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)) ⟶
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).obj
          (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) :=
    AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u, 0} (ZMod m)))

  let ιℤ_of (m : ℕ) :
      AddCommGrpCat.of (ULift.{u} ℤ) ⟶
        (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).obj
          (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) :=
    (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
      AddCommGrpCat.of (ULift.{u} ℤ) ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)) ≫
      (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))) ≫
        ιM_of m)

  let u₀_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).obj
          (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) ⟶
        ((CategoryTheory.sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op (T_of S))).obj
          ((U_of S m).obj (weilEtaleModuleUnit S m)) :=
    (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) AddCommGrpCat.{u}).map
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) (hT_of S)).unit.app
        (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))))

  let ηℤ_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶
        (U_of S m).obj (weilEtaleModuleUnit S m) :=
    ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
      (AddCommGrpCat.of (ULift.{u} ℤ)) ((U_of S m).obj (weilEtaleModuleUnit S m))).symm
      (ιℤ_of m ≫ u₀_of S m)

  let αM_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      weilEtaleTorsionSheaf S m ⟶ (U_of S m).obj (weilEtaleModuleUnit S m) :=
    ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
      ((U_of S m).obj (weilEtaleModuleUnit S m))).symm (ιM_of m ≫ u₀_of S m)

  have h_ηℤ_homEquiv : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
        (AddCommGrpCat.of (ULift.{u} ℤ)) ((U_of S m).obj (weilEtaleModuleUnit S m))
        (ηℤ_of S m) = ιℤ_of m ≫ u₀_of S m :=
    fun _ _ => Equiv.apply_symm_apply _ _

  have h_αM_homEquiv : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} (hT_of S)).homEquiv
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
        ((U_of S m).obj (weilEtaleModuleUnit S m))
        (αM_of S m) = ιM_of m ≫ u₀_of S m :=
    fun _ _ => Equiv.apply_symm_apply _ _

  have hβM_exists : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      ∃ βM : (U_of S m).obj (weilEtaleModuleUnit S m) ⟶ weilEtaleTorsionSheaf S m,
        αM_of S m ≫ βM = 𝟙 (weilEtaleTorsionSheaf S m) ∧
        βM ≫ αM_of S m = 𝟙 ((U_of S m).obj (weilEtaleModuleUnit S m)) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let eZ : ModuleCat.{u, 0} ℤ ≌ AddCommGrpCat.{u} :=
      (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
    let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      eZ.inverse ⋙ ModuleCat.coextendScalars (Int.castRingHom R)
    let adjModR : FgtMod ⊣ C_mod :=
      (ModuleCat.restrictCoextendScalarsAdj (Int.castRingHom R)).comp eZ.toAdjunction
    have _ : J.HasSheafCompose C_mod := hasSheafCompose_of_adj J adjModR
    let C_sh := CategoryTheory.sheafCompose J C_mod
    let eShR (ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R))
        (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        ((U_of S m).obj ℱ ⟶ 𝒢) ≃ (ℱ ⟶ C_sh.obj 𝒢) :=
      { toFun := fun φ =>
          ⟨{ app := fun W => adjModR.homEquiv (ℱ.obj.obj W) (𝒢.obj.obj W) (φ.hom.app W)
             naturality := fun {W₁ W₂} u => by
               have h1 := Adjunction.homEquiv_naturality_left adjModR (ℱ.obj.map u) (φ.hom.app W₂)
               have h2 := Adjunction.homEquiv_naturality_right adjModR (φ.hom.app W₁) (𝒢.obj.map u)
               exact h1.symm.trans ((congrArg _ (φ.hom.naturality u)).trans h2) }⟩
        invFun := fun ψ =>
          ⟨{ app := fun W => (adjModR.homEquiv (ℱ.obj.obj W) (𝒢.obj.obj W)).symm (ψ.hom.app W)
             naturality := fun {W₁ W₂} u => by
               have h1 := Adjunction.homEquiv_naturality_left_symm adjModR (ℱ.obj.map u) (ψ.hom.app W₂)
               have h2 := Adjunction.homEquiv_naturality_right_symm adjModR (ψ.hom.app W₁) (𝒢.obj.map u)
               exact h1.symm.trans ((congrArg _ (ψ.hom.naturality u)).trans h2) }⟩
        left_inv := fun φ => by
          apply sheaf_hom_eq; intro W
          exact (adjModR.homEquiv _ _).symm_apply_apply (φ.hom.app W)
        right_inv := fun ψ => by
          apply sheaf_hom_eq; intro W
          exact (adjModR.homEquiv _ _).apply_symm_apply (ψ.hom.app W) }
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let R_mod := ModuleCat.of R R
    let FM := weilEtaleTorsionSheaf S m
    let oneR := weilEtaleModuleUnit S m
    let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} (hT_of S)
    let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) (hT_of S)
    let ιM : AM ⟶ FgtMod.obj R_mod := ιM_of m
    let ιM_inv : FgtMod.obj R_mod ⟶ AM := AddCommGrpCat.ofHom (AddMonoidHom.id R)
    have hιM_1 : ιM ≫ ιM_inv = 𝟙 AM := by ext ⟨x⟩; rfl
    have hιM_2 : ιM_inv ≫ ιM = 𝟙 (FgtMod.obj R_mod) := by ext ⟨x⟩; rfl
    let evMod (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        (R_mod ⟶ ((sheafSections J (ModuleCat.{u, u} R)).obj (Opposite.op (T_of S))).obj (C_sh.obj 𝒢)) ≃
          (FgtMod.obj R_mod ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) :=
      (adjModR.homEquiv R_mod (𝒢.obj.obj (Opposite.op (T_of S)))).symm
    let preEqv (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        (FgtMod.obj R_mod ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) ≃
          (AM ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj 𝒢) :=
      { toFun := fun f => ιM ≫ f
        invFun := fun g => ιM_inv ≫ g
        left_inv := fun f => by dsimp only; rw [← Category.assoc, hιM_2, Category.id_comp]
        right_inv := fun g => by dsimp only; rw [← Category.assoc, hιM_1, Category.id_comp] }
    let eHom (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) :
        ((U_of S m).obj oneR ⟶ 𝒢) ≃ (FM ⟶ 𝒢) :=
      (eShR oneR 𝒢).trans
        ((adjR.homEquiv R_mod (C_sh.obj 𝒢)).trans
          ((evMod 𝒢).trans ((preEqv 𝒢).trans (adjℤ.homEquiv AM 𝒢).symm)))
    have heHom_apply : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (φ : (U_of S m).obj oneR ⟶ 𝒢), eHom 𝒢 φ = αM_of S m ≫ φ := by
      intro 𝒢 φ
      change (adjℤ.homEquiv AM 𝒢).symm
          (ιM_of m ≫ (evMod 𝒢) ((adjR.homEquiv R_mod (C_sh.obj 𝒢)) ((eShR oneR 𝒢) φ))) =
        αM_of S m ≫ φ
      apply (adjℤ.homEquiv AM 𝒢).injective
      rw [Equiv.apply_symm_apply, Adjunction.homEquiv_naturality_right adjℤ (αM_of S m) φ,
        h_αM_homEquiv, Category.assoc]
      congr 1
      apply (evMod 𝒢).symm.injective
      rw [Equiv.symm_apply_apply]
      change adjR.homEquiv R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ) =
        adjModR.homEquiv R_mod (𝒢.obj.obj (Opposite.op (T_of S)))
          (FgtMod.map (adjR.unit.app R_mod) ≫ φ.hom.app (Opposite.op (T_of S)))
      have h_adjR : adjR.homEquiv R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ) =
          adjR.unit.app R_mod ≫
            adjModR.homEquiv (oneR.obj.obj (Opposite.op (T_of S)))
              (𝒢.obj.obj (Opposite.op (T_of S))) (φ.hom.app (Opposite.op (T_of S))) :=
        Adjunction.homEquiv_unit adjR R_mod (C_sh.obj 𝒢) (eShR oneR 𝒢 φ)
      have h_nat_mod : adjR.unit.app R_mod ≫
          adjModR.homEquiv (oneR.obj.obj (Opposite.op (T_of S)))
            (𝒢.obj.obj (Opposite.op (T_of S))) (φ.hom.app (Opposite.op (T_of S))) =
          adjModR.homEquiv R_mod (𝒢.obj.obj (Opposite.op (T_of S)))
            (FgtMod.map (adjR.unit.app R_mod) ≫ φ.hom.app (Opposite.op (T_of S))) :=
        (Adjunction.homEquiv_naturality_left adjModR
          (adjR.unit.app R_mod) (φ.hom.app (Opposite.op (T_of S)))).symm
      exact h_adjR.trans h_nat_mod
    let βM : (U_of S m).obj oneR ⟶ FM := (eHom FM).symm (𝟙 FM)
    have hαβ : αM_of S m ≫ βM = 𝟙 FM := by
      rw [← heHom_apply FM βM]
      exact (eHom FM).apply_symm_apply (𝟙 FM)
    have hβα : βM ≫ αM_of S m = 𝟙 ((U_of S m).obj oneR) := by
      apply (eHom ((U_of S m).obj oneR)).injective
      rw [heHom_apply, heHom_apply, Category.comp_id, ← Category.assoc, hαβ, Category.id_comp]
    exact ⟨βM, hαβ, hβα⟩

  let βM_of (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
      (U_of S m).obj (weilEtaleModuleUnit S m) ⟶ weilEtaleTorsionSheaf S m :=
    Classical.choose (hβM_exists S m)

  have hαβ_of : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      αM_of S m ≫ βM_of S m = 𝟙 (weilEtaleTorsionSheaf S m) :=
    fun S m => (Classical.choose_spec (hβM_exists S m)).1

  have hβα_of : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      βM_of S m ≫ αM_of S m = 𝟙 ((U_of S m).obj (weilEtaleModuleUnit S m)) :=
    fun S m => (Classical.choose_spec (hβM_exists S m)).2

  let θ_of (S : AlgebraicGeometry.Scheme.{u}) (m k : ℕ) :
      weilEtaleModuleH S m k →+ weilEtaleTorsionH S m k :=
    let _ := hAdd_U S m
    let _ := (hLim_U S m).1
    let _ := (hLim_U S m).2
    let _ := hExtMod S m
    let _ := hExtAb S
    ((Abelian.Ext.mk₀ (βM_of S m)).postcomp
        ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero k)).comp
      (((Abelian.Ext.mk₀ (ηℤ_of S m)).precomp
          ((U_of S m).obj (weilEtaleModuleUnit S m)) (Nat.zero_add k)).comp
        ((U_of S m).mapExtAddHom (weilEtaleModuleUnit S m) (weilEtaleModuleUnit S m) k))

  have hθ_of_apply : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m k : ℕ)
      (x : weilEtaleModuleH S m k),
      let _ := hAdd_U S m
      let _ := (hLim_U S m).1
      let _ := (hLim_U S m).2
      let _ := hExtMod S m
      let _ := hExtAb S
      θ_of S m k x =
        ((Abelian.Ext.mk₀ (ηℤ_of S m)).comp
          (Abelian.Ext.mapExactFunctor (U_of S m) x) (Nat.zero_add k)).comp
          (Abelian.Ext.mk₀ (βM_of S m)) (Nat.add_zero k) := by
    intro S m k x
    let _ := hAdd_U S m
    let _ := (hLim_U S m).1
    let _ := (hLim_U S m).2
    let _ := hExtMod S m
    let _ := hExtAb S
    let p₁ := (Abelian.Ext.mk₀ (βM_of S m)).postcomp
      ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero k)
    let p₂ := (Abelian.Ext.mk₀ (ηℤ_of S m)).precomp
      ((U_of S m).obj (weilEtaleModuleUnit S m)) (Nat.zero_add k)
    let p₃ := (U_of S m).mapExtAddHom (weilEtaleModuleUnit S m) (weilEtaleModuleUnit S m) k
    have h0 : θ_of S m k x = p₁ (p₂ (p₃ x)) := rfl
    exact h0.trans ((ext_postcomp_apply _ _ _).trans
      (congrArg (fun z => z.comp (Abelian.Ext.mk₀ (βM_of S m)) (Nat.add_zero k))
        ((ext_precomp_apply _ _ _).trans
          (congrArg (fun w => (Abelian.Ext.mk₀ (ηℤ_of S m)).comp w (Nat.zero_add k))
            (mapExtAddHom_apply _ _ _ _ _)))))

  have hθ_of_valid : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m k : ℕ),
      WeilIsModuleToTorsionComparison S m k (θ_of S m k) := by
    intro S m k
    exact ⟨U_of S m, fun _ => rfl, fun _ _ => HEq.rfl, hAdd_U S m, (hLim_U S m).1, (hLim_U S m).2,
      T_of S, hT_of S, rfl, HEq.rfl, u₀_of S m, HEq.rfl, βM_of S m, hαβ_of S m, hβα_of S m,
      fun _ => rfl⟩

  have hθ_of_uniq : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m k : ℕ)
      (θ : weilEtaleModuleH S m k →+ weilEtaleTorsionH S m k),
      WeilIsModuleToTorsionComparison S m k θ → θ = θ_of S m k := by
    intro S m k θ hθ
    rcases hθ with ⟨U₁, hU₁_obj, hU₁_map, hAdd₁, hLim₁, hColim₁, T₁, hT₁, hT₁_l, hT₁_h,
      u₁, hu₁, β₁, hαβ₁, hβα₁, hθ_eq⟩
    have hU_eq : U₁ = U_of S m := by
      have hmap := @hU₁_map
      rcases U₁ with ⟨o₁, m₁, i₁, c₁⟩
      have ho : o₁ = (U_of S m).obj := funext fun ℱ => sheaf_eq_of_obj_eq (hU₁_obj ℱ)
      subst ho
      refine CategoryTheory.Functor.ext (fun _ => rfl) (fun ℱ₁ ℱ₂ f => ?_)
      rw [eqToHom_refl, eqToHom_refl, Category.id_comp, Category.comp_id]
      apply sheaf_hom_eq; intro W
      exact eq_of_heq (hmap f W)
    subst hU_eq
    have : hAdd₁ = hAdd_U S m := Subsingleton.elim _ _; subst this
    have : hLim₁ = (hLim_U S m).1 := Subsingleton.elim _ _; subst this
    have : hColim₁ = (hLim_U S m).2 := Subsingleton.elim _ _; subst this
    have hT_eq : T₁ = T_of S := etale_obj_eq S T₁ (T_of S) hT₁_l hT₁_h
    subst hT_eq
    have : hT₁ = hT_of S := Subsingleton.elim _ _; subst this
    have hu_eq : u₁ = u₀_of S m := eq_of_heq hu₁
    subst hu_eq
    have hβ_eq : β₁ = βM_of S m := by
      calc
        β₁ = β₁ ≫ 𝟙 (weilEtaleTorsionSheaf S m) := (Category.comp_id β₁).symm
        _ = β₁ ≫ (αM_of S m ≫ βM_of S m) := by rw [hαβ_of S m]
        _ = (β₁ ≫ αM_of S m) ≫ βM_of S m := (Category.assoc _ _ _).symm
        _ = 𝟙 _ ≫ βM_of S m := by erw [hβα₁]
        _ = βM_of S m := Category.id_comp _
    subst hβ_eq
    ext x
    exact hθ_eq x

  
  have hGenBij : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m k : ℕ)
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))),
      let _ := hAdd_U S m
      let _ := (hLim_U S m).1
      let _ := (hLim_U S m).2
      let _ := hExtMod S m
      let _ := hExtAb S
      Function.Bijective (fun x : Abelian.Ext (weilEtaleModuleUnit S m) ℱ k =>
        (Abelian.Ext.mk₀ (ηℤ_of S m)).comp
          (Abelian.Ext.mapExactFunctor (U_of S m) x) (Nat.zero_add k)) := by
    intro S m
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m
    have _ := hAdd_U S m
    have _ := (hLim_U S m).1
    have _ := (hLim_U S m).2
    have _ : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) := inferInstance
    have _ : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    have _ := hExtMod S m
    have _ := hExtAb S
    have _ : EnoughInjectives (CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) := inferInstance
    have _ : EnoughInjectives (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let R_mod := ModuleCat.of R R
    let Cℤ := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ := Cℤ.obj Aℤ
    let oneR := weilEtaleModuleUnit S m
    let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} (hT_of S)
    let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) (hT_of S)
    
    have hBase : ∀ ℱ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
        Function.Bijective (fun x : Abelian.Ext oneR ℱ 0 =>
          (Abelian.Ext.mk₀ (ηℤ_of S m)).comp
            (Abelian.Ext.mapExactFunctor (U_of S m) x) (Nat.zero_add 0)) := by
      intro ℱ
      let A : ModuleCat.{u, u} R := ℱ.obj.obj (Opposite.op (T_of S))
      let eR : (R_mod ⟶ A) ≃ A :=
        { toFun := fun ψ => ψ (1 : R)
          invFun := fun a => ModuleCat.ofHom (LinearMap.toSpanSingleton R A a)
          left_inv := fun ψ => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro r
            change r • ψ (1 : R) = ψ r
            rw [← map_smul, smul_eq_mul, mul_one]
          right_inv := fun a => one_smul R a }
      let eℤ : (Aℤ ⟶ FgtMod.obj A) ≃ A :=
        { toFun := fun g => g (ULift.up (1 : ℤ))
          invFun := fun a => AddCommGrpCat.ofHom
            { toFun := fun z => z.down • a
              map_zero' := zero_smul ℤ a
              map_add' := fun z₁ z₂ => add_smul z₁.down z₂.down a }
          left_inv := fun g => by
            ext ⟨z⟩
            change z • g (ULift.up (1 : ℤ)) = g (ULift.up z)
            rw [← map_zsmul]
            congr 1
            ext
            exact mul_one z
          right_inv := fun a => one_smul ℤ a }
      let eℤ' : (Aℤ ⟶ ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).obj
          ((U_of S m).obj ℱ)) ≃ A := eℤ
      have h_hom_bij : Function.Bijective (fun φ : oneR ⟶ ℱ => ηℤ_of S m ≫ (U_of S m).map φ) := by
        let eqDom : (oneR ⟶ ℱ) ≃ A := (adjR.homEquiv R_mod ℱ).trans eR
        let eqCod : (Fℤ ⟶ (U_of S m).obj ℱ) ≃ A :=
          (adjℤ.homEquiv Aℤ ((U_of S m).obj ℱ)).trans eℤ'
        have h_comm : ∀ φ : oneR ⟶ ℱ, eqCod (ηℤ_of S m ≫ (U_of S m).map φ) = eqDom φ := by
          intro φ
          change eℤ' ((adjℤ.homEquiv Aℤ ((U_of S m).obj ℱ)) (ηℤ_of S m ≫ (U_of S m).map φ)) =
            eR ((adjR.homEquiv R_mod ℱ) φ)
          rw [Adjunction.homEquiv_naturality_right adjℤ (ηℤ_of S m) ((U_of S m).map φ),
            h_ηℤ_homEquiv]
          have h_adjR : adjR.homEquiv R_mod ℱ φ =
              adjR.unit.app R_mod ≫ φ.hom.app (Opposite.op (T_of S)) :=
            Adjunction.homEquiv_unit adjR R_mod ℱ φ
          have h_rhs : ιℤ_of m ≫ (FgtMod.map (adjR.unit.app R_mod) ≫
              FgtMod.map (φ.hom.app (Opposite.op (T_of S)))) =
              ιℤ_of m ≫ FgtMod.map (adjR.homEquiv R_mod ℱ φ) := by
            rw [← FgtMod.map_comp, h_adjR]
          have h_ev : eℤ' ((ιℤ_of m ≫ u₀_of S m) ≫
              ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).map ((U_of S m).map φ)) =
              eℤ (ιℤ_of m ≫ FgtMod.map (adjR.homEquiv R_mod ℱ φ)) :=
            congrArg eℤ ((Category.assoc _ _ _).trans h_rhs)
          rw [h_ev]
          change (adjR.homEquiv R_mod ℱ φ) (ιℤ_of m (ULift.up (1 : ℤ))) =
            (adjR.homEquiv R_mod ℱ φ) (1 : R)
          congr 1
          ext
          exact Int.cast_one
        have h_fn : (fun φ : oneR ⟶ ℱ => ηℤ_of S m ≫ (U_of S m).map φ) =
            (eqCod.symm ∘ eqDom) := by
          funext φ
          exact eqCod.injective (by rw [Function.comp_apply, Equiv.apply_symm_apply, h_comm])
        rw [h_fn]
        exact eqCod.symm.bijective.comp eqDom.bijective
      let mk0Dom : (oneR ⟶ ℱ) ≃ Abelian.Ext oneR ℱ 0 :=
        Equiv.ofBijective Abelian.Ext.mk₀ (Abelian.Ext.mk₀_bijective oneR ℱ)
      let mk0Cod : (Fℤ ⟶ (U_of S m).obj ℱ) ≃ Abelian.Ext Fℤ ((U_of S m).obj ℱ) 0 :=
        Equiv.ofBijective Abelian.Ext.mk₀ (Abelian.Ext.mk₀_bijective Fℤ ((U_of S m).obj ℱ))
      have h_ext0 : (fun x : Abelian.Ext oneR ℱ 0 =>
          (Abelian.Ext.mk₀ (ηℤ_of S m)).comp
            (Abelian.Ext.mapExactFunctor (U_of S m) x) (Nat.zero_add 0)) =
          (mk0Cod ∘ (fun φ => ηℤ_of S m ≫ (U_of S m).map φ) ∘ mk0Dom.symm) := by
        funext x
        obtain ⟨φ, rfl⟩ := mk0Dom.surjective x
        have hsymm : mk0Dom.symm (mk0Dom φ) = φ := mk0Dom.symm_apply_apply φ
        dsimp only [Function.comp_apply]
        rw [hsymm]
        change (Abelian.Ext.mk₀ (ηℤ_of S m)).comp
            (Abelian.Ext.mapExactFunctor (U_of S m) (Abelian.Ext.mk₀ φ)) (Nat.zero_add 0) =
          Abelian.Ext.mk₀ (ηℤ_of S m ≫ (U_of S m).map φ)
        rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      rw [h_ext0]
      exact mk0Cod.bijective.comp (h_hom_bij.comp mk0Dom.symm.bijective)

    
    let isTF_cat {C : Type (u + 1)} [Category.{u + 1} C] [Preadditive C] (K : C) : Prop :=
      ∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 K)
    have isTF_sub : ∀ {C : Type (u + 1)} [Category.{u + 1} C] [Preadditive C] {K' P : C}
        (ι : K' ⟶ P) [Mono ι], isTF_cat P → isTF_cat K' := by
      intro C _ _ K' P ι _ hP n hn
      have _ : Mono (n • 𝟙 P) := hP n hn
      have hcomm : (n • 𝟙 K') ≫ ι = ι ≫ (n • 𝟙 P) := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
      have _ : Mono ((n • 𝟙 K') ≫ ι) := by
        rw [hcomm]
        exact mono_comp ι (n • 𝟙 P)
      exact mono_of_mono (n • 𝟙 K') ι
    have isTF_map : ∀ {A B : Type (u + 1)} [Category.{u + 1} A] [Preadditive A]
        [Category.{u + 1} B] [Preadditive B] (F : A ⥤ B) [F.Additive]
        [Limits.PreservesFiniteLimits F] {K : A}, isTF_cat K → isTF_cat (F.obj K) := by
      intro A B _ _ _ _ F _ _ K hK n hn
      have _ : Mono (n • 𝟙 K) := hK n hn
      have hmap : F.map (n • 𝟙 K) = n • 𝟙 (F.obj K) := by
        rw [F.map_nsmul, F.map_id]
      rw [← hmap]
      exact F.map_mono (n • 𝟙 K)
    have hasColimOfGroth : ∀ (C : Type (u + 1)) [Category.{u + 1} C] [Abelian C]
        [IsGrothendieckAbelian.{u} C],
        Limits.HasColimitsOfSize.{0, u} C ∧ Limits.HasColimitsOfSize.{u, u} C ∧
          LocallySmall.{u} C :=
      fun C _ _ _ => ⟨Limits.hasColimitsOfSizeShrink C, Limits.hasColimitsOfSizeShrink C,
        inferInstance⟩
    let sigmaObjU {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} (X : ι → C) : C :=
      Limits.sigmaObj X
    let sigmaDesc {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} {X : ι → C} {Z : C} (c : ∀ i, X i ⟶ Z) : sigmaObjU X ⟶ Z :=
      Limits.Sigma.desc c
    let sigmaIota {C : Type (u + 1)} [Category.{u + 1} C] [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} (X : ι → C) (i : ι) : X i ⟶ sigmaObjU X :=
      Limits.Sigma.ι X i
    have sigmaIotaDesc : ∀ {C : Type (u + 1)} [Category.{u + 1} C]
        [Limits.HasColimitsOfSize.{u, u} C] {ι : Type u} {X : ι → C} {Z : C}
        (c : ∀ i, X i ⟶ Z) (i : ι), sigmaIota X i ≫ sigmaDesc c = c i :=
      fun c i => Limits.Sigma.ι_comp_desc c i
    have isTF_sigma : ∀ {C : Type (u + 1)} [Category.{u + 1} C] [Abelian C]
        [IsGrothendieckAbelian.{u} C] [Limits.HasColimitsOfSize.{0, u} C]
        [Limits.HasColimitsOfSize.{u, u} C]
        {ι : Type u} (X : ι → C), (∀ i : ι, isTF_cat (X i)) → isTF_cat (sigmaObjU X) := by
      intro C _ _ _ _ _ ι X hX n hn
      have _ : AB4OfSize.{u} C := AB4OfSize_shrink C
      have _ : HasExactColimitsOfShape (Discrete ι) C := AB4OfSize.ofShape ι
      let D : Discrete ι ⥤ C := Discrete.functor X
      let φ : D ⟶ D := n • 𝟙 D
      have _ : ∀ j : Discrete ι, Mono (φ.app j) := fun ⟨i⟩ => hX i n hn
      have _ : Mono φ := NatTrans.mono_of_mono_app φ
      exact Limits.colim.map_mono' φ (Limits.colimit.isColimit D) (Limits.colimit.isColimit D)
        (n • 𝟙 (sigmaObjU X)) (fun ⟨i⟩ => by
          change sigmaIota X i ≫ (n • 𝟙 (sigmaObjU X)) =
            (n • 𝟙 (X i)) ≫ sigmaIota X i
          rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
    have hMono_Aℤ : ∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 Aℤ) := by
      intro n hn
      rw [AddCommGrpCat.mono_iff_injective]
      intro ⟨x⟩ ⟨y⟩ hxy
      have h' : (n : ℤ) * x = (n : ℤ) * y := by
        have hd := congrArg ULift.down hxy
        change n • x = n • y at hd
        rwa [nsmul_eq_mul, nsmul_eq_mul] at hd
      exact congrArg ULift.up (mul_left_cancel₀ (Nat.cast_ne_zero.mpr hn) h')
    have hTF_Fℤ : isTF_cat Fℤ := by
      intro n hn
      have _ : Mono (n • 𝟙 Aℤ) := hMono_Aℤ n hn
      let C_unf : AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
        (CategoryTheory.Functor.const (S.Etale)ᵒᵖ) ⋙
          CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
      have _ : Limits.PreservesFiniteLimits C_unf :=
        Limits.comp_preservesFiniteLimits _ _
      have hmap : C_unf.map (n • 𝟙 Aℤ) = n • 𝟙 Fℤ := by
        rw [C_unf.map_nsmul, C_unf.map_id]
        rfl
      rw [← hmap]
      exact C_unf.map_mono (n • 𝟙 Aℤ)
    have hCover : ∀ ℰ : CategoryTheory.Sheaf J AddCommGrpCat.{u},
        ∃ (P : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (q : P ⟶ ℰ),
          isTF_cat P ∧ Epi q := by
      let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S
      have _ : IsGrothendieckAbelian.{u} (CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}) :=
        inferInstance
      obtain ⟨hColim0_aff, hColimU_aff, _⟩ :=
        hasColimOfGroth (CategoryTheory.Sheaf J_aff AddCommGrpCat.{u})
      obtain ⟨hColim0_J, hColimU_J, hLocSmall_J⟩ :=
        hasColimOfGroth (CategoryTheory.Sheaf J AddCommGrpCat.{u})
      have _ := hColim0_aff; have _ := hColimU_aff
      have _ := hColim0_J; have _ := hColimU_J; have _ := hLocSmall_J
      have hMono_sigma_Aℤ : ∀ (ι : Type u) (n : ℕ), n ≠ 0 →
          Mono (n • 𝟙 (Limits.sigmaObj (fun _ : ι => Aℤ))) := by
        intro ι n hn
        have _ : AB4OfSize.{u} AddCommGrpCat.{u} := inferInstance
        have _ : HasExactColimitsOfShape (Discrete ι) AddCommGrpCat.{u} := AB4OfSize.ofShape ι
        let D : Discrete ι ⥤ AddCommGrpCat.{u} := Discrete.functor (fun _ : ι => Aℤ)
        let φ : D ⟶ D := n • 𝟙 D
        have _ : ∀ j : Discrete ι, Mono (φ.app j) := fun ⟨_⟩ => hMono_Aℤ n hn
        have _ : Mono φ := NatTrans.mono_of_mono_app φ
        exact Limits.colim.map_mono' φ (Limits.colimit.isColimit D) (Limits.colimit.isColimit D)
          (n • 𝟙 (Limits.sigmaObj (fun _ : ι => Aℤ))) (fun ⟨i⟩ => by
            change Limits.Sigma.ι (fun _ : ι => Aℤ) i ≫ (n • 𝟙 _) =
              (n • 𝟙 Aℤ) ≫ Limits.Sigma.ι (fun _ : ι => Aℤ) i
            rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
      have hTF_free : ∀ W : S.AffineEtale,
          isTF_cat (CategoryTheory.Sheaf.freeYoneda J_aff W Aℤ) := by
        intro W
        apply isTF_map (CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u})
        intro n hn
        have _ : ∀ V : (S.AffineEtale)ᵒᵖ,
            Mono ((n • 𝟙 (CategoryTheory.Presheaf.freeYoneda W Aℤ)).app V) := by
          intro V
          change Mono (n • 𝟙 ((CategoryTheory.Presheaf.freeYoneda W Aℤ).obj V))
          exact hMono_sigma_Aℤ _ n hn
        exact NatTrans.mono_of_mono_app _
      let C₀ := SmallModel.{u} S.AffineEtale
      let eAff : S.AffineEtale ≌ C₀ := equivSmallModel S.AffineEtale
      let Y : C₀ → CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} :=
        fun x => CategoryTheory.Sheaf.freeYoneda J_aff (eAff.inverse.obj x) Aℤ
      let G₀ : CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} := sigmaObjU Y
      have hTF₀ : isTF_cat G₀ := isTF_sigma Y (fun x => hTF_free (eAff.inverse.obj x))
      have hSep₀ : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_aff AddCommGrpCat.{u}}
          (f₁ f₂ : ℱ₁ ⟶ ℱ₂), (∀ h : G₀ ⟶ ℱ₁, h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
        intro ℱ₁ ℱ₂ f₁ f₂ h_eq
        ext V a
        let U : S.AffineEtale := V.unop
        let x : C₀ := eAff.functor.obj U
        let isoU : U ≅ eAff.inverse.obj x := eAff.unitIso.app U
        let a' : ℱ₁.obj.obj (Opposite.op (eAff.inverse.obj x)) :=
          ℱ₁.obj.map (Opposite.op isoU.inv) a
        let α₀ : Aℤ ⟶ ℱ₁.obj.obj (Opposite.op (eAff.inverse.obj x)) :=
          AddCommGrpCat.ofHom
            { toFun := fun z => z.down • a'
              map_zero' := zero_smul ℤ a'
              map_add' := fun z₁ z₂ => add_smul z₁.down z₂.down a' }
        let α : Y x ⟶ ℱ₁ := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm α₀
        classical
        let h_proj : G₀ ⟶ ℱ₁ :=
          sigmaDesc (X := Y) fun y => if hy : y = x then eqToHom (congrArg Y hy) ≫ α else 0
        have h_ι : sigmaIota Y x ≫ h_proj = α := by
          dsimp only [h_proj]
          rw [sigmaIotaDesc]
          split_ifs with h
          · exact Category.id_comp α
          · exact (h rfl).elim
        have hα_eq : α ≫ f₁ = α ≫ f₂ := by
          rw [← h_ι, Category.assoc, Category.assoc, h_eq h_proj]
        have h_ev : ∀ (g : ℱ₁ ⟶ ℱ₂),
            CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
              α₀ ≫ g.hom.app (Opposite.op (eAff.inverse.obj x)) := by
          intro g
          let adjSh := CategoryTheory.sheafificationAdjunction J_aff AddCommGrpCat.{u}
          let PF := CategoryTheory.Presheaf.freeYoneda (eAff.inverse.obj x) Aℤ
          let α' : (CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}).obj PF ⟶ ℱ₁ := α
          have h1 : adjSh.homEquiv PF ℱ₂ (α' ≫ g) =
              CategoryTheory.Presheaf.freeYonedaHomEquiv.symm α₀ ≫ g.hom := by
            rw [Adjunction.homEquiv_naturality_right adjSh α' g]
            change adjSh.homEquiv PF ℱ₁
                ((adjSh.homEquiv PF ℱ₁).symm
                  (CategoryTheory.Presheaf.freeYonedaHomEquiv.symm α₀)) ≫
                g.hom = _
            rw [Equiv.apply_symm_apply]
          change CategoryTheory.Presheaf.freeYonedaHomEquiv (adjSh.homEquiv PF ℱ₂ (α' ≫ g)) = _
          rw [h1, CategoryTheory.Presheaf.freeYonedaHomEquiv_symm_comp, Equiv.apply_symm_apply]
        have h_app_x := congrArg (fun k => k (ULift.up (1 : ℤ)))
          ((h_ev f₁).symm.trans
            (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv hα_eq |>.trans (h_ev f₂)))
        change f₁.hom.app (Opposite.op (eAff.inverse.obj x)) ((1 : ℤ) • a') =
          f₂.hom.app (Opposite.op (eAff.inverse.obj x)) ((1 : ℤ) • a') at h_app_x
        rw [one_smul ℤ] at h_app_x
        have ha_id : ℱ₁.obj.map (Opposite.op isoU.hom) a' = a := by
          dsimp [a']
          have hop : Opposite.op isoU.inv ≫ Opposite.op isoU.hom = 𝟙 V := by
            change Opposite.op (isoU.hom ≫ isoU.inv) = Opposite.op (𝟙 U)
            rw [Iso.hom_inv_id]
          rw [← Functor.map_comp_apply, hop, Functor.map_id_apply]
        have hf1_eq : (ℱ₂.obj.map (Opposite.op isoU.hom))
            (f₁.hom.app (Opposite.op (eAff.inverse.obj x)) a') = f₁.hom.app V a := by
          change (f₁.hom.app (Opposite.op (eAff.inverse.obj x)) ≫
            ℱ₂.obj.map (Opposite.op isoU.hom)) a' = f₁.hom.app V a
          rw [← f₁.hom.naturality (Opposite.op isoU.hom)]
          change f₁.hom.app V (ℱ₁.obj.map (Opposite.op isoU.hom) a') = f₁.hom.app V a
          rw [ha_id]
        have hf2_eq : (ℱ₂.obj.map (Opposite.op isoU.hom))
            (f₂.hom.app (Opposite.op (eAff.inverse.obj x)) a') = f₂.hom.app V a := by
          change (f₂.hom.app (Opposite.op (eAff.inverse.obj x)) ≫
            ℱ₂.obj.map (Opposite.op isoU.hom)) a' = f₂.hom.app V a
          rw [← f₂.hom.naturality (Opposite.op isoU.hom)]
          change f₂.hom.app V (ℱ₁.obj.map (Opposite.op isoU.hom) a') = f₂.hom.app V a
          rw [ha_id]
        rw [← hf1_eq, ← hf2_eq, h_app_x]
      let E := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
      have _ : E.functor.Additive := E.functor.additive_of_preserves_binary_products
      let G_tf := E.functor.obj G₀
      have hTF_tf : isTF_cat G_tf := isTF_map E.functor hTF₀
      have hSep_tf : ∀ {X₁ X₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
          (f₁ f₂ : X₁ ⟶ X₂), (∀ h : G_tf ⟶ X₁, h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
        intro X₁ X₂ f₁ f₂ h_eq
        refine E.inverse.map_injective (hSep₀ _ _ fun k => ?_)
        have hk := h_eq (E.functor.map k ≫ E.counitIso.hom.app X₁)
        have hnat₁ := E.counitIso.hom.naturality f₁
        have hnat₂ := E.counitIso.hom.naturality f₂
        dsimp at hnat₁ hnat₂
        have hk' : E.functor.map (k ≫ E.inverse.map f₁) ≫ E.counitIso.hom.app X₂ =
            E.functor.map (k ≫ E.inverse.map f₂) ≫ E.counitIso.hom.app X₂ := by
          rw [Functor.map_comp, Functor.map_comp, Category.assoc, Category.assoc, hnat₁, hnat₂,
            ← Category.assoc, ← Category.assoc, hk]
        exact E.functor.map_injective ((cancel_mono (E.counitIso.hom.app X₂)).mp hk')
      intro ℰ
      have _ : Small.{u} (G_tf ⟶ ℰ) := LocallySmall.hom_small G_tf ℰ
      let Idx : Type u := Shrink.{u} (G_tf ⟶ ℰ)
      let P : CategoryTheory.Sheaf J AddCommGrpCat.{u} := sigmaObjU (fun _ : Idx => G_tf)
      let q : P ⟶ ℰ := sigmaDesc (X := fun _ : Idx => G_tf)
        (fun i : Idx => (equivShrink (G_tf ⟶ ℰ)).symm i)
      refine ⟨P, q, isTF_sigma (fun _ : Idx => G_tf) (fun _ => hTF_tf), ?_⟩
      refine ⟨fun {Z} f₁ f₂ hqf => hSep_tf f₁ f₂ fun h => ?_⟩
      have hi : sigmaIota (fun _ : Idx => G_tf) (equivShrink (G_tf ⟶ ℰ) h) ≫ q = h :=
        (sigmaIotaDesc (X := fun _ : Idx => G_tf)
          (fun i : Idx => (equivShrink (G_tf ⟶ ℰ)).symm i) (equivShrink (G_tf ⟶ ℰ) h)).trans
          (Equiv.symm_apply_apply _ h)
      rw [← hi, Category.assoc, Category.assoc, hqf]

    
    have hLiftModHom : ∀ {M N : ModuleCat.{u, u} R} (g : FgtMod.obj M ⟶ FgtMod.obj N),
        ∃ f : M ⟶ N, FgtMod.map f = g := by
      intro M N g
      refine ⟨ModuleCat.ofHom
        { toFun := g.hom.toFun
          map_add' := g.hom.map_add'
          map_smul' := fun r x => by
            obtain ⟨z, hz⟩ := ZMod.intCast_surjective r.down
            have hzr : (z : R) = r := by ext; exact hz
            simp only [RingHom.id_apply, ← hzr]
            rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
            exact map_zsmul g.hom z x }, ?_⟩
      ext x; rfl
    have hFgtInj : ∀ {M N : ModuleCat.{u, u} R} {f₁ f₂ : M ⟶ N},
        FgtMod.map f₁ = FgtMod.map f₂ → f₁ = f₂ := by
      intro M N f₁ f₂ h; ext x; exact congrArg (fun k => k x) h
    have hUFull : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)}
        (φ : (U_of S m).obj ℱ₁ ⟶ (U_of S m).obj ℱ₂),
        ∃ ψ : ℱ₁ ⟶ ℱ₂, (U_of S m).map ψ = φ := by
      intro ℱ₁ ℱ₂ φ
      choose appL happL using fun W => hLiftModHom (φ.hom.app W)
      refine ⟨⟨{ app := appL
                 naturality := fun {W₁ W₂} u => by
                   apply hFgtInj
                   rw [FgtMod.map_comp, FgtMod.map_comp, happL W₁, happL W₂]
                   exact φ.hom.naturality u }⟩, ?_⟩
      ext W x; exact congrArg (fun k => k x) (happL W)
    have hUFaith : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)} {ψ₁ ψ₂ : ℱ₁ ⟶ ℱ₂},
        (U_of S m).map ψ₁ = (U_of S m).map ψ₂ → ψ₁ = ψ₂ := by
      intro ℱ₁ ℱ₂ ψ₁ ψ₂ h; ext W x; exact congrArg (fun k => k.hom.app W x) h
    have hLiftSheaf : ∀ (ℬ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        m • 𝟙 ℬ = 0 → ∃ ℬ_mod : CategoryTheory.Sheaf J (ModuleCat.{u, u} R),
          (U_of S m).obj ℬ_mod = ℬ := by
      intro ℬ hm
      let downHom : R →+* ZMod m :=
        { toFun := ULift.down
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      let objMod (W : (S.Etale)ᵒᵖ) : ModuleCat.{u, u} R :=
        let hmW : ∀ x : ℬ.obj.obj W, m • x = 0 := fun x => by
          change ((m • 𝟙 ℬ).hom.app W) x = 0
          rw [hm]; rfl
        letI : Module (ZMod m) (ℬ.obj.obj W) := AddCommGroup.zmodModule hmW
        letI : Module R (ℬ.obj.obj W) := Module.compHom (ℬ.obj.obj W) downHom
        ModuleCat.of R (ℬ.obj.obj W)
      choose mapMod hmapMod using fun {W₁ W₂ : (S.Etale)ᵒᵖ} (u : W₁ ⟶ W₂) =>
        hLiftModHom (M := objMod W₁) (N := objMod W₂) (ℬ.obj.map u)
      let P_mod : (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
        { obj := objMod
          map := fun u => mapMod u
          map_id := fun W => hFgtInj (by rw [hmapMod, FgtMod.map_id]; exact ℬ.obj.map_id W)
          map_comp := fun u v => hFgtInj (by
            rw [hmapMod, FgtMod.map_comp, hmapMod, hmapMod]; exact ℬ.obj.map_comp u v) }
      have hP_comp : P_mod ⋙ FgtMod = ℬ.obj := by
        refine CategoryTheory.Functor.ext (fun _ => rfl) (fun _ _ u => ?_)
        dsimp; rw [Category.id_comp, Category.comp_id]; exact hmapMod u
      have hIsSheaf : Presheaf.IsSheaf J P_mod := by
        intro E
        let eqvW (W : (S.Etale)ᵒᵖ) : (E ⟶ objMod W) ≃ (FgtMod.obj E ⟶ ℬ.obj.obj W) :=
          { toFun := fun f => FgtMod.map f
            invFun := fun g => Classical.choose (hLiftModHom (M := E) (N := objMod W) g)
            left_inv := fun f => hFgtInj (Classical.choose_spec
              (hLiftModHom (M := E) (N := objMod W) (FgtMod.map f)))
            right_inv := fun g => Classical.choose_spec
              (hLiftModHom (M := E) (N := objMod W) g) }
        let isoE : P_mod ⋙ coyoneda.obj (Opposite.op E) ≅
            ℬ.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E)) :=
          NatIso.ofComponents (fun W => (eqvW W).toIso) (fun {W₁ W₂} u => by
            ext f
            change FgtMod.map (f ≫ mapMod u) = FgtMod.map f ≫ ℬ.obj.map u
            rw [FgtMod.map_comp, hmapMod])
        exact Presieve.isSheaf_iso J isoE.symm (ℬ.property (FgtMod.obj E))
      exact ⟨⟨P_mod, hIsSheaf⟩, sheaf_eq_of_obj_eq hP_comp⟩
    have hExtend : ∀ (ℐ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) [Injective ℐ]
        (SC : ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u})),
        SC.ShortExact → isTF_cat SC.X₃ →
        ∀ (g₀ : SC.X₁ ⟶ (U_of S m).obj ℐ), ∃ h : SC.X₂ ⟶ (U_of S m).obj ℐ, SC.f ≫ h = g₀ := by
      intro ℐ _ SC hSC hTF_K g₀
      let upHom : ZMod m →+* R :=
        { toFun := ULift.up
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      have hm_ℐ : m • 𝟙 ((U_of S m).obj ℐ) = 0 := by
        ext W x
        let M_W : Type u := ℐ.obj.obj W
        let modZ : Module (ZMod m) M_W := Module.compHom M_W upHom
        exact @ZModModule.char_nsmul_eq_zero m M_W _ modZ x
      let K' := SC.X₁; let P := SC.X₂; let K := SC.X₃; let ι := SC.f; let π := SC.g
      have _ : Mono ι := hSC.mono_f
      have _ : Epi π := hSC.epi_g
      let K'_bar := Limits.cokernel (m • 𝟙 K')
      let P_bar := Limits.cokernel (m • 𝟙 P)
      let pK' := Limits.cokernel.π (m • 𝟙 K')
      let pP := Limits.cokernel.π (m • 𝟙 P)
      have hm_K' : m • 𝟙 K'_bar = 0 := by
        rw [← cancel_epi pK', Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
          ← Category.id_comp pK', ← Preadditive.nsmul_comp, Limits.cokernel.condition]
      have hm_P : m • 𝟙 P_bar = 0 := by
        rw [← cancel_epi pP, Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
          ← Category.id_comp pP, ← Preadditive.nsmul_comp, Limits.cokernel.condition]
      have h_cond_ι : (m • 𝟙 K') ≫ (ι ≫ pP) = 0 := by
        have hcomm : (m • 𝟙 K') ≫ ι = ι ≫ (m • 𝟙 P) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        rw [← Category.assoc, hcomm, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
      let ι_bar : K'_bar ⟶ P_bar := Limits.cokernel.desc (m • 𝟙 K') (ι ≫ pP) h_cond_ι
      have h_comm_ι : pK' ≫ ι_bar = ι ≫ pP := Limits.cokernel.π_desc _ _ _
      have _ : Mono ι_bar := by
        apply Abelian.Pseudoelement.mono_of_zero_of_map_zero
        intro a_bar ha_bar
        obtain ⟨a, rfl⟩ := Abelian.Pseudoelement.pseudo_surjective_of_epi pK' a_bar
        have h1 : Abelian.Pseudoelement.pseudoApply pP (Abelian.Pseudoelement.pseudoApply ι a) = 0 := by
          rw [← Abelian.Pseudoelement.comp_apply, ← h_comm_ι, Abelian.Pseudoelement.comp_apply]
          exact ha_bar
        obtain ⟨b, hb⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact
          (ShortComplex.exact_cokernel (m • 𝟙 P)) _ h1
        by_cases hm0 : m = 0
        · subst hm0
          have hb0 : Abelian.Pseudoelement.pseudoApply ((0 : ℕ) • 𝟙 P) b = 0 := by
            rw [zero_smul]; exact Abelian.Pseudoelement.zero_apply P b
          rw [hb0] at hb
          have ha0 : a = 0 := Abelian.Pseudoelement.zero_of_map_zero ι
            (Abelian.Pseudoelement.pseudo_injective_of_mono ι) a hb.symm
          rw [ha0, Abelian.Pseudoelement.apply_zero]
        · have _ : Mono (m • 𝟙 K) := hTF_K m hm0
          have hcomm_π : (m • 𝟙 P) ≫ π = π ≫ (m • 𝟙 K) := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
          have hπb : Abelian.Pseudoelement.pseudoApply (m • 𝟙 K)
              (Abelian.Pseudoelement.pseudoApply π b) = 0 := by
            rw [← Abelian.Pseudoelement.comp_apply, ← hcomm_π, Abelian.Pseudoelement.comp_apply, hb,
              ← Abelian.Pseudoelement.comp_apply]
            have hz : ι ≫ π = 0 := SC.zero
            rw [hz]; exact Abelian.Pseudoelement.zero_apply K a
          have hb_ker : Abelian.Pseudoelement.pseudoApply π b = 0 :=
            Abelian.Pseudoelement.zero_of_map_zero (m • 𝟙 K)
              (Abelian.Pseudoelement.pseudo_injective_of_mono (m • 𝟙 K)) _ hπb
          obtain ⟨c, rfl⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact hSC.exact b hb_ker
          have hcomm_ι2 : (m • 𝟙 K') ≫ ι = ι ≫ (m • 𝟙 P) := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
          have hc_eq : Abelian.Pseudoelement.pseudoApply ι
              (Abelian.Pseudoelement.pseudoApply (m • 𝟙 K') c) =
              Abelian.Pseudoelement.pseudoApply ι a := by
            rw [← Abelian.Pseudoelement.comp_apply, hcomm_ι2, Abelian.Pseudoelement.comp_apply, hb]
          have ha_eq : a = Abelian.Pseudoelement.pseudoApply (m • 𝟙 K') c :=
            (Abelian.Pseudoelement.pseudo_injective_of_mono ι hc_eq).symm
          rw [ha_eq, ← Abelian.Pseudoelement.comp_apply, Limits.cokernel.condition]
          exact Abelian.Pseudoelement.zero_apply K'_bar c
      obtain ⟨K'_mod, hK'_mod⟩ := hLiftSheaf K'_bar hm_K'
      obtain ⟨P_mod, hP_mod⟩ := hLiftSheaf P_bar hm_P
      obtain ⟨ι_mod, hι_mod⟩ := hUFull (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm)
      have _ : Mono ι_mod := by
        refine ⟨fun {Z} f₁ f₂ hf => hUFaith ?_⟩
        have _ : Mono ((U_of S m).map ι_mod) := by
          rw [hι_mod]
          exact mono_comp (eqToHom hK'_mod) (ι_bar ≫ eqToHom hP_mod.symm)
        rw [← cancel_mono ((U_of S m).map ι_mod), ← (U_of S m).map_comp,
          ← (U_of S m).map_comp, hf]
      have hg₀_cond : (m • 𝟙 K') ≫ g₀ = 0 := by
        have hcomm : (m • 𝟙 K') ≫ g₀ = g₀ ≫ (m • 𝟙 ((U_of S m).obj ℐ)) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        rw [hcomm, hm_ℐ, Limits.comp_zero]
      let g₀_bar : K'_bar ⟶ (U_of S m).obj ℐ := Limits.cokernel.desc (m • 𝟙 K') g₀ hg₀_cond
      obtain ⟨g₀_mod, hg₀_mod⟩ := hUFull (eqToHom hK'_mod ≫ g₀_bar)
      let h_mod : P_mod ⟶ ℐ := Injective.factorThru g₀_mod ι_mod
      have hh_mod : ι_mod ≫ h_mod = g₀_mod := Injective.comp_factorThru g₀_mod ι_mod
      refine ⟨pP ≫ eqToHom hP_mod.symm ≫ (U_of S m).map h_mod, ?_⟩
      have h_mid : ι_bar ≫ eqToHom hP_mod.symm ≫ (U_of S m).map h_mod = g₀_bar := by
        have h_eq1 : (eqToHom hK'_mod ≫ ι_bar ≫ eqToHom hP_mod.symm) ≫ (U_of S m).map h_mod =
            eqToHom hK'_mod ≫ g₀_bar := by
          rw [← hι_mod, ← (U_of S m).map_comp, hh_mod, hg₀_mod]
        have h_eq2 := congrArg (fun k => eqToHom hK'_mod.symm ≫ k) h_eq1
        simpa only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp] using h_eq2
      calc
        SC.f ≫ (pP ≫ eqToHom hP_mod.symm ≫ (U_of S m).map h_mod)
          = (ι ≫ pP) ≫ eqToHom hP_mod.symm ≫ (U_of S m).map h_mod := (Category.assoc _ _ _).symm
        _ = (pK' ≫ ι_bar) ≫ eqToHom hP_mod.symm ≫ (U_of S m).map h_mod := by rw [h_comm_ι]
        _ = pK' ≫ (ι_bar ≫ eqToHom hP_mod.symm ≫ (U_of S m).map h_mod) := Category.assoc _ _ _
        _ = pK' ≫ g₀_bar := by rw [h_mid]
        _ = g₀ := Limits.cokernel.π_desc _ _ _
    exact ext_comparison_bijective_of_acyclic (U_of S m) oneR Fℤ (ηℤ_of S m) hBase
      (fun ℐ _ p e => ext_vanish_of_effaceable isTF_cat isTF_sub hCover ((U_of S m).obj ℐ)
        (hExtend ℐ) p hTF_Fℤ e)

  
  have hθ_of_bij : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m k : ℕ),
      Function.Bijective (θ_of S m k) := by
    intro S m k
    have _ := hAdd_U S m
    have _ := (hLim_U S m).1
    have _ := (hLim_U S m).2
    have _ := hExtMod S m
    have _ := hExtAb S
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hPost_bij : Function.Bijective
        ((Abelian.Ext.mk₀ (βM_of S m)).postcomp Fℤ (Nat.add_zero k)) := by
      let eqvPost : Abelian.Ext Fℤ ((U_of S m).obj (weilEtaleModuleUnit S m)) k ≃
          weilEtaleTorsionH S m k :=
        { toFun := (Abelian.Ext.mk₀ (βM_of S m)).postcomp Fℤ (Nat.add_zero k)
          invFun := (Abelian.Ext.mk₀ (αM_of S m)).postcomp Fℤ (Nat.add_zero k)
          left_inv := fun z => by
            change (z.comp (Abelian.Ext.mk₀ (βM_of S m)) (Nat.add_zero k)).comp
              (Abelian.Ext.mk₀ (αM_of S m)) (Nat.add_zero k) = z
            rw [Abelian.Ext.comp_assoc z _ _ (Nat.add_zero k) (Nat.zero_add 0) (Nat.add_zero k),
              Abelian.Ext.mk₀_comp_mk₀, hβα_of S m, Abelian.Ext.comp_mk₀_id]
          right_inv := fun z => by
            change (z.comp (Abelian.Ext.mk₀ (αM_of S m)) (Nat.add_zero k)).comp
              (Abelian.Ext.mk₀ (βM_of S m)) (Nat.add_zero k) = z
            rw [Abelian.Ext.comp_assoc z _ _ (Nat.add_zero k) (Nat.zero_add 0) (Nat.add_zero k),
              Abelian.Ext.mk₀_comp_mk₀, hαβ_of S m, Abelian.Ext.comp_mk₀_id] }
      exact eqvPost.bijective
    exact hPost_bij.comp (hGenBij S m k (weilEtaleModuleUnit S m))

  
  
  
  refine ⟨?_, ?_, ?_⟩
  · 
    intro S m k
    exact ⟨⟨θ_of S m k, hθ_of_valid S m k, hθ_of_bij S m k⟩,
      fun θ₁ θ₂ h₁ h₂ => (hθ_of_uniq S m k θ₁ h₁).trans (hθ_of_uniq S m k θ₂ h₂).symm⟩

  · 
    intro S ℓ r i j c hc θ_i1 θ_i0 θ_j1 θ_j0 θ_c1 θ_c0
      hθ_i1 hθ_i0 hθ_j1 hθ_j0 hθ_c1 hθ_c0 a b a₀ b₀ ha hb
    let m₁ := ℓ ^ (r + 1)
    let m₀ := ℓ ^ r
    let R₁ := ULift.{u, 0} (ZMod m₁)
    let R₀ := ULift.{u, 0} (ZMod m₀)
    let J := S.smallEtaleTopology
    have _ := hHasSC_fgt S m₁; have _ := hAdd_U S m₁
    have _ := (hLim_U S m₁).1; have _ := (hLim_U S m₁).2
    have _ := hHasSC_fgt S m₀; have _ := hAdd_U S m₀
    have _ := (hLim_U S m₀).1; have _ := (hLim_U S m₀).2
    have _ := hExtMod S m₁
    have _ := hExtMod S m₀
    have _ := hExtAb S
    have _ : EnoughInjectives (CategoryTheory.Sheaf J (ModuleCat.{u, u} R₀)) := inferInstance
    rw [hθ_of_uniq S m₁ i θ_i1 hθ_i1, hθ_of_uniq S m₀ i θ_i0 hθ_i0] at ha
    rw [hθ_of_uniq S m₁ j θ_j1 hθ_j1, hθ_of_uniq S m₀ j θ_j0 hθ_j0] at hb
    rw [hθ_of_uniq S m₁ c θ_c1 hθ_c1, hθ_of_uniq S m₀ c θ_c0 hθ_c0]
    let π₀ : ZMod m₁ →+* ZMod m₀ := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod m₀)
    let π : R₁ →+* R₀ :=
      { toFun := fun x => ULift.up (π₀ x.down)
        map_one' := congrArg ULift.up π₀.map_one
        map_mul' := fun x y => congrArg ULift.up (π₀.map_mul x.down y.down)
        map_zero' := congrArg ULift.up π₀.map_zero
        map_add' := fun x y => congrArg ULift.up (π₀.map_add x.down y.down) }
    have _ : J.HasSheafCompose (ModuleCat.restrictScalars π) :=
      hasSheafCompose_of_adj J (ModuleCat.extendRestrictScalarsAdj π)
    have _ : J.HasSheafCompose (ModuleCat.coextendScalars π) :=
      hasSheafCompose_of_adj J (ModuleCat.restrictCoextendScalarsAdj π)
    let ρ : CategoryTheory.Sheaf J (ModuleCat.{u, u} R₀) ⥤
        CategoryTheory.Sheaf J (ModuleCat.{u, u} R₁) :=
      CategoryTheory.sheafCompose J (ModuleCat.restrictScalars π)
    have _ : ρ.IsLeftAdjoint := ⟨_, ⟨sheafComposeAdjRight J (ModuleCat.restrictCoextendScalarsAdj π)⟩⟩
    have _ : ρ.IsRightAdjoint := ⟨_, ⟨sheafComposeAdjLeft J (ModuleCat.extendRestrictScalarsAdj π)⟩⟩
    have _ : Limits.PreservesFiniteLimits ρ := inferInstance
    have _ : Limits.PreservesFiniteColimits ρ := inferInstance
    have _ : ρ.Additive := { map_add := by intros; ext W x; rfl }
    let FgtMod₁ := CategoryTheory.forget₂ (ModuleCat.{u, u} R₁) AddCommGrpCat.{u}
    let FgtMod₀ := CategoryTheory.forget₂ (ModuleCat.{u, u} R₀) AddCommGrpCat.{u}
    let Cℤ := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM₁ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₁))
    let AM₀ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let R₁_mod := ModuleCat.of R₁ R₁
    let R₀_mod := ModuleCat.of R₀ R₀
    let Fℤ := Cℤ.obj Aℤ
    let oneR₁ := weilEtaleModuleUnit S m₁
    let oneR₀ := weilEtaleModuleUnit S m₀
    let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} (hT_of S)
    let adjR₁ := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R₁) (hT_of S)
    let adjR₀ := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R₀) (hT_of S)
    let M₀_res : ModuleCat.{u, u} R₁ := (ModuleCat.restrictScalars π).obj R₀_mod
    let π_lin : R₁_mod ⟶ M₀_res :=
      letI : Algebra R₁ R₀ := π.toAlgebra
      ModuleCat.ofHom
        { toFun := fun x => (π x : M₀_res)
          map_add' := fun x y => by change π (x + y) = π x + π y; exact π.map_add x y
          map_smul' := fun r x => by change π (r * x) = π r * π x; exact π.map_mul r x }
    let q_r : oneR₁ ⟶ ρ.obj oneR₀ :=
      (adjR₁.homEquiv R₁_mod (ρ.obj oneR₀)).symm
        (π_lin ≫ (ModuleCat.restrictScalars π).map (adjR₀.unit.app R₀_mod))
    let τ₀ : AM₁ ⟶ AM₀ := AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom π₀.toAddMonoidHom)
    let π_ab : FgtMod₁.obj R₁_mod ⟶ FgtMod₀.obj R₀_mod := FgtMod₁.map π_lin
    let q_r_ab : (U_of S m₁).obj oneR₁ ⟶ (U_of S m₀).obj oneR₀ := (U_of S m₁).map q_r
    have hq_unit : u₀_of S m₁ ≫
        ((sheafSections J AddCommGrpCat.{u}).obj (Opposite.op (T_of S))).map q_r_ab =
        π_ab ≫ u₀_of S m₀ := by
      have h1 : FgtMod₁.map (adjR₁.unit.app R₁_mod) ≫ ((U_of S m₁).map q_r).hom.app (Opposite.op (T_of S)) =
          FgtMod₁.map (adjR₁.unit.app R₁_mod ≫ q_r.hom.app (Opposite.op (T_of S))) :=
        (FgtMod₁.map_comp _ _).symm
      have h2 : adjR₁.unit.app R₁_mod ≫ q_r.hom.app (Opposite.op (T_of S)) =
          π_lin ≫ (ModuleCat.restrictScalars π).map (adjR₀.unit.app R₀_mod) :=
        (Adjunction.homEquiv_unit adjR₁ R₁_mod (ρ.obj oneR₀) q_r).symm.trans
          (Equiv.apply_symm_apply _ _)
      exact h1.trans ((congrArg FgtMod₁.map h2).trans (FgtMod₁.map_comp _ _))
    have h_η : ηℤ_of S m₁ ≫ q_r_ab = ηℤ_of S m₀ := by
      apply (adjℤ.homEquiv Aℤ ((U_of S m₀).obj oneR₀)).injective
      rw [Adjunction.homEquiv_naturality_right adjℤ (ηℤ_of S m₁) q_r_ab,
        h_ηℤ_homEquiv, h_ηℤ_homEquiv, Category.assoc, hq_unit, ← Category.assoc]
      congr 1
      ext ⟨z⟩
      exact congrArg ULift.up (map_intCast π₀ z)
    have h_α : αM_of S m₁ ≫ q_r_ab = Cℤ.map τ₀ ≫ αM_of S m₀ := by
      apply (adjℤ.homEquiv AM₁ ((U_of S m₀).obj oneR₀)).injective
      rw [Adjunction.homEquiv_naturality_right adjℤ (αM_of S m₁) q_r_ab,
        Adjunction.homEquiv_naturality_left adjℤ τ₀ (αM_of S m₀),
        h_αM_homEquiv, h_αM_homEquiv, Category.assoc, hq_unit, ← Category.assoc, ← Category.assoc]
      rfl
