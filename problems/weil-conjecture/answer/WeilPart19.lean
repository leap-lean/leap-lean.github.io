  · intro q M₁ M₂ ⟨e⟩
    rw [hObj_eq q M₁, hObj_eq q M₂]
    exact ⟨(T_fun q).mapIso e⟩
  · intro SC hSE
    have hFun_eq : weilEtaleHigherDirectImage h = fun a F => (T_fun a).obj F :=
      funext fun a => funext fun F => hObj_eq a F
    rw [hFun_eq]
    obtain ⟨δ, hαβ, hβδ, hδα, hMono0, hEx1, hEx2, hEx3⟩ := hLES SC hSE
    exact ⟨fun a => (T_fun a).map SC.f, fun a => (T_fun a).map SC.g,
      δ, hαβ, hβδ, hδα, hMono0, hEx1, hEx2, hEx3⟩
  · intro M I q
    rw [hObj_eq q M]
    let M₀ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} :=
      ((CochainComplex.single₀ (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})).obj M).X 0
    obtain ⟨iso₀⟩ := hMain q M₀ I.cocomplex (I.ι.f 0) (sc_zero_sh I.exact₀) I.injective
      (CategoryTheory.InjectiveResolution.instMonoFNatι I 0) I.exact₀ I.exact_succ
    exact ⟨((T_fun q).mapIso
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 M).symm).trans iso₀⟩

theorem weil_ellPrimary_serre_closure_and_mod_prime_extraction (k : Type u) [Field k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hSerre : WeilConstructibleModPrimeSerreHolds k ℓ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
    [AlgebraicGeometry.QuasiCompact Y.hom]
    [AlgebraicGeometry.IsSeparated Y.hom] :
    (∀ (G : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero G → WeilEllPrimaryConstructible ℓ Y.left G) ∧
    (∀ (G : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ Y.left G → WeilEllPrimaryConstructible ℓ Y.left G) ∧
    (∀ (G₁ G₂ : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (CategoryTheory.Iso G₁ G₂) →
      WeilEllPrimaryConstructible ℓ Y.left G₁ →
      WeilEllPrimaryConstructible ℓ Y.left G₂) ∧
    (∀ (G : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilEllPrimaryConstructible ℓ Y.left G →
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      WeilIsConstructibleModPrimeSheaf ℓ Y.left G) ∧
    (∀ {N₁ N₂ N₃ N₄ N₅ : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}}
        (f₁ : Quiver.Hom N₁ N₂) (f₂ : Quiver.Hom N₂ N₃)
        (f₃ : Quiver.Hom N₃ N₄) (f₄ : Quiver.Hom N₄ N₅)
        (h₁₂ : CategoryTheory.CategoryStruct.comp f₁ f₂ = 0)
        (h₂₃ : CategoryTheory.CategoryStruct.comp f₂ f₃ = 0)
        (h₃₄ : CategoryTheory.CategoryStruct.comp f₃ f₄ = 0),
      (CategoryTheory.ShortComplex.mk f₁ f₂ h₁₂).Exact →
      (CategoryTheory.ShortComplex.mk f₂ f₃ h₂₃).Exact →
      (CategoryTheory.ShortComplex.mk f₃ f₄ h₃₄).Exact →
      WeilEllPrimaryConstructible ℓ Y.left N₁ →
      WeilEllPrimaryConstructible ℓ Y.left N₂ →
      WeilEllPrimaryConstructible ℓ Y.left N₄ →
      WeilEllPrimaryConstructible ℓ Y.left N₅ →
      WeilEllPrimaryConstructible ℓ Y.left N₃) :=
by
  let C := CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}
  let 𝒬 : C → Prop := WeilIsConstructibleModPrimeSheaf ℓ Y.left
  have hQ_zero : ∀ G : C, Limits.IsZero G → 𝒬 G :=
    fun G hG => (hSerre.1 Y.left G).2 hG
  have hQ_iso : ∀ G₁ G₂ : C, Nonempty (G₁ ≅ G₂) → 𝒬 G₁ → 𝒬 G₂ :=
    hSerre.2.1 Y.left
  obtain ⟨hQ_ker_coker, hQ_ext_tors⟩ := hSerre.2.2.2.2 Y
  have h_s1 :
      (∀ {X W : C} (φ : X ⟶ W),
        Limits.IsZero W →
        Nonempty (Limits.kernel φ ≅ X) ∧ Limits.IsZero (Limits.cokernel φ)) ∧
      (∀ {X W₁ W₂ : C} (φ : X ⟶ W₁) (e : W₁ ≅ W₂),
        Nonempty (Limits.kernel (φ ≫ e.hom) ≅ Limits.kernel φ) ∧
        Nonempty (Limits.cokernel (φ ≫ e.hom) ≅ Limits.cokernel φ)) ∧
      (∀ {F₁ : C} {SC : ShortComplex C},
        SC.ShortExact →
        ∀ (φ : F₁ ⟶ SC.X₂),
          ∃ (α : Limits.kernel (φ ≫ SC.g) ⟶ SC.X₁)
            (u : Limits.cokernel α ⟶ Limits.cokernel φ)
            (v : Limits.cokernel φ ⟶ Limits.cokernel (φ ≫ SC.g))
            (huv : u ≫ v = 0),
            Nonempty (Limits.kernel φ ≅ Limits.kernel α) ∧
            (ShortComplex.mk u v huv).ShortExact) := by
    refine ⟨?_, ?_, ?_⟩
    · intro X W φ hW
      have hφ : φ = 0 := hW.eq_of_tgt φ 0
      rw [hφ]
      exact ⟨⟨Limits.kernelZeroIsoSource⟩, hW.of_iso Limits.cokernelZeroIsoTarget⟩
    · intro X W₁ W₂ φ e
      exact ⟨⟨Limits.kernelCompMono φ e.hom⟩, ⟨Limits.cokernelCompIsIso φ e.hom⟩⟩
    · intro F₁ SC hSE φ
      let S := kernelCokernelCompSequence φ SC.g
      have hS := kernelCokernelCompSequence_exact φ SC.g
      let d₀₁ : Limits.kernel φ ⟶ Limits.kernel (φ ≫ SC.g) := S.map' 0 1
      let d₁₂ : Limits.kernel (φ ≫ SC.g) ⟶ Limits.kernel SC.g := S.map' 1 2
      let d₂₃ : Limits.kernel SC.g ⟶ Limits.cokernel φ := S.map' 2 3
      let d₃₄ : Limits.cokernel φ ⟶ Limits.cokernel (φ ≫ SC.g) := S.map' 3 4
      let eK : Limits.kernel SC.g ≅ SC.X₁ :=
        Limits.IsLimit.conePointUniqueUpToIso
          (Limits.limit.isLimit (Limits.parallelPair SC.g 0)) hSE.fIsKernel
      let α : Limits.kernel (φ ≫ SC.g) ⟶ SC.X₁ := d₁₂ ≫ eK.hom
      have hd₀₁_₁₂ : d₀₁ ≫ d₁₂ = 0 := (S.sc' hS.toIsComplex 0 1 2).zero
      have hd₀₁_α : d₀₁ ≫ α = 0 := by
        dsimp [α]
        rw [← Category.assoc, hd₀₁_₁₂, Limits.zero_comp]
      let SC₀₁₂ := ShortComplex.mk d₀₁ α hd₀₁_α
      let iso₀₁₂ : S.sc' hS.toIsComplex 0 1 2 ≅ SC₀₁₂ :=
        ShortComplex.isoMk (Iso.refl _) (Iso.refl _) eK
          (by dsimp [SC₀₁₂, d₀₁]; rw [Category.id_comp, Category.comp_id])
          (by dsimp [SC₀₁₂, α, d₁₂]; rw [Category.id_comp])
      have hEx₀₁₂ : SC₀₁₂.Exact := ShortComplex.exact_of_iso iso₀₁₂ (hS.exact' 0 1 2)
      have hMono₀₁ : Mono d₀₁ := by dsimp [d₀₁]; infer_instance
      have hLim₀ := (SC₀₁₂.exact_and_mono_f_iff_f_is_kernel).mp ⟨hEx₀₁₂, hMono₀₁⟩
      let eKα : Limits.kernel φ ≅ Limits.kernel α :=
        Limits.IsLimit.conePointUniqueUpToIso hLim₀.some
          (Limits.limit.isLimit (Limits.parallelPair α 0))
      let d'₂₃ : SC.X₁ ⟶ Limits.cokernel φ := eK.inv ≫ d₂₃
