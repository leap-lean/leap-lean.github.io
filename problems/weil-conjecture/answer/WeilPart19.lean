      have hSep := CategoryTheory.Presheaf.IsSheaf.isSeparated G.property
      refine hSep E S_cov hS_mem s 0 ?_
      intro Y₀ f hf
      rcases hf with ⟨Z_et, h_et, g_et, ⟨idx⟩, rfl⟩
      rw [map_zero]
