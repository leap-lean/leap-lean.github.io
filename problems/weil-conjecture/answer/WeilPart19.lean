            have hc2 : algebraMap Ω₀ ↑(Z_bar.presheaf.obj (Opposite.op ⊤)) (algebraMap K₁ Ω₀ c) =
                α₂_Z.hom (algebraMap K₁ Ω₀ c) :=
              congrArg (fun φ => φ.hom (algebraMap K₁ Ω₀ c)) hAlgZbar_top
            change p_Z.appTop.hom (algebraMap K₁ ↑(Z.presheaf.obj (Opposite.op ⊤)) c) =
              algebraMap Ω₀ ↑(Z_bar.presheaf.obj (Opposite.op ⊤)) (algebraMap K₁ Ω₀ c)
            rw [hc1, hc2]
            exact hc }
      let Φ_top : TensorProduct K₁ Ω₀ ↑(Z.presheaf.obj (Opposite.op ⊤)) →ₐ[Ω₀]
          ↑(Z_bar.presheaf.obj (Opposite.op ⊤)) :=
        Algebra.TensorProduct.lift
          (Algebra.ofId Ω₀ ↑(Z_bar.presheaf.obj (Opposite.op ⊤))) ψ_top
          (fun _ _ => Commute.all _ _)
      
      let hBC_U := fun a : ι => (hAffOpenBC g g_bar p_Z hpZ (U_cov a) (hAffU a)).2
      let eΦ_U : ∀ a : ι, TensorProduct K₁ Ω₀ ↑(Z.presheaf.obj (Opposite.op (U_cov a))) ≃ₐ[Ω₀]
          ↑(Z_bar.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map p_Z.base).obj (U_cov a)))) :=
        fun a => AlgEquiv.ofBijective _ (hBC_U a).choose_spec.2
      let hBC_Inter := fun q : ι × ι =>
        (hAffOpenBC g g_bar p_Z hpZ (U_cov q.1 ⊓ U_cov q.2) (hAffInter q.1 q.2)).2
      let eΦ_Inter : ∀ q : ι × ι,
          TensorProduct K₁ Ω₀ ↑(Z.presheaf.obj (Opposite.op (U_cov q.1 ⊓ U_cov q.2))) ≃ₐ[Ω₀]
          ↑(Z_bar.presheaf.obj (Opposite.op
            ((TopologicalSpace.Opens.map p_Z.base).obj (U_cov q.1 ⊓ U_cov q.2)))) :=
        fun q => AlgEquiv.ofBijective _ (hBC_Inter q).choose_spec.2
      have h_eΦ_U : ∀ (a : ι) (c : Ω₀) (r : ↑(Z.presheaf.obj (Opposite.op (U_cov a)))),
          eΦ_U a (TensorProduct.tmul K₁ c r) =
            algebraMap Ω₀ ↑(Z_bar.presheaf.obj (Opposite.op
              ((TopologicalSpace.Opens.map p_Z.base).obj (U_cov a)))) c *
            (p_Z.app (U_cov a)).hom r := by
        intro a c r
        dsimp only [eΦ_U]
        rw [AlgEquiv.ofBijective_apply, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply,
          (hBC_U a).choose_spec.1 r]
      have h_eΦ_Inter : ∀ (q : ι × ι)
          (c : Ω₀) (r : ↑(Z.presheaf.obj (Opposite.op (U_cov q.1 ⊓ U_cov q.2)))),
          eΦ_Inter q (TensorProduct.tmul K₁ c r) =
            algebraMap Ω₀ ↑(Z_bar.presheaf.obj (Opposite.op
              ((TopologicalSpace.Opens.map p_Z.base).obj (U_cov q.1 ⊓ U_cov q.2)))) c *
            (p_Z.app (U_cov q.1 ⊓ U_cov q.2)).hom r := by
        intro q c r
        dsimp only [eΦ_Inter]
        rw [AlgEquiv.ofBijective_apply, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply,
          (hBC_Inter q).choose_spec.1 r]
      
      let resAlgZ : ∀ {W₁ W₂ : Z.Opens} (hle : W₁ ≤ W₂),
          ↑(Z.presheaf.obj (Opposite.op W₂)) →ₐ[K₁] ↑(Z.presheaf.obj (Opposite.op W₁)) :=
        fun {W₁ W₂} hle =>
          { toRingHom := (Z.presheaf.map (CategoryTheory.homOfLE hle).op).hom
            commutes' := fun c => by
              have hmor : (α₁_Z ≫ Z.presheaf.map (CategoryTheory.homOfLE (le_top : W₂ ≤ ⊤)).op) ≫
                  Z.presheaf.map (CategoryTheory.homOfLE hle).op =
                  α₁_Z ≫ Z.presheaf.map (CategoryTheory.homOfLE (le_top : W₁ ≤ ⊤)).op := by
                rw [CategoryTheory.Category.assoc, ← Z.presheaf.map_comp, ← op_comp]
                rfl
              exact congrArg (fun f => f.hom c) hmor }
      let resAlgZbar : ∀ {W₁ W₂ : Z_bar.Opens} (hle : W₁ ≤ W₂),
          ↑(Z_bar.presheaf.obj (Opposite.op W₂)) →ₐ[Ω₀] ↑(Z_bar.presheaf.obj (Opposite.op W₁)) :=
        fun {W₁ W₂} hle =>
          { toRingHom := (Z_bar.presheaf.map (CategoryTheory.homOfLE hle).op).hom
            commutes' := fun c => by
              have hmor : (α₂_Z ≫ Z_bar.presheaf.map (CategoryTheory.homOfLE (le_top : W₂ ≤ ⊤)).op) ≫
                  Z_bar.presheaf.map (CategoryTheory.homOfLE hle).op =
                  α₂_Z ≫ Z_bar.presheaf.map (CategoryTheory.homOfLE (le_top : W₁ ≤ ⊤)).op := by
                rw [CategoryTheory.Category.assoc, ← Z_bar.presheaf.map_comp, ← op_comp]
                rfl
              exact congrArg (fun f => f.hom c) hmor }
      
      let resZ_1 : (∀ a : ι, ↑(Z.presheaf.obj (Opposite.op (U_cov a)))) →ₐ[K₁]
          (∀ q : ι × ι, ↑(Z.presheaf.obj (Opposite.op (U_cov q.1 ⊓ U_cov q.2)))) :=
        AlgHom.pi fun q =>
          (resAlgZ (inf_le_left : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.1)).comp
            (Pi.evalAlgHom K₁ (fun a : ι => ↑(Z.presheaf.obj (Opposite.op (U_cov a)))) q.1)
      let resZ_2 : (∀ a : ι, ↑(Z.presheaf.obj (Opposite.op (U_cov a)))) →ₐ[K₁]
          (∀ q : ι × ι, ↑(Z.presheaf.obj (Opposite.op (U_cov q.1 ⊓ U_cov q.2)))) :=
        AlgHom.pi fun q =>
          (resAlgZ (inf_le_right : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.2)).comp
            (Pi.evalAlgHom K₁ (fun a : ι => ↑(Z.presheaf.obj (Opposite.op (U_cov a)))) q.2)
      let U_cov_bar : ι → Z_bar.Opens := fun a => (TopologicalSpace.Opens.map p_Z.base).obj (U_cov a)
      let resZbar_1 : (∀ a : ι, ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar a)))) →ₐ[Ω₀]
          (∀ q : ι × ι, ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar q.1 ⊓ U_cov_bar q.2)))) :=
        AlgHom.pi fun q =>
          (resAlgZbar (inf_le_left : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.1)).comp
            (Pi.evalAlgHom Ω₀ (fun a : ι => ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar a)))) q.1)
      let resZbar_2 : (∀ a : ι, ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar a)))) →ₐ[Ω₀]
          (∀ q : ι × ι, ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar q.1 ⊓ U_cov_bar q.2)))) :=
        AlgHom.pi fun q =>
          (resAlgZbar (inf_le_right : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.2)).comp
            (Pi.evalAlgHom Ω₀ (fun a : ι => ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar a)))) q.2)
      
      let toEqZ : ↑(Z.presheaf.obj (Opposite.op ⊤)) →ₐ[K₁] ↥(resZ_1.equalizer resZ_2) :=
        { toFun := fun t => ⟨fun a => resAlgZ (le_top : U_cov a ≤ ⊤) t, by
            ext q
            have hmor : Z.presheaf.map (CategoryTheory.homOfLE (le_top : U_cov q.1 ≤ ⊤)).op ≫
                Z.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.1)).op =
                Z.presheaf.map (CategoryTheory.homOfLE (le_top : U_cov q.2 ≤ ⊤)).op ≫
                Z.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.2)).op := by
              rw [← Z.presheaf.map_comp, ← Z.presheaf.map_comp, ← op_comp, ← op_comp]
              rfl
            exact congrArg (fun f => f.hom t) hmor⟩
          map_one' := by ext a; exact map_one _
          map_mul' := fun x y => by ext a; exact map_mul _ x y
          map_zero' := by ext a; exact map_zero _
          map_add' := fun x y => by ext a; exact map_add _ x y
          commutes' := fun c => by ext a; exact (resAlgZ (le_top : U_cov a ≤ ⊤)).commutes c }
      have hBij_toEqZ : Function.Bijective toEqZ := by
        refine ⟨fun x y hxy => ?_, fun y => ?_⟩
        · have h_gl := TopCat.Sheaf.existsUnique_gluing'.{u} Z.sheaf U_cov ⊤
            (fun a => CategoryTheory.homOfLE le_top) (le_of_eq hSupU.symm)
            (fun a => (toEqZ x).1 a)
            (fun a b => congrFun (toEqZ x).2 (a, b))
          exact h_gl.unique (fun _ => rfl) (fun a => congrFun (congrArg Subtype.val hxy.symm) a)
        · obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing'.{u} Z.sheaf U_cov ⊤
            (fun a => CategoryTheory.homOfLE le_top) (le_of_eq hSupU.symm) y.1
            (fun a b => congrFun y.2 (a, b))
          exact ⟨t, Subtype.ext (funext ht)⟩
      let eEqZ : ↑(Z.presheaf.obj (Opposite.op ⊤)) ≃ₐ[K₁] ↥(resZ_1.equalizer resZ_2) :=
        AlgEquiv.ofBijective toEqZ hBij_toEqZ
      let toEqZbar : ↑(Z_bar.presheaf.obj (Opposite.op ⊤)) →ₐ[Ω₀]
          ↥(resZbar_1.equalizer resZbar_2) :=
        { toFun := fun t => ⟨fun a => resAlgZbar (le_top : U_cov_bar a ≤ ⊤) t, by
            ext q
            have hmor : Z_bar.presheaf.map (CategoryTheory.homOfLE (le_top : U_cov_bar q.1 ≤ ⊤)).op ≫
                Z_bar.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.1)).op =
                Z_bar.presheaf.map (CategoryTheory.homOfLE (le_top : U_cov_bar q.2 ≤ ⊤)).op ≫
                Z_bar.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.2)).op := by
              rw [← Z_bar.presheaf.map_comp, ← Z_bar.presheaf.map_comp, ← op_comp, ← op_comp]
              rfl
            exact congrArg (fun f => f.hom t) hmor⟩
          map_one' := by ext a; exact map_one _
          map_mul' := fun x y => by ext a; exact map_mul _ x y
          map_zero' := by ext a; exact map_zero _
          map_add' := fun x y => by ext a; exact map_add _ x y
          commutes' := fun c => by ext a; exact (resAlgZbar (le_top : U_cov_bar a ≤ ⊤)).commutes c }
      have hBij_toEqZbar : Function.Bijective toEqZbar := by
        refine ⟨fun x y hxy => ?_, fun y => ?_⟩
        · have h_gl := TopCat.Sheaf.existsUnique_gluing'.{u} Z_bar.sheaf U_cov_bar ⊤
            (fun a => CategoryTheory.homOfLE le_top) (le_of_eq hSupU_bar.symm)
            (fun a => (toEqZbar x).1 a)
            (fun a b => congrFun (toEqZbar x).2 (a, b))
          exact h_gl.unique (fun _ => rfl) (fun a => congrFun (congrArg Subtype.val hxy.symm) a)
        · obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing'.{u} Z_bar.sheaf U_cov_bar ⊤
            (fun a => CategoryTheory.homOfLE le_top) (le_of_eq hSupU_bar.symm) y.1
            (fun a b => congrFun y.2 (a, b))
          exact ⟨t, Subtype.ext (funext ht)⟩
      let eEqZbar : ↑(Z_bar.presheaf.obj (Opposite.op ⊤)) ≃ₐ[Ω₀]
          ↥(resZbar_1.equalizer resZbar_2) :=
        AlgEquiv.ofBijective toEqZbar hBij_toEqZbar
      
      let e_A : TensorProduct K₁ Ω₀ (∀ a : ι, ↑(Z.presheaf.obj (Opposite.op (U_cov a)))) ≃ₐ[Ω₀]
          (∀ a : ι, ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar a)))) :=
        (Algebra.TensorProduct.piRight K₁ Ω₀ Ω₀
          (fun a : ι => ↑(Z.presheaf.obj (Opposite.op (U_cov a))))).trans
          (AlgEquiv.piCongrRight eΦ_U)
      let e_B : TensorProduct K₁ Ω₀
          (∀ q : ι × ι, ↑(Z.presheaf.obj (Opposite.op (U_cov q.1 ⊓ U_cov q.2)))) ≃ₐ[Ω₀]
          (∀ q : ι × ι, ↑(Z_bar.presheaf.obj (Opposite.op (U_cov_bar q.1 ⊓ U_cov_bar q.2)))) :=
        (Algebra.TensorProduct.piRight K₁ Ω₀ Ω₀
          (fun q : ι × ι => ↑(Z.presheaf.obj (Opposite.op (U_cov q.1 ⊓ U_cov q.2))))).trans
          (AlgEquiv.piCongrRight eΦ_Inter)
      have hComm_res1 : ∀ x, e_B ((Algebra.TensorProduct.map (AlgHom.id Ω₀ Ω₀) resZ_1) x) =
          resZbar_1 (e_A x) := by
        have hAlgEq : e_B.toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id Ω₀ Ω₀) resZ_1) =
            resZbar_1.comp e_A.toAlgHom := by
          apply Algebra.TensorProduct.ext'
          intro c sf
          ext q
          change (eΦ_Inter q) (TensorProduct.tmul K₁ c ((resZ_1 sf) q)) =
            resAlgZbar (inf_le_left : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.1)
              ((eΦ_U q.1) (TensorProduct.tmul K₁ c (sf q.1)))
          rw [h_eΦ_Inter, h_eΦ_U, map_mul,
            (resAlgZbar (inf_le_left : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.1)).commutes c]
          congr 1
          have hnat := p_Z.naturality
            (CategoryTheory.homOfLE (inf_le_left : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.1)).op
          exact congrArg (fun f => f.hom (sf q.1)) hnat
        exact AlgHom.congr_fun hAlgEq
      have hComm_res2 : ∀ x, e_B ((Algebra.TensorProduct.map (AlgHom.id Ω₀ Ω₀) resZ_2) x) =
          resZbar_2 (e_A x) := by
        have hAlgEq : e_B.toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id Ω₀ Ω₀) resZ_2) =
            resZbar_2.comp e_A.toAlgHom := by
          apply Algebra.TensorProduct.ext'
          intro c sf
          ext q
          change (eΦ_Inter q) (TensorProduct.tmul K₁ c ((resZ_2 sf) q)) =
            resAlgZbar (inf_le_right : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.2)
              ((eΦ_U q.2) (TensorProduct.tmul K₁ c (sf q.2)))
          rw [h_eΦ_Inter, h_eΦ_U, map_mul,
            (resAlgZbar (inf_le_right : U_cov_bar q.1 ⊓ U_cov_bar q.2 ≤ U_cov_bar q.2)).commutes c]
          congr 1
          have hnat := p_Z.naturality
            (CategoryTheory.homOfLE (inf_le_right : U_cov q.1 ⊓ U_cov q.2 ≤ U_cov q.2)).op
          exact congrArg (fun f => f.hom (sf q.2)) hnat
        exact AlgHom.congr_fun hAlgEq
      let eEqMap : ↥((Algebra.TensorProduct.map (AlgHom.id Ω₀ Ω₀) resZ_1).equalizer
          (Algebra.TensorProduct.map (AlgHom.id Ω₀ Ω₀) resZ_2)) ≃ₐ[Ω₀]
          ↥(resZbar_1.equalizer resZbar_2) :=
        { toFun := fun x => ⟨e_A x.1, by
            change resZbar_1 (e_A x.1) = resZbar_2 (e_A x.1)
            rw [← hComm_res1, ← hComm_res2, x.2]⟩
          invFun := fun y => ⟨e_A.symm y.1, by
            apply e_B.injective
            rw [hComm_res1, hComm_res2, e_A.apply_symm_apply]
            exact y.2⟩
          left_inv := fun x => Subtype.ext (e_A.symm_apply_apply x.1)
          right_inv := fun y => Subtype.ext (e_A.apply_symm_apply y.1)
          map_mul' := fun x y => Subtype.ext (map_mul e_A x.1 y.1)
          map_add' := fun x y => Subtype.ext (map_add e_A x.1 y.1)
          commutes' := fun c => Subtype.ext (e_A.commutes c) }
      let eTot : TensorProduct K₁ Ω₀ ↑(Z.presheaf.obj (Opposite.op ⊤)) ≃ₐ[Ω₀]
          ↑(Z_bar.presheaf.obj (Opposite.op ⊤)) :=
        ((Algebra.TensorProduct.congr AlgEquiv.refl eEqZ).trans
          (AlgHom.tensorEqualizerEquiv Ω₀ Ω₀ resZ_1 resZ_2)).trans
          (eEqMap.trans eEqZbar.symm)
      have hΦ_top_eq : (Φ_top : TensorProduct K₁ Ω₀ ↑(Z.presheaf.obj (Opposite.op ⊤)) →
          ↑(Z_bar.presheaf.obj (Opposite.op ⊤))) = eTot := by
        have hAlgEq : Φ_top = eTot.toAlgHom := by
          apply Algebra.TensorProduct.ext'
          intro c t
          apply eEqZbar.injective
          dsimp [eTot]
          rw [AlgEquiv.apply_symm_apply]
          ext a
          change resAlgZbar (le_top : U_cov_bar a ≤ ⊤)
              (algebraMap Ω₀ ↑(Z_bar.presheaf.obj (Opposite.op ⊤)) c * p_Z.appTop.hom t) =
            eΦ_U a (TensorProduct.tmul K₁ c (resAlgZ (le_top : U_cov a ≤ ⊤) t))
          rw [h_eΦ_U, map_mul, (resAlgZbar (le_top : U_cov_bar a ≤ ⊤)).commutes c]
          congr 1
          have hnat := p_Z.naturality (CategoryTheory.homOfLE (le_top : U_cov a ≤ ⊤)).op
          exact (congrArg (fun f => f.hom t) hnat).symm
        ext z
        exact AlgHom.congr_fun hAlgEq z
      have hBij_Φ_top : Function.Bijective Φ_top := by
        rw [hΦ_top_eq]
        exact eTot.bijective
      
      have hIso_Φ_cat : CategoryTheory.IsIso (CommRingCat.ofHom Φ_top.toRingHom) :=
        (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom Φ_top.toRingHom)).mpr hBij_Φ_top
      let e_Φ_cat := CategoryTheory.asIso (CommRingCat.ofHom Φ_top.toRingHom)
      have hPushTop : CategoryTheory.IsPushout α₁_Z
          (CommRingCat.ofHom (algebraMap K₁ Ω₀)) p_Z.appTop α₂_Z := by
        refine CategoryTheory.IsPushout.of_iso
          (CommRingCat.isPushout_tensorProduct K₁ Ω₀ ↑(Z.presheaf.obj (Opposite.op ⊤))).flip
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (CategoryTheory.Iso.refl _) e_Φ_cat ?_ (by simp) ?_ ?_
        · simp [hAlgZ_top]
        · ext t
          simp [e_Φ_cat, Φ_top, ψ_top]
        · rw [← hAlgZbar_top]
          ext c
          simp [e_Φ_cat, Φ_top]
      have hpSpecTop : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map p_Z.appTop)
          (AlgebraicGeometry.Spec.map α₂_Z)
          (AlgebraicGeometry.Spec.map α₁_Z) β :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPushTop
      have hpZ_rect : CategoryTheory.IsPullback p_Z
          (Z_bar.toSpecΓ ≫ AlgebraicGeometry.Spec.map α₂_Z)
          (Z.toSpecΓ ≫ AlgebraicGeometry.Spec.map α₁_Z) β := by
        rwa [hToSpecΓ_struct g_bar, hToSpecΓ_struct g]
      have hpTop : CategoryTheory.IsPullback p_Z Z_bar.toSpecΓ Z.toSpecΓ
          (AlgebraicGeometry.Spec.map p_Z.appTop) :=
        CategoryTheory.IsPullback.of_bot hpZ_rect
          (AlgebraicGeometry.Scheme.toSpecΓ_naturality p_Z) hpSpecTop
      have hSurj_spec : AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map p_Z.appTop) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpSpecTop.flip hSurj_β
      have hFlat_spec : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map p_Z.appTop) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpSpecTop.flip hFlat_β
      have hQC_spec : AlgebraicGeometry.QuasiCompact (AlgebraicGeometry.Spec.map p_Z.appTop) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpSpecTop.flip hQC_β
      letI : AlgebraicGeometry.IsAffine Z_bar := hAffZ_bar
      have hIso_Zbar : (CategoryTheory.MorphismProperty.isomorphisms
          AlgebraicGeometry.Scheme) Z_bar.toSpecΓ :=
        AlgebraicGeometry.IsAffine.affine
      have hIso_Z : CategoryTheory.IsIso Z.toSpecΓ :=
        @CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback _ _
          (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
          (@AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓ @AlgebraicGeometry.QuasiCompact)
          AlgebraicGeometry.descendsAlong_isomorphisms_surjective_inf_flat_inf_quasicompact
          _ _ _ _ _ _ _ _ hpTop.flip ⟨⟨hSurj_spec, hFlat_spec⟩, hQC_spec⟩ hIso_Zbar
      exact ⟨hIso_Z⟩
    have hProp_μ₁ : AlgebraicGeometry.IsProper (μ₁ j) := by
      have h_comp : AlgebraicGeometry.IsProper (μ₁ j ≫ i₁) := by
        rw [hLift₁ j]
        exact hProp_tilde₁ j
      exact @AlgebraicGeometry.IsProper.of_comp _ _ _ (μ₁ j) i₁ h_comp inferInstance
    have hAff_μ₁ : AlgebraicGeometry.IsAffineHom (μ₁ j) := by
      have h_comp : AlgebraicGeometry.IsAffineHom (μ₁ j ≫ i₁) := by
        rw [hLift₁ j]
        exact hAff_f₁
      exact @AlgebraicGeometry.IsAffineHom.of_comp _ _ _ (μ₁ j) i₁ h_comp inferInstance
    exact AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_μ₁, hAff_μ₁⟩
  
  have hNilSub_props : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      AlgebraicGeometry.Surjective X.nilradical.subschemeι ∧
