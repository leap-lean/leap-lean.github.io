    have hWbar_g : hW_bar.isoSpec.hom ≫ AlgebraicGeometry.Spec.map α₂_W = W_bar.ι ≫ g_bar := by
      rw [hW_bar.isoSpec_hom]
      dsimp [α₂_W]
      rw [AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top_assoc,
