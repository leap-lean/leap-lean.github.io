    have : IsNoetherianRing ↥B₁ := Algebra.FiniteType.isNoetherianRing k ↥B₁
    have hR₁_in_B₁ : ∀ r : R₁, φ_K r ∈ B₁ := by
      intro r
      have hr_mem : r ∈ Algebra.adjoin k (S₀ : Set R₁) := by rw [hS₀]; trivial
      refine Algebra.adjoin_induction (fun y hy => ?_) (fun c => B₁.algebraMap_mem c)
