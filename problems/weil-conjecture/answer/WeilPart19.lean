          p_pull.map η ≫ r = CategoryTheory.CategoryStruct.id (p_pull.obj M)) := by
    have hCoh0Iso : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        (J : CategoryTheory.GrothendieckTopology C)
        [CategoryTheory.HasSheafify J AddCommGrpCat.{u}]
        [CategoryTheory.HasExt (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
        (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        Nonempty (G.cohomologyPresheaf 0 ≅ G.obj) := by
      intro C _ J _ _ G
