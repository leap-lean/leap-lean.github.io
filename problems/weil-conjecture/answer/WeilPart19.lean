            CategoryTheory.Sieve.functorPushforward ι T ∈ K (ι.obj U₀)) h_top_eq) h1
      have h3 := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S) (ι.obj U₀)
