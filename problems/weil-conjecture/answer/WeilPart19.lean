import WeilPart18
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_smooth_proj_curve_fiber_integral_and_projective (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (X : AlgebraicGeometry.Scheme.{u}),
      ConnectedSpace ↥X ↔ Nat.card (weilEtaleTorsionH X ℓ 0) = ℓ) ∧
    (∀ (k₀ : Type u) [Field k₀]
        (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom]
        [AlgebraicGeometry.IsProper C₀.hom],
      ConnectedSpace ↥C₀.left →
      AlgebraicGeometry.IsIntegral C₀.left) ∧
    (∀ (Z₁ C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (f : C ⟶ Z₁),
      (∃ (N : ℕ) (ι : C.left ⟶
          CategoryTheory.Limits.pullback Z₁.hom (weilProjectiveSpaceOver k N).hom),
        AlgebraicGeometry.IsClosedImmersion ι ∧
        ι ≫ CategoryTheory.Limits.pullback.fst Z₁.hom (weilProjectiveSpaceOver k N).hom =
          f.left) →
      ∀ (k₀ : Type u) [Field k₀]
        (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left),
        IsProjectiveOverField k₀
          (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f.left s))) :=
by
  classical
  refine ⟨?_, ?_, ?_⟩
  · intro X
    have hMult := (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    haveI := hMult.toIsStableUnderComposition
    haveI := hMult.toContainsIdentities
    let J := X.smallEtaleTopology
    let K_pre := X.smallEtalePretopology
    have hJ_eq : J = K_pre.toGrothendieck :=
      X.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology le_rfl
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let Am : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let Fℤ := C.obj Aℤ
    let Fm := weilEtaleTorsionSheaf X ℓ
    let T_std : X.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 X)
        (CategoryTheory.MorphismProperty.id_mem (@AlgebraicGeometry.Etale) X)
    have hT_std : CategoryTheory.Limits.IsTerminal T_std :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom))
        (fun U m => CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.Category.comp_id m.left).symm.trans
            (CategoryTheory.MorphismProperty.Over.w m)))
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_std
    have hEtaleHom : ∀ {U₁ U₂ : X.Etale} (f : U₁ ⟶ U₂), AlgebraicGeometry.Etale f.left := by
      intro U₁ U₂ f
      have hfw : f.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w f
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        f.left U₂.hom U₂.prop (hfw.symm ▸ U₁.prop)
    have hOpenHom : ∀ {U₁ U₂ : X.Etale} (f : U₁ ⟶ U₂), IsOpenMap ⇑f.left.base := by
      intro U₁ U₂ f
      haveI : AlgebraicGeometry.Etale f.left := hEtaleHom f
      exact f.left.isOpenMap
    have hArrowsMem : ∀ (U : X.Etale) {ι : Type u} (Y : ι → X.Etale) (f : ∀ i, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (f i).left.base y = x) →
        CategoryTheory.Presieve.ofArrows Y f ∈ K_pre.coverings U := by
      intro U ι Y f hsurj
      refine ⟨?_, ?_⟩
      · intro x
        obtain ⟨i, y, hy⟩ := hsurj x
        refine ⟨↥(Y i).left, AlgebraicGeometry.Scheme.forget.map (f i).left, ?_, y, hy⟩
        exact CategoryTheory.Presieve.map.of (F := AlgebraicGeometry.Scheme.forget)
          (CategoryTheory.Presieve.map.of (F := CategoryTheory.Over.forget X)
            (CategoryTheory.Presieve.map.of (F := AlgebraicGeometry.Scheme.Etale.forget X)
              (CategoryTheory.Presieve.ofArrows.mk i)))
      · rintro _ _ hmap
        rcases hmap with ⟨h1⟩
        rcases h1 with ⟨h0⟩
        cases h0
        exact hEtaleHom (f _)
    let L_pre : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥(Opposite.unop U).left ↥Am)
        map := fun u => AddCommGrpCat.ofHom
          (LocallyConstant.comapAddMonoidHom ⟨⇑u.unop.left.base, u.unop.left.continuous⟩)
        map_id := fun _ => by
          ext s x
          rfl
        map_comp := fun f g => by
          ext s x
          rfl }
    have hL_sheaf : CategoryTheory.Presheaf.IsSheaf J L_pre := by
      apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J L_pre
        (CategoryTheory.forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type, hJ_eq,
        CategoryTheory.Presieve.isSheaf_pretopology]
      intro U R hR
      have hsurj : ∀ x : ↥U.left, ∃ (V : X.Etale) (g : V ⟶ U), R g ∧ ∃ y : ↥V.left, g.left.base y = x := by
        intro x
        rcases hR.1 x with ⟨_, _, ⟨⟨⟨hg⟩⟩⟩, y, hy⟩
        exact ⟨_, _, hg, y, hy⟩
      intro fam hcompat
      let fam' : ∀ {V : X.Etale} (g : V ⟶ U), R g → LocallyConstant ↥V.left ↥Am :=
        fun g hg => fam g hg
      have hagree : ∀ {V₁ V₂ : X.Etale} (g₁ : V₁ ⟶ U) (hg₁ : R g₁) (g₂ : V₂ ⟶ U) (hg₂ : R g₂)
          (y₁ : ↥V₁.left) (y₂ : ↥V₂.left),
          g₁.left.base y₁ = g₂.left.base y₂ → fam' g₁ hg₁ y₁ = fam' g₂ hg₂ y₂ := by
        intro V₁ V₂ g₁ hg₁ g₂ hg₂ y₁ y₂ h_eq
        haveI : AlgebraicGeometry.Etale g₁.left := hEtaleHom g₁
        haveI : AlgebraicGeometry.Etale g₂.left := hEtaleHom g₂
        let fst_W := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
        let snd_W := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
        have hEt_fst : AlgebraicGeometry.Etale fst_W :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback g₁.left g₂.left).flip inferInstance
        have hEt_W : AlgebraicGeometry.Etale (fst_W ≫ V₁.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            fst_W V₁.hom hEt_fst V₁.prop
        let W_et : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_W ≫ V₁.hom) hEt_W
        let π₁ : W_et ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk fst_W rfl
        have h_snd_w : snd_W ≫ V₂.hom = fst_W ≫ V₁.hom := by
          have hw₁ : g₁.left ≫ U.hom = V₁.hom := CategoryTheory.MorphismProperty.Over.w g₁
          have hw₂ : g₂.left ≫ U.hom = V₂.hom := CategoryTheory.MorphismProperty.Over.w g₂
          rw [← hw₁, ← hw₂, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition]
        let π₂ : W_et ⟶ V₂ := CategoryTheory.MorphismProperty.Over.homMk snd_W h_snd_w
        have hπ_eq : π₁ ≫ g₁ = π₂ ≫ g₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ h_eq
        have hc := hcompat π₁ π₂ hg₁ hg₂ hπ_eq
        have hcz : (L_pre.map π₁.op (fam' g₁ hg₁)) z = (L_pre.map π₂.op (fam' g₂ hg₂)) z :=
          congrArg (fun (q : LocallyConstant ↥W_et.left ↥Am) => q z) hc
        change fam' g₁ hg₁ (fst_W.base z) = fam' g₂ hg₂ (snd_W.base z) at hcz
        rwa [hz₁, hz₂] at hcz
      let s₀_fun : ↥U.left → ↥Am := fun x =>
        fam' (hsurj x).choose_spec.choose (hsurj x).choose_spec.choose_spec.1
          (hsurj x).choose_spec.choose_spec.2.choose
      have hs₀_spec : ∀ {V : X.Etale} (g : V ⟶ U) (hg : R g) (y : ↥V.left),
          s₀_fun (g.left.base y) = fam' g hg y := by
        intro V g hg y
        dsimp [s₀_fun]
        exact hagree _ _ g hg _ y
          (hsurj (g.left.base y)).choose_spec.choose_spec.2.choose_spec
      have hs₀_lc : IsLocallyConstant s₀_fun := by
        intro E
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        obtain ⟨V, g, hg, y, rfl⟩ := hsurj x
        have hyE : y ∈ (fam' g hg) ⁻¹' E := by
          change fam' g hg y ∈ E
          rw [← hs₀_spec g hg y]
          exact hx
        refine ⟨⇑g.left.base '' ((fam' g hg) ⁻¹' E), ?_,
          hOpenHom g _ ((fam' g hg).isLocallyConstant E), ⟨y, hyE, rfl⟩⟩
        rintro _ ⟨y', hy', rfl⟩
        change s₀_fun (g.left.base y') ∈ E
        rw [hs₀_spec g hg y']
        exact hy'
      refine ⟨⟨s₀_fun, hs₀_lc⟩, fun {V} g hg => ?_, fun t ht => ?_⟩
      · apply LocallyConstant.ext
        intro y
        exact hs₀_spec g hg y
      · apply LocallyConstant.ext
        intro x
        obtain ⟨V, g, hg, y, rfl⟩ := hsurj x
        let t' : LocallyConstant ↥U.left ↥Am := t
        have hti : fam' g hg y = t' (g.left.base y) :=
          (congrArg (fun (q : LocallyConstant ↥V.left ↥Am) => q y) (ht g hg)).symm
        exact hti.symm.trans (hs₀_spec g hg y).symm
    let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨L_pre, hL_sheaf⟩
    let ι_Am : Am ⟶ L_pre.obj (Opposite.op T_std) :=
      AddCommGrpCat.ofHom LocallyConstant.constAddMonoidHom
    let η_Am : Am ⟶ Fm.obj.obj (Opposite.op T_std) := adj.unit.app Am
    let Φ_hom : Fm ⟶ L_sh := (adj.homEquiv Am L_sh).symm ι_Am
    have hΦ_unit : η_Am ≫ Φ_hom.hom.app (Opposite.op T_std) = ι_Am :=
      (adj.homEquiv_unit Am L_sh Φ_hom).symm.trans ((adj.homEquiv Am L_sh).apply_symm_apply ι_Am)
    have hFm_type : CategoryTheory.Presieve.IsSheaf J
        (Fm.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J Fm.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) Fm.cond)
    have hFm_arrows : ∀ (U : X.Etale) {ι : Type u} (Y : ι → X.Etale) (f : ∀ i, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (f i).left.base y = x) →
        CategoryTheory.Presieve.IsSheafFor
          (Fm.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
          (CategoryTheory.Presieve.ofArrows Y f) := by
      intro U ι Y f hsurj
      have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y f) ∈ J U := by
        rw [hJ_eq, CategoryTheory.Pretopology.mem_toGrothendieck]
        exact ⟨_, hArrowsMem U Y f hsurj, CategoryTheory.Sieve.le_generate _⟩
      exact (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (hFm_type _ hcov)
    have hFm_subsingleton_of_empty : ∀ (Z : X.Etale),
        IsEmpty ↥Z.left → Subsingleton ↥(Fm.obj.obj (Opposite.op Z)) := by
      intro Z hEmpty
      have hsh := (CategoryTheory.Presieve.isSheafFor_arrows_iff _ _).mp
        (hFm_arrows Z (fun _ : ↥Z.left => Z) (fun _ => 𝟙 Z) (fun x => hEmpty.elim x))
      refine ⟨fun a₁ a₂ => ?_⟩
      obtain ⟨_, _, huniq⟩ := hsh (fun z => hEmpty.elim z) (fun z => hEmpty.elim z)
      exact (huniq a₁ (fun z => hEmpty.elim z)).trans (huniq a₂ (fun z => hEmpty.elim z)).symm
    let W_open : ∀ (U : X.Etale), LocallyConstant ↥U.left ↥Am → ↥U.left → U.left.Opens :=
      fun U s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
    let W_et : ∀ (U : X.Etale), LocallyConstant ↥U.left ↥Am → ↥U.left → X.Etale :=
      fun U s x =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((W_open U s x).ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (W_open U s x).ι U.hom inferInstance U.prop)
    let j_et : ∀ (U : X.Etale) (s : LocallyConstant ↥U.left ↥Am) (x : ↥U.left),
        W_et U s x ⟶ U :=
      fun U s x => CategoryTheory.MorphismProperty.Over.homMk (W_open U s x).ι rfl
    have hj_surj : ∀ (U : X.Etale) (s : LocallyConstant ↥U.left ↥Am) (x : ↥U.left),
        ∃ (i : ↥U.left) (y : ↥(W_et U s i).left), (j_et U s i).left.base y = x :=
      fun U s x => ⟨x, ⟨x, rfl⟩, rfl⟩
    let σ_loc : ∀ (U : X.Etale) (s : LocallyConstant ↥U.left ↥Am) (x : ↥U.left),
        ↥(Fm.obj.obj (Opposite.op (W_et U s x))) :=
      fun U s x => Fm.obj.map (hT_std.from (W_et U s x)).op (η_Am (s x))
    have hσ_compat : ∀ (U : X.Etale) (s : LocallyConstant ↥U.left ↥Am)
        (x₁ x₂ : ↥U.left) (Z : X.Etale) (g₁ : Z ⟶ W_et U s x₁) (g₂ : Z ⟶ W_et U s x₂),
        g₁ ≫ j_et U s x₁ = g₂ ≫ j_et U s x₂ →
        Fm.obj.map g₁.op (σ_loc U s x₁) = Fm.obj.map g₂.op (σ_loc U s x₂) := by
      intro U s x₁ x₂ Z g₁ g₂ hgg
      by_cases hne : Nonempty ↥Z.left
      · obtain ⟨z₀⟩ := hne
        have hs₁ : s ((g₁ ≫ j_et U s x₁).left.base z₀) = s x₁ := (g₁.left.base z₀).2
        have hs₂ : s ((g₂ ≫ j_et U s x₂).left.base z₀) = s x₂ := (g₂.left.base z₀).2
        rw [hgg] at hs₁
        have hsx : s x₁ = s x₂ := hs₁.symm.trans hs₂
        have hterm : g₁ ≫ hT_std.from (W_et U s x₁) = g₂ ≫ hT_std.from (W_et U s x₂) :=
          hT_std.hom_ext _ _
        have hmap : Fm.obj.map (hT_std.from (W_et U s x₁)).op ≫ Fm.obj.map g₁.op =
            Fm.obj.map (hT_std.from (W_et U s x₂)).op ≫ Fm.obj.map g₂.op := by
          rw [← Fm.obj.map_comp, ← Fm.obj.map_comp, ← op_comp, ← op_comp, hterm]
        dsimp only [σ_loc]
        rw [hsx]
        exact congrArg (fun φ => φ (η_Am (s x₂))) hmap
      · haveI := hFm_subsingleton_of_empty Z (not_nonempty_iff.mp hne)
        exact Subsingleton.elim _ _
    have hψ_ex : ∀ (U : X.Etale) (s : LocallyConstant ↥U.left ↥Am),
        ∃! t : ↥(Fm.obj.obj (Opposite.op U)),
          ∀ x : ↥U.left, Fm.obj.map (j_et U s x).op t = σ_loc U s x := by
      intro U s
      exact ((CategoryTheory.Presieve.isSheafFor_arrows_iff _ _).mp
        (hFm_arrows U (W_et U s) (j_et U s) (hj_surj U s))) (σ_loc U s) (hσ_compat U s)
    let ψ_fun : ∀ (U : X.Etale), LocallyConstant ↥U.left ↥Am → ↥(Fm.obj.obj (Opposite.op U)) :=
      fun U s => (hψ_ex U s).choose
    have hψ_spec : ∀ (U : X.Etale) (s : LocallyConstant ↥U.left ↥Am) (x : ↥U.left),
        Fm.obj.map (j_et U s x).op (ψ_fun U s) = σ_loc U s x :=
      fun U s => (hψ_ex U s).choose_spec.1
    have hψ_const : ∀ {V U : X.Etale} (g : V ⟶ U) (s : LocallyConstant ↥U.left ↥Am) (a : ↥Am),
        (∀ y : ↥V.left, s (g.left.base y) = a) →
        Fm.obj.map g.op (ψ_fun U s) = Fm.obj.map (hT_std.from V).op (η_Am a) := by
      intro V U g s a hconst
      by_cases hne : Nonempty ↥V.left
      · obtain ⟨y₀⟩ := hne
        let x₀ : ↥U.left := g.left.base y₀
        have ha₀ : s x₀ = a := hconst y₀
        have hrange : Set.range ⇑g.left.base ⊆ Set.range ⇑(W_open U s x₀).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨y, rfl⟩
          change s (g.left.base y) = s x₀
          rw [hconst y, ha₀]
        let l₀ : V.left ⟶ (W_open U s x₀ : AlgebraicGeometry.Scheme.{u}) :=
          AlgebraicGeometry.IsOpenImmersion.lift (W_open U s x₀).ι g.left hrange
        have hl₀_fac : l₀ ≫ (W_open U s x₀).ι = g.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (W_open U s x₀).ι g.left hrange
        have hl₀_w : l₀ ≫ (W_et U s x₀).hom = V.hom := by
          change l₀ ≫ ((W_open U s x₀).ι ≫ U.hom) = V.hom
          rw [← CategoryTheory.Category.assoc, hl₀_fac]
          exact CategoryTheory.MorphismProperty.Over.w g
        let l_et : V ⟶ W_et U s x₀ := CategoryTheory.MorphismProperty.Over.homMk l₀ hl₀_w
        have hl_eq : l_et ≫ j_et U s x₀ = g :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hl₀_fac
        have hterm : l_et ≫ hT_std.from (W_et U s x₀) = hT_std.from V := hT_std.hom_ext _ _
        have hmap₁ : Fm.obj.map g.op = Fm.obj.map (j_et U s x₀).op ≫ Fm.obj.map l_et.op := by
          rw [← hl_eq, op_comp, Fm.obj.map_comp]
        have hmap₂ : Fm.obj.map (hT_std.from (W_et U s x₀)).op ≫ Fm.obj.map l_et.op =
            Fm.obj.map (hT_std.from V).op := by
          rw [← Fm.obj.map_comp, ← op_comp, hterm]
        calc
          Fm.obj.map g.op (ψ_fun U s)
            = Fm.obj.map l_et.op (Fm.obj.map (j_et U s x₀).op (ψ_fun U s)) :=
              congrArg (fun φ => φ (ψ_fun U s)) hmap₁
          _ = Fm.obj.map l_et.op (Fm.obj.map (hT_std.from (W_et U s x₀)).op (η_Am a)) := by
              rw [hψ_spec U s x₀]
              dsimp [σ_loc]
              rw [ha₀]
          _ = Fm.obj.map (hT_std.from V).op (η_Am a) :=
              congrArg (fun φ => φ (η_Am a)) hmap₂
      · haveI := hFm_subsingleton_of_empty V (not_nonempty_iff.mp hne)
        exact Subsingleton.elim _ _
    have hψ_zero : ∀ (U : X.Etale), ψ_fun U 0 = 0 := by
      intro U
      have h1 := hψ_const (𝟙 U) 0 0 (fun _ => rfl)
      simp only [op_id, Fm.obj.map_id, AddCommGrpCat.id_apply, map_zero] at h1
      exact h1
    have hψ_add : ∀ (U : X.Etale) (s₁ s₂ : LocallyConstant ↥U.left ↥Am),
        ψ_fun U (s₁ + s₂) = ψ_fun U s₁ + ψ_fun U s₂ := by
      intro U s₁ s₂
      let W₁₂ : ↥U.left → U.left.Opens := fun x => W_open U s₁ x ⊓ W_open U s₂ x
      let W₁₂_et : ↥U.left → X.Etale := fun x =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((W₁₂ x).ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (W₁₂ x).ι U.hom inferInstance U.prop)
      let j₁₂ : ∀ x : ↥U.left, W₁₂_et x ⟶ U :=
        fun x => CategoryTheory.MorphismProperty.Over.homMk (W₁₂ x).ι rfl
      have hj₁₂_surj : ∀ x : ↥U.left, ∃ (i : ↥U.left) (y : ↥(W₁₂_et i).left),
          (j₁₂ i).left.base y = x := fun x => ⟨x, ⟨x, rfl, rfl⟩, rfl⟩
      have hsh := (CategoryTheory.Presieve.isSheafFor_arrows_iff _ _).mp
        (hFm_arrows U W₁₂_et j₁₂ hj₁₂_surj)
      have heq_on : ∀ x : ↥U.left,
          Fm.obj.map (j₁₂ x).op (ψ_fun U (s₁ + s₂)) =
            Fm.obj.map (j₁₂ x).op (ψ_fun U s₁ + ψ_fun U s₂) := by
        intro x
        rw [map_add,
          hψ_const (j₁₂ x) (s₁ + s₂) (s₁ x + s₂ x) (fun y => congrArg₂ (· + ·) y.2.1 y.2.2),
          hψ_const (j₁₂ x) s₁ (s₁ x) (fun y => y.2.1),
          hψ_const (j₁₂ x) s₂ (s₂ x) (fun y => y.2.2),
          ← map_add, ← map_add]
