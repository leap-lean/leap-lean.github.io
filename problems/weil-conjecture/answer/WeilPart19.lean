      ρ 0 = 𝟙 T ∧
      (∀ γ₁ γ₂ : ZMod ℓ, ρ (γ₁ + γ₂) = ρ γ₁ ≫ ρ γ₂) ∧
      (∃ (s_taut : P.obj.obj (Opposite.op U_T)),
        ∀ γ : ZMod ℓ,
