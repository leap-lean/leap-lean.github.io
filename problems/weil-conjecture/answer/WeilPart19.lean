    have hw : ((F_Z.map f).left) ≫ (F_Z.obj U₂).hom = (F_Z.obj U₁).hom := (F_Z.map f).w
    have hfg : AlgebraicGeometry.Etale (((F_Z.map f).left) ≫ (F_Z.obj U₂).hom) := by
