              rw [map_mul]
              exact A_gen.mul_mem ha hb
            one_mem' := by
              change α_B 1 ∈ A_gen
              rw [map_one]
              exact A_gen.one_mem
            add_mem' := fun ha hb => by
              change α_B (_ + _) ∈ A_gen
              rw [map_add]
              exact A_gen.add_mem ha hb
