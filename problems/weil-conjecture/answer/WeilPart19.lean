      exact ⟨AlgEquiv.ofRingEquiv
        (f := { toFun := α_R.toRingHom
                invFun := β_hom
                left_inv := fun z => congrArg (fun h : _ →ₐ[R'] _ => h z) h_ba
                right_inv := fun z => congrArg (fun h : Loc →+* Loc => h z) h_ab
                map_mul' := α_R.map_mul
                map_add' := α_R.map_add })
        (fun b => by
          change α_R (b ⊗ₜ[R'] (1 : E)) = algebraMap BD Loc (algebraMap B BD b)
          dsimp only [α_R]
          rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
          rfl)⟩
    have hClearDenom :
        ∀ {R₀ K₀ E : Type u} [CommRing R₀] [IsDomain R₀] [Field K₀]
          [Algebra R₀ K₀] [IsFractionRing R₀ K₀] [CommRing E] [Algebra R₀ E]
          (z : TensorProduct R₀ K₀ E),
          ∃ (m : R₀), m ≠ 0 ∧ ∃ (e : E), (algebraMap R₀ K₀ m) • z = (1 : K₀) ⊗ₜ[R₀] e := by
      intro R₀ K₀ E _ _ _ _ _ _ _ z
      induction z using TensorProduct.induction_on with
      | zero =>
        exact ⟨1, one_ne_zero, 0, by simp⟩
      | tmul k e =>
        obtain ⟨⟨a, m⟩, ham⟩ := IsLocalization.surj (nonZeroDivisors R₀) k
        have hm_ne : (m : R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp m.2
        refine ⟨m.1, hm_ne, a • e, ?_⟩
        calc
          (algebraMap R₀ K₀ m.1) • (k ⊗ₜ[R₀] e) =
              ((algebraMap R₀ K₀ m.1) ⊗ₜ[R₀] (1 : E)) * (k ⊗ₜ[R₀] e) := by
            rw [Algebra.smul_def]; rfl
          _ = (k * algebraMap R₀ K₀ m.1) ⊗ₜ[R₀] e := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm]
          _ = (algebraMap R₀ K₀ a) ⊗ₜ[R₀] e := by rw [ham]
          _ = (a • (1 : K₀)) ⊗ₜ[R₀] e := by rw [Algebra.smul_def, mul_one]
          _ = (1 : K₀) ⊗ₜ[R₀] (a • e) := TensorProduct.smul_tmul a (1 : K₀) e
      | add z₁ z₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨m₁, hm₁, e₁, he₁⟩
        rcases ih₂ with ⟨m₂, hm₂, e₂, he₂⟩
        refine ⟨m₁ * m₂, mul_ne_zero hm₁ hm₂, m₂ • e₁ + m₁ • e₂, ?_⟩
        have hsm : ∀ (r : R₀) (x : E),
            (algebraMap R₀ K₀ r) • ((1 : K₀) ⊗ₜ[R₀] x) = (1 : K₀) ⊗ₜ[R₀] (r • x) := fun r x => by
          rw [Algebra.smul_def]
          change ((algebraMap R₀ K₀ r) ⊗ₜ[R₀] (1 : E)) * ((1 : K₀) ⊗ₜ[R₀] x) = _
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
            show algebraMap R₀ K₀ r = r • (1 : K₀) by rw [Algebra.smul_def, mul_one],
            TensorProduct.smul_tmul]
        rw [map_mul, smul_add, mul_comm (algebraMap R₀ K₀ m₁), mul_smul, he₁, hsm,
          mul_comm (algebraMap R₀ K₀ m₂), mul_smul, he₂, hsm, TensorProduct.tmul_add]
    have hKillTorsion :
        ∀ {R₀ K₀ E : Type u} [CommRing R₀] [IsDomain R₀] [Field K₀]
          [Algebra R₀ K₀] [IsFractionRing R₀ K₀] [CommRing E] [Algebra R₀ E]
          (e : E),
          (1 : K₀) ⊗ₜ[R₀] e = (0 : TensorProduct R₀ K₀ E) →
          ∃ (m : R₀), m ≠ 0 ∧ m • e = 0 := by
      intro R₀ K₀ E _ _ _ _ _ _ _ e he0
      haveI : IsLocalization (Algebra.algebraMapSubmonoid E (nonZeroDivisors R₀))
          (TensorProduct R₀ E K₀) :=
        IsLocalization.tensor (S := E) K₀ (nonZeroDivisors R₀)
      have h0' : algebraMap E (TensorProduct R₀ E K₀) e = 0 := by
        change e ⊗ₜ[R₀] (1 : K₀) = 0
        have hcomm := congrArg (Algebra.TensorProduct.comm R₀ K₀ E) he0
        simpa using hcomm
      obtain ⟨⟨mE, hmE⟩, hmul0⟩ :=
        (IsLocalization.map_eq_zero_iff
          (Algebra.algebraMapSubmonoid E (nonZeroDivisors R₀))
          (TensorProduct R₀ E K₀) e).mp h0'
      rcases hmE with ⟨m, hm_nzd, rfl⟩
      refine ⟨m, mem_nonZeroDivisors_iff_ne_zero.mp hm_nzd, ?_⟩
      rwa [Algebra.smul_def]
    have hHomogEval :
        ∀ {R₀ A : Type u} [CommRing R₀] [CommRing A] [Algebra R₀ A]
          {n : ℕ} (c : R₀) (z : Fin n → A) (F : MvPolynomial (Fin n) R₀),
          ∃ (N : ℕ) (a : A),
            ∀ {T : Type u} [CommRing T] [Algebra R₀ T]
              (ι : A →ₐ[R₀] T) (u : T),
              algebraMap R₀ T c * u = 1 →
              (algebraMap R₀ T c) ^ N * MvPolynomial.aeval (fun i => u * ι (z i)) F = ι a := by
      intro R₀ A _ _ _ n c z F
      induction F using MvPolynomial.induction_on with
      | C r =>
        refine ⟨0, algebraMap R₀ A r, fun ι u _ => ?_⟩
        simp [ι.commutes]
      | add F₁ F₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨N₁, a₁, h₁⟩
        rcases ih₂ with ⟨N₂, a₂, h₂⟩
        refine ⟨N₁ + N₂, c ^ N₂ • a₁ + c ^ N₁ • a₂, fun {T} _ _ ι u hcu => ?_⟩
        have e₁ := h₁ ι u hcu
        have e₂ := h₂ ι u hcu
        calc
          (algebraMap R₀ T c) ^ (N₁ + N₂) *
              MvPolynomial.aeval (fun i => u * ι (z i)) (F₁ + F₂) =
            (algebraMap R₀ T c) ^ N₂ *
                ((algebraMap R₀ T c) ^ N₁ * MvPolynomial.aeval (fun i => u * ι (z i)) F₁) +
              (algebraMap R₀ T c) ^ N₁ *
                ((algebraMap R₀ T c) ^ N₂ * MvPolynomial.aeval (fun i => u * ι (z i)) F₂) := by
            rw [map_add, pow_add]; ring
          _ = (algebraMap R₀ T c) ^ N₂ * ι a₁ + (algebraMap R₀ T c) ^ N₁ * ι a₂ := by
            rw [e₁, e₂]
          _ = ι (c ^ N₂ • a₁ + c ^ N₁ • a₂) := by
            simp [Algebra.smul_def]
      | mul_X F' i ih =>
        rcases ih with ⟨N', a', h'⟩
        refine ⟨N' + 1, a' * z i, fun {T} _ _ ι u hcu => ?_⟩
        have e' := h' ι u hcu
        calc
          (algebraMap R₀ T c) ^ (N' + 1) *
              MvPolynomial.aeval (fun j => u * ι (z j)) (F' * MvPolynomial.X i) =
            ((algebraMap R₀ T c) ^ N' * MvPolynomial.aeval (fun j => u * ι (z j)) F') *
              ((algebraMap R₀ T c * u) * ι (z i)) := by
            rw [map_mul, MvPolynomial.aeval_X, pow_succ]; ring
          _ = ι a' * (1 * ι (z i)) := by rw [e', hcu]
          _ = ι (a' * z i) := by rw [one_mul, map_mul]
    have hAlgHomSpread :
        ∀ {R₀ K₀ A₁_src A₂_dst : Type u}
          [CommRing R₀] [IsDomain R₀] [IsNoetherianRing R₀]
          [Field K₀] [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
          [CommRing A₁_src] [Algebra R₀ A₁_src]
          [CommRing A₂_dst] [Algebra R₀ A₂_dst]
          {m_src : ℕ} (π_src : MvPolynomial (Fin m_src) R₀ →ₐ[R₀] A₁_src)
          (_ : Function.Surjective π_src)
          (f_K : TensorProduct R₀ K₀ A₁_src →ₐ[K₀] TensorProduct R₀ K₀ A₂_dst),
          ∃ (c : R₀) (_ : c ≠ 0) (y : Fin m_src → A₂_dst)
            (h_rel : R₀) (_ : h_rel ≠ 0),
            (∀ v : Fin m_src,
              (algebraMap R₀ K₀ c) • f_K ((1 : K₀) ⊗ₜ[R₀] π_src (MvPolynomial.X v)) =
                (1 : K₀) ⊗ₜ[R₀] y v) ∧
            ∀ (S : Type u) [CommRing S] [Algebra R₀ S]
              (hc_S : IsUnit (algebraMap R₀ S c)),
              IsUnit (algebraMap R₀ S h_rel) →
              ∃ (F_S : TensorProduct R₀ S A₁_src →ₐ[S] TensorProduct R₀ S A₂_dst),
                ∀ (P : MvPolynomial (Fin m_src) R₀),
                  F_S ((1 : S) ⊗ₜ[R₀] π_src P) =
                    MvPolynomial.aeval (fun v => (↑(hc_S.unit⁻¹) : S) ⊗ₜ[R₀] y v) P := by
      intro R₀ K₀ A₁_src A₂_dst _ _ _ _ _ _ _ _ _ _ m_src π_src hSurj_src f_K
      haveI : IsNoetherianRing (MvPolynomial (Fin m_src) R₀) := MvPolynomial.isNoetherianRing
      have hfg_ker : (RingHom.ker π_src.toRingHom).FG := IsNoetherian.noetherian _
      obtain ⟨r_rel, p_rel, hp_span⟩ :=
        Submodule.fg_iff_exists_fin_generating_family.mp hfg_ker
      have h_gen_clear := fun v : Fin m_src =>
        hClearDenom (f_K ((1 : K₀) ⊗ₜ[R₀] π_src (MvPolynomial.X v)))
      choose c_v hc_v y_tilde hy_tilde using h_gen_clear
      let c : R₀ := ∏ v : Fin m_src, c_v v
      have hc_ne : c ≠ 0 := Finset.prod_ne_zero_iff.mpr fun v _ => hc_v v
      let y : Fin m_src → A₂_dst := fun v =>
        (∏ w ∈ Finset.univ.erase v, c_v w) • y_tilde v
      have hy_spec : ∀ v : Fin m_src,
          (algebraMap R₀ K₀ c) • f_K ((1 : K₀) ⊗ₜ[R₀] π_src (MvPolynomial.X v)) =
            (1 : K₀) ⊗ₜ[R₀] y v := by
        intro v
        have hc_split : c = (∏ w ∈ Finset.univ.erase v, c_v w) * c_v v :=
          (Finset.prod_erase_mul Finset.univ c_v (Finset.mem_univ v)).symm
        rw [hc_split, map_mul, mul_smul, hy_tilde v, Algebra.smul_def]
        change ((algebraMap R₀ K₀ (∏ w ∈ Finset.univ.erase v, c_v w)) ⊗ₜ[R₀] (1 : A₂_dst)) *
          ((1 : K₀) ⊗ₜ[R₀] y_tilde v) = (1 : K₀) ⊗ₜ[R₀] y v
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
          show algebraMap R₀ K₀ (∏ w ∈ Finset.univ.erase v, c_v w) =
            (∏ w ∈ Finset.univ.erase v, c_v w) • (1 : K₀) by rw [Algebra.smul_def, mul_one],
          TensorProduct.smul_tmul]
