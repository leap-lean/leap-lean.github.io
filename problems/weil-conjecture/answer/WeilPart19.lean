        (TopologicalSpace.Opens.map μ_K.base).obj
          ((TopologicalSpace.Opens.map q_Y.base).obj (V α)) := by
      ext x
      have hb : (μ_K ≫ q_Y).base x = (q_C ≫ μ_R).base x := by rw [hcommK]
      change (q_C ≫ μ_R).base x ∈ V α ↔ (μ_K ≫ q_Y).base x ∈ V α
