    choose V_x g_x y_x hg_x hy_x using hcovT
    let O : ↥(ι.obj U₀).left → Set ↥(ι.obj U₀).left :=
      fun x => Set.range ⇑(ι.map (g_x x)).left
    have hO_open : ∀ x : ↥(ι.obj U₀).left, IsOpen (O x) := by
      intro x
      have het : AlgebraicGeometry.Etale (ι.map (g_x x)).left := by
        have hw : (ι.map (g_x x)).left ≫ (ι.obj U₀).hom = (ι.obj (V_x x)).hom :=
          CategoryTheory.MorphismProperty.Over.w (ι.map (g_x x))
        have hcomp : P_et ((ι.map (g_x x)).left ≫ (ι.obj U₀).hom) :=
          hw.symm ▸ (ι.obj (V_x x)).prop
        exact CategoryTheory.MorphismProperty.of_postcomp P_et
          (ι.map (g_x x)).left (ι.obj U₀).hom (ι.obj U₀).prop hcomp
      exact (AlgebraicGeometry.Scheme.Hom.isOpenMap (ι.map (g_x x)).left).isOpen_range
    have hO_univ : (Set.univ : Set ↥(ι.obj U₀).left) ⊆ ⋃ x, O x := by
      intro x _
      exact Set.mem_iUnion.mpr ⟨x, y_x x, hy_x x⟩
    have hcomp_U₀ : CompactSpace ↥(ι.obj U₀).left := by
      change CompactSpace ↥(AlgebraicGeometry.Scheme.Spec.obj U₀.left)
      infer_instance
    obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover O hO_open hO_univ
    let n := Fintype.card ↥s
    let e : Fin n ≃ ↥s := (Fintype.equivFin ↥s).symm
    let V : Fin n → S.AffineEtale := fun b => V_x (e b).1
    let π : ∀ b : Fin n, V b ⟶ U₀ := fun b => g_x (e b).1
    refine ⟨n, V, π, fun b => hg_x (e b).1, ?_⟩
    dsimp only [J_aff]
    rw [AlgebraicGeometry.Scheme.AffineEtale.topology,
      CategoryTheory.Functor.mem_inducedTopology_iff_of_isCoverDense ι J]
    have hsub : CategoryTheory.Sieve.ofArrows (fun b => ι.obj (V b)) (fun b => ι.map (π b)) ≤
        CategoryTheory.Sieve.functorPushforward ι (CategoryTheory.Sieve.ofArrows V π) := by
