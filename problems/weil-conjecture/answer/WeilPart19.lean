          have h1 := hq_α ιK uK hcuK
          rw [h_aeval_K] at h1
          change _ * f_K ((1 : K₀) ⊗ₜ[R₀] π_src (p_rel α)) = (1 : K₀) ⊗ₜ[R₀] q_α at h1
          rw [hp_ker, TensorProduct.tmul_zero, map_zero, mul_zero] at h1
