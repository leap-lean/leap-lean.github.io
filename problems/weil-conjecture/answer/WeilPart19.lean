    isUnit_of_dvd_unit (map_dvd (algebraMap A₁ S) ⟨h₁₂, mul_comm h₁₂ a⟩)
      (IsLocalization.Away.algebraMap_isUnit h)
  let φ_R₁_S : R₁ →+* S := IsLocalization.Away.lift h₁₂ hUnit_h₁₂_S
  have hφ_R₁_S_eq : ∀ x : A₁, φ_R₁_S (algebraMap A₁ R₁ x) = algebraMap A₁ S x :=
    fun x => IsLocalization.Away.lift_eq h₁₂ hUnit_h₁₂_S x
  let j_S_R₁ : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R₁_S)
  have hj_fac : j_S_R₁ ≫ j₁₂ = j_h := by
    dsimp [j_S_R₁, j₁₂, j_h]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 1
    ext x
    exact hφ_R₁_S_eq x
  have hUnit_prod_S : IsUnit (φ_R₁_S h_prod_R₁) := by
    have hmul : φ_R₁_S h_prod_R₁ * φ_R₁_S (algebraMap A₁ R₁ d_pow) = algebraMap A₁ S a := by
      rw [← map_mul, h_surj, hφ_R₁_S_eq]
    exact isUnit_of_mul_isUnit_left (hmul.symm ▸ hUnit_a_S)
  have hUnit_h₃₄₅_S : IsUnit (φ_R₁_S h₃ * φ_R₁_S h₄ * φ_R₁_S h₅) := by
    have hm : φ_R₁_S h_prod_R₁ = (φ_R₁_S h₃ * φ_R₁_S h₄ * φ_R₁_S h₅) * φ_R₁_S h₆ := by
      dsimp [h_prod_R₁]; simp only [map_mul]
    exact isUnit_of_mul_isUnit_left (hm ▸ hUnit_prod_S)
  have hUnit_h₆_S : IsUnit (φ_R₁_S h₆) := by
    have hm : φ_R₁_S h_prod_R₁ = (φ_R₁_S h₃ * φ_R₁_S h₄ * φ_R₁_S h₅) * φ_R₁_S h₆ := by
      dsimp [h_prod_R₁]; simp only [map_mul]
    exact isUnit_of_mul_isUnit_right (hm ▸ hUnit_prod_S)
  have hUnit_h₃₄_S : IsUnit (φ_R₁_S h₃ * φ_R₁_S h₄) :=
    isUnit_of_mul_isUnit_left hUnit_h₃₄₅_S
  have hUnit_h₅_S : IsUnit (φ_R₁_S h₅) :=
    isUnit_of_mul_isUnit_right hUnit_h₃₄₅_S
  have hUnit_h₃_S : IsUnit (φ_R₁_S h₃) :=
    isUnit_of_mul_isUnit_left hUnit_h₃₄_S
  have hUnit_h₄_S : IsUnit (φ_R₁_S h₄) :=
    isUnit_of_mul_isUnit_right hUnit_h₃₄_S
  let Y_h := CategoryTheory.Limits.pullback f_init' j_h
  let fst_Yh : Y_h ⟶ Y_init := CategoryTheory.Limits.pullback.fst f_init' j_h
  let snd_Yh : Y_h ⟶ AlgebraicGeometry.Spec (CommRingCat.of S) :=
    CategoryTheory.Limits.pullback.snd f_init' j_h
  let Y_red := CategoryTheory.Limits.pullback i_red_init fst_Yh
  let i_red : Y_red ⟶ Y_h := CategoryTheory.Limits.pullback.snd i_red_init fst_Yh
  let q_Yred_h_init : Y_red ⟶ Y_red_init := CategoryTheory.Limits.pullback.fst i_red_init fst_Yh
  let f_YS : Y_red ⟶ AlgebraicGeometry.Spec (CommRingCat.of S) := i_red ≫ snd_Yh
  have hpYred_h_init : CategoryTheory.IsPullback q_Yred_h_init f_YS f_red_init j_h :=
    (CategoryTheory.IsPullback.of_hasPullback i_red_init fst_Yh).paste_vert
      (CategoryTheory.IsPullback.of_hasPullback f_init' j_h)
  let q_YS : Y_red ⟶ Y_R₁ :=
    CategoryTheory.Limits.pullback.lift q_Yred_h_init (f_YS ≫ j_S_R₁)
      (by rw [CategoryTheory.Category.assoc, hj_fac]; exact hpYred_h_init.w)
  have hpYS : CategoryTheory.IsPullback q_YS f_YS f_Y_R₁ j_S_R₁ :=
    isPullback_factor hj_fac hpYred_h_init
  let W_bad := CategoryTheory.Limits.pullback q_YS i_WR₁
  let i_W : W_bad ⟶ Y_red := CategoryTheory.Limits.pullback.fst q_YS i_WR₁
  let q_WS : W_bad ⟶ W_R₁ := CategoryTheory.Limits.pullback.snd q_YS i_WR₁
  let C_S : Fin s → AlgebraicGeometry.Scheme.{u} :=
    fun j => CategoryTheory.Limits.pullback (f_C_R₁ j) j_S_R₁
  let q_CS : ∀ j : Fin s, C_S j ⟶ C_R₁ j :=
    fun j => CategoryTheory.Limits.pullback.fst (f_C_R₁ j) j_S_R₁
  let f_CS : ∀ j : Fin s, C_S j ⟶ Z₁.left :=
    fun j => CategoryTheory.Limits.pullback.snd (f_C_R₁ j) j_S_R₁
  have hpCS : ∀ j : Fin s,
      CategoryTheory.IsPullback (q_CS j) (f_CS j) (f_C_R₁ j) j_S_R₁ :=
    fun j => CategoryTheory.IsPullback.of_hasPullback (f_C_R₁ j) j_S_R₁
  let C : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    fun j => CategoryTheory.Over.mk (f_CS j ≫ Z₁.hom)
  let f_bar : ∀ j : Fin s, C j ⟶ Z₁ :=
    fun j => CategoryTheory.Over.homMk (f_CS j) rfl
  let μ : ∀ j : Fin s, (C j).left ⟶ Y_red := fun j =>
    hpYS.lift (q_CS j ≫ μ_R₁ j) (f_CS j)
      (by rw [CategoryTheory.Category.assoc, hμ_R₁_comp j]; exact (hpCS j).w)
  have hμ_qYS : ∀ j : Fin s, μ j ≫ q_YS = q_CS j ≫ μ_R₁ j :=
    fun j => hpYS.lift_fst _ _ _
  have hμ_fYS : ∀ j : Fin s, μ j ≫ f_YS = f_CS j :=
    fun j => hpYS.lift_snd _ _ _
  let U_comp : Fin s → Y_red.Opens :=
    fun j => (TopologicalSpace.Opens.map q_YS.base).obj (U_R₁ j)
  obtain ⟨hCl_iW, hUniv_μS, hU_subS, hCompl_subS, hDisj_US, hEmpty_preS⟩ :=
    hPart_transfer S φ_R₁_S hUnit_h₄_S Y_red q_YS f_YS C_S q_CS f_CS μ
      hpYS hpCS hμ_qYS hμ_fYS
  have h_c3 := fun j : Fin s =>
    hTransfer j h hh_ne
      (dvd_trans (Finset.dvd_prod_of_mem _ (Finset.mem_univ j))
        (dvd_trans ⟨h₂, rfl⟩ ⟨a, rfl⟩))
      (C_S j) (q_CS j ≫ q_C_R₁_init j) (f_CS j)
      (by
        have hp := (hpCS j).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback (f_C_init j) j₁₂)
        rwa [hj_fac] at hp)
  refine ⟨Y_red, W_bad, i_red, i_W, C, f_bar, μ, U_comp,
    inferInstance, inferInstance, hCl_iW, ?_, ?_, ?_, ?_, ?_, ?_,
    hUniv_μS, hU_subS, hCompl_subS, hDisj_US, hEmpty_preS, ?_⟩
  · have hpWS_base : CategoryTheory.IsPullback q_WS (i_W ≫ f_YS) (π_W ≫ fst_XR₁) j_S_R₁ := by
      rw [hπ_W_fst]
      exact (CategoryTheory.IsPullback.of_hasPullback q_YS i_WR₁).flip.paste_vert hpYS
    exact hFinW_transfer S φ_R₁_S hUnit_h₆_S W_bad q_WS (i_W ≫ f_YS) hpWS_base
  · intro j
    have hUnit_j : IsUnit (φ_R₁_S (h₃_j j)) := by
      have hdvd : φ_R₁_S (h₃_j j) ∣ φ_R₁_S h₃ :=
        map_dvd φ_R₁_S (Finset.dvd_prod_of_mem _ (Finset.mem_univ j))
      exact isUnit_of_dvd_unit hdvd hUnit_h₃_S
    exact hFin_μ_transfer j S φ_R₁_S hUnit_j (C_S j) Y_red
      (q_CS j) (f_CS j) q_YS f_YS (μ j) (hpCS j) hpYS (hμ_qYS j) (hμ_fYS j)
  · intro j
    exact hμ_fYS j
  · intro j
    exact (h_c3 j).1
  · intro j
    obtain ⟨ι_h, hCl_ιh, hFac_ιh⟩ := (h_c3 j).2.1
    exact ⟨N_init j, ι_h, hCl_ιh, hFac_ιh⟩
  · intro j
    exact (h_c3 j).2.2
  · intro j
    have hUnit_j : IsUnit (φ_R₁_S (h₅_j j)) := by
      have hdvd : φ_R₁_S (h₅_j j) ∣ φ_R₁_S h₅ :=
        map_dvd φ_R₁_S (Finset.dvd_prod_of_mem _ (Finset.mem_univ j))
      exact isUnit_of_dvd_unit hdvd hUnit_h₅_S
    exact hOpenIso_transfer j S φ_R₁_S hUnit_j (C_S j) Y_red
      (q_CS j) (f_CS j) q_YS f_YS (μ j) (U_comp j)
      (hpCS j) hpYS (hμ_qYS j) (hμ_fYS j) rfl

theorem weil_etale_p1_finite_cover_geometric_curve_resolution_spread_out (k : Type u) [Field k] [IsAlgClosed k]
    (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine Z₀.left]
    [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
    (hIntZ₀ : AlgebraicGeometry.IsIntegral Z₀.left)
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback Z₀.hom (weilProjectiveSpaceOver k 1).hom)
    (hIntY : AlgebraicGeometry.IsIntegral Y)
    (hFinπ : AlgebraicGeometry.IsFinite π) :
    let p₁₀ := CategoryTheory.Limits.pullback.fst Z₀.hom (weilProjectiveSpaceOver k 1).hom
    let f_Y := π ≫ p₁₀
    (∃ (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsAffine Z₁.left)
        (_ : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom)
        (_ : AlgebraicGeometry.IsIntegral Z₁.left)
        (g : Z₁ ⟶ Z₀),
      Function.Injective
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) ∧
      (∀ x : ↑(Z₁.left.presheaf.obj (Opposite.op ⊤)),
        ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
          p ≠ 0 ∧
          Polynomial.eval₂
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) x p = 0) ∧
      AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd f_Y g.left)) ∨
    (∃ (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : AlgebraicGeometry.IsAffine Z₁.left)
        (_ : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom)
        (d₁ : ℕ) (_ : AlgebraicGeometry.SmoothOfRelativeDimension d₁ Z₁.hom)
        (_ : AlgebraicGeometry.IsIntegral Z₁.left)
        (g : Z₁ ⟶ Z₀)
        (Y_red W_bad : AlgebraicGeometry.Scheme.{u})
        (i_red : Y_red ⟶ CategoryTheory.Limits.pullback f_Y g.left)
        (i_W : W_bad ⟶ Y_red)
        (s : ℕ)
        (C : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (f_bar : ∀ j : Fin s, C j ⟶ Z₁)
        (μ : ∀ j : Fin s, (C j).left ⟶ Y_red)
        (U_comp : Fin s → Y_red.Opens),
      Function.Injective
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) ∧
      (∀ x : ↑(Z₁.left.presheaf.obj (Opposite.op ⊤)),
        ∃ p : Polynomial ↑(Z₀.left.presheaf.obj (Opposite.op ⊤)),
          p ≠ 0 ∧
          Polynomial.eval₂
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop g.left)) x p = 0) ∧
      AlgebraicGeometry.IsClosedImmersion i_red ∧
      AlgebraicGeometry.Surjective i_red ∧
      AlgebraicGeometry.IsClosedImmersion i_W ∧
      AlgebraicGeometry.IsFinite
        (i_W ≫ i_red ≫ CategoryTheory.Limits.pullback.snd f_Y g.left) ∧
      (∀ j : Fin s, AlgebraicGeometry.IsFinite (μ j)) ∧
      (∀ j : Fin s,
        μ j ≫ i_red ≫ CategoryTheory.Limits.pullback.snd f_Y g.left = (f_bar j).left) ∧
      (∀ j : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension 1 (f_bar j).left) ∧
      (∀ j : Fin s,
        ∃ (N : ℕ) (ι : (C j).left ⟶
            CategoryTheory.Limits.pullback Z₁.hom (weilProjectiveSpaceOver k N).hom),
          AlgebraicGeometry.IsClosedImmersion ι ∧
          ι ≫ CategoryTheory.Limits.pullback.fst Z₁.hom (weilProjectiveSpaceOver k N).hom =
            (f_bar j).left) ∧
      (∀ j : Fin s,
        ∃ (Ω₀ : Type u) (_ : Field Ω₀) (_ : IsAlgClosed Ω₀)
            (η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z₁.left),
          DenseRange η.base ∧
          AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback (f_bar j).left η)) ∧
      (⋃ j : Fin s, Set.range (μ j).base) = Set.univ ∧
      (∀ j : Fin s, (U_comp j : Set Y_red) ⊆ (Set.range i_W.base)ᶜ) ∧
      ((Set.range i_W.base)ᶜ : Set Y_red) ⊆ (⋃ j : Fin s, (U_comp j : Set Y_red)) ∧
      (∀ i j : Fin s, i ≠ j → Disjoint (U_comp i) (U_comp j)) ∧
      (∀ i j : Fin s, i ≠ j → ((μ j).base) ⁻¹' (U_comp i : Set Y_red) = ∅) ∧
      (∀ j : Fin s, CategoryTheory.IsIso ((μ j) ∣_ (U_comp j)))) :=
by
  rcases weil_p1_finite_cover_branch1_or_flat_generic_fiber k Z₀ hIntZ₀ Y π hIntY hFinπ with
    hBr1 | ⟨K₀, hFieldK₀, ι₀, hFrac₀, π_K₀, hFinK₀, hFlatK₀, hSurjK₀⟩
  · exact Or.inl hBr1
  · right
    let _ : Field K₀ := hFieldK₀
    let P₁ := weilProjectiveSpaceOver k 1
    let p₁₀ := CategoryTheory.Limits.pullback.fst Z₀.hom P₁.hom
    let p₂₀ := CategoryTheory.Limits.pullback.snd Z₀.hom P₁.hom
    let f_Y := π ≫ p₁₀
    let ξ₀ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ Z₀.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀) ≫ Z₀.left.isoSpec.inv
    let Y_K₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)) :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_Y ξ₀)
    obtain ⟨K₁, hFieldK₁, hAlgK₀K₁, hFinDimK₁, Ω₀, hFieldΩ₀, hAlgClΩ₀, τ,
      s, C_K₁, μ_K₁, U_comp_K₁, hInt_CK₁, hProj_CK₁, hSm_CK₁, hGeomInt_CK₁,
      hFin_μK₁, hComp_μK₁, hUniv_μK₁, hFin_badK₁, hDisj_UK₁, hEmpty_preK₁, hIso_μK₁⟩ :=
      weil_p1_flat_generic_fiber_curve_resolution_over_ext K₀ Y_K₀ π_K₀ hFinK₀ hFlatK₀ hSurjK₀
    let _ : Field K₁ := hFieldK₁
    let _ : Algebra K₀ K₁ := hAlgK₀K₁
    have _ : FiniteDimensional K₀ K₁ := hFinDimK₁
    let _ : Field Ω₀ := hFieldΩ₀
    have _ : IsAlgClosed Ω₀ := hAlgClΩ₀
    obtain ⟨A₁, hCommRingA₁, hDomA₁, hAlgkA₁, hFTkA₁, d₁, hSmA₁,
      hAlgA₁K₁, hFrac₁, g_init, hAlg_loc, hGenComm⟩ :=
      weil_smooth_affine_model_of_finite_fraction_ext k Z₀ hIntZ₀ K₀ ι₀ hFrac₀ K₁
    let _ : CommRing A₁ := hCommRingA₁
    have _ : IsDomain A₁ := hDomA₁
    let _ : Algebra k A₁ := hAlgkA₁
    have _ : Algebra.FiniteType k A₁ := hFTkA₁
    let _ : Algebra A₁ K₁ := hAlgA₁K₁
    have _ : IsFractionRing A₁ K₁ := hFrac₁
    have _ : AlgebraicGeometry.IsFinite π := hFinπ
    let S_init : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
    let X_init := CategoryTheory.Limits.pullback S_init.hom P₁.hom
    let p₁_init := CategoryTheory.Limits.pullback.fst S_init.hom P₁.hom
    let p₂_init := CategoryTheory.Limits.pullback.snd S_init.hom P₁.hom
    have hX_comm : (p₁_init ≫ g_init.left) ≫ Z₀.hom = p₂_init ≫ P₁.hom := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w g_init]
      exact CategoryTheory.Limits.pullback.condition
    let q_X : X_init ⟶ CategoryTheory.Limits.pullback Z₀.hom P₁.hom :=
      CategoryTheory.Limits.pullback.lift (p₁_init ≫ g_init.left) p₂_init hX_comm
    have hpX_tot : CategoryTheory.IsPullback (q_X ≫ p₂₀) p₁_init P₁.hom (g_init.left ≫ Z₀.hom) := by
      have h1 : q_X ≫ p₂₀ = p₂_init := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h2 : g_init.left ≫ Z₀.hom = S_init.hom := CategoryTheory.Over.w g_init
      rw [h1, h2]
      exact (CategoryTheory.IsPullback.of_hasPullback S_init.hom P₁.hom).flip
    have hpX : CategoryTheory.IsPullback q_X p₁_init p₁₀ g_init.left :=
      CategoryTheory.IsPullback.of_right hpX_tot
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback Z₀.hom P₁.hom).flip
    let Y_init := CategoryTheory.Limits.pullback f_Y g_init.left
    let r₁ := CategoryTheory.Limits.pullback.fst f_Y g_init.left
    let f_init₀ := CategoryTheory.Limits.pullback.snd f_Y g_init.left
    have hY_comm : (r₁ ≫ π) ≫ p₁₀ = f_init₀ ≫ g_init.left := by
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.Limits.pullback.condition
    let π_init : Y_init ⟶ X_init := hpX.lift (r₁ ≫ π) f_init₀ hY_comm
    have hπ_q : π_init ≫ q_X = r₁ ≫ π := hpX.lift_fst (r₁ ≫ π) f_init₀ hY_comm
    have hπ_p₁ : π_init ≫ p₁_init = f_init₀ := hpX.lift_snd (r₁ ≫ π) f_init₀ hY_comm
    have hpπ_tot : CategoryTheory.IsPullback (π_init ≫ p₁_init) r₁ g_init.left (π ≫ p₁₀) := by
      rw [hπ_p₁]
      exact (CategoryTheory.IsPullback.of_hasPullback f_Y g_init.left).flip
    have hpπ : CategoryTheory.IsPullback π_init r₁ q_X π :=
      CategoryTheory.IsPullback.of_right hpπ_tot hπ_q hpX.flip
    have hFin_π_init : AlgebraicGeometry.IsFinite π_init :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpπ.flip hFinπ
    have _ : AlgebraicGeometry.IsFinite π_init := hFin_π_init
    let Y_K₁ := (weilBaseChangeOver K₀ K₁ Y_K₀).left
    let e₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K₁))
    let q_YK₁ := CategoryTheory.Limits.pullback.fst Y_K₀.hom e₁
    let h_YK₁ : Y_K₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of K₁) :=
      (weilBaseChangeOver K₀ K₁ Y_K₀).hom
    let ξ_A₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ K₁))
    have hpYK₁_Z₀ : CategoryTheory.IsPullback
        (q_YK₁ ≫ CategoryTheory.Limits.pullback.fst f_Y ξ₀) h_YK₁ f_Y (ξ_A₁ ≫ g_init.left) := by
      have h_eq : e₁ ≫ ξ₀ = ξ_A₁ ≫ g_init.left := by
        dsimp [e₁, ξ₀, ξ_A₁]
        rw [← CategoryTheory.Category.assoc, hGenComm, CategoryTheory.Category.assoc]
      rw [← h_eq]
      exact (CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom e₁).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f_Y ξ₀)
    have hpY_init : CategoryTheory.IsPullback r₁ f_init₀ f_Y g_init.left :=
      CategoryTheory.IsPullback.of_hasPullback f_Y g_init.left
    let p_YK₁ : Y_K₁ ⟶ Y_init :=
      hpY_init.lift (q_YK₁ ≫ CategoryTheory.Limits.pullback.fst f_Y ξ₀)
        (h_YK₁ ≫ ξ_A₁) (by rw [CategoryTheory.Category.assoc]; exact hpYK₁_Z₀.w)
    have hpY₀ : CategoryTheory.IsPullback p_YK₁ h_YK₁ f_init₀ ξ_A₁ := by
      refine CategoryTheory.IsPullback.of_right ?_
        (hpY_init.lift_snd _ _ _) hpY_init
      have h_fst : p_YK₁ ≫ r₁ = q_YK₁ ≫ CategoryTheory.Limits.pullback.fst f_Y ξ₀ :=
        hpY_init.lift_fst _ _ _
      rw [h_fst]
      exact hpYK₁_Z₀
    have hpY : CategoryTheory.IsPullback p_YK₁ h_YK₁ (π_init ≫ p₁_init) ξ_A₁ := by
      rwa [hπ_p₁]
    obtain ⟨h, hh_ne, Y_red, W_bad, i_red₀, i_W, C, f_bar, μ, U_comp,
      hCl_red₀, hSurj_red₀, hCl_W, hFin_W₀, hFin_μ, hComp_μ, hSm_fbar,
      hProj_C, hGenInt_C, hUniv_μ, hU_sub, hCompl_sub, hDisj_U, hEmpty_pre, hIso_μ⟩ :=
      weil_spread_out_p1_curve_resolution_over_fraction_ring k A₁ K₁ Y_init π_init
        Y_K₁ p_YK₁ h_YK₁ hpY Ω₀ τ s C_K₁ μ_K₁ U_comp_K₁
        hInt_CK₁ hProj_CK₁ hSm_CK₁ hGeomInt_CK₁ hFin_μK₁ hComp_μK₁
        hUniv_μK₁ hFin_badK₁ hDisj_UK₁ hEmpty_preK₁ hIso_μK₁
    let j_h : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ S_init.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ (Localization.Away h)))
    let Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (j_h ≫ S_init.hom)
    let j_over : Z₁ ⟶ S_init := CategoryTheory.Over.homMk j_h rfl
    let g : Z₁ ⟶ Z₀ := j_over ≫ g_init
    have hAffZ₁ : AlgebraicGeometry.IsAffine Z₁.left := by
      dsimp [Z₁]
      infer_instance
    have hLftS_init : AlgebraicGeometry.LocallyOfFiniteType S_init.hom := by
      dsimp [S_init]
      rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)]
      change @Algebra.FiniteType k A₁ _ _ (algebraMap k A₁).toAlgebra
      convert hFTkA₁
      exact Algebra.algebra_ext _ _ (fun _ => rfl)
    have hLftZ₁ : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom := by
      dsimp [Z₁]
      have _ : AlgebraicGeometry.LocallyOfFiniteType S_init.hom := hLftS_init
      infer_instance
    have hSmZ₁ : AlgebraicGeometry.SmoothOfRelativeDimension d₁ Z₁.hom := by
      dsimp [Z₁]
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension d₁ S_init.hom := hSmA₁
      exact Nat.zero_add d₁ ▸ AlgebraicGeometry.smoothOfRelativeDimension_comp 0 d₁ j_h S_init.hom
    have hDomLoc : IsDomain (Localization.Away h) :=
      IsLocalization.isDomain_localization
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hh_ne))
    have hIntZ₁ : AlgebraicGeometry.IsIntegral Z₁.left := by
      dsimp [Z₁]
      rw [AlgebraicGeometry.affine_isIntegral_iff]
      exact hDomLoc
    have hp_Z₁ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (π_init ≫ p₁_init) j_h ≫ r₁)
        (CategoryTheory.Limits.pullback.snd (π_init ≫ p₁_init) j_h)
        f_Y g.left := by
      have hp_right : CategoryTheory.IsPullback r₁ (π_init ≫ p₁_init) f_Y g_init.left := by
        rw [hπ_p₁]
        exact hpY_init
      exact (CategoryTheory.IsPullback.of_hasPullback (π_init ≫ p₁_init) j_h).paste_horiz hp_right
    let e_pb : CategoryTheory.Limits.pullback (π_init ≫ p₁_init) j_h ≅
        CategoryTheory.Limits.pullback f_Y g.left :=
      hp_Z₁.isoPullback
    have he_snd : e_pb.hom ≫ CategoryTheory.Limits.pullback.snd f_Y g.left =
        CategoryTheory.Limits.pullback.snd (π_init ≫ p₁_init) j_h :=
      hp_Z₁.isoPullback_hom_snd
    let i_red : Y_red ⟶ CategoryTheory.Limits.pullback f_Y g.left := i_red₀ ≫ e_pb.hom
    have hCl_red : AlgebraicGeometry.IsClosedImmersion i_red := by
      dsimp [i_red]
      have _ : AlgebraicGeometry.IsClosedImmersion i_red₀ := hCl_red₀
      infer_instance
    have hSurj_red : AlgebraicGeometry.Surjective i_red := by
      dsimp [i_red]
      have _ : AlgebraicGeometry.Surjective i_red₀ := hSurj_red₀
      infer_instance
    obtain ⟨hInj_g, hAlg_g⟩ := hAlg_loc h hh_ne
    refine ⟨Z₁, hAffZ₁, hLftZ₁, d₁, hSmZ₁, hIntZ₁, g, Y_red, W_bad, i_red, i_W,
      s, C, f_bar, μ, U_comp, hInj_g, hAlg_g, hCl_red, hSurj_red, hCl_W,
      ?_, hFin_μ, ?_, hSm_fbar, hProj_C, hGenInt_C,
      hUniv_μ, hU_sub, hCompl_sub, hDisj_U, hEmpty_pre, hIso_μ⟩
    · dsimp [i_red, f_Y, p₁₀, P₁] at he_snd ⊢
      rw [CategoryTheory.Category.assoc, he_snd]
      exact hFin_W₀
    · intro j
      dsimp [i_red, f_Y, p₁₀, P₁] at he_snd ⊢
      rw [CategoryTheory.Category.assoc, he_snd]
      exact hComp_μ j

theorem weil_etale_p1_finite_cover_to_smooth_proj_curve_reduction (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hSmoothCurveFam : ∀ (Z₁ C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsAffine Z₁.left]
        (d₁ : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d₁ Z₁.hom],
        AlgebraicGeometry.IsIntegral Z₁.left →
        ∀ (f : C ⟶ Z₁) [AlgebraicGeometry.SmoothOfRelativeDimension 1 f.left],
          (∃ (N : ℕ) (ι : C.left ⟶
              CategoryTheory.Limits.pullback Z₁.hom (weilProjectiveSpaceOver k N).hom),
            AlgebraicGeometry.IsClosedImmersion ι ∧
            ι ≫ CategoryTheory.Limits.pullback.fst Z₁.hom (weilProjectiveSpaceOver k N).hom =
              f.left) →
          (∃ (Ω₀ : Type u) (_ : Field Ω₀) (_ : IsAlgClosed Ω₀)
              (η : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ Z₁.left),
            DenseRange η.base ∧
            AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f.left η)) →
          ∀ q : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₁.left
            (weilEtaleHigherDirectImage f.left q (weilEtaleTorsionSheaf C.left ℓ)))
    (Z₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine Z₀.left]
    [AlgebraicGeometry.LocallyOfFiniteType Z₀.hom]
    (hIntZ₀ : AlgebraicGeometry.IsIntegral Z₀.left)
    (Y : AlgebraicGeometry.Scheme.{u})
    (π : Y ⟶ CategoryTheory.Limits.pullback Z₀.hom (weilProjectiveSpaceOver k 1).hom)
    (hIntY : AlgebraicGeometry.IsIntegral Y)
    (hFinπ : AlgebraicGeometry.IsFinite π) :
    ∀ q : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
      (weilEtaleHigherDirectImage
        (CategoryTheory.Limits.pullback.fst Z₀.hom (weilProjectiveSpaceOver k 1).hom) q
        (weilEtaleHigherDirectImage π 0 (weilEtaleTorsionSheaf Y ℓ))) :=
by
  have genFLC_of_iso : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (e : G₁ ≅ G₂),
      WeilIsGenFiniteEtaleConstantModPrime ℓ Z G₂ →
      WeilIsGenFiniteEtaleConstantModPrime ℓ Z G₁ := by
    intro Z G₁ G₂ e ⟨hTor₂, U, hU, V, p, A, hFin_p, hEt_p, hSurj_p, hFin_A, hTor_A, hPB₂⟩
    refine ⟨?_, U, hU, V, p, A, hFin_p, hEt_p, hSurj_p, hFin_A, hTor_A, ?_⟩
    · calc
        ℓ • 𝟙 G₁ = ℓ • (e.hom ≫ 𝟙 G₂ ≫ e.inv) := by
          rw [CategoryTheory.Category.id_comp, e.hom_inv_id]
        _ = e.hom ≫ (ℓ • 𝟙 G₂) ≫ e.inv := by
          rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul]
        _ = 0 := by
          rw [hTor₂, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    · dsimp only [WeilIsEtaleSheafPullback] at hPB₂ ⊢
      rcases hPB₂ with ⟨hCont, hAdj, ⟨iso₂⟩⟩
      refine ⟨hCont, hAdj, ⟨?_⟩⟩
      exact (CategoryTheory.Functor.mapIso _ e).trans iso₂
  have higherDirectImage_mapIso : ∀ {X S : AlgebraicGeometry.Scheme.{u}}
      (f : X ⟶ S) (q : ℕ)
      {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (eF : F₁ ≅ F₂),
      weilEtaleHigherDirectImage f q F₁ ≅ weilEtaleHigherDirectImage f q F₂ := by
    intro X S f q F₁ F₂ eF
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    exact (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).mapIso
      (CategoryTheory.Functor.isoWhiskerLeft B.op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).mapIso eF))
  let P₁ := weilProjectiveSpaceOver k 1
  have : AlgebraicGeometry.IsProper P₁.hom := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (1 + 1)) k)
        (fun _ => rfl)
    let : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k)
    let φ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
    have hφ_bij : Function.Bijective φ := by
      constructor
      · intro a b hab
        exact MvPolynomial.C_injective (Fin (1 + 1)) k (congrArg Subtype.val hab)
      · intro x
        have hx : x.1 ∈ (1 : Submodule k (MvPolynomial (Fin (1 + 1)) k)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero]
          exact x.2
        rw [Submodule.mem_one] at hx
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, Subtype.ext hr⟩
    have : CategoryTheory.IsIso (CommRingCat.ofHom φ) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom φ)).mpr hφ_bij
    dsimp [P₁, weilProjectiveSpaceOver]
    infer_instance
  let p₁₀ := CategoryTheory.Limits.pullback.fst Z₀.hom P₁.hom
  have : AlgebraicGeometry.IsProper p₁₀ := inferInstance
  letI : AlgebraicGeometry.IsFinite π := hFinπ
  let f_Y := π ≫ p₁₀
  have hProp_fY : AlgebraicGeometry.IsProper f_Y := inferInstance
  let V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (f_Y ≫ Z₀.hom)
  let f₀ : V₀ ⟶ Z₀ := CategoryTheory.Over.homMk f_Y rfl
  obtain ⟨hFinComp, hRedIso, hExcision⟩ :=
    weil_etale_finite_pushforward_comp_and_conductor_excision
  obtain ⟨hFinBase, hDescent⟩ :=
    weil_etale_finite_over_base_and_genFinite_descent k ℓ hPBC
  suffices hGoal_f₀ : ∀ q : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₀.left
      (weilEtaleHigherDirectImage f₀.left q (weilEtaleTorsionSheaf V₀.left ℓ)) by
    intro q
    obtain ⟨e₀⟩ := hFinComp Y (CategoryTheory.Limits.pullback Z₀.hom P₁.hom) Z₀.left
      π p₁₀ (weilEtaleTorsionSheaf Y ℓ) q
    exact genFLC_of_iso e₀ (hGoal_f₀ q)
  rcases weil_etale_p1_finite_cover_geometric_curve_resolution_spread_out
      k Z₀ hIntZ₀ Y π hIntY hFinπ with
    ⟨Z₁, hAffZ₁, hLftZ₁, hIntZ₁, g, hInj_g, hAlg_g, hFin_snd⟩ |
    ⟨Z₁, hAffZ₁, hLftZ₁, d₁, hSmZ₁, hIntZ₁, g, Y_red, W_bad, i_red, i_W,
      s, C, f_bar, μ, U_comp, hInj_g, hAlg_g, hCl_red, hSurj_red, hCl_W,
      hFin_WZ₁, hFin_μ, hμ_comp, hSm_fbar, hProj_C, hGenInt_C,
      hUniv_μ, hU_sub, hCompl_sub, hDisj_U, hEmpty_pre, hIso_μ⟩
  · letI : AlgebraicGeometry.IsAffine Z₁.left := hAffZ₁
    letI : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom := hLftZ₁
    letI : AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.snd f_Y g.left) := hFin_snd
    exact hDescent Z₀ Z₁ V₀ hIntZ₀ hIntZ₁ f₀ hProp_fY g hInj_g hAlg_g
      (fun q => hFinBase Z₁ hIntZ₁ (CategoryTheory.Limits.pullback f_Y g.left)
        (CategoryTheory.Limits.pullback.snd f_Y g.left) q)
  · letI : AlgebraicGeometry.IsAffine Z₁.left := hAffZ₁
    letI : AlgebraicGeometry.LocallyOfFiniteType Z₁.hom := hLftZ₁
    letI : AlgebraicGeometry.SmoothOfRelativeDimension d₁ Z₁.hom := hSmZ₁
    letI : AlgebraicGeometry.IsClosedImmersion i_red := hCl_red
    letI : AlgebraicGeometry.Surjective i_red := hSurj_red
    letI : AlgebraicGeometry.IsClosedImmersion i_W := hCl_W
    apply hDescent Z₀ Z₁ V₀ hIntZ₀ hIntZ₁ f₀ hProp_fY g hInj_g hAlg_g
    let Y₁ := CategoryTheory.Limits.pullback f_Y g.left
    let snd := CategoryTheory.Limits.pullback.snd f_Y g.left
    let f_red := i_red ≫ snd
    let P_red : CategoryTheory.Sheaf Y_red.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
      fun F => ∀ q : ℕ, WeilIsGenFiniteEtaleConstantModPrime ℓ Z₁.left
        (weilEtaleHigherDirectImage f_red q F)
    suffices hPred : P_red (weilEtaleTorsionSheaf Y_red ℓ) by
      intro q
      obtain ⟨e_red⟩ := hRedIso Y_red Y₁ i_red ℓ
      obtain ⟨e_comp⟩ := hFinComp Y_red Y₁ Z₁.left i_red snd (weilEtaleTorsionSheaf Y_red ℓ) q
      exact genFLC_of_iso ((higherDirectImage_mapIso snd q e_red.symm).trans e_comp) (hPred q)
    obtain ⟨hZero, hRetract, hExact⟩ :=
      (weil_etale_p1_baseChange_and_genFLC_exact_closure k ℓ hPBC).2 Z₁ hIntZ₁ Y_red f_red
    have hPW : P_red (weilEtaleHigherDirectImage i_W 0 (weilEtaleTorsionSheaf W_bad ℓ)) := by
      intro q
      obtain ⟨eW⟩ := hFinComp W_bad Y_red Z₁.left i_W f_red (weilEtaleTorsionSheaf W_bad ℓ) q
      letI : AlgebraicGeometry.IsFinite (i_W ≫ f_red) := hFin_WZ₁
      exact genFLC_of_iso eW (hFinBase Z₁ hIntZ₁ W_bad (i_W ≫ f_red) q)
    have hPC : ∀ j : Fin s,
        P_red (weilEtaleHigherDirectImage (μ j) 0 (weilEtaleTorsionSheaf (C j).left ℓ)) := by
      intro j q
      letI : AlgebraicGeometry.IsFinite (μ j) := hFin_μ j
      letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f_bar j).left := hSm_fbar j
      obtain ⟨eC⟩ := hFinComp (C j).left Y_red Z₁.left (μ j) f_red
        (weilEtaleTorsionSheaf (C j).left ℓ) q
      have hCurve_j : WeilIsGenFiniteEtaleConstantModPrime ℓ Z₁.left
          (weilEtaleHigherDirectImage (μ j ≫ f_red) q (weilEtaleTorsionSheaf (C j).left ℓ)) := by
        change WeilIsGenFiniteEtaleConstantModPrime ℓ Z₁.left
          (weilEtaleHigherDirectImage (μ j ≫ i_red ≫ snd) q
            (weilEtaleTorsionSheaf (C j).left ℓ))
        rw [hμ_comp j]
        exact hSmoothCurveFam Z₁ (C j) d₁ hIntZ₁ (f_bar j) (hProj_C j) (hGenInt_C j) q
      exact genFLC_of_iso eC hCurve_j
    have hPE : ∀ j : Fin s, P_red (weilEtaleHigherDirectImage
        (CategoryTheory.Limits.pullback.fst (μ j) i_W ≫ μ j) 0
        (weilEtaleTorsionSheaf (CategoryTheory.Limits.pullback (μ j) i_W) ℓ)) := by
      intro j q
      letI : AlgebraicGeometry.IsFinite (μ j) := hFin_μ j
      let E_j := CategoryTheory.Limits.pullback (μ j) i_W
      let ιE := CategoryTheory.Limits.pullback.fst (μ j) i_W ≫ μ j
      have : AlgebraicGeometry.IsFinite ιE := inferInstance
      obtain ⟨eE⟩ := hFinComp E_j Y_red Z₁.left ιE f_red (weilEtaleTorsionSheaf E_j ℓ) q
      have hEqE : ιE ≫ f_red =
          CategoryTheory.Limits.pullback.snd (μ j) i_W ≫ (i_W ≫ i_red ≫ snd) :=
        (congrArg (· ≫ f_red) CategoryTheory.Limits.pullback.condition).trans
          (CategoryTheory.Category.assoc _ _ _)
      have hFinE : AlgebraicGeometry.IsFinite (ιE ≫ f_red) := by
        rw [hEqE]
        letI : AlgebraicGeometry.IsFinite (i_W ≫ i_red ≫ snd) := hFin_WZ₁
        infer_instance
      exact genFLC_of_iso eE (hFinBase Z₁ hIntZ₁ E_j (ιE ≫ f_red) q)
    exact hExcision ℓ Y_red W_bad i_W s (fun j => (C j).left) μ hFin_μ U_comp
      hUniv_μ hU_sub hCompl_sub hDisj_U hEmpty_pre hIso_μ
      P_red hZero hRetract hExact hPW hPC hPE

theorem weil_geom_point_generic_or_strictly_henselian_dvr (k : Type u) [Field k] [IsAlgClosed k]
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine Z₁.left]
    [AlgebraicGeometry.LocallyOfFiniteType Z₁.hom]
    (hIntZ₁ : AlgebraicGeometry.IsIntegral Z₁.left)
    (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₁.left) :
    DenseRange s.base ∨
    ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : Algebra k R)
      (_ : IsDiscreteValuationRing R) (_ : HenselianLocalRing R)
      (_ : IsSepClosed (IsLocalRing.ResidueField R))
      (g_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Z₁.left)
      (Ω_R : Type u) (_ : Field Ω_R) (_ : IsAlgClosed Ω_R)
      (η_R : AlgebraicGeometry.Spec (CommRingCat.of Ω_R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R))
      (k₁ : Type u) (_ : Field k₁) (_ : IsAlgClosed k₁)
      (u₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k₀))
      (u_R : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R)),
      DenseRange η_R.base ∧
      DenseRange (η_R ≫ g_R).base ∧
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)),
        u_R.base pt = IsLocalRing.closedPoint R) ∧
      u₀ ≫ s = u_R ≫ g_R :=
by
  have hStage1 : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra k B] [Algebra.FiniteType k B],
      Module.Finite B ↥(integralClosure B (FractionRing B)) ∧
      IsIntegrallyClosed ↥(integralClosure B (FractionRing B)) := by
    intro B _ _ _ _
    classical
    let K : Type u := FractionRing B
    have hIC : IsIntegrallyClosed ↥(integralClosure B K) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension K (L := K)
    refine ⟨?_, hIC⟩
    obtain ⟨s_dim, g, hg_inj, hg_fin⟩ := exists_finite_inj_algHom_of_fg k B
    let P : Type u := MvPolynomial (Fin s_dim) k
    let _ : Algebra P B := g.toRingHom.toAlgebra
    have hFinPB : Module.Finite P B := hg_fin
    have : Algebra.IsIntegral P B := Algebra.IsIntegral.of_finite P B
    have hgK_inj : Function.Injective (algebraMap P K) := by
      rw [IsScalarTower.algebraMap_eq P B K]
      exact (IsFractionRing.injective B K).comp hg_inj
    let F : Type u := FractionRing P
    have hP_units : ∀ y : nonZeroDivisors P, IsUnit (algebraMap P K y) := by
      rintro ⟨y, hy⟩
      refine IsUnit.mk0 _ (fun h0 => mem_nonZeroDivisors_iff_ne_zero.mp hy ?_)
      exact hgK_inj (h0.trans (map_zero (algebraMap P K)).symm)
    let i_FK : F →+* K := IsLocalization.lift hP_units
    let _ : Algebra F K := i_FK.toAlgebra
    have : IsScalarTower P F K :=
      IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.lift_eq hP_units x).symm)
    have : FiniteDimensional F K := by
      rcases hFinPB with ⟨⟨sB, hsB⟩⟩
      let S_K : Finset K := sB.image (algebraMap B K)
      let E : IntermediateField F K := IntermediateField.adjoin F (S_K : Set K)
      have hIntS : ∀ z ∈ (S_K : Set K), _root_.IsIntegral F z := by
        intro z hz
        rw [Finset.mem_coe, Finset.mem_image] at hz
        obtain ⟨b, _, rfl⟩ := hz
        have hbP : _root_.IsIntegral P (algebraMap B K b) :=
          (Algebra.IsIntegral.isIntegral (R := P) b).map (IsScalarTower.toAlgHom P B K)
        exact _root_.IsIntegral.tower_top hbP
      have hFinE : FiniteDimensional F ↥E :=
        IntermediateField.finiteDimensional_adjoin (S := (S_K : Set K)) hIntS
      have hB_in_E : ∀ b : B, algebraMap B K b ∈ E := by
        intro b
        have hb_mem : b ∈ Submodule.span P (sB : Set B) := by
          rw [hsB]; trivial
        refine Submodule.span_induction (fun x hx => ?_) ?_ (fun x y _ _ hx hy => ?_)
          (fun p x _ hx => ?_) hb_mem
        · exact IntermediateField.subset_adjoin F (S_K : Set K)
            (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx))
        · rw [map_zero]; exact E.zero_mem
        · rw [map_add]; exact E.add_mem hx hy
