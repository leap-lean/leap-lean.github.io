        (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective (CategoryTheory.Sieve.generate R_p) hmem u
      rcases hf with ⟨Z, h, g, ⟨⟩, rfl⟩
      exact ⟨y ≫ h, (CategoryTheory.Category.assoc y h p).trans hy⟩
    let fibOf : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
        (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W) → (W.Etale ⥤ Type u) :=
      fun W Ω _ _ w =>
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        { obj := fun E => { e : S_Ω ⟶ E.left // e ≫ E.hom = w }
          map := fun {E₁ E₂} f => TypeCat.ofHom fun e =>
            ⟨e.1 ≫ f.left, (CategoryTheory.Category.assoc e.1 f.left E₂.hom).trans
              ((congrArg (e.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w f)).trans e.2)⟩
          map_id := fun E => by
            ext e
            exact CategoryTheory.Category.comp_id e.1
          map_comp := fun f g => by
            ext e
            exact CategoryTheory.Category.assoc e.1 f.left g.left }
    have hJoint : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W)
        {E : W.Etale} (R : CategoryTheory.Sieve E),
        R ∈ W.smallEtaleTopology E →
        ∀ (x : (fibOf W Ω w).obj E),
          ∃ (E' : W.Etale) (u : E' ⟶ E) (_ : R.arrows u) (y : (fibOf W Ω w).obj E'),
            (CategoryTheory.ConcreteCategory.hom ((fibOf W Ω w).map u)) y = x := by
      intro W Ω _ _ w E R hR x
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
      let Fgt₁ := CategoryTheory.MorphismProperty.Over.forget P_et ⊤ W
      let Fgt₂ := CategoryTheory.Over.forget W
      have hR₁ : CategoryTheory.Sieve.functorPushforward Fgt₁ R ∈
          (AlgebraicGeometry.Scheme.overGrothendieckTopology P_et W) (Fgt₁.obj E) :=
        CategoryTheory.Functor.mem_restrictedTopology_iff.mp hR
      have hR₂ : CategoryTheory.Sieve.functorPushforward Fgt₂
          (CategoryTheory.Sieve.functorPushforward Fgt₁ R) ∈
          AlgebraicGeometry.Scheme.etaleTopology E.left :=
        (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mp hR₁
      obtain ⟨Y₀, f, hf, y, hy⟩ :=
        (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective _ hR₂ x.1
      let ⟨Z_ov, f_ov, k_sch, hf_ov, hf_k⟩ := hf
      let ⟨E', u_et, h_ov, hu_R, hf_eq⟩ := hf_ov
      let y' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E'.left :=
        (y ≫ k_sch) ≫ h_ov.left
      have hy'_u : y' ≫ u_et.left = x.1 := by
        have hf_left : f_ov.left = h_ov.left ≫ u_et.left :=
          congrArg CategoryTheory.CommaMorphism.left hf_eq
        dsimp [y']
        exact (CategoryTheory.Category.assoc (y ≫ k_sch) h_ov.left u_et.left).trans
          ((CategoryTheory.Category.assoc y k_sch (h_ov.left ≫ u_et.left)).trans
            ((congrArg (y ≫ k_sch ≫ ·) hf_left.symm).trans
              ((congrArg (y ≫ ·) hf_k.symm).trans hy)))
      have hy'_w : y' ≫ E'.hom = w :=
        (congrArg (y' ≫ ·) (CategoryTheory.MorphismProperty.Over.w u_et).symm).trans
          ((CategoryTheory.Category.assoc y' u_et.left E.hom).symm.trans
            ((congrArg (· ≫ E.hom) hy'_u).trans x.2))
      exact ⟨E', u_et, hu_R, ⟨y', hy'_w⟩, Subtype.ext hy'_u⟩
    have hCof : ∀ (W : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
        CategoryTheory.IsCofiltered (fibOf W Ω w).Elements := by
      intro W Ω _ _ w
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let fib := fibOf W Ω w
      let T_W : W.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.id W)
        (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id W))
      refine
        { toIsCofilteredOrEmpty :=
            { cone_objs := fun X₀ Y₀ => ?_
              cone_maps := fun {X₀ Y₀} f g => ?_ }
          nonempty := ⟨fib.elementsMk T_W ⟨w, CategoryTheory.Category.comp_id w⟩⟩ }
