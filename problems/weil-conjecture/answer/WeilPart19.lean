    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.QuasiCompact X.hom]
    [AlgebraicGeometry.IsSeparated X.hom]
    (π : X_bar ⟶ X) (U : X.left.Opens) (i : Y ⟶ X)
    (hπ : AlgebraicGeometry.IsProper π.left)
    (hπ_iso : CategoryTheory.IsIso (π.left ∣_ U))
    (hi : AlgebraicGeometry.IsClosedImmersion i.left)
    (hi_range : Set.range i.left.base = (U : Set X.left)ᶜ)
    (hClosed0 : ∀ (G_Y : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ Y.left G_Y →
      WeilIsConstructibleModPrimeSheaf ℓ X.left (weilEtaleHigherDirectImage i.left 0 G_Y))
    (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
    (hF : WeilIsConstructibleModPrimeSheaf ℓ X.left F) :
    ∃ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}))
      (F_Y : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u})
      (K_bar : CategoryTheory.Sheaf X_bar.left.smallEtaleTopology AddCommGrpCat.{u}),
      SC.ShortExact ∧
      SC.X₂ = F ∧
      SC.X₃ = weilEtaleHigherDirectImage i.left 0 F_Y ∧
      WeilIsConstructibleModPrimeSheaf ℓ Y.left F_Y ∧
      WeilIsConstructibleModPrimeSheaf ℓ X_bar.left K_bar ∧
      Nonempty (SC.X₁ ≅ weilEtaleHigherDirectImage π.left 0 K_bar) ∧
      (∀ b : ℕ, CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage π.left (b + 1) K_bar)) :=
by
  
  have hPillar1 :
      (∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : W₁ ⟶ W₂)
          (H : CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        CategoryTheory.Limits.IsZero H →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h q H)) ∧
      (∀ (V : AlgebraicGeometry.Scheme.{u})
          (M : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id V) 0 M ≅ M)) ∧
      (∀ {Z W : AlgebraicGeometry.Scheme.{u}} (p : Z ⟶ W)
          (M : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
          (M_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          (hCont : (weilCompEtaleSitePullback p).IsContinuous
            W.smallEtaleTopology Z.smallEtaleTopology)
          (hRA : ((weilCompEtaleSitePullback p).sheafPushforwardContinuous
            AddCommGrpCat.{u} W.smallEtaleTopology Z.smallEtaleTopology).IsRightAdjoint),
        letI := hCont
        letI := hRA
