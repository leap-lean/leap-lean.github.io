        have hEx_ε₁ : (CategoryTheory.ShortComplex.mk ε₁ (K_shift.d 0 1) hε₁).Exact := by
          let S_src := CategoryTheory.ShortComplex.mk (K.d 0 1) (K.d 1 2) (K.d_comp_d 0 1 2)
          let S_tgt := CategoryTheory.ShortComplex.mk ε₁ (K_shift.d 0 1) hε₁
          let φ : S_src ⟶ S_tgt :=
            { τ₁ := π₀
              τ₂ := 𝟙 (K.X 1)
              τ₃ := 𝟙 (K.X 2)
              comm₁₂ := by dsimp [S_src, S_tgt, K_shift]; rw [CategoryTheory.Category.comp_id, hπ_ε₁]
              comm₂₃ := by dsimp [S_src, S_tgt, K_shift]; rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id] }
          have : CategoryTheory.Epi φ.τ₁ := by dsimp [φ]; infer_instance
          have : CategoryTheory.IsIso φ.τ₂ := by dsimp [φ]; infer_instance
          have : CategoryTheory.Mono φ.τ₃ := by dsimp [φ]; infer_instance
          exact (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mp (hEx_succ 0)
        obtain ⟨δ, _, hβδ, hδα, _, _, hEx_βδ, hEx_δα⟩ := hLES SC_M hSE_M
        have hZ1 : CategoryTheory.Limits.IsZero ((T_fun (q' + 1)).obj (K.X 0)) :=
          hInjZero (K.X 0) (hK_inj 0) q'
        have hZ2 : CategoryTheory.Limits.IsZero ((T_fun (q' + 2)).obj (K.X 0)) :=
          hInjZero (K.X 0) (hK_inj 0) (q' + 1)
        have : CategoryTheory.Mono (δ (q' + 1)) :=
