            (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, iso_sh.inv_hom_id]
          simp
        map_add' := map_add fwd_sh }
    cases q with
    | zero => exact ⟨(Θ₀ F).trans e_sh⟩
    | succ p =>
      obtain ⟨e_p⟩ := hEquivSucc p F
      exact ⟨e_p.trans e_sh⟩
  
  have hStep_m : WeilOrdGodRingStep S (ULift.{u, 0} (ZMod m)) :=
    hPillar2 (ULift.{u, 0} (ZMod m)) hPillar1
  have hStep_Z : WeilOrdGodRingStep S (ULift.{u, 0} ℤ) :=
    hPillar2 (ULift.{u, 0} ℤ) hPillar1
  have hExtComp := hPillar4 hStep_m hStep_Z
  obtain ⟨_, G₀, η₀, _, _, _, ⟨hAdd₀, hLim₀, hColim₀⟩, hMono₀, hObj₀, hAcyc₀⟩ := hStep_m
  obtain ⟨G, η, diff, hExactG, hMonoη, hEx0, hExq, hAcycq⟩ :=
    @hPillar3
      (CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))))
      _ _ _ (weilEtaleModuleUnit S m) G₀ hAdd₀ hLim₀ hColim₀ η₀ hMono₀
      (fun k hk F => hAcyc₀ _ (G₀.obj F) (hObj₀ F) k hk)
  exact ⟨G, η, diff, hExactG, hMonoη, hEx0, hExq, hAcycq, hExtComp⟩

theorem weil_etale_affine_filtered_colimits_and_compact_freeYoneda (S : AlgebraicGeometry.Scheme.{u}) [CompactSpace ↥S] [S.IsSeparated] (m : ℕ) :
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
    let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
    let Γ_S : CategoryTheory.Functor 𝒞 (ModuleCat.{u, u} R) :=
      CategoryTheory.Functor.comp (CategoryTheory.sheafToPresheaf J (ModuleCat.{u, u} R))
        ((CategoryTheory.evaluation (Opposite S.Etale) (ModuleCat.{u, u} R)).obj (Opposite.op T_S))
    (∀ (W : S.Etale),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left →
      CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u}
        (CategoryTheory.coyoneda.obj (Opposite.op (weilEtaleLocalFreeSheaf S m W)))) ∧
    CategoryTheory.Limits.PreservesFilteredColimitsOfSize.{u, u} Γ_S ∧
    ∃ (I₀ : Type u) (W : I₀ → S.Etale),
      (∀ i : I₀, AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj (W i)).left) ∧
      (CategoryTheory.ObjectProperty.ofObj
        (fun i : I₀ => weilEtaleLocalFreeSheaf S m (W i))).IsSeparating :=
by
  let R := ULift.{u, 0} (ZMod m)
  let A := ModuleCat.{u, u} R
  let J := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J A
  let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (CategoryTheory.CategoryStruct.id S)
    (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  let Γ_S : CategoryTheory.Functor 𝒞 A :=
    CategoryTheory.Functor.comp (CategoryTheory.sheafToPresheaf J A)
      ((CategoryTheory.evaluation (Opposite S.Etale) A).obj (Opposite.op T_S))
  let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S
  let ι := AlgebraicGeometry.Scheme.AffineEtale.Spec S
  let E_aff := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S A
  have hL_def : ∀ X : S.Etale,
      weilEtaleLocalFreeSheaf S m X = CategoryTheory.Sheaf.freeYoneda J X (ModuleCat.of R R) :=
    fun _ => rfl
  
  have filtered_fin_ub : ∀ {Λ : Type u} [CategoryTheory.Category.{u} Λ]
      [CategoryTheory.IsFiltered Λ] (k : ℕ) (idx : Fin k → Λ),
      ∃ (μ : Λ), Nonempty (∀ b : Fin k, idx b ⟶ μ) := by
    intro Λ _ _ k
    induction k with
    | zero =>
      intro _
      obtain ⟨μ₀⟩ := CategoryTheory.IsFiltered.nonempty (C := Λ)
      exact ⟨μ₀, ⟨fun b => Fin.elim0 b⟩⟩
    | succ k ih =>
      intro idx
      obtain ⟨μ₁, ⟨u₁⟩⟩ := ih (fun i => idx i.castSucc)
      let μ := CategoryTheory.IsFiltered.max μ₁ (idx (Fin.last k))
      exact ⟨μ, ⟨Fin.lastCases (CategoryTheory.IsFiltered.rightToMax μ₁ (idx (Fin.last k)))
        (fun i => u₁ i ≫ CategoryTheory.IsFiltered.leftToMax μ₁ (idx (Fin.last k)))⟩⟩
  have filtered_fin_coeq_cond : ∀ {Λ : Type u} [CategoryTheory.Category.{u} Λ]
      [CategoryTheory.IsFiltered Λ] (l₀ : Λ) (k : ℕ)
      (Q : ∀ {μ : Λ}, (l₀ ⟶ μ) → Fin k → Prop),
      (∀ {μ₁ μ₂ : Λ} (w : l₀ ⟶ μ₁) (c : μ₁ ⟶ μ₂) (b : Fin k), Q w b → Q (w ≫ c) b) →
      (∀ b : Fin k, ∃ (ν : Λ) (v : l₀ ⟶ ν), Q v b) →
      ∃ (μ : Λ) (w : l₀ ⟶ μ), ∀ b : Fin k, Q w b := by
    intro Λ _ _ l₀ k
    induction k with
    | zero =>
      intro _ _ _
      exact ⟨l₀, 𝟙 l₀, fun b => Fin.elim0 b⟩
    | succ k ih =>
      intro Q hup hsol
      obtain ⟨μ₁, w₁, hw₁⟩ := ih (fun w i => Q w i.castSucc)
        (fun w c i h => hup w c i.castSucc h) (fun i => hsol i.castSucc)
      obtain ⟨ν, v, hv⟩ := hsol (Fin.last k)
      let m₀ := CategoryTheory.IsFiltered.max μ₁ ν
      let a₁ : l₀ ⟶ m₀ := w₁ ≫ CategoryTheory.IsFiltered.leftToMax μ₁ ν
      let a₂ : l₀ ⟶ m₀ := v ≫ CategoryTheory.IsFiltered.rightToMax μ₁ ν
      let μ := CategoryTheory.IsFiltered.coeq a₁ a₂
      let c : m₀ ⟶ μ := CategoryTheory.IsFiltered.coeqHom a₁ a₂
      refine ⟨μ, a₁ ≫ c, Fin.lastCases ?_ ?_⟩
      · have heq : a₁ ≫ c = v ≫ (CategoryTheory.IsFiltered.rightToMax μ₁ ν ≫ c) := by
          rw [CategoryTheory.IsFiltered.coeq_condition a₁ a₂]
          exact CategoryTheory.Category.assoc _ _ _
        rw [heq]
        exact hup v _ (Fin.last k) hv
      · intro i
        have heq : a₁ ≫ c = w₁ ≫ (CategoryTheory.IsFiltered.leftToMax μ₁ ν ≫ c) :=
          CategoryTheory.Category.assoc _ _ _
        rw [heq]
        exact hup w₁ _ i.castSucc (hw₁ i)
  have types_filtered_fin_lift : ∀ {Λ : Type u} [CategoryTheory.Category.{u} Λ]
      [CategoryTheory.IsFiltered Λ] {k : ℕ} (G : Fin k → (Λ ⥤ Type u))
      (c : ∀ b : Fin k, CategoryTheory.Limits.Cocone (G b))
      (hc : ∀ b : Fin k, CategoryTheory.Limits.IsColimit (c b))
      (x : ∀ b : Fin k, (c b).pt),
      ∃ (l₁ : Λ) (y : ∀ b : Fin k, (G b).obj l₁),
        ∀ b : Fin k, CategoryTheory.ConcreteCategory.hom ((c b).ι.app l₁) (y b) = x b := by
    intro Λ _ _ k G c hc x
    have hsurj : ∀ b : Fin k, ∃ (j : Λ) (y₀ : (G b).obj j),
        CategoryTheory.ConcreteCategory.hom ((c b).ι.app j) y₀ = x b :=
      fun b => CategoryTheory.Limits.Types.jointly_surjective_of_isColimit (hc b) (x b)
    choose idx y₀ hy₀ using hsurj
    obtain ⟨l₁, ⟨u⟩⟩ := filtered_fin_ub k idx
    refine ⟨l₁, fun b => CategoryTheory.ConcreteCategory.hom ((G b).map (u b)) (y₀ b), fun b => ?_⟩
    have hw := congrArg
      (fun f : (G b).obj (idx b) ⟶ (c b).pt => CategoryTheory.ConcreteCategory.hom f (y₀ b))
      ((c b).w (u b))
    simpa using hw.trans (hy₀ b)
  have types_filtered_fin_eq : ∀ {Λ : Type u} [CategoryTheory.Category.{u} Λ]
      [CategoryTheory.IsFiltered Λ] {k : ℕ} (G : Fin k → (Λ ⥤ Type u))
      (c : ∀ b : Fin k, CategoryTheory.Limits.Cocone (G b))
      (hc : ∀ b : Fin k, CategoryTheory.Limits.IsColimit (c b))
      (l₀ : Λ) (x₁ x₂ : ∀ b : Fin k, (G b).obj l₀),
      (∀ b : Fin k,
        CategoryTheory.ConcreteCategory.hom ((c b).ι.app l₀) (x₁ b) =
          CategoryTheory.ConcreteCategory.hom ((c b).ι.app l₀) (x₂ b)) →
      ∃ (μ : Λ) (w : l₀ ⟶ μ),
        ∀ b : Fin k,
          CategoryTheory.ConcreteCategory.hom ((G b).map w) (x₁ b) =
            CategoryTheory.ConcreteCategory.hom ((G b).map w) (x₂ b) := by
    intro Λ _ _ k G c hc l₀ x₁ x₂ heq
    apply filtered_fin_coeq_cond l₀ k
      (fun {μ} w b =>
        CategoryTheory.ConcreteCategory.hom ((G b).map w) (x₁ b) =
          CategoryTheory.ConcreteCategory.hom ((G b).map w) (x₂ b))
    · intro μ₁ μ₂ w u b h
      simp only [CategoryTheory.Functor.map_comp]
      exact congrArg (CategoryTheory.ConcreteCategory.hom ((G b).map u)) h
    · intro b
      obtain ⟨ν₀, f, g, hfg⟩ :=
        (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff (G b) (hc b)).mp (heq b)
      let c₀ := CategoryTheory.IsFiltered.coeqHom f g
      refine ⟨CategoryTheory.IsFiltered.coeq f g, f ≫ c₀, ?_⟩
      have hcond : f ≫ c₀ = g ≫ c₀ := CategoryTheory.IsFiltered.coeq_condition f g
      calc
        CategoryTheory.ConcreteCategory.hom ((G b).map (f ≫ c₀)) (x₁ b)
            = CategoryTheory.ConcreteCategory.hom ((G b).map c₀)
                (CategoryTheory.ConcreteCategory.hom ((G b).map f) (x₁ b)) := by
              simp [CategoryTheory.Functor.map_comp]
        _ = CategoryTheory.ConcreteCategory.hom ((G b).map c₀)
              (CategoryTheory.ConcreteCategory.hom ((G b).map g) (x₂ b)) := by
              rw [hfg]
        _ = CategoryTheory.ConcreteCategory.hom ((G b).map (g ≫ c₀)) (x₂ b) := by
              simp [CategoryTheory.Functor.map_comp]
        _ = CategoryTheory.ConcreteCategory.hom ((G b).map (f ≫ c₀)) (x₂ b) := by
              rw [hcond]
  
  have modulePresheaf_isSheaf_iff_forget : ∀ {D : Type (u + 1)} [CategoryTheory.Category D]
      (K : CategoryTheory.GrothendieckTopology D) (Q : Dᵒᵖ ⥤ A),
      CategoryTheory.Presheaf.IsSheaf K Q ↔
        CategoryTheory.Presieve.IsSheaf K (Q ⋙ CategoryTheory.forget A) := by
    intro D _ K Q
    let P_fgt : Dᵒᵖ ⥤ Type u := Q ⋙ CategoryTheory.forget A
    let e_eval : ∀ M : A, (ModuleCat.of R R ⟶ M) ≃ ↥M := fun M =>
      { toFun := fun α => α.hom (1 : R)
        invFun := fun v => ModuleCat.ofHom (LinearMap.toSpanSingleton R M v)
        left_inv := fun α => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro r
          change r • α.hom 1 = α.hom r
          rw [← map_smul, smul_eq_mul, mul_one]
        right_inv := fun v => by
          change (1 : R) • v = v
          exact one_smul R v }
    let Φ : Q ⋙ CategoryTheory.coyoneda.obj (Opposite.op (ModuleCat.of R R)) ≅ P_fgt :=
      CategoryTheory.NatIso.ofComponents (fun X => (e_eval (Q.obj X)).toIso) (fun _ => by ext; rfl)
    constructor
    · intro hQ
      exact CategoryTheory.Presieve.isSheaf_iso K Φ (hQ (ModuleCat.of R R))
    · intro hType E U S_cov hS_cov x hx
      have hpt : ∀ e : E, ∃! t_e : P_fgt.obj (Opposite.op U),
          CategoryTheory.Presieve.FamilyOfElements.IsAmalgamation
            (P := P_fgt) (R := S_cov.arrows)
            (fun V f hf => (x f hf).hom e) t_e := by
        intro e
        apply hType S_cov hS_cov
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        have hcompat := hx g₁ g₂ hf₁ hf₂ hcomm
        exact congrArg (fun ψ : E ⟶ Q.obj (Opposite.op Z) => ψ.hom e) hcompat
      choose t ht_amal ht_uniq using hpt
      have ht_add : ∀ e₁ e₂ : E, t (e₁ + e₂) = t e₁ + t e₂ := by
        intro e₁ e₂
        symm
        apply ht_uniq (e₁ + e₂)
        intro V f hf
        change (Q.map f.op).hom (t e₁ + t e₂) = (x f hf).hom (e₁ + e₂)
        rw [map_add, map_add]
        exact congrArg₂ (· + ·) (ht_amal e₁ f hf) (ht_amal e₂ f hf)
      have ht_smul : ∀ (r : R) (e : E), t (r • e) = r • t e := by
        intro r e
        symm
        apply ht_uniq (r • e)
        intro V f hf
        change (Q.map f.op).hom (r • t e) = (x f hf).hom (r • e)
        rw [map_smul, map_smul]
        exact congrArg (r • ·) (ht_amal e f hf)
      let t_hom : E ⟶ Q.obj (Opposite.op U) :=
        ModuleCat.ofHom
          { toAddHom := { toFun := t, map_add' := ht_add }
            map_smul' := ht_smul }
      refine ⟨t_hom, ?_, ?_⟩
      · intro V f hf
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro e
        exact ht_amal e f hf
      · intro y hy
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro e
        apply ht_uniq e
        intro V f hf
        have hyf := hy f hf
        exact congrArg (fun ψ : E ⟶ Q.obj (Opposite.op V) => ψ.hom e) hyf
  
  have affineEtale_finite_subcover : ∀ (U₀ : S.AffineEtale) (T : CategoryTheory.Sieve U₀),
      T ∈ J_aff U₀ →
      ∃ (n : ℕ) (V : Fin n → S.AffineEtale) (π : ∀ b : Fin n, V b ⟶ U₀),
        (∀ b : Fin n, T.arrows (π b)) ∧
        CategoryTheory.Sieve.ofArrows V π ∈ J_aff U₀ := by
    intro U₀ T hT
