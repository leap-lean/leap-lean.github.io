      refine ⟨⟨s_gen, eq_top_iff.mpr ?_⟩⟩
      intro w _
      have haux : ∀ z ∈ B₁, ∀ u : ↥B₁, u.1 = z → u ∈ Algebra.adjoin k (s_gen : Set ↥B₁) := by
