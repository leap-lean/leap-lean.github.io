theorem weil_etale_constructible_pullback_and_zariski_cover (ℓ : ℕ)
    (hPullEx : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h F₂ F₁ ∧
        (ℓ • CategoryTheory.CategoryStruct.id F₂ = 0 →
          ℓ • CategoryTheory.CategoryStruct.id F₁ = 0))
    (hPullComp : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃)
        (F₃ : CategoryTheory.Sheaf X₃.smallEtaleTopology AddCommGrpCat.{u})
        (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
        (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      (WeilIsEtaleSheafPullback h₂ F₃ F₂ →
        WeilIsEtaleSheafPullback h₁ F₂ F₁ →
        WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁) ∧
      (WeilIsEtaleSheafPullback h₂ F₃ F₂ →
        WeilIsEtaleSheafPullback (h₁ ≫ h₂) F₃ F₁ →
        WeilIsEtaleSheafPullback h₁ F₂ F₁))
    (hPullConst : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (A : AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h
        ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
        ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A)) :
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (g : X₁ ⟶ X₂)
        (F : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (F' : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback g F F' ∧
        (WeilIsConstructibleModPrimeSheaf ℓ X₂ F →
          WeilIsConstructibleModPrimeSheaf ℓ X₁ F')) ∧
    (∀ (Y : AlgebraicGeometry.Scheme.{u})
        (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      ∀ (n : ℕ) (W : Fin n → Y.Opens),
        iSup W = ⊤ →
        (∀ a : Fin n,
          ∃ (G_a : CategoryTheory.Sheaf (W a : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology
              AddCommGrpCat.{u}),
            WeilIsEtaleSheafPullback (W a).ι G G_a ∧
            WeilIsConstructibleModPrimeSheaf ℓ (W a : AlgebraicGeometry.Scheme.{u}) G_a) →
        WeilIsConstructibleModPrimeSheaf ℓ Y G) :=
by
  have hs1 : ∀ (X : AlgebraicGeometry.Scheme.{u}) (C : TopologicalSpace.Closeds ↥X),
      AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme := by
    intro X C
    let I := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
    let Z := I.subscheme
    let iZ := I.subschemeι
    have hsupp : I.support = C :=
      SetLike.coe_injective (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C)
    have hrad_eq : I = I.radical := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support, hsupp]
    let W : X.affineOpens → Z.Opens := fun U => (TopologicalSpace.Opens.map iZ.base).obj U.1
    have hcov : TopologicalSpace.IsOpenCover W := by
      change ⨆ U : X.affineOpens, W U = ⊤
      rw [eq_top_iff]
      intro z _
      have hz : iZ.base z ∈ (⊤ : X.Opens) := trivial
      rw [← AlgebraicGeometry.iSup_affineOpens_eq_top X, TopologicalSpace.Opens.mem_iSup] at hz
      obtain ⟨U, hU⟩ := hz
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨U, hU⟩
    let 𝒰 : Z.OpenCover := Z.openCoverOfIsOpenCover W hcov
    have _ : ∀ U : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X U) := by
      intro U
      change AlgebraicGeometry.IsReduced (W U : AlgebraicGeometry.Scheme.{u})
      have _ : AlgebraicGeometry.IsAffine (W U : AlgebraicGeometry.Scheme.{u}) := U.2.preimage iZ
      have hI_rad_eq : I.ideal U = (I.ideal U).radical := by
        calc
          I.ideal U = I.radical.ideal U := congrArg (fun J : X.IdealSheafData => J.ideal U) hrad_eq
          _ = (I.ideal U).radical := AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal I U
      have hI_rad : (I.ideal U).IsRadical := by
        rw [hI_rad_eq]
        exact Ideal.radical_isRadical _
      have _ : IsReduced (↑(X.presheaf.obj (Opposite.op U.1)) ⧸ I.ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced (I.ideal U)).mp hI_rad
      let eU := AlgebraicGeometry.Scheme.Opens.topIso (W U) ≪≫ I.subschemeObjIso U
      have hinj : Function.Injective eU.hom.hom := by
        intro x y hxy
        have h1 : (eU.hom ≫ eU.inv).hom x = (eU.hom ≫ eU.inv).hom y :=
          congrArg eU.inv.hom hxy
        simpa using h1
      have _ : IsReduced ↑((W U : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)) :=
        isReduced_of_injective eU.hom.hom hinj
      exact AlgebraicGeometry.isReduced_of_isAffine_isReduced (W U : AlgebraicGeometry.Scheme.{u})
    exact AlgebraicGeometry.IsReduced.of_openCover Z 𝒰
  have hs2 : ∀ {Z' X : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsReduced Z']
      [IrreducibleSpace ↥Z'] (h : Z' ⟶ X),
      let C : TopologicalSpace.Closeds ↥X := ⟨closure (Set.range h.base), isClosed_closure⟩
      let I_Z : X.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
      IrreducibleSpace ↥I_Z.subscheme ∧
        ∃ (qZ : Z' ⟶ I_Z.subscheme),
          qZ ≫ I_Z.subschemeι = h ∧ DenseRange qZ.base := by
    intro Z' X _ _ h C I_Z
    let Z := I_Z.subscheme
    let iZ := I_Z.subschemeι
    have hrange : Set.range iZ.base = closure (Set.range h.base) := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have hirr_univ : IsIrreducible (Set.univ : Set ↥Z') := IrreducibleSpace.isIrreducible_univ ↥Z'
    have hirr_range_h : IsIrreducible (Set.range h.base) := by
      rw [← Set.image_univ]
      exact hirr_univ.image h.base (ContinuousMap.continuous _).continuousOn
    have hirr_range_iZ : IsIrreducible (Set.range iZ.base) := by
      rw [hrange]
      exact hirr_range_h.closure
    have _ : IrreducibleSpace ↥(Set.range iZ.base) :=
      isIrreducible_iff_irreducibleSpace.mp hirr_range_iZ
    have hEmb : Topology.IsClosedEmbedding iZ.base :=
      AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding iZ
    have hIrrZ : IrreducibleSpace ↥Z :=
      (Homeomorph.irreducibleSpace_iff hEmb.isEmbedding.toHomeomorph).mpr inferInstance
    have hKer : iZ.ker ≤ h.ker := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι]
      change I_Z ≤ AlgebraicGeometry.Scheme.IdealSheafData.ofIdeals
        (fun U => RingHom.ker (h.app U.1).hom)
      rw [AlgebraicGeometry.Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      rw [RingHom.mem_ker, ← AlgebraicGeometry.basicOpen_eq_bot_iff,
        ← AlgebraicGeometry.Scheme.preimage_basicOpen h s, eq_bot_iff]
      intro z' hz'
      have hz'_supp : h.base z' ∈ I_Z.support := by
        change h.base z' ∈ (I_Z.support : Set ↥X)
        rw [AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
        exact subset_closure ⟨z', rfl⟩
      have hz'_zero := AlgebraicGeometry.Scheme.IdealSheafData.mem_support_iff.mp hz'_supp U
      exact (X.mem_zeroLocus_iff (I_Z.ideal U : Set ↑(X.presheaf.obj (Opposite.op U.1)))
        (h.base z')).mp hz'_zero s hs hz'
    let qZ : Z' ⟶ Z := AlgebraicGeometry.IsClosedImmersion.lift iZ h hKer
    have hqZ_fac : qZ ≫ iZ = h := AlgebraicGeometry.IsClosedImmersion.lift_fac iZ h hKer
    have hDense : DenseRange qZ.base := by
      intro z
      rw [mem_closure_iff]
      intro O hO hzO
      obtain ⟨V, hV, rfl⟩ := hEmb.isEmbedding.isInducing.isOpen_iff.mp hO
      have hiz_cl : iZ.base z ∈ closure (Set.range h.base) := by
        rw [← hrange]
        exact ⟨z, rfl⟩
      obtain ⟨_, ⟨hqzV, z', rfl⟩⟩ := mem_closure_iff.mp hiz_cl V hV hzO
      refine ⟨qZ.base z', ?_, ⟨z', rfl⟩⟩
      change iZ.base (qZ.base z') ∈ V
      have hpt : iZ.base (qZ.base z') = h.base z' := by
        rw [← hqZ_fac]
        rfl
      rwa [hpt]
    exact ⟨hIrrZ, qZ, hqZ_fac, hDense⟩
  have hs3_pull : ∀ {Z' Z : AlgebraicGeometry.Scheme.{u}} (qZ : Z' ⟶ Z),
      DenseRange qZ.base →
      ∀ (U : Z.Opens), Nonempty U →
        ∀ (V : AlgebraicGeometry.Scheme.{u}) (p : V ⟶ (U : AlgebraicGeometry.Scheme.{u})),
          AlgebraicGeometry.IsFinite p →
          AlgebraicGeometry.Etale p →
          AlgebraicGeometry.Surjective p →
          ∃ (U' : Z'.Opens) (_ : Nonempty U')
            (V' : AlgebraicGeometry.Scheme.{u}) (p' : V' ⟶ (U' : AlgebraicGeometry.Scheme.{u}))
            (v' : V' ⟶ V),
            AlgebraicGeometry.IsFinite p' ∧
            AlgebraicGeometry.Etale p' ∧
            AlgebraicGeometry.Surjective p' ∧
            v' ≫ p ≫ U.ι = p' ≫ U'.ι ≫ qZ := by
    intro Z' Z qZ hDense U ⟨u₀⟩ V p hFin hEt hSurj
    have _ : AlgebraicGeometry.IsFinite p := hFin
    have _ : AlgebraicGeometry.Etale p := hEt
    have _ : AlgebraicGeometry.Surjective p := hSurj
    obtain ⟨z'₀, hz'₀⟩ := hDense.exists_mem_open U.isOpen ⟨u₀.1, u₀.2⟩
    let U' : Z'.Opens := (TopologicalSpace.Opens.map qZ.base).obj U
    have hU' : Nonempty U' := ⟨⟨z'₀, hz'₀⟩⟩
    let qU : (U' : AlgebraicGeometry.Scheme.{u}) ⟶ (U : AlgebraicGeometry.Scheme.{u}) := qZ ∣_ U
    let V' : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback qU p
    let p' : V' ⟶ (U' : AlgebraicGeometry.Scheme.{u}) := CategoryTheory.Limits.pullback.fst qU p
    let v' : V' ⟶ V := CategoryTheory.Limits.pullback.snd qU p
    refine ⟨U', hU', V', p', v', inferInstance, inferInstance, inferInstance, ?_⟩
    calc
      v' ≫ p ≫ U.ι = (v' ≫ p) ≫ U.ι := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (p' ≫ qU) ≫ U.ι := by rw [CategoryTheory.Limits.pullback.condition]
      _ = p' ≫ (qU ≫ U.ι) := CategoryTheory.Category.assoc _ _ _
      _ = p' ≫ U'.ι ≫ qZ := by rw [AlgebraicGeometry.morphismRestrict_ι]
  have hs3_cov : ∀ {Y Z : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsIntegral Z]
      (iZ : Z ⟶ Y) [AlgebraicGeometry.IsClosedImmersion iZ]
      (n : ℕ) (W : Fin n → Y.Opens),
      iSup W = ⊤ →
      ∃ (a : Fin n) (Z_a : Z.Opens)
          (iZa : (Z_a : AlgebraicGeometry.Scheme.{u}) ⟶ (W a : AlgebraicGeometry.Scheme.{u})),
        AlgebraicGeometry.IsIntegral (Z_a : AlgebraicGeometry.Scheme.{u}) ∧
        AlgebraicGeometry.IsClosedImmersion iZa ∧
        iZa ≫ (W a).ι = Z_a.ι ≫ iZ ∧
        ∀ (U_a : (Z_a : AlgebraicGeometry.Scheme.{u}).Opens), Nonempty U_a →
          ∀ (V : AlgebraicGeometry.Scheme.{u}) (p_a : V ⟶ (U_a : AlgebraicGeometry.Scheme.{u})),
            AlgebraicGeometry.IsFinite p_a →
            AlgebraicGeometry.Etale p_a →
            AlgebraicGeometry.Surjective p_a →
            ∃ (U : Z.Opens) (_ : Nonempty U) (p : V ⟶ (U : AlgebraicGeometry.Scheme.{u})),
              AlgebraicGeometry.IsFinite p ∧
              AlgebraicGeometry.Etale p ∧
              AlgebraicGeometry.Surjective p ∧
              p ≫ U.ι ≫ iZ = (p_a ≫ U_a.ι ≫ iZa) ≫ (W a).ι := by
    intro Y Z _ iZ _ n W hTop
    let z₀ : ↥Z := Classical.arbitrary ↥Z
    have hz₀ : iZ.base z₀ ∈ (⊤ : Y.Opens) := trivial
    rw [← hTop, TopologicalSpace.Opens.mem_iSup] at hz₀
    obtain ⟨a, ha⟩ := hz₀
    let Z_a : Z.Opens := (TopologicalSpace.Opens.map iZ.base).obj (W a)
    have _ : Nonempty ↥(Z_a : AlgebraicGeometry.Scheme.{u}) := ⟨⟨z₀, ha⟩⟩
    have hIntZa : AlgebraicGeometry.IsIntegral (Z_a : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion Z_a.ι
    let iZa : (Z_a : AlgebraicGeometry.Scheme.{u}) ⟶ (W a : AlgebraicGeometry.Scheme.{u}) :=
      iZ ∣_ W a
    have hiZa_comm : iZa ≫ (W a).ι = Z_a.ι ≫ iZ := AlgebraicGeometry.morphismRestrict_ι iZ (W a)
    refine ⟨a, Z_a, iZa, hIntZa, inferInstance, hiZa_comm, ?_⟩
    intro U_a ⟨u_a⟩ V p_a hFin hEt hSurj
    have _ : AlgebraicGeometry.IsFinite p_a := hFin
    have _ : AlgebraicGeometry.Etale p_a := hEt
    have _ : AlgebraicGeometry.Surjective p_a := hSurj
    let j_U : (U_a : AlgebraicGeometry.Scheme.{u}) ⟶ Z := U_a.ι ≫ Z_a.ι
    let U : Z.Opens := j_U.opensRange
    have hU : Nonempty U := ⟨⟨j_U.base u_a, u_a, rfl⟩⟩
    let p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}) := p_a ≫ j_U.isoOpensRange.hom
    refine ⟨U, hU, p, inferInstance, inferInstance, inferInstance, ?_⟩
    calc
      p ≫ U.ι ≫ iZ = p_a ≫ (j_U.isoOpensRange.hom ≫ U.ι) ≫ iZ := by
        dsimp [p]
        simp only [CategoryTheory.Category.assoc]
      _ = p_a ≫ (U_a.ι ≫ Z_a.ι) ≫ iZ := by
        rw [AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι]
      _ = p_a ≫ U_a.ι ≫ (Z_a.ι ≫ iZ) := by
        simp only [CategoryTheory.Category.assoc]
      _ = (p_a ≫ U_a.ι ≫ iZa) ≫ (W a).ι := by
        rw [← hiZa_comm]
        simp only [CategoryTheory.Category.assoc]
  refine ⟨?_, ?_⟩
  · intro X₁ X₂ g F
    obtain ⟨F', hPull_g, hTors_g⟩ := hPullEx g F
    refine ⟨F', hPull_g, fun hF => ⟨hTors_g hF.1, ?_⟩⟩
    intro Z' iZ' hiZ' hIntZ'
    have _ : AlgebraicGeometry.IsClosedImmersion iZ' := hiZ'
    have _ : AlgebraicGeometry.IsIntegral Z' := hIntZ'
    let h : Z' ⟶ X₂ := iZ' ≫ g
    let C : TopologicalSpace.Closeds ↥X₂ := ⟨closure (Set.range h.base), isClosed_closure⟩
    let I_Z : X₂.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
    let Z : AlgebraicGeometry.Scheme.{u} := I_Z.subscheme
    let iZ : Z ⟶ X₂ := I_Z.subschemeι
    have _ : AlgebraicGeometry.IsReduced Z := hs1 X₂ C
    obtain ⟨hIrrZ, qZ, hqZ_fac, hDense⟩ := hs2 h
    have _ : IrreducibleSpace ↥Z := hIrrZ
    have hIntZ : AlgebraicGeometry.IsIntegral Z :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Z
    obtain ⟨U, hU, V, p, A, hFin_p, hEt_p, hSurj_p, hFin_A, hTors_A, hPull_p⟩ :=
      hF.2 Z iZ inferInstance hIntZ
    obtain ⟨U', hU', V', p', v', hFin_p', hEt_p', hSurj_p', hComm_p'⟩ :=
      hs3_pull qZ hDense U hU V p hFin_p hEt_p hSurj_p
    have hCompEq : v' ≫ (p ≫ U.ι ≫ iZ) = (p' ≫ U'.ι ≫ iZ') ≫ g := by
      calc
        v' ≫ (p ≫ U.ι ≫ iZ) = (v' ≫ p ≫ U.ι) ≫ iZ := by
          simp only [CategoryTheory.Category.assoc]
        _ = (p' ≫ U'.ι ≫ qZ) ≫ iZ := by
          rw [hComm_p']
        _ = p' ≫ U'.ι ≫ (qZ ≫ iZ) := by
          simp only [CategoryTheory.Category.assoc]
        _ = (p' ≫ U'.ι ≫ iZ') ≫ g := by
          rw [hqZ_fac]
          dsimp [h]
          simp only [CategoryTheory.Category.assoc]
    have hPullCompF : WeilIsEtaleSheafPullback ((p' ≫ U'.ι ≫ iZ') ≫ g) F
        ((CategoryTheory.constantSheaf V'.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
      rw [← hCompEq]
      exact (hPullComp v' (p ≫ U.ι ≫ iZ) F _ _).1 hPull_p (hPullConst v' A)
    exact ⟨U', hU', V', p', A, hFin_p', hEt_p', hSurj_p', hFin_A, hTors_A,
      (hPullComp (p' ≫ U'.ι ≫ iZ') g F F' _).2 hPull_g hPullCompF⟩
  · intro Y G hTors n W hTop hCov
    refine ⟨hTors, ?_⟩
    intro Z iZ hiZ hIntZ
    have _ : AlgebraicGeometry.IsClosedImmersion iZ := hiZ
    have _ : AlgebraicGeometry.IsIntegral Z := hIntZ
    obtain ⟨a, Z_a, iZa, hIntZa, hiZa_cl, -, hLiftZa⟩ := hs3_cov iZ n W hTop
    obtain ⟨G_a, hPull_a, hConst_a⟩ := hCov a
    obtain ⟨U_a, hUa, V, p_a, A, hFin_pa, hEt_pa, hSurj_pa, hFin_A, hTors_A, hPull_pa⟩ :=
      hConst_a.2 (Z_a : AlgebraicGeometry.Scheme.{u}) iZa hiZa_cl hIntZa
    obtain ⟨U, hU, p, hFin_p, hEt_p, hSurj_p, hp_comm⟩ :=
      hLiftZa U_a hUa V p_a hFin_pa hEt_pa hSurj_pa
    have hPullG : WeilIsEtaleSheafPullback (p ≫ U.ι ≫ iZ) G
        ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
      rw [hp_comm]
      exact (hPullComp (p_a ≫ U_a.ι ≫ iZa) (W a).ι G G_a _).1 hPull_a hPull_pa
    exact ⟨U, hU, V, p, A, hFin_p, hEt_p, hSurj_p, hFin_A, hTors_A, hPullG⟩

theorem weil_etale_constructible_mod_prime_serre_and_local (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    WeilConstructibleModPrimeSerreHolds k ℓ :=
by
  classical
  obtain ⟨hPullExZero, hPullIso, hPullComp, hPullConst, hPullKerCoker, hPullSE⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  obtain ⟨hConnHom, hExtSplit⟩ :=
    weil_etale_constantSheaf_connected_hom_and_torsion_split.{u} ℓ
  obtain ⟨hGeomPull, hZarCov⟩ :=
    weil_etale_constructible_pullback_and_zariski_cover.{u} ℓ
      (fun h F₂ =>
        let ⟨F₁, hP, hT, _⟩ := hPullExZero h F₂
        ⟨F₁, hP, hT⟩)
      hPullComp hPullConst
  have hZeroSheaf : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero F → WeilIsConstructibleModPrimeSheaf ℓ Y F := by
    intro Y F hZero
    refine ⟨hZero.eq_of_src _ _, ?_⟩
    intro Z iZ hiZ hIntZ
    have _ : AlgebraicGeometry.IsClosedImmersion iZ := hiZ
    have _ : AlgebraicGeometry.IsIntegral Z := hIntZ
    let U : Z.Opens := ⊤
    have hU : Nonempty U := ⟨⟨Classical.arbitrary ↥Z, trivial⟩⟩
    let V : AlgebraicGeometry.Scheme.{u} := (U : AlgebraicGeometry.Scheme.{u})
    let p : V ⟶ (U : AlgebraicGeometry.Scheme.{u}) := 𝟙 V
    let A₀ : AddCommGrpCat.{u} :=
      AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod 1))
    have hFinA₀ : Finite A₀ := by
      change Finite (ULift.{u, 0} (ZMod 1))
      infer_instance
    have hZeroA₀ : CategoryTheory.Limits.IsZero A₀ := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext ⟨x⟩
      exact ULift.ext _ _ (Subsingleton.elim _ _)
    let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
    have _ : C_V.Additive := by
      dsimp [C_V]
      infer_instance
    have hZeroCV : CategoryTheory.Limits.IsZero (C_V.obj A₀) := C_V.map_isZero hZeroA₀
    obtain ⟨F_V, hPullFV, _, hZeroMap⟩ := hPullExZero (p ≫ U.ι ≫ iZ) F
    have hZeroFV : CategoryTheory.Limits.IsZero F_V := hZeroMap hZero
    exact ⟨U, hU, V, p, A₀, inferInstance, inferInstance, inferInstance, hFinA₀,
      hZeroA₀.eq_of_src _ _,
      hPullIso (p ≫ U.ι ≫ iZ) F F F_V (C_V.obj A₀) hPullFV
        ⟨CategoryTheory.Iso.refl F⟩ ⟨hZeroFV.iso hZeroCV⟩⟩
  have hCommonShrink : ∀ {Y_sch : AlgebraicGeometry.Scheme.{u}}
      (G₁ G₂ : CategoryTheory.Sheaf Y_sch.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsConstructibleModPrimeSheaf ℓ Y_sch G₁ →
      WeilIsConstructibleModPrimeSheaf ℓ Y_sch G₂ →
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (iZ : Z ⟶ Y_sch),
        AlgebraicGeometry.IsClosedImmersion iZ →
        AlgebraicGeometry.IsIntegral Z →
        ∃ (U₀ : Z.Opens) (U'_0 : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) (_ : Nonempty U'_0)
          (V₀ : AlgebraicGeometry.Scheme.{u}) (p₀ : V₀ ⟶ (U'_0 : AlgebraicGeometry.Scheme.{u}))
          (A₁ A₂ : AddCommGrpCat.{u}),
          AlgebraicGeometry.IsAffine (U'_0 : AlgebraicGeometry.Scheme.{u}) ∧
          AlgebraicGeometry.IsIntegral (U'_0 : AlgebraicGeometry.Scheme.{u}) ∧
          AlgebraicGeometry.IsIntegral V₀ ∧
          AlgebraicGeometry.IsFinite p₀ ∧
          AlgebraicGeometry.Etale p₀ ∧
          AlgebraicGeometry.Surjective p₀ ∧
          Finite A₁ ∧ ℓ • CategoryTheory.CategoryStruct.id A₁ = 0 ∧
          Finite A₂ ∧ ℓ • CategoryTheory.CategoryStruct.id A₂ = 0 ∧
          WeilIsEtaleSheafPullback (p₀ ≫ U'_0.ι ≫ U₀.ι ≫ iZ) G₁
            ((CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₁) ∧
          WeilIsEtaleSheafPullback (p₀ ≫ U'_0.ι ≫ U₀.ι ≫ iZ) G₂
            ((CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) := by
    intro Y_sch G₁ G₂ hG₁ hG₂ Z iZ hiZ hIntZ
    have _ : AlgebraicGeometry.IsClosedImmersion iZ := hiZ
    have _ : AlgebraicGeometry.IsIntegral Z := hIntZ
    obtain ⟨U₁, ⟨u₁⟩, V₁, p₁, A₁, _, hEt₁, hSurj₁, hFinA₁, hTorsA₁, hPull₁⟩ :=
      hG₁.2 Z iZ hiZ hIntZ
    obtain ⟨U₂, ⟨u₂⟩, V₂, p₂, A₂, _, hEt₂, hSurj₂, hFinA₂, hTorsA₂, hPull₂⟩ :=
      hG₂.2 Z iZ hiZ hIntZ
    have _ : AlgebraicGeometry.Etale p₁ := hEt₁
    have _ : AlgebraicGeometry.Surjective p₁ := hSurj₁
    have _ : AlgebraicGeometry.Etale p₂ := hEt₂
    have _ : AlgebraicGeometry.Surjective p₂ := hSurj₂
    obtain ⟨z₀, hz₀_1, hz₀_2⟩ :=
      nonempty_preirreducible_inter U₁.isOpen U₂.isOpen ⟨u₁.1, u₁.2⟩ ⟨u₂.1, u₂.2⟩
    have hz₀_inf : z₀ ∈ (U₁ ⊓ U₂ : Z.Opens) := ⟨hz₀_1, hz₀_2⟩
    obtain ⟨U₀_top, hU₀_aff, hz₀_U₀, hU₀_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens Z))
        hz₀_inf
    let U₀ : Z.Opens := U₀_top
    have _ : AlgebraicGeometry.IsAffine (U₀ : AlgebraicGeometry.Scheme.{u}) := hU₀_aff
    have _ : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨z₀, hz₀_U₀⟩⟩
    have _ : AlgebraicGeometry.IsIntegral (U₀ : AlgebraicGeometry.Scheme.{u}) :=
