        have ht_u : (f - g) ≫ u 0 = 0 := by
          have h1 := congrArg (· ≫ CategoryTheory.Limits.biprod.fst) ht
          simpa [C_d, hv0] using h1
        have ht_δ : (f - g) ≫ δ 0 = 0 := by
          have h2 := congrArg (· ≫ CategoryTheory.Limits.biprod.snd) ht
          simpa [C_d] using h2
        obtain ⟨t_tilde, htt⟩ := hε_lift (f - g) ht_δ
        have htt_ι : t_tilde ≫ ι₀ = 0 := by
          rw [← hu_zero, ← CategoryTheory.Category.assoc, htt, ht_u]
        have ht0 : t_tilde = 0 := by
          rw [← CategoryTheory.cancel_mono ι₀, CategoryTheory.Limits.zero_comp, htt_ι]
        rw [← htt, ht0, CategoryTheory.Limits.zero_comp]
      have hCd00 : (C.sc' 0 0 1).f = 0 := C.shape 0 0 (by simp)
      have hC0_ex : (C.sc' 0 0 1).Exact := ((C.sc' 0 0 1).exact_iff_mono hCd00).mpr hCd0_mono
      have hC0_sc_z : CategoryTheory.Limits.IsZero (C.sc' 0 0 1).homology :=
        ((C.sc' 0 0 1).exact_iff_isZero_homology).mp hC0_ex
      exact hC0_sc_z.of_iso
        (C.homologyIsoSc' 0 0 1 CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0))
    have hC_z1 : CategoryTheory.Limits.IsZero (C.homology 1) := by
      let S₁ := C.sc' 0 1 2
      let kl := CategoryTheory.Limits.kernel.lift S₁.g S₁.f S₁.zero
      let T := CategoryTheory.Limits.kernel S₁.g
      let ιT : T ⟶ K₀.X 0 ⊞ J.cocomplex.X 1 := CategoryTheory.Limits.kernel.ι S₁.g
      let tK : T ⟶ K₀.X 0 := ιT ≫ CategoryTheory.Limits.biprod.fst
      let tJ : T ⟶ J.cocomplex.X 1 := ιT ≫ CategoryTheory.Limits.biprod.snd
      have hιT_decomp : ιT =
          tK ≫ CategoryTheory.Limits.biprod.inl + tJ ≫ CategoryTheory.Limits.biprod.inr := by
        calc ιT
            = ιT ≫ 𝟙 (K₀.X 0 ⊞ J.cocomplex.X 1) := (CategoryTheory.Category.comp_id ιT).symm
          _ = ιT ≫ (CategoryTheory.Limits.biprod.fst ≫ CategoryTheory.Limits.biprod.inl +
                CategoryTheory.Limits.biprod.snd ≫ CategoryTheory.Limits.biprod.inr) := by
              rw [CategoryTheory.Limits.biprod.total]
          _ = tK ≫ CategoryTheory.Limits.biprod.inl + tJ ≫ CategoryTheory.Limits.biprod.inr := by
              rw [CategoryTheory.Preadditive.comp_add, ← CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc]
      have hιT_g : ιT ≫ C_d 1 = 0 := by
        have hcond : ιT ≫ C.d 1 2 = 0 := CategoryTheory.Limits.kernel.condition S₁.g
        rwa [hC_d_succ 0] at hcond
      have htJ_d : tJ ≫ δ 1 = 0 := by
        have h2 : (ιT ≫ C_d 1) ≫ CategoryTheory.Limits.biprod.snd = 0 := by
          rw [hιT_g, CategoryTheory.Limits.zero_comp]
        rw [hιT_decomp] at h2
        dsimp only [C_d] at h2
        simp only [CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inl_desc_assoc,
          CategoryTheory.Limits.biprod.inr_desc_assoc,
          CategoryTheory.Limits.biprod.lift_snd,
          CategoryTheory.Limits.comp_zero, zero_add] at h2
        exact h2
      have htK_d : tK ≫ K₀.d 0 1 = tJ ≫ u 1 := by
        have h1 : (ιT ≫ C_d 1) ≫ CategoryTheory.Limits.biprod.fst = 0 := by
          rw [hιT_g, CategoryTheory.Limits.zero_comp]
        rw [hιT_decomp] at h1
        dsimp only [C_d] at h1
        simp only [CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biprod.inl_desc_assoc,
          CategoryTheory.Limits.biprod.inr_desc_assoc,
          CategoryTheory.Limits.biprod.lift_fst,
          hv1, CategoryTheory.Preadditive.comp_neg] at h1
        exact sub_eq_zero.mp (by simpa [sub_eq_add_neg] using h1)
      let tJ_ker : T ⟶ CategoryTheory.Limits.kernel (δ 1) :=
        CategoryTheory.Limits.kernel.lift (δ 1) tJ htJ_d
      let qJ : J.cocomplex.X 0 ⟶ CategoryTheory.Limits.kernel (δ 1) :=
        CategoryTheory.Limits.kernel.lift (δ 1) (δ 0) (J.cocomplex.d_comp_d 0 1 2)
      have : CategoryTheory.Epi qJ :=
        ((J.cocomplex.sc' 0 1 2).exact_iff_epi_kernel_lift).mp (J.exact_succ 0)
      let T' := CategoryTheory.Limits.pullback qJ tJ_ker
      let s₀ : T' ⟶ J.cocomplex.X 0 := CategoryTheory.Limits.pullback.fst qJ tJ_ker
      let πT : T' ⟶ T := CategoryTheory.Limits.pullback.snd qJ tJ_ker
      have : CategoryTheory.Epi πT := CategoryTheory.Abelian.epi_pullback_of_epi_f qJ tJ_ker
      have hs₀_δ : s₀ ≫ δ 0 = πT ≫ tJ := by
        have hpb := congrArg (· ≫ CategoryTheory.Limits.kernel.ι (δ 1))
          (CategoryTheory.Limits.pullback.condition (f := qJ) (g := tJ_ker))
        simpa [s₀, πT, qJ, tJ_ker] using hpb
      have hdiff_d : (πT ≫ tK - s₀ ≫ u 0) ≫ K₀.d 0 1 = 0 := by
        have hu01_u : u 0 ≫ K₀.d 0 1 = δ 0 ≫ u 1 := hu₀₁.symm
        rw [CategoryTheory.Preadditive.sub_comp,
          CategoryTheory.Category.assoc πT tK (K₀.d 0 1),
          CategoryTheory.Category.assoc s₀ (u 0) (K₀.d 0 1),
          htK_d, hu01_u,
          ← CategoryTheory.Category.assoc πT tJ (u 1),
          ← CategoryTheory.Category.assoc s₀ (δ 0) (u 1),
          hs₀_δ, sub_self]
      obtain ⟨h₀, hh₀⟩ := hι₀_lift (πT ≫ tK - s₀ ≫ u 0) hdiff_d
      let s_hat : T' ⟶ J.cocomplex.X 0 := s₀ + h₀ ≫ ε
      have hs_hat_kl : s_hat ≫ kl = πT :=
        (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι S₁.g)).mp <| by
          have hkl_ι : s_hat ≫ (kl ≫ CategoryTheory.Limits.kernel.ι S₁.g) =
              s_hat ≫ C.d 0 1 :=
            congrArg (s_hat ≫ ·) (CategoryTheory.Limits.kernel.lift_ι S₁.g S₁.f S₁.zero)
          have hlhs : (s_hat ≫ kl) ≫ CategoryTheory.Limits.kernel.ι S₁.g =
              s_hat ≫ C_d 0 := by
            refine (CategoryTheory.Category.assoc s_hat kl _).trans (hkl_ι.trans ?_)
            rw [hC_d0]
          refine hlhs.trans ?_
          change s_hat ≫ C_d 0 = πT ≫ ιT
          apply CategoryTheory.Limits.biprod.hom_ext
          · simp only [s_hat, C_d, hv0, CategoryTheory.Preadditive.add_comp,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_fst, hu_zero, hh₀]
            exact add_sub_cancel _ _
          · simp only [s_hat, C_d, CategoryTheory.Preadditive.add_comp,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_snd, hε_d,
              CategoryTheory.Limits.comp_zero, add_zero, hs₀_δ, tJ]
      have : CategoryTheory.Epi (s_hat ≫ kl) := hs_hat_kl.symm ▸ inferInstance
      have hkl_epi : CategoryTheory.Epi kl := CategoryTheory.epi_of_epi s_hat kl
      have hS₁_ex : S₁.Exact := (S₁.exact_iff_epi_kernel_lift).mpr hkl_epi
      have hS₁_z : CategoryTheory.Limits.IsZero S₁.homology :=
        (S₁.exact_iff_isZero_homology).mp hS₁_ex
      exact hS₁_z.of_iso
        (C.homologyIsoSc' 0 1 2 (CochainComplex.prev_nat_succ 0) (CochainComplex.next ℕ 1))
    have hJ_z : ∀ n : ℕ, CategoryTheory.Limits.IsZero (J.cocomplex.homology (n + 1)) := by
      intro n
      have hsc_z : CategoryTheory.Limits.IsZero (J.cocomplex.sc' n (n + 1) (n + 2)).homology :=
        ((J.cocomplex.sc' n (n + 1) (n + 2)).exact_iff_isZero_homology).mp (J.exact_succ n)
      exact hsc_z.of_iso (J.cocomplex.homologyIsoSc' n (n + 1) (n + 2)
        (CochainComplex.prev_nat_succ n) (CochainComplex.next ℕ (n + 1)))
    refine ⟨K_sh, C, ι_sh, π_C, hF_zero, hC_inj, hC_z0, hC_z1, ?_, hSE_F, ?_⟩
    · intro m
      let S_Ksh := K_sh.sc' (m + 1) (m + 2) (m + 3)
      let S_K := K₀.sc' m (m + 1) (m + 2)
      let e_sc : S_Ksh ≅ S_K := CategoryTheory.ShortComplex.isoMk
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by
          change 𝟙 _ ≫ K₀.d m (m + 1) = K_sh.d (m + 1) (m + 2) ≫ 𝟙 _
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id, hKsh_d_succ m])
        (by
          change 𝟙 _ ≫ K₀.d (m + 1) (m + 2) = K_sh.d (m + 2) (m + 3) ≫ 𝟙 _
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id, hKsh_d_succ (m + 1)])
      let e_Ksh : K_sh.homology (m + 2) ≅ K₀.homology (m + 1) :=
        (K_sh.homologyIsoSc' (m + 1) (m + 2) (m + 3)
          (CochainComplex.prev_nat_succ (m + 1)) (CochainComplex.next ℕ (m + 2))).trans
          ((CategoryTheory.ShortComplex.homologyMapIso e_sc).trans
            (K₀.homologyIsoSc' m (m + 1) (m + 2)
              (CochainComplex.prev_nat_succ m) (CochainComplex.next ℕ (m + 1))).symm)
      have hex1 := hSE_A.homology_exact₁ (m + 1) (m + 2) rfl
      have : CategoryTheory.Mono (HomologicalComplex.homologyMap ι_sh (m + 2)) :=
        ((CategoryTheory.ShortComplex.exact_iff_mono _ ((hJ_z m).eq_of_src _ _)).mp hex1)
      have hex2 := hSE_A.homology_exact₂ (m + 2)
      have : CategoryTheory.Epi (HomologicalComplex.homologyMap ι_sh (m + 2)) :=
        (hex2.epi_f_iff).mpr ((hJ_z (m + 1)).eq_of_tgt _ _)
      have : CategoryTheory.IsIso (HomologicalComplex.homologyMap ι_sh (m + 2)) :=
        CategoryTheory.isIso_of_mono_of_epi _
      exact ⟨(CategoryTheory.asIso (HomologicalComplex.homologyMap ι_sh (m + 2))).symm.trans e_Ksh⟩
    · intro m
      let S_FKsh := FK_sh.sc' (m + 1) (m + 2) (m + 3)
      let S_FK := FK₀.sc' m (m + 1) (m + 2)
      let e_sc : S_FKsh ≅ S_FK := CategoryTheory.ShortComplex.isoMk
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by
          change 𝟙 _ ≫ F.map (K₀.d m (m + 1)) = F.map (K_sh.d (m + 1) (m + 2)) ≫ 𝟙 _
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id, hKsh_d_succ m])
        (by
          change 𝟙 _ ≫ F.map (K₀.d (m + 1) (m + 2)) = F.map (K_sh.d (m + 2) (m + 3)) ≫ 𝟙 _
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id, hKsh_d_succ (m + 1)])
      exact ⟨(FK_sh.homologyIsoSc' (m + 1) (m + 2) (m + 3)
          (CochainComplex.prev_nat_succ (m + 1)) (CochainComplex.next ℕ (m + 2))).trans
        ((CategoryTheory.ShortComplex.homologyMapIso e_sc).trans
          (FK₀.homologyIsoSc' m (m + 1) (m + 2)
            (CochainComplex.prev_nat_succ m) (CochainComplex.next ℕ (m + 1))).symm)⟩
  suffices h_main : ∀ (q₀ : ℕ) (K₀ : CochainComplex A_cat ℕ),
      (∀ n : ℕ, CategoryTheory.Injective (K₀.X n)) →
      (∀ b : ℕ, P_A (K₀.homology b)) →
      P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K₀).homology q₀) from
    h_main q K hK_inj hK_coh
  intro q₀
  refine Nat.strongRecOn q₀ fun q₀ ih K₀ hK₀_inj hK₀_coh => ?_
  rcases q₀ with _ | q'
  · let H₀ : A_cat := K₀.homology 0
    have : CategoryTheory.HasInjectiveResolution H₀ := CategoryTheory.HasInjectiveResolutions.out H₀
    let J : CategoryTheory.InjectiveResolution H₀ := CategoryTheory.injectiveResolution H₀
    obtain ⟨e_FJ⟩ := h_s1.1 J.cocomplex
    obtain ⟨e_J0⟩ := h_s1.2 H₀ J
    obtain ⟨e_FK⟩ := h_s1.1 K₀
    exact hPB_iso ⟨e_FJ.trans ((F.mapIso e_J0).trans e_FK.symm)⟩ (hF_res H₀ (hK₀_coh 0) J 0)
  · let H₀ : A_cat := K₀.homology 0
    have : CategoryTheory.HasInjectiveResolution H₀ := CategoryTheory.HasInjectiveResolutions.out H₀
    let J : CategoryTheory.InjectiveResolution H₀ := CategoryTheory.injectiveResolution H₀
    obtain ⟨K_sh, C, ι_sh, π_C, hF_zero, hC_inj, hC_z0, hC_z1, hC_coh, hSE_F, hFK_sh⟩ :=
      h_s2 K₀ hK₀_inj J
    obtain ⟨C₁, hC₁_inj, hC_C₁_coh, -, hFC_FC₁⟩ := h_s3 C hC_inj hC_z0
    obtain ⟨e_C1⟩ := hC_C₁_coh 0
    have hC₁_z0 : CategoryTheory.Limits.IsZero (C₁.homology 0) := hC_z1.of_iso e_C1.symm
    obtain ⟨K', hK'_inj, hC₁_K'_coh, hFC₁_z0, hFC₁_FK'⟩ := h_s3 C₁ hC₁_inj hC₁_z0
    have hK'_coh : ∀ b : ℕ, P_A (K'.homology b) := by
      intro b
      obtain ⟨e₁⟩ := hC_coh b
      obtain ⟨e₂⟩ := hC_C₁_coh (b + 1)
      obtain ⟨e₃⟩ := hC₁_K'_coh b
      exact hPA_iso ⟨e₁.symm.trans (e₂.trans e₃)⟩ (hK₀_coh (b + 1))
    have hPB_1 : P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology (q' + 1)) := by
      rcases q' with _ | r
      · obtain ⟨e_FC1⟩ := hFC_FC₁ 0
        exact hPB_iso ⟨e_FC1.symm⟩ (hPB_zero hFC₁_z0)
      · obtain ⟨e_a⟩ := hFC_FC₁ (r + 1)
        obtain ⟨e_b⟩ := hFC₁_FK' r
        exact hPB_iso ⟨(e_a.trans e_b).symm⟩ (ih r (by omega) K' hK'_inj hK'_coh)
    have hPB_2 : P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology (q' + 1)) :=
      hF_res H₀ (hK₀_coh 0) J (q' + 1)
    have hPB_4 : P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology (q' + 2)) := by
      obtain ⟨e_c⟩ := hFC_FC₁ (q' + 1)
      obtain ⟨e_d⟩ := hFC₁_FK' q'
      exact hPB_iso ⟨(e_c.trans e_d).symm⟩ (ih q' (Nat.lt_succ_self q') K' hK'_inj hK'_coh)
    have hPB_5 : P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology (q' + 2)) :=
      hF_res H₀ (hK₀_coh 0) J (q' + 2)
    let getZ := fun {S : CategoryTheory.ShortComplex B_cat} (_ : S.Exact) => S.zero
    have hex3 := hSE_F.homology_exact₃ (q' + 1) (q' + 2) rfl
    have hex1 := hSE_F.homology_exact₁ (q' + 1) (q' + 2) rfl
    have hex2 := hSE_F.homology_exact₂ (q' + 2)
    have hPB_Ksh : P_B (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj K_sh).homology (q' + 2)) :=
      hPB_five
        (HomologicalComplex.homologyMap ((F.mapHomologicalComplex (ComplexShape.up ℕ)).map π_C) (q' + 1))
        (hSE_F.δ (q' + 1) (q' + 2) rfl)
        (HomologicalComplex.homologyMap ((F.mapHomologicalComplex (ComplexShape.up ℕ)).map ι_sh) (q' + 2))
        (HomologicalComplex.homologyMap ((F.mapHomologicalComplex (ComplexShape.up ℕ)).map π_C) (q' + 2))
        (getZ hex3) (getZ hex1) (getZ hex2)
        hex3 hex1 hex2 hPB_1 hPB_2 hPB_4 hPB_5
    obtain ⟨e_sh⟩ := hFK_sh q'
    exact hPB_iso ⟨e_sh⟩ hPB_Ksh

theorem weil_etale_proper_composition_constructible (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hSerre : WeilConstructibleModPrimeSerreHolds k ℓ)
    (X_bar X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    [AlgebraicGeometry.QuasiCompact S.hom]
    [AlgebraicGeometry.IsSeparated S.hom]
    (π : X_bar ⟶ X) (hπ : AlgebraicGeometry.IsProper π.left)
    (f : X ⟶ S) (hf : AlgebraicGeometry.IsProper f.left)
    (hPush_π : ∀ (F_bar : CategoryTheory.Sheaf X_bar.left.smallEtaleTopology AddCommGrpCat.{u})
        (b : ℕ),
      WeilIsConstructibleModPrimeSheaf ℓ X_bar.left F_bar →
      WeilIsConstructibleModPrimeSheaf ℓ X.left (weilEtaleHigherDirectImage π.left b F_bar))
    (hPush_f : ∀ (G : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}) (a : ℕ),
      WeilIsConstructibleModPrimeSheaf ℓ X.left G →
      WeilIsConstructibleModPrimeSheaf ℓ S.left (weilEtaleHigherDirectImage f.left a G))
    (F_bar : CategoryTheory.Sheaf X_bar.left.smallEtaleTopology AddCommGrpCat.{u})
    (hF_bar : WeilIsConstructibleModPrimeSheaf ℓ X_bar.left F_bar) (q : ℕ) :
    WeilIsConstructibleModPrimeSheaf ℓ S.left
      (weilEtaleHigherDirectImage (π.left ≫ f.left) q F_bar) :=
by
  have _ : AlgebraicGeometry.IsProper f.left := hf
  have _ : AlgebraicGeometry.LocallyOfFiniteType X.hom := by
    rw [← CategoryTheory.Over.w f]
    infer_instance
  have _ : AlgebraicGeometry.QuasiCompact X.hom := by
    rw [← CategoryTheory.Over.w f]
    infer_instance
  have _ : AlgebraicGeometry.IsSeparated X.hom := by
    rw [← CategoryTheory.Over.w f]
    infer_instance
  obtain ⟨hCont, hPushProps, hPushComp⟩ :=
    weil_etale_pushforward_continuous_comp_and_injective.{u}
  letI : (weilCompEtaleSitePullback π.left).IsContinuous
      X.left.smallEtaleTopology X_bar.left.smallEtaleTopology :=
    hCont π.left
  letI : (weilCompEtaleSitePullback f.left).IsContinuous
      S.left.smallEtaleTopology X.left.smallEtaleTopology :=
    hCont f.left
  letI : (weilCompEtaleSitePullback (π.left ≫ f.left)).IsContinuous
      S.left.smallEtaleTopology X_bar.left.smallEtaleTopology :=
    hCont (π.left ≫ f.left)
  let π_push := (weilCompEtaleSitePullback π.left).sheafPushforwardContinuous
    AddCommGrpCat.{u} X.left.smallEtaleTopology X_bar.left.smallEtaleTopology
  let f_push := (weilCompEtaleSitePullback f.left).sheafPushforwardContinuous
    AddCommGrpCat.{u} S.left.smallEtaleTopology X.left.smallEtaleTopology
  let πf_push := (weilCompEtaleSitePullback (π.left ≫ f.left)).sheafPushforwardContinuous
    AddCommGrpCat.{u} S.left.smallEtaleTopology X_bar.left.smallEtaleTopology
  obtain ⟨hAdd_π, _, hInj_π⟩ := hPushProps π.left
  obtain ⟨hAdd_f, hLim_f, _⟩ := hPushProps f.left
  obtain ⟨hAdd_πf, _, _⟩ := hPushProps (π.left ≫ f.left)
  letI : π_push.Additive := hAdd_π
  letI : f_push.Additive := hAdd_f
  letI : CategoryTheory.Limits.PreservesFiniteLimits f_push := hLim_f
  letI : πf_push.Additive := hAdd_πf
  obtain ⟨e_comp⟩ := hPushComp π.left f.left
  obtain ⟨_, _, _, hRes_π⟩ :=
    weil_etale_higherDirectImage_exact_and_injectiveResolution π.left
  obtain ⟨hTors_f, hIso_f, hLES_f, hRes_f⟩ :=
    weil_etale_higherDirectImage_exact_and_injectiveResolution f.left
  obtain ⟨hTors_πf, _, _, hRes_πf⟩ :=
    weil_etale_higherDirectImage_exact_and_injectiveResolution (π.left ≫ f.left)
  obtain ⟨_, hMod_X, hIso_PX, _, _⟩ :=
    weil_ellPrimary_serre_closure_and_mod_prime_extraction k ℓ hSerre X
  obtain ⟨hZero_PS, hMod_S, hIso_PS, hExtract_S, hFive_PS⟩ :=
    weil_ellPrimary_serre_closure_and_mod_prime_extraction k ℓ hSerre S
  have hPush_f_step : ∀ (m : ℕ)
      (M : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilEllPrimaryConstructibleStep ℓ X.left m M →
      ∀ (a : ℕ), WeilEllPrimaryConstructible ℓ S.left (weilEtaleHigherDirectImage f.left a M) := by
    intro m
    induction m with
    | zero =>
      intro M hZeroM a
      change CategoryTheory.Limits.IsZero M at hZeroM
      have h1 : (1 : ℕ) • CategoryTheory.CategoryStruct.id M = 0 := by
        rw [one_nsmul, CategoryTheory.Limits.IsZero.iff_id_eq_zero] at *
        exact hZeroM
      have h1_push : (1 : ℕ) •
          CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f.left a M) = 0 :=
        hTors_f 1 a M h1
      rw [one_nsmul, ← CategoryTheory.Limits.IsZero.iff_id_eq_zero] at h1_push
      exact hZero_PS _ h1_push
    | succ m ih =>
      intro M hStep a
      rcases hStep with ⟨SC, hSE, hIsoM, hX₁, hX₃⟩
      obtain ⟨α, β, δ, hαβ, hβδ, hδα, hMono0, hEx_αβ, hEx_βδ, hEx_δα⟩ := hLES_f SC hSE
      have hX₂_a : WeilEllPrimaryConstructible ℓ S.left
          (weilEtaleHigherDirectImage f.left a SC.X₂) := by
        rcases a with _ | k
        · obtain ⟨Z₀, hZ₀⟩ :=
            (inferInstance : CategoryTheory.Limits.HasZeroObject
              (CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u})).zero
          let z₀ : Z₀ ⟶ weilEtaleHigherDirectImage f.left 0 SC.X₁ := 0
          have hzα : z₀ ≫ α 0 = 0 := CategoryTheory.Limits.zero_comp
          have hEx0 : (CategoryTheory.ShortComplex.mk z₀ (α 0) hzα).Exact :=
            ((CategoryTheory.ShortComplex.mk z₀ (α 0) hzα).exact_iff_mono rfl).mpr hMono0
          exact hFive_PS z₀ (α 0) (β 0) (δ 0) hzα (hαβ 0) (hβδ 0)
            hEx0 (hEx_αβ 0) (hEx_βδ 0)
            (hZero_PS Z₀ hZ₀)
            (ih SC.X₁ hX₁ 0)
            (hMod_S _ (hPush_f SC.X₃ 0 hX₃))
            (ih SC.X₁ hX₁ 1)
        · exact hFive_PS (δ k) (α (k + 1)) (β (k + 1)) (δ (k + 1))
            (hδα k) (hαβ (k + 1)) (hβδ (k + 1))
            (hEx_δα k) (hEx_αβ (k + 1)) (hEx_βδ (k + 1))
            (hMod_S _ (hPush_f SC.X₃ k hX₃))
            (ih SC.X₁ hX₁ (k + 1))
            (hMod_S _ (hPush_f SC.X₃ (k + 1) hX₃))
            (ih SC.X₁ hX₁ (k + 2))
      exact hIso_PS _ _ (hIso_f a SC.X₂ M hIsoM) hX₂_a
  have hF_res : ∀ (H : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
      WeilEllPrimaryConstructible ℓ X.left H →
      ∀ (J : CategoryTheory.InjectiveResolution H) (a : ℕ),
        WeilEllPrimaryConstructible ℓ S.left
          (((f_push.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology a) := by
    intro H ⟨m, hm⟩ J a
    exact hIso_PS _ _ (hRes_f H J a) (hPush_f_step m H hm a)
  let I : CategoryTheory.InjectiveResolution F_bar :=
    CategoryTheory.injectiveResolution F_bar
  let K : CochainComplex
      (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}) ℕ :=
    (π_push.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hK_inj : ∀ n : ℕ, CategoryTheory.Injective (K.X n) :=
    fun n => hInj_π (I.cocomplex.X n) (I.injective n)
  have hK_coh : ∀ b : ℕ, WeilEllPrimaryConstructible ℓ X.left (K.homology b) := by
    intro b
    exact hIso_PX _ _ (hRes_π F_bar I b) (hMod_X _ (hPush_π F_bar b hF_bar))
  have hFK_q : WeilEllPrimaryConstructible ℓ S.left
      (((f_push.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q) :=
    weil_abelian_injective_cochain_pushforward_serre
      (CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u})
      (CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u})
      f_push
      (WeilEllPrimaryConstructible ℓ X.left)
      (WeilEllPrimaryConstructible ℓ S.left)
      (fun {_ _} hIso hPA => hIso_PX _ _ hIso hPA)
      (fun {_} hZ => hZero_PS _ hZ)
      (fun {_ _} hIso hPB => hIso_PS _ _ hIso hPB)
      (fun f₁ f₂ f₃ f₄ h₁₂ h₂₃ h₃₄ hex₁ hex₂ hex₃ h₁ h₂ h₄ h₅ =>
        hFive_PS f₁ f₂ f₃ f₄ h₁₂ h₂₃ h₃₄ hex₁ hex₂ hex₃ h₁ h₂ h₄ h₅)
      hF_res K hK_inj hK_coh q
  let _ : (π_push.comp f_push).Additive := inferInstance
  let iso_assoc :
      ((f_push.mapHomologicalComplex (ComplexShape.up ℕ)).obj K) ≅
      (((π_push.comp f_push).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) :=
    HomologicalComplex.Hom.isoOfComponents (fun _ => CategoryTheory.Iso.refl _)
      (fun i j _ => by simp [K])
  let iso_comp :
      (((π_push.comp f_push).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) ≅
      ((πf_push.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) :=
    (CategoryTheory.NatIso.mapHomologicalComplex e_comp.symm (ComplexShape.up ℕ)).app I.cocomplex
  obtain ⟨iso_πf⟩ := hRes_πf F_bar I q
  let iso_tot :
      (((f_push.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q) ≅
      weilEtaleHigherDirectImage (π.left ≫ f.left) q F_bar :=
    (HomologicalComplex.homologyMapIso (iso_assoc.trans iso_comp) q).trans iso_πf.symm
  have hPS_tot : WeilEllPrimaryConstructible ℓ S.left
      (weilEtaleHigherDirectImage (π.left ≫ f.left) q F_bar) :=
    hIso_PS _ _ ⟨iso_tot⟩ hFK_q
  have hTors_tot : ℓ • CategoryTheory.CategoryStruct.id
      (weilEtaleHigherDirectImage (π.left ≫ f.left) q F_bar) = 0 :=
    hTors_πf ℓ q F_bar hF_bar.1
  exact hExtract_S _ hPS_tot hTors_tot

theorem weil_projSpace_codimTwo_center_and_line_projection (k : Type u) [Field k] (m : ℕ) :
    let P_amb := weilProjectiveSpaceOver k (m + 2)
    let P_sub := weilProjectiveSpaceOver k m
    let P_1 := weilProjectiveSpaceOver k 1
    let U_k := weilCodimTwoComplOpen k m
    let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    letI : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
    let W_1 : Fin 2 → P_1.left.Opens := fun c =>
      AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X c)
    ((⨆ c : Fin 2, W_1 c) = ⊤) ∧
    (∀ c : Fin 2, AlgebraicGeometry.QuasiCompact (W_1 c).ι) ∧
    Nonempty U_k ∧
    CompactSpace ↥(U_k : AlgebraicGeometry.Scheme.{u}) ∧
    (∃ (i_k : P_sub ⟶ P_amb),
      AlgebraicGeometry.IsClosedImmersion i_k.left ∧
      Set.range i_k.left.base = (U_k : Set P_amb.left)ᶜ) ∧
    (∃ (pr_k : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ P_1.left),
      WeilIsCodimTwoLineProjection k m pr_k) :=
by
  intro P_amb P_sub P_1 U_k 𝒜_1 W_1
  let _ : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
  let 𝒜_sub := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
  let 𝒜_amb := MvPolynomial.homogeneousSubmodule (Fin (m + 3)) k
  let _ : GradedAlgebra 𝒜_sub := MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra 𝒜_amb := MvPolynomial.gradedAlgebra
  let X_1 := AlgebraicGeometry.Proj 𝒜_1
  let X_sub := AlgebraicGeometry.Proj 𝒜_sub
  let X_amb := AlgebraicGeometry.Proj 𝒜_amb

  
  have hStdCov : ∀ (N : ℕ),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)) = ⊤ := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X
    rw [HomogeneousIdeal.irrelevant_eq_span, Ideal.span_le]
    rintro p hp
    simp only [Set.mem_iUnion] at hp
    rcases hp with ⟨i, hi_pos, hp_mem⟩
    change 0 < i at hi_pos
    have hp_hom : MvPolynomial.IsHomogeneous p i :=
      (MvPolynomial.mem_homogeneousSubmodule i p).mp hp_mem
    have hrange : Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k) =
        MvPolynomial.X '' Set.univ := Set.image_univ.symm
    change p ∈ Ideal.span (Set.range MvPolynomial.X)
    rw [hrange, MvPolynomial.mem_ideal_span_X_image]
    intro μ hμ
    by_contra h_all
    have hμ0 : μ = 0 := by
      ext a
      by_contra ha
      exact h_all ⟨a, Set.mem_univ a, ha⟩
    have hdeg := hp_hom (MvPolynomial.mem_support_iff.mp hμ)
    rw [hμ0] at hdeg
    simp only [map_zero] at hdeg
    omega

  have hCov_1 : (⨆ c : Fin 2, W_1 c) = ⊤ := hStdCov 1
  have hCov_sub : (⨆ r : Fin (m + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_sub (MvPolynomial.X r)) = ⊤ :=
    hStdCov m
  have hCov_amb : (⨆ a : Fin (m + 3), AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X a)) = ⊤ :=
    hStdCov (m + 2)

  
  have hQcW : ∀ c : Fin 2, AlgebraicGeometry.QuasiCompact (W_1 c).ι := by
    have hProperP1 : AlgebraicGeometry.IsProper P_1.hom := by
      have : IsScalarTower k ↥(𝒜_1 0) (MvPolynomial (Fin 2) k) :=
        ⟨fun a x p => smul_mul_assoc a (x : MvPolynomial (Fin 2) k) p⟩
      have : Algebra.FiniteType ↥(𝒜_1 0) (MvPolynomial (Fin 2) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜_1 0) (MvPolynomial (Fin 2) k)
      have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜_1 0)) := by
        intro z
        have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin 2) k 0 := z.2
        rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
        obtain ⟨a, ha⟩ := hz0
        exact ⟨a, Subtype.ext ha⟩
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0)))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0))) hSurj0
      dsimp [P_1, weilProjectiveSpaceOver]
      infer_instance
    have : CompactSpace ↥P_1.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace P_1.hom
    have : QuasiSeparatedSpace ↥P_1.left :=
      @AlgebraicGeometry.quasiSeparatedSpace_of_quasiSeparated _ _ P_1.hom _ _
    intro c
    have hXc : (MvPolynomial.X c : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
      MvPolynomial.isHomogeneous_X k c
    have : CompactSpace ↥(W_1 c : AlgebraicGeometry.Scheme.{u}) :=
      Homeomorph.compactSpace
        (AlgebraicGeometry.Scheme.homeoOfIso
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X c) hXc Nat.one_pos).symm)
    exact AlgebraicGeometry.quasiCompact_of_compactSpace (W_1 c).ι

  
  have hNeU : Nonempty U_k := by
    have hnot_irrel : ¬ HomogeneousIdeal.irrelevant 𝒜_amb ≤ (⊥ : HomogeneousIdeal 𝒜_amb) := by
      intro hle
      have hX0_irrel : (MvPolynomial.X (0 : Fin (m + 3)) : MvPolynomial (Fin (m + 3)) k) ∈
          (HomogeneousIdeal.irrelevant 𝒜_amb).toIdeal := by
        rw [HomogeneousIdeal.irrelevant_eq_span]
        apply Ideal.subset_span
        simp only [Set.mem_iUnion]
        exact ⟨1, Nat.one_pos, MvPolynomial.isHomogeneous_X k 0⟩
      have hX0_bot : (MvPolynomial.X (0 : Fin (m + 3)) : MvPolynomial (Fin (m + 3)) k) ∈
          (⊥ : Ideal (MvPolynomial (Fin (m + 3)) k)) := hle hX0_irrel
      exact MvPolynomial.X_ne_zero (0 : Fin (m + 3)) (Ideal.mem_bot.mp hX0_bot)
    let η₀ : X_amb :=
      { asHomogeneousIdeal := ⊥
        isPrime := Ideal.isPrime_bot
        not_irrelevant_le := hnot_irrel }
    have hη₀ : η₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X 0) := by
      change MvPolynomial.X (0 : Fin (m + 3)) ∉ (⊥ : HomogeneousIdeal 𝒜_amb)
      intro hmem
      exact MvPolynomial.X_ne_zero (0 : Fin (m + 3)) hmem
    exact ⟨⟨η₀, Set.mem_union_left _ hη₀⟩⟩

  
  let ι₂ : Fin 2 → Fin (m + 3) := Fin.cases 0 (fun _ => 1)
  let D_two : Fin 2 → X_amb.Opens := fun c =>
    AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X (ι₂ c))
  let U_amb : X_amb.Opens := D_two 0 ⊔ D_two 1
  have hU_eq : (⨆ c : Fin 2, D_two c) = U_amb := by
    ext x
    change x ∈ (⨆ c : Fin 2, D_two c) ↔ x ∈ D_two 0 ⊔ D_two 1
    rw [TopologicalSpace.Opens.mem_iSup, Fin.exists_fin_two]
    rfl
  have hCompU : CompactSpace ↥(U_k : AlgebraicGeometry.Scheme.{u}) := by
    let 𝒰 := AlgebraicGeometry.Scheme.Opens.iSupOpenCover D_two
    have : Finite 𝒰.I₀ := inferInstanceAs (Finite (Fin 2))
    have : ∀ c : 𝒰.I₀, CompactSpace ↥(𝒰.X c) := fun c =>
      Homeomorph.compactSpace
        (AlgebraicGeometry.Scheme.homeoOfIso
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X (ι₂ c))
            (MvPolynomial.isHomogeneous_X k (ι₂ c)) Nat.one_pos).symm)
    have : CompactSpace ↥((⨆ c : Fin 2, D_two c : X_amb.Opens) : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.Scheme.OpenCover.compactSpace 𝒰
    have hCompU_amb : CompactSpace ↥(U_amb : AlgebraicGeometry.Scheme.{u}) :=
      Homeomorph.compactSpace (AlgebraicGeometry.Scheme.homeoOfIso (X_amb.isoOfEq hU_eq))
    exact hCompU_amb

  
  have hGlueProj : ∀ (I : Type) (n_A n_B : ℕ),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (n_A + 1)) k
      let ℬ := MvPolynomial.homogeneousSubmodule (Fin (n_B + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra ℬ := MvPolynomial.gradedAlgebra
      let X_A := AlgebraicGeometry.Proj 𝒜
      let X_B := AlgebraicGeometry.Proj ℬ
      ∀ (θ : ℬ →+*ᵍ 𝒜)
        (_ : ∀ a : k, θ (MvPolynomial.C a) = MvPolynomial.C a)
        (f : I → MvPolynomial (Fin (n_A + 1)) k)
        (g : I → MvPolynomial (Fin (n_B + 1)) k)
        (hf : ∀ i : I, f i ∈ 𝒜 1)
        (hg : ∀ i : I, g i ∈ ℬ 1)
        (_ : ∀ i : I, θ (g i) = f i)
        (hsub : ∀ i : I, Submonoid.powers (g i) ≤ Submonoid.comap θ (Submonoid.powers (f i))),
      let D_A : I → X_A.Opens := fun i => AlgebraicGeometry.Proj.basicOpen 𝒜 (f i)
      let D_B : I → X_B.Opens := fun i => AlgebraicGeometry.Proj.basicOpen ℬ (g i)
      let φ : ∀ i : I, (D_A i : AlgebraicGeometry.Scheme.{u}) ⟶ X_B := fun i =>
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f i) (hf i) Nat.one_pos).hom ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map θ (hsub i))) ≫
            ((AlgebraicGeometry.Proj.basicOpenIsoSpec ℬ (g i) (hg i) Nat.one_pos).inv ≫ (D_B i).ι))
      ∃ (Φ : ((⨆ i : I, D_A i : X_A.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶ X_B),
        (∀ i : I, X_A.homOfLE (le_iSup D_A i) ≫ Φ = φ i) ∧
        ((⨆ i : I, D_A i).ι ≫ (weilProjectiveSpaceOver k n_A).hom =
          Φ ≫ (weilProjectiveSpaceOver k n_B).hom) ∧
        (∀ (b : MvPolynomial (Fin (n_B + 1)) k), b ∈ ℬ 1 →
          ∀ (u : ↥(⨆ i : I, D_A i)),
            Φ.base u ∈ AlgebraicGeometry.Proj.basicOpen ℬ b ↔
              u.1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (θ b)) := by
    intro I n_A n_B 𝒜 ℬ X_A X_B θ hθC f g hf hg hθg hsub D_A D_B φ
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra ℬ := MvPolynomial.gradedAlgebra
    have h_map_awayMk : ∀ {d : ℕ} {a : MvPolynomial (Fin (n_A + 1)) k}
        {b : MvPolynomial (Fin (n_B + 1)) k} (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d)
        (hθb : θ b = a) (hsub_b : Submonoid.powers b ≤ Submonoid.comap θ (Submonoid.powers a))
        (n : ℕ) (P : MvPolynomial (Fin (n_B + 1)) k) (hP : P ∈ ℬ (n • d)),
        HomogeneousLocalization.map θ hsub_b (HomogeneousLocalization.Away.mk ℬ hb n P hP) =
          HomogeneousLocalization.Away.mk 𝒜 ha n (θ P) (θ.map_mem hP) := by
      intro d a b ha hb hθb hsub_b n P hP
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      dsimp only [HomogeneousLocalization.Away.mk]
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      congr 1
      ext
      simp [map_pow, hθb]
    let 𝒰 := AlgebraicGeometry.Scheme.Opens.iSupOpenCover D_A
    have h_ov : ∀ i₁ i₂ : 𝒰.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰.f i₁) (𝒰.f i₂) ≫ φ i₁ =
          CategoryTheory.Limits.pullback.snd (𝒰.f i₁) (𝒰.f i₂) ≫ φ i₂ := by
      intro i₁ i₂
      change I at i₁ i₂
      change CategoryTheory.Limits.pullback.fst
          (X_A.homOfLE (le_iSup D_A i₁)) (X_A.homOfLE (le_iSup D_A i₂)) ≫ φ i₁ =
        CategoryTheory.Limits.pullback.snd
          (X_A.homOfLE (le_iSup D_A i₁)) (X_A.homOfLE (le_iSup D_A i₂)) ≫ φ i₂
      have sq := AlgebraicGeometry.isPullback_opens_inf_le (le_iSup D_A i₁) (le_iSup D_A i₂)
      rw [← CategoryTheory.cancel_epi sq.isoPullback.hom]
      have hfst : sq.isoPullback.hom ≫
          CategoryTheory.Limits.pullback.fst
            (X_A.homOfLE (le_iSup D_A i₁)) (X_A.homOfLE (le_iSup D_A i₂)) ≫ φ i₁ =
          X_A.homOfLE inf_le_left ≫ φ i₁ := by
        rw [← CategoryTheory.Category.assoc, sq.isoPullback_hom_fst]
      have hsnd : sq.isoPullback.hom ≫
          CategoryTheory.Limits.pullback.snd
            (X_A.homOfLE (le_iSup D_A i₁)) (X_A.homOfLE (le_iSup D_A i₂)) ≫ φ i₂ =
          X_A.homOfLE inf_le_right ≫ φ i₂ := by
        rw [← CategoryTheory.Category.assoc, sq.isoPullback_hom_snd]
      rw [hfst, hsnd]
      let x_A := f i₁ * f i₂
      let x_B := g i₁ * g i₂
      have hx_A : x_A ∈ 𝒜 (1 + 1) := SetLike.mul_mem_graded (hf i₁) (hf i₂)
      have hx_B : x_B ∈ ℬ (1 + 1) := SetLike.mul_mem_graded (hg i₁) (hg i₂)
      have hpos2 : 0 < 1 + 1 := by omega
      have hθx : θ x_B = x_A := by simp [x_A, x_B, map_mul, hθg]
      have hsub_12 : Submonoid.powers x_B ≤ Submonoid.comap θ (Submonoid.powers x_A) :=
        Submonoid.powers_le.mpr ⟨1, by simp [hθx]⟩
      have hmul_A : AlgebraicGeometry.Proj.basicOpen 𝒜 x_A = D_A i₁ ⊓ D_A i₂ :=
        AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (f i₁) (f i₂)
      let α_12 : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 x_A)) ⟶
          ((D_A i₁ ⊓ D_A i₂ : X_A.Opens) : AlgebraicGeometry.Scheme.{u}) :=
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 x_A hx_A hpos2).inv ≫
          (X_A.isoOfEq hmul_A).hom
      rw [← CategoryTheory.cancel_epi α_12]
      have hBranch : ∀ (j₁ j₂ : I) (hle : D_A i₁ ⊓ D_A i₂ ≤ D_A j₁)
          (hxA_eq : x_A = f j₁ * f j₂) (hxB_eq : x_B = g j₁ * g j₂),
          α_12 ≫ X_A.homOfLE hle ≫ φ j₁ =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.map θ hsub_12)) ≫
            AlgebraicGeometry.Proj.awayι ℬ x_B hx_B hpos2 := by
        intro j₁ j₂ hle hxA_eq hxB_eq
        have h_step1 : α_12 ≫ X_A.homOfLE hle ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f j₁) (hf j₁) Nat.one_pos).hom =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hf j₂) hxA_eq)) := by
          rw [← CategoryTheory.cancel_mono
            ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f j₁) (hf j₁) Nat.one_pos).inv ≫
              (D_A j₁).ι)]
          calc (α_12 ≫ X_A.homOfLE hle ≫
                (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f j₁) (hf j₁) Nat.one_pos).hom) ≫
                ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (f j₁) (hf j₁) Nat.one_pos).inv ≫
                  (D_A j₁).ι)
              = α_12 ≫ X_A.homOfLE hle ≫ (D_A j₁).ι := by
