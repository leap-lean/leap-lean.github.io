          AlgebraicGeometry.Scheme.homOfLE_ι]
      calc (D_sub r).ι ≫ f_sub
          = ((D_sub r).ι ≫ iso_top_sub.hom) ≫ Φ_sub :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = X_sub.homOfLE (le_iSup D_sub r) ≫ Φ_sub := by rw [h_in]
        _ = _ := hΦ_sub_ι r
    have hf_sub_pre : ∀ (b : MvPolynomial (Fin (m + 3)) k), b ∈ 𝒜_amb 1 →
        f_sub ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜_amb b =
          AlgebraicGeometry.Proj.basicOpen 𝒜_sub (ψ_hom b) := by
      intro b hb
      ext x
      let u : ↥(⨆ r : Fin (m + 1), D_sub r) := iso_top_sub.hom.base x
      have hu1 : u.1 = x := by
        change ((iso_top_sub.hom ≫ (⨆ r : Fin (m + 1), D_sub r).ι).base) x = x
        rw [hiso_top_ι]
        rfl
      change Φ_sub.base u ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_amb b ↔
        x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_sub (ψ_hom b)
      rw [hΦ_sub_pre b hb u, hu1]

    
    have hf_cl : AlgebraicGeometry.IsClosedImmersion f_sub := by
      apply AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top D_amb hCov_amb
      intro a
      refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun r => ?_) j) a
      · 
        have hbot : f_sub ⁻¹ᵁ D_amb 0 = ⊥ := by
          rw [hf_sub_pre (MvPolynomial.X 0) (hXa_amb 0), hψ0,
            AlgebraicGeometry.Proj.basicOpen_zero]
        have : IsEmpty ↥((f_sub ⁻¹ᵁ D_amb 0 : X_sub.Opens) : AlgebraicGeometry.Scheme.{u}) :=
          ⟨fun x => by
            have hx : x.1 ∈ (⊥ : X_sub.Opens) := hbot ▸ x.2
            exact hx⟩
        infer_instance
      · 
        have hbot : f_sub ⁻¹ᵁ D_amb (Fin.succ 0) = ⊥ := by
          rw [hf_sub_pre (MvPolynomial.X (Fin.succ 0)) (hXa_amb (Fin.succ 0)), hψ_succ0,
            AlgebraicGeometry.Proj.basicOpen_zero]
        have : IsEmpty ↥((f_sub ⁻¹ᵁ D_amb (Fin.succ 0) : X_sub.Opens) : AlgebraicGeometry.Scheme.{u}) :=
          ⟨fun x => by
            have hx : x.1 ∈ (⊥ : X_sub.Opens) := hbot ▸ x.2
            exact hx⟩
        infer_instance
      · 
        have hVr : f_sub ⁻¹ᵁ D_amb r.succ.succ = D_sub r := by
          rw [hf_sub_pre (MvPolynomial.X r.succ.succ) (hXr2 r), hψ_Zr r]
        have h_restr_eq : (f_sub ∣_ D_amb r.succ.succ) =
            (X_sub.isoOfEq hVr).hom ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_sub (MvPolynomial.X r) (hZr r) Nat.one_pos).hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map ψ_hom (hsub_ψ r))) ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X r.succ.succ) (hXr2 r) Nat.one_pos).inv := by
          rw [← CategoryTheory.cancel_mono (D_amb r.succ.succ).ι]
          rw [AlgebraicGeometry.morphismRestrict_ι]
          calc (f_sub ⁻¹ᵁ D_amb r.succ.succ).ι ≫ f_sub
              = ((X_sub.isoOfEq hVr).hom ≫ (D_sub r).ι) ≫ f_sub := by
                  rw [AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
            _ = (X_sub.isoOfEq hVr).hom ≫ ((D_sub r).ι ≫ f_sub) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = ((X_sub.isoOfEq hVr).hom ≫
                  (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_sub (MvPolynomial.X r) (hZr r) Nat.one_pos).hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map ψ_hom (hsub_ψ r))) ≫
                  (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X r.succ.succ) (hXr2 r) Nat.one_pos).inv) ≫
                  (D_amb r.succ.succ).ι := by
                  rw [hf_sub_chart r]
                  simp only [CategoryTheory.Category.assoc]
        rw [h_restr_eq]
        have : AlgebraicGeometry.IsClosedImmersion
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.map ψ_hom (hsub_ψ r)))) :=
          AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ (hSurj_ψ r)
        infer_instance

    
    have hf_range : Set.range f_sub.base = (U_amb : Set X_amb)ᶜ := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩ hyU
        rcases hyU with hy0 | hy1
        · have hx0 : x ∈ f_sub ⁻¹ᵁ D_amb 0 := hy0
          rw [hf_sub_pre (MvPolynomial.X 0) (hXa_amb 0), hψ0,
            AlgebraicGeometry.Proj.basicOpen_zero] at hx0
          exact hx0
        · have hx1 : x ∈ f_sub ⁻¹ᵁ D_amb 1 := hy1
          rw [hf_sub_pre (MvPolynomial.X 1) (hXa_amb 1), hψ1,
            AlgebraicGeometry.Proj.basicOpen_zero] at hx1
          exact hx1
      · intro hy_notU
        have hy_not0 : y ∉ D_amb 0 := fun h => hy_notU (Or.inl h)
        have hy_not1 : y ∉ D_amb 1 := fun h => hy_notU (Or.inr h)
        have hy_top : y ∈ (⊤ : X_amb.Opens) := trivial
        rw [← hCov_amb, TopologicalSpace.Opens.mem_iSup] at hy_top
        obtain ⟨a, hya⟩ := hy_top
        have hex_r : ∃ r : Fin (m + 1), y ∈ D_amb r.succ.succ := by
          refine Fin.cases (fun h0 => (hy_not0 h0).elim)
            (fun j => Fin.cases (fun h1 => (hy_not1 h1).elim) (fun r hr => ⟨r, hr⟩) j) a hya
        obtain ⟨r, hyr⟩ := hex_r
        let q := (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X r.succ.succ)
          (hXr2 r) Nat.one_pos).hom.base ⟨y, hyr⟩
        have hq_inv : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X r.succ.succ)
            (hXr2 r) Nat.one_pos).inv.base q = ⟨y, hyr⟩ := by
          change ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X r.succ.succ)
            (hXr2 r) Nat.one_pos).hom ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X r.succ.succ)
              (hXr2 r) Nat.one_pos).inv).base ⟨y, hyr⟩ = ⟨y, hyr⟩
          rw [CategoryTheory.Iso.hom_inv_id]
          rfl
        have hq_y : (AlgebraicGeometry.Proj.awayι 𝒜_amb (MvPolynomial.X r.succ.succ)
            (hXr2 r) Nat.one_pos).base q = y := by
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          change (D_amb r.succ.succ).ι.base
            ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X r.succ.succ)
              (hXr2 r) Nat.one_pos).inv.base q) = y
          rw [hq_inv]
          rfl
        have hξ_mem : ∀ (i₀ : Fin (m + 3)), y ∉ D_amb i₀ →
            HomogeneousLocalization.Away.isLocalizationElem (hXr2 r) (hXa_amb i₀) ∈ q.asIdeal := by
          intro i₀ hy_not
          have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_amb (hXr2 r) Nat.one_pos
            (hXa_amb i₀) Nat.one_pos
          have hq_not_bo : q ∉ PrimeSpectrum.basicOpen
              (HomogeneousLocalization.Away.isLocalizationElem (hXr2 r) (hXa_amb i₀)) := by
            rw [← hpre]
            intro hmem
            change (AlgebraicGeometry.Proj.awayι 𝒜_amb (MvPolynomial.X r.succ.succ)
              (hXr2 r) Nat.one_pos).base q ∈ D_amb i₀ at hmem
            rw [hq_y] at hmem
            exact hy_not hmem
          by_contra h_not
          exact hq_not_bo h_not
        have hξ0 : HomogeneousLocalization.Away.isLocalizationElem (hXr2 r) (hXa_amb 0) ∈
            q.asIdeal := hξ_mem 0 hy_not0
        have hξ1 : HomogeneousLocalization.Away.isLocalizationElem (hXr2 r) (hXa_amb 1) ∈
            q.asIdeal := hξ_mem 1 hy_not1

        
        let Φ_r := HomogeneousLocalization.map ψ_hom (hsub_ψ r)
        let sec_r := HomogeneousLocalization.map σ_hom (hsub_σ r)
        let ρ : MvPolynomial (Fin (m + 3)) k →+* MvPolynomial (Fin (m + 3)) k :=
          σ_ring.comp ψ_ring
        have hρ_hom : ∀ (n : ℕ) (G : MvPolynomial (Fin (m + 3)) k),
            G ∈ 𝒜_amb n → ρ G ∈ 𝒜_amb n :=
          fun n G hG => σ_hom.map_mem (ψ_hom.map_mem hG)
        let mkHom : ∀ (n : ℕ), ↥(𝒜_amb (n • 1)) →+
            HomogeneousLocalization.Away 𝒜_amb (MvPolynomial.X r.succ.succ) := fun n =>
          { toFun := fun x => HomogeneousLocalization.Away.mk 𝒜_amb (hXr2 r) n x.1 x.2
            map_zero' := by
              apply HomogeneousLocalization.val_injective
              rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
                Submodule.coe_zero, Localization.mk_zero]
            map_add' := fun x₁ x₂ => by
              apply HomogeneousLocalization.val_injective
              rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_add,
                HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
                Localization.add_mk_self, Submodule.coe_add] }
        have h_ker_le : RingHom.ker Φ_r ≤ q.asIdeal := by
          intro z hz
          rw [RingHom.mem_ker] at hz
          obtain ⟨d, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_amb (hXr2 r) z
          have hSecΦ : sec_r (Φ_r (HomogeneousLocalization.Away.mk 𝒜_amb (hXr2 r) d F hF)) =
              HomogeneousLocalization.Away.mk 𝒜_amb (hXr2 r) d (ρ F) (hρ_hom (d • 1) F hF) := by
            apply HomogeneousLocalization.val_injective
            rw [HomogeneousLocalization.Away.val_mk]
            dsimp only [Φ_r, sec_r, HomogeneousLocalization.Away.mk]
            rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.map_mk,
              HomogeneousLocalization.val_mk]
            have hden_eq : σ_ring (ψ_ring (MvPolynomial.X r.succ.succ ^ d)) =
                MvPolynomial.X r.succ.succ ^ d := by
              rw [map_pow, map_pow]
              change (σ_hom (ψ_hom (MvPolynomial.X r.succ.succ))) ^ d = _
              rw [hψ_Zr r, hσ_Zr r]
            exact congrArg₂ Localization.mk rfl (Subtype.ext hden_eq)
          have hρF_zero : mkHom d ⟨ρ F, hρ_hom (d • 1) F hF⟩ = 0 := by
            change HomogeneousLocalization.Away.mk 𝒜_amb (hXr2 r) d (ρ F) _ = 0
            rw [← hSecΦ, hz, map_zero]
          have hz_sub : HomogeneousLocalization.Away.mk 𝒜_amb (hXr2 r) d F hF =
              mkHom d ⟨F - ρ F, Submodule.sub_mem _ hF (hρ_hom (d • 1) F hF)⟩ := by
            change mkHom d ⟨F, hF⟩ = _
            have hsub_eq : (⟨F - ρ F, Submodule.sub_mem _ hF (hρ_hom (d • 1) F hF)⟩ : ↥(𝒜_amb (d • 1))) =
                ⟨F, hF⟩ - ⟨ρ F, hρ_hom (d • 1) F hF⟩ := rfl
            rw [hsub_eq, map_sub, hρF_zero, sub_zero]
          rw [hz_sub]
          have h_mon_hom : ∀ (ν : Fin (m + 3) →₀ ℕ) (c_val : k) (n : ℕ),
              (Finsupp.weight 1) ν = n → (MvPolynomial.monomial ν c_val).IsHomogeneous n := by
            intro ν c_val n hν ν' hν'
            have heq : ν = ν' := by
              by_contra hne
              simp [MvPolynomial.coeff_monomial, hne] at hν'
            rw [← heq]
            exact hν
          have hF_hom : F.IsHomogeneous (d • 1) :=
            (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
          have hM_mem : ∀ u : F.support,
              MvPolynomial.monomial u.1 (F.coeff u.1) ∈ 𝒜_amb (d • 1) := by
            intro u
            rw [MvPolynomial.mem_homogeneousSubmodule]
            exact h_mon_hom u.1 (F.coeff u.1) (d • 1)
              (hF_hom (MvPolynomial.mem_support_iff.mp u.2))
          let term : F.support → ↥(𝒜_amb (d • 1)) := fun u =>
            ⟨MvPolynomial.monomial u.1 (F.coeff u.1) -
              ρ (MvPolynomial.monomial u.1 (F.coeff u.1)),
              Submodule.sub_mem _ (hM_mem u) (hρ_hom (d • 1) _ (hM_mem u))⟩
          have hsum_eq : (⟨F - ρ F, Submodule.sub_mem _ hF (hρ_hom (d • 1) F hF)⟩ : ↥(𝒜_amb (d • 1))) =
              ∑ u ∈ F.support.attach, term u := by
            apply Subtype.ext
            rw [AddSubmonoidClass.coe_finsetSum]
            dsimp only [term]
            rw [Finset.sum_sub_distrib, Finset.sum_attach F.support (fun μ => MvPolynomial.monomial μ (F.coeff μ)),
              Finset.sum_attach F.support (fun μ => ρ (MvPolynomial.monomial μ (F.coeff μ))),
              ← map_sum ρ, ← MvPolynomial.as_sum F]
          rw [hsum_eq, map_sum]
          apply Ideal.sum_mem q.asIdeal
          intro u _
          let μ := u.1
          have hμ : μ ∈ F.support := u.2
          have h_mon_div : ∀ (i₀ : Fin (m + 3)),
              ρ (MvPolynomial.X i₀) = 0 →
              HomogeneousLocalization.Away.isLocalizationElem (hXr2 r) (hXa_amb i₀) ∈ q.asIdeal →
              μ i₀ ≠ 0 →
              mkHom d (term u) ∈ q.asIdeal := by
            intro i₀ hρ_i hξ_i hμ_i
            have hρM : ρ (MvPolynomial.monomial μ (F.coeff μ)) = 0 := by
              rw [MvPolynomial.monomial_eq, map_mul]
              change ρ (MvPolynomial.C (F.coeff μ)) *
                ρ (∏ a ∈ μ.support, MvPolynomial.X a ^ μ a) = 0
              rw [map_prod]
              have hprod0 : (∏ a ∈ μ.support, ρ (MvPolynomial.X a ^ μ a)) = 0 := by
                apply Finset.prod_eq_zero (Finsupp.mem_support_iff.mpr hμ_i)
                rw [map_pow, hρ_i, zero_pow hμ_i]
              rw [hprod0, mul_zero]
            let μ' : Fin (m + 3) →₀ ℕ := μ - Finsupp.single i₀ 1
            have h_add_μ : Finsupp.single i₀ 1 + μ' = μ := by
              ext a
              simp only [Finsupp.add_apply, μ', Finsupp.tsub_apply, Finsupp.single_apply]
              by_cases ha : i₀ = a
              · subst ha; simp only [ite_true]; omega
              · simp [ha]
            set w' : ℕ := (Finsupp.weight (1 : Fin (m + 3) → ℕ)) μ'
            have hw_single : (Finsupp.weight (1 : Fin (m + 3) → ℕ)) (Finsupp.single i₀ 1) = 1 := by
              simp [Finsupp.weight_apply]
            have hw_eq : 1 + w' = d := by
              have hw_μ : (Finsupp.weight (1 : Fin (m + 3) → ℕ)) μ = d • 1 :=
                hF_hom (MvPolynomial.mem_support_iff.mp hμ)
              rw [nsmul_one] at hw_μ
              have hw_add := congrArg (Finsupp.weight (1 : Fin (m + 3) → ℕ)) h_add_μ
              rw [map_add, hw_single, hw_μ] at hw_add
              exact hw_add
            have hd_pos : 1 ≤ d := by omega
            have hdeg_μ' : (Finsupp.weight 1) μ' = (d - 1) • 1 := by
              change w' = (d - 1) • (1 : ℕ)
              rw [nsmul_one, ← hw_eq, Nat.add_sub_cancel_left]
              rfl
            have hM'_mem : MvPolynomial.monomial μ' (F.coeff μ) ∈ 𝒜_amb ((d - 1) • 1) := by
              rw [MvPolynomial.mem_homogeneousSubmodule]
              exact h_mon_hom μ' (F.coeff μ) ((d - 1) • 1) hdeg_μ'
            have hmul_M : MvPolynomial.X i₀ * MvPolynomial.monomial μ' (F.coeff μ) =
                MvPolynomial.monomial μ (F.coeff μ) := by
              change MvPolynomial.monomial (Finsupp.single i₀ 1) (1 : k) *
                MvPolynomial.monomial μ' (F.coeff μ) = _
              rw [MvPolynomial.monomial_mul_monomial, h_add_μ, one_mul]
            have h_fac : mkHom d (term u) =
                HomogeneousLocalization.Away.isLocalizationElem (hXr2 r) (hXa_amb i₀) *
                HomogeneousLocalization.Away.mk 𝒜_amb (hXr2 r) (d - 1)
                  (MvPolynomial.monomial μ' (F.coeff μ)) hM'_mem := by
              apply HomogeneousLocalization.val_injective
              change (HomogeneousLocalization.Away.mk 𝒜_amb (hXr2 r) d
                (MvPolynomial.monomial μ (F.coeff μ) - ρ (MvPolynomial.monomial μ (F.coeff μ))) _).val = _
              rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mul]
              dsimp only [HomogeneousLocalization.Away.isLocalizationElem]
              rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
                Localization.mk_mul]
              have hnum_eq : MvPolynomial.monomial μ (F.coeff μ) -
                  ρ (MvPolynomial.monomial μ (F.coeff μ)) =
                  MvPolynomial.X i₀ ^ 1 * MvPolynomial.monomial μ' (F.coeff μ) := by
                rw [hρM, sub_zero, pow_one, hmul_M]
              have hden_eq : (MvPolynomial.X r.succ.succ : MvPolynomial (Fin (m + 3)) k) ^ d =
                  (MvPolynomial.X r.succ.succ : MvPolynomial (Fin (m + 3)) k) ^ 1 *
                    (MvPolynomial.X r.succ.succ : MvPolynomial (Fin (m + 3)) k) ^ (d - 1) := by
                rw [← pow_add, Nat.add_sub_of_le hd_pos]
              exact congrArg₂ Localization.mk hnum_eq (Subtype.ext hden_eq)
            rw [h_fac]
            exact Ideal.mul_mem_right _ q.asIdeal hξ_i

          by_cases hμ0 : μ 0 = 0
          · by_cases hμ1 : μ 1 = 0
            · 
              have hρM_eq : ρ (MvPolynomial.monomial μ (F.coeff μ)) =
                  MvPolynomial.monomial μ (F.coeff μ) := by
                rw [MvPolynomial.monomial_eq, map_mul]
                have hC : ρ (MvPolynomial.C (F.coeff μ)) = MvPolynomial.C (F.coeff μ) := by
                  simp [ρ, σ_ring, ψ_ring]
                rw [hC]
                congr 1
                change ρ (∏ a ∈ μ.support, MvPolynomial.X a ^ μ a) =
                  ∏ a ∈ μ.support, MvPolynomial.X a ^ μ a
                rw [map_prod]
                apply Finset.prod_congr rfl
                intro a ha
                have ha_ne : μ a ≠ 0 := Finsupp.mem_support_iff.mp ha
                have hρXa : ρ (MvPolynomial.X a) = MvPolynomial.X a := by
                  refine Fin.cases (fun h0 => (h0 hμ0).elim)
                    (fun j => Fin.cases (fun h1 => (h1 (Fin.succ_zero_eq_one.symm ▸ hμ1)).elim)
                      (fun q_idx _ => by simp [ρ, σ_ring, ψ_ring, ψ_vars]) j) a ha_ne
                rw [map_pow, hρXa]
              have hterm0 : term u = 0 := by
                apply Subtype.ext
                dsimp only [term, μ]
                rw [hρM_eq, sub_self, Submodule.coe_zero]
              rw [hterm0, map_zero]
              exact q.asIdeal.zero_mem
            · 
              have hρ1 : ρ (MvPolynomial.X 1) = 0 := by
                change σ_ring (ψ_hom (MvPolynomial.X 1)) = 0
                rw [hψ1, map_zero]
              exact h_mon_div 1 hρ1 hξ1 hμ1
          · 
            have hρ0 : ρ (MvPolynomial.X 0) = 0 := by
              change σ_ring (ψ_hom (MvPolynomial.X 0)) = 0
              rw [hψ0, map_zero]
            exact h_mon_div 0 hρ0 hξ0 hμ0

        have hq_zl : q ∈ PrimeSpectrum.zeroLocus (RingHom.ker Φ_r : Set _) := h_ker_le
        rw [← range_comap_of_surjective _ Φ_r (hSurj_ψ r)] at hq_zl
        obtain ⟨p_spec, hp_eq⟩ := hq_zl
        let x_sub : X_sub := (AlgebraicGeometry.Proj.awayι 𝒜_sub (MvPolynomial.X r)
          (hZr r) Nat.one_pos).base p_spec
        refine ⟨x_sub, ?_⟩
        have hx_eq : x_sub = (D_sub r).ι.base
            ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_sub (MvPolynomial.X r)
              (hZr r) Nat.one_pos).inv.base p_spec) := by
          dsimp [x_sub]
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          rfl
        rw [hx_eq]
        change ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_sub (MvPolynomial.X r)
            (hZr r) Nat.one_pos).inv ≫ ((D_sub r).ι ≫ f_sub)).base p_spec = y
        rw [hf_sub_chart r, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
          CategoryTheory.Iso.inv_hom_id_assoc]
        change (AlgebraicGeometry.Proj.awayι 𝒜_amb (MvPolynomial.X r.succ.succ)
            (hXr2 r) Nat.one_pos).base (PrimeSpectrum.comap Φ_r p_spec) = y
        rw [hp_eq, hq_y]

    exact ⟨CategoryTheory.Over.homMk f_sub hf_sub_hom, hf_cl, hf_range⟩

  
  have hLineProj : ∃ (pr_k : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ P_1.left),
      WeilIsCodimTwoLineProjection k m pr_k := by
    let g_hom : 𝒜_1 →+*ᵍ 𝒜_amb :=
      { toRingHom := (MvPolynomial.rename ι₂).toRingHom
        map_mem := fun {i p} hp => MvPolynomial.IsHomogeneous.rename_isHomogeneous hp }
    have hgC : ∀ a : k, g_hom (MvPolynomial.C a) = MvPolynomial.C a := fun a => by
      change MvPolynomial.rename ι₂ (MvPolynomial.C a) = MvPolynomial.C a
      exact MvPolynomial.rename_C ι₂ a
    have hgX : ∀ c : Fin 2, g_hom (MvPolynomial.X c) = MvPolynomial.X (ι₂ c) := fun c => by
      change MvPolynomial.rename ι₂ (MvPolynomial.X c) = MvPolynomial.X (ι₂ c)
      exact MvPolynomial.rename_X ι₂ c
    have hX_amb : ∀ c : Fin 2, MvPolynomial.X (ι₂ c) ∈ 𝒜_amb 1 :=
      fun c => MvPolynomial.isHomogeneous_X k (ι₂ c)
    have hX_1 : ∀ c : Fin 2, MvPolynomial.X c ∈ 𝒜_1 1 :=
      fun c => MvPolynomial.isHomogeneous_X k c
    have hsub_g : ∀ c : Fin 2,
        Submonoid.powers (MvPolynomial.X c) ≤
          Submonoid.comap g_hom (Submonoid.powers (MvPolynomial.X (ι₂ c))) :=
      fun c => Submonoid.powers_le.mpr ⟨1, by simp [hgX c]⟩
    obtain ⟨Φ_pr, hΦ_pr_ι, hΦ_pr_hom, hΦ_pr_pre⟩ :=
      hGlueProj (Fin 2) (m + 2) 1 g_hom hgC
        (fun c => MvPolynomial.X (ι₂ c)) MvPolynomial.X hX_amb hX_1 hgX hsub_g
    let pr_amb : (U_amb : AlgebraicGeometry.Scheme.{u}) ⟶ X_1 :=
      (X_amb.isoOfEq hU_eq.symm).hom ≫ Φ_pr
    let g_amb_hom : X_amb ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := P_amb.hom
    let g_1_hom : X_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := P_1.hom
    have hpr_hom : U_amb.ι ≫ g_amb_hom = pr_amb ≫ g_1_hom := by
      have hΦ_hom' : (⨆ c : Fin 2, D_two c).ι ≫ g_amb_hom = Φ_pr ≫ g_1_hom := hΦ_pr_hom
      calc U_amb.ι ≫ g_amb_hom
          = ((X_amb.isoOfEq hU_eq.symm).hom ≫ (⨆ c : Fin 2, D_two c).ι) ≫ g_amb_hom := by
              rw [AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
        _ = (X_amb.isoOfEq hU_eq.symm).hom ≫ ((⨆ c : Fin 2, D_two c).ι ≫ g_amb_hom) :=
              CategoryTheory.Category.assoc _ _ _
        _ = (X_amb.isoOfEq hU_eq.symm).hom ≫ (Φ_pr ≫ g_1_hom) := by
              rw [hΦ_hom']
        _ = pr_amb ≫ g_1_hom := (CategoryTheory.Category.assoc _ _ _).symm
    let pr_k : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ P_1.left := pr_amb
    refine ⟨pr_k, hpr_hom, ?_⟩
    intro c
    refine ⟨?_, ?_⟩
    · ext u
      let u' : ↥(⨆ c' : Fin 2, D_two c') := (X_amb.isoOfEq hU_eq.symm).hom.base u
      have hu'1 : u'.1 = u.1 := by
        change (((X_amb.isoOfEq hU_eq.symm).hom ≫ (⨆ c' : Fin 2, D_two c').ι).base u) = u.1
        rw [AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
        rfl
      change Φ_pr.base u' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X c) ↔
        u.1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_amb (MvPolynomial.X (ι₂ c))
      have hpre_c : Φ_pr.base u' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X c) ↔
          u'.1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_amb (g_hom (MvPolynomial.X c)) :=
        hΦ_pr_pre (MvPolynomial.X c) (hX_1 c) u'
      rw [hpre_c, hgX c, hu'1]
      exact Iff.rfl
    · have h_le_amb : D_two c ≤ U_amb := hU_eq ▸ le_iSup D_two c
      have h_le : (D_two c : P_amb.left.Opens) ≤ U_k := h_le_amb
      refine ⟨h_le, g_hom, hsub_g c, hX_amb c, hX_1 c, rfl, ?_⟩
      have h_hom_eq : X_amb.homOfLE h_le_amb ≫ (X_amb.isoOfEq hU_eq.symm).hom =
          X_amb.homOfLE (le_iSup D_two c) := by
        rw [← CategoryTheory.cancel_mono (⨆ c' : Fin 2, D_two c').ι]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι,
          AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι]
      have h_chart : X_amb.homOfLE h_le_amb ≫ pr_amb =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_amb (MvPolynomial.X (ι₂ c)) (hX_amb c) Nat.one_pos).hom ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map g_hom (hsub_g c))) ≫
              ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_1 (MvPolynomial.X c) (hX_1 c) Nat.one_pos).inv ≫
                (W_1 c).ι)) := by
        calc X_amb.homOfLE h_le_amb ≫ pr_amb
            = (X_amb.homOfLE h_le_amb ≫ (X_amb.isoOfEq hU_eq.symm).hom) ≫ Φ_pr :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = X_amb.homOfLE (le_iSup D_two c) ≫ Φ_pr := by rw [h_hom_eq]
          _ = _ := hΦ_pr_ι c
      exact h_chart

  exact ⟨hCov_1, hQcW, hNeU, hCompU, hSubImm, hLineProj⟩

theorem weil_codimTwo_blowup_chart_trivialization (k : Type u) [Field k] (m : ℕ)
    (pr_k : ((weilCodimTwoComplOpen k m :
      (weilProjectiveSpaceOver k (m + 2)).left.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
      (weilProjectiveSpaceOver k 1).left)
    (hPr : WeilIsCodimTwoLineProjection k m pr_k)
    (hg : (weilCodimTwoComplOpen k m).ι ≫ (weilProjectiveSpaceOver k (m + 2)).hom =
      pr_k ≫ (weilProjectiveSpaceOver k 1).hom)
    (c : Fin 2) :
    let P_amb := weilProjectiveSpaceOver k (m + 2)
    let P_1 := weilProjectiveSpaceOver k 1
    let P_fib := weilProjectiveSpaceOver k (m + 1)
    let U_k := weilCodimTwoComplOpen k m
    let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    letI : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
    let W_c : P_1.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X c)
    let Q_k := CategoryTheory.Limits.pullback P_amb.hom P_1.hom
    let γ_k : (U_k : AlgebraicGeometry.Scheme.{u}) ⟶ Q_k :=
      CategoryTheory.Limits.pullback.lift U_k.ι pr_k hg
    let Q_c : Q_k.Opens := (CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ⁻¹ᵁ W_c
    let E_c := CategoryTheory.Limits.pullback (W_c.ι ≫ P_1.hom) P_fib.hom
    ∃ (Φ_c : E_c ⟶ (Q_c : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.IsClosedImmersion Φ_c ∧
      (Φ_c ≫ ((CategoryTheory.Limits.pullback.snd P_amb.hom P_1.hom) ∣_ W_c) =
        CategoryTheory.Limits.pullback.fst (W_c.ι ≫ P_1.hom) P_fib.hom) ∧
      (AlgebraicGeometry.Scheme.Hom.ker (γ_k ∣_ Q_c) = AlgebraicGeometry.Scheme.Hom.ker Φ_c) :=
by
  intro P_amb P_1 P_fib U_k 𝒜_1 W_c Q_k γ_k Q_c E_c
  let _ : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
  
  have hAwayLift : ∀ {R S : Type u} [CommRing R] [CommRing S] (x : R) (g : R →+* S)
      (hu : IsUnit (g x)),
      ∃ L : Localization.Away x →+* S,
        (∀ r : R, L (algebraMap R (Localization.Away x) r) = g r) ∧
        L (IsLocalization.Away.invSelf (S := Localization.Away x) x) = ↑(hu.unit⁻¹) := by
    intro R S _ _ x g hu
    let _ : Algebra R S := g.toAlgebra
    have hu' : IsUnit (algebraMap R S x) := hu
    let L : Localization.Away x →+* S := IsLocalization.Away.lift x (g := g) hu'
    have hL_alg : ∀ r : R, L (algebraMap R (Localization.Away x) r) = g r := fun r =>
      IsLocalization.Away.lift_eq (x := x) (g := g) hu' r
    have hL_inv : L (IsLocalization.Away.invSelf (S := Localization.Away x) x) = ↑(hu.unit⁻¹) := by
      apply hu.mul_right_inj.mp
      calc g x * L (IsLocalization.Away.invSelf (S := Localization.Away x) x)
          = L (algebraMap R (Localization.Away x) x *
              IsLocalization.Away.invSelf (S := Localization.Away x) x) := by
            rw [map_mul, hL_alg]
        _ = L 1 := by rw [IsLocalization.Away.mul_invSelf]
        _ = 1 := map_one L
        _ = g x * ↑(hu.unit⁻¹) := (IsUnit.mul_val_inv hu).symm
    exact ⟨L, hL_alg, hL_inv⟩

  
  have hLocMk : ∀ {R : Type u} [CommRing R] (f x : R) (n : ℕ)
      (hs : f ^ n ∈ Submonoid.powers f),
      (Localization.mk x ⟨f ^ n, hs⟩ : Localization.Away f) =
        algebraMap R (Localization.Away f) x *
          (IsLocalization.Away.invSelf (S := Localization.Away f) f) ^ n := by
    intro R _ f x n hs
    rw [Localization.mk_eq_mk']
    have hspec := IsLocalization.mk'_spec' (Localization.Away f) x ⟨f ^ n, hs⟩
    have hmul : algebraMap R (Localization.Away f) (f ^ n) *
        (IsLocalization.Away.invSelf (S := Localization.Away f) f) ^ n = 1 := by
      rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
    calc IsLocalization.mk' (Localization.Away f) x ⟨f ^ n, hs⟩
        = IsLocalization.mk' (Localization.Away f) x ⟨f ^ n, hs⟩ *
            (algebraMap R (Localization.Away f) (f ^ n) *
              (IsLocalization.Away.invSelf (S := Localization.Away f) f) ^ n) := by
          rw [hmul, mul_one]
      _ = (algebraMap R (Localization.Away f) (f ^ n) *
            IsLocalization.mk' (Localization.Away f) x ⟨f ^ n, hs⟩) *
            (IsLocalization.Away.invSelf (S := Localization.Away f) f) ^ n := by
          ring
      _ = algebraMap R (Localization.Away f) x *
            (IsLocalization.Away.invSelf (S := Localization.Away f) f) ^ n := by
          rw [hspec]

  
  have hFromZeroVal : ∀ (N : ℕ)
      (s : Submonoid (MvPolynomial (Fin (N + 1)) k)) (x : k),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (HomogeneousLocalization.fromZeroRingHom 𝒜 s (algebraMap k ↥(𝒜 0) x)).val =
        algebraMap (MvPolynomial (Fin (N + 1)) k) (Localization s) (MvPolynomial.C x) := by
    intro N s x
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    change (HomogeneousLocalization.mk _).val = _
    rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk']
    exact IsLocalization.mk'_one (M := s) (Localization s) (MvPolynomial.C x)

  
  have hSpecNotMem : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
      (p : AlgebraicGeometry.Spec (CommRingCat.of S)) (r : R),
      (r ∉ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base p).asIdeal) ↔
        (φ r ∉ p.asIdeal) :=
    fun _ _ _ => Iff.rfl

  have hSpecBasicOpen : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
      (p : AlgebraicGeometry.Spec (CommRingCat.of S)) (r : R),
      (p ∈ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ
        PrimeSpectrum.basicOpen r) ↔ (φ r ∉ p.asIdeal) :=
    fun _ _ _ => Iff.rfl

  
  have hProjCov : ∀ (N : ℕ),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
        MvPolynomial.gradedAlgebra
      (⨆ a : Fin (N + 1),
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X a) :
          (weilProjectiveSpaceOver k N).left.Opens)) = ⊤ := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X
    rw [HomogeneousIdeal.irrelevant_eq_span, Ideal.span_le]
    rintro F hF_mem
    simp only [Set.mem_iUnion, SetLike.mem_coe] at hF_mem
    obtain ⟨i, hi_pos, hF_hom0⟩ := hF_mem
    have hF_hom : MvPolynomial.IsHomogeneous F i :=
      (MvPolynomial.mem_homogeneousSubmodule i F).mp hF_hom0
    rw [SetLike.mem_coe, F.as_sum]
    apply Ideal.sum_mem
    intro e he
    have he_deg := hF_hom (MvPolynomial.mem_support_iff.mp he)
    have he_ne : e ≠ 0 := by
      rintro rfl
      simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at he_deg
      omega
    obtain ⟨a, ha⟩ : ∃ a : Fin (N + 1), e a ≠ 0 := by
      by_contra hall
      apply he_ne
      ext b
      by_contra hb
      exact hall ⟨b, hb⟩
    let e' : Fin (N + 1) →₀ ℕ := e - Finsupp.single a 1
    have h_add : Finsupp.single a 1 + e' = e := by
      ext b
      simp only [e', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
        Finsupp.single_apply]
      split_ifs with hba
      · subst hba; omega
      · omega
    have h_mon : MvPolynomial.monomial e (F.coeff e) =
        MvPolynomial.X a * MvPolynomial.monomial e' (F.coeff e) := by
      rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, h_add]
    rw [h_mon]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨a, rfl⟩)

  
  have hProjChart : ∀ (N : ℕ) (a : Fin (N + 1)),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let hx_a : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X a)).mpr
          (MvPolynomial.isHomogeneous_X k a)
      let P_a := MvPolynomial {b : Fin (N + 1) // b ≠ a} k
      ∃ (e_ring : P_a ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))
        (isoProj :
          ((AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) :
            (weilProjectiveSpaceOver k N).left.Opens) : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of P_a)),
        (∀ x : k, e_ring (MvPolynomial.C x) =
          HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X a))
            (algebraMap k ↥(𝒜 0) x)) ∧
        (∀ b : {b : Fin (N + 1) // b ≠ a}, e_ring (MvPolynomial.X b) =
          HomogeneousLocalization.Away.isLocalizationElem hx_a
            ((MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X b.1)).mpr
              (MvPolynomial.isHomogeneous_X k b.1))) ∧
        (isoProj.hom =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) hx_a zero_lt_one).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.toRingHom)) ∧
        (isoProj.inv =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.symm.toRingHom) ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) hx_a zero_lt_one).inv) ∧
        ((AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) :
            (weilProjectiveSpaceOver k N).left.Opens).ι ≫ (weilProjectiveSpaceOver k N).hom =
          isoProj.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
        (∀ (a' : Fin (N + 1)) (ha' : a' ≠ a)
            (p : AlgebraicGeometry.Spec (CommRingCat.of P_a)),
          (isoProj.inv ≫
              (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) :
                (weilProjectiveSpaceOver k N).left.Opens).ι).base p ∈
            (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a') :
              (weilProjectiveSpaceOver k N).left.Opens) ↔
            MvPolynomial.X ⟨a', ha'⟩ ∉ p.asIdeal) := by
    intro N a
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hx : ∀ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
      fun i => (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X i)).mpr
        (MvPolynomial.isHomogeneous_X k i)
    let hx_a := hx a
    let R_hom := MvPolynomial (Fin (N + 1)) k
    let Xa : R_hom := MvPolynomial.X a
    let P_a := MvPolynomial {b : Fin (N + 1) // b ≠ a} k
    let α : P_a →+* HomogeneousLocalization.Away 𝒜 Xa :=
      MvPolynomial.eval₂Hom
        ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xa)).comp
          (algebraMap k ↥(𝒜 0)))
        (fun b => HomogeneousLocalization.Away.isLocalizationElem hx_a (hx b.1))
    have hα_C : ∀ x : k, α (MvPolynomial.C x) =
        HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xa)
          (algebraMap k ↥(𝒜 0) x) := by
      intro x; dsimp only [α]; rw [MvPolynomial.eval₂Hom_C]; rfl
    have hα_X : ∀ b : {b : Fin (N + 1) // b ≠ a},
        α (MvPolynomial.X b) = HomogeneousLocalization.Away.isLocalizationElem hx_a (hx b.1) := by
      intro b; dsimp only [α]; rw [MvPolynomial.eval₂Hom_X']
    let valHom : HomogeneousLocalization.Away 𝒜 Xa →+* Localization.Away Xa :=
      (Algebra.ofId (HomogeneousLocalization.Away 𝒜 Xa) (Localization.Away Xa)).toRingHom
    have hvalHom : ∀ z : HomogeneousLocalization.Away 𝒜 Xa, valHom z = z.val :=
      fun _ => rfl
    have hα_C_val : ∀ x : k, (α (MvPolynomial.C x)).val =
        algebraMap R_hom (Localization.Away Xa) (MvPolynomial.C x) := by
      intro x
      rw [hα_C]
      exact hFromZeroVal N (Submonoid.powers Xa) x
    have hα_X_val : ∀ b : {b : Fin (N + 1) // b ≠ a}, (α (MvPolynomial.X b)).val =
        algebraMap R_hom (Localization.Away Xa) (MvPolynomial.X b.1) *
          IsLocalization.Away.invSelf (S := Localization.Away Xa) Xa := by
      intro b
      rw [hα_X]
      dsimp [HomogeneousLocalization.Away.isLocalizationElem]
      have h1 := hLocMk Xa ((MvPolynomial.X b.1 : R_hom) ^ 1) 1 ⟨1, rfl⟩
      simpa [pow_one] using h1
    let ev_a : R_hom →+* P_a :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun i : Fin (N + 1) => if h : i = a then 1 else MvPolynomial.X ⟨i, h⟩)
    have hev_C : ∀ x : k, ev_a (MvPolynomial.C x) = MvPolynomial.C x := by
      intro x; dsimp only [ev_a]; rw [MvPolynomial.eval₂Hom_C]
    have hev_X : ∀ i : Fin (N + 1),
        ev_a (MvPolynomial.X i) = if h : i = a then 1 else MvPolynomial.X ⟨i, h⟩ := by
      intro i; dsimp only [ev_a]; rw [MvPolynomial.eval₂Hom_X']
    have hev_Xa : IsUnit (ev_a Xa) := by
      change IsUnit (ev_a (MvPolynomial.X a))
      rw [hev_X]
      simp only [↓reduceDIte, isUnit_one]
    obtain ⟨L_a, hLa_alg, hLa_inv⟩ := hAwayLift Xa ev_a hev_Xa
    have hLa_inv1 : L_a (IsLocalization.Away.invSelf (S := Localization.Away Xa) Xa) = 1 := by
      rw [hLa_inv]
      apply hev_Xa.mul_right_inj.mp
      rw [IsUnit.mul_val_inv, mul_one]
      change 1 = ev_a (MvPolynomial.X a)
      rw [hev_X]
      simp only [↓reduceDIte]
    let β : HomogeneousLocalization.Away 𝒜 Xa →+* P_a := L_a.comp valHom
    have hβ_α : β.comp α = RingHom.id P_a := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro x
        change β (α (MvPolynomial.C x)) = MvPolynomial.C x
        simp only [β, RingHom.comp_apply, hvalHom, hα_C_val, hLa_alg, hev_C]
      · intro b
        change β (α (MvPolynomial.X b)) = MvPolynomial.X b
        simp only [β, RingHom.comp_apply, hvalHom, hα_X_val, map_mul,
          hLa_alg, hLa_inv1, mul_one, hev_X, b.2, ↓reduceDIte]
    have h_ev_val : ∀ b : Fin (N + 1),
        (α (ev_a (MvPolynomial.X b))).val =
          algebraMap R_hom (Localization.Away Xa) (MvPolynomial.X b) *
            IsLocalization.Away.invSelf (S := Localization.Away Xa) Xa := by
      intro b
      rw [hev_X]
      split_ifs with hb
      · subst hb
        rw [map_one, ← hvalHom, map_one]
        exact (IsLocalization.Away.mul_invSelf Xa).symm
      · exact hα_X_val ⟨b, hb⟩
    have hα_β : ∀ z : HomogeneousLocalization.Away 𝒜 Xa, α (β z) = z := by
      intro z
      obtain ⟨d, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hx_a z
      apply HomogeneousLocalization.val_injective
      have hz_val : (HomogeneousLocalization.Away.mk 𝒜 hx_a d F hF).val =
          algebraMap R_hom (Localization.Away Xa) F *
            (IsLocalization.Away.invSelf (S := Localization.Away Xa) Xa) ^ d := by
        rw [HomogeneousLocalization.Away.val_mk]
        exact hLocMk Xa F d _
