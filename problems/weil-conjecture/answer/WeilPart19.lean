        MvPolynomial.aeval (fun v => uS_base ⊗ₜ[R₀] y v)
      have hφ_ker : ∀ P ∈ RingHom.ker π_src.toRingHom, φ_poly P = 0 := by
        have h_le : RingHom.ker π_src.toRingHom ≤ RingHom.ker φ_poly.toRingHom := by
          have h_ideal : Ideal.span (Set.range p_rel) = RingHom.ker π_src.toRingHom := hp_span
          rw [← h_ideal, Ideal.span_le]
          rintro _ ⟨α, rfl⟩
          change φ_poly (p_rel α) = 0
          have hev : φ_poly (p_rel α) =
              MvPolynomial.aeval (fun v => uS * ιS (y v)) (p_rel α) := by
            congr 1
            apply MvPolynomial.algHom_ext
            intro v
            simp only [φ_poly, MvPolynomial.aeval_X]
            change uS_base ⊗ₜ[R₀] y v = (uS_base ⊗ₜ[R₀] 1) * ((1 : S) ⊗ₜ[R₀] y v)
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
