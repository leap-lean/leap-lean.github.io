    obtain ⟨x₀, hx₀_G', hx₀_dvd'⟩ := hex_min
    have hx₀_ne : x₀ ≠ 0 := (Finset.mem_erase.mp hx₀_G').1
    have hx₀_G : x₀ ∈ G := (Finset.mem_erase.mp hx₀_G').2
