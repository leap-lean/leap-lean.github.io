    (hFF : (algebraMap A D).FaithfullyFlat)
    (hEt : Algebra.Etale A D)
    (e₁₂ : ZMod ℓ → TensorProduct A D D)
    (he_idem : ∀ δ : ZMod ℓ, e₁₂ δ * e₁₂ δ = e₁₂ δ)
    (he_orth : ∀ δ₁ δ₂ : ZMod ℓ, δ₁ ≠ δ₂ → e₁₂ δ₁ * e₁₂ δ₂ = 0)
    (he_sum : (∑ δ : ZMod ℓ, e₁₂ δ) = 1)
