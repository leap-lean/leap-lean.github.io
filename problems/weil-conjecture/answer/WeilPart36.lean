    @hr_all

  
  have hUnpackPB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₂ F₁ →
      Nonempty
        ((((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology).obj F₂) ≅ F₁) := by
    intro X₁ X₂ h F₂ F₁ hPB
    rcases hPB with ⟨hc, hr, ⟨e⟩⟩
    cases Subsingleton.elim hc (@hc_all X₁ X₂ h)
    cases Subsingleton.elim hr (@hr_all X₁ X₂ h)
    exact ⟨e⟩

  have hCoimagePB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ G₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (ψ₂ : F₂ ⟶ G₂)
      (F₁ G₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₂ F₁ →
      WeilIsEtaleSheafPullback h G₂ G₁ →
      ∃ (ψ₁ : F₁ ⟶ G₁),
        WeilIsEtaleSheafPullback h
          (CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ₂))
          (CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ₁)) := by
    intro X₁ X₂ h F₂ G₂ ψ₂ F₁ G₁ hPB_F hPB_G
    obtain ⟨e_F⟩ := hUnpackPB h F₂ F₁ hPB_F
    obtain ⟨e_G⟩ := hUnpackPB h G₂ G₁ hPB_G
    let pb := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    letI : pb.Additive := (hSite.1 h).1
    letI : CategoryTheory.Limits.PreservesFiniteLimits pb := (hSite.1 h).2.1
    letI : CategoryTheory.Limits.PreservesFiniteColimits pb := (hSite.1 h).2.2.1
    let ψ₁ : F₁ ⟶ G₁ := e_F.inv ≫ pb.map ψ₂ ≫ e_G.hom
    have heq : e_F.hom ≫ ψ₁ = pb.map ψ₂ ≫ e_G.hom := by
      dsimp [ψ₁]
      rw [← CategoryTheory.Category.assoc, e_F.hom_inv_id, CategoryTheory.Category.id_comp]
    let e_ker : pb.obj (CategoryTheory.Limits.kernel ψ₂) ≅
        CategoryTheory.Limits.kernel (pb.map ψ₂) :=
      CategoryTheory.Limits.PreservesKernel.iso pb ψ₂
    have he_ker_ι : e_ker.hom ≫ CategoryTheory.Limits.kernel.ι (pb.map ψ₂) =
        pb.map (CategoryTheory.Limits.kernel.ι ψ₂) := by
      rw [CategoryTheory.Limits.PreservesKernel.iso_hom,
        CategoryTheory.Limits.kernelComparison_comp_ι]
    have hk_to0 : (pb.map (CategoryTheory.Limits.kernel.ι ψ₂) ≫ e_F.hom) ≫ ψ₁ = 0 := by
      rw [CategoryTheory.Category.assoc, heq, ← CategoryTheory.Category.assoc, ← pb.map_comp,
        CategoryTheory.Limits.kernel.condition, pb.map_zero, CategoryTheory.Limits.zero_comp]
    have hk_from0 : (CategoryTheory.Limits.kernel.ι ψ₁ ≫ e_F.inv) ≫ pb.map ψ₂ = 0 := by
      apply (cancel_mono e_G.hom).mp
      rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc]
      exact CategoryTheory.Limits.kernel.condition ψ₁
    let k_from : CategoryTheory.Limits.kernel ψ₁ ⟶ pb.obj (CategoryTheory.Limits.kernel ψ₂) :=
      CategoryTheory.Limits.kernel.lift (pb.map ψ₂)
        (CategoryTheory.Limits.kernel.ι ψ₁ ≫ e_F.inv) hk_from0 ≫ e_ker.inv
    have hk_from_ι : k_from ≫ pb.map (CategoryTheory.Limits.kernel.ι ψ₂) =
        CategoryTheory.Limits.kernel.ι ψ₁ ≫ e_F.inv := by
      dsimp [k_from]
      rw [CategoryTheory.Category.assoc, ← he_ker_ι, e_ker.inv_hom_id_assoc,
        CategoryTheory.Limits.kernel.lift_ι]
    have hc_to0 : pb.map (CategoryTheory.Limits.kernel.ι ψ₂) ≫
        (e_F.hom ≫ CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ₁)) = 0 := by
      rw [← CategoryTheory.Category.assoc,
        ← CategoryTheory.Limits.kernel.lift_ι ψ₁
          (pb.map (CategoryTheory.Limits.kernel.ι ψ₂) ≫ e_F.hom) hk_to0,
        CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.condition,
        CategoryTheory.Limits.comp_zero]
    let c_to : CategoryTheory.Limits.cokernel (pb.map (CategoryTheory.Limits.kernel.ι ψ₂)) ⟶
        CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ₁) :=
      CategoryTheory.Limits.cokernel.desc (pb.map (CategoryTheory.Limits.kernel.ι ψ₂))
        (e_F.hom ≫ CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ₁)) hc_to0
    have hc_from0 : CategoryTheory.Limits.kernel.ι ψ₁ ≫
        (e_F.inv ≫
          CategoryTheory.Limits.cokernel.π (pb.map (CategoryTheory.Limits.kernel.ι ψ₂))) = 0 := by
      rw [← CategoryTheory.Category.assoc, ← hk_from_ι, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
    let c_from : CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ₁) ⟶
        CategoryTheory.Limits.cokernel (pb.map (CategoryTheory.Limits.kernel.ι ψ₂)) :=
      CategoryTheory.Limits.cokernel.desc (CategoryTheory.Limits.kernel.ι ψ₁)
        (e_F.inv ≫ CategoryTheory.Limits.cokernel.π (pb.map (CategoryTheory.Limits.kernel.ι ψ₂)))
        hc_from0
    let e_cok₂ : CategoryTheory.Limits.cokernel (pb.map (CategoryTheory.Limits.kernel.ι ψ₂)) ≅
        CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ₁) :=
      { hom := c_to
        inv := c_from
        hom_inv_id := by
          apply (cancel_epi
            (CategoryTheory.Limits.cokernel.π (pb.map (CategoryTheory.Limits.kernel.ι ψ₂)))).mp
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
            ← CategoryTheory.Category.assoc, e_F.hom_inv_id, CategoryTheory.Category.id_comp,
            CategoryTheory.Category.comp_id]
        inv_hom_id := by
          apply (cancel_epi
            (CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ₁))).mp
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
            ← CategoryTheory.Category.assoc, e_F.inv_hom_id, CategoryTheory.Category.id_comp,
            CategoryTheory.Category.comp_id] }
    exact ⟨ψ₁, ⟨@hc_all X₁ X₂ h, @hr_all X₁ X₂ h,
      ⟨CategoryTheory.Limits.PreservesCokernel.iso pb (CategoryTheory.Limits.kernel.ι ψ₂) ≪≫
        e_cok₂⟩⟩⟩

  have hEpiPB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F₂ Q₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (π₂ : F₂ ⟶ Q₂) [CategoryTheory.Epi π₂]
      (F₁ Q₁ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₂ F₁ →
      WeilIsEtaleSheafPullback h Q₂ Q₁ →
      ∃ (π₁ : F₁ ⟶ Q₁), CategoryTheory.Epi π₁ := by
    intro X₁ X₂ h F₂ Q₂ π₂ _ F₁ Q₁ hPB_F hPB_Q
    obtain ⟨e_F⟩ := hUnpackPB h F₂ F₁ hPB_F
    obtain ⟨e_Q⟩ := hUnpackPB h Q₂ Q₁ hPB_Q
    let pb := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    letI : CategoryTheory.Limits.PreservesFiniteColimits pb := (hSite.1 h).2.2.1
    have : CategoryTheory.Epi (pb.map π₂) := pb.map_epi π₂
    exact ⟨e_F.inv ≫ pb.map π₂ ≫ e_Q.hom, inferInstance⟩

  
  have hSheafifyBijOfTopSieve : ∀ (S : AlgebraicGeometry.Scheme.{u}) (V : S.Etale),
      (∀ R ∈ S.smallEtaleTopology V, R.arrows (𝟙 V)) →
      ∀ (P : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}),
        Function.Bijective
          ((CategoryTheory.toSheafify S.smallEtaleTopology P).app (Opposite.op V)) := by
    clear * -
    intro S V hTop P
    let J := S.smallEtaleTopology
    let η_sh := CategoryTheory.toSheafify J P
    have : CategoryTheory.Presheaf.IsLocallyInjective J η_sh := inferInstance
    have : CategoryTheory.Presheaf.IsLocallySurjective J η_sh := inferInstance
    constructor
    · intro x y hxy
      have hmem : CategoryTheory.Presheaf.equalizerSieve x y ∈ J V :=
        CategoryTheory.Presheaf.equalizerSieve_mem J η_sh x y hxy
      have hid : (CategoryTheory.Presheaf.equalizerSieve x y).arrows (𝟙 V) := hTop _ hmem
      change (P.map (𝟙 (Opposite.op V))) x = (P.map (𝟙 (Opposite.op V))) y at hid
      rwa [P.map_id, AddCommGrpCat.id_apply, AddCommGrpCat.id_apply] at hid
    · intro s
      have hmem : CategoryTheory.Presheaf.imageSieve η_sh s ∈ J V :=
        CategoryTheory.Presheaf.imageSieve_mem J η_sh s
      obtain ⟨x, hx⟩ := hTop _ hmem
      refine ⟨x, hx.trans ?_⟩
      change (((CategoryTheory.sheafify J P).map (𝟙 (Opposite.op V))) s) = s
      rw [(CategoryTheory.sheafify J P).map_id, AddCommGrpCat.id_apply]

  
  have hAlgClosedEtaleSecPt : ∀ (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
      (W : AlgebraicGeometry.Scheme.{u})
      (w : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) [AlgebraicGeometry.Etale w]
      (x : ↥W),
      ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ W,
        σ ≫ w = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) ∧
        σ.base (⊥ : PrimeSpectrum Ω₀) = x := by
    clear * -
    intro Ω₀ _ _ W w _ x
    obtain ⟨V_aff, hAffV, hx_V, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := W) (x := x) (U := ⊤) trivial
    let R_V : CommRingCat.{u} := W.presheaf.obj (Opposite.op V_aff)
    let j_B : AlgebraicGeometry.Spec R_V ⟶ W := hAffV.fromSpec
    have hx_range : x ∈ Set.range ⇑j_B.base := by
      rw [hAffV.range_fromSpec]
      exact hx_V
    obtain ⟨p₀, hp₀⟩ := hx_range
    let q₀ : PrimeSpectrum ↥R_V := p₀
    have hw_spec : AlgebraicGeometry.Etale (j_B ≫ w) := by
      dsimp [j_B]
      infer_instance
    let φ_hom : CommRingCat.of Ω₀ ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_B ≫ w)
    have hφ_map : AlgebraicGeometry.Spec.map φ_hom = j_B ≫ w :=
      AlgebraicGeometry.Spec.map_preimage (j_B ≫ w)
    let _ : Algebra Ω₀ ↥R_V := φ_hom.hom.toAlgebra
    have : Algebra.Etale Ω₀ ↥R_V := by
      rw [← RingHom.etale_algebraMap]
      change φ_hom.hom.Etale
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hφ_map.symm ▸ hw_spec)
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod Ω₀ ↥R_V).mp inferInstance
    let _ : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra Ω₀ (L i) := hAlgL
    have hex_i₀ : ∃ i₀ : I, Θ.symm (Pi.single i₀ 1) ∉ q₀.asIdeal := by
      by_contra! hall
      have h1_prod : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j
        simp [Finset.sum_apply]
      have h1_R : (1 : ↥R_V) = ∑ i : I, Θ.symm (Pi.single i 1) := by
        calc
          (1 : ↥R_V) = Θ.symm 1 := (map_one Θ.symm).symm
          _ = ∑ i : I, Θ.symm (Pi.single i 1) := by rw [h1_prod, map_sum]
      have h1_mem : (1 : ↥R_V) ∈ q₀.asIdeal := by
        rw [h1_R]
        exact Ideal.sum_mem q₀.asIdeal fun i _ => hall i
      exact q₀.isPrime.ne_top ((Ideal.eq_top_iff_one q₀.asIdeal).mpr h1_mem)
    obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
    have : Algebra.IsSeparable Ω₀ (L i₀) := (hFinSep i₀).2
    let e_L : Ω₀ ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap Ω₀ (L i₀))
        ⟨RingHom.injective _, IsSepClosed.algebraMap_surjective Ω₀ (L i₀)⟩
    let χ_ring : ↥R_V →+* Ω₀ :=
      e_L.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom)
    let χ : R_V ⟶ CommRingCat.of Ω₀ := CommRingCat.ofHom χ_ring
    have hφχ : φ_hom ≫ χ = 𝟙 (CommRingCat.of Ω₀) := by
      apply CommRingCat.hom_ext
      ext c
      change e_L.symm ((Θ (algebraMap Ω₀ ↥R_V c)) i₀) = c
      rw [Θ.commutes]
      exact e_L.symm_apply_apply c
    have hχ_surj : Function.Surjective χ_ring := by
      intro c
      refine ⟨Θ.symm (Pi.single i₀ (e_L c)), ?_⟩
      change e_L.symm ((Θ (Θ.symm (Pi.single i₀ (e_L c)))) i₀) = c
      rw [AlgEquiv.apply_symm_apply, Pi.single_eq_same, e_L.symm_apply_apply]
    have hker_max : (RingHom.ker χ_ring).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective χ_ring hχ_surj
    have hker_le : RingHom.ker χ_ring ≤ q₀.asIdeal := by
      intro r hr
      rw [RingHom.mem_ker] at hr
      have hθr0 : (Θ r) i₀ = 0 := by
        have h1 : e_L.symm ((Θ r) i₀) = 0 := hr
        exact e_L.symm.injective (h1.trans (map_zero e_L.symm).symm)
      have hmul0_prod : Θ r * Pi.single i₀ (1 : L i₀) = 0 := by
        ext j
        by_cases hj : j = i₀
        · subst hj; simp [hθr0]
        · simp [Pi.single_eq_of_ne hj]
      have hmul0 : r * Θ.symm (Pi.single i₀ 1) = 0 := by
        calc
          r * Θ.symm (Pi.single i₀ 1) = Θ.symm (Θ r * Pi.single i₀ 1) := by
            rw [map_mul, AlgEquiv.symm_apply_apply]
          _ = 0 := by rw [hmul0_prod, map_zero]
      have hmem_mul : r * Θ.symm (Pi.single i₀ 1) ∈ q₀.asIdeal := by
        rw [hmul0]
        exact q₀.asIdeal.zero_mem
      exact (q₀.isPrime.mem_or_mem hmem_mul).resolve_right hi₀_not_mem
    have hker_eq : RingHom.ker χ_ring = q₀.asIdeal :=
      hker_max.eq_of_le q₀.isPrime.ne_top hker_le
    have hcomap_pt : (AlgebraicGeometry.Spec.map χ).base (⊥ : PrimeSpectrum Ω₀) = p₀ := by
      apply PrimeSpectrum.ext
      change Ideal.comap χ_ring ⊥ = q₀.asIdeal
      rw [← RingHom.ker_eq_comap_bot]
      exact hker_eq
    refine ⟨AlgebraicGeometry.Spec.map χ ≫ j_B, ?_, ?_⟩
    · rw [CategoryTheory.Category.assoc, ← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hφχ,
        AlgebraicGeometry.Spec.map_id]
    · change j_B.base ((AlgebraicGeometry.Spec.map χ).base (⊥ : PrimeSpectrum Ω₀)) = x
      rw [hcomap_pt, hp₀]

  
  have hTopHensel : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)],
      let S_R := AlgebraicGeometry.Spec (CommRingCat.of R)
      let T_R := weilEtaleIdTerminal.{u} S_R
      ∀ S_sieve ∈ S_R.smallEtaleTopology T_R, S_sieve.arrows (𝟙 T_R) := by
    clear * -
    intro R _ _ _ S_R T_R S_sieve hS
    let hT_R := weilEtaleIdTerminalIsTerminal.{u} S_R
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hJ_eq : S_R.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_R (le_refl P_et)
    have hmem_pre : S_sieve ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck T_R :=
      hJ_eq ▸ hS
    obtain ⟨Y, f, y, hf_arr, _, hfy⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) T_R S_sieve).mp hmem_pre (IsLocalRing.closedPoint R)
    have hY_hom_y : Y.hom.base y = IsLocalRing.closedPoint R :=
      (congrArg (fun m : Y.left ⟶ S_R => m.base y)
        (f.w.symm.trans (CategoryTheory.Category.comp_id f.left))).trans hfy
    obtain ⟨U, hU, hyU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y.left) (x := y) (U := ⊤) trivial
    let B_ring : Type u := ↑(Y.left.presheaf.obj (Opposite.op U))
    have hy_range : y ∈ Set.range ⇑hU.fromSpec := by
      rw [hU.range_fromSpec]
      exact hyU
    obtain ⟨p_B, hp_B⟩ := hy_range
    let q_B : PrimeSpectrum B_ring := p_B
    have : q_B.asIdeal.IsPrime := q_B.isPrime
    let w_B : AlgebraicGeometry.Spec (CommRingCat.of B_ring) ⟶ S_R := hU.fromSpec ≫ Y.hom
    have hw_B_et : AlgebraicGeometry.Etale w_B := by
      have : AlgebraicGeometry.Etale Y.hom := Y.prop
      dsimp [w_B]
      infer_instance
    let f_RB : R →+* B_ring := (AlgebraicGeometry.Spec.preimage w_B).hom
    have hf_RB_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_RB) = w_B :=
      AlgebraicGeometry.Spec.map_preimage w_B
    let _ : Algebra R B_ring := f_RB.toAlgebra
    have : Algebra.Etale R B_ring := by
      rw [← RingHom.etale_algebraMap]
      change f_RB.Etale
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hf_RB_map.symm ▸ hw_B_et)
    have hcomap_pB : PrimeSpectrum.comap f_RB q_B = IsLocalRing.closedPoint R := by
      have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_RB)).base p_B =
          PrimeSpectrum.comap f_RB q_B := rfl
      rw [← h1, hf_RB_map]
      change Y.hom.base (hU.fromSpec.base p_B) = _
      rw [hp_B, hY_hom_y]
    let κ_R : Type u := IsLocalRing.ResidueField R
    let res_R : R →+* κ_R := IsLocalRing.residue R
    let K_B : Type u := AlgebraicClosure q_B.asIdeal.ResidueField
    let φ_B : B_ring →+* K_B :=
      (algebraMap q_B.asIdeal.ResidueField K_B).comp (algebraMap B_ring q_B.asIdeal.ResidueField)
    let α_B : R →+* K_B := φ_B.comp f_RB
    have hker_φB : RingHom.ker φ_B = q_B.asIdeal := by
      refine (?_ : RingHom.ker φ_B =
          RingHom.ker (algebraMap B_ring q_B.asIdeal.ResidueField)).trans
        (Ideal.ker_algebraMap_residueField q_B.asIdeal)
      ext b
      simp only [RingHom.mem_ker, φ_B, RingHom.comp_apply]
      exact ⟨fun h => (RingHom.injective (algebraMap q_B.asIdeal.ResidueField K_B))
        (h.trans (map_zero _).symm), fun h => by rw [h, map_zero]⟩
    have hker_αB : RingHom.ker α_B = IsLocalRing.maximalIdeal R := by
      change Ideal.comap f_RB (RingHom.ker φ_B) = _
      rw [hker_φB]
      exact congrArg PrimeSpectrum.asIdeal hcomap_pB
    have hle_ker : ∀ r ∈ IsLocalRing.maximalIdeal R, α_B r = 0 :=
      fun r hr => RingHom.mem_ker.mp (hker_αB.symm ▸ hr)
    let ι_κ : κ_R →+* K_B := Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) α_B hle_ker
    have hι_res : ι_κ.comp res_R = α_B := by
      ext r
      exact Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal R) α_B hle_ker
    let B_κ : Type u := TensorProduct R κ_R B_ring
    have : Algebra.Etale κ_R B_κ := inferInstance
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ_R B_κ).mp inferInstance
    let _ : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra κ_R (L i) := hAlgL
    let _ : Algebra R K_B := α_B.toAlgebra
    let ι_κ_alg : κ_R →ₐ[R] K_B :=
      { ι_κ with commutes' := fun r => congrFun (congrArg DFunLike.coe hι_res) r }
    let φ_alg : B_ring →ₐ[R] K_B :=
      { φ_B with commutes' := fun _ => rfl }
    let Ψ_κ : B_κ →ₐ[R] K_B :=
      Algebra.TensorProduct.lift ι_κ_alg φ_alg (fun _ _ => Commute.all _ _)
    let χ : (∀ i : I, L i) →+* K_B := Ψ_κ.toRingHom.comp Θ.symm.toRingHom
    have hex_i₀ : ∃ i₀ : I, χ (Pi.single i₀ 1) ≠ 0 := by
      by_contra! hall
      have h1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j; simp [Finset.sum_apply]
      have h0 : (1 : K_B) = 0 := by
        calc
          (1 : K_B) = χ 1 := (map_one χ).symm
          _ = ∑ i : I, χ (Pi.single i 1) := by rw [h1, map_sum]
          _ = 0 := Finset.sum_eq_zero (fun i _ => hall i)
      exact one_ne_zero h0
    obtain ⟨i₀, _⟩ := hex_i₀
    have : Algebra.IsSeparable κ_R (L i₀) := (hFinSep i₀).2
    let e_i₀ : κ_R ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap κ_R (L i₀))
        ⟨RingHom.injective _, IsSepClosed.algebraMap_surjective κ_R (L i₀)⟩
    let π_B : B_ring →+* L i₀ :=
      (Pi.evalRingHom L i₀).comp
        (Θ.toRingHom.comp (Algebra.TensorProduct.includeRight : B_ring →ₐ[R] B_κ).toRingHom)
    let ψ₀ : B_ring →ₐ[R] κ_R :=
      { (e_i₀.symm.toRingHom.comp π_B) with
        commutes' := fun r => by
          change e_i₀.symm ((Θ (TensorProduct.tmul R (1 : κ_R) (algebraMap R B_ring r))) i₀) =
            algebraMap R κ_R r
          have htmul : TensorProduct.tmul R (1 : κ_R) (algebraMap R B_ring r) =
              algebraMap κ_R B_κ (algebraMap R κ_R r) := by
            calc
              TensorProduct.tmul R (1 : κ_R) (algebraMap R B_ring r)
                = TensorProduct.tmul R (1 : κ_R) (r • (1 : B_ring)) := by
                    rw [Algebra.smul_def, mul_one]
              _ = TensorProduct.tmul R (r • (1 : κ_R)) (1 : B_ring) := by
                    rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
              _ = algebraMap κ_R B_κ (algebraMap R κ_R r) := by
                    rw [Algebra.smul_def, mul_one]; rfl
          rw [htmul, Θ.commutes]
          exact e_i₀.symm_apply_apply (algebraMap R κ_R r) }
    let Q_id : Ideal B_ring := RingHom.ker ψ₀.toRingHom
    have : Q_id.IsPrime := RingHom.ker_isPrime ψ₀.toRingHom
    obtain ⟨f_loc_el, hfQ, hStd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) Q_id
    let _ : Algebra.IsStandardEtale R (Localization.Away f_loc_el) := hStd
    have hf_ne : ψ₀ f_loc_el ≠ 0 := fun h0 => hfQ (RingHom.mem_ker.mpr h0)
    have hf_unit : IsUnit (ψ₀.toRingHom f_loc_el) := IsUnit.mk0 (ψ₀ f_loc_el) hf_ne
    let ψ_loc : Localization.Away f_loc_el →ₐ[R] κ_R :=
      { (IsLocalization.Away.lift f_loc_el (g := ψ₀.toRingHom) hf_unit) with
        commutes' := fun r => by
          rw [IsScalarTower.algebraMap_apply R B_ring (Localization.Away f_loc_el)]
          change IsLocalization.Away.lift f_loc_el hf_unit
            (algebraMap B_ring _ (algebraMap R B_ring r)) = _
          rw [IsLocalization.Away.lift_eq]
          exact ψ₀.commutes r }
    obtain ⟨pres⟩ :=
      Algebra.IsStandardEtale.nonempty_standardEtalePresentation
        (R := R) (S := Localization.Away f_loc_el)
    let P_pair : StandardEtalePair R := pres.P
    let a_bar : κ_R := ψ_loc pres.x
    have hMap_bar : P_pair.HasMap a_bar := pres.hasMap.map ψ_loc
    have hf_bar : Polynomial.aeval a_bar P_pair.f = 0 := hMap_bar.1
    have hg_bar : IsUnit (Polynomial.aeval a_bar P_pair.g) := hMap_bar.2
    have hderiv_bar : IsUnit (Polynomial.aeval a_bar (Polynomial.derivative P_pair.f)) := by
      apply IsUnit.mk0
      intro h0
      cases hP : P_pair with
      | mk fP hfP_monic gP hBez =>
        have hf_bar' : Polynomial.aeval a_bar fP = 0 := by simpa [hP] using hf_bar
        have hg_bar' : Polynomial.aeval a_bar gP ≠ 0 := by
          have hg_eq : P_pair.g = gP := by rw [hP]
          have hu : IsUnit (Polynomial.aeval a_bar gP) := hg_eq ▸ hg_bar
          exact hu.ne_zero
        have h0' : Polynomial.aeval a_bar (Polynomial.derivative fP) = 0 := by
          simpa [hP] using h0
        obtain ⟨p₁, p₂, nP, hBezout⟩ := hBez
        have h_ev := congrArg (Polynomial.aeval a_bar) hBezout
        simp [hf_bar', h0'] at h_ev
        exact pow_ne_zero nP hg_bar' h_ev.symm
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective a_bar
    have h_eval_res : ∀ (q_p : Polynomial R) (x : R),
        res_R (q_p.eval x) = Polynomial.aeval (res_R x) q_p := by
      intro q_p x
      rw [Polynomial.aeval_def]
      exact (Polynomial.eval₂_at_apply res_R x).symm
    have hf_a₀ : P_pair.f.eval a₀ ∈ IsLocalRing.maximalIdeal R := by
      rw [← IsLocalRing.ker_residue, RingHom.mem_ker, h_eval_res, ha₀]
      exact hf_bar
    have hderiv_a₀ : IsUnit ((Polynomial.derivative P_pair.f).eval a₀) := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.ker_residue,
        RingHom.mem_ker, h_eval_res, ha₀]
      exact hderiv_bar.ne_zero
    obtain ⟨a, ha_root, ha_diff⟩ :=
      HenselianLocalRing.is_henselian P_pair.f P_pair.monic_f a₀ hf_a₀ hderiv_a₀
    have hres_a : res_R a = a_bar := by
      have h0 : res_R (a - a₀) = 0 := by
        rw [← IsLocalRing.ker_residue, RingHom.mem_ker] at ha_diff
        exact ha_diff
      rw [map_sub, sub_eq_zero] at h0
      exact h0.trans ha₀
    have ha_f : Polynomial.aeval a P_pair.f = 0 := ha_root
    have ha_g : IsUnit (Polynomial.aeval a P_pair.g) := by
      change IsUnit (P_pair.g.eval a)
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.ker_residue,
        RingHom.mem_ker, h_eval_res, hres_a]
      exact hg_bar.ne_zero
    let e_P : P_pair.Ring ≃ₐ[R] Localization.Away f_loc_el :=
      AlgEquiv.ofBijective (P_pair.lift pres.x pres.hasMap) pres.lift_bijective
    let ψ_sec : B_ring →ₐ[R] R :=
      (P_pair.lift a ⟨ha_f, ha_g⟩).comp
        (e_P.symm.toAlgHom.comp (IsScalarTower.toAlgHom R B_ring (Localization.Away f_loc_el)))
    let σ₀ : S_R ⟶ Y.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sec.toRingHom) ≫ hU.fromSpec
    have hσ₀_hom : σ₀ ≫ Y.hom = 𝟙 S_R := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sec.toRingHom) ≫ hU.fromSpec) ≫
        Y.hom = 𝟙 S_R
      refine (CategoryTheory.Category.assoc _ _ _).trans ?_
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sec.toRingHom) ≫ w_B = 𝟙 S_R
      rw [← hf_RB_map, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hid : ψ_sec.toRingHom.comp f_RB = RingHom.id R := RingHom.ext ψ_sec.commutes
      rw [hid]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of R)
    let σ_et : T_R ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk σ₀ hσ₀_hom trivial
    have hcomp_id : σ_et ≫ f = 𝟙 T_R := hT_R.hom_ext (σ_et ≫ f) (𝟙 T_R)
    exact hcomp_id ▸ S_sieve.downward_closed hf_arr σ_et

  
  have hHenselOpenInj : ∀ (m_mod r_d : ℕ)
      (R_b : Type u) [CommRing R_b] [HenselianLocalRing R_b]
      [IsAlgClosed (IsLocalRing.ResidueField R_b)]
      (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀]
      (j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_b))
      [AlgebraicGeometry.Etale j_R]
      (X_R : AlgebraicGeometry.Scheme.{u})
      (f_R : X_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_b)),
      (let j_X := CategoryTheory.Limits.pullback.fst f_R j_R
       ∀ ψ_r : weilEtaleTorsionH X_R m_mod r_d →+
           weilEtaleTorsionH (CategoryTheory.Limits.pullback f_R j_R) m_mod r_d,
         WeilIsTorsionEtalePullback j_X m_mod r_d ψ_r → Function.Injective ψ_r) →
      let S_R := AlgebraicGeometry.Spec (CommRingCat.of R_b)
      let T_R := weilEtaleIdTerminal.{u} S_R
      let U_Ω : S_R.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j_R inferInstance
      let u_Ω : U_Ω ⟶ T_R := (weilEtaleIdTerminalIsTerminal.{u} S_R).from U_Ω
      let G_R := weilEtaleHigherDirectImage f_R r_d (weilEtaleTorsionSheaf X_R m_mod)
      Function.Injective (G_R.obj.map (Opposite.op u_Ω)) := by
    clear * - hSheafifyBijOfTopSieve hAlgClosedEtaleSecPt hTopHensel hTorsPull hAltSlice
    intro m_mod r_d R_b _ _ _ Ω₀ _ _ j_R _ X_R f_R hInj_jX₀ S_R T_R U_Ω u_Ω G_R
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω₀)
    have hTop_TR : ∀ R ∈ S_R.smallEtaleTopology T_R, R.arrows (𝟙 T_R) := hTopHensel R_b
    have hTop_UΩ : ∀ R ∈ S_R.smallEtaleTopology U_Ω, R.arrows (𝟙 U_Ω) := by
      intro R hR
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have hJ_eq : S_R.smallEtaleTopology =
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) S_R (le_refl P_et)
      have hmem_pre : R ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U_Ω :=
        hJ_eq ▸ hR
      obtain ⟨Y, f, y, hf_arr, hf_et, _⟩ :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) U_Ω R).mp hmem_pre (⊥ : PrimeSpectrum Ω₀)
      let f_left : Y.left ⟶ S_Ω := f.left
      have : AlgebraicGeometry.Etale f_left := hf_et
      obtain ⟨σ, hσ, _⟩ := hAlgClosedEtaleSecPt Ω₀ Y.left f_left y
      have hσ_Y : σ ≫ Y.hom = j_R :=
        (congrArg (σ ≫ ·) f.w.symm).trans
          ((CategoryTheory.Category.assoc σ f_left j_R).symm.trans
            ((congrArg (· ≫ j_R) hσ).trans (CategoryTheory.Category.id_comp j_R)))
      let s_et : U_Ω ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk σ hσ_Y trivial
      have hcomp_id : s_et ≫ f = 𝟙 U_Ω :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hσ (Subsingleton.elim _ _)
      exact hcomp_id ▸ R.downward_closed hf_arr s_et
    have hShMapInj : ∀ (P : (S_R.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}),
        Function.Injective (P.map (Opposite.op u_Ω)) →
        Function.Injective
          (((CategoryTheory.presheafToSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj
            P).obj.map (Opposite.op u_Ω)) := by
      intro P hInjP
      let η_P := CategoryTheory.toSheafify S_R.smallEtaleTopology P
      have hBij_T := hSheafifyBijOfTopSieve S_R T_R hTop_TR P
      have hBij_U := hSheafifyBijOfTopSieve S_R U_Ω hTop_UΩ P
      have hnat := η_P.naturality (Opposite.op u_Ω)
      intro a b hab
      obtain ⟨x, rfl⟩ := hBij_T.2 a
      obtain ⟨y, rfl⟩ := hBij_T.2 b
      have hx_nat : (η_P.app (Opposite.op U_Ω)) ((P.map (Opposite.op u_Ω)) x) =
          (((CategoryTheory.presheafToSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj
            P).obj.map (Opposite.op u_Ω)) ((η_P.app (Opposite.op T_R)) x) :=
        congrArg (fun m => m x) hnat
      have hy_nat : (η_P.app (Opposite.op U_Ω)) ((P.map (Opposite.op u_Ω)) y) =
          (((CategoryTheory.presheafToSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj
            P).obj.map (Opposite.op u_Ω)) ((η_P.app (Opposite.op T_R)) y) :=
        congrArg (fun m => m y) hnat
      have hxy_U : (η_P.app (Opposite.op U_Ω)) ((P.map (Opposite.op u_Ω)) x) =
          (η_P.app (Opposite.op U_Ω)) ((P.map (Opposite.op u_Ω)) y) :=
        hx_nat.trans (hab.trans hy_nat.symm)
      exact congrArg (η_P.app (Opposite.op T_R)) (hInjP (hBij_U.1 hxy_U))
    let F_XR := weilEtaleTorsionSheaf X_R m_mod
    let B_fR := weilEtaleSitePullback f_R
    let P_R : (S_R.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := B_fR.op ⋙ F_XR.cohomologyPresheaf r_d
    apply hShMapInj P_R
    let W₁ : X_R.Etale := B_fR.obj U_Ω
    let W₂ : X_R.Etale := B_fR.obj T_R
    let g_et : W₁ ⟶ W₂ := B_fR.map u_Ω
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget X_R
    let W₁_sch : AlgebraicGeometry.Scheme.{u} := (Fgt.obj W₁).left
    let W₂_sch : AlgebraicGeometry.Scheme.{u} := (Fgt.obj W₂).left
    let g_left : W₁_sch ⟶ W₂_sch := (Fgt.map g_et).left
    obtain ⟨Θ, hΘ_nat⟩ := hAltSlice X_R m_mod r_d
    obtain ⟨p_g, hp_g⟩ := hTorsPull.1 g_left m_mod r_d
    have hBijPullIso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (e : Y₁ ≅ Y₂)
        (p_hom : weilEtaleTorsionH Y₂ m_mod r_d →+ weilEtaleTorsionH Y₁ m_mod r_d),
        WeilIsTorsionEtalePullback e.hom m_mod r_d p_hom →
        Function.Bijective p_hom := by
      intro Y₁ Y₂ e p_hom hp_hom
      obtain ⟨p_inv, hp_inv⟩ := hTorsPull.1 e.inv m_mod r_d
      have hid₁ : WeilIsTorsionEtalePullback (e.hom ≫ e.inv) m_mod r_d (AddMonoidHom.id _) := by
        obtain ⟨p_id₁, hp_id₁⟩ := hTorsPull.1 (e.hom ≫ e.inv) m_mod r_d
        have h_eq := hTorsPull.2.1 m_mod r_d p_id₁ (e.hom_inv_id ▸ hp_id₁)
        rwa [h_eq] at hp_id₁
      have hid₂ : WeilIsTorsionEtalePullback (e.inv ≫ e.hom) m_mod r_d (AddMonoidHom.id _) := by
        obtain ⟨p_id₂, hp_id₂⟩ := hTorsPull.1 (e.inv ≫ e.hom) m_mod r_d
        have h_eq := hTorsPull.2.1 m_mod r_d p_id₂ (e.inv_hom_id ▸ hp_id₂)
        rwa [h_eq] at hp_id₂
      have hcomp₁ : AddMonoidHom.id _ = p_hom.comp p_inv :=
        hTorsPull.2.2.1 e.hom e.inv m_mod r_d p_hom p_inv (AddMonoidHom.id _) hp_hom hp_inv hid₁
      have hcomp₂ : AddMonoidHom.id _ = p_inv.comp p_hom :=
        hTorsPull.2.2.1 e.inv e.hom m_mod r_d p_inv p_hom (AddMonoidHom.id _) hp_inv hp_hom hid₂
      exact ⟨fun a b hab => by
          have h := congrArg p_inv hab
          have ha := DFunLike.congr_fun hcomp₂.symm a
          have hb := DFunLike.congr_fun hcomp₂.symm b
          exact ha.symm.trans (h.trans hb),
        fun y => ⟨p_inv y, DFunLike.congr_fun hcomp₁.symm y⟩⟩
    let e_pb_id : CategoryTheory.Limits.pullback (𝟙 S_R) f_R ≅ X_R :=
      { hom := CategoryTheory.Limits.pullback.snd (𝟙 S_R) f_R
        inv := CategoryTheory.Limits.pullback.lift f_R (𝟙 X_R)
          ((CategoryTheory.Category.comp_id f_R).trans
            (CategoryTheory.Category.id_comp f_R).symm)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
    let e_W₂ : W₂_sch ≅ X_R := e_pb_id
    let e_sym : W₁_sch ≅ CategoryTheory.Limits.pullback f_R j_R :=
      CategoryTheory.Limits.pullbackSymmetry j_R f_R
    let j_X := CategoryTheory.Limits.pullback.fst f_R j_R
    have hg_π : g_left ≫ e_W₂.hom = CategoryTheory.Limits.pullback.snd j_R f_R :=
      (Fgt.map g_et).w
    have h_sq_eq : g_left ≫ e_W₂.hom = e_sym.hom ≫ j_X :=
      hg_π.trans (CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst j_R f_R).symm
    obtain ⟨p_W₂, hp_W₂⟩ := hTorsPull.1 e_W₂.hom m_mod r_d
    obtain ⟨p_sym, hp_sym⟩ := hTorsPull.1 e_sym.hom m_mod r_d
    obtain ⟨ψ_r, hψ_r⟩ := hTorsPull.1 j_X m_mod r_d
    obtain ⟨p_comp, hp_comp⟩ := hTorsPull.1 (g_left ≫ e_W₂.hom) m_mod r_d
    have hc₁ : p_comp = p_g.comp p_W₂ :=
      hTorsPull.2.2.1 g_left e_W₂.hom m_mod r_d p_g p_W₂ p_comp hp_g hp_W₂ hp_comp
    have hc₂ : p_comp = p_sym.comp ψ_r :=
      hTorsPull.2.2.1 e_sym.hom j_X m_mod r_d p_sym ψ_r p_comp hp_sym hψ_r (h_sq_eq ▸ hp_comp)
    have hBij_W₂ : Function.Bijective p_W₂ := hBijPullIso e_W₂ p_W₂ hp_W₂
    have hBij_sym : Function.Bijective p_sym := hBijPullIso e_sym p_sym hp_sym
    have hInj_ψ : Function.Injective ψ_r := hInj_jX₀ ψ_r hψ_r
    have hInj_pg : Function.Injective p_g := by
      intro x y hxy
      obtain ⟨a, rfl⟩ := hBij_W₂.2 x
      obtain ⟨b, rfl⟩ := hBij_W₂.2 y
      have ha : p_g (p_W₂ a) = p_sym (ψ_r a) :=
        DFunLike.congr_fun (hc₁.symm.trans hc₂) a
      have hb : p_g (p_W₂ b) = p_sym (ψ_r b) :=
        DFunLike.congr_fun (hc₁.symm.trans hc₂) b
      have hab : p_sym (ψ_r a) = p_sym (ψ_r b) :=
        ha.symm.trans (hxy.trans hb)
      exact congrArg p_W₂ (hInj_ψ (hBij_sym.1 hab))
    intro z₁ z₂ hz
    have hz₁ := hΘ_nat g_et p_g hp_g z₁
    have hz₂ := hΘ_nat g_et p_g hp_g z₂
    have hθ_eq : p_g (Θ W₂ z₁) = p_g (Θ W₂ z₂) :=
      hz₁.symm.trans ((congrArg (Θ W₁) hz).trans hz₂)
    exact (Θ W₂).injective (hInj_pg hθ_eq)

  
  intro U_line s₀ Ω η G_r Fℤ_U ψ hZero_η I_s hPB_Is
  let P := Polynomial k
