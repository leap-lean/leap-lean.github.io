          rw [MvPolynomial.aeval_X]
          rfl
      intro p
      rw [P_pre₀.algebraMap_apply]
      exact congrArg (fun h => h p) h_aeval
    have hJac_unit₀ : IsUnit P_pre₀.jacobian := by
      rw [P_pre₀.jacobian_eq_jacobiMatrix_det, halg_pre₀_apply, hJ_mat₀_eq, isUnit_iff_exists_inv]
      refine ⟨Ideal.Quotient.mk J₀ h₀_poly, ?_⟩
      rw [← map_mul, ← sub_eq_zero]
      have hmk1 : (1 : MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) =
          Ideal.Quotient.mk J₀ 1 := rfl
      rw [hmk1, ← map_sub, ← hBezout₀, map_sum]
      refine Finset.sum_eq_zero fun s _ => ?_
      have hs_mem : R₀ s ∈ J₀ := Ideal.subset_span ⟨s, rfl⟩
      rw [map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hs_mem, mul_zero]
    let P_sub₀ : Algebra.SubmersivePresentation ↑(D_poly.obj i₀)
        (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) (Fin n) (Fin r) :=
      { __ := P_pre₀, jacobian_isUnit := hJac_unit₀ }
    have hStd₀ : Algebra.IsStandardSmoothOfRelativeDimension 0 ↑(D_poly.obj i₀)
        (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) :=
      P_sub₀.isStandardSmoothOfRelativeDimension hdim₀
    have hEt_Q₀ : Algebra.Etale ↑(D_poly.obj i₀)
        (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) :=
      @Algebra.instEtaleOfIsStandardSmoothOfRelativeDimensionOfNatNat _ _ _ _ _ hStd₀
    have hf₀_et : f₀.hom.Etale := by
      have halg_Q₀ : algebraMap (↑(D_poly.obj i₀))
          (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) = f₀.hom := rfl
      rw [← halg_Q₀, RingHom.etale_algebraMap]
      exact hEt_Q₀
    let φ_inf : MvPolynomial (Fin n) ↑c_poly.pt →+* ↑E_inf := (MvPolynomial.aeval P₀.val).toRingHom
    have hφ_ri : Function.RightInverse P₀.σ' ⇑φ_inf := fun x_e => P₀.aeval_val_σ' x_e
    have hker_φ : RingHom.ker φ_inf = Ideal.span (Set.range R_inf) := by
      change RingHom.ker (MvPolynomial.aeval P₀.val) = Ideal.span (Set.range P₀.relation)
      rw [← P₀.ker_eq_ker_aeval_val, P₀.span_range_relation_eq_ker]
    have hR₀_map_inf : ∀ s : Fin r,
        MvPolynomial.map (c_poly.ι.app i₀).hom (R₀ s) = R_inf s := by
      intro s
      dsimp [R₀]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_poly.w θ_jac, hR_tilde s]
    have hJ₀_le : J₀ ≤ RingHom.ker (φ_inf.comp (MvPolynomial.map (c_poly.ι.app i₀).hom)) := by
      rw [Ideal.span_le]
      intro x_p hx
      obtain ⟨s, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hR₀_map_inf s]
      exact RingHom.mem_ker.mp (hker_φ.symm ▸ Ideal.subset_span ⟨s, rfl⟩)
    have hJ₀_zero : ∀ a ∈ J₀,
        (φ_inf.comp (MvPolynomial.map (c_poly.ι.app i₀).hom)) a = 0 :=
      fun a ha => hJ₀_le ha
    let g₀_bar : (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) →+* ↑E_inf :=
      Ideal.Quotient.lift J₀ (φ_inf.comp (MvPolynomial.map (c_poly.ι.app i₀).hom)) hJ₀_zero
    have hg₀_mk : ∀ p : MvPolynomial (Fin n) ↑(D_poly.obj i₀),
        g₀_bar (Ideal.Quotient.mk J₀ p) =
          φ_inf (MvPolynomial.map (c_poly.ι.app i₀).hom p) :=
      fun _ => Ideal.Quotient.lift_mk J₀
        (φ_inf.comp (MvPolynomial.map (c_poly.ι.app i₀).hom)) hJ₀_zero
    let g₀ : CommRingCat.of (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) ⟶ E_inf :=
      CommRingCat.ofHom g₀_bar
    have hw_push : c_poly.ι.app i₀ ≫ f_E = f₀ ≫ g₀ := by
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro b
      change f_E.hom ((c_poly.ι.app i₀).hom b) = g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.C b))
      rw [hg₀_mk, MvPolynomial.map_C]
      dsimp [φ_inf]
      rw [MvPolynomial.aeval_C, halg_fE]
    let ψ_of : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_poly.ι.app i₀) f₀),
        MvPolynomial (Fin n) ↑c_poly.pt →+* ↑s.pt :=
      fun s => MvPolynomial.eval₂Hom s.inl.hom
        (fun k_v => s.inr.hom (Ideal.Quotient.mk J₀ (MvPolynomial.X k_v)))
    have hψ_comp : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_poly.ι.app i₀) f₀),
        (ψ_of s).comp (MvPolynomial.map (c_poly.ι.app i₀).hom) =
          s.inr.hom.comp (Ideal.Quotient.mk J₀) := by
      intro s
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [RingHom.comp_apply, MvPolynomial.map_C, ψ_of, MvPolynomial.eval₂Hom_C]
        exact congrArg (fun k_h => k_h.hom b) s.condition
      · intro k_v
        simp only [RingHom.comp_apply, MvPolynomial.map_X, ψ_of, MvPolynomial.eval₂Hom_X']
    have hker_le_ψ : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_poly.ι.app i₀) f₀),
        RingHom.ker φ_inf ≤ RingHom.ker (ψ_of s) := by
      intro s
      rw [hker_φ, Ideal.span_le]
      intro x_p hx
      obtain ⟨t, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, ← hR₀_map_inf t]
      have h1 := congrArg (fun h => h (R₀ t)) (hψ_comp s)
      simp only [RingHom.comp_apply] at h1
      have ht_mem : R₀ t ∈ J₀ := Ideal.subset_span ⟨t, rfl⟩
      rw [h1, Ideal.Quotient.eq_zero_iff_mem.mpr ht_mem, map_zero]
    let desc_hom : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_poly.ι.app i₀) f₀),
        ↑E_inf →+* ↑s.pt :=
      fun s => φ_inf.liftOfRightInverse P₀.σ' hφ_ri ⟨ψ_of s, hker_le_ψ s⟩
    have hdesc_φ : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_poly.ι.app i₀) f₀)
        (p : MvPolynomial (Fin n) ↑c_poly.pt),
        desc_hom s (φ_inf p) = ψ_of s p :=
      fun s p => RingHom.liftOfRightInverse_comp_apply φ_inf P₀.σ' hφ_ri ⟨ψ_of s, hker_le_ψ s⟩ p
    refine ⟨i₀, CommRingCat.of (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀), f₀, g₀, hf₀_et, ?_⟩
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_push
        (fun s => CommRingCat.ofHom (desc_hom s)) ?_ ?_ ?_)
    · intro s
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro a
      change desc_hom s (f_E.hom a) = s.inl.hom a
      have hfE_a : f_E.hom a = φ_inf (MvPolynomial.C a) := by
        dsimp [φ_inf]
        rw [MvPolynomial.aeval_C, halg_fE]
      rw [hfE_a, hdesc_φ]
      exact MvPolynomial.eval₂Hom_C _ _ a
    · intro s
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      change desc_hom s (g₀_bar (Ideal.Quotient.mk J₀ p)) =
        s.inr.hom (Ideal.Quotient.mk J₀ p)
      rw [hg₀_mk, hdesc_φ]
      exact congrArg (fun h => h p) (hψ_comp s)
    · intro s m hm_inl hm_inr
      have hm_comp : m.hom.comp φ_inf = ψ_of s := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_C]
          dsimp [φ_inf]
          rw [MvPolynomial.aeval_C, halg_fE]
          exact congrArg (fun k_h => k_h.hom a) hm_inl
        · intro k_v
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_X']
          have hXk : φ_inf (MvPolynomial.X k_v) =
              g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.X k_v)) := by
            rw [hg₀_mk, MvPolynomial.map_X]
          rw [hXk]
          exact congrArg (fun h => h.hom (Ideal.Quotient.mk J₀ (MvPolynomial.X k_v))) hm_inr
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro e_el
      change m.hom e_el = desc_hom s e_el
      have he := hφ_ri e_el
      conv_lhs => rw [← he]
      conv_rhs => rw [← he]
      have hlhs : m.hom (φ_inf (P₀.σ' e_el)) = (ψ_of s) (P₀.σ' e_el) :=
        congrArg (fun h => h (P₀.σ' e_el)) hm_comp
      rw [hlhs, hdesc_φ]

  
  
  
  let 𝒥 : Type u := CategoryTheory.Under i₀
  let hCat : CategoryTheory.SmallCategory 𝒥 := inferInstance
  let hFilt : CategoryTheory.IsFiltered 𝒥 := CategoryTheory.IsFiltered.under i₀
  refine ⟨𝒥, hCat, hFilt, ?_⟩
  let _ : CategoryTheory.SmallCategory 𝒥 := hCat
  let _ : CategoryTheory.IsFiltered 𝒥 := hFilt

  
  obtain ⟨E_diag, f_stage, c_E, hc_E, ι_inf_cE, e_W, x_inf,
      hf_stage_nat, hf_stage_et, hx_E_colim, hLoc_cE, he_comm_cE⟩ :
      ∃ (E_diag : 𝒥 ⥤ CommRingCat.{u})
        (f_stage : ∀ j : 𝒥, D_poly.obj j.right ⟶ E_diag.obj j)
        (c_E : CategoryTheory.Limits.Cocone E_diag)
        (_ : CategoryTheory.Limits.IsColimit c_E)
        (ι_inf_cE : c_E.pt ⟶ E_inf_loc)
        (e_W : AlgebraicGeometry.Spec c_E.pt ≅ W)
        (x_inf : ↑c_E.pt),
        (∀ {j j' : 𝒥} (φ : j ⟶ j'),
          f_stage j ≫ E_diag.map φ = D_poly.map φ.right ≫ f_stage j') ∧
        (∀ j : 𝒥, (f_stage j).hom.Etale) ∧
        (∀ j : 𝒥,
          (c_E.ι.app j).hom
            ((f_stage j).hom ((ι_D.app j.right).hom ((α.app j.right).hom Polynomial.X))) =
            x_inf) ∧
        @IsLocalization.Away ↑c_E.pt _ x_inf ↑E_inf_loc _ ι_inf_cE.hom.toAlgebra ∧
        (e_WU₀.hom ≫ CategoryTheory.Limits.pullback.snd j_A w =
          AlgebraicGeometry.Spec.map ι_inf_cE ≫ e_W.hom) := by
    let E_diag : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := fun j => CategoryTheory.Limits.pushout (D_poly.map j.hom) f₀
        map := fun {j j'} φ =>
          CategoryTheory.Limits.pushout.desc
            (D_poly.map φ.right ≫ CategoryTheory.Limits.pushout.inl (D_poly.map j'.hom) f₀)
            (CategoryTheory.Limits.pushout.inr (D_poly.map j'.hom) f₀)
            (by
              rw [← Category.assoc, ← D_poly.map_comp, CategoryTheory.Under.w φ]
              exact CategoryTheory.Limits.pushout.condition)
        map_id := fun j => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Under.id_right,
              D_poly.map_id, Category.id_comp, Category.comp_id]
          · rw [CategoryTheory.Limits.pushout.inr_desc, Category.comp_id]
        map_comp := fun {j₁ j₂ j₃} φ ψ => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Under.comp_right,
              D_poly.map_comp, Category.assoc, ← Category.assoc (CategoryTheory.Limits.pushout.inl _ _),
              CategoryTheory.Limits.pushout.inl_desc, Category.assoc,
              CategoryTheory.Limits.pushout.inl_desc]
          · rw [CategoryTheory.Limits.pushout.inr_desc, ← Category.assoc,
              CategoryTheory.Limits.pushout.inr_desc, CategoryTheory.Limits.pushout.inr_desc] }

    let f_stage : ∀ j : 𝒥, D_poly.obj j.right ⟶ E_diag.obj j :=
      fun j => CategoryTheory.Limits.pushout.inl (D_poly.map j.hom) f₀

    have hf_stage_nat : ∀ {j j' : 𝒥} (φ : j ⟶ j'),
        f_stage j ≫ E_diag.map φ = D_poly.map φ.right ≫ f_stage j' := by
      intro j j' φ
      exact CategoryTheory.Limits.pushout.inl_desc _ _ _

    have hf_stage_et : ∀ j : 𝒥, (f_stage j).hom.Etale := by
      intro j
      have hEt_f₀ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f₀) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf₀_et
      have hPb_push := AlgebraicGeometry.isPullback_SpecMap_pushout (D_poly.map j.hom) f₀
      have hEt_inl : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f_stage j)) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_push.flip hEt_f₀
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_inl

    let c_E : CategoryTheory.Limits.Cocone E_diag :=
      { pt := E_inf
        ι :=
          { app := fun j =>
              CategoryTheory.Limits.pushout.desc (c_poly.ι.app j.right ≫ f_E) g₀
                (by rw [← Category.assoc, c_poly.w j.hom, hPush₀.w])
            naturality := fun {j j'} φ => by
              dsimp [E_diag]
              rw [Category.comp_id]
              apply CategoryTheory.Limits.pushout.hom_ext
              · rw [← Category.assoc, CategoryTheory.Limits.pushout.inl_desc, Category.assoc,
                  CategoryTheory.Limits.pushout.inl_desc, ← Category.assoc, c_poly.w φ.right,
                  CategoryTheory.Limits.pushout.inl_desc]
              · rw [← Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
                  CategoryTheory.Limits.pushout.inr_desc, CategoryTheory.Limits.pushout.inr_desc] } }

    have _ : (CategoryTheory.Under.forget i₀).Final := CategoryTheory.Under.final_forget i₀
    let hc_poly_under :
        CategoryTheory.Limits.IsColimit (c_poly.whisker (CategoryTheory.Under.forget i₀)) :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv
        (CategoryTheory.Under.forget i₀) c_poly).symm hc_poly

    let j_init : 𝒥 := CategoryTheory.Under.mk (𝟙 i₀)
    let s_B_of : CategoryTheory.Limits.Cocone E_diag →
        CategoryTheory.Limits.Cocone (CategoryTheory.Under.forget i₀ ⋙ D_poly) :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun j => f_stage j ≫ s.ι.app j
              naturality := fun {j j'} φ => by
                dsimp
                rw [Category.comp_id, ← Category.assoc, ← hf_stage_nat φ,
                  Category.assoc, s.w φ] } }

    have hinr_s_eq : ∀ (s : CategoryTheory.Limits.Cocone E_diag) (j : 𝒥),
        CategoryTheory.Limits.pushout.inr (D_poly.map j.hom) f₀ ≫ s.ι.app j =
          CategoryTheory.Limits.pushout.inr (D_poly.map (𝟙 i₀)) f₀ ≫ s.ι.app j_init := by
      intro s j
      let φ_j : j_init ⟶ j := CategoryTheory.Under.homMk j.hom (Category.id_comp j.hom)
      calc
        CategoryTheory.Limits.pushout.inr (D_poly.map j.hom) f₀ ≫ s.ι.app j =
            (CategoryTheory.Limits.pushout.inr (D_poly.map (𝟙 i₀)) f₀ ≫ E_diag.map φ_j) ≫
              s.ι.app j := by
          dsimp [E_diag]
          rw [CategoryTheory.Limits.pushout.inr_desc]
        _ = CategoryTheory.Limits.pushout.inr (D_poly.map (𝟙 i₀)) f₀ ≫ s.ι.app j_init := by
          rw [Category.assoc, s.w φ_j]

    have hu_E_comm : ∀ s : CategoryTheory.Limits.Cocone E_diag,
        c_poly.ι.app i₀ ≫ hc_poly_under.desc (s_B_of s) =
          f₀ ≫ (CategoryTheory.Limits.pushout.inr (D_poly.map (𝟙 i₀)) f₀ ≫ s.ι.app j_init) := by
      intro s
      have hfac := hc_poly_under.fac (s_B_of s) j_init
      change c_poly.ι.app i₀ ≫ hc_poly_under.desc (s_B_of s) =
        f_stage j_init ≫ s.ι.app j_init at hfac
      rw [hfac]
      dsimp [f_stage, j_init]
      have hid_inl : D_poly.map (𝟙 i₀) ≫
          CategoryTheory.Limits.pushout.inl (D_poly.map (𝟙 i₀)) f₀ =
          CategoryTheory.Limits.pushout.inl (D_poly.map (𝟙 i₀)) f₀ := by
        conv_lhs =>
          lhs
          rw [D_poly.map_id]
        exact Category.id_comp _
      calc
        CategoryTheory.Limits.pushout.inl (D_poly.map (𝟙 i₀)) f₀ ≫ s.ι.app j_init =
            (D_poly.map (𝟙 i₀) ≫ CategoryTheory.Limits.pushout.inl (D_poly.map (𝟙 i₀)) f₀) ≫
              s.ι.app j_init := by
          rw [hid_inl]
        _ = f₀ ≫ (CategoryTheory.Limits.pushout.inr (D_poly.map (𝟙 i₀)) f₀ ≫ s.ι.app j_init) := by
          rw [CategoryTheory.Limits.pushout.condition, Category.assoc]

    let hc_E : CategoryTheory.Limits.IsColimit c_E :=
      { desc := fun s =>
          hPush₀.desc (hc_poly_under.desc (s_B_of s))
            (CategoryTheory.Limits.pushout.inr (D_poly.map (𝟙 i₀)) f₀ ≫ s.ι.app j_init)
            (hu_E_comm s)
        fac := fun s j => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [← Category.assoc]
            change (f_stage j ≫ c_E.ι.app j) ≫ _ = f_stage j ≫ s.ι.app j
            dsimp [c_E, f_stage]
            rw [CategoryTheory.Limits.pushout.inl_desc, Category.assoc, hPush₀.inl_desc]
            exact hc_poly_under.fac (s_B_of s) j
          · rw [← Category.assoc]
            dsimp [c_E]
            rw [CategoryTheory.Limits.pushout.inr_desc, hPush₀.inr_desc]
            exact (hinr_s_eq s j).symm
        uniq := fun s m hm => by
          apply hPush₀.hom_ext
          · rw [hPush₀.inl_desc]
            apply hc_poly_under.uniq (s_B_of s)
            intro j
            change c_poly.ι.app j.right ≫ f_E ≫ m = f_stage j ≫ s.ι.app j
            rw [← Category.assoc]
            have hinl : c_poly.ι.app j.right ≫ f_E = f_stage j ≫ c_E.ι.app j :=
              (CategoryTheory.Limits.pushout.inl_desc _ _ _).symm
            rw [hinl, Category.assoc, hm j]
          · rw [hPush₀.inr_desc]
            have hinr : g₀ =
                CategoryTheory.Limits.pushout.inr (D_poly.map (𝟙 i₀)) f₀ ≫ c_E.ι.app j_init :=
              (CategoryTheory.Limits.pushout.inr_desc _ _ _).symm
            rw [hinr, Category.assoc, hm j_init] }

    have hx_E_colim : ∀ j : 𝒥,
        (c_E.ι.app j).hom
          ((f_stage j).hom ((ι_D.app j.right).hom ((α.app j.right).hom Polynomial.X))) =
          f_E.hom t_poly := by
      intro j
      have h1 : f_stage j ≫ c_E.ι.app j = c_poly.ι.app j.right ≫ f_E :=
        CategoryTheory.Limits.pushout.inl_desc _ _ _
      have h2 := congrArg
        (fun f => f.hom ((ι_D.app j.right).hom ((α.app j.right).hom Polynomial.X))) h1
      change (c_E.ι.app j).hom
          ((f_stage j).hom ((ι_D.app j.right).hom ((α.app j.right).hom Polynomial.X))) =
        f_E.hom ((c_poly.ι.app j.right).hom
          ((ι_D.app j.right).hom ((α.app j.right).hom Polynomial.X))) at h2
      rw [h2, ht_colim j.right]

    exact ⟨E_diag, f_stage, c_E, hc_E, ι_inf₀, e_W₀, f_E.hom t_poly,
      hf_stage_nat, hf_stage_et, hx_E_colim, hLoc_inf, he_comm₀⟩

  
  obtain ⟨E_loc, ι_loc, c_Eloc, hc_Eloc, ι_inf, e_WU, hι_comm, he_comm, hLoc_stage⟩ :
      ∃ (E_loc : 𝒥 ⥤ CommRingCat.{u})
        (ι_loc : E_diag ⟶ E_loc)
        (c_Eloc : CategoryTheory.Limits.Cocone E_loc)
        (_ : CategoryTheory.Limits.IsColimit c_Eloc)
        (ι_inf : c_E.pt ⟶ c_Eloc.pt)
        (e_WU : AlgebraicGeometry.Spec c_Eloc.pt ≅ CategoryTheory.Limits.pullback j_A w),
        (∀ j : 𝒥, c_E.ι.app j ≫ ι_inf = ι_loc.app j ≫ c_Eloc.ι.app j) ∧
        (e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_A w =
          AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom) ∧
        (∀ j : 𝒥,
          @IsLocalization.Away ↑(E_diag.obj j) _
            ((f_stage j).hom ((ι_D.app j.right).hom ((α.app j.right).hom Polynomial.X)))
            ↑(E_loc.obj j) _ (ι_loc.app j).hom.toAlgebra) := by
    let j_init : 𝒥 := CategoryTheory.Under.mk (𝟙 i₀)
    let x_poly : ∀ i : ℐ, ↑(D_poly.obj i) :=
      fun i => (ι_D.app i).hom ((α.app i).hom Polynomial.X)
    have hx_poly_map : ∀ {i i' : ℐ} (θ : i ⟶ i'),
        (D_poly.map θ).hom (x_poly i) = x_poly i' := by
      intro i i' θ
      dsimp [x_poly]
      have h1 := congrArg (fun f => f.hom ((α.app i).hom Polynomial.X)) (ι_D.naturality θ).symm
      change (D_poly.map θ).hom ((ι_D.app i).hom ((α.app i).hom Polynomial.X)) =
        (ι_D.app i').hom ((D.map θ).hom ((α.app i).hom Polynomial.X)) at h1
      rw [h1]
      have h2 := congrArg (fun f => f.hom Polynomial.X) (hα_nat θ)
      exact congrArg (ι_D.app i').hom h2

    let x_E : ∀ j : 𝒥, ↑(E_diag.obj j) := fun j => (f_stage j).hom (x_poly j.right)
    have hx_E_map : ∀ {j j' : 𝒥} (φ : j ⟶ j'),
        (E_diag.map φ).hom (x_E j) = x_E j' := by
      intro j j' φ
      dsimp [x_E]
      have h1 := congrArg (fun f => f.hom (x_poly j.right)) (hf_stage_nat φ)
      change (E_diag.map φ).hom ((f_stage j).hom (x_poly j.right)) =
        (f_stage j').hom ((D_poly.map φ.right).hom (x_poly j.right)) at h1
      rw [h1, hx_poly_map φ.right]

    
    obtain ⟨E_loc_obj, ι_loc_app, hLoc_stage⟩ :
        ∃ (E_loc_obj : 𝒥 → CommRingCat.{u})
          (ι_loc_app : ∀ j : 𝒥, E_diag.obj j ⟶ E_loc_obj j),
          ∀ j : 𝒥,
            @IsLocalization.Away ↑(E_diag.obj j) _ (x_E j) ↑(E_loc_obj j) _
              (ι_loc_app j).hom.toAlgebra :=
      ⟨fun j => CommRingCat.of (Localization.Away (x_E j)),
        fun j => CommRingCat.ofHom (algebraMap (↑(E_diag.obj j)) (Localization.Away (x_E j))),
        fun j => hToAlgAway (↑(E_diag.obj j)) (x_E j)⟩

    let _ : ∀ j : 𝒥, Algebra ↑(E_diag.obj j) ↑(E_loc_obj j) :=
      fun j => (ι_loc_app j).hom.toAlgebra
    have _ : ∀ j : 𝒥, IsLocalization.Away (x_E j) ↑(E_loc_obj j) := hLoc_stage
    let _ : Algebra ↑c_E.pt ↑E_inf_loc := ι_inf_cE.hom.toAlgebra
    have _ : IsLocalization.Away x_inf ↑E_inf_loc := hLoc_cE

    have hUnit_Eloc_map : ∀ {j j' : 𝒥} (φ : j ⟶ j'),
        IsUnit (((ι_loc_app j').hom.comp (E_diag.map φ).hom) (x_E j)) := by
      intro j j' φ
      change IsUnit (algebraMap (↑(E_diag.obj j')) (↑(E_loc_obj j'))
        ((E_diag.map φ).hom (x_E j)))
      rw [hx_E_map φ]
      exact IsLocalization.Away.algebraMap_isUnit (S := ↑(E_loc_obj j')) (x_E j')

    let map_hom : ∀ {j j' : 𝒥} (φ : j ⟶ j'), ↑(E_loc_obj j) →+* ↑(E_loc_obj j') :=
      fun {j j'} φ =>
        IsLocalization.Away.lift (x_E j)
          (g := (ι_loc_app j').hom.comp (E_diag.map φ).hom) (hUnit_Eloc_map φ)

    have hmap_hom_eq : ∀ {j j' : 𝒥} (φ : j ⟶ j') (a : ↑(E_diag.obj j)),
        map_hom φ ((ι_loc_app j).hom a) = (ι_loc_app j').hom ((E_diag.map φ).hom a) :=
      fun {j _} φ a => IsLocalization.Away.lift_eq (x_E j) (hUnit_Eloc_map φ) a

    let E_loc : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := E_loc_obj
        map := fun φ => CommRingCat.ofHom (map_hom φ)
        map_id := fun j => by
          apply CommRingCat.Hom.ext
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_E j))
          apply RingHom.ext
          intro a
          change map_hom (𝟙 j) ((ι_loc_app j).hom a) = (ι_loc_app j).hom a
          rw [hmap_hom_eq, E_diag.map_id]
          rfl
        map_comp := fun {j₁ j₂ j₃} φ ψ => by
          apply CommRingCat.Hom.ext
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_E j₁))
          apply RingHom.ext
          intro a
          change map_hom (φ ≫ ψ) ((ι_loc_app j₁).hom a) =
            map_hom ψ (map_hom φ ((ι_loc_app j₁).hom a))
          rw [hmap_hom_eq, hmap_hom_eq, hmap_hom_eq, E_diag.map_comp]
          rfl }

    let ι_loc : E_diag ⟶ E_loc :=
      { app := ι_loc_app
        naturality := fun {j j'} φ => by
          apply CommRingCat.Hom.ext
          apply RingHom.ext
          intro a
          exact (hmap_hom_eq φ a).symm }

    have hUnit_Eloc_colim : ∀ j : 𝒥,
        IsUnit ((ι_inf_cE.hom.comp (c_E.ι.app j).hom) (x_E j)) := by
      intro j
      change IsUnit (algebraMap (↑c_E.pt) (↑E_inf_loc) ((c_E.ι.app j).hom (x_E j)))
      rw [hx_E_colim j]
      exact IsLocalization.Away.algebraMap_isUnit (S := ↑E_inf_loc) x_inf

    let colim_leg_hom : ∀ j : 𝒥, ↑(E_loc_obj j) →+* ↑E_inf_loc :=
      fun j => IsLocalization.Away.lift (x_E j)
        (g := ι_inf_cE.hom.comp (c_E.ι.app j).hom) (hUnit_Eloc_colim j)

    have hcolim_leg_eq : ∀ (j : 𝒥) (a : ↑(E_diag.obj j)),
        colim_leg_hom j ((ι_loc_app j).hom a) = ι_inf_cE.hom ((c_E.ι.app j).hom a) :=
      fun j a => IsLocalization.Away.lift_eq (x_E j) (hUnit_Eloc_colim j) a

    let c_Eloc : CategoryTheory.Limits.Cocone E_loc :=
      { pt := E_inf_loc
        ι :=
          { app := fun j => CommRingCat.ofHom (colim_leg_hom j)
            naturality := fun {j j'} φ => by
              dsimp [E_loc]
              rw [Category.comp_id]
              apply CommRingCat.Hom.ext
              apply IsLocalization.ringHom_ext (Submonoid.powers (x_E j))
              apply RingHom.ext
              intro a
              change colim_leg_hom j' (map_hom φ ((ι_loc_app j).hom a)) =
                colim_leg_hom j ((ι_loc_app j).hom a)
              rw [hmap_hom_eq, hcolim_leg_eq, hcolim_leg_eq]
              exact congrArg ι_inf_cE.hom (congrArg (fun f => f.hom a) (c_E.w φ)) } }

    have hι_comm : ∀ j : 𝒥, c_E.ι.app j ≫ ι_inf_cE = ι_loc.app j ≫ c_Eloc.ι.app j := by
      intro j
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro a
      exact (hcolim_leg_eq j a).symm

    let s_E_of : CategoryTheory.Limits.Cocone E_loc → CategoryTheory.Limits.Cocone E_diag :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun j => ι_loc.app j ≫ s.ι.app j
              naturality := fun {j j'} φ => by
                dsimp
                rw [Category.comp_id, ← Category.assoc, ι_loc.naturality φ,
                  Category.assoc, s.w φ] } }

    have hUnit_Eloc_desc : ∀ s : CategoryTheory.Limits.Cocone E_loc,
        IsUnit ((hc_E.desc (s_E_of s)).hom x_inf) := by
      intro s
      rw [← hx_E_colim j_init]
      have hfac := congrArg (fun f => f.hom (x_E j_init)) (hc_E.fac (s_E_of s) j_init)
      change (hc_E.desc (s_E_of s)).hom ((c_E.ι.app j_init).hom (x_E j_init)) =
        (s.ι.app j_init).hom
          (algebraMap (↑(E_diag.obj j_init)) (↑(E_loc_obj j_init)) (x_E j_init)) at hfac
      rw [hfac]
      exact (IsLocalization.Away.algebraMap_isUnit
        (S := ↑(E_loc_obj j_init)) (x_E j_init)).map (s.ι.app j_init).hom

    let desc_Eloc_hom : ∀ s : CategoryTheory.Limits.Cocone E_loc, ↑E_inf_loc →+* ↑s.pt :=
      fun s => IsLocalization.Away.lift x_inf
        (g := (hc_E.desc (s_E_of s)).hom) (hUnit_Eloc_desc s)

    have hdesc_Eloc_eq : ∀ (s : CategoryTheory.Limits.Cocone E_loc) (e_el : ↑c_E.pt),
        desc_Eloc_hom s (ι_inf_cE.hom e_el) = (hc_E.desc (s_E_of s)).hom e_el :=
      fun s e_el => IsLocalization.Away.lift_eq x_inf (hUnit_Eloc_desc s) e_el

    let hc_Eloc : CategoryTheory.Limits.IsColimit c_Eloc :=
      { desc := fun s => CommRingCat.ofHom (desc_Eloc_hom s)
        fac := fun s j => by
          apply CommRingCat.Hom.ext
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_E j))
          apply RingHom.ext
          intro a
          change desc_Eloc_hom s (colim_leg_hom j ((ι_loc_app j).hom a)) =
            (s.ι.app j).hom ((ι_loc_app j).hom a)
          rw [hcolim_leg_eq, hdesc_Eloc_eq]
          exact congrArg (fun f => f.hom a) (hc_E.fac (s_E_of s) j)
        uniq := fun s m hm => by
          have hm_E : ι_inf_cE ≫ m = hc_E.desc (s_E_of s) := by
            apply hc_E.uniq (s_E_of s)
            intro j
            rw [← Category.assoc, hι_comm j, Category.assoc, hm j]
          apply CommRingCat.Hom.ext
          apply IsLocalization.ringHom_ext (Submonoid.powers x_inf)
          apply RingHom.ext
          intro e_el
          change m.hom (ι_inf_cE.hom e_el) = desc_Eloc_hom s (ι_inf_cE.hom e_el)
          rw [hdesc_Eloc_eq]
          exact congrArg (fun f => f.hom e_el) hm_E }

    exact ⟨E_loc, ι_loc, c_Eloc, hc_Eloc, ι_inf_cE, e_WU₀,
      hι_comm, he_comm_cE, hLoc_stage⟩

  refine ⟨E_diag, E_loc, ι_loc, c_E, hc_E, c_Eloc, hc_Eloc, ι_inf, e_W, e_WU,
    hι_comm, he_comm, ?_⟩

  
  
  
  have hLocUnitPow : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S)
      (u₀ : Rˣ) (π₀ : R) (e₀ : ℕ),
      1 ≤ e₀ →
      @IsLocalization.Away R _ (↑u₀ * π₀ ^ e₀) S _ φ.toAlgebra →
      @IsLocalization.Away R _ π₀ S _ φ.toAlgebra := by
    intro R S _ _ φ u₀ π₀ e₀ he₀ hLocX
    let _ : Algebra R S := φ.toAlgebra
    set x₀ : R := ↑u₀ * π₀ ^ e₀
    have _ : IsLocalization.Away x₀ S := hLocX
    have he_eq : e₀ = (e₀ - 1) + 1 := (Nat.sub_add_cancel he₀).symm
    apply @IsLocalization.Away.mk R _ S _ φ.toAlgebra π₀
    · have huX : IsUnit (φ x₀) := IsLocalization.Away.algebraMap_isUnit (S := S) x₀
      have hx_fac : x₀ = π₀ * (↑u₀ * π₀ ^ (e₀ - 1)) := by
        dsimp [x₀]
        conv_lhs => rw [he_eq, pow_succ]
        ring
      rw [hx_fac, map_mul] at huX
      exact isUnit_of_mul_isUnit_left huX
    · intro s
      obtain ⟨⟨a₀, _, ⟨m, rfl⟩⟩, hs⟩ := IsLocalization.surj (M := Submonoid.powers x₀) s
      have hs' : s * φ (x₀ ^ m) = φ a₀ := hs
      have hpow_R : x₀ ^ m * (↑(u₀⁻¹) : R) ^ m = π₀ ^ (e₀ * m) := by
        dsimp [x₀]
        calc
          (↑u₀ * π₀ ^ e₀) ^ m * (↑(u₀⁻¹) : R) ^ m =
              ((↑u₀ : R) * ↑(u₀⁻¹)) ^ m * (π₀ ^ e₀) ^ m := by
            rw [mul_pow, ← mul_pow]
            ring
          _ = π₀ ^ (e₀ * m) := by
            rw [Units.mul_inv u₀, one_pow, one_mul, pow_mul]
      refine ⟨e₀ * m, a₀ * (↑(u₀⁻¹) : R) ^ m, ?_⟩
      change s * (φ π₀) ^ (e₀ * m) = φ (a₀ * (↑(u₀⁻¹) : R) ^ m)
      rw [← map_pow, ← hpow_R, map_mul, ← mul_assoc, hs', ← map_mul]
    · intro a b hab
      obtain ⟨⟨_, m, rfl⟩, hm⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers x₀) S).mp hab
      have hm' : x₀ ^ m * a = x₀ ^ m * b := hm
      have hpow_L : (↑(u₀⁻¹) : R) ^ m * x₀ ^ m = π₀ ^ (e₀ * m) := by
        dsimp [x₀]
        calc
          (↑(u₀⁻¹) : R) ^ m * (↑u₀ * π₀ ^ e₀) ^ m =
              ((↑(u₀⁻¹) : R) * ↑u₀) ^ m * (π₀ ^ e₀) ^ m := by
            rw [mul_pow, ← mul_assoc, ← mul_pow]
          _ = π₀ ^ (e₀ * m) := by
            rw [Units.inv_mul u₀, one_pow, one_mul, pow_mul]
      refine ⟨e₀ * m, ?_⟩
      calc
        π₀ ^ (e₀ * m) * a = ((↑(u₀⁻¹) : R) ^ m * x₀ ^ m) * a := by rw [hpow_L]
        _ = (↑(u₀⁻¹) : R) ^ m * (x₀ ^ m * a) := by ring
        _ = (↑(u₀⁻¹) : R) ^ m * (x₀ ^ m * b) := by rw [hm']
        _ = ((↑(u₀⁻¹) : R) ^ m * x₀ ^ m) * b := by ring
        _ = π₀ ^ (e₀ * m) * b := by rw [hpow_L]

  have hSingleStage : ∀ (j_s : 𝒥) (ϖ_s : ↑(D.obj j_s.right))
      (u_s : (↑(D.obj j_s.right))ˣ) (e_s : ℕ) (ψ_s : Polynomial k →+* ↑(D.obj j_s.right)),
      1 ≤ e_s →
      (α.app j_s.right).hom Polynomial.X = ↑u_s * ϖ_s ^ e_s →
      ψ_s.comp Polynomial.C = (α.app j_s.right).hom.comp Polynomial.C →
      ψ_s Polynomial.X = ϖ_s →
      ψ_s.Etale →
      ∃ (w_s : AlgebraicGeometry.Spec (E_diag.obj j_s) ⟶ Y_d)
        (_ : AlgebraicGeometry.Etale w_s)
        (ϕ_s : AlgebraicGeometry.Spec (E_loc.obj j_s) ≅ CategoryTheory.Limits.pullback j_d w_s),
        ϕ_s.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_s =
          AlgebraicGeometry.Spec.map (ι_loc.app j_s) ∧
        w_s ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map (f_stage j_s) ≫ π_Sd j_s.right ∧
        w_s ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map (f_stage j_s) ≫
            AlgebraicGeometry.Spec.map (ι_D.app j_s.right) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) := by
    intro j_s ϖ_s u_s e_s ψ_s he_s hX_s hψC_s hψX_s hψEt_s
    obtain ⟨v_s, hv_s_et, hv_s_fst, hv_s_snd⟩ := hv_stage j_s.right ψ_s hψC_s hψEt_s
    let _ : AlgebraicGeometry.Etale v_s := hv_s_et
    have hEt_fs : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f_stage j_s)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (hf_stage_et j_s)
    let w_s : AlgebraicGeometry.Spec (E_diag.obj j_s) ⟶ Y_d :=
      AlgebraicGeometry.Spec.map (f_stage j_s) ≫ v_s
    have hw_s_et : AlgebraicGeometry.Etale w_s := by
      dsimp [w_s]
      infer_instance
    have hw_s_fst : w_s ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
        AlgebraicGeometry.Spec.map (f_stage j_s) ≫ π_Sd j_s.right := by
      dsimp [w_s]
      rw [Category.assoc, hv_s_fst]
    have hw_s_snd : w_s ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
        AlgebraicGeometry.Spec.map (f_stage j_s) ≫
          AlgebraicGeometry.Spec.map (ι_D.app j_s.right) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) := by
      dsimp [w_s]
      rw [Category.assoc, hv_s_snd]
    let η_s : ↑(D.obj j_s.right) →+* ↑(E_diag.obj j_s) :=
      (f_stage j_s).hom.comp (ι_D.app j_s.right).hom
    let u_Es : (↑(E_diag.obj j_s))ˣ := Units.map η_s.toMonoidHom u_s
    have hx_Es_eq :
        (f_stage j_s).hom ((ι_D.app j_s.right).hom ((α.app j_s.right).hom Polynomial.X)) =
          ↑u_Es * (η_s ϖ_s) ^ e_s := by
      change η_s ((α.app j_s.right).hom Polynomial.X) = ↑u_Es * (η_s ϖ_s) ^ e_s
      rw [hX_s, map_mul, map_pow]
      rfl
    have hLoc_xEs : @IsLocalization.Away ↑(E_diag.obj j_s) _ (↑u_Es * (η_s ϖ_s) ^ e_s)
        ↑(E_loc.obj j_s) _ (ι_loc.app j_s).hom.toAlgebra := by
      rw [← hx_Es_eq]
      exact hLoc_stage j_s
    have hLoc_ϖs : @IsLocalization.Away ↑(E_diag.obj j_s) _ (η_s ϖ_s)
        ↑(E_loc.obj j_s) _ (ι_loc.app j_s).hom.toAlgebra :=
      hLocUnitPow (ι_loc.app j_s).hom u_Es (η_s ϖ_s) e_s he_s hLoc_xEs
    let ρ_s : CommRingCat.of (Polynomial k) ⟶ E_diag.obj j_s :=
      CommRingCat.ofHom ψ_s ≫ ι_D.app j_s.right ≫ f_stage j_s
    have hρ_s_X : ρ_s.hom Polynomial.X = η_s ϖ_s := by
      change η_s (ψ_s Polynomial.X) = η_s ϖ_s
      rw [hψX_s]
    have hLoc_ρs : @IsLocalization.Away ↑(E_diag.obj j_s) _ (ρ_s.hom Polynomial.X)
        ↑(E_loc.obj j_s) _ (ι_loc.app j_s).hom.toAlgebra := by
      rwa [hρ_s_X]
    obtain ⟨ψ_Gm_s, hPush_Gm_s⟩ :=
      hPushLocAway
        (CommRingCat.ofHom (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X : Polynomial k))))
        ρ_s (ι_loc.app j_s) Polynomial.X
        (hToAlgAway (Polynomial k) Polynomial.X) hLoc_ρs
    have hSpec_ρs : AlgebraicGeometry.Spec.map ρ_s =
        w_s ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 := by
      dsimp [ρ_s]
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        Category.assoc, hw_s_snd]
    have hPb_loc_s_raw := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_Gm_s
    have hPb_loc_s : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map ψ_Gm_s)
        (AlgebraicGeometry.Spec.map (ι_loc.app j_s))
        j_Gm (w_s ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) := by
      rwa [hSpec_ρs] at hPb_loc_s_raw
    have hPb_jd_s : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst j_d w_s ≫
          CategoryTheory.Limits.pullback.fst j_Gm
            (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
        (CategoryTheory.Limits.pullback.snd j_d w_s)
        j_Gm (w_s ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) :=
      (CategoryTheory.IsPullback.of_hasPullback j_d w_s).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback j_Gm
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
    let ϕ_s : AlgebraicGeometry.Spec (E_loc.obj j_s) ≅
        CategoryTheory.Limits.pullback j_d w_s :=
      hPb_loc_s.isoPullback ≪≫ hPb_jd_s.isoPullback.symm
    have hϕ_s : ϕ_s.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_s =
        AlgebraicGeometry.Spec.map (ι_loc.app j_s) := by
      dsimp [ϕ_s]
      rw [Category.assoc, hPb_jd_s.isoPullback_inv_snd, hPb_loc_s.isoPullback_hom_snd]
    exact ⟨w_s, hw_s_et, ϕ_s, hϕ_s, hw_s_fst, hw_s_snd⟩

  
  intro j
  obtain ⟨ϖ, u, e, ψ_i, he, _, hX, hψC, hψX, hψEt, i₁, θ, β, ψ₁, hβ, hψ₁C, hψ₁X, hψ₁Et⟩ :=
    hStage j.right
  obtain ⟨w_j, hw_j, ϕ_j, hϕ_j, hw_j_fst, hw_j_snd⟩ :=
    hSingleStage j ϖ u e ψ_i he hX hψC hψX hψEt
  let j₁ : 𝒥 := CategoryTheory.Under.mk (j.hom ≫ θ)
  let θ_U : j ⟶ j₁ := CategoryTheory.Under.homMk θ rfl
  let u₁ : (↑(D.obj i₁))ˣ := Units.map (D.map θ).hom.toMonoidHom u
  have he₁ : 1 ≤ ℓ * e := Nat.mul_pos hℓ_pos he
  have hX₁ : (α.app i₁).hom Polynomial.X = ↑u₁ * β ^ (ℓ * e) := by
    have hα_θ := congrArg (fun f => f.hom Polynomial.X) (hα_nat θ).symm
    change (α.app i₁).hom Polynomial.X = (D.map θ).hom ((α.app j.right).hom Polynomial.X) at hα_θ
    rw [hα_θ, hX, map_mul, map_pow, hβ, ← pow_mul]
    rfl
  obtain ⟨w₁, hw₁, ϕ₁, hϕ₁, hw₁_fst, hw₁_snd⟩ :=
    hSingleStage j₁ β u₁ (ℓ * e) ψ₁ he₁ hX₁ hψ₁C hψ₁X hψ₁Et

  refine ⟨w_j, hw_j, ϕ_j, hϕ_j, j₁, θ_U, w₁, hw₁, ϕ₁, hϕ₁, ?_⟩
  dsimp only
  refine ⟨?_, ?_, ?_⟩
  · 
    calc
      AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫ w_j ≫
          CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
        (AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫
          AlgebraicGeometry.Spec.map (f_stage j)) ≫ π_Sd j.right := by
        rw [hw_j_fst, Category.assoc]
      _ = AlgebraicGeometry.Spec.map (f_stage j ≫ E_diag.map θ_U) ≫ π_Sd j.right := by
        rw [← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map (D_poly.map θ ≫ f_stage j₁) ≫ π_Sd j.right := by
        rw [hf_stage_nat θ_U]
        rfl
      _ = AlgebraicGeometry.Spec.map (f_stage j₁) ≫
            (AlgebraicGeometry.Spec.map (D_poly.map θ) ≫ π_Sd j.right) := by
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
      _ = AlgebraicGeometry.Spec.map (f_stage j₁) ≫ π_Sd i₁ := by
        rw [hπ_nat θ]
      _ = w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 := hw₁_fst.symm
  · 
    have hψ_kum : (D.map θ).hom.comp ψ_i =
        ψ₁.comp ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom) := by
      apply Polynomial.ringHom_ext'
      · ext c_k
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Polynomial.aeval_C]
        change ((D.map θ).hom.comp (ψ_i.comp Polynomial.C)) c_k =
          (ψ₁.comp Polynomial.C) c_k
        rw [hψC, hψ₁C, ← RingHom.comp_assoc, ← CommRingCat.hom_comp, hα_nat θ]
      · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Polynomial.aeval_X, map_pow]
        rw [hψX, hβ, hψ₁X]
    have hSpec_kum :
        AlgebraicGeometry.Spec.map (D.map θ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_i) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ κ_A1 := by
      dsimp [κ_A1]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hhom : CommRingCat.ofHom ψ_i ≫ D.map θ =
          CommRingCat.ofHom ((D.map θ).hom.comp ψ_i) := rfl
      rw [hhom, hψ_kum]
      rfl
    have hw₁_snd_assoc :
        (AlgebraicGeometry.Spec.map (f_stage j₁) ≫
          AlgebraicGeometry.Spec.map (ι_D.app i₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) ≫ κ_A1 =
        w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 := by
      change (AlgebraicGeometry.Spec.map (f_stage j₁) ≫
        AlgebraicGeometry.Spec.map (ι_D.app j₁.right) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) ≫ κ_A1 = _
      rw [← hw₁_snd, Category.assoc]
    calc
      AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫ w_j ≫
          CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
        (AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫
          (AlgebraicGeometry.Spec.map (f_stage j) ≫
            AlgebraicGeometry.Spec.map (ι_D.app j.right))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_i) := by
        rw [hw_j_snd]
        simp only [Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (ι_D.app j.right ≫ f_stage j ≫ E_diag.map θ_U) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_i) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        simp only [Category.assoc]
      _ = AlgebraicGeometry.Spec.map (D.map θ ≫ ι_D.app i₁ ≫ f_stage j₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_i) := by
        have hchain : ι_D.app j.right ≫ f_stage j ≫ E_diag.map θ_U =
            D.map θ ≫ ι_D.app i₁ ≫ f_stage j₁ := by
          rw [hf_stage_nat θ_U]
          change ι_D.app j.right ≫ D_poly.map θ ≫ f_stage j₁ =
            D.map θ ≫ ι_D.app i₁ ≫ f_stage j₁
          rw [← Category.assoc, ← ι_D.naturality θ, Category.assoc]
        rw [hchain]
      _ = AlgebraicGeometry.Spec.map (f_stage j₁) ≫
            AlgebraicGeometry.Spec.map (ι_D.app i₁) ≫
              (AlgebraicGeometry.Spec.map (D.map θ) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_i)) := by
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
        simp only [Category.assoc]
      _ = (AlgebraicGeometry.Spec.map (f_stage j₁) ≫
            AlgebraicGeometry.Spec.map (ι_D.app i₁) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) ≫ κ_A1 := by
        rw [hSpec_kum]
        simp only [Category.assoc]
      _ = w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 := hw₁_snd_assoc
  · 
    calc
      (ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫ ϕ_j.hom) ≫
          CategoryTheory.Limits.pullback.snd j_d w_j =
        ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫
          (ϕ_j.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j) := by
        simp only [Category.assoc]
      _ = ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (ι_loc.app j ≫ E_loc.map θ_U) := by
        rw [hϕ_j, ← AlgebraicGeometry.Spec.map_comp]
      _ = ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_diag.map θ_U ≫ ι_loc.app j₁) := by
        rw [ι_loc.naturality θ_U]
      _ = ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (ι_loc.app j₁) ≫
            AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
        rw [AlgebraicGeometry.Spec.map_comp]
      _ = ϕ₁.inv ≫ (ϕ₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁) ≫
            AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
        rw [← hϕ₁]
      _ = CategoryTheory.Limits.pullback.snd j_d w₁ ≫
            AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
        simp only [← Category.assoc, ϕ₁.inv_hom_id, Category.id_comp]

theorem weil_punctured_val_ring_acyclic_noetherian_stage_deg_zero_bij (k : Type u) [Field k]
    (d_rel ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPur0 :
      let S_d := weilAffineSpaceOver k d_rel
      let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
      let Gm_k := AlgebraicGeometry.Spec
        (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
      let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X : Polynomial k))))
      let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
      let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
      let U_d := CategoryTheory.Limits.pullback j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
      let j_d : U_d ⟶ Y_d :=
        CategoryTheory.Limits.pullback.snd j_Gm
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y_d) [AlgebraicGeometry.Etale w],
        ConnectedSpace ↥W → Nonempty ↥W →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback j_d w) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback j_d w)) :
    let S_d := weilAffineSpaceOver k d_rel
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
    let U_d := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let j_d : U_d ⟶ Y_d :=
      CategoryTheory.Limits.pullback.snd j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    ∀ (E E_loc : CommRingCat.{u})
      (w_E : AlgebraicGeometry.Spec E ⟶ Y_d) [AlgebraicGeometry.Etale w_E]
      (ι_E : E ⟶ E_loc)
      (ϕ_E : AlgebraicGeometry.Spec E_loc ≅ CategoryTheory.Limits.pullback j_d w_E),
      ϕ_E.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_E = AlgebraicGeometry.Spec.map ι_E →
      ∀ (ψ_E : weilEtaleTorsionH (AlgebraicGeometry.Spec E) ℓ 0 →+
          weilEtaleTorsionH (AlgebraicGeometry.Spec E_loc) ℓ 0),
        WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map ι_E) ℓ 0 ψ_E →
        Function.Bijective ψ_E :=
by
  intro S_d A1_k Gm_k j_Gm p_A1 Y_d U_d j_d

  
  obtain ⟨hPullEx, hPullId, hPullComp, -, -⟩ :=
    weil_etale_torsion_pullback_functoriality.{u}

  have hPullCompEq : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
      (f₁ : X₁ ⟶ X₂) (f₂ : X₂ ⟶ X₃) (g : X₁ ⟶ X₃) (m q : ℕ)
      (p₁ : weilEtaleTorsionH X₂ m q →+ weilEtaleTorsionH X₁ m q)
      (p₂ : weilEtaleTorsionH X₃ m q →+ weilEtaleTorsionH X₂ m q)
      (pg : weilEtaleTorsionH X₃ m q →+ weilEtaleTorsionH X₁ m q),
      f₁ ≫ f₂ = g →
      WeilIsTorsionEtalePullback f₁ m q p₁ →
      WeilIsTorsionEtalePullback f₂ m q p₂ →
      WeilIsTorsionEtalePullback g m q pg →
      pg = p₁.comp p₂ := by
    intro X₁ X₂ X₃ f₁ f₂ g m q p₁ p₂ pg hfg hp₁ hp₂ hpg
    rw [← hfg] at hpg
    exact hPullComp f₁ f₂ m q p₁ p₂ pg hp₁ hp₂ hpg

  have hPullSqEq : ∀ {X₁ X₂ X₃ X₄ : AlgebraicGeometry.Scheme.{u}}
      (f₁ : X₁ ⟶ X₂) (f₂ : X₂ ⟶ X₄) (g₁ : X₁ ⟶ X₃) (g₂ : X₃ ⟶ X₄) (m q : ℕ)
      (pf₁ : weilEtaleTorsionH X₂ m q →+ weilEtaleTorsionH X₁ m q)
      (pf₂ : weilEtaleTorsionH X₄ m q →+ weilEtaleTorsionH X₂ m q)
      (pg₁ : weilEtaleTorsionH X₃ m q →+ weilEtaleTorsionH X₁ m q)
      (pg₂ : weilEtaleTorsionH X₄ m q →+ weilEtaleTorsionH X₃ m q),
      f₁ ≫ f₂ = g₁ ≫ g₂ →
      WeilIsTorsionEtalePullback f₁ m q pf₁ →
      WeilIsTorsionEtalePullback f₂ m q pf₂ →
      WeilIsTorsionEtalePullback g₁ m q pg₁ →
      WeilIsTorsionEtalePullback g₂ m q pg₂ →
      pf₁.comp pf₂ = pg₁.comp pg₂ := by
    intro X₁ X₂ X₃ X₄ f₁ f₂ g₁ g₂ m q pf₁ pf₂ pg₁ pg₂ hsq hpf₁ hpf₂ hpg₁ hpg₂
    obtain ⟨p_diag, hp_diag⟩ := hPullEx (f₁ ≫ f₂) m q
    have h1 := hPullComp f₁ f₂ m q pf₁ pf₂ p_diag hpf₁ hpf₂ hp_diag
    have h2 := hPullCompEq g₁ g₂ (f₁ ≫ f₂) m q pg₁ pg₂ p_diag hsq.symm hpg₁ hpg₂ hp_diag
    exact h1.symm.trans h2

  have hPullRightInv : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
      (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₁) (m q : ℕ)
      (pf : weilEtaleTorsionH X₂ m q →+ weilEtaleTorsionH X₁ m q)
      (pg : weilEtaleTorsionH X₁ m q →+ weilEtaleTorsionH X₂ m q),
      f ≫ g = 𝟙 X₁ →
      WeilIsTorsionEtalePullback f m q pf →
      WeilIsTorsionEtalePullback g m q pg →
      pf.comp pg = AddMonoidHom.id _ := by
    intro X₁ X₂ f g m q pf pg hfg hpf hpg
    obtain ⟨p_id, hp_id⟩ := hPullEx (𝟙 X₁) m q
    have hid := hPullId m q p_id hp_id
    exact (hPullCompEq f g (𝟙 X₁) m q pf pg p_id hfg hpf hpg hp_id).symm.trans hid

  have hPullIsoBij : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}
      (e : X₁ ≅ X₂) (m q : ℕ)
      (pe : weilEtaleTorsionH X₂ m q →+ weilEtaleTorsionH X₁ m q),
      WeilIsTorsionEtalePullback e.hom m q pe →
      Function.Bijective pe := by
    intro X₁ X₂ e m q pe hpe
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv m q
    have h_ri := hPullRightInv e.hom e.inv m q pe p_inv e.hom_inv_id hpe hp_inv
    have h_li := hPullRightInv e.inv e.hom m q p_inv pe e.inv_hom_id hp_inv hpe
    exact ⟨Function.HasLeftInverse.injective ⟨p_inv, fun x => DFunLike.congr_fun h_li x⟩,
      Function.HasRightInverse.surjective ⟨p_inv, fun y => DFunLike.congr_fun h_ri y⟩⟩

  
  
  have hIdempPowAbsorb : ∀ {A : Type u} [CommRing A] {e : A},
      IsIdempotentElem e → ∀ k : ℕ, e * e ^ k = e := by
    intro A _ e he k
    induction k with
    | zero => rw [pow_zero, mul_one]
    | succ k ih => rw [pow_succ', ← mul_assoc, he.eq, ih]

  have hIdempLocOne : ∀ {A : Type u} [CommRing A] {e : A},
      IsIdempotentElem e → algebraMap A (Localization.Away e) e = 1 := by
    intro A _ e he
    have hu : IsUnit (algebraMap A (Localization.Away e) e) :=
      IsLocalization.Away.algebraMap_isUnit e
    apply hu.mul_left_cancel
    rw [← map_mul, he.eq, mul_one]

  have hIdempLocSurj : ∀ {A : Type u} [CommRing A] {e : A},
      IsIdempotentElem e → Function.Surjective (algebraMap A (Localization.Away e)) := by
    intro A _ e he z
    obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers e) z
    refine ⟨a, ?_⟩
    dsimp only at hzs
    rw [map_pow, hIdempLocOne he, one_pow, mul_one] at hzs
    exact hzs.symm

  have hIdempLocZeroIff : ∀ {A : Type u} [CommRing A] {e : A}
      (he : IsIdempotentElem e) (x : A),
      algebraMap A (Localization.Away e) x = 0 ↔ e * x = 0 := by
    intro A _ e he x
    constructor
    · intro hx
      obtain ⟨⟨_, k, rfl⟩, hkx⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers e) (Localization.Away e) x).mp hx
      dsimp only at hkx
      calc
        e * x = (e * e ^ k) * x := by rw [hIdempPowAbsorb he k]
        _ = e * (e ^ k * x) := by ring
        _ = 0 := by rw [hkx, mul_zero]
    · intro hex
      calc
        algebraMap A (Localization.Away e) x =
            1 * algebraMap A (Localization.Away e) x := (one_mul _).symm
        _ = algebraMap A (Localization.Away e) e *
              algebraMap A (Localization.Away e) x := by rw [hIdempLocOne he]
        _ = algebraMap A (Localization.Away e) (e * x) := (map_mul _ _ _).symm
        _ = 0 := by rw [hex, map_zero]

  have hs3 :
      (∀ (R : Type u) [CommRing R] [IsNoetherianRing R],
        ∃ (n : ℕ) (c : Fin n → R),
          (∀ i : Fin n, IsIdempotentElem (c i)) ∧
          (∀ i j : Fin n, i ≠ j → c i * c j = 0) ∧
          (∑ i : Fin n, c i) = 1 ∧
          (∀ i : Fin n, ConnectedSpace (PrimeSpectrum (Localization.Away (c i))))) ∧
      (∀ (A : Type u) [CommRing A] (n : ℕ) (e : Fin n → A),
        (∀ i : Fin n, IsIdempotentElem (e i)) →
        (∀ i j : Fin n, i ≠ j → e i * e j = 0) →
        (∑ i : Fin n, e i) = 1 →
        Function.Bijective
          (RingHom.pi fun i : Fin n => algebraMap A (Localization.Away (e i)))) := by
    refine ⟨?_, ?_⟩
    · intro R _ _
      have hBasicOpenInj : ∀ {d₁ d₂ : R},
          IsIdempotentElem d₁ → IsIdempotentElem d₂ →
          PrimeSpectrum.basicOpen d₁ = PrimeSpectrum.basicOpen d₂ → d₁ = d₂ := by
        intro d₁ d₂ hd₁ hd₂ hbo
        have hcl : PrimeSpectrum.isIdempotentElemEquivClopens ⟨d₁, hd₁⟩ =
            PrimeSpectrum.isIdempotentElemEquivClopens ⟨d₂, hd₂⟩ := by
          ext p
          have h1 := congrArg (fun U : TopologicalSpace.Opens (PrimeSpectrum R) => p ∈ U)
            ((PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens ⟨d₁, hd₁⟩).trans
              (hbo.trans (PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens ⟨d₂, hd₂⟩).symm))
          exact iff_of_eq h1
        exact congrArg Subtype.val (PrimeSpectrum.isIdempotentElemEquivClopens.injective hcl)
      have hRec : ∀ (U : TopologicalSpace.Opens (PrimeSpectrum R)) (e : R),
          U = PrimeSpectrum.basicOpen (1 - e) →
          IsIdempotentElem e →
          ∃ (n : ℕ) (c : Fin n → R),
            (∀ i : Fin n, IsIdempotentElem (c i)) ∧
            (∀ i j : Fin n, i ≠ j → c i * c j = 0) ∧
            (∑ i : Fin n, c i) = e ∧
            (∀ i : Fin n, ConnectedSpace (PrimeSpectrum (Localization.Away (c i)))) := by
        intro U
        refine WellFounded.induction
          (C := fun U => ∀ e : R,
            U = PrimeSpectrum.basicOpen (1 - e) →
            IsIdempotentElem e →
            ∃ (n : ℕ) (c : Fin n → R),
              (∀ i : Fin n, IsIdempotentElem (c i)) ∧
              (∀ i j : Fin n, i ≠ j → c i * c j = 0) ∧
              (∑ i : Fin n, c i) = e ∧
              (∀ i : Fin n, ConnectedSpace (PrimeSpectrum (Localization.Away (c i)))))
          wellFounded_gt U ?_
        intro U ih e hU he
        by_cases hEmp : IsEmpty (PrimeSpectrum (Localization.Away e))
        · haveI : Subsingleton (Localization.Away e) :=
            PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmp
          have he_zero_map : algebraMap R (Localization.Away e) e = 0 := Subsingleton.elim _ _
          have he_zero : e = 0 := by
            have h1 := (hIdempLocZeroIff he e).mp he_zero_map
            exact he.eq.symm.trans h1
          refine ⟨0, Fin.elim0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_,
            fun i => Fin.elim0 i⟩
          simp [he_zero]
        · by_cases hConn : ConnectedSpace (PrimeSpectrum (Localization.Away e))
          · refine ⟨1, fun _ => e, fun _ => he, ?_, ?_, fun _ => hConn⟩
            · intro i j hij
              exact False.elim (hij (Subsingleton.elim i j))
            · simp
          · have hNe : Nonempty (PrimeSpectrum (Localization.Away e)) := not_isEmpty_iff.mp hEmp
            have hNotPre : ¬ PreconnectedSpace (PrimeSpectrum (Localization.Away e)) := by
              intro hPre
              exact hConn { toPreconnectedSpace := hPre, toNonempty := hNe }
            rw [preconnectedSpace_iff_clopen] at hNotPre
            push_neg at hNotPre
            obtain ⟨s_set, hs_clopen, hs_ne_empty, hs_ne_univ⟩ := hNotPre
            let S_cl : TopologicalSpace.Clopens (PrimeSpectrum (Localization.Away e)) :=
              ⟨s_set, hs_clopen⟩
            let f_bar := PrimeSpectrum.isIdempotentElemEquivClopens.symm S_cl
            have hf_ne_zero : f_bar.1 ≠ 0 := by
              intro hf0
              have hbo := PrimeSpectrum.basicOpen_isIdempotentElemEquivClopens_symm S_cl
              rw [hf0, PrimeSpectrum.basicOpen_zero] at hbo
              obtain ⟨p₀, hp₀⟩ := hs_ne_empty
              have hp_mem : p₀ ∈ S_cl.toOpens := hp₀
              rw [← hbo] at hp_mem
              exact hp_mem
            have hf_ne_one : f_bar.1 ≠ 1 := by
              intro hf1
              have hbo := PrimeSpectrum.basicOpen_isIdempotentElemEquivClopens_symm S_cl
              rw [hf1, PrimeSpectrum.basicOpen_one] at hbo
              apply hs_ne_univ
              ext p
              exact iff_of_eq (congrArg (fun V : TopologicalSpace.Opens _ => p ∈ V) hbo.symm)
            obtain ⟨a, ha⟩ := hIdempLocSurj he f_bar.1
            let e₁ : R := e * a
            let e₂ : R := e - e₁
            have hee₁ : e * e₁ = e₁ := by
              dsimp only [e₁]
              rw [← mul_assoc, he.eq]
            have hmap_e₁ : algebraMap R (Localization.Away e) e₁ = f_bar.1 := by
              dsimp only [e₁]
              rw [map_mul, hIdempLocOne he, one_mul, ha]
            have he₁_idem : IsIdempotentElem e₁ := by
              change e₁ * e₁ = e₁
              have hdiff_map : algebraMap R (Localization.Away e) (e₁ * e₁ - e₁) = 0 := by
                rw [map_sub, map_mul, hmap_e₁, f_bar.2.eq, sub_self]
              have hdiff_ker := (hIdempLocZeroIff he (e₁ * e₁ - e₁)).mp hdiff_map
              have hdiff_eq : e * (e₁ * e₁ - e₁) = e₁ * e₁ - e₁ := by
                calc
                  e * (e₁ * e₁ - e₁) = (e * e₁) * e₁ - e * e₁ := by ring
                  _ = e₁ * e₁ - e₁ := by rw [hee₁]
              rw [hdiff_eq] at hdiff_ker
              exact sub_eq_zero.mp hdiff_ker
            have he₁e₂ : e₁ * e₂ = 0 := by
              dsimp only [e₂]
              calc
                e₁ * (e - e₁) = e * e₁ - e₁ * e₁ := by ring
                _ = e₁ - e₁ := by rw [hee₁, he₁_idem.eq]
                _ = 0 := sub_self e₁
            have hee₂ : e * e₂ = e₂ := by
              dsimp only [e₂]
              calc
                e * (e - e₁) = e * e - e * e₁ := mul_sub e e e₁
                _ = e - e₁ := by rw [he.eq, hee₁]
            have he₂_idem : IsIdempotentElem e₂ := by
              change e₂ * e₂ = e₂
              calc
                e₂ * e₂ = (e - e₁) * e₂ := rfl
                _ = e * e₂ - e₁ * e₂ := sub_mul e e₁ e₂
                _ = e₂ := by rw [hee₂, he₁e₂, sub_zero]
            have hgt₁ : PrimeSpectrum.basicOpen (1 - e₁) > U := by
              rw [hU]
              have hmul₁ : (1 - e₁) * (1 - e) = 1 - e := by
                calc
                  (1 - e₁) * (1 - e) = 1 - e - e₁ + e * e₁ := by ring
                  _ = 1 - e := by rw [hee₁, sub_add_cancel]
              have hle₁ : PrimeSpectrum.basicOpen (1 - e) ≤ PrimeSpectrum.basicOpen (1 - e₁) := by
                conv_lhs => rw [← hmul₁, PrimeSpectrum.basicOpen_mul]
                exact inf_le_left
              refine lt_of_le_of_ne hle₁ fun heq => hf_ne_one ?_
              have h1eq := hBasicOpenInj he.one_sub he₁_idem.one_sub heq
              have he₁_eq_e : e₁ = e := by linear_combination h1eq
              rw [← hmap_e₁, he₁_eq_e, hIdempLocOne he]
            have hgt₂ : PrimeSpectrum.basicOpen (1 - e₂) > U := by
              rw [hU]
              have hmul₂ : (1 - e₂) * (1 - e) = 1 - e := by
                calc
                  (1 - e₂) * (1 - e) = 1 - e - e₂ + e * e₂ := by ring
                  _ = 1 - e := by rw [hee₂, sub_add_cancel]
              have hle₂ : PrimeSpectrum.basicOpen (1 - e) ≤ PrimeSpectrum.basicOpen (1 - e₂) := by
                conv_lhs => rw [← hmul₂, PrimeSpectrum.basicOpen_mul]
                exact inf_le_left
              refine lt_of_le_of_ne hle₂ fun heq => hf_ne_zero ?_
              have h2eq := hBasicOpenInj he.one_sub he₂_idem.one_sub heq
              have he₁_eq_zero : e₁ = 0 := by
                dsimp only [e₂] at h2eq
                linear_combination -h2eq
              rw [← hmap_e₁, he₁_eq_zero, map_zero]
            obtain ⟨n₁, c₁, hc₁_idem, hc₁_orth, hc₁_sum, hc₁_conn⟩ :=
              ih (PrimeSpectrum.basicOpen (1 - e₁)) hgt₁ e₁ rfl he₁_idem
            obtain ⟨n₂, c₂, hc₂_idem, hc₂_orth, hc₂_sum, hc₂_conn⟩ :=
              ih (PrimeSpectrum.basicOpen (1 - e₂)) hgt₂ e₂ rfl he₂_idem
            have hc₁_abs : ∀ i : Fin n₁, c₁ i * e₁ = c₁ i := by
              intro i
              rw [← hc₁_sum, Finset.mul_sum]
              rw [Finset.sum_eq_single i]
              · exact (hc₁_idem i).eq
              · intro i' _ hi'
                exact hc₁_orth i i' hi'.symm
              · intro hi
                exact False.elim (hi (Finset.mem_univ i))
            have hc₂_abs : ∀ j : Fin n₂, e₂ * c₂ j = c₂ j := by
              intro j
              rw [← hc₂_sum, Finset.sum_mul]
              rw [Finset.sum_eq_single j]
              · exact (hc₂_idem j).eq
              · intro j' _ hj'
                exact hc₂_orth j' j hj'
              · intro hj
                exact False.elim (hj (Finset.mem_univ j))
            have hcross : ∀ (i : Fin n₁) (j : Fin n₂), c₁ i * c₂ j = 0 := by
              intro i j
              calc
                c₁ i * c₂ j = (c₁ i * e₁) * (e₂ * c₂ j) := by rw [hc₁_abs i, hc₂_abs j]
                _ = c₁ i * (e₁ * e₂) * c₂ j := by ring
                _ = 0 := by rw [he₁e₂, mul_zero, zero_mul]
            let c_sum : Fin (n₁ + n₂) → R := Fin.addCases c₁ c₂
            have hSplitFin : ∀ k : Fin (n₁ + n₂),
                (∃ i : Fin n₁, k = Fin.castAdd n₂ i) ∨
                (∃ j : Fin n₂, k = Fin.natAdd n₁ j) :=
              fun k => Fin.addCases (fun i => Or.inl ⟨i, rfl⟩) (fun j => Or.inr ⟨j, rfl⟩) k
            refine ⟨n₁ + n₂, c_sum, ?_, ?_, ?_, ?_⟩
            · intro k
              rcases hSplitFin k with ⟨i, rfl⟩ | ⟨j, rfl⟩
              · simp [c_sum, hc₁_idem i]
              · simp [c_sum, hc₂_idem j]
            · intro x y hxy
              rcases hSplitFin x with ⟨i₁, rfl⟩ | ⟨j₁, rfl⟩ <;>
                rcases hSplitFin y with ⟨i₂, rfl⟩ | ⟨j₂, rfl⟩
              · simp only [c_sum, Fin.addCases_left]
                exact hc₁_orth i₁ i₂ (fun h => hxy (congrArg (Fin.castAdd n₂) h))
              · simp only [c_sum, Fin.addCases_left, Fin.addCases_right]
                exact hcross i₁ j₂
              · simp only [c_sum, Fin.addCases_right, Fin.addCases_left]
                rw [mul_comm]
                exact hcross i₂ j₁
              · simp only [c_sum, Fin.addCases_right]
                exact hc₂_orth j₁ j₂ (fun h => hxy (congrArg (Fin.natAdd n₁) h))
            · dsimp only [c_sum]
              rw [Fin.sum_univ_add]
              simp only [Fin.addCases_left, Fin.addCases_right, hc₁_sum, hc₂_sum]
              dsimp only [e₂]
              ring
            · intro k
              rcases hSplitFin k with ⟨i, rfl⟩ | ⟨j, rfl⟩
              · have hk : c_sum (Fin.castAdd n₂ i) = c₁ i := Fin.addCases_left i
                rw [hk]
                exact hc₁_conn i
              · have hk : c_sum (Fin.natAdd n₁ j) = c₂ j := Fin.addCases_right j
                rw [hk]
                exact hc₂_conn j
      exact hRec (PrimeSpectrum.basicOpen (1 - (1 : R))) 1 rfl IsIdempotentElem.one
    · intro A _ n e he_idem he_orth he_sum
      let Φ := RingHom.pi fun i : Fin n => algebraMap A (Localization.Away (e i))
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro x hx
        have hex : ∀ i : Fin n, e i * x = 0 := by
          intro i
          have hxi : algebraMap A (Localization.Away (e i)) x = 0 := by
            simpa [Φ] using congrFun hx i
          exact (hIdempLocZeroIff (he_idem i) x).mp hxi
        calc
          x = 1 * x := (one_mul x).symm
          _ = (∑ i : Fin n, e i) * x := by rw [he_sum]
          _ = ∑ i : Fin n, e i * x := Finset.sum_mul Finset.univ e x
          _ = 0 := Finset.sum_eq_zero fun i _ => hex i
      · intro y
        choose a ha using fun i : Fin n => hIdempLocSurj (he_idem i) (y i)
        refine ⟨∑ j : Fin n, e j * a j, ?_⟩
        funext i
        change algebraMap A (Localization.Away (e i)) (∑ j : Fin n, e j * a j) = y i
        rw [map_sum]
        rw [Finset.sum_eq_single i]
        · rw [map_mul, hIdempLocOne (he_idem i), one_mul, ha i]
        · intro j _ hji
          have heij : algebraMap A (Localization.Away (e i)) (e j) = 0 :=
            (hIdempLocZeroIff (he_idem i) (e j)).mpr (he_orth i j hji.symm)
          rw [map_mul, heij, zero_mul]
        · intro hi
          exact False.elim (hi (Finset.mem_univ i))

  
  have hs4 : ∀ (E E_loc : CommRingCat.{u})
      (w_E : AlgebraicGeometry.Spec E ⟶ Y_d) [AlgebraicGeometry.Etale w_E]
      (ι_E : E ⟶ E_loc)
      (ϕ_E : AlgebraicGeometry.Spec E_loc ≅ CategoryTheory.Limits.pullback j_d w_E),
      ϕ_E.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_E = AlgebraicGeometry.Spec.map ι_E →
      IsNoetherianRing ↑E ∧
      ∀ (a : ↑E),
        let w_a : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away a)) ⟶ Y_d :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑E) (Localization.Away a))) ≫
            w_E
        AlgebraicGeometry.Etale w_a ∧
        (ConnectedSpace ↥(CategoryTheory.Limits.pullback j_d w_a) →
          ConnectedSpace (PrimeSpectrum (Localization.Away (ι_E.hom a)))) := by
    intro E E_loc w_E hw_E ι_E ϕ_E hϕ_E
    have hLFT_Sd : AlgebraicGeometry.LocallyOfFiniteType S_d.hom := by
      dsimp [S_d, weilAffineSpaceOver]
      rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    haveI : AlgebraicGeometry.LocallyOfFiniteType S_d.hom := hLFT_Sd
    haveI : AlgebraicGeometry.IsLocallyNoetherian A1_k := by
      dsimp [A1_k]
      infer_instance
    haveI : AlgebraicGeometry.LocallyOfFiniteType
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1) := inferInstance
    haveI : AlgebraicGeometry.IsLocallyNoetherian Y_d :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    haveI : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec E) :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian w_E
    haveI : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Spec E) :=
      AlgebraicGeometry.IsNoetherian.mk
    have hNoethE : IsNoetherianRing ↑E :=
      AlgebraicGeometry.isNoetherian_Spec.mp inferInstance
    refine ⟨hNoethE, fun a => ?_⟩
    let E_a := CommRingCat.of (Localization.Away a)
    let f_a : E ⟶ E_a := CommRingCat.ofHom (algebraMap (↑E) (Localization.Away a))
    haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map f_a) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization a
    let w_a : AlgebraicGeometry.Spec E_a ⟶ Y_d := AlgebraicGeometry.Spec.map f_a ≫ w_E
    have hw_a : AlgebraicGeometry.Etale w_a := by
      dsimp only [w_a]
      infer_instance
    refine ⟨hw_a, fun hConnPb => ?_⟩
    let a' : ↑E_loc := ι_E.hom a
    let Eloc_a := CommRingCat.of (Localization.Away a')
    let f_a' : E_loc ⟶ Eloc_a := CommRingCat.ofHom (algebraMap (↑E_loc) (Localization.Away a'))
    let ι_a_ring : Localization.Away a →+* Localization.Away a' :=
      IsLocalization.Away.map (Localization.Away a) (Localization.Away a') ι_E.hom a
    let ι_a : E_a ⟶ Eloc_a := CommRingCat.ofHom ι_a_ring
    have hcomm_push : ι_E ≫ f_a' = f_a ≫ ι_a := by
      apply CommRingCat.hom_ext
      ext x
      change algebraMap (↑E_loc) (Localization.Away a') (ι_E.hom x) =
        ι_a_ring (algebraMap (↑E) (Localization.Away a) x)
      dsimp only [ι_a_ring, IsLocalization.Away.map]
      exact (IsLocalization.map_eq _ x).symm
    have hPush : CategoryTheory.IsPushout ι_E f_a f_a' ι_a := by
      have hu_cocone :
          ∀ s : CategoryTheory.Limits.PushoutCocone ι_E f_a, IsUnit (s.inl.hom a') := by
        intro s
        have hcond := congrArg (fun g : E ⟶ s.pt => g.hom a) s.condition
        change IsUnit ((ι_E ≫ s.inl).hom a)
        rw [hcond]
        exact (IsLocalization.Away.algebraMap_isUnit a).map s.inr.hom
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_push
          (fun s => CommRingCat.ofHom (IsLocalization.Away.lift a' (hu_cocone s)))
          (fun s => ?_) (fun s => ?_) (fun s m hm₁ _ => ?_))
      · apply CommRingCat.hom_ext
        ext y
        exact IsLocalization.Away.lift_eq a' (hu_cocone s) y
      · apply CommRingCat.hom_ext
        refine IsLocalization.ringHom_ext (Submonoid.powers a) ?_
        ext x
        have hcond := congrArg (fun g : E ⟶ s.pt => g.hom x) s.condition
        change (IsLocalization.Away.lift a' (hu_cocone s))
            (ι_a_ring (algebraMap (↑E) (Localization.Away a) x)) =
          s.inr.hom (f_a.hom x)
        dsimp only [ι_a_ring, IsLocalization.Away.map]
        rw [IsLocalization.map_eq, IsLocalization.Away.lift_eq]
        exact hcond
      · apply CommRingCat.hom_ext
        refine IsLocalization.ringHom_ext (Submonoid.powers a') ?_
        ext y
        have hm₁_y := congrArg (fun g : E_loc ⟶ s.pt => g.hom y) hm₁
        exact hm₁_y.trans (IsLocalization.Away.lift_eq a' (hu_cocone s) y).symm
    have hpb₁ : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map f_a') (AlgebraicGeometry.Spec.map ι_a)
        (AlgebraicGeometry.Spec.map ι_E) (AlgebraicGeometry.Spec.map f_a) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout ι_E f_a f_a' ι_a hPush
    have hpb₂ : CategoryTheory.IsPullback
        (ϕ_E.hom ≫ CategoryTheory.Limits.pullback.fst j_d w_E)
        (AlgebraicGeometry.Spec.map ι_E) j_d w_E :=
      CategoryTheory.IsPullback.of_iso
        (CategoryTheory.IsPullback.of_hasPullback j_d w_E)
        ϕ_E.symm (CategoryTheory.Iso.refl U_d) (CategoryTheory.Iso.refl (AlgebraicGeometry.Spec E))
        (CategoryTheory.Iso.refl Y_d)
        (by
          change CategoryTheory.Limits.pullback.fst j_d w_E ≫ 𝟙 U_d =
            ϕ_E.inv ≫ ϕ_E.hom ≫ CategoryTheory.Limits.pullback.fst j_d w_E
          rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
            ϕ_E.inv_hom_id, CategoryTheory.Category.id_comp])
        (by
          change CategoryTheory.Limits.pullback.snd j_d w_E ≫ 𝟙 (AlgebraicGeometry.Spec E) =
            ϕ_E.inv ≫ AlgebraicGeometry.Spec.map ι_E
          rw [CategoryTheory.Category.comp_id, ← hϕ_E, ← CategoryTheory.Category.assoc,
            ϕ_E.inv_hom_id, CategoryTheory.Category.id_comp])
        ((CategoryTheory.Category.id_comp j_d).trans (CategoryTheory.Category.comp_id j_d).symm)
        ((CategoryTheory.Category.id_comp w_E).trans (CategoryTheory.Category.comp_id w_E).symm)
    have hpb_tot : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map f_a' ≫ ϕ_E.hom ≫ CategoryTheory.Limits.pullback.fst j_d w_E)
        (AlgebraicGeometry.Spec.map ι_a) j_d w_a :=
      hpb₁.paste_horiz hpb₂
    let e_pb : AlgebraicGeometry.Spec Eloc_a ≅ CategoryTheory.Limits.pullback j_d w_a :=
      hpb_tot.isoPullback
    have hSurj : Function.Surjective e_pb.inv.base := by
      intro x
      refine ⟨e_pb.hom.base x, ?_⟩
      change (e_pb.hom ≫ e_pb.inv).base x = x
      rw [e_pb.hom_inv_id]
      rfl
    have : ConnectedSpace ↥(CategoryTheory.Limits.pullback j_d w_a) := hConnPb
    exact hSurj.connectedSpace e_pb.inv.continuous

  
  have hs5 : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      [ConnectedSpace ↥S₁] [ConnectedSpace ↥S₂]
      (h : S₁ ⟶ S₂)
      (p : weilEtaleTorsionH S₂ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0),
      WeilIsTorsionEtalePullback h ℓ 0 p →
      Function.Bijective p := by
    intro S₁ S₂ hConn₁ hConn₂ h p hp
    have hℓ_pos : 1 ≤ ℓ := (Fact.out : Nat.Prime ℓ).pos
    have hModGenBij : ∀ (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S],
        Function.Bijective (fun c : ZMod ℓ =>
          c.val • CategoryTheory.Abelian.Ext.mk₀.{u}
            (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S ℓ))) := by
      intro S _
      let oneR := weilEtaleModuleUnit S ℓ
      have hEndBij := (weil_etale_connected_unit_end_and_geom_point_lift S ℓ hℓ_pos).1
      let e_ext : weilEtaleModuleH S ℓ 0 ≃+ (oneR ⟶ oneR) :=
        CategoryTheory.Abelian.Ext.addEquiv₀
      have hmk : ∀ f : oneR ⟶ oneR, e_ext.symm f = CategoryTheory.Abelian.Ext.mk₀.{u} f :=
        fun f => CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply f
      have hEq : (fun c : ZMod ℓ => c.val • CategoryTheory.Abelian.Ext.mk₀.{u} (𝟙 oneR)) =
          e_ext.symm ∘ (fun c : ZMod ℓ => c.val • 𝟙 oneR) := by
        funext c
        change c.val • CategoryTheory.Abelian.Ext.mk₀.{u} (𝟙 oneR) =
          e_ext.symm (c.val • 𝟙 oneR)
        rw [map_nsmul, hmk]
      rw [hEq]
      exact e_ext.symm.bijective.comp hEndBij
    obtain ⟨pull, hPull⟩ := weil_etale_module_pullback_exists h ℓ 0
    have hPullUnit : pull (CategoryTheory.Abelian.Ext.mk₀.{u}
          (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S₂ ℓ))) =
        CategoryTheory.Abelian.Ext.mk₀.{u}
          (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S₁ ℓ)) := by
      rcases hPull with ⟨hB_R, P_pull_R, adj_R, hAdd_R, hLim_R, hColim_R, hPull_spec⟩
      letI := hAdd_R
      letI := hLim_R
      letI := hColim_R
      obtain ⟨η_R, _, hηε_R, hpull_eq⟩ := hPull_spec
        (weilEtaleIdTerminal.{u} S₂) (weilEtaleIdTerminalIsTerminal.{u} S₂)
        (weilEtaleIdTerminal.{u} S₁) (weilEtaleIdTerminalIsTerminal.{u} S₁)
      rw [hpull_eq (CategoryTheory.Abelian.Ext.mk₀.{u} (𝟙 (weilEtaleModuleUnit S₂ ℓ)))]
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        P_pull_R.map_id,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Category.id_comp,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hηε_R]
    have hPullBij : Function.Bijective pull := by
      let e₂ : ZMod ℓ ≃ weilEtaleModuleH S₂ ℓ 0 :=
        Equiv.ofBijective _ (hModGenBij S₂)
      let e₁ : ZMod ℓ ≃ weilEtaleModuleH S₁ ℓ 0 :=
        Equiv.ofBijective _ (hModGenBij S₁)
      have hcomp_gen : ∀ c : ZMod ℓ, pull (e₂ c) = e₁ c := by
        intro c
        change pull (c.val • CategoryTheory.Abelian.Ext.mk₀.{u} _) = _
        rw [map_nsmul, hPullUnit]
        rfl
      have hpull_eq_equiv : (pull : weilEtaleModuleH S₂ ℓ 0 → weilEtaleModuleH S₁ ℓ 0) =
          e₁ ∘ e₂.symm := by
        funext x
        have hx : e₂ (e₂.symm x) = x := e₂.apply_symm_apply x
        calc
          pull x = pull (e₂ (e₂.symm x)) := by rw [hx]
          _ = e₁ (e₂.symm x) := hcomp_gen (e₂.symm x)
      rw [hpull_eq_equiv]
      exact e₁.bijective.comp e₂.symm.bijective
    obtain ⟨Θ₂, hΘ₂, hBij₂⟩ := (weil_etale_module_ext_comparison.1 S₂ ℓ 0).1
    obtain ⟨Θ₁, hΘ₁, hBij₁⟩ := (weil_etale_module_ext_comparison.1 S₁ ℓ 0).1
    let eΘ₂ : weilEtaleModuleH S₂ ℓ 0 ≃ weilEtaleTorsionH S₂ ℓ 0 :=
      Equiv.ofBijective Θ₂ hBij₂
    let eΘ₁ : weilEtaleModuleH S₁ ℓ 0 ≃ weilEtaleTorsionH S₁ ℓ 0 :=
      Equiv.ofBijective Θ₁ hBij₁
    have hp_eq_equiv : (p : weilEtaleTorsionH S₂ ℓ 0 → weilEtaleTorsionH S₁ ℓ 0) =
        eΘ₁ ∘ pull ∘ eΘ₂.symm := by
      funext x
      have hx : Θ₂ (eΘ₂.symm x) = x := eΘ₂.apply_symm_apply x
      calc
        p x = p (Θ₂ (eΘ₂.symm x)) := by rw [hx]
        _ = Θ₁ (pull (eΘ₂.symm x)) :=
          (weil_etale_module_torsion_pullback_comm h ℓ 0 pull p Θ₂ Θ₁ hPull hp hΘ₂ hΘ₁
            (eΘ₂.symm x)).symm
    rw [hp_eq_equiv]
    exact eΘ₁.bijective.comp (hPullBij.comp eΘ₂.symm.bijective)

  
  
  have hCoverMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (I : Type u)
      (V : I → S.Etale) (v : ∀ i : I, V i ⟶ U),
      (∀ y : ↥U.left, ∃ (i : I) (x : ↥(V i).left), (v i).left.base x = y) →
      CategoryTheory.Sieve.ofArrows V v ∈ S.smallEtaleTopology U := by
    intro S U I V v hsurj
    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let U' : P.Over ⊤ S := U
    let V' : I → P.Over ⊤ S := V
    let v' : ∀ i : I, V' i ⟶ U' := v
    change CategoryTheory.Sieve.ofArrows V' v' ∈
      (AlgebraicGeometry.Scheme.smallGrothendieckTopology P S) U'
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (le_rfl : P ≤ P),
      CategoryTheory.Pretopology.mem_toGrothendieck]
    refine ⟨CategoryTheory.Presieve.ofArrows V' v', ?_,
      CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows V' v')⟩
    change CategoryTheory.Presieve.ofArrows V' v' ∈
      (CategoryTheory.Precoverage.comap (CategoryTheory.MorphismProperty.Over.forget P ⊤ S)
        (CategoryTheory.Precoverage.over S (AlgebraicGeometry.Scheme.precoverage P))).coverings U'
    rw [CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Presieve.map_ofArrows,
      CategoryTheory.Precoverage.over, CategoryTheory.Precoverage.mem_comap_iff,
      CategoryTheory.Presieve.map_ofArrows]
    refine ⟨?_, ?_⟩
    · rw [AlgebraicGeometry.Scheme.jointlySurjectivePrecoverage,
        CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Presieve.map_ofArrows,
        CategoryTheory.Types.mem_jointlySurjectivePrecoverage_iff]
      intro y
      obtain ⟨i, x, hx⟩ := hsurj y
      exact ⟨_, _, CategoryTheory.Presieve.ofArrows.mk i, x, hx⟩
    · rintro _ _ ⟨i⟩
      exact CategoryTheory.MorphismProperty.of_postcomp P (v' i).left U'.hom
        U'.prop (by rw [CategoryTheory.MorphismProperty.Over.w (v' i)]; exact (V' i).prop)

  let zsmulHom : ∀ (M : AddCommGrpCat.{u}), ↥M → (AddCommGrpCat.of (ULift.{u} ℤ) ⟶ M) :=
    fun M m => AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }

  have hzsmul_eval : ∀ {M : AddCommGrpCat.{u}} (m : ↥M),
