      rw [hj'_pt, hy_lift_hom, hw_P_pt]
    obtain ⟨hAdd_Rv, hLim_Rv, hColim_Rv⟩ := hResExact hv
    have _ := hAdd_Rv; have _ := hLim_Rv; have _ := hColim_Rv
    let C₂ := CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
    let T₂ : W₂.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)
    let Γ₂ := (CategoryTheory.sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    obtain ⟨e_cA₁⟩ := hResConst hv A₁
    obtain ⟨e_cA₃⟩ := hResConst hv A₃
    let SC₂_raw := SC_P.map (resEtale hv)
    have hSE₂_raw : SC₂_raw.ShortExact := hSE_P.map_of_exact (resEtale hv)
    let ℰ₂ := (resEtale hv).obj ℰ_P
    let f₂ : C₂.obj A₁ ⟶ ℰ₂ := e_cA₁.inv ≫ SC₂_raw.f
    let g₂_raw : ℰ₂ ⟶ (resEtale hv).obj (C_P.obj A₃) := SC₂_raw.g
    let g₂ : ℰ₂ ⟶ C₂.obj A₃ := g₂_raw ≫ e_cA₃.hom
    have hfg₂ : f₂ ≫ g₂ = 0 := by
      dsimp [f₂, g₂, g₂_raw]
      rw [Category.assoc, ← Category.assoc SC₂_raw.f, SC₂_raw.zero,
        Limits.zero_comp, Limits.comp_zero]
    have hSE₂ : (ShortComplex.mk f₂ g₂ hfg₂).ShortExact :=
      ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk e_cA₁ (Iso.refl ℰ₂) e_cA₃
          ((e_cA₁.hom_inv_id_assoc SC₂_raw.f).trans (Category.comp_id SC₂_raw.f).symm)
          (Category.id_comp (SC₂_raw.g ≫ e_cA₃.hom)))
        hSE₂_raw
    have _ : Epi (Γ₂.map g₂_raw) :=
      hResEpi u_lift j' hv g_P fun a =>
        hLifts _ (List.mem_map_of_mem (Finset.mem_toList.mpr (Finset.mem_univ a)))
    have hEpi_Γg₂ : Epi (Γ₂.map g₂) := by
      dsimp [g₂]; rw [Γ₂.map_comp]; exact epi_comp _ _
    obtain ⟨e_comp_vw⟩ := hResComp hv hw_P hw₂
    exact ⟨W₂, w₂, hw₂, y₂, hConn₂, A₁, A₃, ℰ₂, f₂, g₂, hfg₂,
      hw₂_pt, hFin₁, hFin₃, hSE₂, hEpi_Γg₂, ⟨e_comp_vw.app SC.X₂⟩⟩

  
  obtain ⟨W₂, w₂, hw₂, y₂, hConn₂, A₁, A₃, ℰ₂, f₂, g₂, hfg₂,
    hw₂_pt, hFin₁, hFin₃, hSE₂, hEpi_Γg₂, ⟨e_res_X₂⟩⟩ := hStepW₂
  have _ := hConn₂
  have hStepFive :
      ∃ (A₂ : AddCommGrpCat.{u}),
        Finite ↥A₂ ∧
        Nonempty (ℰ₂ ≅
          (CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) := by
    clear * - hTerm hConnIso W₂ hConn₂ A₁ A₃ ℰ₂ f₂ g₂ hfg₂ hFin₁ hFin₃ hSE₂ hEpi_Γg₂
    let C₂ := CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}
    let T₂ : W₂.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)
    let Γ₂ := (CategoryTheory.sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T₂)
    let adj₂ := CategoryTheory.constantSheafAdj W₂.smallEtaleTopology AddCommGrpCat.{u} (hTerm W₂)
    let SC₂ := ShortComplex.mk f₂ g₂ hfg₂
    have _ : Γ₂.IsRightAdjoint := adj₂.isRightAdjoint
    have _ : Γ₂.Additive := { map_add := fun {_ _ _ _} => AddCommGrpCat.ext fun _ => rfl }
    have _ : Limits.PreservesFiniteLimits Γ₂ := inferInstance
    let SC_ab := SC₂.map Γ₂
    have hEx_ab : SC_ab.Exact :=
      hSE₂.exact.map_of_mono_of_preservesKernel Γ₂ hSE₂.mono_f inferInstance
    have _ : Mono SC₂.f := hSE₂.mono_f
    have _ : Mono SC_ab.f := Γ₂.map_mono SC₂.f
    have _ : Epi SC_ab.g := hEpi_Γg₂
    have hSE_ab : SC_ab.ShortExact := { exact := hEx_ab }
    obtain ⟨hIso_u₁, hIso_c₁⟩ := hConnIso W₂ A₁
    obtain ⟨hIso_u₃, hIso_c₃⟩ := hConnIso W₂ A₃
    have _ := hIso_u₁; have _ := hIso_c₁; have _ := hIso_u₃; have _ := hIso_c₃
    have _ : Finite ↥SC_ab.X₁ :=
      @Finite.of_surjective ↥A₁ ↥SC_ab.X₁ hFin₁ _
        (ConcreteCategory.bijective_of_isIso (adj₂.unit.app A₁)).2
    have _ : Finite ↥SC_ab.X₃ :=
      @Finite.of_surjective ↥A₃ ↥SC_ab.X₃ hFin₃ _
        (ConcreteCategory.bijective_of_isIso (adj₂.unit.app A₃)).2
    have hFin_A₂ : Finite ↥(Γ₂.obj ℰ₂) := by
      have hSurj_g : Function.Surjective SC_ab.g.hom :=
        (AddCommGrpCat.epi_iff_surjective SC_ab.g).mp inferInstance
      let sec : ↥SC_ab.X₃ → ↥SC_ab.X₂ := fun z => (hSurj_g z).choose
      have hsec : ∀ z, SC_ab.g.hom (sec z) = z := fun z => (hSurj_g z).choose_spec
      have hKer : ∀ m : ↥SC_ab.X₂, m - sec (SC_ab.g.hom m) ∈ SC_ab.f.hom.range := by
        intro m
        rw [ShortComplex.ab_exact_iff_range_eq_ker.mp hEx_ab]
        change SC_ab.g.hom (m - sec (SC_ab.g.hom m)) = 0
        rw [map_sub, hsec, sub_self]
      refine Finite.of_injective
        (fun m : ↥SC_ab.X₂ => ((hKer m).choose, SC_ab.g.hom m))
        (fun m₁ m₂ hm => ?_)
      have h1 : (hKer m₁).choose = (hKer m₂).choose := congrArg Prod.fst hm
      have h2 : SC_ab.g.hom m₁ = SC_ab.g.hom m₂ := congrArg Prod.snd hm
      have hf1 := (hKer m₁).choose_spec
      have hf2 := (hKer m₂).choose_spec
      rw [h1, h2] at hf1
      exact sub_left_inj.mp (hf1.symm.trans hf2)
    have hIso_counit_ℰ₂ : IsIso (adj₂.counit.app ℰ₂) := by
      have _ : C₂.IsLeftAdjoint := adj₂.isLeftAdjoint
      have _ : C₂.Additive := by
        dsimp [C₂]; unfold CategoryTheory.constantSheaf; infer_instance
      have _ : Limits.PreservesFiniteColimits C₂ := inferInstance
      have _ : Limits.PreservesFiniteLimits C₂ := by
        dsimp [C₂, CategoryTheory.constantSheaf]; infer_instance
      let SC_top := SC_ab.map C₂
      have hSE_top : SC_top.ShortExact := hSE_ab.map_of_exact C₂
      let φ_SC : SC_top ⟶ SC₂ :=
        { τ₁ := adj₂.counit.app (C₂.obj A₁)
          τ₂ := adj₂.counit.app ℰ₂
          τ₃ := adj₂.counit.app (C₂.obj A₃)
          comm₁₂ := (adj₂.counit.naturality f₂).symm
          comm₂₃ := (adj₂.counit.naturality g₂).symm }
      have _ : Mono φ_SC.τ₂ :=
        ShortComplex.mono_of_mono_of_mono_of_mono φ_SC hSE_top.exact hSE₂.mono_f
          inferInstance inferInstance
      have _ : Epi φ_SC.τ₂ :=
        ShortComplex.epi_of_epi_of_epi_of_epi φ_SC hSE₂.exact hSE_top.epi_g
          inferInstance inferInstance
      exact Balanced.isIso_of_mono_of_epi (adj₂.counit.app ℰ₂)
    exact ⟨Γ₂.obj ℰ₂, hFin_A₂, ⟨(@asIso _ _ _ _ (adj₂.counit.app ℰ₂) hIso_counit_ℰ₂).symm⟩⟩

  obtain ⟨A₂, hFin_A₂, ⟨e_ℰ₂⟩⟩ := hStepFive
  exact ⟨W₂, w₂, A₂, hw₂, ⟨y₂, hw₂_pt⟩, hFin_A₂, (hResPbIff hw₂).2 ⟨e_res_X₂ ≪≫ e_ℰ₂⟩⟩

theorem weil_bockstein_open_higherDirectImage_pullback (Z S : AlgebraicGeometry.Scheme.{u})
    (f : Z ⟶ S)
    (U : S.Opens)
    (m q : ℕ) :
    WeilIsEtaleSheafPullback U.ι
      (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z m))
      (weilEtaleHigherDirectImage (f ∣_ U) q
        (weilEtaleTorsionSheaf (f ⁻¹ᵁ U).toScheme m)) :=
by
  classical
  have hEtComp : MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEtPb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have hEtBC : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  let U₀ : AlgebraicGeometry.Scheme.{u} := U.toScheme
  let V_Z : Z.Opens := f ⁻¹ᵁ U
  let V_U : AlgebraicGeometry.Scheme.{u} := V_Z.toScheme
  let f_U : V_U ⟶ U₀ := f ∣_ U
  let siteMap : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (_ : AlgebraicGeometry.Etale w), Functor V.Etale X.Etale :=
    fun hw => MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hw

  have hMemEt : ∀ {X : AlgebraicGeometry.Scheme.{u}} (E : X.Etale) (R : Sieve E),
      R ∈ X.smallEtaleTopology E ↔
        ∀ (x : ↥E.left), ∃ (Y : X.Etale) (g : Y ⟶ E) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    clear * - hEtComp
    intro X E R
    change R ∈ Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) X E ↔ _
    rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X (le_refl _)]
    exact Scheme.mem_toGrothendieck_smallPretopology E R

  have hMorEt : ∀ {X : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : X.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    clear * -
    intro X Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := MorphismProperty.Over.w u
    have _ : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    have _ : AlgebraicGeometry.Etale Y₂.hom := Y₂.prop
    exact AlgebraicGeometry.Etale.of_comp u.left Y₂.hom

  have hContB : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology := by
    clear * - hEtComp hEtPb hEtBC hMemEt hMorEt
    intro Y₁ Y₂ h
    let B_h : Functor Y₂.Etale Y₁.Etale := weilEtaleSitePullback h
    have _ : Limits.PreservesFiniteLimits B_h :=
      MorphismProperty.Over.instPreservesFiniteLimitsTopPullback (@AlgebraicGeometry.Etale) h
    have _ : RepresentablyFlat B_h := flat_of_preservesFiniteLimits B_h
    have hCompat : CompatiblePreserving Y₁.smallEtaleTopology B_h :=
      compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h
    have hCov : CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
      refine ⟨fun {E} {R} hR => (hMemEt (B_h.obj E) _).mpr fun y => ?_⟩
      obtain ⟨V, u, v, huR, _, hv⟩ :=
        (hMemEt E R).mp hR ((Limits.pullback.fst E.hom h).base y)
      have hpb_top : IsPullback ((B_h.map u).left) (Limits.pullback.fst V.hom h)
          (Limits.pullback.fst E.hom h) u.left := by
        refine IsPullback.of_right ?_ (Limits.pullback.lift_fst _ _ _)
          (IsPullback.of_hasPullback E.hom h).flip
        have hw : u.left ≫ E.hom = V.hom := MorphismProperty.Over.w u
        have hsnd : (B_h.map u).left ≫ Limits.pullback.snd E.hom h =
            Limits.pullback.snd V.hom h := MorphismProperty.Over.w (B_h.map u)
        rw [hw, hsnd]
        exact (IsPullback.of_hasPullback V.hom h).flip
      let e_pb := hpb_top.isoPullback
      obtain ⟨z₀, hz₀_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback y v hv.symm
      refine ⟨B_h.obj V, B_h.map u, e_pb.inv.base z₀,
        ⟨V, u, 𝟙 (B_h.obj V), huR, (Category.id_comp _).symm⟩, hMorEt (B_h.map u), ?_⟩
      have hcomp : e_pb.inv ≫ (B_h.map u).left =
          Limits.pullback.fst (Limits.pullback.fst E.hom h) u.left :=
        (Iso.inv_comp_eq e_pb).mpr hpb_top.isoPullback_hom_fst.symm
      exact (Scheme.Hom.comp_apply e_pb.inv ((B_h.map u).left) z₀).symm.trans
        ((congrArg (fun g : _ ⟶ (B_h.obj E).left => g.base z₀) hcomp).trans hz₀_fst)
    exact Functor.isContinuous_of_coverPreserving hCompat hCov

  have hOpenCont : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (hw : AlgebraicGeometry.Etale w),
      (siteMap hw).IsContinuous V.smallEtaleTopology X.smallEtaleTopology := by
    clear * - hEtComp siteMap hMemEt hMorEt
    intro V X w hw
    let M_w : Functor V.Etale X.Etale := siteMap hw
    have hCompat : CompatiblePreserving X.smallEtaleTopology M_w := by
      refine CompatiblePreserving.mk ?_
      intro ℱ Y T x hx Y₁ Y₂ Z₀ f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      have hcomm_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun m => ((AlgebraicGeometry.Scheme.Etale.forget X).map m).left) hcomm
      have hf₁_et : AlgebraicGeometry.Etale f₁.left := hMorEt f₁
      have hZV_et : AlgebraicGeometry.Etale (f₁.left ≫ Y₁.hom) :=
        MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) f₁.left Y₁.hom hf₁_et Y₁.prop
      let Z_V : V.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) hZV_et
      let f₁_V : Z_V ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      have hw₂ : f₂.left ≫ Y₂.hom = Z_V.hom :=
        (congrArg (f₂.left ≫ ·) (MorphismProperty.Over.w g₂).symm).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ Y.hom) hcomm_left.symm).trans
              ((Category.assoc _ _ _).trans
                (congrArg (f₁.left ≫ ·) (MorphismProperty.Over.w g₁)))))
      let f₂_V : Z_V ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left hw₂ trivial
      have hfV_comm : f₁_V ≫ g₁ = f₂_V ≫ g₂ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget V).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact hcomm_left
      have hx_eq := hx f₁_V f₂_V hg₁ hg₂ hfV_comm
      have heZ_w : 𝟙 Z₀.left ≫ (M_w.obj Z_V).hom = Z₀.hom :=
        (Category.id_comp _).trans
          ((Category.assoc f₁.left Y₁.hom w).trans (MorphismProperty.Over.w f₁))
      let e_Z : Z₀ ⟶ M_w.obj Z_V := MorphismProperty.Over.homMk (𝟙 Z₀.left) heZ_w trivial
      have he₁ : e_Z ≫ M_w.map f₁_V = f₁ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact Category.id_comp f₁.left
      have he₂ : e_Z ≫ M_w.map f₂_V = f₂ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact Category.id_comp f₂.left
      have hmap := congrArg (ℱ.obj.map e_Z.op) hx_eq
      change (ℱ.obj.map (M_w.map f₁_V).op ≫ ℱ.obj.map e_Z.op) (x g₁ hg₁) =
        (ℱ.obj.map (M_w.map f₂_V).op ≫ ℱ.obj.map e_Z.op) (x g₂ hg₂) at hmap
      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp] at hmap
      have hm₁ : ℱ.obj.map ((M_w.map f₁_V).op ≫ e_Z.op) = ℱ.obj.map f₁.op :=
        congrArg (fun g => ℱ.obj.map g.op) he₁
      have hm₂ : ℱ.obj.map ((M_w.map f₂_V).op ≫ e_Z.op) = ℱ.obj.map f₂.op :=
        congrArg (fun g => ℱ.obj.map g.op) he₂
      rwa [hm₁, hm₂] at hmap
    have hCov : CoverPreserving V.smallEtaleTopology X.smallEtaleTopology M_w := by
      refine ⟨fun {Y₀} {R} hR => (hMemEt (M_w.obj Y₀) _).mpr fun z => ?_⟩
      obtain ⟨Y, u, y, huR, huEt, hy⟩ := (hMemEt Y₀ R).mp hR z
      exact ⟨M_w.obj Y, M_w.map u, y, ⟨Y, u, 𝟙 (M_w.obj Y), huR, (Category.id_comp _).symm⟩, huEt, hy⟩
    exact Functor.isContinuous_of_coverPreserving hCompat hCov

  let resEtale := fun {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (hw : AlgebraicGeometry.Etale w) =>
    @Functor.sheafPushforwardContinuous _ _ _ _
      (siteMap hw) AddCommGrpCat.{u} _ V.smallEtaleTopology X.smallEtaleTopology (hOpenCont hw)

  have hResAdj : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (hw : AlgebraicGeometry.Etale w),
      let B_w : Functor X.Etale V.Etale := weilEtaleSitePullback w
      letI : B_w.IsContinuous X.smallEtaleTopology V.smallEtaleTopology := hContB w
      ∃ (_ : ((Functor.whiskeringLeft V.Etaleᵒᵖ X.Etaleᵒᵖ AddCommGrpCat.{u}).obj (siteMap hw).op) ⊣
          ((Functor.whiskeringLeft X.Etaleᵒᵖ V.Etaleᵒᵖ AddCommGrpCat.{u}).obj B_w.op)),
        Nonempty (resEtale hw ⊣ B_w.sheafPushforwardContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology V.smallEtaleTopology) := by
    clear * - hEtComp hEtPb hEtBC siteMap hContB hOpenCont resEtale
    intro V X w hw B_w
    let _ : B_w.IsContinuous X.smallEtaleTopology V.smallEtaleTopology := hContB w
    let _ := hOpenCont hw
    let adj_site : siteMap hw ⊣ B_w :=
      MorphismProperty.Over.mapPullbackAdj (@AlgebraicGeometry.Etale) ⊤ w hw trivial
    let R_M := (Functor.whiskeringLeft V.Etaleᵒᵖ X.Etaleᵒᵖ AddCommGrpCat.{u}).obj (siteMap hw).op
    let R_B := (Functor.whiskeringLeft X.Etaleᵒᵖ V.Etaleᵒᵖ AddCommGrpCat.{u}).obj B_w.op
    let adj_pre : R_M ⊣ R_B := Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun P =>
              { app := fun opT => P.map (adj_site.counit.app opT.unop).op
                naturality := fun {opT₂ opT₁} u =>
                  (P.map_comp _ _).symm.trans
                    ((congrArg P.map (Opposite.unop_injective (adj_site.counit.naturality u.unop).symm)).trans
                      (P.map_comp _ _)) }
            naturality := fun {_ _} α => NatTrans.ext (funext fun _ => (α.naturality _).symm) }
        counit :=
          { app := fun Q =>
              { app := fun opY => Q.map (adj_site.unit.app opY.unop).op
                naturality := fun {opY₂ opY₁} v =>
                  (Q.map_comp _ _).symm.trans
                    ((congrArg Q.map (Opposite.unop_injective (adj_site.unit.naturality v.unop).symm)).trans
                      (Q.map_comp _ _)) }
            naturality := fun {_ _} β => NatTrans.ext (funext fun _ => (β.naturality _).symm) }
        left_triangle := NatTrans.ext (funext fun P => NatTrans.ext (funext fun opY =>
          (Category.id_comp _).trans ((P.map_comp _ _).symm.trans
            ((congrArg P.map (Opposite.unop_injective (adj_site.left_triangle_components opY.unop))).trans
              (P.map_id _)))))
        right_triangle := NatTrans.ext (funext fun Q => NatTrans.ext (funext fun opT =>
          (Category.id_comp _).trans ((Q.map_comp _ _).symm.trans
            ((congrArg Q.map (Opposite.unop_injective (adj_site.right_triangle_components opT.unop))).trans
              (Q.map_id _))))) }
    let pf_w := B_w.sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology V.smallEtaleTopology
    let adj_sh : resEtale hw ⊣ pf_w := Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun F => { hom := adj_pre.unit.app F.obj }
            naturality := fun {_ _} α => Sheaf.hom_ext (adj_pre.unit.naturality α.hom) }
        counit :=
          { app := fun H => { hom := adj_pre.counit.app H.obj }
            naturality := fun {_ _} β => Sheaf.hom_ext (adj_pre.counit.naturality β.hom) }
        left_triangle := NatTrans.ext (funext fun F =>
          Sheaf.hom_ext (congrArg (fun η => η.app F.obj) adj_pre.left_triangle))
        right_triangle := NatTrans.ext (funext fun H =>
          Sheaf.hom_ext (congrArg (fun η => η.app H.obj) adj_pre.right_triangle)) }
    exact ⟨adj_pre, ⟨adj_sh⟩⟩

  have hResShComm : ∀ {V' V : AlgebraicGeometry.Scheme.{u}} {w : V' ⟶ V}
      (hw : AlgebraicGeometry.Etale w),
      let E_w : Functor V'.Etale V.Etale := siteMap hw
      let R_Ew := (Functor.whiskeringLeft V'.Etaleᵒᵖ V.Etaleᵒᵖ AddCommGrpCat.{u}).obj E_w.op
      Nonempty (presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u} ⋙ resEtale hw ≅
        R_Ew ⋙ presheafToSheaf V'.smallEtaleTopology AddCommGrpCat.{u}) := by
    clear * - hEtComp hEtPb hEtBC siteMap hContB hOpenCont resEtale hResAdj
    intro V' V w hw E_w R_Ew
    let _ := hOpenCont hw
    let _ := hContB w
    let B_w : Functor V.Etale V'.Etale := weilEtaleSitePullback w
    let pf_w := B_w.sheafPushforwardContinuous AddCommGrpCat.{u}
      V.smallEtaleTopology V'.smallEtaleTopology
    let R_Bw := (Functor.whiskeringLeft V.Etaleᵒᵖ V'.Etaleᵒᵖ AddCommGrpCat.{u}).obj B_w.op
    obtain ⟨adj_pre_w, ⟨adj_res_w⟩⟩ := hResAdj hw
    let adj_L₁ := (sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}).comp adj_res_w
    let adj_L₂ := adj_pre_w.comp (sheafificationAdjunction V'.smallEtaleTopology AddCommGrpCat.{u})
    let iso_R₁₂ : pf_w ⋙ sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u} ≅
        sheafToPresheaf V'.smallEtaleTopology AddCommGrpCat.{u} ⋙ R_Bw :=
      NatIso.ofComponents (fun _ => Iso.refl _) (fun _ =>
        (Category.comp_id _).trans (Category.id_comp _).symm)
    exact ⟨(adj_L₁.ofNatIsoRight iso_R₁₂).leftAdjointUniq adj_L₂⟩

  have hResConst : ∀ {V' V : AlgebraicGeometry.Scheme.{u}} {w : V' ⟶ V}
      (hw : AlgebraicGeometry.Etale w) (A : AddCommGrpCat.{u}),
      Nonempty ((resEtale hw).obj
        ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A) ≅
        (CategoryTheory.constantSheaf V'.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    clear * - hEtComp siteMap hOpenCont resEtale hResShComm
    intro V' V w hw A
    obtain ⟨σ_sh⟩ := hResShComm hw
    let E_w : Functor V'.Etale V.Etale := siteMap hw
    let e_pre : E_w.op ⋙ (Functor.const V.Etaleᵒᵖ).obj A ≅ (Functor.const V'.Etaleᵒᵖ).obj A :=
      NatIso.ofComponents (fun _ => Iso.refl A) (fun _ =>
        (Category.comp_id _).trans (Category.id_comp _).symm)
    exact ⟨σ_sh.app ((Functor.const V.Etaleᵒᵖ).obj A) ≪≫
      (presheafToSheaf V'.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_pre⟩

  have hResExact : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (hw : AlgebraicGeometry.Etale w),
      (resEtale hw).Additive ∧
      Limits.PreservesFiniteLimits (resEtale hw) ∧
      Limits.PreservesFiniteColimits (resEtale hw) := by
    clear * - hEtComp siteMap hOpenCont resEtale hResAdj
    intro V X w hw
    let _ := hOpenCont hw
    obtain ⟨_, ⟨adj_w⟩⟩ := hResAdj hw
    have _ : (resEtale hw).IsLeftAdjoint := adj_w.isLeftAdjoint
    have hAdd : (resEtale hw).Additive :=
      { map_add := fun {_ _ _ _} => Sheaf.hom_ext (NatTrans.ext (funext fun _ => rfl)) }
    have hLim : Limits.PreservesFiniteLimits (resEtale hw) := by
      refine Limits.PreservesFiniteLimits.mk fun K _ _ => ?_
      have _ : Limits.PreservesLimitsOfShape K
          (resEtale hw ⋙ sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u}) := by
        change Limits.PreservesLimitsOfShape K
          (sheafToPresheaf X.smallEtaleTopology AddCommGrpCat.{u} ⋙
            (Functor.whiskeringLeft _ _ _).obj (siteMap hw).op)
        infer_instance
      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves
        (resEtale hw) (sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u})
    exact ⟨hAdd, hLim, inferInstance⟩

  have hExtByZero : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (O : Y.Opens),
      let ho : AlgebraicGeometry.Etale O.ι := inferInstance
      Limits.PreservesFiniteLimits (resEtale ho) ∧
      Limits.PreservesFiniteColimits (resEtale ho) ∧
      (resEtale ho).Additive ∧
      ∀ (J : Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) [Injective J],
        Injective ((resEtale ho).obj J) := by
    clear * - hEtComp siteMap hOpenCont resEtale hResExact
    intro Y O ho
    let _ : Zero AddCommGrpCat.{u} := Limits.HasZeroObject.zero' AddCommGrpCat.{u}
    let _ := hOpenCont ho
    let E_O : Functor O.toScheme.Etale Y.Etale := siteMap ho
    let Φ : Y.Etale → Prop := fun T => Set.range T.hom.base ⊆ Set.range O.ι.base
    have hΦ_mono : ∀ {T₁ T₂ : Y.Etale} (u : T₁ ⟶ T₂), Φ T₂ → Φ T₁ := by
      intro T₁ T₂ u h₂ z ⟨x, hx⟩
      have hw : (u.left ≫ T₂.hom).base x = T₁.hom.base x :=
        congrArg (fun g : T₁.left ⟶ Y => g.base x) (MorphismProperty.Over.w u)
      exact h₂ ⟨u.left.base x, ((Scheme.Hom.comp_apply u.left T₂.hom x).symm.trans hw).trans hx⟩
    let liftObj : ∀ (T : Y.Etale), Φ T → O.toScheme.Etale := fun T hT =>
      let t := AlgebraicGeometry.IsOpenImmersion.lift O.ι T.hom hT
      have ht : t ≫ O.ι = T.hom := AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι T.hom hT
      have hEt : AlgebraicGeometry.Etale t := by
        have _ : AlgebraicGeometry.Etale (t ≫ O.ι) := ht.symm ▸ T.prop
        exact AlgebraicGeometry.Etale.of_comp t O.ι
      MorphismProperty.Over.mk ⊤ t hEt
    let liftIso : ∀ (T : Y.Etale) (hT : Φ T), E_O.obj (liftObj T hT) ≅ T := fun T hT =>
      MorphismProperty.Over.isoMk (Iso.refl T.left)
        ((Category.id_comp _).trans (AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι T.hom hT).symm)
    have hEO : ∀ (Y₀ : O.toScheme.Etale), Φ (E_O.obj Y₀) := fun Y₀ z ⟨x, hx⟩ =>
      ⟨Y₀.hom.base x, (Scheme.Hom.comp_apply Y₀.hom O.ι x).symm.trans hx⟩
    let counitLiftIso : ∀ (Y₀ : O.toScheme.Etale), liftObj (E_O.obj Y₀) (hEO Y₀) ≅ Y₀ := fun Y₀ =>
      MorphismProperty.Over.isoMk (Iso.refl Y₀.left)
        ((Category.id_comp _).trans
          ((cancel_mono O.ι).mp
            (AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι (E_O.obj Y₀).hom (hEO Y₀))).symm)
    let liftMap : ∀ {T₁ T₂ : Y.Etale} (u : T₁ ⟶ T₂) (h₂ : Φ T₂),
        liftObj T₁ (hΦ_mono u h₂) ⟶ liftObj T₂ h₂ := fun u h₂ =>
      MorphismProperty.Over.homMk u.left
        ((cancel_mono O.ι).mp
          ((Category.assoc u.left _ O.ι).trans
            ((congrArg (u.left ≫ ·) (AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι _ h₂)).trans
              ((MorphismProperty.Over.w u).trans
                (AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι _ (hΦ_mono u h₂)).symm))))
        trivial
    have hLiftMap_id : ∀ (T : Y.Etale) (h : Φ T), liftMap (𝟙 T) h = 𝟙 (liftObj T h) :=
      fun _ _ => MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
    have hLiftMap_comp : ∀ {T₁ T₂ T₃ : Y.Etale} (u : T₁ ⟶ T₂) (v : T₂ ⟶ T₃) (h₃ : Φ T₃),
        liftMap (u ≫ v) h₃ = liftMap u (hΦ_mono v h₃) ≫ liftMap v h₃ :=
      fun _ _ _ => MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
    let j_obj : (O.toScheme.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) → (Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) := fun P =>
      { obj := fun opT =>
          if h : Φ opT.unop then P.obj (Opposite.op (liftObj opT.unop h)) else (0 : AddCommGrpCat.{u})
        map := fun {opT₂ opT₁} g =>
          if h₂ : Φ opT₂.unop then
            eqToHom (dif_pos h₂) ≫ P.map (liftMap g.unop h₂).op ≫
              eqToHom (dif_pos (hΦ_mono g.unop h₂) :
                (if h : Φ opT₁.unop then P.obj (Opposite.op (liftObj opT₁.unop h)) else (0 : AddCommGrpCat.{u})) =
                  P.obj (Opposite.op (liftObj opT₁.unop (hΦ_mono g.unop h₂)))).symm
          else 0
        map_id := fun opT => by
          by_cases h : Φ opT.unop
          · simp only [dif_pos h]
            have hid : (liftMap (𝟙 opT).unop h).op = 𝟙 (Opposite.op (liftObj opT.unop h)) :=
              congrArg Quiver.Hom.op (hLiftMap_id _ h)
            rw [hid, P.map_id, Category.id_comp, eqToHom_trans]
            exact eqToHom_refl _ _
          · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h))).eq_of_src _ _
        map_comp := fun {opT₃ opT₂ opT₁} g₁ g₂ => by
          by_cases h₃ : Φ opT₃.unop
          · have h₂ : Φ opT₂.unop := hΦ_mono g₁.unop h₃
            simp only [dif_pos h₃, dif_pos h₂]
            have hcomp : (liftMap (g₁ ≫ g₂).unop h₃).op =
                (liftMap g₁.unop h₃).op ≫ (liftMap g₂.unop h₂).op :=
              congrArg Quiver.Hom.op (hLiftMap_comp g₂.unop g₁.unop h₃)
            rw [hcomp, P.map_comp]
            simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
          · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h₃))).eq_of_src _ _ }
    let j_pre : (O.toScheme.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      { obj := j_obj
        map := fun {P₁ P₂} α =>
          { app := fun opT =>
              if h : Φ opT.unop then
                eqToHom (dif_pos h) ≫ α.app (Opposite.op (liftObj opT.unop h)) ≫
                  eqToHom (dif_pos h :
                    (j_obj P₂).obj opT = P₂.obj (Opposite.op (liftObj opT.unop h))).symm
              else 0
            naturality := fun {opT₂ opT₁} g => by
              by_cases h₂ : Φ opT₂.unop
              · have h₁ : Φ opT₁.unop := hΦ_mono g.unop h₂
                dsimp [j_obj]
                simp only [dif_pos h₂, dif_pos h₁, Category.assoc, eqToHom_trans_assoc,
                  eqToHom_refl, Category.id_comp]
                rw [← Category.assoc (P₁.map _), α.naturality, Category.assoc]
              · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h₂))).eq_of_src _ _ }
        map_id := fun _ => NatTrans.ext (funext fun opT => by
          by_cases h : Φ opT.unop
          · dsimp; simp only [dif_pos h, Category.id_comp, eqToHom_trans]; exact eqToHom_refl _ _
          · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h))).eq_of_src _ _)
        map_comp := fun {_ _ _} _ _ => NatTrans.ext (funext fun opT => by
          by_cases h : Φ opT.unop
          · dsimp; simp only [dif_pos h, Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
          · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h))).eq_of_src _ _) }
    let R_pre : (Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (O.toScheme.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      (Functor.whiskeringLeft O.toScheme.Etaleᵒᵖ Y.Etaleᵒᵖ AddCommGrpCat.{u}).obj E_O.op
    let adj_pre : j_pre ⊣ R_pre := Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun P =>
              { app := fun opY =>
                  P.map (counitLiftIso opY.unop).hom.op ≫
                    eqToHom (dif_pos (hEO opY.unop) :
                      (if h : Φ (E_O.obj opY.unop) then
                        P.obj (Opposite.op (liftObj (E_O.obj opY.unop) h)) else (0 : AddCommGrpCat.{u})) =
                        P.obj (Opposite.op (liftObj (E_O.obj opY.unop) (hEO opY.unop)))).symm
                naturality := fun {opY₂ opY₁} g => by
                  dsimp [R_pre, j_pre, j_obj]
                  simp only [dif_pos (hEO opY₂.unop), Category.assoc, eqToHom_trans_assoc,
                    eqToHom_refl, Category.id_comp]
                  rw [← Category.assoc, ← P.map_comp, ← Category.assoc, ← P.map_comp]
                  exact congrArg (· ≫ _) (congrArg P.map (Opposite.unop_injective
                    (MorphismProperty.Comma.Hom.ext
                      ((Category.id_comp _).trans (Category.comp_id _).symm)
                      (Subsingleton.elim _ _)))) }
            naturality := fun {_ _} α => NatTrans.ext (funext fun opY => by
              dsimp [R_pre, j_pre, j_obj]
              simp only [dif_pos (hEO opY.unop), Category.assoc, eqToHom_trans_assoc,
                eqToHom_refl, Category.id_comp]
              exact ((Category.assoc _ _ _).symm).trans
                ((congrArg (· ≫ _) (α.naturality _).symm).trans (Category.assoc _ _ _))) }
        counit :=
          { app := fun Q =>
              { app := fun opT =>
                  if h : Φ opT.unop then
                    eqToHom (dif_pos h) ≫ Q.map (liftIso opT.unop h).inv.op
                  else 0
                naturality := fun {opT₂ opT₁} g => by
                  by_cases h₂ : Φ opT₂.unop
                  · have h₁ : Φ opT₁.unop := hΦ_mono g.unop h₂
                    dsimp [R_pre, j_pre, j_obj]
                    simp only [dif_pos h₂, dif_pos h₁, Category.assoc, eqToHom_trans_assoc,
                      eqToHom_refl, Category.id_comp]
                    rw [← Q.map_comp, ← Q.map_comp]
                    exact congrArg (eqToHom (dif_pos h₂) ≫ ·) (congrArg Q.map
                      (Opposite.unop_injective
                        (MorphismProperty.Comma.Hom.ext
                          ((Category.id_comp _).trans (Category.comp_id _).symm)
                          (Subsingleton.elim _ _))))
                  · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h₂))).eq_of_src _ _ }
            naturality := fun {_ _} β => NatTrans.ext (funext fun opT => by
              by_cases h : Φ opT.unop
              · dsimp [R_pre, j_pre, j_obj]
                simp only [dif_pos h, Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
                exact congrArg (eqToHom (dif_pos h) ≫ ·) (β.naturality _).symm
              · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h))).eq_of_src _ _) }
        left_triangle := NatTrans.ext (funext fun P => NatTrans.ext (funext fun opT => by
          by_cases h : Φ opT.unop
          · dsimp [R_pre, j_pre, j_obj]
            simp only [dif_pos h, dif_pos (hEO (liftObj opT.unop h)), Category.assoc,
              eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
            have h_id : liftMap (liftIso opT.unop h).inv (hEO (liftObj opT.unop h)) ≫
                (counitLiftIso (liftObj opT.unop h)).hom = 𝟙 (liftObj opT.unop h) :=
              MorphismProperty.Comma.Hom.ext
                ((Category.comp_id _).trans (Iso.refl_inv _)) (Subsingleton.elim _ _)
            rw [← Category.assoc (P.map _), ← P.map_comp, ← CategoryTheory.op_comp, h_id,
              CategoryTheory.op_id, P.map_id, Category.id_comp, eqToHom_trans]
            exact eqToHom_refl _ _
          · exact ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h))).eq_of_src _ _))
        right_triangle := NatTrans.ext (funext fun Q => NatTrans.ext (funext fun opY => by
          dsimp [R_pre, j_pre, j_obj]
          simp only [dif_pos (hEO opY.unop), Category.assoc, eqToHom_trans_assoc,
            eqToHom_refl, Category.id_comp]
          have h_id : (liftIso (E_O.obj opY.unop) (hEO opY.unop)).inv ≫
              E_O.map (counitLiftIso opY.unop).hom = 𝟙 (E_O.obj opY.unop) :=
            MorphismProperty.Comma.Hom.ext
              ((Category.comp_id _).trans (Iso.refl_inv _)) (Subsingleton.elim _ _)
          rw [← Q.map_comp, ← CategoryTheory.op_comp, h_id, CategoryTheory.op_id, Q.map_id])) }
    have _ : Limits.PreservesFiniteLimits j_pre := by
      refine preservesFiniteLimits_of_evaluation j_pre fun opT => ?_
      by_cases h : Φ opT.unop
      · let iso_ev : j_pre ⋙ (evaluation Y.Etaleᵒᵖ AddCommGrpCat.{u}).obj opT ≅
            (evaluation O.toScheme.Etaleᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op (liftObj opT.unop h)) :=
          NatIso.ofComponents (fun P => eqToIso (dif_pos h)) (fun {_ _} _ => by
            dsimp [j_pre]
            simp only [dif_pos h, Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id])
        exact Limits.preservesFiniteLimits_of_natIso iso_ev.symm
      · let iso_zero : j_pre ⋙ (evaluation Y.Etaleᵒᵖ AddCommGrpCat.{u}).obj opT ≅
            (Functor.const _).obj (0 : AddCommGrpCat.{u}) :=
          NatIso.ofComponents (fun _ => eqToIso (dif_neg h)) (fun {_ _} _ =>
            ((Limits.isZero_zero AddCommGrpCat.{u}).of_iso (eqToIso (dif_neg h))).eq_of_src _ _)
        have _ : Limits.PreservesFiniteLimits
            ((Functor.const (O.toScheme.Etaleᵒᵖ ⥤ AddCommGrpCat.{u})).obj (0 : AddCommGrpCat.{u})) :=
          ⟨fun _ _ _ => ⟨fun {_} => ⟨fun {_} _ => ⟨
            { lift := fun _ => 0
              fac := fun _ _ => (Limits.isZero_zero AddCommGrpCat.{u}).eq_of_tgt _ _
              uniq := fun _ _ _ => (Limits.isZero_zero AddCommGrpCat.{u}).eq_of_tgt _ _ }⟩⟩⟩⟩
        exact Limits.preservesFiniteLimits_of_natIso iso_zero.symm
    let j_sh : Sheaf O.toScheme.smallEtaleTopology AddCommGrpCat.{u} ⥤
        Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
      sheafToPresheaf O.toScheme.smallEtaleTopology AddCommGrpCat.{u} ⋙ j_pre ⋙
        presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
    have _ : Limits.PreservesFiniteLimits (j_pre ⋙ presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}) :=
      Limits.comp_preservesFiniteLimits _ _
    have _ : Limits.PreservesFiniteLimits j_sh := Limits.comp_preservesFiniteLimits _ _
    have _ : j_sh.PreservesMonomorphisms := inferInstance
    let adj_sh_Y := sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}
    let ff_O := fullyFaithfulSheafToPresheaf O.toScheme.smallEtaleTopology AddCommGrpCat.{u}
    let adj_jsh : j_sh ⊣ resEtale ho := Adjunction.mkOfHomEquiv
      { homEquiv := fun F G =>
          (adj_sh_Y.homEquiv (j_pre.obj F.obj) G).trans
            ((adj_pre.homEquiv F.obj G.obj).trans (ff_O.homEquiv (X := F) (Y := (resEtale ho).obj G)).symm)
        homEquiv_naturality_left_symm := fun {F' F G} f₀ g₀ => by
          apply (adj_sh_Y.homEquiv (j_pre.obj F'.obj) G).injective
          have hL : (adj_sh_Y.homEquiv (j_pre.obj F'.obj) G)
              (((adj_sh_Y.homEquiv (j_pre.obj F'.obj) G).trans
                ((adj_pre.homEquiv F'.obj G.obj).trans
                  (ff_O.homEquiv (X := F') (Y := (resEtale ho).obj G)).symm)).symm (f₀ ≫ g₀)) =
              (adj_pre.homEquiv F'.obj G.obj).symm (f₀.hom ≫ g₀.hom) :=
            (adj_sh_Y.homEquiv (j_pre.obj F'.obj) G).apply_symm_apply _
          have hR₁ := adj_sh_Y.homEquiv_naturality_left (j_pre.map f₀.hom)
            ((adj_sh_Y.homEquiv (j_pre.obj F.obj) G).symm ((adj_pre.homEquiv F.obj G.obj).symm g₀.hom))
          have hR₂ : (adj_sh_Y.homEquiv (j_pre.obj F.obj) G)
              ((adj_sh_Y.homEquiv (j_pre.obj F.obj) G).symm
                ((adj_pre.homEquiv F.obj G.obj).symm g₀.hom)) =
              (adj_pre.homEquiv F.obj G.obj).symm g₀.hom :=
            (adj_sh_Y.homEquiv (j_pre.obj F.obj) G).apply_symm_apply _
          exact hL.trans ((adj_pre.homEquiv_naturality_left_symm f₀.hom g₀.hom).trans
            ((congrArg (j_pre.map f₀.hom ≫ ·) hR₂.symm).trans hR₁.symm))
        homEquiv_naturality_right := fun {F G G'} f₀ g₀ => by
          apply ff_O.map_injective
          exact (congrArg (adj_pre.homEquiv F.obj G'.obj)
            (adj_sh_Y.homEquiv_naturality_right f₀ g₀)).trans
            (adj_pre.homEquiv_naturality_right _ g₀.hom) }
    obtain ⟨hAdd_O, hLim_O, hColim_O⟩ := hResExact ho
    exact ⟨hLim_O, hColim_O, hAdd_O, fun J _ => Injective.injective_of_adjoint adj_jsh J⟩

  have hDegZero : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      Nonempty (Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology 0 ≅
        sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u}) := by
    clear * -
    intro Y
    let J := Y.smallEtaleTopology
    let P_free : Y.Etale → (Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      fun T => yoneda.obj T ⋙ AddCommGrpCat.free
    let R_sh : Y.Etale → Sheaf J AddCommGrpCat.{u} :=
      fun T => (presheafToSheaf J AddCommGrpCat.{u}).obj (P_free T)
    let r_map : ∀ {T₁ T₂ : Y.Etale}, (T₂ ⟶ T₁) → (R_sh T₂ ⟶ R_sh T₁) :=
      fun u => (presheafToSheaf J AddCommGrpCat.{u}).map
        (Functor.whiskerRight (yoneda.map u) AddCommGrpCat.free)
    let equiv_hom : ∀ (T : Y.Etale) (G : Sheaf J AddCommGrpCat.{u}),
        (R_sh T ⟶ G) ≃ ↥(G.obj.obj (Opposite.op T)) :=
      fun T G =>
        ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T) G).trans
          (((AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv (yoneda.obj T) G.obj).trans yonedaEquiv)
    let z_univ : ∀ (T : Y.Etale), ↥((R_sh T).obj.obj (Opposite.op T)) :=
      fun T => equiv_hom T (R_sh T) (𝟙 (R_sh T))
    have h_eval : ∀ (T : Y.Etale) {G : Sheaf J AddCommGrpCat.{u}} (φ : R_sh T ⟶ G),
        equiv_hom T G φ = φ.hom.app (Opposite.op T) (z_univ T) := by
      intro T G φ
      have h1 := (sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv_naturality_right
        (X := P_free T) (𝟙 (R_sh T)) φ
      rw [Category.id_comp] at h1
      let α₀ := (sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T) (R_sh T) (𝟙 (R_sh T))
      have h2 := (AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv_naturality_right
        (X := yoneda.obj T) α₀ ((sheafToPresheaf J AddCommGrpCat.{u}).map φ)
      dsimp [equiv_hom, z_univ]
      rw [h1]
      exact congrArg yonedaEquiv h2
    have h_rmap_z : ∀ {T₁ T₂ : Y.Etale} (u : T₂ ⟶ T₁),
        (r_map u).hom.app (Opposite.op T₂) (z_univ T₂) =
          (R_sh T₁).obj.map u.op (z_univ T₁) := by
      intro T₁ T₂ u
      rw [← h_eval T₂ (r_map u)]
      let F_free := (Functor.whiskeringRight Y.Etaleᵒᵖ (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
      have h1 := (congrArg ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv
          (F_free.obj (yoneda.obj T₂)) (R_sh T₁)) (Category.comp_id _).symm).trans
        ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv_naturality_left
          (F_free.map (yoneda.map u)) (𝟙 (R_sh T₁)))
      let α₁ := (sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T₁) (R_sh T₁) (𝟙 (R_sh T₁))
      have h2 := (AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv_naturality_left (yoneda.map u) α₁
      let β₁ := (AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv (yoneda.obj T₁) (R_sh T₁).obj α₁
      have h12 : yonedaEquiv (((AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv
          (yoneda.obj T₂) (R_sh T₁).obj)
          ((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv (P_free T₂) (R_sh T₁) (r_map u))) =
          yonedaEquiv (yoneda.map u ≫ β₁) :=
        congrArg yonedaEquiv ((congrArg ((AddCommGrpCat.adj.whiskerRight Y.Etaleᵒᵖ).homEquiv
          (yoneda.obj T₂) (R_sh T₁).obj) h1).trans h2)
      dsimp [equiv_hom, z_univ]
      rw [h12]
      change β₁.app (Opposite.op T₂) (𝟙 T₂ ≫ u) = ((R_sh T₁).obj.map u.op) (β₁.app (Opposite.op T₁) (𝟙 T₁))
      have hnat := congrArg (fun g => g (𝟙 T₁)) (β₁.naturality u.op)
      dsimp [yoneda] at hnat
      rw [Category.comp_id] at hnat
      rw [Category.id_comp]
      exact hnat
    let addEquiv_TG : ∀ (T : Y.Etale) (G : Sheaf J AddCommGrpCat.{u}),
        Abelian.Ext (R_sh T) G 0 ≃+ ↥(G.obj.obj (Opposite.op T)) :=
      fun T G =>
        Abelian.Ext.addEquiv₀.trans
          { equiv_hom T G with
            map_add' := fun f₁ f₂ => by
              change equiv_hom T G (f₁ + f₂) = equiv_hom T G f₁ + equiv_hom T G f₂
              rw [h_eval, h_eval, h_eval]; rfl }
    let iso_TG : ∀ (T : Y.Etale) (G : Sheaf J AddCommGrpCat.{u}),
        ((Sheaf.cohomologyPresheafFunctor J 0).obj G).obj (Opposite.op T) ≅
          G.obj.obj (Opposite.op T) :=
      fun T G =>
        { hom := AddCommGrpCat.ofHom (addEquiv_TG T G).toAddMonoidHom
          inv := AddCommGrpCat.ofHom (addEquiv_TG T G).symm.toAddMonoidHom
          hom_inv_id := AddCommGrpCat.ext fun x => (addEquiv_TG T G).symm_apply_apply x
          inv_hom_id := AddCommGrpCat.ext fun y => (addEquiv_TG T G).apply_symm_apply y }
    refine ⟨NatIso.ofComponents
      (fun G => NatIso.ofComponents (fun opT => iso_TG opT.unop G) (fun {opT₁ opT₂} v =>
        AddCommGrpCat.ext fun x => by
          dsimp [iso_TG, addEquiv_TG]
          change equiv_hom opT₂.unop G (Abelian.Ext.homEquiv₀
              ((Abelian.Ext.mk₀ (r_map v.unop)).comp x (Nat.zero_add 0))) =
            G.obj.map v (equiv_hom opT₁.unop G (Abelian.Ext.homEquiv₀ x))
          have hx : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x) = x :=
            Abelian.Ext.homEquiv₀.symm_apply_apply x
          have hcomp : Abelian.Ext.homEquiv₀
              ((Abelian.Ext.mk₀ (r_map v.unop)).comp x (Nat.zero_add 0)) =
              r_map v.unop ≫ Abelian.Ext.homEquiv₀ x := by
            conv_lhs => rw [← hx, Abelian.Ext.mk₀_comp_mk₀]
            exact Abelian.Ext.homEquiv₀.apply_symm_apply _
          rw [hcomp, h_eval, h_eval]
          change (Abelian.Ext.homEquiv₀ x).hom.app (Opposite.op opT₂.unop)
              ((r_map v.unop).hom.app (Opposite.op opT₂.unop) (z_univ opT₂.unop)) = _
          rw [h_rmap_z v.unop]
          exact congrArg (fun g : (R_sh opT₁.unop).obj.obj opT₁ ⟶ G.obj.obj opT₂ => g (z_univ opT₁.unop))
            ((Abelian.Ext.homEquiv₀ x).hom.naturality v)))
      (fun {G₁ G₂} ψ => NatTrans.ext (funext fun opT => AddCommGrpCat.ext fun x => by
        dsimp [iso_TG, addEquiv_TG]
        change equiv_hom opT.unop G₂ (Abelian.Ext.homEquiv₀
            (x.comp (Abelian.Ext.mk₀ ψ) (Nat.add_zero 0))) =
          ψ.hom.app opT (equiv_hom opT.unop G₁ (Abelian.Ext.homEquiv₀ x))
        have hx : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x) = x :=
          Abelian.Ext.homEquiv₀.symm_apply_apply x
        have hcomp : Abelian.Ext.homEquiv₀ (x.comp (Abelian.Ext.mk₀ ψ) (Nat.add_zero 0)) =
            Abelian.Ext.homEquiv₀ x ≫ ψ := by
          conv_lhs => rw [← hx, Abelian.Ext.mk₀_comp_mk₀]
          exact Abelian.Ext.homEquiv₀.apply_symm_apply _
        rw [hcomp, h_eval, h_eval]; rfl))⟩

  have hu_et : AlgebraicGeometry.Etale U.ι := inferInstance
  have hv_et : AlgebraicGeometry.Etale V_Z.ι := inferInstance
  have hOpenHDI : Nonempty ((resEtale hu_et).obj
      (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z m)) ≅
      weilEtaleHigherDirectImage f_U q (weilEtaleTorsionSheaf V_U m)) := by
    clear * - hEtComp hEtPb hEtBC m q Z S f U U₀ V_Z V_U f_U hu_et hv_et
      siteMap hOpenCont resEtale hExtByZero hResShComm hDegZero hResConst
    let E_U : Functor U₀.Etale S.Etale := siteMap hu_et
    let E_V : Functor V_U.Etale Z.Etale := siteMap hv_et
    let _ := hOpenCont hu_et; let _ := hOpenCont hv_et
    obtain ⟨hLim_V, hColim_V, hAdd_V, hInj_V⟩ := hExtByZero V_Z
    have _ := hLim_V; have _ := hColim_V; have _ := hAdd_V
    obtain ⟨σ_sh⟩ := hResShComm hu_et
    let B_f : Functor S.Etale Z.Etale := weilEtaleSitePullback f
    let B_fU : Functor U₀.Etale V_U.Etale := weilEtaleSitePullback f_U
    let hpb_T : ∀ (T : U₀.Etale),
        IsPullback (Limits.pullback.fst T.hom f_U)
          (Limits.pullback.snd T.hom f_U ≫ V_Z.ι) (T.hom ≫ U.ι) f :=
      fun T => (IsPullback.of_hasPullback T.hom f_U).paste_vert
        (AlgebraicGeometry.isPullback_morphismRestrict f U)
    let iso_T : ∀ (T : U₀.Etale), E_V.obj (B_fU.obj T) ≅ B_f.obj (E_U.obj T) :=
      fun T => MorphismProperty.Over.isoMk (hpb_T T).isoPullback (hpb_T T).isoPullback_hom_snd
    let e_EB : B_fU ⋙ E_V ≅ E_U ⋙ B_f :=
      NatIso.ofComponents iso_T (fun {T₁ T₂} u => by
        apply MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
        apply Limits.pullback.hom_ext
        · have hL : (((B_fU ⋙ E_V).map u) ≫ (iso_T T₂).hom).left ≫
              Limits.pullback.fst (T₂.hom ≫ U.ι) f =
              Limits.pullback.fst T₁.hom f_U ≫ u.left :=
            (Category.assoc _ _ _).trans
              ((congrArg ((B_fU.map u).left ≫ ·) (hpb_T T₂).isoPullback_hom_fst).trans
                (Limits.pullback.lift_fst _ _ _))
          have hR : ((iso_T T₁).hom ≫ ((E_U ⋙ B_f).map u)).left ≫
              Limits.pullback.fst (T₂.hom ≫ U.ι) f =
              Limits.pullback.fst T₁.hom f_U ≫ u.left :=
            (Category.assoc _ _ _).trans
              ((congrArg ((hpb_T T₁).isoPullback.hom ≫ ·) (Limits.pullback.lift_fst _ _ _)).trans
                ((Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ u.left) (hpb_T T₁).isoPullback_hom_fst)))
          exact hL.trans hR.symm
        · have hL : (((B_fU ⋙ E_V).map u) ≫ (iso_T T₂).hom).left ≫
              Limits.pullback.snd (T₂.hom ≫ U.ι) f =
              Limits.pullback.snd T₁.hom f_U ≫ V_Z.ι :=
            (Category.assoc _ _ _).trans
              ((congrArg ((B_fU.map u).left ≫ ·) (hpb_T T₂).isoPullback_hom_snd).trans
                ((Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ V_Z.ι) (Limits.pullback.lift_snd _ _ _))))
          have hR : ((iso_T T₁).hom ≫ ((E_U ⋙ B_f).map u)).left ≫
              Limits.pullback.snd (T₂.hom ≫ U.ι) f =
              Limits.pullback.snd T₁.hom f_U ≫ V_Z.ι :=
            (Category.assoc _ _ _).trans
              ((congrArg ((hpb_T T₁).isoPullback.hom ≫ ·) (Limits.pullback.lift_snd _ _ _)).trans
                (hpb_T T₁).isoPullback_hom_snd)
          exact hL.trans hR.symm)
    obtain ⟨α₀_Z⟩ := hDegZero Z
    obtain ⟨α₀_V⟩ := hDegZero V_U
    let R_EV := (Functor.whiskeringLeft V_U.Etaleᵒᵖ Z.Etaleᵒᵖ AddCommGrpCat.{u}).obj E_V.op
    let τ₀ : Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology 0 ⋙ R_EV ≅
        resEtale hv_et ⋙ Sheaf.cohomologyPresheafFunctor V_U.smallEtaleTopology 0 :=
      Functor.isoWhiskerRight α₀_Z R_EV ≪≫
        NatIso.ofComponents (fun _ => Iso.refl _) (fun _ =>
          (Category.comp_id _).trans (Category.id_comp _).symm) ≪≫
        Functor.isoWhiskerLeft (resEtale hv_et) α₀_V.symm
    let R_sh_of : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (T : Y.Etale),
        Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
      fun Y T => (presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
        (yoneda.obj T ⋙ AddCommGrpCat.free)
    let δ_pre : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        {SC : ShortComplex (Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})}
        (hSE : SC.ShortExact) (deg : ℕ),
        (Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology deg).obj SC.X₃ ⟶
          (Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology (deg + 1)).obj SC.X₁ :=
      fun Y {SC} hSE deg =>
        { app := fun opT => AddCommGrpCat.ofHom (hSE.extClass.postcomp (R_sh_of Y opT.unop) rfl)
          naturality := fun {opT₁ opT₂} v => AddCommGrpCat.ext fun x =>
            Abelian.Ext.comp_assoc _ x hSE.extClass (Nat.zero_add deg) rfl (Nat.zero_add (deg + 1)) }
    have hNatCokernel : ∀ {C₀ : Type (u + 1)} [Category.{u, u + 1} C₀]
        {F₁ F₂ F₃ : C₀ ⥤ AddCommGrpCat.{u}} (f₁ : F₁ ⟶ F₂) (g₁ : F₂ ⟶ F₃) (h0 : f₁ ≫ g₁ = 0),
        (∀ X, Epi (g₁.app X)) →
        (∀ X, Limits.IsColimit (Limits.CokernelCofork.ofπ (g₁.app X)
          (congrArg (fun α => α.app X) h0))) →
        Nonempty (Limits.cokernel f₁ ≅ F₃) := by
      intro C₀ _ F₁ F₂ F₃ f₁ g₁ h0 hEpi hc
      let colim : Limits.IsColimit (Limits.CokernelCofork.ofπ g₁ h0) :=
        Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun {Z'} k_hom hk =>
            { app := fun X => (hc X).desc (Limits.CokernelCofork.ofπ (k_hom.app X)
                (congrArg (fun α => α.app X) hk))
              naturality := fun {X₁ X₂} w => by
                have _ : Epi (g₁.app X₁) := hEpi X₁
                apply (cancel_epi (g₁.app X₁)).mp
                have hf₁ := (hc X₁).fac (Limits.CokernelCofork.ofπ (k_hom.app X₁)
                  (congrArg (fun α => α.app X₁) hk)) Limits.WalkingParallelPair.one
                have hf₂ := (hc X₂).fac (Limits.CokernelCofork.ofπ (k_hom.app X₂)
                  (congrArg (fun α => α.app X₂) hk)) Limits.WalkingParallelPair.one
                dsimp at hf₁ hf₂ ⊢
                rw [← Category.assoc, ← g₁.naturality w, Category.assoc, hf₂,
                  k_hom.naturality w, ← Category.assoc, hf₁] })
          (fun {Z'} k_hom hk => NatTrans.ext (funext fun X =>
            (hc X).fac (Limits.CokernelCofork.ofπ (k_hom.app X)
              (congrArg (fun α => α.app X) hk)) Limits.WalkingParallelPair.one))
          (fun {Z'} k_hom hk m_hom hm => NatTrans.ext (funext fun X => by
            have _ : Epi (g₁.app X) := hEpi X
            apply (cancel_epi (g₁.app X)).mp
            exact (congrArg (fun α => α.app X) hm).trans
              ((hc X).fac (Limits.CokernelCofork.ofπ (k_hom.app X)
                (congrArg (fun α => α.app X) hk)) Limits.WalkingParallelPair.one).symm))
      exact ⟨(Limits.colimit.isColimit (Limits.parallelPair f₁ 0)).coconePointUniqueUpToIso colim⟩
    have hConnIso : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        {SC : ShortComplex (Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})}
        (hSE : SC.ShortExact) [Injective SC.X₂] (k₀ : ℕ),
        IsIso (δ_pre Y hSE (k₀ + 1)) := by
      intro Y SC hSE _ k₀
      have _ : ∀ opT, IsIso ((δ_pre Y hSE (k₀ + 1)).app opT) := fun opT => by
        have _ : Mono ((δ_pre Y hSE (k₀ + 1)).app opT) := by
          rw [AddCommGrpCat.mono_iff_injective]
          intro a b hab
          have hsub : (a - b).comp hSE.extClass (rfl : (k₀ + 1) + 1 = k₀ + 2) = 0 := by
            change (δ_pre Y hSE (k₀ + 1)).app opT (a - b) = 0
            rw [map_sub, hab, sub_self]
          obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃
            (R_sh_of Y opT.unop) hSE (a - b) rfl hsub
          have hx₂0 : x₂ = 0 := Abelian.Ext.eq_zero_of_injective x₂
          rw [hx₂0, Abelian.Ext.zero_comp] at hx₂
          exact sub_eq_zero.mp hx₂.symm
        have _ : Epi ((δ_pre Y hSE (k₀ + 1)).app opT) := by
          rw [AddCommGrpCat.epi_iff_surjective]
          intro x₁
          have hz : x₁.comp (Abelian.Ext.mk₀ SC.f) (Nat.add_zero (k₀ + 2)) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          exact Abelian.Ext.covariant_sequence_exact₁ (R_sh_of Y opT.unop) hSE x₁ hz rfl
        exact Balanced.isIso_of_mono_of_epi _
      exact NatIso.isIso_of_isIso_app (δ_pre Y hSE (k₀ + 1))
    have hCohIso : ∀ (n : ℕ) (M : Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty ((E_V.op ⋙ Sheaf.cohomologyPresheaf M n) ≅
          Sheaf.cohomologyPresheaf ((resEtale hv_et).obj M) n) := by
      intro n
      induction n with
      | zero => exact fun M => ⟨τ₀.app M⟩
      | succ m₀ ih =>
        intro M
        let J_inj := Injective.under M
        let u_M : M ⟶ J_inj := Injective.ι M
        let v_M : J_inj ⟶ Limits.cokernel u_M := Limits.cokernel.π u_M
        let SC : ShortComplex (Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
          ShortComplex.mk u_M v_M (Limits.cokernel.condition u_M)
        have hSE : SC.ShortExact :=
          { exact := ShortComplex.exact_of_g_is_cokernel SC (Limits.cokernelIsCokernel u_M) }
        let SC_V := SC.map (resEtale hv_et)
        have hSE_V : SC_V.ShortExact := hSE.map_of_exact (resEtale hv_et)
        have hInj_JV : Injective SC_V.X₂ := hInj_V J_inj
        cases m₀ with
        | zero =>
          let f_Z := (Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology 0).map SC.g
          let g_Z := δ_pre Z hSE 0
          have h0_Z : R_EV.map f_Z ≫ R_EV.map g_Z = 0 :=
            NatTrans.ext (funext fun opW =>
              (fun {S₀ : ShortComplex AddCommGrpCat.{u}} (_ : S₀.Exact) => S₀.zero)
                (Abelian.Ext.covariant_sequence_exact₃' (R_sh_of Z (E_V.obj opW.unop)) hSE 0 1 rfl))
          let f_V := (Sheaf.cohomologyPresheafFunctor V_U.smallEtaleTopology 0).map SC_V.g
          let g_V := δ_pre V_U hSE_V 0
          have h0_V : f_V ≫ g_V = 0 :=
            NatTrans.ext (funext fun opW =>
              (fun {S₀ : ShortComplex AddCommGrpCat.{u}} (_ : S₀.Exact) => S₀.zero)
                (Abelian.Ext.covariant_sequence_exact₃' (R_sh_of V_U opW.unop) hSE_V 0 1 rfl))
          have hEpi_Z : ∀ (opW : V_U.Etaleᵒᵖ), Epi (AddCommGrpCat.ofHom
              (hSE.extClass.postcomp (R_sh_of Z (E_V.obj opW.unop)) (rfl : 0 + 1 = 1))) := fun opW => by
            rw [AddCommGrpCat.epi_iff_surjective]
            intro x₁
            exact Abelian.Ext.covariant_sequence_exact₁ (R_sh_of Z (E_V.obj opW.unop)) hSE x₁
              (Abelian.Ext.eq_zero_of_injective _) rfl
          have hEpi_V : ∀ (opW : V_U.Etaleᵒᵖ), Epi (AddCommGrpCat.ofHom
              (hSE_V.extClass.postcomp (R_sh_of V_U opW.unop) (rfl : 0 + 1 = 1))) := fun opW => by
            rw [AddCommGrpCat.epi_iff_surjective]
            intro x₁
            have _ : Injective SC_V.X₂ := hInj_JV
            exact Abelian.Ext.covariant_sequence_exact₁ (R_sh_of V_U opW.unop) hSE_V x₁
              (Abelian.Ext.eq_zero_of_injective _) rfl
          let hc_Z : ∀ opW, Limits.IsColimit
              (Limits.CokernelCofork.ofπ ((R_EV.map g_Z).app opW)
                (congrArg (fun α => α.app opW) h0_Z)) := fun opW => by
            have _ := hEpi_Z opW
            exact (Abelian.Ext.covariant_sequence_exact₃'
              (R_sh_of Z (E_V.obj opW.unop)) hSE 0 1 rfl).gIsCokernel
          let hc_V : ∀ opW, Limits.IsColimit
              (Limits.CokernelCofork.ofπ (g_V.app opW)
                (congrArg (fun α => α.app opW) h0_V)) := fun opW => by
            have _ := hEpi_V opW
            exact (Abelian.Ext.covariant_sequence_exact₃'
              (R_sh_of V_U opW.unop) hSE_V 0 1 rfl).gIsCokernel
          obtain ⟨e_cok₁⟩ := hNatCokernel (R_EV.map f_Z) (R_EV.map g_Z) h0_Z hEpi_Z hc_Z
          obtain ⟨e_cok₂⟩ := hNatCokernel f_V g_V h0_V hEpi_V hc_V
          let e_mid := Limits.cokernel.mapIso (R_EV.map f_Z) f_V
            (τ₀.app SC.X₂) (τ₀.app SC.X₃) (τ₀.hom.naturality SC.g)
          exact ⟨e_cok₁.symm ≪≫ e_mid ≪≫ e_cok₂⟩
        | succ k₀ =>
          have _ : IsIso (δ_pre Z hSE (k₀ + 1)) := hConnIso Z hSE k₀
          have _ : Injective SC_V.X₂ := hInj_JV
          have _ : IsIso (δ_pre V_U hSE_V (k₀ + 1)) := hConnIso V_U hSE_V k₀
          obtain ⟨e_ih⟩ := ih SC.X₃
          exact ⟨R_EV.mapIso (asIso (δ_pre Z hSE (k₀ + 1))).symm ≪≫ e_ih ≪≫
            asIso (δ_pre V_U hSE_V (k₀ + 1))⟩
    let G_Z := weilEtaleTorsionSheaf Z m
    obtain ⟨e_coh⟩ := hCohIso q G_Z
    let P_Z := Sheaf.cohomologyPresheaf G_Z q
    let e_EB_pre : E_U.op ⋙ (B_f.op ⋙ P_Z) ≅ B_fU.op ⋙ (E_V.op ⋙ P_Z) :=
      NatIso.ofComponents
        (fun opT =>
          { hom := P_Z.map (e_EB.hom.app opT.unop).op
            inv := P_Z.map (e_EB.inv.app opT.unop).op
            hom_inv_id := by
              rw [← P_Z.map_comp]
              have h1 : (e_EB.hom.app opT.unop).op ≫ (e_EB.inv.app opT.unop).op =
                  𝟙 (Opposite.op (B_f.obj (E_U.obj opT.unop))) :=
                Opposite.unop_injective (Iso.inv_hom_id_app e_EB opT.unop)
              exact (congrArg P_Z.map h1).trans (P_Z.map_id _)
            inv_hom_id := by
              rw [← P_Z.map_comp]
              have h1 : (e_EB.inv.app opT.unop).op ≫ (e_EB.hom.app opT.unop).op =
                  𝟙 (Opposite.op (E_V.obj (B_fU.obj opT.unop))) :=
                Opposite.unop_injective (Iso.hom_inv_id_app e_EB opT.unop)
              exact (congrArg P_Z.map h1).trans (P_Z.map_id _) })
        (fun {opT₁ opT₂} v => by
          change P_Z.map (B_f.map (E_U.map v.unop)).op ≫ P_Z.map (e_EB.hom.app opT₂.unop).op =
            P_Z.map (e_EB.hom.app opT₁.unop).op ≫ P_Z.map (E_V.map (B_fU.map v.unop)).op
          rw [← P_Z.map_comp, ← P_Z.map_comp]
          exact congrArg P_Z.map (congrArg Quiver.Hom.op (e_EB.hom.naturality v.unop).symm))
    obtain ⟨e_tors⟩ := hResConst hv_et
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
    let e_P_tors := (Sheaf.cohomologyPresheafFunctor V_U.smallEtaleTopology q).mapIso e_tors
    let e_pre : E_U.op ⋙ (B_f.op ⋙ P_Z) ≅ B_fU.op ⋙ Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf V_U m) q :=
      e_EB_pre ≪≫ Functor.isoWhiskerLeft B_fU.op (e_coh ≪≫ e_P_tors)
    exact ⟨σ_sh.app (B_f.op ⋙ P_Z) ≪≫
      (presheafToSheaf U₀.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_pre⟩

  obtain ⟨e_RU⟩ := hOpenHDI
  have hc_U : (weilEtaleSitePullback U.ι).IsContinuous S.smallEtaleTopology U₀.smallEtaleTopology :=
    hContB U.ι
  let _ := hc_U
  let _ := hOpenCont hu_et
  obtain ⟨_, ⟨adj_res_U⟩⟩ := hResAdj hu_et
  have hr_U : ((weilEtaleSitePullback U.ι).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology U₀.smallEtaleTopology).IsRightAdjoint :=
    adj_res_U.isRightAdjoint
  let _ := hr_U
  let adj_pb_U := (weilEtaleSitePullback U.ι).sheafAdjunctionContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology U₀.smallEtaleTopology
  let θ_U := adj_pb_U.leftAdjointUniq adj_res_U
  exact ⟨hc_U, hr_U, ⟨θ_U.app (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z m)) ≪≫ e_RU⟩⟩

theorem weil_bockstein_open_locConst_clopen_section_zero (k : Type u) [Field k]
    (S : AlgebraicGeometry.Scheme.{u})
    (U : S.Opens) [ConnectedSpace ↥U.toScheme]
    (u_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ S)
    (hu_mem : Set.range u_bar.base ⊆ (U : Set S))
    (ℛ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (hLocConst : ∀ x : ↥U.toScheme,
      ∃ (V : AlgebraicGeometry.Scheme.{u}) (w : V ⟶ U.toScheme) (A₀ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale w ∧
        x ∈ Set.range w.base ∧
        WeilIsEtaleSheafPullback (w ≫ U.ι) ℛ
          ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (φ : (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ ℛ)
    (h_ubar_zero :
      ∃ (hc_u : (weilEtaleSitePullback u_bar).IsContinuous
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
        (hr_u : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback u_bar) AddCommGrpCat.{u} _
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology hc_u).IsRightAdjoint),
        (@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback u_bar) AddCommGrpCat.{u} _
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology hc_u hr_u).map φ = 0)
    (W : S.Etale)
    (hW_sub : Set.range ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom.base ⊆ (U : Set S)) :
    φ.hom.app (Opposite.op W) = 0 :=
by
  classical
  let hFld_k := ‹Field k›
  have hConn_U := ‹ConnectedSpace ↥U.toScheme›
  have hEtComp : MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEtPb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have hEtBC : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  let U₀ : AlgebraicGeometry.Scheme.{u} := U.toScheme
  have hu_et : AlgebraicGeometry.Etale U.ι := inferInstance
  let siteMap : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (_ : AlgebraicGeometry.Etale w), Functor V.Etale X.Etale :=
    fun hw => MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hw

  have hTerm : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)) := by
    clear * -
    exact fun X =>
      Limits.IsTerminal.ofUniqueHom
        (fun Y => MorphismProperty.Over.homMk Y.hom (Category.comp_id Y.hom) trivial)
        (fun Y m => by
          apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact (Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m))

  have hMemEt : ∀ {X : AlgebraicGeometry.Scheme.{u}} (E : X.Etale) (R : Sieve E),
      R ∈ X.smallEtaleTopology E ↔
        ∀ (x : ↥E.left), ∃ (Y : X.Etale) (g : Y ⟶ E) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    clear * - hEtComp
    intro X E R
    change R ∈ Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) X E ↔ _
    rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X (le_refl _)]
    exact Scheme.mem_toGrothendieck_smallPretopology E R

  have hMorEt : ∀ {X : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : X.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    clear * -
    intro X Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := MorphismProperty.Over.w u
    have _ : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    have _ : AlgebraicGeometry.Etale Y₂.hom := Y₂.prop
    exact AlgebraicGeometry.Etale.of_comp u.left Y₂.hom

  have hContB : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology := by
    clear * - hEtComp hEtPb hEtBC hMemEt hMorEt
    intro Y₁ Y₂ h
    let B_h : Functor Y₂.Etale Y₁.Etale := weilEtaleSitePullback h
    have _ : Limits.PreservesFiniteLimits B_h :=
      MorphismProperty.Over.instPreservesFiniteLimitsTopPullback (@AlgebraicGeometry.Etale) h
    have _ : RepresentablyFlat B_h := flat_of_preservesFiniteLimits B_h
    have hCompat : CompatiblePreserving Y₁.smallEtaleTopology B_h :=
      compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h
    have hCov : CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
      refine ⟨fun {E} {R} hR => (hMemEt (B_h.obj E) _).mpr fun y => ?_⟩
      obtain ⟨V, u, v, huR, _, hv⟩ :=
        (hMemEt E R).mp hR ((Limits.pullback.fst E.hom h).base y)
      have hpb_top : IsPullback ((B_h.map u).left) (Limits.pullback.fst V.hom h)
          (Limits.pullback.fst E.hom h) u.left := by
        refine IsPullback.of_right ?_ (Limits.pullback.lift_fst _ _ _)
          (IsPullback.of_hasPullback E.hom h).flip
        have hw : u.left ≫ E.hom = V.hom := MorphismProperty.Over.w u
        have hsnd : (B_h.map u).left ≫ Limits.pullback.snd E.hom h =
            Limits.pullback.snd V.hom h := MorphismProperty.Over.w (B_h.map u)
        rw [hw, hsnd]
        exact (IsPullback.of_hasPullback V.hom h).flip
      let e_pb := hpb_top.isoPullback
      obtain ⟨z₀, hz₀_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback y v hv.symm
      refine ⟨B_h.obj V, B_h.map u, e_pb.inv.base z₀,
        ⟨V, u, 𝟙 (B_h.obj V), huR, (Category.id_comp _).symm⟩, hMorEt (B_h.map u), ?_⟩
      have hcomp : e_pb.inv ≫ (B_h.map u).left =
          Limits.pullback.fst (Limits.pullback.fst E.hom h) u.left :=
        (Iso.inv_comp_eq e_pb).mpr hpb_top.isoPullback_hom_fst.symm
      exact (Scheme.Hom.comp_apply e_pb.inv ((B_h.map u).left) z₀).symm.trans
        ((congrArg (fun g : _ ⟶ (B_h.obj E).left => g.base z₀) hcomp).trans hz₀_fst)
    exact Functor.isContinuous_of_coverPreserving hCompat hCov

  have hOpenCont : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (hw : AlgebraicGeometry.Etale w),
      (siteMap hw).IsContinuous V.smallEtaleTopology X.smallEtaleTopology := by
    clear * - hEtComp siteMap hMemEt hMorEt
    intro V X w hw
    let M_w : Functor V.Etale X.Etale := siteMap hw
    have hCompat : CompatiblePreserving X.smallEtaleTopology M_w := by
      refine CompatiblePreserving.mk ?_
      intro ℱ Y T x hx Y₁ Y₂ Z₀ f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      have hcomm_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun m => ((AlgebraicGeometry.Scheme.Etale.forget X).map m).left) hcomm
      have hf₁_et : AlgebraicGeometry.Etale f₁.left := hMorEt f₁
      have hZV_et : AlgebraicGeometry.Etale (f₁.left ≫ Y₁.hom) :=
        MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) f₁.left Y₁.hom hf₁_et Y₁.prop
      let Z_V : V.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) hZV_et
      let f₁_V : Z_V ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      have hw₂ : f₂.left ≫ Y₂.hom = Z_V.hom :=
        (congrArg (f₂.left ≫ ·) (MorphismProperty.Over.w g₂).symm).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ Y.hom) hcomm_left.symm).trans
              ((Category.assoc _ _ _).trans
                (congrArg (f₁.left ≫ ·) (MorphismProperty.Over.w g₁)))))
      let f₂_V : Z_V ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left hw₂ trivial
      have hfV_comm : f₁_V ≫ g₁ = f₂_V ≫ g₂ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget V).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact hcomm_left
      have hx_eq := hx f₁_V f₂_V hg₁ hg₂ hfV_comm
      have heZ_w : 𝟙 Z₀.left ≫ (M_w.obj Z_V).hom = Z₀.hom :=
        (Category.id_comp _).trans
          ((Category.assoc f₁.left Y₁.hom w).trans (MorphismProperty.Over.w f₁))
      let e_Z : Z₀ ⟶ M_w.obj Z_V := MorphismProperty.Over.homMk (𝟙 Z₀.left) heZ_w trivial
      have he₁ : e_Z ≫ M_w.map f₁_V = f₁ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact Category.id_comp f₁.left
      have he₂ : e_Z ≫ M_w.map f₂_V = f₂ := by
        apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact Category.id_comp f₂.left
      have hmap := congrArg (ℱ.obj.map e_Z.op) hx_eq
      change (ℱ.obj.map (M_w.map f₁_V).op ≫ ℱ.obj.map e_Z.op) (x g₁ hg₁) =
        (ℱ.obj.map (M_w.map f₂_V).op ≫ ℱ.obj.map e_Z.op) (x g₂ hg₂) at hmap
      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp] at hmap
      have hm₁ : ℱ.obj.map ((M_w.map f₁_V).op ≫ e_Z.op) = ℱ.obj.map f₁.op :=
        congrArg (fun g => ℱ.obj.map g.op) he₁
      have hm₂ : ℱ.obj.map ((M_w.map f₂_V).op ≫ e_Z.op) = ℱ.obj.map f₂.op :=
        congrArg (fun g => ℱ.obj.map g.op) he₂
      rwa [hm₁, hm₂] at hmap
    have hCov : CoverPreserving V.smallEtaleTopology X.smallEtaleTopology M_w := by
      refine ⟨fun {Y₀} {R} hR => (hMemEt (M_w.obj Y₀) _).mpr fun z => ?_⟩
      obtain ⟨Y, u, y, huR, huEt, hy⟩ := (hMemEt Y₀ R).mp hR z
      exact ⟨M_w.obj Y, M_w.map u, y, ⟨Y, u, 𝟙 (M_w.obj Y), huR, (Category.id_comp _).symm⟩, huEt, hy⟩
    exact Functor.isContinuous_of_coverPreserving hCompat hCov

  let resEtale := fun {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (hw : AlgebraicGeometry.Etale w) =>
    @Functor.sheafPushforwardContinuous _ _ _ _
      (siteMap hw) AddCommGrpCat.{u} _ V.smallEtaleTopology X.smallEtaleTopology (hOpenCont hw)

  have hResAdj : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
      (hw : AlgebraicGeometry.Etale w),
      let B_w : Functor X.Etale V.Etale := weilEtaleSitePullback w
      letI : B_w.IsContinuous X.smallEtaleTopology V.smallEtaleTopology := hContB w
      ∃ (_ : ((Functor.whiskeringLeft V.Etaleᵒᵖ X.Etaleᵒᵖ AddCommGrpCat.{u}).obj (siteMap hw).op) ⊣
          ((Functor.whiskeringLeft X.Etaleᵒᵖ V.Etaleᵒᵖ AddCommGrpCat.{u}).obj B_w.op)),
        Nonempty (resEtale hw ⊣ B_w.sheafPushforwardContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology V.smallEtaleTopology) := by
    clear * - hEtComp hEtPb hEtBC siteMap hContB hOpenCont resEtale
    intro V X w hw B_w
    let _ : B_w.IsContinuous X.smallEtaleTopology V.smallEtaleTopology := hContB w
    let _ := hOpenCont hw
    let adj_site : siteMap hw ⊣ B_w :=
      MorphismProperty.Over.mapPullbackAdj (@AlgebraicGeometry.Etale) ⊤ w hw trivial
    let R_M := (Functor.whiskeringLeft V.Etaleᵒᵖ X.Etaleᵒᵖ AddCommGrpCat.{u}).obj (siteMap hw).op
    let R_B := (Functor.whiskeringLeft X.Etaleᵒᵖ V.Etaleᵒᵖ AddCommGrpCat.{u}).obj B_w.op
    let adj_pre : R_M ⊣ R_B := Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun P =>
              { app := fun opT => P.map (adj_site.counit.app opT.unop).op
                naturality := fun {opT₂ opT₁} u =>
                  (P.map_comp _ _).symm.trans
                    ((congrArg P.map (Opposite.unop_injective (adj_site.counit.naturality u.unop).symm)).trans
                      (P.map_comp _ _)) }
            naturality := fun {_ _} α => NatTrans.ext (funext fun _ => (α.naturality _).symm) }
        counit :=
          { app := fun Q =>
              { app := fun opY => Q.map (adj_site.unit.app opY.unop).op
                naturality := fun {opY₂ opY₁} v =>
                  (Q.map_comp _ _).symm.trans
                    ((congrArg Q.map (Opposite.unop_injective (adj_site.unit.naturality v.unop).symm)).trans
                      (Q.map_comp _ _)) }
            naturality := fun {_ _} β => NatTrans.ext (funext fun _ => (β.naturality _).symm) }
        left_triangle := NatTrans.ext (funext fun P => NatTrans.ext (funext fun opY =>
          (Category.id_comp _).trans ((P.map_comp _ _).symm.trans
            ((congrArg P.map (Opposite.unop_injective (adj_site.left_triangle_components opY.unop))).trans
              (P.map_id _)))))
        right_triangle := NatTrans.ext (funext fun Q => NatTrans.ext (funext fun opT =>
          (Category.id_comp _).trans ((Q.map_comp _ _).symm.trans
            ((congrArg Q.map (Opposite.unop_injective (adj_site.right_triangle_components opT.unop))).trans
              (Q.map_id _))))) }
    let pf_w := B_w.sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology V.smallEtaleTopology
    let adj_sh : resEtale hw ⊣ pf_w := Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun F => { hom := adj_pre.unit.app F.obj }
            naturality := fun {_ _} α => Sheaf.hom_ext (adj_pre.unit.naturality α.hom) }
        counit :=
          { app := fun H => { hom := adj_pre.counit.app H.obj }
            naturality := fun {_ _} β => Sheaf.hom_ext (adj_pre.counit.naturality β.hom) }
        left_triangle := NatTrans.ext (funext fun F =>
          Sheaf.hom_ext (congrArg (fun η => η.app F.obj) adj_pre.left_triangle))
        right_triangle := NatTrans.ext (funext fun H =>
          Sheaf.hom_ext (congrArg (fun η => η.app H.obj) adj_pre.right_triangle)) }
    exact ⟨adj_pre, ⟨adj_sh⟩⟩

  have hPbToRes : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {e : V ⟶ X}
      (he : AlgebraicGeometry.Etale e)
      {ℱ : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      {𝒢 : Sheaf V.smallEtaleTopology AddCommGrpCat.{u}},
      WeilIsEtaleSheafPullback e ℱ 𝒢 → Nonempty ((resEtale he).obj ℱ ≅ 𝒢) := by
    clear * - hEtComp hEtPb hEtBC siteMap hContB hOpenCont resEtale hResAdj
    intro V X e he ℱ 𝒢 ⟨hc_e, hr_e, ⟨e_pb⟩⟩
    have hc_eq : hc_e = hContB e := Subsingleton.elim _ _
    subst hc_eq
    let _ := hContB e; let _ := hr_e
    obtain ⟨_, ⟨adj_res⟩⟩ := hResAdj he
    let B_e : Functor X.Etale V.Etale := weilEtaleSitePullback e
    let adj_pb := B_e.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology V.smallEtaleTopology
    let θ := adj_res.leftAdjointUniq adj_pb
    exact ⟨θ.app ℱ ≪≫ e_pb⟩

  let locConstPresheaf : ∀ (V : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
      Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
    fun V A =>
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun g => AddCommGrpCat.ofHom
          (LocallyConstant.comapAddMonoidHom (Z := ↥A) g.unop.left.base.hom)
        map_id := fun _ => AddCommGrpCat.ext fun _ => by ext; rfl
        map_comp := fun _ _ => AddCommGrpCat.ext fun _ => by ext; rfl }

  have hLocConstModel : ∀ (V : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
      ∃ (hSheaf : Presheaf.IsSheaf V.smallEtaleTopology (locConstPresheaf V A))
        (Υ : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A ≅
          ⟨locConstPresheaf V A, hSheaf⟩),
        ∀ (E : V.Etale) (a : ↥A),
          Υ.hom.hom.app (Opposite.op E)
            (((CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}).unit.app
              ((Functor.const (Opposite V.Etale)).obj A)).app (Opposite.op E) a) =
            LocallyConstant.const ↥E.left a := by
    clear * - hEtComp hEtPb hEtBC hMemEt hMorEt locConstPresheaf
    intro V A
    let P_A := locConstPresheaf V A
    let θ_A : (Functor.const (Opposite V.Etale)).obj A ⟶ P_A :=
      { app := fun E => AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => by ext; rfl }
    have hSheaf : Presheaf.IsSheaf V.smallEtaleTopology P_A := by
      clear * - hEtComp hEtPb hEtBC hMemEt hMorEt V A P_A
      rw [Presheaf.isSheaf_iff_isLimit]
      intro E S₀ hS₀
      have hcov := (hMemEt E S₀).mp hS₀
      let eval_c : ∀ (c : Limits.Cone (S₀.arrows.diagram.op ⋙ P_A))
          (w : S₀.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
        fun c w m => (c.π.app (Opposite.op w)).hom m
      have h_ov : ∀ (c : Limits.Cone (S₀.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S₀.arrows.category) (m : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m y₁ = eval_c c w₂ m y₂ := by
        intro c w₁ w₂ m y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := hMorEt u₂
        let Z_sch := Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : V.Etale := MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left := MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (MorphismProperty.Over.w u₂).symm).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) Limits.pullback.condition.symm).trans
                ((Category.assoc _ _ _).trans (congrArg (p₁ ≫ ·) (MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left := MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget V).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact Limits.pullback.condition
        let w₁₂ : S₀.arrows.category := ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S₀.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ := ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ := ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ := Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m (p₂.base z) = eval_c c w₁₂ m z :=
          congrArg (fun φ => (φ.hom m : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥A := fun m x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            eval_c c ⟨CategoryTheory.Over.mk u_x, hu_x⟩ m y_x
          have hg_eq : ∀ (m : ↥c.pt) (w : S₀.arrows.category) (y : ↥w.obj.left.left),
              g_fn m (w.obj.hom.left.base y) = eval_c c w m y := fun m w y => by
            let ch := hcov (w.obj.hom.left.base y)
            exact h_ov c ⟨CategoryTheory.Over.mk ch.choose_spec.choose,
              ch.choose_spec.choose_spec.choose_spec.1⟩ w m
              ch.choose_spec.choose_spec.choose y ch.choose_spec.choose_spec.choose_spec.2.2
          have hg_lc : ∀ m : ↥c.pt, IsLocallyConstant (g_fn m) := fun m => by
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S₀.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥A := eval_c c w_x m
            have _ : AlgebraicGeometry.Etale u_x.left := hEt_x
            refine ⟨u_x.left.base '' (f_x ⁻¹' {a}), ?_,
              u_x.left.isOpenMap _ (f_x.isLocallyConstant {a}), ⟨y_x, hx, hy_x⟩⟩
            rintro _ ⟨y', hy', rfl⟩
            change g_fn m (w_x.obj.hom.left.base y') = a
            rw [hg_eq m w_x y']
            exact hy'
          AddCommGrpCat.ofHom
            { toFun := fun m => ⟨g_fn m, hg_lc m⟩
              map_zero' := LocallyConstant.ext fun x => by
                let ch := hcov x
                let w_x : S₀.arrows.category := ⟨CategoryTheory.Over.mk ch.choose_spec.choose,
                  ch.choose_spec.choose_spec.choose_spec.1⟩
                exact congrArg (fun g : LocallyConstant _ ↥A => g ch.choose_spec.choose_spec.choose)
                  (map_zero (c.π.app (Opposite.op w_x)).hom)
              map_add' := fun m₁ m₂ => LocallyConstant.ext fun x => by
                let ch := hcov x
                let w_x : S₀.arrows.category := ⟨CategoryTheory.Over.mk ch.choose_spec.choose,
                  ch.choose_spec.choose_spec.choose_spec.1⟩
                exact congrArg (fun g : LocallyConstant _ ↥A => g ch.choose_spec.choose_spec.choose)
                  (map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂) }
        fac := fun c j => AddCommGrpCat.ext fun m => LocallyConstant.ext fun y => by
          let ch := hcov (j.unop.obj.hom.left.base y)
          exact h_ov c ⟨CategoryTheory.Over.mk ch.choose_spec.choose,
            ch.choose_spec.choose_spec.choose_spec.1⟩ j.unop m
            ch.choose_spec.choose_spec.choose y ch.choose_spec.choose_spec.choose_spec.2.2
        uniq := fun c g_hom hk => AddCommGrpCat.ext fun m => by
          let gm : LocallyConstant ↥E.left ↥A := g_hom.hom m
          change gm = _
          apply LocallyConstant.ext
          intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S₀.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg (fun φ => (φ.hom m : LocallyConstant _ ↥A) y_x) (hk (Opposite.op w_x))
          change gm (u_x.left.base y_x) = eval_c c w_x m y_x at hkx
          rwa [hy_x] at hkx }⟩
    have hLocInj : Presheaf.IsLocallyInjective V.smallEtaleTopology θ_A := by
      refine Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · refine (hMemEt E.unop _).mpr fun x => False.elim (hEmp.false x)
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun g : LocallyConstant ↥E.unop.left ↥A => g x₀) ha
        subst ha_eq
        have htop : Presheaf.equalizerSieve
            (F := (Functor.const (Opposite V.Etale)).obj A) (X := E) a₁ a₁ = ⊤ :=
          Sieve.id_mem_iff_eq_top.mp rfl
        rw [htop]
        exact V.smallEtaleTopology.top_mem E.unop
    have hLocSurj : Presheaf.IsLocallySurjective V.smallEtaleTopology θ_A := by
      refine Presheaf.IsLocallySurjective.mk ?_
      intro E g
      refine (hMemEt E (Presheaf.imageSieve θ_A g)).mpr fun x => ?_
      let g_lc : LocallyConstant ↥E.left ↥A := g
      let a : ↥A := g_lc x
      let O_a : E.left.Opens := ⟨g_lc ⁻¹' {a}, g_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) O_a.ι E.hom inferInstance E.prop
      let Y_a : V.Etale := MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := MorphismProperty.Over.homMk O_a.ι rfl trivial
      exact ⟨Y_a, u_a, ⟨x, rfl⟩, ⟨a, LocallyConstant.ext fun y => y.2.symm⟩, inferInstance, rfl⟩
    have hW_θ : V.smallEtaleTopology.W θ_A :=
      (V.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : IsIso ((CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
      (V.smallEtaleTopology.W_iff θ_A).mp hW_θ
    let ℒ_A : Sheaf V.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hSheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}
    let P_const := (Functor.const (Opposite V.Etale)).obj A
    let Υ_hom : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ ℒ_A :=
      (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_hom =
        (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A :=
      Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have _ : IsIso Υ_hom := by
      rw [hΥ_eq]
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map inferInstance
    let Υ : (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A ≅ ℒ_A :=
      asIso Υ_hom
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ.hom.hom = θ_A := by
      have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
      rwa [Adjunction.homEquiv_unit] at h1
    exact ⟨hSheaf, Υ, fun E a => congrArg (fun η => η.app (Opposite.op E) a) h_unit_Υ⟩

  let ℱ_U := (resEtale hu_et).obj ℛ
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let P_constℤ := (Functor.const S.Etaleᵒᵖ).obj Aℤ
  let Fℤ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let ηℤ := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app P_constℤ
  let one_sec : ∀ (Y : S.Etale), ↥(Fℤ_S.obj.obj (Opposite.op Y)) :=
    fun Y => (ηℤ.app (Opposite.op Y)).hom (ULift.up (1 : ℤ))
  have h_one_nat : ∀ {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      (Fℤ_S.obj.map u.op).hom (one_sec Y₂) = one_sec Y₁ := fun u =>
    (congrArg (fun g => g.hom (ULift.up (1 : ℤ))) (ηℤ.naturality u.op)).symm
  let s_sec : ∀ (Y : S.Etale), ↥(ℛ.obj.obj (Opposite.op Y)) :=
    fun Y => (φ.hom.app (Opposite.op Y)).hom (one_sec Y)
  have h_s_nat : ∀ {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      (ℛ.obj.map u.op).hom (s_sec Y₂) = s_sec Y₁ := by
    intro Y₁ Y₂ u
    have hnat := congrArg (fun g => g.hom (one_sec Y₂)) (φ.hom.naturality u.op)
    change (φ.hom.app (Opposite.op Y₁)).hom ((Fℤ_S.obj.map u.op).hom (one_sec Y₂)) =
      (ℛ.obj.map u.op).hom (s_sec Y₂) at hnat
    rw [h_one_nat u] at hnat
    exact hnat.symm

  let E_U : Functor U₀.Etale S.Etale := siteMap hu_et
  let T_U₀ : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 U₀)
  have hT_U₀ : Limits.IsTerminal T_U₀ := hTerm U₀
  let U_et : S.Etale := E_U.obj T_U₀
  let σ_U : ↥(ℱ_U.obj.obj (Opposite.op T_U₀)) := s_sec U_et
  have hσ_res : ∀ (E : U₀.Etale),
      (ℱ_U.obj.map (hT_U₀.from E).op).hom σ_U = s_sec (E_U.obj E) :=
    fun E => h_s_nat (E_U.map (hT_U₀.from E))

  let Z₀ : Set ↥U₀ :=
    { x : ↥U₀ | ∃ (E : U₀.Etale), x ∈ Set.range E.hom.base ∧ s_sec (E_U.obj E) = 0 }
  have hOpen_Z₀ : IsOpen Z₀ := by
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨E, hxE, hsE⟩
    have _ : AlgebraicGeometry.Etale E.hom := E.prop
    have hOpenRange : IsOpen (Set.range E.hom.base) := by
      rw [← Set.image_univ]
      exact E.hom.isOpenMap _ isOpen_univ
    exact ⟨Set.range E.hom.base, fun x' hx' => ⟨E, hx', hsE⟩, hOpenRange, hxE⟩

  have hChart : ∀ x : ↥U₀,
      ∃ (V : AlgebraicGeometry.Scheme.{u}) (w : V ⟶ U₀) (hw : AlgebraicGeometry.Etale w)
        (he : AlgebraicGeometry.Etale (w ≫ U.ι))
        (A₀ : AddCommGrpCat.{u}) (y : ↥V)
        (hSh : Presheaf.IsSheaf V.smallEtaleTopology (locConstPresheaf V A₀))
        (θ : (resEtale he).obj ℛ ≅ ⟨locConstPresheaf V A₀, hSh⟩),
        w.base y = x := by
    intro x
    obtain ⟨V, w, A₀, hw, ⟨y, hy⟩, hPb⟩ := hLocConst x
    have he : AlgebraicGeometry.Etale (w ≫ U.ι) :=
      MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) w U.ι hw hu_et
    obtain ⟨e₀⟩ := hPbToRes he hPb
    obtain ⟨hSh, Υ, _⟩ := hLocConstModel V A₀
    exact ⟨V, w, hw, he, A₀, y, hSh, e₀ ≪≫ Υ, hy⟩

  have hZeroAtZeroVal : ∀ {V : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ U₀}
      (hw : AlgebraicGeometry.Etale w) (he : AlgebraicGeometry.Etale (w ≫ U.ι))
      {A₀ : AddCommGrpCat.{u}} {y : ↥V} {x : ↥U₀}
      (hy : w.base y = x)
      {hSh : Presheaf.IsSheaf V.smallEtaleTopology (locConstPresheaf V A₀)}
      (θ : (resEtale he).obj ℛ ≅ ⟨locConstPresheaf V A₀, hSh⟩),
      let M_e : Functor V.Etale S.Etale := siteMap he
      let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
      let f_x : LocallyConstant ↥T_V.left ↥A₀ :=
        (θ.hom.hom.app (Opposite.op T_V)).hom (s_sec (M_e.obj T_V))
      f_x y = 0 → x ∈ Z₀ := by
    clear * - hEtComp S U U₀ hu_et ℛ φ siteMap hOpenCont resEtale
      locConstPresheaf Aℤ P_constℤ Fℤ_S ηℤ one_sec s_sec h_s_nat E_U Z₀
    intro V w hw he A₀ y x hy hSh θ M_e T_V f_x hfy0
    have _ := hw
    let O₀ : V.Opens := ⟨f_x ⁻¹' {0}, f_x.isLocallyConstant {0}⟩
    have hy_O₀ : y ∈ O₀ := hfy0
    have hEt_O₀w : AlgebraicGeometry.Etale (O₀.ι ≫ w) := inferInstance
    let Y₀_V : V.Etale := MorphismProperty.Over.mk ⊤ O₀.ι (inferInstance : AlgebraicGeometry.Etale O₀.ι)
    let u_O₀ : Y₀_V ⟶ T_V := MorphismProperty.Over.homMk O₀.ι (Category.comp_id O₀.ι) trivial
    let E₀ : U₀.Etale := MorphismProperty.Over.mk ⊤ (O₀.ι ≫ w) hEt_O₀w
    let iso_E₀ : E_U.obj E₀ ≅ M_e.obj Y₀_V :=
      MorphismProperty.Over.isoMk (Iso.refl O₀.toScheme)
        ((Category.id_comp _).trans (Category.assoc O₀.ι w U.ι).symm)
    let s_Y₀ : ↥(((resEtale he).obj ℛ).obj.obj (Opposite.op Y₀_V)) :=
      s_sec (M_e.obj Y₀_V)
    have hs_Y₀' : s_Y₀ = 0 := by
      apply (ConcreteCategory.bijective_of_isIso (θ.hom.hom.app (Opposite.op Y₀_V))).1
      rw [map_zero]
      have hnat_θ := congrArg (fun g => g.hom (s_sec (M_e.obj T_V)))
        (θ.hom.hom.naturality u_O₀.op)
      change (θ.hom.hom.app (Opposite.op Y₀_V)).hom
          ((ℛ.obj.map (M_e.map u_O₀).op).hom (s_sec (M_e.obj T_V))) =
        LocallyConstant.comap O₀.ι.base.hom f_x at hnat_θ
      have hs_eq : (ℛ.obj.map (M_e.map u_O₀).op).hom (s_sec (M_e.obj T_V)) = s_Y₀ :=
        h_s_nat (M_e.map u_O₀)
      refine (congrArg (θ.hom.hom.app (Opposite.op Y₀_V)).hom hs_eq.symm).trans (hnat_θ.trans ?_)
      ext z
      exact z.2
    have hs_Y₀ : s_sec (M_e.obj Y₀_V) = 0 := hs_Y₀'
    have hs_E₀ : s_sec (E_U.obj E₀) = 0 := by
      rw [← h_s_nat iso_E₀.hom, hs_Y₀, map_zero]
    exact ⟨E₀, ⟨⟨y, hy_O₀⟩, hy⟩, hs_E₀⟩

  have hOpen_Z₀_compl : IsOpen Z₀ᶜ := by
    clear * - hEtComp hEtPb hEtBC S U U₀ hu_et ℛ φ siteMap hOpenCont resEtale
      locConstPresheaf Aℤ P_constℤ Fℤ_S ηℤ one_sec s_sec h_s_nat E_U Z₀ hChart hZeroAtZeroVal
    rw [isOpen_iff_forall_mem_open]
    intro x hx_not
    obtain ⟨V, w, hw, he, A₀, y, hSh, θ, hy⟩ := hChart x
    have _ := hw
    let M_e : Functor V.Etale S.Etale := siteMap he
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
    let f_x : LocallyConstant ↥T_V.left ↥A₀ :=
      (θ.hom.hom.app (Opposite.op T_V)).hom (s_sec (M_e.obj T_V))
    have hfy_ne : f_x y ≠ 0 := fun hfy0 => hx_not (hZeroAtZeroVal hw he hy θ hfy0)
    let O₁ : V.Opens := ⟨f_x ⁻¹' {0}ᶜ, f_x.isLocallyConstant {0}ᶜ⟩
    have hy_O₁ : y ∈ O₁ := hfy_ne
    have hOpenRange : IsOpen (Set.range (O₁.ι ≫ w).base) := by
      rw [← Set.image_univ]
      exact (O₁.ι ≫ w).isOpenMap _ isOpen_univ
    refine ⟨Set.range (O₁.ι ≫ w).base, ?_, hOpenRange, ⟨⟨y, hy_O₁⟩, hy⟩⟩
    rintro x' ⟨y₁, rfl⟩ ⟨E, ⟨z_E, hz_E⟩, hsE⟩
    let P := Limits.pullback (O₁.ι ≫ w) E.hom
    let fst : P ⟶ O₁.toScheme := Limits.pullback.fst (O₁.ι ≫ w) E.hom
    let snd : P ⟶ E.left := Limits.pullback.snd (O₁.ι ≫ w) E.hom
    obtain ⟨p, hp_fst, _⟩ := Scheme.Pullback.exists_preimage_pullback y₁ z_E hz_E.symm
    have _ : AlgebraicGeometry.Etale E.hom := E.prop
    have _ : AlgebraicGeometry.Etale fst :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (IsPullback.of_hasPullback (O₁.ι ≫ w) E.hom).flip E.prop
    let Y_P : V.Etale := MorphismProperty.Over.mk ⊤ (fst ≫ O₁.ι) inferInstance
    let u_PV : Y_P ⟶ T_V := MorphismProperty.Over.homMk (fst ≫ O₁.ι) (Category.comp_id _) trivial
    have hPE_w : snd ≫ (E_U.obj E).hom = (M_e.obj Y_P).hom := by
      change snd ≫ (E.hom ≫ U.ι) = (fst ≫ O₁.ι) ≫ (w ≫ U.ι)
      rw [← Category.assoc snd E.hom U.ι, ← Limits.pullback.condition]
      simp only [Category.assoc]
      rfl
    let m_PE : M_e.obj Y_P ⟶ E_U.obj E :=
      MorphismProperty.Over.homMk snd hPE_w trivial
    let s_YP : ↥(((resEtale he).obj ℛ).obj.obj (Opposite.op Y_P)) :=
      s_sec (M_e.obj Y_P)
    have hs_YP : s_YP = 0 := by
      change s_sec (M_e.obj Y_P) = 0
      rw [← h_s_nat m_PE, hsE, map_zero]
    have hnat_θ := congrArg (fun g => g.hom (s_sec (M_e.obj T_V)))
      (θ.hom.hom.naturality u_PV.op)
    change (θ.hom.hom.app (Opposite.op Y_P)).hom
        ((ℛ.obj.map (M_e.map u_PV).op).hom (s_sec (M_e.obj T_V))) =
      LocallyConstant.comap (fst ≫ O₁.ι).base.hom f_x at hnat_θ
    have hs_eq : (ℛ.obj.map (M_e.map u_PV).op).hom (s_sec (M_e.obj T_V)) = s_YP :=
      h_s_nat (M_e.map u_PV)
    have hcomap_zero : LocallyConstant.comap (fst ≫ O₁.ι).base.hom f_x = 0 :=
      hnat_θ.symm.trans
        ((congrArg (θ.hom.hom.app (Opposite.op Y_P)).hom (hs_eq.trans hs_YP)).trans (map_zero _))
    have hp_val : f_x (O₁.ι.base (fst.base p)) = 0 :=
      congrArg (fun g : LocallyConstant ↥P ↥A₀ => g p) hcomap_zero
    rw [hp_fst] at hp_val
    exact y₁.2 hp_val

  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := Classical.arbitrary ↥S_k
  have hu_range : Set.range u_bar.base ⊆ Set.range U.ι.base := by
    rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
  let u_U : S_k ⟶ U₀ := AlgebraicGeometry.IsOpenImmersion.lift U.ι u_bar hu_range
  have hu_U_fac : u_U ≫ U.ι = u_bar :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι u_bar hu_range
  let x₀ : ↥U₀ := u_U.base pt_k
  have hx₀_Z₀ : x₀ ∈ Z₀ := by
    clear * - hEtComp hEtPb hEtBC k hFld_k S U U₀ u_bar hu_mem hu_et
      siteMap hContB hOpenCont resEtale hResAdj locConstPresheaf hLocConstModel
      ℛ φ Aℤ P_constℤ Fℤ_S ηℤ one_sec s_sec h_s_nat E_U Z₀ hChart hZeroAtZeroVal
      S_k pt_k hu_range u_U hu_U_fac x₀ h_ubar_zero
    by_contra hx₀_not
    obtain ⟨V, w, hw, he, A₀, y₀, hSh, θ, hy₀⟩ := hChart x₀
    have _ := hw
    let M_e : Functor V.Etale S.Etale := siteMap he
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
    let f_x₀ : LocallyConstant ↥T_V.left ↥A₀ :=
      (θ.hom.hom.app (Opposite.op T_V)).hom (s_sec (M_e.obj T_V))
    let a₀ : ↥A₀ := f_x₀ y₀
    have ha₀_ne : a₀ ≠ 0 := fun ha₀0 => hx₀_not (hZeroAtZeroVal hw he hy₀ θ ha₀0)
    let O_a : V.Opens := ⟨f_x₀ ⁻¹' {a₀}, f_x₀.isLocallyConstant {a₀}⟩
    let V_star := O_a.toScheme
    let y_star : ↥V_star := ⟨y₀, rfl⟩
    let e_star : V_star ⟶ S := O_a.ι ≫ (w ≫ U.ι)
    have he_star : AlgebraicGeometry.Etale e_star :=
      MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) O_a.ι (w ≫ U.ι) inferInstance he
    have he_star_pt : e_star.base y_star = u_bar.base pt_k := by
      change U.ι.base (w.base y₀) = u_bar.base pt_k
      rw [hy₀]
      exact congrArg (fun g : S_k ⟶ S => g.base pt_k) hu_U_fac
    have ho_a : AlgebraicGeometry.Etale O_a.ι := inferInstance
    let M_Oa : Functor V_star.Etale V.Etale := siteMap ho_a
    let M_estar : Functor V_star.Etale S.Etale := siteMap he_star
    let ℒ_star : Sheaf V_star.smallEtaleTopology AddCommGrpCat.{u} :=
      (resEtale ho_a).obj ⟨locConstPresheaf V A₀, hSh⟩
    let iso_M_star : M_estar ≅ M_Oa ⋙ M_e :=
      NatIso.ofComponents
        (fun Y => MorphismProperty.Over.isoMk (Iso.refl Y.left)
          ((Category.id_comp _).trans (Category.assoc Y.hom O_a.ι (w ≫ U.ι))))
        (fun {_ _} u => MorphismProperty.Comma.Hom.ext
          ((Category.comp_id u.left).trans (Category.id_comp u.left).symm)
          (Subsingleton.elim _ _))
    let _ := hOpenCont he_star; let _ := hOpenCont ho_a; let _ := hOpenCont he
    let _ := Functor.isContinuous_comp M_Oa M_e
      V_star.smallEtaleTopology V.smallEtaleTopology S.smallEtaleTopology
    let e_res_star : (resEtale he_star).obj ℛ ≅ (resEtale ho_a).obj ((resEtale he).obj ℛ) :=
      (Functor.sheafPushforwardContinuousIso iso_M_star AddCommGrpCat.{u}
          V_star.smallEtaleTopology S.smallEtaleTopology).app ℛ ≪≫
        ((Functor.sheafPushforwardContinuousComp M_Oa M_e AddCommGrpCat.{u}
            V_star.smallEtaleTopology V.smallEtaleTopology S.smallEtaleTopology).symm).app ℛ
    let θ_star : (resEtale he_star).obj ℛ ⟶ ℒ_star :=
      e_res_star.hom ≫ (resEtale ho_a).map θ.hom
    let T_star : V_star.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V_star)
    have hθ_star_eval : (θ_star.hom.app (Opposite.op T_star)).hom (s_sec (M_estar.obj T_star)) =
        LocallyConstant.const ↥V_star a₀ := by
      let u_Oa : M_Oa.obj T_star ⟶ T_V :=
        MorphismProperty.Over.homMk (𝟙 V_star ≫ O_a.ι) (Category.comp_id _) trivial
      have hnat_θ := congrArg (fun g => g.hom (s_sec (M_e.obj T_V)))
        (θ.hom.hom.naturality u_Oa.op)
      change (θ.hom.hom.app (Opposite.op (M_Oa.obj T_star))).hom
          ((ℛ.obj.map (M_e.map u_Oa).op).hom (s_sec (M_e.obj T_V))) =
        LocallyConstant.comap (𝟙 V_star ≫ O_a.ι).base.hom f_x₀ at hnat_θ
      have hs_eq : (ℛ.obj.map (M_e.map u_Oa).op).hom (s_sec (M_e.obj T_V)) =
          (ℛ.obj.map (iso_M_star.inv.app T_star).op).hom (s_sec (M_estar.obj T_star)) :=
        (h_s_nat (M_e.map u_Oa)).trans (h_s_nat (iso_M_star.inv.app T_star)).symm
      have h1 : (θ_star.hom.app (Opposite.op T_star)).hom (s_sec (M_estar.obj T_star)) =
          LocallyConstant.comap (𝟙 V_star ≫ O_a.ι).base.hom f_x₀ :=
        (congrArg (θ.hom.hom.app (Opposite.op (M_Oa.obj T_star))).hom hs_eq.symm).trans hnat_θ
      refine h1.trans ?_
      apply LocallyConstant.ext
      intro z
      change f_x₀ (O_a.ι.base z) = a₀
      exact z.2

    let P_pb := Limits.pullback e_star u_bar
    let p₁ : P_pb ⟶ V_star := Limits.pullback.fst e_star u_bar
    let p₂ : P_pb ⟶ S_k := Limits.pullback.snd e_star u_bar
    obtain ⟨z_pb, _, _⟩ := Scheme.Pullback.exists_preimage_pullback y_star pt_k he_star_pt
    obtain ⟨hc_u, hr_u, hpb_u_zero⟩ := h_ubar_zero
    have hc_u_eq : hc_u = hContB u_bar := Subsingleton.elim _ _
    subst hc_u_eq
    let _ := hContB u_bar; let _ := hr_u
    let _ := hContB e_star; let _ := hContB p₁; let _ := hContB p₂
    let 𝒢_pb : Sheaf P_pb.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨locConstPresheaf P_pb A₀, (hLocConstModel P_pb A₀).choose⟩
    let B_p₁ : Functor V_star.Etale P_pb.Etale := weilEtaleSitePullback p₁
    let B_p₂ : Functor S_k.Etale P_pb.Etale := weilEtaleSitePullback p₂
    let B_estar : Functor S.Etale V_star.Etale := weilEtaleSitePullback e_star
    let B_ubar : Functor S.Etale S_k.Etale := weilEtaleSitePullback u_bar
    let pf_p₁ := B_p₁.sheafPushforwardContinuous AddCommGrpCat.{u}
      V_star.smallEtaleTopology P_pb.smallEtaleTopology
    let pf_p₂ := B_p₂.sheafPushforwardContinuous AddCommGrpCat.{u}
      S_k.smallEtaleTopology P_pb.smallEtaleTopology
    let pf_estar := B_estar.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology V_star.smallEtaleTopology
    let pf_ubar := B_ubar.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S_k.smallEtaleTopology
    let γ_p₁ : ℒ_star ⟶ pf_p₁.obj 𝒢_pb :=
      { hom :=
          { app := fun opY =>
              AddCommGrpCat.ofHom
                (LocallyConstant.comapAddMonoidHom (Z := ↥A₀)
                  (Limits.pullback.fst opY.unop.hom p₁).base.hom)
            naturality := fun {opY₁ opY₂} u => by
              have hcomm : (B_p₁.map u.unop).left ≫ Limits.pullback.fst opY₁.unop.hom p₁ =
                  Limits.pullback.fst opY₂.unop.hom p₁ ≫ u.unop.left :=
                Limits.pullback.lift_fst _ _ _
              apply AddCommGrpCat.ext
              intro g
              let g_lc : LocallyConstant ↥opY₁.unop.left ↥A₀ := g
              apply LocallyConstant.ext
              intro q_pt
              change g_lc (u.unop.left.base ((Limits.pullback.fst opY₂.unop.hom p₁).base q_pt)) =
                g_lc ((Limits.pullback.fst opY₁.unop.hom p₁).base ((B_p₁.map u.unop).left.base q_pt))
              exact congrArg g_lc (congrArg (fun m : _ ⟶ opY₁.unop.left => m.base q_pt) hcomm).symm } }
    let β₁ : (resEtale he_star).obj ℛ ⟶ pf_p₁.obj 𝒢_pb := θ_star ≫ γ_p₁
    obtain ⟨_, ⟨adj_estar⟩⟩ := hResAdj he_star
    let β₂ : ℛ ⟶ pf_estar.obj (pf_p₁.obj 𝒢_pb) :=
      (adj_estar.homEquiv ℛ (pf_p₁.obj 𝒢_pb)) β₁
    let P_et : MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      fun ⦃_ _⦄ h₀ => AlgebraicGeometry.Etale h₀
    have _ : P_et.IsStableUnderComposition :=
      { comp_mem := fun _ _ hf hg => by
          have _ : AlgebraicGeometry.Etale _ := hf
          have _ : AlgebraicGeometry.Etale _ := hg
          exact inferInstance }
    have _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f₀ : Z₁ ⟶ Z₂), P_et.HasPullbacksAlong f₀ :=
      fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f₀ : Z₁ ⟶ Z₂), P_et.IsStableUnderBaseChangeAlong f₀ :=
      fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.Etale) hp hg)
    let e_fun : B_estar ⋙ B_p₁ ≅ B_ubar ⋙ B_p₂ :=
      (MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) p₁ e_star).symm ≪≫
        MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) Limits.pullback.condition ≪≫
        MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) p₂ u_bar
    let _ := Functor.isContinuous_comp B_estar B_p₁
      S.smallEtaleTopology V_star.smallEtaleTopology P_pb.smallEtaleTopology
    let _ := Functor.isContinuous_comp B_ubar B_p₂
      S.smallEtaleTopology S_k.smallEtaleTopology P_pb.smallEtaleTopology
    let e_pf : pf_p₁ ⋙ pf_estar ≅ pf_p₂ ⋙ pf_ubar :=
      Functor.sheafPushforwardContinuousComp B_estar B_p₁ AddCommGrpCat.{u}
          S.smallEtaleTopology V_star.smallEtaleTopology P_pb.smallEtaleTopology ≪≫
        Functor.sheafPushforwardContinuousIso e_fun AddCommGrpCat.{u}
          S.smallEtaleTopology P_pb.smallEtaleTopology ≪≫
        (Functor.sheafPushforwardContinuousComp B_ubar B_p₂ AddCommGrpCat.{u}
          S.smallEtaleTopology S_k.smallEtaleTopology P_pb.smallEtaleTopology).symm
    let β₃ : ℛ ⟶ pf_ubar.obj (pf_p₂.obj 𝒢_pb) := β₂ ≫ e_pf.hom.app 𝒢_pb
    let adj_u := B_ubar.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S_k.smallEtaleTopology
    let Ψ : (B_ubar.sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology S_k.smallEtaleTopology).obj ℛ ⟶ pf_p₂.obj 𝒢_pb :=
      (adj_u.homEquiv ℛ (pf_p₂.obj 𝒢_pb)).symm β₃
    have hφβ₃ : φ ≫ β₃ = 0 := by
      have h1 := adj_u.homEquiv_naturality_left φ Ψ
      have h2 : adj_u.homEquiv ℛ (pf_p₂.obj 𝒢_pb) Ψ = β₃ :=
        (adj_u.homEquiv ℛ (pf_p₂.obj 𝒢_pb)).apply_symm_apply β₃
      rw [h2, hpb_u_zero, Limits.zero_comp] at h1
      have h0 : adj_u.homEquiv Fℤ_S (pf_p₂.obj 𝒢_pb) 0 = 0 := by
        rw [Adjunction.homEquiv_unit, pf_ubar.map_zero, Limits.comp_zero]
      exact h1.symm.trans h0
    have hφβ₂ : φ ≫ β₂ = 0 := by
      have h1 := congrArg (· ≫ e_pf.inv.app 𝒢_pb) hφβ₃
      dsimp [β₃] at h1
      simp only [Category.assoc, Iso.hom_inv_id_app, Limits.zero_comp] at h1
      exact (Category.comp_id (φ ≫ β₂)).symm.trans (by rwa [Category.assoc])
    have _ : pf_estar.Additive :=
      { map_add := fun {_ _ _ _} => Sheaf.hom_ext (NatTrans.ext (funext fun _ => rfl)) }
    have hφβ₁ : (resEtale he_star).map φ ≫ β₁ = 0 := by
      apply (adj_estar.homEquiv Fℤ_S (pf_p₁.obj 𝒢_pb)).injective
      have h1 := adj_estar.homEquiv_naturality_left φ β₁
      dsimp [β₂] at hφβ₂
      rw [h1, hφβ₂, Adjunction.homEquiv_unit, pf_estar.map_zero, Limits.comp_zero]
    have hev0 := congrArg
      (fun α => (α.hom.app (Opposite.op T_star)).hom (one_sec (M_estar.obj T_star))) hφβ₁
    change LocallyConstant.comap (Limits.pullback.fst T_star.hom p₁).base.hom
        ((θ_star.hom.app (Opposite.op T_star)).hom (s_sec (M_estar.obj T_star))) = 0 at hev0
    rw [hθ_star_eval] at hev0
    obtain ⟨q_pb, _, _⟩ := Scheme.Pullback.exists_preimage_pullback
      (p₁.base z_pb) z_pb (rfl : T_star.hom.base (p₁.base z_pb) = p₁.base z_pb)
    exact ha₀_ne (congrArg (fun g : LocallyConstant ↥(B_p₁.obj T_star).left ↥A₀ => g q_pb) hev0)

  have hZ₀_univ : Z₀ = Set.univ :=
    IsClopen.eq_univ ⟨by simpa only [compl_compl] using hOpen_Z₀_compl.isClosed_compl, hOpen_Z₀⟩
      ⟨x₀, hx₀_Z₀⟩

  have hσ_U_zero : σ_U = 0 := by
    let R_cov : Sieve T_U₀ :=
      { arrows := fun Y _ => s_sec (E_U.obj Y) = 0
        downward_closed := fun {Y₁ Y₂} u hu g => by
          change s_sec (E_U.obj Y₁) = 0 at hu
          rw [← h_s_nat (E_U.map g), hu, map_zero] }
    have hR_mem : R_cov ∈ U₀.smallEtaleTopology T_U₀ := by
      refine (hMemEt T_U₀ R_cov).mpr fun x => ?_
      have hx : x ∈ Z₀ := by rw [hZ₀_univ]; trivial
      rcases hx with ⟨E, ⟨y, hy⟩, hsE⟩
      have hfrom_left : (hT_U₀.from E).left = E.hom :=
        (Category.comp_id (hT_U₀.from E).left).symm.trans (MorphismProperty.Over.w (hT_U₀.from E))
      exact ⟨E, hT_U₀.from E, y, hsE, hMorEt (hT_U₀.from E), hfrom_left.symm ▸ hy⟩
    refine Sheaf.isSeparated ℱ_U T_U₀ R_cov hR_mem σ_U 0 fun Y u hu => ?_
    rw [map_zero]
    have hu_eq : u = hT_U₀.from Y := hT_U₀.hom_ext _ _
    rw [hu_eq, hσ_res Y]
    exact hu

  have hs_over_U : ∀ (Y : S.Etale),
      Set.range Y.hom.base ⊆ (U : Set S) → s_sec Y = 0 := by
    intro Y hY_sub
    have hY_range : Set.range Y.hom.base ⊆ Set.range U.ι.base := by
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
    let y_U : Y.left ⟶ U₀ := AlgebraicGeometry.IsOpenImmersion.lift U.ι Y.hom hY_range
    have hy_U_fac : y_U ≫ U.ι = Y.hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι Y.hom hY_range
    let m_YU : Y ⟶ U_et :=
      MorphismProperty.Over.homMk y_U
        ((Category.assoc y_U (𝟙 U₀) U.ι).symm.trans
          ((congrArg (· ≫ U.ι) (Category.comp_id y_U)).trans hy_U_fac))
        trivial
    have hs_Uet : s_sec U_et = 0 := hσ_U_zero
    rw [← h_s_nat m_YU, hs_Uet, map_zero]

  apply AddCommGrpCat.ext
  intro z
  change (φ.hom.app (Opposite.op W)).hom z = 0
  obtain ⟨_, Υ_Sℤ, hΥ_Sℤ_const⟩ := hLocConstModel S Aℤ
  let R_z : Sieve W := Presheaf.imageSieve ηℤ z
  have hRz_mem : R_z ∈ S.smallEtaleTopology W := by
    refine (hMemEt W R_z).mpr fun x => ?_
    let f_z : LocallyConstant ↥W.left ↥Aℤ := (Υ_Sℤ.hom.hom.app (Opposite.op W)).hom z
    let a : ↥Aℤ := f_z x
    let O_x : W.left.Opens := ⟨f_z ⁻¹' {a}, f_z.isLocallyConstant {a}⟩
    have hYx_et : AlgebraicGeometry.Etale (O_x.ι ≫ W.hom) :=
      MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) O_x.ι W.hom inferInstance W.prop
    let Y_x : S.Etale := MorphismProperty.Over.mk ⊤ (O_x.ι ≫ W.hom) hYx_et
    let g_x : Y_x ⟶ W := MorphismProperty.Over.homMk O_x.ι rfl trivial
    refine ⟨Y_x, g_x, ⟨x, rfl⟩, ⟨a, ?_⟩, inferInstance, rfl⟩
    apply (ConcreteCategory.bijective_of_isIso (Υ_Sℤ.hom.hom.app (Opposite.op Y_x))).1
    have hnat_Υ := congrArg (fun α => α.hom z) (Υ_Sℤ.hom.hom.naturality g_x.op)
    change (Υ_Sℤ.hom.hom.app (Opposite.op Y_x)).hom ((Fℤ_S.obj.map g_x.op).hom z) =
      LocallyConstant.comap O_x.ι.base.hom f_z at hnat_Υ
    refine (hΥ_Sℤ_const Y_x a).trans (Eq.trans ?_ hnat_Υ.symm)
    apply LocallyConstant.ext
    intro y_pt
    exact y_pt.2.symm
  refine Sheaf.isSeparated ℛ W R_z hRz_mem ((φ.hom.app (Opposite.op W)).hom z) 0 fun Y g hg => ?_
  rw [map_zero]
  have hnat := congrArg (fun α => α.hom z) (φ.hom.naturality g.op)
  change (φ.hom.app (Opposite.op Y)).hom ((Fℤ_S.obj.map g.op).hom z) =
    (ℛ.obj.map g.op).hom ((φ.hom.app (Opposite.op W)).hom z) at hnat
  rw [← hnat]
  rcases hg with ⟨a, ha⟩
  let a_int : ULift.{u} ℤ := a
  have ha_smul : a_int = a_int.down • ULift.up (1 : ℤ) := by
    apply ULift.ext
    change a_int.down = a_int.down • (1 : ℤ)
    simp
  have hz_res : (Fℤ_S.obj.map g.op).hom z = a_int.down • one_sec Y := by
    have ha' : (Fℤ_S.obj.map g.op).hom z = (ηℤ.app (Opposite.op Y)).hom a_int := ha.symm
    conv_lhs => rw [ha', ha_smul, map_zsmul]
    rfl
  change (φ.hom.app (Opposite.op Y)).hom ((Fℤ_S.obj.map g.op).hom z) = 0
  rw [hz_res, map_zsmul]
  have hY_sub : Set.range Y.hom.base ⊆ (U : Set S) := by
    rintro _ ⟨w_pt, rfl⟩
    have hw_g : (g.left ≫ W.hom).base w_pt = Y.hom.base w_pt :=
      congrArg (fun m : Y.left ⟶ S => m.base w_pt) (MorphismProperty.Over.w g)
    rw [← hw_g]
    exact hW_sub ⟨g.left.base w_pt, rfl⟩
  change a_int.down • s_sec Y = 0
  rw [hs_over_U Y hY_sub, smul_zero]

theorem weil_sing_dev_deg2m2_bockstein_open_locConst_and_clopen_zero (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Z S : AlgebraicGeometry.Scheme.{u})
    (f : Z ⟶ S)
    (U : S.Opens) [ConnectedSpace ↥U.toScheme]
    (R_U : Type u) [CommRing R_U] [IsNoetherianRing R_U]
    (e_U : U.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of R_U))
    (u_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ S)
    (hu_mem : Set.range u_bar.base ⊆ (U : Set S))
    (hLocConst_mod_ell : ∀ (q : ℕ) (x : ↥U.toScheme),
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U.toScheme) (A₀ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale w ∧
        x ∈ Set.range w.base ∧
        Finite ↥A₀ ∧
        WeilIsEtaleSheafPullback w
          (weilEtaleHigherDirectImage (f ∣_ U) q
            (weilEtaleTorsionSheaf (f ⁻¹ᵁ U).toScheme ℓ))
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (r q : ℕ)
    (ξ' : (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Z (ℓ ^ (r + 1)))).H 0)
    (h_ubar_zero :
      ∃ (hc_u : (weilEtaleSitePullback u_bar).IsContinuous
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
        (hr_u : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback u_bar) AddCommGrpCat.{u} _
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology hc_u).IsRightAdjoint),
        (@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback u_bar) AddCommGrpCat.{u} _
          S.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology hc_u hr_u).map
            (CategoryTheory.Abelian.Ext.addEquiv₀ ξ') = 0)
    (W : S.Etale)
    (hW_sub : Set.range ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom.base ⊆ (U : Set S)) :
    (CategoryTheory.Abelian.Ext.addEquiv₀ ξ').hom.app (Opposite.op W) = 0 :=
by
  classical
  let U₀ : AlgebraicGeometry.Scheme.{u} := U.toScheme
  let V_Z : Z.Opens := f ⁻¹ᵁ U
  let V_U : AlgebraicGeometry.Scheme.{u} := V_Z.toScheme
  let f_U : V_U ⟶ U₀ := f ∣_ U

  
  have hShrink : ∀ (V : AlgebraicGeometry.Scheme.{u}) (w : V ⟶ U₀),
      AlgebraicGeometry.Etale w →
      ∀ y : ↥V, ∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (j₀ : W₀ ⟶ V) (y₀ : ↥W₀),
        AlgebraicGeometry.IsOpenImmersion j₀ ∧ j₀.base y₀ = y ∧ ConnectedSpace ↥W₀ := by
    intro V w hw y
    have _ := hw
    obtain ⟨U_aff, hAff, hy, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    let B : Type u := ↑(V.presheaf.obj (Opposite.op U_aff))
    let z : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) := hAff.isoSpec.hom.base ⟨y, hy⟩
    let g : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_U) :=
      hAff.fromSpec ≫ w ≫ e_U.hom
    have hg_lft : AlgebraicGeometry.LocallyOfFiniteType g := inferInstance
    let φ_ring : CommRingCat.of R_U ⟶ CommRingCat.of B := AlgebraicGeometry.Spec.preimage g
    have hSpecφ : AlgebraicGeometry.Spec.map φ_ring = g := AlgebraicGeometry.Spec.map_preimage g
    have hFT_φ : RingHom.FiniteType φ_ring.hom := by
      rw [← hSpecφ] at hg_lft
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hg_lft
    let _ : Algebra R_U B := φ_ring.hom.toAlgebra
    have _ : Algebra.FiniteType R_U B := hFT_φ
    have _ : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R_U B
    let X := ↥(AlgebraicGeometry.Spec (CommRingCat.of B))
    have _ : TopologicalSpace.NoetherianSpace X :=
      PrimeSpectrum.instNoetherianSpace (R := B)
    let C_bad : Set (Set X) := { C ∈ irreducibleComponents X | z ∉ C }
    have hFin_all : (irreducibleComponents X).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    have hFin_bad : C_bad.Finite := hFin_all.subset (fun _ hC => hC.1)
    let F_bad : Set X := ⋃ C ∈ C_bad, C
    have hClosed_bad : IsClosed F_bad :=
      hFin_bad.isClosed_biUnion (fun C hC => isClosed_of_mem_irreducibleComponents C hC.1)
    let O_z : Set X := F_badᶜ
    have hOpen_Oz : IsOpen O_z := hClosed_bad.isOpen_compl
    have hz_Oz : z ∈ O_z := by
      intro hz_in
      rcases Set.mem_iUnion₂.mp hz_in with ⟨C, hC_bad, hz_C⟩
      exact hC_bad.2 hz_C
    have hPreirred_inter : ∀ {C : Set X}, IsPreirreducible C → IsPreirreducible (C ∩ O_z) := by
      intro C hC U₁ U₂ hU₁ hU₂ ⟨x₁, ⟨hx₁C, hx₁O⟩, hx₁U₁⟩ ⟨x₂, ⟨hx₂C, hx₂O⟩, hx₂U₂⟩
      obtain ⟨x₃, hx₃C, ⟨hx₃O, hx₃U₁⟩, ⟨_, hx₃U₂⟩⟩ :=
        hC (O_z ∩ U₁) (O_z ∩ U₂) (hOpen_Oz.inter hU₁) (hOpen_Oz.inter hU₂)
          ⟨x₁, hx₁C, hx₁O, hx₁U₁⟩ ⟨x₂, hx₂C, hx₂O, hx₂U₂⟩
      exact ⟨x₃, ⟨hx₃C, hx₃O⟩, hx₃U₁, hx₃U₂⟩
    have hPreconn_Oz : _root_.IsPreconnected O_z := by
      refine isPreconnected_of_forall z (fun w' hw' => ?_)
      let Cw := irreducibleComponent w'
      refine ⟨Cw ∩ O_z, Set.inter_subset_right, ?_, ⟨mem_irreducibleComponent, hw'⟩,
        (hPreirred_inter isIrreducible_irreducibleComponent.isPreirreducible).isPreconnected⟩
      refine ⟨?_, hz_Oz⟩
      by_contra hz_not
      have hCw_bad : Cw ∈ C_bad := ⟨irreducibleComponent_mem_irreducibleComponents w', hz_not⟩
      exact hw' (Set.mem_iUnion₂.mpr ⟨Cw, hCw_bad, mem_irreducibleComponent⟩)
    let W_open : (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens := ⟨O_z, hOpen_Oz⟩
    let W₀ := W_open.toScheme
    let y₀ : ↥W₀ := ⟨z, hz_Oz⟩
    let j₀ : W₀ ⟶ V := W_open.ι ≫ hAff.fromSpec
    have hj₀_open : AlgebraicGeometry.IsOpenImmersion j₀ := inferInstance
    have hj₀_pt : j₀.base y₀ = y := by
      change hAff.fromSpec.base (hAff.isoSpec.hom.base ⟨y, hy⟩) = y
      have hcomp : hAff.isoSpec.hom ≫ hAff.fromSpec = U_aff.ι := by
        rw [← hAff.isoSpec_inv_ι, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
      exact congrArg (fun m : U_aff.toScheme ⟶ V => m.base ⟨y, hy⟩) hcomp
    have _ : PreconnectedSpace ↥W₀ := isPreconnected_iff_preconnectedSpace.mp hPreconn_Oz
    have _ : ConnectedSpace ↥W₀ := @ConnectedSpace.mk ↥W₀ _ inferInstance ⟨y₀⟩
    exact ⟨W₀, j₀, y₀, hj₀_open, hj₀_pt, inferInstance⟩

  
  obtain ⟨hc_all, _, hAddLim, -⟩ := weil_etale_pinned_clopen_section_and_stalk_criteria
  obtain ⟨_, hPbIso, hPbComp, hPbConst, hPbKerCok, _⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor ℓ
  have hConnKerCok := (weil_etale_constantSheaf_connected_hom_and_torsion_split ℓ).1

  let IsFinLocConst := fun (ℱ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}) =>
    ∀ x : ↥U₀, ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U₀) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      x ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w ℱ
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)

  have hKerCok : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ₀ : ℱ₁ ⟶ ℱ₂),
      IsFinLocConst ℱ₁ → IsFinLocConst ℱ₂ →
      IsFinLocConst (CategoryTheory.Limits.kernel ψ₀) ∧
      IsFinLocConst (CategoryTheory.Limits.cokernel ψ₀) := by
    intro ℱ₁ ℱ₂ ψ₀ h₁ h₂
    have hCommon : ∀ x : ↥U₀,
        ∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (w₀ : W₀ ⟶ U₀) (y₀ : ↥W₀)
          (_ : ConnectedSpace ↥W₀) (A₁ A₂ : AddCommGrpCat.{u})
          (ψ : (CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₁ ⟶
            (CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).obj A₂),
          AlgebraicGeometry.Etale w₀ ∧
          w₀.base y₀ = x ∧
          Finite ↥A₁ ∧ Finite ↥A₂ ∧
          WeilIsEtaleSheafPullback w₀ (CategoryTheory.Limits.kernel ψ₀)
            (CategoryTheory.Limits.kernel ψ) ∧
          WeilIsEtaleSheafPullback w₀ (CategoryTheory.Limits.cokernel ψ₀)
            (CategoryTheory.Limits.cokernel ψ) := by
      intro x
      obtain ⟨W₁, w₁, A₁, hw₁, ⟨y₁, hy₁⟩, hFin₁, hPb₁⟩ := h₁ x
      obtain ⟨W₂, w₂, A₂, hw₂, ⟨y₂, hy₂⟩, hFin₂, hPb₂⟩ := h₂ x
      have _ := hw₁; have _ := hw₂
      let P := CategoryTheory.Limits.pullback w₁ w₂
      let fst : P ⟶ W₁ := CategoryTheory.Limits.pullback.fst w₁ w₂
      let snd : P ⟶ W₂ := CategoryTheory.Limits.pullback.snd w₁ w₂
      obtain ⟨p, hp_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ (hy₁.trans hy₂.symm)
      obtain ⟨W₀, j₀, y₀, hj₀_open, hj₀_pt, hConn₀⟩ :=
        hShrink P (fst ≫ w₁) inferInstance p
      let v₁ : W₀ ⟶ W₁ := j₀ ≫ fst
      let v₂ : W₀ ⟶ W₂ := j₀ ≫ snd
      let w₀ : W₀ ⟶ U₀ := v₁ ≫ w₁
      have hw₀ : AlgebraicGeometry.Etale w₀ := inferInstance
      have hw₀_eq : v₂ ≫ w₂ = w₀ := by
        dsimp [v₁, v₂, w₀]
        rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition, ← Category.assoc]
      have hw₀_pt : w₀.base y₀ = x := by
        change w₁.base (fst.base (j₀.base y₀)) = x
        rw [hj₀_pt, hp_fst, hy₁]
      let C₀ := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
      have hPb₀₁ : WeilIsEtaleSheafPullback w₀ ℱ₁ (C₀.obj A₁) :=
        (hPbComp v₁ w₁ ℱ₁ _ (C₀.obj A₁)).1 hPb₁ (hPbConst v₁ A₁)
      have hPb₀₂' : WeilIsEtaleSheafPullback (v₂ ≫ w₂) ℱ₂ (C₀.obj A₂) :=
        (hPbComp v₂ w₂ ℱ₂ _ (C₀.obj A₂)).1 hPb₂ (hPbConst v₂ A₂)
      have hPb₀₂ : WeilIsEtaleSheafPullback w₀ ℱ₂ (C₀.obj A₂) := hw₀_eq ▸ hPb₀₂'
      obtain ⟨ψ, hPbKer, hPbCok⟩ := hPbKerCok w₀ ℱ₁ ℱ₂ ψ₀ (C₀.obj A₁) (C₀.obj A₂) hPb₀₁ hPb₀₂
      exact ⟨W₀, w₀, y₀, hConn₀, A₁, A₂, ψ, hw₀, hw₀_pt, hFin₁, hFin₂, hPbKer, hPbCok⟩
    refine ⟨fun x => ?_, fun x => ?_⟩
    · obtain ⟨W₀, w₀, y₀, hConn₀, A₁, A₂, ψ, hw₀, hw₀_pt, hFin₁, _, hPbKer, _⟩ := hCommon x
      have _ := hConn₀
      obtain ⟨α, hIsoKer, _⟩ := hConnKerCok W₀ A₁ A₂ ψ
      have _ : Finite ↥A₁ := hFin₁
      have hFin_ker : Finite ↥(CategoryTheory.Limits.kernel α) :=
        Finite.of_injective _
          ((AddCommGrpCat.mono_iff_injective (CategoryTheory.Limits.kernel.ι α)).mp inferInstance)
      exact ⟨W₀, w₀, CategoryTheory.Limits.kernel α, hw₀, ⟨y₀, hw₀_pt⟩, hFin_ker,
        hPbIso w₀ _ _ _ _ hPbKer ⟨Iso.refl _⟩ hIsoKer⟩
    · obtain ⟨W₀, w₀, y₀, hConn₀, A₁, A₂, ψ, hw₀, hw₀_pt, _, hFin₂, _, hPbCok⟩ := hCommon x
      have _ := hConn₀
      obtain ⟨α, _, hIsoCok⟩ := hConnKerCok W₀ A₁ A₂ ψ
      have _ : Finite ↥A₂ := hFin₂
      have hFin_cok : Finite ↥(CategoryTheory.Limits.cokernel α) :=
        Finite.of_surjective _
          ((AddCommGrpCat.epi_iff_surjective (CategoryTheory.Limits.cokernel.π α)).mp inferInstance)
      exact ⟨W₀, w₀, CategoryTheory.Limits.cokernel α, hw₀, ⟨y₀, hw₀_pt⟩, hFin_cok,
        hPbIso w₀ _ _ _ _ hPbCok ⟨Iso.refl _⟩ hIsoCok⟩

  
  have _ : (weilCompEtaleSitePullback f_U).IsContinuous
      U₀.smallEtaleTopology V_U.smallEtaleTopology := hc_all f_U
  have _ : ((weilCompEtaleSitePullback f_U).sheafPushforwardContinuous
      AddCommGrpCat.{u} U₀.smallEtaleTopology V_U.smallEtaleTopology).Additive :=
    (hAddLim f_U).2.1

  have hTerm_VU : CategoryTheory.Limits.IsTerminal
      (AlgebraicGeometry.Scheme.Etale.mk (𝟙 V_U)) :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun Y => CategoryTheory.MorphismProperty.Over.homMk Y.hom (Category.comp_id Y.hom) trivial)
      (fun Y m => by
        apply (AlgebraicGeometry.Scheme.Etale.forget V_U).map_injective
        apply CategoryTheory.Over.OverMorphism.ext
        exact (Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m))

  have hExactEpiMono : ∀ {X₁ X₁' X₂ X₃' X₃ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}}
      (π : X₁ ⟶ X₁') [CategoryTheory.Epi π] (f' : X₁' ⟶ X₂) (g' : X₂ ⟶ X₃')
      (ι : X₃' ⟶ X₃) [CategoryTheory.Mono ι]
      (hfg : (π ≫ f') ≫ (g' ≫ ι) = 0) (hf'g' : f' ≫ g' = 0),
      (CategoryTheory.ShortComplex.mk (π ≫ f') (g' ≫ ι) hfg).Exact →
      (CategoryTheory.ShortComplex.mk f' g' hf'g').Exact := by
    intro X₁ X₁' X₂ X₃' X₃ π _ f' g' ι _ hfg hf'g' hEx
    rw [CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift]
    have _ : CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift (g' ≫ ι) (π ≫ f') hfg) :=
      hEx.epi_kernelLift
    have hker_cond : CategoryTheory.Limits.kernel.ι (g' ≫ ι) ≫ g' = 0 := by
      apply (cancel_mono ι).mp
      rw [Category.assoc, CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    let u : CategoryTheory.Limits.kernel (g' ≫ ι) ⟶ CategoryTheory.Limits.kernel g' :=
      CategoryTheory.Limits.kernel.lift g' (CategoryTheory.Limits.kernel.ι (g' ≫ ι)) hker_cond
    let v : CategoryTheory.Limits.kernel g' ⟶ CategoryTheory.Limits.kernel (g' ≫ ι) :=
      CategoryTheory.Limits.kernel.lift (g' ≫ ι) (CategoryTheory.Limits.kernel.ι g')
        (by rw [← Category.assoc, CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp])
    have huv : u ≫ v = 𝟙 _ := by apply CategoryTheory.Limits.equalizer.hom_ext; simp [u, v]
    have hvu : v ≫ u = 𝟙 _ := by apply CategoryTheory.Limits.equalizer.hom_ext; simp [u, v]
    have _ : CategoryTheory.IsIso u := ⟨v, huv, hvu⟩
    have hcomm : CategoryTheory.Limits.kernel.lift (g' ≫ ι) (π ≫ f') hfg ≫ u =
        π ≫ CategoryTheory.Limits.kernel.lift g' f' hf'g' := by
      apply CategoryTheory.Limits.equalizer.hom_ext; simp [u]
    have _ : CategoryTheory.Epi (π ≫ CategoryTheory.Limits.kernel.lift g' f' hf'g') := by
      rw [← hcomm]; exact epi_comp _ _
    exact epi_of_epi π (CategoryTheory.Limits.kernel.lift g' f' hf'g')

  have hLocConst_all : ∀ (k_lvl a : ℕ),
      IsFinLocConst
        (weilEtaleHigherDirectImage f_U a (weilEtaleTorsionSheaf V_U (ℓ ^ (k_lvl + 1)))) := by
    intro k_lvl
    induction k_lvl with
    | zero =>
      intro a
      rw [zero_add, pow_one]
      exact hLocConst_mod_ell a
    | succ k_lvl ih =>
      have hPrime : Nat.Prime ℓ := Fact.out
      have hℓ_pos : 0 < ℓ := hPrime.pos
      have _ : NeZero ℓ := ⟨hPrime.ne_zero⟩
      have _ : NeZero (ℓ ^ (k_lvl + 1)) := ⟨pow_ne_zero (k_lvl + 1) hPrime.ne_zero⟩
      have _ : NeZero (ℓ ^ (k_lvl + 2)) := ⟨pow_ne_zero (k_lvl + 2) hPrime.ne_zero⟩
      let hdvd_pow : ℓ ∣ ℓ ^ (k_lvl + 2) := dvd_pow_self ℓ (Nat.succ_ne_zero (k_lvl + 1))
      let ι_hom : ZMod (ℓ ^ (k_lvl + 1)) →+ ZMod (ℓ ^ (k_lvl + 2)) :=
        { toFun := fun y => ((y.val * ℓ : ℕ) : ZMod (ℓ ^ (k_lvl + 2)))
          map_zero' := by simp
          map_add' := fun y₁ y₂ => by
            have hdiv := (Nat.div_add_mod (y₁.val + y₂.val) (ℓ ^ (k_lvl + 1))).symm
            rw [← ZMod.val_add y₁ y₂] at hdiv
            have hmul : (y₁.val + y₂.val) * ℓ =
                ((y₁.val + y₂.val) / ℓ ^ (k_lvl + 1)) * ℓ ^ (k_lvl + 2) + (y₁ + y₂).val * ℓ := by
              calc
                (y₁.val + y₂.val) * ℓ =
                    (ℓ ^ (k_lvl + 1) * ((y₁.val + y₂.val) / ℓ ^ (k_lvl + 1)) + (y₁ + y₂).val) * ℓ :=
                  congrArg (· * ℓ) hdiv
                _ = ((y₁.val + y₂.val) / ℓ ^ (k_lvl + 1)) * (ℓ ^ (k_lvl + 1) * ℓ) + (y₁ + y₂).val * ℓ := by
                  ring
                _ = ((y₁.val + y₂.val) / ℓ ^ (k_lvl + 1)) * ℓ ^ (k_lvl + 2) + (y₁ + y₂).val * ℓ := by
                  rw [← pow_succ]
            have hcast : (((y₁.val + y₂.val) * ℓ : ℕ) : ZMod (ℓ ^ (k_lvl + 2))) =
                (((y₁ + y₂).val * ℓ : ℕ) : ZMod (ℓ ^ (k_lvl + 2))) := by
              rw [hmul, Nat.cast_add, Nat.cast_mul,
                CharP.cast_eq_zero (ZMod (ℓ ^ (k_lvl + 2))) (ℓ ^ (k_lvl + 2)), mul_zero, zero_add]
            rw [← hcast, Nat.add_mul, Nat.cast_add] }
      let π_hom : ZMod (ℓ ^ (k_lvl + 2)) →+ ZMod ℓ :=
        (ZMod.castHom hdvd_pow (ZMod ℓ)).toAddMonoidHom
      have hι_val : ∀ y : ZMod (ℓ ^ (k_lvl + 1)),
          ι_hom y = ((y.val * ℓ : ℕ) : ZMod (ℓ ^ (k_lvl + 2))) := fun _ => rfl
      have hι_inj : Function.Injective ι_hom := by
        rw [injective_iff_map_eq_zero]
        intro y hy
        rw [hι_val, ZMod.natCast_eq_zero_iff, pow_succ] at hy
        have hdvd : ℓ ^ (k_lvl + 1) ∣ y.val := (Nat.mul_dvd_mul_iff_right hℓ_pos).mp hy
        have hval0 : y.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd y.val_lt
        exact ZMod.val_injective (ℓ ^ (k_lvl + 1)) (hval0.trans ZMod.val_zero.symm)
      have hπ_surj : Function.Surjective π_hom := by
        intro z
        refine ⟨(z.val : ZMod (ℓ ^ (k_lvl + 2))), ?_⟩
        change ZMod.castHom hdvd_pow (ZMod ℓ) (z.val : ZMod (ℓ ^ (k_lvl + 2))) = z
        rw [map_natCast, ZMod.natCast_zmod_val]
      have hιπ_zero : ∀ y : ZMod (ℓ ^ (k_lvl + 1)), π_hom (ι_hom y) = 0 := by
        intro y
        rw [hι_val]
        change ZMod.castHom hdvd_pow (ZMod ℓ) ((y.val * ℓ : ℕ) : ZMod (ℓ ^ (k_lvl + 2))) = 0
        rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero (ZMod ℓ) ℓ, mul_zero]
      let f_ab0 : AddCommGrpCat.of (ZMod (ℓ ^ (k_lvl + 1))) ⟶ AddCommGrpCat.of (ZMod (ℓ ^ (k_lvl + 2))) :=
        AddCommGrpCat.ofHom ι_hom
      let g_ab0 : AddCommGrpCat.of (ZMod (ℓ ^ (k_lvl + 2))) ⟶ AddCommGrpCat.of (ZMod ℓ) :=
        AddCommGrpCat.ofHom π_hom
      have hfg0 : f_ab0 ≫ g_ab0 = 0 := AddCommGrpCat.ext hιπ_zero
      let SC_ab0 : CategoryTheory.ShortComplex AddCommGrpCat.{0} :=
        CategoryTheory.ShortComplex.mk f_ab0 g_ab0 hfg0
      have hEx_ab0 : SC_ab0.Exact := by
        rw [CategoryTheory.ShortComplex.ab_exact_iff_range_eq_ker]
        ext x
        refine ⟨fun ⟨y, hy⟩ => ?_, fun hx => ?_⟩
        · change π_hom x = 0
          rw [← hy]
          exact hιπ_zero y
        · have hx_val : π_hom x = ((x.val : ℕ) : ZMod ℓ) := by
            conv_lhs => rw [← ZMod.natCast_zmod_val x]
            exact map_natCast (ZMod.castHom hdvd_pow (ZMod ℓ)) x.val
          have hdvd : ℓ ∣ x.val := by
            rw [← ZMod.natCast_eq_zero_iff, ← hx_val]
            exact hx
          rcases hdvd with ⟨m_div, hm⟩
          refine ⟨(m_div : ZMod (ℓ ^ (k_lvl + 1))), ?_⟩
          change ι_hom (m_div : ZMod (ℓ ^ (k_lvl + 1))) = x
          have hm_lt : m_div < ℓ ^ (k_lvl + 1) := by
