          eq_FY G₂ (CategoryTheory.CategoryStruct.comp α_m β_m) =
            (β_m.app (Opposite.op V)).hom (eq_FY G₁ α_m) := by
      intro G₁ G₂ α_m β_m
      dsimp only [eq_FY, Equiv.trans_apply]
      rw [CategoryTheory.Presheaf.freeYonedaHomEquiv_comp]
      rfl
    let h_hom : P_rep ⟶ P_FY := (eq_rep P_FY).symm (eq_FY P_FY (𝟙 P_FY))
    let h_inv : P_FY ⟶ P_rep := (eq_FY P_rep).symm (eq_rep P_rep (𝟙 P_rep))
    let e_pre : P_rep ≅ P_FY :=
      { hom := h_hom
        inv := h_inv
        hom_inv_id := (eq_rep P_rep).injective (by
          rw [heq_rep_nat h_hom h_inv, (eq_rep P_FY).apply_symm_apply]
          change eq_FY P_rep (𝟙 P_FY ≫ h_inv) = _
          rw [CategoryTheory.Category.id_comp, (eq_FY P_rep).apply_symm_apply])
        inv_hom_id := (eq_FY P_FY).injective (by
          rw [heq_FY_nat h_inv h_hom, (eq_FY P_rep).apply_symm_apply]
          change eq_rep P_FY (𝟙 P_rep ≫ h_hom) = _
          rw [CategoryTheory.Category.id_comp, (eq_rep P_FY).apply_symm_apply]) }
    exact ⟨(CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_pre⟩

  have subsingleton_ext_of_iso :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}}
        {A₁ A₂ G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (e : A₁ ≅ A₂) (n : ℕ),
        Subsingleton (CategoryTheory.Abelian.Ext A₂ G n) →
        Subsingleton (CategoryTheory.Abelian.Ext A₁ G n) := by
    clear * -
    intro Z A₁ A₂ G e n hSub
    refine ⟨fun x₁ x₂ => ?_⟩
    have hx0 : ∀ x : CategoryTheory.Abelian.Ext A₁ G n, x = 0 := by
      intro x
      have hid : (CategoryTheory.Abelian.Ext.mk₀ (e.hom ≫ e.inv)).comp x (Nat.zero_add n) = x := by
        rw [e.hom_inv_id, CategoryTheory.Abelian.Ext.mk₀_id_comp]
      rw [← hid, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
      have hy0 : (CategoryTheory.Abelian.Ext.mk₀ e.inv).comp x (Nat.zero_add n) = 0 :=
        Subsingleton.elim _ _
      rw [hy0, CategoryTheory.Abelian.Ext.comp_zero]
    exact (hx0 x₁).trans (hx0 x₂).symm

  have hMonoRep :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) {U V : Z.Etale} (u : U ⟶ V)
        [CategoryTheory.Mono u.left],
        CategoryTheory.Mono
          ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
            (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u)
              AddCommGrpCat.free)) := by
    clear * -
    intro Z U V u _
    have hu_mono : CategoryTheory.Mono u := by
      refine ⟨fun {T} f₁ f₂ h => ?_⟩
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · have hleft : f₁.left ≫ u.left = f₂.left ≫ u.left :=
          congrArg (fun k => ((AlgebraicGeometry.Scheme.Etale.forget Z).map k).left) h
        exact (CategoryTheory.cancel_mono u.left).mp hleft
      · exact Subsingleton.elim _ _
    let φ_pre := CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free
    have hMono_app : ∀ W : Opposite Z.Etale, CategoryTheory.Mono (φ_pre.app W) := by
      intro W
      let S₁ := (CategoryTheory.yoneda.obj U).obj W
      let S₂ := (CategoryTheory.yoneda.obj V).obj W
      let g : S₁ ⟶ S₂ := (CategoryTheory.yoneda.map u).app W
      have hg_inj : Function.Injective g := fun f₁ f₂ hf => (CategoryTheory.cancel_mono u).mp hf
      by_cases hne : Nonempty S₁
      · let _ := hne
        have : CategoryTheory.SplitMono g :=
          ⟨TypeCat.ofHom (Function.invFun g), by
            ext x
            exact Function.leftInverse_invFun hg_inj x⟩
        change CategoryTheory.Mono (AddCommGrpCat.free.map g)
        infer_instance
      · have hEmpty : IsEmpty S₁ := not_nonempty_iff.mp hne
        have hid0 : 𝟙 (AddCommGrpCat.free.obj S₁) = 0 := by
          apply (AddCommGrpCat.adj.homEquiv S₁ (AddCommGrpCat.free.obj S₁)).injective
          ext x
          exact hEmpty.elim x
        refine ⟨fun {N} a b _ => ?_⟩
        calc
          a = a ≫ 𝟙 (AddCommGrpCat.free.obj S₁) := (CategoryTheory.Category.comp_id a).symm
          _ = a ≫ 0 := by rw [hid0]
          _ = 0 := CategoryTheory.Limits.comp_zero
          _ = b ≫ 0 := CategoryTheory.Limits.comp_zero.symm
          _ = b ≫ 𝟙 (AddCommGrpCat.free.obj S₁) := by rw [hid0]
          _ = b := CategoryTheory.Category.comp_id b
    have : CategoryTheory.Mono φ_pre := CategoryTheory.NatTrans.mono_of_mono_app φ_pre
    infer_instance

  have hExtCompMk0Zero :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}}
        {S : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})}
        (hS : S.ShortExact)
        (J : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        (ψ : S.X₂ ⟶ J),
        hS.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (S.f ≫ ψ)) (Nat.add_zero 1) = 0 := by
    clear * -
    intro Z S hS J ψ
    have hzero := ConcreteCategory.congr_hom
      ((fun {SC : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : SC.Exact) => SC.zero)
        (CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁' hS J 0 1 (Nat.add_zero 1)))
      (CategoryTheory.Abelian.Ext.mk₀ ψ)
    change hS.extClass.comp ((CategoryTheory.Abelian.Ext.mk₀ S.f).comp
      (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.zero_add 0)) (Nat.add_zero 1) = 0 at hzero
    rwa [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hzero

  
  
  
  let k := AlgebraicClosure F
  have hFieldEt :
      ∀ (E₀ E₁ : Type u) [Finite E₀] [Field E₀] [Finite E₁] [Field E₁] [Algebra E₀ E₁],
        AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ E₁))) := by
    clear * -
    intro E₀ E₁ _ _ _ _ _
    have : PerfectField E₀ := PerfectField.ofFinite
    have : Module.Finite E₀ E₁ := @Module.Finite.of_finite E₀ E₁ _ _ _ _
    have : Algebra.IsAlgebraic E₀ E₁ := Algebra.IsAlgebraic.of_finite E₀ E₁
    have : Algebra.IsSeparable E₀ E₁ := Algebra.IsAlgebraic.isSeparable_of_perfectField
    have hEtAlg : Algebra.Etale E₀ E₁ :=
      (Algebra.Etale.iff_exists_algEquiv_prod E₀ E₁).mpr
        ⟨PUnit, inferInstance, fun _ => E₁, inferInstance, inferInstance,
          (AlgEquiv.funUnique E₀ PUnit E₁).symm, fun _ => ⟨inferInstance, inferInstance⟩⟩
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr hEtAlg)

  have hFieldColim :
      ∀ (E₀ : Type u) [Finite E₀] [Field E₀] [Algebra F E₀] [Algebra E₀ k]
        [IsScalarTower F E₀ k] (D₀ : Type u) [CommRing D₀] [Algebra E₀ D₀],
        ∃ (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
          (B_diag : CategoryTheory.Functor ℐ CommRingCat.{u})
          (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of D₀)) B_diag)
          (c : CategoryTheory.Limits.Cocone B_diag) (_ : CategoryTheory.Limits.IsColimit c)
          (f_inf : Quiver.Hom (CommRingCat.of D₀) c.pt)
          (e_pt : c.pt ≅ CommRingCat.of (TensorProduct E₀ k D₀)),
          (∀ i : ℐ,
            @CategoryTheory.CategoryStruct.comp CommRingCat.{u} _ _ _ _ (α.app i) (c.ι.app i) =
              f_inf) ∧
          CategoryTheory.CategoryStruct.comp f_inf e_pt.hom =
            CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight : D₀ →ₐ[E₀] TensorProduct E₀ k D₀).toRingHom ∧
          (∀ i : ℐ, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (α.app i))) := by
    intro E₀ _ _ _ _ _ D₀ _ _
    let ℐ := { L : IntermediateField E₀ k // FiniteDimensional E₀ ↥L }
    let instSupℐ : SemilatticeSup ℐ :=
      { Subtype.partialOrder _ with
        sup := fun i j =>
          ⟨i.1 ⊔ j.1,
            letI := i.2; letI := j.2
            IntermediateField.finiteDimensional_sup i.1 j.1⟩
        le_sup_left := fun i j => (le_sup_left : i.1 ≤ i.1 ⊔ j.1)
        le_sup_right := fun i j => (le_sup_right : j.1 ≤ i.1 ⊔ j.1)
        sup_le := fun i j l h₁ h₂ => (sup_le h₁ h₂ : i.1 ⊔ j.1 ≤ l.1) }
    let i_bot : ℐ := ⟨⊥, inferInstance⟩
    have hFilt : CategoryTheory.IsFiltered ℐ :=
      @CategoryTheory.isFiltered_of_semilatticeSup_nonempty ℐ instSupℐ ⟨i_bot⟩
    let D : CategoryTheory.Functor ℐ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of (TensorProduct E₀ ↥i.1 D₀)
        map := fun {i j} θ => CommRingCat.ofHom
          (Algebra.TensorProduct.map
            (IntermediateField.inclusion (CategoryTheory.leOfHom θ))
            (AlgHom.id E₀ D₀)).toRingHom
        map_id := fun i => CommRingCat.hom_ext
          (congrArg AlgHom.toRingHom
            (a₁ := Algebra.TensorProduct.map
              (IntermediateField.inclusion
                (CategoryTheory.leOfHom (CategoryTheory.CategoryStruct.id i)))
              (AlgHom.id E₀ D₀))
            (a₂ := AlgHom.id E₀ (TensorProduct E₀ ↥i.1 D₀))
            (Algebra.TensorProduct.ext' fun _ _ => rfl))
        map_comp := fun {i j l} θ₁ θ₂ => CommRingCat.hom_ext
          (congrArg AlgHom.toRingHom
            (a₁ := Algebra.TensorProduct.map
              (IntermediateField.inclusion (CategoryTheory.leOfHom (θ₁ ≫ θ₂)))
              (AlgHom.id E₀ D₀))
            (a₂ := (Algebra.TensorProduct.map
              (IntermediateField.inclusion (CategoryTheory.leOfHom θ₂))
              (AlgHom.id E₀ D₀)).comp
              (Algebra.TensorProduct.map
                (IntermediateField.inclusion (CategoryTheory.leOfHom θ₁))
                (AlgHom.id E₀ D₀)))
            (Algebra.TensorProduct.ext' fun _ _ => rfl)) }
    let α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of D₀)) D :=
      { app := fun i => CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight :
            D₀ →ₐ[E₀] TensorProduct E₀ ↥i.1 D₀).toRingHom
        naturality := fun {i j} _ => CommRingCat.hom_ext (RingHom.ext fun _ => rfl) }
    let c : CategoryTheory.Limits.Cocone D :=
      { pt := CommRingCat.of (TensorProduct E₀ k D₀)
        ι :=
          { app := fun i => CommRingCat.ofHom
              (Algebra.TensorProduct.map i.1.val (AlgHom.id E₀ D₀)).toRingHom
            naturality := fun {i j} θ =>
              (CommRingCat.hom_ext
                (congrArg AlgHom.toRingHom
                  (a₁ := (Algebra.TensorProduct.map j.1.val (AlgHom.id E₀ D₀)).comp
                    (Algebra.TensorProduct.map
                      (IntermediateField.inclusion (CategoryTheory.leOfHom θ))
                      (AlgHom.id E₀ D₀)))
                  (a₂ := Algebra.TensorProduct.map i.1.val (AlgHom.id E₀ D₀))
                  (Algebra.TensorProduct.ext' fun _ _ => rfl))).trans
                (CategoryTheory.Category.comp_id _).symm } }
    have : Algebra.IsAlgebraic E₀ k := Algebra.IsAlgebraic.tower_top (K := F) E₀
    let idxOf : k → ℐ := fun x =>
      ⟨IntermediateField.adjoin E₀ {x},
        IntermediateField.adjoin.finiteDimensional (Algebra.IsAlgebraic.isAlgebraic x).isIntegral⟩
    let memIdx : ∀ x : k, x ∈ (idxOf x).1 :=
      fun x => IntermediateField.mem_adjoin_simple_self E₀ x
    let desc_of : ∀ s : CategoryTheory.Limits.Cocone D, Quiver.Hom c.pt s.pt := fun s =>
      let S_ring : Type u := ↑s.pt
      let φ_D_ring : D₀ →+* S_ring := (α.app i_bot ≫ s.ι.app i_bot).hom
      letI : Algebra E₀ S_ring := (φ_D_ring.comp (algebraMap E₀ D₀)).toAlgebra
      have h_one_tmul : ∀ (i : ℐ) (d : D₀),
          (s.ι.app i).hom ((1 : ↥i.1) ⊗ₜ[E₀] d) = φ_D_ring d := by
        intro i d
        have hle : i_bot.1 ≤ i.1 := bot_le
        exact congrArg (fun f => f.hom ((1 : ↥i_bot.1) ⊗ₜ[E₀] d))
          (s.w (CategoryTheory.homOfLE hle))
      let ψ_fun : k → S_ring := fun x =>
        (s.ι.app (idxOf x)).hom (⟨x, memIdx x⟩ ⊗ₜ[E₀] (1 : D₀))
      have hψ_eq : ∀ (i : ℐ) (y : ↥i.1),
          ψ_fun y.1 = (s.ι.app i).hom (y ⊗ₜ[E₀] (1 : D₀)) := by
        intro i y
        have hle : (idxOf y.1).1 ≤ i.1 := IntermediateField.adjoin_simple_le_iff.mpr y.2
        exact (congrArg (fun f => f.hom (⟨y.1, memIdx y.1⟩ ⊗ₜ[E₀] (1 : D₀)))
          (s.w (CategoryTheory.homOfLE hle))).symm
      let ψ_k : k →ₐ[E₀] S_ring :=
        { toFun := ψ_fun
          map_one' := (hψ_eq i_bot 1).trans (s.ι.app i_bot).hom.map_one
          map_mul' := fun x y => by
            let j : ℐ :=
              ⟨(idxOf x).1 ⊔ (idxOf y).1,
                letI := (idxOf x).2; letI := (idxOf y).2
                IntermediateField.finiteDimensional_sup (idxOf x).1 (idxOf y).1⟩
            have hx : x ∈ j.1 :=
              (le_sup_left : (idxOf x).1 ≤ (idxOf x).1 ⊔ (idxOf y).1) (memIdx x)
            have hy : y ∈ j.1 :=
              (le_sup_right : (idxOf y).1 ≤ (idxOf x).1 ⊔ (idxOf y).1) (memIdx y)
            have h_tmul :
                ((⟨x * y, j.1.mul_mem hx hy⟩ : ↥j.1) ⊗ₜ[E₀] (1 : D₀)) =
                ((⟨x, hx⟩ : ↥j.1) ⊗ₜ[E₀] (1 : D₀)) * ((⟨y, hy⟩ : ↥j.1) ⊗ₜ[E₀] (1 : D₀)) :=
              ((Algebra.TensorProduct.tmul_mul_tmul
                (⟨x, hx⟩ : ↥j.1) (⟨y, hy⟩ : ↥j.1) (1 : D₀) (1 : D₀)).trans
                (congrArg ((⟨x * y, j.1.mul_mem hx hy⟩ : ↥j.1) ⊗ₜ[E₀] ·) (one_mul (1 : D₀)))).symm
            exact (hψ_eq j ⟨x * y, j.1.mul_mem hx hy⟩).trans
              ((congrArg (s.ι.app j).hom h_tmul).trans
                (((s.ι.app j).hom.map_mul _ _).trans
                  (congrArg₂ (· * ·) (hψ_eq j ⟨x, hx⟩).symm (hψ_eq j ⟨y, hy⟩).symm)))
          map_zero' :=
            (hψ_eq i_bot 0).trans
              ((congrArg (s.ι.app i_bot).hom (TensorProduct.zero_tmul _ _)).trans
                (s.ι.app i_bot).hom.map_zero)
          map_add' := fun x y => by
            let j : ℐ :=
              ⟨(idxOf x).1 ⊔ (idxOf y).1,
                letI := (idxOf x).2; letI := (idxOf y).2
                IntermediateField.finiteDimensional_sup (idxOf x).1 (idxOf y).1⟩
            have hx : x ∈ j.1 :=
              (le_sup_left : (idxOf x).1 ≤ (idxOf x).1 ⊔ (idxOf y).1) (memIdx x)
            have hy : y ∈ j.1 :=
              (le_sup_right : (idxOf y).1 ≤ (idxOf x).1 ⊔ (idxOf y).1) (memIdx y)
            exact (hψ_eq j ⟨x + y, j.1.add_mem hx hy⟩).trans
              ((congrArg (s.ι.app j).hom (TensorProduct.add_tmul _ _ _)).trans
                (((s.ι.app j).hom.map_add _ _).trans
                  (congrArg₂ (· + ·) (hψ_eq j ⟨x, hx⟩).symm (hψ_eq j ⟨y, hy⟩).symm)))
          commutes' := fun r =>
            (hψ_eq i_bot (algebraMap E₀ ↥i_bot.1 r)).trans
              ((congrArg (s.ι.app i_bot).hom (Algebra.TensorProduct.tmul_one_eq_one_tmul r)).trans
                (h_one_tmul i_bot (algebraMap E₀ D₀ r))) }
      let φ_D : D₀ →ₐ[E₀] S_ring :=
        { φ_D_ring with commutes' := fun _ => rfl }
      CommRingCat.ofHom (Algebra.TensorProduct.productLeftAlgHom ψ_k φ_D).toRingHom
    have hc : CategoryTheory.Limits.IsColimit c :=
      { desc := desc_of
        fac := fun s i => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro (z : TensorProduct E₀ ↥i.1 D₀)
          have h_one_tmul : ∀ d : D₀,
              ((s.ι.app i).hom ((1 : ↥i.1) ⊗ₜ[E₀] d) : ↑s.pt) =
                ((α.app i_bot ≫ s.ι.app i_bot).hom d : ↑s.pt) := by
            intro d
            have hle : i_bot.1 ≤ i.1 := bot_le
            exact congrArg (fun f => (f.hom ((1 : ↥i_bot.1) ⊗ₜ[E₀] d) : ↑s.pt))
