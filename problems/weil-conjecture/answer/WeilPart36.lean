        intro A a b; ext ⟨z⟩; exact zsmul_add a b z
      have hμ_nat : ∀ {A₁ A₂ : AddCommGrpCat.{u}} (φ : A₁ ⟶ A₂) (a : ↥A₁),
          μ_hom A₁ a ≫ φ = μ_hom A₂ (φ a) := by
        intro A₁ A₂ φ a; ext ⟨z⟩; exact map_zsmul φ.hom z a
      have hμ_bij : ∀ (A : AddCommGrpCat.{u}), Function.Bijective (μ_hom A) := by
        intro A
        refine ⟨fun a b hab => ?_, fun φ => ⟨φ (ULift.up (1 : ℤ)), ?_⟩⟩
        · have h1 := ConcreteCategory.congr_hom hab (ULift.up (1 : ℤ))
          change (1 : ℤ) • a = (1 : ℤ) • b at h1
          rwa [one_zsmul, one_zsmul] at h1
        · ext ⟨z⟩
          have hz : (ULift.up z : ULift.{u} ℤ) = z • ULift.up (1 : ℤ) :=
            congrArg ULift.up (zsmul_one z).symm
          change z • φ (ULift.up (1 : ℤ)) = φ (ULift.up z)
          rw [hz, map_zsmul]

      let g_W : ∀ (W : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
          ↥A →+ ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A).H 0 :=
        fun W A =>
          let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
          haveI : C_W.Additive := by
            dsimp only [C_W]; unfold CategoryTheory.constantSheaf; infer_instance
          { toFun := fun a => CategoryTheory.Abelian.Ext.mk₀ (C_W.map (μ_hom A a))
            map_zero' := by rw [hμ_zero, C_W.map_zero, CategoryTheory.Abelian.Ext.mk₀_zero]
            map_add' := fun a b => by rw [hμ_add, C_W.map_add, CategoryTheory.Abelian.Ext.mk₀_add] }
      have hg_bij : ∀ (W : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥W] [PreconnectedSpace ↥W]
          (A : AddCommGrpCat.{u}), Function.Bijective (g_W W A) := by
        intro W _ _ A
        exact (CategoryTheory.Abelian.Ext.mk₀_bijective _ _).comp
          ((hMapBij_all W Aℤ A).comp (hμ_bij A))
      have hg_post : ∀ (W : AlgebraicGeometry.Scheme.{u}) {A₁ A₂ : AddCommGrpCat.{u}}
          (φ : A₁ ⟶ A₂) (a : ↥A₁),
          (CategoryTheory.Abelian.Ext.mk₀
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).map φ)).postcomp
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
            (Nat.add_zero 0) (g_W W A₁ a) = g_W W A₂ (φ a) := by
        intro W A₁ A₂ φ a
        let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
        change (CategoryTheory.Abelian.Ext.mk₀ (C_W.map (μ_hom A₁ a))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (C_W.map φ)) (Nat.add_zero 0) =
          CategoryTheory.Abelian.Ext.mk₀ (C_W.map (μ_hom A₂ (φ a)))
        rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← C_W.map_comp, hμ_nat φ a]

      let D₀ := weilProjectiveSpaceOver F 1
      let k := AlgebraicClosure F
      let g_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
      let D_ov_bar := weilBaseChangeOver F k D₀
      let Z_ov_bar := weilBaseChangeOver F k Z_tilde
      let pr_D : Quiver.Hom D_ov_bar.left D₀.left := CategoryTheory.Limits.pullback.fst D₀.hom g_k
      let pr_Z : Quiver.Hom Z_ov_bar.left Z_tilde.left :=
        CategoryTheory.Limits.pullback.fst Z_tilde.hom g_k
      have hPb_fbar' : CategoryTheory.IsPullback pr_Z f_bar.left f₀.left pr_D := hPb_fbar

      let C_Dbar := CategoryTheory.constantSheaf D_ov_bar.left.smallEtaleTopology AddCommGrpCat.{u}
      let C_Zbar := CategoryTheory.constantSheaf Z_ov_bar.left.smallEtaleTopology AddCommGrpCat.{u}
      have : C_Dbar.Additive := by
        dsimp only [C_Dbar]; unfold CategoryTheory.constantSheaf; infer_instance
      have : C_Zbar.Additive := by
        dsimp only [C_Zbar]; unfold CategoryTheory.constantSheaf; infer_instance
      let T_Dbar := weilEtaleIdTerminal.{u} D_ov_bar.left
      let hT_Dbar := weilEtaleIdTerminalIsTerminal.{u} D_ov_bar.left
      let adj_Dbar := CategoryTheory.constantSheafAdj D_ov_bar.left.smallEtaleTopology
        AddCommGrpCat.{u} hT_Dbar
      obtain ⟨hT_Zbar⟩ := hBCBase.1 f_bar.left hT_Dbar

      let e_hom : ∀ (A : AddCommGrpCat.{u}),
          A ⟶ (weilEtaleHigherDirectImage f_bar.left 0 (C_Zbar.obj A)).obj.obj
            (Opposite.op T_Dbar) :=
        fun A => AddCommGrpCat.ofHom
          ((weilOuterTrFibEdgeHom f_bar.left T_Dbar hT_Zbar (C_Zbar.obj A) 0).comp
            (g_W Z_ov_bar.left A))
      let α_hom : ∀ (A : AddCommGrpCat.{u}),
          C_Dbar.obj A ⟶ weilEtaleHigherDirectImage f_bar.left 0 (C_Zbar.obj A) :=
        fun A => (adj_Dbar.homEquiv A _).symm (e_hom A)

      have hα_nat : ∀ {A₁ A₂ : AddCommGrpCat.{u}} (φ : A₁ ⟶ A₂),
          C_Dbar.map φ ≫ α_hom A₂ =
            α_hom A₁ ≫ weilEtaleHigherDirectImageMap f_bar.left 0 (C_Zbar.map φ) := by
        intro A₁ A₂ φ
        apply (adj_Dbar.homEquiv A₁ _).injective
        rw [adj_Dbar.homEquiv_naturality_left, adj_Dbar.homEquiv_naturality_right,
          Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        ext a
        change weilOuterTrFibEdgeHom f_bar.left T_Dbar hT_Zbar (C_Zbar.obj A₂) 0
            (g_W Z_ov_bar.left A₂ (φ a)) =
          ((weilEtaleHigherDirectImageMap f_bar.left 0 (C_Zbar.map φ)).hom.app (Opposite.op T_Dbar))
            (weilOuterTrFibEdgeHom f_bar.left T_Dbar hT_Zbar (C_Zbar.obj A₁) 0
              (g_W Z_ov_bar.left A₁ a))
        rw [(hBCBase.2.1 f_bar.left 0).2.2 T_Dbar hT_Zbar (C_Zbar.map φ)
            (g_W Z_ov_bar.left A₁ a),
          hg_post Z_ov_bar.left φ a]

      let AM := fun n : ℕ => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
      have hPrime' : Nat.Prime ℓ := Fact.out
      have hℓ_k : (ℓ : k) ≠ 0 := by
        intro h0
        have hF0 : (ℓ : F) = 0 := by
          apply (algebraMap F k).injective
          rw [map_natCast, map_zero]
          exact h0
        have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp hF0
        rcases CharP.char_is_prime_or_zero F (ringChar F) with hp | hp0
        · exact hℓ ((Nat.Prime.dvd_iff_eq hPrime' hp.ne_one).mp hdvd)
        · rw [hp0, zero_dvd_iff] at hdvd
          exact hPrime'.ne_zero hdvd
      have : AlgebraicGeometry.IsProper D_ov_bar.hom :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback D₀.hom g_k) inferInstance
      have : AlgebraicGeometry.LocallyOfFiniteType D_ov_bar.hom := inferInstance
      have hTor_Zbar_1 : ℓ • CategoryTheory.CategoryStruct.id
          (weilEtaleTorsionSheaf Z_ov_bar.left (ℓ ^ 1)) = 0 := by
        let U := AddCommGrpCat.uliftFunctor.{u, 0}
        let A_1 := AddCommGrpCat.of (ZMod (ℓ ^ 1))
        have hA1 : (ℓ ^ 1) • (𝟙 A_1) = 0 := by
          ext a; change (ℓ ^ 1) • a = 0; rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
        have hU1 : (ℓ ^ 1) • (𝟙 (U.obj A_1)) = 0 := by
          rw [← U.map_id, ← Functor.map_nsmul, hA1, U.map_zero]
        have hC1 : (ℓ ^ 1) • (𝟙 (C_Zbar.obj (U.obj A_1))) = 0 := by
          rw [← C_Zbar.map_id, ← Functor.map_nsmul, hU1, C_Zbar.map_zero]
        rwa [pow_one ℓ] at hC1

      have hBase0 : CategoryTheory.IsIso (α_hom (AM (ℓ ^ 1))) := by
        let A₀ := AM (ℓ ^ 1)
        apply hStalkIso_raw D_ov_bar.left (α_hom A₀)
        intro y
        let κ := D_ov_bar.left.residueField y
        let Ω := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let bar_y : Quiver.Hom S_Ω D_ov_bar.left :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
            (D_ov_bar.left.fromSpecResidueField y)
        let T_Ω := weilEtaleIdTerminal.{u} S_Ω
        let hT_Ω := weilEtaleIdTerminalIsTerminal.{u} S_Ω
        let adj_Ω := CategoryTheory.constantSheafAdj S_Ω.smallEtaleTopology AddCommGrpCat.{u} hT_Ω
        let C_SΩ := CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}
        have _hIrred_SΩ : IrreducibleSpace ↥S_Ω := inferInstance
        have : Nonempty ↥S_Ω := inferInstance
        have : PreconnectedSpace ↥S_Ω := inferInstance

        let Z_y := CategoryTheory.Limits.pullback f_bar.left bar_y
        let pr₁ : Quiver.Hom Z_y Z_ov_bar.left := CategoryTheory.Limits.pullback.fst f_bar.left bar_y
        let π_y : Quiver.Hom Z_y S_Ω := CategoryTheory.Limits.pullback.snd f_bar.left bar_y
        have hPb_y : CategoryTheory.IsPullback pr₁ π_y f_bar.left bar_y :=
          CategoryTheory.IsPullback.of_hasPullback f_bar.left bar_y
        have hPb_paste : CategoryTheory.IsPullback (pr₁ ≫ pr_Z) π_y f₀.left (bar_y ≫ pr_D) :=
          hPb_y.paste_horiz hPb_fbar'
        have _hIrred_fib : IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left (bar_y ≫ pr_D)) :=
          hFibIrred Ω (bar_y ≫ pr_D)
        let homeo_Zy : ↥(CategoryTheory.Limits.pullback f₀.left (bar_y ≫ pr_D)) ≃ₜ ↥Z_y :=
          AlgebraicGeometry.Scheme.homeoOfIso hPb_paste.isoPullback.symm
        have hNe_Zy : Nonempty ↥Z_y := Nonempty.map homeo_Zy inferInstance
        have hPre_Zy : PreconnectedSpace ↥Z_y := by
          refine ⟨?_⟩
          rw [← Set.image_univ_of_surjective homeo_Zy.surjective]
          exact PreirreducibleSpace.isPreirreducible_univ.isPreconnected.image homeo_Zy
            homeo_Zy.continuous.continuousOn
        have : Nonempty ↥Z_y := hNe_Zy
        have : PreconnectedSpace ↥Z_y := hPre_Zy

        let B_y := weilEtaleSitePullback bar_y
        let pf_y := B_y.sheafPushforwardContinuous AddCommGrpCat.{u}
          D_ov_bar.left.smallEtaleTopology S_Ω.smallEtaleTopology
        let pb_y := B_y.sheafPullback AddCommGrpCat.{u}
          D_ov_bar.left.smallEtaleTopology S_Ω.smallEtaleTopology
        let adj_y := B_y.sheafAdjunctionContinuous AddCommGrpCat.{u}
          D_ov_bar.left.smallEtaleTopology S_Ω.smallEtaleTopology
        let ℋ_y := weilEtaleHigherDirectImage π_y 0 (weilEtaleTorsionSheaf Z_y (ℓ ^ 1))

        obtain ⟨β_y, hβ_y⟩ := ((hBCBase.2.2.1 f_bar.left bar_y π_y pr₁ hPb_y.w).1
          (weilEtaleTorsionSheaf Z_ov_bar.left (ℓ ^ 1)) 0).1
        have hIso_βy : CategoryTheory.IsIso ((adj_y.homEquiv _ _).symm β_y) :=
          hPBC_k k ℓ hℓ_k Z_ov_bar D_ov_bar f_bar bar_y π_y pr₁ hPb_y
            (weilEtaleTorsionSheaf Z_ov_bar.left (ℓ ^ 1)) hTor_Zbar_1 0 hβ_y
        let c_pr₁ := weilEtaleConstPullbackHom pr₁
          (weilEtaleIdTerminalIsTerminal.{u} Z_y)
          (weilEtaleIdTerminalIsTerminal.{u} Z_ov_bar.left) A₀
        have : CategoryTheory.IsIso c_pr₁ := (sys pr₁).hConstIso _ _ A₀
        let e_cpr₁ := CategoryTheory.asIso c_pr₁
        let e_R_pr₁ : weilEtaleHigherDirectImage π_y 0 _ ≅ ℋ_y :=
          { hom := weilEtaleHigherDirectImageMap π_y 0 e_cpr₁.hom
            inv := weilEtaleHigherDirectImageMap π_y 0 e_cpr₁.inv
            hom_inv_id := ((hBCBase.2.1 π_y 0).2.1 e_cpr₁.hom e_cpr₁.inv).symm.trans
              ((congrArg (weilEtaleHigherDirectImageMap π_y 0) e_cpr₁.hom_inv_id).trans
                ((hBCBase.2.1 π_y 0).1 _))
            inv_hom_id := ((hBCBase.2.1 π_y 0).2.1 e_cpr₁.inv e_cpr₁.hom).symm.trans
              ((congrArg (weilEtaleHigherDirectImageMap π_y 0) e_cpr₁.inv_hom_id).trans
                ((hBCBase.2.1 π_y 0).1 _)) }
        let γ_y := β_y ≫ pf_y.map e_R_pr₁.hom
        have hγ_y : WeilIsSingDevAlgBCConstPush f_bar.left bar_y π_y pr₁ hPb_y.w A₀ 0 γ_y :=
          ⟨β_y, hβ_y, rfl⟩
        let γ_tilde := (adj_y.homEquiv _ _).symm γ_y
        have hγ_tilde_eq : γ_tilde = (adj_y.homEquiv _ _).symm β_y ≫ e_R_pr₁.hom := by
          apply (adj_y.homEquiv _ _).injective
          rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
            Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        have hIso_γtilde : CategoryTheory.IsIso γ_tilde := by
          rw [hγ_tilde_eq]
          have : CategoryTheory.IsIso ((adj_y.homEquiv _ _).symm β_y) := hIso_βy
          have : CategoryTheory.IsIso e_R_pr₁.hom := e_R_pr₁.isIso_hom
          exact CategoryTheory.IsIso.comp_isIso
        let e_γy := @CategoryTheory.asIso _ _ _ _ γ_tilde hIso_γtilde

        let c_y := weilEtaleConstPullbackHom bar_y hT_Ω hT_Dbar A₀
        have : CategoryTheory.IsIso c_y := (sys bar_y).hConstIso hT_Ω hT_Dbar A₀
        let e_cy := CategoryTheory.asIso c_y
        let ψ_y : C_SΩ.obj A₀ ⟶ ℋ_y := e_cy.inv ≫ pb_y.map (α_hom A₀) ≫ e_γy.hom

        obtain ⟨hT_pull⟩ := hBCBase.1 bar_y hT_Dbar
        obtain ⟨hT_Zy⟩ := hBCBase.1 π_y hT_Ω
        let τ_y : B_y.obj T_Dbar ⟶ T_Ω := hT_Ω.from (B_y.obj T_Dbar)
        let σ_g : T_Ω ⟶ B_y.obj T_Dbar := hT_pull.from T_Ω
        have hστ : σ_g ≫ τ_y = 𝟙 T_Ω := hT_Ω.hom_ext _ _
        have hℋ_id : ℋ_y.obj.map τ_y.op ≫ ℋ_y.obj.map σ_g.op =
            𝟙 (ℋ_y.obj.obj (Opposite.op T_Ω)) := by
          rw [← ℋ_y.obj.map_comp, ← op_comp, hστ, op_id, ℋ_y.obj.map_id]

        have hcψ : c_y ≫ ψ_y = pb_y.map (α_hom A₀) ≫ γ_tilde := by
          change e_cy.hom ≫ (e_cy.inv ≫ pb_y.map (α_hom A₀) ≫ γ_tilde) =
            pb_y.map (α_hom A₀) ≫ γ_tilde
          rw [← Category.assoc e_cy.hom, e_cy.hom_inv_id, Category.id_comp]
        have hAdj1 := congrArg
          (adj_Dbar.homEquiv A₀ (pf_y.obj ℋ_y) ∘ adj_y.homEquiv (C_Dbar.obj A₀) ℋ_y) hcψ
        dsimp only [Function.comp_apply] at hAdj1
        have hLHS : adj_Dbar.homEquiv A₀ (pf_y.obj ℋ_y)
              (adj_y.homEquiv (C_Dbar.obj A₀) ℋ_y (c_y ≫ ψ_y)) =
            adj_Ω.homEquiv A₀ ℋ_y ψ_y ≫ ℋ_y.obj.map τ_y.op := by
          rw [adj_y.homEquiv_naturality_right]
          dsimp only [c_y, weilEtaleConstPullbackHom]
          rw [Equiv.apply_symm_apply, adj_Dbar.homEquiv_naturality_right, Equiv.apply_symm_apply]
          change (adj_Ω.unit.app A₀ ≫ (C_SΩ.obj A₀).obj.map τ_y.op) ≫
              ψ_y.hom.app (Opposite.op (B_y.obj T_Dbar)) =
            (adj_Ω.unit.app A₀ ≫ ψ_y.hom.app (Opposite.op T_Ω)) ≫ ℋ_y.obj.map τ_y.op
          rw [Category.assoc, ψ_y.hom.naturality τ_y.op, Category.assoc]
        have hRHS : adj_Dbar.homEquiv A₀ (pf_y.obj ℋ_y)
              (adj_y.homEquiv (C_Dbar.obj A₀) ℋ_y (pb_y.map (α_hom A₀) ≫ γ_tilde)) =
            e_hom A₀ ≫ γ_y.hom.app (Opposite.op T_Dbar) := by
          rw [adj_y.homEquiv_naturality_left]
          dsimp only [γ_tilde, α_hom]
          rw [Equiv.apply_symm_apply, adj_Dbar.homEquiv_naturality_right, Equiv.apply_symm_apply]
          rfl
        rw [hLHS, hRHS] at hAdj1
        have hAdj2 : adj_Ω.homEquiv A₀ ℋ_y ψ_y =
            e_hom A₀ ≫ γ_y.hom.app (Opposite.op T_Dbar) ≫ ℋ_y.obj.map σ_g.op := by
          calc
            adj_Ω.homEquiv A₀ ℋ_y ψ_y
              = adj_Ω.homEquiv A₀ ℋ_y ψ_y ≫ (ℋ_y.obj.map τ_y.op ≫ ℋ_y.obj.map σ_g.op) := by
                  rw [hℋ_id]
                  exact (Category.comp_id _).symm
            _ = (adj_Ω.homEquiv A₀ ℋ_y ψ_y ≫ ℋ_y.obj.map τ_y.op) ≫ ℋ_y.obj.map σ_g.op :=
                  (Category.assoc _ _ _).symm
            _ = (e_hom A₀ ≫ γ_y.hom.app (Opposite.op T_Dbar)) ≫ ℋ_y.obj.map σ_g.op :=
                  congrArg (· ≫ ℋ_y.obj.map σ_g.op) hAdj1
            _ = e_hom A₀ ≫ γ_y.hom.app (Opposite.op T_Dbar) ≫ ℋ_y.obj.map σ_g.op :=
                  Category.assoc _ _ _

        obtain ⟨p_pull, hp_pull⟩ := hPullEx pr₁ (ℓ ^ 1) 0
        have hp_pull_g : ∀ a : ↥A₀, p_pull (g_W Z_ov_bar.left A₀ a) = g_W Z_y A₀ a := by
          intro a
          rcases hp_pull with
            ⟨hc_p, hr_p, hAdd_p, hLim_p, hColim_p, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, _, hp_eq⟩
          let P_pull := @CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback pr₁) AddCommGrpCat.{u} _
            Z_ov_bar.left.smallEtaleTopology Z_y.smallEtaleTopology hc_p hr_p
          let C_Zy := CategoryTheory.constantSheaf Z_y.smallEtaleTopology AddCommGrpCat.{u}
          let πℤ := @weilEtaleConstPullbackHom _ _ pr₁ hc_p hr_p T₁ hT₁ T₂ hT₂ Aℤ
          let πM := @weilEtaleConstPullbackHom _ _ pr₁ hc_p hr_p T₁ hT₁ T₂ hT₂ A₀
          change ιℤ ≫ πℤ = 𝟙 (C_Zy.obj Aℤ) at hιπ
          have hNat_μ : P_pull.map (C_Zbar.map (μ_hom A₀ a)) ≫ πM =
              πℤ ≫ C_Zy.map (μ_hom A₀ a) :=
            @hConstPullNat _ _ pr₁ hc_p hr_p T₁ hT₁ T₂ hT₂ Aℤ A₀ (μ_hom A₀ a)
          have hComp_μ : (ιℤ ≫ P_pull.map (C_Zbar.map (μ_hom A₀ a))) ≫ πM =
              C_Zy.map (μ_hom A₀ a) := by
            rw [Category.assoc, hNat_μ, ← Category.assoc, hιπ, Category.id_comp]
          rw [hp_eq (g_W Z_ov_bar.left A₀ a)]
          change (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp (C_Zy.obj Aℤ) (Nat.add_zero 0)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull hAdd_p hLim_p hColim_p _ _
                (C_Zbar.obj Aℤ) (C_Zbar.obj A₀) 0)
                (CategoryTheory.Abelian.Ext.mk₀ (C_Zbar.map (μ_hom A₀ a))))
              (Nat.zero_add 0)) =
            CategoryTheory.Abelian.Ext.mk₀ (C_Zy.map (μ_hom A₀ a))
          rw [CategoryTheory.Functor.mapExtAddHom_apply,
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          change ((CategoryTheory.Abelian.Ext.mk₀
              (ιℤ ≫ P_pull.map (C_Zbar.map (μ_hom A₀ a)))).comp
            (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 0)) = _
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hComp_μ]

        have hEqFn : (adj_Ω.homEquiv A₀ ℋ_y ψ_y : ↥A₀ → _) =
            (weilOuterTrFibEdgeHom π_y T_Ω hT_Zy (weilEtaleTorsionSheaf Z_y (ℓ ^ 1)) 0) ∘
              (g_W Z_y A₀) := by
          funext a
          have h1 := ConcreteCategory.congr_hom hAdj2 a
          have hTri := hPastePkg.2.2 f_bar.left bar_y π_y pr₁ hPb_y.w
            T_Dbar hT_Dbar hT_Zbar T_Ω hT_Ω hT_Zy σ_g (ℓ ^ 1) 0 hγ_y hp_pull
            (g_W Z_ov_bar.left A₀ a)
          exact h1.trans (hTri.trans (congrArg _ (hp_pull_g a)))

        have hBij_adjψ : Function.Bijective (adj_Ω.homEquiv A₀ ℋ_y ψ_y) := by
          rw [hEqFn]
          exact (hSpecEdgeBij Ω π_y T_Ω hT_Ω hT_Zy (weilEtaleTorsionSheaf Z_y (ℓ ^ 1)) 0).comp
            (hg_bij Z_y A₀)
        have hIso_adjψ : CategoryTheory.IsIso (adj_Ω.homEquiv A₀ ℋ_y ψ_y) :=
