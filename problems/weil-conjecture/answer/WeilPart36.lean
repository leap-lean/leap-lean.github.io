          @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra ∧
          AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)) := by
    clear * -
    intro P Ω B_bar
    let K₀ := FractionRing P
    have hinj_P_K0 : Function.Injective (algebraMap P K₀) := IsFractionRing.injective P K₀
    have hinj_K0_Ω : Function.Injective (algebraMap K₀ Ω) := RingHom.injective (algebraMap K₀ Ω)
    have hinj_P_Ω : Function.Injective (algebraMap P Ω) := by
      rw [IsScalarTower.algebraMap_eq P K₀ Ω]
      exact hinj_K0_Ω.comp hinj_P_K0
    have hinj_P_B : Function.Injective (algebraMap P ↥B_bar) := by
      intro p q hpq
      apply hinj_P_Ω
      exact congrArg Subtype.val hpq
    let ev0 : P →+* k := Polynomial.evalRingHom 0
    have hev0_surj : Function.Surjective ev0 := fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
    have hm0_ker : RingHom.ker ev0 = Ideal.span ({Polynomial.X} : Set P) := by
      ext p
      rw [RingHom.mem_ker, Ideal.mem_span_singleton]
      change Polynomial.eval 0 p = 0 ↔ Polynomial.X ∣ p
      rw [← Polynomial.IsRoot.def, ← Polynomial.dvd_iff_isRoot, map_zero, sub_zero]
    have _ : (Ideal.span ({Polynomial.X} : Set P)).IsMaximal := by
      rw [← hm0_ker]
      exact RingHom.ker_isMaximal_of_surjective ev0 hev0_surj
    have hker_le : RingHom.ker (algebraMap P ↥B_bar) ≤ Ideal.span ({Polynomial.X} : Set P) := by
      intro p hp
      rw [RingHom.mem_ker] at hp
      rw [hinj_P_B (hp.trans (map_zero _).symm)]
      exact Ideal.zero_mem _
    have _ : Algebra.IsIntegral P ↥B_bar :=
      ⟨fun ⟨b, q_pol, hq_mon, hq_ev⟩ => ⟨q_pol, hq_mon, Subtype.ext (by
        change (B_bar.val (Polynomial.aeval ⟨b, _⟩ q_pol)) = 0
        rw [← Polynomial.aeval_algHom_apply B_bar.val]
        exact hq_ev)⟩⟩
    obtain ⟨M_max, hM_max, hM_under⟩ :=
