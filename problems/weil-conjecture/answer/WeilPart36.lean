    have hSE₀ : SC₀.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel α_j }
    have hc_zero : ∀ c : C_0.H 0, c = 0 := by
      intro c
      have hδ_α : (c.comp hSE₀.extClass (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ α_j) (Nat.add_zero 1) = 0 := by
        rw [CategoryTheory.Abelian.Ext.comp_assoc c hSE₀.extClass
            (CategoryTheory.Abelian.Ext.mk₀ α_j) (Nat.zero_add 1) (Nat.add_zero 1) (by omega),
