    let g₀_poly : Fin r → MvPolynomial (Fin n) ↑(D_poly.obj i₀) :=
      fun s => MvPolynomial.map (D_poly.map θ_jac).hom (g_tilde s)
    let h₀_poly : MvPolynomial (Fin n) ↑(D_poly.obj i₀) :=
      MvPolynomial.map (D_poly.map θ_jac).hom h_tilde
    let J₀ : Ideal (MvPolynomial (Fin n) ↑(D_poly.obj i₀)) := Ideal.span (Set.range R₀)
    let f₀ : D_poly.obj i₀ ⟶ CommRingCat.of (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀) :=
