    let η_M₀ : M₀ ⟶ (C_sh.obj M₀).obj.obj (Opposite.op T_sh) := adj_csh.unit.app M₀
    have hη_M₀_bij : Function.Bijective η_M₀ :=
      hSheafifyBijOfTopSieve T_sh (hTopHensel R_sh)
        ((CategoryTheory.Functor.const (Opposite S_sh.Etale)).obj M₀)
    let f_lhs : ↥M₀ →+ ↥(G_sh.obj.obj (Opposite.op T_sh)) :=
      (η_M₀ ≫ Θ_sh.hom.app (Opposite.op T_sh)).hom
    let f_rhs : ↥M₀ →+ ↥(G_sh.obj.obj (Opposite.op T_sh)) :=
