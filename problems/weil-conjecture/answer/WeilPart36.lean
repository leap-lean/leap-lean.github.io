  · intro hCoverKill
    apply hZeroOfAffSieve Q
    intro W₀ _ s₀
    let W : AlgebraicGeometry.Scheme.{u} := W₀.left
    let w : W ⟶ Y := W₀.hom
    have _ : AlgebraicGeometry.IsAffine W := inferInstance
    have _ : AlgebraicGeometry.Etale w := W₀.prop
    let s₀_U : ↥((G_U.cohomologyPresheaf b).obj (Opposite.op (B_j.obj W₀))) := s₀
