  have hSub_yonU : Subsingleton (Aℤ ⟶ Q_R.obj.obj (Opposite.op U_Ω)) :=
    ⟨fun g₁ g₂ => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm.injective
