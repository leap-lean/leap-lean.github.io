        congrArg (fun z => p₃ (Θ_Z (B_fbar.obj W₃) z)) hz₃_eq
      _ = p₃ (q₂ (Θ_Z (B_fbar.obj W₂) z₂)) :=
        congrArg p₃ hθ₂
      _ = p₂ (Θ_Z (B_fbar.obj W₂) z₂) := by
        rw [hcomp₂, AddMonoidHom.comp_apply]

