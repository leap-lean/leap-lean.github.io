      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let Q_R := CategoryTheory.Limits.pullback g_Q.left g_R
    let Q_R_Ω := CategoryTheory.Limits.pullback
      (CategoryTheory.Limits.pullback.snd g_Q.left g_R) j_R
    let j_Q : Q_R_Ω ⟶ Q_R :=
      CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd g_Q.left g_R) j_R
    (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ Q_R) [AlgebraicGeometry.Etale w]
      (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
        weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Q w) ℓ 0),
      WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Q w) ℓ 0 ψ₀ →
      Function.Bijective ψ₀) ∧
    (∀ (b : ℕ), 1 ≤ b → b ≤ 2 * m →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j_Q b (weilEtaleTorsionSheaf Q_R_Ω ℓ))) :=
by
  
  have hAtlasGen :
      ∀ (d_rel : ℕ) (X₀_sch U₀_sch : AlgebraicGeometry.Scheme.{u})
        (p_base : U₀_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
