    have hpb_ι : CategoryTheory.IsPullback ι_TXR p_L fst_XR j_WX :=
      CategoryTheory.IsPullback.of_right hpb_ι_outer hι_TXR_fst
        (CategoryTheory.IsPullback.of_hasPullback f_X g_A).flip
    have hqx_pt : j_WX.base (x_tilde_0.base pt_k) = x_pt.base pt_k := by
      change (x_tilde_0 ≫ j_WX).base pt_k = x_pt.base pt_k
      rw [hx_tilde_fac]
    obtain ⟨Q₁, hQ₁_z, hQ₁_L⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_ι z (x_tilde_0.base pt_k)
        (hz_fst.trans hqx_pt.symm)
    obtain ⟨Q₂, hQ₂_z₀, hQ₂_L⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_ι z₀ (x_tilde_0.base pt_k)
        (hz₀_fst.trans hqx_pt.symm)
    have hQ₁_R : p_R_spec.base Q₁ = IsLocalRing.closedPoint A_bar := by
      rw [← hι_TXR_snd]
      change snd_XR.base (ι_TXR.base Q₁) = IsLocalRing.closedPoint A_bar
      rw [hQ₁_z, hz_closed]
    have hQ₂_R : p_R_spec.base Q₂ = IsLocalRing.closedPoint A_bar := by
      rw [← hι_TXR_snd]
      change snd_XR.base (ι_TXR.base Q₂) = IsLocalRing.closedPoint A_bar
      rw [hQ₂_z₀, hz₀_snd]
    have hker_Q : ∀ a : A_X, ε₀ a = 0 → ι_A a ∈ Q₁.asIdeal ∧ ι_A a ∈ Q₂.asIdeal := by
      intro a ha0
      have hmem_x : a ∈ (x_tilde_0.base pt_k).asIdeal := by
