      have hdvd : ℓ ^ (r' + 1) ∣ ℓ ^ (r' + 2) := pow_dvd_pow ℓ (Nat.le_succ (r' + 1))
      let π : ZMod (ℓ ^ (r' + 2)) →+ ZMod (ℓ ^ (r' + 1)) :=
        (ZMod.castHom hdvd (ZMod (ℓ ^ (r' + 1)))).toAddMonoidHom
      have hcomp_zero : ∀ a : ZMod ℓ, π (μ a) = 0 := by
        intro a
        change ZMod.castHom hdvd (ZMod (ℓ ^ (r' + 1)))
          ((a.val * ℓ ^ (r' + 1) : ℕ) : ZMod (ℓ ^ (r' + 2))) = 0
        rw [map_natCast, Nat.cast_mul, ZMod.natCast_self (ℓ ^ (r' + 1)), mul_zero]
      have hμ_inj : Function.Injective μ := by
        rw [injective_iff_map_eq_zero]
        intro a ha
        change ((a.val * ℓ ^ (r' + 1) : ℕ) : ZMod (ℓ ^ (r' + 2))) = 0 at ha
        rw [ZMod.natCast_eq_zero_iff, hpow_succ] at ha
        have hdvd_a : ℓ ∣ a.val := (Nat.mul_dvd_mul_iff_right hpow_pos).mp ha
