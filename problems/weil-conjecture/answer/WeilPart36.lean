    have hJ_det₁_to_0 :
        MvPolynomial.map (D_poly.map θ_jac).hom J_mat₁.det = J_mat₀.det := by
      rw [RingHom.map_det (MvPolynomial.map (D_poly.map θ_jac).hom) J_mat₁, hJ_mat₁_to_0]
    have hBezout₀ : ∑ s : Fin r, g₀_poly s * R₀ s = J_mat₀.det * h₀_poly - 1 := by
      have hsub : (∑ s : Fin r, g₀_poly s * R₀ s) - (J_mat₀.det * h₀_poly - 1) = 0 := by
        rw [← hΔ₀]
        dsimp [Δ₁, g₀_poly, R₀, h₀_poly]
        rw [map_sub, map_sum, map_sub, map_mul, map_one, hJ_det₁_to_0]
        congr 1
        exact Finset.sum_congr rfl fun s _ => (map_mul _ _ _).symm
      exact sub_eq_zero.mp hsub
    have halg_pre₀_apply : ∀ p : MvPolynomial (Fin n) ↑(D_poly.obj i₀),
        (algebraMap P_pre₀.Ring (MvPolynomial (Fin n) ↑(D_poly.obj i₀) ⧸ J₀)) p =
