          (weilEtaleHigherDirectImage j_A b (weilEtaleTorsionSheaf A_Ω ℓ))) :
    let g_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
