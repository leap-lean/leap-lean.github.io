      have hp_Bg'_zero : p_Bg' (p_sym ξ) = 0 :=
        (congrArg p_Bg' ((Θ_U (B_j.obj W₀)).apply_symm_apply (p_sym ξ)).symm).trans
          ((hΘ_U (B_j.map g') p_Bg' hp_Bg' s₀).symm.trans
            ((congrArg (Θ_U (B_j.obj V₀)) hs₀_zero).trans (map_zero (Θ_U (B_j.obj V₀)))))
      have hp_mid_zero : p_mid ξ = 0 :=
        (congrFun (congrArg DFunLike.coe hp_mid_eq) ξ).trans hp_Bg'_zero
      refine ⟨⟨V_x, v_x⟩, hAff_Vx, hEt_vx, hx_mem, fun p_x hp_x => ?_⟩
      have hp_x_comp : WeilIsTorsionEtalePullback (α_g' ≫ (m_g' ≫ sym_hom)) ℓ b p_x :=
        Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ b p_x) hTriFwd.symm) hp_x
