      exact hBij_comp hpb_QΩ.isoPullback.hom i_QΩ i (hBij_iso hpb_QΩ.isoPullback i) hBij_iQΩ
    · intro ψ_top _
      have hSub_Qk1 : Subsingleton (weilEtaleTorsionH Q_k1 ℓ (2 * m + 1)) :=
        (hQ3_fib k₁ (u_R ≫ g_R)).1
      have hSub_QΩ : Subsingleton (weilEtaleTorsionH Q_Ω ℓ (2 * m + 1)) :=
        (hQ3_fib Ω (j_R ≫ g_R)).1
      obtain ⟨p_k1, hp_k1⟩ := weil_etale_torsion_pullback_functoriality.1 i_Qk1 ℓ (2 * m + 1)
      have hInj_k1 := (hBij_iQk1 (2 * m + 1) p_k1 hp_k1).1
      have hSub_QR : Subsingleton (weilEtaleTorsionH Q_R ℓ (2 * m + 1)) :=
        ⟨fun a b => hInj_k1 (Subsingleton.elim (p_k1 a) (p_k1 b))⟩
      obtain ⟨p_e, hp_e⟩ :=
        weil_etale_torsion_pullback_functoriality.1 hpb_QΩ.isoPullback.inv ℓ (2 * m + 1)
      have hInj_e := (hBij_iso hpb_QΩ.isoPullback.symm (2 * m + 1) p_e hp_e).1
      have hSub_QRΩ : Subsingleton (weilEtaleTorsionH Q_R_Ω ℓ (2 * m + 1)) :=
        ⟨fun a b => hInj_e (Subsingleton.elim (p_e a) (p_e b))⟩
      exact ⟨fun a b _ => Subsingleton.elim a b, fun y => ⟨0, Subsingleton.elim (ψ_top 0) y⟩⟩

  
  obtain ⟨hOdpNonempty, hOdpUnique⟩ :=
    weil_proj_quadric_val_ring_odp_tbar_regular_and_unique_origin
      m P Polynomial.X R_bar p_R t_bar ht_eq ht_ne Ω φ_R_Ω hLoc_Ω
  let C_Q := AlgebraicGeometry.Spec (CommRingCat.of
    (MvPolynomial (Fin (m + 1) × Fin 2) P ⧸ Ideal.span
      {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C (Polynomial.X : P)}))
  let p_CQ : C_Q ⟶ U_line :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
  let C_Q_R := CategoryTheory.Limits.pullback p_CQ g_R
  let fst_CQR := CategoryTheory.Limits.pullback.fst p_CQ g_R
  let snd_CQR := CategoryTheory.Limits.pullback.snd p_CQ g_R
  let C_Q_R_Ω := CategoryTheory.Limits.pullback snd_CQR j_R
  let j_CQ : C_Q_R_Ω ⟶ C_Q_R := CategoryTheory.Limits.pullback.fst snd_CQR j_R
  let ι_affQ_R : C_Q_R ⟶ Q_R :=
    CategoryTheory.Limits.pullback.lift (fst_CQR ≫ ι_affQ) snd_CQR
      (by rw [Category.assoc, hQ1.1]; exact CategoryTheory.Limits.pullback.condition)
  have hι_affQR_fst : ι_affQ_R ≫ fst_QR = fst_CQR ≫ ι_affQ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hι_affQR_snd : ι_affQ_R ≫ f_QR = snd_CQR :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_affQR_outer :
      CategoryTheory.IsPullback (ι_affQ_R ≫ f_QR) fst_CQR g_R (ι_affQ ≫ g_Q.left) := by
    rw [hι_affQR_snd, hQ1.1]
    exact (CategoryTheory.IsPullback.of_hasPullback p_CQ g_R).flip
  have hpb_affQR : CategoryTheory.IsPullback ι_affQ_R fst_CQR fst_QR ι_affQ :=
    CategoryTheory.IsPullback.of_right hpb_affQR_outer hι_affQR_fst
      (CategoryTheory.IsPullback.of_hasPullback g_Q.left g_R).flip
  have _ : AlgebraicGeometry.IsOpenImmersion ι_affQ_R :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hpb_affQR.flip inferInstance
  let ι_affQ_R_Ω : C_Q_R_Ω ⟶ Q_R_Ω :=
    CategoryTheory.Limits.pullback.lift (j_CQ ≫ ι_affQ_R)
      (CategoryTheory.Limits.pullback.snd snd_CQR j_R)
      (by rw [Category.assoc, hι_affQR_snd]; exact CategoryTheory.Limits.pullback.condition)
  have hι_affQRΩ_fst : ι_affQ_R_Ω ≫ j_Q = j_CQ ≫ ι_affQ_R :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _

  let S_d := weilAffineSpaceOver k (2 * m + 1)
  let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
  let A_Ω := CategoryTheory.Limits.pullback j_R
    (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
  let j_A : A_Ω ⟶ A_R :=
    CategoryTheory.Limits.pullback.snd j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)

  have hSmoothOpenAt : ∀ (z : ↥Q_R) (W_sm : Q_fam.left.Opens),
      fst_QR.base z ∈ W_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_sm.ι ≫ g_Q.left) →
      ∃ (V : Q_R.Opens) (_ : z ∈ V)
        (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
        (V_U : AlgebraicGeometry.Scheme.{u})
        (ι_VU : V_U ⟶ Q_R_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
        CategoryTheory.IsPullback ι_VU j_V j_Q V.ι ∧
        CategoryTheory.IsPullback φ_U j_V j_A φ := by
    intro z W_sm hz_W hSm_W
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_sm.ι ≫ g_Q.left) := hSm_W
    let f_W := W_sm.ι ≫ g_Q.left
    let Q'_R := CategoryTheory.Limits.pullback f_W g_R
    let fst'_QR := CategoryTheory.Limits.pullback.fst f_W g_R
    let f'_QR := CategoryTheory.Limits.pullback.snd f_W g_R
    let Q'_R_Ω := CategoryTheory.Limits.pullback f'_QR j_R
    let j_Q' : Q'_R_Ω ⟶ Q'_R := CategoryTheory.Limits.pullback.fst f'_QR j_R
    let e_WQ : Q'_R ⟶ Q_R :=
      CategoryTheory.Limits.pullback.lift (fst'_QR ≫ W_sm.ι) f'_QR
        (by rw [Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    have he_WQ_fst : e_WQ ≫ fst_QR = fst'_QR ≫ W_sm.ι :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have he_WQ_snd : e_WQ ≫ f_QR = f'_QR :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_WQ_outer : CategoryTheory.IsPullback
        (e_WQ ≫ f_QR) fst'_QR g_R (W_sm.ι ≫ g_Q.left) := by
      rw [he_WQ_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback f_W g_R).flip
    have hpb_WQ : CategoryTheory.IsPullback e_WQ fst'_QR fst_QR W_sm.ι :=
      CategoryTheory.IsPullback.of_right hpb_WQ_outer he_WQ_fst
        (CategoryTheory.IsPullback.of_hasPullback g_Q.left g_R).flip
    have _ : AlgebraicGeometry.IsOpenImmersion e_WQ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_WQ.flip inferInstance
    let e_WQ_Ω : Q'_R_Ω ⟶ Q_R_Ω :=
      CategoryTheory.Limits.pullback.lift (j_Q' ≫ e_WQ)
        (CategoryTheory.Limits.pullback.snd f'_QR j_R)
        (by rw [Category.assoc, he_WQ_snd]; exact CategoryTheory.Limits.pullback.condition)
    have he_WQΩ_fst : e_WQ_Ω ≫ j_Q = j_Q' ≫ e_WQ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have he_WQΩ_snd : e_WQ_Ω ≫ f_QΩ = CategoryTheory.Limits.pullback.snd f'_QR j_R :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_WQΩ_outer :
        CategoryTheory.IsPullback (e_WQ_Ω ≫ f_QΩ) j_Q' j_R (e_WQ ≫ f_QR) := by
      rw [he_WQΩ_snd, he_WQ_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback f'_QR j_R).flip
    have hpb_jQ' : CategoryTheory.IsPullback e_WQ_Ω j_Q' j_Q e_WQ :=
      CategoryTheory.IsPullback.of_right hpb_WQΩ_outer he_WQΩ_fst
        (CategoryTheory.IsPullback.of_hasPullback f_QR j_R).flip
    obtain ⟨z', hz'_eWQ, -⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_WQ z ⟨fst_QR.base z, hz_W⟩ rfl
    obtain ⟨V', hz'_V', φ', hEt_φ', V'_U, ι_V'U, j_V', φ'_U, hSq1', hSq2'⟩ :=
      hAtlasGen (2 * m + 1) W_sm.toScheme U_line p_A1 f_W R_bar Ω g_k_R g_R hg_R_pA1 j_R z'
    have _ : AlgebraicGeometry.Etale φ' := hEt_φ'
    let ι_tot : V'.toScheme ⟶ Q_R := V'.ι ≫ e_WQ
    have _ : AlgebraicGeometry.IsOpenImmersion ι_tot := by
      dsimp [ι_tot]
      infer_instance
    let V : Q_R.Opens := ι_tot.opensRange
    have hz_V : z ∈ V := by
      refine ⟨⟨z', hz'_V'⟩, ?_⟩
      change e_WQ.base z' = z
      exact hz'_eWQ
    let φ : V.toScheme ⟶ A_R := ι_tot.isoOpensRange.inv ≫ φ'
    have hEt_φ : AlgebraicGeometry.Etale φ := by
      dsimp [φ]
      infer_instance
    let j_V : V'_U ⟶ V.toScheme := j_V' ≫ ι_tot.isoOpensRange.hom
    have hSq1_tot : CategoryTheory.IsPullback (ι_V'U ≫ e_WQ_Ω) j_V' j_Q ι_tot :=
      hSq1'.paste_horiz hpb_jQ'
    have hSq1 : CategoryTheory.IsPullback (ι_V'U ≫ e_WQ_Ω) j_V j_Q V.ι :=
      CategoryTheory.IsPullback.of_iso hSq1_tot (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) ι_tot.isoOpensRange (CategoryTheory.Iso.refl _)
        (by simp) (by simp [j_V]) (by simp)
        (by simp [V, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι])
    have hSq2 : CategoryTheory.IsPullback φ'_U j_V j_A φ :=
      CategoryTheory.IsPullback.of_iso hSq2' (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) ι_tot.isoOpensRange (CategoryTheory.Iso.refl _)
        (by simp) (by simp [j_V]) (by simp [j_A, S_d]) (by simp [φ])
    exact ⟨V, hz_V, φ, hEt_φ, V'_U, ι_V'U ≫ e_WQ_Ω, j_V, φ'_U, hSq1, hSq2⟩

  have hSmoothAtlas : ∀ z : ↥Q_R,
      z ∉ Set.range j_Q.base →
      z ∉ Set.range i_o₀.base →
      ∃ (V : Q_R.Opens) (_ : z ∈ V)
        (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
        (V_U : AlgebraicGeometry.Scheme.{u})
        (ι_VU : V_U ⟶ Q_R_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
        CategoryTheory.IsPullback ι_VU j_V j_Q V.ι ∧
        CategoryTheory.IsPullback φ_U j_V j_A φ := by
    intro z hz_not_jQ hz_not_io₀
    have hz_closed : f_QR.base z = IsLocalRing.closedPoint R_bar := by
      rcases hMax_R (f_QR.base z).asIdeal (f_QR.base z).isPrime with hbot | hmax
      · exfalso
        have hj_bot : j_R.base (⊥ : PrimeSpectrum Ω) = f_QR.base z := by
          apply PrimeSpectrum.ext
          rw [hbot]
          change Ideal.comap φ_R_Ω ⊥ = ⊥
          ext r
          rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
          exact ⟨fun hr0 => hφ_inj (hr0.trans (map_zero _).symm),
            fun hr => by rw [hr, map_zero]⟩
        obtain ⟨z_U, hz_U, -⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := f_QR) (g := j_R)
            z (⊥ : PrimeSpectrum Ω) hj_bot.symm
        exact hz_not_jQ ⟨z_U, hz_U⟩
      · exact PrimeSpectrum.ext hmax
    have hz_not_o₀ : fst_QR.base z ∉ Set.range (o₀ ≫ ι_affQ).base := by
      intro ⟨pt, hpt⟩
      have hpt' : ι_affQ.base (o₀.base pt) = fst_QR.base z := hpt
      obtain ⟨z_CQ, hz_CQ, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_affQR z (o₀.base pt) hpt'.symm
      have hz_CQ_fst : fst_CQR.base z_CQ ∈ Set.range o₀.base := by
        refine ⟨pt, ι_affQ.isOpenEmbedding.injective ?_⟩
        rw [hpt']
        change fst_QR.base z = (fst_CQR ≫ ι_affQ).base z_CQ
        rw [← hι_affQR_fst]
        change fst_QR.base z = fst_QR.base (ι_affQ_R.base z_CQ)
        rw [hz_CQ]
      have hz_CQ_snd : snd_CQR.base z_CQ = IsLocalRing.closedPoint R_bar := by
        rw [← hz_closed]
        change snd_CQR.base z_CQ = f_QR.base z
        rw [← hι_affQR_snd]
        change f_QR.base (ι_affQ_R.base z_CQ) = f_QR.base z
        rw [hz_CQ]
      let c_o₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ C_Q_R :=
        CategoryTheory.Limits.pullback.lift (u_k ≫ o₀) u_R
          (by rw [Category.assoc, hQ1.2.1, huR_eq_uk])
      have hc_o₀_eq : c_o₀ ≫ ι_affQ_R = i_o₀ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, hι_affQR_fst, ← Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, hi_o₀_fst, Category.assoc]
        · rw [Category.assoc, hι_affQR_snd,
            CategoryTheory.Limits.pullback.lift_snd, hi_o₀_snd]
      let z₀_CQ : ↥C_Q_R := c_o₀.base (⊥ : PrimeSpectrum k₁)
      have hz₀_CQ_fst : fst_CQR.base z₀_CQ ∈ Set.range o₀.base := by
        refine ⟨u_k.base (⊥ : PrimeSpectrum k₁), ?_⟩
        change (u_k ≫ o₀).base (⊥ : PrimeSpectrum k₁) = (c_o₀ ≫ fst_CQR).base (⊥ : PrimeSpectrum k₁)
        rw [CategoryTheory.Limits.pullback.lift_fst]
      have hz₀_CQ_snd : snd_CQR.base z₀_CQ = IsLocalRing.closedPoint R_bar := by
        change (c_o₀ ≫ snd_CQR).base (⊥ : PrimeSpectrum k₁) = IsLocalRing.closedPoint R_bar
        rw [CategoryTheory.Limits.pullback.lift_snd]
        exact hu_R_pt (⊥ : PrimeSpectrum k₁)
      have heq_CQ : z_CQ = z₀_CQ :=
        hOdpUnique k o₀ hQ1.2.2 z_CQ z₀_CQ hz_CQ_fst hz₀_CQ_fst hz_CQ_snd hz₀_CQ_snd
      apply hz_not_io₀
      refine ⟨(⊥ : PrimeSpectrum k₁), ?_⟩
      rw [← hc_o₀_eq]
      change ι_affQ_R.base z₀_CQ = z
      rw [← heq_CQ, hz_CQ]
    obtain ⟨W_sm, hz_W, hSm_W⟩ := hQ2 (fst_QR.base z) hz_not_o₀
    exact hSmoothOpenAt z W_sm hz_W hSm_W

  obtain ⟨hSkyscraperGen, hDegZeroInjGen⟩ :=
    weil_proj_quadric_val_ring_skyscraper_and_deg_zero_inj ℓ
  have hInj0_Q : ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ Q_R) [AlgebraicGeometry.Etale w]
      (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
        weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Q w) ℓ 0),
      WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Q w) ℓ 0 ψ₀ →
      Function.Injective ψ₀ := by
    apply hDegZeroInjGen j_Q
    intro x
    by_cases hx_aff : fst_QR.base x ∈ Set.range ι_affQ.base
    · rcases hx_aff with ⟨x_CQ0, hx_CQ0⟩
      obtain ⟨x_CQR, hx_CQR, -⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_affQR x x_CQ0 hx_CQ0.symm
      let O_aff : Q_R.Opens := ι_affQ_R.opensRange
      refine ⟨O_aff, ⟨x_CQR, hx_CQR⟩, Or.inl ?_⟩
      intro W _ w _ hNe_W
      let w' : W ⟶ C_Q_R := w ≫ ι_affQ_R.isoOpensRange.inv
      have _ : AlgebraicGeometry.Etale w' := by
        dsimp [w']
        infer_instance
      have hw'_eq : w' ≫ ι_affQ_R = w ≫ O_aff.ι := by
        have hinv : ι_affQ_R.isoOpensRange.inv ≫ ι_affQ_R = O_aff.ι := by
          rw [← Category.id_comp O_aff.ι, ← Iso.inv_hom_id ι_affQ_R.isoOpensRange, Category.assoc]
          exact congrArg (ι_affQ_R.isoOpensRange.inv ≫ ·)
            (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_affQ_R).symm
        exact (Category.assoc w _ _).trans (congrArg (w ≫ ·) hinv)
      have hNe_CQ := hOdpNonempty W w' hNe_W
      let Φ_W : CategoryTheory.Limits.pullback j_CQ w' ⟶
          CategoryTheory.Limits.pullback j_Q (w ≫ O_aff.ι) :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst j_CQ w' ≫ ι_affQ_R_Ω)
          (CategoryTheory.Limits.pullback.snd j_CQ w')
          (by
            rw [Category.assoc, hι_affQRΩ_fst, ← Category.assoc,
              CategoryTheory.Limits.pullback.condition, Category.assoc, hw'_eq])
      exact hNe_CQ.map Φ_W.base
    · have hx_not_o₀ : fst_QR.base x ∉ Set.range (o₀ ≫ ι_affQ).base := by
        intro ⟨pt, hpt⟩
        exact hx_aff ⟨o₀.base pt, hpt⟩
      obtain ⟨W_sm, hx_W, hSm_W⟩ := hQ2 (fst_QR.base x) hx_not_o₀
      obtain ⟨V, hx_V, φ, hEt_φ, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩ :=
        hSmoothOpenAt x W_sm hx_W hSm_W
      have _ : AlgebraicGeometry.Etale φ := hEt_φ
      refine ⟨V, hx_V, Or.inr ?_⟩
      intro W _ w _ ψ₀ hψ₀
      have hpb0 : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst j_V w)
          (CategoryTheory.Limits.pullback.snd j_V w) j_V w :=
        CategoryTheory.IsPullback.of_hasPullback j_V w
      have hpb1 : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst j_V w ≫ ι_VU)
          (CategoryTheory.Limits.pullback.snd j_V w) j_Q (w ≫ V.ι) :=
        hpb0.paste_horiz hSq1
      have hpb2 : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst j_V w ≫ φ_U)
          (CategoryTheory.Limits.pullback.snd j_V w) j_A (w ≫ φ) :=
        hpb0.paste_horiz hSq2
      let e_W : CategoryTheory.Limits.pullback j_Q (w ≫ V.ι) ≅
          CategoryTheory.Limits.pullback j_A (w ≫ φ) :=
        hpb1.isoPullback.symm ≪≫ hpb2.isoPullback
      have he_W_snd : e_W.hom ≫ CategoryTheory.Limits.pullback.snd j_A (w ≫ φ) =
          CategoryTheory.Limits.pullback.snd j_Q (w ≫ V.ι) := by
        simp [e_W, Iso.trans_hom, CategoryTheory.IsPullback.isoPullback_hom_snd,
          CategoryTheory.IsPullback.isoPullback_inv_snd]
      have hBij_A : HasBijPull (CategoryTheory.Limits.pullback.snd j_A (w ≫ φ)) 0 :=
        fun p hp => hBij0_A W (w ≫ φ) p hp
      have hBij_Q : HasBijPull (CategoryTheory.Limits.pullback.snd j_Q (w ≫ V.ι)) 0 := by
        rw [← he_W_snd]
        exact hBij_comp e_W.hom (CategoryTheory.Limits.pullback.snd j_A (w ≫ φ)) 0
          (hBij_iso e_W 0) hBij_A
      exact (hBij_Q ψ₀ hψ₀).1

  exact weil_proj_quadric_val_ring_trunc_acyclic_from_punctual_roof
    ℓ R_bar Ω k₁ f_QR f_QΩ j_Q j_A i_o₀ (2 * m)
    (hSkyscraperGen k₁ i_o₀) hInj0_Q hBij0_A (fun b hb _ => hZero_A b hb)
    hSmoothAtlas hGlobalBij

theorem weil_sing_origin_cosp_split_odp_linear_roof_to_quadric (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ)
    (X₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₀ : X₀ ⟶ CategoryTheory.Over.mk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))))
    (x₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X₀.left)
    (hx₀ : x₀ ≫ f₀.left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0)))
    (hOdp : IsEtaleSplitOdpPointOver m f₀ (x₀.base (⊥ : PrimeSpectrum k))
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))).base
        (⊥ : PrimeSpectrum k)))
    (R_bar : Type u) [CommRing R_bar] [HenselianLocalRing R_bar]
    [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    (p_R : Polynomial k →+* R_bar)
    (ht_max : p_R Polynomial.X ∈ IsLocalRing.maximalIdeal R_bar)
    (hRes : (IsLocalRing.residue R_bar).comp p_R =
      ((IsLocalRing.residue R_bar).comp (p_R.comp Polynomial.C)).comp
        (Polynomial.evalRingHom 0))
    (Ω : Type u) [CommRing Ω]
    (φ_R_Ω : R_bar →+* Ω) :
    let U_line := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let C_Q := AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) (Polynomial k) ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C (Polynomial.X : Polynomial k)}))
    let p_CQ : C_Q ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
    let g_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let X_R := CategoryTheory.Limits.pullback f₀.left g_R
    let X_R_Ω := CategoryTheory.Limits.pullback
      (CategoryTheory.Limits.pullback.snd f₀.left g_R) j_R
    let j_X : X_R_Ω ⟶ X_R :=
      CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd f₀.left g_R) j_R
    let C_Q_R := CategoryTheory.Limits.pullback p_CQ g_R
    let C_Q_R_Ω := CategoryTheory.Limits.pullback
      (CategoryTheory.Limits.pullback.snd p_CQ g_R) j_R
    let j_CQ : C_Q_R_Ω ⟶ C_Q_R :=
      CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd p_CQ g_R) j_R
    ∃ (V_R V_R_Ω : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsAffine V_R)
      (e_XR : V_R ⟶ X_R) (_ : AlgebraicGeometry.Etale e_XR)
      (e_CQR : V_R ⟶ C_Q_R) (_ : AlgebraicGeometry.Etale e_CQR)
      (e_XR_Ω : V_R_Ω ⟶ X_R_Ω) (j_VR : V_R_Ω ⟶ V_R) (e_CQR_Ω : V_R_Ω ⟶ C_Q_R_Ω),
      (∀ z : ↥X_R,
        (CategoryTheory.Limits.pullback.fst f₀.left g_R).base z ∈ Set.range x₀.base →
        (CategoryTheory.Limits.pullback.snd f₀.left g_R).base z =
          IsLocalRing.closedPoint R_bar →
        z ∈ Set.range e_XR.base) ∧
      CategoryTheory.IsPullback e_XR_Ω j_VR j_X e_XR ∧
      CategoryTheory.IsPullback e_CQR_Ω j_VR j_CQ e_CQR :=
by
  have hUnramUnit :
      ∀ (k₀ : Type u) [Field k₀]
        (R₁ : Type u) [CommRing R₁] (q₀ : Ideal R₁) [hq₀ : q₀.IsPrime]
        (φ₁ ψ₁ : Polynomial k₀ →+* R₁),
        φ₁.Etale → ψ₁.Etale →
        Ideal.comap φ₁ q₀ = Ideal.span {Polynomial.X} →
        Ideal.comap ψ₁ q₀ = Ideal.span {Polynomial.X} →
        ∃ (g₀ : R₁) (_ : g₀ ∉ q₀) (u : (Localization.Away g₀)ˣ),
          algebraMap R₁ (Localization.Away g₀) (ψ₁ Polynomial.X) =
            ↑u * algebraMap R₁ (Localization.Away g₀) (φ₁ Polynomial.X) := by
    clear * -
    intro k₀ _ R₁ _ q₀ hq₀ φ₁ ψ₁ hφ₁ hψ₁ hq_φ hq_ψ
    let P := Polynomial k₀
    let m₀ : Ideal P := Ideal.span {Polynomial.X}
    have hm₀_prime : m₀.IsPrime := by
      dsimp [m₀]
      rw [← hq_φ]
      exact Ideal.IsPrime.comap φ₁
    let _ : m₀.IsPrime := hm₀_prime
    let P₀ := Localization.AtPrime m₀
    let L := Localization.AtPrime q₀
    have hMax_P₀ : IsLocalRing.maximalIdeal P₀ = Ideal.span {algebraMap P P₀ Polynomial.X} := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal m₀ P₀]
      dsimp [m₀]
      rw [Ideal.map_span, Set.image_singleton]
    have hMax_L : ∀ (θ : P →+* R₁), θ.Etale → Ideal.comap θ q₀ = m₀ →
        IsLocalRing.maximalIdeal L = Ideal.span {algebraMap R₁ L (θ Polynomial.X)} := by
      intro θ hθ hq_θ
      let _ : Algebra P R₁ := θ.toAlgebra
      have hθ_alg : algebraMap P R₁ = θ := rfl
      have _ : Algebra.Etale P R₁ := RingHom.etale_algebraMap.mp (hθ_alg ▸ hθ)
      let loc_hom : P₀ →+* L := Localization.localRingHom m₀ q₀ θ hq_θ.symm
      let _ : Algebra P₀ L := loc_hom.toAlgebra
      have hloc_alg : algebraMap P₀ L = loc_hom := rfl
      have _ : IsLocalHom (algebraMap P₀ L) := by
        rw [hloc_alg]
        exact Localization.isLocalHom_localRingHom m₀ q₀ θ hq_θ.symm
      have _ : IsScalarTower P P₀ L :=
        IsScalarTower.of_algebraMap_eq fun x =>
          (Localization.localRingHom_to_map m₀ q₀ θ hq_θ.symm x).symm
      have _ : Algebra.FormallyUnramified R₁ L :=
        Algebra.FormallyUnramified.of_isLocalization q₀.primeCompl
      have _ : Algebra.FormallyUnramified P L :=
        Algebra.FormallyUnramified.comp P R₁ L
      have _ : Algebra.FormallyUnramified P₀ L :=
        Algebra.FormallyUnramified.localization_base m₀.primeCompl
      have _ : Algebra.EssFiniteType R₁ L :=
        Algebra.EssFiniteType.of_isLocalization L q₀.primeCompl
      have _ : Algebra.EssFiniteType P L :=
        Algebra.EssFiniteType.comp P R₁ L
      have _ : Algebra.EssFiniteType P₀ L :=
        Algebra.EssFiniteType.of_comp P P₀ L
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := P₀) (S := L), hMax_P₀,
        Ideal.map_span, Set.image_singleton, hloc_alg,
        Localization.localRingHom_to_map m₀ q₀ θ hq_θ.symm Polynomial.X]
    let a_L : L := algebraMap R₁ L (φ₁ Polynomial.X)
    let b_L : L := algebraMap R₁ L (ψ₁ Polynomial.X)
    have hSpan_eq : Ideal.span ({a_L} : Set L) = Ideal.span ({b_L} : Set L) := by
      rw [← hMax_L φ₁ hφ₁ hq_φ, ← hMax_L ψ₁ hψ₁ hq_ψ]
    have hb_mem : b_L ∈ Ideal.span ({a_L} : Set L) := by
      rw [hSpan_eq]
      exact Ideal.mem_span_singleton_self b_L
    have ha_mem : a_L ∈ Ideal.span ({b_L} : Set L) := by
      rw [← hSpan_eq]
      exact Ideal.mem_span_singleton_self a_L
    obtain ⟨x, hx⟩ := Ideal.mem_span_singleton.mp hb_mem
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp ha_mem
    have hUnit_L : ∃ u_L : Lˣ, b_L = ↑u_L * a_L := by
      by_cases hux : IsUnit x
      · exact ⟨hux.unit, by rw [hx, mul_comm, IsUnit.unit_spec hux]⟩
      · have hx_max : x ∈ IsLocalRing.maximalIdeal L :=
          not_imp_comm.mp (IsLocalRing.notMem_maximalIdeal (x := x)).mp hux
        have hxy_max : x * y ∈ IsLocalRing.maximalIdeal L :=
          (IsLocalRing.maximalIdeal L).mul_mem_right y hx_max
        have h1xy_not : 1 - x * y ∉ IsLocalRing.maximalIdeal L := by
          intro hmem
          have h1 : (1 : L) ∈ IsLocalRing.maximalIdeal L := by
            have heq : (1 : L) = (1 - x * y) + x * y := by ring
            rw [heq]
            exact (IsLocalRing.maximalIdeal L).add_mem hmem hxy_max
          exact Ideal.IsPrime.ne_top inferInstance
            ((Ideal.eq_top_iff_one _).mpr h1)
        have hu1 : IsUnit (1 - x * y) :=
          (IsLocalRing.notMem_maximalIdeal (x := 1 - x * y)).mp h1xy_not
        have hzero : (1 - x * y) * a_L = 0 := by
          calc
            (1 - x * y) * a_L = a_L - (a_L * x) * y := by ring
            _ = a_L - b_L * y := by rw [← hx]
            _ = a_L - a_L := by rw [← hy]
            _ = 0 := sub_self a_L
        have ha0 : a_L = 0 := hu1.mul_right_eq_zero.mp hzero
        exact ⟨1, by rw [hx, ha0, zero_mul, mul_zero]⟩
    obtain ⟨u_L, hu_L⟩ := hUnit_L
    obtain ⟨⟨a, s₁⟩, hs₁⟩ := IsLocalization.surj q₀.primeCompl (↑u_L : L)
    have hu_s₁ : IsUnit (algebraMap R₁ L s₁.1) := IsLocalization.map_units L s₁
    have hu_a : IsUnit (algebraMap R₁ L a) := by
      rw [← hs₁]
      exact u_L.isUnit.mul hu_s₁
    have ha_not : a ∉ q₀ := by
      intro ha_in
      have ha_max : algebraMap R₁ L a ∈ IsLocalRing.maximalIdeal L :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff L q₀ a).mpr ha_in
      exact (IsLocalRing.notMem_maximalIdeal.mpr hu_a) ha_max
    have hEq_L : algebraMap R₁ L (s₁.1 * ψ₁ Polynomial.X) =
        algebraMap R₁ L (a * φ₁ Polynomial.X) := by
      rw [map_mul, map_mul]
      change algebraMap R₁ L s₁.1 * b_L = algebraMap R₁ L a * a_L
      rw [hu_L, ← hs₁]
      ring
    obtain ⟨t, ht_eq⟩ := IsLocalization.exists_of_eq (M := q₀.primeCompl) hEq_L
    let g₀ : R₁ := a * s₁.1 * t.1
    have hg₀ : g₀ ∉ q₀ :=
      hq₀.mul_notMem (hq₀.mul_notMem ha_not s₁.2) t.2
    let S := Localization.Away g₀
    let ρ : R₁ →+* S := algebraMap R₁ S
    have hug₀ : IsUnit (ρ g₀) := IsLocalization.Away.algebraMap_isUnit g₀
    have hua : IsUnit (ρ a) := by
      refine isUnit_of_mul_isUnit_left (y := ρ s₁.1 * ρ t.1) ?_
      have heq : ρ a * (ρ s₁.1 * ρ t.1) = ρ g₀ := by
        dsimp [g₀]; simp only [map_mul, mul_assoc]
      rwa [heq]
    have hus : IsUnit (ρ s₁.1) := by
      refine isUnit_of_mul_isUnit_left (y := ρ a * ρ t.1) ?_
      have heq : ρ s₁.1 * (ρ a * ρ t.1) = ρ g₀ := by
        dsimp [g₀]; simp only [map_mul]; ring
      rwa [heq]
    have hut : IsUnit (ρ t.1) := by
      refine isUnit_of_mul_isUnit_left (y := ρ a * ρ s₁.1) ?_
      have heq : ρ t.1 * (ρ a * ρ s₁.1) = ρ g₀ := by
        dsimp [g₀]; simp only [map_mul]; ring
      rwa [heq]
    let u : Sˣ := hua.unit * hus.unit⁻¹
    refine ⟨g₀, hg₀, u, ?_⟩
    have hρ_eq := congrArg ρ ht_eq
    simp only [map_mul] at hρ_eq
    have hs_eq : ρ s₁.1 * ρ (ψ₁ Polynomial.X) = ρ a * ρ (φ₁ Polynomial.X) :=
      hut.mul_left_cancel hρ_eq
    calc
      ρ (ψ₁ Polynomial.X) = ↑(hus.unit⁻¹) * (↑hus.unit * ρ (ψ₁ Polynomial.X)) := by
        rw [Units.inv_mul_cancel_left]
      _ = ↑(hus.unit⁻¹) * (ρ a * ρ (φ₁ Polynomial.X)) := by
        rw [IsUnit.unit_spec hus, hs_eq]
      _ = ↑u * ρ (φ₁ Polynomial.X) := by
        dsimp [u]
        ring

  have hQuadPushout :
      ∀ (m₀ : ℕ) (A₁ A₂ : Type u) [CommRing A₁] [CommRing A₂]
        (α : A₁ →+* A₂) (c₁ : A₁) (c₂ : A₂) (u : A₂ˣ),
        c₂ = ↑u * α c₁ →
        let Q₁ := MvPolynomial (Fin (m₀ + 1) × Fin 2) A₁ ⧸ Ideal.span
          {(∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C c₁}
        let Q₂ := MvPolynomial (Fin (m₀ + 1) × Fin 2) A₂ ⧸ Ideal.span
          {(∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C c₂}
        ∃ (β : Q₁ →+* Q₂),
          CategoryTheory.IsPushout
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : A₁ →+* MvPolynomial (Fin (m₀ + 1) × Fin 2) A₁)))
            (CommRingCat.ofHom α)
            (CommRingCat.ofHom β)
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : A₂ →+* MvPolynomial (Fin (m₀ + 1) × Fin 2) A₂))) := by
    clear * -
    intro m₀ A₁ A₂ _ _ α c₁ c₂ u hc Q₁ Q₂
    let σ := Fin (m₀ + 1) × Fin 2
    let F₁ : MvPolynomial σ A₁ :=
      (∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C c₁
    let F₂ : MvPolynomial σ A₂ :=
      (∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C c₂
    let I₁ : Ideal (MvPolynomial σ A₁) := Ideal.span {F₁}
    let I₂ : Ideal (MvPolynomial σ A₂) := Ideal.span {F₂}
    let mk₁ : MvPolynomial σ A₁ →+* Q₁ := Ideal.Quotient.mk I₁
    let mk₂ : MvPolynomial σ A₂ →+* Q₂ := Ideal.Quotient.mk I₂
    let ι₁ : A₁ →+* Q₁ := mk₁.comp MvPolynomial.C
    let ι₂ : A₂ →+* Q₂ := mk₂.comp MvPolynomial.C
    let β_var : σ → Q₂ := fun idx =>
      if idx.2 = 0 then mk₂ (MvPolynomial.C (↑(u⁻¹) : A₂) * MvPolynomial.X idx)
      else mk₂ (MvPolynomial.X idx)
    let β_raw : MvPolynomial σ A₁ →+* Q₂ := MvPolynomial.eval₂Hom (ι₂.comp α) β_var
    have hβ_F₁ : β_raw F₁ = 0 := by
      change MvPolynomial.eval₂Hom (ι₂.comp α) β_var
        ((∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C c₁) = 0
      rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C]
      have hterm : ∀ j : Fin (m₀ + 1),
          MvPolynomial.eval₂Hom (ι₂.comp α) β_var
              (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) =
            mk₂ (MvPolynomial.C (↑(u⁻¹) : A₂)) *
              mk₂ (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) := by
        intro j
        rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
        dsimp [β_var]
        rw [← map_mul, ← map_mul, mul_assoc]
      simp_rw [hterm, ← Finset.mul_sum, ← map_sum]
      have hc₁_eq : α c₁ = (↑(u⁻¹) : A₂) * c₂ := by
        rw [hc, Units.inv_mul_cancel_left]
      change mk₂ (MvPolynomial.C (↑(u⁻¹) : A₂)) *
          mk₂ (∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          mk₂ (MvPolynomial.C (α c₁)) = 0
      rw [hc₁_eq, map_mul MvPolynomial.C, map_mul mk₂, ← mul_sub, ← map_sub]
      have hF₂_zero : mk₂ F₂ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      change mk₂ (MvPolynomial.C (↑(u⁻¹) : A₂)) * mk₂ F₂ = 0
      rw [hF₂_zero, mul_zero]
    have hβ_ker : ∀ p ∈ I₁, β_raw p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      rw [map_mul, hβ_F₁, zero_mul]
    let β : Q₁ →+* Q₂ := Ideal.Quotient.lift I₁ β_raw hβ_ker
    refine ⟨β, ?_⟩
    have hcomm : CommRingCat.ofHom ι₁ ≫ CommRingCat.ofHom β =
        CommRingCat.ofHom α ≫ CommRingCat.ofHom ι₂ := by
      apply CommRingCat.hom_ext
      ext a
      exact MvPolynomial.eval₂Hom_C (ι₂.comp α) β_var a
    let ψ_var_of : ∀ sc : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom ι₁) (CommRingCat.ofHom α), σ → ↑sc.pt :=
      fun sc idx =>
        if idx.2 = 0 then sc.inr.hom ↑u * sc.inl.hom (mk₁ (MvPolynomial.X idx))
        else sc.inl.hom (mk₁ (MvPolynomial.X idx))
    let Ψ_raw_of : ∀ sc : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom ι₁) (CommRingCat.ofHom α), MvPolynomial σ A₂ →+* ↑sc.pt :=
      fun sc => MvPolynomial.eval₂Hom sc.inr.hom (ψ_var_of sc)
    have hΨ_ker_of : ∀ (sc : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom ι₁) (CommRingCat.ofHom α)) (p : MvPolynomial σ A₂),
        p ∈ I₂ → Ψ_raw_of sc p = 0 := by
      intro sc p hp
      let f₁ : Q₁ →+* ↑sc.pt := sc.inl.hom
      let f₂ : A₂ →+* ↑sc.pt := sc.inr.hom
      have hsc : ∀ a : A₁, f₁ (ι₁ a) = f₂ (α a) :=
        fun a => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom sc.condition) a
      have hΨ_F₂ : Ψ_raw_of sc F₂ = 0 := by
        change MvPolynomial.eval₂Hom f₂ (ψ_var_of sc)
          ((∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C c₂) = 0
        rw [map_sub, map_sum, MvPolynomial.eval₂Hom_C]
        have hterm : ∀ j : Fin (m₀ + 1),
            MvPolynomial.eval₂Hom f₂ (ψ_var_of sc)
                (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) =
              f₂ ↑u * f₁ (mk₁ (MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) := by
          intro j
          rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          dsimp [ψ_var_of]
          rw [mul_assoc, ← map_mul f₁, ← map_mul mk₁]
        simp_rw [hterm, ← Finset.mul_sum, ← map_sum f₁, ← map_sum mk₁]
        rw [hc, map_mul, ← hsc c₁]
        change f₂ ↑u *
            f₁ (mk₁ (∑ j : Fin (m₀ + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) -
          f₂ ↑u * f₁ (mk₁ (MvPolynomial.C c₁)) = 0
        rw [← mul_sub, ← map_sub f₁, ← map_sub mk₁]
        have hF₁_zero : mk₁ F₁ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        change f₂ ↑u * f₁ (mk₁ F₁) = 0
        rw [hF₁_zero, map_zero, mul_zero]
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      rw [map_mul, hΨ_F₂, zero_mul]
    let desc_fn : ∀ sc : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom ι₁) (CommRingCat.ofHom α), Q₂ →+* ↑sc.pt :=
      fun sc => Ideal.Quotient.lift I₂ (Ψ_raw_of sc) (hΨ_ker_of sc)
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun sc => CommRingCat.ofHom (desc_fn sc))
        (fun sc => ?_) (fun sc => ?_) (fun sc m_hom hm_l hm_r => ?_))
    · apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        change desc_fn sc (β (mk₁ (MvPolynomial.C a))) =
          sc.inl.hom (mk₁ (MvPolynomial.C a))
        have h1 : β (mk₁ (MvPolynomial.C a)) = ι₂ (α a) :=
          MvPolynomial.eval₂Hom_C (ι₂.comp α) β_var a
        rw [h1]
        change MvPolynomial.eval₂Hom sc.inr.hom (ψ_var_of sc) (MvPolynomial.C (α a)) =
          sc.inl.hom (ι₁ a)
        rw [MvPolynomial.eval₂Hom_C]
        exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom sc.condition) a).symm
      · intro idx
        change desc_fn sc (β (mk₁ (MvPolynomial.X idx))) =
          sc.inl.hom (mk₁ (MvPolynomial.X idx))
        have h1 : β (mk₁ (MvPolynomial.X idx)) = β_var idx :=
          MvPolynomial.eval₂Hom_X' (ι₂.comp α) β_var idx
        rw [h1]
        dsimp [β_var]
        split_ifs with h0
        · change MvPolynomial.eval₂Hom sc.inr.hom (ψ_var_of sc)
              (MvPolynomial.C (↑(u⁻¹) : A₂) * MvPolynomial.X idx) =
            sc.inl.hom (mk₁ (MvPolynomial.X idx))
          rw [map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
          dsimp [ψ_var_of]
          simp only [h0, ↓reduceIte, ← mul_assoc, ← map_mul sc.inr.hom,
            Units.inv_mul, map_one, one_mul]
        · change MvPolynomial.eval₂Hom sc.inr.hom (ψ_var_of sc) (MvPolynomial.X idx) =
            sc.inl.hom (mk₁ (MvPolynomial.X idx))
          rw [MvPolynomial.eval₂Hom_X']
          dsimp [ψ_var_of]
          simp only [h0, ↓reduceIte]
    · apply CommRingCat.hom_ext
      ext b
      exact MvPolynomial.eval₂Hom_C sc.inr.hom (ψ_var_of sc) b
    · apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro b
        change m_hom.hom (ι₂ b) = MvPolynomial.eval₂Hom sc.inr.hom (ψ_var_of sc) (MvPolynomial.C b)
        rw [MvPolynomial.eval₂Hom_C]
        exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) b
      · intro idx
        change m_hom.hom (mk₂ (MvPolynomial.X idx)) =
          MvPolynomial.eval₂Hom sc.inr.hom (ψ_var_of sc) (MvPolynomial.X idx)
        rw [MvPolynomial.eval₂Hom_X']
        dsimp [ψ_var_of]
        have hl_idx : m_hom.hom (β (mk₁ (MvPolynomial.X idx))) =
            sc.inl.hom (mk₁ (MvPolynomial.X idx)) :=
          DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l) (mk₁ (MvPolynomial.X idx))
        have hβ_X : β (mk₁ (MvPolynomial.X idx)) = β_var idx :=
          MvPolynomial.eval₂Hom_X' (ι₂.comp α) β_var idx
        split_ifs with h0
        · have hdecomp : mk₂ (MvPolynomial.X idx) =
              ι₂ ↑u * β (mk₁ (MvPolynomial.X idx)) := by
            rw [hβ_X]
            dsimp [β_var, ι₂]
            simp only [h0, ↓reduceIte, ← map_mul mk₂, ← mul_assoc, ← map_mul MvPolynomial.C,
              Units.mul_inv, map_one, one_mul]
          have hr_u : m_hom.hom (ι₂ ↑u) = sc.inr.hom ↑u :=
            DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) ↑u
          rw [hdecomp, map_mul, hr_u, hl_idx]
        · have hdecomp : mk₂ (MvPolynomial.X idx) = β (mk₁ (MvPolynomial.X idx)) := by
            rw [hβ_X]
            dsimp [β_var]
            simp only [h0, ↓reduceIte]
          rw [hdecomp, hl_idx]

  have hEtaleHensel :
      (∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀] {V Z : AlgebraicGeometry.Scheme.{u}}
          (e : V ⟶ Z) [AlgebraicGeometry.Etale e]
          (x_pt : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z) (v_pt : ↥V),
        e.base v_pt = x_pt.base (⊥ : PrimeSpectrum k₀) →
        ∃ (v_k : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ V),
          v_k.base (⊥ : PrimeSpectrum k₀) = v_pt ∧ v_k ≫ e = x_pt) ∧
      (∀ (P_base S A_bar : Type u) [CommRing P_base] [CommRing S] [CommRing A_bar]
          [HenselianLocalRing A_bar] (φ_S : P_base →+* S),
        φ_S.Etale →
        ∀ (p_A : P_base →+* A_bar) (Q : Ideal S) [Q.IsPrime]
          (σ_bar : S →+* IsLocalRing.ResidueField A_bar),
          RingHom.ker σ_bar = Q →
          σ_bar.comp φ_S = (IsLocalRing.residue A_bar).comp p_A →
          ∃ (f_et : S) (_ : f_et ∉ Q) (σ_tilde : Localization.Away f_et →+* A_bar),
            σ_tilde.comp ((algebraMap S (Localization.Away f_et)).comp φ_S) = p_A ∧
            ((IsLocalRing.residue A_bar).comp σ_tilde).comp
              (algebraMap S (Localization.Away f_et)) = σ_bar) := by
    clear * -
    classical
    refine ⟨?_, ?_⟩
    · intro k₀ _ _ V Z e _ x_pt v_pt hv₀
      obtain ⟨p₀, hp₀_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := e) (g := x_pt) v_pt (⊥ : PrimeSpectrum k₀) hv₀
      obtain ⟨W₀, hAff_W₀, hp₀_W₀, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := p₀) (U := (⊤ : (CategoryTheory.Limits.pullback e x_pt).Opens)) trivial
      let R_W₀ : CommRingCat.{u} :=
        (CategoryTheory.Limits.pullback e x_pt).presheaf.obj (Opposite.op W₀)
      let A₀ : Type u := ↑R_W₀
      let j_W₀ : AlgebraicGeometry.Spec R_W₀ ⟶ CategoryTheory.Limits.pullback e x_pt :=
        hAff_W₀.fromSpec
      have _ : AlgebraicGeometry.IsOpenImmersion j_W₀ := hAff_W₀.isOpenImmersion_fromSpec
      have _ : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.snd e x_pt) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback e x_pt) inferInstance
      let π₀ : AlgebraicGeometry.Spec R_W₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
        j_W₀ ≫ CategoryTheory.Limits.pullback.snd e x_pt
      have hEt_π₀ : AlgebraicGeometry.Etale π₀ := by dsimp [π₀]; infer_instance
      let α₀_hom : CommRingCat.of k₀ ⟶ R_W₀ := AlgebraicGeometry.Spec.preimage π₀
      have hα₀_map : AlgebraicGeometry.Spec.map α₀_hom = π₀ :=
        AlgebraicGeometry.Spec.map_preimage π₀
      have hα₀_et : α₀_hom.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hα₀_map.symm ▸ hEt_π₀)
      let q₀ : PrimeSpectrum A₀ := hAff_W₀.primeIdealOf ⟨p₀, hp₀_W₀⟩
      have hq₀_pt : j_W₀.base q₀ = p₀ := hAff_W₀.fromSpec_primeIdealOf ⟨p₀, hp₀_W₀⟩
      let _ : Algebra k₀ A₀ := α₀_hom.hom.toAlgebra
      have hα₀_alg : algebraMap k₀ A₀ = α₀_hom.hom := rfl
      have _ : Algebra.Etale k₀ A₀ := RingHom.etale_algebraMap.mp (hα₀_alg ▸ hα₀_et)
      obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hModFin⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k₀ A₀).mp inferInstance
      let _ : Fintype I := Fintype.ofFinite I
      let _ : ∀ i, Field (Ai i) := hFieldAi
      let _ : ∀ i, Algebra k₀ (Ai i) := hAlgAi
      have inv_i : ∀ i : I, Ai i ≃ₐ[k₀] k₀ := fun i => by
        have _ : Module.Finite k₀ (Ai i) := (hModFin i).1
        have hbij : Function.Bijective (Algebra.ofId k₀ (Ai i)) :=
          IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k₀) (K := Ai i)
        exact (AlgEquiv.ofBijective (Algebra.ofId k₀ (Ai i)) hbij).symm
      let e_k : A₀ ≃ₐ[k₀] (I → k₀) := e_prod.trans (AlgEquiv.piCongrRight inv_i)
      let P_I : Ideal (I → k₀) := Ideal.comap e_k.symm.toRingHom q₀.asIdeal
      have hPI_prime : P_I.IsPrime := q₀.isPrime.comap e_k.symm.toRingHom
      let δ : I → (I → k₀) := fun i j => if j = i then 1 else 0
      have hsum_δ : (∑ i : I, δ i) = 1 := by
        ext j
        simp [δ]
      have hex_i₀ : ∃ i₀ : I, δ i₀ ∉ P_I := by
        by_contra hall
        simp only [not_exists, not_not] at hall
        have h1_mem : (1 : I → k₀) ∈ P_I := by
          rw [← hsum_δ]
          exact P_I.sum_mem fun i _ => hall i
        exact hPI_prime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
      obtain ⟨i₀, hi₀⟩ := hex_i₀
      let χ_alg : A₀ →ₐ[k₀] k₀ := (Pi.evalAlgHom k₀ (fun _ : I => k₀) i₀).comp e_k.toAlgHom
      have hker_χ : ∀ a : A₀, χ_alg a = 0 ↔ a ∈ q₀.asIdeal := by
        intro a
        let f : I → k₀ := e_k a
        have hf_i₀ : f i₀ = χ_alg a := rfl
        have hmul_zero : δ i₀ * (f - algebraMap k₀ (I → k₀) (f i₀)) = 0 := by
          ext j
          change δ i₀ j * (f j - f i₀) = 0
          dsimp [δ]
          split_ifs with hj
          · rw [hj, sub_self, mul_zero]
          · rw [zero_mul]
        have hdiff_mem : f - algebraMap k₀ (I → k₀) (f i₀) ∈ P_I := by
          have h0 : δ i₀ * (f - algebraMap k₀ (I → k₀) (f i₀)) ∈ P_I := by
            rw [hmul_zero]; exact P_I.zero_mem
          exact (hPI_prime.mem_or_mem h0).resolve_left hi₀
        have hf_iff : f ∈ P_I ↔ a ∈ q₀.asIdeal := by
          change e_k.symm (e_k a) ∈ q₀.asIdeal ↔ a ∈ q₀.asIdeal
          rw [e_k.symm_apply_apply]
        have hc_iff : algebraMap k₀ (I → k₀) (f i₀) ∈ P_I ↔ f ∈ P_I :=
          ⟨fun h => sub_add_cancel f (algebraMap k₀ (I → k₀) (f i₀)) ▸ P_I.add_mem hdiff_mem h,
           fun h => sub_sub_cancel f (algebraMap k₀ (I → k₀) (f i₀)) ▸ P_I.sub_mem h hdiff_mem⟩
        rw [← hf_iff, ← hf_i₀, ← hc_iff]
        constructor
        · intro hc0
          rw [hc0, map_zero]
          exact P_I.zero_mem
        · intro hc_mem
          by_contra hc_ne
          have hu_c : IsUnit (algebraMap k₀ (I → k₀) (f i₀)) :=
            (Ne.isUnit hc_ne).map (algebraMap k₀ (I → k₀))
          exact hPI_prime.ne_top (Ideal.eq_top_of_isUnit_mem P_I hc_mem hu_c)
      let χ_hom : R_W₀ ⟶ CommRingCat.of k₀ := CommRingCat.ofHom χ_alg.toRingHom
      let s₀_W : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ AlgebraicGeometry.Spec R_W₀ :=
        AlgebraicGeometry.Spec.map χ_hom
      have hs₀_pt : s₀_W.base (⊥ : PrimeSpectrum k₀) = q₀ := by
        apply PrimeSpectrum.ext
        ext a
        change χ_alg a = 0 ↔ a ∈ q₀.asIdeal
        exact hker_χ a
      have hs₀_π₀ : s₀_W ≫ π₀ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) := by
        rw [← hα₀_map, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp_id : α₀_hom ≫ χ_hom = 𝟙 (CommRingCat.of k₀) := by
          apply CommRingCat.hom_ext
          ext c
          exact χ_alg.commutes c
        rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
      let v_k : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ V :=
        s₀_W ≫ j_W₀ ≫ CategoryTheory.Limits.pullback.fst e x_pt
      refine ⟨v_k, ?_, ?_⟩
      · change (CategoryTheory.Limits.pullback.fst e x_pt).base
          (j_W₀.base (s₀_W.base (⊥ : PrimeSpectrum k₀))) = v_pt
        rw [hs₀_pt, hq₀_pt, hp₀_fst]
      · dsimp [v_k]
        rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← Category.assoc j_W₀, ← Category.assoc s₀_W]
        change (s₀_W ≫ π₀) ≫ x_pt = x_pt
        rw [hs₀_π₀, Category.id_comp]
    · intro P_base S A_bar _ _ _ _ φ_S hφ_S p_A Q _ σ_bar hQ_ker hcomm_bar
      let k₁ := IsLocalRing.ResidueField A_bar
      let res : A_bar →+* k₁ := IsLocalRing.residue A_bar
      let _ : Algebra P_base S := φ_S.toAlgebra
      have hφ_alg : algebraMap P_base S = φ_S := rfl
      have _ : Algebra.Etale P_base S := RingHom.etale_algebraMap.mp (hφ_alg ▸ hφ_S)
      let _ : Algebra P_base A_bar := p_A.toAlgebra
      let _ : Algebra P_base k₁ := (res.comp p_A).toAlgebra
      have _ : IsScalarTower P_base A_bar k₁ := IsScalarTower.of_algebraMap_eq' rfl
      obtain ⟨f_et, hf_et, hStd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := P_base) Q
      let S_loc := Localization.Away f_et
      have _ : Algebra.IsStandardEtale P_base S_loc := hStd
      have hσ_ne : σ_bar f_et ≠ 0 := by
        intro h0
        apply hf_et
        rw [← hQ_ker]
        exact h0
      have hu_fet : IsUnit (σ_bar f_et) := Ne.isUnit hσ_ne
      let σ'_ring : S_loc →+* k₁ := IsLocalization.Away.lift (S := S_loc) f_et hu_fet
      have hσ'_comp : σ'_ring.comp (algebraMap S S_loc) = σ_bar := by
        ext s
        exact IsLocalization.Away.lift_eq (S := S_loc) f_et hu_fet s
      let σ'_alg : S_loc →ₐ[P_base] k₁ :=
        { σ'_ring with
          commutes' := fun p => by
            change σ'_ring (algebraMap S S_loc (φ_S p)) = res (p_A p)
            rw [IsLocalization.Away.lift_eq (S := S_loc) f_et hu_fet (φ_S p)]
            exact DFunLike.congr_fun hcomm_bar p }
      obtain ⟨pres⟩ :=
        Algebra.IsStandardEtale.nonempty_standardEtalePresentation (R := P_base) (S := S_loc)
      let e_pres : pres.P.Ring ≃ₐ[P_base] S_loc :=
        AlgEquiv.ofBijective (pres.P.lift pres.x pres.hasMap) pres.lift_bijective
      let a_bar : k₁ := σ'_alg pres.x
      have ha_bar : pres.P.HasMap a_bar := pres.hasMap.map σ'_alg
      let F_R : Polynomial A_bar := pres.P.f.map p_A
      have hMonF : F_R.Monic := pres.P.monic_f.map p_A
      obtain ⟨a₀, ha₀_res⟩ := IsLocalRing.residue_surjective a_bar
      have hres_eval : ∀ (r : A_bar) (q : Polynomial P_base),
          res (Polynomial.eval r (q.map p_A)) = Polynomial.aeval (res r) q := by
        intro r q
        rw [Polynomial.eval_map, Polynomial.hom_eval₂]
        rfl
      have ha₀_eval : Polynomial.eval a₀ F_R ∈ IsLocalRing.maximalIdeal A_bar := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        change res (Polynomial.eval a₀ F_R) = 0
        dsimp [F_R]
        rw [hres_eval, ha₀_res]
        exact ha_bar.1
      have ha₀_deriv : IsUnit (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A_bar)
          (Polynomial.eval a₀ (Polynomial.derivative F_R))) := by
        change IsUnit (res (Polynomial.eval a₀ (Polynomial.derivative F_R)))
        dsimp [F_R]
        rw [Polynomial.derivative_map, hres_eval, ha₀_res]
        exact ha_bar.isUnit_derivative_f
      obtain ⟨a, ha_root, ha_diff⟩ :=
        HenselianRing.is_henselian F_R hMonF a₀ ha₀_eval ha₀_deriv
      have ha_res : res a = a_bar := by
        rw [← ha₀_res]
        apply sub_eq_zero.mp
        rw [← map_sub]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr ha_diff
      have ha_f : Polynomial.aeval a pres.P.f = 0 := by
        rw [Polynomial.aeval_def, ← Polynomial.eval_map]
        exact ha_root
      have hres_aeval : ∀ q : Polynomial P_base,
          res (Polynomial.aeval a q) = Polynomial.aeval a_bar q := by
        intro q
        have h1 : Polynomial.aeval a q = Polynomial.eval a (q.map p_A) := by
          rw [Polynomial.eval_map, Polynomial.aeval_def]
          rfl
        rw [h1, hres_eval, ha_res]
      have ha_g : IsUnit (Polynomial.aeval a pres.P.g) := by
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hmem
        have h0 : res (Polynomial.aeval a pres.P.g) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hmem
        rw [hres_aeval] at h0
        exact ha_bar.2.ne_zero h0
      have ha : pres.P.HasMap a := ⟨ha_f, ha_g⟩
      let σ_tilde_alg : S_loc →ₐ[P_base] A_bar :=
        (pres.P.lift a ha).comp e_pres.symm.toAlgHom
      let σ_tilde : S_loc →+* A_bar := σ_tilde_alg.toRingHom
      refine ⟨f_et, hf_et, σ_tilde, ?_, ?_⟩
      · ext p
        exact σ_tilde_alg.commutes p
      · have hlhs_eq : (IsScalarTower.toAlgHom P_base A_bar k₁).comp (pres.P.lift a ha) =
            σ'_alg.comp e_pres.toAlgHom := by
          apply pres.P.homEquiv.injective
          apply Subtype.ext
          rw [pres.P.homEquiv_apply_coe, pres.P.homEquiv_apply_coe]
          change res ((pres.P.lift a ha) pres.P.X) =
            σ'_alg ((pres.P.lift pres.x pres.hasMap) pres.P.X)
          rw [pres.P.lift_X, pres.P.lift_X, ha_res]
        have hres_σ : res.comp σ_tilde = σ'_ring := by
          ext z
          have h1 := DFunLike.congr_fun hlhs_eq (e_pres.symm z)
          change res (σ_tilde z) = σ'_alg (e_pres (e_pres.symm z)) at h1
          rwa [e_pres.apply_symm_apply] at h1
        rw [hres_σ, hσ'_comp]

  have hRelRoof :
      ∀ (k₀ : Type u) [Field k₀] (R_U : Type u) [CommRing R_U] (c_U : k₀ →+* R_U)
        (X C : AlgebraicGeometry.Scheme.{u})
        (f_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_U))
        (f_C : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_U))
        (hX_k : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀)),
        f_X ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_U) = hX_k →
        ∀ (s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of R_U))
          (x_pt : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ X),
          x_pt ≫ f_X = s₀ →
          x_pt ≫ hX_k = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) →
          ∀ (B : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine B]
            (e_B : B ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_U)) [AlgebraicGeometry.Etale e_B]
            (s_B : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ B),
            s_B ≫ e_B = s₀ →
            ∀ (W : AlgebraicGeometry.Scheme.{u}) (q_B : W ⟶ B)
              (e_X : W ⟶ X) [AlgebraicGeometry.Etale e_X]
              (e_C : W ⟶ C) [AlgebraicGeometry.Etale e_C]
              (w_k : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ W),
              e_X ≫ f_X = q_B ≫ e_B →
              e_C ≫ f_C = q_B ≫ e_B →
              w_k ≫ q_B = s_B →
              w_k ≫ e_X = x_pt →
              ∀ (A_bar : Type u) [CommRing A_bar] [IsLocalRing A_bar]
                (p_A : R_U →+* A_bar)
                (Ω₀ : Type u) [CommRing Ω₀] (φ_A_Ω : A_bar →+* Ω₀)
                (g_tilde_R : AlgebraicGeometry.Spec (CommRingCat.of A_bar) ⟶ B),
                g_tilde_R ≫ e_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_A) →
                ∀ (u_k : AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.ResidueField A_bar)) ⟶
                    AlgebraicGeometry.Spec (CommRingCat.of k₀)),
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue A_bar)) ≫
                    g_tilde_R = u_k ≫ s_B →
                  let g_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_A)
                  let j_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A_Ω)
                  let X_A := CategoryTheory.Limits.pullback f_X g_A
                  let X_A_Ω := CategoryTheory.Limits.pullback
                    (CategoryTheory.Limits.pullback.snd f_X g_A) j_A
                  let j_XA : X_A_Ω ⟶ X_A :=
                    CategoryTheory.Limits.pullback.fst
                      (CategoryTheory.Limits.pullback.snd f_X g_A) j_A
                  let C_A := CategoryTheory.Limits.pullback f_C g_A
                  let C_A_Ω := CategoryTheory.Limits.pullback
                    (CategoryTheory.Limits.pullback.snd f_C g_A) j_A
                  let j_CA : C_A_Ω ⟶ C_A :=
                    CategoryTheory.Limits.pullback.fst
                      (CategoryTheory.Limits.pullback.snd f_C g_A) j_A
                  ∃ (V_R V_R_Ω : AlgebraicGeometry.Scheme.{u})
                    (_ : AlgebraicGeometry.IsAffine V_R)
                    (e_XR : V_R ⟶ X_A) (_ : AlgebraicGeometry.Etale e_XR)
                    (e_CR : V_R ⟶ C_A) (_ : AlgebraicGeometry.Etale e_CR)
                    (e_XR_Ω : V_R_Ω ⟶ X_A_Ω) (j_VR : V_R_Ω ⟶ V_R) (e_CR_Ω : V_R_Ω ⟶ C_A_Ω),
                    (∀ z : ↥X_A,
                      (CategoryTheory.Limits.pullback.fst f_X g_A).base z ∈ Set.range x_pt.base →
                      (CategoryTheory.Limits.pullback.snd f_X g_A).base z =
                        IsLocalRing.closedPoint A_bar →
                      z ∈ Set.range e_XR.base) ∧
                    CategoryTheory.IsPullback e_XR_Ω j_VR j_XA e_XR ∧
                    CategoryTheory.IsPullback e_CR_Ω j_VR j_CA e_CR := by
    clear * -
    intro k₀ _ R_U _ c_U X C f_X f_C hX_k hf_X s₀ x_pt _hx₀ hx₀_k
      B _ e_B _ s_B _hs_B W q_B e_X _ e_C _ w_k he_X he_C hw_B hw_X
      A_bar _ _ p_A Ω₀ _ φ_A_Ω g_tilde_R hg_tilde_R u_k hu_gtilde
      g_A j_A X_A X_A_Ω j_XA C_A C_A_Ω j_CA
    let pt_k : PrimeSpectrum k₀ := ⊥
    obtain ⟨W_aff, hAff_W, hw_mem, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := w_k.base pt_k) (U := (⊤ : W.Opens)) trivial
    let W' : AlgebraicGeometry.Scheme.{u} := W_aff.toScheme
    have _ : AlgebraicGeometry.IsAffine W' := hAff_W
    have hwk_range : Set.range w_k.base ⊆ Set.range W_aff.ι.base := by
      rintro _ ⟨pt, rfl⟩
      rw [Subsingleton.elim pt pt_k]
      exact ⟨⟨w_k.base pt_k, hw_mem⟩, rfl⟩
    let w'_k : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ W' :=
      AlgebraicGeometry.IsOpenImmersion.lift W_aff.ι w_k hwk_range
    have hw'_fac : w'_k ≫ W_aff.ι = w_k :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_aff.ι w_k hwk_range
    let q'_B : W' ⟶ B := W_aff.ι ≫ q_B
    let e'_X : W' ⟶ X := W_aff.ι ≫ e_X
    let e'_C : W' ⟶ C := W_aff.ι ≫ e_C
    have _ : AlgebraicGeometry.Etale e'_X := by dsimp [e'_X]; infer_instance
    have _ : AlgebraicGeometry.Etale e'_C := by dsimp [e'_C]; infer_instance
    let V_R : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback q'_B g_tilde_R
    let fst_VR : V_R ⟶ W' := CategoryTheory.Limits.pullback.fst q'_B g_tilde_R
    let p_VR : V_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_bar) :=
      CategoryTheory.Limits.pullback.snd q'_B g_tilde_R
    have hAff_VR : AlgebraicGeometry.IsAffine V_R := inferInstance
    let V_R_Ω : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p_VR j_A
    let j_VR : V_R_Ω ⟶ V_R := CategoryTheory.Limits.pullback.fst p_VR j_A
    let p_VR_Ω : V_R_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₀) :=
