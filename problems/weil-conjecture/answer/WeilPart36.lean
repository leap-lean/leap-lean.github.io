          (Nat.zero_add r))
    (∀ (r : ℕ), 1 ≤ r → r ≤ M →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j r G)) →
    Function.Surjective (leray_j (M + 1)) →
    Function.Injective (leray_j (M + 2)) →
    Subsingleton ((weilEtaleHigherDirectImage j (M + 1) G).H 0) :=
by
  let J_X := X.smallEtaleTopology
  let J_U := X_U.smallEtaleTopology
  let B_j := weilEtaleSitePullback j
  let pf_j := B_j.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_U
  let pb_j := B_j.sheafPullback AddCommGrpCat.{u} J_X J_U
  let adj_j := B_j.sheafAdjunctionContinuous AddCommGrpCat.{u} J_X J_U
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_U := (CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_X := (CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}).obj Aℤ
  let πℤ : pb_j.obj Fℤ_X ⟶ Fℤ_U := weilEtaleConstPullbackHom j hT_U hT_X Aℤ
  have : pf_j.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products pf_j
  have : CategoryTheory.Limits.PreservesFiniteLimits pf_j := ⟨fun _ _ _ => inferInstance⟩

  
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X_U.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite X.Etale) (Opposite X_U.Etale)
      AddCommGrpCat.{u}).obj B_j.op
  let Sh_X : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let E_X := W_B.comp Sh_X
  let Φ_HDI : ℕ → CategoryTheory.Functor
      (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    fun q => (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U q).comp E_X

  have hInjHDIZero : ∀ (I : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      [CategoryTheory.Injective I] (p : ℕ),
      1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j p I) := by
    intro I _ p hp
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, p = m + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
    have hP_zero : CategoryTheory.Limits.IsZero
        (CategoryTheory.Functor.comp B_j.op (CategoryTheory.Sheaf.cohomologyPresheaf I (m + 1))) := by
      rw [CategoryTheory.Functor.isZero_iff]
      intro V
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext x
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x
    exact Sh_X.map_isZero hP_zero

  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X_U.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X_U.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let Sh_U := CategoryTheory.presheafToSheaf J_U AddCommGrpCat.{u}
  let U_U := CategoryTheory.sheafToPresheaf J_U AddCommGrpCat.{u}
  let L_tot := Free_PSh ⋙ Sh_U
  let R_tot := U_U ⋙ Fgt_PSh
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite X_U.Etale) AddCommGrpCat.adj
  let adj_sh := CategoryTheory.sheafificationAdjunction J_U AddCommGrpCat.{u}
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh
  let Z_fun : X_U.Etale ⥤ CategoryTheory.Sheaf J_U AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite X_U.Etale → CategoryTheory.Sheaf J_U AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)

  let e_raw : ∀ (W : Opposite X_U.Etale) (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext (Z_obj W) F 0 ≃ ↑((U_U.obj F).obj W) :=
    fun W F =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
        ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) F).trans
          CategoryTheory.yonedaEquiv)

  have he_add : ∀ (W : Opposite X_U.Etale) (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
      e_raw W F (α₁ + α₂) = e_raw W F α₁ + e_raw W F α₂ := by
    intro W F α₁ α₂
    let V := Opposite.unop W
    let u₁ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
    let u₂ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
    have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
      map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
    let ψ : (Z_obj W ⟶ F) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_U.obj F) :=
      fun u => adj_sh.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) F u
    have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
      dsimp [ψ]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit]
      have hmap : U_U.map (u₁ + u₂) = U_U.map u₁ + U_U.map u₂ := rfl
      rw [hmap, CategoryTheory.Preadditive.comp_add]
    let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_U.obj F) →
        ↑((U_U.obj F).obj W) :=
      fun φ => CategoryTheory.yonedaEquiv
        (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_U.obj F) φ)
    let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
    have hyon : ∀ (φ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_U.obj F),
        eval_hom φ = (φ.app W) g₀ := by
      intro φ
      dsimp [eval_hom]
      rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
        e_raw W F α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
      intro α
      dsimp [e_raw, eval_hom, ψ, adj_tot]
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      rfl
    rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
      CategoryTheory.NatTrans.app_add]
    rfl

  let e_add : ∀ (W : Opposite X_U.Etale) (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F).obj W) ≃+
        ↑((U_U.obj F).obj W) :=
    fun W F => AddEquiv.mk' (e_raw W F) (he_add W F)

  let θ_comp : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) (W : Opposite X_U.Etale),
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F).obj W ≅
        (U_U.obj F).obj W :=
    fun F W =>
      { hom := AddCommGrpCat.ofHom (e_add W F).toAddMonoidHom
        inv := AddCommGrpCat.ofHom (e_add W F).symm.toAddMonoidHom
        hom_inv_id := by ext x; exact (e_add W F).symm_apply_apply x
        inv_hom_id := by ext y; exact (e_add W F).apply_symm_apply y }

  let θ_obj : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F ≅ U_U.obj F :=
    fun F => CategoryTheory.NatIso.ofComponents (fun W => θ_comp F W) (by
      intro W₁ W₂ ω
      have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F).map ω =
          ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F := rfl
      rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F]
      ext α
      let u : Z_obj W₁ ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α
      have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
      change e_raw W₂ F
          ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
        ((U_U.obj F).map ω) (e_raw W₁ F α)
      rw [hα]
      have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
      rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      dsimp [e_raw]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_left,
        ← CategoryTheory.yonedaEquiv_naturality',
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      rfl)

  let θ : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0 ≅ U_U :=
    CategoryTheory.NatIso.ofComponents θ_obj (by
      intro F₁ F₂ φ
      ext W α
      have hmap_φ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).map φ).app W =
          (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map φ := rfl
      let u : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
      have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
      change e_raw W F₂ ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).map φ).app W) α) =
        ((U_U.map φ).app W) (e_raw W F₁ α)
      rw [hmap_φ_mor, CategoryTheory.Abelian.extFunctorObj_map, hα]
      have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
          (CategoryTheory.Abelian.Ext.mk₀ u) =
          CategoryTheory.Abelian.Ext.mk₀ (u ≫ φ) :=
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u φ
      change e_raw W F₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
          (CategoryTheory.Abelian.Ext.mk₀ u)) = _
      rw [hpost]
      dsimp [e_raw]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      rfl)

  let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let e_pre : U_U.comp W_B ≅ pf_j.comp U_X :=
    CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _) (by
      intro _ _ _
      ext W x
      rfl)
  let e_counit : U_X.comp Sh_X ≅
      CategoryTheory.Functor.id (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
    CategoryTheory.asIso (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).counit
  let ε₀ : Φ_HDI 0 ≅ pf_j :=
    CategoryTheory.Functor.isoWhiskerRight θ E_X ≪≫
      (CategoryTheory.Functor.associator U_U W_B Sh_X).symm ≪≫
      CategoryTheory.Functor.isoWhiskerRight e_pre Sh_X ≪≫
      CategoryTheory.Functor.associator pf_j U_X Sh_X ≪≫
      CategoryTheory.Functor.isoWhiskerLeft pf_j e_counit ≪≫
      CategoryTheory.Functor.rightUnitor pf_j

  have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (Opposite X_U.Etale) AddCommGrpCat.{u})),
      (∀ (W : Opposite X_U.Etale),
        (K.map ((CategoryTheory.evaluation (Opposite X_U.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
      K.Exact := by
    intro K hW
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (Opposite X_U.Etale) AddCommGrpCat.{u}).obj W
    have hZW : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
    exact hZW.of_iso (K.mapLeftHomologyIso evW).symm

  have hHDI_SE : ∀ (SC : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf J_U AddCommGrpCat.{u})),
      SC.ShortExact →
      (∀ (p : ℕ), 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j p SC.X₂)) →
      ((∃ (δ₀ : pf_j.obj SC.X₃ ⟶ weilEtaleHigherDirectImage j 1 SC.X₁)
          (hcomp : pf_j.map SC.g ≫ δ₀ = 0),
        CategoryTheory.Epi δ₀ ∧
        (CategoryTheory.ShortComplex.mk (pf_j.map SC.g) δ₀ hcomp).Exact) ∧
      (CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j 1 SC.X₁) →
        (SC.map pf_j).ShortExact)) ∧
      (∀ (q : ℕ), 1 ≤ q →
        Nonempty (weilEtaleHigherDirectImage j (q + 1) SC.X₁ ≅
          weilEtaleHigherDirectImage j q SC.X₃)) ∧
      (∀ (p : ℕ), 1 ≤ p →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j (p + 1) SC.X₁) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j p SC.X₃)) := by
    intro SC hSE hAcyc
    have hConn : ∀ (q : ℕ),
        ∃ (Δ : (Φ_HDI q).obj SC.X₃ ⟶ (Φ_HDI (q + 1)).obj SC.X₁)
          (hcomp₁ : (Φ_HDI q).map SC.g ≫ Δ = 0)
          (hcomp₂ : Δ ≫ (Φ_HDI (q + 1)).map SC.f = 0),
          (CategoryTheory.ShortComplex.mk ((Φ_HDI q).map SC.g) Δ hcomp₁).Exact ∧
          (CategoryTheory.ShortComplex.mk Δ ((Φ_HDI (q + 1)).map SC.f) hcomp₂).Exact ∧
          CategoryTheory.Epi Δ ∧
          (CategoryTheory.Limits.IsZero ((Φ_HDI q).obj SC.X₂) → CategoryTheory.IsIso Δ) := by
      intro q
      let δ_pre : SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1) :=
        { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
          naturality := by
            intro W₁ W₂ ω
            have hL : (SC.X₃.cohomologyPresheaf q).map ω =
                ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
            have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
                ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
            rw [hL, hR,
              CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
              CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
            ext α
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
              (Nat.zero_add q) rfl (by omega) }
      have hg_app : ∀ (W : Opposite X_U.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U q).map SC.g).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.g
      have hf_app : ∀ (W : Opposite X_U.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U (q + 1)).map SC.f).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) SC.f
      have hcomp₁_pre :
          (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U q).map SC.g ≫ δ_pre = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        have hz : AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) ≫
            AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        have hzx : (AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) ≫
            AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)) x = 0 :=
          congrArg (fun φ => φ x) hz
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hg_app W]
        exact hzx
      have hcomp₂_pre :
          δ_pre ≫ (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U (q + 1)).map SC.f = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        have hz : AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        have hzx : (AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1)))) x = 0 :=
          congrArg (fun φ => φ x) hz
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W]
        exact hzx
      let A_pre := CategoryTheory.ShortComplex.mk
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U q).map SC.g) δ_pre hcomp₁_pre
      let B_pre := CategoryTheory.ShortComplex.mk
        δ_pre ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U (q + 1)).map SC.f) hcomp₂_pre
      have hA_pre_ex : A_pre.Exact := by
        apply hPresheafExact A_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X_U.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        let eW : A_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [A_pre, evW]; rw [hg_app W]; ext x; rfl)
            (by dsimp [A_pre, evW, δ_pre]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have hB_pre_ex : B_pre.Exact := by
        apply hPresheafExact B_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X_U.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        let eW : B_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [B_pre, evW, δ_pre]; ext x; rfl)
            (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      let Δ : (Φ_HDI q).obj SC.X₃ ⟶ (Φ_HDI (q + 1)).obj SC.X₁ := E_X.map δ_pre
      have hcomp₁ : (Φ_HDI q).map SC.g ≫ Δ = 0 := by
        change E_X.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U q).map SC.g) ≫
          E_X.map δ_pre = 0
        rw [← E_X.map_comp, hcomp₁_pre, E_X.map_zero]
      have hcomp₂ : Δ ≫ (Φ_HDI (q + 1)).map SC.f = 0 := by
        change E_X.map δ_pre ≫
          E_X.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U (q + 1)).map SC.f) = 0
        rw [← E_X.map_comp, hcomp₂_pre, E_X.map_zero]
      have hEx₁ : (CategoryTheory.ShortComplex.mk ((Φ_HDI q).map SC.g) Δ hcomp₁).Exact :=
        (hA_pre_ex.map W_B).map Sh_X
      have hEx₂ : (CategoryTheory.ShortComplex.mk Δ ((Φ_HDI (q + 1)).map SC.f) hcomp₂).Exact :=
        (hB_pre_ex.map W_B).map Sh_X
      have hZ_succ : CategoryTheory.Limits.IsZero ((Φ_HDI (q + 1)).obj SC.X₂) :=
        hAcyc (q + 1) (Nat.le_add_left 1 q)
      have hf_zero : (Φ_HDI (q + 1)).map SC.f = 0 :=
        hZ_succ.eq_of_tgt ((Φ_HDI (q + 1)).map SC.f) 0
      have hEpi_Δ : CategoryTheory.Epi Δ := hEx₂.epi_f hf_zero
      refine ⟨Δ, hcomp₁, hcomp₂, hEx₁, hEx₂, hEpi_Δ, ?_⟩
      intro hZ_q
      have hg_zero : (Φ_HDI q).map SC.g = 0 := hZ_q.eq_of_src ((Φ_HDI q).map SC.g) 0
      have hMono_Δ : CategoryTheory.Mono Δ := hEx₁.mono_g hg_zero
      exact CategoryTheory.isIso_of_mono_of_epi Δ
    refine ⟨?_, ?_, ?_⟩
    · obtain ⟨Δ₀, hcomp₁_0, _, hEx₁_0, _, hEpi_Δ₀, _⟩ := hConn 0
      let δ₀ : pf_j.obj SC.X₃ ⟶ (Φ_HDI 1).obj SC.X₁ := ε₀.inv.app SC.X₃ ≫ Δ₀
      have hcomp₀ : pf_j.map SC.g ≫ δ₀ = 0 := by
        dsimp [δ₀]
        rw [← CategoryTheory.Category.assoc, ε₀.inv.naturality SC.g,
          CategoryTheory.Category.assoc, hcomp₁_0, CategoryTheory.Limits.comp_zero]
      have hEpi_δ₀ : CategoryTheory.Epi δ₀ := by
        dsimp [δ₀]
        exact CategoryTheory.epi_comp _ _
      have hEx_pf : (CategoryTheory.ShortComplex.mk (pf_j.map SC.g) δ₀ hcomp₀).Exact := by
        let e_SC : CategoryTheory.ShortComplex.mk ((Φ_HDI 0).map SC.g) Δ₀ hcomp₁_0 ≅
            CategoryTheory.ShortComplex.mk (pf_j.map SC.g) δ₀ hcomp₀ :=
          CategoryTheory.ShortComplex.isoMk
            (ε₀.app SC.X₂) (ε₀.app SC.X₃) (CategoryTheory.Iso.refl _)
            (ε₀.hom.naturality SC.g).symm
            (by
              dsimp [δ₀]
              rw [← CategoryTheory.Category.assoc, ε₀.hom_inv_id_app,
                CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC).mp hEx₁_0
      refine ⟨⟨δ₀, hcomp₀, hEpi_δ₀, hEx_pf⟩, ?_⟩
      intro hZ₁
      obtain ⟨hSC_ex, hSC_mono⟩ :=
        (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_j).mp
          inferInstance SC hSE
      have hδ₀_zero : δ₀ = 0 := hZ₁.eq_of_tgt δ₀ 0
      have hSC_epi : CategoryTheory.Epi (pf_j.map SC.g) := hEx_pf.epi_f hδ₀_zero
      exact CategoryTheory.ShortComplex.ShortExact.mk' hSC_ex hSC_mono hSC_epi
    · intro q hq
      obtain ⟨Δ, _, _, _, _, _, hIso_Δ⟩ := hConn q
      let e_Δ : (Φ_HDI q).obj SC.X₃ ≅ (Φ_HDI (q + 1)).obj SC.X₁ :=
        @CategoryTheory.asIso _ _ _ _ Δ (hIso_Δ (hAcyc q hq))
      exact ⟨e_Δ.symm⟩
    · intro p hp hZ_succ
      obtain ⟨Δ, _, _, _, _, _, hIso_Δ⟩ := hConn p
      let e_Δ : (Φ_HDI p).obj SC.X₃ ≅ (Φ_HDI (p + 1)).obj SC.X₁ :=
        @CategoryTheory.asIso _ _ _ _ Δ (hIso_Δ (hAcyc p hp))
      exact hZ_succ.of_iso e_Δ

  
  let Φ_j := fun {A : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      {B : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}}
      (σ : pb_j.obj A ⟶ B) (r : ℕ) (z : A.H r) =>
    (CategoryTheory.Abelian.Ext.mk₀ σ).postcomp Fℤ_U (Nat.add_zero r)
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _ Fℤ_X A r) z)
        (Nat.zero_add r))

  let Φ_hom := fun {A : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      {B : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}}
      (σ : pb_j.obj A ⟶ B) (r : ℕ) =>
    ((CategoryTheory.Abelian.Ext.mk₀ σ).postcomp Fℤ_U (Nat.add_zero r)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_j.obj A) (Nat.zero_add r)).comp
        (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _ Fℤ_X A r))

  have hΦ_nat : ∀ {A₁ A₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      {B₁ B₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}}
      (f_X : A₁ ⟶ A₂) (f_U : B₁ ⟶ B₂)
      (σ₁ : pb_j.obj A₁ ⟶ B₁) (σ₂ : pb_j.obj A₂ ⟶ B₂),
      σ₁ ≫ f_U = pb_j.map f_X ≫ σ₂ →
      ∀ (r : ℕ) (z : A₁.H r),
        (Φ_j σ₁ r z).comp (CategoryTheory.Abelian.Ext.mk₀ f_U) (Nat.add_zero r) =
          Φ_j σ₂ r (z.comp (CategoryTheory.Abelian.Ext.mk₀ f_X) (Nat.add_zero r)) := by
    intro A₁ A₂ B₁ B₂ f_X f_U σ₁ σ₂ hcomm r z
    let u := (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _ Fℤ_X A₁ r) z
    have hmap : (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _ Fℤ_X A₂ r)
        (z.comp (CategoryTheory.Abelian.Ext.mk₀ f_X) (Nat.add_zero r)) =
        u.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_j.map f_X)) (Nat.add_zero r) := by
      dsimp [u]
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp u (Nat.zero_add r)).comp
        (CategoryTheory.Abelian.Ext.mk₀ σ₁) (Nat.add_zero r)).comp
        (CategoryTheory.Abelian.Ext.mk₀ f_U) (Nat.add_zero r) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _ Fℤ_X A₂ r)
          (z.comp (CategoryTheory.Abelian.Ext.mk₀ f_X) (Nat.add_zero r)))
        (Nat.zero_add r)).comp
        (CategoryTheory.Abelian.Ext.mk₀ σ₂) (Nat.add_zero r)
    rw [hmap,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp u (Nat.zero_add r))
        (CategoryTheory.Abelian.Ext.mk₀ σ₁)
        (CategoryTheory.Abelian.Ext.mk₀ f_U) (Nat.add_zero r),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ σ₁ f_U, hcomm,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (pb_j.map f_X) σ₂,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ) u
        (CategoryTheory.Abelian.Ext.mk₀ (pb_j.map f_X)) (Nat.zero_add r),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp u (Nat.zero_add r))
        (CategoryTheory.Abelian.Ext.mk₀ (pb_j.map f_X))
        (CategoryTheory.Abelian.Ext.mk₀ σ₂) (Nat.add_zero r)]

  have hΦ_pre : ∀ {A₁ A₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      {B : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}}
      (f_X : A₁ ⟶ A₂) (τ : pb_j.obj A₂ ⟶ B) (r : ℕ) (w : A₁.H r),
      Φ_j (pb_j.map f_X ≫ τ) r w =
        Φ_j τ r (((CategoryTheory.Abelian.Ext.mk₀ f_X).postcomp Fℤ_X (Nat.add_zero r)) w) := by
    intro A₁ A₂ B f_X τ r w
    have h1 := hΦ_nat f_X (CategoryTheory.CategoryStruct.id B) (pb_j.map f_X ≫ τ) τ
      (CategoryTheory.Category.comp_id _) r w
    rw [CategoryTheory.Abelian.Ext.comp_mk₀_id] at h1
    exact h1

  have hBij0 : ∀ (H : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      Function.Bijective (Φ_j (adj_j.counit.app H) 0) := by
    intro H
    have h0_mk₀ : ∀ (g : Fℤ_X ⟶ pf_j.obj H),
        Φ_j (adj_j.counit.app H) 0 (CategoryTheory.Abelian.Ext.mk₀ g) =
          CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X H).symm g)) := by
      intro g
      have hmap0 : (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
          Fℤ_X (pf_j.obj H) 0) (CategoryTheory.Abelian.Ext.mk₀ g) =
          CategoryTheory.Abelian.Ext.mk₀ (pb_j.map g) := by
        rw [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      have h1 : Φ_j (adj_j.counit.app H) 0 (CategoryTheory.Abelian.Ext.mk₀ g) =
          CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp ιℤ (pb_j.map g))
              (adj_j.counit.app H)) := by
        change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
              Fℤ_X (pf_j.obj H) 0) (CategoryTheory.Abelian.Ext.mk₀ g))
            (Nat.zero_add 0)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app H)) (Nat.add_zero 0) = _
        rw [hmap0, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      have h2 : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp ιℤ (pb_j.map g)) (adj_j.counit.app H) =
          CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X H).symm g) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (CategoryTheory.CategoryStruct.comp ιℤ)
            (CategoryTheory.Adjunction.homEquiv_counit adj_j Fℤ_X H g).symm)
      exact h1.trans (congrArg CategoryTheory.Abelian.Ext.mk₀ h2)
    let inv₀ : H.H 0 → (pf_j.obj H).H 0 := fun u =>
      CategoryTheory.Abelian.Ext.mk₀
        ((adj_j.homEquiv Fℤ_X H)
          (CategoryTheory.CategoryStruct.comp πℤ (CategoryTheory.Abelian.Ext.addEquiv₀ u)))
    have hLeft : Function.LeftInverse inv₀ (Φ_j (adj_j.counit.app H) 0) := by
      intro z
      let g : Fℤ_X ⟶ pf_j.obj H := CategoryTheory.Abelian.Ext.addEquiv₀ z
      have hz : CategoryTheory.Abelian.Ext.mk₀ g = z :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z
      have hl : Φ_j (adj_j.counit.app H) 0 z =
          CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X H).symm g)) :=
        (congrArg (Φ_j (adj_j.counit.app H) 0) hz.symm).trans (h0_mk₀ g)
      have ha : CategoryTheory.Abelian.Ext.addEquiv₀ (Φ_j (adj_j.counit.app H) 0 z) =
          CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X H).symm g) := by
        rw [hl, ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply _
      have hm : CategoryTheory.CategoryStruct.comp πℤ
          (CategoryTheory.Abelian.Ext.addEquiv₀ (Φ_j (adj_j.counit.app H) 0 z)) =
          (adj_j.homEquiv Fℤ_X H).symm g := by
        rw [ha, ← CategoryTheory.Category.assoc, hπι, CategoryTheory.Category.id_comp]
      have heq : (adj_j.homEquiv Fℤ_X H)
          (CategoryTheory.CategoryStruct.comp πℤ
            (CategoryTheory.Abelian.Ext.addEquiv₀ (Φ_j (adj_j.counit.app H) 0 z))) = g :=
        (congrArg (adj_j.homEquiv Fℤ_X H) hm).trans
          ((adj_j.homEquiv Fℤ_X H).apply_symm_apply g)
      exact (congrArg CategoryTheory.Abelian.Ext.mk₀ heq).trans hz
    have hRight : Function.RightInverse inv₀ (Φ_j (adj_j.counit.app H) 0) := by
      intro u
      let g : Fℤ_X ⟶ pf_j.obj H :=
        (adj_j.homEquiv Fℤ_X H)
          (CategoryTheory.CategoryStruct.comp πℤ (CategoryTheory.Abelian.Ext.addEquiv₀ u))
      have hm : CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X H).symm g) =
          CategoryTheory.Abelian.Ext.addEquiv₀ u := by
        dsimp [g]
        rw [(adj_j.homEquiv Fℤ_X H).symm_apply_apply, ← CategoryTheory.Category.assoc,
          hιπ, CategoryTheory.Category.id_comp]
      exact (h0_mk₀ g).trans
        ((congrArg CategoryTheory.Abelian.Ext.mk₀ hm).trans
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply u))
    exact ⟨hLeft.injective, hRight.surjective⟩

  have hSurj_inj : ∀ (I : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      [CategoryTheory.Injective I] (k : ℕ),
      Function.Surjective (Φ_j (adj_j.counit.app I) k) := by
    intro I _ k
    cases k with
    | zero => exact (hBij0 I).2
    | succ n =>
      intro x
      refine ⟨0, ?_⟩
      have h0 : Φ_j (adj_j.counit.app I) (n + 1) 0 = 0 :=
        map_zero (Φ_hom (adj_j.counit.app I) (n + 1))
      exact h0.trans (CategoryTheory.Abelian.Ext.eq_zero_of_injective x).symm

  
  have hExtLadder : ∀ (SC_top : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
      (hSE_top : SC_top.ShortExact) [CategoryTheory.Injective SC_top.X₂]
      (SC_bot : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_U AddCommGrpCat.{u}))
      (hSE_bot : SC_bot.ShortExact)
      (τ : SC_top.map pb_j ⟶ SC_bot),
      (∀ (k : ℕ), Function.Surjective (Φ_j τ.τ₁ (k + 1)) →
        Function.Surjective (Φ_j τ.τ₂ k) →
        Function.Surjective (Φ_j τ.τ₃ k)) ∧
      (∀ (k : ℕ), 1 ≤ k → Function.Injective (Φ_j τ.τ₁ (k + 1)) →
        Function.Injective (Φ_j τ.τ₃ k)) := by
    intro SC_top hSE_top _ SC_bot hSE_bot τ
    have hSE_pb : (SC_top.map pb_j).ShortExact := hSE_top.map_of_exact pb_j
    have h_ext_nat : hSE_pb.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ τ.τ₁) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ τ.τ₃).comp hSE_bot.extClass (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb hSE_bot τ
    have hΦ_δ : ∀ (k : ℕ) (w : SC_top.X₃.H k),
        Φ_j τ.τ₁ (k + 1) (w.comp hSE_top.extClass (rfl : k + 1 = k + 1)) =
          (Φ_j τ.τ₃ k w).comp hSE_bot.extClass (rfl : k + 1 = k + 1) := by
      intro k w
      let u_pb := (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
        Fℤ_X SC_top.X₃ k) w
      have hmap_δ : (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
          Fℤ_X SC_top.X₁ (k + 1)) (w.comp hSE_top.extClass (rfl : k + 1 = k + 1)) =
          u_pb.comp hSE_pb.extClass (rfl : k + 1 = k + 1) := by
        dsimp [u_pb]
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb_j hSE_top]
      change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
            Fℤ_X SC_top.X₁ (k + 1)) (w.comp hSE_top.extClass (rfl : k + 1 = k + 1)))
          (Nat.zero_add (k + 1))).comp
          (CategoryTheory.Abelian.Ext.mk₀ τ.τ₁) (Nat.add_zero (k + 1)) =
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp u_pb (Nat.zero_add k)).comp
          (CategoryTheory.Abelian.Ext.mk₀ τ.τ₃) (Nat.add_zero k)).comp
          hSE_bot.extClass (rfl : k + 1 = k + 1)
      rw [hmap_δ,
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
          u_pb hSE_pb.extClass (Nat.zero_add k) (rfl : k + 1 = k + 1) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp u_pb (Nat.zero_add k))
          hSE_pb.extClass (CategoryTheory.Abelian.Ext.mk₀ τ.τ₁)
          (rfl : k + 1 = k + 1) (Nat.add_zero 1) (by omega),
        h_ext_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp u_pb (Nat.zero_add k))
          (CategoryTheory.Abelian.Ext.mk₀ τ.τ₃) hSE_bot.extClass
          (Nat.add_zero k) (Nat.zero_add 1) (by omega)]
    refine ⟨?_, ?_⟩
    · intro k hSurj₁ hSurj₂ u
      obtain ⟨x₁, hx₁⟩ := hSurj₁ (u.comp hSE_bot.extClass (rfl : k + 1 = k + 1))
      have hx₁_f : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ SC_top.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨w₀, hw₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X hSE_top x₁ hx₁_f
          (rfl : k + 1 = k + 1)
      have hw₀_δ : (Φ_j τ.τ₃ k w₀).comp hSE_bot.extClass (rfl : k + 1 = k + 1) =
          u.comp hSE_bot.extClass (rfl : k + 1 = k + 1) := by
        rw [← hΦ_δ k w₀, hw₀, hx₁]
      have hdiff_δ : (u - Φ_j τ.τ₃ k w₀).comp hSE_bot.extClass (rfl : k + 1 = k + 1) = 0 := by
        have hsub := map_sub (hSE_bot.extClass.postcomp Fℤ_U (rfl : k + 1 = k + 1)) u (Φ_j τ.τ₃ k w₀)
        exact hsub.trans (sub_eq_zero.mpr hw₀_δ.symm)
      obtain ⟨v₂, hv₂⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_U hSE_bot
          (u - Φ_j τ.τ₃ k w₀) (rfl : k + 1 = k + 1) hdiff_δ
      obtain ⟨z₂, hz₂⟩ := hSurj₂ v₂
      have hz₂_g : Φ_j τ.τ₃ k (z₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC_top.g) (Nat.add_zero k)) =
          u - Φ_j τ.τ₃ k w₀ := by
        rw [← hΦ_nat SC_top.g SC_bot.g τ.τ₂ τ.τ₃ τ.comm₂₃ k z₂, hz₂, hv₂]
      refine ⟨z₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC_top.g) (Nat.add_zero k) + w₀, ?_⟩
      have hadd : Φ_j τ.τ₃ k
          (z₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC_top.g) (Nat.add_zero k) + w₀) =
          Φ_j τ.τ₃ k (z₂.comp (CategoryTheory.Abelian.Ext.mk₀ SC_top.g) (Nat.add_zero k)) +
            Φ_j τ.τ₃ k w₀ :=
        map_add (Φ_hom τ.τ₃ k) _ w₀
      rw [hadd, hz₂_g, sub_add_cancel]
    · intro k hk hInj₁
      obtain ⟨n, rfl⟩ : ∃ n : ℕ, k = n + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
      change Function.Injective ⇑(Φ_hom τ.τ₃ (n + 1))
      rw [injective_iff_map_eq_zero]
      intro w hw
      have hw' : Φ_j τ.τ₃ (n + 1) w = 0 := hw
      have hδ0 : Φ_j τ.τ₁ (n + 2) (w.comp hSE_top.extClass (rfl : (n + 1) + 1 = n + 2)) =
          Φ_j τ.τ₁ (n + 2) 0 := by
        rw [hΦ_δ (n + 1) w, hw',
          CategoryTheory.Abelian.Ext.zero_comp Fℤ_U (n + 1) hSE_bot.extClass (n + 2) rfl]
        exact (map_zero (Φ_hom τ.τ₁ (n + 2))).symm
      have hw_ext0 : w.comp hSE_top.extClass (rfl : (n + 1) + 1 = n + 2) = 0 := hInj₁ hδ0
      obtain ⟨z, hz⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_X hSE_top w
          (rfl : (n + 1) + 1 = n + 2) hw_ext0
      have hz0 : z = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective z
      rw [← hz, hz0,
        CategoryTheory.Abelian.Ext.zero_comp Fℤ_X (n + 1)
          (CategoryTheory.Abelian.Ext.mk₀ SC_top.g) (n + 1) (Nat.add_zero (n + 1))]

  
  have hFourTerm : ∀ {A₁ A₂ A₃ R₁ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      (f' : A₁ ⟶ A₂) [CategoryTheory.Mono f']
      (g' : A₂ ⟶ A₃) (δ₀ : A₃ ⟶ R₁) [CategoryTheory.Epi δ₀]
      (hfg' : f' ≫ g' = 0) (hgδ : g' ≫ δ₀ = 0),
      (CategoryTheory.ShortComplex.mk f' g' hfg').Exact →
      (CategoryTheory.ShortComplex.mk g' δ₀ hgδ).Exact →
      let i_W := CategoryTheory.Limits.cokernel.desc f' g' hfg'
      Function.Surjective ((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_X (Nat.add_zero 0)) →
      Function.Injective ((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_X (Nat.add_zero 1)) →
      Subsingleton (R₁.H 0) := by
    intro A₁ A₂ A₃ R₁ f' _ g' δ₀ _ hfg' hgδ hEx₁ hEx₂ i_W hSurj₀ hInj₁
    let W := CategoryTheory.Limits.cokernel f'
    let p_W : A₂ ⟶ W := CategoryTheory.Limits.cokernel.π f'
    have hp_iW : p_W ≫ i_W = g' := CategoryTheory.Limits.cokernel.π_desc f' g' hfg'
    have hMono_iW : CategoryTheory.Mono i_W :=
      CategoryTheory.ShortComplex.Exact.mono_cokernelDesc hEx₁
    have hiδ : i_W ≫ δ₀ = 0 := by
      apply (CategoryTheory.cancel_epi p_W).mp
      rw [← CategoryTheory.Category.assoc, hp_iW, hgδ, CategoryTheory.Limits.comp_zero]
    let S₂ := CategoryTheory.ShortComplex.mk g' δ₀ hgδ
    let SC_R := CategoryTheory.ShortComplex.mk i_W δ₀ hiδ
    let ℓ_g : A₂ ⟶ CategoryTheory.Limits.kernel δ₀ :=
      CategoryTheory.Limits.kernel.lift δ₀ g' hgδ
    have : CategoryTheory.Epi ℓ_g :=
      (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift S₂).mp hEx₂
    let ℓ_iW : W ⟶ CategoryTheory.Limits.kernel δ₀ :=
      CategoryTheory.Limits.kernel.lift δ₀ i_W hiδ
    have hfac_k : p_W ≫ ℓ_iW = ℓ_g := by
      apply CategoryTheory.Limits.equalizer.hom_ext
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι, hp_iW,
        CategoryTheory.Limits.kernel.lift_ι]
    have : CategoryTheory.Epi (p_W ≫ ℓ_iW) := by
      rw [hfac_k]
      infer_instance
    have : CategoryTheory.Epi ℓ_iW := CategoryTheory.epi_of_epi p_W ℓ_iW
    have hEx_R : SC_R.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift SC_R).mpr inferInstance
    have hSE_R : SC_R.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hEx_R hMono_iW inferInstance
    have hc_zero : ∀ c : R₁.H 0, c = 0 := by
      intro c
      let δc : W.H 1 := c.comp hSE_R.extClass (rfl : 0 + 1 = 1)
      have hδc_map : ((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_X (Nat.add_zero 1)) δc = 0 := by
        change (c.comp hSE_R.extClass (rfl : 0 + 1 = 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ SC_R.f) (Nat.add_zero 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc c hSE_R.extClass
          (CategoryTheory.Abelian.Ext.mk₀ SC_R.f) rfl (Nat.add_zero 1) rfl,
          hSE_R.extClass_comp,
          CategoryTheory.Abelian.Ext.comp_zero c A₃ 1 1 rfl]
      have hδc0 : δc = 0 := (injective_iff_map_eq_zero _).mp hInj₁ δc hδc_map
      obtain ⟨y, hy⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_X hSE_R c (rfl : 0 + 1 = 1) hδc0
      obtain ⟨w, hw⟩ := hSurj₀ y
      have hw' : w.comp (CategoryTheory.Abelian.Ext.mk₀ i_W) (Nat.add_zero 0) = y := hw
      rw [← hy, ← hw',
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero w
          (CategoryTheory.Abelian.Ext.mk₀ i_W) (CategoryTheory.Abelian.Ext.mk₀ δ₀)
          (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ i_W δ₀, hiδ,
        CategoryTheory.Abelian.Ext.mk₀_zero W R₁,
        CategoryTheory.Abelian.Ext.comp_zero w R₁ 0 0 rfl]
    exact ⟨fun a b => (hc_zero a).trans (hc_zero b).symm⟩

  
  dsimp only
  induction M generalizing G with
  | zero =>
    intro _ hSurj hInj
    let I : CategoryTheory.Sheaf J_U AddCommGrpCat.{u} := CategoryTheory.Injective.under G
    let u : G ⟶ I := CategoryTheory.Injective.ι G
    let Q := CategoryTheory.Limits.cokernel u
    let v : I ⟶ Q := CategoryTheory.Limits.cokernel.π u
    let SC := CategoryTheory.ShortComplex.mk u v (CategoryTheory.Limits.cokernel.condition u)
    have hSE : SC.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel u) inferInstance inferInstance
    obtain ⟨hEx_pf, hMono_f'⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_j).mp
        inferInstance SC hSE
    let f' : pf_j.obj G ⟶ pf_j.obj I := (SC.map pf_j).f
    let g' : pf_j.obj I ⟶ pf_j.obj Q := (SC.map pf_j).g
    have : CategoryTheory.Mono f' := hMono_f'
    let W := CategoryTheory.Limits.cokernel f'
    let p_W : pf_j.obj I ⟶ W := CategoryTheory.Limits.cokernel.π f'
    let i_W : W ⟶ pf_j.obj Q := CategoryTheory.Limits.cokernel.desc f' g' (SC.map pf_j).zero
    have hi_W : p_W ≫ i_W = g' := CategoryTheory.Limits.cokernel.π_desc f' g' (SC.map pf_j).zero
    let SC_W := CategoryTheory.ShortComplex.mk f' p_W (CategoryTheory.Limits.cokernel.condition f')
    have hSE_W : SC_W.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel f') inferInstance inferInstance
    have : CategoryTheory.Injective SC_W.X₂ :=
      CategoryTheory.Injective.injective_of_adjoint adj_j I
    let τ_W : SC_W.map pb_j ⟶ SC :=
      CategoryTheory.ShortComplex.homMk
        (adj_j.counit.app G)
        (adj_j.counit.app I)
        (pb_j.map i_W ≫ adj_j.counit.app Q)
        (adj_j.counit.naturality u).symm
        (by
          dsimp [SC_W, SC]
          rw [← CategoryTheory.Category.assoc, ← pb_j.map_comp, hi_W]
          exact (adj_j.counit.naturality v).symm)
    have hSurj_τ3 : Function.Surjective (Φ_j τ_W.τ₃ 0) :=
      (hExtLadder SC_W hSE_W SC hSE τ_W).1 0 hSurj (hSurj_inj I 0)
    have hSurj_iW0 : Function.Surjective
        ((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_X (Nat.add_zero 0)) := by
      intro y
      obtain ⟨w₀, hw₀⟩ := hSurj_τ3 (Φ_j (adj_j.counit.app Q) 0 y)
      refine ⟨w₀, (hBij0 Q).1 ?_⟩
      exact (hΦ_pre i_W (adj_j.counit.app Q) 0 w₀).symm.trans hw₀
    have hInj_τ3 : Function.Injective (Φ_j τ_W.τ₃ 1) :=
      (hExtLadder SC_W hSE_W SC hSE τ_W).2 1 (le_refl 1) hInj
    have hInj_iW1 : Function.Injective
        ((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_X (Nat.add_zero 1)) := by
      have hcomp_eq : Φ_j τ_W.τ₃ 1 =
          (Φ_j (adj_j.counit.app Q) 1) ∘
            ⇑((CategoryTheory.Abelian.Ext.mk₀ i_W).postcomp Fℤ_X (Nat.add_zero 1)) := by
        funext w
        exact hΦ_pre i_W (adj_j.counit.app Q) 1 w
      rw [hcomp_eq] at hInj_τ3
      exact Function.Injective.of_comp hInj_τ3
    obtain ⟨δ₀, hcomp, hEpi_δ₀, hEx_δ⟩ :=
      (hHDI_SE SC hSE (fun p hp => hInjHDIZero I p hp)).1.1
    have : CategoryTheory.Epi δ₀ := hEpi_δ₀
    exact hFourTerm f' g' δ₀ (SC.map pf_j).zero hcomp hEx_pf hEx_δ hSurj_iW0 hInj_iW1
  | succ m ih =>
    intro hZero_le hSurj hInj
    let I : CategoryTheory.Sheaf J_U AddCommGrpCat.{u} := CategoryTheory.Injective.under G
    let u : G ⟶ I := CategoryTheory.Injective.ι G
    let Q := CategoryTheory.Limits.cokernel u
    let v : I ⟶ Q := CategoryTheory.Limits.cokernel.π u
    let SC := CategoryTheory.ShortComplex.mk u v (CategoryTheory.Limits.cokernel.condition u)
    have hSE : SC.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel u) inferInstance inferInstance
    have hCalc := hHDI_SE SC hSE (fun p hp => hInjHDIZero I p hp)
    have hSE_pf : (SC.map pf_j).ShortExact :=
      hCalc.1.2 (hZero_le 1 (le_refl 1) (Nat.le_add_left 1 m))
    have hZero_Q : ∀ (r : ℕ), 1 ≤ r → r ≤ m →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j r Q) :=
      fun r hr1 hrm =>
        hCalc.2.2 r hr1 (hZero_le (r + 1) (Nat.le_add_left 1 r) (Nat.add_le_add_right hrm 1))
    obtain ⟨e_R⟩ := hCalc.2.1 (m + 1) (Nat.le_add_left 1 m)
    have : CategoryTheory.Injective (SC.map pf_j).X₂ :=
      CategoryTheory.Injective.injective_of_adjoint adj_j I
    let τ_c : (SC.map pf_j).map pb_j ⟶ SC :=
      CategoryTheory.ShortComplex.homMk
        (adj_j.counit.app G)
        (adj_j.counit.app I)
        (adj_j.counit.app Q)
        (adj_j.counit.naturality u).symm
        (adj_j.counit.naturality v).symm
    have hSurj_Q : Function.Surjective (Φ_j (adj_j.counit.app Q) (m + 1)) :=
      (hExtLadder (SC.map pf_j) hSE_pf SC hSE τ_c).1 (m + 1) hSurj (hSurj_inj I (m + 1))
    have hInj_Q : Function.Injective (Φ_j (adj_j.counit.app Q) (m + 2)) :=
      (hExtLadder (SC.map pf_j) hSE_pf SC hSE τ_c).2 (m + 2) (Nat.le_add_left 1 (m + 1)) hInj
    have hSub_Q : Subsingleton ((weilEtaleHigherDirectImage j (m + 1) Q).H 0) :=
      ih Q hZero_Q hSurj_Q hInj_Q
    refine ⟨fun a b => ?_⟩
    have hab : a.comp (CategoryTheory.Abelian.Ext.mk₀ e_R.hom) (Nat.add_zero 0) =
        b.comp (CategoryTheory.Abelian.Ext.mk₀ e_R.hom) (Nat.add_zero 0) :=
      hSub_Q.elim _ _
    have h_inv : ∀ x : (weilEtaleHigherDirectImage j (m + 2) G).H 0,
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ e_R.hom) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_R.inv) (Nat.add_zero 0) = x := by
      intro x
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero x
          (CategoryTheory.Abelian.Ext.mk₀ e_R.hom)
          (CategoryTheory.Abelian.Ext.mk₀ e_R.inv) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ e_R.hom e_R.inv,
        e_R.hom_inv_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    exact (h_inv a).symm.trans
      ((congrArg (fun z => z.comp (CategoryTheory.Abelian.Ext.mk₀ e_R.inv) (Nat.add_zero 0)) hab).trans
        (h_inv b))

theorem weil_proj_quadric_val_ring_trunc_acyclic_from_punctual_roof (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R_bar Ω k₁ : Type u) [CommRing R_bar] [HenselianLocalRing R_bar]
    [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    [Field Ω] [IsAlgClosed Ω] [Field k₁] [IsAlgClosed k₁]
    {X X_U Y U : AlgebraicGeometry.Scheme.{u}}
    (f_R : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_bar))
    (f_Ω : X_U ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (j : X_U ⟶ X) [AlgebraicGeometry.IsOpenImmersion j]
    (j_Y : U ⟶ Y)
    (i₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ X)
    (N : ℕ)
    (hSkyscraperZero :
      ∀ (S : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id S = 0 →
        (∀ (K : Type u) [Field K] [IsAlgClosed K]
          (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
          z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range i₀.base →
          ∃ (H_z : CategoryTheory.Sheaf
              (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
            WeilIsEtaleSheafPullback z_bar S H_z ∧
            CategoryTheory.Limits.IsZero H_z) →
        Subsingleton (S.H 0) →
        CategoryTheory.Limits.IsZero S)
    (hInj0_X :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ X) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j w) ℓ 0 ψ₀ →
        Function.Injective ψ₀)
    (hBij0_Y :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_Y w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_Y w) ℓ 0 ψ₀ →
        Function.Bijective ψ₀)
    (hZero_Y :
      ∀ (b : ℕ), 1 ≤ b → b ≤ N →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j_Y b (weilEtaleTorsionSheaf U ℓ)))
    (hSmoothAtlas :
      ∀ z : ↥X,
        z ∉ Set.range j.base →
        z ∉ Set.range i₀.base →
        ∃ (V : X.Opens) (_ : z ∈ V)
          (φ : V.toScheme ⟶ Y) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ X_U) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ U),
          CategoryTheory.IsPullback ι_VU j_V j V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_Y φ)
    (hGlobalBij :
      ∀ (i : ℕ), i ≤ N + 1 →
        ∀ (ψ_i : weilEtaleTorsionH X ℓ i →+ weilEtaleTorsionH X_U ℓ i),
          WeilIsTorsionEtalePullback j ℓ i ψ_i →
          Function.Bijective ψ_i) :
    (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ X) [AlgebraicGeometry.Etale w]
      (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
        weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ 0),
      WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j w) ℓ 0 ψ₀ →
      Function.Bijective ψ₀) ∧
    (∀ (b : ℕ), 1 ≤ b → b ≤ N →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf X_U ℓ))) :=
by
  classical
  let _ := (f_R, f_Ω)
  obtain ⟨_, hPullId, _, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨hSiteExact, _, _, _, _, _⟩ :=
    weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  obtain ⟨hPullExZero, _, hPullCompPair, _, _, _⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  obtain ⟨_, _, _, _, hTorConst, hTorHDI⟩ :=
    weil_etale_pullback_functoriality_and_iso_torsionH.{u} ℓ

  have hIsZeroPullback : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂)
      (F₂ : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u})
      (F₁ : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F₂ F₁ →
      CategoryTheory.Limits.IsZero F₂ →
      CategoryTheory.Limits.IsZero F₁ := by
    intro Z₁ Z₂ h F₂ F₁ hPB hZ₂
    rcases hPB with ⟨hc, hr, ⟨e_iso⟩⟩
    haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    haveI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h : CategoryTheory.Functor Z₂.Etale Z₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    letI := hc
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    letI := hr
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
      Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    have hid_zero : 𝟙 (pb_h.obj F₂) = 0 :=
      (adj_h.homEquiv F₂ (pb_h.obj F₂)).injective
        (hZ₂.eq_of_src
          ((adj_h.homEquiv F₂ (pb_h.obj F₂)) (𝟙 (pb_h.obj F₂)))
          ((adj_h.homEquiv F₂ (pb_h.obj F₂)) 0))
    have hZ_pb : CategoryTheory.Limits.IsZero (pb_h.obj F₂) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      exact hid_zero
    exact hZ_pb.of_iso e_iso.symm

  have hPullZeroComp : ∀ {Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Z₁ ⟶ Z₂) (h₂ : Z₂ ⟶ Z₃)
      (S : CategoryTheory.Sheaf Z₃.smallEtaleTopology AddCommGrpCat.{u})
      (H₂ : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h₂ S H₂ →
      CategoryTheory.Limits.IsZero H₂ →
      ∃ (H₁ : CategoryTheory.Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback (h₁ ≫ h₂) S H₁ ∧
        CategoryTheory.Limits.IsZero H₁ := by
    intro Z₁ Z₂ Z₃ h₁ h₂ S H₂ hPB₂ hZ₂
    obtain ⟨H₁, hPB₁, _, hZ₁_imp⟩ := hPullExZero h₁ H₂
    exact ⟨H₁, (hPullCompPair h₁ h₂ S H₂ H₁).1 hPB₂ hPB₁, hZ₁_imp hZ₂⟩

  obtain ⟨hc_j, hr_j, hLim_pb_j, hAdd_pb_j, hAdd_pf_j⟩ := hSiteExact j
  let B_j : CategoryTheory.Functor X.Etale X_U.Etale := weilEtaleSitePullback j
  let J_X := X.smallEtaleTopology
  let J_U := X_U.smallEtaleTopology
  letI : B_j.IsContinuous J_X J_U := hc_j
  let pf_j := B_j.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_U
  letI : pf_j.IsRightAdjoint := hr_j
  let pb_j := B_j.sheafPullback AddCommGrpCat.{u} J_X J_U
  let adj_j := B_j.sheafAdjunctionContinuous AddCommGrpCat.{u} J_X J_U
  letI : CategoryTheory.Limits.PreservesFiniteLimits pb_j := hLim_pb_j
  letI : pb_j.Additive := hAdd_pb_j
  letI : pf_j.Additive := hAdd_pf_j
  haveI := adj_j.leftAdjoint_preservesColimits
  haveI : CategoryTheory.Limits.PreservesFiniteColimits pb_j := ⟨fun _ _ _ => inferInstance⟩

  let T_U : X_U.Etale := weilEtaleIdTerminal.{u} X_U
  let hT_U : CategoryTheory.Limits.IsTerminal T_U := weilEtaleIdTerminalIsTerminal.{u} X_U
  let T_X : X.Etale := weilEtaleIdTerminal.{u} X
  let hT_X : CategoryTheory.Limits.IsTerminal T_X := weilEtaleIdTerminalIsTerminal.{u} X
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let F_U := weilEtaleTorsionSheaf X_U ℓ
  let F_X := weilEtaleTorsionSheaf X ℓ
  let adj_U := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT_U
  let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_X
  let τ_j := hT_U.from (B_j.obj T_X)
  let α_j : F_X ⟶ pf_j.obj F_U :=
    (adj_X.homEquiv AM (pf_j.obj F_U)).symm
      (CategoryTheory.CategoryStruct.comp (adj_U.unit.app AM) (F_U.obj.map (Opposite.op τ_j)))
  let C_0 := CategoryTheory.Limits.cokernel α_j

  obtain ⟨hMonoOfInj0, hBij0OfIso, hSliceCokZero⟩ :=
    weil_punctual_roof_const_push_mono_isIso_and_slice_cokernel_zero ℓ j hT_U hT_X
  obtain ⟨hIdHDIZero, hEtaleBC_HDI⟩ :=
    weil_punctual_roof_hdi_id_isZero_and_etale_pullback.{u} ℓ
  obtain ⟨ιℤ, hιπ, hπι, hBaseSub, hLerayIso⟩ :=
    weil_punctual_roof_base_cokernel_h0_subsingleton_and_leray_factor ℓ j hT_U hT_X

  have hMono_αj : CategoryTheory.Mono α_j := hMonoOfInj0 hInj0_X
  have hSub_C0 : Subsingleton (C_0.H 0) :=
    hBaseSub hMono_αj
      (fun ψ₀ hψ₀ => (hGlobalBij 0 (Nat.zero_le _) ψ₀ hψ₀).2)
      (fun ψ₁ hψ₁ => (hGlobalBij 1 (Nat.le_add_left 1 N) ψ₁ hψ₁).1)

  have hLiftGeomPt : ∀ {K : Type u} [Field K] {V₀ : AlgebraicGeometry.Scheme.{u}}
      (v : V₀ ⟶ X) [AlgebraicGeometry.IsOpenImmersion v]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
      z_bar.base (⊥ : PrimeSpectrum K) ∈ Set.range v.base →
      ∃ (z_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ V₀), z_V ≫ v = z_bar := by
    intro K _ V₀ v _ z_bar hz_mem
    have hsub : Set.range z_bar.base ⊆ Set.range v.base := by
      rintro _ ⟨pt, rfl⟩
      rw [Subsingleton.elim pt (⊥ : PrimeSpectrum K)]
      exact hz_mem
    exact ⟨AlgebraicGeometry.IsOpenImmersion.lift v z_bar hsub,
      AlgebraicGeometry.IsOpenImmersion.lift_fac v z_bar hsub⟩

  have hTor_C0 : ℓ • CategoryTheory.CategoryStruct.id C_0 = 0 := by
    have hTor_pf : ℓ • CategoryTheory.CategoryStruct.id (pf_j.obj F_U) = 0 := by
      rw [← pf_j.map_id, ← CategoryTheory.Functor.map_nsmul, hTorConst X_U, pf_j.map_zero]
    let π_C0 : pf_j.obj F_U ⟶ C_0 := CategoryTheory.Limits.cokernel.π α_j
    apply (CategoryTheory.cancel_epi π_C0).mp
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp π_C0, ← CategoryTheory.Preadditive.nsmul_comp,
      hTor_pf, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hStalk_C0 : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
      z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range i₀.base →
      ∃ (H_z : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z_bar C_0 H_z ∧
        CategoryTheory.Limits.IsZero H_z := by
    intro K _ _ z_bar hz_not_i₀
    by_cases hz_j : z_bar.base (⊥ : PrimeSpectrum K) ∈ Set.range j.base
    · obtain ⟨z_U, hz_U⟩ := hLiftGeomPt j z_bar hz_j
      haveI : CategoryTheory.Mono j := AlgebraicGeometry.IsOpenImmersion.mono j
      obtain ⟨H_XU, hPB_XU, hZ_XU⟩ := hSliceCokZero j (fun W _ u _ => by
        refine ⟨W, u, CategoryTheory.CategoryStruct.id W, ?_, fun ψ₀ hψ₀ => ?_⟩
        · refine CategoryTheory.IsPullback.of_isLimit
            (c := CategoryTheory.Limits.PullbackCone.mk u (CategoryTheory.CategoryStruct.id W)
              (CategoryTheory.Category.id_comp _).symm) ?_
          refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
            (fun s => s.snd)
            (fun s => (CategoryTheory.cancel_mono j).mp
              ((CategoryTheory.Category.assoc s.snd u j).trans s.condition.symm))
            (fun s => CategoryTheory.Category.comp_id s.snd)
            (fun s m _ hm₂ => (CategoryTheory.Category.comp_id m).symm.trans hm₂)
        · rw [hPullId ℓ 0 ψ₀ hψ₀]
          exact Function.bijective_id)
      obtain ⟨H_z, hPB_z, hZ_z⟩ := hPullZeroComp z_U j C_0 H_XU hPB_XU hZ_XU
      rw [hz_U] at hPB_z
      exact ⟨H_z, hPB_z, hZ_z⟩
    · obtain ⟨V, hz_V, φ, hEt_φ, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩ :=
        hSmoothAtlas (z_bar.base (⊥ : PrimeSpectrum K)) hz_j hz_not_i₀
      haveI : AlgebraicGeometry.Etale φ := hEt_φ
      obtain ⟨z_V, hz_V_fac⟩ := hLiftGeomPt V.ι z_bar ⟨⟨_, hz_V⟩, rfl⟩
      obtain ⟨H_V, hPB_V, hZ_V⟩ := hSliceCokZero V.ι (fun W _ u _ => by
        let w_Y : W ⟶ Y := u ≫ φ
        haveI : AlgebraicGeometry.Etale w_Y := by dsimp [w_Y]; infer_instance
        let W' := CategoryTheory.Limits.pullback j_Y w_Y
        let fst_W : W' ⟶ U := CategoryTheory.Limits.pullback.fst j_Y w_Y
        let h' : W' ⟶ W := CategoryTheory.Limits.pullback.snd j_Y w_Y
        let v_U : W' ⟶ V_U :=
          hSq2.lift fst_W (h' ≫ u)
            ((CategoryTheory.Limits.pullback.condition (f := j_Y) (g := w_Y)).trans
              (CategoryTheory.Category.assoc h' u φ).symm)
        have hvU_fst : v_U ≫ φ_U = fst_W := hSq2.lift_fst _ _ _
        have hvU_snd : v_U ≫ j_V = h' ≫ u := hSq2.lift_snd _ _ _
        have hOuter : CategoryTheory.IsPullback (v_U ≫ φ_U) h' j_Y (u ≫ φ) :=
          Eq.ndrec
            (motive := fun k => CategoryTheory.IsPullback k h' j_Y (u ≫ φ))
            (CategoryTheory.IsPullback.of_hasPullback j_Y w_Y)
            hvU_fst.symm
        have hLeft : CategoryTheory.IsPullback v_U h' j_V u :=
          CategoryTheory.IsPullback.of_right hOuter hvU_snd hSq2
        exact ⟨W', v_U ≫ ι_VU, h', hLeft.paste_horiz hSq1,
          fun ψ₀ hψ₀ => hBij0_Y W w_Y ψ₀ hψ₀⟩)
      obtain ⟨H_z, hPB_z, hZ_z⟩ := hPullZeroComp z_V V.ι C_0 H_V hPB_V hZ_V
      rw [hz_V_fac] at hPB_z
      exact ⟨H_z, hPB_z, hZ_z⟩

  have hZero_C0 : CategoryTheory.Limits.IsZero C_0 :=
    hSkyscraperZero C_0 hTor_C0 hStalk_C0 hSub_C0
  have hIso_αj : CategoryTheory.IsIso α_j := by
    haveI : CategoryTheory.Mono α_j := hMono_αj
    haveI : CategoryTheory.Epi α_j :=
      (CategoryTheory.Preadditive.epi_iff_isZero_cokernel α_j).mpr hZero_C0
    exact CategoryTheory.isIso_of_mono_of_epi α_j

  refine ⟨hBij0OfIso hIso_αj, ?_⟩
  intro b
  refine Nat.strongRecOn b (fun b ih hb1 hbN => ?_)
  let M : ℕ := b - 1
  have hb_eq : M + 1 = b := Nat.sub_add_cancel hb1
  have hZero_le : ∀ (r : ℕ), 1 ≤ r → r ≤ M →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage j r F_U) :=
    fun r hr1 hrM => ih r (by omega) hr1 (by omega)
  have hSurj_M1 :=
    (hLerayIso hIso_αj (M + 1) (fun ψ hψ => hGlobalBij (M + 1) (by omega) ψ hψ)).2
  have hInj_M2 :=
    (hLerayIso hIso_αj (M + 2) (fun ψ hψ => hGlobalBij (M + 2) (by omega) ψ hψ)).1
  have hSub_Fb : Subsingleton ((weilEtaleHigherDirectImage j b F_U).H 0) := by
    rw [← hb_eq]
    exact weil_punctual_roof_trunc_leray_hdi_h0_subsingleton
      j hT_U hT_X ιℤ hιπ hπι M F_U hZero_le hSurj_M1 hInj_M2
  have hTor_Fb : ℓ • CategoryTheory.CategoryStruct.id
      (weilEtaleHigherDirectImage j b F_U) = 0 :=
    hTorHDI j b F_U (hTorConst X_U)
  have hStalk_Fb : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ X),
      z_bar.base (⊥ : PrimeSpectrum K) ∉ Set.range i₀.base →
      ∃ (H_z : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z_bar (weilEtaleHigherDirectImage j b F_U) H_z ∧
        CategoryTheory.Limits.IsZero H_z := by
    intro K _ _ z_bar hz_not_i₀
    by_cases hz_j : z_bar.base (⊥ : PrimeSpectrum K) ∈ Set.range j.base
    · obtain ⟨z_U, hz_U⟩ := hLiftGeomPt j z_bar hz_j
      haveI : CategoryTheory.Mono j := AlgebraicGeometry.IsOpenImmersion.mono j
      have hSq_id : CategoryTheory.IsPullback
          (CategoryTheory.CategoryStruct.id X_U)
          (CategoryTheory.CategoryStruct.id X_U) j j := by
        refine CategoryTheory.IsPullback.of_isLimit
          (c := CategoryTheory.Limits.PullbackCone.mk
            (CategoryTheory.CategoryStruct.id X_U)
            (CategoryTheory.CategoryStruct.id X_U) rfl) ?_
        refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
          (fun s => s.snd)
          (fun s => (CategoryTheory.Category.comp_id s.snd).trans
            ((CategoryTheory.cancel_mono j).mp s.condition.symm))
          (fun s => CategoryTheory.Category.comp_id s.snd)
          (fun s m _ hm₂ => (CategoryTheory.Category.comp_id m).symm.trans hm₂)
      have hPB_j := hEtaleBC_HDI
        (CategoryTheory.CategoryStruct.id X_U)
        (CategoryTheory.CategoryStruct.id X_U) j j b hSq_id
      have hZ_id := hIdHDIZero X_U F_U b hb1
      obtain ⟨H_z, hPB_z, hZ_z⟩ := hPullZeroComp z_U j
        (weilEtaleHigherDirectImage j b F_U)
        (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id X_U) b F_U)
        hPB_j hZ_id
      rw [hz_U] at hPB_z
      exact ⟨H_z, hPB_z, hZ_z⟩
    · obtain ⟨V, hz_V, φ, hEt_φ, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩ :=
        hSmoothAtlas (z_bar.base (⊥ : PrimeSpectrum K)) hz_j hz_not_i₀
      haveI : AlgebraicGeometry.Etale φ := hEt_φ
      obtain ⟨z_V, hz_V_fac⟩ := hLiftGeomPt V.ι z_bar ⟨⟨_, hz_V⟩, rfl⟩
      have hPB_φ := hEtaleBC_HDI φ_U j_V j_Y φ b hSq2
      have hZ_jV : CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j_V b (weilEtaleTorsionSheaf V_U ℓ)) :=
        hIsZeroPullback φ
          (weilEtaleHigherDirectImage j_Y b (weilEtaleTorsionSheaf U ℓ))
          (weilEtaleHigherDirectImage j_V b (weilEtaleTorsionSheaf V_U ℓ))
          hPB_φ (hZero_Y b hb1 hbN)
      have hPB_V := hEtaleBC_HDI ι_VU j_V j V.ι b hSq1
      obtain ⟨H_z, hPB_z, hZ_z⟩ := hPullZeroComp z_V V.ι
        (weilEtaleHigherDirectImage j b F_U)
        (weilEtaleHigherDirectImage j_V b (weilEtaleTorsionSheaf V_U ℓ))
        hPB_V hZ_jV
      rw [hz_V_fac] at hPB_z
      exact ⟨H_z, hPB_z, hZ_z⟩
  exact hSkyscraperZero (weilEtaleHigherDirectImage j b F_U) hTor_Fb hStalk_Fb hSub_Fb

theorem weil_sing_origin_cosp_proj_quadric_val_ring_acyclic (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (Q_fam : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g_Q : Q_fam ⟶ CategoryTheory.Over.mk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))))
    [AlgebraicGeometry.IsProper g_Q.left]
    (ι_affQ : AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) (Polynomial k) ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
