      (CategoryTheory.Category.assoc s_et g_et w₀).symm.trans
        ((congrArg (· ≫ w₀) hs_et).trans hs_tilde)
    let u_Z_hom := ((AlgebraicGeometry.Scheme.Etale.forget Y_ov.left).obj
      ((weilEtaleSitePullback f₁.left).obj U_et)).hom
    let g_B_u : (Fgt_Z.obj (B_fbar.obj W_s)).left ⟶ Z_W :=
      (Fgt_Z.map (B_fbar.map u_Ws)).left
