    congrArg (fun u => CategoryTheory.CategoryStruct.comp (adj_U.unit.app Aℤ)
      (Fℤ_U.obj.map (Opposite.op u))) he_T
  have h_eleft_hom : e_left.hom.app Aℤ = πℤ := by
    have h1 : (adj₁.homEquiv Aℤ Fℤ_U) (e_left.hom.app Aℤ) = adj₂.unit.app Aℤ :=
      CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app adj₁ adj₂ Aℤ
    rw [h_adj1_equiv, h_adj2_unit] at h1
    have h2 : (adj_j.homEquiv Fℤ_X Fℤ_U) (e_left.hom.app Aℤ) =
        (adj_X.homEquiv Aℤ (pf_j.obj Fℤ_U)).symm
          (CategoryTheory.CategoryStruct.comp (adj_U.unit.app Aℤ)
            (Fℤ_U.obj.map (Opposite.op τ))) :=
      ((adj_X.homEquiv Aℤ (pf_j.obj Fℤ_U)).symm_apply_apply _).symm.trans
        (congrArg (adj_X.homEquiv Aℤ (pf_j.obj Fℤ_U)).symm h1)
    exact ((adj_j.homEquiv Fℤ_X Fℤ_U).symm_apply_apply _).symm.trans
      (congrArg (adj_j.homEquiv Fℤ_X Fℤ_U).symm h2)
  have hιπ : CategoryTheory.CategoryStruct.comp ιℤ πℤ =
      CategoryTheory.CategoryStruct.id Fℤ_U := by
    rw [← h_eleft_hom]
    exact e_left.inv_hom_id_app Aℤ
  have hπι : CategoryTheory.CategoryStruct.comp πℤ ιℤ =
      CategoryTheory.CategoryStruct.id (pb_j.obj Fℤ_X) := by
    rw [← h_eleft_hom]
    exact e_left.hom_inv_id_app Aℤ
  let πM : pb_j.obj F_X ⟶ F_U := (adj_j.homEquiv F_X F_U).symm α_j
  let Λ_j : ∀ i : ℕ, weilEtaleTorsionH X ℓ i →+ weilEtaleTorsionH X_U ℓ i := fun i =>
