  have hAll : ∀ (r_idx q_deg : ℕ),
      CategoryTheory.IsIso (bc q_deg (weilEtaleTorsionSheaf X (ℓ ^ (r_idx + 1)))) := by
    intro r_idx
    induction r_idx with
