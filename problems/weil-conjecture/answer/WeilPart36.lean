        (MvPolynomial (Fin (m + 1) × Fin 2) (Polynomial k) ⧸ Ideal.span
          {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C (Polynomial.X : Polynomial k)})))
    (hQ1 :
      let p_CQ := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
      let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))
      ι_affQ ≫ g_Q.left = p_CQ ∧
      o₀ ≫ p_CQ = s₀ ∧
      ∀ (idx : Fin (m + 1) × Fin 2) (pt : AlgebraicGeometry.Spec (CommRingCat.of k)),
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (o₀.base pt).asIdeal)
    (hQ2 :
      ∀ z : Q_fam.left,
        z ∉ Set.range (o₀ ≫ ι_affQ).base →
        ∃ V : Q_fam.left.Opens,
          z ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g_Q.left))
    (hQ3 :
      let U_line := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
      let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
      ∃ (ι_Pi : CategoryTheory.Limits.pullback p_A1 (weilProjectiveSpaceOver k m).hom ⟶
          Q_fam.left),
        AlgebraicGeometry.IsClosedImmersion ι_Pi ∧
        ι_Pi ≫ g_Q.left =
          CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom ∧
        ∀ (K : Type u) [Field K] [IsAlgClosed K]
          (s_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U_line),
          Subsingleton
            (weilEtaleTorsionH (CategoryTheory.Limits.pullback g_Q.left s_K) ℓ (2 * m + 1)) ∧
          ∀ (i : ℕ),
            i ≤ 2 * m →
            ∀ (h_Pi_K :
                CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
                  s_K ⟶
                CategoryTheory.Limits.pullback g_Q.left s_K),
              h_Pi_K ≫ CategoryTheory.Limits.pullback.fst g_Q.left s_K =
                CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
                  s_K ≫ ι_Pi →
              h_Pi_K ≫ CategoryTheory.Limits.pullback.snd g_Q.left s_K =
                CategoryTheory.Limits.pullback.snd
                  (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
                  s_K →
              ∀ (p_i :
                  weilEtaleTorsionH (CategoryTheory.Limits.pullback g_Q.left s_K) ℓ i →+
                  weilEtaleTorsionH
                    (CategoryTheory.Limits.pullback
                      (CategoryTheory.Limits.pullback.fst p_A1 (weilProjectiveSpaceOver k m).hom)
                      s_K) ℓ i),
                WeilIsTorsionEtalePullback h_Pi_K ℓ i p_i →
                Function.Bijective p_i)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar]
    [HenselianLocalRing R_bar] [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    (p_R : Polynomial k →+* R_bar)
    (t_bar : R_bar) (ht_eq : p_R Polynomial.X = t_bar)
    (ht_max : t_bar ∈ IsLocalRing.maximalIdeal R_bar)
    (ht_ne : t_bar ≠ 0)
    (hMax_R : ∀ P_id : Ideal R_bar, P_id.IsPrime →
      P_id = ⊥ ∨ P_id = IsLocalRing.maximalIdeal R_bar)
    (hRes : (IsLocalRing.residue R_bar).comp p_R =
      ((IsLocalRing.residue R_bar).comp (p_R.comp Polynomial.C)).comp
