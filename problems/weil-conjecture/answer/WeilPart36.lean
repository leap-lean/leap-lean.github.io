        _ = AlgebraicGeometry.Spec.map ι_inf₀ ≫ e_W₀.hom := by rw [h1]

    exact ⟨D_poly, ι_D, c_poly, hc_poly, t_poly, π_Sd, E_inf, E_inf_loc, f_E, ι_inf₀,
      e_W₀, e_WU₀, ht_colim, hπ_nat, hv_stage, hf_E, hLoc_inf, he_comm₀⟩

  
  
  
  obtain ⟨i₀, E₀, f₀, g₀, hf₀_et, hPush₀⟩ :
      ∃ (i₀ : ℐ) (E₀ : CommRingCat.{u}) (f₀ : D_poly.obj i₀ ⟶ E₀) (g₀ : E₀ ⟶ E_inf),
        f₀.hom.Etale ∧ CategoryTheory.IsPushout (c_poly.ι.app i₀) f₀ f_E g₀ := by
    clear! k d_rel ℓ R_bar Ω D c t_poly E_inf_loc hToAlgAway hPushLocAway
    let F_fgt := CategoryTheory.forget CommRingCat.{u}
    let hc_type : CategoryTheory.Limits.IsColimit (F_fgt.mapCocone c_poly) :=
      CategoryTheory.Limits.isColimitOfPreserves F_fgt hc_poly
    have hNonemptyℐ : Nonempty ℐ := CategoryTheory.IsFiltered.nonempty
    have hLiftSet₀ : ∀ {α_t : Type} (S : Finset α_t) (x_fn : α_t → ↑c_poly.pt),
        ∃ (i : ℐ) (y_fn : α_t → ↑(D_poly.obj i)),
          ∀ a ∈ S, (c_poly.ι.app i).hom (y_fn a) = x_fn a := by
      intro α_t S x_fn
      induction S using Finset.induction_on with
      | empty =>
        obtain ⟨i_e⟩ := hNonemptyℐ
        exact ⟨i_e, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' ha₀ ih =>
        obtain ⟨i₁, y₁, hy₁⟩ := ih
        obtain ⟨i₂, z, hz⟩ :=
          CategoryTheory.Limits.Types.jointly_surjective (D_poly ⋙ F_fgt) hc_type (x_fn a₀)
        have hz' : (c_poly.ι.app i₂).hom z = x_fn a₀ := hz
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun a => if a = a₀ then (D_poly.map u₂).hom z
            else (D_poly.map u₁).hom (y₁ a), ?_⟩
        intro a ha
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · simp only [↓reduceIte]
          have hw₂ := congrArg (fun k_h => k_h.hom z) (c_poly.w u₂)
          exact hw₂.trans hz'
        · have hne : a ≠ a₀ := fun h => ha₀ (h ▸ haS')
          simp only [hne, ↓reduceIte]
          have hw₁ := congrArg (fun k_h => k_h.hom (y₁ a)) (c_poly.w u₁)
          exact hw₁.trans (hy₁ a haS')
    have hZeroSet₀ : ∀ {α_t : Type} (S : Finset α_t) (i₁ : ℐ) (y_fn : α_t → ↑(D_poly.obj i₁)),
        (∀ a ∈ S, (c_poly.ι.app i₁).hom (y_fn a) = 0) →
        ∃ (i₀ : ℐ) (θ : i₁ ⟶ i₀), ∀ a ∈ S, (D_poly.map θ).hom (y_fn a) = 0 := by
      intro α_t S i₁ y_fn hy
      induction S using Finset.induction_on with
      | empty =>
        exact ⟨i₁, 𝟙 i₁, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' _ ih =>
        obtain ⟨i₂, θ₁, hθ₁⟩ := ih (fun a ha => hy a (Finset.mem_insert_of_mem ha))
        have h_eq₀ : (CategoryTheory.ConcreteCategory.hom ((F_fgt.mapCocone c_poly).ι.app i₂))
