      calc
        f_lhs (B_M a) = f_lhs ((e_vec a).hom (ULift.up (1 : ℤ))) := by rw [he1]
        _ = ((e_vec a ≫ η_M₀ ≫ Θ_sh.hom.app (Opposite.op T_sh)).hom) (ULift.up (1 : ℤ)) := rfl
        _ = f_rhs (B_M a) :=
            congrArg (fun k : Aℤ ⟶ G_sh.obj.obj (Opposite.op T_sh) =>
              k.hom (ULift.up (1 : ℤ))) hcomp_app
    have hf_eq : f_lhs = f_rhs := by
      have hlin : f_lhs.toZModLinearMap (ℓ' + 1) = f_rhs.toZModLinearMap (ℓ' + 1) :=
        B_M.ext hf_basis
      ext m
      exact DFunLike.congr_fun hlin m
    have hf_lhs_bij : Function.Bijective f_lhs := by
      rw [hf_eq]
      exact (evalH0Equiv S_sh G_sh).bijective.comp e_sh_H0.bijective
    have hΘ_sh_bij : Function.Bijective (Θ_sh.hom.app (Opposite.op T_sh)) := by
      have hcomp_bij : Function.Bijective (Θ_sh.hom.app (Opposite.op T_sh) ∘ η_M₀) := hf_lhs_bij
      exact hBijRight hη_M₀_bij hcomp_bij
    have hpbΦ_inj : Function.Injective ((pb_u.map Φ).hom.app (Opposite.op T_sh)) := by
      intro x y hxy
      let x₀ := ((Ξ_const.hom.app M₀).hom.app (Opposite.op T_sh)) x
      let y₀ := ((Ξ_const.hom.app M₀).hom.app (Opposite.op T_sh)) y
