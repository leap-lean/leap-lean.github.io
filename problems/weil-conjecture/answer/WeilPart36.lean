        let Z_sch := CategoryTheory.Limits.pullback u₁_left u₂_left
        let p₁ : Z_sch ⟶ Y₁.left := CategoryTheory.Limits.pullback.fst u₁_left u₂_left
        let p₂ : Z_sch ⟶ Y₂.left := CategoryTheory.Limits.pullback.snd u₁_left u₂_left
        have hu₂_et : AlgebraicGeometry.Etale u₂_left := hMorEtale V u₂
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁_left u₂_left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ Y₁.hom) :=
          CategoryTheory.MorphismProperty.comp_mem P_et p₁ Y₁.hom hp₁_et Y₁.prop
        let Z_et : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ Y₁.hom) hZ_et
        let q₁ : Z_et ⟶ Y₁ :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ Y₂.hom = p₁ ≫ Y₁.hom := by
          have hw₁ : u₁_left ≫ E.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u₁
          have hw₂ : u₂_left ≫ E.hom = Y₂.hom := CategoryTheory.MorphismProperty.Over.w u₂
          rw [← hw₂, ← CategoryTheory.Category.assoc,
            ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hw₁]
        let q₂ : Z_et ⟶ Y₂ :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext
          · exact CategoryTheory.Limits.pullback.condition
          · exact Subsingleton.elim _ _
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
          congrArg (fun k =>
            (k.hom m : LocallyConstant
              ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj w₁₂.obj.left).left ↥A) z)
            (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m (p₂.base z) = eval_c c w₁₂ m z :=
          congrArg (fun k =>
            (k.hom m : LocallyConstant
              ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj w₁₂.obj.left).left ↥A) z)
            (c.w mor₂.op)
        exact (congrArg (eval_c c w₁ m) hz₁.symm).trans (hev₁.trans
          (hev₂.symm.trans (congrArg (eval_c c w₂ m) hz₂)))
      let g_fn : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A)) (m : ↥c.pt),
          ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj E).left → ↥A :=
        fun c m x =>
          let u_x := (hcov x).choose_spec.choose
          let y_x := (hcov x).choose_spec.choose_spec.choose
          let hu_x := (hcov x).choose_spec.choose_spec.choose_spec.1
          eval_c c ⟨CategoryTheory.Over.mk u_x, hu_x⟩ m y_x
      have hg_eq : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (m : ↥c.pt) (w : S.arrows.category)
          (y : ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj w.obj.left).left),
          g_fn c m (((AlgebraicGeometry.Scheme.Etale.forget V).map w.obj.hom).left.base y) =
            eval_c c w m y := by
        intro c m w y
        let x := ((AlgebraicGeometry.Scheme.Etale.forget V).map w.obj.hom).left.base y
        let u_x := (hcov x).choose_spec.choose
        let y_x := (hcov x).choose_spec.choose_spec.choose
        let hspec := (hcov x).choose_spec.choose_spec.choose_spec
        exact h_ov c ⟨CategoryTheory.Over.mk u_x, hspec.1⟩ w m y_x y hspec.2.2
      have hg_isLC : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (m : ↥c.pt), IsLocallyConstant (g_fn c m) := by
        intro c m
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        let Y_x := (hcov x).choose
        let u_x := (hcov x).choose_spec.choose
        let y_x := (hcov x).choose_spec.choose_spec.choose
        let hspec := (hcov x).choose_spec.choose_spec.choose_spec
        let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hspec.1⟩
        let u_left := ((AlgebraicGeometry.Scheme.Etale.forget V).map u_x).left
        have : AlgebraicGeometry.Etale u_left := hspec.2.1
        let O : Set ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y_x).left :=
          (eval_c c w_x m) ⁻¹' {a}
        have hO_open : IsOpen O := (eval_c c w_x m).isLocallyConstant {a}
        refine ⟨u_left.base '' O, ?_, u_left.isOpenMap O hO_open, ?_⟩
        · rintro x' ⟨y', hy', rfl⟩
          change g_fn c m (u_left.base y') = a
          rw [hg_eq c m w_x y']
          exact hy'
        · refine ⟨y_x, ?_, hspec.2.2⟩
          exact hx
      let lift_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A)),
          c.pt ⟶ (P_A.mapCone S.arrows.cocone.op).pt :=
        fun c => AddCommGrpCat.ofHom
          { toFun := fun m => ⟨g_fn c m, hg_isLC c m⟩
            map_zero' := by
              ext x
              let u_x := (hcov x).choose_spec.choose
              let y_x := (hcov x).choose_spec.choose_spec.choose
              let hu_x := (hcov x).choose_spec.choose_spec.choose_spec.1
              let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
              change eval_c c w_x 0 y_x = 0
              dsimp only [eval_c]
              rw [map_zero]
              rfl
            map_add' := fun m₁ m₂ => by
              ext x
              let u_x := (hcov x).choose_spec.choose
              let y_x := (hcov x).choose_spec.choose_spec.choose
              let hu_x := (hcov x).choose_spec.choose_spec.choose_spec.1
              let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
              change eval_c c w_x (m₁ + m₂) y_x = eval_c c w_x m₁ y_x + eval_c c w_x m₂ y_x
              dsimp only [eval_c]
              rw [map_add]
              rfl }
      refine ⟨{
        lift := lift_c
        fac := fun c j => by
          apply AddCommGrpCat.ext
          intro m
          apply LocallyConstant.ext
          intro y
          exact hg_eq c m j.unop y
        uniq := fun c k hk => by
          apply AddCommGrpCat.ext
          intro m
          apply LocallyConstant.ext
          intro x
          let Y_x := (hcov x).choose
          let u_x := (hcov x).choose_spec.choose
          let y_x := (hcov x).choose_spec.choose_spec.choose
          let hspec := (hcov x).choose_spec.choose_spec.choose_spec
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hspec.1⟩
          let km : LocallyConstant
              ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj E).left ↥A := k.hom m
          have hkx : km (((AlgebraicGeometry.Scheme.Etale.forget V).map u_x).left.base y_x) =
              eval_c c w_x m y_x :=
            congrArg (fun φ =>
              let φm : LocallyConstant
                  ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y_x).left ↥A := φ.hom m
              φm y_x)
              (hk (Opposite.op w_x))
          exact (congrArg km hspec.2.2).symm.trans hkx
      }⟩
    let ℒ_A : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let P_const : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const (Opposite V.Etale)).obj A
    let θ_A : P_const ⟶ P_A :=
      { app := fun E => AddCommGrpCat.ofHom
          (LocallyConstant.constAddMonoidHom
            (X := ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj E.unop).left) (Y := ↥A))
        naturality := fun _ _ _ => by
          apply AddCommGrpCat.ext
          intro a
          ext x
          rfl }
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective V.smallEtaleTopology θ_A := by
      apply CategoryTheory.Presheaf.IsLocallyInjective.mk
      intro E a₁ a₂ ha
      rw [hMem V E.unop _]
      intro x
      have ha_eq : a₁ = a₂ := congrArg (fun f => f x) ha
      refine ⟨E.unop, 𝟙 E.unop, x, ?_, ?_, rfl⟩
      · show (P_const.map (Opposite.op (𝟙 E.unop))) a₁ =
          (P_const.map (Opposite.op (𝟙 E.unop))) a₂
        rw [ha_eq]
      · exact hMorEtale V (𝟙 E.unop)
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective V.smallEtaleTopology θ_A := by
      apply CategoryTheory.Presheaf.IsLocallySurjective.mk
      intro (E : V.Etale) g
      rw [hMem V E _]
      intro x
      let a : ↥A := g x
      let E_sch : AlgebraicGeometry.Scheme.{u} := E.left
      let O_a : E_sch.Opens := ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et O_a.ι E.hom inferInstance E.prop
      let Y_a : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ?_, hMorEtale V u_a, rfl⟩
      refine ⟨a, ?_⟩
      ext y
      exact y.2.symm
    have hW : V.smallEtaleTopology.W θ_A :=
      (V.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
      (V.smallEtaleTopology.W_iff θ_A).mp hW
    let adj_sh := CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}
    let Υ_A : C_V ⟶ ℒ_A := (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_A =
        (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A :=
      CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have : CategoryTheory.IsIso Υ_A := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map inferInstance
    let e_A : C_V ≅ ℒ_A := CategoryTheory.asIso Υ_A
    let θ_V : ∀ Y : V.Etale,
        LocallyConstant ↥((AlgebraicGeometry.Scheme.Etale.forget V).obj Y).left ↥A →+
          ↑(C_V.obj.obj (Opposite.op Y)) :=
      fun Y => (e_A.inv.hom.app (Opposite.op Y)).hom
    refine ⟨hT_V, θ_V, ?_, ?_, ?_⟩
    · intro Y
      have : CategoryTheory.IsIso (e_A.inv.hom.app (Opposite.op Y)) :=
        CategoryTheory.Iso.isIso_hom
          (((CategoryTheory.sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u}).mapIso
            e_A.symm).app (Opposite.op Y))
      exact (CategoryTheory.ConcreteCategory.isIso_iff_bijective
        (e_A.inv.hom.app (Opposite.op Y))).mp inferInstance
    · intro Y₁ Y₂ f g
      have hnat := e_A.inv.hom.naturality (Opposite.op f)
      exact (congrArg (fun φ => φ.hom g) hnat).symm
    · intro a
      let S_to_P := CategoryTheory.sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u}
      have hunit_sh : adj_sh.unit.app P_const ≫ S_to_P.map e_A.hom = θ_A := by
        have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
        rwa [CategoryTheory.Adjunction.homEquiv_unit] at h1
      have hθ_nat : θ_A ≫ S_to_P.map e_A.inv = adj_sh.unit.app P_const :=
        (congrArg (· ≫ S_to_P.map e_A.inv) hunit_sh.symm).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (adj_sh.unit.app P_const ≫ ·)
              ((S_to_P.map_comp e_A.hom e_A.inv).symm.trans
                ((congrArg S_to_P.map e_A.hom_inv_id).trans (S_to_P.map_id C_V)))).trans
              (CategoryTheory.Category.comp_id _)))
      have hθ_app : (θ_A ≫ S_to_P.map e_A.inv).app (Opposite.op T_V) =
          (adj_sh.unit.app P_const).app (Opposite.op T_V) :=
        congrArg (fun τ => τ.app (Opposite.op T_V)) hθ_nat
      let adj_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT_V
      have hadj_unit : adj_V.unit.app A =
          (adj_sh.unit.app P_const).app (Opposite.op T_V) := by
        change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_V).comp adj_sh).unit.app A = _
        rw [CategoryTheory.Adjunction.comp_unit_app]
        exact CategoryTheory.Category.id_comp _
      exact congrArg (fun φ => φ.hom a) (hθ_app.trans hadj_unit.symm)

theorem weil_sing_dev_algBC_higherDirectImage_mono_and_long_exact {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S)
    (SC : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
    (hSE : SC.ShortExact) :
    CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 SC.f) ∧
    ∀ (q : ℕ),
      ∃ (h₁ : CategoryTheory.CategoryStruct.comp
            (weilEtaleHigherDirectImageMap f q SC.f)
            (weilEtaleHigherDirectImageMap f q SC.g) = 0)
        (h₂ : CategoryTheory.CategoryStruct.comp
            (weilEtaleHigherDirectImageMap f q SC.g)
            (weilSingDevAlgBCConnHom f SC hSE q) = 0)
        (h₃ : CategoryTheory.CategoryStruct.comp
            (weilSingDevAlgBCConnHom f SC hSE q)
            (weilEtaleHigherDirectImageMap f (q + 1) SC.f) = 0),
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f q SC.f)
          (weilEtaleHigherDirectImageMap f q SC.g) h₁).Exact ∧
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f q SC.g)
          (weilSingDevAlgBCConnHom f SC hSE q) h₂).Exact ∧
        (CategoryTheory.ShortComplex.mk
          (weilSingDevAlgBCConnHom f SC hSE q)
          (weilEtaleHigherDirectImageMap f (q + 1) SC.f) h₃).Exact :=
by
  have hFunExact :
      ∀ {J : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} J]
        (S_pre : CategoryTheory.ShortComplex (J ⥤ AddCommGrpCat.{u})),
        (∀ W : J, (S_pre.map ((CategoryTheory.evaluation J AddCommGrpCat.{u}).obj W)).Exact) →
        S_pre.Exact := by
    clear * -
    intro J _ S_pre h
    rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
    ext W x
    have hg0 : (S_pre.g.app W) (((CategoryTheory.Limits.kernel.ι S_pre.g).app W) x) = 0 := by
      change (((CategoryTheory.Limits.kernel.ι S_pre.g) ≫ S_pre.g).app W) x = 0
      rw [CategoryTheory.Limits.kernel.condition]
      rfl
    have hex := (CategoryTheory.ShortComplex.ab_exact_iff_function_exact _).mp (h W)
    obtain ⟨y, hy⟩ := (hex (((CategoryTheory.Limits.kernel.ι S_pre.g).app W) x)).1 hg0
    change ((CategoryTheory.Limits.cokernel.π S_pre.f).app W)
      (((CategoryTheory.Limits.kernel.ι S_pre.g).app W) x) = 0
    rw [← hy]
    change ((S_pre.f ≫ CategoryTheory.Limits.cokernel.π S_pre.f).app W) y = 0
    rw [CategoryTheory.Limits.cokernel.condition]
    rfl
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B := weilEtaleSitePullback f
  let shf := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
  have : shf.Additive :=
    CategoryTheory.Adjunction.left_adjoint_additive
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u})
  let wh := (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
    AddCommGrpCat.{u}).obj B.op
  refine ⟨?_, fun q => ?_⟩
  · let α₀ := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology 0).map SC.f
    have : CategoryTheory.Mono α₀ := by
      have : ∀ W : Opposite X.Etale, CategoryTheory.Mono (α₀.app W) := by
        intro W
        rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        let R_W := weilPolyP1CohomologyRepSheaf X (Opposite.unop W)
        obtain ⟨fa, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective R_W SC.X₁).2 a
        obtain ⟨fb, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective R_W SC.X₁).2 b
        have hab' : CategoryTheory.Abelian.Ext.mk₀ (fa ≫ SC.f) =
            CategoryTheory.Abelian.Ext.mk₀ (fb ≫ SC.f) := by
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
          exact hab
        have : CategoryTheory.Mono SC.f := hSE.mono_f
        exact congrArg CategoryTheory.Abelian.Ext.mk₀
          ((cancel_mono SC.f).mp ((CategoryTheory.Abelian.Ext.mk₀_bijective R_W SC.X₂).1 hab'))
      exact CategoryTheory.NatTrans.mono_of_mono_app α₀
    have : CategoryTheory.Mono (wh.map α₀) :=
      CategoryTheory.Functor.map_mono wh α₀
    change CategoryTheory.Mono (shf.map (wh.map α₀))
    exact CategoryTheory.Functor.map_mono shf (wh.map α₀)
  · let F_q := CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q
    let F_q1 := CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology (q + 1)
    let f_pre := F_q.map SC.f
    let g_pre := F_q.map SC.g
    let f1_pre := F_q1.map SC.f
    let δ_pre : Quiver.Hom (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ q)
        (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1)) :=
      { app := fun W =>
          AddCommGrpCat.ofHom
            (hSE.extClass.postcomp (weilPolyP1CohomologyRepSheaf X (Opposite.unop W)) rfl)
        naturality := fun {W₁ W₂} u =>
          AddCommGrpCat.ext fun x =>
            let φ_u : Quiver.Hom
                (weilPolyP1CohomologyRepSheaf X (Opposite.unop W₂))
                (weilPolyP1CohomologyRepSheaf X (Opposite.unop W₁)) :=
              (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).map
                (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u.unop)
                  AddCommGrpCat.free)
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ φ_u) x hSE.extClass
              (Nat.zero_add q) rfl (Nat.zero_add (q + 1)) }
    have h1_pre : f_pre ≫ g_pre = 0 := by
      ext W x
      have hex := (CategoryTheory.ShortComplex.ab_exact_iff_function_exact _).mp
        (CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
          (weilPolyP1CohomologyRepSheaf X (Opposite.unop W)) hSE q)
      exact (hex _).2 ⟨x, rfl⟩
    have h2_pre : g_pre ≫ δ_pre = 0 := by
      ext W x
      have hex := (CategoryTheory.ShortComplex.ab_exact_iff_function_exact _).mp
        (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
          (weilPolyP1CohomologyRepSheaf X (Opposite.unop W)) hSE q (q + 1) rfl)
      exact (hex _).2 ⟨x, rfl⟩
    have h3_pre : δ_pre ≫ f1_pre = 0 := by
      ext W x
      have hex := (CategoryTheory.ShortComplex.ab_exact_iff_function_exact _).mp
        (CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
          (weilPolyP1CohomologyRepSheaf X (Opposite.unop W)) hSE q (q + 1) rfl)
      exact (hex _).2 ⟨x, rfl⟩
    let S1_pre := CategoryTheory.ShortComplex.mk f_pre g_pre h1_pre
    let S2_pre := CategoryTheory.ShortComplex.mk g_pre δ_pre h2_pre
    let S3_pre := CategoryTheory.ShortComplex.mk δ_pre f1_pre h3_pre
    have hex1_pre : S1_pre.Exact := hFunExact S1_pre fun W =>
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
        (weilPolyP1CohomologyRepSheaf X (Opposite.unop W)) hSE q
    have hex2_pre : S2_pre.Exact := hFunExact S2_pre fun W =>
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
        (weilPolyP1CohomologyRepSheaf X (Opposite.unop W)) hSE q (q + 1) rfl
    have hex3_pre : S3_pre.Exact := hFunExact S3_pre fun W =>
