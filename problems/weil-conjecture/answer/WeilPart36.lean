        congrArg (fun f => f.hom z₁) (θ_sh.naturality (Opposite.op u₁))
      have hn2 : (θ_sh.app (Opposite.op W₁₂)).hom z₂' =
          (ℛ_bar.obj.map (Opposite.op u₂)).hom ((θ_sh.app (Opposite.op W₂)).hom z₂) :=
        congrArg (fun f => f.hom z₂) (θ_sh.naturality (Opposite.op u₂))
      have hc1 : (ℛ_bar.obj.map (Opposite.op u₁)).hom
          ((ℛ_bar.obj.map (Opposite.op (hT_D.from W₁))).hom (σ_hom ξ')) =
          (ℛ_bar.obj.map (Opposite.op (hT_D.from W₁₂))).hom (σ_hom ξ') := by
        have hfrom : u₁ ≫ hT_D.from W₁ = hT_D.from W₁₂ := hT_D.hom_ext _ _
        exact (congrArg (fun f => f.hom (σ_hom ξ'))
          (ℛ_bar.obj.map_comp (hT_D.from W₁).op u₁.op)).symm.trans
          (congrArg (fun m => (ℛ_bar.obj.map (Opposite.op m)).hom (σ_hom ξ')) hfrom)
      have hc2 : (ℛ_bar.obj.map (Opposite.op u₂)).hom
          ((ℛ_bar.obj.map (Opposite.op (hT_D.from W₂))).hom (σ_hom ξ')) =
          (ℛ_bar.obj.map (Opposite.op (hT_D.from W₁₂))).hom (σ_hom ξ') := by
        have hfrom : u₂ ≫ hT_D.from W₂ = hT_D.from W₁₂ := hT_D.hom_ext _ _
        exact (congrArg (fun f => f.hom (σ_hom ξ'))
          (ℛ_bar.obj.map_comp (hT_D.from W₂).op u₂.op)).symm.trans
          (congrArg (fun m => (ℛ_bar.obj.map (Opposite.op m)).hom (σ_hom ξ')) hfrom)
      exact (hn1.trans ((congrArg _ hz₁).trans hc1)).trans
        (hn2.trans ((congrArg _ hz₂).trans hc2)).symm
    have hEqSieve : CategoryTheory.Presheaf.equalizerSieve z₁' z₂' ∈
        D_bar.left.smallEtaleTopology W₁₂ :=
      CategoryTheory.Presheaf.IsLocallyInjective.equalizerSieve_mem (φ := θ_sh) z₁' z₂' hθ_eq
    obtain ⟨W₃, v₃, s₃, hv₃_eq, hs₃_v⟩ :=
      hLiftCov W₁₂ (CategoryTheory.Presheaf.equalizerSieve z₁' z₂') hEqSieve s₁₂
    let a₁ : W₃ ⟶ W₁ := v₃ ≫ u₁
    let a₂ : W₃ ⟶ W₂ := v₃ ≫ u₂
    have hs₃_1 : s₃ ≫ (Fgt_D.map a₁).left = s₁ :=
      (congrArg (s₃ ≫ ·) (congrArg CategoryTheory.CommaMorphism.left
        (Fgt_D.map_comp v₃ u₁))).trans
        (((CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ (Fgt_D.map u₁).left) hs₃_v)).trans hs₁₂_1)
    have hs₃_2 : s₃ ≫ (Fgt_D.map a₂).left = s₂ :=
      (congrArg (s₃ ≫ ·) (congrArg CategoryTheory.CommaMorphism.left
        (Fgt_D.map_comp v₃ u₂))).trans
        (((CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ (Fgt_D.map u₂).left) hs₃_v)).trans hs₁₂_2)
    have hs₃ : s₃ ≫ (Fgt_D.obj W₃).hom = s_bar :=
      (congrArg (s₃ ≫ ·) (Fgt_D.map a₁).w.symm).trans
        (((CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ (Fgt_D.obj W₁).hom) hs₃_1)).trans hs₁)
    have hz₃_eq : (P_pre.map (Opposite.op a₁)).hom z₁ = (P_pre.map (Opposite.op a₂)).hom z₂ := by
      have hc1 : (P_pre.map (Opposite.op a₁)).hom z₁ = (P_pre.map (Opposite.op v₃)).hom z₁' :=
        congrArg (fun f => f.hom z₁) (P_pre.map_comp u₁.op v₃.op)
      have hc2 : (P_pre.map (Opposite.op a₂)).hom z₂ = (P_pre.map (Opposite.op v₃)).hom z₂' :=
        congrArg (fun f => f.hom z₂) (P_pre.map_comp u₂.op v₃.op)
      exact hc1.trans (hv₃_eq.trans hc2.symm)
    obtain ⟨p₃, hp₃⟩ := hPullEx (ι_can W₃ s₃ hs₃) n_mod q_deg
    obtain ⟨q₁, hq₁⟩ := hPullEx (Fgt_Z.map (B_fbar.map a₁)).left n_mod q_deg
    obtain ⟨q₂, hq₂⟩ := hPullEx (Fgt_Z.map (B_fbar.map a₂)).left n_mod q_deg
    have hfac₁ := hCanFac a₁ s₃ hs₃ s₁ hs₁ hs₃_1
    have hfac₂ := hCanFac a₂ s₃ hs₃ s₂ hs₂ hs₃_2
    have hp₁' : WeilIsTorsionEtalePullback
        (ι_can W₃ s₃ hs₃ ≫ (Fgt_Z.map (B_fbar.map a₁)).left) n_mod q_deg p₁ := by
      rwa [hfac₁]
    have hp₂' : WeilIsTorsionEtalePullback
        (ι_can W₃ s₃ hs₃ ≫ (Fgt_Z.map (B_fbar.map a₂)).left) n_mod q_deg p₂ := by
      rwa [hfac₂]
    have hcomp₁ := hPullComp (ι_can W₃ s₃ hs₃) (Fgt_Z.map (B_fbar.map a₁)).left n_mod q_deg
      p₃ q₁ p₁ hp₃ hq₁ hp₁'
    have hcomp₂ := hPullComp (ι_can W₃ s₃ hs₃) (Fgt_Z.map (B_fbar.map a₂)).left n_mod q_deg
      p₃ q₂ p₂ hp₃ hq₂ hp₂'
    have hθ₁ : Θ_Z (B_fbar.obj W₃) ((P_pre.map (Opposite.op a₁)).hom z₁) =
        q₁ (Θ_Z (B_fbar.obj W₁) z₁) :=
