    have hPB_η_Gq : WeilIsEtaleSheafPullback (η_Δb ≫ θ_b) Gq H_η_b :=
      (hCompPB_ex η_Δb θ_b Gq G_Δb H_η_b).1 hPB_GΔb hPB_Hηb
    have hη_mem_lc : (η_Δb ≫ θ_b).base (⊥ : PrimeSpectrum Ω) ∈ U_lc := by
      rw [hη_gen]
      exact hGenMemUlc
    have hCard_Hηb := (hGenStalkCard Ω (η_Δb ≫ θ_b) hη_mem_lc H_η_b hPB_η_Gq).2
    obtain ⟨e_Hηb⟩ := hStalkEvalAt U_Δb_ov X₀_b_ov f₀_b Ω η_Δb H_η_b hPB_Hηb
    have hCard_Xηb :
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀_b.left η_Δb) ℓ q) =
        Nat.card ↥B_gen :=
      (Nat.card_congr e_Hηb.symm.toEquiv).trans hCard_Hηb
    have hCard_Xs0 : Nat.card (weilEtaleTorsionH X_s₀_b ℓ q) = Nat.card ↥B_gen :=
      hCard_s0_η.trans hCard_Xηb

    obtain ⟨H_s₀, hPB_Hs0_0, -⟩ := hExPB_ex s₀_Δb G_Δb
    have hPB_Hs0 : WeilIsEtaleSheafPullback (s₀_Δb ≫ θ_b) Gq H_s₀ :=
      (hCompPB_ex s₀_Δb θ_b Gq G_Δb H_s₀).1 hPB_GΔb hPB_Hs0_0
    obtain ⟨e_Hs0_Xs0⟩ := hStalkEvalAt U_Δb_ov X₀_b_ov f₀_b k s₀_Δb H_s₀ hPB_Hs0_0

    obtain ⟨W₀, _, _, w₀, hEt_w₀, s_W, η_W, G_W, Φ, hs_W, _, hDense_ηW, hPB_GW, hKer_ηW⟩ :=
      hLift_b hFin_Xs0
    exact ⟨Θ_b, ev₀_b, hEt_θ, hev_Θ, hPB_GΔb, hFin_Xs0, hCard_Xs0,
      ⟨H_s₀, hPB_Hs0, ⟨e_Hs0_Xs0⟩⟩,
      ⟨W₀, w₀, hEt_w₀, s_W, η_W, G_W, Φ, hs_W, hDense_ηW, hPB_GW, hKer_ηW⟩⟩

  have hUbarStalkCard : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U_bar.toScheme)
      (H_z : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback z Gq H_z →
      Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) = Nat.card ↥B_gen := by
    intro K _ _ z H_z hPB_Hz
    let z_RU : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_U) := z ≫ e_U.hom
    let ψ_z : R_U →+* K := (AlgebraicGeometry.Spec.preimage z_RU).hom
    have hz_RU_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) = z_RU :=
      AlgebraicGeometry.Spec.map_preimage z_RU
    have hz_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z) ≫ e_U.inv = z := by
      rw [hz_RU_eq]
      dsimp [z_RU]
      rw [Category.assoc, e_U.hom_inv_id, Category.comp_id]
    let φ_z : Polynomial k →+* K := ψ_z.comp (algebraMap (Polynomial k) R_U)
    by_cases hker : RingHom.ker φ_z = ⊥
    · have hpt_bot : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z)).base
          (⊥ : PrimeSpectrum K) = (⊥ : PrimeSpectrum R_U) := by
        apply PrimeSpectrum.localization_comap_injective R_U (Submonoid.powers Δ_k)
        apply PrimeSpectrum.ext
        change Ideal.comap φ_z ⊥ = Ideal.comap (algebraMap (Polynomial k) R_U) ⊥
        have hbot_RU : Ideal.comap (algebraMap (Polynomial k) R_U) ⊥ = ⊥ := by
          ext p
          simp only [Ideal.mem_comap, Ideal.mem_bot]
          exact ⟨fun h0 => hinj_PRU (h0.trans (map_zero _).symm), fun hp => by rw [hp, map_zero]⟩
        rw [hbot_RU]
        exact hker
      have hz_mem : z.base (⊥ : PrimeSpectrum K) ∈ U_lc := by
        rw [← hz_eq]
        change e_U.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_z)).base
          (⊥ : PrimeSpectrum K)) ∈ U_lc
        rw [hpt_bot]
        exact hGenMemUlc
      exact hGenStalkCard K z hz_mem H_z hPB_Hz
    · obtain ⟨b, hb_fac⟩ := hPolyHomClosed K φ_z hker
      have hb_ne : Polynomial.eval b Δ_k ≠ 0 := by
        intro hb0
        have hφ_Δ0 : φ_z Δ_k = 0 := by
          have h1 := DFunLike.congr_fun hb_fac Δ_k
          simpa [hb0] using h1
        have hUnit_K : IsUnit (φ_z Δ_k) :=
          (IsLocalization.Away.algebraMap_isUnit (S := R_U) Δ_k).map ψ_z
        exact hUnit_K.ne_zero hφ_Δ0
      obtain ⟨Θ_b, ev₀_b, _, hev_Θ, _, hFin_Xs0, hCard_Xs0,
        ⟨H_s₀, hPB_Hs0, ⟨e_Hs0_Xs0⟩⟩, -⟩ := hShiftedOriginPkg b hb_ne
      let θ_b := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_b.toRingHom) ≫ e_U.inv
      let s₀_Δb := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀_b)
      let u_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_z.comp Polynomial.C))
      have hψ_fac : ψ_z = ((φ_z.comp Polynomial.C).comp ev₀_b).comp Θ_b.toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers Δ_k)
        change φ_z = (φ_z.comp Polynomial.C).comp
          ((ev₀_b.comp Θ_b.toRingHom).comp (algebraMap (Polynomial k) R_U))
        rw [hev_Θ, ← hb_fac]
      have hz_fac : z = u_K ≫ (s₀_Δb ≫ θ_b) := by
        rw [← hz_eq, hψ_fac]
        dsimp [u_K, s₀_Δb, θ_b]
        rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
        simp only [Category.assoc]
      have hPB_z_comp : WeilIsEtaleSheafPullback (u_K ≫ (s₀_Δb ≫ θ_b)) Gq H_z := by
        rwa [← hz_fac]
      have hPB_uK : WeilIsEtaleSheafPullback u_K H_s₀ H_z :=
        (hCompPB_ex u_K (s₀_Δb ≫ θ_b) Gq H_s₀ H_z).2 hPB_Hs0 hPB_z_comp
      have _ : HenselianLocalRing k := Field.henselian k
      have _ : IsSepClosed (IsLocalRing.ResidueField k) := hSepRes k
      obtain ⟨e_z_s0⟩ :=
        (weil_strictly_henselian_spec_etale_eval_and_pullback k).2 K u_K
          (fun pt => Subsingleton.elim (u_K.base pt) (IsLocalRing.closedPoint k))
          H_s₀ H_z hPB_uK
      let e_tot := e_z_s0.trans e_Hs0_Xs0
      have _ : Finite (weilEtaleTorsionH _ ℓ q) := hFin_Xs0
      exact ⟨Finite.of_equiv _ e_tot.symm.toEquiv,
        (Nat.card_congr e_tot.toEquiv).trans hCard_Xs0⟩

  intro x
  let q_x : PrimeSpectrum R_U := e_U.hom.base x
  have hqx_inv : e_U.inv.base q_x = x := by
    change (e_U.hom ≫ e_U.inv).base x = x
    rw [e_U.hom_inv_id]; rfl
  let p_x : PrimeSpectrum (Polynomial k) :=
    PrimeSpectrum.comap (algebraMap (Polynomial k) R_U) q_x
  by_cases hpx_bot : p_x.asIdeal = ⊥
  · 
    have hqx_bot : q_x = (⊥ : PrimeSpectrum R_U) := by
      apply PrimeSpectrum.localization_comap_injective R_U (Submonoid.powers Δ_k)
      apply PrimeSpectrum.ext
      have hbot_RU : Ideal.comap (algebraMap (Polynomial k) R_U) ⊥ = ⊥ := by
        ext p
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        exact ⟨fun h0 => hinj_PRU (h0.trans (map_zero _).symm), fun hp => by rw [hp, map_zero]⟩
      exact hpx_bot.trans hbot_RU.symm
    have hx_lc : x ∈ U_lc := by
      rw [← hqx_inv, hqx_bot]
      exact hGenMemUlc
    obtain ⟨v₀, hv₀⟩ := hSurj_plc.surj ⟨x, hx_lc⟩
    let w_gen : V_lc ⟶ U_bar.toScheme := p_lc ≫ U_lc.ι
    have hw_gen_et : AlgebraicGeometry.Etale w_gen := by dsimp [w_gen]; infer_instance
    refine ⟨V_lc, w_gen, B_gen, hw_gen_et, ⟨v₀, ?_⟩, hFin_Bgen, hPB_lc⟩
    change U_lc.ι.base (p_lc.base v₀) = x
    have hv₀' : p_lc.base v₀ = ⟨x, hx_lc⟩ := hv₀
    rw [hv₀']
    rfl
  · 
    obtain ⟨b, hb_ker⟩ := hPolyPrime p_x hpx_bot
    have hb_ne : Polynomial.eval b Δ_k ≠ 0 := by
      intro hb0
      have hmem_px : Δ_k ∈ p_x.asIdeal := by
        rw [hb_ker, RingHom.mem_ker]
        exact hb0
      have hmem_qx : algebraMap (Polynomial k) R_U Δ_k ∈ q_x.asIdeal := hmem_px
      exact q_x.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem q_x.asIdeal hmem_qx
          (IsLocalization.Away.algebraMap_isUnit (S := R_U) Δ_k))
    obtain ⟨Θ_b, ev₀_b, hEt_θ, hev_Θ, hPB_GΔb, hFin_Xs0, hCard_Xs0, _,
      ⟨W₀, w₀, hEt_w₀, s_W, η_W, G_W, Φ, hs_W, hDense_ηW, hPB_GW, hKer_ηW⟩⟩ :=
      hShiftedOriginPkg b hb_ne
    let θ_b := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_b.toRingHom) ≫ e_U.inv
    let s₀_Δb := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀_b)
    have _ : AlgebraicGeometry.Etale θ_b := hEt_θ
    have _ : AlgebraicGeometry.Etale w₀ := hEt_w₀
    let M₀ : AddCommGrpCat.{u} :=
      AddCommGrpCat.of (weilEtaleTorsionH
        (CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd f_U θ_b) s₀_Δb) ℓ q)
    have hFin_M0 : Finite ↥M₀ := hFin_Xs0
    have _ : Finite ↥M₀ := hFin_M0
    let w : W₀ ⟶ U_bar.toScheme := w₀ ≫ θ_b
    have hw_et : AlgebraicGeometry.Etale w := by dsimp [w]; infer_instance
    have hPB_w : WeilIsEtaleSheafPullback w Gq G_W :=
      (hCompPB_ex w₀ θ_b Gq _ G_W).1 hPB_GΔb hPB_GW
    have hCard_W : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W₀)
        (H_z : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z G_W H_z →
        Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ Nat.card ↥M₀ := by
      intro K _ _ z H_z hPB_zG
      have hPB_zGq : WeilIsEtaleSheafPullback (z ≫ w) Gq H_z :=
        (hCompPB_ex z w Gq G_W H_z).1 hPB_w hPB_zG
      obtain ⟨hFin_Hz, hEq_Hz⟩ := hUbarStalkCard K (z ≫ w) H_z hPB_zGq
      exact ⟨hFin_Hz, le_of_eq (hEq_Hz.trans hCard_Xs0.symm)⟩
    have _ : CategoryTheory.IsIso Φ :=
      hPromoteIso W₀ Ω η_W hDense_ηW M₀ G_W Φ hKer_ηW hCard_W
    let C_W₀ := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
    have hPB_final : WeilIsEtaleSheafPullback w Gq (C_W₀.obj M₀) :=
      hIsoPB_ex w Gq Gq G_W (C_W₀.obj M₀) hPB_w ⟨CategoryTheory.Iso.refl Gq⟩
        ⟨(CategoryTheory.asIso Φ).symm⟩
    refine ⟨W₀, w, M₀, hw_et, ⟨s_W.base (⊥ : PrimeSpectrum k), ?_⟩, hFin_M0, hPB_final⟩
    have hqb_eq : (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (ev₀_b.comp Θ_b.toRingHom))).base (⊥ : PrimeSpectrum k) = q_x := by
      apply PrimeSpectrum.localization_comap_injective R_U (Submonoid.powers Δ_k)
      apply PrimeSpectrum.ext
      change Ideal.comap ((ev₀_b.comp Θ_b.toRingHom).comp (algebraMap (Polynomial k) R_U)) ⊥ =
        p_x.asIdeal
      rw [hev_Θ, hb_ker]
      rfl
    have hs0_θ_eq : s₀_Δb ≫ θ_b =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev₀_b.comp Θ_b.toRingHom)) ≫ e_U.inv := by
      dsimp [s₀_Δb, θ_b]
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hs0_pt : (s₀_Δb ≫ θ_b).base (⊥ : PrimeSpectrum k) = x := by
      rw [hs0_θ_eq]
      change e_U.inv.base ((AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (ev₀_b.comp Θ_b.toRingHom))).base (⊥ : PrimeSpectrum k)) = x
      rw [hqb_eq, hqx_inv]
    change (s_W ≫ w₀ ≫ θ_b).base (⊥ : PrimeSpectrum k) = x
    rw [← Category.assoc s_W w₀, hs_W]
    exact hs0_pt

theorem weil_bockstein_open_shortExact_finLocConst_ext (U₀ : AlgebraicGeometry.Scheme.{u})
    (hShrink : ∀ (V : AlgebraicGeometry.Scheme.{u}) (w : V ⟶ U₀),
      AlgebraicGeometry.Etale w →
      ∀ y : ↥V, ∃ (W₀ : AlgebraicGeometry.Scheme.{u}) (j₀ : W₀ ⟶ V) (y₀ : ↥W₀),
        AlgebraicGeometry.IsOpenImmersion j₀ ∧ j₀.base y₀ = y ∧ ConnectedSpace ↥W₀)
    (SC : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}))
    (hSE : SC.ShortExact)
    (x : ↥U₀)
    (hX₁ : ∃ (W₁ : AlgebraicGeometry.Scheme.{u}) (w₁ : W₁ ⟶ U₀) (A₁ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w₁ ∧
      x ∈ Set.range w₁.base ∧
      Finite ↥A₁ ∧
      WeilIsEtaleSheafPullback w₁ SC.X₁
        ((CategoryTheory.constantSheaf W₁.smallEtaleTopology AddCommGrpCat.{u}).obj A₁))
    (hX₃ : ∃ (W₃ : AlgebraicGeometry.Scheme.{u}) (w₃ : W₃ ⟶ U₀) (A₃ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w₃ ∧
      x ∈ Set.range w₃.base ∧
      Finite ↥A₃ ∧
      WeilIsEtaleSheafPullback w₃ SC.X₃
        ((CategoryTheory.constantSheaf W₃.smallEtaleTopology AddCommGrpCat.{u}).obj A₃)) :
    ∃ (W₂ : AlgebraicGeometry.Scheme.{u}) (w₂ : W₂ ⟶ U₀) (A₂ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w₂ ∧
      x ∈ Set.range w₂.base ∧
      Finite ↥A₂ ∧
      WeilIsEtaleSheafPullback w₂ SC.X₂
        ((CategoryTheory.constantSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).obj A₂) :=
by
  classical
  have hEtComp : MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEtPb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have hEtBC : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  have hTerm : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)) :=
    fun X =>
      Limits.IsTerminal.ofUniqueHom
        (fun Y => MorphismProperty.Over.homMk Y.hom (Category.comp_id Y.hom) trivial)
        (fun Y m => by
          apply (AlgebraicGeometry.Scheme.Etale.forget X).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact (Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m))

  have hMemEt : ∀ {X : AlgebraicGeometry.Scheme.{u}} (E : X.Etale) (R : Sieve E),
      R ∈ X.smallEtaleTopology E ↔
        ∀ (z : ↥E.left), ∃ (Y : X.Etale) (g : Y ⟶ E) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = z := by
    intro X E R
    change R ∈ Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) X E ↔ _
    rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X (le_refl _)]
    exact Scheme.mem_toGrothendieck_smallPretopology E R

  have hMorEt : ∀ {X : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : X.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    intro X Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := MorphismProperty.Over.w u
    have _ : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    have _ : AlgebraicGeometry.Etale Y₂.hom := Y₂.prop
    exact AlgebraicGeometry.Etale.of_comp u.left Y₂.hom

  
  have hSlicePkg :
      ∃ (resEtale : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X},
          AlgebraicGeometry.Etale w →
          Functor (Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
            (Sheaf V.smallEtaleTopology AddCommGrpCat.{u})),
        (∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X} (hw : AlgebraicGeometry.Etale w),
          (resEtale hw).Additive ∧
          Limits.PreservesFiniteLimits (resEtale hw) ∧
          Limits.PreservesFiniteColimits (resEtale hw)) ∧
        (∀ {V₂ V₁ X : AlgebraicGeometry.Scheme.{u}} {v : V₂ ⟶ V₁} {w : V₁ ⟶ X}
            (hv : AlgebraicGeometry.Etale v) (hw : AlgebraicGeometry.Etale w)
            (hvw : AlgebraicGeometry.Etale (v ≫ w)),
          Nonempty (resEtale hvw ≅ resEtale hw ⋙ resEtale hv)) ∧
        (∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X} (hw : AlgebraicGeometry.Etale w)
            {ℱ : Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
            {𝒢 : Sheaf V.smallEtaleTopology AddCommGrpCat.{u}},
          (WeilIsEtaleSheafPullback w ℱ 𝒢 → Nonempty ((resEtale hw).obj ℱ ≅ 𝒢)) ∧
          (Nonempty ((resEtale hw).obj ℱ ≅ 𝒢) → WeilIsEtaleSheafPullback w ℱ 𝒢)) ∧
        (∀ {V' V : AlgebraicGeometry.Scheme.{u}} {w : V' ⟶ V}
            (hw : AlgebraicGeometry.Etale w) (A : AddCommGrpCat.{u}),
          Nonempty ((resEtale hw).obj
            ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A) ≅
            (CategoryTheory.constantSheaf V'.smallEtaleTopology AddCommGrpCat.{u}).obj A)) ∧
        (∀ (V : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥V] [PreconnectedSpace ↥V]
            (A : AddCommGrpCat.{u}),
          IsIso ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
            (hTerm V)).unit.app A) ∧
          IsIso ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
            (hTerm V)).counit.app
            ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A))) ∧
        (∀ {P W₂ : AlgebraicGeometry.Scheme.{u}} [PreconnectedSpace ↥W₂]
            {E_lift : P.Etale} (u_lift : E_lift ⟶ AlgebraicGeometry.Scheme.Etale.mk (𝟙 P))
            (j' : W₂ ⟶ E_lift.left) (hv : AlgebraicGeometry.Etale (j' ≫ E_lift.hom))
            {ℰ_P : Sheaf P.smallEtaleTopology AddCommGrpCat.{u}} {A₃ : AddCommGrpCat.{u}}
            (g_P : ℰ_P ⟶ (CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}).obj A₃),
          (∀ a : ↥A₃, ∃ s : ↥(ℰ_P.obj.obj (Opposite.op E_lift)),
            (g_P.hom.app (Opposite.op E_lift)).hom s =
              (((CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}).obj A₃).obj.map
                u_lift.op).hom
                (((CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u}
                  (hTerm P)).unit.app A₃).hom a)) →
          Epi (((CategoryTheory.sheafSections W₂.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W₂)))).map
            ((resEtale hv).map g_P))) := by
    clear * - hEtComp hEtPb hEtBC hTerm hMemEt hMorEt
    let siteMap : ∀ {V X : AlgebraicGeometry.Scheme.{u}} {w : V ⟶ X}
        (_ : AlgebraicGeometry.Etale w), Functor V.Etale X.Etale :=
      fun hw => MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hw
    let sitePb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
        Functor Y₂.Etale Y₁.Etale :=
      fun h =>
        letI : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h := hEtPb h
        letI : MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h := hEtBC h
        MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
