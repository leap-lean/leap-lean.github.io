    have hp_comp_zero : p_comp ξ = 0 :=
      (congrFun (congrArg DFunLike.coe hp_comp_eq) ξ).trans
        ((congrArg p_β hpa_zero).trans (map_zero p_β))
    have hp_Bga_zero : p_Bga ξ₀ = 0 :=
      (congrFun (congrArg DFunLike.coe hp_Bga_eq) ξ₀).trans hp_comp_zero
    have hΘ_zero : Θ_U (B_j.obj V₀) (((G_U.cohomologyPresheaf b).map (B_j.map g_a).op).hom s₀_U) = 0 :=
      (hΘ_U (B_j.map g_a) p_Bga hp_Bga s₀_U).trans hp_Bga_zero
