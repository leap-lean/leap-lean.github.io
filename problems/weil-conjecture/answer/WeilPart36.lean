                (RingHom.ext fun c₀ => (IsScalarTower.algebraMap_apply E₀ E₁ k c₀).symm)
            let p_ZV₁_0 : Quiver.Hom (V_bar V₁).toScheme V₁.toScheme := p_ZX ∣_ V₁
            have hp_ZV₁_cond : p_ZV₁_0 ≫ Z_V₁_hom =
                (((V_bar V₁).ι ≫ E_bar_hom) ≫ snd_X ≫ g_E₁k) ≫ g_01 :=
              (CategoryTheory.Category.assoc p_ZV₁_0 V₁.ι Z_X.hom).symm.trans
                ((congrArg (· ≫ Z_X.hom)
                    (AlgebraicGeometry.morphismRestrict_ι p_ZX V₁)).trans
                  ((CategoryTheory.Category.assoc (V_bar V₁).ι p_ZX Z_X.hom).trans
                    ((congrArg ((V_bar V₁).ι ≫ ·) hp_ZX_pb.w).trans
                      ((congrArg ((V_bar V₁).ι ≫ ·)
                          ((congrArg ((E_bar_hom ≫ snd_X) ≫ ·) hg_tower.symm).trans
                            ((CategoryTheory.Category.assoc
                              (E_bar_hom ≫ snd_X) g_E₁k g_01).symm.trans
                              (congrArg (· ≫ g_01)
                                (CategoryTheory.Category.assoc E_bar_hom snd_X g_E₁k))))).trans
                        ((CategoryTheory.Category.assoc (V_bar V₁).ι
                            (E_bar_hom ≫ snd_X ≫ g_E₁k) g_01).symm.trans
                          (congrArg (· ≫ g_01)
                            (CategoryTheory.Category.assoc
                              (V_bar V₁).ι E_bar_hom (snd_X ≫ g_E₁k)).symm))))))
            let p_ZV₁ : Quiver.Hom (V_bar V₁).toScheme ZV₁_left :=
              CategoryTheory.Limits.pullback.lift p_ZV₁_0
                (((V_bar V₁).ι ≫ E_bar_hom) ≫ snd_X ≫ g_E₁k) hp_ZV₁_cond
            have hp_ZV₁_X : p_ZV₁ ≫ zV₁_X = ((V_bar V₁).ι ≫ E_bar_hom) ≫ pr_X :=
              (CategoryTheory.Category.assoc p_ZV₁ fst_ZV₁ z_V₁).symm.trans
                ((congrArg (· ≫ z_V₁)
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((CategoryTheory.Category.assoc p_ZV₁_0 V₁.ι z_X).symm.trans
                    ((congrArg (· ≫ z_X)
                        (AlgebraicGeometry.morphismRestrict_ι p_ZX V₁)).trans
                      ((CategoryTheory.Category.assoc (V_bar V₁).ι p_ZX z_X).trans
                        ((congrArg ((V_bar V₁).ι ≫ ·) hp_ZX_X).trans
                          (CategoryTheory.Category.assoc (V_bar V₁).ι E_bar_hom pr_X).symm)))))
            let σ_V₁ : Quiver.Hom (E_of V₁) ((weilEtaleSitePullback pr_X).obj ZV₁_et) :=
              CategoryTheory.MorphismProperty.Over.homMk
                (CategoryTheory.Limits.pullback.lift p_ZV₁ ((V_bar V₁).ι ≫ E_bar_hom) hp_ZV₁_X)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            have hσ_comm : f₁₂ ≫ σ_V₁ = σ_W₁ ≫ (weilEtaleSitePullback pr_X).map u_et := by
              apply CategoryTheory.MorphismProperty.Comma.Hom.ext
              · apply CategoryTheory.Limits.pullback.hom_ext
                · let lift_V₁ : Quiver.Hom (V_bar V₁).toScheme
                      (CategoryTheory.Limits.pullback zV₁_X pr_X) :=
                    CategoryTheory.Limits.pullback.lift p_ZV₁ ((V_bar V₁).ι ≫ E_bar_hom) hp_ZV₁_X
                  let lift_W₁ : Quiver.Hom (V_bar W_ov).toScheme
                      (CategoryTheory.Limits.pullback zW₁_X pr_X) :=
                    CategoryTheory.Limits.pullback.lift p_ZW₁
                      ((V_bar W_ov).ι ≫ E_bar_hom) hp_ZW₁_X
                  have hL : (i₁₂ ≫ lift_V₁) ≫
                      CategoryTheory.Limits.pullback.fst zV₁_X pr_X = i₁₂ ≫ p_ZV₁ :=
                    (CategoryTheory.Category.assoc i₁₂ lift_V₁ _).trans
                      (congrArg (i₁₂ ≫ ·)
                        (CategoryTheory.Limits.pullback.lift_fst p_ZV₁
                          ((V_bar V₁).ι ≫ E_bar_hom) hp_ZV₁_X))
                  have hm := CategoryTheory.MorphismProperty.Over.pullback_map_left
                    (@AlgebraicGeometry.Etale) ⊤ pr_X u_et
                  have hR : (lift_W₁ ≫ ((weilEtaleSitePullback pr_X).map u_et).left) ≫
                      CategoryTheory.Limits.pullback.fst zV₁_X pr_X = p_ZW₁ ≫ u_WV₁ :=
                    (CategoryTheory.Category.assoc lift_W₁ _ _).trans
                      ((congrArg (lift_W₁ ≫ ·)
                          ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst zV₁_X pr_X) hm).trans
                            (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
                        ((CategoryTheory.Category.assoc lift_W₁ _ u_WV₁).symm.trans
                          (congrArg (· ≫ u_WV₁)
                            (CategoryTheory.Limits.pullback.lift_fst p_ZW₁
                              ((V_bar W_ov).ι ≫ E_bar_hom) hp_ZW₁_X))))
                  have h_mid : i₁₂ ≫ p_ZV₁ = p_ZW₁ ≫ u_WV₁ := by
                    apply CategoryTheory.Limits.pullback.hom_ext
                    · have h_fst₁ : (i₁₂ ≫ p_ZV₁) ≫ fst_ZV₁ = i₁₂ ≫ p_ZV₁_0 :=
                        (CategoryTheory.Category.assoc i₁₂ p_ZV₁ fst_ZV₁).trans
                          (congrArg (i₁₂ ≫ ·)
                            (CategoryTheory.Limits.pullback.lift_fst _ _ _))
                      have h_fst₂ : (p_ZW₁ ≫ u_WV₁) ≫ fst_ZV₁ = p_ZW ≫ ι_WV₁ :=
                        (CategoryTheory.Category.assoc p_ZW₁ u_WV₁ fst_ZV₁).trans
                          ((congrArg (p_ZW₁ ≫ ·)
                              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                            ((CategoryTheory.Category.assoc p_ZW₁ _ ι_WV₁).symm.trans
                              (congrArg (· ≫ ι_WV₁) hp_ZW₁_fst)))
                      have h_fst_mid : i₁₂ ≫ p_ZV₁_0 = p_ZW ≫ ι_WV₁ := by
                        apply (CategoryTheory.cancel_mono V₁.ι).mp
                        exact (CategoryTheory.Category.assoc i₁₂ p_ZV₁_0 V₁.ι).trans
                          ((congrArg (i₁₂ ≫ ·)
                              (AlgebraicGeometry.morphismRestrict_ι p_ZX V₁)).trans
                            ((CategoryTheory.Category.assoc i₁₂ (V_bar V₁).ι p_ZX).symm.trans
                              ((congrArg (· ≫ p_ZX) hi₁₂_ι).trans
                                ((AlgebraicGeometry.morphismRestrict_ι p_ZX W_ov).symm.trans
                                  ((congrArg (p_ZW ≫ ·)
                                      (AlgebraicGeometry.Scheme.homOfLE_ι X_E₀
                                        (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).symm).trans
                                    (CategoryTheory.Category.assoc p_ZW ι_WV₁ V₁.ι).symm)))))
                      exact h_fst₁.trans (h_fst_mid.trans h_fst₂.symm)
                    · have h_snd₁ : (i₁₂ ≫ p_ZV₁) ≫
                          CategoryTheory.Limits.pullback.snd Z_V₁_hom g_01 =
                          i₁₂ ≫ (((V_bar V₁).ι ≫ E_bar_hom) ≫ snd_X ≫ g_E₁k) :=
                        (CategoryTheory.Category.assoc i₁₂ p_ZV₁ _).trans
                          (congrArg (i₁₂ ≫ ·)
                            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
                      have h_snd₂ : (p_ZW₁ ≫ u_WV₁) ≫
                          CategoryTheory.Limits.pullback.snd Z_V₁_hom g_01 =
                          (((V_bar W_ov).ι ≫ E_bar_hom) ≫ snd_X) ≫ g_E₁k :=
                        (CategoryTheory.Category.assoc p_ZW₁ u_WV₁ _).trans
                          ((congrArg (p_ZW₁ ≫ ·)
                              (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                            hp_ZW₁_snd)
                      have h_snd_mid : i₁₂ ≫ (((V_bar V₁).ι ≫ E_bar_hom) ≫ snd_X ≫ g_E₁k) =
                          (((V_bar W_ov).ι ≫ E_bar_hom) ≫ snd_X) ≫ g_E₁k :=
                        (CategoryTheory.Category.assoc i₁₂ ((V_bar V₁).ι ≫ E_bar_hom) _).symm.trans
                          ((congrArg (· ≫ (snd_X ≫ g_E₁k))
                              ((CategoryTheory.Category.assoc i₁₂ (V_bar V₁).ι E_bar_hom).symm.trans
                                (congrArg (· ≫ E_bar_hom) hi₁₂_ι))).trans
                            (CategoryTheory.Category.assoc ((V_bar W_ov).ι ≫ E_bar_hom)
                              snd_X g_E₁k).symm)
                      exact h_snd₁.trans (h_snd_mid.trans h_snd₂.symm)
                  exact hL.trans (h_mid.trans hR.symm)
                · have hwL := CategoryTheory.Over.w
                    ((AlgebraicGeometry.Scheme.Etale.forget X_bar).map (f₁₂ ≫ σ_V₁))
                  have hwR := CategoryTheory.Over.w
                    ((AlgebraicGeometry.Scheme.Etale.forget X_bar).map
                      (σ_W₁ ≫ (weilEtaleSitePullback pr_X).map u_et))
                  exact hwL.trans hwR.symm
              · exact Subsingleton.elim _ _
            let t1_bar : ↑(𝒥_bar.obj.obj (Opposite.op (E_of V₁))) :=
              (𝒥_bar.obj.map (Opposite.op σ_V₁)).hom
                (((adj_prX.unit.app 𝒥₀).hom.app (Opposite.op ZV₁_et)).hom t₁)
            have ht1_bar_res : (𝒥_bar.obj.map (Opposite.op f₁₂)).hom t1_bar = t_bar := by
              let u_t₁ := ((adj_prX.unit.app 𝒥₀).hom.app (Opposite.op ZV₁_et)).hom t₁
              have h1 : (𝒥_bar.obj.map (Opposite.op f₁₂)).hom
                    ((𝒥_bar.obj.map (Opposite.op σ_V₁)).hom u_t₁) =
                  (𝒥_bar.obj.map (Opposite.op (f₁₂ ≫ σ_V₁))).hom u_t₁ :=
                (ConcreteCategory.congr_hom
                  ((congrArg 𝒥_bar.obj.map
                      (CategoryTheory.op_comp (f := f₁₂) (g := σ_V₁))).trans
                    (𝒥_bar.obj.map_comp (Opposite.op σ_V₁) (Opposite.op f₁₂)))
                  u_t₁).symm
              have h2 : (𝒥_bar.obj.map (Opposite.op (f₁₂ ≫ σ_V₁))).hom u_t₁ =
                  (𝒥_bar.obj.map (Opposite.op (σ_W₁ ≫ (weilEtaleSitePullback pr_X).map u_et))).hom
                    u_t₁ :=
                congrArg (fun k => (𝒥_bar.obj.map (Opposite.op k)).hom u_t₁) hσ_comm
              have h3 : (𝒥_bar.obj.map
                    (Opposite.op (σ_W₁ ≫ (weilEtaleSitePullback pr_X).map u_et))).hom u_t₁ =
                  (𝒥_bar.obj.map (Opposite.op σ_W₁)).hom
                    ((𝒥_bar.obj.map (Opposite.op ((weilEtaleSitePullback pr_X).map u_et))).hom
                      u_t₁) :=
                ConcreteCategory.congr_hom
                  ((congrArg 𝒥_bar.obj.map
                      (CategoryTheory.op_comp (f := σ_W₁)
                        (g := (weilEtaleSitePullback pr_X).map u_et))).trans
                    (𝒥_bar.obj.map_comp
                      (Opposite.op ((weilEtaleSitePullback pr_X).map u_et))
                      (Opposite.op σ_W₁)))
                  u_t₁
              have hnat_u : (((adj_prX.unit.app 𝒥₀).hom.app (Opposite.op ZW₁_et)).hom
                    ((𝒥₀.obj.map (Opposite.op u_et)).hom t₁)) =
                  (𝒥_bar.obj.map (Opposite.op ((weilEtaleSitePullback pr_X).map u_et))).hom u_t₁ :=
                ConcreteCategory.congr_hom
                  ((adj_prX.unit.app 𝒥₀).hom.naturality (Opposite.op u_et)) t₁
              have h4 : (𝒥_bar.obj.map (Opposite.op σ_W₁)).hom
                    ((𝒥_bar.obj.map (Opposite.op ((weilEtaleSitePullback pr_X).map u_et))).hom
                      u_t₁) =
                  (𝒥_bar.obj.map (Opposite.op σ_W₁)).hom
                    (((adj_prX.unit.app 𝒥₀).hom.app (Opposite.op ZW₁_et)).hom s₁) :=
                congrArg ((𝒥_bar.obj.map (Opposite.op σ_W₁)).hom ·)
                  (hnat_u.symm.trans
                    (congrArg (((adj_prX.unit.app 𝒥₀).hom.app (Opposite.op ZW₁_et)).hom ·)
                      ht₁_res))
              exact h1.trans (h2.trans (h3.trans (h4.trans hs₁)))
            let ψ₁ : R_of V₁ ⟶ 𝒥_bar :=
              (weilPolyP1CohomologyRepHomEquiv X_bar (E_of V₁) 𝒥_bar).symm t1_bar
            let R_f₁₂ : R_of W_ov ⟶ R_of V₁ :=
              (CategoryTheory.presheafToSheaf X_bar.smallEtaleTopology AddCommGrpCat.{u}).map
                (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map f₁₂)
                  AddCommGrpCat.free)
            have hψ₁_fac : R_f₁₂ ≫ ψ₁ = ψ_W := by
              apply (weilPolyP1CohomologyRepHomEquiv X_bar (E_of W_ov) 𝒥_bar).injective
              rw [repHomEquiv_naturality_left X_bar f₁₂ 𝒥_bar ψ₁,
                (weilPolyP1CohomologyRepHomEquiv X_bar (E_of V₁) 𝒥_bar).apply_symm_apply]
              exact ht1_bar_res
            have hmv_f_fst : mv.shortComplex.f ≫ CategoryTheory.Limits.biprod.fst = R_f₁₂ :=
              (congrArg (· ≫ CategoryTheory.Limits.biprod.fst) mv.shortComplex_f).trans
                (CategoryTheory.Limits.biprod.lift_fst _ _)
            have hψW_mv : ψ_W = mv.shortComplex.f ≫ (CategoryTheory.Limits.biprod.fst ≫ ψ₁) :=
              hψ₁_fac.symm.trans
                ((congrArg (· ≫ ψ₁) hmv_f_fst.symm).trans
                  (CategoryTheory.Category.assoc _ _ _))
            rw [← hx₀, hx₀_mk, hψW_mv]
            exact hExtCompMk0Zero hmv_se 𝒥_bar (CategoryTheory.Limits.biprod.fst ≫ ψ₁)

      
      have hAff_each : ∀ x : ↥X_E₀,
          ∃ W : X_E₀.Opens, AlgebraicGeometry.IsAffineOpen W ∧ x ∈ W := by
        intro x
        obtain ⟨W, hW, hxW, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (X := X_E₀) (U := ⊤) (Set.mem_univ x)
        exact ⟨W, hW, hxW⟩
      choose W_pt hW_aff hx_W using hAff_each
      obtain ⟨s_fin, hs_cov⟩ := IsCompact.elim_finite_subcover
        (isCompact_univ : IsCompact (Set.univ : Set ↥X_E₀))
        (fun x : ↥X_E₀ => (W_pt x : Set ↥X_E₀))
        (fun x => (W_pt x).isOpen)
        (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_W x⟩)
      let m_cov := s_fin.card
      let eqv_s : Fin m_cov ≃ ↥s_fin := s_fin.equivFin.symm
      let U_cov : Fin m_cov → X_E₀.Opens := fun j => W_pt (eqv_s j).1
      have hU_aff : ∀ j : Fin m_cov, AlgebraicGeometry.IsAffineOpen (U_cov j) :=
        fun j => hW_aff (eqv_s j).1
      have hU_top : (⨆ j : Fin m_cov, U_cov j) = ⊤ := by
        refine le_antisymm le_top fun x _ => ?_
        have hx := hs_cov (Set.mem_univ x)
        rw [Set.mem_iUnion₂] at hx
        rcases hx with ⟨y, hy_s, hxy⟩
        exact TopologicalSpace.Opens.mem_iSup.mpr
          ⟨eqv_s.symm ⟨y, hy_s⟩,
            (congrArg (fun z : ↥s_fin => x ∈ W_pt z.1)
              (eqv_s.apply_symm_apply ⟨y, hy_s⟩)).mpr hxy⟩
      have hSub_top : Subsingleton (CategoryTheory.Abelian.Ext (R_of ⊤) 𝒥_bar q₀) := by
        rw [← hU_top]
        exact hUnionVanish m_cov U_cov hU_aff q₀ hq₀
      let e_top_sch : (V_bar ⊤).toScheme ≅ E_bar_left := E_bar_left.topIso
      let e_top_et : E_of ⊤ ≅ E_bar :=
        { hom := CategoryTheory.MorphismProperty.Over.homMk e_top_sch.hom
            (congrArg (· ≫ E_bar_hom) (AlgebraicGeometry.Scheme.topIso_hom E_bar_left)) trivial
          inv := CategoryTheory.MorphismProperty.Over.homMk e_top_sch.inv
            ((CategoryTheory.Category.assoc e_top_sch.inv (V_bar ⊤).ι E_bar_hom).symm.trans
              ((congrArg (· ≫ E_bar_hom)
                  ((congrArg (e_top_sch.inv ≫ ·)
                      (AlgebraicGeometry.Scheme.topIso_hom E_bar_left).symm).trans
                    e_top_sch.inv_hom_id)).trans
                (CategoryTheory.Category.id_comp E_bar_hom)))
            trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            e_top_sch.hom_inv_id (Subsingleton.elim _ _)
          inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            e_top_sch.inv_hom_id (Subsingleton.elim _ _) }
      let e_R_top : R_of ⊤ ≅ weilPolyP1CohomologyRepSheaf X_bar E_bar :=
        (CategoryTheory.presheafToSheaf X_bar.smallEtaleTopology AddCommGrpCat.{u}).mapIso
          (CategoryTheory.Functor.isoWhiskerRight (CategoryTheory.yoneda.mapIso e_top_et)
            AddCommGrpCat.free)
      exact subsingleton_ext_of_iso e_R_top.symm q₀ hSub_top

    
    let P_q : CategoryTheory.Functor (Opposite Y_bar.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback f_bar.left).op
        (CategoryTheory.Sheaf.cohomologyPresheaf 𝒥_bar q₀)
    let shAdj_Y := CategoryTheory.sheafificationAdjunction
      Y_bar.smallEtaleTopology AddCommGrpCat.{u}
    let ℋ_q : CategoryTheory.Sheaf Y_bar.smallEtaleTopology AddCommGrpCat.{u} :=
      (CategoryTheory.presheafToSheaf Y_bar.smallEtaleTopology AddCommGrpCat.{u}).obj P_q
    have hunit_zero : shAdj_Y.unit.app P_q = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext V_op
      rcases V_op with ⟨V_bar⟩
      apply AddCommGrpCat.ext
      intro z
      change ((shAdj_Y.unit.app P_q).app (Opposite.op V_bar)).hom z = 0
      obtain ⟨ι, U_fam, u_fam, hCov_V, hBasis_i⟩ := hAffBasis_Y V_bar
      let P_ℋ : CategoryTheory.Functor (Opposite Y_bar.Etale) (Type u) :=
        ((CategoryTheory.sheafForget Y_bar.smallEtaleTopology
          (D := AddCommGrpCat.{u})).obj ℋ_q).obj
      have hSh_V : CategoryTheory.Presieve.IsSheafFor P_ℋ
          (CategoryTheory.Presieve.ofArrows U_fam u_fam) :=
        (CategoryTheory.Presieve.isSheafFor_iff_generate
          (CategoryTheory.Presieve.ofArrows U_fam u_fam)).mpr
          (((CategoryTheory.sheafForget Y_bar.smallEtaleTopology
            (D := AddCommGrpCat.{u})).obj ℋ_q).property.isSheafFor
            (CategoryTheory.Sieve.ofArrows U_fam u_fam) hCov_V)
      refine hSh_V.isSeparatedFor.ext fun W' w hw => ?_
      rcases hw with ⟨idx⟩
      have hSub_idx : Subsingleton ↑(P_q.obj (Opposite.op (U_fam idx))) := by
        obtain ⟨E₀, hFin₀, hFld₀, hAlgF₀, hAlg₀k, hST₀, Z_Y, hAff_ZY, z_Y, hEt_zY,
          p_ZY, hz_Y_comm, hp_ZY_pb, hp_ZY_Y⟩ := hBasis_i idx
        letI : Finite E₀ := hFin₀
        letI : Field E₀ := hFld₀
        letI : Algebra F E₀ := hAlgF₀
        letI : Algebra E₀ k := hAlg₀k
        letI : IsScalarTower F E₀ k := hST₀
        letI : AlgebraicGeometry.IsAffine Z_Y.left := hAff_ZY
        letI : AlgebraicGeometry.Etale z_Y := hEt_zY
        let E_bar : X_bar.Etale := (weilEtaleSitePullback f_bar.left).obj (U_fam idx)
        let X_E₀ := CategoryTheory.Limits.pullback z_Y f₀.left
        let f_E₀ : Quiver.Hom X_E₀ Z_Y.left := CategoryTheory.Limits.pullback.fst z_Y f₀.left
        let z_X : Quiver.Hom X_E₀ X₀.left := CategoryTheory.Limits.pullback.snd z_Y f₀.left
        have : AlgebraicGeometry.IsProper f_E₀ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback z_Y f₀.left).flip inferInstance
        have : AlgebraicGeometry.Etale z_X :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback z_Y f₀.left) inferInstance
        have : CompactSpace ↥Z_Y.left := inferInstance
        have hComp_XE₀ : CompactSpace ↥X_E₀ :=
          AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace f_E₀
        have hSep_XE₀ : X_E₀.IsSeparated := by
          rw [AlgebraicGeometry.Scheme.isSeparated_iff]
          have : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from Z_Y.left) :=
            (AlgebraicGeometry.Scheme.isSeparated_iff Z_Y.left).mp inferInstance
          have hfZ : AlgebraicGeometry.IsSeparated
              (f_E₀ ≫ CategoryTheory.Limits.terminal.from Z_Y.left) := inferInstance
          rwa [CategoryTheory.Limits.terminal.comp_from] at hfZ
        let Z_X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₀)) :=
          CategoryTheory.Over.mk (f_E₀ ≫ Z_Y.hom)
        letI : CompactSpace ↥Z_X.left := hComp_XE₀
        letI : Z_X.left.IsSeparated := hSep_XE₀
        have hz_X_comm : z_X ≫ X₀.hom =
            Z_X.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E₀)) :=
          (congrArg (z_X ≫ ·) (CategoryTheory.Over.w f₀).symm).trans
            ((CategoryTheory.Category.assoc z_X f₀.left Y₀.hom).symm.trans
              ((congrArg (· ≫ Y₀.hom)
                  (CategoryTheory.Limits.pullback.condition
