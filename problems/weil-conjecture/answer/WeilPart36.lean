    let g'_ov : X_z_ov ⟶ X₀ := CategoryTheory.Over.homMk fst_z (by
      change fst_z ≫ X₀.hom = snd_z ≫ z ≫ S₀.hom
      rw [← CategoryTheory.Over.w f_S₀, ← Category.assoc,
        CategoryTheory.Limits.pullback.condition, Category.assoc])
    have hPB_pbc : WeilIsEtaleSheafPullback z
        (weilEtaleHigherDirectImage f_S₀.left q (weilEtaleTorsionSheaf X₀.left ℓ))
        (weilEtaleHigherDirectImage snd_z q (weilEtaleTorsionSheaf X_z_left ℓ)) :=
      hPBC X₀ S₀ S_K_ov X_z_ov f_S₀ g_ov f'_ov g'_ov inferInstance
        (CategoryTheory.IsPullback.of_hasPullback f_S₀.left z) _ _
        (hTorsSh X₀.left) (hConstPB_ex fst_z _) q
    obtain ⟨e_Hz⟩ := hUniquePB z _ H_z _ hPB_Hz hPB_pbc
    obtain ⟨e₁⟩ := hIsoH0 e_Hz
    have _ : HenselianLocalRing K := Field.henselian K
    have _ : IsSepClosed (IsLocalRing.ResidueField K) := hSepRes K
    obtain ⟨e₂⟩ :=
      (weil_strictly_henselian_spec_etale_eval_and_pullback K).1 X_z_left snd_z q
        (weilEtaleTorsionSheaf X_z_left ℓ)
    exact ⟨e₁.trans e₂⟩

  have hGenStalkCard : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (g_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ D_bar.left),
      g_K.base (⊥ : PrimeSpectrum K) ∈ U_lc →
      ∀ (H_K : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback g_K Rq H_K →
        Finite (H_K.H 0) ∧ Nat.card (H_K.H 0) = Nat.card ↥B_gen := by
    intro K _ _ g_K hg_mem H_K hPB_HK
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    have hRange_lc : Set.range ⇑g_K.base ⊆ Set.range ⇑U_lc.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨pt, rfl⟩
      rw [Subsingleton.elim pt (⊥ : PrimeSpectrum K)]
      exact hg_mem
    let g_lc : S_K ⟶ U_lc.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_lc.ι g_K hRange_lc
    have hg_lc : g_lc ≫ U_lc.ι = g_K :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_lc.ι g_K hRange_lc
    obtain ⟨v₀, hv₀⟩ := hSurj_plc.surj (g_lc.base (⊥ : PrimeSpectrum K))
    have hv₀_base : p_lc.base v₀ = g_lc.base (⊥ : PrimeSpectrum K) := hv₀
    obtain ⟨z₀, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := p_lc) (g := g_lc)
        v₀ (⊥ : PrimeSpectrum K) hv₀_base
    let fst_lc := CategoryTheory.Limits.pullback.fst p_lc g_lc
    let snd_lc := CategoryTheory.Limits.pullback.snd p_lc g_lc
    let E_lc : S_K.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ snd_lc inferInstance
    obtain ⟨τ_lc, _, _⟩ := hCoverByTK K E_lc z₀
    let σ_lc : S_K ⟶ CategoryTheory.Limits.pullback p_lc g_lc := τ_lc.left
    have hσ_lc : σ_lc ≫ snd_lc = 𝟙 S_K := CategoryTheory.MorphismProperty.Over.w τ_lc
    let g_tilde : S_K ⟶ V_lc := σ_lc ≫ fst_lc
    have hg_tilde : g_tilde ≫ (p_lc ≫ U_lc.ι) = g_K := by
      dsimp [g_tilde]
      rw [← Category.assoc, Category.assoc σ_lc, CategoryTheory.Limits.pullback.condition,
        ← Category.assoc, hσ_lc, Category.id_comp, hg_lc]
    let C_K := CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}
    have hPB_const : WeilIsEtaleSheafPullback g_K Rq (C_K.obj B_gen) := by
      rw [← hg_tilde]
      exact (hCompPB_ex g_tilde (p_lc ≫ U_lc.ι) Rq _ (C_K.obj B_gen)).1 hPB_lc
        (hConstPB_ex g_tilde B_gen)
    obtain ⟨e_HK⟩ := hUniquePB g_K Rq H_K (C_K.obj B_gen) hPB_HK hPB_const
    obtain ⟨e_H0⟩ := hIsoH0 e_HK
    let T_K := weilEtaleIdTerminal.{u} S_K
    let hT_K := weilEtaleIdTerminalIsTerminal.{u} S_K
    let e_CK_H0 : (C_K.obj B_gen).H 0 ≃+ ↥((C_K.obj B_gen).obj.obj (Opposite.op T_K)) :=
      CategoryTheory.Sheaf.H.equiv₀ (C_K.obj B_gen) hT_K
    let e_Bgen : ↥B_gen ≃ ↥((C_K.obj B_gen).obj.obj (Opposite.op T_K)) :=
      Equiv.ofBijective _ (hConstEvalBij K B_gen)
    let e_tot : H_K.H 0 ≃ ↥B_gen :=
      e_H0.toEquiv.trans (e_CK_H0.toEquiv.trans e_Bgen.symm)
    exact ⟨Finite.of_equiv ↥B_gen e_tot.symm, Nat.card_congr e_tot⟩

  have hClosedSecCard : ∀ (y_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left)
      (_ : y_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (K : Type u) [Field K] [IsAlgClosed K]
      (u_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k))
      (H_z : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback (u_K ≫ y_bar) Rq H_z →
      Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) = Nat.card ↥B_gen := by
    intro y_bar hy_bar K _ _ u_K H_z hPB_Hz
    obtain ⟨ι_y, hOpen_y, X_y, f_y, hProp_fy, ι_Xy, hι_y_hom, hs₀_y, hPb_y, hSing_y⟩ :=
      weil_sing_dev_outer_locConst_geom_chart_dichotomy F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀
        h1d f_bar hPb_fbar e_P y_bar hy_bar
    have _ : AlgebraicGeometry.IsOpenImmersion ι_y := hOpen_y
    have _ : AlgebraicGeometry.IsProper f_y.left := hProp_fy
    let G_q_y := weilEtaleHigherDirectImage f_y.left q (weilEtaleTorsionSheaf X_y.left ℓ)
    have hPB_Gqy : WeilIsEtaleSheafPullback ι_y Rq G_q_y :=
      hChartPbc q ι_y hι_y_hom X_y f_y ι_Xy hPb_y
    obtain ⟨H_η, hPB_Hη, -⟩ := hExPB_ex η G_q_y
    have hPB_η_Rq : WeilIsEtaleSheafPullback (η ≫ ι_y) Rq H_η :=
      (hCompPB_ex η ι_y Rq G_q_y H_η).1 hPB_Gqy hPB_Hη
    have hη_mem : (η ≫ ι_y).base (⊥ : PrimeSpectrum Ω) ∈ U_lc := by
      change ι_y.base (η.base (⊥ : PrimeSpectrum Ω)) ∈ U_lc
      rw [hη_bot]
      obtain ⟨u_pt, hu_pt⟩ := hU_lc_ne
      exact hMemOpenChartBot ι_y (U_lc : Set ↥D_bar.left) U_lc.isOpen ⟨u_pt, hu_pt⟩
    have hCard_Hη := (hGenStalkCard Ω (η ≫ ι_y) hη_mem H_η hPB_η_Rq).2
    obtain ⟨e_Hη⟩ := hStalkEvalAt U_line_ov X_y f_y Ω η H_η hPB_Hη
    have hCard_Xη : Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_y.left η) ℓ q) =
        Nat.card ↥B_gen :=
      (Nat.card_congr e_Hη.symm.toEquiv).trans hCard_Hη
    have hCard_Xs₀ :
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_y.left s₀) ℓ q) =
        Nat.card ↥B_gen :=
      (hOrigin X_y f_y hSing_y q hq).1.trans hCard_Xη
    obtain ⟨H_s, hPB_Hs0, -⟩ := hExPB_ex s₀ G_q_y
    have hPB_Hs : WeilIsEtaleSheafPullback y_bar Rq H_s := by
      rw [← hs₀_y]
      exact (hCompPB_ex s₀ ι_y Rq G_q_y H_s).1 hPB_Gqy hPB_Hs0
    have hPB_uK : WeilIsEtaleSheafPullback u_K H_s H_z :=
      (hCompPB_ex u_K y_bar Rq H_s H_z).2 hPB_Hs hPB_Hz
    have _ : HenselianLocalRing k := Field.henselian k
    have _ : IsSepClosed (IsLocalRing.ResidueField k) := hSepRes k
    obtain ⟨e_z_s⟩ :=
      (weil_strictly_henselian_spec_etale_eval_and_pullback k).2 K u_K
        (fun pt => Subsingleton.elim (u_K.base pt) (IsLocalRing.closedPoint k))
        H_s H_z hPB_uK
    obtain ⟨e_Hs_Xs₀⟩ := hStalkEvalAt U_line_ov X_y f_y k s₀ H_s hPB_Hs0
    let Z_y_left := CategoryTheory.Limits.pullback f_bar.left y_bar
    let fst_yb := CategoryTheory.Limits.pullback.fst f_bar.left y_bar
    let snd_yb := CategoryTheory.Limits.pullback.snd f_bar.left y_bar
    let hpb_yb := CategoryTheory.IsPullback.of_hasPullback f_bar.left y_bar
    have _ : AlgebraicGeometry.IsProper snd_yb :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_yb inferInstance
    let Z_y_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk snd_yb
    have _ : AlgebraicGeometry.IsProper Z_y_ov.hom := by
      change AlgebraicGeometry.IsProper snd_yb; infer_instance
    have hFin_Zyb : Finite (weilEtaleTorsionH Z_y_left ℓ q) :=
      hRatFiberFinite y_bar hy_bar Z_y_ov fst_yb hpb_yb
    have hpb_pasted : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_y.left s₀ ≫ ι_Xy)
        (CategoryTheory.Limits.pullback.snd f_y.left s₀) f_bar.left y_bar := by
      rw [← hs₀_y]
      exact (CategoryTheory.IsPullback.of_hasPullback f_y.left s₀).paste_horiz hPb_y
    obtain ⟨e_iso_Xs₀⟩ := hIsoH hpb_pasted.isoPullback q
    let e_tot_z : H_z.H 0 ≃+ weilEtaleTorsionH (CategoryTheory.Limits.pullback f_y.left s₀) ℓ q :=
      e_z_s.trans e_Hs_Xs₀
    have _ : Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_y.left s₀) ℓ q) :=
      Finite.of_equiv _ e_iso_Xs₀.symm.toEquiv
    exact ⟨Finite.of_equiv _ e_tot_z.symm.toEquiv,
      (Nat.card_congr e_tot_z.toEquiv).trans hCard_Xs₀⟩

  have hAllGeomStalkCard : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ D_bar.left)
      (H_z : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback z Rq H_z →
      Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) = Nat.card ↥B_gen := by
    intro K _ _ z H_z hPB_Hz
    obtain ⟨ι_z, hOpen_z, φ_z, hι_zhom, hφ_zfac⟩ := hStdChartOfSection K z
    have _ : AlgebraicGeometry.IsOpenImmersion ι_z := hOpen_z
    by_cases hker : RingHom.ker φ_z = ⊥
    · have hφ_bot : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_z)).base
          (⊥ : PrimeSpectrum K) = (⊥ : PrimeSpectrum (Polynomial k)) := by
        apply PrimeSpectrum.ext
        exact hker
      have hz_mem : z.base (⊥ : PrimeSpectrum K) ∈ U_lc := by
        rw [← hφ_zfac]
        change ι_z.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_z)).base
          (⊥ : PrimeSpectrum K)) ∈ U_lc
        rw [hφ_bot]
        obtain ⟨u_pt, hu_pt⟩ := hU_lc_ne
        exact hMemOpenChartBot ι_z (U_lc : Set ↥D_bar.left) U_lc.isOpen ⟨u_pt, hu_pt⟩
      exact hGenStalkCard K z hz_mem H_z hPB_Hz
    · obtain ⟨a, ha_fac⟩ := hPolyHomClosed K φ_z hker
      let u_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_z.comp Polynomial.C))
      let s_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_line :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))
      let y_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left := s_a ≫ ι_z
      have hy_bar : y_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        dsimp [y_bar, s_a, p_A1]
        rw [Category.assoc, hι_zhom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_evC : (Polynomial.evalRingHom a).comp Polynomial.C = RingHom.id k := by
          ext c; simp
        rw [h_evC, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      have hz_eq : u_K ≫ y_bar = z := by
        rw [← hφ_zfac, ha_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          Category.assoc]
      rw [← hz_eq] at hPB_Hz
      exact hClosedSecCard y_bar hy_bar K u_K H_z hPB_Hz

  
  constructor
  · refine ⟨B_gen, hFin_Bgen, fun x => ?_⟩
    let κ_x : Type u := ↥(D_bar.left.residueField x)
    let s_x : AlgebraicGeometry.Spec (CommRingCat.of κ_x) ⟶ D_bar.left :=
      D_bar.left.fromSpecResidueField x
    have hs_x_pt : s_x.base (⊥ : PrimeSpectrum κ_x) = x := by
      have hmem : s_x.base (⊥ : PrimeSpectrum κ_x) ∈ Set.range ⇑s_x.base := ⟨_, rfl⟩
      rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField, Set.mem_singleton_iff] at hmem
    obtain ⟨ι_x, hOpen_ιx, φ_x, hι_xhom, hφ_xfac⟩ := hStdChartOfSection κ_x s_x
    have _ : AlgebraicGeometry.IsOpenImmersion ι_x := hOpen_ιx
    let pt_x : ↥U_line :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_x)).base (⊥ : PrimeSpectrum κ_x)
    have hι_x_pt : ι_x.base pt_x = x := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_x) ≫ ι_x).base
        (⊥ : PrimeSpectrum κ_x) = x
      rw [hφ_xfac]
      exact hs_x_pt
    have hex_y : ∃ (y_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left),
        y_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
        (pt_x = (⊥ : PrimeSpectrum (Polynomial k)) ∨
          y_bar.base (⊥ : PrimeSpectrum k) = x) := by
      by_cases hbot : pt_x.asIdeal = ⊥
      · let y₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left := s₀ ≫ ι_x
        have hy₀ : y₀ ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
          dsimp [y₀, s₀, p_A1]
          rw [Category.assoc, hι_xhom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_evC : (Polynomial.evalRingHom (0 : k)).comp Polynomial.C = RingHom.id k := by
            ext c; simp
          rw [h_evC, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        exact ⟨y₀, hy₀, Or.inl (PrimeSpectrum.ext hbot)⟩
      · obtain ⟨a, ha_ker⟩ := hPolyPrime pt_x hbot
        let s_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_line :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))
        let y_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left := s_a ≫ ι_x
        have hy_a : y_a ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
          dsimp [y_a, s_a, p_A1]
          rw [Category.assoc, hι_xhom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_evC : (Polynomial.evalRingHom a).comp Polynomial.C = RingHom.id k := by
            ext c; simp
          rw [h_evC, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        have hpt_sa : s_a.base (⊥ : PrimeSpectrum k) = pt_x := by
          apply PrimeSpectrum.ext
          change Ideal.comap (Polynomial.evalRingHom a) ⊥ = pt_x.asIdeal
          exact ha_ker.symm
        refine ⟨y_a, hy_a, Or.inr ?_⟩
        change ι_x.base (s_a.base (⊥ : PrimeSpectrum k)) = x
        rw [hpt_sa, hι_x_pt]
    obtain ⟨y_bar, hy_bar, hx_cases⟩ := hex_y
    obtain ⟨ι_y, hOpen_y, X_y, f_y, hProp_fy, ι_Xy, hι_y_hom, hs₀_y, hPb_y, hSing_y⟩ :=
      weil_sing_dev_outer_locConst_geom_chart_dichotomy F m Z_tilde f₀ u₀ j_aff s_inf S_aff U₀
        h1d f_bar hPb_fbar e_P y_bar hy_bar
    have _ : AlgebraicGeometry.IsOpenImmersion ι_y := hOpen_y
    have _ : AlgebraicGeometry.IsProper f_y.left := hProp_fy
    let G_q_y := weilEtaleHigherDirectImage f_y.left q (weilEtaleTorsionSheaf X_y.left ℓ)
    have hPB_Gqy : WeilIsEtaleSheafPullback ι_y Rq G_q_y :=
      hChartPbc q ι_y hι_y_hom X_y f_y ι_Xy hPb_y
    let X_s₀ := CategoryTheory.Limits.pullback f_y.left s₀
    let M₀ : AddCommGrpCat.{u} := AddCommGrpCat.of (weilEtaleTorsionH X_s₀ ℓ q)
    obtain ⟨H_s₀_y, hPB_Hs₀y, -⟩ := hExPB_ex s₀ G_q_y
    have hPB_Hs₀y_Rq : WeilIsEtaleSheafPullback y_bar Rq H_s₀_y := by
      rw [← hs₀_y]
      exact (hCompPB_ex s₀ ι_y Rq G_q_y H_s₀_y).1 hPB_Gqy hPB_Hs₀y
    obtain ⟨hFin_Hs₀y, hCard_Hs₀y⟩ := hAllGeomStalkCard k y_bar H_s₀_y hPB_Hs₀y_Rq
    obtain ⟨e_Hs₀y_M0⟩ := hStalkEvalAt U_line_ov X_y f_y k s₀ H_s₀_y hPB_Hs₀y
    have hFin_M0 : Finite ↥M₀ := Finite.of_equiv _ e_Hs₀y_M0.toEquiv
    have _ : Finite ↥M₀ := hFin_M0
    have hCard_M0 : Nat.card ↥M₀ = Nat.card ↥B_gen :=
      (Nat.card_congr e_Hs₀y_M0.symm.toEquiv).trans hCard_Hs₀y
    obtain ⟨W₀, _, _, w₀, hEt_w₀, s_W, η_W, G_W, Φ, hs_W, hη_W, hDense_ηW, hPB_GW, hKer_ηW⟩ :=
      (hOrigin X_y f_y hSing_y q hq).2.1 hFin_M0
    have _ : AlgebraicGeometry.Etale w₀ := hEt_w₀
    let w : W₀ ⟶ D_bar.left := w₀ ≫ ι_y
    have hw_et : AlgebraicGeometry.Etale w := by dsimp [w]; infer_instance
    have hPB_w : WeilIsEtaleSheafPullback w Rq G_W :=
      (hCompPB_ex w₀ ι_y Rq G_q_y G_W).1 hPB_Gqy hPB_GW
    have hCard_W : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W₀)
        (H_z : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z G_W H_z →
        Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ Nat.card ↥M₀ := by
      intro K _ _ z H_z hPB_zG
      have hPB_zRq : WeilIsEtaleSheafPullback (z ≫ w) Rq H_z :=
        (hCompPB_ex z w Rq G_W H_z).1 hPB_w hPB_zG
      obtain ⟨hFin_Hz, hEq_Hz⟩ := hAllGeomStalkCard K (z ≫ w) H_z hPB_zRq
      exact ⟨hFin_Hz, le_of_eq (hEq_Hz.trans hCard_M0.symm)⟩
    have _ : CategoryTheory.IsIso Φ :=
      hPromoteIso W₀ Ω η_W hDense_ηW M₀ G_W Φ hKer_ηW hCard_W
    obtain ⟨e_MB⟩ := hTorsIsoBgen M₀ B_gen (hTorsH X_s₀) hTor_Bgen hCard_M0
    let C_W₀ := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
    have hPB_final : WeilIsEtaleSheafPullback w Rq (C_W₀.obj B_gen) :=
      hIsoPB_ex w Rq Rq G_W (C_W₀.obj B_gen) hPB_w ⟨CategoryTheory.Iso.refl Rq⟩
        ⟨(CategoryTheory.asIso Φ).symm ≪≫ C_W₀.mapIso e_MB⟩
    refine ⟨W₀, w, hw_et, ?_, hPB_final⟩
    rcases hx_cases with hpt_bot | hy_pt_x
    · refine ⟨η_W.base (⊥ : PrimeSpectrum Ω), ?_⟩
      change (η_W ≫ w₀ ≫ ι_y).base (⊥ : PrimeSpectrum Ω) = x
      rw [← Category.assoc η_W w₀, hη_W]
      change ι_y.base (η.base (⊥ : PrimeSpectrum Ω)) = x
      rw [hη_bot, hChartBotEq ι_y ι_x, ← hpt_bot, hι_x_pt]
    · refine ⟨s_W.base (⊥ : PrimeSpectrum k), ?_⟩
      change (s_W ≫ w₀ ≫ ι_y).base (⊥ : PrimeSpectrum k) = x
      rw [← Category.assoc s_W w₀, hs_W, hs₀_y]
      exact hy_pt_x
  · obtain ⟨x_ref⟩ : Nonempty ↥D_bar.left := inferInstance
