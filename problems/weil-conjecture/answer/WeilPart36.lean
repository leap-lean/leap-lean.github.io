        (f_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_U))
        (e'_Y : W' ⟶ Y) [AlgebraicGeometry.Etale e'_Y],
        e'_Y ≫ f_Y = q'_B ≫ e_B →
        let Y_R := CategoryTheory.Limits.pullback f_Y g_A
