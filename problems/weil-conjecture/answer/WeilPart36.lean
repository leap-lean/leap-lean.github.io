    let d : ↥W → Σ' (V_x : AlgebraicGeometry.Scheme.{u}), (V_x ⟶ W) :=
      fun a => Classical.choose (hPtCover a)
    have hd := fun a : ↥W => Classical.choose_spec (hPtCover a)
    refine ⟨↥W, fun a => (d a).1, fun a => (hd a).1, fun a => (d a).2, fun a => (hd a).2.1,
