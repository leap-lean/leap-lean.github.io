theorem weil_odp_pbc_eval_algClosed_sieve_lift_and_diagonal_zero (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ {S : AlgebraicGeometry.Scheme.{u}} (U : S.Etale)
        (R : CategoryTheory.Sieve U),
      R ∈ S.smallEtaleTopology U →
      ∀ (x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left),
        ∃ (V : S.Etale) (v : V ⟶ U)
          (x_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj V).left),
          R.arrows v ∧
          x_tilde ≫ ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left = x) ∧
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (hT_top : CategoryTheory.Limits.IsTerminal
          ((weilEtaleSitePullback Y.hom).obj
            (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k)))))
        (G : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ),
      Function.Injective
        (weilOuterTrFibEdgeHom Y.hom
          (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k)))
          hT_top G q)) ∧
    (∀ {Y₁ : AlgebraicGeometry.Scheme.{u}} (W : Y₁.Etale) (m q : ℕ)
        (β : weilEtaleTorsionH Y₁ m q)
        (p_W : weilEtaleTorsionH Y₁ m q →+
          weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget Y₁).obj W).left m q),
      let T_Y := weilEtaleIdTerminal.{u} Y₁
      let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y₁
      ((((weilEtaleTorsionSheaf Y₁ m).cohomologyPresheaf q).map
          (Opposite.op (hT_Y.from W))).hom
        (weilPolyP1CohomologyTermToPresheaf Y₁ T_Y hT_Y
          (weilEtaleTorsionSheaf Y₁ m) q β)) = 0 →
      WeilIsTorsionEtalePullback
        ((AlgebraicGeometry.Scheme.Etale.forget Y₁).obj W).hom m q p_W →
      p_W β = 0) :=
by
  classical
  
  have hLiftCov :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} (U : S.Etale)
        (R : CategoryTheory.Sieve U),
      R ∈ S.smallEtaleTopology U →
      ∀ (x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left),
        ∃ (V : S.Etale) (v : V ⟶ U)
          (x_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj V).left),
          R.arrows v ∧
          x_tilde ≫ ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left = x := by
    intro S U R hR x
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale.{u}
    letI : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative P_et).toIsStableUnderComposition
    have hTopEq : S.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S)).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S (le_refl P_et)
    have hR_pre : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S)).toGrothendieck U := by
      rwa [← hTopEq]
    obtain ⟨pt_k⟩ : Nonempty ↥S_k := inferInstance
    obtain ⟨V₀, v₀, y₀, hv₀_mem, hv₀_et, hy₀⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R).mp hR_pre (x.base pt_k)
    let v₀_left : ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₀).left ⟶
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left :=
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v₀).left
    haveI : AlgebraicGeometry.Etale v₀_left := hv₀_et
    let P := CategoryTheory.Limits.pullback v₀_left x
    let fst_P : P ⟶ ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₀).left :=
      CategoryTheory.Limits.pullback.fst v₀_left x
    let snd_P : P ⟶ S_k := CategoryTheory.Limits.pullback.snd v₀_left x
    have hpb_P : CategoryTheory.IsPullback fst_P snd_P v₀_left x :=
      CategoryTheory.IsPullback.of_hasPullback v₀_left x
    obtain ⟨p₀, _, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_P y₀ pt_k hy₀
    haveI : AlgebraicGeometry.Etale snd_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_P inferInstance
    obtain ⟨U_A, hAff, hp₀_mem, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := p₀) (U := (⊤ : P.Opens)) trivial
    let A_cat : CommRingCat.{u} := P.presheaf.obj (Opposite.op U_A)
    let A : Type u := ↑A_cat
    have hNonempty_SpecA : Nonempty ↥(AlgebraicGeometry.Spec A_cat) :=
      ⟨hAff.isoSpec.hom.base ⟨p₀, hp₀_mem⟩⟩
    have hNontriv_A : Nontrivial A :=
      PrimeSpectrum.nonempty_iff_nontrivial.mp hNonempty_SpecA
    let g_A : AlgebraicGeometry.Spec A_cat ⟶ S_k := hAff.fromSpec ≫ snd_P
    have hEt_gA : AlgebraicGeometry.Etale g_A := inferInstance
    let φ_kA : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage g_A
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_kA = g_A :=
      AlgebraicGeometry.Spec.map_preimage g_A
    have hEt_map : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_kA) := by
      rwa [hSpec_φ]
    have hEt_ring : RingHom.Etale φ_kA.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mp hEt_map
    letI : Algebra k A := φ_kA.hom.toAlgebra
    haveI : Algebra.Etale k A := RingHom.Etale.toAlgebra hEt_ring
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k A).mp inferInstance
    letI : Finite I := hFinI
    letI : ∀ i : I, Field (Ai i) := hFieldAi
    letI : ∀ i : I, Algebra k (Ai i) := hAlgAi
    have hNonemptyI : Nonempty I := by
      by_contra hEmpty
      haveI : IsEmpty I := not_nonempty_iff.mp hEmpty
      haveI : Subsingleton (∀ i : I, Ai i) := inferInstance
      haveI : Subsingleton A := e_prod.toEquiv.subsingleton
      exact false_of_nontrivial_of_subsingleton A
    obtain ⟨i₀⟩ := hNonemptyI
    haveI : Module.Finite k (Ai i₀) := (hFinSep i₀).1
    haveI : Algebra.IsIntegral k (Ai i₀) := Algebra.IsIntegral.of_finite k (Ai i₀)
    have hBij_i₀ : Function.Bijective (algebraMap k (Ai i₀)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_i₀ : k ≃ₐ[k] Ai i₀ := AlgEquiv.ofBijective (Algebra.ofId k (Ai i₀)) hBij_i₀
    let ε_alg : A →ₐ[k] k :=
      e_i₀.symm.toAlgHom.comp ((Pi.evalAlgHom k Ai i₀).comp e_prod.toAlgHom)
    have hε_comp : φ_kA ≫ CommRingCat.ofHom ε_alg.toRingHom = 𝟙 (CommRingCat.of k) := by
      ext c
      exact ε_alg.commutes c
    let σ_A : S_k ⟶ AlgebraicGeometry.Spec A_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_alg.toRingHom)
    have hσ_gA : σ_A ≫ g_A = 𝟙 S_k := by
      rw [← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp, hε_comp, AlgebraicGeometry.Spec.map_id]
    let x_tilde : S_k ⟶ ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₀).left :=
      σ_A ≫ hAff.fromSpec ≫ fst_P
    refine ⟨V₀, v₀, x_tilde, hv₀_mem, ?_⟩
    calc
      x_tilde ≫ v₀_left
          = σ_A ≫ hAff.fromSpec ≫ (fst_P ≫ v₀_left) := by simp only [x_tilde, Category.assoc]
      _ = σ_A ≫ hAff.fromSpec ≫ (snd_P ≫ x) := by rw [CategoryTheory.Limits.pullback.condition]
      _ = (σ_A ≫ g_A) ≫ x := by simp only [g_A, Category.assoc]
      _ = 𝟙 S_k ≫ x := by rw [hσ_gA]
      _ = x := Category.id_comp x

  
  have hRepHomNat :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} (V : Z.Etale)
        {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : G₁ ⟶ G₂)
        (α : weilPolyP1CohomologyRepSheaf Z V ⟶ G₁),
      weilPolyP1CohomologyRepHomEquiv Z V G₂ (α ≫ φ) =
        (φ.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V G₁ α) := by
    intro Z V G₁ G₂ φ α
    let J := Z.smallEtaleTopology
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let frAdj := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let F₀ := CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
    have hsh : shAdj.homEquiv F₀ G₂ (α ≫ φ) = shAdj.homEquiv F₀ G₁ α ≫ φ.hom :=
      shAdj.homEquiv_naturality_right α φ
    have hfr : frAdj.homEquiv (CategoryTheory.yoneda.obj V) G₂.obj
        (shAdj.homEquiv F₀ G₁ α ≫ φ.hom) =
        frAdj.homEquiv (CategoryTheory.yoneda.obj V) G₁.obj (shAdj.homEquiv F₀ G₁ α) ≫
          CategoryTheory.Functor.whiskerRight φ.hom (CategoryTheory.forget AddCommGrpCat.{u}) :=
      frAdj.homEquiv_naturality_right (shAdj.homEquiv F₀ G₁ α) φ.hom
    have hyon := CategoryTheory.yonedaEquiv_comp
      (frAdj.homEquiv (CategoryTheory.yoneda.obj V) G₁.obj (shAdj.homEquiv F₀ G₁ α))
      (CategoryTheory.Functor.whiskerRight φ.hom (CategoryTheory.forget AddCommGrpCat.{u}))
    exact (congrArg (fun x => CategoryTheory.yonedaEquiv
      (frAdj.homEquiv (CategoryTheory.yoneda.obj V) G₂.obj x)) hsh).trans
      ((congrArg CategoryTheory.yonedaEquiv hfr).trans hyon)

  have hTermBij :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (T : Z.Etale)
        (hT : CategoryTheory.Limits.IsTerminal T)
        (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Function.Bijective (weilPolyP1CohomologyTermToPresheaf Z T hT G q) := by
    intro Z T hT G q
    let J := Z.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let R_T := weilPolyP1CohomologyRepSheaf Z T
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let f : R_T ⟶ Fℤ := weilPolyP1CohomologyRepToConst Z T hT
    let ι_T : ↥(R_T.obj.obj (Opposite.op T)) :=
      weilPolyP1CohomologyRepHomEquiv Z T R_T (𝟙 R_T)
    let g₀ : Aℤ ⟶ R_T.obj.obj (Opposite.op T) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • ι_T
          map_zero' := zero_zsmul ι_T
          map_add' := fun a b => add_zsmul ι_T a.down b.down }
    let inv_rep : Fℤ ⟶ R_T := (adj_c.homEquiv Aℤ R_T).symm g₀
    have h_left : f ≫ inv_rep = 𝟙 R_T := by
      apply (weilPolyP1CohomologyRepHomEquiv Z T R_T).injective
      have h1 : weilPolyP1CohomologyRepHomEquiv Z T R_T (f ≫ inv_rep) =
          (inv_rep.hom.app (Opposite.op T)).hom
            (((adj_c.unit.app Aℤ).hom) (ULift.up (1 : ℤ))) :=
        (hRepHomNat T inv_rep f).trans
          (congrArg (inv_rep.hom.app (Opposite.op T)).hom
            ((weilPolyP1CohomologyRepHomEquiv Z T Fℤ).apply_symm_apply _))
      have hunit : adj_c.unit.app Aℤ ≫ inv_rep.hom.app (Opposite.op T) = g₀ :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_c Aℤ R_T inv_rep).symm.trans
          ((adj_c.homEquiv Aℤ R_T).apply_symm_apply g₀)
      have h2 : (inv_rep.hom.app (Opposite.op T)).hom
          (((adj_c.unit.app Aℤ).hom) (ULift.up (1 : ℤ))) = ι_T := by
        have happ := congrArg (fun m : Aℤ ⟶ R_T.obj.obj (Opposite.op T) =>
          m.hom (ULift.up (1 : ℤ))) hunit
        exact happ.trans (one_zsmul ι_T)
      exact h1.trans h2
    have h_right : inv_rep ≫ f = 𝟙 Fℤ := by
