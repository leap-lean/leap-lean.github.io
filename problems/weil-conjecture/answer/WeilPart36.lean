      CategoryTheory.Abelian.Ext.mk₀
        ((adj_j.homEquiv Fℤ_X F_U)
          (CategoryTheory.CategoryStruct.comp πℤ (CategoryTheory.Abelian.Ext.addEquiv₀ u)))
    have hLeft : Function.LeftInverse inv_leray₀ (leray_j 0) := by
      intro z
      let g : Fℤ_X ⟶ pf_j.obj F_U := CategoryTheory.Abelian.Ext.addEquiv₀ z
      have hz : CategoryTheory.Abelian.Ext.mk₀ g = z :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z
      have hl : leray_j 0 z =
          CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X F_U).symm g)) :=
        (congrArg (leray_j 0) hz.symm).trans (hLeray0_mk₀ g)
      have ha : CategoryTheory.Abelian.Ext.addEquiv₀ (leray_j 0 z) =
          CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X F_U).symm g) := by
        rw [hl, ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply _
      have hm : CategoryTheory.CategoryStruct.comp πℤ
          (CategoryTheory.Abelian.Ext.addEquiv₀ (leray_j 0 z)) =
          (adj_j.homEquiv Fℤ_X F_U).symm g := by
        rw [ha, ← CategoryTheory.Category.assoc, hπι, CategoryTheory.Category.id_comp]
      have heq : (adj_j.homEquiv Fℤ_X F_U)
          (CategoryTheory.CategoryStruct.comp πℤ
            (CategoryTheory.Abelian.Ext.addEquiv₀ (leray_j 0 z))) = g :=
