      rfl
    have hvan_all : ∀ {W'' : D_bar.left.Etale} (g : W'' ⟶ W') (a : ↥Aℤ),
        (φ.hom.app (Opposite.op W'')).hom
          (((η_ℤ.app (Opposite.op W'')).hom a : ↥(Fℤ.obj.obj (Opposite.op W'')))) = 0 := by
      intro W'' g a
      let η_hom : ↥Aℤ →+ ↥(Fℤ.obj.obj (Opposite.op W'')) := (η_ℤ.app (Opposite.op W'')).hom
      let φ_hom : ↥(Fℤ.obj.obj (Opposite.op W'')) →+ ↥(ℛ_bar.obj.obj (Opposite.op W'')) :=
        (φ.hom.app (Opposite.op W'')).hom
      change φ_hom (η_hom a) = 0
      have ha : a = a.down • ULift.up (1 : ℤ) := by
        apply ULift.ext
        change a.down = a.down • (1 : ℤ)
        simp
      have h1 : φ_hom (η_hom (ULift.up (1 : ℤ))) = 0 := by
        have hnat_η : η_hom (ULift.up (1 : ℤ)) =
            (Fℤ.obj.map (Opposite.op (hT_D.from W''))).hom
              (((η_ℤ.app (Opposite.op T_D)).hom (ULift.up 1) :
                ↥(Fℤ.obj.obj (Opposite.op T_D)))) := by
          have hn := congrArg (fun f => f.hom (ULift.up (1 : ℤ)))
            (η_ℤ.naturality (Opposite.op (hT_D.from W'')))
          dsimp [Pℤ] at hn
          exact hn
        have hnat_φ : φ_hom ((Fℤ.obj.map (Opposite.op (hT_D.from W''))).hom
            (((η_ℤ.app (Opposite.op T_D)).hom (ULift.up 1) :
              ↥(Fℤ.obj.obj (Opposite.op T_D))))) =
            (ℛ_bar.obj.map (Opposite.op (hT_D.from W''))).hom (σ_hom η') := by
          rw [hσ_Eq]
          exact congrArg (fun f => f.hom (((η_ℤ.app (Opposite.op T_D)).hom (ULift.up 1) :
              ↥(Fℤ.obj.obj (Opposite.op T_D)))))
            (φ.hom.naturality (Opposite.op (hT_D.from W'')))
        have hfrom : hT_D.from W'' = (g ≫ v') ≫ hT_D.from W_s := hT_D.hom_ext _ _
        have hmap_σ : (ℛ_bar.obj.map (Opposite.op (hT_D.from W''))).hom (σ_hom η') = 0 := by
          have hcomp := ℛ_bar.obj.map_comp (hT_D.from W_s).op (g ≫ v').op
          have heq := congrArg (fun f => f.hom (σ_hom η'))
            ((congrArg ℛ_bar.obj.map (congrArg Opposite.op hfrom)).trans hcomp)
          exact heq.trans ((congrArg (ℛ_bar.obj.map (Opposite.op (g ≫ v'))).hom hσ_Ws_zero).trans
            (map_zero _))
        exact (congrArg φ_hom hnat_η).trans (hnat_φ.trans hmap_σ)
      rw [ha, map_zsmul, map_zsmul, h1, smul_zero]
    have : CategoryTheory.Presheaf.IsLocallySurjective J_D η_ℤ :=
      CategoryTheory.GrothendieckTopology.instIsLocallySurjectiveToSheafify Pℤ
    apply AddCommGrpCat.ext
    intro x
    let y : ↥(ℛ_bar.obj.obj (Opposite.op W')) := (φ.hom.app (Opposite.op W')).hom x
    change y = 0
    have hSep := ℛ_bar.property Aℤ (CategoryTheory.Presheaf.imageSieve η_ℤ x)
      (CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem (f := η_ℤ) x)
    let c_hom : Aℤ ⟶ ℛ_bar.obj.obj (Opposite.op W') :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • y
          map_zero' := zero_zsmul y
          map_add' := fun a b => add_zsmul y a.down b.down }
    have hc_zero : c_hom = 0 := by
      apply hSep.isSeparatedFor.ext
      intro W'' g hg
      obtain ⟨a, ha⟩ := hg
      change c_hom ≫ ℛ_bar.obj.map (Opposite.op g) = 0 ≫ ℛ_bar.obj.map (Opposite.op g)
      rw [CategoryTheory.Limits.zero_comp]
      apply AddCommGrpCat.ext
      intro n
      change (ℛ_bar.obj.map (Opposite.op g)).hom (n.down • y) = 0
      have hy_g : (ℛ_bar.obj.map (Opposite.op g)).hom y = 0 := by
        have hnat_g : (ℛ_bar.obj.map (Opposite.op g)).hom y =
            (φ.hom.app (Opposite.op W'')).hom ((Fℤ.obj.map (Opposite.op g)).hom x) :=
          congrArg (fun f => f.hom x) (φ.hom.naturality (Opposite.op g)).symm
        have hax : ((η_ℤ.app (Opposite.op W'')).hom a : ↥(Fℤ.obj.obj (Opposite.op W''))) =
            (Fℤ.obj.map (Opposite.op g)).hom x := ha
        exact hnat_g.trans ((congrArg (φ.hom.app (Opposite.op W'')).hom hax.symm).trans
          (hvan_all g a))
      rw [map_zsmul, hy_g, smul_zero]
    have h1 := congrArg
      (fun f : Aℤ ⟶ ℛ_bar.obj.obj (Opposite.op W') => f.hom (ULift.up (1 : ℤ))) hc_zero
    simpa [c_hom] using h1

  · 
    intro ξ' W_et s_tilde hs_tilde z₀ hz₀ ι hι_fst hι_snd p_ι hp_ι
    have hι_eq : ι = ι_can W_et s_tilde hs_tilde := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact hι_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact hι_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    have hp_can : WeilIsTorsionEtalePullback (ι_can W_et s_tilde hs_tilde) n_mod q_deg p_ι := by
      rwa [← hι_eq]
    have hval : HasEvalVal ξ' (p_ι (Θ_Z (B_fbar.obj W_et) z₀)) :=
      ⟨W_et, s_tilde, hs_tilde, z₀, p_ι, hz₀, hp_can, rfl⟩
    exact hUniqEval ξ' (hev_spec ξ') hval

