        have : CategoryTheory.IsIso (bc p SC.X₃) := ih p
        have : CategoryTheory.IsIso (bc (p + 2) SC.X₁) := hModPrime (p + 2)
        exact hFive t₀ t₁ t₂ t₃ b₀ b₁ b₂ b₃
          wt₀₁ ht₀₁ wt₁₂ ht₁₂ wt₂₃ ht₂₃
          h0₃'_p hEx₃'_p h0₁'_s hEx₁'_s h0₂'_s hEx₂'_s
          (bc p SC.X₃) (bc (p + 1) SC.X₁) (bc (p + 1) SC.X₂) (bc (p + 1) SC.X₃) (bc (p + 2) SC.X₁)
          hComm_p (hNat (p + 1) SC.f) (hNat (p + 1) SC.g) hComm_s
