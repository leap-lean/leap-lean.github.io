    (hH2_D : Nat.card (weilEtaleTorsionH (weilGeomScheme F (weilProjectiveSpaceOver F 1)) ℓ 2) = ℓ)
    (hFrobTopP1 : ∀ (r : ℕ)
      (f_top : weilEtaleTorsionH (weilGeomScheme F (weilProjectiveSpaceOver F 1)) (ℓ ^ r) 2 →+
        weilEtaleTorsionH (weilGeomScheme F (weilProjectiveSpaceOver F 1)) (ℓ ^ r) 2),
      WeilIsTorsionGeomFrobAction F (weilProjectiveSpaceOver F 1) (ℓ ^ r) 2 f_top →
      ∀ w : weilEtaleTorsionH (weilGeomScheme F (weilProjectiveSpaceOver F 1)) (ℓ ^ r) 2,
        f_top w = (Nat.card F) • w)
    (hCont_pr :
      (weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).IsContinuous
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology)
    (hAdj_pr :
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback
          (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
        AddCommGrpCat.{u} _
        (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
        (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology hCont_pr).IsRightAdjoint)
    (ℳ₀ : ℕ → CategoryTheory.Sheaf
      (weilProjectiveSpaceOver F 1).left.smallEtaleTopology AddCommGrpCat.{u})
    (ℳ_bar : ℕ → CategoryTheory.Sheaf
      (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology AddCommGrpCat.{u})
    (τ_bar : ∀ r : ℕ, Quiver.Hom (ℳ_bar (r + 1)) (ℳ_bar r))
    (iso_bar : ∀ r : ℕ,
      CategoryTheory.Iso
        ((@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver F 1).hom
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          AddCommGrpCat.{u} _
          (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          hCont_pr hAdj_pr).obj (ℳ₀ r))
        (ℳ_bar r))
    (frob_E2 : ∀ r : ℕ, (ℳ_bar r).H 2 →+ (ℳ_bar r).H 2)
    (hfrob_E2 : ∀ r : ℕ,
      WeilTransvTriIsGeomBaseSheafAction F (weilProjectiveSpaceOver F 1)
        (ℳ₀ r) (ℳ_bar r) hCont_pr hAdj_pr (iso_bar r) 2 (frob_E2 r))
    (hTor_M : ∀ r : ℕ, (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (ℳ_bar r) = 0)
    (hConst_M : ∀ (r : ℕ)
      (T : (weilGeomScheme F (weilProjectiveSpaceOver F 1)).Etale)
      (hT : CategoryTheory.Limits.IsTerminal T),
      Finite ↥((ℳ_bar r).obj.obj (Opposite.op T)) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
          AddCommGrpCat.{u} hT).counit.app (ℳ_bar r))) :
    ∃ (frob_H0 : ∀ r : ℕ, (ℳ_bar r).H 0 →+ (ℳ_bar r).H 0)
      (Ψ : ∀ r : ℕ, (ℳ_bar r).H 0 →+ (ℳ_bar r).H 2),
      (∀ r : ℕ,
        WeilTransvTriIsGeomBaseSheafAction F (weilProjectiveSpaceOver F 1)
          (ℳ₀ r) (ℳ_bar r) hCont_pr hAdj_pr (iso_bar r) 0 (frob_H0 r)) ∧
      (∀ r : ℕ, Function.Bijective (Ψ r)) ∧
      (∀ (r : ℕ) (u : (ℳ_bar (r + 1)).H 0),
        (CategoryTheory.Abelian.Ext.mk₀ (τ_bar r)).postcomp
          ((CategoryTheory.constantSheaf
            (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Nat.add_zero 2) (Ψ (r + 1) u) =
        Ψ r ((CategoryTheory.Abelian.Ext.mk₀ (τ_bar r)).postcomp
          ((CategoryTheory.constantSheaf
            (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Nat.add_zero 0) u)) ∧
      (∀ (r : ℕ) (u : (ℳ_bar r).H 0),
        frob_E2 r (Ψ r u) = (Nat.card F) • Ψ r (frob_H0 r u)) :=
by
  let D₀ := weilProjectiveSpaceOver F 1
  let S := weilGeomScheme F D₀
  let g : S ⟶ S := weilGeomFrobHom F D₀
  let J := S.smallEtaleTopology
  let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ := C.obj Aℤ
  let U := AddCommGrpCat.uliftFunctor.{u, 0}
  let AM : ℕ → AddCommGrpCat.{u} := fun n => U.obj (AddCommGrpCat.of (ZMod n))
  let FM : ℕ → CategoryTheory.Sheaf J AddCommGrpCat.{u} := fun n => weilEtaleTorsionSheaf S n
  have hPrime : Nat.Prime ℓ := Fact.out
  have _ : C.Additive := by dsimp only [C]; unfold CategoryTheory.constantSheaf; infer_instance
  have _ : CategoryTheory.Limits.PreservesFiniteLimits C := by
    dsimp only [C]; unfold CategoryTheory.constantSheaf; infer_instance
  have _ : CategoryTheory.Limits.PreservesFiniteColimits C := by
    dsimp only [C]; unfold CategoryTheory.constantSheaf; infer_instance

  
  have hIsIso_g : CategoryTheory.IsIso g := by
    let ψ := (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
      (AlgebraicClosure F) _ _ _).symm
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
    let i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
    let i₂_inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.symm.toRingHom)
    have hi_hom_inv : i₂ ≫ i₂_inv = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h1 : ψ.toRingHom.comp ψ.symm.toRingHom = RingHom.id _ :=
        RingHom.ext ψ.apply_symm_apply
      rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have hi_inv_hom : i₂_inv ≫ i₂ = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h1 : ψ.symm.toRingHom.comp ψ.toRingHom = RingHom.id _ :=
        RingHom.ext ψ.symm_apply_apply
      rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have hcomp_inv : CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
        (CommRingCat.ofHom ψ.symm.toRingHom) =
        CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)) :=
      (CommRingCat.ofHom_comp _ _).symm.trans
        (congrArg CommRingCat.ofHom (RingHom.ext ψ.symm.commutes))
    let g_hom : Limits.pullback D₀.hom f₂ ⟶ Limits.pullback D₀.hom f₂ := weilGeomFrobHom F D₀
    let g_inv : Limits.pullback D₀.hom f₂ ⟶ Limits.pullback D₀.hom f₂ :=
      CategoryTheory.Limits.pullback.map D₀.hom f₂ D₀.hom f₂
        (CategoryTheory.CategoryStruct.id D₀.left) i₂_inv
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of F)))
        ((CategoryTheory.Category.comp_id D₀.hom).trans (CategoryTheory.Category.id_comp D₀.hom).symm)
        ((CategoryTheory.Category.comp_id f₂).trans
          ((congrArg AlgebraicGeometry.Spec.map hcomp_inv.symm).trans
            (AlgebraicGeometry.Spec.map_comp _ _)))
    change CategoryTheory.IsIso g_hom
    refine ⟨⟨g_inv, ?_, ?_⟩⟩
    · apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [g_hom, weilGeomFrobHom, g_inv]
        rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
          Category.comp_id, Category.comp_id, Category.id_comp]
      · dsimp only [g_hom, weilGeomFrobHom, g_inv]
        change (Limits.pullback.map D₀.hom f₂ D₀.hom f₂ (𝟙 D₀.left) i₂ (𝟙 _) _ _ ≫
            Limits.pullback.map D₀.hom f₂ D₀.hom f₂ (𝟙 D₀.left) i₂_inv (𝟙 _) _ _) ≫
          Limits.pullback.snd D₀.hom f₂ = 𝟙 _ ≫ Limits.pullback.snd D₀.hom f₂
        rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
          Category.assoc, hi_hom_inv, Category.comp_id, Category.id_comp]
    · apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [g_hom, weilGeomFrobHom, g_inv]
        rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
          Category.comp_id, Category.comp_id, Category.id_comp]
      · dsimp only [g_hom, weilGeomFrobHom, g_inv]
        change (Limits.pullback.map D₀.hom f₂ D₀.hom f₂ (𝟙 D₀.left) i₂_inv (𝟙 _) _ _ ≫
            Limits.pullback.map D₀.hom f₂ D₀.hom f₂ (𝟙 D₀.left) i₂ (𝟙 _) _ _) ≫
          Limits.pullback.snd D₀.hom f₂ = 𝟙 _ ≫ Limits.pullback.snd D₀.hom f₂
        rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
          Category.assoc, hi_inv_hom, Category.comp_id, Category.id_comp]

  
  have hAlphaM_inv :
      ∀ (G : CategoryTheory.Functor S.Etale S.Etale)
        (hG_obj : ∀ U_et : S.Etale,
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj (G.obj U_et)).left =
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj U_et).left ∧
          HEq ((AlgebraicGeometry.Scheme.Etale.forget S).obj (G.obj U_et)).hom
            (CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget S).obj U_et).hom g))
        (hG_map : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
          HEq ((AlgebraicGeometry.Scheme.Etale.forget S).map (G.map u)).left
            ((AlgebraicGeometry.Scheme.Etale.forget S).map u).left)
        (hCont_G : G.IsContinuous J J)
        (hAdd_P : (letI := hCont_G; G.sheafPushforwardContinuous AddCommGrpCat.{u} J J).Additive)
        (hLim_P : CategoryTheory.Limits.PreservesFiniteLimits
          (letI := hCont_G; G.sheafPushforwardContinuous AddCommGrpCat.{u} J J))
        (hColim_P : CategoryTheory.Limits.PreservesFiniteColimits
          (letI := hCont_G; G.sheafPushforwardContinuous AddCommGrpCat.{u} J J))
        (T : S.Etale) (hT : CategoryTheory.Limits.IsTerminal T)
        (μ : G.obj T ⟶ T)
        (A : AddCommGrpCat.{u})
        (q_A : Aℤ ⟶ A)
        (_ : CategoryTheory.Epi (C.map q_A))
        (ℱ_bar : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (β_bar : (letI := hCont_G; G.sheafPushforwardContinuous AddCommGrpCat.{u} J J).obj ℱ_bar ⟶
          ℱ_bar),
        letI := hCont_G
        let P := G.sheafPushforwardContinuous AddCommGrpCat.{u} J J
        let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
        let αℤ : Fℤ ⟶ P.obj Fℤ :=
          (adj.homEquiv Aℤ (P.obj Fℤ)).symm (adj.unit.app Aℤ ≫ Fℤ.obj.map (Opposite.op μ))
        let αM : C.obj A ⟶ P.obj (C.obj A) :=
          (adj.homEquiv A (P.obj (C.obj A))).symm
            (adj.unit.app A ≫ (C.obj A).obj.map (Opposite.op μ))
        ∃ (βM : P.obj (C.obj A) ⟶ C.obj A),
          αM ≫ βM = 𝟙 (C.obj A) ∧
          βM ≫ αM = 𝟙 (P.obj (C.obj A)) ∧
          (∀ (ω_m : (C.obj A).H 2) (u : ℱ_bar.H 0) (u_tilde fu_tilde : C.obj A ⟶ ℱ_bar),
            (CategoryTheory.Abelian.Ext.mk₀ βM).postcomp Fℤ (Nat.add_zero 2)
              ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P
                  hAdd_P hLim_P hColim_P _ _ Fℤ (C.obj A) 2) ω_m)
                (Nat.zero_add 2)) = (Nat.card F) • ω_m →
            C.map q_A ≫ u_tilde = CategoryTheory.Abelian.Ext.addEquiv₀ u →
            C.map q_A ≫ fu_tilde = CategoryTheory.Abelian.Ext.addEquiv₀
              ((CategoryTheory.Abelian.Ext.mk₀ β_bar).postcomp Fℤ (Nat.add_zero 0)
                ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
                  ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P
                    hAdd_P hLim_P hColim_P _ _ Fℤ ℱ_bar 0) u)
                  (Nat.zero_add 0))) →
            (CategoryTheory.Abelian.Ext.mk₀ β_bar).postcomp Fℤ (Nat.add_zero 2)
              ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P
                  hAdd_P hLim_P hColim_P _ _ Fℤ ℱ_bar 2)
                  ((CategoryTheory.Abelian.Ext.mk₀ u_tilde).postcomp Fℤ (Nat.add_zero 2) ω_m))
                (Nat.zero_add 2)) =
              (Nat.card F) •
                ((CategoryTheory.Abelian.Ext.mk₀ fu_tilde).postcomp Fℤ (Nat.add_zero 2) ω_m)) := by
    intro G hG_obj hG_map hCont_G hAdd_P hLim_P hColim_P T hT μ A q_A hEpi_q ℱ_bar β_bar
    let _ := hIsIso_g
    let _ := hCont_G
    let _ : (weilEtaleSitePullback g).IsContinuous J J := (sys g).hCont
    let F_A := C.obj A
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    let B_g := weilEtaleSitePullback g
    let P := G.sheafPushforwardContinuous AddCommGrpCat.{u} J J
    let P_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} J J
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT

    have hEqHomObj : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (hXY : X = Y)
        (f_X : X ⟶ S) (f_Y : Y ⟶ S),
        HEq f_X (f_Y ≫ g) → eqToHom hXY.symm ≫ f_X = f_Y ≫ g := by
      intro X Y hXY f_X f_Y hheq
      subst hXY
      rw [eq_of_heq hheq, eqToHom_refl, Category.id_comp]

    have hEqHomObj' : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (hXY : X = Y)
        (f_X : X ⟶ S) (f_Y : Y ⟶ S),
        HEq f_X (f_Y ≫ g) → eqToHom hXY ≫ f_Y = f_X ≫ CategoryTheory.inv g := by
      intro X Y hXY f_X f_Y hheq
      subst hXY
      rw [eq_of_heq hheq, eqToHom_refl, Category.id_comp, Category.assoc,
        CategoryTheory.IsIso.hom_inv_id, Category.comp_id]

    have hEqMapLeft : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
        ((Fgt.map (G.map u)).left) ≫ eqToHom (hG_obj U₂).1 =
          eqToHom (hG_obj U₁).1 ≫ (Fgt.map u).left := by
      intro U₁ U₂ u
      have hconj := (CategoryTheory.conj_eqToHom_iff_heq
        ((Fgt.map (G.map u)).left) ((Fgt.map u).left) (hG_obj U₁).1 (hG_obj U₂).1).mpr (hG_map u)
      have h1 := congrArg (· ≫ eqToHom (hG_obj U₂).1) hconj
      change ((Fgt.map (G.map u)).left) ≫ eqToHom (hG_obj U₂).1 =
        (eqToHom (hG_obj U₁).1 ≫ (Fgt.map u).left ≫ eqToHom ((hG_obj U₂).1).symm) ≫
          eqToHom (hG_obj U₂).1 at h1
      rw [Category.assoc, Category.assoc, eqToHom_trans, eqToHom_refl, Category.comp_id] at h1
      exact h1

    have hEqMapLeftSymm : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
        (Fgt.map u).left ≫ eqToHom ((hG_obj U₂).1).symm =
          eqToHom ((hG_obj U₁).1).symm ≫ (Fgt.map (G.map u)).left := by
      intro U₁ U₂ u
      have hm := hEqMapLeft u
      calc (Fgt.map u).left ≫ eqToHom ((hG_obj U₂).1).symm
          = (eqToHom ((hG_obj U₁).1).symm ≫ eqToHom (hG_obj U₁).1) ≫
              (Fgt.map u).left ≫ eqToHom ((hG_obj U₂).1).symm := by
                rw [eqToHom_trans, eqToHom_refl, Category.id_comp]
        _ = eqToHom ((hG_obj U₁).1).symm ≫
              (eqToHom (hG_obj U₁).1 ≫ (Fgt.map u).left) ≫ eqToHom ((hG_obj U₂).1).symm := by
                simp only [Category.assoc]
        _ = eqToHom ((hG_obj U₁).1).symm ≫
              ((Fgt.map (G.map u)).left ≫ eqToHom (hG_obj U₂).1) ≫ eqToHom ((hG_obj U₂).1).symm := by
                rw [← hm]
        _ = eqToHom ((hG_obj U₁).1).symm ≫ (Fgt.map (G.map u)).left := by
                rw [Category.assoc ((Fgt.map (G.map u)).left), eqToHom_trans, eqToHom_refl,
                  Category.comp_id]

    have hd₁_sq : ∀ U_et : S.Etale,
        eqToHom ((hG_obj U_et).1).symm ≫ (Fgt.obj (G.obj U_et)).hom = (Fgt.obj U_et).hom ≫ g :=
      fun U_et => hEqHomObj (hG_obj U_et).1 (Fgt.obj (G.obj U_et)).hom (Fgt.obj U_et).hom (hG_obj U_et).2

    let d₁_left : ∀ U_et : S.Etale,
        (Fgt.obj U_et).left ⟶ Limits.pullback (Fgt.obj (G.obj U_et)).hom g :=
      fun U_et => Limits.pullback.lift (eqToHom ((hG_obj U_et).1).symm) (Fgt.obj U_et).hom (hd₁_sq U_et)

    let d₁_hom : ∀ U_et : S.Etale, U_et ⟶ B_g.obj (G.obj U_et) := fun U_et =>
      CategoryTheory.MorphismProperty.Over.homMk (d₁_left U_et)
        (Limits.pullback.lift_snd (eqToHom ((hG_obj U_et).1).symm) (Fgt.obj U_et).hom (hd₁_sq U_et))

    have hd₁_nat : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
        u ≫ d₁_hom U₂ = d₁_hom U₁ ≫ B_g.map (G.map u) := by
      intro U₁ U₂ u
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      let m_bg : Limits.pullback (Fgt.obj (G.obj U₁)).hom g ⟶
          Limits.pullback (Fgt.obj (G.obj U₂)).hom g :=
        (Fgt.map (B_g.map (G.map u))).left
      have hm_fst : m_bg ≫ Limits.pullback.fst (Fgt.obj (G.obj U₂)).hom g =
          Limits.pullback.fst (Fgt.obj (G.obj U₁)).hom g ≫ (Fgt.map (G.map u)).left :=
        Limits.pullback.lift_fst _ _ _
      have hm_snd : m_bg ≫ Limits.pullback.snd (Fgt.obj (G.obj U₂)).hom g =
          Limits.pullback.snd (Fgt.obj (G.obj U₁)).hom g :=
        Limits.pullback.lift_snd _ _ _
      change (Fgt.map u).left ≫ d₁_left U₂ = d₁_left U₁ ≫ m_bg
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.assoc, hm_fst,
          ← Category.assoc, Limits.pullback.lift_fst]
        exact hEqMapLeftSymm u
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.assoc, hm_snd,
          Limits.pullback.lift_snd]
        exact (Fgt.map u).w

    let fst_iso : ∀ U_et : S.Etale, Limits.pullback (Fgt.obj U_et).hom g ≅ (Fgt.obj U_et).left :=
      fun U_et =>
        @CategoryTheory.asIso _ _ _ _ (Limits.pullback.fst (Fgt.obj U_et).hom g)
          (CategoryTheory.IsPullback.isIso_fst_of_isIso
            (CategoryTheory.IsPullback.of_hasPullback (Fgt.obj U_et).hom g))

    let eq_BG_iso : ∀ U_et : S.Etale,
        (Fgt.obj (G.obj (B_g.obj U_et))).left ≅ Limits.pullback (Fgt.obj U_et).hom g :=
      fun U_et => eqToIso (hG_obj (B_g.obj U_et)).1

    let d₂_left_iso : ∀ U_et : S.Etale,
        (Fgt.obj (G.obj (B_g.obj U_et))).left ≅ (Fgt.obj U_et).left :=
      fun U_et => eq_BG_iso U_et ≪≫ fst_iso U_et

    have hd₂_hom_w : ∀ U_et : S.Etale,
        (d₂_left_iso U_et).hom ≫ (Fgt.obj U_et).hom = (Fgt.obj (G.obj (B_g.obj U_et))).hom := by
      intro U_et
      let snd_U : Limits.pullback (Fgt.obj U_et).hom g ⟶ S :=
        Limits.pullback.snd (Fgt.obj U_et).hom g
      have h1 : (eq_BG_iso U_et).hom ≫ snd_U =
          (Fgt.obj (G.obj (B_g.obj U_et))).hom ≫ CategoryTheory.inv g :=
        hEqHomObj' (hG_obj (B_g.obj U_et)).1 (Fgt.obj (G.obj (B_g.obj U_et))).hom
          (Fgt.obj (B_g.obj U_et)).hom (hG_obj (B_g.obj U_et)).2
      have hcond : (fst_iso U_et).hom ≫ (Fgt.obj U_et).hom = snd_U ≫ g :=
        Limits.pullback.condition
      change ((eq_BG_iso U_et).hom ≫ (fst_iso U_et).hom) ≫ (Fgt.obj U_et).hom =
        (Fgt.obj (G.obj (B_g.obj U_et))).hom
      rw [Category.assoc, hcond, ← Category.assoc, h1, Category.assoc,
        CategoryTheory.IsIso.inv_hom_id, Category.comp_id]

    have hd₂_inv_w : ∀ U_et : S.Etale,
        (d₂_left_iso U_et).inv ≫ (Fgt.obj (G.obj (B_g.obj U_et))).hom = (Fgt.obj U_et).hom := by
      intro U_et
      rw [← hd₂_hom_w U_et, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]

    let d₂_inv : ∀ U_et : S.Etale, U_et ⟶ G.obj (B_g.obj U_et) := fun U_et =>
      CategoryTheory.MorphismProperty.Over.homMk (d₂_left_iso U_et).inv (hd₂_inv_w U_et)

    have hd₂_inv_nat : ∀ {U₁ U₂ : S.Etale} (u : U₁ ⟶ U₂),
        u ≫ d₂_inv U₂ = d₂_inv U₁ ≫ G.map (B_g.map u) := by
      intro U₁ U₂ u
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply (CategoryTheory.cancel_mono (d₂_left_iso U₂).hom).mp
      change ((Fgt.map u).left ≫ (d₂_left_iso U₂).inv) ≫ (d₂_left_iso U₂).hom =
        ((d₂_left_iso U₁).inv ≫ (Fgt.map (G.map (B_g.map u))).left) ≫ (d₂_left_iso U₂).hom
      rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      have hbg_fst : ((Fgt.map (B_g.map u)).left :
            Limits.pullback (Fgt.obj U₁).hom g ⟶ Limits.pullback (Fgt.obj U₂).hom g) ≫
          (fst_iso U₂).hom = (fst_iso U₁).hom ≫ (Fgt.map u).left :=
        Limits.pullback.lift_fst _ _ _
      have hm : (Fgt.map (G.map (B_g.map u))).left ≫ (eq_BG_iso U₂).hom =
          (eq_BG_iso U₁).hom ≫ (Fgt.map (B_g.map u)).left :=
        hEqMapLeft (B_g.map u)
      have hstep : (Fgt.map (G.map (B_g.map u))).left ≫ (d₂_left_iso U₂).hom =
          (d₂_left_iso U₁).hom ≫ (Fgt.map u).left := by
        change (Fgt.map (G.map (B_g.map u))).left ≫ ((eq_BG_iso U₂).hom ≫ (fst_iso U₂).hom) =
          ((eq_BG_iso U₁).hom ≫ (fst_iso U₁).hom) ≫ (Fgt.map u).left
        rw [← Category.assoc, hm, Category.assoc]
        exact congrArg ((eq_BG_iso U₁).hom ≫ ·) hbg_fst
      rw [Category.assoc, hstep, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]

    have hTri : ∀ U_et : S.Etale, G.map (d₁_hom U_et) = d₂_inv (G.obj U_et) := by
      intro U_et
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply (CategoryTheory.cancel_mono (d₂_left_iso (G.obj U_et)).hom).mp
      change (Fgt.map (G.map (d₁_hom U_et))).left ≫ (d₂_left_iso (G.obj U_et)).hom =
        (d₂_left_iso (G.obj U_et)).inv ≫ (d₂_left_iso (G.obj U_et)).hom
      rw [Iso.inv_hom_id]
      have hm : (Fgt.map (G.map (d₁_hom U_et))).left ≫ (eq_BG_iso (G.obj U_et)).hom =
          eqToHom (hG_obj U_et).1 ≫ d₁_left U_et :=
        hEqMapLeft (d₁_hom U_et)
      have hd₁_fst : d₁_left U_et ≫ (fst_iso (G.obj U_et)).hom = eqToHom ((hG_obj U_et).1).symm :=
        Limits.pullback.lift_fst _ _ _
      change (Fgt.map (G.map (d₁_hom U_et))).left ≫
        ((eq_BG_iso (G.obj U_et)).hom ≫ (fst_iso (G.obj U_et)).hom) =
        𝟙 (Fgt.obj (G.obj U_et)).left
      rw [← Category.assoc, hm, Category.assoc, hd₁_fst, eqToHom_trans, eqToHom_refl]

    let ε_Pg : ∀ ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}, P.obj (P_g.obj ℱ) ⟶ ℱ := fun ℱ =>
      { hom :=
        { app := fun U_op => ℱ.obj.map (Opposite.op (d₁_hom (Opposite.unop U_op)))
          naturality := fun {U₁ U₂} u => by
            change ℱ.obj.map (Opposite.op (B_g.map (G.map u.unop))) ≫
                ℱ.obj.map (Opposite.op (d₁_hom (Opposite.unop U₂))) =
              ℱ.obj.map (Opposite.op (d₁_hom (Opposite.unop U₁))) ≫ ℱ.obj.map (Opposite.op u.unop)
            rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
            exact congrArg (fun k => ℱ.obj.map (Opposite.op k)) (hd₁_nat u.unop).symm } }

    let ε_gP : ∀ ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}, P_g.obj (P.obj ℱ) ⟶ ℱ := fun ℱ =>
      { hom :=
        { app := fun U_op => ℱ.obj.map (Opposite.op (d₂_inv (Opposite.unop U_op)))
          naturality := fun {U₁ U₂} u => by
            change ℱ.obj.map (Opposite.op (G.map (B_g.map u.unop))) ≫
                ℱ.obj.map (Opposite.op (d₂_inv (Opposite.unop U₂))) =
              ℱ.obj.map (Opposite.op (d₂_inv (Opposite.unop U₁))) ≫ ℱ.obj.map (Opposite.op u.unop)
            rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp]
            exact congrArg (fun k => ℱ.obj.map (Opposite.op k)) (hd₂_inv_nat u.unop).symm } }

    have hε_Pg_nat : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (φ : ℱ₁ ⟶ ℱ₂),
        P.map (P_g.map φ) ≫ ε_Pg ℱ₂ = ε_Pg ℱ₁ ≫ φ := by
      intro ℱ₁ ℱ₂ φ
      apply CategoryTheory.Sheaf.hom_ext
      apply NatTrans.ext
      funext U_op
      exact (φ.hom.naturality (Opposite.op (d₁_hom (Opposite.unop U_op)))).symm

    have hε_tri : P.map (ε_gP F_A) = ε_Pg (P.obj F_A) := by
      apply CategoryTheory.Sheaf.hom_ext
      apply NatTrans.ext
      funext U_op
      change F_A.obj.map (Opposite.op (d₂_inv (G.obj (Opposite.unop U_op)))) =
        F_A.obj.map (Opposite.op (G.map (d₁_hom (Opposite.unop U_op))))
      rw [hTri (Opposite.unop U_op)]

    let αℤ : Fℤ ⟶ P.obj Fℤ :=
      (adj.homEquiv Aℤ (P.obj Fℤ)).symm (adj.unit.app Aℤ ≫ Fℤ.obj.map (Opposite.op μ))
    let αM : F_A ⟶ P.obj F_A :=
      (adj.homEquiv A (P.obj F_A)).symm (adj.unit.app A ≫ F_A.obj.map (Opposite.op μ))
    let τ_g : B_g.obj T ⟶ T := hT.from (B_g.obj T)
    let γM : F_A ⟶ P_g.obj F_A :=
      (adj.homEquiv A (P_g.obj F_A)).symm (adj.unit.app A ≫ F_A.obj.map (Opposite.op τ_g))
    let βM : P.obj F_A ⟶ F_A := P.map γM ≫ ε_Pg F_A
    let δM : P_g.obj F_A ⟶ F_A := P_g.map αM ≫ ε_gP F_A

    have hαβ : αM ≫ βM = 𝟙 F_A := by
      apply (adj.homEquiv A F_A).injective
      have hRHS : adj.homEquiv A F_A (𝟙 F_A) = adj.unit.app A := by
        rw [adj.homEquiv_unit]
        exact Category.comp_id _
      rw [hRHS, adj.homEquiv_naturality_right]
      have hα_app : adj.homEquiv A (P.obj F_A) αM =
          adj.unit.app A ≫ F_A.obj.map (Opposite.op μ) :=
        (adj.homEquiv A (P.obj F_A)).apply_symm_apply _
      rw [hα_app]
      let γ_GT : F_A.obj.obj (Opposite.op (G.obj T)) ⟶
          F_A.obj.obj (Opposite.op (B_g.obj (G.obj T))) :=
        γM.hom.app (Opposite.op (G.obj T))
      let γ_T : F_A.obj.obj (Opposite.op T) ⟶ F_A.obj.obj (Opposite.op (B_g.obj T)) :=
        γM.hom.app (Opposite.op T)
      change (adj.unit.app A ≫ F_A.obj.map (Opposite.op μ)) ≫
        (γ_GT ≫ F_A.obj.map (Opposite.op (d₁_hom T))) = adj.unit.app A
      have hnat_γ : F_A.obj.map (Opposite.op μ) ≫ γ_GT =
          γ_T ≫ F_A.obj.map (Opposite.op (B_g.map μ)) :=
        γM.hom.naturality (Opposite.op μ)
      have hγ_app : adj.unit.app A ≫ γ_T = adj.unit.app A ≫ F_A.obj.map (Opposite.op τ_g) := by
        have h1 : adj.homEquiv A (P_g.obj F_A) γM = adj.unit.app A ≫ γ_T := by
          rw [adj.homEquiv_unit]
          rfl
        exact h1.symm.trans ((adj.homEquiv A (P_g.obj F_A)).apply_symm_apply _)
      have h_id_T : d₁_hom T ≫ B_g.map μ ≫ τ_g = 𝟙 T := hT.hom_ext _ _
      calc (adj.unit.app A ≫ F_A.obj.map (Opposite.op μ)) ≫
            (γ_GT ≫ F_A.obj.map (Opposite.op (d₁_hom T)))
          = adj.unit.app A ≫ (F_A.obj.map (Opposite.op μ) ≫ γ_GT) ≫
              F_A.obj.map (Opposite.op (d₁_hom T)) := by simp only [Category.assoc]
        _ = adj.unit.app A ≫ (γ_T ≫ F_A.obj.map (Opposite.op (B_g.map μ))) ≫
              F_A.obj.map (Opposite.op (d₁_hom T)) := by rw [hnat_γ]
        _ = (adj.unit.app A ≫ γ_T) ≫
              (F_A.obj.map (Opposite.op (B_g.map μ)) ≫ F_A.obj.map (Opposite.op (d₁_hom T))) := by
                simp only [Category.assoc]
        _ = adj.unit.app A ≫
              (F_A.obj.map (Opposite.op τ_g) ≫
                (F_A.obj.map (Opposite.op (B_g.map μ)) ≫ F_A.obj.map (Opposite.op (d₁_hom T)))) := by
                rw [hγ_app, Category.assoc]
        _ = adj.unit.app A ≫ F_A.obj.map (Opposite.op (d₁_hom T ≫ B_g.map μ ≫ τ_g)) := by
                rw [← F_A.obj.map_comp, ← F_A.obj.map_comp]
                rfl
        _ = adj.unit.app A := by
                rw [h_id_T]
                change adj.unit.app A ≫ F_A.obj.map (𝟙 (Opposite.op T)) = adj.unit.app A
                rw [F_A.obj.map_id]
                exact Category.comp_id _

    have hγδ : γM ≫ δM = 𝟙 F_A := by
      apply (adj.homEquiv A F_A).injective
      have hRHS : adj.homEquiv A F_A (𝟙 F_A) = adj.unit.app A := by
        rw [adj.homEquiv_unit]
        exact Category.comp_id _
      rw [hRHS, adj.homEquiv_naturality_right]
      have hγ_app : adj.homEquiv A (P_g.obj F_A) γM =
          adj.unit.app A ≫ F_A.obj.map (Opposite.op τ_g) :=
        (adj.homEquiv A (P_g.obj F_A)).apply_symm_apply _
      rw [hγ_app]
      let α_BT : F_A.obj.obj (Opposite.op (B_g.obj T)) ⟶
          F_A.obj.obj (Opposite.op (G.obj (B_g.obj T))) :=
        αM.hom.app (Opposite.op (B_g.obj T))
      let α_T : F_A.obj.obj (Opposite.op T) ⟶ F_A.obj.obj (Opposite.op (G.obj T)) :=
        αM.hom.app (Opposite.op T)
      change (adj.unit.app A ≫ F_A.obj.map (Opposite.op τ_g)) ≫
        (α_BT ≫ F_A.obj.map (Opposite.op (d₂_inv T))) = adj.unit.app A
      have hnat_α : F_A.obj.map (Opposite.op τ_g) ≫ α_BT =
          α_T ≫ F_A.obj.map (Opposite.op (G.map τ_g)) :=
        αM.hom.naturality (Opposite.op τ_g)
      have hα_app : adj.unit.app A ≫ α_T = adj.unit.app A ≫ F_A.obj.map (Opposite.op μ) := by
        have h1 : adj.homEquiv A (P.obj F_A) αM = adj.unit.app A ≫ α_T := by
          rw [adj.homEquiv_unit]
          rfl
        exact h1.symm.trans ((adj.homEquiv A (P.obj F_A)).apply_symm_apply _)
      have h_id_T : d₂_inv T ≫ G.map τ_g ≫ μ = 𝟙 T := hT.hom_ext _ _
      calc (adj.unit.app A ≫ F_A.obj.map (Opposite.op τ_g)) ≫
            (α_BT ≫ F_A.obj.map (Opposite.op (d₂_inv T)))
          = adj.unit.app A ≫ (F_A.obj.map (Opposite.op τ_g) ≫ α_BT) ≫
              F_A.obj.map (Opposite.op (d₂_inv T)) := by simp only [Category.assoc]
        _ = adj.unit.app A ≫ (α_T ≫ F_A.obj.map (Opposite.op (G.map τ_g))) ≫
              F_A.obj.map (Opposite.op (d₂_inv T)) := by rw [hnat_α]
        _ = (adj.unit.app A ≫ α_T) ≫
              (F_A.obj.map (Opposite.op (G.map τ_g)) ≫ F_A.obj.map (Opposite.op (d₂_inv T))) := by
                simp only [Category.assoc]
        _ = adj.unit.app A ≫
              (F_A.obj.map (Opposite.op μ) ≫
                (F_A.obj.map (Opposite.op (G.map τ_g)) ≫ F_A.obj.map (Opposite.op (d₂_inv T)))) := by
                rw [hα_app, Category.assoc]
        _ = adj.unit.app A ≫ F_A.obj.map (Opposite.op (d₂_inv T ≫ G.map τ_g ≫ μ)) := by
                rw [← F_A.obj.map_comp, ← F_A.obj.map_comp]
                rfl
        _ = adj.unit.app A := by
                rw [h_id_T]
                change adj.unit.app A ≫ F_A.obj.map (𝟙 (Opposite.op T)) = adj.unit.app A
                rw [F_A.obj.map_id]
                exact Category.comp_id _

    have hβα : βM ≫ αM = 𝟙 (P.obj F_A) := by
      calc βM ≫ αM
          = P.map γM ≫ (ε_Pg F_A ≫ αM) := Category.assoc _ _ _
        _ = P.map γM ≫ (P.map (P_g.map αM) ≫ ε_Pg (P.obj F_A)) := by rw [← hε_Pg_nat αM]
        _ = P.map γM ≫ (P.map (P_g.map αM) ≫ P.map (ε_gP F_A)) := by rw [← hε_tri]
        _ = P.map (γM ≫ (P_g.map αM ≫ ε_gP F_A)) := by rw [← P.map_comp, ← P.map_comp]
        _ = P.map (γM ≫ δM) := rfl
        _ = P.map (𝟙 F_A) := by rw [hγδ]
        _ = 𝟙 (P.obj F_A) := P.map_id F_A

    have hα_nat_q : C.map q_A ≫ αM = αℤ ≫ P.map (C.map q_A) := by
      apply (adj.homEquiv Aℤ (P.obj F_A)).injective
      rw [adj.homEquiv_naturality_left, adj.homEquiv_naturality_right,
        (adj.homEquiv A (P.obj F_A)).apply_symm_apply,
        (adj.homEquiv Aℤ (P.obj Fℤ)).apply_symm_apply]
      let q_GT : Fℤ.obj.obj (Opposite.op (G.obj T)) ⟶ F_A.obj.obj (Opposite.op (G.obj T)) :=
        (C.map q_A).hom.app (Opposite.op (G.obj T))
      change q_A ≫ adj.unit.app A ≫ F_A.obj.map (Opposite.op μ) =
        (adj.unit.app Aℤ ≫ Fℤ.obj.map (Opposite.op μ)) ≫ q_GT
      have hq_nat : Fℤ.obj.map (Opposite.op μ) ≫ q_GT =
          (C.map q_A).hom.app (Opposite.op T) ≫ F_A.obj.map (Opposite.op μ) :=
        (C.map q_A).hom.naturality (Opposite.op μ)
      have hunit_nat : q_A ≫ adj.unit.app A =
          adj.unit.app Aℤ ≫ (C.map q_A).hom.app (Opposite.op T) :=
        adj.unit.naturality q_A
      rw [Category.assoc, hq_nat, ← Category.assoc (adj.unit.app Aℤ), ← hunit_nat, Category.assoc]

    refine ⟨βM, hαβ, hβα, fun ω_m u u_tilde fu_tilde hf_top hu_tilde hfu_tilde => ?_⟩
    let _ := hAdd_P
    let _ := hLim_P
    let _ := hColim_P
    let _ := hEpi_q
    let u_hat : Fℤ ⟶ ℱ_bar := CategoryTheory.Abelian.Ext.addEquiv₀ u
    have hu_mk0 : CategoryTheory.Abelian.Ext.mk₀ u_hat = u :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply u
    have hfu_eq : CategoryTheory.Abelian.Ext.addEquiv₀
        ((CategoryTheory.Abelian.Ext.mk₀ β_bar).postcomp Fℤ (Nat.add_zero 0)
          ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P
              hAdd_P hLim_P hColim_P _ _ Fℤ ℱ_bar 0) u)
            (Nat.zero_add 0))) = αℤ ≫ P.map u_hat ≫ β_bar := by
      apply (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ ℱ_bar).1
      rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply, ← hu_mk0,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      change ((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
          (CategoryTheory.Abelian.Ext.mk₀ (P.map u_hat)) (Nat.zero_add 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ β_bar) (Nat.add_zero 0) = _
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        Category.assoc]
    have h_epi_eq : C.map q_A ≫ (αM ≫ P.map u_tilde ≫ β_bar) = C.map q_A ≫ fu_tilde := by
      calc C.map q_A ≫ (αM ≫ P.map u_tilde ≫ β_bar)
          = (C.map q_A ≫ αM) ≫ P.map u_tilde ≫ β_bar := (Category.assoc _ _ _).symm
        _ = (αℤ ≫ P.map (C.map q_A)) ≫ P.map u_tilde ≫ β_bar := by rw [hα_nat_q]
        _ = αℤ ≫ (P.map (C.map q_A) ≫ P.map u_tilde) ≫ β_bar := by simp only [Category.assoc]
        _ = αℤ ≫ P.map (C.map q_A ≫ u_tilde) ≫ β_bar := by rw [← P.map_comp]
        _ = αℤ ≫ P.map u_hat ≫ β_bar := by rw [hu_tilde]
        _ = C.map q_A ≫ fu_tilde := (hfu_tilde.trans hfu_eq).symm
    have h_mid : αM ≫ P.map u_tilde ≫ β_bar = fu_tilde :=
      (CategoryTheory.cancel_epi (C.map q_A)).mp h_epi_eq
    have h_intertwine : P.map u_tilde ≫ β_bar = βM ≫ fu_tilde := by
      calc (P.map u_tilde : P.obj F_A ⟶ P.obj ℱ_bar) ≫ β_bar
          = 𝟙 (P.obj F_A) ≫ (P.map u_tilde ≫ β_bar) := (Category.id_comp _).symm
        _ = (βM ≫ αM) ≫ (P.map u_tilde ≫ β_bar) := by rw [hβα]
        _ = βM ≫ (αM ≫ P.map u_tilde ≫ β_bar) := Category.assoc _ _ _
        _ = βM ≫ fu_tilde := by rw [h_mid]

    change (((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P
          hAdd_P hLim_P hColim_P _ _ Fℤ ℱ_bar 2)
          (ω_m.comp (CategoryTheory.Abelian.Ext.mk₀ u_tilde) (Nat.add_zero 2)))
        (Nat.zero_add 2)).comp (CategoryTheory.Abelian.Ext.mk₀ β_bar) (Nat.add_zero 2)) =
      (Nat.card F) • ((CategoryTheory.Abelian.Ext.mk₀ fu_tilde).postcomp Fℤ (Nat.add_zero 2) ω_m)
    rw [CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ αℤ) _ _
        (Nat.zero_add 2) (Nat.add_zero 2) (Nat.add_zero 2),
      CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ (P.map u_tilde))
        (CategoryTheory.Abelian.Ext.mk₀ β_bar) (Nat.add_zero 2) (Nat.zero_add 0) (Nat.add_zero 2),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_intertwine,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ βM)
        (CategoryTheory.Abelian.Ext.mk₀ fu_tilde) (Nat.add_zero 2) (Nat.add_zero 0) (Nat.add_zero 2),
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ αℤ) _
        (CategoryTheory.Abelian.Ext.mk₀ fu_tilde) (Nat.zero_add 2) (Nat.add_zero 2) (Nat.add_zero 2),
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ αℤ)
        (ω_m.mapExactFunctor P) (CategoryTheory.Abelian.Ext.mk₀ βM)
        (Nat.zero_add 2) (Nat.add_zero 2) (Nat.add_zero 2)]
    have hf_top' : (((CategoryTheory.Abelian.Ext.mk₀ αℤ).comp
        (ω_m.mapExactFunctor P) (Nat.zero_add 2)).comp
        (CategoryTheory.Abelian.Ext.mk₀ βM) (Nat.add_zero 2)) = (Nat.card F) • ω_m := by
      rw [← CategoryTheory.Functor.mapExtAddHom_apply P Fℤ F_A 2 ω_m]
      exact hf_top
    rw [hf_top']
    exact map_nsmul ((CategoryTheory.Abelian.Ext.mk₀ fu_tilde).postcomp Fℤ (Nat.add_zero 2))
      (Nat.card F) ω_m

  
  have hPostId : ∀ {X : CategoryTheory.Sheaf J AddCommGrpCat.{u}} {d : ℕ} (w : X.H d),
      (CategoryTheory.Abelian.Ext.mk₀ (𝟙 X)).postcomp Fℤ (Nat.add_zero d) w = w :=
    fun w => CategoryTheory.Abelian.Ext.comp_mk₀_id w

  have hPostZero : ∀ {X Y : CategoryTheory.Sheaf J AddCommGrpCat.{u}} {d : ℕ} (w : X.H d),
      (CategoryTheory.Abelian.Ext.mk₀ (0 : X ⟶ Y)).postcomp Fℤ (Nat.add_zero d) w = 0 := by
    intro X Y d w
    change w.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : X ⟶ Y)) (Nat.add_zero d) = 0
    rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hPostAdd : ∀ {X Y : CategoryTheory.Sheaf J AddCommGrpCat.{u}} {d : ℕ}
      (f₁ f₂ : X ⟶ Y) (w : X.H d),
      (CategoryTheory.Abelian.Ext.mk₀ (f₁ + f₂)).postcomp Fℤ (Nat.add_zero d) w =
        (CategoryTheory.Abelian.Ext.mk₀ f₁).postcomp Fℤ (Nat.add_zero d) w +
          (CategoryTheory.Abelian.Ext.mk₀ f₂).postcomp Fℤ (Nat.add_zero d) w := by
    intro X Y d f₁ f₂ w
    change w.comp (CategoryTheory.Abelian.Ext.mk₀ (f₁ + f₂)) (Nat.add_zero d) = _
    rw [CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add]
    rfl

  have hPostComp : ∀ {X Y Z : CategoryTheory.Sheaf J AddCommGrpCat.{u}} {d : ℕ}
      (f : X ⟶ Y) (g : Y ⟶ Z) (w : X.H d),
      (CategoryTheory.Abelian.Ext.mk₀ (f ≫ g)).postcomp Fℤ (Nat.add_zero d) w =
        (CategoryTheory.Abelian.Ext.mk₀ g).postcomp Fℤ (Nat.add_zero d)
          ((CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ (Nat.add_zero d) w) := by
    intro X Y Z d f g w
    change w.comp (CategoryTheory.Abelian.Ext.mk₀ (f ≫ g)) (Nat.add_zero d) = _
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc w _ _
        (Nat.add_zero d) (Nat.zero_add 0) (Nat.add_zero d)]
    rfl

  have hPostNsmul : ∀ {X Y : CategoryTheory.Sheaf J AddCommGrpCat.{u}} {d : ℕ}
      (k : ℕ) (f : X ⟶ Y) (w : X.H d),
      (CategoryTheory.Abelian.Ext.mk₀ (k • f)).postcomp Fℤ (Nat.add_zero d) w =
        k • ((CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ (Nat.add_zero d) w) := by
    intro X Y d k f w
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, hPostZero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, hPostAdd, ih]

  have hSubOfIdZero : ∀ {X : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (d : ℕ),
      CategoryTheory.CategoryStruct.id X = 0 → Subsingleton (X.H d) := by
    intro X d hid
    refine ⟨fun x y => ?_⟩
    have hx : x = 0 := by
      rw [← hPostId x]
      change (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id X)).postcomp
        Fℤ (Nat.add_zero d) x = 0
      rw [hid, hPostZero]
    have hy : y = 0 := by
      rw [← hPostId y]
      change (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id X)).postcomp
        Fℤ (Nat.add_zero d) y = 0
      rw [hid, hPostZero]
    rw [hx, hy]

  have hTorElem : ∀ {B : AddCommGrpCat.{u}} {k : ℕ},
      k • CategoryTheory.CategoryStruct.id B = 0 → ∀ b : ↥B, k • b = 0 := by
    intro B k hk b
    exact CategoryTheory.ConcreteCategory.congr_hom hk b

  have hModSmulElem : ∀ {M : Type u} [AddCommGroup M] {m : ℕ} (x : M),
      m • x = 0 → ∀ a : ℕ, (a % m) • x = a • x := by
    intro M _ m x htor a
    have hdiv : m * (a / m) + a % m = a := Nat.div_add_mod a m
    conv_rhs => rw [← hdiv, add_nsmul, mul_comm, mul_smul, htor, smul_zero, zero_add]

  have hBezoutInj : ∀ {M : Type u} [AddCommGroup M] (b₀ : M),
      b₀ ≠ 0 → ℓ • b₀ = 0 →
      ∀ z : ZMod ℓ, z.val • b₀ = 0 → z = 0 := by
    intro M _ b₀ hb_ne hb_tor z hz
    have _ : NeZero ℓ := ⟨hPrime.ne_zero⟩
    by_contra hz_ne
    have hval_ne : z.val ≠ 0 := by
      intro hv0
      apply hz_ne
      rw [← ZMod.natCast_zmod_val z, hv0, Nat.cast_zero]
    have hlt : z.val < ℓ := ZMod.val_lt z
    have hndvd : ¬ (ℓ ∣ z.val) := fun hd => hval_ne (Nat.eq_zero_of_dvd_of_lt hd hlt)
    have hcop : Nat.Coprime ℓ z.val := hPrime.coprime_iff_not_dvd.mpr hndvd
    have hbez : (1 : ℤ) = (ℓ : ℤ) * Nat.gcdA ℓ z.val + (z.val : ℤ) * Nat.gcdB ℓ z.val := by
      have h1 := Nat.gcd_eq_gcd_ab ℓ z.val
      rw [hcop.gcd_eq_one, Nat.cast_one] at h1
      exact h1
    have hb0_zero : b₀ = 0 := by
      calc b₀ = (1 : ℤ) • b₀ := (one_zsmul b₀).symm
        _ = ((ℓ : ℤ) * Nat.gcdA ℓ z.val + (z.val : ℤ) * Nat.gcdB ℓ z.val) • b₀ := by rw [← hbez]
        _ = (Nat.gcdA ℓ z.val * (ℓ : ℤ)) • b₀ + (Nat.gcdB ℓ z.val * (z.val : ℤ)) • b₀ := by
            rw [mul_comm (ℓ : ℤ), mul_comm (z.val : ℤ), add_zsmul]
        _ = Nat.gcdA ℓ z.val • ((ℓ : ℤ) • b₀) + Nat.gcdB ℓ z.val • ((z.val : ℤ) • b₀) := by
            rw [mul_zsmul, mul_zsmul]
        _ = Nat.gcdA ℓ z.val • (ℓ • b₀) + Nat.gcdB ℓ z.val • (z.val • b₀) := by
            rw [natCast_zsmul, natCast_zsmul]
        _ = 0 := by rw [hb_tor, hz, smul_zero, smul_zero, add_zero]
    exact hb_ne hb0_zero

  let E : ℕ → Type u := fun n => weilEtaleTorsionH S n 2
  let liftHom : ∀ {m₁ m₂ : ℕ}, (ZMod m₁ →+ ZMod m₂) → (AM m₁ ⟶ AM m₂) :=
    fun φ => U.map (AddCommGrpCat.ofHom φ)
  let mapE : ∀ {m₁ m₂ : ℕ}, (ZMod m₁ →+ ZMod m₂) → (E m₁ →+ E m₂) :=
    fun φ => (CategoryTheory.Abelian.Ext.mk₀ (C.map (liftHom φ))).postcomp Fℤ (Nat.add_zero 2)

  have hMapE_id : ∀ (n : ℕ) (x : E n), mapE (AddMonoidHom.id (ZMod n)) x = x := by
    intro n x
    dsimp only [mapE, liftHom]
    rw [AddCommGrpCat.ofHom_id, U.map_id, C.map_id]
    exact hPostId x

  have hMapE_comp : ∀ {m₁ m₂ m₃ : ℕ} (α : ZMod m₁ →+ ZMod m₂) (β : ZMod m₂ →+ ZMod m₃)
      (x : E m₁), mapE (β.comp α) x = mapE β (mapE α x) := by
    intro m₁ m₂ m₃ α β x
    dsimp only [mapE, liftHom]
    rw [AddCommGrpCat.ofHom_comp, U.map_comp, C.map_comp]
    exact hPostComp _ _ x

  have hU_tor : ∀ n : ℕ, n • CategoryTheory.CategoryStruct.id (AM n) = 0 := by
    intro n
    have h0 : n • CategoryTheory.CategoryStruct.id (AddCommGrpCat.of (ZMod n)) = 0 := by
      ext z; change n • z = 0; rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    dsimp only [AM]
    rw [← U.map_id, ← CategoryTheory.Functor.map_nsmul, h0, U.map_zero]

  have hAM_tor : ∀ n : ℕ, n • CategoryTheory.CategoryStruct.id (C.obj (AM n)) = 0 := by
    intro n
    rw [← C.map_id, ← CategoryTheory.Functor.map_nsmul, hU_tor n, C.map_zero]

  have hH3 : Subsingleton (weilEtaleTorsionH S ℓ 3) := hH3_D 3 (le_refl 3)

  let μZMod : ∀ s : ℕ, ZMod ℓ →+ ZMod (ℓ ^ (s + 1)) := fun s =>
    letI : NeZero ℓ := ⟨hPrime.ne_zero⟩
    { toFun := fun x => ((x.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1)))
      map_zero' := by simp
      map_add' := fun x y => by
        rw [ZMod.val_add]
        have hdiv : x.val + y.val = ℓ * ((x.val + y.val) / ℓ) + (x.val + y.val) % ℓ :=
          (Nat.div_add_mod (x.val + y.val) ℓ).symm
        have hmul : (x.val + y.val) * ℓ ^ s =
            ((x.val + y.val) / ℓ) * ℓ ^ (s + 1) + ((x.val + y.val) % ℓ) * ℓ ^ s := by
          calc (x.val + y.val) * ℓ ^ s
              = (ℓ * ((x.val + y.val) / ℓ) + (x.val + y.val) % ℓ) * ℓ ^ s := by rw [← hdiv]
            _ = ((x.val + y.val) / ℓ) * (ℓ * ℓ ^ s) + ((x.val + y.val) % ℓ) * ℓ ^ s := by ring
            _ = ((x.val + y.val) / ℓ) * ℓ ^ (s + 1) + ((x.val + y.val) % ℓ) * ℓ ^ s := by
                rw [← pow_succ']
        have hcast : (((x.val + y.val) * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) =
            ((((x.val + y.val) % ℓ) * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) := by
          rw [hmul, Nat.cast_add, Nat.cast_mul, ZMod.natCast_self, mul_zero, zero_add]
        rw [← hcast, add_mul, Nat.cast_add] }

  let πZMod : ∀ s : ℕ, ZMod (ℓ ^ (s + 1)) →+ ZMod (ℓ ^ s) := fun s =>
    (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))).toAddMonoidHom

  have hTransSurj : ∀ (s : ℕ) (w : E (ℓ ^ s)), ∃ w' : E (ℓ ^ (s + 1)), mapE (πZMod s) w' = w := by
    intro s w
    have _ : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have _ : NeZero (ℓ ^ s) := ⟨pow_ne_zero s hPrime.ne_zero⟩
    have _ : NeZero (ℓ ^ (s + 1)) := ⟨pow_ne_zero (s + 1) hPrime.ne_zero⟩
    have hμ_inj : Function.Injective (μZMod s) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      change ((x.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) = 0 at hx
      have hdvd1 : ℓ ^ (s + 1) ∣ x.val * ℓ ^ s := (ZMod.natCast_eq_zero_iff _ _).mp hx
      rw [pow_succ'] at hdvd1
      have hdvd2 : ℓ ∣ x.val := (Nat.mul_dvd_mul_iff_right (pow_pos hPrime.pos s)).mp hdvd1
      have hval0 : x.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd2 (ZMod.val_lt x)
      rw [← ZMod.natCast_zmod_val x, hval0, Nat.cast_zero]
    have hπ_surj : Function.Surjective (πZMod s) := fun y =>
      ⟨(y.val : ZMod (ℓ ^ (s + 1))), by
        change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))
          (y.val : ZMod (ℓ ^ (s + 1))) = y
        rw [map_natCast, ZMod.natCast_zmod_val]⟩
    have h0 : liftHom (μZMod s) ≫ liftHom (πZMod s) = 0 := by
      ext z; apply ULift.ext
      change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))
        ((z.down.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) = 0
      rw [map_natCast, Nat.cast_mul, ZMod.natCast_self, mul_zero]
    let SC_s : CategoryTheory.ShortComplex AddCommGrpCat.{u} :=
      CategoryTheory.ShortComplex.mk (liftHom (μZMod s)) (liftHom (πZMod s)) h0
    have hSE : (SC_s.map C).ShortExact :=
      ({ exact := (CategoryTheory.ShortComplex.ab_exact_iff SC_s).mpr fun y hy => by
          have hy0 : πZMod s y.down = 0 := congrArg ULift.down hy
          have hy_cast : (y.down.val : ZMod (ℓ ^ s)) = 0 := by
            have h1 : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s))
                (y.down.val : ZMod (ℓ ^ (s + 1))) = (y.down.val : ZMod (ℓ ^ s)) := map_natCast _ _
            rw [ZMod.natCast_zmod_val] at h1
            exact h1.symm.trans hy0
          obtain ⟨k_q, hk_q⟩ := (ZMod.natCast_eq_zero_iff _ _).mp hy_cast
          have hk_lt : k_q < ℓ := by
            have hlt : y.down.val < ℓ ^ (s + 1) := ZMod.val_lt y.down
            rw [hk_q, pow_succ] at hlt
            exact Nat.lt_of_mul_lt_mul_left hlt
          let x₀ : ZMod ℓ := (k_q : ZMod ℓ)
          have hx₀_val : x₀.val = k_q := ZMod.val_natCast_of_lt hk_lt
          refine ⟨ULift.up x₀, ULift.ext _ _ ?_⟩
          change ((x₀.val * ℓ ^ s : ℕ) : ZMod (ℓ ^ (s + 1))) = y.down
          rw [hx₀_val, mul_comm, ← hk_q, ZMod.natCast_zmod_val]
         mono_f := (AddCommGrpCat.mono_iff_injective _).mpr fun x₁ x₂ h12 =>
          ULift.ext _ _ (hμ_inj (congrArg ULift.down h12))
         epi_g := (AddCommGrpCat.epi_iff_surjective _).mpr fun y => by
          obtain ⟨x, hx⟩ := hπ_surj y.down
          exact ⟨ULift.up x, ULift.ext _ _ hx⟩ } : SC_s.ShortExact).map_of_exact C
    have hbdry : w.comp hSE.extClass (rfl : 2 + 1 = 3) = 0 := @Subsingleton.elim _ hH3 _ 0
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hSE w (rfl : 2 + 1 = 3) hbdry

  have hFinEℓ : Finite (E ℓ) :=
    Nat.finite_of_card_ne_zero (by rw [hH2_D]; exact hPrime.ne_zero)
  have hNontrivEℓ : Nontrivial (E ℓ) :=
    (Finite.one_lt_card_iff_nontrivial).mp (by rw [hH2_D]; exact hPrime.one_lt)
  obtain ⟨ω_base, hω_base_ne⟩ := exists_ne (0 : E ℓ)
  have hω_base_tor : ℓ • ω_base = 0 := by
    rw [← hPostId ω_base, ← hPostNsmul]
    change (CategoryTheory.Abelian.Ext.mk₀ (ℓ • CategoryTheory.CategoryStruct.id (C.obj (AM ℓ)))).postcomp
      Fℤ (Nat.add_zero 2) ω_base = 0
    rw [hAM_tor ℓ, hPostZero]

  let i1_ring : ZMod ℓ →+* ZMod (ℓ ^ 1) := ZMod.castHom (dvd_of_eq (pow_one ℓ)) (ZMod (ℓ ^ 1))
  let j1_ring : ZMod (ℓ ^ 1) →+* ZMod ℓ := ZMod.castHom (dvd_of_eq (pow_one ℓ).symm) (ZMod ℓ)
  have h_j1_i1 : j1_ring.toAddMonoidHom.comp i1_ring.toAddMonoidHom = AddMonoidHom.id _ := by
    have h : j1_ring.comp i1_ring = RingHom.id _ := RingHom.ext_zmod _ _
    exact congrArg RingHom.toAddMonoidHom h

  let ω₀ : E (ℓ ^ 1) := mapE i1_ring.toAddMonoidHom ω_base
  let ω : ∀ r : ℕ, E (ℓ ^ (r + 1)) :=
    Nat.rec ω₀ (fun r ω_r => Classical.choose (hTransSurj (r + 1) ω_r))

  have hω_tr : ∀ r : ℕ, mapE (πZMod (r + 1)) (ω (r + 1)) = ω r :=
    fun r => Classical.choose_spec (hTransSurj (r + 1) (ω r))

  let pZMod : ∀ r : ℕ, ZMod (ℓ ^ (r + 1)) →+ ZMod ℓ := fun r =>
    (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)).toAddMonoidHom

  have hω_proj_base : ∀ r : ℕ, mapE (pZMod r) (ω r) = ω_base := by
    intro r
    induction r with
    | zero =>
      have hp0 : pZMod 0 = j1_ring.toAddMonoidHom := rfl
      change mapE (pZMod 0) (mapE i1_ring.toAddMonoidHom ω_base) = ω_base
      rw [hp0, ← hMapE_comp, h_j1_i1, hMapE_id]
    | succ r ih =>
      have hp_comp : (pZMod r).comp (πZMod (r + 1)) = pZMod (r + 1) := by
        have h : (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)).comp
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
            ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero (r + 1))) (ZMod ℓ) :=
          RingHom.ext_zmod _ _
        exact congrArg RingHom.toAddMonoidHom h
      rw [← hp_comp, hMapE_comp, hω_tr r, ih]

  have hPrimeOrderElem : ∀ {M : Type u} [AddCommGroup M] (k_r : ℕ) (a : M),
      a ≠ 0 → (ℓ ^ k_r) • a = 0 → ∃ b : M, b ≠ 0 ∧ ℓ • b = 0 := by
    intro M _ k_r
    induction k_r with
    | zero => intro a ha_ne ha_tor; rw [pow_zero, one_nsmul] at ha_tor; exact absurd ha_tor ha_ne
    | succ k_r ih =>
      intro a ha_ne ha_tor
      rw [pow_succ, mul_smul] at ha_tor
      by_cases hℓa : ℓ • a = 0
      · exact ⟨a, ha_ne, hℓa⟩
      · exact ih (ℓ • a) hℓa ha_tor

  have hConstH2Bij : ∀ (r : ℕ) (B : AddCommGrpCat.{u}) [Finite ↥B]
      (hTorB : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id B = 0)
      (μ_B : ↥B → (AM (ℓ ^ (r + 1)) ⟶ B))
      (_ : ∀ (b : ↥B) (z : ULift.{u, 0} (ZMod (ℓ ^ (r + 1)))), μ_B b z = z.down.val • b),
      Function.Bijective (fun b : ↥B =>
        (CategoryTheory.Abelian.Ext.mk₀ (C.map (μ_B b))).postcomp Fℤ (Nat.add_zero 2) (ω r)) := by
    intro r
    have _ : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have _ : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
    let μ_std : ∀ (B : AddCommGrpCat.{u}),
        ((ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id B = 0) → ↥B → (AM (ℓ ^ (r + 1)) ⟶ B) :=
      fun B hTorB b => AddCommGrpCat.ofHom
        { toFun := fun z => z.down.val • b
          map_zero' := by simp
          map_add' := fun ⟨a₁⟩ ⟨a₂⟩ => by
            change (a₁ + a₂).val • b = a₁.val • b + a₂.val • b
            rw [ZMod.val_add]
            exact (hModSmulElem b (hTorElem hTorB b) (a₁.val + a₂.val)).trans
              (add_nsmul b a₁.val a₂.val) }
    let Ψ_const : ∀ (B : AddCommGrpCat.{u}),
        ((ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id B = 0) → (↥B →+ (C.obj B).H 2) :=
      fun B hTorB =>
        { toFun := fun b =>
            (CategoryTheory.Abelian.Ext.mk₀ (C.map (μ_std B hTorB b))).postcomp Fℤ
              (Nat.add_zero 2) (ω r)
          map_zero' := by
            have h0 : μ_std B hTorB 0 = 0 := by ext z; exact smul_zero z.down.val
            rw [h0, C.map_zero, hPostZero]
          map_add' := fun b₁ b₂ => by
            have hadd : μ_std B hTorB (b₁ + b₂) = μ_std B hTorB b₁ + μ_std B hTorB b₂ := by
              ext z; exact smul_add z.down.val b₁ b₂
            rw [hadd, C.map_add, hPostAdd] }
    have hΨ_nat : ∀ {B₁ B₂ : AddCommGrpCat.{u}}
        (hTor₁ : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id B₁ = 0)
        (hTor₂ : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id B₂ = 0)
        (φ : B₁ ⟶ B₂) (b : ↥B₁),
        (CategoryTheory.Abelian.Ext.mk₀ (C.map φ)).postcomp Fℤ (Nat.add_zero 2)
          (Ψ_const B₁ hTor₁ b) = Ψ_const B₂ hTor₂ (φ b) := by
      intro B₁ B₂ hTor₁ hTor₂ φ b
      have hcomp : μ_std B₁ hTor₁ b ≫ φ = μ_std B₂ hTor₂ (φ b) := by
        ext z
        change φ (z.down.val • b) = z.down.val • φ b
        exact map_nsmul φ.hom z.down.val b
      change (CategoryTheory.Abelian.Ext.mk₀ (C.map φ)).postcomp Fℤ (Nat.add_zero 2)
        ((CategoryTheory.Abelian.Ext.mk₀ (C.map (μ_std B₁ hTor₁ b))).postcomp Fℤ
          (Nat.add_zero 2) (ω r)) = _
      rw [← hPostComp, ← C.map_comp, hcomp]
      rfl
    have hTorAMℓ : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (AM ℓ) = 0 := by
      rw [pow_succ, mul_smul, hU_tor ℓ, smul_zero]
    have hBijAMℓ : Function.Bijective (Ψ_const (AM ℓ) hTorAMℓ) := by
      have hEvalAMℓ : ∀ a : ZMod ℓ,
          Ψ_const (AM ℓ) hTorAMℓ (ULift.up a) = a.val • ω_base := by
        intro a
        have hμ_eq : μ_std (AM ℓ) hTorAMℓ (ULift.up a) = a.val • liftHom (pZMod r) := by
          ext z; apply ULift.ext
          change z.down.val • a = a.val • pZMod r z.down
          have hpz : pZMod r z.down = (z.down.val : ZMod ℓ) := by
            conv_lhs => rw [← ZMod.natCast_zmod_val z.down]
            exact map_natCast (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero r)) (ZMod ℓ)) z.down.val
          rw [hpz, nsmul_eq_mul, nsmul_eq_mul, ZMod.natCast_zmod_val, mul_comm]
        change (CategoryTheory.Abelian.Ext.mk₀ (C.map (μ_std (AM ℓ) hTorAMℓ (ULift.up a)))).postcomp
          Fℤ (Nat.add_zero 2) (ω r) = a.val • ω_base
        rw [hμ_eq, CategoryTheory.Functor.map_nsmul, hPostNsmul]
        exact congrArg (a.val • ·) (hω_proj_base r)
      have hInj : Function.Injective (Ψ_const (AM ℓ) hTorAMℓ) := by
        rw [injective_iff_map_eq_zero]
        intro ⟨a⟩ hx
        rw [hEvalAMℓ a] at hx
        exact congrArg ULift.up (hBezoutInj ω_base hω_base_ne hω_base_tor a hx)
      have hFinAMℓ : Finite ↥(AM ℓ) := by change Finite (ULift.{u, 0} (ZMod ℓ)); infer_instance
      let _ : Fintype ↥(AM ℓ) := Fintype.ofFinite ↥(AM ℓ)
      let _ : Fintype (E ℓ) := Fintype.ofFinite (E ℓ)
      have hCard : Fintype.card ↥(AM ℓ) = Fintype.card (E ℓ) := by
        rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hH2_D]
        change Nat.card (ULift.{u, 0} (ZMod ℓ)) = ℓ
        rw [Nat.card_ulift, Nat.card_zmod]
      exact (Fintype.bijective_iff_injective_and_card _).mpr ⟨hInj, hCard⟩
    have hCardInd : ∀ (c : ℕ) (B : AddCommGrpCat.{u}) [Finite ↥B],
        Nat.card ↥B = c →
        ∀ (hTorB : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id B = 0),
          Function.Bijective (Ψ_const B hTorB) := by
      intro c
      induction c using Nat.strongRecOn with
      | ind c ih =>
        intro B hFinB hCardB hTorB
        by_cases hc1 : c ≤ 1
        · have hSubB : Subsingleton ↥B := (Finite.card_le_one_iff_subsingleton).mp (hCardB ▸ hc1)
          have hidB : CategoryTheory.CategoryStruct.id B = 0 := by
            ext x; exact Subsingleton.elim x 0
          have hidCB : CategoryTheory.CategoryStruct.id (C.obj B) = 0 := by
            rw [← C.map_id, hidB, C.map_zero]
          have hSubH2 : Subsingleton ((C.obj B).H 2) := hSubOfIdZero 2 hidCB
          exact ⟨fun x y _ => Subsingleton.elim x y,
            fun y => ⟨0, Subsingleton.elim _ y⟩⟩
        · have hc_gt1 : 1 < Nat.card ↥B := by omega
          have hNontrivB : Nontrivial ↥B := (Finite.one_lt_card_iff_nontrivial).mp hc_gt1
          obtain ⟨a₀, ha₀_ne⟩ := exists_ne (0 : ↥B)
          obtain ⟨b₀, hb₀_ne, hb₀_tor⟩ :=
            hPrimeOrderElem (r + 1) a₀ ha₀_ne (hTorElem hTorB a₀)
          let i_B : AM ℓ ⟶ B := AddCommGrpCat.ofHom
            { toFun := fun z => z.down.val • b₀
              map_zero' := by simp
              map_add' := fun ⟨a₁⟩ ⟨a₂⟩ => by
                change (a₁ + a₂).val • b₀ = a₁.val • b₀ + a₂.val • b₀
                rw [ZMod.val_add]
                exact (hModSmulElem b₀ hb₀_tor (a₁.val + a₂.val)).trans
                  (add_nsmul b₀ a₁.val a₂.val) }
          have hi_inj : Function.Injective i_B.hom := by
            rw [injective_iff_map_eq_zero]
            intro ⟨a⟩ hz
            change a.val • b₀ = 0 at hz
            exact congrArg ULift.up (hBezoutInj b₀ hb₀_ne hb₀_tor a hz)
          let H : AddSubgroup ↥B := AddMonoidHom.range i_B.hom
          let Q : AddCommGrpCat.{u} := AddCommGrpCat.of (↥B ⧸ H)
          let q_B : B ⟶ Q := AddCommGrpCat.ofHom (QuotientAddGroup.mk' H)
          have hq_surj : Function.Surjective q_B.hom := QuotientAddGroup.mk'_surjective H
          have hFinQ : Finite ↥Q := Finite.of_surjective q_B.hom hq_surj
          have hTorQ : (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id Q = 0 := by
            ext b
            change (ℓ ^ (r + 1)) • QuotientAddGroup.mk' H b = 0
            rw [← map_nsmul, hTorElem hTorB b, map_zero]
          have hiq_zero : i_B ≫ q_B = 0 := by
            ext z
            change QuotientAddGroup.mk' H (i_B.hom z) = 0
            exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨z, rfl⟩
          let SC_B : CategoryTheory.ShortComplex AddCommGrpCat.{u} :=
            CategoryTheory.ShortComplex.mk i_B q_B hiq_zero
          have hSE_B : (SC_B.map C).ShortExact :=
            ({ exact := (CategoryTheory.ShortComplex.ab_exact_iff SC_B).mpr fun b hb => by
                change QuotientAddGroup.mk' H b = 0 at hb
                exact (QuotientAddGroup.eq_zero_iff b).mp hb
               mono_f := (AddCommGrpCat.mono_iff_injective i_B).mpr hi_inj
               epi_g := (AddCommGrpCat.epi_iff_surjective q_B).mpr hq_surj } :
              SC_B.ShortExact).map_of_exact C
          have hCardH : Nat.card ↥H = ℓ := by
            let e_H : ZMod ℓ ≃ ↥H := Equiv.ofBijective
              (fun z => ⟨i_B.hom (ULift.up z), ⟨ULift.up z, rfl⟩⟩)
              ⟨fun x y hxy => congrArg ULift.down (hi_inj (congrArg Subtype.val hxy)),
               fun ⟨_, ⟨u, rfl⟩⟩ => ⟨u.down, rfl⟩⟩
            rw [← Nat.card_congr e_H, Nat.card_zmod]
          have hLagrange : c = Nat.card ↥Q * ℓ := by
            rw [← hCardB, ← hCardH]
            exact AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup H
          have hCardQ_lt : Nat.card ↥Q < c := by
            have hℓ2 : 2 ≤ ℓ := hPrime.two_le
            have hQ_pos : 0 < Nat.card ↥Q := by
              by_contra hQ0
              have : Nat.card ↥Q = 0 := by omega
              rw [this, zero_mul] at hLagrange
              omega
            nlinarith
          have hBijQ : Function.Bijective (Ψ_const Q hTorQ) :=
            ih (Nat.card ↥Q) hCardQ_lt Q rfl hTorQ
          let i_star := (CategoryTheory.Abelian.Ext.mk₀ (C.map i_B)).postcomp Fℤ (Nat.add_zero 2)
          let q_star := (CategoryTheory.Abelian.Ext.mk₀ (C.map q_B)).postcomp Fℤ (Nat.add_zero 2)
          have hi_star_inj : Function.Injective i_star := by
            rw [injective_iff_map_eq_zero]
            intro x hx
            obtain ⟨z₁, hz₁⟩ :=
              CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE_B x hx (rfl : 1 + 1 = 2)
            have hSubQ1 : Subsingleton ((C.obj Q).H 1) := hH1_const (r + 1) Q hTorQ
            have hz0 : z₁ = 0 := @Subsingleton.elim _ hSubQ1 z₁ 0
            rw [← hz₁, hz0, CategoryTheory.Abelian.Ext.zero_comp]
          refine ⟨?_, ?_⟩
          · rw [injective_iff_map_eq_zero]
            intro b hb
            have hqb0 : Ψ_const Q hTorQ (q_B b) = 0 := by
              rw [← hΨ_nat hTorB hTorQ q_B b]
              change q_star (Ψ_const B hTorB b) = 0
              rw [hb, map_zero]
            have hqb_ker : q_B.hom b = 0 :=
              hBijQ.1 (hqb0.trans (map_zero (Ψ_const Q hTorQ)).symm)
            have hb_H : b ∈ H := (QuotientAddGroup.eq_zero_iff b).mp hqb_ker
            obtain ⟨a, rfl⟩ := hb_H
            have hia0 : i_star (Ψ_const (AM ℓ) hTorAMℓ a) = 0 := by
              change (CategoryTheory.Abelian.Ext.mk₀ (C.map i_B)).postcomp Fℤ (Nat.add_zero 2)
                (Ψ_const (AM ℓ) hTorAMℓ a) = 0
              rw [hΨ_nat hTorAMℓ hTorB i_B a]
              exact hb
            have ha0 : Ψ_const (AM ℓ) hTorAMℓ a = 0 :=
              hi_star_inj (hia0.trans (map_zero i_star).symm)
            have ha_eq0 : a = 0 :=
              hBijAMℓ.1 (ha0.trans (map_zero (Ψ_const (AM ℓ) hTorAMℓ)).symm)
            rw [ha_eq0, map_zero]
          · intro y
            obtain ⟨q₀, hq₀⟩ := hBijQ.2 (q_star y)
            obtain ⟨b₁, hb₁⟩ := hq_surj q₀
            have hdiff_ker : (y - Ψ_const B hTorB b₁).comp
                (CategoryTheory.Abelian.Ext.mk₀ (SC_B.map C).g) (Nat.add_zero 2) = 0 := by
              change q_star (y - Ψ_const B hTorB b₁) = 0
              rw [map_sub]
              change q_star y - (CategoryTheory.Abelian.Ext.mk₀ (C.map q_B)).postcomp Fℤ
                (Nat.add_zero 2) (Ψ_const B hTorB b₁) = 0
              rw [hΨ_nat hTorB hTorQ q_B b₁]
              change q_star y - Ψ_const Q hTorQ (q_B.hom b₁) = 0
              rw [hb₁, hq₀, sub_self]
            obtain ⟨x, hx⟩ :=
              CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE_B
                (y - Ψ_const B hTorB b₁) hdiff_ker
            obtain ⟨a, rfl⟩ := hBijAMℓ.2 x
            have hx' : i_star (Ψ_const (AM ℓ) hTorAMℓ a) = y - Ψ_const B hTorB b₁ := hx
            refine ⟨b₁ + i_B a, ?_⟩
            rw [map_add, ← hΨ_nat hTorAMℓ hTorB i_B a]
            change Ψ_const B hTorB b₁ + i_star (Ψ_const (AM ℓ) hTorAMℓ a) = y
            rw [hx', add_sub_cancel]
    intro B hFinB hTorB μ_B hμ_B
    have hEqFn : (fun b : ↥B =>
        (CategoryTheory.Abelian.Ext.mk₀ (C.map (μ_B b))).postcomp Fℤ (Nat.add_zero 2) (ω r)) =
        Ψ_const B hTorB := by
      funext b
      have hμ_eq : μ_B b = μ_std B hTorB b := by ext z; exact hμ_B b z
      rw [hμ_eq]
      rfl
    rw [hEqFn]
    exact hCardInd (Nat.card ↥B) B rfl hTorB

  
  let T_S : S.Etale := weilEtaleIdTerminal.{u} S
  let hT_S : CategoryTheory.Limits.IsTerminal T_S := weilEtaleIdTerminalIsTerminal.{u} S
  let adj_S := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S

  let q_hom : ∀ r : ℕ, Aℤ ⟶ AM (ℓ ^ (r + 1)) := fun r => AddCommGrpCat.ofHom
    { toFun := fun z => ULift.up (z.down : ZMod (ℓ ^ (r + 1)))
      map_zero' := congrArg ULift.up Int.cast_zero
      map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }

  have hEpi_q : ∀ r : ℕ, CategoryTheory.Epi (C.map (q_hom r)) := by
    intro r
    have _ : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
    have hq_surj : Function.Surjective (q_hom r).hom := fun y =>
      ⟨ULift.up (y.down.val : ℤ), ULift.ext _ _ (by
        change ((y.down.val : ℤ) : ZMod (ℓ ^ (r + 1))) = y.down
        rw [Int.cast_natCast, ZMod.natCast_zmod_val])⟩
    have _ : CategoryTheory.Epi (q_hom r) := (AddCommGrpCat.epi_iff_surjective (q_hom r)).mpr hq_surj
    exact C.map_epi (q_hom r)

  have hLevelFac : ∀ r : ℕ,
      let M_r : AddCommGrpCat.{u} := (ℳ_bar r).obj.obj (Opposite.op T_S)
      let ε_r : C.obj M_r ⟶ ℳ_bar r := adj_S.counit.app (ℳ_bar r)
      ((ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id M_r = 0) ∧
      ∃ (e_H0 : ↥M_r → (ℳ_bar r).H 0) (μ_M : ↥M_r → (AM (ℓ ^ (r + 1)) ⟶ M_r)),
        Function.Bijective e_H0 ∧
        (∀ (x : ↥M_r) (z : ULift.{u, 0} (ZMod (ℓ ^ (r + 1)))), μ_M x z = z.down.val • x) ∧
        (∀ x : ↥M_r,
          C.map (q_hom r) ≫ (C.map (μ_M x) ≫ ε_r) =
            CategoryTheory.Abelian.Ext.addEquiv₀ (e_H0 x)) := by
    intro r
    let m₀ := ℓ ^ (r + 1)
    have _ : NeZero m₀ := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
    let M₀ : AddCommGrpCat.{u} := (ℳ_bar r).obj.obj (Opposite.op T_S)
    let ε₀ : C.obj M₀ ⟶ ℳ_bar r := adj_S.counit.app (ℳ_bar r)
    have hTor_M₀ : m₀ • CategoryTheory.CategoryStruct.id M₀ = 0 := by
      have h_app : ∀ k : ℕ,
          ((k • CategoryTheory.CategoryStruct.id (ℳ_bar r)).hom.app (Opposite.op T_S)) =
            k • CategoryTheory.CategoryStruct.id M₀ := by
        intro k
        induction k with
        | zero => rw [zero_nsmul, zero_nsmul]; rfl
        | succ k ih =>
          rw [succ_nsmul, succ_nsmul]
          exact congrArg (· + CategoryTheory.CategoryStruct.id M₀) ih
      rw [← h_app m₀, hTor_M r]
      rfl
    let φ_Z : ↥M₀ → (Aℤ ⟶ M₀) := fun x => AddCommGrpCat.ofHom
      { toFun := fun z => z.down • x
        map_zero' := zero_zsmul x
        map_add' := fun z₁ z₂ => add_zsmul x z₁.down z₂.down }
    have hφ_Z_bij : Function.Bijective φ_Z := by
      refine ⟨fun x₁ x₂ h12 => ?_, fun φ => ⟨φ (ULift.up 1), ?_⟩⟩
      · have h1 := CategoryTheory.ConcreteCategory.congr_hom h12 (ULift.up (1 : ℤ))
        change (1 : ℤ) • x₁ = (1 : ℤ) • x₂ at h1
        rwa [one_zsmul, one_zsmul] at h1
      · ext ⟨z⟩
        have hz : (ULift.up z : ULift.{u} ℤ) = z • ULift.up (1 : ℤ) :=
          congrArg ULift.up (zsmul_one z).symm
        change z • φ (ULift.up 1) = φ (ULift.up z)
        rw [hz, map_zsmul]
    let μ_M₀ : ↥M₀ → (AM m₀ ⟶ M₀) := fun x => AddCommGrpCat.ofHom
      { toFun := fun w => w.down.val • x
        map_zero' := by simp
        map_add' := fun ⟨a₁⟩ ⟨a₂⟩ => by
          change (a₁ + a₂).val • x = a₁.val • x + a₂.val • x
          rw [ZMod.val_add]
          exact (hModSmulElem x (hTorElem hTor_M₀ x) (a₁.val + a₂.val)).trans
            (add_nsmul x a₁.val a₂.val) }
    have hq_μ_eq : ∀ x : ↥M₀, q_hom r ≫ μ_M₀ x = φ_Z x := by
      intro x
      ext ⟨z⟩
      let w : ZMod m₀ := (z : ZMod m₀)
      change w.val • x = z • x
      have hcast0 : (((w.val : ℤ) - z : ℤ) : ZMod m₀) = 0 := by
        rw [Int.cast_sub, Int.cast_natCast, ZMod.natCast_zmod_val, sub_self]
      obtain ⟨k, hk⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd ((w.val : ℤ) - z) m₀).mp hcast0
      have hdiff0 : ((w.val : ℤ) - z) • x = 0 := by
        rw [hk, mul_comm, mul_zsmul, natCast_zsmul, hTorElem hTor_M₀ x, smul_zero]
      calc w.val • x
          = (w.val : ℤ) • x := (natCast_zsmul x w.val).symm
        _ = ((w.val : ℤ) - z + z) • x := by rw [sub_add_cancel]
        _ = ((w.val : ℤ) - z) • x + z • x := add_zsmul x ((w.val : ℤ) - z) z
        _ = 0 + z • x := by rw [hdiff0]
        _ = z • x := zero_add _
    let e_H0_fn : ↥M₀ → (ℳ_bar r).H 0 :=
      fun x => CategoryTheory.Abelian.Ext.addEquiv₀.symm
        ((adj_S.homEquiv Aℤ (ℳ_bar r)).symm (φ_Z x))
    have he_H0_bij : Function.Bijective e_H0_fn :=
      CategoryTheory.Abelian.Ext.addEquiv₀.symm.bijective.comp
        ((adj_S.homEquiv Aℤ (ℳ_bar r)).symm.bijective.comp hφ_Z_bij)
    have he_H0_fac : ∀ x : ↥M₀,
        C.map (q_hom r) ≫ (C.map (μ_M₀ x) ≫ ε₀) =
          CategoryTheory.Abelian.Ext.addEquiv₀ (e_H0_fn x) := by
      intro x
      dsimp only [e_H0_fn]
      rw [AddEquiv.apply_symm_apply, adj_S.homEquiv_counit, ← hq_μ_eq x, C.map_comp,
        Category.assoc]
    exact ⟨hTor_M₀, e_H0_fn, μ_M₀, he_H0_bij, fun _ _ => rfl, he_H0_fac⟩

  have hExLift : ∀ (r : ℕ) (u : (ℳ_bar r).H 0),
      ∃ u_tilde : FM (ℓ ^ (r + 1)) ⟶ ℳ_bar r,
        C.map (q_hom r) ≫ u_tilde = CategoryTheory.Abelian.Ext.addEquiv₀ u := by
    intro r u
    obtain ⟨_, e_H0, μ_M, he_bij, _, he_fac⟩ := hLevelFac r
    obtain ⟨x, rfl⟩ := he_bij.2 u
    exact ⟨C.map (μ_M x) ≫ adj_S.counit.app (ℳ_bar r), he_fac x⟩

  let lift : ∀ (r : ℕ), (ℳ_bar r).H 0 → (FM (ℓ ^ (r + 1)) ⟶ ℳ_bar r) :=
    fun r u => Classical.choose (hExLift r u)
  have hlift_spec : ∀ (r : ℕ) (u : (ℳ_bar r).H 0),
      C.map (q_hom r) ≫ lift r u = CategoryTheory.Abelian.Ext.addEquiv₀ u :=
    fun r u => Classical.choose_spec (hExLift r u)

  let Ψ : ∀ r : ℕ, (ℳ_bar r).H 0 →+ (ℳ_bar r).H 2 := fun r =>
    letI := hEpi_q r
    { toFun := fun u =>
        (CategoryTheory.Abelian.Ext.mk₀ (lift r u)).postcomp Fℤ (Nat.add_zero 2) (ω r)
      map_zero' := by
        have hl0 : lift r 0 = 0 :=
          (CategoryTheory.cancel_epi (C.map (q_hom r))).mp
            ((hlift_spec r 0).trans (by rw [map_zero, CategoryTheory.Limits.comp_zero]))
        rw [hl0, hPostZero]
      map_add' := fun u₁ u₂ => by
        have hl_add : lift r (u₁ + u₂) = lift r u₁ + lift r u₂ :=
          (CategoryTheory.cancel_epi (C.map (q_hom r))).mp
            ((hlift_spec r (u₁ + u₂)).trans
              (by rw [map_add, CategoryTheory.Preadditive.comp_add, hlift_spec r u₁,
                hlift_spec r u₂]))
        rw [hl_add, hPostAdd] }

  have hΨ_bij : ∀ r : ℕ, Function.Bijective (Ψ r) := by
    intro r
    let _ := hEpi_q r
    let M₀ : AddCommGrpCat.{u} := (ℳ_bar r).obj.obj (Opposite.op T_S)
    let ε₀ : C.obj M₀ ⟶ ℳ_bar r := adj_S.counit.app (ℳ_bar r)
    obtain ⟨hFin_M, hIso_counit⟩ := hConst_M r T_S hT_S
    let _ : Finite ↥M₀ := hFin_M
    let _ : CategoryTheory.IsIso ε₀ := hIso_counit
    obtain ⟨hTor_M₀, e_H0_fn, μ_M₀, he_H0_bij, hμ_M₀_val, he_H0_fac⟩ := hLevelFac r
    let e_ε := CategoryTheory.asIso ε₀
    have hPostEpsBij : Function.Bijective
        ((CategoryTheory.Abelian.Ext.mk₀ ε₀).postcomp Fℤ (Nat.add_zero 2)) := by
      refine ⟨fun w₁ w₂ h12 => ?_, fun z =>
        ⟨(CategoryTheory.Abelian.Ext.mk₀ e_ε.inv).postcomp Fℤ (Nat.add_zero 2) z, ?_⟩⟩
      · have h' := congrArg
