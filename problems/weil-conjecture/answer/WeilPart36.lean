        [AlgebraicGeometry.Etale w] [AlgebraicGeometry.Etale w₁]
        (π_W : W₁ ⟶ W)
        (π_WU : CategoryTheory.Limits.pullback j_d w₁ ⟶ CategoryTheory.Limits.pullback j_d w),
