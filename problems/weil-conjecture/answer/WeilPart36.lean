    obtain ⟨p_β, hp_β⟩ := hPullEx β_a ℓ b
    obtain ⟨p_a, hp_a⟩ := hPullEx fst_ua ℓ b
    obtain ⟨p_comp, hp_comp⟩ := hPullEx (β_a ≫ fst_ua) ℓ b
