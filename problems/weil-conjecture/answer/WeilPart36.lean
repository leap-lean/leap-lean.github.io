                _ = k * ℓ ^ (r' + 2) + (a + b).val * ℓ ^ (r' + 1) := by rw [← hpow_succ]
            have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r' + 2)))) hnat
