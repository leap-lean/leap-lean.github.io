        have hα_zero : α_Qb = 0 := by
          let α' : (CategoryTheory.presheafToSheaf J_D AddCommGrpCat.{u}).obj constℤ_D ⟶
              pf_η.obj (pb_η.obj Q_b) := α_Qb
          suffices h0 : α' = 0 from h0
          apply (adj_sh_D.homEquiv constℤ_D (pf_η.obj (pb_η.obj Q_b))).injective
          have hlhs : (adj_sh_D.homEquiv constℤ_D (pf_η.obj (pb_η.obj Q_b))) α' = β_Qb :=
            CategoryTheory.Adjunction.homEquiv_unit adj_sh_D constℤ_D _ α'
          have hrhs : (adj_sh_D.homEquiv constℤ_D (pf_η.obj (pb_η.obj Q_b))) 0 = 0 := by
            rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_zero,
              CategoryTheory.Limits.comp_zero]
          rw [hlhs, hrhs]
          exact hη_α0
        have hpb_π0 : pb_η.map π_Qb = 0 := by
          apply (adj_η.homEquiv (C_D.obj Eℤ) (pb_η.obj Q_b)).injective
          have hlhs : (adj_η.homEquiv (C_D.obj Eℤ) (pb_η.obj Q_b)) (pb_η.map π_Qb) = α_Qb := by
            rw [CategoryTheory.Adjunction.homEquiv_unit]
            exact (adj_η.unit.naturality π_Qb).symm
          have hrhs : (adj_η.homEquiv (C_D.obj Eℤ) (pb_η.obj Q_b)) 0 = 0 := by
            rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_zero,
              CategoryTheory.Limits.comp_zero]
          rw [hlhs, hrhs]
          exact hα_zero
        have _ : CategoryTheory.Epi π_Qb := hEpiCok_D (CategoryTheory.Limits.kernel.ι ψ_b)
        have _ : CategoryTheory.Epi (pb_η.map π_Qb) := pb_η.map_epi π_Qb
        have hid_zero : 𝟙 (pb_η.obj Q_b) = 0 := by
          apply (cancel_epi (pb_η.map π_Qb)).mp
          rw [Category.comp_id, CategoryTheory.Limits.comp_zero, hpb_π0]
        have hZero_pb : CategoryTheory.Limits.IsZero (pb_η.obj Q_b) :=
          (CategoryTheory.Limits.IsZero.iff_id_eq_zero (pb_η.obj Q_b)).mpr hid_zero
        exact CategoryTheory.Limits.IsZero.of_iso hZero_pb e_I.symm
      have heb_g0 : e_b ≫ g₀ = 0 := by
        have h1 := congrArg (adj_D.homEquiv Eℤ G) hψ_b_zero
        rw [CategoryTheory.Adjunction.homEquiv_naturality_left] at h1
        change e_b ≫ g₀ = (adj_D.homEquiv Eℤ G) 0 at h1
        rwa [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_zero,
          CategoryTheory.Limits.comp_zero] at h1
      have hval := congrArg (fun f : Eℤ ⟶ _ => f.hom (ULift.up (1 : ℤ))) heb_g0
      exact (congrArg g₀.hom (one_zsmul b)).symm.trans hval
    have hLocSurj_Ψ : CategoryTheory.Sheaf.IsLocallySurjective Ψ := by
      refine ⟨fun {U} t =>
        (hMemEtale D U (CategoryTheory.Presheaf.imageSieve Ψ.hom t)).mpr ?_⟩
      intro x
      let t_B : ↥((C_D.obj B).obj.obj (Opposite.op U)) :=
        ((CategoryTheory.Limits.kernel.ι φ).hom.app (Opposite.op U)) t
      have hφ_tB : (φ.hom.app (Opposite.op U)) t_B = 0 := by
        change (((CategoryTheory.Limits.kernel.ι φ ≫ φ).hom.app (Opposite.op U)) t) = 0
        rw [CategoryTheory.Limits.kernel.condition]
        rfl
      have _ : CategoryTheory.Presheaf.IsLocallySurjective J_D
          (CategoryTheory.toSheafify J_D constB_D) := inferInstance
      have hImg : CategoryTheory.Presheaf.imageSieve η_sh_B t_B ∈ J_D U :=
        CategoryTheory.Presheaf.imageSieve_mem J_D (CategoryTheory.toSheafify J_D constB_D) t_B
      obtain ⟨Y_v, f_v, y₀, ⟨b, hb_eq⟩, hf_et, hf_pt⟩ := (hMemEtale D U _).mp hImg x
      have hφ_b0 : (φ.hom.app (Opposite.op Y_v)) (η_sh_B.app (Opposite.op Y_v) b) = 0 := by
        rw [hb_eq]
        have hnat := congrArg (fun k_fn => k_fn t_B) (φ.hom.naturality f_v.op)
        exact hnat.trans ((congrArg (G.obj.map f_v.op) hφ_tB).trans (map_zero _))
      have hb_ker : b ∈ g₀.hom.ker := hElemInKer Y_v ⟨y₀⟩ b hφ_b0
      let b₀ : ↥B₀ := ⟨b, hb_ker⟩
      let s₀_sec : ↥((C_D.obj B₀).obj.obj (Opposite.op Y_v)) := η_sh_B0.app (Opposite.op Y_v) b₀
      have hΨ_s0 : (Ψ.hom.app (Opposite.op Y_v)) s₀_sec =
          ((CategoryTheory.Limits.kernel φ).obj.map f_v.op) t := by
        let ev_Yv : CategoryTheory.Sheaf J_D AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
          CategoryTheory.sheafToPresheaf J_D AddCommGrpCat.{u} ⋙
            (CategoryTheory.evaluation (D.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op Y_v)
        have hMono_ker_Yv : CategoryTheory.Mono
            ((CategoryTheory.Limits.kernel.ι φ).hom.app (Opposite.op Y_v)) :=
          ev_Yv.map_mono (CategoryTheory.Limits.kernel.ι φ)
        have hInj_ker_Yv : Function.Injective
            ((CategoryTheory.Limits.kernel.ι φ).hom.app (Opposite.op Y_v)) :=
          (AddCommGrpCat.mono_iff_injective _).mp hMono_ker_Yv
        apply hInj_ker_Yv
        have hlhs : ((CategoryTheory.Limits.kernel.ι φ).hom.app (Opposite.op Y_v))
            ((Ψ.hom.app (Opposite.op Y_v)) s₀_sec) = η_sh_B.app (Opposite.op Y_v) b := by
          change (((Ψ ≫ CategoryTheory.Limits.kernel.ι φ).hom.app (Opposite.op Y_v)) s₀_sec) = _
          rw [hΨ_ι]
          exact hNat_ιB0 Y_v b₀
        have hrhs : ((CategoryTheory.Limits.kernel.ι φ).hom.app (Opposite.op Y_v))
            (((CategoryTheory.Limits.kernel φ).obj.map f_v.op) t) =
            ((C_D.obj B).obj.map f_v.op) t_B := by
          have hnat := congrArg (fun k_fn => k_fn t)
            ((CategoryTheory.Limits.kernel.ι φ).hom.naturality f_v.op)
          simpa only [AddCommGrpCat.comp_apply] using hnat
        rw [hlhs, hrhs, hb_eq]
      exact ⟨Y_v, f_v, y₀, ⟨s₀_sec, hΨ_s0⟩, hf_et, hf_pt⟩
    have _ : CategoryTheory.Epi Ψ :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} Ψ).mp hLocSurj_Ψ
    have _ : CategoryTheory.IsIso Ψ := CategoryTheory.isIso_of_mono_of_epi Ψ
    exact ⟨B₀, hFinB₀, ⟨CategoryTheory.asIso Ψ⟩⟩

  
  have hSepRes : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      IsSepClosed (IsLocalRing.ResidueField K) := by
    intro K _ _
    have hbij : Function.Bijective (IsLocalRing.residue K) :=
      ⟨RingHom.injective (IsLocalRing.residue K), Ideal.Quotient.mk_surjective⟩
    let e : K ≃+* IsLocalRing.ResidueField K := RingEquiv.ofBijective (IsLocalRing.residue K) hbij
    have _ : IsAlgClosed (IsLocalRing.ResidueField K) :=
      IsAlgClosed.of_exists_root _ fun p hmon hirr => by
        let p₀ : Polynomial K := p.map e.symm.toRingHom
        have hp₀_deg : p₀.degree ≠ 0 := by
          rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
          exact ne_of_gt (Irreducible.degree_pos hirr)
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p₀ hp₀_deg
        refine ⟨e c, ?_⟩
        have hev : Polynomial.eval c p₀ = e.symm (Polynomial.eval (e c) p) := by
          dsimp [p₀]
          rw [Polynomial.eval_map]
          conv_lhs => rw [← e.symm_apply_apply c]
          exact (Polynomial.hom_eval₂ p (RingHom.id _) e.symm.toRingHom (e c)).symm
        have hc0 : e.symm (Polynomial.eval (e c) p) = 0 := hev.symm.trans hc
        simpa using congrArg e hc0
    infer_instance

  have hSamePtZero : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (Q_S : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (Ω₀ K₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀] [Field K₀] [IsAlgClosed K₀]
      (z₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ S)
      (z₂ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ S),
      z₂.base (⊥ : PrimeSpectrum K₀) = z₁.base (⊥ : PrimeSpectrum Ω₀) →
      (∀ (I₁ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z₁ Q_S I₁ → CategoryTheory.Limits.IsZero I₁) →
      ∀ (I₂ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K₀)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z₂ Q_S I₂ → CategoryTheory.Limits.IsZero I₂ := by
    intro S Q_S Ω₀ K₀ _ _ _ _ z₁ z₂ hpt hZero₁ I₂ hPB₂
    obtain ⟨w₀, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := z₂) (g := z₁)
        (⊥ : PrimeSpectrum K₀) (⊥ : PrimeSpectrum Ω₀) hpt
    let P_zz := CategoryTheory.Limits.pullback z₂ z₁
    let κ_w : Type u := ↥(P_zz.residueField w₀)
    let Ω' : Type u := AlgebraicClosure κ_w
    let u_w : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶ P_zz :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ_w Ω')) ≫
        P_zz.fromSpecResidueField w₀
    let α₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of K₀) :=
      u_w ≫ CategoryTheory.Limits.pullback.fst z₂ z₁
    let α₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of Ω₀) :=
      u_w ≫ CategoryTheory.Limits.pullback.snd z₂ z₁
    have hcomm : α₂ ≫ z₂ = α₁ ≫ z₁ := by
      change (u_w ≫ CategoryTheory.Limits.pullback.fst z₂ z₁) ≫ z₂ =
        (u_w ≫ CategoryTheory.Limits.pullback.snd z₂ z₁) ≫ z₁
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc]
    obtain ⟨I₁, hPB₁, -⟩ := hExPB_ex z₁ Q_S
    have hZ_I₁ : CategoryTheory.Limits.IsZero I₁ := hZero₁ I₁ hPB₁
    obtain ⟨I', hPB_α₁, _, hZ_imp⟩ := hExPB_ex α₁ I₁
    have hZ_I' : CategoryTheory.Limits.IsZero I' := hZ_imp hZ_I₁
    have hPB_comp : WeilIsEtaleSheafPullback (α₂ ≫ z₂) Q_S I' := by
      rw [hcomm]
      exact (hCompPB_ex α₁ z₁ Q_S I₁ I').1 hPB₁ hPB_α₁
    have hPB_α₂ : WeilIsEtaleSheafPullback α₂ I₂ I' :=
      (hCompPB_ex α₂ z₂ Q_S I₂ I').2 hPB₂ hPB_comp
    have _ : HenselianLocalRing K₀ := Field.henselian K₀
    have _ : IsSepClosed (IsLocalRing.ResidueField K₀) := hSepRes K₀
    obtain ⟨e_H0⟩ := (weil_strictly_henselian_spec_etale_eval_and_pullback K₀).2 Ω' α₂
      (fun pt => Subsingleton.elim (α₂.base pt) (IsLocalRing.closedPoint K₀))
      I₂ I' hPB_α₂
    let S_Ω' := AlgebraicGeometry.Spec (CommRingCat.of Ω')
    let T_Ω' := weilEtaleIdTerminal.{u} S_Ω'
    let hT_Ω' := weilEtaleIdTerminalIsTerminal.{u} S_Ω'
    let e_ev : I'.H 0 ≃+ ↥(I'.obj.obj (Opposite.op T_Ω')) :=
      CategoryTheory.Sheaf.H.equiv₀ I' hT_Ω'
    have hZero_obj : CategoryTheory.Limits.IsZero (I'.obj.obj (Opposite.op T_Ω')) := by
      let ev_T : CategoryTheory.Sheaf S_Ω'.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        CategoryTheory.sheafToPresheaf S_Ω'.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (CategoryTheory.evaluation (S_Ω'.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_Ω')
      exact ev_T.map_isZero hZ_I'
    have hSub_obj : Subsingleton ↥(I'.obj.obj (Opposite.op T_Ω')) :=
      ⟨fun a b => by
        let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
        let fa : Eℤ ⟶ I'.obj.obj (Opposite.op T_Ω') :=
          AddCommGrpCat.ofHom
            { toFun := fun z => z.down • a
              map_zero' := zero_zsmul a
              map_add' := fun z₁ z₂ => add_zsmul a z₁.down z₂.down }
        let fb : Eℤ ⟶ I'.obj.obj (Opposite.op T_Ω') :=
          AddCommGrpCat.ofHom
            { toFun := fun z => z.down • b
              map_zero' := zero_zsmul b
              map_add' := fun z₁ z₂ => add_zsmul b z₁.down z₂.down }
        have hfab : fa = fb := hZero_obj.eq_of_tgt fa fb
        have h1 := congrArg (fun g : Eℤ ⟶ _ => g.hom (ULift.up (1 : ℤ))) hfab
        exact (one_zsmul a).symm.trans (h1.trans (one_zsmul b))⟩
    have hSub_I' : Subsingleton (I'.H 0) := e_ev.toEquiv.subsingleton
    have hSub_I₂ : Subsingleton (I₂.H 0) := e_H0.symm.toEquiv.subsingleton
    exact hIsZeroOnSpecAlgClosed K₀ I₂ hSub_I₂

  have hCoimagePullback : ∀ {U D : AlgebraicGeometry.Scheme.{u}} (ι_y : U ⟶ D)
      (F_D R_D : CategoryTheory.Sheaf D.smallEtaleTopology AddCommGrpCat.{u})
      (ψ_D : F_D ⟶ R_D)
      (F_U R_U : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback ι_y F_D F_U →
      WeilIsEtaleSheafPullback ι_y R_D R_U →
      ∃ (ψ_U : F_U ⟶ R_U),
        WeilIsEtaleSheafPullback ι_y
          (CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ_D))
          (CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ_U)) := by
    intro U D ι_y F_D R_D ψ_D F_U R_U hPB_F hPB_R
    have hHasCo : ∀ W : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
          (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) :=
      fun _ => inferInstance
    have _ := hHasCo U
    have _ := hHasCo D
    let Q_D := CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ_D)
    let p_D : F_D ⟶ Q_D := CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ_D)
    let j_D : Q_D ⟶ R_D := CategoryTheory.Abelian.factorThruCoimage ψ_D
    obtain ⟨Q_U, hPB_Q, -⟩ := hExPB_ex ι_y Q_D
    obtain ⟨p_U, -, hPB_cok_p⟩ := hKerCokerPB ι_y F_D Q_D p_D F_U Q_U hPB_F hPB_Q
    obtain ⟨i_U, hPB_ker_j, -⟩ := hKerCokerPB ι_y Q_D R_D j_D Q_U R_U hPB_Q hPB_R
    have hZ_cok_pD : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel p_D) :=
      CategoryTheory.Limits.isZero_cokernel_of_epi p_D
    obtain ⟨C_pU0, hPB_cp0, _, hZ_cp0⟩ := hExPB_ex ι_y (CategoryTheory.Limits.cokernel p_D)
    obtain ⟨e_cp⟩ := hUniquePB ι_y (CategoryTheory.Limits.cokernel p_D) C_pU0
      (CategoryTheory.Limits.cokernel p_U) hPB_cp0 hPB_cok_p
    have hZ_cok_pU : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel p_U) :=
      CategoryTheory.Limits.IsZero.of_iso (hZ_cp0 hZ_cok_pD) e_cp.symm
    have _ : CategoryTheory.Epi p_U :=
      (CategoryTheory.Preadditive.epi_iff_isZero_cokernel p_U).mpr hZ_cok_pU
    have hZ_ker_jD : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel j_D) :=
      CategoryTheory.Limits.isZero_kernel_of_mono j_D
    obtain ⟨K_jU0, hPB_kj0, _, hZ_kj0⟩ := hExPB_ex ι_y (CategoryTheory.Limits.kernel j_D)
    obtain ⟨e_kj⟩ := hUniquePB ι_y (CategoryTheory.Limits.kernel j_D) K_jU0
      (CategoryTheory.Limits.kernel i_U) hPB_kj0 hPB_ker_j
    have hZ_ker_iU : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel i_U) :=
      CategoryTheory.Limits.IsZero.of_iso (hZ_kj0 hZ_ker_jD) e_kj.symm
    have _ : CategoryTheory.Mono i_U :=
      (CategoryTheory.Preadditive.mono_iff_isZero_kernel i_U).mpr hZ_ker_iU
    let ψ_U : F_U ⟶ R_U := p_U ≫ i_U
    have hker_pU : CategoryTheory.Limits.kernel.ι ψ_U ≫ p_U = 0 := by
      apply (cancel_mono i_U).mp
      rw [Category.assoc, CategoryTheory.Limits.kernel.condition ψ_U,
        CategoryTheory.Limits.zero_comp]
    let bar_pU : CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ_U) ⟶ Q_U :=
      CategoryTheory.Limits.cokernel.desc (CategoryTheory.Limits.kernel.ι ψ_U) p_U hker_pU
    have hπ_bar :
        CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ_U) ≫ bar_pU = p_U :=
      CategoryTheory.Limits.cokernel.π_desc (CategoryTheory.Limits.kernel.ι ψ_U) p_U hker_pU
    have _ : CategoryTheory.Epi
        (CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ_U) ≫ bar_pU) := by
      rw [hπ_bar]
      infer_instance
    have _ : CategoryTheory.Epi bar_pU :=
      CategoryTheory.epi_of_epi
        (CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ_U)) bar_pU
    have hbar_iU : bar_pU ≫ i_U = CategoryTheory.Abelian.factorThruCoimage ψ_U := by
      apply (cancel_epi (CategoryTheory.Limits.cokernel.π (CategoryTheory.Limits.kernel.ι ψ_U))).mp
      rw [← Category.assoc, hπ_bar]
      exact (CategoryTheory.Abelian.coimage.fac ψ_U).symm
    have _ : CategoryTheory.Mono (bar_pU ≫ i_U) := by
      rw [hbar_iU]
      infer_instance
    have _ : CategoryTheory.Mono bar_pU := CategoryTheory.mono_of_mono bar_pU i_U
    have _ : CategoryTheory.IsIso bar_pU := CategoryTheory.isIso_of_mono_of_epi bar_pU
    exact ⟨ψ_U, hIsoPB_ex ι_y Q_D Q_D Q_U _ hPB_Q ⟨CategoryTheory.Iso.refl Q_D⟩
      ⟨(CategoryTheory.asIso bar_pU).symm⟩⟩

  have hPolyPrime : ∀ (pt : PrimeSpectrum (Polynomial k)), pt.asIdeal ≠ ⊥ →
      ∃ a : k, pt.asIdeal = RingHom.ker (Polynomial.evalRingHom a) := by
    intro pt hne
    have hMax : pt.asIdeal.IsMaximal := IsPrime.to_maximal_ideal hne
    let g : Polynomial k := Submodule.IsPrincipal.generator pt.asIdeal
    have hspan : Ideal.span ({g} : Set (Polynomial k)) = pt.asIdeal :=
      Ideal.span_singleton_generator pt.asIdeal
    have hg_not_unit : ¬ IsUnit g := by
      intro hu
      apply hMax.ne_top
      rw [← hspan, Ideal.span_singleton_eq_top]
      exact hu
    have hg_deg : g.degree ≠ 0 := by
      intro hd0
      exact hg_not_unit (Polynomial.isUnit_iff_degree_eq_zero.mpr hd0)
    obtain ⟨a, ha⟩ := IsAlgClosed.exists_root g hg_deg
    refine ⟨a, hMax.eq_of_le ?_ ?_⟩
    · intro htop
      have h1 : (1 : Polynomial k) ∈ RingHom.ker (Polynomial.evalRingHom a) := by
        rw [htop]; trivial
      rw [RingHom.mem_ker, map_one] at h1
      exact one_ne_zero h1
    · rw [← hspan, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      exact ha

  have hPolyHomClosed : ∀ (K : Type u) [Field K] (φ : Polynomial k →+* K),
      RingHom.ker φ ≠ ⊥ →
      ∃ a : k, φ = (φ.comp Polynomial.C).comp (Polynomial.evalRingHom a) := by
    intro K _ φ hne
    obtain ⟨p, hp_mem, hp_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    let _ : Algebra k K := (φ.comp Polynomial.C).toAlgebra
    have hφ_eval : ∀ r : Polynomial k, Polynomial.aeval (φ Polynomial.X) r = φ r := by
      intro r
      induction r using Polynomial.induction_on' with
      | add r₁ r₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
      | monomial n c =>
        rw [Polynomial.aeval_monomial, ← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        rfl
    have hp_alg : IsAlgebraic k (φ Polynomial.X) := ⟨p, hp_ne, (hφ_eval p).trans hp_mem⟩
    have hp_int : _root_.IsIntegral k (φ Polynomial.X) := hp_alg.isIntegral
    let mp := minpoly k (φ Polynomial.X)
    have hm_deg : mp.degree ≠ 0 :=
      ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hp_int))
    obtain ⟨a, ha⟩ := IsAlgClosed.exists_root mp hm_deg
    obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr ha
    have hq_unit : IsUnit q_pol :=
      ((minpoly.irreducible hp_int).isUnit_or_isUnit hq_pol).resolve_left
        (Polynomial.not_isUnit_X_sub_C a)
    have hq_monic : q_pol.Monic :=
