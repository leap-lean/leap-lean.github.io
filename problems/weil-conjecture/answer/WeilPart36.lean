import WeilPart35
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_punctual_roof_const_push_mono_isIso_and_slice_cokernel_zero (ℓ : ℕ)
    {Z Z_U : AlgebraicGeometry.Scheme.{u}} (h : Z_U ⟶ Z)
    [_hc : (weilEtaleSitePullback h).IsContinuous Z.smallEtaleTopology Z_U.smallEtaleTopology]
    {T_U : Z_U.Etale} (hT_U : CategoryTheory.Limits.IsTerminal T_U)
    {T_Z : Z.Etale} (hT_Z : CategoryTheory.Limits.IsTerminal T_Z) :
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let F_Z := weilEtaleTorsionSheaf Z ℓ
    let F_ZU := weilEtaleTorsionSheaf Z_U ℓ
    let pf_h := (weilEtaleSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} Z.smallEtaleTopology Z_U.smallEtaleTopology
    let adj_U := CategoryTheory.constantSheafAdj Z_U.smallEtaleTopology AddCommGrpCat.{u} hT_U
    let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
    let τ := hT_U.from ((weilEtaleSitePullback h).obj T_Z)
    let α_h : F_Z ⟶ pf_h.obj F_ZU :=
      (adj_Z.homEquiv AM (pf_h.obj F_ZU)).symm
        (CategoryTheory.CategoryStruct.comp (adj_U.unit.app AM) (F_ZU.obj.map (Opposite.op τ)))
    ((∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Z) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback h w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd h w) ℓ 0 ψ₀ →
        Function.Injective ψ₀) →
      CategoryTheory.Mono α_h) ∧
    (CategoryTheory.IsIso α_h →
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Z) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback h w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd h w) ℓ 0 ψ₀ →
        Function.Bijective ψ₀) ∧
    (∀ {V : AlgebraicGeometry.Scheme.{u}} (v : V ⟶ Z) [AlgebraicGeometry.Etale v],
      (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (u : W ⟶ V) [AlgebraicGeometry.Etale u],
        ∃ (W' : AlgebraicGeometry.Scheme.{u}) (w' : W' ⟶ Z_U) (h' : W' ⟶ W),
          CategoryTheory.IsPullback w' h' h (u ≫ v) ∧
          ∀ (ψ₀ : weilEtaleTorsionH W ℓ 0 →+ weilEtaleTorsionH W' ℓ 0),
            WeilIsTorsionEtalePullback h' ℓ 0 ψ₀ →
            Function.Bijective ψ₀) →
      ∃ (H_V : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback v (CategoryTheory.Limits.cokernel α_h) H_V ∧
        CategoryTheory.Limits.IsZero H_V) :=
by
  classical
  intro AM F_Z F_ZU pf_h adj_U adj_Z τ α_h
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hop_comp : ∀ {C : Type _} [CategoryTheory.Category C] {A B D : C}
      (g₁ : A ⟶ B) (g₂ : B ⟶ D),
      (g₁ ≫ g₂).op = g₂.op ≫ g₁.op := fun _ _ => rfl
  let isoToEquiv : ∀ {M₁ M₂ : AddCommGrpCat.{u}}, (M₁ ≅ M₂) → (↥M₁ ≃ ↥M₂) :=
    fun {M₁ M₂} e =>
      { toFun := fun x => e.hom.hom x
        invFun := fun y => e.inv.hom y
        left_inv := fun x => congrArg (fun k : M₁ ⟶ M₁ => k.hom x) e.hom_inv_id
        right_inv := fun y => congrArg (fun k : M₂ ⟶ M₂ => k.hom y) e.inv_hom_id }

  
  
  
  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale)
      (R : CategoryTheory.Sieve U),
      R ∈ S.smallEtaleTopology U ↔
        ∀ (x : ↥U.left), ∃ (Y₀ : S.Etale) (g : Y₀ ⟶ U) (y : ↥Y₀.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro S U R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl P_et)
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      P_et P_et S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance U R
    exact (iff_of_eq
      (congrArg (fun K : CategoryTheory.GrothendieckTopology S.Etale => R ∈ K U) heq)).trans hiff

  let termEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}), S.Etale :=
    fun S => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S) inferInstance
  have hTermEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (termEtale S) := by
    intro S
    exact CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U₀ => CategoryTheory.MorphismProperty.Over.homMk U₀.hom
        (CategoryTheory.Category.comp_id U₀.hom))
      (fun U₀ m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))

  obtain ⟨hPullEx, _, _, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}

  
  
  
  let evZ : ∀ (G : AddCommGrpCat.{u}), (Aℤ ⟶ G) ≃ ↥G := fun G =>
    { toFun := fun u => u.hom (ULift.up (1 : ℤ))
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun z => z.down • m
          map_zero' := zero_zsmul m
          map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
      left_inv := fun u => by
        apply AddCommGrpCat.ext
        rintro ⟨z⟩
        change z • u.hom (ULift.up (1 : ℤ)) = u.hom (ULift.up z)
        have hz : z • (ULift.up (1 : ℤ) : ↥Aℤ) = ULift.up z :=
          ULift.ext _ _ (by change z • (1 : ℤ) = z; simp)
        rw [← map_zsmul u.hom z (ULift.up (1 : ℤ)), hz]
      right_inv := fun m => one_zsmul m }

  have hDegZeroConj : ∀ {W W' : AlgebraicGeometry.Scheme.{u}} (h' : W' ⟶ W)
      (ψ₀ : weilEtaleTorsionH W ℓ 0 →+ weilEtaleTorsionH W' ℓ 0),
      WeilIsTorsionEtalePullback h' ℓ 0 ψ₀ →
      ∃ (hc' : (weilEtaleSitePullback h').IsContinuous
          W.smallEtaleTopology W'.smallEtaleTopology)
        (T₁ : W'.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : W.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        letI : (weilEtaleSitePullback h').IsContinuous
          W.smallEtaleTopology W'.smallEtaleTopology := hc'
        let B_h' := weilEtaleSitePullback h'
        let pf_h' := B_h'.sheafPushforwardContinuous
          AddCommGrpCat.{u} W.smallEtaleTopology W'.smallEtaleTopology
        let F_W := weilEtaleTorsionSheaf W ℓ
        let F_W' := weilEtaleTorsionSheaf W' ℓ
        let adj₁ := CategoryTheory.constantSheafAdj W'.smallEtaleTopology AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT₂
        let τ₁₂ := hT₁.from (B_h'.obj T₂)
        let α'_M : F_W ⟶ pf_h'.obj F_W' :=
          (adj₂.homEquiv AM (pf_h'.obj F_W')).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
              (F_W'.obj.map (Opposite.op τ₁₂)))
        ∃ (e₁ : weilEtaleTorsionH W ℓ 0 ≃ ↥(F_W.obj.obj (Opposite.op T₂)))
          (e₂ : weilEtaleTorsionH W' ℓ 0 ≃ ↥((pf_h'.obj F_W').obj.obj (Opposite.op T₂))),
          ∀ x : weilEtaleTorsionH W ℓ 0,
            e₂ (ψ₀ x) = (α'_M.hom.app (Opposite.op T₂)).hom (e₁ x) := by
    intro W W' h' ψ₀ hψ₀
    rcases hψ₀ with ⟨hc', hr', hAdd', hLim', hColim', T₁, hT₁, T₂, hT₂, ιℤ, _, hπι, hψ_eq⟩
    refine ⟨hc', T₁, hT₁, T₂, hT₂, ?_⟩
    have := hc'
    have := hr'
    have := hAdd'
    have := hLim'
    have := hColim'
    let B_h' : CategoryTheory.Functor W.Etale W'.Etale := weilEtaleSitePullback h'
    let J_W := W.smallEtaleTopology
    let J_W' := W'.smallEtaleTopology
    let F_W := weilEtaleTorsionSheaf W ℓ
    let F_W' := weilEtaleTorsionSheaf W' ℓ
    let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_W' := (CategoryTheory.constantSheaf J_W' AddCommGrpCat.{u}).obj Aℤ
    let pf_h' := B_h'.sheafPushforwardContinuous AddCommGrpCat.{u} J_W J_W'
    let pb_h' := B_h'.sheafPullback AddCommGrpCat.{u} J_W J_W'
    let adj_pull := B_h'.sheafAdjunctionContinuous AddCommGrpCat.{u} J_W J_W'
    let adj₁ := CategoryTheory.constantSheafAdj J_W' AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT₂
    let τ₁₂ := hT₁.from (B_h'.obj T₂)
    let α'_ℤ : Fℤ_W ⟶ pf_h'.obj Fℤ_W' :=
      (adj₂.homEquiv Aℤ (pf_h'.obj Fℤ_W')).symm
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
          (Fℤ_W'.obj.map (Opposite.op τ₁₂)))
    let α'_M : F_W ⟶ pf_h'.obj F_W' :=
      (adj₂.homEquiv AM (pf_h'.obj F_W')).symm
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
          (F_W'.obj.map (Opposite.op τ₁₂)))
    let πℤ : pb_h'.obj Fℤ_W ⟶ Fℤ_W' := (adj_pull.homEquiv Fℤ_W Fℤ_W').symm α'_ℤ
    let πM : pb_h'.obj F_W ⟶ F_W' := (adj_pull.homEquiv F_W F_W').symm α'_M
    have hExtMk₀ : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
        [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
        {Y₁ Y₂ : C_ab} (g : Y₁ ⟶ Y₂),
        CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
      intro C_ab _ _ _ Y₁ Y₂ g
      have hg := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
        (CategoryTheory.Abelian.Ext.addEquiv₀.symm g)
      rw [AddEquiv.apply_symm_apply] at hg
      rw [hg, AddEquiv.apply_symm_apply]
    let e_ext_W : weilEtaleTorsionH W ℓ 0 ≃ (Fℤ_W ⟶ F_W) :=
      (CategoryTheory.Abelian.Ext.addEquiv₀ : F_W.H 0 ≃+ (Fℤ_W ⟶ F_W)).toEquiv
    let e_ext_W' : weilEtaleTorsionH W' ℓ 0 ≃ (Fℤ_W' ⟶ F_W') :=
      (CategoryTheory.Abelian.Ext.addEquiv₀ : F_W'.H 0 ≃+ (Fℤ_W' ⟶ F_W')).toEquiv
    let T₀_W : W.Etale := termEtale W
    let hT_BT₀ : CategoryTheory.Limits.IsTerminal (B_h'.obj T₀_W) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U₀ => CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift (U₀.hom ≫ h') U₀.hom
            (CategoryTheory.Category.comp_id (U₀.hom ≫ h')))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _))
        (fun U₀ m => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Category.comp_id
                (m.left ≫ CategoryTheory.Limits.pullback.fst T₀_W.hom h')).symm.trans
              ((CategoryTheory.Category.assoc m.left
                  (CategoryTheory.Limits.pullback.fst T₀_W.hom h') (𝟙 W)).trans
                ((congrArg (m.left ≫ ·)
                    (CategoryTheory.Limits.pullback.condition (f := T₀_W.hom) (g := h'))).trans
                  ((CategoryTheory.Category.assoc m.left
                      (CategoryTheory.Limits.pullback.snd T₀_W.hom h') h').symm.trans
                    ((congrArg (· ≫ h') (CategoryTheory.MorphismProperty.Over.w m)).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm))))
          · exact (CategoryTheory.MorphismProperty.Over.w m).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    let e_τ : B_h'.obj T₂ ≅ T₁ :=
      B_h'.mapIso (hT₂.uniqueUpToIso (hTermEtale W)) ≪≫ hT_BT₀.uniqueUpToIso hT₁
    have he_τ_hom : e_τ.hom = τ₁₂ := hT₁.hom_ext e_τ.hom τ₁₂
    let e₁ : weilEtaleTorsionH W ℓ 0 ≃ ↥(F_W.obj.obj (Opposite.op T₂)) :=
      (e_ext_W.trans (adj₂.homEquiv Aℤ F_W)).trans (evZ (F_W.obj.obj (Opposite.op T₂)))
    let e₂ : weilEtaleTorsionH W' ℓ 0 ≃ ↥((pf_h'.obj F_W').obj.obj (Opposite.op T₂)) :=
      (((e_ext_W'.trans (adj₁.homEquiv Aℤ F_W')).trans (evZ (F_W'.obj.obj (Opposite.op T₁)))).trans
        (isoToEquiv (F_W'.obj.mapIso e_τ.op)))
    refine ⟨e₁, e₂, fun x => ?_⟩
    let f_x : Fℤ_W ⟶ F_W := e_ext_W x
    have hx_mk : x = CategoryTheory.Abelian.Ext.mk₀ f_x :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x).symm
    let g_y : Fℤ_W' ⟶ F_W' := ιℤ ≫ pb_h'.map f_x ≫ πM
    have hψ_hom : e_ext_W' (ψ₀ x) = g_y := by
      change CategoryTheory.Abelian.Ext.addEquiv₀ (ψ₀ x) = g_y
      rw [hψ_eq x, hx_mk]
      change CategoryTheory.Abelian.Ext.addEquiv₀
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((pb_h'.mapExtAddHom Fℤ_W F_W 0) (CategoryTheory.Abelian.Ext.mk₀ f_x))
          (Nat.zero_add 0)).comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 0)) = _
      rw [CategoryTheory.Functor.mapExtAddHom_apply pb_h' Fℤ_W F_W 0,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hExtMk₀, CategoryTheory.Category.assoc]
    have hπg : πℤ ≫ g_y = pb_h'.map f_x ≫ πM :=
      (CategoryTheory.Category.assoc πℤ ιℤ (pb_h'.map f_x ≫ πM)).symm.trans
        ((congrArg (· ≫ (pb_h'.map f_x ≫ πM)) hπι).trans
          (CategoryTheory.Category.id_comp _))
    have hmate₁ : α'_ℤ ≫ pf_h'.map g_y = f_x ≫ α'_M := by
      have hl : (adj_pull.homEquiv Fℤ_W F_W') (πℤ ≫ g_y) = α'_ℤ ≫ pf_h'.map g_y :=
        (adj_pull.homEquiv_naturality_right πℤ g_y).trans
          (congrArg (· ≫ pf_h'.map g_y) ((adj_pull.homEquiv Fℤ_W Fℤ_W').apply_symm_apply α'_ℤ))
      have hr : (adj_pull.homEquiv Fℤ_W F_W') (pb_h'.map f_x ≫ πM) = f_x ≫ α'_M :=
        (adj_pull.homEquiv_naturality_left f_x πM).trans
          (congrArg (f_x ≫ ·) ((adj_pull.homEquiv F_W F_W').apply_symm_apply α'_M))
      exact hl.symm.trans ((congrArg (adj_pull.homEquiv Fℤ_W F_W') hπg).trans hr)
    have hmate₂ : ((adj₁.homEquiv Aℤ F_W') g_y) ≫ F_W'.obj.map τ₁₂.op =
        ((adj₂.homEquiv Aℤ F_W) f_x) ≫ α'_M.hom.app (Opposite.op T₂) := by
      have hl : (adj₂.homEquiv Aℤ (pf_h'.obj F_W')) (α'_ℤ ≫ pf_h'.map g_y) =
          ((adj₁.homEquiv Aℤ F_W') g_y) ≫ F_W'.obj.map τ₁₂.op :=
        (adj₂.homEquiv_naturality_right α'_ℤ (pf_h'.map g_y)).trans
          ((congrArg (· ≫ g_y.hom.app (Opposite.op (B_h'.obj T₂)))
              ((adj₂.homEquiv Aℤ (pf_h'.obj Fℤ_W')).apply_symm_apply _)).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (adj₁.unit.app Aℤ ≫ ·) (g_y.hom.naturality τ₁₂.op)).trans
                (CategoryTheory.Category.assoc _ _ _).symm)))
      have hr : (adj₂.homEquiv Aℤ (pf_h'.obj F_W')) (f_x ≫ α'_M) =
          ((adj₂.homEquiv Aℤ F_W) f_x) ≫ α'_M.hom.app (Opposite.op T₂) :=
        adj₂.homEquiv_naturality_right f_x α'_M
      exact hl.symm.trans ((congrArg (adj₂.homEquiv Aℤ (pf_h'.obj F_W')) hmate₁).trans hr)
    have h1 : e₂ (ψ₀ x) =
        (F_W'.obj.map τ₁₂.op).hom
          (((adj₁.homEquiv Aℤ F_W') g_y).hom (ULift.up (1 : ℤ))) :=
      (congrArg (fun k : B_h'.obj T₂ ⟶ T₁ =>
          (F_W'.obj.map k.op).hom
            (((adj₁.homEquiv Aℤ F_W') (e_ext_W' (ψ₀ x))).hom (ULift.up (1 : ℤ))))
        he_τ_hom).trans
        (congrArg (fun m : Fℤ_W' ⟶ F_W' =>
            (F_W'.obj.map τ₁₂.op).hom (((adj₁.homEquiv Aℤ F_W') m).hom (ULift.up (1 : ℤ))))
          hψ_hom)
    exact h1.trans (congrArg (fun m : Aℤ ⟶ F_W'.obj.obj (Opposite.op (B_h'.obj T₂)) =>
      m.hom (ULift.up (1 : ℤ))) hmate₂)

  
  
  
  have hAlphaSheafify : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : S₁ ⟶ S₂)
      [_hc_f : (weilEtaleSitePullback f).IsContinuous
        S₂.smallEtaleTopology S₁.smallEtaleTopology]
      {TS₁ : S₁.Etale} (hTS₁ : CategoryTheory.Limits.IsTerminal TS₁)
      {TS₂ : S₂.Etale} (hTS₂ : CategoryTheory.Limits.IsTerminal TS₂),
      let B_f := weilEtaleSitePullback f
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let G₁ := weilEtaleTorsionSheaf S₁ ℓ
      let G₂ := weilEtaleTorsionSheaf S₂ ℓ
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hTS₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hTS₂
      let τ_f := hTS₁.from (B_f.obj TS₂)
      let α_f : G₂ ⟶ pf_f.obj G₁ :=
        (adj₂.homEquiv AM (pf_f.obj G₁)).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (G₁.obj.map (Opposite.op τ_f)))
      let const₁ := (CategoryTheory.Functor.const (S₁.Etale)ᵒᵖ).obj AM
      let const₂ := (CategoryTheory.Functor.const (S₂.Etale)ᵒᵖ).obj AM
      let η₁ := CategoryTheory.toSheafify J₁ const₁
      let η₂ := CategoryTheory.toSheafify J₂ const₂
      η₂ ≫ α_f.hom = CategoryTheory.Functor.whiskerLeft B_f.op η₁ := by
    intro S₁ S₂ f _hc_f TS₁ hTS₁ TS₂ hTS₂ B_f J₁ J₂ G₁ G₂ pf_f adj₁ adj₂ τ_f α_f
      const₁ const₂ η₁ η₂
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let α_tilde : G₂ ⟶ pf_f.obj G₁ :=
      (adj_sh₂.homEquiv const₂ (pf_f.obj G₁)).symm (CategoryTheory.Functor.whiskerLeft B_f.op η₁)
    have hη_tilde : η₂ ≫ α_tilde.hom = CategoryTheory.Functor.whiskerLeft B_f.op η₁ :=
      (adj_sh₂.homEquiv const₂ (pf_f.obj G₁)).apply_symm_apply
        (CategoryTheory.Functor.whiskerLeft B_f.op η₁)
    have hα_eq : α_f = α_tilde := by
      apply (adj₂.homEquiv AM (pf_f.obj G₁)).injective
      have hlhs : (adj₂.homEquiv AM (pf_f.obj G₁)) α_f =
          η₁.app (Opposite.op TS₁) ≫ G₁.obj.map τ_f.op :=
        (adj₂.homEquiv AM (pf_f.obj G₁)).apply_symm_apply _
      have hrhs : (adj₂.homEquiv AM (pf_f.obj G₁)) α_tilde =
          η₁.app (Opposite.op (B_f.obj TS₂)) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj₂ AM (pf_f.obj G₁) α_tilde).trans
          (congrArg (fun ν : const₂ ⟶ (pf_f.obj G₁).obj => ν.app (Opposite.op TS₂)) hη_tilde)
      have hnat : η₁.app (Opposite.op TS₁) ≫ G₁.obj.map τ_f.op =
          η₁.app (Opposite.op (B_f.obj TS₂)) :=
        (η₁.naturality τ_f.op).symm.trans (CategoryTheory.Category.id_comp _)
      exact hlhs.trans (hnat.trans hrhs.symm)
    exact (congrArg (fun β : G₂ ⟶ pf_f.obj G₁ => η₂ ≫ β.hom) hα_eq).trans hη_tilde

  let sliceEtale : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (_g : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale _g → CategoryTheory.Functor Y₁.Etale Y₂.Etale :=
    fun {_ _} _ hg => CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hg

  have hSliceCont : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (g : Y₁ ⟶ Y₂)
      (hg : AlgebraicGeometry.Etale g),
      (sliceEtale g hg).IsContinuous Y₁.smallEtaleTopology Y₂.smallEtaleTopology := by
    intro Y₁ Y₂ g hg
    let M_g := sliceEtale g hg
    have hCompat : CategoryTheory.CompatiblePreserving Y₂.smallEtaleTopology M_g := by
      refine ⟨fun ℱ {V₀} {T_pr} {x} hx {U₁ U₂ W_ov} f₁ f₂ {g₁ g₂} hg₁ hg₂ hcomm => ?_⟩
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hcomm
      have hEt_comp : (f₁.left ≫ U₁.hom) ≫ g = W_ov.hom :=
        (CategoryTheory.Category.assoc f₁.left U₁.hom g).trans
          (CategoryTheory.MorphismProperty.Over.w f₁)
      have hEt' : AlgebraicGeometry.Etale (f₁.left ≫ U₁.hom) :=
        CategoryTheory.MorphismProperty.of_postcomp P_et
          (f₁.left ≫ U₁.hom) g hg (hEt_comp.symm ▸ W_ov.prop)
      let W' : Y₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ U₁.hom) hEt'
      have hf₂_w : f₂.left ≫ U₂.hom = f₁.left ≫ U₁.hom :=
        (congrArg (f₂.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
          ((CategoryTheory.Category.assoc f₂.left g₂.left V₀.hom).symm.trans
            ((congrArg (· ≫ V₀.hom) hleft.symm).trans
              ((CategoryTheory.Category.assoc f₁.left g₁.left V₀.hom).trans
                (congrArg (f₁.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁)))))
      let f₁_lift : W' ⟶ U₁ :=
        CategoryTheory.MorphismProperty.Over.homMk (f₁.left : W'.left ⟶ U₁.left) rfl
      let f₂_lift : W' ⟶ U₂ :=
        CategoryTheory.MorphismProperty.Over.homMk (f₂.left : W'.left ⟶ U₂.left) hf₂_w
      have hcomm' : f₁_lift ≫ g₁ = f₂_lift ≫ g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hleft (Subsingleton.elim _ _)
      have hx_eq := hx f₁_lift f₂_lift hg₁ hg₂ hcomm'
      let ε_W : W_ov ⟶ M_g.obj W' :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 W_ov.left : W_ov.left ⟶ (M_g.obj W').left)
          ((CategoryTheory.Category.id_comp ((f₁.left ≫ U₁.hom) ≫ g)).trans hEt_comp)
      have hε₁ : ε_W ≫ M_g.map f₁_lift = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₁.left) (Subsingleton.elim _ _)
      have hε₂ : ε_W ≫ M_g.map f₂_lift = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₂.left) (Subsingleton.elim _ _)
      have hl_map : ℱ.obj.map f₁.op = ℱ.obj.map (M_g.map f₁_lift).op ≫ ℱ.obj.map ε_W.op :=
        (congrArg ℱ.obj.map (congrArg Opposite.op hε₁.symm)).trans (ℱ.obj.map_comp _ _)
      have hr_map : ℱ.obj.map f₂.op = ℱ.obj.map (M_g.map f₂_lift).op ≫ ℱ.obj.map ε_W.op :=
        (congrArg ℱ.obj.map (congrArg Opposite.op hε₂.symm)).trans (ℱ.obj.map_comp _ _)
      exact (congrArg (fun k : ℱ.obj.obj (Opposite.op (M_g.obj U₁)) ⟶
            ℱ.obj.obj (Opposite.op W_ov) =>
          CategoryTheory.ConcreteCategory.hom k (x g₁ hg₁)) hl_map).trans
        ((congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map ε_W.op)) hx_eq).trans
          (congrArg (fun k : ℱ.obj.obj (Opposite.op (M_g.obj U₂)) ⟶
              ℱ.obj.obj (Opposite.op W_ov) =>
            CategoryTheory.ConcreteCategory.hom k (x g₂ hg₂)) hr_map).symm)
    have hCov : CategoryTheory.CoverPreserving
        Y₁.smallEtaleTopology Y₂.smallEtaleTopology M_g := by
      refine ⟨fun {U₀} {S_cov} hS => ?_⟩
      refine (hMemEtale Y₂ (M_g.obj U₀) (S_cov.functorPushforward M_g)).mpr fun x => ?_
      obtain ⟨V₀, g₀, y₀, hg_S, hg_et, hg_pt⟩ := (hMemEtale Y₁ U₀ S_cov).mp hS x
      exact ⟨M_g.obj V₀, M_g.map g₀, y₀,
        ⟨V₀, g₀, 𝟙 (M_g.obj V₀), hg_S, (CategoryTheory.Category.id_comp _).symm⟩,
        hg_et, hg_pt⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  have hSliceCocont : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (g : Y₁ ⟶ Y₂)
      (hg : AlgebraicGeometry.Etale g),
      (sliceEtale g hg).IsCocontinuous Y₁.smallEtaleTopology Y₂.smallEtaleTopology := by
    intro Y₁ Y₂ g hg
    let M_g := sliceEtale g hg
    refine ⟨fun {U₀} {R} hR => ?_⟩
    refine (hMemEtale Y₁ U₀ (R.functorPullback M_g)).mpr fun x => ?_
    obtain ⟨X₀, u₀, y₀, hu_R, hu_et, hu_pt⟩ := (hMemEtale Y₂ (M_g.obj U₀) R).mp hR x
    have hX'_et : AlgebraicGeometry.Etale (u₀.left ≫ U₀.hom) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        u₀.left U₀.hom hu_et U₀.prop
    let X' : Y₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (u₀.left ≫ U₀.hom) hX'_et
    let u' : X' ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk u₀.left rfl
    let e_X : M_g.obj X' ⟶ X₀ :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 X₀.left : (M_g.obj X').left ⟶ X₀.left)
        ((CategoryTheory.Category.id_comp X₀.hom).trans
          ((CategoryTheory.MorphismProperty.Over.w u₀).symm.trans
            (CategoryTheory.Category.assoc u₀.left U₀.hom g).symm))
    have hmap_u' : M_g.map u' = e_X ≫ u₀ :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp u₀.left).symm (Subsingleton.elim _ _)
    have hu'_pull : (R.functorPullback M_g).arrows u' :=
      show R.arrows (M_g.map u') from
        Eq.mpr (congrArg (fun k => R.arrows k) hmap_u') (R.downward_closed hu_R e_X)
    exact ⟨X', u', y₀, hu'_pull, hu_et, hu_pt⟩

  have hSliceThetaIso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (g : Y₁ ⟶ Y₂)
      (hg : AlgebraicGeometry.Etale g),
      let M_g := sliceEtale g hg
      letI : M_g.IsContinuous Y₁.smallEtaleTopology Y₂.smallEtaleTopology := hSliceCont g hg
      let J₁ := Y₁.smallEtaleTopology
      let J₂ := Y₂.smallEtaleTopology
      let G₁ := weilEtaleTorsionSheaf Y₁ ℓ
      let G₂ := weilEtaleTorsionSheaf Y₂ ℓ
      let res_g := M_g.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
      let const₁ := (CategoryTheory.Functor.const (Y₁.Etale)ᵒᵖ).obj AM
      let const₂ := (CategoryTheory.Functor.const (Y₂.Etale)ᵒᵖ).obj AM
      let η₁ := CategoryTheory.toSheafify J₁ const₁
      let η₂ := CategoryTheory.toSheafify J₂ const₂
      let θ_g : G₁ ⟶ res_g.obj G₂ :=
        ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).homEquiv
          const₁ (res_g.obj G₂)).symm (CategoryTheory.Functor.whiskerLeft M_g.op η₂)
      (η₁ ≫ θ_g.hom = CategoryTheory.Functor.whiskerLeft M_g.op η₂) ∧
      CategoryTheory.IsIso θ_g := by
    intro Y₁ Y₂ g hg M_g J₁ J₂ G₁ G₂ res_g const₁ const₂ η₁ η₂ θ_g
    have : M_g.IsContinuous J₁ J₂ := hSliceCont g hg
    have : M_g.IsCocontinuous J₁ J₂ := hSliceCocont g hg
    let adj_sh₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    have hη_θ : η₁ ≫ θ_g.hom = CategoryTheory.Functor.whiskerLeft M_g.op η₂ :=
      (adj_sh₁.homEquiv const₁ (res_g.obj G₂)).apply_symm_apply
        (CategoryTheory.Functor.whiskerLeft M_g.op η₂)
    refine ⟨hη_θ, ?_⟩
    have hInj : ∀ U₀ : Y₁.Etale, Function.Injective (θ_g.hom.app (Opposite.op U₀)) := by
      intro U₀
      rw [injective_iff_map_eq_zero]
      intro s hs0
      have hImg : CategoryTheory.Presheaf.imageSieve η₁ s ∈ J₁ U₀ :=
        CategoryTheory.Presheaf.imageSieve_mem J₁ η₁ s
      refine G₁.isSeparated U₀ (CategoryTheory.Presheaf.imageSieve η₁ s) hImg s 0
        (fun V₀ g₀ hg₀ => ?_)
      refine Eq.trans ?_ (map_zero (G₁.obj.map g₀.op).hom).symm
      obtain ⟨a, ha⟩ := hg₀
      have hη₂_zero : (η₂.app (Opposite.op (M_g.obj V₀))) a =
          (η₂.app (Opposite.op (M_g.obj V₀))) 0 := by
        have h1 : (η₂.app (Opposite.op (M_g.obj V₀))) a =
            (θ_g.hom.app (Opposite.op V₀)) ((η₁.app (Opposite.op V₀)) a) :=
          (congrArg (fun ν : const₁ ⟶ (res_g.obj G₂).obj => (ν.app (Opposite.op V₀)) a) hη_θ).symm
        have hnat := congrArg (fun k => k s) (θ_g.hom.naturality g₀.op)
        exact h1.trans
          ((congrArg (θ_g.hom.app (Opposite.op V₀)) ha).trans
            (hnat.trans
              ((congrArg ((res_g.obj G₂).obj.map g₀.op) hs0).trans
                ((map_zero _).trans (map_zero (η₂.app (Opposite.op (M_g.obj V₀))).hom).symm))))
      let S_eq := CategoryTheory.Presheaf.equalizerSieve
        (F := const₂) (X := Opposite.op (M_g.obj V₀)) a 0
      have hSeq_mem : S_eq ∈ J₂ (M_g.obj V₀) :=
        CategoryTheory.Presheaf.equalizerSieve_mem J₂ η₂ a 0 hη₂_zero
      have hSpull_mem : S_eq.functorPullback M_g ∈ J₁ V₀ :=
        M_g.cover_lift J₁ J₂ hSeq_mem
      refine G₁.isSeparated V₀ (S_eq.functorPullback M_g) hSpull_mem
        ((G₁.obj.map g₀.op) s) 0 (fun V' k₀ hk₀ => ?_)
      have ha0 : (a : ↥AM) = 0 := hk₀
      have hnat' := congrArg (fun m => m a) (η₁.naturality k₀.op)
      exact (congrArg (G₁.obj.map k₀.op) ha.symm).trans
        (hnat'.symm.trans
          ((congrArg (η₁.app (Opposite.op V')).hom ha0).trans
            ((map_zero (η₁.app (Opposite.op V')).hom).trans
              (map_zero (G₁.obj.map k₀.op).hom).symm)))
    have _ : ∀ W_op : (Y₁.Etale)ᵒᵖ, CategoryTheory.Mono (θ_g.hom.app W_op) :=
      fun W_op => (AddCommGrpCat.mono_iff_injective _).mpr (hInj W_op.unop)
    have hMono_hom : CategoryTheory.Mono θ_g.hom :=
      (CategoryTheory.NatTrans.mono_iff_mono_app θ_g.hom).mpr inferInstance
    have _ : CategoryTheory.Mono θ_g :=
      (CategoryTheory.sheafToPresheaf J₁ AddCommGrpCat.{u}).mono_of_mono_map hMono_hom
    have hSurj : CategoryTheory.Sheaf.IsLocallySurjective θ_g := by
      refine ⟨fun {U₀} t => ?_⟩
      let R_img := CategoryTheory.Presheaf.imageSieve η₂ t
      have hR_mem : R_img ∈ J₂ (M_g.obj U₀) :=
        CategoryTheory.Presheaf.imageSieve_mem J₂ η₂ t
      have hRpull_mem : R_img.functorPullback M_g ∈ J₁ U₀ :=
        M_g.cover_lift J₁ J₂ hR_mem
      refine J₁.superset_covering (fun V₀ k₀ hk₀ => ?_) hRpull_mem
      obtain ⟨a, ha⟩ := hk₀
      refine ⟨(η₁.app (Opposite.op V₀)) a, ?_⟩
      have h1 : (θ_g.hom.app (Opposite.op V₀)) ((η₁.app (Opposite.op V₀)) a) =
          (η₂.app (Opposite.op (M_g.obj V₀))) a :=
        congrArg (fun ν : const₁ ⟶ (res_g.obj G₂).obj => (ν.app (Opposite.op V₀)) a) hη_θ
      exact h1.trans ha
    have _ : CategoryTheory.Epi θ_g := CategoryTheory.Sheaf.epi_of_isLocallySurjective θ_g
    exact CategoryTheory.isIso_of_mono_of_epi θ_g

  have hSquareEquiv : ∀ {W W' : AlgebraicGeometry.Scheme.{u}}
      (w : W ⟶ Z) (hw : AlgebraicGeometry.Etale w)
      (w' : W' ⟶ Z_U) (h' : W' ⟶ W)
      [_hc' : (weilEtaleSitePullback h').IsContinuous
        W.smallEtaleTopology W'.smallEtaleTopology]
      {T₁ : W'.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : W.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
      CategoryTheory.IsPullback w' h' h w →
      let B_h' := weilEtaleSitePullback h'
      let pf_h' := B_h'.sheafPushforwardContinuous
        AddCommGrpCat.{u} W.smallEtaleTopology W'.smallEtaleTopology
      let F_W := weilEtaleTorsionSheaf W ℓ
      let F_W' := weilEtaleTorsionSheaf W' ℓ
      let adj₁ := CategoryTheory.constantSheafAdj W'.smallEtaleTopology AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT₂
      let τ₁₂ := hT₁.from (B_h'.obj T₂)
      let α'_M : F_W ⟶ pf_h'.obj F_W' :=
        (adj₂.homEquiv AM (pf_h'.obj F_W')).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
            (F_W'.obj.map (Opposite.op τ₁₂)))
      let E_w : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w hw
      ∃ (e_dom : ↥(F_W.obj.obj (Opposite.op T₂)) ≃ ↥(F_Z.obj.obj (Opposite.op E_w)))
        (e_cod : ↥((pf_h'.obj F_W').obj.obj (Opposite.op T₂)) ≃
          ↥((pf_h.obj F_ZU).obj.obj (Opposite.op E_w))),
        ∀ s : ↥(F_W.obj.obj (Opposite.op T₂)),
          e_cod ((α'_M.hom.app (Opposite.op T₂)).hom s) =
            (α_h.hom.app (Opposite.op E_w)).hom (e_dom s) := by
    intro W W' w hw w' h' _hc' T₁ hT₁ T₂ hT₂ hpb
      B_h' pf_h' F_W F_W' adj₁ adj₂ τ₁₂ α'_M E_w
    have hw' : AlgebraicGeometry.Etale w' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hw
    let J_W := W.smallEtaleTopology
    let J_W' := W'.smallEtaleTopology
    let M_w := @sliceEtale W Z w hw
    let M_w' := @sliceEtale W' Z_U w' hw'
    have : M_w.IsContinuous J_W Z.smallEtaleTopology := @hSliceCont W Z w hw
    have : M_w'.IsContinuous J_W' Z_U.smallEtaleTopology := @hSliceCont W' Z_U w' hw'
    let res_w := M_w.sheafPushforwardContinuous AddCommGrpCat.{u} J_W Z.smallEtaleTopology
    let res_w' := M_w'.sheafPushforwardContinuous AddCommGrpCat.{u} J_W' Z_U.smallEtaleTopology
    let const_W := (CategoryTheory.Functor.const (W.Etale)ᵒᵖ).obj AM
    let const_W' := (CategoryTheory.Functor.const (W'.Etale)ᵒᵖ).obj AM
    let const_ZU := (CategoryTheory.Functor.const (Z_U.Etale)ᵒᵖ).obj AM
    let const_Z := (CategoryTheory.Functor.const (Z.Etale)ᵒᵖ).obj AM
    let η_W := CategoryTheory.toSheafify J_W const_W
    let η_W' := CategoryTheory.toSheafify J_W' const_W'
    let η_ZU := CategoryTheory.toSheafify Z_U.smallEtaleTopology const_ZU
    let η_Z := CategoryTheory.toSheafify Z.smallEtaleTopology const_Z
    let θ_w : F_W ⟶ res_w.obj F_Z :=
      ((CategoryTheory.sheafificationAdjunction J_W AddCommGrpCat.{u}).homEquiv
        const_W (res_w.obj F_Z)).symm (CategoryTheory.Functor.whiskerLeft M_w.op η_Z)
    let θ_w' : F_W' ⟶ res_w'.obj F_ZU :=
      ((CategoryTheory.sheafificationAdjunction J_W' AddCommGrpCat.{u}).homEquiv
        const_W' (res_w'.obj F_ZU)).symm (CategoryTheory.Functor.whiskerLeft M_w'.op η_ZU)
    obtain ⟨hη_θw, hIso_θw⟩ := @hSliceThetaIso W Z w hw
    obtain ⟨hη_θw', hIso_θw'⟩ := @hSliceThetaIso W' Z_U w' hw'
    have : CategoryTheory.IsIso θ_w := hIso_θw
    have : CategoryTheory.IsIso θ_w' := hIso_θw'
    let B_h : CategoryTheory.Functor Z.Etale Z_U.Etale := weilEtaleSitePullback h
    have hSqU : ∀ U₀ : W.Etale,
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst U₀.hom h')
          (CategoryTheory.Limits.pullback.snd U₀.hom h' ≫ w')
          (U₀.hom ≫ w) h :=
      fun U₀ => (CategoryTheory.IsPullback.of_hasPullback U₀.hom h').paste_vert hpb.flip
    let δ_U : ∀ U₀ : W.Etale, B_h.obj (M_w.obj U₀) ⟶ M_w'.obj (B_h'.obj U₀) :=
      fun U₀ => CategoryTheory.MorphismProperty.Over.homMk
        (hSqU U₀).isoPullback.inv (hSqU U₀).isoPullback_inv_snd
    let δ_inv_U : ∀ U₀ : W.Etale, M_w'.obj (B_h'.obj U₀) ⟶ B_h.obj (M_w.obj U₀) :=
      fun U₀ => CategoryTheory.MorphismProperty.Over.homMk
        (hSqU U₀).isoPullback.hom (hSqU U₀).isoPullback_hom_snd
    let e_δ : ∀ U₀ : W.Etale, B_h.obj (M_w.obj U₀) ≅ M_w'.obj (B_h'.obj U₀) :=
      fun U₀ =>
        { hom := δ_U U₀
          inv := δ_inv_U U₀
          hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (hSqU U₀).isoPullback.inv_hom_id (Subsingleton.elim _ _)
          inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            (hSqU U₀).isoPullback.hom_inv_id (Subsingleton.elim _ _) }
    have hδ_nat : ∀ {U₁ U₂ : W.Etale} (g : U₁ ⟶ U₂),
        B_h.map (M_w.map g) ≫ δ_U U₂ = δ_U U₁ ≫ M_w'.map (B_h'.map g) := by
      intro U₁ U₂ g
      have hinv_nat : δ_inv_U U₁ ≫ B_h.map (M_w.map g) =
          M_w'.map (B_h'.map g) ≫ δ_inv_U U₂ := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        change (hSqU U₁).isoPullback.hom ≫ (B_h.map (M_w.map g)).left =
          (B_h'.map g).left ≫ (hSqU U₂).isoPullback.hom
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hfst₁ : (B_h.map (M_w.map g)).left ≫
              CategoryTheory.Limits.pullback.fst (U₂.hom ≫ w) h =
              CategoryTheory.Limits.pullback.fst (U₁.hom ≫ w) h ≫ g.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hfst₂ : (B_h'.map g).left ≫ CategoryTheory.Limits.pullback.fst U₂.hom h' =
              CategoryTheory.Limits.pullback.fst U₁.hom h' ≫ g.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          exact (CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom
              (B_h.map (M_w.map g)).left _).trans
            ((congrArg ((hSqU U₁).isoPullback.hom ≫ ·) hfst₁).trans
              ((CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom _ g.left).symm.trans
                ((congrArg (· ≫ g.left) (hSqU U₁).isoPullback_hom_fst).trans
                  (hfst₂.symm.trans
                    ((congrArg ((B_h'.map g).left ≫ ·) (hSqU U₂).isoPullback_hom_fst.symm).trans
                      (CategoryTheory.Category.assoc (B_h'.map g).left
                        (hSqU U₂).isoPullback.hom _).symm)))))
        · have hsnd₁ : (B_h.map (M_w.map g)).left ≫
              CategoryTheory.Limits.pullback.snd (U₂.hom ≫ w) h =
              CategoryTheory.Limits.pullback.snd (U₁.hom ≫ w) h :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hsnd₂ : (B_h'.map g).left ≫ CategoryTheory.Limits.pullback.snd U₂.hom h' =
              CategoryTheory.Limits.pullback.snd U₁.hom h' :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          exact (CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom
              (B_h.map (M_w.map g)).left _).trans
            ((congrArg ((hSqU U₁).isoPullback.hom ≫ ·) hsnd₁).trans
              ((hSqU U₁).isoPullback_hom_snd.trans
                ((congrArg (· ≫ w') hsnd₂.symm).trans
                  ((CategoryTheory.Category.assoc (B_h'.map g).left _ w').trans
                    ((congrArg ((B_h'.map g).left ≫ ·) (hSqU U₂).isoPullback_hom_snd.symm).trans
                      (CategoryTheory.Category.assoc (B_h'.map g).left
                        (hSqU U₂).isoPullback.hom _).symm)))))
      exact (CategoryTheory.Category.id_comp (B_h.map (M_w.map g) ≫ δ_U U₂)).symm.trans
        ((congrArg (· ≫ (B_h.map (M_w.map g) ≫ δ_U U₂)) (e_δ U₁).hom_inv_id.symm).trans
          ((CategoryTheory.Category.assoc (e_δ U₁).hom (e_δ U₁).inv _).trans
            ((congrArg ((e_δ U₁).hom ≫ ·)
              ((CategoryTheory.Category.assoc (e_δ U₁).inv _ (δ_U U₂)).symm.trans
                ((congrArg (· ≫ δ_U U₂) hinv_nat).trans
                  ((CategoryTheory.Category.assoc (M_w'.map (B_h'.map g))
                    (e_δ U₂).inv (e_δ U₂).hom).trans
                    ((congrArg (M_w'.map (B_h'.map g) ≫ ·) (e_δ U₂).inv_hom_id).trans
                      (CategoryTheory.Category.comp_id _)))))))))
    let ε_sq : pf_h'.obj (res_w'.obj F_ZU) ⟶ res_w.obj (pf_h.obj F_ZU) :=
      CategoryTheory.ObjectProperty.homMk
        { app := fun U_op => F_ZU.obj.map (δ_U U_op.unop).op
          naturality := fun {U₁_op U₂_op} g_op =>
            (F_ZU.obj.map_comp _ _).symm.trans
              ((congrArg F_ZU.obj.map ((hop_comp _ _).symm.trans
                  (congrArg Opposite.op (hδ_nat g_op.unop).symm))).trans
                ((congrArg F_ZU.obj.map (hop_comp _ _)).trans (F_ZU.obj.map_comp _ _))) }
    have hComm_sh : θ_w ≫ res_w.map α_h = α'_M ≫ pf_h'.map θ_w' ≫ ε_sq := by
      let adj_shW := CategoryTheory.sheafificationAdjunction J_W AddCommGrpCat.{u}
      apply (adj_shW.homEquiv const_W (res_w.obj (pf_h.obj F_ZU))).injective
      refine (CategoryTheory.Adjunction.homEquiv_unit adj_shW const_W
        (res_w.obj (pf_h.obj F_ZU)) (θ_w ≫ res_w.map α_h)).trans
        (Eq.trans ?_
          (CategoryTheory.Adjunction.homEquiv_unit adj_shW const_W
            (res_w.obj (pf_h.obj F_ZU)) (α'_M ≫ pf_h'.map θ_w' ≫ ε_sq)).symm)
      have hα_h_sh := hAlphaSheafify h hT_U hT_Z
      have hα_h'_sh := hAlphaSheafify h' hT₁ hT₂
      refine CategoryTheory.NatTrans.ext (funext fun U_op => ?_)
      let U₀ := U_op.unop
      have hl : (η_W.app (Opposite.op U₀) ≫ θ_w.hom.app (Opposite.op U₀)) ≫
          α_h.hom.app (Opposite.op (M_w.obj U₀)) =
          η_ZU.app (Opposite.op (B_h.obj (M_w.obj U₀))) := by
        have h1 := congrArg (fun ν : const_W ⟶ (res_w.obj F_Z).obj => ν.app (Opposite.op U₀)) hη_θw
        have h2 := congrArg (fun ν : const_Z ⟶ (pf_h.obj F_ZU).obj =>
          ν.app (Opposite.op (M_w.obj U₀))) hα_h_sh
        exact (congrArg (· ≫ α_h.hom.app (Opposite.op (M_w.obj U₀))) h1).trans h2
      have hr : (η_W.app (Opposite.op U₀) ≫ α'_M.hom.app (Opposite.op U₀)) ≫
          (θ_w'.hom.app (Opposite.op (B_h'.obj U₀)) ≫ F_ZU.obj.map (δ_U U₀).op) =
          η_ZU.app (Opposite.op (B_h.obj (M_w.obj U₀))) := by
        have h1 := congrArg (fun ν : const_W ⟶ (pf_h'.obj F_W').obj =>
          ν.app (Opposite.op U₀)) hα_h'_sh
        have h2 := congrArg (fun ν : const_W' ⟶ (res_w'.obj F_ZU).obj =>
          ν.app (Opposite.op (B_h'.obj U₀))) hη_θw'
        have hnat : η_ZU.app (Opposite.op (M_w'.obj (B_h'.obj U₀))) ≫ F_ZU.obj.map (δ_U U₀).op =
            η_ZU.app (Opposite.op (B_h.obj (M_w.obj U₀))) :=
          (η_ZU.naturality (δ_U U₀).op).symm.trans (CategoryTheory.Category.id_comp _)
        exact (congrArg (· ≫ (θ_w'.hom.app (Opposite.op (B_h'.obj U₀)) ≫
            F_ZU.obj.map (δ_U U₀).op)) h1).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ F_ZU.obj.map (δ_U U₀).op) h2).trans hnat))
      exact (CategoryTheory.Category.assoc _ _ _).symm.trans
        (hl.trans (hr.symm.trans (CategoryTheory.Category.assoc _ _ _)))
    let e_TW0 : T₂ ≅ termEtale W := hT₂.uniqueUpToIso (hTermEtale W)
    let e_M0 : M_w.obj (termEtale W) ≅ E_w :=
      CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl W)
        (CategoryTheory.Category.id_comp w)
    let e_ME : M_w.obj T₂ ≅ E_w := M_w.mapIso e_TW0 ≪≫ e_M0
    let inv_θw : res_w.obj F_Z ⟶ F_W := CategoryTheory.inv θ_w
    let iso_θw_T₂ : F_W.obj.obj (Opposite.op T₂) ≅ (res_w.obj F_Z).obj.obj (Opposite.op T₂) :=
      { hom := θ_w.hom.app (Opposite.op T₂)
        inv := inv_θw.hom.app (Opposite.op T₂)
        hom_inv_id := congrArg (fun m : F_W ⟶ F_W => m.hom.app (Opposite.op T₂))
          (CategoryTheory.IsIso.hom_inv_id θ_w)
        inv_hom_id := congrArg (fun m : res_w.obj F_Z ⟶ res_w.obj F_Z =>
          m.hom.app (Opposite.op T₂)) (CategoryTheory.IsIso.inv_hom_id θ_w) }
    let inv_θw' : res_w'.obj F_ZU ⟶ F_W' := CategoryTheory.inv θ_w'
    let iso_pf_θw' : pf_h'.obj F_W' ≅ pf_h'.obj (res_w'.obj F_ZU) :=
      { hom := pf_h'.map θ_w'
        inv := pf_h'.map inv_θw'
        hom_inv_id := (pf_h'.map_comp θ_w' inv_θw').symm.trans
          ((congrArg pf_h'.map (CategoryTheory.IsIso.hom_inv_id θ_w')).trans
            (pf_h'.map_id F_W'))
        inv_hom_id := (pf_h'.map_comp inv_θw' θ_w').symm.trans
          ((congrArg pf_h'.map (CategoryTheory.IsIso.inv_hom_id θ_w')).trans
            (pf_h'.map_id (res_w'.obj F_ZU))) }
    let iso_pf_θ_T₂ : (pf_h'.obj F_W').obj.obj (Opposite.op T₂) ≅
        (pf_h'.obj (res_w'.obj F_ZU)).obj.obj (Opposite.op T₂) :=
      { hom := iso_pf_θw'.hom.hom.app (Opposite.op T₂)
        inv := iso_pf_θw'.inv.hom.app (Opposite.op T₂)
        hom_inv_id := congrArg (fun m : pf_h'.obj F_W' ⟶ pf_h'.obj F_W' =>
          m.hom.app (Opposite.op T₂)) iso_pf_θw'.hom_inv_id
        inv_hom_id := congrArg
          (fun m : pf_h'.obj (res_w'.obj F_ZU) ⟶ pf_h'.obj (res_w'.obj F_ZU) =>
            m.hom.app (Opposite.op T₂))
          iso_pf_θw'.inv_hom_id }
    let e_θw := isoToEquiv iso_θw_T₂
    let e_dom_Z := isoToEquiv (F_Z.obj.mapIso e_ME.symm.op)
    let e_dom := e_θw.trans e_dom_Z
    let e_pf_θ := isoToEquiv iso_pf_θ_T₂
    let e_ε := isoToEquiv (F_ZU.obj.mapIso (e_δ T₂).op)
    let e_cod_Z := isoToEquiv ((pf_h.obj F_ZU).obj.mapIso e_ME.symm.op)
    let e_cod := (e_pf_θ.trans e_ε).trans e_cod_Z
    refine ⟨e_dom, e_cod, fun s => ?_⟩
    have hcomm_app : α'_M.hom.app (Opposite.op T₂) ≫
          ((pf_h'.map θ_w').hom.app (Opposite.op T₂) ≫ ε_sq.hom.app (Opposite.op T₂)) =
        θ_w.hom.app (Opposite.op T₂) ≫ (res_w.map α_h).hom.app (Opposite.op T₂) :=
      congrArg (fun m : F_W ⟶ res_w.obj (pf_h.obj F_ZU) => m.hom.app (Opposite.op T₂))
        hComm_sh.symm
    have hstep1 : e_ε (e_pf_θ ((α'_M.hom.app (Opposite.op T₂)).hom s)) =
        (α_h.hom.app (Opposite.op (M_w.obj T₂))).hom (e_θw s) :=
      congrArg (fun m : F_W.obj.obj (Opposite.op T₂) ⟶
          (res_w.obj (pf_h.obj F_ZU)).obj.obj (Opposite.op T₂) => m.hom s) hcomm_app
    have hstep2 : e_cod_Z ((α_h.hom.app (Opposite.op (M_w.obj T₂))).hom (e_θw s)) =
        (α_h.hom.app (Opposite.op E_w)).hom (e_dom_Z (e_θw s)) :=
      congrArg (fun m : F_Z.obj.obj (Opposite.op (M_w.obj T₂)) ⟶
          (pf_h.obj F_ZU).obj.obj (Opposite.op E_w) => m.hom (e_θw s))
        (α_h.hom.naturality e_ME.inv.op).symm
    exact (congrArg e_cod_Z hstep1).trans hstep2

  
  have hSquareRel : ∀ {W W' : AlgebraicGeometry.Scheme.{u}}
      (w : W ⟶ Z) (hw : AlgebraicGeometry.Etale w)
      (w' : W' ⟶ Z_U) (h' : W' ⟶ W),
      CategoryTheory.IsPullback w' h' h w →
      ∀ (ψ₀ : weilEtaleTorsionH W ℓ 0 →+ weilEtaleTorsionH W' ℓ 0),
        WeilIsTorsionEtalePullback h' ℓ 0 ψ₀ →
        let E_w : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w hw
        (Function.Injective ψ₀ ↔ Function.Injective ((α_h.hom.app (Opposite.op E_w)).hom)) ∧
        (Function.Bijective ψ₀ ↔ Function.Bijective ((α_h.hom.app (Opposite.op E_w)).hom)) := by
    intro W W' w hw w' h' hpb ψ₀ hψ₀ E_w
    obtain ⟨hc', T₁, hT₁, T₂, hT₂, e₁, e₂, he₁₂⟩ := hDegZeroConj h' ψ₀ hψ₀
    have := hc'
    obtain ⟨e_dom, e_cod, he_sq⟩ := hSquareEquiv w hw w' h' hT₁ hT₂ hpb
    let e_L := e₁.trans e_dom
    let e_R := e₂.trans e_cod
    have hrel : ∀ x : weilEtaleTorsionH W ℓ 0,
        e_R (ψ₀ x) = (α_h.hom.app (Opposite.op E_w)).hom (e_L x) :=
      fun x => (congrArg e_cod (he₁₂ x)).trans (he_sq (e₁ x))
    have hfun_α : ((α_h.hom.app (Opposite.op E_w)).hom :
          ↥(F_Z.obj.obj (Opposite.op E_w)) → ↥((pf_h.obj F_ZU).obj.obj (Opposite.op E_w))) =
        ⇑e_R ∘ ⇑ψ₀ ∘ ⇑e_L.symm :=
      funext fun z =>
        (congrArg ((α_h.hom.app (Opposite.op E_w)).hom) (e_L.apply_symm_apply z).symm).trans
          (hrel (e_L.symm z)).symm
    have hfun_ψ : (⇑ψ₀ : weilEtaleTorsionH W ℓ 0 → weilEtaleTorsionH W' ℓ 0) =
        ⇑e_R.symm ∘ ((α_h.hom.app (Opposite.op E_w)).hom) ∘ ⇑e_L :=
      funext fun x => e_R.injective ((hrel x).trans (e_R.apply_symm_apply _).symm)
    refine ⟨⟨fun hInj => Eq.mp (congrArg Function.Injective hfun_α.symm)
        (e_R.injective.comp (hInj.comp e_L.symm.injective)),
      fun hInj => Eq.mp (congrArg Function.Injective hfun_ψ.symm)
        (e_R.symm.injective.comp (hInj.comp e_L.injective))⟩,
      ⟨fun hBij => Eq.mp (congrArg Function.Bijective hfun_α.symm)
        (e_R.bijective.comp (hBij.comp e_L.symm.bijective)),
      fun hBij => Eq.mp (congrArg Function.Bijective hfun_ψ.symm)
        (e_R.symm.bijective.comp (hBij.comp e_L.bijective))⟩⟩

  
  
  
  have hMonoOfAffEtale : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : G₁ ⟶ G₂),
      (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ S) (hw : AlgebraicGeometry.Etale w),
        Function.Injective
          ((φ.hom.app (Opposite.op (CategoryTheory.MorphismProperty.Over.mk ⊤ w hw))).hom)) →
      CategoryTheory.Mono φ := by
    intro S G₁ G₂ φ hAffInj
    have hInjD : ∀ D : S.Etale, Function.Injective ((φ.hom.app (Opposite.op D)).hom) := by
      intro D
      rw [injective_iff_map_eq_zero]
      intro s hs0
      let S₀ : CategoryTheory.Sieve D :=
        { arrows := fun {E} k => (G₁.obj.map k.op).hom s = 0
          downward_closed := fun {E E'} {k} hk g =>
            (congrArg (fun m : G₁.obj.obj (Opposite.op D) ⟶ G₁.obj.obj (Opposite.op E') =>
                m.hom s)
              (G₁.obj.map_comp k.op g.op)).trans
              ((congrArg (G₁.obj.map g.op).hom hk).trans (map_zero (G₁.obj.map g.op).hom)) }
      have hS₀_mem : S₀ ∈ S.smallEtaleTopology D := by
        refine (hMemEtale S D S₀).mpr fun d => ?_
        obtain ⟨U_d, hAff, hd_mem, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := d) (U := (⊤ : D.left.Opens)) trivial
        let W_d : AlgebraicGeometry.Scheme.{u} :=
          AlgebraicGeometry.Spec (D.left.presheaf.obj (Opposite.op U_d))
        have : AlgebraicGeometry.IsAffine W_d := inferInstance
        let ι_d : W_d ⟶ D.left := hAff.fromSpec
        have _ : AlgebraicGeometry.IsOpenImmersion ι_d := hAff.isOpenImmersion_fromSpec
        have hEt_ι : AlgebraicGeometry.Etale ι_d := inferInstance
        let w_d : W_d ⟶ S := ι_d ≫ D.hom
        have hw_d : AlgebraicGeometry.Etale w_d :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            ι_d D.hom hEt_ι D.prop
        let E_d : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w_d hw_d
        let k_d : E_d ⟶ D := CategoryTheory.MorphismProperty.Over.homMk ι_d rfl
        have hd_range : d ∈ Set.range ι_d.base := by
          rw [hAff.range_fromSpec]
          exact hd_mem
        rcases hd_range with ⟨y, hy⟩
        have hk_zero : (G₁.obj.map k_d.op).hom s = 0 := by
          apply hAffInj W_d w_d hw_d
          have hnat : (φ.hom.app (Opposite.op E_d)).hom ((G₁.obj.map k_d.op).hom s) =
              (G₂.obj.map k_d.op).hom ((φ.hom.app (Opposite.op D)).hom s) :=
            congrArg
              (fun m : G₁.obj.obj (Opposite.op D) ⟶ G₂.obj.obj (Opposite.op E_d) => m.hom s)
              (φ.hom.naturality k_d.op)
          exact hnat.trans
            ((congrArg (G₂.obj.map k_d.op).hom hs0).trans
              ((map_zero _).trans (map_zero (φ.hom.app (Opposite.op E_d)).hom).symm))
        exact ⟨E_d, k_d, y, hk_zero, hEt_ι, hy⟩
      refine G₁.isSeparated D S₀ hS₀_mem s 0 (fun E k hk => ?_)
      exact hk.trans (map_zero (G₁.obj.map k.op).hom).symm
    have _ : ∀ D_op : (S.Etale)ᵒᵖ, CategoryTheory.Mono (φ.hom.app D_op) :=
      fun D_op => (AddCommGrpCat.mono_iff_injective _).mpr (hInjD D_op.unop)
    have hMono_hom : CategoryTheory.Mono φ.hom :=
      (CategoryTheory.NatTrans.mono_iff_mono_app φ.hom).mpr inferInstance
    exact (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).mono_of_mono_map
      hMono_hom

  have hSliceCokernelZero : ∀ {V : AlgebraicGeometry.Scheme.{u}} (v : V ⟶ Z)
      [hv : AlgebraicGeometry.Etale v]
      [_hc_v : (weilEtaleSitePullback v).IsContinuous Z.smallEtaleTopology V.smallEtaleTopology]
      [_hr_v : ((weilEtaleSitePullback v).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z.smallEtaleTopology V.smallEtaleTopology).IsRightAdjoint]
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : G₁ ⟶ G₂),
      (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (u : W ⟶ V) [AlgebraicGeometry.Etale u] (hw : AlgebraicGeometry.Etale (u ≫ v)),
        Function.Bijective
          ((φ.hom.app (Opposite.op (CategoryTheory.MorphismProperty.Over.mk ⊤ (u ≫ v) hw))).hom)) →
      CategoryTheory.Limits.IsZero
        (((weilEtaleSitePullback v).sheafPullback
          AddCommGrpCat.{u} Z.smallEtaleTopology V.smallEtaleTopology).obj
            (CategoryTheory.Limits.cokernel φ)) := by
    intro V v hv _hc_v _hr_v G₁ G₂ φ hAffBij
    let J_V := V.smallEtaleTopology
    let J_Z := Z.smallEtaleTopology
    let M_v := @sliceEtale V Z v hv
    have : M_v.IsContinuous J_V J_Z := @hSliceCont V Z v hv
    let res_v := M_v.sheafPushforwardContinuous AddCommGrpCat.{u} J_V J_Z
    let B_v : CategoryTheory.Functor Z.Etale V.Etale := weilEtaleSitePullback v
    let pf_v := B_v.sheafPushforwardContinuous AddCommGrpCat.{u} J_Z J_V
    let pb_v := B_v.sheafPullback AddCommGrpCat.{u} J_Z J_V
    let adj_pb_v := B_v.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Z J_V
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) v :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) v :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let adj_MB : M_v ⊣ (CategoryTheory.MorphismProperty.Over.pullback
        (@AlgebraicGeometry.Etale) ⊤ v) :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj (@AlgebraicGeometry.Etale) ⊤ v hv trivial
    let unit_res : CategoryTheory.Functor.id (CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}) ⟶
        res_v ⋙ pf_v :=
      { app := fun F => CategoryTheory.ObjectProperty.homMk
          { app := fun D => F.obj.map (adj_MB.counit.app D.unop).op
            naturality := fun {D₁ D₂} f =>
              (F.obj.map_comp _ _).symm.trans
                ((congrArg F.obj.map (congrArg Opposite.op
                    (adj_MB.counit.naturality f.unop).symm)).trans
                  (F.obj.map_comp _ _)) }
        naturality := fun {F₁ F₂} m =>
          CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun D =>
            (m.hom.naturality (adj_MB.counit.app D.unop).op).symm)) }
    let counit_res : pf_v ⋙ res_v ⟶
        CategoryTheory.Functor.id (CategoryTheory.Sheaf J_V AddCommGrpCat.{u}) :=
      { app := fun G => CategoryTheory.ObjectProperty.homMk
          { app := fun U => G.obj.map (adj_MB.unit.app U.unop).op
            naturality := fun {U₁ U₂} f =>
              (G.obj.map_comp _ _).symm.trans
                ((congrArg G.obj.map (congrArg Opposite.op
                    (adj_MB.unit.naturality f.unop).symm)).trans
                  (G.obj.map_comp _ _)) }
        naturality := fun {G₁ G₂} m =>
          CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U =>
            (m.hom.naturality (adj_MB.unit.app U.unop).op).symm)) }
    let adj_res_v : res_v ⊣ pf_v :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit := unit_res
          counit := counit_res
          left_triangle := CategoryTheory.NatTrans.ext (funext fun F =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U_op =>
              (F.obj.map_comp
                (adj_MB.counit.app (M_v.obj U_op.unop)).op
                (M_v.map (adj_MB.unit.app U_op.unop)).op).symm.trans
                ((congrArg F.obj.map (congrArg Opposite.op
                    (adj_MB.left_triangle_components U_op.unop))).trans
                  (F.obj.map_id (Opposite.op (M_v.obj U_op.unop)))))))
          right_triangle := CategoryTheory.NatTrans.ext (funext fun G =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun D_op =>
              (G.obj.map_comp
                (B_v.map (adj_MB.counit.app D_op.unop)).op
                (adj_MB.unit.app (B_v.obj D_op.unop)).op).symm.trans
                ((congrArg G.obj.map (congrArg Opposite.op
                    (adj_MB.right_triangle_components D_op.unop))).trans
                  (G.obj.map_id (Opposite.op (B_v.obj D_op.unop))))))) }
    let e_pb : pb_v ≅ res_v := CategoryTheory.Adjunction.leftAdjointUniq adj_pb_v adj_res_v
    have hMono_res : CategoryTheory.Mono (res_v.map φ) := by
      apply hMonoOfAffEtale (res_v.map φ)
      intro W _ u hu
      have : AlgebraicGeometry.Etale u := hu
      have hw : AlgebraicGeometry.Etale (u ≫ v) :=
