  have hIso_γ : CategoryTheory.IsIso γ := ⟨⟨w, h_γw, h_wγ⟩⟩
  have hAdjUnitFromIso :
      ∀ {𝒟₁ 𝒟₂ : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒟₁]
        [CategoryTheory.Category.{u + 1} 𝒟₂]
        {L_a : CategoryTheory.Functor 𝒟₁ 𝒟₂} {R_a : CategoryTheory.Functor 𝒟₂ 𝒟₁}
        {L_b : CategoryTheory.Functor 𝒟₂ 𝒟₁} {R_b : CategoryTheory.Functor 𝒟₁ 𝒟₂}
        (adj_a : L_a ⊣ R_a) (adj_b : L_b ⊣ R_b)
        (u_sys : ∀ H : 𝒟₁, CategoryTheory.Iso (R_a.obj (R_b.obj H)) H)
        (_hu_nat : ∀ {H₁ H₂ : 𝒟₁} (k : H₁ ⟶ H₂),
          R_a.map (R_b.map k) ≫ (u_sys H₂).hom = (u_sys H₁).hom ≫ k),
        ∃ (ε_hom : ∀ F : 𝒟₁, F ⟶ L_b.obj (L_a.obj F))
          (ε_inv : ∀ F : 𝒟₁, L_b.obj (L_a.obj F) ⟶ F),
          (∀ F : 𝒟₁, ε_hom F ≫ ε_inv F = 𝟙 F) ∧
          (∀ F : 𝒟₁, ε_inv F ≫ ε_hom F = 𝟙 (L_b.obj (L_a.obj F))) ∧
          (∀ {M₀ : 𝒟₁} {M'₀ : 𝒟₂} (α : M₀ ⟶ R_a.obj M'₀) (α_inv : M'₀ ⟶ R_b.obj M₀),
            α ≫ R_a.map α_inv = (u_sys M₀).inv →
            L_b.map ((adj_a.homEquiv M₀ M'₀).symm α) ≫
              (adj_b.homEquiv M'₀ M₀).symm α_inv = ε_inv M₀) := by
    clear * -
    intro 𝒟₁ 𝒟₂ _ _ L_a R_a L_b R_b adj_a adj_b u_sys hu_nat
    let Ψ : ∀ (F H : 𝒟₁), (L_b.obj (L_a.obj F) ⟶ H) ≃ (F ⟶ H) := fun F H =>
      { toFun := fun v =>
          (adj_a.homEquiv F (R_b.obj H) (adj_b.homEquiv (L_a.obj F) H v)) ≫ (u_sys H).hom
        invFun := fun z =>
          (adj_b.homEquiv (L_a.obj F) H).symm
            ((adj_a.homEquiv F (R_b.obj H)).symm (z ≫ (u_sys H).inv))
        left_inv := fun v => by
          dsimp only
          rw [Category.assoc, (u_sys H).hom_inv_id, Category.comp_id,
            Equiv.symm_apply_apply, Equiv.symm_apply_apply]
        right_inv := fun z => by
          dsimp only
          rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply,
            Category.assoc, (u_sys H).inv_hom_id, Category.comp_id] }
    have hΨ_right : ∀ {F H H' : 𝒟₁} (v : L_b.obj (L_a.obj F) ⟶ H) (k : H ⟶ H'),
        Ψ F H' (v ≫ k) = Ψ F H v ≫ k := by
      intro F H H' v k
      let x := adj_a.homEquiv F (R_b.obj H) (adj_b.homEquiv (L_a.obj F) H v)
      calc
        Ψ F H' (v ≫ k) =
            (adj_a.homEquiv F (R_b.obj H') (adj_b.homEquiv (L_a.obj F) H' (v ≫ k))) ≫
              (u_sys H').hom := rfl
        _ = (x ≫ R_a.map (R_b.map k)) ≫ (u_sys H').hom := by
            dsimp only [x]
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
              CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = x ≫ (R_a.map (R_b.map k) ≫ (u_sys H').hom) := Category.assoc _ _ _
        _ = x ≫ ((u_sys H).hom ≫ k) := by rw [hu_nat k]
        _ = (x ≫ (u_sys H).hom) ≫ k := (Category.assoc _ _ _).symm
        _ = Ψ F H v ≫ k := rfl
    let ε_hom : ∀ F : 𝒟₁, F ⟶ L_b.obj (L_a.obj F) :=
      fun F => Ψ F (L_b.obj (L_a.obj F)) (𝟙 (L_b.obj (L_a.obj F)))
    let ε_inv : ∀ F : 𝒟₁, L_b.obj (L_a.obj F) ⟶ F :=
      fun F => (Ψ F F).symm (𝟙 F)
    have hΨ_eq : ∀ {F H : 𝒟₁} (v : L_b.obj (L_a.obj F) ⟶ H),
        Ψ F H v = ε_hom F ≫ v := by
      intro F H v
      calc
        Ψ F H v = Ψ F H (𝟙 (L_b.obj (L_a.obj F)) ≫ v) := by rw [Category.id_comp]
        _ = ε_hom F ≫ v := hΨ_right (𝟙 (L_b.obj (L_a.obj F))) v
    have hε_hom_inv : ∀ F : 𝒟₁, ε_hom F ≫ ε_inv F = 𝟙 F := by
      intro F
      calc
        ε_hom F ≫ ε_inv F = Ψ F F (ε_inv F) := (hΨ_eq (ε_inv F)).symm
        _ = 𝟙 F := (Ψ F F).apply_symm_apply (𝟙 F)
    have hε_inv_hom : ∀ F : 𝒟₁, ε_inv F ≫ ε_hom F = 𝟙 (L_b.obj (L_a.obj F)) := by
      intro F
      apply (Ψ F (L_b.obj (L_a.obj F))).injective
      calc
        Ψ F (L_b.obj (L_a.obj F)) (ε_inv F ≫ ε_hom F) =
            ε_hom F ≫ (ε_inv F ≫ ε_hom F) := hΨ_eq (ε_inv F ≫ ε_hom F)
        _ = (ε_hom F ≫ ε_inv F) ≫ ε_hom F := (Category.assoc _ _ _).symm
        _ = 𝟙 F ≫ ε_hom F := by rw [hε_hom_inv F]
        _ = ε_hom F := Category.id_comp _
        _ = ε_hom F ≫ 𝟙 (L_b.obj (L_a.obj F)) := (Category.comp_id _).symm
        _ = Ψ F (L_b.obj (L_a.obj F)) (𝟙 (L_b.obj (L_a.obj F))) := (hΨ_eq _).symm
    have h_mate : ∀ {M₀ : 𝒟₁} {M'₀ : 𝒟₂} (α : M₀ ⟶ R_a.obj M'₀) (α_inv : M'₀ ⟶ R_b.obj M₀),
        α ≫ R_a.map α_inv = (u_sys M₀).inv →
        L_b.map ((adj_a.homEquiv M₀ M'₀).symm α) ≫
          (adj_b.homEquiv M'₀ M₀).symm α_inv = ε_inv M₀ := by
      intro M₀ M'₀ α α_inv h_comp
      let α_t := (adj_a.homEquiv M₀ M'₀).symm α
      let α_inv_t := (adj_b.homEquiv M'₀ M₀).symm α_inv
      apply (Ψ M₀ M₀).injective
      calc
        Ψ M₀ M₀ (L_b.map α_t ≫ α_inv_t) =
            (adj_a.homEquiv M₀ (R_b.obj M₀)
              (adj_b.homEquiv (L_a.obj M₀) M₀ (L_b.map α_t ≫ α_inv_t))) ≫
              (u_sys M₀).hom := rfl
        _ = (adj_a.homEquiv M₀ (R_b.obj M₀)
              (α_t ≫ adj_b.homEquiv M'₀ M₀ α_inv_t)) ≫ (u_sys M₀).hom := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_left]
        _ = (adj_a.homEquiv M₀ (R_b.obj M₀) (α_t ≫ α_inv)) ≫ (u_sys M₀).hom := by
            dsimp only [α_inv_t]
            rw [Equiv.apply_symm_apply]
        _ = (adj_a.homEquiv M₀ M'₀ α_t ≫ R_a.map α_inv) ≫ (u_sys M₀).hom := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = (α ≫ R_a.map α_inv) ≫ (u_sys M₀).hom := by
            dsimp only [α_t]
            rw [Equiv.apply_symm_apply]
        _ = (u_sys M₀).inv ≫ (u_sys M₀).hom := by rw [h_comp]
        _ = 𝟙 M₀ := (u_sys M₀).inv_hom_id
        _ = Ψ M₀ M₀ (ε_inv M₀) := ((Ψ M₀ M₀).apply_symm_apply (𝟙 M₀)).symm
    exact ⟨ε_hom, ε_inv, hε_hom_inv, hε_inv_hom, h_mate⟩
  obtain ⟨ε₁_hom, ε₁_inv, hε₁_hom_inv, _hε₁_inv_hom, h_mate₁_fn⟩ :=
    hAdjUnitFromIso adj₁ adj₂ u₁ hu₁_nat
  obtain ⟨ε₂_hom, ε₂_inv, hε₂_hom_inv, hε₂_inv_hom, h_mate₂_fn⟩ :=
    hAdjUnitFromIso adj₂ adj₁ u₂ hu₂_nat
  let γ_t : L₁.obj M ⟶ M' := (adj₁.homEquiv M M').symm γ
  let γ_inv_t : L₂.obj M' ⟶ M := (adj₂.homEquiv M' M).symm γ_inv
  have h_mate₁ : L₂.map γ_t ≫ γ_inv_t = ε₁_inv M := h_mate₁_fn γ γ_inv h₁
  have h_mate₂ : L₁.map γ_inv_t ≫ γ_t = ε₂_inv M' := h_mate₂_fn γ_inv γ h₂
  let s : L₁.obj (L₂.obj M') ⟶ L₁.obj M := L₁.map γ_inv_t
  let s_L : L₁.obj M ⟶ L₁.obj (L₂.obj M') := L₁.map (ε₁_hom M ≫ L₂.map γ_t)
  let s_R : L₁.obj M ⟶ L₁.obj (L₂.obj M') := γ_t ≫ ε₂_hom M'
  have h_sL_s : s_L ≫ s = 𝟙 (L₁.obj M) := by
    calc
      s_L ≫ s = L₁.map (ε₁_hom M ≫ L₂.map γ_t) ≫ L₁.map γ_inv_t := rfl
      _ = L₁.map ((ε₁_hom M ≫ L₂.map γ_t) ≫ γ_inv_t) := (L₁.map_comp _ _).symm
      _ = L₁.map (ε₁_hom M ≫ (L₂.map γ_t ≫ γ_inv_t)) := by rw [Category.assoc]
      _ = L₁.map (ε₁_hom M ≫ ε₁_inv M) := by rw [h_mate₁]
      _ = L₁.map (𝟙 M) := by rw [hε₁_hom_inv M]
      _ = 𝟙 (L₁.obj M) := L₁.map_id M
