    have hTopEx : (CategoryTheory.ComposableArrows.mk₄ t₀ t₁ t₂ t₃).Exact :=
      CategoryTheory.ComposableArrows.exact_of_δ₀
        (CategoryTheory.ComposableArrows.exact₂_mk
