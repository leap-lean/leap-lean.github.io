    have h_eps_f' :
        ((ε_pre X' (pb_g'.obj G)).hom.app (Opposite.op U_X')).hom
          (CategoryTheory.Abelian.Ext.mk₀ (ρ_W ≫ pb_g'.map ψ)) =
        weilPolyP1CohomologyRepHomEquiv X' U_X' (pb_g'.obj G) (ρ_W ≫ pb_g'.map ψ) := by
      have h_add0' : CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (ρ_W ≫ pb_g'.map ψ)) = ρ_W ≫ pb_g'.map ψ :=
        (CategoryTheory.Abelian.Ext.mk₀_bijective _ _).1
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
            (CategoryTheory.Abelian.Ext.mk₀ (ρ_W ≫ pb_g'.map ψ)))
      change weilPolyP1CohomologyRepHomEquiv X' U_X' (pb_g'.obj G)
          (CategoryTheory.Abelian.Ext.addEquiv₀
            (CategoryTheory.Abelian.Ext.mk₀ (ρ_W ≫ pb_g'.map ψ))) = _
      rw [h_add0']
    rw [h_eps_f', hRepRight U_X' ρ_W (pb_g'.map ψ)]
    let R_X := weilPolyP1CohomologyRepSheaf X U_X
    let ι_UX : ↑(R_X.obj.obj (Opposite.op U_X)) :=
      weilPolyP1CohomologyRepHomEquiv X U_X R_X (𝟙 R_X)
    let s_pull : ↑((pb_g'.obj R_X).obj.obj (Opposite.op (B_g'.obj U_X))) :=
      ((adj_g'.unit.app R_X).hom.app (Opposite.op U_X)) ι_UX
    have hρ_app : weilPolyP1CohomologyRepHomEquiv X' U_X' (pb_g'.obj R_X) ρ_W =
        ((pb_g'.obj R_X).obj.map (Opposite.op (e_fun.inv.app W₀))) s_pull :=
      Equiv.apply_symm_apply (weilPolyP1CohomologyRepHomEquiv X' U_X' (pb_g'.obj R_X)) _
    rw [hρ_app]
    have h_nat_pbg :
        (((pb_g'.map ψ).hom.app (Opposite.op U_X'))
          (((pb_g'.obj R_X).obj.map (Opposite.op (e_fun.inv.app W₀))) s_pull)) =
        ((pb_g'.obj G).obj.map (Opposite.op (e_fun.inv.app W₀)))
          (((pb_g'.map ψ).hom.app (Opposite.op (B_g'.obj U_X))) s_pull) := by
      have hn := congrArg (fun m => m.hom s_pull)
        (((pb_g'.map ψ).hom).naturality (Opposite.op (e_fun.inv.app W₀)))
      exact hn
    have h_nat_unit :
        (((pb_g'.map ψ).hom.app (Opposite.op (B_g'.obj U_X))) s_pull) =
        ((adj_g'.unit.app G).hom.app (Opposite.op U_X))
          ((ψ.hom.app (Opposite.op U_X)) ι_UX) := by
      have hn := congrArg (fun m => (m.hom.app (Opposite.op U_X)).hom ι_UX)
        (adj_g'.unit.naturality ψ).symm
      exact hn
    have hψ_ι : (ψ.hom.app (Opposite.op U_X)) ι_UX = x := by
      have hr := hRepRight U_X (𝟙 R_X) ψ
      rw [CategoryTheory.Category.id_comp] at hr
      exact hr.symm
    have h_eps_G : ((ε_pre X G).hom.app (Opposite.op ((weilEtaleSitePullback f).obj W₀))).hom s = x := rfl
    have h_βpf_x : ((β_pf.hom.app (Opposite.op W₀)).hom) x =
        ((pb_g'.obj G).obj.map (Opposite.op (e_fun.inv.app W₀))).hom
          (((adj_g'.unit.app G).hom.app (Opposite.op U_X)).hom x) := rfl
    exact (h_nat_pbg.trans
      (congrArg ((pb_g'.obj G).obj.map (Opposite.op (e_fun.inv.app W₀))).hom
        (h_nat_unit.trans (congrArg ((adj_g'.unit.app G).hom.app (Opposite.op U_X)).hom hψ_ι)))).trans
      (h_βpf_x.symm.trans (congrArg (β_pf.hom.app (Opposite.op W₀)).hom h_eps_G.symm))
  have hMateConj :
      (adj_g.homEquiv _ _).symm β₀ ≫ (θ_sh f' (pb_g'.obj G)).hom =
        pb_g.map (θ_sh f G).hom ≫ (adj_g.homEquiv _ _).symm β_pf :=
    (adj_g.homEquiv_naturality_right_symm β₀ (θ_sh f' (pb_g'.obj G)).hom).symm.trans
      ((congrArg (adj_g.homEquiv _ _).symm hConj).trans
        (adj_g.homEquiv_naturality_left_symm (θ_sh f G).hom β_pf))
  have hMateEq :
      (adj_g.homEquiv _ _).symm β₀ =
        pb_g.map (θ_sh f G).hom ≫ (adj_g.homEquiv _ _).symm β_pf ≫
          (θ_sh f' (pb_g'.obj G)).inv := by
    have h1 := congrArg (· ≫ (θ_sh f' (pb_g'.obj G)).inv) hMateConj
    rw [CategoryTheory.Category.assoc, (θ_sh f' (pb_g'.obj G)).hom_inv_id,
      CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc] at h1
    exact h1
  haveI : CategoryTheory.IsIso ((adj_g.homEquiv (pf_f.obj G)
      (pf_f'.obj (pb_g'.obj G))).symm β_pf) :=
    hBC0_iso G hG_tor
  haveI : CategoryTheory.IsIso (pb_g.map (θ_sh f G).hom) :=
    (pb_g.mapIso (θ_sh f G)).isIso_hom
  rw [hMateEq]
  infer_instance

theorem weil_odp_bc_terminal_edge_torsion_pullback_triangle (sys : WeilEtaleSitePullbackSys.{u})
    (hConstIndep : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
        {T₁ T₁' : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (hT₁' : CategoryTheory.Limits.IsTerminal T₁')
        {T₂ T₂' : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (hT₂' : CategoryTheory.Limits.IsTerminal T₂')
        (A : AddCommGrpCat.{u}),
      letI := (sys h).hCont
      letI := (sys h).hAdj
      weilEtaleConstPullbackHom h hT₁ hT₂ A = weilEtaleConstPullbackHom h hT₁' hT₂' A)
    {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
    (h_sq : g' ≫ f = f' ≫ g)
    (m q : ℕ)
    (hT_top : CategoryTheory.Limits.IsTerminal
      ((weilEtaleSitePullback f).obj (weilEtaleIdTerminal.{u} S)))
    (hT_top' : CategoryTheory.Limits.IsTerminal
      ((weilEtaleSitePullback f').obj (weilEtaleIdTerminal.{u} S')))
    (τ_S' : weilEtaleIdTerminal.{u} S' ⟶
      (weilEtaleSitePullback g).obj (weilEtaleIdTerminal.{u} S))
    (p_g' : weilEtaleTorsionH X m q →+ weilEtaleTorsionH X' m q)
    (hp_g' : WeilIsTorsionEtalePullback g' m q p_g')
    {bc_push :
      letI := (sys g).hCont
      letI := (sys g').hCont
      letI := (sys g').hAdj
      weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf X m) ⟶
        ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology S'.smallEtaleTopology).obj
          (weilEtaleHigherDirectImage f' q
            (((weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
              X.smallEtaleTopology X'.smallEtaleTopology).obj (weilEtaleTorsionSheaf X m)))}
    (hbc :
      letI := (sys g).hCont
      letI := (sys g').hCont
      letI := (sys g').hAdj
      letI := (sys g').hAdd_pb
      letI := (sys g').hLim_pb
      letI := (sys g').hColim_pb
      WeilIsSingDevAlgBCBCPush f g f' g' h_sq (weilEtaleTorsionSheaf X m) q bc_push)
    (β : weilEtaleTorsionH X m q) :
    letI := (sys g).hCont
    letI := (sys g).hAdj
    letI := (sys g').hCont
    letI := (sys g').hAdj
    letI := (sys g').hAdd_pb
    letI := (sys g').hLim_pb
    letI := (sys g').hColim_pb
    let pb_g := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let T_S := weilEtaleIdTerminal.{u} S
    let T_S' := weilEtaleIdTerminal.{u} S'
    let FM := weilEtaleTorsionSheaf X m
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let πM := weilEtaleConstPullbackHom g'
      (weilEtaleIdTerminalIsTerminal.{u} X')
      (weilEtaleIdTerminalIsTerminal.{u} X) AM
    let bc_m := (adj_g.homEquiv _ _).symm bc_push
    let sec_S := weilOuterTrFibEdgeHom f T_S hT_top FM q β
    let sec_pull :=
      ((pb_g.obj (weilEtaleHigherDirectImage f q FM)).obj.map (Opposite.op τ_S')).hom
        (((adj_g.unit.app (weilEtaleHigherDirectImage f q FM)).hom.app
          (Opposite.op T_S)).hom sec_S)
    (((bc_m ≫ weilEtaleHigherDirectImageMap f' q πM).hom.app
        (Opposite.op T_S')).hom sec_pull) =
      weilOuterTrFibEdgeHom f' T_S' hT_top' (weilEtaleTorsionSheaf X' m) q (p_g' β) :=
by
  
  have hRepRight : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (m_hom : weilPolyP1CohomologyRepSheaf Z V ⟶ G₁) (ψ : G₁ ⟶ G₂),
      weilPolyP1CohomologyRepHomEquiv Z V G₂ (m_hom ≫ ψ) =
        (ψ.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V G₁ m_hom) := by
    intro Z V G₁ G₂ m_hom ψ
    let shAdj := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let freeAdj := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let YV := CategoryTheory.yoneda.obj V ⋙ AddCommGrpCat.free
    change CategoryTheory.yonedaEquiv
      ((freeAdj.homEquiv (CategoryTheory.yoneda.obj V) G₂.obj)
        ((shAdj.homEquiv YV G₂) (m_hom ≫ ψ))) = _
    rw [shAdj.homEquiv_naturality_right m_hom ψ]
    change CategoryTheory.yonedaEquiv
      ((freeAdj.homEquiv (CategoryTheory.yoneda.obj V) G₂.obj)
        ((shAdj.homEquiv YV G₁) m_hom ≫ ψ.hom)) = _
    rw [freeAdj.homEquiv_naturality_right ((shAdj.homEquiv YV G₁) m_hom) ψ.hom,
      CategoryTheory.yonedaEquiv_comp]
    rfl

  have hRepLeft : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : Z.Etale} (v : V₂ ⟶ V₁)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : weilPolyP1CohomologyRepSheaf Z V₁ ⟶ G),
      let ψ_v : weilPolyP1CohomologyRepSheaf Z V₂ ⟶ weilPolyP1CohomologyRepSheaf Z V₁ :=
        (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v) AddCommGrpCat.free)
      weilPolyP1CohomologyRepHomEquiv Z V₂ G (ψ_v ≫ φ) =
        (G.obj.map (Opposite.op v)).hom (weilPolyP1CohomologyRepHomEquiv Z V₁ G φ) := by
    intro Z V₁ V₂ v G φ ψ_v
    let shAdj := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let freeAdj := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let YV₁ := CategoryTheory.yoneda.obj V₁ ⋙ AddCommGrpCat.free
    let YV₂ := CategoryTheory.yoneda.obj V₂ ⋙ AddCommGrpCat.free
    change CategoryTheory.yonedaEquiv
      ((freeAdj.homEquiv (CategoryTheory.yoneda.obj V₂) G.obj)
        ((shAdj.homEquiv YV₂ G) (ψ_v ≫ φ))) = _
    rw [shAdj.homEquiv_naturality_left _ φ]
    have hFree : (freeAdj.homEquiv (CategoryTheory.yoneda.obj V₂) G.obj)
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v) AddCommGrpCat.free ≫
          (shAdj.homEquiv YV₁ G) φ) =
        CategoryTheory.yoneda.map v ≫
          (freeAdj.homEquiv (CategoryTheory.yoneda.obj V₁) G.obj) ((shAdj.homEquiv YV₁ G) φ) :=
      freeAdj.homEquiv_naturality_left (CategoryTheory.yoneda.map v) ((shAdj.homEquiv YV₁ G) φ)
    rw [hFree, ← CategoryTheory.yonedaEquiv_naturality]
    rfl

  
  letI := (sys g).hCont
  letI := (sys g).hAdj
  letI := (sys g').hCont
  letI := (sys g').hAdj
  letI := (sys g').hAdd_pb
  letI := (sys g').hLim_pb
  letI := (sys g').hColim_pb
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  let B_f := weilEtaleSitePullback f
  let B_g := weilEtaleSitePullback g
  let B_f' := weilEtaleSitePullback f'
  let B_g' := weilEtaleSitePullback g'
  let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let pb_g := B_g.sheafPullback AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let pf_g' := B_g'.sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology
  let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology
  let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology

  let T_S := weilEtaleIdTerminal.{u} S
  let T_S' := weilEtaleIdTerminal.{u} S'
  let FM := weilEtaleTorsionSheaf X m
  let FM' := weilEtaleTorsionSheaf X' m
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_X' := (CategoryTheory.constantSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let πM := weilEtaleConstPullbackHom g'
    (weilEtaleIdTerminalIsTerminal.{u} X')
    (weilEtaleIdTerminalIsTerminal.{u} X) AM
  let M_sh := weilEtaleHigherDirectImage f q FM
  let N_sh := weilEtaleHigherDirectImage f' q (pb_g'.obj FM)
  let R_bot := weilEtaleHigherDirectImage f' q FM'
  let Φ_π := weilEtaleHigherDirectImageMap f' q πM
  let bc_m : pb_g.obj M_sh ⟶ N_sh := (adj_g.homEquiv M_sh N_sh).symm bc_push
  let sec_S := weilOuterTrFibEdgeHom f T_S hT_top FM q β
  let u_S := ((adj_g.unit.app M_sh).hom.app (Opposite.op T_S)).hom sec_S
  let sec_pull := ((pb_g.obj M_sh).obj.map (Opposite.op τ_S')).hom u_S
  let γ_tilde : pb_g.obj M_sh ⟶ R_bot := bc_m ≫ Φ_π

  change ((γ_tilde.hom.app (Opposite.op T_S')).hom sec_pull) =
    weilOuterTrFibEdgeHom f' T_S' hT_top' FM' q (p_g' β)

  
  have hNat_τ : (γ_tilde.hom.app (Opposite.op T_S')).hom sec_pull =
      (R_bot.obj.map (Opposite.op τ_S')).hom
        ((γ_tilde.hom.app (Opposite.op (B_g.obj T_S))).hom u_S) :=
    congrArg (fun k => k.hom u_S) (γ_tilde.hom.naturality (Opposite.op τ_S'))

  have hMate_γ : adj_g.unit.app M_sh ≫ pf_g.map γ_tilde = bc_push ≫ pf_g.map Φ_π := by
    rw [← adj_g.homEquiv_unit M_sh R_bot γ_tilde]
    dsimp only [γ_tilde, bc_m]
    rw [adj_g.homEquiv_naturality_right, Equiv.apply_symm_apply]

  have hEval_TS : (γ_tilde.hom.app (Opposite.op (B_g.obj T_S))).hom u_S =
      (Φ_π.hom.app (Opposite.op (B_g.obj T_S))).hom
        ((bc_push.hom.app (Opposite.op T_S)).hom sec_S) :=
    congrArg (fun k => (k.hom.app (Opposite.op T_S)).hom sec_S) hMate_γ

  
  let U_X := B_f.obj T_S
  let U_X' := B_f'.obj T_S'
  let W_mid := B_f'.obj (B_g.obj T_S)
  let r_X := weilPolyP1CohomologyRepToConst X U_X hT_top
  let r_X' := weilPolyP1CohomologyRepToConst X' U_X' hT_top'
  let s_β := weilPolyP1CohomologyTermToPresheaf X U_X hT_top FM q β
  let P_N := B_f'.op ⋙ (pb_g'.obj FM).cohomologyPresheaf q
  let P_bot := B_f'.op ⋙ FM'.cohomologyPresheaf q
  let shAdj_S' := CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}

  let e_fun : (B_f ⋙ B_g') ≅ (B_g ⋙ B_f') :=
    (CategoryTheory.MorphismProperty.Over.pullbackComp g' f).symm ≪≫
      CategoryTheory.MorphismProperty.Over.pullbackCongr h_sq ≪≫
      CategoryTheory.MorphismProperty.Over.pullbackComp f' g
  let ρ_T := weilPolyP1CohomologyRepPullHom g' U_X W_mid (e_fun.inv.app T_S)
  let x_N : ↑(P_N.obj (Opposite.op (B_g.obj T_S))) :=
    (CategoryTheory.Abelian.Ext.mk₀ ρ_T).comp
      (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X U_X) FM q s_β) (Nat.zero_add q)

  have hBC_eval : (bc_push.hom.app (Opposite.op T_S)).hom sec_S =
      ((shAdj_S'.unit.app P_N).app (Opposite.op (B_g.obj T_S))).hom x_N :=
    congrArg (fun k => k.hom s_β) (hbc T_S)

  let α_πM : P_N ⟶ P_bot :=
    CategoryTheory.Functor.whiskerLeft B_f'.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map πM)
  let y_bot : ↑(P_bot.obj (Opposite.op (B_g.obj T_S))) :=
    x_N.comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q)

  have hΦ_eval :
      (Φ_π.hom.app (Opposite.op (B_g.obj T_S))).hom
        (((shAdj_S'.unit.app P_N).app (Opposite.op (B_g.obj T_S))).hom x_N) =
      ((shAdj_S'.unit.app P_bot).app (Opposite.op (B_g.obj T_S))).hom y_bot :=
    (congrArg (fun k => (k.app (Opposite.op (B_g.obj T_S))).hom x_N)
      (shAdj_S'.unit.naturality α_πM)).symm

  let φ_τ : weilPolyP1CohomologyRepSheaf X' U_X' ⟶ weilPolyP1CohomologyRepSheaf X' W_mid :=
    (CategoryTheory.presheafToSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).map
      (CategoryTheory.Functor.whiskerRight
        (CategoryTheory.yoneda.map (B_f'.map τ_S')) AddCommGrpCat.free)

  have hRbot_eval :
      (R_bot.obj.map (Opposite.op τ_S')).hom
        (((shAdj_S'.unit.app P_bot).app (Opposite.op (B_g.obj T_S))).hom y_bot) =
      ((shAdj_S'.unit.app P_bot).app (Opposite.op T_S')).hom
        ((CategoryTheory.Abelian.Ext.mk₀ φ_τ).comp y_bot (Nat.zero_add q)) :=
    (congrArg (fun k => k.hom y_bot)
      ((shAdj_S'.unit.app P_bot).naturality (Opposite.op τ_S'))).symm

  have hLHS_unit :
      (γ_tilde.hom.app (Opposite.op T_S')).hom sec_pull =
      ((shAdj_S'.unit.app P_bot).app (Opposite.op T_S')).hom
        ((CategoryTheory.Abelian.Ext.mk₀ φ_τ).comp y_bot (Nat.zero_add q)) := by
    rw [hNat_τ, hEval_TS, hBC_eval, hΦ_eval, hRbot_eval]

  
  rcases hp_g' with ⟨hc_p, hp_g'⟩
  have h1 : hc_p = (sys g').hCont := Subsingleton.elim _ _
  subst h1
  rcases hp_g' with ⟨hr_p, hp_g'⟩
  have h2 : hr_p = (sys g').hAdj := Subsingleton.elim _ _
  subst h2
  rcases hp_g' with ⟨hAdd_p, hLim_p, hColim_p, T₁, hT₁, T₂, hT₂, ιℤ, _, hπι, hp_eq⟩
  have h3 : hAdd_p = (sys g').hAdd_pb := Subsingleton.elim _ _
  subst h3
  have h4 : hLim_p = (sys g').hLim_pb := Subsingleton.elim _ _
  subst h4
  have h5 : hColim_p = (sys g').hColim_pb := Subsingleton.elim _ _
  subst h5

  let πM_p := weilEtaleConstPullbackHom g' hT₁ hT₂ AM
  have hπM_eq : πM = πM_p :=
    hConstIndep g' (weilEtaleIdTerminalIsTerminal.{u} X') hT₁
      (weilEtaleIdTerminalIsTerminal.{u} X) hT₂ AM

  let π'ℤ := weilEtaleConstPullbackHom g' hT_top' hT_top Aℤ
  have hπℤ_eq : weilEtaleConstPullbackHom g' hT₁ hT₂ Aℤ = π'ℤ :=
    hConstIndep g' hT₁ hT_top' hT₂ hT_top Aℤ
  have hπ'ℤ_ι : π'ℤ ≫ ιℤ = 𝟙 (pb_g'.obj Fℤ_X) := by
    rw [← hπℤ_eq]
    exact hπι

  let ψ_tot : pb_g'.obj (weilPolyP1CohomologyRepSheaf X U_X) ⟶ Fℤ_X' :=
    pb_g'.map r_X ≫ π'ℤ
  have hDeg0_post : (φ_τ ≫ ρ_T ≫ pb_g'.map r_X) ≫ π'ℤ = r_X' := by
    apply (weilPolyP1CohomologyRepHomEquiv X' U_X' Fℤ_X').injective
    have hAssoc : (φ_τ ≫ ρ_T ≫ pb_g'.map r_X) ≫ π'ℤ = φ_τ ≫ ρ_T ≫ ψ_tot := by
      simp only [ψ_tot, CategoryTheory.Category.assoc]
    rw [hAssoc]
    let adj_top := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_top
    let adj_top' := CategoryTheory.constantSheafAdj X'.smallEtaleTopology AddCommGrpCat.{u} hT_top'
    let one_up : ↑Aℤ := ULift.up (1 : ℤ)
    let e_X : ↑(Fℤ_X.obj.obj (Opposite.op U_X)) := (adj_top.unit.app Aℤ).hom one_up
    let e'_X' : ↑(Fℤ_X'.obj.obj (Opposite.op U_X')) := (adj_top'.unit.app Aℤ).hom one_up
    have hRHS_val : weilPolyP1CohomologyRepHomEquiv X' U_X' Fℤ_X' r_X' = e'_X' :=
      Equiv.apply_symm_apply (weilPolyP1CohomologyRepHomEquiv X' U_X' Fℤ_X') e'_X'
    have hrX_val : weilPolyP1CohomologyRepHomEquiv X U_X Fℤ_X r_X = e_X :=
      Equiv.apply_symm_apply (weilPolyP1CohomologyRepHomEquiv X U_X Fℤ_X) e_X
    rw [hRHS_val, hRepLeft X' (B_f'.map τ_S') Fℤ_X' (ρ_T ≫ ψ_tot),
      hRepRight X' W_mid ρ_T ψ_tot]
    let R_UX := weilPolyP1CohomologyRepSheaf X U_X
    let ι_UX : ↑(R_UX.obj.obj (Opposite.op U_X)) :=
      weilPolyP1CohomologyRepHomEquiv X U_X R_UX (𝟙 R_UX)
    let s_pull_UX : ↑((pb_g'.obj R_UX).obj.obj (Opposite.op (B_g'.obj U_X))) :=
      ((adj_g'.unit.app R_UX).hom.app (Opposite.op U_X)).hom ι_UX
    have hρ_val : weilPolyP1CohomologyRepHomEquiv X' W_mid (pb_g'.obj R_UX) ρ_T =
        ((pb_g'.obj R_UX).obj.map (Opposite.op (e_fun.inv.app T_S))).hom s_pull_UX :=
      Equiv.apply_symm_apply (weilPolyP1CohomologyRepHomEquiv X' W_mid (pb_g'.obj R_UX)) _
    rw [hρ_val]
    have hNat_ψ :
        (ψ_tot.hom.app (Opposite.op W_mid)).hom
          (((pb_g'.obj R_UX).obj.map (Opposite.op (e_fun.inv.app T_S))).hom s_pull_UX) =
        (Fℤ_X'.obj.map (Opposite.op (e_fun.inv.app T_S))).hom
          ((ψ_tot.hom.app (Opposite.op (B_g'.obj U_X))).hom s_pull_UX) :=
      congrArg (fun k => k.hom s_pull_UX)
        (ψ_tot.hom.naturality (Opposite.op (e_fun.inv.app T_S)))
    rw [hNat_ψ]
    have hrX_ι : (r_X.hom.app (Opposite.op U_X)).hom ι_UX = e_X := by
      have h1 := (hRepRight X U_X (𝟙 R_UX) r_X).symm
      rw [CategoryTheory.Category.id_comp, hrX_val] at h1
      exact h1
    have hUnit_rX :
        ((pb_g'.map r_X).hom.app (Opposite.op (B_g'.obj U_X))).hom s_pull_UX =
        ((adj_g'.unit.app Fℤ_X).hom.app (Opposite.op U_X)).hom e_X := by
      have hn := (congrArg (fun k => (k.hom.app (Opposite.op U_X)).hom ι_UX)
        (adj_g'.unit.naturality r_X)).symm
      exact hn.trans (congrArg ((adj_g'.unit.app Fℤ_X).hom.app (Opposite.op U_X)).hom hrX_ι)
    let τ_X' : B_g'.obj U_X ⟶ U_X' := hT_top'.from (B_g'.obj U_X)
    have hπ'ℤ_mate₁ : adj_g'.unit.app Fℤ_X ≫ pf_g'.map π'ℤ =
        (adj_top.homEquiv Aℤ (pf_g'.obj Fℤ_X')).symm
          (adj_top'.unit.app Aℤ ≫ Fℤ_X'.obj.map (Opposite.op τ_X')) := by
      rw [← adj_g'.homEquiv_unit Fℤ_X Fℤ_X' π'ℤ]
      exact Equiv.apply_symm_apply (adj_g'.homEquiv Fℤ_X Fℤ_X') _
    have hπ'ℤ_mate₂ :
        adj_top.unit.app Aℤ ≫
          ((adj_g'.unit.app Fℤ_X ≫ pf_g'.map π'ℤ).hom.app (Opposite.op U_X)) =
        adj_top'.unit.app Aℤ ≫ Fℤ_X'.obj.map (Opposite.op τ_X') := by
      have h_eq := congrArg (adj_top.homEquiv Aℤ (pf_g'.obj Fℤ_X')) hπ'ℤ_mate₁
      rw [Equiv.apply_symm_apply] at h_eq
      exact (adj_top.homEquiv_unit Aℤ (pf_g'.obj Fℤ_X')
        (adj_g'.unit.app Fℤ_X ≫ pf_g'.map π'ℤ)).symm.trans h_eq
    have hψ_eval :
        (ψ_tot.hom.app (Opposite.op (B_g'.obj U_X))).hom s_pull_UX =
        (Fℤ_X'.obj.map (Opposite.op τ_X')).hom e'_X' := by
      change (π'ℤ.hom.app (Opposite.op (B_g'.obj U_X))).hom
        (((pb_g'.map r_X).hom.app (Opposite.op (B_g'.obj U_X))).hom s_pull_UX) = _
      rw [hUnit_rX]
      exact congrArg (fun k => k.hom one_up) hπ'ℤ_mate₂
    rw [hψ_eval]
    have hTermEnd : (B_f'.map τ_S' ≫ e_fun.inv.app T_S) ≫ τ_X' = 𝟙 U_X' :=
      hT_top'.hom_ext _ _
    change (Fℤ_X'.obj.map (Opposite.op τ_X') ≫
      Fℤ_X'.obj.map (Opposite.op (e_fun.inv.app T_S)) ≫
      Fℤ_X'.obj.map (Opposite.op (B_f'.map τ_S'))).hom e'_X' = e'_X'
    rw [← Fℤ_X'.obj.map_comp, ← Fℤ_X'.obj.map_comp]
    change (Fℤ_X'.obj.map
      (Opposite.op ((B_f'.map τ_S' ≫ e_fun.inv.app T_S) ≫ τ_X'))).hom e'_X' = e'_X'
    rw [hTermEnd]
    exact congrArg (fun k => k.hom e'_X') (Fℤ_X'.obj.map_id (Opposite.op U_X'))

  have hDeg0 : φ_τ ≫ ρ_T ≫ pb_g'.map r_X = r_X' ≫ ιℤ := by
    calc
      φ_τ ≫ ρ_T ≫ pb_g'.map r_X
          = (φ_τ ≫ ρ_T ≫ pb_g'.map r_X) ≫ 𝟙 (pb_g'.obj Fℤ_X) :=
            (CategoryTheory.Category.comp_id _).symm
      _ = (φ_τ ≫ ρ_T ≫ pb_g'.map r_X) ≫ (π'ℤ ≫ ιℤ) := by rw [hπ'ℤ_ι]
      _ = ((φ_τ ≫ ρ_T ≫ pb_g'.map r_X) ≫ π'ℤ) ≫ ιℤ :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = r_X' ≫ ιℤ := by rw [hDeg0_post]

  
  let β_pb := pb_g'.mapExtAddHom Fℤ_X FM q β
  have hs_β_pb : pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X U_X) FM q s_β =
      (CategoryTheory.Abelian.Ext.mk₀ (pb_g'.map r_X)).comp β_pb (Nat.zero_add q) := by
    let s_β_ext : CategoryTheory.Abelian.Ext (weilPolyP1CohomologyRepSheaf X U_X) FM q :=
      (CategoryTheory.Abelian.Ext.mk₀ r_X).comp β (Nat.zero_add q)
    change (pb_g'.mapExtAddHom (weilPolyP1CohomologyRepSheaf X U_X) FM q) s_β_ext = _
    rw [CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Functor.mapExtAddHom_apply]

  have hx_N_eq : x_N =
      (CategoryTheory.Abelian.Ext.mk₀ (ρ_T ≫ pb_g'.map r_X)).comp β_pb (Nat.zero_add q) := by
    dsimp only [x_N]
    rw [hs_β_pb,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ρ_T)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_g'.map r_X))
        β_pb (Nat.zero_add 0) (Nat.zero_add q) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  have hExt_eq :
      (CategoryTheory.Abelian.Ext.mk₀ φ_τ).comp y_bot (Nat.zero_add q) =
      weilPolyP1CohomologyTermToPresheaf X' U_X' hT_top' FM' q (p_g' β) := by
    dsimp only [y_bot]
    rw [hx_N_eq, hπM_eq,
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ φ_τ)
        ((CategoryTheory.Abelian.Ext.mk₀ (ρ_T ≫ pb_g'.map r_X)).comp β_pb (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ πM_p)
        (Nat.zero_add q) (Nat.add_zero q) (by omega),
      ← CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ φ_τ)
        (CategoryTheory.Abelian.Ext.mk₀ (ρ_T ≫ pb_g'.map r_X))
        β_pb (Nat.zero_add 0) (Nat.zero_add q) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hDeg0,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ r_X' ιℤ,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ r_X')
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        β_pb (Nat.zero_add 0) (Nat.zero_add q) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ r_X')
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp β_pb (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ πM_p)
        (Nat.zero_add q) (Nat.add_zero q) (by omega)]
    have hp_β : p_g' β =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp β_pb (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM_p) (Nat.add_zero q) :=
      hp_eq β
    rw [← hp_β]
    rfl

  rw [hLHS_unit, hExt_eq]
  rfl

theorem weil_odp_pbc_eval_mod_prime_beck_chevalley_and_long_exact (sys : WeilEtaleSitePullbackSys.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
    (hPb : CategoryTheory.IsPullback g' f' f g)
    (hPBC : WeilCanonicalModPrimePBC ℓ f) :
    letI := (sys g).hCont
    letI := (sys g).hAdj
    letI := (sys g').hCont
    letI := (sys g').hAdj
    letI := (sys g').hAdd_pb
    letI := (sys g').hLim_pb
    letI := (sys g').hColim_pb
    let pb_g := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let pb_g' := (weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology
    let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    ∃ (bc : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          pb_g.obj (weilEtaleHigherDirectImage f q F) ⟶
            weilEtaleHigherDirectImage f' q (pb_g'.obj F))
      (conn_top : ∀ (q : ℕ)
          {SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})},
          SC.ShortExact →
            (weilEtaleHigherDirectImage f q SC.X₃ ⟶
              weilEtaleHigherDirectImage f (q + 1) SC.X₁))
      (conn_bot : ∀ (q : ℕ)
          {SC' : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u})},
          SC'.ShortExact →
            (weilEtaleHigherDirectImage f' q SC'.X₃ ⟶
              weilEtaleHigherDirectImage f' (q + 1) SC'.X₁)),
      (∀ (q : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : F₁ ⟶ F₂),
        pb_g.map (weilEtaleHigherDirectImageMap f q φ) ≫ bc q F₂ =
          bc q F₁ ≫ weilEtaleHigherDirectImageMap f' q (pb_g'.map φ)) ∧
      (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE : SC.ShortExact),
        CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 SC.f) ∧
        CategoryTheory.Mono (weilEtaleHigherDirectImageMap f' 0 (SC.map pb_g').f) ∧
        ∀ (q : ℕ),
          (pb_g.map (conn_top q hSE) ≫ bc (q + 1) SC.X₁ =
            bc q SC.X₃ ≫ conn_bot q (hSE.map_of_exact pb_g')) ∧
          ((∃ h0₁, (CategoryTheory.ShortComplex.mk
                (weilEtaleHigherDirectImageMap f q SC.f)
                (weilEtaleHigherDirectImageMap f q SC.g) h0₁).Exact) ∧
            (∃ h0₂, (CategoryTheory.ShortComplex.mk
                (weilEtaleHigherDirectImageMap f q SC.g)
                (conn_top q hSE) h0₂).Exact) ∧
            (∃ h0₃, (CategoryTheory.ShortComplex.mk
                (conn_top q hSE)
                (weilEtaleHigherDirectImageMap f (q + 1) SC.f) h0₃).Exact)) ∧
          ((∃ h0₁', (CategoryTheory.ShortComplex.mk
                (weilEtaleHigherDirectImageMap f' q (SC.map pb_g').f)
                (weilEtaleHigherDirectImageMap f' q (SC.map pb_g').g) h0₁').Exact) ∧
            (∃ h0₂', (CategoryTheory.ShortComplex.mk
                (weilEtaleHigherDirectImageMap f' q (SC.map pb_g').g)
                (conn_bot q (hSE.map_of_exact pb_g')) h0₂').Exact) ∧
            (∃ h0₃', (CategoryTheory.ShortComplex.mk
                (conn_bot q (hSE.map_of_exact pb_g'))
                (weilEtaleHigherDirectImageMap f' (q + 1) (SC.map pb_g').f) h0₃').Exact))) ∧
      (∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        CategoryTheory.IsIso (bc q F)) ∧
      (∀ (m q : ℕ)
          (hT_top : CategoryTheory.Limits.IsTerminal
            ((weilEtaleSitePullback f).obj (weilEtaleIdTerminal.{u} S)))
          (hT_top' : CategoryTheory.Limits.IsTerminal
            ((weilEtaleSitePullback f').obj (weilEtaleIdTerminal.{u} S')))
          (τ_S' : weilEtaleIdTerminal.{u} S' ⟶
            (weilEtaleSitePullback g).obj (weilEtaleIdTerminal.{u} S))
          (p_g' : weilEtaleTorsionH X m q →+ weilEtaleTorsionH X' m q),
        WeilIsTorsionEtalePullback g' m q p_g' →
        ∀ (β : weilEtaleTorsionH X m q),
          let T_S := weilEtaleIdTerminal.{u} S
          let T_S' := weilEtaleIdTerminal.{u} S'
          let FM := weilEtaleTorsionSheaf X m
          let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
          let πM := weilEtaleConstPullbackHom g'
            (weilEtaleIdTerminalIsTerminal.{u} X')
            (weilEtaleIdTerminalIsTerminal.{u} X) AM
          let sec_S := weilOuterTrFibEdgeHom f T_S hT_top FM q β
          let sec_pull :=
            ((pb_g.obj (weilEtaleHigherDirectImage f q FM)).obj.map (Opposite.op τ_S')).hom
              (((adj_g.unit.app (weilEtaleHigherDirectImage f q FM)).hom.app
                (Opposite.op T_S)).hom sec_S)
          (((bc q FM ≫ weilEtaleHigherDirectImageMap f' q πM).hom.app
              (Opposite.op T_S')).hom sec_pull) =
            weilOuterTrFibEdgeHom f' T_S' hT_top' (weilEtaleTorsionSheaf X' m) q (p_g' β)) :=
by
  obtain ⟨hc_all, hr_all, _, hConstIndep_all, _⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria.{u}
  have hConstIndep : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
      {T₁ T₁' : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₁' : CategoryTheory.Limits.IsTerminal T₁')
      {T₂ T₂' : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (hT₂' : CategoryTheory.Limits.IsTerminal T₂')
      (A : AddCommGrpCat.{u}),
      letI := (sys h).hCont
      letI := (sys h).hAdj
      weilEtaleConstPullbackHom h hT₁ hT₂ A = weilEtaleConstPullbackHom h hT₁' hT₂' A := by
    intro S₁ S₂ h T₁ T₁' hT₁ hT₁' T₂ T₂' hT₂ hT₂' A
    have h_gen : ∀ (hc₁ : (weilEtaleSitePullback h).IsContinuous
          S₂.smallEtaleTopology S₁.smallEtaleTopology),
        ∀ (hr₁ :
          letI := hc₁
          ((weilEtaleSitePullback h).sheafPushforwardContinuous
            AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint),
        @weilEtaleConstPullbackHom S₁ S₂ h hc₁ hr₁ T₁ hT₁ T₂ hT₂ A =
          @weilEtaleConstPullbackHom S₁ S₂ h hc₁ hr₁ T₁' hT₁' T₂' hT₂' A := by
      intro hc₁ hr₁
      have hc_eq : hc₁ = @hc_all S₁ S₂ h := Subsingleton.elim _ _
      subst hc_eq
      have hr_eq : hr₁ = @hr_all S₁ S₂ h := Subsingleton.elim _ _
      subst hr_eq
      exact @hConstIndep_all S₁ S₂ h T₁ T₁' hT₁ hT₁' T₂ T₂' hT₂ hT₂' A
    exact h_gen (sys h).hCont (sys h).hAdj
  letI := (sys g).hCont
  letI := (sys g).hAdj
  letI := (sys g').hCont
  letI := (sys g').hAdj
  letI := (sys g').hAdd_pb
  letI := (sys g').hLim_pb
  letI := (sys g').hColim_pb
  let pb_g := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let pb_g' := (weilEtaleSitePullback g').sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology
  let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  obtain ⟨hBC_ex_uniq, hBC_nat_push, hBC_conn_push⟩ :=
    weil_odp_bc_push_exists_unique_and_nat sys f g f' g' hPb.w
  let bc_push : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      weilEtaleHigherDirectImage f q F ⟶
        pf_g.obj (weilEtaleHigherDirectImage f' q (pb_g'.obj F)) :=
    fun q F => Classical.choose (hBC_ex_uniq F q).1
  have hbc_push : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsSingDevAlgBCBCPush f g f' g' hPb.w F q (bc_push q F) :=
    fun q F => Classical.choose_spec (hBC_ex_uniq F q).1
  let bc : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      pb_g.obj (weilEtaleHigherDirectImage f q F) ⟶
        weilEtaleHigherDirectImage f' q (pb_g'.obj F) :=
    fun q F => (adj_g.homEquiv _ _).symm (bc_push q F)
  let conn_top : ∀ (q : ℕ)
      {SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})},
      SC.ShortExact →
        (weilEtaleHigherDirectImage f q SC.X₃ ⟶
          weilEtaleHigherDirectImage f (q + 1) SC.X₁) :=
    fun q {SC} hSE => weilSingDevAlgBCConnHom f SC hSE q
  let conn_bot : ∀ (q : ℕ)
      {SC' : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u})},
      SC'.ShortExact →
        (weilEtaleHigherDirectImage f' q SC'.X₃ ⟶
          weilEtaleHigherDirectImage f' (q + 1) SC'.X₁) :=
    fun q {SC'} hSE' => weilSingDevAlgBCConnHom f' SC' hSE' q
  have hNat : ∀ (q : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : F₁ ⟶ F₂),
      pb_g.map (weilEtaleHigherDirectImageMap f q φ) ≫ bc q F₂ =
        bc q F₁ ≫ weilEtaleHigherDirectImageMap f' q (pb_g'.map φ) := by
    intro q F₁ F₂ φ
    apply (adj_g.homEquiv _ _).injective
    dsimp only [bc]
    rw [adj_g.homEquiv_naturality_left, adj_g.homEquiv_naturality_right,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact hBC_nat_push φ q (hbc_push q F₁) (hbc_push q F₂)
  have hConnNat : ∀ (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q : ℕ),
      pb_g.map (conn_top q hSE) ≫ bc (q + 1) SC.X₁ =
        bc q SC.X₃ ≫ conn_bot q (hSE.map_of_exact pb_g') := by
    intro SC hSE q
    apply (adj_g.homEquiv _ _).injective
    dsimp only [bc, conn_top, conn_bot]
    rw [adj_g.homEquiv_naturality_left, adj_g.homEquiv_naturality_right,
