    let E_R' := Equiv.ofBijective (AddMonoidHom.pi ev_R') (hPiEvalBij n R' ev_R' hev_R')
    let P_prod : (∀ i : Fin n,
        weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (R i))) ℓ 0) →
      (∀ i : Fin n,
        weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (R' i))) ℓ 0) :=
      fun u i => p_i i (u i)
    have hBij_P : Function.Bijective P_prod := by
      refine ⟨fun u₁ u₂ hu => funext fun i => (hBij i (p_i i) (hp_i i)).1 (congrFun hu i), ?_⟩
      intro v
      choose u hu using fun i : Fin n => (hBij i (p_i i) (hp_i i)).2 (v i)
      exact ⟨u, funext hu⟩
    have hSq_coord : ∀ (i : Fin n)
        (x : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (∀ j : Fin n, R j))) ℓ 0),
        ev_R' i (Ψ x) = p_i i (ev_R i x) := by
      intro i x
      have hcomm_ring :
          CommRingCat.ofHom (RingHom.pi fun j => (φ j).comp (Pi.evalRingHom R j)) ≫
            CommRingCat.ofHom (Pi.evalRingHom R' i) =
          CommRingCat.ofHom (Pi.evalRingHom R i) ≫ CommRingCat.ofHom (φ i) := by
        apply CommRingCat.hom_ext
        ext u
        rfl
      have hcomm_spec :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom R' i)) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (RingHom.pi fun j => (φ j).comp (Pi.evalRingHom R j))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ i)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i)) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hcomm_ring]
      have hsq := hPullSqEq
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom R' i)))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (RingHom.pi fun j => (φ j).comp (Pi.evalRingHom R j))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ i)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i)))
        ℓ 0 (ev_R' i) Ψ (p_i i) (ev_R i) hcomm_spec (hev_R' i) hΨ (hp_i i) (hev_R i)
      exact DFunLike.congr_fun hsq x
    have hΨ_eq : (Ψ : _ → _) = E_R'.symm ∘ P_prod ∘ E_R := by
      funext x
      apply E_R'.injective
      rw [Function.comp_apply, Function.comp_apply, Equiv.apply_symm_apply]
      funext i
      exact hSq_coord i x
    rw [hΨ_eq]
    exact E_R'.symm.bijective.comp (hBij_P.comp E_R.bijective)

  
  intro E E_loc w_E hw_E ι_E ϕ_E hϕ_E ψ_E hψ_E
  obtain ⟨hNoethE, hStageAway⟩ := hs4 E E_loc w_E ι_E ϕ_E hϕ_E
  letI : IsNoetherianRing ↑E := hNoethE
  obtain ⟨n, c, hc_idem, hc_orth, hc_sum, hc_conn⟩ := hs3.1 (↑E)
  let c' : Fin n → ↑E_loc := fun i => ι_E.hom (c i)
  have hc'_idem : ∀ i : Fin n, IsIdempotentElem (c' i) := by
    intro i
    change ι_E.hom (c i) * ι_E.hom (c i) = ι_E.hom (c i)
    rw [← map_mul, (hc_idem i).eq]
  have hc'_orth : ∀ i j : Fin n, i ≠ j → c' i * c' j = 0 := by
    intro i j hij
    change ι_E.hom (c i) * ι_E.hom (c j) = 0
    rw [← map_mul, hc_orth i j hij, map_zero]
  have hc'_sum : (∑ i : Fin n, c' i) = 1 := by
    change (∑ i : Fin n, ι_E.hom (c i)) = 1
    rw [← map_sum, hc_sum, map_one]
  let e_R : ↑E ≃+* ∀ i : Fin n, Localization.Away (c i) :=
    RingEquiv.ofBijective
      (RingHom.pi fun i : Fin n => algebraMap (↑E) (Localization.Away (c i)))
      (hs3.2 (↑E) n c hc_idem hc_orth hc_sum)
  let e_Rloc : ↑E_loc ≃+* ∀ i : Fin n, Localization.Away (c' i) :=
    RingEquiv.ofBijective
      (RingHom.pi fun i : Fin n => algebraMap (↑E_loc) (Localization.Away (c' i)))
      (hs3.2 (↑E_loc) n c' hc'_idem hc'_orth hc'_sum)
  let iso_E : E ≅ CommRingCat.of (∀ i : Fin n, Localization.Away (c i)) :=
    { hom := CommRingCat.ofHom e_R.toRingHom
      inv := CommRingCat.ofHom e_R.symm.toRingHom
      hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun x => e_R.symm_apply_apply x)
      inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun x => e_R.apply_symm_apply x) }
  let iso_Eloc : E_loc ≅ CommRingCat.of (∀ i : Fin n, Localization.Away (c' i)) :=
    { hom := CommRingCat.ofHom e_Rloc.toRingHom
      inv := CommRingCat.ofHom e_Rloc.symm.toRingHom
      hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun x => e_Rloc.symm_apply_apply x)
      inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun x => e_Rloc.apply_symm_apply x) }
  let φ_i : ∀ i : Fin n, Localization.Away (c i) →+* Localization.Away (c' i) :=
    fun i => IsLocalization.Away.map (Localization.Away (c i)) (Localization.Away (c' i))
      ι_E.hom (c i)
  have hBijComp : ∀ (i : Fin n)
      (p_i : weilEtaleTorsionH
          (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (c i)))) ℓ 0 →+
        weilEtaleTorsionH
          (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (c' i)))) ℓ 0),
      WeilIsTorsionEtalePullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_i i))) ℓ 0 p_i →
      Function.Bijective p_i := by
    intro i p_i hp_i
    obtain ⟨hw_i, hConnLoc_i⟩ := hStageAway (c i)
    let w_i : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (c i))) ⟶ Y_d :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (↑E) (Localization.Away (c i)))) ≫ w_E
    letI : AlgebraicGeometry.Etale w_i := hw_i
    letI : ConnectedSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (c i)))) :=
      hc_conn i
    have hPur_i := hPur0
      (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (c i)))) w_i
      (hc_conn i) (hc_conn i).toNonempty
    letI : ConnectedSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (c' i)))) :=
      hConnLoc_i hPur_i.1
    exact hs5 (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_i i))) p_i hp_i
  let π_hom : CommRingCat.of (∀ i : Fin n, Localization.Away (c i)) ⟶
      CommRingCat.of (∀ i : Fin n, Localization.Away (c' i)) :=
    CommRingCat.ofHom (RingHom.pi fun i => (φ_i i).comp (Pi.evalRingHom _ i))
  obtain ⟨Ψ_pi, hΨ_pi⟩ := hPullEx (AlgebraicGeometry.Spec.map π_hom) ℓ 0
  have hBij_Ψ : Function.Bijective Ψ_pi :=
    hs6 n (fun i => Localization.Away (c i)) (fun i => Localization.Away (c' i))
      φ_i hBijComp Ψ_pi hΨ_pi
  have hRingSq : ι_E ≫ iso_Eloc.hom = iso_E.hom ≫ π_hom := by
    apply CommRingCat.hom_ext
    ext x i
    change algebraMap (↑E_loc) (Localization.Away (c' i)) (ι_E.hom x) =
      φ_i i (algebraMap (↑E) (Localization.Away (c i)) x)
    dsimp only [φ_i, IsLocalization.Away.map]
    exact (IsLocalization.map_eq _ x).symm
  have hSpecSq :
      AlgebraicGeometry.Spec.map iso_Eloc.hom ≫ AlgebraicGeometry.Spec.map ι_E =
        AlgebraicGeometry.Spec.map π_hom ≫ AlgebraicGeometry.Spec.map iso_E.hom := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hRingSq]
  let e_SpecE : AlgebraicGeometry.Spec
      (CommRingCat.of (∀ i : Fin n, Localization.Away (c i))) ≅ AlgebraicGeometry.Spec E :=
    { hom := AlgebraicGeometry.Spec.map iso_E.hom
      inv := AlgebraicGeometry.Spec.map iso_E.inv
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, iso_E.inv_hom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, iso_E.hom_inv_id, AlgebraicGeometry.Spec.map_id] }
  let e_SpecEloc : AlgebraicGeometry.Spec
      (CommRingCat.of (∀ i : Fin n, Localization.Away (c' i))) ≅ AlgebraicGeometry.Spec E_loc :=
    { hom := AlgebraicGeometry.Spec.map iso_Eloc.hom
      inv := AlgebraicGeometry.Spec.map iso_Eloc.inv
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, iso_Eloc.inv_hom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, iso_Eloc.hom_inv_id, AlgebraicGeometry.Spec.map_id] }
  obtain ⟨p_eE, hp_eE⟩ := hPullEx e_SpecE.hom ℓ 0
  obtain ⟨p_eEloc, hp_eEloc⟩ := hPullEx e_SpecEloc.hom ℓ 0
  have hBij_eE : Function.Bijective p_eE := hPullIsoBij e_SpecE ℓ 0 p_eE hp_eE
  have hBij_eEloc : Function.Bijective p_eEloc := hPullIsoBij e_SpecEloc ℓ 0 p_eEloc hp_eEloc
  have hSq_tot := hPullSqEq
    e_SpecEloc.hom (AlgebraicGeometry.Spec.map ι_E)
    (AlgebraicGeometry.Spec.map π_hom) e_SpecE.hom
    ℓ 0 p_eEloc ψ_E Ψ_pi p_eE hSpecSq hp_eEloc hψ_E hΨ_pi hp_eE
  let eqv_eE := Equiv.ofBijective p_eE hBij_eE
  let eqv_eEloc := Equiv.ofBijective p_eEloc hBij_eEloc
  have hψ_eq : (ψ_E : _ → _) = eqv_eEloc.symm ∘ Ψ_pi ∘ eqv_eE := by
    funext x
    apply eqv_eEloc.injective
    rw [Function.comp_apply, Function.comp_apply, Equiv.apply_symm_apply]
    exact DFunLike.congr_fun hSq_tot x
  rw [hψ_eq]
  exact eqv_eEloc.symm.bijective.comp (hBij_Ψ.comp eqv_eE.bijective)

theorem weil_punctured_val_ring_acyclic_filtered_colimit_torsionH (ℓ q : ℕ)
    (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥] [CategoryTheory.IsFiltered 𝒥]
    (B : 𝒥 ⥤ CommRingCat.{u})
    (c : CategoryTheory.Limits.Cocone B) (hc : CategoryTheory.Limits.IsColimit c) :
    (∀ (ξ_inf : weilEtaleTorsionH (AlgebraicGeometry.Spec c.pt) ℓ q),
      ∃ (j : 𝒥) (ξ_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q),
        ∀ (p_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q →+
            weilEtaleTorsionH (AlgebraicGeometry.Spec c.pt) ℓ q),
          WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (c.ι.app j)) ℓ q p_j →
          p_j ξ_j = ξ_inf) ∧
    (∀ (j : 𝒥) (ξ_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q)
      (p_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q →+
        weilEtaleTorsionH (AlgebraicGeometry.Spec c.pt) ℓ q),
      WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (c.ι.app j)) ℓ q p_j →
      p_j ξ_j = 0 →
      ∃ (j' : 𝒥) (φ : j ⟶ j'),
        ∀ (p_φ : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q →+
            weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j')) ℓ q),
          WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (B.map φ)) ℓ q p_φ →
          p_φ ξ_j = 0) :=
by
  classical
  have hConstPullInv :
      ∀ {𝒞₁ 𝒞₂ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞₁]
        [CategoryTheory.Category.{u, u + 1} 𝒞₂]
        (J₁ : CategoryTheory.GrothendieckTopology 𝒞₁)
        (J₂ : CategoryTheory.GrothendieckTopology 𝒞₂)
        [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
        [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
        (F_site : 𝒞₂ ⥤ 𝒞₁) [F_site.IsContinuous J₂ J₁]
        [(F_site.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint]
        {T₁ : 𝒞₁} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : 𝒞₂} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (τ_inv : T₁ ⟶ F_site.obj T₂),
        hT₁.from (F_site.obj T₂) ≫ τ_inv = 𝟙 (F_site.obj T₂) →
        τ_inv ≫ hT₁.from (F_site.obj T₂) = 𝟙 T₁ →
        ∀ (A : AddCommGrpCat.{u}),
          let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
          let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
          let pf := F_site.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
          let pb := F_site.sheafPullback AddCommGrpCat.{u} J₂ J₁
          let adj_pull := F_site.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
          let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
          let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
          let τ : F_site.obj T₂ ⟶ T₁ := hT₁.from (F_site.obj T₂)
          let π_A : pb.obj (C₂.obj A) ⟶ C₁.obj A :=
            (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
              ((adj₂.homEquiv A (pf.obj (C₁.obj A))).symm
                (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op))
          ∃ (ι_A : C₁.obj A ⟶ pb.obj (C₂.obj A)),
            ι_A ≫ π_A = 𝟙 (C₁.obj A) ∧ π_A ≫ ι_A = 𝟙 (pb.obj (C₂.obj A)) := by
    intro 𝒞₁ 𝒞₂ _ _ J₁ J₂ _ _ F_site _ _ T₁ hT₁ T₂ hT₂ τ_inv hτ₁ hτ₂ A
    intro C₁ C₂ pf pb adj_pull adj₁ adj₂ τ π_A
    have hMatePost : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) (g : C₁.obj A ⟶ F),
        (adj₂.homEquiv A (pf.obj F)) ((adj_pull.homEquiv (C₂.obj A) F) (π_A ≫ g)) =
          (adj₁.homEquiv A F g) ≫ F.obj.map τ.op := by
      intro F g
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.Adjunction.homEquiv_naturality_right]
      dsimp only [π_A]
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      change (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op) ≫
          g.hom.app (Opposite.op (F_site.obj T₂)) =
        (adj₁.homEquiv A F g) ≫ F.obj.map τ.op
      rw [CategoryTheory.Category.assoc, g.hom.naturality τ.op, ← CategoryTheory.Category.assoc,
        CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    let P_A : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} := pb.obj (C₂.obj A)
    let w₀ : A ⟶ P_A.obj.obj (Opposite.op (F_site.obj T₂)) :=
      (adj₂.homEquiv A (pf.obj P_A)) ((adj_pull.homEquiv (C₂.obj A) P_A) (𝟙 P_A))
    let ι_A : C₁.obj A ⟶ P_A :=
      (adj₁.homEquiv A P_A).symm (w₀ ≫ P_A.obj.map τ_inv.op)
    refine ⟨ι_A, ?_, ?_⟩
    · apply (adj₁.homEquiv A (C₁.obj A)).injective
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      dsimp only [ι_A]
      rw [Equiv.apply_symm_apply]
      have hstep1 :
          (w₀ ≫ P_A.obj.map τ_inv.op) ≫
              ((CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁)).map π_A =
            (w₀ ≫ π_A.hom.app (Opposite.op (F_site.obj T₂))) ≫ (C₁.obj A).obj.map τ_inv.op := by
        change (w₀ ≫ P_A.obj.map τ_inv.op) ≫ π_A.hom.app (Opposite.op T₁) = _
        rw [CategoryTheory.Category.assoc, π_A.hom.naturality τ_inv.op,
          ← CategoryTheory.Category.assoc]
      rw [hstep1]
      have hw₀ : w₀ ≫ π_A.hom.app (Opposite.op (F_site.obj T₂)) =
          adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op := by
        change (adj₂.homEquiv A (pf.obj P_A)) ((adj_pull.homEquiv (C₂.obj A) P_A) (𝟙 P_A)) ≫
            ((CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj
              (Opposite.op T₂)).map (pf.map π_A) = _
        rw [← CategoryTheory.Adjunction.homEquiv_naturality_right,
          ← CategoryTheory.Adjunction.homEquiv_naturality_right, CategoryTheory.Category.id_comp]
        dsimp only [π_A]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      rw [hw₀, CategoryTheory.Category.assoc, ← (C₁.obj A).obj.map_comp, ← CategoryTheory.op_comp,
        hτ₂, CategoryTheory.op_id, (C₁.obj A).obj.map_id]
      exact (CategoryTheory.Adjunction.homEquiv_unit adj₁ A (C₁.obj A) (𝟙 (C₁.obj A))).symm
    · apply (adj_pull.homEquiv (C₂.obj A) P_A).injective
      apply (adj₂.homEquiv A (pf.obj P_A)).injective
      rw [hMatePost P_A ι_A]
      dsimp only [ι_A]
      rw [Equiv.apply_symm_apply]
      change (w₀ ≫ P_A.obj.map τ_inv.op) ≫ P_A.obj.map τ.op = w₀
      rw [CategoryTheory.Category.assoc, ← P_A.obj.map_comp, ← CategoryTheory.op_comp, hτ₁,
        CategoryTheory.op_id, P_A.obj.map_id, CategoryTheory.Category.comp_id]

  have hConstZ_eq :
      ∀ {𝒞₁ 𝒞₂ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞₁]
        [CategoryTheory.Category.{u, u + 1} 𝒞₂]
        (J₁ : CategoryTheory.GrothendieckTopology 𝒞₁)
        (J₂ : CategoryTheory.GrothendieckTopology 𝒞₂)
        [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
        [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
        (F_site : 𝒞₂ ⥤ 𝒞₁) [F_site.IsContinuous J₂ J₁]
        [(F_site.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint]
        {T₁ : 𝒞₁} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : 𝒞₂} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (A : AddCommGrpCat.{u}),
        let P₁ := (CategoryTheory.Functor.const (Opposite 𝒞₁)).obj A
        let P₂ := (CategoryTheory.Functor.const (Opposite 𝒞₂)).obj A
        let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
        let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
        let pf := F_site.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
        let adj_pull := F_site.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : F_site.obj T₂ ⟶ T₁ := hT₁.from (F_site.obj T₂)
        let η₁ := CategoryTheory.Functor.whiskerLeft F_site.op
          ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app P₁)
        let u_A := ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv P₂
          (pf.obj (C₁.obj A))).symm η₁
        let c_A := (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm u_A
        let π_A := (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
          ((adj₂.homEquiv A (pf.obj (C₁.obj A))).symm
            (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op))
        c_A = π_A := by
    intro 𝒞₁ 𝒞₂ _ _ J₁ J₂ _ _ F_site _ _ T₁ hT₁ T₂ hT₂ A
    intro P₁ P₂ C₁ C₂ pf adj_pull adj₁ adj₂ τ η₁ u_A c_A π_A
    dsimp only [c_A, π_A]
    congr 1
    apply (adj₂.homEquiv A (pf.obj (C₁.obj A))).injective
    rw [Equiv.apply_symm_apply]
    have hu : (adj₂.homEquiv A (pf.obj (C₁.obj A))) u_A =
        ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app P₁).app
          (Opposite.op (F_site.obj T₂)) := by
      let e_sh := (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv P₂
        (pf.obj (C₁.obj A))
      let e_pre := (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₂).homEquiv A
        (pf.obj (C₁.obj A)).obj
      have h1 : (adj₂.homEquiv A (pf.obj (C₁.obj A))) u_A = e_pre η₁ :=
        congrArg e_pre (e_sh.apply_symm_apply η₁)
