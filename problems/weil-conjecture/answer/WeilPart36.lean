                    rw [CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
          let e_coker : CategoryTheory.Limits.cokernel ψ ≅ CategoryTheory.Limits.cokernel δ₁ :=
            { hom := CategoryTheory.Limits.cokernel.desc ψ
                (e_Mq.hom ≫ CategoryTheory.Limits.cokernel.π δ₁) hψ_cond
              inv := CategoryTheory.Limits.cokernel.desc δ₁
                (e_Mq.inv ≫ CategoryTheory.Limits.cokernel.π ψ) hδ_cond
              hom_inv_id := by
                apply (cancel_epi (CategoryTheory.Limits.cokernel.π ψ)).mp
                rw [← Category.assoc, CategoryTheory.Limits.cokernel.π_desc, Category.assoc,
                  CategoryTheory.Limits.cokernel.π_desc, ← Category.assoc, e_Mq.hom_inv_id,
                  Category.id_comp, Category.comp_id]
              inv_hom_id := by
                apply (cancel_epi (CategoryTheory.Limits.cokernel.π δ₁)).mp
                rw [← Category.assoc, CategoryTheory.Limits.cokernel.π_desc, Category.assoc,
                  CategoryTheory.Limits.cokernel.π_desc, ← Category.assoc, e_Mq.inv_hom_id,
                  Category.id_comp, Category.comp_id] }
          let eQ_full : C_D.obj Q ≅ CategoryTheory.Limits.cokernel δ₁ := eQ ≪≫ e_coker
          have hSub_Q : Subsingleton ((C_D.obj Q).H 1) := hH1_const 1 Q hTorQ
          obtain ⟨K₁, hFinK₁, ⟨eK₁⟩⟩ :=
            hKerConst_low hm (q' + 1) hq A'' (e''.hom ≫ δ₂)
          have : Finite ↥K₁ := hFinK₁
          have : CategoryTheory.IsIso e''.hom := e''.isIso_hom
          let eK₁_full : C_D.obj K₁ ≅ CategoryTheory.Limits.kernel δ₂ :=
            eK₁ ≪≫ CategoryTheory.Limits.kernelIsIsoComp e''.hom δ₂
          exact hExtClosure_D (CategoryTheory.ShortComplex.mk i₁ p₁ h₁) hSE₁
            Q K₁ hSub_Q ⟨eQ_full⟩ ⟨eK₁_full⟩
    intro r T hT
    obtain ⟨A, hFinA, hIsoA⟩ := hInd r (2 * m) (le_refl (2 * m))
    have : Finite ↥A := hFinA
    exact hTransfer_D A _ T hT hIsoA

theorem weil_sing_dev_deg2m_p1_const_h2_twist_equiv (F : Type u) [Finite F] [Field F]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (sys : WeilEtaleSitePullbackSys.{u})
    [Nonempty ↥(weilGeomScheme F (weilProjectiveSpaceOver F 1))]
    [PreconnectedSpace ↥(weilGeomScheme F (weilProjectiveSpaceOver F 1))]
    (hH1_const : ∀ (n : ℕ) (A : AddCommGrpCat.{u}) [Finite ↥A],
      (ℓ ^ n) • CategoryTheory.CategoryStruct.id A = 0 →
      Subsingleton
        (((CategoryTheory.constantSheaf
          (weilGeomScheme F (weilProjectiveSpaceOver F 1)).smallEtaleTopology
