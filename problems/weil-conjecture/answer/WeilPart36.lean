        Function.Bijective Ψ := by
    intro n R R' _ _ φ hBij Ψ hΨ
    choose ev_R hev_R using fun i : Fin n =>
      hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i))) ℓ 0
    choose ev_R' hev_R' using fun i : Fin n =>
      hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom R' i))) ℓ 0
    choose p_i hp_i using fun i : Fin n =>
      hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ i))) ℓ 0
