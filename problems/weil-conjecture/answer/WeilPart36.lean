      exact hpb_mv0
    have hpb_ι_tilde : CategoryTheory.IsPullback ι_tilde
        (AlgebraicGeometry.Spec.map inr_mv)
        (CategoryTheory.Limits.pullback.snd S_d.hom p_base) ι_U :=
      CategoryTheory.IsPullback.of_right hpb_ι_outer
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback S_d.hom p_base)
    have _ : AlgebraicGeometry.Etale ι_tilde :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_ι_tilde.flip inferInstance
    have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hγ_et
    have _ : AlgebraicGeometry.Etale V₀.toSpecΓ := by
      rw [← hAffV₀.isoSpec_hom]
      infer_instance
    let φ₀ : V₀.toScheme ⟶ Y_d :=
      V₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ) ≫ ι_tilde
    have _ : AlgebraicGeometry.Etale φ₀ := by
      dsimp [φ₀]
      infer_instance
    have hφ₀_snd : φ₀ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_base =
        V₀.ι ≫ f₀_hom := by
      have hsnd : ι_tilde ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_base =
          AlgebraicGeometry.Spec.map inr_mv ≫ ι_U :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      dsimp [φ₀]
      rw [Category.assoc, Category.assoc, hsnd,
        ← Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ)),
        ← AlgebraicGeometry.Spec.map_comp]
      have hγ_inr : inr_mv ≫ CommRingCat.ofHom γ = f₀_hom.appLE U V₀ e_VU :=
        CommRingCat.hom_ext hγ_C
      rw [hγ_inr, AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc,
        hAffU.toSpecΓ_fromSpec, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    let V_R : X_R.Opens := (TopologicalSpace.Opens.map fst_XR.base).obj V₀
    have hx_VR : x ∈ V_R := hx₀_V₀
    have hpb_res : CategoryTheory.IsPullback (fst_XR ∣_ V₀) V_R.ι V₀.ι fst_XR :=
      AlgebraicGeometry.isPullback_morphismRestrict fst_XR V₀
    have hpb_VR_V0 : CategoryTheory.IsPullback
        (fst_XR ∣_ V₀) (V_R.ι ≫ f_R) (V₀.ι ≫ f₀_hom) g_R :=
      hpb_res.paste_vert (CategoryTheory.IsPullback.of_hasPullback f₀_hom g_R)
    let φ_R : V_R.toScheme ⟶ A_R :=
      hpb_AY.lift ((fst_XR ∣_ V₀) ≫ φ₀) (V_R.ι ≫ f_R)
        (by
          rw [Category.assoc, hφ₀_snd]
          exact hpb_VR_V0.w)
    have hpb_φR_outer : CategoryTheory.IsPullback
        (φ_R ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        (fst_XR ∣_ V₀) g_R
        (φ₀ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_base) := by
      rw [hpb_AY.lift_snd, hφ₀_snd]
      exact hpb_VR_V0.flip
    have hpb_φR : CategoryTheory.IsPullback φ_R (fst_XR ∣_ V₀) π_AY φ₀ :=
      CategoryTheory.IsPullback.of_right hpb_φR_outer (hpb_AY.lift_fst _ _ _) hpb_AY.flip
    have hEt_φR : AlgebraicGeometry.Etale φ_R :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_φR.flip inferInstance
    let V_U := CategoryTheory.Limits.pullback j_X V_R.ι
    let ι_VU : V_U ⟶ X_R_Ω := CategoryTheory.Limits.pullback.fst j_X V_R.ι
    let j_V : V_U ⟶ V_R.toScheme := CategoryTheory.Limits.pullback.snd j_X V_R.ι
    have hSq1 : CategoryTheory.IsPullback ι_VU j_V j_X V_R.ι :=
      CategoryTheory.IsPullback.of_hasPullback j_X V_R.ι
    let snd_XRΩ := CategoryTheory.Limits.pullback.snd f_R j_R
    have hpb_jX : CategoryTheory.IsPullback j_X snd_XRΩ f_R j_R :=
      CategoryTheory.IsPullback.of_hasPullback f_R j_R
    have hpb_VU_jR : CategoryTheory.IsPullback (ι_VU ≫ snd_XRΩ) j_V j_R (V_R.ι ≫ f_R) :=
      hSq1.paste_horiz hpb_jX.flip
    have hVR_fR_eq : V_R.ι ≫ f_R = φ_R ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R :=
      (hpb_AY.lift_snd _ _ _).symm
    have hpb_jA : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        j_A j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) :=
      CategoryTheory.IsPullback.of_hasPullback j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let φ_U : V_U ⟶ A_Ω :=
      CategoryTheory.Limits.pullback.lift (ι_VU ≫ snd_XRΩ) (j_V ≫ φ_R)
        (by
          rw [Category.assoc j_V, ← hVR_fR_eq]
          exact hpb_VU_jR.w)
    have hpb_φU_outer : CategoryTheory.IsPullback
        (φ_U ≫ CategoryTheory.Limits.pullback.fst j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        j_V j_R (φ_R ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) := by
      have hfst : φ_U ≫ CategoryTheory.Limits.pullback.fst j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) = ι_VU ≫ snd_XRΩ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst, ← hVR_fR_eq]
      exact hpb_VU_jR
    have hSq2 : CategoryTheory.IsPullback φ_U j_V j_A φ_R :=
      CategoryTheory.IsPullback.of_right hpb_φU_outer
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) hpb_jA
    exact ⟨V_R, hx_VR, φ_R, hEt_φR, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩
  intro U_Δ g_Δ_R j_R X_R X_R_Ω j_X q ψ_q hψ_q
  let P := Polynomial k
  let R_Δ := Localization.Away Δ₀
  let p_R : P →+* R_bar := p_Δ_R.comp (algebraMap P R_Δ)
  let S_d := weilAffineSpaceOver k d_rel
  let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
  let j_A :=
    CategoryTheory.Limits.pullback.snd j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
  let p_UΔ : U_Δ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((algebraMap P R_Δ).comp Polynomial.C))
  have hg_Δ_R_p : g_Δ_R ≫ p_UΔ = g_k_R := by
    dsimp [g_Δ_R, p_UΔ, g_k_R, p_R]
    rw [← AlgebraicGeometry.Spec.map_comp]
    simp only [Category.assoc]
  have hAtlas_XR :=
    hAtlasGen X₀ U_Δ p_UΔ f₀ R_bar Ω g_k_R g_Δ_R hg_Δ_R_p j_R
  exact weil_origin_cosp_etale_atlas_acyclic_pullback_bijective
    ℓ j_A j_X hBij0_A hZero_A hAtlas_XR q ψ_q hψ_q

theorem weil_punctured_line_locConst_origin_card_and_basis_lift (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (Δ₀ : Polynomial k)
    (ev₀ : Localization.Away Δ₀ →+* k)
    (hev₀ : ev₀.comp (algebraMap (Polynomial k) (Localization.Away Δ₀)) = Polynomial.evalRingHom 0)
    (φ_Δ_Ω : Localization.Away Δ₀ →+* AlgebraicClosure (FractionRing (Polynomial k)))
    (hφ_Δ_Ω : φ_Δ_Ω.comp (algebraMap (Polynomial k) (Localization.Away Δ₀)) =
      algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))
    (X₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₀ : X₀ ⟶ CategoryTheory.Over.mk
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap (Polynomial k) (Localization.Away Δ₀)).comp Polynomial.C))))
    [AlgebraicGeometry.IsProper f₀.left]
    (q : ℕ)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [HenselianLocalRing R_bar]
    [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    (p_Δ_R : Localization.Away Δ₀ →+* R_bar)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial k)))
    (hφ_comp : φ_R_Ω.comp p_Δ_R = φ_Δ_Ω)
    (hφ_inj : Function.Injective φ_R_Ω)
    (hj_open : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)))
    (hRes : (IsLocalRing.residue R_bar).comp p_Δ_R =
      ((IsLocalRing.residue R_bar).comp
        ((p_Δ_R.comp (algebraMap (Polynomial k) (Localization.Away Δ₀))).comp Polynomial.C)).comp
        ev₀)
    (hBij_jX :
      let U_Δ := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away Δ₀))
      let Ω := AlgebraicClosure (FractionRing (Polynomial k))
      let g_Δ_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ U_Δ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_Δ_R)
      let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
      let j_X := CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd f₀.left g_Δ_R) j_R
      ∀ ψ_q : weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀.left g_Δ_R) ℓ q →+
          weilEtaleTorsionH
            (CategoryTheory.Limits.pullback
              (CategoryTheory.Limits.pullback.snd f₀.left g_Δ_R) j_R) ℓ q,
        WeilIsTorsionEtalePullback j_X ℓ q ψ_q → Function.Bijective ψ_q)
    (ℐ_sh : Type u) [CategoryTheory.SmallCategory ℐ_sh] [CategoryTheory.IsFiltered ℐ_sh]
    (D_sh : ℐ_sh ⥤ CommRingCat.{u})
    (α_sh : (CategoryTheory.Functor.const ℐ_sh).obj
      (CommRingCat.of (Localization.Away Δ₀)) ⟶ D_sh)
    (R_sh : Type u) [CommRing R_sh] [IsDomain R_sh] [HenselianLocalRing R_sh]
    [IsAlgClosed (IsLocalRing.ResidueField R_sh)]
    (f_sh : CommRingCat.of (Localization.Away Δ₀) ⟶ CommRingCat.of R_sh)
    (ι_sh : CommRingCat.of R_sh ⟶ CommRingCat.of R_bar)
    (c_sh : CategoryTheory.Limits.Cocone D_sh)
    (hc_sh : CategoryTheory.Limits.IsColimit c_sh)
    (e_sh : c_sh.pt ≅ CommRingCat.of R_sh)
    (hf_ι_sh : f_sh ≫ ι_sh = CommRingCat.ofHom p_Δ_R)
    (hι_sh_inj : Function.Injective ι_sh.hom)
    (hMax_sh : ∀ x : R_sh, ι_sh.hom x ∈ IsLocalRing.maximalIdeal R_bar ↔
      x ∈ IsLocalRing.maximalIdeal R_sh)
    (hStage_sh : ∀ j : ℐ_sh,
      (α_sh.app j).hom.Etale ∧
      IsDomain ↑(D_sh.obj j) ∧
      (α_sh.app j) ≫ (c_sh.ι.app j) ≫ e_sh.hom = f_sh ∧
      Function.Injective (((c_sh.ι.app j) ≫ e_sh.hom) ≫ ι_sh).hom ∧
      ∃ χ_j : D_sh.obj j ⟶ CommRingCat.of k,
        (α_sh.app j) ≫ χ_j = CommRingCat.ofHom ev₀) :
    let R_Δ := Localization.Away Δ₀
    let U_Δ := AlgebraicGeometry.Spec (CommRingCat.of R_Δ)
    let Ω := AlgebraicClosure (FractionRing (Polynomial k))
    let s₀_Δ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_Δ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)
    let η_Δ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U_Δ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Δ_Ω)
    let X_s₀ := CategoryTheory.Limits.pullback f₀.left s₀_Δ
    let X_η := CategoryTheory.Limits.pullback f₀.left η_Δ
    let G_Δ := weilEtaleHigherDirectImage f₀.left q (weilEtaleTorsionSheaf X₀.left ℓ)
    Nat.card (weilEtaleTorsionH X_s₀ ℓ q) = Nat.card (weilEtaleTorsionH X_η ℓ q) ∧
    (Finite (weilEtaleTorsionH X_s₀ ℓ q) →
      ∃ (W₀ : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsAffine W₀)
        (_ : AlgebraicGeometry.IsIntegral W₀)
        (w₀ : W₀ ⟶ U_Δ)
        (_ : AlgebraicGeometry.Etale w₀)
        (s_W : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀)
        (η_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀)
        (G_W : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u})
        (Φ : (CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (weilEtaleTorsionH X_s₀ ℓ q)) ⟶ G_W),
        s_W ≫ w₀ = s₀_Δ ∧
        η_W ≫ w₀ = η_Δ ∧
        DenseRange η_W.base ∧
        WeilIsEtaleSheafPullback w₀ G_Δ G_W ∧
        ∀ (H_η : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback η_W (CategoryTheory.Limits.kernel Φ) H_η →
          CategoryTheory.Limits.IsZero H_η) :=
by
  classical
  intro R_Δ U_Δ Ω s₀_Δ η_Δ X_s₀ X_η G_Δ
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
