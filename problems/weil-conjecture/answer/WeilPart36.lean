      apply MvPolynomial.ext
      intro m
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hm : m ∈ p.support
      · rw [Finset.sum_eq_single m
          (fun x_m _ hxm => by simp only [hxm, ↓reduceIte])
          (fun h => absurd hm h)]
        simp only [↓reduceIte]
        exact hy m hm
      · have hsum0 : (∑ x_m ∈ p.support, if x_m = m then y_fn x_m else 0) = 0 := by
          refine Finset.sum_eq_zero fun x_m hx => ?_
          have hxm : x_m ≠ m := fun h => hm (h ▸ hx)
          simp only [hxm, ↓reduceIte]
        rw [hsum0, map_zero, MvPolynomial.notMem_support_iff.mp hm]
    have hLiftPolyFam : ∀ {n r : ℕ} (F_fam : Fin r → MvPolynomial (Fin n) ↑c_poly.pt),
        ∃ (i : ℐ) (F_lift : Fin r → MvPolynomial (Fin n) ↑(D_poly.obj i)),
          ∀ s : Fin r, MvPolynomial.map (c_poly.ι.app i).hom (F_lift s) = F_fam s := by
      intro n r F_fam
      suffices ∀ (T : Finset (Fin r)),
          ∃ (i : ℐ) (F_lift : Fin r → MvPolynomial (Fin n) ↑(D_poly.obj i)),
            ∀ s ∈ T, MvPolynomial.map (c_poly.ι.app i).hom (F_lift s) = F_fam s by
        obtain ⟨i, F_lift, hF⟩ := this Finset.univ
        exact ⟨i, F_lift, fun s => hF s (Finset.mem_univ s)⟩
      intro T
      induction T using Finset.induction_on with
      | empty =>
        obtain ⟨i_e⟩ := hNonemptyℐ
        exact ⟨i_e, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert s₀ T' hs₀ ih =>
        obtain ⟨i₁, F₁, hF₁⟩ := ih
        obtain ⟨i₂, p₂, hp₂⟩ := hLiftPoly (F_fam s₀)
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun s => if s = s₀ then MvPolynomial.map (D_poly.map u₂).hom p₂
            else MvPolynomial.map (D_poly.map u₁).hom (F₁ s), ?_⟩
        intro s hs
        rcases Finset.mem_insert.mp hs with rfl | hsT'
        · simp only [↓reduceIte, MvPolynomial.map_map]
          have hw₂ : (c_poly.ι.app i₃).hom.comp (D_poly.map u₂).hom =
              (c_poly.ι.app i₂).hom := by
            rw [← CommRingCat.hom_comp, c_poly.w u₂]
          rw [hw₂, hp₂]
        · have hne : s ≠ s₀ := fun h => hs₀ (h ▸ hsT')
          simp only [hne, ↓reduceIte, MvPolynomial.map_map]
          have hw₁ : (c_poly.ι.app i₃).hom.comp (D_poly.map u₁).hom =
              (c_poly.ι.app i₁).hom := by
            rw [← CommRingCat.hom_comp, c_poly.w u₁]
          rw [hw₁, hF₁ s hsT']
    let _ : Algebra ↑c_poly.pt ↑E_inf := f_E.hom.toAlgebra
    have halg_fE : algebraMap (↑c_poly.pt) (↑E_inf) = f_E.hom := rfl
    have hEt_inf : Algebra.Etale (↑c_poly.pt) (↑E_inf) := by
