          _ = Ξ_const.inv.app Aℤ ≫ (cℤ_u ≫ CategoryTheory.inv cℤ_u) := by
                rw [Category.assoc, hΞ_Aℤ]
          _ = Ξ_const.inv.app Aℤ := by
