          ((C_W.obj Aℤ).obj.map_comp (Opposite.op (B.map (hT₂.from W) ≫ τ)) (Opposite.op δ₁))
        have he := congrArg (fun m => ((C_W.obj Aℤ).obj.map (Opposite.op m)).hom u₁) hEnd
        have hid := congrArg (fun f => f.hom u₁) ((C_W.obj Aℤ).obj.map_id (Opposite.op T₁))
        exact (congrArg ((C_W.obj Aℤ).obj.map (Opposite.op δ₁)).hom hc1.symm).trans
          (hc2.symm.trans (he.trans hid))
      exact hStep1.trans (hStep2.trans
        ((congrArg ((C_W.obj Aℤ).obj.map (Opposite.op δ₁)).hom
          (hStep3.trans ((congrArg (φ₂.hom.app (Opposite.op W)).hom huW_eval).trans hStep4))).trans
          (hStep5.trans hRHS.symm)))
    have hMor_eq : ρ_δ ≫ P_pull.map u_W =
        weilPolyP1CohomologyRepToConst W₀ T₁ hT₁ ≫ ιℤ := by
      calc
        ρ_δ ≫ P_pull.map u_W
            = (ρ_δ ≫ P_pull.map u_W) ≫ 𝟙 (P_pull.obj (C_Y.obj Aℤ)) := (Category.comp_id _).symm
        _ = (ρ_δ ≫ P_pull.map u_W) ≫ (πℤ ≫ ιℤ) := by rw [hπι]
        _ = ((ρ_δ ≫ P_pull.map u_W) ≫ πℤ) ≫ ιℤ := (Category.assoc _ _ _).symm
        _ = weilPolyP1CohomologyRepToConst W₀ T₁ hT₁ ≫ ιℤ := by rw [hMor_π]
    rw [hMor_eq, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _
        (Nat.zero_add q) (Nat.add_zero q) (Nat.zero_add q)] at hPrePost_zero
    have hpW_β : p_W β =
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C_Y.obj Aℤ) (C_Y.obj AM) q) β) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q)) := hp_eq β
    have hTermZero : weilPolyP1CohomologyTermToPresheaf W₀ T₁ hT₁ (C_W.obj AM) q (p_W β) = 0 := by
      change (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1CohomologyRepToConst W₀ T₁ hT₁)).comp
        (p_W β) (Nat.zero_add q) = 0
      rwa [hpW_β]
    let e_W := weilPolyP1CohomologyTermToPresheaf W₀ T₁ hT₁ (C_W.obj AM) q
    exact (hTermBij W₀ T₁ hT₁ (C_W.obj AM) q).1 (hTermZero.trans (map_zero e_W).symm)

theorem weil_sing_dev_odp_sq_point_section_prime_pow_pbc_eval (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ q_deg r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (Z_bar D_bar Z_s_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType D_bar.hom]
    (f_bar : Z_bar ⟶ D_bar) [AlgebraicGeometry.IsProper f_bar.left]
    (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left)
    (hs_bar : s_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_Zbar : Z_s_bar.left ⟶ Z_bar.left)
    (hPb_s : CategoryTheory.IsPullback π_Zbar Z_s_bar.hom f_bar.left s_bar)
    (Θ_Z : ∀ (V : Z_bar.left.Etale),
      ↥(((weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r + 1))).cohomologyPresheaf q_deg).obj
        (Opposite.op V)) ≃+
        weilEtaleTorsionH
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj V).left (ℓ ^ (r + 1)) q_deg)
    (hΘ_Z : ∀ {V₁ V₂ : Z_bar.left.Etale} (g : Quiver.Hom V₁ V₂)
      (p_g : weilEtaleTorsionH
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj V₂).left (ℓ ^ (r + 1)) q_deg →+
        weilEtaleTorsionH
          ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj V₁).left (ℓ ^ (r + 1)) q_deg),
      WeilIsTorsionEtalePullback
        ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).map g).left (ℓ ^ (r + 1)) q_deg p_g →
      ∀ z : ↥(((weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r + 1))).cohomologyPresheaf q_deg).obj
        (Opposite.op V₂)),
        Θ_Z V₁ ((((weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r + 1))).cohomologyPresheaf q_deg).map
          g.op).hom z) = p_g (Θ_Z V₂ z)) :
    let B_fbar := weilEtaleSitePullback f_bar.left
    let P_pre := CategoryTheory.Functor.comp B_fbar.op
      ((weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r + 1))).cohomologyPresheaf q_deg)
    let ℛ_bar := weilEtaleHigherDirectImage f_bar.left q_deg
      (weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r + 1)))
    let θ_sh := (CategoryTheory.sheafificationAdjunction D_bar.left.smallEtaleTopology
      AddCommGrpCat.{u}).unit.app P_pre
    let hT_D := weilEtaleIdTerminalIsTerminal.{u} D_bar.left
    ∃ ev_sbar : ℛ_bar.H 0 →+ weilEtaleTorsionH Z_s_bar.left (ℓ ^ (r + 1)) q_deg,
      (∀ η' : ℛ_bar.H 0,
        ev_sbar η' = 0 →
        ∃ (W_s : D_bar.left.Etale)
          (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_s).left),
          s_tilde ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_s).hom = s_bar ∧
          ∀ W' : D_bar.left.Etale,
            Nonempty (W' ⟶ W_s) →
            (CategoryTheory.Abelian.Ext.addEquiv₀ η').hom.app (Opposite.op W') = 0) ∧
      (∀ (ξ' : ℛ_bar.H 0) (W_et : D_bar.left.Etale)
        (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_et).left),
        s_tilde ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_et).hom = s_bar →
        ∀ z₀ : ↥(P_pre.obj (Opposite.op W_et)),
          (θ_sh.app (Opposite.op W_et)).hom z₀ =
            (ℛ_bar.obj.map (Opposite.op (hT_D.from W_et))).hom
              ((((CategoryTheory.constantSheafAdj D_bar.left.smallEtaleTopology AddCommGrpCat.{u} hT_D).homEquiv
                  (AddCommGrpCat.of (ULift.{u} ℤ)) ℛ_bar)
                (CategoryTheory.Abelian.Ext.addEquiv₀ ξ')).hom
                (ULift.up (1 : ℤ))) →
          ∀ (ι : Z_s_bar.left ⟶
              ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (B_fbar.obj W_et)).left),
            ι ≫ CategoryTheory.Limits.pullback.fst
                ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_et).hom f_bar.left =
              Z_s_bar.hom ≫ s_tilde →
            ι ≫ CategoryTheory.Limits.pullback.snd
                ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W_et).hom f_bar.left =
              π_Zbar →
            ∀ (p_ι : weilEtaleTorsionH
                  ((AlgebraicGeometry.Scheme.Etale.forget Z_bar.left).obj (B_fbar.obj W_et)).left
                  (ℓ ^ (r + 1)) q_deg →+
                weilEtaleTorsionH Z_s_bar.left (ℓ ^ (r + 1)) q_deg),
              WeilIsTorsionEtalePullback ι (ℓ ^ (r + 1)) q_deg p_ι →
              ev_sbar ξ' = p_ι (Θ_Z (B_fbar.obj W_et) z₀)) :=
by
  classical
  intro B_fbar P_pre ℛ_bar θ_sh hT_D
  let n_mod : ℕ := ℓ ^ (r + 1)
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)

  
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality
  obtain ⟨hc_all, hr_all, hSiteEx, _, hConstIso_all, _⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria
  have sys : WeilEtaleSitePullbackSys.{u} := fun {Z₁ Z₂} h =>
    { hCont := @hc_all Z₁ Z₂ h
      hAdj := @hr_all Z₁ Z₂ h
      hAdd_pb := (@hSiteEx Z₁ Z₂ h).1
      hAdd_pf := (@hSiteEx Z₁ Z₂ h).2.1
      hLim_pb := (@hSiteEx Z₁ Z₂ h).2.2.1
      hColim_pb := (@hSiteEx Z₁ Z₂ h).2.2.2
      hConstIso := fun {T₁} hT₁ {T₂} hT₂ A => @hConstIso_all Z₁ Z₂ h T₁ hT₁ T₂ hT₂ A }
  obtain ⟨_, _, _, hStalkColim_k⟩ := weil_etale_algClosed_spec_unit_iso_and_stalk_colimit k
  obtain ⟨hLiftCov, _, hDiagZero⟩ := weil_odp_pbc_eval_algClosed_sieve_lift_and_diagonal_zero k

  
  have hTor_m : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      m • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Y m) = 0 := by
    intro Y m
    let J := Y.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let FM := weilEtaleTorsionSheaf Y m
    let T := weilEtaleIdTerminal.{u} Y
    let hT := weilEtaleIdTerminalIsTerminal.{u} Y
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    apply (adj.homEquiv AM FM).injective
    have h0 : adj.homEquiv AM FM 0 = 0 := by
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      simp
    rw [h0, CategoryTheory.Adjunction.homEquiv_unit]
    apply AddCommGrpCat.ext
    intro x
    let u_hom : ↥AM →+ ↥(FM.obj.obj (Opposite.op T)) := (adj.unit.app AM).hom
    change m • u_hom x = 0
    have hmx : m • x = 0 := by
      apply ULift.ext
      change m • x.down = 0
      simp
    exact (_root_.map_nsmul u_hom m x).symm.trans ((congrArg u_hom hmx).trans u_hom.map_zero)

  have hTerm_pb : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.Limits.IsTerminal
        ((weilEtaleSitePullback h).obj (weilEtaleIdTerminal.{u} X₂)) := by
    intro X₁ X₂ h
    let T₂ := weilEtaleIdTerminal.{u} X₂
    let B := weilEtaleSitePullback h
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget X₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget X₂
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.lift ((Fgt₁.obj W).hom ≫ h) (Fgt₁.obj W).hom
          (CategoryTheory.Category.comp_id ((Fgt₁.obj W).hom ≫ h)))
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial)
      (fun W g => ?_)
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    let gl : (Fgt₁.obj W).left ⟶ (Fgt₁.obj (B.obj T₂)).left := (Fgt₁.map g).left
    have hgw : gl ≫ CategoryTheory.Limits.pullback.snd (Fgt₂.obj T₂).hom h =
        (Fgt₁.obj W).hom := (Fgt₁.map g).w
    apply CategoryTheory.Limits.pullback.hom_ext
    · have hcond : CategoryTheory.Limits.pullback.fst (Fgt₂.obj T₂).hom h ≫
          (Fgt₂.obj T₂).hom =
          CategoryTheory.Limits.pullback.snd (Fgt₂.obj T₂).hom h ≫ h :=
        CategoryTheory.Limits.pullback.condition
      have hfst_eq : CategoryTheory.Limits.pullback.fst (Fgt₂.obj T₂).hom h =
          CategoryTheory.Limits.pullback.snd (Fgt₂.obj T₂).hom h ≫ h :=
        (CategoryTheory.Category.comp_id
          (CategoryTheory.Limits.pullback.fst (Fgt₂.obj T₂).hom h)).symm.trans hcond
      exact (congrArg (gl ≫ ·) hfst_eq).trans
        (((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ h) hgw)).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
    · exact hgw.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm

  have hTermIndep : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {T₁ T₂ W : Z.Etale}
      (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (u₁ : W ⟶ T₁) (u₂ : W ⟶ T₂)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (q : ℕ) (β : G.H q),
      ((G.cohomologyPresheaf q).map (Opposite.op u₁)).hom
        (weilPolyP1CohomologyTermToPresheaf Z T₁ hT₁ G q β) =
      ((G.cohomologyPresheaf q).map (Opposite.op u₂)).hom
        (weilPolyP1CohomologyTermToPresheaf Z T₂ hT₂ G q β) := by
    intro Z T₁ T₂ W hT₁ hT₂ u₁ u₂ G q β
    let J := Z.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let e : T₁ ⟶ T₂ := hT₂.from T₁
    have hu₂ : u₂ = u₁ ≫ e := hT₂.hom_ext u₂ (u₁ ≫ e)
    have hcomp_op : (G.cohomologyPresheaf q).map (Opposite.op u₂) =
        (G.cohomologyPresheaf q).map (Opposite.op e) ≫
          (G.cohomologyPresheaf q).map (Opposite.op u₁) :=
      (congrArg (G.cohomologyPresheaf q).map (congrArg Opposite.op hu₂)).trans
        ((G.cohomologyPresheaf q).map_comp e.op u₁.op)
    suffices hT_eq : ((G.cohomologyPresheaf q).map (Opposite.op e)).hom
        (weilPolyP1CohomologyTermToPresheaf Z T₂ hT₂ G q β) =
        weilPolyP1CohomologyTermToPresheaf Z T₁ hT₁ G q β by
      have happ := congrArg
        (fun f => f.hom (weilPolyP1CohomologyTermToPresheaf Z T₂ hT₂ G q β)) hcomp_op
      exact (congrArg ((G.cohomologyPresheaf q).map (Opposite.op u₁)).hom
        hT_eq.symm).trans happ.symm
    let Z_fun : Z.Etale ⥤ CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      CategoryTheory.yoneda ⋙
        ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u) AddCommGrpCat.{u}).obj
          AddCommGrpCat.free ⋙ CategoryTheory.presheafToSheaf J AddCommGrpCat.{u})
    have hmor : Z_fun.map e ≫ weilPolyP1CohomologyRepToConst Z T₂ hT₂ =
        weilPolyP1CohomologyRepToConst Z T₁ hT₁ := by
      apply (weilPolyP1CohomologyRepHomEquiv Z T₁ Fℤ).injective
      have hRHS : weilPolyP1CohomologyRepHomEquiv Z T₁ Fℤ
          (weilPolyP1CohomologyRepToConst Z T₁ hT₁) =
          (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₁).unit.app Aℤ).hom)
            (ULift.up (1 : ℤ)) :=
        (weilPolyP1CohomologyRepHomEquiv Z T₁ Fℤ).apply_symm_apply _
      let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
      let frAdj := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
      let f₂ := weilPolyP1CohomologyRepToConst Z T₂ hT₂
      let w_e := CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map e) AddCommGrpCat.free
      have hsh : (shAdj.homEquiv (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj T₁)
          AddCommGrpCat.free) Fℤ) (Z_fun.map e ≫ f₂) =
          w_e ≫ (shAdj.homEquiv (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj T₂)
            AddCommGrpCat.free) Fℤ) f₂ :=
        shAdj.homEquiv_naturality_left w_e f₂
      have hfr : (frAdj.homEquiv (CategoryTheory.yoneda.obj T₁) Fℤ.obj)
          (w_e ≫ (shAdj.homEquiv _ Fℤ) f₂) =
          CategoryTheory.yoneda.map e ≫
            (frAdj.homEquiv (CategoryTheory.yoneda.obj T₂) Fℤ.obj)
              ((shAdj.homEquiv _ Fℤ) f₂) :=
        frAdj.homEquiv_naturality_left (CategoryTheory.yoneda.map e) ((shAdj.homEquiv _ Fℤ) f₂)
      have hyon : CategoryTheory.yonedaEquiv (CategoryTheory.yoneda.map e ≫
          (frAdj.homEquiv (CategoryTheory.yoneda.obj T₂) Fℤ.obj) ((shAdj.homEquiv _ Fℤ) f₂)) =
          (Fℤ.obj.map (Opposite.op e)).hom
            (weilPolyP1CohomologyRepHomEquiv Z T₂ Fℤ f₂) :=
        (CategoryTheory.yonedaEquiv_naturality _ e).symm
      have hLHS : weilPolyP1CohomologyRepHomEquiv Z T₁ Fℤ (Z_fun.map e ≫ f₂) =
          (Fℤ.obj.map (Opposite.op e)).hom
            (weilPolyP1CohomologyRepHomEquiv Z T₂ Fℤ f₂) :=
        (congrArg (fun x => CategoryTheory.yonedaEquiv
          ((frAdj.homEquiv (CategoryTheory.yoneda.obj T₁) Fℤ.obj) x)) hsh).trans
          ((congrArg CategoryTheory.yonedaEquiv hfr).trans hyon)
      let Pℤ := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ
      let η := shAdj.unit.app Pℤ
      have hnat := congrArg (fun f => f.hom (ULift.up (1 : ℤ))) (η.naturality (Opposite.op e))
      dsimp [Pℤ] at hnat
      exact hLHS.trans ((congrArg (Fℤ.obj.map (Opposite.op e)).hom
        ((weilPolyP1CohomologyRepHomEquiv Z T₂ Fℤ).apply_symm_apply _)).trans
        (hnat.symm.trans hRHS.symm))
    have hmap_val : ((G.cohomologyPresheaf q).map (Opposite.op e)).hom
        (weilPolyP1CohomologyTermToPresheaf Z T₂ hT₂ G q β) =
        (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map e)).comp
          ((CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1CohomologyRepToConst Z T₂ hT₂)).comp β
            (Nat.zero_add q)) (Nat.zero_add q) := by
      have hmap : (G.cohomologyPresheaf q).map (Opposite.op e) =
          ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map (Opposite.op e))).app G := rfl
      exact congrArg (fun f => f.hom (weilPolyP1CohomologyTermToPresheaf Z T₂ hT₂ G q β))
        (hmap.trans (CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map (Opposite.op e)) G))
    exact hmap_val.trans
      (((CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map e))
          (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1CohomologyRepToConst Z T₂ hT₂))
          β (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q)).symm).trans
        (congrArg (fun m => m.comp β (Nat.zero_add q))
          ((CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (Z_fun.map e)
              (weilPolyP1CohomologyRepToConst Z T₂ hT₂)).trans
            (congrArg CategoryTheory.Abelian.Ext.mk₀ hmor))))

  
  have H_vanish : ∀ (Y_ov V_ov F_ov : CategoryTheory.Over S_k)
      [AlgebraicGeometry.LocallyOfFiniteType V_ov.hom]
      (f₁ : Y_ov ⟶ V_ov) [AlgebraicGeometry.IsProper f₁.left]
      (s₁ : S_k ⟶ V_ov.left)
      (_hs₁ : s₁ ≫ V_ov.hom = 𝟙 S_k)
      (ι₁ : F_ov.left ⟶ Y_ov.left)
      (hPb₁ : CategoryTheory.IsPullback ι₁ F_ov.hom f₁.left s₁)
      (β : weilEtaleTorsionH Y_ov.left n_mod q_deg)
      (p_ι₁ : weilEtaleTorsionH Y_ov.left n_mod q_deg →+
        weilEtaleTorsionH F_ov.left n_mod q_deg),
      WeilIsTorsionEtalePullback ι₁ n_mod q_deg p_ι₁ →
      p_ι₁ β = 0 →
      ∃ (U_et : V_ov.left.Etale)
        (s_et : S_k ⟶ ((AlgebraicGeometry.Scheme.Etale.forget V_ov.left).obj U_et).left),
        s_et ≫ ((AlgebraicGeometry.Scheme.Etale.forget V_ov.left).obj U_et).hom = s₁ ∧
        ∀ (p_U : weilEtaleTorsionH Y_ov.left n_mod q_deg →+
            weilEtaleTorsionH
              ((AlgebraicGeometry.Scheme.Etale.forget Y_ov.left).obj
                ((weilEtaleSitePullback f₁.left).obj U_et)).left n_mod q_deg),
          WeilIsTorsionEtalePullback
            ((AlgebraicGeometry.Scheme.Etale.forget Y_ov.left).obj
              ((weilEtaleSitePullback f₁.left).obj U_et)).hom n_mod q_deg p_U →
          p_U β = 0 := by
    intro Y_ov V_ov F_ov _ f₁ _ s₁ _hs₁ ι₁ hPb₁ β p_ι₁ hp_ι₁ hp_zero
    have hPBC₁ : WeilCanonicalModPrimePBC ℓ f₁.left :=
      weil_odp_pbc_eval_proper_canonical_mod_prime_pbc k ℓ hℓ_k Y_ov V_ov f₁
    have := (sys s₁).hCont
    have := (sys s₁).hAdj
    have := (sys ι₁).hCont
    have := (sys ι₁).hAdj
    have := (sys ι₁).hAdd_pb
    have := (sys ι₁).hLim_pb
    have := (sys ι₁).hColim_pb
    obtain ⟨bc₁, conn_top₁, conn_bot₁, hNat₁, hLES₁, hModIso₁, hEdge₁⟩ :=
      weil_odp_pbc_eval_mod_prime_beck_chevalley_and_long_exact
        sys ℓ f₁.left s₁ F_ov.hom ι₁ hPb₁ hPBC₁
    have hModPrime₁ : ∀ q : ℕ,
