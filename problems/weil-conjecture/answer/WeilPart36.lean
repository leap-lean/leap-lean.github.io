    rw [hMemEtale Y W₀ R₀]
    intro x
    have hx_univ : x ∈ (⋃ a : I, Set.range (u a).base) := by
      rw [hcov]
      trivial
    obtain ⟨a, y, hy⟩ := Set.mem_iUnion.mp hx_univ
    have hv₀_et : AlgebraicGeometry.Etale (u a ≫ w) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (u a) w (hu_et a) W₀.prop
    let V₀ : Y.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (u a ≫ w) hv₀_et
    let g_a : V₀ ⟶ W₀ :=
      CategoryTheory.MorphismProperty.Over.homMk (u a) rfl
    refine ⟨V₀, g_a, y, ?_, hu_et a, hy⟩
    let m_ga : (Fgt_U.obj (B_j.obj V₀)).left ⟶ (Fgt_U.obj (B_j.obj W₀)).left :=
      (Fgt_U.map (B_j.map g_a)).left
    obtain ⟨-, ⟨β_a₀, hTriBwd₀⟩⟩ := hTri w V₀.hom (u a)
      (CategoryTheory.MorphismProperty.Over.w g_a)
      (B_j.map g_a).left
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.MorphismProperty.Over.w (B_j.map g_a))
