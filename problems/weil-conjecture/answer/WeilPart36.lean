  let Γ_X := (CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj (Opposite.op T_X)
  let e_sec : Γ_U ≅ pf_j.comp Γ_X :=
    CategoryTheory.NatIso.ofComponents
