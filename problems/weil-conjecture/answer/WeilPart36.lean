        _ = Ξ_const.inv.app Aℤ ≫ (pb_u.map (C_W.map (e_vec a)) ≫ pb_u.map Φ) ≫ β_star := by
              rw [hnat_Ξ]; simp only [Category.assoc]
        _ = CategoryTheory.inv cℤ_u ≫ pb_u.map (φ_W_vec a) ≫ β_star := by
