            change (1 : A_X) ⊗ₜ[R_U] (c_U (ε₀ a) • r) = φ_f (c_U (ε₀ a)) ⊗ₜ[R_U] r
            rw [← TensorProduct.smul_tmul]
            change (φ_f (c_U (ε₀ a)) * 1) ⊗ₜ[R_U] r = φ_f (c_U (ε₀ a)) ⊗ₜ[R_U] r
            rw [mul_one]
          change a ⊗ₜ[R_U] r - (1 : A_X) ⊗ₜ[R_U] (p_A (c_U (ε₀ a)) * r) =
