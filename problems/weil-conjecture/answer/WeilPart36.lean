        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    have hBij_inv : Function.Bijective inv_α_ext :=
      ⟨hLeft_inv.injective, hRight_inv.surjective⟩
    have hEq_comp : leray_j i = (Λ_j i) ∘ inv_α_ext := by
      funext z
      exact (congrArg (leray_j i) (hLeft_inv z).symm).trans (hFactor i (inv_α_ext z))
    rw [hEq_comp]
    exact hBij_Λ.comp hBij_inv
  exact ⟨ιℤ, hιπ, hπι, hConj3, hConj4⟩

theorem weil_punctual_roof_trunc_leray_hdi_h0_subsingleton {X_U X : AlgebraicGeometry.Scheme.{u}} (j : X_U ⟶ X)
