                let x' : ↥E_xy.1 := IntermediateField.inclusion (le_sup_left : (E_of x).1 ≤ E_xy.1) (x_of x)
                let y' : ↥E_xy.1 := IntermediateField.inclusion (le_sup_right : (E_of y).1 ≤ E_xy.1) (x_of y)
                change fn ((x' * y' : ↥E_xy.1) : k) = fn (x' : k) * fn (y' : k)
                rw [hfn E_xy (x' * y'), hfn E_xy x', hfn E_xy y', map_mul]
              map_zero' := by
                rw [show (0 : k) = ((0 : ↥bot₀.1) : k) from rfl, hfn bot₀ 0, map_zero]
              map_add' := fun x y => by
                let E_xy := sup₀ (E_of x) (E_of y)
                let x' : ↥E_xy.1 := IntermediateField.inclusion (le_sup_left : (E_of x).1 ≤ E_xy.1) (x_of x)
                let y' : ↥E_xy.1 := IntermediateField.inclusion (le_sup_right : (E_of y).1 ≤ E_xy.1) (x_of y)
                change fn ((x' + y' : ↥E_xy.1) : k) = fn (x' : k) + fn (y' : k)
                rw [hfn E_xy (x' + y'), hfn E_xy x', hfn E_xy y', map_add] }
        fac := fun s E => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro y
          let E_top : ℐ₀ := sup₀ (E_of (y : k)) E
          have hle₁ : (E_of (y : k)).1 ≤ E_top.1 := le_sup_left
          have hle₂ : E.1 ≤ E_top.1 := le_sup_right
          have h1 := congrArg (fun f => f.hom (x_of (y : k))) (s.w (CategoryTheory.homOfLE hle₁))
          have h2 := congrArg (fun f => f.hom y) (s.w (CategoryTheory.homOfLE hle₂))
          have heq_top : IntermediateField.inclusion hle₁ (x_of (y : k)) =
              IntermediateField.inclusion hle₂ y := Subtype.ext rfl
          exact h1.symm.trans ((congrArg (s.ι.app E_top).hom heq_top).trans h2)
        uniq := fun s m_hom hm => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro x
          exact congrArg (fun f => f.hom (x_of x)) (hm (E_of x)) }
    letI : Algebra F ↑A₀ := σ_A.hom.toAlgebra
    have hTpLift : ∀ {R : Type u} [CommRing R] [Algebra F R] {S : CommRingCat.{u}}
        (u_A : A₀ ⟶ S) (u_R : CommRingCat.of R ⟶ S),
        σ_A ≫ u_A = CommRingCat.ofHom (algebraMap F R) ≫ u_R →
        ∃! (φ : CommRingCat.of (TensorProduct F ↑A₀ R) ⟶ S),
          CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := F) (A := ↑A₀) (B := R)) ≫ φ = u_A ∧
          CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := ↑A₀) (B := R)).toRingHom ≫ φ = u_R := by
      intro R _ _ S u_A u_R hcomm
      letI : Algebra F ↑S := (σ_A ≫ u_A).hom.toAlgebra
      let uA_alg : ↑A₀ →ₐ[F] ↑S := { u_A.hom with commutes' := fun _ => rfl }
      let uR_alg : R →ₐ[F] ↑S :=
        { u_R.hom with commutes' := fun c => (congrArg (fun f => f.hom c) hcomm).symm }
      let φ₀ : CommRingCat.of (TensorProduct F ↑A₀ R) ⟶ S :=
        CommRingCat.ofHom (Algebra.TensorProduct.lift uA_alg uR_alg (fun _ _ => Commute.all _ _)).toRingHom
      have hφA : CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := F) (A := ↑A₀) (B := R)) ≫ φ₀ = u_A :=
        CommRingCat.hom_ext (RingHom.ext fun a => by
          change φ₀.hom (a ⊗ₜ[F] (1 : R)) = u_A.hom a
          change uA_alg a * uR_alg 1 = u_A.hom a
          rw [map_one, mul_one]; rfl)
      have hφR : CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := ↑A₀) (B := R)).toRingHom ≫ φ₀ = u_R :=
        CommRingCat.hom_ext (RingHom.ext fun r => by
          change φ₀.hom ((1 : ↑A₀) ⊗ₜ[F] r) = u_R.hom r
          change uA_alg 1 * uR_alg r = u_R.hom r
          rw [map_one, one_mul]; rfl)
      refine ⟨φ₀, ⟨hφA, hφR⟩, ?_⟩
      rintro ψ ⟨hψA, hψR⟩
      apply CommRingCat.hom_ext; apply RingHom.ext; intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul a r =>
        have ha : ψ.hom (a ⊗ₜ[F] (1 : R)) = u_A.hom a := congrArg (fun f => f.hom a) hψA
        have hr : ψ.hom ((1 : ↑A₀) ⊗ₜ[F] r) = u_R.hom r := congrArg (fun f => f.hom r) hψR
        have hφa : φ₀.hom (a ⊗ₜ[F] (1 : R)) = u_A.hom a := congrArg (fun f => f.hom a) hφA
        have hφr : φ₀.hom ((1 : ↑A₀) ⊗ₜ[F] r) = u_R.hom r := congrArg (fun f => f.hom r) hφR
        have hmul : (a ⊗ₜ[F] r : TensorProduct F ↑A₀ R) = (a ⊗ₜ[F] 1) * (1 ⊗ₜ[F] r) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hmul, map_mul, map_mul, ha, hr, hφa, hφr]
      | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
    have hPushEtale : ∀ {R S R' S' : CommRingCat.{u}}
        (f : R ⟶ S) (g : R ⟶ R') (g' : S ⟶ S') (f' : R' ⟶ S'),
        g ≫ f' = f ≫ g' →
        f.hom.Etale →
        (∀ {T : CommRingCat.{u}} (u₁ : R' ⟶ T) (u₂ : S ⟶ T),
          g ≫ u₁ = f ≫ u₂ → ∃! φ : S' ⟶ T, f' ≫ φ = u₁ ∧ g' ≫ φ = u₂) →
        f'.hom.Etale := by
      intro R S R' S' f g g' f' hcomm hf hUniv
      letI : Algebra ↑R ↑S := f.hom.toAlgebra
      letI : Algebra ↑R ↑R' := g.hom.toAlgebra
      letI : Algebra ↑R' ↑S' := f'.hom.toAlgebra
      letI : Algebra ↑R ↑S' := (g ≫ f').hom.toAlgebra
      haveI : Algebra.Etale ↑R ↑S := RingHom.Etale.toAlgebra hf
      haveI : Algebra.Etale ↑R' (TensorProduct ↑R ↑R' ↑S) :=
        Algebra.Etale.baseChange ↑R ↑S ↑R'
      let T_tp : CommRingCat.{u} := CommRingCat.of (TensorProduct ↑R ↑R' ↑S)
      let i₁ : R' ⟶ T_tp :=
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := ↑R) (A := ↑R') (B := ↑S))
      let i₂ : S ⟶ T_tp :=
        CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := ↑R) (A := ↑R') (B := ↑S)).toRingHom
      have hi_comm : g ≫ i₁ = f ≫ i₂ :=
        CommRingCat.hom_ext (RingHom.ext fun r => by
          change g.hom r ⊗ₜ[↑R] (1 : ↑S) = (1 : ↑R') ⊗ₜ[↑R] f.hom r
          have h1 : g.hom r = r • (1 : ↑R') := Algebra.algebraMap_eq_smul_one r
          have h2 : f.hom r = r • (1 : ↑S) := Algebra.algebraMap_eq_smul_one r
          rw [h1, h2, TensorProduct.smul_tmul])
      let bwd : S' ⟶ T_tp := (hUniv i₁ i₂ hi_comm).choose
      have hbwd₁ : f' ≫ bwd = i₁ := (hUniv i₁ i₂ hi_comm).choose_spec.1.1
      have hbwd₂ : g' ≫ bwd = i₂ := (hUniv i₁ i₂ hi_comm).choose_spec.1.2
      let u₁_alg : ↑R' →ₐ[↑R] ↑S' := { f'.hom with commutes' := fun _ => rfl }
      let u₂_alg : ↑S →ₐ[↑R] ↑S' :=
        { g'.hom with commutes' := fun r => congrArg (fun k => k.hom r) hcomm.symm }
      let fwd : T_tp ⟶ S' :=
        CommRingCat.ofHom (Algebra.TensorProduct.lift u₁_alg u₂_alg (fun _ _ => Commute.all _ _)).toRingHom
      have hfwd₁ : i₁ ≫ fwd = f' :=
        CommRingCat.hom_ext (RingHom.ext fun r' => by
          change u₁_alg r' * u₂_alg 1 = f'.hom r'
          rw [map_one, mul_one]; rfl)
      have hfwd₂ : i₂ ≫ fwd = g' :=
        CommRingCat.hom_ext (RingHom.ext fun s => by
          change u₁_alg 1 * u₂_alg s = g'.hom s
          rw [map_one, one_mul]; rfl)
      have hbwd_fwd : bwd ≫ fwd = 𝟙 S' := by
        apply (hUniv f' g' hcomm).unique
        · exact ⟨by rw [← CategoryTheory.Category.assoc, hbwd₁, hfwd₁],
                 by rw [← CategoryTheory.Category.assoc, hbwd₂, hfwd₂]⟩
        · exact ⟨CategoryTheory.Category.comp_id _, CategoryTheory.Category.comp_id _⟩
      have hfwd_bwd : fwd ≫ bwd = 𝟙 T_tp := by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro z
        induction z using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | tmul r' s =>
          have h1 : (fwd ≫ bwd).hom (r' ⊗ₜ[↑R] (1 : ↑S)) = r' ⊗ₜ[↑R] (1 : ↑S) :=
            congrArg (fun k => k.hom r')
              (by rw [← CategoryTheory.Category.assoc, hfwd₁, hbwd₁] : i₁ ≫ (fwd ≫ bwd) = i₁)
          have h2 : (fwd ≫ bwd).hom ((1 : ↑R') ⊗ₜ[↑R] s) = (1 : ↑R') ⊗ₜ[↑R] s :=
            congrArg (fun k => k.hom s)
              (by rw [← CategoryTheory.Category.assoc, hfwd₂, hbwd₂] : i₂ ≫ (fwd ≫ bwd) = i₂)
          have hmul : (r' ⊗ₜ[↑R] s : TensorProduct ↑R ↑R' ↑S) = (r' ⊗ₜ[↑R] 1) * (1 ⊗ₜ[↑R] s) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hmul, map_mul, h1, h2]
          rfl
        | add x y hx hy => rw [map_add, hx, hy]; rfl
      have hi₁_et : i₁.hom.Etale := by
        change (algebraMap ↑R' (TensorProduct ↑R ↑R' ↑S)).Etale
        exact RingHom.etale_algebraMap.mpr inferInstance
      have hfwd_et : fwd.hom.Etale :=
        RingHom.Etale.of_bijective
          ⟨fun x y hxy => by
            have h := congrArg bwd.hom hxy
            exact (congrArg (fun k => k.hom x) hfwd_bwd).symm.trans
              (h.trans (congrArg (fun k => k.hom y) hfwd_bwd)),
           fun y => ⟨bwd.hom y, congrArg (fun k => k.hom y) hbwd_fwd⟩⟩
      have hcomp_et : (i₁ ≫ fwd).hom.Etale :=
        RingHom.Etale.stableUnderComposition i₁.hom fwd.hom hi₁_et hfwd_et
      exact hfwd₁ ▸ hcomp_et
    have hStep3 : ∃ (D_A : CategoryTheory.Functor ℐ₀ CommRingCat.{u})
        (inl_E : ∀ E : ℐ₀, A₀ ⟶ D_A.obj E)
        (u_E : ∀ E : ℐ₀, D_A.obj E ⟶ A_bar)
        (hu_nat : ∀ {E₁ E₂ : ℐ₀} (θ : E₁ ⟶ E₂),
          D_A.map θ ≫ u_E E₂ = u_E E₁ ≫ ((CategoryTheory.Functor.const ℐ₀).obj A_bar).map θ),
        Nonempty (CategoryTheory.Limits.IsColimit
          ({ pt := A_bar, ι := { app := u_E, naturality := @hu_nat } } : CategoryTheory.Limits.Cocone D_A)) ∧
        (∀ E : ℐ₀, (inl_E E).hom.Etale) ∧
        (∀ E : ℐ₀, inl_E E ≫ u_E E = inl_A) ∧
        (∀ (E₁ E₂ : ℐ₀) (hle : E₁.1 ≤ E₂.1),
          (D_A.map (CategoryTheory.homOfLE hle)).hom.Etale) := by
      let D_A : CategoryTheory.Functor ℐ₀ CommRingCat.{u} :=
        { obj := fun E => CommRingCat.of (TensorProduct F ↑A₀ ↥E.1)
          map := fun {E₁ E₂} θ =>
            CommRingCat.ofHom
              (Algebra.TensorProduct.map (AlgHom.id F ↑A₀)
                (IntermediateField.inclusion (CategoryTheory.leOfHom θ))).toRingHom
          map_id := fun E => by
            apply CommRingCat.hom_ext; apply RingHom.ext; intro z
            induction z using TensorProduct.induction_on with
            | zero => exact (map_zero _).trans (map_zero _).symm
            | tmul a e => rfl
            | add x y hx hy => exact (map_add _ x y).trans ((congrArg₂ (· + ·) hx hy).trans (map_add _ x y).symm)
          map_comp := fun f g => by
            apply CommRingCat.hom_ext; apply RingHom.ext; intro z
            induction z using TensorProduct.induction_on with
            | zero => exact (map_zero _).trans (map_zero _).symm
            | tmul a e => rfl
            | add x y hx hy => exact (map_add _ x y).trans ((congrArg₂ (· + ·) hx hy).trans (map_add _ x y).symm) }
      let inl_E : ∀ E : ℐ₀, A₀ ⟶ D_A.obj E := fun E =>
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := F) (A := ↑A₀) (B := ↥E.1))
      let inr_E : ∀ E : ℐ₀, D_k.obj E ⟶ D_A.obj E := fun E =>
        CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := ↑A₀) (B := ↥E.1)).toRingHom
      have hinl_et : ∀ E : ℐ₀, (inl_E E).hom.Etale := by
        intro E
        letI := E.2
        haveI : Algebra.Etale F ↥E.1 := hFinFieldEtale F ↥E.1
        haveI : Algebra.Etale ↑A₀ (TensorProduct F ↑A₀ ↥E.1) :=
          Algebra.Etale.baseChange F ↥E.1 ↑A₀
        change (algebraMap ↑A₀ (TensorProduct F ↑A₀ ↥E.1)).Etale
        exact RingHom.etale_algebraMap.mpr inferInstance
      have hcA_comm : ∀ E : ℐ₀,
          σ_A ≫ inl_A = CommRingCat.ofHom (algebraMap F ↥E.1) ≫ (c_k.ι.app E ≫ inr_A) := by
        intro E
        have h1 : CommRingCat.ofHom (algebraMap F ↥E.1) ≫ c_k.ι.app E =
            CommRingCat.ofHom (algebraMap F k) :=
          CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
        rw [← CategoryTheory.Category.assoc, h1]
        exact hPush_A.w
      let u_E : ∀ E : ℐ₀, D_A.obj E ⟶ A_bar := fun E =>
        (hTpLift inl_A (c_k.ι.app E ≫ inr_A) (hcA_comm E)).choose
      have hu_E_inl : ∀ E : ℐ₀, inl_E E ≫ u_E E = inl_A := fun E =>
        (hTpLift inl_A (c_k.ι.app E ≫ inr_A) (hcA_comm E)).choose_spec.1.1
      have hu_E_inr : ∀ E : ℐ₀, inr_E E ≫ u_E E = c_k.ι.app E ≫ inr_A := fun E =>
        (hTpLift inl_A (c_k.ι.app E ≫ inr_A) (hcA_comm E)).choose_spec.1.2
      have hu_nat : ∀ {E₁ E₂ : ℐ₀} (θ : E₁ ⟶ E₂),
          D_A.map θ ≫ u_E E₂ = u_E E₁ ≫ ((CategoryTheory.Functor.const ℐ₀).obj A_bar).map θ := by
        intro E₁ E₂ θ
        refine Eq.trans ?_ (CategoryTheory.Category.comp_id _).symm
        apply (hTpLift inl_A (c_k.ι.app E₁ ≫ inr_A) (hcA_comm E₁)).unique
        · refine ⟨?_, ?_⟩
          · rw [← CategoryTheory.Category.assoc]
            have hmap_inl : inl_E E₁ ≫ D_A.map θ = inl_E E₂ :=
              CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
            rw [hmap_inl, hu_E_inl E₂]
          · rw [← CategoryTheory.Category.assoc]
            have hmap_inr : inr_E E₁ ≫ D_A.map θ = D_k.map θ ≫ inr_E E₂ :=
              CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
            rw [hmap_inr, CategoryTheory.Category.assoc, hu_E_inr E₂,
              ← CategoryTheory.Category.assoc, c_k.w θ]
        · exact ⟨hu_E_inl E₁, hu_E_inr E₁⟩
      let c_A : CategoryTheory.Limits.Cocone D_A :=
        { pt := A_bar
          ι := { app := u_E, naturality := @hu_nat } }
      have hc_A : CategoryTheory.Limits.IsColimit c_A :=
        { desc := fun s =>
            let g_A : A₀ ⟶ s.pt := inl_E bot₀ ≫ s.ι.app bot₀
            let s_k : CategoryTheory.Limits.Cocone D_k :=
              { pt := s.pt
                ι :=
                  { app := fun E => inr_E E ≫ s.ι.app E
                    naturality := fun {E₁ E₂} θ => by
                      refine Eq.trans ?_ (CategoryTheory.Category.comp_id _).symm
                      have hmap_inr : inr_E E₁ ≫ D_A.map θ = D_k.map θ ≫ inr_E E₂ :=
                        CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
                      rw [← CategoryTheory.Category.assoc, ← hmap_inr,
                        CategoryTheory.Category.assoc, s.w θ] } }
            let g_k_hom : CommRingCat.of k ⟶ s.pt := hc_k.desc s_k
            have hg_comm : σ_A ≫ g_A = CommRingCat.ofHom (algebraMap F k) ≫ g_k_hom := by
              have hbot_eq : σ_A ≫ inl_E bot₀ = CommRingCat.ofHom (algebraMap F ↥bot₀.1) ≫ inr_E bot₀ :=
                CommRingCat.hom_ext (RingHom.ext fun c => by
                  change σ_A.hom c ⊗ₜ[F] (1 : ↥bot₀.1) = (1 : ↑A₀) ⊗ₜ[F] algebraMap F ↥bot₀.1 c
                  have h1 : σ_A.hom c = c • (1 : ↑A₀) := Algebra.algebraMap_eq_smul_one c
                  rw [h1, TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one])
              have hck_bot : CommRingCat.ofHom (algebraMap F k) =
                  CommRingCat.ofHom (algebraMap F ↥bot₀.1) ≫ c_k.ι.app bot₀ :=
                CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
              dsimp [g_A, g_k_hom]
              rw [← CategoryTheory.Category.assoc, hbot_eq, CategoryTheory.Category.assoc,
                hck_bot, CategoryTheory.Category.assoc, hc_k.fac s_k bot₀]
            hPush_A.desc g_A g_k_hom hg_comm
          fac := fun s E => by
            let g_A : A₀ ⟶ s.pt := inl_E bot₀ ≫ s.ι.app bot₀
            have hg_A_all : ∀ E' : ℐ₀, inl_E E' ≫ s.ι.app E' = g_A := by
              intro E'
              have hle : bot₀.1 ≤ E'.1 := bot_le
              have hmap_inl : inl_E bot₀ ≫ D_A.map (CategoryTheory.homOfLE hle) = inl_E E' :=
                CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
              dsimp [g_A]
              rw [← s.w (CategoryTheory.homOfLE hle), ← CategoryTheory.Category.assoc, hmap_inl]
            let s_k : CategoryTheory.Limits.Cocone D_k :=
              { pt := s.pt
                ι :=
                  { app := fun E' => inr_E E' ≫ s.ι.app E'
                    naturality := fun {E₁ E₂} θ => by
                      refine Eq.trans ?_ (CategoryTheory.Category.comp_id _).symm
                      have hmap_inr : inr_E E₁ ≫ D_A.map θ = D_k.map θ ≫ inr_E E₂ :=
                        CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
                      rw [← CategoryTheory.Category.assoc, ← hmap_inr,
                        CategoryTheory.Category.assoc, s.w θ] } }
            apply (hTpLift g_A (inr_E E ≫ s.ι.app E) (by
              rw [← hg_A_all E, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
              congr 1
              exact CommRingCat.hom_ext (RingHom.ext fun c => by
                change σ_A.hom c ⊗ₜ[F] (1 : ↥E.1) = (1 : ↑A₀) ⊗ₜ[F] algebraMap F ↥E.1 c
                have h1 : σ_A.hom c = c • (1 : ↑A₀) := Algebra.algebraMap_eq_smul_one c
                rw [h1, TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one]))).unique
            · refine ⟨?_, ?_⟩
              · change inl_E E ≫ (u_E E ≫ _) = g_A
                rw [← CategoryTheory.Category.assoc, hu_E_inl E, hPush_A.inl_desc]
              · change inr_E E ≫ (u_E E ≫ _) = inr_E E ≫ s.ι.app E
                rw [← CategoryTheory.Category.assoc, hu_E_inr E, CategoryTheory.Category.assoc,
                  hPush_A.inr_desc, hc_k.fac s_k E]
            · exact ⟨hg_A_all E, rfl⟩
          uniq := fun s m_hom hm => by
            apply hPush_A.hom_ext
            · rw [hPush_A.inl_desc, ← hu_E_inl bot₀, CategoryTheory.Category.assoc]
              exact congrArg (inl_E bot₀ ≫ ·) (hm bot₀)
            · rw [hPush_A.inr_desc]
              apply hc_k.hom_ext
              intro E
              rw [hc_k.fac, ← CategoryTheory.Category.assoc, ← hu_E_inr E, CategoryTheory.Category.assoc]
              exact congrArg (inr_E E ≫ ·) (hm E) }
      have hd_et : ∀ (E₁ E₂ : ℐ₀) (hle : E₁.1 ≤ E₂.1),
          (D_A.map (CategoryTheory.homOfLE hle)).hom.Etale := by
        intro E₁ E₂ hle
        let θ : E₁ ⟶ E₂ := CategoryTheory.homOfLE hle
        have hinc_et : (D_k.map θ).hom.Etale := by
          let inc := IntermediateField.inclusion hle
          letI : Algebra ↥E₁.1 ↥E₂.1 := inc.toRingHom.toAlgebra
          haveI : IsScalarTower F ↥E₁.1 ↥E₂.1 :=
            IsScalarTower.of_algebraMap_eq fun c => (inc.commutes c).symm
          haveI : FiniteDimensional F ↥E₁.1 := E₁.2
          haveI : FiniteDimensional F ↥E₂.1 := E₂.2
          haveI : Finite ↥E₁.1 := Module.finite_of_finite F
          haveI : FiniteDimensional ↥E₁.1 ↥E₂.1 :=
            Module.Finite.of_restrictScalars_finite F ↥E₁.1 ↥E₂.1
          haveI : Algebra.Etale ↥E₁.1 ↥E₂.1 := hFinFieldEtale ↥E₁.1 ↥E₂.1
