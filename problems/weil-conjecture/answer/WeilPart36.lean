    have hInj_Λ1 : Function.Injective (Λ_j 1) := hInj₁ (Λ_j 1) (hΛ_j 1)
    have hSurj_α0 : ∀ y : (pf_j.obj F_U).H 0,
        ∃ x : F_X.H 0, x.comp (CategoryTheory.Abelian.Ext.mk₀ α_j) (Nat.add_zero 0) = y := by
