  let G_r_R := weilEtaleHigherDirectImage f_R r_deg (weilEtaleTorsionSheaf X_R ℓ)
  have hPB_GR : WeilIsEtaleSheafPullback g_R G_r G_r_R := by
    let S_R_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (g_R ≫ U_line_ov.hom)
    let X_R_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (f_R ≫ (g_R ≫ U_line_ov.hom))
    let g_ov : S_R_ov ⟶ U_line_ov := CategoryTheory.Over.homMk g_R rfl
    let f'_ov : X_R_ov ⟶ S_R_ov := CategoryTheory.Over.homMk f_R rfl
    let g'_ov : X_R_ov ⟶ X₀ :=
      CategoryTheory.Over.homMk fst_R (by
