theorem weil_sing_dev_algBC_adj_mate_isIso_of_two_sided_paste {𝒞₁ 𝒞₂ : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞₁]
    [CategoryTheory.Category.{u + 1} 𝒞₂]
    {L₁ : CategoryTheory.Functor 𝒞₁ 𝒞₂} {R₁ : CategoryTheory.Functor 𝒞₂ 𝒞₁}
    {L₂ : CategoryTheory.Functor 𝒞₂ 𝒞₁} {R₂ : CategoryTheory.Functor 𝒞₁ 𝒞₂}
    (adj₁ : L₁ ⊣ R₁) (adj₂ : L₂ ⊣ R₂)
    (u₁ : ∀ H : 𝒞₁, CategoryTheory.Iso (R₁.obj (R₂.obj H)) H)
    (u₂ : ∀ H' : 𝒞₂, CategoryTheory.Iso (R₂.obj (R₁.obj H')) H')
    (hu₁_nat : ∀ {H₁ H₂ : 𝒞₁} (k : Quiver.Hom H₁ H₂),
      CategoryTheory.CategoryStruct.comp (R₁.map (R₂.map k)) (u₁ H₂).hom =
        CategoryTheory.CategoryStruct.comp (u₁ H₁).hom k)
    (hu₂_nat : ∀ {H'₁ H'₂ : 𝒞₂} (k : Quiver.Hom H'₁ H'₂),
      CategoryTheory.CategoryStruct.comp (R₂.map (R₁.map k)) (u₂ H'₂).hom =
        CategoryTheory.CategoryStruct.comp (u₂ H'₁).hom k)
    {M : 𝒞₁} {M' : 𝒞₂}
    (γ : Quiver.Hom M (R₁.obj M')) (γ_inv : Quiver.Hom M' (R₂.obj M))
    (h₁ : CategoryTheory.CategoryStruct.comp γ (R₁.map γ_inv) = (u₁ M).inv)
    (h₂ : CategoryTheory.CategoryStruct.comp γ_inv (R₂.map γ) = (u₂ M').inv) :
    CategoryTheory.IsIso γ ∧ CategoryTheory.IsIso ((adj₁.homEquiv M M').symm γ) :=
by
  let r : R₁.obj M' ⟶ R₁.obj (R₂.obj M) := R₁.map γ_inv
  let l : R₁.obj (R₂.obj M) ⟶ R₁.obj M' := (u₁ M).hom ≫ γ
  let r' : R₁.obj (R₂.obj M) ⟶ R₁.obj M' := R₁.map (R₂.map γ ≫ (u₂ M').hom)
  have h_lr : l ≫ r = 𝟙 (R₁.obj (R₂.obj M)) := by
    calc
      l ≫ r = ((u₁ M).hom ≫ γ) ≫ R₁.map γ_inv := rfl
      _ = (u₁ M).hom ≫ (γ ≫ R₁.map γ_inv) := Category.assoc _ _ _
      _ = (u₁ M).hom ≫ (u₁ M).inv := by rw [h₁]
      _ = 𝟙 (R₁.obj (R₂.obj M)) := (u₁ M).hom_inv_id
  have h_rr' : r ≫ r' = 𝟙 (R₁.obj M') := by
    calc
      r ≫ r' = R₁.map γ_inv ≫ R₁.map (R₂.map γ ≫ (u₂ M').hom) := rfl
      _ = R₁.map (γ_inv ≫ (R₂.map γ ≫ (u₂ M').hom)) := (R₁.map_comp _ _).symm
      _ = R₁.map ((γ_inv ≫ R₂.map γ) ≫ (u₂ M').hom) := by rw [← Category.assoc]
      _ = R₁.map ((u₂ M').inv ≫ (u₂ M').hom) := by rw [h₂]
      _ = R₁.map (𝟙 M') := by rw [(u₂ M').inv_hom_id]
      _ = 𝟙 (R₁.obj M') := R₁.map_id M'
  have h_l_eq_r' : l = r' := by
    calc
      l = l ≫ 𝟙 (R₁.obj M') := (Category.comp_id l).symm
      _ = l ≫ (r ≫ r') := by rw [← h_rr']
      _ = (l ≫ r) ≫ r' := (Category.assoc l r r').symm
      _ = 𝟙 (R₁.obj (R₂.obj M)) ≫ r' := by rw [h_lr]
      _ = r' := Category.id_comp r'
  let w : R₁.obj M' ⟶ M := r ≫ (u₁ M).hom
  have h_γw : γ ≫ w = 𝟙 M := by
    calc
      γ ≫ w = γ ≫ (R₁.map γ_inv ≫ (u₁ M).hom) := rfl
      _ = (γ ≫ R₁.map γ_inv) ≫ (u₁ M).hom := (Category.assoc _ _ _).symm
      _ = (u₁ M).inv ≫ (u₁ M).hom := by rw [h₁]
      _ = 𝟙 M := (u₁ M).inv_hom_id
  have h_wγ : w ≫ γ = 𝟙 (R₁.obj M') := by
    calc
      w ≫ γ = (r ≫ (u₁ M).hom) ≫ γ := rfl
      _ = r ≫ l := Category.assoc r (u₁ M).hom γ
