        ∃ M_R : Multiset R_bar,
          M_R.card = F.natDegree ∧
          F = (M_R.map (fun r => Polynomial.X - Polynomial.C r)).prod := by
      intro F hF
      let n := F.natDegree
      let pair : Fin n → ↥B_bar × ↥M_max.primeCompl :=
        fun i => Classical.choose (IsLocalization.surj M_max.primeCompl (F.coeff i.1))
      have hpair : ∀ i : Fin n,
          F.coeff i.1 * algebraMap ↥B_bar R_bar (pair i).2.1 =
            algebraMap ↥B_bar R_bar (pair i).1 :=
        fun i => Classical.choose_spec (IsLocalization.surj M_max.primeCompl (F.coeff i.1))
      let s : ↥M_max.primeCompl := ∏ i : Fin n, (pair i).2
      let t_rest : Fin n → ↥B_bar :=
        fun i => (∏ j ∈ Finset.univ.erase i, (pair j).2).1
      have hs_fac : ∀ i : Fin n, s.1 = (pair i).2.1 * t_rest i := by
        intro i
        have h1 : (pair i).2 * (∏ j ∈ Finset.univ.erase i, (pair j).2) = s :=
          Finset.mul_prod_erase Finset.univ (fun j => (pair j).2) (Finset.mem_univ i)
        exact congrArg Subtype.val h1.symm
      let c_coeff : Fin n → ↥B_bar :=
        fun i => (pair i).1 * t_rest i * s.1 ^ (n - 1 - i.1)
      have hc_eq : ∀ i : Fin n,
          F.coeff i.1 * (algebraMap ↥B_bar R_bar s.1) ^ (n - i.1) =
            algebraMap ↥B_bar R_bar (c_coeff i) := by
        intro i
        have hsub : n - i.1 = 1 + (n - 1 - i.1) := by omega
        rw [hsub, pow_add, pow_one, ← mul_assoc]
        conv_lhs => rw [hs_fac i]
        rw [map_mul, ← mul_assoc, hpair i]
        dsimp [c_coeff]
        rw [hs_fac i]
        simp only [map_mul, map_pow]
      let q_low : Polynomial ↥B_bar :=
        ∑ i : Fin n, Polynomial.C (c_coeff i) * Polynomial.X ^ i.1
      let G : Polynomial ↥B_bar := Polynomial.X ^ n + q_low
      have hG_monic : G.Monic := Polynomial.monic_X_pow_add (hSumDegLt n c_coeff)
      have hF_sum : F = Polynomial.X ^ n +
          ∑ i : Fin n, Polynomial.C (F.coeff i.1) * Polynomial.X ^ i.1 := by
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow F]
        rw [Finset.sum_range_succ, add_comm]
        have hlc : F.coeff n = 1 := hF.coeff_natDegree
        dsimp [n] at hlc ⊢
        rw [hlc, map_one, one_mul,
          ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (F.coeff j) * Polynomial.X ^ j) n]
      let F_Ω : Polynomial Ω := F.map φ_R_Ω
      have hFΩ_monic : F_Ω.Monic := hF.map φ_R_Ω
      obtain ⟨M_Ω, hM_Ω0⟩ := (Polynomial.splits_iff_exists_multiset).mp (IsAlgClosed.splits F_Ω)
      rw [hFΩ_monic.leadingCoeff, map_one, one_mul] at hM_Ω0
      have hMΩ_card : M_Ω.card = n := by
        have hd := congrArg Polynomial.natDegree hM_Ω0
        rw [Polynomial.natDegree_multiset_prod_X_sub_C_eq_card] at hd
        dsimp [F_Ω, n] at hd ⊢
        rw [hF.natDegree_map φ_R_Ω] at hd
        exact hd.symm
      have hRootInt : ∀ α ∈ M_Ω, s.1.1 * α ∈ B_bar := by
        intro α hα
        have hev0 : Polynomial.eval α F_Ω = 0 := by
          rw [hM_Ω0, Polynomial.eval_multiset_prod, Multiset.map_map]
          apply Multiset.prod_eq_zero
          rw [Multiset.mem_map]
          exact ⟨α, hα, by simp⟩
        have hevF : α ^ n + ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1 = 0 := by
          have hmapF : F_Ω = Polynomial.X ^ n +
              ∑ i : Fin n, Polynomial.C (φ_R_Ω (F.coeff i.1)) * Polynomial.X ^ i.1 := by
            dsimp [F_Ω]
            conv_lhs => rw [hF_sum]
            simp [Polynomial.map_sum]
          rw [hmapF] at hev0
          simpa [Polynomial.eval_finsetSum] using hev0
        have hG_eval : Polynomial.aeval (s.1.1 * α) G = 0 := by
          dsimp [G, q_low]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ i : Fin n,
              (Polynomial.aeval (s.1.1 * α)) (Polynomial.C (c_coeff i) * Polynomial.X ^ i.1) =
                (s.1.1) ^ n * (φ_R_Ω (F.coeff i.1) * α ^ i.1) := by
            intro i
            rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
            have hci : (algebraMap ↥B_bar Ω) (c_coeff i) =
                φ_R_Ω (F.coeff i.1) * (s.1.1) ^ (n - i.1) := by
              change (c_coeff i).1 = _
              rw [← hφ_B (c_coeff i), ← hc_eq i, map_mul, map_pow, hφ_B]
            rw [hci]
            have hpow : (s.1.1) ^ (n - i.1) * (s.1.1 * α) ^ i.1 =
                (s.1.1) ^ n * α ^ i.1 := by
              rw [mul_pow, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (le_of_lt i.2)]
            calc
              φ_R_Ω (F.coeff i.1) * (s.1.1) ^ (n - i.1) * (s.1.1 * α) ^ i.1 =
                  φ_R_Ω (F.coeff i.1) * ((s.1.1) ^ (n - i.1) * (s.1.1 * α) ^ i.1) := by ring
              _ = φ_R_Ω (F.coeff i.1) * ((s.1.1) ^ n * α ^ i.1) := by rw [hpow]
              _ = (s.1.1) ^ n * (φ_R_Ω (F.coeff i.1) * α ^ i.1) := by ring
          simp_rw [hterm, ← Finset.mul_sum, mul_pow]
          calc
            (s.1.1) ^ n * α ^ n + (s.1.1) ^ n * ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1 =
                (s.1.1) ^ n * (α ^ n + ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1) := by ring
            _ = 0 := by rw [hevF, mul_zero]
        have hIntB : IsIntegral ↥B_bar (s.1.1 * α) := ⟨G, hG_monic, hG_eval⟩
        exact isIntegral_trans (R := P) (A := ↥B_bar) (B := Ω) (s.1.1 * α) hIntB
      let liftRoot : Ω → R_bar := fun α =>
        if hα : α ∈ M_Ω then IsLocalization.mk' R_bar ⟨s.1.1 * α, hRootInt α hα⟩ s else 0
      have hlift_val : ∀ α ∈ M_Ω, φ_R_Ω (liftRoot α) = α := by
        intro α hα
        have hd : liftRoot α = IsLocalization.mk' R_bar ⟨s.1.1 * α, hRootInt α hα⟩ s := by
          simp [liftRoot, hα]
        have hs_ne : s.1.1 ≠ 0 := (hB_units s).ne_zero
        apply mul_left_cancel₀ hs_ne
        calc
          s.1.1 * φ_R_Ω (liftRoot α) =
              φ_R_Ω (algebraMap ↥B_bar R_bar s.1 * liftRoot α) := by
            rw [map_mul, hφ_B]
          _ = φ_R_Ω (algebraMap ↥B_bar R_bar ⟨s.1.1 * α, hRootInt α hα⟩) := by
            rw [hd, mul_comm, IsLocalization.mk'_spec]
          _ = s.1.1 * α := hφ_B _
      let M_R : Multiset R_bar := M_Ω.map liftRoot
      refine ⟨M_R, ?_, ?_⟩
      · dsimp [M_R]; rw [Multiset.card_map, hMΩ_card]
      · apply Polynomial.map_injective φ_R_Ω hφ_inj
        change F_Ω = ((M_R.map (fun r => Polynomial.X - Polynomial.C r)).prod).map φ_R_Ω
        rw [hM_Ω0, Polynomial.map_multiset_prod]
        dsimp [M_R]
        rw [Multiset.map_map, Multiset.map_map]
        congr 1
        refine Multiset.map_congr rfl ?_
        intro α hα
        simp [hlift_val α hα]

    have hAlgClosedRes : IsAlgClosed (IsLocalRing.ResidueField R_bar) := by
      apply IsAlgClosed.of_exists_root
      intro p hp_mon hp_irr
      let n := p.natDegree
      have hn_pos : 1 ≤ n := Irreducible.natDegree_pos hp_irr
      let lift_c : Fin n → R_bar :=
        fun i => Classical.choose (IsLocalRing.residue_surjective (p.coeff i.1))
      have hlift_c : ∀ i : Fin n, IsLocalRing.residue R_bar (lift_c i) = p.coeff i.1 :=
        fun i => Classical.choose_spec (IsLocalRing.residue_surjective (p.coeff i.1))
      let q_low : Polynomial R_bar :=
        ∑ i : Fin n, Polynomial.C (lift_c i) * Polynomial.X ^ i.1
      let F : Polynomial R_bar := Polynomial.X ^ n + q_low
      have hF_mon : F.Monic := Polynomial.monic_X_pow_add (hSumDegLt n lift_c)
      have hF_deg : F.natDegree = n := by
        dsimp [F]
        apply Polynomial.natDegree_eq_of_degree_eq_some
        rw [Polynomial.degree_add_eq_left_of_degree_lt]
        · exact Polynomial.degree_X_pow n
        · rw [Polynomial.degree_X_pow]
          exact hSumDegLt n lift_c
      have hF_map : F.map (IsLocalRing.residue R_bar) = p := by
        conv_rhs => rw [Polynomial.as_sum_range_C_mul_X_pow p]
        rw [Finset.sum_range_succ, add_comm]
        have hlc : p.coeff n = 1 := hp_mon.coeff_natDegree
        dsimp [n] at hlc ⊢
        rw [hlc, map_one, one_mul,
          ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (p.coeff j) * Polynomial.X ^ j) n]
        dsimp [F, q_low]
        simp [Polynomial.map_sum, hlift_c]
        rfl
      obtain ⟨M_R, hMR_card, hF_prod⟩ := hMonicSplits F hF_mon
      have hMR_ne : M_R ≠ 0 := by
        intro h0
        rw [h0, Multiset.card_zero, hF_deg] at hMR_card
        omega
      obtain ⟨r₀, hr₀⟩ := Multiset.exists_mem_of_ne_zero hMR_ne
      have hFr₀ : Polynomial.eval r₀ F = 0 := by
        rw [hF_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
        apply Multiset.prod_eq_zero
        rw [Multiset.mem_map]
        exact ⟨r₀, hr₀, by simp⟩
      refine ⟨IsLocalRing.residue R_bar r₀, ?_⟩
      rw [← hF_map, Polynomial.eval_map, Polynomial.eval₂_at_apply, hFr₀, map_zero]

    have hHensel : HenselianLocalRing R_bar := by
      apply HenselianLocalRing.mk
      intro f hf_mon a₀ ha₀ _
      obtain ⟨M_R, _, hf_prod⟩ := hMonicSplits f hf_mon
      have hprod_mem : (M_R.map (fun r => a₀ - r)).prod ∈ IsLocalRing.maximalIdeal R_bar := by
        have hev : Polynomial.eval a₀ f = (M_R.map (fun r => a₀ - r)).prod := by
          rw [hf_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
          congr 1
          ext r
          simp
        rwa [← hev]
      have hPrimeMax : (IsLocalRing.maximalIdeal R_bar).IsPrime := inferInstance
      obtain ⟨d, hd_mem, hd_max⟩ :=
        (hPrimeMax.multiset_prod_mem_iff_exists_mem _).mp hprod_mem
      obtain ⟨r, hr_mem, rfl⟩ := Multiset.mem_map.mp hd_mem
      refine ⟨r, ?_, ?_⟩
      · rw [Polynomial.IsRoot.def, hf_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
        apply Multiset.prod_eq_zero
        rw [Multiset.mem_map]
        exact ⟨r, hr_mem, by simp⟩
      · have hneg : r - a₀ = -(a₀ - r) := by ring
        rw [hneg]
        exact (IsLocalRing.maximalIdeal R_bar).neg_mem hd_max

    have hFactorX : ∀ (d : ℕ) (g : P), g.natDegree ≤ d → g ≠ 0 →
        ∃ (r : ℕ) (h : P), g = Polynomial.X ^ r * h ∧ Polynomial.eval 0 h ≠ 0 := by
      intro d
      induction d with
      | zero =>
        intro g hdeg hg_ne
        refine ⟨0, g, by simp, ?_⟩
        rw [Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero hdeg)] at hg_ne ⊢
        rw [Polynomial.eval_C]
        intro hc0
        exact hg_ne (by rw [hc0, map_zero])
      | succ d ih =>
        intro g hdeg hg_ne
        by_cases hg0 : Polynomial.eval 0 g = 0
        · have hdvd : Polynomial.X ∣ g := by
            have h1 : Polynomial.X - Polynomial.C 0 ∣ g :=
              Polynomial.dvd_iff_isRoot.mpr hg0
            simpa using h1
          rcases hdvd with ⟨g₁, rfl⟩
          have hg₁_ne : g₁ ≠ 0 := right_ne_zero_of_mul hg_ne
          have hdeg_mul : (Polynomial.X * g₁).natDegree = 1 + g₁.natDegree := by
            rw [Polynomial.natDegree_mul Polynomial.X_ne_zero hg₁_ne, Polynomial.natDegree_X]
          obtain ⟨r₁, h, rfl, hh0⟩ := ih g₁ (by omega) hg₁_ne
          exact ⟨r₁ + 1, h, by rw [pow_succ', mul_assoc], hh0⟩
        · exact ⟨0, g, by simp, hg0⟩

    have hLocAway : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra := by
      let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      refine {
        map_units := ?_
        surj := ?_
        exists_of_eq := ?_
      }
      · rintro ⟨_, n, rfl⟩
        apply Ne.isUnit
        change φ_R_Ω (t_bar ^ n) ≠ 0
        rw [map_pow]
        refine pow_ne_zero n ?_
        intro h0
        exact ht_ne (hφ_inj (h0.trans (map_zero _).symm))
      · intro z
        have hz_int : IsIntegral K₀ z := Algebra.IsIntegral.isIntegral z
        let Q : Polynomial K₀ := minpoly K₀ z
        have hQ_mon : Q.Monic := minpoly.monic hz_int
        let n_Q := Q.natDegree
        let pairK : Fin n_Q → P × ↥(nonZeroDivisors P) :=
          fun i => Classical.choose (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
        have hpairK : ∀ i : Fin n_Q,
            Q.coeff i.1 * algebraMap P K₀ (pairK i).2.1 = algebraMap P K₀ (pairK i).1 :=
          fun i => Classical.choose_spec (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
        let g_sub : ↥(nonZeroDivisors P) := ∏ i : Fin n_Q, (pairK i).2
        let g : P := g_sub.1
        have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp g_sub.2
        let restK : Fin n_Q → P := fun i => (∏ j ∈ Finset.univ.erase i, (pairK j).2).1
        have hg_fac : ∀ i : Fin n_Q, g = (pairK i).2.1 * restK i := by
          intro i
          have h1 : (pairK i).2 * (∏ j ∈ Finset.univ.erase i, (pairK j).2) = g_sub :=
            Finset.mul_prod_erase Finset.univ (fun j => (pairK j).2) (Finset.mem_univ i)
          exact congrArg Subtype.val h1.symm
        let a_P : Fin n_Q → P := fun i => (pairK i).1 * restK i * g ^ (n_Q - 1 - i.1)
        have ha_eq : ∀ i : Fin n_Q,
            Q.coeff i.1 * (algebraMap P K₀ g) ^ (n_Q - i.1) = algebraMap P K₀ (a_P i) := by
          intro i
          have hsub : n_Q - i.1 = 1 + (n_Q - 1 - i.1) := by omega
          rw [hsub, pow_add, pow_one, ← mul_assoc]
          conv_lhs => rw [hg_fac i]
          rw [map_mul, ← mul_assoc, hpairK i]
          dsimp [a_P]
          rw [hg_fac i]
          simp only [map_mul, map_pow]
        let G_P : Polynomial P :=
          Polynomial.X ^ n_Q + ∑ i : Fin n_Q, Polynomial.C (a_P i) * Polynomial.X ^ i.1
        have hGP_mon : G_P.Monic := Polynomial.monic_X_pow_add (hSumDegLt n_Q a_P)
        have hQ_sum : Q = Polynomial.X ^ n_Q +
            ∑ i : Fin n_Q, Polynomial.C (Q.coeff i.1) * Polynomial.X ^ i.1 := by
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow Q]
          rw [Finset.sum_range_succ, add_comm]
          have hlc : Q.coeff n_Q = 1 := hQ_mon.coeff_natDegree
          dsimp [n_Q] at hlc ⊢
          rw [hlc, map_one, one_mul,
            ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (Q.coeff j) * Polynomial.X ^ j) n_Q]
        have hQz : z ^ n_Q + ∑ i : Fin n_Q, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1 = 0 := by
          have h0 : Polynomial.aeval z Q = 0 := minpoly.aeval K₀ z
          conv_lhs at h0 => rw [hQ_sum]
          simpa [map_sum] using h0
        let w : Ω := algebraMap P Ω g * z
        have hw_mem : w ∈ B_bar := by
          refine ⟨G_P, hGP_mon, ?_⟩
          rw [← Polynomial.aeval_def]
          dsimp [G_P]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ i : Fin n_Q,
              (Polynomial.aeval w) (Polynomial.C (a_P i) * Polynomial.X ^ i.1) =
                (algebraMap P Ω g) ^ n_Q * (algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by
            intro i
            rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
            have hai : algebraMap P Ω (a_P i) =
                algebraMap K₀ Ω (Q.coeff i.1) * (algebraMap P Ω g) ^ (n_Q - i.1) := by
              rw [IsScalarTower.algebraMap_apply P K₀ Ω (a_P i), ← ha_eq i, map_mul, map_pow,
                ← IsScalarTower.algebraMap_apply P K₀ Ω g]
            rw [hai]
            dsimp [w]
            have hpow : (algebraMap P Ω g) ^ (n_Q - i.1) * (algebraMap P Ω g * z) ^ i.1 =
                (algebraMap P Ω g) ^ n_Q * z ^ i.1 := by
              rw [mul_pow, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (le_of_lt i.2)]
            calc
              algebraMap K₀ Ω (Q.coeff i.1) * (algebraMap P Ω g) ^ (n_Q - i.1) *
                  (algebraMap P Ω g * z) ^ i.1 =
                algebraMap K₀ Ω (Q.coeff i.1) *
                  ((algebraMap P Ω g) ^ (n_Q - i.1) * (algebraMap P Ω g * z) ^ i.1) := by ring
              _ = algebraMap K₀ Ω (Q.coeff i.1) * ((algebraMap P Ω g) ^ n_Q * z ^ i.1) := by rw [hpow]
              _ = (algebraMap P Ω g) ^ n_Q * (algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by ring
          simp_rw [hterm, ← Finset.mul_sum]
          dsimp [w]
          rw [mul_pow]
          calc
            (algebraMap P Ω g) ^ n_Q * z ^ n_Q +
                (algebraMap P Ω g) ^ n_Q * ∑ i : Fin n_Q, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1 =
              (algebraMap P Ω g) ^ n_Q *
                (z ^ n_Q + ∑ i : Fin n_Q, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by ring
            _ = 0 := by rw [hQz, mul_zero]
        obtain ⟨r, h, hg_eq, hh0⟩ := hFactorX g.natDegree g (le_refl _) hg_ne
        have hh_not_M : algebraMap P ↥B_bar h ∉ M_max := by
          intro hhM
          have hh_comap : h ∈ Ideal.comap (algebraMap P ↥B_bar) M_max := hhM
          rw [hM_comap, ← hm0_ker, RingHom.mem_ker] at hh_comap
          exact hh0 hh_comap
        let s_h : ↥M_max.primeCompl := ⟨algebraMap P ↥B_bar h, hh_not_M⟩
        let x_R : R_bar := IsLocalization.mk' R_bar ⟨w, hw_mem⟩ s_h
        refine ⟨(x_R, ⟨t_bar ^ r, r, rfl⟩), ?_⟩
        change z * φ_R_Ω (t_bar ^ r) = φ_R_Ω x_R
        have hh_Ω_ne : algebraMap P Ω h ≠ 0 := by
          intro h0
          have hh_zero : h = 0 := hinj_P_Ω (h0.trans (map_zero _).symm)
          rw [hh_zero, Polynomial.eval_zero] at hh0
          exact hh0 rfl
        apply mul_right_cancel₀ hh_Ω_ne
        have hxR_mul : φ_R_Ω x_R * algebraMap P Ω h = w := by
          have h1 : x_R * algebraMap ↥B_bar R_bar s_h.1 = algebraMap ↥B_bar R_bar ⟨w, hw_mem⟩ :=
            IsLocalization.mk'_spec R_bar ⟨w, hw_mem⟩ s_h
          have h2 := congrArg φ_R_Ω h1
          rw [map_mul, hφ_B, hφ_B] at h2
          exact h2
        have ht_Ω : φ_R_Ω (t_bar ^ r) = (algebraMap P Ω Polynomial.X) ^ r := by
          rw [map_pow]
          congr 1
          exact RingHom.congr_fun hφ_comp Polynomial.X
        rw [hxR_mul, ht_Ω]
        dsimp [w]
        rw [hg_eq, map_mul, map_pow]
        ring
      · intro x y hxy
        exact ⟨⟨1, 0, pow_zero t_bar⟩, by simp [hφ_inj hxy]⟩

    have hj_open : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)) := by
      let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      have _ : IsLocalization.Away t_bar Ω := hLocAway
      exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization t_bar

    exact ⟨hDom_R, hHensel, hAlgClosedRes, ht_max, ht_ne, hMax_R, hRes,
      φ_R_Ω, hφ_B, hφ_comp, hφ_inj, hLocAway, hj_open⟩

  
  
  have hAtlasGen : ∀ (d_rel : ℕ) (X₀_sch U₀_sch : AlgebraicGeometry.Scheme.{u})
      (p_base : U₀_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (f₀_hom : X₀_sch ⟶ U₀_sch)
      [AlgebraicGeometry.SmoothOfRelativeDimension d_rel f₀_hom]
      (R_bar Ω₀ : Type u) [CommRing R_bar] [CommRing Ω₀]
      (g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k))
      (g_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ U₀_sch)
      (_ : g_R ≫ p_base = g_k_R)
      (j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar)),
      let S_d := weilAffineSpaceOver k d_rel
      let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
      let A_Ω := CategoryTheory.Limits.pullback j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
      let j_A : A_Ω ⟶ A_R :=
        CategoryTheory.Limits.pullback.snd j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
      let X_R := CategoryTheory.Limits.pullback f₀_hom g_R
      let X_R_Ω := CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.snd f₀_hom g_R) j_R
      let j_X : X_R_Ω ⟶ X_R :=
        CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd f₀_hom g_R) j_R
      ∀ x : ↥X_R,
        ∃ (V : X_R.Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ X_R_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_X V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A φ := by
    clear * -
    intro d_rel X₀_sch U₀_sch p_base f₀_hom _ R_bar Ω₀ _ _ g_k_R g_R hg_R j_R
      S_d A_R A_Ω j_A X_R X_R_Ω j_X x
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_base
    let π_AY : A_R ⟶ Y_d :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst S_d.hom g_k_R)
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R ≫ g_R)
        (by
          rw [Category.assoc, hg_R]
          exact CategoryTheory.Limits.pullback.condition)
    have hpb_AY_outer : CategoryTheory.IsPullback
        (π_AY ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base)
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        S_d.hom (g_R ≫ p_base) := by
      have hfst : π_AY ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base =
          CategoryTheory.Limits.pullback.fst S_d.hom g_k_R :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst, hg_R]
      exact CategoryTheory.IsPullback.of_hasPullback S_d.hom g_k_R
    have hpb_AY : CategoryTheory.IsPullback π_AY
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        (CategoryTheory.Limits.pullback.snd S_d.hom p_base) g_R :=
      CategoryTheory.IsPullback.of_right hpb_AY_outer
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback S_d.hom p_base)

    let fst_XR := CategoryTheory.Limits.pullback.fst f₀_hom g_R
    let f_R := CategoryTheory.Limits.pullback.snd f₀_hom g_R
    let x₀_pt : ↥X₀_sch := fst_XR.base x
    obtain ⟨U, hAffU, V₀, hAffV₀, hx₀_V₀, e_VU, hStdSm⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d_rel f₀_hom).mp inferInstance x₀_pt
    obtain ⟨γ, hγ_C, hγ_et⟩ :=
      RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStdSm
    let R_U : CommRingCat.{u} := U₀_sch.presheaf.obj (Opposite.op U)
    let A_U : Type u := ↑R_U
    let ι_U : AlgebraicGeometry.Spec R_U ⟶ U₀_sch := hAffU.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion ι_U := hAffU.isOpenImmersion_fromSpec
    have _ : AlgebraicGeometry.Etale ι_U := inferInstance
    let c_U_hom : CommRingCat.of k ⟶ R_U := AlgebraicGeometry.Spec.preimage (ι_U ≫ p_base)
    have hc_U_map : AlgebraicGeometry.Spec.map c_U_hom = ι_U ≫ p_base :=
      AlgebraicGeometry.Spec.map_preimage (ι_U ≫ p_base)
    let f_mv : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) k) :=
      CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin d_rel) k))
    let inl_mv : CommRingCat.of (MvPolynomial (Fin d_rel) k) ⟶
        CommRingCat.of (MvPolynomial (Fin d_rel) A_U) :=
      CommRingCat.ofHom (MvPolynomial.map c_U_hom.hom)
    let inr_mv : R_U ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) A_U) :=
      CommRingCat.ofHom (MvPolynomial.C : A_U →+* MvPolynomial (Fin d_rel) A_U)
    have hcomm_mv : f_mv ≫ inl_mv = c_U_hom ≫ inr_mv := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact MvPolynomial.map_C c_U_hom.hom a
    have hColim_mv : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_mv inr_mv hcomm_mv) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_mv
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun i => s.inl.hom (MvPolynomial.X i))))
        ?_ ?_ ?_
      · intro s
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          change MvPolynomial.eval₂Hom s.inr.hom _
              (MvPolynomial.map c_U_hom.hom (MvPolynomial.C a)) =
            s.inl.hom (MvPolynomial.C a)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) a).symm
        · intro i
          change MvPolynomial.eval₂Hom s.inr.hom _
              (MvPolynomial.map c_U_hom.hom (MvPolynomial.X i)) =
            s.inl.hom (MvPolynomial.X i)
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · intro s
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro b
        exact MvPolynomial.eval₂Hom_C s.inr.hom (fun i => s.inl.hom (MvPolynomial.X i)) b
      · intro s m_hom hm_l hm_r
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro b
          change m_hom.hom (MvPolynomial.C b) =
            MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.C b)
          rw [MvPolynomial.eval₂Hom_C]
          exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) b
        · intro i
          change m_hom.hom (MvPolynomial.X i) =
            MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.X i)
          rw [MvPolynomial.eval₂Hom_X']
          have hXi := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l) (MvPolynomial.X i)
          change m_hom.hom (MvPolynomial.map c_U_hom.hom (MvPolynomial.X i)) =
            s.inl.hom (MvPolynomial.X i) at hXi
          rwa [MvPolynomial.map_X] at hXi
    have hPush_mv : CategoryTheory.IsPushout f_mv c_U_hom inl_mv inr_mv :=
      CategoryTheory.IsPushout.of_isColimit hColim_mv
    have hpb_mv0 : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_mv) (AlgebraicGeometry.Spec.map inr_mv)
        S_d.hom (ι_U ≫ p_base) := by
      rw [← hc_U_map]
      exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_mv c_U_hom inl_mv inr_mv hPush_mv
    let ι_tilde : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d_rel) A_U)) ⟶ Y_d :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map inl_mv)
        (AlgebraicGeometry.Spec.map inr_mv ≫ ι_U)
        (by
          rw [Category.assoc]
          exact hpb_mv0.w)
    have hpb_ι_outer : CategoryTheory.IsPullback
        (ι_tilde ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base)
        (AlgebraicGeometry.Spec.map inr_mv)
        S_d.hom (ι_U ≫ p_base) := by
      have hfst : ι_tilde ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base =
          AlgebraicGeometry.Spec.map inl_mv :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst]
      exact hpb_mv0
    have hpb_ι_tilde : CategoryTheory.IsPullback ι_tilde
        (AlgebraicGeometry.Spec.map inr_mv)
        (CategoryTheory.Limits.pullback.snd S_d.hom p_base) ι_U :=
      CategoryTheory.IsPullback.of_right hpb_ι_outer
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback S_d.hom p_base)
    have _ : AlgebraicGeometry.Etale ι_tilde :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_ι_tilde.flip inferInstance

    have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hγ_et
    have _ : AlgebraicGeometry.Etale V₀.toSpecΓ := by
      rw [← hAffV₀.isoSpec_hom]
      infer_instance
    let φ₀ : V₀.toScheme ⟶ Y_d :=
      V₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ) ≫ ι_tilde
    have _ : AlgebraicGeometry.Etale φ₀ := by
      dsimp [φ₀]
      infer_instance
    have hφ₀_snd : φ₀ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_base =
        V₀.ι ≫ f₀_hom := by
      have hsnd : ι_tilde ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_base =
          AlgebraicGeometry.Spec.map inr_mv ≫ ι_U :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      dsimp [φ₀]
      rw [Category.assoc, Category.assoc, hsnd,
        ← Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ)),
        ← AlgebraicGeometry.Spec.map_comp]
      have hγ_inr : inr_mv ≫ CommRingCat.ofHom γ = f₀_hom.appLE U V₀ e_VU :=
        CommRingCat.hom_ext hγ_C
      rw [hγ_inr, AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc,
        hAffU.toSpecΓ_fromSpec, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]

    let V_R : X_R.Opens := (TopologicalSpace.Opens.map fst_XR.base).obj V₀
    have hx_VR : x ∈ V_R := hx₀_V₀
    have hpb_res : CategoryTheory.IsPullback (fst_XR ∣_ V₀) V_R.ι V₀.ι fst_XR :=
      AlgebraicGeometry.isPullback_morphismRestrict fst_XR V₀
    have hpb_VR_V0 : CategoryTheory.IsPullback
        (fst_XR ∣_ V₀) (V_R.ι ≫ f_R) (V₀.ι ≫ f₀_hom) g_R :=
      hpb_res.paste_vert (CategoryTheory.IsPullback.of_hasPullback f₀_hom g_R)
    let φ_R : V_R.toScheme ⟶ A_R :=
      hpb_AY.lift ((fst_XR ∣_ V₀) ≫ φ₀) (V_R.ι ≫ f_R)
        (by
          rw [Category.assoc, hφ₀_snd]
          exact hpb_VR_V0.w)
    have hpb_φR_outer : CategoryTheory.IsPullback
        (φ_R ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        (fst_XR ∣_ V₀) g_R
        (φ₀ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_base) := by
      rw [hpb_AY.lift_snd, hφ₀_snd]
      exact hpb_VR_V0.flip
    have hpb_φR : CategoryTheory.IsPullback φ_R (fst_XR ∣_ V₀) π_AY φ₀ :=
      CategoryTheory.IsPullback.of_right hpb_φR_outer (hpb_AY.lift_fst _ _ _) hpb_AY.flip
    have hEt_φR : AlgebraicGeometry.Etale φ_R :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_φR.flip inferInstance

    let V_U := CategoryTheory.Limits.pullback j_X V_R.ι
    let ι_VU : V_U ⟶ X_R_Ω := CategoryTheory.Limits.pullback.fst j_X V_R.ι
    let j_V : V_U ⟶ V_R.toScheme := CategoryTheory.Limits.pullback.snd j_X V_R.ι
    have hSq1 : CategoryTheory.IsPullback ι_VU j_V j_X V_R.ι :=
      CategoryTheory.IsPullback.of_hasPullback j_X V_R.ι
    let snd_XRΩ := CategoryTheory.Limits.pullback.snd f_R j_R
    have hpb_jX : CategoryTheory.IsPullback j_X snd_XRΩ f_R j_R :=
      CategoryTheory.IsPullback.of_hasPullback f_R j_R
    have hpb_VU_jR : CategoryTheory.IsPullback (ι_VU ≫ snd_XRΩ) j_V j_R (V_R.ι ≫ f_R) :=
      hSq1.paste_horiz hpb_jX.flip
    have hVR_fR_eq : V_R.ι ≫ f_R = φ_R ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R :=
      (hpb_AY.lift_snd _ _ _).symm
    have hpb_jA : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        j_A j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) :=
      CategoryTheory.IsPullback.of_hasPullback j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let φ_U : V_U ⟶ A_Ω :=
      CategoryTheory.Limits.pullback.lift (ι_VU ≫ snd_XRΩ) (j_V ≫ φ_R)
        (by
          rw [Category.assoc j_V, ← hVR_fR_eq]
          exact hpb_VU_jR.w)
    have hpb_φU_outer : CategoryTheory.IsPullback
        (φ_U ≫ CategoryTheory.Limits.pullback.fst j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        j_V j_R (φ_R ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) := by
      have hfst : φ_U ≫ CategoryTheory.Limits.pullback.fst j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) = ι_VU ≫ snd_XRΩ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst, ← hVR_fR_eq]
      exact hpb_VU_jR
    have hSq2 : CategoryTheory.IsPullback φ_U j_V j_A φ_R :=
      CategoryTheory.IsPullback.of_right hpb_φU_outer
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) hpb_jA

    exact ⟨V_R, hx_VR, φ_R, hEt_φR, V_U, ι_VU, j_V, φ_U, hSq1, hSq2⟩

  
  
  intro U_line s₀ Ω η X_s₀ X_η G_q G_succ Fℤ_U
  let P := Polynomial k
  obtain ⟨M_max, hM_max, hM_comap, hDom_R, hHensel_R, hAlgClosedRes_R,
    ht_max, ht_ne, hMax_R, hRes_R,
    φ_R_Ω, hφ_B, hφ_comp, hφ_inj, hLoc_Ω, hj_open⟩ := hValRingPkg
  let _ : M_max.IsMaximal := hM_max
  let R_bar := Localization.AtPrime M_max
  let _ : IsDomain R_bar := hDom_R
  let _ : HenselianLocalRing R_bar := hHensel_R
  let _ : IsAlgClosed (IsLocalRing.ResidueField R_bar) := hAlgClosedRes_R
  let p_R : P →+* R_bar := algebraMap P R_bar
  let t_bar : R_bar := p_R Polynomial.X

  obtain ⟨⟨ℐ, hCat_ℐ, hFilt_ℐ, D, α, c, hc, e_pt, hCocone, hStage⟩,
    ⟨ℐ_sh, hCat_sh, hFilt_sh, D_sh, α_sh, R_sh, hCR_sh, hDom_sh, hHens_sh, hAlg_sh,
      f_sh, ι_sh, c_sh, hc_sh, e_sh, hf_sh, hι_sh_inj, hι_sh_max, hStage_sh⟩⟩ :=
    weil_origin_cosp_alg_val_ring_and_good_stage_colimit k ℓ M_max hM_comap
      φ_R_Ω hφ_B hφ_comp hφ_inj
  let _ : CategoryTheory.SmallCategory ℐ := hCat_ℐ
  let _ : CategoryTheory.IsFiltered ℐ := hFilt_ℐ
  let _ : CategoryTheory.SmallCategory ℐ_sh := hCat_sh
  let _ : CategoryTheory.IsFiltered ℐ_sh := hFilt_sh
  let _ : CommRing R_sh := hCR_sh
  let _ : IsDomain R_sh := hDom_sh
  let _ : HenselianLocalRing R_sh := hHens_sh
  let _ : IsAlgClosed (IsLocalRing.ResidueField R_sh) := hAlg_sh

  obtain ⟨hBij0_A, hZero_A⟩ :=
    weil_origin_cosp_smooth_affine_val_ring_acyclic k (2 * m + 1) ℓ hPur0 hPur2 hPur1
      R_bar p_R t_bar rfl Ω φ_R_Ω hLoc_Ω ℐ D α c hc e_pt hCocone hStage

  obtain ⟨hBij0_Q, hZero_Q⟩ :=
    weil_sing_origin_cosp_proj_quadric_val_ring_acyclic k m hm ℓ hℓ hPBC
      Q_fam g_Q ι_affQ o₀ hQ1 hQ2 hQ3
      R_bar p_R t_bar rfl ht_max ht_ne hMax_R hRes_R
      Ω φ_R_Ω hφ_inj hLoc_Ω hj_open hBij0_A hZero_A

  let p_A1 : U_line ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* P))
  let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
  let g_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ U_line :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)
  let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
  have _ : AlgebraicGeometry.IsOpenImmersion j_R := hj_open
  have hg_R_pA1 : g_R ≫ p_A1 = g_k_R := by
    dsimp [g_R, p_A1, g_k_R]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  let k₁ := IsLocalRing.ResidueField R_bar
  let u_R : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R_bar))
  have hu_R_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)),
      u_R.base pt = IsLocalRing.closedPoint R_bar := by
    intro pt
    rw [Subsingleton.elim pt (⊥ : PrimeSpectrum k₁)]
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue R_bar) ⊥ = IsLocalRing.maximalIdeal R_bar
    ext x
    rw [Ideal.mem_comap, Ideal.mem_bot]
    exact Ideal.Quotient.eq_zero_iff_mem
  let u_k : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((IsLocalRing.residue R_bar).comp (p_R.comp Polynomial.C)))
  have huR_eq_uk : u_R ≫ g_R = u_k ≫ s₀ := by
    dsimp [u_R, g_R, u_k, s₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    exact hRes_R

  let S_d := weilAffineSpaceOver k (2 * m + 1)
  let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
  let A_Ω := CategoryTheory.Limits.pullback j_R
    (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
  let j_A : A_Ω ⟶ A_R :=
    CategoryTheory.Limits.pullback.snd j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
  let X_R := CategoryTheory.Limits.pullback f₀.left g_R
  let fst_XR := CategoryTheory.Limits.pullback.fst f₀.left g_R
  let f_R := CategoryTheory.Limits.pullback.snd f₀.left g_R
  let X_R_Ω := CategoryTheory.Limits.pullback f_R j_R
  let j_X : X_R_Ω ⟶ X_R := CategoryTheory.Limits.pullback.fst f_R j_R
  let f_Ω : X_R_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    CategoryTheory.Limits.pullback.snd f_R j_R
  have _ : AlgebraicGeometry.IsOpenImmersion j_X :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback f_R j_R).flip hj_open

  let Q_R := CategoryTheory.Limits.pullback g_Q.left g_R
  let Q_R_Ω := CategoryTheory.Limits.pullback
    (CategoryTheory.Limits.pullback.snd g_Q.left g_R) j_R
  let j_Q : Q_R_Ω ⟶ Q_R :=
    CategoryTheory.Limits.pullback.fst
      (CategoryTheory.Limits.pullback.snd g_Q.left g_R) j_R

  
  have hSmoothRoofAt : ∀ (z : ↥X_R) (W_sm : X₀.left.Opens),
      fst_XR.base z ∈ W_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_sm.ι ≫ f₀.left) →
      ∃ (Y U V V_U : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsAffine V)
        (j_Y : U ⟶ Y)
        (e_X : V ⟶ X_R) (_ : AlgebraicGeometry.Etale e_X)
