          have hψ_eq : ∀ y : ↥i.1,
              ((s.ι.app (idxOf y.1)).hom (⟨y.1, memIdx y.1⟩ ⊗ₜ[E₀] (1 : D₀)) : ↑s.pt) =
                ((s.ι.app i).hom (y ⊗ₜ[E₀] (1 : D₀)) : ↑s.pt) := by
            intro y
            have hle : (idxOf y.1).1 ≤ i.1 := IntermediateField.adjoin_simple_le_iff.mpr y.2
            exact (congrArg (fun f => (f.hom (⟨y.1, memIdx y.1⟩ ⊗ₜ[E₀] (1 : D₀)) : ↑s.pt))
              (s.w (CategoryTheory.homOfLE hle))).symm
          refine @TensorProduct.inductionOn E₀ _ ↥i.1 D₀ _ _ _ _
            (fun z => (c.ι.app i ≫ desc_of s).hom z = (s.ι.app i).hom z) z
            (fun y d => ?_) (fun z₁ z₂ ih₁ ih₂ => ?_)
          · exact (congrArg₂ (@HMul.hMul ↑s.pt ↑s.pt ↑s.pt _) (hψ_eq y) (h_one_tmul d).symm).trans
              (((s.ι.app i).hom.map_mul _ _).symm.trans
                (congrArg (s.ι.app i).hom
                  ((Algebra.TensorProduct.tmul_mul_tmul _ _ _ _).trans
                    (congrArg₂ (· ⊗ₜ[E₀] ·) (mul_one y) (one_mul d)))))
          · exact (RingHom.map_add _ z₁ z₂).trans
              ((congrArg₂ (@HAdd.hAdd ↑s.pt ↑s.pt ↑s.pt _) ih₁ ih₂).trans
                (RingHom.map_add _ z₁ z₂).symm)
        uniq := fun s m hm => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro (z : TensorProduct E₀ k D₀)
          refine @TensorProduct.inductionOn E₀ _ k D₀ _ _ _ _
            (fun z => m.hom z = (desc_of s).hom z) z
            (fun x d => ?_) (fun z₁ z₂ ih₁ ih₂ => ?_)
          · have hsplit : (x ⊗ₜ[E₀] d : TensorProduct E₀ k D₀) =
                (x ⊗ₜ[E₀] (1 : D₀)) * ((1 : k) ⊗ₜ[E₀] d) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            have hm_x : (m.hom (x ⊗ₜ[E₀] (1 : D₀)) : ↑s.pt) =
                ((s.ι.app (idxOf x)).hom (⟨x, memIdx x⟩ ⊗ₜ[E₀] (1 : D₀)) : ↑s.pt) :=
              congrArg (fun f => (f.hom (⟨x, memIdx x⟩ ⊗ₜ[E₀] (1 : D₀)) : ↑s.pt)) (hm (idxOf x))
            have hm_d : (m.hom ((1 : k) ⊗ₜ[E₀] d) : ↑s.pt) =
                ((s.ι.app i_bot).hom ((1 : ↥i_bot.1) ⊗ₜ[E₀] d) : ↑s.pt) :=
              congrArg (fun f => (f.hom ((1 : ↥i_bot.1) ⊗ₜ[E₀] d) : ↑s.pt)) (hm i_bot)
            exact (congrArg m.hom hsplit).trans
              ((m.hom.map_mul _ _).trans
                (congrArg₂ (@HMul.hMul ↑s.pt ↑s.pt ↑s.pt _) hm_x hm_d))
          · exact (RingHom.map_add _ z₁ z₂).trans
              ((congrArg₂ (@HAdd.hAdd ↑s.pt ↑s.pt ↑s.pt _) ih₁ ih₂).trans
                (RingHom.map_add _ z₁ z₂).symm) }
    have hα_et : ∀ i : ℐ, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (α.app i)) := by
      intro i
      let _ : FiniteDimensional E₀ ↥i.1 := i.2
      let _ : Finite ↥i.1 := Module.finite_of_finite E₀
      have hEt_ext : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ ↥i.1))) :=
        hFieldEt E₀ ↥i.1
      have hpb_i : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Algebra.TensorProduct.includeLeftRingHom : ↥i.1 →+* TensorProduct E₀ ↥i.1 D₀)))
          (AlgebraicGeometry.Spec.map (α.app i))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ ↥i.1)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₀ D₀))) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
          (CommRingCat.isPushout_tensorProduct E₀ ↥i.1 D₀)
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_i hEt_ext
