          inv_hom_id := by
            change G.obj.map (Opposite.op e_T.inv) ≫ G.obj.map (Opposite.op e_T.hom) =
              𝟙 (G.obj.obj (Opposite.op (B_j.obj T_X)))
            rw [← G.obj.map_comp]
            change G.obj.map (Opposite.op (e_T.hom ≫ e_T.inv)) =
              𝟙 (G.obj.obj (Opposite.op (B_j.obj T_X)))
            rw [e_T.hom_inv_id]
            exact G.obj.map_id (Opposite.op (B_j.obj T_X)) })
