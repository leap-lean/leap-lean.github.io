      let X_R := CategoryTheory.Limits.pullback f₀_hom g_R
      let X_R_Ω := CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.snd f₀_hom g_R) j_R
      let j_X : X_R_Ω ⟶ X_R :=
        CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd f₀_hom g_R) j_R
      ∀ x : ↥X_R,
        ∃ (V : X_R.Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ X_R_Ω) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_X V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A φ := by
    clear * -
    intro X₀_sch U₀_sch p_base f₀_hom _ R_bar Ω₀ _ _ g_k_R g_R hg_R j_R
      S_d A_R A_Ω j_A X_R X_R_Ω j_X x
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_base
    let π_AY : A_R ⟶ Y_d :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst S_d.hom g_k_R)
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R ≫ g_R)
        (by
          rw [Category.assoc, hg_R]
          exact CategoryTheory.Limits.pullback.condition)
    have hpb_AY_outer : CategoryTheory.IsPullback
        (π_AY ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base)
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        S_d.hom (g_R ≫ p_base) := by
      have hfst : π_AY ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base =
          CategoryTheory.Limits.pullback.fst S_d.hom g_k_R :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst, hg_R]
      exact CategoryTheory.IsPullback.of_hasPullback S_d.hom g_k_R
    have hpb_AY : CategoryTheory.IsPullback π_AY
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
        (CategoryTheory.Limits.pullback.snd S_d.hom p_base) g_R :=
      CategoryTheory.IsPullback.of_right hpb_AY_outer
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback S_d.hom p_base)
    let fst_XR := CategoryTheory.Limits.pullback.fst f₀_hom g_R
    let f_R := CategoryTheory.Limits.pullback.snd f₀_hom g_R
    let x₀ : ↥X₀_sch := fst_XR.base x
    obtain ⟨U, hAffU, V₀, hAffV₀, hx₀_V₀, e_VU, hStdSm⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d_rel f₀_hom).mp inferInstance x₀
    obtain ⟨γ, hγ_C, hγ_et⟩ :=
      RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStdSm
    let R_U : CommRingCat.{u} := U₀_sch.presheaf.obj (Opposite.op U)
    let A_U : Type u := ↑R_U
    let ι_U : AlgebraicGeometry.Spec R_U ⟶ U₀_sch := hAffU.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion ι_U := hAffU.isOpenImmersion_fromSpec
    have _ : AlgebraicGeometry.Etale ι_U := inferInstance
    let c_U_hom : CommRingCat.of k ⟶ R_U := AlgebraicGeometry.Spec.preimage (ι_U ≫ p_base)
    have hc_U_map : AlgebraicGeometry.Spec.map c_U_hom = ι_U ≫ p_base :=
      AlgebraicGeometry.Spec.map_preimage (ι_U ≫ p_base)
    let f_mv : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) k) :=
      CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin d_rel) k))
    let inl_mv : CommRingCat.of (MvPolynomial (Fin d_rel) k) ⟶
        CommRingCat.of (MvPolynomial (Fin d_rel) A_U) :=
      CommRingCat.ofHom (MvPolynomial.map c_U_hom.hom)
    let inr_mv : R_U ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) A_U) :=
      CommRingCat.ofHom (MvPolynomial.C : A_U →+* MvPolynomial (Fin d_rel) A_U)
    have hcomm_mv : f_mv ≫ inl_mv = c_U_hom ≫ inr_mv := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact MvPolynomial.map_C c_U_hom.hom a
    have hColim_mv : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_mv inr_mv hcomm_mv) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_mv
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun i => s.inl.hom (MvPolynomial.X i))))
        ?_ ?_ ?_
      · intro s
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          change MvPolynomial.eval₂Hom s.inr.hom _
              (MvPolynomial.map c_U_hom.hom (MvPolynomial.C a)) =
            s.inl.hom (MvPolynomial.C a)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) a).symm
        · intro i
          change MvPolynomial.eval₂Hom s.inr.hom _
              (MvPolynomial.map c_U_hom.hom (MvPolynomial.X i)) =
            s.inl.hom (MvPolynomial.X i)
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · intro s
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro b
        exact MvPolynomial.eval₂Hom_C s.inr.hom (fun i => s.inl.hom (MvPolynomial.X i)) b
      · intro s m hm_l hm_r
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro b
          change m.hom (MvPolynomial.C b) =
            MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.C b)
          rw [MvPolynomial.eval₂Hom_C]
          exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) b
        · intro i
          change m.hom (MvPolynomial.X i) =
            MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.X i)
          rw [MvPolynomial.eval₂Hom_X']
          have hXi := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l) (MvPolynomial.X i)
          change m.hom (MvPolynomial.map c_U_hom.hom (MvPolynomial.X i)) =
            s.inl.hom (MvPolynomial.X i) at hXi
          rwa [MvPolynomial.map_X] at hXi
    have hPush_mv : CategoryTheory.IsPushout f_mv c_U_hom inl_mv inr_mv :=
      CategoryTheory.IsPushout.of_isColimit hColim_mv
    have hpb_mv0 : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_mv) (AlgebraicGeometry.Spec.map inr_mv)
