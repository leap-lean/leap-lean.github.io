      intro m
      rw [MvPolynomial.coeff_map]
      have h0 : (0 : MvPolynomial (Fin n) ↑(D_poly.obj i₀)).coeff m = 0 := rfl
      rw [h0]
      by_cases hm : m ∈ Δ₁.support
      · exact hθ_zero m hm
      · rw [MvPolynomial.notMem_support_iff.mp hm, map_zero]
    let R₀ : Fin r → MvPolynomial (Fin n) ↑(D_poly.obj i₀) :=
