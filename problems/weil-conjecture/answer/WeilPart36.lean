        (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _ Fℤ_X F_X i))
  have hΛ_j : ∀ i : ℕ, WeilIsTorsionEtalePullback j ℓ i (Λ_j i) := fun i =>
    ⟨_hc, _hr, _hAdd, _hLim, _hColim, T_U, hT_U, T_X, hT_X, ιℤ, hιπ, hπι, fun _ => rfl⟩
  let leray_j : ∀ i : ℕ, (pf_j.obj F_U).H i → F_U.H i := fun i z =>
    (CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app F_U)).postcomp
      Fℤ_U (Nat.add_zero i)
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
          Fℤ_X (pf_j.obj F_U) i) z)
        (Nat.zero_add i))
  have hπM_eq : πM = CategoryTheory.CategoryStruct.comp (pb_j.map α_j) (adj_j.counit.app F_U) :=
    CategoryTheory.Adjunction.homEquiv_counit adj_j F_X F_U α_j
  have hFactor : ∀ (i : ℕ) (x : F_X.H i),
      leray_j i (x.comp (CategoryTheory.Abelian.Ext.mk₀ α_j) (Nat.add_zero i)) = Λ_j i x := by
    intro i x
    let w := (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _ Fℤ_X F_X i) x
    have hmap : (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
        Fℤ_X (pf_j.obj F_U) i) (x.comp (CategoryTheory.Abelian.Ext.mk₀ α_j) (Nat.add_zero i)) =
        w.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_j.map α_j)) (Nat.add_zero i) := by
      dsimp [w]
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    dsimp [leray_j, Λ_j]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
          Fℤ_X (pf_j.obj F_U) i) (x.comp (CategoryTheory.Abelian.Ext.mk₀ α_j) (Nat.add_zero i)))
        (Nat.zero_add i)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app F_U)) (Nat.add_zero i) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp w (Nat.zero_add i)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero i)
    rw [hmap,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) w
        (CategoryTheory.Abelian.Ext.mk₀ (pb_j.map α_j)) (Nat.zero_add i) (Nat.add_zero i)
        (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp w (Nat.zero_add i))
        (CategoryTheory.Abelian.Ext.mk₀ (pb_j.map α_j))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_j.counit.app F_U))
        (Nat.add_zero i) (Nat.zero_add 0) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hπM_eq]
  have hLeray0_mk₀ : ∀ (g : Fℤ_X ⟶ pf_j.obj F_U),
      leray_j 0 (CategoryTheory.Abelian.Ext.mk₀ g) =
        CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.comp ιℤ ((adj_j.homEquiv Fℤ_X F_U).symm g)) := by
    intro g
    have hmap0 : (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_j _ _ _ _ _
        Fℤ_X (pf_j.obj F_U) 0) (CategoryTheory.Abelian.Ext.mk₀ g) =
        CategoryTheory.Abelian.Ext.mk₀ (pb_j.map g) := by
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    have h1 : leray_j 0 (CategoryTheory.Abelian.Ext.mk₀ g) =
        CategoryTheory.Abelian.Ext.mk₀
