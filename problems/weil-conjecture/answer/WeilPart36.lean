      (pf₂ : weilEtaleTorsionH X₄ m q →+ weilEtaleTorsionH X₂ m q)
      (pg₁ : weilEtaleTorsionH X₃ m q →+ weilEtaleTorsionH X₁ m q)
      (pg₂ : weilEtaleTorsionH X₄ m q →+ weilEtaleTorsionH X₃ m q),
      f₁ ≫ f₂ = g₁ ≫ g₂ →
      WeilIsTorsionEtalePullback f₁ m q pf₁ →
      WeilIsTorsionEtalePullback f₂ m q pf₂ →
      WeilIsTorsionEtalePullback g₁ m q pg₁ →
      WeilIsTorsionEtalePullback g₂ m q pg₂ →
