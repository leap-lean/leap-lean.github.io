    exact hConstPullInv S₁.smallEtaleTopology S₂.smallEtaleTopology
      (weilEtaleSitePullback h) hT₁ hT₂ τ_inv (hTB.hom_ext _ _) (hT₁.hom_ext _ _) A

  let B₀ : CommRingCat.{u} := CommRingCat.of (ULift.{u} ℤ)
  let zHom : ∀ (R : CommRingCat.{u}), B₀ ⟶ R := fun R =>
    CommRingCat.ofHom
      { toFun := fun z => (z.down : ↑R)
        map_one' := Int.cast_one
        map_mul' := fun x y => Int.cast_mul x.down y.down
        map_zero' := Int.cast_zero
        map_add' := fun x y => Int.cast_add x.down y.down }
  have hz_comp : ∀ {R₁ R₂ : CommRingCat.{u}} (g : R₁ ⟶ R₂),
      zHom R₁ ≫ g = zHom R₂ := by
    intro R₁ R₂ g
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro z
    exact map_intCast g.hom z.down
  let α_ℤ : (CategoryTheory.Functor.const 𝒥).obj B₀ ⟶ B :=
    { app := fun j => zHom (B.obj j)
      naturality := fun {j j'} φ =>
        (CategoryTheory.Category.id_comp (zHom (B.obj j'))).trans
          (hz_comp (B.map φ)).symm }
  let f_inf : B₀ ⟶ c.pt := zHom c.pt
  have hf_inf : ∀ j : 𝒥, α_ℤ.app j ≫ c.ι.app j = f_inf :=
    fun j => hz_comp (c.ι.app j)
  let Z₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B₀
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let G₀ : CategoryTheory.Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u} :=
    weilEtaleTorsionSheaf Z₀ ℓ
  obtain ⟨hLift_G₀, hKill_G₀⟩ := hAffq 𝒥 B₀ B α_ℤ c hc f_inf hf_inf G₀

  let Φ_of : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (π : Y ⟶ Z₀),
      (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
        Z₀.smallEtaleTopology Y.smallEtaleTopology).obj G₀).H q ≃+
      weilEtaleTorsionH Y ℓ q := fun {Y} π =>
    let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let π_M := weilEtaleConstPullbackHom π
      (weilEtaleIdTerminalIsTerminal.{u} Y)
      (weilEtaleIdTerminalIsTerminal.{u} Z₀) AM
    let ι_M := Classical.choose (hSchemeConstInv π AM)
    let h_inv := Classical.choose_spec (hSchemeConstInv π AM)
    let fwd := (CategoryTheory.Abelian.Ext.mk₀.{u} π_M).postcomp Fℤ_Y (Nat.add_zero q)
    let bwd := (CategoryTheory.Abelian.Ext.mk₀.{u} ι_M).postcomp Fℤ_Y (Nat.add_zero q)
    { toFun := fwd
      invFun := bwd
      left_inv := fun x => by
        change (x.comp (CategoryTheory.Abelian.Ext.mk₀.{u} π_M) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} ι_M) (Nat.add_zero q) = x
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_inv.2,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        change (y.comp (CategoryTheory.Abelian.Ext.mk₀.{u} ι_M) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} π_M) (Nat.add_zero q) = y
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_inv.1,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      map_add' := fwd.map_add }

  have hTriangleBridge :
      ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        (π₁ : Y₁ ⟶ Z₀) (π₂ : Y₂ ⟶ Z₀) (h : Y₁ ⟶ Y₂) (h_eq : h ≫ π₂ = π₁)
        (p_h : weilEtaleTorsionH Y₂ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q),
        WeilIsTorsionEtalePullback h ℓ q p_h →
        ∀ (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
            Z₀.smallEtaleTopology Y₂.smallEtaleTopology).obj G₀).H q),
          (∀ (x₁ : (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
              Z₀.smallEtaleTopology Y₁.smallEtaleTopology).obj G₀).H q),
            WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq G₀ q x₂ x₁ →
            p_h (Φ_of π₂ x₂) = Φ_of π₁ x₁) ∧
          (p_h (Φ_of π₂ x₂) = 0 →
            WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq G₀ q x₂ 0) := by
    intro Y₁ Y₂ π₁ π₂ h h_eq p_h hp_h x₂
    let B₁ := weilEtaleSitePullback π₁
    let B₂ := weilEtaleSitePullback π₂
    let B_h := weilEtaleSitePullback h
    let pb₁ := B₁.sheafPullback AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₁.smallEtaleTopology
    let pb₂ := B₂.sheafPullback AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₂.smallEtaleTopology
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z₀.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z₀.smallEtaleTopology Y₂.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    obtain ⟨hAdd_h, hLim_h, hColim_h, hcℤ_h⟩ := hSite.1 h
    letI : pb_h.Additive := hAdd_h
    letI : CategoryTheory.Limits.PreservesFiniteLimits pb_h := hLim_h
    letI : CategoryTheory.Limits.PreservesFiniteColimits pb_h := hColim_h
    let hT₀ := weilEtaleIdTerminalIsTerminal.{u} Z₀
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} Y₁
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} Y₂
    obtain ⟨ιℤ_h, hιπ_ℤ, hπι_ℤ⟩ := hSchemeConstInv h Aℤ
    let πℤ_h := weilEtaleConstPullbackHom h hT₁ hT₂ Aℤ
    let πM_h := weilEtaleConstPullbackHom h hT₁ hT₂ AM
    let πM_1 := weilEtaleConstPullbackHom π₁ hT₁ hT₀ AM
    let πM_2 := weilEtaleConstPullbackHom π₂ hT₂ hT₀ AM
    let Fℤ₁ := (CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ₂ := (CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let G₂ := weilEtaleTorsionSheaf Y₂ ℓ
    let p_std : weilEtaleTorsionH Y₂ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q :=
      ((CategoryTheory.Abelian.Ext.mk₀.{u} πM_h).postcomp Fℤ₁ (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ_h).precomp (pb_h.obj G₂) (Nat.zero_add q)).comp
          (pb_h.mapExtAddHom Fℤ₂ G₂ q))
    have hp_std : WeilIsTorsionEtalePullback h ℓ q p_std :=
      ⟨@hc_all Y₁ Y₂ h, @hr_all Y₁ Y₂ h, hAdd_h, hLim_h, hColim_h,
        weilEtaleIdTerminal.{u} Y₁, hT₁, weilEtaleIdTerminal.{u} Y₂, hT₂,
        ιℤ_h, hιπ_ℤ, hπι_ℤ, fun _ => rfl⟩
    have hp_eq : p_h = p_std := hPullUniq h p_h p_std hp_h hp_std
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let e_B : CategoryTheory.Iso B₁ (CategoryTheory.Functor.comp B₂ B_h) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
        (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
    letI : (CategoryTheory.Functor.comp B₂ B_h).IsContinuous
        Z₀.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B₂ B_h
        Z₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
      AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₁.smallEtaleTopology
    let β : Quiver.Hom (pb_h.obj (pb₂.obj G₀)) (pb₁.obj G₀) :=
      (adj_h.homEquiv (pb₂.obj G₀) (pb₁.obj G₀)).symm
        ((adj₂.homEquiv G₀ (pf_h.obj (pb₁.obj G₀))).symm
          (CategoryTheory.CategoryStruct.comp
            (adj₁.unit.app G₀)
            (e_pf.hom.app (pb₁.obj G₀))))
    let Pℤ₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj Aℤ
    let Pℤ₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj Aℤ
    let η₁ := CategoryTheory.Functor.whiskerLeft B_h.op
      ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ₁)
    let uℤ := ((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology
      AddCommGrpCat.{u}).homEquiv Pℤ₂ (pf_h.obj Fℤ₁)).symm η₁
    let cℤ := (adj_h.homEquiv Fℤ₂ Fℤ₁).symm uℤ
    let inv_cℤ := @CategoryTheory.inv _ _ _ _ cℤ hcℤ_h
    have hcℤ_eq : cℤ = πℤ_h :=
      hConstZ_eq Y₁.smallEtaleTopology Y₂.smallEtaleTopology B_h hT₁ hT₂ Aℤ
    have hinv_cℤ : inv_cℤ = ιℤ_h := by
      have h1 : ιℤ_h ≫ cℤ = 𝟙 Fℤ₁ := by rw [hcℤ_eq]; exact hιπ_ℤ
      calc
        inv_cℤ = 𝟙 Fℤ₁ ≫ inv_cℤ := (CategoryTheory.Category.id_comp _).symm
        _ = (ιℤ_h ≫ cℤ) ≫ inv_cℤ := by rw [h1]
        _ = ιℤ_h ≫ (cℤ ≫ inv_cℤ) := CategoryTheory.Category.assoc _ _ _
        _ = ιℤ_h ≫ 𝟙 _ := by rw [@CategoryTheory.IsIso.hom_inv_id _ _ _ _ cℤ hcℤ_h]
        _ = ιℤ_h := CategoryTheory.Category.comp_id _
    have hcoc : pb_h.map πM_2 ≫ πM_h = β ≫ πM_1 :=
      hMateCocycle Z₀.smallEtaleTopology Y₁.smallEtaleTopology Y₂.smallEtaleTopology
        B₁ B₂ B_h e_B hT₀ hT₁ hT₂ AM
    let y_pull : (pb₁.obj G₀).H q :=
      (CategoryTheory.Abelian.Ext.mk₀.{u} β).postcomp Fℤ₁ (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀.{u} inv_cℤ).precomp (pb_h.obj (pb₂.obj G₀))
          (Nat.zero_add q) ((pb_h.mapExtAddHom Fℤ₂ (pb₂.obj G₀) q) x₂))
    have hy_maps : WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq G₀ q x₂ y_pull :=
      ⟨@hc_all Y₁ Y₂ h, @hr_all Y₁ Y₂ h, hAdd_h, hLim_h, hColim_h, hcℤ_h, rfl⟩
    have hΦ_y : Φ_of π₁ y_pull = p_h (Φ_of π₂ x₂) := by
      rw [hp_eq]
      dsimp only [y_pull]
      rw [hinv_cℤ]
      exact hExtIntertwine pb_h ιℤ_h β πM_1 πM_2 πM_h hcoc x₂
    refine ⟨?_, ?_⟩
    · intro x₁ hMaps
      rcases hMaps with ⟨hc', hr', hAdd', hLim', hColim', hcℤ', hx₁_eq⟩
      obtain rfl : hc' = @hc_all Y₁ Y₂ h := Subsingleton.elim _ _
      obtain rfl : hr' = @hr_all Y₁ Y₂ h := Subsingleton.elim _ _
      obtain rfl : hAdd' = hAdd_h := Subsingleton.elim _ _
      obtain rfl : hLim' = hLim_h := Subsingleton.elim _ _
      obtain rfl : hColim' = hColim_h := Subsingleton.elim _ _
      obtain rfl : hcℤ' = hcℤ_h := Subsingleton.elim _ _
      have hy_eq : y_pull = x₁ := hx₁_eq
      rw [← hy_eq, hΦ_y]
    · intro hp0
      have hΦ0 : Φ_of π₁ y_pull = Φ_of π₁ 0 := by
        rw [hΦ_y, hp0, map_zero]
      have hy0 : y_pull = 0 := (Φ_of π₁).injective hΦ0
      rwa [hy0] at hy_maps

  let π_j : ∀ j : 𝒥, AlgebraicGeometry.Spec (B.obj j) ⟶ Z₀ :=
    fun j => AlgebraicGeometry.Spec.map (α_ℤ.app j)
  let π_inf : AlgebraicGeometry.Spec c.pt ⟶ Z₀ :=
    AlgebraicGeometry.Spec.map f_inf
  let u_j : ∀ j : 𝒥, AlgebraicGeometry.Spec c.pt ⟶ AlgebraicGeometry.Spec (B.obj j) :=
    fun j => AlgebraicGeometry.Spec.map (c.ι.app j)
  refine ⟨?_, ?_⟩
  · intro ξ_inf
    let s_inf := (Φ_of π_inf).symm ξ_inf
    obtain ⟨j, hu, s_j, hMaps⟩ := hLift_G₀ s_inf
    refine ⟨j, Φ_of (π_j j) s_j, fun p_j hp_j => ?_⟩
    have h1 := (hTriangleBridge π_inf (π_j j) (u_j j) hu p_j hp_j s_j).1 s_inf hMaps
    exact h1.trans ((Φ_of π_inf).apply_symm_apply ξ_inf)
  · intro j ξ_j p_j hp_j hp_j0
    let s_j := (Φ_of (π_j j)).symm ξ_j
    have hs_j : Φ_of (π_j j) s_j = ξ_j := (Φ_of (π_j j)).apply_symm_apply ξ_j
    have hu_j : u_j j ≫ π_j j = π_inf :=
      (AlgebraicGeometry.Spec.map_comp (α_ℤ.app j) (c.ι.app j)).symm.trans
        (congrArg AlgebraicGeometry.Spec.map (hf_inf j))
    have hp_s0 : p_j (Φ_of (π_j j) s_j) = 0 := by
      rw [hs_j]
      exact hp_j0
    have hMaps0 : WeilEtaleTrianglePullbackMapsTo π_inf (π_j j) (u_j j) hu_j G₀ q s_j 0 :=
      (hTriangleBridge π_inf (π_j j) (u_j j) hu_j p_j hp_j s_j).2 hp_s0
    obtain ⟨j', φ, hφ, hMaps_φ⟩ := hKill_G₀ j hu_j s_j hMaps0
    refine ⟨j', φ, fun p_φ hp_φ => ?_⟩
    have h2 := (hTriangleBridge (π_j j') (π_j j)
      (AlgebraicGeometry.Spec.map (B.map φ)) hφ p_φ hp_φ s_j).1 0 hMaps_φ
    rw [← hs_j, h2, map_zero]

theorem weil_punctured_val_ring_acyclic_hdi_isZero_iff_affine_etale_cover_kill (ℓ b : ℕ)
    {U Y : AlgebraicGeometry.Scheme.{u}} (j : U ⟶ Y) :
    (CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf U ℓ)) →
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
        (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b),
        ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
          (_ : ∀ a, AlgebraicGeometry.IsAffine (V a))
          (v : ∀ a, V a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (v a)),
          (⋃ a, Set.range (v a).base) = Set.univ ∧
          ∀ (a : I)
            (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j w) (v a)) ℓ b),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd j w) (v a)) ℓ b p_a →
            p_a ξ = 0) ∧
    ((∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
        (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b),
        ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
          (u : ∀ a, V a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (u a)),
          (⋃ a, Set.range (u a).base) = Set.univ ∧
          ∀ (a : I)
            (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j w) (u a)) ℓ b),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd j w) (u a)) ℓ b p_a →
            p_a ξ = 0) →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf U ℓ))) :=
by
  classical
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hop_comp : ∀ {C : Type _} [CategoryTheory.Category C] {A B D : C}
      (g₁ : A ⟶ B) (g₂ : B ⟶ D),
      (g₁ ≫ g₂).op = g₂.op ≫ g₁.op := fun _ _ => rfl

  have hMemEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (E : Z.Etale)
      (R : CategoryTheory.Sieve E),
      R ∈ Z.smallEtaleTopology E ↔
        ∀ (x : ↥E.left), ∃ (W_z : Z.Etale) (g : W_z ⟶ E) (y : ↥W_z.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro Z E R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      Z (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) Z
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance E R
    exact (iff_of_eq
      (congrArg (fun K : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ K E) heq)).trans hiff

  let J_Y := Y.smallEtaleTopology

  have hZeroToSieve : ∀ (P : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero
        ((CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj P) →
      ∀ (W₀ : Y.Etale) (s₀ : ↥(P.obj (Opposite.op W₀))),
        ∃ R₀ ∈ J_Y W₀,
          ∀ {V₀ : Y.Etale} (g : V₀ ⟶ W₀), R₀.arrows g → (P.map g.op).hom s₀ = 0 := by
    intro P hZero W₀ s₀
    have hZeroSh : CategoryTheory.Limits.IsZero (CategoryTheory.sheafify J_Y P) :=
      (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}).map_isZero hZero
    let η_P := CategoryTheory.toSheafify J_Y P
    have hη_zero : η_P = 0 := hZeroSh.eq_of_tgt η_P 0
    have hη_app_zero : η_P.app (Opposite.op W₀) = 0 :=
      congrArg (fun ν : P ⟶ CategoryTheory.sheafify J_Y P => ν.app (Opposite.op W₀)) hη_zero
    have hη_eq :
        (CategoryTheory.ConcreteCategory.hom (η_P.app (Opposite.op W₀))) s₀ =
          (CategoryTheory.ConcreteCategory.hom (η_P.app (Opposite.op W₀))) 0 := by
      rw [hη_app_zero]
      simp
    let R₀ : CategoryTheory.Sieve W₀ :=
      CategoryTheory.Presheaf.equalizerSieve (F := P) (X := Opposite.op W₀) s₀ 0
    have hR₀_mem : R₀ ∈ J_Y W₀ :=
      CategoryTheory.Presheaf.equalizerSieve_mem J_Y η_P s₀ 0 hη_eq
    exact ⟨R₀, hR₀_mem, fun g hg => hg.trans (map_zero (P.map g.op).hom)⟩

  have hZeroOfAffSieve : ∀ (P : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}),
      (∀ (W₀ : Y.Etale) [AlgebraicGeometry.IsAffine W₀.left]
        (s₀ : ↥(P.obj (Opposite.op W₀))),
        ∃ R₀ ∈ J_Y W₀,
          ∀ {V₀ : Y.Etale} (g : V₀ ⟶ W₀), R₀.arrows g → (P.map g.op).hom s₀ = 0) →
      CategoryTheory.Limits.IsZero
        ((CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj P) := by
    intro P hAffZero
    let F_P := (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj P
    let η_P := CategoryTheory.toSheafify J_Y P
    let adj_sh := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    have hη_zero : η_P = 0 := by
      ext E_op : 2
      apply AddCommGrpCat.ext
      intro s
      let E := Opposite.unop E_op
      have hE_et : AlgebraicGeometry.Etale E.hom := E.prop
      let R_zero : CategoryTheory.Sieve E :=
        { arrows := fun {Z} g => (P.map g.op).hom s = 0
          downward_closed := fun {Z Z'} g hg k => by
            have hmap : P.map (k ≫ g).op = P.map g.op ≫ P.map k.op :=
              (congrArg P.map (hop_comp k g)).trans (P.map_comp g.op k.op)
            exact (congrArg (fun φ => φ.hom s) hmap).trans
              ((congrArg (P.map k.op).hom hg).trans (map_zero (P.map k.op).hom)) }
      have hR_mem : R_zero ∈ J_Y E := by
        rw [hMemEtale Y E R_zero]
        intro x
        obtain ⟨O_x, hAffO, hxO, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := x) (U := (⊤ : E.left.Opens)) trivial
        have hW_et : AlgebraicGeometry.Etale (O_x.ι ≫ E.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O_x.ι E.hom inferInstance hE_et
        let W_x : Y.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ E.hom) hW_et
        have _ : AlgebraicGeometry.IsAffine W_x.left := hAffO
        let j_x : W_x ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
        obtain ⟨R_x, hRx_mem, hRx_zero⟩ := hAffZero W_x ((P.map j_x.op).hom s)
        obtain ⟨Z, f_y, y, hfy_R, hfy_et, hfy_pt⟩ :=
          (hMemEtale Y W_x R_x).mp hRx_mem ⟨x, hxO⟩
        refine ⟨Z, f_y ≫ j_x, y, ?_, ?_, ?_⟩
        · have hmap : P.map (f_y ≫ j_x).op = P.map j_x.op ≫ P.map f_y.op :=
            (congrArg P.map (hop_comp f_y j_x)).trans (P.map_comp j_x.op f_y.op)
          exact (congrArg (fun φ => φ.hom s) hmap).trans (hRx_zero f_y hfy_R)
        · have hOx_et : AlgebraicGeometry.Etale O_x.ι := inferInstance
          exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            f_y.left O_x.ι hfy_et hOx_et
        · change O_x.ι.base (f_y.left.base y) = x
          rw [hfy_pt]
          rfl
      exact F_P.isSeparated E R_zero hR_mem (η_P.app (Opposite.op E) s) 0 (fun Z g hg => by
        change (F_P.obj.map g.op) (η_P.app (Opposite.op E) s) = (F_P.obj.map g.op) 0
        rw [map_zero]
        have hnat := congrArg (fun k => k s) (η_P.naturality g.op)
        have hlhs : (P.map g.op ≫ η_P.app (Opposite.op Z)) s = 0 := by
          change (η_P.app (Opposite.op Z)).hom ((P.map g.op).hom s) = 0
          rw [hg, map_zero]
        exact hnat.symm.trans hlhs)
    have hid_zero : 𝟙 F_P = 0 := by
      have htri : (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).map η_P ≫
          adj_sh.counit.app F_P = 𝟙 F_P :=
        adj_sh.left_triangle_components P
      rw [← htri, hη_zero, CategoryTheory.Functor.map_zero, CategoryTheory.Limits.zero_comp]
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    exact hid_zero

  have hTri : ∀ {W V : AlgebraicGeometry.Scheme.{u}} (w : W ⟶ Y) (w' : V ⟶ Y) (v : V ⟶ W)
      (_hvw : v ≫ w = w')
      (m_g : CategoryTheory.Limits.pullback w' j ⟶ CategoryTheory.Limits.pullback w j)
      (hmap_fst : m_g ≫ CategoryTheory.Limits.pullback.fst w j =
        CategoryTheory.Limits.pullback.fst w' j ≫ v)
      (hmap_snd : m_g ≫ CategoryTheory.Limits.pullback.snd w j =
        CategoryTheory.Limits.pullback.snd w' j),
      let σ := CategoryTheory.Limits.pullbackSymmetry w j
      let fst_v := CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j w) v
      (∃ α : CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) v ⟶
          CategoryTheory.Limits.pullback w' j,
        α ≫ (m_g ≫ σ.hom) = fst_v) ∧
      (∃ β : CategoryTheory.Limits.pullback w' j ⟶
          CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) v,
        (β ≫ fst_v) ≫ σ.inv = m_g) := by
    intro W V w w' v hvw m_g hmap_fst hmap_snd σ fst_v
    let snd_v := CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd j w) v
    have hcond_α : snd_v ≫ w' = (fst_v ≫ CategoryTheory.Limits.pullback.fst j w) ≫ j := by
      calc
        snd_v ≫ w' = snd_v ≫ (v ≫ w) := by rw [hvw]
        _ = (snd_v ≫ v) ≫ w := (Category.assoc _ _ _).symm
        _ = (fst_v ≫ CategoryTheory.Limits.pullback.snd j w) ≫ w := by
          rw [CategoryTheory.Limits.pullback.condition]
        _ = fst_v ≫ (CategoryTheory.Limits.pullback.snd j w ≫ w) := Category.assoc _ _ _
        _ = fst_v ≫ (CategoryTheory.Limits.pullback.fst j w ≫ j) := by
          rw [CategoryTheory.Limits.pullback.condition]
        _ = (fst_v ≫ CategoryTheory.Limits.pullback.fst j w) ≫ j := (Category.assoc _ _ _).symm
    let α : CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) v ⟶
        CategoryTheory.Limits.pullback w' j :=
      CategoryTheory.Limits.pullback.lift snd_v
        (fst_v ≫ CategoryTheory.Limits.pullback.fst j w) hcond_α
    have hTriFwd : α ≫ (m_g ≫ σ.hom) = fst_v := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (α ≫ (m_g ≫ σ.hom)) ≫ CategoryTheory.Limits.pullback.fst j w =
              α ≫ m_g ≫ (σ.hom ≫ CategoryTheory.Limits.pullback.fst j w) := by
            simp only [Category.assoc]
          _ = α ≫ (m_g ≫ CategoryTheory.Limits.pullback.snd w j) := by
            dsimp [σ]
            rw [CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst]
          _ = α ≫ CategoryTheory.Limits.pullback.snd w' j := by rw [hmap_snd]
          _ = fst_v ≫ CategoryTheory.Limits.pullback.fst j w :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
      · calc
          (α ≫ (m_g ≫ σ.hom)) ≫ CategoryTheory.Limits.pullback.snd j w =
              α ≫ m_g ≫ (σ.hom ≫ CategoryTheory.Limits.pullback.snd j w) := by
            simp only [Category.assoc]
          _ = α ≫ (m_g ≫ CategoryTheory.Limits.pullback.fst w j) := by
            dsimp [σ]
            rw [CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd]
          _ = (α ≫ CategoryTheory.Limits.pullback.fst w' j) ≫ v := by
            rw [hmap_fst, Category.assoc]
          _ = snd_v ≫ v := by rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = fst_v ≫ CategoryTheory.Limits.pullback.snd j w :=
            CategoryTheory.Limits.pullback.condition.symm
    have hcond_β : (m_g ≫ σ.hom) ≫ CategoryTheory.Limits.pullback.snd j w =
        CategoryTheory.Limits.pullback.fst w' j ≫ v := by
      calc
        (m_g ≫ σ.hom) ≫ CategoryTheory.Limits.pullback.snd j w =
            m_g ≫ (σ.hom ≫ CategoryTheory.Limits.pullback.snd j w) := Category.assoc _ _ _
        _ = m_g ≫ CategoryTheory.Limits.pullback.fst w j := by
          dsimp [σ]
          rw [CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd]
        _ = CategoryTheory.Limits.pullback.fst w' j ≫ v := hmap_fst
    let β : CategoryTheory.Limits.pullback w' j ⟶
        CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) v :=
      CategoryTheory.Limits.pullback.lift (m_g ≫ σ.hom)
        (CategoryTheory.Limits.pullback.fst w' j) hcond_β
    have hTriBwd : (β ≫ fst_v) ≫ σ.inv = m_g := by
      calc
        (β ≫ fst_v) ≫ σ.inv = (m_g ≫ σ.hom) ≫ σ.inv := by
          dsimp [β, fst_v]
          rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = m_g ≫ (σ.hom ≫ σ.inv) := Category.assoc _ _ _
        _ = m_g := by rw [σ.hom_inv_id, Category.comp_id]
    exact ⟨⟨α, hTriFwd⟩, ⟨β, hTriBwd⟩⟩

  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨Θ_U, hΘ_U⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1 U ℓ b
  let G_U := weilEtaleTorsionSheaf U ℓ
  let Fgt_U := AlgebraicGeometry.Scheme.Etale.forget U
  let B_j : CategoryTheory.Functor Y.Etale U.Etale := weilEtaleSitePullback j
  let Q : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
    CategoryTheory.Functor.comp B_j.op (G_U.cohomologyPresheaf b)

  refine ⟨?_, ?_⟩
  · intro hZero W _ w _ ξ
    let W₀ : Y.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ w (inferInstance : AlgebraicGeometry.Etale w)
    let sym_hom : (Fgt_U.obj (B_j.obj W₀)).left ⟶ CategoryTheory.Limits.pullback j w :=
      (CategoryTheory.Limits.pullbackSymmetry w j).hom
    obtain ⟨p_sym, hp_sym⟩ := hPullEx sym_hom ℓ b
