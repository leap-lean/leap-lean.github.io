        Function.Injective (algebraMap P R_bar) ∧
        Function.Surjective
          ((IsLocalRing.residue R_bar).comp ((algebraMap P R_bar).comp Polynomial.C)) := by
    classical
    intro P R_Δ Ω B_bar R_bar t_bar
    let K₀ := FractionRing P
    have hinj_P_Ω : Function.Injective (algebraMap P Ω) := by
      rw [IsScalarTower.algebraMap_eq P K₀ Ω]
      exact (RingHom.injective (algebraMap K₀ Ω)).comp (IsFractionRing.injective P K₀)
    have hDom_R : IsDomain R_bar :=
      IsLocalization.isDomain_of_le_nonZeroDivisors R_bar M_max.primeCompl_le_nonZeroDivisors
    letI : IsDomain R_bar := hDom_R

    have hB_units : ∀ y : ↥M_max.primeCompl, IsUnit (B_bar.val.toRingHom y.1) := by
