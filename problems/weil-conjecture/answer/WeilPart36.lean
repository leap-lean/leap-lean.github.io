  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_R := (CategoryTheory.constantSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Q_ψ := CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ)
