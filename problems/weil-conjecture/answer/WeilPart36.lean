          change (c_poly.ι.app i₂).hom ((D_poly.map θ₁).hom (y_fn a₀)) =
            (c_poly.ι.app i₂).hom 0
          rw [map_zero]
          have hw := congrArg (fun k_h => k_h.hom (y_fn a₀)) (c_poly.w θ₁)
          exact hw.trans (hy a₀ (Finset.mem_insert_self a₀ S'))
        obtain ⟨i₀, θ₂, hθ₂⟩ :=
          (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hc_type _ _).mp h_eq₀
        have hθ₂' : (D_poly.map θ₂).hom ((D_poly.map θ₁).hom (y_fn a₀)) = 0 := by
          have h₁ : (D_poly.map θ₂).hom ((D_poly.map θ₁).hom (y_fn a₀)) =
              (D_poly.map θ₂).hom 0 := hθ₂
          rwa [map_zero] at h₁
        refine ⟨i₀, θ₁ ≫ θ₂, ?_⟩
        intro a ha
        rw [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · exact hθ₂'
        · rw [hθ₁ a haS', map_zero]
    have hLiftPoly : ∀ {n : ℕ} (p : MvPolynomial (Fin n) ↑c_poly.pt),
