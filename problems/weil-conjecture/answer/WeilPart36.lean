  let f_QR := CategoryTheory.Limits.pullback.snd g_Q.left g_R
  let f_QΩ : Q_R_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    CategoryTheory.Limits.pullback.snd f_QR j_R
  have _ : AlgebraicGeometry.IsOpenImmersion j_Q :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback f_QR j_R).flip hj_open

  
  let k₁ := IsLocalRing.ResidueField R_bar
  let u_R : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R_bar))
  have hu_R_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)),
      u_R.base pt = IsLocalRing.closedPoint R_bar := by
    intro pt
    rw [Subsingleton.elim pt (⊥ : PrimeSpectrum k₁)]
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue R_bar) ⊥ = IsLocalRing.maximalIdeal R_bar
    ext x
    rw [Ideal.mem_comap, Ideal.mem_bot]
    exact Ideal.Quotient.eq_zero_iff_mem
  let u_k : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ S_k :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((IsLocalRing.residue R_bar).comp (p_R.comp Polynomial.C)))
  have huR_eq_uk : u_R ≫ g_R = u_k ≫ s₀ := by
    dsimp [u_R, g_R, u_k, s₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    exact hRes
  have hu_R_cl : AlgebraicGeometry.IsClosedImmersion u_R :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (IsLocalRing.residue R_bar)) IsLocalRing.residue_surjective

  let Q_k1 := CategoryTheory.Limits.pullback g_Q.left (u_R ≫ g_R)
  let fst_Qk1 := CategoryTheory.Limits.pullback.fst g_Q.left (u_R ≫ g_R)
  let f_Qk1 := CategoryTheory.Limits.pullback.snd g_Q.left (u_R ≫ g_R)
  let i_Qk1 : Q_k1 ⟶ Q_R :=
    CategoryTheory.Limits.pullback.lift fst_Qk1 (f_Qk1 ≫ u_R)
