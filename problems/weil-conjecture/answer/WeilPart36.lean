      let e_sec : ∀ U : S_prod.Etale,
          ↥((G.cohomologyPresheaf 0).obj (Opposite.op U)) ≃ ↥(G.obj.obj (Opposite.op U)) :=
        fun U => CategoryTheory.Abelian.Ext.homEquiv₀.trans
