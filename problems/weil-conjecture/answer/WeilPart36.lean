  let adj₁ := adj_X.comp adj_j
  let adj₂ := adj_U.ofNatIsoRight e_sec
  let e_left : (C_X.comp pb_j) ≅ C_U := adj₁.leftAdjointUniq adj₂
  let ιℤ : Fℤ_U ⟶ pb_j.obj Fℤ_X := e_left.inv.app Aℤ
  have h_adj1_equiv : ∀ (m : pb_j.obj Fℤ_X ⟶ Fℤ_U),
      (adj₁.homEquiv Aℤ Fℤ_U) m =
        (adj_X.homEquiv Aℤ (pf_j.obj Fℤ_U)) ((adj_j.homEquiv Fℤ_X Fℤ_U) m) := by
