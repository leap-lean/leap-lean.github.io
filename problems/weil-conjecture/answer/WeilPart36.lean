        ∃ φ_R_Ω : R_bar →+* Ω,
          (∀ b : ↥B_bar, φ_R_Ω (algebraMap ↥B_bar R_bar b) = b.1) ∧
          φ_R_Ω.comp (algebraMap P R_bar) = algebraMap P Ω ∧
