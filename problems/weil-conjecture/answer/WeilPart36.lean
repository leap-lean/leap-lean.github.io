    let ev_sh_std := CategoryTheory.sheafToPresheaf S_sh.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (S_sh.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_sh)
