    let pb_sh := (weilEtaleSitePullback p_sh).sheafPullback AddCommGrpCat.{u}
      Z₀.smallEtaleTopology S_sh.smallEtaleTopology
    have : pb_sh.Additive := (hSite.1 p_sh).1
    have hTorsGsh : (ℓ' + 1) • CategoryTheory.CategoryStruct.id G_sh = 0 := by
      change (ℓ' + 1) • CategoryTheory.CategoryStruct.id (pb_sh.obj G) = 0
      rw [← pb_sh.map_id, ← CategoryTheory.Functor.map_nsmul, hTorsG, pb_sh.map_zero]
    have hTorsGsh_sec : ∀ s : ↥(G_sh.obj.obj (Opposite.op T_sh)), (ℓ' + 1) • s = 0 := by
