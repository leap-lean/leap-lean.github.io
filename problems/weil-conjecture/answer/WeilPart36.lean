      exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_mv c_U_hom inl_mv inr_mv hPush_mv
    let ι_tilde : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin d_rel) A_U)) ⟶ Y_d :=
