    exact ⟨v_k1.base pt_k1, rfl⟩

  
  intro U_line C_Q p_CQ g_R j_R X_R X_R_Ω j_X C_Q_R C_Q_R_Ω j_CQ
  have _ := ht_max
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : PrimeSpectrum k := ⊥
  let P := Polynomial k
  let p_A1 : U_line ⟶ S_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* P))
  let ev0 : P →+* k := Polynomial.evalRingHom 0
  let s₀ : S_k ⟶ U_line := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0)
  have hf₀_k : f₀.left ≫ p_A1 = X₀.hom := CategoryTheory.Over.w f₀
  have hx₀_k : x₀ ≫ X₀.hom = 𝟙 S_k := by
    rw [← hf₀_k, ← Category.assoc, hx₀]
    dsimp [p_A1]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hevC : (Polynomial.evalRingHom (0 : k)).comp Polynomial.C = RingHom.id k := by
      ext c; simp
    rw [hevC, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hm0_ker : RingHom.ker ev0 = Ideal.span ({Polynomial.X} : Set P) := by
    ext p
    rw [RingHom.mem_ker, Ideal.mem_span_singleton]
    change Polynomial.eval 0 p = 0 ↔ Polynomial.X ∣ p
    rw [← Polynomial.IsRoot.def, ← Polynomial.dvd_iff_isRoot, map_zero, sub_zero]
  have hm0_max : (Ideal.span ({Polynomial.X} : Set P)).IsMaximal := by
    rw [← hm0_ker]
    exact RingHom.ker_isMaximal_of_surjective ev0 (fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩)
  obtain ⟨_, R', _u₀, e_B, h, V', v₀, e_Y, q,
    hEt_eB, hEt_eY, hEt_q, _, hv₀_Y,
    ⟨ψ_B, hψB_X, hEt_ψB, _⟩, _, _, hq_h, hRoof₀⟩ := hOdp
  have _ : AlgebraicGeometry.Etale e_B := hEt_eB
  have _ : AlgebraicGeometry.Etale e_Y := hEt_eY
  have _ : AlgebraicGeometry.Etale q := hEt_q
  let R₁ : Type u := ↑R'
  let φ_B_hom : CommRingCat.of P ⟶ R' := AlgebraicGeometry.Spec.preimage e_B
  have hφ_B_map : AlgebraicGeometry.Spec.map φ_B_hom = e_B :=
    AlgebraicGeometry.Spec.map_preimage e_B
  let φ_B : P →+* R₁ := φ_B_hom.hom
  have hφB_et : φ_B.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      (hφ_B_map.symm ▸ hEt_eB)
  have hψB_et : ψ_B.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_ψB
  let σ_idx := Fin (m + 1) × Fin 2
  let I_h : Ideal (MvPolynomial σ_idx R₁) :=
    Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
      MvPolynomial.C h}
  let π_h : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ_idx R₁ ⧸ I_h)) ⟶
      AlgebraicGeometry.Spec R' :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk I_h).comp MvPolynomial.C))
  let u'_0 : PrimeSpectrum R₁ := (q ≫ π_h).base v₀
  let q₀ : Ideal R₁ := u'_0.asIdeal
  have _ : q₀.IsPrime := u'_0.isPrime
  have heB_u'0 : e_B.base u'_0 = s₀.base pt_k := by
    change (q ≫ π_h ≫ e_B).base v₀ = s₀.base pt_k
    rw [← hRoof₀]
    change f₀.left.base (e_Y.base v₀) = s₀.base pt_k
    rw [hv₀_Y]
    change (x₀ ≫ f₀.left).base pt_k = s₀.base pt_k
    rw [hx₀]
  have hq_φ : Ideal.comap φ_B q₀ = Ideal.span {Polynomial.X} := by
    have h1 : Ideal.comap φ_B q₀ = (e_B.base u'_0).asIdeal := by
      rw [← hφ_B_map]; rfl
    have h2 : (s₀.base pt_k).asIdeal = RingHom.ker ev0 := rfl
    rw [h1, heB_u'0, h2, hm0_ker]
  have hq_ψ : Ideal.comap ψ_B q₀ = Ideal.span {Polynomial.X} := by
    have hh_q0 : h ∈ q₀ := hq_h
    have hX_comap : Polynomial.X ∈ Ideal.comap ψ_B q₀ := by
      change ψ_B Polynomial.X ∈ q₀
      rwa [hψB_X]
    have hle : Ideal.span ({Polynomial.X} : Set P) ≤ Ideal.comap ψ_B q₀ :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hX_comap)
    have hprime_ψ : (Ideal.comap ψ_B q₀).IsPrime := u'_0.isPrime.comap ψ_B
    exact (hm0_max.eq_of_le hprime_ψ.ne_top hle).symm
  obtain ⟨v_k, hv_k_pt, hv_k_eY⟩ := hEtaleHensel.1 k e_Y x₀ v₀ hv₀_Y
  let s_R₁ : S_k ⟶ AlgebraicGeometry.Spec R' := v_k ≫ q ≫ π_h
  have hs_R₁_pt : s_R₁.base pt_k = u'_0 := by
    change (q ≫ π_h).base (v_k.base pt_k) = u'_0
    rw [hv_k_pt]
  let χ₁_hom : R' ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage s_R₁
  have hχ₁_map : AlgebraicGeometry.Spec.map χ₁_hom = s_R₁ :=
    AlgebraicGeometry.Spec.map_preimage s_R₁
  let χ₁ : R₁ →+* k := χ₁_hom.hom
  have hχ₁_ker : RingHom.ker χ₁ = q₀ := by
    have h1 : RingHom.ker χ₁ = (s_R₁.base pt_k).asIdeal := by
      rw [← hχ₁_map]; rfl
    rw [h1, hs_R₁_pt]
  have hχ₁_φB : χ₁.comp φ_B = ev0 := by
    have hmap : AlgebraicGeometry.Spec.map (φ_B_hom ≫ χ₁_hom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0) := by
      rw [AlgebraicGeometry.Spec.map_comp, hχ₁_map, hφ_B_map]
      dsimp [s_R₁]
      rw [Category.assoc, Category.assoc, ← hRoof₀, ← Category.assoc, hv_k_eY, hx₀]
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap)
  obtain ⟨g₀, hg₀, u, hu_eq⟩ :=
    hUnramUnit k R₁ q₀ φ_B ψ_B hφB_et hψB_et hq_φ hq_ψ
  rw [hψB_X] at hu_eq
  let S := Localization.Away g₀
  let ρ₁ : R₁ →+* S := algebraMap R₁ S
  have hχ₁_g₀ : IsUnit (χ₁ g₀) := by
    apply Ne.isUnit
    intro h0
    apply hg₀
    rw [← hχ₁_ker]
    exact h0
  let χ_S : S →+* k := IsLocalization.Away.lift (S := S) g₀ hχ₁_g₀
  have hχ_S_comp : χ_S.comp ρ₁ = χ₁ := by
    ext r
    exact IsLocalization.Away.lift_eq (S := S) g₀ hχ₁_g₀ r
  let φ_S : P →+* S := ρ₁.comp φ_B
  have _ : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁ : R' ⟶ CommRingCat.of S)) :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization g₀
  have hφ_S_et : φ_S.Etale := by
    have hSpec_φS : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_S) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁ : R' ⟶ CommRingCat.of S) ≫ e_B := by
      rw [← hφ_B_map, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hEt_Spec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_S)) := by
      rw [hSpec_φS]; infer_instance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      hEt_Spec
  let k₁ := IsLocalRing.ResidueField R_bar
  let res : R_bar →+* k₁ := IsLocalRing.residue R_bar
  let ι_k : k →+* k₁ := res.comp (p_R.comp Polynomial.C)
  let σ_bar : S →+* k₁ := ι_k.comp χ_S
  let Q_S : Ideal S := RingHom.ker σ_bar
  have _ : Q_S.IsPrime := RingHom.ker_isPrime σ_bar
  have hσ_comm : σ_bar.comp φ_S = res.comp p_R := by
    have h1 : χ_S.comp φ_S = ev0 := by
      change (χ_S.comp ρ₁).comp φ_B = ev0
      rw [hχ_S_comp, hχ₁_φB]
    change ι_k.comp (χ_S.comp φ_S) = res.comp p_R
    rw [h1]
    exact hRes.symm
  obtain ⟨f_et, hf_et, σ_tilde, hσ_pR, hσ_res⟩ :=
    hEtaleHensel.2 P S R_bar φ_S hφ_S_et p_R Q_S σ_bar rfl hσ_comm
  let R_fin := Localization.Away f_et
  let ρ₂ : S →+* R_fin := algebraMap S R_fin
  let ρ : R₁ →+* R_fin := ρ₂.comp ρ₁
  let φ_fin : P →+* R_fin := ρ₂.comp φ_S
  have hχS_fet : IsUnit (χ_S f_et) := by
    apply Ne.isUnit
    intro h0
    apply hf_et
    change ι_k (χ_S f_et) = 0
    rw [h0, map_zero]
  let χ_fin : R_fin →+* k := IsLocalization.Away.lift (S := R_fin) f_et hχS_fet
  have hχ_fin_comp : χ_fin.comp ρ₂ = χ_S := by
    ext s
    exact IsLocalization.Away.lift_eq (S := R_fin) f_et hχS_fet s
  have hres_σ_tilde : res.comp σ_tilde = ι_k.comp χ_fin := by
    refine IsLocalization.ringHom_ext (Submonoid.powers f_et) ?_
    rw [hσ_res]
    ext s
    change ι_k (χ_S s) = ι_k ((χ_fin.comp ρ₂) s)
    rw [hχ_fin_comp]
  let u_fin : R_finˣ := Units.map ρ₂.toMonoidHom u
  have hu_fin_eq : ρ h = ↑u_fin * φ_fin Polynomial.X := by
    change ρ₂ (ρ₁ h) = ↑u_fin * ρ₂ (φ_S Polynomial.X)
    rw [hu_eq, map_mul]
    rfl
  have _ : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₂)) :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization f_et
  have hEt_ιfin : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ : R' ⟶ CommRingCat.of R_fin)) := by
    have heq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ : R' ⟶ CommRingCat.of R_fin) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₂) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁ : R' ⟶ CommRingCat.of S) := by
      rw [← AlgebraicGeometry.Spec.map_comp]; rfl
    rw [heq]; infer_instance
  have hFinish : ∀ (A_fin : Type u) [CommRing A_fin]
      (ρ_f : R₁ →+* A_fin) (φ_f : P →+* A_fin) (χ_f : A_fin →+* k)
      (σ_f : A_fin →+* R_bar) (u_f : A_finˣ),
      AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_f : R' ⟶ CommRingCat.of A_fin)) →
      φ_f = ρ_f.comp φ_B →
      χ_f.comp ρ_f = χ₁ →
      σ_f.comp φ_f = p_R →
      res.comp σ_f = ι_k.comp χ_f →
      ρ_f h = ↑u_f * φ_f Polynomial.X →
      ∃ (V_R V_R_Ω : AlgebraicGeometry.Scheme.{u})
        (_ : AlgebraicGeometry.IsAffine V_R)
        (e_XR : V_R ⟶ X_R) (_ : AlgebraicGeometry.Etale e_XR)
        (e_CQR : V_R ⟶ C_Q_R) (_ : AlgebraicGeometry.Etale e_CQR)
        (e_XR_Ω : V_R_Ω ⟶ X_R_Ω) (j_VR : V_R_Ω ⟶ V_R) (e_CQR_Ω : V_R_Ω ⟶ C_Q_R_Ω),
        (∀ z : ↥X_R,
          (CategoryTheory.Limits.pullback.fst f₀.left g_R).base z ∈ Set.range x₀.base →
          (CategoryTheory.Limits.pullback.snd f₀.left g_R).base z =
            IsLocalRing.closedPoint R_bar →
          z ∈ Set.range e_XR.base) ∧
        CategoryTheory.IsPullback e_XR_Ω j_VR j_X e_XR ∧
        CategoryTheory.IsPullback e_CQR_Ω j_VR j_CQ e_CQR := by
    intro A_fin _ ρ_f φ_f χ_f σ_f u_f hEt_ι hφ_eq hχ_eq hσ_eq hres_eq hu_f
    let B := AlgebraicGeometry.Spec (CommRingCat.of A_fin)
    let ι_fin : B ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_f : R' ⟶ CommRingCat.of A_fin)
    have _ : AlgebraicGeometry.Etale ι_fin := hEt_ι
    let e_fin_B : B ⟶ U_line := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_f)
    have he_fin_B_eq : e_fin_B = ι_fin ≫ e_B := by
      dsimp [e_fin_B, ι_fin]
      rw [hφ_eq, ← hφ_B_map, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have _ : AlgebraicGeometry.Etale e_fin_B := by
      rw [he_fin_B_eq]; infer_instance
    let s_B : S_k ⟶ B := AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_f)
    have hs_B_ι : s_B ≫ ι_fin = s_R₁ := by
      rw [← hχ₁_map, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      exact CommRingCat.hom_ext hχ_eq
    have hs_B_eB : s_B ≫ e_fin_B = s₀ := by
      rw [he_fin_B_eq, ← Category.assoc, hs_B_ι]
      dsimp [s_R₁]
      rw [Category.assoc, Category.assoc, ← hRoof₀, ← Category.assoc, hv_k_eY, hx₀]
    let g_tilde_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ B :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_f)
    have hg_tilde_R : g_tilde_R ≫ e_fin_B = g_R := by
      dsimp [g_tilde_R, e_fin_B, g_R]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hσ_eq]
    let u_k : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ S_k :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_k)
    have hu_gtilde : AlgebraicGeometry.Spec.map (CommRingCat.ofHom res) ≫ g_tilde_R =
        u_k ≫ s_B := by
      dsimp [g_tilde_R, u_k, s_B]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hres_eq]
    let W : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback (q ≫ π_h) ι_fin
    let fst_W : W ⟶ V' := CategoryTheory.Limits.pullback.fst (q ≫ π_h) ι_fin
    let q_B : W ⟶ B := CategoryTheory.Limits.pullback.snd (q ≫ π_h) ι_fin
    have _ : AlgebraicGeometry.Etale fst_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (q ≫ π_h) ι_fin).flip inferInstance
    let e_X : W ⟶ X₀.left := fst_W ≫ e_Y
    have _ : AlgebraicGeometry.Etale e_X := by dsimp [e_X]; infer_instance
    have he_X : e_X ≫ f₀.left = q_B ≫ e_fin_B := by
      have hcond : fst_W ≫ (q ≫ π_h) = q_B ≫ ι_fin :=
        CategoryTheory.Limits.pullback.condition
      calc
        e_X ≫ f₀.left = fst_W ≫ (e_Y ≫ f₀.left) := Category.assoc fst_W e_Y f₀.left
        _ = fst_W ≫ ((q ≫ π_h) ≫ e_B) := by rw [hRoof₀]; rfl
        _ = (fst_W ≫ (q ≫ π_h)) ≫ e_B := (Category.assoc _ _ _).symm
        _ = (q_B ≫ ι_fin) ≫ e_B := by rw [hcond]
        _ = q_B ≫ e_fin_B := by rw [Category.assoc, he_fin_B_eq]
    let w_k : S_k ⟶ W :=
      CategoryTheory.Limits.pullback.lift v_k s_B hs_B_ι.symm
    have hw_B : w_k ≫ q_B = s_B := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hw_X : w_k ≫ e_X = x₀ := by
      dsimp [e_X]
      rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hv_k_eY]
    let I_hfin : Ideal (MvPolynomial σ_idx A_fin) :=
      Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C (ρ_f h)}
    let π_hfin : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ_idx A_fin ⧸ I_hfin)) ⟶ B :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_hfin).comp MvPolynomial.C))
    obtain ⟨β₁, hPush₁⟩ := hQuadPushout m R₁ A_fin ρ_f h (ρ_f h) 1 (one_mul (ρ_f h)).symm
    have hPb₁ : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁)) π_hfin π_h ι_fin :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush₁
    let q_fin : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ_idx A_fin ⧸ I_hfin)) :=
      hPb₁.lift (fst_W ≫ q) q_B
        (by rw [Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    have hPb_qfin_outer : CategoryTheory.IsPullback
        (q_fin ≫ π_hfin) fst_W ι_fin (q ≫ π_h) := by
      rw [hPb₁.lift_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (q ≫ π_h) ι_fin).flip
    have hPb_qfin : CategoryTheory.IsPullback
        q_fin fst_W (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁)) q :=
      CategoryTheory.IsPullback.of_right hPb_qfin_outer (hPb₁.lift_fst _ _ _) hPb₁.flip
    have _ : AlgebraicGeometry.Etale q_fin :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_qfin.flip inferInstance
    obtain ⟨β₂, hPush₂⟩ := hQuadPushout m P A_fin φ_f Polynomial.X (ρ_f h) u_f hu_f
    have hPb₂ : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂)) π_hfin p_CQ e_fin_B :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush₂
    have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂)) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb₂.flip inferInstance
    let e_C : W ⟶ C_Q := q_fin ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂)
    have _ : AlgebraicGeometry.Etale e_C := by dsimp [e_C]; infer_instance
    have he_C : e_C ≫ p_CQ = q_B ≫ e_fin_B := by
      dsimp [e_C]
      rw [Category.assoc, hPb₂.w, ← Category.assoc, hPb₁.lift_snd]
    exact hRelRoof k P Polynomial.C X₀.left C_Q f₀.left p_CQ X₀.hom hf₀_k
      s₀ x₀ hx₀ hx₀_k B e_fin_B s_B hs_B_eB W q_B e_X e_C w_k he_X he_C hw_B hw_X
      R_bar p_R Ω φ_R_Ω g_tilde_R hg_tilde_R u_k hu_gtilde
  exact hFinish R_fin ρ φ_fin χ_fin σ_tilde u_fin hEt_ιfin rfl
    (by change (χ_fin.comp ρ₂).comp ρ₁ = χ₁; rw [hχ_fin_comp, hχ_S_comp])
    hσ_pR hres_σ_tilde hu_fin_eq

theorem weil_sing_origin_cosp_coimage_zero_transfer_of_inj (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₀ : X₀ ⟶ CategoryTheory.Over.mk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))))
    [AlgebraicGeometry.IsProper f₀.left]
    (r_deg : ℕ)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar]
    [HenselianLocalRing R_bar] [IsAlgClosed (IsLocalRing.ResidueField R_bar)]
    (p_R : Polynomial k →+* R_bar)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial k)))
    (hφ_comp : φ_R_Ω.comp p_R =
      algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))
    (hj_open : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)))
    (hRes : (IsLocalRing.residue R_bar).comp p_R =
      ((IsLocalRing.residue R_bar).comp (p_R.comp Polynomial.C)).comp
        (Polynomial.evalRingHom 0))
    (hInj_jX :
      let U_line := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
      let g_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ U_line :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_R)
      let j_R : AlgebraicGeometry.Spec
          (CommRingCat.of (AlgebraicClosure (FractionRing (Polynomial k)))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
      let j_X := CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd f₀.left g_R) j_R
      ∀ ψ_r : weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀.left g_R) ℓ r_deg →+
          weilEtaleTorsionH
            (CategoryTheory.Limits.pullback
              (CategoryTheory.Limits.pullback.snd f₀.left g_R) j_R) ℓ r_deg,
        WeilIsTorsionEtalePullback j_X ℓ r_deg ψ_r → Function.Injective ψ_r) :
    let U_line := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0))
    let Ω := AlgebraicClosure (FractionRing (Polynomial k))
    let η : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U_line :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) Ω))
    let G_r := weilEtaleHigherDirectImage f₀.left r_deg (weilEtaleTorsionSheaf X₀.left ℓ)
    let Fℤ_U := (CategoryTheory.constantSheaf U_line.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    ∀ (ψ : Fℤ_U ⟶ G_r),
      (∀ (I_η : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback η
          (CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ)) I_η →
        CategoryTheory.Limits.IsZero I_η) →
      ∀ (I_s : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback s₀
          (CategoryTheory.Limits.cokernel (CategoryTheory.Limits.kernel.ι ψ)) I_s →
        CategoryTheory.Limits.IsZero I_s :=
by
  classical
  
  obtain ⟨_, hConstPB_t, _, _, hTorsSh, _⟩ :=
    weil_etale_pullback_functoriality_and_iso_torsionH ℓ
  obtain ⟨hExPB_ex, _, hCompPB_ex, hConstPB_ex, _, _⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor ℓ
  obtain ⟨hc_all, hr_all, hSite⟩ :=
    weil_etale_site_pullback_rightAdjoint_and_exact_package
  have hSliceIso :=
    weil_etale_slice_cohomology_bijective (@hc_all) (@hr_all) hSite
  have hTorsPull := weil_etale_torsion_pullback_functoriality
  have hAltSlice := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1

  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    @hc_all
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
