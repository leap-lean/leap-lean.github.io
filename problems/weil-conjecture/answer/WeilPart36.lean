      let Y_B := CategoryTheory.Limits.pullback f_Y e_B
      let fst_YB := CategoryTheory.Limits.pullback.fst f_Y e_B
      let snd_YB := CategoryTheory.Limits.pullback.snd f_Y e_B
      have hEt_fstYB : AlgebraicGeometry.Etale fst_YB :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback f_Y e_B).flip inferInstance
      let δ_Y : W' ⟶ Y_B := CategoryTheory.Limits.pullback.lift e'_Y q'_B he'_Y
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have hEt_δY : AlgebraicGeometry.Etale δ_Y :=
        CategoryTheory.MorphismProperty.of_postcomp P_et δ_Y fst_YB hEt_fstYB
          (by rw [CategoryTheory.Limits.pullback.lift_fst]; infer_instance)
      let fst_YR := CategoryTheory.Limits.pullback.fst f_Y g_A
      let snd_YR := CategoryTheory.Limits.pullback.snd f_Y g_A
      let π_YB : Y_R ⟶ Y_B :=
        CategoryTheory.Limits.pullback.lift fst_YR (snd_YR ≫ g_tilde_R)
          (by rw [Category.assoc, hg_tilde_R]; exact CategoryTheory.Limits.pullback.condition)
      have hpb_πYB_outer : CategoryTheory.IsPullback
          (π_YB ≫ fst_YB) snd_YR f_Y (g_tilde_R ≫ e_B) := by
        have h1 : π_YB ≫ fst_YB = fst_YR := CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [h1, hg_tilde_R]
        exact CategoryTheory.IsPullback.of_hasPullback f_Y g_A
      have hpb_πYB : CategoryTheory.IsPullback π_YB snd_YR snd_YB g_tilde_R :=
        CategoryTheory.IsPullback.of_right hpb_πYB_outer
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          (CategoryTheory.IsPullback.of_hasPullback f_Y e_B)
      let e_YR : V_R ⟶ Y_R :=
        CategoryTheory.Limits.pullback.lift (fst_VR ≫ e'_Y) p_VR
          (by
            rw [Category.assoc, he'_Y, ← Category.assoc,
              CategoryTheory.Limits.pullback.condition, Category.assoc, hg_tilde_R])
      have he_YR_fst : e_YR ≫ fst_YR = fst_VR ≫ e'_Y :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have he_YR_snd : e_YR ≫ snd_YR = p_VR :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_eYR_outer : CategoryTheory.IsPullback
          (e_YR ≫ snd_YR) fst_VR g_tilde_R (δ_Y ≫ snd_YB) := by
        have h2 : δ_Y ≫ snd_YB = q'_B := CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [he_YR_snd, h2]
        exact (CategoryTheory.IsPullback.of_hasPullback q'_B g_tilde_R).flip
      have he_YR_π : e_YR ≫ π_YB = fst_VR ≫ δ_Y := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, he_YR_fst,
            Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
            he_YR_snd, Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.condition]
      have hpb_eYR : CategoryTheory.IsPullback e_YR fst_VR π_YB δ_Y :=
        CategoryTheory.IsPullback.of_right hpb_eYR_outer he_YR_π hpb_πYB.flip
      have hEt_eYR : AlgebraicGeometry.Etale e_YR :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpb_eYR.flip hEt_δY
      let snd_YRΩ := CategoryTheory.Limits.pullback.snd snd_YR j_A
      let e_YR_Ω : V_R_Ω ⟶ Y_R_Ω :=
        CategoryTheory.Limits.pullback.lift (j_VR ≫ e_YR) p_VR_Ω
          (by rw [Category.assoc, he_YR_snd]; exact CategoryTheory.Limits.pullback.condition)
      have hpb_Ω_outer : CategoryTheory.IsPullback
          (e_YR_Ω ≫ snd_YRΩ) j_VR j_A (e_YR ≫ snd_YR) := by
        have h3 : e_YR_Ω ≫ snd_YRΩ = p_VR_Ω := CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [h3, he_YR_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback p_VR j_A).flip
      have hpb_Ω : CategoryTheory.IsPullback e_YR_Ω j_VR j_Y e_YR :=
        CategoryTheory.IsPullback.of_right hpb_Ω_outer
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.IsPullback.of_hasPullback snd_YR j_A).flip
      exact ⟨e_YR, hEt_eYR, e_YR_Ω, he_YR_fst, he_YR_snd, hpb_Ω⟩
    obtain ⟨e_XR, hEt_XR, e_XR_Ω, he_XR_fst, he_XR_snd, hSq_X⟩ :=
      hLeg X f_X e'_X (by dsimp [e'_X, q'_B]; rw [Category.assoc, he_X, Category.assoc])
    obtain ⟨e_CR, hEt_CR, e_CR_Ω, _, _, hSq_C⟩ :=
      hLeg C f_C e'_C (by dsimp [e'_C, q'_B]; rw [Category.assoc, he_C, Category.assoc])
    refine ⟨V_R, V_R_Ω, hAff_VR, e_XR, hEt_XR, e_CR, hEt_CR, e_XR_Ω, j_VR, e_CR_Ω,
      ?_, hSq_X, hSq_C⟩
    let k₁ := IsLocalRing.ResidueField A_bar
    let u_R : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue A_bar))
    have hv_k1_comm : (u_k ≫ w'_k) ≫ q'_B = u_R ≫ g_tilde_R := by
      dsimp [q'_B, u_R]
      rw [Category.assoc, ← Category.assoc w'_k, hw'_fac, hw_B, hu_gtilde]
    let v_k1 : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ V_R :=
      CategoryTheory.Limits.pullback.lift (u_k ≫ w'_k) u_R hv_k1_comm
    let pt_k1 : PrimeSpectrum k₁ := ⊥
    let z₀ : ↥X_A := e_XR.base (v_k1.base pt_k1)
    let fst_XR := CategoryTheory.Limits.pullback.fst f_X g_A
    let snd_XR := CategoryTheory.Limits.pullback.snd f_X g_A
    have hz₀_fst : fst_XR.base z₀ = x_pt.base pt_k := by
      have hcomp : v_k1 ≫ e_XR ≫ fst_XR = u_k ≫ x_pt := by
        rw [he_XR_fst]
        dsimp [e'_X]
        rw [← Category.assoc v_k1, CategoryTheory.Limits.pullback.lift_fst,
          Category.assoc, ← Category.assoc w'_k, hw'_fac, hw_X]
      change (v_k1 ≫ e_XR ≫ fst_XR).base pt_k1 = x_pt.base pt_k
      rw [hcomp]
      change x_pt.base (u_k.base pt_k1) = x_pt.base pt_k
      rw [Subsingleton.elim (u_k.base pt_k1) pt_k]
    have hz₀_snd : snd_XR.base z₀ = IsLocalRing.closedPoint A_bar := by
      have hcomp : v_k1 ≫ e_XR ≫ snd_XR = u_R := by
        rw [he_XR_snd]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      have huR_pt : u_R.base pt_k1 = IsLocalRing.closedPoint A_bar := by
        apply PrimeSpectrum.ext
        change Ideal.comap (IsLocalRing.residue A_bar) ⊥ = IsLocalRing.maximalIdeal A_bar
        ext r
        rw [Ideal.mem_comap, Ideal.mem_bot]
        exact Ideal.Quotient.eq_zero_iff_mem
      change (v_k1 ≫ e_XR ≫ snd_XR).base pt_k1 = IsLocalRing.closedPoint A_bar
      rw [hcomp, huR_pt]
    intro z hz_range hz_closed
    rcases hz_range with ⟨pt_z, hpt_z⟩
    rw [Subsingleton.elim pt_z pt_k] at hpt_z
    have hz_fst : fst_XR.base z = x_pt.base pt_k := hpt_z.symm
    obtain ⟨W_X, hAff_WX, hx₀_WX, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := x_pt.base pt_k) (U := (⊤ : X.Opens)) trivial
    let R_WX : CommRingCat.{u} := X.presheaf.obj (Opposite.op W_X)
    let A_X : Type u := ↑R_WX
    let j_WX : AlgebraicGeometry.Spec R_WX ⟶ X := hAff_WX.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion j_WX := hAff_WX.isOpenImmersion_fromSpec
    have hx₀_jWX : Set.range x_pt.base ⊆ Set.range j_WX.base := by
      rintro _ ⟨pt, rfl⟩
      rw [Subsingleton.elim pt pt_k]
      exact ⟨hAff_WX.primeIdealOf ⟨x_pt.base pt_k, hx₀_WX⟩,
        hAff_WX.fromSpec_primeIdealOf ⟨x_pt.base pt_k, hx₀_WX⟩⟩
    let x_tilde_0 : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ AlgebraicGeometry.Spec R_WX :=
