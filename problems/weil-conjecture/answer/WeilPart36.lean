        WeilIsTorsionEtalePullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ i))) ℓ 0 p_i →
        Function.Bijective p_i) →
      ∀ (Ψ : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (∀ i : Fin n, R i))) ℓ 0 →+
          weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (∀ i : Fin n, R' i))) ℓ 0),
