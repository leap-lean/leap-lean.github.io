  have hi_Qk1_fst : i_Qk1 ≫ fst_QR = fst_Qk1 :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hi_Qk1_snd : i_Qk1 ≫ f_QR = f_Qk1 ≫ u_R :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_Qk1_outer :
      CategoryTheory.IsPullback (i_Qk1 ≫ fst_QR) f_Qk1 g_Q.left (u_R ≫ g_R) := by
    rw [hi_Qk1_fst]
    exact CategoryTheory.IsPullback.of_hasPullback g_Q.left (u_R ≫ g_R)
  have hpb_Qk1 : CategoryTheory.IsPullback i_Qk1 f_Qk1 f_QR u_R :=
    CategoryTheory.IsPullback.of_right hpb_Qk1_outer hi_Qk1_snd
      (CategoryTheory.IsPullback.of_hasPullback g_Q.left g_R)
  have _ : AlgebraicGeometry.IsClosedImmersion i_Qk1 :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Qk1.flip hu_R_cl

  have ho₀_uR : (u_k ≫ o₀ ≫ ι_affQ) ≫ g_Q.left =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁)) ≫ (u_R ≫ g_R) := by
    rw [Category.id_comp, Category.assoc, Category.assoc, hQ1.1, hQ1.2.1, huR_eq_uk]
  let σ_o₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ Q_k1 :=
    CategoryTheory.Limits.pullback.lift (u_k ≫ o₀ ≫ ι_affQ) (𝟙 _) ho₀_uR
  have hσ_fst : σ_o₀ ≫ fst_Qk1 = u_k ≫ o₀ ≫ ι_affQ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hσ_sec : σ_o₀ ≫ f_Qk1 = 𝟙 _ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have _ : AlgebraicGeometry.IsSeparated f_Qk1 :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_Q.left (u_R ≫ g_R)) inferInstance
  have _ : AlgebraicGeometry.IsClosedImmersion σ_o₀ := by
    let Δ : Q_k1 ⟶ CategoryTheory.Limits.pullback f_Qk1 f_Qk1 :=
      CategoryTheory.Limits.pullback.diagonal f_Qk1
    have hΔ : AlgebraicGeometry.IsClosedImmersion Δ := inferInstance
    let γ : Q_k1 ⟶ CategoryTheory.Limits.pullback f_Qk1 f_Qk1 :=
      CategoryTheory.Limits.pullback.lift (𝟙 Q_k1) (f_Qk1 ≫ σ_o₀)
        (by rw [Category.id_comp, Category.assoc, hσ_sec, Category.comp_id])
    have hcomm : σ_o₀ ≫ Δ = σ_o₀ ≫ γ := by
      dsimp [Δ, γ]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Limits.pullback.lift_fst]
      · rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Limits.pullback.lift_snd, Category.comp_id,
          ← Category.assoc, hσ_sec, Category.id_comp]
    have hlim : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.PullbackCone.mk σ_o₀ σ_o₀ hcomm) := by
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm (fun s => s.fst ≫ f_Qk1) ?_ ?_ ?_
      · intro s
        have h1 : (s.fst ≫ Δ) ≫ CategoryTheory.Limits.pullback.fst f_Qk1 f_Qk1 =
            (s.snd ≫ γ) ≫ CategoryTheory.Limits.pullback.fst f_Qk1 f_Qk1 :=
          congrArg (· ≫ CategoryTheory.Limits.pullback.fst f_Qk1 f_Qk1) s.condition
        have h2 : (s.fst ≫ Δ) ≫ CategoryTheory.Limits.pullback.snd f_Qk1 f_Qk1 =
            (s.snd ≫ γ) ≫ CategoryTheory.Limits.pullback.snd f_Qk1 f_Qk1 :=
          congrArg (· ≫ CategoryTheory.Limits.pullback.snd f_Qk1 f_Qk1) s.condition
        dsimp [Δ, γ] at h1 h2
        simp only [Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_snd, Category.comp_id] at h1 h2
        rw [Category.assoc, h1, ← h2]
        exact h1
      · intro s
        have h1 : (s.fst ≫ Δ) ≫ CategoryTheory.Limits.pullback.fst f_Qk1 f_Qk1 =
            (s.snd ≫ γ) ≫ CategoryTheory.Limits.pullback.fst f_Qk1 f_Qk1 :=
          congrArg (· ≫ CategoryTheory.Limits.pullback.fst f_Qk1 f_Qk1) s.condition
        have h2 : (s.fst ≫ Δ) ≫ CategoryTheory.Limits.pullback.snd f_Qk1 f_Qk1 =
            (s.snd ≫ γ) ≫ CategoryTheory.Limits.pullback.snd f_Qk1 f_Qk1 :=
          congrArg (· ≫ CategoryTheory.Limits.pullback.snd f_Qk1 f_Qk1) s.condition
        dsimp [Δ, γ] at h1 h2
        simp only [Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_snd, Category.comp_id] at h1 h2
        rw [Category.assoc, h1, ← h2]
        exact h1
      · intro s m_hom hm _
        calc
          m_hom = m_hom ≫ 𝟙 _ := (Category.comp_id m_hom).symm
          _ = m_hom ≫ (σ_o₀ ≫ f_Qk1) := by rw [hσ_sec]
          _ = (m_hom ≫ σ_o₀) ≫ f_Qk1 := (Category.assoc m_hom σ_o₀ f_Qk1).symm
          _ = s.fst ≫ f_Qk1 := by rw [hm]
    have hpb_σ : CategoryTheory.IsPullback σ_o₀ σ_o₀ Δ γ :=
      CategoryTheory.IsPullback.of_isLimit hlim
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_σ hΔ

  let i_o₀ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ Q_R := σ_o₀ ≫ i_Qk1
  have _ : AlgebraicGeometry.IsClosedImmersion i_o₀ := by
    dsimp [i_o₀]
    infer_instance
  have hi_o₀_fst : i_o₀ ≫ fst_QR = u_k ≫ o₀ ≫ ι_affQ := by
    dsimp [i_o₀]
    rw [Category.assoc, hi_Qk1_fst, hσ_fst]
  have hi_o₀_snd : i_o₀ ≫ f_QR = u_R := by
    dsimp [i_o₀]
