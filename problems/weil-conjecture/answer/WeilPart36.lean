      have hexact_mid : ∀ x : ZMod (ℓ ^ (r' + 2)), π x = 0 → ∃ a : ZMod ℓ, μ a = x := by
        intro x hx
        have hx_cast : ((x.val : ℕ) : ZMod (ℓ ^ (r' + 1))) = 0 := by
          have h1 : ZMod.castHom hdvd (ZMod (ℓ ^ (r' + 1)))
