    have hJ_mat₀_eq : P_pre₀.jacobiMatrix = J_mat₀ := by
      refine Matrix.ext fun s₁ s₂ => ?_
      exact Algebra.PreSubmersivePresentation.jacobiMatrix_naive (v := R₀)
        P₀.map P₀.map_inj s₀ hs₀ s₁ s₂
