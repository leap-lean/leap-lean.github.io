      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ A_R) [AlgebraicGeometry.Etale w]
        (ψ₀ : weilEtaleTorsionH W ℓ 0 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_A w) ℓ 0),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd j_A w) ℓ 0 ψ₀ →
        Function.Bijective ψ₀)
    (hZero_A :
      let S_d := weilAffineSpaceOver k (2 * m + 1)
      let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
