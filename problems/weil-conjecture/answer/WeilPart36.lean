    obtain ⟨i₀, θ_jac, hθ_zero⟩ := hZeroSet₀ Δ₁.support i₁ (fun m => Δ₁.coeff m) hΔ₁_coeff
    have hΔ₀ : MvPolynomial.map (D_poly.map θ_jac).hom Δ₁ = 0 := by
