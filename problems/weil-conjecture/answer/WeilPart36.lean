    let α_ext : F_X.H i → (pf_j.obj F_U).H i :=
      fun x => x.comp (CategoryTheory.Abelian.Ext.mk₀ α_j) (Nat.add_zero i)
    let inv_α_ext : (pf_j.obj F_U).H i → F_X.H i :=
      fun z => z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv α_j)) (Nat.add_zero i)
