    have hp_Bga_comp : WeilIsTorsionEtalePullback ((β_a ≫ fst_ua) ≫ sym_inv) ℓ b p_Bga :=
      Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ b p_Bga) hTriBwd.symm) hp_Bga
    have hp_Bga_eq : p_Bga = p_comp.comp p_sym_inv :=
      hPullComp (β_a ≫ fst_ua) sym_inv ℓ b p_comp p_sym_inv p_Bga hp_comp hp_sym_inv hp_Bga_comp
