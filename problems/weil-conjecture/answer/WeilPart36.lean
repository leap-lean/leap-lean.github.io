  have hConj3 : CategoryTheory.Mono α_j →
      (∀ (ψ₀ : weilEtaleTorsionH X ℓ 0 →+ weilEtaleTorsionH X_U ℓ 0),
        WeilIsTorsionEtalePullback j ℓ 0 ψ₀ → Function.Surjective ψ₀) →
      (∀ (ψ₁ : weilEtaleTorsionH X ℓ 1 →+ weilEtaleTorsionH X_U ℓ 1),
