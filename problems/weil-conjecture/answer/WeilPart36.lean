  let P := Polynomial k
  let p_Δ_k : U_Δ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((algebraMap P R_Δ).comp Polynomial.C))
  let U_Δ_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk p_Δ_k
  have : AlgebraicGeometry.LocallyOfFiniteType U_Δ_ov.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType p_Δ_k
    have hfac : p_Δ_k =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R_Δ)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* P)) := by
      dsimp [p_Δ_k]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hfac]
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R_Δ))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization Δ₀
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* P))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr
        (RingHom.finiteType_algebraMap.mpr (inferInstance : Algebra.FiniteType k P))
    infer_instance

  have hSepRes : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      IsSepClosed (IsLocalRing.ResidueField K) := by
    intro K _ _
    let e : K ≃+* IsLocalRing.ResidueField K :=
      RingEquiv.ofBijective (IsLocalRing.residue K)
        ⟨RingHom.injective (IsLocalRing.residue K), Ideal.Quotient.mk_surjective⟩
    have : IsAlgClosed (IsLocalRing.ResidueField K) :=
      IsAlgClosed.of_exists_root _ fun p _ hirr => by
        let p₀ : Polynomial K := p.map e.symm.toRingHom
        have hp₀_deg : p₀.degree ≠ 0 := by
          rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
          exact ne_of_gt (Irreducible.degree_pos hirr)
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p₀ hp₀_deg
        refine ⟨e c, ?_⟩
        have hev : Polynomial.eval c p₀ = e.symm (Polynomial.eval (e c) p) := by
          dsimp [p₀]
          rw [Polynomial.eval_map]
          conv_lhs => rw [← e.symm_apply_apply c]
          exact (Polynomial.hom_eval₂ p (RingHom.id _) e.symm.toRingHom (e c)).symm
        simpa using congrArg e (hev.symm.trans hc)
    infer_instance

  let k₁ : Type u := IsLocalRing.ResidueField R_bar
  let S_k₁ := AlgebraicGeometry.Spec (CommRingCat.of k₁)
  let S_R := AlgebraicGeometry.Spec (CommRingCat.of R_bar)
  let S_sh := AlgebraicGeometry.Spec (CommRingCat.of R_sh)
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let u_R : S_k₁ ⟶ S_R :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R_bar))
  let u_k : S_k₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      ((IsLocalRing.residue R_bar).comp
        ((p_Δ_R.comp (algebraMap P R_Δ)).comp Polynomial.C)))
  let g_Δ_R : S_R ⟶ U_Δ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_Δ_R)
  let j_R : S_Ω ⟶ S_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
  let π_sh : S_R ⟶ S_sh := AlgebraicGeometry.Spec.map ι_sh
  let g_sh : S_sh ⟶ U_Δ := AlgebraicGeometry.Spec.map f_sh

  have hu_R_g : u_R ≫ g_Δ_R = u_k ≫ s₀_Δ := by
    have h1 : u_R ≫ g_Δ_R =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((IsLocalRing.residue R_bar).comp p_Δ_R)) := by
      dsimp [u_R, g_Δ_R]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h2 : u_k ≫ s₀_Δ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (((IsLocalRing.residue R_bar).comp
            ((p_Δ_R.comp (algebraMap P R_Δ)).comp Polynomial.C)).comp ev₀)) := by
      dsimp [u_k, s₀_Δ]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact h1.trans
      ((congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) hRes).trans h2.symm)

  have hu_R_pt : ∀ pt : ↥S_k₁, u_R.base pt = IsLocalRing.closedPoint R_bar := by
    intro pt
    have hpt : pt = (⊥ : PrimeSpectrum k₁) := Subsingleton.elim pt _
    rw [hpt]
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue R_bar) ⊥ = IsLocalRing.maximalIdeal R_bar
    exact IsLocalRing.ker_residue

  have hu_k_pt : ∀ pt : ↥S_k₁,
      u_k.base pt = IsLocalRing.closedPoint k :=
    fun pt => Subsingleton.elim (u_k.base pt) (IsLocalRing.closedPoint k)

  have hu_sh_pt : ∀ pt : ↥S_k₁,
      (u_R ≫ π_sh).base pt = IsLocalRing.closedPoint R_sh := by
    intro pt
    change π_sh.base (u_R.base pt) = IsLocalRing.closedPoint R_sh
    rw [hu_R_pt pt]
    apply PrimeSpectrum.ext
    ext x
    exact hMax_sh x

  
  have hClause1 : Nat.card (weilEtaleTorsionH X_s₀ ℓ q) =
      Nat.card (weilEtaleTorsionH X_η ℓ q) := by
    have : HenselianLocalRing k := Field.henselian k
    have : IsSepClosed (IsLocalRing.ResidueField k) := hSepRes k
    have hCard_k : Nat.card (weilEtaleTorsionH
          (CategoryTheory.Limits.pullback f₀.left (u_k ≫ s₀_Δ)) ℓ q) =
        Nat.card (weilEtaleTorsionH X_s₀ ℓ q) :=
      hPbcHensCard U_Δ_ov X₀ f₀ inferInstance k s₀_Δ k₁ u_k hu_k_pt q
    have hCard_R : Nat.card (weilEtaleTorsionH
          (CategoryTheory.Limits.pullback f₀.left (u_R ≫ g_Δ_R)) ℓ q) =
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀.left g_Δ_R) ℓ q) :=
      hPbcHensCard U_Δ_ov X₀ f₀ inferInstance R_bar g_Δ_R k₁ u_R hu_R_pt q
    have hCard_s0_R : Nat.card (weilEtaleTorsionH X_s₀ ℓ q) =
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀.left g_Δ_R) ℓ q) := by
      rw [← hCard_k, ← hu_R_g, hCard_R]
    let j_X := CategoryTheory.Limits.pullback.fst
      (CategoryTheory.Limits.pullback.snd f₀.left g_Δ_R) j_R
    obtain ⟨ψ_q, hψ_q⟩ := hTorsEx j_X ℓ q
    have hCard_R_RΩ :
        Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀.left g_Δ_R) ℓ q) =
        Nat.card (weilEtaleTorsionH
          (CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd f₀.left g_Δ_R) j_R) ℓ q) :=
      Nat.card_congr (Equiv.ofBijective ψ_q (hBij_jX ψ_q hψ_q))
    have hj_g_η : j_R ≫ g_Δ_R = η_Δ := by
      dsimp [j_R, g_Δ_R, η_Δ]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_comp]
    have hpb_paste : CategoryTheory.IsPullback
        (j_X ≫ CategoryTheory.Limits.pullback.fst f₀.left g_Δ_R)
        (CategoryTheory.Limits.pullback.snd
          (CategoryTheory.Limits.pullback.snd f₀.left g_Δ_R) j_R)
        f₀.left η_Δ := by
      rw [← hj_g_η]
      exact (CategoryTheory.IsPullback.of_hasPullback
        (CategoryTheory.Limits.pullback.snd f₀.left g_Δ_R) j_R).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f₀.left g_Δ_R)
    obtain ⟨e_Hη⟩ := hPbcIsoH hpb_paste.isoPullback q
    exact hCard_s0_R.trans (hCard_R_RΩ.trans (Nat.card_congr e_Hη.toEquiv))

  refine ⟨hClause1, fun hFin => ?_⟩

  
  have hUniquePB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (G₁ G₂ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F G₁ →
      WeilIsEtaleSheafPullback h F G₂ →
      Nonempty (G₁ ≅ G₂) := by
    rintro X₁ X₂ h F G₁ G₂ ⟨_, _, ⟨e₁⟩⟩ ⟨_, _, ⟨e₂⟩⟩
    exact ⟨e₁.symm ≪≫ e₂⟩

  have hIsoH0 : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {H₁ H₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}},
      (H₁ ≅ H₂) → Nonempty (H₁.H 0 ≃+ H₂.H 0) := by
    intro Y H₁ H₂ e
    let T_Y := weilEtaleIdTerminal.{u} Y
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let e₁ : H₁.H 0 ≃+ ↥(H₁.obj.obj (Opposite.op T_Y)) := CategoryTheory.Sheaf.H.equiv₀ H₁ hT_Y
    let e₂ : H₂.H 0 ≃+ ↥(H₂.obj.obj (Opposite.op T_Y)) := CategoryTheory.Sheaf.H.equiv₀ H₂ hT_Y
    let e_mid : ↥(H₁.obj.obj (Opposite.op T_Y)) ≃+ ↥(H₂.obj.obj (Opposite.op T_Y)) :=
      { toFun := e.hom.hom.app (Opposite.op T_Y)
        invFun := e.inv.hom.app (Opposite.op T_Y)
        left_inv := fun s =>
          congrArg (fun ν : H₁ ⟶ H₁ => (ν.hom.app (Opposite.op T_Y)) s) e.hom_inv_id
        right_inv := fun t =>
          congrArg (fun ν : H₂ ⟶ H₂ => (ν.hom.app (Opposite.op T_Y)) t) e.inv_hom_id
        map_add' := map_add (e.hom.hom.app (Opposite.op T_Y)).hom }
    exact ⟨e₁.trans (e_mid.trans e₂.symm)⟩

  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have hSheafifyBijOfTopSieve : ∀ {S : AlgebraicGeometry.Scheme.{u}} (V : S.Etale),
      (∀ R ∈ S.smallEtaleTopology V, R.arrows (𝟙 V)) →
      ∀ (P_pre : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}),
        Function.Bijective
          ((CategoryTheory.toSheafify S.smallEtaleTopology P_pre).app (Opposite.op V)) := by
    intro S V hTop P_pre
    let η := CategoryTheory.toSheafify S.smallEtaleTopology P_pre
    constructor
    · intro x y hxy
      have hmem : CategoryTheory.Presheaf.equalizerSieve x y ∈ S.smallEtaleTopology V :=
        CategoryTheory.Presheaf.equalizerSieve_mem S.smallEtaleTopology η x y hxy
      have hid : (P_pre.map (𝟙 (Opposite.op V))) x = (P_pre.map (𝟙 (Opposite.op V))) y :=
        hTop _ hmem
      have hx : (P_pre.map (𝟙 (Opposite.op V))) x = x :=
        congrArg (fun g => g x) (P_pre.map_id (Opposite.op V))
      have hy : (P_pre.map (𝟙 (Opposite.op V))) y = y :=
        congrArg (fun g => g y) (P_pre.map_id (Opposite.op V))
      exact hx.symm.trans (hid.trans hy)
    · intro s
      have hmem : CategoryTheory.Presheaf.imageSieve η s ∈ S.smallEtaleTopology V :=
        CategoryTheory.Presheaf.imageSieve_mem S.smallEtaleTopology η s
      obtain ⟨x, hx⟩ := hTop _ hmem
      exact ⟨x, hx.trans (congrArg (fun g => g s)
        ((CategoryTheory.sheafify S.smallEtaleTopology P_pre).map_id (Opposite.op V)))⟩

  have hBijRight : ∀ {α β γ : Type u} {f : β → γ} {g : α → β},
      Function.Bijective g → Function.Bijective (f ∘ g) → Function.Bijective f := by
    intro α β γ f g hg hfg
    refine ⟨fun b₁ b₂ hb => ?_, fun c => ?_⟩
    · obtain ⟨a₁, rfl⟩ := hg.2 b₁
      obtain ⟨a₂, rfl⟩ := hg.2 b₂
      have h1 : (f ∘ g) a₁ = (f ∘ g) a₂ := hb
      rw [hfg.1 h1]
    · obtain ⟨a, ha⟩ := hfg.2 c
      exact ⟨g a, ha⟩

  have hAlgClosedEtaleSec : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (Y : AlgebraicGeometry.Scheme.{u})
      (f : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)) [AlgebraicGeometry.Etale f]
      (x : ↥Y),
      ∃ (σ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Y),
        AlgebraicGeometry.Etale σ ∧
        σ ≫ f = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ∧
        σ.base (⊥ : PrimeSpectrum K) = x := by
    intro K _ _ Y f _ x
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    obtain ⟨V_x, hAffV, hxV, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := x) (U := (⊤ : Y.Opens)) trivial
    let R_V : CommRingCat.{u} := Y.presheaf.obj (Opposite.op V_x)
    let B : Type u := ↑R_V
    let p_x : PrimeSpectrum B := hAffV.isoSpec.hom.base ⟨x, hxV⟩
    let j_V : AlgebraicGeometry.Spec R_V ⟶ Y := hAffV.isoSpec.inv ≫ V_x.ι
    have hj_V_pt : j_V.base p_x = x := by
      dsimp [j_V, p_x]
      have h1 : hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩) = ⟨x, hxV⟩ := by
        change (hAffV.isoSpec.hom ≫ hAffV.isoSpec.inv).base ⟨x, hxV⟩ = ⟨x, hxV⟩
        rw [hAffV.isoSpec.hom_inv_id]
        rfl
      change V_x.ι.base (hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩)) = x
      rw [h1]
      rfl
    have : AlgebraicGeometry.Etale j_V := by dsimp [j_V]; infer_instance
    let φ_KB : CommRingCat.of K ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_V ≫ f)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_KB = j_V ≫ f :=
      AlgebraicGeometry.Spec.map_preimage (j_V ≫ f)
    have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_KB) := by
      rw [hSpec_φ]; infer_instance
    have hEt_hom : φ_KB.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec
    let _ : Algebra K B := φ_KB.hom.toAlgebra
    have : Algebra.Etale K B := RingHom.etale_algebraMap.mp hEt_hom
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K B).mp inferInstance
    have : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra K (L i) := hAlgL
    have hex_i₀ : ∃ i₀ : I, Θ.symm (Pi.single i₀ 1) ∉ p_x.asIdeal := by
      by_contra! hall
      have hsum1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j; simp [Finset.sum_apply]
      have hB1 : (1 : B) = ∑ i : I, Θ.symm (Pi.single i 1) := by
        calc (1 : B) = Θ.symm 1 := (map_one Θ.symm).symm
          _ = ∑ i : I, Θ.symm (Pi.single i 1) := by rw [hsum1, map_sum]
      have hmem1 : (1 : B) ∈ p_x.asIdeal := by
        rw [hB1]
        exact Ideal.sum_mem p_x.asIdeal (fun i _ => hall i)
      exact p_x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hmem1)
    obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
    have hSurj_i₀ : Function.Surjective (algebraMap K (L i₀)) := by
      intro y
      have : Module.Finite K (L i₀) := (hFinSep i₀).1
      have hy_int : _root_.IsIntegral K y := Algebra.IsIntegral.isIntegral y
      let m := minpoly K y
      have hm_deg : m.degree ≠ 0 :=
        ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_root m hm_deg
      obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
      have hq_unit : IsUnit q_pol :=
        ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
          (Polynomial.not_isUnit_X_sub_C c)
      have hq_monic : q_pol.Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
          (hq_pol ▸ minpoly.monic hy_int)
      have hq1 : q_pol = 1 := by
        have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
        have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
        rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
      have hm_eq : m = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
      have haeval : Polynomial.aeval y m = 0 := minpoly.aeval K y
      rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
      exact ⟨c, haeval.symm⟩
    let e_L : K ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap K (L i₀)) ⟨RingHom.injective _, hSurj_i₀⟩
    let χ : B →+* K :=
      e_L.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom)
    have hχ_comp : φ_KB ≫ CommRingCat.ofHom χ = 𝟙 (CommRingCat.of K) := by
      apply CommRingCat.hom_ext
      ext c
      change e_L.symm (Θ (algebraMap K B c) i₀) = c
      rw [Θ.commutes]
      exact e_L.symm_apply_apply c
    have hker_χ : RingHom.ker χ = p_x.asIdeal := by
      ext b
      rw [RingHom.mem_ker]
      have hχ_zero_iff : χ b = 0 ↔ Θ b i₀ = 0 := by
        change e_L.symm (Θ b i₀) = 0 ↔ Θ b i₀ = 0
        exact ⟨fun h => by simpa using congrArg e_L h, fun h => by simp [h]⟩
      rw [hχ_zero_iff]
      have hprod0 : Θ.symm (Pi.single i₀ 1) * (b - Θ.symm (Pi.single i₀ (Θ b i₀))) = 0 := by
        apply Θ.injective
        rw [map_mul, map_sub, Θ.apply_symm_apply, Θ.apply_symm_apply, map_zero]
        ext j
        by_cases hj : j = i₀
        · subst hj; simp
        · simp [Pi.single_eq_of_ne hj]
      have hdiff_mem : b - Θ.symm (Pi.single i₀ (Θ b i₀)) ∈ p_x.asIdeal := by
        have hmem0 : Θ.symm (Pi.single i₀ 1) * (b - Θ.symm (Pi.single i₀ (Θ b i₀))) ∈
            p_x.asIdeal := by
          rw [hprod0]; exact p_x.asIdeal.zero_mem
        exact (p_x.isPrime.mem_or_mem hmem0).resolve_left hi₀_not_mem
      constructor
      · intro hb0
        rw [hb0, Pi.single_zero, map_zero, sub_zero] at hdiff_mem
        exact hdiff_mem
      · intro hbp
        by_contra hne0
        have hsingle_mem : Θ.symm (Pi.single i₀ (Θ b i₀)) ∈ p_x.asIdeal := by
          have hsub := p_x.asIdeal.sub_mem hbp hdiff_mem
          simpa using hsub
        have hinv_prod : Θ.symm (Pi.single i₀ (Θ b i₀)) * Θ.symm (Pi.single i₀ (Θ b i₀)⁻¹) =
            Θ.symm (Pi.single i₀ 1) := by
          rw [← map_mul]
          congr 1
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [mul_inv_cancel₀ hne0]
          · simp [Pi.single_eq_of_ne hj]
        exact hi₀_not_mem (hinv_prod ▸ p_x.asIdeal.mul_mem_right _ hsingle_mem)
    let σ : S_K ⟶ Y := AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫ j_V
    have hσ_hom : σ ≫ f = 𝟙 S_K := by
      dsimp [σ]
      rw [Category.assoc, ← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp, hχ_comp,
        AlgebraicGeometry.Spec.map_id]
    have hf_et : (@AlgebraicGeometry.Etale) f := inferInstance
    have hσ_et : AlgebraicGeometry.Etale σ :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) σ f hf_et
        (by rw [hσ_hom]; infer_instance)
    refine ⟨σ, hσ_et, hσ_hom, ?_⟩
    have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base (⊥ : PrimeSpectrum K) =
        p_x := by
      apply PrimeSpectrum.ext
      change Ideal.comap χ ⊥ = p_x.asIdeal
      exact hker_χ
    change j_V.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base
      (⊥ : PrimeSpectrum K)) = x
    rw [hpt_eq, hj_V_pt]

  have hTopHensel : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsAlgClosed (IsLocalRing.ResidueField R)],
      let Z_R := AlgebraicGeometry.Spec (CommRingCat.of R)
      ∀ S_sieve ∈ Z_R.smallEtaleTopology (weilEtaleIdTerminal.{u} Z_R),
        S_sieve.arrows (𝟙 (weilEtaleIdTerminal.{u} Z_R)) := by
    intro R _ _ _ Z_R S_sieve hS
    let T_Z := weilEtaleIdTerminal.{u} Z_R
    let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z_R
    obtain ⟨Y, f, y, hf_arr, _, hfy⟩ :=
      (hMemEtale Z_R T_Z S_sieve).mp hS (IsLocalRing.closedPoint R)
    have hY_hom_y : Y.hom.base y = IsLocalRing.closedPoint R :=
      (congrArg (fun m : Y.left ⟶ Z_R => m.base y)
        (f.w.symm.trans (CategoryTheory.Category.comp_id f.left))).trans hfy
    obtain ⟨U, hU, hyU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y.left) (x := y) (U := ⊤) trivial
    let B_ring : Type u := ↑(Y.left.presheaf.obj (Opposite.op U))
    have hy_range : y ∈ Set.range ⇑hU.fromSpec := by
      rw [hU.range_fromSpec]
      exact hyU
    obtain ⟨p_B, hp_B⟩ := hy_range
    let q_B : PrimeSpectrum B_ring := p_B
    have : q_B.asIdeal.IsPrime := q_B.isPrime
    let w_B : AlgebraicGeometry.Spec (CommRingCat.of B_ring) ⟶ Z_R := hU.fromSpec ≫ Y.hom
    have hw_B_et : AlgebraicGeometry.Etale w_B := by
      have : AlgebraicGeometry.Etale Y.hom := Y.prop
      dsimp [w_B]
      infer_instance
    let f_RB : R →+* B_ring := (AlgebraicGeometry.Spec.preimage w_B).hom
    have hf_RB_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_RB) = w_B :=
      AlgebraicGeometry.Spec.map_preimage w_B
    let _ : Algebra R B_ring := f_RB.toAlgebra
    have : Algebra.Etale R B_ring := by
      rw [← RingHom.etale_algebraMap]
      change f_RB.Etale
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hf_RB_map.symm ▸ hw_B_et)
    have hcomap_pB : PrimeSpectrum.comap f_RB q_B = IsLocalRing.closedPoint R := by
      have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_RB)).base p_B =
          PrimeSpectrum.comap f_RB q_B := rfl
      rw [← h1, hf_RB_map]
      change Y.hom.base (hU.fromSpec.base p_B) = _
      rw [hp_B, hY_hom_y]
    let κ_R : Type u := IsLocalRing.ResidueField R
    let res_R : R →+* κ_R := IsLocalRing.residue R
    let K_B : Type u := AlgebraicClosure q_B.asIdeal.ResidueField
    let φ_B : B_ring →+* K_B :=
      (algebraMap q_B.asIdeal.ResidueField K_B).comp (algebraMap B_ring q_B.asIdeal.ResidueField)
    let α_B : R →+* K_B := φ_B.comp f_RB
    have hker_φB : RingHom.ker φ_B = q_B.asIdeal := by
      refine (?_ : RingHom.ker φ_B = RingHom.ker (algebraMap B_ring q_B.asIdeal.ResidueField)).trans
        (Ideal.ker_algebraMap_residueField q_B.asIdeal)
      ext b
      simp only [RingHom.mem_ker, φ_B, RingHom.comp_apply]
      exact ⟨fun h => (RingHom.injective (algebraMap q_B.asIdeal.ResidueField K_B))
        (h.trans (map_zero _).symm), fun h => by rw [h, map_zero]⟩
    have hker_αB : RingHom.ker α_B = IsLocalRing.maximalIdeal R := by
      change Ideal.comap f_RB (RingHom.ker φ_B) = _
      rw [hker_φB]
      exact congrArg PrimeSpectrum.asIdeal hcomap_pB
    have hle_ker : ∀ r ∈ IsLocalRing.maximalIdeal R, α_B r = 0 :=
      fun r hr => RingHom.mem_ker.mp (hker_αB.symm ▸ hr)
    let ι_κ : κ_R →+* K_B := Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) α_B hle_ker
    have hι_res : ι_κ.comp res_R = α_B := by
      ext r
      exact Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal R) α_B hle_ker
    let B_κ : Type u := TensorProduct R κ_R B_ring
    have : Algebra.Etale κ_R B_κ := inferInstance
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ_R B_κ).mp inferInstance
    let _ : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra κ_R (L i) := hAlgL
    have hSurjL : ∀ i : I, Function.Surjective (algebraMap κ_R (L i)) := by
      intro i z
      have : Algebra.IsSeparable κ_R (L i) := (hFinSep i).2
      have hz_int : _root_.IsIntegral κ_R z := Algebra.IsSeparable.isIntegral κ_R z
      let p := minpoly κ_R z
      have hp_monic : p.Monic := minpoly.monic hz_int
      have hp_irr : Irreducible p := minpoly.irreducible hz_int
      have hp_deg_pos : 0 < p.degree := Irreducible.degree_pos hp_irr
      have hp_sep : p.Separable := Algebra.IsSeparable.isSeparable κ_R z
      have hp_sp : p.Splits := IsSepClosed.splits_of_separable p hp_sep
      obtain ⟨c, hc⟩ := hp_sp.exists_eval_eq_zero (ne_of_gt hp_deg_pos)
      obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
      have hq_unit : IsUnit q_pol :=
        (hp_irr.isUnit_or_isUnit hq_pol).resolve_left (Polynomial.not_isUnit_X_sub_C c)
      have hq_monic : q_pol.Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c) (hq_pol ▸ hp_monic)
      have hq_deg : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
      have hq_eq : q_pol = 1 := by
        have hlead : q_pol.coeff 0 = 1 := by
          rw [← hq_deg]
          exact hq_monic.leadingCoeff
        rw [Polynomial.eq_C_of_natDegree_eq_zero hq_deg, hlead, map_one]
      have hp_eq : p = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq_eq, mul_one]
      have haeval : Polynomial.aeval z p = 0 := minpoly.aeval κ_R z
      rw [hp_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
      exact ⟨c, haeval.symm⟩
    let _ : Algebra R K_B := α_B.toAlgebra
    let ι_κ_alg : κ_R →ₐ[R] K_B :=
      { ι_κ with commutes' := fun r => congrFun (congrArg DFunLike.coe hι_res) r }
    let φ_alg : B_ring →ₐ[R] K_B :=
      { φ_B with commutes' := fun _ => rfl }
    let Ψ_κ : B_κ →ₐ[R] K_B :=
      Algebra.TensorProduct.lift ι_κ_alg φ_alg (fun _ _ => Commute.all _ _)
    let χ : (∀ i : I, L i) →+* K_B := Ψ_κ.toRingHom.comp Θ.symm.toRingHom
    have hex_i₀ : ∃ i₀ : I, χ (Pi.single i₀ 1) ≠ 0 := by
      by_contra! hall
      have h1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j; simp [Finset.sum_apply]
      have h0 : (1 : K_B) = 0 := by
        calc
          (1 : K_B) = χ 1 := (map_one χ).symm
          _ = ∑ i : I, χ (Pi.single i 1) := by rw [h1, map_sum]
          _ = 0 := Finset.sum_eq_zero (fun i _ => hall i)
      exact one_ne_zero h0
    obtain ⟨i₀, _⟩ := hex_i₀
    let e_i₀ : κ_R ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap κ_R (L i₀)) ⟨RingHom.injective _, hSurjL i₀⟩
    let π_B : B_ring →+* L i₀ :=
      (Pi.evalRingHom L i₀).comp
        (Θ.toRingHom.comp (Algebra.TensorProduct.includeRight : B_ring →ₐ[R] B_κ).toRingHom)
    let ψ₀ : B_ring →ₐ[R] κ_R :=
      { (e_i₀.symm.toRingHom.comp π_B) with
        commutes' := fun r => by
          change e_i₀.symm ((Θ (TensorProduct.tmul R (1 : κ_R) (algebraMap R B_ring r))) i₀) =
            algebraMap R κ_R r
          have htmul : TensorProduct.tmul R (1 : κ_R) (algebraMap R B_ring r) =
              algebraMap κ_R B_κ (algebraMap R κ_R r) := by
            calc
              TensorProduct.tmul R (1 : κ_R) (algebraMap R B_ring r)
                = TensorProduct.tmul R (1 : κ_R) (r • (1 : B_ring)) := by
                    rw [Algebra.smul_def, mul_one]
              _ = TensorProduct.tmul R (r • (1 : κ_R)) (1 : B_ring) := by
                    rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
              _ = algebraMap κ_R B_κ (algebraMap R κ_R r) := by
                    rw [Algebra.smul_def, mul_one]; rfl
          rw [htmul, Θ.commutes]
          exact e_i₀.symm_apply_apply (algebraMap R κ_R r) }
    let Q : Ideal B_ring := RingHom.ker ψ₀.toRingHom
    have : Q.IsPrime := RingHom.ker_isPrime ψ₀.toRingHom
    obtain ⟨f_loc_el, hfQ, hStd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) Q
    let _ : Algebra.IsStandardEtale R (Localization.Away f_loc_el) := hStd
    have hf_ne : ψ₀ f_loc_el ≠ 0 := fun h0 => hfQ (RingHom.mem_ker.mpr h0)
    have hf_unit : IsUnit (ψ₀.toRingHom f_loc_el) := IsUnit.mk0 (ψ₀ f_loc_el) hf_ne
    let ψ_loc : Localization.Away f_loc_el →ₐ[R] κ_R :=
      { (IsLocalization.Away.lift f_loc_el (g := ψ₀.toRingHom) hf_unit) with
        commutes' := fun r => by
          rw [IsScalarTower.algebraMap_apply R B_ring (Localization.Away f_loc_el)]
          change IsLocalization.Away.lift f_loc_el hf_unit
            (algebraMap B_ring _ (algebraMap R B_ring r)) = _
          rw [IsLocalization.Away.lift_eq]
          exact ψ₀.commutes r }
    obtain ⟨pres⟩ :=
      Algebra.IsStandardEtale.nonempty_standardEtalePresentation
        (R := R) (S := Localization.Away f_loc_el)
    let P_std : StandardEtalePair R := pres.P
    let a_bar : κ_R := ψ_loc pres.x
    have hMap_bar : P_std.HasMap a_bar := pres.hasMap.map ψ_loc
    have hf_bar : Polynomial.aeval a_bar P_std.f = 0 := hMap_bar.1
    have hg_bar : IsUnit (Polynomial.aeval a_bar P_std.g) := hMap_bar.2
    have hderiv_bar : IsUnit (Polynomial.aeval a_bar (Polynomial.derivative P_std.f)) := by
      apply IsUnit.mk0
      intro h0
      cases hP : P_std with
      | mk fP _ gP hBez =>
        have hf_bar' : Polynomial.aeval a_bar fP = 0 := by simpa [hP] using hf_bar
        have hg_bar' : Polynomial.aeval a_bar gP ≠ 0 := by
          have hg_eq : P_std.g = gP := by rw [hP]
          have hu : IsUnit (Polynomial.aeval a_bar gP) := hg_eq ▸ hg_bar
          exact hu.ne_zero
        have h0' : Polynomial.aeval a_bar (Polynomial.derivative fP) = 0 := by
          simpa [hP] using h0
        obtain ⟨p₁, p₂, nP, hBezout⟩ := hBez
        have h_ev := congrArg (Polynomial.aeval a_bar) hBezout
        simp [hf_bar', h0'] at h_ev
        exact pow_ne_zero nP hg_bar' h_ev.symm
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective a_bar
    have h_eval_res : ∀ (q_pol : Polynomial R) (x : R),
        res_R (q_pol.eval x) = Polynomial.aeval (res_R x) q_pol := by
      intro q_pol x
      rw [Polynomial.aeval_def]
      exact (Polynomial.eval₂_at_apply res_R x).symm
    have hf_a₀ : P_std.f.eval a₀ ∈ IsLocalRing.maximalIdeal R := by
      rw [← IsLocalRing.ker_residue, RingHom.mem_ker, h_eval_res, ha₀]
      exact hf_bar
    have hderiv_a₀ : IsUnit ((Polynomial.derivative P_std.f).eval a₀) := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.ker_residue,
        RingHom.mem_ker, h_eval_res, ha₀]
      exact hderiv_bar.ne_zero
    obtain ⟨a, ha_root, ha_diff⟩ :=
      HenselianLocalRing.is_henselian P_std.f P_std.monic_f a₀ hf_a₀ hderiv_a₀
    have hres_a : res_R a = a_bar := by
      have h0 : res_R (a - a₀) = 0 := by
        rw [← IsLocalRing.ker_residue, RingHom.mem_ker] at ha_diff
        exact ha_diff
      rw [map_sub, sub_eq_zero] at h0
      exact h0.trans ha₀
    have ha_f : Polynomial.aeval a P_std.f = 0 := ha_root
    have ha_g : IsUnit (Polynomial.aeval a P_std.g) := by
      change IsUnit (P_std.g.eval a)
      rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.ker_residue,
        RingHom.mem_ker, h_eval_res, hres_a]
      exact hg_bar.ne_zero
    have ha_map : P_std.HasMap a := ⟨ha_f, ha_g⟩
    let e_P : P_std.Ring ≃ₐ[R] Localization.Away f_loc_el :=
      AlgEquiv.ofBijective (P_std.lift pres.x pres.hasMap) pres.lift_bijective
    let ψ : B_ring →ₐ[R] R :=
      (P_std.lift a ha_map).comp
        (e_P.symm.toAlgHom.comp (IsScalarTower.toAlgHom R B_ring (Localization.Away f_loc_el)))
    let σ₀ : Z_R ⟶ Y.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ hU.fromSpec
    have hσ₀_hom : σ₀ ≫ Y.hom = 𝟙 Z_R := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ hU.fromSpec) ≫
        Y.hom = 𝟙 Z_R
      refine (CategoryTheory.Category.assoc _ _ _).trans ?_
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ w_B = 𝟙 Z_R
      rw [← hf_RB_map, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hid : ψ.toRingHom.comp f_RB = RingHom.id R := RingHom.ext ψ.commutes
      rw [hid]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of R)
    let σ_et : T_Z ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk σ₀ hσ₀_hom trivial
    have hcomp_id : σ_et ≫ f = 𝟙 T_Z := hT_Z.hom_ext (σ_et ≫ f) (𝟙 T_Z)
    exact hcomp_id ▸ S_sieve.downward_closed hf_arr σ_et

  
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let evalH0Equiv : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      F.H 0 ≃+ ↥(F.obj.obj (Opposite.op (weilEtaleIdTerminal.{u} Z))) :=
    fun Z F =>
      let T_Z := weilEtaleIdTerminal.{u} Z
      let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z
      let adj_c := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
      let u1 := (adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ))
      { toFun := fun x =>
          (((CategoryTheory.Abelian.Ext.addEquiv₀ x).hom.app (Opposite.op T_Z)).hom) u1
        invFun := fun m =>
          CategoryTheory.Abelian.Ext.mk₀ ((adj_c.homEquiv Aℤ F).symm
            (AddCommGrpCat.ofHom
              { toFun := fun z => z.down • m
                map_zero' := zero_zsmul m
                map_add' := fun a b => add_zsmul m a.down b.down }))
        left_inv := fun x => by
          let φ := CategoryTheory.Abelian.Ext.addEquiv₀ x
          let m := ((φ.hom.app (Opposite.op T_Z)).hom) u1
          let g_m : Aℤ ⟶ F.obj.obj (Opposite.op T_Z) :=
            AddCommGrpCat.ofHom
              { toFun := fun z => z.down • m
                map_zero' := zero_zsmul m
                map_add' := fun a b => add_zsmul m a.down b.down }
          have hgm_eq : g_m = adj_c.homEquiv Aℤ F φ := by
            rw [CategoryTheory.Adjunction.homEquiv_unit]
            apply AddCommGrpCat.ext
            rintro ⟨n⟩
            have hn : (⟨n⟩ : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) := by
              ext
              exact (mul_one n).symm
            change n • m = ((adj_c.unit.app Aℤ ≫ φ.hom.app (Opposite.op T_Z)).hom) ⟨n⟩
            rw [hn, map_zsmul]
            rfl
          change CategoryTheory.Abelian.Ext.mk₀ ((adj_c.homEquiv Aℤ F).symm g_m) = x
          rw [hgm_eq, Equiv.symm_apply_apply]
          exact CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
        right_inv := fun m => by
          let g_m : Aℤ ⟶ F.obj.obj (Opposite.op T_Z) :=
            AddCommGrpCat.ofHom
              { toFun := fun z => z.down • m
                map_zero' := zero_zsmul m
                map_add' := fun a b => add_zsmul m a.down b.down }
          let ψ := (adj_c.homEquiv Aℤ F).symm g_m
          have hmk : CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ ψ) = ψ :=
            CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply ψ
          have hsh : adj_c.unit.app Aℤ ≫ ψ.hom.app (Opposite.op T_Z) = g_m :=
            (CategoryTheory.Adjunction.homEquiv_unit adj_c Aℤ F ψ).symm.trans
              (Equiv.apply_symm_apply _ _)
          change (((CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ ψ)).hom.app
            (Opposite.op T_Z)).hom) u1 = m
          rw [hmk]
          exact (congrArg (fun k : Aℤ ⟶ F.obj.obj (Opposite.op T_Z) =>
            k.hom (ULift.up (1 : ℤ))) hsh).trans (one_zsmul m)
        map_add' := fun x y => by
          rw [map_add]
          rfl }

  have hMapsUnique : ∀ {Y₀ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}}
      (π₃ : Y₃ ⟶ Y₀) (π₂ : Y₂ ⟶ Y₀) (u₁ u₂ : Y₃ ⟶ Y₂)
      (heq : u₁ = u₂)
      (h₁ : u₁ ≫ π₂ = π₃) (h₂ : u₂ ≫ π₂ = π₃)
      (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})
      (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₂.smallEtaleTopology).obj F₀).H 0)
      (y₁ y₂ : (((weilEtaleSitePullback π₃).sheafPullback AddCommGrpCat.{u}
        Y₀.smallEtaleTopology Y₃.smallEtaleTopology).obj F₀).H 0),
      WeilEtaleTrianglePullbackMapsTo π₃ π₂ u₁ h₁ F₀ 0 x₂ y₁ →
      WeilEtaleTrianglePullbackMapsTo π₃ π₂ u₂ h₂ F₀ 0 x₂ y₂ →
      y₁ = y₂ := by
    intro Y₀ Y₂ Y₃ π₃ π₂ u₁ u₂ heq h₁ h₂ F₀ x₂ y₁ y₂ hm₁ hm₂
    subst heq
    have hh : h₁ = h₂ := Subsingleton.elim _ _
    subst hh
    rcases hm₁ with ⟨_, _, _, _, _, _, hy₁⟩
    rcases hm₂ with ⟨_, _, _, _, _, _, hy₂⟩
    exact hy₁.symm.trans hy₂

  have hBasisLiftStage : ∀ (p : ℕ) [Fact (Nat.Prime p)]
      (B₀ : CommRingCat.{u})
      (G : CategoryTheory.Sheaf (AlgebraicGeometry.Spec B₀).smallEtaleTopology AddCommGrpCat.{u})
      (_ : p • CategoryTheory.CategoryStruct.id G = 0)
      (M₀ : AddCommGrpCat.{u}) [Finite ↥M₀]
      (_ : ∀ m : ↥M₀, p • m = 0)
      (f₀_sh : B₀ ⟶ CommRingCat.of R_sh)
      (α₀ : (CategoryTheory.Functor.const ℐ_sh).obj B₀ ⟶ D_sh)
      (_ : ∀ j : ℐ_sh, (α₀.app j) ≫ (c_sh.ι.app j) ≫ e_sh.hom = f₀_sh),
      let Z₀ := AlgebraicGeometry.Spec B₀
      let p_i : ∀ j : ℐ_sh, AlgebraicGeometry.Spec (D_sh.obj j) ⟶ Z₀ :=
        fun j => AlgebraicGeometry.Spec.map (α₀.app j)
      let u_i : ∀ j : ℐ_sh, S_sh ⟶ AlgebraicGeometry.Spec (D_sh.obj j) :=
        fun j => AlgebraicGeometry.Spec.map ((c_sh.ι.app j) ≫ e_sh.hom)
      let p_sh : S_sh ⟶ Z₀ := AlgebraicGeometry.Spec.map f₀_sh
      let G_sh := ((weilEtaleSitePullback p_sh).sheafPullback AddCommGrpCat.{u}
        Z₀.smallEtaleTopology S_sh.smallEtaleTopology).obj G
      (↥M₀ ≃+ G_sh.H 0) →
      ∃ (j_star : ℐ_sh)
        (Φ : (CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (D_sh.obj j_star)).smallEtaleTopology AddCommGrpCat.{u}).obj M₀ ⟶
          ((weilEtaleSitePullback (p_i j_star)).sheafPullback
            AddCommGrpCat.{u} Z₀.smallEtaleTopology
            (AlgebraicGeometry.Spec (D_sh.obj j_star)).smallEtaleTopology).obj G),
        Subsingleton
          ((((weilEtaleSitePullback (u_i j_star)).sheafPullback
              AddCommGrpCat.{u}
              (AlgebraicGeometry.Spec (D_sh.obj j_star)).smallEtaleTopology
              S_sh.smallEtaleTopology).obj (CategoryTheory.Limits.kernel Φ)).H 0) := by
    intro p hp B₀ G hTorsG M₀ _ hTorsM f₀_sh α₀ hCocone Z₀ p_i u_i p_sh G_sh e_sh_H0
    rcases Nat.exists_eq_succ_of_ne_zero (Fact.out : Nat.Prime p).ne_zero with ⟨ℓ', rfl⟩
    let _ : Module (ZMod (ℓ' + 1)) ↥M₀ := AddCommGroup.zmodModule hTorsM
    let _ : Module.Finite (ZMod (ℓ' + 1)) ↥M₀ := Module.Finite.of_finite
    let r := Module.finrank (ZMod (ℓ' + 1)) ↥M₀
    let B_M : Module.Basis (Fin r) (ZMod (ℓ' + 1)) ↥M₀ :=
      Module.finBasis (ZMod (ℓ' + 1)) ↥M₀
    let c'_sh : CategoryTheory.Limits.Cocone D_sh := c_sh.extend e_sh.hom
    let hc'_sh : CategoryTheory.Limits.IsColimit c'_sh :=
      CategoryTheory.Limits.IsColimit.extendIso e_sh.hom hc_sh
    have hLiftEach : ∀ a : Fin r,
        ∃ (j : ℐ_sh)
          (hu : u_i j ≫ p_i j = p_sh)
          (s_j : (((weilEtaleSitePullback (p_i j)).sheafPullback
            AddCommGrpCat.{u} Z₀.smallEtaleTopology
            (AlgebraicGeometry.Spec (D_sh.obj j)).smallEtaleTopology).obj G).H 0),
          WeilEtaleTrianglePullbackMapsTo p_sh (p_i j) (u_i j)
            hu G 0 s_j (e_sh_H0 (B_M a)) :=
      fun a => (hAff0 ℐ_sh B₀ D_sh α₀ c'_sh hc'_sh f₀_sh hCocone G).1 (e_sh_H0 (B_M a))
    let j_of : Fin r → ℐ_sh := fun a => Classical.choose (hLiftEach a)
    have hUpper : ∀ (n : ℕ) (idx : Fin n → ℐ_sh),
        ∃ (j_top : ℐ_sh), ∀ a : Fin n, Nonempty (idx a ⟶ j_top) := by
      intro n
      induction n with
      | zero =>
        intro _
        exact ⟨Classical.choice CategoryTheory.IsFiltered.nonempty, fun a => Fin.elim0 a⟩
      | succ n ih =>
        intro idx
        obtain ⟨j₀, hj₀⟩ := ih (fun i : Fin n => idx i.castSucc)
        let j_last := idx (Fin.last n)
        let j_top := CategoryTheory.IsFiltered.max j₀ j_last
        refine ⟨j_top, Fin.lastCases ⟨CategoryTheory.IsFiltered.rightToMax j₀ j_last⟩ ?_⟩
        intro i
        exact ⟨Classical.choice (hj₀ i) ≫ CategoryTheory.IsFiltered.leftToMax j₀ j_last⟩
    obtain ⟨j_star, hθ_ex⟩ := hUpper r j_of
    let θ_of : ∀ a : Fin r, j_of a ⟶ j_star := fun a => Classical.choice (hθ_ex a)
    let W₀ := AlgebraicGeometry.Spec (D_sh.obj j_star)
    let w₀ : W₀ ⟶ Z₀ := p_i j_star
    let u_star : S_sh ⟶ W₀ := u_i j_star
    have hu_star : u_star ≫ w₀ = p_sh := by
      dsimp [u_star, w₀, u_i, p_i, p_sh]
      rw [← AlgebraicGeometry.Spec.map_comp]
      exact congrArg AlgebraicGeometry.Spec.map (hCocone j_star)
    let pb_w₀ := (weilEtaleSitePullback w₀).sheafPullback AddCommGrpCat.{u}
      Z₀.smallEtaleTopology W₀.smallEtaleTopology
    let G_W := pb_w₀.obj G
    have hTriPush : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        (π₁ : Y₁ ⟶ Z₀) (π₂ : Y₂ ⟶ Z₀) (h : Y₁ ⟶ Y₂) (h_eq : h ≫ π₂ = π₁)
        (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y₂.smallEtaleTopology).obj G).H 0),
        ∃ x₁ : (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y₁.smallEtaleTopology).obj G).H 0,
          WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq G 0 x₂ x₁ := by
      intro Y₁ Y₂ π₁ π₂ h h_eq x₂
      obtain ⟨hAdd_h, hLim_h, hColim_h, hcℤ_h⟩ := hSite.1 h
      let B_h := weilEtaleSitePullback h
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      have : pb_h.Additive := hAdd_h
      have : CategoryTheory.Limits.PreservesFiniteLimits pb_h := hLim_h
      have : CategoryTheory.Limits.PreservesFiniteColimits pb_h := hColim_h
      let shAdj₂ := CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}
      let shAdj₁ := CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}
      let Pℤ₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj Aℤ
      let Pℤ₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj Aℤ
      let Fℤ₂ := (CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ₁ := (CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let η₁ := CategoryTheory.Functor.whiskerLeft B_h.op (shAdj₁.unit.app Pℤ₁)
      let uℤ := (shAdj₂.homEquiv Pℤ₂ (pf_h.obj Fℤ₁)).symm η₁
      let cℤ := (adj_h.homEquiv Fℤ₂ Fℤ₁).symm uℤ
      have : CategoryTheory.IsIso cℤ := hcℤ_h
      let β := weilEtalePullMateInv.{u} π₁ π₂ h h_eq G
      refine ⟨((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv cℤ)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_h x₂)
        (Nat.zero_add 0)).comp (CategoryTheory.Abelian.Ext.mk₀ β) (Nat.add_zero 0),
        ⟨hc_all h, hr_all h, hAdd_h, hLim_h, hColim_h, hcℤ_h, rfl⟩⟩
    have hConsolidated : ∀ a : Fin r,
        ∃ s_W_a : G_W.H 0,
          WeilEtaleTrianglePullbackMapsTo p_sh w₀ u_star hu_star G 0 s_W_a (e_sh_H0 (B_M a)) := by
      intro a
      let ja := j_of a
      obtain ⟨hu_a, s_a, hm_a⟩ := Classical.choose_spec (hLiftEach a)
      let v_a : W₀ ⟶ AlgebraicGeometry.Spec (D_sh.obj ja) :=
        AlgebraicGeometry.Spec.map (D_sh.map (θ_of a))
      have hv_a : v_a ≫ p_i ja = w₀ := by
        dsimp [v_a, w₀, p_i]
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hnat := α₀.naturality (θ_of a)
        dsimp at hnat
        rw [Category.id_comp] at hnat
        rw [hnat]
      have huv_eq : u_star ≫ v_a = u_i ja := by
        dsimp [u_star, v_a, u_i]
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hnat := c_sh.ι.naturality (θ_of a)
        dsimp at hnat
        rw [Category.comp_id] at hnat
        rw [← Category.assoc, hnat]
      obtain ⟨s_W_a, hm_va⟩ := hTriPush w₀ (p_i ja) v_a hv_a s_a
      obtain ⟨z_a, hm_u⟩ := hTriPush p_sh w₀ u_star hu_star s_W_a
      have huv_w : (u_star ≫ v_a) ≫ p_i ja = p_sh := by
        rw [huv_eq]
        exact hu_a
      have hm_comp :=
        hSite.2.2.2.1 w₀ (p_i ja) p_sh v_a u_star hv_a hu_star huv_w G 0 s_a s_W_a z_a hm_va hm_u
      have hza_eq : z_a = e_sh_H0 (B_M a) :=
        hMapsUnique p_sh (p_i ja) (u_star ≫ v_a) (u_i ja)
          huv_eq huv_w hu_a G s_a z_a (e_sh_H0 (B_M a)) hm_comp hm_a
      exact ⟨s_W_a, hza_eq ▸ hm_u⟩
    let s_W_vec : Fin r → G_W.H 0 := fun a => Classical.choose (hConsolidated a)
    have hs_W_vec : ∀ a : Fin r,
        WeilEtaleTrianglePullbackMapsTo p_sh w₀ u_star hu_star G 0
          (s_W_vec a) (e_sh_H0 (B_M a)) :=
      fun a => Classical.choose_spec (hConsolidated a)

    let T_W := weilEtaleIdTerminal.{u} W₀
    let hT_W := weilEtaleIdTerminalIsTerminal.{u} W₀
    let T_sh := weilEtaleIdTerminal.{u} S_sh
    let hT_sh := weilEtaleIdTerminalIsTerminal.{u} S_sh
    let C_W := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
    let C_sh := CategoryTheory.constantSheaf S_sh.smallEtaleTopology AddCommGrpCat.{u}
    let adj_cW := CategoryTheory.constantSheafAdj W₀.smallEtaleTopology AddCommGrpCat.{u} hT_W
    let adj_csh := CategoryTheory.constantSheafAdj S_sh.smallEtaleTopology AddCommGrpCat.{u} hT_sh

    have : pb_w₀.Additive := (hSite.1 w₀).1
    have hTorsGW : (ℓ' + 1) • CategoryTheory.CategoryStruct.id G_W = 0 := by
      dsimp [G_W]
      rw [← pb_w₀.map_id, ← CategoryTheory.Functor.map_nsmul, hTorsG, pb_w₀.map_zero]
    have hTorsGW_sec : ∀ s : ↥(G_W.obj.obj (Opposite.op T_W)), (ℓ' + 1) • s = 0 := by
      intro s
      have hApp : ∀ t : ℕ, ((t • CategoryTheory.CategoryStruct.id G_W).hom.app
          (Opposite.op T_W)).hom s = t • s := by
        intro t
        induction t with
        | zero => simp
        | succ t ih =>
          rw [succ_nsmul, succ_nsmul]
          change (((t • CategoryTheory.CategoryStruct.id G_W).hom.app (Opposite.op T_W)).hom +
            ((CategoryTheory.CategoryStruct.id G_W).hom.app (Opposite.op T_W)).hom) s = _
          rw [AddMonoidHom.add_apply, ih]
          rfl
      have h0 := congrArg (fun ν : G_W ⟶ G_W => (ν.hom.app (Opposite.op T_W)).hom s) hTorsGW
      exact (hApp (ℓ' + 1)).symm.trans h0
    let _ : Module (ZMod (ℓ' + 1)) ↥(G_W.obj.obj (Opposite.op T_W)) :=
      AddCommGroup.zmodModule hTorsGW_sec

    let φ_W_vec : ∀ a : Fin r, C_W.obj Aℤ ⟶ G_W :=
      fun a => CategoryTheory.Abelian.Ext.addEquiv₀ (s_W_vec a)
    let t_vec : Fin r → ↥(G_W.obj.obj (Opposite.op T_W)) :=
      fun a => ((adj_cW.homEquiv Aℤ G_W) (φ_W_vec a)).hom (ULift.up (1 : ℤ))
    let α_lin : ↥M₀ →ₗ[ZMod (ℓ' + 1)] ↥(G_W.obj.obj (Opposite.op T_W)) :=
      B_M.constr (ZMod (ℓ' + 1)) t_vec
    let α₀_hom : M₀ ⟶ G_W.obj.obj (Opposite.op T_W) :=
      AddCommGrpCat.ofHom α_lin.toAddMonoidHom
    let Φ : C_W.obj M₀ ⟶ G_W := (adj_cW.homEquiv M₀ G_W).symm α₀_hom

    let e_vec : ∀ a : Fin r, Aℤ ⟶ M₀ := fun a =>
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • B_M a
          map_zero' := zero_zsmul (B_M a)
          map_add' := fun z₁ z₂ => add_zsmul (B_M a) z₁.down z₂.down }
    have hΦ_basis : ∀ a : Fin r, C_W.map (e_vec a) ≫ Φ = φ_W_vec a := by
      intro a
      apply (adj_cW.homEquiv Aℤ G_W).injective
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply]
      apply AddCommGrpCat.ext
      rintro ⟨n⟩
      have hn : (⟨n⟩ : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) := by
        ext
        exact (mul_one n).symm
      rw [hn, map_zsmul, map_zsmul]
      congr 1
      change α_lin ((1 : ℤ) • B_M a) = t_vec a
      rw [one_zsmul]
      exact B_M.constr_basis (ZMod (ℓ' + 1)) t_vec a

    obtain ⟨hAdd_u, hLim_u, hColim_u, hcℤ_u⟩ := hSite.1 u_star
    let B_u := weilEtaleSitePullback u_star
    let pf_u := B_u.sheafPushforwardContinuous AddCommGrpCat.{u}
      W₀.smallEtaleTopology S_sh.smallEtaleTopology
    let pb_u := B_u.sheafPullback AddCommGrpCat.{u}
      W₀.smallEtaleTopology S_sh.smallEtaleTopology
    let adj_u := B_u.sheafAdjunctionContinuous AddCommGrpCat.{u}
      W₀.smallEtaleTopology S_sh.smallEtaleTopology
    have : pb_u.Additive := hAdd_u
    have : CategoryTheory.Limits.PreservesFiniteLimits pb_u := hLim_u
    have : CategoryTheory.Limits.PreservesFiniteColimits pb_u := hColim_u

    let shAdj_W := CategoryTheory.sheafificationAdjunction W₀.smallEtaleTopology AddCommGrpCat.{u}
    let shAdj_sh := CategoryTheory.sheafificationAdjunction S_sh.smallEtaleTopology AddCommGrpCat.{u}
    let Pℤ_W := (CategoryTheory.Functor.const (Opposite W₀.Etale)).obj Aℤ
    let Pℤ_sh := (CategoryTheory.Functor.const (Opposite S_sh.Etale)).obj Aℤ
    let Fℤ_W := C_W.obj Aℤ
    let Fℤ_sh := C_sh.obj Aℤ
    let η₁_u := CategoryTheory.Functor.whiskerLeft B_u.op (shAdj_sh.unit.app Pℤ_sh)
    let uℤ_u := (shAdj_W.homEquiv Pℤ_W (pf_u.obj Fℤ_sh)).symm η₁_u
    let cℤ_u := (adj_u.homEquiv Fℤ_W Fℤ_sh).symm uℤ_u
    have : CategoryTheory.IsIso cℤ_u := hcℤ_u

    let β_star : pb_u.obj G_W ⟶ G_sh := weilEtalePullMateInv.{u} p_sh w₀ u_star hu_star G
    let α_star : G_sh ⟶ pb_u.obj G_W := weilEtalePullMateHom.{u} p_sh w₀ u_star hu_star G
    have hαβ_star : α_star ≫ β_star = 𝟙 G_sh := ((hFunc.1 p_sh w₀ u_star hu_star).1 G).1
    have hβα_star : β_star ≫ α_star = 𝟙 (pb_u.obj G_W) :=
      ((hFunc.1 p_sh w₀ u_star hu_star).1 G).2
    have : CategoryTheory.IsIso β_star := ⟨⟨α_star, hβα_star, hαβ_star⟩⟩

    let σ_u_left : S_sh ⟶ (B_u.obj T_W).left :=
      CategoryTheory.Limits.pullback.lift u_star (𝟙 S_sh)
        ((CategoryTheory.Category.comp_id u_star).trans (CategoryTheory.Category.id_comp u_star).symm)
    let σ_u : T_sh ⟶ B_u.obj T_W :=
      CategoryTheory.MorphismProperty.Over.homMk σ_u_left
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
    let τ_u : B_u.obj T_W ⟶ T_sh := hT_sh.from (B_u.obj T_W)
    let e_term_u : T_sh ≅ B_u.obj T_W :=
      { hom := σ_u
        inv := τ_u
        hom_inv_id := hT_sh.hom_ext (σ_u ≫ τ_u) (𝟙 T_sh)
        inv_hom_id := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hw_τ : τ_u.left = CategoryTheory.Limits.pullback.snd (𝟙 W₀) u_star :=
              (Category.comp_id τ_u.left).symm.trans τ_u.w
            exact ((Category.assoc τ_u.left σ_u_left _).trans
              (congrArg (τ_u.left ≫ ·)
                (CategoryTheory.Limits.pullback.lift_fst u_star (𝟙 S_sh) _))).trans
              (((congrArg (· ≫ u_star) hw_τ).trans
                ((CategoryTheory.Limits.pullback.condition (f := 𝟙 W₀) (g := u_star)).symm.trans
                  (Category.comp_id _))).trans
                (Category.id_comp _).symm)
          · exact ((Category.assoc τ_u.left σ_u_left _).trans
              (congrArg (τ_u.left ≫ ·)
                (CategoryTheory.Limits.pullback.lift_snd u_star (𝟙 S_sh) _))).trans
              (τ_u.w.trans (Category.id_comp _).symm) }

    let ev_sh := (CategoryTheory.sheafSections S_sh.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T_sh)
    let ev_W := (CategoryTheory.sheafSections W₀.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op T_W)
    let iso_ev_u : pf_u ⋙ ev_W ≅ ev_sh :=
      CategoryTheory.NatIso.ofComponents
        (fun F => F.obj.mapIso e_term_u.op)
        (fun {_ _} φ => (φ.hom.naturality e_term_u.hom.op).symm)
    let adj_comp_u : (C_W ⋙ pb_u) ⊣ ev_sh := (adj_cW.comp adj_u).ofNatIsoRight iso_ev_u
    let Ξ_const : C_W ⋙ pb_u ≅ C_sh := adj_comp_u.leftAdjointUniq adj_csh
    have hΞ_Aℤ : Ξ_const.hom.app Aℤ = cℤ_u := by
      apply (adj_comp_u.homEquiv Aℤ Fℤ_sh).injective
      have hLHS : adj_comp_u.homEquiv Aℤ Fℤ_sh (Ξ_const.hom.app Aℤ) = adj_csh.unit.app Aℤ := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        exact CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj_comp_u adj_csh Aℤ
      have hRHS : adj_comp_u.homEquiv Aℤ Fℤ_sh cℤ_u = adj_csh.unit.app Aℤ := by
        have h1 : adj_comp_u.homEquiv Aℤ Fℤ_sh cℤ_u =
            ((adj_cW.comp adj_u).homEquiv Aℤ Fℤ_sh cℤ_u) ≫ iso_ev_u.hom.app Fℤ_sh := by
          rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.ofNatIsoRight_unit,
            CategoryTheory.NatTrans.comp_app, CategoryTheory.Functor.whiskerLeft_app,
            Category.assoc]
          dsimp only [CategoryTheory.Functor.comp_obj]
          rw [← iso_ev_u.hom.naturality cℤ_u, ← Category.assoc,
            ← CategoryTheory.Adjunction.homEquiv_unit]
        rw [h1, CategoryTheory.Adjunction.comp_homEquiv]
        dsimp only [Equiv.trans_apply]
        have hc : adj_u.homEquiv Fℤ_W Fℤ_sh cℤ_u = uℤ_u := Equiv.apply_symm_apply _ _
        rw [hc]
        have hu : adj_cW.homEquiv Aℤ (pf_u.obj Fℤ_sh) uℤ_u = η₁_u.app (Opposite.op T_W) := by
          have hu_sh : shAdj_W.homEquiv Pℤ_W (pf_u.obj Fℤ_sh) uℤ_u = η₁_u :=
            Equiv.apply_symm_apply _ _
          exact congrArg (fun ν => ν.app (Opposite.op T_W)) hu_sh
        rw [hu]
        change (shAdj_sh.unit.app Pℤ_sh).app (Opposite.op (B_u.obj T_W)) ≫
            Fℤ_sh.obj.map e_term_u.hom.op =
          (shAdj_sh.unit.app Pℤ_sh).app (Opposite.op T_sh)
        exact ((shAdj_sh.unit.app Pℤ_sh).naturality e_term_u.hom.op).symm.trans
          (Category.id_comp _)
      exact hLHS.trans hRHS.symm

    let Θ_sh : C_sh.obj M₀ ⟶ G_sh := Ξ_const.inv.app M₀ ≫ pb_u.map Φ ≫ β_star
    have hΘ_basis : ∀ a : Fin r,
        C_sh.map (e_vec a) ≫ Θ_sh =
          CategoryTheory.Abelian.Ext.addEquiv₀ (e_sh_H0 (B_M a)) := by
      intro a
      let φ_sh_a : Fℤ_sh ⟶ G_sh :=
        CategoryTheory.Abelian.Ext.addEquiv₀ (e_sh_H0 (B_M a))
      rcases hs_W_vec a with ⟨_, _, _, _, _, _, hExtEq⟩
      have hExtEq' : ((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv cℤ_u)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u
            (CategoryTheory.Abelian.Ext.mk₀ (φ_W_vec a)))
          (Nat.zero_add 0)).comp (CategoryTheory.Abelian.Ext.mk₀ β_star) (Nat.add_zero 0) =
          CategoryTheory.Abelian.Ext.mk₀ φ_sh_a := by
        rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply,
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
        exact hExtEq
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hExtEq'
      have hHom_a : CategoryTheory.inv cℤ_u ≫ pb_u.map (φ_W_vec a) ≫ β_star = φ_sh_a := by
