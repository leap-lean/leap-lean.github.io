  let HasBijPull : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}}, (X₁ ⟶ X₂) → ℕ → Prop :=
    fun {X₁ X₂} h i =>
      ∀ (p : weilEtaleTorsionH X₂ ℓ i →+ weilEtaleTorsionH X₁ ℓ i),
        WeilIsTorsionEtalePullback h ℓ i p → Function.Bijective p
  have hBij_iso : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂) (i : ℕ),
      HasBijPull e.hom i := by
    intro X₁ X₂ e i p hp
    obtain ⟨q, hq⟩ := weil_etale_torsion_pullback_functoriality.1 e.inv ℓ i
    obtain ⟨pid₁, hpid₁⟩ := weil_etale_torsion_pullback_functoriality.1 (𝟙 X₁) ℓ i
    obtain ⟨pid₂, hpid₂⟩ := weil_etale_torsion_pullback_functoriality.1 (𝟙 X₂) ℓ i
    have hcomp₁ : pid₁ = p.comp q :=
      weil_etale_torsion_pullback_functoriality.2.2.1 e.hom e.inv ℓ i p q pid₁ hp hq
        (by simpa only [Iso.hom_inv_id] using hpid₁)
    have hcomp₂ : pid₂ = q.comp p :=
      weil_etale_torsion_pullback_functoriality.2.2.1 e.inv e.hom ℓ i q p pid₂ hq hp
        (by simpa only [Iso.inv_hom_id] using hpid₂)
    rw [weil_etale_torsion_pullback_functoriality.2.1 ℓ i pid₁ hpid₁] at hcomp₁
    rw [weil_etale_torsion_pullback_functoriality.2.1 ℓ i pid₂ hpid₂] at hcomp₂
    have hL : Function.LeftInverse q p := fun x => by
      simpa using DFunLike.congr_fun hcomp₂.symm x
    have hR : Function.RightInverse q p := fun y => by
      simpa using DFunLike.congr_fun hcomp₁.symm y
    exact ⟨hL.injective, hR.surjective⟩
  have hBij_comp : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃) (i : ℕ),
      HasBijPull h₁ i → HasBijPull h₂ i → HasBijPull (h₁ ≫ h₂) i := by
    intro X₁ X₂ X₃ h₁ h₂ i hb₁ hb₂ p₁₂ hp₁₂
    obtain ⟨p₁, hp₁⟩ := weil_etale_torsion_pullback_functoriality.1 h₁ ℓ i
    obtain ⟨p₂, hp₂⟩ := weil_etale_torsion_pullback_functoriality.1 h₂ ℓ i
    have heq :=
      weil_etale_torsion_pullback_functoriality.2.2.1 h₁ h₂ ℓ i p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
    rw [heq]
    exact (hb₁ p₁ hp₁).comp (hb₂ p₂ hp₂)
  have hBij_cancel_left : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃) (i : ℕ),
      HasBijPull h₁ i → HasBijPull (h₁ ≫ h₂) i → HasBijPull h₂ i := by
    intro X₁ X₂ X₃ h₁ h₂ i hb₁ hb₁₂ p₂ hp₂
    obtain ⟨p₁, hp₁⟩ := weil_etale_torsion_pullback_functoriality.1 h₁ ℓ i
    obtain ⟨p₁₂, hp₁₂⟩ := weil_etale_torsion_pullback_functoriality.1 (h₁ ≫ h₂) ℓ i
    have heq :=
      weil_etale_torsion_pullback_functoriality.2.2.1 h₁ h₂ ℓ i p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
    have hbij₁ := hb₁ p₁ hp₁
    have hbij₁₂ := hb₁₂ p₁₂ hp₁₂
    rw [heq] at hbij₁₂
    refine ⟨fun a b hab => hbij₁₂.1 (by simp [hab]), fun y => ?_⟩
    obtain ⟨x, hx⟩ := hbij₁₂.2 (p₁ y)
    exact ⟨x, hbij₁.1 hx⟩
  have hBij_cancel_right : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : X₁ ⟶ X₂) (h₂ : X₂ ⟶ X₃) (i : ℕ),
      HasBijPull h₂ i → HasBijPull (h₁ ≫ h₂) i → HasBijPull h₁ i := by
    intro X₁ X₂ X₃ h₁ h₂ i hb₂ hb₁₂ p₁ hp₁
    obtain ⟨p₂, hp₂⟩ := weil_etale_torsion_pullback_functoriality.1 h₂ ℓ i
    obtain ⟨p₁₂, hp₁₂⟩ := weil_etale_torsion_pullback_functoriality.1 (h₁ ≫ h₂) ℓ i
    have heq :=
      weil_etale_torsion_pullback_functoriality.2.2.1 h₁ h₂ ℓ i p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
    have hbij₂ := hb₂ p₂ hp₂
    have hbij₁₂ := hb₁₂ p₁₂ hp₁₂
    rw [heq] at hbij₁₂
    refine ⟨fun a b hab => ?_, fun z => ?_⟩
    · obtain ⟨a₀, rfl⟩ := hbij₂.2 a
      obtain ⟨b₀, rfl⟩ := hbij₂.2 b
      exact congrArg p₂ (hbij₁₂.1 hab)
    · obtain ⟨x, hx⟩ := hbij₁₂.2 z
      exact ⟨p₂ x, hx⟩

