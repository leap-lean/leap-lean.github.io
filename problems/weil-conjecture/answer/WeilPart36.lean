    have hpb_ι_outer : CategoryTheory.IsPullback
        (ι_tilde ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base)
        (AlgebraicGeometry.Spec.map inr_mv)
        S_d.hom (ι_U ≫ p_base) := by
      have hfst : ι_tilde ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_base =
