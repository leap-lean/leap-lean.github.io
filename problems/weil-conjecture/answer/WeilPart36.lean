        CategoryTheory.Limits.pullback.fst (g_et ≫ w₀) f_bar.left ≫ g_et :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    let e_pb : (Fgt_Z.obj (B_fbar.obj W_s)).left ⟶
        ((AlgebraicGeometry.Scheme.Etale.forget Y_ov.left).obj
