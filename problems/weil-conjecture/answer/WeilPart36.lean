      have hV₀_et : AlgebraicGeometry.Etale (O_x.ι ≫ Y_x.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_x.ι Y_x.hom inferInstance Y_x.prop
      let V₀ : Y.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ Y_x.hom) hV₀_et
      let j_O : V₀ ⟶ Y_x := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
      let g' : V₀ ⟶ W₀ := j_O ≫ g_x
      have hs₀_zero : (((G_U.cohomologyPresheaf b).map (B_j.map g').op).hom) s₀ = 0 :=
        hR₀_zero g' (R₀.downward_closed hg_arr j_O)
      let m_g' : (Fgt_U.obj (B_j.obj V₀)).left ⟶ (Fgt_U.obj (B_j.obj W₀)).left :=
        (Fgt_U.map (B_j.map g')).left
      obtain ⟨⟨α_g'₀, hTriFwd₀⟩, -⟩ := hTri w V₀.hom v_x
        (CategoryTheory.MorphismProperty.Over.w g')
        (B_j.map g').left
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.MorphismProperty.Over.w (B_j.map g'))
      let α_g' : CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) v_x ⟶
          (Fgt_U.obj (B_j.obj V₀)).left := α_g'₀
      have hTriFwd : α_g' ≫ (m_g' ≫ sym_hom) =
          CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j w) v_x :=
        hTriFwd₀
      obtain ⟨p_Bg', hp_Bg'⟩ := hPullEx m_g' ℓ b
      obtain ⟨p_α, hp_α⟩ := hPullEx α_g' ℓ b
      obtain ⟨p_mid, hp_mid⟩ := hPullEx (m_g' ≫ sym_hom) ℓ b
