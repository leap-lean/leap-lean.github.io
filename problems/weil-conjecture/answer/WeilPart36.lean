    let Fℤ := (CategoryTheory.constantSheaf J_D AddCommGrpCat.{u}).obj Aℤ
    let η_ℤ := (CategoryTheory.sheafificationAdjunction J_D AddCommGrpCat.{u}).unit.app Pℤ
