          change (((t • CategoryTheory.CategoryStruct.id G_sh).hom.app (Opposite.op T_sh)).hom +
            ((CategoryTheory.CategoryStruct.id G_sh).hom.app (Opposite.op T_sh)).hom) s = _
          rw [AddMonoidHom.add_apply, ih]
