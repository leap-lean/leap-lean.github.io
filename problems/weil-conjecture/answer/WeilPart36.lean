  let U_Ω : S_R.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j_R inferInstance
  let u_Ω : U_Ω ⟶ T_R := hT_R.from U_Ω

  have hTop_UΩ : ∀ R ∈ S_R.smallEtaleTopology U_Ω, R.arrows (𝟙 U_Ω) := by
    intro R hR
    obtain ⟨Y, g_y, y₀, hgR, hg_et, _⟩ := (hMemEtale S_R U_Ω R).mp hR (⊥ : PrimeSpectrum Ω)
    let f_y : Y.left ⟶ S_Ω := g_y.left
    have : AlgebraicGeometry.Etale f_y := hg_et
    obtain ⟨σ, _, hσ_g, _⟩ := hAlgClosedEtaleSec Ω Y.left f_y y₀
    have hσ_Y : σ ≫ Y.hom = j_R := by
      have hgw : f_y ≫ j_R = Y.hom := g_y.w
      rw [← hgw, ← Category.assoc, hσ_g, Category.id_comp]
    let s_et : U_Ω ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk σ hσ_Y trivial
    have hs_comp : s_et ≫ g_y = 𝟙 U_Ω :=
      CategoryTheory.MorphismProperty.Over.Hom.ext hσ_g
    exact hs_comp ▸ R.downward_closed hgR s_et

  have hMapBijOfSheafify : ∀ (P_pre : (S_R.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}),
      let F_sh := (CategoryTheory.presheafToSheaf S_R.smallEtaleTopology AddCommGrpCat.{u}).obj
        P_pre
      Function.Bijective (P_pre.map (Opposite.op u_Ω)) →
      Function.Bijective (F_sh.obj.map (Opposite.op u_Ω)) := by
    intro P_pre F_sh hBijP
    let η_P := CategoryTheory.toSheafify S_R.smallEtaleTopology P_pre
    have hBij_TR : Function.Bijective (η_P.app (Opposite.op T_R)) :=
      hSheafifyBijOfTopSieve T_R (hTopHensel R_bar) P_pre
    have hBij_UΩ : Function.Bijective (η_P.app (Opposite.op U_Ω)) :=
      hSheafifyBijOfTopSieve U_Ω hTop_UΩ P_pre
    have hnat : P_pre.map (Opposite.op u_Ω) ≫ η_P.app (Opposite.op U_Ω) =
        η_P.app (Opposite.op T_R) ≫ F_sh.obj.map (Opposite.op u_Ω) :=
      η_P.naturality (Opposite.op u_Ω)
    have hLHS_bij : Function.Bijective
        ((η_P.app (Opposite.op U_Ω)) ∘ (P_pre.map (Opposite.op u_Ω))) :=
      hBij_UΩ.comp hBijP
    have hRHS_bij : Function.Bijective
        ((F_sh.obj.map (Opposite.op u_Ω)) ∘ (η_P.app (Opposite.op T_R))) := by
      have hfun : ((F_sh.obj.map (Opposite.op u_Ω)) ∘ (η_P.app (Opposite.op T_R))) =
          ((η_P.app (Opposite.op U_Ω)) ∘ (P_pre.map (Opposite.op u_Ω))) :=
        funext fun x => congrArg (fun k => k x) hnat.symm
      rwa [hfun]
    exact hBijRight hBij_TR hRHS_bij

  have hHenselOpenBij :
      Function.Bijective ((C_R.obj A_M).obj.map (Opposite.op u_Ω)) ∧
      Function.Bijective (G_R.obj.map (Opposite.op u_Ω)) := by
    refine ⟨?_, ?_⟩
    · exact hMapBijOfSheafify ((CategoryTheory.Functor.const _).obj A_M)
        ⟨fun _ _ h => h, fun x => ⟨x, rfl⟩⟩
    · apply hMapBijOfSheafify
        ((weilEtaleSitePullback f_R).op ⋙ (weilEtaleTorsionSheaf X_R ℓ).cohomologyPresheaf q)
      let B_fR := weilEtaleSitePullback f_R
      let g_et := B_fR.map u_Ω
      let W₁ := B_fR.obj U_Ω
      let W₂ := B_fR.obj T_R
      let Fgt_XR := AlgebraicGeometry.Scheme.Etale.forget X_R
      obtain ⟨Θ_coh, hΘ_inter⟩ :=
        weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1 X_R ℓ q
      have hTorsIsoBij : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (e : Z₁ ≅ Z₂)
          (p_hom : weilEtaleTorsionH Z₂ ℓ q →+ weilEtaleTorsionH Z₁ ℓ q),
          WeilIsTorsionEtalePullback e.hom ℓ q p_hom → Function.Bijective p_hom := by
        intro Z₁ Z₂ e p_hom hp_hom
        obtain ⟨p_inv, hp_inv⟩ := hTorsEx e.inv ℓ q
        obtain ⟨p_id₁, hp_id₁⟩ := hTorsEx (𝟙 Z₁) ℓ q
        obtain ⟨p_id₂, hp_id₂⟩ := hTorsEx (𝟙 Z₂) ℓ q
        have hc₁ := hTorsComp e.hom e.inv ℓ q p_hom p_inv p_id₁
          hp_hom hp_inv (e.hom_inv_id.symm ▸ hp_id₁)
        have hc₂ := hTorsComp e.inv e.hom ℓ q p_inv p_hom p_id₂
          hp_inv hp_hom (e.inv_hom_id.symm ▸ hp_id₂)
        rw [hTorsId ℓ q p_id₁ hp_id₁] at hc₁
        rw [hTorsId ℓ q p_id₂ hp_id₂] at hc₂
        exact ⟨fun x y hxy => by
            have h1 := congrArg p_inv hxy
            rwa [← AddMonoidHom.comp_apply, ← AddMonoidHom.comp_apply, ← hc₂] at h1,
          fun z => ⟨p_inv z, by
            change (p_hom.comp p_inv) z = z
            rw [← hc₁]
            rfl⟩⟩
      let π₂ : (Fgt_XR.obj W₂).left ⟶ X_R :=
        CategoryTheory.Limits.pullback.snd (𝟙 S_R) f_R
      let l_π₂ : X_R ⟶ (Fgt_XR.obj W₂).left :=
        CategoryTheory.Limits.pullback.lift f_R (𝟙 X_R) (Category.comp_id f_R)
      let e_π₂ : (Fgt_XR.obj W₂).left ≅ X_R :=
        { hom := π₂
          inv := l_π₂
          hom_inv_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact ((Category.assoc π₂ l_π₂ _).trans
                (congrArg (π₂ ≫ ·)
                  (CategoryTheory.Limits.pullback.lift_fst f_R (𝟙 X_R) _))).trans
                (((CategoryTheory.Limits.pullback.condition (f := 𝟙 S_R) (g := f_R)).symm.trans
                  (Category.comp_id _)).trans
                  (Category.id_comp _).symm)
            · exact ((Category.assoc π₂ l_π₂ _).trans
                (congrArg (π₂ ≫ ·)
                  (CategoryTheory.Limits.pullback.lift_snd f_R (𝟙 X_R) _))).trans
                ((Category.comp_id π₂).trans (Category.id_comp π₂).symm)
          inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
      let j_X := CategoryTheory.Limits.pullback.fst f_R j_R
      let e_symm : (Fgt_XR.obj W₁).left ≅ CategoryTheory.Limits.pullback f_R j_R :=
        CategoryTheory.Limits.pullbackSymmetry j_R f_R
      have hcomp_XR : (Fgt_XR.map g_et).left ≫ π₂ = e_symm.hom ≫ j_X := by
        have hw_g : (Fgt_XR.map g_et).left ≫ π₂ =
            CategoryTheory.Limits.pullback.snd j_R f_R := (Fgt_XR.map g_et).w
        have hsymm : e_symm.hom ≫ j_X = CategoryTheory.Limits.pullback.snd j_R f_R :=
          CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst j_R f_R
        exact hw_g.trans hsymm.symm
      obtain ⟨p_g, hp_g⟩ := hTorsEx (Fgt_XR.map g_et).left ℓ q
      obtain ⟨p_π₂, hp_π₂⟩ := hTorsEx π₂ ℓ q
      obtain ⟨p_symm, hp_symm⟩ := hTorsEx e_symm.hom ℓ q
      obtain ⟨ψ_q, hψ_q⟩ := hTorsEx j_X ℓ q
      obtain ⟨p_tot, hp_tot⟩ := hTorsEx (e_symm.hom ≫ j_X) ℓ q
      have htot_lhs := hTorsComp (Fgt_XR.map g_et).left π₂ ℓ q p_g p_π₂ p_tot
        hp_g hp_π₂ (hcomp_XR.symm ▸ hp_tot)
      have htot_rhs := hTorsComp e_symm.hom j_X ℓ q p_symm ψ_q p_tot
        hp_symm hψ_q hp_tot
      have hpg_comp_eq : p_g.comp p_π₂ = p_symm.comp ψ_q := htot_lhs.symm.trans htot_rhs
      have hp_π₂_bij : Function.Bijective p_π₂ := hTorsIsoBij e_π₂ p_π₂ hp_π₂
      have hp_symm_bij : Function.Bijective p_symm := hTorsIsoBij e_symm p_symm hp_symm
      have hψ_bij : Function.Bijective ψ_q := hBij_jX ψ_q hψ_q
      have hpg_π₂_bij : Function.Bijective (p_g ∘ p_π₂) := by
        change Function.Bijective (p_g.comp p_π₂)
        rw [hpg_comp_eq]
        exact hp_symm_bij.comp hψ_bij
      have hpg_bij : Function.Bijective p_g :=
        hBijRight hp_π₂_bij hpg_π₂_bij
      have hInter := hΘ_inter g_et p_g hp_g
      let map_coh := ((weilEtaleTorsionSheaf X_R ℓ).cohomologyPresheaf q).map g_et.op
      have hΘ_map_bij : Function.Bijective ((Θ_coh W₁) ∘ map_coh) := by
        have hfun : ((Θ_coh W₁) ∘ map_coh) = (p_g ∘ (Θ_coh W₂)) :=
          funext fun z => hInter z
        rw [hfun]
        exact hpg_bij.comp (Θ_coh W₂).bijective
      refine ⟨fun a₁ a₂ ha => hΘ_map_bij.1 (congrArg (Θ_coh W₁) ha), fun b => ?_⟩
      obtain ⟨a, ha⟩ := hΘ_map_bij.2 (Θ_coh W₁ b)
      exact ⟨a, (Θ_coh W₁).injective ha⟩

  
  have hPB_GR : WeilIsEtaleSheafPullback g_Δ_R G_Δ G_R := hPBC_at g_Δ_R
  have hPB_gW_GR : WeilIsEtaleSheafPullback g_W G_W G_R :=
    (hCompPB_ex g_W w₀ G_Δ G_W G_R).2 hPB_GW (hg_W_w₀.symm ▸ hPB_GR)
  obtain ⟨Ψ_R, hPB_kerR, _⟩ :=
    hKerCokerPB g_W _ G_W Φ (C_R.obj A_M) G_R (hConstPB_ex g_W A_M) hPB_gW_GR
  have hPB_Ksh : WeilIsEtaleSheafPullback u_star (CategoryTheory.Limits.kernel Φ) K_sh :=
    ⟨hc_all u_star, hr_all u_star, ⟨CategoryTheory.Iso.refl _⟩⟩
  have hPB_πsh_ker : WeilIsEtaleSheafPullback π_sh K_sh (CategoryTheory.Limits.kernel Ψ_R) :=
    (hCompPB_ex π_sh u_star (CategoryTheory.Limits.kernel Φ) K_sh
      (CategoryTheory.Limits.kernel Ψ_R)).2 hPB_Ksh hPB_kerR
  obtain ⟨K_k₁, hPB_Kk₁⟩ := hExPB (u_R ≫ π_sh) K_sh
  have hPB_uR_ker : WeilIsEtaleSheafPullback u_R (CategoryTheory.Limits.kernel Ψ_R) K_k₁ :=
    (hCompPB_ex u_R π_sh K_sh (CategoryTheory.Limits.kernel Ψ_R) K_k₁).2 hPB_πsh_ker hPB_Kk₁
  obtain ⟨e_Kk1_Ksh⟩ :=
    (weil_strictly_henselian_spec_etale_eval_and_pullback R_sh).2 k₁ (u_R ≫ π_sh) hu_sh_pt
      K_sh K_k₁ hPB_Kk₁
  obtain ⟨e_Kk1_kerR⟩ :=
    (weil_strictly_henselian_spec_etale_eval_and_pullback R_bar).2 k₁ u_R hu_R_pt
      (CategoryTheory.Limits.kernel Ψ_R) K_k₁ hPB_uR_ker
  have : Subsingleton (K_sh.H 0) := hSub_Ksh
  have hSub_Kk1 : Subsingleton (K_k₁.H 0) := e_Kk1_Ksh.toEquiv.subsingleton
  have hSub_kerR : Subsingleton ((CategoryTheory.Limits.kernel Ψ_R).H 0) :=
    e_Kk1_kerR.symm.toEquiv.subsingleton

  have hOpenKernelZero : ∀ (H_η : CategoryTheory.Sheaf
      S_Ω.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback η_W (CategoryTheory.Limits.kernel Φ) H_η →
      CategoryTheory.Limits.IsZero H_η := by
    intro H_η hPB_Hη
    let K_R := CategoryTheory.Limits.kernel Ψ_R
    have : Subsingleton (K_R.H 0) := hSub_kerR
    have hSub_KR_TR : Subsingleton ↥(K_R.obj.obj (Opposite.op T_R)) :=
      (CategoryTheory.Sheaf.H.equiv₀ K_R hT_R).symm.toEquiv.subsingleton
    let ev_TR := CategoryTheory.sheafToPresheaf S_R.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (S_R.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_R)
    have hZero_KR_TR : CategoryTheory.Limits.IsZero (ev_TR.obj K_R) :=
      (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mpr
        (AddCommGrpCat.ext fun x => hSub_KR_TR.elim x 0)
    have hZero_ker_TR : CategoryTheory.Limits.IsZero
        (CategoryTheory.Limits.kernel (ev_TR.map Ψ_R)) :=
      CategoryTheory.Limits.IsZero.of_iso hZero_KR_TR
        (CategoryTheory.Limits.PreservesKernel.iso ev_TR Ψ_R).symm
    have hInj_Ψ_TR : Function.Injective (Ψ_R.hom.app (Opposite.op T_R)) :=
      (AddCommGrpCat.mono_iff_injective _).mp
        ((CategoryTheory.Preadditive.mono_iff_isZero_kernel (ev_TR.map Ψ_R)).mpr hZero_ker_TR)
    have hInj_Ψ_UΩ : Function.Injective (Ψ_R.hom.app (Opposite.op U_Ω)) := by
      intro x y hxy
      obtain ⟨x₀, rfl⟩ := hHenselOpenBij.1.2 x
      obtain ⟨y₀, rfl⟩ := hHenselOpenBij.1.2 y
      have hnat := Ψ_R.hom.naturality (Opposite.op u_Ω)
      have hx_nat : (Ψ_R.hom.app (Opposite.op U_Ω))
          (((C_R.obj A_M).obj.map (Opposite.op u_Ω)) x₀) =
          (G_R.obj.map (Opposite.op u_Ω)) ((Ψ_R.hom.app (Opposite.op T_R)) x₀) :=
        congrArg (fun k => k x₀) hnat
      have hy_nat : (Ψ_R.hom.app (Opposite.op U_Ω))
          (((C_R.obj A_M).obj.map (Opposite.op u_Ω)) y₀) =
          (G_R.obj.map (Opposite.op u_Ω)) ((Ψ_R.hom.app (Opposite.op T_R)) y₀) :=
        congrArg (fun k => k y₀) hnat
      have hG_eq : (G_R.obj.map (Opposite.op u_Ω)) ((Ψ_R.hom.app (Opposite.op T_R)) x₀) =
          (G_R.obj.map (Opposite.op u_Ω)) ((Ψ_R.hom.app (Opposite.op T_R)) y₀) :=
        hx_nat.symm.trans (hxy.trans hy_nat)
      have hx₀y₀ : x₀ = y₀ := hInj_Ψ_TR (hHenselOpenBij.2.1 hG_eq)
      rw [hx₀y₀]
    let ev_UΩ := CategoryTheory.sheafToPresheaf S_R.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (S_R.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op U_Ω)
    have hMono_Ψ_UΩ : CategoryTheory.Mono (ev_UΩ.map Ψ_R) :=
      (AddCommGrpCat.mono_iff_injective _).mpr hInj_Ψ_UΩ
    have hZero_KR_UΩ : CategoryTheory.Limits.IsZero (ev_UΩ.obj K_R) :=
      CategoryTheory.Limits.IsZero.of_iso
        ((CategoryTheory.Preadditive.mono_iff_isZero_kernel (ev_UΩ.map Ψ_R)).mp hMono_Ψ_UΩ)
        (CategoryTheory.Limits.PreservesKernel.iso ev_UΩ Ψ_R)
    have hId0_UΩ : CategoryTheory.CategoryStruct.id (ev_UΩ.obj K_R) = 0 :=
      (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp hZero_KR_UΩ
    have : Subsingleton ↥(K_R.obj.obj (Opposite.op U_Ω)) :=
      ⟨fun a b => by
        have ha : a = 0 := congrArg (fun f : ev_UΩ.obj K_R ⟶ ev_UΩ.obj K_R => f.hom a) hId0_UΩ
        have hb : b = 0 := congrArg (fun f : ev_UΩ.obj K_R ⟶ ev_UΩ.obj K_R => f.hom b) hId0_UΩ
        exact ha.trans hb.symm⟩
    have hSub_Ext0 : Subsingleton
        (CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} S_R U_Ω) K_R 0) :=
      ⟨fun x₁ x₂ => by
        obtain ⟨φ₁, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective _ _).2 x₁
        obtain ⟨φ₂, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective _ _).2 x₂
        have hfy : CategoryTheory.Sheaf.freeYonedaHomEquiv φ₁ =
            CategoryTheory.Sheaf.freeYonedaHomEquiv φ₂ :=
          AddCommGrpCat.ext fun _ => Subsingleton.elim _ _
        rw [CategoryTheory.Sheaf.freeYonedaHomEquiv.injective hfy]⟩
    have hSurj_slice := (hSliceBij S_R U_Ω K_R 0).2
    let pb_jR := (weilEtaleSitePullback j_R).sheafPullback AddCommGrpCat.{u}
      S_R.smallEtaleTopology S_Ω.smallEtaleTopology
    have : Subsingleton ((pb_jR.obj K_R).H 0) :=
      ⟨fun y₁ y₂ => by
        obtain ⟨x₁, rfl⟩ := hSurj_slice y₁
        obtain ⟨x₂, rfl⟩ := hSurj_slice y₂
        rw [hSub_Ext0.elim x₁ x₂]⟩
    have hPB_jR_Hη : WeilIsEtaleSheafPullback j_R K_R H_η :=
      (hCompPB_ex j_R g_W (CategoryTheory.Limits.kernel Φ) K_R H_η).2 hPB_kerR hPB_Hη
    have hPB_jR_std : WeilIsEtaleSheafPullback j_R K_R (pb_jR.obj K_R) :=
      ⟨hc_all j_R, hr_all j_R, ⟨CategoryTheory.Iso.refl _⟩⟩
    obtain ⟨e_Hη_iso⟩ := hUniquePB j_R K_R (pb_jR.obj K_R) H_η hPB_jR_std hPB_jR_Hη
    obtain ⟨e_Hη_H0⟩ := hIsoH0 e_Hη_iso
    have : Subsingleton (H_η.H 0) := e_Hη_H0.symm.toEquiv.subsingleton
    let T_Ω := weilEtaleIdTerminal.{u} S_Ω
    let hT_Ω := weilEtaleIdTerminalIsTerminal.{u} S_Ω
    have hSub_Hη_TΩ : Subsingleton ↥(H_η.obj.obj (Opposite.op T_Ω)) :=
      (CategoryTheory.Sheaf.H.equiv₀ H_η hT_Ω).symm.toEquiv.subsingleton
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    ext V_op : 2
    rcases V_op with ⟨V⟩
    apply AddCommGrpCat.ext
    intro s
    change s = 0
    let R_V : CategoryTheory.Sieve V :=
      { arrows := fun Y f_v => ∃ (u_v : Y ⟶ T_Ω) (v_v : T_Ω ⟶ V), f_v = u_v ≫ v_v
        downward_closed := fun {_ _} {_} ⟨u_v, v_v, hf_v⟩ g_v =>
          ⟨g_v ≫ u_v, v_v, (congrArg (g_v ≫ ·) hf_v).trans (Category.assoc g_v u_v v_v).symm⟩ }
    have hRV_mem : R_V ∈ S_Ω.smallEtaleTopology V := by
      refine (hMemEtale S_Ω V R_V).mpr ?_
      intro x
      have : AlgebraicGeometry.Etale V.hom := V.prop
      obtain ⟨σ, hσ_et, hσ_hom, hσ_pt⟩ := hAlgClosedEtaleSec Ω V.left V.hom x
      let f_x : T_Ω ⟶ V := CategoryTheory.MorphismProperty.Over.homMk σ hσ_hom trivial
      exact ⟨T_Ω, f_x, (⊥ : PrimeSpectrum Ω), ⟨𝟙 T_Ω, f_x, (Category.id_comp f_x).symm⟩,
        hσ_et, hσ_pt⟩
    exact H_η.isSeparated V R_V hRV_mem s 0 (fun Y f_v ⟨u_v, v_v, hf_v⟩ => by
      change (H_η.obj.map f_v.op) s = (H_η.obj.map f_v.op) 0
      rw [map_zero, hf_v]
      have hcomp_map : H_η.obj.map (u_v ≫ v_v).op = H_η.obj.map v_v.op ≫ H_η.obj.map u_v.op :=
        H_η.obj.map_comp v_v.op u_v.op
      rw [hcomp_map]
      change (H_η.obj.map u_v.op) ((H_η.obj.map v_v.op) s) = 0
      rw [hSub_Hη_TΩ.elim ((H_η.obj.map v_v.op) s) 0, map_zero])

  exact ⟨W₀, hAff_W₀, hInt_W₀, w₀, hEt_w₀, s_W, η_W, G_W, Φ,
    hs_W, hη_W_w₀, hDense_ηW, hPB_GW, hOpenKernelZero⟩

theorem weil_sing_dev_deg2m2_mod_prime_punctured_line_locConst (k : Type u) [Field k] [IsAlgClosed k]
    (d_rel : ℕ)
    (Z_bar D_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    [AlgebraicGeometry.IsProper D_bar.hom]
    (e_P : D_bar ≅ weilProjectiveSpaceOver k 1)
    (f_bar : Z_bar ⟶ D_bar)
    [AlgebraicGeometry.IsProper f_bar.left]
    [AlgebraicGeometry.Surjective f_bar.left]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hConstruct : ∀ q : ℕ,
      WeilIsConstructibleModPrimeSheaf ℓ D_bar.left
        (weilEtaleHigherDirectImage f_bar.left q
          (weilEtaleTorsionSheaf Z_bar.left ℓ)))
    (j_k : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ D_bar.left)
    [AlgebraicGeometry.IsOpenImmersion j_k]
    (hj_k_hom : j_k ≫ D_bar.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (Δ_k : Polynomial k) (hΔ_ne : Δ_k ≠ 0)
    (U_bar : D_bar.left.Opens)
    (e_U : U_bar.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away Δ_k)))
    (he_U : U_bar.ι = e_U.hom ≫
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away Δ_k))) ≫ j_k)
    [AlgebraicGeometry.SmoothOfRelativeDimension d_rel (f_bar.left ∣_ U_bar)] :
    ∀ (q : ℕ) (x : ↥U_bar.toScheme),
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U_bar.toScheme) (A₀ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale w ∧
        x ∈ Set.range w.base ∧
        Finite ↥A₀ ∧
        WeilIsEtaleSheafPullback w
          (weilEtaleHigherDirectImage (f_bar.left ∣_ U_bar) q
            (weilEtaleTorsionSheaf (f_bar.left ⁻¹ᵁ U_bar).toScheme ℓ))
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) :=
by
  classical
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  have hSerre := weil_etale_constructible_mod_prime_serre_and_local k ℓ
  obtain ⟨hIsoH, _, _, _, hTorsSh, _⟩ :=
    weil_etale_pullback_functoriality_and_iso_torsionH.{u} ℓ
  obtain ⟨hExPB_ex, hIsoPB_ex, hCompPB_ex, hConstPB_ex, hKerCokerPB, _⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ

  have hUniquePB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (G₁ G₂ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F G₁ →
      WeilIsEtaleSheafPullback h F G₂ →
      Nonempty (G₁ ≅ G₂) := by
    rintro X₁ X₂ h F G₁ G₂ ⟨_, _, ⟨e₁⟩⟩ ⟨_, _, ⟨e₂⟩⟩
    exact ⟨e₁.symm ≪≫ e₂⟩

  have hIsoH0 : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {H₁ H₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}},
      (H₁ ≅ H₂) → Nonempty (H₁.H 0 ≃+ H₂.H 0) := by
    intro Y H₁ H₂ e
    let T_Y := weilEtaleIdTerminal.{u} Y
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let e₁ : H₁.H 0 ≃+ ↥(H₁.obj.obj (Opposite.op T_Y)) := CategoryTheory.Sheaf.H.equiv₀ H₁ hT_Y
    let e₂ : H₂.H 0 ≃+ ↥(H₂.obj.obj (Opposite.op T_Y)) := CategoryTheory.Sheaf.H.equiv₀ H₂ hT_Y
    let e_mid : ↥(H₁.obj.obj (Opposite.op T_Y)) ≃+ ↥(H₂.obj.obj (Opposite.op T_Y)) :=
      { toFun := e.hom.hom.app (Opposite.op T_Y)
        invFun := e.inv.hom.app (Opposite.op T_Y)
        left_inv := fun s =>
          congrArg (fun ν : H₁ ⟶ H₁ => (ν.hom.app (Opposite.op T_Y)) s) e.hom_inv_id
        right_inv := fun t =>
          congrArg (fun ν : H₂ ⟶ H₂ => (ν.hom.app (Opposite.op T_Y)) t) e.inv_hom_id
        map_add' := map_add (e.hom.hom.app (Opposite.op T_Y)).hom }
    exact ⟨e₁.trans (e_mid.trans e₂.symm)⟩

  
  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have hSheafZero : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W →
      ∀ (s : ↥(ℱ.obj.obj (Opposite.op W))),
        (∀ {Y : S.Etale} (f : Y ⟶ W), R.arrows f → (ℱ.obj.map f.op) s = 0) →
        s = 0 := by
    intro S ℱ W R hR s hs
    exact ℱ.isSeparated W R hR s 0 (fun Y f hf => by
      change (ℱ.obj.map f.op) s = (ℱ.obj.map f.op) 0
      rw [map_zero]
      exact hs f hf)

  have hCoverByTK : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (U : (AlgebraicGeometry.Spec (CommRingCat.of K)).Etale) (x : ↥U.left),
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := weilEtaleIdTerminal.{u} S_K
      ∃ (f_x : T_K ⟶ U),
        AlgebraicGeometry.Etale f_x.left ∧
        f_x.left.base (⊥ : PrimeSpectrum K) = x := by
    intro K _ _ U x S_K T_K
    have _ : AlgebraicGeometry.Etale U.hom := U.prop
    obtain ⟨V_x, hAffV, hxV, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := x) (U := (⊤ : U.left.Opens)) trivial
    let R_V : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V_x)
    let B : Type u := ↑R_V
    let p_x : PrimeSpectrum B := hAffV.isoSpec.hom.base ⟨x, hxV⟩
    let j_V : AlgebraicGeometry.Spec R_V ⟶ U.left := hAffV.isoSpec.inv ≫ V_x.ι
    have hj_V_pt : j_V.base p_x = x := by
      dsimp [j_V, p_x]
      have h1 : hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩) = ⟨x, hxV⟩ := by
        change (hAffV.isoSpec.hom ≫ hAffV.isoSpec.inv).base ⟨x, hxV⟩ = ⟨x, hxV⟩
        rw [hAffV.isoSpec.hom_inv_id]
        rfl
      change V_x.ι.base (hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩)) = x
      rw [h1]
      rfl
    have _ : AlgebraicGeometry.Etale j_V := by dsimp [j_V]; infer_instance
    let φ_KB : CommRingCat.of K ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_V ≫ U.hom)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_KB = j_V ≫ U.hom :=
      AlgebraicGeometry.Spec.map_preimage (j_V ≫ U.hom)
    have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_KB) := by
      rw [hSpec_φ]; infer_instance
    have hEt_hom : φ_KB.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec
    let _ : Algebra K B := φ_KB.hom.toAlgebra
    have _ : Algebra.Etale K B := RingHom.etale_algebraMap.mp hEt_hom
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K B).mp inferInstance
    have _ : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra K (L i) := hAlgL
    have hex_i₀ : ∃ i₀ : I, Θ.symm (Pi.single i₀ 1) ∉ p_x.asIdeal := by
      by_contra! hall
      have hsum1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j; simp [Finset.sum_apply]
      have hB1 : (1 : B) = ∑ i : I, Θ.symm (Pi.single i 1) := by
        calc (1 : B) = Θ.symm 1 := (map_one Θ.symm).symm
          _ = ∑ i : I, Θ.symm (Pi.single i 1) := by rw [hsum1, map_sum]
      have hmem1 : (1 : B) ∈ p_x.asIdeal := by
        rw [hB1]
        exact Ideal.sum_mem p_x.asIdeal (fun i _ => hall i)
      exact p_x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hmem1)
    obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
    have hSurj_i₀ : Function.Surjective (algebraMap K (L i₀)) := by
      intro y
      have _ : Module.Finite K (L i₀) := (hFinSep i₀).1
      have hy_int : _root_.IsIntegral K y := Algebra.IsIntegral.isIntegral y
      let m := minpoly K y
      have hm_deg : m.degree ≠ 0 :=
        ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_root m hm_deg
      obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
      have hq_unit : IsUnit q_pol :=
        ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
          (Polynomial.not_isUnit_X_sub_C c)
      have hq_monic : q_pol.Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
          (hq_pol ▸ minpoly.monic hy_int)
      have hq1 : q_pol = 1 := by
        have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
        have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
        rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
      have hm_eq : m = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
      have haeval : Polynomial.aeval y m = 0 := minpoly.aeval K y
      rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
      exact ⟨c, haeval.symm⟩
    let e_L : K ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap K (L i₀)) ⟨RingHom.injective _, hSurj_i₀⟩
    let χ : B →+* K :=
      e_L.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom)
    have hχ_comp : φ_KB ≫ CommRingCat.ofHom χ = 𝟙 (CommRingCat.of K) := by
      apply CommRingCat.hom_ext
      ext c
      change e_L.symm (Θ (algebraMap K B c) i₀) = c
      rw [Θ.commutes]
      exact e_L.symm_apply_apply c
    have hker_χ : RingHom.ker χ = p_x.asIdeal := by
      ext b
      rw [RingHom.mem_ker]
      have hχ_zero_iff : χ b = 0 ↔ Θ b i₀ = 0 := by
        change e_L.symm (Θ b i₀) = 0 ↔ Θ b i₀ = 0
        exact ⟨fun h => by simpa using congrArg e_L h, fun h => by simp [h]⟩
      rw [hχ_zero_iff]
      have hprod0 : Θ.symm (Pi.single i₀ 1) * (b - Θ.symm (Pi.single i₀ (Θ b i₀))) = 0 := by
        apply Θ.injective
        rw [map_mul, map_sub, Θ.apply_symm_apply, Θ.apply_symm_apply, map_zero]
        ext j
        by_cases hj : j = i₀
        · subst hj; simp
        · simp [Pi.single_eq_of_ne hj]
      have hdiff_mem : b - Θ.symm (Pi.single i₀ (Θ b i₀)) ∈ p_x.asIdeal := by
        have hmem0 : Θ.symm (Pi.single i₀ 1) * (b - Θ.symm (Pi.single i₀ (Θ b i₀))) ∈
            p_x.asIdeal := by
          rw [hprod0]; exact p_x.asIdeal.zero_mem
        exact (p_x.isPrime.mem_or_mem hmem0).resolve_left hi₀_not_mem
      constructor
      · intro hb0
        rw [hb0, Pi.single_zero, map_zero, sub_zero] at hdiff_mem
        exact hdiff_mem
      · intro hbp
        by_contra hne0
        have hsingle_mem : Θ.symm (Pi.single i₀ (Θ b i₀)) ∈ p_x.asIdeal := by
          have hsub := p_x.asIdeal.sub_mem hbp hdiff_mem
          simpa using hsub
        have hinv_prod : Θ.symm (Pi.single i₀ (Θ b i₀)) * Θ.symm (Pi.single i₀ (Θ b i₀)⁻¹) =
            Θ.symm (Pi.single i₀ 1) := by
          rw [← map_mul]
          congr 1
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [mul_inv_cancel₀ hne0]
          · simp [Pi.single_eq_of_ne hj]
        exact hi₀_not_mem (hinv_prod ▸ p_x.asIdeal.mul_mem_right _ hsingle_mem)
    let σ_x : S_K ⟶ U.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫ j_V
    have hσ_hom : σ_x ≫ U.hom = 𝟙 S_K := by
      dsimp [σ_x]
      rw [Category.assoc, ← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp, hχ_comp,
        AlgebraicGeometry.Spec.map_id]
    have hσ_et : AlgebraicGeometry.Etale σ_x :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) σ_x U.hom U.prop
        (by rw [hσ_hom]; infer_instance)
    let f_x : T_K ⟶ U := CategoryTheory.MorphismProperty.Over.homMk σ_x hσ_hom
    refine ⟨f_x, hσ_et, ?_⟩
    have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base (⊥ : PrimeSpectrum K) =
        p_x := by
      apply PrimeSpectrum.ext
      change Ideal.comap χ ⊥ = p_x.asIdeal
      exact hker_χ
    change j_V.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base
      (⊥ : PrimeSpectrum K)) = x
    rw [hpt_eq, hj_V_pt]

  have hTopSieveTK : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (R : CategoryTheory.Sieve
        (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of K)))),
      R ∈ (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology
        (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of K))) →
      R.arrows (𝟙 _) := by
    intro K _ _ R hR
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    let T_K := weilEtaleIdTerminal.{u} S_K
    let hT_K := weilEtaleIdTerminalIsTerminal.{u} S_K
    obtain ⟨Y, u, y₀, huR, _, _⟩ := (hMemEtale S_K T_K R).mp hR (⊥ : PrimeSpectrum K)
    obtain ⟨f_y, _, _⟩ := hCoverByTK K Y y₀
    have hcomp_id : f_y ≫ u = 𝟙 T_K := hT_K.hom_ext (f_y ≫ u) (𝟙 T_K)
    rw [← hcomp_id]
    exact R.downward_closed huR f_y

  have hConstEvalBij : ∀ (K : Type u) [Field K] [IsAlgClosed K] (A : AddCommGrpCat.{u}),
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := weilEtaleIdTerminal.{u} S_K
      let constA : (S_K.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj A
      Function.Bijective
        ((CategoryTheory.toSheafify S_K.smallEtaleTopology constA).app (Opposite.op T_K)) := by
    intro K _ _ A S_K T_K constA
    let η_K := CategoryTheory.toSheafify S_K.smallEtaleTopology constA
    let C_K := CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}
    constructor
    · let Idx : S_K.Etale → Type u := fun V =>
        { σ : S_K ⟶ V.left // σ ≫ V.hom = 𝟙 S_K }
      let RK₀ : (S_K.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
        { obj := fun V_op => AddCommGrpCat.of (Idx V_op.unop → ↥A)
          map := fun {V₁_op V₂_op} g_op =>
            AddCommGrpCat.ofHom
              { toFun := fun φ τ =>
                  φ ⟨τ.1 ≫ g_op.unop.left, by
                    erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w g_op.unop, τ.2]⟩
                map_zero' := rfl
                map_add' := fun _ _ => rfl }
          map_id := fun _ => by
            apply AddCommGrpCat.ext
            intro φ
            funext τ
            exact congrArg φ (Subtype.ext (Category.comp_id τ.1))
          map_comp := fun f_op g_op => by
            apply AddCommGrpCat.ext
            intro φ
            funext τ
            exact congrArg φ (Subtype.ext (Category.assoc τ.1 g_op.unop.left f_op.unop.left).symm) }
      let id_idx : Idx T_K := ⟨𝟙 S_K, Category.id_comp _⟩
      have hIdxTK : ∀ τ : Idx T_K, τ = id_idx := fun ⟨τ, hτ⟩ =>
        Subtype.ext ((Category.comp_id τ).symm.trans hτ)
      have hRK_sheaf : CategoryTheory.Presheaf.IsSheaf S_K.smallEtaleTopology RK₀ := by
        intro E V S hS x hx
        let m_idx : ∀ {W : S_K.Etale}, Idx W → (T_K ⟶ W) :=
          fun τ => CategoryTheory.MorphismProperty.Over.homMk τ.1 τ.2
        have hm_mem : ∀ τ : Idx V, S.arrows (m_idx τ) := by
          intro τ
          have hpbS : S.pullback (m_idx τ) ∈ S_K.smallEtaleTopology T_K :=
            S_K.smallEtaleTopology.pullback_stable (m_idx τ) hS
          simpa [CategoryTheory.Sieve.pullback_apply] using hTopSieveTK K _ hpbS
        let x_hom : ∀ τ : Idx V, E ⟶ AddCommGrpCat.of (Idx T_K → ↥A) :=
          fun τ => x (m_idx τ) (hm_mem τ)
        let amalg : E ⟶ RK₀.obj (Opposite.op V) :=
          AddCommGrpCat.ofHom
            { toFun := fun e τ => ((x_hom τ).hom e) id_idx
              map_zero' := by
                ext τ
                exact congrFun ((x_hom τ).hom.map_zero) id_idx
              map_add' := fun e₁ e₂ => by
                ext τ
                exact congrFun ((x_hom τ).hom.map_add e₁ e₂) id_idx }
        refine ⟨amalg, ?_, ?_⟩
        · intro W f_w hf
          apply AddCommGrpCat.ext
          intro e
          funext σ
          let fσ : Idx V := ⟨σ.1 ≫ f_w.left, by
            erw [Category.assoc, CategoryTheory.MorphismProperty.Over.w f_w, σ.2]⟩
          have hcomp_eq : 𝟙 T_K ≫ m_idx fσ = m_idx σ ≫ f_w := by
            rw [Category.id_comp]
            exact CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
          have hx_raw := hx (𝟙 T_K) (m_idx σ) (hm_mem fσ) hf hcomp_eq
          have hx_val := congrFun (congrArg (fun (m : E ⟶ RK₀.obj (Opposite.op T_K)) =>
            m.hom e) hx_raw) id_idx
          dsimp [RK₀, amalg, x_hom, fσ] at hx_val ⊢
          have h1 : (⟨𝟙 S_K ≫ 𝟙 S_K,
              (congrArg (· ≫ T_K.hom) (Category.id_comp _)).trans id_idx.2⟩ : Idx T_K) = id_idx :=
            hIdxTK _
          have h2 : (⟨𝟙 S_K ≫ σ.1,
              (by erw [Category.assoc, σ.2])⟩ : Idx W) = σ :=
            Subtype.ext (Category.id_comp σ.1)
          erw [h1, h2] at hx_val
          exact hx_val
        · intro y hy
          apply AddCommGrpCat.ext
          intro e
          funext τ
          have hy_raw := hy (m_idx τ) (hm_mem τ)
          have hy_val := congrFun (congrArg (fun (m : E ⟶ RK₀.obj (Opposite.op T_K)) =>
            m.hom e) hy_raw) id_idx
          dsimp [RK₀, amalg, x_hom] at hy_val ⊢
          have h2 : (⟨𝟙 S_K ≫ τ.1,
              (by erw [Category.assoc, τ.2])⟩ : Idx V) = τ :=
            Subtype.ext (Category.id_comp τ.1)
          erw [h2] at hy_val
          exact hy_val
      let RK : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u} := ⟨RK₀, hRK_sheaf⟩
      let u_pre : constA ⟶ RK.obj :=
        { app := fun _ =>
            AddCommGrpCat.ofHom
              { toFun := fun a _ => a
                map_zero' := rfl
                map_add' := fun _ _ => rfl }
          naturality := fun _ _ _ => rfl }
      let adj_sh := CategoryTheory.sheafificationAdjunction S_K.smallEtaleTopology AddCommGrpCat.{u}
      let u_sh : C_K.obj A ⟶ RK := (adj_sh.homEquiv constA RK).symm u_pre
      have hηu : η_K ≫ u_sh.hom = u_pre :=
        (adj_sh.homEquiv constA RK).apply_symm_apply u_pre
      intro a₁ a₂ ha_eq
      have h1 := congrArg (fun m => (u_sh.hom.app (Opposite.op T_K) m) id_idx) ha_eq
      have h_eval : ∀ a : ↥A,
          (u_sh.hom.app (Opposite.op T_K) (η_K.app (Opposite.op T_K) a)) id_idx = a := by
        intro a
        exact congrArg (fun ν : constA ⟶ RK.obj => (ν.app (Opposite.op T_K) a) id_idx) hηu
      rwa [h_eval a₁, h_eval a₂] at h1
    · intro s
      have _ : CategoryTheory.Presheaf.IsLocallySurjective S_K.smallEtaleTopology
          (CategoryTheory.toSheafify S_K.smallEtaleTopology constA) :=
        inferInstance
      have hImg : CategoryTheory.Presheaf.imageSieve η_K s ∈ S_K.smallEtaleTopology T_K :=
        CategoryTheory.Presheaf.imageSieve_mem S_K.smallEtaleTopology
          (CategoryTheory.toSheafify S_K.smallEtaleTopology constA) s
      obtain ⟨a, ha⟩ := hTopSieveTK K _ hImg
      exact ⟨a, ha.trans (congrArg (fun g => g s)
        ((C_K.obj A).obj.map_id (Opposite.op T_K)))⟩

  
  have hPromoteIso : ∀ (W₀ : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (η_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀)
      (_ : DenseRange η_W.base)
      (M₀ : AddCommGrpCat.{u}) [Finite ↥M₀]
      (G_W : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u})
      (Φ : (CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).obj M₀ ⟶ G_W),
      (∀ (H_η : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback η_W (CategoryTheory.Limits.kernel Φ) H_η →
        CategoryTheory.Limits.IsZero H_η) →
      (∀ (K : Type u) [Field K] [IsAlgClosed K]
          (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W₀)
          (H_z : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z G_W H_z →
        Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ Nat.card ↥M₀) →
      CategoryTheory.IsIso Φ := by
    intro W₀ Ω _ _ η_W hDense M₀ _ G_W Φ hKerη hCard
    let C_W := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
    let constM_W : (W₀.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj M₀
    let η_sh : constM_W ⟶ (C_W.obj M₀).obj :=
      CategoryTheory.toSheafify W₀.smallEtaleTopology constM_W
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := weilEtaleIdTerminal.{u} S_Ω
    let C_Ω := CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}
    let constM_Ω : (S_Ω.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (CategoryTheory.Functor.const _).obj M₀
    let η_sh_Ω : constM_Ω ⟶ (C_Ω.obj M₀).obj :=
      CategoryTheory.toSheafify S_Ω.smallEtaleTopology constM_Ω
    obtain ⟨_, ⟨hc_η, hr_η, ⟨_⟩⟩, -⟩ := hExPB_ex η_W (CategoryTheory.Limits.kernel Φ)
    let B_η : CategoryTheory.Functor W₀.Etale S_Ω.Etale := weilEtaleSitePullback η_W
    let pf_η := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_η AddCommGrpCat.{u} _ W₀.smallEtaleTopology S_Ω.smallEtaleTopology hc_η
    let pb_η := @CategoryTheory.Functor.sheafPullback _ _ _ _
      B_η AddCommGrpCat.{u} _ W₀.smallEtaleTopology S_Ω.smallEtaleTopology hc_η hr_η
    let adj_η := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      B_η AddCommGrpCat.{u} _ W₀.smallEtaleTopology S_Ω.smallEtaleTopology hc_η hr_η
    have hZero_pb_ker : CategoryTheory.Limits.IsZero (pb_η.obj (CategoryTheory.Limits.kernel Φ)) :=
      hKerη (pb_η.obj (CategoryTheory.Limits.kernel Φ))
        ⟨hc_η, hr_η, ⟨CategoryTheory.Iso.refl _⟩⟩
    let u_pre_Ω : constM_W ⟶ (pf_η.obj (C_Ω.obj M₀)).obj :=
      CategoryTheory.Functor.whiskerLeft B_η.op η_sh_Ω
    let adj_sh_W := CategoryTheory.sheafificationAdjunction W₀.smallEtaleTopology AddCommGrpCat.{u}
    let u_sh_Ω : C_W.obj M₀ ⟶ pf_η.obj (C_Ω.obj M₀) :=
      (adj_sh_W.homEquiv constM_W (pf_η.obj (C_Ω.obj M₀))).symm u_pre_Ω
    have hη_ush : η_sh ≫ u_sh_Ω.hom = u_pre_Ω :=
      (adj_sh_W.homEquiv constM_W (pf_η.obj (C_Ω.obj M₀))).apply_symm_apply u_pre_Ω
    let π_const_Ω : pb_η.obj (C_W.obj M₀) ⟶ C_Ω.obj M₀ :=
      (adj_η.homEquiv (C_W.obj M₀) (C_Ω.obj M₀)).symm u_sh_Ω
    have hadj_π : adj_η.unit.app (C_W.obj M₀) ≫ pf_η.map π_const_Ω = u_sh_Ω :=
      (adj_η.homEquiv (C_W.obj M₀) (C_Ω.obj M₀)).apply_symm_apply u_sh_Ω
    have hker_ush0 : CategoryTheory.Limits.kernel.ι Φ ≫ u_sh_Ω = 0 := by
      have _ : pf_η.Additive := { map_add := by intro _ _ _ _; ext _; rfl }
      have hZero_pf : CategoryTheory.Limits.IsZero
          (pf_η.obj (pb_η.obj (CategoryTheory.Limits.kernel Φ))) :=
        pf_η.map_isZero hZero_pb_ker
      have hunit0 : adj_η.unit.app (CategoryTheory.Limits.kernel Φ) = 0 :=
        hZero_pf.eq_of_tgt _ 0
      rw [← hadj_π, ← Category.assoc]
      have hnat_u : CategoryTheory.Limits.kernel.ι Φ ≫ adj_η.unit.app (C_W.obj M₀) =
          adj_η.unit.app (CategoryTheory.Limits.kernel Φ) ≫
            pf_η.map (pb_η.map (CategoryTheory.Limits.kernel.ι Φ)) :=
        adj_η.unit.naturality (CategoryTheory.Limits.kernel.ι Φ)
      rw [hnat_u, hunit0, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
    have hInj_Φ : ∀ W₁ : W₀.Etale, Function.Injective (Φ.hom.app (Opposite.op W₁)) := by
      intro W₁
      rw [injective_iff_map_eq_zero]
      intro s hs0
      have _ : CategoryTheory.Presheaf.IsLocallySurjective W₀.smallEtaleTopology
          (CategoryTheory.toSheafify W₀.smallEtaleTopology constM_W) :=
        inferInstance
      have hImgMem : CategoryTheory.Presheaf.imageSieve η_sh s ∈ W₀.smallEtaleTopology W₁ :=
        CategoryTheory.Presheaf.imageSieve_mem W₀.smallEtaleTopology
          (CategoryTheory.toSheafify W₀.smallEtaleTopology constM_W) s
      apply hSheafZero (C_W.obj M₀) W₁ (CategoryTheory.Presheaf.imageSieve η_sh s) hImgMem s
      intro Y_v f_v hf
      obtain ⟨m, hm⟩ := hf
      by_cases hneY : Nonempty ↥Y_v.left
      · obtain ⟨y₀⟩ := hneY
        have _ : AlgebraicGeometry.Etale Y_v.hom := Y_v.prop
        let pt_Ω : ↥S_Ω := (⊥ : PrimeSpectrum Ω)
        have hRange_ηW : Set.range ⇑η_W.base = {η_W.base pt_Ω} := by
          ext v
          simp only [Set.mem_range, Set.mem_singleton_iff]
          exact ⟨fun ⟨z, hz⟩ => hz ▸ congrArg η_W.base (Subsingleton.elim z pt_Ω),
            fun hv => ⟨pt_Ω, hv.symm⟩⟩
        have hSpec : η_W.base pt_Ω ⤳ Y_v.hom.base y₀ := by
          rw [specializes_iff_mem_closure, ← hRange_ηW, hDense.closure_eq]
          trivial
        obtain ⟨y_η, _, hy_eq⟩ := AlgebraicGeometry.Flat.generalizingMap Y_v.hom hSpec
        obtain ⟨z₀, -⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y_η pt_Ω hy_eq
        obtain ⟨τ_Y, _, _⟩ := hCoverByTK Ω (B_η.obj Y_v) z₀
        have hΦ_m0 : (Φ.hom.app (Opposite.op Y_v)) (η_sh.app (Opposite.op Y_v) m) = 0 := by
          rw [hm]
          have hnat := congrArg (fun k => k s) (Φ.hom.naturality f_v.op)
          exact hnat.trans ((congrArg (G_W.obj.map f_v.op) hs0).trans (map_zero _))
        let ev_Yv : CategoryTheory.Sheaf W₀.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
          CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u} ⋙
            (CategoryTheory.evaluation (W₀.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op Y_v)
        let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
        let ι_m : Eℤ ⟶ ev_Yv.obj (C_W.obj M₀) :=
          AddCommGrpCat.ofHom
            { toFun := fun z => z.down • (η_sh.app (Opposite.op Y_v) m)
              map_zero' := zero_zsmul _
              map_add' := fun z₁ z₂ => add_zsmul _ z₁.down z₂.down }
        have hι_m0 : ι_m ≫ ev_Yv.map Φ = 0 := by
          apply AddCommGrpCat.ext
          rintro ⟨z⟩
          change (Φ.hom.app (Opposite.op Y_v)) (z • (η_sh.app (Opposite.op Y_v) m)) = 0
          rw [map_zsmul, hΦ_m0, zsmul_zero]
        let lift_m : Eℤ ⟶ ev_Yv.obj (CategoryTheory.Limits.kernel Φ) :=
          CategoryTheory.Limits.kernel.lift (ev_Yv.map Φ) ι_m hι_m0 ≫
            (CategoryTheory.Limits.PreservesKernel.iso ev_Yv Φ).inv
        have hlift_fac : lift_m ≫ ev_Yv.map (CategoryTheory.Limits.kernel.ι Φ) = ι_m := by
          dsimp [lift_m]
          rw [Category.assoc, CategoryTheory.Limits.PreservesKernel.iso_inv_ι,
            CategoryTheory.Limits.kernel.lift_ι]
        have hι_ush0 : ι_m ≫ ev_Yv.map u_sh_Ω = 0 := by
          rw [← hlift_fac, Category.assoc, ← ev_Yv.map_comp, hker_ush0, ev_Yv.map_zero,
            CategoryTheory.Limits.comp_zero]
        have hush_m0 : (u_sh_Ω.hom.app (Opposite.op Y_v)) (η_sh.app (Opposite.op Y_v) m) = 0 := by
          have h1 := congrArg (fun g : Eℤ ⟶ ev_Yv.obj (pf_η.obj (C_Ω.obj M₀)) =>
            g (ULift.up (1 : ℤ))) hι_ush0
          simpa [ι_m, ev_Yv] using h1
        have hηΩ_Yv0 : η_sh_Ω.app (Opposite.op (B_η.obj Y_v)) m = 0 := by
          have h1 := congrArg (fun ν : constM_W ⟶ (pf_η.obj (C_Ω.obj M₀)).obj =>
            (ν.app (Opposite.op Y_v)) m) hη_ush
          exact h1.symm.trans hush_m0
        have hηΩ_T0 : η_sh_Ω.app (Opposite.op T_Ω) m = 0 := by
          have hnat_τ := congrArg (fun k => k m) (η_sh_Ω.naturality τ_Y.op)
          dsimp [constM_Ω] at hnat_τ
          rw [hnat_τ, hηΩ_Yv0, map_zero]
        have hm0 : m = 0 :=
          (hConstEvalBij Ω M₀).1 (hηΩ_T0.trans (map_zero _).symm)
        rw [← hm, hm0, map_zero]
      · rw [not_nonempty_iff] at hneY
        have hBotMem : (⊥ : CategoryTheory.Sieve Y_v) ∈ W₀.smallEtaleTopology Y_v :=
          (hMemEtale W₀ Y_v ⊥).mpr (fun x => IsEmpty.elim hneY x)
        exact hSheafZero (C_W.obj M₀) Y_v ⊥ hBotMem
          (((C_W.obj M₀).obj.map f_v.op) s) (fun _ hbot => False.elim hbot)
    have _ : ∀ W_op : (W₀.Etale)ᵒᵖ, CategoryTheory.Mono (Φ.hom.app W_op) :=
      fun W_op => (AddCommGrpCat.mono_iff_injective _).mpr (hInj_Φ W_op.unop)
    have hMono_hom : CategoryTheory.Mono Φ.hom :=
      (CategoryTheory.NatTrans.mono_iff_mono_app Φ.hom).mpr inferInstance
    have _ : CategoryTheory.Mono Φ :=
      (CategoryTheory.sheafToPresheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).mono_of_mono_map
        hMono_hom
    have hZero_kerΦ : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel Φ) :=
      CategoryTheory.Limits.isZero_kernel_of_mono Φ
    have hHasCo : ∀ W : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
          (CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) :=
      fun _ => inferInstance
    have _ : CategoryTheory.Limits.HasCokernel Φ :=
      (hHasCo W₀).has_colimit (CategoryTheory.Limits.parallelPair Φ 0)
    have hZero_cokerΦ : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel Φ) := by
      apply weil_etale_geometric_point_stalk_conservativity W₀ (CategoryTheory.Limits.cokernel Φ)
      intro K _ _ z
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := weilEtaleIdTerminal.{u} S_K
      let hT_K := weilEtaleIdTerminalIsTerminal.{u} S_K
      let C_K := CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}
      have hPB_C : WeilIsEtaleSheafPullback z (C_W.obj M₀) (C_K.obj M₀) := hConstPB_ex z M₀
      obtain ⟨H_z, hPB_Hz, -⟩ := hExPB_ex z G_W
      obtain ⟨ψ_z, hPB_ker_z, hPB_coker_z⟩ :=
        hKerCokerPB z (C_W.obj M₀) G_W Φ (C_K.obj M₀) H_z hPB_C hPB_Hz
      have _ : CategoryTheory.Limits.HasCokernel ψ_z :=
        (hHasCo S_K).has_colimit (CategoryTheory.Limits.parallelPair ψ_z 0)
      obtain ⟨_, ⟨_, _, ⟨e_Kz0⟩⟩, _, hZero_Kz0⟩ :=
        hExPB_ex z (CategoryTheory.Limits.kernel Φ)
      obtain ⟨_, _, ⟨e_Kz1⟩⟩ := hPB_ker_z
      have hZero_ker_ψz : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel ψ_z) :=
        CategoryTheory.Limits.IsZero.of_iso (hZero_Kz0 hZero_kerΦ) (e_Kz1.symm ≪≫ e_Kz0)
      let ev_TK : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        CategoryTheory.sheafToPresheaf S_K.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (CategoryTheory.evaluation (S_K.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_K)
      have hZero_ker_app : CategoryTheory.Limits.IsZero
          (CategoryTheory.Limits.kernel (ev_TK.map ψ_z)) :=
        CategoryTheory.Limits.IsZero.of_iso (ev_TK.map_isZero hZero_ker_ψz)
          (CategoryTheory.Limits.PreservesKernel.iso ev_TK ψ_z).symm
      have hMono_ψTK : CategoryTheory.Mono (ψ_z.hom.app (Opposite.op T_K)) :=
        (CategoryTheory.Preadditive.mono_iff_isZero_kernel (ev_TK.map ψ_z)).mpr hZero_ker_app
      have hInj_ψTK : Function.Injective (ψ_z.hom.app (Opposite.op T_K)) :=
        (AddCommGrpCat.mono_iff_injective (ψ_z.hom.app (Opposite.op T_K))).mp hMono_ψTK
      obtain ⟨hFin_Hz, hCard_Hz⟩ := hCard K z H_z hPB_Hz
      let e_Hz_H0 : H_z.H 0 ≃+ ↥(H_z.obj.obj (Opposite.op T_K)) :=
        CategoryTheory.Sheaf.H.equiv₀ H_z hT_K
      let e_CK_M0 : ↥M₀ ≃ ↥((C_K.obj M₀).obj.obj (Opposite.op T_K)) :=
        Equiv.ofBijective _ (hConstEvalBij K M₀)
      have _ : Finite ↥(H_z.obj.obj (Opposite.op T_K)) :=
        Finite.of_equiv (H_z.H 0) e_Hz_H0.toEquiv
      have hCard_le : Nat.card ↥(H_z.obj.obj (Opposite.op T_K)) ≤
          Nat.card ↥((C_K.obj M₀).obj.obj (Opposite.op T_K)) := by
        rw [← Nat.card_congr e_Hz_H0.toEquiv, ← Nat.card_congr e_CK_M0]
        exact hCard_Hz
      have hSurj_ψTK : Function.Surjective (ψ_z.hom.app (Opposite.op T_K)) :=
        (hInj_ψTK.bijective_of_nat_card_le hCard_le).2
      have hLocSurj_ψz : CategoryTheory.Sheaf.IsLocallySurjective ψ_z := by
        refine ⟨fun {U} t =>
          (hMemEtale S_K U (CategoryTheory.Presheaf.imageSieve ψ_z.hom t)).mpr ?_⟩
        intro u_pt
        obtain ⟨f_u, hf_et, hf_pt⟩ := hCoverByTK K U u_pt
        obtain ⟨s₀, hs₀⟩ := hSurj_ψTK ((H_z.obj.map f_u.op) t)
        exact ⟨T_K, f_u, (⊥ : PrimeSpectrum K), ⟨s₀, hs₀⟩, hf_et, hf_pt⟩
      have _ : CategoryTheory.Epi ψ_z :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} ψ_z).mp hLocSurj_ψz
      exact ⟨CategoryTheory.Limits.cokernel ψ_z, hPB_coker_z,
        CategoryTheory.Limits.isZero_cokernel_of_epi ψ_z⟩
    have _ : CategoryTheory.Epi Φ :=
      (CategoryTheory.Preadditive.epi_iff_isZero_cokernel Φ).mpr hZero_cokerΦ
    exact CategoryTheory.isIso_of_mono_of_epi Φ

  
  have hj_R_open : ∀ (R_bar : Type u) [CommRing R_bar] (t_bar : R_bar)
      (Ω : Type u) [CommRing Ω] (φ_R_Ω : R_bar →+* Ω),
      @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra →
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)) := by
    intro R_bar _ t_bar Ω _ φ_R_Ω hLoc
    let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
    have _ : IsLocalization.Away t_bar Ω := hLoc
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := Ω) t_bar

  have hSepRes : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      IsSepClosed (IsLocalRing.ResidueField K) := by
    intro K _ _
    have hbij : Function.Bijective (IsLocalRing.residue K) :=
      ⟨RingHom.injective (IsLocalRing.residue K), Ideal.Quotient.mk_surjective⟩
    let e : K ≃+* IsLocalRing.ResidueField K := RingEquiv.ofBijective (IsLocalRing.residue K) hbij
    have _ : IsAlgClosed (IsLocalRing.ResidueField K) :=
      IsAlgClosed.of_exists_root _ fun p _ hirr => by
        let p₀ : Polynomial K := p.map e.symm.toRingHom
        have hp₀_deg : p₀.degree ≠ 0 := by
          rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
          exact ne_of_gt (Irreducible.degree_pos hirr)
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p₀ hp₀_deg
        refine ⟨e c, ?_⟩
        have hev : Polynomial.eval c p₀ = e.symm (Polynomial.eval (e c) p) := by
          dsimp [p₀]
          rw [Polynomial.eval_map]
          conv_lhs => rw [← e.symm_apply_apply c]
          exact (Polynomial.hom_eval₂ p (RingHom.id _) e.symm.toRingHom (e c)).symm
        have hc0 : e.symm (Polynomial.eval (e c) p) = 0 := hev.symm.trans hc
        simpa using congrArg e hc0
    infer_instance

  have hPolyPrime : ∀ (pt : PrimeSpectrum (Polynomial k)), pt.asIdeal ≠ ⊥ →
      ∃ b : k, pt.asIdeal = RingHom.ker (Polynomial.evalRingHom b) := by
    intro pt hne
    have hMax : pt.asIdeal.IsMaximal := IsPrime.to_maximal_ideal hne
    let g : Polynomial k := Submodule.IsPrincipal.generator pt.asIdeal
    have hspan : Ideal.span ({g} : Set (Polynomial k)) = pt.asIdeal :=
      Ideal.span_singleton_generator pt.asIdeal
    have hg_not_unit : ¬ IsUnit g := by
      intro hu
      apply hMax.ne_top
      rw [← hspan, Ideal.span_singleton_eq_top]
      exact hu
    have hg_deg : g.degree ≠ 0 := by
      intro hd0
      exact hg_not_unit (Polynomial.isUnit_iff_degree_eq_zero.mpr hd0)
    obtain ⟨b, hb⟩ := IsAlgClosed.exists_root g hg_deg
    refine ⟨b, hMax.eq_of_le ?_ ?_⟩
    · intro htop
      have h1 : (1 : Polynomial k) ∈ RingHom.ker (Polynomial.evalRingHom b) := by
        rw [htop]; trivial
      rw [RingHom.mem_ker, map_one] at h1
      exact one_ne_zero h1
    · rw [← hspan, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      exact hb

  have hPolyHomClosed : ∀ (K : Type u) [Field K] (φ : Polynomial k →+* K),
      RingHom.ker φ ≠ ⊥ →
      ∃ b : k, φ = (φ.comp Polynomial.C).comp (Polynomial.evalRingHom b) := by
    intro K _ φ hne
    obtain ⟨p, hp_mem, hp_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    let _ : Algebra k K := (φ.comp Polynomial.C).toAlgebra
    have hφ_eval : ∀ r : Polynomial k, Polynomial.aeval (φ Polynomial.X) r = φ r := by
      intro r
      induction r using Polynomial.induction_on' with
      | add r₁ r₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
      | monomial n c =>
        rw [Polynomial.aeval_monomial, ← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
        rfl
    have hp_alg : IsAlgebraic k (φ Polynomial.X) := ⟨p, hp_ne, (hφ_eval p).trans hp_mem⟩
    have hp_int : _root_.IsIntegral k (φ Polynomial.X) := hp_alg.isIntegral
    let m := minpoly k (φ Polynomial.X)
    have hm_deg : m.degree ≠ 0 :=
      ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hp_int))
    obtain ⟨b, hb⟩ := IsAlgClosed.exists_root m hm_deg
    obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hb
    have hq_unit : IsUnit q_pol :=
      ((minpoly.irreducible hp_int).isUnit_or_isUnit hq_pol).resolve_left
        (Polynomial.not_isUnit_X_sub_C b)
    have hq_monic : q_pol.Monic :=
      Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C b)
        (hq_pol ▸ minpoly.monic hp_int)
    have hq1 : q_pol = 1 := by
      have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
      have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
