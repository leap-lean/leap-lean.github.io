    have hx_tilde_fac : x_tilde_0 ≫ j_WX = x_pt :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_WX x_pt hx₀_jWX
    let ε₀_hom : R_WX ⟶ CommRingCat.of k₀ := AlgebraicGeometry.Spec.preimage x_tilde_0
    have hε₀_map : AlgebraicGeometry.Spec.map ε₀_hom = x_tilde_0 :=
      AlgebraicGeometry.Spec.map_preimage x_tilde_0
    let ε₀ : A_X →+* k₀ := ε₀_hom.hom
    let φ_f_hom : CommRingCat.of R_U ⟶ R_WX := AlgebraicGeometry.Spec.preimage (j_WX ≫ f_X)
    have hφ_f_map : AlgebraicGeometry.Spec.map φ_f_hom = j_WX ≫ f_X :=
      AlgebraicGeometry.Spec.map_preimage (j_WX ≫ f_X)
    let φ_f : R_U →+* A_X := φ_f_hom.hom
    have hε₀_sec : ∀ c : k₀, ε₀ (φ_f (c_U c)) = c := by
      have hmap_id : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom c_U ≫ φ_f_hom ≫ ε₀_hom) =
          AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k₀)) := by
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          hε₀_map, hφ_f_map, AlgebraicGeometry.Spec.map_id,
          Category.assoc, Category.assoc, hf_X, ← Category.assoc, hx_tilde_fac, hx₀_k]
      have hhom_id := AlgebraicGeometry.Spec.map_injective hmap_id
      intro c
      exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hhom_id) c
    let _ : Algebra R_U A_X := φ_f.toAlgebra
    let _ : Algebra R_U A_bar := p_A.toAlgebra
    let T : Type u := TensorProduct R_U A_X A_bar
    let ι_A : A_X →+* T := Algebra.TensorProduct.includeLeftRingHom
    let ι_R : A_bar →+* T :=
      (Algebra.TensorProduct.includeRight (R := R_U) (A := A_X) (B := A_bar)).toRingHom
    have hPush_T : CategoryTheory.IsPushout
        φ_f_hom (CommRingCat.ofHom p_A)
        (CommRingCat.ofHom ι_A : R_WX ⟶ CommRingCat.of T)
        (CommRingCat.ofHom ι_R) :=
      CommRingCat.isPushout_tensorProduct R_U A_X A_bar
    let T_XR := AlgebraicGeometry.Spec (CommRingCat.of T)
    let p_L : T_XR ⟶ AlgebraicGeometry.Spec R_WX :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_A : R_WX ⟶ CommRingCat.of T)
    let p_R_spec : T_XR ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)
    have hpb_T : CategoryTheory.IsPullback p_L p_R_spec (j_WX ≫ f_X) g_A := by
      rw [← hφ_f_map]
      exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_T
    let ι_TXR : T_XR ⟶ X_A :=
      CategoryTheory.Limits.pullback.lift (p_L ≫ j_WX) p_R_spec
        (by rw [Category.assoc]; exact hpb_T.w)
    have hι_TXR_fst : ι_TXR ≫ fst_XR = p_L ≫ j_WX :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι_TXR_snd : ι_TXR ≫ snd_XR = p_R_spec :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_ι_outer : CategoryTheory.IsPullback
