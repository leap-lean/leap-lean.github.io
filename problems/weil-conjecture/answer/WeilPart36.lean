        obtain ⟨hb₁, hb₂⟩ := hker_Q b hb0
        have htmul_eq : a ⊗ₜ[R_U] r - ι_R (p_A (c_U (ε₀ a)) * r) = ι_A b * ι_R r := by
          have hsmul : (1 : A_X) ⊗ₜ[R_U] (p_A (c_U (ε₀ a)) * r) =
