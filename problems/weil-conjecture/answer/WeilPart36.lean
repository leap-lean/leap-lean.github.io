            algebraMap ↥B_bar R_bar (c_B i) := by
        intro i
        have hsub : n - i.1 = 1 + (n - 1 - i.1) := by omega
        rw [hsub, pow_add, pow_one, ← mul_assoc]
        conv_lhs => rw [hs_fac i]
        rw [map_mul, ← mul_assoc, hpairR i]
        dsimp [c_B]
        rw [hs_fac i]
        simp only [map_mul, map_pow]
      let G_B : Polynomial ↥B_bar :=
        Polynomial.X ^ n + ∑ i : Fin n, Polynomial.C (c_B i) * Polynomial.X ^ i.1
      have hGB_mon : G_B.Monic := Polynomial.monic_X_pow_add (hSumDegLt n c_B)
      let F_Ω : Polynomial Ω := F.map φ_R_Ω
      have hFΩ_mon : F_Ω.Monic := hF_mon.map φ_R_Ω
      have hF_sum : F = Polynomial.X ^ n +
          ∑ i : Fin n, Polynomial.C (F.coeff i.1) * Polynomial.X ^ i.1 := by
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow F]
        rw [Finset.sum_range_succ, add_comm]
        have hlc : F.coeff n = 1 := hF_mon.coeff_natDegree
        dsimp [n] at hlc ⊢
        rw [hlc, map_one, one_mul,
          ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (F.coeff j) * Polynomial.X ^ j) n]
      let M_Ω : Multiset Ω := F_Ω.roots
      have hM_Ω0 : F_Ω = (M_Ω.map (fun α => Polynomial.X - Polynomial.C α)).prod :=
        (IsAlgClosed.splits F_Ω).eq_prod_roots_of_monic hFΩ_mon
      have hMΩ_card : M_Ω.card = F.natDegree := by
        have hd1 : F_Ω.natDegree = F.natDegree := hF_mon.natDegree_map φ_R_Ω
        have hd2 : F_Ω.natDegree = M_Ω.card := by
          rw [hM_Ω0, Polynomial.natDegree_multiset_prod_X_sub_C_eq_card]
        exact hd2.symm.trans hd1
      have hRoot_int : ∀ α ∈ M_Ω, s.1.1 * α ∈ B_bar := by
        intro α hα
        have hα0 : Polynomial.eval α F_Ω = 0 := by
          rw [hM_Ω0, Polynomial.eval_multiset_prod, Multiset.map_map]
          apply Multiset.prod_eq_zero
          rw [Multiset.mem_map]
          exact ⟨α, hα, by simp⟩
        have hα_sum : α ^ n + ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1 = 0 := by
          dsimp [F_Ω] at hα0
          rw [Polynomial.eval_map] at hα0
          conv_lhs at hα0 => rw [hF_sum]
          simpa [Polynomial.eval₂_add, Polynomial.eval₂_finsetSum] using hα0
        have hInt_B : _root_.IsIntegral ↥B_bar (s.1.1 * α) := by
          refine ⟨G_B, hGB_mon, ?_⟩
          rw [← Polynomial.aeval_def]
          dsimp [G_B]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ i : Fin n,
              (Polynomial.aeval (s.1.1 * α)) (Polynomial.C (c_B i) * Polynomial.X ^ i.1) =
                s.1.1 ^ n * (φ_R_Ω (F.coeff i.1) * α ^ i.1) := by
            intro i
            rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
            have hci : (algebraMap ↥B_bar Ω) (c_B i) =
                φ_R_Ω (F.coeff i.1) * s.1.1 ^ (n - i.1) := by
              change (c_B i).1 = _
              rw [← hφ_B (c_B i), ← hc_eq i, map_mul, map_pow, hφ_B]
            rw [hci, mul_pow]
            have hpow : s.1.1 ^ (n - i.1) * s.1.1 ^ i.1 = s.1.1 ^ n := by
              rw [← pow_add, Nat.sub_add_cancel (le_of_lt i.2)]
            calc
              φ_R_Ω (F.coeff i.1) * s.1.1 ^ (n - i.1) * (s.1.1 ^ i.1 * α ^ i.1) =
                φ_R_Ω (F.coeff i.1) * ((s.1.1 ^ (n - i.1) * s.1.1 ^ i.1) * α ^ i.1) := by ring
              _ = φ_R_Ω (F.coeff i.1) * (s.1.1 ^ n * α ^ i.1) := by rw [hpow]
              _ = s.1.1 ^ n * (φ_R_Ω (F.coeff i.1) * α ^ i.1) := by ring
          simp_rw [hterm, ← Finset.mul_sum]
          rw [mul_pow]
          calc
            s.1.1 ^ n * α ^ n + s.1.1 ^ n * ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1 =
              s.1.1 ^ n * (α ^ n + ∑ i : Fin n, φ_R_Ω (F.coeff i.1) * α ^ i.1) := by ring
            _ = 0 := by rw [hα_sum, mul_zero]
        exact _root_.isIntegral_trans (s.1.1 * α) hInt_B
      let liftRoot : Ω → R_bar := fun α =>
        if hα : α ∈ M_Ω then IsLocalization.mk' R_bar ⟨s.1.1 * α, hRoot_int α hα⟩ s else 0
      have hlift_val : ∀ α ∈ M_Ω, φ_R_Ω (liftRoot α) = α := by
        intro α hα
        dsimp [liftRoot]
        rw [dif_pos hα]
        have hs_ne : s.1.1 ≠ 0 := by
          intro h0
          apply s.2
          have hs0 : s.1 = 0 := Subtype.ext h0
          rw [hs0]
          exact M_max.zero_mem
        apply mul_left_cancel₀ hs_ne
        have hspec := IsLocalization.mk'_spec' R_bar ⟨s.1.1 * α, hRoot_int α hα⟩ s
        have h1 := congrArg φ_R_Ω hspec
        rw [map_mul, hφ_B, hφ_B] at h1
        exact h1
      let M_R : Multiset R_bar := M_Ω.map liftRoot
      refine ⟨M_R, ?_, ?_⟩
      · dsimp [M_R]
        rw [Multiset.card_map, hMΩ_card]
      · apply Polynomial.map_injective φ_R_Ω hφ_inj
        change F_Ω = ((M_R.map (fun r => Polynomial.X - Polynomial.C r)).prod).map φ_R_Ω
        rw [hM_Ω0, Polynomial.map_multiset_prod]
        dsimp [M_R]
        rw [Multiset.map_map, Multiset.map_map]
        congr 1
        refine Multiset.map_congr rfl fun α hα => ?_
        simp [hlift_val α hα]

    have hHensel : HenselianLocalRing R_bar := by
      apply HenselianLocalRing.mk
      intro f hf_mon a₀ ha₀ _
      obtain ⟨M_R, _, hf_prod⟩ := hMonicSplits f hf_mon
      have hprod_mem : (M_R.map (fun r => a₀ - r)).prod ∈ IsLocalRing.maximalIdeal R_bar := by
        have hev : Polynomial.eval a₀ f = (M_R.map (fun r => a₀ - r)).prod := by
          rw [hf_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
          congr 1
          ext r
          simp
        rwa [← hev]
      have hPrimeMax : (IsLocalRing.maximalIdeal R_bar).IsPrime := inferInstance
      obtain ⟨d, hd_mem, hd_max⟩ :=
        (hPrimeMax.multiset_prod_mem_iff_exists_mem _).mp hprod_mem
      obtain ⟨r, hr_mem, rfl⟩ := Multiset.mem_map.mp hd_mem
      refine ⟨r, ?_, ?_⟩
      · rw [Polynomial.IsRoot.def, hf_prod, Polynomial.eval_multiset_prod, Multiset.map_map]
        apply Multiset.prod_eq_zero
        rw [Multiset.mem_map]
        exact ⟨r, hr_mem, by simp⟩
      · have hneg : r - a₀ = -(a₀ - r) := by ring
        rw [hneg]
        exact (IsLocalRing.maximalIdeal R_bar).neg_mem hd_max

    have hFactorX : ∀ (d : ℕ) (g : P), g.natDegree ≤ d → g ≠ 0 →
        ∃ (r : ℕ) (h : P), g = Polynomial.X ^ r * h ∧ Polynomial.eval 0 h ≠ 0 := by
      intro d
      induction d with
      | zero =>
        intro g hdeg hg_ne
        refine ⟨0, g, by simp, ?_⟩
        rw [Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero hdeg)] at hg_ne ⊢
        rw [Polynomial.eval_C]
        intro hc0
        exact hg_ne (by rw [hc0, map_zero])
      | succ d ih =>
        intro g hdeg hg_ne
        by_cases hg0 : Polynomial.eval 0 g = 0
        · have hdvd : Polynomial.X ∣ g := by
            have h1 : Polynomial.X - Polynomial.C 0 ∣ g := Polynomial.dvd_iff_isRoot.mpr hg0
            simpa using h1
          rcases hdvd with ⟨g₁, rfl⟩
          have hg₁_ne : g₁ ≠ 0 := right_ne_zero_of_mul hg_ne
          have hdeg_mul : (Polynomial.X * g₁).natDegree = 1 + g₁.natDegree := by
            rw [Polynomial.natDegree_mul Polynomial.X_ne_zero hg₁_ne, Polynomial.natDegree_X]
          obtain ⟨r₁, h, rfl, hh0⟩ := ih g₁ (by omega) hg₁_ne
          exact ⟨r₁ + 1, h, by rw [pow_succ', mul_assoc], hh0⟩
        · exact ⟨0, g, by simp, hg0⟩

    have hLocAway : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra := by
      let _ : Algebra R_bar Ω := φ_R_Ω.toAlgebra
      refine {
        map_units := ?_
        surj := ?_
        exists_of_eq := ?_
      }
      · rintro ⟨_, n, rfl⟩
        apply Ne.isUnit
        change φ_R_Ω (t_bar ^ n) ≠ 0
        rw [map_pow]
        refine pow_ne_zero n ?_
        intro h0
        exact ht_ne (hφ_inj (h0.trans (map_zero _).symm))
      · intro z
        have hz_int : _root_.IsIntegral K₀ z := Algebra.IsIntegral.isIntegral z
        let Q : Polynomial K₀ := minpoly K₀ z
        have hQ_mon : Q.Monic := minpoly.monic hz_int
        let m := Q.natDegree
        let pairK : Fin m → P × ↥(nonZeroDivisors P) :=
          fun i => Classical.choose (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
        have hpairK : ∀ i : Fin m,
            Q.coeff i.1 * algebraMap P K₀ (pairK i).2.1 = algebraMap P K₀ (pairK i).1 :=
          fun i => Classical.choose_spec (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
        let g_sub : ↥(nonZeroDivisors P) := ∏ i : Fin m, (pairK i).2
        let g : P := g_sub.1
        have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp g_sub.2
        let restK : Fin m → P := fun i => (∏ j ∈ Finset.univ.erase i, (pairK j).2).1
        have hg_fac : ∀ i : Fin m, g = (pairK i).2.1 * restK i := by
          intro i
          have h1 : (pairK i).2 * (∏ j ∈ Finset.univ.erase i, (pairK j).2) = g_sub :=
            Finset.mul_prod_erase Finset.univ (fun j => (pairK j).2) (Finset.mem_univ i)
          exact congrArg Subtype.val h1.symm
        let a_P : Fin m → P := fun i => (pairK i).1 * restK i * g ^ (m - 1 - i.1)
        have ha_eq : ∀ i : Fin m,
            Q.coeff i.1 * (algebraMap P K₀ g) ^ (m - i.1) = algebraMap P K₀ (a_P i) := by
          intro i
          have hsub : m - i.1 = 1 + (m - 1 - i.1) := by omega
          rw [hsub, pow_add, pow_one, ← mul_assoc]
          conv_lhs => rw [hg_fac i]
          rw [map_mul, ← mul_assoc, hpairK i]
          dsimp [a_P]
          rw [hg_fac i]
          simp only [map_mul, map_pow]
        let G_P : Polynomial P :=
          Polynomial.X ^ m + ∑ i : Fin m, Polynomial.C (a_P i) * Polynomial.X ^ i.1
        have hGP_mon : G_P.Monic := Polynomial.monic_X_pow_add (hSumDegLt m a_P)
        have hQ_sum : Q = Polynomial.X ^ m +
            ∑ i : Fin m, Polynomial.C (Q.coeff i.1) * Polynomial.X ^ i.1 := by
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow Q]
          rw [Finset.sum_range_succ, add_comm]
          have hlc : Q.coeff m = 1 := hQ_mon.coeff_natDegree
          dsimp [m] at hlc ⊢
          rw [hlc, map_one, one_mul,
            ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (Q.coeff j) * Polynomial.X ^ j) m]
        have hQz : z ^ m + ∑ i : Fin m, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1 = 0 := by
          have h0 : Polynomial.aeval z Q = 0 := minpoly.aeval K₀ z
          conv_lhs at h0 => rw [hQ_sum]
          simpa [map_sum] using h0
        let w : Ω := algebraMap P Ω g * z
        have hw_mem : w ∈ B_bar := by
          refine ⟨G_P, hGP_mon, ?_⟩
          rw [← Polynomial.aeval_def]
          dsimp [G_P]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ i : Fin m,
              (Polynomial.aeval w) (Polynomial.C (a_P i) * Polynomial.X ^ i.1) =
                (algebraMap P Ω g) ^ m * (algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by
            intro i
            rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
            have hai : algebraMap P Ω (a_P i) =
                algebraMap K₀ Ω (Q.coeff i.1) * (algebraMap P Ω g) ^ (m - i.1) := by
              rw [IsScalarTower.algebraMap_apply P K₀ Ω (a_P i), ← ha_eq i, map_mul, map_pow,
                ← IsScalarTower.algebraMap_apply P K₀ Ω g]
            rw [hai]
            dsimp [w]
            have hpow : (algebraMap P Ω g) ^ (m - i.1) * (algebraMap P Ω g * z) ^ i.1 =
                (algebraMap P Ω g) ^ m * z ^ i.1 := by
              rw [mul_pow, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (le_of_lt i.2)]
            calc
              algebraMap K₀ Ω (Q.coeff i.1) * (algebraMap P Ω g) ^ (m - i.1) *
                  (algebraMap P Ω g * z) ^ i.1 =
                algebraMap K₀ Ω (Q.coeff i.1) *
                  ((algebraMap P Ω g) ^ (m - i.1) * (algebraMap P Ω g * z) ^ i.1) := by ring
              _ = algebraMap K₀ Ω (Q.coeff i.1) * ((algebraMap P Ω g) ^ m * z ^ i.1) := by rw [hpow]
              _ = (algebraMap P Ω g) ^ m * (algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by ring
          simp_rw [hterm, ← Finset.mul_sum]
          dsimp [w]
          rw [mul_pow]
          calc
            (algebraMap P Ω g) ^ m * z ^ m +
                (algebraMap P Ω g) ^ m * ∑ i : Fin m, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1 =
              (algebraMap P Ω g) ^ m *
                (z ^ m + ∑ i : Fin m, algebraMap K₀ Ω (Q.coeff i.1) * z ^ i.1) := by ring
            _ = 0 := by rw [hQz, mul_zero]
        obtain ⟨r, h, hg_eq, hh0⟩ := hFactorX g.natDegree g (le_refl _) hg_ne
        have hh_not_M : algebraMap P ↥B_bar h ∉ M_max := by
          intro hhM
          have hh_comap : h ∈ Ideal.comap (algebraMap P ↥B_bar) M_max := hhM
          rw [hM, ← hm0_ker, RingHom.mem_ker] at hh_comap
          exact hh0 hh_comap
        let s_h : ↥M_max.primeCompl := ⟨algebraMap P ↥B_bar h, hh_not_M⟩
        let x_R : R_bar := IsLocalization.mk' R_bar ⟨w, hw_mem⟩ s_h
        refine ⟨(x_R, ⟨t_bar ^ r, r, rfl⟩), ?_⟩
        change z * φ_R_Ω (t_bar ^ r) = φ_R_Ω x_R
        have hh_Ω_ne : algebraMap P Ω h ≠ 0 := by
          intro h0
          have hh_zero : h = 0 := hinj_P_Ω (h0.trans (map_zero _).symm)
          rw [hh_zero, Polynomial.eval_zero] at hh0
          exact hh0 rfl
        apply mul_right_cancel₀ hh_Ω_ne
        have hxR_mul : φ_R_Ω x_R * algebraMap P Ω h = w := by
          have h1 : x_R * algebraMap ↥B_bar R_bar s_h.1 = algebraMap ↥B_bar R_bar ⟨w, hw_mem⟩ :=
            IsLocalization.mk'_spec R_bar ⟨w, hw_mem⟩ s_h
          have h2 := congrArg φ_R_Ω h1
          rw [map_mul, hφ_B, hφ_B] at h2
          exact h2
        have ht_Ω : φ_R_Ω (t_bar ^ r) = (algebraMap P Ω Polynomial.X) ^ r := by
          rw [map_pow]
          congr 1
          exact RingHom.congr_fun hφ_comp Polynomial.X
        rw [hxR_mul, ht_Ω]
        dsimp [w]
        rw [hg_eq, map_mul, map_pow]
        ring
      · intro x y hxy
        exact ⟨⟨1, 0, pow_zero t_bar⟩, by simp [hφ_inj hxy]⟩

    exact ⟨p_Δ_R, φ_R_Ω,
      ⟨hDom_R, hHensel, hAlgClosedRes, ht_max, ht_ne, hp_Δ_R, hRes_Δ, hφ_Δ_eq, hφ_comp, hφ_inj,
        hLocAway⟩,
      hφ_B, hP_inj, hRes_surj⟩

  
  have hPart3 : ∀ (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
      (E : Type u) [CommRing E]
      (α_E : Polynomial k →+* E), α_E.Etale →
      ∀ (ρ : E →+* R_bar),
        ρ (α_E Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar →
        Function.Injective (ρ.comp α_E) →
        ∃ h_E : E,
          IsUnit (ρ h_E) ∧
          IsDomain (Localization.Away h_E) ∧
          ((algebraMap E (Localization.Away h_E)).comp α_E).Etale ∧
          ∀ (ρ₁ : Localization.Away h_E →+* R_bar),
            ρ₁.comp (algebraMap E (Localization.Away h_E)) = ρ →
            Function.Injective ρ₁ := by
    clear hPart2
    classical
    intro R_bar _ _ _ E _ α_E hα_et ρ hX_max hcomp_inj
    let P := Polynomial k
    let q : Ideal E := Ideal.comap ρ (IsLocalRing.maximalIdeal R_bar)
    have hq_prime : q.IsPrime := Ideal.comap_isPrime ρ (IsLocalRing.maximalIdeal R_bar)

    have hNoeth_and_ε : IsNoetherianRing E ∧
        ∃ ε : E →+* k, RingHom.ker ε = q ∧ ε.comp α_E = Polynomial.evalRingHom 0 := by
      have hNoethE : IsNoetherianRing E := by
        letI : Algebra P E := α_E.toAlgebra
        have : Algebra.Etale P E := RingHom.etale_algebraMap.mp hα_et
        letI : Algebra k E := (α_E.comp Polynomial.C).toAlgebra
        have : IsScalarTower k P E := IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.FiniteType k P := inferInstance
        have : Algebra.FiniteType P E := inferInstance
        have : Algebra.FiniteType k E :=
          Algebra.FiniteType.trans ‹Algebra.FiniteType k P› ‹Algebra.FiniteType P E›
        exact Algebra.FiniteType.isNoetherianRing k E
      let R₀ := MvPolynomial (Fin 1) k
      let e_mv : R₀ ≃ₐ[k] P := MvPolynomial.uniqueAlgEquiv k (Fin 1)
      let φ_R₀ : R₀ →+* E := α_E.comp e_mv.toRingHom
      have hφ_R₀_et : φ_R₀.Etale :=
        RingHom.Etale.stableUnderComposition e_mv.toRingHom α_E
          (RingHom.Etale.of_bijective e_mv.bijective) hα_et
      letI : Algebra R₀ k := MvPolynomial.constantCoeff.toAlgebra
      letI : Algebra R₀ E := φ_R₀.toAlgebra
      have : Algebra.Etale R₀ E := RingHom.etale_algebraMap.mp hφ_R₀_et
      have : Algebra.Etale k (TensorProduct R₀ k E) := Algebra.Etale.baseChange R₀ E k
      obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k (TensorProduct R₀ k E)).mp inferInstance
      have : Finite I := hFinI
      letI : Fintype I := Fintype.ofFinite I
      letI : ∀ i, Field (L i) := hFieldL
      letI : ∀ i, Algebra k (L i) := hAlgL
      have : ∀ i, Module.Finite k (L i) := fun i => (hFinSep i).1
      have : Module.Finite k (∀ i : I, L i) := inferInstance
      have hFin_T : Module.Finite k (TensorProduct R₀ k E) :=
        Module.Finite.equiv Θ.symm.toLinearEquiv
      let Q_E := E ⧸ q
      have : IsDomain Q_E := Ideal.Quotient.isDomain q
      letI : Algebra k Q_E := ((Ideal.Quotient.mk q).comp (α_E.comp Polynomial.C)).toAlgebra
      let f_k : k →ₐ[R₀] Q_E :=
        { toRingHom := algebraMap k Q_E
          commutes' := fun p₀ => by
            have hcomm :
                (algebraMap k Q_E).comp MvPolynomial.constantCoeff =
                  ((Ideal.Quotient.mk q).comp α_E).comp e_mv.toRingHom := by
              apply MvPolynomial.ringHom_ext
              · intro c
                change algebraMap k Q_E (MvPolynomial.constantCoeff (MvPolynomial.C c)) =
                  Ideal.Quotient.mk q (α_E (e_mv (MvPolynomial.C c)))
                rw [MvPolynomial.constantCoeff_C, ← MvPolynomial.algebraMap_eq,
                  e_mv.commutes c, Polynomial.algebraMap_eq]
                rfl
              · intro i
                fin_cases i
                change algebraMap k Q_E (MvPolynomial.constantCoeff (MvPolynomial.X 0)) =
                  Ideal.Quotient.mk q (α_E (e_mv (MvPolynomial.X 0)))
                have heX : e_mv (MvPolynomial.X 0) = Polynomial.X := by
                  simp [e_mv, MvPolynomial.uniqueAlgEquiv]
                rw [MvPolynomial.constantCoeff_X, map_zero, heX]
                have hXq : α_E Polynomial.X ∈ q := hX_max
                exact (Ideal.Quotient.eq_zero_iff_mem.mpr hXq).symm
            exact RingHom.congr_fun hcomm p₀ }
      letI : Algebra R₀ Q_E := (((Ideal.Quotient.mk q).comp α_E).comp e_mv.toRingHom).toAlgebra
      let f_k' : k →ₐ[R₀] Q_E :=
        { toRingHom := algebraMap k Q_E
          commutes' := f_k.commutes' }
      let f_E' : E →ₐ[R₀] Q_E :=
        { toRingHom := Ideal.Quotient.mk q
          commutes' := fun _ => rfl }
      let π_T : TensorProduct R₀ k E →+* Q_E :=
        (Algebra.TensorProduct.productMap f_k' f_E').toRingHom
      let π_lin : TensorProduct R₀ k E →ₗ[k] Q_E :=
        { toFun := π_T
          map_add' := π_T.map_add
          map_smul' := fun c t => by
            rw [RingHom.id_apply, Algebra.smul_def, Algebra.smul_def, map_mul]
            congr 1
            change (Algebra.TensorProduct.productMap f_k' f_E') (c ⊗ₜ[R₀] (1 : E)) = algebraMap k Q_E c
            simp [f_k'] }
      have hπ_surj : Function.Surjective π_lin := by
        intro y
        obtain ⟨e, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨(1 : k) ⊗ₜ[R₀] e, by simp [π_lin, π_T, f_E']⟩
      have : Module.Finite k Q_E := Module.Finite.of_surjective π_lin hπ_surj
      have hSurj_k_QE : Function.Surjective (algebraMap k Q_E) := by
        intro y
        have hy_int : _root_.IsIntegral k y := Algebra.IsIntegral.isIntegral y
        let m_y := minpoly k y
        have hm_deg : m_y.degree ≠ 0 :=
          ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root m_y hm_deg
        obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
        have hq_unit : IsUnit q_pol :=
          ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
            (Polynomial.not_isUnit_X_sub_C c)
        have hq_monic : q_pol.Monic :=
          Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
            (hq_pol ▸ minpoly.monic hy_int)
        have hq1 : q_pol = 1 := by
          have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
          have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
          rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
        have hm_eq : m_y = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
        have haeval : Polynomial.aeval y m_y = 0 := minpoly.aeval k y
        rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
        exact ⟨c, haeval.symm⟩
      let e_kq : k ≃+* Q_E :=
        RingEquiv.ofBijective (algebraMap k Q_E) ⟨RingHom.injective _, hSurj_k_QE⟩
      let ε : E →+* k := e_kq.symm.toRingHom.comp (Ideal.Quotient.mk q)
      have hker_ε : RingHom.ker ε = q := by
        ext e
        rw [RingHom.mem_ker]
        change e_kq.symm (Ideal.Quotient.mk q e) = 0 ↔ e ∈ q
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact ⟨fun h => by simpa using congrArg e_kq h, fun h => by simp [h]⟩
      have hε_α : ε.comp α_E = Polynomial.evalRingHom 0 := by
        apply Polynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
          exact e_kq.symm_apply_apply c
        · have hXq : α_E Polynomial.X ∈ q := hX_max
          change e_kq.symm (Ideal.Quotient.mk q (α_E Polynomial.X)) = Polynomial.eval 0 Polynomial.X
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hXq, map_zero, Polynomial.eval_X]
      exact ⟨hNoethE, ε, hker_ε, hε_α⟩

    obtain ⟨hNoethE, ε, hker_ε, hε_α⟩ := hNoeth_and_ε
    have : IsNoetherianRing E := hNoethE

    let S_q := Localization.AtPrime q
    let m_q : Ideal S_q := IsLocalRing.maximalIdeal S_q
    have : IsNoetherianRing S_q := IsLocalization.isNoetherianRing q.primeCompl S_q hNoethE
    have hDom_Sq : IsDomain S_q := by
      let ψ : P →+* S_q := (algebraMap E S_q).comp α_E
      let I₀ : Ideal P := Ideal.span {Polynomial.X}
      have hε_units : ∀ y : q.primeCompl, IsUnit (ε y.1) := by
        intro y
        refine IsUnit.mk0 (ε y.1) ?_
        intro h0
        have hyq : y.1 ∈ RingHom.ker ε := h0
        rw [hker_ε] at hyq
        exact y.2 hyq
      let ε_loc : S_q →+* k := IsLocalization.lift (M := q.primeCompl) (g := ε) hε_units
      have hε_loc_comp : ε_loc.comp (algebraMap E S_q) = ε :=
        RingHom.ext fun e => IsLocalization.lift_eq (M := q.primeCompl) hε_units e
      have hε_ψ : ε_loc.comp ψ = Polynomial.evalRingHom 0 := by
        change (ε_loc.comp (algebraMap E S_q)).comp α_E = Polynomial.evalRingHom 0
        rw [hε_loc_comp]
        exact hε_α
      have hε_surj : Function.Surjective ε_loc := by
        intro c
        refine ⟨ψ (Polynomial.C c), ?_⟩
        change (ε_loc.comp ψ) (Polynomial.C c) = c
        rw [hε_ψ]
        exact Polynomial.eval_C
      have hker_εloc : RingHom.ker ε_loc = m_q :=
        IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ε_loc hε_surj)

      letI : Algebra P E := α_E.toAlgebra
      have : Algebra.Etale P E := RingHom.etale_algebraMap.mp hα_et
      have : Algebra.FormallyEtale P E := inferInstance
      have : Algebra.FormallyEtale E S_q := Algebra.FormallyEtale.of_isLocalization q.primeCompl
      have : Algebra.FormallyEtale P S_q := Algebra.FormallyEtale.comp P E S_q
      have hψ_alg : algebraMap P S_q = ψ := IsScalarTower.algebraMap_eq P E S_q

      let J : Ideal S_q := Ideal.map ψ I₀
      have hJ_span : J = Ideal.span {ψ Polynomial.X} := by
        dsimp [J, I₀]
        rw [Ideal.map_span, Set.image_singleton]
      have hJ_le : J ≤ m_q := by
        rw [hJ_span, Ideal.span_singleton_le_iff_mem, ← hker_εloc, RingHom.mem_ker]
        change (ε_loc.comp ψ) Polynomial.X = 0
        rw [hε_ψ]
        exact Polynomial.eval_X
      let L : Ideal S_q := J ⊔ m_q ^ 2
      let Q := S_q ⧸ L
      let M : Ideal Q := Ideal.map (Ideal.Quotient.mk L) m_q
      have hM2 : M ^ 2 = ⊥ := by
        dsimp [M]
        rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
        exact le_sup_right
      have hg₂_comm_hom :
          ((Ideal.Quotient.mk L).comp (ψ.comp Polynomial.C)).comp (ε_loc.comp ψ) =
            (Ideal.Quotient.mk L).comp ψ := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [hε_ψ]
        · have hX_L : ψ Polynomial.X ∈ L :=
            (le_sup_left : J ≤ L) (by rw [hJ_span]; exact Ideal.subset_span rfl)
          have hmk0 : Ideal.Quotient.mk L (ψ Polynomial.X) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hX_L
          change Ideal.Quotient.mk L (ψ (Polynomial.C ((ε_loc.comp ψ) Polynomial.X))) =
            Ideal.Quotient.mk L (ψ Polynomial.X)
          rw [hε_ψ, Polynomial.coe_evalRingHom, Polynomial.eval_X, map_zero, map_zero, map_zero, hmk0]
      let g₁ : S_q →ₐ[P] Q := Ideal.Quotient.mkₐ P L
      let g₂ : S_q →ₐ[P] Q :=
        { toRingHom := ((Ideal.Quotient.mk L).comp (ψ.comp Polynomial.C)).comp ε_loc
          commutes' := fun p => by
            have halgQ : algebraMap P Q p = Ideal.Quotient.mk L (ψ p) := by
              rw [IsScalarTower.algebraMap_apply P S_q Q p, hψ_alg]
              rfl
            rw [halgQ]
            change (((Ideal.Quotient.mk L).comp (ψ.comp Polynomial.C)).comp ε_loc)
              (algebraMap P S_q p) = Ideal.Quotient.mk L (ψ p)
            rw [hψ_alg]
            exact RingHom.congr_fun hg₂_comm_hom p }
      have hg_comp : (Ideal.Quotient.mkₐ P M).comp g₁ = (Ideal.Quotient.mkₐ P M).comp g₂ := by
        apply AlgHom.ext
        intro z
        change Ideal.Quotient.mk M (g₁ z) = Ideal.Quotient.mk M (g₂ z)
        rw [Ideal.Quotient.eq]
        have hz_mem : z - ψ (Polynomial.C (ε_loc z)) ∈ m_q := by
          rw [← hker_εloc, RingHom.mem_ker, map_sub]
          have hc : ε_loc (ψ (Polynomial.C (ε_loc z))) = ε_loc z := by
            change (ε_loc.comp ψ) (Polynomial.C (ε_loc z)) = ε_loc z
            rw [hε_ψ]
            exact Polynomial.eval_C
          rw [hc, sub_self]
        exact Ideal.mem_map_of_mem (Ideal.Quotient.mk L) hz_mem
      have hg_eq : g₁ = g₂ := (Algebra.FormallyEtale.comp_bijective P S_q M hM2).1 hg_comp
      have hm_le_L : m_q ≤ J ⊔ m_q • m_q := by
        have hm_le_L' : m_q ≤ L := by
          intro z hz
          have hz0 : ε_loc z = 0 := by rwa [← hker_εloc] at hz
          have hmk : Ideal.Quotient.mk L z = 0 := by
            change g₁ z = 0
            rw [hg_eq]
            change Ideal.Quotient.mk L (ψ (Polynomial.C (ε_loc z))) = 0
            rw [hz0, map_zero, map_zero, map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mp hmk
        simpa only [L, pow_two, Ideal.smul_eq_mul] using hm_le_L'
      have hm_le_J : m_q ≤ J :=
        @Submodule.le_of_le_smul_of_le_jacobson_bot S_q S_q _ _ _ m_q J m_q
          (Ideal.fg_of_isNoetherianRing m_q)
          (IsLocalRing.maximalIdeal_le_jacobson (R := S_q) ⊥)
          hm_le_L
      have hJ_eq : J = m_q := le_antisymm hJ_le hm_le_J
      have hm_span : m_q = Ideal.span {ψ Polynomial.X} := hJ_eq.symm.trans hJ_span

      have hLift : ∀ s : ℕ,
          ∃ ψ_s : S_q →ₐ[P] (P ⧸ I₀ ^ (s + 1)),
            ∀ z ∈ m_q,
              Ideal.Quotient.factor
                (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.zero_le s))) (ψ_s z) = 0 := by
        intro s
        induction s with
        | zero =>
          have hψ₀_comm_hom :
              ((Ideal.Quotient.mk (I₀ ^ 1)).comp Polynomial.C).comp (ε_loc.comp ψ) =
                Ideal.Quotient.mk (I₀ ^ 1) := by
            apply Polynomial.ringHom_ext'
            · ext c
              simp [hε_ψ]
            · have hX : (Polynomial.X : P) ∈ I₀ ^ 1 := by
                rw [pow_one]
                exact Ideal.subset_span rfl
              have hmk0 : Ideal.Quotient.mk (I₀ ^ 1) Polynomial.X = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr hX
              change Ideal.Quotient.mk (I₀ ^ 1) (Polynomial.C ((ε_loc.comp ψ) Polynomial.X)) =
                Ideal.Quotient.mk (I₀ ^ 1) Polynomial.X
              rw [hε_ψ, Polynomial.coe_evalRingHom, Polynomial.eval_X, map_zero, map_zero, hmk0]
          let ψ_0 : S_q →ₐ[P] (P ⧸ I₀ ^ 1) :=
            { toRingHom := ((Ideal.Quotient.mk (I₀ ^ 1)).comp Polynomial.C).comp ε_loc
              commutes' := fun p => by
                change (((Ideal.Quotient.mk (I₀ ^ 1)).comp Polynomial.C).comp ε_loc)
                  (algebraMap P S_q p) = Ideal.Quotient.mk (I₀ ^ 1) p
                rw [hψ_alg]
                exact RingHom.congr_fun hψ₀_comm_hom p }
          refine ⟨ψ_0, fun z hz => ?_⟩
          have hz0 : ε_loc z = 0 := by rwa [← hker_εloc] at hz
          have hψ0_z : ψ_0 z = 0 := by
            change Ideal.Quotient.mk (I₀ ^ 1) (Polynomial.C (ε_loc z)) = 0
            rw [hz0, map_zero, map_zero]
          rw [hψ0_z, map_zero]
        | succ s ih =>
          obtain ⟨ψ_s, hψ_s⟩ := ih
          have hle : I₀ ^ (s + 2) ≤ I₀ ^ (s + 1) :=
            Ideal.pow_le_pow_right (Nat.le_succ (s + 1))
          let π_s : (P ⧸ I₀ ^ (s + 2)) →ₐ[P] (P ⧸ I₀ ^ (s + 1)) :=
            { toRingHom := Ideal.Quotient.factor hle
              commutes' := fun _ => rfl }
          have hπ_surj : Function.Surjective π_s.toRingHom := fun x => by
            obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
            exact ⟨Ideal.Quotient.mk (I₀ ^ (s + 2)) p, rfl⟩
          let K_s : Ideal (P ⧸ I₀ ^ (s + 2)) := RingHom.ker π_s.toRingHom
          have hKs2 : K_s ^ 2 = ⊥ := by
            have hKs_le : K_s ≤ Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 2))) (I₀ ^ (s + 1)) := by
              intro x hx
              obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
              exact Ideal.mem_map_of_mem _ (Ideal.Quotient.eq_zero_iff_mem.mp hx)
            have hpow_le : K_s ^ 2 ≤
                (Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 2))) (I₀ ^ (s + 1))) ^ 2 :=
              Ideal.pow_right_mono hKs_le 2
            rw [← Ideal.map_pow, ← pow_mul] at hpow_le
            have hexp : s + 2 ≤ (s + 1) * 2 := by omega
            have hbot : Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 2))) (I₀ ^ ((s + 1) * 2)) = ⊥ := by
              rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
              exact Ideal.pow_le_pow_right hexp
            exact eq_bot_iff.mpr (hpow_le.trans (le_of_eq hbot))
          let e_ring := RingHom.quotientKerEquivOfSurjective hπ_surj
          let e_inv : (P ⧸ I₀ ^ (s + 1)) →ₐ[P] ((P ⧸ I₀ ^ (s + 2)) ⧸ K_s) :=
            { toRingHom := e_ring.symm.toRingHom
              commutes' := fun r => by
                apply e_ring.injective
                change e_ring (e_ring.symm (algebraMap P (P ⧸ I₀ ^ (s + 1)) r)) =
                  e_ring (Ideal.Quotient.mk K_s (algebraMap P (P ⧸ I₀ ^ (s + 2)) r))
                rw [e_ring.apply_symm_apply]
                rfl }
          obtain ⟨ψ_next, hψ_next⟩ :=
            (Algebra.FormallyEtale.comp_bijective P S_q K_s hKs2).2 (e_inv.comp ψ_s)
          refine ⟨ψ_next, fun z hz => ?_⟩
          have hπ_eq : π_s (ψ_next z) = ψ_s z := by
            have hz_comp := AlgHom.congr_fun hψ_next z
            exact (congrArg e_ring hz_comp).trans (e_ring.apply_symm_apply (ψ_s z))
          have hfac_comp :
              Ideal.Quotient.factor
                (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.zero_le (s + 1)))) (ψ_next z) =
              Ideal.Quotient.factor
                (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.zero_le s))) (π_s (ψ_next z)) := by
            obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (ψ_next z)
            rw [← hp]
            rfl
          rw [hfac_comp, hπ_eq]
          exact hψ_s z hz

      have hPowX_ne_zero : ∀ r : ℕ, (ψ Polynomial.X) ^ r ≠ 0 := by
        intro r hr0
        obtain ⟨ψ_r, _⟩ := hLift r
        have hcomm : ψ_r.toRingHom (ψ (Polynomial.X ^ r)) =
            Ideal.Quotient.mk (I₀ ^ (r + 1)) (Polynomial.X ^ r) := by
          rw [← RingHom.congr_fun hψ_alg (Polynomial.X ^ r)]
          exact ψ_r.commutes (Polynomial.X ^ r)
        rw [map_pow, hr0, map_zero] at hcomm
        have hmem : (Polynomial.X ^ r : P) ∈ I₀ ^ (r + 1) :=
          Ideal.Quotient.eq_zero_iff_mem.mp hcomm.symm
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hmem
        have hdeg := Polynomial.natDegree_le_of_dvd hmem (pow_ne_zero r Polynomial.X_ne_zero)
        rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X_pow] at hdeg
        omega

      have hiInf : ⨅ n : ℕ, m_q ^ n = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing m_q (IsLocalRing.maximalIdeal.isMaximal S_q).ne_top
      have hUnitPow : ∀ z : S_q, z ≠ 0 → ∃ (u : S_qˣ) (a : ℕ), z = ↑u * (ψ Polynomial.X) ^ a := by
        intro z hz
        have hnot_all : ∃ n : ℕ, z ∉ m_q ^ (n + 1) := by
          by_contra! hall
          have hz_bot : z ∈ (⨅ n : ℕ, m_q ^ n) := by
            rw [Ideal.mem_iInf]
            intro n
            rcases n with _ | n
            · rw [pow_zero, Ideal.one_eq_top]; trivial
            · exact hall n
          rw [hiInf, Ideal.mem_bot] at hz_bot
          exact hz hz_bot
        let a := Nat.find hnot_all
        have hza1 : z ∉ m_q ^ (a + 1) := Nat.find_spec hnot_all
        have hza : z ∈ m_q ^ a := by
          by_cases ha0 : a = 0
          · rw [ha0, pow_zero, Ideal.one_eq_top]; trivial
          · obtain ⟨b, hb⟩ := Nat.exists_eq_succ_of_ne_zero ha0
            have hmin := Nat.find_min hnot_all (hb ▸ Nat.lt_succ_self b)
            rw [hb]
            exact not_not.mp hmin
        rw [hm_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hza
        obtain ⟨u₀, hu₀⟩ := hza
        have hu₀_not_m : u₀ ∉ m_q := by
          intro hum
          rw [hm_span, Ideal.mem_span_singleton'] at hum
          obtain ⟨v, rfl⟩ := hum
          apply hza1
          rw [hm_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
          exact ⟨v, by rw [pow_succ', ← mul_assoc, hu₀]⟩
        have hu₀_unit : IsUnit u₀ := by
          rwa [← IsLocalRing.notMem_maximalIdeal]
        exact ⟨hu₀_unit.unit, a, hu₀.symm⟩

      have : Nontrivial S_q := ⟨⟨1, 0, by simp [hPowX_ne_zero 0]⟩⟩
      have : NoZeroDivisors S_q :=
        { eq_zero_or_eq_zero_of_mul_eq_zero := fun {x y} hxy => by
            by_contra! hne
            obtain ⟨hx_ne, hy_ne⟩ := hne
            obtain ⟨ux, a, rfl⟩ := hUnitPow x hx_ne
            obtain ⟨uy, b, rfl⟩ := hUnitPow y hy_ne
            have hmul : (↑(ux * uy) : S_q) * (ψ Polynomial.X) ^ (a + b) = 0 := by
              calc
                (↑(ux * uy) : S_q) * (ψ Polynomial.X) ^ (a + b) =
                  (↑ux * (ψ Polynomial.X) ^ a) * (↑uy * (ψ Polynomial.X) ^ b) := by
                    rw [Units.val_mul, pow_add]; ring
                _ = 0 := hxy
            have hpow0 : (ψ Polynomial.X) ^ (a + b) = 0 := by
              have h1 := congrArg ((↑(ux * uy)⁻¹ : S_q) * ·) hmul
              simpa [← mul_assoc] using h1
            exact hPowX_ne_zero (a + b) hpow0 }
      exact NoZeroDivisors.to_isDomain S_q

    let K_ker : Ideal E := RingHom.ker (algebraMap E S_q)
    have hK_fg : K_ker.FG := Ideal.fg_of_isNoetherianRing K_ker
    obtain ⟨S_fin, hS_span⟩ := hK_fg
    have hAnn_mem : ∀ z ∈ S_fin, ∃ s : q.primeCompl, s.1 * z = 0 := by
      intro z hz
      have hz_mem : z ∈ K_ker := hS_span ▸ Ideal.subset_span hz
      have hz_ker : algebraMap E S_q z = 0 := RingHom.mem_ker.mp hz_mem
      obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl S_q z).mp hz_ker
      exact ⟨s, hs⟩
    let s_choose : {z // z ∈ S_fin} → q.primeCompl := fun z => Classical.choose (hAnn_mem z.1 z.2)
    have hs_choose : ∀ z : {z // z ∈ S_fin}, (s_choose z).1 * z.1 = 0 :=
      fun z => Classical.choose_spec (hAnn_mem z.1 z.2)
    let s_prod : q.primeCompl := ∏ z ∈ S_fin.attach, s_choose z
    let h_E : E := s_prod.1
    have hhE_not_q : h_E ∉ q := s_prod.2
    have hhE_unit : IsUnit (ρ h_E) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      exact hhE_not_q
    have hAnn_all : ∀ w ∈ K_ker, h_E * w = 0 := by
      intro w hw
      rw [← hS_span] at hw
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
      · intro z hz
        have hdvd : (s_choose ⟨z, hz⟩).1 ∣ h_E := by
          have hdvd_sub : s_choose ⟨z, hz⟩ ∣ s_prod :=
            Finset.dvd_prod_of_mem s_choose (Finset.mem_attach S_fin ⟨z, hz⟩)
          rcases hdvd_sub with ⟨t, ht⟩
          exact ⟨t.1, congrArg Subtype.val ht⟩
        rcases hdvd with ⟨t, ht⟩
        calc
          h_E * z = t * ((s_choose ⟨z, hz⟩).1 * z) := by rw [ht]; ring
          _ = 0 := by rw [hs_choose ⟨z, hz⟩, mul_zero]
      · exact mul_zero h_E
      · intro w₁ w₂ _ _ hw₁ hw₂
        rw [mul_add, hw₁, hw₂, add_zero]
      · intro e w₀ _ hw₀
        calc
          h_E * (e • w₀) = e * (h_E * w₀) := by rw [smul_eq_mul]; ring
          _ = 0 := by rw [hw₀, mul_zero]

    let E₁ := Localization.Away h_E
    have hUnit_hE_Sq : IsUnit (algebraMap E S_q h_E) := IsLocalization.map_units S_q s_prod
    let ι_E₁_Sq : E₁ →+* S_q := IsLocalization.Away.lift (S := E₁) h_E hUnit_hE_Sq
    have hι_E₁_inj : Function.Injective ι_E₁_Sq := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨n, a, hza'⟩ := IsLocalization.Away.surj h_E z
      have ha_ker : a ∈ K_ker := by
        rw [RingHom.mem_ker]
        have h1 := congrArg ι_E₁_Sq hza'
        rw [← map_pow, map_mul, hz, zero_mul, IsLocalization.Away.lift_eq] at h1
        exact h1.symm
      have hha0 : h_E * a = 0 := hAnn_all a ha_ker
      have hz_mul : z * algebraMap E E₁ (h_E ^ (n + 1)) = 0 := by
        calc
          z * algebraMap E E₁ (h_E ^ (n + 1)) =
            (z * algebraMap E E₁ h_E ^ n) * algebraMap E E₁ h_E := by
              rw [pow_succ, map_mul, map_pow, mul_assoc]
          _ = algebraMap E E₁ (h_E * a) := by rw [hza', ← map_mul, mul_comm]
          _ = 0 := by rw [hha0, map_zero]
      have hpow_unit : IsUnit (algebraMap E E₁ (h_E ^ (n + 1))) := by
        rw [map_pow]
        exact (IsLocalization.Away.algebraMap_isUnit (S := E₁) h_E).pow (n + 1)
      exact hpow_unit.mul_left_eq_zero.mp hz_mul

    have : IsDomain S_q := hDom_Sq
    have hDom_E₁ : IsDomain E₁ := Function.Injective.isDomain ι_E₁_Sq hι_E₁_inj
    have : IsDomain E₁ := hDom_E₁
    let α₁ : P →+* E₁ := (algebraMap E E₁).comp α_E
    have hα₁_et : α₁.Etale :=
      RingHom.Etale.stableUnderComposition α_E (algebraMap E E₁) hα_et
        (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway h_E))

    refine ⟨h_E, hhE_unit, hDom_E₁, hα₁_et, ?_⟩
    intro ρ₁ hρ₁_comp
    have hρ₁_α₁ : ρ₁.comp α₁ = ρ.comp α_E := by
      dsimp [α₁]
      rw [← RingHom.comp_assoc, hρ₁_comp]
    let K₀ := FractionRing P
    letI : Algebra P E₁ := α₁.toAlgebra
    have : Algebra.Etale P E₁ := RingHom.etale_algebraMap.mp hα₁_et
    have : Module.Flat P E₁ := inferInstance
    have : Algebra.Etale K₀ (TensorProduct P K₀ E₁) := Algebra.Etale.baseChange P E₁ K₀
    obtain ⟨I₁, hFinI₁, L₁, hFieldL₁, hAlgL₁, Θ₁, hFinSep₁⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ (TensorProduct P K₀ E₁)).mp inferInstance
    have : Finite I₁ := hFinI₁
    letI : Fintype I₁ := Fintype.ofFinite I₁
    letI : ∀ i, Field (L₁ i) := hFieldL₁
    letI : ∀ i, Algebra K₀ (L₁ i) := hAlgL₁
    have : ∀ i, Module.Finite K₀ (L₁ i) := fun i => (hFinSep₁ i).1
    have : Module.Finite K₀ (∀ i : I₁, L₁ i) := inferInstance
    have : Module.Finite K₀ (TensorProduct P K₀ E₁) :=
      Module.Finite.equiv Θ₁.symm.toLinearEquiv

    have hinj_tmul : Function.Injective (fun y : E₁ => (1 : K₀) ⊗ₜ[P] y) := by
      let f_PK : P →ₗ[P] K₀ := Algebra.linearMap P K₀
      have hf_PK_inj : Function.Injective f_PK := IsFractionRing.injective P K₀
      have hr_inj : Function.Injective (LinearMap.rTensor E₁ f_PK) :=
        Module.Flat.rTensor_preserves_injective_linearMap f_PK hf_PK_inj
      intro y₁ y₂ hy
      have h1 : LinearMap.rTensor E₁ f_PK ((1 : P) ⊗ₜ[P] y₁) =
          LinearMap.rTensor E₁ f_PK ((1 : P) ⊗ₜ[P] y₂) := by
        simpa [f_PK] using hy
      have h2 := hr_inj h1
      have h3 := congrArg (TensorProduct.lid P E₁) h2
      simpa using h3

    have hDivX : ∀ (d : ℕ) (G : Polynomial P), G.natDegree ≤ d → G ≠ 0 →
        ∃ (r : ℕ) (H : Polynomial P), G = Polynomial.X ^ r * H ∧ H.coeff 0 ≠ 0 := by
      intro d
      induction d with
      | zero =>
        intro G hdeg hG_ne
        refine ⟨0, G, by simp, ?_⟩
        intro hc0
        apply hG_ne
        rw [Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero hdeg), hc0, map_zero]
      | succ d ih =>
        intro G hdeg hG_ne
        by_cases hc0 : G.coeff 0 = 0
        · obtain ⟨G₁, rfl⟩ := Polynomial.X_dvd_iff.mpr hc0
          have hG₁_ne : G₁ ≠ 0 := right_ne_zero_of_mul hG_ne
          have hdeg_mul : (Polynomial.X * G₁).natDegree = 1 + G₁.natDegree := by
            rw [Polynomial.natDegree_mul Polynomial.X_ne_zero hG₁_ne, Polynomial.natDegree_X]
          obtain ⟨r₁, H, rfl, hH0⟩ := ih G₁ (by omega) hG₁_ne
          exact ⟨r₁ + 1, H, by rw [pow_succ', mul_assoc], hH0⟩
        · exact ⟨0, G, by simp, hc0⟩

    rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    rw [RingHom.mem_ker] at hx
    by_contra hx_ne
    let t_x : TensorProduct P K₀ E₁ := (1 : K₀) ⊗ₜ[P] x
    have htx_int : _root_.IsIntegral K₀ t_x := Algebra.IsIntegral.isIntegral t_x
    let Q : Polynomial K₀ := minpoly K₀ t_x
    have hQ_mon : Q.Monic := minpoly.monic htx_int
    let m := Q.natDegree
    let pairK : Fin m → P × ↥(nonZeroDivisors P) :=
      fun i => Classical.choose (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
    have hpairK : ∀ i : Fin m,
        Q.coeff i.1 * algebraMap P K₀ (pairK i).2.1 = algebraMap P K₀ (pairK i).1 :=
      fun i => Classical.choose_spec (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
    let s_sub : ↥(nonZeroDivisors P) := ∏ i : Fin m, (pairK i).2
    let s_P : P := s_sub.1
    have hsP_ne : s_P ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_sub.2
    let restK : Fin m → P := fun i => (∏ j ∈ Finset.univ.erase i, (pairK j).2).1
    have hsP_fac : ∀ i : Fin m, s_P = (pairK i).2.1 * restK i := by
      intro i
      have h1 : (pairK i).2 * (∏ j ∈ Finset.univ.erase i, (pairK j).2) = s_sub :=
        Finset.mul_prod_erase Finset.univ (fun j => (pairK j).2) (Finset.mem_univ i)
      exact congrArg Subtype.val h1.symm
    let c_P : Fin m → P := fun i => (pairK i).1 * restK i
    have hcP_eq : ∀ i : Fin m, Q.coeff i.1 * algebraMap P K₀ s_P = algebraMap P K₀ (c_P i) := by
      intro i
      conv_lhs => rw [hsP_fac i]
      rw [map_mul, ← mul_assoc, hpairK i]
      dsimp [c_P]
      rw [map_mul]
    let G : Polynomial P :=
      Polynomial.C s_P * Polynomial.X ^ m + ∑ i : Fin m, Polynomial.C (c_P i) * Polynomial.X ^ i.1
    have hG_ne : G ≠ 0 := by
      intro hG0
      have hdeg_low : (∑ i : Fin m, Polynomial.C (c_P i) * Polynomial.X ^ i.1).degree <
          (m : WithBot ℕ) := by
        by_cases hm0 : m = 0
        · simp [hm0]
        · have : 0 < m := Nat.pos_of_ne_zero hm0
          exact (Polynomial.degree_sum_fin_lt c_P).trans_le (le_refl _)
      have hcoeff_m : G.coeff m = s_P := by
        dsimp [G]
        rw [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_self, mul_one,
          Polynomial.coeff_eq_zero_of_degree_lt hdeg_low, add_zero]
      rw [hG0, Polynomial.coeff_zero] at hcoeff_m
      exact hsP_ne hcoeff_m.symm

    have hG_eval : Polynomial.eval₂ α₁ x G = 0 := by
      apply hinj_tmul
      change (1 : K₀) ⊗ₜ[P] Polynomial.eval₂ α₁ x G = (1 : K₀) ⊗ₜ[P] 0
      rw [TensorProduct.tmul_zero]
      have h0 : Polynomial.aeval t_x Q = 0 := minpoly.aeval K₀ t_x
      have hQ_sum : Q = Polynomial.X ^ m +
          ∑ i : Fin m, Polynomial.C (Q.coeff i.1) * Polynomial.X ^ i.1 := by
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow Q]
        rw [Finset.sum_range_succ, add_comm]
        have hlc : Q.coeff m = 1 := hQ_mon.coeff_natDegree
        dsimp [m] at hlc ⊢
        rw [hlc, map_one, one_mul,
          ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (Q.coeff j) * Polynomial.X ^ j) m]
      have h1 := congrArg (fun u : TensorProduct P K₀ E₁ => (algebraMap P K₀ s_P) • u) h0
      rw [smul_zero] at h1
      conv_lhs at h1 => rw [hQ_sum]
      rw [map_add, map_pow, Polynomial.aeval_X, map_sum, smul_add, Finset.smul_sum] at h1
      have htx_pow : ∀ n : ℕ, t_x ^ n = (1 : K₀) ⊗ₜ[P] (x ^ n) := by
        intro n
        induction n with
        | zero => rfl
        | succ n ih =>
          rw [pow_succ, pow_succ, ih]
          dsimp [t_x]
          rw [mul_one]
      have htmul_P : ∀ (s : P) (y : E₁),
          (algebraMap P K₀ s) ⊗ₜ[P] y = (1 : K₀) ⊗ₜ[P] (α₁ s * y) := by
        intro s y
        calc
          (algebraMap P K₀ s) ⊗ₜ[P] y
            = ((algebraMap P K₀ s) ⊗ₜ[P] (1 : E₁)) * ((1 : K₀) ⊗ₜ[P] y) := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          _ = ((1 : K₀) ⊗ₜ[P] (algebraMap P E₁ s)) * ((1 : K₀) ⊗ₜ[P] y) := by
                rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
          _ = (1 : K₀) ⊗ₜ[P] (α₁ s * y) := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]; rfl
      have hlead : (algebraMap P K₀ s_P) • (t_x ^ m) = (1 : K₀) ⊗ₜ[P] (α₁ s_P * x ^ m) := by
        rw [htx_pow m]
        change (algebraMap P K₀ s_P * 1) ⊗ₜ[P] (x ^ m) = _
        rw [mul_one]
        exact htmul_P s_P (x ^ m)
      have hterm : ∀ i : Fin m,
          (algebraMap P K₀ s_P) • ((Polynomial.aeval t_x) (Polynomial.C (Q.coeff i.1) * Polynomial.X ^ i.1)) =
            (1 : K₀) ⊗ₜ[P] (α₁ (c_P i) * x ^ i.1) := by
        intro i
        rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, htx_pow i.1]
        change (algebraMap P K₀ s_P) •
            ((Q.coeff i.1 ⊗ₜ[P] (1 : E₁)) * ((1 : K₀) ⊗ₜ[P] (x ^ i.1))) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        change (algebraMap P K₀ s_P * Q.coeff i.1) ⊗ₜ[P] (x ^ i.1) = _
        rw [mul_comm, hcP_eq i]
        exact htmul_P (c_P i) (x ^ i.1)
      rw [hlead] at h1
      simp_rw [hterm] at h1
      rw [← TensorProduct.tmul_sum, ← TensorProduct.tmul_add] at h1
      convert h1 using 2
      dsimp [G]
      simp [Polynomial.eval₂_add, Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul,
        Polynomial.eval₂_C, Polynomial.eval₂_X_pow]

    obtain ⟨r, H, hGH, hH0_ne⟩ := hDivX G.natDegree G (le_refl _) hG_ne
    rw [hGH, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hG_eval
    have hH_eval0 : Polynomial.eval₂ α₁ x H = 0 :=
      (mul_eq_zero.mp hG_eval).resolve_left (pow_ne_zero r hx_ne)
    have hρH : Polynomial.eval₂ (ρ₁.comp α₁) (ρ₁ x) H = 0 := by
      rw [← Polynomial.hom_eval₂ H α₁ ρ₁ x, hH_eval0, map_zero]
    rw [hρ₁_α₁, hx, Polynomial.eval₂_at_zero] at hρH
    exact hH0_ne (hcomp_inj (hρH.trans (map_zero _).symm))

  
  have hPart4 :
      ∀ [IsDomain (Localization.AtPrime M_max)]
        (φ_R_Ω : Localization.AtPrime M_max →+*
          AlgebraicClosure (FractionRing (Polynomial k)))
        (hφ_B : ∀ b : ↥(integralClosure (Polynomial k)
            (AlgebraicClosure (FractionRing (Polynomial k)))),
          φ_R_Ω (algebraMap _ (Localization.AtPrime M_max) b) = b.1)
        (hφ_comp : φ_R_Ω.comp (algebraMap (Polynomial k) (Localization.AtPrime M_max)) =
          algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))
        (hφ_inj : Function.Injective φ_R_Ω)
        (ht_max : algebraMap (Polynomial k) (Localization.AtPrime M_max) Polynomial.X ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime M_max))
        (ht_ne : algebraMap (Polynomial k) (Localization.AtPrime M_max) Polynomial.X ≠ 0)
        (hP_inj : Function.Injective (algebraMap (Polynomial k) (Localization.AtPrime M_max)))
        (hRes_surj : Function.Surjective
          ((IsLocalRing.residue (Localization.AtPrime M_max)).comp
            ((algebraMap (Polynomial k) (Localization.AtPrime M_max)).comp Polynomial.C)))
        (hEtShrink : ∀ (E : Type u) [CommRing E]
            (α_E : Polynomial k →+* E), α_E.Etale →
            ∀ (ρ : E →+* Localization.AtPrime M_max),
              ρ (α_E Polynomial.X) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime M_max) →
              Function.Injective (ρ.comp α_E) →
              ∃ h_E : E,
                IsUnit (ρ h_E) ∧
                IsDomain (Localization.Away h_E) ∧
                ((algebraMap E (Localization.Away h_E)).comp α_E).Etale ∧
                ∀ (ρ₁ : Localization.Away h_E →+* Localization.AtPrime M_max),
                  ρ₁.comp (algebraMap E (Localization.Away h_E)) = ρ →
                  Function.Injective ρ₁),
        let P := Polynomial k
        let R_bar := Localization.AtPrime M_max
        ∃ (ℐ : Type u) (hCat : CategoryTheory.SmallCategory ℐ)
            (hFilt : CategoryTheory.IsFiltered ℐ),
          letI : CategoryTheory.SmallCategory ℐ := hCat
          letI : CategoryTheory.IsFiltered ℐ := hFilt
          ∃ (D : ℐ ⥤ CommRingCat.{u})
            (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D)
            (c : CategoryTheory.Limits.Cocone D)
            (_ : CategoryTheory.Limits.IsColimit c)
            (e_pt : c.pt ≅ CommRingCat.of R_bar),
            (∀ i : ℐ,
              (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom (algebraMap P R_bar) ∧
              Function.Injective ((c.ι.app i) ≫ e_pt.hom).hom) ∧
            (∀ i : ℐ,
              ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ) (ψ_i : Polynomial k →+* ↑(D.obj i)),
                1 ≤ e ∧
                ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
                (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
                ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
                ψ_i Polynomial.X = ϖ ∧
                ψ_i.Etale ∧
                ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁)) (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
                  (D.map θ).hom ϖ = β ^ ℓ ∧
                  ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
                  ψ₁ Polynomial.X = β ∧
                  ψ₁.Etale) := by
    clear hPart2 hPart3 hM
    classical
    intro _ φ_R_Ω hφ_B hφ_comp hφ_inj ht_max ht_ne hP_inj hRes_surj hEtShrink

    
    have hStageAbstract : ∀ (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
        [Algebra (Polynomial k) R_bar],
        algebraMap (Polynomial k) R_bar Polynomial.X ∈ IsLocalRing.maximalIdeal R_bar →
        algebraMap (Polynomial k) R_bar Polynomial.X ≠ 0 →
        Function.Injective (algebraMap (Polynomial k) R_bar) →
        Function.Surjective
          ((IsLocalRing.residue R_bar).comp ((algebraMap (Polynomial k) R_bar).comp Polynomial.C)) →
        (∀ r : R_bar, ∃ β : R_bar, β ^ ℓ = r) →
        (∀ (E : Type u) [CommRing E]
            (α_E : Polynomial k →+* E), α_E.Etale →
            ∀ (ρ : E →+* R_bar),
              ρ (α_E Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar →
              Function.Injective (ρ.comp α_E) →
              ∃ h_E : E,
                IsUnit (ρ h_E) ∧
                IsDomain (Localization.Away h_E) ∧
                ((algebraMap E (Localization.Away h_E)).comp α_E).Etale ∧
                ∀ (ρ₁ : Localization.Away h_E →+* R_bar),
                  ρ₁.comp (algebraMap E (Localization.Away h_E)) = ρ →
                  Function.Injective ρ₁) →
        (∀ F : Finset R_bar,
            ∃ (C_ty : Type u) (_ : CommRing C_ty) (_ : IsDomain C_ty) (_ : IsIntegrallyClosed C_ty)
              (_ : Algebra (Polynomial k) C_ty) (_ : Algebra.IsIntegral (Polynomial k) C_ty)
              (_ : Algebra.FiniteType (Polynomial k) C_ty)
              (φ_C : C_ty →+* R_bar),
              Function.Injective φ_C ∧
              φ_C.comp (algebraMap (Polynomial k) C_ty) = algebraMap (Polynomial k) R_bar ∧
              ∀ w ∈ F, ∃ (a s : C_ty), IsUnit (φ_C s) ∧ w * φ_C s = φ_C a) →
        ∃ (ℐ : Type u) (hCat : CategoryTheory.SmallCategory ℐ)
            (hFilt : CategoryTheory.IsFiltered ℐ),
          letI : CategoryTheory.SmallCategory ℐ := hCat
          letI : CategoryTheory.IsFiltered ℐ := hFilt
          ∃ (D : ℐ ⥤ CommRingCat.{u})
            (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial k)) ⟶ D)
            (c : CategoryTheory.Limits.Cocone D)
            (_ : CategoryTheory.Limits.IsColimit c)
            (e_pt : c.pt ≅ CommRingCat.of R_bar),
            (∀ i : ℐ,
              (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom (algebraMap (Polynomial k) R_bar) ∧
              Function.Injective ((c.ι.app i) ≫ e_pt.hom).hom) ∧
            (∀ i : ℐ,
              ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ) (ψ_i : Polynomial k →+* ↑(D.obj i)),
                1 ≤ e ∧
                ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
                (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
                ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
                ψ_i Polynomial.X = ϖ ∧
                ψ_i.Etale ∧
                ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁)) (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
                  (D.map θ).hom ϖ = β ^ ℓ ∧
                  ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
                  ψ₁ Polynomial.X = β ∧
                  ψ₁.Etale) := by
      clear φ_R_Ω hφ_B hφ_comp hφ_inj ht_max ht_ne hP_inj hRes_surj hEtShrink
      intro R_bar _ _ _ _ ht_max ht_ne hP_inj hRes_surj hPow_surj hEtShrink hCurveCover
      let P := Polynomial k
      let t_bar : R_bar := algebraMap P R_bar Polynomial.X

      have hEtaleCompEquiv : ∀ (S₁ S₂ : Type u) [CommRing S₁] [CommRing S₂]
          (f : Polynomial k →+* S₁), f.Etale →
          ∀ (e : S₁ ≃+* S₂),
            (CommRingCat.ofHom (e.toRingHom.comp f)).hom.Etale := by
        intro S₁ S₂ _ _ f hf e
        exact RingHom.Etale.stableUnderComposition f e.toRingHom hf
          (RingHom.Etale.of_bijective e.bijective)

      have hMaxPrincipalOfEtale : ∀ (B₀ : Type u) [CommRing B₀] [IsNoetherianRing B₀]
          (ψ₀ : P →+* B₀), ψ₀.Etale →
          ∀ (q₀ : Ideal B₀) [q₀.IsPrime]
            (ε₀ : B₀ →+* k), RingHom.ker ε₀ = q₀ → ε₀.comp ψ₀ = Polynomial.evalRingHom 0 →
            IsLocalRing.maximalIdeal (Localization.AtPrime q₀) =
              Ideal.span {algebraMap B₀ (Localization.AtPrime q₀) (ψ₀ Polynomial.X)} := by
        intro B₀ _ hNoethB₀ ψ₀ hψ₀_et q₀ _ ε₀ hker_ε₀ hε₀_ψ₀
        let S₀ := Localization.AtPrime q₀
        let m₀ : Ideal S₀ := IsLocalRing.maximalIdeal S₀
        have : IsNoetherianRing S₀ := IsLocalization.isNoetherianRing q₀.primeCompl S₀ hNoethB₀
        let ψ : P →+* S₀ := (algebraMap B₀ S₀).comp ψ₀
        let I₀ : Ideal P := Ideal.span {Polynomial.X}
        have hε_units : ∀ y : q₀.primeCompl, IsUnit (ε₀ y.1) := by
          intro y
          refine IsUnit.mk0 (ε₀ y.1) ?_
          intro h0
          have hyq : y.1 ∈ RingHom.ker ε₀ := h0
          rw [hker_ε₀] at hyq
          exact y.2 hyq
        let ε_loc : S₀ →+* k := IsLocalization.lift (M := q₀.primeCompl) (g := ε₀) hε_units
        have hε_loc_comp : ε_loc.comp (algebraMap B₀ S₀) = ε₀ :=
          RingHom.ext fun b => IsLocalization.lift_eq (M := q₀.primeCompl) hε_units b
        have hε_ψ : ε_loc.comp ψ = Polynomial.evalRingHom 0 := by
          change (ε_loc.comp (algebraMap B₀ S₀)).comp ψ₀ = Polynomial.evalRingHom 0
          rw [hε_loc_comp]
          exact hε₀_ψ₀
        have hε_surj : Function.Surjective ε_loc := by
          intro c
          refine ⟨ψ (Polynomial.C c), ?_⟩
          change (ε_loc.comp ψ) (Polynomial.C c) = c
          rw [hε_ψ]
          exact Polynomial.eval_C
        have hker_εloc : RingHom.ker ε_loc = m₀ :=
          IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ε_loc hε_surj)

        let : Algebra P B₀ := ψ₀.toAlgebra
        have : Algebra.Etale P B₀ := (RingHom.etale_algebraMap (R := P) (S := B₀)).mp hψ₀_et
        have : Algebra.FormallyEtale P B₀ := inferInstance
        have : Algebra.FormallyEtale B₀ S₀ := Algebra.FormallyEtale.of_isLocalization q₀.primeCompl
        have : Algebra.FormallyEtale P S₀ := Algebra.FormallyEtale.comp P B₀ S₀
        have hψ_alg : algebraMap P S₀ = ψ := IsScalarTower.algebraMap_eq P B₀ S₀

        let J : Ideal S₀ := Ideal.map ψ I₀
        have hJ_span : J = Ideal.span {ψ Polynomial.X} := by
          dsimp [J, I₀]
          rw [Ideal.map_span, Set.image_singleton]
        have hJ_le : J ≤ m₀ := by
          rw [hJ_span, Ideal.span_singleton_le_iff_mem, ← hker_εloc, RingHom.mem_ker]
          change (ε_loc.comp ψ) Polynomial.X = 0
          rw [hε_ψ]
          exact Polynomial.eval_X
        let L_id : Ideal S₀ := J ⊔ m₀ ^ 2
        let Q := S₀ ⧸ L_id
        let M : Ideal Q := Ideal.map (Ideal.Quotient.mk L_id) m₀
        have hM2 : M ^ 2 = ⊥ := by
          dsimp [M]
          rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
          exact le_sup_right
        have hg₂_comm_hom :
            ((Ideal.Quotient.mk L_id).comp (ψ.comp Polynomial.C)).comp (ε_loc.comp ψ) =
              (Ideal.Quotient.mk L_id).comp ψ := by
          apply Polynomial.ringHom_ext'
          · ext c
            simp [hε_ψ]
          · have hX_L : ψ Polynomial.X ∈ L_id :=
              (le_sup_left : J ≤ L_id) (by rw [hJ_span]; exact Ideal.subset_span rfl)
            have hmk0 : Ideal.Quotient.mk L_id (ψ Polynomial.X) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr hX_L
            change Ideal.Quotient.mk L_id (ψ (Polynomial.C ((ε_loc.comp ψ) Polynomial.X))) =
              Ideal.Quotient.mk L_id (ψ Polynomial.X)
            rw [hε_ψ, Polynomial.coe_evalRingHom, Polynomial.eval_X, map_zero, map_zero, map_zero, hmk0]
        let g₁ : S₀ →ₐ[P] Q := Ideal.Quotient.mkₐ P L_id
        let g₂ : S₀ →ₐ[P] Q :=
          { toRingHom := ((Ideal.Quotient.mk L_id).comp (ψ.comp Polynomial.C)).comp ε_loc
            commutes' := fun p => by
              have halgQ : algebraMap P Q p = Ideal.Quotient.mk L_id (ψ p) := by
                rw [IsScalarTower.algebraMap_apply P S₀ Q p, hψ_alg]
                rfl
              rw [halgQ]
              change (((Ideal.Quotient.mk L_id).comp (ψ.comp Polynomial.C)).comp ε_loc)
                (algebraMap P S₀ p) = Ideal.Quotient.mk L_id (ψ p)
              rw [hψ_alg]
              exact RingHom.congr_fun hg₂_comm_hom p }
        have hg_comp : (Ideal.Quotient.mkₐ P M).comp g₁ = (Ideal.Quotient.mkₐ P M).comp g₂ := by
          apply AlgHom.ext
          intro z
          change Ideal.Quotient.mk M (g₁ z) = Ideal.Quotient.mk M (g₂ z)
          rw [Ideal.Quotient.eq]
          have hz_mem : z - ψ (Polynomial.C (ε_loc z)) ∈ m₀ := by
            rw [← hker_εloc, RingHom.mem_ker, map_sub]
            have hc : ε_loc (ψ (Polynomial.C (ε_loc z))) = ε_loc z := by
              change (ε_loc.comp ψ) (Polynomial.C (ε_loc z)) = ε_loc z
              rw [hε_ψ]
              exact Polynomial.eval_C
            rw [hc, sub_self]
          exact Ideal.mem_map_of_mem (Ideal.Quotient.mk L_id) hz_mem
        have hg_eq : g₁ = g₂ := (Algebra.FormallyEtale.comp_bijective P S₀ M hM2).1 hg_comp
        have hm_le_L : m₀ ≤ J ⊔ m₀ • m₀ := by
          have hm_le_L' : m₀ ≤ L_id := by
            intro z hz
            have hz0 : ε_loc z = 0 := by rwa [← hker_εloc] at hz
            have hmk : Ideal.Quotient.mk L_id z = 0 := by
              change g₁ z = 0
              rw [hg_eq]
              change Ideal.Quotient.mk L_id (ψ (Polynomial.C (ε_loc z))) = 0
              rw [hz0, map_zero, map_zero, map_zero]
            exact Ideal.Quotient.eq_zero_iff_mem.mp hmk
          simpa only [L_id, pow_two, Ideal.smul_eq_mul] using hm_le_L'
        have hm_le_J : m₀ ≤ J :=
          @Submodule.le_of_le_smul_of_le_jacobson_bot S₀ S₀ _ _ _ m₀ J m₀
            (Ideal.fg_of_isNoetherianRing m₀)
            (IsLocalRing.maximalIdeal_le_jacobson (R := S₀) ⊥)
            hm_le_L
        exact (le_antisymm hJ_le hm_le_J).symm.trans hJ_span

      have hFinGenOfEtale : ∀ (S : Type u) [CommRing S] (ψ : P →+* S), ψ.Etale →
          ∃ G : Finset S, ∀ s : S, s ∈ Subring.closure (Set.range (ψ.comp Polynomial.C) ∪ (G : Set S)) := by
        intro S _ ψ hψ
        let : Algebra P S := ψ.toAlgebra
        have : Algebra.Etale P S := (RingHom.etale_algebraMap (R := P) (S := S)).mp hψ
        let : Algebra k S := (ψ.comp Polynomial.C).toAlgebra
        have : IsScalarTower k P S := IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.FiniteType k P := inferInstance
        have : Algebra.FiniteType P S := inferInstance
        have hFT : Algebra.FiniteType k S :=
          Algebra.FiniteType.trans ‹Algebra.FiniteType k P› ‹Algebra.FiniteType P S›
        obtain ⟨G, hG⟩ := hFT.out
        refine ⟨G, fun s => ?_⟩
        have hs_top : s ∈ Algebra.adjoin k (G : Set S) := by
          rw [hG]
          trivial
        exact Algebra.adjoin_induction
          (fun g hg => Subring.subset_closure (Or.inr hg))
          (fun c => Subring.subset_closure (Or.inl ⟨c, rfl⟩))
          (fun _ _ _ _ hx hy => Subring.add_mem _ hx hy)
          (fun _ _ _ _ hx hy => Subring.mul_mem _ hx hy)
          hs_top

      have hKummerBaseChange : ∀ (B₀ R_bar₀ : Type u) [CommRing B₀] [CommRing R_bar₀]
          (ψ₀ : Polynomial k →+* B₀), ψ₀.Etale →
          ∀ (ι_B : B₀ →+* R_bar₀)
            (τ_β : Polynomial k →+* R_bar₀),
            ι_B.comp (ψ₀.comp Polynomial.C) = τ_β.comp Polynomial.C →
            (τ_β Polynomial.X) ^ ℓ = ι_B (ψ₀ Polynomial.X) →
            ∃ (E : Type u) (_ : CommRing E)
              (α_E : Polynomial k →+* E) (inr_E : B₀ →+* E) (ρ : E →+* R_bar₀),
              α_E.Etale ∧
              inr_E (ψ₀ Polynomial.X) = (α_E Polynomial.X) ^ ℓ ∧
              (∀ p : Polynomial k, ρ (α_E p) = τ_β p) ∧
              (∀ b : B₀, ρ (inr_E b) = ι_B b) := by
        intro B₀ R_bar₀ _ _ ψ₀ hψ₀_et ι_B τ_β hC_eq hX_pow
        let R₀ := MvPolynomial (Fin 1) k
        let e_mv : R₀ ≃ₐ[k] P := MvPolynomial.uniqueAlgEquiv k (Fin 1)
        let φ_B : R₀ →+* B₀ := ψ₀.comp e_mv.toRingHom
        have hφB_et : φ_B.Etale :=
          RingHom.Etale.stableUnderComposition e_mv.toRingHom ψ₀
            (RingHom.Etale.of_bijective e_mv.bijective) hψ₀_et
        let κ_R₀ : R₀ →+* P := (MvPolynomial.aeval (fun _ : Fin 1 => (Polynomial.X : P) ^ ℓ)).toRingHom
        let : Algebra R₀ P := κ_R₀.toAlgebra
        let : Algebra R₀ B₀ := φ_B.toAlgebra
        have : Algebra.Etale R₀ B₀ := (RingHom.etale_algebraMap (R := R₀) (S := B₀)).mp hφB_et
        let E := TensorProduct R₀ P B₀
        have hPE_et : Algebra.Etale P E := Algebra.Etale.baseChange R₀ B₀ P
        have hα_et := (RingHom.etale_algebraMap (R := P) (S := E)).mpr hPE_et
        let inr_alg : B₀ →ₐ[R₀] E := Algebra.TensorProduct.includeRight (R := R₀) (A := P) (B := B₀)
        have hcomm_R₀ : (τ_β.comp κ_R₀) = (ι_B.comp φ_B) := by
          apply MvPolynomial.ringHom_ext
          · intro c
            change τ_β (κ_R₀ (MvPolynomial.C c)) = ι_B (ψ₀ (e_mv (MvPolynomial.C c)))
            have hκC : κ_R₀ (MvPolynomial.C c) = Polynomial.C c := by
              change (MvPolynomial.aeval (fun _ : Fin 1 => (Polynomial.X : P) ^ ℓ)) (MvPolynomial.C c) =
                Polynomial.C c
              rw [MvPolynomial.aeval_C, Polynomial.algebraMap_eq]
            have heC : e_mv (MvPolynomial.C c) = Polynomial.C c := by
              rw [← MvPolynomial.algebraMap_eq, e_mv.commutes c, Polynomial.algebraMap_eq]
            rw [hκC, heC]
            exact (RingHom.congr_fun hC_eq c).symm
          · intro j
            fin_cases j
            change τ_β (κ_R₀ (MvPolynomial.X 0)) = ι_B (ψ₀ (e_mv (MvPolynomial.X 0)))
            have hκX : κ_R₀ (MvPolynomial.X 0) = Polynomial.X ^ ℓ :=
              MvPolynomial.aeval_X (fun _ : Fin 1 => (Polynomial.X : P) ^ ℓ) 0
            have heX : e_mv (MvPolynomial.X 0) = Polynomial.X := by
              simp [e_mv, MvPolynomial.uniqueAlgEquiv]
            rw [hκX, map_pow, heX]
            exact hX_pow
        let : Algebra R₀ R_bar₀ := (τ_β.comp κ_R₀).toAlgebra
        let f_P_R : P →ₐ[R₀] R_bar₀ :=
          { toRingHom := τ_β
            commutes' := fun _ => rfl }
        let f_B_R : B₀ →ₐ[R₀] R_bar₀ :=
          { toRingHom := ι_B
            commutes' := fun r => (RingHom.congr_fun hcomm_R₀ r).symm }
        let ρ_alg : E →ₐ[R₀] R_bar₀ := Algebra.TensorProduct.productMap f_P_R f_B_R
        refine ⟨E, inferInstance, algebraMap P E, inr_alg.toRingHom, ρ_alg.toRingHom,
          hα_et, ?_, ?_, ?_⟩
        · have heX : e_mv (MvPolynomial.X 0) = Polynomial.X := by
            simp [e_mv, MvPolynomial.uniqueAlgEquiv]
          have hψX : ψ₀ Polynomial.X = algebraMap R₀ B₀ (MvPolynomial.X 0) := by
            change ψ₀ Polynomial.X = ψ₀ (e_mv (MvPolynomial.X 0))
            rw [heX]
          rw [hψX]
          change (1 : P) ⊗ₜ[R₀] (algebraMap R₀ B₀ (MvPolynomial.X 0)) =
            (algebraMap P E Polynomial.X) ^ ℓ
          rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul]
          have hκX : algebraMap R₀ P (MvPolynomial.X 0) = Polynomial.X ^ ℓ :=
            MvPolynomial.aeval_X (fun _ : Fin 1 => (Polynomial.X : P) ^ ℓ) 0
          rw [hκX, ← map_pow]
          rfl
        · intro p
          change ρ_alg (p ⊗ₜ[R₀] (1 : B₀)) = τ_β p
          rw [Algebra.TensorProduct.productMap_apply_tmul]
          simp [f_P_R, f_B_R]
        · intro b
          change ρ_alg ((1 : P) ⊗ₜ[R₀] b) = ι_B b
          rw [Algebra.TensorProduct.productMap_apply_tmul]
          simp [f_P_R, f_B_R]

      let IsGoodStage : Subalgebra P R_bar → Prop := fun B =>
        ∃ (ϖ : ↑(CommRingCat.of ↥B)) (u : (↑(CommRingCat.of ↥B))ˣ) (e : ℕ)
          (ψ : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of ↥B),
          1 ≤ e ∧
          B.val ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
          algebraMap P ↥B Polynomial.X = ↑u * ϖ ^ e ∧
          ψ.hom.comp Polynomial.C = (CommRingCat.ofHom (algebraMap P ↥B)).hom.comp Polynomial.C ∧
          ψ.hom Polynomial.X = ϖ ∧
          ψ.hom.Etale

      let ℐ : Type u := { B : Subalgebra P R_bar // IsGoodStage B }
      let hCat : CategoryTheory.SmallCategory ℐ := inferInstance

      have hBotGood : IsGoodStage (⊥ : Subalgebra P R_bar) := by
        let B_bot : Subalgebra P R_bar := ⊥
        let e_bot : ↥B_bot ≃ₐ[P] P := Algebra.botEquivOfInjective hP_inj
        let ϖ_bot : ↑(CommRingCat.of ↥B_bot) := algebraMap P ↥B_bot Polynomial.X
        let ψ_bot : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of ↥B_bot :=
          CommRingCat.ofHom (algebraMap P ↥B_bot)
        have hψ_bot_bij : Function.Bijective ψ_bot.hom := by
          have heq : (ψ_bot.hom : P → ↥B_bot) = e_bot.symm := by
            funext p
            exact (e_bot.symm.commutes p).symm
          rw [heq]
          exact e_bot.symm.bijective
        have hψ_bot_et : ψ_bot.hom.Etale := RingHom.Etale.of_bijective hψ_bot_bij
        refine ⟨ϖ_bot, 1, 1, ψ_bot, le_refl 1, ?_, by simp [ϖ_bot, B_bot], rfl, rfl, hψ_bot_et⟩
        change t_bar ∈ IsLocalRing.maximalIdeal R_bar
        exact ht_max
      let i_bot : ℐ := ⟨⊥, hBotGood⟩

      have hStageFinSet : ∀ i : ℐ, ∃ F_i : Finset R_bar,
          (i.1 : Set R_bar) ⊆ (Algebra.adjoin P (F_i : Set R_bar) : Set R_bar) := by
        intro i
        obtain ⟨_, _, _, ψ, _, _, _, hψ_C, _, hψ_et⟩ := i.2
        obtain ⟨G, hG⟩ := hFinGenOfEtale (↑(CommRingCat.of ↥i.1)) ψ.hom hψ_et
        let F_i : Finset R_bar := G.image i.1.val
        refine ⟨F_i, ?_⟩
        intro x hx
        have hs_mem := hG ⟨x, hx⟩
        have hsub_le : Subring.closure (Set.range (ψ.hom.comp Polynomial.C) ∪ (G : Set ↥i.1)) ≤
            Subring.comap i.1.val.toRingHom (Algebra.adjoin P (F_i : Set R_bar)).toSubring := by
          rw [Subring.closure_le]
          rintro y (⟨c, rfl⟩ | hyG)
          · change i.1.val ((ψ.hom.comp Polynomial.C) c) ∈ Algebra.adjoin P (F_i : Set R_bar)
            rw [hψ_C]
            change algebraMap P R_bar (Polynomial.C c) ∈ Algebra.adjoin P (F_i : Set R_bar)
            exact (Algebra.adjoin P (F_i : Set R_bar)).algebraMap_mem (Polynomial.C c)
          · change i.1.val y ∈ Algebra.adjoin P (F_i : Set R_bar)
            exact Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hyG))
        exact hsub_le hs_mem

      have hDominateFinset : ∀ F : Finset R_bar,
          ∃ B : Subalgebra P R_bar, (F : Set R_bar) ⊆ (B : Set R_bar) ∧ IsGoodStage B := by
        intro F
        obtain ⟨C_ty, hCR_C, hDom_C, hIC_C, hAlgP_C, hIntP_C, hFTP_C,
          φ_C, hφC_inj, hφC_P, hF_frac⟩ := hCurveCover F
        let : CommRing C_ty := hCR_C
        have : IsDomain C_ty := hDom_C
        have : IsIntegrallyClosed C_ty := hIC_C
        let : Algebra P C_ty := hAlgP_C
        have : Algebra.IsIntegral P C_ty := hIntP_C
        have : Algebra.FiniteType P C_ty := hFTP_C
        let : Algebra k C_ty := ((algebraMap P C_ty).comp Polynomial.C).toAlgebra
        have : IsScalarTower k P C_ty := IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.FiniteType k P := inferInstance
        have : Algebra.FiniteType k C_ty :=
          Algebra.FiniteType.trans ‹Algebra.FiniteType k P› ‹Algebra.FiniteType P C_ty›
        have hNoeth_CP : IsNoetherianRing C_ty := Algebra.FiniteType.isNoetherianRing k C_ty

        let p_L : Ideal C_ty := Ideal.comap φ_C (IsLocalRing.maximalIdeal R_bar)
        have : p_L.IsPrime := Ideal.comap_isPrime φ_C (IsLocalRing.maximalIdeal R_bar)
        have hφC_X : φ_C (algebraMap P C_ty Polynomial.X) = t_bar :=
          RingHom.congr_fun hφC_P Polynomial.X
        have hX_in_pL : algebraMap P C_ty Polynomial.X ∈ p_L := by
          change φ_C (algebraMap P C_ty Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar
          rw [hφC_X]
          exact ht_max
        have hX_CP_ne : algebraMap P C_ty Polynomial.X ≠ 0 := by
          intro h0
          have h1 := congrArg φ_C h0
          rw [map_zero, hφC_X] at h1
          exact ht_ne h1
        have hpL_ne_bot : p_L ≠ ⊥ := by
          intro hbot
          rw [hbot, Ideal.mem_bot] at hX_in_pL
          exact hX_CP_ne hX_in_pL

        have hDivX_P : ∀ (d : ℕ) (G : Polynomial P), G.natDegree ≤ d → G ≠ 0 →
            ∃ (r : ℕ) (H : Polynomial P), G = Polynomial.X ^ r * H ∧ H.coeff 0 ≠ 0 := by
          intro d
          induction d with
          | zero =>
            intro G hdeg hG_ne
            refine ⟨0, G, by simp, ?_⟩
            intro hc0
            exact hG_ne (by rw [Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero hdeg),
              hc0, map_zero])
          | succ d ih =>
            intro G hdeg hG_ne
            by_cases hc0 : G.coeff 0 = 0
            · obtain ⟨G₁, rfl⟩ := Polynomial.X_dvd_iff.mpr hc0
              have hG₁_ne : G₁ ≠ 0 := right_ne_zero_of_mul hG_ne
              have hdeg_mul : (Polynomial.X * G₁).natDegree = 1 + G₁.natDegree := by
                rw [Polynomial.natDegree_mul Polynomial.X_ne_zero hG₁_ne, Polynomial.natDegree_X]
              obtain ⟨r₁, H, rfl, hH0⟩ := ih G₁ (by omega) hG₁_ne
              exact ⟨r₁ + 1, H, by rw [pow_succ', mul_assoc], hH0⟩
            · exact ⟨0, G, by simp, hc0⟩

        have hDim_CP : ringKrullDim C_ty = (1 : WithBot ℕ∞) := by
          apply le_antisymm
          · exact (Ring.krullDimLE_iff (n := 1)).mp (Ring.KrullDimLE.mk₁ fun I hI => by
              by_cases hI0 : I = ⊥
              · left
                rw [hI0]
                exact ⟨⟨inferInstance, bot_le⟩, fun J ⟨_, _⟩ _ => bot_le⟩
              · right
                obtain ⟨x, hxI, hx_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI0
                obtain ⟨Q, hQ_mon, hQ_eval⟩ := Algebra.IsIntegral.isIntegral (R := P) x
                obtain ⟨r, H, hQH, hH0_ne⟩ := hDivX_P Q.natDegree Q (le_refl _) hQ_mon.ne_zero
                rw [hQH, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hQ_eval
                have hH_eval : Polynomial.eval₂ (algebraMap P C_ty) x H = 0 :=
                  (mul_eq_zero.mp hQ_eval).resolve_left (pow_ne_zero r hx_ne)
                obtain ⟨G₁, hG₁⟩ := Polynomial.X_dvd_iff.mpr
                  (show (H - Polynomial.C (H.coeff 0)).coeff 0 = 0 by simp)
                have hH_split : H = Polynomial.C (H.coeff 0) + Polynomial.X * G₁ := by
                  have h1 := eq_add_of_sub_eq hG₁
                  rwa [add_comm] at h1
                have hc0_mem : H.coeff 0 ∈ Ideal.comap (algebraMap P C_ty) I := by
                  change algebraMap P C_ty (H.coeff 0) ∈ I
                  have hev0 : algebraMap P C_ty (H.coeff 0) +
                      x * Polynomial.eval₂ (algebraMap P C_ty) x G₁ = 0 := by
                    conv_lhs at hH_eval => rw [hH_split]
                    simpa [Polynomial.eval₂_add, Polynomial.eval₂_mul] using hH_eval
                  have heq_neg : algebraMap P C_ty (H.coeff 0) =
                      -(x * Polynomial.eval₂ (algebraMap P C_ty) x G₁) :=
                    eq_neg_of_add_eq_zero_left hev0
                  rw [heq_neg]
                  exact I.neg_mem (I.mul_mem_right _ hxI)
                have hcomap_ne : Ideal.comap (algebraMap P C_ty) I ≠ ⊥ := by
                  intro hbot
                  rw [hbot, Ideal.mem_bot] at hc0_mem
                  exact hH0_ne hc0_mem
                have hcomap_prime : (Ideal.comap (algebraMap P C_ty) I).IsPrime :=
                  Ideal.comap_isPrime (algebraMap P C_ty) I
                have hcomap_max : (Ideal.comap (algebraMap P C_ty) I).IsMaximal :=
                  Ideal.IsPrime.isMaximal hcomap_prime hcomap_ne
                have hf_int : (algebraMap P C_ty).IsIntegral :=
                  fun y => Algebra.IsIntegral.isIntegral (R := P) y
                exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap P C_ty) hf_int
                  I hcomap_max)
          · exact (Order.le_krullDim_iff (n := 1)).mpr
              (let x₀ : _root_.PrimeSpectrum C_ty := ⟨⊥, inferInstance⟩
               let x₁ : _root_.PrimeSpectrum C_ty := ⟨p_L, inferInstance⟩
               have hlt : x₀ < x₁ :=
                 lt_of_le_of_ne bot_le (fun h => hpL_ne_bot (congrArg _root_.PrimeSpectrum.asIdeal h).symm)
               ⟨RelSeries.cons (RelSeries.singleton _ x₁) x₀ hlt, rfl⟩)

        have hpL_ht : p_L.height ≤ 1 := by
          have hle := Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top ‹p_L.IsPrime›)
          rw [hDim_CP] at hle
          exact WithBot.coe_le_coe.mp hle

        obtain ⟨f₁, hf₁_not_pL, hStdSm⟩ :=
          weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k 1 C_ty hDim_CP p_L hpL_ht
        have : Algebra.IsStandardSmoothOfRelativeDimension 1 k (Localization.Away f₁) := hStdSm
        let B₀ := Localization.Away f₁
        have hf₁_ne : f₁ ≠ 0 := fun h0 => hf₁_not_pL (h0 ▸ p_L.zero_mem)
        have hSub_f₁ : Submonoid.powers f₁ ≤ nonZeroDivisors C_ty :=
          Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf₁_ne)
        have : IsDomain B₀ := IsLocalization.isDomain_of_le_nonZeroDivisors B₀ hSub_f₁
        have : IsNoetherianRing B₀ :=
          IsLocalization.isNoetherianRing (Submonoid.powers f₁) B₀ hNoeth_CP

        have hf₁_unit_R : IsUnit (φ_C f₁) := IsLocalRing.notMem_maximalIdeal.mp hf₁_not_pL
        let ρ₀ : B₀ →+* R_bar :=
          let : Algebra C_ty R_bar := φ_C.toAlgebra
          IsLocalization.Away.lift (S := B₀) f₁ hf₁_unit_R
        have hρ₀_CP : ρ₀.comp (algebraMap C_ty B₀) = φ_C := by
          let : Algebra C_ty R_bar := φ_C.toAlgebra
          ext c
          exact IsLocalization.Away.lift_eq (S := B₀) f₁ hf₁_unit_R c
        have hρ₀_P : ρ₀.comp (algebraMap P B₀) = algebraMap P R_bar := by
          apply RingHom.ext
          intro p
          change ρ₀ (algebraMap C_ty B₀ (algebraMap P C_ty p)) = algebraMap P R_bar p
          have h1 : ρ₀ (algebraMap C_ty B₀ (algebraMap P C_ty p)) = φ_C (algebraMap P C_ty p) :=
            RingHom.congr_fun hρ₀_CP (algebraMap P C_ty p)
          rw [h1]
          exact RingHom.congr_fun hφC_P p
        have hρ₀_inj : Function.Injective ρ₀ := by
          rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
          intro z hz
          rw [RingHom.mem_ker] at hz
          obtain ⟨n, c, hzc⟩ := IsLocalization.Away.surj f₁ z
          have hc0 : c = 0 := by
            apply hφC_inj
            rw [map_zero]
            have h1 := congrArg ρ₀ hzc
            have h2 : ρ₀ (algebraMap C_ty B₀ c) = φ_C c := RingHom.congr_fun hρ₀_CP c
            rw [map_mul, hz, zero_mul, h2] at h1
            exact h1.symm
          rw [hc0, map_zero] at hzc
          exact ((IsLocalization.Away.algebraMap_isUnit (S := B₀) f₁).pow n).mul_left_eq_zero.mp hzc
        obtain ⟨g_mv, hg_mv_et⟩ :=
          Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial 1 k B₀
        let e_mv_symm : P ≃ₐ[k] MvPolynomial (Fin 1) k :=
          (MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm
        let θ₀ : P →+* B₀ := g_mv.toRingHom.comp e_mv_symm.toRingHom
        have hθ₀_et : θ₀.Etale :=
          RingHom.Etale.stableUnderComposition e_mv_symm.toRingHom g_mv.toRingHom
            (RingHom.Etale.of_bijective e_mv_symm.bijective) hg_mv_et
        have hθ₀_C : θ₀.comp Polynomial.C = algebraMap k B₀ := by
          ext c
          change g_mv (e_mv_symm (algebraMap k P c)) = algebraMap k B₀ c
          rw [e_mv_symm.commutes, g_mv.commutes]
        have halg_k_B₀ : algebraMap k B₀ = (algebraMap P B₀).comp Polynomial.C := by
          ext c
          rw [IsScalarTower.algebraMap_apply k C_ty B₀ c,
            IsScalarTower.algebraMap_apply k P C_ty c]
          rfl

        let t₀ : B₀ := θ₀ Polynomial.X
        obtain ⟨c₀, hc₀⟩ := hRes_surj (IsLocalRing.residue R_bar (ρ₀ t₀))
        let sh_sub : P →+* P := (Polynomial.aeval (Polynomial.X - Polynomial.C c₀)).toRingHom
        let sh_add : P →+* P := (Polynomial.aeval (Polynomial.X + Polynomial.C c₀)).toRingHom
        have hsh_1 : sh_add.comp sh_sub = RingHom.id P := by
          apply Polynomial.ringHom_ext
          · intro c
            change sh_add (sh_sub (Polynomial.C c)) = Polynomial.C c
            have h1 : sh_sub (Polynomial.C c) = Polynomial.C c := Polynomial.aeval_C _ c
            have h2 : sh_add (Polynomial.C c) = Polynomial.C c := Polynomial.aeval_C _ c
            rw [h1, h2]
          · change sh_add (sh_sub Polynomial.X) = Polynomial.X
            have h1 : sh_sub Polynomial.X = Polynomial.X - Polynomial.C c₀ := Polynomial.aeval_X _
            have h2 : sh_add Polynomial.X = Polynomial.X + Polynomial.C c₀ := Polynomial.aeval_X _
            have h3 : sh_add (Polynomial.C c₀) = Polynomial.C c₀ := Polynomial.aeval_C _ c₀
            rw [h1, map_sub, h2, h3]
            ring
        have hsh_2 : sh_sub.comp sh_add = RingHom.id P := by
          apply Polynomial.ringHom_ext
          · intro c
            change sh_sub (sh_add (Polynomial.C c)) = Polynomial.C c
            have h1 : sh_add (Polynomial.C c) = Polynomial.C c := Polynomial.aeval_C _ c
            have h2 : sh_sub (Polynomial.C c) = Polynomial.C c := Polynomial.aeval_C _ c
            rw [h1, h2]
          · change sh_sub (sh_add Polynomial.X) = Polynomial.X
            have h1 : sh_add Polynomial.X = Polynomial.X + Polynomial.C c₀ := Polynomial.aeval_X _
            have h2 : sh_sub Polynomial.X = Polynomial.X - Polynomial.C c₀ := Polynomial.aeval_X _
            have h3 : sh_sub (Polynomial.C c₀) = Polynomial.C c₀ := Polynomial.aeval_C _ c₀
            rw [h1, map_add, h2, h3]
            ring
        have hsh_bij : Function.Bijective sh_sub :=
          ⟨fun p₁ p₂ h => by
            have h' := congrArg sh_add h
            simpa using (RingHom.congr_fun hsh_1 p₁).symm.trans (h'.trans (RingHom.congr_fun hsh_1 p₂)),
           fun p => ⟨sh_add p, RingHom.congr_fun hsh_2 p⟩⟩

        let ψ₀ : P →+* B₀ := θ₀.comp sh_sub
        have hψ₀_et : ψ₀.Etale :=
          RingHom.Etale.stableUnderComposition sh_sub θ₀ (RingHom.Etale.of_bijective hsh_bij) hθ₀_et
        have hψ₀_C : ψ₀.comp Polynomial.C = (algebraMap P B₀).comp Polynomial.C := by
          have hsh_C : sh_sub.comp Polynomial.C = Polynomial.C := by
            apply RingHom.ext
            intro c
            exact Polynomial.aeval_C (Polynomial.X - Polynomial.C c₀) c
          rw [RingHom.comp_assoc, hsh_C, hθ₀_C, halg_k_B₀]
        let ϖ₀ : B₀ := ψ₀ Polynomial.X
        let q₀ : Ideal B₀ := Ideal.comap ρ₀ (IsLocalRing.maximalIdeal R_bar)
        have : q₀.IsPrime := Ideal.comap_isPrime ρ₀ (IsLocalRing.maximalIdeal R_bar)
        have hϖ₀_q₀ : ϖ₀ ∈ q₀ := by
          have hshX : sh_sub Polynomial.X = Polynomial.X - Polynomial.C c₀ :=
            Polynomial.aeval_X (Polynomial.X - Polynomial.C c₀)
          have hϖ₀_eq : ϖ₀ = t₀ - algebraMap P B₀ (Polynomial.C c₀) := by
            change θ₀ (sh_sub Polynomial.X) = _
            rw [hshX, map_sub, ← RingHom.comp_apply θ₀ Polynomial.C c₀, hθ₀_C, halg_k_B₀]
            rfl
          change ρ₀ ϖ₀ ∈ IsLocalRing.maximalIdeal R_bar
          have hc₀_R : ρ₀ (algebraMap P B₀ (Polynomial.C c₀)) =
              algebraMap P R_bar (Polynomial.C c₀) :=
            RingHom.congr_fun hρ₀_P (Polynomial.C c₀)
          rw [hϖ₀_eq, map_sub, hc₀_R, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
          exact hc₀.symm

        let bar_ρ : B₀ ⧸ q₀ →+* IsLocalRing.ResidueField R_bar :=
          Ideal.Quotient.lift q₀ ((IsLocalRing.residue R_bar).comp ρ₀)
            (fun _ hb => Ideal.Quotient.eq_zero_iff_mem.mpr hb)
        have hbar_ρ_inj : Function.Injective bar_ρ := by
          intro x y hxy
          obtain ⟨bx, rfl⟩ := Ideal.Quotient.mk_surjective x
          obtain ⟨by_, rfl⟩ := Ideal.Quotient.mk_surjective y
          rw [Ideal.Quotient.eq]
          change ρ₀ (bx - by_) ∈ IsLocalRing.maximalIdeal R_bar
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub, sub_eq_zero]
          exact hxy
        let ι_k_Q₀ : k →+* B₀ ⧸ q₀ := (Ideal.Quotient.mk q₀).comp (ψ₀.comp Polynomial.C)
        have hbar_ι : bar_ρ.comp ι_k_Q₀ =
            (IsLocalRing.residue R_bar).comp ((algebraMap P R_bar).comp Polynomial.C) := by
          ext c
          rw [RingHom.comp_apply, RingHom.comp_apply, hψ₀_C]
          change IsLocalRing.residue R_bar (ρ₀ (algebraMap P B₀ (Polynomial.C c))) = _
          rw [← RingHom.comp_apply ρ₀ (algebraMap P B₀), hρ₀_P]
          rfl
        have hSurj_ιQ₀ : Function.Surjective ι_k_Q₀ := by
          intro y
          obtain ⟨c, hc⟩ := hRes_surj (bar_ρ y)
          exact ⟨c, hbar_ρ_inj ((RingHom.congr_fun hbar_ι c).trans hc)⟩
        let e_kQ₀ : k ≃+* B₀ ⧸ q₀ :=
          RingEquiv.ofBijective ι_k_Q₀ ⟨ι_k_Q₀.injective, hSurj_ιQ₀⟩
        let ε₀ : B₀ →+* k := e_kQ₀.symm.toRingHom.comp (Ideal.Quotient.mk q₀)
        have hker_ε₀ : RingHom.ker ε₀ = q₀ := by
          ext b
          rw [RingHom.mem_ker]
          change e_kQ₀.symm (Ideal.Quotient.mk q₀ b) = 0 ↔ b ∈ q₀
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          exact ⟨fun h => by simpa using congrArg e_kQ₀ h, fun h => by simp [h]⟩
        have hε₀_ψ₀ : ε₀.comp ψ₀ = Polynomial.evalRingHom 0 := by
          apply Polynomial.ringHom_ext
          · intro c
            rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
            exact e_kQ₀.symm_apply_apply c
          · change e_kQ₀.symm (Ideal.Quotient.mk q₀ ϖ₀) = Polynomial.eval 0 Polynomial.X
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hϖ₀_q₀, map_zero, Polynomial.eval_X]

        let S₀ := Localization.AtPrime q₀
        let m₀ : Ideal S₀ := IsLocalRing.maximalIdeal S₀
        have : IsDomain S₀ :=
          IsLocalization.isDomain_of_le_nonZeroDivisors S₀ q₀.primeCompl_le_nonZeroDivisors
        have : IsNoetherianRing S₀ := IsLocalization.isNoetherianRing q₀.primeCompl S₀ inferInstance
        have hm₀_span : m₀ = Ideal.span {algebraMap B₀ S₀ ϖ₀} :=
          hMaxPrincipalOfEtale B₀ ψ₀ hψ₀_et q₀ ε₀ hker_ε₀ hε₀_ψ₀

        let x_B₀ : B₀ := algebraMap P B₀ Polynomial.X
        let x_S₀ : S₀ := algebraMap B₀ S₀ x_B₀
        have hx_B₀_R : ρ₀ x_B₀ = t_bar := RingHom.congr_fun hρ₀_P Polynomial.X
        have hx_B₀_q₀ : x_B₀ ∈ q₀ := by
          change ρ₀ x_B₀ ∈ IsLocalRing.maximalIdeal R_bar
          rw [hx_B₀_R]
          exact ht_max
        have hx_B₀_ne : x_B₀ ≠ 0 := by
          intro h0
          have h1 := congrArg ρ₀ h0
          rw [map_zero, hx_B₀_R] at h1
          exact ht_ne h1
        have hinj_B₀_S₀ : Function.Injective (algebraMap B₀ S₀) :=
          IsLocalization.injective S₀ q₀.primeCompl_le_nonZeroDivisors
        have hx_S₀_m₀ : x_S₀ ∈ m₀ :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff S₀ q₀ x_B₀).mpr hx_B₀_q₀
        have hx_S₀_ne : x_S₀ ≠ 0 :=
          fun h0 => hx_B₀_ne (hinj_B₀_S₀ (h0.trans (map_zero _).symm))

        have hiInf₀ : ⨅ n : ℕ, m₀ ^ n = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing m₀ (IsLocalRing.maximalIdeal.isMaximal S₀).ne_top
        have hex_n : ∃ n : ℕ, x_S₀ ∉ m₀ ^ (n + 1) := by
          by_contra! hall
          have hbot : x_S₀ ∈ (⨅ n : ℕ, m₀ ^ n) := by
            rw [Ideal.mem_iInf]
            intro n
            rcases n with _ | n
            · rw [pow_zero, Ideal.one_eq_top]; trivial
            · exact hall n
          rw [hiInf₀, Ideal.mem_bot] at hbot
          exact hx_S₀_ne hbot
        let e : ℕ := Nat.find hex_n
        have hx_not_e1 : x_S₀ ∉ m₀ ^ (e + 1) := Nat.find_spec hex_n
        have he_ne_zero : e ≠ 0 := by
          intro he0
          apply hx_not_e1
          simpa [he0] using hx_S₀_m₀
        have he_pos : 1 ≤ e := Nat.pos_of_ne_zero he_ne_zero
        have hx_in_e : x_S₀ ∈ m₀ ^ e := by
          obtain ⟨k_pred, hk_pred⟩ := Nat.exists_eq_succ_of_ne_zero he_ne_zero
          have hmin := Nat.find_min hex_n (hk_pred ▸ Nat.lt_succ_self k_pred)
          rw [hk_pred]
          exact not_not.mp hmin

        rw [hm₀_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hx_in_e
        obtain ⟨u_S₀, hu_S₀⟩ := hx_in_e
        have hu_not_m₀ : u_S₀ ∉ m₀ := by
          intro hum
          rw [hm₀_span, Ideal.mem_span_singleton'] at hum
          obtain ⟨v, rfl⟩ := hum
          apply hx_not_e1
          rw [hm₀_span, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
          exact ⟨v, by rw [pow_succ', ← mul_assoc, hu_S₀]⟩

        obtain ⟨⟨a_u, s_u⟩, hus⟩ := IsLocalization.surj q₀.primeCompl u_S₀
        have hus' : u_S₀ * algebraMap B₀ S₀ s_u.1 = algebraMap B₀ S₀ a_u := hus
        have hau_not_q₀ : a_u ∉ q₀ := by
          intro hau_q
          have hau_m : algebraMap B₀ S₀ a_u ∈ m₀ :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff S₀ q₀ a_u).mpr hau_q
          rw [← hus'] at hau_m
          have hsu_unit : IsUnit (algebraMap B₀ S₀ s_u.1) := IsLocalization.map_units S₀ s_u
          have hu_m : u_S₀ ∈ m₀ := by
            have h1 := m₀.mul_mem_right (↑hsu_unit.unit⁻¹ : S₀) hau_m
            simpa [mul_assoc] using h1
          exact hu_not_m₀ hu_m

        have hfac_B₀ : s_u.1 * x_B₀ = a_u * ϖ₀ ^ e := by
          apply hinj_B₀_S₀
          rw [map_mul, map_mul, map_pow]
          change algebraMap B₀ S₀ s_u.1 * x_S₀ = algebraMap B₀ S₀ a_u * (algebraMap B₀ S₀ ϖ₀) ^ e
          rw [← hu_S₀, ← hus']
          ring

        let a_hat : {w // w ∈ F} → C_ty := fun w => Classical.choose (hF_frac w.1 w.2)
        let s_hat : {w // w ∈ F} → C_ty :=
          fun w => Classical.choose (Classical.choose_spec (hF_frac w.1 w.2))
        have hs_hat_spec : ∀ w : {w // w ∈ F},
            IsUnit (φ_C (s_hat w)) ∧ w.1 * φ_C (s_hat w) = φ_C (a_hat w) :=
          fun w => Classical.choose_spec (Classical.choose_spec (hF_frac w.1 w.2))
        have hshat_not_q₀ : ∀ w : {w // w ∈ F}, algebraMap C_ty B₀ (s_hat w) ∉ q₀ := by
          intro w hmem
          have hunit_R : IsUnit (ρ₀ (algebraMap C_ty B₀ (s_hat w))) := by
            have h1 : ρ₀ (algebraMap C_ty B₀ (s_hat w)) = φ_C (s_hat w) :=
              RingHom.congr_fun hρ₀_CP (s_hat w)
            rw [h1]
            exact (hs_hat_spec w).1
          exact (IsLocalRing.notMem_maximalIdeal.mpr hunit_R) hmem

        let s_u_sub : q₀.primeCompl := s_u
        let a_u_sub : q₀.primeCompl := ⟨a_u, hau_not_q₀⟩
        let d_F_sub : q₀.primeCompl :=
          ∏ w ∈ F.attach, ⟨algebraMap C_ty B₀ (s_hat w), hshat_not_q₀ w⟩
        let g_sub : q₀.primeCompl := s_u_sub * a_u_sub * d_F_sub
        let g : B₀ := g_sub.1
        have hg_unit_R : IsUnit (ρ₀ g) :=
          IsLocalRing.notMem_maximalIdeal.mp g_sub.2

        let B₁ := Localization.Away g
        let ρ₁ : B₁ →+* R_bar :=
          let : Algebra B₀ R_bar := ρ₀.toAlgebra
          IsLocalization.Away.lift (S := B₁) g hg_unit_R
        have hρ₁_B₀ : ρ₁.comp (algebraMap B₀ B₁) = ρ₀ := by
          let : Algebra B₀ R_bar := ρ₀.toAlgebra
          ext b
          exact IsLocalization.Away.lift_eq (S := B₁) g hg_unit_R b
        have hρ₁_P : ρ₁.comp ((algebraMap B₀ B₁).comp (algebraMap P B₀)) = algebraMap P R_bar := by
          rw [← RingHom.comp_assoc, hρ₁_B₀, hρ₀_P]
        have hρ₁_inj : Function.Injective ρ₁ := by
          rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
          intro z hz
          rw [RingHom.mem_ker] at hz
          obtain ⟨n, b, hzb⟩ := IsLocalization.Away.surj g z
          have hb0 : b = 0 := by
            apply hρ₀_inj
            rw [map_zero]
            have h1 := congrArg ρ₁ hzb
            have hb_R : ρ₁ (algebraMap B₀ B₁ b) = ρ₀ b := RingHom.congr_fun hρ₁_B₀ b
            rw [map_mul, hz, zero_mul, hb_R] at h1
            exact h1.symm
          rw [hb0, map_zero] at hzb
          exact ((IsLocalization.Away.algebraMap_isUnit (S := B₁) g).pow n).mul_left_eq_zero.mp hzb

        have hg_unit_B₁ : IsUnit (algebraMap B₀ B₁ g) :=
          IsLocalization.Away.algebraMap_isUnit (S := B₁) g
        have hsu_unit_B₁ : IsUnit (algebraMap B₀ B₁ s_u.1) := by
          refine isUnit_of_dvd_unit ?_ hg_unit_B₁
          exact ⟨algebraMap B₀ B₁ (a_u * d_F_sub.1), by
            dsimp [g, g_sub, s_u_sub, a_u_sub]
            simp only [map_mul]
            ring⟩
        have hau_unit_B₁ : IsUnit (algebraMap B₀ B₁ a_u) := by
          refine isUnit_of_dvd_unit ?_ hg_unit_B₁
          exact ⟨algebraMap B₀ B₁ (s_u.1 * d_F_sub.1), by
            dsimp [g, g_sub, s_u_sub, a_u_sub]
            simp only [map_mul]
            ring⟩
        have hshat_unit_B₁ : ∀ w : {w // w ∈ F},
            IsUnit (algebraMap B₀ B₁ (algebraMap C_ty B₀ (s_hat w))) := by
          intro w
          refine isUnit_of_dvd_unit ?_ hg_unit_B₁
          have hdvd_dF : algebraMap C_ty B₀ (s_hat w) ∣ d_F_sub.1 := by
            have hdvd_sub : (⟨algebraMap C_ty B₀ (s_hat w), hshat_not_q₀ w⟩ : q₀.primeCompl) ∣ d_F_sub :=
              Finset.dvd_prod_of_mem _ (Finset.mem_attach F w)
            rcases hdvd_sub with ⟨t, ht⟩
            exact ⟨t.1, congrArg Subtype.val ht⟩
          rcases hdvd_dF with ⟨t, ht⟩
          exact ⟨algebraMap B₀ B₁ (s_u.1 * a_u * t), by
            change algebraMap B₀ B₁ (s_u.1 * a_u * d_F_sub.1) = _
            rw [ht]
            simp only [map_mul]
            ring⟩

        let B : Subalgebra P R_bar :=
          { ρ₁.range with
            algebraMap_mem' := fun p =>
              ⟨((algebraMap B₀ B₁).comp (algebraMap P B₀)) p, RingHom.congr_fun hρ₁_P p⟩ }
        let e_B : B₁ ≃+* ↥B :=
          RingEquiv.ofBijective ρ₁.rangeRestrict
            ⟨fun x y h => hρ₁_inj (congrArg Subtype.val h), ρ₁.rangeRestrict_surjective⟩

        refine ⟨B, ?_, ?_⟩
        · intro w hw
          have hw_F : w ∈ F := Finset.mem_coe.mp hw
          let u_sw : B₁ˣ := (hshat_unit_B₁ ⟨w, hw_F⟩).unit
          let z_w : B₁ :=
            algebraMap B₀ B₁ (algebraMap C_ty B₀ (a_hat ⟨w, hw_F⟩)) * ↑(u_sw⁻¹)
          refine ⟨z_w, ?_⟩
          have hsw_unit_R : IsUnit (φ_C (s_hat ⟨w, hw_F⟩)) := (hs_hat_spec ⟨w, hw_F⟩).1
          apply hsw_unit_R.mul_left_inj.mp
          have hρ_usw : ρ₁ (↑u_sw) = φ_C (s_hat ⟨w, hw_F⟩) := by
            change ρ₁ (algebraMap B₀ B₁ (algebraMap C_ty B₀ (s_hat ⟨w, hw_F⟩))) = _
            have h1 : ρ₁ (algebraMap B₀ B₁ (algebraMap C_ty B₀ (s_hat ⟨w, hw_F⟩))) =
                ρ₀ (algebraMap C_ty B₀ (s_hat ⟨w, hw_F⟩)) :=
              RingHom.congr_fun hρ₁_B₀ _
            have h2 : ρ₀ (algebraMap C_ty B₀ (s_hat ⟨w, hw_F⟩)) = φ_C (s_hat ⟨w, hw_F⟩) :=
              RingHom.congr_fun hρ₀_CP _
            rw [h1, h2]
          have hρ_a : ρ₁ (algebraMap B₀ B₁ (algebraMap C_ty B₀ (a_hat ⟨w, hw_F⟩))) =
              φ_C (a_hat ⟨w, hw_F⟩) := by
            have h1 : ρ₁ (algebraMap B₀ B₁ (algebraMap C_ty B₀ (a_hat ⟨w, hw_F⟩))) =
                ρ₀ (algebraMap C_ty B₀ (a_hat ⟨w, hw_F⟩)) :=
              RingHom.congr_fun hρ₁_B₀ _
            have h2 : ρ₀ (algebraMap C_ty B₀ (a_hat ⟨w, hw_F⟩)) = φ_C (a_hat ⟨w, hw_F⟩) :=
              RingHom.congr_fun hρ₀_CP _
            rw [h1, h2]
          calc
            ρ₁ z_w * φ_C (s_hat ⟨w, hw_F⟩)
              = ρ₁ (algebraMap B₀ B₁ (algebraMap C_ty B₀ (a_hat ⟨w, hw_F⟩))) *
                  (ρ₁ (↑(u_sw⁻¹)) * ρ₁ (↑u_sw)) := by
                  dsimp [z_w]; rw [map_mul, ← hρ_usw, mul_assoc]
            _ = φ_C (a_hat ⟨w, hw_F⟩) := by
                  rw [← map_mul, Units.inv_mul, map_one, mul_one, hρ_a]
            _ = w * φ_C (s_hat ⟨w, hw_F⟩) := ((hs_hat_spec ⟨w, hw_F⟩).2).symm
        · have hB₀B₁_et :=
            (RingHom.etale_algebraMap (R := B₀) (S := B₁)).mpr (Algebra.Etale.of_isLocalizationAway g)
          have hψB₁_et :=
            RingHom.Etale.stableUnderComposition ψ₀ _ hψ₀_et hB₀B₁_et
          let ψ_B : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of ↥B :=
            CommRingCat.ofHom (e_B.toRingHom.comp ((algebraMap B₀ B₁).comp ψ₀))
          have hψB_et : ψ_B.hom.Etale := hEtaleCompEquiv B₁ ↥B _ hψB₁_et e_B
          let ϖ_B : ↑(CommRingCat.of ↥B) := ψ_B.hom Polynomial.X
          let u_B₁ : B₁ˣ := hau_unit_B₁.unit * hsu_unit_B₁.unit⁻¹
          let u_B : (↑(CommRingCat.of ↥B))ˣ := Units.map e_B.toRingHom.toMonoidHom u_B₁
          refine ⟨ϖ_B, u_B, e, ψ_B, he_pos, ?_, ?_, ?_, rfl, hψB_et⟩
          · change ρ₁ (algebraMap B₀ B₁ ϖ₀) ∈ IsLocalRing.maximalIdeal R_bar
            have hϖ_R : ρ₁ (algebraMap B₀ B₁ ϖ₀) = ρ₀ ϖ₀ := RingHom.congr_fun hρ₁_B₀ ϖ₀
            rw [hϖ_R]
            exact hϖ₀_q₀
          · apply e_B.symm.injective
            have hlhs : e_B.symm (algebraMap P ↥B Polynomial.X) =
                algebraMap B₀ B₁ x_B₀ := by
              apply e_B.injective
              rw [e_B.apply_symm_apply]
              apply Subtype.ext
              exact (RingHom.congr_fun hρ₁_P Polynomial.X).symm
            have hrhs : e_B.symm (↑u_B * ϖ_B ^ e) =
                ↑u_B₁ * (algebraMap B₀ B₁ ϖ₀) ^ e := by
              rw [map_mul, map_pow]
              have hu_eq : e_B.symm (↑u_B) = ↑u_B₁ := e_B.symm_apply_apply (↑u_B₁)
              have hϖ_eq : e_B.symm ϖ_B = algebraMap B₀ B₁ ϖ₀ :=
                e_B.symm_apply_apply (algebraMap B₀ B₁ ϖ₀)
              rw [hu_eq, hϖ_eq]
            rw [hlhs, hrhs]
            apply hsu_unit_B₁.mul_right_inj.mp
            calc
              algebraMap B₀ B₁ s_u.1 * algebraMap B₀ B₁ x_B₀
                = algebraMap B₀ B₁ (s_u.1 * x_B₀) := (map_mul _ _ _).symm
              _ = algebraMap B₀ B₁ (a_u * ϖ₀ ^ e) := by rw [hfac_B₀]
              _ = ↑hau_unit_B₁.unit * (algebraMap B₀ B₁ ϖ₀) ^ e := by
                    rw [map_mul, map_pow]; rfl
              _ = algebraMap B₀ B₁ s_u.1 * (↑u_B₁ * (algebraMap B₀ B₁ ϖ₀) ^ e) := by
                    dsimp [u_B₁]
                    have hmul1 : algebraMap B₀ B₁ s_u.1 * ↑(hsu_unit_B₁.unit⁻¹) = 1 :=
                      Units.mul_inv hsu_unit_B₁.unit
                    calc
                      ↑hau_unit_B₁.unit * (algebraMap B₀ B₁ ϖ₀) ^ e
                        = ↑hau_unit_B₁.unit * (algebraMap B₀ B₁ s_u.1 * ↑(hsu_unit_B₁.unit⁻¹)) *
                            (algebraMap B₀ B₁ ϖ₀) ^ e := by rw [hmul1, mul_one]
                      _ = algebraMap B₀ B₁ s_u.1 *
                            ((↑hau_unit_B₁.unit * ↑(hsu_unit_B₁.unit⁻¹)) *
                              (algebraMap B₀ B₁ ϖ₀) ^ e) := by ring
          · ext c
            change ρ₁ (algebraMap B₀ B₁ (ψ₀ (Polynomial.C c))) = algebraMap P R_bar (Polynomial.C c)
            have h1 : ψ₀ (Polynomial.C c) = algebraMap P B₀ (Polynomial.C c) :=
              RingHom.congr_fun hψ₀_C c
            have h2 : ρ₁ (algebraMap B₀ B₁ (algebraMap P B₀ (Polynomial.C c))) =
                ρ₀ (algebraMap P B₀ (Polynomial.C c)) :=
              RingHom.congr_fun hρ₁_B₀ _
            have h3 : ρ₀ (algebraMap P B₀ (Polynomial.C c)) = algebraMap P R_bar (Polynomial.C c) :=
              RingHom.congr_fun hρ₀_P _
            rw [h1, h2, h3]

      have hUpper : ∀ i₁ i₂ : ℐ, ∃ i₃ : ℐ, i₁ ≤ i₃ ∧ i₂ ≤ i₃ := by
        intro i₁ i₂
        obtain ⟨F₁, hF₁⟩ := hStageFinSet i₁
        obtain ⟨F₂, hF₂⟩ := hStageFinSet i₂
        obtain ⟨B₃, hB₃_sub, hB₃_good⟩ := hDominateFinset (F₁ ∪ F₂)
        refine ⟨⟨B₃, hB₃_good⟩, ?_, ?_⟩
        · intro x hx
          have hadj : Algebra.adjoin P (F₁ : Set R_bar) ≤ B₃ :=
            Algebra.adjoin_le fun z hz =>
              hB₃_sub (Finset.mem_coe.mpr (Finset.mem_union_left F₂ (Finset.mem_coe.mp hz)))
          exact hadj (hF₁ hx)
        · intro y hy
          have hadj : Algebra.adjoin P (F₂ : Set R_bar) ≤ B₃ :=
            Algebra.adjoin_le fun z hz =>
              hB₃_sub (Finset.mem_coe.mpr (Finset.mem_union_right F₁ (Finset.mem_coe.mp hz)))
          exact hadj (hF₂ hy)

      have hFilt : CategoryTheory.IsFiltered ℐ :=
        { cocone_objs := fun i₁ i₂ =>
            let ⟨i₃, h₁, h₂⟩ := hUpper i₁ i₂
            ⟨i₃, homOfLE h₁, homOfLE h₂, trivial⟩
          cocone_maps := fun {i₁ i₂} _ _ => ⟨i₂, 𝟙 i₂, Subsingleton.elim _ _⟩
          nonempty := ⟨i_bot⟩ }

      have hCov_R : ∀ x : R_bar, ∃ i : ℐ, x ∈ i.1 := by
        intro x
        obtain ⟨B, hB_sub, hB_good⟩ := hDominateFinset {x}
        exact ⟨⟨B, hB_good⟩, hB_sub (by simp)⟩

      refine ⟨ℐ, hCat, hFilt, ?_⟩
      let D : ℐ ⥤ CommRingCat.{u} :=
        { obj := fun i => CommRingCat.of ↥i.1
          map := fun {i₁ i₂} θ =>
            CommRingCat.ofHom (Subalgebra.inclusion (leOfHom θ)).toRingHom
          map_id := fun _ => by apply CommRingCat.hom_ext; ext x; rfl
          map_comp := fun _ _ => by apply CommRingCat.hom_ext; ext x; rfl }
      let α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D :=
        { app := fun i => CommRingCat.ofHom (algebraMap P ↥i.1)
          naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext p; rfl }
      let c : CategoryTheory.Limits.Cocone D :=
        { pt := CommRingCat.of R_bar
          ι :=
            { app := fun i => CommRingCat.ofHom i.1.val.toRingHom
              naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext x; rfl } }
      let e_pt : c.pt ≅ CommRingCat.of R_bar := CategoryTheory.Iso.refl (CommRingCat.of R_bar)

      have hc_indep : ∀ (s : CategoryTheory.Limits.Cocone D) (x : R_bar) (i : ℐ)
          (hx : x ∈ i.1),
          (s.ι.app i).hom ⟨x, hx⟩ =
            (s.ι.app (Classical.choose (hCov_R x))).hom ⟨x, Classical.choose_spec (hCov_R x)⟩ := by
        intro s x i hx
        let i₀ := Classical.choose (hCov_R x)
        have hx₀ : x ∈ i₀.1 := Classical.choose_spec (hCov_R x)
        obtain ⟨i₃, hi₃, hi₀₃⟩ := hUpper i i₀
        have h1 : (s.ι.app i).hom ⟨x, hx⟩ = (s.ι.app i₃).hom ⟨x, hi₃ hx⟩ := by
          have hnat := s.ι.naturality (homOfLE hi₃)
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hnat) ⟨x, hx⟩).symm
        have h2 : (s.ι.app i₀).hom ⟨x, hx₀⟩ = (s.ι.app i₃).hom ⟨x, hi₀₃ hx₀⟩ := by
          have hnat := s.ι.naturality (homOfLE hi₀₃)
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hnat) ⟨x, hx₀⟩).symm
        exact h1.trans h2.symm

      let desc_c : ∀ s : CategoryTheory.Limits.Cocone D, c.pt ⟶ s.pt := fun s =>
        CommRingCat.ofHom
          { toFun := fun x =>
              (s.ι.app (Classical.choose (hCov_R x))).hom ⟨x, Classical.choose_spec (hCov_R x)⟩
            map_one' := by
              rw [← hc_indep s 1 i_bot i_bot.1.one_mem]
              exact map_one (s.ι.app i_bot).hom
            map_mul' := fun x y => by
              obtain ⟨ix, hx⟩ := hCov_R x
              obtain ⟨iy, hy⟩ := hCov_R y
              obtain ⟨i₃, h₁, h₂⟩ := hUpper ix iy
              rw [← hc_indep s x i₃ (h₁ hx), ← hc_indep s y i₃ (h₂ hy),
                ← hc_indep s (x * y) i₃ (i₃.1.mul_mem (h₁ hx) (h₂ hy))]
              exact map_mul (s.ι.app i₃).hom ⟨x, h₁ hx⟩ ⟨y, h₂ hy⟩
            map_zero' := by
              rw [← hc_indep s 0 i_bot i_bot.1.zero_mem]
              exact map_zero (s.ι.app i_bot).hom
            map_add' := fun x y => by
              obtain ⟨ix, hx⟩ := hCov_R x
              obtain ⟨iy, hy⟩ := hCov_R y
              obtain ⟨i₃, h₁, h₂⟩ := hUpper ix iy
              rw [← hc_indep s x i₃ (h₁ hx), ← hc_indep s y i₃ (h₂ hy),
                ← hc_indep s (x + y) i₃ (i₃.1.add_mem (h₁ hx) (h₂ hy))]
              exact map_add (s.ι.app i₃).hom ⟨x, h₁ hx⟩ ⟨y, h₂ hy⟩ }

      have hc : CategoryTheory.Limits.IsColimit c :=
        { desc := desc_c
          fac := fun s i => by
            apply CommRingCat.hom_ext
            ext y
            exact (hc_indep s (i.1.val y) i y.2).symm
          uniq := fun s m hm => by
            apply CommRingCat.hom_ext
            ext x
            let i₀ := Classical.choose (hCov_R x)
            have hx₀ : x ∈ i₀.1 := Classical.choose_spec (hCov_R x)
            calc
              m.hom x = (c.ι.app i₀ ≫ m).hom ⟨x, hx₀⟩ := rfl
              _ = (s.ι.app i₀).hom ⟨x, hx₀⟩ := by rw [hm i₀]
              _ = (desc_c s).hom x := rfl }

      refine ⟨D, α, c, hc, e_pt, ?_, ?_⟩
      · intro i
        refine ⟨?_, Subtype.val_injective⟩
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        exact i.1.val.commutes p
      · intro i
        obtain ⟨ϖ, u, e, ψ_i_cat, he, hϖ_max, hX_eq, hψ_C, hψ_X, hψ_et⟩ := i.2
        refine ⟨ϖ, u, e, ψ_i_cat.hom, he, hϖ_max, hX_eq, hψ_C, hψ_X, hψ_et, ?_⟩
        have hℓ_prime : Nat.Prime ℓ := Fact.out
        have hℓ_pos : 0 < ℓ := hℓ_prime.pos
        have hℓ_ge1 : 1 ≤ ℓ := hℓ_pos

        obtain ⟨β_R, hβ_pow⟩ := hPow_surj (i.1.val ϖ)
        have hβ_max : β_R ∈ IsLocalRing.maximalIdeal R_bar := by
          have hpow_max : β_R ^ ℓ ∈ IsLocalRing.maximalIdeal R_bar := by
            rw [hβ_pow]
            exact hϖ_max
          have hMaxPrime : (IsLocalRing.maximalIdeal R_bar).IsPrime := inferInstance
          exact hMaxPrime.mem_of_pow_mem ℓ hpow_max
        have hβ_ne : β_R ≠ 0 := by
          intro h0
          have hϖ0 : i.1.val ϖ = 0 := by
            rw [← hβ_pow, h0, zero_pow hℓ_pos.ne']
          have ht0 : t_bar = 0 := by
            change i.1.val (algebraMap P ↥i.1 Polynomial.X) = 0
            rw [hX_eq, map_mul, map_pow, hϖ0, zero_pow (by omega), mul_zero]
          exact ht_ne ht0

        let τ_β : P →+* R_bar :=
          Polynomial.eval₂RingHom ((algebraMap P R_bar).comp Polynomial.C) β_R
        have hτ_C : τ_β.comp Polynomial.C = (algebraMap P R_bar).comp Polynomial.C := by
          ext c
          exact Polynomial.eval₂_C ((algebraMap P R_bar).comp Polynomial.C) β_R
        have hτ_X : τ_β Polynomial.X = β_R :=
          Polynomial.eval₂_X ((algebraMap P R_bar).comp Polynomial.C) β_R
        have hτ_inj : Function.Injective τ_β := by
          rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
          intro p hp
          rw [RingHom.mem_ker] at hp
          by_contra hp_ne
          have hp_prod : p = Polynomial.C p.leadingCoeff *
              (p.roots.map (fun c => Polynomial.X - Polynomial.C c)).prod :=
            (IsAlgClosed.splits p).eq_prod_roots
          have hlc_ne : p.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp_ne
          have hlc_unit : IsUnit (τ_β (Polynomial.C p.leadingCoeff)) := by
            rw [← RingHom.comp_apply τ_β Polynomial.C, hτ_C]
            exact ((IsUnit.mk0 p.leadingCoeff hlc_ne).map Polynomial.C).map (algebraMap P R_bar)
          have hprod_eval : τ_β ((p.roots.map (fun c => Polynomial.X - Polynomial.C c)).prod) = 0 := by
            rw [hp_prod, map_mul] at hp
            exact (mul_eq_zero.mp hp).resolve_left hlc_unit.ne_zero
          have hprod_R : (p.roots.map (fun c => β_R - algebraMap P R_bar (Polynomial.C c))).prod = 0 := by
            rw [map_multiset_prod, Multiset.map_map] at hprod_eval
            convert hprod_eval using 2
            refine Multiset.map_congr rfl fun c _ => ?_
            rw [Function.comp_apply, map_sub, hτ_X, ← RingHom.comp_apply τ_β Polynomial.C, hτ_C]
            rfl
          obtain ⟨c, _, hc0⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp hprod_R)
          have hβ_eq_c : β_R = algebraMap P R_bar (Polynomial.C c) := sub_eq_zero.mp hc0
          by_cases hc_zero : c = 0
          · rw [hc_zero, map_zero, map_zero] at hβ_eq_c
            exact hβ_ne hβ_eq_c
          · have hc_unit : IsUnit (algebraMap P R_bar (Polynomial.C c)) :=
              ((IsUnit.mk0 c hc_zero).map Polynomial.C).map (algebraMap P R_bar)
            rw [← hβ_eq_c] at hc_unit
            exact (IsLocalRing.notMem_maximalIdeal.mpr hc_unit) hβ_max

        let ι_i_R : ↑(CommRingCat.of ↥i.1) →+* R_bar :=
          { toFun := fun y => i.1.val y
            map_one' := i.1.val.map_one
            map_mul' := i.1.val.map_mul
            map_zero' := i.1.val.map_zero
            map_add' := i.1.val.map_add }
        have hC_compat : ι_i_R.comp (ψ_i_cat.hom.comp Polynomial.C) = τ_β.comp Polynomial.C := by
          ext c
          change i.1.val ((ψ_i_cat.hom.comp Polynomial.C) c) = τ_β (Polynomial.C c)
          have htc : τ_β (Polynomial.C c) = algebraMap P R_bar (Polynomial.C c) :=
            RingHom.congr_fun hτ_C c
          rw [hψ_C, htc]
          exact i.1.val.commutes (Polynomial.C c)
        have hX_compat : (τ_β Polynomial.X) ^ ℓ = ι_i_R (ψ_i_cat.hom Polynomial.X) := by
          change (τ_β Polynomial.X) ^ ℓ = i.1.val (ψ_i_cat.hom Polynomial.X)
          rw [hτ_X, hψ_X]
          exact hβ_pow
        obtain ⟨E, hCR_E, α_E, inr_E, ρ_E, hαE_et, _, hρ_αE, hρ_inrE⟩ :=
          hKummerBaseChange (↑(CommRingCat.of ↥i.1)) R_bar
            ψ_i_cat.hom hψ_et ι_i_R τ_β hC_compat hX_compat
        let : CommRing E := hCR_E

        have hXE_max : ρ_E (α_E Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar := by
          rw [hρ_αE Polynomial.X, hτ_X]
          exact hβ_max
        have hcompE_inj : Function.Injective (ρ_E.comp α_E) := by
          intro p₁ p₂ hp
          apply hτ_inj
          simpa only [RingHom.comp_apply, hρ_αE] using hp
        obtain ⟨h_E, hhE_unit, _, hα₁_et, hρ₁_inj_all⟩ :=
          hEtShrink E α_E hαE_et ρ_E hXE_max hcompE_inj

        let E₁ := Localization.Away h_E
        let ρ₁ : E₁ →+* R_bar :=
          let : Algebra E R_bar := ρ_E.toAlgebra
          IsLocalization.Away.lift (S := E₁) h_E hhE_unit
        have hρ₁_E : ρ₁.comp (algebraMap E E₁) = ρ_E := by
          let : Algebra E R_bar := ρ_E.toAlgebra
          ext x
          exact IsLocalization.Away.lift_eq (S := E₁) h_E hhE_unit x
        have hρ₁_inj : Function.Injective ρ₁ := hρ₁_inj_all ρ₁ hρ₁_E
        let α₁ : P →+* E₁ := (algebraMap E E₁).comp α_E
        let inr₁ : ↑(CommRingCat.of ↥i.1) →+* E₁ := (algebraMap E E₁).comp inr_E
        have hρ₁_inr₁ : ∀ y : ↑(CommRingCat.of ↥i.1), ρ₁ (inr₁ y) = i.1.val y := by
          intro y
          change (ρ₁.comp (algebraMap E E₁)) (inr_E y) = i.1.val y
          rw [hρ₁_E]
          exact hρ_inrE y
        have hρ₁_α₁ : ∀ p : P, ρ₁ (α₁ p) = τ_β p := by
          intro p
          change (ρ₁.comp (algebraMap E E₁)) (α_E p) = τ_β p
          rw [hρ₁_E]
          exact hρ_αE p

        let B₁ : Subalgebra P R_bar :=
          { ρ₁.range with
            algebraMap_mem' := fun p =>
              ⟨inr₁ (algebraMap P ↥i.1 p), by
                rw [hρ₁_inr₁]
                exact i.1.val.commutes p⟩ }
        have hi_le_B₁ : i.1 ≤ B₁ := by
          intro x hx
          exact ⟨inr₁ ⟨x, hx⟩, hρ₁_inr₁ ⟨x, hx⟩⟩

        let e_B₁ : E₁ ≃+* ↥B₁ :=
          RingEquiv.ofBijective ρ₁.rangeRestrict
            ⟨fun x y h => hρ₁_inj (congrArg Subtype.val h), ρ₁.rangeRestrict_surjective⟩
        let ψ₁_cat : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of ↥B₁ :=
          CommRingCat.ofHom (e_B₁.toRingHom.comp ((algebraMap E E₁).comp α_E))
        have hψ₁_et : ψ₁_cat.hom.Etale := hEtaleCompEquiv E₁ ↥B₁ _ hα₁_et e_B₁
        let β₁ : ↑(CommRingCat.of ↥B₁) := ψ₁_cat.hom Polynomial.X
        have hβ₁_val : B₁.val β₁ = β_R := by
          change ρ₁ (α₁ Polynomial.X) = β_R
          rw [hρ₁_α₁, hτ_X]
        have hinc_ϖ : Subalgebra.inclusion hi_le_B₁ ϖ = β₁ ^ ℓ := by
          apply Subtype.ext
          change i.1.val ϖ = (B₁.val β₁) ^ ℓ
          rw [hβ₁_val, hβ_pow]
        have hψ₁_C : ψ₁_cat.hom.comp Polynomial.C =
            (CommRingCat.ofHom (algebraMap P ↥B₁)).hom.comp Polynomial.C := by
          ext c
          change ρ₁ (α₁ (Polynomial.C c)) = algebraMap P R_bar (Polynomial.C c)
          rw [hρ₁_α₁]
          exact RingHom.congr_fun hτ_C c

        have hB₁_good : IsGoodStage B₁ := by
          let inc : ↑(CommRingCat.of ↥i.1) →+* ↑(CommRingCat.of ↥B₁) :=
            (CommRingCat.ofHom (Subalgebra.inclusion hi_le_B₁).toRingHom).hom
          let u₁ : (↑(CommRingCat.of ↥B₁))ˣ := Units.map inc.toMonoidHom u
          refine ⟨β₁, u₁, ℓ * e, ψ₁_cat, Nat.mul_pos hℓ_ge1 he, ?_, ?_, hψ₁_C, rfl, hψ₁_et⟩
          · rw [hβ₁_val]
            exact hβ_max
          · have halgX : algebraMap P ↥B₁ Polynomial.X = inc (algebraMap P ↥i.1 Polynomial.X) := by
              apply Subtype.ext
              exact (i.1.val.commutes Polynomial.X).symm
            rw [halgX, hX_eq, map_mul, map_pow]
            change ↑u₁ * (Subalgebra.inclusion hi_le_B₁ ϖ) ^ e = ↑u₁ * β₁ ^ (ℓ * e)
            rw [hinc_ϖ, ← pow_mul]

        let i₁ : ℐ := ⟨B₁, hB₁_good⟩
        exact ⟨i₁, homOfLE hi_le_B₁, β₁, ψ₁_cat.hom, hinc_ϖ, hψ₁_C, rfl, hψ₁_et⟩

    
    intro P R_bar
    let K₀ := FractionRing P
    let Ω := AlgebraicClosure K₀
    let B_bar := integralClosure P Ω

    have hPow_surj : ∀ r : R_bar, ∃ β : R_bar, β ^ ℓ = r := by
      intro r
      have hℓ_prime : Nat.Prime ℓ := Fact.out
      have hℓ_pos : 0 < ℓ := hℓ_prime.pos
      have hℓ_ge1 : 1 ≤ ℓ := hℓ_pos
      obtain ⟨β₀, hβ₀_pow⟩ := IsAlgClosed.exists_pow_nat_eq (φ_R_Ω r) hℓ_pos
      obtain ⟨⟨a_r, s_r⟩, hr_surj⟩ := IsLocalization.surj M_max.primeCompl r
      have hr_surj' : r * algebraMap ↥B_bar R_bar s_r.1 = algebraMap ↥B_bar R_bar a_r := hr_surj
      have hr_Ω : φ_R_Ω r * s_r.1.1 = a_r.1 := by
        have h1 := congrArg φ_R_Ω hr_surj'
        rw [map_mul, hφ_B, hφ_B] at h1
        exact h1
      have hsβ_int : s_r.1.1 * β₀ ∈ B_bar := by
        let c_B : ↥B_bar := s_r.1 ^ (ℓ - 1) * a_r
        have hInt_B : _root_.IsIntegral ↥B_bar (s_r.1.1 * β₀) := by
          refine ⟨Polynomial.X ^ ℓ - Polynomial.C c_B, Polynomial.monic_X_pow_sub_C c_B hℓ_pos.ne', ?_⟩
          rw [← Polynomial.aeval_def, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
            sub_eq_zero, mul_pow, hβ₀_pow]
          change s_r.1.1 ^ ℓ * φ_R_Ω r = s_r.1.1 ^ (ℓ - 1) * a_r.1
          have hℓ_split : ℓ = (ℓ - 1) + 1 := (Nat.sub_add_cancel hℓ_ge1).symm
          conv_lhs => rw [hℓ_split, pow_succ, mul_assoc, mul_comm s_r.1.1 _, hr_Ω]
        exact _root_.isIntegral_trans (s_r.1.1 * β₀) hInt_B
      let β_R : R_bar := IsLocalization.mk' R_bar ⟨s_r.1.1 * β₀, hsβ_int⟩ s_r
      have hφ_β : φ_R_Ω β_R = β₀ := by
        have hs_ne : s_r.1.1 ≠ 0 := by
          intro h0
          apply s_r.2
          have hs0 : s_r.1 = 0 := Subtype.ext h0
          rw [hs0]
          exact M_max.zero_mem
        apply mul_left_cancel₀ hs_ne
        have hspec := IsLocalization.mk'_spec' R_bar ⟨s_r.1.1 * β₀, hsβ_int⟩ s_r
        have h1 := congrArg φ_R_Ω hspec
        rw [map_mul, hφ_B, hφ_B] at h1
        exact h1
      exact ⟨β_R, hφ_inj (by rw [map_pow, hφ_β, hβ₀_pow])⟩

    have hNormExtract : ∀ (A₀_ty : Type u) [CommRing A₀_ty] [IsDomain A₀_ty]
        [Algebra P A₀_ty] [Algebra.IsIntegral P A₀_ty] [Algebra.FiniteType P A₀_ty]
        (ι_A : A₀_ty →+* Ω),
        ι_A.comp (algebraMap P A₀_ty) = algebraMap P Ω →
        Function.Injective ι_A →
        ∃ (C_ty : Type u) (_ : CommRing C_ty) (_ : IsDomain C_ty) (_ : IsIntegrallyClosed C_ty)
          (_ : Algebra P C_ty) (_ : Algebra.IsIntegral P C_ty) (_ : Algebra.FiniteType P C_ty)
          (i_AC : A₀_ty →+* C_ty)
          (j_B : C_ty →+* ↥B_bar),
          Function.Injective j_B ∧
          j_B.comp (algebraMap P C_ty) = algebraMap P ↥B_bar ∧
          ∀ a : A₀_ty, (j_B (i_AC a)).1 = ι_A a := by
      clear hStageAbstract hPow_surj
      intro A₀_ty _ _ _ _ _ ι_A hιA_P hιA_inj
      let L := FractionRing A₀_ty
      let C_A := integralClosure A₀_ty L
      have hFin_IC : Module.Finite A₀_ty ↥C_A ∧ IsIntegrallyClosed ↥C_A := by
        let : Algebra k A₀_ty := ((algebraMap P A₀_ty).comp Polynomial.C).toAlgebra
        have : IsScalarTower k P A₀_ty := IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.FiniteType k P := inferInstance
        have : Algebra.FiniteType k A₀_ty :=
          Algebra.FiniteType.trans ‹Algebra.FiniteType k P› ‹Algebra.FiniteType P A₀_ty›
        exact weil_algClosed_finiteType_domain_integralClosure_finite k A₀_ty L
      obtain ⟨hFin_CA, hIC_CA⟩ := hFin_IC
      have : Module.Finite A₀_ty ↥C_A := hFin_CA
      have hFT_ACA : Algebra.FiniteType A₀_ty ↥C_A := Module.Finite.finiteType ↥C_A
      let alg_P_CA : Algebra P ↥C_A := inferInstance
      have hFT_PCA : Algebra.FiniteType P ↥C_A :=
        Algebra.FiniteType.trans ‹Algebra.FiniteType P A₀_ty› hFT_ACA
      have hInt_PCA : Algebra.IsIntegral P ↥C_A := by
        refine ⟨fun c => ?_⟩
        have hc_L : _root_.IsIntegral P c.1 := _root_.isIntegral_trans c.1 c.2
        exact (_root_.isIntegral_algHom_iff (C_A.val.restrictScalars P) Subtype.val_injective).mp hc_L
      have hA_units : ∀ y : nonZeroDivisors A₀_ty, IsUnit (ι_A y.1) := by
        intro y
        apply Ne.isUnit
        intro h0
        exact (mem_nonZeroDivisors_iff_ne_zero.mp y.2)
          (hιA_inj (h0.trans (map_zero ι_A).symm))
      let ι_L : L →+* Ω :=
        IsLocalization.lift (M := nonZeroDivisors A₀_ty) (g := ι_A) hA_units
      have hι_L_A : ∀ a : A₀_ty, ι_L (algebraMap A₀_ty L a) = ι_A a :=
        fun a => IsLocalization.lift_eq (M := nonZeroDivisors A₀_ty) hA_units a
      have hι_L_P : ι_L.comp (algebraMap P L) = algebraMap P Ω := by
        apply RingHom.ext
        intro p
        change ι_L (algebraMap P L p) = algebraMap P Ω p
        rw [IsScalarTower.algebraMap_apply P A₀_ty L p, hι_L_A]
        exact RingHom.congr_fun hιA_P p
      have hι_L_mem : ∀ c : ↥C_A, ι_L c.1 ∈ B_bar := by
        intro c
        have hc_P : _root_.IsIntegral P c.1 := _root_.isIntegral_trans c.1 c.2
        obtain ⟨Q, hQ_mon, hQ_eval⟩ := hc_P
        refine ⟨Q, hQ_mon, ?_⟩
        rw [← hι_L_P, ← Polynomial.hom_eval₂, hQ_eval, map_zero]
      let j_B : ↥C_A →+* ↥B_bar :=
        { toFun := fun c => ⟨ι_L c.1, hι_L_mem c⟩
          map_one' := Subtype.ext (map_one ι_L)
          map_mul' := fun x y => Subtype.ext (map_mul ι_L x.1 y.1)
          map_zero' := Subtype.ext (map_zero ι_L)
          map_add' := fun x y => Subtype.ext (map_add ι_L x.1 y.1) }
      have hj_B_inj : Function.Injective j_B := by
        intro x y hxy
        apply Subtype.ext
        exact ι_L.injective (congrArg Subtype.val hxy)
      have hj_B_P : j_B.comp (algebraMap P ↥C_A) = algebraMap P ↥B_bar := by
        apply RingHom.ext
        intro p
        apply Subtype.ext
        exact RingHom.congr_fun hι_L_P p
      exact ⟨↥C_A, inferInstance, inferInstance, hIC_CA, alg_P_CA, hInt_PCA, hFT_PCA,
        algebraMap A₀_ty ↥C_A, j_B, hj_B_inj, hj_B_P, hι_L_A⟩

    have hCurveCover : ∀ F : Finset R_bar,
        ∃ (C_ty : Type u) (_ : CommRing C_ty) (_ : IsDomain C_ty) (_ : IsIntegrallyClosed C_ty)
          (_ : Algebra P C_ty) (_ : Algebra.IsIntegral P C_ty) (_ : Algebra.FiniteType P C_ty)
          (φ_C : C_ty →+* R_bar),
          Function.Injective φ_C ∧
          φ_C.comp (algebraMap P C_ty) = algebraMap P R_bar ∧
          ∀ w ∈ F, ∃ (a s : C_ty), IsUnit (φ_C s) ∧ w * φ_C s = φ_C a := by
      clear hStageAbstract hPow_surj
      intro F
      let pair_w : R_bar → ↥B_bar × ↥M_max.primeCompl :=
        fun w => Classical.choose (IsLocalization.surj M_max.primeCompl w)
      have hpair_w : ∀ w : R_bar,
          w * algebraMap ↥B_bar R_bar (pair_w w).2.1 = algebraMap ↥B_bar R_bar (pair_w w).1 :=
        fun w => Classical.choose_spec (IsLocalization.surj M_max.primeCompl w)
      let S_gen : Finset Ω :=
        F.image (fun w => (pair_w w).1.1) ∪ F.image (fun w => (pair_w w).2.1.1)
      have hS_in_B : ∀ z ∈ S_gen, z ∈ B_bar := by
        intro z hz
        rcases Finset.mem_union.mp hz with hz1 | hz2
        · rcases Finset.mem_image.mp hz1 with ⟨w, _, rfl⟩
          exact (pair_w w).1.2
        · rcases Finset.mem_image.mp hz2 with ⟨w, _, rfl⟩
          exact (pair_w w).2.1.2
      let A₀ : Subalgebra P Ω := Algebra.adjoin P (S_gen : Set Ω)
      have hA₀_le_B : A₀ ≤ B_bar := Algebra.adjoin_le fun z hz => hS_in_B z (Finset.mem_coe.mp hz)
      have hA₀_int : Algebra.IsIntegral P ↥A₀ := by
        refine ⟨fun x => ?_⟩
        have hx_Ω : _root_.IsIntegral P (A₀.val x) := hA₀_le_B x.2
        exact (_root_.isIntegral_algHom_iff A₀.val Subtype.val_injective).mp hx_Ω
      have hFT_PA₀ : Algebra.FiniteType P ↥A₀ := by
        let S_A₀ : Finset ↥A₀ :=
          S_gen.attach.image (fun z => (⟨z.1, Algebra.subset_adjoin z.2⟩ : ↥A₀))
        refine ⟨⟨S_A₀, ?_⟩⟩
        rw [eq_top_iff]
        intro x _
        let W : Subalgebra P Ω := Subalgebra.map A₀.val (Algebra.adjoin P (S_A₀ : Set ↥A₀))
        have hA₀_le_W : A₀ ≤ W := by
          refine Algebra.adjoin_le fun z hz => ?_
          have hz_fin : z ∈ S_gen := Finset.mem_coe.mp hz
          let z' : ↥A₀ := ⟨z, Algebra.subset_adjoin hz⟩
          have hz'_mem : z' ∈ S_A₀ :=
            Finset.mem_image_of_mem _ (Finset.mem_attach S_gen ⟨z, hz_fin⟩)
          exact ⟨z', Algebra.subset_adjoin (Finset.mem_coe.mpr hz'_mem), rfl⟩
        rcases hA₀_le_W x.2 with ⟨y, hy, hyx⟩
        have hy_eq : y = x := Subtype.ext hyx
        rwa [← hy_eq]

      obtain ⟨C_ty, hCR_C, hDom_C, hIC_C, hAlgP_C, hIntP_C, hFTP_C,
        i_AC, j_B, hj_B_inj, hj_B_P, hj_AC⟩ :=
        hNormExtract ↥A₀ A₀.val.toRingHom (RingHom.ext fun p => A₀.val.commutes p)
          Subtype.val_injective
      let : CommRing C_ty := hCR_C
      let : Algebra P C_ty := hAlgP_C
      let φ_C : C_ty →+* R_bar := (algebraMap ↥B_bar R_bar).comp j_B
      have hφC_inj : Function.Injective φ_C := by
        intro x y hxy
        apply hj_B_inj
        apply Subtype.ext
        have h1 := congrArg φ_R_Ω hxy
        change φ_R_Ω (algebraMap ↥B_bar R_bar (j_B x)) =
          φ_R_Ω (algebraMap ↥B_bar R_bar (j_B y)) at h1
        rwa [hφ_B, hφ_B] at h1
      have hφC_P : φ_C.comp (algebraMap P C_ty) = algebraMap P R_bar := by
        apply RingHom.ext
        intro p
        change algebraMap ↥B_bar R_bar (j_B (algebraMap P C_ty p)) = algebraMap P R_bar p
        have h2 : j_B (algebraMap P C_ty p) = algebraMap P ↥B_bar p := RingHom.congr_fun hj_B_P p
        rw [h2, ← IsScalarTower.algebraMap_apply P ↥B_bar R_bar p]
      refine ⟨C_ty, hCR_C, hDom_C, hIC_C, hAlgP_C, hIntP_C, hFTP_C, φ_C, hφC_inj, hφC_P, ?_⟩
      intro w hw
      have hat_mem : (pair_w w).1.1 ∈ A₀ ∧ (pair_w w).2.1.1 ∈ A₀ :=
        ⟨Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _
          (Finset.mem_image_of_mem _ hw))),
         Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_right _
          (Finset.mem_image_of_mem _ hw)))⟩
      let a : C_ty := i_AC ⟨(pair_w w).1.1, hat_mem.1⟩
      let s : C_ty := i_AC ⟨(pair_w w).2.1.1, hat_mem.2⟩
      have hj_a : j_B a = (pair_w w).1 := Subtype.ext (hj_AC ⟨(pair_w w).1.1, hat_mem.1⟩)
      have hj_s : j_B s = (pair_w w).2.1 := Subtype.ext (hj_AC ⟨(pair_w w).2.1.1, hat_mem.2⟩)
      refine ⟨a, s, ?_, ?_⟩
      · change IsUnit (algebraMap ↥B_bar R_bar (j_B s))
        rw [hj_s]
        exact IsLocalization.map_units R_bar (pair_w w).2
      · change w * algebraMap ↥B_bar R_bar (j_B s) = algebraMap ↥B_bar R_bar (j_B a)
        rw [hj_s, hj_a]
        exact hpair_w w

    exact hStageAbstract R_bar ht_max ht_ne hP_inj hRes_surj hPow_surj hEtShrink hCurveCover

  
  have hPart5 :
      ∀ (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [HenselianLocalRing R_bar]
        (p_Δ_R : Localization.Away Δ₀ →+* R_bar)
        (ht_max : p_Δ_R (algebraMap (Polynomial k) (Localization.Away Δ₀) Polynomial.X) ∈
          IsLocalRing.maximalIdeal R_bar)
        (hp_P_inj : Function.Injective
          (p_Δ_R.comp (algebraMap (Polynomial k) (Localization.Away Δ₀))))
        (hRes : (IsLocalRing.residue R_bar).comp p_Δ_R =
          ((IsLocalRing.residue R_bar).comp
            ((p_Δ_R.comp (algebraMap (Polynomial k) (Localization.Away Δ₀))).comp Polynomial.C)).comp ev₀)
        (hEtShrink : ∀ (E : Type u) [CommRing E]
            (α_E : Polynomial k →+* E), α_E.Etale →
            ∀ (ρ : E →+* R_bar),
              ρ (α_E Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar →
              Function.Injective (ρ.comp α_E) →
              ∃ h_E : E,
                IsUnit (ρ h_E) ∧
                IsDomain (Localization.Away h_E) ∧
                ((algebraMap E (Localization.Away h_E)).comp α_E).Etale ∧
                ∀ (ρ₁ : Localization.Away h_E →+* R_bar),
                  ρ₁.comp (algebraMap E (Localization.Away h_E)) = ρ →
                  Function.Injective ρ₁),
        let R_Δ := Localization.Away Δ₀
        ∃ (ℐ_sh : Type u) (hCat_sh : CategoryTheory.SmallCategory ℐ_sh)
            (hFilt_sh : CategoryTheory.IsFiltered ℐ_sh)
            (R_sh : Type u) (hCR_sh : CommRing R_sh) (hDom_sh : IsDomain R_sh)
            (hHens_sh : HenselianLocalRing R_sh),
          letI : CategoryTheory.SmallCategory ℐ_sh := hCat_sh
          letI : CategoryTheory.IsFiltered ℐ_sh := hFilt_sh
          letI : CommRing R_sh := hCR_sh
          letI : IsDomain R_sh := hDom_sh
          letI : HenselianLocalRing R_sh := hHens_sh
          ∃ (_ : IsAlgClosed (IsLocalRing.ResidueField R_sh))
            (D_sh : ℐ_sh ⥤ CommRingCat.{u})
            (α_sh : (CategoryTheory.Functor.const ℐ_sh).obj (CommRingCat.of R_Δ) ⟶ D_sh)
            (f_sh : CommRingCat.of R_Δ ⟶ CommRingCat.of R_sh)
            (ι_sh : CommRingCat.of R_sh ⟶ CommRingCat.of R_bar)
            (c_sh : CategoryTheory.Limits.Cocone D_sh)
            (_ : CategoryTheory.Limits.IsColimit c_sh)
            (e_sh : c_sh.pt ≅ CommRingCat.of R_sh),
            f_sh ≫ ι_sh = CommRingCat.ofHom p_Δ_R ∧
            Function.Injective ι_sh.hom ∧
            (∀ x : R_sh, ι_sh.hom x ∈ IsLocalRing.maximalIdeal R_bar ↔
              x ∈ IsLocalRing.maximalIdeal R_sh) ∧
            (∀ j : ℐ_sh,
              (α_sh.app j).hom.Etale ∧
              IsDomain ↑(D_sh.obj j) ∧
              (α_sh.app j) ≫ (c_sh.ι.app j) ≫ e_sh.hom = f_sh ∧
              Function.Injective (((c_sh.ι.app j) ≫ e_sh.hom) ≫ ι_sh).hom ∧
              ∃ χ_j : D_sh.obj j ⟶ CommRingCat.of k,
                (α_sh.app j) ≫ χ_j = CommRingCat.ofHom ev₀) := by
    clear hPart2 hPart3 hPart4
    classical
    intro R_bar _ _ _ p_Δ_R ht_max hp_P_inj hRes hEtShrink
    intro R_Δ
    let P := Polynomial k

    have hp_Δ_inj : Function.Injective p_Δ_R := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨n, f, hzf'⟩ := IsLocalization.Away.surj Δ₀ z
      have hf0 : f = 0 := by
        apply hp_P_inj
        rw [map_zero]
        change p_Δ_R (algebraMap P R_Δ f) = 0
        rw [← hzf', map_mul, hz, zero_mul]
      rw [hf0, map_zero] at hzf'
      have hunit : IsUnit (algebraMap P R_Δ Δ₀ ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit (S := R_Δ) Δ₀).pow n
      exact hunit.mul_left_eq_zero.mp hzf'

    letI : Algebra R_Δ R_bar := p_Δ_R.toAlgebra
    let ℐ_sh : Type u := { C : Subalgebra R_Δ R_bar // (algebraMap R_Δ ↥C).Etale }
    let hCat_sh : CategoryTheory.SmallCategory ℐ_sh := inferInstance
    letI : CategoryTheory.SmallCategory ℐ_sh := hCat_sh

    have hBot_et : (algebraMap R_Δ ↥(⊥ : Subalgebra R_Δ R_bar)).Etale := by
      let e_bot : ↥(⊥ : Subalgebra R_Δ R_bar) ≃ₐ[R_Δ] R_Δ :=
        Algebra.botEquivOfInjective hp_Δ_inj
      have heq : algebraMap R_Δ ↥(⊥ : Subalgebra R_Δ R_bar) = e_bot.symm.toAlgHom.toRingHom := by
        ext r
        exact congrArg Subtype.val (e_bot.symm.commutes r).symm
      rw [heq]
      exact RingHom.Etale.of_bijective e_bot.symm.bijective
    let j_bot : ℐ_sh := ⟨⊥, hBot_et⟩
    have : Nonempty ℐ_sh := ⟨j_bot⟩

    
    have hEmbedEtale : ∀ (E : Type u) [CommRing E]
        (φ : R_Δ →+* E), φ.Etale →
        ∀ (ρ : E →+* R_bar), ρ.comp φ = p_Δ_R →
        ∃ j : ℐ_sh, Set.range ρ ⊆ (j.1 : Set R_bar) := by
      intro E _ φ hφ_et ρ hρ_comp
      have hPRΔ_et : (algebraMap P R_Δ).Etale :=
        RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway Δ₀)
      let α_E : P →+* E := φ.comp (algebraMap P R_Δ)
      have hα_et : α_E.Etale :=
        RingHom.Etale.stableUnderComposition (algebraMap P R_Δ) φ hPRΔ_et hφ_et
      have hX_max : ρ (α_E Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar := by
        change (ρ.comp φ) (algebraMap P R_Δ Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar
        rw [hρ_comp]
        exact ht_max
      have hcomp_inj : Function.Injective (ρ.comp α_E) := by
        have hcomp_eq : ρ.comp α_E = p_Δ_R.comp (algebraMap P R_Δ) := by
          dsimp [α_E]
          rw [← RingHom.comp_assoc, hρ_comp]
        rw [hcomp_eq]
        exact hp_P_inj
      obtain ⟨h_E, hhE_unit, _, _, hρ₁_inj_all⟩ :=
        hEtShrink E α_E hα_et ρ hX_max hcomp_inj
      let E₁ := Localization.Away h_E
      let ρ₁ : E₁ →+* R_bar :=
        letI : Algebra E R_bar := ρ.toAlgebra
        IsLocalization.Away.lift (S := E₁) h_E hhE_unit
      have hρ₁_comp : ρ₁.comp (algebraMap E E₁) = ρ := by
        letI : Algebra E R_bar := ρ.toAlgebra
        ext e
        exact IsLocalization.Away.lift_eq (S := E₁) h_E hhE_unit e
      have hρ₁_inj : Function.Injective ρ₁ := hρ₁_inj_all ρ₁ hρ₁_comp
      let φ₁ : R_Δ →+* E₁ := (algebraMap E E₁).comp φ
      have hφ₁_et : φ₁.Etale :=
        RingHom.Etale.stableUnderComposition φ (algebraMap E E₁) hφ_et
          (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway h_E))
      have hρ₁_φ₁ : ρ₁.comp φ₁ = p_Δ_R := by
        dsimp [φ₁]
        rw [← RingHom.comp_assoc, hρ₁_comp, hρ_comp]
      let C_new : Subalgebra R_Δ R_bar :=
        { ρ₁.range with
          algebraMap_mem' := fun r =>
            ⟨φ₁ r, RingHom.congr_fun hρ₁_φ₁ r⟩ }
      let e_C : E₁ ≃+* ↥C_new :=
        RingEquiv.ofBijective ρ₁.rangeRestrict
          ⟨fun x y h => hρ₁_inj (congrArg Subtype.val h), ρ₁.rangeRestrict_surjective⟩
      have halg_C : algebraMap R_Δ ↥C_new = e_C.toRingHom.comp φ₁ := by
        ext r
        exact (RingHom.congr_fun hρ₁_φ₁ r).symm
      have hC_et : (algebraMap R_Δ ↥C_new).Etale := by
        rw [halg_C]
        exact RingHom.Etale.stableUnderComposition φ₁ e_C.toRingHom hφ₁_et
          (RingHom.Etale.of_bijective e_C.bijective)
      refine ⟨⟨C_new, hC_et⟩, ?_⟩
      rintro _ ⟨e, rfl⟩
      exact ⟨algebraMap E E₁ e, RingHom.congr_fun hρ₁_comp e⟩

    
    have hUpper : ∀ j₁ j₂ : ℐ_sh, ∃ j₃ : ℐ_sh, j₁ ≤ j₃ ∧ j₂ ≤ j₃ := by
      intro j₁ j₂
      have : Algebra.Etale R_Δ ↥j₁.1 := RingHom.etale_algebraMap.mp j₁.2
      have : Algebra.Etale R_Δ ↥j₂.1 := RingHom.etale_algebraMap.mp j₂.2
      let E := TensorProduct R_Δ ↥j₁.1 ↥j₂.1
      have : Algebra.Etale ↥j₁.1 E := Algebra.Etale.baseChange R_Δ ↥j₂.1 ↥j₁.1
      have : Algebra.Etale R_Δ E := Algebra.Etale.comp R_Δ ↥j₁.1 E
      have hφ_et := (RingHom.etale_algebraMap (R := R_Δ) (S := E)).mpr ‹Algebra.Etale R_Δ E›
      let ρ_alg : E →ₐ[R_Δ] R_bar := Algebra.TensorProduct.productMap j₁.1.val j₂.1.val
      let ρ : E →+* R_bar := ρ_alg.toRingHom
      have hρ_comp : ρ.comp (algebraMap R_Δ E) = p_Δ_R := by
        ext r
        exact ρ_alg.commutes r
      obtain ⟨j₃, hj₃_sub⟩ := hEmbedEtale E _ hφ_et ρ hρ_comp
      refine ⟨j₃, ?_, ?_⟩
      · intro x hx
        refine hj₃_sub ⟨(⟨x, hx⟩ : ↥j₁.1) ⊗ₜ[R_Δ] (1 : ↥j₂.1), ?_⟩
        change ρ_alg ((⟨x, hx⟩ : ↥j₁.1) ⊗ₜ[R_Δ] (1 : ↥j₂.1)) = x
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        simp
      · intro y hy
        refine hj₃_sub ⟨(1 : ↥j₁.1) ⊗ₜ[R_Δ] (⟨y, hy⟩ : ↥j₂.1), ?_⟩
        change ρ_alg ((1 : ↥j₁.1) ⊗ₜ[R_Δ] (⟨y, hy⟩ : ↥j₂.1)) = y
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        simp

    have hFilt_sh : CategoryTheory.IsFiltered ℐ_sh :=
      { cocone_objs := fun j₁ j₂ =>
          let ⟨j₃, h₁, h₂⟩ := hUpper j₁ j₂
          ⟨j₃, homOfLE h₁, homOfLE h₂, trivial⟩
        cocone_maps := fun {j₁ j₂} f g => ⟨j₂, 𝟙 j₂, Subsingleton.elim _ _⟩
        nonempty := ⟨j_bot⟩ }
    letI : CategoryTheory.IsFiltered ℐ_sh := hFilt_sh

    have hDir_sh : Directed (· ≤ ·) (fun j : ℐ_sh => j.1) := fun j₁ j₂ => hUpper j₁ j₂
    let S_sh : Subalgebra R_Δ R_bar := ⨆ j : ℐ_sh, j.1
    let R_sh : Type u := ↥S_sh
    let hCR_sh : CommRing R_sh := inferInstance
    let hDom_sh : IsDomain R_sh := inferInstance

    have hCov_sh : ∀ x : R_sh, ∃ j : ℐ_sh, x.1 ∈ j.1 := by
      intro x
      have hx : x.1 ∈ (S_sh : Set R_bar) := x.2
      dsimp [S_sh] at hx
      rw [Subalgebra.coe_iSup_of_directed hDir_sh, Set.mem_iUnion] at hx
      exact hx

    
    have hUnit_iff : ∀ x : R_sh, IsUnit x ↔ x.1 ∉ IsLocalRing.maximalIdeal R_bar := by
      intro x
      constructor
      · intro hx_unit hmem
        have hbar_unit : IsUnit x.1 := hx_unit.map S_sh.val.toRingHom
        exact (IsLocalRing.notMem_maximalIdeal.mpr hbar_unit) hmem
      · intro hnot_mem
        have hbar_unit : IsUnit x.1 := IsLocalRing.notMem_maximalIdeal.mp hnot_mem
        obtain ⟨j, hxj⟩ := hCov_sh x
        let x₀ : ↥j.1 := ⟨x.1, hxj⟩
        have hx₀_unit : IsUnit (j.1.val.toRingHom x₀) := hbar_unit
        let E_x := Localization.Away x₀
        have hEx_et :=
          (RingHom.etale_algebraMap (R := ↥j.1) (S := E_x)).mpr
            (Algebra.Etale.of_isLocalizationAway x₀)
        have hφx_et :=
          RingHom.Etale.stableUnderComposition (algebraMap R_Δ ↥j.1) _ j.2 hEx_et
        let ρ_x : E_x →+* R_bar :=
          letI : Algebra ↥j.1 R_bar := j.1.val.toRingHom.toAlgebra
          IsLocalization.Away.lift (S := E_x) x₀ hx₀_unit
        have hρx_comp_j : ρ_x.comp (algebraMap ↥j.1 E_x) = j.1.val.toRingHom := by
          letI : Algebra ↥j.1 R_bar := j.1.val.toRingHom.toAlgebra
          ext y
          exact IsLocalization.Away.lift_eq (S := E_x) x₀ hx₀_unit y
        have hρx_comp : ρ_x.comp ((algebraMap ↥j.1 E_x).comp (algebraMap R_Δ ↥j.1)) = p_Δ_R := by
          rw [← RingHom.comp_assoc, hρx_comp_j]
          ext r
          exact j.1.val.commutes r
        obtain ⟨j', hj'_sub⟩ := hEmbedEtale E_x _ hφx_et ρ_x hρx_comp
        let inv_x₀ : E_x := IsLocalization.Away.invSelf (S := E_x) x₀
        have hinv_mem_j' : ρ_x inv_x₀ ∈ j'.1 := hj'_sub ⟨inv_x₀, rfl⟩
        have hinv_mem_sh : ρ_x inv_x₀ ∈ S_sh :=
          (le_iSup (fun i : ℐ_sh => i.1) j') hinv_mem_j'
        let y : R_sh := ⟨ρ_x inv_x₀, hinv_mem_sh⟩
        have hxy1 : x * y = 1 := by
          apply Subtype.ext
          change x.1 * ρ_x inv_x₀ = 1
          have h1 : algebraMap ↥j.1 E_x x₀ * inv_x₀ = 1 :=
            IsLocalization.Away.mul_invSelf (S := E_x) x₀
          have h2 := congrArg ρ_x h1
          have h3 : ρ_x (algebraMap ↥j.1 E_x x₀) = x.1 := RingHom.congr_fun hρx_comp_j x₀
          rw [map_mul, map_one, h3] at h2
          exact h2
        exact IsUnit.of_mul_eq_one y hxy1

    have hLoc_sh : IsLocalRing R_sh := by
      apply IsLocalRing.of_nonunits_add
      intro a b ha hb
      rw [mem_nonunits_iff, hUnit_iff, not_not] at ha hb ⊢
      exact (IsLocalRing.maximalIdeal R_bar).add_mem ha hb
    letI : IsLocalRing R_sh := hLoc_sh

    have hMax_iff : ∀ x : R_sh, x.1 ∈ IsLocalRing.maximalIdeal R_bar ↔
        x ∈ IsLocalRing.maximalIdeal R_sh := by
      intro x
      conv_rhs => rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hUnit_iff, not_not]

    
    let ι_k_κ : k →+* IsLocalRing.ResidueField R_bar :=
      (IsLocalRing.residue R_bar).comp
        (((p_Δ_R.comp (algebraMap P R_Δ)).comp Polynomial.C))

    have hSection_all : ∀ j : ℐ_sh,
        ∃ χ_C : ↥j.1 →+* k,
          χ_C.comp (algebraMap R_Δ ↥j.1) = ev₀ ∧
          ∀ y : ↥j.1, IsLocalRing.residue R_bar (j.1.val y) = ι_k_κ (χ_C y) := by
      intro j
      letI : Algebra R_Δ k := ev₀.toAlgebra
      have : Algebra.Etale R_Δ ↥j.1 := RingHom.etale_algebraMap.mp j.2
      let T_j := TensorProduct R_Δ k ↥j.1
      have : Algebra.Etale k T_j := Algebra.Etale.baseChange R_Δ ↥j.1 k
      obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k T_j).mp inferInstance
      have : Finite I := hFinI
      letI : Fintype I := Fintype.ofFinite I
      letI : ∀ a, Field (L a) := hFieldL
      letI : ∀ a, Algebra k (L a) := hAlgL

      let κ_bar := IsLocalRing.ResidueField R_bar
      letI : Algebra R_Δ κ_bar := ((IsLocalRing.residue R_bar).comp p_Δ_R).toAlgebra
      let f_k : k →ₐ[R_Δ] κ_bar :=
        { toRingHom := ι_k_κ
          commutes' := fun r => (RingHom.congr_fun hRes r).symm }
      let f_C : ↥j.1 →ₐ[R_Δ] κ_bar :=
        { toRingHom := (IsLocalRing.residue R_bar).comp j.1.val.toRingHom
          commutes' := fun r => congrArg (IsLocalRing.residue R_bar) (j.1.val.commutes r) }
      let μ_j : T_j →+* κ_bar := (Algebra.TensorProduct.productMap f_k f_C).toRingHom

      have hex_a₀ : ∃ a₀ : I, Θ.symm (Pi.single a₀ 1) ∉ RingHom.ker μ_j := by
        by_contra! hall
        have hsum1 : (1 : ∀ a : I, L a) = ∑ a : I, Pi.single a (1 : L a) := by
          ext b; simp [Finset.sum_apply]
        have hT1 : (1 : T_j) = ∑ a : I, Θ.symm (Pi.single a 1) := by
          calc (1 : T_j) = Θ.symm 1 := (map_one Θ.symm).symm
            _ = ∑ a : I, Θ.symm (Pi.single a 1) := by rw [hsum1, map_sum]
        have hmem1 : (1 : T_j) ∈ RingHom.ker μ_j := by
          rw [hT1]
          exact Ideal.sum_mem (RingHom.ker μ_j) (fun a _ => hall a)
        rw [RingHom.mem_ker, map_one] at hmem1
        exact one_ne_zero hmem1
      obtain ⟨a₀, ha₀_not_ker⟩ := hex_a₀

      have hSurj_a₀ : Function.Surjective (algebraMap k (L a₀)) := by
        intro y
        have : Module.Finite k (L a₀) := (hFinSep a₀).1
        have hy_int : _root_.IsIntegral k y := Algebra.IsIntegral.isIntegral y
        let m_y := minpoly k y
        have hm_deg : m_y.degree ≠ 0 :=
          ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root m_y hm_deg
        obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
        have hq_unit : IsUnit q_pol :=
          ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
            (Polynomial.not_isUnit_X_sub_C c)
        have hq_monic : q_pol.Monic :=
          Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
            (hq_pol ▸ minpoly.monic hy_int)
        have hq1 : q_pol = 1 := by
          have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
          have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
          rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
        have hm_eq : m_y = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
        have haeval : Polynomial.aeval y m_y = 0 := minpoly.aeval k y
        rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
        exact ⟨c, haeval.symm⟩

      let e_L : k ≃+* L a₀ :=
        RingEquiv.ofBijective (algebraMap k (L a₀)) ⟨RingHom.injective _, hSurj_a₀⟩
      let π_T : T_j →+* k :=
        e_L.symm.toRingHom.comp ((Pi.evalRingHom L a₀).comp Θ.toRingHom)
      have hπ_k : ∀ c : k, π_T (algebraMap k T_j c) = c := by
        intro c
        change e_L.symm (Θ (algebraMap k T_j c) a₀) = c
        rw [Θ.commutes]
        exact e_L.symm_apply_apply c
      have hμ_π : ∀ t : T_j, μ_j t = ι_k_κ (π_T t) := by
        intro t
        have hprod0 : Θ.symm (Pi.single a₀ 1) * (t - algebraMap k T_j (π_T t)) = 0 := by
          apply Θ.injective
          rw [map_mul, map_sub, Θ.apply_symm_apply, map_zero]
          ext b
          by_cases hb : b = a₀
          · subst hb
            simp only [Pi.single_eq_same, Pi.mul_apply, Pi.sub_apply, one_mul, Pi.zero_apply]
            rw [Θ.commutes]
            exact sub_eq_zero.mpr (e_L.apply_symm_apply (Θ t b)).symm
          · simp [Pi.single_eq_of_ne hb]
        have hmul0 : μ_j (Θ.symm (Pi.single a₀ 1)) * μ_j (t - algebraMap k T_j (π_T t)) = 0 := by
          rw [← map_mul, hprod0, map_zero]
        have he_ne : μ_j (Θ.symm (Pi.single a₀ 1)) ≠ 0 := ha₀_not_ker
        have hdiff0 : μ_j (t - algebraMap k T_j (π_T t)) = 0 :=
          (mul_eq_zero.mp hmul0).resolve_left he_ne
        rw [map_sub, sub_eq_zero] at hdiff0
        have hμ_alg : μ_j (algebraMap k T_j (π_T t)) = ι_k_κ (π_T t) := by
          change (Algebra.TensorProduct.productMap f_k f_C) ((π_T t) ⊗ₜ[R_Δ] (1 : ↥j.1)) = _
          simp [f_k]
        exact hdiff0.trans hμ_alg

      let χ_C : ↥j.1 →+* k :=
        π_T.comp (Algebra.TensorProduct.includeRight (R := R_Δ) (A := k) (B := ↥j.1)).toRingHom
      refine ⟨χ_C, ?_, ?_⟩
      · ext r
        change π_T ((1 : k) ⊗ₜ[R_Δ] algebraMap R_Δ ↥j.1 r) = ev₀ r
        have htmul : ((1 : k) ⊗ₜ[R_Δ] algebraMap R_Δ ↥j.1 r : T_j) = algebraMap k T_j (ev₀ r) := by
          rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul]
          rfl
        rw [htmul, hπ_k]
      · intro y
        have hμ_y : μ_j ((1 : k) ⊗ₜ[R_Δ] y) = IsLocalRing.residue R_bar (j.1.val y) := by
          change (Algebra.TensorProduct.productMap f_k f_C) ((1 : k) ⊗ₜ[R_Δ] y) = _
          simp [f_C]
        exact hμ_y.symm.trans (hμ_π ((1 : k) ⊗ₜ[R_Δ] y))

    
    have hAlgClosed_sh : IsAlgClosed (IsLocalRing.ResidueField R_sh) := by
      let ι_k_sh : k →+* IsLocalRing.ResidueField R_sh :=
        (IsLocalRing.residue R_sh).comp
          ((algebraMap R_Δ R_sh).comp ((algebraMap P R_Δ).comp Polynomial.C))
      have hSurj_sh : Function.Surjective ι_k_sh := by
        intro z_bar
        obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective z_bar
        obtain ⟨j, hzj⟩ := hCov_sh z
        obtain ⟨χ_C, _, hχ_res⟩ := hSection_all j
        let c := χ_C ⟨z.1, hzj⟩
        refine ⟨c, ?_⟩
        change Ideal.Quotient.mk (IsLocalRing.maximalIdeal R_sh)
            (algebraMap R_Δ R_sh (algebraMap P R_Δ (Polynomial.C c))) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal R_sh) z
        symm
        rw [Ideal.Quotient.eq, ← hMax_iff]
        change z.1 - p_Δ_R (algebraMap P R_Δ (Polynomial.C c)) ∈ IsLocalRing.maximalIdeal R_bar
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
        exact hχ_res ⟨z.1, hzj⟩
      let e_res_sh : k ≃+* IsLocalRing.ResidueField R_sh :=
        RingEquiv.ofBijective ι_k_sh ⟨ι_k_sh.injective, hSurj_sh⟩
      refine IsAlgClosed.of_exists_root _ fun p _ hp_irr => ?_
      let p₀ : Polynomial k := p.map e_res_sh.symm.toRingHom
      have hp₀_deg : p₀.degree ≠ 0 := by
        rw [Polynomial.degree_map_eq_of_injective e_res_sh.symm.injective]
        exact ne_of_gt (Irreducible.degree_pos hp_irr)
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p₀ hp₀_deg
      refine ⟨e_res_sh c, ?_⟩
      have hev : Polynomial.eval c p₀ = e_res_sh.symm (Polynomial.eval (e_res_sh c) p) := by
        dsimp [p₀]
        rw [Polynomial.eval_map]
        conv_lhs => rw [← e_res_sh.symm_apply_apply c]
        exact (Polynomial.hom_eval₂ p (RingHom.id _) e_res_sh.symm.toRingHom (e_res_sh c)).symm
      have hc0 : e_res_sh.symm (Polynomial.eval (e_res_sh c) p) = 0 := hev.symm.trans hc
      simpa using congrArg e_res_sh hc0

    
    have hFinSetStage : ∀ (n : ℕ) (g : Fin n → R_sh),
        ∃ j : ℐ_sh, ∀ m : Fin n, (g m).1 ∈ j.1 := by
      intro n
      induction n with
      | zero =>
        intro _
        exact ⟨j_bot, fun m => Fin.elim0 m⟩
      | succ n ih =>
        intro g
        obtain ⟨j₁, hj₁⟩ := ih (fun m : Fin n => g m.castSucc)
        obtain ⟨j₂, hj₂⟩ := hCov_sh (g (Fin.last n))
        obtain ⟨j₃, h₁₃, h₂₃⟩ := hUpper j₁ j₂
        refine ⟨j₃, fun m => ?_⟩
        rcases Fin.lastCases (motive := fun m => (g m).1 ∈ j₃.1)
          (h₂₃ hj₂) (fun i => h₁₃ (hj₁ i)) m with hm
        exact hm

    have hHens_sh : HenselianLocalRing R_sh := by
      apply HenselianLocalRing.mk
      intro f hf_mon a₀ ha₀ hderiv
      let ι_bar : R_sh →+* R_bar := S_sh.val.toRingHom
      let f_bar : Polynomial R_bar := f.map ι_bar
      have hf_bar_mon : f_bar.Monic := hf_mon.map ι_bar
      have ha₀_bar : Polynomial.eval a₀.1 f_bar ∈ IsLocalRing.maximalIdeal R_bar := by
        have hev : Polynomial.eval a₀.1 f_bar = (Polynomial.eval a₀ f).1 := by
          dsimp [f_bar]
          rw [Polynomial.eval_map]
          exact (Polynomial.hom_eval₂ f (RingHom.id R_sh) ι_bar a₀).symm
        rw [hev, hMax_iff]
        exact ha₀
      have hderiv_bar : IsUnit (Polynomial.eval a₀.1 f_bar.derivative) := by
        have hev : Polynomial.eval a₀.1 f_bar.derivative = (Polynomial.eval a₀ f.derivative).1 := by
          dsimp [f_bar]
          rw [Polynomial.derivative_map, Polynomial.eval_map]
          exact (Polynomial.hom_eval₂ f.derivative (RingHom.id R_sh) ι_bar a₀).symm
        rw [hev]
        exact hderiv.map ι_bar
      have hH_ex := HenselianLocalRing.is_henselian f_bar hf_bar_mon a₀.1 ha₀_bar hderiv_bar
      let r : R_bar := Classical.choose hH_ex
      have hr_root : Polynomial.eval r f_bar = 0 := (Classical.choose_spec hH_ex).1
      have hr_diff : r - a₀.1 ∈ IsLocalRing.maximalIdeal R_bar := (Classical.choose_spec hH_ex).2
      have hr_deriv_unit : IsUnit (Polynomial.eval r f_bar.derivative) := by
        have hdvd : r - a₀.1 ∣
            Polynomial.eval r f_bar.derivative - Polynomial.eval a₀.1 f_bar.derivative :=
          Polynomial.sub_dvd_eval_sub r a₀.1 f_bar.derivative
        have hsub_max :
            Polynomial.eval r f_bar.derivative - Polynomial.eval a₀.1 f_bar.derivative ∈
              IsLocalRing.maximalIdeal R_bar :=
          Ideal.mem_of_dvd _ hdvd hr_diff
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hr_mem
        have ha₀_mem : Polynomial.eval a₀.1 f_bar.derivative ∈ IsLocalRing.maximalIdeal R_bar := by
          have heq : Polynomial.eval a₀.1 f_bar.derivative =
              Polynomial.eval r f_bar.derivative -
                (Polynomial.eval r f_bar.derivative - Polynomial.eval a₀.1 f_bar.derivative) := by
            ring
          rw [heq]
          exact (IsLocalRing.maximalIdeal R_bar).sub_mem hr_mem hsub_max
        exact (IsLocalRing.notMem_maximalIdeal.mpr hderiv_bar) ha₀_mem

      let n := f.natDegree
      obtain ⟨j₀, hj₀⟩ := hFinSetStage n (fun m : Fin n => f.coeff m.1)
      let C := j₀.1
      let c_C : Fin n → ↥C := fun m => ⟨(f.coeff m.1).1, hj₀ m⟩
      let F_C : Polynomial ↥C :=
        Polynomial.X ^ n + ∑ m : Fin n, Polynomial.C (c_C m) * Polynomial.X ^ m.1
      have hdeg_low : (∑ m : Fin n, Polynomial.C (c_C m) * Polynomial.X ^ m.1).degree <
          (n : WithBot ℕ) := by
        by_cases hn0 : n = 0
        · simp [hn0]
        · have : 0 < n := Nat.pos_of_ne_zero hn0
          exact (Polynomial.degree_sum_fin_lt c_C).trans_le (le_refl _)
      have hFC_mon : F_C.Monic := Polynomial.monic_X_pow_add hdeg_low
      have hFC_map : F_C.map C.val.toRingHom = f_bar := by
        have hf_sum : f = Polynomial.X ^ n +
            ∑ m : Fin n, Polynomial.C (f.coeff m.1) * Polynomial.X ^ m.1 := by
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow f]
          rw [Finset.sum_range_succ, add_comm]
          have hlc : f.coeff n = 1 := hf_mon.coeff_natDegree
          dsimp [n] at hlc ⊢
          rw [hlc, map_one, one_mul,
            ← Fin.sum_univ_eq_sum_range (fun m => Polynomial.C (f.coeff m) * Polynomial.X ^ m) n]
        dsimp [f_bar]
        conv_rhs => rw [hf_sum]
        dsimp [F_C]
        simp only [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
          Polynomial.map_mul, Polynomial.map_C]
        rfl

      let P_et : _root_.StandardEtalePair ↥C :=
        _root_.StandardEtalePair.mk F_C hFC_mon F_C.derivative ⟨1, 0, 1, by simp⟩
      have hCP_et : (algebraMap ↥C P_et.Ring).Etale :=
        (RingHom.etale_algebraMap (R := ↥C) (S := P_et.Ring)).mpr inferInstance
      let φ_et : R_Δ →+* P_et.Ring := (algebraMap ↥C P_et.Ring).comp (algebraMap R_Δ ↥C)
      have hφ_et : φ_et.Etale :=
        RingHom.Etale.stableUnderComposition (algebraMap R_Δ ↥C) (algebraMap ↥C P_et.Ring) j₀.2 hCP_et
      letI : Algebra ↥C R_bar := C.val.toRingHom.toAlgebra
      have hHasMap : P_et.HasMap r := by
        refine ⟨?_, ?_⟩
        · change Polynomial.aeval r F_C = 0
          rw [Polynomial.aeval_def, ← Polynomial.eval_map]
          change Polynomial.eval r (F_C.map C.val.toRingHom) = 0
          rw [hFC_map]
          exact hr_root
        · change IsUnit (Polynomial.aeval r F_C.derivative)
          rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Polynomial.derivative_map]
          change IsUnit (Polynomial.eval r (F_C.map C.val.toRingHom).derivative)
          rw [hFC_map]
          exact hr_deriv_unit
      let ρ_et_alg : P_et.Ring →ₐ[↥C] R_bar := P_et.lift r hHasMap
      have hρ_et_comp : ρ_et_alg.toRingHom.comp φ_et = p_Δ_R := by
        ext x_Δ
        change ρ_et_alg (algebraMap ↥C P_et.Ring (algebraMap R_Δ ↥C x_Δ)) = p_Δ_R x_Δ
        rw [ρ_et_alg.commutes]
        exact C.val.commutes x_Δ
      obtain ⟨j₁, hj₁_sub⟩ := hEmbedEtale P_et.Ring φ_et hφ_et ρ_et_alg.toRingHom hρ_et_comp
      have hr_mem_j₁ : r ∈ j₁.1 := by
        have hX_eq : ρ_et_alg P_et.X = r := P_et.lift_X r hHasMap
        exact hj₁_sub ⟨P_et.X, hX_eq⟩
      have hr_mem_sh : r ∈ S_sh := (le_iSup (fun i : ℐ_sh => i.1) j₁) hr_mem_j₁
      let a : R_sh := ⟨r, hr_mem_sh⟩
      refine ⟨a, ?_, ?_⟩
      · rw [Polynomial.IsRoot.def]
        apply Subtype.ext
        change ι_bar (Polynomial.eval a f) = 0
        have hev : ι_bar (Polynomial.eval a f) = Polynomial.eval r f_bar := by
          dsimp [f_bar]
          rw [Polynomial.eval_map]
          exact Polynomial.hom_eval₂ f (RingHom.id R_sh) ι_bar a
        rw [hev]
        exact hr_root
      · rw [← hMax_iff]
        exact hr_diff

    
    refine ⟨ℐ_sh, hCat_sh, hFilt_sh, R_sh, hCR_sh, hDom_sh, hHens_sh, ?_⟩
    letI : CommRing R_sh := hCR_sh
    letI : IsDomain R_sh := hDom_sh
    letI : HenselianLocalRing R_sh := hHens_sh

    let D_sh : ℐ_sh ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of ↥j.1
        map := fun {j₁ j₂} θ =>
          CommRingCat.ofHom (Subalgebra.inclusion (leOfHom θ)).toRingHom
        map_id := fun _ => by apply CommRingCat.hom_ext; ext x; rfl
        map_comp := fun _ _ => by apply CommRingCat.hom_ext; ext x; rfl }
    let α_sh : (CategoryTheory.Functor.const ℐ_sh).obj (CommRingCat.of R_Δ) ⟶ D_sh :=
      { app := fun j => CommRingCat.ofHom (algebraMap R_Δ ↥j.1)
        naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext r; rfl }
    let f_sh : CommRingCat.of R_Δ ⟶ CommRingCat.of R_sh :=
      CommRingCat.ofHom (algebraMap R_Δ R_sh)
    let ι_sh : CommRingCat.of R_sh ⟶ CommRingCat.of R_bar :=
      CommRingCat.ofHom S_sh.val.toRingHom
    let c_sh : CategoryTheory.Limits.Cocone D_sh :=
      { pt := CommRingCat.of R_sh
        ι :=
          { app := fun j =>
              CommRingCat.ofHom (Subalgebra.inclusion (le_iSup (fun i : ℐ_sh => i.1) j)).toRingHom
            naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext x; rfl } }
    let e_sh : c_sh.pt ≅ CommRingCat.of R_sh := CategoryTheory.Iso.refl (CommRingCat.of R_sh)

    have hc_sh_indep : ∀ (s : CategoryTheory.Limits.Cocone D_sh) (x : R_sh) (j : ℐ_sh)
        (hx : x.1 ∈ j.1),
        (s.ι.app j).hom ⟨x.1, hx⟩ =
          (s.ι.app (Classical.choose (hCov_sh x))).hom ⟨x.1, Classical.choose_spec (hCov_sh x)⟩ := by
      intro s x j hx
      let j₀ := Classical.choose (hCov_sh x)
      have hx₀ : x.1 ∈ j₀.1 := Classical.choose_spec (hCov_sh x)
      obtain ⟨j₃, hj₃, hj₀₃⟩ := hUpper j j₀
      have h1 : (s.ι.app j).hom ⟨x.1, hx⟩ = (s.ι.app j₃).hom ⟨x.1, hj₃ hx⟩ := by
        have hnat := s.ι.naturality (homOfLE hj₃)
        exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hnat) ⟨x.1, hx⟩).symm
      have h2 : (s.ι.app j₀).hom ⟨x.1, hx₀⟩ = (s.ι.app j₃).hom ⟨x.1, hj₀₃ hx₀⟩ := by
        have hnat := s.ι.naturality (homOfLE hj₀₃)
        exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hnat) ⟨x.1, hx₀⟩).symm
      exact h1.trans h2.symm

    let desc_sh : ∀ s : CategoryTheory.Limits.Cocone D_sh, c_sh.pt ⟶ s.pt := fun s =>
      CommRingCat.ofHom
        { toFun := fun x =>
            (s.ι.app (Classical.choose (hCov_sh x))).hom ⟨x.1, Classical.choose_spec (hCov_sh x)⟩
          map_one' := by
            rw [← hc_sh_indep s 1 j_bot j_bot.1.one_mem]
            exact map_one (s.ι.app j_bot).hom
          map_mul' := fun x y => by
            obtain ⟨jx, hx⟩ := hCov_sh x
            obtain ⟨jy, hy⟩ := hCov_sh y
            obtain ⟨j₃, h₁, h₂⟩ := hUpper jx jy
            rw [← hc_sh_indep s x j₃ (h₁ hx), ← hc_sh_indep s y j₃ (h₂ hy),
              ← hc_sh_indep s (x * y) j₃ (j₃.1.mul_mem (h₁ hx) (h₂ hy))]
            exact map_mul (s.ι.app j₃).hom ⟨x.1, h₁ hx⟩ ⟨y.1, h₂ hy⟩
          map_zero' := by
            rw [← hc_sh_indep s 0 j_bot j_bot.1.zero_mem]
            exact map_zero (s.ι.app j_bot).hom
          map_add' := fun x y => by
            obtain ⟨jx, hx⟩ := hCov_sh x
            obtain ⟨jy, hy⟩ := hCov_sh y
            obtain ⟨j₃, h₁, h₂⟩ := hUpper jx jy
            rw [← hc_sh_indep s x j₃ (h₁ hx), ← hc_sh_indep s y j₃ (h₂ hy),
              ← hc_sh_indep s (x + y) j₃ (j₃.1.add_mem (h₁ hx) (h₂ hy))]
            exact map_add (s.ι.app j₃).hom ⟨x.1, h₁ hx⟩ ⟨y.1, h₂ hy⟩ }

    have hc_sh : CategoryTheory.Limits.IsColimit c_sh :=
      { desc := desc_sh
        fac := fun s j => by
          apply CommRingCat.hom_ext
          ext y
          exact (hc_sh_indep s ((c_sh.ι.app j).hom y) j y.2).symm
        uniq := fun s m hm => by
          apply CommRingCat.hom_ext
          ext x
          let j₀ := Classical.choose (hCov_sh x)
          have hx₀ : x.1 ∈ j₀.1 := Classical.choose_spec (hCov_sh x)
          have hx_eq : (c_sh.ι.app j₀).hom ⟨x.1, hx₀⟩ = x := by
            apply Subtype.ext; rfl
          calc
            m.hom x = m.hom ((c_sh.ι.app j₀).hom ⟨x.1, hx₀⟩) := by rw [hx_eq]
            _ = (c_sh.ι.app j₀ ≫ m).hom ⟨x.1, hx₀⟩ := rfl
            _ = (s.ι.app j₀).hom ⟨x.1, hx₀⟩ := by rw [hm j₀]
            _ = (desc_sh s).hom x := rfl }

    refine ⟨hAlgClosed_sh, D_sh, α_sh, f_sh, ι_sh, c_sh, hc_sh, e_sh, ?_, ?_, ?_, ?_⟩
    · apply CommRingCat.hom_ext
      ext r
      exact S_sh.val.commutes r
    · exact Subtype.val_injective
    · intro x
      exact hMax_iff x
    · intro j
      refine ⟨j.2, (inferInstance : IsDomain ↥j.1), ?_, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        ext r
        exact j.1.val.commutes r
      · exact Subtype.val_injective
      · obtain ⟨χ_C, hχ_ev, _⟩ := hSection_all j
        refine ⟨CommRingCat.ofHom χ_C, ?_⟩
        apply CommRingCat.hom_ext
        exact hχ_ev

  
  intro P R_Δ Ω R_bar t_bar
  obtain ⟨p_Δ_R, φ_R_Ω, hClause1, hφ_B, hP_inj, hRes_surj⟩ := hPart2
  have ⟨hDom_R, hHens_R, _, ht_max, ht_ne, hp_Δ_R, hRes_Δ, _, hφ_comp, hφ_inj, _⟩ := hClause1
  have : IsDomain (Localization.AtPrime M_max) := hDom_R
  have : IsDomain R_bar := hDom_R
  have : HenselianLocalRing R_bar := hHens_R
  have hEtShrink : ∀ (E : Type u) [CommRing E]
      (α_E : Polynomial k →+* E), α_E.Etale →
      ∀ (ρ : E →+* R_bar),
        ρ (α_E Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar →
        Function.Injective (ρ.comp α_E) →
        ∃ h_E : E,
          IsUnit (ρ h_E) ∧
          IsDomain (Localization.Away h_E) ∧
          ((algebraMap E (Localization.Away h_E)).comp α_E).Etale ∧
          ∀ (ρ₁ : Localization.Away h_E →+* R_bar),
            ρ₁.comp (algebraMap E (Localization.Away h_E)) = ρ →
            Function.Injective ρ₁ :=
    fun E _ α_E hα_et ρ hX hInj => hPart3 R_bar E α_E hα_et ρ hX hInj
  have hClause2 := hPart4 φ_R_Ω hφ_B hφ_comp hφ_inj ht_max ht_ne hP_inj hRes_surj hEtShrink
  have ht_max_Δ : p_Δ_R (algebraMap P R_Δ Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar := by
    change (p_Δ_R.comp (algebraMap P R_Δ)) Polynomial.X ∈ IsLocalRing.maximalIdeal R_bar
    rw [hp_Δ_R]
    exact ht_max
  have hp_P_inj : Function.Injective (p_Δ_R.comp (algebraMap P R_Δ)) := by
    rw [hp_Δ_R]
    exact hP_inj
  have hClause3 := hPart5 R_bar p_Δ_R ht_max_Δ hp_P_inj hRes_Δ hEtShrink
  exact ⟨p_Δ_R, φ_R_Ω, hClause1, hClause2, hClause3⟩

theorem weil_punctured_val_ring_acyclic_etale_chart_stage_descent (k : Type u) [Field k]
    (d_rel ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial k →+* R_bar)
    (t_bar : R_bar) (ht_eq : p_R Polynomial.X = t_bar)
    (Ω : Type u) [Field Ω]
    (φ_R_Ω : R_bar →+* Ω)
    (hLoc_t : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra)
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D : ℐ ⥤ CommRingCat.{u})
    (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial k)) ⟶ D)
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (e_pt : c.pt ≅ CommRingCat.of R_bar)
    (hCocone_eq : ∀ i : ℐ, (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R)
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ) (ψ_i : Polynomial k →+* ↑(D.obj i)),
        1 ≤ e ∧
        ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
        (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁)) (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
          (D.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale) :
    let S_d := weilAffineSpaceOver k d_rel
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let κ_A1 : A1_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
    let U_d := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let j_d : U_d ⟶ Y_d :=
      CategoryTheory.Limits.pullback.snd j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
    let A_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let j_A : A_Ω ⟶ A_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ A_R) [AlgebraicGeometry.Etale w],
      ∃ (𝒥 : Type u) (hCat : CategoryTheory.SmallCategory 𝒥)
        (hFilt : CategoryTheory.IsFiltered 𝒥),
        letI : CategoryTheory.SmallCategory 𝒥 := hCat
        letI : CategoryTheory.IsFiltered 𝒥 := hFilt
        ∃ (E_diag E_loc : 𝒥 ⥤ CommRingCat.{u})
          (ι_loc : E_diag ⟶ E_loc)
          (c_E : CategoryTheory.Limits.Cocone E_diag)
          (_ : CategoryTheory.Limits.IsColimit c_E)
          (c_Eloc : CategoryTheory.Limits.Cocone E_loc)
          (_ : CategoryTheory.Limits.IsColimit c_Eloc)
          (ι_inf : c_E.pt ⟶ c_Eloc.pt)
          (e_W : AlgebraicGeometry.Spec c_E.pt ≅ W)
          (e_WU : AlgebraicGeometry.Spec c_Eloc.pt ≅ CategoryTheory.Limits.pullback j_A w),
          (∀ j : 𝒥, c_E.ι.app j ≫ ι_inf = ι_loc.app j ≫ c_Eloc.ι.app j) ∧
          (e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_A w =
            AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom) ∧
          (∀ j : 𝒥,
            ∃ (w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d)
              (_ : AlgebraicGeometry.Etale w_j)
              (ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅
                CategoryTheory.Limits.pullback j_d w_j),
              ϕ_j.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
                AlgebraicGeometry.Spec.map (ι_loc.app j) ∧
              ∃ (j₁ : 𝒥) (θ_U : j ⟶ j₁)
                (w₁ : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶ Y_d)
                (_ : AlgebraicGeometry.Etale w₁)
                (ϕ₁ : AlgebraicGeometry.Spec (E_loc.obj j₁) ≅
                  CategoryTheory.Limits.pullback j_d w₁),
                ϕ₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁ =
                  AlgebraicGeometry.Spec.map (ι_loc.app j₁) ∧
                (let π_W : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶
                    AlgebraicGeometry.Spec (E_diag.obj j) :=
                    AlgebraicGeometry.Spec.map (E_diag.map θ_U)
                 let π_WU : CategoryTheory.Limits.pullback j_d w₁ ⟶
                    CategoryTheory.Limits.pullback j_d w_j :=
                    ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫ ϕ_j.hom
                 π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
                   w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 ∧
                 π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
                   w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 ∧
                 π_WU ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
                   CategoryTheory.Limits.pullback.snd j_d w₁ ≫ π_W)) :=
by
  classical
  intro S_d A1_k Gm_k j_Gm κ_A1 p_A1 Y_d U_d j_d g_k_R j_R A_R A_Ω j_A W _ w _

  have hα_nat : ∀ {i i' : ℐ} (θ : i ⟶ i'), α.app i ≫ D.map θ = α.app i' := by
    intro i i' θ
    exact (α.naturality θ).symm.trans (Category.id_comp _)

  
  
  
  have hToAlgAway : ∀ (R : Type u) [CommRing R] (r : R),
      @IsLocalization.Away R _ r (Localization.Away r) _
        (algebraMap R (Localization.Away r)).toAlgebra := by
    intro R _ r
    have hu : IsUnit (algebraMap R (Localization.Away r) r) :=
      IsLocalization.Away.algebraMap_isUnit (S := Localization.Away r) r
    have hsurj : ∀ s : Localization.Away r,
        ∃ (n : ℕ) (a : R),
          s * (algebraMap R (Localization.Away r) r) ^ n =
            algebraMap R (Localization.Away r) a := by
      intro s
      obtain ⟨⟨a, _, ⟨n, rfl⟩⟩, hs⟩ :=
        IsLocalization.surj (M := Submonoid.powers r) (S := Localization.Away r) s
      refine ⟨n, a, ?_⟩
      rwa [← map_pow]
    have heq : ∀ a b : R,
        algebraMap R (Localization.Away r) a = algebraMap R (Localization.Away r) b →
          ∃ n : ℕ, r ^ n * a = r ^ n * b := by
      intro a b hab
      obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers r) (Localization.Away r)).mp hab
      exact ⟨n, hn⟩
    exact @IsLocalization.Away.mk R _ (Localization.Away r) _
      (algebraMap R (Localization.Away r)).toAlgebra r hu hsurj heq

  have hPushLocAway : ∀ {A B A_x B_y : CommRingCat.{u}}
      (φ_A : A ⟶ A_x) (ρ : A ⟶ B) (ι_B : B ⟶ B_y) (x₀ : ↑A),
      @IsLocalization.Away ↑A _ x₀ ↑A_x _ φ_A.hom.toAlgebra →
      @IsLocalization.Away ↑B _ (ρ.hom x₀) ↑B_y _ ι_B.hom.toAlgebra →
      ∃ ψ : A_x ⟶ B_y, CategoryTheory.IsPushout φ_A ρ ψ ι_B := by
    intro A B A_x B_y φ_A ρ ι_B x₀ hLocA hLocB
    let _ : Algebra ↑A ↑A_x := φ_A.hom.toAlgebra
    let _ : Algebra ↑B ↑B_y := ι_B.hom.toAlgebra
    have _ : IsLocalization.Away x₀ ↑A_x := hLocA
    have _ : IsLocalization.Away (ρ.hom x₀) ↑B_y := hLocB
    have hUnitB : IsUnit ((ι_B.hom.comp ρ.hom) x₀) := by
      change IsUnit (algebraMap (↑B) (↑B_y) (ρ.hom x₀))
      exact IsLocalization.Away.algebraMap_isUnit (S := ↑B_y) (ρ.hom x₀)
    let ψ_hom : ↑A_x →+* ↑B_y :=
      IsLocalization.Away.lift x₀ (g := ι_B.hom.comp ρ.hom) hUnitB
    let ψ : A_x ⟶ B_y := CommRingCat.ofHom ψ_hom
    have hw_loc : φ_A ≫ ψ = ρ ≫ ι_B := by
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro a
      exact IsLocalization.Away.lift_eq x₀ hUnitB a
    have hUnitS : ∀ s : CategoryTheory.Limits.PushoutCocone φ_A ρ,
        IsUnit (s.inr.hom (ρ.hom x₀)) := by
      intro s
      have heq : s.inr.hom (ρ.hom x₀) = s.inl.hom (φ_A.hom x₀) :=
        (congrArg (fun f => f.hom x₀) s.condition).symm
      rw [heq]
      have huA : IsUnit (φ_A.hom x₀) :=
        IsLocalization.Away.algebraMap_isUnit (S := ↑A_x) x₀
      exact huA.map s.inl.hom
    refine ⟨ψ, CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_loc
        (fun s => CommRingCat.ofHom
          (IsLocalization.Away.lift (ρ.hom x₀) (g := s.inr.hom) (hUnitS s)))
        ?_ ?_ ?_)⟩
    · intro s
      apply CommRingCat.Hom.ext
      apply IsLocalization.ringHom_ext (Submonoid.powers x₀)
      apply RingHom.ext
      intro a
      change (IsLocalization.Away.lift (ρ.hom x₀) (g := s.inr.hom) (hUnitS s))
          (ψ_hom (algebraMap (↑A) (↑A_x) a)) = s.inl.hom (φ_A.hom a)
      have h1 : ψ_hom (algebraMap (↑A) (↑A_x) a) = algebraMap (↑B) (↑B_y) (ρ.hom a) :=
        IsLocalization.Away.lift_eq x₀ hUnitB a
      rw [h1, IsLocalization.Away.lift_eq (ρ.hom x₀) (hUnitS s)]
      exact (congrArg (fun f => f.hom a) s.condition).symm
    · intro s
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro b
      exact IsLocalization.Away.lift_eq (ρ.hom x₀) (hUnitS s) b
    · intro s m _ hm_inr
      apply CommRingCat.Hom.ext
      apply IsLocalization.ringHom_ext (Submonoid.powers (ρ.hom x₀))
      apply RingHom.ext
      intro b
      change m.hom (algebraMap (↑B) (↑B_y) b) =
        (IsLocalization.Away.lift (ρ.hom x₀) (g := s.inr.hom) (hUnitS s))
          (algebraMap (↑B) (↑B_y) b)
      rw [IsLocalization.Away.lift_eq (ρ.hom x₀) (hUnitS s)]
      exact congrArg (fun f => f.hom b) hm_inr

  
  
  
  obtain ⟨D_poly, ι_D, c_poly, hc_poly, t_poly, π_Sd, E_inf, E_inf_loc, f_E, ι_inf₀,
      e_W₀, e_WU₀, ht_colim, hπ_nat, hv_stage, hf_E, hLoc_inf, he_comm₀⟩ :
      ∃ (D_poly : ℐ ⥤ CommRingCat.{u})
        (ι_D : D ⟶ D_poly)
        (c_poly : CategoryTheory.Limits.Cocone D_poly)
        (_ : CategoryTheory.Limits.IsColimit c_poly)
        (t_poly : ↑c_poly.pt)
        (π_Sd : ∀ i : ℐ, AlgebraicGeometry.Spec (D_poly.obj i) ⟶ S_d.left)
        (E_inf E_inf_loc : CommRingCat.{u})
        (f_E : c_poly.pt ⟶ E_inf)
        (ι_inf₀ : E_inf ⟶ E_inf_loc)
        (e_W₀ : AlgebraicGeometry.Spec E_inf ≅ W)
        (e_WU₀ : AlgebraicGeometry.Spec E_inf_loc ≅ CategoryTheory.Limits.pullback j_A w),
        (∀ i : ℐ, (c_poly.ι.app i).hom ((ι_D.app i).hom ((α.app i).hom Polynomial.X)) = t_poly) ∧
        (∀ {i i' : ℐ} (θ : i ⟶ i'),
          AlgebraicGeometry.Spec.map (D_poly.map θ) ≫ π_Sd i = π_Sd i') ∧
        (∀ (i : ℐ) (ψ : Polynomial k →+* ↑(D.obj i)),
          ψ.comp Polynomial.C = (α.app i).hom.comp Polynomial.C →
          ψ.Etale →
          ∃ (v_i : AlgebraicGeometry.Spec (D_poly.obj i) ⟶ Y_d),
            AlgebraicGeometry.Etale v_i ∧
            v_i ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 = π_Sd i ∧
            v_i ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
              AlgebraicGeometry.Spec.map (ι_D.app i) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        f_E.hom.Etale ∧
        @IsLocalization.Away ↑E_inf _ (f_E.hom t_poly) ↑E_inf_loc _ ι_inf₀.hom.toAlgebra ∧
        (e_WU₀.hom ≫ CategoryTheory.Limits.pullback.snd j_A w =
          AlgebraicGeometry.Spec.map ι_inf₀ ≫ e_W₀.hom) := by
    have hPushMvPoly : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (σ : R₁ →+* R₂),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom (MvPolynomial.C : R₁ →+* MvPolynomial (Fin d_rel) R₁))
          (CommRingCat.ofHom σ)
          (CommRingCat.ofHom (MvPolynomial.map σ))
          (CommRingCat.ofHom (MvPolynomial.C : R₂ →+* MvPolynomial (Fin d_rel) R₂)) := by
      intro R₁ R₂ _ _ σ
      have hw_mv :
          (CommRingCat.ofHom (MvPolynomial.C : R₁ →+* MvPolynomial (Fin d_rel) R₁)) ≫
            CommRingCat.ofHom (MvPolynomial.map σ) =
          CommRingCat.ofHom σ ≫
            CommRingCat.ofHom (MvPolynomial.C : R₂ →+* MvPolynomial (Fin d_rel) R₂) := by
        apply CommRingCat.Hom.ext
        apply RingHom.ext
        intro r
        exact MvPolynomial.map_C σ r
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_mv
          (fun s => CommRingCat.ofHom
            (MvPolynomial.eval₂Hom s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m))))
          ?_ ?_ ?_)
      · intro s
        apply CommRingCat.Hom.ext
        apply MvPolynomial.ringHom_ext
        · intro r
          change (MvPolynomial.eval₂Hom s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m)))
              (MvPolynomial.map σ (MvPolynomial.C r)) = s.inl.hom (MvPolynomial.C r)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact (congrArg (fun f => f.hom r) s.condition).symm
        · intro m
          change (MvPolynomial.eval₂Hom s.inr.hom (fun n => s.inl.hom (MvPolynomial.X n)))
              (MvPolynomial.map σ (MvPolynomial.X m)) = s.inl.hom (MvPolynomial.X m)
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · intro s
        apply CommRingCat.Hom.ext
        apply RingHom.ext
        intro r
        exact MvPolynomial.eval₂Hom_C _ _ r
      · intro s m hm_inl hm_inr
        apply CommRingCat.Hom.ext
        apply MvPolynomial.ringHom_ext
        · intro r
          change m.hom (MvPolynomial.C r) =
            (MvPolynomial.eval₂Hom s.inr.hom (fun n => s.inl.hom (MvPolynomial.X n)))
              (MvPolynomial.C r)
          rw [MvPolynomial.eval₂Hom_C]
          exact congrArg (fun f => f.hom r) hm_inr
        · intro n
          change m.hom (MvPolynomial.X n) =
            (MvPolynomial.eval₂Hom s.inr.hom (fun n' => s.inl.hom (MvPolynomial.X n')))
              (MvPolynomial.X n)
          rw [MvPolynomial.eval₂Hom_X']
          have hXn : (MvPolynomial.X n : MvPolynomial (Fin d_rel) R₂) =
              MvPolynomial.map σ (MvPolynomial.X n) := (MvPolynomial.map_X σ n).symm
          rw [hXn]
          exact congrArg (fun f => f.hom (MvPolynomial.X n)) hm_inl

    let c_R : CategoryTheory.Limits.Cocone D :=
      { pt := CommRingCat.of R_bar
        ι :=
          { app := fun i => c.ι.app i ≫ e_pt.hom
            naturality := fun _ _ θ => by
              dsimp
              rw [Category.comp_id, ← Category.assoc, c.w θ] } }
    let hc_R : CategoryTheory.Limits.IsColimit c_R :=
      CategoryTheory.Limits.IsColimit.ofIsoColimit hc
        (CategoryTheory.Limits.Cocone.ext e_pt (fun _ => rfl))

    let D_poly : ℐ ⥤ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of (MvPolynomial (Fin d_rel) ↑(D.obj i))
        map := fun θ => CommRingCat.ofHom (MvPolynomial.map (D.map θ).hom)
        map_id := fun i => by
          apply CommRingCat.Hom.ext
          apply RingHom.ext
          intro p
          rw [D.map_id]
          exact MvPolynomial.map_id p
        map_comp := fun θ₁ θ₂ => by
          apply CommRingCat.Hom.ext
          apply RingHom.ext
          intro p
          rw [D.map_comp]
          exact (MvPolynomial.map_map (D.map θ₁).hom (D.map θ₂).hom p).symm }

    let ι_D : D ⟶ D_poly :=
      { app := fun i => CommRingCat.ofHom MvPolynomial.C
        naturality := fun _ _ θ => by
          apply CommRingCat.Hom.ext
          apply RingHom.ext
          intro d
          exact (MvPolynomial.map_C (D.map θ).hom d).symm }

    let C_inf : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin d_rel) R_bar)
    let t_poly : ↑C_inf := MvPolynomial.C t_bar

    let c_poly : CategoryTheory.Limits.Cocone D_poly :=
      { pt := C_inf
        ι :=
          { app := fun i => CommRingCat.ofHom (MvPolynomial.map (c_R.ι.app i).hom)
            naturality := fun i i' θ => by
              dsimp [D_poly]
              rw [Category.comp_id]
              apply CommRingCat.Hom.ext
              apply RingHom.ext
              intro p
              have hw : (c_R.ι.app i').hom.comp (D.map θ).hom = (c_R.ι.app i).hom := by
                rw [← CommRingCat.hom_comp, c_R.w θ]
              exact (MvPolynomial.map_map (D.map θ).hom (c_R.ι.app i').hom p).trans
                (congrArg (fun h => MvPolynomial.map h p) hw) } }

    have ht_colim : ∀ i : ℐ,
        (c_poly.ι.app i).hom ((ι_D.app i).hom ((α.app i).hom Polynomial.X)) = t_poly := by
      intro i
      change MvPolynomial.map (c.ι.app i ≫ e_pt.hom).hom
          (MvPolynomial.C ((α.app i).hom Polynomial.X)) = MvPolynomial.C t_bar
      rw [MvPolynomial.map_C]
      have hX_eq : (c.ι.app i ≫ e_pt.hom).hom ((α.app i).hom Polynomial.X) = p_R Polynomial.X :=
        congrArg (fun f => f.hom Polynomial.X) (hCocone_eq i)
      rw [hX_eq, ht_eq]

    let i_star : ℐ := Classical.choice CategoryTheory.IsFiltered.nonempty
    let s_D_of : CategoryTheory.Limits.Cocone D_poly → CategoryTheory.Limits.Cocone D :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun i => ι_D.app i ≫ s.ι.app i
              naturality := fun _ _ θ => by
                dsimp
                rw [Category.comp_id, ← Category.assoc, ι_D.naturality θ,
                  Category.assoc, s.w θ] } }
    have hy_indep : ∀ (s : CategoryTheory.Limits.Cocone D_poly) (i : ℐ) (m : Fin d_rel),
        (s.ι.app i).hom (MvPolynomial.X m) = (s.ι.app i_star).hom (MvPolynomial.X m) := by
      intro s i m
      let k_m := CategoryTheory.IsFiltered.max i i_star
      let l_m : i ⟶ k_m := CategoryTheory.IsFiltered.leftToMax i i_star
      let r_m : i_star ⟶ k_m := CategoryTheory.IsFiltered.rightToMax i i_star
      have hl : (s.ι.app i).hom (MvPolynomial.X m) = (s.ι.app k_m).hom (MvPolynomial.X m) := by
        have hw := congrArg (fun f => f.hom (MvPolynomial.X m)) (s.w l_m).symm
        simpa [D_poly] using hw
      have hr : (s.ι.app i_star).hom (MvPolynomial.X m) = (s.ι.app k_m).hom (MvPolynomial.X m) := by
        have hw := congrArg (fun f => f.hom (MvPolynomial.X m)) (s.w r_m).symm
        simpa [D_poly] using hw
      exact hl.trans hr.symm

    let hc_poly : CategoryTheory.Limits.IsColimit c_poly :=
      { desc := fun s =>
          CommRingCat.ofHom
            (MvPolynomial.eval₂Hom (hc_R.desc (s_D_of s)).hom
              (fun m => (s.ι.app i_star).hom (MvPolynomial.X m)))
        fac := fun s i => by
          apply CommRingCat.Hom.ext
          apply MvPolynomial.ringHom_ext
          · intro d
            change (MvPolynomial.eval₂Hom (hc_R.desc (s_D_of s)).hom _)
                (MvPolynomial.map (c_R.ι.app i).hom (MvPolynomial.C d)) =
              (s.ι.app i).hom (MvPolynomial.C d)
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            exact congrArg (fun f => f.hom d) (hc_R.fac (s_D_of s) i)
          · intro m
            change (MvPolynomial.eval₂Hom (hc_R.desc (s_D_of s)).hom _)
                (MvPolynomial.map (c_R.ι.app i).hom (MvPolynomial.X m)) =
              (s.ι.app i).hom (MvPolynomial.X m)
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
            exact (hy_indep s i m).symm
        uniq := fun s m hm => by
          have hm_R : CommRingCat.ofHom (m.hom.comp MvPolynomial.C) = hc_R.desc (s_D_of s) := by
            apply hc_R.uniq (s_D_of s)
            intro i
            apply CommRingCat.Hom.ext
            apply RingHom.ext
            intro d
            change m.hom (MvPolynomial.C ((c_R.ι.app i).hom d)) =
              (s.ι.app i).hom (MvPolynomial.C d)
            have hC : (MvPolynomial.C ((c_R.ι.app i).hom d) : MvPolynomial (Fin d_rel) R_bar) =
                (c_poly.ι.app i).hom (MvPolynomial.C d) := (MvPolynomial.map_C _ d).symm
            rw [hC]
            exact congrArg (fun f => f.hom (MvPolynomial.C d)) (hm i)
          apply CommRingCat.Hom.ext
          apply MvPolynomial.ringHom_ext
          · intro r
            change m.hom (MvPolynomial.C r) =
              (MvPolynomial.eval₂Hom (hc_R.desc (s_D_of s)).hom _) (MvPolynomial.C r)
            rw [MvPolynomial.eval₂Hom_C]
            exact congrArg (fun f => f.hom r) hm_R
          · intro n
            change m.hom (MvPolynomial.X n) =
              (MvPolynomial.eval₂Hom (hc_R.desc (s_D_of s)).hom _) (MvPolynomial.X n)
            rw [MvPolynomial.eval₂Hom_X']
            have hXn : (MvPolynomial.X n : MvPolynomial (Fin d_rel) R_bar) =
                (c_poly.ι.app i_star).hom (MvPolynomial.X n) :=
              (MvPolynomial.map_X _ n).symm
            rw [hXn]
            exact congrArg (fun f => f.hom (MvPolynomial.X n)) (hm i_star) }

    let π_Sd : ∀ i : ℐ, AlgebraicGeometry.Spec (D_poly.obj i) ⟶ S_d.left :=
      fun i => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.map ((α.app i).hom.comp Polynomial.C)))

    have hπ_nat : ∀ {i i' : ℐ} (θ : i ⟶ i'),
        AlgebraicGeometry.Spec.map (D_poly.map θ) ≫ π_Sd i = π_Sd i' := by
      intro i i' θ
      dsimp [π_Sd, D_poly, S_d, weilAffineSpaceOver]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro p
      have hcomp_C : (D.map θ).hom.comp ((α.app i).hom.comp Polynomial.C) =
          (α.app i').hom.comp Polynomial.C := by
        rw [← RingHom.comp_assoc, ← CommRingCat.hom_comp, hα_nat θ]
      exact (MvPolynomial.map_map ((α.app i).hom.comp Polynomial.C) (D.map θ).hom p).trans
        (congrArg (fun h => MvPolynomial.map h p) hcomp_C)

    have hv_stage : ∀ (i : ℐ) (ψ : Polynomial k →+* ↑(D.obj i)),
        ψ.comp Polynomial.C = (α.app i).hom.comp Polynomial.C →
        ψ.Etale →
        ∃ (v_i : AlgebraicGeometry.Spec (D_poly.obj i) ⟶ Y_d),
          AlgebraicGeometry.Etale v_i ∧
          v_i ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 = π_Sd i ∧
          v_i ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
            AlgebraicGeometry.Spec.map (ι_D.app i) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) := by
      intro i ψ hψC hψEt
      have hcomm_vi : π_Sd i ≫ S_d.hom =
          (AlgebraicGeometry.Spec.map (ι_D.app i) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ≫ p_A1 := by
        dsimp [π_Sd, S_d, weilAffineSpaceOver, p_A1, ι_D]
        rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
          ← CommRingCat.ofHom_comp]
        congr 2
        apply RingHom.ext
        intro x_k
        change MvPolynomial.map ((α.app i).hom.comp Polynomial.C) (MvPolynomial.C x_k) =
          MvPolynomial.C ((ψ.comp Polynomial.C) x_k)
        rw [MvPolynomial.map_C, hψC]
      let v_i : AlgebraicGeometry.Spec (D_poly.obj i) ⟶ Y_d :=
        CategoryTheory.Limits.pullback.lift (π_Sd i)
          (AlgebraicGeometry.Spec.map (ι_D.app i) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) hcomm_vi
      have hv_fst : v_i ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 = π_Sd i :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hv_snd : v_i ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map (ι_D.app i) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hOuter_raw :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPushMvPoly (ψ.comp Polynomial.C))
      have hMap_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map (ψ.comp Polynomial.C))) =
            v_i ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 := by
        rw [hv_fst, hψC]
      have hBot_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp Polynomial.C)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1 := by
        dsimp [p_A1]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hOuter : CategoryTheory.IsPullback
          (v_i ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1)
          (AlgebraicGeometry.Spec.map (ι_D.app i))
          S_d.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1) := by
        rwa [hMap_eq, hBot_eq] at hOuter_raw
      have hRight : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst S_d.hom p_A1)
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
          S_d.hom p_A1 :=
        CategoryTheory.IsPullback.of_hasPullback S_d.hom p_A1
      have hLeft : CategoryTheory.IsPullback
          v_i (AlgebraicGeometry.Spec.map (ι_D.app i))
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        (hRight.paste_horiz_iff hv_snd).mp hOuter
      have hEt_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψEt
      have hEt_vi : AlgebraicGeometry.Etale v_i :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hLeft.flip hEt_ψ
      exact ⟨v_i, hEt_vi, hv_fst, hv_snd⟩

    have hPb_AR : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map (p_R.comp Polynomial.C))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : R_bar →+* MvPolynomial (Fin d_rel) R_bar)))
        S_d.hom g_k_R :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPushMvPoly (p_R.comp Polynomial.C))
    let e_AR : AlgebraicGeometry.Spec C_inf ≅ A_R := hPb_AR.isoPullback
    have he_AR_inv_snd :
        e_AR.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : R_bar →+* MvPolynomial (Fin d_rel) R_bar)) =
        CategoryTheory.Limits.pullback.snd S_d.hom g_k_R :=
      hPb_AR.isoPullback_inv_snd
    let E_inf : CommRingCat.{u} := AlgebraicGeometry.Scheme.Γ.obj (Opposite.op W)
    let e_W₀ : AlgebraicGeometry.Spec E_inf ≅ W := W.isoSpec.symm
    let u_W_AR : AlgebraicGeometry.Spec E_inf ⟶ AlgebraicGeometry.Spec C_inf :=
      e_W₀.hom ≫ w ≫ e_AR.inv
    have hEt_uW : AlgebraicGeometry.Etale u_W_AR := by
      dsimp [u_W_AR]
      infer_instance
    let f_E : c_poly.pt ⟶ E_inf := AlgebraicGeometry.Spec.preimage u_W_AR
    have hSpec_fE : AlgebraicGeometry.Spec.map f_E = u_W_AR :=
      AlgebraicGeometry.Spec.map_preimage u_W_AR
    have hf_E : f_E.hom.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rw [hSpec_fE]
      exact hEt_uW

    let E_inf_loc : CommRingCat.{u} :=
      CommRingCat.of (Localization.Away (f_E.hom t_poly))
    let ι_inf₀ : E_inf ⟶ E_inf_loc :=
      CommRingCat.ofHom (algebraMap (↑E_inf) (Localization.Away (f_E.hom t_poly)))
    have hLoc_inf : @IsLocalization.Away ↑E_inf _ (f_E.hom t_poly) ↑E_inf_loc _
        ι_inf₀.hom.toAlgebra :=
      hToAlgAway (↑E_inf) (f_E.hom t_poly)

    let ρ_R : CommRingCat.of R_bar ⟶ E_inf :=
      CommRingCat.ofHom (MvPolynomial.C : R_bar →+* MvPolynomial (Fin d_rel) R_bar) ≫ f_E
    have hSpec_ρR : AlgebraicGeometry.Spec.map ρ_R =
        e_W₀.hom ≫ w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R := by
      dsimp [ρ_R]
      rw [AlgebraicGeometry.Spec.map_comp, hSpec_fE]
      dsimp [u_W_AR]
      rw [Category.assoc, Category.assoc, he_AR_inv_snd]
    obtain ⟨ψ_inf_Ω, hPush_inf⟩ :=
      hPushLocAway (CommRingCat.ofHom φ_R_Ω) ρ_R ι_inf₀ t_bar hLoc_t hLoc_inf
    have hPb_loc_inf : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map ψ_inf_Ω)
        (AlgebraicGeometry.Spec.map ι_inf₀)
        j_R (AlgebraicGeometry.Spec.map ρ_R) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_inf
    have hPb_mid_W : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst j_A w ≫
          CategoryTheory.Limits.pullback.fst j_R
            (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        (CategoryTheory.Limits.pullback.snd j_A w)
        j_R
        (w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) :=
      (CategoryTheory.IsPullback.of_hasPullback j_A w).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback j_R
          (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
    have hPb_iso_left : CategoryTheory.IsPullback
        (𝟙 (CategoryTheory.Limits.pullback j_A w))
        (CategoryTheory.Limits.pullback.snd j_A w ≫ e_W₀.inv)
        (CategoryTheory.Limits.pullback.snd j_A w)
        e_W₀.hom :=
      CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [Category.id_comp, Category.assoc, e_W₀.inv_hom_id, Category.comp_id]⟩
    have hPb_W_raw := hPb_iso_left.paste_horiz hPb_mid_W
    have hPb_W : CategoryTheory.IsPullback
        (𝟙 (CategoryTheory.Limits.pullback j_A w) ≫
          CategoryTheory.Limits.pullback.fst j_A w ≫
            CategoryTheory.Limits.pullback.fst j_R
              (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        (CategoryTheory.Limits.pullback.snd j_A w ≫ e_W₀.inv)
        j_R (AlgebraicGeometry.Spec.map ρ_R) := by
      rwa [← hSpec_ρR] at hPb_W_raw
    let e_WU₀ : AlgebraicGeometry.Spec E_inf_loc ≅ CategoryTheory.Limits.pullback j_A w :=
      hPb_loc_inf.isoPullback ≪≫ hPb_W.isoPullback.symm
    have he_comm₀ : e_WU₀.hom ≫ CategoryTheory.Limits.pullback.snd j_A w =
        AlgebraicGeometry.Spec.map ι_inf₀ ≫ e_W₀.hom := by
      have h1 : e_WU₀.hom ≫ CategoryTheory.Limits.pullback.snd j_A w ≫ e_W₀.inv =
          AlgebraicGeometry.Spec.map ι_inf₀ := by
        dsimp [e_WU₀]
        rw [Category.assoc, hPb_W.isoPullback_inv_snd, hPb_loc_inf.isoPullback_hom_snd]
      calc
