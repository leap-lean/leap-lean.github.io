      have hy₀ : ((Ξ_const.inv.app M₀).hom.app (Opposite.op T_sh)) y₀ = y :=
        congrArg (fun ν : (C_W ⋙ pb_u).obj M₀ ⟶ (C_W ⋙ pb_u).obj M₀ =>
          (ν.hom.app (Opposite.op T_sh)) y) (Ξ_const.hom_inv_id_app M₀)
      have hΘxy : (Θ_sh.hom.app (Opposite.op T_sh)) x₀ =
          (Θ_sh.hom.app (Opposite.op T_sh)) y₀ := by
        change (β_star.hom.app (Opposite.op T_sh))
            (((pb_u.map Φ).hom.app (Opposite.op T_sh))
              (((Ξ_const.inv.app M₀).hom.app (Opposite.op T_sh)) x₀)) =
          (β_star.hom.app (Opposite.op T_sh))
            (((pb_u.map Φ).hom.app (Opposite.op T_sh))
              (((Ξ_const.inv.app M₀).hom.app (Opposite.op T_sh)) y₀))
        rw [hx₀, hy₀, hxy]
      have hx₀y₀ : x₀ = y₀ := hΘ_sh_bij.1 hΘxy
