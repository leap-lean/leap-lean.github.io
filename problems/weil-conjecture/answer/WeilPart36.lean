theorem weil_odp_pbc_eval_proper_canonical_mod_prime_pbc (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    (f : X ⟶ S) [AlgebraicGeometry.IsProper f.left] :
    WeilCanonicalModPrimePBC ℓ f.left :=
by
  obtain ⟨_, hComp, hCancel, hAffineLoc, hArrowIso⟩ :=
    weil_pbc_canonical_calculus_and_extraction.{u} ℓ
  obtain ⟨hIsoP0, hVieta⟩ := weil_vieta_binary_form_cover_projSpace k
  have hLFT_Proj : ∀ (N : ℕ),
      AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
    intro N
    dsimp [weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp
      exact ⟨c, Subtype.ext hc⟩
    have hFT_map : RingHom.FiniteType (algebraMap k ↥(𝒜 0)) :=
      RingHom.FiniteType.of_surjective _ hSurj0
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT_map
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
        _ _ _ _ _ _ (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    infer_instance
  have hProjSpace : ∀ (N : ℕ)
      (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType B.hom],
      WeilCanonicalModPrimePBC ℓ
        (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k N).hom) := by
    intro N
    induction N with
    | zero =>
      intro B _
      have : CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom := hIsoP0
      let p₀ := CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 0).hom
      have : CategoryTheory.IsIso p₀ := inferInstance
      have : AlgebraicGeometry.IsFinite p₀ := inferInstance
      exact weil_pbc_finite_morphism ℓ p₀
    | succ m ih =>
      intro B _
      let P_m := weilProjectiveSpaceOver k m
      let P_1 := weilProjectiveSpaceOver k 1
      let P_succ := weilProjectiveSpaceOver k (m + 1)
      let p_mB := CategoryTheory.Limits.pullback.fst B.hom P_m.hom
      have : AlgebraicGeometry.LocallyOfFiniteType P_m.hom := hLFT_Proj m
      have : AlgebraicGeometry.LocallyOfFiniteType p_mB := inferInstance
      let B_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (p_mB ≫ B.hom)
      have : AlgebraicGeometry.LocallyOfFiniteType B_m.hom :=
        (inferInstance : AlgebraicGeometry.LocallyOfFiniteType (p_mB ≫ B.hom))
      let p_1Bm := CategoryTheory.Limits.pullback.fst B_m.hom P_1.hom
      have hPBC_1Bm : WeilCanonicalModPrimePBC ℓ p_1Bm := by
        apply hAffineLoc
        intro U hU
        let B_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (U.ι ≫ B_m.hom)
        have : AlgebraicGeometry.IsAffine B_U.left := hU
        have : AlgebraicGeometry.LocallyOfFiniteType B_U.hom :=
          (inferInstance : AlgebraicGeometry.LocallyOfFiniteType (U.ι ≫ B_m.hom))
        have hBU : WeilCanonicalModPrimePBC ℓ
            (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom) :=
          weil_pbc_projLine_over_affine_finiteType k ℓ hℓ B_U
        let V_U : (CategoryTheory.Limits.pullback B_m.hom P_1.hom).Opens :=
          (TopologicalSpace.Opens.map p_1Bm.base).obj U
        have hpb_res : CategoryTheory.IsPullback (p_1Bm ∣_ U)
            (V_U.ι ≫ CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
            B_U.hom P_1.hom :=
          (AlgebraicGeometry.isPullback_morphismRestrict p_1Bm U).paste_vert
            (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom)
        exact hArrowIso (p_1Bm ∣_ U) (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom)
          hpb_res.isoPullback (CategoryTheory.Iso.refl B_U.left)
          (hpb_res.isoPullback_hom_fst.trans (CategoryTheory.Category.comp_id _).symm) hBU
      have hPBC_mB : WeilCanonicalModPrimePBC ℓ p_mB := ih B
      have hPBC_tower : WeilCanonicalModPrimePBC ℓ (p_1Bm ≫ p_mB) :=
        hComp p_1Bm p_mB hPBC_1Bm hPBC_mB
      obtain ⟨μ, hFin_μ, hSurj_μ, hw_μ⟩ := hVieta m
      have : AlgebraicGeometry.IsFinite μ := hFin_μ
      have : AlgebraicGeometry.Surjective μ := hSurj_μ
      let P_m1_hom := CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom ≫ P_m.hom
      have hμ_cond : CategoryTheory.Limits.pullback.fst B.hom P_m1_hom ≫ B.hom =
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ) ≫ P_succ.hom := by
        rw [CategoryTheory.Category.assoc, hw_μ]
        exact CategoryTheory.Limits.pullback.condition
      let μ_B : CategoryTheory.Limits.pullback B.hom P_m1_hom ⟶
          CategoryTheory.Limits.pullback B.hom P_succ.hom :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ)
          hμ_cond
      have hμB_fst : μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.fst B.hom P_m1_hom :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hμB_snd : μ_B ≫ CategoryTheory.Limits.pullback.snd B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_outer_μ : CategoryTheory.IsPullback
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
          B.hom (μ ≫ P_succ.hom) := by
        rw [hμB_fst, hw_μ]
        exact CategoryTheory.IsPullback.of_hasPullback B.hom P_m1_hom
      have hpb_μB : CategoryTheory.IsPullback μ_B
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_succ.hom) μ :=
        CategoryTheory.IsPullback.of_right hpb_outer_μ hμB_snd
          (CategoryTheory.IsPullback.of_hasPullback B.hom P_succ.hom)
      have : AlgebraicGeometry.IsFinite μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpb_μB.flip inferInstance
      have hSurj_μB : AlgebraicGeometry.Surjective μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hpb_μB.flip inferInstance
      have hPBC_μB : WeilCanonicalModPrimePBC ℓ μ_B := weil_pbc_finite_morphism ℓ μ_B
      have hα_cond : (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom) ≫ P_m.hom =
          CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom ≫ P_1.hom := by
        rw [CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom)]
        exact CategoryTheory.Limits.pullback.condition (f := B_m.hom) (g := P_1.hom)
      let α : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
          CategoryTheory.Limits.pullback P_m.hom P_1.hom :=
        CategoryTheory.Limits.pullback.lift
          (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
          hα_cond
      have hα_fst : α ≫ CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom =
          p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hα_snd : α ≫ CategoryTheory.Limits.pullback.snd P_m.hom P_1.hom =
          CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_outer_α : CategoryTheory.IsPullback p_1Bm
          (α ≫ CategoryTheory.Limits.pullback.snd P_m.hom P_1.hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_m.hom ≫ P_m.hom) P_1.hom := by
        rw [hα_snd,
          ← CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom)]
        exact CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom
      have hpb_left : CategoryTheory.IsPullback p_1Bm α
          (CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom) :=
        CategoryTheory.IsPullback.of_bot hpb_outer_α hα_fst.symm
          (CategoryTheory.IsPullback.of_hasPullback P_m.hom P_1.hom)
      have hpb_assoc : CategoryTheory.IsPullback (p_1Bm ≫ p_mB) α B.hom P_m1_hom :=
        hpb_left.paste_horiz (CategoryTheory.IsPullback.of_hasPullback B.hom P_m.hom)
      have he_assoc : hpb_assoc.isoPullback.symm.hom ≫ (p_1Bm ≫ p_mB) =
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom) ≫
            (CategoryTheory.Iso.refl B.left).hom := by
        change hpb_assoc.isoPullback.inv ≫ (p_1Bm ≫ p_mB) = _
        rw [hpb_assoc.isoPullback_inv_fst, CategoryTheory.Iso.refl_hom,
          CategoryTheory.Category.comp_id, hμB_fst]
      have hPBC_comp_μB : WeilCanonicalModPrimePBC ℓ
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom) :=
        hArrowIso (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
          (p_1Bm ≫ p_mB) hpb_assoc.isoPullback.symm (CategoryTheory.Iso.refl B.left)
          he_assoc hPBC_tower
      exact hCancel μ_B (CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
        hSurj_μB hPBC_μB hPBC_comp_μB
  apply hAffineLoc
  intro U hU
  let S_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (U.ι ≫ S.hom)
  let V_fU : X.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj U
  let X_U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (V_fU.ι ≫ X.hom)
  have hf_U_w : (f.left ∣_ U) ≫ S_U.hom = X_U.hom := by
    change (f.left ∣_ U) ≫ (U.ι ≫ S.hom) = V_fU.ι ≫ X.hom
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
      CategoryTheory.Category.assoc, CategoryTheory.Over.w f]
  let f_U : X_U ⟶ S_U := CategoryTheory.Over.homMk (f.left ∣_ U) hf_U_w
  have : AlgebraicGeometry.IsAffine S_U.left := hU
  have : AlgebraicGeometry.LocallyOfFiniteType S_U.hom :=
    (inferInstance : AlgebraicGeometry.LocallyOfFiniteType (U.ι ≫ S.hom))
  have : AlgebraicGeometry.IsProper f_U.left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (AlgebraicGeometry.isPullback_morphismRestrict f.left U).flip inferInstance
  have : AlgebraicGeometry.LocallyOfFiniteType f_U.left := inferInstance
  have : AlgebraicGeometry.LocallyOfFiniteType X_U.hom := by
    rw [← CategoryTheory.Over.w f_U]
    infer_instance
  obtain ⟨N, X_tilde, ι_X, ι_S, hFin_X, hFin_S, hSurj_π, hComm⟩ :=
    weil_relative_chow_projective_factorization k X_U S_U f_U
  have : AlgebraicGeometry.IsFinite ι_X := hFin_X
  have : AlgebraicGeometry.IsFinite ι_S := hFin_S
  let p_NX := CategoryTheory.Limits.pullback.fst X_U.hom (weilProjectiveSpaceOver k N).hom
  let p_NS := CategoryTheory.Limits.pullback.fst S_U.hom (weilProjectiveSpaceOver k N).hom
  let π := ι_X ≫ p_NX
  have hPBC_π : WeilCanonicalModPrimePBC ℓ π :=
    hComp ι_X p_NX (weil_pbc_finite_morphism ℓ ι_X) (hProjSpace N X_U)
  have hPBC_rhs : WeilCanonicalModPrimePBC ℓ (ι_S ≫ p_NS) :=
    hComp ι_S p_NS (weil_pbc_finite_morphism ℓ ι_S) (hProjSpace N S_U)
  have hPBC_πf : WeilCanonicalModPrimePBC ℓ (π ≫ f_U.left) := by
    rwa [hComm]
  exact hCancel π f_U.left hSurj_π hPBC_π hPBC_πf

theorem weil_odp_bc_higherDirectImage_mono_and_long_exact {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
    (SC : CategoryTheory.ShortComplex
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
    (hSE : SC.ShortExact) :
    CategoryTheory.Mono (weilEtaleHigherDirectImageMap f 0 SC.f) ∧
    ∀ (q : ℕ),
      ∃ (h0₁ : CategoryTheory.CategoryStruct.comp
            (weilEtaleHigherDirectImageMap f q SC.f)
            (weilEtaleHigherDirectImageMap f q SC.g) = 0)
        (h0₂ : CategoryTheory.CategoryStruct.comp
            (weilEtaleHigherDirectImageMap f q SC.g)
            (weilSingDevAlgBCConnHom f SC hSE q) = 0)
        (h0₃ : CategoryTheory.CategoryStruct.comp
            (weilSingDevAlgBCConnHom f SC hSE q)
            (weilEtaleHigherDirectImageMap f (q + 1) SC.f) = 0),
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f q SC.f)
          (weilEtaleHigherDirectImageMap f q SC.g) h0₁).Exact ∧
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f q SC.g)
          (weilSingDevAlgBCConnHom f SC hSE q) h0₂).Exact ∧
        (CategoryTheory.ShortComplex.mk
          (weilSingDevAlgBCConnHom f SC hSE q)
          (weilEtaleHigherDirectImageMap f (q + 1) SC.f) h0₃).Exact :=
by
  have hPresheafExact :
      ∀ {P₁ P₂ P₃ : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}}
        (α : P₁ ⟶ P₂) (β : P₂ ⟶ P₃) (h0 : α ≫ β = 0),
        (∀ (W : Opposite X.Etale) (z : P₂.obj W), β.app W z = 0 → ∃ y : P₁.obj W, α.app W y = z) →
        (CategoryTheory.ShortComplex.mk α β h0).Exact := by
    intro P₁ P₂ P₃ α β h0 hpt
    rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
    refine CategoryTheory.NatTrans.ext (funext fun W => AddCommGrpCat.ext fun x => ?_)
    have hgx : (β.app W) (((CategoryTheory.Limits.kernel.ι β).app W) x) = 0 := by
      change ((CategoryTheory.Limits.kernel.ι β ≫ β).app W) x = 0
      rw [CategoryTheory.Limits.kernel.condition]
      rfl
    obtain ⟨y, hy⟩ := hpt W (((CategoryTheory.Limits.kernel.ι β).app W) x) hgx
    change ((CategoryTheory.Limits.cokernel.π α).app W)
      (((CategoryTheory.Limits.kernel.ι β).app W) x) = 0
    rw [← hy]
    change ((α ≫ CategoryTheory.Limits.cokernel.π α).app W) y = 0
    rw [CategoryTheory.Limits.cokernel.condition]
    rfl
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Z_fun : CategoryTheory.Functor X.Etale
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda ⋙
      (Free_PSh ⋙ CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u})
  let Z_obj (W : Opposite X.Etale) :
      CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    Opposite.unop (Z_fun.op.obj W)
  let map_pre (n : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : F₁ ⟶ F₂) :
      Quiver.Hom (CategoryTheory.Sheaf.cohomologyPresheaf F₁ n)
        (CategoryTheory.Sheaf.cohomologyPresheaf F₂ n) :=
    (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology n).map φ
  have hApp :
      ∀ (n : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : F₁ ⟶ F₂) (W : Opposite X.Etale),
        (map_pre n φ).app W =
          AddCommGrpCat.ofHom ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
            (Z_obj W) (Nat.add_zero n)) :=
    fun n _ _ φ W =>
      CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) n φ
  let wh := (CategoryTheory.Functor.whiskeringLeft
    (Opposite S.Etale) (Opposite X.Etale) AddCommGrpCat.{u}).obj (weilEtaleSitePullback f).op
  let δ_Z (q : ℕ) : Quiver.Hom (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ q)
      (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1)) :=
    { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
      naturality := fun {W₁ W₂} ω => by
        have hL : (SC.X₃.cohomologyPresheaf q).map ω =
            ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
        have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
            ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
        rw [hL, hR,
          CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
          CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
        ext α
        exact CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
          (Nat.zero_add q) rfl (Nat.zero_add (q + 1)) }
  have hZeroOfExact :
      ∀ {S₀ : CategoryTheory.ShortComplex AddCommGrpCat.{u}}, S₀.Exact → S₀.f ≫ S₀.g = 0 :=
    fun {_} hex =>
      have _ := hex
      CategoryTheory.ShortComplex.zero _
  have hMain :
      ∀ {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
        [CategoryTheory.Abelian 𝒟]
        (L : CategoryTheory.Functor
          (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) 𝒟)
        [L.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits L]
        [CategoryTheory.Limits.PreservesFiniteColimits L],
        CategoryTheory.Mono
          (L.map (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op
            (map_pre 0 SC.f))) ∧
        ∀ (q : ℕ),
          let m_f := L.map (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op
            (map_pre q SC.f))
          let m_g := L.map (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op
            (map_pre q SC.g))
          let m_δ := L.map (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op
            (δ_Z q))
          let m_f1 := L.map (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op
            (map_pre (q + 1) SC.f))
          ∃ (h0₁ : CategoryTheory.CategoryStruct.comp m_f m_g = 0)
            (h0₂ : CategoryTheory.CategoryStruct.comp m_g m_δ = 0)
            (h0₃ : CategoryTheory.CategoryStruct.comp m_δ m_f1 = 0),
            (CategoryTheory.ShortComplex.mk m_f m_g h0₁).Exact ∧
            (CategoryTheory.ShortComplex.mk m_g m_δ h0₂).Exact ∧
            (CategoryTheory.ShortComplex.mk m_δ m_f1 h0₃).Exact := by
    intro 𝒟 _ _ L _ _ _
    refine ⟨?_, fun q => ?_⟩
    · have : CategoryTheory.Mono SC.f := hSE.mono_f
      have : CategoryTheory.Mono (map_pre 0 SC.f) := by
        refine @CategoryTheory.NatTrans.mono_of_mono_app _ _ _ _ _ _ (map_pre 0 SC.f) (fun W => ?_)
        rw [hApp 0 SC.f W]
        exact CategoryTheory.Abelian.Ext.mono_postcomp_mk₀_of_mono (Z_obj W) SC.f
      have : CategoryTheory.Mono (wh.map (map_pre 0 SC.f)) :=
        CategoryTheory.Functor.map_mono wh (map_pre 0 SC.f)
      exact CategoryTheory.Functor.map_mono L (wh.map (map_pre 0 SC.f))
    · have h1_pre : map_pre q SC.f ≫ map_pre q SC.g = 0 := by
        refine CategoryTheory.NatTrans.ext (funext fun W => ?_)
        change (map_pre q SC.f).app W ≫ (map_pre q SC.g).app W = 0
        rw [hApp q SC.f W, hApp q SC.g W]
        exact hZeroOfExact (CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
          (Z_obj W) hSE q)
      have h2_pre : map_pre q SC.g ≫ δ_Z q = 0 := by
        refine CategoryTheory.NatTrans.ext (funext fun W => ?_)
        change (map_pre q SC.g).app W ≫ (δ_Z q).app W = 0
        rw [hApp q SC.g W]
        exact hZeroOfExact (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
          (Z_obj W) hSE q (q + 1) rfl)
      have h3_pre : δ_Z q ≫ map_pre (q + 1) SC.f = 0 := by
        refine CategoryTheory.NatTrans.ext (funext fun W => ?_)
        change (δ_Z q).app W ≫ (map_pre (q + 1) SC.f).app W = 0
        rw [hApp (q + 1) SC.f W]
        exact hZeroOfExact (CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
          (Z_obj W) hSE q (q + 1) rfl)
      let S1_pre := CategoryTheory.ShortComplex.mk (map_pre q SC.f) (map_pre q SC.g) h1_pre
      let S2_pre := CategoryTheory.ShortComplex.mk (map_pre q SC.g) (δ_Z q) h2_pre
      let S3_pre := CategoryTheory.ShortComplex.mk (δ_Z q) (map_pre (q + 1) SC.f) h3_pre
      have hex1_pre : S1_pre.Exact := by
        refine hPresheafExact (map_pre q SC.f) (map_pre q SC.g) h1_pre (fun W z hz => ?_)
        change ((map_pre q SC.g).app W) z = 0 at hz
        rw [hApp q SC.g W] at hz
        obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂
          (Z_obj W) hSE z hz
        refine ⟨y, ?_⟩
        rw [hApp q SC.f W]
        exact hy
      have hex2_pre : S2_pre.Exact := by
        refine hPresheafExact (map_pre q SC.g) (δ_Z q) h2_pre (fun W z hz => ?_)
        obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
          (Z_obj W) hSE z rfl hz
        refine ⟨y, ?_⟩
        rw [hApp q SC.g W]
        exact hy
      have hex3_pre : S3_pre.Exact := by
        refine hPresheafExact (δ_Z q) (map_pre (q + 1) SC.f) h3_pre (fun W z hz => ?_)
        change ((map_pre (q + 1) SC.f).app W) z = 0 at hz
        rw [hApp (q + 1) SC.f W] at hz
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          (Z_obj W) hSE z hz rfl
      exact ⟨((S1_pre.map wh).map L).zero,
        ((S2_pre.map wh).map L).zero,
        ((S3_pre.map wh).map L).zero,
        (hex1_pre.map wh).map L,
        (hex2_pre.map wh).map L,
        (hex3_pre.map wh).map L⟩
  have hMapEq :
      ∀ (n : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : F₁ ⟶ F₂),
        weilEtaleHigherDirectImageMap f n φ =
          (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
            (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op (map_pre n φ)) :=
    fun _ _ _ _ => rfl
  have hConnEq :
      ∀ (q : ℕ),
        weilSingDevAlgBCConnHom f SC hSE q =
          (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
            (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f).op (δ_Z q)) := by
    intro q
    unfold weilSingDevAlgBCConnHom
    congr 2
  have : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).Additive :=
    CategoryTheory.Adjunction.left_adjoint_additive
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u})
  obtain ⟨hMono, hEx⟩ := hMain (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u})
  refine ⟨?_, fun q => ?_⟩
  · rw [hMapEq 0 SC.f]
    exact hMono
  · rw [hMapEq q SC.f, hMapEq q SC.g, hConnEq q, hMapEq (q + 1) SC.f]
    exact hEx q

theorem weil_odp_bc_push_exists_unique_and_nat (sys : WeilEtaleSitePullbackSys.{u})
    {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : X ⟶ S) (g : S' ⟶ S) (f' : X' ⟶ S') (g' : X' ⟶ X)
