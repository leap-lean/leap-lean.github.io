        rw [ZMod.natCast_eq_zero_iff] at hx_cast
        rcases hx_cast with ⟨c, hc⟩
        have hc_lt : c < ℓ := by
          have hlt : c * ℓ ^ (r' + 1) < ℓ * ℓ ^ (r' + 1) := by
            rw [mul_comm c, ← hc, ← hpow_succ]
            exact ZMod.val_lt x
          exact Nat.lt_of_mul_lt_mul_right hlt
        refine ⟨(c : ZMod ℓ), ?_⟩
        change (((c : ZMod ℓ).val * ℓ ^ (r' + 1) : ℕ) : ZMod (ℓ ^ (r' + 2))) = x
        rw [ZMod.val_natCast_of_lt hc_lt, mul_comm c, ← hc, ZMod.natCast_zmod_val]
      let U := AddCommGrpCat.uliftFunctor.{u, 0}
      let f_u := U.map (AddCommGrpCat.ofHom μ)
      let g_u := U.map (AddCommGrpCat.ofHom π)
      have hfg_u : f_u ≫ g_u = 0 := by
        apply AddCommGrpCat.ext
        intro z
        change ULift.up (π (μ z.down)) = 0
        rw [hcomp_zero]
        rfl
      let SC_u := CategoryTheory.ShortComplex.mk f_u g_u hfg_u
      have hMono_u : CategoryTheory.Mono SC_u.f := by
        rw [AddCommGrpCat.mono_iff_injective]
        intro z₁ z₂ hz
        have hdown : μ z₁.down = μ z₂.down := congrArg ULift.down hz
        exact ULift.ext _ _ (hμ_inj hdown)
      have hEpi_u : CategoryTheory.Epi SC_u.g := by
        rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hπ_surj y.down
        exact ⟨ULift.up x, ULift.ext _ _ hx⟩
      have hEx_u : SC_u.Exact := by
        rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
        intro x hx
        have hπ0 : π x.down = 0 := congrArg ULift.down hx
        obtain ⟨a, ha⟩ := hexact_mid x.down hπ0
        exact ⟨ULift.up a, ULift.ext _ _ ha⟩
      have hSE_u : SC_u.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hEx_u hMono_u hEpi_u
      let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
      have : C_X.Additive := by
        dsimp [C_X]; unfold CategoryTheory.constantSheaf; infer_instance
      have : CategoryTheory.Limits.PreservesFiniteLimits C_X := by
        dsimp [C_X]; unfold CategoryTheory.constantSheaf; infer_instance
      have : CategoryTheory.Limits.PreservesFiniteColimits C_X := by
        dsimp [C_X]; unfold CategoryTheory.constantSheaf; infer_instance
      let SC := SC_u.map C_X
      have hSE : SC.ShortExact := hSE_u.map_of_exact C_X
      let hSE' : (SC.map pb_g').ShortExact := hSE.map_of_exact pb_g'
      obtain ⟨hMono_f0, hMono_f'0, hDeg⟩ := hLES SC hSE
      intro q_deg
      cases q_deg with
      | zero =>
        obtain ⟨Z₀, _⟩ := (CategoryTheory.Limits.HasZeroObject.zero :
          ∃ Z₀ : CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u},
            CategoryTheory.Limits.IsZero Z₀)
        obtain ⟨hComm0, ⟨⟨h0₁, hEx₁⟩, ⟨h0₂, hEx₂⟩, _⟩, ⟨⟨h0₁', hEx₁'⟩, ⟨h0₂', hEx₂'⟩, _⟩⟩ := hDeg 0
        let t₀ : Z₀ ⟶ pb_g.obj (weilEtaleHigherDirectImage f 0 SC.X₁) := 0
        let t₁ := pb_g.map (weilEtaleHigherDirectImageMap f 0 SC.f)
        let t₂ := pb_g.map (weilEtaleHigherDirectImageMap f 0 SC.g)
        let t₃ := pb_g.map (conn_top 0 hSE)
        let b₀ : Z₀ ⟶ weilEtaleHigherDirectImage f' 0 (pb_g'.obj SC.X₁) := 0
        let b₁ := weilEtaleHigherDirectImageMap f' 0 (SC.map pb_g').f
        let b₂ := weilEtaleHigherDirectImageMap f' 0 (SC.map pb_g').g
        let b₃ := conn_bot 0 hSE'
        let wt₀₁ : t₀ ≫ t₁ = 0 := CategoryTheory.Limits.zero_comp
        have ht₀₁ : (CategoryTheory.ShortComplex.mk t₀ t₁ wt₀₁).Exact :=
          (CategoryTheory.ShortComplex.exact_iff_mono
            (CategoryTheory.ShortComplex.mk t₀ t₁ wt₀₁) rfl).mpr inferInstance
        let wt₁₂ : t₁ ≫ t₂ = 0 :=
          ((CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f 0 SC.f)
            (weilEtaleHigherDirectImageMap f 0 SC.g) h0₁).map pb_g).zero
        have ht₁₂ : (CategoryTheory.ShortComplex.mk t₁ t₂ wt₁₂).Exact := hEx₁.map pb_g
        let wt₂₃ : t₂ ≫ t₃ = 0 :=
          ((CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f 0 SC.g)
            (conn_top 0 hSE) h0₂).map pb_g).zero
        have ht₂₃ : (CategoryTheory.ShortComplex.mk t₂ t₃ wt₂₃).Exact := hEx₂.map pb_g
        let wb₀₁ : b₀ ≫ b₁ = 0 := CategoryTheory.Limits.zero_comp
        have hb₀₁ : (CategoryTheory.ShortComplex.mk b₀ b₁ wb₀₁).Exact :=
          (CategoryTheory.ShortComplex.exact_iff_mono
            (CategoryTheory.ShortComplex.mk b₀ b₁ wb₀₁) rfl).mpr hMono_f'0
        have sq₀ : t₀ ≫ bc 0 SC.X₁ = 𝟙 Z₀ ≫ b₀ := by
          dsimp [t₀, b₀]
          rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.id_comp]
        have : CategoryTheory.IsIso (bc 1 SC.X₁) := hModPrime 1
        exact hFive t₀ t₁ t₂ t₃ b₀ b₁ b₂ b₃
          wt₀₁ ht₀₁ wt₁₂ ht₁₂ wt₂₃ ht₂₃
          wb₀₁ hb₀₁ h0₁' hEx₁' h0₂' hEx₂'
          (𝟙 Z₀) (bc 0 SC.X₁) (bc 0 SC.X₂) (bc 0 SC.X₃) (bc 1 SC.X₁)
          sq₀ (hNat 0 SC.f) (hNat 0 SC.g) hComm0
          inferInstance (hModPrime 0) (ih 0) inferInstance
      | succ p =>
        obtain ⟨hComm_p, ⟨_, _, ⟨h0₃_p, hEx₃_p⟩⟩, ⟨_, _, ⟨h0₃'_p, hEx₃'_p⟩⟩⟩ := hDeg p
        obtain ⟨hComm_s, ⟨⟨h0₁_s, hEx₁_s⟩, ⟨h0₂_s, hEx₂_s⟩, _⟩,
          ⟨⟨h0₁'_s, hEx₁'_s⟩, ⟨h0₂'_s, hEx₂'_s⟩, _⟩⟩ := hDeg (p + 1)
        let t₀ := pb_g.map (conn_top p hSE)
        let t₁ := pb_g.map (weilEtaleHigherDirectImageMap f (p + 1) SC.f)
        let t₂ := pb_g.map (weilEtaleHigherDirectImageMap f (p + 1) SC.g)
        let t₃ := pb_g.map (conn_top (p + 1) hSE)
        let b₀ := conn_bot p hSE'
        let b₁ := weilEtaleHigherDirectImageMap f' (p + 1) (SC.map pb_g').f
        let b₂ := weilEtaleHigherDirectImageMap f' (p + 1) (SC.map pb_g').g
        let b₃ := conn_bot (p + 1) hSE'
        let wt₀₁ : t₀ ≫ t₁ = 0 :=
          ((CategoryTheory.ShortComplex.mk
            (conn_top p hSE)
            (weilEtaleHigherDirectImageMap f (p + 1) SC.f) h0₃_p).map pb_g).zero
        have ht₀₁ : (CategoryTheory.ShortComplex.mk t₀ t₁ wt₀₁).Exact := hEx₃_p.map pb_g
        let wt₁₂ : t₁ ≫ t₂ = 0 :=
          ((CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f (p + 1) SC.f)
