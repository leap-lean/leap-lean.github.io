          p.appLE (U_B_chart γ) (V_et_chart γ) (e_p γ) :=
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ιH f₁.left
          (U_B_chart γ) (V_chart γ) (V_et_chart γ) (e_chart γ) (hVet_le_VH γ)
      rw [← h_comp, AlgebraicGeometry.Scheme.Hom.appLE]
      rfl
    rw [← hp_appLE] at hSm0
