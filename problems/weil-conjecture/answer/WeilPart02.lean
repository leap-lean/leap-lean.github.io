      have hInj_fA₀C : Function.Injective f_A₀C_alg := by
        have heq : f_A₀C_alg.toLinearMap =
            LinearMap.lTensor K (IsScalarTower.toAlgHom k (MvPolynomial (Fin m) k) C).toLinearMap := by
          ext κ p
          rfl
        change Function.Injective f_A₀C_alg.toLinearMap
        rw [heq]
        exact Module.Flat.lTensor_preserves_injective_linearMap
