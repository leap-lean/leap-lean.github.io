    have hdiff_max : (⟨w, hw⟩ : ↥O_rel) - j u_O ∈ IsLocalRing.maximalIdeal ↥O_rel := by
      have hmap : μ_g.toRingHom (z_w - algebraMap ↥Ox₀ B_g u_O) = μ_g.toRingHom (ϖ_g * q_w) :=
        congrArg μ_g.toRingHom hq_w
      rw [μ_g.toRingHom.map_sub, μ_g.toRingHom.map_mul] at hmap
      change μ_g z_w - μ_g (algebraMap ↥Ox₀ B_g u_O) = μ_g ϖ_g * μ_g q_w at hmap
      rw [hz_w, μ_g.commutes u_O, μ_g.commutes ϖ₀] at hmap
      change (⟨w, hw⟩ : ↥O_rel) - j u_O = j ϖ₀ * μ_g q_w at hmap
      rw [hmap]
      exact (IsLocalRing.maximalIdeal ↥O_rel).mul_mem_right _
        ((hj_max ϖ₀).mp hϖ₀_mem_max)
    refine ⟨u_O.1, u_O.2, ?_⟩
    by_cases hdiff0 : w - (u_O.1 : F) = 0
    · exact Or.inl hdiff0
    · right
      intro hinv_mem
      let d_O : ↥O_rel := ⟨w, hw⟩ - j u_O
      let v_O : ↥O_rel := ⟨(w - (u_O.1 : F))⁻¹, hinv_mem⟩
      have hdv : d_O * v_O = 1 := Subtype.ext (mul_inv_cancel₀ hdiff0)
      have hd_unit : IsUnit d_O := ⟨⟨d_O, v_O, hdv, mul_comm d_O v_O ▸ hdv⟩, rfl⟩
      exact (IsLocalRing.notMem_maximalIdeal.mpr hd_unit) hdiff_max
  obtain ⟨R_top, instCR_top, instDom_top, instAlgKR_top, instAlgRF_top, instTow_top,
    instFrac_top, ψ_top, hEt_top, _⟩ :=
    h_chart K C_K p_K hIntCK hPropCK hSmCK F η_F hηF_comm hFuncF
      (⊤ : ValuationSubring F) (fun _ => ValuationSubring.mem_top _)
  obtain ⟨hTr_kF, hTr_sep, hFin_sep, hSep_sep⟩ :=
    @h_sep k K R_top F _ _ _ instCR_top instDom_top instAlgKR_top _ _ _ instAlgRF_top
      _ instTow_top instFrac_top m hTrK ψ_top hEt_top
  refine ⟨hTr_kF, ⟨@algebraMap R_top F _ _ instAlgRF_top (ψ_top Polynomial.X),
    hTr_sep, hFin_sep, hSep_sep⟩, ?_⟩
  intro O_rel hO_ne_top hKO
  obtain ⟨R, instCR, instDom, instAlgKR, instAlgRF, instTow, instFrac, ψ, hEt, hRO⟩ :=
    h_chart K C_K p_K hIntCK hPropCK hSmCK F η_F hηF_comm hFuncF O_rel hKO
  obtain ⟨_, hTr_x₀, hFin_x₀, _⟩ :=
    @h_sep k K R F _ _ _ instCR instDom instAlgKR _ _ _ instAlgRF
      _ instTow instFrac m hTrK ψ hEt
  obtain ⟨hEt_Ox₀, hRes_Ox₀⟩ :=
    @h_val K R F _ _ instCR instDom instAlgKR _ _ instAlgRF instTow instFrac
      ψ hEt O_rel hO_ne_top hRO hTr_x₀ hFin_x₀
  exact ⟨@algebraMap R F _ _ instAlgRF (ψ Polynomial.X), hTr_x₀, hEt_Ox₀, hRes_Ox₀⟩

