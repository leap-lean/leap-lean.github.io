        rw [h_ik, Localization.mk_mul, one_mul, h_mon]
        congr 1
        apply Subtype.ext
        change MvPolynomial.X μ ^ (∑ γ : Fin (M₀ + 1), d γ) = MvPolynomial.X μ ^ r
        rw [h_deg]
      rw [Finset.sum_congr rfl h_term, h_mk_sum, ← MvPolynomial.as_sum G,
