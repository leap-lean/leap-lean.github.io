          · change u ∈ _; rw [hu0]; exact Subalgebra.zero_mem _
          · change u ∈ _; rw [sub_eq_zero.mp hu1]; exact Subalgebra.one_mem _
        refine mul_mem hidem_mem ?_
        have _ : Algebra.IsAlgebraic K₀ (E_fld ℓ i) := Algebra.IsAlgebraic.of_finite K₀ (E_fld ℓ i)
        have h_adj_top : Algebra.adjoin K₀ {α_prim ℓ i} = ⊤ := by
          rw [← IntermediateField.adjoin_toSubalgebra, hα_prim ℓ i]
