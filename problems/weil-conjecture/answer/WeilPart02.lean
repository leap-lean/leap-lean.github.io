        exact hq_basic
      have hz_in_Fc : ι₁.left.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 F_c := by
        rw [← hq_z]
        exact h_in_Fc
      exact hz_not hz_in_Fc

theorem weil_algClosed_minimal_prime_field_descent_of_curve_chart (k : Type u) [Field k] (m M₀ d₀ : ℕ)
    (μ ν : Fin (M₀ + 1))
    (R : Type u) [CommRing R] [IsDomain R] [Algebra k R]
    (hTrdegR : Algebra.trdeg k R ≤ (m : Cardinal.{u}))
    (S : Type u) [CommRing S] [Algebra R S]
    (x : Fin (M₀ + 1) → S)
    (hx_mu : x μ = 1)
    (hx_surj : Function.Surjective (MvPolynomial.aeval x : MvPolynomial (Fin (M₀ + 1)) R →ₐ[R] S))
    (hMin_Ω : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ_Ω : R →+* Ω),
      letI : Algebra R Ω := φ_Ω.toAlgebra
      ∀ (Q₁ Q₂ : PrimeSpectrum (TensorProduct R S Ω)), Q₁ < Q₂ → IsMin Q₁)
    (P : PrimeSpectrum (MvPolynomial (weilDegMonomialIdx M₀ d₀) R))
    (Q : PrimeSpectrum (MvPolynomial (weilDegMonomialIdx M₀ d₀) S))
    (hP_bot : ∀ G : MvPolynomial (weilDegMonomialIdx M₀ d₀) k,
      MvPolynomial.map (algebraMap k R) G ∈ P.asIdeal → G = 0)
    (hF_mem : (∑ e : weilDegMonomialIdx M₀ d₀,
      MvPolynomial.C (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * MvPolynomial.X e) ∈ Q.asIdeal)
    (hTrans_Q : ∀ g : Polynomial (MvPolynomial (weilDegMonomialIdx M₀ d₀) R),
      Polynomial.eval₂ (MvPolynomial.map (algebraMap R S)) (MvPolynomial.C (x ν)) g ∈ Q.asIdeal ↔
        ∀ j : ℕ, g.coeff j ∈ P.asIdeal) :
    ∃ (F : Type u) (_ : Field F) (_ : IsAlgClosed F) (_ : Algebra k F)
      (Ω : Type u) (_ : Field Ω) (_ : Algebra k Ω) (_ : Algebra F Ω) (_ : IsScalarTower k F Ω)
      (C : weilDegMonomialIdx M₀ d₀ → Ω)
      (A₀ : Type u) (_ : CommRing A₀) (_ : IsDomain A₀) (_ : Algebra F A₀)
      (_ : Algebra.FiniteType F A₀)
      (y : Fin (M₀ + 1) → A₀),
      Algebra.trdeg k F ≤ (m : Cardinal.{u}) ∧
      Function.Injective (MvPolynomial.aeval C : MvPolynomial (weilDegMonomialIdx M₀ d₀) k →ₐ[k] Ω) ∧
      y μ = 1 ∧
      ¬ IsAlgebraic F (y ν) ∧
      (∑ e : weilDegMonomialIdx M₀ d₀,
        TensorProduct.tmul F (∏ α : Fin (M₀ + 1), (y α) ^ (e.1 α : ℕ)) (C e) :
          TensorProduct F A₀ Ω) = 0 :=
by
  
  have hNullPoint : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (E : Type u) [CommRing E] [Nontrivial E] [Algebra K E] [Algebra.FiniteType K E],
      Nonempty (E →ₐ[K] K) := by
    intro K _ _ E _ _ _ _
    obtain ⟨n, Φ, hΦ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := K) (S := E)).mp inferInstance
    obtain ⟨𝔪, _⟩ := Ideal.exists_maximal E
    have : (Ideal.comap Φ.toRingHom 𝔪).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective Φ.toRingHom hΦ_surj
    obtain ⟨c, hc⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := K)
        (I := Ideal.comap Φ.toRingHom 𝔪)).mp inferInstance
    have hker : ∀ p : MvPolynomial (Fin n) K, Φ p = 0 → MvPolynomial.aeval c p = 0 := by
      intro p hp0
      have hmem : p ∈ Ideal.comap Φ.toRingHom 𝔪 := by
        change Φ p ∈ 𝔪
        rw [hp0]
        exact Ideal.zero_mem 𝔪
      rw [hc, MvPolynomial.mem_vanishingIdeal_iff] at hmem
      exact hmem c (Set.mem_singleton c)
    let fn : E → K := fun e => MvPolynomial.aeval c (Classical.choose (hΦ_surj e))
    have hfn : ∀ p : MvPolynomial (Fin n) K, fn (Φ p) = MvPolynomial.aeval c p := by
      intro p
      dsimp [fn]
      have hsub : Φ (Classical.choose (hΦ_surj (Φ p)) - p) = 0 := by
        rw [map_sub, Classical.choose_spec (hΦ_surj (Φ p)), sub_self]
      exact sub_eq_zero.mp (by rw [← map_sub]; exact hker _ hsub)
    refine ⟨{
      toFun := fn
      map_one' := by rw [← Φ.map_one, hfn, map_one]
      map_mul' := fun a b => by
        obtain ⟨pa, rfl⟩ := hΦ_surj a
        obtain ⟨pb, rfl⟩ := hΦ_surj b
        rw [← map_mul, hfn, hfn, hfn, map_mul]
      map_zero' := by rw [← Φ.map_zero, hfn, map_zero]
      map_add' := fun a b => by
        obtain ⟨pa, rfl⟩ := hΦ_surj a
        obtain ⟨pb, rfl⟩ := hΦ_surj b
        rw [← map_add, hfn, hfn, hfn, map_add]
      commutes' := fun r => by
        rw [← Φ.commutes r, hfn, AlgHom.commutes]
    }⟩

  
  let I := weilDegMonomialIdx M₀ d₀
  have hStep1 : ∃ (F : Type u) (_ : Field F) (_ : IsAlgClosed F) (_ : Algebra k F)
      (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω) (_ : Algebra k Ω) (_ : Algebra F Ω)
      (_ : IsScalarTower k F Ω)
      (φ_F : R →+* F)
      (C : I → Ω)
      (Λ : Type u) (_ : Field Λ)
      (σ_S : S →+* Λ) (j_Ω : Ω →+* Λ),
