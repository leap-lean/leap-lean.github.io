    have hϖ_g_ne : ϖ_g ≠ 0 := by
      intro h0
      apply hϖ₀_ne
      apply hj_inj
      rw [map_zero]
      change algebraMap ↥Ox₀ ↥O_rel ϖ₀ = 0
      rw [← μ_g.commutes ϖ₀]
      change μ_g ϖ_g = 0
      rw [h0, map_zero]
    let ν_g : B_g →+* F := O_rel.subtype.comp μ_g.toRingHom
    have hνg_inj : Function.Injective ν_g := Subtype.val_injective.comp hμg_inj
    have hJg_uniq : ∀ (M : Ideal B_g), M.IsMaximal → M = J_g := by
      intro M hM
