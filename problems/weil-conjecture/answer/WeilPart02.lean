                (hX (α₀ b)) zero_lt_one).base).obj (D_M (α₀ a)))) =
          (TopologicalSpace.Opens.map (V b).ι.base).obj (Φ_left ⁻¹ᵁ D_M (α₀ a)) at h1
        rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX (α₀ b)) zero_lt_one (hX (α₀ a)) zero_lt_one,
            AlgebraicGeometry.SpecMap_preimage_basicOpen] at h1
        change (TopologicalSpace.Opens.map (V b).toSpecΓ.base).obj
            (PrimeSpectrum.basicOpen (φ b (HomogeneousLocalization.Away.isLocalizationElem (hX (α₀ b)) (hX (α₀ a))))) =
          (TopologicalSpace.Opens.map (V b).ι.base).obj (Φ_left ⁻¹ᵁ D_M (α₀ a)) at h1
        rw [hφ_elem b (α₀ a), hAnchor a b,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen, hBasic a b] at h1
        exact h1.symm
      ext y
      have hyCov : y ∈ ⨆ b : Fin r, V b := by rw [hCovV]; trivial
      obtain ⟨b, hyb⟩ := TopologicalSpace.Opens.mem_iSup.mp hyCov
      constructor
      · intro hy
        have hmem : (⟨y, hyb⟩ : ↥(V b)) ∈
            (TopologicalSpace.Opens.map (V b).ι.base).obj (Φ_left ⁻¹ᵁ D_M (α₀ a)) := hy
        rw [hChartPre b] at hmem
        exact hmem.1
      · intro hya
        have hmem : (⟨y, hyb⟩ : ↥(V b)) ∈
            (TopologicalSpace.Opens.map (V b).ι.base).obj (V a ⊓ V b) := ⟨hya, hyb⟩
        rw [← hChartPre b] at hmem
        exact hmem
    haveI : AlgebraicGeometry.IsProper p_M := hPropProjSpace M
    haveI : AlgebraicGeometry.IsProper (Φ_left ≫ p_M) := by
      rw [hΦ_hom]; infer_instance
    haveI : AlgebraicGeometry.IsProper Φ_left :=
      AlgebraicGeometry.IsProper.of_comp Φ_left p_M
    have hClosedRange : IsClosed (Set.range Φ_left.base) := Φ_left.isClosedMap.isClosed_range
    let Wcov : Option (Fin r) → (AlgebraicGeometry.Proj 𝒜).Opens
      | none => ⟨(Set.range Φ_left.base)ᶜ, hClosedRange.isOpen_compl⟩
      | some a => D_M (α₀ a)
    have hCovWcov : ⨆ idx : Option (Fin r), Wcov idx = ⊤ := by
      apply le_antisymm le_top
      intro p _
      by_cases hp : p ∈ Set.range Φ_left.base
      · obtain ⟨y, rfl⟩ := hp
        have hyCov : y ∈ ⨆ a : Fin r, V a := by rw [hCovV]; trivial
        obtain ⟨a, hya⟩ := TopologicalSpace.Opens.mem_iSup.mp hyCov
        rw [← hPre a] at hya
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨some a, hya⟩
      · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨none, hp⟩
    have hClosedΦ : AlgebraicGeometry.IsClosedImmersion Φ_left := by
      refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) Wcov hCovWcov).mpr ?_
      rintro (_ | a)
      · have hEmpty : IsEmpty ↥((Φ_left ⁻¹ᵁ Wcov none).toScheme) :=
          ⟨fun z => z.2 ⟨z.1, rfl⟩⟩
        exact @AlgebraicGeometry.IsClosedImmersion.instOfIsEmptyCarrierCarrierCommRingCat
          _ _ hEmpty (Φ_left ∣_ Wcov none)
      · have hSurj_φa : Function.Surjective (φ a) := by
          let liftPoly : MvPolynomial (Fin (M + 1)) k →+*
              HomogeneousLocalization.Away 𝒜 (MvPolynomial.X (α₀ a)) :=
            MvPolynomial.eval₂Hom
              ((HomogeneousLocalization.fromZeroRingHom 𝒜
                (Submonoid.powers (MvPolynomial.X (α₀ a)))).comp (algebraMap k ↥(𝒜 0)))
              (fun α => HomogeneousLocalization.Away.isLocalizationElem (hX (α₀ a)) (hX α))
          have hComp : (φ a).comp liftPoly = ψ a := by
            apply MvPolynomial.ringHom_ext'
            · ext c
              simp only [RingHom.comp_apply, liftPoly, MvPolynomial.eval₂Hom_C, ψ]
              exact hφ_const a c
            · intro α
              simp only [RingHom.comp_apply, liftPoly, MvPolynomial.eval₂Hom_X', ψ]
              exact hφ_elem a α
          exact Function.Surjective.of_comp (by rw [← RingHom.coe_comp, hComp]; exact hGen a)
        haveI : AlgebraicGeometry.IsClosedImmersion
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ a))) :=
          AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (φ a)) hSurj_φa
        haveI : CategoryTheory.IsIso (V a).toSpecΓ := by
          rw [← (hAffV a).isoSpec_hom]; infer_instance
        let e_src := Y.left.isoOfEq (hPre a)
        let isoD_a := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X (α₀ a)) (hX (α₀ a)) zero_lt_one
        have hResEq : Φ_left ∣_ D_M (α₀ a) =
            e_src.hom ≫ (V a).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ a)) ≫ isoD_a.inv := by
          rw [← cancel_mono (D_M (α₀ a)).ι, Category.assoc, Category.assoc, Category.assoc,
              AlgebraicGeometry.morphismRestrict_ι, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
          change (Φ_left ⁻¹ᵁ D_M (α₀ a)).ι ≫ Φ_left = e_src.hom ≫ Φ_chart a
          rw [← hΦ_ι a, ← Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
        change AlgebraicGeometry.IsClosedImmersion (Φ_left ∣_ D_M (α₀ a))
        rw [hResEq]
        infer_instance
    exact ⟨M, CategoryTheory.Over.homMk Φ_left hΦ_hom, hClosedΦ⟩
  
  have hProjY : IsProjectiveOverField k Y := by
    obtain ⟨N₀, ι_Z, hClZ⟩ := hProjZ
    haveI : AlgebraicGeometry.IsClosedImmersion ι_Z.left := hClZ
    haveI : AlgebraicGeometry.IsFinite g.left := hFin
    let h : Y ⟶ weilProjectiveSpaceOver k N₀ := g ≫ ι_Z
    have hFin_h : AlgebraicGeometry.IsFinite h.left := by
      change AlgebraicGeometry.IsFinite (g.left ≫ ι_Z.left)
      infer_instance
    obtain ⟨hPropY, r, M, V, lam, W_sec, α₀, hCovV, hAffV, hBasic, hDiag, hInv, hAnchor, hCocycle, hGen⟩ :=
      hCocycleStep N₀ h hFin_h
    haveI : AlgebraicGeometry.IsProper Y.hom := hPropY
    exact hGlueStep r M V hCovV hAffV lam hBasic hDiag hInv W_sec α₀ hAnchor hCocycle hGen
  
  have hDimEq : topologicalKrullDim Y.left = topologicalKrullDim Z.left := by
    clear hProjY hGlueStep hCocycleStep hPropProjSpace hProjZ hIntY
    have hRingDim : ∀ {R B : Type u} [CommRing R] [CommRing B] (φ : R →+* B),
        Function.Injective φ → RingHom.IsIntegral φ → ringKrullDim B = ringKrullDim R := by
      intro R B _ _ φ hInj hInt
      letI : Algebra R B := φ.toAlgebra
      haveI : Algebra.IsIntegral R B := ⟨hInt⟩
      apply le_antisymm
      · apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap φ)
        intro q₁ q₂ hlt
        have h_not_le : ¬ (q₂.asIdeal ≤ q₁.asIdeal) := not_le_of_gt hlt
        obtain ⟨x, hxq₂, hxq₁⟩ := Set.not_subset.mp h_not_le
        have hx_sdiff : x ∈ (q₂.asIdeal : Set B) \ (q₁.asIdeal : Set B) := ⟨hxq₂, hxq₁⟩
        have h_int_x : IsIntegral R x := hInt x
        have := q₁.isPrime
        exact Ideal.under_lt_under_of_integral_mem_sdiff (R := R) (le_of_lt hlt) hx_sdiff h_int_x
      · have h_lift : ∀ (m : ℕ) (p : LTSeries (PrimeSpectrum R)), p.length = m →
            ∃ (q : LTSeries (PrimeSpectrum B)),
              q.length = m ∧ Ideal.under R q.last.asIdeal = p.last.asIdeal := by
          intro m
          induction m with
          | zero =>
            intro p _
            have h_bot : Ideal.under R (⊥ : Ideal B) ≤ p.last.asIdeal := by
              intro r hr
              have hr0 : φ r = 0 := Ideal.mem_bot.mp hr
              have hr_eq : r = 0 := hInj (hr0.trans (map_zero φ).symm)
              rw [hr_eq]
              exact p.last.asIdeal.zero_mem
            have := p.last.isPrime
            obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
              Ideal.exists_ideal_over_prime_of_isIntegral (R := R) (S := B)
                p.last.asIdeal (⊥ : Ideal B) h_bot
            exact ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, hQ₀_under⟩
          | succ m ih =>
            intro p hp_len
            let p' : LTSeries (PrimeSpectrum R) := p.eraseLast
            have hp'_len : p'.length = m := by
              rw [RelSeries.eraseLast_length, hp_len]
              omega
            have hp'_lt : p'.last < p.last := p.eraseLast_last_rel_last (by omega)
            obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
            have h_le_under : Ideal.under R q'.last.asIdeal ≤ p.last.asIdeal := by
              rw [hq'_under]
              exact le_of_lt hp'_lt
            have := p.last.isPrime
            have := q'.last.isPrime
            obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
              Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (R := R) (S := B)
                p.last.asIdeal q'.last.asIdeal h_le_under
            have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum B) := by
              refine lt_of_le_not_ge hQ_ge (fun h_ge => ?_)
              have h_eq : Q_next = q'.last.asIdeal := le_antisymm h_ge hQ_ge
              have h_under_eq : p.last.asIdeal = p'.last.asIdeal := by
                rw [← hQ_under, h_eq, hq'_under]
              exact (ne_of_lt hp'_lt) (PrimeSpectrum.ext h_under_eq.symm)
            let q : LTSeries (PrimeSpectrum B) := q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q
            refine ⟨q, ?_, ?_⟩
            · rw [RelSeries.snoc_length, hq'_len]
            · rw [RelSeries.last_snoc]
              exact hQ_under
        change ⨆ (p : LTSeries (PrimeSpectrum R)), (p.length : WithBot ℕ∞) ≤ ringKrullDim B
        apply iSup_le
        intro p
        obtain ⟨q, hq_len, _⟩ := h_lift p.length p rfl
        calc (p.length : WithBot ℕ∞)
            = (q.length : WithBot ℕ∞) := by rw [hq_len]
          _ ≤ Order.krullDim (PrimeSpectrum B) := Order.LTSeries.length_le_krullDim q
          _ = ringKrullDim B := rfl
    have hOpenCoverDim : ∀ (X : Type u) [TopologicalSpace X] {ι : Type u}
        (W : ι → TopologicalSpace.Opens X),
        (∀ x : X, ∃ i : ι, x ∈ W i) →
        topologicalKrullDim X = ⨆ i : ι, topologicalKrullDim ↥(W i) := by
      intro X _ ι W hCov
      apply le_antisymm
      · change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds X)),
          (p.length : WithBot ℕ∞) ≤ ⨆ i : ι, topologicalKrullDim ↥(W i)
        apply iSup_le
        intro p
        obtain ⟨x, hx0⟩ := (p 0).isIrreducible.nonempty
        obtain ⟨i₀, hxW⟩ := hCov x
        have hv_emb : Topology.IsOpenEmbedding (Subtype.val : ↥(W i₀) → X) := (W i₀).isOpenEmbedding'
        let c : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥(W i₀) := fun j =>
          have hx_j : x ∈ (p j : Set X) := p.monotone (Fin.zero_le j) hx0
          have h_ne_j : ((p j : Set X) ∩ Set.range (Subtype.val : ↥(W i₀) → X)).Nonempty :=
            ⟨x, hx_j, ⟨x, hxW⟩, rfl⟩
          { carrier := (Subtype.val : ↥(W i₀) → X) ⁻¹' (p j : Set X)
            isIrreducible' := (p j).isIrreducible.preimage hv_emb h_ne_j
            isClosed' := (p j).isClosed.preimage continuous_subtype_val }
        have h_strict : ∀ j : Fin p.length, c (Fin.castSucc j) < c j.succ := by
          intro j
          have hp_lt : p (Fin.castSucc j) < p j.succ := p.step j
          have h_le : c (Fin.castSucc j) ≤ c j.succ := fun y hy => (le_of_lt hp_lt) hy
          refine lt_of_le_not_ge h_le (fun h_ge => ?_)
          obtain ⟨y, hy_succ, hy_not⟩ := Set.not_subset.mp (not_le_of_gt hp_lt)
          have hO₁ : IsOpen ((p (Fin.castSucc j) : Set X)ᶜ) :=
            (p (Fin.castSucc j)).isClosed.isOpen_compl
          have hO₂ : IsOpen (W i₀ : Set X) := (W i₀).isOpen
          have hN₁ : ((p j.succ : Set X) ∩ (p (Fin.castSucc j) : Set X)ᶜ).Nonempty :=
            ⟨y, hy_succ, hy_not⟩
          have hN₂ : ((p j.succ : Set X) ∩ (W i₀ : Set X)).Nonempty :=
            ⟨x, p.monotone (Fin.zero_le j.succ) hx0, hxW⟩
          obtain ⟨w, hw_succ, hw_not, hw_W⟩ :=
            (p j.succ).isIrreducible.isPreirreducible _ _ hO₁ hO₂ hN₁ hN₂
          exact hw_not (h_ge (show (⟨w, hw_W⟩ : ↥(W i₀)) ∈ c j.succ from hw_succ))
        let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(W i₀)) :=
          { length := p.length, toFun := c, step := h_strict }
        calc (p.length : WithBot ℕ∞)
            = (q.length : WithBot ℕ∞) := rfl
          _ ≤ topologicalKrullDim ↥(W i₀) := Order.LTSeries.length_le_krullDim q
          _ ≤ ⨆ i : ι, topologicalKrullDim ↥(W i) :=
              le_iSup (fun i : ι => topologicalKrullDim ↥(W i)) i₀
      · apply iSup_le
        intro i
        exact topologicalKrullDim_subspace_le X (W i : Set X)
    haveI : AlgebraicGeometry.IsIntegral Z.left := hIntZ
    haveI : AlgebraicGeometry.IsFinite g.left := hFin
    let ι : Type u := { U : Z.left.Opens // AlgebraicGeometry.IsAffineOpen U }
    have hCovZ : ∀ z : Z.left, ∃ i : ι, z ∈ i.1 := by
      intro z
      obtain ⟨U, hAffU, hzU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top z)
      exact ⟨⟨U, hAffU⟩, hzU⟩
    have hCovY : ∀ y : Y.left, ∃ i : ι, y ∈ g.left ⁻¹ᵁ i.1 := by
      intro y
      obtain ⟨i, hi⟩ := hCovZ (g.left.base y)
      exact ⟨i, hi⟩
    rw [hOpenCoverDim ↥Y.left (fun i : ι => g.left ⁻¹ᵁ i.1) hCovY,
        hOpenCoverDim ↥Z.left (fun i : ι => i.1) hCovZ]
    refine iSup_congr fun i => ?_
    let U : Z.left.Opens := i.1
    have hAffU : AlgebraicGeometry.IsAffineOpen U := i.2
    let V_U : Y.left.Opens := g.left ⁻¹ᵁ U
    have hAffVU : AlgebraicGeometry.IsAffineOpen V_U := hAffU.preimage g.left
    have hIntHom : RingHom.IsIntegral (g.left.app U).hom :=
      ((AlgebraicGeometry.isIntegralHom_iff g.left).mp inferInstance).2 U hAffU
    have hInjHom : Function.Injective (g.left.app U).hom := by
      intro r₁ r₂ hr
      have hsub : (g.left.app U).hom (r₁ - r₂) = 0 := by rw [map_sub, hr, sub_self]
      have hpre : g.left ⁻¹ᵁ Z.left.basicOpen (r₁ - r₂) = ⊥ := by
        rw [AlgebraicGeometry.Scheme.preimage_basicOpen, hsub, AlgebraicGeometry.Scheme.basicOpen_zero]
      have hbo : Z.left.basicOpen (r₁ - r₂) = ⊥ := by
        rw [eq_bot_iff]
        intro z hz
        obtain ⟨y, rfl⟩ := hSurj.surj z
        have hy : y ∈ g.left ⁻¹ᵁ Z.left.basicOpen (r₁ - r₂) := hz
        rw [hpre] at hy
        exact hy
      exact sub_eq_zero.mp ((AlgebraicGeometry.basicOpen_eq_bot_iff (r₁ - r₂)).mp hbo)
    have hRingEq : ringKrullDim ↑(Y.left.presheaf.obj (Opposite.op V_U)) =
        ringKrullDim ↑(Z.left.presheaf.obj (Opposite.op U)) :=
      hRingDim (g.left.app U).hom hInjHom hIntHom
    have hTopAff : ∀ {S : AlgebraicGeometry.Scheme.{u}} (W : S.Opens)
        (hAff : AlgebraicGeometry.IsAffineOpen W),
        topologicalKrullDim ↥W = ringKrullDim ↑(S.presheaf.obj (Opposite.op W)) := by
      intro S W hAff
      let e := AlgebraicGeometry.Scheme.homeoOfIso hAff.isoSpec
      calc topologicalKrullDim ↥W
          = topologicalKrullDim ↥W.toScheme := rfl
        _ = topologicalKrullDim ↥(AlgebraicGeometry.Spec (S.presheaf.obj (Opposite.op W))) :=
            e.isHomeomorph.topologicalKrullDim_eq
        _ = topologicalKrullDim (PrimeSpectrum ↑(S.presheaf.obj (Opposite.op W))) := rfl
        _ = ringKrullDim ↑(S.presheaf.obj (Opposite.op W)) :=
            PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _
    rw [hTopAff V_U hAffVU, hTopAff U hAffU, hRingEq]
  exact ⟨hProjY, hDimEq⟩

theorem weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ)
    (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Algebra k A] [Algebra.FiniteType k A]
    (hDimA : ringKrullDim A = (d : WithBot ℕ∞))
    (p : Ideal A) [p.IsPrime]
    (hp : p.height ≤ 1) :
    ∃ f : A, f ∉ p ∧ Algebra.IsStandardSmoothOfRelativeDimension d k (Localization.Away f) :=
by
  
  
  have h_s1 : ∀ (e : ℕ) (D : Type u) [CommRing D] [IsDomain D] [Algebra k D] [Algebra.FiniteType k D],
      ringKrullDim D = (e : WithBot ℕ∞) →
      ∀ (q : Ideal D) [q.IsPrime] [Algebra.IsSmoothAt k q],
        ∃ f : D, f ∉ q ∧ Algebra.IsStandardSmoothOfRelativeDimension e k (Localization.Away f) := by
    clear! d A
    intro e D _ _ _ _ hDimD q _ _
    obtain ⟨s₁, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k D
    let P_s := MvPolynomial (Fin s₁) k
    have hDimPs : ringKrullDim P_s = (s₁ : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing,
        ringKrullDim_eq_zero_of_isField (Field.toIsField k), zero_add,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    have hTrPs : Algebra.trdeg k P_s = (s₁ : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin]
      simp
    have hs₁Dim : ringKrullDim D = (s₁ : WithBot ℕ∞) := by
      letI : Algebra P_s D := g.toRingHom.toAlgebra
      have _ : Algebra.IsIntegral P_s D := ⟨hg_int⟩
      have hLE1 : ringKrullDim D ≤ ringKrullDim P_s := by
        refine Order.krullDim_le_of_strictMono
          (fun Q : PrimeSpectrum D => (⟨Ideal.under P_s Q.asIdeal, inferInstance⟩ : PrimeSpectrum P_s)) ?_
        intro Q₁ Q₂ hlt
        change Ideal.under P_s Q₁.asIdeal < Ideal.under P_s Q₂.asIdeal
        obtain ⟨x, hx₂, hx₁⟩ := SetLike.exists_of_lt (show Q₁.asIdeal < Q₂.asIdeal from hlt)
        exact Ideal.under_lt_under_of_integral_mem_sdiff hlt.le ⟨hx₂, hx₁⟩
          (Algebra.IsIntegral.isIntegral x)
      have hLift : ∀ (n : ℕ) (c : LTSeries (PrimeSpectrum P_s)), c.length = n →
          ∃ c' : LTSeries (PrimeSpectrum D),
            c'.length = n ∧ Ideal.under P_s (c'.last).asIdeal = (c.last).asIdeal := by
        intro n
        induction n with
        | zero =>
          intro c _
          have hbot : Ideal.under P_s (⊥ : Ideal D) ≤ (c.last).asIdeal := by
            intro x hx
            rw [Ideal.mem_comap, Ideal.mem_bot] at hx
            have hx0 : x = 0 := hg_inj (by simpa [RingHom.algebraMap_toAlgebra] using hx)
            exact hx0 ▸ (c.last).asIdeal.zero_mem
          obtain ⟨Q, _, hQprime, hQover⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral (c.last).asIdeal (⊥ : Ideal D) hbot
          exact ⟨RelSeries.singleton _ ⟨Q, hQprime⟩, rfl, hQover⟩
        | succ n ih =>
          intro c hc
          let c₀ := c.eraseLast
          have hc₀ : c₀.length = n := by simp [c₀, hc]
          obtain ⟨c'₀, hc'₀len, hc'₀over⟩ := ih c₀ hc₀
          have hlt_c : (c₀.last).asIdeal < (c.last).asIdeal := by
            have hstep : c.toFun (⟨n, by omega⟩ : Fin c.length).castSucc <
                c.toFun (⟨n, by omega⟩ : Fin c.length).succ := c.step ⟨n, by omega⟩
            have h1 : c₀.last = c.toFun (⟨n, by omega⟩ : Fin c.length).castSucc := by
              simp only [c₀, RelSeries.eraseLast, RelSeries.last]
              congr 1
              ext
              simp [hc]
            have h2 : c.last = c.toFun (⟨n, by omega⟩ : Fin c.length).succ := by
              simp only [RelSeries.last]
              congr 1
              ext
              simp [hc]
            rw [h1, h2]
            exact hstep
          have hle_under : Ideal.under P_s (c'₀.last).asIdeal ≤ (c.last).asIdeal := by
            rw [hc'₀over]
            exact hlt_c.le
          obtain ⟨Q, hleQ, hQprime, hQover⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
              (c.last).asIdeal (c'₀.last).asIdeal hle_under
          have hltQ : (c'₀.last : PrimeSpectrum D) < ⟨Q, hQprime⟩ := by
            refine lt_of_le_of_ne hleQ ?_
            intro hEq
            have hEqIdeal : (c'₀.last).asIdeal = Q := congrArg PrimeSpectrum.asIdeal hEq
            rw [hEqIdeal, hQover] at hc'₀over
            exact hlt_c.ne hc'₀over.symm
          refine ⟨c'₀.snoc ⟨Q, hQprime⟩ hltQ, ?_, ?_⟩
          · simp [hc'₀len]
          · simpa using hQover
      have hLE2 : ringKrullDim P_s ≤ ringKrullDim D := by
        rw [ringKrullDim, ringKrullDim, Order.krullDim, Order.krullDim]
        refine iSup_le fun c => ?_
        obtain ⟨c', hc'len, _⟩ := hLift c.length c rfl
        rw [← hc'len]
        exact le_iSup (fun d : LTSeries (PrimeSpectrum D) => (d.length : WithBot ℕ∞)) c'
      exact (le_antisymm hLE1 hLE2).trans hDimPs
    have hs₁Tr : Algebra.trdeg k D = (s₁ : Cardinal.{u}) := by
      letI : Algebra P_s D := g.toRingHom.toAlgebra
      have _ : IsScalarTower k P_s D := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
      have _ : Algebra.IsIntegral P_s D := ⟨hg_int⟩
      have _ : FaithfulSMul P_s D := (faithfulSMul_iff_algebraMap_injective P_s D).mpr hg_inj
      have _ : Algebra.IsAlgebraic P_s D := Algebra.IsIntegral.isAlgebraic
      have hAdd : Algebra.trdeg k P_s + Algebra.trdeg P_s D = Algebra.trdeg k D := trdeg_add_eq k P_s
      rw [hTrPs, trdeg_eq_zero (R := P_s) (A := D), add_zero] at hAdd
      exact hAdd.symm
    have _ : Algebra.FinitePresentation k D := Algebra.FinitePresentation.of_finiteType.mp inferInstance
    obtain ⟨f, hf, hSm⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth k q
    let D_f := Localization.Away f
    have hf0 : f ≠ 0 := fun h => hf (h ▸ q.zero_mem)
    have hSub : Submonoid.powers f ≤ nonZeroDivisors D :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf0)
    have _ : IsDomain D_f := IsLocalization.isDomain_of_le_nonZeroDivisors D_f hSub
    obtain ⟨ι, σ, _, _, ⟨P_sub⟩⟩ := hSm.out
    let n_D : ℕ := P_sub.dimension
    have _ : Algebra.IsStandardSmoothOfRelativeDimension n_D k D_f :=
      P_sub.isStandardSmoothOfRelativeDimension rfl
    have hTrEq : Algebra.trdeg k D_f = Algebra.trdeg k D := by
      have _ : FaithfulSMul D D_f :=
        (faithfulSMul_iff_algebraMap_injective D D_f).mpr (IsLocalization.injective D_f hSub)
      have _ : Algebra.IsAlgebraic D D_f := IsLocalization.isAlgebraic D_f (Submonoid.powers f)
      have hAdd : Algebra.trdeg k D + Algebra.trdeg D D_f = Algebra.trdeg k D_f := trdeg_add_eq k D
      rw [trdeg_eq_zero (R := D) (A := D_f), add_zero] at hAdd
      exact hAdd.symm
    have hTrDf : Algebra.trdeg k D_f = (n_D : Cardinal.{u}) := by
      have hSmHom : RingHom.IsStandardSmoothOfRelativeDimension n_D (algebraMap k D_f) :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n_D).mpr inferInstance
      obtain ⟨ψ, hψ_comp, hψ_et⟩ :=
        RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hSmHom
      let R₀ := MvPolynomial (Fin n_D) k
      let K₀ := FractionRing R₀
      let K_f := FractionRing D_f
      have hTrR₀ : Algebra.trdeg k R₀ = (n_D : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin]
        simp
      have hTrK₀ : Algebra.trdeg k K₀ = (n_D : Cardinal.{u}) := by
        have _ : Algebra.IsAlgebraic R₀ K₀ := IsLocalization.isAlgebraic K₀ (nonZeroDivisors R₀)
        have hAdd : Algebra.trdeg k R₀ + Algebra.trdeg R₀ K₀ = Algebra.trdeg k K₀ := trdeg_add_eq k R₀
        rw [hTrR₀, trdeg_eq_zero (R := R₀) (A := K₀), add_zero] at hAdd
        exact hAdd.symm
      have hTrKf : Algebra.trdeg k K_f = Algebra.trdeg k D_f := by
        have _ : Algebra.IsAlgebraic D_f K_f := IsLocalization.isAlgebraic K_f (nonZeroDivisors D_f)
        have hAdd : Algebra.trdeg k D_f + Algebra.trdeg D_f K_f = Algebra.trdeg k K_f :=
          trdeg_add_eq k D_f
        rw [trdeg_eq_zero (R := D_f) (A := K_f), add_zero] at hAdd
        exact hAdd.symm
      have hTrKf_eq_K₀ : Algebra.trdeg k K_f = Algebra.trdeg k K₀ := by
        letI : Algebra R₀ D_f := ψ.toAlgebra
        have _ : Algebra.Etale R₀ D_f := RingHom.etale_algebraMap.mp hψ_et
        have _ : Module.Flat R₀ D_f := inferInstance
        have _ : Module.IsTorsionFree R₀ D_f := Module.Flat.isTorsionFree
        have hInjR₀ : Function.Injective (algebraMap R₀ D_f) :=
          (faithfulSMul_iff_algebraMap_injective R₀ D_f).mp inferInstance
        have hUnitK₀ : ∀ y : nonZeroDivisors R₀,
            IsUnit (((algebraMap D_f K_f).comp (algebraMap R₀ D_f)) y) := by
          intro y
          rw [RingHom.comp_apply]
          exact Ne.isUnit ((map_ne_zero_iff _ (IsFractionRing.injective D_f K_f)).mpr
            ((map_ne_zero_iff _ hInjR₀).mpr (mem_nonZeroDivisors_iff_ne_zero.mp y.2)))
        let i_K₀ : K₀ →+* K_f := IsLocalization.lift hUnitK₀
        letI : Algebra K₀ K_f := i_K₀.toAlgebra
        have _ : FaithfulSMul K₀ K_f := (faithfulSMul_iff_algebraMap_injective K₀ K_f).mpr i_K₀.injective
        have _ : IsScalarTower k K₀ K_f := IsScalarTower.of_algebraMap_eq' <| by
          ext c
          calc algebraMap k K_f c
              = algebraMap D_f K_f (algebraMap k D_f c) := IsScalarTower.algebraMap_apply k D_f K_f c
            _ = algebraMap D_f K_f (ψ (MvPolynomial.C c)) := by
                rw [← hψ_comp, RingHom.comp_apply]
            _ = i_K₀ (algebraMap R₀ K₀ (algebraMap k R₀ c)) :=
                (IsLocalization.lift_eq hUnitK₀ (algebraMap k R₀ c)).symm
            _ = algebraMap K₀ K_f (algebraMap k K₀ c) := by
                rw [← IsScalarTower.algebraMap_apply k R₀ K₀ c]
                rfl
        let B := TensorProduct R₀ K₀ D_f
        have _ : Algebra.Etale K₀ B := inferInstance
        have _ : Module.Finite K₀ B := by
          obtain ⟨I_et, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
            (Algebra.Etale.iff_exists_algEquiv_prod K₀ B).mp inferInstance
          letI := hFinI
          letI := hFieldAi
          letI := hAlgAi
          have _ : ∀ i : I_et, Module.Finite K₀ (Ai i) := fun i => (hFinSep i).1
          exact Module.Finite.equiv (AlgEquiv.toLinearEquiv e_prod).symm
        have _ : Algebra.IsIntegral K₀ B := Algebra.IsIntegral.of_finite K₀ B
        let φ_Df_Kf : D_f →ₐ[R₀] K_f :=
          { toRingHom := algebraMap D_f K_f
            commutes' := fun _ => rfl }
        let i_K₀_alg : K₀ →ₐ[R₀] K_f :=
          { toRingHom := i_K₀
            commutes' := fun r => IsLocalization.lift_eq hUnitK₀ r }
        let hComm : ∀ (x : K₀) (y : D_f), Commute (i_K₀_alg x) (φ_Df_Kf y) :=
          fun _ _ => Commute.all _ _
        let Φ_ring : B →+* K_f :=
          (Algebra.TensorProduct.lift i_K₀_alg φ_Df_Kf hComm).toRingHom
        let Φ_K₀ : B →ₐ[K₀] K_f :=
          { toRingHom := Φ_ring
            commutes' := fun x => by
              change (Algebra.TensorProduct.lift i_K₀_alg φ_Df_Kf hComm) (x ⊗ₜ[R₀] (1 : D_f)) = i_K₀ x
              rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
              rfl }
        have hAlgDf : ∀ x : D_f, IsAlgebraic K₀ (algebraMap D_f K_f x) := by
          intro x
          have hIntB : IsIntegral K₀ ((1 : K₀) ⊗ₜ[R₀] x : B) := Algebra.IsIntegral.isIntegral _
          have hIntKf : IsIntegral K₀ (Φ_K₀ ((1 : K₀) ⊗ₜ[R₀] x)) := hIntB.map Φ_K₀
          have hEval : Φ_K₀ ((1 : K₀) ⊗ₜ[R₀] x) = algebraMap D_f K_f x := by
            change (Algebra.TensorProduct.lift i_K₀_alg φ_Df_Kf hComm) ((1 : K₀) ⊗ₜ[R₀] x) = _
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl
          rw [hEval] at hIntKf
          exact hIntKf.isAlgebraic
        have _ : Algebra.IsAlgebraic K₀ K_f := ⟨fun z => by
          obtain ⟨⟨a, b⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors D_f) z
          have hb_ne : algebraMap D_f K_f b.1 ≠ 0 :=
            (map_ne_zero_iff _ (IsFractionRing.injective D_f K_f)).mpr
              (mem_nonZeroDivisors_iff_ne_zero.mp b.2)
          have hz_eq : z = algebraMap D_f K_f a * (algebraMap D_f K_f b.1)⁻¹ := by
            rw [← hz, mul_inv_cancel_right₀ hb_ne]
          rw [hz_eq]
          exact (hAlgDf a).mul (hAlgDf b.1).inv⟩
        have hAdd : Algebra.trdeg k K₀ + Algebra.trdeg K₀ K_f = Algebra.trdeg k K_f :=
          trdeg_add_eq k K₀
        rw [trdeg_eq_zero (R := K₀) (A := K_f), add_zero] at hAdd
        exact hAdd.symm
      exact hTrKf.symm.trans (hTrKf_eq_K₀.trans hTrK₀)
    have hs₁_eq_e : s₁ = e := by
      exact_mod_cast hs₁Dim.symm.trans hDimD
    have hnEq : n_D = e := by
      have hCard : (n_D : Cardinal.{u}) = (e : Cardinal.{u}) := by
        rw [← hTrDf, hTrEq, hs₁Tr, hs₁_eq_e]
      exact_mod_cast hCard
    exact ⟨f, hf, hnEq ▸ inferInstance⟩

  
  have h_s2 : ∀ (e : ℕ) (D : Type u) [CommRing D] [IsDomain D] [Algebra k D] [Algebra.FiniteType k D],
      ringKrullDim D = (e : WithBot ℕ∞) →
      ∀ (F_D : Type u) [Field F_D] [Algebra k F_D] [Algebra D F_D]
        [IsScalarTower k D F_D] [IsFractionRing D F_D],
        Algebra.IsSmoothAt k (⊥ : Ideal D) ∧ Module.finrank F_D Ω[F_D ⁄ k] = e := by
    clear! d A
    intro e D _ _ _ _ hDimD F_D _ _ _ _ _
    let q₀ : Ideal D := ⊥
    have hSmBot : Algebra.IsSmoothAt k q₀ := by
      have hCompl : q₀.primeCompl = nonZeroDivisors D := by
        ext x
        simp [q₀, Ideal.primeCompl, mem_nonZeroDivisors_iff_ne_zero]
      have _ : IsLocalization (nonZeroDivisors D) (Localization.AtPrime q₀) := by
        rw [← hCompl]
        infer_instance
      let e_D : Localization.AtPrime q₀ ≃ₐ[D] FractionRing D :=
        IsLocalization.algEquiv (nonZeroDivisors D) (Localization.AtPrime q₀) (FractionRing D)
      let e_k : Localization.AtPrime q₀ ≃ₐ[k] FractionRing D := e_D.restrictScalars k
      exact Algebra.FormallySmooth.of_equiv e_k.symm
    refine ⟨hSmBot, ?_⟩
    have _ : Algebra.IsSmoothAt k q₀ := hSmBot
    obtain ⟨f, hf, hSm_f⟩ := h_s1 e D hDimD q₀
    let D_f := Localization.Away f
    have hf0 : f ≠ 0 := by simpa [q₀] using hf
    have hSub : Submonoid.powers f ≤ nonZeroDivisors D :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf0)
    have _ : IsDomain D_f := IsLocalization.isDomain_of_le_nonZeroDivisors D_f hSub
    have _ : Algebra.IsStandardSmoothOfRelativeDimension e k D_f := hSm_f
    have _ : Algebra.IsStandardSmooth k D_f :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth e
    have _ : Module.Free D_f Ω[D_f ⁄ k] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hFinrankDf : Module.finrank D_f Ω[D_f ⁄ k] = e :=
      Module.finrank_eq_of_rank_eq (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential e)
    have hf_ne_F : algebraMap D F_D f ≠ 0 :=
      (map_ne_zero_iff (algebraMap D F_D) (IsFractionRing.injective D F_D)).mpr hf0
    have hu : IsUnit (algebraMap D F_D f) := Ne.isUnit hf_ne_F
    let φ_f : D_f →+* F_D := IsLocalization.Away.lift f hu
    letI : Algebra D_f F_D := φ_f.toAlgebra
    have _ : IsScalarTower D D_f F_D := IsScalarTower.of_algebraMap_eq' <| by
      ext x
      exact (IsLocalization.Away.lift_eq f hu x).symm
    have _ : IsScalarTower k D_f F_D := IsScalarTower.of_algebraMap_eq' <| by
      ext c
      calc algebraMap k F_D c = algebraMap D F_D (algebraMap k D c) := IsScalarTower.algebraMap_apply k D F_D c
        _ = algebraMap D_f F_D (algebraMap D D_f (algebraMap k D c)) :=
            IsScalarTower.algebraMap_apply D D_f F_D (algebraMap k D c)
        _ = algebraMap D_f F_D (algebraMap k D_f c) := by rw [← IsScalarTower.algebraMap_apply k D D_f c]
    have _ : IsFractionRing D_f F_D :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers f) D_f F_D
    have _ : IsLocalizedModule (nonZeroDivisors D_f) (KaehlerDifferential.map k k D_f F_D) :=
      KaehlerDifferential.isLocalizedModule_map k D_f F_D (nonZeroDivisors D_f)
    have hLocFinrank :=
      Module.finrank_of_isLocalizedModule_of_free F_D (nonZeroDivisors D_f) (KaehlerDifferential.map k k D_f F_D)
    exact hLocFinrank.trans hFinrankDf

  
  have h_s3 : ∀ (d₀ : ℕ) (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
      [Algebra k A₀] [Algebra.FiniteType k A₀],
      ringKrullDim A₀ = (d₀ : WithBot ℕ∞) →
      ∀ (p₀ : Ideal A₀) [p₀.IsPrime], p₀ ≠ ⊥ → p₀.height ≤ 1 →
        ∃ (m e_p : ℕ),
          d₀ = m + 1 ∧
          Module.finrank p₀.ResidueField (IsLocalRing.CotangentSpace (Localization.AtPrime p₀)) = 1 ∧
          ringKrullDim (A₀ ⧸ p₀) = (e_p : WithBot ℕ∞) ∧
          e_p ≤ m := by
    clear! d A
    intro d A _ _ _ _ _ hDimA p _ hp_ne hp
    have hBotLtP : (⟨⊥, inferInstance⟩ : PrimeSpectrum A) < ⟨p, inferInstance⟩ :=
      lt_of_le_of_ne bot_le (fun h => hp_ne (congrArg PrimeSpectrum.asIdeal h).symm)
    have hd_pos : 1 ≤ d := by
      let c₁ : LTSeries (PrimeSpectrum A) :=
        (RelSeries.singleton _ (⟨p, inferInstance⟩ : PrimeSpectrum A)).cons ⟨⊥, inferInstance⟩ hBotLtP
      have hlen : ((c₁.length : ℕ) : WithBot ℕ∞) ≤ ringKrullDim A :=
        le_iSup (fun c : LTSeries (PrimeSpectrum A) => (c.length : WithBot ℕ∞)) c₁
      rw [hDimA] at hlen
      have hc₁len : c₁.length = 1 := rfl
      rw [hc₁len] at hlen
      exact_mod_cast hlen
    let m : ℕ := d - 1
    have hd_eq : d = m + 1 := (Nat.sub_add_cancel hd_pos).symm
    have _ : Nonempty (PrimeSpectrum (A ⧸ p)) := ⟨⟨⊥, inferInstance⟩⟩
    have hChainLE : ∀ c : LTSeries (PrimeSpectrum (A ⧸ p)), c.length ≤ m := by
      intro c
      let f_mk : PrimeSpectrum (A ⧸ p) → PrimeSpectrum A :=
        PrimeSpectrum.comap (Ideal.Quotient.mk p)
      have hf_strict : StrictMono f_mk := by
        intro q₁ q₂ hlt
        change Ideal.comap (Ideal.Quotient.mk p) q₁.asIdeal < Ideal.comap (Ideal.Quotient.mk p) q₂.asIdeal
        obtain ⟨y, hy₂, hy₁⟩ := SetLike.exists_of_lt (show q₁.asIdeal < q₂.asIdeal from hlt)
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact SetLike.lt_iff_le_and_exists.mpr ⟨Ideal.comap_mono hlt.le, x, hy₂, hy₁⟩
      let c' : LTSeries (PrimeSpectrum A) := c.map f_mk (fun _ _ h => hf_strict h)
      have hp_le_head : p ≤ (c'.head).asIdeal := by
        intro x hx
        change Ideal.Quotient.mk p x ∈ (c.head).asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact (c.head).asIdeal.zero_mem
      have hBotLtHead : (⟨⊥, inferInstance⟩ : PrimeSpectrum A) < c'.head :=
        lt_of_lt_of_le hBotLtP hp_le_head
      let c'' : LTSeries (PrimeSpectrum A) := c'.cons ⟨⊥, inferInstance⟩ hBotLtHead
      have hlen : ((c''.length : ℕ) : WithBot ℕ∞) ≤ ringKrullDim A :=
        le_iSup (fun s : LTSeries (PrimeSpectrum A) => (s.length : WithBot ℕ∞)) c''
      rw [hDimA, hd_eq] at hlen
      have hc''len : c''.length = c.length + 1 := by
        simp [c'']
        rfl
      rw [hc''len] at hlen
      have hNat : c.length + 1 ≤ m + 1 := by exact_mod_cast hlen
      omega
    have hSupLE : (⨆ c : LTSeries (PrimeSpectrum (A ⧸ p)), (c.length : ℕ∞)) ≤ (m : ℕ∞) :=
      iSup_le fun c => Nat.cast_le.mpr (hChainLE c)
    have hSupNeTop : (⨆ c : LTSeries (PrimeSpectrum (A ⧸ p)), (c.length : ℕ∞)) ≠ ⊤ :=
      ne_top_of_le_ne_top (ENat.natCast_ne_top m) hSupLE
    obtain ⟨e_p, he_p_eq⟩ := ENat.ne_top_iff_exists.mp hSupNeTop
    have hDimQuot : ringKrullDim (A ⧸ p) = (e_p : WithBot ℕ∞) := by
      rw [ringKrullDim, Order.krullDim_eq_iSup_length, ← he_p_eq]
      rfl
    have he_p_le : e_p ≤ m := by
      rw [← he_p_eq] at hSupLE
      exact Nat.cast_le.mp hSupLE
    let S := Localization.AtPrime p
    have _ : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
    have _ : IsNoetherianRing S := inferInstance
    have hSubP : p.primeCompl ≤ nonZeroDivisors A := by
      intro x hx
      exact mem_nonZeroDivisors_of_ne_zero (fun h0 => hx (h0 ▸ p.zero_mem))
    have hIntClosedS : IsIntegrallyClosed S := isIntegrallyClosed_of_isLocalization S p.primeCompl hSubP
    obtain ⟨a, ha_mem, ha_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp_ne
    have haS_mem : algebraMap A S a ∈ IsLocalRing.maximalIdeal S :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff S p a).mpr ha_mem
    have haS_ne : algebraMap A S a ≠ 0 :=
      (map_ne_zero_iff (algebraMap A S) (IsLocalization.injective S hSubP)).mpr ha_ne
    have hmS_ne_bot : IsLocalRing.maximalIdeal S ≠ ⊥ := by
      intro hBot
      exact haS_ne (Ideal.mem_bot.mp (hBot ▸ haS_mem))
    have hNotField : ¬ IsField S := by
      rw [IsLocalRing.isField_iff_maximalIdeal_eq]
      exact hmS_ne_bot
    have hUniquePrime : ∃! Q : Ideal S, Q ≠ ⊥ ∧ Q.IsPrime := by
      refine ⟨IsLocalRing.maximalIdeal S, ⟨hmS_ne_bot, inferInstance⟩, ?_⟩
      rintro Q ⟨hQ_ne, hQ_prime⟩
      let e_ord := IsLocalization.orderIsoOfPrime p.primeCompl S
      let q : Ideal A := (e_ord ⟨Q, hQ_prime⟩).1
      have hq_prime : q.IsPrime := (e_ord ⟨Q, hQ_prime⟩).2.1
      have hq_disj : Disjoint (p.primeCompl : Set A) (q : Set A) := (e_ord ⟨Q, hQ_prime⟩).2.2
      have hq_le_p : q ≤ p := by
        intro x hx
        by_contra hxp
        exact Set.disjoint_left.mp hq_disj hxp hx
      have hBot_map : (e_ord ⟨⊥, inferInstance⟩).1 = ⊥ := by
        ext x
        simp [e_ord, IsLocalization.orderIsoOfPrime]
      have hq_ne_bot : q ≠ ⊥ := by
        intro hq0
        have hEqOrd : e_ord ⟨Q, hQ_prime⟩ = e_ord ⟨⊥, inferInstance⟩ := by
          ext1
          exact hq0.trans hBot_map.symm
        exact hQ_ne (congrArg Subtype.val (e_ord.injective hEqOrd))
      have hq_eq_p : q = p := by
        by_contra hne
        have hlt : q < p := lt_of_le_of_ne hq_le_p hne
        have hp1 : p.height ≤ ((1 : ℕ) : ℕ∞) := hp
        have hq_ht_lt : q.height < ((1 : ℕ) : ℕ∞) :=
          (Ideal.height_le_iff.mp hp1) q hq_prime hlt
        have hq_ht_zero : q.height ≤ ((0 : ℕ) : ℕ∞) := Order.le_of_lt_add_one hq_ht_lt
        have hbot_lt_q : (⊥ : Ideal A) < q := lt_of_le_of_ne bot_le hq_ne_bot.symm
        have hbot_ht := (Ideal.height_le_iff (p := q) (n := 0)).mp hq_ht_zero ⊥ inferInstance hbot_lt_q
        exact not_lt_bot hbot_ht
      have hm_map : (e_ord ⟨IsLocalRing.maximalIdeal S, inferInstance⟩).1 = p := by
        ext x
        exact IsLocalization.AtPrime.to_map_mem_maximal_iff S p x
      have hEqOrd : e_ord ⟨Q, hQ_prime⟩ = e_ord ⟨IsLocalRing.maximalIdeal S, inferInstance⟩ := by
        ext1
        exact hq_eq_p.trans hm_map.symm
      exact congrArg Subtype.val (e_ord.injective hEqOrd)
    have hTFAE : (IsIntegrallyClosed S ∧ ∃! Q : Ideal S, Q ≠ ⊥ ∧ Q.IsPrime) ↔
        Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S) = 1 :=
      (IsDiscreteValuationRing.TFAE S hNotField).out 4 6
    have hCot : Module.finrank p.ResidueField (IsLocalRing.CotangentSpace S) = 1 :=
      hTFAE.mp ⟨hIntClosedS, hUniquePrime⟩
    exact ⟨m, e_p, hd_eq, hCot, hDimQuot, he_p_le⟩

  
  have h_s4 : ∀ (m : ℕ)
      (S : Type u) [CommRing S] [IsDomain S] [IsLocalRing S] [IsNoetherianRing S]
      [Algebra k S] [Module.Finite S Ω[S ⁄ k]]
      (K : Type u) [Field K] [Algebra k K] [Algebra S K] [IsScalarTower k S K] [IsFractionRing S K]
      [Module.Finite (IsLocalRing.ResidueField S) Ω[IsLocalRing.ResidueField S ⁄ k]],
      Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S) = 1 →
      Module.finrank K Ω[K ⁄ k] = m + 1 →
      Module.finrank (IsLocalRing.ResidueField S) Ω[IsLocalRing.ResidueField S ⁄ k] ≤ m →
      Module.finrank (IsLocalRing.ResidueField S) Ω[IsLocalRing.ResidueField S ⁄ k] = m := by
    clear! d A
    intro m S _ _ _ _ _ _ K _ _ _ _ _ _ hCotS hDiffK hDiffResLE
    let m_S := IsLocalRing.maximalIdeal S
    let u := Module.finrank (IsLocalRing.ResidueField S)
      (TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k])
    have hSurj_res : Function.Surjective (algebraMap S (IsLocalRing.ResidueField S)) :=
      IsLocalRing.residue_surjective
    have hKer_res : RingHom.ker (algebraMap S (IsLocalRing.ResidueField S)) = m_S :=
      IsLocalRing.ker_residue
    let M_S : TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k] →ₗ[IsLocalRing.ResidueField S]
        Ω[IsLocalRing.ResidueField S ⁄ k] :=
      KaehlerDifferential.mapBaseChange k S (IsLocalRing.ResidueField S)
    have hSurj_MS : Function.Surjective M_S :=
      KaehlerDifferential.mapBaseChange_surjective k S (IsLocalRing.ResidueField S) hSurj_res
    have hRange_MS : M_S.range = ⊤ := LinearMap.range_eq_top.mpr hSurj_MS
    have hRN_MS : Module.finrank (IsLocalRing.ResidueField S) ↥M_S.range +
        Module.finrank (IsLocalRing.ResidueField S) ↥M_S.ker = u :=
      LinearMap.finrank_range_add_finrank_ker M_S
    rw [hRange_MS, finrank_top] at hRN_MS
    let bCot := Module.finBasis (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S)
    let i₀ : Fin (Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S)) :=
      ⟨0, by omega⟩
    let v₀ : IsLocalRing.CotangentSpace S := bCot i₀
    have hv₀_span : ∀ v : IsLocalRing.CotangentSpace S,
        ∃ c : IsLocalRing.ResidueField S, v = c • v₀ := by
      intro v
      refine ⟨bCot.repr v i₀, ?_⟩
      conv_lhs => rw [← bCot.sum_repr v]
      have hUniv : (Finset.univ : Finset (Fin (Module.finrank (IsLocalRing.ResidueField S)
          (IsLocalRing.CotangentSpace S)))) = {i₀} := by
        ext j
        simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
        ext
        change j.1 = 0
        omega
      rw [hUniv, Finset.sum_singleton]
    obtain ⟨π₀, hπ₀⟩ := Ideal.toCotangent_surjective m_S v₀
    let ω₀ : TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k] :=
      (1 : IsLocalRing.ResidueField S) ⊗ₜ[S] KaehlerDifferential.D k S π₀.1
    have hm_zero_κ : ∀ a ∈ m_S, algebraMap S (IsLocalRing.ResidueField S) a = 0 := by
      intro a ha
      rwa [← RingHom.mem_ker, hKer_res]
    have hm2_zero : ∀ y ∈ m_S ^ 2,
        ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] KaehlerDifferential.D k S y :
          TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k]) = 0 := by
      intro y hy
      rw [pow_two] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz, TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
        have ha0 : a • (1 : IsLocalRing.ResidueField S) = 0 := by
          rw [Algebra.smul_def, mul_one, hm_zero_κ a ha]
        have hb0 : b • (1 : IsLocalRing.ResidueField S) = 0 := by
          rw [Algebra.smul_def, mul_one, hm_zero_κ b hb]
        rw [ha0, hb0, TensorProduct.zero_tmul, TensorProduct.zero_tmul, add_zero]
      · intro x z hx hz
        rw [map_add, TensorProduct.tmul_add, hx, hz, add_zero]
    let φ_ω : IsLocalRing.ResidueField S →ₗ[IsLocalRing.ResidueField S]
        TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k] :=
      LinearMap.toSpanSingleton (IsLocalRing.ResidueField S) _ ω₀
    have hKer_le_range : M_S.ker ≤ φ_ω.range := by
      intro w hw
      rw [LinearMap.mem_ker] at hw
      obtain ⟨u_cot, rfl⟩ :=
        (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k S
          (IsLocalRing.ResidueField S) hSurj_res w).mp hw
      obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ u_cot
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
      have hx_m : x.1 ∈ m_S := hKer_res ▸ x.2
      obtain ⟨c, hc⟩ := hv₀_span (m_S.toCotangent ⟨x.1, hx_m⟩)
      obtain ⟨s, rfl⟩ := hSurj_res c
      have hCotEq : m_S.toCotangent ⟨x.1, hx_m⟩ = m_S.toCotangent (s • π₀) := by
        rw [hc, ← hπ₀, IsScalarTower.algebraMap_smul, map_smul]
      have hy_mem : x.1 - (s • π₀).1 ∈ m_S ^ 2 := (Ideal.toCotangent_eq m_S).mp hCotEq
      have hx_decomp : x.1 = s * π₀.1 + (x.1 - (s • π₀).1) := by
        change x.1 = s * π₀.1 + (x.1 - s * π₀.1)
        ring
      rw [hx_decomp, map_add, TensorProduct.tmul_add, hm2_zero _ hy_mem, add_zero,
        Derivation.leibniz, TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
      have hπ0 : π₀.1 • (1 : IsLocalRing.ResidueField S) = 0 := by
        rw [Algebra.smul_def, mul_one, hm_zero_κ π₀.1 π₀.2]
      rw [hπ0, TensorProduct.zero_tmul, add_zero]
      refine ⟨algebraMap S (IsLocalRing.ResidueField S) s, ?_⟩
      simp only [φ_ω, LinearMap.toSpanSingleton_apply, ω₀, TensorProduct.smul_tmul',
        smul_eq_mul, mul_one]
      rw [Algebra.smul_def, mul_one]
    have hRN_φω : Module.finrank (IsLocalRing.ResidueField S) ↥φ_ω.range +
        Module.finrank (IsLocalRing.ResidueField S) ↥φ_ω.ker =
        Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.ResidueField S) :=
      LinearMap.finrank_range_add_finrank_ker φ_ω
    rw [Module.finrank_self] at hRN_φω
    have hKer_finrank : Module.finrank (IsLocalRing.ResidueField S) ↥M_S.ker ≤ 1 := by
      have hle := Submodule.finrank_mono hKer_le_range
      omega
    have hu_le : u ≤ Module.finrank (IsLocalRing.ResidueField S) Ω[IsLocalRing.ResidueField S ⁄ k] + 1 := by
      omega
    have hPure_TS : ∀ z : TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k],
        ∃ η : Ω[S ⁄ k],
          ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] η :
            TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k]) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, by simp⟩
      | tmul c η =>
        obtain ⟨s, rfl⟩ := hSurj_res c
        refine ⟨s • η, ?_⟩
        rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨η₁, h₁⟩ := ih₁
        obtain ⟨η₂, h₂⟩ := ih₂
        exact ⟨η₁ + η₂, by rw [TensorProduct.tmul_add, h₁, h₂]⟩
    let bT : Module.Basis (Fin u) (IsLocalRing.ResidueField S)
        (TensorProduct S (IsLocalRing.ResidueField S) Ω[S ⁄ k]) :=
      Module.finBasis (IsLocalRing.ResidueField S) _
    let ω_tilde : Fin u → Ω[S ⁄ k] := fun i => Classical.choose (hPure_TS (bT i))
    have hω_tilde : ∀ i : Fin u, ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] ω_tilde i : _) = bT i :=
      fun i => Classical.choose_spec (hPure_TS (bT i))
    let W : Submodule S Ω[S ⁄ k] := Submodule.span S (Set.range ω_tilde)
    have hW_top : W = ⊤ := by
      rw [← IsLocalRing.map_mkQ_eq_top, eq_top_iff]
      intro q _
      obtain ⟨η, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      let s_coeff : Fin u → S := fun i =>
        Classical.choose (hSurj_res (bT.repr ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] η) i))
      have hs_coeff : ∀ i : Fin u,
          algebraMap S (IsLocalRing.ResidueField S) (s_coeff i) =
            bT.repr ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] η) i :=
        fun i => Classical.choose_spec (hSurj_res (bT.repr ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] η) i))
      let w_η : Ω[S ⁄ k] := ∑ i : Fin u, s_coeff i • ω_tilde i
      have hw_mem : w_η ∈ W :=
        sum_mem fun i _ => Submodule.smul_mem W (s_coeff i) (Submodule.subset_span ⟨i, rfl⟩)
      have hTensorEq : ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] w_η : _) =
          (1 : IsLocalRing.ResidueField S) ⊗ₜ[S] η := by
        simp only [w_η, TensorProduct.tmul_sum]
        conv_rhs => rw [← bT.sum_repr ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] η)]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, hs_coeff i, ← hω_tilde i,
          TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have hZeroTensor : ((Ideal.Quotient.mk m_S 1) ⊗ₜ[S] (w_η - η) : TensorProduct S (S ⧸ m_S) Ω[S ⁄ k]) = 0 := by
        change ((1 : IsLocalRing.ResidueField S) ⊗ₜ[S] (w_η - η) : _) = 0
        rw [TensorProduct.tmul_sub, hTensorEq, sub_self]
      have hQuotZero :=
        congrArg (TensorProduct.quotTensorEquivQuotSMul Ω[S ⁄ k] m_S) hZeroTensor
      rw [map_zero, TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul] at hQuotZero
      refine ⟨w_η, hw_mem, ?_⟩
      change Submodule.Quotient.mk w_η = Submodule.Quotient.mk η
      rwa [← sub_eq_zero, ← Submodule.Quotient.mk_sub]
    let μ : Ω[S ⁄ k] →ₗ[S] Ω[K ⁄ k] := KaehlerDifferential.map k k S K
    have _ : IsLocalizedModule (nonZeroDivisors S) μ :=
      KaehlerDifferential.isLocalizedModule_map k S K (nonZeroDivisors S)
    let Φ_K : (Fin u → K) →ₗ[K] Ω[K ⁄ k] :=
      { toFun := fun f => ∑ i : Fin u, f i • μ (ω_tilde i)
        map_add' := fun f g => by simp [Finset.sum_add_distrib, add_smul]
        map_smul' := fun c f => by simp [Finset.smul_sum, mul_smul] }
    have hMapW : ∀ z ∈ W, μ z ∈ Φ_K.range := by
      intro z hz
      refine Submodule.span_induction ?_ (by simp) ?_ ?_ hz
      · rintro _ ⟨i, rfl⟩
        refine ⟨Pi.single i 1, ?_⟩
        simp [Φ_K, Pi.single_apply]
      · intro x y _ _ hx hy
        rw [map_add]
        exact add_mem hx hy
      · intro s x _ hx
        rw [LinearMap.map_smul, ← IsScalarTower.algebraMap_smul K s (μ x)]
        exact Submodule.smul_mem _ _ hx
    have hRangeK_top : Φ_K.range = ⊤ := by
      rw [eq_top_iff]
      intro ξ _
      obtain ⟨⟨η, t⟩, ht_eq⟩ := IsLocalizedModule.surj (nonZeroDivisors S) μ ξ
      have ht_ne0 : t.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp t.2
      have htK_ne0 : algebraMap S K t.1 ≠ 0 :=
        (map_ne_zero_iff (algebraMap S K) (IsFractionRing.injective S K)).mpr ht_ne0
      have hsmul_eq : (algebraMap S K t.1) • ξ = μ η := by
        simpa [Submonoid.smul_def, IsScalarTower.algebraMap_smul] using ht_eq
      have hξη : ξ = (algebraMap S K t.1)⁻¹ • μ η := by
        rw [← hsmul_eq, inv_smul_smul₀ htK_ne0]
      rw [hξη]
      exact Submodule.smul_mem _ _ (hMapW η (hW_top ▸ Submodule.mem_top))
    have hRN_ΦK : Module.finrank K ↥Φ_K.range + Module.finrank K ↥Φ_K.ker =
        Module.finrank K (Fin u → K) :=
      LinearMap.finrank_range_add_finrank_ker Φ_K
    rw [hRangeK_top, finrank_top, hDiffK, Module.finrank_fin_fun] at hRN_ΦK
    omega

  
  have h_s5 : ∀ (m : ℕ)
      (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [Algebra k A₀] [Algebra.FiniteType k A₀]
      (p₀ : Ideal A₀) [p₀.IsPrime],
      Module.finrank p₀.ResidueField (IsLocalRing.CotangentSpace (Localization.AtPrime p₀)) = 1 →
      Module.finrank p₀.ResidueField Ω[p₀.ResidueField ⁄ k] = m →
      Algebra.IsSmoothAt k p₀ := by
    clear! d A
    intro m A _ _ _ _ p _ hCotS hDiffRes
    have h_local_smooth : ∀ (r : ℕ) (P S : Type u)
        [CommRing P] [IsLocalRing P] [IsNoetherianRing P] [Algebra k P]
        (_hSmP : Algebra.FormallySmooth k P) [Module.Free P Ω[P ⁄ k]] [Module.Finite P Ω[P ⁄ k]]
        [CommRing S] [IsDomain S] [IsLocalRing S] [IsNoetherianRing S]
        [Algebra k S] [Algebra P S] [IsScalarTower k P S]
        [Module.Finite (IsLocalRing.ResidueField S) Ω[IsLocalRing.ResidueField S ⁄ k]]
        (_hSmRes : Algebra.FormallySmooth k (IsLocalRing.ResidueField S)),
        Function.Surjective (algebraMap P S) →
        Module.finrank P Ω[P ⁄ k] = r →
        Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S) = 1 →
        Module.finrank (IsLocalRing.ResidueField S) Ω[IsLocalRing.ResidueField S ⁄ k] = m →
        True ∧ Algebra.FormallySmooth k S := by
      clear! A
      intro r P S _ _ _ _ hSmP _ _ _ _ _ _ _ _ _ _ hSmRes hSurj_φ hFinrank_P hCotS hDiffRes
      refine ⟨trivial, ?_⟩
      have _ : Algebra.FormallySmooth k P := hSmP
      have _ : Algebra.FormallySmooth k (IsLocalRing.ResidueField S) := hSmRes
      have _ : IsScalarTower k P (IsLocalRing.ResidueField S) := IsScalarTower.of_algebraMap_eq' <| by
        ext c
        calc algebraMap k (IsLocalRing.ResidueField S) c
            = algebraMap S (IsLocalRing.ResidueField S) (algebraMap k S c) :=
                IsScalarTower.algebraMap_apply k S (IsLocalRing.ResidueField S) c
          _ = algebraMap S (IsLocalRing.ResidueField S) (algebraMap P S (algebraMap k P c)) := by
                rw [IsScalarTower.algebraMap_apply k P S c]
          _ = algebraMap P (IsLocalRing.ResidueField S) (algebraMap k P c) :=
                (IsScalarTower.algebraMap_apply P S (IsLocalRing.ResidueField S) (algebraMap k P c)).symm
      have hSurj_Pκ : Function.Surjective (algebraMap P (IsLocalRing.ResidueField S)) := by
        rw [IsScalarTower.algebraMap_eq P S (IsLocalRing.ResidueField S)]
        exact IsLocalRing.residue_surjective.comp hSurj_φ
      let m_P := IsLocalRing.maximalIdeal P
      let m_S := IsLocalRing.maximalIdeal S
      let I : Ideal P := RingHom.ker (algebraMap P S)
      let J_P : Ideal P := RingHom.ker (algebraMap P (IsLocalRing.ResidueField S))
      have hJP_eq : J_P = m_P :=
        IsLocalRing.ker_eq_maximalIdeal (algebraMap P (IsLocalRing.ResidueField S)) hSurj_Pκ
      have hI_le_JP : I ≤ J_P := by
        intro x hx
        rw [RingHom.mem_ker, IsScalarTower.algebraMap_apply P S (IsLocalRing.ResidueField S),
          RingHom.mem_ker.mp hx, map_zero]
      have hFG_I : I.FG := IsNoetherian.noetherian I
      have hFG_JP : J_P.FG := IsNoetherian.noetherian J_P
      have hFinrank_TP : Module.finrank (IsLocalRing.ResidueField S)
          (TensorProduct P (IsLocalRing.ResidueField S) Ω[P ⁄ k]) = r := by
        let bP := Module.finBasis P Ω[P ⁄ k]
        rw [Module.finrank_eq_card_basis (bP.baseChange (IsLocalRing.ResidueField S)),
          Fintype.card_fin, hFinrank_P]
      have _ : IsScalarTower P (IsLocalRing.ResidueField S) (IsLocalRing.ResidueField S) :=
        IsScalarTower.right
      let L_κ : TensorProduct P (IsLocalRing.ResidueField S) ↥J_P →ₗ[IsLocalRing.ResidueField S]
          TensorProduct P (IsLocalRing.ResidueField S) Ω[P ⁄ k] :=
        KaehlerDifferential.cotangentComplexBaseChange k (IsLocalRing.ResidueField S) P
          (IsLocalRing.ResidueField S)
      have hmκ_le : IsLocalRing.maximalIdeal (IsLocalRing.ResidueField S) ≤
          RingHom.ker (algebraMap (IsLocalRing.ResidueField S) (IsLocalRing.ResidueField S)) := by
        rw [IsLocalRing.isField_iff_maximalIdeal_eq.mp (Field.toIsField (IsLocalRing.ResidueField S))]
        exact bot_le
      have hInj_Lκ : Function.Injective L_κ :=
        (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange
          (R := k) (S := IsLocalRing.ResidueField S) P (IsLocalRing.ResidueField S)
          hSurj_Pκ hFG_JP hmκ_le).mp inferInstance
      let M_κ : TensorProduct P (IsLocalRing.ResidueField S) Ω[P ⁄ k] →ₗ[IsLocalRing.ResidueField S]
          Ω[IsLocalRing.ResidueField S ⁄ k] :=
        KaehlerDifferential.mapBaseChange k P (IsLocalRing.ResidueField S)
      have hSurj_Mκ : Function.Surjective M_κ :=
        KaehlerDifferential.mapBaseChange_surjective k P (IsLocalRing.ResidueField S) hSurj_Pκ
      have hPure_VP : ∀ v : TensorProduct P (IsLocalRing.ResidueField S) ↥J_P,
          ∃ b : ↥J_P,
            ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] b :
              TensorProduct P (IsLocalRing.ResidueField S) ↥J_P) = v := by
        intro v
        induction v using TensorProduct.induction_on with
        | zero => exact ⟨0, by simp⟩
        | tmul a b =>
          obtain ⟨p₀, rfl⟩ := hSurj_Pκ a
          exact ⟨p₀ • b, by rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]⟩
        | add v₁ v₂ ih₁ ih₂ =>
          obtain ⟨b₁, h₁⟩ := ih₁
          obtain ⟨b₂, h₂⟩ := ih₂
          exact ⟨b₁ + b₂, by rw [TensorProduct.tmul_add, h₁, h₂]⟩
      have hRange_Lκ : L_κ.range = M_κ.ker := by
        ext w
        rw [LinearMap.mem_range, LinearMap.mem_ker,
          KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k P
            (IsLocalRing.ResidueField S) hSurj_Pκ]
        constructor
        · rintro ⟨v, rfl⟩
          obtain ⟨b, rfl⟩ := hPure_VP v
          refine ⟨J_P.toCotangent b, ?_⟩
          rw [KaehlerDifferential.kerCotangentToTensor_toCotangent,
            KaehlerDifferential.cotangentComplexBaseChange_tmul, one_smul,
            KaehlerDifferential.kerToTensor_apply]
        · rintro ⟨u_cot, rfl⟩
          obtain ⟨b, rfl⟩ := Ideal.toCotangent_surjective J_P u_cot
          refine ⟨(1 : IsLocalRing.ResidueField S) ⊗ₜ[P] b, ?_⟩
          rw [KaehlerDifferential.kerCotangentToTensor_toCotangent,
            KaehlerDifferential.cotangentComplexBaseChange_tmul, one_smul,
            KaehlerDifferential.kerToTensor_apply]
      have hRN_Mκ : Module.finrank (IsLocalRing.ResidueField S) ↥M_κ.range +
          Module.finrank (IsLocalRing.ResidueField S) ↥M_κ.ker =
          Module.finrank (IsLocalRing.ResidueField S)
            (TensorProduct P (IsLocalRing.ResidueField S) Ω[P ⁄ k]) :=
        LinearMap.finrank_range_add_finrank_ker M_κ
      rw [LinearMap.range_eq_top.mpr hSurj_Mκ, finrank_top, hDiffRes, ← hRange_Lκ,
        LinearMap.finrank_range_of_inj hInj_Lκ, hFinrank_TP] at hRN_Mκ
      have hm_le_r : m ≤ r := by omega
      have hFinrank_VP : Module.finrank (IsLocalRing.ResidueField S)
          (TensorProduct P (IsLocalRing.ResidueField S) ↥J_P) = r - m := by
        omega
      have hx_mem_mS : ∀ x : ↥J_P, algebraMap P S x.1 ∈ m_S := by
        intro x
        have hker : RingHom.ker (IsLocalRing.residue S) = m_S := IsLocalRing.ker_residue
        rw [← hker, RingHom.mem_ker]
        exact (IsScalarTower.algebraMap_apply P S (IsLocalRing.ResidueField S) x.1).symm.trans x.2
      have _ : IsScalarTower P (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S) :=
        ⟨fun p₀ a v => by
          rw [← IsScalarTower.algebraMap_smul S p₀ (a • v),
            ← IsScalarTower.algebraMap_smul S p₀ a, smul_assoc]⟩
      let q_PS : ↥J_P →ₗ[P] IsLocalRing.CotangentSpace S :=
        { toFun := fun x => m_S.toCotangent ⟨algebraMap P S x.1, hx_mem_mS x⟩
          map_add' := fun x y => by
            rw [← m_S.toCotangent.map_add]
            congr 1
            ext
            exact map_add (algebraMap P S) x.1 y.1
          map_smul' := fun p₀ x => by
            conv_rhs =>
              rw [RingHom.id_apply, ← IsScalarTower.algebraMap_smul S p₀, ← m_S.toCotangent.map_smul]
            congr 1
            ext
            exact map_mul (algebraMap P S) p₀ x.1 }
      let Φ_PS : TensorProduct P (IsLocalRing.ResidueField S) ↥J_P →ₗ[IsLocalRing.ResidueField S]
          IsLocalRing.CotangentSpace S :=
        LinearMap.liftBaseChange (IsLocalRing.ResidueField S) q_PS
      have hΦ_tmul : ∀ (a : IsLocalRing.ResidueField S) (x : ↥J_P), Φ_PS (a ⊗ₜ[P] x) = a • q_PS x :=
        LinearMap.liftBaseChange_tmul (IsLocalRing.ResidueField S) q_PS
      have hSurj_ΦPS : Function.Surjective Φ_PS := by
        intro v
        obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective m_S v
        obtain ⟨x, hx⟩ := hSurj_φ y.1
        have hx_JP : x ∈ J_P := by
          rw [RingHom.mem_ker, IsScalarTower.algebraMap_apply P S (IsLocalRing.ResidueField S)]
          change IsLocalRing.residue S (algebraMap P S x) = 0
          rw [hx]
          exact RingHom.mem_ker.mp ((IsLocalRing.ker_residue (R := S)).symm ▸ y.2)
        refine ⟨(1 : IsLocalRing.ResidueField S) ⊗ₜ[P] ⟨x, hx_JP⟩, ?_⟩
        rw [hΦ_tmul, one_smul]
        change m_S.toCotangent ⟨algebraMap P S x, _⟩ = m_S.toCotangent y
        congr 1
        ext
        exact hx
      let ι_IJ : ↥I →ₗ[P] ↥J_P := Submodule.inclusion hI_le_JP
      let ψ_I : TensorProduct P (IsLocalRing.ResidueField S) ↥I →ₗ[IsLocalRing.ResidueField S]
          TensorProduct P (IsLocalRing.ResidueField S) ↥J_P :=
        LinearMap.baseChange (IsLocalRing.ResidueField S) ι_IJ
      have hMap_JP : Ideal.map (algebraMap P S) J_P = m_S := by
        refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun x hx => hx_mem_mS ⟨x, hx⟩) ?_
        intro s hs
        obtain ⟨x, rfl⟩ := hSurj_φ s
        have hx_JP : x ∈ J_P := by
          rw [RingHom.mem_ker, IsScalarTower.algebraMap_apply P S (IsLocalRing.ResidueField S)]
          change IsLocalRing.residue S (algebraMap P S x) = 0
          exact RingHom.mem_ker.mp ((IsLocalRing.ker_residue (R := S)).symm ▸ hs)
        exact Ideal.mem_map_of_mem (algebraMap P S) hx_JP
      have hSurj_map_ideal : ∀ K : Ideal P, ∀ s ∈ Ideal.map (algebraMap P S) K,
