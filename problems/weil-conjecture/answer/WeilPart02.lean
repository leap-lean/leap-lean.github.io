      hMod4 hd s ↑(X.left.presheaf.obj (Opposite.op V))
        ↑(X.left.presheaf.obj (Opposite.op V')) φ hSurj q hKer f_lift f_new_lift γ₀ hDet_q J rfl
    have hSpec'_C : V'.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ'.comp MvPolynomial.C)) =
