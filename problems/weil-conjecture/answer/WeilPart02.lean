      let _ : Algebra K₀ (A₀ ℓ) := instAlgK₀A ℓ
      exact (Algebra.Etale.iff_exists_algEquiv_prod K₀ (A₀ ℓ)).mp (hEt_A₀ ℓ)
    choose I_idx hFin_I E_fld instField_E instAlg_E e_prod hFinSep_E using hProd
    let _ : ∀ (ℓ : Fin s), Fintype (I_idx ℓ) := fun ℓ => Fintype.ofFinite (I_idx ℓ)
    let _ : ∀ (ℓ : Fin s) (i : I_idx ℓ), Field (E_fld ℓ i) := instField_E
    let _ : ∀ (ℓ : Fin s) (i : I_idx ℓ), Algebra K₀ (E_fld ℓ i) := instAlg_E
    have _ : ∀ (ℓ : Fin s) (i : I_idx ℓ), FiniteDimensional K₀ (E_fld ℓ i) :=
