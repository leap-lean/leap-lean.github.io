    have hFT_ek : ek.hom.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _ ek.commRingCatIsoToRingEquiv.surjective
    have hOpenPkg : ∀ (U : V₁.left.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U) [Nonempty ↥U.toScheme],
        ∃ (sU : ℕ) (gU : @AlgHom k (MvPolynomial (Fin sU) k) ↑(V₁.left.presheaf.obj (Opposite.op U))
            _ _ _ _ (κ U).hom.toAlgebra),
