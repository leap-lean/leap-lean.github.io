            have h0 := congrArg φ_0 hx_ann
            rw [map_zero, map_mul, Polynomial.eval₂_eq_sum_range, map_sum] at h0
            refine Eq.trans ?_ h0
            congr 1
            rw [Polynomial.aeval_def, Polynomial.eval₂_map, Polynomial.eval₂_eq_sum_range]
            refine Finset.sum_congr rfl (fun d _ => ?_)
            rw [map_mul, map_pow]
            congr 1
            change algebraMap L (F_j j) (algebraMap K₀ L ((q_min ℓ i).coeff d)) =
              φ_0 (algebraMap K₀ _ ((q_min ℓ i).coeff d))
            symm
            change proj_j ((1 : L) ⊗ₜ[K₀] ((e_prod ℓ).symm (algebraMap K₀ _ ((q_min ℓ i).coeff d)))) = _
            rw [AlgEquiv.commutes]
            have h_tm : (1 : L) ⊗ₜ[K₀] (algebraMap K₀ (A₀ ℓ) ((q_min ℓ i).coeff d)) =
