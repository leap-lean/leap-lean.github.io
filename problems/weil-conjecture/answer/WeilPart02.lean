        exact ⟨a, u, IsLocalRing.notMem_maximalIdeal.mp hu_not_max, rfl⟩
      have _ : NoZeroDivisors (Localization.AtPrime qI) :=
        { eq_zero_or_eq_zero_of_mul_eq_zero := by
            intro x y hxy
            by_contra h_both
            rw [not_or] at h_both
            obtain ⟨a, u, hu, rfl⟩ := hFactor x h_both.1
            obtain ⟨b, v, hv, rfl⟩ := hFactor y h_both.2
            have h_prod : π_B ^ (a + b) * (u * v) = 0 := by
              calc π_B ^ (a + b) * (u * v) = (π_B ^ a * u) * (π_B ^ b * v) := by
                    rw [pow_add]
                    ring
                _ = 0 := hxy
            have huv : u * v = 0 := hRegPow (a + b) (u * v) h_prod
            exact not_isUnit_zero (huv ▸ hu.mul hv) }
      exact NoZeroDivisors.to_isDomain (Localization.AtPrime qI)

  have h_s2 : ∀ (C : Type u) [CommRing C] [IsNoetherianRing C],
      (∀ (qI : Ideal C) [qI.IsPrime], IsDomain (Localization.AtPrime qI)) →
      ∀ (q₀ : Ideal C) [q₀.IsPrime],
      ∃ b : C, b ∉ q₀ ∧ IsDomain (Localization.Away b) := by
    intro C _ _ hDom q₀ _
    have h_le_comap_bot : ∀ (qI : Ideal C) [qI.IsPrime] (p : Ideal C),
        p ∈ minimalPrimes C → p ≤ qI →
        p ≤ Ideal.comap (algebraMap C (Localization.AtPrime qI)) ⊥ := by
      intro qI _ p hp hpq
      have _ : IsDomain (Localization.AtPrime qI) := hDom qI
      have hP_prime : (Ideal.comap (algebraMap C (Localization.AtPrime qI)) ⊥).IsPrime :=
        Ideal.IsPrime.comap (algebraMap C (Localization.AtPrime qI))
      have hP_le_p : Ideal.comap (algebraMap C (Localization.AtPrime qI)) ⊥ ≤ p := by
        intro a ha
        rw [Ideal.mem_comap, Submodule.mem_bot] at ha
        obtain ⟨s, hs⟩ :=
          (IsLocalization.map_eq_zero_iff qI.primeCompl (Localization.AtPrime qI) a).mp ha
        have hs_not_p : s.1 ∉ p := fun hsp => s.2 (hpq hsp)
        exact (hp.1.1.mem_or_mem (hs.symm ▸ p.zero_mem)).resolve_left hs_not_p
      exact hp.2 ⟨hP_prime, bot_le⟩ hP_le_p
    obtain ⟨p₀, hp₀_min, hp₀_q₀⟩ := @Ideal.exists_minimalPrimes_le C _ ⊥ q₀ _ bot_le
    have hp₀_min' : p₀ ∈ minimalPrimes C := hp₀_min
    let S_other : Set (Ideal C) := minimalPrimes C \ {p₀}
    have hFin : S_other.Finite := (minimalPrimes.finite_of_isNoetherianRing C).sdiff
    let _ : Fintype ↥S_other := hFin.fintype
    have h_sep : ∀ p : ↥S_other, ∃ c : C, c ∈ p.1 ∧ c ∉ q₀ := by
      intro p
      have h_not_le : ¬ (p.1 ≤ q₀) := by
        intro hp_le
        have h1 := h_le_comap_bot q₀ p.1 p.2.1 hp_le
        have h2 := h_le_comap_bot q₀ p₀ hp₀_min' hp₀_q₀
        have _ : IsDomain (Localization.AtPrime q₀) := hDom q₀
        have hP_le_p₀ : Ideal.comap (algebraMap C (Localization.AtPrime q₀)) ⊥ ≤ p₀ := by
          intro a ha
          rw [Ideal.mem_comap, Submodule.mem_bot] at ha
          obtain ⟨s, hs⟩ :=
            (IsLocalization.map_eq_zero_iff q₀.primeCompl (Localization.AtPrime q₀) a).mp ha
          have hs_not_p₀ : s.1 ∉ p₀ := fun hsp => s.2 (hp₀_q₀ hsp)
          exact (hp₀_min'.1.1.mem_or_mem (hs.symm ▸ p₀.zero_mem)).resolve_left hs_not_p₀
        have hP_le_p : Ideal.comap (algebraMap C (Localization.AtPrime q₀)) ⊥ ≤ p.1 := by
          intro a ha
          rw [Ideal.mem_comap, Submodule.mem_bot] at ha
          obtain ⟨s, hs⟩ :=
            (IsLocalization.map_eq_zero_iff q₀.primeCompl (Localization.AtPrime q₀) a).mp ha
          have hs_not_p : s.1 ∉ p.1 := fun hsp => s.2 (hp_le hsp)
          exact (p.2.1.1.1.mem_or_mem (hs.symm ▸ p.1.zero_mem)).resolve_left hs_not_p
        have heq : p.1 = p₀ := le_antisymm (h1.trans hP_le_p₀) (h2.trans hP_le_p)
        exact p.2.2 heq
      exact Set.not_subset.mp h_not_le
    choose c hc_mem hc_not using h_sep
    let b : C := ∏ p : ↥S_other, c p
    have hb_not : b ∉ q₀ :=
      Submonoid.prod_mem q₀.primeCompl (fun p _ => hc_not p)
    have h_ann : ∀ x ∈ p₀, x * b = 0 := by
      intro x hx
      by_contra hxb
      let Ann : Ideal C :=
        { carrier := {a : C | a * (x * b) = 0}
          zero_mem' := zero_mul _
          add_mem' := fun ha₁ ha₂ => by dsimp at *; rw [add_mul, ha₁, ha₂, add_zero]
          smul_mem' := fun r a ha => by dsimp at *; rw [mul_assoc, ha, mul_zero] }
      have hAnn_ne_top : Ann ≠ ⊤ := by
        intro htop
        have h1 : (1 : C) ∈ Ann := htop ▸ Submodule.mem_top
        change 1 * (x * b) = 0 at h1
        rw [one_mul] at h1
        exact hxb h1
      obtain ⟨𝔪, h𝔪_max, hAnn_le⟩ := Ideal.exists_le_maximal Ann hAnn_ne_top
      have _ : 𝔪.IsPrime := h𝔪_max.isPrime
      obtain ⟨p, hp_min, hp_m⟩ := @Ideal.exists_minimalPrimes_le C _ ⊥ 𝔪 _ bot_le
      have hp_min' : p ∈ minimalPrimes C := hp_min
      have hxb_p : x * b ∈ p := by
        by_cases hp_eq : p = p₀
        · rw [hp_eq]
          exact p₀.mul_mem_right b hx
        · let p' : ↥S_other := ⟨p, hp_min', hp_eq⟩
          have hdvd : c p' ∣ b := Finset.dvd_prod_of_mem c (Finset.mem_univ p')
          rcases hdvd with ⟨d, hd⟩
          have hb_p : b ∈ p := hd ▸ p.mul_mem_right d (hc_mem p')
          exact p.mul_mem_left x hb_p
      have hxb_ker : x * b ∈ Ideal.comap (algebraMap C (Localization.AtPrime 𝔪)) ⊥ :=
        h_le_comap_bot 𝔪 p hp_min' hp_m hxb_p
      rw [Ideal.mem_comap, Submodule.mem_bot] at hxb_ker
      obtain ⟨s, hs⟩ :=
        (IsLocalization.map_eq_zero_iff 𝔪.primeCompl (Localization.AtPrime 𝔪) (x * b)).mp hxb_ker
      exact s.2 (hAnn_le hs)
    let J : Ideal (Localization.Away b) := Ideal.map (algebraMap C (Localization.Away b)) p₀
    have hJ_bot : J = ⊥ := by
      rw [← le_bot_iff, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, Submodule.mem_bot,
        IsLocalization.map_eq_zero_iff (Submonoid.powers b) (Localization.Away b)]
      exact ⟨⟨b, Submonoid.mem_powers b⟩, by change b * x = 0; rw [mul_comm, h_ann x hx]⟩
    have hDisj : Disjoint (Submonoid.powers b : Set C) (p₀ : Set C) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact hb_not (hp₀_q₀ (Ideal.IsPrime.mem_of_pow_mem hp₀_min'.1.1 n hmem))
    have hJ_prime : J.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b)
        p₀ hp₀_min'.1.1 hDisj
    have hBot_prime : (⊥ : Ideal (Localization.Away b)).IsPrime := hJ_bot ▸ hJ_prime
    have _ : Nontrivial (Localization.Away b) :=
      ⟨⟨1, 0, fun h10 => hBot_prime.ne_top
        (top_unique fun x _ => mul_one x ▸ Ideal.mul_mem_left ⊥ x (h10 ▸ Submodule.zero_mem ⊥))⟩⟩
    have _ : NoZeroDivisors (Localization.Away b) :=
      { eq_zero_or_eq_zero_of_mul_eq_zero := fun huv => hBot_prime.mem_or_mem huv }
    exact ⟨b, hb_not, NoZeroDivisors.to_isDomain (Localization.Away b)⟩

  let W₀ : P.Opens := U_aff ⊓ V_sm
  let x₀ : ↥W₀ := ⟨q, ⟨hqU, hqV⟩⟩
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ π) := hSm
  have hSm_W₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₀.ι ≫ π) := by
    have hcomp := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1
      (P.homOfLE (inf_le_right : W₀ ≤ V_sm)) (V_sm.ι ≫ π)
    rw [zero_add, ← CategoryTheory.Category.assoc, P.homOfLE_ι] at hcomp
    exact hcomp
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₀.ι ≫ π) := hSm_W₀
  obtain ⟨U_K, _, V₀, hV₀, hx₀, e₀, hStd⟩ :=
    AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
      (n := 1) (f := W₀.ι ≫ π) x₀
  have hUK_top : U_K = ⊤ := by
    apply top_unique
    intro y _
    have hy : y = (W₀.ι ≫ π).base x₀ := Subsingleton.elim _ _
    rw [hy]
    exact e₀ hx₀
  let e_K : K ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_K)) :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).symm ≪≫
      (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.mapIso
        (CategoryTheory.eqToIso hUK_top).op).commRingCatIsoToRingEquiv
  let V : P.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor W₀.ι).obj V₀
  have hV : AlgebraicGeometry.IsAffineOpen V := hV₀.image_of_isOpenImmersion W₀.ι
  have hV_le_W₀ : V ≤ W₀ := (W₀.ι.image_le_opensRange V₀).trans_eq W₀.opensRange_ι
  have hV_aff : V ≤ U_aff := hV_le_W₀.trans inf_le_left
  have hV_sm : V ≤ V_sm := hV_le_W₀.trans inf_le_right
  have hqV' : q ∈ V := ⟨x₀, hx₀, rfl⟩
  let e_C : ↑(P.presheaf.obj (Opposite.op V)) ≃+* ↑(W₀.toScheme.presheaf.obj (Opposite.op V₀)) :=
    (W₀.ι.appIso V₀).commRingCatIsoToRingEquiv
  obtain ⟨g_et, _, hg_et⟩ := hStd.exists_etale_mvPolynomial
  let e_poly : Polynomial K ≃+*
      MvPolynomial (Fin 1)
        ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_K)) :=
    (MvPolynomial.uniqueAlgEquiv K (Fin 1)).symm.toRingEquiv.trans
      (MvPolynomial.mapEquiv (Fin 1) e_K)
  let h_et : Polynomial K →+* ↑(P.presheaf.obj (Opposite.op V)) :=
    e_C.symm.toRingHom.comp (g_et.comp e_poly.toRingHom)
  have hh_et : h_et.Etale :=
    RingHom.Etale.respectsIso.left _ e_C.symm
      (RingHom.Etale.respectsIso.right g_et e_poly hg_et)
  have hDom_V : ∀ (qI : Ideal ↑(P.presheaf.obj (Opposite.op V))) [qI.IsPrime],
      IsDomain (Localization.AtPrime qI) :=
    h_s1 _ h_et hh_et
  have _ : IsNoetherianRing ↑(P.presheaf.obj (Opposite.op V)) := by
    let _ : Algebra (Polynomial K) ↑(P.presheaf.obj (Opposite.op V)) := h_et.toAlgebra
    have h_alg_eq : algebraMap (Polynomial K) ↑(P.presheaf.obj (Opposite.op V)) = h_et := rfl
    have _ : Algebra.Etale (Polynomial K) ↑(P.presheaf.obj (Opposite.op V)) := by
      rw [← RingHom.etale_algebraMap, h_alg_eq]
      exact hh_et
    exact Algebra.FiniteType.isNoetherianRing (Polynomial K) ↑(P.presheaf.obj (Opposite.op V))
  obtain ⟨b, hb_mem, hb_dom⟩ :=
    h_s2 _ hDom_V (hV.primeIdealOf ⟨q, hqV'⟩).asIdeal

  have hq_bo_b : q ∈ P.basicOpen b := by
    have hp_bo : hV.primeIdealOf ⟨q, hqV'⟩ ∈ PrimeSpectrum.basicOpen b := hb_mem
    rw [← hV.fromSpec_preimage_basicOpen b] at hp_bo
    change hV.fromSpec.base (hV.primeIdealOf ⟨q, hqV'⟩) ∈ P.basicOpen b at hp_bo
    rw [hV.fromSpec_primeIdealOf ⟨q, hqV'⟩] at hp_bo
    exact hp_bo
  have _ : IsLocalization.Away b ↑(P.presheaf.obj (Opposite.op (P.basicOpen b))) :=
    hV.isLocalization_basicOpen b
  let e_b := IsLocalization.algEquiv (Submonoid.powers b)
    ↑(P.presheaf.obj (Opposite.op (P.basicOpen b))) (Localization.Away b)
  have _ : IsDomain ↑(P.presheaf.obj (Opposite.op (P.basicOpen b))) :=
    Function.Injective.isDomain e_b.toRingHom e_b.injective
  obtain ⟨f, hf_le_b, hq_bo_f⟩ := hAff.exists_basicOpen_le (⟨q, hq_bo_b⟩ : ↥(P.basicOpen b)) hqU
  have hf_le_sm : P.basicOpen f ≤ V_sm :=
    hf_le_b.trans ((P.basicOpen_le b).trans hV_sm)
  have hWb_le_U : P.basicOpen b ≤ U_aff :=
    (P.basicOpen_le b).trans hV_aff
  let f' : ↑(P.presheaf.obj (Opposite.op (P.basicOpen b))) :=
    (P.presheaf.map (CategoryTheory.homOfLE hWb_le_U).op).hom f
  have h_bo_eq : P.basicOpen f' = P.basicOpen f := by
    rw [P.basicOpen_res f (CategoryTheory.homOfLE hWb_le_U).op]
    exact inf_eq_right.mpr hf_le_b
  have hf'_ne : f' ≠ 0 := by
    intro hf0
    have hq0 : q ∈ P.basicOpen f' := h_bo_eq.symm ▸ hq_bo_f
    rw [hf0, P.basicOpen_zero] at hq0
    exact hq0
  have h_pow_nzd : Submonoid.powers f' ≤
      nonZeroDivisors ↑(P.presheaf.obj (Opposite.op (P.basicOpen b))) := by
    rintro _ ⟨n, rfl⟩
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hf'_ne)
  have hWb : AlgebraicGeometry.IsAffineOpen (P.basicOpen b) := hV.basicOpen b
  have _ : IsLocalization.Away f' ↑(P.presheaf.obj (Opposite.op (P.basicOpen f'))) :=
    hWb.isLocalization_basicOpen f'
  have _ : IsDomain ↑(P.presheaf.obj (Opposite.op (P.basicOpen f'))) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors
      ↑(P.presheaf.obj (Opposite.op (P.basicOpen f'))) h_pow_nzd
  let e_eq : ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) ≃+*
      ↑(P.presheaf.obj (Opposite.op (P.basicOpen f'))) :=
    (P.presheaf.mapIso (CategoryTheory.eqToIso h_bo_eq).op).commRingCatIsoToRingEquiv
  have hDom_f : IsDomain ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) :=
    Function.Injective.isDomain e_eq.toRingHom e_eq.injective

  have hUf : AlgebraicGeometry.IsAffineOpen (P.basicOpen f) := hAff.basicOpen f
  have hIrred_Uf : IsIrreducible (P.basicOpen f : Set ↥P) := by
    have hUniv : IsIrreducible
        (Set.univ : Set (PrimeSpectrum ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))))) :=
      IrreducibleSpace.isIrreducible_univ _
    have hImg := hUniv.image hUf.fromSpec.base hUf.fromSpec.base.hom.continuous.continuousOn
    have hEqRange : (hUf.fromSpec.base ''
        (Set.univ : Set (PrimeSpectrum ↑(P.presheaf.obj (Opposite.op (P.basicOpen f)))))) =
        (P.basicOpen f : Set ↥P) := by
      apply Set.Subset.antisymm
      · rintro _ ⟨p, _, rfl⟩
        rw [← hUf.range_fromSpec]
        exact ⟨p, rfl⟩
      · intro y hy
        rw [← hUf.range_fromSpec] at hy
        rcases hy with ⟨p, rfl⟩
        exact ⟨p, trivial, rfl⟩
    exact hEqRange ▸ hImg
  have hIrred_union : IsIrreducible (E ∪ (P.basicOpen f : Set ↥P)) := by
    refine ⟨⟨q, Or.inl hqE⟩, ?_⟩
    intro O₁ O₂ hO₁ hO₂ h₁ h₂
    have h₁' : ((P.basicOpen f : Set ↥P) ∩ O₁).Nonempty := by
      rcases h₁ with ⟨z₁, hz₁ | hz₁, hz₁O₁⟩
      · obtain ⟨w₁, _, hw₁⟩ := hE.1.isPreirreducible (P.basicOpen f : Set ↥P) O₁
          (P.basicOpen f).isOpen hO₁ ⟨q, hqE, hq_bo_f⟩ ⟨z₁, hz₁, hz₁O₁⟩
        exact ⟨w₁, hw₁⟩
      · exact ⟨z₁, hz₁, hz₁O₁⟩
    have h₂' : ((P.basicOpen f : Set ↥P) ∩ O₂).Nonempty := by
      rcases h₂ with ⟨z₂, hz₂ | hz₂, hz₂O₂⟩
      · obtain ⟨w₂, _, hw₂⟩ := hE.1.isPreirreducible (P.basicOpen f : Set ↥P) O₂
          (P.basicOpen f).isOpen hO₂ ⟨q, hqE, hq_bo_f⟩ ⟨z₂, hz₂, hz₂O₂⟩
        exact ⟨w₂, hw₂⟩
      · exact ⟨z₂, hz₂, hz₂O₂⟩
    obtain ⟨w, hwUf, hwO⟩ := hIrred_Uf.isPreirreducible O₁ O₂ hO₁ hO₂ h₁' h₂'
    exact ⟨w, Or.inr hwUf, hwO⟩
  have hSub_E : (P.basicOpen f : Set ↥P) ⊆ E :=
    Set.subset_union_right.trans (hE.2 hIrred_union Set.subset_union_left)
  exact ⟨f, hq_bo_f, hf_le_sm, hDom_f, hSub_E⟩

theorem weil_etale_cartier_pullback_local_dvd_of_mem_prime (K : Type u) [Field K]
    {B₀ V₁ H : AlgebraicGeometry.Scheme.{u}}
    (f₁ : V₁ ⟶ B₀)
    (W : B₀.Opens)
    (ιH : H ⟶ V₁)
    (hClH : AlgebraicGeometry.IsClosedImmersion ιH)
    (hEt : AlgebraicGeometry.Etale ((ιH ≫ f₁) ∣_ W))
    (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₀)
    (hs : Set.range s.base ⊆ (W : Set B₀))
    (V_aff : V₁.Opens)
    (hV_aff : AlgebraicGeometry.IsAffineOpen V_aff)
    (s_H : ↑(V₁.presheaf.obj (Opposite.op V_aff)))
    (hKer : RingHom.ker (ιH.app V_aff).hom = Ideal.span {s_H})
    (U_q : (CategoryTheory.Limits.pullback f₁ s).Opens)
    (hU_q : AlgebraicGeometry.IsAffineOpen U_q)
    (hU_le : U_q ≤ (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst f₁ s).base).obj V_aff)
    (P : Ideal ↑((CategoryTheory.Limits.pullback f₁ s).presheaf.obj (Opposite.op U_q)))
    [P.IsPrime]
    (p : ↑((CategoryTheory.Limits.pullback f₁ s).presheaf.obj (Opposite.op U_q)))
    (hp : p ∈ P) :
    ∃ (t a : ↑((CategoryTheory.Limits.pullback f₁ s).presheaf.obj (Opposite.op U_q))),
      t ∉ P ∧
      t * p = a * ((CategoryTheory.Limits.pullback.fst f₁ s).appLE V_aff U_q hU_le).hom s_H :=
by
  let P_s := CategoryTheory.Limits.pullback f₁ s
  let π₁ : P_s ⟶ V₁ := CategoryTheory.Limits.pullback.fst f₁ s
  let π₂ : P_s ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
    CategoryTheory.Limits.pullback.snd f₁ s
  let R_q := P_s.presheaf.obj (Opposite.op U_q)
  let f_q : ↑R_q := (π₁.appLE V_aff U_q hU_le).hom s_H
  by_cases hfP : f_q ∈ P
  swap
  · exact ⟨f_q, p, hfP, mul_comm f_q p⟩
  have _ : AlgebraicGeometry.IsClosedImmersion ιH := hClH
  let g : H ⟶ B₀ := ιH ≫ f₁
  let H_K := CategoryTheory.Limits.pullback π₁ ιH
  let j_K : H_K ⟶ P_s := CategoryTheory.Limits.pullback.fst π₁ ιH
  let p_H : H_K ⟶ H := CategoryTheory.Limits.pullback.snd π₁ ιH
  have _ : AlgebraicGeometry.IsClosedImmersion j_K := inferInstance
  have hs_range : Set.range s.base ⊆ Set.range W.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    exact hs
  let s_W : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W :=
    AlgebraicGeometry.IsOpenImmersion.lift W.ι s hs_range
  have hs_W : s_W ≫ W.ι = s := AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι s hs_range
  have hPb_rect : CategoryTheory.IsPullback p_H (j_K ≫ π₂) g s :=
    (CategoryTheory.IsPullback.of_hasPullback π₁ ιH).flip.paste_vert
      (CategoryTheory.IsPullback.of_hasPullback f₁ s)
  have hPb_outer : CategoryTheory.IsPullback (j_K ≫ π₂) p_H (s_W ≫ W.ι) g := by
    rw [hs_W]
    exact hPb_rect.flip
  have hPb_et :=
    CategoryTheory.IsPullback.of_bot' hPb_outer (AlgebraicGeometry.isPullback_morphismRestrict g W)
  let g_K : H_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) := j_K ≫ π₂
  have hEt_gK : AlgebraicGeometry.Etale g_K :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_et.flip hEt
  let W_H : H_K.Opens := (TopologicalSpace.Opens.map j_K.base).obj U_q
  have hW_H : AlgebraicGeometry.IsAffineOpen W_H := hU_q.preimage j_K
  let B_q := H_K.presheaf.obj (Opposite.op W_H)
  have hEt_app : RingHom.Etale (g_K.appLE ⊤ W_H le_top).hom :=
    AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Etale g_K hEt_gK
      ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ ⟨W_H, hW_H⟩ le_top
  let iso_K : K ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op ⊤)) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.symm
  have hEt_isoK : iso_K.toRingHom.Etale := RingHom.Etale.of_bijective iso_K.bijective
  let φ_K : K →+* ↑B_q := (g_K.appLE ⊤ W_H le_top).hom.comp iso_K.toRingHom
  have hEt_φK : φ_K.Etale :=
    RingHom.Etale.stableUnderComposition _ _ hEt_isoK hEt_app
  let _ : Algebra K ↑B_q := φ_K.toAlgebra
  have hAlgEt : Algebra.Etale K ↑B_q :=
    (RingHom.etale_algebraMap (R := K) (S := ↑B_q)).mp hEt_φK
  let ψ : ↑R_q →+* ↑B_q := (j_K.app U_q).hom
  have hSurj_ψ : Function.Surjective ψ :=
    AlgebraicGeometry.Scheme.Hom.app_surjective j_K U_q hU_q
  have h_ideal_eq : ∀ {X : AlgebraicGeometry.Scheme.{u}} (I : X.IdealSheafData)
      {V₁' V₂' : X.Opens} (h₁ : AlgebraicGeometry.IsAffineOpen V₁')
      (h₂ : AlgebraicGeometry.IsAffineOpen V₂') (e : V₁' = V₂'),
      Ideal.comap (X.presheaf.map (CategoryTheory.eqToHom e).op).hom (I.ideal ⟨V₁', h₁⟩) =
        I.ideal ⟨V₂', h₂⟩ := by
    intro X I V₁' V₂' h₁ h₂ e
    subst e
    rw [CategoryTheory.eqToHom_refl, op_id, X.presheaf.map_id]
    exact Ideal.comap_id _
  have h_iso_comap_eq_map : ∀ (R : CommRingCat.{u}) (J : Ideal ↑R),
      Ideal.comap (AlgebraicGeometry.Scheme.ΓSpecIso R).hom.hom J =
        Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom J := by
    intro R J
    ext x
    simp only [Ideal.mem_comap]
    constructor
    · intro hx
      have hx' : (AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso R).hom.hom x) ∈
          Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom J :=
        Ideal.mem_map_of_mem _ hx
      have h_id := ConcreteCategory.congr_hom (AlgebraicGeometry.Scheme.ΓSpecIso R).hom_inv_id x
      simpa [h_id] using hx'
    · intro hx
      have hx' : (AlgebraicGeometry.Scheme.ΓSpecIso R).hom.hom x ∈
          Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso R).hom.hom
            (Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom J) :=
        Ideal.mem_map_of_mem _ hx
      rw [Ideal.map_map] at hx'
      have h_comp : (AlgebraicGeometry.Scheme.ΓSpecIso R).hom.hom.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom = RingHom.id ↑R := by
        ext y
        exact ConcreteCategory.congr_hom (AlgebraicGeometry.Scheme.ΓSpecIso R).inv_hom_id y
      simpa [h_comp] using hx'
  have h_fromSpec_comap : ∀ {X : AlgebraicGeometry.Scheme.{u}} (I : X.IdealSheafData)
      {U : X.Opens} (hU : AlgebraicGeometry.IsAffineOpen U),
      (I.comap hU.fromSpec).ideal ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ =
        Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv.hom
          (I.ideal ⟨U, hU⟩) := by
    intro X I U hU
    have e_U : hU.fromSpec ''ᵁ ⊤ = U :=
      (AlgebraicGeometry.Scheme.Hom.image_top_eq_opensRange hU.fromSpec).trans hU.opensRange_fromSpec
    have h_appIso_hom : (hU.fromSpec.appIso ⊤).hom =
        X.presheaf.map (CategoryTheory.eqToHom e_U.symm).op ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv := by
      rw [AlgebraicGeometry.Scheme.Hom.appIso_hom]
      have hnat := hU.fromSpec.naturality (CategoryTheory.eqToHom e_U.symm).op
      have hpost := congrArg
        (fun m => m ≫ (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).presheaf.map
          (CategoryTheory.eqToHom hU.fromSpec_preimage_self.symm).op) hnat.symm
      dsimp only at hpost
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp,
        hU.fromSpec_app_self, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Functor.map_comp] at hpost
      have h_id_top : (CategoryTheory.eqToHom hU.fromSpec_preimage_self).op ≫
          (CategoryTheory.eqToHom hU.fromSpec_preimage_self.symm).op =
          𝟙 (Opposite.op (⊤ : (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).Opens)) :=
        Subsingleton.elim _ _
      rw [h_id_top, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id] at hpost
      refine Eq.trans ?_ hpost
      congr 2
    have h_appIso_inv : (hU.fromSpec.appIso ⊤).inv =
        (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).hom ≫
          X.presheaf.map (CategoryTheory.eqToHom e_U).op := by
      apply (CategoryTheory.cancel_epi (hU.fromSpec.appIso ⊤).hom).mp
      rw [CategoryTheory.Iso.hom_inv_id, h_appIso_hom, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.inv_hom_id_assoc, ← CategoryTheory.Functor.map_comp,
        ← op_comp, CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_refl,
        op_id, CategoryTheory.Functor.map_id]
    rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, h_appIso_inv,
      CommRingCat.hom_comp, ← Ideal.comap_comap, h_ideal_eq I _ hU e_U, h_iso_comap_eq_map]
  have h_aff_comap : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine X]
      [AlgebraicGeometry.IsAffine Y] (h : X ⟶ Y) (J : Y.IdealSheafData),
      (J.comap h).ideal ⟨⊤, AlgebraicGeometry.isAffineOpen_top X⟩ =
        Ideal.map h.appTop.hom (J.ideal ⟨⊤, AlgebraicGeometry.isAffineOpen_top Y⟩) := by
    intro X Y _ _ h J
    have _ : AlgebraicGeometry.IsAffineHom h := AlgebraicGeometry.isAffineHom_of_isAffine h
    let T_X : X.affineOpens := ⟨⊤, AlgebraicGeometry.isAffineOpen_top X⟩
    let T_Y : Y.affineOpens := ⟨⊤, AlgebraicGeometry.isAffineOpen_top Y⟩
    let K₀ : Ideal ↑(X.presheaf.obj (Opposite.op ⊤)) := Ideal.map h.appTop.hom (J.ideal T_Y)
    have hK₀ : (AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop K₀).ideal T_X = K₀ := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop_ideal]
      rw [Subsingleton.elim (CategoryTheory.homOfLE _).op (𝟙 (Opposite.op ⊤)),
        X.presheaf.map_id, CommRingCat.hom_id, Ideal.map_id]
    have h_eq : J.comap h = AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop K₀ := by
      apply le_antisymm
      · rw [(AlgebraicGeometry.Scheme.IdealSheafData.map_gc h) J
          (AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop K₀)]
        apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_isAffine
        rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_map_of_isAffineHom]
        change J.ideal T_Y ≤
          Ideal.comap h.appTop.hom ((AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop K₀).ideal T_X)
        rw [hK₀]
        exact Ideal.map_le_iff_le_comap.mp (le_refl K₀)
      · apply AlgebraicGeometry.Scheme.IdealSheafData.le_of_isAffine
        rw [hK₀, Ideal.map_le_iff_le_comap]
        have h_le := AlgebraicGeometry.Scheme.IdealSheafData.ideal_mono
          ((AlgebraicGeometry.Scheme.IdealSheafData.map_gc h).le_u_l J) T_Y
        rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_map_of_isAffineHom] at h_le
        exact h_le
    rw [h_eq]
    exact hK₀
  let A_V := V₁.presheaf.obj (Opposite.op V_aff)
  let φ : A_V ⟶ R_q := π₁.appLE V_aff U_q hU_le
  have hKer_ψ : RingHom.ker ψ = Ideal.span {f_q} := by
    have h_ker_pb : j_K.ker = ιH.ker.comap π₁ :=
      AlgebraicGeometry.Scheme.IdealSheafData.ker_fst_of_isClosedImmersion ιH π₁
    have h_comm_spec : AlgebraicGeometry.Spec.map φ ≫ hV_aff.fromSpec = hU_q.fromSpec ≫ π₁ :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π₁ hV_aff hU_q hU_le
    have h_sheaf_eq : j_K.ker.comap hU_q.fromSpec =
        (ιH.ker.comap hV_aff.fromSpec).comap (AlgebraicGeometry.Spec.map φ) := by
      rw [h_ker_pb, ← AlgebraicGeometry.Scheme.IdealSheafData.comap_comp, ← h_comm_spec,
        AlgebraicGeometry.Scheme.IdealSheafData.comap_comp]
    have h_top_eq := congrArg
      (fun D : (AlgebraicGeometry.Spec R_q).IdealSheafData =>
        D.ideal ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩) h_sheaf_eq
    dsimp only at h_top_eq
    rw [h_fromSpec_comap j_K.ker hU_q, AlgebraicGeometry.Scheme.Hom.ker_apply j_K ⟨U_q, hU_q⟩,
      h_aff_comap (AlgebraicGeometry.Spec.map φ) (ιH.ker.comap hV_aff.fromSpec),
      h_fromSpec_comap ιH.ker hV_aff, AlgebraicGeometry.Scheme.Hom.ker_apply ιH ⟨V_aff, hV_aff⟩]
      at h_top_eq
    change Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso R_q).inv.hom (RingHom.ker ψ) =
      Ideal.map (AlgebraicGeometry.Spec.map φ).appTop.hom
        (Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso A_V).inv.hom
          (RingHom.ker (ιH.app V_aff).hom)) at h_top_eq
    rw [hKer, Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton] at h_top_eq
    have h_nat := ConcreteCategory.congr_hom (AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality φ) s_H
    change (AlgebraicGeometry.Scheme.ΓSpecIso R_q).inv.hom (φ.hom s_H) =
      (AlgebraicGeometry.Spec.map φ).appTop.hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso A_V).inv.hom s_H) at h_nat
    rw [← h_nat, ← Set.image_singleton, ← Ideal.map_span] at h_top_eq
    have h_cancel := congrArg (Ideal.map (AlgebraicGeometry.Scheme.ΓSpecIso R_q).hom.hom) h_top_eq
    rw [Ideal.map_map, Ideal.map_map] at h_cancel
    have h_comp : (AlgebraicGeometry.Scheme.ΓSpecIso R_q).hom.hom.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso R_q).inv.hom = RingHom.id ↑R_q := by
      ext y
      exact ConcreteCategory.congr_hom (AlgebraicGeometry.Scheme.ΓSpecIso R_q).inv_hom_id y
    simpa [h_comp] using h_cancel
  obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e_prod, _⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod K ↑B_q).mp hAlgEt
  classical
  let z : ↑B_q := ψ p
  let u : ∀ i : I, Ai i := fun i => if e_prod z i = 0 then 1 else 0
  let v : ∀ i : I, Ai i := fun i =>
    let _ : Field (Ai i) := hFieldAi i
    (e_prod z i + u i)⁻¹
  let e₀ : ↑B_q := e_prod.symm u
  let w : ↑B_q := e_prod.symm v
  have he₀_mul : e₀ * z = 0 := by
    apply e_prod.injective
    rw [map_mul, e_prod.apply_symm_apply, map_zero]
    ext i
    simp only [Pi.mul_apply, Pi.zero_apply, u]
    split_ifs with hzi
    · rw [hzi, mul_zero]
    · rw [zero_mul]
  have hzw_one : (z + e₀) * w = 1 := by
    apply e_prod.injective
    rw [map_mul, map_add, e_prod.apply_symm_apply, e_prod.apply_symm_apply, map_one]
    ext i
    let _ : Field (Ai i) := hFieldAi i
    change (e_prod z i + u i) * (e_prod z i + u i)⁻¹ = 1
    apply mul_inv_cancel₀
    dsimp only [u]
    split_ifs with hzi
    · rw [hzi, zero_add]
      exact one_ne_zero
    · rw [add_zero]
      exact hzi
  obtain ⟨t, ht_ψ⟩ := hSurj_ψ e₀
  obtain ⟨d, hd_ψ⟩ := hSurj_ψ w
  have htp_ker : t * p ∈ RingHom.ker ψ := by
    rw [RingHom.mem_ker, map_mul, ht_ψ]
    exact he₀_mul
  rw [hKer_ψ, Ideal.mem_span_singleton] at htp_ker
  obtain ⟨a, ha⟩ := htp_ker
  have hptd_ker : (p + t) * d - 1 ∈ RingHom.ker ψ := by
    rw [RingHom.mem_ker, map_sub, map_mul, map_add, map_one, ht_ψ, hd_ψ]
    change (z + e₀) * w - 1 = 0
    rw [hzw_one, sub_self]
  rw [hKer_ψ, Ideal.mem_span_singleton] at hptd_ker
  obtain ⟨b, hb⟩ := hptd_ker
  have ht_not_P : t ∉ P := by
    intro htP
    have h1 : (p + t) * d ∈ P := P.mul_mem_right d (P.add_mem hp htP)
    have h2 : f_q * b ∈ P := P.mul_mem_right b hfP
    have h_one_eq : (1 : ↑R_q) = (p + t) * d - f_q * b := by
      rw [← hb]
      ring
    have h1_mem : (1 : ↑R_q) ∈ P := by
      rw [h_one_eq]
      exact P.sub_mem h1 h2
    exact Ideal.IsPrime.ne_top ‹P.IsPrime› ((Ideal.eq_top_iff_one P).mpr h1_mem)
  exact ⟨t, a, ht_not_P, ha.trans (mul_comm f_q a)⟩

theorem weil_proj_curve_charts_and_deg_numerator_cocycle (k : Type u) [Field k] (K : Type u) [Field K] [IsAlgClosed K]
    (M₀ d₀ : ℕ)
    (B₀ V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjB₀ : IsProjectiveOverField k B₀)
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (f₁ : V₁ ⟶ B₀)
    (F : MvPolynomial (Fin (M₀ + 1)) k)
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k (d₀ • 1))
    (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₀.left)
    (C : AlgebraicGeometry.Scheme.{u})
    (ι_C : C ⟶ CategoryTheory.Limits.pullback f₁.left s)
    (hClC : AlgebraicGeometry.IsClosedImmersion ι_C)
    (hIntC : AlgebraicGeometry.IsIntegral C)
    (hPropC : AlgebraicGeometry.IsProper (ι_C ≫ CategoryTheory.Limits.pullback.snd f₁.left s))
    (hDimC : topologicalKrullDim ↥C = (1 : WithBot ℕ∞))
    (S_fin : Finset ↥C)
    (hClosedS : ∀ q ∈ S_fin, IsClosed ({q} : Set ↥C))
    (hCard : S_fin.card < d₀) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let ι₁_proj : V₁.left ⟶
        AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) := ι₁.left
    let U_proj : Fin (M₀ + 1) →
        (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k)).Opens :=
      fun μ => AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) (MvPolynomial.X μ)
    let P_chart : Fin (M₀ + 1) → (CategoryTheory.Limits.pullback f₁.left s).Opens :=
      fun μ => (TopologicalSpace.Opens.map
        (CategoryTheory.Limits.pullback.fst f₁.left s ≫ ι₁_proj).base).obj (U_proj μ)
    let C_chart : Fin (M₀ + 1) → C.Opens :=
      fun μ => (TopologicalSpace.Opens.map ι_C.base).obj (P_chart μ)
    let f_sec : ∀ μ : Fin (M₀ + 1), ↑(C.presheaf.obj (Opposite.op (C_chart μ))) :=
      fun μ => ((ι_C ≫ CategoryTheory.Limits.pullback.fst f₁.left s ≫ ι₁_proj).app (U_proj μ)).hom
        ((AlgebraicGeometry.Proj.awayToSection
          (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) (MvPolynomial.X μ)).hom
          (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k)
            (MvPolynomial.isHomogeneous_X k μ) d₀ F hF))
    (∀ μ : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (P_chart μ)) ∧
    (∀ μ ν : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (C_chart μ ⊓ C_chart ν)) ∧
    (⨆ μ : Fin (M₀ + 1), C_chart μ) = ⊤ ∧
    ∃ (z_star w_star : ↥C) (μ_z μ_w : Fin (M₀ + 1))
      (p_sec : ∀ μ : Fin (M₀ + 1), ↑(C.presheaf.obj (Opposite.op (C_chart μ))))
      (u_cocycle : ∀ μ ν : Fin (M₀ + 1), ↑(C.presheaf.obj (Opposite.op (C_chart μ ⊓ C_chart ν)))),
      z_star ∉ S_fin ∧
      z_star ∈ C_chart μ_z ∧ z_star ∉ C.basicOpen (p_sec μ_z) ∧
      w_star ∈ C_chart μ_w ∧ w_star ∈ C.basicOpen (p_sec μ_w) ∧
      (∀ (μ : Fin (M₀ + 1)) (q : ↥C), q ∈ S_fin → q ∈ C_chart μ →
        q ∉ C.basicOpen (p_sec μ)) ∧
      (∀ μ ν : Fin (M₀ + 1), IsUnit (u_cocycle μ ν)) ∧
      (∀ μ ν : Fin (M₀ + 1),
        (C.presheaf.map (CategoryTheory.homOfLE
          (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (p_sec μ) =
          u_cocycle μ ν *
            (C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (p_sec ν)) ∧
      (∀ μ ν : Fin (M₀ + 1),
        (C.presheaf.map (CategoryTheory.homOfLE
          (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec μ) =
          u_cocycle μ ν *
            (C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν)) :=
by
  intro ι₁_proj U_proj P_chart C_chart f_sec
  have _ := hPropC
  have _ : AlgebraicGeometry.IsClosedImmersion ι₁_proj := hCl₁
  have _ : AlgebraicGeometry.IsClosedImmersion ι_C := hClC
  have _ : AlgebraicGeometry.IsIntegral C := hIntC
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P_proj : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let p_proj : P_proj ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
  have _ : AlgebraicGeometry.IsSeparated B₀.hom := by
    obtain ⟨N₀, ιB₀, hClB₀⟩ := hProjB₀
    have _ : AlgebraicGeometry.IsClosedImmersion ιB₀.left := hClB₀
    have _ : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k N₀).hom := by
      let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k) :=
        MvPolynomial.gradedAlgebra
      change AlgebraicGeometry.IsSeparated
        (AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0))))
      infer_instance
    rw [← CategoryTheory.Over.w ιB₀]
    infer_instance
  have hOver : ι₁_proj ≫ p_proj = f₁.left ≫ B₀.hom :=
    (CategoryTheory.Over.w ι₁).trans (CategoryTheory.Over.w f₁).symm
  let t_coord : ∀ μ : Fin (M₀ + 1),
      Fin (M₀ + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) :=
    fun μ γ => HomogeneousLocalization.Away.mk 𝒜
      (MvPolynomial.isHomogeneous_X k μ) 1 (MvPolynomial.X γ)
      (MvPolynomial.isHomogeneous_X k γ)
  let s_coord : ∀ μ : Fin (M₀ + 1),
      Fin (M₀ + 1) → ↑(P_proj.presheaf.obj (Opposite.op (U_proj μ))) :=
    fun μ γ => (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)).hom (t_coord μ γ)
  let s_F : ∀ μ : Fin (M₀ + 1), ↑(P_proj.presheaf.obj (Opposite.op (U_proj μ))) :=
    fun μ => (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)).hom
      (HomogeneousLocalization.Away.mk 𝒜
        (MvPolynomial.isHomogeneous_X k μ) d₀ F hF)
  let ι_k : ∀ μ : Fin (M₀ + 1), k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) :=
    fun μ => (HomogeneousLocalization.fromZeroRingHom 𝒜
      (Submonoid.powers (MvPolynomial.X μ))).comp (algebraMap k ↥(𝒜 0))
  
  have h_s1 :
      (∀ μ : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (U_proj μ)) ∧
      (∀ μ ν : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (U_proj μ ⊓ U_proj ν)) ∧
      (⨆ μ : Fin (M₀ + 1), U_proj μ) = ⊤ ∧
      (∀ μ : Fin (M₀ + 1), s_coord μ μ = 1) ∧
      (∀ μ α : Fin (M₀ + 1), P_proj.basicOpen (s_coord μ α) = U_proj μ ⊓ U_proj α) ∧
      (∀ (μ : Fin (M₀ + 1)) (z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ)),
        ∃ (S_supp : Finset (Fin (M₀ + 1) →₀ ℕ)) (coeff : (Fin (M₀ + 1) →₀ ℕ) → k),
