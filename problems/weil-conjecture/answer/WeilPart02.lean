    intro x hxU hxPrev
    have hxK : x ∈ K := ⟨hxU, hxPrev⟩
    have hxU_t := ht_cov hxK
    rw [Set.mem_iUnion₂] at hxU_t
    obtain ⟨z, hzt, hxz⟩ := hxU_t
    refine ⟨e_t.symm ⟨z, hzt⟩, ?_⟩
    change x ∈ V₁_z (e_t (e_t.symm ⟨z, hzt⟩)).1
    rw [e_t.apply_symm_apply]
    exact hxz
  · intro hd F_new hFn_mem hPt
    have hHomAll :
        ∀ j : Fin (ν + 1),
          Fin.snoc (α := fun _ => MvPolynomial (Fin (N + 1)) k) F_prev F_new j ∈
            MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 := by
      refine Fin.lastCases ?_ (fun j => ?_)
      · simpa using hFn_mem
      · simpa using hSl.1 j
    refine ⟨hHomAll, ?_⟩
    intro x hxU hxAll
    have hxPrev : ∀ j : Fin ν, ι_X.left.base x ∈ weilProjHyperplaneSet k N (F_prev j) :=
      fun j => by simpa using hxAll j.castSucc
    have hxNew : ι_X.left.base x ∈ weilProjHyperplaneSet k N F_new :=
      by simpa using hxAll (Fin.last ν)
    obtain ⟨α₀, V, hAffV, hxV, hVU, hVα, s, φ, q, f_lift, f_new_lift, γ₀,
      hSurj, hSpec, hKer, hf_lift_eq, hf_new_eq, hDet_q, hJ_notMem⟩ :=
      hPt x hxU hxPrev hxNew
