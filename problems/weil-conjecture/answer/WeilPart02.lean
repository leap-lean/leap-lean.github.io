        (⟨ι_Ω a, ha⟩ : ↥E) ⤳ (⟨ι_Ω b, hb⟩ : ↥E) ↔ a ≤ b := by
      intro a b ha hb
      exact (Topology.IsInducing.subtypeVal.specializes_iff
        (x := (⟨ι_Ω a, ha⟩ : ↥E)) (y := (⟨ι_Ω b, hb⟩ : ↥E))).symm.trans
        (hg_open.isInducing.specializes_iff.trans (PrimeSpectrum.le_iff_specializes a b).symm)
    let C_of : ↥E → TopologicalSpace.IrreducibleCloseds ↥E := fun e =>
      ⟨closure {e}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hC_lt : ∀ {a b : PrimeSpectrum (TensorProduct R_β S Ω)}
        (ha : ι_Ω a ∈ E) (hb : ι_Ω b ∈ E),
        a < b → C_of ⟨ι_Ω b, hb⟩ < C_of ⟨ι_Ω a, ha⟩ := by
      intro a b ha hb hab
      have h_le : C_of ⟨ι_Ω b, hb⟩ ≤ C_of ⟨ι_Ω a, ha⟩ := by
        have h_sp : (⟨ι_Ω a, ha⟩ : ↥E) ⤳ (⟨ι_Ω b, hb⟩ : ↥E) := (h_ind_E ha hb).mpr hab.le
        rw [specializes_iff_mem_closure] at h_sp
        exact closure_minimal (Set.singleton_subset_iff.mpr h_sp) isClosed_closure
      refine lt_of_le_not_ge h_le (fun h_ge => ?_)
      have ha_mem : (⟨ι_Ω a, ha⟩ : ↥E) ∈ closure ({(⟨ι_Ω b, hb⟩ : ↥E)} : Set ↥E) :=
        h_ge (subset_closure (Set.mem_singleton _))
      rw [← specializes_iff_mem_closure, h_ind_E hb ha] at ha_mem
      exact not_le_of_gt hab ha_mem
    have hC₂₁ : C_of e₂ < C_of e₁ := hC_lt h₁_E h₂_E hQ₁₂
    have hC₁₀ : C_of e₁ < C_of e₀ := hC_lt h₀_E h₁_E hQ₀₁
    let ser : LTSeries (TopologicalSpace.IrreducibleCloseds ↥E) :=
      { length := 2
        toFun := ![C_of e₂, C_of e₁, C_of e₀]
        step := fun i => by
          fin_cases i
          · exact hC₂₁
          · exact hC₁₀ }
    have h_len : ((2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥E :=
      Order.LTSeries.length_le_krullDim ser
    rw [hDimE] at h_len
    norm_cast at h_len
  · 
    intro c p hFinS
