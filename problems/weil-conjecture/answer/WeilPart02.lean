          fun i => Classical.choose_spec (IsLocalization.surj (nonZeroDivisors ↥Ox₀) (P_min.coeff i))
        let S_idx := Finset.range (N_deg + 1)
        let D_den : ↥Ox₀ := ∏ i ∈ S_idx, (den_fn i).1
        have hD_ne : D_den ≠ 0 :=
          Finset.prod_ne_zero_iff.mpr (fun i _ => mem_nonZeroDivisors_iff_ne_zero.mp (den_fn i).2)
