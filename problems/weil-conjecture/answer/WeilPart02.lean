        let Aj_cat := (U j : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)
        let Aj := ↑Aj_cat
        let κj_orig_cat : CommRingCat.of k ⟶ Y.left.presheaf.obj (Opposite.op (U j)) :=
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ (U j) le_top
        let κj_cat : CommRingCat.of k ⟶ Aj_cat :=
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ((U j).ι ≫ Y.hom).appTop
        have hκj_compat : κj_orig_cat ≫ (U j).topIso.inv = κj_cat := by
          have hY_res : Y.hom.appTop ≫ Y.left.presheaf.map (homOfLE (le_top : U j ≤ ⊤)).op =
              AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ (U j) le_top := by
            rw [← appLE_top_top Y.hom (fun _ _ => trivial)]
            exact AlgebraicGeometry.Scheme.Hom.appLE_map Y.hom
              (U := ⊤) (V := ⊤) (V' := U j)
              (e := fun _ _ => trivial) (homOfLE (le_top : U j ≤ ⊤)).op
          dsimp only [κj_orig_cat, κj_cat]
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, ι_appTop_eq_topIso_inv,
            ← Category.assoc Y.hom.appTop, hY_res, Category.assoc]
        let fj_top : Fin (n j) → Aj := fun m => (U j).topIso.inv.hom (f j m)
        let σj : MvPolynomial (Fin (n j)) k →+* Aj := MvPolynomial.eval₂Hom κj_cat.hom fj_top
        have hσj_eq : σj = (U j).topIso.inv.hom.comp
            (MvPolynomial.eval₂Hom κj_orig_cat.hom (f j)) := by
          apply MvPolynomial.ringHom_ext'
          · ext c
            simp only [σj, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
            exact (congrArg (fun m => m.hom c) hκj_compat).symm
          · intro m
            simp [σj, fj_top]
        have hSurj_σj : Function.Surjective σj := by
          rw [hσj_eq]
          exact ((U j).topIso.commRingCatIsoToRingEquiv.symm.surjective).comp (hGen j)
        let Rβ_cat := (D β : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)
        let Rβ := ↑Rβ_cat
        let κPβ_cat : CommRingCat.of k ⟶ Rβ_cat :=
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ((D β).ι ≫ P.hom).appTop
        let z_vec : Fin (n j) → Rβ := fun m =>
          (D β).topIso.inv.hom (z (Classical.choose (hRecov j β hZβ m)) β)
        let τβ : MvPolynomial (Fin (n j)) k →+* Rβ := MvPolynomial.eval₂Hom κPβ_cat.hom z_vec
        let Iβ : Ideal Rβ := Ideal.map τβ (RingHom.ker σj)
        let Qβ := Rβ ⧸ Iβ
        let mkβ : Rβ →+* Qβ := Ideal.Quotient.mk Iβ
        have hKerSub : ∀ Q ∈ RingHom.ker σj, (mkβ.comp τβ) Q = 0 := by
          intro Q hQ
          rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_map_of_mem τβ hQ
        let θβ : Aj →+* Qβ :=
          (Ideal.Quotient.lift (RingHom.ker σj) (mkβ.comp τβ) hKerSub).comp
            (RingHom.quotientKerEquivOfSurjective hSurj_σj).symm.toRingHom
        have hθβ_σj : θβ.comp σj = mkβ.comp τβ := by
          apply RingHom.ext
          intro Q
          change Ideal.Quotient.lift (RingHom.ker σj) (mkβ.comp τβ) hKerSub
            ((RingHom.quotientKerEquivOfSurjective hSurj_σj).symm (σj Q)) = mkβ (τβ Q)
          have hSymm : (RingHom.quotientKerEquivOfSurjective hSurj_σj).symm (σj Q) =
              Ideal.Quotient.mk (RingHom.ker σj) Q :=
            (RingHom.quotientKerEquivOfSurjective hSurj_σj).symm_apply_eq.mpr rfl
          rw [hSymm, Ideal.Quotient.lift_mk]
          rfl
        let Qβ_cat := CommRingCat.of Qβ
        let Cβ := AlgebraicGeometry.Spec Qβ_cat
        let ι_C : Cβ ⟶ (D β : AlgebraicGeometry.Scheme) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom mkβ) ≫
            inv (D β : AlgebraicGeometry.Scheme).toSpecΓ
        have : AlgebraicGeometry.IsClosedImmersion
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mkβ)) :=
          AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
            (CommRingCat.ofHom mkβ) Ideal.Quotient.mk_surjective
        have hCl_ιC : AlgebraicGeometry.IsClosedImmersion ι_C := by
          dsimp only [ι_C]; infer_instance
        let ψβ_U : Cβ ⟶ (U j : AlgebraicGeometry.Scheme) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θβ) ≫
            inv (U j : AlgebraicGeometry.Scheme).toSpecΓ
        let ψβ : Cβ ⟶ Y.left := ψβ_U ≫ (U j).ι
        have hInvToSpecΓ_appTop : ∀ {W : AlgebraicGeometry.Scheme} [AlgebraicGeometry.IsAffine W],
            (inv W.toSpecΓ).appTop =
              (AlgebraicGeometry.Scheme.ΓSpecIso (W.presheaf.obj (Opposite.op ⊤))).inv := by
          intro W _
          rw [← cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso (W.presheaf.obj (Opposite.op ⊤))).hom,
            Iso.inv_hom_id, ← AlgebraicGeometry.Scheme.toSpecΓ_appTop,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, IsIso.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        have hψβ_hom : ψβ ≫ Y.hom = (ι_C ≫ (D β).ι) ≫ P.hom := by
          apply hom_ext_Spec
          have hL : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (ψβ ≫ Y.hom).appTop =
              (κj_cat ≫ CommRingCat.ofHom θβ) ≫ (AlgebraicGeometry.Scheme.ΓSpecIso Qβ_cat).inv := by
            have h1 : ψβ ≫ Y.hom = ψβ_U ≫ ((U j).ι ≫ Y.hom) := Category.assoc _ _ _
            have h2 : ψβ_U.appTop =
                CommRingCat.ofHom θβ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso Qβ_cat).inv := by
              dsimp only [ψβ_U]
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, hInvToSpecΓ_appTop, specHom_SpecMap]
            rw [h1, AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc, h2]
            exact (Category.assoc κj_cat (CommRingCat.ofHom θβ)
              (AlgebraicGeometry.Scheme.ΓSpecIso Qβ_cat).inv).symm
          have hR : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              ((ι_C ≫ (D β).ι) ≫ P.hom).appTop =
              (κPβ_cat ≫ CommRingCat.ofHom mkβ) ≫ (AlgebraicGeometry.Scheme.ΓSpecIso Qβ_cat).inv := by
            have h1 : (ι_C ≫ (D β).ι) ≫ P.hom = ι_C ≫ ((D β).ι ≫ P.hom) := Category.assoc _ _ _
            have h2 : ι_C.appTop =
                CommRingCat.ofHom mkβ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso Qβ_cat).inv := by
              dsimp only [ι_C]
              rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, hInvToSpecΓ_appTop, specHom_SpecMap]
            rw [h1, AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc, h2]
            exact (Category.assoc κPβ_cat (CommRingCat.ofHom mkβ)
              (AlgebraicGeometry.Scheme.ΓSpecIso Qβ_cat).inv).symm
          rw [hL, hR]
          have hMid : κj_cat ≫ CommRingCat.ofHom θβ = κPβ_cat ≫ CommRingCat.ofHom mkβ := by
            ext c
            change θβ (κj_cat.hom c) = mkβ (κPβ_cat.hom c)
            have hc := congrArg (fun m => m (MvPolynomial.C c)) hθβ_σj
            simpa [σj, τβ] using hc
          rw [hMid]
        let p₂_β : (Vβ : AlgebraicGeometry.Scheme) ⟶ (D β : AlgebraicGeometry.Scheme) :=
          p₂.left ∣_ D β
        let ρβ : Rβ →+* ↑((Vβ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)) :=
          p₂_β.appTop.hom
        have hRange_u : Set.range (Uβ.ι ≫ U₀.ι).base ⊆ Set.range (U j).ι.base := by
          rintro _ ⟨x, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact hU₀_le j x.1.2
        let u_mor : (Uβ : AlgebraicGeometry.Scheme) ⟶ (U j : AlgebraicGeometry.Scheme) :=
          AlgebraicGeometry.IsOpenImmersion.lift (U j).ι (Uβ.ι ≫ U₀.ι) hRange_u
        have hu_mor_fac : u_mor ≫ (U j).ι = Uβ.ι ≫ U₀.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (U j).ι (Uβ.ι ≫ U₀.ι) hRange_u
        have hp₂_sβ_fac : (sβ ≫ p₂_β) ≫ (D β).ι = Uβ.ι ≫ Φ := by
          rw [Category.assoc, AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc, hsβ_fac,
            Category.assoc, hν_p₂]
        have hPullPoly : ∀ Q : MvPolynomial (Fin (n j)) k,
            sβ.appTop.hom (ρβ (τβ Q)) = u_mor.appTop.hom (σj Q) := by
          intro Q
          have hEqHom : (sβ.appTop.hom.comp ρβ).comp τβ = u_mor.appTop.hom.comp σj := by
            apply MvPolynomial.ringHom_ext'
            · ext c
              simp only [τβ, σj, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
              have hMorEq : (sβ ≫ p₂_β) ≫ (D β).ι ≫ P.hom = u_mor ≫ (U j).ι ≫ Y.hom := by
                rw [← Category.assoc (sβ ≫ p₂_β), hp₂_sβ_fac, ← Category.assoc u_mor, hu_mor_fac,
                  Category.assoc, Category.assoc]
                congr 1
                rw [← hν_p₂, ← hν_π₀, Category.assoc, Category.assoc, p₂.w, π₀.w]
              have hRing := congrArg (fun g =>
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ g.appTop).hom c) hMorEq
              simpa only [ρβ, κPβ_cat, κj_cat, AlgebraicGeometry.Scheme.Hom.comp_appTop,
                Category.assoc, CategoryTheory.ConcreteCategory.comp_apply] using hRing
            · intro m
              simp only [τβ, σj, MvPolynomial.eval₂Hom_X', RingHom.comp_apply, z_vec, fj_top, ρβ]
              let β_m := Classical.choose (hRecov j β hZβ m)
              have hRec_m := Classical.choose_spec (hRecov j β hZβ m)
              have hUβ_le_Φ : Uβ ≤ Φ ⁻¹ᵁ D β := by
                intro w hw
                have heq_w : p₂.left.base (ν.base w) = Φ.base w :=
                  congrArg (fun g => g.base w) hν_p₂
                change Φ.base w ∈ D β
                rwa [← heq_w]
              have hL_m : sβ.appTop.hom (p₂_β.appTop.hom ((D β).topIso.inv.hom (z β_m β))) =
                  Uβ.topIso.inv.hom ((AlgebraicGeometry.Scheme.Hom.appLE Φ (D β) Uβ hUβ_le_Φ).hom
                    (z β_m β)) := by
                have hCatL : (D β).topIso.inv ≫ p₂_β.appTop ≫ sβ.appTop =
                    AlgebraicGeometry.Scheme.Hom.appLE Φ (D β) Uβ hUβ_le_Φ ≫ Uβ.topIso.inv := by
                  rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop,
                    topIso_inv_comp_appTop (D β) (sβ ≫ p₂_β),
                    ← appLE_ι_comp Uβ (D β) Φ hUβ_le_Φ]
                  exact appLE_congr hp₂_sβ_fac (D β) ⊤ _ _
                exact congrArg (fun g => g.hom (z β_m β)) hCatL
              have hR_m : u_mor.appTop.hom ((U j).topIso.inv.hom (f j m)) =
                  Uβ.topIso.inv.hom ((AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) Uβ
                    (fun x _ => hU₀_le j x.2)).hom (f j m)) := by
                have hCatR : (U j).topIso.inv ≫ u_mor.appTop =
                    AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) Uβ (fun x _ => hU₀_le j x.2) ≫
                      Uβ.topIso.inv := by
                  rw [topIso_inv_comp_appTop (U j) u_mor,
                    ← appLE_ι_comp Uβ (U j) U₀.ι (fun x _ => hU₀_le j x.2)]
                  exact appLE_congr hu_mor_fac (U j) ⊤ _ _
                exact congrArg (fun g => g.hom (f j m)) hCatR
              rw [hL_m, hR_m]
              congr 1
              have hResL : (AlgebraicGeometry.Scheme.Hom.appLE Φ (D β) Uβ hUβ_le_Φ).hom (z β_m β) =
                  ((U₀ : AlgebraicGeometry.Scheme).presheaf.map (homOfLE hUβ_le_Φ).op).hom
                    ((AlgebraicGeometry.Scheme.Hom.app Φ (D β)).hom (z β_m β)) :=
                rfl
              have hResR : (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) Uβ
                  (fun x _ => hU₀_le j x.2)).hom (f j m) =
                  ((U₀ : AlgebraicGeometry.Scheme).presheaf.map (homOfLE hUβ_le_Φ).op).hom
                    ((AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) (Φ ⁻¹ᵁ D β)
                      (fun x _ => hU₀_le j x.2)).hom (f j m)) :=
                congrArg (fun g => g.hom (f j m))
                  (AlgebraicGeometry.Scheme.Hom.appLE_map U₀.ι
                    (e := fun x _ => hU₀_le j x.2) (homOfLE hUβ_le_Φ).op).symm
              rw [hResL, hResR, hRec_m]
          exact congrArg (fun g => g Q) hEqHom
        have hInj_sβ_top : Function.Injective sβ.appTop.hom := by
          intro a₁ a₂ haEq
          have hsβ_ν_app : Vβ.topIso.inv ≫ sβ.appTop =
              AlgebraicGeometry.Scheme.Hom.app ν Vβ ≫ Uβ.topIso.inv := by
            rw [topIso_inv_comp_appTop Vβ sβ, AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν (U := Vβ),
              ← appLE_ι_comp Uβ Vβ ν (le_refl Uβ)]
            exact appLE_congr hsβ_fac Vβ ⊤ _ _
          have hνEq : (AlgebraicGeometry.Scheme.Hom.app ν Vβ).hom (Vβ.topIso.hom.hom a₁) =
              (AlgebraicGeometry.Scheme.Hom.app ν Vβ).hom (Vβ.topIso.hom.hom a₂) := by
            apply Uβ.topIso.commRingCatIsoToRingEquiv.symm.injective
            have hc1 := congrArg (fun g => g.hom (Vβ.topIso.hom.hom a₁)) hsβ_ν_app
            have hc2 := congrArg (fun g => g.hom (Vβ.topIso.hom.hom a₂)) hsβ_ν_app
            dsimp at hc1 hc2
            have hIso1 : Vβ.topIso.inv.hom (Vβ.topIso.hom.hom a₁) = a₁ :=
              congrArg (fun g => g.hom a₁) Vβ.topIso.hom_inv_id
            have hIso2 : Vβ.topIso.inv.hom (Vβ.topIso.hom.hom a₂) = a₂ :=
              congrArg (fun g => g.hom a₂) Vβ.topIso.hom_inv_id
            change Uβ.topIso.inv.hom _ = Uβ.topIso.inv.hom _
            rw [← hc1, ← hc2, hIso1, hIso2, haEq]
          have hTopEq := hInj_ν_app Vβ hNonVβ hνEq
          exact Vβ.topIso.commRingCatIsoToRingEquiv.injective hTopEq
        have hIβ_ker : Iβ ≤ RingHom.ker ρβ := by
          rw [Ideal.map_le_iff_le_comap]
          intro Q hQ
          rw [Ideal.mem_comap, RingHom.mem_ker]
          apply hInj_sβ_top
          rw [hPullPoly Q, RingHom.mem_ker.mp hQ, map_zero, map_zero]
        let ρβ_bar_cat : Qβ_cat ⟶ (Vβ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤) :=
          CommRingCat.ofHom (Ideal.Quotient.lift Iβ ρβ (fun a ha => hIβ_ker ha))
        have hρβ_bar_mk_cat : CommRingCat.ofHom mkβ ≫ ρβ_bar_cat = p₂_β.appTop := by
          ext r
          exact congrArg (fun g => g r) (Ideal.Quotient.lift_comp_mk Iβ ρβ _)
        let qβ : (Vβ : AlgebraicGeometry.Scheme) ⟶ Cβ :=
          (Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫ AlgebraicGeometry.Spec.map ρβ_bar_cat
        have hqβ_ιC : qβ ≫ ι_C = p₂_β := by
          rw [← cancel_mono (D β : AlgebraicGeometry.Scheme).toSpecΓ]
          have h1 : (qβ ≫ ι_C) ≫ (D β : AlgebraicGeometry.Scheme).toSpecΓ =
              (Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                AlgebraicGeometry.Spec.map p₂_β.appTop := by
            calc
              (qβ ≫ ι_C) ≫ (D β : AlgebraicGeometry.Scheme).toSpecΓ
                = (Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                    (AlgebraicGeometry.Spec.map ρβ_bar_cat ≫
                      AlgebraicGeometry.Spec.map (CommRingCat.ofHom mkβ)) ≫
                    (inv (D β : AlgebraicGeometry.Scheme).toSpecΓ ≫
                      (D β : AlgebraicGeometry.Scheme).toSpecΓ) := by
                  dsimp only [qβ, ι_C]
                  simp only [Category.assoc]
              _ = (Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom mkβ ≫ ρβ_bar_cat) := by
                  rw [IsIso.inv_hom_id, Category.comp_id, ← AlgebraicGeometry.Spec.map_comp]
              _ = (Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                    AlgebraicGeometry.Spec.map p₂_β.appTop := by
                  rw [hρβ_bar_mk_cat]
          have h2 : p₂_β ≫ (D β : AlgebraicGeometry.Scheme).toSpecΓ =
              (Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                AlgebraicGeometry.Spec.map p₂_β.appTop := by
            symm
            have h0 := toSpecΓ_SpecMap_of_hom (p₂_β ≫ (D β : AlgebraicGeometry.Scheme).toSpecΓ)
            rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
              AlgebraicGeometry.Scheme.toSpecΓ_appTop, ← Category.assoc,
              Iso.inv_hom_id, Category.id_comp] at h0
            exact h0
          exact h1.trans h2.symm
        have hqβ_ψβ : Vβ.ι ≫ π₀.left = qβ ≫ ψβ := by
          apply AlgebraicGeometry.ext_of_isDominant sβ
          have hLHS : sβ ≫ (Vβ.ι ≫ π₀.left) = u_mor ≫ (U j).ι := by
            rw [← Category.assoc, hsβ_fac, Category.assoc, hν_π₀, hu_mor_fac]
          have hRHS : sβ ≫ (qβ ≫ ψβ) = (sβ ≫ qβ ≫ ψβ_U) ≫ (U j).ι := by
            dsimp only [ψβ]
            simp only [Category.assoc]
          rw [hLHS, hRHS]
          congr 1
          rw [← cancel_mono (U j : AlgebraicGeometry.Scheme).toSpecΓ]
          apply hom_ext_Spec
          have hU1 : (AlgebraicGeometry.Scheme.ΓSpecIso Aj_cat).inv ≫
              (u_mor ≫ (U j : AlgebraicGeometry.Scheme).toSpecΓ).appTop = u_mor.appTop := by
            rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.toSpecΓ_appTop,
              ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
          have hU2 : (AlgebraicGeometry.Scheme.ΓSpecIso Aj_cat).inv ≫
              ((sβ ≫ qβ ≫ ψβ_U) ≫ (U j : AlgebraicGeometry.Scheme).toSpecΓ).appTop =
              CommRingCat.ofHom θβ ≫ ρβ_bar_cat ≫ sβ.appTop := by
            have hCancelU : (sβ ≫ qβ ≫ ψβ_U) ≫ (U j : AlgebraicGeometry.Scheme).toSpecΓ =
                sβ ≫ ((Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom θβ ≫ ρβ_bar_cat)) := by
              calc
                (sβ ≫ qβ ≫ ψβ_U) ≫ (U j : AlgebraicGeometry.Scheme).toSpecΓ
                  = sβ ≫ ((Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                      (AlgebraicGeometry.Spec.map ρβ_bar_cat ≫
                        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θβ)) ≫
                      (inv (U j : AlgebraicGeometry.Scheme).toSpecΓ ≫
                        (U j : AlgebraicGeometry.Scheme).toSpecΓ)) := by
                    dsimp only [ψβ_U, qβ]
                    simp only [Category.assoc]
                _ = sβ ≫ ((Vβ : AlgebraicGeometry.Scheme).toSpecΓ ≫
                      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θβ ≫ ρβ_bar_cat)) := by
                    rw [IsIso.inv_hom_id, Category.comp_id, ← AlgebraicGeometry.Spec.map_comp]
            have hSpecV := specHom_toSpecΓ_SpecMap (X := (Vβ : AlgebraicGeometry.Scheme))
              (CommRingCat.ofHom θβ ≫ ρβ_bar_cat)
            rw [hCancelU, AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc]
            erw [hSpecV]
            rw [Category.assoc]
          rw [hU1, hU2]
          ext a
          obtain ⟨Q, rfl⟩ := hSurj_σj a
          change u_mor.appTop.hom (σj Q) = sβ.appTop.hom (ρβ_bar_cat.hom (θβ (σj Q)))
          have hθQ : θβ (σj Q) = mkβ (τβ Q) := congrArg (fun g => g Q) hθβ_σj
          have hρQ : ρβ_bar_cat.hom (mkβ (τβ Q)) = ρβ (τβ Q) :=
            congrArg (fun g => g.hom (τβ Q)) hρβ_bar_mk_cat
          rw [hθQ, hρQ, hPullPoly Q]
        let Z := CategoryTheory.Limits.pullback Y.hom P.hom
        let fstZ := CategoryTheory.Limits.pullback.fst Y.hom P.hom
        let sndZ := CategoryTheory.Limits.pullback.snd Y.hom P.hom
        let ι_V₀ : V₀.left ⟶ Z :=
          CategoryTheory.Limits.pullback.lift π₀.left p₂.left (by rw [π₀.w, p₂.w])
        have : AlgebraicGeometry.IsClosedImmersion ι_V₀ := hCl_lift
        let W_Z : Z.Opens := sndZ ⁻¹ᵁ D β
        let Ψ_tilde : Cβ ⟶ Z :=
          CategoryTheory.Limits.pullback.lift ψβ (ι_C ≫ (D β).ι) hψβ_hom
        have hRange_Ψ : Set.range Ψ_tilde.base ⊆ Set.range W_Z.ι.base := by
          rintro _ ⟨x, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          change (Ψ_tilde ≫ sndZ).base x ∈ D β
          rw [CategoryTheory.Limits.pullback.lift_snd]
          exact ((ι_C.base x)).2
        let Ψβ : Cβ ⟶ (W_Z : AlgebraicGeometry.Scheme) :=
          AlgebraicGeometry.IsOpenImmersion.lift W_Z.ι Ψ_tilde hRange_Ψ
        have hΨβ_fac : Ψβ ≫ W_Z.ι = Ψ_tilde :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac W_Z.ι Ψ_tilde hRange_Ψ
        have hΨβ_snd : Ψβ ≫ (sndZ ∣_ D β) = ι_C := by
          rw [← cancel_mono (D β).ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            ← Category.assoc, hΨβ_fac]
          exact CategoryTheory.Limits.pullback.lift_snd _ _ _
        have : AlgebraicGeometry.IsSeparated (Ψβ ≫ (sndZ ∣_ D β)) := by
          rw [hΨβ_snd]; infer_instance
        have : AlgebraicGeometry.IsSeparated Ψβ :=
          AlgebraicGeometry.IsSeparated.of_comp Ψβ (sndZ ∣_ D β)
        let V'_Z : V₀.left.Opens := ι_V₀ ⁻¹ᵁ W_Z
        have hEq_VZ : Vβ = V'_Z := by
          ext x
          change p₂.left.base x ∈ D β ↔ (ι_V₀ ≫ sndZ).base x ∈ D β
          rw [CategoryTheory.Limits.pullback.lift_snd]
        have hR1 : Set.range Vβ.ι.base ⊆ Set.range V'_Z.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι, hEq_VZ]
        have hR2 : Set.range V'_Z.ι.base ⊆ Set.range Vβ.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι, AlgebraicGeometry.Scheme.Opens.range_ι, hEq_VZ]
        let e₁ : (Vβ : AlgebraicGeometry.Scheme) ⟶ (V'_Z : AlgebraicGeometry.Scheme) :=
          AlgebraicGeometry.IsOpenImmersion.lift V'_Z.ι Vβ.ι hR1
        let e₂ : (V'_Z : AlgebraicGeometry.Scheme) ⟶ (Vβ : AlgebraicGeometry.Scheme) :=
          AlgebraicGeometry.IsOpenImmersion.lift Vβ.ι V'_Z.ι hR2
        have he₁_fac : e₁ ≫ V'_Z.ι = Vβ.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac V'_Z.ι Vβ.ι hR1
        have he₂_fac : e₂ ≫ Vβ.ι = V'_Z.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac Vβ.ι V'_Z.ι hR2
        have he₁_e₂ : e₁ ≫ e₂ = 𝟙 _ := by
          rw [← cancel_mono Vβ.ι, Category.assoc, he₂_fac, he₁_fac, Category.id_comp]
        have he₂_e₁ : e₂ ≫ e₁ = 𝟙 _ := by
          rw [← cancel_mono V'_Z.ι, Category.assoc, he₁_fac, he₂_fac, Category.id_comp]
        have : CategoryTheory.IsIso e₁ := ⟨⟨e₂, he₁_e₂, he₂_e₁⟩⟩
        have hqβ_Ψβ : qβ ≫ Ψβ = e₁ ≫ (ι_V₀ ∣_ W_Z) := by
          have hEqZ : (qβ ≫ Ψβ) ≫ W_Z.ι = (e₁ ≫ (ι_V₀ ∣_ W_Z)) ≫ W_Z.ι := by
            rw [Category.assoc qβ, hΨβ_fac, Category.assoc e₁,
              AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc e₁, he₁_fac]
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [Category.assoc qβ, CategoryTheory.Limits.pullback.lift_fst,
                Category.assoc Vβ.ι, CategoryTheory.Limits.pullback.lift_fst, hqβ_ψβ]
            · rw [Category.assoc qβ, CategoryTheory.Limits.pullback.lift_snd,
                Category.assoc Vβ.ι, CategoryTheory.Limits.pullback.lift_snd,
                ← Category.assoc qβ, hqβ_ιC, AlgebraicGeometry.morphismRestrict_ι]
          exact (cancel_mono W_Z.ι).mp hEqZ
        have : AlgebraicGeometry.IsClosedImmersion (qβ ≫ Ψβ) := by
          rw [hqβ_Ψβ]; infer_instance
        have : AlgebraicGeometry.IsClosedImmersion qβ :=
          AlgebraicGeometry.IsClosedImmersion.of_comp qβ Ψβ
        change AlgebraicGeometry.IsClosedImmersion p₂_β
        rw [← hqβ_ιC]
        infer_instance
  have hProjV₀ : IsProjectiveOverField k V₀ := ⟨N, p₂, step4⟩
  exact ⟨V₀, π₀, U₀, hIntV₀, hProjV₀, hProp_π₀, hSurj_π₀, hU₀, hIso_U₀⟩

theorem weil_chow_projective_modification_over_algClosure (F : Type u) [Finite F] [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible X.hom]
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom] :
    ∃ (V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
      (π₀ : V₀ ⟶ weilBaseChangeOver F (AlgebraicClosure F) X),
      AlgebraicGeometry.IsIntegral V₀.left ∧
      IsProjectiveOverField (AlgebraicClosure F) V₀ ∧
      topologicalKrullDim V₀.left = (d : WithBot ℕ∞) ∧
      IsGenFiniteEtaleAlterationOver (AlgebraicClosure F) π₀ :=
by
  let k : Type u := AlgebraicClosure F
  let X_bar := weilBaseChangeOver F k X
  obtain ⟨hIntX, hPropX, hSmX⟩ := weil_smooth_algClosure_baseChange_integral F X d
  have : AlgebraicGeometry.IsProper X_bar.hom := hPropX
  have : AlgebraicGeometry.SmoothOfRelativeDimension d X_bar.hom := hSmX
  obtain ⟨V₀, π₀, U₀, hIntV₀, hProjV₀, hPropπ₀, hSurjπ₀, hU₀, hIsoU₀⟩ :=
    weil_chow_birational_projective_modification k X_bar hIntX
  have : CategoryTheory.IsIso (π₀.left ∣_ U₀) := hIsoU₀
  have hDimV₀ : topologicalKrullDim V₀.left = (d : WithBot ℕ∞) :=
    (weil_birational_iso_on_open_krullDim_eq k V₀ X_bar hIntV₀ hProjV₀ hIntX π₀ U₀ hU₀).trans
      (weil_smooth_integral_krullDim_over_field k d X_bar hIntX)
  have hAltπ₀ : IsGenFiniteEtaleAlterationOver k π₀ :=
    ⟨hPropπ₀, hSurjπ₀, U₀, hU₀, inferInstance, inferInstance, inferInstance⟩
  exact ⟨V₀, π₀, hIntV₀, hProjV₀, hDimV₀, hAltπ₀⟩

theorem weil_algClosed_dim_zero_snc_alteration (k : Type u) [Field k] [IsAlgClosed k]
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV : AlgebraicGeometry.IsIntegral V.left)
    (hProjV : IsProjectiveOverField k V)
    (hDimV : topologicalKrullDim V.left = (0 : WithBot ℕ∞))
    (U_V : V.left.Opens) (hUV : Nonempty U_V) :
    ∃ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z_W : Set W.left) (φ : W ⟶ V),
      AlgebraicGeometry.IsIntegral W.left ∧
      IsProjectiveOverField k W ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 0 W.hom ∧
      IsSncDivisorSupport k 0 W Z_W ∧
      IsGenFiniteEtaleAlterationOver k φ ∧
      φ.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆ Z_W :=
by
  
  let X := V.left
  have : AlgebraicGeometry.IsIntegral X := hIntV
  have : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
  have hUnivIrred : IsIrreducible (Set.univ : Set X) := IrreducibleSpace.isIrreducible_univ ↥X
  let : OrderTop (TopologicalSpace.IrreducibleCloseds X) :=
    { top := ⟨Set.univ, hUnivIrred, isClosed_univ⟩
      le_top := fun _ _ _ => trivial }
  have hDimIC : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) = 0 := hDimV
  have hSubIC : Subsingleton (TopologicalSpace.IrreducibleCloseds X) :=
    Order.krullDim_eq_zero_iff_of_orderTop.mp hDimIC
  have hSubV : Subsingleton X := ⟨fun x y => by
    let cx : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure ({x} : Set X), (isIrreducible_singleton).closure, isClosed_closure⟩
    let cy : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure ({y} : Set X), (isIrreducible_singleton).closure, isClosed_closure⟩
    have h_eq : cx = cy := hSubIC.elim cx cy
    have h_cl : closure ({x} : Set X) = closure ({y} : Set X) := congrArg (·.carrier) h_eq
    exact (inseparable_iff_closure_eq.mpr h_cl).eq⟩
  obtain ⟨x₀⟩ : Nonempty X := IrreducibleSpace.toNonempty
  obtain ⟨U_a, hAffUa, hx₀Ua, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := X) (x := x₀) (U := ⊤) trivial
  have hUa_top : U_a = ⊤ := by
    ext z
    constructor
    · intro _
      trivial
    · intro _
      rw [Subsingleton.elim z x₀]
      exact hx₀Ua
  have hAffTop : AlgebraicGeometry.IsAffineOpen (⊤ : X.Opens) := hUa_top ▸ hAffUa
  have : IsIso (⊤ : X.Opens).toSpecΓ := by
    rw [← hAffTop.isoSpec_hom]
    infer_instance
  have hToSpecEq : X.toSpecΓ = X.topIso.inv ≫ (⊤ : X.Opens).toSpecΓ := by
    rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_top]
    change X.toSpecΓ = X.topIso.inv ≫ X.topIso.hom ≫ X.toSpecΓ
    rw [Iso.inv_hom_id_assoc]
  have : IsIso X.toSpecΓ := by
    rw [hToSpecEq]
    infer_instance
  have : AlgebraicGeometry.IsAffine X := ⟨inferInstance⟩

  
  have hFTV : AlgebraicGeometry.LocallyOfFiniteType V.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProjV
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  
  let R := CommRingCat.of k
  let A_cat := X.presheaf.obj (Opposite.op ⊤)
  let φ_k : R ⟶ A_cat :=
    (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ AlgebraicGeometry.Scheme.Hom.appTop V.hom
  have hFactorV : V.hom = X.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ_k := by
    have hNat := AlgebraicGeometry.Scheme.toSpecΓ_naturality V.hom
    rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom R] at hNat
    have hNat2 := hNat =≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv
    have hLHS : V.hom ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).hom ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv = V.hom := by
      rw [← AlgebraicGeometry.Spec.map_comp, Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id,
        Category.comp_id]
    rw [Category.assoc, hLHS, Category.assoc, ← AlgebraicGeometry.Spec.map_comp] at hNat2
    exact hNat2
  have hFT_app : (AlgebraicGeometry.Scheme.Hom.appTop V.hom).hom.FiniteType :=
    AlgebraicGeometry.HasRingHomProperty.appTop (@AlgebraicGeometry.LocallyOfFiniteType) V.hom hFTV
  have hSurjΓ : Function.Surjective ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv).hom := by
    intro y
    refine ⟨((AlgebraicGeometry.Scheme.ΓSpecIso R).hom).hom y, ?_⟩
    change (((AlgebraicGeometry.Scheme.ΓSpecIso R).hom ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso R).inv).hom) y = y
    rw [Iso.hom_inv_id]
    rfl
  have hFT_φk : φ_k.hom.FiniteType := by
    change ((AlgebraicGeometry.Scheme.Hom.appTop V.hom).hom.comp
      ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv).hom).FiniteType
    exact RingHom.FiniteType.comp hFT_app (RingHom.FiniteType.of_surjective _ hSurjΓ)
  let A : Type u := ↑A_cat
  have : IsDomain A :=
    @AlgebraicGeometry.IsIntegral.component_integral X hIntV ⊤ ⟨⟨x₀, trivial⟩⟩
  have hSubSpec : Subsingleton (PrimeSpectrum A) := ⟨fun p q => by
    let p' : ↥(AlgebraicGeometry.Spec A_cat) := p
    let q' : ↥(AlgebraicGeometry.Spec A_cat) := q
    have hpq : X.isoSpec.inv.base p' = X.isoSpec.inv.base q' := Subsingleton.elim _ _
    have hpq2 := congrArg X.isoSpec.hom.base hpq
    change (X.isoSpec.inv ≫ X.isoSpec.hom).base p' =
      (X.isoSpec.inv ≫ X.isoSpec.hom).base q' at hpq2
    rw [Iso.inv_hom_id] at hpq2
    exact hpq2⟩
  have hBotPrime : (⊥ : Ideal A).IsPrime :=
    ⟨bot_ne_top, fun {x y} hxy => by
      rcases mul_eq_zero.mp (Ideal.mem_bot.mp hxy) with rfl | rfl
      · exact Or.inl (Ideal.mem_bot.mpr rfl)
      · exact Or.inr (Ideal.mem_bot.mpr rfl)⟩
  have hFieldA : IsField A :=
    { exists_pair_ne := ⟨0, 1, zero_ne_one⟩
      mul_comm := mul_comm
      mul_inv_cancel := fun {a} ha => by
        have hUnit : IsUnit a := by
          by_contra hNotUnit
          have hNeTop : Ideal.span ({a} : Set A) ≠ ⊤ :=
            mt Ideal.span_singleton_eq_top.mp hNotUnit
          obtain ⟨𝔪, hMax, hLe⟩ := Ideal.exists_le_maximal _ hNeTop
          have hEqSpec : (⟨𝔪, hMax.isPrime⟩ : PrimeSpectrum A) = ⟨⊥, hBotPrime⟩ :=
            hSubSpec.elim _ _
          have hEqIdeal : 𝔪 = ⊥ := congrArg PrimeSpectrum.asIdeal hEqSpec
          have haMem : a ∈ (⊥ : Ideal A) := hEqIdeal ▸ hLe (Ideal.subset_span rfl)
          exact ha (Ideal.mem_bot.mp haMem)
        obtain ⟨u, rfl⟩ := hUnit
        exact ⟨↑u⁻¹, Units.mul_inv u⟩ }
  let : Algebra k A := φ_k.hom.toAlgebra
  have hAlgMap : algebraMap k A = φ_k.hom := rfl
  have hFTA : Algebra.FiniteType k A := hFT_φk
  obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFTA
  let I : Ideal (MvPolynomial (Fin n) k) := RingHom.ker g
  let eQuot : (MvPolynomial (Fin n) k ⧸ I) ≃ₐ[k] A :=
    Ideal.quotientKerAlgEquivOfSurjective hg
  have hFieldQuot : IsField (MvPolynomial (Fin n) k ⧸ I) :=
    MulEquiv.isField hFieldA eQuot.toRingEquiv.toMulEquiv
  have hMaxI : I.IsMaximal :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient I).mpr hFieldQuot
  obtain ⟨c, hcI⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hMaxI
  have hSurjφ : Function.Surjective φ_k.hom := by
    intro y
    obtain ⟨p, rfl⟩ := hg y
    refine ⟨MvPolynomial.aeval c p, ?_⟩
    let q : MvPolynomial (Fin n) k := p - MvPolynomial.C (MvPolynomial.aeval c p)
    have hq_eval : MvPolynomial.aeval c q = 0 := by
      simp [q]
    have hq_mem : q ∈ I := by
      rw [hcI, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      exact hq_eval
    have hgq : g q = 0 := RingHom.mem_ker.mp hq_mem
    have hsub : g p - φ_k.hom (MvPolynomial.aeval c p) = 0 := by
      simpa [q, map_sub, AlgHom.commutes, hAlgMap] using hgq
    exact (sub_eq_zero.mp hsub).symm
  have hBijφ : Function.Bijective φ_k.hom := ⟨φ_k.hom.injective, hSurjφ⟩
  have : IsIso (AlgebraicGeometry.Spec.map φ_k) :=
    AlgebraicGeometry.isIso_SpecMap_iff.mpr hBijφ
  have : IsIso V.hom := by
    rw [hFactorV]
    infer_instance

  
  have hSnc : IsSncDivisorSupport k 0 V (∅ : Set V.left) := by
    refine ⟨0, Fin.elim0, fun i => Fin.elim0 i,
      fun i => Fin.elim0 i,
      fun i => Fin.elim0 i,
      fun i => Fin.elim0 i,
      by simp, ?_⟩
    intro x
    refine ⟨⊤, hAffTop, trivial, ?_⟩
    let ψ : MvPolynomial (Fin 0) k →+* ↑(V.left.presheaf.obj (Opposite.op ⊤)) :=
      φ_k.hom.comp (MvPolynomial.isEmptyRingEquiv k (Fin 0)).toRingHom
    have hBijψ : Function.Bijective ψ :=
      hBijφ.comp (MvPolynomial.isEmptyRingEquiv k (Fin 0)).bijective
    have : IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
      AlgebraicGeometry.isIso_SpecMap_iff.mpr hBijψ
    refine ⟨ψ, inferInstance, ?_, fun z => Fin.elim0 z.1, fun z => Fin.elim0 z.1,
      fun i => Fin.elim0 i⟩
    have hψC : CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 0) k) ≫
        CommRingCat.ofHom ψ = φ_k := by
      ext c
      simp [ψ]
    rw [← AlgebraicGeometry.Spec.map_comp, hψC,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_top, Category.assoc, ← hFactorV]
  have hAltId : IsGenFiniteEtaleAlterationOver k (𝟙 V) := by
    refine ⟨?_, ?_, U_V, hUV, ?_, ?_, ?_⟩
    · change AlgebraicGeometry.IsProper (𝟙 V.left)
      infer_instance
    · change AlgebraicGeometry.Surjective (𝟙 V.left)
      infer_instance
    · change AlgebraicGeometry.IsFinite ((𝟙 V.left) ∣_ U_V)
      infer_instance
    · change AlgebraicGeometry.Etale ((𝟙 V.left) ∣_ U_V)
      infer_instance
    · change AlgebraicGeometry.Surjective ((𝟙 V.left) ∣_ U_V)
      infer_instance
  refine ⟨V, ∅, 𝟙 V, hIntV, hProjV, inferInstance, hSnc, hAltId, ?_⟩
  intro z hz
  obtain ⟨u₀, hu₀⟩ := hUV
  have h_eq : (CategoryTheory.Over.Hom.left (𝟙 V)).base z = u₀ := hSubV.elim _ _
  apply hz
  rw [h_eq]
  exact hu₀

theorem weil_projectiveSpace_integral_krullDim_and_dim_zero_iso (k : Type u) [Field k] (m : ℕ) :
    AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k m).left ∧
    IsProjectiveOverField k (weilProjectiveSpaceOver k m) ∧
    topologicalKrullDim (weilProjectiveSpaceOver k m).left = (m : WithBot ℕ∞) ∧
    (m = 0 → CategoryTheory.IsIso (weilProjectiveSpaceOver k m).hom) :=
by
  
  have hChartEquiv : ∀ (m' : ℕ) (a : Fin (m' + 1)),
      let 𝒜' := MvPolynomial.homogeneousSubmodule (Fin (m' + 1)) k
      let _ : GradedAlgebra 𝒜' := MvPolynomial.gradedAlgebra
      ∃ (e : MvPolynomial {b : Fin (m' + 1) // b ≠ a} k ≃+*
          HomogeneousLocalization.Away 𝒜' (MvPolynomial.X a)),
        ∀ c : k,
          e (MvPolynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom 𝒜'
              (Submonoid.powers (MvPolynomial.X a))
              (algebraMap k ↥(𝒜' 0) c) := by
    intro m' a
    let P := MvPolynomial (Fin (m' + 1)) k
    let 𝒜' := MvPolynomial.homogeneousSubmodule (Fin (m' + 1)) k
    let _ : GradedAlgebra 𝒜' := MvPolynomial.gradedAlgebra
    let Xa : P := MvPolynomial.X a
    let S : Submonoid P := Submonoid.powers Xa
    let τ := {b : Fin (m' + 1) // b ≠ a}
    let Pτ := MvPolynomial τ k
    let Ra := HomogeneousLocalization.Away 𝒜' Xa
    have hX : ∀ j : Fin (m' + 1), MvPolynomial.X j ∈ 𝒜' 1 := fun j =>
      (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X j)).mpr
        (MvPolynomial.isHomogeneous_X k j)
    let ι_k : k →+* Ra :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜' S).comp (algebraMap k ↥(𝒜' 0))
    let u : τ → Ra := fun b =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X b.1, hX b.1⟩, ⟨Xa, hX a⟩, Submonoid.mem_powers Xa⟩
    let α : Pτ →+* Ra := MvPolynomial.eval₂Hom ι_k u
    let w : Fin (m' + 1) → Pτ := fun j =>
      if h : j = a then 1 else MvPolynomial.X ⟨j, h⟩
    let dehom : P →+* Pτ := MvPolynomial.eval₂Hom MvPolynomial.C w
    have hdehom_S : ∀ y : S, dehom y.1 = 1 := by
      intro y
      obtain ⟨n, hn⟩ := y.2
      have hn' : Xa ^ n = y.1 := hn
      rw [← hn', map_pow]
      have hXa_one : dehom Xa = 1 := by
        change MvPolynomial.eval₂Hom MvPolynomial.C w (MvPolynomial.X a) = 1
        rw [MvPolynomial.eval₂Hom_X']
        simp only [w, ↓reduceDIte]
      rw [hXa_one, one_pow]
    have hUnit : ∀ y : S, IsUnit (dehom y.1) := fun y => by
      rw [hdehom_S y]
      exact isUnit_one
    let β_loc : Localization S →+* Pτ := IsLocalization.lift hUnit
    have hβ_loc_mk : ∀ (p : P) (y : S), β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hUnit p (dehom p) y).mpr
        (by rw [hdehom_S y, one_mul])
    let valHom : Ra →+* Localization S :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let β : Ra →+* Pτ := β_loc.comp valHom
    have hLeft : ∀ q : Pτ, β (α q) = q := by
      have hcomp : β.comp α = RingHom.id Pτ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change β_loc (α (MvPolynomial.C c)).val = MvPolynomial.C c
          rw [MvPolynomial.eval₂Hom_C]
          have hval_c : (ι_k c).val = Localization.mk (MvPolynomial.C c) 1 := rfl
          rw [hval_c, hβ_loc_mk]
          exact MvPolynomial.eval₂Hom_C MvPolynomial.C w c
        · intro b
          change β_loc (α (MvPolynomial.X b)).val = MvPolynomial.X b
          rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.val_mk, hβ_loc_mk,
            MvPolynomial.eval₂Hom_X']
          simp only [w, b.2, ↓reduceDIte]
          rfl
      intro q
      exact DFunLike.congr_fun hcomp q
    have hRight : ∀ z : Ra, α (β z) = z := by
      let φ : P →+* Localization S := valHom.comp (α.comp dehom)
      have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        change (α (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) 1
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        rfl
      have hφ_X : ∀ j : Fin (m' + 1),
          φ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) ⟨Xa, Submonoid.mem_powers Xa⟩ := by
        intro j
        change (α (dehom (MvPolynomial.X j))).val = _
        rw [MvPolynomial.eval₂Hom_X']
        by_cases hj : j = a
        · subst hj
          simp only [w, ↓reduceDIte, map_one, HomogeneousLocalization.val_one]
          exact (Localization.mk_self ⟨Xa, Submonoid.mem_powers Xa⟩).symm
        · simp only [w, hj, ↓reduceDIte]
          change (α (MvPolynomial.X ⟨j, hj⟩)).val = _
          rw [MvPolynomial.eval₂Hom_X']
          exact HomogeneousLocalization.val_mk _
      have hφ_prod : ∀ (d : Fin (m' + 1) →₀ ℕ) (s : Finset (Fin (m' + 1))),
          φ (∏ j ∈ s, MvPolynomial.X j ^ d j) =
            Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
              ⟨Xa ^ (∑ j ∈ s, d j), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
        intro d s
        induction s using Finset.induction_on with
        | empty =>
          simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
          exact (Localization.mk_one).symm
        | insert j s hjs ih =>
          rw [Finset.prod_insert hjs, Finset.sum_insert hjs, map_mul, map_pow, hφ_X j,
            Localization.mk_pow, ih, Localization.mk_mul]
          congr 1
          apply Subtype.ext
          exact (pow_add Xa (d j) (∑ i ∈ s, d i)).symm
      have hweight : ∀ d : Fin (m' + 1) →₀ ℕ,
          (Finsupp.weight 1) d = ∑ j ∈ d.support, d j := by
        intro d
        simp [Finsupp.weight_apply, Finsupp.sum]
      have hφ_monomial : ∀ (d : Fin (m' + 1) →₀ ℕ) (c : k),
          φ (MvPolynomial.monomial d c) =
            Localization.mk (MvPolynomial.monomial d c)
              ⟨Xa ^ ((Finsupp.weight 1) d), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
        intro d c
        rw [MvPolynomial.monomial_eq, map_mul, hφ_C]
        change Localization.mk (MvPolynomial.C c) 1 *
            φ (∏ j ∈ d.support, MvPolynomial.X j ^ d j) = _
        rw [hφ_prod d d.support, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        change 1 * Xa ^ (∑ j ∈ d.support, d j) = Xa ^ ((Finsupp.weight 1) d)
        rw [one_mul, hweight d]
      have h_sum_mk : ∀ (s : Finset (Fin (m' + 1) →₀ ℕ))
          (g : (Fin (m' + 1) →₀ ℕ) → P) (y : S),
          ∑ d ∈ s, Localization.mk (g d) y = Localization.mk (∑ d ∈ s, g d) y := by
        intro s g y
        induction s using Finset.induction_on with
        | empty =>
          simp [Localization.mk_zero]
        | insert d s hds ih =>
          rw [Finset.sum_insert hds, Finset.sum_insert hds, ih, Localization.add_mk_self]
      have hφ_homog : ∀ (n : ℕ) (p : P), p.IsHomogeneous n →
          φ p = Localization.mk p ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩ := by
        intro n p hp
        conv_lhs => rw [MvPolynomial.as_sum p]
        rw [map_sum]
        have hterms : ∀ d ∈ p.support,
            φ (MvPolynomial.monomial d (p.coeff d)) =
              Localization.mk (MvPolynomial.monomial d (p.coeff d))
                ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩ := by
          intro d hd
          rw [hφ_monomial]
          have hdn : (Finsupp.weight 1) d = n := hp (MvPolynomial.mem_support_iff.mp hd)
          congr 1
          apply Subtype.ext
          change Xa ^ ((Finsupp.weight 1) d) = Xa ^ n
          rw [hdn]
        rw [Finset.sum_congr rfl hterms, h_sum_mk, ← MvPolynomial.as_sum p]
      intro z
      refine Quotient.inductionOn' z fun nd => ?_
      obtain ⟨n, hn⟩ := nd.den_mem
      have hn' : Xa ^ n = nd.den.1 := hn
      have hXa_pow_ne : Xa ^ n ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) h0
        simp [Xa] at hev
      have hex_d : ∃ d₀, (Xa ^ n).coeff d₀ ≠ 0 := by
        by_contra h_all
        push Not at h_all
        exact hXa_pow_ne (MvPolynomial.ext_iff.mpr fun d => by simp [h_all d])
      obtain ⟨d₀, hd₀⟩ := hex_d
      have hden_homog : (Xa ^ n).IsHomogeneous nd.deg := by
        rw [hn']
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
      have hXa_homog : (Xa ^ n).IsHomogeneous n := by
        simpa using (MvPolynomial.isHomogeneous_X k a).pow n
      have hdeg_eq : nd.deg = n := (hden_homog hd₀).symm.trans (hXa_homog hd₀)
      have hnum_homog : nd.num.1.IsHomogeneous n := by
        rw [← hdeg_eq]
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
      apply HomogeneousLocalization.val_injective
      have hβ_mk : β (HomogeneousLocalization.mk nd) = dehom nd.num.1 := by
        change β_loc (HomogeneousLocalization.mk nd).val = dehom nd.num.1
        rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
      rw [hβ_mk]
      change φ nd.num.1 = (HomogeneousLocalization.mk nd).val
      rw [hφ_homog n nd.num.1 hnum_homog, HomogeneousLocalization.val_mk]
      congr 1
      apply Subtype.ext
      exact hn'
    let e : Pτ ≃+* Ra :=
      { α with
        invFun := β
        left_inv := hLeft
        right_inv := hRight }
    exact ⟨e, fun c => MvPolynomial.eval₂Hom_C ι_k u c⟩

  
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hIrrelAndIrred :
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (m + 1) → MvPolynomial (Fin (m + 1)) k)) ∧
      IrreducibleSpace (ProjectiveSpectrum 𝒜) := by
    refine ⟨?_, ?_⟩
    · intro p hp
      have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hp_coeff0 : p.coeff 0 = 0 := by
        classical
        have hdecomp : p = ∑ i ∈ (DirectSum.decompose 𝒜 p).support,
            (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (m + 1)) k) :=
          (DirectSum.sum_support_decompose 𝒜 p).symm
        conv_lhs => rw [hdecomp]
        rw [MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro i _
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin (m + 1)) k) = 0 := by
            rw [← GradedRing.proj_apply]
            exact hp0_proj
          simp [h0]
        · by_contra hne
          have hmem : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (m + 1)) k) ∈ 𝒜 i :=
            Subtype.prop _
          have hhom : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (m + 1)) k).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem
          have hw0 : (Finsupp.weight 1) (0 : Fin (m + 1) →₀ ℕ) = i := hhom hne
          simp at hw0
          exact hi hw0.symm
      have hrange : Set.range (MvPolynomial.X : Fin (m + 1) → MvPolynomial (Fin (m + 1)) k) =
          MvPolynomial.X '' (Set.univ : Set (Fin (m + 1))) := by
        simp
      rw [hrange, MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      have hd_ne : p.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
      have hd_ne_zero : d ≠ 0 := by
        intro h0
        subst h0
        exact hd_ne hp_coeff0
      have hex_i : ∃ i : Fin (m + 1), d i ≠ 0 := by
        by_contra hall
        push Not at hall
        exact hd_ne_zero (Finsupp.ext hall)
      obtain ⟨i, hi⟩ := hex_i
      exact ⟨i, Set.mem_univ i, hi⟩
    · have hPrimeBot : (⊥ : HomogeneousIdeal 𝒜).toIdeal.IsPrime := by
        rw [HomogeneousIdeal.toIdeal_bot]
        exact Ideal.isPrime_bot
      have hNotIrrel : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥ := by
        intro hle
        let X0 : MvPolynomial (Fin (m + 1)) k := MvPolynomial.X 0
        have hX0_mem1 : X0 ∈ 𝒜 1 :=
          (MvPolynomial.mem_homogeneousSubmodule 1 X0).mpr (MvPolynomial.isHomogeneous_X k 0)
        have hX0_irrel : X0 ∈ HomogeneousIdeal.irrelevant 𝒜 := by
          rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
          exact DirectSum.decompose_of_mem_ne 𝒜 hX0_mem1 (by decide : (1 : ℕ) ≠ 0)
        have hX0_bot : X0 ∈ (⊥ : HomogeneousIdeal 𝒜) := hle hX0_irrel
        have hX0_zero : X0 = 0 := by
          change X0 ∈ (⊥ : HomogeneousIdeal 𝒜).toIdeal at hX0_bot
          rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at hX0_bot
          exact hX0_bot
        have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) hX0_zero
        simp [X0] at hev
      let η₀ : ProjectiveSpectrum 𝒜 := ⟨⊥, hPrimeBot, hNotIrrel⟩
      have hη_mem : ∀ (W : Set (ProjectiveSpectrum 𝒜)), IsOpen W → W.Nonempty → η₀ ∈ W := by
        intro W hW ⟨z, hz⟩
        obtain ⟨s, hs⟩ := (ProjectiveSpectrum.isOpen_iff 𝒜 W).mp hW
        by_contra hηW
        have hηWc : η₀ ∈ Wᶜ := hηW
        rw [hs, ProjectiveSpectrum.mem_zeroLocus] at hηWc
        have hzWc : z ∈ ProjectiveSpectrum.zeroLocus 𝒜 s := by
          rw [ProjectiveSpectrum.mem_zeroLocus]
          intro f hf
          have hf_bot : f ∈ (⊥ : HomogeneousIdeal 𝒜) := hηWc hf
          have hf_zero : f = 0 := by
            change f ∈ (⊥ : HomogeneousIdeal 𝒜).toIdeal at hf_bot
            rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at hf_bot
            exact hf_bot
          rw [hf_zero]
          exact zero_mem _
        rw [← hs] at hzWc
        exact hzWc hz
      exact
        { isPreirreducible_univ := fun U V hU hV ⟨u, _, hu⟩ ⟨v, _, hv⟩ =>
            ⟨η₀, trivial, hη_mem U hU ⟨u, hu⟩, hη_mem V hV ⟨v, hv⟩⟩
          toNonempty := ⟨η₀⟩ }

  
  have hOpenCoverKrullDim :
      ∀ (T : Type u) [TopologicalSpace T] {ι : Type} [Nonempty ι]
        (V_cov : ι → TopologicalSpace.Opens T),
        iSup V_cov = ⊤ →
        (∀ i : ι, topologicalKrullDim ↥(V_cov i) = (m : WithBot ℕ∞)) →
        topologicalKrullDim T = (m : WithBot ℕ∞) := by
    intro T _ ι hne V_cov hCov hDim
    apply le_antisymm
    · change Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ (m : WithBot ℕ∞)
      refine iSup_le fun (p : LTSeries (TopologicalSpace.IrreducibleCloseds T)) => ?_
      obtain ⟨x₀, hx₀⟩ := (p 0).isIrreducible'.nonempty
      have hx₀_top : x₀ ∈ (⊤ : TopologicalSpace.Opens T) := trivial
      rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx₀_top
      obtain ⟨i, hx₀U⟩ := hx₀_top
      let y₀ : ↥(V_cov i) := ⟨x₀, hx₀U⟩
      let S_fun : Fin (p.length + 1) → Set ↥(V_cov i) := fun r =>
        Subtype.val ⁻¹' (p r : Set T)
      have hCl : ∀ r : Fin (p.length + 1), IsClosed (S_fun r) := fun r =>
        (p r).isClosed'.preimage continuous_subtype_val
      have hNonempty : ∀ r : Fin (p.length + 1), (S_fun r).Nonempty := fun r =>
        ⟨y₀, p.monotone (Fin.zero_le r) hx₀⟩
      have hPre : ∀ r : Fin (p.length + 1), IsPreirreducible (S_fun r) := fun r =>
        IsPreirreducible.preimage (p r).isIrreducible'.isPreirreducible
          (V_cov i).isOpen.isOpenEmbedding_subtypeVal
      let q_fun : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥(V_cov i) :=
        fun r => ⟨S_fun r, ⟨hNonempty r, hPre r⟩, hCl r⟩
      have hStep : ∀ r : Fin p.length, q_fun r.castSucc < q_fun r.succ := by
        intro r
        have hlt_r : p r.castSucc < p r.succ := p.step r
        refine lt_of_le_not_ge ?_ ?_
        · intro y hy
          exact hlt_r.le hy
        · intro hle
          have hsub_union :
              (p r.succ : Set T) ⊆ (p r.castSucc : Set T) ∪ (V_cov i : Set T)ᶜ := by
            intro z hz
            by_cases hzU : z ∈ V_cov i
            · exact Or.inl (hle (show (⟨z, hzU⟩ : ↥(V_cov i)) ∈ S_fun r.succ from hz))
            · exact Or.inr hzU
          have hunion :=
            (isPreirreducible_iff_isClosed_union_isClosed.mp
              (p r.succ).isIrreducible'.isPreirreducible)
              (p r.castSucc : Set T) ((V_cov i : Set T)ᶜ)
              (p r.castSucc).isClosed' (V_cov i).isOpen.isClosed_compl hsub_union
          rcases hunion with hle_p | hcompl
          · exact not_le_of_gt hlt_r hle_p
          · have hx₀_succ : x₀ ∈ (p r.succ : Set T) :=
              p.monotone (Fin.zero_le r.succ) hx₀
            exact hcompl hx₀_succ hx₀U
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(V_cov i)) :=
        ⟨p.length, q_fun, hStep⟩
      have hlen : (q.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥(V_cov i) :=
        Order.LTSeries.length_le_krullDim q
      simpa [q, hDim i] using hlen
    · obtain ⟨i₀⟩ := hne
      rw [← hDim i₀]
      exact topologicalKrullDim_subspace_le T (V_cov i₀ : Set T)

  
  let B₀ := weilProjectiveSpaceOver k m
  let U : Fin (m + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
  have hCov : iSup U = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrelAndIrred.1
  have hXa : ∀ a : Fin (m + 1), MvPolynomial.X a ∈ 𝒜 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X a)).mpr
      (MvPolynomial.isHomogeneous_X k a)
  have hChartIso : ∀ a : Fin (m + 1),
      Nonempty ((U a).toScheme ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {b : Fin (m + 1) // b ≠ a} k))) := by
    intro a
    obtain ⟨e_a, _⟩ := hChartEquiv m a
    exact ⟨AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hXa a) zero_lt_one ≪≫
      CategoryTheory.asIso (AlgebraicGeometry.Spec.map e_a.toCommRingCatIso.hom)⟩

  
  have hIntB₀ : AlgebraicGeometry.IsIntegral B₀.left := by
    have hRedChart : ∀ a : Fin (m + 1), AlgebraicGeometry.IsReduced (U a).toScheme := by
      intro a
      obtain ⟨iso_a⟩ := hChartIso a
      exact AlgebraicGeometry.isReduced_of_isOpenImmersion iso_a.hom
    let 𝒰 := (AlgebraicGeometry.Proj 𝒜).openCoverOfIsOpenCover U
      (TopologicalSpace.IsOpenCover.mk hCov)
    have hRedCover : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := by
      intro i
      rw [(AlgebraicGeometry.Proj 𝒜).openCoverOfIsOpenCover_X U
        (TopologicalSpace.IsOpenCover.mk hCov) i]
      exact hRedChart i
    have hRedProj : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Proj 𝒜) :=
      @AlgebraicGeometry.IsReduced.of_openCover (AlgebraicGeometry.Proj 𝒜) 𝒰 hRedCover
    have hIrredProj : IrreducibleSpace ↥(AlgebraicGeometry.Proj 𝒜) := hIrrelAndIrred.2
    exact @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced
      (AlgebraicGeometry.Proj 𝒜) hRedProj hIrredProj

  
  have hProjB₀ : IsProjectiveOverField k B₀ := by
    refine ⟨m, 𝟙 B₀, ?_⟩
    change AlgebraicGeometry.IsClosedImmersion (𝟙 B₀.left)
    infer_instance

  
  have hDimB₀ : topologicalKrullDim B₀.left = (m : WithBot ℕ∞) := by
    have hDimChart : ∀ a : Fin (m + 1), topologicalKrullDim ↥(U a) = (m : WithBot ℕ∞) := by
      intro a
      obtain ⟨iso_a⟩ := hChartIso a
      let P_a := MvPolynomial {b : Fin (m + 1) // b ≠ a} k
      have hHomeo := (AlgebraicGeometry.Scheme.homeoOfIso iso_a).isHomeomorph.topologicalKrullDim_eq
      change topologicalKrullDim ↥(U a).toScheme = (m : WithBot ℕ∞)
      rw [hHomeo]
      change topologicalKrullDim (PrimeSpectrum P_a) = (m : WithBot ℕ∞)
      rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim P_a,
        MvPolynomial.ringKrullDim_of_isNoetherianRing,
        ringKrullDim_eq_zero_of_field k, zero_add,
        ENat.card_eq_coe_fintype_card]
      have hUniq : Unique {b : Fin (m + 1) // b = a} :=
        { default := ⟨a, rfl⟩
          uniq := fun ⟨_, hb⟩ => Subtype.ext hb }
      have hcard : Fintype.card {b : Fin (m + 1) // b ≠ a} = m := by
        have hc := @Fintype.card_subtype_compl (Fin (m + 1)) _ (fun b => b = a) _ _
        have hc1 : Fintype.card {b : Fin (m + 1) // b = a} = 1 :=
          @Fintype.card_unique {b : Fin (m + 1) // b = a} hUniq _
        rw [Fintype.card_fin, hc1, Nat.add_sub_cancel] at hc
        exact hc
      rw [hcard]
      rfl
    have _ : Nonempty (Fin (m + 1)) := ⟨0⟩
    exact hOpenCoverKrullDim ↥(AlgebraicGeometry.Proj 𝒜) U hCov hDimChart

  
  have hIsoZero : m = 0 → CategoryTheory.IsIso B₀.hom := by
    intro hm
    subst hm
    have hU0_top : U 0 = ⊤ := by
      ext x
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      have hx : x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
      rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx
      obtain ⟨a, ha⟩ := hx
      rwa [Fin.eq_zero a] at ha
    have hAwayEq : AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one).inv ≫
          ((AlgebraicGeometry.Proj 𝒜).isoOfEq hU0_top).hom ≫
          (AlgebraicGeometry.Proj 𝒜).topIso.hom := by
      rw [AlgebraicGeometry.Scheme.topIso_hom, AlgebraicGeometry.Scheme.isoOfEq_hom_ι,
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one) := by
      rw [hAwayEq]
      infer_instance
    have _ : IsEmpty {b : Fin 1 // b ≠ 0} := ⟨fun ⟨b, hb⟩ => hb (Fin.eq_zero b)⟩
    obtain ⟨e₀, he₀⟩ := hChartEquiv 0 0
    let e_k : k ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) :=
      (MvPolynomial.isEmptyRingEquiv k {b : Fin 1 // b ≠ 0}).symm.trans e₀
    have hHomEq :
        CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X 0))) =
        e_k.toCommRingCatIso.hom := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X 0)) (algebraMap k ↥(𝒜 0) c) = e_k c
      symm
      change e₀ ((MvPolynomial.isEmptyRingEquiv k {b : Fin 1 // b ≠ 0}).symm c) = _
      rw [MvPolynomial.isEmptyRingEquiv_symm_apply]
      exact he₀ c
    have hCompEq :
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one ≫ B₀.hom =
          AlgebraicGeometry.Spec.map e_k.toCommRingCatIso.hom := by
      change AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
        hHomEq]
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one ≫ B₀.hom) := by
      rw [hCompEq]
      infer_instance
    exact CategoryTheory.IsIso.of_isIso_comp_left
      (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hXa 0) zero_lt_one) B₀.hom

  exact ⟨hIntB₀, hProjB₀, hDimB₀, hIsoZero⟩

theorem weil_algClosed_finiteType_domain_integralClosure_finite (k : Type u) [Field k] [IsAlgClosed k]
    (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] :
    Module.Finite A ↥(integralClosure A K) ∧
    IsIntegrallyClosed ↥(integralClosure A K) :=
by
  refine ⟨?_, integralClosure.isIntegrallyClosedOfFiniteExtension K⟩
  
  have hFrobSpan : ∀ (s p e : ℕ) [ExpChar k p],
      ∃ (m : ℕ) (u : Fin m → MvPolynomial (Fin s) k),
        ∀ f : MvPolynomial (Fin s) k,
          ∃ q : Fin m → MvPolynomial (Fin s) k,
            f = ∑ j : Fin m, (q j) ^ (p ^ e) * u j := by
    intro s p e _
    let Q : ℕ := p ^ e
    have hQ : 0 < Q := pow_pos (expChar_pos k p) e
    have : ExpChar (MvPolynomial (Fin s) k) p :=
      expChar_of_injective_algebraMap (MvPolynomial.C_injective (Fin s) k) p
    have : PerfectField k := IsAlgClosed.perfectField k
    have : PerfectRing k p := PerfectField.toPerfectRing p
    let φ_k : k ≃+* k := iterateFrobeniusEquiv k p e
    let u₀ : (Fin s → Fin Q) → MvPolynomial (Fin s) k :=
      fun r => ∏ i : Fin s, MvPolynomial.X i ^ (r i).1
    have h_ind : ∀ f : MvPolynomial (Fin s) k,
        ∃ q₀ : (Fin s → Fin Q) → MvPolynomial (Fin s) k,
          f = ∑ r : Fin s → Fin Q, (q₀ r) ^ Q * u₀ r := by
      intro f
      refine MvPolynomial.induction_on' f ?_ ?_
      · intro d c
        let r_d : Fin s → Fin Q := fun i => ⟨d i % Q, Nat.mod_lt (d i) hQ⟩
        let c₀ : k := φ_k.symm c
        have hc₀ : c₀ ^ Q = c := by
          have h1 : φ_k c₀ = c := φ_k.apply_symm_apply c
          rwa [iterateFrobeniusEquiv_def] at h1
        let g_d : MvPolynomial (Fin s) k :=
          MvPolynomial.C c₀ * ∏ i : Fin s, MvPolynomial.X i ^ (d i / Q)
        classical
        refine ⟨fun r => if r = r_d then g_d else 0, ?_⟩
        rw [Finset.sum_eq_single r_d]
        · simp only [↓reduceIte]
          have h_mon : (MvPolynomial.monomial d c : MvPolynomial (Fin s) k) =
              MvPolynomial.C c * ∏ i : Fin s, (MvPolynomial.X i : MvPolynomial (Fin s) k) ^ d i := by
            rw [MvPolynomial.monomial_eq,
              Finsupp.prod_fintype d (fun i n => (MvPolynomial.X i : MvPolynomial (Fin s) k) ^ n)
                (fun _ => pow_zero _)]
          rw [h_mon]
          have hg_pow : g_d ^ Q =
              MvPolynomial.C c *
                ∏ i : Fin s, (MvPolynomial.X i : MvPolynomial (Fin s) k) ^ (Q * (d i / Q)) := by
            dsimp [g_d]
            rw [mul_pow, ← map_pow MvPolynomial.C, hc₀, ← Finset.prod_pow]
            congr 1
            refine Finset.prod_congr rfl (fun i _ => ?_)
            rw [← pow_mul, mul_comm]
          rw [hg_pow, mul_assoc]
          congr 1
          rw [← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl (fun i _ => ?_)
          dsimp [r_d]
          rw [← pow_add, Nat.div_add_mod (d i) Q]
        · intro r _ hr
          simp [hr, zero_pow hQ.ne']
        · intro h_abs
          exact absurd (Finset.mem_univ r_d) h_abs
      · intro f₁ f₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
        refine ⟨fun r => q₁ r + q₂ r, ?_⟩
        rw [hq₁, hq₂, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun r _ => ?_)
        have h_add_pow : (q₁ r + q₂ r) ^ Q = q₁ r ^ Q + q₂ r ^ Q := by
          have hm := map_add (iterateFrobenius (MvPolynomial (Fin s) k) p e) (q₁ r) (q₂ r)
          simpa only [iterateFrobenius_def, Q] using hm
        rw [h_add_pow, right_distrib]
    let m := Fintype.card (Fin s → Fin Q)
    let e_fin : (Fin s → Fin Q) ≃ Fin m := Fintype.equivFin (Fin s → Fin Q)
    refine ⟨m, fun j => u₀ (e_fin.symm j), fun f => ?_⟩
    obtain ⟨q₀, hq₀⟩ := h_ind f
    refine ⟨fun j => q₀ (e_fin.symm j), ?_⟩
    rw [hq₀]
    exact (Equiv.sum_comp e_fin.symm (fun r => q₀ r ^ Q * u₀ r)).symm

  
  have hFrobFinite : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
      [IsNoetherianRing R] (F : Type u) [Field F] [Algebra R F] [IsFractionRing R F]
      (L : Type u) [Field L] [Algebra R L] [Algebra F L] [IsScalarTower R F L]
      [FiniteDimensional F L] (p : ℕ) [ExpChar R p],
      (∀ e : ℕ, ∃ (m : ℕ) (u : Fin m → R),
        ∀ r : R, ∃ q : Fin m → R, r = ∑ j : Fin m, (q j) ^ (p ^ e) * u j) →
      Module.Finite R ↥(integralClosure R L) := by
    intro R _ _ _ _ F _ _ _ L _ _ _ _ _ p _ hSpan
    let M : IntermediateField F L := separableClosure F L
    have hFinM : Module.Finite R ↥(integralClosure R ↥M) :=
      IsIntegralClosure.finite R F ↥M ↥(integralClosure R ↥M)
    obtain ⟨n, f_surj, hf_surj⟩ :=
      @Module.Finite.exists_fin' R ↥(integralClosure R ↥M) _ _ _ hFinM
    have hRM_inj : Function.Injective (algebraMap R ↥M) := by
      rw [IsScalarTower.algebraMap_eq R F ↥M]
      exact (RingHom.injective (algebraMap F ↥M)).comp (IsFractionRing.injective R F)
    have hRL_inj : Function.Injective (algebraMap R L) := by
      rw [IsScalarTower.algebraMap_eq R F L]
      exact (RingHom.injective (algebraMap F L)).comp (IsFractionRing.injective R F)
    have : ExpChar ↥M p := expChar_of_injective_algebraMap hRM_inj p
    have : ExpChar L p := expChar_of_injective_algebraMap hRL_inj p
    have hTowerRML : IsScalarTower R ↥M L := by
      refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
      rw [IsScalarTower.algebraMap_apply R F L r,
        IsScalarTower.algebraMap_apply F ↥M L (algebraMap R F r),
        ← IsScalarTower.algebraMap_apply R F ↥M r]
    let e : ℕ := IsPurelyInseparable.exponent ↥M L
    let Φ_R : R →+* R := iterateFrobenius R p e
    let Φ_LM : L →+* ↥M := IsPurelyInseparable.iterateFrobenius ↥M L p (le_refl e)
    have h_comm : (algebraMap R ↥M).comp Φ_R = Φ_LM.comp (algebraMap R L) := by
      ext r
      simp only [RingHom.comp_apply]
      rw [@IsScalarTower.algebraMap_apply R ↥M L _ _ _ _ _ _ hTowerRML r,
        IsPurelyInseparable.iterateFrobenius_algebraMap L p (le_refl e) (algebraMap R ↥M r),
        ← map_pow, iterateFrobenius_def]
    obtain ⟨m, u, hu⟩ := hSpan e
    have h_f_smul : ∀ (s : R) (c : Fin n → R), f_surj (s • c) = s • f_surj c :=
      f_surj.map_smul
    let instTw : Module R ↥(integralClosure R ↥M) :=
      Module.compHom ↥(integralClosure R ↥M) Φ_R
    let F_span :=
      @LinearMap.mk R R _ _ (RingHom.id R) (Fin m × Fin n → R) ↥(integralClosure R ↥M) _ _ _ instTw
        { toFun := fun α => f_surj (fun l => ∑ j : Fin m, Φ_R (α (j, l)) * u j)
          map_add' := fun α₁ α₂ => by
            have h_eq : (fun l => ∑ j : Fin m, Φ_R ((α₁ + α₂) (j, l)) * u j) =
                (fun l => ∑ j : Fin m, Φ_R (α₁ (j, l)) * u j) +
                (fun l => ∑ j : Fin m, Φ_R (α₂ (j, l)) * u j) := by
              ext l
              simp only [Pi.add_apply, map_add, right_distrib, Finset.sum_add_distrib]
            rw [h_eq, map_add] }
        (fun r α => by
          have h_eq : (fun l => ∑ j : Fin m, Φ_R ((r • α) (j, l)) * u j) =
              Φ_R r • (fun l => ∑ j : Fin m, Φ_R (α (j, l)) * u j) := by
            ext l
            simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, Finset.mul_sum]
          exact (congrArg f_surj h_eq).trans
            (h_f_smul (Φ_R r) (fun l => ∑ j : Fin m, Φ_R (α (j, l)) * u j)))
    have hF_surj : Function.Surjective F_span := by
      intro w
      obtain ⟨c, rfl⟩ := hf_surj w
      choose q hq using fun l => hu (c l)
      refine ⟨fun idx => q idx.2 idx.1, ?_⟩
      change f_surj (fun l => ∑ j : Fin m, Φ_R (q l j) * u j) = f_surj c
      congr 1
      ext l
      simpa only [Φ_R, iterateFrobenius_def] using (hq l).symm
    have hFinTw : @Module.Finite R ↥(integralClosure R ↥M) _ _ instTw :=
      @Module.Finite.of_surjective R (Fin m × Fin n → R) _ _ _ R ↥(integralClosure R ↥M) _ _ instTw
        (RingHom.id R) inferInstance F_span hF_surj
    have hNoethTw : @IsNoetherian R ↥(integralClosure R ↥M) _ _ instTw :=
      @isNoetherian_of_isNoetherianRing_of_finite R ↥(integralClosure R ↥M) _ _ instTw _ hFinTw
    let ψ :=
      @LinearMap.mk R R _ _ (RingHom.id R) ↥(integralClosure R L) ↥(integralClosure R ↥M) _ _ _ instTw
        { toFun := fun z => ⟨Φ_LM z.1, _root_.IsIntegral.map_of_comp_eq Φ_R Φ_LM h_comm z.2⟩
          map_add' := fun z₁ z₂ => Subtype.ext (map_add Φ_LM z₁.1 z₂.1) }
        (fun r z => Subtype.ext (by
          change Φ_LM ((r • z : ↥(integralClosure R L)).1) =
            (Φ_R r • (⟨Φ_LM z.1, _⟩ : ↥(integralClosure R ↥M))).1
          have h1 : (r • z : ↥(integralClosure R L)).1 = algebraMap R L r * z.1 :=
            Algebra.smul_def r z.1
          have h2 : ∀ w : ↥(integralClosure R ↥M), (Φ_R r • w).1 = algebraMap R ↥M (Φ_R r) * w.1 :=
            fun w => Algebra.smul_def (Φ_R r) w.1
          rw [h1, map_mul, h2]
          have hc := RingHom.congr_fun h_comm r
          simp only [RingHom.comp_apply] at hc
          rw [hc]))
    have hInj_ψ : Function.Injective ψ := by
      intro z₁ z₂ hz
      have hz1 : Φ_LM z₁.1 = Φ_LM z₂.1 := congrArg Subtype.val hz
      exact Subtype.ext (Φ_LM.injective hz1)
    exact @Module.Finite.of_injective R R ↥(integralClosure R L) ↥(integralClosure R ↥M)
      _ _ _ _ _ instTw hNoethTw (RingHom.id R) (RingHom.id R)
      RingHomInvPair.ids RingHomInvPair.ids ψ hInj_ψ

  
  obtain ⟨s, g, hg_inj, hg_fin⟩ := exists_finite_inj_algHom_of_fg k A
  let _ : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
  let _ : Algebra (MvPolynomial (Fin s) k) K := ((algebraMap A K).comp g.toRingHom).toAlgebra
  have : IsScalarTower (MvPolynomial (Fin s) k) A K := IsScalarTower.of_algebraMap_eq' rfl
  have : Module.Finite (MvPolynomial (Fin s) k) A := hg_fin
  have : Algebra.IsIntegral (MvPolynomial (Fin s) k) A :=
    Algebra.IsIntegral.of_finite (MvPolynomial (Fin s) k) A
  have : Module.IsTorsionFree (MvPolynomial (Fin s) k) A :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hg_inj
  have hPK_inj : Function.Injective (algebraMap (MvPolynomial (Fin s) k) K) :=
    (IsFractionRing.injective A K).comp hg_inj
  let ψ_frac : FractionRing (MvPolynomial (Fin s) k) →+* K := IsFractionRing.lift hPK_inj
  let _ : Algebra (FractionRing (MvPolynomial (Fin s) k)) K := ψ_frac.toAlgebra
  have : IsScalarTower (MvPolynomial (Fin s) k) (FractionRing (MvPolynomial (Fin s) k)) K :=
    IsScalarTower.of_algebraMap_eq (fun p₀ => (IsFractionRing.lift_algebraMap hPK_inj p₀).symm)
  let _ : Algebra (FractionRing (MvPolynomial (Fin s) k)) (FractionRing A) :=
    FractionRing.liftAlgebra (MvPolynomial (Fin s) k) (FractionRing A)
  have : IsScalarTower (MvPolynomial (Fin s) k)
      (FractionRing (MvPolynomial (Fin s) k)) (FractionRing A) :=
    FractionRing.isScalarTower_liftAlgebra (MvPolynomial (Fin s) k) (FractionRing A)
  have : FiniteDimensional (FractionRing (MvPolynomial (Fin s) k)) (FractionRing A) :=
    instFiniteDimensionalFractionRingOfFinite
  let e_AK : FractionRing A ≃ₐ[A] K :=
    IsLocalization.algEquiv (nonZeroDivisors A) (FractionRing A) K
  have h_comp_KP :
      e_AK.toRingEquiv.toRingHom.comp
        (algebraMap (FractionRing (MvPolynomial (Fin s) k)) (FractionRing A)) =
      algebraMap (FractionRing (MvPolynomial (Fin s) k)) K := by
    apply @IsLocalization.ringHom_ext (MvPolynomial (Fin s) k) _
      (nonZeroDivisors (MvPolynomial (Fin s) k)) (FractionRing (MvPolynomial (Fin s) k))
    apply RingHom.ext
    intro p₀
    simp only [RingHom.comp_apply]
    have h1 : algebraMap (FractionRing (MvPolynomial (Fin s) k)) (FractionRing A)
        (algebraMap (MvPolynomial (Fin s) k) (FractionRing (MvPolynomial (Fin s) k)) p₀) =
        algebraMap A (FractionRing A) (algebraMap (MvPolynomial (Fin s) k) A p₀) := by
      rw [← IsScalarTower.algebraMap_apply (MvPolynomial (Fin s) k)
            (FractionRing (MvPolynomial (Fin s) k)) (FractionRing A) p₀,
          IsScalarTower.algebraMap_apply (MvPolynomial (Fin s) k) A (FractionRing A) p₀]
    rw [h1]
    change e_AK (algebraMap A (FractionRing A) (algebraMap (MvPolynomial (Fin s) k) A p₀)) =
      algebraMap (FractionRing (MvPolynomial (Fin s) k)) K
        (algebraMap (MvPolynomial (Fin s) k) (FractionRing (MvPolynomial (Fin s) k)) p₀)
    rw [e_AK.commutes,
      ← IsScalarTower.algebraMap_apply (MvPolynomial (Fin s) k)
        (FractionRing (MvPolynomial (Fin s) k)) K p₀,
      IsScalarTower.algebraMap_apply (MvPolynomial (Fin s) k) A K p₀]
  let e_lin : FractionRing A ≃ₗ[FractionRing (MvPolynomial (Fin s) k)] K :=
    { toFun := e_AK
      invFun := e_AK.symm
      left_inv := e_AK.left_inv
      right_inv := e_AK.right_inv
      map_add' := map_add e_AK
      map_smul' := fun c x => by
        simp only [RingHom.id_apply, Algebra.smul_def, map_mul]
        congr 1
        exact RingHom.congr_fun h_comp_KP c }
  have : FiniteDimensional (FractionRing (MvPolynomial (Fin s) k)) K := e_lin.finiteDimensional
  obtain ⟨p, hp⟩ := ExpChar.exists k
  have : ExpChar k p := hp
  have : ExpChar (MvPolynomial (Fin s) k) p :=
    expChar_of_injective_algebraMap (MvPolynomial.C_injective (Fin s) k) p
  have : Module.Finite (MvPolynomial (Fin s) k)
      ↥(integralClosure (MvPolynomial (Fin s) k) K) :=
    hFrobFinite (MvPolynomial (Fin s) k) (FractionRing (MvPolynomial (Fin s) k)) K p
      (fun e => hFrobSpan s p e)
  have h_mem_iff : ∀ x : K,
      x ∈ integralClosure (MvPolynomial (Fin s) k) K ↔ x ∈ integralClosure A K :=
    fun x => ⟨fun hx => _root_.IsIntegral.tower_top hx, fun hx => isIntegral_trans x hx⟩
  let e_ic : ↥(integralClosure (MvPolynomial (Fin s) k) K) ≃ₗ[MvPolynomial (Fin s) k]
      ↥(integralClosure A K) :=
    { toFun := fun z => ⟨z.1, (h_mem_iff z.1).mp z.2⟩
      invFun := fun z => ⟨z.1, (h_mem_iff z.1).mpr z.2⟩
      left_inv := fun _ => Subtype.ext rfl
      right_inv := fun _ => Subtype.ext rfl
      map_add' := fun _ _ => Subtype.ext rfl
      map_smul' := fun _ _ => Subtype.ext rfl }
  have : Module.Finite (MvPolynomial (Fin s) k) ↥(integralClosure A K) :=
    Module.Finite.equiv e_ic
  exact Module.Finite.of_restrictScalars_finite (MvPolynomial (Fin s) k) A ↥(integralClosure A K)

theorem weil_algClosed_scheme_normalization_finite_birational (k : Type u) [Field k] [IsAlgClosed k]
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV : AlgebraicGeometry.IsIntegral V.left)
    (hProjV : IsProjectiveOverField k V)
    (hFinIntClosure : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K)) :
    ∃ (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ν : V_norm ⟶ V)
      (U_ν : V.left.Opens),
      AlgebraicGeometry.IsIntegral V_norm.left ∧
      AlgebraicGeometry.IsFinite ν.left ∧
      AlgebraicGeometry.IsProper ν.left ∧
      AlgebraicGeometry.Surjective ν.left ∧
      Nonempty U_ν ∧
      CategoryTheory.IsIso (ν.left ∣_ U_ν) ∧
      ∀ x : V_norm.left, ∃ U : V_norm.left.Opens,
        AlgebraicGeometry.IsAffineOpen U ∧
        x ∈ U ∧
        IsIntegrallyClosed ↑(V_norm.left.presheaf.obj (Opposite.op U)) :=
by
  have h_s1 : AlgebraicGeometry.LocallyOfFiniteType V.hom ∧ AlgebraicGeometry.IsSeparated V.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProjV
    haveI : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    haveI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    haveI : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    haveI : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    haveI : AlgebraicGeometry.IsSeparated (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.isSeparated 𝒜
    haveI : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    exact ⟨inferInstance, inferInstance⟩

  have h_s2 : ∀ (X : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsIntegral X]
      [IrreducibleSpace ↥X]
      [AlgebraicGeometry.QuasiCompact (X.fromSpecStalk (genericPoint ↥X))]
      [AlgebraicGeometry.QuasiSeparated (X.fromSpecStalk (genericPoint ↥X))]
      (U : X.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) [Nonempty U],
      ∃ (e : ↥(integralClosure ↑(X.presheaf.obj (Opposite.op U)) ↑X.functionField) ≃+*
          ↑((X.fromSpecStalk (genericPoint ↥X)).normalization.presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map
              (X.fromSpecStalk (genericPoint ↥X)).fromNormalization.base).obj U)))),
        ∀ a : ↑(X.presheaf.obj (Opposite.op U)),
          e (algebraMap ↑(X.presheaf.obj (Opposite.op U))
            ↥(integralClosure ↑(X.presheaf.obj (Opposite.op U)) ↑X.functionField) a) =
          ((X.fromSpecStalk (genericPoint ↥X)).fromNormalization.app U).hom a := by
    intro X _ _ _ _ U hU _
    let η : ↥X := genericPoint ↥X
    let ξ := X.fromSpecStalk η
    let A := ↑(X.presheaf.obj (Opposite.op U))
    let K := ↑X.functionField
    let X_η := AlgebraicGeometry.Spec (X.presheaf.stalk η)
    let W_ξ : X_η.Opens := (TopologicalSpace.Opens.map ξ.base).obj U
    obtain ⟨⟨u₀, hu₀⟩⟩ := ‹Nonempty U›
    have hηU : η ∈ U :=
      ((genericPoint_spec ↥X).mem_open_set_iff U.isOpen).mpr ⟨u₀, Set.mem_univ u₀, hu₀⟩
    have hW_top : W_ξ = ⊤ := by
      ext pt
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      have hmem : ξ pt ∈ Set.range ⇑ξ := ⟨pt, rfl⟩
      rw [AlgebraicGeometry.Scheme.range_fromSpecStalk] at hmem
      have hSpec : ξ pt ⤳ η := hmem
      change ξ pt ∈ (U : Set ↥X)
      exact Specializes.mem_open hSpec U.isOpen hηU
    let B_U := ↑(X_η.presheaf.obj (Opposite.op W_ξ))
    letI : Algebra A B_U := (ξ.app U).hom.toAlgebra
    let iso_KB : X.functionField ≅ X_η.presheaf.obj (Opposite.op W_ξ) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.stalk η)).symm ≪≫
        X_η.presheaf.mapIso (CategoryTheory.eqToIso hW_top).op
    have h_app : ξ.app U = X.presheaf.germ U η hηU ≫ iso_KB.hom := by
      rw [AlgebraicGeometry.Scheme.fromSpecStalk_app hηU]
      have hHom : (CategoryTheory.homOfLE le_top : W_ξ ⟶ ⊤) = CategoryTheory.eqToHom hW_top :=
        Subsingleton.elim _ _
      dsimp [iso_KB]
      rw [hHom]
      rfl
    let φ_alg : K ≃ₐ[A] B_U :=
      { iso_KB.commRingCatIsoToRingEquiv with
        commutes' := fun a => by
          change iso_KB.hom.hom (algebraMap A K a) = (ξ.app U).hom a
          have h1 : algebraMap A K a = (X.presheaf.germ U η hηU).hom a := rfl
          rw [h1, h_app, CommRingCat.hom_comp, RingHom.comp_apply] }
    let Ψ_U : ↥(integralClosure A K) ≃ₐ[A] ↥(integralClosure A B_U) :=
      AlgEquiv.mapIntegralClosure φ_alg
    let e : ↥(integralClosure A K) ≃+*
        ↑(ξ.normalization.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map ξ.fromNormalization.base).obj U))) :=
      Ψ_U.toRingEquiv.trans (ξ.normalizationObjIso hU).symm.commRingCatIsoToRingEquiv
    refine ⟨e, fun a => ?_⟩
    change (ξ.normalizationObjIso hU).inv.hom (Ψ_U (algebraMap A ↥(integralClosure A K) a)) =
      (ξ.fromNormalization.app U).hom a
    rw [Ψ_U.commutes a, AlgebraicGeometry.Scheme.Hom.fromNormalization_app ξ hU,
      CommRingCat.hom_comp, RingHom.comp_apply]
    rfl

  have h_s3 : ∀ (A : Type u) [CommRing A] [IsDomain A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
      (_ : Module.Finite A ↥(integralClosure A K))
      (R : Type u) [CommRing R]
      (ψ : A →+* R)
      (e : ↥(integralClosure A K) ≃+* R)
      (_ : ∀ a : A, e (algebraMap A ↥(integralClosure A K) a) = ψ a),
      ∃ Δ : A, Δ ≠ 0 ∧
        ∀ (A_Δ : Type u) [CommRing A_Δ] [Algebra A A_Δ] [IsLocalization.Away Δ A_Δ]
          (R_Δ : Type u) [CommRing R_Δ] [Algebra R R_Δ] [IsLocalization.Away (ψ Δ) R_Δ],
          Function.Bijective (IsLocalization.Away.map A_Δ R_Δ ψ Δ) := by
    intro A _ _ K _ _ _ hFin R _ ψ e he
    let C := ↥(integralClosure A K)
    have hψ_inj : Function.Injective ψ := by
      intro a₁ a₂ hEq
      have h1 : e (algebraMap A C a₁) = e (algebraMap A C a₂) := by rw [he, he, hEq]
      have h2 : (algebraMap A C a₁).1 = (algebraMap A C a₂).1 :=
        congrArg Subtype.val (e.injective h1)
      exact IsFractionRing.injective A K h2
    obtain ⟨s, hs⟩ := hFin.fg_top
    have h_den : ∀ w : C, ∃ (a_w d_w : A), d_w ≠ 0 ∧ d_w • w = algebraMap A C a_w := by
      intro w
      obtain ⟨a_w, d_w, hd_mem, hdiv⟩ := IsFractionRing.div_surjective (A := A) w.1
      have hd_ne : d_w ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hd_mem
      have hdK_ne : algebraMap A K d_w ≠ 0 :=
        fun h0 => hd_ne (IsFractionRing.injective A K (h0.trans (map_zero _).symm))
      have hmul : algebraMap A K a_w = w.1 * algebraMap A K d_w := (div_eq_iff hdK_ne).mp hdiv
      refine ⟨a_w, d_w, hd_ne, ?_⟩
      rw [Algebra.smul_def]
      apply Subtype.ext
      change algebraMap A K d_w * w.1 = algebraMap A K a_w
      rw [hmul, mul_comm]
    choose a_fn d_fn hd_ne hd_eq using h_den
    let Δ : A := ∏ w ∈ s, d_fn w
    have hΔ_ne : Δ ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun w _ => hd_ne w)
    let M_Δ : Submodule A C :=
      { carrier := {c : C | ∃ b : A, Δ • c = algebraMap A C b}
        zero_mem' := ⟨0, by simp⟩
        add_mem' := by
          rintro c₁ c₂ ⟨b₁, hb₁⟩ ⟨b₂, hb₂⟩
          exact ⟨b₁ + b₂, by rw [smul_add, hb₁, hb₂, map_add]⟩
        smul_mem' := by
          rintro a c ⟨b, hb⟩
          refine ⟨a * b, ?_⟩
          rw [smul_comm Δ a c, hb, map_mul, Algebra.smul_def] }
    have hs_le : (s : Set C) ⊆ (M_Δ : Set C) := by
      intro w hw
      obtain ⟨q_w, hq⟩ := Finset.dvd_prod_of_mem d_fn hw
      refine ⟨q_w * a_fn w, ?_⟩
      change (∏ i ∈ s, d_fn i) • w = algebraMap A C (q_w * a_fn w)
      rw [hq, mul_comm (d_fn w) q_w, mul_smul, hd_eq w, map_mul, Algebra.smul_def]
    have hM_top : M_Δ = ⊤ := top_unique (hs ▸ Submodule.span_le.mpr hs_le)
    have hR_clear : ∀ y : R, ∃ b : A, ψ Δ * y = ψ b := by
      intro y
      have hc : e.symm y ∈ M_Δ := hM_top ▸ Submodule.mem_top
      obtain ⟨b, hb⟩ := hc
      refine ⟨b, ?_⟩
      have hb' : algebraMap A C Δ * e.symm y = algebraMap A C b := by
        rwa [← Algebra.smul_def]
      have he_mul := congrArg e hb'
      rw [map_mul, e.apply_symm_apply, he, he] at he_mul
      exact he_mul
    refine ⟨Δ, hΔ_ne, fun A_Δ _ _ _ R_Δ _ _ _ => ⟨?_, ?_⟩⟩
    · rw [IsLocalization.Away.map_injective_iff]
      intro a ha
      have ha0 : a = 0 := hψ_inj (ha.trans (map_zero ψ).symm)
      exact ⟨0, by simp [ha0]⟩
    · intro z
      let L := IsLocalization.Away.map A_Δ R_Δ ψ Δ
      obtain ⟨n, y, hzy⟩ := IsLocalization.Away.surj (ψ Δ) z
      obtain ⟨b, hb⟩ := hR_clear y
      obtain ⟨u_A, hu_A⟩ := IsLocalization.Away.algebraMap_isUnit (S := A_Δ) Δ
      obtain ⟨u_R, hu_R⟩ := IsLocalization.Away.algebraMap_isUnit (S := R_Δ) (ψ Δ)
      have hL_eq : ∀ a : A, L (algebraMap A A_Δ a) = algebraMap R R_Δ (ψ a) :=
        fun a => IsLocalization.map_eq _ a
      have hLu : L (u_A : A_Δ) = (u_R : R_Δ) := by
        rw [hu_A, hu_R, hL_eq]
      have hLu_inv : L ↑u_A⁻¹ * (u_R : R_Δ) = 1 := by
        rw [← hLu, ← map_mul, Units.inv_mul, map_one]
      let x : A_Δ := algebraMap A A_Δ b * (↑u_A⁻¹ : A_Δ) ^ (n + 1)
      refine ⟨x, ?_⟩
      have hz_pow : z * (u_R : R_Δ) ^ (n + 1) = L (algebraMap A A_Δ b) := by
        rw [pow_succ, ← mul_assoc, hu_R, hzy, ← map_mul, mul_comm y (ψ Δ), hb, ← hL_eq]
      have hLx_pow : L x * (u_R : R_Δ) ^ (n + 1) = L (algebraMap A A_Δ b) := by
        dsimp [x]
        rw [map_mul, map_pow, mul_assoc, ← mul_pow, hLu_inv, one_pow, mul_one]
      have hEq_pow : L x * ↑(u_R ^ (n + 1)) = z * ↑(u_R ^ (n + 1)) := by
        rw [Units.val_pow_eq_pow_val, hLx_pow, hz_pow]
      exact (Units.mul_left_inj (u_R ^ (n + 1))).mp hEq_pow

  have h_s4 : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsReduced Y]
      (f : X ⟶ Y) [AlgebraicGeometry.IsAffineHom f]
      {U₀ : Y.Opens} (hU₀ : AlgebraicGeometry.IsAffineOpen U₀)
      (Δ : ↑(Y.presheaf.obj (Opposite.op U₀))),
      Δ ≠ 0 →
      (letI := hU₀.isLocalization_basicOpen Δ
       letI := (hU₀.preimage f).isLocalization_basicOpen ((f.app U₀).hom Δ)
       Function.Bijective (IsLocalization.Away.map
         ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen Δ)))
         ↑(X.presheaf.obj (Opposite.op (X.basicOpen ((f.app U₀).hom Δ))))
         (f.app U₀).hom Δ)) →
      Nonempty (Y.basicOpen Δ) ∧ CategoryTheory.IsIso (f ∣_ Y.basicOpen Δ) := by
    intro X Y _ f _ U₀ hU₀ Δ hΔ hBij
    let U_ν : Y.Opens := Y.basicOpen Δ
    have hNeBot : U_ν ≠ ⊥ := (AlgebraicGeometry.basicOpen_eq_bot_iff Δ).not.mpr hΔ
    obtain ⟨y₀, hy₀⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U_ν).mp hNeBot
    refine ⟨⟨⟨y₀, hy₀⟩⟩, ?_⟩
    letI := hU₀.isLocalization_basicOpen Δ
    letI := (hU₀.preimage f).isLocalization_basicOpen ((f.app U₀).hom Δ)
    haveI : CategoryTheory.IsIso (CommRingCat.ofHom (IsLocalization.Away.map
        ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen Δ)))
        ↑(X.presheaf.obj (Opposite.op (X.basicOpen ((f.app U₀).hom Δ))))
        (f.app U₀).hom Δ)) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mpr hBij
    have hIsoApp : CategoryTheory.IsIso (f.app U_ν) := by
      rw [hU₀.app_basicOpen_eq_away_map f (hU₀.preimage f) Δ]
      infer_instance
    have hImg : (U_ν.ι.opensFunctor).obj ⊤ = U_ν := by
      rw [AlgebraicGeometry.Scheme.Hom.image_top_eq_opensRange,
        AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    have hIsoImg : CategoryTheory.IsIso (f.app ((U_ν.ι.opensFunctor).obj ⊤)) := by
      rw [hImg]
      exact hIsoApp
    have hIsoTop : CategoryTheory.IsIso (f ∣_ U_ν).appTop := by
      rw [AlgebraicGeometry.morphismRestrict_appTop]
      have hMapIso : ∀ {A B : X.Opens} (e : A = B),
          CategoryTheory.IsIso (X.presheaf.map (CategoryTheory.eqToHom e).op) :=
        fun e => (X.presheaf.mapIso (CategoryTheory.eqToIso e).op).isIso_hom
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIsoImg (hMapIso _)
    have hAff_Uν : AlgebraicGeometry.IsAffineOpen U_ν := hU₀.basicOpen Δ
    exact (@AlgebraicGeometry.HasAffineProperty.iff_of_isAffine
      _ _ AlgebraicGeometry.instHasAffinePropertyIsomorphismsSchemeAndIsAffineIsIsoCommRingCatAppTop
      _ _ (f ∣_ U_ν) hAff_Uν).mpr ⟨hAff_Uν.preimage f, hIsoTop⟩

  haveI : AlgebraicGeometry.IsIntegral V.left := hIntV
  haveI : IrreducibleSpace ↥V.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral V.left
  obtain ⟨hFT, hSep⟩ := h_s1
  haveI : AlgebraicGeometry.LocallyOfFiniteType V.hom := hFT
  haveI : AlgebraicGeometry.IsSeparated V.hom := hSep
  let η : ↥V.left := genericPoint ↥V.left
  let ξ := V.left.fromSpecStalk η
  haveI : AlgebraicGeometry.QuasiCompact ξ := AlgebraicGeometry.QuasiCompact.of_comp ξ V.hom
  haveI : AlgebraicGeometry.QuasiSeparated ξ := AlgebraicGeometry.QuasiSeparated.of_comp ξ V.hom
  let V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (ξ.fromNormalization ≫ V.hom)
  let ν : V_norm ⟶ V := CategoryTheory.Over.homMk ξ.fromNormalization rfl
  have hIntVn : AlgebraicGeometry.IsIntegral V_norm.left := by
    change AlgebraicGeometry.IsIntegral ξ.normalization
    infer_instance
  haveI : AlgebraicGeometry.IsIntegralHom ν.left := by
    change AlgebraicGeometry.IsIntegralHom ξ.fromNormalization
    infer_instance
  haveI : AlgebraicGeometry.IsAffineHom ν.left := inferInstance
  have hChart : ∀ (U : V.left.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) [Nonempty U],
      Module.Finite ↑(V.left.presheaf.obj (Opposite.op U))
        ↥(integralClosure ↑(V.left.presheaf.obj (Opposite.op U)) ↑V.left.functionField) ∧
      IsIntegrallyClosed
        ↥(integralClosure ↑(V.left.presheaf.obj (Opposite.op U)) ↑V.left.functionField) ∧
      ∃ (e : ↥(integralClosure ↑(V.left.presheaf.obj (Opposite.op U)) ↑V.left.functionField) ≃+*
          ↑(V_norm.left.presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map ν.left.base).obj U)))),
        ∀ a : ↑(V.left.presheaf.obj (Opposite.op U)),
          e (algebraMap ↑(V.left.presheaf.obj (Opposite.op U))
            ↥(integralClosure ↑(V.left.presheaf.obj (Opposite.op U)) ↑V.left.functionField) a) =
          (ν.left.app U).hom a := by
    intro U hU _
    let A := ↑(V.left.presheaf.obj (Opposite.op U))
    let K := ↑V.left.functionField
    haveI : IsFractionRing A K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen V.left U hU
    let φ_U : k →+* A :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        V.hom.appLE ⊤ U le_top).hom
    letI : Algebra k A := φ_U.toAlgebra
    have hFT_φ : φ_U.FiniteType := by
      have hcomp : φ_U = (V.hom.appLE ⊤ U le_top).hom.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom :=
        CommRingCat.hom_comp _ _
      rw [hcomp]
      exact RingHom.FiniteType.comp
        (V.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hU le_top)
        (RingHom.FiniteType.of_surjective _
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv.surjective)
    haveI : Algebra.FiniteType k A := hFT_φ
    obtain ⟨hFin_U, hIC_U⟩ := hFinIntClosure A K
    exact ⟨hFin_U, hIC_U, h_s2 V.left U hU⟩
  have hFinν : AlgebraicGeometry.IsFinite ν.left := by
    rw [AlgebraicGeometry.isFinite_iff]
    refine ⟨inferInstance, fun U hU => ?_⟩
    by_cases hUne : Nonempty U
    · haveI : Nonempty U := hUne
      obtain ⟨hFin_U, _, e_U, he_U⟩ := hChart U hU
      have h_eq : (ν.left.app U).hom =
          e_U.toRingHom.comp (algebraMap ↑(V.left.presheaf.obj (Opposite.op U))
            ↥(integralClosure ↑(V.left.presheaf.obj (Opposite.op U)) ↑V.left.functionField)) := by
        ext a
        exact (he_U a).symm
      rw [h_eq]
      exact RingHom.Finite.comp
        (RingHom.Finite.of_surjective _ e_U.surjective)
        (RingHom.finite_algebraMap.mpr hFin_U)
    · have hU_bot : U = ⊥ := by
        ext z
        exact ⟨fun hz => False.elim (hUne ⟨⟨z, hz⟩⟩), False.elim⟩
      subst hU_bot
      haveI : Subsingleton ↑(V_norm.left.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map ν.left.base).obj ⊥))) := by
        change Subsingleton ↑(V_norm.left.presheaf.obj (Opposite.op (⊥ : V_norm.left.Opens)))
        infer_instance
      exact RingHom.Finite.of_surjective _ (fun y => ⟨0, Subsingleton.elim _ _⟩)
  haveI : AlgebraicGeometry.IsFinite ν.left := hFinν
  have hPropν : AlgebraicGeometry.IsProper ν.left := inferInstance
  have hSurjν : AlgebraicGeometry.Surjective ν.left := by
    obtain ⟨pt⟩ : Nonempty ↥(AlgebraicGeometry.Spec (V.left.presheaf.stalk η)) := by
      change Nonempty ↥(AlgebraicGeometry.Spec V.left.functionField)
      infer_instance
    have hpt_range : ξ pt ∈ Set.range ⇑ν.left := by
      refine ⟨ξ.toNormalization pt, ?_⟩
      change ξ.fromNormalization (ξ.toNormalization pt) = ξ pt
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Scheme.Hom.toNormalization_fromNormalization]
    have hpt_spec : ξ pt ⤳ η := by
      have hm : ξ pt ∈ Set.range ⇑ξ := ⟨pt, rfl⟩
      rwa [AlgebraicGeometry.Scheme.range_fromSpecStalk] at hm
    have hη_cl : η ∈ closure {ξ pt} := specializes_iff_mem_closure.mp hpt_spec
    have hClRange : IsClosed (Set.range ⇑ν.left) :=
      (AlgebraicGeometry.Scheme.Hom.isClosedMap ν.left).isClosed_range
    have hη_mem : η ∈ Set.range ⇑ν.left :=
      hClRange.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hpt_range) hη_cl
    have hUniv : (Set.univ : Set ↥V.left) ⊆ Set.range ⇑ν.left := by
      rw [← (genericPoint_spec ↥V.left).def]
      exact hClRange.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hη_mem)
    exact ⟨fun y => hUniv (Set.mem_univ y)⟩
  obtain ⟨y₀⟩ : Nonempty ↥V.left := IrreducibleSpace.toNonempty
  obtain ⟨U₀, hU₀, hy₀, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V.left) (x := y₀) (U := ⊤) trivial
  haveI : Nonempty U₀ := ⟨⟨y₀, hy₀⟩⟩
  obtain ⟨hFin₀, _, e₀, he₀⟩ := hChart U₀ hU₀
  haveI : IsFractionRing ↑(V.left.presheaf.obj (Opposite.op U₀)) ↑V.left.functionField :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen V.left U₀ hU₀
  obtain ⟨Δ, hΔ_ne, hBij_all⟩ :=
    h_s3 ↑(V.left.presheaf.obj (Opposite.op U₀)) ↑V.left.functionField hFin₀
      ↑(V_norm.left.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map ν.left.base).obj U₀)))
      (ν.left.app U₀).hom e₀ he₀
  let U_ν : V.left.Opens := V.left.basicOpen Δ
  have hBij₀ :
      letI := hU₀.isLocalization_basicOpen Δ
      letI := (hU₀.preimage ν.left).isLocalization_basicOpen ((ν.left.app U₀).hom Δ)
      Function.Bijective (IsLocalization.Away.map
        ↑(V.left.presheaf.obj (Opposite.op (V.left.basicOpen Δ)))
        ↑(V_norm.left.presheaf.obj (Opposite.op (V_norm.left.basicOpen ((ν.left.app U₀).hom Δ))))
        (ν.left.app U₀).hom Δ) := by
    letI := hU₀.isLocalization_basicOpen Δ
    letI := (hU₀.preimage ν.left).isLocalization_basicOpen ((ν.left.app U₀).hom Δ)
    exact hBij_all _ _
  obtain ⟨hUν_ne, hIso_Uν⟩ := h_s4 ν.left hU₀ Δ hΔ_ne hBij₀
  refine ⟨V_norm, ν, U_ν, hIntVn, hFinν, hPropν, hSurjν, hUν_ne, hIso_Uν, ?_⟩
  intro x
  obtain ⟨U₁, hU₁, hx₁, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V.left) (x := ν.left x) (U := ⊤) trivial
  haveI : Nonempty U₁ := ⟨⟨ν.left x, hx₁⟩⟩
  obtain ⟨_, hIC₁, e₁, _⟩ := hChart U₁ hU₁
  exact ⟨(TopologicalSpace.Opens.map ν.left.base).obj U₁, hU₁.preimage ν.left, hx₁,
    @IsIntegrallyClosed.of_equiv _ _ _ _ e₁ hIC₁⟩

theorem weil_isFinite_projective_and_krullDim_over_field (k : Type u) [Field k]
    {Y Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (g : Y ⟶ Z)
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    (hIntZ : AlgebraicGeometry.IsIntegral Z.left)
    (hProjZ : IsProjectiveOverField k Z)
    (hFin : AlgebraicGeometry.IsFinite g.left)
    (hSurj : AlgebraicGeometry.Surjective g.left) :
    IsProjectiveOverField k Y ∧
    topologicalKrullDim Y.left = topologicalKrullDim Z.left :=
by
  
  have hPropProjSpace : ∀ (n : ℕ), AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k n).hom := by
    clear * -
    intro n
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    letI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (n + 1)) k) :=
      ⟨fun c x q => smul_mul_assoc c (x : MvPolynomial (Fin (n + 1)) k) q⟩
    have hAlgZeroBij : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      constructor
      · intro c₁ c₂ hc
        have hc' : algebraMap k (MvPolynomial (Fin (n + 1)) k) c₁ =
            algebraMap k (MvPolynomial (Fin (n + 1)) k) c₂ := by
          rw [IsScalarTower.algebraMap_apply k ↥(𝒜 0) (MvPolynomial (Fin (n + 1)) k) c₁,
              IsScalarTower.algebraMap_apply k ↥(𝒜 0) (MvPolynomial (Fin (n + 1)) k) c₂]
          exact congrArg Subtype.val hc
        exact MvPolynomial.C_injective (Fin (n + 1)) k hc'
      · rintro ⟨p, hp⟩
        change p.IsHomogeneous 0 at hp
        refine ⟨p.coeff 0, Subtype.ext ?_⟩
        change (algebraMap k ↥(𝒜 0) (p.coeff 0) : MvPolynomial (Fin (n + 1)) k) = p
        have hLHS : (algebraMap k ↥(𝒜 0) (p.coeff 0) : MvPolynomial (Fin (n + 1)) k) =
            MvPolynomial.C (p.coeff 0) :=
          (IsScalarTower.algebraMap_apply k ↥(𝒜 0) (MvPolynomial (Fin (n + 1)) k) _).symm
        rw [hLHS]
        ext d
        by_cases hd : d = 0
        · subst hd; simp [MvPolynomial.coeff_C]
        · have hC0 : (MvPolynomial.C (p.coeff 0) : MvPolynomial (Fin (n + 1)) k).coeff d = 0 := by
