    let μ_g : B_g →ₐ[↥Ox₀] ↥O_rel :=
      { μ_g_ring with
        commutes' := fun u => by
          change μ_g_ring (algebraMap B₀ B_g (algebraMap ↥Ox₀ B₀ u)) = j u
          rw [IsLocalization.Away.lift_eq g hg_unit]
          exact μ_B.commutes u }
    have hμg_inj : Function.Injective μ_g := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers g) z
      have hb0 : μ_B b = 0 := by
        have happ := congrArg μ_g hbs
        rw [map_mul, hz, zero_mul] at happ
        have hR : μ_g (algebraMap B₀ B_g b) = μ_B b :=
