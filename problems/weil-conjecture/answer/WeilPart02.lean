        let fC_alg : C →ₐ[MvPolynomial (Fin m) k] T := { fC with commutes' := fun _ => rfl }
        let fB_alg : B →ₐ[MvPolynomial (Fin m) k] T :=
          { fB with commutes' := fun p => (RingHom.congr_fun hagree p).symm }
        let F := Algebra.TensorProduct.lift fC_alg fB_alg (fun _ _ => Commute.all _ _)
        exact ⟨F.toRingHom, fun c b => Algebra.TensorProduct.lift_tmul fC_alg fB_alg _ c b⟩

      
      classical
      let e_comm : TensorProduct k L C ≃+* TensorProduct k C L :=
