      have he_pre_ℓ_ι : e_pre_ℓ.inv ≫ (Φ'_b ⁻¹ᵁ W'_open ℓ).ι = e_V₁.inv ≫ V'₁.ι := by
        change (e_V₁.inv ≫ E'_b.homOfLE hpre_eq_V₁.ge) ≫ (Φ'_b ⁻¹ᵁ W'_open ℓ).ι = _
