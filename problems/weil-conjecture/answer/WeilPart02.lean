            ext x
            obtain ⟨p₁, rfl⟩ := hSurj_Pκ a
            obtain ⟨p₂, rfl⟩ := hSurj_Pκ b
            dsimp
            rw [← map_add, h_indep, h_indep, h_indep, add_mul, map_add]
          map_smul' := fun r₀ a => by
            ext x
