  have hc_sing : ∀ v : ↥hSingFin.toFinset, MvPolynomial.eval c (E_sing v) ≠ 0 := by
    rw [map_prod, Finset.prod_ne_zero_iff] at hc_sing_prod
    exact fun v => hc_sing_prod v (Finset.mem_univ v)
  refine ⟨c, hc_qf, hHom c, fun H ιH hCartier => ?_⟩
  let p : H ⟶ B₀.left := ιH ≫ f₁.left
  have _ : AlgebraicGeometry.IsClosedImmersion ιH := hCartier.1
  have _ : AlgebraicGeometry.IsProper f₁.left := hFib₁.1
  let V_H : Fin G → H.Opens := fun γ => ιH ⁻¹ᵁ V_chart γ
  have hVH_aff : ∀ γ : Fin G, AlgebraicGeometry.IsAffineOpen (V_H γ) := fun γ =>
