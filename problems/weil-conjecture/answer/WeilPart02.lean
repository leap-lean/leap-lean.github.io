      let ψ_C : C →+* Localization M_Q :=
        ι_Q_loc.comp (q_line.comp (Algebra.TensorProduct.includeRight : C →ₐ[k] TensorProduct k L C).toRingHom)
      have hPt_units_Q : ∀ g : P_t.primeCompl, IsUnit ((ι_Q_loc.comp τ_Q) g) := by
        intro g
        exact IsLocalization.map_units (Localization M_Q)
          ⟨τ_Q g.1, Submonoid.mem_map_of_mem τ_Q g.2⟩
      let ψ_R : R →+* Localization M_Q := IsLocalization.lift (S := R) hPt_units_Q
      have hψ_R_poly : ∀ f : Polynomial L, ψ_R (algebraMap (Polynomial L) R f) = ι_Q_loc (τ_Q f) :=
        IsLocalization.lift_eq hPt_units_Q
      have hψ_R_L : ∀ ℓ : L, ψ_R (algebraMap L R ℓ) = ι_Q_loc (q_line (ℓ ⊗ₜ[k] (1 : C))) := by
        intro ℓ
        rw [IsScalarTower.algebraMap_apply L (Polynomial L) R, Polynomial.algebraMap_eq, hψ_R_poly]
        simp [τ_Q]
      have hψ_R_ϖ : ψ_R ϖ = ι_Q_loc (q_line (y idx0)) := by
        change ψ_R (algebraMap (Polynomial L) R Polynomial.X) = _
        rw [hψ_R_poly]
        simp [τ_Q]
      have hψ_agree : ψ_C.comp (algebraMap (MvPolynomial (Fin m) k) C) =
          ψ_R.comp (algebraMap (MvPolynomial (Fin m) k) R) := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [ψ_C, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.includeRight_apply, hAlgA₀R_C]
          have h1 : algebraMap (MvPolynomial (Fin m) k) C (MvPolynomial.C c) = algebraMap k C c :=
            (IsScalarTower.algebraMap_apply k (MvPolynomial (Fin m) k) C c).symm
          rw [h1, IsScalarTower.algebraMap_apply k L R, hψ_R_L]
          congr 2
          calc (1 : L) ⊗ₜ[k] algebraMap k C c
              = (1 : L) ⊗ₜ[k] (c • (1 : C)) := by
                congr 1; symm; rw [Algebra.smul_def, mul_one]
            _ = (c • (1 : L)) ⊗ₜ[k] (1 : C) := (TensorProduct.smul_tmul c (1 : L) (1 : C)).symm
            _ = (algebraMap k L c) ⊗ₜ[k] (1 : C) := by
                congr 1; rw [Algebra.smul_def, mul_one]
        · intro j
          simp only [ψ_C, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.includeRight_apply, hAlgA₀R_X]
          change ι_Q_loc (q_line ((1 : L) ⊗ₜ[k] x_C j)) = ψ_R (w_R j)
          by_cases h : j.1 = 0
          · have hj : j = idx0 := Fin.ext h
            rw [hj, hw0, map_add, IsScalarTower.algebraMap_apply K L R, hψ_R_L (a_L idx0),
              hψ_R_ϖ, ← map_add, ← map_add]
            congr 2
            simp [y, add_sub_cancel]
          · let r : Fin (m - 1) := ⟨j.1 - 1, by omega⟩
            have hj : j = idxSucc r := by ext; simp [idxSucc, r]; omega
            have hg_mem : g_line r ∈ I_line :=
              Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ r)))
            have hq_g : q_line (y (idxSucc r)) = q_line ((u r) ⊗ₜ[k] (1 : C)) * q_line (y idx0) := by
              have h0 : q_line (g_line r) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hg_mem
              have hsmul : (u r) • (y idx0) = ((u r) ⊗ₜ[k] (1 : C)) * y idx0 := by
                rw [Algebra.smul_def]; rfl
              change q_line (y (idxSucc r) - (u r) • (y idx0)) = 0 at h0
              rw [map_sub, hsmul, map_mul, sub_eq_zero] at h0
              exact h0
            rw [hj, hwsucc, map_add, map_mul, IsScalarTower.algebraMap_apply K L R,
              hψ_R_L (a_L (idxSucc r)), hψ_R_L (u r), hψ_R_ϖ, ← map_mul, ← hq_g, ← map_add, ← map_add]
            congr 2
            simp [y, add_sub_cancel]
      obtain ⟨Ψ_DQ, hΨ_tmul⟩ := hLiftRingHom ψ_C ψ_R hψ_agree
      have hΨπ : ∀ x : TensorProduct k L C, Ψ_DQ (π_CL_D x) = ι_Q_loc (q_line x) := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul ℓ c =>
          rw [hπ_tmul, hΨ_tmul, hψ_R_L]
          simp only [ψ_C, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.includeRight_apply, ← map_mul,
            Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        | add x₁ x₂ hx₁ hx₂ => rw [map_add, map_add, map_add, map_add, hx₁, hx₂]
      have hΦΨ_QD : ∀ d : TensorProduct (MvPolynomial (Fin m) k) C R, Φ_QD (Ψ_DQ d) = d := by
        have hΦ_ψR : Φ_QD.comp ψ_R = ι_RD := by
          apply IsLocalization.ringHom_ext P_t.primeCompl
          refine RingHom.ext fun f => ?_
          change Φ_QD (ψ_R (algebraMap (Polynomial L) R f)) = ι_RD (algebraMap (Polynomial L) R f)
          rw [hψ_R_poly, IsLocalization.lift_eq]
          exact RingHom.congr_fun hπ_τ f
        intro d
        induction d using TensorProduct.induction_on with
        | zero => simp
        | tmul c r =>
          rw [hΨ_tmul, map_mul]
          have hc : Φ_QD (ψ_C c) = c ⊗ₜ[MvPolynomial (Fin m) k] (1 : R) := by
            simp only [ψ_C, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              Algebra.TensorProduct.includeRight_apply]
            change Φ_QD (ι_Q_loc (q_line ((1 : L) ⊗ₜ[k] c))) = _
            rw [IsLocalization.lift_eq]
            simp [π_bar, q_line, hπ_tmul]
          have hr : Φ_QD (ψ_R r) = (1 : C) ⊗ₜ[MvPolynomial (Fin m) k] r :=
            RingHom.congr_fun hΦ_ψR r
          rw [hc, hr, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add d₁ d₂ hd₁ hd₂ => rw [map_add, map_add, hd₁, hd₂]

      
      obtain ⟨p₀, hp₀_min, hp₀_le_q⟩ :=
        Ideal.exists_minimalPrimes_le
          (bot_le : (⊥ : Ideal (TensorProduct (MvPolynomial (Fin m) k) C R)) ≤ q.asIdeal)
      haveI hp₀_prime : p₀.IsPrime := hp₀_min.1.1
      let P : Ideal (TensorProduct k L C) := Ideal.comap π_CL_D p₀
      haveI hP_prime : P.IsPrime := Ideal.IsPrime.comap π_CL_D
      have hI_le_P : I_line ≤ P := fun z hz => by
        change π_CL_D z ∈ p₀
        rw [hI_ker z hz]
        exact p₀.zero_mem
      have hP_min : P ∈ I_line.minimalPrimes := by
        refine ⟨⟨hP_prime, hI_le_P⟩, ?_⟩
        rintro P' ⟨hP'_prime, hI_le_P'⟩ hP'_le_P
        let Q' : Ideal (TensorProduct k L C ⧸ I_line) := Ideal.map q_line P'
        have hker_le : RingHom.ker q_line ≤ P' := by
          rw [Ideal.mk_ker]; exact hI_le_P'
        haveI hQ'_prime : Q'.IsPrime :=
          Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_le
        have hcomap_Q' : Ideal.comap q_line Q' = P' :=
          (Ideal.comap_map_of_surjective' q_line Ideal.Quotient.mk_surjective P').trans
            (sup_eq_left.mpr hker_le)
        have hQ'_le_loc : Q' ≤ Ideal.comap ι_Q_loc (Ideal.comap Φ_QD p₀) := by
          rw [Ideal.map_le_iff_le_comap]
          intro x hx
          have hxP : π_CL_D x ∈ p₀ := hP'_le_P hx
          change Φ_QD (ι_Q_loc (q_line x)) ∈ p₀
          rwa [IsLocalization.lift_eq]
        have hDisj_MQ :
            Disjoint (M_Q : Set (TensorProduct k L C ⧸ I_line))
              (Q' : Set (TensorProduct k L C ⧸ I_line)) := by
          rw [Set.disjoint_left]
          intro z hzM hzQ
          have hz_p₀ : Φ_QD (ι_Q_loc z) ∈ p₀ := hQ'_le_loc hzQ
          have hunit : IsUnit (Φ_QD (ι_Q_loc z)) :=
            (IsLocalization.map_units (Localization M_Q) ⟨z, hzM⟩).map _
          exact hp₀_prime.ne_top (Ideal.eq_top_of_isUnit_mem p₀ hz_p₀ hunit)
        let p'_loc : Ideal (Localization M_Q) := Ideal.map ι_Q_loc Q'
        haveI hp'_loc_prime : p'_loc.IsPrime :=
          IsLocalization.isPrime_of_isPrime_disjoint M_Q (Localization M_Q) Q' hQ'_prime hDisj_MQ
        have hcomap_p'_loc : Ideal.comap ι_Q_loc p'_loc = Q' := by
          rw [← Ideal.under_def]
          exact IsLocalization.under_map_of_isPrime_disjoint M_Q (Localization M_Q) hQ'_prime hDisj_MQ
        have hp'_loc_le : p'_loc ≤ Ideal.comap Φ_QD p₀ :=
          Ideal.map_le_iff_le_comap.mpr hQ'_le_loc
        let p'_D : Ideal (TensorProduct (MvPolynomial (Fin m) k) C R) := Ideal.comap Ψ_DQ p'_loc
        haveI hp'_D_prime : p'_D.IsPrime := Ideal.IsPrime.comap Ψ_DQ
        have hp'_D_le : p'_D ≤ p₀ := by
          intro d hd
          have := hp'_loc_le hd
          change Φ_QD (Ψ_DQ d) ∈ p₀ at this
          rwa [hΦΨ_QD] at this
        have hp₀_le_p'D : p₀ ≤ p'_D := hp₀_min.2 ⟨hp'_D_prime, bot_le⟩ hp'_D_le
        intro x hxP
        have hx_p'D : π_CL_D x ∈ p'_D := hp₀_le_p'D hxP
        change Ψ_DQ (π_CL_D x) ∈ p'_loc at hx_p'D
        rw [hΨπ] at hx_p'D
        have hx_Q' : q_line x ∈ Q' := by rwa [← hcomap_p'_loc]
        rwa [← hcomap_Q']
      have hDim_quotP : ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (TensorProduct k L C ⧸ P) :=
        hMinPrimeDim L (TensorProduct k L C) hDim_CL S_line hCardS P hP_min

      have hDisj_MR :
          Disjoint (M_R : Set (TensorProduct (MvPolynomial (Fin m) k) C R))
            (p₀ : Set (TensorProduct (MvPolynomial (Fin m) k) C R)) := by
        by_contra hNotDisj
        obtain ⟨_, ⟨r, hr_nzd, rfl⟩, hr_p₀⟩ := Set.not_disjoint_iff.mp hNotDisj
        let q_R : Ideal R := Ideal.comap ι_RD p₀
        haveI hq_R_prime : q_R.IsPrime := Ideal.IsPrime.comap ι_RD
        have hq_R_ne_bot : q_R ≠ ⊥ := by
          have hr_ne : r ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hr_nzd
          intro hbot
          have hr_mem : r ∈ q_R := hr_p₀
          rw [hbot, Ideal.mem_bot] at hr_mem
          exact hr_ne hr_mem
        have hϖ_p₀ : (1 : C) ⊗ₜ[MvPolynomial (Fin m) k] ϖ ∈ p₀ := hPrimeMem q_R hq_R_ne_bot
        have hy_P : ∀ j : Fin m, y j ∈ P := by
          intro j
          change π_CL_D (y j) ∈ p₀
          by_cases h : j.1 = 0
          · have hj : j = idx0 := Fin.ext h
            rwa [hj, hπ_y0]
          · let r' : Fin (m - 1) := ⟨j.1 - 1, by omega⟩
            have hj : j = idxSucc r' := by ext; simp [idxSucc, r']; omega
            rw [hj, hπ_ysucc]
            have hmul : ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] (algebraMap L R (u r') * ϖ)) =
                ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] algebraMap L R (u r')) *
                  ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] ϖ) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            rw [hmul]
            exact p₀.mul_mem_left _ hϖ_p₀
        let e_res : (R ⧸ Ideal.span {ϖ}) ≃+* L :=
          (RingEquiv.ofBijective (q₀.comp (algebraMap L R)) hRes).symm
        have he_res : ∀ ℓ : L, e_res.toRingHom (q₀ (algebraMap L R ℓ)) = ℓ := fun ℓ =>
          e_res.symm.symm_apply_apply ℓ
        let mkP : TensorProduct k L C →+* (TensorProduct k L C ⧸ P) := Ideal.Quotient.mk P
        let α_C : C →+* (TensorProduct k L C ⧸ P) :=
          mkP.comp (Algebra.TensorProduct.includeRight : C →ₐ[k] TensorProduct k L C).toRingHom
        let α_R₀ : (R ⧸ Ideal.span {ϖ}) →+* (TensorProduct k L C ⧸ P) :=
          mkP.comp ((Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct k L C).comp
            e_res.toRingHom)
        have hα_agree : α_C.comp (algebraMap (MvPolynomial (Fin m) k) C) =
            α_R₀.comp (algebraMap (MvPolynomial (Fin m) k) (R ⧸ Ideal.span {ϖ})) := by
          apply MvPolynomial.ringHom_ext'
          · ext c
            simp only [α_C, α_R₀, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
            have h1 : algebraMap (MvPolynomial (Fin m) k) C (MvPolynomial.C c) = algebraMap k C c :=
              (IsScalarTower.algebraMap_apply k (MvPolynomial (Fin m) k) C c).symm
            have h2 : algebraMap (MvPolynomial (Fin m) k) (R ⧸ Ideal.span {ϖ}) (MvPolynomial.C c) =
                q₀ (algebraMap L R (algebraMap k L c)) := by
              rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin m) k) R (R ⧸ Ideal.span {ϖ}),
                hAlgA₀R_C, IsScalarTower.algebraMap_apply k L R]
              rfl
            rw [h1, h2, he_res]
            congr 1
            calc (1 : L) ⊗ₜ[k] algebraMap k C c
                = (1 : L) ⊗ₜ[k] (c • (1 : C)) := by
                  congr 1; symm; rw [Algebra.smul_def, mul_one]
              _ = (c • (1 : L)) ⊗ₜ[k] (1 : C) := (TensorProduct.smul_tmul c (1 : L) (1 : C)).symm
              _ = (algebraMap k L c) ⊗ₜ[k] (1 : C) := by
                  congr 1; rw [Algebra.smul_def, mul_one]
          · intro j
            simp only [α_C, α_R₀, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
            have hXj : algebraMap (MvPolynomial (Fin m) k) (R ⧸ Ideal.span {ϖ}) (MvPolynomial.X j) =
                q₀ (algebraMap L R (a_L j)) := by
              rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin m) k) R (R ⧸ Ideal.span {ϖ})]
              have hmod := RingHom.congr_fun hMod_ϖ (MvPolynomial.X j)
              simp only [RingHom.comp_apply] at hmod
              change q₀ (algebraMap (MvPolynomial (Fin m) k) R (MvPolynomial.X j)) = _
              rw [hmod]
              simp [a_L, a, ← IsScalarTower.algebraMap_apply K L R]
            rw [hXj, he_res]
            have hy0 : mkP (y j) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hy_P j)
            change mkP ((1 : L) ⊗ₜ[k] x_C j) = mkP ((a_L j) ⊗ₜ[k] (1 : C))
            rwa [← sub_eq_zero, ← map_sub]
        obtain ⟨Ψ₀, hΨ₀_tmul⟩ := hLiftRingHom α_C α_R₀ hα_agree
        have hSurj_Ψ₀ : Function.Surjective Ψ₀ := by
          have hmkP_range : ∀ x : TensorProduct k L C, mkP x ∈ Set.range Ψ₀ := by
            intro x
            induction x using TensorProduct.induction_on with
            | zero => exact ⟨0, map_zero Ψ₀⟩
            | tmul ℓ c =>
              refine ⟨c ⊗ₜ[MvPolynomial (Fin m) k] q₀ (algebraMap L R ℓ), ?_⟩
              rw [hΨ₀_tmul]
              simp only [α_C, α_R₀, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
                Algebra.TensorProduct.includeRight_apply,
                Algebra.TensorProduct.includeLeftRingHom_apply, he_res,
                ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
            | add x₁ x₂ hx₁ hx₂ =>
              obtain ⟨d₁, hd₁⟩ := hx₁
              obtain ⟨d₂, hd₂⟩ := hx₂
              exact ⟨d₁ + d₂, by rw [map_add, map_add, hd₁, hd₂]⟩
          intro z
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
          exact hmkP_range x
        have hle1 : ringKrullDim (TensorProduct k L C ⧸ P) ≤
            ringKrullDim (TensorProduct (MvPolynomial (Fin m) k) C (R ⧸ Ideal.span {ϖ})) :=
          ringKrullDim_le_of_surjective Ψ₀ hSurj_Ψ₀
        have h2le1 : ((2 : ℕ) : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) :=
          hDim_quotP.trans (hle1.trans hDimD₀)
        norm_num at h2le1

      
      let p₀_loc : Ideal (Localization M_R) := Ideal.map ι_D_loc p₀
      haveI hp₀_loc_prime : p₀_loc.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint M_R (Localization M_R) p₀ hp₀_prime hDisj_MR
      have hcomap_p₀_loc : Ideal.comap ι_D_loc p₀_loc = p₀ := by
        rw [← Ideal.under_def]
        exact IsLocalization.under_map_of_isPrime_disjoint M_R (Localization M_R) hp₀_prime hDisj_MR
      let P_gen : PrimeSpectrum (TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R)) :=
        ⟨Ideal.comap e_gen.symm.toRingHom p₀_loc, Ideal.IsPrime.comap e_gen.symm.toRingHom⟩
      have hcomap_eq : (PrimeSpectrum.comap lam_gen P_gen).asIdeal = p₀ := by
        ext d
        change e_gen.symm (lam_gen d) ∈ p₀_loc ↔ d ∈ p₀
        rw [he_gen_symm, ← Ideal.mem_comap, hcomap_p₀_loc]
      have hq_cl : q ∈ closure ({PrimeSpectrum.comap lam_gen P_gen} :
          Set (PrimeSpectrum (TensorProduct (MvPolynomial (Fin m) k) C R))) := by
        rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus, hcomap_eq]
        exact SetLike.coe_subset_coe.mpr hp₀_le_q
      have hsub : ({PrimeSpectrum.comap lam_gen P_gen} :
          Set (PrimeSpectrum (TensorProduct (MvPolynomial (Fin m) k) C R))) ⊆
          Set.range (PrimeSpectrum.comap lam_gen) :=
        Set.singleton_subset_iff.mpr ⟨P_gen, rfl⟩
      exact closure_mono hsub hq_cl

  
  letI : Algebra k K := (ψ_s.comp MvPolynomial.C).toAlgebra
  haveI : Infinite K := IsAlgClosed.instInfinite
  haveI : Infinite (FractionRing (MvPolynomial (Fin (m - 1)) K)) :=
    Infinite.of_injective
      (algebraMap K (FractionRing (MvPolynomial (Fin (m - 1)) K)))
      (algebraMap K (FractionRing (MvPolynomial (Fin (m - 1)) K))).injective
  haveI : (Ideal.span ({Polynomial.X} :
      Set (Polynomial (FractionRing (MvPolynomial (Fin (m - 1)) K))))).IsPrime :=
    (Ideal.span_singleton_prime Polynomial.X_ne_zero).mpr Polynomial.prime_X
  obtain ⟨hAlgA₀R, hTowerkA₀R, ϖ, hRest⟩ :=
    hMain rfl
      (FractionRing (MvPolynomial (Fin (m - 1)) K))
      (Localization.AtPrime (Ideal.span ({Polynomial.X} :
        Set (Polynomial (FractionRing (MvPolynomial (Fin (m - 1)) K))))))
  exact ⟨FractionRing (MvPolynomial (Fin (m - 1)) K),
    inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    Localization.AtPrime (Ideal.span ({Polynomial.X} :
      Set (Polynomial (FractionRing (MvPolynomial (Fin (m - 1)) K))))),
    inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    hAlgA₀R, hTowerkA₀R, ϖ, hRest⟩

theorem weil_integral_projective_open_chart_domain_krullDim (k : Type u) [Field k] (m : ℕ)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hProjV₁ : IsProjectiveOverField k V₁)
    (hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (f₁ : V₁ ⟶ weilProjectiveSpaceOver k m)
    (hSurj : AlgebraicGeometry.Surjective f₁.left)
    (ι_aff : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin m) k)) ⟶
      (weilProjectiveSpaceOver k m).left)
    [AlgebraicGeometry.IsOpenImmersion ι_aff]
    (hι_hom : ι_aff ≫ (weilProjectiveSpaceOver k m).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) :
    ∀ (O : V₁.left.Opens) (v : ↥V₁.left),
      v ∈ O →
      f₁.left.base v ∈ Set.range ι_aff.base →
      ∃ (U : V₁.left.Opens) (C : Type u) (_ : CommRing C) (_ : IsDomain C)
        (_ : Algebra k C) (_ : Algebra.FiniteType k C)
        (_ : Algebra (MvPolynomial (Fin m) k) C)
        (_ : IsScalarTower k (MvPolynomial (Fin m) k) C)
        (e_U : U.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of C)),
        v ∈ U ∧
        U ≤ O ∧
        Function.Injective (algebraMap (MvPolynomial (Fin m) k) C) ∧
        ringKrullDim C = ((m + 1 : ℕ) : WithBot ℕ∞) ∧
        U.ι ≫ f₁.left =
          e_U.hom ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin m) k) C)) ≫ ι_aff :=
by
  
  have hFTV₁ : AlgebraicGeometry.LocallyOfFiniteType V₁.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProjV₁
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  
  have h_loc_dim : ∀ (T : Type u) [TopologicalSpace T] [Nonempty T] (d : WithBot ℕ∞),
      (∀ x : T, ∃ V : TopologicalSpace.Opens T, x ∈ V ∧ topologicalKrullDim ↥V = d) →
      topologicalKrullDim T = d := by
    intro T _ hneT d h_cov
    apply le_antisymm
    · change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds T)),
        (p.length : WithBot ℕ∞) ≤ d
      refine iSup_le fun p => ?_
      obtain ⟨x, hx0⟩ := (p 0).isIrreducible.nonempty
      obtain ⟨V, hxV, hVdim⟩ := h_cov x
      have hv_emb : Topology.IsOpenEmbedding (Subtype.val : ↥V → T) := V.isOpenEmbedding'
      have hx_i : ∀ i : Fin (p.length + 1), x ∈ (p i : Set T) := fun i =>
        p.monotone (Fin.zero_le i) hx0
      let c : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V := fun i =>
        { carrier := (Subtype.val : ↥V → T) ⁻¹' (p i : Set T)
          isIrreducible' := (p i).isIrreducible.preimage hv_emb ⟨x, hx_i i, ⟨x, hxV⟩, rfl⟩
          isClosed' := (p i).isClosed.preimage continuous_subtype_val }
      have hc_strict : ∀ i : Fin p.length, c (Fin.castSucc i) < c i.succ := by
        intro i
        have hp_lt : p (Fin.castSucc i) < p i.succ := p.step i
        have hp_sub : (p (Fin.castSucc i) : Set T) ⊆ (p i.succ : Set T) := le_of_lt hp_lt
        have h_le : c (Fin.castSucc i) ≤ c i.succ := fun z hz => hp_sub hz
        refine lt_of_le_of_ne h_le fun h_eq => ?_
        have h_not_le : ¬ ((p i.succ : Set T) ⊆ (p (Fin.castSucc i) : Set T)) :=
          not_le_of_gt hp_lt
        obtain ⟨y, hy_succ, hy_not⟩ := Set.not_subset.mp h_not_le
        obtain ⟨w, hw_succ, hw_compl, hw_V⟩ :=
          (p i.succ).isIrreducible.isPreirreducible
            ((p (Fin.castSucc i) : Set T)ᶜ) (V : Set T)
            (p (Fin.castSucc i)).isClosed.isOpen_compl V.isOpen
            ⟨y, hy_succ, hy_not⟩ ⟨x, hx_i i.succ, hxV⟩
        have hw_c : (⟨w, hw_V⟩ : ↥V) ∈ c i.succ := hw_succ
        rw [← h_eq] at hw_c
        exact hw_compl hw_c
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
        { length := p.length, toFun := c, step := hc_strict }
      rw [← hVdim]
      exact Order.LTSeries.length_le_krullDim q
    · obtain ⟨x₀⟩ := hneT
      obtain ⟨V₀, _, hV₀dim⟩ := h_cov x₀
      rw [← hV₀dim]
      exact topologicalKrullDim_subspace_le T (V₀ : Set T)

  
  have h_single_dom : ∀ (k₀ : Type u) [Field k₀]
      (R F₀ : Type u) [CommRing R] [IsDomain R] [Algebra k₀ R] [Algebra.FiniteType k₀ R]
      [Field F₀] [Algebra k₀ F₀] [Algebra R F₀] [IsScalarTower k₀ R F₀] [IsFractionRing R F₀],
      ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k₀ F₀ ∧
        ringKrullDim R = (s : WithBot ℕ∞) := by
    clear * -
    intro k₀ _ R F₀ _ _ _ _ _ _ _ _ _
    have : FaithfulSMul k₀ R :=
      (faithfulSMul_iff_algebraMap_injective k₀ R).mpr (algebraMap k₀ R).injective
    have : FaithfulSMul R F₀ :=
      (faithfulSMul_iff_algebraMap_injective R F₀).mpr (IsFractionRing.injective R F₀)
    have : Algebra.IsAlgebraic R F₀ :=
      IsLocalization.isAlgebraic F₀ (nonZeroDivisors R)
    have h_tr_RF₀ : Algebra.trdeg R F₀ = 0 := trdeg_eq_zero
    have h_tr_k₀R_eq : Algebra.trdeg k₀ R = Algebra.trdeg k₀ F₀ := by
      have h := trdeg_add_eq k₀ R (A := F₀)
      rwa [h_tr_RF₀, add_zero] at h
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k₀ R
    let P : Type u := MvPolynomial (Fin s) k₀
    have h_dim_P : ringKrullDim P = (s : WithBot ℕ∞) := by
      change ringKrullDim (MvPolynomial (Fin s) k₀) = (s : WithBot ℕ∞)
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k₀,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    have h_tr_s : (s : Cardinal.{u}) = Algebra.trdeg k₀ F₀ := by
      rw [← h_tr_k₀R_eq]
      let : Algebra P R := g.toRingHom.toAlgebra
      have : IsScalarTower k₀ P R := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
      have : Algebra.IsIntegral P R := ⟨hg_int⟩
      have : Algebra.IsAlgebraic P R := Algebra.IsIntegral.isAlgebraic
      have : FaithfulSMul k₀ P :=
        (faithfulSMul_iff_algebraMap_injective k₀ P).mpr (algebraMap k₀ P).injective
      have : FaithfulSMul P R :=
        (faithfulSMul_iff_algebraMap_injective P R).mpr hg_inj
      have h_tr_k₀P : Algebra.trdeg k₀ P = (s : Cardinal.{u}) := by
        change Algebra.trdeg k₀ (MvPolynomial (Fin s) k₀) = (s : Cardinal.{u})
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
      have h_tr_PR : Algebra.trdeg P R = 0 := trdeg_eq_zero
      have h_add := trdeg_add_eq k₀ P (A := R)
      rw [h_tr_k₀P, h_tr_PR, add_zero] at h_add
      exact h_add
    have h_dim_RP : ringKrullDim R = ringKrullDim P := by
      let : Algebra P R := g.toRingHom.toAlgebra
      have : Algebra.IsIntegral P R := ⟨hg_int⟩
      apply le_antisymm
      · refine Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap P R)) ?_
        intro q₁ q₂ hlt
        have h_not_le : ¬ ((q₂.asIdeal : Set R) ⊆ (q₁.asIdeal : Set R)) :=
          not_le_of_gt hlt
        obtain ⟨x, hx₂, hx₁⟩ := Set.not_subset.mp h_not_le
        exact Ideal.under_lt_under_of_integral_mem_sdiff (R := P) (le_of_lt hlt)
          ⟨hx₂, hx₁⟩ (Algebra.IsIntegral.isIntegral x)
      · change ⨆ (p : LTSeries (PrimeSpectrum P)), (p.length : WithBot ℕ∞) ≤ ringKrullDim R
        have h_lift : ∀ (len : ℕ) (p : LTSeries (PrimeSpectrum P)), p.length = len →
            ∃ q : LTSeries (PrimeSpectrum R),
              q.length = len ∧ Ideal.under P q.last.asIdeal = p.last.asIdeal := by
          intro len
          induction len with
          | zero =>
            intro p _
            have h_bot : Ideal.under P (⊥ : Ideal R) ≤ p.last.asIdeal := by
              intro y hy
              have hy0 : algebraMap P R y = 0 := Ideal.mem_bot.mp hy
              change g y = 0 at hy0
              rw [hg_inj (hy0.trans (map_zero g).symm)]
              exact p.last.asIdeal.zero_mem
            obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
              Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal (⊥ : Ideal R) h_bot
            refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, ?_⟩
            simpa using hQ₀_under
          | succ len ih =>
            intro p hp_len
            have hp_ne : p.length ≠ 0 := by omega
            have hp'_len : p.eraseLast.length = len := by
              rw [RelSeries.eraseLast_length, hp_len]
              rfl
            have hp'_lt : p.eraseLast.last < p.last := p.eraseLast_last_rel_last hp_ne
            obtain ⟨q', hq'_len, hq'_under⟩ := ih p.eraseLast hp'_len
            have h_le : Ideal.under P q'.last.asIdeal ≤ p.last.asIdeal := by
              rw [hq'_under]
              exact le_of_lt hp'_lt
            obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
              @Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime P _ R _ _ _
                p.last.asIdeal p.last.isPrime q'.last.asIdeal q'.last.isPrime h_le
            have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum R) := by
              refine lt_of_le_of_ne hQ_ge fun h_eq => ?_
              have h_id_eq : q'.last.asIdeal = Q_next := congrArg PrimeSpectrum.asIdeal h_eq
              have h_p_eq : p.eraseLast.last.asIdeal = p.last.asIdeal := by
                rw [← hq'_under, h_id_eq, hQ_under]
              exact (ne_of_lt hp'_lt) (PrimeSpectrum.ext h_p_eq)
            refine ⟨q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q, ?_, ?_⟩
            · simp [hq'_len]
            · simpa using hQ_under
        refine iSup_le fun p => ?_
        obtain ⟨q, hq_len, _⟩ := h_lift p.length p rfl
        rw [← hq_len]
        exact Order.LTSeries.length_le_krullDim q
    exact ⟨s, h_tr_s, h_dim_RP.trans h_dim_P⟩

  
  have : AlgebraicGeometry.IsIntegral V₁.left := hIntV₁
  have : IrreducibleSpace ↥V₁.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral V₁.left
  let η_pt : ↥V₁.left := genericPoint ↥V₁.left
  let F₀ : Type u := ↑V₁.left.functionField
  let η_mor : AlgebraicGeometry.Spec (CommRingCat.of F₀) ⟶ V₁.left :=
    V₁.left.fromSpecStalk η_pt
  let φ_kF₀ : CommRingCat.of k ⟶ CommRingCat.of F₀ :=
    AlgebraicGeometry.Spec.preimage (η_mor ≫ V₁.hom)
  have hSpec_kF₀ : AlgebraicGeometry.Spec.map φ_kF₀ = η_mor ≫ V₁.hom :=
    AlgebraicGeometry.Spec.map_preimage _
  let : Algebra k F₀ := φ_kF₀.hom.toAlgebra

  have h_aff_trdeg : ∀ (W : V₁.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W),
      Nonempty ↥W →
      ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k F₀ ∧
        ringKrullDim ↑(V₁.left.presheaf.obj (Opposite.op W)) = (s : WithBot ℕ∞) := by
    intro W hAffW hWne
    let A_W : Type u := ↑(V₁.left.presheaf.obj (Opposite.op W))
    have : Nonempty ↥W.toScheme := hWne
    have : IsDomain A_W := @AlgebraicGeometry.IsIntegral.component_integral V₁.left hIntV₁ W hWne
    let α_W : CommRingCat.of k ⟶ CommRingCat.of A_W :=
      AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ V₁.hom)
    have hSpec_W : AlgebraicGeometry.Spec.map α_W = hAffW.fromSpec ≫ V₁.hom :=
      AlgebraicGeometry.Spec.map_preimage _
    have hFT_W_mor : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map α_W) := by
      rw [hSpec_W]
      infer_instance
    have hFT_W_hom : RingHom.FiniteType α_W.hom :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hFT_W_mor
    let : Algebra k A_W := α_W.hom.toAlgebra
    have : Algebra.FiniteType k A_W := hFT_W_hom
    obtain ⟨⟨w₀, hw₀W⟩⟩ := hWne
    have hηW : η_pt ∈ W := (genericPoint_specializes w₀).mem_open W.isOpen hw₀W
    let ψ_WF₀ : CommRingCat.of A_W ⟶ CommRingCat.of F₀ := V₁.left.germToFunctionField W
    let : Algebra A_W F₀ := ψ_WF₀.hom.toAlgebra
    have : IsFractionRing A_W F₀ :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen V₁.left W hAffW
    have h_germ_eq : AlgebraicGeometry.Spec.map ψ_WF₀ ≫ hAffW.fromSpec = η_mor := by
      change AlgebraicGeometry.Spec.map (V₁.left.presheaf.germ W η_pt hηW) ≫ hAffW.fromSpec =
        V₁.left.fromSpecStalk η_pt
      rw [← W.fromSpecStalkOfMem_toSpecΓ_assoc η_pt hηW hAffW.fromSpec,
        hAffW.toSpecΓ_fromSpec, W.fromSpecStalkOfMem_ι]
    have hSpec_comp : AlgebraicGeometry.Spec.map (α_W ≫ ψ_WF₀) = AlgebraicGeometry.Spec.map φ_kF₀ := by
      rw [AlgebraicGeometry.Spec.map_comp, hSpec_W, ← CategoryTheory.Category.assoc,
        h_germ_eq, hSpec_kF₀]
    have h_cat_eq : α_W ≫ ψ_WF₀ = φ_kF₀ := by
      simpa only [AlgebraicGeometry.Spec.preimage_map] using
        congrArg AlgebraicGeometry.Spec.preimage hSpec_comp
    have : IsScalarTower k A_W F₀ :=
      IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h_cat_eq).symm
    exact h_single_dom k A_W F₀

  have h_aff_krullDim : ∀ (W : V₁.left.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W),
      Nonempty ↥W →
      ringKrullDim ↑(V₁.left.presheaf.obj (Opposite.op W)) = ((m + 1 : ℕ) : WithBot ℕ∞) := by
    obtain ⟨x₀⟩ := IrreducibleSpace.toNonempty (X := ↥V₁.left)
    have : Nonempty ↥V₁.left := ⟨x₀⟩
    obtain ⟨W₀, hAffW₀, hx₀W₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x₀) (U := ⊤) trivial
    obtain ⟨s₀, hs₀_tr, _⟩ := h_aff_trdeg W₀ hAffW₀ ⟨⟨x₀, hx₀W₀⟩⟩
    have h_cov_V₁ : ∀ x : ↥V₁.left, ∃ V : V₁.left.Opens,
        x ∈ V ∧ topologicalKrullDim ↥V = (s₀ : WithBot ℕ∞) := by
      intro x
      obtain ⟨V, hAffV, hxV, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
      obtain ⟨s_V, hsV_tr, hsV_dim⟩ := h_aff_trdeg V hAffV ⟨⟨x, hxV⟩⟩
      have hs_eq : s_V = s₀ := Nat.cast_injective (hsV_tr.trans hs₀_tr.symm)
      refine ⟨V, hxV, ?_⟩
      have h_homeo := (AlgebraicGeometry.Scheme.homeoOfIso hAffV.isoSpec).isHomeomorph
      change topologicalKrullDim ↥V.toScheme = (s₀ : WithBot ℕ∞)
      rw [h_homeo.topologicalKrullDim_eq]
      change topologicalKrullDim (PrimeSpectrum ↑(V₁.left.presheaf.obj (Opposite.op V))) =
        (s₀ : WithBot ℕ∞)
      rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, hsV_dim, hs_eq]
    have hs₀_eq : (s₀ : WithBot ℕ∞) = ((m + 1 : ℕ) : WithBot ℕ∞) := by
      rw [← h_loc_dim ↥V₁.left (s₀ : WithBot ℕ∞) h_cov_V₁]
      exact hDimV₁
    intro W hAffW hWne
    obtain ⟨s_W, hsW_tr, hsW_dim⟩ := h_aff_trdeg W hAffW hWne
    have hsW_eq : s_W = s₀ := Nat.cast_injective (hsW_tr.trans hs₀_tr.symm)
    rw [hsW_dim, hsW_eq, hs₀_eq]

  
  intro O v hvO hvf
  let W_chart : V₁.left.Opens := (TopologicalSpace.Opens.map f₁.left.base).obj ι_aff.opensRange
  have hvW : v ∈ W_chart := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mpr hvf
  obtain ⟨U, hAffU, hvU, hU_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := v) (U := O ⊓ W_chart) ⟨hvO, hvW⟩
  have hUO : U ≤ O := fun z hz => (hU_sub hz).1
  have hUW : U ≤ W_chart := fun z hz => (hU_sub hz).2
  let C : Type u := ↑(V₁.left.presheaf.obj (Opposite.op U))
  have hUne : Nonempty ↥U := ⟨⟨v, hvU⟩⟩
  have : Nonempty ↥U.toScheme := hUne
  have hDomC : IsDomain C := @AlgebraicGeometry.IsIntegral.component_integral V₁.left hIntV₁ U hUne
  have hDimC : ringKrullDim C = ((m + 1 : ℕ) : WithBot ℕ∞) := h_aff_krullDim U hAffU hUne
  let e_U : U.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of C) := hAffU.isoSpec
  let A₀ : Type u := MvPolynomial (Fin m) k
  have hU_range : Set.range ⇑(U.ι ≫ f₁.left) ⊆ Set.range ⇑ι_aff := by
    rintro _ ⟨u, rfl⟩
    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
    change f₁.left u.1 ∈ Set.range ⇑ι_aff
    exact AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp (hUW u.2)
  let g_U : U.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A₀) :=
    AlgebraicGeometry.IsOpenImmersion.lift ι_aff (U.ι ≫ f₁.left) hU_range
  have hg_fac : g_U ≫ ι_aff = U.ι ≫ f₁.left :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac ι_aff (U.ι ≫ f₁.left) hU_range
  let φ_k_cat : CommRingCat.of k ⟶ CommRingCat.of C :=
    AlgebraicGeometry.Spec.preimage (e_U.inv ≫ U.ι ≫ V₁.hom)
  have hSpec_k : AlgebraicGeometry.Spec.map φ_k_cat = e_U.inv ≫ U.ι ≫ V₁.hom :=
    AlgebraicGeometry.Spec.map_preimage _
  have hFT_k_mor : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_k_cat) := by
    rw [hSpec_k]
    infer_instance
  have hFT_k_hom : RingHom.FiniteType φ_k_cat.hom :=
    AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hFT_k_mor
  let instAlgkC : Algebra k C := φ_k_cat.hom.toAlgebra
  have instFTkC : Algebra.FiniteType k C := hFT_k_hom
  let α_C_cat : CommRingCat.of A₀ ⟶ CommRingCat.of C :=
    AlgebraicGeometry.Spec.preimage (e_U.inv ≫ g_U)
  have hSpec_A₀ : AlgebraicGeometry.Spec.map α_C_cat = e_U.inv ≫ g_U :=
    AlgebraicGeometry.Spec.map_preimage _
  let instAlgA₀C : Algebra A₀ C := α_C_cat.hom.toAlgebra
  have h_ofHom_α : CommRingCat.ofHom (algebraMap A₀ C) = α_C_cat := CommRingCat.ofHom_hom α_C_cat
  have hFac : U.ι ≫ f₁.left =
      e_U.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ C)) ≫ ι_aff := by
    rw [h_ofHom_α, hSpec_A₀, CategoryTheory.Category.assoc, e_U.hom_inv_id_assoc, hg_fac]
  have hSpec_tower :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀) ≫ α_C_cat) =
        AlgebraicGeometry.Spec.map φ_k_cat := by
    rw [AlgebraicGeometry.Spec.map_comp, hSpec_A₀, hSpec_k]
    change (e_U.inv ≫ g_U) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
      e_U.inv ≫ U.ι ≫ V₁.hom
    rw [← hι_hom, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc g_U,
      hg_fac, CategoryTheory.Category.assoc, CategoryTheory.Over.w f₁]
  have h_cat_tower : CommRingCat.ofHom (algebraMap k A₀) ≫ α_C_cat = φ_k_cat := by
    simpa only [AlgebraicGeometry.Spec.preimage_map] using
      congrArg AlgebraicGeometry.Spec.preimage hSpec_tower
  have instTower : IsScalarTower k A₀ C :=
    IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h_cat_tower).symm
  have hInj : Function.Injective (algebraMap A₀ C) := by
    have hηU : η_pt ∈ U := (genericPoint_specializes v).mem_open U.isOpen hvU
    let η_U : ↥U.toScheme := ⟨η_pt, hηU⟩
    let q_η : PrimeSpectrum C := e_U.hom η_U
    obtain ⟨v_η, hv_η⟩ := hSurj.surj (ι_aff (⊥ : PrimeSpectrum A₀))
    have h_spec_base : f₁.left η_pt ⤳ ι_aff (⊥ : PrimeSpectrum A₀) :=
      hv_η ▸ (genericPoint_specializes v_η).map f₁.left.continuous
    have h_eval_η : f₁.left η_pt = ι_aff (PrimeSpectrum.comap (algebraMap A₀ C) q_η) := by
      have h_ap := congrArg (fun φ => φ η_U) hFac
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply,
        AlgebraicGeometry.Spec.map_apply] at h_ap
      exact h_ap
    rw [h_eval_η] at h_spec_base
    have h_spec_A₀ : PrimeSpectrum.comap (algebraMap A₀ C) q_η ⤳ (⊥ : PrimeSpectrum A₀) :=
      (ι_aff.isOpenEmbedding.isInducing.specializes_iff).mp h_spec_base
    have h_le_bot : (PrimeSpectrum.comap (algebraMap A₀ C) q_η).asIdeal ≤ ⊥ := by
      have h1 : (PrimeSpectrum.comap (algebraMap A₀ C) q_η).asIdeal ≤
          (⊥ : PrimeSpectrum A₀).asIdeal :=
        (PrimeSpectrum.le_iff_specializes _ _).mpr h_spec_A₀
      rwa [PrimeSpectrum.asIdeal_bot] at h1
    rw [RingHom.injective_iff_ker_eq_bot, ← le_bot_iff]
    intro a ha
    apply h_le_bot
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    rw [RingHom.mem_ker] at ha
    rw [ha]
    exact q_η.asIdeal.zero_mem
  exact ⟨U, C, inferInstance, hDomC, instAlgkC, instFTkC, instAlgA₀C, instTower, e_U,
    hvU, hUO, hInj, hDimC, hFac⟩

theorem weil_equidim_curve_baseChange_krullDim_le_one_and_surj (k : Type u) [Field k] (m : ℕ)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₁ : V₁ ⟶ weilProjectiveSpaceOver k m)
    (hEquidim : ∀ (K' : Type u) [Field K'] [IsAlgClosed K']
        (s' : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ (weilProjectiveSpaceOver k m).left),
      ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₁.left s'),
        topologicalKrullDim ↥E = (1 : WithBot ℕ∞))
    (K : Type u) [Field K]
    (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left)
    (L₀ : Type u) [Field L₀] [Algebra K L₀] :
    topologicalKrullDim
      ↥(CategoryTheory.Limits.pullback f₁.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L₀)) ≫ s)) ≤
      (1 : WithBot ℕ∞) ∧
    ∃ (q_fib :
        CategoryTheory.Limits.pullback f₁.left
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L₀)) ≫ s) ⟶
        CategoryTheory.Limits.pullback f₁.left s),
      AlgebraicGeometry.Surjective q_fib :=
by
  let s_KL₀ : AlgebraicGeometry.Spec (CommRingCat.of L₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of K) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L₀))
  have hSurj_sKL₀ : AlgebraicGeometry.Surjective s_KL₀ := by
    refine AlgebraicGeometry.Surjective.mk ?_
    intro y
    obtain ⟨x⟩ := (inferInstance : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of L₀)))
    exact ⟨x, Subsingleton.elim _ _⟩
  let F_K : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₁.left s
  let F_L₀ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₁.left (s_KL₀ ≫ s)
  let p_L₀ : F_L₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of L₀) :=
    CategoryTheory.Limits.pullback.snd f₁.left (s_KL₀ ≫ s)
  let q_fib : F_L₀ ⟶ F_K :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst f₁.left (s_KL₀ ≫ s))
      (p_L₀ ≫ s_KL₀)
      (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
  have hq_fst :
      q_fib ≫ CategoryTheory.Limits.pullback.fst f₁.left s =
        CategoryTheory.Limits.pullback.fst f₁.left (s_KL₀ ≫ s) :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_snd :
      q_fib ≫ CategoryTheory.Limits.pullback.snd f₁.left s = p_L₀ ≫ s_KL₀ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPB_outer :
      CategoryTheory.IsPullback
        (q_fib ≫ CategoryTheory.Limits.pullback.fst f₁.left s)
        p_L₀ f₁.left (s_KL₀ ≫ s) := by
    rw [hq_fst]
    exact CategoryTheory.IsPullback.of_hasPullback f₁.left (s_KL₀ ≫ s)
  have hPB_q :
      CategoryTheory.IsPullback q_fib p_L₀
        (CategoryTheory.Limits.pullback.snd f₁.left s) s_KL₀ :=
    CategoryTheory.IsPullback.of_right hPB_outer hq_snd
      (CategoryTheory.IsPullback.of_hasPullback f₁.left s)
  have hSurj_q : AlgebraicGeometry.Surjective q_fib :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.Surjective) hPB_q.flip hSurj_sKL₀

  let Ω : Type u := AlgebraicClosure L₀
  let s_L₀Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of L₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L₀ Ω))
  let s_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k m).left :=
    s_L₀Ω ≫ (s_KL₀ ≫ s)
  let X_Ω : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₁.left s_Ω
  have hDim_XΩ : topologicalKrullDim ↥X_Ω ≤ (1 : WithBot ℕ∞) := by
    change (⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥X_Ω)),
      (p.length : WithBot ℕ∞)) ≤ (1 : WithBot ℕ∞)
    refine iSup_le fun p => ?_
    obtain ⟨E, hE, hlast⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible
        (p.last : Set ↥X_Ω) p.last.isIrreducible
    have hsub : ∀ i : Fin (p.length + 1), (p i : Set ↥X_Ω) ⊆ E := fun i =>
      Set.Subset.trans (p.monotone (Fin.le_last i)) hlast
    let q_fun : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥E := fun i =>
      ⟨(Subtype.val : ↥E → ↥X_Ω) ⁻¹' (p i : Set ↥X_Ω),
        by
          refine ⟨?_, ?_⟩
          · obtain ⟨x, hx⟩ := (p i).isIrreducible.1
            exact ⟨⟨x, hsub i hx⟩, hx⟩
          · intro u v hu hv ⟨y₁, hy₁_p, hy₁_u⟩ ⟨y₂, hy₂_p, hy₂_v⟩
            obtain ⟨u₀, hu₀, rfl⟩ := isOpen_induced_iff.mp hu
            obtain ⟨v₀, hv₀, rfl⟩ := isOpen_induced_iff.mp hv
            obtain ⟨z, hz_p, hz_u₀, hz_v₀⟩ :=
              (p i).isIrreducible.2 u₀ v₀ hu₀ hv₀ ⟨y₁.1, hy₁_p, hy₁_u⟩ ⟨y₂.1, hy₂_p, hy₂_v⟩
            exact ⟨⟨z, hsub i hz_p⟩, hz_p, hz_u₀, hz_v₀⟩,
        (p i).isClosed.preimage continuous_subtype_val⟩
    have hq_step : ∀ j : Fin p.length, q_fun j.castSucc < q_fun j.succ := by
      intro j
      have hpj : p j.castSucc < p j.succ := p.step j
      have hpj_sub : (p j.castSucc : Set ↥X_Ω) ⊆ (p j.succ : Set ↥X_Ω) := le_of_lt hpj
      refine lt_of_le_of_ne
        (show q_fun j.castSucc ≤ q_fun j.succ from fun _ hy => hpj_sub hy) ?_
      intro hEq
      have hImg :
          (Subtype.val : ↥E → ↥X_Ω) '' (q_fun j.castSucc : Set ↥E) =
            (Subtype.val : ↥E → ↥X_Ω) '' (q_fun j.succ : Set ↥E) :=
        congrArg (fun c : TopologicalSpace.IrreducibleCloseds ↥E =>
          (Subtype.val : ↥E → ↥X_Ω) '' (c : Set ↥E)) hEq
      have hRange : Set.range (Subtype.val : ↥E → ↥X_Ω) = E := Subtype.range_coe
      have h1 : (Subtype.val : ↥E → ↥X_Ω) '' (q_fun j.castSucc : Set ↥E) =
          (p j.castSucc : Set ↥X_Ω) :=
        Set.image_preimage_eq_of_subset ((hsub j.castSucc).trans hRange.symm.subset)
      have h2 : (Subtype.val : ↥E → ↥X_Ω) '' (q_fun j.succ : Set ↥E) =
          (p j.succ : Set ↥X_Ω) :=
        Set.image_preimage_eq_of_subset ((hsub j.succ).trans hRange.symm.subset)
      rw [h1, h2] at hImg
      exact ne_of_lt hpj (SetLike.ext' hImg)
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥E) :=
      RelSeries.mk p.length q_fun hq_step
    calc
      (p.length : WithBot ℕ∞) = (q.length : WithBot ℕ∞) := rfl
      _ ≤ topologicalKrullDim ↥E := Order.LTSeries.length_le_krullDim q
      _ = (1 : WithBot ℕ∞) := hEquidim Ω s_Ω E hE

  let F_Ω : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p_L₀ s_L₀Ω
  let q_Ω : F_Ω ⟶ F_L₀ := CategoryTheory.Limits.pullback.fst p_L₀ s_L₀Ω
  have hPB_Ω :
      CategoryTheory.IsPullback
        (q_Ω ≫ CategoryTheory.Limits.pullback.fst f₁.left (s_KL₀ ≫ s))
        (CategoryTheory.Limits.pullback.snd p_L₀ s_L₀Ω)
        f₁.left s_Ω :=
    (CategoryTheory.IsPullback.of_hasPullback p_L₀ s_L₀Ω).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback f₁.left (s_KL₀ ≫ s))
  let e_Ω : F_Ω ≅ X_Ω := hPB_Ω.isoPullback
  have hDim_FΩ : topologicalKrullDim ↥F_Ω ≤ (1 : WithBot ℕ∞) := by
    rw [(AlgebraicGeometry.Scheme.homeoOfIso e_Ω).isHomeomorph.topologicalKrullDim_eq]
    exact hDim_XΩ

  have hDim_ring :
      ∀ (B : Type u) [CommRing B] [Algebra L₀ B],
        ringKrullDim (TensorProduct L₀ B Ω) ≤ (1 : WithBot ℕ∞) →
        ringKrullDim B ≤ (1 : WithBot ℕ∞) := by
    intro B _ _ hDim_BΩ
    let f_lin : L₀ →ₗ[L₀] Ω := Algebra.linearMap L₀ Ω
    have hf_ker : LinearMap.ker f_lin = ⊥ :=
      LinearMap.ker_eq_bot.mpr (algebraMap L₀ Ω).injective
    obtain ⟨g_lin, hg⟩ := LinearMap.exists_leftInverse_of_injective f_lin hf_ker
    have hg1 : g_lin 1 = 1 := by
      have h1 : g_lin (f_lin 1) = (LinearMap.id : L₀ →ₗ[L₀] L₀) 1 :=
        LinearMap.congr_fun hg 1
      simpa [f_lin] using h1
    let B_bilin : B →ₗ[L₀] Ω →ₗ[L₀] B :=
      LinearMap.mk₂ L₀ (fun b ω => (g_lin ω) • b)
        (fun b₁ b₂ ω => smul_add (g_lin ω) b₁ b₂)
        (fun c b ω => smul_comm (g_lin ω) c b)
        (fun b ω₁ ω₂ => by rw [map_add, add_smul])
        (fun c b ω => by rw [map_smul, smul_eq_mul, mul_smul])
    let ψ_B : TensorProduct L₀ B Ω →ₗ[L₀] B := TensorProduct.lift B_bilin
    have hLeftInv : Function.LeftInverse ψ_B (algebraMap B (TensorProduct L₀ B Ω)) := by
      intro b
      have halg : algebraMap B (TensorProduct L₀ B Ω) b = TensorProduct.tmul L₀ b (1 : Ω) :=
        rfl
      rw [halg, TensorProduct.lift.tmul, LinearMap.mk₂_apply, hg1, one_smul]
    have hInj_B : Function.Injective (algebraMap B (TensorProduct L₀ B Ω)) :=
      hLeftInv.injective
    have : Algebra.IsIntegral B (TensorProduct L₀ B Ω) :=
      Algebra.IsIntegral.tensorProduct L₀ B Ω
    change (⨆ (p : LTSeries (PrimeSpectrum B)), (p.length : WithBot ℕ∞)) ≤ (1 : WithBot ℕ∞)
    refine iSup_le fun p => ?_
    suffices hp_len : p.length ≤ 1 from Nat.cast_le.mpr hp_len
    by_contra h_gt
    have h2 : 2 ≤ p.length := by omega
    let i₀ : Fin (p.length + 1) := ⟨0, by omega⟩
    let i₁ : Fin (p.length + 1) := ⟨1, by omega⟩
    let i₂ : Fin (p.length + 1) := ⟨2, by omega⟩
    let P₀ : PrimeSpectrum B := p i₀
    let P₁ : PrimeSpectrum B := p i₁
    let P₂ : PrimeSpectrum B := p i₂
    have h01 : P₀ < P₁ := p.strictMono (Fin.mk_lt_mk.mpr (by omega))
    have h12 : P₁ < P₂ := p.strictMono (Fin.mk_lt_mk.mpr (by omega))
    have h_bot : Ideal.under B (⊥ : Ideal (TensorProduct L₀ B Ω)) ≤ P₀.asIdeal := by
      intro x hx
      have hx0 : algebraMap B (TensorProduct L₀ B Ω) x = 0 := hx
      have h0 : x = 0 := hInj_B (hx0.trans (map_zero _).symm)
      rw [h0]
      exact P₀.asIdeal.zero_mem
    obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral P₀.asIdeal
        (⊥ : Ideal (TensorProduct L₀ B Ω)) h_bot
    have : Q₀.IsPrime := hQ₀_prime
    obtain ⟨Q₁, hQ₀₁, hQ₁_prime, hQ₁_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime P₁.asIdeal Q₀
        (by rw [hQ₀_under]; exact le_of_lt h01)
    have : Q₁.IsPrime := hQ₁_prime
    obtain ⟨Q₂, hQ₁₂, hQ₂_prime, hQ₂_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime P₂.asIdeal Q₁
        (by rw [hQ₁_under]; exact le_of_lt h12)
    let q₀ : PrimeSpectrum (TensorProduct L₀ B Ω) := ⟨Q₀, hQ₀_prime⟩
    let q₁ : PrimeSpectrum (TensorProduct L₀ B Ω) := ⟨Q₁, hQ₁_prime⟩
    let q₂ : PrimeSpectrum (TensorProduct L₀ B Ω) := ⟨Q₂, hQ₂_prime⟩
    have hq₀₁ : q₀ < q₁ := by
      refine lt_of_le_of_ne hQ₀₁ ?_
      intro hEq
      have hIdealEq : Q₀ = Q₁ := congrArg PrimeSpectrum.asIdeal hEq
      have hP₀₁ : P₀.asIdeal = P₁.asIdeal := by
        rw [← hQ₀_under, ← hQ₁_under, hIdealEq]
      exact ne_of_lt h01 (PrimeSpectrum.ext hP₀₁)
    have hq₁₂ : q₁ < q₂ := by
      refine lt_of_le_of_ne hQ₁₂ ?_
      intro hEq
      have hIdealEq : Q₁ = Q₂ := congrArg PrimeSpectrum.asIdeal hEq
      have hP₁₂ : P₁.asIdeal = P₂.asIdeal := by
        rw [← hQ₁_under, ← hQ₂_under, hIdealEq]
      exact ne_of_lt h12 (PrimeSpectrum.ext hP₁₂)
    let q_ser : LTSeries (PrimeSpectrum (TensorProduct L₀ B Ω)) :=
      RelSeries.mk 2 ![q₀, q₁, q₂] (fun i => by fin_cases i <;> [exact hq₀₁; exact hq₁₂])
    have h2_le_1 : ((2 : ℕ) : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) :=
      (Order.LTSeries.length_le_krullDim q_ser).trans hDim_BΩ
    exact (by decide : ¬ (((2 : ℕ) : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞))) h2_le_1

  refine ⟨?_, q_fib, hSurj_q⟩
  change (⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥F_L₀)),
    (p.length : WithBot ℕ∞)) ≤ (1 : WithBot ℕ∞)
  refine iSup_le fun p => ?_
  obtain ⟨x, hx₀⟩ := (p 0).isIrreducible.1
  obtain ⟨R_cat, f, hOpen_f, ⟨y₀, hy₀⟩, _⟩ :=
    AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
      (show x ∈ (⊤ : F_L₀.Opens) from trivial)
  have : AlgebraicGeometry.IsOpenImmersion f := hOpen_f
  let B : Type u := R_cat
  let φ_op := AlgebraicGeometry.Spec.fullyFaithful.preimage (f ≫ p_L₀)
  let φ_B : CommRingCat.of L₀ ⟶ R_cat := φ_op.unop
  have hφ_B : AlgebraicGeometry.Spec.map φ_B = f ≫ p_L₀ := by
    change AlgebraicGeometry.Scheme.Spec.map φ_B.op = f ≫ p_L₀
    rw [Quiver.Hom.op_unop]
    exact AlgebraicGeometry.Spec.fullyFaithful.map_preimage (f ≫ p_L₀)
  let : Algebra L₀ B := φ_B.hom.toAlgebra
  have hSpec_B :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L₀ B)) = f ≫ p_L₀ :=
    hφ_B
  have hPB_aff :
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f q_Ω)
        (CategoryTheory.Limits.pullback.snd f q_Ω ≫
          CategoryTheory.Limits.pullback.snd p_L₀ s_L₀Ω)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L₀ B)))
        s_L₀Ω := by
    have hP :=
      ((CategoryTheory.IsPullback.of_hasPullback f q_Ω).flip.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback p_L₀ s_L₀Ω).flip).flip
    rwa [← hSpec_B] at hP
  let e_aff :
      CategoryTheory.Limits.pullback f q_Ω ≅
        CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L₀ B))) s_L₀Ω :=
    hPB_aff.isoPullback
  let ι_Ω :
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct L₀ B Ω)) ⟶ F_Ω :=
    (AlgebraicGeometry.pullbackSpecIso L₀ B Ω).inv ≫
      e_aff.inv ≫ CategoryTheory.Limits.pullback.snd f q_Ω
  have hDim_BΩ : ringKrullDim (TensorProduct L₀ B Ω) ≤ (1 : WithBot ℕ∞) := by
    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (TensorProduct L₀ B Ω)]
    change topologicalKrullDim
      ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct L₀ B Ω))) ≤ (1 : WithBot ℕ∞)
    rw [ι_Ω.isOpenEmbedding.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq]
    exact (topologicalKrullDim_subspace_le _ _).trans hDim_FΩ
  have hDim_SpecB : topologicalKrullDim ↥(AlgebraicGeometry.Spec R_cat) ≤ (1 : WithBot ℕ∞) := by
    change topologicalKrullDim ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) ≤ (1 : WithBot ℕ∞)
    have hEqDim :
        topologicalKrullDim ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) = ringKrullDim B :=
      PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim B
    rw [hEqDim]
    exact hDim_ring B hDim_BΩ
  have h_cl :
      ∀ i : Fin (p.length + 1),
        closure ((p i : Set ↥F_L₀) ∩ Set.range f.base) = (p i : Set ↥F_L₀) := by
    intro i
    refine Set.Subset.antisymm (closure_minimal Set.inter_subset_left (p i).isClosed) ?_
    intro z hz
    by_contra hz_not
    have hx_i : x ∈ (p i : Set ↥F_L₀) := p.monotone (Fin.zero_le i) hx₀
    obtain ⟨w, hw_pi, hw_rng, hw_not_cl⟩ :=
      (p i).isIrreducible.2
        (Set.range f.base)
        (closure ((p i : Set ↥F_L₀) ∩ Set.range f.base))ᶜ
        f.isOpenEmbedding.isOpen_range
        isClosed_closure.isOpen_compl
        ⟨x, hx_i, ⟨y₀, hy₀⟩⟩
        ⟨z, hz, hz_not⟩
    exact hw_not_cl (subset_closure ⟨hw_pi, hw_rng⟩)
  let q_V_fun : Fin (p.length + 1) →
      TopologicalSpace.IrreducibleCloseds ↥(AlgebraicGeometry.Spec R_cat) := fun i =>
    ⟨f.base ⁻¹' (p i : Set ↥F_L₀),
      ⟨⟨y₀, by rw [Set.mem_preimage, hy₀]; exact p.monotone (Fin.zero_le i) hx₀⟩,
        (p i).isIrreducible.2.preimage f.isOpenEmbedding⟩,
      (p i).isClosed.preimage f.continuous⟩
  have hq_V_step : ∀ j : Fin p.length, q_V_fun j.castSucc < q_V_fun j.succ := by
    intro j
    have hpj : p j.castSucc < p j.succ := p.step j
    have hpj_sub : (p j.castSucc : Set ↥F_L₀) ⊆ (p j.succ : Set ↥F_L₀) := le_of_lt hpj
    refine lt_of_le_of_ne
      (show q_V_fun j.castSucc ≤ q_V_fun j.succ from fun _ hy => hpj_sub hy) ?_
    intro hEq
    have hClEq :
        closure (f.base '' (q_V_fun j.castSucc : Set ↥(AlgebraicGeometry.Spec R_cat))) =
          closure (f.base '' (q_V_fun j.succ : Set ↥(AlgebraicGeometry.Spec R_cat))) :=
      congrArg (fun c : TopologicalSpace.IrreducibleCloseds ↥(AlgebraicGeometry.Spec R_cat) =>
        closure (f.base '' (c : Set ↥(AlgebraicGeometry.Spec R_cat)))) hEq
    change closure (f.base '' (f.base ⁻¹' (p j.castSucc : Set ↥F_L₀))) =
      closure (f.base '' (f.base ⁻¹' (p j.succ : Set ↥F_L₀))) at hClEq
    rw [Set.image_preimage_eq_inter_range, Set.image_preimage_eq_inter_range,
      h_cl j.castSucc, h_cl j.succ] at hClEq
    exact ne_of_lt hpj (SetLike.ext' hClEq)
  let q_V : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(AlgebraicGeometry.Spec R_cat)) :=
    RelSeries.mk p.length q_V_fun hq_V_step
  exact (Order.LTSeries.length_le_krullDim q_V).trans hDim_SpecB

theorem weil_dvr_schematic_image_closure_and_proj_immersion (k : Type u) [Field k] (m : ℕ)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (f₁ : V₁ ⟶ weilProjectiveSpaceOver k m)
    (hProp : AlgebraicGeometry.IsProper f₁.left)
    (σ₁ : weilProjectiveSpaceOver k m ⟶ V₁)
    (hSec : σ₁ ≫ f₁ = 𝟙 (weilProjectiveSpaceOver k m))
    (hSepB₀ : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k m).hom)
    (hProjBC : ∀ (L : Type u) [Field L] [Algebra k L],
      IsProjectiveOverField L (weilBaseChangeOver k L V₁))
    (ι_aff : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin m) k)) ⟶
      (weilProjectiveSpaceOver k m).left)
    [AlgebraicGeometry.IsOpenImmersion ι_aff]
    (hι_hom : ι_aff ≫ (weilProjectiveSpaceOver k m).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (L : Type u) [Field L] [Algebra k L]
    (R : Type u) [CommRing R] [IsDomain R]
    [Algebra k R] [Algebra L R] [IsScalarTower k L R]
    [Algebra (MvPolynomial (Fin m) k) R] [IsScalarTower k (MvPolynomial (Fin m) k) R]
    (ϖ : R)
    (hCharts : ∀ (O : V₁.left.Opens) (v : ↥V₁.left),
      v ∈ O →
      f₁.left.base v ∈ Set.range ι_aff.base →
      ∃ (U : V₁.left.Opens) (C : Type u) (_ : CommRing C) (_ : IsDomain C)
        (_ : Algebra k C) (_ : Algebra.FiniteType k C)
        (_ : Algebra (MvPolynomial (Fin m) k) C)
        (_ : IsScalarTower k (MvPolynomial (Fin m) k) C)
        (e_U : U.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of C)),
        v ∈ U ∧
        U ≤ O ∧
        Function.Injective (algebraMap (MvPolynomial (Fin m) k) C) ∧
        ringKrullDim C = ((m + 1 : ℕ) : WithBot ℕ∞) ∧
        U.ι ≫ f₁.left =
          e_U.hom ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin m) k) C)) ≫ ι_aff)
    (hAlgDVR : ∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C]
        [Algebra (MvPolynomial (Fin m) k) C] [IsScalarTower k (MvPolynomial (Fin m) k) C],
      Function.Injective (algebraMap (MvPolynomial (Fin m) k) C) →
      IsDomain (TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R)) ∧
      (ringKrullDim C = ((m + 1 : ℕ) : WithBot ℕ∞) →
       ringKrullDim (TensorProduct (MvPolynomial (Fin m) k) C (R ⧸ Ideal.span {ϖ})) ≤
         (1 : WithBot ℕ∞) →
       ∀ q : PrimeSpectrum (TensorProduct (MvPolynomial (Fin m) k) C R),
         q ∈ closure (Set.range (PrimeSpectrum.comap
           (Algebra.TensorProduct.map
             (AlgHom.id (MvPolynomial (Fin m) k) C)
             (IsScalarTower.toAlgHom (MvPolynomial (Fin m) k) R (FractionRing R))).toRingHom))))
    (hDimW₀ : topologicalKrullDim
      ↥(CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.snd f₁.left
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin m) k) R)) ≫ ι_aff))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) ≤
      (1 : WithBot ℕ∞)) :
    ∃ (N : ℕ)
      (Y_R : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y_R)
      (p_R : Y_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (_ : AlgebraicGeometry.IsProper p_R) (_ : AlgebraicGeometry.Surjective p_R)
      (σ_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y_R)
      (gProj : Y_R ⟶ (weilProjectiveSpaceOver L N).left)
      (hComm : gProj ≫ (weilProjectiveSpaceOver L N).hom =
        p_R ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L R)))
      (φ₀ :
        CategoryTheory.Limits.pullback p_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ})))) ⟶
        CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd f₁.left
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin m) k) R)) ≫ ι_aff))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))),
      (σ_R ≫ p_R = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R))) ∧
      AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.lift gProj p_R hComm) ∧
      AlgebraicGeometry.IsClosedImmersion φ₀ ∧
      AlgebraicGeometry.Surjective φ₀ :=
by
  let A₀ := MvPolynomial (Fin m) k
  let B₀ := weilProjectiveSpaceOver k m
  have : IsSeparated B₀.hom := hSepB₀
  have : IsProper f₁.left := hProp
  let γ_R : Spec (CommRingCat.of R) ⟶ B₀.left :=
    Spec.map (CommRingCat.ofHom (algebraMap A₀ R)) ≫ ι_aff
  let W_R := Limits.pullback f₁.left γ_R
  let π_VR : W_R ⟶ V₁.left := Limits.pullback.fst f₁.left γ_R
  let p_W : W_R ⟶ Spec (CommRingCat.of R) := Limits.pullback.snd f₁.left γ_R
  have hPB_R : IsPullback π_VR p_W f₁.left γ_R := IsPullback.of_hasPullback f₁.left γ_R

  
  have hSec_left : σ₁.left ≫ f₁.left = 𝟙 B₀.left := by
    simpa using congrArg Over.Hom.left hSec
  let x_aff : ↥(Spec (CommRingCat.of A₀)) := (⊥ : PrimeSpectrum A₀)
  let v₀ : ↥V₁.left := σ₁.left.base (ι_aff.base x_aff)
  have hv₀ : f₁.left.base v₀ ∈ Set.range ι_aff.base := by
    refine ⟨x_aff, ?_⟩
    change ι_aff.base x_aff = (σ₁.left ≫ f₁.left).base (ι_aff.base x_aff)
    rw [hSec_left]
    rfl

  
  let F₀ := FractionRing R
  let ι_F₀ : Spec (CommRingCat.of F₀) ⟶ Spec (CommRingCat.of R) :=
    Spec.map (CommRingCat.ofHom (algebraMap R F₀))
  let W_F₀ := Limits.pullback p_W ι_F₀
  let j : W_F₀ ⟶ W_R := Limits.pullback.fst p_W ι_F₀
  let p_F₀ : W_F₀ ⟶ Spec (CommRingCat.of F₀) := Limits.pullback.snd p_W ι_F₀
  let π_VF₀ : W_F₀ ⟶ V₁.left := j ≫ π_VR
  have hBase_F₀ : ι_F₀ ≫ γ_R = Spec.map (CommRingCat.ofHom (algebraMap A₀ F₀)) ≫ ι_aff := by
    dsimp [ι_F₀, γ_R]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq A₀ R F₀]
  have hPB_F₀ : IsPullback π_VF₀ p_F₀ f₁.left (Spec.map (CommRingCat.ofHom (algebraMap A₀ F₀)) ≫ ι_aff) := by
    have hP := (IsPullback.of_hasPullback p_W ι_F₀).paste_horiz hPB_R
    rwa [hBase_F₀] at hP

  let R₀ := R ⧸ Ideal.span {ϖ}
  let ι₀ : Spec (CommRingCat.of R₀) ⟶ Spec (CommRingCat.of R) :=
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ})))
  let W₀ := Limits.pullback p_W ι₀
  let j₀ : W₀ ⟶ W_R := Limits.pullback.fst p_W ι₀
  let p₀ : W₀ ⟶ Spec (CommRingCat.of R₀) := Limits.pullback.snd p_W ι₀
  let π_V₀ : W₀ ⟶ V₁.left := j₀ ≫ π_VR
  have hBase_0 : ι₀ ≫ γ_R = Spec.map (CommRingCat.ofHom (algebraMap A₀ R₀)) ≫ ι_aff := by
    dsimp [ι₀, γ_R]
    have hq : Ideal.Quotient.mk (Ideal.span {ϖ}) = algebraMap R R₀ := rfl
    rw [hq, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq A₀ R R₀]
  have hPB_0 : IsPullback π_V₀ p₀ f₁.left (Spec.map (CommRingCat.ofHom (algebraMap A₀ R₀)) ≫ ι_aff) := by
    have hP := (IsPullback.of_hasPullback p_W ι₀).paste_horiz hPB_R
    rwa [hBase_0] at hP

  
  have hChartOpen :
      ∀ (T : Type u) [CommRing T] [Algebra A₀ T]
        {W_T : Scheme.{u}} (π_V : W_T ⟶ V₁.left) (p_T : W_T ⟶ Spec (CommRingCat.of T)),
        IsPullback π_V p_T f₁.left (Spec.map (CommRingCat.ofHom (algebraMap A₀ T)) ≫ ι_aff) →
        ∀ (U : V₁.left.Opens) (C : Type u) [CommRing C] [Algebra A₀ C]
          (e_U : U.toScheme ≅ Spec (CommRingCat.of C)),
          U.ι ≫ f₁.left = e_U.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A₀ C)) ≫ ι_aff →
          ∃ (ψ : Spec (CommRingCat.of (TensorProduct A₀ C T)) ⟶ W_T),
            IsOpenImmersion ψ ∧
            Set.range ψ.base = π_V.base ⁻¹' (U : Set ↥V₁.left) ∧
            ψ ≫ π_V =
              Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
                e_U.inv ≫ U.ι ∧
            ψ ≫ p_T = Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) := by
    intro T _ _ W_T π_V p_T hPB U C _ _ e_U hU_fac
    let s_C : Spec (CommRingCat.of C) ⟶ Spec (CommRingCat.of A₀) :=
      Spec.map (CommRingCat.ofHom (algebraMap A₀ C))
    let s_T : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of A₀) :=
      Spec.map (CommRingCat.ofHom (algebraMap A₀ T))
    let i_L : Spec (CommRingCat.of (TensorProduct A₀ C T)) ⟶ Spec (CommRingCat.of C) :=
      Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
    let i_R : Spec (CommRingCat.of (TensorProduct A₀ C T)) ⟶ Spec (CommRingCat.of T) :=
      Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
    have hPB_Spec : IsPullback i_L i_R s_C s_T := by
      refine (IsPullback.of_hasPullback s_C s_T).of_iso
        (pullbackSpecIso A₀ C T) (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · dsimp [s_C, s_T, i_L]
        rw [← pullbackSpecIso_inv_fst A₀ C T, Iso.hom_inv_id_assoc]
        simp
      · dsimp [s_C, s_T, i_R]
        rw [← pullbackSpecIso_inv_snd A₀ C T, Iso.hom_inv_id_assoc]
        simp
      · simp
      · simp
    have hPB_mono : IsPullback i_L i_R (s_C ≫ ι_aff) (s_T ≫ ι_aff) :=
      IsPullback.of_isLimit
        (Limits.PullbackCone.isLimitOfCompMono s_C s_T ι_aff _ hPB_Spec.isLimit)
    have hPB_outer : IsPullback (i_L ≫ e_U.inv) i_R (U.ι ≫ f₁.left) (s_T ≫ ι_aff) := by
      refine hPB_mono.of_iso (Iso.refl _) e_U.symm (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · dsimp [s_C]
        simp [hU_fac]
      · simp
    have hψ_cond : ((i_L ≫ e_U.inv) ≫ U.ι) ≫ f₁.left = i_R ≫ (s_T ≫ ι_aff) := by
      rw [Category.assoc]
      exact hPB_outer.w
    let ψ : Spec (CommRingCat.of (TensorProduct A₀ C T)) ⟶ W_T :=
      hPB.lift ((i_L ≫ e_U.inv) ≫ U.ι) i_R hψ_cond
    have hψ_fst : ψ ≫ π_V = (i_L ≫ e_U.inv) ≫ U.ι := hPB.lift_fst _ _ _
    have hψ_snd : ψ ≫ p_T = i_R := hPB.lift_snd _ _ _
    have hPB_top : IsPullback (i_L ≫ e_U.inv) ψ U.ι π_V := by
      refine IsPullback.of_bot ?_ hψ_fst.symm hPB
      rwa [hψ_snd]
    have hOpen_ψ : IsOpenImmersion ψ :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsOpenImmersion) hPB_top inferInstance
    let e_open := IsPullback.isoIsPullback U.toScheme W_T hPB_top (isPullback_morphismRestrict π_V U)
    have he_snd : e_open.hom ≫ (π_V ⁻¹ᵁ U).ι = ψ :=
      IsPullback.isoIsPullback_hom_snd U.toScheme W_T hPB_top (isPullback_morphismRestrict π_V U)
    have hRange : Set.range ψ.base = π_V.base ⁻¹' (U : Set ↥V₁.left) := by
      have hSurj_e : Function.Surjective e_open.hom.base := fun y =>
        ⟨e_open.inv.base y, by rw [← Scheme.Hom.comp_apply, e_open.inv_hom_id]; rfl⟩
      rw [← he_snd, Scheme.Hom.comp_base, TopCat.coe_comp,
        Set.range_comp, hSurj_e.range_eq, Set.image_univ, (π_V ⁻¹ᵁ U).range_ι]
      rfl
    exact ⟨ψ, hOpen_ψ, hRange, by simpa [Category.assoc] using hψ_fst, hψ_snd⟩

  
  have hMemRange_F₀ : ∀ x : ↥W_F₀, f₁.left.base (π_VF₀.base x) ∈ Set.range ι_aff.base := by
    intro x
    have h := congrFun (congrArg (fun g => (g.base : _ → _)) hPB_F₀.w) x
    change f₁.left.base (π_VF₀.base x) =
      ι_aff.base ((Spec.map (CommRingCat.ofHom (algebraMap A₀ F₀))).base (p_F₀.base x)) at h
    rw [h]
    exact ⟨_, rfl⟩

  have hChartIrred_F₀ :
      ∀ (U : V₁.left.Opens) (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C]
        [Algebra A₀ C] [IsScalarTower k A₀ C]
        (e_U : U.toScheme ≅ Spec (CommRingCat.of C)),
        Function.Injective (algebraMap A₀ C) →
        U.ι ≫ f₁.left = e_U.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A₀ C)) ≫ ι_aff →
        (π_VF₀.base ⁻¹' (U : Set ↥V₁.left)).Nonempty ∧
          IsIrreducible (π_VF₀.base ⁻¹' (U : Set ↥V₁.left)) := by
    intro U C _ _ _ _ _ _ e_U hInjC hU_fac
    have hDomCF₀ : IsDomain (TensorProduct A₀ C F₀) := (hAlgDVR C hInjC).1
    have hIntSpec : IsIntegral (Spec (CommRingCat.of (TensorProduct A₀ C F₀))) :=
      (affine_isIntegral_iff (CommRingCat.of (TensorProduct A₀ C F₀))).mpr hDomCF₀
    have hIrredSpec : IrreducibleSpace ↥(Spec (CommRingCat.of (TensorProduct A₀ C F₀))) :=
      irreducibleSpace_of_isIntegral _
    obtain ⟨ψ, _, hRange, _, _⟩ := hChartOpen F₀ π_VF₀ p_F₀ hPB_F₀ U C e_U hU_fac
    rw [← hRange, ← Set.image_univ]
    have hNe : (ψ.base '' Set.univ).Nonempty := by
      obtain ⟨q₀⟩ := hIrredSpec.toNonempty
      exact ⟨ψ.base q₀, ⟨q₀, trivial, rfl⟩⟩
    exact ⟨hNe, hNe, PreirreducibleSpace.isPreirreducible_univ.image ψ.base ψ.continuous.continuousOn⟩

  have hNonempty_WF₀ : Nonempty ↥W_F₀ := by
    obtain ⟨U₀, C₀, hCR₀, hDom₀, hAlgk₀, hFT₀, hAlgA₀, hTow₀, e_U₀, _, _, hInj₀, _, hFac₀⟩ :=
      hCharts ⊤ v₀ trivial hv₀
    let _ := hCR₀; let _ := hDom₀; let _ := hAlgk₀; let _ := hFT₀; let _ := hAlgA₀; let _ := hTow₀
    obtain ⟨⟨x₀, _⟩, _⟩ := hChartIrred_F₀ U₀ C₀ e_U₀ hInj₀ hFac₀
    exact ⟨x₀⟩

  have hPre_WF₀ : PreirreducibleSpace ↥W_F₀ := ⟨by
    intro O₁ O₂ hO₁ hO₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
    obtain ⟨U₁, C₁, hCR₁, hDom₁, hAlgk₁, hFT₁, hAlgA₁, hTow₁, e_U₁, hx₁U₁, _, hInj₁, _, hFac₁⟩ :=
      hCharts ⊤ (π_VF₀.base x₁) trivial (hMemRange_F₀ x₁)
    obtain ⟨U₂, C₂, hCR₂, hDom₂, hAlgk₂, hFT₂, hAlgA₂, hTow₂, e_U₂, hx₂U₂, _, hInj₂, _, hFac₂⟩ :=
      hCharts ⊤ (π_VF₀.base x₂) trivial (hMemRange_F₀ x₂)
    have hIrredV : IrreducibleSpace ↥V₁.left := irreducibleSpace_of_isIntegral V₁.left
    obtain ⟨v₁₂, _, hv₁₂U₁, hv₁₂U₂⟩ :=
      PreirreducibleSpace.isPreirreducible_univ U₁.1 U₂.1 U₁.isOpen U₂.isOpen
        ⟨π_VF₀.base x₁, trivial, hx₁U₁⟩ ⟨π_VF₀.base x₂, trivial, hx₂U₂⟩
    have hv₁₂Range : f₁.left.base v₁₂ ∈ Set.range ι_aff.base := by
      have h := congrFun (congrArg (fun g => (g.base : _ → _)) hFac₁) ⟨v₁₂, hv₁₂U₁⟩
      change f₁.left.base v₁₂ = ι_aff.base _ at h
      rw [h]; exact ⟨_, rfl⟩
    obtain ⟨U₃, C₃, hCR₃, hDom₃, hAlgk₃, hFT₃, hAlgA₃, hTow₃, e_U₃, _, hU₃LE, hInj₃, _, hFac₃⟩ :=
      hCharts (U₁ ⊓ U₂) v₁₂ ⟨hv₁₂U₁, hv₁₂U₂⟩ hv₁₂Range
    have hIrred₁ : IsIrreducible (π_VF₀.base ⁻¹' (U₁ : Set ↥V₁.left)) := by
      let _ := hCR₁; let _ := hDom₁; let _ := hAlgk₁; let _ := hFT₁; let _ := hAlgA₁; let _ := hTow₁
      exact (hChartIrred_F₀ U₁ C₁ e_U₁ hInj₁ hFac₁).2
    have hIrred₂ : IsIrreducible (π_VF₀.base ⁻¹' (U₂ : Set ↥V₁.left)) := by
      let _ := hCR₂; let _ := hDom₂; let _ := hAlgk₂; let _ := hFT₂; let _ := hAlgA₂; let _ := hTow₂
      exact (hChartIrred_F₀ U₂ C₂ e_U₂ hInj₂ hFac₂).2
    obtain ⟨z, hzU₃⟩ : (π_VF₀.base ⁻¹' (U₃ : Set ↥V₁.left)).Nonempty := by
      let _ := hCR₃; let _ := hDom₃; let _ := hAlgk₃; let _ := hFT₃; let _ := hAlgA₃; let _ := hTow₃
      exact (hChartIrred_F₀ U₃ C₃ e_U₃ hInj₃ hFac₃).1
    have hzU₁₂ : π_VF₀.base z ∈ U₁ ⊓ U₂ := hU₃LE hzU₃
    obtain ⟨y, hyU₁, hyO₁, hyU₂⟩ :=
      hIrred₁.isPreirreducible O₁ (π_VF₀.base ⁻¹' (U₂ : Set ↥V₁.left))
        hO₁ (U₂.isOpen.preimage π_VF₀.continuous)
        ⟨x₁, hx₁U₁, hx₁⟩ ⟨z, hzU₁₂.1, hzU₁₂.2⟩
    obtain ⟨w, _, hwO₁, hwO₂⟩ :=
      hIrred₂.isPreirreducible O₁ O₂ hO₁ hO₂
        ⟨y, hyU₂, hyO₁⟩ ⟨x₂, hx₂U₂, hx₂⟩
    exact ⟨w, trivial, hwO₁, hwO₂⟩⟩

  have : IrreducibleSpace ↥W_F₀ := { toPreirreducibleSpace := hPre_WF₀, toNonempty := hNonempty_WF₀ }
  have : ∀ x : ↥W_F₀, _root_.IsReduced ↑(W_F₀.presheaf.stalk x) := by
    intro x
    obtain ⟨U, C, hCR, hDom, hAlgk, hFT, hAlgA, hTow, e_U, hxU, _, hInj, _, hFac⟩ :=
      hCharts ⊤ (π_VF₀.base x) trivial (hMemRange_F₀ x)
    let _ := hCR; let _ := hDom; let _ := hAlgk; let _ := hFT; let _ := hAlgA; let _ := hTow
    have hDomCF₀ : IsDomain (TensorProduct A₀ C F₀) := (hAlgDVR C hInj).1
    have : IsIntegral (Spec (CommRingCat.of (TensorProduct A₀ C F₀))) :=
      (affine_isIntegral_iff (CommRingCat.of (TensorProduct A₀ C F₀))).mpr hDomCF₀
    have : IsReduced (Spec (CommRingCat.of (TensorProduct A₀ C F₀))) := inferInstance
    obtain ⟨ψ, hOpenψ, hRange, _, _⟩ := hChartOpen F₀ π_VF₀ p_F₀ hPB_F₀ U C e_U hFac
    have hxRange : x ∈ Set.range ψ.base := by rw [hRange]; exact hxU
    obtain ⟨q, rfl⟩ := hxRange
    have hInjStalk : Function.Injective (CommRingCat.Hom.hom (ψ.stalkMap q)) := by
      intro a b hab
      have h1 := congrArg (CommRingCat.Hom.hom (inv (ψ.stalkMap q))) hab
      simpa [← CommRingCat.hom_comp] using h1
    exact isReduced_of_injective _ hInjStalk
  have : IsReduced W_F₀ := isReduced_of_isReduced_stalk W_F₀
  have hInt_WF₀ : IsIntegral W_F₀ := isIntegral_of_irreducibleSpace_of_isReduced W_F₀

  
  have hDense_j : DenseRange j.base := by
    rw [denseRange_iff_closure_range]
    ext w
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hwRange : f₁.left.base (π_VR.base w) ∈ Set.range ι_aff.base := by
      have h := congrFun (congrArg (fun g => (g.base : _ → _)) hPB_R.w) w
      change f₁.left.base (π_VR.base w) =
        ι_aff.base ((Spec.map (CommRingCat.ofHom (algebraMap A₀ R))).base (p_W.base w)) at h
      rw [h]; exact ⟨_, rfl⟩
    obtain ⟨U, C, hCR, hDom, hAlgk, hFT, hAlgA, hTow, e_U, hwU, _, hInjC, hDimC, hFac⟩ :=
      hCharts ⊤ (π_VR.base w) trivial hwRange
    let _ := hCR; let _ := hDom; let _ := hAlgk; let _ := hFT; let _ := hAlgA; let _ := hTow
    obtain ⟨ψ_R, _, hRange_R, hψR_fst, hψR_snd⟩ := hChartOpen R π_VR p_W hPB_R U C e_U hFac
    obtain ⟨ψ_F₀, _, _, hψF₀_fst, hψF₀_snd⟩ := hChartOpen F₀ π_VF₀ p_F₀ hPB_F₀ U C e_U hFac
    obtain ⟨ψ_0, hOpen_0, _, _, _⟩ := hChartOpen R₀ π_V₀ p₀ hPB_0 U C e_U hFac
    have hDimC₀ : ringKrullDim (TensorProduct A₀ C R₀) ≤ (1 : WithBot ℕ∞) := by
      rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
      change topologicalKrullDim ↥(Spec (CommRingCat.of (TensorProduct A₀ C R₀))) ≤ (1 : WithBot ℕ∞)
      rw [ψ_0.isOpenEmbedding.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq]
      exact (topologicalKrullDim_subspace_le _ _).trans hDimW₀
    let lam_gen := (Algebra.TensorProduct.map
      (AlgHom.id A₀ C) (IsScalarTower.toAlgHom A₀ R F₀)).toRingHom
    have hNat : ψ_F₀ ≫ j = Spec.map (CommRingCat.ofHom lam_gen) ≫ ψ_R := by
      apply Limits.pullback.hom_ext
      · calc
          (ψ_F₀ ≫ j) ≫ π_VR = ψ_F₀ ≫ π_VF₀ := Category.assoc _ _ _
          _ = Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫ e_U.inv ≫ U.ι :=
            hψF₀_fst
          _ = (Spec.map (CommRingCat.ofHom lam_gen) ≫
                Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)) ≫
              e_U.inv ≫ U.ι := by
            rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
            congr 3
            ext c
            simp [lam_gen]
          _ = (Spec.map (CommRingCat.ofHom lam_gen) ≫ ψ_R) ≫ π_VR := by
            rw [Category.assoc, Category.assoc, hψR_fst]
      · calc
          (ψ_F₀ ≫ j) ≫ p_W = ψ_F₀ ≫ (j ≫ p_W) := Category.assoc _ _ _
          _ = ψ_F₀ ≫ (p_F₀ ≫ ι_F₀) := by rw [Limits.pullback.condition]
          _ = (ψ_F₀ ≫ p_F₀) ≫ ι_F₀ := (Category.assoc _ _ _).symm
          _ = Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫ ι_F₀ := by
            rw [hψF₀_snd]
          _ = Spec.map (CommRingCat.ofHom lam_gen) ≫
              Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) := by
            dsimp [ι_F₀]
            rw [← Spec.map_comp, ← CommRingCat.ofHom_comp,
              ← Spec.map_comp, ← CommRingCat.ofHom_comp]
            apply congrArg Spec.map
            apply congrArg CommRingCat.ofHom
            ext r
            simp [lam_gen]
          _ = (Spec.map (CommRingCat.ofHom lam_gen) ≫ ψ_R) ≫ p_W := by
            rw [Category.assoc, hψR_snd]
    have hwRangeR : w ∈ Set.range ψ_R.base := by rw [hRange_R]; exact hwU
    obtain ⟨q, rfl⟩ := hwRangeR
    have hq_cl := (hAlgDVR C hInjC).2 hDimC hDimC₀ q
    have hMapBase : (Spec.map (CommRingCat.ofHom lam_gen)).base =
        TopCat.ofHom ⟨PrimeSpectrum.comap lam_gen, PrimeSpectrum.continuous_comap lam_gen⟩ :=
      Spec.map_base (CommRingCat.ofHom lam_gen)
    have hRangeEq : Set.range (PrimeSpectrum.comap lam_gen) =
        Set.range (Spec.map (CommRingCat.ofHom lam_gen)).base := by
      rw [hMapBase]; rfl
    rw [hRangeEq] at hq_cl
    have hImg1 : ψ_R.base q ∈ closure (ψ_R.base '' Set.range (Spec.map (CommRingCat.ofHom lam_gen)).base) :=
      image_closure_subset_closure_image ψ_R.continuous ⟨q, hq_cl, rfl⟩
    have hImg2 : ψ_R.base '' Set.range (Spec.map (CommRingCat.ofHom lam_gen)).base =
        Set.range (ψ_F₀ ≫ j).base := by
      rw [← Set.range_comp]
      change Set.range (Spec.map (CommRingCat.ofHom lam_gen) ≫ ψ_R).base = _
      rw [hNat]
    rw [hImg2] at hImg1
    exact closure_mono (by rintro _ ⟨y, rfl⟩; exact ⟨ψ_F₀.base y, rfl⟩) hImg1

  
  let Y_R := j.image
  let ι_Y : Y_R ⟶ W_R := j.imageι
  let p_R : Y_R ⟶ Spec (CommRingCat.of R) := ι_Y ≫ p_W
  have hIrred_gen : IrreducibleSpace ↥W_F₀ := irreducibleSpace_of_isIntegral W_F₀
  obtain ⟨y₀⟩ := hIrred_gen.toNonempty
  have hNonemptyY : Nonempty ↥Y_R := ⟨j.toImage.base y₀⟩
  have hDom : DenseRange j.toImage.base := IsDominant.denseRange (f := j.toImage)
  have hPreY : PreirreducibleSpace ↥Y_R := ⟨by
    intro u v hu hv ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
    obtain ⟨a, ha⟩ := hDom.exists_mem_open hu ⟨x₁, hx₁⟩
    obtain ⟨b, hb⟩ := hDom.exists_mem_open hv ⟨x₂, hx₂⟩
    obtain ⟨c, _, hc_u, hc_v⟩ :=
      PreirreducibleSpace.isPreirreducible_univ
        (j.toImage.base ⁻¹' u) (j.toImage.base ⁻¹' v)
        (hu.preimage j.toImage.continuous) (hv.preimage j.toImage.continuous)
        ⟨a, trivial, ha⟩ ⟨b, trivial, hb⟩
    exact ⟨j.toImage.base c, trivial, hc_u, hc_v⟩⟩
  have : IrreducibleSpace ↥Y_R := { toPreirreducibleSpace := hPreY, toNonempty := hNonemptyY }
  have : ∀ x : ↥Y_R, _root_.IsReduced ↑(Y_R.presheaf.stalk x) := by
    intro x
    obtain ⟨U_P, hUP, hxUP, _⟩ :=
      exists_isAffineOpen_mem_and_subset (x := ι_Y.base x) (U := ⊤) trivial
    let W_x : Y_R.Opens := ι_Y ⁻¹ᵁ U_P
    have hWx : IsAffineOpen W_x := hUP.preimage ι_Y
    have hxWx : x ∈ (W_x : Set ↥Y_R) := hxUP
    rw [← hWx.range_fromSpec] at hxWx
    obtain ⟨q, hq⟩ := hxWx
    rw [← hq]
    let e_sub := j.ker.subschemeObjIso ⟨U_P, hUP⟩
    let e_quot := Ideal.quotEquivOfEq (j.ker_apply ⟨U_P, hUP⟩)
    let φ_inj : ↑(Y_R.presheaf.obj (Opposite.op W_x)) →+*
        ↑(W_F₀.presheaf.obj (Opposite.op (j ⁻¹ᵁ U_P))) :=
      (RingHom.kerLift (CommRingCat.Hom.hom (j.app U_P))).comp
        (e_quot.toRingHom.comp (CommRingCat.Hom.hom e_sub.hom))
    have hInj_φ : Function.Injective φ_inj :=
      (RingHom.kerLift_injective _).comp
        (e_quot.injective.comp
          (fun a b hab => by
            have h1 := congrArg (CommRingCat.Hom.hom e_sub.inv) hab
            simpa [← CommRingCat.hom_comp] using h1))
    have hRed_Γ : _root_.IsReduced ↑(Y_R.presheaf.obj (Opposite.op W_x)) :=
      isReduced_of_injective φ_inj hInj_φ
    have : IsReduced (Spec (Y_R.presheaf.obj (Opposite.op W_x))) :=
      (affine_isReduced_iff _).mpr hRed_Γ
    have hInj_stalk : Function.Injective (CommRingCat.Hom.hom (hWx.fromSpec.stalkMap q)) := by
      intro a b hab
      have h1 := congrArg (CommRingCat.Hom.hom (inv (hWx.fromSpec.stalkMap q))) hab
      simpa [← CommRingCat.hom_comp] using h1
    exact isReduced_of_injective _ hInj_stalk
  have : IsReduced Y_R := isReduced_of_isReduced_stalk Y_R
  have hIntY_R : IsIntegral Y_R := isIntegral_of_irreducibleSpace_of_isReduced Y_R

  have hSurj_ιY : Surjective ι_Y := ⟨by
    intro w
    have hSub : Set.range j.base ⊆ Set.range ι_Y.base := by
      rintro _ ⟨y, rfl⟩
      exact ⟨j.toImage.base y, by rw [← Scheme.Hom.comp_apply, Scheme.Hom.toImage_imageι]⟩
    have hUniv : (Set.univ : Set ↥W_R) ⊆ Set.range ι_Y.base := by
      rw [← hDense_j.closure_range]
      exact closure_minimal hSub ι_Y.isClosedEmbedding.isClosed_range
    exact hUniv (Set.mem_univ w)⟩

  let σ_W : Spec (CommRingCat.of R) ⟶ W_R :=
    Limits.pullback.lift (γ_R ≫ σ₁.left) (𝟙 _)
      (by rw [Category.assoc, hSec_left, Category.comp_id, Category.id_comp])
  have hσ_W : σ_W ≫ p_W = 𝟙 (Spec (CommRingCat.of R)) := Limits.pullback.lift_snd _ _ _
  have hCl_σW : IsClosedImmersion σ_W := by
    have : IsClosedImmersion (σ_W ≫ p_W) := by rw [hσ_W]; infer_instance
    exact IsClosedImmersion.of_comp σ_W p_W
  have : IsIntegral (Spec (CommRingCat.of R)) := (affine_isIntegral_iff (CommRingCat.of R)).mpr inferInstance
  have : IsReduced (Spec (CommRingCat.of R)) := inferInstance
  have hKerLE : ι_Y.ker ≤ σ_W.ker := by
    rw [Scheme.IdealSheafData.le_def]
    intro U a ha
    have hKerEq : ι_Y.ker = j.ker := Scheme.IdealSheafData.ker_subschemeι j.ker
    have ha' : a ∈ j.ker.ideal U := by rwa [← hKerEq]
    have hSupp : (j.ker.support : Set ↥W_R) = Set.univ := by
      rw [← Scheme.IdealSheafData.range_subschemeι j.ker]
      exact Set.range_eq_univ.mpr hSurj_ιY.surj
    have hZeroUniv : W_R.zeroLocus (j.ker.ideal U : Set ↑(W_R.presheaf.obj (Opposite.op U.1))) = Set.univ := by
      apply Set.eq_univ_of_univ_subset
      rw [← hSupp]
      change j.ker.supportSet ⊆ _
      rw [j.ker.supportSet_eq_iInter_zeroLocus]
      exact Set.iInter_subset _ U
    have hSpecZero : PrimeSpectrum.zeroLocus (j.ker.ideal U : Set ↑(W_R.presheaf.obj (Opposite.op U.1))) = Set.univ := by
      rw [← U.2.fromSpec_preimage_zeroLocus, hZeroUniv]
      exact Set.preimage_univ
    have hNil : IsNilpotent a :=
      mem_nilradical.mp ((PrimeSpectrum.zeroLocus_eq_univ_iff _).mp hSpecZero ha')
    have hNilMap : IsNilpotent ((CommRingCat.Hom.hom (σ_W.app U.1)) a) := hNil.map _
    rw [σ_W.ker_apply U, RingHom.mem_ker]
    exact hNilMap.eq_zero
  let σ_R : Spec (CommRingCat.of R) ⟶ Y_R := IsClosedImmersion.lift ι_Y σ_W hKerLE
  have hSec_R : σ_R ≫ p_R = 𝟙 (Spec (CommRingCat.of R)) := by
    dsimp [p_R]
    rw [← Category.assoc, IsClosedImmersion.lift_fac, hσ_W]
  have hSurj_pR : Surjective p_R := ⟨fun x =>
    ⟨σ_R.base x, by simpa using congrFun (congrArg (fun g => (g.base : _ → _)) hSec_R) x⟩⟩

  let φ₀ : Limits.pullback p_R ι₀ ⟶ Limits.pullback p_W ι₀ :=
    Limits.pullback.lift (Limits.pullback.fst p_R ι₀ ≫ ι_Y) (Limits.pullback.snd p_R ι₀)
      (by rw [Category.assoc]; exact Limits.pullback.condition)
  have hPB_φ₀ : IsPullback (Limits.pullback.fst p_R ι₀) φ₀ ι_Y (Limits.pullback.fst p_W ι₀) := by
    refine IsPullback.of_bot ?_ (Limits.pullback.lift_fst _ _ _).symm
      (IsPullback.of_hasPullback p_W ι₀)
    rw [Limits.pullback.lift_snd]
    exact IsPullback.of_hasPullback p_R ι₀
  have hCl_φ₀ : IsClosedImmersion φ₀ :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsClosedImmersion) hPB_φ₀ inferInstance
  have hSurj_φ₀ : Surjective φ₀ :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @Surjective) hPB_φ₀ hSurj_ιY

  
  obtain ⟨N, ι_VL_over, hCl_VL⟩ := hProjBC L
  let P_L := weilProjectiveSpaceOver L N
  let s_kL : Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of k) :=
    Spec.map (CommRingCat.ofHom (algebraMap k L))
  let s_LR : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of L) :=
    Spec.map (CommRingCat.ofHom (algebraMap L R))
  let s_kR : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of k) :=
    Spec.map (CommRingCat.ofHom (algebraMap k R))
  let ι_VL : Limits.pullback V₁.hom s_kL ⟶ P_L.left := ι_VL_over.left
  have : IsClosedImmersion ι_VL := hCl_VL
  have hι_VL : ι_VL ≫ P_L.hom = Limits.pullback.snd V₁.hom s_kL := Over.w ι_VL_over
  have hs_comp : s_LR ≫ s_kL = s_kR := by
    dsimp [s_LR, s_kL, s_kR]
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq k L R]
  have hγ_hom : γ_R ≫ B₀.hom = s_kR := by
    dsimp [γ_R, B₀, s_kR]
    rw [Category.assoc, hι_hom, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hC : (MvPolynomial.C : k →+* A₀) = algebraMap k A₀ := rfl
    rw [hC, ← IsScalarTower.algebraMap_eq k A₀ R]

  let P_BR := Limits.pullback B₀.hom s_kR
  let Γ_γ : Spec (CommRingCat.of R) ⟶ P_BR :=
    Limits.pullback.lift γ_R (𝟙 _) (by rw [Category.id_comp, hγ_hom])
  have : IsSeparated (Limits.pullback.snd B₀.hom s_kR) := inferInstance
  have hCl_Γ : IsClosedImmersion Γ_γ := by
    have : IsClosedImmersion (Γ_γ ≫ Limits.pullback.snd B₀.hom s_kR) := by
      rw [Limits.pullback.lift_snd]; infer_instance
    exact IsClosedImmersion.of_comp Γ_γ (Limits.pullback.snd B₀.hom s_kR)

  let V_1L := Limits.pullback V₁.hom s_kL
  let p_VL : V_1L ⟶ Spec (CommRingCat.of L) := Limits.pullback.snd V₁.hom s_kL
  let P_VLR := Limits.pullback p_VL s_LR
  let π'_V : P_VLR ⟶ V₁.left := Limits.pullback.fst p_VL s_LR ≫ Limits.pullback.fst V₁.hom s_kL
  let q_VR : P_VLR ⟶ Spec (CommRingCat.of R) := Limits.pullback.snd p_VL s_LR
  have hPB_VkR : IsPullback π'_V q_VR V₁.hom s_kR := by
    have hP := (IsPullback.of_hasPullback p_VL s_LR).paste_horiz (IsPullback.of_hasPullback V₁.hom s_kL)
    rwa [hs_comp] at hP
  let f_tilde : P_VLR ⟶ P_BR :=
    Limits.pullback.lift (π'_V ≫ f₁.left) q_VR
      (by rw [Category.assoc, Over.w f₁]; exact hPB_VkR.w)
  have hPB_mid : IsPullback π'_V f_tilde f₁.left (Limits.pullback.fst B₀.hom s_kR) := by
    refine IsPullback.of_bot ?_ (Limits.pullback.lift_fst _ _ _).symm
      (IsPullback.of_hasPullback B₀.hom s_kR)
    rw [Limits.pullback.lift_snd, Over.w f₁]
    exact hPB_VkR
  have hα_cond : π_VR ≫ V₁.hom = p_W ≫ s_kR := by
    rw [← Over.w f₁, ← Category.assoc, Limits.pullback.condition, Category.assoc, hγ_hom]
  let α_W : W_R ⟶ P_VLR := hPB_VkR.lift π_VR p_W hα_cond
  have hα_fst : α_W ≫ π'_V = π_VR := hPB_VkR.lift_fst _ _ _
  have hα_snd : α_W ≫ q_VR = p_W := hPB_VkR.lift_snd _ _ _
  have hα_comm : α_W ≫ f_tilde = p_W ≫ Γ_γ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, hα_fst,
        Category.assoc, Limits.pullback.lift_fst, Limits.pullback.condition]
    · rw [Category.assoc, Limits.pullback.lift_snd, hα_snd,
        Category.assoc, Limits.pullback.lift_snd, Category.comp_id]
  have hPB_α : IsPullback α_W p_W f_tilde Γ_γ := by
    refine IsPullback.of_right ?_ hα_comm hPB_mid
    rw [hα_fst, Limits.pullback.lift_fst]
    exact hPB_R
  have hCl_α : IsClosedImmersion α_W :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @IsClosedImmersion) hPB_α.flip inferInstance

  let P_PR := Limits.pullback P_L.hom s_LR
  let β_Proj : P_VLR ⟶ P_PR :=
    Limits.pullback.lift (Limits.pullback.fst p_VL s_LR ≫ ι_VL) q_VR
      (by rw [Category.assoc, hι_VL]; exact Limits.pullback.condition)
  have hPB_β : IsPullback (Limits.pullback.fst p_VL s_LR) β_Proj ι_VL
      (Limits.pullback.fst P_L.hom s_LR) := by
    refine IsPullback.of_bot ?_ (Limits.pullback.lift_fst _ _ _).symm
      (IsPullback.of_hasPullback P_L.hom s_LR)
    rw [Limits.pullback.lift_snd, hι_VL]
    exact IsPullback.of_hasPullback p_VL s_LR
  have hCl_β : IsClosedImmersion β_Proj :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @IsClosedImmersion) hPB_β inferInstance

  let ι_tot : Y_R ⟶ P_PR := ι_Y ≫ α_W ≫ β_Proj
  have hCl_tot : IsClosedImmersion ι_tot := inferInstance
  let gProj : Y_R ⟶ P_L.left := ι_tot ≫ Limits.pullback.fst P_L.hom s_LR
  have h_tot_snd : ι_tot ≫ Limits.pullback.snd P_L.hom s_LR = p_R := by
    dsimp [ι_tot, β_Proj]
    rw [Category.assoc, Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
      Category.assoc ι_Y α_W q_VR, hα_snd]
  have hComm : gProj ≫ P_L.hom = p_R ≫ s_LR := by
    dsimp [gProj]
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, h_tot_snd]
  have hLiftEq : Limits.pullback.lift gProj p_R hComm = ι_tot := by
    apply Limits.pullback.hom_ext
    · exact Limits.pullback.lift_fst _ _ _
    · rw [Limits.pullback.lift_snd, h_tot_snd]
  refine ⟨N, Y_R, hIntY_R, p_R, inferInstance, hSurj_pR, σ_R, gProj, hComm, φ₀,
    hSec_R, ?_, hCl_φ₀, hSurj_φ₀⟩
  rwa [hLiftEq]

theorem weil_algClosed_pencil_generic_slope_dvr_reduction (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hProjV₁ : IsProjectiveOverField k V₁)
    (hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (f₁ : V₁ ⟶ weilProjectiveSpaceOver k m)
    (hProp : AlgebraicGeometry.IsProper f₁.left)
    (hSurj : AlgebraicGeometry.Surjective f₁.left)
    (σ₁ : weilProjectiveSpaceOver k m ⟶ V₁)
    (hSec : σ₁ ≫ f₁ = 𝟙 (weilProjectiveSpaceOver k m))
    (hEquidim : ∀ (K' : Type u) [Field K'] [IsAlgClosed K']
        (s' : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ (weilProjectiveSpaceOver k m).left),
      ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₁.left s'),
        topologicalKrullDim ↥E = (1 : WithBot ℕ∞))
    (hAlgDom : ∀ (E : Type u) [Field E] [Algebra k E]
        (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C],
      IsDomain (TensorProduct k C E) ∧
      ringKrullDim (TensorProduct k C E) = ringKrullDim C)
    (hMinPrimeDim : ∀ (L : Type u) [Field L]
        (C_L : Type u) [CommRing C_L] [IsDomain C_L] [Algebra L C_L] [Algebra.FiniteType L C_L],
      ringKrullDim C_L = ((m + 1 : ℕ) : WithBot ℕ∞) →
      ∀ (S : Finset C_L), S.card ≤ m - 1 →
      ∀ P ∈ (Ideal.span (S : Set C_L)).minimalPrimes,
        ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (C_L ⧸ P))
    (hProjBC : ∀ (L : Type u) [Field L] [Algebra k L],
      IsProjectiveOverField L (weilBaseChangeOver k L V₁))
    (K : Type u) [Field K] [IsAlgClosed K]
    (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left) :
    ∃ (L : Type u) (_ : Field L) (_ : Infinite L)
      (R : Type u) (_ : CommRing R) (_ : IsDomain R)
      (_ : IsPrincipalIdealRing R) (_ : IsLocalRing R) (_ : Algebra L R)
      (ϖ : R) (N : ℕ)
      (Y_R : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y_R)
      (p_R : Y_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (_ : AlgebraicGeometry.IsProper p_R) (_ : AlgebraicGeometry.Surjective p_R)
      (σ_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y_R)
      (gProj : Y_R ⟶ (weilProjectiveSpaceOver L N).left)
      (hComm : gProj ≫ (weilProjectiveSpaceOver L N).hom =
        p_R ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L R)))
      (π_fib :
        ↥(CategoryTheory.Limits.pullback p_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) →
        ↥(CategoryTheory.Limits.pullback f₁.left s)),
      ϖ ≠ 0 ∧
      IsLocalRing.maximalIdeal R = Ideal.span {ϖ} ∧
      Function.Bijective ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap L R)) ∧
      (σ_R ≫ p_R = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R))) ∧
      AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.lift gProj p_R hComm) ∧
      topologicalKrullDim
        ↥(CategoryTheory.Limits.pullback p_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) ≤
        (1 : WithBot ℕ∞) ∧
      Function.Surjective π_fib ∧
      Continuous π_fib :=
by
  obtain ⟨hSepB₀, ι_aff, hOpen_ι, ψ_s, hι_hom, hs_fac⟩ :=
    weil_projSpace_standard_affine_chart_and_isSeparated k m K s
  have : AlgebraicGeometry.IsOpenImmersion ι_aff := hOpen_ι
  obtain ⟨L, hFieldL, hInfL, hAlgkK, hAlgkL, hAlgKL, hTowerkKL,
      R, hCommR, hDomR, hPIR_R, hLocR,
      hAlgkR, hAlgKR, hAlgLR, hTowerkLR, hTowerKLR, hAlgA₀R, hTowerkA₀R,
      ϖ, _hψ_k, hϖ_ne, hMax, hRes, hMod_ϖ, hAlgDVR⟩ :=
    weil_algClosed_generic_slope_dvr_algebra_package k m hm hAlgDom hMinPrimeDim K ψ_s
  let : Field L := hFieldL
  have : Infinite L := hInfL
  let : Algebra k K := hAlgkK
  let : Algebra k L := hAlgkL
  let : Algebra K L := hAlgKL
  have : IsScalarTower k K L := hTowerkKL
  let : CommRing R := hCommR
  have : IsDomain R := hDomR
  have : IsPrincipalIdealRing R := hPIR_R
  have : IsLocalRing R := hLocR
  let : Algebra k R := hAlgkR
  let : Algebra K R := hAlgKR
  let : Algebra L R := hAlgLR
  have : IsScalarTower k L R := hTowerkLR
  have : IsScalarTower K L R := hTowerKLR
  let : Algebra (MvPolynomial (Fin m) k) R := hAlgA₀R
  have : IsScalarTower k (MvPolynomial (Fin m) k) R := hTowerkA₀R
  have hCharts :=
    weil_integral_projective_open_chart_domain_krullDim k m V₁ hIntV₁ hProjV₁ hDimV₁
      f₁ hSurj ι_aff hι_hom
  have hMaxI : (Ideal.span ({ϖ} : Set R)).IsMaximal := by
    rw [← hMax]
    exact IsLocalRing.maximalIdeal.isMaximal R
  let : Field (R ⧸ Ideal.span ({ϖ} : Set R)) :=
    Ideal.Quotient.field (Ideal.span ({ϖ} : Set R))
  let q₀ : R →+* (R ⧸ Ideal.span ({ϖ} : Set R)) :=
    Ideal.Quotient.mk (Ideal.span ({ϖ} : Set R))
  let ι₀ : AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ Ideal.span ({ϖ} : Set R))) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom q₀)
  let γ_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ (weilProjectiveSpaceOver k m).left :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin m) k) R)) ≫ ι_aff
  have hAlgKL₀ : algebraMap K (R ⧸ Ideal.span ({ϖ} : Set R)) = q₀.comp (algebraMap K R) := by
    rw [IsScalarTower.algebraMap_eq K R (R ⧸ Ideal.span ({ϖ} : Set R))]
    rfl
  have hBaseEq :
      ι₀ ≫ γ_R =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap K (R ⧸ Ideal.span ({ϖ} : Set R)))) ≫ s := by
    dsimp only [ι₀, γ_R]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hMod_ϖ, ← hAlgKL₀,
      CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc, hs_fac]
  have hPB₀ :
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd f₁.left γ_R) ι₀ ≫
          CategoryTheory.Limits.pullback.fst f₁.left γ_R)
        (CategoryTheory.Limits.pullback.snd
          (CategoryTheory.Limits.pullback.snd f₁.left γ_R) ι₀)
        f₁.left
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap K (R ⧸ Ideal.span ({ϖ} : Set R)))) ≫ s) := by
    have hP :=
      (CategoryTheory.IsPullback.of_hasPullback
        (CategoryTheory.Limits.pullback.snd f₁.left γ_R) ι₀).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f₁.left γ_R)
    rwa [hBaseEq] at hP
  let e_W₀ := hPB₀.isoPullback
  obtain ⟨hDim_FL₀, q_fib, hSurj_q⟩ :=
    weil_equidim_curve_baseChange_krullDim_le_one_and_surj k m V₁ f₁ hEquidim K s
      (R ⧸ Ideal.span ({ϖ} : Set R))
  have : AlgebraicGeometry.Surjective q_fib := hSurj_q
  have hDimW₀ :
      topologicalKrullDim
        ↥(CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd f₁.left γ_R) ι₀) ≤
        (1 : WithBot ℕ∞) := by
    rw [(AlgebraicGeometry.Scheme.homeoOfIso e_W₀).isHomeomorph.topologicalKrullDim_eq]
    exact hDim_FL₀
  obtain ⟨N, Y_R, hIntY_R, p_R, hProp_pR, hSurj_pR, σ_R, gProj, hComm, φ₀,
      hSec_R, hClosed, hCl_φ₀, hSurj_φ₀⟩ :=
    weil_dvr_schematic_image_closure_and_proj_immersion k m V₁ hIntV₁ f₁ hProp σ₁ hSec
      hSepB₀ hProjBC ι_aff hι_hom L R ϖ hCharts hAlgDVR hDimW₀
  have : AlgebraicGeometry.IsClosedImmersion φ₀ := hCl_φ₀
  have : AlgebraicGeometry.Surjective φ₀ := hSurj_φ₀
  let π_hom :
      CategoryTheory.Limits.pullback p_R ι₀ ⟶ CategoryTheory.Limits.pullback f₁.left s :=
    φ₀ ≫ e_W₀.hom ≫ q_fib
  have hSurj_π : Function.Surjective (π_hom.base) :=
    AlgebraicGeometry.Scheme.Hom.surjective π_hom
  have hCont_π : Continuous (π_hom.base) :=
    π_hom.continuous
  have hDimY₀ :
      topologicalKrullDim ↥(CategoryTheory.Limits.pullback p_R ι₀) ≤ (1 : WithBot ℕ∞) := by
    rw [φ₀.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq]
    exact (topologicalKrullDim_subspace_le _ _).trans hDimW₀
  exact ⟨L, hFieldL, hInfL, R, hCommR, hDomR, hPIR_R, hLocR, hAlgLR,
    ϖ, N, Y_R, hIntY_R, p_R, hProp_pR, hSurj_pR, σ_R, gProj, hComm,
    π_hom.base, hϖ_ne, hMax, hRes, hSec_R, hClosed, hDimY₀, hSurj_π, hCont_π⟩

theorem weil_algClosed_proper_curve_connected_fibers_of_section (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (U₀ : (weilProjectiveSpaceOver k m).left.Opens) (hU₀ : Nonempty U₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hProjV₁ : IsProjectiveOverField k V₁)
    (hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (f₁ : V₁ ⟶ weilProjectiveSpaceOver k m)
    (hProp : AlgebraicGeometry.IsProper f₁.left)
    (hSurj : AlgebraicGeometry.Surjective f₁.left)
    (hSmU₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U₀))
    (σ₁ : weilProjectiveSpaceOver k m ⟶ V₁)
    (hSec : σ₁ ≫ f₁ = 𝟙 (weilProjectiveSpaceOver k m))
    (hEquidim : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left),
      ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₁.left s),
        topologicalKrullDim ↥E = (1 : WithBot ℕ∞)) :
    ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback f₁.left s) :=
by
  intro K _ _ s
  obtain ⟨hAlgDom, hMinPrimeAll⟩ :=
    weil_algClosed_domain_tensor_and_minimalPrime_krullDim_ge_two k
  have hProjBC : ∀ (L : Type u) [Field L] [Algebra k L],
      IsProjectiveOverField L (weilBaseChangeOver k L V₁) :=
    fun L _ _ => weil_isProjectiveOverField_baseChange k L V₁ hProjV₁
  obtain ⟨L, _, _, R, _, _, _, _, _, ϖ, N, Y_R, _, p_R, _, _,
      σ_R, gProj, hComm, π_fib,
      hϖ_ne, hMax, hRes, hSecR, hClosed, hDim0, hSurjFib, hContFib⟩ :=
    weil_algClosed_pencil_generic_slope_dvr_reduction k m hm
      V₁ hIntV₁ hProjV₁ hDimV₁ f₁ hProp hSurj σ₁ hSec hEquidim
      hAlgDom (hMinPrimeAll m hm) hProjBC K s
  have hGlob : Function.Bijective (p_R.appTop).hom :=
    weil_integral_proper_section_appTop_bijective R Y_R p_R σ_R hSecR
  have : ConnectedSpace
      ↥(CategoryTheory.Limits.pullback p_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) :=
    weil_dvr_projective_curve_connected_special_fiber L R ϖ hϖ_ne hMax hRes
      N Y_R p_R hGlob gProj hComm hClosed hDim0
  exact hSurjFib.connectedSpace hContFib

theorem weil_algClosed_linear_pencil_curve_fibration (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV : AlgebraicGeometry.IsIntegral V.left)
    (hProjV : IsProjectiveOverField k V)
    (hDimV : topologicalKrullDim V.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (U_V : V.left.Opens) (hUV : Nonempty U_V) :
    ∃ (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₀ : B₀.left.Opens)
      (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f₁ : V₁ ⟶ B₀)
      (Z₁ : AlgebraicGeometry.Scheme.{u})
      (ιZ₁ : Z₁ ⟶ V₁.left)
      (α₁ : V₁ ⟶ V),
      AlgebraicGeometry.IsIntegral B₀.left ∧
      IsProjectiveOverField k B₀ ∧
      topologicalKrullDim B₀.left = (m : WithBot ℕ∞) ∧
      Nonempty U₀ ∧
      AlgebraicGeometry.IsIntegral V₁.left ∧
      IsProjectiveOverField k V₁ ∧
      topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞) ∧
      IsEquidimGenSmoothCurveFibOver k f₁ U₀ ∧
      AlgebraicGeometry.IsClosedImmersion ιZ₁ ∧
      AlgebraicGeometry.IsReduced Z₁ ∧
      AlgebraicGeometry.IsFinite (ιZ₁ ≫ f₁.left) ∧
      AlgebraicGeometry.Etale ((ιZ₁ ≫ f₁.left) ∣_ U₀) ∧
      IsGenFiniteEtaleAlterationOver k α₁ ∧
      α₁.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
        f₁.left.base ⁻¹' ((U₀ : Set B₀.left)ᶜ) ∪ Set.range ιZ₁.base :=
by
  have hFT_of_proj :
      ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        IsProjectiveOverField k Y → AlgebraicGeometry.LocallyOfFiniteType Y.hom := by
    intro Y ⟨N, ι, hClosed⟩
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  have hIsIsoRestrictLE :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (U W : Y.Opens),
        W ≤ U → CategoryTheory.IsIso (f ∣_ U) → CategoryTheory.IsIso (f ∣_ W) := by
    intro X Y f U W hWU hIsoU
    have : CategoryTheory.IsIso (f ∣_ U) := hIsoU
    have hPW : CategoryTheory.IsPullback (f ∣_ W) ((f ⁻¹ᵁ W).ι) W.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f W
    have hPU : CategoryTheory.IsPullback (f ∣_ U) ((f ⁻¹ᵁ U).ι) U.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f U
    have hPre : f ⁻¹ᵁ W ≤ f ⁻¹ᵁ U := fun _ hx => hWU hx
    have hcomm : (f ∣_ W) ≫ Y.homOfLE hWU = X.homOfLE hPre ≫ (f ∣_ U) := by
      rw [← CategoryTheory.cancel_mono U.ι]
      simp [AlgebraicGeometry.morphismRestrict_ι]
    have hTop : CategoryTheory.IsPullback (f ∣_ W) (X.homOfLE hPre) (Y.homOfLE hWU) (f ∣_ U) :=
      CategoryTheory.IsPullback.of_bot (by simpa using hPW) hcomm hPU
    exact hTop.isIso_fst_of_isIso

  let B₀ := weilProjectiveSpaceOver k m
  obtain ⟨hIntB₀, hProjB₀, hDimB₀, hIsoB₀⟩ :=
    weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k m
  obtain ⟨V_norm, ν, U_ν, W_reg, hIntVn, hProjVn, hPropν, hSurjν, hUν, hIsoν, hSmWreg, hDimSing⟩ :=
    weil_algClosed_projective_normalization_codim2_smooth k m V hIntV hProjV hDimV

  have : AlgebraicGeometry.LocallyOfFiniteType V.hom := hFT_of_proj V hProjV
  have : CategoryTheory.IsIso (ν.left ∣_ U_ν) := hIsoν
  have hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
    (weil_birational_iso_on_open_krullDim_eq k V_norm V hIntVn hProjVn hIntV ν U_ν hUν).trans hDimV

  let Z_closed : Set V_norm.left := ν.left.base ⁻¹' ((U_V : Set V.left)ᶜ)
  have hClosedZ : IsClosed Z_closed :=
    (ν.left ⁻¹ᵁ U_V).isOpen.isClosed_compl
  have hProperZ : Z_closed ≠ Set.univ := by
    obtain ⟨⟨y₀, hy₀⟩⟩ := hUV
    obtain ⟨x₀, hx₀⟩ := hSurjν.surj y₀
    intro hUniv
    have hx₀Z : x₀ ∈ Z_closed := hUniv ▸ Set.mem_univ x₀
    exact hx₀Z (by simpa [hx₀] using hy₀)

  rcases Nat.eq_zero_or_pos m with rfl | hm
  · have : CategoryTheory.IsIso B₀.hom := hIsoB₀ rfl
    have hWregTop : W_reg = ⊤ := by
      ext z
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      by_contra hz
      let S : Set V_norm.left := (W_reg : Set V_norm.left)ᶜ
      let z' : ↥S := ⟨z, hz⟩
      let c₀ : TopologicalSpace.IrreducibleCloseds ↥S :=
        ⟨closure ({z'} : Set ↥S), isIrreducible_singleton.closure, isClosed_closure⟩
      have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥S) := ⟨c₀⟩
      have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥S := Order.krullDim_nonneg
      have h2 : (0 : WithBot ℕ∞) + 2 ≤ ((0 + 1 : ℕ) : WithBot ℕ∞) :=
        (add_le_add h0 le_rfl).trans hDimSing
      norm_num at h2
    have hSmVn : AlgebraicGeometry.SmoothOfRelativeDimension 1 V_norm.hom := by
      rw [hWregTop] at hSmWreg
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1
          ((⊤ : V_norm.left.Opens).ι ≫ V_norm.hom) := hSmWreg
      have : AlgebraicGeometry.SmoothOfRelativeDimension 0 V_norm.left.topIso.inv := inferInstance
      have h1 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          (V_norm.left.topIso.inv ≫ ((⊤ : V_norm.left.Opens).ι ≫ V_norm.hom)) := inferInstance
      have heq : V_norm.left.topIso.inv ≫ ((⊤ : V_norm.left.Opens).ι ≫ V_norm.hom) = V_norm.hom := by
        change V_norm.left.topIso.inv ≫ V_norm.left.topIso.hom ≫ V_norm.hom = V_norm.hom
        exact CategoryTheory.Iso.inv_hom_id_assoc V_norm.left.topIso V_norm.hom
      rwa [Nat.zero_add, heq] at h1
    have : IrreducibleSpace ↥B₀.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral B₀.left
    obtain ⟨b₀⟩ : Nonempty ↥B₀.left := IrreducibleSpace.toNonempty
    have hU₀ : Nonempty (⊤ : B₀.left.Opens) := ⟨⟨b₀, trivial⟩⟩
    let f₁ : V_norm ⟶ B₀ :=
      CategoryTheory.Over.homMk (V_norm.hom ≫ CategoryTheory.inv B₀.hom) (by simp)
    obtain ⟨hFib₁, Z₁, ιZ₁, hClZ₁, hRedZ₁, hFinZ₁, hEtZ₁, hSubZ₁⟩ :=
      weil_algClosed_dim_one_curve_fibration_m_zero k V_norm B₀
        hIntVn hProjVn hDimVn hSmVn f₁ Z_closed hClosedZ hProperZ
    have hAltν : IsGenFiniteEtaleAlterationOver k ν :=
      ⟨hPropν, hSurjν, U_ν, hUν, inferInstance, inferInstance, inferInstance⟩
    refine ⟨B₀, ⊤, V_norm, f₁, Z₁, ιZ₁, ν,
      hIntB₀, hProjB₀, hDimB₀, hU₀, hIntVn, hProjVn, hDimVn,
      hFib₁, hClZ₁, hRedZ₁, hFinZ₁, hEtZ₁, hAltν, ?_⟩
    exact hSubZ₁.trans Set.subset_union_right
  · obtain ⟨U₀, V₁, f₁, σ₁, Z₁, ιZ₁, φ₁, U_φ₁,
        hU₀, hIntV₁, hProjV₁, hPropφ₁, hSurjφ₁, hUφ₁, hIsoφ₁,
        hPropf₁, hSurjf₁, hSmf₁U₀, hSec₁, hFibComp₁,
        hClZ₁, hRedZ₁, hFinZ₁, hEtZ₁, hBdryφ₁⟩ :=
      weil_algClosed_adapted_pencil_blowup_section k m hm V_norm
        hIntVn hProjVn hDimVn W_reg hSmWreg hDimSing Z_closed hClosedZ hProperZ
    have : AlgebraicGeometry.LocallyOfFiniteType V_norm.hom := hFT_of_proj V_norm hProjVn
    have : CategoryTheory.IsIso (φ₁.left ∣_ U_φ₁) := hIsoφ₁
    have hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
      (weil_birational_iso_on_open_krullDim_eq k V₁ V_norm
        hIntV₁ hProjV₁ hIntVn φ₁ U_φ₁ hUφ₁).trans hDimVn
    have hConn₁ :=
      weil_algClosed_proper_curve_connected_fibers_of_section k m hm U₀ hU₀
        V₁ hIntV₁ hProjV₁ hDimV₁ f₁ hPropf₁ hSurjf₁ hSmf₁U₀ σ₁ hSec₁
        (fun K _ _ s E hE => (hFibComp₁ K s E hE).1)
    have hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀ :=
      ⟨hPropf₁, hSurjf₁, hSmf₁U₀, fun K _ _ s => ⟨hConn₁ K s, hFibComp₁ K s⟩⟩

    have : AlgebraicGeometry.IsProper ν.left := hPropν
    have : AlgebraicGeometry.IsProper φ₁.left := hPropφ₁
    have : AlgebraicGeometry.Surjective ν.left := hSurjν
    have : AlgebraicGeometry.Surjective φ₁.left := hSurjφ₁
    let K₁ : Set V.left := ν.left.base '' ((U_φ₁ : Set V_norm.left)ᶜ)
    have hClosedK₁ : IsClosed K₁ :=
      AlgebraicGeometry.Scheme.Hom.isClosedMap ν.left _ U_φ₁.isOpen.isClosed_compl
    let U_α₁ : V.left.Opens := U_ν ⊓ ⟨K₁ᶜ, hClosedK₁.isOpen_compl⟩
    have hUα₁_le_ν : U_α₁ ≤ U_ν := inf_le_left
    have hPreUα₁_le_φ₁ : ν.left ⁻¹ᵁ U_α₁ ≤ U_φ₁ := by
      intro z hz
      by_contra hzNot
      exact hz.2 ⟨z, hzNot, rfl⟩
    have hNonemptyUα₁ : Nonempty U_α₁ := by
      let W_ν : V_norm.left.Opens := ν.left ⁻¹ᵁ U_ν
      obtain ⟨⟨y₀, hy₀⟩⟩ := hUν
      obtain ⟨z₁, hz₁⟩ := hSurjν.surj y₀
      have hz₁W : z₁ ∈ W_ν := by
        change ν.left.base z₁ ∈ U_ν
        rwa [hz₁]
      obtain ⟨⟨z₂, hz₂⟩⟩ := hUφ₁
      have : IrreducibleSpace ↥V_norm.left :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral V_norm.left
      obtain ⟨z₀, _, hz₀W, hz₀φ⟩ :=
        PreirreducibleSpace.isPreirreducible_univ W_ν.1 U_φ₁.1 W_ν.isOpen U_φ₁.isOpen
          ⟨z₁, trivial, hz₁W⟩ ⟨z₂, trivial, hz₂⟩
      refine ⟨⟨ν.left.base z₀, hz₀W, ?_⟩⟩
      rintro ⟨z', hz'Not, hEqBase⟩
      have hz'W : ν.left.base z' ∈ U_ν := by
        rw [hEqBase]
        exact hz₀W
      obtain ⟨a₀, ha₀⟩ : z₀ ∈ Set.range W_ν.ι.base := by
        rw [W_ν.range_ι]
        exact hz₀W
      obtain ⟨a', ha'⟩ : z' ∈ Set.range W_ν.ι.base := by
        rw [W_ν.range_ι]
        exact hz'W
      have hcomm := AlgebraicGeometry.morphismRestrict_ι ν.left U_ν
      have h1 : ((ν.left ∣_ U_ν) ≫ U_ν.ι).base a₀ = ((ν.left ∣_ U_ν) ≫ U_ν.ι).base a' := by
        rw [hcomm]
        change ν.left.base (W_ν.ι.base a₀) = ν.left.base (W_ν.ι.base a')
        rw [ha₀, ha', hEqBase]
      have h2 : (ν.left ∣_ U_ν).base a₀ = (ν.left ∣_ U_ν).base a' :=
        U_ν.ι.isOpenEmbedding.injective h1
      have h3 : a₀ = a' := by
        have hInv := congrArg (CategoryTheory.inv (ν.left ∣_ U_ν)).base h2
        change ((ν.left ∣_ U_ν) ≫ CategoryTheory.inv (ν.left ∣_ U_ν)).base a₀ =
          ((ν.left ∣_ U_ν) ≫ CategoryTheory.inv (ν.left ∣_ U_ν)).base a' at hInv
        simpa using hInv
      have hzEq : z₀ = z' := by
        rw [← ha₀, ← ha', h3]
      exact hz'Not (hzEq ▸ hz₀φ)
    have hIsoνUα₁ : CategoryTheory.IsIso (ν.left ∣_ U_α₁) :=
      hIsIsoRestrictLE ν.left U_ν U_α₁ hUα₁_le_ν hIsoν
    have hIsoφ₁Uα₁ : CategoryTheory.IsIso (φ₁.left ∣_ (ν.left ⁻¹ᵁ U_α₁)) :=
      hIsIsoRestrictLE φ₁.left U_φ₁ (ν.left ⁻¹ᵁ U_α₁) hPreUα₁_le_φ₁ hIsoφ₁
    let α₁ : V₁ ⟶ V := φ₁ ≫ ν
    have : CategoryTheory.IsIso (α₁.left ∣_ U_α₁) := by
      change CategoryTheory.IsIso ((φ₁.left ≫ ν.left) ∣_ U_α₁)
      rw [AlgebraicGeometry.morphismRestrict_comp]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIsoφ₁Uα₁ hIsoνUα₁
    have hAltα₁ : IsGenFiniteEtaleAlterationOver k α₁ := by
      refine ⟨?_, ?_, U_α₁, hNonemptyUα₁, inferInstance, inferInstance, inferInstance⟩
      · change AlgebraicGeometry.IsProper (φ₁.left ≫ ν.left)
        infer_instance
      · change AlgebraicGeometry.Surjective (φ₁.left ≫ ν.left)
        infer_instance
    refine ⟨B₀, U₀, V₁, f₁, Z₁, ιZ₁, α₁,
      hIntB₀, hProjB₀, hDimB₀, hU₀, hIntV₁, hProjV₁, hDimV₁,
      hFib₁, hClZ₁, hRedZ₁, hFinZ₁, hEtZ₁, hAltα₁, ?_⟩
    exact hBdryφ₁

theorem weil_projective_cartier_hypersurface_pullback (k : Type u) [Field k]
    (M₀ d₀ : ℕ) (hd₀ : 1 ≤ d₀)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ιX : X ⟶ weilProjectiveSpaceOver k M₀)
    (F : MvPolynomial (Fin (M₀ + 1)) k)
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k d₀) :
    ∃ (H : AlgebraicGeometry.Scheme.{u}) (ιH : H ⟶ X.left),
      IsHomogeneousHypersurfacePullbackOver k M₀ d₀ ιX F ιH :=
by
  let _ := hd₀
  let A := MvPolynomial (Fin (M₀ + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k
  let _inst𝒜 : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hF' : F ∈ 𝒜 (d₀ • (1 : ℕ)) := (@nsmul_one ℕ _ d₀).symm ▸ hF
  let hX₀ : ∀ μ : Fin (M₀ + 1), MvPolynomial.X μ ∈ 𝒜 1 :=
    fun μ => MvPolynomial.isHomogeneous_X k μ
  let U_P : Fin (M₀ + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
    fun μ => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)
  let z_P : ∀ μ : Fin (M₀ + 1), HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ) :=
    fun μ => HomogeneousLocalization.Away.mk 𝒜 (hX₀ μ) d₀ F hF'
  let s_P : ∀ μ : Fin (M₀ + 1),
      ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (U_P μ))) :=
    fun μ => (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)).hom (z_P μ)
  let S : AlgebraicGeometry.Scheme.{u} := X.left
  let ι : S ⟶ AlgebraicGeometry.Proj 𝒜 := ιX.left
  let V : Fin (M₀ + 1) → S.Opens :=
    fun μ => (TopologicalSpace.Opens.map ι.base).obj (U_P μ)
  let t : ∀ μ : Fin (M₀ + 1), ↑(S.presheaf.obj (Opposite.op (V μ))) :=
    fun μ => (ι.app (U_P μ)).hom (s_P μ)
  let W_F : S.Opens :=
    (TopologicalSpace.Opens.map ι.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜 F)
  
  have hU_cov : (⨆ μ : Fin (M₀ + 1), U_P μ) = ⊤ := by
    have h_adjoin : Algebra.adjoin (↥(𝒜 0))
        (Set.range (MvPolynomial.X : Fin (M₀ + 1) → A)) = ⊤ := by
      rw [eq_top_iff]
      have h_all : ∀ p : A, p ∈ Algebra.adjoin (↥(𝒜 0))
          (Set.range (MvPolynomial.X : Fin (M₀ + 1) → A)) := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a =>
          let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
          exact (Algebra.adjoin (↥(𝒜 0))
            (Set.range (MvPolynomial.X : Fin (M₀ + 1) → A))).algebraMap_mem c₀
        | add p q hp hq =>
          exact add_mem hp hq
        | mul_X p i hp =>
          exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
      intro p _
      exact h_all p
    exact AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X
      (fun i => ⟨1, hX₀ i⟩) h_adjoin
  have hV_cov : (⨆ μ : Fin (M₀ + 1), V μ) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hxP : ι.base x ∈ (⨆ μ : Fin (M₀ + 1), U_P μ) := by
      rw [hU_cov]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hxP ⊢
    obtain ⟨μ, hμ⟩ := hxP
    exact ⟨μ, hμ⟩
  
  have hDiv : ∀ μ ν : Fin (M₀ + 1),
      ∃ w : ↑(S.presheaf.obj (Opposite.op (V μ ⊓ V ν))),
        (S.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t μ) =
          w * (S.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (t ν) := by
    intro μ ν
    have h_mul : AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ * MvPolynomial.X ν) =
        U_P μ ⊓ U_P ν :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X μ) (MvPolynomial.X ν)
    let φ_μν : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ * MvPolynomial.X ν) →+*
        ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (U_P μ ⊓ U_P ν))) :=
      (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ * MvPolynomial.X ν) ≫
        (AlgebraicGeometry.Proj 𝒜).presheaf.map (eqToHom h_mul.symm).op).hom
    have h_left_P :
        ((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
          (s_P μ) =
          φ_μν (HomogeneousLocalization.awayMap 𝒜 (hX₀ ν)
            (rfl : MvPolynomial.X μ * MvPolynomial.X ν = MvPolynomial.X μ * MvPolynomial.X ν)
            (z_P μ)) := by
      have h_comp :
          AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ) ≫
            (AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_left).op =
          CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hX₀ ν) rfl) ≫
            (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ * MvPolynomial.X ν) ≫
              (AlgebraicGeometry.Proj 𝒜).presheaf.map (eqToHom h_mul.symm).op) := by
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX₀ ν) rfl,
          CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
        congr 2
      exact congrArg (fun k => k.hom (z_P μ)) h_comp
    have h_comm : (MvPolynomial.X μ : A) * MvPolynomial.X ν = MvPolynomial.X ν * MvPolynomial.X μ :=
      mul_comm _ _
    have h_right_P :
        ((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
          (s_P ν) =
          φ_μν (HomogeneousLocalization.awayMap 𝒜 (hX₀ μ) h_comm (z_P ν)) := by
      have h_comp :
          AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X ν) ≫
            (AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_right).op =
          CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hX₀ μ) h_comm) ≫
            (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ * MvPolynomial.X ν) ≫
              (AlgebraicGeometry.Proj 𝒜).presheaf.map (eqToHom h_mul.symm).op) := by
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜 (hX₀ μ) h_comm,
          CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
        congr 2
      exact congrArg (fun k => k.hom (z_P ν)) h_comp
    have h_μν : MvPolynomial.X μ * MvPolynomial.X ν ∈ 𝒜 2 :=
      SetLike.mul_mem_graded (hX₀ μ) (hX₀ ν)
    have h_ν_pow : (MvPolynomial.X ν : A) ^ (2 * d₀) ∈ 𝒜 (d₀ • 2) := by
      have h_deg : (2 * d₀) • (1 : ℕ) = d₀ • (2 : ℕ) := by
        simp [mul_comm]
      exact h_deg ▸ SetLike.pow_mem_graded (2 * d₀) (hX₀ ν)
    let w₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ * MvPolynomial.X ν) :=
      HomogeneousLocalization.Away.mk 𝒜 h_μν d₀ ((MvPolynomial.X ν : A) ^ (2 * d₀)) h_ν_pow
    have h_away_eq :
        HomogeneousLocalization.awayMap 𝒜 (hX₀ ν) rfl (z_P μ) =
          w₀ * HomogeneousLocalization.awayMap 𝒜 (hX₀ μ) h_comm (z_P ν) := by
      rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul]
      have hw₀_val :=
        HomogeneousLocalization.Away.val_mk 𝒜 d₀ h_μν ((MvPolynomial.X ν : A) ^ (2 * d₀)) h_ν_pow
      rw [hw₀_val]
      dsimp [z_P, HomogeneousLocalization.Away.mk]
      rw [HomogeneousLocalization.val_awayMap_mk, HomogeneousLocalization.val_awayMap_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨⟨1, Submonoid.one_mem _⟩, ?_⟩
      dsimp
      rw [mul_pow, two_mul, pow_add]
      ring
    have h_sec_P :
        ((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
          (s_P μ) =
        φ_μν w₀ *
          ((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
            (s_P ν) := by
      rw [h_left_P, h_right_P, h_away_eq, map_mul]
    refine ⟨(ι.app (U_P μ ⊓ U_P ν)).hom (φ_μν w₀), ?_⟩
    have h_nat_l :
        ι.app (U_P μ) ≫ S.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V μ ⊓ V ν ≤ V μ)).op =
        (AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫
          ι.app (U_P μ ⊓ U_P ν) := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.map_appLE]
      rfl
    have h_nat_r :
        ι.app (U_P ν) ≫ S.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V μ ⊓ V ν ≤ V ν)).op =
        (AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫
          ι.app (U_P μ ⊓ U_P ν) := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.map_appLE]
      rfl
    have hl : (S.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V μ ⊓ V ν ≤ V μ)).op).hom (t μ) =
        (ι.app (U_P μ ⊓ U_P ν)).hom
          (((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (s_P μ)) :=
      congrArg (fun k => k.hom (s_P μ)) h_nat_l
    have hr : (S.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V μ ⊓ V ν ≤ V ν)).op).hom (t ν) =
        (ι.app (U_P μ ⊓ U_P ν)).hom
          (((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (s_P ν)) :=
      congrArg (fun k => k.hom (s_P ν)) h_nat_r
    rw [hl, hr, h_sec_P, map_mul]
    rfl
  
  have hBasic_P : ∀ μ : Fin (M₀ + 1),
      (AlgebraicGeometry.Proj 𝒜).basicOpen (s_P μ) =
        U_P μ ⊓ AlgebraicGeometry.Proj.basicOpen 𝒜 F := by
    intro μ
    apply TopologicalSpace.Opens.ext
    ext p
    simp only [SetLike.mem_coe]
    let p₀ : ProjectiveSpectrum 𝒜 := p
    have h_pow_notMem : ∀ {x : A}, x ∉ p₀.asHomogeneousIdeal.toIdeal →
        ∀ n : ℕ, x ^ n ∉ p₀.asHomogeneousIdeal.toIdeal := by
      intro x hx n
      induction n with
      | zero =>
        rw [pow_zero]
        exact fun h1 => p₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      | succ n ih =>
        rw [pow_succ]
        exact fun hmul => (p₀.isPrime.mem_or_mem hmul).elim ih hx
    by_cases hp : p ∈ U_P μ
    · have hXμ_notMem : MvPolynomial.X μ ∉ p₀.asHomogeneousIdeal.toIdeal :=
        (ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X μ) p₀).mp hp
      have h_sub : Submonoid.powers (MvPolynomial.X μ) ≤ p₀.asHomogeneousIdeal.toIdeal.primeCompl := by
        rintro _ ⟨n, rfl⟩
        exact h_pow_notMem hXμ_notMem n
      have h_mem_lhs : p ∈ (AlgebraicGeometry.Proj 𝒜).basicOpen (s_P μ) ↔
          IsUnit (((AlgebraicGeometry.Proj 𝒜).presheaf.germ (U_P μ) p hp).hom (s_P μ)) :=
        AlgebraicGeometry.Scheme.mem_basicOpen (AlgebraicGeometry.Proj 𝒜) (s_P μ) p hp
      let y_p : HomogeneousLocalization.AtPrime 𝒜 p₀.asHomogeneousIdeal.toIdeal :=
        HomogeneousLocalization.mapId 𝒜 h_sub (z_P μ)
      let iso_p := (AlgebraicGeometry.Proj.stalkIso' 𝒜 p).toCommRingCatIso
      have h_germ_eq :
          (((AlgebraicGeometry.Proj 𝒜).presheaf.germ (U_P μ) p hp).hom (s_P μ)) =
            iso_p.inv.hom y_p := by
        have h_comp := AlgebraicGeometry.ProjectiveSpectrum.Proj.awayToSection_germ 𝒜
          (MvPolynomial.X μ) p hp
        exact congrArg (fun φ => φ.hom (z_P μ)) h_comp
      have h_unit_iff : IsUnit (iso_p.inv.hom y_p) ↔ IsUnit y_p := by
        refine ⟨fun hu => ?_, fun hu => RingHom.isUnit_map iso_p.inv.hom hu⟩
        have hu' := RingHom.isUnit_map iso_p.hom.hom hu
        have h_id : iso_p.hom.hom (iso_p.inv.hom y_p) = y_p :=
          congrArg (fun φ => φ.hom y_p) iso_p.inv_hom_id
        rwa [h_id] at hu'
      have hy_val : y_p.val = Localization.mk F ⟨(MvPolynomial.X μ) ^ d₀, h_sub ⟨d₀, rfl⟩⟩ := by
        have h_comap : Submonoid.powers (MvPolynomial.X μ) ≤
            Submonoid.comap (GradedRingHom.id 𝒜) p₀.asHomogeneousIdeal.toIdeal.primeCompl := h_sub
        have hy_eq : y_p = HomogeneousLocalization.map (GradedRingHom.id 𝒜) h_comap
            (HomogeneousLocalization.mk
              ⟨d₀ • (1 : ℕ), ⟨F, hF'⟩,
                ⟨(MvPolynomial.X μ) ^ d₀, SetLike.pow_mem_graded d₀ (hX₀ μ)⟩, ⟨d₀, rfl⟩⟩) := rfl
        rw [hy_eq, HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
        rfl
      have h_yp_iff : IsUnit y_p ↔ p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 F := by
        change IsUnit y_p ↔ p₀ ∈ ProjectiveSpectrum.basicOpen 𝒜 F
        rw [ProjectiveSpectrum.mem_basicOpen]
        refine ⟨fun hu hF_in => ?_, fun hF_out => ?_⟩
        · obtain ⟨u, hu_eq⟩ := hu
          let v : HomogeneousLocalization.AtPrime 𝒜 p₀.asHomogeneousIdeal.toIdeal := ↑u⁻¹
          have hv : y_p * v = 1 := by
            rw [← hu_eq]
            exact Units.mul_inv u
          have hv_val := congrArg HomogeneousLocalization.val hv
          rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one, hy_val] at hv_val
          induction hv_ind : v.val using Localization.induction_on with
          | H data =>
            rw [hv_ind, Localization.mk_mul, ← Localization.mk_one,
              Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hv_val
            obtain ⟨c, hc⟩ := hv_val
            dsimp at hc
            have h_lhs_mem : ↑c * (1 * (F * data.1)) ∈ p₀.asHomogeneousIdeal.toIdeal := by
              have h_eq : ↑c * (1 * (F * data.1)) = (↑c * data.1) * F := by ring
              rw [h_eq]
              exact p₀.asHomogeneousIdeal.toIdeal.mul_mem_left _ hF_in
            rw [hc] at h_lhs_mem
            have h_rhs_notMem :
                ↑c * (((MvPolynomial.X μ) ^ d₀ * ↑data.2) * 1) ∉ p₀.asHomogeneousIdeal.toIdeal := by
              rw [mul_one]
              exact p₀.isPrime.mul_notMem c.2
                (p₀.isPrime.mul_notMem (h_pow_notMem hXμ_notMem d₀) data.2.2)
            exact h_rhs_notMem h_lhs_mem
        · have hX_pow : (MvPolynomial.X μ : A) ^ d₀ ∈ 𝒜 (d₀ • (1 : ℕ)) :=
            SetLike.pow_mem_graded d₀ (hX₀ μ)
          let u_inv : HomogeneousLocalization.AtPrime 𝒜 p₀.asHomogeneousIdeal.toIdeal :=
            HomogeneousLocalization.mk ⟨d₀ • (1 : ℕ), ⟨(MvPolynomial.X μ) ^ d₀, hX_pow⟩, ⟨F, hF'⟩, hF_out⟩
          refine IsUnit.of_mul_eq_one u_inv ?_
          rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul,
            HomogeneousLocalization.val_one, hy_val, HomogeneousLocalization.val_mk,
            Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff,
            Localization.r_iff_exists]
          refine ⟨⟨1, Submonoid.one_mem _⟩, ?_⟩
          dsimp
          ring
      exact h_mem_lhs.trans
        ((by rw [h_germ_eq]; rfl : IsUnit _ ↔ IsUnit (iso_p.inv.hom y_p)).trans
          (h_unit_iff.trans (h_yp_iff.trans ⟨fun h => ⟨hp, h⟩, fun h => h.2⟩)))
    · refine ⟨fun h => False.elim (hp (AlgebraicGeometry.Scheme.basicOpen_le _ _ h)),
        fun h => False.elim (hp h.1)⟩
  have hBasic_V : ∀ μ : Fin (M₀ + 1), S.basicOpen (t μ) = V μ ⊓ W_F := by
    intro μ
    have h_pre := (AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι (s_P μ)).symm
    change S.basicOpen (t μ) =
      (TopologicalSpace.Opens.map ι.base).obj
        ((AlgebraicGeometry.Proj 𝒜).basicOpen (s_P μ)) at h_pre
    rw [h_pre, hBasic_P μ]
    rfl
  
  have hResComp : ∀ {W₁ W₂ W₃ : S.Opens} (h₁₂ : W₁ ≤ W₂) (h₂₃ : W₂ ≤ W₃)
      (x : ↑(S.presheaf.obj (Opposite.op W₃))),
      (S.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((S.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
        (S.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
    intro W₁ W₂ W₃ h₁₂ h₂₃ x
    have h_map :
        S.presheaf.map (CategoryTheory.homOfLE h₂₃).op ≫
          S.presheaf.map (CategoryTheory.homOfLE h₁₂).op =
        S.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op := by
      rw [← CategoryTheory.Functor.map_comp]
      congr 1
    exact congrArg (fun φ => φ.hom x) h_map
  have hResTrans : ∀ {U₁ U₂ W₁ W₂ : S.Opens} (hW : W₁ = W₂)
      (h₁ : W₁ ≤ U₁) (h₂ : W₂ ≤ U₁) (hW₁ : W₁ ≤ U₂) (hW₂ : W₂ ≤ U₂)
      (x : ↑(S.presheaf.obj (Opposite.op U₁)))
      (y : ↑(S.presheaf.obj (Opposite.op U₂))),
      (S.presheaf.map (CategoryTheory.homOfLE h₁).op).hom x ∈
        Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hW₁).op).hom y} →
      (S.presheaf.map (CategoryTheory.homOfLE h₂).op).hom x ∈
        Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hW₂).op).hom y} := by
    intro U₁ U₂ W₁ W₂ hW h₁ h₂ hW₁ hW₂ x y hmem
    subst hW
    exact hmem
  have hSpan_eq : ∀ (W : S.Opens) (μ ν : Fin (M₀ + 1)) (hWμ : W ≤ V μ) (hWν : W ≤ V ν),
      Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hWμ).op).hom (t μ)} =
        Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hWν).op).hom (t ν)} := by
    have hSpan_le : ∀ (W : S.Opens) (μ ν : Fin (M₀ + 1)) (hWμ : W ≤ V μ) (hWν : W ≤ V ν),
        Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hWμ).op).hom (t μ)} ≤
          Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hWν).op).hom (t ν)} := by
      intro W μ ν hWμ hWν
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_span_singleton]
      obtain ⟨w, hw⟩ := hDiv μ ν
      have hWμν : W ≤ V μ ⊓ V ν := le_inf hWμ hWν
      rw [← hResComp hWμν inf_le_left (t μ), ← hResComp hWμν inf_le_right (t ν), hw, map_mul]
      exact ⟨(S.presheaf.map (CategoryTheory.homOfLE hWμν).op).hom w, mul_comm _ _⟩
    intro W μ ν hWμ hWν
    exact le_antisymm (hSpan_le W μ ν hWμ hWν) (hSpan_le W ν μ hWν hWμ)
  let J_ideal : ∀ U : S.affineOpens, Ideal ↑(S.presheaf.obj (Opposite.op U.1)) := fun U =>
    { carrier := { g | ∀ (μ : Fin (M₀ + 1)) (h : ↑(S.presheaf.obj (Opposite.op U.1)))
        (hh : S.basicOpen h ≤ V μ),
        (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le h)).op).hom g ∈
          Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hh).op).hom (t μ)} }
      zero_mem' := by
        intro μ h hh
        simp
      add_mem' := by
        intro a b ha hb μ h hh
        rw [map_add]
        exact Ideal.add_mem _ (ha μ h hh) (hb μ h hh)
      smul_mem' := by
        intro c a ha μ h hh
        rw [smul_eq_mul, map_mul]
        exact Ideal.mul_mem_left _ _ (ha μ h hh) }
  have hChart : ∀ (U : S.affineOpens) (μ : Fin (M₀ + 1)) (hU : U.1 ≤ V μ),
      J_ideal U = Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hU).op).hom (t μ)} := by
    intro U μ hU
    apply le_antisymm
    · intro g hg
      have h_one : S.basicOpen (1 : ↑(S.presheaf.obj (Opposite.op U.1))) = U.1 :=
        S.basicOpen_of_isUnit isUnit_one
      have hh_one : S.basicOpen (1 : ↑(S.presheaf.obj (Opposite.op U.1))) ≤ V μ :=
        h_one.le.trans hU
      have hg1 := hResTrans h_one
        (S.basicOpen_le (1 : ↑(S.presheaf.obj (Opposite.op U.1)))) (le_refl U.1)
        hh_one hU g (t μ) (hg μ 1 hh_one)
      have h_id : (S.presheaf.map (CategoryTheory.homOfLE (le_refl U.1)).op).hom g = g := by
        have h_op : (CategoryTheory.homOfLE (le_refl U.1)).op = 𝟙 (Opposite.op U.1) :=
          Subsingleton.elim _ _
        rw [h_op, CategoryTheory.Functor.map_id]
        rfl
      rwa [h_id] at hg1
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      intro ν h hh
      have hh_μ : S.basicOpen h ≤ V μ := (S.basicOpen_le h).trans hU
      rw [hResComp (S.basicOpen_le h) hU (t μ),
        hSpan_eq (S.basicOpen h) ν μ hh hh_μ]
      exact Ideal.subset_span (Set.mem_singleton _)
  have hCoverBasic : ∀ U : S.affineOpens,
      ∃ (ι_cov : Type u) (_ : Fintype ι_cov)
        (μ_cov : ι_cov → Fin (M₀ + 1))
        (h_cov : ι_cov → ↑(S.presheaf.obj (Opposite.op U.1))),
        (∀ p : ι_cov, S.basicOpen (h_cov p) ≤ V (μ_cov p)) ∧
        Ideal.span (Set.range h_cov) = ⊤ := by
    intro U
    have h_pt_ex : ∀ x : ↥U.1,
        ∃ (μ : Fin (M₀ + 1)) (h : ↑(S.presheaf.obj (Opposite.op U.1))),
          S.basicOpen h ≤ V μ ∧ x.1 ∈ S.basicOpen h := by
      intro x
      have hx_top : x.1 ∈ (⨆ μ : Fin (M₀ + 1), V μ) := by
        rw [hV_cov]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hx_top
      obtain ⟨μ, hxμ⟩ := hx_top
      obtain ⟨h, hh_le, hxh⟩ := U.2.exists_basicOpen_le (⟨x.1, hxμ⟩ : ↥(V μ)) x.2
      exact ⟨μ, h, hh_le, hxh⟩
    choose μ_x h_x hh_le hxh using h_pt_ex
    have h_sub : (U.1 : Set S) ⊆ ⋃ x : ↥U.1, (S.basicOpen (h_x x) : Set S) := by
      intro y hy
      exact Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hxh ⟨y, hy⟩⟩
    obtain ⟨F_pts, hF_pts⟩ := U.2.isCompact.elim_finite_subcover
      (fun x : ↥U.1 => (S.basicOpen (h_x x) : Set S))
      (fun x => (S.basicOpen (h_x x)).isOpen) h_sub
    refine ⟨↥F_pts, inferInstance, fun p => μ_x p.1, fun p => h_x p.1,
      fun p => hh_le p.1, ?_⟩
    rw [← U.2.iSup_basicOpen_eq_self_iff]
    apply le_antisymm
    · exact iSup_le fun f => S.basicOpen_le f.1
    · intro y hy
      have hyF := hF_pts hy
      rw [Set.mem_iUnion₂] at hyF
      obtain ⟨x, hxF, hyx⟩ := hyF
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨⟨h_x x, ⟨⟨x, hxF⟩, rfl⟩⟩, hyx⟩
  have hLiftPow : ∀ {W : S.Opens} (hW : AlgebraicGeometry.IsAffineOpen W)
      (r x t_W : ↑(S.presheaf.obj (Opposite.op W))),
      (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le r)).op).hom x ∈
        Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le r)).op).hom t_W} →
      ∃ N : ℕ, r ^ N * x ∈ Ideal.span {t_W} := by
    intro W hW r x t_W hmem
    have _instLoc : IsLocalization.Away r ↑(S.presheaf.obj (Opposite.op (S.basicOpen r))) :=
      hW.isLocalization_basicOpen r
    let ρ_r : ↑(S.presheaf.obj (Opposite.op W)) →+*
        ↑(S.presheaf.obj (Opposite.op (S.basicOpen r))) :=
      algebraMap ↑(S.presheaf.obj (Opposite.op W))
        ↑(S.presheaf.obj (Opposite.op (S.basicOpen r)))
    have hmem' : ρ_r x ∈ Ideal.span {ρ_r t_W} := hmem
    rw [Ideal.mem_span_singleton] at hmem'
    obtain ⟨q, hq⟩ := hmem'
    obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj r q
    have h_loc_eq : ρ_r (r ^ m * x) = ρ_r (t_W * b) := by
      calc ρ_r (r ^ m * x)
        _ = ρ_r r ^ m * ρ_r x := by rw [map_mul, map_pow]
        _ = ρ_r r ^ m * (ρ_r t_W * q) := by rw [hq]
        _ = ρ_r t_W * (q * ρ_r r ^ m) := by ring
        _ = ρ_r t_W * ρ_r b := by rw [hb]
        _ = ρ_r (t_W * b) := by rw [map_mul]
    obtain ⟨c, hc⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers r)
        ↑(S.presheaf.obj (Opposite.op (S.basicOpen r)))).mp h_loc_eq
    obtain ⟨k, hk⟩ := c.2
    refine ⟨k + m, Ideal.mem_span_singleton.mpr ⟨r ^ k * b, ?_⟩⟩
    rw [← hk] at hc
    calc r ^ (k + m) * x
      _ = r ^ k * (r ^ m * x) := by rw [pow_add, mul_assoc]
      _ = r ^ k * (t_W * b) := hc
      _ = t_W * (r ^ k * b) := by ring
  have map_ideal_basicOpen : ∀ (U : S.affineOpens) (f : ↑(S.presheaf.obj (Opposite.op U.1))),
      Ideal.map (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le f)).op).hom (J_ideal U) =
        J_ideal (S.affineBasicOpen f) := by
    intro U f
    let R_U := ↑(S.presheaf.obj (Opposite.op U.1))
    let U_f : S.affineOpens := S.affineBasicOpen f
    let R_f := ↑(S.presheaf.obj (Opposite.op (S.basicOpen f)))
    let ρ_f : R_U →+* R_f := (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le f)).op).hom
    have hρ_alg : algebraMap R_U R_f = ρ_f := rfl
    have _instLoc_f : IsLocalization.Away f R_f := U.2.isLocalization_basicOpen f
    apply le_antisymm
    · refine Ideal.map_le_iff_le_comap.mpr fun g hg ν h' hh' => ?_
      obtain ⟨h, h_eq⟩ := U.2.basicOpen_basicOpen_is_basicOpen f h'
      have hh : S.basicOpen h ≤ V ν := h_eq.le.trans hh'
      have h'_le_bf : S.basicOpen h' ≤ S.basicOpen f := S.basicOpen_le h'
      have hg_h := hg ν h hh
      have h_tr := hResTrans h_eq (S.basicOpen_le h)
        (h'_le_bf.trans (S.basicOpen_le f)) hh hh' g (t ν) hg_h
      have h_comp_g := hResComp h'_le_bf (S.basicOpen_le f) g
      exact h_comp_g.symm ▸ h_tr
    · intro y hy
      obtain ⟨m₀, a, ha_eq⟩ := IsLocalization.Away.surj f y
      rw [hρ_alg] at ha_eq
      have ha_mem : ρ_f a ∈ J_ideal U_f := by
        rw [← ha_eq, mul_comm]
        exact (J_ideal U_f).mul_mem_left (ρ_f f ^ m₀) hy
      obtain ⟨ι_cov, _, μ_cov, h_cov, hh_cov_le, hh_cov_span⟩ := hCoverBasic U
      have h_local_pow : ∀ p : ι_cov,
          ∃ k_p : ℕ,
            (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le (h_cov p))).op).hom
              (f ^ k_p * a) ∈
            Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE (hh_cov_le p)).op).hom
              (t (μ_cov p))} := by
        intro p
        let W_p : S.Opens := S.basicOpen (h_cov p)
        have hWp : AlgebraicGeometry.IsAffineOpen W_p := U.2.basicOpen (h_cov p)
        let f_p := (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le (h_cov p))).op).hom f
        let a_p := (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le (h_cov p))).op).hom a
        let t_p := (S.presheaf.map (CategoryTheory.homOfLE (hh_cov_le p)).op).hom (t (μ_cov p))
        let h'_p : R_f := ρ_f (h_cov p)
        have h_bo_fp : S.basicOpen f_p = W_p ⊓ S.basicOpen f :=
          S.basicOpen_res f (CategoryTheory.homOfLE (S.basicOpen_le (h_cov p))).op
        have h_bo_h'p : S.basicOpen h'_p = S.basicOpen f ⊓ W_p :=
          S.basicOpen_res (h_cov p) (CategoryTheory.homOfLE (S.basicOpen_le f)).op
        have h_eq_fp : S.basicOpen h'_p = S.basicOpen f_p :=
          h_bo_h'p.trans ((inf_comm (S.basicOpen f) W_p).trans h_bo_fp.symm)
        have hh'_p_le : S.basicOpen h'_p ≤ V (μ_cov p) := by
          rw [h_bo_h'p]
          exact inf_le_right.trans (hh_cov_le p)
        have hfp_le : S.basicOpen f_p ≤ V (μ_cov p) := h_eq_fp ▸ hh'_p_le
        have ha_h'p := ha_mem (μ_cov p) h'_p hh'_p_le
        change (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le h'_p)).op).hom (ρ_f a) ∈ _ at ha_h'p
        rw [hResComp (S.basicOpen_le h'_p) (S.basicOpen_le f) a] at ha_h'p
        have ha_fp := hResTrans h_eq_fp
          ((S.basicOpen_le h'_p).trans (S.basicOpen_le f))
          ((S.basicOpen_le f_p).trans (S.basicOpen_le (h_cov p)))
          hh'_p_le hfp_le a (t (μ_cov p)) ha_h'p
        rw [← hResComp (S.basicOpen_le f_p) (S.basicOpen_le (h_cov p)) a,
          ← hResComp (S.basicOpen_le f_p) (hh_cov_le p) (t (μ_cov p))] at ha_fp
        obtain ⟨k_p, hk_p⟩ := hLiftPow hWp f_p a_p t_p ha_fp
        refine ⟨k_p, ?_⟩
        simpa [f_p, a_p, t_p, map_mul, map_pow] using hk_p
      choose k_pt hk_pt using h_local_pow
      let K : ℕ := Finset.univ.sup k_pt
      have hK_mem : f ^ K * a ∈ J_ideal U := by
        intro ν h hh
        let W_h : S.Opens := S.basicOpen h
        have hWh : AlgebraicGeometry.IsAffineOpen W_h := U.2.basicOpen h
        let R_h := ↑(S.presheaf.obj (Opposite.op W_h))
        let ρ_h : R_U →+* R_h := (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le h)).op).hom
        let x_h : R_h := ρ_h (f ^ K * a)
        let t_h : R_h := (S.presheaf.map (CategoryTheory.homOfLE hh).op).hom (t ν)
        let I_h : Ideal R_h := Ideal.span {t_h}
        let C : Ideal R_h := I_h.colon {x_h}
        have h_bar_rad : ∀ p : ι_cov, ρ_h (h_cov p) ∈ C.radical := by
          intro p
          let h_bar : R_h := ρ_h (h_cov p)
          have h_bo_bar : S.basicOpen h_bar = W_h ⊓ S.basicOpen (h_cov p) :=
            S.basicOpen_res (h_cov p) (CategoryTheory.homOfLE (S.basicOpen_le h)).op
          have h_bar_le_Wp : S.basicOpen h_bar ≤ S.basicOpen (h_cov p) :=
            h_bo_bar.le.trans inf_le_right
          have h_bar_le_Vp : S.basicOpen h_bar ≤ V (μ_cov p) :=
            h_bar_le_Wp.trans (hh_cov_le p)
          have h_bar_le_Vν : S.basicOpen h_bar ≤ V ν :=
            (S.basicOpen_le h_bar).trans hh
          have hk_le : k_pt p ≤ K := Finset.le_sup (Finset.mem_univ p)
          obtain ⟨d_p, hd_p⟩ := Nat.le.dest hk_le
          have hK_Wp : (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le (h_cov p))).op).hom
              (f ^ K * a) ∈
              Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE (hh_cov_le p)).op).hom
                (t (μ_cov p))} := by
            have h_split : f ^ K * a = f ^ d_p * (f ^ k_pt p * a) := by
              rw [← hd_p, pow_add]
              ring
            rw [h_split, map_mul]
            exact Ideal.mul_mem_left _ _ (hk_pt p)
          have h_res_bar :
              (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le h_bar)).op).hom x_h ∈
                Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le h_bar)).op).hom t_h} := by
            have h1 : (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le h_bar)).op).hom x_h =
                (S.presheaf.map (CategoryTheory.homOfLE h_bar_le_Wp).op).hom
                  ((S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le (h_cov p))).op).hom
                    (f ^ K * a)) := by
              dsimp [x_h, ρ_h]
              rw [hResComp (S.basicOpen_le h_bar) (S.basicOpen_le h),
                hResComp h_bar_le_Wp (S.basicOpen_le (h_cov p))]
            rw [h1]
            have h2 := Ideal.mem_map_of_mem
              (S.presheaf.map (CategoryTheory.homOfLE h_bar_le_Wp).op).hom hK_Wp
            rw [Ideal.map_span, Set.image_singleton,
              hResComp h_bar_le_Wp (hh_cov_le p),
              hSpan_eq (S.basicOpen h_bar) (μ_cov p) ν h_bar_le_Vp h_bar_le_Vν,
              ← hResComp (S.basicOpen_le h_bar) hh] at h2
            exact h2
          obtain ⟨N_p, hN_p⟩ := hLiftPow hWh h_bar x_h t_h h_res_bar
          rw [Ideal.mem_radical_iff]
          refine ⟨N_p, ?_⟩
          rw [Submodule.mem_colon_singleton, smul_eq_mul]
          exact hN_p
        have h_span_bar : Ideal.span (Set.range (fun p : ι_cov => ρ_h (h_cov p))) = ⊤ := by
          have h_map := congrArg (Ideal.map ρ_h) hh_cov_span
          rw [Ideal.map_span, Ideal.map_top, ← Set.range_comp] at h_map
          exact h_map
        have h_top_le : (⊤ : Ideal R_h) ≤ C.radical := by
          rw [← h_span_bar, Ideal.span_le]
          rintro _ ⟨p, rfl⟩
          exact h_bar_rad p
        have h1_rad : (1 : R_h) ∈ C.radical := h_top_le Submodule.mem_top
        obtain ⟨M, h1M⟩ := Ideal.mem_radical_iff.mp h1_rad
        rw [one_pow] at h1M
        rw [Submodule.mem_colon_singleton, one_smul] at h1M
        exact h1M
      have h_map_mem : ρ_f (f ^ K * a) ∈ Ideal.map ρ_f (J_ideal U) :=
        Ideal.mem_map_of_mem ρ_f hK_mem
      have h_prod : ρ_f (f ^ K * a) = y * ρ_f f ^ (K + m₀) := by
        calc ρ_f (f ^ K * a)
          _ = ρ_f f ^ K * ρ_f a := by rw [map_mul, map_pow]
          _ = ρ_f f ^ K * (y * ρ_f f ^ m₀) := by rw [← ha_eq]
          _ = y * ρ_f f ^ (K + m₀) := by rw [pow_add]; ring
      rw [h_prod] at h_map_mem
      have hu : IsUnit (ρ_f f ^ (K + m₀)) := by
        rw [← hρ_alg]
        exact (IsLocalization.Away.algebraMap_isUnit f).pow (K + m₀)
      obtain ⟨u_f, hu_f⟩ := hu
      rw [← hu_f] at h_map_mem
      have h_resc := (Ideal.map ρ_f (J_ideal U)).mul_mem_right (↑u_f⁻¹) h_map_mem
      simpa [mul_assoc] using h_resc
  
  let Z_supp : Set S := (W_F : Set S)ᶜ
  have supportSet_inter : ∀ (U : S.affineOpens), ∀ x ∈ U.1,
      x ∈ Z_supp ↔ x ∈ S.zeroLocus (J_ideal U : Set ↑(S.presheaf.obj (Opposite.op U.1))) := by
    intro U x hxU
    have hx_top : x ∈ (⨆ μ : Fin (M₀ + 1), V μ) := by
      rw [hV_cov]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hx_top
    obtain ⟨μ₀, hxμ₀⟩ := hx_top
    obtain ⟨h₀, hh₀_le, hxh₀⟩ := U.2.exists_basicOpen_le (⟨x, hxμ₀⟩ : ↥(V μ₀)) hxU
    let ρ₀ := (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le h₀)).op).hom
    have h_map_eq : Ideal.map ρ₀ (J_ideal U) =
        Ideal.span {(S.presheaf.map (CategoryTheory.homOfLE hh₀_le).op).hom (t μ₀)} :=
      (map_ideal_basicOpen U h₀).trans (hChart (S.affineBasicOpen h₀) μ₀ hh₀_le)
    have h_zl_eq : S.zeroLocus (ρ₀ '' (J_ideal U : Set ↑(S.presheaf.obj (Opposite.op U.1)))) =
        S.zeroLocus {(S.presheaf.map (CategoryTheory.homOfLE hh₀_le).op).hom (t μ₀)} := by
      rw [← S.zeroLocus_span (ρ₀ '' _), ← Ideal.map_span, Ideal.span_eq, h_map_eq, S.zeroLocus_span]
    have h_zl_U : x ∈ S.zeroLocus (J_ideal U : Set ↑(S.presheaf.obj (Opposite.op U.1))) ↔
        x ∈ S.zeroLocus (ρ₀ '' (J_ideal U : Set ↑(S.presheaf.obj (Opposite.op U.1)))) := by
      simp only [AlgebraicGeometry.Scheme.mem_zeroLocus_iff, Set.mem_image, forall_exists_index,
        and_imp, forall_apply_eq_imp_iff₂]
      refine forall₂_congr fun g _ => not_congr ?_
      have h_res := S.basicOpen_res g (CategoryTheory.homOfLE (S.basicOpen_le h₀)).op
      change S.basicOpen (ρ₀ g) = S.basicOpen h₀ ⊓ S.basicOpen g at h_res
      rw [h_res]
      exact ⟨fun hxg => ⟨hxh₀, hxg⟩, fun h => h.2⟩
    rw [h_zl_U, h_zl_eq, AlgebraicGeometry.Scheme.mem_zeroLocus_iff, Set.forall_mem_singleton,
      S.basicOpen_res (t μ₀) (CategoryTheory.homOfLE hh₀_le).op, hBasic_V μ₀]
    change x ∉ W_F ↔ x ∉ (S.basicOpen h₀ ⊓ (V μ₀ ⊓ W_F) : S.Opens)
    exact ⟨fun hn hmem => hn hmem.2.2, fun hn hxW => hn ⟨hxh₀, hxμ₀, hxW⟩⟩
  
  let J_data : S.IdealSheafData :=
    AlgebraicGeometry.Scheme.IdealSheafData.mkOfMemSupportIff
      J_ideal map_ideal_basicOpen Z_supp supportSet_inter
  refine ⟨J_data.subscheme, J_data.subschemeι, ?_, hF', ?_, ?_⟩
  · exact AlgebraicGeometry.IsClosedImmersion.instSubschemeι J_data
  · exact (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι J_data).trans
      (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_mkOfMemSupportIff
        J_ideal map_ideal_basicOpen Z_supp supportSet_inter)
  · intro μ hXμ U hU_aff hU_sub
    let U_aff : S.affineOpens := ⟨U, hU_aff⟩
    have h_ker : RingHom.ker (J_data.subschemeι.app U).hom = J_ideal U_aff := by
      rw [← AlgebraicGeometry.Scheme.Hom.ker_apply J_data.subschemeι U_aff,
        AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι J_data,
        AlgebraicGeometry.Scheme.IdealSheafData.mkOfMemSupportIff_ideal]
    rw [h_ker, hChart U_aff μ hU_sub]
    congr 2

theorem weil_projective_integral_finite_affine_cover_trdeg_le (k : Type u) [Field k] (m : ℕ)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntB₀ : AlgebraicGeometry.IsIntegral B₀.left)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (hDimB₀ : topologicalKrullDim B₀.left = (m : WithBot ℕ∞)) :
    AlgebraicGeometry.IsSeparated B₀.hom ∧
    ∃ (B_cov : ℕ)
      (R : Fin B_cov → Type u)
      (_ : ∀ β, CommRing (R β))
      (_ : ∀ β, IsDomain (R β))
      (_ : ∀ β, Algebra k (R β))
      (_ : ∀ β, Algebra.FiniteType k (R β))
      (j : ∀ β : Fin B_cov, AlgebraicGeometry.Spec (CommRingCat.of (R β)) ⟶ B₀.left),
      (∀ β, AlgebraicGeometry.IsOpenImmersion (j β)) ∧
      (∀ β, j β ≫ B₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (R β)))) ∧
      (⋃ β : Fin B_cov, Set.range (j β).base) = Set.univ ∧
      (∀ β, Algebra.trdeg k (R β) ≤ (m : Cardinal.{u})) :=
by
  have hProjProps : AlgebraicGeometry.IsSeparated B₀.hom ∧
      AlgebraicGeometry.LocallyOfFiniteType B₀.hom ∧
      CompactSpace ↥B₀.left := by
    obtain ⟨N₀, ιB₀, hClB₀⟩ := hProjB₀
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let f_ι : B₀.left ⟶ AlgebraicGeometry.Proj 𝒜 := ιB₀.left
    haveI : AlgebraicGeometry.IsClosedImmersion f_ι := hClB₀
    have hHom_eq : B₀.hom = f_ι ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (CategoryTheory.Over.w ιB₀).symm
    haveI : AlgebraicGeometry.IsSeparated (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.isSeparated 𝒜
    have hSepB₀ : AlgebraicGeometry.IsSeparated B₀.hom := by
      rw [hHom_eq]
      infer_instance
    haveI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N₀ + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N₀ + 1)) k) p⟩
    haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N₀ + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N₀ + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz : z.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N₀ + 1)) k)) := by
        simpa [𝒜, MvPolynomial.homogeneousSubmodule_zero] using z.2
      rw [Submodule.mem_one] at hz
      obtain ⟨c, hc⟩ := hz
      exact ⟨c, Subtype.ext hc⟩
    have hFT_map0 : (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))).hom.FiniteType :=
      RingHom.FiniteType.of_surjective (algebraMap k ↥(𝒜 0)) hSurj0
    haveI : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT_map0
    have hLFT_B₀ : AlgebraicGeometry.LocallyOfFiniteType B₀.hom := by
      rw [hHom_eq]
      infer_instance
    have hCompProj : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) := by
      have h_adjoin : Algebra.adjoin (↥(𝒜 0))
          (Set.range (MvPolynomial.X : Fin (N₀ + 1) → MvPolynomial (Fin (N₀ + 1)) k)) = ⊤ := by
        rw [eq_top_iff]
        have h_mem_all : ∀ p : MvPolynomial (Fin (N₀ + 1)) k,
            p ∈ Algebra.adjoin (↥(𝒜 0))
              (Set.range (MvPolynomial.X : Fin (N₀ + 1) → MvPolynomial (Fin (N₀ + 1)) k)) := by
          intro p
          induction p using MvPolynomial.induction_on with
          | C a =>
            let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
            exact (Algebra.adjoin (↥(𝒜 0))
              (Set.range (MvPolynomial.X : Fin (N₀ + 1) → MvPolynomial (Fin (N₀ + 1)) k))).algebraMap_mem c₀
          | add p q hp hq =>
            exact add_mem hp hq
          | mul_X p i hp =>
            exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
        intro p _
        exact h_mem_all p
      have h_top : (⨆ i : Fin (N₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X
          (fun i => ⟨1, MvPolynomial.isHomogeneous_X k i⟩) h_adjoin
      rw [← isCompact_univ_iff]
      have h_univ : (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) =
          ⋃ i : Fin (N₀ + 1), (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i) :
            Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
        rw [← TopologicalSpace.Opens.coe_top, ← h_top, TopologicalSpace.Opens.coe_iSup]
      rw [h_univ]
      refine isCompact_iUnion fun i => ?_
      let U_i := AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)
      let iso_i := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X i)
        (MvPolynomial.isHomogeneous_X k i) zero_lt_one
      have hHomeo : ↥(U_i : AlgebraicGeometry.Scheme.{u}) ≃ₜ ↥(AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i)))) :=
        TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso_i)
      exact isCompact_iff_compactSpace.mpr hHomeo.symm.compactSpace
    have hCompB₀ : CompactSpace ↥B₀.left := by
      haveI : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) := hCompProj
      exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding f_ι).compactSpace
    exact ⟨hSepB₀, hLFT_B₀, hCompB₀⟩
  obtain ⟨hSepB₀, hLFT_B₀, hCompB₀⟩ := hProjProps
  haveI : AlgebraicGeometry.LocallyOfFiniteType B₀.hom := hLFT_B₀
  haveI : CompactSpace ↥B₀.left := hCompB₀
  have hAffPt : ∀ x : ↥B₀.left, ∃ U : B₀.left.Opens,
      AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U := by
    intro x
    obtain ⟨U, hAffU, hxU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top x)
    exact ⟨U, hAffU, hxU⟩
  choose U_pt hAff_pt hx_pt using hAffPt
  have h_cov : (Set.univ : Set ↥B₀.left) ⊆ ⋃ x : ↥B₀.left, (U_pt x : Set ↥B₀.left) := by
    intro x _
    exact Set.mem_iUnion.mpr ⟨x, hx_pt x⟩
  obtain ⟨S_cov, hS_cov⟩ := isCompact_univ.elim_finite_subcover
    (fun x : ↥B₀.left => (U_pt x : Set ↥B₀.left))
    (fun x => (U_pt x).isOpen) h_cov
  let B_cov : ℕ := S_cov.card
  let e : Fin B_cov ≃ ↥S_cov := S_cov.equivFin.symm
  let U : Fin B_cov → B₀.left.Opens := fun β => U_pt (e β).1
  have hAff : ∀ β : Fin B_cov, AlgebraicGeometry.IsAffineOpen (U β) :=
    fun β => hAff_pt (e β).1
  have hNe : ∀ β : Fin B_cov, Nonempty ↥(U β) :=
    fun β => ⟨⟨(e β).1, hx_pt (e β).1⟩⟩
  let R_cat : Fin B_cov → CommRingCat.{u} :=
    fun β => B₀.left.presheaf.obj (Opposite.op (U β))
  let R : Fin B_cov → Type u := fun β => ↥(R_cat β)
  let instComm : ∀ β : Fin B_cov, CommRing (R β) := fun β => inferInstance
  letI : ∀ β : Fin B_cov, CommRing (R β) := instComm
  have instDom : ∀ β : Fin B_cov, IsDomain (R β) := by
    intro β
    exact @AlgebraicGeometry.IsIntegral.component_integral B₀.left hIntB₀ (U β) (hNe β)
  letI : ∀ β : Fin B_cov, IsDomain (R β) := instDom
  let j : ∀ β : Fin B_cov, AlgebraicGeometry.Spec (CommRingCat.of (R β)) ⟶ B₀.left :=
    fun β => (hAff β).fromSpec
  have hOpen_j : ∀ β : Fin B_cov, AlgebraicGeometry.IsOpenImmersion (j β) :=
    fun β => inferInstance
  let α : ∀ β : Fin B_cov, CommRingCat.of k ⟶ R_cat β :=
    fun β => AlgebraicGeometry.Spec.preimage (j β ≫ B₀.hom)
  let instAlg : ∀ β : Fin B_cov, Algebra k (R β) :=
    fun β => (CommRingCat.Hom.hom (α β)).toAlgebra
  letI : ∀ β : Fin B_cov, Algebra k (R β) := instAlg
  have hHom_j : ∀ β : Fin B_cov,
      j β ≫ B₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (R β))) :=
    fun β => (AlgebraicGeometry.Spec.map_preimage (j β ≫ B₀.hom)).symm
  have instFT : ∀ β : Fin B_cov, Algebra.FiniteType k (R β) := by
    intro β
    haveI : AlgebraicGeometry.IsOpenImmersion (j β) := hOpen_j β
    have hLFT_map : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (R β)))) := by
      rw [← hHom_j β]
      infer_instance
    have hFT_hom : (CommRingCat.ofHom (algebraMap k (R β))).hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_map
    exact ⟨hFT_hom.out⟩
  letI : ∀ β : Fin B_cov, Algebra.FiniteType k (R β) := instFT
  have hCov_j : (⋃ β : Fin B_cov, Set.range (j β).base) = Set.univ := by
    apply Set.eq_univ_of_univ_subset
    intro y hy
    have hyS := hS_cov hy
    rw [Set.mem_iUnion₂] at hyS
    obtain ⟨x, hxS, hyU⟩ := hyS
    rw [Set.mem_iUnion]
    refine ⟨e.symm ⟨x, hxS⟩, ?_⟩
    have hRange : Set.range (j (e.symm ⟨x, hxS⟩)).base = (U (e.symm ⟨x, hxS⟩) : Set ↥B₀.left) :=
      (hAff (e.symm ⟨x, hxS⟩)).range_fromSpec
    rw [hRange]
    simpa [U] using hyU
  have hDim_R : ∀ β : Fin B_cov, ringKrullDim (R β) ≤ (m : WithBot ℕ∞) := by
    intro β
    let e_iso := AlgebraicGeometry.Scheme.homeoOfIso (hAff β).isoSpec
    have h1 : ringKrullDim (R β) = topologicalKrullDim (PrimeSpectrum (R β)) :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (R β)).symm
    have h2 : topologicalKrullDim ↥(U β).toScheme = topologicalKrullDim ↥(AlgebraicGeometry.Spec (R_cat β)) :=
      e_iso.isHomeomorph.topologicalKrullDim_eq
    have h3 : topologicalKrullDim ↥(U β : Set ↥B₀.left) ≤ topologicalKrullDim ↥B₀.left :=
      topologicalKrullDim_subspace_le ↥B₀.left (U β : Set ↥B₀.left)
    calc
      ringKrullDim (R β) = topologicalKrullDim (PrimeSpectrum (R β)) := h1
      _ = topologicalKrullDim ↥(AlgebraicGeometry.Spec (R_cat β)) := rfl
      _ = topologicalKrullDim ↥(U β).toScheme := h2.symm
      _ = topologicalKrullDim ↥(U β : Set ↥B₀.left) := rfl
      _ ≤ topologicalKrullDim ↥B₀.left := h3
      _ = (m : WithBot ℕ∞) := hDimB₀
  have hTrdeg_R : ∀ β : Fin B_cov, Algebra.trdeg k (R β) ≤ (m : Cardinal.{u}) := by
    intro β
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k (R β)
    let P : Type u := MvPolynomial (Fin s) k
    have hDim_P : ringKrullDim P = (s : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    letI : Algebra P (R β) := g.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral P (R β) := ⟨hg_int⟩
    have hLift : ∀ (len : ℕ) (p : LTSeries (PrimeSpectrum P)), p.length = len →
        ∃ q : LTSeries (PrimeSpectrum (R β)),
          q.length = len ∧ Ideal.under P q.last.asIdeal = p.last.asIdeal := by
      intro len
      induction len with
      | zero =>
        intro p _
        have h_bot : Ideal.under P (⊥ : Ideal (R β)) ≤ p.last.asIdeal := by
          intro y hy
          have hgy : g y = 0 := hy
          have hy0 : y = 0 := hg_inj (by simpa using hgy)
          rw [hy0]
          exact p.last.asIdeal.zero_mem
        haveI : p.last.asIdeal.IsPrime := p.last.isPrime
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
          @Ideal.exists_ideal_over_prime_of_isIntegral P _ (R β) _ _ _ p.last.asIdeal _ (⊥ : Ideal (R β)) h_bot
        refine ⟨RelSeries.singleton _ (⟨Q₀, hQ₀_prime⟩ : PrimeSpectrum (R β)), rfl, ?_⟩
        exact hQ₀_under
      | succ len ih =>
        intro p hp_len
        let p' : LTSeries (PrimeSpectrum P) := p.eraseLast
        have hp'_len : p'.length = len := by
          rw [RelSeries.eraseLast_length, hp_len]
          omega
        have hp'_lt : p'.last < p.last :=
          p.eraseLast_last_rel_last (by omega)
        obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
        have h_le_under : Ideal.under P q'.last.asIdeal ≤ p.last.asIdeal := by
          rw [hq'_under]
          exact le_of_lt hp'_lt
        haveI : p.last.asIdeal.IsPrime := p.last.isPrime
        haveI : q'.last.asIdeal.IsPrime := q'.last.isPrime
        obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
          @Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime P _ (R β) _ _ _ p.last.asIdeal _ q'.last.asIdeal _ h_le_under
        have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum (R β)) := by
          apply lt_of_le_of_ne hQ_ge
          intro h_eq
          have h_p_eq : p'.last.asIdeal = p.last.asIdeal := by
            rw [← hq'_under, h_eq, hQ_under]
          exact ne_of_lt hp'_lt (PrimeSpectrum.ext h_p_eq)
        refine ⟨q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q, ?_, ?_⟩
        · rw [RelSeries.snoc_length, hq'_len]
        · rw [RelSeries.last_snoc]
          exact hQ_under
    have hs_le_dimP : (s : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum P) :=
      le_of_eq hDim_P.symm
    obtain ⟨p₀, hp₀_len⟩ := Order.le_krullDim_iff.mp hs_le_dimP
    obtain ⟨q₀, hq₀_len, _⟩ := hLift p₀.length p₀ rfl
    have hs_le_m_wb : (s : WithBot ℕ∞) ≤ (m : WithBot ℕ∞) := by
      calc
        (s : WithBot ℕ∞) = (p₀.length : WithBot ℕ∞) := by rw [hp₀_len]
        _ = (q₀.length : WithBot ℕ∞) := by rw [hq₀_len]
        _ ≤ ringKrullDim (R β) := Order.LTSeries.length_le_krullDim q₀
        _ ≤ (m : WithBot ℕ∞) := hDim_R β
    have hs_le_m : s ≤ m := (Nat.cast_le (α := WithBot ℕ∞)).mp hs_le_m_wb
    haveI : IsScalarTower k P (R β) :=
      IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
    haveI : FaithfulSMul k P :=
      (faithfulSMul_iff_algebraMap_injective k P).mpr (algebraMap k P).injective
    haveI : FaithfulSMul P (R β) :=
      (faithfulSMul_iff_algebraMap_injective P (R β)).mpr hg_inj
    haveI : Algebra.IsAlgebraic P (R β) := Algebra.IsIntegral.isAlgebraic
    have h_tr_PR : Algebra.trdeg P (R β) = 0 := trdeg_eq_zero
    have h_tr_kP : Algebra.trdeg k P = (s : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain]
      simp
    have h_tr_kR : Algebra.trdeg k (R β) = (s : Cardinal.{u}) := by
      have h_add := trdeg_add_eq k P (A := R β)
      rw [h_tr_kP, h_tr_PR, add_zero] at h_add
      exact h_add.symm
    rw [h_tr_kR]
    exact (Nat.cast_le (α := Cardinal.{u})).mpr hs_le_m
  exact ⟨hSepB₀, B_cov, R, instComm, instDom, instAlg, instFT, j, hOpen_j, hHom_j, hCov_j, hTrdeg_R⟩

theorem weil_projective_curve_fib_product_chart_reduction (k : Type u) [Field k] (M₀ d₀ : ℕ)
    (hd₀ : 1 ≤ d₀)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hSepB₀ : AlgebraicGeometry.IsSeparated B₀.hom)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀)
    (R_β : Type u) [CommRing R_β] [Algebra k R_β]
    (j_β : AlgebraicGeometry.Spec (CommRingCat.of R_β) ⟶ B₀.left)
    (hOpen_j : AlgebraicGeometry.IsOpenImmersion j_β)
    (hHom_j : j_β ≫ B₀.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_β)))
    (μ : Fin (M₀ + 1)) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) :=
      MvPolynomial.gradedAlgebra
    ∃ (S : Type u)
      (_ : CommRing S)
      (_ : Algebra R_β S)
      (x : Fin (M₀ + 1) → S),
      x μ = 1 ∧
      Function.Surjective (MvPolynomial.aeval x : MvPolynomial (Fin (M₀ + 1)) R_β →ₐ[R_β] S) ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ_Ω : R_β →+* Ω),
        letI : Algebra R_β Ω := φ_Ω.toAlgebra
        ∀ (Q₁ Q₂ : PrimeSpectrum (TensorProduct R_β S Ω)), Q₁ < Q₂ → IsMin Q₁) ∧
      (∀ (c : weilDegMonomialIdx M₀ d₀ → k) (p : PrimeSpectrum R_β),
        ({q : PrimeSpectrum S | PrimeSpectrum.comap (algebraMap R_β S) q = p ∧
          (∑ e : weilDegMonomialIdx M₀ d₀,
            algebraMap R_β S (algebraMap k R_β (c e)) *
              ∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) ∈ q.asIdeal}).Finite →
        ({z : V₁.left | f₁.left.base z = j_β.base p ∧
          z ∈ ((TopologicalSpace.Opens.map ι₁.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k)
              (MvPolynomial.X μ)) : Set V₁.left) ∧
          z ∉ ((TopologicalSpace.Opens.map ι₁.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k)
              (weilHomogeneousPoly M₀ d₀ c)) : Set V₁.left)}).Finite) :=
by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  
  let f_μ : MvPolynomial (Fin (M₀ + 1)) k := MvPolynomial.X μ
  let M_f : Submonoid (MvPolynomial (Fin (M₀ + 1)) k) := Submonoid.powers f_μ
  let P_μ : Type u := HomogeneousLocalization.Away 𝒜 f_μ
  letI : Algebra k P_μ :=
    ((HomogeneousLocalization.fromZeroRingHom 𝒜 M_f).comp (algebraMap k ↥(𝒜 0))).toAlgebra
  have hXμ : f_μ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k μ
  have hX_hom : ∀ α : Fin (M₀ + 1), MvPolynomial.X α ∈ 𝒜 (1 • 1) := fun α => by
    rw [one_smul]
    exact MvPolynomial.isHomogeneous_X k α
  let u_μ : Fin (M₀ + 1) → P_μ := fun α =>
    HomogeneousLocalization.Away.mk 𝒜 hXμ 1 (MvPolynomial.X α) (hX_hom α)
  let s_pow : ℕ → M_f := fun n => ⟨f_μ ^ n, ⟨n, rfl⟩⟩
  have hu_mu : u_μ μ = 1 := by
    apply HomogeneousLocalization.val_injective M_f
    rw [HomogeneousLocalization.Away.val_mk]
    have h_den : (⟨f_μ ^ 1, ⟨1, rfl⟩⟩ : M_f) =
        ⟨MvPolynomial.X μ, Submonoid.mem_powers (MvPolynomial.X μ)⟩ :=
      Subtype.ext (pow_one f_μ)
    rw [h_den, Localization.mk_self ⟨MvPolynomial.X μ, Submonoid.mem_powers (MvPolynomial.X μ)⟩]
    rw [← HomogeneousLocalization.algebraMap_apply, map_one]
  have h_mk_pow : ∀ (g : MvPolynomial (Fin (M₀ + 1)) k) (s : M_f) (d : ℕ),
      (Localization.mk g s) ^ d = Localization.mk (g ^ d) (s ^ d) := by
    intro g s d
    induction d with
    | zero => simp [Localization.mk_one]
    | succ d ih => rw [pow_succ, pow_succ, pow_succ, ih, Localization.mk_mul]
  have h_mk_prod : ∀ (T : Finset (Fin (M₀ + 1)))
      (g : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k) (t : Fin (M₀ + 1) → M_f),
      ∏ α ∈ T, Localization.mk (g α) (t α) =
        Localization.mk (∏ α ∈ T, g α) (∏ α ∈ T, t α) := by
    intro T g t
    induction T using Finset.induction_on with
    | empty => simp [Localization.mk_one]
    | @insert α T hα ih =>
      rw [Finset.prod_insert hα, Finset.prod_insert hα, Finset.prod_insert hα, ih,
        Localization.mk_mul]
  have h_mk_sum : ∀ (T : Finset (Fin (M₀ + 1) →₀ ℕ))
      (g : (Fin (M₀ + 1) →₀ ℕ) → MvPolynomial (Fin (M₀ + 1)) k) (s : M_f),
      ∑ i ∈ T, Localization.mk (g i) s = Localization.mk (∑ i ∈ T, g i) s := by
    intro T g s
    induction T using Finset.induction_on with
    | empty => simp [Localization.mk_zero]
    | @insert i T hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, ih, Localization.add_mk_self]
  have h_scalar_val : ∀ r : k,
      (algebraMap k P_μ r).val = Localization.mk (MvPolynomial.C r) 1 := by
    intro r
    refine (HomogeneousLocalization.val_mk _).trans ?_
    congr 1
  have h_monomial_val : ∀ (n : ℕ) (m : Fin (M₀ + 1) →₀ ℕ) (r : k),
      (∑ α : Fin (M₀ + 1), m α) = n →
      (MvPolynomial.aeval u_μ (MvPolynomial.monomial m r)).val =
        Localization.mk (MvPolynomial.monomial m r) (s_pow n) := by
    intro n m r hm
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
    rw [← HomogeneousLocalization.algebraMap_apply, map_mul, map_prod]
    simp_rw [map_pow, HomogeneousLocalization.algebraMap_apply, u_μ,
      HomogeneousLocalization.Away.val_mk, h_mk_pow]
    rw [h_scalar_val r, h_mk_prod, Localization.mk_mul]
    have h_num : MvPolynomial.C r * ∏ α : Fin (M₀ + 1), (MvPolynomial.X α) ^ (m α) =
        MvPolynomial.monomial m r := by
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
    have h_den : (1 * ∏ α : Fin (M₀ + 1), (⟨f_μ ^ 1, ⟨1, rfl⟩⟩ : M_f) ^ (m α)) = s_pow n := by
