    refine ⟨inferInstance, inferInstance, ϖ, hψ_k, hϖ_ne, hMax, hRes, hMod_ϖ, ?_⟩
    intro C _ _ _ _ _ _ hInjC
    refine ⟨?_, ?_⟩
    · 
      haveI hDomCK : IsDomain (TensorProduct k C K) := (hAlgDom K C).1
      let e_mv : MvPolynomial (Fin m) K ≃+* TensorProduct k K (MvPolynomial (Fin m) k) :=
        (MvPolynomial.algebraTensorAlgEquiv k K).symm.toRingEquiv
      have he_mv_C : ∀ κ : K,
          e_mv (MvPolynomial.C κ) = κ ⊗ₜ[k] (1 : MvPolynomial (Fin m) k) := by
        intro κ
        apply (MvPolynomial.algebraTensorAlgEquiv k K).injective
        change (MvPolynomial.algebraTensorAlgEquiv k K)
          ((MvPolynomial.algebraTensorAlgEquiv k K).symm _) = _
        rw [AlgEquiv.apply_symm_apply, MvPolynomial.algebraTensorAlgEquiv_tmul, map_one,
