        hf_emb.isCompact_iff.mpr (TopologicalSpace.NoetherianSpace.isCompact (f_iso.base '' s)))
    have hNoethProj : TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜) := by
      refine TopologicalSpace.noetherianSpace_iff_isCompact.mpr (fun s => ?_)
      let D : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
        fun α => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α)
