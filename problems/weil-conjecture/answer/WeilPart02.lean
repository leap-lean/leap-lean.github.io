          fun i => Classical.choose_spec (hSurj_Pκ (bKer.repr z₁_sub i))
        let n_z : ↥J_P := p₀ • u₀ + ∑ i : Fin c, p_coeff i • g_JP i
        have hn_mem : n_z.1 ∈ N_ideal := by
