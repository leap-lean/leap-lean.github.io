        change (π_mod ϖ_B₀) i_star = 0
        have h0 : π_mod ϖ_B₀ = 0 := by
          rw [← RingHom.mem_ker, hker_π_mod]
          exact Ideal.subset_span rfl
        rw [h0]
        rfl
    have hJg_max : J_g.IsMaximal := by
      rw [← hker_ψ_res]
