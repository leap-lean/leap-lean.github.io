      (letI : Algebra Ω Λ := j_Ω.toAlgebra; ¬ IsAlgebraic Ω (σ_S (x ν))) ∧
      (∑ e : I, σ_S (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * j_Ω (C e)) = 0 := by
    let A : Type u := MvPolynomial I R
    let B : Type u := MvPolynomial I S
    let f_AB : A →+* B := MvPolynomial.map (algebraMap R S)
    have : P.asIdeal.IsPrime := P.isPrime
