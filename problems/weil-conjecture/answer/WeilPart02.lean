    have hΘ_snd : Θ.hom ≫ snd_L =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L (Fin k_D → L))) := by
      have h_pb_fst : e₁.hom ≫
          CategoryTheory.Limits.pullback.fst π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L B_L)) := by
        have h_eq : (AlgebraicGeometry.pullbackSpecIso K₀ L (A₀ ℓ)).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L B_L)) =
            CategoryTheory.Limits.pullback.fst π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) :=
          AlgebraicGeometry.pullbackSpecIso_hom_fst' K₀ L (A₀ ℓ)
        exact (congrArg (e₁.hom ≫ ·) h_eq.symm).trans
          (Iso.inv_hom_id_assoc (AlgebraicGeometry.pullbackSpecIso K₀ L (A₀ ℓ)) _)
      have h_step1 : Θ.hom ≫ snd_L = iso_spec_Ψ.hom ≫ (e₁.hom ≫ (fwd₂ ≫ snd_L)) := by
        change (iso_spec_Ψ.hom ≫ e₁.hom ≫ fwd₂) ≫ snd_L = _
        rw [Category.assoc, Category.assoc]
      have h_step2 : fwd₂ ≫ snd_L =
          CategoryTheory.Limits.pullback.fst π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h_step3 : iso_spec_Ψ.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L B_L)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L (Fin k_D → L))) := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ_L.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L B_L)) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
          (RingHom.ext fun l_0 => Ψ_L.commutes l_0)
      exact h_step1.trans ((congrArg (fun f => iso_spec_Ψ.hom ≫ (e₁.hom ≫ f)) h_step2).trans
        ((congrArg (iso_spec_Ψ.hom ≫ ·) h_pb_fst).trans h_step3))
    let ev : ∀ j : Fin k_D, (Fin k_D → L) →ₐ[L] L :=
      fun j => Pi.evalAlgHom L (fun _ => L) j
    let s_pt : ∀ j : Fin k_D, AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ P_L :=
      fun j => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev j).toRingHom) ≫ Θ.hom
    have hs_snd : ∀ j : Fin k_D, s_pt j ≫ snd_L = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) := by
      intro j
      dsimp only [s_pt]
      rw [Category.assoc, hΘ_snd, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_id : (ev j).toRingHom.comp (algebraMap L (Fin k_D → L)) = RingHom.id L :=
        RingHom.ext (fun l_0 => (ev j).commutes l_0)
      rw [h_id]
      simp
    let z : Fin k_D → (AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ D ℓ) :=
      fun j => s_pt j ≫ fst_L
    have hz : ∀ j : Fin k_D, z j ≫ p ℓ = ξ_L := by
      intro j
      dsimp only [z]
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc,
        hs_snd j, Category.id_comp]
    refine ⟨k_D, z, hz, fun q => ?_⟩
    let P_id : PrimeSpectrum (Fin k_D → L) := Θ.inv.base q
    have h1_not_mem : (1 : Fin k_D → L) ∉ P_id.asIdeal :=
      fun h1 => P_id.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    have h1_sum : (1 : Fin k_D → L) = ∑ j : Fin k_D, Pi.single j (1 : L) := by
      ext j₀
      simp only [Pi.one_apply, Finset.sum_apply]
      rw [Finset.sum_eq_single j₀]
      · simp
      · intro j' _ hj_ne; exact Pi.single_eq_of_ne (Ne.symm hj_ne) 1
      · intro hj₀; exact False.elim (hj₀ (Finset.mem_univ j₀))
    have hex_j : ∃ j₀ : Fin k_D, Pi.single j₀ (1 : L) ∉ P_id.asIdeal := by
      by_contra h_all
      simp only [not_exists, not_not] at h_all
      apply h1_not_mem
      rw [h1_sum]
      exact Ideal.sum_mem P_id.asIdeal (fun j _ => h_all j)
    obtain ⟨j₀, hj₀_not⟩ := hex_j
    let pt_L : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := IsLocalRing.closedPoint L
    have hPid_eq : P_id =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev j₀).toRingHom)).base pt_L := by
      refine PrimeSpectrum.ext ?_
      ext v
      have hpt_bot : pt_L.asIdeal = ⊥ :=
        (Ideal.eq_bot_or_top pt_L.asIdeal).resolve_right pt_L.isPrime.ne_top
      change v ∈ P_id.asIdeal ↔ v ∈ Ideal.comap (ev j₀).toRingHom pt_L.asIdeal
      rw [hpt_bot, Ideal.mem_comap, Ideal.mem_bot]
      change v ∈ P_id.asIdeal ↔ v j₀ = 0
      have h_prod0 : Pi.single j₀ (1 : L) * (v - algebraMap L (Fin k_D → L) (v j₀)) = 0 := by
        ext j'
        by_cases hj' : j' = j₀
        · subst hj'; simp
        · simp [Pi.single_eq_of_ne hj']
      have h_diff_mem : v - algebraMap L (Fin k_D → L) (v j₀) ∈ P_id.asIdeal := by
        have h_mem0 : Pi.single j₀ (1 : L) * (v - algebraMap L (Fin k_D → L) (v j₀)) ∈ P_id.asIdeal := by
          rw [h_prod0]; exact P_id.asIdeal.zero_mem
        exact (P_id.isPrime.mem_or_mem h_mem0).resolve_left hj₀_not
      constructor
      · intro hv_mem
        by_contra hv_ne
        have h_alg_mem : algebraMap L (Fin k_D → L) (v j₀) ∈ P_id.asIdeal := by
          have h_sub := P_id.asIdeal.sub_mem hv_mem h_diff_mem
          simpa using h_sub
        have h_unit : IsUnit (algebraMap L (Fin k_D → L) (v j₀)) :=
          (isUnit_iff_ne_zero.mpr hv_ne).map (algebraMap L (Fin k_D → L))
        exact P_id.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h_alg_mem h_unit)
      · intro hv0
        rw [hv0, map_zero, sub_zero] at h_diff_mem
        exact h_diff_mem
    have hs_lift_eq :
        CategoryTheory.Limits.pullback.lift (z j₀)
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L))) (hz j₀) = s_pt j₀ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact CategoryTheory.Limits.pullback.lift_fst (z j₀)
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L))) (hz j₀)
      · exact (CategoryTheory.Limits.pullback.lift_snd (z j₀)
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L))) (hz j₀)).trans (hs_snd j₀).symm
    refine ⟨j₀, pt_L, ?_⟩
    have hs_pt_q : (s_pt j₀).base pt_L = q := by
      have h1 : (s_pt j₀).base pt_L = Θ.hom.base P_id :=
        congrArg Θ.hom.base hPid_eq.symm
      have h2 : Θ.hom.base P_id = (Θ.inv ≫ Θ.hom).base q := rfl
      have h3 : (Θ.inv ≫ Θ.hom).base q = q := by
        rw [Θ.inv_hom_id]
        rfl
      exact h1.trans (h2.trans h3)
    exact (congrArg (fun f => f.base pt_L) hs_lift_eq).trans hs_pt_q
  
  have weil_algClosed_integralClosure_finite_of_finiteType_domain :
      ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
        (K₀ : Type u) [Field K₀] [Algebra A K₀] [IsFractionRing A K₀]
        (L : Type u) [Field L] [Algebra A L] [Algebra K₀ L] [IsScalarTower A K₀ L]
        [FiniteDimensional K₀ L],
        Module.Finite A ↥(integralClosure A L) := by
    clear weil_generic_etale_galois_splitting_points hEtD hFinD hW W p D s hProjB₀ hIntB₀ B₀
    intro A _ _ _ _ K₀ _ _ _ L _ _ _ _ _
    obtain ⟨d, g, hg_inj, hg_fin⟩ := exists_finite_inj_algHom_of_fg k A
    let P := MvPolynomial (Fin d) k
    let _ : Algebra P A := g.toRingHom.toAlgebra
    have hFin_PA : Module.Finite P A := RingHom.finite_algebraMap.mp hg_fin
    have hInt_PA : Algebra.IsIntegral P A :=
      (Algebra.finite_iff_isIntegral_and_finiteType.mp hFin_PA).1
    let _ : Algebra P K₀ := ((algebraMap A K₀).comp g.toRingHom).toAlgebra
    let _ : Algebra P L := ((algebraMap A L).comp g.toRingHom).toAlgebra
    have _ : IsScalarTower P A K₀ := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower P A L := IsScalarTower.of_algebraMap_eq' rfl
    let K_P := FractionRing P
    have hInj_PK₀ : Function.Injective (algebraMap P K₀) :=
      (IsFractionRing.injective A K₀).comp hg_inj
    let φ_KP_K₀ : K_P →+* K₀ :=
      IsFractionRing.lift (K := K_P) (g := algebraMap P K₀) hInj_PK₀
    let _ : Algebra K_P K₀ := φ_KP_K₀.toAlgebra
    have _ : IsScalarTower P K_P K₀ := IsScalarTower.of_algebraMap_eq (fun x => by
      change algebraMap P K₀ x = φ_KP_K₀ (algebraMap P K_P x)
      exact (IsFractionRing.lift_algebraMap hInj_PK₀ x).symm)
    let _ : Algebra K_P L := ((algebraMap K₀ L).comp φ_KP_K₀).toAlgebra
    have _ : IsScalarTower K_P K₀ L := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower P K_P L := IsScalarTower.of_algebraMap_eq (fun x => by
      change algebraMap P L x = algebraMap K₀ L (algebraMap K_P K₀ (algebraMap P K_P x))
      rw [← IsScalarTower.algebraMap_apply P K_P K₀, IsScalarTower.algebraMap_apply P A K₀,
        IsScalarTower.algebraMap_apply P A L, IsScalarTower.algebraMap_apply A K₀ L])
    have h_div_P : ∀ (b : A), b ≠ 0 → ∃ p₀ : P, p₀ ≠ 0 ∧ b ∣ algebraMap P A p₀ := by
      intro b hb_ne
      obtain ⟨q₀, hq₀_monic, hq₀_eval⟩ := Algebra.IsIntegral.isIntegral (R := P) b
      have h_aux : ∀ (n : ℕ) (q : Polynomial P),
          q.natDegree ≤ n → q ≠ 0 → Polynomial.aeval b q = 0 →
          ∃ p₀ : P, p₀ ≠ 0 ∧ b ∣ algebraMap P A p₀ := by
        intro n
        induction n with
        | zero =>
          intro q hdeg hq_ne hq_ev
          have hd0 : q.natDegree = 0 := Nat.eq_zero_of_le_zero hdeg
          rw [Polynomial.eq_C_of_natDegree_eq_zero hd0] at hq_ne hq_ev
          refine ⟨q.coeff 0, fun h0 => hq_ne (by rw [h0, map_zero]), 0, ?_⟩
          rw [mul_zero]
          simpa using hq_ev
        | succ n ih =>
          intro q hdeg hq_ne hq_ev
          by_cases hc0 : q.coeff 0 = 0
          · have hq_fac : Polynomial.X * q.divX = q := by
              simpa [hc0] using Polynomial.X_mul_divX_add q
            have hdiv_ne : q.divX ≠ 0 := fun h0 => hq_ne (by rw [← hq_fac, h0, mul_zero])
            have h_ev_div : Polynomial.aeval b q.divX = 0 := by
              have h_mul : b * Polynomial.aeval b q.divX = 0 := by
                calc b * Polynomial.aeval b q.divX
                  _ = Polynomial.aeval b (Polynomial.X * q.divX) := by simp
                  _ = Polynomial.aeval b q := by rw [hq_fac]
                  _ = 0 := hq_ev
              exact (mul_eq_zero.mp h_mul).resolve_left hb_ne
            have hdeg_pos : 0 < q.natDegree := by
              by_contra hle
              have hd0 : q.natDegree = 0 := Nat.eq_zero_of_not_pos hle
              exact hq_ne (by rw [Polynomial.eq_C_of_natDegree_eq_zero hd0, hc0, map_zero])
            have hdeg_div : q.divX.natDegree ≤ n := by
              rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
              omega
            exact ih q.divX hdeg_div hdiv_ne h_ev_div
          · refine ⟨q.coeff 0, hc0, -(Polynomial.aeval b q.divX), ?_⟩
            have h_sum : b * Polynomial.aeval b q.divX + algebraMap P A (q.coeff 0) = 0 := by
              have h_ev2 := congrArg (Polynomial.aeval b) (Polynomial.X_mul_divX_add q).symm
              rw [hq_ev, map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at h_ev2
              exact h_ev2.symm
            linear_combination h_sum
      exact h_aux q₀.natDegree q₀ le_rfl hq₀_monic.ne_zero hq₀_eval
    have _ : FiniteDimensional K_P K₀ := by
      classical
      obtain ⟨S_gen, hS_gen⟩ := Module.finite_def.mp hFin_PA
      refine Module.finite_def.mpr ⟨S_gen.image (algebraMap A K₀), le_antisymm le_top ?_⟩
      intro z _
      obtain ⟨a, b, hb_mem, rfl⟩ := IsFractionRing.div_surjective (A := A) z
      have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
      obtain ⟨p₀, hp₀_ne, c_mul, hc_mul⟩ := h_div_P b hb_ne
      have h_span_map : ∀ x : A, algebraMap A K₀ x ∈
          Submodule.span K_P (↑(S_gen.image (algebraMap A K₀)) : Set K₀) := by
        intro x
        have hx_mem : x ∈ Submodule.span P (S_gen : Set A) := hS_gen ▸ Submodule.mem_top
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hx_mem
        · intro s hs
          exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hs))
        · simp
        · intro u v _ _ hu hv
          rw [map_add]
          exact add_mem hu hv
        · intro r u _ hu
          have h_smul : algebraMap A K₀ (r • u) = (algebraMap P K_P r) • algebraMap A K₀ u := by
            rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply P A K₀,
              IsScalarTower.algebraMap_apply P K_P K₀, Algebra.smul_def]
          rw [h_smul]
          exact Submodule.smul_mem _ _ hu
      have hp₀_K₀_ne : algebraMap P K₀ p₀ ≠ 0 :=
        fun h0 => hp₀_ne (hInj_PK₀ (h0.trans (map_zero _).symm))
      have hb_K₀_ne : algebraMap A K₀ b ≠ 0 :=
        fun h0 => hb_ne ((IsFractionRing.injective A K₀) (h0.trans (map_zero _).symm))
      have h_eq_z : algebraMap A K₀ a / algebraMap A K₀ b =
          (algebraMap P K_P p₀)⁻¹ • algebraMap A K₀ (a * c_mul) := by
        rw [Algebra.smul_def, map_inv₀, ← IsScalarTower.algebraMap_apply P K_P K₀,
          show algebraMap P K₀ p₀ = algebraMap A K₀ (algebraMap P A p₀) from
            IsScalarTower.algebraMap_apply P A K₀ p₀,
