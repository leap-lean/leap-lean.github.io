          (p j.castSucc).isClosed (U_F a).isOpen.isClosed_compl hcov_union) with h₁ | h₂
        · exact not_le_of_gt hstep h₁
        · exact h₂ (p.monotone (Fin.zero_le j.succ) hx₀) hx₀_U
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(U_F a)) :=
        RelSeries.mk p.length c (fun j => hc_strict j)
      have hlen : (p.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥(U_F a) :=
        Order.LTSeries.length_le_krullDim q
      rwa [hDim_UF a] at hlen
    · calc (1 : WithBot ℕ∞)
          = topologicalKrullDim ↥(U_F 0) := (hDim_UF 0).symm
        _ ≤ topologicalKrullDim
              ↥(AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) F)) :=
            topologicalKrullDim_subspace_le _ _

  
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
    MvPolynomial.gradedAlgebra
  let P₁ := weilProjectiveSpaceOver k 1
  let p₀ : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) k) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k) := P₁.hom
  refine ⟨?_, ?_⟩
  · let U₀ : Fin 2 → (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) k)).Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X a)
    have hCov₀ : iSup U₀ = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top
        (MvPolynomial.homogeneousSubmodule (Fin 2) k) MvPolynomial.X (hIrrel k)
    refine hSmoothCover k (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) k))
      p₀ U₀ hCov₀ ?_
    intro a
    obtain ⟨e_a, he_C, hXa1, _, _⟩ := hEquiv k a (MvPolynomial.X a) rfl
    let iso_spec := AlgebraicGeometry.Proj.basicOpenIsoSpec
      (MvPolynomial.homogeneousSubmodule (Fin 2) k) (MvPolynomial.X a) hXa1 zero_lt_one
    let iso_ring := CategoryTheory.asIso (AlgebraicGeometry.Spec.map e_a.toCommRingCatIso.hom)
    refine ⟨iso_spec ≪≫ iso_ring, ?_⟩
    rw [← CategoryTheory.cancel_epi iso_spec.inv]
    have h_lhs : iso_spec.inv ≫ (U₀ a).ι ≫ p₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin 2) k)
            (Submonoid.powers (MvPolynomial.X a))).comp
              (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin 2) k 0)))) := by
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
      change AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) k)
        (MvPolynomial.X a) hXa1 zero_lt_one ≫
        AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) k) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin 2) k 0))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    rw [h_lhs]
    have h_rhs : iso_spec.inv ≫ (iso_spec ≪≫ iso_ring).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C ≫ e_a.toCommRingCatIso.hom) := by
      dsimp only [CategoryTheory.Iso.trans_hom, iso_ring, CategoryTheory.asIso_hom]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
        ← AlgebraicGeometry.Spec.map_comp]
    rw [h_rhs]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact (he_C c).symm
  · intro K _ α
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) :=
      MvPolynomial.gradedAlgebra
    let φ : k →+* K := (AlgebraicGeometry.Spec.preimage α).hom
    have hα : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = α := by
      rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
    obtain ⟨e₀⟩ := hProjBaseIso K φ
    let e_bc : AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≅
        CategoryTheory.Limits.pullback P₁.hom α :=
      e₀ ≪≫ CategoryTheory.Limits.pullback.congrHom rfl hα
    let homeo_bc :
        ↥(AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)) ≃ₜ
          ↥(CategoryTheory.Limits.pullback P₁.hom α) :=
      AlgebraicGeometry.Scheme.homeoOfIso e_bc
    obtain ⟨hIrred_K, hDim_K⟩ := hProjIrredDim K
    haveI := hIrred_K
    obtain ⟨x_K⟩ : Nonempty
        ↥(AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K)) :=
      IrreducibleSpace.toNonempty
    refine ⟨?_, ?_⟩
    · refine
        { isPreirreducible_univ := ?_
          toNonempty := ⟨homeo_bc x_K⟩ }
      rw [← Set.image_univ_of_surjective homeo_bc.surjective]
      exact PreirreducibleSpace.isPreirreducible_univ.image
        homeo_bc homeo_bc.continuous.continuousOn
    · rw [← homeo_bc.isHomeomorph.topologicalKrullDim_eq]
      exact hDim_K

theorem weil_pointCenter_incidence_blowup_package (k : Type u) [Field k] (m : ℕ) (hm : 1 ≤ m) :
    let P_amb := weilProjectiveSpaceOver k (m + 1)
    let B₀ := weilProjectiveSpaceOver k m
    let U_proj := weilProjCenterComplOpen k m
    ∃ (pr_p₀ : (U_proj : AlgebraicGeometry.Scheme.{u}) ⟶ B₀.left)
      (P_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (p₁ : P_tilde ⟶ P_amb)
      (p₂ : P_tilde ⟶ B₀)
      (ε_p₀ : B₀ ⟶ P_tilde),
      IsCenterComplLinearProjection k m pr_p₀ ∧
      Nonempty U_proj ∧
      AlgebraicGeometry.IsIntegral P_tilde.left ∧
      IsProjectiveOverField k P_tilde ∧
      AlgebraicGeometry.IsProper p₁.left ∧
      AlgebraicGeometry.IsProper p₂.left ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 p₂.left ∧
      ∃ (hIso_p₁ : CategoryTheory.IsIso (p₁.left ∣_ U_proj)),
        (@CategoryTheory.inv _ _ _ _ (p₁.left ∣_ U_proj) hIso_p₁ ≫
          (p₁.left ⁻¹ᵁ U_proj).ι ≫ p₂.left = pr_p₀) ∧
        (ε_p₀ ≫ p₂ = 𝟙 B₀) ∧
        (∀ (g_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P_amb.left),
          g_pt ≫ P_amb.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
          Set.range g_pt.base ⊆ ((U_proj : Set P_amb.left)ᶜ) →
          B₀.hom ≫ g_pt = ε_p₀.left ≫ p₁.left) ∧
        (∀ (K : Type u) [Field K] [IsAlgClosed K]
            (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₀.left),
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback p₂.left s) ∧
          topologicalKrullDim ↥(CategoryTheory.Limits.pullback p₂.left s) = (1 : WithBot ℕ∞) ∧
          ∃ z₀ : ↥(CategoryTheory.Limits.pullback p₂.left s),
            p₁.left.base ((CategoryTheory.Limits.pullback.fst p₂.left s).base z₀) ∉ U_proj) :=
by
  let _ := hm
  have hProperProj :
      ∀ (N : ℕ), AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) hSurj0
    dsimp [weilProjectiveSpaceOver]
    infer_instance

  let P_amb := weilProjectiveSpaceOver k (m + 1)
  let B₀ := weilProjectiveSpaceOver k m
  let P₁ := weilProjectiveSpaceOver k 1
  let U_proj := weilProjCenterComplOpen k m

  haveI : AlgebraicGeometry.IsProper P_amb.hom := hProperProj (m + 1)
  haveI : AlgebraicGeometry.IsProper B₀.hom := hProperProj m
  have hProjPamb : IsProjectiveOverField k P_amb :=
    ⟨m + 1, 𝟙 P_amb, by change AlgebraicGeometry.IsClosedImmersion (𝟙 _); infer_instance⟩
  have hProjB₀ : IsProjectiveOverField k B₀ :=
    ⟨m, 𝟙 B₀, by change AlgebraicGeometry.IsClosedImmersion (𝟙 _); infer_instance⟩

  obtain ⟨hCovB₀, hUproj, hCompU, hIntU, pr_p₀, p₀_pt, hPr, hp₀_hom, hp₀_range, hp₀_uniq⟩ :=
    weil_projCenterCompl_linearProjection_and_point_unique k m
  obtain ⟨hSmP₁, hFibP₁⟩ := weil_projLine_smooth_and_baseChange_krullDim_one k

  have hg_comm : U_proj.ι ≫ P_amb.hom = pr_p₀ ≫ B₀.hom := hPr.1.symm
  let Q := CategoryTheory.Limits.pullback P_amb.hom B₀.hom
  let γ : (U_proj : AlgebraicGeometry.Scheme.{u}) ⟶ Q :=
    CategoryTheory.Limits.pullback.lift U_proj.ι pr_p₀ hg_comm
  let Z_tilde : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.image γ
  let ι_inc : Z_tilde ⟶ Q := AlgebraicGeometry.Scheme.Hom.imageι γ
  haveI : AlgebraicGeometry.IsClosedImmersion ι_inc := by
    dsimp [ι_inc]
    infer_instance
  let p₁_left : Z_tilde ⟶ P_amb.left :=
    ι_inc ≫ CategoryTheory.Limits.pullback.fst P_amb.hom B₀.hom
  let p₂_left : Z_tilde ⟶ B₀.left :=
    ι_inc ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom
  let P_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (p₁_left ≫ P_amb.hom)
  let p₁ : P_tilde ⟶ P_amb := CategoryTheory.Over.homMk p₁_left rfl
  have hp₂_w : p₂_left ≫ B₀.hom = P_tilde.hom := by
    change (ι_inc ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ≫ B₀.hom =
      (ι_inc ≫ CategoryTheory.Limits.pullback.fst P_amb.hom B₀.hom) ≫ P_amb.hom
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition]
  let p₂ : P_tilde ⟶ B₀ := CategoryTheory.Over.homMk p₂_left hp₂_w

  haveI : CompactSpace ↥(U_proj : AlgebraicGeometry.Scheme.{u}) := hCompU
  obtain ⟨hIntPt, hProp_p₁, hProp_p₂, hKerRestr, hIso_p₁, hComp_pr⟩ :=
    weil_schematicImage_graph_openIso_and_isIntegral
      (AlgebraicGeometry.Spec (CommRingCat.of k)) P_amb.left B₀.left
      P_amb.hom B₀.hom U_proj hIntU pr_p₀ hg_comm

  let S_k : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
  let g₁_k : P_amb ⟶ S_k :=
    CategoryTheory.Over.homMk P_amb.hom (CategoryTheory.Category.comp_id P_amb.hom)
  let g₂_k : B₀ ⟶ S_k :=
    CategoryTheory.Over.homMk B₀.hom (CategoryTheory.Category.comp_id B₀.hom)
  haveI : AlgebraicGeometry.IsSeparated S_k.hom := by
    change AlgebraicGeometry.IsSeparated (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    infer_instance
  obtain ⟨N_Q, ι_Q, hCl_Q⟩ :=
    weil_projectiveOverField_pullback_of_isSeparated k P_amb B₀ S_k g₁_k g₂_k hProjPamb hProjB₀
  let j_inc : P_tilde ⟶
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.fst g₁_k.left g₂_k.left ≫ P_amb.hom) :=
    CategoryTheory.Over.homMk ι_inc (CategoryTheory.Category.assoc _ _ _).symm
  have hProjPt : IsProjectiveOverField k P_tilde := by
    haveI : AlgebraicGeometry.IsClosedImmersion j_inc.left := by
      change AlgebraicGeometry.IsClosedImmersion ι_inc
      infer_instance
    haveI : AlgebraicGeometry.IsClosedImmersion ι_Q.left := hCl_Q
    refine ⟨N_Q, j_inc ≫ ι_Q, ?_⟩
    change AlgebraicGeometry.IsClosedImmersion (j_inc.left ≫ ι_Q.left)
    infer_instance

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let D₀ : Fin (m + 1) → B₀.left.Opens := fun b =>
    AlgebraicGeometry.Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) (MvPolynomial.X b)
  have hCovB₀' : (⨆ b : Fin (m + 1), D₀ b) = (⊤ : B₀.left.Opens) := hCovB₀
  let Q_open : Fin (m + 1) → Q.Opens := fun b =>
    (CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ⁻¹ᵁ D₀ b
  let W_open : Fin (m + 1) → P_tilde.left.Opens := fun b => p₂.left ⁻¹ᵁ D₀ b
  let E_open : Fin (m + 1) → AlgebraicGeometry.Scheme.{u} := fun b =>
    CategoryTheory.Limits.pullback ((D₀ b).ι ≫ B₀.hom) P₁.hom

  have hε_tilde_cond : (B₀.hom ≫ p₀_pt) ≫ P_amb.hom = 𝟙 B₀.left ≫ B₀.hom := by
    rw [CategoryTheory.Category.assoc, hp₀_hom, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.id_comp]
  let ε_tilde : B₀.left ⟶ Q :=
    CategoryTheory.Limits.pullback.lift (B₀.hom ≫ p₀_pt) (𝟙 B₀.left) hε_tilde_cond

  have hChart : ∀ b : Fin (m + 1),
      ∃ (ψ_b : E_open b ⟶ (W_open b : AlgebraicGeometry.Scheme.{u}))
        (ε_b : (D₀ b : AlgebraicGeometry.Scheme.{u}) ⟶ P_tilde.left),
        CategoryTheory.IsIso ψ_b ∧
        (ψ_b ≫ (p₂.left ∣_ D₀ b) =
          CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) ∧
        (ε_b ≫ ι_inc = (D₀ b).ι ≫ ε_tilde) := by
    intro b
    obtain ⟨Φ_b, p₀_b, s_b, hCl_Φ, hΦ_snd, hKer_b, hp₀b_hom, hp₀b_range, hs_fst, hs_p₀b⟩ :=
      weil_pointCenter_blowup_chart_trivialization k m pr_p₀ hPr hg_comm b
    have hp₀_eq : p₀_b = p₀_pt := hp₀_uniq p₀_b hp₀b_hom hp₀b_range
    haveI : AlgebraicGeometry.IsClosedImmersion Φ_b := hCl_Φ
    have hKer_eq : AlgebraicGeometry.Scheme.Hom.ker (ι_inc ∣_ Q_open b) =
        AlgebraicGeometry.Scheme.Hom.ker Φ_b :=
      (hKerRestr (Q_open b)).trans hKer_b
    let ψ_b₀ := AlgebraicGeometry.IsClosedImmersion.lift (ι_inc ∣_ Q_open b) Φ_b hKer_eq.le
    have hIso_ψ₀ : CategoryTheory.IsIso ψ_b₀ :=
      AlgebraicGeometry.IsClosedImmersion.isIso_lift (ι_inc ∣_ Q_open b) Φ_b hKer_eq
    have hψ_fac : ψ_b₀ ≫ (ι_inc ∣_ Q_open b) = Φ_b :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac (ι_inc ∣_ Q_open b) Φ_b hKer_eq.le
    let ψ_b : E_open b ⟶ (W_open b : AlgebraicGeometry.Scheme.{u}) := ψ_b₀
    have hIso_ψ : CategoryTheory.IsIso ψ_b := hIso_ψ₀
    have hψ_p₂ : ψ_b ≫ (p₂.left ∣_ D₀ b) =
        CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom := by
      rw [← CategoryTheory.cancel_mono (D₀ b).ι]
      have h1 : ψ_b ≫ ((p₂.left ∣_ D₀ b) ≫ (D₀ b).ι) =
          ψ_b₀ ≫ (((ι_inc ⁻¹ᵁ Q_open b).ι ≫ ι_inc) ≫
            CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) := by
        rw [AlgebraicGeometry.morphismRestrict_ι p₂.left (D₀ b), CategoryTheory.Category.assoc]
        rfl
      calc (ψ_b ≫ (p₂.left ∣_ D₀ b)) ≫ (D₀ b).ι
          = ψ_b ≫ ((p₂.left ∣_ D₀ b) ≫ (D₀ b).ι) := CategoryTheory.Category.assoc _ _ _
        _ = ψ_b₀ ≫ (((ι_inc ⁻¹ᵁ Q_open b).ι ≫ ι_inc) ≫
              CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) := h1
        _ = ψ_b₀ ≫ (((ι_inc ∣_ Q_open b) ≫ (Q_open b).ι) ≫
              CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) := by
            rw [← AlgebraicGeometry.morphismRestrict_ι ι_inc (Q_open b)]
        _ = (ψ_b₀ ≫ (ι_inc ∣_ Q_open b)) ≫
              ((Q_open b).ι ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) := by
            rw [CategoryTheory.Category.assoc (ι_inc ∣_ Q_open b),
              ← CategoryTheory.Category.assoc ψ_b₀]
        _ = (Φ_b ≫ (CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom ∣_ D₀ b)) ≫ (D₀ b).ι := by
            rw [hψ_fac, ← AlgebraicGeometry.morphismRestrict_ι
              (CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) (D₀ b),
              CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom ≫ (D₀ b).ι := by
            rw [hΦ_snd]
    let ε_b : (D₀ b : AlgebraicGeometry.Scheme.{u}) ⟶ P_tilde.left :=
      s_b ≫ ψ_b ≫ (W_open b).ι
    have hε_b_inc : ε_b ≫ ι_inc = (D₀ b).ι ≫ ε_tilde := by
      have hs_inc : ε_b ≫ ι_inc = s_b ≫ Φ_b ≫ (Q_open b).ι := by
        calc (s_b ≫ ψ_b ≫ (W_open b).ι) ≫ ι_inc
            = s_b ≫ (ψ_b₀ ≫ ((ι_inc ⁻¹ᵁ Q_open b).ι ≫ ι_inc)) := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
                rfl
          _ = s_b ≫ (ψ_b₀ ≫ ((ι_inc ∣_ Q_open b) ≫ (Q_open b).ι)) := by
                rw [← AlgebraicGeometry.morphismRestrict_ι ι_inc (Q_open b)]
          _ = s_b ≫ ((ψ_b₀ ≫ (ι_inc ∣_ Q_open b)) ≫ (Q_open b).ι) := by
                rw [← CategoryTheory.Category.assoc ψ_b₀]
          _ = s_b ≫ Φ_b ≫ (Q_open b).ι := by rw [hψ_fac]
      rw [hs_inc]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [hs_p₀b, hp₀_eq, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst]
      · calc (s_b ≫ Φ_b ≫ (Q_open b).ι) ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom
            = s_b ≫ (Φ_b ≫ ((Q_open b).ι ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom)) := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
          _ = s_b ≫ (Φ_b ≫ ((CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom ∣_ D₀ b) ≫
                (D₀ b).ι)) := by
                rw [← AlgebraicGeometry.morphismRestrict_ι
                  (CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) (D₀ b)]
          _ = s_b ≫ ((Φ_b ≫ (CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom ∣_ D₀ b)) ≫
                (D₀ b).ι) := by
                rw [← CategoryTheory.Category.assoc Φ_b]
          _ = (s_b ≫ CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) ≫ (D₀ b).ι := by
                rw [hΦ_snd, ← CategoryTheory.Category.assoc]
          _ = (D₀ b).ι := by rw [hs_fst, CategoryTheory.Category.id_comp]
          _ = ((D₀ b).ι ≫ ε_tilde) ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  CategoryTheory.Category.comp_id]
    exact ⟨ψ_b, ε_b, hIso_ψ, hψ_p₂, hε_b_inc⟩

  have hSm_Wb : ∀ b : Fin (m + 1),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 ((W_open b).ι ≫ p₂.left) := by
    intro b
    obtain ⟨ψ_b, _, hIso_ψ, hψ_p₂, _⟩ := hChart b
    haveI : CategoryTheory.IsIso ψ_b := hIso_ψ
    have hEq : (W_open b).ι ≫ p₂.left =
        CategoryTheory.inv ψ_b ≫
          CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom ≫ (D₀ b).ι := by
      calc (W_open b).ι ≫ p₂.left
          = (p₂.left ∣_ D₀ b) ≫ (D₀ b).ι :=
              (AlgebraicGeometry.morphismRestrict_ι p₂.left (D₀ b)).symm
        _ = (CategoryTheory.inv ψ_b ≫ ψ_b) ≫ (p₂.left ∣_ D₀ b) ≫ (D₀ b).ι := by
              rw [CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = CategoryTheory.inv ψ_b ≫
              (ψ_b ≫ (p₂.left ∣_ D₀ b)) ≫ (D₀ b).ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.inv ψ_b ≫
              CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom ≫ (D₀ b).ι := by
              rw [hψ_p₂]
    rw [hEq]
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 0 (CategoryTheory.inv ψ_b) :=
      inferInstance
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) :=
      (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback ((D₀ b).ι ≫ B₀.hom) P₁.hom).flip hSmP₁
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 0 (D₀ b).ι := inferInstance
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension (1 + 0)
        (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom ≫ (D₀ b).ι) :=
      inferInstance
    have h_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (1 + 0))
        (CategoryTheory.inv ψ_b ≫
          CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom ≫ (D₀ b).ι) :=
      inferInstance
    simpa using h_comp

  have hSm_p₂ : AlgebraicGeometry.SmoothOfRelativeDimension 1 p₂.left := by
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro z
    have hz_top : p₂.left.base z ∈ (⊤ : B₀.left.Opens) := trivial
    rw [← hCovB₀', TopologicalSpace.Opens.mem_iSup] at hz_top
    obtain ⟨b, hzb⟩ := hz_top
    have hzW : z ∈ W_open b := hzb
    have h₀ := hSm_Wb b
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at h₀
    obtain ⟨U, hAffU, V₀, hAffV₀, hzV₀, e₀, hStd₀⟩ := h₀ ⟨z, hzW⟩
    let j := (W_open b).ι
    let V : P_tilde.left.Opens := j ''ᵁ V₀
    have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffV₀.image_of_isOpenImmersion j
    have hzV : z ∈ V := ⟨⟨z, hzW⟩, hzV₀, AlgebraicGeometry.Scheme.Opens.ι_apply (W_open b) ⟨z, hzW⟩⟩
    have e : V ≤ p₂.left ⁻¹ᵁ U := by
      rintro _ ⟨w, hw, rfl⟩
      exact e₀ hw
    have hpre_eq : j ⁻¹ᵁ V = V₀ := by
      ext w
      refine ⟨?_, fun hw => ⟨w, hw, rfl⟩⟩
      rintro ⟨w', hw', hEq⟩
      cases j.isOpenEmbedding.injective hEq
      exact hw'
    have hIso_app : CategoryTheory.IsIso (j.app V) :=
      AlgebraicGeometry.PresheafedSpace.IsOpenImmersion.c_iso V₀
    have hIso_map : CategoryTheory.IsIso
        ((W_open b).toScheme.presheaf.map (CategoryTheory.homOfLE hpre_eq.ge).op) := by
      have : CategoryTheory.IsIso (CategoryTheory.homOfLE hpre_eq.ge).op :=
        ⟨⟨(CategoryTheory.homOfLE hpre_eq.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
      infer_instance
    have hIso_j : CategoryTheory.IsIso (j.appLE V V₀ hpre_eq.ge) := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_app hIso_map
    refine ⟨U, hAffU, V, hAffV, hzV, e, ?_⟩
    let φ := p₂.left.appLE U V e
    let ψ := j.appLE V V₀ hpre_eq.ge
    have hcomp : φ ≫ ψ = (j ≫ p₂.left).appLE U V₀ e₀ :=
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j p₂.left U V V₀ e hpre_eq.ge
    have hφ_eq : φ = (j ≫ p₂.left).appLE U V₀ e₀ ≫ @CategoryTheory.inv _ _ _ _ ψ hIso_j := by
      haveI := hIso_j
      rw [← hcomp, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
        CategoryTheory.Category.comp_id]
    let e_ring : ↑((W_open b).toScheme.presheaf.obj (Opposite.op V₀)) ≃+*
        ↑(P_tilde.left.presheaf.obj (Opposite.op V)) :=
      (@CategoryTheory.asIso _ _ _ _ ψ hIso_j).symm.commRingCatIsoToRingEquiv
    have h_std' : RingHom.IsStandardSmoothOfRelativeDimension 1
        (e_ring.toRingHom.comp ((j ≫ p₂.left).appLE U V₀ e₀).hom) :=
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _ e_ring hStd₀
    have hhom : φ.hom = e_ring.toRingHom.comp ((j ≫ p₂.left).appLE U V₀ e₀).hom := by
      rw [hφ_eq, CommRingCat.hom_comp]
      rfl
    rwa [hhom]

  let 𝒰₀ := B₀.left.openCoverOfIsOpenCover D₀ (TopologicalSpace.IsOpenCover.mk hCovB₀')
  let ε_loc : ∀ b : 𝒰₀.I₀, 𝒰₀.X b ⟶ P_tilde.left :=
    fun b => (hChart b).choose_spec.choose
  have hε_loc_inc : ∀ b : 𝒰₀.I₀, ε_loc b ≫ ι_inc = 𝒰₀.f b ≫ ε_tilde :=
    fun b => (hChart b).choose_spec.choose_spec.2.2
  have hε_glue : ∀ (b₁ b₂ : 𝒰₀.I₀),
      CategoryTheory.Limits.pullback.fst (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ ε_loc b₁ =
        CategoryTheory.Limits.pullback.snd (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ ε_loc b₂ := by
    intro b₁ b₂
    rw [← CategoryTheory.cancel_mono ι_inc]
    calc (CategoryTheory.Limits.pullback.fst (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ ε_loc b₁) ≫ ι_inc
        = CategoryTheory.Limits.pullback.fst (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ (ε_loc b₁ ≫ ι_inc) :=
            CategoryTheory.Category.assoc _ _ _
      _ = (CategoryTheory.Limits.pullback.fst (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ 𝒰₀.f b₁) ≫ ε_tilde := by
            rw [hε_loc_inc b₁, ← CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Limits.pullback.snd (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ 𝒰₀.f b₂) ≫ ε_tilde := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = CategoryTheory.Limits.pullback.snd (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ (ε_loc b₂ ≫ ι_inc) := by
            rw [CategoryTheory.Category.assoc, ← hε_loc_inc b₂]
      _ = (CategoryTheory.Limits.pullback.snd (𝒰₀.f b₁) (𝒰₀.f b₂) ≫ ε_loc b₂) ≫ ι_inc :=
            (CategoryTheory.Category.assoc _ _ _).symm
  let ε_left : B₀.left ⟶ P_tilde.left := 𝒰₀.glueMorphisms ε_loc hε_glue
  have hε_inc : ε_left ≫ ι_inc = ε_tilde := by
    apply 𝒰₀.hom_ext
    intro b
    calc (𝒰₀.f b ≫ ε_left) ≫ ι_inc
        = ε_loc b ≫ ι_inc := by
            rw [AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰₀ ε_loc hε_glue b]
      _ = 𝒰₀.f b ≫ ε_tilde := hε_loc_inc b
  have hε_p₁ : ε_left ≫ p₁.left = B₀.hom ≫ p₀_pt := by
    change ε_left ≫ ι_inc ≫ CategoryTheory.Limits.pullback.fst P_amb.hom B₀.hom = B₀.hom ≫ p₀_pt
    rw [← CategoryTheory.Category.assoc, hε_inc, CategoryTheory.Limits.pullback.lift_fst]
  have hε_p₂ : ε_left ≫ p₂.left = 𝟙 B₀.left := by
    change ε_left ≫ ι_inc ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom = 𝟙 B₀.left
    rw [← CategoryTheory.Category.assoc, hε_inc, CategoryTheory.Limits.pullback.lift_snd]
  have hε_w : ε_left ≫ P_tilde.hom = B₀.hom := by
    change ε_left ≫ p₁.left ≫ P_amb.hom = B₀.hom
    rw [← CategoryTheory.Category.assoc, hε_p₁, CategoryTheory.Category.assoc, hp₀_hom,
      CategoryTheory.Category.comp_id]
  let ε_p₀ : B₀ ⟶ P_tilde := CategoryTheory.Over.homMk ε_left hε_w
  have hSec_ε : ε_p₀ ≫ p₂ = 𝟙 B₀ := by
    ext : 1
    exact hε_p₂

  refine ⟨pr_p₀, P_tilde, p₁, p₂, ε_p₀,
    hPr, hUproj, hIntPt, hProjPt, hProp_p₁, hProp_p₂, hSm_p₂,
    hIso_p₁, hComp_pr, hSec_ε, ?_, ?_⟩
  · intro g_pt hg_hom hg_range
    rw [hp₀_uniq g_pt hg_hom hg_range]
    exact hε_p₁.symm
  · intro K _ _ s
    let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := default
    have hs_top : s.base pt_K ∈ (⊤ : B₀.left.Opens) := trivial
    rw [← hCovB₀', TopologicalSpace.Opens.mem_iSup] at hs_top
    obtain ⟨b, hsb⟩ := hs_top
    have hs_range : Set.range s.base ⊆ Set.range (D₀ b).ι.base := by
      rintro _ ⟨x, rfl⟩
      rw [(D₀ b).range_ι, Subsingleton.elim x pt_K]
      exact hsb
    let s_D : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (D₀ b : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift (D₀ b).ι s hs_range
    have hs_D : s_D ≫ (D₀ b).ι = s :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (D₀ b).ι s hs_range
    obtain ⟨ψ_b, _, hIso_ψ, hψ_p₂, _⟩ := hChart b
    haveI : CategoryTheory.IsIso ψ_b := hIso_ψ

    let α : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) := s ≫ B₀.hom
    let L_α := CategoryTheory.Limits.pullback P₁.hom α
    let fst_L := CategoryTheory.Limits.pullback.fst P₁.hom α
    let snd_L := CategoryTheory.Limits.pullback.snd P₁.hom α
    let fst_E := CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom
    let snd_E := CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom
    have hu_cond : (snd_L ≫ s_D) ≫ ((D₀ b).ι ≫ B₀.hom) = fst_L ≫ P₁.hom := by
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc s_D, hs_D]
      exact CategoryTheory.Limits.pullback.condition.symm
    let u : L_α ⟶ E_open b :=
      CategoryTheory.Limits.pullback.lift (snd_L ≫ s_D) fst_L hu_cond
    have sq_right : CategoryTheory.IsPullback snd_E fst_E P₁.hom ((D₀ b).ι ≫ B₀.hom) :=
      (CategoryTheory.IsPullback.of_hasPullback ((D₀ b).ι ≫ B₀.hom) P₁.hom).flip
    have hu_fst : u ≫ fst_E = snd_L ≫ s_D := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hu_snd : u ≫ snd_E = fst_L := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have sq₁ : CategoryTheory.IsPullback u snd_L fst_E s_D := by
      rw [← CategoryTheory.IsPullback.paste_horiz_iff sq_right hu_fst]
      have h_bot : s_D ≫ ((D₀ b).ι ≫ B₀.hom) = α := by
        rw [← CategoryTheory.Category.assoc, hs_D]
      rw [hu_snd, h_bot]
      exact CategoryTheory.IsPullback.of_hasPullback P₁.hom α
    have sq₂ : CategoryTheory.IsPullback ψ_b fst_E (p₂.left ∣_ D₀ b)
        (𝟙 (D₀ b : AlgebraicGeometry.Scheme.{u})) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [hψ_p₂, CategoryTheory.Category.comp_id]⟩
    have sq₃ : CategoryTheory.IsPullback (W_open b).ι (p₂.left ∣_ D₀ b) p₂.left (D₀ b).ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict p₂.left (D₀ b)).flip
    have sq_fib : CategoryTheory.IsPullback ((u ≫ ψ_b) ≫ (W_open b).ι) snd_L p₂.left s := by
      have h_paste := (sq₁.paste_horiz sq₂).paste_horiz sq₃
      rwa [CategoryTheory.Category.comp_id, hs_D] at h_paste

    let e_fib : L_α ≅ CategoryTheory.Limits.pullback p₂.left s := sq_fib.isoPullback
    let homeo_fib : ↥L_α ≃ₜ ↥(CategoryTheory.Limits.pullback p₂.left s) :=
      AlgebraicGeometry.Scheme.homeoOfIso e_fib
    obtain ⟨hIrred_L, hDim_L⟩ := hFibP₁ K α
    haveI : IrreducibleSpace ↥L_α := hIrred_L
    have hPre_univ : IsPreirreducible
        (Set.univ : Set ↥(CategoryTheory.Limits.pullback p₂.left s)) := by
      rw [← Set.image_univ_of_surjective homeo_fib.surjective]
      exact PreirreducibleSpace.isPreirreducible_univ.image
        homeo_fib homeo_fib.continuous.continuousOn
    obtain ⟨x_L⟩ : Nonempty ↥L_α := IrreducibleSpace.toNonempty
    have hIrred_fib : IrreducibleSpace ↥(CategoryTheory.Limits.pullback p₂.left s) :=
      { isPreirreducible_univ := hPre_univ
        toNonempty := ⟨homeo_fib x_L⟩ }
    have hDim_fib : topologicalKrullDim ↥(CategoryTheory.Limits.pullback p₂.left s) =
        (1 : WithBot ℕ∞) := by
      rw [← homeo_fib.isHomeomorph.topologicalKrullDim_eq, hDim_L]

    have hσ_cond : (s ≫ ε_p₀.left) ≫ p₂.left = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ≫ s := by
      change (s ≫ ε_left) ≫ p₂.left = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ≫ s
      rw [CategoryTheory.Category.assoc, hε_p₂, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    let σ_s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        CategoryTheory.Limits.pullback p₂.left s :=
      CategoryTheory.Limits.pullback.lift (s ≫ ε_p₀.left)
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K))) hσ_cond
    refine ⟨hIrred_fib, hDim_fib, σ_s.base pt_K, ?_⟩
    have h_pt_eq : p₁.left.base
        ((CategoryTheory.Limits.pullback.fst p₂.left s).base (σ_s.base pt_K)) =
        p₀_pt.base (α.base pt_K) := by
      change (σ_s ≫ CategoryTheory.Limits.pullback.fst p₂.left s ≫ p₁.left).base pt_K =
        (α ≫ p₀_pt).base pt_K
      rw [← CategoryTheory.Category.assoc σ_s, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.assoc]
      change (s ≫ (ε_left ≫ p₁.left)).base pt_K = (s ≫ B₀.hom ≫ p₀_pt).base pt_K
      rw [hε_p₁]
    rw [h_pt_eq]
    exact hp₀_range ⟨α.base pt_K, rfl⟩

theorem weil_algClosed_noetherian_boundary_div_low_smooth (k : Type u) [Field k] [IsAlgClosed k]
    (m N : ℕ) (hm : 1 ≤ m)
    (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntVn : AlgebraicGeometry.IsIntegral V_norm.left)
    (hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (ι_V : V_norm ⟶ weilProjectiveSpaceOver k N)
    (hClV : AlgebraicGeometry.IsClosedImmersion ι_V.left)
    (Z_closed : Set V_norm.left)
    (hClosedZ : IsClosed Z_closed)
    (hProperZ : Z_closed ≠ Set.univ) :
    ∃ (Z_div : AlgebraicGeometry.Scheme.{u})
      (ι_div : Z_div ⟶ V_norm.left)
      (U_sm_div : Z_div.Opens)
      (Z_low : Set V_norm.left),
      AlgebraicGeometry.IsClosedImmersion ι_div ∧
      AlgebraicGeometry.IsReduced Z_div ∧
      IsClosed Z_low ∧
      (Z_closed = Set.range ι_div.base ∪ Z_low) ∧
      topologicalKrullDim ↥(Set.range ι_div.base) ≤ ((m : ℕ) : WithBot ℕ∞) ∧
      topologicalKrullDim ↥Z_low ≤ ((m - 1 : ℕ) : WithBot ℕ∞) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension m (U_sm_div.ι ≫ ι_div ≫ V_norm.hom) ∧
      topologicalKrullDim ↥(ι_div.base '' ((U_sm_div : Set Z_div)ᶜ)) ≤
        ((m - 1 : ℕ) : WithBot ℕ∞) :=
by
  
  
  
  have hProjNoeth :
      TopologicalSpace.NoetherianSpace ↥V_norm.left ∧
      AlgebraicGeometry.LocallyOfFiniteType V_norm.hom := by
    have : AlgebraicGeometry.IsClosedImmersion ι_V.left := hClV
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    have : AlgebraicGeometry.QuasiCompact (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    have hFT : AlgebraicGeometry.LocallyOfFiniteType V_norm.hom := by
      rw [← CategoryTheory.Over.w ι_V]
      infer_instance
    have : AlgebraicGeometry.QuasiCompact V_norm.hom := by
      rw [← CategoryTheory.Over.w ι_V]
      infer_instance
    have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      AlgebraicGeometry.isNoetherian_Spec.mpr inferInstance
    have : CompactSpace ↥V_norm.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace V_norm.hom
    have : AlgebraicGeometry.IsLocallyNoetherian V_norm.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian V_norm.hom
    have : AlgebraicGeometry.IsNoetherian V_norm.left := AlgebraicGeometry.IsNoetherian.mk
    exact ⟨inferInstance, hFT⟩

  have : TopologicalSpace.NoetherianSpace ↥V_norm.left := hProjNoeth.1
  have : AlgebraicGeometry.LocallyOfFiniteType V_norm.hom := hProjNoeth.2
  have : AlgebraicGeometry.IsIntegral V_norm.left := hIntVn
  have : IrreducibleSpace ↥V_norm.left :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral V_norm.left

  
  
  
  have hPartition :
      ∃ (S_div : Set (Set V_norm.left)) (Z_low : Set V_norm.left),
        S_div.Finite ∧
        (∀ W ∈ S_div, IsClosed W ∧ IsIrreducible W ∧
          topologicalKrullDim ↥W = ((m : ℕ) : WithBot ℕ∞)) ∧
        (∀ W ∈ S_div, ∃ x ∈ W, x ∉ ⋃ W' ∈ S_div \ {W}, W') ∧
        IsClosed (⋃ W ∈ S_div, W) ∧
        IsClosed Z_low ∧
        (Z_closed = (⋃ W ∈ S_div, W) ∪ Z_low) ∧
        topologicalKrullDim ↥(⋃ W ∈ S_div, W) ≤ ((m : ℕ) : WithBot ℕ∞) ∧
        topologicalKrullDim ↥Z_low ≤ ((m - 1 : ℕ) : WithBot ℕ∞) ∧
        (∀ K : Set V_norm.left, IsClosed K → K ⊆ (⋃ W ∈ S_div, W) →
          (∀ W ∈ S_div, W ∩ K ≠ W) →
          topologicalKrullDim ↥K ≤ ((m - 1 : ℕ) : WithBot ℕ∞)) := by
    let X := ↥V_norm.left
    have h_emb_irred : ∀ {Y Z : Type u} [TopologicalSpace Y] [TopologicalSpace Z]
        {f : Y → Z} (hf : Topology.IsEmbedding f) {s : Set Y},
        IsIrreducible (f '' s) → IsIrreducible s := by
      intro Y Z _ _ f hf s hs
      refine ⟨?_, ?_⟩
      · obtain ⟨_, ⟨y, hys, rfl⟩⟩ := hs.nonempty
        exact ⟨y, hys⟩
      · intro u v hu hv ⟨y₁, hy₁s, hy₁u⟩ ⟨y₂, hy₂s, hy₂v⟩
        obtain ⟨U, hU, rfl⟩ := hf.isInducing.isOpen_iff.mp hu
        obtain ⟨V, hV, rfl⟩ := hf.isInducing.isOpen_iff.mp hv
        obtain ⟨_, ⟨y, hys, rfl⟩, hyU, hyV⟩ :=
          hs.isPreirreducible U V hU hV
            ⟨f y₁, ⟨y₁, hy₁s, rfl⟩, hy₁u⟩
            ⟨f y₂, ⟨y₂, hy₂s, rfl⟩, hy₂v⟩
        exact ⟨y, hys, hyU, hyV⟩

    have h_irred_univ : ∀ {W : Set X}, IsIrreducible W → IsIrreducible (Set.univ : Set ↥W) := by
      intro W hW
      apply h_emb_irred Topology.IsEmbedding.subtypeVal
      have h_img : (Subtype.val : ↥W → X) '' Set.univ = W := by
        ext x
        simp
      rwa [h_img]

    have h_strict_drop : ∀ {W A : Set X} {d : ℕ}, 1 ≤ d → IsClosed W → IsIrreducible W →
        topologicalKrullDim ↥W ≤ ((d : ℕ) : WithBot ℕ∞) →
        IsClosed A → A ⊆ W → A ≠ W →
        topologicalKrullDim ↥A ≤ ((d - 1 : ℕ) : WithBot ℕ∞) := by
      intro W A d hd hWCl hWIrr hDimW hACl hAW hAneW
      change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥A)),
        (p.length : WithBot ℕ∞) ≤ ((d - 1 : ℕ) : WithBot ℕ∞)
      apply iSup_le
      intro p
      obtain ⟨w₀, hw₀W, hw₀A⟩ : ∃ x ∈ W, x ∉ A := by
        by_contra! h
        exact hAneW (Set.Subset.antisymm hAW h)
      let i : ↥A → ↥W := Set.inclusion hAW
      have hi_emb : Topology.IsEmbedding i := Topology.IsEmbedding.inclusion hAW
      have hi_inj : Function.Injective i := Set.inclusion_injective hAW
      have hi_range : Set.range i = (Subtype.val : ↥W → X) ⁻¹' A := by
        ext w
        exact ⟨by rintro ⟨a, rfl⟩; exact a.2, fun hw => ⟨⟨w.1, hw⟩, rfl⟩⟩
      have hi_cl_range : IsClosed (Set.range i) :=
        hi_range ▸ hACl.preimage continuous_subtype_val
      let Φ_fun : TopologicalSpace.IrreducibleCloseds ↥A →
          TopologicalSpace.IrreducibleCloseds ↥W := fun c =>
        { carrier := i '' (c : Set ↥A)
          isIrreducible' := c.isIrreducible.image i hi_emb.continuous.continuousOn
          isClosed' := by
            obtain ⟨t, ht_cl, hpre⟩ := hi_emb.isInducing.isClosed_iff.mp c.isClosed
            rw [← hpre, Set.image_preimage_eq_inter_range]
            exact ht_cl.inter hi_cl_range }
      let q₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥W) :=
        { length := p.length
          toFun := fun k => Φ_fun (p k)
          step := fun k => by
            have hp_lt : p (Fin.castSucc k) < p k.succ := p.step k
            have h_le : Φ_fun (p (Fin.castSucc k)) ≤ Φ_fun (p k.succ) :=
              Set.image_mono (le_of_lt hp_lt)
            refine lt_of_le_not_ge h_le (fun h_ge => ?_)
            have h_sub : (p k.succ : Set ↥A) ⊆ (p (Fin.castSucc k) : Set ↥A) := by
              intro a ha
              obtain ⟨a', ha', ha_eq⟩ := h_ge ⟨a, ha, rfl⟩
              exact hi_inj ha_eq ▸ ha'
            exact not_le_of_gt hp_lt h_sub }
      let top_W : TopologicalSpace.IrreducibleCloseds ↥W :=
        ⟨Set.univ, h_irred_univ hWIrr, isClosed_univ⟩
      have h_lt_top : q₀.last < top_W := by
        refine lt_of_le_not_ge (fun _ _ => trivial) (fun h_ge => ?_)
        obtain ⟨a, _, ha_eq⟩ := h_ge (Set.mem_univ (⟨w₀, hw₀W⟩ : ↥W))
        have ha_val : a.1 = w₀ := congrArg Subtype.val ha_eq
        exact hw₀A (ha_val ▸ a.2)
      let q := q₀.snoc top_W h_lt_top
      have hq_len : q.length = p.length + 1 := RelSeries.snoc_length _ _ _
      have h_le_d : ((p.length + 1 : ℕ) : WithBot ℕ∞) ≤ ((d : ℕ) : WithBot ℕ∞) := by
        calc ((p.length + 1 : ℕ) : WithBot ℕ∞)
            = (q.length : WithBot ℕ∞) := by rw [hq_len]
          _ ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥W) :=
              Order.LTSeries.length_le_krullDim q
          _ = topologicalKrullDim ↥W := rfl
          _ ≤ ((d : ℕ) : WithBot ℕ∞) := hDimW
      have hn : p.length + 1 ≤ d :=
        ENat.natCast_le_natCast.mp (WithBot.coe_le_coe.mp h_le_d)
      have hn' : p.length ≤ d - 1 := by omega
      exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr hn')

    have h_irred_sub_finset : ∀ {C : Set X}, IsIrreducible C → ∀ (F : Finset (Set X)),
        (∀ Y ∈ F, IsClosed Y) → C ⊆ (⋃ Y ∈ F, Y) → ∃ Y ∈ F, C ⊆ Y := by
      intro C hC F
      induction F using Finset.induction_on with
      | empty =>
        intro _ hSub
        obtain ⟨x, hx⟩ := hC.nonempty
        have hx' := hSub hx
        simp at hx'
      | insert Y₀ F' _ ih =>
        intro hCl hSub
        by_cases hCY₀ : C ⊆ Y₀
        · exact ⟨Y₀, Finset.mem_insert_self _ _, hCY₀⟩
        let U' : Set X := ⋃ Y ∈ F', Y
        by_cases hCU' : C ⊆ U'
        · obtain ⟨Y, hY, hCY⟩ := ih (fun Y hY => hCl Y (Finset.mem_insert_of_mem hY)) hCU'
          exact ⟨Y, Finset.mem_insert_of_mem hY, hCY⟩
        have hClY₀ : IsClosed Y₀ := hCl Y₀ (Finset.mem_insert_self _ _)
        have hClU' : IsClosed U' :=
          F'.finite_toSet.isClosed_biUnion (fun Y hY => hCl Y (Finset.mem_insert_of_mem hY))
        obtain ⟨x₁, hx₁C, hx₁Y₀⟩ := Set.not_subset.mp hCY₀
        obtain ⟨x₂, hx₂C, hx₂U'⟩ := Set.not_subset.mp hCU'
        obtain ⟨z, hzC, hzY₀, hzU'⟩ :=
          hC.isPreirreducible Y₀ᶜ U'ᶜ hClY₀.isOpen_compl hClU'.isOpen_compl
            ⟨x₁, hx₁C, hx₁Y₀⟩ ⟨x₂, hx₂C, hx₂U'⟩
        have hz_in := hSub hzC
        simp only [Finset.mem_insert, Set.iUnion_iUnion_eq_or_left, Set.mem_union] at hz_in
        rcases hz_in with h1 | h2
        · exact False.elim (hzY₀ h1)
        · exact False.elim (hzU' h2)

    have h_union_bound : ∀ {S₀ : Set (Set X)} {b : WithBot ℕ∞}, S₀.Finite →
        (∀ Y ∈ S₀, IsClosed Y) →
        (∀ Y ∈ S₀, topologicalKrullDim ↥Y ≤ b) →
        topologicalKrullDim ↥(⋃ Y ∈ S₀, Y) ≤ b := by
      intro S₀ b hFin hCl hBnd
      let U_tot : Set X := ⋃ Y ∈ S₀, Y
      change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥U_tot)),
        (p.length : WithBot ℕ∞) ≤ b
      apply iSup_le
      intro p
      let M : Set X := (Subtype.val : ↥U_tot → X) '' (p.last : Set ↥U_tot)
      have hMIrr : IsIrreducible M :=
        p.last.isIrreducible.image Subtype.val continuous_subtype_val.continuousOn
      have hMSub : M ⊆ ⋃ Y ∈ hFin.toFinset, Y := by
        rintro _ ⟨u, _, rfl⟩
        simp only [Set.Finite.mem_toFinset]
        exact u.2
      obtain ⟨Y₀, hY₀_fin, hMY₀⟩ :=
        h_irred_sub_finset hMIrr hFin.toFinset
          (fun Y hY => hCl Y (hFin.mem_toFinset.mp hY)) hMSub
      have hY₀ : Y₀ ∈ S₀ := hFin.mem_toFinset.mp hY₀_fin
      let j : ↥Y₀ → ↥U_tot := Set.inclusion (fun z hz => Set.mem_biUnion hY₀ hz)
      have hj_emb : Topology.IsEmbedding j := Topology.IsEmbedding.inclusion _
      have hk_img : ∀ k : Fin (p.length + 1),
          j '' (j ⁻¹' (p k : Set ↥U_tot)) = (p k : Set ↥U_tot) := by
        intro k
        apply Set.image_preimage_eq_of_subset
        intro u hu
        have hu_last : u ∈ (p.last : Set ↥U_tot) := p.monotone (Fin.le_last k) hu
        have hu_Y₀ : u.1 ∈ Y₀ := hMY₀ ⟨u, hu_last, rfl⟩
        exact ⟨⟨u.1, hu_Y₀⟩, rfl⟩
      let D : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥Y₀ := fun k =>
        { carrier := j ⁻¹' (p k : Set ↥U_tot)
          isIrreducible' := h_emb_irred hj_emb ((hk_img k).symm ▸ (p k).isIrreducible)
          isClosed' := (p k).isClosed.preimage hj_emb.continuous }
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀) :=
        { length := p.length
          toFun := D
          step := fun k => by
            have hp_lt : p (Fin.castSucc k) < p k.succ := p.step k
            have h_le : D (Fin.castSucc k) ≤ D k.succ :=
              fun y hy => (le_of_lt hp_lt) hy
            refine lt_of_le_not_ge h_le (fun h_ge => ?_)
            have h_sub : (p k.succ : Set ↥U_tot) ⊆ (p (Fin.castSucc k) : Set ↥U_tot) := by
              rw [← hk_img k.succ, ← hk_img (Fin.castSucc k)]
              exact Set.image_mono h_ge
            exact not_le_of_gt hp_lt h_sub }
      calc (p.length : WithBot ℕ∞)
          = (q.length : WithBot ℕ∞) := rfl
        _ ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Y₀) :=
            Order.LTSeries.length_le_krullDim q
        _ = topologicalKrullDim ↥Y₀ := rfl
        _ ≤ b := hBnd Y₀ hY₀

    obtain ⟨S, hS_fin, hS_cl, hS_irr, hZ_eq_S⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hClosedZ
    have hDim_univ : topologicalKrullDim ↥(Set.univ : Set X) ≤ ((m + 1 : ℕ) : WithBot ℕ∞) := by
      rw [(Homeomorph.Set.univ X).isHomeomorph.topologicalKrullDim_eq, hDimVn]
    have hW_le_m : ∀ W ∈ S, topologicalKrullDim ↥W ≤ ((m : ℕ) : WithBot ℕ∞) := by
      intro W hW
      have hW_ne_univ : W ≠ Set.univ := by
        intro hEq
        apply hProperZ
        apply Set.Subset.antisymm (Set.subset_univ _)
        rw [← hEq, hZ_eq_S]
        exact fun x hx => Set.mem_sUnion.mpr ⟨W, hW, hx⟩
      have h1 : 1 ≤ m + 1 := by omega
      have h := h_strict_drop h1 isClosed_univ (IrreducibleSpace.isIrreducible_univ X)
        hDim_univ (hS_cl W hW) (Set.subset_univ W) hW_ne_univ
      simpa using h

    let S_div : Set (Set X) := {W ∈ S | topologicalKrullDim ↥W = ((m : ℕ) : WithBot ℕ∞)}
    let S_low : Set (Set X) := {W ∈ S | topologicalKrullDim ↥W ≠ ((m : ℕ) : WithBot ℕ∞)}
    let Z_low : Set X := ⋃ W ∈ S_low, W
    have hFin_div : S_div.Finite := hS_fin.subset (fun _ h => h.1)
    have hFin_low : S_low.Finite := hS_fin.subset (fun _ h => h.1)
    have hCl_divSet : IsClosed (⋃ W ∈ S_div, W) :=
      hFin_div.isClosed_biUnion (fun W hW => hS_cl W hW.1)
    have hCl_low : IsClosed Z_low :=
      hFin_low.isClosed_biUnion (fun W hW => hS_cl W hW.1)

    have hLow_le : ∀ W ∈ S_low, topologicalKrullDim ↥W ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
      intro W hW
      have hle := hW_le_m W hW.1
      have hne := hW.2
      cases hd : topologicalKrullDim ↥W with
      | bot => exact bot_le
      | coe a =>
        rw [hd] at hle hne
        cases a with
        | top =>
          exact absurd (top_le_iff.mp (WithBot.coe_le_coe.mp hle)) (ENat.natCast_ne_top m)
        | coe n =>
          have hn_le : n ≤ m := ENat.natCast_le_natCast.mp (WithBot.coe_le_coe.mp hle)
          have hn_ne : n ≠ m := by
            rintro rfl
            exact hne rfl
          have hn_lt : n ≤ m - 1 := by omega
          exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr hn_lt)

    refine ⟨S_div, Z_low, hFin_div, ?_, ?_, hCl_divSet, hCl_low, ?_, ?_, ?_, ?_⟩
    · intro W hW
      exact ⟨hS_cl W hW.1, hS_irr W hW.1, hW.2⟩
    · intro W hW
      by_contra! hSub
      have hFin_diff : (S_div \ {W}).Finite := hFin_div.sdiff
      have hSub' : W ⊆ ⋃ W' ∈ hFin_diff.toFinset, W' := by
        intro x hx
        simpa using hSub x hx
      obtain ⟨W', hW'_fin, hWW'⟩ :=
        h_irred_sub_finset (hS_irr W hW.1) hFin_diff.toFinset
          (fun Y hY => hS_cl Y (hFin_diff.mem_toFinset.mp hY).1.1) hSub'
      have hW'_mem : W' ∈ S_div \ {W} := hFin_diff.mem_toFinset.mp hW'_fin
      have hW_ne_W' : W ≠ W' := fun hEq => hW'_mem.2 (Set.mem_singleton_iff.mpr hEq.symm)
      have hDrop := h_strict_drop hm (hS_cl W' hW'_mem.1.1) (hS_irr W' hW'_mem.1.1)
        (le_of_eq hW'_mem.1.2) (hS_cl W hW.1) hWW' hW_ne_W'
      rw [hW.2] at hDrop
      have hbad : m ≤ m - 1 := ENat.natCast_le_natCast.mp (WithBot.coe_le_coe.mp hDrop)
      omega
    · ext x
      dsimp only [Z_low]
      rw [hZ_eq_S]
      simp only [Set.mem_sUnion, Set.mem_union, Set.mem_iUnion, exists_prop]
      refine ⟨?_, ?_⟩
      · rintro ⟨W, hW, hxW⟩
        by_cases hEq : topologicalKrullDim ↥W = ((m : ℕ) : WithBot ℕ∞)
        · exact Or.inl ⟨W, ⟨hW, hEq⟩, hxW⟩
        · exact Or.inr ⟨W, ⟨hW, hEq⟩, hxW⟩
      · rintro (⟨W, hW, hxW⟩ | ⟨W, hW, hxW⟩)
        · exact ⟨W, hW.1, hxW⟩
        · exact ⟨W, hW.1, hxW⟩
    · exact h_union_bound hFin_div (fun W hW => hS_cl W hW.1) (fun W hW => le_of_eq hW.2)
    · exact h_union_bound hFin_low (fun W hW => hS_cl W hW.1) hLow_le
    · intro K hClK hKSub hKProper
      let F_K : Set (Set X) := (fun W => W ∩ K) '' S_div
      have hFin_FK : F_K.Finite := hFin_div.image _
      have hEq_K : K = ⋃ Y ∈ F_K, Y := by
        ext x
        refine ⟨fun hxK => ?_, ?_⟩
        · have hxU := hKSub hxK
          simp only [Set.mem_iUnion, exists_prop] at hxU
          obtain ⟨W, hW, hxW⟩ := hxU
          exact Set.mem_biUnion ⟨W, hW, rfl⟩ ⟨hxW, hxK⟩
        · intro hxU
          simp only [Set.mem_iUnion, exists_prop] at hxU
          rcases hxU with ⟨_, ⟨W, _, rfl⟩, _, hxK⟩
          exact hxK
      have hDim_FK : topologicalKrullDim ↥(⋃ Y ∈ F_K, Y) ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
        apply h_union_bound hFin_FK
        · rintro _ ⟨W, hW, rfl⟩
          exact (hS_cl W hW.1).inter hClK
        · rintro _ ⟨W, hW, rfl⟩
          exact h_strict_drop hm (hS_cl W hW.1) (hS_irr W hW.1) (le_of_eq hW.2)
            ((hS_cl W hW.1).inter hClK) Set.inter_subset_left (hKProper W hW)
      exact hEq_K.symm ▸ hDim_FK

  
  
  
  have hVanSub : ∀ (C : TopologicalSpace.Closeds ↥V_norm.left),
      AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι ∧
      AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subscheme ∧
      Set.range (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).subschemeι.base =
        (C : Set V_norm.left) := by
    intro C
    let I_C := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
    let Z := I_C.subscheme
    let ι := I_C.subschemeι
    refine ⟨inferInstance, ?_, ?_⟩
    · let V_fam : V_norm.left.affineOpens → Z.Opens :=
        fun U => (TopologicalSpace.Opens.map ι.base).obj U.1
      have h_cov : TopologicalSpace.IsOpenCover V_fam := by
        change ⨆ U : V_norm.left.affineOpens, V_fam U = ⊤
        apply le_antisymm le_top
        intro z _
        have hz_top : ι.base z ∈ (⨆ U : V_norm.left.affineOpens, U.1 : V_norm.left.Opens) := by
          rw [AlgebraicGeometry.iSup_affineOpens_eq_top V_norm.left]
          trivial
        obtain ⟨U, hzU⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_top
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨U, hzU⟩
      have hRed_each : ∀ (U : V_norm.left.affineOpens),
          AlgebraicGeometry.IsReduced (V_fam U).toScheme := by
        intro U
        have hAff : AlgebraicGeometry.IsAffineOpen (V_fam U) :=
          AlgebraicGeometry.IsAffineHom.isAffine_preimage U.1 U.2
        have : AlgebraicGeometry.IsAffine (V_fam U).toScheme := hAff
        have hRad : (I_C.ideal U).IsRadical := by
          dsimp [I_C]
          rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
          exact PrimeSpectrum.isRadical_vanishingIdeal _
        have : _root_.IsReduced (↑(V_norm.left.presheaf.obj (Opposite.op U.1)) ⧸ I_C.ideal U) :=
          (Ideal.isRadical_iff_quotient_reduced _).mp hRad
        let e₁ : ↑(Z.presheaf.obj (Opposite.op (V_fam U))) ≃+*
            (↑(V_norm.left.presheaf.obj (Opposite.op U.1)) ⧸ I_C.ideal U) :=
          (I_C.subschemeObjIso U).commRingCatIsoToRingEquiv
        have h_isIso_homOfLE : ∀ {O₁ O₂ : Z.Opens} (hle : O₁ ≤ O₂), O₁ = O₂ →
            CategoryTheory.IsIso (Z.presheaf.map (CategoryTheory.homOfLE hle).op) := by
          intro O₁ O₂ hle hEq
          subst hEq
          have h_id : (CategoryTheory.homOfLE hle).op = 𝟙 (Opposite.op O₁) :=
            Subsingleton.elim _ _
          rw [h_id, CategoryTheory.Functor.map_id]
          infer_instance
        have h_top_eq : (V_fam U).ι ''ᵁ ⊤ = V_fam U := by
          ext z
          exact ⟨by rintro ⟨u, _, rfl⟩; exact u.2, fun hz => ⟨⟨z, hz⟩, trivial, rfl⟩⟩
        have hle_top : (⊤ : (V_fam U).toScheme.Opens) ≤
            (TopologicalSpace.Opens.map (V_fam U).ι.base).obj (V_fam U) :=
          fun z _ => z.2
        have : CategoryTheory.IsIso
            ((V_fam U).ι.appLE (V_fam U) ⊤ hle_top) := by
          rw [AlgebraicGeometry.Scheme.Opens.ι_appLE (V_fam U) (V_fam U) ⊤ hle_top]
          exact h_isIso_homOfLE _ h_top_eq
        let e₂ : ↑(Z.presheaf.obj (Opposite.op (V_fam U))) ≃+*
            ↑((V_fam U).toScheme.presheaf.obj (Opposite.op ⊤)) :=
          (CategoryTheory.asIso
            ((V_fam U).ι.appLE (V_fam U) ⊤ hle_top)).commRingCatIsoToRingEquiv
        let e_tot := e₂.symm.trans e₁
        have : _root_.IsReduced ↑((V_fam U).toScheme.presheaf.obj (Opposite.op ⊤)) := by
          refine ⟨fun x ⟨n, hn⟩ => ?_⟩
          have hpow : (e_tot x) ^ n = 0 := by rw [← map_pow, hn, map_zero]
          exact e_tot.injective ((IsNilpotent.eq_zero ⟨n, hpow⟩).trans (map_zero e_tot).symm)
        exact AlgebraicGeometry.isReduced_of_isAffine_isReduced (V_fam U).toScheme
      let 𝒰 : Z.OpenCover := Z.openCoverOfIsOpenCover V_fam h_cov
      have : ∀ (U : 𝒰.I₀), AlgebraicGeometry.IsReduced (𝒰.X U) := hRed_each
      exact AlgebraicGeometry.IsReduced.of_openCover Z 𝒰
    · exact (I_C.range_subschemeι).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal C)

  have hChartDom : ∀ (C_div : TopologicalSpace.Closeds ↥V_norm.left)
      (W : Set V_norm.left), IsClosed W → IsIrreducible W →
      topologicalKrullDim ↥W = ((m : ℕ) : WithBot ℕ∞) →
      ∀ (U : V_norm.left.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
        (W ∩ (U : Set V_norm.left)).Nonempty →
        (C_div : Set V_norm.left) ∩ (U : Set V_norm.left) = W ∩ (U : Set V_norm.left) →
        let A := ↑(V_norm.left.presheaf.obj (Opposite.op U)) ⧸
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_div).ideal ⟨U, hU⟩
        letI : Algebra k A :=
          ((Ideal.Quotient.mk
            ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_div).ideal ⟨U, hU⟩)).comp
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              V_norm.hom.appLE ⊤ U le_top).hom)).toAlgebra
        IsDomain A ∧ Algebra.FiniteType k A ∧ (m : Cardinal.{u}) = Algebra.trdeg k A := by
    have h_loc_dim : ∀ (X : Type u) [TopologicalSpace X] [Nonempty X] (d : WithBot ℕ∞),
        (∀ x : X, ∃ O : TopologicalSpace.Opens X, x ∈ O ∧ topologicalKrullDim ↥O = d) →
        topologicalKrullDim X = d := by
      clear * -
      intro X _ hNeX d hX
      apply le_antisymm
      · change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds X)),
          (p.length : WithBot ℕ∞) ≤ d
        apply iSup_le
        intro p
        obtain ⟨x, hx0⟩ := (p 0).isIrreducible.nonempty
        obtain ⟨O, hxO, hOdim⟩ := hX x
        have hv_emb : Topology.IsOpenEmbedding (Subtype.val : ↥O → X) := O.isOpenEmbedding'
        let c : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥O := fun i =>
          have hx_i : x ∈ (p i : Set X) := p.monotone (Fin.zero_le i) hx0
          have h_nonempty_i : ((p i : Set X) ∩ Set.range (Subtype.val : ↥O → X)).Nonempty :=
            ⟨x, hx_i, ⟨x, hxO⟩, rfl⟩
          { carrier := (Subtype.val : ↥O → X) ⁻¹' (p i : Set X)
            isIrreducible' := (p i).isIrreducible.preimage hv_emb h_nonempty_i
            isClosed' := (p i).isClosed.preimage continuous_subtype_val }
        have h_strict : ∀ i : Fin p.length, c (Fin.castSucc i) < c i.succ := by
          intro i
          have hp_lt : p (Fin.castSucc i) < p i.succ := p.step i
          have h_le : c (Fin.castSucc i) ≤ c i.succ := fun y hy => (le_of_lt hp_lt) hy
          refine lt_of_le_not_ge h_le (fun h_ge => ?_)
          obtain ⟨y, hy_succ, hy_not⟩ := Set.not_subset.mp (not_le_of_gt hp_lt)
          obtain ⟨w, hw_succ, hw_not, hw_O⟩ :=
            (p i.succ).isIrreducible.isPreirreducible _ _
              (p (Fin.castSucc i)).isClosed.isOpen_compl O.isOpen
              ⟨y, hy_succ, hy_not⟩ ⟨x, p.monotone (Fin.zero_le i.succ) hx0, hxO⟩
          exact hw_not (h_ge (show (⟨w, hw_O⟩ : ↥O) ∈ c i.succ from hw_succ))
        let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥O) :=
          { length := p.length, toFun := c, step := h_strict }
        calc (p.length : WithBot ℕ∞)
            = (q.length : WithBot ℕ∞) := rfl
          _ ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥O) :=
              Order.LTSeries.length_le_krullDim q
          _ = topologicalKrullDim ↥O := rfl
          _ = d := hOdim
      · obtain ⟨x₀⟩ := hNeX
        obtain ⟨O₀, _, hO₀⟩ := hX x₀
        calc d = topologicalKrullDim ↥O₀ := hO₀.symm
          _ = topologicalKrullDim ↥(O₀ : Set X) := rfl
          _ ≤ topologicalKrullDim X := topologicalKrullDim_subspace_le X (O₀ : Set X)

    have h_single_dom : ∀ (R K : Type u) [CommRing R] [IsDomain R] [Algebra k R]
        [Algebra.FiniteType k R] [Field K] [Algebra k K] [Algebra R K]
        [IsScalarTower k R K] [IsFractionRing R K],
        ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k K ∧
          (s : Cardinal.{u}) = Algebra.trdeg k R ∧
          ringKrullDim R = (s : WithBot ℕ∞) := by
      clear * -
      intro R K _ _ _ _ _ _ _ _ _
      have : FaithfulSMul k R :=
        (faithfulSMul_iff_algebraMap_injective k R).mpr (algebraMap k R).injective
      have : FaithfulSMul R K :=
        (faithfulSMul_iff_algebraMap_injective R K).mpr (IsFractionRing.injective R K)
      have : Algebra.IsAlgebraic R K := IsLocalization.isAlgebraic K (nonZeroDivisors R)
      have h_tr_RK_eq : Algebra.trdeg k R = Algebra.trdeg k K := by
        have h_tr_RK : Algebra.trdeg R K = 0 := trdeg_eq_zero
        have hadd := trdeg_add_eq k R (A := K)
        rw [h_tr_RK, add_zero] at hadd
        exact hadd
      obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k R
      let P : Type u := MvPolynomial (Fin s) k
      have h_dim_P : ringKrullDim P = (s : WithBot ℕ∞) := by
        change ringKrullDim (MvPolynomial (Fin s) k) = (s : WithBot ℕ∞)
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
          zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
        rfl
      let : Algebra P R := g.toRingHom.toAlgebra
      have : Algebra.IsIntegral P R := ⟨hg_int⟩
      have h_tr_kR : (s : Cardinal.{u}) = Algebra.trdeg k R := by
        have : IsScalarTower k P R := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
        have : FaithfulSMul k P :=
          (faithfulSMul_iff_algebraMap_injective k P).mpr (algebraMap k P).injective
        have : FaithfulSMul P R :=
          (faithfulSMul_iff_algebraMap_injective P R).mpr hg_inj
        have : Algebra.IsAlgebraic P R := Algebra.IsIntegral.isAlgebraic
        have h_tr_PR : Algebra.trdeg P R = 0 := trdeg_eq_zero
        have h_tr_kP : Algebra.trdeg k P = (s : Cardinal.{u}) := by
          rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
        have hadd := trdeg_add_eq k P (A := R)
        rw [h_tr_kP, h_tr_PR, add_zero] at hadd
        exact hadd
      have h_dim_le : ringKrullDim R ≤ ringKrullDim P := by
        apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap P R))
        intro q₁ q₂ hlt
        obtain ⟨x, hxq₂, hxq₁⟩ := Set.not_subset.mp (not_le_of_gt hlt)
        have hx_sdiff : x ∈ (q₂.asIdeal : Set R) \ (q₁.asIdeal : Set R) := ⟨hxq₂, hxq₁⟩
        have h_int_x : _root_.IsIntegral P x := Algebra.IsIntegral.isIntegral x
        have := q₁.isPrime
        exact Ideal.under_lt_under_of_integral_mem_sdiff (R := P) (le_of_lt hlt) hx_sdiff h_int_x
      have h_lift : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum P)), p.length = n →
          ∃ (q : LTSeries (PrimeSpectrum R)),
            q.length = n ∧ Ideal.under P q.last.asIdeal = p.last.asIdeal := by
        intro n
        induction n with
        | zero =>
          intro p _
          have h_bot : Ideal.under P (⊥ : Ideal R) ≤ p.last.asIdeal := by
            intro y hy
            have hy0 : g y = 0 := Ideal.mem_bot.mp hy
            have hy_eq : y = 0 := hg_inj (hy0.trans (map_zero g).symm)
            rw [hy_eq]
            exact p.last.asIdeal.zero_mem
          have := p.last.isPrime
          obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral (R := P) (S := R)
              p.last.asIdeal (⊥ : Ideal R) h_bot
          refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, hQ₀_under⟩
        | succ n ih =>
          intro p hp_len
          let p' : LTSeries (PrimeSpectrum P) := p.eraseLast
          have hp'_len : p'.length = n := by
            rw [RelSeries.eraseLast_length, hp_len]
            omega
          have hp'_lt : p'.last < p.last := p.eraseLast_last_rel_last (by omega)
          obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
          have h_le_under : Ideal.under P q'.last.asIdeal ≤ p.last.asIdeal := by
            rw [hq'_under]
            exact le_of_lt hp'_lt
          have := p.last.isPrime
          have := q'.last.isPrime
          obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (R := P) (S := R)
              p.last.asIdeal q'.last.asIdeal h_le_under
          have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum R) := by
            refine lt_of_le_not_ge hQ_ge (fun h_ge => ?_)
            have h_eq : Q_next = q'.last.asIdeal := le_antisymm h_ge hQ_ge
            have h_under_eq : p.last.asIdeal = p'.last.asIdeal := by
              rw [← hQ_under, h_eq, hq'_under]
            exact (ne_of_lt hp'_lt) (PrimeSpectrum.ext h_under_eq.symm)
          let q : LTSeries (PrimeSpectrum R) := q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q
          refine ⟨q, ?_, ?_⟩
          · rw [RelSeries.snoc_length, hq'_len]
          · rw [RelSeries.last_snoc]
            exact hQ_under
      have h_dim_ge : ringKrullDim P ≤ ringKrullDim R := by
        change ⨆ (p : LTSeries (PrimeSpectrum P)), (p.length : WithBot ℕ∞) ≤ ringKrullDim R
        apply iSup_le
        intro p
        obtain ⟨q, hq_len, _⟩ := h_lift p.length p rfl
        calc (p.length : WithBot ℕ∞)
            = (q.length : WithBot ℕ∞) := by rw [hq_len]
          _ ≤ Order.krullDim (PrimeSpectrum R) := Order.LTSeries.length_le_krullDim q
          _ = ringKrullDim R := rfl
      exact ⟨s, h_tr_kR.trans h_tr_RK_eq, h_tr_kR, (le_antisymm h_dim_le h_dim_ge).trans h_dim_P⟩

    intro C_div W hClW hIrrW hDimW U hU hWU_ne hCW
    let C_W : TopologicalSpace.Closeds ↥V_norm.left := ⟨W, hClW⟩
    let I_W := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_W
    let W_sch : AlgebraicGeometry.Scheme.{u} := I_W.subscheme
    let ι_W : W_sch ⟶ V_norm.left := I_W.subschemeι
    obtain ⟨hCl_ιW, hRed_Wsch, hRange_W⟩ := hVanSub C_W
    have : AlgebraicGeometry.IsClosedImmersion ι_W := hCl_ιW
    have : AlgebraicGeometry.IsReduced W_sch := hRed_Wsch
    let f_W : W_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := ι_W ≫ V_norm.hom
    have : AlgebraicGeometry.LocallyOfFiniteType f_W := inferInstance

    let e_W : ↥W_sch ≃ₜ ↥W :=
      (Homeomorph.Set.univ ↥W_sch).symm.trans
        ((ι_W.isClosedEmbedding.isEmbedding.homeomorphImage Set.univ).trans
          (Homeomorph.setCongr (Set.image_univ.trans hRange_W)))
    have hDim_Wsch : topologicalKrullDim ↥W_sch = ((m : ℕ) : WithBot ℕ∞) :=
      e_W.isHomeomorph.topologicalKrullDim_eq.trans hDimW

    obtain ⟨x₀, hx₀W, hx₀U⟩ := hWU_ne
    obtain ⟨z₀, hz₀_eq⟩ : x₀ ∈ Set.range ι_W.base := hRange_W.symm ▸ hx₀W
    have hPre_Wsch : PreirreducibleSpace ↥W_sch := by
      refine ⟨fun u v hu hv ⟨z₁, _, hz₁u⟩ ⟨z₂, _, hz₂v⟩ => ?_⟩
      obtain ⟨U₁, hU₁, hpre₁⟩ := Topology.IsEmbedding.subtypeVal.isInducing.isOpen_iff.mp
        (e_W.isOpenMap u hu)
      obtain ⟨U₂, hU₂, hpre₂⟩ := Topology.IsEmbedding.subtypeVal.isInducing.isOpen_iff.mp
        (e_W.isOpenMap v hv)
      have h1 : (W ∩ U₁).Nonempty := by
        refine ⟨(e_W z₁).1, (e_W z₁).2, ?_⟩
        have : e_W z₁ ∈ e_W '' u := ⟨z₁, hz₁u, rfl⟩
        rwa [← hpre₁] at this
      have h2 : (W ∩ U₂).Nonempty := by
        refine ⟨(e_W z₂).1, (e_W z₂).2, ?_⟩
        have : e_W z₂ ∈ e_W '' v := ⟨z₂, hz₂v, rfl⟩
        rwa [← hpre₂] at this
      obtain ⟨y, hyW, hyU₁, hyU₂⟩ := hIrrW.isPreirreducible U₁ U₂ hU₁ hU₂ h1 h2
      have hy_u : (⟨y, hyW⟩ : ↥W) ∈ e_W '' u := by
        rw [← hpre₁]
        exact hyU₁
      have hy_v : (⟨y, hyW⟩ : ↥W) ∈ e_W '' v := by
        rw [← hpre₂]
        exact hyU₂
      rcases hy_u with ⟨a₁, ha₁u, ha₁_eq⟩
      rcases hy_v with ⟨a₂, ha₂v, ha₂_eq⟩
      have ha_eq : a₁ = a₂ := e_W.injective (ha₁_eq.trans ha₂_eq.symm)
      exact ⟨a₁, trivial, ha₁u, ha_eq.symm ▸ ha₂v⟩
    have : IrreducibleSpace ↥W_sch := @IrreducibleSpace.mk ↥W_sch _ hPre_Wsch ⟨z₀⟩
    have hInt_Wsch : AlgebraicGeometry.IsIntegral W_sch :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced W_sch
    have : Nonempty ↥W_sch := ⟨z₀⟩
    have : Nonempty ↥(⊤ : W_sch.Opens).toScheme := ⟨⟨z₀, trivial⟩⟩

    let K_W : Type u := ↑W_sch.functionField
    let R_k := CommRingCat.of k
    let φ_top : R_k ⟶ W_sch.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ f_W.appLE ⊤ ⊤ le_top
    let : Algebra k K_W := ((W_sch.germToFunctionField ⊤).hom.comp φ_top.hom).toAlgebra
    have hSurjΓ : Function.Surjective ((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom := by
      intro y
      refine ⟨((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom).hom y, ?_⟩
      change (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom) y = y
      rw [CategoryTheory.Iso.hom_inv_id]
      rfl

    have h_aff_W : ∀ (O : W_sch.Opens) (hAffO : AlgebraicGeometry.IsAffineOpen O)
        (hNeO : Nonempty ↥O),
        letI : Algebra k ↑(W_sch.presheaf.obj (Opposite.op O)) :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ f_W.appLE ⊤ O le_top).hom).toAlgebra
        IsDomain ↑(W_sch.presheaf.obj (Opposite.op O)) ∧
        Algebra.FiniteType k ↑(W_sch.presheaf.obj (Opposite.op O)) ∧
        ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k K_W ∧
          (s : Cardinal.{u}) = Algebra.trdeg k ↑(W_sch.presheaf.obj (Opposite.op O)) ∧
          topologicalKrullDim ↥O = (s : WithBot ℕ∞) := by
      intro O hAffO hNeO
      have : Nonempty ↥O.toScheme := hNeO
      let R_O : Type u := ↑(W_sch.presheaf.obj (Opposite.op O))
      have hDomO : IsDomain R_O :=
        @AlgebraicGeometry.IsIntegral.component_integral W_sch hInt_Wsch O hNeO
      let φ_O : R_k ⟶ W_sch.presheaf.obj (Opposite.op O) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ f_W.appLE ⊤ O le_top
      let : Algebra k R_O := φ_O.hom.toAlgebra
      have hFT_appO : (f_W.appLE ⊤ O le_top).hom.FiniteType :=
        f_W.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hAffO le_top
      have hFT_O : Algebra.FiniteType k R_O :=
        RingHom.FiniteType.comp hFT_appO (RingHom.FiniteType.of_surjective _ hSurjΓ)
      have h_comm_germ : f_W.appLE ⊤ O le_top ≫ W_sch.germToFunctionField O =
          f_W.appLE ⊤ ⊤ le_top ≫ W_sch.germToFunctionField ⊤ := by
        have h1 : f_W.appLE ⊤ ⊤ le_top ≫
            W_sch.presheaf.map (CategoryTheory.homOfLE (le_top : O ≤ ⊤)).op =
            f_W.appLE ⊤ O le_top :=
          AlgebraicGeometry.Scheme.Hom.appLE_map f_W le_top
            (CategoryTheory.homOfLE (le_top : O ≤ ⊤)).op
        rw [← h1, CategoryTheory.Category.assoc]
        congr 1
        exact TopCat.Presheaf.germ_res W_sch.presheaf
          (CategoryTheory.homOfLE (le_top : O ≤ ⊤)) _ _
      have h_tower_eq : φ_O ≫ W_sch.germToFunctionField O =
          φ_top ≫ W_sch.germToFunctionField ⊤ := by
        dsimp [φ_O, φ_top]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_comm_germ]
      have : IsScalarTower k R_O K_W :=
        IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h_tower_eq).symm
      have : IsFractionRing R_O K_W :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen W_sch O hAffO
      obtain ⟨s, hs_trK, hs_trR, hs_ring⟩ := h_single_dom R_O K_W
      let e_O := AlgebraicGeometry.Scheme.homeoOfIso hAffO.isoSpec
      have h_top_O : topologicalKrullDim ↥O = ringKrullDim R_O := by
        calc topologicalKrullDim ↥O
            = topologicalKrullDim ↥O.toScheme := rfl
          _ = topologicalKrullDim
                ↥(AlgebraicGeometry.Spec (W_sch.presheaf.obj (Opposite.op O))) :=
              e_O.isHomeomorph.topologicalKrullDim_eq
          _ = topologicalKrullDim (PrimeSpectrum R_O) := rfl
          _ = ringKrullDim R_O := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim R_O
      exact ⟨hDomO, hFT_O, s, hs_trK, hs_trR, h_top_O.trans hs_ring⟩

    let O_U : W_sch.Opens := (TopologicalSpace.Opens.map ι_W.base).obj U
    have hAff_OU : AlgebraicGeometry.IsAffineOpen O_U :=
      AlgebraicGeometry.IsAffineHom.isAffine_preimage U hU
    have hz₀_OU : z₀ ∈ O_U := by
      change ι_W.base z₀ ∈ U
      rwa [hz₀_eq]
    have hNe_OU : Nonempty ↥O_U := ⟨⟨z₀, hz₀_OU⟩⟩

    obtain ⟨_, hFT_OU, s₀, hs₀_trK, hs₀_trOU, _⟩ := h_aff_W O_U hAff_OU hNe_OU
    have h_dim_W_s₀ : topologicalKrullDim ↥W_sch = (s₀ : WithBot ℕ∞) := by
      apply h_loc_dim ↥W_sch (s₀ : WithBot ℕ∞)
      intro z
      obtain ⟨O, hAffO, hzO, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top z)
      obtain ⟨_, _, s, hs_trK, _, hs_top⟩ := h_aff_W O hAffO ⟨⟨z, hzO⟩⟩
      have hs_eq : s = s₀ := Nat.cast_injective (hs_trK.trans hs₀_trK.symm)
      exact ⟨O, hzO, hs_top.trans (by rw [hs_eq])⟩
    have hs₀_m : s₀ = m :=
      ENat.natCast_inj.mp (WithBot.coe_inj.mp (h_dim_W_s₀.symm.trans hDim_Wsch))

    let I_div := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_div
    have hId_eq : I_div.ideal ⟨U, hU⟩ = I_W.ideal ⟨U, hU⟩ := by
      dsimp [I_div, I_W]
      rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal,
        AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
      congr 1
      ext q
      have hqU : hU.fromSpec.base q ∈ (U : Set V_norm.left) := by
        rw [← hU.range_fromSpec]
        exact ⟨q, rfl⟩
      change hU.fromSpec.base q ∈ (C_div : Set V_norm.left) ↔ hU.fromSpec.base q ∈ W
      have h1 : hU.fromSpec.base q ∈ (C_div : Set V_norm.left) ↔
          hU.fromSpec.base q ∈ (C_div : Set V_norm.left) ∩ (U : Set V_norm.left) :=
        ⟨fun h => ⟨h, hqU⟩, fun h => h.1⟩
      have h2 : hU.fromSpec.base q ∈ W ↔
          hU.fromSpec.base q ∈ W ∩ (U : Set V_norm.left) :=
        ⟨fun h => ⟨h, hqU⟩, fun h => h.1⟩
      rw [h1, h2, hCW]

    let R_OU : Type u := ↑(W_sch.presheaf.obj (Opposite.op O_U))
    let : Algebra k R_OU :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ f_W.appLE ⊤ O_U le_top).hom).toAlgebra
    let A : Type u := ↑(V_norm.left.presheaf.obj (Opposite.op U)) ⧸ I_div.ideal ⟨U, hU⟩
    let φ_A : k →+* A :=
      (Ideal.Quotient.mk (I_div.ideal ⟨U, hU⟩)).comp
        (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ V_norm.hom.appLE ⊤ U le_top).hom)
    let : Algebra k A := φ_A.toAlgebra

    let e₁ : R_OU ≃+* (↑(V_norm.left.presheaf.obj (Opposite.op U)) ⧸ I_W.ideal ⟨U, hU⟩) :=
      (I_W.subschemeObjIso ⟨U, hU⟩).commRingCatIsoToRingEquiv
    let e₂ := Ideal.quotEquivOfEq hId_eq.symm
    let e_RA : R_OU ≃+* A := e₁.trans e₂

    have h_comm_k : ∀ c : k, e_RA (algebraMap k R_OU c) = algebraMap k A c := by
      intro c
      have h_comp1 : f_W.appLE ⊤ O_U le_top =
          V_norm.hom.appLE ⊤ U le_top ≫ ι_W.appLE U O_U le_rfl :=
        (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_W V_norm.hom ⊤ U O_U le_top le_rfl).symm
      have h_app_eq : ι_W.appLE U O_U le_rfl = ι_W.app U := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE]
        have hid : (CategoryTheory.homOfLE
            (le_rfl : O_U ≤ (TopologicalSpace.Opens.map ι_W.base).obj U)).op =
            𝟙 (Opposite.op O_U) := Subsingleton.elim _ _
        rw [hid, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
      have happ_W := I_W.subschemeι_app ⟨U, hU⟩
      let r_U := (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫
        V_norm.hom.appLE ⊤ U le_top).hom) c
      have hr_O : algebraMap k R_OU c = (ι_W.app U).hom r_U := by
        change (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ f_W.appLE ⊤ O_U le_top).hom) c = _
        rw [h_comp1, h_app_eq]
        rfl
      have he₁_app : e₁ ((ι_W.app U).hom r_U) = Ideal.Quotient.mk (I_W.ideal ⟨U, hU⟩) r_U := by
        change ((I_W.subschemeObjIso ⟨U, hU⟩).hom).hom ((ι_W.app U).hom r_U) = _
        rw [happ_W]
        change (((I_W.subschemeObjIso ⟨U, hU⟩).inv ≫ (I_W.subschemeObjIso ⟨U, hU⟩).hom).hom)
          (Ideal.Quotient.mk (I_W.ideal ⟨U, hU⟩) r_U) = _
        rw [CategoryTheory.Iso.inv_hom_id]
        rfl
      change e₂ (e₁ (algebraMap k R_OU c)) = Ideal.Quotient.mk (I_div.ideal ⟨U, hU⟩) r_U
      rw [hr_O, he₁_app]
      rfl

    let e_alg : R_OU ≃ₐ[k] A := AlgEquiv.ofRingEquiv h_comm_k
    have hDom_A : IsDomain A := e_RA.symm.toMulEquiv.isDomain R_OU
    have hFT_A : Algebra.FiniteType k A := Algebra.FiniteType.equiv hFT_OU e_alg
    let : Algebra R_OU A := e_RA.toRingHom.toAlgebra
    have : IsScalarTower k R_OU A :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun c => (h_comm_k c).symm)
    have : FaithfulSMul k R_OU :=
      (faithfulSMul_iff_algebraMap_injective k R_OU).mpr (algebraMap k R_OU).injective
    have : FaithfulSMul R_OU A :=
      (faithfulSMul_iff_algebraMap_injective R_OU A).mpr e_RA.injective
    have : Algebra.IsIntegral R_OU A :=
      ⟨fun a => by
        have ha : algebraMap R_OU A (e_RA.symm a) = a := e_RA.apply_symm_apply a
        rw [← ha]
        exact isIntegral_algebraMap⟩
    have : Algebra.IsAlgebraic R_OU A := Algebra.IsIntegral.isAlgebraic
    have h_tr_RA : Algebra.trdeg R_OU A = 0 := trdeg_eq_zero
    have h_tr_eq : Algebra.trdeg k R_OU = Algebra.trdeg k A := by
      have hadd := trdeg_add_eq k R_OU (A := A)
      rw [h_tr_RA, add_zero] at hadd
      exact hadd
    refine ⟨hDom_A, hFT_A, ?_⟩
    rw [← hs₀_m, hs₀_trOU, h_tr_eq]

  
  
  
  have hGenSmooth : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A]
      [Algebra.FiniteType k A],
      (m : Cardinal.{u}) = Algebra.trdeg k A →
      ∃ h : A, h ≠ 0 ∧ Algebra.IsStandardSmoothOfRelativeDimension m k (Localization.Away h) := by
    have h_etale_trdeg : ∀ (r : ℕ) (S : Type u) [CommRing S] [IsDomain S] [Algebra k S],
        Algebra.IsStandardSmoothOfRelativeDimension r k S →
        Algebra.trdeg k S = (r : Cardinal.{u}) := by
      clear * -
      intro r S _ _ _ hStd_r
      obtain ⟨g, hg_et⟩ :=
        Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial r k S
      let P_r : Type u := MvPolynomial (Fin r) k
      let K : Type u := FractionRing S
      let : Algebra P_r S := g.toRingHom.toAlgebra
      have : Algebra.Etale P_r S := hg_et
      have : Module.Flat P_r S := inferInstance
      have : Algebra.HasGoingDown P_r S := Algebra.HasGoingDown.of_flat
      have hg_inj : Function.Injective g := by
        let p_u : Ideal P_r := (⊥ : Ideal S).under P_r
        have : p_u.IsPrime := Ideal.IsPrime.under P_r (⊥ : Ideal S)
        have : (⊥ : Ideal S).LiesOver p_u := ⟨rfl⟩
        obtain ⟨Q₀, hQ₀_le, _, hQ₀_over⟩ :=
          Ideal.exists_ideal_le_liesOver_of_le (p := (⊥ : Ideal P_r)) (q := p_u) (⊥ : Ideal S)
            bot_le
        have hQ₀_eq : Q₀ = (⊥ : Ideal S) := le_bot_iff.mp hQ₀_le
        have hp_eq : p_u = ⊥ := by
          have hover : (⊥ : Ideal P_r) = Ideal.under P_r Q₀ := hQ₀_over.over
          rw [hQ₀_eq] at hover
          exact hover.symm
        rw [injective_iff_map_eq_zero]
        intro x hx
        have hx_mem : x ∈ p_u := Ideal.mem_bot.mpr hx
        rw [hp_eq] at hx_mem
        exact Ideal.mem_bot.mp hx_mem
      have : IsScalarTower k P_r S := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
      have : IsScalarTower k P_r K := IsScalarTower.of_algebraMap_eq' (by
        rw [IsScalarTower.algebraMap_eq k S K, IsScalarTower.algebraMap_eq k P_r S,
          ← RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq P_r S K])
      let F_r : Type u := FractionRing P_r
      have : Module.IsTorsionFree P_r K :=
        Module.isTorsionFree_iff_algebraMap_injective.mpr (by
          rw [IsScalarTower.algebraMap_eq P_r S K]
          exact (IsFractionRing.injective S K).comp hg_inj)
      let : Algebra F_r K := FractionRing.liftAlgebra P_r K
      have : IsScalarTower k F_r K := IsScalarTower.of_algebraMap_eq' (by
        rw [IsScalarTower.algebraMap_eq k P_r K, IsScalarTower.algebraMap_eq k P_r F_r,
          ← RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq P_r F_r K])
      let B_r : Type u := TensorProduct P_r F_r S
      have : Algebra.Etale F_r B_r := Algebra.Etale.baseChange P_r S F_r
      have : Module.Finite F_r B_r := Module.Finite.of_quasiFinite
      let s_alg : S →ₐ[P_r] K :=
        { toRingHom := algebraMap S K
          commutes' := fun _ => rfl }
      let φ_BK : B_r →ₐ[F_r] K :=
        Algebra.TensorProduct.lift (Algebra.ofId F_r K) s_alg (fun _ _ => Commute.all _ _)
      have h_alg_FrK : Algebra.IsAlgebraic F_r K := by
        refine ⟨fun z => ?_⟩
        obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective (A := S) z
        have ha_int : _root_.IsIntegral F_r (algebraMap S K a) := by
          have h1 : _root_.IsIntegral F_r ((1 : F_r) ⊗ₜ[P_r] a : B_r) :=
            Algebra.IsIntegral.isIntegral _
          have h2 := _root_.IsIntegral.map φ_BK h1
          have heq : φ_BK ((1 : F_r) ⊗ₜ[P_r] a) = algebraMap S K a := by
            dsimp only [φ_BK]
            rw [Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, map_one, one_mul]
            rfl
          rwa [heq] at h2
        have hb_int : _root_.IsIntegral F_r (algebraMap S K (b : S)) := by
          have h1 : _root_.IsIntegral F_r ((1 : F_r) ⊗ₜ[P_r] (b : S) : B_r) :=
            Algebra.IsIntegral.isIntegral _
          have h2 := _root_.IsIntegral.map φ_BK h1
          have heq : φ_BK ((1 : F_r) ⊗ₜ[P_r] (b : S)) = algebraMap S K (b : S) := by
            dsimp only [φ_BK]
            rw [Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, map_one, one_mul]
            rfl
          rwa [heq] at h2
        let E : IntermediateField F_r K :=
          IntermediateField.adjoin F_r ({algebraMap S K a, algebraMap S K (b : S)} : Set K)
        have : FiniteDimensional F_r E := by
          apply IntermediateField.finiteDimensional_adjoin
          intro x hx
          rcases hx with rfl | hx'
          · exact ha_int
          · rw [Set.mem_singleton_iff.mp hx']
            exact hb_int
        have hz_mem : algebraMap S K a / algebraMap S K (b : S) ∈ E :=
          div_mem (IntermediateField.subset_adjoin F_r _ (Or.inl rfl))
            (IntermediateField.subset_adjoin F_r _ (Or.inr (Set.mem_singleton _)))
        have hz_int : _root_.IsIntegral F_r (⟨_, hz_mem⟩ : E) := Algebra.IsIntegral.isIntegral _
        exact (_root_.IsIntegral.map E.val hz_int).isAlgebraic
      have : FaithfulSMul k S :=
        (faithfulSMul_iff_algebraMap_injective k S).mpr (algebraMap k S).injective
      have : FaithfulSMul S K :=
        (faithfulSMul_iff_algebraMap_injective S K).mpr (IsFractionRing.injective S K)
      have : FaithfulSMul k P_r :=
        (faithfulSMul_iff_algebraMap_injective k P_r).mpr (algebraMap k P_r).injective
      have : FaithfulSMul P_r F_r :=
        (faithfulSMul_iff_algebraMap_injective P_r F_r).mpr (IsFractionRing.injective P_r F_r)
      have : FaithfulSMul k F_r :=
        (faithfulSMul_iff_algebraMap_injective k F_r).mpr (algebraMap k F_r).injective
      have : FaithfulSMul F_r K :=
        (faithfulSMul_iff_algebraMap_injective F_r K).mpr (algebraMap F_r K).injective
      have : Algebra.IsAlgebraic P_r F_r := IsLocalization.isAlgebraic F_r (nonZeroDivisors P_r)
      have : Algebra.IsAlgebraic S K := IsLocalization.isAlgebraic K (nonZeroDivisors S)
      have h_tr_kPr : Algebra.trdeg k P_r = (r : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
      have h_tr_PrFr : Algebra.trdeg P_r F_r = 0 := trdeg_eq_zero
      have h_tr_kFr : Algebra.trdeg k F_r = (r : Cardinal.{u}) := by
        have hadd := trdeg_add_eq k P_r (A := F_r)
        rw [h_tr_kPr, h_tr_PrFr, add_zero] at hadd
        exact hadd.symm
      have h_tr_FrK : Algebra.trdeg F_r K = 0 := @trdeg_eq_zero F_r K _ _ _ h_alg_FrK
      have h_tr_kK : Algebra.trdeg k K = (r : Cardinal.{u}) := by
        have hadd := trdeg_add_eq k F_r (A := K)
        rw [h_tr_kFr, h_tr_FrK, add_zero] at hadd
        exact hadd.symm
      have h_tr_SK : Algebra.trdeg S K = 0 := trdeg_eq_zero
      have hadd_S := trdeg_add_eq k S (A := K)
      rw [h_tr_SK, add_zero] at hadd_S
      exact hadd_S.trans h_tr_kK

    intro A _ _ _ _ h_trdeg_A
    let K : Type u := FractionRing A
    let L₀ : Type u := Localization.AtPrime (⊥ : Ideal A)
    have : IsLocalization (nonZeroDivisors A) L₀ :=
      { map_units := fun y =>
          IsLocalization.map_units (M := (⊥ : Ideal A).primeCompl) L₀
            (⟨y.1, fun hy0 => mem_nonZeroDivisors_iff_ne_zero.mp y.2 (Ideal.mem_bot.mp hy0)⟩ :
              (⊥ : Ideal A).primeCompl)
        surj := fun z => by
          obtain ⟨⟨x, s⟩, hzs⟩ := IsLocalization.surj (⊥ : Ideal A).primeCompl z
          exact ⟨⟨x, ⟨s.1, mem_nonZeroDivisors_iff_ne_zero.mpr
            (fun hs0 => s.2 (Ideal.mem_bot.mpr hs0))⟩⟩, hzs⟩
        exists_of_eq := fun {x₁ x₂} h_eq => by
          obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := (⊥ : Ideal A).primeCompl) h_eq
          exact ⟨⟨c.1, mem_nonZeroDivisors_iff_ne_zero.mpr
            (fun hc0 => c.2 (Ideal.mem_bot.mpr hc0))⟩, hc⟩ }
    let e_A : K ≃ₐ[A] L₀ := IsLocalization.algEquiv (nonZeroDivisors A) K L₀
    let e_k : K ≃ₐ[k] L₀ := e_A.restrictScalars k
    have : PerfectField k := IsAlgClosed.perfectField k
    have : Algebra.EssFiniteType A K :=
      Algebra.EssFiniteType.of_isLocalization K (nonZeroDivisors A)
    have : Algebra.EssFiniteType k K := Algebra.EssFiniteType.comp k A K
    have : Algebra.FormallySmooth k K := Algebra.FormallySmooth.of_perfectField
    have : Algebra.FormallySmooth k L₀ := Algebra.FormallySmooth.of_equiv e_k
    have : Algebra.IsSmoothAt k (⊥ : Ideal A) := ‹Algebra.FormallySmooth k L₀›
    have : Algebra.FinitePresentation k A :=
      (Algebra.FinitePresentation.of_finiteType).mp ‹Algebra.FiniteType k A›
    obtain ⟨h, hh_not, hStd⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth k (⊥ : Ideal A)
    have hh_ne : h ≠ 0 := by simpa using hh_not
    obtain ⟨ι, σ, hσ, hι, ⟨P_pres⟩⟩ :=
      @Algebra.IsStandardSmooth.out k (Localization.Away h) _ _ _ hStd
    let r : ℕ := P_pres.dimension
    have hStd_r : Algebra.IsStandardSmoothOfRelativeDimension r k (Localization.Away h) :=
      ⟨⟨ι, σ, hσ, hι, P_pres, rfl⟩⟩
    let S : Type u := Localization.Away h
    have h_pow_le : Submonoid.powers h ≤ nonZeroDivisors A :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hh_ne)
    have : IsDomain S := IsLocalization.isDomain_localization h_pow_le
    have : FaithfulSMul k A :=
      (faithfulSMul_iff_algebraMap_injective k A).mpr (algebraMap k A).injective
    have : FaithfulSMul A S :=
      (faithfulSMul_iff_algebraMap_injective A S).mpr
        (IsLocalization.injective S h_pow_le)
    have : Algebra.IsAlgebraic A S := IsLocalization.isAlgebraic S (Submonoid.powers h)
    have h_tr_AS : Algebra.trdeg A S = 0 := trdeg_eq_zero
    have h_tr_kS_eq : Algebra.trdeg k A = Algebra.trdeg k S := by
      have hadd := trdeg_add_eq k A (A := S)
      rw [h_tr_AS, add_zero] at hadd
      exact hadd
    have h_tr_kS : Algebra.trdeg k S = (r : Cardinal.{u}) := h_etale_trdeg r S hStd_r
    have hr_eq : r = m :=
      Nat.cast_injective (h_tr_kS.symm.trans (h_tr_kS_eq.symm.trans h_trdeg_A.symm))
    exact ⟨h, hh_ne, hr_eq ▸ hStd_r⟩

  
  
  
  have hAwaySmooth : ∀ (C : TopologicalSpace.Closeds ↥V_norm.left)
      (U : V_norm.left.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (W : Set V_norm.left),
      (C : Set V_norm.left) ∩ (U : Set V_norm.left) = W ∩ (U : Set V_norm.left) →
      ∀ (h : ↑(V_norm.left.presheaf.obj (Opposite.op U)) ⧸
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).ideal ⟨U, hU⟩),
        h ≠ 0 →
        (letI : Algebra k (↑(V_norm.left.presheaf.obj (Opposite.op U)) ⧸
            (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).ideal ⟨U, hU⟩) :=
          ((Ideal.Quotient.mk
            ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).ideal ⟨U, hU⟩)).comp
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              V_norm.hom.appLE ⊤ U le_top).hom)).toAlgebra
        Algebra.IsStandardSmoothOfRelativeDimension m k (Localization.Away h)) →
        let I_C := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C
        let Z := I_C.subscheme
        let ι := I_C.subschemeι
        ∃ (O : Z.Opens) (B : Set V_norm.left),
          IsOpen B ∧
          (W ∩ B).Nonempty ∧
          (O : Set Z) = ι.base ⁻¹' B ∧
          AlgebraicGeometry.IsAffineOpen O ∧
          RingHom.IsStandardSmoothOfRelativeDimension m ((ι ≫ V_norm.hom).appLE ⊤ O le_top).hom := by
    intro C U hU W hCW h hh_ne hSm_h I_C Z ι
    let R_k := CommRingCat.of k
    let R_U : Type u := ↑(V_norm.left.presheaf.obj (Opposite.op U))
    let A : Type u := R_U ⧸ I_C.ideal ⟨U, hU⟩
    let φ_A : k →+* A :=
      (Ideal.Quotient.mk (I_C.ideal ⟨U, hU⟩)).comp
        (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ V_norm.hom.appLE ⊤ U le_top).hom)
    let : Algebra k A := φ_A.toAlgebra
    have hStd_alg : Algebra.IsStandardSmoothOfRelativeDimension m k (Localization.Away h) := hSm_h
    obtain ⟨h_tilde, hh_tilde⟩ := Ideal.Quotient.mk_surjective h
    let B₀ : V_norm.left.Opens := V_norm.left.basicOpen h_tilde
    let B : Set V_norm.left := (B₀ : Set V_norm.left)
    have hBU : B ⊆ (U : Set V_norm.left) := V_norm.left.basicOpen_le h_tilde

    have hWB_ne : (W ∩ B).Nonempty := by
      by_contra hEmpty
      rw [Set.not_nonempty_iff_eq_empty] at hEmpty
      have hCB_empty : (C : Set V_norm.left) ∩ B = ∅ := by
        calc (C : Set V_norm.left) ∩ B
            = ((C : Set V_norm.left) ∩ (U : Set V_norm.left)) ∩ B := by
                rw [Set.inter_assoc, Set.inter_eq_self_of_subset_right hBU]
          _ = (W ∩ (U : Set V_norm.left)) ∩ B := by rw [hCW]
          _ = W ∩ B := by rw [Set.inter_assoc, Set.inter_eq_self_of_subset_right hBU]
          _ = ∅ := hEmpty
      have h_in_id : h_tilde ∈ I_C.ideal ⟨U, hU⟩ := by
        dsimp [I_C]
        rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal,
          PrimeSpectrum.mem_vanishingIdeal]
        intro q hqC
        by_contra hq_not
        have hq_bo : q ∈ PrimeSpectrum.basicOpen h_tilde :=
          (PrimeSpectrum.mem_basicOpen h_tilde q).mpr hq_not
        have hq_pre : q ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj B₀ := by
          rwa [AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hU h_tilde]
        have h_in_CB : hU.fromSpec.base q ∈ (C : Set V_norm.left) ∩ B := ⟨hqC, hq_pre⟩
        rw [hCB_empty] at h_in_CB
        exact h_in_CB
      apply hh_ne
      rw [← hh_tilde]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr h_in_id

    let V_U : Z.Opens := (TopologicalSpace.Opens.map ι.base).obj U
    have hAff_VU : AlgebraicGeometry.IsAffineOpen V_U :=
      AlgebraicGeometry.IsAffineHom.isAffine_preimage U hU
    let g_O : ↑(Z.presheaf.obj (Opposite.op V_U)) := (ι.app U).hom h_tilde
    let O : Z.Opens := Z.basicOpen g_O
    have hO_pre : (O : Set Z) = ι.base ⁻¹' B := by
      have h_eq : (TopologicalSpace.Opens.map ι.base).obj B₀ = O :=
        AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι h_tilde
      exact congrArg (fun V : Z.Opens => (V : Set Z)) h_eq.symm
    have hAff_O : AlgebraicGeometry.IsAffineOpen O := hAff_VU.basicOpen g_O
    have hOVU : O ≤ V_U := Z.basicOpen_le g_O

    let R_VU : Type u := ↑(Z.presheaf.obj (Opposite.op V_U))
    let R_O : Type u := ↑(Z.presheaf.obj (Opposite.op O))
    let res_VO : Z.presheaf.obj (Opposite.op V_U) ⟶ Z.presheaf.obj (Opposite.op O) :=
      Z.presheaf.map (CategoryTheory.homOfLE hOVU).op
    let : Algebra R_VU R_O := res_VO.hom.toAlgebra
    have : IsLocalization.Away g_O R_O := hAff_VU.isLocalization_basicOpen g_O

    let e_AV : A ≃+* R_VU := (I_C.subschemeObjIso ⟨U, hU⟩).symm.commRingCatIsoToRingEquiv
    have h_ι_app : ∀ r : R_U, (ι.app U).hom r = e_AV (Ideal.Quotient.mk (I_C.ideal ⟨U, hU⟩) r) := by
      intro r
      have happ := I_C.subschemeι_app ⟨U, hU⟩
      change (ι.app U).hom r = ((I_C.subschemeObjIso ⟨U, hU⟩).inv).hom
        (Ideal.Quotient.mk (I_C.ideal ⟨U, hU⟩) r)
      rw [happ]
      rfl
    have hg_eq : e_AV h = g_O := by
      rw [← hh_tilde, ← h_ι_app h_tilde]
    have h_pow_map : Submonoid.map e_AV.toMonoidHom (Submonoid.powers h) = Submonoid.powers g_O := by
      ext x
      simp only [Submonoid.mem_map, Submonoid.mem_powers_iff]
      refine ⟨?_, ?_⟩
      · rintro ⟨y, ⟨n, rfl⟩, rfl⟩
        refine ⟨n, ?_⟩
        change g_O ^ n = e_AV (h ^ n)
        rw [map_pow, hg_eq]
      · rintro ⟨n, rfl⟩
        refine ⟨h ^ n, ⟨n, rfl⟩, ?_⟩
        change e_AV (h ^ n) = g_O ^ n
        rw [map_pow, hg_eq]

    let e_loc : Localization.Away h ≃+* R_O :=
      IsLocalization.ringEquivOfRingEquiv (Localization.Away h) R_O e_AV h_pow_map

    have h_alg_sm : RingHom.IsStandardSmoothOfRelativeDimension m
        (algebraMap k (Localization.Away h)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap m).mpr hStd_alg
    let e_src : ↑((AlgebraicGeometry.Spec R_k).presheaf.obj (Opposite.op ⊤)) ≃+* k :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R_k).commRingCatIsoToRingEquiv
    have h_sm1 :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso m).right
        (algebraMap k (Localization.Away h)) e_src h_alg_sm
    have h_sm2 :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso m).left
        ((algebraMap k (Localization.Away h)).comp e_src.toRingHom) e_loc h_sm1

    have h_eq_hom : e_loc.toRingHom.comp
        ((algebraMap k (Localization.Away h)).comp e_src.toRingHom) =
        ((ι ≫ V_norm.hom).appLE ⊤ O le_top).hom := by
      have h_tower : algebraMap k (Localization.Away h) =
          (algebraMap A (Localization.Away h)).comp φ_A :=
        IsScalarTower.algebraMap_eq k A (Localization.Away h)
      have h_comp1 : (ι ≫ V_norm.hom).appLE ⊤ V_U le_top =
          V_norm.hom.appLE ⊤ U le_top ≫ ι.appLE U V_U le_rfl :=
        (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι V_norm.hom ⊤ U V_U le_top le_rfl).symm
      have h_app_eq : ι.appLE U V_U le_rfl = ι.app U := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE]
        have hid : (CategoryTheory.homOfLE
            (le_rfl : V_U ≤ (TopologicalSpace.Opens.map ι.base).obj U)).op =
            𝟙 (Opposite.op V_U) := Subsingleton.elim _ _
        rw [hid, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
      have h_res_O : (ι ≫ V_norm.hom).appLE ⊤ V_U le_top ≫ res_VO =
          (ι ≫ V_norm.hom).appLE ⊤ O le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map (ι ≫ V_norm.hom) le_top
          (CategoryTheory.homOfLE hOVU).op
      ext x
      have hx_inv : ((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom (e_src x) = x := by
        change (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom) x = x
        rw [CategoryTheory.Iso.hom_inv_id]
        rfl
      have h_phi_x : φ_A (e_src x) =
          Ideal.Quotient.mk (I_C.ideal ⟨U, hU⟩) ((V_norm.hom.appLE ⊤ U le_top).hom x) := by
        change Ideal.Quotient.mk _ ((V_norm.hom.appLE ⊤ U le_top).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom (e_src x))) = _
        rw [hx_inv]
      calc e_loc (algebraMap k (Localization.Away h) (e_src x))
          = e_loc (algebraMap A (Localization.Away h) (φ_A (e_src x))) := by
              rw [h_tower]; rfl
        _ = res_VO.hom (e_AV (φ_A (e_src x))) :=
              IsLocalization.ringEquivOfRingEquiv_eq _ _
        _ = res_VO.hom ((ι.app U).hom ((V_norm.hom.appLE ⊤ U le_top).hom x)) := by
              rw [h_phi_x, ← h_ι_app]
        _ = ((ι ≫ V_norm.hom).appLE ⊤ O le_top).hom x := by
              rw [← h_res_O, h_comp1, h_app_eq]; rfl

    rw [h_eq_hom] at h_sm2
    exact ⟨O, B, B₀.isOpen, hWB_ne, hO_pre, hAff_O, h_sm2⟩

  obtain ⟨S_div, Z_low, hFin_div, hW_props, hW_sep,
      hCl_divSet, hCl_low, hZ_eq, hDim_divSet, hDim_low, hDim_proper⟩ := hPartition

  let C_div : TopologicalSpace.Closeds ↥V_norm.left := ⟨⋃ W ∈ S_div, W, hCl_divSet⟩
  let I_div := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C_div
  let Z_div : AlgebraicGeometry.Scheme.{u} := I_div.subscheme
  let ι_div : Z_div ⟶ V_norm.left := I_div.subschemeι
  obtain ⟨hCl_div, hRed_div, hRange_div⟩ := hVanSub C_div
  have : AlgebraicGeometry.IsClosedImmersion ι_div := hCl_div

  have hZ_union : Z_closed = Set.range ι_div.base ∪ Z_low := by
    rw [hRange_div]
    exact hZ_eq
  have hDim_range : topologicalKrullDim ↥(Set.range ι_div.base) ≤ ((m : ℕ) : WithBot ℕ∞) := by
    have hRange' : Set.range ι_div.base = ⋃ W ∈ S_div, W := hRange_div
    exact hRange'.symm ▸ hDim_divSet

  let 𝒮_sm : Set Z_div.Opens :=
    { O : Z_div.Opens |
      AlgebraicGeometry.IsAffineOpen O ∧
      RingHom.IsStandardSmoothOfRelativeDimension m
        ((ι_div ≫ V_norm.hom).appLE ⊤ O le_top).hom }
  let U_sm_div : Z_div.Opens := sSup 𝒮_sm

  have hSm_U : AlgebraicGeometry.SmoothOfRelativeDimension m
      (U_sm_div.ι ≫ ι_div ≫ V_norm.hom) := by
    have h_isIso_Zdiv : ∀ {O₁ O₂ : Z_div.Opens} (hle : O₁ ≤ O₂), O₁ = O₂ →
        CategoryTheory.IsIso (Z_div.presheaf.map (CategoryTheory.homOfLE hle).op) := by
      intro O₁ O₂ hle hEq
      subst hEq
      have h_id : (CategoryTheory.homOfLE hle).op = 𝟙 (Opposite.op O₁) := Subsingleton.elim _ _
      rw [h_id, CategoryTheory.Functor.map_id]
      infer_instance
    refine ⟨fun z => ?_⟩
    obtain ⟨O, ⟨hO_aff, hO_sm⟩, hzO⟩ := TopologicalSpace.Opens.mem_sSup.mp z.2
    have hO_le : O ≤ U_sm_div := le_sSup ⟨hO_aff, hO_sm⟩
    let V_open : U_sm_div.toScheme.Opens := (TopologicalSpace.Opens.map U_sm_div.ι.base).obj O
    have hO_range : O ≤ U_sm_div.ι.opensRange := by
      rwa [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    have hV_aff : AlgebraicGeometry.IsAffineOpen V_open :=
      hO_aff.preimage_of_isOpenImmersion U_sm_div.ι hO_range
    have he : V_open ≤
        (TopologicalSpace.Opens.map (U_sm_div.ι ≫ ι_div ≫ V_norm.hom).base).obj ⊤ := le_top
    refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top _, V_open, hV_aff, hzO, he, ?_⟩
    have h_comp : (U_sm_div.ι ≫ (ι_div ≫ V_norm.hom)).appLE ⊤ V_open he =
        (ι_div ≫ V_norm.hom).appLE ⊤ O le_top ≫ U_sm_div.ι.appLE O V_open le_rfl :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE U_sm_div.ι (ι_div ≫ V_norm.hom)
        ⊤ O V_open le_top le_rfl).symm
    have : CategoryTheory.IsIso (U_sm_div.ι.appLE O V_open le_rfl) := by
      rw [AlgebraicGeometry.Scheme.Opens.ι_appLE U_sm_div O V_open le_rfl]
      apply h_isIso_Zdiv
      apply le_antisymm _ (fun w hw => ⟨⟨w, hO_le hw⟩, hw, rfl⟩)
      intro w hw
      rcases hw with ⟨u, hu, rfl⟩
      exact hu
    let e_tgt : ↑(Z_div.presheaf.obj (Opposite.op O)) ≃+*
        ↑(U_sm_div.toScheme.presheaf.obj (Opposite.op V_open)) :=
      (CategoryTheory.asIso (U_sm_div.ι.appLE O V_open le_rfl)).commRingCatIsoToRingEquiv
    have h_sm' :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso m).left
        ((ι_div ≫ V_norm.hom).appLE ⊤ O le_top).hom e_tgt hO_sm
    have h_hom_eq : e_tgt.toRingHom.comp ((ι_div ≫ V_norm.hom).appLE ⊤ O le_top).hom =
        ((U_sm_div.ι ≫ ι_div ≫ V_norm.hom).appLE ⊤ V_open he).hom := by
      rw [h_comp]
      rfl
    rwa [← h_hom_eq]

  let K_sing : Set V_norm.left := ι_div.base '' ((U_sm_div : Set Z_div)ᶜ)
  have hCl_Ksing : IsClosed K_sing :=
    ι_div.isClosedEmbedding.isClosedMap _ U_sm_div.isOpen.isClosed_compl
  have hSub_Ksing : K_sing ⊆ ⋃ W ∈ S_div, W := by
    rintro _ ⟨z, _, rfl⟩
    change ι_div.base z ∈ (C_div : Set V_norm.left)
    rw [← hRange_div]
    exact ⟨z, rfl⟩
  have hDim_Ksing : topologicalKrullDim ↥K_sing ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
    apply hDim_proper K_sing hCl_Ksing hSub_Ksing
    intro W hW hWK_eq
    obtain ⟨hClW, hIrrW, hDimW⟩ := hW_props W hW
    obtain ⟨x_W, hxW, hx_not_other⟩ := hW_sep W hW
    let F_other : Set V_norm.left := ⋃ W' ∈ S_div \ {W}, W'
    have hCl_other : IsClosed F_other :=
      hFin_div.sdiff.isClosed_biUnion (fun W' hW' => (hW_props W' hW'.1).1)
    let U_sep : V_norm.left.Opens := ⟨F_otherᶜ, hCl_other.isOpen_compl⟩
    obtain ⟨U_W, hAff_UW, hx_UW, hUW_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show x_W ∈ U_sep from hx_not_other)
    have hWU_ne : (W ∩ (U_W : Set V_norm.left)).Nonempty := ⟨x_W, hxW, hx_UW⟩
    have hCW : (C_div : Set V_norm.left) ∩ (U_W : Set V_norm.left) =
        W ∩ (U_W : Set V_norm.left) := by
      ext y
      simp only [Set.mem_inter_iff]
      refine ⟨fun ⟨hyC, hyU⟩ => ⟨?_, hyU⟩,
        fun ⟨hyW, hyU⟩ => ⟨Set.mem_biUnion hW hyW, hyU⟩⟩
      change y ∈ ⋃ W' ∈ S_div, W' at hyC
      simp only [Set.mem_iUnion, exists_prop] at hyC
      obtain ⟨W', hW', hyW'⟩ := hyC
      by_cases hEq : W' = W
      · rwa [← hEq]
      · exfalso
        exact hUW_sub hyU (Set.mem_biUnion ⟨hW', hEq⟩ hyW')
    let A_W : Type u := ↑(V_norm.left.presheaf.obj (Opposite.op U_W)) ⧸ I_div.ideal ⟨U_W, hAff_UW⟩
    let : Algebra k A_W :=
      ((Ideal.Quotient.mk (I_div.ideal ⟨U_W, hAff_UW⟩)).comp
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          V_norm.hom.appLE ⊤ U_W le_top).hom)).toAlgebra
    obtain ⟨hDom_AW, hFT_AW, hTr_AW⟩ :=
      hChartDom C_div W hClW hIrrW hDimW U_W hAff_UW hWU_ne hCW
    have : IsDomain A_W := hDom_AW
    have : Algebra.FiniteType k A_W := hFT_AW
    obtain ⟨h_W, hh_ne, hSm_hW⟩ := hGenSmooth A_W hTr_AW
    obtain ⟨O_W, B_W, _, ⟨y_W, hyW_W, hyW_B⟩, hO_pre, hAff_OW, hSm_OW⟩ :=
      hAwaySmooth C_div U_W hAff_UW W hCW h_W hh_ne hSm_hW
    have hOW_le : O_W ≤ U_sm_div := le_sSup ⟨hAff_OW, hSm_OW⟩
    have hy_Ksing : y_W ∈ K_sing := by
      have hy_inter : y_W ∈ W ∩ K_sing := by
        rw [hWK_eq]
        exact hyW_W
      exact hy_inter.2
    obtain ⟨z_W, hz_not_U, hz_eq⟩ := hy_Ksing
    have hz_OW : z_W ∈ O_W := by
      change z_W ∈ (O_W : Set Z_div)
      rw [hO_pre]
      change ι_div.base z_W ∈ B_W
      rwa [hz_eq]
    exact hz_not_U (hOW_le hz_OW)

  exact ⟨Z_div, ι_div, U_sm_div, Z_low, hCl_div, hRed_div, hCl_low,
    hZ_union, hDim_range, hDim_low, hSm_U, hDim_Ksing⟩

theorem weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint (k : Type u) [Field k] [IsAlgClosed k] (N : ℕ) :
    (∀ (Y : Set (weilProjectiveSpaceOver k N).left), IsClosed Y →
      ∀ (e : ℕ), 1 ≤ e → ((e : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Y →
      ∀ (F : MvPolynomial (Fin (N + 1)) k),
        F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 → F ≠ 0 →
        (Y ∩ weilProjHyperplaneSet k N F).Nonempty ∧
        (((e - 1 : ℕ) : WithBot ℕ∞) ≤
          topologicalKrullDim ↥(Y ∩ weilProjHyperplaneSet k N F))) ∧
    (∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_X : X ⟶ weilProjectiveSpaceOver k N),
      AlgebraicGeometry.IsClosedImmersion ι_X.left →
      ∀ (S₀ : Set X.left), IsClosed S₀ →
        topologicalKrullDim ↥S₀ ≤ (0 : WithBot ℕ∞) →
        ∀ (x : X.left), x ∈ S₀ →
          ∃ q_x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X.left,
            q_x ≫ X.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
            x ∈ Set.range q_x.base) :=
by
  
  have hPart12 :
      (TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N).left ∧
        ∃ (U : Fin (N + 1) → (weilProjectiveSpaceOver k N).left.Opens)
          (chartIso : ∀ α : Fin (N + 1),
            AlgebraicGeometry.Spec
              (CommRingCat.of (MvPolynomial {b : Fin (N + 1) // b ≠ α} k)) ≅
              (U α : AlgebraicGeometry.Scheme.{u})),
          (⋃ α : Fin (N + 1), (U α : Set (weilProjectiveSpaceOver k N).left)) = Set.univ ∧
          (∀ α : Fin (N + 1),
            (U α : Set (weilProjectiveSpaceOver k N).left) =
              (weilProjHyperplaneSet k N (MvPolynomial.X α))ᶜ) ∧
          (∀ α : Fin (N + 1),
            (chartIso α).hom ≫ (U α).ι ≫ (weilProjectiveSpaceOver k N).hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
          (∀ (α : Fin (N + 1)) (F : MvPolynomial (Fin (N + 1)) k),
            F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 →
            ∀ p : AlgebraicGeometry.Spec
                (CommRingCat.of (MvPolynomial {b : Fin (N + 1) // b ≠ α} k)),
              ((chartIso α).hom ≫ (U α).ι).base p ∈ weilProjHyperplaneSet k N F ↔
                MvPolynomial.eval₂Hom MvPolynomial.C
                  (fun j : Fin (N + 1) =>
                    if h : j = α then 1 else MvPolynomial.X ⟨j, h⟩) F ∈ p.asIdeal)) ∧
      (∀ (W : Set (weilProjectiveSpaceOver k N).left), IsClosed W →
        ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥W →
        ∀ (F : MvPolynomial (Fin (N + 1)) k),
          F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 →
          (W ∩ weilProjHyperplaneSet k N F).Nonempty) := by
    let P := MvPolynomial (Fin (N + 1)) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    refine ⟨?_, ?_⟩
    · let U : Fin (N + 1) → (weilProjectiveSpaceOver k N).left.Opens :=
        fun α => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X α)
      have hU_compl : ∀ α : Fin (N + 1),
          (U α : Set (weilProjectiveSpaceOver k N).left) =
            (weilProjHyperplaneSet k N (MvPolynomial.X α))ᶜ := by
        intro α
        dsimp [U, weilProjHyperplaneSet]
        exact (compl_compl _).symm
      have hCov : (⋃ α : Fin (N + 1), (U α : Set (weilProjectiveSpaceOver k N).left)) = Set.univ := by
        ext z
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        rw [Set.mem_iUnion]
        by_contra! hz_not
        have hX_mem : ∀ α : Fin (N + 1), MvPolynomial.X α ∈ z.asHomogeneousIdeal := by
          intro α
          have hmem_iff := AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X α) z
          exact not_not.mp (hmem_iff.not.mp (hz_not α))
        have hirrel : HomogeneousIdeal.irrelevant 𝒜 ≤ z.asHomogeneousIdeal := by
          intro p hp
          rw [HomogeneousIdeal.mem_irrelevant_iff] at hp
          have hp_zero : (DirectSum.decompose 𝒜 p 0 : P) = 0 := hp
          have hcoeff0 : p.coeff 0 = 0 := by
            classical
            conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 p]
            rw [MvPolynomial.coeff_sum]
            refine Finset.sum_eq_zero fun d _ => ?_
            by_cases hd : d = 0
            · subst hd
              rw [hp_zero]
              rfl
            · by_contra hne
              have hhom : (DirectSum.decompose 𝒜 p d : P).IsHomogeneous d :=
                (DirectSum.decompose 𝒜 p d).2
              have hdeg := hhom hne
              rw [map_zero] at hdeg
              exact hd hdeg.symm
          rw [MvPolynomial.as_sum p]
          refine Ideal.sum_mem z.asHomogeneousIdeal.toIdeal fun m hm => ?_
          have hm_ne : m ≠ 0 := by
            intro h0
            subst h0
            exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
          have hex : ∃ α : Fin (N + 1), m α ≠ 0 := by
            by_contra! hall
            apply hm_ne
            ext α
            exact hall α
          obtain ⟨α, hα_ne⟩ := hex
          let m' : Fin (N + 1) →₀ ℕ := m - Finsupp.single α 1
          have hm_eq : Finsupp.single α 1 + m' = m := by
            ext β
            simp only [Finsupp.add_apply, m', Finsupp.tsub_apply]
            by_cases hβα : β = α
            · subst hβα
              simp only [Finsupp.single_eq_same]
              omega
            · rw [Finsupp.single_apply, ite_eq_right_iff.mpr fun h => absurd h (Ne.symm hβα),
                zero_add, Nat.sub_zero]
          have hmon : MvPolynomial.monomial m (p.coeff m) =
              MvPolynomial.X α * MvPolynomial.monomial m' (p.coeff m) := by
            have hX1 : (MvPolynomial.X α : P) = MvPolynomial.monomial (Finsupp.single α 1) 1 := by
              simpa using (@MvPolynomial.X_pow_eq_monomial k (Fin (N + 1)) 1 α _)
            rw [hX1, MvPolynomial.monomial_mul_monomial, one_mul, hm_eq]
          rw [hmon]
          exact z.asHomogeneousIdeal.toIdeal.mul_mem_right _ (hX_mem α)
        exact z.not_irrelevant_le hirrel
      have hChartPkg : ∀ α : Fin (N + 1),
          ∃ (chartIso : AlgebraicGeometry.Spec
              (CommRingCat.of (MvPolynomial {b : Fin (N + 1) // b ≠ α} k)) ≅
              (U α : AlgebraicGeometry.Scheme.{u})),
            (chartIso.hom ≫ (U α).ι ≫ (weilProjectiveSpaceOver k N).hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
            (∀ (F : MvPolynomial (Fin (N + 1)) k),
              F ∈ 𝒜 1 →
              ∀ p : AlgebraicGeometry.Spec
                  (CommRingCat.of (MvPolynomial {b : Fin (N + 1) // b ≠ α} k)),
                (chartIso.hom ≫ (U α).ι).base p ∈ weilProjHyperplaneSet k N F ↔
                  MvPolynomial.eval₂Hom MvPolynomial.C
                    (fun j : Fin (N + 1) =>
                      if h : j = α then 1 else MvPolynomial.X ⟨j, h⟩) F ∈ p.asIdeal) := by
        intro α
        let τ := {b : Fin (N + 1) // b ≠ α}
        let P_α := MvPolynomial τ k
        let X_α : P := MvPolynomial.X α
        have hX_α : X_α ∈ 𝒜 1 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k α)
        let S_α : Submonoid P := Submonoid.powers X_α
        let R_α := HomogeneousLocalization.Away 𝒜 X_α
        let ι_k : k →+* R_α :=
          (HomogeneousLocalization.fromZeroRingHom 𝒜 S_α).comp (algebraMap k ↥(𝒜 0))
        let u_α : τ → R_α := fun b =>
          HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X b.1,
              (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k b.1)⟩,
              ⟨X_α, hX_α⟩, ⟨1, pow_one X_α⟩⟩
        let Φ_α : P_α →+* R_α := MvPolynomial.eval₂Hom ι_k u_α
        let w_α : Fin (N + 1) → P_α :=
          fun j => if h : j = α then 1 else MvPolynomial.X ⟨j, h⟩
        let dehom_α : P →+* P_α := MvPolynomial.eval₂Hom MvPolynomial.C w_α
        have h_dehom_S : ∀ y : S_α, dehom_α y.1 = 1 := by
          intro y
          obtain ⟨n, hn⟩ := y.2
          have hX_one : dehom_α X_α = 1 := by
            change MvPolynomial.eval₂Hom MvPolynomial.C w_α (MvPolynomial.X α) = 1
            rw [MvPolynomial.eval₂Hom_X']
            dsimp only [w_α]
            split_ifs with h
            · rfl
            · exact absurd rfl h
          change dehom_α y.1 = 1
          rw [← hn, map_pow, hX_one, one_pow]
        have h_unit_S : ∀ y : S_α, IsUnit (dehom_α y.1) := by
          intro y
          rw [h_dehom_S y]
          exact isUnit_one
        let β_loc : Localization S_α →+* P_α := IsLocalization.lift h_unit_S
        have h_β_mk : ∀ (p : P) (y : S_α), β_loc (Localization.mk p y) = dehom_α p := by
          intro p y
          have hmul : Localization.mk p y * algebraMap P (Localization S_α) y.1 =
              algebraMap P (Localization S_α) p := by
            rw [← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_comm p y.1, ← Localization.mk_mul,
              Localization.mk_self, one_mul]
          have hmap := congrArg β_loc hmul
          rw [map_mul, IsLocalization.lift_eq, IsLocalization.lift_eq, h_dehom_S y, mul_one] at hmap
          exact hmap
        let valHom : R_α →+* Localization S_α :=
          { toFun := HomogeneousLocalization.val
            map_one' := HomogeneousLocalization.val_one
            map_mul' := HomogeneousLocalization.val_mul
            map_zero' := HomogeneousLocalization.val_zero
            map_add' := HomogeneousLocalization.val_add }
        let Ψ_α : R_α →+* P_α := β_loc.comp valHom
        have h_ιk_val : ∀ c : k, (ι_k c).val = Localization.mk (MvPolynomial.C c) 1 :=
          fun _ => rfl
        have h_left : ∀ q : P_α, Ψ_α (Φ_α q) = q := by
          have hcomp : Ψ_α.comp Φ_α = RingHom.id P_α := by
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro c
              change β_loc ((Φ_α (MvPolynomial.C c)).val) = MvPolynomial.C c
              have h1 : Φ_α (MvPolynomial.C c) = ι_k c := MvPolynomial.eval₂Hom_C ι_k u_α c
              rw [h1, h_ιk_val c, h_β_mk]
              exact MvPolynomial.eval₂Hom_C MvPolynomial.C w_α c
            · intro b
              change β_loc ((Φ_α (MvPolynomial.X b)).val) = MvPolynomial.X b
              have h1 : Φ_α (MvPolynomial.X b) = u_α b := MvPolynomial.eval₂Hom_X' ι_k u_α b
              rw [h1, HomogeneousLocalization.val_mk, h_β_mk]
              have h2 : dehom_α (MvPolynomial.X b.1) = w_α b.1 :=
                MvPolynomial.eval₂Hom_X' MvPolynomial.C w_α b.1
              rw [h2]
              dsimp only [w_α]
              split_ifs with h
              · exact absurd h b.2
              · rfl
          intro q
          exact RingHom.congr_fun hcomp q
        let y₁ : S_α := ⟨X_α, ⟨1, pow_one X_α⟩⟩
        let Θ_α : P →+* Localization S_α := valHom.comp (Φ_α.comp dehom_α)
        have hΘ_C : ∀ c : k, Θ_α (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
          intro c
          change (Φ_α (dehom_α (MvPolynomial.C c))).val = _
          have h1 : dehom_α (MvPolynomial.C c) = MvPolynomial.C c :=
            MvPolynomial.eval₂Hom_C MvPolynomial.C w_α c
          have h2 : Φ_α (MvPolynomial.C c) = ι_k c :=
            MvPolynomial.eval₂Hom_C ι_k u_α c
