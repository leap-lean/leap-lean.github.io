      rw [IsLocalization.Away.lift_eq g hev_g_unit]
      change (π_mod b) i_star = a
      rw [hb]
      simp [f_a]
    let ϖ_g : B_g := algebraMap ↥Ox₀ B_g ϖ₀
    have hϖ_g_eq : ϖ_g = algebraMap B₀ B_g ϖ_B₀ := rfl
    let J_g : Ideal B_g := Ideal.span {ϖ_g}
    have hker_ψ_res : RingHom.ker ψ_res = J_g := by
      apply le_antisymm
      · intro z hz
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers g) z
        have hev_b : ev_star b = 0 := by
