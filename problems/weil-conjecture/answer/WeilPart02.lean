        exact hG1
      rw [← HomogeneousLocalization.algebraMap_apply (∑ d ∈ G.support, _), map_sum]
      have h_term : ∀ d ∈ G.support,
          (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ))
