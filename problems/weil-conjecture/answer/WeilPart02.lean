          rw [← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (MvPolynomial.X α₀) hXα hpos,
            ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (MvPolynomial.X α₀) hXα hpos,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
        calc V.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ_αk
            = (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (ι_0.left.appLE D_α V hVα)) ≫
                AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X α₀)))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
                simp only [φ_αk, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = ι_0.left.resLE D_α V hVα ≫
                (D_α.toSpecΓ ≫ AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X α₀)))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
                rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]
                simp only [CategoryTheory.Category.assoc]
          _ = ι_0.left.resLE D_α V hVα ≫
                ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α₀) hXα hpos).hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                    (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X α₀))))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
                rw [hiso_α]; simp only [CategoryTheory.Category.assoc]
          _ = (ι_0.left.resLE D_α V hVα ≫ D_α.ι) ≫
                (AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))) := by
                rw [haway_zero]; simp only [CategoryTheory.Category.assoc]
          _ = V.ι ≫ (ι_0.left ≫ P_N.hom) := by
                rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.assoc]
                rfl
          _ = V.ι ≫ X_0.hom := by
                rw [CategoryTheory.Over.w ι_0]
      · intro j hXj
        rw [hρ_eq, AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
        let nd_tj : HomogeneousLocalization.NumDenSameDeg 𝒜_ν (Submonoid.powers T_last) :=
          ⟨1, ⟨MvPolynomial.X j.castSucc, hXj⟩, ⟨T_last, hT⟩, Submonoid.mem_powers T_last⟩
        let t_j : HomogeneousLocalization.Away 𝒜_ν T_last := HomogeneousLocalization.mk nd_tj
        let hp_Xα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N + 1)) k) ∈
            Submonoid.powers (MvPolynomial.X α₀) := ⟨1, pow_one _⟩
        let nd_G : HomogeneousLocalization.NumDenSameDeg 𝒜_N (Submonoid.powers (MvPolynomial.X α₀)) :=
          ⟨1, ⟨G, hG⟩, ⟨MvPolynomial.X α₀, hXα⟩, hp_Xα⟩
        let nd_Fj : HomogeneousLocalization.NumDenSameDeg 𝒜_N (Submonoid.powers (MvPolynomial.X α₀)) :=
          ⟨1, ⟨F j, hSlice.1 j⟩, ⟨MvPolynomial.X α₀, hXα⟩, hp_Xα⟩
        let γ_G : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α₀) := HomogeneousLocalization.mk nd_G
        let γ_Fj : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α₀) := HomogeneousLocalization.mk nd_Fj
        change θ_mul (HomogeneousLocalization.awayMap 𝒜_N hXα (mul_comm (MvPolynomial.X α₀) G) (Φ_loc t_j)) *
            (X_0.left.presheaf.map (CategoryTheory.homOfLE hW₀V).op).hom
              ((AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀) ≫
                ι_0.left.appLE D_α V hVα).hom γ_G) =
          (X_0.left.presheaf.map (CategoryTheory.homOfLE hW₀V).op).hom
            ((AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀) ≫
              ι_0.left.appLE D_α V hVα).hom γ_Fj)
        rw [← hθ_α γ_G, ← hθ_α γ_Fj, ← map_mul]
        congr 1
        have hΦ_tj : Φ_loc t_j =
            HomogeneousLocalization.Away.mk 𝒜_N hG 1 (F j) (by rw [one_smul]; exact hSlice.1 j) := by
          apply HomogeneousLocalization.val_injective
          have hmap_tj : Φ_loc t_j = HomogeneousLocalization.map g_hom hsub' (HomogeneousLocalization.mk nd_tj) := rfl
          rw [hmap_tj, HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk_iff]
          apply Localization.r_of_eq
          simp [nd_tj, g_hom, T_last, pow_one]
        have hγ_G : γ_G =
            HomogeneousLocalization.Away.mk 𝒜_N hXα 1 G (by rw [one_smul]; exact hG) := by
          apply HomogeneousLocalization.val_injective
          have hmk : γ_G = HomogeneousLocalization.mk nd_G := rfl
          rw [hmk, HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk,
            Localization.mk_eq_mk_iff]
          apply Localization.r_of_eq
          simp [nd_G, pow_one]
        have hγ_Fj : γ_Fj =
            HomogeneousLocalization.Away.mk 𝒜_N hXα 1 (F j) (by rw [one_smul]; exact hSlice.1 j) := by
          apply HomogeneousLocalization.val_injective
          have hmk : γ_Fj = HomogeneousLocalization.mk nd_Fj := rfl
          rw [hmk, HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk,
            Localization.mk_eq_mk_iff]
          apply Localization.r_of_eq
          simp [nd_Fj, pow_one]
        rw [hΦ_tj, hγ_G, hγ_Fj,
          HomogeneousLocalization.awayMap_mk,
          HomogeneousLocalization.awayMap_mk,
          HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_mul, Localization.mk_eq_mk_iff]
        apply Localization.r_of_eq
        simp only [Submonoid.coe_mul, pow_one]
        ring

  
  have h_s1 : ∀ (s : ℕ) (R_V : Type u) [CommRing R_V]
      (φ : MvPolynomial (Fin (s + ν + d)) k →+* R_V)
      (_ : Function.Surjective φ)
      (q : Fin s → MvPolynomial (Fin (s + ν + d)) k)
      (_ : RingHom.ker φ = Ideal.span (Set.range q))
      (f_lift : Fin ν → MvPolynomial (Fin (s + ν + d)) k)
      (idx : Fin (s + ν) → Fin (s + ν + d))
      (_ : Function.Injective idx)
      (_ : IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + ν) =>
        φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a)))))
      (g_V : R_V),
      ∃ δ_V : R_V,
        (∀ (p : Ideal R_V), p.IsPrime →
          g_V ∉ p → (∀ j : Fin ν, φ (f_lift j) ∈ p) → δ_V ∉ p) ∧
        (∀ (R' : Type u) [CommRing R'] [Algebra R_V R']
            [IsLocalization.Away (g_V * δ_V) R']
            (ρ : MvPolynomial (Fin ν) k →+* R'),
          (∀ c : k, ρ (MvPolynomial.C c) = algebraMap R_V R' (φ (MvPolynomial.C c))) →
          (∀ j : Fin ν,
            ρ (MvPolynomial.X j) * algebraMap R_V R' g_V =
              algebraMap R_V R' (φ (f_lift j))) →
          RingHom.IsStandardSmoothOfRelativeDimension d ρ) := by
    intro s R_V _ φ hSurj q hKer f_lift idx hInj hDet g_V
    let n := s + ν + d
    obtain ⟨g_tilde, hg_tilde⟩ := hSurj g_V
    let M_qf : Matrix (Fin (s + ν)) (Fin (s + ν)) R_V :=
      Matrix.of fun a b : Fin (s + ν) =>
        φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))
    let M_tilde : Matrix (Fin (s + ν + 1)) (Fin (s + ν + 1)) (MvPolynomial (Fin n) k) :=
      Matrix.of fun r c =>
        Fin.lastCases
          (Fin.lastCases (g_tilde * g_tilde) (fun b => MvPolynomial.pderiv (idx b) g_tilde) c)
          (fun a => Fin.lastCases
            (Fin.addCases (fun _ : Fin s => (0 : MvPolynomial (Fin n) k))
              (fun j : Fin ν => g_tilde * f_lift j) a)
            (fun b => MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a)) c) r
    let δ_tilde : MvPolynomial (Fin n) k := Matrix.det M_tilde
    let δ_V : R_V := φ δ_tilde
    refine ⟨δ_V, ?_, ?_⟩
    · intro p hp hg_not hf_mem hδ_mem
      have : p.IsPrime := hp
      let π_p : R_V →+* R_V ⧸ p := Ideal.Quotient.mk p
      have hπ_δ : π_p δ_V = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hδ_mem
      have hg_ne : π_p g_V ≠ 0 := fun h0 => hg_not (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      have hdet_qf_ne : π_p (Matrix.det M_qf) ≠ 0 := (hDet.map π_p).ne_zero
      have hdet_eq : π_p δ_V = (π_p g_V * π_p g_V) * π_p (Matrix.det M_qf) := by
        change (π_p.comp φ) (Matrix.det M_tilde) = _
        rw [RingHom.map_det, Matrix.det_succ_column _ (Fin.last (s + ν)), Fin.sum_univ_castSucc]
        have hsum0 : (∑ a : Fin (s + ν),
            (-1 : R_V ⧸ p) ^ (a.castSucc.1 + (Fin.last (s + ν)).1) *
              ((π_p.comp φ).mapMatrix M_tilde) a.castSucc (Fin.last (s + ν)) *
              Matrix.det (((π_p.comp φ).mapMatrix M_tilde).submatrix
                a.castSucc.succAbove (Fin.last (s + ν)).succAbove)) = 0 := by
          refine Finset.sum_eq_zero fun a _ => ?_
          have hentry : ((π_p.comp φ).mapMatrix M_tilde) a.castSucc (Fin.last (s + ν)) = 0 := by
            change π_p (φ (M_tilde a.castSucc (Fin.last (s + ν)))) = 0
            simp only [M_tilde, Matrix.of_apply, Fin.lastCases_castSucc, Fin.lastCases_last]
            refine Fin.addCases (fun a₀ => ?_) (fun j => ?_) a
            · simp only [Fin.addCases_left, map_zero]
            · simp only [Fin.addCases_right, map_mul, hg_tilde]
              rw [Ideal.Quotient.eq_zero_iff_mem.mpr (hf_mem j), mul_zero]
          rw [hentry, mul_zero, zero_mul]
        rw [hsum0, zero_add]
        have hsign : (-1 : R_V ⧸ p) ^ ((Fin.last (s + ν)).1 + (Fin.last (s + ν)).1) = 1 := by
          have heven : (Fin.last (s + ν)).1 + (Fin.last (s + ν)).1 = 2 * (s + ν) := by
            simp [Fin.val_last]; omega
          rw [heven, pow_mul]
          norm_num
        have hlast_entry : ((π_p.comp φ).mapMatrix M_tilde) (Fin.last (s + ν)) (Fin.last (s + ν)) =
            π_p g_V * π_p g_V := by
          change π_p (φ (M_tilde (Fin.last (s + ν)) (Fin.last (s + ν)))) = _
          simp only [M_tilde, Matrix.of_apply, Fin.lastCases_last, map_mul, hg_tilde]
        have hsub_mat : (((π_p.comp φ).mapMatrix M_tilde).submatrix
            (Fin.last (s + ν)).succAbove (Fin.last (s + ν)).succAbove) =
            π_p.mapMatrix M_qf := by
          ext a b
          rw [Fin.succAbove_last]
          change π_p (φ (M_tilde a.castSucc b.castSucc)) = π_p (M_qf a b)
          simp only [M_tilde, M_qf, Matrix.of_apply, Fin.lastCases_castSucc]
        rw [hsign, one_mul, hlast_entry, hsub_mat, ← RingHom.map_det]
      rw [hdet_eq] at hπ_δ
      exact mul_ne_zero (mul_ne_zero hg_ne hg_ne) hdet_qf_ne hπ_δ
    · intro R' _ _ _ ρ hρ_C hρ_X
      let P_ν := MvPolynomial (Fin ν) k
      let _ : Algebra P_ν R' := ρ.toAlgebra
      change @Algebra.IsStandardSmoothOfRelativeDimension d P_ν R' _ _ ρ.toAlgebra
      let w₀ : R' := IsLocalization.Away.invSelf (S := R') (g_V * δ_V)
      have hw₀ : algebraMap R_V R' (g_V * δ_V) * w₀ = 1 :=
        IsLocalization.Away.mul_invSelf (g_V * δ_V)
      let z_den : R' := algebraMap R_V R' δ_V * w₀
      let z_jac : R' := algebraMap R_V R' g_V * w₀
      have hg_den : algebraMap R_V R' g_V * z_den = 1 := by
        dsimp only [z_den]
        rw [← mul_assoc, ← map_mul, hw₀]
      have hδ_jac : algebraMap R_V R' δ_V * z_jac = 1 := by
        dsimp only [z_jac]
        rw [← mul_assoc, ← map_mul, mul_comm δ_V g_V, hw₀]
      have hgδ_inv : algebraMap R_V R' (g_V * δ_V) * (z_den * z_jac) = 1 := by
        calc algebraMap R_V R' (g_V * δ_V) * (z_den * z_jac)
            = (algebraMap R_V R' g_V * z_den) * (algebraMap R_V R' δ_V * z_jac) := by
                rw [map_mul]; ring
          _ = 1 * 1 := by rw [hg_den, hδ_jac]
          _ = 1 := one_mul 1
      have hρ_X_eq : ∀ j : Fin ν, ρ (MvPolynomial.X j) =
          z_den * algebraMap R_V R' (φ (f_lift j)) := by
        intro j
        calc ρ (MvPolynomial.X j)
            = ρ (MvPolynomial.X j) * (algebraMap R_V R' g_V * z_den) := by
                rw [hg_den, mul_one]
          _ = (ρ (MvPolynomial.X j) * algebraMap R_V R' g_V) * z_den := (mul_assoc _ _ _).symm
          _ = z_den * algebraMap R_V R' (φ (f_lift j)) := by rw [hρ_X j, mul_comm]
      let val : Fin (n + 2) → R' :=
        Fin.lastCases z_jac (Fin.lastCases z_den (fun i => algebraMap R_V R' (φ (MvPolynomial.X i))))
      let ι_var : Fin n → Fin (n + 2) := fun i => i.castSucc.castSucc
      have hι_inj : Function.Injective ι_var :=
        Fin.castSucc_injective (n + 1) |>.comp (Fin.castSucc_injective n)
      let v_den : Fin (n + 2) := (Fin.last n).castSucc
      let v_jac : Fin (n + 2) := Fin.last (n + 1)
      have hval_var : ∀ i : Fin n, val (ι_var i) = algebraMap R_V R' (φ (MvPolynomial.X i)) := by
        intro i
        simp only [val, ι_var, Fin.lastCases_castSucc]
      have hval_den : val v_den = z_den := by
        simp only [val, v_den, Fin.lastCases_castSucc, Fin.lastCases_last]
      have hval_jac : val v_jac = z_jac := by
        simp only [val, v_jac, Fin.lastCases_last]
      let Z₁ : MvPolynomial (Fin (n + 2)) P_ν := MvPolynomial.X v_den
      let Z₂ : MvPolynomial (Fin (n + 2)) P_ν := MvPolynomial.X v_jac
      let ι_amb : MvPolynomial (Fin (n + 2)) k →+* MvPolynomial (Fin (n + 2)) P_ν :=
        MvPolynomial.map MvPolynomial.C
      let Λ : MvPolynomial (Fin n) k →+* MvPolynomial (Fin (n + 2)) P_ν :=
        ι_amb.comp (MvPolynomial.rename ι_var).toRingHom
      have hΛ_apply : ∀ p : MvPolynomial (Fin n) k,
          Λ p = MvPolynomial.map MvPolynomial.C (MvPolynomial.rename ι_var p) := fun _ => rfl
      let ev : MvPolynomial (Fin (n + 2)) P_ν →+* R' :=
        (@MvPolynomial.aeval P_ν R' (Fin (n + 2)) _ _ ρ.toAlgebra val).toRingHom
      have hev_C : ∀ p : P_ν, ev (MvPolynomial.C p) = ρ p := by
        intro p
        exact @MvPolynomial.aeval_C P_ν R' (Fin (n + 2)) _ _ ρ.toAlgebra val p
      have hev_X : ∀ v : Fin (n + 2), ev (MvPolynomial.X v) = val v := by
        intro v
        exact @MvPolynomial.aeval_X P_ν R' (Fin (n + 2)) _ _ ρ.toAlgebra val v
      have hev_Λ : ev.comp Λ = (algebraMap R_V R').comp φ := by
        apply MvPolynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          simp only [RingHom.comp_apply, hΛ_apply, MvPolynomial.rename_C,
            MvPolynomial.map_C, hev_C, hρ_C]
        · intro i
          simp only [RingHom.comp_apply, hΛ_apply, MvPolynomial.rename_X,
            MvPolynomial.map_X, hev_X, hval_var]
      have hSurj_ev : Function.Surjective (@MvPolynomial.aeval P_ν R' (Fin (n + 2)) _ _ ρ.toAlgebra val) := by
        intro y
        obtain ⟨m, a, hy_eq⟩ := IsLocalization.Away.surj (g_V * δ_V) y
        obtain ⟨a_tilde, ha_tilde⟩ := hSurj a
        refine ⟨Λ a_tilde * (Z₁ * Z₂) ^ m, ?_⟩
        change ev (Λ a_tilde * (Z₁ * Z₂) ^ m) = y
        rw [map_mul, map_pow, map_mul, hev_X, hev_X, hval_den, hval_jac]
        have ha_ev : ev (Λ a_tilde) = algebraMap R_V R' a := by
          rw [← ha_tilde]
          exact RingHom.congr_fun hev_Λ a_tilde
        rw [ha_ev, ← hy_eq, mul_assoc, ← mul_pow, hgδ_inv, one_pow, mul_one]
      let G_gen : @Algebra.Generators P_ν R' (Fin (n + 2)) _ _ ρ.toAlgebra :=
        @Algebra.Generators.ofSurjective P_ν R' (Fin (n + 2)) _ _ ρ.toAlgebra val hSurj_ev
      let rel : Fin (s + ν + 2) → MvPolynomial (Fin (n + 2)) P_ν :=
        Fin.lastCases (Z₂ * Λ δ_tilde - 1)
          (Fin.lastCases (Z₁ * Λ g_tilde - 1)
            (Fin.addCases
              (fun a₀ : Fin s => Λ (q a₀))
              (fun j : Fin ν => Z₁ * Λ (f_lift j) - MvPolynomial.C (MvPolynomial.X j))))
      let I_rel : Ideal (MvPolynomial (Fin (n + 2)) P_ν) := Ideal.span (Set.range rel)
      have hmem_I : ∀ r : Fin (s + ν + 2), rel r ∈ I_rel :=
        fun r => Ideal.subset_span ⟨r, rfl⟩
      have hI_le_ker : I_rel ≤ RingHom.ker ev := by
        rw [Ideal.span_le]
        rintro _ ⟨r, rfl⟩
        change ev (rel r) = 0
        refine Fin.lastCases ?_ (fun r₀ => Fin.lastCases ?_ (fun a => Fin.addCases (fun a₀ => ?_) (fun j => ?_) a) r₀) r
        · simp only [rel, Fin.lastCases_last, map_sub, map_mul, map_one, Z₂, hev_X, hval_jac]
          have hδ_ev : ev (Λ δ_tilde) = algebraMap R_V R' δ_V := RingHom.congr_fun hev_Λ δ_tilde
          rw [hδ_ev, mul_comm z_jac, hδ_jac, sub_self]
        · simp only [rel, Fin.lastCases_castSucc, Fin.lastCases_last, map_sub, map_mul, map_one,
            Z₁, hev_X, hval_den]
          have hg_ev : ev (Λ g_tilde) = algebraMap R_V R' g_V := by
            rw [← hg_tilde]
            exact RingHom.congr_fun hev_Λ g_tilde
          rw [hg_ev, mul_comm z_den, hg_den, sub_self]
        · simp only [rel, Fin.lastCases_castSucc, Fin.addCases_left]
          have hq_ev : ev (Λ (q a₀)) = algebraMap R_V R' (φ (q a₀)) := RingHom.congr_fun hev_Λ (q a₀)
          have hq0 : φ (q a₀) = 0 := by
            rw [← RingHom.mem_ker, hKer]
            exact Ideal.subset_span ⟨a₀, rfl⟩
          rw [hq_ev, hq0, map_zero]
        · simp only [rel, Fin.lastCases_castSucc, Fin.addCases_right, map_sub, map_mul, Z₁, hev_X,
            hval_den, hev_C]
          have hf_ev : ev (Λ (f_lift j)) = algebraMap R_V R' (φ (f_lift j)) :=
            RingHom.congr_fun hev_Λ (f_lift j)
          rw [hf_ev, hρ_X_eq j, sub_self]
      let z₁_k : MvPolynomial (Fin (n + 2)) k := MvPolynomial.X v_den
      let z₂_k : MvPolynomial (Fin (n + 2)) k := MvPolynomial.X v_jac
      let g₀ : MvPolynomial (Fin (n + 2)) k := MvPolynomial.rename ι_var g_tilde
      let δ₀ : MvPolynomial (Fin (n + 2)) k := MvPolynomial.rename ι_var δ_tilde
      let π_coeff : P_ν →+* MvPolynomial (Fin (n + 2)) k :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun j : Fin ν => z₁_k * MvPolynomial.rename ι_var (f_lift j))
      let π_amb : MvPolynomial (Fin (n + 2)) P_ν →+* MvPolynomial (Fin (n + 2)) k :=
        MvPolynomial.eval₂Hom π_coeff MvPolynomial.X
      have hE_C : ∀ p : P_ν, ι_amb (π_amb (MvPolynomial.C p)) - MvPolynomial.C p ∈ I_rel := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C c =>
          have h1 : π_amb (MvPolynomial.C (MvPolynomial.C c)) = MvPolynomial.C c := by
            dsimp only [π_amb, π_coeff]
            rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
          rw [h1]
          simp only [ι_amb, MvPolynomial.map_C, sub_self]
          exact I_rel.zero_mem
        | add p₁ p₂ ih₁ ih₂ =>
          have h_eq : ι_amb (π_amb (MvPolynomial.C (p₁ + p₂))) - MvPolynomial.C (p₁ + p₂) =
              (ι_amb (π_amb (MvPolynomial.C p₁)) - MvPolynomial.C p₁) +
                (ι_amb (π_amb (MvPolynomial.C p₂)) - MvPolynomial.C p₂) := by
            simp only [map_add]; ring
          rw [h_eq]
          exact I_rel.add_mem ih₁ ih₂
        | mul_X p₁ j ih =>
          have hj_mem : ι_amb (π_amb (MvPolynomial.C (MvPolynomial.X j))) -
              MvPolynomial.C (MvPolynomial.X j) ∈ I_rel := by
            have h1 : π_amb (MvPolynomial.C (MvPolynomial.X j)) =
                z₁_k * MvPolynomial.rename ι_var (f_lift j) := by
              dsimp only [π_amb, π_coeff]
              rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
            have h_eq : ι_amb (π_amb (MvPolynomial.C (MvPolynomial.X j))) -
                MvPolynomial.C (MvPolynomial.X j) =
                rel ((Fin.natAdd s j).castSucc.castSucc) := by
              rw [h1]
              simp only [rel, Fin.lastCases_castSucc, Fin.addCases_right, hΛ_apply, ι_amb,
                map_mul, z₁_k, Z₁, MvPolynomial.map_X]
            rw [h_eq]
            exact hmem_I _
          have h_prod : ι_amb (π_amb (MvPolynomial.C (p₁ * MvPolynomial.X j))) -
              MvPolynomial.C (p₁ * MvPolynomial.X j) =
              ι_amb (π_amb (MvPolynomial.C p₁)) *
                (ι_amb (π_amb (MvPolynomial.C (MvPolynomial.X j))) - MvPolynomial.C (MvPolynomial.X j)) +
              (ι_amb (π_amb (MvPolynomial.C p₁)) - MvPolynomial.C p₁) *
                MvPolynomial.C (MvPolynomial.X j) := by
            simp only [map_mul]; ring
          rw [h_prod]
          exact I_rel.add_mem (I_rel.mul_mem_left _ hj_mem) (I_rel.mul_mem_right _ ih)
      have hE_all : ∀ P : MvPolynomial (Fin (n + 2)) P_ν, ι_amb (π_amb P) - P ∈ I_rel := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C p => exact hE_C p
        | add P₁ P₂ ih₁ ih₂ =>
          have h_eq : ι_amb (π_amb (P₁ + P₂)) - (P₁ + P₂) =
              (ι_amb (π_amb P₁) - P₁) + (ι_amb (π_amb P₂) - P₂) := by
            simp only [map_add]; ring
          rw [h_eq]
          exact I_rel.add_mem ih₁ ih₂
        | mul_X P₁ v ih =>
          have hv : ι_amb (π_amb (MvPolynomial.X v)) = MvPolynomial.X v := by
            simp only [π_amb, ι_amb, MvPolynomial.eval₂Hom_X', MvPolynomial.map_X]
          have h_eq : ι_amb (π_amb (P₁ * MvPolynomial.X v)) - P₁ * MvPolynomial.X v =
              (ι_amb (π_amb P₁) - P₁) * MvPolynomial.X v := by
            simp only [map_mul, hv]; ring
          rw [h_eq]
          exact I_rel.mul_mem_right _ ih
      let J_k : Ideal (MvPolynomial (Fin (n + 2)) k) :=
        Ideal.span (Set.range (fun a₀ : Fin s => MvPolynomial.rename ι_var (q a₀)) ∪
          {z₁_k * g₀ - 1, z₂_k * δ₀ - 1})
      have hq_J : ∀ a₀ : Fin s, MvPolynomial.rename ι_var (q a₀) ∈ J_k :=
        fun a₀ => Ideal.subset_span (Or.inl ⟨a₀, rfl⟩)
      have hz₁_J : z₁_k * g₀ - 1 ∈ J_k :=
        Ideal.subset_span (Or.inr (Set.mem_insert _ _))
      have hz₂_J : z₂_k * δ₀ - 1 ∈ J_k :=
        Ideal.subset_span (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      have hJ_to_I : Ideal.map ι_amb J_k ≤ I_rel := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨w, hw, rfl⟩
        rcases hw with ⟨a₀, rfl⟩ | hw_pair
        · have heq : ι_amb (MvPolynomial.rename ι_var (q a₀)) =
              rel ((Fin.castAdd ν a₀).castSucc.castSucc) := by
            simp only [rel, Fin.lastCases_castSucc, Fin.addCases_left, hΛ_apply, ι_amb]
          rw [heq]
          exact hmem_I _
        · rcases Set.mem_insert_iff.mp hw_pair with rfl | hw_single
          · have heq : ι_amb (z₁_k * g₀ - 1) = rel (Fin.last (s + ν)).castSucc := by
              simp only [rel, Fin.lastCases_castSucc, Fin.lastCases_last, map_sub, map_mul,
                map_one, hΛ_apply, ι_amb, z₁_k, g₀, Z₁, MvPolynomial.map_X]
            rw [heq]
            exact hmem_I _
          · rw [Set.mem_singleton_iff.mp hw_single]
            have heq : ι_amb (z₂_k * δ₀ - 1) = rel (Fin.last (s + ν + 1)) := by
              simp only [rel, Fin.lastCases_last, map_sub, map_mul, map_one, hΛ_apply, ι_amb,
                z₂_k, δ₀, Z₂, MvPolynomial.map_X]
            rw [heq]
            exact hmem_I _
      have hclear : ∀ Q : MvPolynomial (Fin (n + 2)) k,
          ∃ (d_Q : ℕ) (A_Q : MvPolynomial (Fin n) k),
            (g₀ * δ₀) ^ d_Q * Q - MvPolynomial.rename ι_var A_Q ∈ J_k := by
        intro Q
        induction Q using MvPolynomial.induction_on with
        | C c =>
          refine ⟨0, MvPolynomial.C c, ?_⟩
          simp only [pow_zero, one_mul, MvPolynomial.rename_C, sub_self]
          exact J_k.zero_mem
        | add Q₁ Q₂ ih₁ ih₂ =>
          obtain ⟨d₁, A₁, h₁⟩ := ih₁
          obtain ⟨d₂, A₂, h₂⟩ := ih₂
          refine ⟨d₁ + d₂, (g_tilde * δ_tilde) ^ d₂ * A₁ + (g_tilde * δ_tilde) ^ d₁ * A₂, ?_⟩
          have hren : MvPolynomial.rename ι_var
              ((g_tilde * δ_tilde) ^ d₂ * A₁ + (g_tilde * δ_tilde) ^ d₁ * A₂) =
              (g₀ * δ₀) ^ d₂ * MvPolynomial.rename ι_var A₁ +
                (g₀ * δ₀) ^ d₁ * MvPolynomial.rename ι_var A₂ := by
            simp only [map_add, map_mul, map_pow, g₀, δ₀]
          have h_eq : (g₀ * δ₀) ^ (d₁ + d₂) * (Q₁ + Q₂) -
              MvPolynomial.rename ι_var
                ((g_tilde * δ_tilde) ^ d₂ * A₁ + (g_tilde * δ_tilde) ^ d₁ * A₂) =
              (g₀ * δ₀) ^ d₂ * ((g₀ * δ₀) ^ d₁ * Q₁ - MvPolynomial.rename ι_var A₁) +
                (g₀ * δ₀) ^ d₁ * ((g₀ * δ₀) ^ d₂ * Q₂ - MvPolynomial.rename ι_var A₂) := by
            rw [hren, pow_add]; ring
          rw [h_eq]
          exact J_k.add_mem (J_k.mul_mem_left _ h₁) (J_k.mul_mem_left _ h₂)
        | mul_X Q₁ v ih =>
          obtain ⟨d₁, A₁, h₁⟩ := ih
          refine Fin.lastCases ?_ (fun w => Fin.lastCases ?_ (fun i => ?_) w) v
          · refine ⟨d₁ + 1, A₁ * g_tilde, ?_⟩
            have hren : MvPolynomial.rename ι_var (A₁ * g_tilde) =
                MvPolynomial.rename ι_var A₁ * g₀ := by simp only [map_mul, g₀]
            have h_eq : (g₀ * δ₀) ^ (d₁ + 1) * (Q₁ * MvPolynomial.X (Fin.last (n + 1))) -
                MvPolynomial.rename ι_var (A₁ * g_tilde) =
                (g₀ * z₂_k * δ₀) * ((g₀ * δ₀) ^ d₁ * Q₁ - MvPolynomial.rename ι_var A₁) +
                  (MvPolynomial.rename ι_var A₁ * g₀) * (z₂_k * δ₀ - 1) := by
              rw [hren, pow_succ]
              change (g₀ * δ₀) ^ d₁ * (g₀ * δ₀) * (Q₁ * z₂_k) - MvPolynomial.rename ι_var A₁ * g₀ = _
              ring
            rw [h_eq]
            exact J_k.add_mem (J_k.mul_mem_left _ h₁) (J_k.mul_mem_left _ hz₂_J)
          · refine ⟨d₁ + 1, A₁ * δ_tilde, ?_⟩
            have hren : MvPolynomial.rename ι_var (A₁ * δ_tilde) =
                MvPolynomial.rename ι_var A₁ * δ₀ := by simp only [map_mul, δ₀]
            have h_eq : (g₀ * δ₀) ^ (d₁ + 1) * (Q₁ * MvPolynomial.X (Fin.last n).castSucc) -
                MvPolynomial.rename ι_var (A₁ * δ_tilde) =
                (δ₀ * z₁_k * g₀) * ((g₀ * δ₀) ^ d₁ * Q₁ - MvPolynomial.rename ι_var A₁) +
                  (MvPolynomial.rename ι_var A₁ * δ₀) * (z₁_k * g₀ - 1) := by
              rw [hren, pow_succ]
              change (g₀ * δ₀) ^ d₁ * (g₀ * δ₀) * (Q₁ * z₁_k) - MvPolynomial.rename ι_var A₁ * δ₀ = _
              ring
            rw [h_eq]
            exact J_k.add_mem (J_k.mul_mem_left _ h₁) (J_k.mul_mem_left _ hz₁_J)
          · refine ⟨d₁, A₁ * MvPolynomial.X i, ?_⟩
            have hren : MvPolynomial.rename ι_var (A₁ * MvPolynomial.X i) =
                MvPolynomial.rename ι_var A₁ * MvPolynomial.X (ι_var i) := by
              simp only [map_mul, MvPolynomial.rename_X]
            have h_eq' : (g₀ * δ₀) ^ d₁ * (Q₁ * MvPolynomial.X i.castSucc.castSucc) -
                MvPolynomial.rename ι_var (A₁ * MvPolynomial.X i) =
                ((g₀ * δ₀) ^ d₁ * Q₁ - MvPolynomial.rename ι_var A₁) *
                  MvPolynomial.X (ι_var i) := by
              rw [hren]; change (g₀ * δ₀) ^ d₁ * (Q₁ * MvPolynomial.X (ι_var i)) - _ = _; ring
            rw [h_eq']
            exact J_k.mul_mem_right (MvPolynomial.X (ι_var i)) h₁
      have huv_pow : ∀ K : ℕ, (z₁_k * z₂_k) ^ K * (g₀ * δ₀) ^ K - 1 ∈ J_k := by
        intro K
        induction K with
        | zero =>
          simp only [pow_zero, mul_one, sub_self]
          exact J_k.zero_mem
        | succ K ih =>
          have huv1 : (z₁_k * z₂_k) * (g₀ * δ₀) - 1 ∈ J_k := by
            have heq : (z₁_k * z₂_k) * (g₀ * δ₀) - 1 =
                (z₁_k * g₀) * (z₂_k * δ₀ - 1) + (z₁_k * g₀ - 1) := by ring
            rw [heq]
            exact J_k.add_mem (J_k.mul_mem_left _ hz₂_J) hz₁_J
          have hstep : (z₁_k * z₂_k) ^ (K + 1) * (g₀ * δ₀) ^ (K + 1) - 1 =
              ((z₁_k * z₂_k) * (g₀ * δ₀)) * ((z₁_k * z₂_k) ^ K * (g₀ * δ₀) ^ K - 1) +
                ((z₁_k * z₂_k) * (g₀ * δ₀) - 1) := by
            rw [pow_succ, pow_succ]; ring
          rw [hstep]
          exact J_k.add_mem (J_k.mul_mem_left _ ih) huv1
      have hker_le_I : RingHom.ker ev ≤ I_rel := by
        intro P hP
        have hP0 : ev P = 0 := hP
        let Q := π_amb P
        have hdiff_I : ι_amb Q - P ∈ I_rel := hE_all P
        have hQ_ev : ev (ι_amb Q) = 0 := by
          have hdiff0 : ev (ι_amb Q - P) = 0 := hI_le_ker hdiff_I
          rw [map_sub, hP0, sub_zero] at hdiff0
          exact hdiff0
        obtain ⟨d_Q, A_Q, hclear_Q⟩ := hclear Q
        have hclear_I : ι_amb ((g₀ * δ₀) ^ d_Q * Q - MvPolynomial.rename ι_var A_Q) ∈ I_rel :=
          hJ_to_I (Ideal.mem_map_of_mem ι_amb hclear_Q)
        have hA_ev : algebraMap R_V R' (φ A_Q) = 0 := by
          have h0 : ev (ι_amb ((g₀ * δ₀) ^ d_Q * Q - MvPolynomial.rename ι_var A_Q)) = 0 :=
            hI_le_ker hclear_I
          rw [map_sub, map_sub, map_mul, map_mul, hQ_ev, mul_zero, zero_sub, neg_eq_zero] at h0
          have hΛ : ι_amb (MvPolynomial.rename ι_var A_Q) = Λ A_Q := rfl
          rw [hΛ] at h0
          exact (RingHom.congr_fun hev_Λ A_Q).symm.trans h0
        obtain ⟨⟨_, M, rfl⟩, hM_ann⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (g_V * δ_V)) R' (φ A_Q)).mp hA_ev
        dsimp only at hM_ann
        have hker_M : (g_tilde * δ_tilde) ^ M * A_Q ∈ Ideal.span (Set.range q) := by
          rw [← hKer, RingHom.mem_ker, map_mul, map_pow, map_mul, hg_tilde]
          exact hM_ann
        have hren_q_le : Ideal.map (MvPolynomial.rename ι_var).toRingHom
            (Ideal.span (Set.range q)) ≤ J_k := by
          rw [Ideal.map_span, Ideal.span_le]
          rintro _ ⟨_, ⟨a₀, rfl⟩, rfl⟩
          exact hq_J a₀
        have hMA_J : (g₀ * δ₀) ^ M * MvPolynomial.rename ι_var A_Q ∈ J_k := by
          have hmem : MvPolynomial.rename ι_var ((g_tilde * δ_tilde) ^ M * A_Q) ∈ J_k :=
            hren_q_le (Ideal.mem_map_of_mem (MvPolynomial.rename ι_var).toRingHom hker_M)
          simpa only [map_mul, map_pow, g₀, δ₀] using hmem
        have hMQ_J : (g₀ * δ₀) ^ (M + d_Q) * Q ∈ J_k := by
          have heq : (g₀ * δ₀) ^ (M + d_Q) * Q =
              (g₀ * δ₀) ^ M * ((g₀ * δ₀) ^ d_Q * Q - MvPolynomial.rename ι_var A_Q) +
                ((g₀ * δ₀) ^ M * MvPolynomial.rename ι_var A_Q) := by
            rw [pow_add]; ring
          rw [heq]
          exact J_k.add_mem (J_k.mul_mem_left _ hclear_Q) hMA_J
        have hQ_J : Q ∈ J_k := by
          have heq : Q = (z₁_k * z₂_k) ^ (M + d_Q) * ((g₀ * δ₀) ^ (M + d_Q) * Q) -
              ((z₁_k * z₂_k) ^ (M + d_Q) * (g₀ * δ₀) ^ (M + d_Q) - 1) * Q := by ring
          rw [heq]
          exact J_k.sub_mem (J_k.mul_mem_left _ hMQ_J)
            (J_k.mul_mem_right _ (huv_pow (M + d_Q)))
        have hQ_I : ι_amb Q ∈ I_rel := hJ_to_I (Ideal.mem_map_of_mem ι_amb hQ_J)
        have hP_eq : P = ι_amb Q - (ι_amb Q - P) := by ring
        rw [hP_eq]
        exact I_rel.sub_mem hQ_I hdiff_I
      have hspan_eq_ker : Ideal.span (Set.range rel) = G_gen.ker := by
        have hG_ker : G_gen.ker = RingHom.ker ev := by
          ext P
          simp only [Algebra.Generators.ker, RingHom.mem_ker]
          rfl
        rw [hG_ker]
        exact le_antisymm hI_le_ker hker_le_I
      let P_pres : @Algebra.Presentation P_ν R' (Fin (n + 2)) (Fin (s + ν + 2)) _ _ ρ.toAlgebra :=
        { toGenerators := G_gen
          relation := rel
          span_range_relation_eq_ker := hspan_eq_ker }
      let map_idx : Fin (s + ν + 2) → Fin (n + 2) :=
        Fin.lastCases v_jac (Fin.lastCases v_den (fun b => ι_var (idx b)))
      have hmap_inj : Function.Injective map_idx := by
        intro c₁ c₂
        refine Fin.lastCases ?_ (fun c₁' => ?_) c₁
        · refine Fin.lastCases (fun _ => rfl) (fun c₂' h_eq' => ?_) c₂
          simp only [map_idx, Fin.lastCases_last, Fin.lastCases_castSucc] at h_eq'
          revert h_eq'
          refine Fin.lastCases ?_ (fun b₂ => ?_) c₂' <;> intro h_bad
          · simp only [Fin.lastCases_last, v_jac, v_den, Fin.ext_iff, Fin.val_last,
              Fin.val_castSucc] at h_bad
            omega
          · simp only [Fin.lastCases_castSucc, v_jac, ι_var, Fin.ext_iff, Fin.val_last,
              Fin.val_castSucc] at h_bad
            have := (idx b₂).isLt
            omega
        · refine Fin.lastCases (fun h_eq' => ?_) (fun c₂' h_eq' => ?_) c₂
          · simp only [map_idx, Fin.lastCases_last, Fin.lastCases_castSucc] at h_eq'
            revert h_eq'
            refine Fin.lastCases ?_ (fun b₁ => ?_) c₁' <;> intro h_bad
            · simp only [Fin.lastCases_last, v_jac, v_den, Fin.ext_iff, Fin.val_last,
                Fin.val_castSucc] at h_bad
              omega
            · simp only [Fin.lastCases_castSucc, v_jac, ι_var, Fin.ext_iff, Fin.val_last,
                Fin.val_castSucc] at h_bad
              have := (idx b₁).isLt
              omega
          · congr 1
            simp only [map_idx, Fin.lastCases_castSucc] at h_eq'
            revert h_eq'
            refine Fin.lastCases ?_ (fun b₁ => ?_) c₁'
            · refine Fin.lastCases (fun _ => rfl) (fun b₂ h_bad => ?_) c₂'
              simp only [Fin.lastCases_last, Fin.lastCases_castSucc, v_den, ι_var, Fin.ext_iff,
                Fin.val_last, Fin.val_castSucc] at h_bad
              have := (idx b₂).isLt
              omega
            · refine Fin.lastCases (fun h_bad => ?_) (fun b₂ h_ab => ?_) c₂'
              · simp only [Fin.lastCases_last, Fin.lastCases_castSucc, v_den, ι_var, Fin.ext_iff,
                  Fin.val_last, Fin.val_castSucc] at h_bad
                have := (idx b₁).isLt
                omega
              · simp only [Fin.lastCases_castSucc] at h_ab
                exact congrArg Fin.castSucc (hInj (hι_inj h_ab))
      let P_pre : @Algebra.PreSubmersivePresentation P_ν R' (Fin (n + 2)) (Fin (s + ν + 2)) _ _
          ρ.toAlgebra :=
        { toPresentation := P_pres
          map := map_idx
          map_inj := hmap_inj }
      have hpderiv_one : ∀ v : Fin (n + 2),
          MvPolynomial.pderiv v (1 : MvPolynomial (Fin (n + 2)) P_ν) = 0 := by
        intro v
        rw [← MvPolynomial.C_1, MvPolynomial.pderiv_C]
      have hpderiv_Λ_in : ∀ (i : Fin n) (p : MvPolynomial (Fin n) k),
          MvPolynomial.pderiv (ι_var i) (Λ p) = Λ (MvPolynomial.pderiv i p) := by
        intro i p
        simp only [hΛ_apply, MvPolynomial.pderiv_map, MvPolynomial.pderiv_rename hι_inj]
      have hpderiv_Λ_out : ∀ (v : Fin (n + 2)), (∀ i : Fin n, ι_var i ≠ v) →
          ∀ (p : MvPolynomial (Fin n) k), MvPolynomial.pderiv v (Λ p) = 0 := by
        intro v hv p
        induction p using MvPolynomial.induction_on with
        | C c =>
          simp only [hΛ_apply, MvPolynomial.rename_C, MvPolynomial.map_C, MvPolynomial.pderiv_C]
        | add p₁ p₂ ih₁ ih₂ =>
          rw [map_add, map_add, ih₁, ih₂, add_zero]
        | mul_X p₁ i ih =>
          have hX : Λ (p₁ * MvPolynomial.X i) = Λ p₁ * MvPolynomial.X (ι_var i) := by
            simp only [hΛ_apply, map_mul, MvPolynomial.rename_X, MvPolynomial.map_X]
          rw [hX, MvPolynomial.pderiv_mul, ih, zero_mul, zero_add,
            MvPolynomial.pderiv_X_of_ne (hv i), mul_zero]
      have hv_den_out : ∀ i : Fin n, ι_var i ≠ v_den := by
        intro i h
        have hval := congrArg Fin.val h
        simp only [ι_var, v_den, Fin.val_castSucc, Fin.val_last] at hval
        exact Nat.ne_of_lt i.isLt hval
      have hv_jac_out : ∀ i : Fin n, ι_var i ≠ v_jac := by
        intro i h
        have hval := congrArg Fin.val h
        simp only [ι_var, v_jac, Fin.val_castSucc, Fin.val_last] at hval
        have := i.isLt
        omega
      have hv_den_ne_jac : v_den ≠ v_jac := by
        intro h
        have hval := congrArg Fin.val h
        simp only [v_den, v_jac, Fin.val_castSucc, Fin.val_last] at hval
        omega
      let J_tot : Matrix (Fin (s + ν + 2)) (Fin (s + ν + 2)) R' :=
        Matrix.of fun r c => ev (MvPolynomial.pderiv (map_idx c) (rel r))
      have hjac_eq_Jtot : P_pre.jacobian = Matrix.det J_tot := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
          G_gen.algebraMap_eq]
        change ev (Matrix.det P_pre.jacobiMatrix) = Matrix.det J_tot
        rw [RingHom.map_det, ← Matrix.det_transpose]
        congr 1
        ext r c
        simp only [Matrix.transpose_apply, RingHom.mapMatrix_apply, Matrix.map_apply,
          Algebra.PreSubmersivePresentation.jacobiMatrix_apply, J_tot, Matrix.of_apply]
        rfl
      let J_pre : Matrix (Fin (s + ν + 1)) (Fin (s + ν + 1)) R' :=
        Matrix.of fun r₀ c₀ => J_tot r₀.castSucc c₀.castSucc
      have hdet_Jtot : Matrix.det J_tot = Matrix.det J_pre * algebraMap R_V R' δ_V := by
        rw [Matrix.det_succ_column J_tot (Fin.last (s + ν + 1)), Fin.sum_univ_castSucc]
        have hsum0 : (∑ r₀ : Fin (s + ν + 1),
            (-1 : R') ^ (r₀.castSucc.1 + (Fin.last (s + ν + 1)).1) *
              J_tot r₀.castSucc (Fin.last (s + ν + 1)) *
              Matrix.det (J_tot.submatrix r₀.castSucc.succAbove
                (Fin.last (s + ν + 1)).succAbove)) = 0 := by
          refine Finset.sum_eq_zero fun r₀ _ => ?_
          have hentry0 : J_tot r₀.castSucc (Fin.last (s + ν + 1)) = 0 := by
            simp only [J_tot, Matrix.of_apply, map_idx, Fin.lastCases_last]
            suffices hp0 : MvPolynomial.pderiv v_jac (rel r₀.castSucc) = 0 by
              rw [hp0, map_zero]
            refine Fin.lastCases ?_ (fun a => Fin.addCases (fun a₀ => ?_) (fun j => ?_) a) r₀
            · simp only [rel, Fin.lastCases_castSucc, Fin.lastCases_last, map_sub, hpderiv_one,
                sub_zero, MvPolynomial.pderiv_mul, Z₁, MvPolynomial.pderiv_X_of_ne hv_den_ne_jac,
                hpderiv_Λ_out v_jac hv_jac_out, zero_mul, mul_zero, add_zero]
            · simp only [rel, Fin.lastCases_castSucc, Fin.addCases_left,
                hpderiv_Λ_out v_jac hv_jac_out]
            · simp only [rel, Fin.lastCases_castSucc, Fin.addCases_right, map_sub,
                MvPolynomial.pderiv_C, sub_zero, MvPolynomial.pderiv_mul, Z₁,
                MvPolynomial.pderiv_X_of_ne hv_den_ne_jac, hpderiv_Λ_out v_jac hv_jac_out,
                zero_mul, mul_zero, add_zero]
          rw [hentry0, mul_zero, zero_mul]
        rw [hsum0, zero_add]
        have hsign : (-1 : R') ^ ((Fin.last (s + ν + 1)).1 + (Fin.last (s + ν + 1)).1) = 1 := by
          have heven : (Fin.last (s + ν + 1)).1 + (Fin.last (s + ν + 1)).1 = 2 * (s + ν + 1) := by
            simp [Fin.val_last]; omega
          rw [heven, pow_mul]
          norm_num
        have hlast_entry : J_tot (Fin.last (s + ν + 1)) (Fin.last (s + ν + 1)) =
            algebraMap R_V R' δ_V := by
          simp only [J_tot, Matrix.of_apply, map_idx, rel, Fin.lastCases_last, map_sub, hpderiv_one,
            sub_zero, MvPolynomial.pderiv_mul, Z₂, MvPolynomial.pderiv_X_self,
            hpderiv_Λ_out v_jac hv_jac_out, one_mul, mul_zero, add_zero]
          exact RingHom.congr_fun hev_Λ δ_tilde
        have hsub_eq : J_tot.submatrix (Fin.last (s + ν + 1)).succAbove
            (Fin.last (s + ν + 1)).succAbove = J_pre := by
          ext r₀ c₀
          rw [Fin.succAbove_last]
          rfl
        rw [hsign, one_mul, hlast_entry, hsub_eq, mul_comm]
      let d_vec : Fin (s + ν + 1) → R' :=
        Fin.lastCases (algebraMap R_V R' g_V)
          (Fin.addCases (fun _ : Fin s => (1 : R')) (fun _ : Fin ν => algebraMap R_V R' g_V))
      let D_scale : Matrix (Fin (s + ν + 1)) (Fin (s + ν + 1)) R' := Matrix.diagonal d_vec
      have hdet_D : Matrix.det D_scale = (algebraMap R_V R' g_V) ^ (ν + 1) := by
        rw [Matrix.det_diagonal, Fin.prod_univ_castSucc, Fin.prod_univ_add]
        simp only [d_vec, Fin.lastCases_castSucc, Fin.lastCases_last, Fin.addCases_left,
          Fin.addCases_right, Finset.prod_const_one, one_mul, Finset.prod_const, Finset.card_fin,
          pow_succ]
      have hmul_mat : D_scale * J_pre = ((algebraMap R_V R').comp φ).mapMatrix M_tilde := by
        ext r₀ c₀
        rw [Matrix.diagonal_mul]
        change d_vec r₀ * ev (MvPolynomial.pderiv (map_idx c₀.castSucc) (rel r₀.castSucc)) =
          algebraMap R_V R' (φ (M_tilde r₀ c₀))
        refine Fin.lastCases ?_ (fun a => Fin.addCases (fun a₀ => ?_) (fun j => ?_) a) r₀ <;>
          refine Fin.lastCases ?_ (fun b => ?_) c₀
        · simp only [d_vec, map_idx, rel, M_tilde, Matrix.of_apply, Fin.lastCases_castSucc,
            Fin.lastCases_last, map_sub, hpderiv_one, sub_zero, MvPolynomial.pderiv_mul, Z₁,
            MvPolynomial.pderiv_X_self, hpderiv_Λ_out v_den hv_den_out, one_mul, mul_zero,
            add_zero, map_mul, hg_tilde]
          have hg_ev : ev (Λ g_tilde) = algebraMap R_V R' g_V := by
            rw [← hg_tilde]; exact RingHom.congr_fun hev_Λ g_tilde
          rw [hg_ev]
        · simp only [d_vec, map_idx, rel, M_tilde, Matrix.of_apply, Fin.lastCases_castSucc,
            Fin.lastCases_last, map_sub, hpderiv_one, sub_zero, MvPolynomial.pderiv_mul, Z₁,
            MvPolynomial.pderiv_X_of_ne (hv_den_out (idx b)).symm, hpderiv_Λ_in, zero_mul,
            zero_add, map_mul, hev_X, hval_den]
          have hpd_ev : ev (Λ (MvPolynomial.pderiv (idx b) g_tilde)) =
              algebraMap R_V R' (φ (MvPolynomial.pderiv (idx b) g_tilde)) :=
            RingHom.congr_fun hev_Λ _
          rw [hpd_ev, ← mul_assoc, hg_den, one_mul]
        · simp only [d_vec, map_idx, rel, M_tilde, Matrix.of_apply, Fin.lastCases_castSucc,
            Fin.lastCases_last, Fin.addCases_left, hpderiv_Λ_out v_den hv_den_out, map_zero,
            mul_zero]
        · simp only [d_vec, map_idx, rel, M_tilde, Matrix.of_apply, Fin.lastCases_castSucc,
            Fin.addCases_left, hpderiv_Λ_in, one_mul]
          exact RingHom.congr_fun hev_Λ _
        · simp only [d_vec, map_idx, rel, M_tilde, Matrix.of_apply, Fin.lastCases_castSucc,
            Fin.lastCases_last, Fin.addCases_right, map_sub, MvPolynomial.pderiv_C, sub_zero,
            MvPolynomial.pderiv_mul, Z₁, MvPolynomial.pderiv_X_self,
            hpderiv_Λ_out v_den hv_den_out, one_mul, mul_zero, add_zero, map_mul, hg_tilde]
          have hf_ev : ev (Λ (f_lift j)) = algebraMap R_V R' (φ (f_lift j)) :=
            RingHom.congr_fun hev_Λ _
          rw [hf_ev]
        · simp only [d_vec, map_idx, rel, M_tilde, Matrix.of_apply, Fin.lastCases_castSucc,
            Fin.addCases_right, map_sub, MvPolynomial.pderiv_C, sub_zero, MvPolynomial.pderiv_mul,
            Z₁, MvPolynomial.pderiv_X_of_ne (hv_den_out (idx b)).symm, hpderiv_Λ_in, zero_mul,
            zero_add, map_mul, hev_X, hval_den]
          have hpd_ev : ev (Λ (MvPolynomial.pderiv (idx b) (f_lift j))) =
              algebraMap R_V R' (φ (MvPolynomial.pderiv (idx b) (f_lift j))) :=
            RingHom.congr_fun hev_Λ _
          rw [hpd_ev, ← mul_assoc, hg_den, one_mul]
      have hdet_Jpre : (algebraMap R_V R' g_V) ^ (ν + 1) * Matrix.det J_pre =
          algebraMap R_V R' δ_V := by
        rw [← hdet_D, ← Matrix.det_mul, hmul_mat, ← RingHom.map_det]
        rfl
      have hUnit_jac : IsUnit P_pre.jacobian := by
        refine IsUnit.of_mul_eq_one ((algebraMap R_V R' g_V) ^ (ν + 1) * z_jac ^ 2) ?_
        rw [hjac_eq_Jtot, hdet_Jtot]
        calc (Matrix.det J_pre * algebraMap R_V R' δ_V) *
              ((algebraMap R_V R' g_V) ^ (ν + 1) * z_jac ^ 2)
            = ((algebraMap R_V R' g_V) ^ (ν + 1) * Matrix.det J_pre) *
                algebraMap R_V R' δ_V * z_jac ^ 2 := by ring
          _ = algebraMap R_V R' δ_V * algebraMap R_V R' δ_V * z_jac ^ 2 := by rw [hdet_Jpre]
          _ = (algebraMap R_V R' δ_V * z_jac) ^ 2 := by ring
          _ = 1 := by rw [hδ_jac, one_pow]
      let P_sub : @Algebra.SubmersivePresentation P_ν R' (Fin (n + 2)) (Fin (s + ν + 2)) _ _
          ρ.toAlgebra _ :=
        { toPreSubmersivePresentation := P_pre
          jacobian_isUnit := hUnit_jac }
      have hdim : P_sub.dimension = d := by
        change Nat.card (Fin (s + ν + d + 2)) - Nat.card (Fin (s + ν + 2)) = d
        rw [Nat.card_fin, Nat.card_fin]
        omega
      exact @Algebra.SubmersivePresentation.isStandardSmoothOfRelativeDimension d P_ν R'
        (Fin (n + 2)) (Fin (s + ν + 2)) _ _ ρ.toAlgebra _ _ P_sub hdim

  
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let 𝒜_ν := MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k
  let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra 𝒜_ν := MvPolynomial.gradedAlgebra
  have hNotHyp : ∀ (y : (weilProjectiveSpaceOver k N).left) (H : MvPolynomial (Fin (N + 1)) k),
      y ∉ weilProjHyperplaneSet k N H ↔ y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N H := by
    intro y H
    dsimp [weilProjHyperplaneSet]
    exact Classical.not_not
  let S_pts : Set X.left :=
    {x | x ∈ U ∧ ι_X.left.base x ∉ weilProjHyperplaneSet k N G ∧
      ∀ j : Fin ν, ι_X.left.base x ∈ weilProjHyperplaneSet k N (F j)}
  have hex_chart : ∀ p : ↥S_pts,
      ∃ W_p : X.left.Opens,
        p.1 ∈ W_p ∧
        (∀ x : X.left, x ∈ W_p → ι_X.left.base x ∉ weilProjHyperplaneSet k N G) ∧
        (∀ (W_tot : X.left.Opens) (hle : W_p ≤ W_tot)
           (ψ : (W_tot : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k ν).left),
           IsLinearProjChartMorphism k N ν X.left ι_X.left F G W_tot ψ →
           AlgebraicGeometry.SmoothOfRelativeDimension d (X.left.homOfLE hle ≫ ψ)) := by
    intro p
    obtain ⟨hxU, hxNotG, hxF⟩ := p.2
    obtain ⟨α₀, V, hAffV, hxV, _hVU, hVα, hXα, hpos, s, φ, q, f_lift, idx,
        hSurj, hInj, hAlgk, hKer, hf_lift, _, hDet_qf⟩ :=
      hSlice.2 p.1 hxU hxF
    let R_V := ↑(X.left.presheaf.obj (Opposite.op V))
    let D_α := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀)
    let hp_Xα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N + 1)) k) ∈
        Submonoid.powers (MvPolynomial.X α₀) := ⟨1, pow_one _⟩
    let g_V : R_V :=
      ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀) hXα hpos).hom ≫
        ι_X.left.appLE D_α V hVα).hom
        (HomogeneousLocalization.mk ⟨1, ⟨G, hG⟩, ⟨MvPolynomial.X α₀, hXα⟩, hp_Xα⟩)
    obtain ⟨h_basic, h_fac_pkg⟩ := h_s3 X ι_X α₀ V hAffV hVα hXα hpos
    obtain ⟨δ_V, hδ_prime, hδ_smooth⟩ :=
      h_s1 s R_V φ hSurj q hKer f_lift idx hInj hDet_qf g_V
    let W_p : X.left.Opens := X.left.basicOpen (g_V * δ_V)
    have hWp_split : W_p = X.left.basicOpen g_V ⊓ X.left.basicOpen δ_V :=
      AlgebraicGeometry.Scheme.basicOpen_mul _ g_V δ_V
    have hbg_eq : X.left.basicOpen g_V =
        V ⊓ (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N G) :=
      h_basic G hG
    let v_p : PrimeSpectrum R_V := V.toSpecΓ.base ⟨p.1, hxV⟩
    have hmem_basic_iff : ∀ r : R_V, p.1 ∈ X.left.basicOpen r ↔ r ∉ v_p.asIdeal := by
      intro r
      have hpre := SetLike.ext_iff.mp
        (AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen V r) ⟨p.1, hxV⟩
      have hι : (⟨p.1, hxV⟩ : ↥V.toScheme) ∈
          (TopologicalSpace.Opens.map V.ι.base).obj (X.left.basicOpen r) ↔
          p.1 ∈ X.left.basicOpen r := by
        change V.ι.base ⟨p.1, hxV⟩ ∈ X.left.basicOpen r ↔ p.1 ∈ X.left.basicOpen r
        rw [AlgebraicGeometry.Scheme.Opens.ι_apply]
      exact hι.symm.trans hpre.symm
    have hp_bg : p.1 ∈ X.left.basicOpen g_V := by
      rw [hbg_eq]
      exact ⟨hxV, (hNotHyp _ G).mp hxNotG⟩
    have hg_not_vp : g_V ∉ v_p.asIdeal := (hmem_basic_iff g_V).mp hp_bg
    have hf_mem_vp : ∀ j : Fin ν, φ (f_lift j) ∈ v_p.asIdeal := by
      intro j
      by_contra hnot
      have hp_bf : p.1 ∈ X.left.basicOpen (φ (f_lift j)) :=
        (hmem_basic_iff (φ (f_lift j))).mpr hnot
      have hbf_eq : X.left.basicOpen (φ (f_lift j)) =
          V ⊓ (TopologicalSpace.Opens.map ι_X.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N (F j)) := by
        rw [hf_lift j (hSlice.1 j)]
        exact h_basic (F j) (hSlice.1 j)
      rw [hbf_eq] at hp_bf
      exact (hNotHyp _ (F j)).mpr hp_bf.2 (hxF j)
    have hδ_not_vp : δ_V ∉ v_p.asIdeal :=
      hδ_prime v_p.asIdeal v_p.isPrime hg_not_vp hf_mem_vp
    have hp_bδ : p.1 ∈ X.left.basicOpen δ_V := (hmem_basic_iff δ_V).mpr hδ_not_vp
    refine ⟨W_p, ?_, ?_, ?_⟩
    · rw [hWp_split]
      exact ⟨hp_bg, hp_bδ⟩
    · intro x hxWp
      rw [hWp_split] at hxWp
      have hx_bg := hxWp.1
      rw [hbg_eq] at hx_bg
      exact (hNotHyp _ G).mpr hx_bg.2
    · intro W_tot hle ψ hψ
      have hWpV : W_p ≤ V := X.left.basicOpen_le (g_V * δ_V)
      let k_hom : k →+* R_V := φ.comp MvPolynomial.C
      have hk : V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom k_hom) = V.ι ≫ X.hom := by
        have hcomp_k : CommRingCat.ofHom k_hom =
            CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom φ := rfl
        rw [hcomp_k, AlgebraicGeometry.Spec.map_comp]
        exact hAlgk
      obtain ⟨hT, hpos', ρ_p, hfac, hρ_C, hρ_X⟩ :=
        h_fac_pkg k_hom hk W_tot W_p hWpV hle ψ hψ
      obtain ⟨e_ν, he_C, he_X⟩ := h_s2 hT
      let R'_p := ↑(X.left.presheaf.obj (Opposite.op W_p))
      have : IsLocalization.Away (g_V * δ_V) R'_p :=
        hAffV.isLocalization_basicOpen (g_V * δ_V)
      have halg_eq : algebraMap R_V R'_p =
          (X.left.presheaf.map (CategoryTheory.homOfLE hWpV).op).hom := rfl
      let ρ'_p : MvPolynomial (Fin ν) k →+* R'_p := ρ_p.comp e_ν.toRingHom
      have hρ'_C : ∀ c : k, ρ'_p (MvPolynomial.C c) =
          algebraMap R_V R'_p (φ (MvPolynomial.C c)) := by
        intro c
        change ρ_p (e_ν (MvPolynomial.C c)) = _
        rw [he_C c, hρ_C c, halg_eq]
        rfl
      have hρ'_X : ∀ j : Fin ν,
          ρ'_p (MvPolynomial.X j) * algebraMap R_V R'_p g_V =
            algebraMap R_V R'_p (φ (f_lift j)) := by
        intro j
        have hXj : (MvPolynomial.X j.castSucc : MvPolynomial (Fin (ν + 1)) k) ∈ 𝒜_ν 1 :=
          MvPolynomial.isHomogeneous_X k j.castSucc
        change ρ_p (e_ν (MvPolynomial.X j)) * _ = _
        rw [he_X j hXj, halg_eq, hf_lift j (hSlice.1 j)]
        exact hρ_X j hXj
      have hStd : RingHom.IsStandardSmoothOfRelativeDimension d ρ'_p :=
        hδ_smooth R'_p ρ'_p hρ'_C hρ'_X
      have : AlgebraicGeometry.SmoothOfRelativeDimension d
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'_p)) :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
          (RingHom.locally_of (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d)
            ρ'_p hStd)
      have hρ_comp : CommRingCat.ofHom ρ_p =
          CommRingCat.ofHom e_ν.symm.toRingHom ≫ CommRingCat.ofHom ρ'_p := by
        rw [← CommRingCat.ofHom_comp]
        exact congrArg CommRingCat.ofHom
          (RingHom.ext fun x => congrArg ρ_p (e_ν.apply_symm_apply x).symm)
      have hSpec_ρ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_p) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'_p) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ν.symm.toRingHom) := by
        rw [hρ_comp, AlgebraicGeometry.Spec.map_comp]
      have : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ν.symm.toRingHom)) := by
        refine ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ν.toRingHom), ?_, ?_⟩⟩
        · have h1 : e_ν.toRingHom.comp e_ν.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_ν.apply_symm_apply
          have h1' : CommRingCat.ofHom e_ν.symm.toRingHom ≫ CommRingCat.ofHom e_ν.toRingHom =
              𝟙 _ := by
            rw [← CommRingCat.ofHom_comp, h1]
            rfl
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h2 : e_ν.symm.toRingHom.comp e_ν.toRingHom = RingHom.id _ :=
            RingHom.ext e_ν.symm_apply_apply
          have h2' : CommRingCat.ofHom e_ν.toRingHom ≫ CommRingCat.ofHom e_ν.symm.toRingHom =
              𝟙 _ := by
            rw [← CommRingCat.ofHom_comp, h2]
            rfl
          rw [h2', AlgebraicGeometry.Spec.map_id]
        · have h1 : e_ν.toRingHom.comp e_ν.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_ν.apply_symm_apply
          have h1' : CommRingCat.ofHom e_ν.symm.toRingHom ≫ CommRingCat.ofHom e_ν.toRingHom =
              𝟙 _ := by
            rw [← CommRingCat.ofHom_comp, h1]
            rfl
          rw [← AlgebraicGeometry.Spec.map_comp, h1', AlgebraicGeometry.Spec.map_id]
      have hAffWp : AlgebraicGeometry.IsAffineOpen W_p := hAffV.basicOpen (g_V * δ_V)
      have : CategoryTheory.IsIso W_p.toSpecΓ := by
        rw [← hAffWp.isoSpec_hom]
        infer_instance
      have : AlgebraicGeometry.SmoothOfRelativeDimension 0 W_p.toSpecΓ := inferInstance
      have : AlgebraicGeometry.SmoothOfRelativeDimension 0
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ν.symm.toRingHom)) := inferInstance
      have : AlgebraicGeometry.SmoothOfRelativeDimension 0
          (AlgebraicGeometry.Proj.awayι 𝒜_ν (MvPolynomial.X (Fin.last ν)) hT hpos') :=
        inferInstance
      have : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 0)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ν.symm.toRingHom) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_ν (MvPolynomial.X (Fin.last ν)) hT hpos') :=
        inferInstance
      have : AlgebraicGeometry.SmoothOfRelativeDimension (d + 0)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'_p) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ν.symm.toRingHom) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_ν (MvPolynomial.X (Fin.last ν)) hT hpos') :=
        inferInstance
      have h_sm_tot : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (d + 0))
          (W_p.toSpecΓ ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'_p) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ν.symm.toRingHom)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_ν (MvPolynomial.X (Fin.last ν)) hT hpos') := by
        simp only [CategoryTheory.Category.assoc]
        infer_instance
      dsimp only [weilProjectiveSpaceOver]
      rw [hfac, hSpec_ρ]
      simpa using h_sm_tot
  choose W_fam hWp_mem hWp_G hWp_sm using hex_chart
  let W : X.left.Opens := ⨆ p : ↥S_pts, W_fam p
  refine ⟨W, ?_, ?_, ?_⟩
  · intro x hxU hxNotG hxF
    let p : ↥S_pts := ⟨x, hxU, hxNotG, hxF⟩
    exact (le_iSup W_fam p) (hWp_mem p)
  · intro x hxW
    obtain ⟨p, hxp⟩ := TopologicalSpace.Opens.mem_iSup.mp hxW
    exact hWp_G p x hxp
  · intro ψ hψ
    exact h_s4 W_fam W rfl ψ (fun p hle => hWp_sm p W hle ψ hψ)

theorem weil_proj_basepointFree_linear_projection_package (k : Type u) [Field k]
    (m N : ℕ) (hm : 1 ≤ m)
    (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntVn : AlgebraicGeometry.IsIntegral V_norm.left)
    (hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (hIntP : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k (m + 1)).left)
    (hDimP : topologicalKrullDim (weilProjectiveSpaceOver k (m + 1)).left =
      ((m + 1 : ℕ) : WithBot ℕ∞))
    (ι_V : V_norm ⟶ weilProjectiveSpaceOver k N)
    (hClV : AlgebraicGeometry.IsClosedImmersion ι_V.left)
    (pr_p₀ : ((weilProjCenterComplOpen k m :
      (weilProjectiveSpaceOver k (m + 1)).left.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
      (weilProjectiveSpaceOver k m).left)
    (hPr : IsCenterComplLinearProjection k m pr_p₀)
    (F : Fin (m + 1 + 1) → MvPolynomial (Fin (N + 1)) k)
    (hF_hom : ∀ a : Fin (m + 1 + 1), F a ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
    (hF_bp : ∀ x : V_norm.left, ∃ a : Fin (m + 1 + 1),
      ι_V.left.base x ∉ weilProjHyperplaneSet k N (F a)) :
    ∃ (π : V_norm ⟶ weilProjectiveSpaceOver k (m + 1))
      (b_star : (weilProjectiveSpaceOver k m).left),
      AlgebraicGeometry.IsFinite π.left ∧
      AlgebraicGeometry.Surjective π.left ∧
      (∀ x : V_norm.left,
        π.left.base x ∈ weilProjCenterComplOpen k m ↔
          ∃ i : Fin (m + 1), ι_V.left.base x ∉ weilProjHyperplaneSet k N (F i.castSucc)) ∧
      (∀ (W : V_norm.left.Opens),
        (∀ x : V_norm.left, x ∈ W →
          ι_V.left.base x ∉ weilProjHyperplaneSet k N (F (Fin.last (m + 1)))) →
        IsLinearProjChartMorphism k N (m + 1) V_norm.left ι_V.left
          (fun i : Fin (m + 1) => F i.castSucc) (F (Fin.last (m + 1))) W (W.ι ≫ π.left)) ∧
      (∀ x : ↥((π.left ⁻¹ᵁ weilProjCenterComplOpen k m : V_norm.left.Opens) :
          AlgebraicGeometry.Scheme.{u}),
        ((π.left ∣_ weilProjCenterComplOpen k m) ≫ pr_p₀).base x = b_star ↔
          (ι_V.left.base x.1 ∉ weilProjHyperplaneSet k N (F (Fin.last m).castSucc) ∧
            ∀ j : Fin m,
              ι_V.left.base x.1 ∈ weilProjHyperplaneSet k N (F (j.castSucc).castSucc))) ∧
      (∀ (W_V : V_norm.left.Opens),
        (∀ x : V_norm.left, x ∈ W_V →
          ι_V.left.base x ∉ weilProjHyperplaneSet k N (F (Fin.last m).castSucc)) →
        ∃ hWU : W_V ≤ π.left ⁻¹ᵁ weilProjCenterComplOpen k m,
          IsLinearProjChartMorphism k N m V_norm.left ι_V.left
            (fun j : Fin m => F (j.castSucc).castSucc) (F (Fin.last m).castSucc) W_V
            (V_norm.left.homOfLE hWU ≫ (π.left ∣_ weilProjCenterComplOpen k m) ≫ pr_p₀)) ∧
      (∀ (Z_div : AlgebraicGeometry.Scheme.{u})
          (ι_div : Z_div ⟶ V_norm.left)
          (_ : AlgebraicGeometry.IsClosedImmersion ι_div)
          (j_div : Z_div ⟶
            ((π.left ⁻¹ᵁ weilProjCenterComplOpen k m : V_norm.left.Opens) :
              AlgebraicGeometry.Scheme.{u}))
          (_ : j_div ≫ (π.left ⁻¹ᵁ weilProjCenterComplOpen k m).ι = ι_div),
        AlgebraicGeometry.IsFinite (j_div ≫ (π.left ∣_ weilProjCenterComplOpen k m) ≫ pr_p₀) ∧
        (∀ (W_et₀ : Z_div.Opens),
          (∀ z : Z_div, z ∈ W_et₀ →
            (ι_div ≫ ι_V.left).base z ∉
              weilProjHyperplaneSet k N (F (Fin.last m).castSucc)) →
          IsLinearProjChartMorphism k N m Z_div (ι_div ≫ ι_V.left)
            (fun j : Fin m => F (j.castSucc).castSucc) (F (Fin.last m).castSucc) W_et₀
            (W_et₀.ι ≫ j_div ≫ (π.left ∣_ weilProjCenterComplOpen k m) ≫ pr_p₀))) :=
by
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let 𝒜_m1 := MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k
  let 𝒜_m := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
  letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra 𝒜_m1 := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra 𝒜_m := MvPolynomial.gradedAlgebra

  
  
  
  let Φ₀ : MvPolynomial (Fin (m + 1 + 1)) k →+* MvPolynomial (Fin (N + 1)) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C F
  have hdeg : ∀ (i : ℕ) (p : MvPolynomial (Fin (m + 1 + 1)) k),
      p ∈ 𝒜_m1 i → Φ₀ p ∈ 𝒜_N i := by
    intro i p hp
    have hp' : p.IsHomogeneous i := hp
    have hev : (MvPolynomial.eval₂ MvPolynomial.C F p).IsHomogeneous (1 * i) :=
      hp'.eval₂ MvPolynomial.C F (fun r => MvPolynomial.isHomogeneous_C _ r) hF_hom
    rw [Nat.one_mul] at hev
    exact hev
  let Φ_gr : 𝒜_m1 →+*ᵍ 𝒜_N := { toRingHom := Φ₀, map_mem := @hdeg }

  let D_N : Fin (m + 1 + 1) → (weilProjectiveSpaceOver k N).left.Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_N (F a)
  let D_m1 : Fin (m + 1 + 1) → (weilProjectiveSpaceOver k (m + 1)).left.Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X a)
  let V : Fin (m + 1 + 1) → V_norm.left.Opens :=
    fun a => (TopologicalSpace.Opens.map ι_V.left.base).obj (D_N a)

  have hmem_V : ∀ (a : Fin (m + 1 + 1)) (x : V_norm.left),
      x ∈ V a ↔ ι_V.left.base x ∉ weilProjHyperplaneSet k N (F a) := by
    intro a x
    change ι_V.left.base x ∈ D_N a ↔ ¬ (ι_V.left.base x ∉ D_N a)
    exact not_not.symm

  have hCovV : ∀ x : V_norm.left, ∃ a : Fin (m + 1 + 1), x ∈ V a := by
    intro x
    obtain ⟨a, ha⟩ := hF_bp x
    exact ⟨a, (hmem_V a x).mpr ha⟩

  have hCovV_top : (⨆ a : Fin (m + 1 + 1), V a) = ⊤ := by
    ext x
    exact ⟨fun _ => trivial, fun _ => TopologicalSpace.Opens.mem_iSup.mpr (hCovV x)⟩

  have hYa : ∀ a : Fin (m + 1 + 1),
      (MvPolynomial.X a : MvPolynomial (Fin (m + 1 + 1)) k) ∈ 𝒜_m1 1 :=
    fun a => MvPolynomial.isHomogeneous_X k a

  have hsub : ∀ a : Fin (m + 1 + 1),
      Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (m + 1 + 1)) k) ≤
        Submonoid.comap Φ₀ (Submonoid.powers (F a)) := by
    intro a
    apply Submonoid.powers_le.mpr
    change Φ₀ (MvPolynomial.X a) ∈ Submonoid.powers (F a)
    simp [Φ₀, Submonoid.mem_powers]

  let π_tilde : ∀ a : Fin (m + 1 + 1),
      (D_N a : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k (m + 1)).left :=
    fun a =>
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫
      AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a) (hYa a) zero_lt_one

  let π_loc : ∀ a : Fin (m + 1 + 1),
      (V a : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k (m + 1)).left :=
    fun a => (ι_V.left ∣_ D_N a) ≫ π_tilde a

  have hOverlap_V : ∀ a a' : Fin (m + 1 + 1),
      V_norm.left.homOfLE (inf_le_left : V a ⊓ V a' ≤ V a) ≫ π_loc a =
      V_norm.left.homOfLE (inf_le_right : V a ⊓ V a' ≤ V a') ≫ π_loc a' := by
    intro a a'
    let F_aa' : MvPolynomial (Fin (N + 1)) k := F a * F a'
    let Y_aa' : MvPolynomial (Fin (m + 1 + 1)) k := MvPolynomial.X a * MvPolynomial.X a'
    have hY_aa' : Y_aa' ∈ 𝒜_m1 2 := by
      have hm_mul := SetLike.mul_mem_graded (hYa a) (hYa a')
      simpa using hm_mul
    have hsub_aa' : Submonoid.powers Y_aa' ≤ Submonoid.comap Φ₀ (Submonoid.powers F_aa') := by
      apply Submonoid.powers_le.mpr
      change Φ₀ (MvPolynomial.X a * MvPolynomial.X a') ∈ Submonoid.powers (F a * F a')
      simp [Φ₀, Submonoid.mem_powers]
    let D_aa' : (weilProjectiveSpaceOver k N).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_N F_aa'
    have hD_eq : D_aa' = D_N a ⊓ D_N a' :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜_N (F a) (F a')
    have hle_D_L : D_aa' ≤ D_N a := hD_eq.le.trans inf_le_left
    have hle_D_R : D_aa' ≤ D_N a' := hD_eq.le.trans inf_le_right
    have hFactor : ∀ (b c : Fin (m + 1 + 1)) (hx : F_aa' = F b * F c)
        (hy : Y_aa' = MvPolynomial.X b * MvPolynomial.X c) (hle : D_aa' ≤ D_N b),
        (weilProjectiveSpaceOver k N).left.homOfLE hle ≫ π_tilde b =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map Φ_gr hsub_aa')) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m1 Y_aa' hY_aa' zero_lt_two := by
      intro b c hx hy hle
      have h_iso_hom :
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F b) (hF_hom b) zero_lt_one).hom =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (F b) :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_N (F b) (hF_hom b) zero_lt_one
      have h_toSpec :
          (weilProjectiveSpaceOver k N).left.homOfLE hle ≫
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (F b) =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_N (hF_hom c) hx)) :=
        (AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_N (hF_hom c) hx).symm
      have h_ring :
          (HomogeneousLocalization.awayMap 𝒜_N (hF_hom c) hx).comp
            (HomogeneousLocalization.map Φ_gr (hsub b)) =
          (HomogeneousLocalization.map Φ_gr hsub_aa').comp
            (HomogeneousLocalization.awayMap 𝒜_m1 (hYa c) hy) := by
        ext z
        obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_m1 (hYa b) z
        have h1 : HomogeneousLocalization.map Φ_gr (hsub b)
            (HomogeneousLocalization.Away.mk 𝒜_m1 (hYa b) n p hp) =
          HomogeneousLocalization.Away.mk 𝒜_N (hF_hom b) n (Φ₀ p) (hdeg (n • 1) p hp) := by
          apply HomogeneousLocalization.val_injective _
          rw [HomogeneousLocalization.Away.val_mk]
          erw [HomogeneousLocalization.map_mk]
          simp [Φ_gr, Φ₀, HomogeneousLocalization.Away.mk]
        simp only [RingHom.comp_apply, h1, HomogeneousLocalization.awayMap_mk]
        rw [HomogeneousLocalization.Away.val_mk]
        erw [HomogeneousLocalization.map_mk]
        simp [Φ_gr, Φ₀, HomogeneousLocalization.Away.mk, hx, hy, mul_pow]
      have h_awayι :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.awayMap 𝒜_m1 (hYa c) hy)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X b) (hYa b) zero_lt_one =
          AlgebraicGeometry.Proj.awayι 𝒜_m1 Y_aa' hY_aa' zero_lt_two :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_m1 (hYa b) zero_lt_one (hYa c) hy
      let tail_b :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub b))) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X b) (hYa b) zero_lt_one
      have hs1 : (weilProjectiveSpaceOver k N).left.homOfLE hle ≫ π_tilde b =
          ((weilProjectiveSpaceOver k N).left.homOfLE hle ≫
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (F b)) ≫ tail_b := by
        dsimp only [π_tilde, tail_b]
        rw [← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ tail_b)
          (congrArg ((weilProjectiveSpaceOver k N).left.homOfLE hle ≫ ·) h_iso_hom)
      have hs2 : ((weilProjectiveSpaceOver k N).left.homOfLE hle ≫
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (F b)) ≫ tail_b =
          (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_N (hF_hom c) hx))) ≫ tail_b :=
        congrArg (· ≫ tail_b) h_toSpec
      have hs3 : (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_N (hF_hom c) hx))) ≫ tail_b =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N F_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.map Φ_gr hsub_aa')) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_m1 Y_aa' hY_aa' zero_lt_two := by
        dsimp only [tail_b]
        rw [CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_ring,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, h_awayι]
      exact (hs1.trans hs2).trans hs3
    have hTildeEq :
        (weilProjectiveSpaceOver k N).left.homOfLE hle_D_L ≫ π_tilde a =
        (weilProjectiveSpaceOver k N).left.homOfLE hle_D_R ≫ π_tilde a' :=
      (hFactor a a' rfl rfl hle_D_L).trans
        (hFactor a' a (mul_comm (F a) (F a')) (mul_comm (MvPolynomial.X a) (MvPolynomial.X a'))
          hle_D_R).symm
    have hV_le : V a ⊓ V a' ≤ (TopologicalSpace.Opens.map ι_V.left.base).obj D_aa' := by
      intro x hx
      change ι_V.left.base x ∈ D_aa'
      rw [hD_eq]
      exact hx
    let u_aa' : ((V a ⊓ V a' : V_norm.left.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
        (D_aa' : AlgebraicGeometry.Scheme.{u}) :=
      V_norm.left.homOfLE hV_le ≫ (ι_V.left ∣_ D_aa')
    have hPull : ∀ (b : Fin (m + 1 + 1)) (hle_V : V a ⊓ V a' ≤ V b) (hle_D : D_aa' ≤ D_N b),
        V_norm.left.homOfLE hle_V ≫ (ι_V.left ∣_ D_N b) =
        u_aa' ≫ (weilProjectiveSpaceOver k N).left.homOfLE hle_D := by
      intro b hle_V hle_D
      rw [← CategoryTheory.cancel_mono (D_N b).ι]
      dsimp only [u_aa']
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι_assoc,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    dsimp only [π_loc]
    rw [← CategoryTheory.Category.assoc, hPull a inf_le_left hle_D_L,
      CategoryTheory.Category.assoc, hTildeEq,
      ← CategoryTheory.Category.assoc, ← hPull a' inf_le_right hle_D_R,
      CategoryTheory.Category.assoc]

  let 𝒰 : V_norm.left.OpenCover :=
    V_norm.left.openCoverOfIsOpenCover V (TopologicalSpace.IsOpenCover.mk hCovV_top)

  have hGlueCond : ∀ (a a' : 𝒰.I₀),
      CategoryTheory.Limits.pullback.fst (𝒰.f a) (𝒰.f a') ≫ π_loc a =
      CategoryTheory.Limits.pullback.snd (𝒰.f a) (𝒰.f a') ≫ π_loc a' := by
    intro (a : Fin (m + 1 + 1)) (a' : Fin (m + 1 + 1))
    let fst := CategoryTheory.Limits.pullback.fst (V a).ι (V a').ι
    let snd := CategoryTheory.Limits.pullback.snd (V a).ι (V a').ι
    have hcond : fst ≫ (V a).ι = snd ≫ (V a').ι := CategoryTheory.Limits.pullback.condition
    have hrange : Set.range (fst ≫ (V a).ι).base ⊆ Set.range (V a ⊓ V a').ι.base := by
      rw [(V a ⊓ V a').range_ι]
      rintro _ ⟨z, rfl⟩
      refine ⟨?_, ?_⟩
      · have h1 : (V a).ι.base (fst.base z) = (fst.base z).1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply (V a) (fst.base z)
        change (V a).ι.base (fst.base z) ∈ V a
        rw [h1]
        exact (fst.base z).2
      · rw [hcond]
        have h2 : (V a').ι.base (snd.base z) = (snd.base z).1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply (V a') (snd.base z)
        change (V a').ι.base (snd.base z) ∈ V a'
        rw [h2]
        exact (snd.base z).2
    let p_inf : CategoryTheory.Limits.pullback (V a).ι (V a').ι ⟶
        ((V a ⊓ V a' : V_norm.left.Opens) : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift (V a ⊓ V a').ι (fst ≫ (V a).ι) hrange
    have hp_fac : p_inf ≫ (V a ⊓ V a').ι = fst ≫ (V a).ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (V a ⊓ V a').ι (fst ≫ (V a).ι) hrange
    have hp_fst : fst = p_inf ≫ V_norm.left.homOfLE (inf_le_left : V a ⊓ V a' ≤ V a) := by
      rw [← CategoryTheory.cancel_mono (V a).ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac]
    have hp_snd : snd = p_inf ≫ V_norm.left.homOfLE (inf_le_right : V a ⊓ V a' ≤ V a') := by
      rw [← CategoryTheory.cancel_mono (V a').ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac, hcond]
    change fst ≫ π_loc a = snd ≫ π_loc a'
    rw [hp_fst, hp_snd, CategoryTheory.Category.assoc, hOverlap_V a a',
      CategoryTheory.Category.assoc]

  let π_left : V_norm.left ⟶ (weilProjectiveSpaceOver k (m + 1)).left :=
    𝒰.glueMorphisms π_loc hGlueCond

  have hChart_V : ∀ a : Fin (m + 1 + 1), (V a).ι ≫ π_left = π_loc a :=
    fun a => 𝒰.ι_glueMorphisms π_loc hGlueCond a

  have hπ_w : π_left ≫ (weilProjectiveSpaceOver k (m + 1)).hom = V_norm.hom := by
    apply 𝒰.hom_ext
    intro (a : Fin (m + 1 + 1))
    change (V a).ι ≫ π_left ≫ (weilProjectiveSpaceOver k (m + 1)).hom = (V a).ι ≫ V_norm.hom
    rw [← CategoryTheory.Category.assoc, hChart_V a]
    let z_m1 := HomogeneousLocalization.fromZeroRingHom 𝒜_m1 (Submonoid.powers (MvPolynomial.X a))
    let z_N := HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (F a))
    have hZeroRing :
        ((HomogeneousLocalization.map Φ_gr (hsub a)).comp z_m1).comp (algebraMap k ↥(𝒜_m1 0)) =
        z_N.comp (algebraMap k ↥(𝒜_N 0)) := by
      ext r
      simp only [RingHom.comp_apply, z_m1, z_N]
      erw [HomogeneousLocalization.map_mk]
      have hr : (algebraMap k ↥(𝒜_m1 0) r : MvPolynomial (Fin (m + 1 + 1)) k) =
          MvPolynomial.C r := rfl
      have hr' : (algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k) =
          MvPolynomial.C r := rfl
      change Localization.mk (Φ₀ ((algebraMap k ↥(𝒜_m1 0) r : MvPolynomial (Fin (m + 1 + 1)) k)))
          ⟨Φ₀ 1, _⟩ =
        Localization.mk ((algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k)) ⟨1, _⟩
      have hnum : Φ₀ ((algebraMap k ↥(𝒜_m1 0) r : MvPolynomial (Fin (m + 1 + 1)) k)) =
          ((algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k)) := by
        rw [hr, hr']
        simp [Φ₀]
      have hden : (⟨Φ₀ 1, (hsub a) (Submonoid.one_mem _)⟩ : Submonoid.powers (F a)) =
          ⟨1, Submonoid.one_mem _⟩ := Subtype.ext (map_one Φ₀)
      rw [hnum, hden]
    have hTilde_hom :
        π_tilde a ≫ (weilProjectiveSpaceOver k (m + 1)).hom =
        (D_N a).ι ≫ (weilProjectiveSpaceOver k N).hom := by
      have hDN_ι : (D_N a).ι =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_N (F a) (hF_hom a) zero_lt_one := by
        dsimp only [D_N]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (F a) (hF_hom a) zero_lt_one,
          CategoryTheory.Iso.hom_inv_id_assoc]
        rfl
      have h_away_m1 :
          AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a) (hYa a) zero_lt_one ≫
            (weilProjectiveSpaceOver k (m + 1)).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_m1.comp (algebraMap k ↥(𝒜_m1 0)))) := by
        change AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a) (hYa a) zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜_m1 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_m1 0))) = _
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_m1 (MvPolynomial.X a) (hYa a) zero_lt_one,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_away_N :
          AlgebraicGeometry.Proj.awayι 𝒜_N (F a) (hF_hom a) zero_lt_one ≫
            (weilProjectiveSpaceOver k N).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
        change AlgebraicGeometry.Proj.awayι 𝒜_N (F a) (hF_hom a) zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) = _
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (F a) (hF_hom a) zero_lt_one,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_mid :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a) (hYa a) zero_lt_one) ≫
            (weilProjectiveSpaceOver k (m + 1)).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
        have hm1 := CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))))
          (AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a) (hYa a) zero_lt_one)
          (weilProjectiveSpaceOver k (m + 1)).hom
        have hm2 := congrArg
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫ ·)
          h_away_m1
        have hm3 :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_m1.comp (algebraMap k ↥(𝒜_m1 0)))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← RingHom.comp_assoc, hZeroRing]
        exact (hm1.trans hm2).trans hm3
      have ht1 : π_tilde a ≫ (weilProjectiveSpaceOver k (m + 1)).hom =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫ ·) h_mid)
      have ht2 : (D_N a).ι ≫ (weilProjectiveSpaceOver k N).hom =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) :=
        (congrArg (· ≫ (weilProjectiveSpaceOver k N).hom) hDN_ι).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            (congrArg ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫ ·) h_away_N))
      exact ht1.trans ht2.symm
    dsimp only [π_loc]
    rw [CategoryTheory.Category.assoc, hTilde_hom, ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc,
      CategoryTheory.Over.w ι_V]

  let π : V_norm ⟶ weilProjectiveSpaceOver k (m + 1) :=
    CategoryTheory.Over.homMk π_left hπ_w
  have hπ_left_eq : π.left = π_left := rfl

  have hPre_π : ∀ b : Fin (m + 1 + 1),
      (TopologicalSpace.Opens.map π.left.base).obj (D_m1 b) = V b := by
    intro b
    ext x
    obtain ⟨a, hxa⟩ := hCovV x
    let u : ↥(V a : AlgebraicGeometry.Scheme.{u}) := ⟨x, hxa⟩
    have hu_val : (V a).ι.base u = x := AlgebraicGeometry.Scheme.Opens.ι_apply (V a) u
    have hElem : HomogeneousLocalization.map Φ_gr (hsub a)
        (HomogeneousLocalization.Away.isLocalizationElem (hYa a) (hYa b)) =
      HomogeneousLocalization.Away.isLocalizationElem (hF_hom a) (hF_hom b) := by
      apply HomogeneousLocalization.val_injective _
      erw [HomogeneousLocalization.map_mk]
      simp [Φ_gr, Φ₀, HomogeneousLocalization.Away.isLocalizationElem,
        HomogeneousLocalization.Away.mk]
    have hTilde_pre :
        (TopologicalSpace.Opens.map (π_tilde a).base).obj (D_m1 b) =
        (TopologicalSpace.Opens.map (D_N a).ι.base).obj (D_N b) := by
      letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      letI : GradedAlgebra 𝒜_m1 := MvPolynomial.gradedAlgebra
      have hDN_ι : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_N (F a) (hF_hom a) zero_lt_one = (D_N a).ι := by
        dsimp only [D_N]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (F a) (hF_hom a) zero_lt_one,
          CategoryTheory.Iso.hom_inv_id_assoc]
        rfl
      have h1 := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_m1 (hYa a) zero_lt_one
        (hYa b) zero_lt_one
      have h2 : (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a)))).base).obj
          (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hYa a) (hYa b))) =
        PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hF_hom a) (hF_hom b)) := by
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen]
        exact congrArg PrimeSpectrum.basicOpen hElem
      have h3 := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N (hF_hom a) zero_lt_one
        (hF_hom b) zero_lt_one
      have hp1 : (TopologicalSpace.Opens.map (π_tilde a).base).obj (D_m1 b) =
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom.base).obj
            ((TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (F a) (hF_hom a) zero_lt_one).base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (F b))) := by
        change (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom.base).obj
          ((TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub a)))).base).obj
            ((TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a) (hYa a) zero_lt_one).base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X b)))) = _
        rw [h1, h2, ← h3]
      have hp2 : (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom.base).obj
            ((TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (F a) (hF_hom a) zero_lt_one).base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (F b))) =
          (TopologicalSpace.Opens.map (D_N a).ι.base).obj (D_N b) := by
        change (TopologicalSpace.Opens.map
          ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a) (hF_hom a) zero_lt_one).hom ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (F a) (hF_hom a) zero_lt_one).base).obj (D_N b) = _
        rw [hDN_ι]
        rfl
      exact hp1.trans hp2
    have hLoc_pre :
        (TopologicalSpace.Opens.map (π_loc a).base).obj (D_m1 b) =
        (TopologicalSpace.Opens.map (V a).ι.base).obj (V b) := by
      have hmr : (ι_V.left ∣_ D_N a) ≫ (D_N a).ι = (V a).ι ≫ ι_V.left :=
        AlgebraicGeometry.morphismRestrict_ι ι_V.left (D_N a)
      change (TopologicalSpace.Opens.map (ι_V.left ∣_ D_N a).base).obj
        ((TopologicalSpace.Opens.map (π_tilde a).base).obj (D_m1 b)) = _
      rw [hTilde_pre]
      change (TopologicalSpace.Opens.map ((ι_V.left ∣_ D_N a) ≫ (D_N a).ι).base).obj (D_N b) = _
      rw [hmr]
      rfl
    have h_iff := SetLike.ext_iff.mp hLoc_pre u
    change π.left.base x ∈ D_m1 b ↔ x ∈ V b
    rw [← hu_val]
    change ((V a).ι ≫ π_left).base u ∈ D_m1 b ↔ (V a).ι.base u ∈ V b
    rw [hChart_V a]
    exact h_iff

  
  
  
  have hProjProperSep : ∀ (M : ℕ),
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k M).hom ∧
      AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k M).hom := by
    intro M
    let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜_M 0) (MvPolynomial (Fin (M + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (M + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜_M 0) (MvPolynomial (Fin (M + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜_M 0) (MvPolynomial (Fin (M + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜_M 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)))) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ hSurj0
    dsimp only [weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
    exact ⟨inferInstance, inferInstance⟩

  have hFinCrit : ∀ (lam : ℕ) (Z : AlgebraicGeometry.Scheme.{u})
      (ι_Z : Z ⟶ (weilProjectiveSpaceOver k N).left)
      (_ : AlgebraicGeometry.IsClosedImmersion ι_Z)
      (g : Z ⟶ (weilProjectiveSpaceOver k lam).left)
      (_ : g ≫ (weilProjectiveSpaceOver k lam).hom =
        ι_Z ≫ (weilProjectiveSpaceOver k N).hom)
      (Ψ : Fin (lam + 1) → MvPolynomial (Fin (N + 1)) k)
      (_ : ∀ b : Fin (lam + 1), Ψ b ∈ 𝒜_N 1)
      (_ : let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (lam + 1)) k) :=
             MvPolynomial.gradedAlgebra
           ∀ b : Fin (lam + 1),
             (TopologicalSpace.Opens.map g.base).obj
               (AlgebraicGeometry.Proj.basicOpen
                 (MvPolynomial.homogeneousSubmodule (Fin (lam + 1)) k) (MvPolynomial.X b)) =
             (TopologicalSpace.Opens.map ι_Z.base).obj
               (AlgebraicGeometry.Proj.basicOpen 𝒜_N (Ψ b))),
      AlgebraicGeometry.IsFinite g := by
    intro lam Z ι_Z hClZ g hg_hom Ψ hΨ_hom hPre_g
    let 𝒜_lam := MvPolynomial.homogeneousSubmodule (Fin (lam + 1)) k
    letI : GradedAlgebra 𝒜_lam := MvPolynomial.gradedAlgebra
    haveI : AlgebraicGeometry.IsClosedImmersion ι_Z := hClZ
    haveI : AlgebraicGeometry.IsAffineHom ι_Z :=
      (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hClZ).1
    have hPN := (hProjProperSep N).1
    have hPlam_sep := (hProjProperSep lam).2
    have hProp_comp : AlgebraicGeometry.IsProper (g ≫ (weilProjectiveSpaceOver k lam).hom) := by
      rw [hg_hom]
      infer_instance
    have hProp_g : AlgebraicGeometry.IsProper g :=
      @AlgebraicGeometry.IsProper.of_comp _ _ _ g (weilProjectiveSpaceOver k lam).hom
        hProp_comp hPlam_sep
    have hCov_lam : ∀ y : (weilProjectiveSpaceOver k lam).left,
        ∃ b : Fin (lam + 1),
          y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_lam (MvPolynomial.X b) := by
      intro y
      by_contra! hAll
      apply y.not_irrelevant_le
      rw [HomogeneousIdeal.irrelevant_le]
      intro d hd p hp
      have hp_hom : p.IsHomogeneous d := hp
      rw [MvPolynomial.as_sum p]
      apply y.asHomogeneousIdeal.toIdeal.sum_mem
      intro s hs
      have hs_deg : (∑ b : Fin (lam + 1), s b) = d := by
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using
          hp_hom (MvPolynomial.mem_support_iff.mp hs)
      have ⟨b₀, hb₀⟩ : ∃ b₀ : Fin (lam + 1), 1 ≤ s b₀ := by
        by_contra! hZero
        have hsum0 : (∑ b : Fin (lam + 1), s b) = 0 :=
          Finset.sum_eq_zero (fun b _ => Nat.lt_one_iff.mp (hZero b))
        omega
      have hXb₀ : (MvPolynomial.X b₀ : MvPolynomial (Fin (lam + 1)) k) ∈
          y.asHomogeneousIdeal.toIdeal := by
        have hnot := hAll b₀
        have hm := @AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜_lam _
          (MvPolynomial.X b₀) y
        exact not_not.mp (mt hm.mpr hnot)
      rw [MvPolynomial.monomial_eq, Finsupp.prod_of_support_subset _ (Finset.subset_univ _)
        _ (fun _ _ => pow_zero _)]
      apply y.asHomogeneousIdeal.toIdeal.mul_mem_left
      obtain ⟨r, hr⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s b₀ ≠ 0)
      rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ b₀), hr, pow_succ']
      exact y.asHomogeneousIdeal.toIdeal.mul_mem_right _
        (y.asHomogeneousIdeal.toIdeal.mul_mem_right _ hXb₀)
    have hAff_g : AlgebraicGeometry.IsAffineHom g := by
      apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
      intro y
      obtain ⟨b, hyb⟩ := hCov_lam y
      refine ⟨AlgebraicGeometry.Proj.basicOpen 𝒜_lam (MvPolynomial.X b), hyb,
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_lam (MvPolynomial.X b)
          (MvPolynomial.isHomogeneous_X k b) zero_lt_one, ?_⟩
      rw [hPre_g b]
      have hAff_DN : AlgebraicGeometry.IsAffineOpen (AlgebraicGeometry.Proj.basicOpen 𝒜_N (Ψ b)) :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (Ψ b) (hΨ_hom b) zero_lt_one
      exact @AlgebraicGeometry.IsAffineOpen.preimage _ _ _ hAff_DN ι_Z
        (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hClZ).1
    exact AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_g, hAff_g⟩

  have hFin_π : AlgebraicGeometry.IsFinite π.left :=
    hFinCrit (m + 1) V_norm.left ι_V.left hClV π.left
      (hπ_w.trans (CategoryTheory.Over.w ι_V).symm) F hF_hom hPre_π

  
  
  
  haveI : AlgebraicGeometry.IsFinite π.left := hFin_π
  have hSurj_π : AlgebraicGeometry.Surjective π.left := by
    let P_sch := (weilProjectiveSpaceOver k (m + 1)).left
    haveI : IrreducibleSpace ↥V_norm.left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral V_norm.left hIntVn
    haveI : IrreducibleSpace ↥P_sch :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral P_sch hIntP
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥V_norm.left) :=
      ⟨⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥V_norm.left, isClosed_univ⟩⟩
    have ⟨c, hc_len⟩ :
        ∃ c : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V_norm.left),
          m + 1 ≤ c.length := by
      by_contra! hlt
      have hsup : (⨆ c : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V_norm.left),
          (c.length : ℕ∞)) ≤ (m : ℕ∞) :=
        iSup_le (fun c => Nat.cast_le.mpr (Nat.lt_succ_iff.mp (hlt c)))
      have hdim : topologicalKrullDim V_norm.left ≤ ((m : ℕ) : WithBot ℕ∞) := by
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥V_norm.left) ≤ _
        rw [Order.krullDim_eq_iSup_length]
        exact WithBot.coe_le_coe.mpr hsup
      rw [hDimVn] at hdim
      exact absurd (Nat.cast_le.mp (WithBot.coe_le_coe.mp hdim)) (by omega)
    obtain ⟨x₀, hx₀⟩ := (c 0).isIrreducible.nonempty
    obtain ⟨U, hAffU, hx₀U, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (TopologicalSpace.Opens.mem_top (π.left.base x₀))
    let V_U : V_norm.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U
    have hx₀V : x₀ ∈ V_U := hx₀U
    have hAffVU : AlgebraicGeometry.IsAffineOpen V_U := hAffU.preimage π.left
    let c_V_fun : Fin (c.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V_U :=
      fun idx =>
        ⟨(Subtype.val : ↥V_U → ↥V_norm.left) ⁻¹' (c idx).1,
          ⟨⟨⟨x₀, hx₀V⟩, c.monotone (Fin.zero_le idx) hx₀⟩,
            (c idx).isIrreducible.isPreirreducible.preimage
              V_U.isOpen.isOpenEmbedding_subtypeVal⟩,
          (c idx).isClosed.preimage continuous_subtype_val⟩
    have hc_V_step : ∀ j : Fin c.length, c_V_fun j.castSucc < c_V_fun j.succ := by
      intro j
      have hlt_j : c j.castSucc < c j.succ := c.step j
      refine lt_of_le_of_ne (fun z hz => (le_of_lt hlt_j) hz) (fun hEq => not_le_of_gt hlt_j ?_)
      intro z hz
      by_contra hz_not
      obtain ⟨w, hw_succ, hw_compl, hw_VU⟩ :=
        (c j.succ).isIrreducible.isPreirreducible
          ((c j.castSucc).1)ᶜ (V_U : Set ↥V_norm.left)
          (c j.castSucc).isClosed.isOpen_compl V_U.isOpen
          ⟨z, hz, hz_not⟩ ⟨x₀, c.monotone (Fin.zero_le j.succ) hx₀, hx₀V⟩
      have hw_in : (⟨w, hw_VU⟩ : ↥V_U) ∈ (c_V_fun j.succ).1 := hw_succ
      rw [← hEq] at hw_in
      exact hw_compl hw_in
    let c_V : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V_U) :=
      { length := c.length, toFun := c_V_fun, step := hc_V_step }
    have hDim_VU_ge : ((m + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥V_U :=
      (WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hc_len)).trans
        (Order.LTSeries.length_le_krullDim c_V)
    let A : Type u := ↑(P_sch.presheaf.obj (Opposite.op U))
    let B : Type u := ↑(V_norm.left.presheaf.obj (Opposite.op V_U))
    have hDim_B_eq : topologicalKrullDim ↥V_U = ringKrullDim B := by
      calc topologicalKrullDim ↥V_U
          = topologicalKrullDim ↥(V_U : AlgebraicGeometry.Scheme.{u}) := rfl
        _ = topologicalKrullDim ↥(AlgebraicGeometry.Spec
              (V_norm.left.presheaf.obj (Opposite.op V_U))) :=
            (AlgebraicGeometry.Scheme.homeoOfIso hAffVU.isoSpec).isHomeomorph.topologicalKrullDim_eq
        _ = ringKrullDim B := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim B
    have hDim_B_ge : ((m + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim B := hDim_B_eq ▸ hDim_VU_ge
    haveI : Nonempty (PrimeSpectrum B) :=
      ⟨hAffVU.isoSpec.hom.base ⟨x₀, hx₀V⟩⟩
    have ⟨q_ser, hq_len⟩ : ∃ q_ser : LTSeries (PrimeSpectrum B), m + 1 ≤ q_ser.length := by
      by_contra! hlt
      have hsup : (⨆ q : LTSeries (PrimeSpectrum B), (q.length : ℕ∞)) ≤ (m : ℕ∞) :=
        iSup_le (fun q => Nat.cast_le.mpr (Nat.lt_succ_iff.mp (hlt q)))
      have hdim : ringKrullDim B ≤ ((m : ℕ) : WithBot ℕ∞) := by
        change Order.krullDim (PrimeSpectrum B) ≤ _
        rw [Order.krullDim_eq_iSup_length]
        exact WithBot.coe_le_coe.mpr hsup
      exact absurd (Nat.cast_le.mp (WithBot.coe_le_coe.mp (hDim_B_ge.trans hdim))) (by omega)
    let φ_mor := π.left.appLE U V_U (le_refl V_U)
    let φ : A →+* B := φ_mor.hom
    have hφ_eq_app : φ = (π.left.app U).hom := by
      change (π.left.app U ≫ V_norm.left.presheaf.map (CategoryTheory.homOfLE (le_refl V_U)).op).hom = _
      have hid : (CategoryTheory.homOfLE (le_refl V_U)).op = 𝟙 (Opposite.op V_U) := rfl
      rw [hid, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
    have hInt_φ : φ.IsIntegral := by
      rw [hφ_eq_app]
      exact ((AlgebraicGeometry.isIntegralHom_iff π.left).mp inferInstance).2 U hAffU
    letI : Algebra A B := φ.toAlgebra
    haveI : Algebra.IsIntegral A B := ⟨hInt_φ⟩
    have hComapStrict : ∀ {q₁ q₂ : PrimeSpectrum B}, q₁ < q₂ →
        PrimeSpectrum.comap φ q₁ < PrimeSpectrum.comap φ q₂ := by
      intro q₁ q₂ hlt_q
      obtain ⟨b, hb₂, hb₁⟩ := Set.not_subset.mp (not_le_of_gt hlt_q)
      exact @Ideal.under_lt_under_of_integral_mem_sdiff A _ B _ q₁.asIdeal q₂.asIdeal _
        q₁.isPrime (le_of_lt hlt_q) b ⟨hb₂, hb₁⟩ (hInt_φ b)
    let p_ser : LTSeries (PrimeSpectrum A) :=
      { length := q_ser.length
        toFun := fun i => PrimeSpectrum.comap φ (q_ser i)
        step := fun j => hComapStrict (q_ser.step j) }
    haveI : IsDomain A :=
      @AlgebraicGeometry.IsIntegral.component_integral P_sch hIntP U ⟨⟨π.left.base x₀, hx₀U⟩⟩
    have hBotPrime : (⊥ : Ideal A).IsPrime :=
      ⟨bot_ne_top, fun {a₁ a₂} hab => mul_eq_zero.mp hab⟩
    let botA : PrimeSpectrum A := ⟨⊥, hBotPrime⟩
    have hp0_eq_bot : p_ser 0 = botA := by
      by_contra hne
      have hlt_bot : botA < p_ser 0 := lt_of_le_of_ne bot_le (Ne.symm hne)
      let p_ext : LTSeries (PrimeSpectrum A) :=
        { length := q_ser.length + 1
          toFun := Fin.cases botA (fun i => p_ser i)
          step := Fin.cases hlt_bot (fun j => p_ser.step j) }
      have hlen_ext : m + 2 ≤ p_ext.length := by
        change m + 2 ≤ q_ser.length + 1
        omega
      have hDim_A_ge : ((m + 2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim A :=
        (WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hlen_ext)).trans
          (Order.LTSeries.length_le_krullDim p_ext)
      have hDim_A_le : ringKrullDim A ≤ ((m + 1 : ℕ) : WithBot ℕ∞) := by
        calc ringKrullDim A
            = topologicalKrullDim ↥(AlgebraicGeometry.Spec (P_sch.presheaf.obj (Opposite.op U))) :=
              (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A).symm
          _ = topologicalKrullDim ↥(U : AlgebraicGeometry.Scheme.{u}) :=
              (AlgebraicGeometry.Scheme.homeoOfIso hAffU.isoSpec).symm.isHomeomorph.topologicalKrullDim_eq
          _ = topologicalKrullDim ↥(U : Set ↥P_sch) := rfl
          _ ≤ topologicalKrullDim ↥P_sch := topologicalKrullDim_subspace_le ↥P_sch (U : Set ↥P_sch)
          _ = ((m + 1 : ℕ) : WithBot ℕ∞) := hDimP
      exact absurd (Nat.cast_le.mp (WithBot.coe_le_coe.mp (hDim_A_ge.trans hDim_A_le))) (by omega)
    have hFromSpec_comm :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π.left hAffU hAffVU (le_refl V_U)
    have hu_in_range : hAffU.fromSpec.base botA ∈ Set.range π.left.base := by
      refine ⟨hAffVU.fromSpec.base (q_ser 0), ?_⟩
      change (hAffVU.fromSpec ≫ π.left).base (q_ser 0) = hAffU.fromSpec.base botA
      rw [← hFromSpec_comm]
      exact congrArg hAffU.fromSpec.base hp0_eq_bot
    have hCl_bot : closure ({botA} : Set ↥(AlgebraicGeometry.Spec (P_sch.presheaf.obj (Opposite.op U)))) =
        Set.univ := by
      change closure ({botA} : Set (PrimeSpectrum A)) = Set.univ
      rw [PrimeSpectrum.closure_singleton, PrimeSpectrum.zeroLocus_bot]
    have hU_sub_cl : (U : Set ↥P_sch) ⊆ closure (Set.range π.left.base) := by
      rw [← hAffU.range_fromSpec, ← Set.image_univ, ← hCl_bot]
      have himg : hAffU.fromSpec.base ''
          ({botA} : Set ↥(AlgebraicGeometry.Spec (P_sch.presheaf.obj (Opposite.op U)))) ⊆
          Set.range π.left.base := by
        rintro _ ⟨z, hz, rfl⟩
        rw [Set.mem_singleton_iff.mp hz]
        exact hu_in_range
      exact (image_closure_subset_closure_image hAffU.fromSpec.continuous).trans
        (closure_mono himg)
    have hU_dense : closure (U : Set ↥P_sch) = Set.univ :=
      dense_iff_closure_eq.mp (U.isOpen.dense ⟨π.left.base x₀, hx₀U⟩)
    have hRange_cl : IsClosed (Set.range π.left.base) := π.left.isClosedMap.isClosed_range
    have hRange_univ : Set.range π.left.base = Set.univ := by
      have hcl_sub : closure (U : Set ↥P_sch) ⊆ closure (Set.range π.left.base) :=
        closure_minimal hU_sub_cl isClosed_closure
      rw [hU_dense, hRange_cl.closure_eq] at hcl_sub
      exact Set.eq_univ_of_univ_subset hcl_sub
    exact ⟨Set.range_eq_univ.mp hRange_univ⟩

  
  
  
  let ε_star : MvPolynomial (Fin (m + 1)) k →+* Polynomial k :=
    MvPolynomial.eval₂Hom Polynomial.C (Fin.snoc (0 : Fin m → Polynomial k) Polynomial.X)
  let ι_last : Polynomial k →+* MvPolynomial (Fin (m + 1)) k :=
    Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X (Fin.last m))
  let ρ_star : MvPolynomial (Fin (m + 1)) k →+* MvPolynomial (Fin (m + 1)) k :=
    ι_last.comp ε_star

  have hε_ι_id : ε_star.comp ι_last = RingHom.id (Polynomial k) := by
    apply Polynomial.ringHom_ext'
    · ext c
      simp [ε_star, ι_last]
    · simp [ε_star, ι_last]

  have hρ_eq : ρ_star = MvPolynomial.eval₂Hom MvPolynomial.C
      (Fin.snoc (0 : Fin m → MvPolynomial (Fin (m + 1)) k) (MvPolynomial.X (Fin.last m))) := by
    apply MvPolynomial.ringHom_ext'
    · ext c
      simp [ρ_star, ε_star, ι_last]
    · refine Fin.lastCases ?_ (fun j => ?_)
      · simp [ρ_star, ε_star, ι_last]
      · simp [ρ_star, ε_star, ι_last]

  let 𝔭_star : Ideal (MvPolynomial (Fin (m + 1)) k) := RingHom.ker ε_star
  have h𝔭_prime : 𝔭_star.IsPrime := RingHom.ker_isPrime ε_star

  have h𝔭_eq_ker_ρ : 𝔭_star = RingHom.ker ρ_star := by
    ext P
    simp only [𝔭_star, RingHom.mem_ker, ρ_star, RingHom.comp_apply]
    refine ⟨fun h => by rw [h, map_zero], fun h => ?_⟩
    have h' := congrArg ε_star h
    simpa using (RingHom.congr_fun hε_ι_id (ε_star P)).symm.trans h'

  have hρ_hom_deg : ∀ (i : ℕ) (Q : MvPolynomial (Fin (m + 1)) k),
      Q.IsHomogeneous i → (ρ_star Q).IsHomogeneous i := by
    intro i Q hQ
    rw [hρ_eq]
    have hev : (MvPolynomial.eval₂ MvPolynomial.C
        (Fin.snoc (0 : Fin m → MvPolynomial (Fin (m + 1)) k) (MvPolynomial.X (Fin.last m))) Q).IsHomogeneous
        (1 * i) := by
      refine hQ.eval₂ _ _ (fun c => MvPolynomial.isHomogeneous_C _ c) ?_
      refine Fin.lastCases ?_ (fun j => ?_)
      · simp only [Fin.snoc_last]
        exact MvPolynomial.isHomogeneous_X k (Fin.last m)
      · simp only [Fin.snoc_castSucc, Pi.zero_apply]
        exact MvPolynomial.isHomogeneous_zero _ _ _
    rwa [Nat.one_mul] at hev

  have hρ_homComp : ∀ (d : ℕ) (P : MvPolynomial (Fin (m + 1)) k),
      MvPolynomial.homogeneousComponent d (ρ_star P) =
      ρ_star (MvPolynomial.homogeneousComponent d P) := by
    intro d P
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent P, map_sum, map_sum]
    conv_rhs => rw [← MvPolynomial.sum_homogeneousComponent P, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [MvPolynomial.homogeneousComponent_of_mem
          (hρ_hom_deg i _ (MvPolynomial.homogeneousComponent_isHomogeneous i P)),
        MvPolynomial.homogeneousComponent_of_mem
          (MvPolynomial.homogeneousComponent_isHomogeneous i P)]
    split_ifs <;> simp

  have h𝔭_homog : Ideal.IsHomogeneous 𝒜_m 𝔭_star := by
    intro d P hP
    rw [h𝔭_eq_ker_ρ, RingHom.mem_ker] at hP ⊢
    change ρ_star ((DirectSum.Decomposition.decompose' P d : ↥(𝒜_m d)) :
      MvPolynomial (Fin (m + 1)) k) = 0
    rw [MvPolynomial.decomposition.decompose'_apply, ← hρ_homComp d P, hP, map_zero]

  have h𝔭_not_irrel : ¬ (HomogeneousIdeal.irrelevant 𝒜_m ≤ ⟨𝔭_star, h𝔭_homog⟩) := by
    intro hle
    have hX_irrel : (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) k) ∈
        HomogeneousIdeal.irrelevant 𝒜_m :=
      HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_m zero_lt_one
        (MvPolynomial.isHomogeneous_X k (Fin.last m))
    have hX_ker : ε_star (MvPolynomial.X (Fin.last m)) = 0 := hle hX_irrel
    have hX_eval : ε_star (MvPolynomial.X (Fin.last m)) = Polynomial.X := by
      simp [ε_star]
    exact Polynomial.X_ne_zero (hX_eval.symm.trans hX_ker)

  let b_star : (weilProjectiveSpaceOver k m).left :=
    (⟨⟨𝔭_star, h𝔭_homog⟩, h𝔭_prime, h𝔭_not_irrel⟩ : ProjectiveSpectrum 𝒜_m)

  have hb_star_char : ∀ y : (weilProjectiveSpaceOver k m).left,
      y = b_star ↔
        (y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X (Fin.last m)) ∧
          ∀ j : Fin m,
            y ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X j.castSucc)) := by
    intro y
    refine ⟨?_, ?_⟩
    · rintro rfl
      refine ⟨?_, fun j => ?_⟩
      · apply (@AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜_m _
          (MvPolynomial.X (Fin.last m)) b_star).mpr
        change ε_star (MvPolynomial.X (Fin.last m)) ≠ 0
        simp [ε_star, Polynomial.X_ne_zero]
      · intro hj_in
        have hj_not := (@AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜_m _
          (MvPolynomial.X j.castSucc) b_star).mp hj_in
        apply hj_not
        change ε_star (MvPolynomial.X j.castSucc) = 0
        simp [ε_star]
    · rintro ⟨hy_last_raw, hy_cast⟩
      have hy_last : (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) k) ∉
          y.asHomogeneousIdeal :=
        (@AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜_m _
          (MvPolynomial.X (Fin.last m)) y).mp hy_last_raw
      have hy_cast_in : ∀ j : Fin m,
          (MvPolynomial.X j.castSucc : MvPolynomial (Fin (m + 1)) k) ∈
            y.asHomogeneousIdeal.toIdeal := by
        intro j
        have hm := @AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜_m _
          (MvPolynomial.X j.castSucc) y
        exact not_not.mp (mt hm.mpr (hy_cast j))
      let I_star : Ideal (MvPolynomial (Fin (m + 1)) k) :=
        Ideal.span (Set.range fun j : Fin m =>
          (MvPolynomial.X j.castSucc : MvPolynomial (Fin (m + 1)) k))
      have hI_le_y : I_star ≤ y.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        exact hy_cast_in j
      have hDiff : ∀ P : MvPolynomial (Fin (m + 1)) k, P - ρ_star P ∈ I_star := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C c =>
          simp [ρ_star, ε_star, ι_last]
        | add p q hp hq =>
          have heq : p + q - ρ_star (p + q) = (p - ρ_star p) + (q - ρ_star q) := by
            rw [map_add]
            ring
          rw [heq]
          exact I_star.add_mem hp hq
        | mul_X p b hp =>
          revert b
          refine Fin.lastCases ?_ (fun j => ?_)
          · have hlast : ρ_star (MvPolynomial.X (Fin.last m)) = MvPolynomial.X (Fin.last m) := by
              simp [hρ_eq]
            have heq : p * MvPolynomial.X (Fin.last m) -
                ρ_star (p * MvPolynomial.X (Fin.last m)) =
                (p - ρ_star p) * MvPolynomial.X (Fin.last m) := by
              rw [map_mul, hlast]
              ring
            rw [heq]
            exact I_star.mul_mem_right _ hp
          · have hcast : ρ_star (MvPolynomial.X j.castSucc) = 0 := by
              simp [hρ_eq]
            have heq : p * MvPolynomial.X j.castSucc -
                ρ_star (p * MvPolynomial.X j.castSucc) =
                p * MvPolynomial.X j.castSucc := by
              rw [map_mul, hcast, mul_zero, sub_zero]
            rw [heq]
            exact I_star.mul_mem_left p (Ideal.subset_span ⟨j, rfl⟩)
      apply ProjectiveSpectrum.ext
      apply HomogeneousIdeal.toIdeal_injective
      apply le_antisymm
      · intro P hP
        rw [← MvPolynomial.sum_homogeneousComponent P]
        apply 𝔭_star.sum_mem
        intro d _
        let Q := MvPolynomial.homogeneousComponent d P
        have hQ_y : Q ∈ y.asHomogeneousIdeal.toIdeal := by
          have hm := (Ideal.IsHomogeneous.mem_iff 𝒜_m y.asHomogeneousIdeal.isHomogeneous).mp hP d
          have hdec : ((DirectSum.Decomposition.decompose' P d : ↥(𝒜_m d)) :
              MvPolynomial (Fin (m + 1)) k) = Q :=
            MvPolynomial.decomposition.decompose'_apply P d
          exact hdec ▸ hm
        have hρQ_form : ∃ c : k,
            ρ_star Q = MvPolynomial.C c * MvPolynomial.X (Fin.last m) ^ d := by
          have hρQ_hom : (ρ_star Q).IsHomogeneous d :=
            hρ_hom_deg d Q (MvPolynomial.homogeneousComponent_isHomogeneous d P)
          have hρQ_eq : ρ_star Q = MvPolynomial.homogeneousComponent d (ρ_star Q) := by
            rw [MvPolynomial.homogeneousComponent_of_mem hρQ_hom, if_pos rfl]
          have hexp : ρ_star Q =
              ∑ r ∈ Finset.range ((ε_star Q).natDegree + 1),
                MvPolynomial.C ((ε_star Q).coeff r) * MvPolynomial.X (Fin.last m) ^ r := by
            change ι_last (ε_star Q) = _
            conv_lhs => rw [Polynomial.as_sum_range (ε_star Q)]
            rw [map_sum]
            refine Finset.sum_congr rfl (fun r _ => ?_)
            rw [← Polynomial.C_mul_X_pow_eq_monomial]
            simp [ι_last]
          rw [hρQ_eq, hexp, map_sum]
          have hSumForm : ∀ (S : Finset ℕ),
              ∃ c : k,
                (∑ r ∈ S, MvPolynomial.homogeneousComponent d
                  (MvPolynomial.C ((ε_star Q).coeff r) * MvPolynomial.X (Fin.last m) ^ r)) =
                MvPolynomial.C c * MvPolynomial.X (Fin.last m) ^ d := by
            intro S
            induction S using Finset.cons_induction with
            | empty => exact ⟨0, by simp⟩
            | cons r s hrs ih =>
              obtain ⟨c_s, hc_s⟩ := ih
              have hr_hom : (MvPolynomial.C ((ε_star Q).coeff r) *
                  (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) k) ^ r).IsHomogeneous r := by
                have hm := (MvPolynomial.isHomogeneous_C (Fin (m + 1)) ((ε_star Q).coeff r)).mul
                  ((MvPolynomial.isHomogeneous_X k (Fin.last m)).pow r)
                simpa using hm
              rw [Finset.sum_cons, hc_s, MvPolynomial.homogeneousComponent_of_mem hr_hom]
              split_ifs with hdr
              · subst hdr
                exact ⟨(ε_star Q).coeff d + c_s, by rw [map_add, add_mul]⟩
              · exact ⟨c_s, by simp⟩
          exact hSumForm _
        obtain ⟨c, hc_eq⟩ := hρQ_form
        have hρQ_y : ρ_star Q ∈ y.asHomogeneousIdeal.toIdeal := by
          have hsub_y := y.asHomogeneousIdeal.toIdeal.sub_mem hQ_y (hI_le_y (hDiff Q))
          simpa using hsub_y
        have hc_zero : c = 0 := by
          by_contra hc_ne
          have hpow_y : (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) k) ^ d ∈
              y.asHomogeneousIdeal.toIdeal := by
            have hmul := y.asHomogeneousIdeal.toIdeal.mul_mem_left
              (MvPolynomial.C c⁻¹) (hc_eq ▸ hρQ_y)
            rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc_ne, map_one, one_mul] at hmul
          cases d with
          | zero =>
            rw [pow_zero] at hpow_y
            exact y.isPrime.ne_top
              (Ideal.eq_top_of_isUnit_mem y.asHomogeneousIdeal.toIdeal hpow_y isUnit_one)
          | succ d' =>
            exact hy_last (y.isPrime.mem_of_pow_mem (d' + 1) hpow_y)
        rw [h𝔭_eq_ker_ρ, RingHom.mem_ker, hc_eq, hc_zero, map_zero, zero_mul]
      · intro P hP
        change P ∈ 𝔭_star at hP
        rw [h𝔭_eq_ker_ρ, RingHom.mem_ker] at hP
        have hmem := hI_le_y (hDiff P)
        rwa [hP, sub_zero] at hmem

  
  let U_proj := weilProjCenterComplOpen k m
  let U_φ : V_norm.left.Opens := π.left ⁻¹ᵁ U_proj
  obtain ⟨hPr_hom, hdeg_pr, hPr_coords⟩ := hPr

  let b_m : Fin (m + 1) := Fin.last m
  let a_m : Fin (m + 1 + 1) := b_m.castSucc
  let F_init : Fin m → MvPolynomial (Fin (N + 1)) k := fun j => F (j.castSucc).castSucc
  let F_m : MvPolynomial (Fin (N + 1)) k := F a_m

  obtain ⟨hPre_pr_bm, hsub_pr, h_le_pr, hb₀, hb₁, hpos_pr, hEq_pr⟩ := hPr_coords b_m

  have hVm_le_Uφ : V a_m ≤ U_φ := by
    rw [← hPre_π a_m]
    exact fun x hx => h_le_pr hx

  let Φ_init₀ : MvPolynomial (Fin (m + 1)) k →+* MvPolynomial (Fin (N + 1)) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C (Fin.snoc F_init F_m)

  have hΦ_comp_rename :
      Φ₀.comp (MvPolynomial.rename Fin.castSucc).toRingHom = Φ_init₀ := by
    apply MvPolynomial.ringHom_ext'
    · ext c
      simp [Φ₀, Φ_init₀]
    · refine Fin.lastCases ?_ (fun j => ?_)
      · simp [Φ₀, Φ_init₀, F_m, a_m, b_m]
      · simp [Φ₀, Φ_init₀, F_init]

  have hdeg_init : ∀ (i : ℕ) (p : MvPolynomial (Fin (m + 1)) k),
      p ∈ 𝒜_m i → Φ_init₀ p ∈ 𝒜_N i := by
    intro i p hp
    rw [← hΦ_comp_rename]
    exact hdeg i (MvPolynomial.rename Fin.castSucc p) (hdeg_pr i p hp)

  have hsub_init :
      Submonoid.powers (MvPolynomial.X b_m : MvPolynomial (Fin (m + 1)) k) ≤
        Submonoid.comap Φ_init₀ (Submonoid.powers F_m) := by
    apply Submonoid.powers_le.mpr
    change Φ_init₀ (MvPolynomial.X (Fin.last m)) ∈ Submonoid.powers F_m
    simp [Φ_init₀, Submonoid.mem_powers]

  have hBaseChart_Vm :
      V_norm.left.homOfLE hVm_le_Uφ ≫ (π.left ∣_ U_proj) ≫ pr_p₀ =
        (ι_V.left ∣_ D_N a_m) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m (hF_hom a_m) zero_lt_one).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (HomogeneousLocalization.map
            { toRingHom := Φ_init₀, map_mem := @hdeg_init } hsub_init)) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b_m) hb₀ zero_lt_one := by
    let M_π : HomogeneousLocalization.Away 𝒜_m1 (MvPolynomial.X a_m) →+*
        HomogeneousLocalization.Away 𝒜_N F_m :=
      HomogeneousLocalization.map Φ_gr (hsub a_m)
    let M_pr : HomogeneousLocalization.Away 𝒜_m (MvPolynomial.X b_m) →+*
        HomogeneousLocalization.Away 𝒜_m1 (MvPolynomial.X a_m) :=
      HomogeneousLocalization.map
        { toRingHom := (MvPolynomial.rename Fin.castSucc).toRingHom, map_mem := @hdeg_pr } hsub_pr
    let M_init : HomogeneousLocalization.Away 𝒜_m (MvPolynomial.X b_m) →+*
        HomogeneousLocalization.Away 𝒜_N F_m :=
      HomogeneousLocalization.map
        { toRingHom := Φ_init₀, map_mem := @hdeg_init } hsub_init
    let g_pref : (AlgebraicGeometry.Proj.basicOpen 𝒜_N F_m : AlgebraicGeometry.Scheme.{u}) ⟶
        (AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X a_m) : AlgebraicGeometry.Scheme.{u}) :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m (hF_hom a_m) zero_lt_one).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_π) ≫
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr).inv
    let f_pref : (V a_m : AlgebraicGeometry.Scheme.{u}) ⟶ (D_m1 a_m : AlgebraicGeometry.Scheme.{u}) :=
      (ι_V.left ∣_ D_N a_m) ≫ g_pref
    have hChart_am : (V a_m).ι ≫ π.left = f_pref ≫ (D_m1 a_m).ι := by
      have h_inv_ι :
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr).inv ≫
            (AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X a_m)).ι =
          AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a_m) (hYa a_m) zero_lt_one :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr
      have hc1 : (V a_m).ι ≫ π.left = π_loc a_m := hChart_V a_m
      have hg_ι : π_tilde a_m = g_pref ≫ (AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X a_m)).ι := by
        have hs1 := CategoryTheory.Category.assoc
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m (hF_hom a_m) zero_lt_one).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_π) ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr).inv)
          (AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X a_m)).ι
        have hs2 := CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_π))
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr).inv
          (AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X a_m)).ι
        have hs3 := congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_π) ≫ ·) h_inv_ι
        exact (congrArg ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m (hF_hom a_m) zero_lt_one).hom ≫ ·)
          (hs2.trans hs3).symm).trans hs1.symm
      have hc2 : π_loc a_m = f_pref ≫ (D_m1 a_m).ι :=
        (congrArg ((ι_V.left ∣_ D_N a_m) ≫ ·) hg_ι).trans
          (CategoryTheory.Category.assoc _ _ _).symm
      exact hc1.trans hc2
    have h_le_pr' : D_m1 a_m ≤ U_proj := h_le_pr
    have hRestr_Vm :
        V_norm.left.homOfLE hVm_le_Uφ ≫ (π.left ∣_ U_proj) =
        f_pref ≫ (weilProjectiveSpaceOver k (m + 1)).left.homOfLE h_le_pr' := by
      rw [← CategoryTheory.cancel_mono U_proj.ι]
      have hr1 : (V_norm.left.homOfLE hVm_le_Uφ ≫ (π.left ∣_ U_proj)) ≫ U_proj.ι =
          (V a_m).ι ≫ π.left := by
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
      have hr2 : (f_pref ≫ (weilProjectiveSpaceOver k (m + 1)).left.homOfLE h_le_pr') ≫ U_proj.ι =
          f_pref ≫ (D_m1 a_m).ι :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (f_pref ≫ ·) ((weilProjectiveSpaceOver k (m + 1)).left.homOfLE_ι h_le_pr'))
      exact (hr1.trans hChart_am).trans hr2.symm
    have hM_comp : M_π.comp M_pr = M_init := by
      ext z
      obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_m hb₀ z
      have h1 : M_pr (HomogeneousLocalization.Away.mk 𝒜_m hb₀ n p hp) =
          HomogeneousLocalization.Away.mk 𝒜_m1 hb₁ n (MvPolynomial.rename Fin.castSucc p)
            (hdeg_pr (n • 1) p hp) := by
        apply HomogeneousLocalization.val_injective _
        rw [HomogeneousLocalization.Away.val_mk]
        erw [HomogeneousLocalization.map_mk]
        simp [HomogeneousLocalization.Away.mk]
      simp only [RingHom.comp_apply, h1]
      erw [HomogeneousLocalization.map_mk, HomogeneousLocalization.map_mk]
      have hp_eq : Φ₀ (MvPolynomial.rename Fin.castSucc p) = Φ_init₀ p :=
        RingHom.congr_fun hΦ_comp_rename p
      change Localization.mk (Φ₀ ((MvPolynomial.rename Fin.castSucc) p))
          ⟨Φ₀ (MvPolynomial.X (Fin.last m).castSucc ^ n), _⟩ =
        Localization.mk (Φ_init₀ p) ⟨Φ_init₀ (MvPolynomial.X (Fin.last m) ^ n), _⟩
      have hden_eq :
          (⟨Φ₀ (MvPolynomial.X (Fin.last m).castSucc ^ n),
              (hsub a_m) ⟨n, rfl⟩⟩ : Submonoid.powers F_m) =
          ⟨Φ_init₀ (MvPolynomial.X (Fin.last m) ^ n),
              hsub_init ⟨n, rfl⟩⟩ := by
        apply Subtype.ext
        simp [Φ₀, Φ_init₀, F_m, a_m, b_m]
      rw [hp_eq, hden_eq]
    have h_away_bm :
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b_m) hb₀ hpos_pr).inv ≫
          (AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X b_m)).ι =
        AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b_m) hb₀ zero_lt_one :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_m (MvPolynomial.X b_m) hb₀ hpos_pr
    have hEq_pr' :
        (weilProjectiveSpaceOver k (m + 1)).left.homOfLE h_le_pr' ≫ pr_p₀ =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_pr) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b_m) hb₀ zero_lt_one := by
      have he1 : (weilProjectiveSpaceOver k (m + 1)).left.homOfLE h_le_pr' ≫ pr_p₀ =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_pr) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b_m) hb₀ hpos_pr).inv ≫
          (AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X b_m)).ι := hEq_pr
      rw [he1, h_away_bm]
    have hCancel_g :
        g_pref ≫
          ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X a_m) hb₁ hpos_pr).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_pr) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b_m) hb₀ zero_lt_one) =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m (hF_hom a_m) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_init) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b_m) hb₀ zero_lt_one := by
      dsimp only [g_pref, F_m]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.inv_hom_id_assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_π)),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hM_comp]
    rw [← CategoryTheory.Category.assoc, hRestr_Vm, CategoryTheory.Category.assoc, hEq_pr']
    exact (CategoryTheory.Category.assoc (ι_V.left ∣_ D_N a_m) g_pref _).trans
      (congrArg ((ι_V.left ∣_ D_N a_m) ≫ ·) hCancel_g)

  have hCompChartPull : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (α : Z ⟶ V_norm.left) (W_Z : Z.Opens)
      (_ : ∀ z : Z, z ∈ W_Z → (α ≫ ι_V.left).base z ∉ weilProjHyperplaneSet k N F_m)
      (q_Z : (W_Z : AlgebraicGeometry.Scheme.{u}) ⟶ (U_φ : AlgebraicGeometry.Scheme.{u}))
      (_ : q_Z ≫ U_φ.ι = W_Z.ι ≫ α),
      IsLinearProjChartMorphism k N m Z (α ≫ ι_V.left) F_init F_m W_Z
        (q_Z ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
    intro Z α W_Z hWZ_avoid q_Z hqZ
    have hWZ : W_Z ≤ (TopologicalSpace.Opens.map (α ≫ ι_V.left).base).obj (D_N a_m) := by
      intro z hz
      have hnot := hWZ_avoid z hz
      change (α ≫ ι_V.left).base z ∈ D_N a_m
      exact not_not.mp hnot
    have hWZ_α : W_Z ≤ (TopologicalSpace.Opens.map α.base).obj (V a_m) := hWZ
    let α_tilde : (W_Z : AlgebraicGeometry.Scheme.{u}) ⟶ (V a_m : AlgebraicGeometry.Scheme.{u}) :=
      Z.homOfLE hWZ_α ≫ (α ∣_ V a_m)
    have hqZ_eq : q_Z = α_tilde ≫ V_norm.left.homOfLE hVm_le_Uφ := by
      rw [← CategoryTheory.cancel_mono U_φ.ι, hqZ,
        CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      dsimp only [α_tilde]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    have hα_restrict :
        α_tilde ≫ (ι_V.left ∣_ D_N a_m) =
        Z.homOfLE hWZ ≫ ((α ≫ ι_V.left) ∣_ D_N a_m) := by
      rw [← CategoryTheory.cancel_mono (D_N a_m).ι]
      calc (α_tilde ≫ (ι_V.left ∣_ D_N a_m)) ≫ (D_N a_m).ι
          = Z.homOfLE hWZ_α ≫ (α ∣_ V a_m) ≫ ((ι_V.left ∣_ D_N a_m) ≫ (D_N a_m).ι) := by
              dsimp only [α_tilde]
              simp only [CategoryTheory.Category.assoc]
        _ = Z.homOfLE hWZ_α ≫ ((α ∣_ V a_m) ≫ (V a_m).ι) ≫ ι_V.left := by
              rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        _ = (Z.homOfLE hWZ_α ≫ (α ⁻¹ᵁ V a_m).ι) ≫ α ≫ ι_V.left := by
              rw [AlgebraicGeometry.morphismRestrict_ι]
              simp only [CategoryTheory.Category.assoc]
        _ = W_Z.ι ≫ α ≫ ι_V.left := by
              rw [AlgebraicGeometry.Scheme.homOfLE_ι]
        _ = Z.homOfLE hWZ ≫ (((α ≫ ι_V.left) ∣_ D_N a_m) ≫ (D_N a_m).ι) := by
              rw [AlgebraicGeometry.morphismRestrict_ι, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
        _ = (Z.homOfLE hWZ ≫ ((α ≫ ι_V.left) ∣_ D_N a_m)) ≫ (D_N a_m).ι := by
              simp only [CategoryTheory.Category.assoc]
    refine ⟨hWZ, hdeg_init, hsub_init, hF_hom a_m, hb₀, zero_lt_one, ?_⟩
    rw [hqZ_eq, CategoryTheory.Category.assoc, hBaseChart_Vm]
    have hPrefix_eq :
        α_tilde ≫ (ι_V.left ∣_ D_N a_m) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m (hF_hom a_m) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map
              { toRingHom := Φ_init₀, map_mem := @hdeg_init } hsub_init)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b_m) hb₀ zero_lt_one =
        Z.homOfLE hWZ ≫ ((α ≫ ι_V.left) ∣_ D_N a_m) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m (hF_hom a_m) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map
              { toRingHom := Φ_init₀, map_mem := @hdeg_init } hsub_init)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X b_m) hb₀ zero_lt_one := by
      rw [← CategoryTheory.Category.assoc α_tilde, hα_restrict, CategoryTheory.Category.assoc]
    exact hPrefix_eq

  
  
  
  have hC3 : ∀ x : V_norm.left,
      π.left.base x ∈ U_proj ↔
        ∃ i : Fin (m + 1), ι_V.left.base x ∉ weilProjHyperplaneSet k N (F i.castSucc) := by
    intro x
    change π.left.base x ∈ (⨆ i : Fin (m + 1), D_m1 i.castSucc) ↔ _
    rw [TopologicalSpace.Opens.mem_iSup]
    refine exists_congr (fun i => ?_)
    have hpre := SetLike.ext_iff.mp (hPre_π i.castSucc) x
    exact hpre.trans (hmem_V i.castSucc x)

  have hC4 : ∀ (W : V_norm.left.Opens),
      (∀ x : V_norm.left, x ∈ W →
        ι_V.left.base x ∉ weilProjHyperplaneSet k N (F (Fin.last (m + 1)))) →
      IsLinearProjChartMorphism k N (m + 1) V_norm.left ι_V.left
        (fun i : Fin (m + 1) => F i.castSucc) (F (Fin.last (m + 1))) W (W.ι ≫ π.left) := by
    intro W hW_avoid
    let a_last : Fin (m + 1 + 1) := Fin.last (m + 1)
    have hW_le : W ≤ V a_last := fun x hx => (hmem_V a_last x).mpr (hW_avoid x hx)
    have hsnoc : Fin.snoc (fun i : Fin (m + 1) => F i.castSucc) (F a_last) = F :=
      Fin.snoc_init_self F
    have hdeg_last : ∀ (i : ℕ) (p : MvPolynomial (Fin (m + 1 + 1)) k),
        p ∈ 𝒜_m1 i →
        MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.snoc (fun i : Fin (m + 1) => F i.castSucc) (F a_last)) p ∈ 𝒜_N i := by
      rw [hsnoc]
      exact hdeg
    have hsub_last :
        Submonoid.powers (MvPolynomial.X a_last : MvPolynomial (Fin (m + 1 + 1)) k) ≤
          Submonoid.comap
            (MvPolynomial.eval₂Hom MvPolynomial.C
              (Fin.snoc (fun i : Fin (m + 1) => F i.castSucc) (F a_last)))
            (Submonoid.powers (F a_last)) := by
      rw [hsnoc]
      exact hsub a_last
    refine ⟨hW_le, hdeg_last, hsub_last, hF_hom a_last, hYa a_last, zero_lt_one, ?_⟩
    have hW_ι : W.ι ≫ π.left = V_norm.left.homOfLE hW_le ≫ π_loc a_last := by
      change W.ι ≫ π_left = _
      rw [← hChart_V a_last, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    rw [hW_ι]
    have hMap_eq :
        HomogeneousLocalization.map Φ_gr (hsub a_last) =
        HomogeneousLocalization.map
          { toRingHom := MvPolynomial.eval₂Hom MvPolynomial.C
              (Fin.snoc (fun i : Fin (m + 1) => F i.castSucc) (F a_last))
            map_mem := @hdeg_last } hsub_last := by
      ext z
      simp only [Φ_gr, Φ₀, hsnoc]
    have hLoc_eq :
        V_norm.left.homOfLE hW_le ≫ π_loc a_last =
        V_norm.left.homOfLE hW_le ≫
          (ι_V.left ∣_ D_N a_last) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a_last) (hF_hom a_last) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map
              { toRingHom := MvPolynomial.eval₂Hom MvPolynomial.C
                  (Fin.snoc (fun i : Fin (m + 1) => F i.castSucc) (F a_last))
                map_mem := @hdeg_last } hsub_last)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a_last) (hYa a_last) zero_lt_one := by
      exact (CategoryTheory.Category.assoc _ _ _).trans
        (congrArg (fun m => V_norm.left.homOfLE hW_le ≫ (ι_V.left ∣_ D_N a_last) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (F a_last) (hF_hom a_last) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom m) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m1 (MvPolynomial.X a_last) (hYa a_last) zero_lt_one) hMap_eq)
    exact hLoc_eq

  have hC5 : ∀ x : ↥(U_φ : AlgebraicGeometry.Scheme.{u}),
      ((π.left ∣_ U_proj) ≫ pr_p₀).base x = b_star ↔
        (ι_V.left.base x.1 ∉ weilProjHyperplaneSet k N F_m ∧
          ∀ j : Fin m,
            ι_V.left.base x.1 ∈ weilProjHyperplaneSet k N (F_init j)) := by
    intro x
    let u : ↥U_proj := (π.left ∣_ U_proj).base x
    have hu_val : u.1 = π.left.base x.1 := by
      rw [← AlgebraicGeometry.Scheme.Opens.ι_apply U_proj u]
      change ((π.left ∣_ U_proj) ≫ U_proj.ι).base x = π.left.base x.1
      rw [AlgebraicGeometry.morphismRestrict_ι]
      rfl
    change pr_p₀.base u = b_star ↔ _
    rw [hb_star_char (pr_p₀.base u)]
    refine and_congr ?_ (forall_congr' fun j => ?_)
    · rw [hPre_pr_bm u, hu_val]
      exact (SetLike.ext_iff.mp (hPre_π a_m) x.1).trans (hmem_V a_m x.1)
    · rw [(hPr_coords j.castSucc).1 u, hu_val]
      have hj := (SetLike.ext_iff.mp (hPre_π j.castSucc.castSucc) x.1).trans
        (hmem_V j.castSucc.castSucc x.1)
      exact not_congr hj |>.trans ⟨not_not.mp, not_not.mpr⟩

  have hC6 : ∀ (W_V : V_norm.left.Opens),
      (∀ x : V_norm.left, x ∈ W_V →
        ι_V.left.base x ∉ weilProjHyperplaneSet k N F_m) →
      ∃ hWU : W_V ≤ U_φ,
        IsLinearProjChartMorphism k N m V_norm.left ι_V.left F_init F_m W_V
          (V_norm.left.homOfLE hWU ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
    intro W_V hWV_avoid
    have hWU : W_V ≤ U_φ := fun x hx => (hC3 x).mpr ⟨b_m, hWV_avoid x hx⟩
    refine ⟨hWU, ?_⟩
    have hChart := hCompChartPull V_norm.left (𝟙 V_norm.left) W_V
      (by simpa [CategoryTheory.Category.id_comp] using hWV_avoid)
      (V_norm.left.homOfLE hWU)
      (by rw [AlgebraicGeometry.Scheme.homOfLE_ι, CategoryTheory.Category.comp_id])
    rwa [CategoryTheory.Category.id_comp] at hChart

  have hC7 : ∀ (Z_div : AlgebraicGeometry.Scheme.{u})
      (ι_div : Z_div ⟶ V_norm.left)
      (_ : AlgebraicGeometry.IsClosedImmersion ι_div)
      (j_div : Z_div ⟶ (U_φ : AlgebraicGeometry.Scheme.{u}))
      (_ : j_div ≫ U_φ.ι = ι_div),
      AlgebraicGeometry.IsFinite (j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀) ∧
      (∀ (W_et₀ : Z_div.Opens),
        (∀ z : Z_div, z ∈ W_et₀ →
          (ι_div ≫ ι_V.left).base z ∉ weilProjHyperplaneSet k N F_m) →
        IsLinearProjChartMorphism k N m Z_div (ι_div ≫ ι_V.left) F_init F_m W_et₀
          (W_et₀.ι ≫ j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀)) := by
    intro Z_div ι_div hCl_div j_div hj_div
    haveI : AlgebraicGeometry.IsClosedImmersion ι_div := hCl_div
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion (ι_div ≫ ι_V.left) := inferInstance
    let g_div : Z_div ⟶ (weilProjectiveSpaceOver k m).left :=
      j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀
    have hg_hom : g_div ≫ (weilProjectiveSpaceOver k m).hom =
        (ι_div ≫ ι_V.left) ≫ (weilProjectiveSpaceOver k N).hom := by
      calc g_div ≫ (weilProjectiveSpaceOver k m).hom
          = j_div ≫ (π.left ∣_ U_proj) ≫ (pr_p₀ ≫ (weilProjectiveSpaceOver k m).hom) := by
              dsimp only [g_div]
              simp only [CategoryTheory.Category.assoc]
        _ = j_div ≫ ((π.left ∣_ U_proj) ≫ U_proj.ι) ≫ (weilProjectiveSpaceOver k (m + 1)).hom := by
              dsimp only [U_proj]
              rw [hPr_hom, CategoryTheory.Category.assoc]
        _ = (j_div ≫ U_φ.ι) ≫ (π_left ≫ (weilProjectiveSpaceOver k (m + 1)).hom) := by
              rw [AlgebraicGeometry.morphismRestrict_ι]
              simp only [CategoryTheory.Category.assoc]
              rfl
        _ = (ι_div ≫ ι_V.left) ≫ (weilProjectiveSpaceOver k N).hom := by
              rw [hj_div, hπ_w, ← CategoryTheory.Over.w ι_V, CategoryTheory.Category.assoc]
    have hg_pre : ∀ b : Fin (m + 1),
        (TopologicalSpace.Opens.map g_div.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X b)) =
        (TopologicalSpace.Opens.map (ι_div ≫ ι_V.left).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N (F b.castSucc)) := by
      intro b
      ext z
      let u : ↥U_proj := (π.left ∣_ U_proj).base (j_div.base z)
      have hu_val : u.1 = π.left.base (ι_div.base z) := by
        rw [← AlgebraicGeometry.Scheme.Opens.ι_apply U_proj u]
        change (j_div ≫ (π.left ∣_ U_proj) ≫ U_proj.ι).base z = _
        rw [AlgebraicGeometry.morphismRestrict_ι]
        have hj_div' : j_div ≫ (π.left ⁻¹ᵁ U_proj).ι = ι_div := hj_div
        rw [← CategoryTheory.Category.assoc, hj_div']
        rfl
      change pr_p₀.base u ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X b) ↔
        ι_div.base z ∈ V b.castSucc
      rw [(hPr_coords b).1 u, hu_val]
      exact SetLike.ext_iff.mp (hPre_π b.castSucc) (ι_div.base z)
    have hFin_div : AlgebraicGeometry.IsFinite g_div :=
      hFinCrit m Z_div (ι_div ≫ ι_V.left) hCl_comp g_div hg_hom
        (fun b => F b.castSucc) (fun b => hF_hom b.castSucc) hg_pre
    refine ⟨hFin_div, fun W_et₀ hWet_avoid => ?_⟩
    have hChart := hCompChartPull Z_div ι_div W_et₀ hWet_avoid (W_et₀.ι ≫ j_div)
      (by rw [CategoryTheory.Category.assoc, hj_div])
    simpa only [CategoryTheory.Category.assoc] using hChart

  exact ⟨π, b_star, hFin_π, hSurj_π, hC3, hC4, hC5, hC6, hC7⟩

theorem weil_algClosed_adapted_bertini_linear_projection (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntVn : AlgebraicGeometry.IsIntegral V_norm.left)
    (hProjVn : IsProjectiveOverField k V_norm)
    (hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (W_reg : V_norm.left.Opens)
    (hSmWreg : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (W_reg.ι ≫ V_norm.hom))
    (hDimSing : topologicalKrullDim ↥((W_reg : Set V_norm.left)ᶜ) + 2 ≤
      ((m + 1 : ℕ) : WithBot ℕ∞))
    (Z_closed : Set V_norm.left)
    (hClosedZ : IsClosed Z_closed)
    (hProperZ : Z_closed ≠ Set.univ)
    (pr_p₀ : ((weilProjCenterComplOpen k m :
      (weilProjectiveSpaceOver k (m + 1)).left.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
      (weilProjectiveSpaceOver k m).left)
    (hPr : IsCenterComplLinearProjection k m pr_p₀) :
    let P_amb := weilProjectiveSpaceOver k (m + 1)
    let B₀ := weilProjectiveSpaceOver k m
    let U_proj := weilProjCenterComplOpen k m
    ∃ (π : V_norm ⟶ P_amb)
      (U_et_π : P_amb.left.Opens)
      (q_sec : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ V_norm.left)
      (Z_div : AlgebraicGeometry.Scheme.{u})
      (ι_div : Z_div ⟶ V_norm.left)
      (j_div : Z_div ⟶ ((π.left ⁻¹ᵁ U_proj : V_norm.left.Opens) : AlgebraicGeometry.Scheme.{u}))
      (Z_low : Set V_norm.left)
      (b_star : B₀.left)
      (W_sm₀ : ((π.left ⁻¹ᵁ U_proj : V_norm.left.Opens) : AlgebraicGeometry.Scheme.{u}).Opens)
      (W_et₀ : Z_div.Opens),
      AlgebraicGeometry.IsFinite π.left ∧
      AlgebraicGeometry.Surjective π.left ∧
      (((U_proj : Set P_amb.left)ᶜ) ⊆ (U_et_π : Set P_amb.left)) ∧
      AlgebraicGeometry.Etale (π.left ∣_ U_et_π) ∧
      (q_sec ≫ V_norm.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) ∧
      (Set.range (q_sec ≫ π.left).base ⊆ ((U_proj : Set P_amb.left)ᶜ)) ∧
      (∀ x : V_norm.left, π.left.base x ∉ U_proj →
        ∃ q_x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ V_norm.left,
          q_x ≫ V_norm.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
          x ∈ Set.range q_x.base) ∧
      AlgebraicGeometry.IsClosedImmersion ι_div ∧
      AlgebraicGeometry.IsReduced Z_div ∧
      IsClosed Z_low ∧
      (Z_closed = Set.range ι_div.base ∪ Z_low) ∧
      (j_div ≫ (π.left ⁻¹ᵁ U_proj).ι = ι_div) ∧
      (Z_low ⊆ (π.left ⁻¹ᵁ U_proj : Set V_norm.left)) ∧
      AlgebraicGeometry.IsFinite (j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀) ∧
      (∀ x : ↥((π.left ⁻¹ᵁ U_proj : V_norm.left.Opens) : AlgebraicGeometry.Scheme.{u}),
        x.1 ∈ Z_low → ((π.left ∣_ U_proj) ≫ pr_p₀).base x ≠ b_star) ∧
      (∀ x : ↥((π.left ⁻¹ᵁ U_proj : V_norm.left.Opens) : AlgebraicGeometry.Scheme.{u}),
        ((π.left ∣_ U_proj) ≫ pr_p₀).base x = b_star → x ∈ W_sm₀) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) ∧
      (∀ z : Z_div,
        (j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀).base z = b_star → z ∈ W_et₀) ∧
      AlgebraicGeometry.Etale (W_et₀.ι ≫ j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀) :=
by
  intro P_amb B₀ U_proj

  
  have hWB_sing :
      ∀ (d : WithBot ℕ∞),
        d + 2 ≤ ((m + 1 : ℕ) : WithBot ℕ∞) →
        d ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
    intro d h
    cases d with
    | bot => exact bot_le
    | coe a =>
      cases a with
      | top =>
        have h' : (⊤ : ℕ∞) ≤ ((m + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h
        exact absurd (top_le_iff.mp h') (ENat.natCast_ne_top (m + 1))
      | coe n =>
        have h' : ((n + 2 : ℕ) : ℕ∞) ≤ ((m + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h
        have hn : n + 2 ≤ m + 1 := Nat.cast_le.mp h'
        have hn' : n ≤ m - 1 := by omega
        exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hn')

  have hWB_step :
      ∀ (x y B : WithBot ℕ∞) (r : ℕ),
        x + 1 ≤ y →
        y + ((r : ℕ) : WithBot ℕ∞) ≤ B →
        x + ((r + 1 : ℕ) : WithBot ℕ∞) ≤ B := by
    intro x y B r hxy hyB
    have h1 : (x + 1) + ((r : ℕ) : WithBot ℕ∞) ≤ y + ((r : ℕ) : WithBot ℕ∞) :=
      add_le_add hxy le_rfl
    have h2 : x + (1 + ((r : ℕ) : WithBot ℕ∞)) ≤ B := by
      rw [← add_assoc]
      exact h1.trans hyB
    have h3 : (1 : WithBot ℕ∞) + ((r : ℕ) : WithBot ℕ∞) = ((r + 1 : ℕ) : WithBot ℕ∞) := by
      rw [add_comm, ← Nat.cast_one, ← Nat.cast_add]
    rwa [h3] at h2

  have hWB_le_diff :
      ∀ (d : WithBot ℕ∞) (r b : ℕ), r ≤ b →
        d + ((r : ℕ) : WithBot ℕ∞) ≤ ((b : ℕ) : WithBot ℕ∞) →
        d ≤ ((b - r : ℕ) : WithBot ℕ∞) := by
    intro d r b hrb h
    cases d with
    | bot => exact bot_le
    | coe a =>
      cases a with
      | top =>
        have h' : (⊤ : ℕ∞) ≤ (b : ℕ∞) := WithBot.coe_le_coe.mp h
        exact absurd (top_le_iff.mp h') (ENat.natCast_ne_top b)
      | coe n =>
        have h' : ((n + r : ℕ) : ℕ∞) ≤ (b : ℕ∞) := WithBot.coe_le_coe.mp h
        have hn : n + r ≤ b := Nat.cast_le.mp h'
        have hn' : n ≤ b - r := by omega
        exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hn')

  have hWB_empty_of_lt :
      ∀ {α : Type u} [TopologicalSpace α] (S : Set α) (e b : ℕ), b < e →
        topologicalKrullDim ↥S + ((e : ℕ) : WithBot ℕ∞) ≤ ((b : ℕ) : WithBot ℕ∞) →
        S = ∅ := by
    intro α _ S e b hbe hdim
    ext z
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hz
    let z' : ↥S := ⟨z, hz⟩
    let c₀ : TopologicalSpace.IrreducibleCloseds ↥S :=
      ⟨closure ({z'} : Set ↥S), isIrreducible_singleton.closure, isClosed_closure⟩
    have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥S) := ⟨c₀⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥S := Order.krullDim_nonneg
    have h1 : (0 : WithBot ℕ∞) + ((e : ℕ) : WithBot ℕ∞) ≤ ((b : ℕ) : WithBot ℕ∞) :=
      (add_le_add h0 le_rfl).trans hdim
    rw [zero_add] at h1
    exact absurd (Nat.cast_le.mp h1) (by omega)

  
  have hSetEqDim :
      ∀ {α : Type u} [TopologicalSpace α] {A B : Set α},
        A = B → topologicalKrullDim ↥A = topologicalKrullDim ↥B := by
    rintro α _ A B rfl
    rfl

  have hEmbDim :
      ∀ {α β : Type u} [TopologicalSpace α] [TopologicalSpace β]
        {f : α → β} (hf : Topology.IsEmbedding f) (s : Set α),
        topologicalKrullDim ↥(f '' s) = topologicalKrullDim ↥s :=
    fun hf s => ((hf.homeomorphImage s).isHomeomorph.topologicalKrullDim_eq).symm

  have hRestrictSub :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (W : X.Opens) (U₀ : Y.Opens)
        (hle : f ⁻¹ᵁ U₀ ≤ W),
        CategoryTheory.IsPullback (f ∣_ U₀) (X.homOfLE hle) U₀.ι (W.ι ≫ f) := by
    intro X Y f W U₀ hle
    have h1 : CategoryTheory.IsPullback (f ∣_ U₀) (X.homOfLE hle ≫ W.ι) U₀.ι f := by
      rw [X.homOfLE_ι hle]
      exact AlgebraicGeometry.isPullback_morphismRestrict f U₀
    have hcomm : (f ∣_ U₀) ≫ U₀.ι = X.homOfLE hle ≫ (W.ι ≫ f) := h1.w
    refine CategoryTheory.IsPullback.of_isLimit (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
      (fun s => h1.lift s.fst (s.snd ≫ W.ι)
        (by rw [CategoryTheory.Category.assoc]; exact s.condition))
      (fun s => h1.lift_fst _ _ _)
      (fun s => by
        rw [← CategoryTheory.cancel_mono W.ι, CategoryTheory.Category.assoc]
        exact h1.lift_snd _ _ _)
      (fun s m hm₁ hm₂ => h1.hom_ext
        (hm₁.trans (h1.lift_fst _ _ _).symm)
        (by rw [← CategoryTheory.Category.assoc, hm₂]; exact (h1.lift_snd _ _ _).symm)))

  have hClosedHyp :
      ∀ (N₀ : ℕ) (F₀ : MvPolynomial (Fin (N₀ + 1)) k),
        IsClosed (weilProjHyperplaneSet k N₀ F₀) := by
    intro N₀ F₀
    let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k) :=
      MvPolynomial.gradedAlgebra
    exact (AlgebraicGeometry.Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k) F₀).isOpen.isClosed_compl

  
  obtain ⟨N, ι_V, hClV⟩ := hProjVn
  have : AlgebraicGeometry.IsClosedImmersion ι_V.left := hClV

  obtain ⟨Z_div, ι_div, U_sm_div, Z_low,
      hCl_div, hRed_div, hClosed_low, hZ_decomp,
      hDim_div, hDim_low, hSm_div, hDim_divSing⟩ :=
    weil_algClosed_noetherian_boundary_div_low_smooth k m N hm V_norm
      hIntVn hDimVn ι_V hClV Z_closed hClosedZ hProperZ
  have : AlgebraicGeometry.IsClosedImmersion ι_div := hCl_div

  let Z_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (ι_div ≫ V_norm.hom)
  let ι_Z_proj : Z_over ⟶ weilProjectiveSpaceOver k N :=
    CategoryTheory.Over.homMk (ι_div ≫ ι_V.left)
      (by dsimp [Z_over]; rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_V])
  have hClZ_proj : AlgebraicGeometry.IsClosedImmersion ι_Z_proj.left := by
    change AlgebraicGeometry.IsClosedImmersion (ι_div ≫ ι_V.left)
    infer_instance

  have hHypBounds := (weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint k N).1
  have hRatLift := (weil_algClosed_proj_hyperplane_krullDim_bounds_and_ratPoint k N).2
  have hBertiniInit := (weil_algClosed_bertini_transversal_step k N).1
  have hBertiniStep := (weil_algClosed_bertini_transversal_step k N).2

  
  have hembV : Topology.IsClosedEmbedding ι_V.left.base := ι_V.left.isClosedEmbedding
  let Y_tot : Set (weilProjectiveSpaceOver k N).left := ι_V.left.base '' Set.univ
  let Y_div : Set (weilProjectiveSpaceOver k N).left := ι_V.left.base '' Set.range ι_div.base
  let Y_sing : Set (weilProjectiveSpaceOver k N).left :=
    ι_V.left.base '' ((W_reg : Set V_norm.left)ᶜ)
  let Y_low : Set (weilProjectiveSpaceOver k N).left := ι_V.left.base '' Z_low
  let Y_divSing : Set (weilProjectiveSpaceOver k N).left :=
    ι_V.left.base '' (ι_div.base '' ((U_sm_div : Set Z_div)ᶜ))

  have hClosed_Ytot : IsClosed Y_tot := hembV.isClosedMap _ isClosed_univ
  have hClosed_Ydiv : IsClosed Y_div :=
    hembV.isClosedMap _ ι_div.isClosedEmbedding.isClosed_range
  have hClosed_Ysing : IsClosed Y_sing :=
    hembV.isClosedMap _ W_reg.isOpen.isClosed_compl
  have hClosed_Ylow : IsClosed Y_low := hembV.isClosedMap _ hClosed_low
  have hClosed_YdivSing : IsClosed Y_divSing :=
    hembV.isClosedMap _ (ι_div.isClosedEmbedding.isClosedMap _ U_sm_div.isOpen.isClosed_compl)

  have hDim_Ytot : topologicalKrullDim ↥Y_tot = ((m + 1 : ℕ) : WithBot ℕ∞) := by
    rw [hEmbDim hembV.isEmbedding Set.univ,
      (Homeomorph.Set.univ V_norm.left).isHomeomorph.topologicalKrullDim_eq]
    exact hDimVn
  have hDim_Ydiv : topologicalKrullDim ↥Y_div ≤ ((m : ℕ) : WithBot ℕ∞) := by
    rw [hEmbDim hembV.isEmbedding]
    exact hDim_div
  have hDim_Ysing : topologicalKrullDim ↥Y_sing ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
    rw [hEmbDim hembV.isEmbedding]
    exact hWB_sing _ hDimSing
  have hDim_Ylow : topologicalKrullDim ↥Y_low ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
    rw [hEmbDim hembV.isEmbedding]
    exact hDim_low
  have hDim_YdivSing : topologicalKrullDim ↥Y_divSing ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
    rw [hEmbDim hembV.isEmbedding]
    exact hDim_divSing

  
  let M_slice : ∀ (r : ℕ), (Fin r → MvPolynomial (Fin (N + 1)) k) →
      Set (weilProjectiveSpaceOver k N).left :=
    fun r Fr => {y | ∀ j : Fin r, y ∈ weilProjHyperplaneSet k N (Fr j)}

  have hM_zero : M_slice 0 Fin.elim0 = Set.univ := by
    ext y
    simp [M_slice]

  have hM_snoc :
      ∀ (r : ℕ) (Fr : Fin r → MvPolynomial (Fin (N + 1)) k)
        (F_new : MvPolynomial (Fin (N + 1)) k),
        M_slice (r + 1) (Fin.snoc Fr F_new) =
          M_slice r Fr ∩ weilProjHyperplaneSet k N F_new := by
    intro r Fr F_new
    ext y
    simp only [M_slice, Set.mem_ofPred_eq, Set.mem_inter_iff, Fin.forall_fin_succ',
      Fin.snoc_castSucc, Fin.snoc_last]

  have hM_closed :
      ∀ (r : ℕ) (Fr : Fin r → MvPolynomial (Fin (N + 1)) k),
        IsClosed (M_slice r Fr) := by
    intro r Fr
    have hEq : M_slice r Fr = ⋂ j : Fin r, weilProjHyperplaneSet k N (Fr j) := by
      ext y
      simp [M_slice]
    rw [hEq]
    exact isClosed_iInter fun j => hClosedHyp N (Fr j)

  have hFlag :
      ∀ (r : ℕ), r ≤ m →
        ∃ (Fr : Fin r → MvPolynomial (Fin (N + 1)) k),
          topologicalKrullDim ↥(Y_tot ∩ M_slice r Fr) + ((r : ℕ) : WithBot ℕ∞) ≤
            ((m + 1 : ℕ) : WithBot ℕ∞) ∧
          (((m + 1 - r : ℕ) : WithBot ℕ∞) ≤
            topologicalKrullDim ↥(Y_tot ∩ M_slice r Fr)) ∧
          topologicalKrullDim ↥(Y_div ∩ M_slice r Fr) + ((r : ℕ) : WithBot ℕ∞) ≤
            ((m : ℕ) : WithBot ℕ∞) ∧
          topologicalKrullDim ↥(Y_sing ∩ M_slice r Fr) + ((r : ℕ) : WithBot ℕ∞) ≤
            ((m - 1 : ℕ) : WithBot ℕ∞) ∧
          topologicalKrullDim ↥(Y_low ∩ M_slice r Fr) + ((r : ℕ) : WithBot ℕ∞) ≤
            ((m - 1 : ℕ) : WithBot ℕ∞) ∧
          topologicalKrullDim ↥(Y_divSing ∩ M_slice r Fr) + ((r : ℕ) : WithBot ℕ∞) ≤
            ((m - 1 : ℕ) : WithBot ℕ∞) ∧
          IsTransversalLinearSlice k N V_norm ι_V W_reg (m + 1 - r) r Fr ∧
          IsTransversalLinearSlice k N Z_over ι_Z_proj U_sm_div (m - r) r Fr := by
    intro r
    induction r with
    | zero =>
      intro _
      refine ⟨Fin.elim0, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [hSetEqDim (by rw [hM_zero, Set.inter_univ]), Nat.cast_zero, add_zero, hDim_Ytot]
      · rw [hSetEqDim (by rw [hM_zero, Set.inter_univ]), Nat.sub_zero, hDim_Ytot]
      · rw [hSetEqDim (by rw [hM_zero, Set.inter_univ]), Nat.cast_zero, add_zero]
        exact hDim_Ydiv
      · rw [hSetEqDim (by rw [hM_zero, Set.inter_univ]), Nat.cast_zero, add_zero]
        exact hDim_Ysing
      · rw [hSetEqDim (by rw [hM_zero, Set.inter_univ]), Nat.cast_zero, add_zero]
        exact hDim_Ylow
      · rw [hSetEqDim (by rw [hM_zero, Set.inter_univ]), Nat.cast_zero, add_zero]
        exact hDim_YdivSing
      · rw [Nat.sub_zero]
        exact hBertiniInit V_norm ι_V hClV W_reg (m + 1) hSmWreg
      · rw [Nat.sub_zero]
        exact hBertiniInit Z_over ι_Z_proj hClZ_proj U_sm_div m hSm_div
    | succ r ih =>
      intro hr_succ
      have hr : r ≤ m := Nat.le_of_succ_le hr_succ
      obtain ⟨Fr, hTotU, hTotL, hDivU, hSingU, hLowU, hDivSingU, hSlV, hSlZ⟩ := ih hr
      have hClosedMr : IsClosed (M_slice r Fr) := hM_closed r Fr
      let Y₅ : Fin 5 → Set (weilProjectiveSpaceOver k N).left := fun a =>
        if a.1 = 0 then Y_tot ∩ M_slice r Fr
        else if a.1 = 1 then Y_div ∩ M_slice r Fr
        else if a.1 = 2 then Y_sing ∩ M_slice r Fr
        else if a.1 = 3 then Y_low ∩ M_slice r Fr
        else Y_divSing ∩ M_slice r Fr
      have hClosedY₅ : ∀ a : Fin 5, IsClosed (Y₅ a) := by
        intro a
        dsimp only [Y₅]
        split_ifs
        · exact hClosed_Ytot.inter hClosedMr
        · exact hClosed_Ydiv.inter hClosedMr
        · exact hClosed_Ysing.inter hClosedMr
        · exact hClosed_Ylow.inter hClosedMr
        · exact hClosed_YdivSing.inter hClosedMr
      let X₂ : Fin 2 → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        Fin.cases V_norm (fun _ => Z_over)
      let ι_X₂ : ∀ l : Fin 2, X₂ l ⟶ weilProjectiveSpaceOver k N :=
        Fin.cases ι_V (fun _ => ι_Z_proj)
      have hClX₂ : ∀ l : Fin 2, AlgebraicGeometry.IsClosedImmersion (ι_X₂ l).left := by
        refine Fin.cases hClV (fun i => ?_)
        obtain rfl : i = 0 := Subsingleton.elim i 0
        exact hClZ_proj
      let U₂ : ∀ l : Fin 2, (X₂ l).left.Opens :=
        Fin.cases W_reg (fun _ => U_sm_div)
      let d₂ : Fin 2 → ℕ := Fin.cases (m + 1 - r) (fun _ => m - r)
      have hd₂ : ∀ l : Fin 2, 1 ≤ d₂ l := by
        refine Fin.cases ?_ (fun i => ?_)
        · change 1 ≤ m + 1 - r
          omega
        · obtain rfl : i = 0 := Subsingleton.elim i 0
          change 1 ≤ m - r
          omega
      let ν₂ : Fin 2 → ℕ := fun _ => r
      let F_prev₂ : ∀ l : Fin 2, Fin (ν₂ l) → MvPolynomial (Fin (N + 1)) k := fun _ => Fr
      have hSl₂ : ∀ l : Fin 2,
          IsTransversalLinearSlice k N (X₂ l) (ι_X₂ l) (U₂ l) (d₂ l) (ν₂ l) (F_prev₂ l) := by
        refine Fin.cases hSlV (fun i => ?_)
        obtain rfl : i = 0 := Subsingleton.elim i 0
        exact hSlZ
      obtain ⟨F_new, hFnew_hom, hFnew_ne, hDrop₅, hNext₂⟩ :=
        hBertiniStep 5 2 Y₅ hClosedY₅ X₂ ι_X₂ hClX₂ U₂ d₂ ν₂ hd₂ F_prev₂ hSl₂
      refine ⟨Fin.snoc Fr F_new, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · have hd : topologicalKrullDim
            ↥((Y_tot ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_tot ∩ M_slice r Fr) := hDrop₅ 0
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hTotU
      · rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        have he_pos : 1 ≤ m + 1 - r := by omega
        have hLow := (hHypBounds (Y_tot ∩ M_slice r Fr) (hClosed_Ytot.inter hClosedMr)
          (m + 1 - r) he_pos hTotL F_new hFnew_hom hFnew_ne).2
        have hsub : m + 1 - r - 1 = m + 1 - (r + 1) := by omega
        rwa [hsub] at hLow
      · have hd : topologicalKrullDim
            ↥((Y_div ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_div ∩ M_slice r Fr) := hDrop₅ 1
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hDivU
      · have hd : topologicalKrullDim
            ↥((Y_sing ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_sing ∩ M_slice r Fr) := hDrop₅ 2
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hSingU
      · have hd : topologicalKrullDim
            ↥((Y_low ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_low ∩ M_slice r Fr) := hDrop₅ 3
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hLowU
      · have hd : topologicalKrullDim
            ↥((Y_divSing ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_divSing ∩ M_slice r Fr) := hDrop₅ 4
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hDivSingU
      · have h0 := hNext₂ 0
        change IsTransversalLinearSlice k N V_norm ι_V W_reg (m + 1 - r - 1) (r + 1)
          (Fin.snoc Fr F_new) at h0
        have hsub : m + 1 - r - 1 = m + 1 - (r + 1) := by omega
        rwa [hsub] at h0
      · have h1 := hNext₂ ((0 : Fin 1).succ)
        change IsTransversalLinearSlice k N Z_over ι_Z_proj U_sm_div (m - r - 1) (r + 1)
          (Fin.snoc Fr F_new) at h1
        have hsub : m - r - 1 = m - (r + 1) := by omega
        rwa [hsub] at h1

  obtain ⟨F_init, hTotU_m, hTotL_m, hDivU_m, hSingU_m, hLowU_m, hDivSingU_m,
      hSlV_m, hSlZ_m⟩ := hFlag m le_rfl
  let M_m := M_slice m F_init
  have hClosed_Mm : IsClosed M_m := hM_closed m F_init

  have hSub_m1 : m + 1 - m = 1 := by omega
  rw [hSub_m1] at hTotL_m hSlV_m
  rw [Nat.sub_self] at hSlZ_m

  have hDim_TotMm : topologicalKrullDim ↥(Y_tot ∩ M_m) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    have h := hWB_le_diff _ m (m + 1) (by omega) hTotU_m
    rwa [hSub_m1] at h

  have hDim_DivMm : topologicalKrullDim ↥(Y_div ∩ M_m) ≤ (0 : WithBot ℕ∞) := by
    have h := hWB_le_diff _ m m le_rfl hDivU_m
    rwa [Nat.sub_self] at h

  have hEmpty_SingMm : Y_sing ∩ M_m = ∅ :=
    hWB_empty_of_lt _ m (m - 1) (by omega) hSingU_m
  have hEmpty_LowMm : Y_low ∩ M_m = ∅ :=
    hWB_empty_of_lt _ m (m - 1) (by omega) hLowU_m
  have hEmpty_DivSingMm : Y_divSing ∩ M_m = ∅ :=
    hWB_empty_of_lt _ m (m - 1) (by omega) hDivSingU_m

  
  let Y₂_step : Fin 2 → Set (weilProjectiveSpaceOver k N).left := fun a =>
    if a.1 = 0 then Y_tot ∩ M_m else Y_div ∩ M_m
  have hClosedY₂ : ∀ a : Fin 2, IsClosed (Y₂_step a) := by
    intro a
    dsimp only [Y₂_step]
    split_ifs
    · exact hClosed_Ytot.inter hClosed_Mm
    · exact hClosed_Ydiv.inter hClosed_Mm

  obtain ⟨F_m_form, hFm_hom, hFm_ne, hDrop_m, hNext_m⟩ :=
    hBertiniStep 2 1 Y₂_step hClosedY₂
      (fun _ => V_norm) (fun _ => ι_V) (fun _ => hClV) (fun _ => W_reg)
      (fun _ => 1) (fun _ => m) (fun _ => le_rfl) (fun _ => F_init) (fun _ => hSlV_m)

  have hSlV_m1 : IsTransversalLinearSlice k N V_norm ι_V W_reg 0 (m + 1)
      (Fin.snoc F_init F_m_form) := by
    simpa using hNext_m 0

  have hDim_TotCenter :
      topologicalKrullDim ↥((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ≤
        (0 : WithBot ℕ∞) := by
    have hd : topologicalKrullDim ↥((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) + 1 ≤
        topologicalKrullDim ↥(Y_tot ∩ M_m) := hDrop_m 0
    have h0 : topologicalKrullDim ↥((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) + 1 ≤
        ((1 : ℕ) : WithBot ℕ∞) :=
      hd.trans hDim_TotMm
    exact hWB_le_diff _ 1 1 le_rfl h0

  have hNonempty_TotCenter :
      ((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form).Nonempty :=
    (hHypBounds (Y_tot ∩ M_m) (hClosed_Ytot.inter hClosed_Mm)
      1 le_rfl hTotL_m F_m_form hFm_hom hFm_ne).1

  have hEmpty_DivCenter :
      (Y_div ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form = ∅ := by
    have hd : topologicalKrullDim ↥((Y_div ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) + 1 ≤
        topologicalKrullDim ↥(Y_div ∩ M_m) := hDrop_m 1
    have h1 : topologicalKrullDim ↥((Y_div ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) +
        ((1 : ℕ) : WithBot ℕ∞) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
      hd.trans hDim_DivMm
    exact hWB_empty_of_lt _ 1 0 (by omega) h1

  obtain ⟨F_last_form, hFlast_hom, _, hDrop_last, _⟩ :=
    hBertiniStep 1 0
      (fun _ => (Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form)
      (fun _ => (hClosed_Ytot.inter hClosed_Mm).inter (hClosedHyp N F_m_form))
      Fin.elim0 (fun l => Fin.elim0 l) (fun l => Fin.elim0 l) (fun l => Fin.elim0 l)
      Fin.elim0 Fin.elim0 (fun l => Fin.elim0 l) (fun l => Fin.elim0 l) (fun l => Fin.elim0 l)

  have hEmpty_TotAll :
      ((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ∩
        weilProjHyperplaneSet k N F_last_form = ∅ := by
    have h0 : topologicalKrullDim
        ↥(((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ∩
          weilProjHyperplaneSet k N F_last_form) + ((1 : ℕ) : WithBot ℕ∞) ≤
        ((0 : ℕ) : WithBot ℕ∞) :=
      (hDrop_last 0).trans hDim_TotCenter
    exact hWB_empty_of_lt _ 1 0 (by omega) h0

  
  let F_m1 : Fin (m + 1) → MvPolynomial (Fin (N + 1)) k := Fin.snoc F_init F_m_form
  let F : Fin (m + 1 + 1) → MvPolynomial (Fin (N + 1)) k := Fin.snoc F_m1 F_last_form

  have hF_cast1 : (fun i : Fin (m + 1) => F i.castSucc) = F_m1 := by
    ext i
    simp only [F, Fin.snoc_castSucc]
  have hF_last1 : F (Fin.last (m + 1)) = F_last_form := by
    simp only [F, Fin.snoc_last]
  have hF_m_eq : F (Fin.last m).castSucc = F_m_form := by
    simp only [F, F_m1, Fin.snoc_castSucc, Fin.snoc_last]
  have hF_init_eq : (fun j : Fin m => F (j.castSucc).castSucc) = F_init := by
    ext j
    simp only [F, F_m1, Fin.snoc_castSucc]

  have hF_hom : ∀ a : Fin (m + 1 + 1),
      F a ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 := by
    refine Fin.lastCases ?_ (fun i => ?_)
    · rw [hF_last1]
      exact hFlast_hom
    · rw [congrFun hF_cast1 i]
      revert i
      refine Fin.lastCases ?_ (fun j => ?_)
      · simp only [F_m1, Fin.snoc_last]
        exact hFm_hom
      · simp only [F_m1, Fin.snoc_castSucc]
        exact hSlV_m.1 j

  have hF_bp : ∀ x : V_norm.left, ∃ a : Fin (m + 1 + 1),
      ι_V.left.base x ∉ weilProjHyperplaneSet k N (F a) := by
    intro x
    by_contra! hAll
    have hx_tot : ι_V.left.base x ∈ Y_tot := ⟨x, trivial, rfl⟩
    have hx_Mm : ι_V.left.base x ∈ M_m := by
      intro j
      have h := hAll (j.castSucc).castSucc
      simpa [F, F_m1, Fin.snoc_castSucc] using h
    have hx_Fm : ι_V.left.base x ∈ weilProjHyperplaneSet k N F_m_form := by
      have h := hAll (Fin.last m).castSucc
      rwa [hF_m_eq] at h
    have hx_Flast : ι_V.left.base x ∈ weilProjHyperplaneSet k N F_last_form := by
      have h := hAll (Fin.last (m + 1))
      rwa [hF_last1] at h
    have hIn : ι_V.left.base x ∈
        ((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ∩
          weilProjHyperplaneSet k N F_last_form :=
      ⟨⟨⟨hx_tot, hx_Mm⟩, hx_Fm⟩, hx_Flast⟩
    rw [hEmpty_TotAll] at hIn
    exact hIn

  
  obtain ⟨hIntP, _, hDimP, _⟩ :=
    weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k (m + 1)

  obtain ⟨π, b_star, hFin_π, hSurj_π, hPre_Uproj, hChart_π, hb_star_iff,
      hChart_WV, hDiv_pkg⟩ :=
    weil_proj_basepointFree_linear_projection_package k m N hm V_norm
      hIntVn hDimVn hIntP hDimP ι_V hClV pr_p₀ hPr F hF_hom hF_bp
  have : AlgebraicGeometry.IsFinite π.left := hFin_π

  
  let U_φ₁ : V_norm.left.Opens := π.left ⁻¹ᵁ U_proj
  let S₀ : Set V_norm.left := (U_φ₁ : Set V_norm.left)ᶜ
  have hClosed_S₀ : IsClosed S₀ := U_φ₁.isOpen.isClosed_compl

  have hS₀_iff :
      ∀ x : V_norm.left,
        x ∈ S₀ ↔
          (∀ j : Fin m, ι_V.left.base x ∈ weilProjHyperplaneSet k N (F_init j)) ∧
            ι_V.left.base x ∈ weilProjHyperplaneSet k N F_m_form := by
    intro x
    change π.left.base x ∉ U_proj ↔ _
    rw [hPre_Uproj x, not_exists]
    simp only [not_not, Fin.forall_fin_succ', hF_m_eq]
    refine and_congr_left' (forall_congr' fun j => ?_)
    change ι_V.left.base x ∈ weilProjHyperplaneSet k N (F (j.castSucc).castSucc) ↔ _
    rw [congrFun hF_init_eq j]

  have hImg_S₀ :
      ι_V.left.base '' S₀ = (Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form := by
    ext y
    refine ⟨?_, ?_⟩
    · rintro ⟨x, hxS, rfl⟩
      obtain ⟨hxMm, hxFm⟩ := (hS₀_iff x).mp hxS
      exact ⟨⟨⟨x, trivial, rfl⟩, hxMm⟩, hxFm⟩
    · rintro ⟨⟨⟨x, _, rfl⟩, hxMm⟩, hxFm⟩
      exact ⟨x, (hS₀_iff x).mpr ⟨hxMm, hxFm⟩, rfl⟩

  have hDim_S₀ : topologicalKrullDim ↥S₀ ≤ (0 : WithBot ℕ∞) := by
    rw [← hEmbDim hembV.isEmbedding S₀, hSetEqDim hImg_S₀]
    exact hDim_TotCenter

  obtain ⟨y_star, hy_star⟩ := hNonempty_TotCenter
  rw [← hImg_S₀] at hy_star
  obtain ⟨x_star, hx_star_S₀, _⟩ := hy_star

  have hPt_lift :
      ∀ x : V_norm.left, π.left.base x ∉ U_proj →
        ∃ q_x : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ V_norm.left,
          q_x ≫ V_norm.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
          x ∈ Set.range q_x.base :=
    fun x hx => hRatLift V_norm ι_V hClV S₀ hClosed_S₀ hDim_S₀ x hx

  obtain ⟨q_sec, hq_sec_hom, pt₀, hpt₀⟩ := hPt_lift x_star hx_star_S₀
  have hq_sec_range :
      Set.range (q_sec ≫ π.left).base ⊆ ((U_proj : Set P_amb.left)ᶜ) := by
    rintro _ ⟨pt, rfl⟩
    have hpt_eq : pt = pt₀ := Subsingleton.elim pt pt₀
    change π.left.base (q_sec.base pt) ∉ U_proj
    rw [hpt_eq, hpt₀]
    exact hx_star_S₀

  
  have hRange_div_sub : Set.range ι_div.base ⊆ Set.range U_φ₁.ι.base := by
    rw [U_φ₁.range_ι]
    rintro _ ⟨z, rfl⟩
    by_contra hz_not
    obtain ⟨hzMm, hzFm⟩ := (hS₀_iff (ι_div.base z)).mp hz_not
    have hIn : ι_V.left.base (ι_div.base z) ∈
        (Y_div ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form :=
      ⟨⟨⟨ι_div.base z, ⟨z, rfl⟩, rfl⟩, hzMm⟩, hzFm⟩
    rw [hEmpty_DivCenter] at hIn
    exact hIn

  let j_div : Z_div ⟶ (U_φ₁ : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsOpenImmersion.lift U_φ₁.ι ι_div hRange_div_sub
  have hj_div_ι : j_div ≫ U_φ₁.ι = ι_div :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_φ₁.ι ι_div hRange_div_sub

  have hZ_low_sub : Z_low ⊆ (U_φ₁ : Set V_norm.left) := by
    intro x hx_low
    by_contra hx_not
    obtain ⟨hxMm, _⟩ := (hS₀_iff x).mp hx_not
    have hIn : ι_V.left.base x ∈ Y_low ∩ M_m := ⟨⟨x, hx_low, rfl⟩, hxMm⟩
    rw [hEmpty_LowMm] at hIn
    exact hIn

  obtain ⟨hFin_div, hChart_Zdiv⟩ := hDiv_pkg Z_div ι_div hCl_div j_div hj_div_ι

  have hb_star_low :
      ∀ x : ↥(U_φ₁ : AlgebraicGeometry.Scheme.{u}),
        x.1 ∈ Z_low → ((π.left ∣_ U_proj) ≫ pr_p₀).base x ≠ b_star := by
    intro x hx_low hEq
    have hx_iff := (hb_star_iff x).mp hEq
    have hxMm : ι_V.left.base x.1 ∈ M_m := by
      intro j
      have h := hx_iff.2 j
      rwa [congrFun hF_init_eq j] at h
    have hIn : ι_V.left.base x.1 ∈ Y_low ∩ M_m := ⟨⟨x.1, hx_low, rfl⟩, hxMm⟩
    rw [hEmpty_LowMm] at hIn
    exact hIn

  
  
  obtain ⟨W_π_et, hWπ_mem, hWπ_G, hWπ_sm⟩ :=
    weil_transversalLinearSlice_relative_smooth_chart k N 0 (m + 1)
      V_norm ι_V hClV W_reg F_m1 hSlV_m1 F_last_form hFlast_hom

  have hSm0_Wπ : AlgebraicGeometry.SmoothOfRelativeDimension 0 (W_π_et.ι ≫ π.left) := by
    apply hWπ_sm
    have hCh := hChart_π W_π_et (by rwa [hF_last1])
    rwa [hF_cast1, hF_last1] at hCh
  have hEt_Wπ : AlgebraicGeometry.Etale (W_π_et.ι ≫ π.left) :=
    (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero (W_π_et.ι ≫ π.left)).mpr hSm0_Wπ

  let K_π : Set P_amb.left := π.left.base '' ((W_π_et : Set V_norm.left)ᶜ)
  have hClosed_Kπ : IsClosed K_π :=
    AlgebraicGeometry.Scheme.Hom.isClosedMap π.left _ W_π_et.isOpen.isClosed_compl
  let U_et_π : P_amb.left.Opens := ⟨K_πᶜ, hClosed_Kπ.isOpen_compl⟩

  have hSub_et_π : ((U_proj : Set P_amb.left)ᶜ) ⊆ (U_et_π : Set P_amb.left) := by
    rintro y hy_not ⟨x, hx_not_Wπ, rfl⟩
    have hx_S₀ : x ∈ S₀ := hy_not
    obtain ⟨hxMm, hxFm⟩ := (hS₀_iff x).mp hx_S₀
    have hx_Wreg : x ∈ W_reg := by
      by_contra hx_sing
      have hIn : ι_V.left.base x ∈ Y_sing ∩ M_m := ⟨⟨x, hx_sing, rfl⟩, hxMm⟩
      rw [hEmpty_SingMm] at hIn
      exact hIn
    have hx_not_Flast : ι_V.left.base x ∉ weilProjHyperplaneSet k N F_last_form := by
      intro hxFlast
      have hIn : ι_V.left.base x ∈
          ((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ∩
            weilProjHyperplaneSet k N F_last_form :=
        ⟨⟨⟨⟨x, trivial, rfl⟩, hxMm⟩, hxFm⟩, hxFlast⟩
      rw [hEmpty_TotAll] at hIn
      exact hIn
    have hx_Fm1 : ∀ i : Fin (m + 1), ι_V.left.base x ∈ weilProjHyperplaneSet k N (F_m1 i) := by
      refine Fin.lastCases ?_ (fun j => ?_)
      · simpa [F_m1] using hxFm
      · simpa [F_m1] using hxMm j
    exact hx_not_Wπ (hWπ_mem x hx_Wreg hx_not_Flast hx_Fm1)

  have hPre_et_π : π.left ⁻¹ᵁ U_et_π ≤ W_π_et := by
    intro x hx
    by_contra hx_not
    exact hx ⟨x, hx_not, rfl⟩
  have hPb_et_π := hRestrictSub π.left W_π_et U_et_π hPre_et_π
  have hEt_π : AlgebraicGeometry.Etale (π.left ∣_ U_et_π) :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.Etale)
      hPb_et_π.flip hEt_Wπ

  
  obtain ⟨W_V, hWV_mem, hWV_G, hWV_sm⟩ :=
    weil_transversalLinearSlice_relative_smooth_chart k N 1 m
      V_norm ι_V hClV W_reg F_init hSlV_m F_m_form hFm_hom

  obtain ⟨hWU, hChart_WV'⟩ := hChart_WV W_V (by rwa [hF_m_eq])
  rw [hF_init_eq, hF_m_eq] at hChart_WV'
  have hSm1_WV : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (V_norm.left.homOfLE hWU ≫ (π.left ∣_ U_proj) ≫ pr_p₀) :=
    hWV_sm _ hChart_WV'

  let j_sm₀ : W_V.toScheme ⟶ (U_φ₁ : AlgebraicGeometry.Scheme.{u}) :=
    V_norm.left.homOfLE hWU
  let W_sm₀ : ((U_φ₁ : AlgebraicGeometry.Scheme.{u}).Opens) := j_sm₀.opensRange

  have hSm_Wsm₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
    have hEq : W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀ =
        j_sm₀.isoOpensRange.inv ≫ (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
      calc W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀
          = (j_sm₀.isoOpensRange.inv ≫ j_sm₀.isoOpensRange.hom) ≫
              W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀ := by
              rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = j_sm₀.isoOpensRange.inv ≫ (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
              rw [CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι_assoc]
    rw [hEq]
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 j_sm₀.isoOpensRange.inv := inferInstance
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := hSm1_WV
    have : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        (j_sm₀.isoOpensRange.inv ≫ (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀)) := inferInstance
    simpa using this

  have hb_star_sm :
      ∀ x : ↥(U_φ₁ : AlgebraicGeometry.Scheme.{u}),
        ((π.left ∣_ U_proj) ≫ pr_p₀).base x = b_star → x ∈ W_sm₀ := by
    intro x hEq
    obtain ⟨hxNotFm, hxMm_raw⟩ := (hb_star_iff x).mp hEq
    rw [hF_m_eq] at hxNotFm
    have hxMm : ∀ j : Fin m, ι_V.left.base x.1 ∈ weilProjHyperplaneSet k N (F_init j) := by
      intro j
      have h := hxMm_raw j
      rwa [congrFun hF_init_eq j] at h
    have hx_Wreg : x.1 ∈ W_reg := by
      by_contra hx_sing
      have hIn : ι_V.left.base x.1 ∈ Y_sing ∩ M_m := ⟨⟨x.1, hx_sing, rfl⟩, hxMm⟩
      rw [hEmpty_SingMm] at hIn
      exact hIn
    have hx_WV : x.1 ∈ W_V := hWV_mem x.1 hx_Wreg hxNotFm hxMm
    refine ⟨⟨x.1, hx_WV⟩, ?_⟩
    apply Subtype.ext
    exact AlgebraicGeometry.Scheme.homOfLE_apply hWU ⟨x.1, hx_WV⟩

  
  obtain ⟨W_et₀, hWet_mem, hWet_G, hWet_sm⟩ :=
    weil_transversalLinearSlice_relative_smooth_chart k N 0 m
      Z_over ι_Z_proj hClZ_proj U_sm_div F_init hSlZ_m F_m_form hFm_hom

  have hSm0_Wet₀ : AlgebraicGeometry.SmoothOfRelativeDimension 0
      (W_et₀.ι ≫ j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
    apply hWet_sm
    have hCh := hChart_Zdiv W_et₀ (by rwa [hF_m_eq])
    rwa [hF_init_eq, hF_m_eq] at hCh
  have hEt_Wet₀ : AlgebraicGeometry.Etale
      (W_et₀.ι ≫ j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀) :=
    (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero _).mpr hSm0_Wet₀

  have hb_star_et :
      ∀ z : Z_div,
        (j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀).base z = b_star → z ∈ W_et₀ := by
    intro z hEq
    have hEq' : ((π.left ∣_ U_proj) ≫ pr_p₀).base (j_div.base z) = b_star := hEq
    obtain ⟨hzNotFm, hzMm_raw⟩ := (hb_star_iff (j_div.base z)).mp hEq'
    have hj_val : (j_div.base z).1 = ι_div.base z := by
      rw [← AlgebraicGeometry.Scheme.Opens.ι_apply U_φ₁ (j_div.base z)]
      change (j_div ≫ U_φ₁.ι).base z = ι_div.base z
      rw [hj_div_ι]
    rw [hj_val, hF_m_eq] at hzNotFm
    have hzMm : ∀ j : Fin m,
        (ι_div ≫ ι_V.left).base z ∈ weilProjHyperplaneSet k N (F_init j) := by
      intro j
      have h := hzMm_raw j
      rw [hj_val, congrFun hF_init_eq j] at h
      exact h
    have hz_Usm : z ∈ U_sm_div := by
      by_contra hz_sing
      have hIn : ι_V.left.base (ι_div.base z) ∈ Y_divSing ∩ M_m :=
        ⟨⟨ι_div.base z, ⟨z, hz_sing, rfl⟩, rfl⟩, hzMm⟩
      rw [hEmpty_DivSingMm] at hIn
      exact hIn
    exact hWet_mem z hz_Usm hzNotFm hzMm

  exact ⟨π, U_et_π, q_sec, Z_div, ι_div, j_div, Z_low, b_star, W_sm₀, W_et₀,
    hFin_π, hSurj_π, hSub_et_π, hEt_π, hq_sec_hom, hq_sec_range, hPt_lift,
    hCl_div, hRed_div, hClosed_low, hZ_decomp, hj_div_ι, hZ_low_sub, hFin_div,
    hb_star_low, hb_star_sm, hSm_Wsm₀, hb_star_et, hEt_Wet₀⟩

theorem weil_etale_exc_open_iso_pullback_isIntegral (X Y Z : AlgebraicGeometry.Scheme.{u})
    (f : X ⟶ Z) (g : Y ⟶ Z)
    (hIntX : AlgebraicGeometry.IsIntegral X)
    (hIntY : AlgebraicGeometry.IsIntegral Y)
    (U U_et : Z.Opens)
    (hNonempty : Nonempty ↥(f ⁻¹ᵁ U))
    [CategoryTheory.IsIso (g ∣_ U)]
    (hEt : AlgebraicGeometry.Etale (f ∣_ U_et))
    (hCov : (U : Set Z) ∪ (U_et : Set Z) = Set.univ) :
    AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f g) :=
by
  have : AlgebraicGeometry.IsIntegral X := hIntX
  have : AlgebraicGeometry.IsIntegral Y := hIntY
  have : IrreducibleSpace ↥Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y

  have hPullRestrict :
      ∀ (V : Z.Opens),
        ∃ q_V : ((CategoryTheory.Limits.pullback.fst f g) ⁻¹ᵁ (f ⁻¹ᵁ V)).toScheme ⟶
            (g ⁻¹ᵁ V).toScheme,
          q_V ≫ (g ⁻¹ᵁ V).ι =
            ((CategoryTheory.Limits.pullback.fst f g) ⁻¹ᵁ (f ⁻¹ᵁ V)).ι ≫
              CategoryTheory.Limits.pullback.snd f g ∧
          CategoryTheory.IsPullback
            ((CategoryTheory.Limits.pullback.fst f g) ∣_ (f ⁻¹ᵁ V)) q_V (f ∣_ V) (g ∣_ V) := by
    intro V
    let fst := CategoryTheory.Limits.pullback.fst f g
    let snd := CategoryTheory.Limits.pullback.snd f g
    have hBase : CategoryTheory.IsPullback fst snd f g :=
      CategoryTheory.IsPullback.of_hasPullback f g
    have hTop : CategoryTheory.IsPullback (fst ∣_ (f ⁻¹ᵁ V)) (fst ⁻¹ᵁ (f ⁻¹ᵁ V)).ι
        (f ⁻¹ᵁ V).ι fst :=
      AlgebraicGeometry.isPullback_morphismRestrict fst (f ⁻¹ᵁ V)
    have hBot : CategoryTheory.IsPullback (g ∣_ V) (g ⁻¹ᵁ V).ι V.ι g :=
      AlgebraicGeometry.isPullback_morphismRestrict g V
    have hOuter : CategoryTheory.IsPullback (fst ∣_ (f ⁻¹ᵁ V)) ((fst ⁻¹ᵁ (f ⁻¹ᵁ V)).ι ≫ snd)
        ((f ∣_ V) ≫ V.ι) g := by
      rw [AlgebraicGeometry.morphismRestrict_ι f V]
      exact hTop.paste_vert hBase
    let q_V : (fst ⁻¹ᵁ (f ⁻¹ᵁ V)).toScheme ⟶ (g ⁻¹ᵁ V).toScheme :=
      hBot.lift ((fst ∣_ (f ⁻¹ᵁ V)) ≫ (f ∣_ V)) ((fst ⁻¹ᵁ (f ⁻¹ᵁ V)).ι ≫ snd)
        (by rw [CategoryTheory.Category.assoc]; exact hOuter.w)
    have hq_ι : q_V ≫ (g ⁻¹ᵁ V).ι = (fst ⁻¹ᵁ (f ⁻¹ᵁ V)).ι ≫ snd := hBot.lift_snd _ _ _
    have hq_comm : (fst ∣_ (f ⁻¹ᵁ V)) ≫ (f ∣_ V) = q_V ≫ (g ∣_ V) :=
      (hBot.lift_fst _ _ _).symm
    refine ⟨q_V, hq_ι, CategoryTheory.IsPullback.of_bot ?_ hq_comm hBot⟩
    rw [hq_ι]
    exact hOuter

  have hEtRed :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) (ψ : W ⟶ Y),
        AlgebraicGeometry.Etale ψ → AlgebraicGeometry.IsReduced W := by
    intro W ψ hEtψ
    have hStalk : ∀ w : ↥W, IsReduced ↑(W.presheaf.stalk w) := by
      intro w
      have hSm0 : AlgebraicGeometry.SmoothOfRelativeDimension 0 ψ :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero ψ).mp hEtψ
      obtain ⟨U_Y, _, V_W, hAffV, hwV, e, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 0 ψ).mp hSm0 w
      let A : Type u := ↑(Y.presheaf.obj (Opposite.op U_Y))
      let B : Type u := ↑(W.presheaf.obj (Opposite.op V_W))
      have : IsDomain A :=
        @AlgebraicGeometry.IsIntegral.component_integral Y hIntY U_Y ⟨⟨ψ.base w, e hwV⟩⟩
      let _ : Algebra A B := (ψ.appLE U_Y V_W e).hom.toAlgebra
      have : Algebra.IsStandardSmoothOfRelativeDimension 0 A B := hStd.toAlgebra 0
      have : Algebra.Etale A B := inferInstance
      have : Module.Flat A B := inferInstance
      let K : Type u := FractionRing A
      have hLinInj : Function.Injective (Algebra.linearMap A K) := IsFractionRing.injective A K
      have hRTensorInj : Function.Injective (LinearMap.rTensor B (Algebra.linearMap A K)) :=
        Module.Flat.rTensor_preserves_injective_linearMap (M := B) (Algebra.linearMap A K) hLinInj
      have hIncInj :
          Function.Injective (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B) := by
        intro b₁ b₂ hb
        apply (Algebra.TensorProduct.lid A B).symm.injective
        apply hRTensorInj
        simpa [Algebra.TensorProduct.lid_symm_apply] using hb
      have : Algebra.Etale K (TensorProduct A K B) := inferInstance
      obtain ⟨I, _, Ai, hField, hAlg, e_prod, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K (TensorProduct A K B)).mp inferInstance
      let _ : ∀ i, Field (Ai i) := hField
      let _ : ∀ i, Algebra K (Ai i) := hAlg
      have : IsReduced (TensorProduct A K B) := isReduced_of_injective e_prod e_prod.injective
      have hRedB : IsReduced B :=
        isReduced_of_injective (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B) hIncInj
      have : IsReduced ↑(W.presheaf.obj (Opposite.op V_W)) := hRedB
      have : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (W.presheaf.obj (Opposite.op V_W))) :=
        (AlgebraicGeometry.affine_isReduced_iff _).mpr hRedB
      have : AlgebraicGeometry.IsReduced (↑V_W : AlgebraicGeometry.Scheme.{u}) :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion hAffV.isoSpec.hom
      have : IsReduced ↑((↑V_W : AlgebraicGeometry.Scheme.{u}).presheaf.stalk ⟨w, hwV⟩) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced (↑V_W : AlgebraicGeometry.Scheme.{u}) ⟨w, hwV⟩
      exact isReduced_of_injective
        (AlgebraicGeometry.Scheme.Opens.stalkIso V_W ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv
        (AlgebraicGeometry.Scheme.Opens.stalkIso V_W ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.injective
    exact @AlgebraicGeometry.isReduced_of_isReduced_stalk W hStalk

  let P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f g
  let p_X : P ⟶ X := CategoryTheory.Limits.pullback.fst f g
  let p_Y : P ⟶ Y := CategoryTheory.Limits.pullback.snd f g
  let W_U : P.Opens := p_X ⁻¹ᵁ (f ⁻¹ᵁ U)
  let W_et : P.Opens := p_X ⁻¹ᵁ (f ⁻¹ᵁ U_et)

  have hCovP : (W_U : Set P) ∪ (W_et : Set P) = Set.univ := by
    ext w
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hw : f.base (p_X.base w) ∈ (U : Set Z) ∪ (U_et : Set Z) := by
      rw [hCov]
      trivial
    exact hw

  have hCommBase : ∀ w : ↥P, f.base (p_X.base w) = g.base (p_Y.base w) := by
    intro w
    change (p_X ≫ f).base w = (p_Y ≫ g).base w
    rw [CategoryTheory.Limits.pullback.condition]

  obtain ⟨q_U, _, hPb_U⟩ := hPullRestrict U
  have : CategoryTheory.IsIso (p_X ∣_ (f ⁻¹ᵁ U)) := hPb_U.isIso_fst_of_isIso
  obtain ⟨x₀⟩ := hNonempty
  let w₀ : ↥W_U.toScheme := (CategoryTheory.inv (p_X ∣_ (f ⁻¹ᵁ U))).base x₀
  have : Nonempty ↥W_U.toScheme := ⟨w₀⟩
  have hNonemptyP : Nonempty ↥P := ⟨w₀.1⟩
  have hIntWU : AlgebraicGeometry.IsIntegral W_U.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion ((p_X ∣_ (f ⁻¹ᵁ U)) ≫ (f ⁻¹ᵁ U).ι)
  have hIrredWU : IrreducibleSpace ↥W_U :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral W_U.toScheme hIntWU
  have hRedWU : AlgebraicGeometry.IsReduced (↑W_U : AlgebraicGeometry.Scheme.{u}) :=
    @AlgebraicGeometry.isReduced_of_isIntegral W_U.toScheme hIntWU
  have hNonemptyVY : ((g ⁻¹ᵁ U : Y.Opens) : Set Y).Nonempty := by
    refine ⟨p_Y.base w₀.1, ?_⟩
    change g.base (p_Y.base w₀.1) ∈ U
    rw [← hCommBase w₀.1]
    exact w₀.2

  obtain ⟨q_et, hq_et_ι, hPb_et⟩ := hPullRestrict U_et
  have : AlgebraicGeometry.Etale q_et :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.Etale) hPb_et hEt
  let ψ_et : W_et.toScheme ⟶ Y := q_et ≫ (g ⁻¹ᵁ U_et).ι
  have hEt_ψ : AlgebraicGeometry.Etale ψ_et := inferInstance
  have hRedWet : AlgebraicGeometry.IsReduced (↑W_et : AlgebraicGeometry.Scheme.{u}) :=
    hEtRed W_et.toScheme ψ_et hEt_ψ
  have hOpen_ψ : IsOpenMap (ψ_et.base : ↥W_et → ↥Y) :=
    AlgebraicGeometry.Scheme.Hom.isOpenMap ψ_et

  have hStalkP : ∀ x : ↥P, IsReduced ↑(P.presheaf.stalk x) := by
    intro x
    have hxCov : x ∈ (W_U : Set P) ∪ (W_et : Set P) := by
      rw [hCovP]
      trivial
    rcases hxCov with hxU | hxEt
    · have : IsReduced ↑((↑W_U : AlgebraicGeometry.Scheme.{u}).presheaf.stalk ⟨x, hxU⟩) :=
        @AlgebraicGeometry.isReduced_stalk_of_isReduced (↑W_U : AlgebraicGeometry.Scheme.{u}) hRedWU ⟨x, hxU⟩
      exact isReduced_of_injective
        (AlgebraicGeometry.Scheme.Opens.stalkIso W_U ⟨x, hxU⟩).symm.commRingCatIsoToRingEquiv
        (AlgebraicGeometry.Scheme.Opens.stalkIso W_U ⟨x, hxU⟩).symm.commRingCatIsoToRingEquiv.injective
    · have : IsReduced ↑((↑W_et : AlgebraicGeometry.Scheme.{u}).presheaf.stalk ⟨x, hxEt⟩) :=
        @AlgebraicGeometry.isReduced_stalk_of_isReduced (↑W_et : AlgebraicGeometry.Scheme.{u}) hRedWet ⟨x, hxEt⟩
      exact isReduced_of_injective
        (AlgebraicGeometry.Scheme.Opens.stalkIso W_et ⟨x, hxEt⟩).symm.commRingCatIsoToRingEquiv
        (AlgebraicGeometry.Scheme.Opens.stalkIso W_et ⟨x, hxEt⟩).symm.commRingCatIsoToRingEquiv.injective
  have : AlgebraicGeometry.IsReduced P := @AlgebraicGeometry.isReduced_of_isReduced_stalk P hStalkP

  have hIrredSetWU : IsIrreducible (W_U : Set P) := by
    have hImg := (@IrreducibleSpace.isIrreducible_univ ↥W_U _ hIrredWU).image
      Subtype.val continuous_subtype_val.continuousOn
    rwa [Set.image_univ, Subtype.range_val] at hImg
  have hDenseWU : Dense (W_U : Set P) := by
    rw [dense_iff_inter_open]
    intro O hOpenO ⟨x, hxO⟩
    by_cases hxU : x ∈ W_U
    · exact ⟨x, hxO, hxU⟩
    · have hxCov : x ∈ (W_U : Set P) ∪ (W_et : Set P) := by
        rw [hCovP]
        trivial
      have hxEt : x ∈ W_et := hxCov.resolve_left hxU
      let O₂ : Set ↥W_et := (Subtype.val : ↥W_et → ↥P) ⁻¹' O
      have hOpenO₂ : IsOpen O₂ := hOpenO.preimage continuous_subtype_val
      have hxO₂ : (⟨x, hxEt⟩ : ↥W_et) ∈ O₂ := hxO
      obtain ⟨y, _, ⟨w, hwO₂, rfl⟩, hyVY⟩ :=
        PreirreducibleSpace.isPreirreducible_univ (ψ_et.base '' O₂) (g ⁻¹ᵁ U : Set Y)
          (hOpen_ψ O₂ hOpenO₂) (g ⁻¹ᵁ U).isOpen
          ⟨ψ_et.base ⟨x, hxEt⟩, trivial, ⟨⟨x, hxEt⟩, hxO₂, rfl⟩⟩
          (let ⟨y₀, hy₀⟩ := hNonemptyVY; ⟨y₀, trivial, hy₀⟩)
      have hψw : ψ_et.base w = p_Y.base w.1 := by
        change (q_et ≫ (g ⁻¹ᵁ U_et).ι).base w = p_Y.base w.1
        rw [hq_et_ι]
        change p_Y.base (W_et.ι.base w) = p_Y.base w.1
        exact congrArg p_Y.base (AlgebraicGeometry.Scheme.Opens.ι_apply W_et w)
      have hwU : w.1 ∈ W_U := by
        change f.base (p_X.base w.1) ∈ U
        rw [hCommBase w.1, ← hψw]
        exact hyVY
      exact ⟨w.1, hwO₂, hwU⟩
  have hIrredUniv : IsIrreducible (Set.univ : Set P) := by
    rw [← hDenseWU.closure_eq]
    exact hIrredSetWU.closure
  have : IrreducibleSpace ↥P :=
    @IrreducibleSpace.mk ↥P _ (PreirreducibleSpace.mk hIrredUniv.isPreirreducible) hNonemptyP
  exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P

theorem weil_algClosed_finite_over_projLine_fiber_equidim (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hProjV₁ : IsProjectiveOverField k V₁)
    (hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (P_tilde_left : AlgebraicGeometry.Scheme.{u})
    (q_tilde : V₁.left ⟶ P_tilde_left)
    [AlgebraicGeometry.IsFinite q_tilde]
    (p₂_left : P_tilde_left ⟶ (weilProjectiveSpaceOver k m).left)
    (f₁ : V₁ ⟶ weilProjectiveSpaceOver k m)
    (hf₁ : f₁.left = q_tilde ≫ p₂_left)
    (W_exc : V₁.left.Opens)
    (hSm_exc : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_exc.ι ≫ f₁.left))
    (hFib_p₂ : ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback p₂_left s) ∧
      topologicalKrullDim ↥(CategoryTheory.Limits.pullback p₂_left s) = (1 : WithBot ℕ∞) ∧
      ∃ z₀ : ↥(CategoryTheory.Limits.pullback p₂_left s),
        q_tilde.base ⁻¹' {(CategoryTheory.Limits.pullback.fst p₂_left s).base z₀} ⊆
          (W_exc : Set V₁.left)) :
    ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left),
      ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₁.left s),
        topologicalKrullDim ↥E = (1 : WithBot ℕ∞) ∧
        ∃ (q : ↥(CategoryTheory.Limits.pullback f₁.left s)) (W : V₁.left.Opens),
          q ∈ E ∧
          (CategoryTheory.Limits.pullback.fst f₁.left s).base q ∈ W ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) :=
by
  
  have h_s1 :
      ∀ (X Y : AlgebraicGeometry.Scheme.{u})
        (g : X ⟶ Y) [AlgebraicGeometry.IsFinite g]
        (E : Set X), IsClosed E →
        topologicalKrullDim ↥E ≤ topologicalKrullDim Y ∧
        (IrreducibleSpace Y →
          topologicalKrullDim Y = (1 : WithBot ℕ∞) →
          (1 : WithBot ℕ∞) ≤ topologicalKrullDim ↥E →
          g.base '' E = Set.univ) := by
    clear * -
    intro X Y g _ E hClosedE
    have hPropAff := (AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom (f := g)).mp ‹_›
    have : AlgebraicGeometry.IsProper g := hPropAff.1
    have : AlgebraicGeometry.IsAffineHom g := hPropAff.2
    have hIntFT := (AlgebraicGeometry.IsFinite.iff_isIntegralHom_and_locallyOfFiniteType (f := g)).mp ‹_›
    have : AlgebraicGeometry.IsIntegralHom g := hIntFT.1
    have hClosedMap : IsClosedMap g.base := AlgebraicGeometry.Scheme.Hom.isClosedMap g
    let push : TopologicalSpace.IrreducibleCloseds ↥E → TopologicalSpace.IrreducibleCloseds Y :=
      fun C =>
        ⟨g.base '' ((Subtype.val : ↥E → X) '' (C : Set ↥E)),
         (C.isIrreducible'.image Subtype.val continuous_subtype_val.continuousOn).image
           g.base g.continuous.continuousOn,
         hClosedMap _ (hClosedE.isClosedEmbedding_subtypeVal.isClosedMap _ C.isClosed')⟩
    have hStrict : StrictMono push := by
      intro C₁ C₂ hlt
      have hle : push C₁ ≤ push C₂ := Set.image_mono (Set.image_mono hlt.le)
      refine lt_of_le_not_ge hle (fun hge => ?_)
      let C₁X : Set X := (Subtype.val : ↥E → X) '' (C₁ : Set ↥E)
      let C₂X : Set X := (Subtype.val : ↥E → X) '' (C₂ : Set ↥E)
      have hIrred₁ : IsIrreducible C₁X :=
        C₁.isIrreducible'.image Subtype.val continuous_subtype_val.continuousOn
      have hIrred₂ : IsIrreducible C₂X :=
        C₂.isIrreducible'.image Subtype.val continuous_subtype_val.continuousOn
      have hClosed₁ : IsClosed C₁X :=
        hClosedE.isClosedEmbedding_subtypeVal.isClosedMap _ C₁.isClosed'
      have hClosed₂ : IsClosed C₂X :=
        hClosedE.isClosedEmbedding_subtypeVal.isClosedMap _ C₂.isClosed'
      obtain ⟨x₀E, hx₀E⟩ := C₁.isIrreducible'.nonempty
      have hx₀₁ : x₀E.1 ∈ C₁X := ⟨x₀E, hx₀E, rfl⟩
      have hx₀₂ : x₀E.1 ∈ C₂X := ⟨x₀E, hlt.le hx₀E, rfl⟩
      obtain ⟨U, hAffU, hy₀U, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := g.base x₀E.1) (U := ⊤) trivial
      let V : X.Opens := g ⁻¹ᵁ U
      have hAffV : AlgebraicGeometry.IsAffineOpen V :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage (f := g) U hAffU
      have hx₀V : x₀E.1 ∈ V := hy₀U
      let W₁ : Set ↥V := (Subtype.val : ↥V → X) ⁻¹' C₁X
      let W₂ : Set ↥V := (Subtype.val : ↥V → X) ⁻¹' C₂X
      have hIrredW₁ : IsIrreducible W₁ :=
        ⟨⟨⟨x₀E.1, hx₀V⟩, hx₀₁⟩, hIrred₁.isPreirreducible.preimage V.isOpen.isOpenEmbedding_subtypeVal⟩
      have hIrredW₂ : IsIrreducible W₂ :=
        ⟨⟨⟨x₀E.1, hx₀V⟩, hx₀₂⟩, hIrred₂.isPreirreducible.preimage V.isOpen.isOpenEmbedding_subtypeVal⟩
      have hClosedW₁ : IsClosed W₁ := hClosed₁.preimage continuous_subtype_val
      have hClosedW₂ : IsClosed W₂ := hClosed₂.preimage continuous_subtype_val
      obtain ⟨zE, hzE₂, hzE₁⟩ := Set.not_subset.mp hlt.not_ge
      have hzX₂ : zE.1 ∈ C₂X := ⟨zE, hzE₂, rfl⟩
      have hzX₁ : zE.1 ∉ C₁X := by
        rintro ⟨w, hw, hEq⟩
        exact hzE₁ (Subtype.val_injective hEq ▸ hw)
      obtain ⟨w, hw₂, hw₁, hwV⟩ :=
        hIrred₂.isPreirreducible C₁Xᶜ (V : Set X) hClosed₁.isOpen_compl V.isOpen
          ⟨zE.1, hzX₂, hzX₁⟩ ⟨x₀E.1, hx₀₂, hx₀V⟩
      let RX : Type u := ↑(X.presheaf.obj (Opposite.op V))
      let RY : Type u := ↑(Y.presheaf.obj (Opposite.op U))
      let eU := AlgebraicGeometry.Scheme.homeoOfIso hAffU.isoSpec
      let eV := AlgebraicGeometry.Scheme.homeoOfIso hAffV.isoSpec
      let D₁ : Set (PrimeSpectrum RX) := eV '' W₁
      let D₂ : Set (PrimeSpectrum RX) := eV '' W₂
      have hIrredD₁ : IsIrreducible D₁ := hIrredW₁.image eV eV.continuous.continuousOn
      have hIrredD₂ : IsIrreducible D₂ := hIrredW₂.image eV eV.continuous.continuousOn
      have hClosedD₁ : IsClosed D₁ := eV.isClosedMap _ hClosedW₁
      have hClosedD₂ : IsClosed D₂ := eV.isClosedMap _ hClosedW₂
      let I₁ : Ideal RX := PrimeSpectrum.vanishingIdeal D₁
      let I₂ : Ideal RX := PrimeSpectrum.vanishingIdeal D₂
      have hP₁ : I₁.IsPrime := (PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime).mp hIrredD₁
      have hP₂ : I₂.IsPrime := (PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime).mp hIrredD₂
      have hZL₁ : PrimeSpectrum.zeroLocus (I₁ : Set RX) = D₁ :=
        (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure D₁).trans hClosedD₁.closure_eq
      have hZL₂ : PrimeSpectrum.zeroLocus (I₂ : Set RX) = D₂ :=
        (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure D₂).trans hClosedD₂.closure_eq
      have hD_sub : D₁ ⊆ D₂ := Set.image_mono (Set.preimage_mono (Set.image_mono hlt.le))
      have hI_le : I₂ ≤ I₁ := PrimeSpectrum.vanishingIdeal_anti_mono hD_sub
      let q₂ : PrimeSpectrum RX := ⟨I₂, hP₂⟩
      have hq₂_D₂ : q₂ ∈ D₂ := by
        rw [← hZL₂, PrimeSpectrum.mem_zeroLocus]
      have hq₂_not_D₁ : q₂ ∉ D₁ := by
        intro hq₂
        have hI₁_le : I₁ ≤ I₂ := by
