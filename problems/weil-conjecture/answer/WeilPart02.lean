    let R_a := ↑((AlgebraicGeometry.Spec (CommRingCat.of L)).presheaf.obj
      (Opposite.op (ξ_L ⁻¹ᵁ U_a.1)))
    let _ : Algebra A_a R_a := (ξ_L.app U_a.1).hom.toAlgebra
    let j_Ua := (ξ_L.normalizationOpenCover).f U_a
    have _ : AlgebraicGeometry.IsOpenImmersion j_Ua :=
      (ξ_L.normalizationOpenCover).map_prop U_a
    have h_iota_pt :
        τ_L.base pt_L =
          j_Ua.base ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (integralClosure A_a R_a).val.toRingHom)).base
              ((ξ_L ⁻¹ᵁ U_a.1).toSpecΓ.base pt'_L)) := by
      have h_eq := AlgebraicGeometry.Scheme.Hom.ι_toNormalization ξ_L U_a
      exact congrArg (fun f => f.base pt'_L) h_eq
    let p_Ra : PrimeSpectrum R_a := (ξ_L ⁻¹ᵁ U_a.1).toSpecΓ.base pt'_L
    have hp_Ra_bot : p_Ra.asIdeal = ⊥ := by
      by_contra hne
      obtain ⟨r, hr, hr_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      have he_ne : e_Ra r ≠ 0 := fun h0 => hr_ne (e_Ra.injective (h0.trans (map_zero e_Ra).symm))
      have h_unit : IsUnit r := by
        refine ⟨⟨r, e_Ra.symm (e_Ra r)⁻¹, ?_, ?_⟩, rfl⟩
        · apply e_Ra.injective; simp [he_ne]
        · apply e_Ra.injective; simp [he_ne]
      exact p_Ra.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hr h_unit)
    let p_Ca : PrimeSpectrum ↥(integralClosure A_a R_a) :=
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (integralClosure A_a R_a).val.toRingHom)).base p_Ra
    have hp_Ca_bot : p_Ca.asIdeal = ⊥ := by
      change Ideal.comap (integralClosure A_a R_a).val.toRingHom p_Ra.asIdeal = ⊥
      rw [hp_Ra_bot]
      ext ⟨c, hc⟩
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      exact ⟨fun h0 => Subtype.ext h0, fun h0 => congrArg Subtype.val h0⟩
    have _ : IrreducibleSpace ↥B₂.left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral B₂.left hIntB₂
    have h_pre : IsPreirreducible (Set.univ : Set ↥B₂.left) :=
      PreirreducibleSpace.isPreirreducible_univ
    have hRange_open : IsOpen (Set.range j_Ua.base : Set ↥B₂.left) :=
      (j_Ua.opensRange : (ξ_L.normalization).Opens).isOpen
    obtain ⟨y, _, hyO, ⟨q_Ca, rfl⟩⟩ :=
      h_pre O (Set.range j_Ua.base) hO hRange_open
        ⟨hO_ne.some, trivial, hO_ne.some_mem⟩
        ⟨j_Ua.base p_Ca, trivial, ⟨p_Ca, rfl⟩⟩
    have hyO' : (q_Ca : PrimeSpectrum ↥(integralClosure A_a R_a)) ∈
        (j_Ua.base ⁻¹' O : Set (PrimeSpectrum ↥(integralClosure A_a R_a))) := hyO
    have hO_pre' : IsOpen (j_Ua.base ⁻¹' O : Set (PrimeSpectrum ↥(integralClosure A_a R_a))) :=
      hO.preimage j_Ua.continuous
    obtain ⟨_, ⟨g, rfl⟩, hqg, hg_sub⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hyO' hO_pre'
    have hg_ne : g ≠ 0 := fun h0 => hqg (h0 ▸ q_Ca.asIdeal.zero_mem)
    have hp_g : p_Ca ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum ↥(integralClosure A_a R_a))) := by
      change g ∉ p_Ca.asIdeal
      rw [hp_Ca_bot, Ideal.mem_bot]
      exact hg_ne
    have hp_mem_pre : p_Ca ∈ j_Ua.base ⁻¹' O := hg_sub hp_g
    refine ⟨τ_L.base pt_L, ?_, ⟨pt_L, rfl⟩⟩
    rw [h_iota_pt]
    exact hp_mem_pre
  have hAltψ₀ : IsGenFiniteEtaleAlterationOver k ψ₀ := by
    have _ : AlgebraicGeometry.IsFinite ψ₀.left := hFinψ₀
    have hProp : AlgebraicGeometry.IsProper ψ₀.left := inferInstance
    have hSurj : AlgebraicGeometry.Surjective ψ₀.left := by
      constructor
      intro y
      have h_cl : IsClosed (Set.range ψ₀.left.base) := ψ₀.left.isClosedMap.isClosed_range
      have h_gen_mem : genericPoint ↥B₀.left ∈ Set.range ψ₀.left.base := by
        refine ⟨τ_L.base pt_L, ?_⟩
        calc ψ₀.left.base (τ_L.base pt_L)
          _ = (τ_L ≫ ψ₀.left).base pt_L := rfl
          _ = ξ_L.base pt_L := by rw [hτ_comp]
          _ = genericPoint ↥B₀.left := hξ_pt
      exact (genericPoint_specializes y).mem_closed h_cl h_gen_mem
    refine ⟨hProp, hSurj, ?_⟩
    let A_a := ↑(B₀.left.presheaf.obj (Opposite.op U_a.1))
    let R_a := ↑((AlgebraicGeometry.Spec (CommRingCat.of L)).presheaf.obj
      (Opposite.op (ξ_L ⁻¹ᵁ U_a.1)))
    let _ : Algebra A_a R_a := (ξ_L.app U_a.1).hom.toAlgebra
    let C_a := ↥(integralClosure A_a R_a)
    let i_locA : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away a₀)) ⟶
        AlgebraicGeometry.Spec (B₀.left.presheaf.obj (Opposite.op U_a.1)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_a (Localization.Away a₀)))
    let i_locC : AlgebraicGeometry.Spec (CommRingCat.of
          (Localization.Away ((algebraMap A_a C_a) a₀))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of C_a) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap C_a (Localization.Away ((algebraMap A_a C_a) a₀))))
    let g_loc : AlgebraicGeometry.Spec (CommRingCat.of
          (Localization.Away ((algebraMap A_a C_a) a₀))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away a₀)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Localization.awayMap (algebraMap A_a C_a) a₀))
    have _ : AlgebraicGeometry.IsOpenImmersion i_locA :=
      @AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway
        (B₀.left.presheaf.obj (Opposite.op U_a.1)) a₀
    have _ : AlgebraicGeometry.IsOpenImmersion i_locC :=
      @AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway
        (CommRingCat.of C_a) ((algebraMap A_a C_a) a₀)
    have _ : AlgebraicGeometry.IsOpenImmersion U_a.2.fromSpec := by
      change AlgebraicGeometry.IsOpenImmersion hV₀_aff.fromSpec
      infer_instance
    have _ : AlgebraicGeometry.IsOpenImmersion ((ξ_L.normalizationOpenCover).f U_a) :=
      (ξ_L.normalizationOpenCover).map_prop U_a
    have h_pb1 : CategoryTheory.IsPullback g_loc i_locC i_locA
        (AlgebraicGeometry.Spec.map (ξ_L.normalizationDiagramMap.app (Opposite.op U_a.1))) := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback
      · change i_locC ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_a C_a)) =
          g_loc ≫ i_locA
        dsimp only [i_locC, g_loc, i_locA]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        refine congrArg (fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom r))
          (RingHom.ext fun x => ?_)
        dsimp only [RingHom.coe_comp, Function.comp_apply,
          Localization.awayMap, IsLocalization.Away.map]
        exact (IsLocalization.map_eq _ x).symm
      · ext q
        change q ∈ ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A_a C_a))).base ⁻¹'
              Set.range i_locA.base) ↔
          q ∈ Set.range i_locC.base
        have h_rA : Set.range i_locA.base = (PrimeSpectrum.basicOpen a₀ : Set (PrimeSpectrum A_a)) :=
          PrimeSpectrum.localization_away_comap_range (Localization.Away a₀) a₀
        have h_rC : Set.range i_locC.base =
            (PrimeSpectrum.basicOpen ((algebraMap A_a C_a) a₀) : Set (PrimeSpectrum C_a)) :=
          PrimeSpectrum.localization_away_comap_range
            (Localization.Away ((algebraMap A_a C_a) a₀)) ((algebraMap A_a C_a) a₀)
        rw [Set.mem_preimage, h_rA, h_rC]
        change a₀ ∉ ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A_a C_a))).base q).asIdeal ↔
          (algebraMap A_a C_a) a₀ ∉ q.asIdeal
        rfl
    have h_pb2 : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (ξ_L.normalizationDiagramMap.app (Opposite.op U_a.1)))
        ((ξ_L.normalizationOpenCover).f U_a) U_a.2.fromSpec ψ₀.left := by
      refine @AlgebraicGeometry.IsOpenImmersion.isPullback _ _ _ _
        (AlgebraicGeometry.Spec.map (ξ_L.normalizationDiagramMap.app (Opposite.op U_a.1)))
        ((ξ_L.normalizationOpenCover).f U_a) U_a.2.fromSpec ξ_L.fromNormalization
        ((ξ_L.normalizationOpenCover).map_prop U_a) inferInstance ?_ ?_
      · exact AlgebraicGeometry.Scheme.Hom.ι_fromNormalization ξ_L U_a
      · rw [U_a.2.opensRange_fromSpec]
        exact AlgebraicGeometry.Scheme.Hom.fromNormalization_preimage ξ_L U_a
    have h_pb_outer : CategoryTheory.IsPullback g_loc
        (i_locC ≫ (ξ_L.normalizationOpenCover).f U_a)
        (i_locA ≫ U_a.2.fromSpec) ψ₀.left :=
      h_pb1.paste_vert h_pb2
    let h_bot := i_locA ≫ U_a.2.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion h_bot :=
      CategoryTheory.MorphismProperty.comp_mem @AlgebraicGeometry.IsOpenImmersion _ _
        inferInstance inferInstance
    let U_et : B₀.left.Opens := h_bot.opensRange
    have hU_et_ne : Nonempty U_et := by
      have _ : Nonempty ↥(U_a.1 : B₀.left.Opens) := hU_a
      have _ : Nonempty ↥(U_a.1.toScheme) := hU_a
      have _ : IsDomain A_a :=
        inferInstanceAs (IsDomain ↑(B₀.left.presheaf.obj (Opposite.op U_a.1)))
      let _ : Algebra A_a K₀ := (B₀.left.germToFunctionField U_a.1).hom.toAlgebra
      have _ : IsFractionRing A_a K₀ :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen B₀.left U_a.1 U_a.2
      have ha₀_K₀ : IsUnit (algebraMap A_a K₀ a₀) :=
        isUnit_iff_ne_zero.mpr (fun h0 => ha₀_ne ((IsFractionRing.injective A_a K₀)
          (h0.trans (map_zero (algebraMap A_a K₀)).symm)))
      let φ_loc_K₀ : Localization.Away a₀ →+* K₀ := IsLocalization.Away.lift a₀ ha₀_K₀
      let q₀ : PrimeSpectrum (Localization.Away a₀) :=
        PrimeSpectrum.comap φ_loc_K₀ (IsLocalRing.closedPoint K₀)
      exact ⟨⟨h_bot.base q₀, ⟨q₀, rfl⟩⟩⟩
    have h_pb_res : CategoryTheory.IsPullback (ψ₀.left ∣_ U_et) (ψ₀.left ⁻¹ᵁ U_et).ι
        U_et.ι ψ₀.left :=
      AlgebraicGeometry.isPullback_morphismRestrict ψ₀.left U_et
    have hFin_et : AlgebraicGeometry.IsFinite (ψ₀.left ∣_ U_et) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        h_pb_res.flip hFinψ₀
    have hSurj_et : AlgebraicGeometry.Surjective (ψ₀.left ∣_ U_et) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        h_pb_res.flip hSurj
    have hEt_et : AlgebraicGeometry.Etale (ψ₀.left ∣_ U_et) := by
      have hEt_gloc : AlgebraicGeometry.Etale g_loc :=
        (@AlgebraicGeometry.HasRingHomProperty.Spec_iff @AlgebraicGeometry.Etale _ _ _ _
          (CommRingCat.ofHom (Localization.awayMap (algebraMap A_a C_a) a₀))).mpr hEt_Ra
      let iso_bot := h_bot.isoOpensRange
      have h_bot_fac : iso_bot.inv ≫ h_bot = U_et.ι :=
        (congrArg (iso_bot.inv ≫ ·) h_bot.isoOpensRange_hom_ι.symm).trans
          (Iso.inv_hom_id_assoc iso_bot U_et.ι)
      let top_lift :=
        h_pb_outer.lift ((ψ₀.left ∣_ U_et) ≫ iso_bot.inv) ((ψ₀.left ⁻¹ᵁ U_et).ι) (by
          rw [Category.assoc, h_bot_fac, h_pb_res.w])
      have h_pb_top : CategoryTheory.IsPullback (ψ₀.left ∣_ U_et) top_lift
          iso_bot.inv g_loc := by
        refine CategoryTheory.IsPullback.of_bot ?_ ?_ h_pb_outer
        · rw [CategoryTheory.IsPullback.lift_snd, h_bot_fac]
          exact h_pb_res
        · exact (CategoryTheory.IsPullback.lift_fst _ _ _ _).symm
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        h_pb_top.flip hEt_gloc
    exact ⟨U_et, hU_et_ne, hFin_et, hEt_et, hSurj_et⟩
  refine ⟨B₂, ψ₀, hIntB₂, hFinψ₀, hAltψ₀, fun ℓ => ?_⟩
  obtain ⟨k_D, z, hz, hz_cov⟩ := hGenSplit ℓ
  have _ : AlgebraicGeometry.IsIntegral B₂.left := hIntB₂
  have _ : AlgebraicGeometry.IsFinite (p ℓ) := hFinD ℓ
  have _ : AlgebraicGeometry.Etale ((p ℓ) ∣_ (W ℓ)) := hEtD ℓ
  let g : Fin k_D → (B₂.left ⟶ D ℓ) := fun j =>
    ξ_L.normalizationDesc (z j) (p ℓ) (hz j).symm
  have hg_p : ∀ j : Fin k_D, g j ≫ p ℓ = ψ₀.left := fun j =>
    ξ_L.normalizationDesc_comp (z j) (p ℓ) (hz j).symm
  have hg_z : ∀ j : Fin k_D, τ_L ≫ g j = z j := fun j =>
    ξ_L.toNormalization_normalizationDesc (z j) (p ℓ) (hz j).symm
  exact weil_pullback_section_cover_of_generic_lifts
    (p ℓ) ψ₀.left (W ℓ) L ξ_L τ_L hτ_comp hDenseτ k_D z hz hz_cov g hg_p hg_z

theorem weil_smooth_one_connected_over_field_isIntegral (K : Type u) [Field K]
    (Y : AlgebraicGeometry.Scheme.{u})
    (g : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    [AlgebraicGeometry.IsProper g]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 g]
    (hConn : ConnectedSpace ↥Y) :
    AlgebraicGeometry.IsIntegral Y :=
by
  
  have h_irred_of_nhds : ∀ (T : Type u) [TopologicalSpace T] [ConnectedSpace T],
      (∀ x : T, ∃ U : Set T, IsOpen U ∧ x ∈ U ∧ IsPreirreducible U) →
      IrreducibleSpace T := by
    intro T _ _ hNhds
    have h_union : ∀ {A B : Set T}, IsPreirreducible A → IsPreirreducible B →
        IsOpen B → (A ∩ B).Nonempty → IsPreirreducible (A ∪ B) := by
      intro A B hA hB hOpenB hAB V₁ V₂ hV₁ hV₂ h₁ h₂
      have hBV₁ : (B ∩ V₁).Nonempty := by
        obtain ⟨z₁, hz₁AB, hz₁V₁⟩ := h₁
        rcases hz₁AB with hz₁A | hz₁B
        · obtain ⟨w₁, _, hw₁BV₁⟩ := hA B V₁ hOpenB hV₁ hAB ⟨z₁, hz₁A, hz₁V₁⟩
          exact ⟨w₁, hw₁BV₁⟩
        · exact ⟨z₁, hz₁B, hz₁V₁⟩
      have hBV₂ : (B ∩ V₂).Nonempty := by
        obtain ⟨z₂, hz₂AB, hz₂V₂⟩ := h₂
        rcases hz₂AB with hz₂A | hz₂B
        · obtain ⟨w₂, _, hw₂BV₂⟩ := hA B V₂ hOpenB hV₂ hAB ⟨z₂, hz₂A, hz₂V₂⟩
          exact ⟨w₂, hw₂BV₂⟩
        · exact ⟨z₂, hz₂B, hz₂V₂⟩
      obtain ⟨w, hwB, hwV⟩ := hB V₁ V₂ hV₁ hV₂ hBV₁ hBV₂
      exact ⟨w, Or.inr hwB, hwV⟩
    obtain ⟨x₀⟩ : Nonempty T := ConnectedSpace.toNonempty
    let E : Set T := irreducibleComponent x₀
    have hClosedE : IsClosed E := isClosed_irreducibleComponent
    have hIrredE : IsIrreducible E := isIrreducible_irreducibleComponent
    have hOpenE : IsOpen E := by
      rw [isOpen_iff_forall_mem_open]
      intro x hxE
      obtain ⟨U, hOpenU, hxU, hPreU⟩ := hNhds x
      have hPreEU : IsPreirreducible (E ∪ U) :=
        h_union hIrredE.isPreirreducible hPreU hOpenU ⟨x, hxE, hxU⟩
      have hEU_eq : E ∪ U = E :=
        (irreducibleComponent_property x₀).2.2 (E ∪ U) hPreEU Set.subset_union_left
      exact ⟨U, Set.subset_union_right.trans_eq hEU_eq, hOpenU, hxU⟩
    have hClopenE : IsClopen E := ⟨by assumption, by assumption⟩
    have hE_univ : E = Set.univ := hClopenE.eq_univ ⟨x₀, mem_irreducibleComponent⟩
    have hPreUniv : PreirreducibleSpace T := ⟨hE_univ ▸ hIrredE.isPreirreducible⟩
    exact @IrreducibleSpace.mk T _ hPreUniv ⟨x₀⟩

  
  have h_local_etale_field : ∀ (F : Type u) [Field F] (A : Type u) [CommRing A]
      [IsLocalRing A] [Algebra F A] [Algebra.FormallyEtale F A] [Algebra.EssFiniteType F A],
      IsField A := by
    intro F _ A _ _ _ _ _
    obtain ⟨I, _, Ai, hFieldAi, hAlgAi, φ, _⟩ :=
      (Algebra.FormallyEtale.iff_exists_algEquiv_prod F A).mp inferInstance
    letI : ∀ i : I, Field (Ai i) := hFieldAi
    letI : ∀ i : I, Algebra F (Ai i) := hAlgAi
    have hNonemptyI : Nonempty I := by
      by_contra hEmpty
      rw [not_nonempty_iff] at hEmpty
      have : Subsingleton ((i : I) → Ai i) := inferInstance
      have : Subsingleton A := φ.toEquiv.subsingleton
      exact false_of_nontrivial_of_subsingleton A
    obtain ⟨i₀⟩ := hNonemptyI
    have hUnique : ∀ j : I, j = i₀ := by
      intro j
      by_contra hj
      classical
      let e : (i : I) → Ai i := fun i => if i = i₀ then 1 else 0
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (φ.symm e) with hu | hu1
      · have hu_j : IsUnit (e j) := by
          have h1 : IsUnit (φ (φ.symm e)) := hu.map φ.toRingHom
          rw [φ.apply_symm_apply] at h1
          exact h1.map (Pi.evalRingHom Ai j)
        have hej : e j = 0 := by simp [e, hj]
        rw [hej] at hu_j
        exact not_isUnit_zero hu_j
      · have hu_i0 : IsUnit ((1 - e) i₀) := by
          have h1 : IsUnit (φ (1 - φ.symm e)) := hu1.map φ.toRingHom
          rw [map_sub, map_one, φ.apply_symm_apply] at h1
          exact h1.map (Pi.evalRingHom Ai i₀)
        have hei0 : (1 - e) i₀ = 0 := by simp [e]
        rw [hei0] at hu_i0
        exact not_isUnit_zero hu_i0
    let : Unique I := ⟨⟨i₀⟩, hUnique⟩
    let e_ring : A ≃+* Ai default := φ.toRingEquiv.trans (RingEquiv.piUnique Ai)
    exact MulEquiv.isField (Field.toIsField (Ai default)) e_ring.toMulEquiv

  
  have h_etale_poly_dom : ∀ (C : Type u) [CommRing C] (h : Polynomial K →+* C),
      h.Etale → ∀ (q : Ideal C) [q.IsPrime], IsDomain (Localization.AtPrime q) := by
    intro C _ h hh q _
    letI : Algebra (Polynomial K) C := h.toAlgebra
    haveI : Algebra.Etale (Polynomial K) C := RingHom.etale_algebraMap.mp hh
    haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing (Polynomial K) C
    haveI : Module.Flat (Polynomial K) (Localization.AtPrime q) :=
      Module.Flat.trans (Polynomial K) C (Localization.AtPrime q)
    have h_amap : ∀ p : Polynomial K,
        algebraMap (Polynomial K) (Localization.AtPrime q) p =
          algebraMap C (Localization.AtPrime q) (h p) :=
      fun p => IsScalarTower.algebraMap_apply (Polynomial K) C (Localization.AtPrime q) p
    let p₀ : Ideal (Polynomial K) := Ideal.comap h q
    have hp₀ : p₀.IsPrime := Ideal.IsPrime.comap h
    have h_mem_max : ∀ p : Polynomial K,
        algebraMap (Polynomial K) (Localization.AtPrime q) p ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime q) ↔ p ∈ p₀ := by
      intro p
      rw [h_amap p]
      exact IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q (h p)
    by_cases hp₀_bot : p₀ = ⊥
    · 
      have : Algebra.Etale (FractionRing (Polynomial K))
          (TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C) :=
        Algebra.Etale.baseChange (Polynomial K) C (FractionRing (Polynomial K))
      have h_unit : ∀ m : nonZeroDivisors (Polynomial K),
          IsUnit (algebraMap (Polynomial K) (Localization.AtPrime q) m) := by
        intro m
        have hm_ne : (m : Polynomial K) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp m.2
        have hm_not_p₀ : (m : Polynomial K) ∉ p₀ := by
          rw [hp₀_bot, Ideal.mem_bot]
          exact hm_ne
        exact IsLocalRing.notMem_maximalIdeal.mp ((h_mem_max m).not.mpr hm_not_p₀)
      let ψ_F : FractionRing (Polynomial K) →+* Localization.AtPrime q :=
        IsLocalization.lift h_unit
      letI : Algebra (FractionRing (Polynomial K)) (Localization.AtPrime q) := ψ_F.toAlgebra
      haveI : IsScalarTower (Polynomial K) (FractionRing (Polynomial K)) (Localization.AtPrime q) := by
        refine ⟨fun p x y => ?_⟩
        change ψ_F (p • x) * y = p • (ψ_F x * y)
        rw [Algebra.smul_def p x, map_mul, IsLocalization.lift_eq h_unit p, mul_assoc,
          ← Algebra.smul_def p (ψ_F x * y)]
      let θ₀ : TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C →ₐ[Polynomial K]
          Localization.AtPrime q :=
        Algebra.TensorProduct.lift
          (IsScalarTower.toAlgHom (Polynomial K) (FractionRing (Polynomial K)) (Localization.AtPrime q))
          (IsScalarTower.toAlgHom (Polynomial K) C (Localization.AtPrime q))
