        have hΦq_ne : Φ_K q.1 ≠ 0 := fun h0 => hq0 (hInjΦ (h0.trans (map_zero _).symm))
        calc w = ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] (1 : FractionRing R)) * w := (one_mul w).symm
          _ = ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] ((Φ_K q.1)⁻¹ * Φ_K q.1)) * w := by
              rw [inv_mul_cancel₀ hΦq_ne]
          _ = (((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] (Φ_K q.1)⁻¹) *
                ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q.1)) * w := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
          _ = ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] (Φ_K q.1)⁻¹) *
                (((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q.1) * w) := mul_assoc _ _ _
          _ = 0 := by rw [hqx, mul_zero]
      exact Function.Injective.isDomain ϒ hInj_ϒ

    · 
      intro hDimC hDimD₀ q
      let lam_gen : TensorProduct (MvPolynomial (Fin m) k) C R →+*
          TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R) :=
        (Algebra.TensorProduct.map (AlgHom.id (MvPolynomial (Fin m) k) C)
          (IsScalarTower.toAlgHom (MvPolynomial (Fin m) k) R (FractionRing R))).toRingHom
      
      let ι_RD : R →+* TensorProduct (MvPolynomial (Fin m) k) C R :=
        (Algebra.TensorProduct.includeRight :
          R →ₐ[MvPolynomial (Fin m) k] TensorProduct (MvPolynomial (Fin m) k) C R).toRingHom
      let M_R : Submonoid (TensorProduct (MvPolynomial (Fin m) k) C R) :=
        (nonZeroDivisors R).map ι_RD
      have hMR_units : ∀ y : M_R, IsUnit (lam_gen y) := by
        rintro ⟨_, r, hr, rfl⟩
        have hunit : IsUnit (algebraMap R (FractionRing R) r) :=
          IsLocalization.map_units (FractionRing R) ⟨r, hr⟩
        have heq : lam_gen (ι_RD r) =
            (Algebra.TensorProduct.includeRight :
              FractionRing R →ₐ[MvPolynomial (Fin m) k]
                TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R)).toRingHom
