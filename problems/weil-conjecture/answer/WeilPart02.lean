          exact h0
        exact (congrArg m_S.toCotangent hsub0).trans (map_zero _)
      let g_JP : Fin c → ↥J_P := fun i => ⟨(g i).1, hI_le_JP (g i).2⟩
      let N_ideal : Ideal P := Ideal.span (Set.range (fun i : Fin c => (g i).1) ∪ {u₀.1})
