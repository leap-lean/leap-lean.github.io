          (_ : ∀ i, Field (E i)) (_ : ∀ i, Algebra K₀ (E i))
          (_ : A₀ ℓ ≃ₐ[K₀] ((i : I) → E i)),
          ∀ i : I, Module.Finite K₀ (E i) ∧ Algebra.IsSeparable K₀ (E i) := by
