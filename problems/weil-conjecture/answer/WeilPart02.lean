          (Fin.snoc (α := fun _ => Fin (s + ν + d)) (Fin.castAdd d) (Fin.natAdd (s + ν) γ₀) b)
          (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + ν + d)) k)
            (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + ν + d)) k) q f_lift)
            f_new_lift a)))
    have hκ : V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp MvPolynomial.C)) =
        V.ι ≫ X.hom := by
      have hcomp : CommRingCat.ofHom (φ.comp MvPolynomial.C) =
          CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom φ := rfl
      rw [hcomp, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
      simpa only [CategoryTheory.Category.assoc] using hSpec
    obtain ⟨hAffV', hxV', hV'α, hSpec'_pkg, hψ_res'⟩ :=
      (hMod2 α₀).2 V hAffV hVα x hxV J hJ_notMem (φ.comp MvPolynomial.C) hκ
    let V' : X.left.Opens := X.left.basicOpen J
