          (AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X μ) (MvPolynomial.X ν)).symm.le).op).hom
    have hΦ_L : ∀ (μ ν : Fin (M₀ + 1)) (t : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ)),
