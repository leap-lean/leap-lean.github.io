    rwa [← h_π_hc, h_der_hc] at h_span_c
  choose G_tan hG_tan_ne hG_tan_span using hTanPolys
  let G_tot : MvPolynomial (weilDegMonomialIdx M₀ d₀) k :=
    G_qf * (∏ γ : Fin G, G_tan γ) * (∏ v : ↥hSingFin.toFinset, E_sing v)
  have hG_tot_ne : G_tot ≠ 0 := by
    refine mul_ne_zero (mul_ne_zero hG_qf ?_) ?_
    · exact Finset.prod_ne_zero_iff.mpr fun γ _ => hG_tan_ne γ
    · exact Finset.prod_ne_zero_iff.mpr fun v _ => hE_sing_ne v
  have h_exists_c : ∃ c : weilDegMonomialIdx M₀ d₀ → k, MvPolynomial.eval c G_tot ≠ 0 := by
    by_contra h_all
    apply hG_tot_ne
    rw [MvPolynomial.funext_iff]
    intro c
    have hc0 : MvPolynomial.eval c G_tot = 0 := not_not.mp (not_exists.mp h_all c)
    simpa only [map_zero] using hc0
  obtain ⟨c, hc_tot⟩ := h_exists_c
  have hc_qf_tan : MvPolynomial.eval c G_qf *
      MvPolynomial.eval c (∏ γ : Fin G, G_tan γ) ≠ 0 := by
    intro h0
    apply hc_tot
    simp only [G_tot, map_mul, h0, zero_mul]
  have hc_qf : MvPolynomial.eval c G_qf ≠ 0 := left_ne_zero_of_mul hc_qf_tan
  have hc_tan_prod : MvPolynomial.eval c (∏ γ : Fin G, G_tan γ) ≠ 0 :=
    right_ne_zero_of_mul hc_qf_tan
  have hc_sing_prod : MvPolynomial.eval c (∏ v : ↥hSingFin.toFinset, E_sing v) ≠ 0 := by
    intro h0
    apply hc_tot
