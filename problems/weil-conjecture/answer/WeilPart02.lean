      rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom, ← CategoryTheory.Category.assoc (V_et_chart γ).toSpecΓ,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE p (U_B_chart γ) (V_et_chart γ) (e_p γ),
        CategoryTheory.Category.assoc, ← AlgebraicGeometry.IsAffineOpen.isoSpec_hom (hUB_aff γ),
        CategoryTheory.Iso.hom_inv_id_assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    rw [h_eq]
    infer_instance
  let V_et : H.Opens := ⨆ γ : Fin G, V_et_chart γ
  have h_fib_y : ∀ z : H, p.base z = y → z ∈ V_et := by
    intro z hpz
    let v : V₁.left := ιH.base z
    have hv_y : f₁.left.base v = y := hpz
    have hv_sm : ∃ W_sm : V₁.left.Opens,
