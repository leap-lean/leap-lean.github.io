        IsLocalization.lift_eq hR_units_loc
      let g_C_alg : C →ₐ[MvPolynomial (Fin m) k] Localization M_R :=
        (IsScalarTower.toAlgHom (MvPolynomial (Fin m) k)
          (TensorProduct (MvPolynomial (Fin m) k) C R) (Localization M_R)).comp
          Algebra.TensorProduct.includeLeft
      let g_frac_alg : FractionRing R →ₐ[MvPolynomial (Fin m) k] Localization M_R :=
        { g_frac with
