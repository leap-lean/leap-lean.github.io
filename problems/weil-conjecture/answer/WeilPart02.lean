        der_T (μ_chart γ) x_bar hx_bar_μ h_span_T
    refine ⟨G_tan, hG_tan_ne, fun c hc => ?_⟩
    have h_span_c := hG_tan c hc
    let h_c : S_chart γ := ∑ e : weilDegMonomialIdx M₀ d₀,
      k_SV γ (c e) *
        ∏ ν : Fin (M₀ + 1),
          ((V₁.left.presheaf.map (CategoryTheory.homOfLE (hV_le_Wproj γ)).op).hom
            (x_proj (μ_chart γ) ν)) ^ (e.1 ν : ℕ)
    have h_π_hc : π_γ h_c = ∑ e : weilDegMonomialIdx M₀ d₀,
        algebraMap k T_γ (c e) * ∏ ν : Fin (M₀ + 1), (x_bar ν) ^ (e.1 ν : ℕ) := by
      simp only [h_c, map_sum, map_mul, map_prod, map_pow, x_bar]
