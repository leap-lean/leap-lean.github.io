          e_mv (MvPolynomial.X j) = (1 : K) ⊗ₜ[k] MvPolynomial.X j := by
        intro j
        apply (MvPolynomial.algebraTensorAlgEquiv k K).injective
        change (MvPolynomial.algebraTensorAlgEquiv k K)
          ((MvPolynomial.algebraTensorAlgEquiv k K).symm _) = _
        rw [AlgEquiv.apply_symm_apply, MvPolynomial.algebraTensorAlgEquiv_tmul,
