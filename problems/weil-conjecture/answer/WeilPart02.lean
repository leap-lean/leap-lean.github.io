import WeilPart01
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_zeta_powerSeries_integrality (F : Type u) [Finite F] [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper X.hom] :
    (∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
      1 ≤ Module.finrank F E ∧
      Nat.card (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap F E))) ⟶ X) =
        weilPointCount F X (Module.finrank F E)) ∧
    (∃ Z : PowerSeries ℤ,
      PowerSeries.constantCoeff Z = 1 ∧
      PowerSeries.X * PowerSeries.derivative Z = Z * weilLogDerivSeries F X) :=
by
  
  have h_part1 : ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
      1 ≤ Module.finrank F E ∧
      Nat.card (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap F E))) ⟶ X) =
        weilPointCount F X (Module.finrank F E) := by
    intro E _ _ _
    have hpos : 1 ≤ Module.finrank F E := Module.finrank_pos
    refine ⟨hpos, ?_⟩
    set n := Module.finrank F E
    have : Finite E := Module.finite_of_finite F
    let _ : Fintype E := Fintype.ofFinite E
    have hcard : Fintype.card E = Nat.card F ^ n := by
      rw [← Nat.card_eq_fintype_card, Module.natCard_eq_pow_finrank (K := F)]
    have hSplit : Polynomial.IsSplittingField F E
        (Polynomial.X ^ (Nat.card F ^ n) - Polynomial.X) := by
      rw [← hcard]
      exact FiniteField.isSplittingField_sub E F
    have h_equiv : Nonempty (E ≃ₐ[F] weilExtField F n) :=
      ⟨@Polynomial.IsSplittingField.algEquiv F E _ _ _
        (Polynomial.X ^ (Nat.card F ^ n) - Polynomial.X) hSplit⟩
    obtain ⟨σ⟩ := h_equiv
    let e : (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap F E))) ⟶ X) ≃
        (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap F (weilExtField F n)))) ⟶ X) :=
      { toFun := fun g => CategoryTheory.Over.homMk
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ g.left) (by
            have hg : g.left ≫ X.hom =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E)) :=
              CategoryTheory.Over.w g
            change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ g.left) ≫
                X.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (weilExtField F n)))
            rw [Category.assoc, hg, ← AlgebraicGeometry.Spec.map_comp]
            congr 1
            ext r
            exact σ.commutes r)
        invFun := fun h => CategoryTheory.Over.homMk
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫ h.left) (by
            have hh : h.left ≫ X.hom =
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap F (weilExtField F n))) :=
              CategoryTheory.Over.w h
            change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫ h.left) ≫
                X.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E))
            rw [Category.assoc, hh, ← AlgebraicGeometry.Spec.map_comp]
            congr 1
            ext r
            exact σ.symm.commutes r)
        left_inv := fun g => by
          ext1
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ g.left) = g.left
          rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have hcomp : CommRingCat.ofHom σ.toRingHom ≫ CommRingCat.ofHom σ.symm.toRingHom =
              𝟙 (CommRingCat.of E) := by
            ext x
            exact σ.symm_apply_apply x
          rw [hcomp, AlgebraicGeometry.Spec.map_id, Category.id_comp]
        right_inv := fun h => by
          ext1
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫ h.left) = h.left
          rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have hcomp : CommRingCat.ofHom σ.symm.toRingHom ≫ CommRingCat.ofHom σ.toRingHom =
              𝟙 (CommRingCat.of (weilExtField F n)) := by
            ext x
            exact σ.apply_symm_apply x
          rw [hcomp, AlgebraicGeometry.Spec.map_id, Category.id_comp] }
    exact Nat.card_congr e

  
  have h_fin : ∀ (L : Type u) [Field L] [Algebra F L] [Finite L],
      Finite (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap F L))) ⟶ X) := by
    intro L _ _ _
    have : AlgebraicGeometry.UniversallyClosed X.hom :=
      AlgebraicGeometry.IsProper.toUniversallyClosed
    have : AlgebraicGeometry.LocallyOfFiniteType X.hom :=
      AlgebraicGeometry.IsProper.toLocallyOfFiniteType
    have : AlgebraicGeometry.QuasiCompact X.hom :=
      AlgebraicGeometry.instQuasiCompactOfUniversallyClosed X.hom
    have : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) :=
      AlgebraicGeometry.Scheme.compactSpace_of_isAffine _
    have : CompactSpace ↥X.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
    obtain ⟨Us, hUs_sub, hUs_fin, hUs_sup⟩ :=
      (AlgebraicGeometry.Scheme.isBasis_affineOpens X.left).exists_finite_of_isCompact
        (U := (⊤ : X.left.Opens)) isCompact_univ
    have : Finite ↥Us := hUs_fin.to_subtype
    have h_ex_φ : ∃ φ : ∀ U : ↥Us, CommRingCat.of F ⟶ X.left.presheaf.obj (Opposite.op U.1),
        ∀ U : ↥Us, AlgebraicGeometry.Spec.map (φ U) = (hUs_sub U.2).fromSpec ≫ X.hom :=
      ⟨fun U => (AlgebraicGeometry.Spec.fullyFaithful.preimage
          ((hUs_sub U.2).fromSpec ≫ X.hom)).unop,
       fun _ => AlgebraicGeometry.Spec.fullyFaithful.map_preimage _⟩
    obtain ⟨φ, hφ_spec⟩ := h_ex_φ
    let algU : ∀ U : ↥Us, Algebra F ↥(X.left.presheaf.obj (Opposite.op U.1)) :=
      fun U => (φ U).hom.toAlgebra
    have hFinAlg : ∀ U : ↥Us,
        Finite (@AlgHom F ↥(X.left.presheaf.obj (Opposite.op U.1)) L _ _ _ (algU U) _) := by
      intro U
      let _ : Algebra F ↥(X.left.presheaf.obj (Opposite.op U.1)) := algU U
      have : AlgebraicGeometry.IsOpenImmersion (hUs_sub U.2).fromSpec :=
        (hUs_sub U.2).isOpenImmersion_fromSpec
      have : AlgebraicGeometry.LocallyOfFiniteType (hUs_sub U.2).fromSpec :=
        AlgebraicGeometry.locallyOfFiniteType_of_isOpenImmersion (hUs_sub U.2).fromSpec
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map (φ U)) := by
        rw [hφ_spec U]
        infer_instance
      have hFT_hom : (φ U).hom.FiniteType :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
      have hFT_alg : Algebra.FiniteType F ↥(X.left.presheaf.obj (Opposite.op U.1)) := hFT_hom
      obtain ⟨s, hs⟩ := hFT_alg.out
      refine Finite.of_injective
        (fun (ψ : ↥(X.left.presheaf.obj (Opposite.op U.1)) →ₐ[F] L) (a : ↥s) => ψ a.1) ?_
      intro ψ₁ ψ₂ h_eq
      have h_le : (⊤ : Subalgebra F ↥(X.left.presheaf.obj (Opposite.op U.1))) ≤
          AlgHom.equalizer ψ₁ ψ₂ := by
        rw [← hs, Algebra.adjoin_le_iff]
        intro a ha
        exact congr_fun h_eq ⟨a, ha⟩
      ext x
      exact h_le trivial
    let F_map : (Σ U : ↥Us, @AlgHom F ↥(X.left.presheaf.obj (Opposite.op U.1)) L _ _ _
          (algU U) _) →
        (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap F L))) ⟶ X) :=
      fun ⟨U, ψ⟩ =>
        let _ : Algebra F ↥(X.left.presheaf.obj (Opposite.op U.1)) := algU U
        CategoryTheory.Over.homMk
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ (hUs_sub U.2).fromSpec)
          (by
            change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫
                (hUs_sub U.2).fromSpec) ≫ X.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F L))
            rw [Category.assoc, ← hφ_spec U, ← AlgebraicGeometry.Spec.map_comp]
            congr 1
            ext r
            exact ψ.commutes r)
    refine Finite.of_surjective F_map ?_
    intro g
    let g_left : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ X.left := g.left
    let pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := default
    have h_top : g_left pt ∈ (⊤ : X.left.Opens) := trivial
    rw [hUs_sup, TopologicalSpace.Opens.mem_sSup] at h_top
    obtain ⟨U₀, hU₀_mem, hxU₀⟩ := h_top
    let U : ↥Us := ⟨U₀, hU₀_mem⟩
    have : AlgebraicGeometry.IsOpenImmersion (hUs_sub U.2).fromSpec :=
      (hUs_sub U.2).isOpenImmersion_fromSpec
    have h_range : Set.range ⇑g_left ⊆ Set.range ⇑(hUs_sub U.2).fromSpec := by
      rw [(hUs_sub U.2).range_fromSpec]
      rintro _ ⟨s, rfl⟩
      rw [Subsingleton.elim s pt]
      exact hxU₀
    have h_ex_gU : ∃ g_U : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
          AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op U.1)),
        g_U ≫ (hUs_sub U.2).fromSpec = g_left :=
      ⟨AlgebraicGeometry.IsOpenImmersion.lift (hUs_sub U.2).fromSpec g_left h_range,
       AlgebraicGeometry.IsOpenImmersion.lift_fac (hUs_sub U.2).fromSpec g_left h_range⟩
    obtain ⟨g_U, hg_U_fac⟩ := h_ex_gU
    have h_ex_ψ₀ : ∃ ψ₀ : X.left.presheaf.obj (Opposite.op U.1) ⟶ CommRingCat.of L,
        AlgebraicGeometry.Spec.map ψ₀ = g_U :=
      ⟨(AlgebraicGeometry.Spec.fullyFaithful.preimage g_U).unop,
       AlgebraicGeometry.Spec.fullyFaithful.map_preimage g_U⟩
    obtain ⟨ψ₀, hψ₀_spec⟩ := h_ex_ψ₀
    have hg_w : g_left ≫ X.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F L)) :=
      CategoryTheory.Over.w g
    have h_comm : φ U ≫ ψ₀ = CommRingCat.ofHom (algebraMap F L) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hψ₀_spec, hφ_spec U, ← Category.assoc,
        hg_U_fac, hg_w]
    let _ : Algebra F ↥(X.left.presheaf.obj (Opposite.op U.1)) := algU U
    let ψ : ↥(X.left.presheaf.obj (Opposite.op U.1)) →ₐ[F] L :=
      { ψ₀.hom with
        commutes' := fun r => CategoryTheory.ConcreteCategory.congr_hom h_comm r }
    refine ⟨⟨U, ψ⟩, ?_⟩
    ext1
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫
        (hUs_sub U.2).fromSpec = g_left
    have h_hom_eq : CommRingCat.ofHom ψ.toRingHom = ψ₀ := by
      ext a
      rfl
    rw [h_hom_eq, hψ₀_spec, hg_U_fac]

  
  have h_divisors : ∃ c : ℕ → ℕ, ∀ n : ℕ, 1 ≤ n →
      weilPointCount F X n = ∑ k ∈ Nat.divisors n, k * c k := by
    have h_ex_ι : ∃ ι : ∀ x : ↥X.left, CommRingCat.of F ⟶ X.left.residueField x,
        ∀ x : ↥X.left,
          AlgebraicGeometry.Spec.map (ι x) = X.left.fromSpecResidueField x ≫ X.hom :=
      ⟨fun x => (AlgebraicGeometry.Spec.fullyFaithful.preimage
          (X.left.fromSpecResidueField x ≫ X.hom)).unop,
       fun _ => AlgebraicGeometry.Spec.fullyFaithful.map_preimage _⟩
    obtain ⟨ι, hι_spec⟩ := h_ex_ι
    let algRes : ∀ x : ↥X.left, Algebra F ↥(X.left.residueField x) :=
      fun x => (ι x).hom.toAlgebra
    let d : ↥X.left → ℕ :=
      fun x => @Module.finrank F ↥(X.left.residueField x) _ _ (algRes x).toModule

    
    have h_equivOverSigma : ∀ (L : Type u) [Field L] [Algebra F L],
        Nonempty ((CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap F L))) ⟶ X) ≃
        (Σ x : ↥X.left, @AlgHom F ↥(X.left.residueField x) L _ _ _ (algRes x) _)) := by
      intro L _ _
      let s := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F L))
      let e₁ : (CategoryTheory.Over.mk s ⟶ X) ≃
          { g : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ X.left // g ≫ X.hom = s } :=
        { toFun := fun g => ⟨g.left, CategoryTheory.Over.w g⟩
          invFun := fun g => CategoryTheory.Over.homMk g.1 g.2
          left_inv := fun g => by ext1; rfl
          right_inv := fun g => by ext1; rfl }
      let e₀ := AlgebraicGeometry.Scheme.SpecToEquivOfField L X.left
      have he₀_cond : ∀ xf : (x : ↥X.left) × (X.left.residueField x ⟶ CommRingCat.of L),
          (e₀.symm xf ≫ X.hom = s) ↔ (ι xf.1 ≫ xf.2 = CommRingCat.ofHom (algebraMap F L)) := by
        intro xf
        rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply, Category.assoc,
          ← hι_spec xf.1, ← AlgebraicGeometry.Spec.map_comp]
        exact AlgebraicGeometry.Spec.map_injective.eq_iff
      let e₂ : { g : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ X.left // g ≫ X.hom = s } ≃
          { xf : (x : ↥X.left) × (X.left.residueField x ⟶ CommRingCat.of L) //
            ι xf.1 ≫ xf.2 = CommRingCat.ofHom (algebraMap F L) } :=
        { toFun := fun g => ⟨e₀ g.1, (he₀_cond (e₀ g.1)).mp (by rw [e₀.symm_apply_apply]; exact g.2)⟩
          invFun := fun xf => ⟨e₀.symm xf.1, (he₀_cond xf.1).mpr xf.2⟩
          left_inv := fun g => Subtype.ext (e₀.symm_apply_apply g.1)
          right_inv := fun xf => Subtype.ext (e₀.apply_symm_apply xf.1) }
      let e₃ : { xf : (x : ↥X.left) × (X.left.residueField x ⟶ CommRingCat.of L) //
            ι xf.1 ≫ xf.2 = CommRingCat.ofHom (algebraMap F L) } ≃
          (Σ x : ↥X.left, @AlgHom F ↥(X.left.residueField x) L _ _ _ (algRes x) _) :=
        { toFun := fun ⟨⟨x, f⟩, hf⟩ =>
            let _ : Algebra F ↥(X.left.residueField x) := algRes x
            ⟨x, { f.hom with
              commutes' := fun r => CategoryTheory.ConcreteCategory.congr_hom hf r }⟩
          invFun := fun ⟨x, σ⟩ =>
            let _ : Algebra F ↥(X.left.residueField x) := algRes x
            ⟨⟨x, CommRingCat.ofHom σ.toRingHom⟩, by ext r; exact σ.commutes r⟩
          left_inv := fun ⟨⟨x, f⟩, hf⟩ => by
            ext1
            refine Sigma.ext rfl (heq_of_eq ?_)
            ext a
            rfl
          right_inv := fun ⟨x, σ⟩ => by
            refine Sigma.ext rfl (heq_of_eq ?_)
            let _ : Algebra F ↥(X.left.residueField x) := algRes x
            ext a
            rfl }
      exact ⟨(e₁.trans e₂).trans e₃⟩

    
    have h_finrank_ext : ∀ n : ℕ, 1 ≤ n → Module.finrank F (weilExtField F n) = n := by
      intro n hn
      obtain ⟨p, hp⟩ := CharP.exists F
      have : NeZero p := ⟨CharP.char_ne_zero_of_finite F p⟩
      have : Fact p.Prime := CharP.char_is_prime_of_pos F p
      have : NeZero n := ⟨by omega⟩
      let E₀ := FiniteField.Extension F p n
      have hfr₀ : Module.finrank F E₀ = n := FiniteField.finrank_extension F p n
      have : Module.Finite F E₀ :=
        Module.finite_of_finrank_pos (by omega : 0 < Module.finrank F E₀)
      have : Finite E₀ := Module.finite_of_finite F
      let _ : Fintype E₀ := Fintype.ofFinite E₀
      have hcard₀ : Fintype.card E₀ = Nat.card F ^ n := by
        rw [← Nat.card_eq_fintype_card, Module.natCard_eq_pow_finrank (K := F), hfr₀]
      have hSplit₀ : Polynomial.IsSplittingField F E₀
          (Polynomial.X ^ (Nat.card F ^ n) - Polynomial.X) := by
        rw [← hcard₀]
        exact FiniteField.isSplittingField_sub E₀ F
      have h_eq₀ : Nonempty (E₀ ≃ₐ[F] weilExtField F n) :=
        ⟨@Polynomial.IsSplittingField.algEquiv F E₀ _ _ _
          (Polynomial.X ^ (Nat.card F ^ n) - Polynomial.X) hSplit₀⟩
      obtain ⟨τ⟩ := h_eq₀
      rw [← τ.toLinearEquiv.finrank_eq, hfr₀]

    
    have h_dvd_of_hom : ∀ (n : ℕ) (hn : 1 ≤ n) (x : ↥X.left),
        @AlgHom F ↥(X.left.residueField x) (weilExtField F n) _ _ _ (algRes x) _ →
        d x ∣ n := by
      intro n hn x σ
      let _ : Algebra F ↥(X.left.residueField x) := algRes x
      have : Finite (weilExtField F n) :=
        Polynomial.IsSplittingField.instFiniteSplittingField _
      let _ : Algebra ↥(X.left.residueField x) (weilExtField F n) := σ.toRingHom.toAlgebra
      have : IsScalarTower F ↥(X.left.residueField x) (weilExtField F n) :=
        IsScalarTower.of_algebraMap_eq' σ.comp_algebraMap.symm
      have hmul : d x * Module.finrank ↥(X.left.residueField x) (weilExtField F n) = n := by
        change Module.finrank F ↥(X.left.residueField x) *
          Module.finrank ↥(X.left.residueField x) (weilExtField F n) = n
        rw [Module.finrank_mul_finrank F ↥(X.left.residueField x) (weilExtField F n),
          h_finrank_ext n hn]
      exact ⟨Module.finrank ↥(X.left.residueField x) (weilExtField F n), hmul.symm⟩

    have h_card_of_dvd : ∀ (n : ℕ) (hn : 1 ≤ n) (x : ↥X.left),
        d x ∣ n →
        Nat.card (@AlgHom F ↥(X.left.residueField x) (weilExtField F n) _ _ _ (algRes x) _) =
          d x ∧
        Nonempty (@AlgHom F ↥(X.left.residueField x) (weilExtField F n) _ _ _ (algRes x) _) := by
      intro n hn x hdvd
      let _ : Algebra F ↥(X.left.residueField x) := algRes x
      have : Finite (weilExtField F n) :=
        Polynomial.IsSplittingField.instFiniteSplittingField _
      have hdvd' : Module.finrank F ↥(X.left.residueField x) ∣
          Module.finrank F (weilExtField F n) := by
        rw [h_finrank_ext n hn]
        exact hdvd
      exact ⟨FiniteField.natCard_algHom_of_finrank_dvd hdvd',
        FiniteField.nonempty_algHom_of_finrank_dvd hdvd'⟩

    let c : ℕ → ℕ := fun k => Nat.card { x : ↥X.left // d x = k }
    have h_fin_locus : ∀ k : ℕ, 1 ≤ k → Finite { x : ↥X.left // d x = k } := by
      intro k hk
      have : Finite (weilExtField F k) :=
        Polynomial.IsSplittingField.instFiniteSplittingField _
      have : Finite (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap F (weilExtField F k)))) ⟶ X) :=
        h_fin (weilExtField F k)
      obtain ⟨e_k⟩ := h_equivOverSigma (weilExtField F k)
      have : Finite (Σ x : ↥X.left,
          @AlgHom F ↥(X.left.residueField x) (weilExtField F k) _ _ _ (algRes x) _) :=
        Finite.of_equiv _ e_k
      have h_nonempty : ∀ x : { x : ↥X.left // d x = k },
          Nonempty (@AlgHom F ↥(X.left.residueField x.1) (weilExtField F k) _ _ _
            (algRes x.1) _) := by
        intro x
        exact (h_card_of_dvd k hk x.1 (by rw [x.2])).2
      refine Finite.of_injective
        (fun x : { x : ↥X.left // d x = k } =>
          (⟨x.1, Classical.choice (h_nonempty x)⟩ :
            Σ y : ↥X.left, @AlgHom F ↥(X.left.residueField y) (weilExtField F k) _ _ _
              (algRes y) _)) ?_
      intro x₁ x₂ heq
      exact Subtype.ext (congrArg Sigma.fst heq)

    refine ⟨c, ?_⟩
    intro n hn
    have : Finite (weilExtField F n) :=
      Polynomial.IsSplittingField.instFiniteSplittingField _
    have : Finite (CategoryTheory.Over.mk (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap F (weilExtField F n)))) ⟶ X) :=
      h_fin (weilExtField F n)
    obtain ⟨e_n⟩ := h_equivOverSigma (weilExtField F n)
    let e_double : (Σ x : ↥X.left,
          @AlgHom F ↥(X.left.residueField x) (weilExtField F n) _ _ _ (algRes x) _) ≃
        (Σ k : ↥(Nat.divisors n), Σ x : { x : ↥X.left // d x = k.1 },
          @AlgHom F ↥(X.left.residueField x.1) (weilExtField F n) _ _ _ (algRes x.1) _) :=
      { toFun := fun ⟨x, σ⟩ =>
          ⟨⟨d x, Nat.mem_divisors.mpr ⟨h_dvd_of_hom n hn x σ, by omega⟩⟩, ⟨⟨x, rfl⟩, σ⟩⟩
        invFun := fun ⟨_, ⟨x, σ⟩⟩ => ⟨x.1, σ⟩
        left_inv := fun ⟨_, _⟩ => rfl
        right_inv := fun ⟨⟨_, _⟩, ⟨⟨_, hx⟩, σ⟩⟩ => by
          dsimp only at hx σ ⊢
          subst hx
          rfl }
    have h_card1 : weilPointCount F X n =
        Nat.card (Σ k : ↥(Nat.divisors n), Σ x : { x : ↥X.left // d x = k.1 },
          @AlgHom F ↥(X.left.residueField x.1) (weilExtField F n) _ _ _ (algRes x.1) _) :=
      Nat.card_congr (e_n.trans e_double)
    rw [h_card1]
    have h_fin_inner : ∀ k : ↥(Nat.divisors n),
        Finite (Σ x : { x : ↥X.left // d x = k.1 },
          @AlgHom F ↥(X.left.residueField x.1) (weilExtField F n) _ _ _ (algRes x.1) _) := by
      intro k
      have hk1 : 1 ≤ k.1 := Nat.pos_of_mem_divisors k.2
      have : Finite { x : ↥X.left // d x = k.1 } := h_fin_locus k.1 hk1
      have : ∀ x : { x : ↥X.left // d x = k.1 },
          Finite (@AlgHom F ↥(X.left.residueField x.1) (weilExtField F n) _ _ _
            (algRes x.1) _) := by
        intro x
        let _ : Algebra F ↥(X.left.residueField x.1) := algRes x.1
        have : Module.Finite F ↥(X.left.residueField x.1) :=
          Module.finite_of_finrank_pos (by
            change 0 < d x.1
            omega)
        have : Finite ↥(X.left.residueField x.1) := Module.finite_of_finite F
        infer_instance
      infer_instance
    rw [Nat.card_sigma]
    have h_inner_eq : ∀ k : ↥(Nat.divisors n),
        Nat.card (Σ x : { x : ↥X.left // d x = k.1 },
          @AlgHom F ↥(X.left.residueField x.1) (weilExtField F n) _ _ _ (algRes x.1) _) =
        k.1 * c k.1 := by
      intro k
      have hk1 : 1 ≤ k.1 := Nat.pos_of_mem_divisors k.2
      have hkdvd : k.1 ∣ n := (Nat.mem_divisors.mp k.2).1
      have : Finite { x : ↥X.left // d x = k.1 } := h_fin_locus k.1 hk1
      let _ : Fintype { x : ↥X.left // d x = k.1 } := Fintype.ofFinite _
      have : ∀ x : { x : ↥X.left // d x = k.1 },
          Finite (@AlgHom F ↥(X.left.residueField x.1) (weilExtField F n) _ _ _
            (algRes x.1) _) := by
        intro x
        let _ : Algebra F ↥(X.left.residueField x.1) := algRes x.1
        have : Module.Finite F ↥(X.left.residueField x.1) :=
          Module.finite_of_finrank_pos (by
            change 0 < d x.1
            omega)
        have : Finite ↥(X.left.residueField x.1) := Module.finite_of_finite F
        infer_instance
      rw [Nat.card_sigma]
      have h_fib : ∀ x : { x : ↥X.left // d x = k.1 },
          Nat.card (@AlgHom F ↥(X.left.residueField x.1) (weilExtField F n) _ _ _
            (algRes x.1) _) = k.1 := by
        intro x
        have hdvd_x : d x.1 ∣ n := by rw [x.2]; exact hkdvd
        rw [(h_card_of_dvd n hn x.1 hdvd_x).1, x.2]
      simp_rw [h_fib, Finset.sum_const, Finset.card_univ, smul_eq_mul, ← Nat.card_eq_fintype_card]
      exact mul_comm (c k.1) k.1
    simp_rw [h_inner_eq]
    exact Finset.sum_coe_sort (Nat.divisors n) (fun k => k * c k)

  
  obtain ⟨c, hc⟩ := h_divisors
  have h_part2 : ∃ Z : PowerSeries ℤ,
      PowerSeries.constantCoeff Z = 1 ∧
      PowerSeries.X * PowerSeries.derivative Z = Z * weilLogDerivSeries F X := by
    let D : PowerSeries ℤ → PowerSeries ℤ := fun f => PowerSeries.X * PowerSeries.derivative f
    have hD_coeff : ∀ (f : PowerSeries ℤ) (n : ℕ),
        PowerSeries.coeff n (D f) = (n : ℤ) * PowerSeries.coeff n f := by
      intro f n
      cases n with
      | zero => simp [D, PowerSeries.coeff_zero_X_mul]
      | succ m =>
        simp only [D, PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative,
          Nat.cast_add, Nat.cast_one]
        ring
    have hD_one : D 1 = 0 := by
      ext n
      rw [hD_coeff, PowerSeries.coeff_one, map_zero]
      split_ifs with hn <;> simp [hn]
    have hD_mul : ∀ f g : PowerSeries ℤ, D (f * g) = f * D g + g * D f := by
      intro f g
      dsimp only [D]
      rw [PowerSeries.derivative.leibniz f g, smul_eq_mul, smul_eq_mul]
      ring
    let G : ℕ → PowerSeries ℤ := fun k => PowerSeries.mk fun n => if k ∣ n then 1 else 0
    let H : ℕ → PowerSeries ℤ := fun k =>
      PowerSeries.mk fun n => if n = 0 then 0 else if k ∣ n then (k : ℤ) else 0
    have hG_deriv : ∀ k : ℕ, 1 ≤ k → D (G k) = G k * H k := by
      intro k hk
      have hG_inv : (1 - PowerSeries.X ^ k) * G k = 1 := by
        ext n
        dsimp only [G]
        rw [sub_mul, one_mul, map_sub, PowerSeries.coeff_X_pow_mul',
          PowerSeries.coeff_mk, PowerSeries.coeff_one]
        by_cases hkn : k ≤ n
        · have hn0 : n ≠ 0 := by omega
          have hdvd : (k ∣ n - k) ↔ (k ∣ n) := by
            conv_rhs => rw [← Nat.sub_add_cancel hkn]
            exact Nat.dvd_add_self_right.symm
          simp only [hkn, ↓reduceIte, PowerSeries.coeff_mk]
          simp [hn0, hdvd]
        · simp only [hkn, ↓reduceIte]
          by_cases hn0 : n = 0
          · subst hn0
            simp
          · have hndvd : ¬ k ∣ n := fun hd => hkn (Nat.le_of_dvd (by omega) hd)
            simp [hn0, hndvd]
      have hH_eq : k • (PowerSeries.X ^ k * G k) = H k := by
        ext n
        dsimp only [G, H]
        rw [map_nsmul, nsmul_eq_mul, PowerSeries.coeff_X_pow_mul',
          PowerSeries.coeff_mk]
        by_cases hkn : k ≤ n
        · have hn0 : n ≠ 0 := by omega
          have hdvd : (k ∣ n - k) ↔ (k ∣ n) := by
            conv_rhs => rw [← Nat.sub_add_cancel hkn]
            exact Nat.dvd_add_self_right.symm
          simp only [hkn, ↓reduceIte, PowerSeries.coeff_mk, hn0, hdvd]
          split_ifs <;> ring
        · simp only [hkn, ↓reduceIte, mul_zero]
          by_cases hn0 : n = 0
          · simp [hn0]
          · have hndvd : ¬ k ∣ n := fun hd => hkn (Nat.le_of_dvd (by omega) hd)
            simp [hn0, hndvd]
      have hD_sub : D (1 - PowerSeries.X ^ k) = -(k • (PowerSeries.X ^ k : PowerSeries ℤ)) := by
        ext n
        rw [hD_coeff, map_sub, PowerSeries.coeff_one, PowerSeries.coeff_X_pow,
          map_neg, map_nsmul, nsmul_eq_mul, PowerSeries.coeff_X_pow]
        by_cases hn0 : n = 0
        · subst hn0
          have hk0 : 0 ≠ k := by omega
          simp [hk0]
        · by_cases hnk : n = k
          · subst hnk
            simp [hn0]
          · simp [hn0, hnk]
      have h0 : D ((1 - PowerSeries.X ^ k) * G k) = 0 := by rw [hG_inv, hD_one]
      rw [hD_mul, hD_sub, nsmul_eq_mul] at h0
      rw [nsmul_eq_mul] at hH_eq
      have h_lin : (1 - PowerSeries.X ^ k) * D (G k) = H k := by
        calc (1 - PowerSeries.X ^ k) * D (G k)
            = (1 - PowerSeries.X ^ k) * D (G k) +
                G k * -((k : PowerSeries ℤ) * PowerSeries.X ^ k) +
                (k : PowerSeries ℤ) * (PowerSeries.X ^ k * G k) := by ring
          _ = 0 + H k := by rw [h0, hH_eq]
          _ = H k := zero_add _
      calc D (G k)
          = 1 * D (G k) := (one_mul _).symm
        _ = (G k * (1 - PowerSeries.X ^ k)) * D (G k) := by rw [mul_comm (G k), hG_inv]
        _ = G k * ((1 - PowerSeries.X ^ k) * D (G k)) := mul_assoc _ _ _
        _ = G k * H k := by rw [h_lin]

    have hG_pow : ∀ (k : ℕ), 1 ≤ k → ∀ m : ℕ, D (G k ^ m) = G k ^ m * (m • H k) := by
      intro k hk m
      induction m with
      | zero => simp [hD_one]
      | succ m ih =>
        rw [pow_succ, hD_mul, ih, hG_deriv k hk, add_nsmul, one_nsmul]
        ring

    have h_prod_deriv : ∀ (s : Finset ℕ), (∀ k ∈ s, 1 ≤ k) →
        D (∏ k ∈ s, G k ^ c k) = (∏ k ∈ s, G k ^ c k) * (∑ k ∈ s, c k • H k) := by
      intro s
      induction s using Finset.cons_induction with
      | empty => intro _; simp [hD_one]
      | cons a s ha ih =>
        intro hs
        have ha1 : 1 ≤ a := hs a (Finset.mem_cons_self a s)
        have hs1 : ∀ k ∈ s, 1 ≤ k := fun k hk => hs k (Finset.mem_cons.mpr (Or.inr hk))
        rw [Finset.prod_cons, Finset.sum_cons, hD_mul, ih hs1, hG_pow a ha1 (c a)]
        ring

    let P : ℕ → PowerSeries ℤ := fun M => ∏ k ∈ Finset.Icc 1 M, G k ^ c k
    let L_trunc : ℕ → PowerSeries ℤ := fun M => ∑ k ∈ Finset.Icc 1 M, c k • H k
    have hP_deriv : ∀ M : ℕ, D (P M) = P M * L_trunc M := by
      intro M
      exact h_prod_deriv (Finset.Icc 1 M) (fun k hk => (Finset.mem_Icc.mp hk).1)

    
    have h_mul_congr : ∀ (M : ℕ) (A B C : PowerSeries ℤ),
        (∀ j ≤ M, PowerSeries.coeff j A = PowerSeries.coeff j B) →
        (∀ j ≤ M, PowerSeries.coeff j (A * C) = PowerSeries.coeff j (B * C)) := by
      intro M A B C hAB j hj
      rw [PowerSeries.coeff_mul, PowerSeries.coeff_mul]
      refine Finset.sum_congr rfl fun uv huv => ?_
      have huv_eq : uv.1 + uv.2 = j := Finset.HasAntidiagonal.mem_antidiagonal.mp huv
      have hu : uv.1 ≤ M := by omega
      rw [hAB uv.1 hu]

    have hG_pow_one : ∀ (M k m : ℕ), M < k →
        ∀ j ≤ M, PowerSeries.coeff j (G k ^ m) = PowerSeries.coeff j (1 : PowerSeries ℤ) := by
      intro M k m hMk
      have hG1 : ∀ j ≤ M, PowerSeries.coeff j (G k) = PowerSeries.coeff j (1 : PowerSeries ℤ) := by
        intro j hj
        dsimp only [G]
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_one]
        by_cases hj0 : j = 0
        · subst hj0; simp
        · have hndvd : ¬ k ∣ j := fun hd => by
            have := Nat.le_of_dvd (by omega) hd
            omega
          simp [hj0, hndvd]
      induction m with
      | zero => intro j _; rfl
      | succ m ih =>
        intro j hj
        rw [pow_succ, h_mul_congr M (G k ^ m) 1 (G k) ih j hj, one_mul, hG1 j hj]

    have hP_step : ∀ M j : ℕ, j ≤ M →
        PowerSeries.coeff j (P (M + 1)) = PowerSeries.coeff j (P M) := by
      intro M j hj
      have hIcc : Finset.Icc 1 (M + 1) = insert (M + 1) (Finset.Icc 1 M) := by
        ext x
        simp only [Finset.mem_Icc, Finset.mem_insert]
        omega
      have hnotmem : M + 1 ∉ Finset.Icc 1 M := by simp
      have hP_succ : P (M + 1) = G (M + 1) ^ c (M + 1) * P M := by
        dsimp only [P]
        rw [hIcc, Finset.prod_insert hnotmem]
      rw [hP_succ,
        h_mul_congr M (G (M + 1) ^ c (M + 1)) 1 (P M)
          (hG_pow_one M (M + 1) (c (M + 1)) (by omega)) j hj,
        one_mul]

    have hP_stab : ∀ j M : ℕ, j ≤ M →
        PowerSeries.coeff j (P M) = PowerSeries.coeff j (P j) := by
      intro j M hjM
      obtain ⟨r, rfl⟩ := Nat.exists_eq_add_of_le hjM
      induction r with
      | zero => simp
      | succ r ih =>
        rw [← add_assoc, hP_step (j + r) j (Nat.le_add_right j r), ih (Nat.le_add_right j r)]

    let Z : PowerSeries ℤ := PowerSeries.mk fun n => PowerSeries.coeff n (P n)
    have hZ0 : PowerSeries.constantCoeff Z = 1 := by
      rw [← PowerSeries.coeff_zero_eq_constantCoeff, PowerSeries.coeff_mk]
      have hP0 : P 0 = 1 := by
        dsimp only [P]
        have h_emp : Finset.Icc 1 0 = ∅ := by simp
        rw [h_emp, Finset.prod_empty]
      rw [hP0, PowerSeries.coeff_one]
      simp

    refine ⟨Z, hZ0, ?_⟩
    change D Z = Z * weilLogDerivSeries F X
    ext n
    cases n with
    | zero =>
      rw [hD_coeff, PowerSeries.coeff_zero_eq_constantCoeff, map_mul]
      simp [weilLogDerivSeries]
    | succ m =>
      set n := m + 1
      have hn1 : 1 ≤ n := by omega
      have h_lhs : PowerSeries.coeff n (D Z) = PowerSeries.coeff n (P n * L_trunc n) := by
        rw [hD_coeff Z n, PowerSeries.coeff_mk, ← hD_coeff (P n) n, hP_deriv n]
      rw [h_lhs, PowerSeries.coeff_mul, PowerSeries.coeff_mul]
      refine Finset.sum_congr rfl fun ij hij => ?_
      have hij_eq : ij.1 + ij.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hij
      have hi : ij.1 ≤ n := by omega
      have hj : ij.2 ≤ n := by omega
      have h1 : PowerSeries.coeff ij.1 (P n) = PowerSeries.coeff ij.1 Z := by
        rw [PowerSeries.coeff_mk, hP_stab ij.1 n hi]
      have h2 : PowerSeries.coeff ij.2 (L_trunc n) =
          PowerSeries.coeff ij.2 (weilLogDerivSeries F X) := by
        dsimp only [L_trunc, weilLogDerivSeries, H]
        rw [map_sum, PowerSeries.coeff_mk]
        by_cases hj0 : ij.2 = 0
        · rw [hj0]
          simp
        · have hj1 : 1 ≤ ij.2 := by omega
          simp only [hj0, ↓reduceIte]
          have h_sum_term : ∀ k ∈ Finset.Icc 1 n,
              PowerSeries.coeff ij.2 (c k • PowerSeries.mk fun m =>
                if m = 0 then 0 else if k ∣ m then (k : ℤ) else 0) =
              if k ∣ ij.2 then (k * c k : ℤ) else 0 := by
            intro k _
            rw [map_nsmul, nsmul_eq_mul, PowerSeries.coeff_mk]
            simp only [hj0, ↓reduceIte]
            split_ifs with hkd
            · ring
            · ring
          rw [Finset.sum_congr rfl h_sum_term, ← Finset.sum_filter]
          have h_filt : (Finset.Icc 1 n).filter (· ∣ ij.2) = Nat.divisors ij.2 := by
            ext k
            simp only [Finset.mem_filter, Finset.mem_Icc, Nat.mem_divisors]
            constructor
            · rintro ⟨_, hkd⟩
              exact ⟨hkd, hj0⟩
            · rintro ⟨hkd, _⟩
              exact ⟨⟨Nat.pos_of_mem_divisors (Nat.mem_divisors.mpr ⟨hkd, hj0⟩),
                le_trans (Nat.le_of_dvd hj1 hkd) hj⟩, hkd⟩
          rw [h_filt, hc ij.2 hj1, Nat.cast_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          push_cast
          rfl
      rw [h1, h2]

  exact ⟨h_part1, h_part2⟩

theorem weil_integrality_and_aut_invariance_of_purity (q d : ℕ) (hq : 2 ≤ q)
    (N : ℕ → ℕ) (A : ℕ → Multiset ℂ)
    (hZ : ∃ Z : PowerSeries ℤ,
      PowerSeries.constantCoeff Z = 1 ∧
      PowerSeries.X * PowerSeries.derivative Z =
        Z * PowerSeries.mk (fun n => if n = 0 then 0 else (N n : ℤ)))
    (hTr : ∀ n : ℕ, 1 ≤ n →
      (N n : ℂ) = ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((A i).map (· ^ n)).sum)
    (hPure : ∀ i ≤ 2 * d, ∀ α ∈ A i,
      IsAlgebraic ℚ α ∧ ∀ β : ℂ, Polynomial.aeval β (minpoly ℚ α) = 0 → ‖β‖ = √(q ^ i)) :
    ∀ i ≤ 2 * d,
      (∀ φ : ℂ ≃+* ℂ, (A i).map φ = A i) ∧
      (∀ α ∈ A i, IsIntegral ℤ α ∧ ‖α‖ = √(q ^ i)) :=
by
  obtain ⟨Z, hZ0, hZderiv⟩ := hZ
  
  have hEqC :
      PowerSeries.map (Int.castRingHom ℂ) Z *
        Polynomial.toPowerSeries (((∑ i ∈ (Finset.Iic (2 * d)).filter Even, A i).map
          (fun α => (1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X)).prod) =
      Polynomial.toPowerSeries (((∑ i ∈ (Finset.Iic (2 * d)).filter Odd, A i).map
        (fun α => (1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X)).prod) := by
    have hTheta : ∀ {R : Type} [CommSemiring R] (F : PowerSeries R) (n : ℕ),
        PowerSeries.coeff n (PowerSeries.X * PowerSeries.derivative F) =
          (n : R) * PowerSeries.coeff n F := by
      intro R _ F n
      cases n with
      | zero => simp [PowerSeries.coeff_zero_X_mul]
      | succ m =>
        rw [PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_derivative]
        push_cast
        exact mul_comm _ _
    have hTheta_mul : ∀ (f g : PowerSeries ℂ),
        PowerSeries.X * PowerSeries.derivative (f * g) =
          (PowerSeries.X * PowerSeries.derivative f) * g +
            f * (PowerSeries.X * PowerSeries.derivative g) := by
      intro f g
      ext n
      rw [map_add, hTheta, PowerSeries.coeff_mul, PowerSeries.coeff_mul, PowerSeries.coeff_mul,
        Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun p hp => ?_
      have hp_eq : p.1 + p.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      rw [hTheta, hTheta, ← hp_eq]
      push_cast
      ring
    let P : Multiset ℂ → Polynomial ℂ := fun M =>
      (M.map (fun α => (1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X)).prod
    let L : Multiset ℂ → PowerSeries ℂ := fun M =>
      PowerSeries.mk (fun n => if n = 0 then 0 else (M.map (· ^ n)).sum)
    have hP0 : ∀ M : Multiset ℂ, (P M).coeff 0 = 1 := by
      intro M
      induction M using Multiset.induction_on with
      | empty => simp [P]
      | cons α M' ih =>
        simp only [P, Multiset.map_cons, Multiset.prod_cons]
        rw [Polynomial.mul_coeff_zero, ih, mul_one]
        simp
    have hSingle : ∀ α : ℂ,
        PowerSeries.X *
            PowerSeries.derivative ((1 : PowerSeries ℂ) - PowerSeries.C α * PowerSeries.X) =
          - ((1 : PowerSeries ℂ) - PowerSeries.C α * PowerSeries.X) *
            PowerSeries.mk (fun n => if n = 0 then (0 : ℂ) else α ^ n) := by
      intro α
      set l_α : PowerSeries ℂ := PowerSeries.mk (fun n => if n = 0 then (0 : ℂ) else α ^ n)
      have hrhs : - ((1 : PowerSeries ℂ) - PowerSeries.C α * PowerSeries.X) * l_α =
          PowerSeries.C α * (PowerSeries.X * l_α) - l_α := by ring
      rw [hrhs]
      ext n
      rw [hTheta]
      cases n with
      | zero =>
        simp [l_α]
      | succ m =>
        cases m with
        | zero =>
          simp [l_α, PowerSeries.coeff_C_mul, PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_one]
        | succ k =>
          have hXk : PowerSeries.coeff (k + 2) (PowerSeries.X : PowerSeries ℂ) = 0 := by
            have h1 : PowerSeries.coeff (k + 2) (PowerSeries.X * (1 : PowerSeries ℂ)) =
                PowerSeries.coeff (k + 1) (1 : PowerSeries ℂ) :=
              PowerSeries.coeff_succ_X_mul (k + 1) 1
            simpa [PowerSeries.coeff_one] using h1
          simp only [map_sub, PowerSeries.coeff_C_mul, PowerSeries.coeff_succ_X_mul,
            PowerSeries.coeff_one, hXk, l_α, PowerSeries.coeff_mk]
          simp [pow_succ']
    have hP_deriv : ∀ M : Multiset ℂ,
        PowerSeries.X * PowerSeries.derivative (Polynomial.toPowerSeries (P M)) =
          - Polynomial.toPowerSeries (P M) * L M := by
      intro M
      induction M using Multiset.induction_on with
      | empty =>
        have hL0 : L 0 = 0 := by
          ext n
          simp [L]
        have hP_empty : Polynomial.toPowerSeries (P 0) = 1 := by
          simp [P]
        rw [hP_empty, hL0]
        ext n
        rw [hTheta]
        simp [PowerSeries.coeff_one]
      | cons α M' ih =>
        have hP_cons : Polynomial.toPowerSeries (P (α ::ₘ M')) =
            ((1 : PowerSeries ℂ) - PowerSeries.C α * PowerSeries.X) *
              Polynomial.toPowerSeries (P M') := by
          simp only [P, Multiset.map_cons, Multiset.prod_cons, Polynomial.coe_mul,
            Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_C, Polynomial.coe_X]
        have hL_cons : L (α ::ₘ M') =
            PowerSeries.mk (fun n => if n = 0 then (0 : ℂ) else α ^ n) + L M' := by
          ext n
          simp only [L, map_add, PowerSeries.coeff_mk, Multiset.map_cons, Multiset.sum_cons]
          split_ifs <;> simp
        rw [hP_cons, hL_cons, hTheta_mul, hSingle α, ih]
        ring
    set Z_C : PowerSeries ℂ := PowerSeries.map (Int.castRingHom ℂ) Z
    set L_N : PowerSeries ℂ := PowerSeries.mk (fun n => if n = 0 then (0 : ℂ) else (N n : ℂ))
    have hZ_C0 : PowerSeries.coeff 0 Z_C = 1 := by
      rw [PowerSeries.coeff_map, PowerSeries.coeff_zero_eq_constantCoeff, hZ0, map_one]
    have hZ_C_deriv : PowerSeries.X * PowerSeries.derivative Z_C = Z_C * L_N := by
      ext n
      rw [hTheta]
      have hn := congrArg (fun S => (Int.castRingHom ℂ) (PowerSeries.coeff n S)) hZderiv
      rw [hTheta, map_mul, map_natCast, PowerSeries.coeff_mul, map_sum] at hn
      have hZ_Cn : (Int.castRingHom ℂ) (PowerSeries.coeff n Z) = PowerSeries.coeff n Z_C :=
        (PowerSeries.coeff_map (Int.castRingHom ℂ) n Z).symm
      rw [hZ_Cn] at hn
      rw [hn, PowerSeries.coeff_mul]
      refine Finset.sum_congr rfl fun p _ => ?_
      simp only [Z_C, L_N, PowerSeries.coeff_map, PowerSeries.coeff_mk, map_mul]
      split_ifs <;> simp
