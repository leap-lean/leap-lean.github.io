          simp only [ψ_gen, g_C_alg, g_frac_alg, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.lift_tmul, map_mul, AlgHom.coe_comp,
            Function.comp_apply, Algebra.TensorProduct.includeLeft_apply, AlgHom.coe_mk]
          change φ_gen (ι_D_loc (c ⊗ₜ[MvPolynomial (Fin m) k] 1)) * φ_gen (g_frac z) = _
          rw [IsLocalization.lift_eq, hz]
