        let α_κ_ring : κ₀ →+* B₀ ⧸ I_ϖ :=
          Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥Ox₀)
            ((Ideal.Quotient.mk I_ϖ).comp (algebraMap ↥Ox₀ B₀)) hkill_max
        let α_κ : κ₀ →ₐ[↥Ox₀] B₀ ⧸ I_ϖ :=
          { α_κ_ring with commutes' := fun _ => rfl }
        let ψ_inv : TensorProduct ↥Ox₀ κ₀ B₀ →ₐ[↥Ox₀] B₀ ⧸ I_ϖ :=
          Algebra.TensorProduct.lift α_κ q_ϖ (fun x y => mul_comm (α_κ x) (q_ϖ y))
        have h1b_zero : ((1 : κ₀) ⊗ₜ[↥Ox₀] b) = 0 := by
          apply e_res.injective
          change π_mod b = e_res.toRingHom 0
          rw [e_res.toRingHom.map_zero]
          exact hb
        have hq_zero : Ideal.Quotient.mk I_ϖ b = 0 := by
          have h_app : ψ_inv ((1 : κ₀) ⊗ₜ[↥Ox₀] b) = ψ_inv.toRingHom 0 :=
            congrArg ψ_inv h1b_zero
          have hψ_tmul : ψ_inv ((1 : κ₀) ⊗ₜ[↥Ox₀] b) = α_κ 1 * q_ϖ b :=
            Algebra.TensorProduct.lift_tmul _ _ _ 1 b
          have hα1 : α_κ 1 = 1 := α_κ.toRingHom.map_one
          rw [ψ_inv.toRingHom.map_zero, hψ_tmul, hα1, one_mul (q_ϖ b)] at h_app
          exact h_app
        exact Ideal.Quotient.eq_zero_iff_mem.mp hq_zero
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        have hres_ϖ₀ : res₀ ϖ₀ = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hϖ₀_mem_max
        have hϖ_smul : ϖ_B₀ = ϖ₀ • (1 : B₀) :=
          (Algebra.smul_def ϖ₀ (1 : B₀)).trans (mul_one _) |>.symm
        change e_res ((1 : κ₀) ⊗ₜ[↥Ox₀] ϖ_B₀) = 0
        rw [hϖ_smul, ← TensorProduct.smul_tmul]
        have h0' : ϖ₀ • (1 : κ₀) = 0 := by
          change res₀ ϖ₀ * 1 = 0
          rw [hres_ϖ₀, zero_mul]
        rw [h0', TensorProduct.zero_tmul]
        exact e_res.toRingHom.map_zero
    let δ : I → (∀ j : I, Ai j) := fun i j => if j = i then 1 else 0
    let g_fn : I → B₀ := fun i => Classical.choose (hπ_mod_surj (δ i))
    have hg_fn : ∀ i : I, π_mod (g_fn i) = δ i :=
      fun i => Classical.choose_spec (hπ_mod_surj (δ i))
    let res_B : B₀ →+* IsLocalRing.ResidueField ↥O_rel :=
      (IsLocalRing.residue ↥O_rel).comp μ_B.toRingHom
    have hres_B_ϖ : res_B ϖ_B₀ = 0 := by
      change IsLocalRing.residue ↥O_rel (μ_B (algebraMap ↥Ox₀ B₀ ϖ₀)) = 0
      rw [AlgHom.commutes]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hj_max ϖ₀).mp hϖ₀_mem_max)
    have hsum_δ : (∑ i : I, δ i) = 1 := by
      ext j
      simp [δ]
    have hsum_ker : (∑ i : I, g_fn i) - 1 ∈ RingHom.ker π_mod := by
      rw [RingHom.mem_ker, map_sub, map_sum, map_one]
      simp_rw [hg_fn]
      rw [hsum_δ, sub_self]
    have hres_sum_one : ∑ i : I, res_B (g_fn i) = 1 := by
      rw [hker_π_mod, Ideal.mem_span_singleton] at hsum_ker
      obtain ⟨q, hq⟩ := hsum_ker
      have h0 : res_B ((∑ i : I, g_fn i) - 1) = 0 := by
        rw [hq, map_mul, hres_B_ϖ, zero_mul]
      rw [map_sub, map_sum, map_one, sub_eq_zero] at h0
      exact h0
    have hex_star : ∃ i_star : I, res_B (g_fn i_star) ≠ 0 := by
      by_contra hall
      push_neg at hall
      have : (∑ i : I, res_B (g_fn i)) = 0 := Finset.sum_eq_zero (fun i _ => hall i)
      rw [hres_sum_one] at this
      exact one_ne_zero this
    obtain ⟨i_star, hi_star⟩ := hex_star
    let g : B₀ := g_fn i_star
    have hg_mod : π_mod g = δ i_star := hg_fn i_star
    have hg_unit : IsUnit (μ_B g) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hmem
      exact hi_star (Ideal.Quotient.eq_zero_iff_mem.mpr hmem)
    let B_g := Localization.Away g
    haveI : Algebra.Etale B₀ B_g := Algebra.Etale.of_isLocalizationAway g
    haveI : Algebra.Etale ↥Ox₀ B_g := Algebra.Etale.comp ↥Ox₀ B₀ B_g
    haveI : IsNoetherianRing B_g :=
      IsLocalization.isNoetherianRing (Submonoid.powers g) B_g inferInstance
    let μ_g_ring : B_g →+* ↥O_rel := IsLocalization.Away.lift g hg_unit
    have hμg_comp : μ_g_ring.comp (algebraMap B₀ B_g) = μ_B.toRingHom :=
