        (hhomeo_H.symm ⟨y₀, ⟨hy₀W₀, hy₀H⟩, hy₀U⟩).2⟩
    have hSliceGe :=
      (hs4 {b : Fin (N + 1) // b ≠ α₀} (Z_chart α₀) hCl_Zα₀ hIrred_Zα₀).2
        e he hDim_Zα₀ f₀ hNe_zeroLocus
    rw [hhomeo_H.isHomeomorph.topologicalKrullDim_eq] at hSliceGe
    exact hSliceGe.trans
      (hSubspaceDimLE (fun z hz => ⟨hW₀_sub hz.1.1, hz.1.2⟩))
  · intro X ι_X hCl_ι S₀ hClosedS₀ hDimS₀ x hx
    have hx_univ : ι_X.left.base x ∈ (Set.univ : Set (weilProjectiveSpaceOver k N).left) := trivial
    rw [← hCov, Set.mem_iUnion] at hx_univ
    obtain ⟨α, hxU⟩ := hx_univ
    let V_α : X.left.Opens := ι_X.left ⁻¹ᵁ U α
    let v_x : ↥(V_α : AlgebraicGeometry.Scheme.{u}) := ⟨x, hxU⟩
    have : AlgebraicGeometry.IsClosedImmersion ι_X.left := hCl_ι
    have : AlgebraicGeometry.IsClosedImmersion (ι_X.left ∣_ U α) :=
      CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.IsClosedImmersion)
        (AlgebraicGeometry.isPullback_morphismRestrict ι_X.left (U α)).flip hCl_ι
    let g_α : (V_α : AlgebraicGeometry.Scheme.{u}) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {b : Fin (N + 1) // b ≠ α} k)) :=
      (ι_X.left ∣_ U α) ≫ (chartIso α).inv
    have hCl_gα : AlgebraicGeometry.IsClosedImmersion g_α := by
      dsimp [g_α]
      infer_instance
    let S_α : Set (V_α : AlgebraicGeometry.Scheme.{u}) := V_α.ι.base ⁻¹' S₀
    have hClosedS_α : IsClosed S_α := hClosedS₀.preimage V_α.ι.continuous
    have hv_Sα : v_x ∈ S_α := by
      change V_α.ι.base v_x ∈ S₀
      rw [AlgebraicGeometry.Scheme.Opens.ι_apply]
      exact hx
    have hDimS_α : topologicalKrullDim ↥S_α ≤ (0 : WithBot ℕ∞) := by
      let f_emb : ↥S_α → ↥S₀ := fun s => ⟨V_α.ι.base s.1, s.2⟩
      have hf_cont : Continuous f_emb := (V_α.ι.continuous.comp continuous_subtype_val).subtype_mk _
      have hf_inj : Function.Injective f_emb := fun a b h =>
        Subtype.ext (V_α.ι.isOpenEmbedding.injective (congrArg (Subtype.val : ↥S₀ → X.left) h))
      have hf_ind : Topology.IsInducing f_emb :=
        Topology.IsInducing.of_comp hf_cont continuous_subtype_val
          (V_α.ι.isOpenEmbedding.isInducing.comp Topology.IsInducing.subtypeVal)
      have hf_emb' : Topology.IsEmbedding f_emb := ⟨hf_ind, hf_inj⟩
      let hhomeo_Sα : ↥S_α ≃ₜ ↥(f_emb '' Set.univ) :=
        (Homeomorph.Set.univ ↥S_α).symm.trans (hf_emb'.homeomorphImage Set.univ)
      rw [hhomeo_Sα.isHomeomorph.topologicalKrullDim_eq]
      exact (topologicalKrullDim_subspace_le ↥S₀ (f_emb '' Set.univ)).trans hDimS₀
    obtain ⟨q, hq_id, pt, hpt⟩ :=
      hs5 {b : Fin (N + 1) // b ≠ α} (V_α : AlgebraicGeometry.Scheme.{u})
        g_α hCl_gα S_α hClosedS_α hDimS_α v_x hv_Sα
    refine ⟨q ≫ V_α.ι, ?_, pt, ?_⟩
    · calc (q ≫ V_α.ι) ≫ X.hom
          = q ≫ V_α.ι ≫ (ι_X.left ≫ (weilProjectiveSpaceOver k N).hom) := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_X]
        _ = q ≫ (V_α.ι ≫ ι_X.left) ≫ (weilProjectiveSpaceOver k N).hom := by
            simp only [CategoryTheory.Category.assoc]
        _ = q ≫ ((ι_X.left ∣_ U α) ≫ (U α).ι) ≫ (weilProjectiveSpaceOver k N).hom := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = q ≫ g_α ≫ (chartIso α).hom ≫ (U α).ι ≫ (weilProjectiveSpaceOver k N).hom := by
            dsimp [g_α]
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
        _ = q ≫ g_α ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
            rw [hChart_hom α]
        _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := hq_id
    · change V_α.ι.base (q.base pt) = x
      rw [hpt]
      exact AlgebraicGeometry.Scheme.Opens.ι_apply V_α v_x

theorem weil_bertini_transversalLinearSlice_init_zero (k : Type u) [Field k] (N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : X ⟶ weilProjectiveSpaceOver k N) :
    AlgebraicGeometry.IsClosedImmersion ι_X.left →
    ∀ (U : X.left.Opens) (d : ℕ),
      AlgebraicGeometry.SmoothOfRelativeDimension d (U.ι ≫ X.hom) →
      IsTransversalLinearSlice k N X ι_X U d 0 Fin.elim0 :=
by
  intro _hCl U d hSm
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  refine ⟨fun j => Fin.elim0 j, ?_⟩
  intro x hxU _hSlice0

  let y : ↥(AlgebraicGeometry.Proj 𝒜_N) := ι_X.left.base x
  have hα₀_ex : ∃ α₀ : Fin (N + 1),
      y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀) := by
    by_contra! hNone
    have hX_mem : ∀ α₀ : Fin (N + 1),
        (MvPolynomial.X α₀ : MvPolynomial (Fin (N + 1)) k) ∈ y.asHomogeneousIdeal.toIdeal := by
      intro α₀
      have hnot :=
        (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_N (MvPolynomial.X α₀) y).not.mp (hNone α₀)
      exact not_not.mp hnot
    have hSpanX : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
        y.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨α₀, _, rfl⟩
      exact hX_mem α₀
    have hIrrel : HomogeneousIdeal.irrelevant 𝒜_N ≤ y.asHomogeneousIdeal := by
      change (HomogeneousIdeal.irrelevant 𝒜_N).toIdeal ≤ y.asHomogeneousIdeal.toIdeal
      rw [HomogeneousIdeal.irrelevant_eq_span, Ideal.span_le]
      intro p hp
      simp only [Set.mem_iUnion] at hp
      obtain ⟨i, hi, hp_i⟩ := hp
      have hp_hom : p.IsHomogeneous i := (MvPolynomial.mem_homogeneousSubmodule i p).mp hp_i
      apply hSpanX
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra! hm0
      have hm_eq : m = 0 := Finsupp.ext fun α₀ => hm0 α₀ (Set.mem_univ α₀)
      have hdeg0 : Finsupp.degree (0 : Fin (N + 1) →₀ ℕ) = 0 := by simp [Finsupp.degree]
      have hdeg : Finsupp.degree m ≠ i := by
        rw [hm_eq, hdeg0]
        exact ne_of_lt hi
      exact (MvPolynomial.mem_support_iff.mp hm) (hp_hom.coeff_eq_zero hdeg)
    exact y.not_irrelevant_le hIrrel
  obtain ⟨α₀, hxXα⟩ := hα₀_ex
  let X_α₀ : X.left.Opens :=
    (TopologicalSpace.Opens.map ι_X.left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀))
  have hxXα' : x ∈ X_α₀ := hxXα
  have hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_N 1 :=
    MvPolynomial.isHomogeneous_X k α₀
  have hpos : 0 < 1 := zero_lt_one

  have hSm' := hSm
  rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at hSm'
  obtain ⟨U_base, _hAffBase, V_U, hAffVU, hxVU, e₀, hStd₀⟩ := hSm' ⟨x, hxU⟩
  have hUbase : U_base = ⊤ := by
    ext z
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hpt : (U.ι ≫ X.hom).base ⟨x, hxU⟩ ∈ U_base := e₀ hxVU
    rwa [Subsingleton.elim z ((U.ι ≫ X.hom).base ⟨x, hxU⟩)]
  subst hUbase

  let V₀ : X.left.Opens := U.ι ''ᵁ V_U
  have hAffV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hAffVU.image_of_isOpenImmersion U.ι
  have hxV₀ : x ∈ V₀ := ⟨⟨x, hxU⟩, hxVU, AlgebraicGeometry.Scheme.Opens.ι_apply U ⟨x, hxU⟩⟩
  have hV₀U : V₀ ≤ U := by
    rintro _ ⟨w, _, rfl⟩
    change U.ι.base w ∈ U
    rw [AlgebraicGeometry.Scheme.Opens.ι_apply U w]
    exact w.2
  have hpre_eq : U.ι ⁻¹ᵁ V₀ = V_U := by
    ext w
    refine ⟨?_, fun hw => ⟨w, hw, rfl⟩⟩
    rintro ⟨w', hw', hEq⟩
    cases U.ι.isOpenEmbedding.injective hEq
    exact hw'
  have hIso_app : CategoryTheory.IsIso (U.ι.app V₀) :=
    AlgebraicGeometry.PresheafedSpace.IsOpenImmersion.c_iso V_U
  have hIso_map : CategoryTheory.IsIso
      (U.toScheme.presheaf.map (CategoryTheory.homOfLE hpre_eq.ge).op) := by
    have : CategoryTheory.IsIso (CategoryTheory.homOfLE hpre_eq.ge).op :=
      ⟨⟨(CategoryTheory.homOfLE hpre_eq.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
    infer_instance
  let ψ_U := U.ι.appLE V₀ V_U hpre_eq.ge
  have hIso_ψ : CategoryTheory.IsIso ψ_U := by
    dsimp [ψ_U]
    rw [AlgebraicGeometry.Scheme.Hom.appLE]
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_app hIso_map
  have e_V₀ : V₀ ≤ (TopologicalSpace.Opens.map X.hom.base).obj
      (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens) :=
    fun _ _ => trivial
  let α₁ := X.hom.appLE ⊤ V₀ e_V₀
  have hcomp_α₁ : α₁ ≫ ψ_U = (U.ι ≫ X.hom).appLE ⊤ V_U e₀ :=
    AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE U.ι X.hom ⊤ V₀ V_U e_V₀ hpre_eq.ge
  have hα₁_eq : α₁ = (U.ι ≫ X.hom).appLE ⊤ V_U e₀ ≫ CategoryTheory.inv ψ_U := by
    rw [← hcomp_α₁, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
      CategoryTheory.Category.comp_id]
  let e_target : ↑(U.toScheme.presheaf.obj (Opposite.op V_U)) ≃+*
      ↑(X.left.presheaf.obj (Opposite.op V₀)) :=
    (CategoryTheory.asIso ψ_U).symm.commRingCatIsoToRingEquiv
  have hStd_α₁ : RingHom.IsStandardSmoothOfRelativeDimension d α₁.hom := by
    have h_std' : RingHom.IsStandardSmoothOfRelativeDimension d
        (e_target.toRingHom.comp ((U.ι ≫ X.hom).appLE ⊤ V_U e₀).hom) :=
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _ e_target hStd₀
    have hhom : α₁.hom = e_target.toRingHom.comp ((U.ι ≫ X.hom).appLE ⊤ V_U e₀).hom := by
      rw [hα₁_eq, CommRingCat.hom_comp]
      rfl
    rwa [hhom]

  let κ₀ : CommRingCat.of k ⟶ X.left.presheaf.obj (Opposite.op V₀) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ α₁
  let e_source : k ≃+*
      ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv
  have hStd_κ₀ : RingHom.IsStandardSmoothOfRelativeDimension d κ₀.hom := by
    have h_std' : RingHom.IsStandardSmoothOfRelativeDimension d
        (α₁.hom.comp e_source.toRingHom) :=
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso.right α₁.hom e_source hStd_α₁
    have hhom : κ₀.hom = α₁.hom.comp e_source.toRingHom := rfl
    rwa [hhom]

  obtain ⟨g₀, hVα, hxV⟩ := hAffV₀.exists_basicOpen_le (V := X_α₀) ⟨x, hxXα'⟩ hxV₀
  let V : X.left.Opens := X.left.basicOpen g₀
  have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffV₀.basicOpen g₀
  have hVV₀ : V ≤ V₀ := X.left.basicOpen_le g₀
  have hVU : V ≤ U := hVV₀.trans hV₀U

  have : IsLocalization.Away g₀ ↑(X.left.presheaf.obj (Opposite.op V)) :=
    hAffV₀.isLocalization_basicOpen g₀
  have hStd_loc : RingHom.IsStandardSmoothOfRelativeDimension 0
      (algebraMap ↑(X.left.presheaf.obj (Opposite.op V₀))
        ↑(X.left.presheaf.obj (Opposite.op V))) :=
    RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway g₀
  have e_V : V ≤ (TopologicalSpace.Opens.map X.hom.base).obj
      (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens) :=
    fun _ _ => trivial
  let κ_V : CommRingCat.of k ⟶ X.left.presheaf.obj (Opposite.op V) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ X.hom.appLE ⊤ V e_V
  have hκ_V_eq : κ_V = κ₀ ≫ X.left.presheaf.map (CategoryTheory.homOfLE hVV₀).op := by
    dsimp [κ_V, κ₀, α₁]
    rw [CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.Hom.appLE_map X.hom e_V₀ (CategoryTheory.homOfLE hVV₀).op]
  have hκ_V_hom : κ_V.hom =
      (algebraMap ↑(X.left.presheaf.obj (Opposite.op V₀))
        ↑(X.left.presheaf.obj (Opposite.op V))).comp κ₀.hom := by
    rw [hκ_V_eq, CommRingCat.hom_comp]
    rfl
  have hStd_V : RingHom.IsStandardSmoothOfRelativeDimension d κ_V.hom := by
    have hcomp := hStd_loc.comp hStd_κ₀
    rw [Nat.zero_add, ← hκ_V_hom] at hcomp
    exact hcomp

  let R_V := ↑(X.left.presheaf.obj (Opposite.op V))
  let : Algebra k R_V := κ_V.hom.toAlgebra
  obtain ⟨ι, σ, hFinσ, hFinι, P, hdim⟩ :=
    @Algebra.IsStandardSmoothOfRelativeDimension.out d k R_V _ _ κ_V.hom.toAlgebra hStd_V
  have : Finite σ := hFinσ
  have : Finite ι := hFinι
  let s : ℕ := Nat.card σ
  have hs_le : s ≤ Nat.card ι := Nat.card_le_card_of_injective P.map P.map_inj
  have hdim' : Nat.card ι - s = d := hdim
  have hcard_ι : Nat.card ι = s + 0 + d := by omega
  let e_σ : Fin s ≃ σ := (Finite.equivFin σ).symm
  let e_ι : Fin (s + 0 + d) ≃ ι := (Finite.equivFinOfCardEq hcard_ι).symm
  let P' : Algebra.SubmersivePresentation k R_V (Fin (s + 0 + d)) (Fin s) :=
    P.reindex e_ι e_σ

  let φ : MvPolynomial (Fin (s + 0 + d)) k →+* R_V := (MvPolynomial.aeval P'.val).toRingHom
  let q : Fin s → MvPolynomial (Fin (s + 0 + d)) k := P'.relation
  let f_lift : Fin 0 → MvPolynomial (Fin (s + 0 + d)) k := Fin.elim0
  let idx : Fin (s + 0) → Fin (s + 0 + d) := P'.map

  have hSurj_φ : Function.Surjective φ := P'.aeval_val_surjective
  have hInj_idx : Function.Injective idx := P'.map_inj
  have hKer_φ : RingHom.ker φ = Ideal.span (Set.range q) :=
    P'.ker_eq_ker_aeval_val.symm.trans P'.span_range_relation_eq_ker.symm

  have hφ_C : CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (s + 0 + d)) k) ≫
      CommRingCat.ofHom φ = κ_V := by
    rw [← CommRingCat.ofHom_comp]
    have hcomp_C : φ.comp MvPolynomial.C = κ_V.hom := by
      ext c
      exact MvPolynomial.aeval_C P'.val c
    rw [hcomp_C]
    exact CommRingCat.ofHom_hom κ_V

  have hSpec_comm :
      V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V.ι ≫ X.hom := by
    calc V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
        = V.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom φ) := by
          rw [← AlgebraicGeometry.Spec.map_comp]
      _ = V.toSpecΓ ≫ AlgebraicGeometry.Spec.map κ_V := by
          rw [hφ_C]
      _ = V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (X.hom.appLE ⊤ V e_V) ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
          dsimp [κ_V]
          rw [AlgebraicGeometry.Spec.map_comp]
      _ = X.hom.resLE ⊤ V e_V ≫
            (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens).toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
          rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc]
      _ = X.hom.resLE ⊤ V e_V ≫
            (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens).ι ≫
            (AlgebraicGeometry.Spec (CommRingCat.of k)).toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
          rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_top, CategoryTheory.Category.assoc]
      _ = X.hom.resLE ⊤ V e_V ≫
            (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens).ι := by
          rw [AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, CategoryTheory.Category.comp_id]
      _ = V.ι ≫ X.hom := AlgebraicGeometry.Scheme.Hom.resLE_comp_ι X.hom e_V

  let M_trans : Matrix (Fin s) (Fin s) R_V := (φ.mapMatrix P'.jacobiMatrix).transpose
  have hUnit_M : IsUnit M_trans.det := by
    rw [Matrix.det_transpose, ← RingHom.map_det]
    change IsUnit ((MvPolynomial.aeval P'.val) P'.jacobiMatrix.det)
    rw [← P'.algebraMap_apply, ← P'.jacobian_eq_jacobiMatrix_det]
    exact P'.jacobian_isUnit

  have hMat1 : (Matrix.of fun a b : Fin s =>
      φ (MvPolynomial.pderiv (idx (Fin.castAdd 0 b)) (q a))) = M_trans := by
    ext a b
    have hb : (Fin.castAdd 0 b : Fin (s + 0)) = b := Fin.ext rfl
    simp only [Matrix.of_apply, hb]
    change φ (MvPolynomial.pderiv (P'.map b) (P'.relation a)) =
      φ (P'.jacobiMatrix b a)
    rw [P'.jacobiMatrix_apply]

  have hMat2 : (Matrix.of fun a b : Fin (s + 0) =>
      φ (MvPolynomial.pderiv (idx b) (Fin.addCases q f_lift a))) = M_trans := by
    ext a b
    let a₀ : Fin s := ⟨a.1, a.2⟩
    have ha : a = Fin.castAdd 0 a₀ := Fin.ext rfl
    simp only [Matrix.of_apply, ha, Fin.addCases_left]
    change φ (MvPolynomial.pderiv (P'.map b) (P'.relation a₀)) =
      φ (P'.jacobiMatrix b a₀)
    rw [P'.jacobiMatrix_apply]

  refine ⟨α₀, V, hAffV, hxV, hVU, hVα, hXα, hpos, s, φ, q, f_lift, idx,
    hSurj_φ, hInj_idx, hSpec_comm, hKer_φ, fun j => Fin.elim0 j, ?_, ?_⟩
  · rw [hMat1]
    exact hUnit_M
  · rw [hMat2]
    exact hUnit_M

theorem weil_algClosed_proj_closedSet_avoidance_poly (k : Type u) [Field k] [IsAlgClosed k]
    (N p : ℕ)
    (Y : Fin p → Set (weilProjectiveSpaceOver k N).left) :
    (∀ a : Fin p, IsClosed (Y a)) →
    ∃ Δ_closed : MvPolynomial (Fin (N + 1)) k,
      Δ_closed ≠ 0 ∧
      ∀ c : Fin (N + 1) → k,
        MvPolynomial.eval c Δ_closed ≠ 0 →
        ∀ a : Fin p,
          topologicalKrullDim ↥(Y a ∩ weilProjHyperplaneSet k N
            (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i)) + 1 ≤
            topologicalKrullDim ↥(Y a) :=
by
  intro hClosedY
  have hNoeth : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N).left := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let f : ProjectiveSpectrum 𝒜 → PrimeSpectrum (MvPolynomial (Fin (N + 1)) k) :=
      fun x => ⟨x.asHomogeneousIdeal.toIdeal, x.isPrime⟩
    have hPre : ∀ s : Set (MvPolynomial (Fin (N + 1)) k),
        ProjectiveSpectrum.zeroLocus 𝒜 s = f ⁻¹' PrimeSpectrum.zeroLocus s := by
      intro s
      ext x
      simp only [Set.mem_preimage, ProjectiveSpectrum.mem_zeroLocus, PrimeSpectrum.mem_zeroLocus]
      rfl
    have hf : Topology.IsInducing f := by
      refine ⟨TopologicalSpace.ext_isClosed fun Z => ?_⟩
      rw [ProjectiveSpectrum.isClosed_iff_zeroLocus, isClosed_induced_iff]
      constructor
      · rintro ⟨s, hs⟩
        refine ⟨PrimeSpectrum.zeroLocus s, PrimeSpectrum.isClosed_zeroLocus s, ?_⟩
        rw [← hPre s]
        exact hs.symm
      · rintro ⟨K, hK, rfl⟩
        obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal K).mp hK
        refine ⟨(I : Set (MvPolynomial (Fin (N + 1)) k)), ?_⟩
        rw [hI, hPre]
    change TopologicalSpace.NoetherianSpace (ProjectiveSpectrum 𝒜)
    rw [TopologicalSpace.noetherianSpace_iff_isCompact]
    intro s
    exact hf.isCompact_iff.mpr (TopologicalSpace.NoetherianSpace.isCompact (f '' s))
  have hIdealAvoid : ∀ (I : Ideal (MvPolynomial (Fin (N + 1)) k)),
      (∃ α : Fin (N + 1), (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∉ I) →
      ∃ L : MvPolynomial (Fin (N + 1)) k,
        L ≠ 0 ∧
        ∀ c : Fin (N + 1) → k,
          MvPolynomial.eval c L ≠ 0 →
          (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i) ∉ I := by
    intro I ⟨α, hXα⟩
    let V_I : Submodule k (Fin (N + 1) → k) :=
      { carrier := {c | (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i) ∈ I}
        zero_mem' := by simp [I.zero_mem]
        add_mem' := fun {a b} ha hb => by
          change (∑ i : Fin (N + 1), MvPolynomial.C ((a + b) i) * MvPolynomial.X i) ∈ I
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          exact I.add_mem ha hb
        smul_mem' := fun r {a} ha => by
          change (∑ i : Fin (N + 1), MvPolynomial.C ((r • a) i) * MvPolynomial.X i) ∈ I
          simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, ← Finset.mul_sum]
          exact I.mul_mem_left _ ha }
    have hVI_lt : V_I < ⊤ := by
      rw [lt_top_iff_ne_top]
      intro hTop
      have hMem : (Pi.single α (1 : k) : Fin (N + 1) → k) ∈ V_I := by
        rw [hTop]
        trivial
      have hMem' : (∑ i : Fin (N + 1),
          MvPolynomial.C ((Pi.single α (1 : k) : Fin (N + 1) → k) i) * MvPolynomial.X i) ∈ I :=
        hMem
      have hSum : (∑ i : Fin (N + 1),
          MvPolynomial.C ((Pi.single α (1 : k) : Fin (N + 1) → k) i) * MvPolynomial.X i) =
          (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) := by
        rw [Finset.sum_eq_single α]
        · simp
        · intro b _ hb
          simp [Pi.single_eq_of_ne hb]
        · intro hAbs
          exact absurd (Finset.mem_univ α) hAbs
      rw [hSum] at hMem'
      exact hXα hMem'
    obtain ⟨ℓ, hℓ_ne, hℓ_ker⟩ := Submodule.exists_dual_map_eq_bot_of_lt_top hVI_lt inferInstance
    let L : MvPolynomial (Fin (N + 1)) k :=
      ∑ i : Fin (N + 1), MvPolynomial.C (ℓ (Pi.single i 1)) * MvPolynomial.X i
    have hEval : ∀ c : Fin (N + 1) → k, MvPolynomial.eval c L = ℓ c := by
      intro c
      have hc_sum : c = ∑ i : Fin (N + 1), c i • Pi.single i (1 : k) := by
        ext j
        simp [Finset.sum_apply, Pi.single_apply]
      conv_rhs => rw [hc_sum]
      simp only [L, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, map_smul,
        smul_eq_mul, mul_comm]
    have hL_ne : L ≠ 0 := by
      intro hL0
      apply hℓ_ne
      exact LinearMap.ext fun c => by rw [← hEval c, hL0, map_zero, LinearMap.zero_apply]
    refine ⟨L, hL_ne, ?_⟩
    intro c hc_ne hInI
    apply hc_ne
    rw [hEval c]
    have hcV : c ∈ V_I := hInI
    have hMapMem : ℓ c ∈ Submodule.map ℓ V_I := Submodule.mem_map_of_mem hcV
    rwa [hℓ_ker, Submodule.mem_bot] at hMapMem
  have hAvoidPt : ∀ y : (weilProjectiveSpaceOver k N).left,
      ∃ L : MvPolynomial (Fin (N + 1)) k,
        L ≠ 0 ∧
        ∀ c : Fin (N + 1) → k,
          MvPolynomial.eval c L ≠ 0 →
          y ∉ weilProjHyperplaneSet k N
            (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i) := by
    intro y
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let y' : ProjectiveSpectrum 𝒜 := y
    have hExistsX : ∃ α : Fin (N + 1),
        (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∉ y'.asHomogeneousIdeal.toIdeal := by
      by_contra! hAll
      apply y'.not_irrelevant_le
      change (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ y'.asHomogeneousIdeal.toIdeal
      rw [HomogeneousIdeal.irrelevant_eq_span]
      refine Ideal.span_le.mpr ?_
      intro g hg
      simp only [Set.mem_iUnion] at hg
      obtain ⟨n, hn, hg_mem⟩ := hg
      have hSpan : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
          y'.asHomogeneousIdeal.toIdeal := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨α, _, rfl⟩
        exact hAll α
      apply hSpan
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hg_hom : g.IsHomogeneous n := (MvPolynomial.mem_homogeneousSubmodule n g).mp hg_mem
      have hm_deg := hg_hom (MvPolynomial.mem_support_iff.mp hm)
      by_contra! hm0
      have hm_eq : m = 0 := Finsupp.ext fun a => hm0 a (Set.mem_univ a)
      rw [hm_eq] at hm_deg
      simp at hm_deg
      omega
    obtain ⟨L, hL_ne, hL_avoid⟩ := hIdealAvoid y'.asHomogeneousIdeal.toIdeal hExistsX
    refine ⟨L, hL_ne, ?_⟩
    intro c hc_ne hyH
    exact hyH ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜
      (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i)
      (y : ↥(AlgebraicGeometry.Proj 𝒜))).mpr (hL_avoid c hc_ne))
  have hKrullDrop : ∀ (T : Type u) [TopologicalSpace T] (Y₀ H : Set T),
      IsClosed H →
      ∀ (S : Finset (Set T)),
        (∀ W ∈ S, IsClosed W ∧ IsIrreducible W) →
        Y₀ = (⋃ W ∈ S, W) →
        (∀ W ∈ S, ∃ z ∈ W, z ∉ H) →
        topologicalKrullDim ↥(Y₀ ∩ H) + 1 ≤ topologicalKrullDim ↥Y₀ := by
    intro T _ Y₀ H hClosedH S hS hY₀ hAvoid
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)) + 1 ≤
      Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Y₀)
    by_cases hEmpty : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H))
    · rw [@Order.krullDim_eq_bot _ _ hEmpty, WithBot.bot_add]
      exact bot_le
    · have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)) :=
        not_isEmpty_iff.mp hEmpty
      let ι : ↥(Y₀ ∩ H) → ↥Y₀ := fun x => ⟨x.1, x.2.1⟩
      have hInj : Function.Injective ι := fun x₁ x₂ h =>
        Subtype.ext (congrArg (Subtype.val : ↥Y₀ → T) h)
      have hCont : Continuous ι := continuous_subtype_val.subtype_mk fun x => x.2.1
      have hClosedImg : ∀ Z : Set ↥(Y₀ ∩ H), IsClosed Z → IsClosed (ι '' Z) := by
        intro Z hZ
        rw [isClosed_induced_iff] at hZ
        obtain ⟨F, hClosedF, rfl⟩ := hZ
        have hEq : ι '' ((Subtype.val : ↥(Y₀ ∩ H) → T) ⁻¹' F) =
            (Subtype.val : ↥Y₀ → T) ⁻¹' (F ∩ H) := by
          ext y
          constructor
          · rintro ⟨x, hxF, rfl⟩
            exact ⟨hxF, x.2.2⟩
          · rintro ⟨hyF, hyH⟩
            exact ⟨⟨y.1, ⟨y.2, hyH⟩⟩, hyF, rfl⟩
        rw [hEq]
        exact (hClosedF.inter hClosedH).preimage continuous_subtype_val
      let Φ : TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H) →
          TopologicalSpace.IrreducibleCloseds ↥Y₀ :=
        fun C => ⟨ι '' (C : Set ↥(Y₀ ∩ H)),
          C.isIrreducible'.image ι hCont.continuousOn,
          hClosedImg C C.isClosed'⟩
      have hStrictMono : StrictMono Φ := by
        intro C₁ C₂ hlt
        refine lt_of_le_not_ge (Set.image_mono hlt.le) fun hge => hlt.not_ge ?_
        exact (Set.image_subset_image_iff hInj).mp hge
      have hLiftW : ∀ W ∈ S, IsClosed {y : ↥Y₀ | y.1 ∈ W} ∧ IsIrreducible {y : ↥Y₀ | y.1 ∈ W} := by
        intro W hW
        have hWY : W ⊆ Y₀ := fun x hx => by
          rw [hY₀]
          exact Set.mem_biUnion hW hx
        refine ⟨(hS W hW).1.preimage continuous_subtype_val, ?_⟩
        refine ⟨?_, ?_⟩
        · obtain ⟨x₀, hx₀⟩ := (hS W hW).2.nonempty
          exact ⟨⟨x₀, hWY hx₀⟩, hx₀⟩
        · rw [isPreirreducible_iff_isClosed_union_isClosed]
          intro z₁ z₂ hz₁ hz₂ hSub
          rw [isClosed_induced_iff] at hz₁ hz₂
          obtain ⟨F₁, hF₁, rfl⟩ := hz₁
          obtain ⟨F₂, hF₂, rfl⟩ := hz₂
          have hWSub : W ⊆ F₁ ∪ F₂ := fun x hx => hSub (a := ⟨x, hWY hx⟩) hx
          rcases (isPreirreducible_iff_isClosed_union_isClosed.mp (hS W hW).2.isPreirreducible)
              F₁ F₂ hF₁ hF₂ hWSub with h₁ | h₂
          · left
            exact fun y hy => h₁ hy
          · right
            exact fun y hy => h₂ hy
      have hExtend : ∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)),
          ∃ q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀),
            q.length = p.length + 1 := by
        intro p
        let p' : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀) :=
          ⟨p.length, fun i => Φ (p i), fun i => hStrictMono (p.step i)⟩
        let : DecidableEq (Set ↥Y₀) := Classical.decEq _
        let t_fin : Finset (Set ↥Y₀) := S.image fun W => {y : ↥Y₀ | y.1 ∈ W}
        have ht_closed : ∀ z ∈ t_fin, IsClosed z := by
          intro z hz
          obtain ⟨W, hW, rfl⟩ := Finset.mem_image.mp hz
          exact (hLiftW W hW).1
        have ht_cov : (p'.last : Set ↥Y₀) ⊆ ⋃₀ (t_fin : Set (Set ↥Y₀)) := by
          intro y _
          let y_val : T := y.1
          have hyY : y_val ∈ Y₀ := y.2
          rw [hY₀] at hyY
          obtain ⟨W, hW, hyW⟩ := Set.mem_iUnion₂.mp hyY
          exact ⟨{z : ↥Y₀ | z.1 ∈ W}, Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hW), hyW⟩
        obtain ⟨Z, hZt, hLastSub⟩ :=
          (isIrreducible_iff_sUnion_isClosed.mp p'.last.isIrreducible') t_fin ht_closed ht_cov
        obtain ⟨W, hW, rfl⟩ := Finset.mem_image.mp hZt
        let W_hat : TopologicalSpace.IrreducibleCloseds ↥Y₀ :=
          ⟨{y : ↥Y₀ | y.1 ∈ W}, (hLiftW W hW).2, (hLiftW W hW).1⟩
        have hWY : W ⊆ Y₀ := fun x hx => by
          rw [hY₀]
          exact Set.mem_biUnion hW hx
        obtain ⟨z, hzW, hzNotH⟩ := hAvoid W hW
        have h_lt : p'.last < W_hat := by
          refine lt_of_le_not_ge hLastSub fun hge => hzNotH ?_
          have hzLast : (⟨z, hWY hzW⟩ : ↥Y₀) ∈ (p'.last : Set ↥Y₀) := hge hzW
          change (⟨z, hWY hzW⟩ : ↥Y₀) ∈ ι '' (p.last : Set ↥(Y₀ ∩ H)) at hzLast
          obtain ⟨x, _, hxEq⟩ := hzLast
          have hVal : x.1 = z := congrArg (Subtype.val : ↥Y₀ → T) hxEq
          rw [← hVal]
          exact x.2.2
        exact ⟨p'.snoc W_hat h_lt, p'.snoc_length W_hat h_lt⟩
      obtain ⟨C₀⟩ := ‹Nonempty (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H))›
      let p₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)) :=
        RelSeries.singleton _ C₀
      obtain ⟨q₀, _⟩ := hExtend p₀
      have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥Y₀) := ⟨q₀.head⟩
      rw [Order.krullDim_eq_iSup_length, Order.krullDim_eq_iSup_length]
      change (↑(⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)),
          (p.length : ℕ∞)) : WithBot ℕ∞) + ↑(1 : ℕ∞) ≤
        ↑(⨆ q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀), (q.length : ℕ∞))
      rw [← WithBot.coe_add, WithBot.coe_le_coe]
      let M_sup : ℕ∞ :=
        ⨆ q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀), (q.length : ℕ∞)
      have hBound : ∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)),
          ((p.length + 1 : ℕ) : ℕ∞) ≤ M_sup := by
        intro p
        obtain ⟨q, hq⟩ := hExtend p
        rw [← hq]
        exact le_iSup (fun q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀) =>
          (q.length : ℕ∞)) q
      change (⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)),
          (p.length : ℕ∞)) + 1 ≤ M_sup
      cases hM : M_sup with
      | top => exact le_top
      | coe m =>
        have hm_pos : 1 ≤ m := by
          have h₀ : ((p₀.length + 1 : ℕ) : ℕ∞) ≤ (m : ℕ∞) := hM ▸ hBound p₀
          have h₀' : p₀.length + 1 ≤ m := Nat.cast_le.mp h₀
          omega
        have hSupLe : (⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)),
            (p.length : ℕ∞)) ≤ ((m - 1 : ℕ) : ℕ∞) := by
          refine iSup_le fun p => ?_
          have hp : ((p.length + 1 : ℕ) : ℕ∞) ≤ (m : ℕ∞) := hM ▸ hBound p
          have hp' : p.length + 1 ≤ m := Nat.cast_le.mp hp
          exact Nat.cast_le.mpr (by omega)
        have hAddLe : (⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H)),
            (p.length : ℕ∞)) + 1 ≤ ((m - 1 : ℕ) : ℕ∞) + 1 :=
          add_le_add hSupLe le_rfl
        have hEqM : ((m - 1 : ℕ) : ℕ∞) + 1 = (m : ℕ∞) := by
          exact_mod_cast (by omega : m - 1 + 1 = m)
        rwa [hEqM] at hAddLe
  have hClosedHyp : ∀ F : MvPolynomial (Fin (N + 1)) k, IsClosed (weilProjHyperplaneSet k N F) := by
    intro F
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    exact (AlgebraicGeometry.Proj.basicOpen 𝒜 F).isOpen.isClosed_compl
  have hDecomp : ∀ a : Fin p, ∃ S : Finset (Set (weilProjectiveSpaceOver k N).left),
      (∀ W ∈ S, IsClosed W ∧ IsIrreducible W) ∧ Y a = ⋃ W ∈ S, W := by
    intro a
    obtain ⟨S_set, hFin, hClS, hIrrS, hEqS⟩ :=
      @TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible _ _ hNoeth _ (hClosedY a)
    refine ⟨hFin.toFinset, ?_, ?_⟩
    · intro W hW
      rw [Set.Finite.mem_toFinset] at hW
      exact ⟨hClS W hW, hIrrS W hW⟩
    · rw [hEqS, Set.sUnion_eq_biUnion]
      simp only [Set.Finite.mem_toFinset]
  choose S_fin hS_props hS_eq using hDecomp
  choose L_pt hL_pt_ne hL_pt_avoid using hAvoidPt
  let y_wit : ∀ (a : Fin p) (W : ↥(S_fin a)), (weilProjectiveSpaceOver k N).left :=
    fun a W => ((hS_props a W.1 W.2).2.nonempty).some
  let hy_mem : ∀ (a : Fin p) (W : ↥(S_fin a)), y_wit a W ∈ W.1 :=
    fun a W => ((hS_props a W.1 W.2).2.nonempty).some_mem
  let Δ_closed : MvPolynomial (Fin (N + 1)) k :=
    ∏ a : Fin p, ∏ W ∈ (S_fin a).attach, L_pt (y_wit a W)
  have hΔ_ne : Δ_closed ≠ 0 := by
    refine Finset.prod_ne_zero_iff.mpr fun a _ => ?_
    exact Finset.prod_ne_zero_iff.mpr fun W _ => hL_pt_ne (y_wit a W)
  refine ⟨Δ_closed, hΔ_ne, ?_⟩
  intro c hc a
  have hc_a : ∏ W ∈ (S_fin a).attach, MvPolynomial.eval c (L_pt (y_wit a W)) ≠ 0 := by
    rw [← map_prod]
    rw [map_prod, Finset.prod_ne_zero_iff] at hc
    exact hc a (Finset.mem_univ a)
  rw [Finset.prod_ne_zero_iff] at hc_a
  refine hKrullDrop (weilProjectiveSpaceOver k N).left (Y a)
    (weilProjHyperplaneSet k N (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i))
    (hClosedHyp _) (S_fin a) (hS_props a) (hS_eq a) ?_
  intro W hW
  have hc_W : MvPolynomial.eval c (L_pt (y_wit a ⟨W, hW⟩)) ≠ 0 :=
    hc_a ⟨W, hW⟩ (Finset.mem_attach _ ⟨W, hW⟩)
  exact ⟨y_wit a ⟨W, hW⟩, hy_mem a ⟨W, hW⟩, hL_pt_avoid (y_wit a ⟨W, hW⟩) c hc_W⟩

theorem weil_bertini_tangent_frame_and_schur_det (k : Type u) [Field k] (N s ν d : ℕ)
    (R : Type u) [CommRing R]
    (φ : MvPolynomial (Fin (s + ν + d)) k →+* R) :
    Function.Surjective φ →
    ∀ (q : Fin s → MvPolynomial (Fin (s + ν + d)) k),
    RingHom.ker φ = Ideal.span (Set.range q) →
    ∀ (f_lift : Fin ν → MvPolynomial (Fin (s + ν + d)) k),
    IsUnit (Matrix.det (Matrix.of fun a b : Fin (s + ν) =>
      φ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q f_lift a)))) →
    ∀ (α₀ : Fin (N + 1))
      (x_coord : Fin N → R)
      (P_h : MvPolynomial (Fin N) k),
    IsUnit (MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord P_h) →
    (∀ r : R, ∃ (e : ℕ) (A : MvPolynomial (Fin N) k),
      r * (MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord P_h) ^ e =
        MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord A) →
    ∃ (Ψ : Fin N → MvPolynomial (Fin (s + ν + d)) k)
      (v : Matrix (Fin N) (Fin d) R)
      (U : Matrix (Fin d) (Fin N)
        (R ⧸ Ideal.span (Set.range (fun j : Fin ν => φ (f_lift j))))),
      (∀ m : Fin N, φ (Ψ m) = x_coord m) ∧
      U * v.map (Ideal.Quotient.mk
        (Ideal.span (Set.range (fun j : Fin ν => φ (f_lift j))))) = 1 ∧
      ∀ (c : Fin (N + 1) → k) (γ₀ : Fin d),
        Matrix.det (Matrix.of fun a b : Fin (s + ν + 1) =>
          φ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (s + ν + d)) (Fin.castAdd d) (Fin.natAdd (s + ν) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + ν + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + ν + d)) k) q f_lift)
              (MvPolynomial.C (c α₀) +
                ∑ m : Fin N, MvPolynomial.C (c (α₀.succAbove m)) * Ψ m) a))) =
          Matrix.det (Matrix.of fun a b : Fin (s + ν) =>
            φ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q f_lift a))) *
            ∑ m : Fin N, φ (MvPolynomial.C (c (α₀.succAbove m))) * v m γ₀ :=
by
  intro hSurj q hKer f_lift hDet α₀ x_coord P_h hUnit_h hLoc
  let P := MvPolynomial (Fin (s + ν + d)) k
  choose Ψ hΨ using fun m : Fin N => hSurj (x_coord m)
  let H : Fin (s + ν) → P := Fin.addCases (motive := fun _ => P) q f_lift
  let M₀ : Matrix (Fin (s + ν)) (Fin (s + ν)) R :=
    Matrix.of fun a b : Fin (s + ν) => φ (MvPolynomial.pderiv (Fin.castAdd d b) (H a))
  let M₁ : Matrix (Fin (s + ν)) (Fin d) R :=
    Matrix.of fun (a : Fin (s + ν)) (γ : Fin d) =>
      φ (MvPolynomial.pderiv (Fin.natAdd (s + ν) γ) (H a))
  let T : Matrix (Fin (s + ν + d)) (Fin d) R :=
    Matrix.of fun (β : Fin (s + ν + d)) (γ : Fin d) =>
      Fin.addCases (motive := fun _ => R)
        (fun b => -(M₀⁻¹ * M₁) b γ)
        (fun γ' => (1 : Matrix (Fin d) (Fin d) R) γ' γ) β
  let D_op : Fin d → P → R := fun γ F =>
    ∑ β : Fin (s + ν + d), φ (MvPolynomial.pderiv β F) * T β γ
  let v : Matrix (Fin N) (Fin d) R :=
    Matrix.of fun (m : Fin N) (γ : Fin d) => D_op γ (Ψ m)

  have hDet_M₀ : IsUnit M₀.det := hDet
  have hM₀_mul_inv : M₀ * M₀⁻¹ = 1 := Matrix.mul_nonsing_inv M₀ hDet_M₀

  have D_C : ∀ (γ : Fin d) (a : k), D_op γ (MvPolynomial.C a) = 0 := by
    intro γ a
    simp [D_op]

  have D_zero : ∀ (γ : Fin d), D_op γ 0 = 0 := by
    intro γ
    simpa using D_C γ 0

  have D_one : ∀ (γ : Fin d), D_op γ 1 = 0 := by
    intro γ
    simpa using D_C γ 1

  have D_add : ∀ (γ : Fin d) (F G : P), D_op γ (F + G) = D_op γ F + D_op γ G := by
    intro γ F G
    simp only [D_op, map_add, add_mul, Finset.sum_add_distrib]

  have D_sub : ∀ (γ : Fin d) (F G : P), D_op γ (F - G) = D_op γ F - D_op γ G := by
    intro γ F G
    simp only [D_op, map_sub, sub_mul, Finset.sum_sub_distrib]

  have D_sum : ∀ (γ : Fin d) (s_fin : Finset (Fin N)) (g : Fin N → P),
      D_op γ (∑ i ∈ s_fin, g i) = ∑ i ∈ s_fin, D_op γ (g i) := by
    intro γ s_fin g
    induction s_fin using Finset.induction_on with
    | empty => simp [D_zero]
    | insert _ _ hnot ih => simp [Finset.sum_insert hnot, D_add, ih]

  have D_split : ∀ (γ : Fin d) (F : P),
      D_op γ F =
        (∑ b : Fin (s + ν), φ (MvPolynomial.pderiv (Fin.castAdd d b) F) * T (Fin.castAdd d b) γ) +
        (∑ γ' : Fin d, φ (MvPolynomial.pderiv (Fin.natAdd (s + ν) γ') F) * T (Fin.natAdd (s + ν) γ') γ) :=
    fun γ F => Fin.sum_univ_add (fun β : Fin ((s + ν) + d) => φ (MvPolynomial.pderiv β F) * T β γ)

  have D_mul : ∀ (γ : Fin d) (F G : P),
      D_op γ (F * G) = φ F * D_op γ G + φ G * D_op γ F := by
    intro γ F G
    have hterm : ∀ β : Fin (s + ν + d),
        φ (MvPolynomial.pderiv β (F * G)) * T β γ =
          φ F * (φ (MvPolynomial.pderiv β G) * T β γ) +
            φ G * (φ (MvPolynomial.pderiv β F) * T β γ) := by
      intro β
      rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul]
      ring
    simp_rw [D_op, hterm, Finset.sum_add_distrib, ← Finset.mul_sum]

  have D_X : ∀ (γ : Fin d) (β₀ : Fin (s + ν + d)),
      D_op γ (MvPolynomial.X β₀) = T β₀ γ := by
    intro γ β₀
    dsimp only [D_op]
    rw [Finset.sum_eq_single β₀]
    · rw [MvPolynomial.pderiv_X_self, map_one, one_mul]
    · intro β _ hne
      rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hne), map_zero, zero_mul]
    · intro hnot
      exact absurd (Finset.mem_univ β₀) hnot

  have D_pow_inv : ∀ (γ : Fin d) (F : P) (h_inv : R),
      φ F * h_inv = 1 →
      ∀ (e : ℕ), h_inv ^ e * D_op γ (F ^ e) = (e : R) * h_inv * D_op γ F := by
    intro γ F h_inv hh e
    have hh' : h_inv * φ F = 1 := by rw [mul_comm]; exact hh
    induction e with
    | zero =>
      simp [D_one]
    | succ n ih =>
      have hpow1 : h_inv ^ n * (φ F) ^ n = 1 := by
        rw [← mul_pow, hh', one_pow]
      calc h_inv ^ (n + 1) * D_op γ (F ^ (n + 1))
          = (h_inv ^ n * h_inv) * D_op γ (F ^ n * F) := by
              rw [pow_succ, pow_succ]
        _ = (h_inv ^ n * h_inv) * (φ (F ^ n) * D_op γ F + φ F * D_op γ (F ^ n)) := by
              rw [D_mul]
        _ = (h_inv ^ n * (φ F) ^ n) * h_inv * D_op γ F +
              (h_inv * φ F) * (h_inv ^ n * D_op γ (F ^ n)) := by
              rw [map_pow]
              ring
        _ = 1 * h_inv * D_op γ F + 1 * ((n : R) * h_inv * D_op γ F) := by
              rw [hpow1, hh', ih]
        _ = ((n + 1 : ℕ) : R) * h_inv * D_op γ F := by
              push_cast
              ring

  have D_H : ∀ (γ : Fin d) (a : Fin (s + ν)), D_op γ (H a) = 0 := by
    intro γ a
    rw [D_split]
    have h1 : (∑ b : Fin (s + ν),
        φ (MvPolynomial.pderiv (Fin.castAdd d b) (H a)) * T (Fin.castAdd d b) γ) =
        - M₁ a γ := by
      have hsub : ∀ b : Fin (s + ν),
          φ (MvPolynomial.pderiv (Fin.castAdd d b) (H a)) * T (Fin.castAdd d b) γ =
            -(M₀ a b * (M₀⁻¹ * M₁) b γ) := by
        intro b
        simp only [M₀, T, Matrix.of_apply, Fin.addCases_left, mul_neg]
      simp_rw [hsub, Finset.sum_neg_distrib]
      have hmul : (∑ b : Fin (s + ν), M₀ a b * (M₀⁻¹ * M₁) b γ) = M₁ a γ := by
        change (M₀ * (M₀⁻¹ * M₁)) a γ = M₁ a γ
        rw [← Matrix.mul_assoc, hM₀_mul_inv, Matrix.one_mul]
      rw [hmul]
    have h2 : (∑ γ' : Fin d,
        φ (MvPolynomial.pderiv (Fin.natAdd (s + ν) γ') (H a)) * T (Fin.natAdd (s + ν) γ') γ) =
        M₁ a γ := by
      have hsub : ∀ γ' : Fin d,
          φ (MvPolynomial.pderiv (Fin.natAdd (s + ν) γ') (H a)) * T (Fin.natAdd (s + ν) γ') γ =
            M₁ a γ' * (1 : Matrix (Fin d) (Fin d) R) γ' γ := by
        intro γ'
        simp only [M₁, T, Matrix.of_apply, Fin.addCases_right]
      simp_rw [hsub]
      change (M₁ * (1 : Matrix (Fin d) (Fin d) R)) a γ = M₁ a γ
      rw [Matrix.mul_one]
    rw [h1, h2, neg_add_cancel]

  have D_ker : ∀ (γ : Fin d) {F : P}, F ∈ RingHom.ker φ → D_op γ F = 0 := by
    intro γ F hF
    rw [hKer] at hF
    induction hF using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      have hqi : q i = H (Fin.castAdd ν i) := by
        simp only [H, Fin.addCases_left]
      rw [hqi]
      exact D_H γ (Fin.castAdd ν i)
    | zero =>
      exact D_zero γ
    | add x y _ _ ihx ihy =>
      rw [D_add, ihx, ihy, add_zero]
    | smul a x hx ihx =>
      have hx_ker : x ∈ RingHom.ker φ := hKer.symm ▸ hx
      have hφx : φ x = 0 := RingHom.mem_ker.mp hx_ker
      change D_op γ (a * x) = 0
      rw [D_mul, ihx, hφx, mul_zero, zero_mul, add_zero]

  have φ_eval₂ : ∀ (P₀ : MvPolynomial (Fin N) k),
      φ (MvPolynomial.eval₂ MvPolynomial.C Ψ P₀) =
        MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord P₀ := by
    intro P₀
    have hcomp : (fun i => φ (Ψ i)) = x_coord := funext hΨ
    rw [MvPolynomial.hom_eval₂, hcomp]

  have D_eval₂ : ∀ (γ : Fin d) (P₀ : MvPolynomial (Fin N) k),
      D_op γ (MvPolynomial.eval₂ MvPolynomial.C Ψ P₀) =
        ∑ m : Fin N,
          MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord (MvPolynomial.pderiv m P₀) * v m γ := by
    intro γ P₀
    refine MvPolynomial.induction_on
      (motive := fun Q => D_op γ (MvPolynomial.eval₂ MvPolynomial.C Ψ Q) =
        ∑ m : Fin N,
          MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord (MvPolynomial.pderiv m Q) * v m γ)
      P₀ (fun a => ?_) (fun P₁ P₂ ih₁ ih₂ => ?_) (fun P₁ n ih => ?_)
    · simp [MvPolynomial.eval₂_C, D_C]
    · simp only [MvPolynomial.eval₂_add, D_add, map_add, add_mul, Finset.sum_add_distrib, ih₁, ih₂]
    · rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, D_mul, φ_eval₂ P₁, hΨ n, ih]
      have hvn : D_op γ (Ψ n) = v n γ := rfl
      rw [hvn]
      have hrhs : (∑ m : Fin N,
          MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord
            (MvPolynomial.pderiv m (P₁ * MvPolynomial.X n)) * v m γ) =
          (∑ m : Fin N,
            MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord (MvPolynomial.pderiv m P₁) *
              x_coord n * v m γ) +
          (∑ m : Fin N,
            MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord P₁ *
              MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord
                (MvPolynomial.pderiv m (MvPolynomial.X n)) * v m γ) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [MvPolynomial.pderiv_mul, MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul,
          MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
        ring
      rw [hrhs]
      have hsum1 : (∑ m : Fin N,
          MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord (MvPolynomial.pderiv m P₁) *
            x_coord n * v m γ) =
          x_coord n * ∑ m : Fin N,
            MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord (MvPolynomial.pderiv m P₁) *
              v m γ := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun m _ => by ring
      have hsum2 : (∑ m : Fin N,
          MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord P₁ *
            MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord
              (MvPolynomial.pderiv m (MvPolynomial.X n)) * v m γ) =
          MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord P₁ * v n γ := by
        rw [Finset.sum_eq_single n]
        · rw [MvPolynomial.pderiv_X_self, MvPolynomial.eval₂_one, mul_one]
        · intro m _ hne
          rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hne), MvPolynomial.eval₂_zero, mul_zero, zero_mul]
        · intro hnot
          exact absurd (Finset.mem_univ n) hnot
      rw [hsum1, hsum2, add_comm]

  let h_val : R := MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord P_h
  obtain ⟨h_inv, hh_inv⟩ := hUnit_h.exists_right_inv
  have hh_inv' : h_inv * h_val = 1 := by rw [mul_comm]; exact hh_inv
  let F_h : P := MvPolynomial.eval₂ MvPolynomial.C Ψ P_h
  have hφ_Fh : φ F_h = h_val := φ_eval₂ P_h
  have hFh_inv : φ F_h * h_inv = 1 := by rw [hφ_Fh]; exact hh_inv

  let y_free : Fin d → R := fun γ => φ (MvPolynomial.X (Fin.natAdd (s + ν) γ))
  choose e_exp A_poly hLoc_eq using fun γ : Fin d => hLoc (y_free γ)

  let Q_rel : Fin d → P := fun γ =>
    MvPolynomial.X (Fin.natAdd (s + ν) γ) * F_h ^ e_exp γ -
      MvPolynomial.eval₂ MvPolynomial.C Ψ (A_poly γ)

  have hQ_ker : ∀ γ : Fin d, Q_rel γ ∈ RingHom.ker φ := by
    intro γ
    rw [RingHom.mem_ker]
    dsimp only [Q_rel]
    rw [map_sub, map_mul, map_pow, hφ_Fh, φ_eval₂ (A_poly γ)]
    exact sub_eq_zero.mpr (hLoc_eq γ)

  let U₀ : Matrix (Fin d) (Fin N) R :=
    Matrix.of fun (γ : Fin d) (m : Fin N) =>
      h_inv ^ e_exp γ *
        MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord (MvPolynomial.pderiv m (A_poly γ)) -
      y_free γ * (e_exp γ : R) * h_inv *
        MvPolynomial.eval₂ (φ.comp MvPolynomial.C) x_coord (MvPolynomial.pderiv m P_h)

  have hU₀v : U₀ * v = 1 := by
    ext γ γ'
    have hDQ := D_ker γ' (hQ_ker γ)
    dsimp only [Q_rel] at hDQ
    rw [D_sub] at hDQ
    have hEq1 : D_op γ' (MvPolynomial.X (Fin.natAdd (s + ν) γ) * F_h ^ e_exp γ) =
        D_op γ' (MvPolynomial.eval₂ MvPolynomial.C Ψ (A_poly γ)) :=
      sub_eq_zero.mp hDQ
    rw [D_mul, D_X, map_pow, hφ_Fh] at hEq1
    have hT_free : T (Fin.natAdd (s + ν) γ) γ' = (1 : Matrix (Fin d) (Fin d) R) γ γ' := by
      simp only [T, Matrix.of_apply, Fin.addCases_right]
    rw [hT_free] at hEq1
    have hMul := congrArg (fun z => h_inv ^ e_exp γ * z) hEq1
    have hLhs : h_inv ^ e_exp γ *
        (y_free γ * D_op γ' (F_h ^ e_exp γ) +
          h_val ^ e_exp γ * (1 : Matrix (Fin d) (Fin d) R) γ γ') =
        y_free γ * (e_exp γ : R) * h_inv * D_op γ' F_h +
          (1 : Matrix (Fin d) (Fin d) R) γ γ' := by
      have hpow_cancel : h_inv ^ e_exp γ * h_val ^ e_exp γ = 1 := by
        rw [← mul_pow, hh_inv', one_pow]
      calc h_inv ^ e_exp γ *
            (y_free γ * D_op γ' (F_h ^ e_exp γ) +
              h_val ^ e_exp γ * (1 : Matrix (Fin d) (Fin d) R) γ γ')
          = y_free γ * (h_inv ^ e_exp γ * D_op γ' (F_h ^ e_exp γ)) +
              (h_inv ^ e_exp γ * h_val ^ e_exp γ) * (1 : Matrix (Fin d) (Fin d) R) γ γ' := by
              ring
        _ = y_free γ * ((e_exp γ : R) * h_inv * D_op γ' F_h) +
              1 * (1 : Matrix (Fin d) (Fin d) R) γ γ' := by
              rw [D_pow_inv γ' F_h h_inv hFh_inv (e_exp γ), hpow_cancel]
        _ = y_free γ * (e_exp γ : R) * h_inv * D_op γ' F_h +
              (1 : Matrix (Fin d) (Fin d) R) γ γ' := by
              ring
    rw [hLhs] at hMul
    have hIsolate : (1 : Matrix (Fin d) (Fin d) R) γ γ' =
        h_inv ^ e_exp γ * D_op γ' (MvPolynomial.eval₂ MvPolynomial.C Ψ (A_poly γ)) -
          y_free γ * (e_exp γ : R) * h_inv * D_op γ' F_h := by
      rw [← hMul]
      ring
    rw [hIsolate]
    dsimp only [F_h]
    rw [D_eval₂ γ' (A_poly γ), D_eval₂ γ' P_h, Finset.mul_sum, Finset.mul_sum,
      ← Finset.sum_sub_distrib, Matrix.mul_apply]
    refine Finset.sum_congr rfl fun m _ => ?_
    simp only [U₀, Matrix.of_apply]
    ring

  let I_sl : Ideal R := Ideal.span (Set.range (fun j : Fin ν => φ (f_lift j)))
  let π_S : R →+* R ⧸ I_sl := Ideal.Quotient.mk I_sl
  let U : Matrix (Fin d) (Fin N) (R ⧸ I_sl) := U₀.map π_S

  have hUv : U * v.map π_S = 1 := by
    ext γ γ'
    simp only [U, Matrix.mul_apply, Matrix.map_apply, ← map_mul, ← map_sum]
    have hEntry : (∑ m : Fin N, U₀ γ m * v m γ') = (1 : Matrix (Fin d) (Fin d) R) γ γ' := by
      rw [← Matrix.mul_apply, hU₀v]
    rw [hEntry]
    by_cases h : γ = γ' <;> simp [Matrix.one_apply, h]

  have hSchur : ∀ (c : Fin (N + 1) → k) (γ₀ : Fin d),
      Matrix.det (Matrix.of fun a b : Fin (s + ν + 1) =>
        φ (MvPolynomial.pderiv
          (Fin.snoc (α := fun _ => Fin (s + ν + d)) (Fin.castAdd d) (Fin.natAdd (s + ν) γ₀) b)
          (Fin.snoc (α := fun _ => P) H
            (MvPolynomial.C (c α₀) +
              ∑ m : Fin N, MvPolynomial.C (c (α₀.succAbove m)) * Ψ m) a))) =
        M₀.det * ∑ m : Fin N, φ (MvPolynomial.C (c (α₀.succAbove m))) * v m γ₀ := by
    intro c γ₀
    let f_new : P :=
      MvPolynomial.C (c α₀) + ∑ m : Fin N, MvPolynomial.C (c (α₀.succAbove m)) * Ψ m
    let M_aug : Matrix (Fin (s + ν + 1)) (Fin (s + ν + 1)) R :=
      Matrix.of fun a b : Fin (s + ν + 1) =>
        φ (MvPolynomial.pderiv
          (Fin.snoc (α := fun _ => Fin (s + ν + d)) (Fin.castAdd d) (Fin.natAdd (s + ν) γ₀) b)
          (Fin.snoc (α := fun _ => P) H f_new a))
    let e_blk : Fin (s + ν) ⊕ Unit ≃ Fin (s + ν + 1) :=
      { toFun := Sum.elim Fin.castSucc (fun _ => Fin.last (s + ν))
        invFun := Fin.lastCases (Sum.inr ()) Sum.inl
        left_inv := by
          rintro (a | ⟨⟩) <;> simp
        right_inv := by
          refine Fin.lastCases ?_ (fun a => ?_) <;> simp }
    let B : Matrix (Fin (s + ν)) Unit R :=
      Matrix.of fun (a : Fin (s + ν)) (_ : Unit) => M₁ a γ₀
    let C_blk : Matrix Unit (Fin (s + ν)) R :=
      Matrix.of fun (_ : Unit) (b : Fin (s + ν)) =>
        φ (MvPolynomial.pderiv (Fin.castAdd d b) f_new)
    let D_blk : Matrix Unit Unit R :=
      Matrix.of fun (_ _ : Unit) =>
        φ (MvPolynomial.pderiv (Fin.natAdd (s + ν) γ₀) f_new)

    have hReindex : Matrix.reindex e_blk.symm e_blk.symm M_aug =
        Matrix.fromBlocks M₀ B C_blk D_blk := by
      ext (a | ⟨⟩) (b | ⟨⟩)
      · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, M_aug, M₀]
      · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, M_aug, B, M₁]
      · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, M_aug, C_blk]
      · simp [Matrix.reindex_apply, Matrix.submatrix_apply, e_blk, M_aug, D_blk]

    let : Invertible M₀ := Matrix.invertibleOfIsUnitDet M₀ hDet_M₀
    have hDet1 : M_aug.det = M₀.det * (D_blk - C_blk * M₀⁻¹ * B).det := by
      rw [← Matrix.det_reindex_self e_blk.symm M_aug, hReindex,
        Matrix.det_fromBlocks₁₁ M₀ B C_blk D_blk, Matrix.invOf_eq_nonsing_inv M₀]

    have hDet_1x1 : (D_blk - C_blk * M₀⁻¹ * B).det = D_op γ₀ f_new := by
      rw [Matrix.det_unique (D_blk - C_blk * M₀⁻¹ * B)]
      change (D_blk - C_blk * M₀⁻¹ * B) () () = D_op γ₀ f_new
      rw [Matrix.sub_apply, Matrix.mul_assoc]
      have hCMB : (C_blk * (M₀⁻¹ * B)) () () =
          ∑ b : Fin (s + ν),
            φ (MvPolynomial.pderiv (Fin.castAdd d b) f_new) * (M₀⁻¹ * M₁) b γ₀ := by
        rw [Matrix.mul_apply]
        refine Finset.sum_congr rfl fun b _ => ?_
        have hMB : (M₀⁻¹ * B) b () = (M₀⁻¹ * M₁) b γ₀ := by
          simp only [Matrix.mul_apply, B, Matrix.of_apply]
        rw [hMB]
        rfl
      rw [hCMB, D_split]
      have hS1 : (∑ b : Fin (s + ν),
          φ (MvPolynomial.pderiv (Fin.castAdd d b) f_new) * T (Fin.castAdd d b) γ₀) =
          -(∑ b : Fin (s + ν),
            φ (MvPolynomial.pderiv (Fin.castAdd d b) f_new) * (M₀⁻¹ * M₁) b γ₀) := by
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun b _ => ?_
        simp only [T, Matrix.of_apply, Fin.addCases_left, mul_neg]
      have hS2 : (∑ γ' : Fin d,
          φ (MvPolynomial.pderiv (Fin.natAdd (s + ν) γ') f_new) * T (Fin.natAdd (s + ν) γ') γ₀) =
          D_blk () () := by
        rw [Finset.sum_eq_single γ₀]
        · simp only [T, D_blk, Matrix.of_apply, Fin.addCases_right, Matrix.one_apply_eq, mul_one]
        · intro γ' _ hne
          simp only [T, Matrix.of_apply, Fin.addCases_right, Matrix.one_apply_ne hne, mul_zero]
        · intro hnot
          exact absurd (Finset.mem_univ γ₀) hnot
      rw [hS1, hS2]
      ring

    have hDf_new : D_op γ₀ f_new =
        ∑ m : Fin N, φ (MvPolynomial.C (c (α₀.succAbove m))) * v m γ₀ := by
      dsimp only [f_new]
      rw [D_add, D_C, zero_add, D_sum γ₀ Finset.univ (fun m => MvPolynomial.C (c (α₀.succAbove m)) * Ψ m)]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [D_mul, D_C, mul_zero, add_zero]
      rfl

    change M_aug.det = M₀.det * ∑ m : Fin N, φ (MvPolynomial.C (c (α₀.succAbove m))) * v m γ₀
    rw [hDet1, hDet_1x1, hDf_new]

  exact ⟨Ψ, v, U, hΨ, hUv, hSchur⟩

theorem weil_bertini_trdeg_bad_incidence_eliminant (k : Type u) [Field k] (N r d : ℕ)
    (S : Type u) [CommRing S]
    (ψ : MvPolynomial (Fin (r + d)) k →+* S) :
    Function.Surjective ψ →
    ∀ (H : Fin r → MvPolynomial (Fin (r + d)) k),
    (∀ a : Fin r, ψ (H a) = 0) →
    IsUnit (Matrix.det (Matrix.of fun a b : Fin r =>
      ψ (MvPolynomial.pderiv (Fin.castAdd d b) (H a)))) →
    ∀ (α₀ : Fin (N + 1))
      (x_bar : Fin N → S)
      (v_bar : Matrix (Fin N) (Fin d) S)
      (U_bar : Matrix (Fin d) (Fin N) S),
    U_bar * v_bar = 1 →
    ∃ Δ_S : MvPolynomial (Fin (N + 1)) k,
      Δ_S ≠ 0 ∧
      ∀ (c : Fin (N + 1) → k) (𝔮 : PrimeSpectrum S),
        MvPolynomial.eval c Δ_S ≠ 0 →
        ψ (MvPolynomial.C (c α₀)) +
          ∑ m : Fin N, ψ (MvPolynomial.C (c (α₀.succAbove m))) * x_bar m ∈ 𝔮.asIdeal →
        ∃ γ₀ : Fin d,
          ∑ m : Fin N, ψ (MvPolynomial.C (c (α₀.succAbove m))) * v_bar m γ₀ ∉ 𝔮.asIdeal :=
by
  intro hSurj H hVanish hDet α₀ x_bar v_bar U_bar hUv
  let κ : k →+* S := ψ.comp MvPolynomial.C

  
  have h_jacobian_etale :
      ∀ (F_q : Type u) [Field F_q] [Algebra k F_q] (σ_Fq : S →+* F_q),
        (∀ a : k, σ_Fq (κ a) = algebraMap k F_q a) →
        (∀ z : F_q, ∃ u v : S, σ_Fq v ≠ 0 ∧ z * σ_Fq v = σ_Fq u) →
        Algebra.trdeg k F_q ≤ (d : Cardinal.{u}) := by
    intro F_q _ _ σ_Fq hσ_κ hσ_frac
    let ψ_bar : MvPolynomial (Fin (r + d)) k →ₐ[k] F_q :=
      { toRingHom := σ_Fq.comp ψ
        commutes' := fun a => hσ_κ a }
    let y_raw : Fin d → F_q := fun γ => ψ_bar (MvPolynomial.X (Fin.natAdd r γ))
    let z_dep : Fin r → F_q := fun b => ψ_bar (MvPolynomial.X (Fin.castAdd d b))
    let Φ_free : MvPolynomial (Fin d) k →ₐ[k] F_q := MvPolynomial.aeval y_raw
    let A_free : Subalgebra k F_q := Φ_free.range
    have hTrdegAfree : Algebra.trdeg k ↥A_free ≤ (d : Cardinal.{u}) := by
      calc Algebra.trdeg k ↥A_free
          ≤ Algebra.trdeg k (MvPolynomial (Fin d) k) :=
            trdeg_le_of_surjective Φ_free.rangeRestrict Φ_free.rangeRestrict_surjective
        _ = (d : Cardinal.{u}) := by
            rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
    have h_from_E0 :
        ∀ (E₀ : Type u) [Field E₀] [Algebra k E₀] [Algebra ↥A_free E₀]
          [IsScalarTower k ↥A_free E₀] [IsFractionRing ↥A_free E₀]
          [Module.IsTorsionFree ↥A_free E₀],
          Algebra.trdeg k F_q ≤ (d : Cardinal.{u}) := by
      intro E₀ _ _ _ _ _ _
      have : Algebra.IsAlgebraic ↥A_free E₀ :=
        (IsFractionRing.isAlgebraic_iff' ↥A_free ↥A_free E₀).mp Algebra.IsIntegral.isAlgebraic
      have : FaithfulSMul ↥A_free E₀ :=
        ⟨fun h => (IsFractionRing.injective ↥A_free E₀) (by simpa [Algebra.smul_def] using h 1)⟩
      have hTrdegE0 : Algebra.trdeg k E₀ ≤ (d : Cardinal.{u}) := by
        have h0 : Algebra.trdeg ↥A_free E₀ = 0 := trdeg_eq_zero
        have h_add := trdeg_add_eq k ↥A_free (A := E₀)
        rw [h0, add_zero] at h_add
        rwa [← h_add]
      let j_E0 : E₀ →+* F_q :=
        IsFractionRing.lift (g := A_free.val.toRingHom) Subtype.coe_injective
      let : Algebra E₀ F_q := j_E0.toAlgebra
      have : IsScalarTower k E₀ F_q := by
        refine IsScalarTower.of_algebraMap_eq' ?_
        ext a
        change algebraMap k F_q a = j_E0 (algebraMap k E₀ a)
        rw [IsScalarTower.algebraMap_apply k ↥A_free E₀ a]
        exact (IsFractionRing.lift_algebraMap (g := A_free.val.toRingHom)
          Subtype.coe_injective (algebraMap k ↥A_free a)).symm
      have hy_mem : ∀ γ : Fin d, y_raw γ ∈ A_free :=
        fun γ => Φ_free.mem_range.mpr ⟨MvPolynomial.X γ, MvPolynomial.aeval_X y_raw γ⟩
      let y_free : Fin d → E₀ := fun γ => algebraMap ↥A_free E₀ ⟨y_raw γ, hy_mem γ⟩
      have hy_free : algebraMap E₀ F_q ∘ y_free = y_raw := by
        ext γ
        exact IsFractionRing.lift_algebraMap (g := A_free.val.toRingHom)
          Subtype.coe_injective ⟨y_raw γ, hy_mem γ⟩
      let e_sum : Fin r ⊕ Fin d ≃ Fin (r + d) := finSumFinEquiv
      have hψ_aeval : MvPolynomial.aeval (Sum.elim z_dep y_raw ∘ e_sum.symm) = ψ_bar := by
        apply MvPolynomial.algHom_ext
        intro idx
        obtain ⟨s, rfl⟩ := e_sum.surjective idx
        rw [MvPolynomial.aeval_X, Function.comp_apply, Equiv.symm_apply_apply]
        cases s with
        | inl b =>
          change z_dep b = ψ_bar (MvPolynomial.X (finSumFinEquiv (Sum.inl b)))
          rw [finSumFinEquiv_apply_left]
        | inr γ =>
          change y_raw γ = ψ_bar (MvPolynomial.X (finSumFinEquiv (Sum.inr γ)))
          rw [finSumFinEquiv_apply_right]
      let H_sum : Fin r → MvPolynomial (Fin r ⊕ Fin d) k :=
        fun a => MvPolynomial.rename e_sum.symm (H a)
      let H_E0 : Fin r → MvPolynomial (Fin r) E₀ :=
        fun a => MvPolynomial.aeval (Sum.elim MvPolynomial.X (MvPolynomial.C ∘ y_free)) (H_sum a)
      have hHE0_zero : ∀ a : Fin r, (MvPolynomial.aeval z_dep) (H_E0 a) = 0 := by
        intro a
        dsimp only [H_E0]
        rw [← MvPolynomial.aeval_sumElim (H_sum a) y_free z_dep, hy_free]
        dsimp only [H_sum]
        rw [MvPolynomial.aeval_rename, hψ_aeval]
        change σ_Fq (ψ (H a)) = 0
        rw [hVanish a, map_zero]
      have hHE0_pderiv : ∀ i j : Fin r,
          (MvPolynomial.aeval z_dep) (MvPolynomial.pderiv i (H_E0 j)) =
            ψ_bar (MvPolynomial.pderiv (Fin.castAdd d i) (H j)) := by
        intro i j
        dsimp only [H_E0]
        rw [← MvPolynomial.aeval_sumElim_pderiv_inl (H_sum j) y_free i,
          ← MvPolynomial.aeval_sumElim _ y_free z_dep, hy_free]
        have hinl : (Sum.inl i : Fin r ⊕ Fin d) = e_sum.symm (Fin.castAdd d i) :=
          (finSumFinEquiv_symm_apply_castAdd i).symm
        rw [hinl]
        dsimp only [H_sum]
        rw [MvPolynomial.pderiv_rename e_sum.symm.injective, MvPolynomial.aeval_rename, hψ_aeval]
      let J_E0 : Matrix (Fin r) (Fin r) (MvPolynomial (Fin r) E₀) :=
        Matrix.of fun i j => MvPolynomial.pderiv i (H_E0 j)
      let D_jac : MvPolynomial (Fin r) E₀ := J_E0.det
      have hDjac_ne : (MvPolynomial.aeval z_dep) D_jac ≠ 0 := by
        have hmap : (MvPolynomial.aeval z_dep) D_jac =
            σ_Fq (Matrix.det (Matrix.of fun a b : Fin r =>
              ψ (MvPolynomial.pderiv (Fin.castAdd d b) (H a)))) := by
          change (MvPolynomial.aeval z_dep).toRingHom J_E0.det = _
          rw [RingHom.map_det]
          have hMat1 : (MvPolynomial.aeval z_dep).toRingHom.mapMatrix J_E0 =
              (Matrix.of fun a b : Fin r =>
                ψ_bar (MvPolynomial.pderiv (Fin.castAdd d b) (H a))).transpose := by
            ext i j
            exact hHE0_pderiv i j
          rw [hMat1, Matrix.det_transpose]
          have hMat2 : (Matrix.of fun a b : Fin r =>
              ψ_bar (MvPolynomial.pderiv (Fin.castAdd d b) (H a))) =
              σ_Fq.mapMatrix (Matrix.of fun a b : Fin r =>
                ψ (MvPolynomial.pderiv (Fin.castAdd d b) (H a))) := by
            ext a b
            rfl
          rw [hMat2, ← RingHom.map_det]
        rw [hmap]
        exact (hDet.map σ_Fq).ne_zero
      let D_lift : MvPolynomial (Fin (r + 1)) E₀ := MvPolynomial.rename Fin.castSucc D_jac
      let v_rel : Fin (r + 1) → MvPolynomial (Fin (r + 1)) E₀ :=
        Fin.snoc (fun j => MvPolynomial.rename Fin.castSucc (H_E0 j))
          (MvPolynomial.X (Fin.last r) * D_lift - 1)
      let I_et : Ideal (MvPolynomial (Fin (r + 1)) E₀) := Ideal.span (Set.range v_rel)
      let A_et := MvPolynomial (Fin (r + 1)) E₀ ⧸ I_et
      let π_et : MvPolynomial (Fin (r + 1)) E₀ →+* A_et := Ideal.Quotient.mk I_et
      have hLast_notMem_vars : ∀ P : MvPolynomial (Fin r) E₀,
          Fin.last r ∉ (MvPolynomial.rename Fin.castSucc P).vars := by
        intro P hMem
        have hSub := MvPolynomial.vars_rename Fin.castSucc P hMem
        rw [Finset.mem_image] at hSub
        obtain ⟨b, _, hb⟩ := hSub
        exact Fin.castSucc_ne_last b hb
      let M_jac : Matrix (Fin (r + 1)) (Fin (r + 1)) (MvPolynomial (Fin (r + 1)) E₀) :=
        Matrix.of fun i j => MvPolynomial.pderiv i (v_rel j)
      have hMjac_det : M_jac.det = D_lift * D_lift := by
        let e_r1 : Fin r ⊕ Fin 1 ≃ Fin (r + 1) := finSumFinEquiv
        have he_inl : ∀ i : Fin r, e_r1 (Sum.inl i) = Fin.castSucc i := by
          intro i
          exact finSumFinEquiv_apply_left i
        have he_inr : ∀ u : Fin 1, e_r1 (Sum.inr u) = Fin.last r := by
          intro u
          obtain rfl : u = 0 := Subsingleton.elim u 0
          change Fin.natAdd r (0 : Fin 1) = Fin.last r
          ext
          exact Nat.add_zero r
        rw [← Matrix.det_reindex_self e_r1.symm M_jac]
        let A_blk : Matrix (Fin r) (Fin r) (MvPolynomial (Fin (r + 1)) E₀) :=
          (MvPolynomial.rename Fin.castSucc).toRingHom.mapMatrix J_E0
        let B_blk : Matrix (Fin r) (Fin 1) (MvPolynomial (Fin (r + 1)) E₀) :=
          Matrix.of fun i u => M_jac (e_r1 (Sum.inl i)) (e_r1 (Sum.inr u))
        let D_blk : Matrix (Fin 1) (Fin 1) (MvPolynomial (Fin (r + 1)) E₀) :=
          Matrix.of fun _ _ => D_lift
        have hBlocks : Matrix.reindex e_r1.symm e_r1.symm M_jac =
            Matrix.fromBlocks A_blk B_blk 0 D_blk := by
          refine Matrix.ext fun x y => ?_
          cases x with
          | inl i =>
            cases y with
            | inl j =>
              change M_jac (e_r1 (Sum.inl i)) (e_r1 (Sum.inl j)) =
                MvPolynomial.rename Fin.castSucc (MvPolynomial.pderiv i (H_E0 j))
              rw [he_inl, he_inl]
              change MvPolynomial.pderiv (Fin.castSucc i) (v_rel (Fin.castSucc j)) = _
              simp only [v_rel, Fin.snoc_castSucc]
              rw [MvPolynomial.pderiv_rename (Fin.castSucc_injective r)]
            | inr u =>
              rfl
          | inr u =>
            cases y with
            | inl j =>
              change M_jac (e_r1 (Sum.inr u)) (e_r1 (Sum.inl j)) = 0
              rw [he_inr, he_inl]
              change MvPolynomial.pderiv (Fin.last r) (v_rel (Fin.castSucc j)) = 0
              simp only [v_rel, Fin.snoc_castSucc]
              exact MvPolynomial.pderiv_eq_zero_of_notMem_vars (hLast_notMem_vars (H_E0 j))
            | inr v =>
              change M_jac (e_r1 (Sum.inr u)) (e_r1 (Sum.inr v)) = D_lift
              rw [he_inr, he_inr]
              change MvPolynomial.pderiv (Fin.last r) (v_rel (Fin.last r)) = D_lift
              simp only [v_rel, Fin.snoc_last, map_sub, Derivation.leibniz,
                MvPolynomial.pderiv_X_self]
              have hp0 : MvPolynomial.pderiv (Fin.last r) D_lift = 0 :=
                MvPolynomial.pderiv_eq_zero_of_notMem_vars (hLast_notMem_vars D_jac)
              simp [hp0]
        rw [hBlocks, Matrix.det_fromBlocks_zero₂₁]
        have hAdet : A_blk.det = D_lift :=
          (RingHom.map_det (MvPolynomial.rename Fin.castSucc).toRingHom J_E0).symm
        have hDdet : D_blk.det = D_lift := Matrix.det_unique D_blk
        rw [hAdet, hDdet]
      have hDlift_unit : IsUnit (π_et D_lift) := by
        have hRel0 : π_et (v_rel (Fin.last r)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨Fin.last r, rfl⟩)
        simp only [v_rel, Fin.snoc_last, map_sub, map_mul, map_one] at hRel0
        have hmul : π_et (MvPolynomial.X (Fin.last r)) * π_et D_lift = 1 :=
          sub_eq_zero.mp hRel0
        exact ⟨⟨π_et D_lift, π_et (MvPolynomial.X (Fin.last r)),
          (mul_comm _ _).trans hmul, hmul⟩, rfl⟩
      have hDetUnit_et : IsUnit (π_et M_jac.det) := by
        rw [hMjac_det, map_mul]
        exact hDlift_unit.mul hDlift_unit
      let P_pre := Algebra.PreSubmersivePresentation.naive (v := v_rel) id Function.injective_id
      have hJacEq : P_pre.jacobiMatrix = M_jac := by
        ext i j
        rw [P_pre.jacobiMatrix_apply]
        rfl
      have hPpre_unit : IsUnit P_pre.jacobian := by
        rw [P_pre.jacobian_eq_jacobiMatrix_det, hJacEq]
        exact hDetUnit_et
      let P_sub : Algebra.SubmersivePresentation E₀ A_et (Fin (r + 1)) (Fin (r + 1)) :=
        { P_pre with jacobian_isUnit := hPpre_unit }
      have hDim0 : P_sub.dimension = 0 := by
        simp [Algebra.Presentation.dimension]
      have : Algebra.IsStandardSmoothOfRelativeDimension 0 E₀ A_et :=
        P_sub.isStandardSmoothOfRelativeDimension hDim0
      have : Algebra.Etale E₀ A_et := inferInstance
      have : Module.Finite E₀ A_et := by
        obtain ⟨I, hFinI, Ai, hField, hAlg, hEquiv, hFinAi⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod E₀ A_et).mp ‹_›
        let : Finite I := hFinI
        let : ∀ i, Field (Ai i) := hField
        let : ∀ i, Algebra E₀ (Ai i) := hAlg
        have : ∀ i, Module.Finite E₀ (Ai i) := fun i => (hFinAi i).1
        exact Module.Finite.equiv hEquiv.symm.toLinearEquiv
      let z_aug : Fin (r + 1) → F_q := Fin.snoc z_dep ((MvPolynomial.aeval z_dep D_jac)⁻¹)
      have hz_aug_comp : z_aug ∘ Fin.castSucc = z_dep := by
        ext i
        simp [z_aug]
      have hIet_ker : ∀ p ∈ I_et, (MvPolynomial.aeval z_aug) p = 0 := by
        intro p hp
        change p ∈ RingHom.ker (MvPolynomial.aeval z_aug).toRingHom
        refine Ideal.span_le.mpr ?_ hp
        rintro _ ⟨idx, rfl⟩
        change (MvPolynomial.aeval z_aug) (v_rel idx) = 0
        refine Fin.lastCases ?_ (fun j => ?_) idx
        · simp only [v_rel, Fin.snoc_last, map_sub, map_mul, map_one,
            MvPolynomial.aeval_X, z_aug, Fin.snoc_last, D_lift, MvPolynomial.aeval_rename]
          rw [hz_aug_comp, inv_mul_cancel₀ hDjac_ne, sub_self]
        · simp only [v_rel, Fin.snoc_castSucc, MvPolynomial.aeval_rename, hz_aug_comp]
          exact hHE0_zero j
      let θ_et : A_et →ₐ[E₀] F_q := Ideal.Quotient.liftₐ I_et (MvPolynomial.aeval z_aug) hIet_ker
      let B₀ : Subalgebra E₀ F_q := θ_et.range
      have : Module.Finite E₀ ↥B₀ :=
        Module.Finite.of_surjective θ_et.rangeRestrict.toLinearMap θ_et.rangeRestrict_surjective
      have hψbar_mem_B0 : ∀ P : MvPolynomial (Fin (r + d)) k, ψ_bar P ∈ B₀ := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C a =>
          rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes,
            IsScalarTower.algebraMap_apply k E₀ F_q]
          exact B₀.algebraMap_mem _
        | add p q hp hq =>
          rw [map_add]
          exact B₀.add_mem hp hq
        | mul_X p idx hp =>
          rw [map_mul]
          refine B₀.mul_mem hp ?_
          obtain ⟨s, rfl⟩ := e_sum.surjective idx
          cases s with
          | inl b =>
            change ψ_bar (MvPolynomial.X (finSumFinEquiv (Sum.inl b))) ∈ B₀
            rw [finSumFinEquiv_apply_left]
            refine ⟨π_et (MvPolynomial.X (Fin.castSucc b)), ?_⟩
            change (MvPolynomial.aeval z_aug) (MvPolynomial.X (Fin.castSucc b)) = z_dep b
            rw [MvPolynomial.aeval_X]
            simp [z_aug]
          | inr γ =>
            change ψ_bar (MvPolynomial.X (finSumFinEquiv (Sum.inr γ))) ∈ B₀
            rw [finSumFinEquiv_apply_right]
            change y_raw γ ∈ B₀
            have hy : y_raw γ = algebraMap E₀ F_q (y_free γ) :=
              (congrFun hy_free γ).symm
            rw [hy]
            exact B₀.algebraMap_mem _
      have hS_mem_B0 : ∀ s : S, σ_Fq s ∈ B₀ := by
        intro s
        obtain ⟨P, rfl⟩ := hSurj s
        exact hψbar_mem_B0 P
      have hFrac_B0 : ∀ z : F_q, ∃ x y : ↥B₀, z = (x : F_q) / (y : F_q) := by
        intro z
        obtain ⟨u, v, hv_ne, hz_eq⟩ := hσ_frac z
        exact ⟨⟨σ_Fq u, hS_mem_B0 u⟩, ⟨σ_Fq v, hS_mem_B0 v⟩, (eq_div_iff hv_ne).mpr hz_eq⟩
      have : IsFractionRing ↥B₀ F_q := IsFractionRing.of_field ↥B₀ F_q hFrac_B0
      have : Algebra.IsAlgebraic ↥B₀ F_q :=
        (IsFractionRing.isAlgebraic_iff' ↥B₀ ↥B₀ F_q).mp Algebra.IsIntegral.isAlgebraic
      have : Algebra.IsAlgebraic E₀ ↥B₀ := Algebra.IsAlgebraic.of_finite E₀ ↥B₀
      have hTrdeg_E0_Fq : Algebra.trdeg E₀ F_q = 0 := by
        have h1 : Algebra.trdeg E₀ ↥B₀ = 0 := trdeg_eq_zero
        have h2 : Algebra.trdeg ↥B₀ F_q = 0 := trdeg_eq_zero
        have h_add := trdeg_add_eq E₀ ↥B₀ (A := F_q)
        rw [h1, h2, add_zero] at h_add
        exact h_add.symm
      have h_add_k := trdeg_add_eq k E₀ (A := F_q)
      rw [hTrdeg_E0_Fq, add_zero] at h_add_k
      rwa [← h_add_k]
    exact h_from_E0 (FractionRing ↥A_free)

  
  have h_split_cokernel :
      ∀ (F_q L : Type u) [Field F_q] [Field L] [Algebra F_q L]
        (x_tilde : Fin N → F_q)
        (v_tilde : Matrix (Fin N) (Fin d) F_q)
        (U_tilde : Matrix (Fin d) (Fin N) F_q),
        U_tilde * v_tilde = 1 →
        ∀ (w : Fin (N + 1) → L),
        w α₀ + ∑ m : Fin N, algebraMap F_q L (x_tilde m) * w (α₀.succAbove m) = 0 →
        (∀ γ : Fin d, ∑ m : Fin N, algebraMap F_q L (v_tilde m γ) * w (α₀.succAbove m) = 0) →
        (∀ z : L, ∃ x y : ↥(Algebra.adjoin F_q (Set.range w)), z = (x : L) / (y : L)) →
        d ≤ N ∧ Algebra.trdeg F_q L ≤ ((N - d : ℕ) : Cardinal.{u}) := by
    intro F_q L _ _ _ x_tilde v_tilde U_tilde hUv_Fq w hInc_w hTan_v hFrac_w
    let T_v : (Fin N → F_q) →ₗ[F_q] (Fin d → F_q) :=
      { toFun := fun u γ => ∑ m : Fin N, u m * v_tilde m γ
        map_add' := fun u₁ u₂ => by
          ext γ
          simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
        map_smul' := fun c u => by
          ext γ
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc]
          exact (Finset.mul_sum Finset.univ (fun m => u m * v_tilde m γ) c).symm }
    have hSurj_Tv : Function.Surjective T_v := by
      intro y
      refine ⟨fun m => ∑ δ : Fin d, y δ * U_tilde δ m, ?_⟩
      ext γ
      change ∑ m : Fin N, (∑ δ : Fin d, y δ * U_tilde δ m) * v_tilde m γ = y γ
      calc ∑ m : Fin N, (∑ δ : Fin d, y δ * U_tilde δ m) * v_tilde m γ
          = ∑ m : Fin N, ∑ δ : Fin d, y δ * (U_tilde δ m * v_tilde m γ) := by
              refine Finset.sum_congr rfl fun m _ => ?_
              rw [Finset.sum_mul]
              exact Finset.sum_congr rfl fun δ _ => mul_assoc _ _ _
        _ = ∑ δ : Fin d, y δ * (∑ m : Fin N, U_tilde δ m * v_tilde m γ) := by
              rw [Finset.sum_comm]
              exact Finset.sum_congr rfl fun δ _ => (Finset.mul_sum _ _ _).symm
        _ = ∑ δ : Fin d, y δ * (U_tilde * v_tilde) δ γ := rfl
        _ = ∑ δ : Fin d, y δ * (1 : Matrix (Fin d) (Fin d) F_q) δ γ := by rw [hUv_Fq]
        _ = y γ := by simp [Matrix.one_apply]
    have hRange_top : T_v.range = ⊤ := LinearMap.range_eq_top.mpr hSurj_Tv
    have hRankNull := LinearMap.finrank_range_add_finrank_ker T_v
    rw [hRange_top, finrank_top, Module.finrank_fin_fun F_q, Module.finrank_fin_fun F_q] at hRankNull
    have hdN : d ≤ N := by omega
    have hKerDim : Module.finrank F_q ↥T_v.ker = N - d := by omega
    let b_ker : Module.Basis (Fin (N - d)) F_q ↥T_v.ker :=
      (Module.finBasis F_q ↥T_v.ker).reindex (finCongr hKerDim)
    let q_row : Fin N → (Fin N → F_q) := fun r₀ m =>
      (if r₀ = m then 1 else 0) - ∑ δ : Fin d, v_tilde r₀ δ * U_tilde δ m
    have hq_ker : ∀ r₀ : Fin N, q_row r₀ ∈ T_v.ker := by
      intro r₀
      rw [LinearMap.mem_ker]
      ext γ
      change ∑ m : Fin N, q_row r₀ m * v_tilde m γ = 0
      simp only [q_row, sub_mul, Finset.sum_sub_distrib]
      have h1 : ∑ m : Fin N, (if r₀ = m then (1 : F_q) else 0) * v_tilde m γ =
          v_tilde r₀ γ := by
        simp
      have h2 : ∑ m : Fin N, (∑ δ : Fin d, v_tilde r₀ δ * U_tilde δ m) * v_tilde m γ =
          v_tilde r₀ γ := by
        calc ∑ m : Fin N, (∑ δ : Fin d, v_tilde r₀ δ * U_tilde δ m) * v_tilde m γ
            = ∑ m : Fin N, ∑ δ : Fin d, v_tilde r₀ δ * (U_tilde δ m * v_tilde m γ) := by
                refine Finset.sum_congr rfl fun m _ => ?_
                rw [Finset.sum_mul]
                exact Finset.sum_congr rfl fun δ _ => mul_assoc _ _ _
          _ = ∑ δ : Fin d, v_tilde r₀ δ * (∑ m : Fin N, U_tilde δ m * v_tilde m γ) := by
                rw [Finset.sum_comm]
                exact Finset.sum_congr rfl fun δ _ => (Finset.mul_sum _ _ _).symm
          _ = ∑ δ : Fin d, v_tilde r₀ δ * (U_tilde * v_tilde) δ γ := rfl
          _ = ∑ δ : Fin d, v_tilde r₀ δ * (1 : Matrix (Fin d) (Fin d) F_q) δ γ := by rw [hUv_Fq]
          _ = v_tilde r₀ γ := by simp [Matrix.one_apply]
      rw [h1, h2, sub_self]
    let μ : Fin N → Fin (N - d) → F_q := fun r₀ j => b_ker.repr ⟨q_row r₀, hq_ker r₀⟩ j
    have hq_expand : ∀ r₀ m : Fin N,
        q_row r₀ m = ∑ j : Fin (N - d), μ r₀ j * (b_ker j).1 m := by
      intro r₀ m
      have hrepr := congrFun (congrArg Subtype.val (b_ker.sum_repr ⟨q_row r₀, hq_ker r₀⟩)) m
      simpa only [Submodule.coe_sum, SetLike.val_smul, Finset.sum_apply, Pi.smul_apply,
        smul_eq_mul, μ] using hrepr.symm
    let t_param : Fin (N - d) → L := fun j =>
      ∑ r₀ : Fin N, algebraMap F_q L (μ r₀ j) * w (α₀.succAbove r₀)
    let Φ_t : MvPolynomial (Fin (N - d)) F_q →ₐ[F_q] L := MvPolynomial.aeval t_param
    have hw_succ_eq : ∀ m : Fin N,
        w (α₀.succAbove m) =
          ∑ j : Fin (N - d), algebraMap F_q L ((b_ker j).1 m) * t_param j := by
      intro m
      have h_proj : ∑ r₀ : Fin N, algebraMap F_q L (q_row r₀ m) * w (α₀.succAbove r₀) =
          w (α₀.succAbove m) := by
        simp only [q_row, map_sub, map_sum, map_mul, sub_mul, Finset.sum_sub_distrib]
        have h_id : ∑ r₀ : Fin N,
            algebraMap F_q L (if r₀ = m then (1 : F_q) else 0) * w (α₀.succAbove r₀) =
            w (α₀.succAbove m) := by
          simp [apply_ite (algebraMap F_q L)]
        have h_kill : ∑ r₀ : Fin N,
            (∑ δ : Fin d, algebraMap F_q L (v_tilde r₀ δ) * algebraMap F_q L (U_tilde δ m)) *
              w (α₀.succAbove r₀) = 0 := by
          calc ∑ r₀ : Fin N,
              (∑ δ : Fin d, algebraMap F_q L (v_tilde r₀ δ) * algebraMap F_q L (U_tilde δ m)) *
                w (α₀.succAbove r₀)
              = ∑ r₀ : Fin N, ∑ δ : Fin d,
                  algebraMap F_q L (U_tilde δ m) *
                    (algebraMap F_q L (v_tilde r₀ δ) * w (α₀.succAbove r₀)) := by
                  refine Finset.sum_congr rfl fun r₀ _ => ?_
                  rw [Finset.sum_mul]
                  exact Finset.sum_congr rfl fun δ _ => by ring
            _ = ∑ δ : Fin d, algebraMap F_q L (U_tilde δ m) *
                  (∑ r₀ : Fin N, algebraMap F_q L (v_tilde r₀ δ) * w (α₀.succAbove r₀)) := by
                  rw [Finset.sum_comm]
                  exact Finset.sum_congr rfl fun δ _ => (Finset.mul_sum _ _ _).symm
            _ = ∑ δ : Fin d, algebraMap F_q L (U_tilde δ m) * 0 := by
                  refine Finset.sum_congr rfl fun δ _ => ?_
                  rw [hTan_v δ]
            _ = 0 := by simp
        rw [h_id, h_kill, sub_zero]
      rw [← h_proj]
      calc ∑ r₀ : Fin N, algebraMap F_q L (q_row r₀ m) * w (α₀.succAbove r₀)
          = ∑ r₀ : Fin N,
              (∑ j : Fin (N - d), algebraMap F_q L (μ r₀ j) * algebraMap F_q L ((b_ker j).1 m)) *
                w (α₀.succAbove r₀) := by
              refine Finset.sum_congr rfl fun r₀ _ => ?_
              rw [hq_expand r₀ m, map_sum]
              simp only [map_mul]
        _ = ∑ r₀ : Fin N, ∑ j : Fin (N - d),
              algebraMap F_q L ((b_ker j).1 m) *
                (algebraMap F_q L (μ r₀ j) * w (α₀.succAbove r₀)) := by
              refine Finset.sum_congr rfl fun r₀ _ => ?_
              rw [Finset.sum_mul]
              exact Finset.sum_congr rfl fun j _ => by ring
        _ = ∑ j : Fin (N - d), algebraMap F_q L ((b_ker j).1 m) * t_param j := by
              rw [Finset.sum_comm]
              exact Finset.sum_congr rfl fun j _ => (Finset.mul_sum _ _ _).symm
    have hw_succ_mem : ∀ m : Fin N, w (α₀.succAbove m) ∈ Φ_t.range := by
      intro m
      rw [hw_succ_eq m]
      refine Φ_t.range.sum_mem fun j _ => ?_
      refine Φ_t.range.mul_mem (Φ_t.range.algebraMap_mem _) ?_
      exact ⟨MvPolynomial.X j, MvPolynomial.aeval_X t_param j⟩
    have hw_α₀_mem : w α₀ ∈ Φ_t.range := by
      have h_eq : w α₀ = - ∑ m : Fin N, algebraMap F_q L (x_tilde m) * w (α₀.succAbove m) :=
        eq_neg_of_add_eq_zero_left hInc_w
      rw [h_eq]
      refine Φ_t.range.neg_mem (Φ_t.range.sum_mem fun m _ => ?_)
      exact Φ_t.range.mul_mem (Φ_t.range.algebraMap_mem _) (hw_succ_mem m)
    let A_w : Subalgebra F_q L := Algebra.adjoin F_q (Set.range w)
    have hAw_le : A_w ≤ Φ_t.range := by
      refine Algebra.adjoin_le ?_
      rintro _ ⟨i, rfl⟩
      exact Fin.succAboveCases α₀ hw_α₀_mem hw_succ_mem i
    have hTrdeg_Aw : Algebra.trdeg F_q ↥A_w ≤ ((N - d : ℕ) : Cardinal.{u}) := by
      calc Algebra.trdeg F_q ↥A_w
          ≤ Algebra.trdeg F_q ↥Φ_t.range :=
            trdeg_le_of_injective (Subalgebra.inclusion hAw_le)
              (Subalgebra.inclusion_injective hAw_le)
        _ ≤ Algebra.trdeg F_q (MvPolynomial (Fin (N - d)) F_q) :=
            trdeg_le_of_surjective Φ_t.rangeRestrict Φ_t.rangeRestrict_surjective
        _ = ((N - d : ℕ) : Cardinal.{u}) := by
            rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
    have : IsFractionRing ↥A_w L := IsFractionRing.of_field ↥A_w L hFrac_w
    have : Algebra.IsAlgebraic ↥A_w L :=
      (IsFractionRing.isAlgebraic_iff' ↥A_w ↥A_w L).mp Algebra.IsIntegral.isAlgebraic
    have hTrdeg_L : Algebra.trdeg F_q L ≤ ((N - d : ℕ) : Cardinal.{u}) := by
      have h0 : Algebra.trdeg ↥A_w L = 0 := trdeg_eq_zero
      have h_add := trdeg_add_eq F_q ↥A_w (A := L)
      rw [h0, add_zero] at h_add
      rwa [← h_add]
    exact ⟨hdN, hTrdeg_L⟩

  
  have h_tower_contra :
      ∀ (F_q L : Type u) [Field F_q] [Field L] [Algebra k F_q] [Algebra k L] [Algebra F_q L]
        [IsScalarTower k F_q L]
        (g_PC : MvPolynomial (Fin (N + 1)) k →ₐ[k] L),
        Function.Injective g_PC →
        Algebra.trdeg k F_q ≤ (d : Cardinal.{u}) →
        d ≤ N →
        Algebra.trdeg F_q L ≤ ((N - d : ℕ) : Cardinal.{u}) →
        False := by
    intro F_q L _ _ _ _ _ _ g_PC hg_inj hTrdegFq hdN hTrdegL
    have hUpper : Algebra.trdeg k L ≤ (N : Cardinal.{u}) := by
      rw [← trdeg_add_eq k F_q (A := L)]
      calc Algebra.trdeg k F_q + Algebra.trdeg F_q L
          ≤ (d : Cardinal.{u}) + ((N - d : ℕ) : Cardinal.{u}) := add_le_add hTrdegFq hTrdegL
        _ = ((d + (N - d) : ℕ) : Cardinal.{u}) := (Nat.cast_add d (N - d)).symm
        _ = (N : Cardinal.{u}) := by rw [Nat.add_sub_of_le hdN]
    have hLower : ((N + 1 : ℕ) : Cardinal.{u}) ≤ Algebra.trdeg k L := by
      calc ((N + 1 : ℕ) : Cardinal.{u})
          = Algebra.trdeg k (MvPolynomial (Fin (N + 1)) k) := by
              rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
        _ ≤ Algebra.trdeg k L := trdeg_le_of_injective g_PC hg_inj
    have hContra : N + 1 ≤ N := Nat.cast_le.mp (hLower.trans hUpper)
    omega

  
  let P_C := MvPolynomial (Fin (N + 1)) k
  let R_SC := MvPolynomial (Fin (N + 1)) S
  let ι_PC : P_C →+* R_SC := MvPolynomial.map κ
  let G_inc : R_SC :=
    MvPolynomial.X α₀ + ∑ m : Fin N, MvPolynomial.C (x_bar m) * MvPolynomial.X (α₀.succAbove m)
  let G_tan : Fin d → R_SC := fun γ =>
    ∑ m : Fin N, MvPolynomial.C (v_bar m γ) * MvPolynomial.X (α₀.succAbove m)
  let I_bad : Ideal R_SC := Ideal.span ({G_inc} ∪ Set.range G_tan)
  let M_SC : Submonoid R_SC := (nonZeroDivisors P_C).map ι_PC
  by_cases hDisj : Disjoint (I_bad : Set R_SC) (M_SC : Set R_SC)
  · exfalso
    let : Algebra k S := κ.toAlgebra
    obtain ⟨𝔓, h𝔓_prime, hIbad_le_𝔓, h𝔓_disj⟩ :=
      Ideal.exists_le_prime_disjoint I_bad M_SC hDisj
    have : 𝔓.IsPrime := h𝔓_prime
    have h_disj : ∀ Δ : P_C, Δ ≠ 0 → ι_PC Δ ∉ 𝔓 := by
      intro Δ hΔ hMem
      exact Set.disjoint_left.mp h𝔓_disj hMem
        (Submonoid.mem_map_of_mem ι_PC (mem_nonZeroDivisors_of_ne_zero hΔ))
    let 𝔮₀ : Ideal S := Ideal.comap MvPolynomial.C 𝔓
    have : 𝔮₀.IsPrime := Ideal.IsPrime.comap MvPolynomial.C
    let D_q := S ⧸ 𝔮₀
    let F_q := FractionRing D_q
    let D_P := R_SC ⧸ 𝔓
    let L := FractionRing D_P
    let j_bar : D_q →+* D_P := Ideal.quotientMap 𝔓 MvPolynomial.C le_rfl
    have h_DL_inj : Function.Injective ((algebraMap D_P L).comp j_bar) :=
      (IsFractionRing.injective D_P L).comp Ideal.quotientMap_injective
    let ι_FL : F_q →+* L := IsFractionRing.lift h_DL_inj
    let : Algebra F_q L := ι_FL.toAlgebra
    let σ_Fq : S →+* F_q := (algebraMap D_q F_q).comp (Ideal.Quotient.mk 𝔮₀)
    let θ_SC : R_SC →+* L := (algebraMap D_P L).comp (Ideal.Quotient.mk 𝔓)
    have hθ_C : ∀ s : S, θ_SC (MvPolynomial.C s) = algebraMap F_q L (σ_Fq s) := by
      intro s
      change (algebraMap D_P L) (j_bar (Ideal.Quotient.mk 𝔮₀ s)) =
        ι_FL (algebraMap D_q F_q (Ideal.Quotient.mk 𝔮₀ s))
      exact (IsFractionRing.lift_algebraMap h_DL_inj (Ideal.Quotient.mk 𝔮₀ s)).symm
    have hσ_κ : ∀ a : k, σ_Fq (κ a) = algebraMap k F_q a := by
      intro a
      change algebraMap D_q F_q (Ideal.Quotient.mk 𝔮₀ (algebraMap k S a)) = algebraMap k F_q a
      have hmk : Ideal.Quotient.mk 𝔮₀ (algebraMap k S a) = algebraMap k D_q a := rfl
      rw [hmk, ← IsScalarTower.algebraMap_apply k D_q F_q]
    have : IsScalarTower k F_q L := by
      refine IsScalarTower.of_algebraMap_eq' ?_
      ext a
      change algebraMap D_P L (Ideal.Quotient.mk 𝔓 (MvPolynomial.C (κ a))) =
        algebraMap F_q L (algebraMap k F_q a)
      rw [← hσ_κ a]
      exact hθ_C (κ a)
    let g_PC : P_C →ₐ[k] L :=
      { toRingHom := θ_SC.comp ι_PC
        commutes' := fun a => by
          change θ_SC (ι_PC (MvPolynomial.C a)) = algebraMap k L a
          have hmapC : ι_PC (MvPolynomial.C a) = MvPolynomial.C (κ a) := MvPolynomial.map_C κ a
          rw [hmapC, hθ_C, hσ_κ, ← IsScalarTower.algebraMap_apply k F_q L] }
    have hg_inj : Function.Injective g_PC := by
      rw [injective_iff_map_eq_zero]
      intro Δ h0
      by_contra hΔ
      have h0' : (algebraMap D_P L) (Ideal.Quotient.mk 𝔓 (ι_PC Δ)) = 0 := h0
      have hmk0 : Ideal.Quotient.mk 𝔓 (ι_PC Δ) = 0 :=
        (injective_iff_map_eq_zero (algebraMap D_P L)).mp (IsFractionRing.injective D_P L) _ h0'
      exact h_disj Δ hΔ (Ideal.Quotient.eq_zero_iff_mem.mp hmk0)
    let w : Fin (N + 1) → L := fun i => θ_SC (MvPolynomial.X i)
    have hInc_w : w α₀ + ∑ m : Fin N, algebraMap F_q L (σ_Fq (x_bar m)) * w (α₀.succAbove m) = 0 := by
      have hG0 : θ_SC G_inc = 0 := by
        change (algebraMap D_P L) (Ideal.Quotient.mk 𝔓 G_inc) = 0
        have hmk0 : Ideal.Quotient.mk 𝔓 G_inc = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (hIbad_le_𝔓 (Ideal.subset_span (Or.inl rfl)))
        rw [hmk0, map_zero]
      simpa only [G_inc, w, map_add, map_sum, map_mul, hθ_C] using hG0
    have hTan_w : ∀ γ : Fin d,
        ∑ m : Fin N, algebraMap F_q L (σ_Fq (v_bar m γ)) * w (α₀.succAbove m) = 0 := by
      intro γ
      have hG0 : θ_SC (G_tan γ) = 0 := by
        change (algebraMap D_P L) (Ideal.Quotient.mk 𝔓 (G_tan γ)) = 0
        have hmk0 : Ideal.Quotient.mk 𝔓 (G_tan γ) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (hIbad_le_𝔓 (Ideal.subset_span (Or.inr ⟨γ, rfl⟩)))
        rw [hmk0, map_zero]
      simpa only [G_tan, w, map_sum, map_mul, hθ_C] using hG0
    let A_w : Subalgebra F_q L := Algebra.adjoin F_q (Set.range w)
    have hθ_mem : ∀ P : R_SC, θ_SC P ∈ A_w := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C s =>
        rw [hθ_C]
        exact A_w.algebraMap_mem _
      | add p q hp hq =>
        rw [map_add]
        exact A_w.add_mem hp hq
      | mul_X p i hp =>
        rw [map_mul]
        exact A_w.mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
    have hD_mem : ∀ u : D_P, algebraMap D_P L u ∈ A_w := by
      intro u
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective u
      exact hθ_mem P
    have hFrac_w : ∀ z : L, ∃ x y : ↥A_w, z = (x : L) / (y : L) := by
      intro z
      obtain ⟨⟨p, q⟩, hpq⟩ := IsLocalization.surj (nonZeroDivisors D_P) z
      have hq_ne0 : (q : D_P) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp q.2
      have hqL_ne0 : algebraMap D_P L (q : D_P) ≠ 0 := fun h0 =>
        hq_ne0 ((injective_iff_map_eq_zero (algebraMap D_P L)).mp
          (IsFractionRing.injective D_P L) _ h0)
      exact ⟨⟨algebraMap D_P L p, hD_mem p⟩, ⟨algebraMap D_P L (q : D_P), hD_mem (q : D_P)⟩,
        (eq_div_iff hqL_ne0).mpr hpq⟩
    have hσ_frac : ∀ z : F_q, ∃ u v : S, σ_Fq v ≠ 0 ∧ z * σ_Fq v = σ_Fq u := by
      intro z
      obtain ⟨⟨p, q⟩, hpq⟩ := IsLocalization.surj (nonZeroDivisors D_q) z
      obtain ⟨u, hu⟩ := Ideal.Quotient.mk_surjective p
      obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective (q : D_q)
      have hq_ne0 : (q : D_q) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp q.2
      have hv_ne0 : σ_Fq v ≠ 0 := by
        change algebraMap D_q F_q (Ideal.Quotient.mk 𝔮₀ v) ≠ 0
        rw [hv]
        exact fun h0 => hq_ne0 ((injective_iff_map_eq_zero (algebraMap D_q F_q)).mp
          (IsFractionRing.injective D_q F_q) _ h0)
      refine ⟨u, v, hv_ne0, ?_⟩
      change z * algebraMap D_q F_q (Ideal.Quotient.mk 𝔮₀ v) =
        algebraMap D_q F_q (Ideal.Quotient.mk 𝔮₀ u)
      rwa [hv, hu]
    have hTrdegFq : Algebra.trdeg k F_q ≤ (d : Cardinal.{u}) :=
      h_jacobian_etale F_q σ_Fq hσ_κ hσ_frac
    let v_tilde : Matrix (Fin N) (Fin d) F_q := v_bar.map σ_Fq
    let U_tilde : Matrix (Fin d) (Fin N) F_q := U_bar.map σ_Fq
    have hUv_Fq : U_tilde * v_tilde = 1 := by
      ext i j
      dsimp only [U_tilde, v_tilde]
      rw [← RingHom.map_matrix_mul U_bar v_bar i j σ_Fq, hUv]
      exact congrFun (congrFun (Matrix.map_one σ_Fq σ_Fq.map_zero σ_Fq.map_one) i) j
    obtain ⟨hdN, hTrdegL⟩ :=
      h_split_cokernel F_q L (fun m => σ_Fq (x_bar m)) v_tilde U_tilde hUv_Fq w
        hInc_w hTan_w hFrac_w
    exact h_tower_contra F_q L g_PC hg_inj hTrdegFq hdN hTrdegL
  · obtain ⟨g, hg_Ibad, hg_MSC⟩ := Set.not_disjoint_iff.mp hDisj
    obtain ⟨Δ_S, hΔ_nzd, rfl⟩ := Submonoid.mem_map.mp hg_MSC
    have hΔ_ne : Δ_S ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hΔ_nzd
    refine ⟨Δ_S, hΔ_ne, ?_⟩
    intro c 𝔮 hc hInc_c
    by_contra! hAll
    let ev_c := MvPolynomial.eval (κ ∘ c)
    have hIbad_le : I_bad ≤ Ideal.comap ev_c 𝔮.asIdeal := by
      refine Ideal.span_le.mpr ?_
      rintro f (hf_inc | ⟨γ, rfl⟩)
      · rw [Set.mem_singleton_iff.mp hf_inc]
        change ev_c G_inc ∈ 𝔮.asIdeal
        have hev_inc : ev_c G_inc =
            ψ (MvPolynomial.C (c α₀)) +
              ∑ m : Fin N, ψ (MvPolynomial.C (c (α₀.succAbove m))) * x_bar m := by
          dsimp only [ev_c, G_inc, κ]
          simp only [map_add, map_sum, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C,
            Function.comp_apply, RingHom.comp_apply]
          congr 1
          exact Finset.sum_congr rfl fun m _ => mul_comm (x_bar m) _
        rwa [hev_inc]
      · change ev_c (G_tan γ) ∈ 𝔮.asIdeal
        have hev_tan : ev_c (G_tan γ) =
            ∑ m : Fin N, ψ (MvPolynomial.C (c (α₀.succAbove m))) * v_bar m γ := by
          dsimp only [ev_c, G_tan, κ]
          simp only [map_sum, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C,
            Function.comp_apply, RingHom.comp_apply]
          exact Finset.sum_congr rfl fun m _ => mul_comm (v_bar m γ) _
        rw [hev_tan]
        exact hAll γ
    have h_ev_mem : ev_c (ι_PC Δ_S) ∈ 𝔮.asIdeal := hIbad_le hg_Ibad
    have h_ev_eq : ev_c (ι_PC Δ_S) = κ (MvPolynomial.eval c Δ_S) := by
      change MvPolynomial.eval (κ ∘ c) (MvPolynomial.map κ Δ_S) =
        κ (MvPolynomial.eval₂ (RingHom.id k) c Δ_S)
      rw [MvPolynomial.eval_map, MvPolynomial.hom_eval₂ Δ_S (RingHom.id k) κ c, RingHom.comp_id]
      rfl
    rw [h_ev_eq] at h_ev_mem
    have hUnit : IsUnit (κ (MvPolynomial.eval c Δ_S)) := (IsUnit.mk0 _ hc).map κ
    exact 𝔮.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem 𝔮.asIdeal h_ev_mem hUnit)

theorem weil_bertini_scheme_chart_cover_and_advance (k : Type u) [Field k] (N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : X ⟶ weilProjectiveSpaceOver k N) :
    AlgebraicGeometry.IsClosedImmersion ι_X.left →
    ∀ (U : X.left.Opens) (d ν : ℕ)
      (F_prev : Fin ν → MvPolynomial (Fin (N + 1)) k),
    IsTransversalLinearSlice k N X ι_X U d ν F_prev →
    (∃ (m_charts : ℕ)
        (α₀ : Fin m_charts → Fin (N + 1))
        (V : Fin m_charts → X.left.Opens)
        (hAffV : ∀ i : Fin m_charts, AlgebraicGeometry.IsAffineOpen (V i))
        (_ : ∀ i : Fin m_charts, V i ≤ U)
        (hVα : ∀ i : Fin m_charts,
          letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
            MvPolynomial.gradedAlgebra
          V i ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X (α₀ i))))
        (s : Fin m_charts → ℕ)
        (φ : ∀ i : Fin m_charts,
          MvPolynomial (Fin (s i + ν + d)) k →+* ↑(X.left.presheaf.obj (Opposite.op (V i))))
        (q : ∀ i : Fin m_charts, Fin (s i) → MvPolynomial (Fin (s i + ν + d)) k)
        (f_lift : ∀ i : Fin m_charts, Fin ν → MvPolynomial (Fin (s i + ν + d)) k)
        (x_coord : ∀ i : Fin m_charts, Fin N → ↑(X.left.presheaf.obj (Opposite.op (V i))))
        (P_h : Fin m_charts → MvPolynomial (Fin N) k),
      (∀ x : X.left, x ∈ U →
