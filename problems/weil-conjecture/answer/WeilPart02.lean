          rw [hsymm]
          exact Ideal.Quotient.lift_mk (RingHom.ker q) β_star.toRingHom hker_le
        have hu_γ : IsUnit (γ_star (q (der_S h))) := by
          rw [hγ_q]
          have hu_mk : IsUnit (mk_K (β_star (der_S h))) := by
            have h1 := AlgHom.congr_fun hβ_star_mk (der_S h)
            change mk_K (β_star (der_S h)) = α_bar (ι_SB (der_S h)) at h1
            rw [h1]
            exact hu_B.map α_bar
          obtain ⟨w_inv, hw_inv⟩ := hK_unit hu_mk
          exact IsUnit.of_mul_eq_one w_inv hw_inv
        let α_ring : B →+* C := IsLocalization.Away.lift (q (der_S h)) hu_γ
        let α_star : B →ₐ[R] C :=
          { α_ring with
            commutes' := fun r => by
              change α_ring (algebraMap Q B (q (φ r))) = algebraMap R C r
              rw [IsLocalization.Away.lift_eq (q (der_S h)) hu_γ (q (φ r)), hγ_q]
              exact β_star.commutes r }
        refine ⟨α_star, ?_⟩
        apply AlgHom.coe_ringHom_injective
        apply IsLocalization.ringHom_ext (Submonoid.powers (q (der_S h)))
        ext y
        obtain ⟨s, rfl⟩ := hq_surj y
        change mk_K (α_ring (algebraMap Q B (q s))) = α_bar (algebraMap Q B (q s))
        rw [IsLocalization.Away.lift_eq (q (der_S h)) hu_γ (q s), hγ_q]
        exact AlgHom.congr_fun hβ_star_mk s
    have hEt_B : Algebra.Etale R B := Algebra.Etale.mk
    have hSm_B : Algebra.IsStandardSmoothOfRelativeDimension 0 R B :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt_B
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0).mpr hSm_B

theorem weil_conormal_jet_transversality_poly_exists (k : Type u) [Field k] (M₀ d₀ : ℕ) (hd₀ : 1 ≤ d₀)
    (T : Type u) [CommRing T] [Algebra k T]
    (ψ : MvPolynomial (Fin 1) k →+* T)
    (hψ_alg : ψ.comp MvPolynomial.C = algebraMap k T)
    (hψ_et : ψ.Etale)
    (der_T : Derivation k T T)
    (μ : Fin (M₀ + 1))
    (x : Fin (M₀ + 1) → T)
    (hx_μ : x μ = 1)
    (h_span : 1 ∈ Ideal.span (Set.range fun ν : Fin (M₀ + 1) => der_T (x ν))) :
    ∃ (G_tan : MvPolynomial (weilDegMonomialIdx M₀ d₀) k),
      G_tan ≠ 0 ∧
      ∀ (c : weilDegMonomialIdx M₀ d₀ → k),
        MvPolynomial.eval c G_tan ≠ 0 →
        1 ∈ Ideal.span {
          ∑ e : weilDegMonomialIdx M₀ d₀,
            algebraMap k T (c e) * ∏ ν : Fin (M₀ + 1), (x ν) ^ (e.1 ν : ℕ),
          der_T (∑ e : weilDegMonomialIdx M₀ d₀,
            algebraMap k T (c e) * ∏ ν : Fin (M₀ + 1), (x ν) ^ (e.1 ν : ℕ)) } :=
by
  have h_s1 : Algebra.FinitePresentation k T ∧
      ∀ (L : Type u) [Field L] [Algebra k L] (τ : T →ₐ[k] L),
        ∃ (F_T : Type u) (_ : Field F_T) (_ : Algebra k F_T) (_ : Algebra F_T L),
          IsScalarTower k F_T L ∧
          Set.range τ ⊆ Set.range (algebraMap F_T L) ∧
          Algebra.trdeg k F_T ≤ 1 := by
    let P₁ : Type u := MvPolynomial (Fin 1) k
    let _ : Algebra P₁ T := ψ.toAlgebra
    have hP₁_eq : ∀ r : k, ψ (algebraMap k P₁ r) = algebraMap k T r := by
      intro r
      change ψ (MvPolynomial.C r) = algebraMap k T r
      rw [← RingHom.comp_apply, hψ_alg]
    have _ : IsScalarTower k P₁ T := IsScalarTower.of_algebraMap_eq fun r => (hP₁_eq r).symm
    have _ : Algebra.Etale P₁ T := RingHom.Etale.toAlgebra hψ_et
    have _ : Algebra.FinitePresentation k P₁ := inferInstance
    have _ : Algebra.FinitePresentation P₁ T := Algebra.Etale.finitePresentation
    refine ⟨Algebra.FinitePresentation.trans k P₁ T, ?_⟩
    intro L _ _ τ
    have hK₀_ex : ∃ (K₀ : Type u) (_ : Field K₀) (_ : Algebra k K₀) (_ : Algebra P₁ K₀)
        (_ : Algebra K₀ L),
        IsScalarTower k P₁ K₀ ∧
        IsScalarTower k K₀ L ∧
        (∀ p : P₁, algebraMap K₀ L (algebraMap P₁ K₀ p) = τ (ψ p)) ∧
        Algebra.trdeg k K₀ ≤ 1 := by
      let φ₀ : P₁ →+* L := τ.toRingHom.comp ψ
      let p₀ : Ideal P₁ := RingHom.ker φ₀
      have _ : p₀.IsPrime := RingHom.ker_isPrime φ₀
      let Q₀ : Type u := P₁ ⧸ p₀
      let K₀ : Type u := FractionRing Q₀
      have htr_Q₀ : Algebra.trdeg k Q₀ ≤ Algebra.trdeg k P₁ :=
        trdeg_le_of_surjective (Ideal.Quotient.mkₐ k p₀) Ideal.Quotient.mk_surjective
      have htr_P₁ : Algebra.trdeg k P₁ = 1 := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin,
          Nat.cast_one, Cardinal.lift_one]
      have _ : Algebra.IsAlgebraic Q₀ K₀ :=
        ⟨fun z => (IsFractionRing.isAlgebraic_iff Q₀ K₀ K₀).mpr (isAlgebraic_algebraMap z)⟩
      have htr_K₀_Q₀ : Algebra.trdeg Q₀ K₀ = 0 := trdeg_eq_zero
      have htr_add : Algebra.trdeg k K₀ = Algebra.trdeg k Q₀ + Algebra.trdeg Q₀ K₀ :=
        (trdeg_add_eq k Q₀ (A := K₀)).symm
      have htr_K₀ : Algebra.trdeg k K₀ ≤ 1 := by
        rw [htr_add, htr_K₀_Q₀, add_zero]
        exact htr_Q₀.trans (le_of_eq htr_P₁)
      let φ₀_bar : Q₀ →+* L := RingHom.kerLift φ₀
      have h_units : ∀ y : nonZeroDivisors Q₀, IsUnit (φ₀_bar y) := by
        intro y
        refine Ne.isUnit fun h0 => mem_nonZeroDivisors_iff_ne_zero.mp y.2 ?_
        exact RingHom.kerLift_injective φ₀ (h0.trans (map_zero φ₀_bar).symm)
      let ι₀ : K₀ →+* L := IsLocalization.lift h_units
      let _ : Algebra K₀ L := ι₀.toAlgebra
      have h_compat_P₁ : ∀ p : P₁, algebraMap K₀ L (algebraMap P₁ K₀ p) = τ (ψ p) := by
        intro p
        have h1 : algebraMap P₁ K₀ p = algebraMap Q₀ K₀ (Ideal.Quotient.mk p₀ p) :=
          IsScalarTower.algebraMap_apply P₁ Q₀ K₀ p
        rw [h1]
        change ι₀ (algebraMap Q₀ K₀ (Ideal.Quotient.mk p₀ p)) = τ (ψ p)
        rw [IsLocalization.lift_eq h_units, RingHom.kerLift_mk]
        rfl
      have _ : IsScalarTower k K₀ L := IsScalarTower.of_algebraMap_eq fun r => by
        rw [IsScalarTower.algebraMap_apply k P₁ K₀ r, h_compat_P₁, hP₁_eq, τ.commutes]
      exact ⟨K₀, inferInstance, inferInstance, inferInstance, inferInstance,
        inferInstance, inferInstance, h_compat_P₁, htr_K₀⟩
    obtain ⟨K₀, _, _, _, _, _, _, hK₀_P₁, hK₀_trdeg⟩ := hK₀_ex
    let _ : Algebra P₁ L := (τ.toRingHom.comp ψ).toAlgebra
    have _ : IsScalarTower P₁ K₀ L := IsScalarTower.of_algebraMap_eq fun p => (hK₀_P₁ p).symm
    let B₀ : Type u := TensorProduct P₁ K₀ T
    have _ : Algebra.Etale K₀ B₀ := inferInstance
    have _ : Module.Finite K₀ B₀ := by
      obtain ⟨I, _, Ai, _, _, e_prod, hAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₀ B₀).mp inferInstance
      have _ : ∀ i : I, Module.Finite K₀ (Ai i) := fun i => (hAi i).1
      exact Module.Finite.equiv e_prod.symm.toLinearEquiv
    let τ_P₁ : T →ₐ[P₁] L :=
      { τ.toRingHom with commutes' := fun _ => rfl }
    let α : B₀ →ₐ[K₀] L :=
      Algebra.TensorProduct.lift (Algebra.ofId K₀ L) τ_P₁ (fun _ _ => Commute.all _ _)
    let S_T : Subalgebra K₀ L := α.range
    have _ : Module.Finite K₀ ↥S_T :=
      Module.Finite.of_surjective α.rangeRestrict.toLinearMap α.rangeRestrict_surjective
    have _ : Algebra.IsIntegral K₀ ↥S_T := Algebra.IsIntegral.of_finite K₀ ↥S_T
    have _ : Algebra.IsAlgebraic K₀ ↥S_T := Algebra.IsAlgebraic.of_finite K₀ ↥S_T
    have htr_ST_K₀ : Algebra.trdeg K₀ ↥S_T = 0 := trdeg_eq_zero
    have htr_ST : Algebra.trdeg k ↥S_T ≤ 1 := by
      have h_add : Algebra.trdeg k ↥S_T = Algebra.trdeg k K₀ + Algebra.trdeg K₀ ↥S_T :=
        (trdeg_add_eq k K₀ (A := ↥S_T)).symm
      rw [h_add, htr_ST_K₀, add_zero]
      exact hK₀_trdeg
    have hIsField : IsField ↥S_T :=
      (Algebra.IsIntegral.isField_iff_isField (RingHom.injective (algebraMap K₀ ↥S_T))).mp
        (Field.toIsField K₀)
    have h_inv : ∀ z ∈ S_T.restrictScalars k, z⁻¹ ∈ S_T.restrictScalars k := by
      intro z hz
      by_cases hz0 : z = 0
      · rw [hz0, inv_zero]
        exact zero_mem _
      · have hz_ne : (⟨z, hz⟩ : ↥S_T) ≠ 0 := fun h => hz0 (congrArg Subtype.val h)
        obtain ⟨⟨v, hv⟩, hmul⟩ := hIsField.mul_inv_cancel hz_ne
        have hzv : z * v = 1 := congrArg Subtype.val hmul
        have hinv_eq : z⁻¹ = v := inv_eq_of_mul_eq_one_right hzv
        rw [hinv_eq]
        exact hv
    let F_int : IntermediateField k L := (S_T.restrictScalars k).toIntermediateField h_inv
    let inc_ST : ↥F_int →ₐ[k] ↥S_T :=
      { toFun := fun z => ⟨z.1, z.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    have hInj_inc : Function.Injective inc_ST := fun a b h => Subtype.ext (congrArg Subtype.val h)
    have htr_F : Algebra.trdeg k ↥F_int ≤ 1 :=
      (trdeg_le_of_injective inc_ST hInj_inc).trans htr_ST
    have hRange : Set.range τ ⊆ Set.range (algebraMap ↥F_int L) := by
      rintro _ ⟨t, rfl⟩
      have ht_mem : τ t ∈ F_int := by
        change τ t ∈ S_T
        refine ⟨(1 : K₀) ⊗ₜ[P₁] t, ?_⟩
        change α ((1 : K₀) ⊗ₜ[P₁] t) = τ t
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      exact ⟨⟨τ t, ht_mem⟩, rfl⟩
    exact ⟨↥F_int, inferInstance, inferInstance, inferInstance, inferInstance, hRange, htr_F⟩
  obtain ⟨hFP, hField⟩ := h_s1
  have _ : Algebra.FinitePresentation k T := hFP
  let Idx := weilDegMonomialIdx M₀ d₀
  let a : Idx → T := fun e => ∏ ν : Fin (M₀ + 1), (x ν) ^ (e.1 ν : ℕ)
  let b : Idx → T := fun e => der_T (a e)
  have hGen : ∀ (L : Type u) [Field L] [Algebra k L]
      (ι_P : MvPolynomial Idx k →ₐ[k] L)
      (τ : T →ₐ[k] L),
      Function.Injective ι_P →
      (∑ e : Idx, ι_P (MvPolynomial.X e) * τ (a e)) = 0 →
      (∑ e : Idx, ι_P (MvPolynomial.X e) * τ (b e)) ≠ 0 := by
    intro L _ _ ι_P τ hInj hSum1 hSum2
    obtain ⟨F_T, _, _, _, _, hRange, hTrdeg⟩ := hField L τ
    have h_ex_ν₀ : ∃ ν₀ : Fin (M₀ + 1), τ (der_T (x ν₀)) ≠ 0 := by
      by_contra h_all
      push Not at h_all
      have h_le : Ideal.span (Set.range fun ν : Fin (M₀ + 1) => der_T (x ν)) ≤
          RingHom.ker τ.toRingHom := by
        rw [Ideal.span_le]
        rintro _ ⟨ν, rfl⟩
        exact h_all ν
      have h1 : (1 : T) ∈ RingHom.ker τ.toRingHom := h_le h_span
      have h10 : (1 : L) = 0 := by
        change τ 1 = 0 at h1
        rwa [map_one] at h1
      exact one_ne_zero h10
    obtain ⟨ν₀, hν₀⟩ := h_ex_ν₀
    have hν₀_ne : ν₀ ≠ μ := by
      rintro rfl
      apply hν₀
      rw [hx_μ, Derivation.map_one_eq_zero, map_zero]
    let e₀ : Idx := ⟨fun ν => if ν = μ then ⟨d₀, Nat.lt_succ_self d₀⟩ else 0, by
      rw [Finset.sum_eq_single μ]
      · simp
      · intro ν _ hν
        simp [hν]
      · intro hμ
        exact False.elim (hμ (Finset.mem_univ μ))⟩
    let e₁ : Idx := ⟨fun ν => if ν = μ then ⟨d₀ - 1, by omega⟩ else if ν = ν₀ then ⟨1, by omega⟩ else 0, by
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ μ)]
      have hν₀_mem : ν₀ ∈ (Finset.univ : Finset (Fin (M₀ + 1))).erase μ :=
        Finset.mem_erase.mpr ⟨hν₀_ne, Finset.mem_univ ν₀⟩
      rw [← Finset.add_sum_erase _ _ hν₀_mem]
      have h_rest : ∑ ν ∈ ((Finset.univ : Finset (Fin (M₀ + 1))).erase μ).erase ν₀,
          ((if ν = μ then (⟨d₀ - 1, by omega⟩ : Fin (d₀ + 1))
            else if ν = ν₀ then ⟨1, by omega⟩ else 0 : Fin (d₀ + 1)) : ℕ) = 0 := by
        refine Finset.sum_eq_zero fun ν hν => ?_
        have hne₁ : ν ≠ ν₀ := (Finset.mem_erase.mp hν).1
        have hne₀ : ν ≠ μ := (Finset.mem_erase.mp (Finset.mem_erase.mp hν).2).1
        simp [hne₀, hne₁]
      rw [h_rest]
      simp [hν₀_ne]
      omega⟩
    have he₀₁ : e₀ ≠ e₁ := by
      intro h_eq
      have hval := congrArg (fun e : Idx => (e.1 ν₀ : ℕ)) h_eq
      simp [e₀, e₁, hν₀_ne] at hval
    have hm_e₀ : a e₀ = 1 := by
      refine Finset.prod_eq_one fun ν _ => ?_
      by_cases hν : ν = μ
      · subst hν
        simp [e₀, hx_μ]
      · simp [e₀, hν]
    have hm_e₁ : a e₁ = x ν₀ := by
      rw [show a e₁ = ∏ ν : Fin (M₀ + 1), (x ν) ^ (e₁.1 ν : ℕ) from rfl]
      rw [Finset.prod_eq_single ν₀]
      · simp [e₁, hν₀_ne]
      · intro ν _ hν_ne
        by_cases hν_μ : ν = μ
        · subst hν_μ
          simp [e₁, hx_μ]
        · simp [e₁, hν_μ, hν_ne]
      · intro h_abs
        exact False.elim (h_abs (Finset.mem_univ ν₀))
    let R_set : Finset Idx := (Finset.univ.erase e₀).erase e₁
    let S_rem : Type := ↥R_set
    have h_card : Fintype.card Idx = Fintype.card S_rem + 2 := by
      have he₁_mem : e₁ ∈ (Finset.univ : Finset Idx).erase e₀ :=
        Finset.mem_erase.mpr ⟨he₀₁.symm, Finset.mem_univ e₁⟩
      have hc1 : R_set.card + 1 = ((Finset.univ : Finset Idx).erase e₀).card :=
        Finset.card_erase_add_one he₁_mem
      have hc0 : ((Finset.univ : Finset Idx).erase e₀).card + 1 = Fintype.card Idx := by
        simpa using Finset.card_erase_add_one (Finset.mem_univ e₀)
      have hcs : Fintype.card S_rem = R_set.card := Fintype.card_coe R_set
      omega
    let aeval_rem : MvPolynomial S_rem F_T →ₐ[F_T] L :=
      MvPolynomial.aeval (fun s : S_rem => ι_P (MvPolynomial.X s.1))
    let A_rem : Subalgebra F_T L := aeval_rem.range
    have hτ_mem : ∀ t : T, τ t ∈ A_rem := by
      intro t
      obtain ⟨f_t, hf_t⟩ := hRange ⟨t, rfl⟩
      rw [← hf_t]
      exact A_rem.algebraMap_mem f_t
    have h_inv_mem : (τ (der_T (x ν₀)))⁻¹ ∈ A_rem := by
      obtain ⟨u₀, hu₀⟩ := hRange ⟨der_T (x ν₀), rfl⟩
      rw [← hu₀, ← map_inv₀]
      exact A_rem.algebraMap_mem u₀⁻¹
    have hS_mem : ∀ s : S_rem, ι_P (MvPolynomial.X s.1) ∈ A_rem := by
      intro s
      exact ⟨MvPolynomial.X s, MvPolynomial.aeval_X _ s⟩
    have he₁_mem_erase : e₁ ∈ (Finset.univ : Finset Idx).erase e₀ :=
      Finset.mem_erase.mpr ⟨he₀₁.symm, Finset.mem_univ e₁⟩
    have hXe₁_mem : ι_P (MvPolynomial.X e₁) ∈ A_rem := by
      have h2 : (∑ e : Idx, ι_P (MvPolynomial.X e) * τ (der_T (a e))) = 0 := hSum2
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ e₀),
          ← Finset.add_sum_erase _ _ he₁_mem_erase] at h2
      rw [hm_e₀, Derivation.map_one_eq_zero, map_zero, mul_zero, zero_add, hm_e₁] at h2
      have h_eq1 : ι_P (MvPolynomial.X e₁) * τ (der_T (x ν₀)) =
          - (∑ e ∈ R_set, ι_P (MvPolynomial.X e) * τ (der_T (a e))) :=
        eq_neg_of_add_eq_zero_left h2
      have h_solve : ι_P (MvPolynomial.X e₁) =
          (- (∑ s : S_rem, ι_P (MvPolynomial.X s.1) * τ (der_T (a s.1)))) *
            (τ (der_T (x ν₀)))⁻¹ := by
        rw [Finset.sum_coe_sort R_set (fun e => ι_P (MvPolynomial.X e) * τ (der_T (a e))),
          ← h_eq1, mul_inv_cancel_right₀ hν₀]
      rw [h_solve]
      exact mul_mem (neg_mem (sum_mem fun s _ => mul_mem (hS_mem s) (hτ_mem _))) h_inv_mem
    have hXe₀_mem : ι_P (MvPolynomial.X e₀) ∈ A_rem := by
      have h1 : (∑ e : Idx, ι_P (MvPolynomial.X e) * τ (a e)) = 0 := hSum1
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ e₀),
          ← Finset.add_sum_erase _ _ he₁_mem_erase] at h1
      rw [hm_e₀, map_one, mul_one] at h1
      have h_solve : ι_P (MvPolynomial.X e₀) =
          - (ι_P (MvPolynomial.X e₁) * τ (a e₁) +
            ∑ s : S_rem, ι_P (MvPolynomial.X s.1) * τ (a s.1)) := by
        rw [Finset.sum_coe_sort R_set (fun e => ι_P (MvPolynomial.X e) * τ (a e))]
        exact eq_neg_of_add_eq_zero_left h1
      rw [h_solve]
      exact neg_mem (add_mem (mul_mem hXe₁_mem (hτ_mem _))
        (sum_mem fun s _ => mul_mem (hS_mem s) (hτ_mem _)))
    have hX_all : ∀ e : Idx, ι_P (MvPolynomial.X e) ∈ A_rem := by
      intro e
      by_cases he₀ : e = e₀
      · exact he₀ ▸ hXe₀_mem
      · by_cases he₁ : e = e₁
        · exact he₁ ▸ hXe₁_mem
        · have heR : e ∈ R_set :=
            Finset.mem_erase.mpr ⟨he₁, Finset.mem_erase.mpr ⟨he₀, Finset.mem_univ e⟩⟩
          exact hS_mem ⟨e, heR⟩
    let ι_rem : MvPolynomial Idx k →ₐ[k] ↥A_rem :=
      MvPolynomial.aeval (fun e : Idx => (⟨ι_P (MvPolynomial.X e), hX_all e⟩ : ↥A_rem))
    have h_comp : (A_rem.val.restrictScalars k).comp ι_rem = ι_P := by
      apply MvPolynomial.algHom_ext
      intro e
      simp [ι_rem]
    have hInj_rem : Function.Injective ι_rem := by
      refine Function.Injective.of_comp (f := A_rem.val.restrictScalars k) ?_
      change Function.Injective ((A_rem.val.restrictScalars k).comp ι_rem)
      rwa [h_comp]
    have htr_low : (Fintype.card Idx : Cardinal.{u}) ≤ Algebra.trdeg k ↥A_rem := by
      have h := trdeg_le_of_injective ι_rem hInj_rem
      rwa [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Cardinal.lift_natCast] at h
    have htr_add : Algebra.trdeg k ↥A_rem = Algebra.trdeg k F_T + Algebra.trdeg F_T ↥A_rem :=
      (trdeg_add_eq k F_T (A := ↥A_rem)).symm
    have htr_up : Algebra.trdeg F_T ↥A_rem ≤ (Fintype.card S_rem : Cardinal.{u}) := by
      have h := trdeg_le_of_surjective aeval_rem.rangeRestrict aeval_rem.rangeRestrict_surjective
      rwa [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Cardinal.lift_natCast] at h
    have h_card_le : (Fintype.card Idx : Cardinal.{u}) ≤ ((1 + Fintype.card S_rem : ℕ) : Cardinal.{u}) := by
      rw [Nat.cast_add, Nat.cast_one]
      exact htr_low.trans (htr_add.le.trans (add_le_add hTrdeg htr_up))
    have h_nat_le : Fintype.card Idx ≤ 1 + Fintype.card S_rem := Nat.cast_le.mp h_card_le
    omega
  have h_s3 : ∃ (G : MvPolynomial Idx k),
      G ≠ 0 ∧
      ∀ (c : Idx → k),
        MvPolynomial.eval c G ≠ 0 →
        1 ∈ Ideal.span {
          ∑ e : Idx, algebraMap k T (c e) * a e,
          ∑ e : Idx, algebraMap k T (c e) * b e } := by
    let P_dual : Type u := MvPolynomial Idx k
    let Q : Type u := TensorProduct k P_dual T
    let H₁ : Q := ∑ e : Idx, (MvPolynomial.X e : P_dual) ⊗ₜ[k] (a e)
    let H₂ : Q := ∑ e : Idx, (MvPolynomial.X e : P_dual) ⊗ₜ[k] (b e)
    let J : Ideal Q := Ideal.span ({H₁, H₂} : Set Q)
    have hJ_fg : J.FG := Submodule.fg_span (Set.toFinite ({H₁, H₂} : Set Q))
    have _ : Algebra.FinitePresentation P_dual (Q ⧸ J) :=
      Algebra.FinitePresentation.quotient hJ_fg
    have hΦ_fp : (algebraMap P_dual (Q ⧸ J)).FinitePresentation :=
      RingHom.finitePresentation_algebraMap.mpr inferInstance
    let S_good : Set (PrimeSpectrum P_dual) :=
      (Set.range (PrimeSpectrum.comap (algebraMap P_dual (Q ⧸ J))))ᶜ
    have hS_const : Topology.IsConstructible S_good :=
      (PrimeSpectrum.isConstructible_range_comap hΦ_fp).compl
    let η_dual : PrimeSpectrum P_dual :=
      ⟨⊥, ⟨bot_ne_top, fun h => by simpa only [Ideal.mem_bot] using mul_eq_zero.mp (Ideal.mem_bot.mp h)⟩⟩
    have hη_mem : η_dual ∈ S_good := by
      rintro ⟨q_spec, hq_eq⟩
      have hq_bot : Ideal.comap (algebraMap P_dual (Q ⧸ J)) q_spec.asIdeal = ⊥ :=
        congrArg PrimeSpectrum.asIdeal hq_eq
      have _ : q_spec.asIdeal.IsPrime := q_spec.isPrime
      let q_Q : Ideal Q := Ideal.comap (Ideal.Quotient.mk J) q_spec.asIdeal
      have _ : q_Q.IsPrime := Ideal.comap_isPrime (Ideal.Quotient.mk J) q_spec.asIdeal
      have hD_ex : ∃ (D : Type u) (_ : CommRing D) (_ : IsDomain D) (_ : Algebra k D)
          (π_D : Q →ₐ[k] D), ∀ z : Q, π_D z = 0 ↔ z ∈ q_Q :=
        ⟨Q ⧸ q_Q, inferInstance, inferInstance, inferInstance,
          Ideal.Quotient.mkₐ k q_Q, fun _ => Ideal.Quotient.eq_zero_iff_mem⟩
      obtain ⟨D, _, _, _, π_D, hπ_D_ker⟩ := hD_ex
      let L : Type u := FractionRing D
      let π_L : Q →ₐ[k] L := (IsScalarTower.toAlgHom k D L).comp π_D
      let ι_P : P_dual →ₐ[k] L := π_L.comp Algebra.TensorProduct.includeLeft
      let τ : T →ₐ[k] L := π_L.comp Algebra.TensorProduct.includeRight
      have hInj : Function.Injective ι_P := by
        rw [injective_iff_map_eq_zero]
        intro p hp
        have hp_eq : ι_P p = algebraMap D L (π_D (p ⊗ₜ[k] (1 : T))) := rfl
        rw [hp_eq] at hp
        have hp_D : π_D (p ⊗ₜ[k] (1 : T)) = 0 :=
          IsFractionRing.injective D L (hp.trans (map_zero _).symm)
        have hp_qQ : p ⊗ₜ[k] (1 : T) ∈ q_Q := (hπ_D_ker _).mp hp_D
        have hp_comap : p ∈ Ideal.comap (algebraMap P_dual (Q ⧸ J)) q_spec.asIdeal := hp_qQ
        rwa [hq_bot, Ideal.mem_bot] at hp_comap
      have h_tmul_sum : ∀ f : Idx → T,
          π_L (∑ e : Idx, (MvPolynomial.X e : P_dual) ⊗ₜ[k] (f e)) =
            ∑ e : Idx, ι_P (MvPolynomial.X e) * τ (f e) := by
        intro f
        rw [map_sum]
        refine Finset.sum_congr rfl fun e _ => ?_
        have h_mul : ((MvPolynomial.X e : P_dual) ⊗ₜ[k] (f e) : Q) =
            ((MvPolynomial.X e : P_dual) ⊗ₜ[k] (1 : T)) * ((1 : P_dual) ⊗ₜ[k] (f e)) := by
          simp
        rw [h_mul, map_mul]
        rfl
      have hJ_le_qQ : J ≤ q_Q := by
        intro z hz
        change Ideal.Quotient.mk J z ∈ q_spec.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hz]
        exact q_spec.asIdeal.zero_mem
      have hH₁_zero : (∑ e : Idx, ι_P (MvPolynomial.X e) * τ (a e)) = 0 := by
        rw [← h_tmul_sum a]
        have hmk : π_D H₁ = 0 :=
          (hπ_D_ker H₁).mpr (hJ_le_qQ (Ideal.subset_span (Set.mem_insert H₁ {H₂})))
        change algebraMap D L (π_D H₁) = 0
        rw [hmk, map_zero]
      have hH₂_zero : (∑ e : Idx, ι_P (MvPolynomial.X e) * τ (b e)) = 0 := by
        rw [← h_tmul_sum b]
        have hmk : π_D H₂ = 0 :=
          (hπ_D_ker H₂).mpr (hJ_le_qQ (Ideal.subset_span (Set.mem_insert_of_mem H₁ rfl)))
        change algebraMap D L (π_D H₂) = 0
        rw [hmk, map_zero]
      exact hGen L ι_P τ hInj hH₁_zero hH₂_zero
    have h_open_empty_of_not_η : ∀ V : Set (PrimeSpectrum P_dual),
        IsOpen V → η_dual ∉ V → V = ∅ := by
      intro V hV hη_not
      ext p
      simp only [Set.mem_empty_iff_false, iff_false]
      intro hp
      obtain ⟨B, ⟨r, rfl⟩, hpB, hBV⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hp hV
      have hr_ne : r ≠ 0 := by
        intro hr0
        rw [hr0] at hpB
        exact hpB (Ideal.zero_mem p.asIdeal)
      have hηB : η_dual ∈ PrimeSpectrum.basicOpen r := by
        change r ∉ (⊥ : Ideal P_dual)
        rwa [Ideal.mem_bot]
      exact hη_not (hBV hηB)
    have h_dichot : ∀ {s : Set (PrimeSpectrum P_dual)}, Topology.IsConstructible s →
        ∃ U : Set (PrimeSpectrum P_dual), IsOpen U ∧ η_dual ∈ U ∧ (U ⊆ s ∨ U ⊆ sᶜ) := by
      refine Topology.IsConstructible.empty_union_induction ?_ ?_ ?_
      · intro U hU_open _
        by_cases hη : η_dual ∈ U
        · exact ⟨U, hU_open, hη, Or.inl Set.Subset.rfl⟩
        · have hU_emp : U = ∅ := h_open_empty_of_not_η U hU_open hη
          refine ⟨Set.univ, isOpen_univ, trivial, Or.inr ?_⟩
          simp [hU_emp]
      · intro s _ t _ ih_s ih_t
        rcases ih_s with ⟨U₁, hU₁, hη₁, h₁ | h₁⟩
        · exact ⟨U₁, hU₁, hη₁, Or.inl (h₁.trans Set.subset_union_left)⟩
        · rcases ih_t with ⟨U₂, hU₂, hη₂, h₂ | h₂⟩
          · exact ⟨U₂, hU₂, hη₂, Or.inl (h₂.trans Set.subset_union_right)⟩
          · refine ⟨U₁ ∩ U₂, hU₁.inter hU₂, ⟨hη₁, hη₂⟩, Or.inr fun z hz h_ut => ?_⟩
            rcases h_ut with hzs | hzt
            · exact h₁ hz.1 hzs
            · exact h₂ hz.2 hzt
      · intro s _ ih_s
        rcases ih_s with ⟨U, hU, hη, h | h⟩
        · exact ⟨U, hU, hη, Or.inr (by simpa only [compl_compl] using h)⟩
        · exact ⟨U, hU, hη, Or.inl h⟩
    obtain ⟨U_good, hU_open, hη_U, hU_sub | hU_compl⟩ := h_dichot hS_const
    · obtain ⟨B, ⟨G, rfl⟩, hη_G, hG_U⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hη_U hU_open
      have hG_sub : (PrimeSpectrum.basicOpen G : Set (PrimeSpectrum P_dual)) ⊆ S_good :=
        hG_U.trans hU_sub
      have hG_ne : G ≠ 0 := by
        change G ∉ (⊥ : Ideal P_dual) at hη_G
        rwa [Ideal.mem_bot] at hη_G
      refine ⟨G, hG_ne, fun c hc => ?_⟩
      let s₁ : T := ∑ e : Idx, algebraMap k T (c e) * a e
      let s₂ : T := ∑ e : Idx, algebraMap k T (c e) * b e
      let I_c : Ideal T := Ideal.span ({s₁, s₂} : Set T)
      change 1 ∈ I_c
      by_contra h1_not
      have hIc_ne_top : I_c ≠ ⊤ := fun htop => h1_not (htop ▸ Submodule.mem_top)
      obtain ⟨m_T, hm_max, hIc_le⟩ := Ideal.exists_le_maximal I_c hIc_ne_top
      let _ : Field (T ⧸ m_T) := Ideal.Quotient.field m_T
      let ev_Q : Q →ₐ[k] (T ⧸ m_T) :=
        Algebra.TensorProduct.lift
          ((Algebra.ofId k (T ⧸ m_T)).comp (MvPolynomial.aeval c))
          (Ideal.Quotient.mkₐ k m_T)
          (fun _ _ => Commute.all _ _)
      have hev_sum : ∀ f : Idx → T,
          ev_Q (∑ e : Idx, (MvPolynomial.X e : P_dual) ⊗ₜ[k] (f e)) =
            Ideal.Quotient.mk m_T (∑ e : Idx, algebraMap k T (c e) * f e) := by
        intro f
        rw [map_sum, map_sum]
        refine Finset.sum_congr rfl fun e _ => ?_
        rw [Algebra.TensorProduct.lift_tmul, map_mul]
        congr 1
        change algebraMap k (T ⧸ m_T) (MvPolynomial.aeval c (MvPolynomial.X e)) =
          Ideal.Quotient.mk m_T (algebraMap k T (c e))
        rw [MvPolynomial.aeval_X, IsScalarTower.algebraMap_apply k T (T ⧸ m_T),
          Ideal.Quotient.algebraMap_eq]
      have hJ_le : J ≤ RingHom.ker ev_Q.toRingHom := by
        rw [Ideal.span_le]
        intro z hz
        rcases Set.mem_insert_iff.mp hz with rfl | hz₂
        · change ev_Q H₁ = 0
          rw [hev_sum a, Ideal.Quotient.eq_zero_iff_mem]
          exact hIc_le (Ideal.subset_span (Set.mem_insert s₁ {s₂}))
        · rw [Set.mem_singleton_iff.mp hz₂]
          change ev_Q H₂ = 0
          rw [hev_sum b, Ideal.Quotient.eq_zero_iff_mem]
          exact hIc_le (Ideal.subset_span (Set.mem_insert_of_mem s₁ rfl))
      let ev_bar : (Q ⧸ J) →+* (T ⧸ m_T) :=
        Ideal.Quotient.lift J ev_Q.toRingHom (fun z hz => RingHom.mem_ker.mp (hJ_le hz))
      let q_pt : PrimeSpectrum (Q ⧸ J) := ⟨RingHom.ker ev_bar, RingHom.ker_isPrime ev_bar⟩
      have h_comap_G :
          PrimeSpectrum.comap (algebraMap P_dual (Q ⧸ J)) q_pt ∈ PrimeSpectrum.basicOpen G := by
        change Ideal.Quotient.lift J ev_Q.toRingHom _ (Ideal.Quotient.mk J (G ⊗ₜ[k] 1)) ≠ 0
        rw [Ideal.Quotient.lift_mk]
        change ev_Q (G ⊗ₜ[k] 1) ≠ 0
        rw [Algebra.TensorProduct.lift_tmul]
        simp only [AlgHom.comp_apply, Algebra.ofId_apply, map_one, mul_one]
        exact fun h0 =>
          hc ((RingHom.injective (algebraMap k (T ⧸ m_T))) (h0.trans (map_zero _).symm))
      exact hG_sub h_comap_G ⟨q_pt, rfl⟩
    · exact False.elim (hU_compl hη_U hη_mem)
  obtain ⟨G_tan, hG_ne, hG_span⟩ := h_s3
  refine ⟨G_tan, hG_ne, fun c hc => ?_⟩
  have h_der : der_T (∑ e : Idx, algebraMap k T (c e) * a e) =
      ∑ e : Idx, algebraMap k T (c e) * b e := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [← Algebra.smul_def, der_T.map_smul, Algebra.smul_def]
  rw [show (∑ e : weilDegMonomialIdx M₀ d₀,
      algebraMap k T (c e) * ∏ ν : Fin (M₀ + 1), (x ν) ^ (e.1 ν : ℕ)) =
      ∑ e : Idx, algebraMap k T (c e) * a e from rfl, h_der]
  exact hG_span c hc

theorem weil_proj_chart_dehomog_poly_and_closedPoint_eval (k : Type u) [Field k] [IsAlgClosed k] (M₀ d₀ : ℕ) (hd₀ : 1 ≤ d₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) :=
      MvPolynomial.gradedAlgebra
    (∀ c : weilDegMonomialIdx M₀ d₀ → k,
      weilHomogeneousPoly M₀ d₀ c ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k d₀) ∧
    (∀ v : V₁.left, IsClosed ({v} : Set V₁.left) →
      ∃ E_v : MvPolynomial (weilDegMonomialIdx M₀ d₀) k,
        E_v ≠ 0 ∧
        ∀ c : weilDegMonomialIdx M₀ d₀ → k,
          MvPolynomial.eval c E_v ≠ 0 →
          v ∈ (TopologicalSpace.Opens.map ι₁.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k)
              (weilHomogeneousPoly M₀ d₀ c))) ∧
    ∃ (W_proj : Fin (M₀ + 1) → V₁.left.Opens)
      (x_proj : ∀ μ : Fin (M₀ + 1),
        Fin (M₀ + 1) → ↑(V₁.left.presheaf.obj (Opposite.op (W_proj μ)))),
      (⨆ μ : Fin (M₀ + 1), W_proj μ) = ⊤ ∧
      (∀ μ : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (W_proj μ)) ∧
      (∀ μ : Fin (M₀ + 1), x_proj μ μ = 1) ∧
      (∀ (μ : Fin (M₀ + 1)) (V : V₁.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
          (hV : V ≤ W_proj μ) (T : Type u) [CommRing T] [Algebra k T]
          (π : ↑(V₁.left.presheaf.obj (Opposite.op V)) →+* T)
          (_ : π.comp ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            V₁.hom.appTop ≫ V₁.left.presheaf.map (CategoryTheory.homOfLE le_top).op).hom =
              algebraMap k T)
          (der_T : Derivation k T T)
          (s₀ : ↑(V₁.left.presheaf.obj (Opposite.op V))),
        der_T (π s₀) = 1 →
        1 ∈ Ideal.span (Set.range fun ν : Fin (M₀ + 1) =>
          der_T (π ((V₁.left.presheaf.map (CategoryTheory.homOfLE hV).op).hom (x_proj μ ν))))) ∧
      (∀ (μ : Fin (M₀ + 1)) (c : weilDegMonomialIdx M₀ d₀ → k)
          (H : AlgebraicGeometry.Scheme.{u}) (ιH : H ⟶ V₁.left),
        IsHomogeneousHypersurfacePullbackOver k M₀ d₀ ι₁ (weilHomogeneousPoly M₀ d₀ c) ιH →
        ∀ (V : V₁.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V) (hV : V ≤ W_proj μ),
          RingHom.ker (ιH.app V).hom =
            Ideal.span { ∑ e : weilDegMonomialIdx M₀ d₀,
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                V₁.hom.appTop ≫ V₁.left.presheaf.map (CategoryTheory.homOfLE le_top).op).hom (c e) *
                ∏ ν : Fin (M₀ + 1),
                  ((V₁.left.presheaf.map (CategoryTheory.homOfLE hV).op).hom (x_proj μ ν)) ^
                    (e.1 ν : ℕ) }) :=
by
  have _ := hd₀
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let p_hom : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    (weilProjectiveSpaceOver k M₀).hom
  let ι : V₁.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι₁.left
  have _ : AlgebraicGeometry.IsClosedImmersion ι := hCl₁
  have hX_hom : ∀ μ : Fin (M₀ + 1), MvPolynomial.X μ ∈ 𝒜 1 :=
    fun μ => MvPolynomial.isHomogeneous_X k μ
  let U_proj : Fin (M₀ + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
    fun μ => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)
  
  have hHom : ∀ c : weilDegMonomialIdx M₀ d₀ → k, weilHomogeneousPoly M₀ d₀ c ∈ 𝒜 d₀ := by
    intro c
    rw [MvPolynomial.mem_homogeneousSubmodule]
    unfold weilHomogeneousPoly
    refine MvPolynomial.IsHomogeneous.sum Finset.univ _ d₀ fun e _ => ?_
    have h_prod : (∏ μ : Fin (M₀ + 1),
        (MvPolynomial.X μ : MvPolynomial (Fin (M₀ + 1)) k) ^ (e.1 μ : ℕ)).IsHomogeneous d₀ := by
      have h_prod₀ := MvPolynomial.IsHomogeneous.prod Finset.univ
        (fun μ => (MvPolynomial.X μ : MvPolynomial (Fin (M₀ + 1)) k) ^ (e.1 μ : ℕ))
        (fun μ => (e.1 μ : ℕ))
        (fun μ _ => MvPolynomial.isHomogeneous_X_pow μ (e.1 μ : ℕ))
      rwa [e.2] at h_prod₀
    simpa only [zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin (M₀ + 1)) (c e)).mul h_prod
  
  have hU_top : (⨆ μ : Fin (M₀ + 1), U_proj μ) = ⊤ := by
    have h_adjoin : Algebra.adjoin (↥(𝒜 0))
        (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k)) = ⊤ := by
      rw [eq_top_iff]
      have h_mem_all : ∀ p : MvPolynomial (Fin (M₀ + 1)) k,
          p ∈ Algebra.adjoin (↥(𝒜 0))
            (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k)) := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a =>
          let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
          exact (Algebra.adjoin (↥(𝒜 0))
            (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k))).algebraMap_mem c₀
        | add p q hp hq =>
          exact add_mem hp hq
        | mul_X p i hp =>
          exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
      intro p _
      exact h_mem_all p
    exact AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X
      (fun μ => ⟨1, hX_hom μ⟩) h_adjoin
  have hU_aff : ∀ μ : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (U_proj μ) :=
    fun μ => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X μ)
      (hX_hom μ) zero_lt_one
  
  have hAvoid : ∀ v : V₁.left, IsClosed ({v} : Set V₁.left) →
      ∃ E_v : MvPolynomial (weilDegMonomialIdx M₀ d₀) k,
        E_v ≠ 0 ∧
        ∀ c : weilDegMonomialIdx M₀ d₀ → k,
          MvPolynomial.eval c E_v ≠ 0 →
          v ∈ (TopologicalSpace.Opens.map ι₁.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 (weilHomogeneousPoly M₀ d₀ c)) := by
    intro v _hv
    let p : ProjectiveSpectrum 𝒜 := ι.base v
    have hp_top : ι.base v ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
    rw [← hU_top] at hp_top
    obtain ⟨μ₀, hμ₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hp_top
    have hX_notMem : MvPolynomial.X μ₀ ∉ p.asHomogeneousIdeal :=
      (ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X μ₀) p).mp hμ₀
    let 𝔓 : Ideal (MvPolynomial (Fin (M₀ + 1)) k) := p.asHomogeneousIdeal.toIdeal
    have hPrime : 𝔓.IsPrime := p.isPrime
    have hX_pow_notMem : (MvPolynomial.X μ₀ : MvPolynomial (Fin (M₀ + 1)) k) ^ d₀ ∉ 𝔓 :=
      mt (hPrime.mem_of_pow_mem d₀) hX_notMem
    let e₀ : weilDegMonomialIdx M₀ d₀ :=
      ⟨fun ν => if ν = μ₀ then ⟨d₀, Nat.lt_succ_self d₀⟩ else 0, by
        rw [Finset.sum_eq_single μ₀]
        · simp
        · intro ν _ hν
          simp [hν]
        · intro h_abs
          exact False.elim (h_abs (Finset.mem_univ μ₀))⟩
    let monom : weilDegMonomialIdx M₀ d₀ → MvPolynomial (Fin (M₀ + 1)) k :=
      fun e => ∏ ν : Fin (M₀ + 1),
        (MvPolynomial.X ν : MvPolynomial (Fin (M₀ + 1)) k) ^ (e.1 ν : ℕ)
    have h_monom_e₀ : monom e₀ = (MvPolynomial.X μ₀ : MvPolynomial (Fin (M₀ + 1)) k) ^ d₀ := by
      dsimp only [monom, e₀]
      rw [Finset.prod_eq_single μ₀]
      · simp
      · intro ν _ hν
        simp [hν]
      · intro h_abs
        exact False.elim (h_abs (Finset.mem_univ μ₀))
    let V_quot := MvPolynomial (Fin (M₀ + 1)) k ⧸ 𝔓
    let q_𝔓 : MvPolynomial (Fin (M₀ + 1)) k →ₐ[k] V_quot := Ideal.Quotient.mkₐ k 𝔓
    have hw₀_ne : q_𝔓 (monom e₀) ≠ 0 := by
      intro h0
      apply hX_pow_notMem
      rw [← h_monom_e₀, ← Ideal.Quotient.eq_zero_iff_mem]
      exact h0
    have _ : Module.Free k V_quot := Module.Free.of_divisionRing k V_quot
    have _ : Module.Projective k V_quot := Module.Projective.of_free
    obtain ⟨ℓ, hℓ⟩ := Module.Projective.exists_dual_eq_one k hw₀_ne
    let E_v : MvPolynomial (weilDegMonomialIdx M₀ d₀) k :=
      ∑ e : weilDegMonomialIdx M₀ d₀,
        MvPolynomial.C (ℓ (q_𝔓 (monom e))) * MvPolynomial.X e
    have h_eval_Ev : ∀ c : weilDegMonomialIdx M₀ d₀ → k,
        MvPolynomial.eval c E_v = ℓ (q_𝔓 (weilHomogeneousPoly M₀ d₀ c)) := by
      intro c
