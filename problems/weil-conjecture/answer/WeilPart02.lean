          · apply Subtype.ext
            simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow]
            rw [pow_one, ← pow_add, Finset.sum_insert hγ]
      have h_mk_sum : ∀ (S : Finset (Fin (M₀ + 1) →₀ ℕ))
          (f : (Fin (M₀ + 1) →₀ ℕ) → MvPolynomial (Fin (M₀ + 1)) k)
          (b : Submonoid.powers (MvPolynomial.X μ)),
          (∑ d ∈ S, Localization.mk (f d) b) = Localization.mk (∑ d ∈ S, f d) b := by
        intro S f b
        classical
        induction S using Finset.induction_on with
        | empty =>
          simp only [Finset.sum_empty, Localization.mk_zero]
        | insert d S hd ih =>
          rw [Finset.sum_insert hd, Finset.sum_insert hd, ih, Localization.add_mk_self]
      have hG_hom : G.IsHomogeneous r := by
        have hG1 : G ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k r := by
