    have hq_ne_𝔪 : q ≠ 𝔪 := by
      intro hEq
      rw [hEq] at hq_ht
      have hLt : (m : ℕ∞) < ((m + 1 : ℕ) : ℕ∞) := by norm_cast; omega
      exact not_lt_of_ge (h𝔪_ht.trans hq_ht) hLt
