  have hq_surj : ∀ γ : Fin G, Function.Surjective (ιH.app (V_chart γ)).hom := fun γ =>
    (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hCartier.1).2 (V_chart γ) (hV_aff γ)
  let h_poly : ∀ γ : Fin G, S_chart γ := fun γ =>
    ∑ e : weilDegMonomialIdx M₀ d₀,
