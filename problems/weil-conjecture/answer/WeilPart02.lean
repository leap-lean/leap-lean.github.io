    clear! k m K C_K F h_chart h_sep
    intro K R F _ _ _ _ _ _ _ _ _ _ ψ hEt O_rel hO_ne_top hRO x₀ Lx₀ Ox₀ hTr_x₀ hFin_x₀
    let P := Polynomial K
    letI : DecidableEq K := Classical.decEq K
    let j : ↥Ox₀ →+* ↥O_rel :=
      (Lx₀.val.toRingHom.comp Ox₀.subtype).codRestrict O_rel.toSubring (fun y => y.2)
    have hj_inj : Function.Injective j := by
      intro y₁ y₂ h
      have hF : (y₁.1 : F) = (y₂.1 : F) := congrArg (fun z : ↥O_rel => (z : F)) h
      exact Subtype.ext (Subtype.ext hF)
    have hj_isUnit : ∀ y : ↥Ox₀, IsUnit y ↔ IsUnit (j y) := by
      intro y
      refine ⟨IsUnit.map j, fun hu => ?_⟩
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have hmulF : (y.1 : F) * (v : F) = 1 := congrArg Subtype.val hv
      have hyF_ne : (y.1 : F) ≠ 0 := left_ne_zero_of_mul_eq_one hmulF
      have hy_ne : y.1 ≠ 0 := fun h0 => hyF_ne (by rw [h0]; rfl)
      have hinv_eq : ((y.1 : F))⁻¹ = (v : F) := inv_eq_of_mul_eq_one_right hmulF
      have hinv_mem : (y.1)⁻¹ ∈ Ox₀ := by
        change (((y.1)⁻¹ : ↥Lx₀) : F) ∈ O_rel
        change ((y.1 : F))⁻¹ ∈ O_rel
        rw [hinv_eq]
        exact v.2
      let y_inv : ↥Ox₀ := ⟨(y.1)⁻¹, hinv_mem⟩
      have hy_mul : y * y_inv = 1 := Subtype.ext (mul_inv_cancel₀ hy_ne)
      exact ⟨⟨y, y_inv, hy_mul, mul_comm y y_inv ▸ hy_mul⟩, rfl⟩
    have hj_max : ∀ y : ↥Ox₀,
        y ∈ IsLocalRing.maximalIdeal ↥Ox₀ ↔ j y ∈ IsLocalRing.maximalIdeal ↥O_rel := by
      intro y
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hj_isUnit]
    have haeval_eq : Polynomial.aeval x₀ = (IsScalarTower.toAlgHom K R F).comp ψ := by
      apply Polynomial.algHom_ext
      simp [x₀]
    have haeval_inj : Function.Injective (Polynomial.aeval x₀ : P →ₐ[K] F) := by
      rw [injective_iff_map_eq_zero]
      exact transcendental_iff.mp hTr_x₀
    have haeval_mem_Lx₀ : ∀ p : P, Polynomial.aeval x₀ p ∈ Lx₀ := by
      intro p
      rw [IntermediateField.mem_adjoin_simple_iff]
      exact ⟨p, 1, by simp⟩
    let ι_PL : P →ₐ[K] ↥Lx₀ :=
      (Polynomial.aeval x₀).codRestrict Lx₀.toSubalgebra haeval_mem_Lx₀
    have hιPL_O : ∀ f : P, ι_PL f ∈ Ox₀ := by
      intro f
      change Polynomial.aeval x₀ f ∈ O_rel
      rw [AlgHom.congr_fun haeval_eq f]
      exact hRO (ψ f)
    let ι_PO : P →+* ↥Ox₀ := ι_PL.toRingHom.codRestrict Ox₀.toSubring hιPL_O
    have hιPO_inj : Function.Injective ι_PO := by
      intro f₁ f₂ h
      exact haeval_inj (congrArg (fun z : ↥Ox₀ => (z.1 : F)) h)
    let p₀ : Ideal P := (IsLocalRing.maximalIdeal ↥Ox₀).comap ι_PO
    haveI hp₀_prime : p₀.IsPrime := Ideal.IsPrime.comap ι_PO
    have hp₀_ne : p₀ ≠ ⊥ := by
      intro hp₀
      have hLx₀_sub : ∀ y : ↥Lx₀, (y : F) ∈ O_rel := by
        intro y
        have hy2 : (y : F) ∈ Lx₀ := y.2
        rw [IntermediateField.mem_adjoin_simple_iff] at hy2
        obtain ⟨r, s, hrs⟩ := hy2
        by_cases hs : s = 0
        · rw [hrs, hs, map_zero, div_zero]
          exact O_rel.zero_mem
        · have hs_not_p₀ : s ∉ p₀ := by
            rw [hp₀, Ideal.mem_bot]
            exact hs
          have hs_unit_Ox₀ : IsUnit (ι_PO s) := by
            rw [← IsLocalRing.notMem_maximalIdeal]
            exact hs_not_p₀
          obtain ⟨v_s, hv_s⟩ := ((hj_isUnit (ι_PO s)).mp hs_unit_Ox₀).exists_right_inv
          have hmul_s : Polynomial.aeval x₀ s * (v_s : F) = 1 := congrArg Subtype.val hv_s
          have hinv_s : (Polynomial.aeval x₀ s)⁻¹ = (v_s : F) :=
            inv_eq_of_mul_eq_one_right hmul_s
          rw [hrs, div_eq_mul_inv, hinv_s]
          exact O_rel.toSubring.mul_mem (hιPL_O r) v_s.2
      apply hO_ne_top
      ext w
      simp only [ValuationSubring.mem_top, iff_true]
      by_contra hw
      have hw_ne : w ≠ 0 := fun h0 => hw (h0 ▸ O_rel.zero_mem)
      have hw_inv : w⁻¹ ∈ O_rel := (O_rel.mem_or_inv_mem w).resolve_left hw
      haveI : Module.Finite ↥Lx₀ F := hFin_x₀
      haveI : Algebra.IsIntegral ↥Lx₀ F := Algebra.IsIntegral.of_finite ↥Lx₀ F
      obtain ⟨p_w, hp_mon, hp_ev⟩ := Algebra.IsIntegral.isIntegral (R := ↥Lx₀) w
      rw [← Polynomial.aeval_def] at hp_ev
      let d := p_w.natDegree
      by_cases hd0 : d = 0
      · have hp1 : p_w = 1 := Polynomial.eq_one_of_monic_natDegree_zero hp_mon hd0
        rw [hp1, map_one] at hp_ev
        exact one_ne_zero hp_ev
      · have hd_pos : 1 ≤ d := Nat.pos_of_ne_zero hd0
        have hsum : (∑ i ∈ Finset.range d, (p_w.coeff i : F) * w ^ i) + w ^ d = 0 := by
          have h1 : Polynomial.aeval w p_w =
              ∑ i ∈ Finset.range (d + 1), (p_w.coeff i : F) * w ^ i := by
            rw [Polynomial.aeval_eq_sum_range]
            rfl
          rw [hp_ev] at h1
          rw [Finset.sum_range_succ, hp_mon.coeff_natDegree, OneMemClass.coe_one, one_mul] at h1
          exact h1.symm
        have hwd : w ^ d = - ∑ i ∈ Finset.range d, (p_w.coeff i : F) * w ^ i :=
          eq_neg_of_add_eq_zero_right hsum
        let d1 := d - 1
        have hw_eq : w = - ∑ i ∈ Finset.range d,
            (p_w.coeff i : F) * (w ^ i * (w⁻¹) ^ d1) := by
          have hLHS : w ^ d * (w⁻¹) ^ d1 = w := by
            have hd_eq : d = d1 + 1 := (Nat.sub_add_cancel hd_pos).symm
            calc
              w ^ d * (w⁻¹) ^ d1
                  = (w ^ d1 * w) * (w⁻¹) ^ d1 := by rw [hd_eq, pow_succ]
              _ = w * ((w * w⁻¹) ^ d1) := by rw [mul_pow]; ring
              _ = w := by rw [mul_inv_cancel₀ hw_ne, one_pow, mul_one]
          calc
            w = w ^ d * (w⁻¹) ^ d1 := hLHS.symm
            _ = (- ∑ i ∈ Finset.range d, (p_w.coeff i : F) * w ^ i) * (w⁻¹) ^ d1 := by
                  rw [hwd]
            _ = - ∑ i ∈ Finset.range d, (p_w.coeff i : F) * (w ^ i * (w⁻¹) ^ d1) := by
                  rw [neg_mul, Finset.sum_mul]
                  congr 1
                  exact Finset.sum_congr rfl (fun _ _ => by ring)
        apply hw
        rw [hw_eq]
        apply O_rel.toSubring.neg_mem
        apply O_rel.toSubring.sum_mem
        intro i hi
        apply O_rel.toSubring.mul_mem (hLx₀_sub (p_w.coeff i))
        have hi_le : i ≤ d1 := Nat.le_sub_one_of_lt (Finset.mem_range.mp hi)
        let diff_i := d1 - i
        have hd_split : d1 = i + diff_i := (Nat.add_sub_cancel' hi_le).symm
        have hpow_eq : w ^ i * (w⁻¹) ^ d1 = (w⁻¹) ^ diff_i := by
          calc
            w ^ i * (w⁻¹) ^ d1
                = w ^ i * ((w⁻¹) ^ i * (w⁻¹) ^ diff_i) := by rw [hd_split, pow_add]
            _ = (w * w⁻¹) ^ i * (w⁻¹) ^ diff_i := by rw [← mul_assoc, ← mul_pow]
            _ = (w⁻¹) ^ diff_i := by rw [mul_inv_cancel₀ hw_ne, one_pow, one_mul]
        rw [hpow_eq]
        exact O_rel.toSubring.pow_mem hw_inv _
    have hp₀_max : p₀.IsMaximal := IsPrime.to_maximal_ideal hp₀_ne
    let π₀ : P := Submodule.IsPrincipal.generator p₀
    have hπ₀_span : Ideal.span {π₀} = p₀ := Submodule.IsPrincipal.span_singleton_generator p₀
    have hπ₀_ne : π₀ ≠ 0 := by
      intro h0
      apply hp₀_ne
      rw [← hπ₀_span, h0, Ideal.span_singleton_eq_bot]
    letI algPO : Algebra P ↥Ox₀ := ι_PO.toAlgebra
    haveI : IsLocalization p₀.primeCompl ↥Ox₀ :=
      { map_units := by
          intro y
          rw [← IsLocalRing.notMem_maximalIdeal]
          exact y.2
        surj := by
          intro z
          have hz2 : z.1.1 ∈ Lx₀ := z.1.2
          rw [IntermediateField.mem_adjoin_simple_iff] at hz2
          obtain ⟨a, b, hab⟩ := hz2
          by_cases hb : b = 0
          · refine ⟨(0, 1), ?_⟩
            apply Subtype.ext
            apply Subtype.ext
            change z.1.1 * Polynomial.aeval x₀ 1 = Polynomial.aeval x₀ 0
            rw [map_one, map_zero, mul_one, hab, hb, map_zero, div_zero]
          · let d := EuclideanDomain.gcd a b
            have hd_ne : d ≠ 0 := by
              intro hd0
              exact hb (EuclideanDomain.gcd_eq_zero_iff.mp hd0).2
