      have hcomp := hmap =≫ P_proj.presheaf.map (CategoryTheory.homOfLE
        (AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X μ) (MvPolynomial.X ν)).symm.le).op
