            (1 : IsLocalRing.ResidueField S) ⊗ₜ[P] z := by
          have hsum_eq : ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] (∑ i : Fin c, p_coeff i • g_JP i) :
