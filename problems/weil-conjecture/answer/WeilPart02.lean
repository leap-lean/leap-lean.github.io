      have hmk_eq : HomogeneousLocalization.mk t₀ = HomogeneousLocalization.mk t₁ := by
        congr 1; ext <;> simp [t₀, t₁]
      exact (congrArg (algebraMap _ _ ∘
        ((AlgebraicGeometry.Proj.basicOpenIsoAway
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (MvPolynomial.X α₀) hXα₀ zero_lt_one).hom ≫
          ι_X.left.appLE
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X α₀))
