        { hom := E'_b.homOfLE hpre_eq_V₁.le
          inv := E'_b.homOfLE hpre_eq_V₁.ge
          hom_inv_id := by
            rw [← CategoryTheory.cancel_mono (Φ'_b ⁻¹ᵁ W'_open ℓ).ι, CategoryTheory.Category.assoc,
              AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι,
              CategoryTheory.Category.id_comp]
          inv_hom_id := by
            rw [← CategoryTheory.cancel_mono V'₁.ι, CategoryTheory.Category.assoc,
              AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι,
              CategoryTheory.Category.id_comp] }
      let e_pre_ℓ := iso_eq_ℓ ≪≫ e_V₁
      let Ψ_1 : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ ℓ} R_b →+* A₁ :=
        MvPolynomial.eval₂Hom MvPolynomial.C (fun r => θ₁ (MvPolynomial.X r))
      let ρ_1 : A₁ →+* MvPolynomial {r : Fin (m + 1 + 1) // r ≠ ℓ} R_b :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun _ => MvPolynomial.X ⟨b.castSucc, Fin.castSucc_ne_last b⟩)
      have hSurj_1 : Function.Surjective Ψ_1 := by
        have hcomp : Ψ_1.comp ρ_1 = RingHom.id A₁ := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro p
            simp only [RingHom.comp_apply]
            dsimp only [Ψ_1, ρ_1]
            rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
            rfl
          · intro r
            rw [h_idx₀ r]
            simp only [RingHom.comp_apply]
            dsimp only [Ψ_1, ρ_1]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
