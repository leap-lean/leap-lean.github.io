    let K_P : Type u := FractionRing D_A
    let Ω : Type u := AlgebraicClosure K_P
    let π_P : A →+* Ω :=
      (algebraMap K_P Ω).comp ((algebraMap D_A K_P).comp (Ideal.Quotient.mk P.asIdeal))
    have hπ_P_zero : ∀ a : A, π_P a = 0 ↔ a ∈ P.asIdeal := by
      intro a
      change (algebraMap K_P Ω) ((algebraMap D_A K_P) (Ideal.Quotient.mk P.asIdeal a)) = 0 ↔ a ∈ P.asIdeal
      rw [map_eq_zero_iff _ (RingHom.injective (algebraMap K_P Ω)),
          map_eq_zero_iff _ (IsFractionRing.injective D_A K_P),
          Ideal.Quotient.eq_zero_iff_mem]
    have hp₀_ker : ∀ r : R, r ∈ p₀ → (π_P.comp MvPolynomial.C) r = 0 := by
      intro r hr
      exact (hπ_P_zero (MvPolynomial.C r)).mpr hr
    let ψ_R₀ : R₀ →+* Ω := Ideal.Quotient.lift p₀ (π_P.comp MvPolynomial.C) hp₀_ker
    have hψ_R₀_inj : Function.Injective ψ_R₀ := by
      intro z₁ z₂ hz
      obtain ⟨r₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
      obtain ⟨r₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
      have h0 : ψ_R₀ (Ideal.Quotient.mk p₀ (r₁ - r₂)) = 0 := by
        rw [map_sub, map_sub, hz, sub_self]
      change π_P (MvPolynomial.C (r₁ - r₂)) = 0 at h0
      exact sub_eq_zero.mp (Ideal.Quotient.eq_zero_iff_mem.mpr ((hπ_P_zero _).mp h0))
    have hψ_R₀_unit : ∀ y : nonZeroDivisors R₀, IsUnit (ψ_R₀ y) := by
      intro y
      exact isUnit_iff_ne_zero.mpr fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hψ_R₀_inj (h0.trans ψ_R₀.map_zero.symm))
    let ψ_F₀ : F₀ →+* Ω := IsLocalization.lift (M := nonZeroDivisors R₀) hψ_R₀_unit
