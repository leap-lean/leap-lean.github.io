    let e₁ : AlgebraicGeometry.Spec (CommRingCat.of B_L) ≅
        CategoryTheory.Limits.pullback π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) :=
      (AlgebraicGeometry.pullbackSpecIso K₀ L (A₀ ℓ)).symm
    let pb_mid := CategoryTheory.Limits.pullback π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ))
    let fwd₂ : pb_mid ⟶ P_L :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.snd π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) ≫
          (isoD₀ ℓ).inv ≫ fst₀ ℓ)
        (CategoryTheory.Limits.pullback.fst π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)))
        (by
          rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition,
