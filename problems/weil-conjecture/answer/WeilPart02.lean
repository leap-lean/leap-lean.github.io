    have hFc : F_c ∈ 𝒜 d₀ := by
      change weilHomogeneousPoly M₀ d₀ c ∈ 𝒜 d₀
      unfold weilHomogeneousPoly
      refine Submodule.sum_mem (𝒜 d₀) (fun e _ => ?_)
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have h_prod : (∏ α : Fin (M₀ + 1),
          (MvPolynomial.X α : MvPolynomial (Fin (M₀ + 1)) k) ^ (e.1 α : ℕ)).IsHomogeneous d₀ := by
        have h_p : ∀ (T : Finset (Fin (M₀ + 1))),
            (∏ α ∈ T, (MvPolynomial.X α : MvPolynomial (Fin (M₀ + 1)) k) ^ (e.1 α : ℕ)).IsHomogeneous
              (∑ α ∈ T, (e.1 α : ℕ)) := by
          intro T
          induction T using Finset.induction_on with
          | empty => simpa using MvPolynomial.isHomogeneous_one (Fin (M₀ + 1)) k
          | @insert α T hα ih =>
            rw [Finset.prod_insert hα, Finset.sum_insert hα]
            have h_pow : ((MvPolynomial.X α : MvPolynomial (Fin (M₀ + 1)) k) ^ (e.1 α : ℕ)).IsHomogeneous
