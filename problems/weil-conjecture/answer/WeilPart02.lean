      obtain ⟨_, hRange, _⟩ := hCartier.2
      have hv_range : v ∈ Set.range ιH.base := ⟨z, rfl⟩
      rw [hRange] at hv_range
      exact hv_range hv_bo
    obtain ⟨γ, hv_chart⟩ := hCovSm v hv_y hv_sm
    have hz_VH : z ∈ V_H γ := hv_chart
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨γ, ?_⟩
    by_contra hz_not_et
    let z₀ : ↥(V_H γ).toScheme := ⟨z, hz_VH⟩
    have hz_not_pre : z₀ ∉ (V_H γ).ι ⁻¹ᵁ H.basicOpen (δ_chart γ) := hz_not_et
    have h_eq_pre := congrArg (fun (U : (V_H γ).toScheme.Opens) => z₀ ∈ U)
      (AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen (V_H γ) (δ_chart γ))
    have hδ_mem : δ_chart γ ∈ ((V_H γ).toSpecΓ.base z₀).asIdeal := by
      by_contra hδ_not
      have hz_in : z₀ ∈ (V_H γ).toSpecΓ ⁻¹ᵁ PrimeSpectrum.basicOpen (δ_chart γ) := hδ_not
      exact hz_not_pre (h_eq_pre.mp hz_in)
    have h_nat := congrArg (fun g => g.base z₀)
      (AlgebraicGeometry.Scheme.Opens.toSpecΓ_naturality ιH (V_chart γ))
    have h_pt : (ιH ∣_ V_chart γ).base z₀ = (⟨v, hv_chart⟩ : ↥(V_chart γ).toScheme) :=
      Subtype.ext (congrArg (fun g => g.base z₀)
        (AlgebraicGeometry.morphismRestrict_ι ιH (V_chart γ)))
    have h_comap : PrimeSpectrum.comap (ιH.app (V_chart γ)).hom ((V_H γ).toSpecΓ.base z₀) =
        (V_chart γ).toSpecΓ.base ⟨v, hv_chart⟩ := by
      change (AlgebraicGeometry.Spec.map (ιH.app (V_chart γ))).base ((V_H γ).toSpecΓ.base z₀) =
        (V_chart γ).toSpecΓ.base ((ιH ∣_ V_chart γ).base z₀) at h_nat
      rw [h_pt] at h_nat
      exact h_nat
    let P_v := ((V_chart γ).toSpecΓ.base ⟨v, hv_chart⟩).asIdeal
    have h_asIdeal : Ideal.comap (ιH.app (V_chart γ)).hom ((V_H γ).toSpecΓ.base z₀).asIdeal = P_v :=
      congrArg PrimeSpectrum.asIdeal h_comap
    have hder_mem : der_S γ (h_poly γ) ∈ P_v := by
      rw [← h_asIdeal]
      exact hδ_mem
    have hh_mem : h_poly γ ∈ P_v := by
      rw [← h_asIdeal]
      have hh0 : (ιH.app (V_chart γ)).hom (h_poly γ) = 0 := by
        rw [← RingHom.mem_ker, hq_ker γ]
        exact Ideal.subset_span rfl
      simp [Ideal.mem_comap, hh0]
    have hI_le_Pv : Ideal.map (φ_chart γ) (RingHom.ker (ev_y_chart γ)) ≤ P_v :=
      hIdeal_chart γ v hv_chart hv_y
    let I_γ := Ideal.map (φ_chart γ) (RingHom.ker (ev_y_chart γ))
    let π_γ := Ideal.Quotient.mk I_γ
    have h_one_span : 1 ∈ Ideal.span { π_γ (h_poly γ), π_γ (der_S γ (h_poly γ)) } :=
      hG_tan_span γ c (hc_tan γ)
    rw [Ideal.mem_span_pair] at h_one_span
    obtain ⟨u, w, huw⟩ := h_one_span
    obtain ⟨u₀, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨w₀, rfl⟩ := Ideal.Quotient.mk_surjective w
    change π_γ u₀ * π_γ (h_poly γ) + π_γ w₀ * π_γ (der_S γ (h_poly γ)) = 1 at huw
    have h_diff_ker : 1 - (u₀ * h_poly γ + w₀ * der_S γ (h_poly γ)) ∈ I_γ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change π_γ (1 - (u₀ * h_poly γ + w₀ * der_S γ (h_poly γ))) = 0
      simp only [map_sub, map_one, map_add, map_mul, huw, sub_self]
    have h_diff_Pv : 1 - (u₀ * h_poly γ + w₀ * der_S γ (h_poly γ)) ∈ P_v :=
      hI_le_Pv h_diff_ker
    have h_comb_Pv : u₀ * h_poly γ + w₀ * der_S γ (h_poly γ) ∈ P_v :=
      P_v.add_mem (P_v.mul_mem_left u₀ hh_mem) (P_v.mul_mem_left w₀ hder_mem)
    have h_one_Pv : (1 : S_chart γ) ∈ P_v := by
      simpa only [sub_add_cancel] using P_v.add_mem h_diff_Pv h_comb_Pv
    exact ((V_chart γ).toSpecΓ.base ⟨v, hv_chart⟩).isPrime.ne_top
      (Ideal.eq_top_of_isUnit_mem P_v h_one_Pv isUnit_one)
  have hClosed_bad : IsClosed (p.base '' ((V_et : Set H)ᶜ)) :=
    p.isClosedMap _ V_et.isOpen.isClosed_compl
  let W_y : B₀.left.Opens := ⟨(p.base '' ((V_et : Set H)ᶜ))ᶜ, hClosed_bad.isOpen_compl⟩
  have hy_Wy : y ∈ W_y := by
    intro hy_bad
    obtain ⟨z, hz_not_et, hpz⟩ := hy_bad
    exact hz_not_et (h_fib_y z hpz)
  have h_pre_Wy : p ⁻¹ᵁ W_y ≤ V_et := by
    intro z hz_Wy
    by_contra hz_not_et
    exact hz_Wy ⟨z, hz_not_et, rfl⟩
  have hEt_Wy : AlgebraicGeometry.Etale (p ∣_ W_y) := by
    let W_H : H.Opens := p ⁻¹ᵁ W_y
    let U_cov : Fin G → W_H.toScheme.Opens := fun γ => W_H.ι ⁻¹ᵁ V_et_chart γ
    have h_top : iSup U_cov = ⊤ := by
      rw [eq_top_iff]
      intro z _
      have hz : z.1 ∈ V_et := h_pre_Wy z.2
      obtain ⟨γ, hγ⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨γ, hγ⟩
    have _ : AlgebraicGeometry.IsZariskiLocalAtSource @AlgebraicGeometry.Etale :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (P := @AlgebraicGeometry.Etale) (Q := @RingHom.Etale)
    have hWH_et : AlgebraicGeometry.Etale (W_H.ι ≫ p) := by
      refine AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
        (P := @AlgebraicGeometry.Etale) U_cov h_top fun γ => ?_
      have _ : AlgebraicGeometry.Etale ((V_et_chart γ).ι ≫ p) := hEt_chart γ
      have h_factor : (U_cov γ).ι ≫ W_H.ι ≫ p =
          (W_H.ι ∣_ V_et_chart γ) ≫ (V_et_chart γ).ι ≫ p := by
        rw [← CategoryTheory.Category.assoc (W_H.ι ∣_ V_et_chart γ),
          AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
      rw [h_factor]
      infer_instance
    have hcomp : AlgebraicGeometry.Etale ((p ∣_ W_y) ≫ W_y.ι) := by
      rwa [AlgebraicGeometry.morphismRestrict_ι]
    exact CategoryTheory.MorphismProperty.of_postcomp
      (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
      (p ∣_ W_y) W_y.ι inferInstance hcomp
  refine ⟨W_y, hy_Wy, hEt_Wy, fun z hz_Wy => ?_⟩
  have hz_et : z ∈ V_et := h_pre_Wy hz_Wy
  obtain ⟨γ, hz_γ⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_et
  have hv_chart : ιH.base z ∈ V_chart γ := hVet_le_VH γ hz_γ
  exact ⟨W_sm_chart γ, hV_le_Wsm γ hv_chart, hSm_W γ⟩

theorem weil_irreducibleComponent_reduced_subscheme_integral_proper {P S : AlgebraicGeometry.Scheme.{u}}
    (π : P ⟶ S)
    (hProp : AlgebraicGeometry.IsProper π)
    (E : Set ↥P)
    (hE : E ∈ irreducibleComponents ↥P) :
    ∃ (C : AlgebraicGeometry.Scheme.{u}) (ι_C : C ⟶ P),
      AlgebraicGeometry.IsClosedImmersion ι_C ∧
      AlgebraicGeometry.IsIntegral C ∧
      Set.range ι_C.base = E ∧
      topologicalKrullDim ↥C = topologicalKrullDim ↥E ∧
      AlgebraicGeometry.IsProper (ι_C ≫ π) ∧
      ∀ (U : P.Opens),
        AlgebraicGeometry.IsAffineOpen U →
        IsDomain ↑(P.presheaf.obj (Opposite.op U)) →
        (U : Set ↥P) ⊆ E →
        Function.Bijective (ι_C.app U).hom :=
by
  have hClosedE : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  let Z_E : TopologicalSpace.Closeds ↥P := ⟨E, hClosedE⟩
  let I_E : P.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_E
  let C : AlgebraicGeometry.Scheme.{u} := I_E.subscheme
  let ι_C : C ⟶ P := I_E.subschemeι
  have hClC : AlgebraicGeometry.IsClosedImmersion ι_C := inferInstance
  have hCoeSupp : (I_E.support : Set ↥P) = E :=
    AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal Z_E
  have hSuppEq : I_E.support = Z_E := SetLike.coe_injective hCoeSupp
  have hRange : Set.range ι_C.base = E := by
    change Set.range ⇑(CategoryTheory.ConcreteCategory.hom I_E.subschemeι.base) = E
    rw [I_E.range_subschemeι, hCoeSupp]
  have _ : AlgebraicGeometry.IsProper π := hProp
  have hPropComp : AlgebraicGeometry.IsProper (ι_C ≫ π) := inferInstance
  let e_E : ↥C ≃ₜ ↥E :=
    (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_C).toIsEmbedding.toHomeomorph.trans
      (Homeomorph.setCongr hRange)
  have hDim : topologicalKrullDim ↥C = topologicalKrullDim ↥E :=
    e_E.isHomeomorph.topologicalKrullDim_eq
  have hIrredE : IrreducibleSpace ↥E := isIrreducible_iff_irreducibleSpace.mp hE.1
  have hIrredC : IrreducibleSpace ↥C := by
    rw [irreducibleSpace_def]
    have hImg : IsIrreducible (⇑e_E.symm '' (Set.univ : Set ↥E)) :=
      (IrreducibleSpace.isIrreducible_univ ↥E).image e_E.symm e_E.symm.continuous.continuousOn
    rwa [Set.image_univ, e_E.symm.surjective.range_eq] at hImg
  have hRadEq : I_E.radical = I_E := by
    have hvs := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support (I := I_E)
    rw [hSuppEq] at hvs
    exact hvs.symm
  have hChartRed : ∀ V : P.affineOpens,
      _root_.IsReduced ↑(C.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map ι_C.base).obj V.1))) := by
    intro V
    have hRadIdeal : (I_E.ideal V).IsRadical := by
      apply Ideal.radical_eq_iff.mp
      rw [← I_E.radical_ideal V, hRadEq]
    have _ : _root_.IsReduced (↑(P.presheaf.obj (Opposite.op V.1)) ⧸ I_E.ideal V) :=
      (Ideal.isRadical_iff_quotient_reduced (I_E.ideal V)).mp hRadIdeal
    let e_obj := (I_E.subschemeObjIso V).commRingCatIsoToRingEquiv
    exact isReduced_of_injective e_obj e_obj.injective
  have hStalkRed : ∀ x : ↥C, _root_.IsReduced ↑(C.presheaf.stalk x) := by
    intro x
    obtain ⟨V₀, hV₀, hxV₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := ι_C.base x) (U := (⊤ : P.Opens)) trivial
    let W : C.Opens := (TopologicalSpace.Opens.map ι_C.base).obj V₀
    have hxW : x ∈ W := hxV₀
    have hW : AlgebraicGeometry.IsAffineOpen W := hV₀.preimage ι_C
    have _ : _root_.IsReduced ↑(C.presheaf.obj (Opposite.op W)) := hChartRed ⟨V₀, hV₀⟩
    let R_W : Type u := ↑(C.presheaf.obj (Opposite.op W))
    letI : Algebra R_W ↑(C.presheaf.stalk x) := C.presheaf.algebra_section_stalk ⟨x, hxW⟩
    let M_x : Submonoid R_W := (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
    have _ : IsLocalization.AtPrime ↑(C.presheaf.stalk x) (hW.primeIdealOf ⟨x, hxW⟩).asIdeal :=
      hW.isLocalization_stalk ⟨x, hxW⟩
    have _ : _root_.IsReduced (Localization M_x) := inferInstance
    let e_loc := IsLocalization.algEquiv M_x ↑(C.presheaf.stalk x) (Localization M_x)
    exact isReduced_of_injective e_loc e_loc.injective
  have hRedC : AlgebraicGeometry.IsReduced C :=
    AlgebraicGeometry.isReduced_of_isReduced_stalk C
  have hIntC : AlgebraicGeometry.IsIntegral C :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C
  refine ⟨C, ι_C, hClC, hIntC, hRange, hDim, hPropComp, ?_⟩
  intro U hU hDom hSub
  have _ : IsDomain ↑(P.presheaf.obj (Opposite.op U)) := hDom
  refine ⟨?_, (AlgebraicGeometry.isClosedImmersion_iff_isAffineHom.mp hClC).2 U hU⟩
  rw [RingHom.injective_iff_ker_eq_bot]
  have hKer : RingHom.ker (ι_C.app U).hom = I_E.ideal ⟨U, hU⟩ :=
    I_E.ker_subschemeι_app ⟨U, hU⟩
  rw [hKer, Submodule.eq_bot_iff]
  intro a ha
  have hBo : PrimeSpectrum.basicOpen a = ⊥ := by
    rw [eq_bot_iff]
    intro p hp
    let x : ↥P := hU.fromSpec.base p
    have hxU : x ∈ U := by
      rw [← SetLike.mem_coe, ← hU.range_fromSpec]
      exact ⟨p, rfl⟩
    have hxSupp : x ∈ I_E.support := by
      change x ∈ (I_E.support : Set ↥P)
      rw [hCoeSupp]
      exact hSub hxU
    have hxZero :=
      (AlgebraicGeometry.Scheme.IdealSheafData.mem_support_iff_of_mem
        (I := I_E) (U := ⟨U, hU⟩) hxU).mp hxSupp
    have hxNotBo : x ∉ P.basicOpen a :=
      (P.mem_zeroLocus_iff _ x).mp hxZero a ha
    have hpBo : x ∈ P.basicOpen a := by
      change p ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj (P.basicOpen a)
      rwa [hU.fromSpec_preimage_basicOpen a]
    exact False.elim (hxNotBo hpBo)
  exact ((PrimeSpectrum.basicOpen_eq_bot_iff a).mp hBo).eq_zero

theorem weil_smooth_curve_open_integral_basicOpen_subset_component (K : Type u) [Field K]
    {P : AlgebraicGeometry.Scheme.{u}}
    (π : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (E : Set ↥P)
    (hE : E ∈ irreducibleComponents ↥P)
    (V_sm : P.Opens)
    (hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ π))
    (U_aff : P.Opens)
    (hAff : AlgebraicGeometry.IsAffineOpen U_aff)
    (q : ↥P)
    (hqE : q ∈ E)
    (hqV : q ∈ V_sm)
    (hqU : q ∈ U_aff) :
    ∃ f : ↑(P.presheaf.obj (Opposite.op U_aff)),
      q ∈ P.basicOpen f ∧
      P.basicOpen f ≤ V_sm ∧
      IsDomain ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) ∧
      (P.basicOpen f : Set ↥P) ⊆ E :=
by
  have h_local_etale_field : ∀ (F : Type u) [Field F] (A : Type u) [CommRing A]
      [IsLocalRing A] [Algebra F A] [Algebra.FormallyEtale F A] [Algebra.EssFiniteType F A],
      IsField A := by
    intro F _ A _ _ _ _ _
    obtain ⟨I, _, Ai, hFieldAi, _, φ, _⟩ :=
      (Algebra.FormallyEtale.iff_exists_algEquiv_prod F A).mp inferInstance
    let _ : ∀ i : I, Field (Ai i) := hFieldAi
    have hNonempty : Nonempty I := by
      by_contra hEmp
      rw [not_nonempty_iff] at hEmp
      have : Subsingleton (∀ i : I, Ai i) := inferInstance
      have : Subsingleton A := φ.toEquiv.subsingleton
      exact false_of_nontrivial_of_subsingleton A
    obtain ⟨i₀⟩ := hNonempty
    have hUnique : ∀ j : I, j = i₀ := by
      intro j
      by_contra hj
      classical
      let e : ∀ i : I, Ai i := fun i => if i = i₀ then 1 else 0
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (φ.symm e) with hu | hu
      · have hu' : IsUnit (e j) := by
          have hmap := hu.map ((Pi.evalRingHom Ai j).comp φ.toRingHom)
          simpa using hmap
        have hej : e j = 0 := if_neg hj
        rw [hej] at hu'
        exact not_isUnit_zero hu'
      · have hu' : IsUnit ((1 : Ai i₀) - e i₀) := by
          have hmap := hu.map ((Pi.evalRingHom Ai i₀).comp φ.toRingHom)
          simpa using hmap
        have hei : e i₀ = 1 := if_pos rfl
        rw [hei, sub_self] at hu'
        exact not_isUnit_zero hu'
    let _ : Unique I := ⟨⟨i₀⟩, hUnique⟩
    let e_field : A ≃+* Ai default := φ.toRingEquiv.trans (RingEquiv.piUnique Ai)
    exact MulEquiv.isField (Field.toIsField (Ai default)) e_field.toMulEquiv

  have h_s1 : ∀ (C : Type u) [CommRing C] (h : Polynomial K →+* C),
      h.Etale → ∀ (qI : Ideal C) [qI.IsPrime], IsDomain (Localization.AtPrime qI) := by
    intro C _ h hh qI _
    let _ : Algebra (Polynomial K) C := h.toAlgebra
    have h_alg_eq : algebraMap (Polynomial K) C = h := rfl
    have _ : Algebra.Etale (Polynomial K) C := by
      rw [← RingHom.etale_algebraMap, h_alg_eq]
      exact hh
    have _ : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing (Polynomial K) C
    have _ : Module.Flat (Polynomial K) (Localization.AtPrime qI) :=
      Module.Flat.trans (Polynomial K) C (Localization.AtPrime qI)
    let p₀ : Ideal (Polynomial K) := Ideal.comap h qI
    have _ : p₀.IsPrime := Ideal.IsPrime.comap h
    by_cases hp₀_bot : p₀ = ⊥
    · have _ : Algebra.Etale (FractionRing (Polynomial K))
          (TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C) :=
        Algebra.Etale.baseChange (Polynomial K) C (FractionRing (Polynomial K))
      let g_PK : Polynomial K →+* Localization.AtPrime qI :=
        algebraMap (Polynomial K) (Localization.AtPrime qI)
      have h_unit : ∀ m : nonZeroDivisors (Polynomial K), IsUnit (g_PK m) := by
        intro m
        have hm_ne : (m : Polynomial K) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp m.2
        have hm_not_p₀ : (m : Polynomial K) ∉ p₀ := by
          rw [hp₀_bot, Submodule.mem_bot]
          exact hm_ne
        have hm_not_q : h m ∈ qI.primeCompl := hm_not_p₀
        change IsUnit (algebraMap (Polynomial K) (Localization.AtPrime qI) m)
        rw [IsScalarTower.algebraMap_apply (Polynomial K) C (Localization.AtPrime qI), h_alg_eq]
        exact IsLocalization.map_units (M := qI.primeCompl)
          (Localization.AtPrime qI) ⟨h m, hm_not_q⟩
      let ψ_F : FractionRing (Polynomial K) →+* Localization.AtPrime qI :=
        IsLocalization.lift (M := nonZeroDivisors (Polynomial K))
          (S := FractionRing (Polynomial K)) (g := g_PK) h_unit
      let _ : Algebra (FractionRing (Polynomial K)) (Localization.AtPrime qI) := ψ_F.toAlgebra
      have _ : IsScalarTower (Polynomial K) (FractionRing (Polynomial K))
          (Localization.AtPrime qI) :=
        IsScalarTower.of_algebraMap_eq' (RingHom.ext fun p =>
          (IsLocalization.lift_eq (M := nonZeroDivisors (Polynomial K))
            (S := FractionRing (Polynomial K)) (g := g_PK) h_unit p).symm)
      let θ₀ : TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C →ₐ[Polynomial K]
          Localization.AtPrime qI :=
        Algebra.TensorProduct.lift
          (IsScalarTower.toAlgHom (Polynomial K) (FractionRing (Polynomial K))
            (Localization.AtPrime qI))
          (IsScalarTower.toAlgHom (Polynomial K) C (Localization.AtPrime qI))
          (fun _ _ => Commute.all _ _)
      let _ : Algebra (TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C)
          (Localization.AtPrime qI) := θ₀.toRingHom.toAlgebra
      have _ : IsScalarTower (FractionRing (Polynomial K))
          (TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C)
          (Localization.AtPrime qI) :=
        ⟨fun x y z => by
          rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def]
          change θ₀ (x • y) * z = ψ_F x * (θ₀ y * z)
          induction y using TensorProduct.induction_on with
          | zero => simp
          | tmul a c =>
            change θ₀ (TensorProduct.tmul (Polynomial K) (x * a) c) * z =
              ψ_F x * (θ₀ (TensorProduct.tmul (Polynomial K) a c) * z)
            simp only [θ₀, Algebra.TensorProduct.lift_tmul, IsScalarTower.coe_toAlgHom']
            change (ψ_F (x * a) * algebraMap C (Localization.AtPrime qI) c) * z =
              ψ_F x * ((ψ_F a * algebraMap C (Localization.AtPrime qI) c) * z)
            rw [map_mul]
            ring
          | add y₁ y₂ ih₁ ih₂ =>
            rw [smul_add, map_add, add_mul, map_add, add_mul, mul_add, ih₁, ih₂]⟩
      let M₀ : Submonoid (TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C) :=
        Submonoid.map
          (Algebra.TensorProduct.includeRight : C →ₐ[Polynomial K]
            TensorProduct (Polynomial K) (FractionRing (Polynomial K)) C).toMonoidHom
          qI.primeCompl
      have _ : IsLocalization M₀ (Localization.AtPrime qI) :=
        { map_units := by
            rintro ⟨_, s, hs, rfl⟩
            change IsUnit (θ₀ (Algebra.TensorProduct.includeRight s))
            simp only [θ₀, Algebra.TensorProduct.includeRight_apply,
              Algebra.TensorProduct.lift_tmul, map_one, one_mul, IsScalarTower.coe_toAlgHom']
            exact IsLocalization.map_units (M := qI.primeCompl)
              (Localization.AtPrime qI) ⟨s, hs⟩
          surj := by
            intro b
            obtain ⟨⟨c, s⟩, hbs⟩ := IsLocalization.surj qI.primeCompl b
            refine ⟨⟨Algebra.TensorProduct.includeRight c,
              ⟨Algebra.TensorProduct.includeRight s.1, ⟨s.1, s.2, rfl⟩⟩⟩, ?_⟩
            change b * θ₀ (Algebra.TensorProduct.includeRight s.1) =
              θ₀ (Algebra.TensorProduct.includeRight c)
            simp only [θ₀, Algebra.TensorProduct.includeRight_apply,
              Algebra.TensorProduct.lift_tmul, map_one, one_mul, IsScalarTower.coe_toAlgHom']
            exact hbs
          exists_of_eq := by
            intro z₁ z₂ hz
            change θ₀ z₁ = θ₀ z₂ at hz
            let z := z₁ - z₂
            have hz0 : θ₀ z = 0 := by rw [map_sub, hz, sub_self]
            have h_clear : ∃ (m : nonZeroDivisors (Polynomial K)) (c : C),
                TensorProduct.tmul (Polynomial K) (1 : FractionRing (Polynomial K)) (h m) * z =
                  TensorProduct.tmul (Polynomial K) (1 : FractionRing (Polynomial K)) c := by
              induction z using TensorProduct.induction_on with
              | zero => exact ⟨1, 0, by simp⟩
              | tmul x c₀ =>
                obtain ⟨⟨p, m⟩, hpm⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial K)) x
                refine ⟨m, h p * c₀, ?_⟩
