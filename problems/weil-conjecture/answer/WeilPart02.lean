    let fZ : ↥Z𝔪 → ↥E_spec := fun u => ⟨u.1, hZ𝔪_sub u.2⟩
    have hfZ_cont : Continuous fZ := Continuous.subtype_mk continuous_subtype_val _
    let C₀_set : Set ↥E_spec := (Subtype.val : ↥E_spec → PrimeSpectrum (B ⧸ I)) ⁻¹' Z𝔪
    have hC₀_img : fZ '' Set.univ = C₀_set := by
      ext u
