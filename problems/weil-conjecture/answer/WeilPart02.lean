        change (π (Fin.last s)).toRingHom f = 0 ↔ (MvPolynomial.aeval c) f = 0
        rw [hCompLast, RingHom.comp_apply]
        refine ⟨fun h => MvPolynomial.C_injective _ K (by rw [map_zero]; exact h), fun h => ?_⟩
        rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, h, map_zero]
