            (@inf_le_left _ _ (C_chart μ) (C_chart α))).op).hom
            (u_coord μ β - κ_C (C_chart μ) c * u_coord μ α) =
            v_unit μ α * (C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_right _ _ (C_chart μ) (C_chart α))).op).hom
              (u_coord α β - κ_C (C_chart α) c * u_coord α α) := by
          rw [map_sub, map_mul, map_sub, map_mul, hu_cocycle μ α β, hu_cocycle μ α α,
            hκ_res (C_chart μ) (C_chart μ ⊓ C_chart α) (@inf_le_left _ _ (C_chart μ) (C_chart α)) c,
            hκ_res (C_chart α) (C_chart μ ⊓ C_chart α) (@inf_le_right _ _ (C_chart μ) (C_chart α)) c]
          ring
        rw [h_coc, C.basicOpen_mul, C.basicOpen_of_isUnit (hv_unit μ α)] at hx_res_L
        have hx_res_R := hx_res_L.2
        rw [C.basicOpen_res] at hx_res_R
        exact hx_not_α hx_res_R.2
    obtain ⟨ℓ_z, hℓ_z_coc, hℓ_z_w, hℓ_z_vanish⟩ := h_sep_max 𝔪_z h𝔪_z h𝔪_zw
    have h_sep_S : ∀ q : ↥S_fin,
        ∃ ℓ : (∀ μ : Fin (M₀ + 1), ↑(C.presheaf.obj (Opposite.op (C_chart μ)))),
          (∀ μ ν : Fin (M₀ + 1),
            (C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ μ) =
              v_unit μ ν *
                (C.presheaf.map (CategoryTheory.homOfLE
                  (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ ν)) ∧
          φ_pt ⟨𝔪_w, h𝔪_w⟩ ∈ C.basicOpen (ℓ α) ∧
          ∀ μ : Fin (M₀ + 1), q.1 ∈ C_chart μ → q.1 ∉ C.basicOpen (ℓ μ) := by
      intro ⟨q, hqS⟩
      by_cases hq_α : q ∈ C_chart α
      · have hq_rng : q ∈ Set.range (hAff_C α).fromSpec.base := by
          rw [(hAff_C α).range_fromSpec]
          exact hq_α
        obtain ⟨p_q_raw, hp_q⟩ := hq_rng
        let p_q : PrimeSpectrum A_α := p_q_raw
        have h_pre_q : (fun p : PrimeSpectrum A_α => (hAff_C α).fromSpec.base p) ⁻¹' ({q} : Set ↥C) =
            ({p_q} : Set (PrimeSpectrum A_α)) := by
          ext p'
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact ⟨fun h => h_inj_fromSpec (h.trans hp_q.symm), fun h => h ▸ hp_q⟩
        have h_cl_pq : IsClosed ({p_q} : Set (PrimeSpectrum A_α)) := by
          rw [← h_pre_q]
          exact (hClosedS q hqS).preimage (hAff_C α).fromSpec.base.hom.continuous
        have hmax_q : p_q.asIdeal.IsMaximal :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_q).mp h_cl_pq
        have hne_qw : p_q.asIdeal ≠ 𝔪_w := by
          intro h_eq
          have hp_eq : p_q = ⟨𝔪_w, h𝔪_w.isPrime⟩ := PrimeSpectrum.ext h_eq
          have hq_eq : q = φ_pt ⟨𝔪_w, h𝔪_w⟩ := hp_q.symm.trans (congrArg (hAff_C α).fromSpec.base hp_eq)
          exact hw_not_S (hq_eq ▸ hqS)
        obtain ⟨ℓ_q, hcoc_q, hw_q, hvan_q⟩ := h_sep_max p_q.asIdeal hmax_q hne_qw
        refine ⟨ℓ_q, hcoc_q, hw_q, fun μ hq_μ => ?_⟩
        change q ∈ C_chart μ at hq_μ
        change q ∉ C.basicOpen (ℓ_q μ)
        rw [← hp_q] at hq_μ ⊢
        exact hvan_q μ p_q.isPrime hq_μ
      · refine ⟨fun μ => u_coord μ α, fun μ ν => hu_cocycle μ ν α, ?_, ?_⟩
        · dsimp only
          rw [hu_diag α, C.basicOpen_of_isUnit isUnit_one]
          exact hw_α
        · intro μ _ hq_bo
          rw [hu_bo μ α] at hq_bo
          exact hq_α hq_bo.2
    choose ℓ_S hℓ_S_coc hℓ_S_w hℓ_S_vanish using h_sep_S
    let p_sec : ∀ μ : Fin (M₀ + 1), ↑(C.presheaf.obj (Opposite.op (C_chart μ))) :=
      fun μ => (∏ q ∈ S_fin.attach, ℓ_S q μ) * (ℓ_z μ) ^ (d₀ - S_fin.card)
    refine ⟨φ_pt ⟨𝔪_z, h𝔪_z⟩, φ_pt ⟨𝔪_w, h𝔪_w⟩, α, α, p_sec,
      hz_not_S, hz_α, ?_, hw_α, ?_, ?_, ?_⟩
    · obtain ⟨k_exp, hk_exp⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.sub_ne_zero_of_lt hCard)
      intro hz_bo
      dsimp [p_sec] at hz_bo
      rw [hk_exp, pow_succ, ← mul_assoc, C.basicOpen_mul] at hz_bo
      exact hℓ_z_vanish α h𝔪_z.isPrime hz_α hz_bo.2
    · have h_bo_prod : ∀ s : Finset ↥S_fin,
          φ_pt ⟨𝔪_w, h𝔪_w⟩ ∈ C.basicOpen (∏ q ∈ s, ℓ_S q α) := by
        intro s
        classical
        induction s using Finset.induction_on with
        | empty =>
          rw [Finset.prod_empty, C.basicOpen_of_isUnit isUnit_one]
          exact hw_α
        | insert q s hq ih =>
          rw [Finset.prod_insert hq, C.basicOpen_mul]
          exact ⟨hℓ_S_w q, ih⟩
      have h_bo_pow : ∀ n : ℕ, φ_pt ⟨𝔪_w, h𝔪_w⟩ ∈ C.basicOpen ((ℓ_z α) ^ n) := by
        intro n
        induction n with
        | zero =>
          rw [pow_zero, C.basicOpen_of_isUnit isUnit_one]
          exact hw_α
        | succ n ih =>
          rw [pow_succ, C.basicOpen_mul]
          exact ⟨ih, hℓ_z_w⟩
      dsimp [p_sec]
      rw [C.basicOpen_mul]
      exact ⟨h_bo_prod S_fin.attach, h_bo_pow (d₀ - S_fin.card)⟩
    · intro μ q hqS hq_μ hq_bo
      obtain ⟨c_rem, hc_rem⟩ :=
        Finset.dvd_prod_of_mem (fun x : ↥S_fin => ℓ_S x μ) (Finset.mem_attach S_fin ⟨q, hqS⟩)
      dsimp [p_sec] at hq_bo
      rw [hc_rem, mul_assoc, C.basicOpen_mul] at hq_bo
      exact hℓ_S_vanish ⟨q, hqS⟩ μ hq_μ hq_bo.1
    · intro μ ν
      dsimp [p_sec]
      rw [map_mul, map_prod, map_pow, map_mul, map_prod, map_pow]
      have h_prod_eq : (∏ x ∈ S_fin.attach,
            (C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_S x μ)) =
          (v_unit μ ν) ^ S_fin.card *
            (∏ x ∈ S_fin.attach,
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_S x ν)) := by
        have h_congr : ∀ x ∈ S_fin.attach,
            (C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_S x μ) =
            v_unit μ ν * (C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_S x ν) :=
          fun x _ => hℓ_S_coc x μ ν
        rw [Finset.prod_congr rfl h_congr, Finset.prod_mul_distrib, Finset.prod_const,
          Finset.card_attach]
      rw [h_prod_eq, hℓ_z_coc μ ν, mul_pow]
      have h_card_add : S_fin.card + (d₀ - S_fin.card) = d₀ :=
        Nat.add_sub_of_le hCard.le
      calc ((v_unit μ ν) ^ S_fin.card *
              ∏ x ∈ S_fin.attach,
                (C.presheaf.map (CategoryTheory.homOfLE
                  (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_S x ν)) *
            ((v_unit μ ν) ^ (d₀ - S_fin.card) *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_z ν) ^ (d₀ - S_fin.card))
          = ((v_unit μ ν) ^ S_fin.card * (v_unit μ ν) ^ (d₀ - S_fin.card)) *
              ((∏ x ∈ S_fin.attach,
                (C.presheaf.map (CategoryTheory.homOfLE
                  (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_S x ν)) *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_z ν) ^ (d₀ - S_fin.card)) := by
            ring
        _ = (v_unit μ ν) ^ d₀ *
              ((∏ x ∈ S_fin.attach,
                (C.presheaf.map (CategoryTheory.homOfLE
                  (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_S x ν)) *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (ℓ_z ν) ^ (d₀ - S_fin.card)) := by
            rw [← pow_add, h_card_add]
  obtain ⟨z_star, w_star, μ_z, μ_w, p_sec, hz_not_S, hz_chart, hz_not_p,
      hw_chart, hw_p, hS_vanish_p, hp_cocycle⟩ := h_s3
  refine ⟨hAff_P, hAff_Cinter, hCov_C, z_star, w_star, μ_z, μ_w, p_sec,
    fun μ ν => (v_unit μ ν) ^ d₀,
    hz_not_S, hz_chart, hz_not_p, hw_chart, hw_p, hS_vanish_p, ?_, hp_cocycle, ?_⟩
  · intro μ ν
    exact IsUnit.pow d₀ (hv_unit μ ν)
  · intro μ ν
    have hf_eq : ∀ α : Fin (M₀ + 1), f_sec α = (g_C.app (U_proj α)).hom (s_F α) :=
      fun _ => rfl
    rw [hf_eq μ, hf_eq ν, h_gC_res_L μ ν (s_F μ), h_gC_res_R μ ν (s_F ν),
      hs_F_coc μ ν, map_mul, map_pow]
    rfl

theorem weil_algClosed_cartier_etale_three_secant_over_open (k : Type u) [Field k] [IsAlgClosed k] (M₀ d₀ : ℕ) (hd₀ : 3 ≤ d₀)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀)
    (F : MvPolynomial (Fin (M₀ + 1)) k)
    (H : AlgebraicGeometry.Scheme.{u})
    (ιH : H ⟶ V₁.left)
    (hCartier : IsHomogeneousHypersurfacePullbackOver k M₀ d₀ ι₁ F ιH)
    (hFin : AlgebraicGeometry.IsFinite (ιH ≫ f₁.left))
    (W : B₀.left.Opens)
    (hEt : AlgebraicGeometry.Etale ((ιH ≫ f₁.left) ∣_ W))
    (hSm : ∀ z : H, (ιH ≫ f₁.left).base z ∈ W →
      ∃ W_sm : V₁.left.Opens,
        ιH.base z ∈ W_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left)) :
    IsLocalThreeSecantSmoothSubschemeOver k f₁ W ιH :=
by
  intro K _ _ s hs E hE
  let P_s := CategoryTheory.Limits.pullback f₁.left s
  let π₁ : P_s ⟶ V₁.left := CategoryTheory.Limits.pullback.fst f₁.left s
  let π₂ : P_s ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
    CategoryTheory.Limits.pullback.snd f₁.left s
  have _ : AlgebraicGeometry.IsProper f₁.left := hFib₁.1
  have _ : AlgebraicGeometry.IsClosedImmersion ι₁.left := hCl₁
  have hProp_π₂ : AlgebraicGeometry.IsProper π₂ := inferInstance
  have hDimE : topologicalKrullDim ↥E = (1 : WithBot ℕ∞) :=
    ((hFib₁.2.2.2 K s).2 E hE).1
  by_contra h_not_three
  
  have hSm_pt : ∀ q : ↥P_s, π₁.base q ∈ Set.range ιH.base →
      ∃ W_sm : V₁.left.Opens,
        π₁.base q ∈ W_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left) := by
    rintro q ⟨z, hz⟩
    have hz_W : (ιH ≫ f₁.left).base z ∈ W := by
      have h_eq : (ιH ≫ f₁.left).base z = s.base (π₂.base q) := by
        calc (ιH ≫ f₁.left).base z
            = f₁.left.base (ιH.base z) := rfl
          _ = (π₁ ≫ f₁.left).base q := by rw [hz]; rfl
          _ = (π₂ ≫ s).base q := by rw [CategoryTheory.Limits.pullback.condition]
          _ = s.base (π₂.base q) := rfl
      rw [h_eq]
      exact hs ⟨π₂.base q, rfl⟩
    obtain ⟨W_sm, hz_sm, hSmW⟩ := hSm z hz_W
    exact ⟨W_sm, hz ▸ hz_sm, hSmW⟩
  
  obtain ⟨C, ι_C, hClC, hIntC, hRangeC, hDimC_eq, hPropC, hBijC⟩ :=
    weil_irreducibleComponent_reduced_subscheme_integral_proper π₂ hProp_π₂ E hE
  have _ : AlgebraicGeometry.IsClosedImmersion ι_C := hClC
  have _ : AlgebraicGeometry.IsIntegral C := hIntC
  have _ : AlgebraicGeometry.IsProper (ι_C ≫ π₂) := hPropC
  have hDimC : topologicalKrullDim ↥C = (1 : WithBot ℕ∞) := hDimC_eq.trans hDimE
  have hInjC : Function.Injective ι_C.base :=
    (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_C).injective
  
  have hNoThreeC : ¬ ∃ q₁ q₂ q₃ : ↥C,
      q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
      (ι_C ≫ π₁).base q₁ ∈ Set.range ιH.base ∧
      (ι_C ≫ π₁).base q₂ ∈ Set.range ιH.base ∧
      (ι_C ≫ π₁).base q₃ ∈ Set.range ιH.base := by
    rintro ⟨q₁, q₂, q₃, h12, h13, h23, hH₁, hH₂, hH₃⟩
    have hE₁ : ι_C.base q₁ ∈ E := hRangeC ▸ ⟨q₁, rfl⟩
    have hE₂ : ι_C.base q₂ ∈ E := hRangeC ▸ ⟨q₂, rfl⟩
    have hE₃ : ι_C.base q₃ ∈ E := hRangeC ▸ ⟨q₃, rfl⟩
    obtain ⟨W₁, hW₁, hSm₁⟩ := hSm_pt (ι_C.base q₁) hH₁
    obtain ⟨W₂, hW₂, hSm₂⟩ := hSm_pt (ι_C.base q₂) hH₂
    obtain ⟨W₃, hW₃, hSm₃⟩ := hSm_pt (ι_C.base q₃) hH₃
    exact h_not_three ⟨ι_C.base q₁, ι_C.base q₂, ι_C.base q₃, W₁, W₂, W₃,
      hInjC.ne h12, hInjC.ne h13, hInjC.ne h23,
      hE₁, hE₂, hE₃, hH₁, hH₂, hH₃,
      hW₁, hSm₁, hW₂, hSm₂, hW₃, hSm₃⟩
  have hFinsetS : ∃ S_fin : Finset ↥C,
      S_fin.card ≤ 2 ∧
      ∀ q : ↥C, q ∈ S_fin ↔ (ι_C ≫ π₁).base q ∈ Set.range ιH.base := by
    classical
    by_cases h1 : ∃ q₁ : ↥C, (ι_C ≫ π₁).base q₁ ∈ Set.range ιH.base
    · obtain ⟨q₁, hq₁⟩ := h1
      by_cases h2 : ∃ q₂ : ↥C, q₂ ≠ q₁ ∧ (ι_C ≫ π₁).base q₂ ∈ Set.range ιH.base
      · obtain ⟨q₂, hq₂_ne, hq₂⟩ := h2
        refine ⟨{q₁, q₂}, ?_, fun q => ?_⟩
        · exact le_trans (Finset.card_insert_le q₁ {q₂}) (by simp)
        · simp only [Finset.mem_insert, Finset.mem_singleton]
          refine ⟨?_, fun hq => ?_⟩
          · rintro (rfl | rfl) <;> assumption
          · by_contra h_neither
            rw [not_or] at h_neither
            exact hNoThreeC ⟨q₁, q₂, q, hq₂_ne.symm, Ne.symm h_neither.1, Ne.symm h_neither.2,
              hq₁, hq₂, hq⟩
      · refine ⟨{q₁}, by simp, fun q => ?_⟩
        simp only [Finset.mem_singleton]
        exact ⟨fun h => h ▸ hq₁, fun hq => by_contra fun hne => h2 ⟨q, hne, hq⟩⟩
    · refine ⟨∅, by simp, fun q => ?_⟩
      simp only [Finset.notMem_empty, false_iff]
      exact fun hq => h1 ⟨q, hq⟩
  obtain ⟨S_fin, hS_card_le, hS_mem⟩ := hFinsetS
  have hCard : S_fin.card < d₀ := by omega
  
  obtain ⟨hClH, hF, _hRangeH, hKerH⟩ := hCartier
  have _ : AlgebraicGeometry.IsClosedImmersion ιH := hClH
  have _ : AlgebraicGeometry.IsFinite (ιH ≫ f₁.left) := hFin
  have hClosedS : ∀ q ∈ S_fin, IsClosed ({q} : Set ↥C) := by
    let H_K := CategoryTheory.Limits.pullback π₁ ιH
    let j_K : H_K ⟶ P_s := CategoryTheory.Limits.pullback.fst π₁ ιH
    let p_H : H_K ⟶ H := CategoryTheory.Limits.pullback.snd π₁ ιH
    have hPb_HK : CategoryTheory.IsPullback p_H (j_K ≫ π₂) (ιH ≫ f₁.left) s :=
      (CategoryTheory.IsPullback.of_hasPullback π₁ ιH).flip.paste_vert
        (CategoryTheory.IsPullback.of_hasPullback f₁.left s)
    let g_HK : H_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) := j_K ≫ π₂
    have _ : AlgebraicGeometry.IsFinite g_HK :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_HK hFin
    have _ : AlgebraicGeometry.IsAffineHom g_HK := (AlgebraicGeometry.isFinite_iff g_HK).mp ‹_› |>.1
    have _ : AlgebraicGeometry.IsAffine H_K := AlgebraicGeometry.isAffine_of_isAffineHom g_HK
    have hFin_top : (g_HK.app ⊤).hom.Finite :=
      (AlgebraicGeometry.isFinite_iff g_HK).mp ‹_› |>.2 ⊤ (AlgebraicGeometry.isAffineOpen_top _)
    let φ_K : K →+* ↑Γ(H_K, ⊤) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ g_HK.app ⊤).hom
    have hInt_φ : φ_K.IsIntegral := by
      change (g_HK.app ⊤).hom.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom |>.IsIntegral
      refine RingHom.IsIntegral.trans _ _ ?_ hFin_top.to_isIntegral
      exact RingHom.isIntegral_of_surjective _
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.symm.surjective
    let hHomeo_HK : ↥H_K ≃ₜ PrimeSpectrum ↑Γ(H_K, ⊤) :=
      TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso H_K.isoSpec)
    have hClosed_HK : ∀ x : ↥H_K, IsClosed ({x} : Set ↥H_K) := by
      intro x
      let p : PrimeSpectrum ↑Γ(H_K, ⊤) := hHomeo_HK x
      have hp_max : p.asIdeal.IsMaximal := by
        rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
        have _ : p.asIdeal.IsPrime := p.isPrime
        have _ : IsDomain (↑Γ(H_K, ⊤) ⧸ p.asIdeal) := Ideal.Quotient.isDomain p.asIdeal
        let ψ : K →+* (↑Γ(H_K, ⊤) ⧸ p.asIdeal) := (Ideal.Quotient.mk p.asIdeal).comp φ_K
        have hInt_ψ : ψ.IsIntegral :=
          RingHom.IsIntegral.trans _ _ hInt_φ
            (RingHom.isIntegral_of_surjective _ Ideal.Quotient.mk_surjective)
        let _ : Algebra K (↑Γ(H_K, ⊤) ⧸ p.asIdeal) := ψ.toAlgebra
        have _ : Algebra.IsIntegral K (↑Γ(H_K, ⊤) ⧸ p.asIdeal) := ⟨hInt_ψ⟩
        exact (@Algebra.IsIntegral.isField_iff_isField K (↑Γ(H_K, ⊤) ⧸ p.asIdeal) _ _ _ _ _
          ψ.injective).mp (Field.toIsField K)
      have hClosed_p : IsClosed ({p} : Set (PrimeSpectrum ↑Γ(H_K, ⊤))) :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mpr hp_max
      have h_pre : hHomeo_HK ⁻¹' ({p} : Set (PrimeSpectrum ↑Γ(H_K, ⊤))) = {x} := by
        ext y
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact ⟨fun h => hHomeo_HK.injective h, fun h => h ▸ rfl⟩
      rw [← h_pre]
      exact hClosed_p.preimage hHomeo_HK.continuous
    intro q hqS
    have hq_pre : ι_C.base q ∈ π₁.base ⁻¹' Set.range ιH.base := (hS_mem q).mp hqS
    rw [← AlgebraicGeometry.Scheme.Pullback.range_fst] at hq_pre
    obtain ⟨x, hx⟩ := hq_pre
    have hClosed_Ps : IsClosed ({ι_C.base q} : Set ↥P_s) := by
      have h_img : j_K.base '' ({x} : Set ↥H_K) = {ι_C.base q} := by
        rw [Set.image_singleton, hx]
