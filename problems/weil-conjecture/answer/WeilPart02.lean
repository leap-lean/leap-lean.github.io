      have : Algebra.FiniteType k κ_z := hFT_φz
      have hBij_φz : Function.Bijective φ_z.hom :=
        ⟨φ_z.hom.injective, hNull_surj κ_z⟩
      have : CategoryTheory.IsIso π_z := by
        rw [← hπz_eq]
        exact AlgebraicGeometry.isIso_SpecMap_iff.mpr hBij_φz
      refine ⟨CategoryTheory.inv π_z ≫ g_z, inferInstance, ?_, ?_⟩
      · dsimp [π_z]
        rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id]
      · intro pt
        exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply z.1
          ((CategoryTheory.inv π_z).base pt)

    choose e he_closed he_hom he_base using hPointImm
    let R_fam : ι → CommRingCat.{u} := fun _ => CommRingCat.of k
    have : CategoryTheory.IsIso (AlgebraicGeometry.sigmaSpec R_fam) := inferInstance
    let Z₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of (ι → k))
    let g_desc : (∐ fun i : ι => AlgebraicGeometry.Spec (R_fam i)) ⟶ V_norm.left :=
      CategoryTheory.Limits.Sigma.desc e
    let ιZ₁ : Z₁ ⟶ V_norm.left :=
      CategoryTheory.inv (AlgebraicGeometry.sigmaSpec R_fam) ≫ g_desc

    
    have hSurjStalk_e : ∀ z : ι, AlgebraicGeometry.SurjectiveOnStalks (e z) := fun z => by
      have : AlgebraicGeometry.IsClosedImmersion (e z) := he_closed z
      infer_instance
    have : AlgebraicGeometry.SurjectiveOnStalks g_desc :=
      AlgebraicGeometry.IsZariskiLocalAtSource.sigmaDesc
        (P := @AlgebraicGeometry.SurjectiveOnStalks) hSurjStalk_e
    have : AlgebraicGeometry.SurjectiveOnStalks ιZ₁ := inferInstance

    
    let ev_hom : ∀ z : ι, CommRingCat.of (ι → k) ⟶ CommRingCat.of k :=
      fun z => CommRingCat.ofHom (Pi.evalRingHom (fun _ : ι => k) z)
    let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := (⟨⊥, hBotPrime k⟩ : PrimeSpectrum k)
    let p_of : ι → ↥Z₁ := fun z => (AlgebraicGeometry.Spec.map (ev_hom z)).base pt_k

    have hp_of_comp : ∀ z : ι, AlgebraicGeometry.Spec.map (ev_hom z) ≫ ιZ₁ = e z := by
      intro z
      have hσ := AlgebraicGeometry.ι_sigmaSpec R_fam z
      change AlgebraicGeometry.Spec.map (ev_hom z) ≫
        CategoryTheory.inv (AlgebraicGeometry.sigmaSpec R_fam) ≫ g_desc = e z
      rw [← hσ, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc,
        CategoryTheory.Limits.Sigma.ι_comp_desc]

    have hp_of_base : ∀ z : ι, ιZ₁.base (p_of z) = z.1 := by
      intro z
      change (AlgebraicGeometry.Spec.map (ev_hom z) ≫ ιZ₁).base pt_k = z.1
      rw [hp_of_comp z]
      exact he_base z pt_k

    have hp_of_surj : Function.Surjective p_of := by
      let _ : Fintype ι := Fintype.ofFinite ι
      let _ : DecidableEq ι := Classical.decEq ι
      intro p
      have hsum1 : (∑ z : ι, Pi.single z (1 : k)) = (1 : ι → k) := by
        ext i
        simp [Pi.single_apply]
      have h_ex : ∃ z : ι, Pi.single z (1 : k) ∉ p.asIdeal := by
        by_contra hall
        have h1_mem : (1 : ι → k) ∈ p.asIdeal := by
          rw [← hsum1]
          exact Ideal.sum_mem p.asIdeal fun z _ => by_contra fun hz => hall ⟨z, hz⟩
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1_mem)
      obtain ⟨z, hz_not⟩ := h_ex
      refine ⟨z, PrimeSpectrum.ext (Ideal.ext fun f => ?_)⟩
      change f z ∈ (⊥ : Ideal k) ↔ f ∈ p.asIdeal
      rw [Ideal.mem_bot]
      let c_f : ι → k := fun _ => f z
      have hmul0 : Pi.single z (1 : k) * (f - c_f) = 0 := by
        ext i
        by_cases hiz : i = z
        · subst hiz; simp [c_f]
        · simp [Pi.single_eq_of_ne hiz]
      have hdiff_mem : f - c_f ∈ p.asIdeal := by
        rcases p.isPrime.mem_or_mem (hmul0 ▸ p.asIdeal.zero_mem) with h1 | h2
        · exact absurd h1 hz_not
        · exact h2
      constructor
      · intro hfz0
        have hc0 : c_f = 0 := funext fun _ => hfz0
        simpa [hc0] using hdiff_mem
      · intro hf_mem
        by_contra hfz_ne
        have hcf_mem : c_f ∈ p.asIdeal := by
          have := p.asIdeal.sub_mem hf_mem hdiff_mem
          simpa using this
        have hunit : c_f * (fun _ => (f z)⁻¹) = 1 := by
          ext i
          exact mul_inv_cancel₀ hfz_ne
        have h1_mem : (1 : ι → k) ∈ p.asIdeal :=
          hunit ▸ p.asIdeal.mul_mem_right _ hcf_mem
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1_mem)

    have hInj_ιZ₁ : Function.Injective ιZ₁.base := by
      intro p₁ p₂ hp_eq
      obtain ⟨z₁, rfl⟩ := hp_of_surj p₁
      obtain ⟨z₂, rfl⟩ := hp_of_surj p₂
      rw [hp_of_base z₁, hp_of_base z₂] at hp_eq
      exact congrArg p_of (Subtype.ext hp_eq)

    have : Finite ↥Z₁ := Finite.of_surjective p_of hp_of_surj
    have hClosedMap_ιZ₁ : IsClosedMap ιZ₁.base := by
      intro C _
      have hEq_biUnion : ιZ₁.base '' C = ⋃ p ∈ C, ({ιZ₁.base p} : Set ↥V_norm.left) := by
        ext y
        simp only [Set.mem_image, Set.mem_iUnion, Set.mem_singleton_iff]
        exact ⟨fun ⟨p, hpC, hpy⟩ => ⟨p, hpC, hpy.symm⟩,
          fun ⟨p, hpC, hyp⟩ => ⟨p, hpC, hyp.symm⟩⟩
      rw [hEq_biUnion]
      refine C.toFinite.isClosed_biUnion fun p _ => ?_
      obtain ⟨z, rfl⟩ := hp_of_surj p
      rw [hp_of_base z]
      exact hClosedPts z.1 z.2

    have hClEmb : Topology.IsClosedEmbedding ιZ₁.base :=
      Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap
        ιZ₁.base.hom.continuous hInj_ιZ₁ hClosedMap_ιZ₁
    have hClosedImm_ιZ₁ : AlgebraicGeometry.IsClosedImmersion ιZ₁ :=
      (AlgebraicGeometry.isClosedImmersion_iff ιZ₁).mpr ⟨inferInstance, hClEmb⟩

    
    let α_pi : CommRingCat.of k ⟶ CommRingCat.of (ι → k) :=
      CommRingCat.ofHom (algebraMap k (ι → k))
    have h_desc_hom : AlgebraicGeometry.sigmaSpec R_fam ≫ AlgebraicGeometry.Spec.map α_pi =
        g_desc ≫ V_norm.hom := by
      refine CategoryTheory.Limits.Sigma.hom_ext _ _ fun z => ?_
      have hLHS : CategoryTheory.Limits.Sigma.ι (fun i : ι => AlgebraicGeometry.Spec (R_fam i)) z ≫
          AlgebraicGeometry.sigmaSpec R_fam ≫ AlgebraicGeometry.Spec.map α_pi =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.ι_sigmaSpec R_fam z,
          ← AlgebraicGeometry.Spec.map_comp]
        have hcomp_id : α_pi ≫ ev_hom z = 𝟙 (CommRingCat.of k) := by
          ext c
          rfl
        rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
      have hRHS : CategoryTheory.Limits.Sigma.ι (fun i : ι => AlgebraicGeometry.Spec (R_fam i)) z ≫
          g_desc ≫ V_norm.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.Sigma.ι_comp_desc, he_hom z]
      exact hLHS.trans hRHS.symm

    have h_ιZ₁_f₁ : ιZ₁ ≫ f₁.left =
        AlgebraicGeometry.Spec.map α_pi ≫ CategoryTheory.inv B₀.hom := by
      rw [hf₁_eq]
      dsimp [ιZ₁]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc g_desc,
        ← h_desc_hom, CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id_assoc]

    have : α_pi.hom.Finite := RingHom.finite_algebraMap.mpr inferInstance
    have : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map α_pi) :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff α_pi).mpr ‹_›
    have hFin_Z₁ : AlgebraicGeometry.IsFinite (ιZ₁ ≫ f₁.left) := by
      rw [h_ιZ₁_f₁]
      infer_instance

    have : Algebra.Etale k (ι → k) :=
      (Algebra.Etale.iff_exists_algEquiv_prod k (ι → k)).mpr
        ⟨ι, inferInstance, fun _ => k, fun _ => inferInstance, fun _ => inferInstance,
          AlgEquiv.refl, fun _ => ⟨inferInstance, inferInstance⟩⟩
    have : α_pi.hom.Etale := RingHom.etale_algebraMap.mpr inferInstance
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map α_pi) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr ‹_›
    have : AlgebraicGeometry.Etale (ιZ₁ ≫ f₁.left) := by
      rw [h_ιZ₁_f₁]
      infer_instance
    have hEt_Z₁ : AlgebraicGeometry.Etale ((ιZ₁ ≫ f₁.left) ∣_ (⊤ : B₀.left.Opens)) :=
      inferInstance

    refine ⟨Z₁, ιZ₁, hClosedImm_ιZ₁, inferInstance, hFin_Z₁, hEt_Z₁, ?_⟩
    intro x hxZ
    exact ⟨p_of ⟨x, hxZ⟩, hp_of_base ⟨x, hxZ⟩⟩

theorem weil_projectiveOverField_pullback_of_isSeparated (k : Type u) [Field k]
    (X₁ X₂ Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g₁ : X₁ ⟶ Z) (g₂ : X₂ ⟶ Z)
    [AlgebraicGeometry.IsSeparated Z.hom]
    (hProj₁ : IsProjectiveOverField k X₁)
    (hProj₂ : IsProjectiveOverField k X₂) :
    IsProjectiveOverField k
      (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.fst g₁.left g₂.left ≫ X₁.hom)) :=
by
  obtain ⟨N₁, ι₁, hCl₁⟩ := hProj₁
  obtain ⟨N₂, ι₂, hCl₂⟩ := hProj₂

  
  have hPart1 :
      ∃ (j : CategoryTheory.Limits.pullback g₁.left g₂.left ⟶
          CategoryTheory.Limits.pullback (weilProjectiveSpaceOver k N₁).hom
            (weilProjectiveSpaceOver k N₂).hom),
        AlgebraicGeometry.IsClosedImmersion j ∧
        j ≫ CategoryTheory.Limits.pullback.fst
            (weilProjectiveSpaceOver k N₁).hom (weilProjectiveSpaceOver k N₂).hom ≫
          (weilProjectiveSpaceOver k N₁).hom =
          CategoryTheory.Limits.pullback.fst g₁.left g₂.left ≫ X₁.hom := by
    let P₁ := weilProjectiveSpaceOver k N₁
    let P₂ := weilProjectiveSpaceOver k N₂
    let μ := CategoryTheory.Limits.pullback.mapDesc g₁.left g₂.left Z.hom
    let c := (CategoryTheory.Limits.pullback.congrHom
      (CategoryTheory.Over.w g₁) (CategoryTheory.Over.w g₂)).hom
    let δ₁₂ : CategoryTheory.Limits.pullback g₁.left g₂.left ⟶
        CategoryTheory.Limits.pullback X₁.hom X₂.hom := μ ≫ c
    have hCl_δ : AlgebraicGeometry.IsClosedImmersion δ₁₂ :=
      AlgebraicGeometry.IsClosedImmersion.comp μ c
    have hδ_fst : δ₁₂ ≫ CategoryTheory.Limits.pullback.fst X₁.hom X₂.hom =
        CategoryTheory.Limits.pullback.fst g₁.left g₂.left := by
      dsimp [δ₁₂, μ, c]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
    let m₁ : CategoryTheory.Limits.pullback X₁.hom X₂.hom ⟶
        CategoryTheory.Limits.pullback P₁.hom X₂.hom :=
      CategoryTheory.Limits.pullback.map X₁.hom X₂.hom P₁.hom X₂.hom
        ι₁.left (𝟙 X₂.left) (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Over.w ι₁])
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hm₁_fst : m₁ ≫ CategoryTheory.Limits.pullback.fst P₁.hom X₂.hom =
        CategoryTheory.Limits.pullback.fst X₁.hom X₂.hom ≫ ι₁.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm₁_snd : m₁ ≫ CategoryTheory.Limits.pullback.snd P₁.hom X₂.hom =
        CategoryTheory.Limits.pullback.snd X₁.hom X₂.hom := by
      dsimp [m₁]
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have hSq₁ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst X₁.hom X₂.hom) m₁
        ι₁.left (CategoryTheory.Limits.pullback.fst P₁.hom X₂.hom) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hm₁_fst.symm
        (CategoryTheory.IsPullback.of_hasPullback P₁.hom X₂.hom)
      rw [hm₁_snd, CategoryTheory.Over.w ι₁]
      exact CategoryTheory.IsPullback.of_hasPullback X₁.hom X₂.hom
    have hCl_m₁ : AlgebraicGeometry.IsClosedImmersion m₁ :=
      CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.IsClosedImmersion) hSq₁ hCl₁
    let m₂ : CategoryTheory.Limits.pullback P₁.hom X₂.hom ⟶
        CategoryTheory.Limits.pullback P₁.hom P₂.hom :=
      CategoryTheory.Limits.pullback.map P₁.hom X₂.hom P₁.hom P₂.hom
        (𝟙 P₁.left) ι₂.left (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Over.w ι₂])
    have hm₂_fst : m₂ ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom =
        CategoryTheory.Limits.pullback.fst P₁.hom X₂.hom := by
      dsimp [m₂]
      rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
    have hm₂_snd : m₂ ≫ CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom =
        CategoryTheory.Limits.pullback.snd P₁.hom X₂.hom ≫ ι₂.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hSq₂ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd P₁.hom X₂.hom) m₂
        ι₂.left (CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hm₂_snd.symm
        (CategoryTheory.IsPullback.of_hasPullback P₁.hom P₂.hom).flip
      rw [hm₂_fst, CategoryTheory.Over.w ι₂]
      exact (CategoryTheory.IsPullback.of_hasPullback P₁.hom X₂.hom).flip
    have hCl_m₂ : AlgebraicGeometry.IsClosedImmersion m₂ :=
      CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.IsClosedImmersion) hSq₂ hCl₂
    refine ⟨δ₁₂ ≫ m₁ ≫ m₂, ?_, ?_⟩
    · exact @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ δ₁₂ (m₁ ≫ m₂) hCl_δ
        (@AlgebraicGeometry.IsClosedImmersion.comp _ _ _ m₁ m₂ hCl_m₁ hCl_m₂)
    · calc (δ₁₂ ≫ m₁ ≫ m₂) ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom ≫ P₁.hom
          = δ₁₂ ≫ m₁ ≫ (m₂ ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom) ≫ P₁.hom := by
              simp only [CategoryTheory.Category.assoc]
        _ = δ₁₂ ≫ (m₁ ≫ CategoryTheory.Limits.pullback.fst P₁.hom X₂.hom) ≫ P₁.hom := by
              rw [hm₂_fst, CategoryTheory.Category.assoc m₁]
        _ = (δ₁₂ ≫ CategoryTheory.Limits.pullback.fst X₁.hom X₂.hom) ≫ (ι₁.left ≫ P₁.hom) := by
              rw [hm₁_fst]; simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst g₁.left g₂.left ≫ X₁.hom := by
              rw [hδ_fst, CategoryTheory.Over.w ι₁]

  
  let _ : ∀ (K : ℕ), GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) :=
    fun _ => MvPolynomial.gradedAlgebra
  have hX : ∀ (K : ℕ) (a : Fin (K + 1)),
      MvPolynomial.X a ∈ MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 1 :=
    fun _ a => MvPolynomial.isHomogeneous_X k a
  have hHomLoc : ∀ (K : ℕ),
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (K + 1) → MvPolynomial (Fin (K + 1)) k)) ∧
      ∀ (i₀ : Fin (K + 1)),
        HomogeneousLocalization.Away.isLocalizationElem
          (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)
          (hX K i₀) (hX K i₀) = 1 ∧
        Subring.closure
          (Set.range ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)
              (Submonoid.powers (MvPolynomial.X i₀))).comp
              (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 0))) ∪
            Set.range (fun a : Fin (K + 1) =>
              HomogeneousLocalization.Away.isLocalizationElem
                (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k)
                (hX K i₀) (hX K a))) = ⊤ := by
    intro K
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k
    have h_sum_mk : ∀ {R : Type u} [CommRing R] {S : Submonoid R} {ι : Type}
        (s : Finset ι) (f : ι → R) (y : S),
        (∑ x ∈ s, Localization.mk (f x) y) = Localization.mk (∑ x ∈ s, f x) y := by
      intro R _ S ι s f y
      classical
      induction s using Finset.induction_on with
      | empty => simp [Localization.mk_zero]
      | @insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
    have h_prod_mk : ∀ {R : Type u} [CommRing R] {S : Submonoid R} {ι : Type}
        (s : Finset ι) (f : ι → R) (g : ι → S),
        (∏ x ∈ s, Localization.mk (f x) (g x)) =
          Localization.mk (∏ x ∈ s, f x)
            ⟨∏ x ∈ s, (g x : R), Submonoid.prod_mem S fun x _ => (g x).2⟩ := by
      intro R _ S ι s f g
      classical
      induction s using Finset.induction_on with
      | empty => simp
      | @insert a s ha ih =>
        simp only [Finset.prod_insert ha, ih, Localization.mk_mul]
        rfl
    have h_hom_deg : ∀ {d : ℕ} {P : MvPolynomial (Fin (K + 1)) k},
        P.IsHomogeneous d → ∀ {m : Fin (K + 1) →₀ ℕ}, P.coeff m ≠ 0 → (∑ a : Fin (K + 1), m a) = d := by
      intro d P hP m hm
      have hw := hP hm
      rw [Finsupp.weight_apply, Finsupp.sum_fintype m _ (fun _ => by simp)] at hw
      simpa [smul_eq_mul, mul_one] using hw
    refine ⟨?_, ?_⟩
    · rw [HomogeneousIdeal.toIdeal_irrelevant_le]
      intro d hd P hP
      have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hP
      rw [MvPolynomial.as_sum P]
      refine Ideal.sum_mem _ fun m hm => ?_
      have hm_ne : P.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      have hm_deg : (∑ a : Fin (K + 1), m a) = d := h_hom_deg hP_hom hm_ne
      have hex : ∃ a₀ : Fin (K + 1), m a₀ ≠ 0 := by
        by_contra h_all
        have h0 : (∑ a : Fin (K + 1), m a) = 0 :=
          Finset.sum_eq_zero fun a _ => Classical.not_not.mp fun h => h_all ⟨a, h⟩
        omega
      obtain ⟨a₀, ha₀_ne⟩ := hex
      have ha₀_le : Finsupp.single a₀ 1 ≤ m := by
        intro b
        by_cases hb : b = a₀
        · subst hb; simp; omega
        · rw [Finsupp.single_eq_of_ne hb]; exact Nat.zero_le _
      have hm_split : (m - Finsupp.single a₀ 1) + Finsupp.single a₀ 1 = m :=
        tsub_add_cancel_of_le ha₀_le
      have h_mon : (MvPolynomial.monomial m) (P.coeff m) =
          (MvPolynomial.monomial (m - Finsupp.single a₀ 1)) (P.coeff m) * MvPolynomial.X a₀ := by
        rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one, hm_split]
      rw [h_mon]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a₀, rfl⟩)
    · intro i₀
      have h_self : HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) (hX K i₀) (hX K i₀) = 1 := by
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_one]
        change (HomogeneousLocalization.Away.mk 𝒜 (hX K i₀) 1 (MvPolynomial.X i₀ ^ 1) _).val = 1
        rw [HomogeneousLocalization.Away.val_mk]
        exact Localization.mk_self ⟨MvPolynomial.X i₀ ^ 1, Submonoid.pow_mem _ (Submonoid.mem_powers _) 1⟩
      refine ⟨h_self, ?_⟩
      rw [eq_top_iff]
      intro w _
      let S_pow := Submonoid.powers (MvPolynomial.X i₀ : MvPolynomial (Fin (K + 1)) k)
      let ι_k : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_pow).comp (algebraMap k ↥(𝒜 0))
      let r : Fin (K + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        fun a => HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜) (hX K i₀) (hX K a)
      let S_gen : Set (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀)) :=
        Set.range ι_k ∪ Set.range r
      obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX K i₀) w
      have hP' : P ∈ 𝒜 d := by simpa [smul_eq_mul, mul_one] using hP
      have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hP'
      let w' : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        ∑ m ∈ P.support, ι_k (P.coeff m) * ∏ a : Fin (K + 1), (r a) ^ (m a)
      have hw'_mem : w' ∈ Subring.closure S_gen := by
        refine Subring.sum_mem _ fun m _ => Subring.mul_mem _ ?_ ?_
        · exact Subring.subset_closure (s := S_gen) (Or.inl ⟨P.coeff m, rfl⟩)
        · refine Subring.prod_mem _ fun a _ => ?_
          exact Subring.pow_mem _ (Subring.subset_closure (s := S_gen) (Or.inr ⟨a, rfl⟩)) (m a)
      suffices h_eq : w' = HomogeneousLocalization.Away.mk 𝒜 (hX K i₀) d P hP by
        rwa [← h_eq]
      rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk]
      have h_val_hom : ∀ x : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀),
          x.val = algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀)) (Localization S_pow) x :=
        fun x => (HomogeneousLocalization.algebraMap_apply x).symm
      rw [h_val_hom]
      simp only [w', map_sum, map_mul, map_prod, map_pow]
      have h_term : ∀ m ∈ P.support,
          algebraMap _ (Localization S_pow) (ι_k (P.coeff m)) *
            (∏ a : Fin (K + 1), (algebraMap _ (Localization S_pow) (r a)) ^ (m a)) =
          Localization.mk ((MvPolynomial.monomial m) (P.coeff m))
            ⟨MvPolynomial.X i₀ ^ d, Submonoid.pow_mem _ (Submonoid.mem_powers _) d⟩ := by
        intro m hm
        have hm_ne : P.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
        have hm_deg : (∑ a : Fin (K + 1), m a) = d := h_hom_deg hP_hom hm_ne
        have h_ik : algebraMap _ (Localization S_pow) (ι_k (P.coeff m)) =
            Localization.mk (MvPolynomial.C (P.coeff m)) 1 := by
          rw [HomogeneousLocalization.algebraMap_apply]
          rfl
        have h_ra : ∀ a : Fin (K + 1),
            (algebraMap _ (Localization S_pow) (r a)) ^ (m a) =
            Localization.mk (MvPolynomial.X a ^ m a)
              ⟨MvPolynomial.X i₀ ^ m a, Submonoid.pow_mem _ (Submonoid.mem_powers _) (m a)⟩ := by
          intro a
          rw [HomogeneousLocalization.algebraMap_apply]
          change ((HomogeneousLocalization.Away.mk 𝒜 (hX K i₀) 1
            (MvPolynomial.X a ^ 1) _).val) ^ (m a) = _
          rw [HomogeneousLocalization.Away.val_mk, pow_one, Localization.mk_pow]
          congr 1
          ext
          simp
        simp_rw [h_ik, h_ra]
        rw [h_prod_mk, Localization.mk_mul]
        have h_num : MvPolynomial.C (P.coeff m) * (∏ a : Fin (K + 1), MvPolynomial.X a ^ m a) =
            (MvPolynomial.monomial m) (P.coeff m) := by
          rw [MvPolynomial.monomial_eq]
          congr 1
          exact (Finsupp.prod_of_support_subset m (Finset.subset_univ _) _ (fun _ _ => pow_zero _)).symm
        have h_den : (1 : S_pow) * ⟨∏ a : Fin (K + 1), MvPolynomial.X i₀ ^ m a,
            Submonoid.prod_mem S_pow fun a _ => Submonoid.pow_mem _ (Submonoid.mem_powers _) (m a)⟩ =
            ⟨MvPolynomial.X i₀ ^ d, Submonoid.pow_mem _ (Submonoid.mem_powers _) d⟩ := by
          ext
          simp [Finset.prod_pow_eq_pow_sum, hm_deg]
        rw [h_num, h_den]
      rw [Finset.sum_congr rfl h_term, h_sum_mk, ← MvPolynomial.as_sum P]

  
  let M : ℕ := (N₁ + 1) * (N₂ + 1) - 1
  have h_pos : 0 < (N₁ + 1) * (N₂ + 1) := Nat.mul_pos (Nat.succ_pos _) (Nat.succ_pos _)
  have h_card : (N₁ + 1) * (N₂ + 1) = M + 1 := (Nat.sub_add_cancel h_pos).symm
  let e : Fin (M + 1) ≃ Fin (N₁ + 1) × Fin (N₂ + 1) :=
    (finProdFinEquiv.trans (Fin.castOrderIso h_card).toEquiv).symm
  let _ : ∀ {K : ℕ} (S : Submonoid (MvPolynomial (Fin (K + 1)) k)),
      Algebra k (HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) S) :=
    fun {K} S =>
      ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) S).comp
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 0))).toAlgebra

  have hPart3 :
      ∃ (σ : CategoryTheory.Limits.pullback (weilProjectiveSpaceOver k N₁).hom
            (weilProjectiveSpaceOver k N₂).hom ⟶
          (weilProjectiveSpaceOver k M).left),
        AlgebraicGeometry.IsClosedImmersion σ ∧
        σ ≫ (weilProjectiveSpaceOver k M).hom =
          CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver k N₁).hom
            (weilProjectiveSpaceOver k N₂).hom ≫ (weilProjectiveSpaceOver k N₁).hom := by
    let p_hom (K : ℕ) :
        AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of k) :=
      (weilProjectiveSpaceOver k K).hom
    have h_away_hom : ∀ (K : ℕ) (f : MvPolynomial (Fin (K + 1)) k) {m : ℕ}
        (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k m) (hm : 0 < m),
        AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) f hf hm ≫
          p_hom K =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap k (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) f))) := by
      intro K f m hf hm
      change AlgebraicGeometry.Proj.awayι _ f hf hm ≫
        (AlgebraicGeometry.Proj.toSpecZero _ ≫ AlgebraicGeometry.Spec.map _) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]

    let 𝒰₁ := (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan
      (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k)
      MvPolynomial.X (hX N₁) (fun _ => zero_lt_one) (hHomLoc N₁).1).openCover
    let 𝒰₂ := (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan
      (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k)
      MvPolynomial.X (hX N₂) (fun _ => zero_lt_one) (hHomLoc N₂).1).openCover
    let 𝒰_M := (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan
      (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
      MvPolynomial.X (hX M) (fun _ => zero_lt_one) (hHomLoc M).1).openCover
    let 𝒰₁₂ := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂)

    let A (i : Fin (N₁ + 1)) :=
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k) (MvPolynomial.X i)
    let B (j : Fin (N₂ + 1)) :=
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k) (MvPolynomial.X j)
    let C (ν : Fin (M + 1)) :=
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X ν)

    let c_ij (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :=
      CategoryTheory.Limits.pullback.congrHom
        (h_away_hom N₁ (MvPolynomial.X ij.1) (hX N₁ ij.1) zero_lt_one)
        (h_away_hom N₂ (MvPolynomial.X ij.2) (hX N₂ ij.2) zero_lt_one)
    let θ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        𝒰₁₂.X ij ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k (A ij.1) (B ij.2))) :=
      c_ij ij ≪≫ AlgebraicGeometry.pullbackSpecIso k (A ij.1) (B ij.2)

    have hθ_fst : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        (θ ij).hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            A ij.1 →+* TensorProduct k (A ij.1) (B ij.2))) =
        CategoryTheory.Limits.pullback.fst (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) :=
      fun ij =>
        (CategoryTheory.Category.assoc (c_ij ij).hom
          (AlgebraicGeometry.pullbackSpecIso k (A ij.1) (B ij.2)).hom _).trans
          ((congrArg ((c_ij ij).hom ≫ ·)
            (AlgebraicGeometry.pullbackSpecIso_hom_fst k (A ij.1) (B ij.2))).trans
            ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.congrHom_hom _ _)).trans
              ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                (CategoryTheory.Category.comp_id _))))
    have hθ_snd : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        (θ ij).hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ↑(Algebra.TensorProduct.includeRight :
            B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))) =
        CategoryTheory.Limits.pullback.snd (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) :=
      fun ij =>
        (CategoryTheory.Category.assoc (c_ij ij).hom
          (AlgebraicGeometry.pullbackSpecIso k (A ij.1) (B ij.2)).hom _).trans
          ((congrArg ((c_ij ij).hom ≫ ·)
            (AlgebraicGeometry.pullbackSpecIso_hom_snd k (A ij.1) (B ij.2))).trans
            ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.congrHom_hom _ _)).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                (CategoryTheory.Category.comp_id _))))
    have h𝒰₁₂_fst : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂) =
          CategoryTheory.Limits.pullback.fst (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) ≫ 𝒰₁.f ij.1 :=
      fun ij =>
        (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂))
          (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂) ij)).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have h𝒰₁₂_snd : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂) =
          CategoryTheory.Limits.pullback.snd (𝒰₁.f ij.1 ≫ p_hom N₁) (𝒰₂.f ij.2 ≫ p_hom N₂) ≫ 𝒰₂.f ij.2 :=
      fun ij =>
        (congrArg (· ≫ CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂))
          (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂) ij)).trans
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)

    
    let r₁ (i a : Fin (N₁ + 1)) : A i :=
      HomogeneousLocalization.Away.isLocalizationElem (hX N₁ i) (hX N₁ a)
    let r₂ (j b : Fin (N₂ + 1)) : B j :=
      HomogeneousLocalization.Away.isLocalizationElem (hX N₂ j) (hX N₂ b)
    let r_M (ν μ : Fin (M + 1)) : C ν :=
      HomogeneousLocalization.Away.isLocalizationElem (hX M ν) (hX M μ)

    let g_poly (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        MvPolynomial (Fin (M + 1)) k →+* TensorProduct k (A ij.1) (B ij.2) :=
      MvPolynomial.eval₂Hom (algebraMap k (TensorProduct k (A ij.1) (B ij.2)))
        (fun μ => (r₁ ij.1 (e μ).1) ⊗ₜ[k] (r₂ ij.2 (e μ).2))
    have hg_self : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        g_poly ij (MvPolynomial.X (e.symm ij)) = 1 := by
      intro ij
      simp only [g_poly, MvPolynomial.eval₂Hom_X', e.apply_symm_apply]
      dsimp only [r₁, r₂]
      rw [((hHomLoc N₁).2 ij.1).1, ((hHomLoc N₂).2 ij.2).1]
      rfl
    have hg_unit : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        IsUnit (g_poly ij (MvPolynomial.X (e.symm ij))) := by
      intro ij
      rw [hg_self ij]
      exact isUnit_one
    let φ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        C (e.symm ij) →+* TensorProduct k (A ij.1) (B ij.2) :=
      (IsLocalization.Away.lift
        (S := Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k))
        (MvPolynomial.X (e.symm ij)) (hg_unit ij)).comp
        (algebraMap (C (e.symm ij))
          (Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k)))

    have hφ_k : ∀ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) (c : k),
        φ ij (algebraMap k (C (e.symm ij)) c) =
          algebraMap k (TensorProduct k (A ij.1) (B ij.2)) c := by
      intro ij c
      dsimp [φ]
      rw [HomogeneousLocalization.algebraMap_apply]
      change (IsLocalization.Away.lift
        (S := Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k))
        (MvPolynomial.X (e.symm ij)) (hg_unit ij))
        (Localization.mk (MvPolynomial.C c) 1) = _
      rw [Localization.mk_eq_mk']
      refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
      simp [g_poly]

    have hφ_ratio : ∀ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) (μ : Fin (M + 1)),
        φ ij (r_M (e.symm ij) μ) = (r₁ ij.1 (e μ).1) ⊗ₜ[k] (r₂ ij.2 (e μ).2) := by
      intro ij μ
      dsimp [φ, r_M]
      rw [HomogeneousLocalization.algebraMap_apply]
      change (IsLocalization.Away.lift
        (S := Localization.Away (MvPolynomial.X (e.symm ij) : MvPolynomial (Fin (M + 1)) k))
        (MvPolynomial.X (e.symm ij)) (hg_unit ij))
        (HomogeneousLocalization.Away.mk _ (hX M (e.symm ij)) 1 (MvPolynomial.X μ ^ 1) _).val = _
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
      simp [pow_one, hg_self ij, g_poly]

    have hφ_surj : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1), Function.Surjective (φ ij) := by
      intro ij
      let inL : A ij.1 →+* TensorProduct k (A ij.1) (B ij.2) :=
        Algebra.TensorProduct.includeLeftRingHom
      let inR : B ij.2 →+* TensorProduct k (A ij.1) (B ij.2) :=
        ↑(Algebra.TensorProduct.includeRight : B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))
      have h_inL : ∀ w : A ij.1, inL w ∈ (φ ij).range := by
        have h_le : (⊤ : Subring (A ij.1)) ≤ (φ ij).range.comap inL := by
          rw [← ((hHomLoc N₁).2 ij.1).2, Subring.closure_le]
          rintro x (⟨c, rfl⟩ | ⟨a, rfl⟩)
          · refine ⟨algebraMap k (C (e.symm ij)) c, ?_⟩
            rw [hφ_k ij c]
            rfl
          · refine ⟨r_M (e.symm ij) (e.symm (a, ij.2)), ?_⟩
            rw [hφ_ratio, e.apply_symm_apply]
            dsimp only [r₁, r₂]
            rw [((hHomLoc N₂).2 ij.2).1]
            rfl
        exact fun w => h_le trivial
      have h_inR : ∀ z : B ij.2, inR z ∈ (φ ij).range := by
        have h_le : (⊤ : Subring (B ij.2)) ≤ (φ ij).range.comap inR := by
          rw [← ((hHomLoc N₂).2 ij.2).2, Subring.closure_le]
          rintro y (⟨c, rfl⟩ | ⟨b, rfl⟩)
          · refine ⟨algebraMap k (C (e.symm ij)) c, ?_⟩
            change φ ij (algebraMap k (C (e.symm ij)) c) =
              (Algebra.TensorProduct.includeRight :
                B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2)) (algebraMap k (B ij.2) c)
            rw [hφ_k ij c]
            exact ((Algebra.TensorProduct.includeRight :
              B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2)).commutes c).symm
          · refine ⟨r_M (e.symm ij) (e.symm (ij.1, b)), ?_⟩
            rw [hφ_ratio, e.apply_symm_apply]
            dsimp only [r₁, r₂]
            rw [((hHomLoc N₁).2 ij.1).1]
            rfl
        exact fun z => h_le trivial
      intro t
      exact TensorProduct.inductionOn (motive := fun t => t ∈ (φ ij).range) t
        (fun w z => by
          have hw : inL w ∈ (φ ij).range := h_inL w
          have hz : inR z ∈ (φ ij).range := h_inR z
          have hmul : inL w * inR z = w ⊗ₜ[k] z := by
            change (w ⊗ₜ[k] (1 : B ij.2)) * ((1 : A ij.1) ⊗ₜ[k] z) = w ⊗ₜ[k] z
            simp
          rw [← hmul]
          exact (φ ij).range.mul_mem hw hz)
        (fun x y hx hy => (φ ij).range.add_mem hx hy)

    
    let σ_loc (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        𝒰₁₂.X ij ⟶ AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
      (θ ij).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij)) ≫ 𝒰_M.f (e.symm ij)

    have h_away_alg : ∀ {K : ℕ} {f g x : MvPolynomial (Fin (K + 1)) k}
        (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k 1) (hx : x = f * g) (c : k),
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) hg hx
          (algebraMap k _ c) = algebraMap k _ c := by
      intro K f g x hg hx c
      exact HomogeneousLocalization.awayMap_fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (K + 1)) k) hg hx (algebraMap k _ c)

    have h_glue : ∀ (ij i'j' : 𝒰₁₂.I₀),
        CategoryTheory.Limits.pullback.fst (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ≫ σ_loc ij =
          CategoryTheory.Limits.pullback.snd (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ≫ σ_loc i'j' := by
      rintro (⟨i, j⟩ : Fin (N₁ + 1) × Fin (N₂ + 1)) (⟨i', j'⟩ : Fin (N₁ + 1) × Fin (N₂ + 1))
      let ν := e.symm (i, j); let ν' := e.symm (i', j')
      let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k
      let 𝒜₂ := MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k
      let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      let A₂ := HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X i * MvPolynomial.X i')
      let B₂ := HomogeneousLocalization.Away 𝒜₂ (MvPolynomial.X j * MvPolynomial.X j')
      let C₂ := HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X ν * MvPolynomial.X ν')
      let αL : A i →ₐ[k] A₂ :=
        { HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl with
          commutes' := h_away_alg (hX N₁ i') rfl }
      let αR : A i' →ₐ[k] A₂ :=
        { HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i) (mul_comm _ _) with
          commutes' := h_away_alg (hX N₁ i) (mul_comm _ _) }
      let βL : B j →ₐ[k] B₂ :=
        { HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl with
          commutes' := h_away_alg (hX N₂ j') rfl }
      let βR : B j' →ₐ[k] B₂ :=
        { HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j) (mul_comm _ _) with
          commutes' := h_away_alg (hX N₂ j) (mul_comm _ _) }
      let τ_L : TensorProduct k (A i) (B j) →+* TensorProduct k A₂ B₂ :=
        (Algebra.TensorProduct.map αL βL).toRingHom
      let τ_R : TensorProduct k (A i') (B j') →+* TensorProduct k A₂ B₂ :=
        (Algebra.TensorProduct.map αR βR).toRingHom

      
      let G : MvPolynomial (Fin (M + 1)) k →+* TensorProduct k A₂ B₂ := τ_L.comp (g_poly (i, j))
      have hG_ν : G (MvPolynomial.X ν) = 1 := by
        dsimp [G, ν]
        rw [hg_self (i, j), map_one]
      have h_inv_A : αL (r₁ i i') * αR (r₁ i' i) = 1 := by
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_one]
        have hval_mul : ∀ x y : A₂, (x * y).val = x.val * y.val := fun x y => by
          simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
        rw [hval_mul]
        change (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl
            (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i) 1 (MvPolynomial.X i' ^ 1) _)).val *
          (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i) (mul_comm _ _)
            (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i') 1 (MvPolynomial.X i ^ 1) _)).val = 1
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk',
          IsLocalization.mk'_eq_iff_eq]
        congr 1
        simp only [OneMemClass.coe_one, Submonoid.coe_mul]
        ring
      have h_inv_B : βL (r₂ j j') * βR (r₂ j' j) = 1 := by
        rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_one]
        have hval_mul : ∀ x y : B₂, (x * y).val = x.val * y.val := fun x y => by
          simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
        rw [hval_mul]
        change (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl
            (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j) 1 (MvPolynomial.X j' ^ 1) _)).val *
          (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j) (mul_comm _ _)
            (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j') 1 (MvPolynomial.X j ^ 1) _)).val = 1
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
          Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk',
          IsLocalization.mk'_eq_iff_eq]
        congr 1
        simp only [OneMemClass.coe_one, Submonoid.coe_mul]
        ring
      have hG_unit : IsUnit (G (MvPolynomial.X ν * MvPolynomial.X ν')) := by
        rw [map_mul, hG_ν, one_mul]
        have hG_ν' : G (MvPolynomial.X ν') = (αL (r₁ i i')) ⊗ₜ[k] (βL (r₂ j j')) := by
          dsimp [G, τ_L, g_poly, ν']
          simp
        rw [hG_ν']
        refine ⟨⟨(αL (r₁ i i')) ⊗ₜ[k] (βL (r₂ j j')), (αR (r₁ i' i)) ⊗ₜ[k] (βR (r₂ j' j)), ?_, ?_⟩, rfl⟩
        · rw [Algebra.TensorProduct.tmul_mul_tmul, h_inv_A, h_inv_B]
          rfl
        · rw [Algebra.TensorProduct.tmul_mul_tmul, mul_comm (αR _), mul_comm (βR _), h_inv_A, h_inv_B]
          rfl
      let ψ : C₂ →+* TensorProduct k A₂ B₂ :=
        (IsLocalization.Away.lift
          (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
          (MvPolynomial.X ν * MvPolynomial.X ν') hG_unit).comp
          (algebraMap C₂
            (Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k)))
      let γL : C ν →+* C₂ := HomogeneousLocalization.awayMap 𝒜_M (hX M ν') rfl
      let γR : C ν' →+* C₂ := HomogeneousLocalization.awayMap 𝒜_M (hX M ν) (mul_comm _ _)

      have hψ_k : ∀ c : k, ψ (algebraMap k C₂ c) = algebraMap k (TensorProduct k A₂ B₂) c := by
        intro c
        dsimp [ψ]
        rw [HomogeneousLocalization.algebraMap_apply]
        change (IsLocalization.Away.lift
          (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
          _ hG_unit) (Localization.mk (MvPolynomial.C c) 1) = _
        rw [Localization.mk_eq_mk']
        refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
        simp only [OneMemClass.coe_one, map_one, one_mul, G, RingHom.comp_apply, g_poly,
          MvPolynomial.eval₂Hom_C]
        exact (Algebra.TensorProduct.map αL βL).commutes c

      have h_cocycle_L : ψ.comp γL = τ_L.comp (φ (i, j)) := by
        have h_le : (⊤ : Subring (C ν)) ≤ RingHom.eqLocus (ψ.comp γL) (τ_L.comp (φ (i, j))) := by
          rw [← ((hHomLoc M).2 ν).2, Subring.closure_le]
          rintro z (⟨c, rfl⟩ | ⟨μ, rfl⟩)
          · change ψ (γL (algebraMap k (C ν) c)) = τ_L (φ (i, j) (algebraMap k (C ν) c))
            rw [h_away_alg (hX M ν') rfl c, hψ_k c, hφ_k (i, j) c]
            exact ((Algebra.TensorProduct.map αL βL).commutes c).symm
          · change ψ (γL (r_M ν μ)) = τ_L (φ (i, j) (r_M ν μ))
            have h_rhs : τ_L (φ (i, j) (r_M ν μ)) = G (MvPolynomial.X μ) := by
              rw [hφ_ratio (i, j) μ]
              simp [G, g_poly]
            rw [h_rhs]
            dsimp [ψ]
            rw [HomogeneousLocalization.algebraMap_apply]
            change (IsLocalization.Away.lift
              (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
              _ hG_unit)
              (γL (HomogeneousLocalization.Away.mk 𝒜_M (hX M ν) 1 (MvPolynomial.X μ ^ 1) _)).val = _
            rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
              Localization.mk_eq_mk']
            refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
            simp only [pow_one, map_mul, hG_ν, one_mul]
            exact mul_comm _ _
        exact RingHom.ext fun z => h_le trivial

      have h_cocycle_R : ψ.comp γR = τ_R.comp (φ (i', j')) := by
        have h_le : (⊤ : Subring (C ν')) ≤ RingHom.eqLocus (ψ.comp γR) (τ_R.comp (φ (i', j'))) := by
          rw [← ((hHomLoc M).2 ν').2, Subring.closure_le]
          rintro z (⟨c, rfl⟩ | ⟨μ, rfl⟩)
          · change ψ (γR (algebraMap k (C ν') c)) = τ_R (φ (i', j') (algebraMap k (C ν') c))
            rw [h_away_alg (hX M ν) (mul_comm _ _) c, hψ_k c, hφ_k (i', j') c]
            exact ((Algebra.TensorProduct.map αR βR).commutes c).symm
          · change ψ (γR (r_M ν' μ)) = τ_R (φ (i', j') (r_M ν' μ))
            dsimp [ψ]
            rw [HomogeneousLocalization.algebraMap_apply]
            change (IsLocalization.Away.lift
              (S := Localization.Away (MvPolynomial.X ν * MvPolynomial.X ν' : MvPolynomial (Fin (M + 1)) k))
              _ hG_unit)
              (γR (HomogeneousLocalization.Away.mk 𝒜_M (hX M ν') 1 (MvPolynomial.X μ ^ 1) _)).val = _
            rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
              Localization.mk_eq_mk']
            refine (IsLocalization.lift_mk'_spec _ _ _ _).mpr ?_
            rw [hφ_ratio (i', j') μ]
            simp only [pow_one, map_mul, hG_ν, mul_one, one_mul]
            have hG_μ : G (MvPolynomial.X μ) = (αL (r₁ i (e μ).1)) ⊗ₜ[k] (βL (r₂ j (e μ).2)) := by
              simp [G, τ_L, g_poly]
            have hG_ν' : G (MvPolynomial.X ν') = (αL (r₁ i i')) ⊗ₜ[k] (βL (r₂ j j')) := by
              dsimp [G, τ_L, g_poly, ν']
              simp
            have hτR_μ : τ_R ((r₁ i' (e μ).1) ⊗ₜ[k] (r₂ j' (e μ).2)) =
                (αR (r₁ i' (e μ).1)) ⊗ₜ[k] (βR (r₂ j' (e μ).2)) := rfl
            rw [hG_μ, hG_ν', hτR_μ, Algebra.TensorProduct.tmul_mul_tmul]
            have hA_eq : αL (r₁ i (e μ).1) = αL (r₁ i i') * αR (r₁ i' (e μ).1) := by
              rw [HomogeneousLocalization.ext_iff_val]
              have hval_mul : ∀ x y : A₂, (x * y).val = x.val * y.val := fun x y => by
                simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
              rw [hval_mul]
              change (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl
                  (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i) 1 (MvPolynomial.X (e μ).1 ^ 1) _)).val =
                (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i') rfl
                  (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i) 1 (MvPolynomial.X i' ^ 1) _)).val *
                (HomogeneousLocalization.awayMap 𝒜₁ (hX N₁ i) (mul_comm _ _)
                  (HomogeneousLocalization.Away.mk 𝒜₁ (hX N₁ i') 1 (MvPolynomial.X (e μ).1 ^ 1) _)).val
              rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
                HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
                HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
                Localization.mk_mul, Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq]
              congr 1
              simp only [Submonoid.coe_mul]
              ring
            have hB_eq : βL (r₂ j (e μ).2) = βL (r₂ j j') * βR (r₂ j' (e μ).2) := by
              rw [HomogeneousLocalization.ext_iff_val]
              have hval_mul : ∀ x y : B₂, (x * y).val = x.val * y.val := fun x y => by
                simp only [← HomogeneousLocalization.algebraMap_apply, map_mul]
              rw [hval_mul]
              change (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl
                  (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j) 1 (MvPolynomial.X (e μ).2 ^ 1) _)).val =
                (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j') rfl
                  (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j) 1 (MvPolynomial.X j' ^ 1) _)).val *
                (HomogeneousLocalization.awayMap 𝒜₂ (hX N₂ j) (mul_comm _ _)
                  (HomogeneousLocalization.Away.mk 𝒜₂ (hX N₂ j') 1 (MvPolynomial.X (e μ).2 ^ 1) _)).val
              rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
                HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk,
                HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
                Localization.mk_mul, Localization.mk_eq_mk', IsLocalization.mk'_eq_iff_eq]
              congr 1
              simp only [Submonoid.coe_mul]
              ring
            rw [hA_eq, hB_eq]
        exact RingHom.ext fun z => h_le trivial

      
      let πL := CategoryTheory.Limits.pullback.fst (𝒰₁₂.f (i, j)) (𝒰₁₂.f (i', j'))
      let πR := CategoryTheory.Limits.pullback.snd (𝒰₁₂.f (i, j)) (𝒰₁₂.f (i', j'))
      have h_ov₁ : (πL ≫ CategoryTheory.Limits.pullback.fst (𝒰₁.f i ≫ p_hom N₁) (𝒰₂.f j ≫ p_hom N₂)) ≫ 𝒰₁.f i =
          (πR ≫ CategoryTheory.Limits.pullback.fst (𝒰₁.f i' ≫ p_hom N₁) (𝒰₂.f j' ≫ p_hom N₂)) ≫ 𝒰₁.f i' :=
        (CategoryTheory.Category.assoc πL _ _).trans
          ((congrArg (πL ≫ ·) (h𝒰₁₂_fst (i, j)).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (πR ≫ ·) (h𝒰₁₂_fst (i', j'))).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)))))
      have h_ov₂ : (πL ≫ CategoryTheory.Limits.pullback.snd (𝒰₁.f i ≫ p_hom N₁) (𝒰₂.f j ≫ p_hom N₂)) ≫ 𝒰₂.f j =
          (πR ≫ CategoryTheory.Limits.pullback.snd (𝒰₁.f i' ≫ p_hom N₁) (𝒰₂.f j' ≫ p_hom N₂)) ≫ 𝒰₂.f j' :=
        (CategoryTheory.Category.assoc πL _ _).trans
          ((congrArg (πL ≫ ·) (h𝒰₁₂_snd (i, j)).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (πR ≫ ·) (h𝒰₁₂_snd (i', j'))).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)))))
      let o₁ := CategoryTheory.Limits.pullback.lift _ _ h_ov₁ ≫
        (AlgebraicGeometry.Proj.pullbackAwayιIso 𝒜₁ (hX N₁ i) zero_lt_one (hX N₁ i') zero_lt_one rfl).hom
      let o₂ := CategoryTheory.Limits.pullback.lift _ _ h_ov₂ ≫
        (AlgebraicGeometry.Proj.pullbackAwayιIso 𝒜₂ (hX N₂ j) zero_lt_one (hX N₂ j') zero_lt_one rfl).hom
      have ho₁_L : o₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom αL.toRingHom) =
          πL ≫ CategoryTheory.Limits.pullback.fst (𝒰₁.f i ≫ p_hom N₁) (𝒰₂.f j ≫ p_hom N₂) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·)
            (AlgebraicGeometry.Proj.pullbackAwayιIso_hom_SpecMap_awayMap_left
              𝒜₁ (hX N₁ i) zero_lt_one (hX N₁ i') zero_lt_one rfl)).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _))
      have ho₁_R : o₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom αR.toRingHom) =
          πR ≫ CategoryTheory.Limits.pullback.fst (𝒰₁.f i' ≫ p_hom N₁) (𝒰₂.f j' ≫ p_hom N₂) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·)
            (AlgebraicGeometry.Proj.pullbackAwayιIso_hom_SpecMap_awayMap_right
              𝒜₁ (hX N₁ i) zero_lt_one (hX N₁ i') zero_lt_one rfl)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      have ho₂_L : o₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom βL.toRingHom) =
          πL ≫ CategoryTheory.Limits.pullback.snd (𝒰₁.f i ≫ p_hom N₁) (𝒰₂.f j ≫ p_hom N₂) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·)
            (AlgebraicGeometry.Proj.pullbackAwayιIso_hom_SpecMap_awayMap_left
              𝒜₂ (hX N₂ j) zero_lt_one (hX N₂ j') zero_lt_one rfl)).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _))
      have ho₂_R : o₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom βR.toRingHom) =
          πR ≫ CategoryTheory.Limits.pullback.snd (𝒰₁.f i' ≫ p_hom N₁) (𝒰₂.f j' ≫ p_hom N₂) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·)
            (AlgebraicGeometry.Proj.pullbackAwayιIso_hom_SpecMap_awayMap_right
              𝒜₂ (hX N₂ j) zero_lt_one (hX N₂ j') zero_lt_one rfl)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      have ho₁₂ : o₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₂)) =
          o₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₂)) := by
        have h_alg₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₂)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom αL.toRingHom) ≫ (𝒰₁.f i ≫ p_hom N₁) :=
          (congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (RingHom.ext fun c => (αL.commutes c).symm)).trans
            (((congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp _ _)).trans
              (AlgebraicGeometry.Spec.map_comp _ _)).trans
              (congrArg (_ ≫ ·) (h_away_hom N₁ (MvPolynomial.X i) (hX N₁ i) zero_lt_one).symm))
        have h_alg₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₂)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom βL.toRingHom) ≫ (𝒰₂.f j ≫ p_hom N₂) :=
          (congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (RingHom.ext fun c => (βL.commutes c).symm)).trans
            (((congrArg AlgebraicGeometry.Spec.map (CommRingCat.ofHom_comp _ _)).trans
              (AlgebraicGeometry.Spec.map_comp _ _)).trans
              (congrArg (_ ≫ ·) (h_away_hom N₂ (MvPolynomial.X j) (hX N₂ j) zero_lt_one).symm))
        exact (congrArg (o₁ ≫ ·) h_alg₁).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ _) ho₁_L).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (πL ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ _) ho₂_L.symm).trans
                      ((CategoryTheory.Category.assoc _ _ _).trans
                        (congrArg (o₂ ≫ ·) h_alg₂.symm))))))))
      let q_O := CategoryTheory.Limits.pullback.lift o₁ o₂ ho₁₂ ≫
        (AlgebraicGeometry.pullbackSpecIso k A₂ B₂).hom
      have h_qO_inL : q_O ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            A₂ →+* TensorProduct k A₂ B₂)) = o₁ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (AlgebraicGeometry.pullbackSpecIso_hom_fst k A₂ B₂)).trans
            (CategoryTheory.Limits.pullback.lift_fst o₁ o₂ ho₁₂))
      have h_qO_inR : q_O ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ↑(Algebra.TensorProduct.includeRight :
            B₂ →ₐ[k] TensorProduct k A₂ B₂)) = o₂ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (_ ≫ ·) (AlgebraicGeometry.pullbackSpecIso_hom_snd k A₂ B₂)).trans
            (CategoryTheory.Limits.pullback.lift_snd o₁ o₂ ho₁₂))

      have hq_L : q_O ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) = πL ≫ (θ (i, j)).hom := by
        have h_mapL : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫
            (AlgebraicGeometry.pullbackSpecIso k (A i) (B j)).inv ≫
              CategoryTheory.Limits.pullback.fst _ _ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeLeftRingHom : A₂ →+* TensorProduct k A₂ B₂)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom αL.toRingHom) := by
          rw [AlgebraicGeometry.pullbackSpecIso_inv_fst,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (RingHom.ext fun x => by simp [τ_L])
        have h_mapR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫
            (AlgebraicGeometry.pullbackSpecIso k (A i) (B j)).inv ≫
              CategoryTheory.Limits.pullback.snd _ _ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ↑(Algebra.TensorProduct.includeRight : B₂ →ₐ[k] TensorProduct k A₂ B₂)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom βL.toRingHom) := by
          rw [AlgebraicGeometry.pullbackSpecIso_inv_snd,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (RingHom.ext fun y => by simp [τ_L])
        refine (CategoryTheory.cancel_mono (AlgebraicGeometry.pullbackSpecIso k (A i) (B j)).inv).mp
          (CategoryTheory.Limits.pullback.hom_ext ?_ ?_)
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((CategoryTheory.Category.assoc q_O _ _).trans
              ((congrArg (q_O ≫ ·) h_mapL).trans
                ((CategoryTheory.Category.assoc q_O _ _).symm.trans
                  ((congrArg (· ≫ _) h_qO_inL).trans
                    (ho₁_L.trans
                      ((congrArg (πL ≫ ·) (hθ_fst (i, j)).symm).trans
                        ((congrArg (fun m => πL ≫ ((θ (i, j)).hom ≫ m))
                          (AlgebraicGeometry.pullbackSpecIso_inv_fst k (A i) (B j)).symm).trans
                          ((CategoryTheory.Category.assoc πL _ _).symm.trans
                            (CategoryTheory.Category.assoc _ _ _).symm))))))))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((CategoryTheory.Category.assoc q_O _ _).trans
              ((congrArg (q_O ≫ ·) h_mapR).trans
                ((CategoryTheory.Category.assoc q_O _ _).symm.trans
                  ((congrArg (· ≫ _) h_qO_inR).trans
                    (ho₂_L.trans
                      ((congrArg (πL ≫ ·) (hθ_snd (i, j)).symm).trans
                        ((congrArg (fun m => πL ≫ ((θ (i, j)).hom ≫ m))
                          (AlgebraicGeometry.pullbackSpecIso_inv_snd k (A i) (B j)).symm).trans
                          ((CategoryTheory.Category.assoc πL _ _).symm.trans
                            (CategoryTheory.Category.assoc _ _ _).symm))))))))

      have hq_R : q_O ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R) = πR ≫ (θ (i', j')).hom := by
        have h_mapL : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R) ≫
            (AlgebraicGeometry.pullbackSpecIso k (A i') (B j')).inv ≫
              CategoryTheory.Limits.pullback.fst _ _ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.includeLeftRingHom : A₂ →+* TensorProduct k A₂ B₂)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom αR.toRingHom) := by
          rw [AlgebraicGeometry.pullbackSpecIso_inv_fst,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (RingHom.ext fun x => by simp [τ_R])
        have h_mapR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R) ≫
            (AlgebraicGeometry.pullbackSpecIso k (A i') (B j')).inv ≫
              CategoryTheory.Limits.pullback.snd _ _ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ↑(Algebra.TensorProduct.includeRight : B₂ →ₐ[k] TensorProduct k A₂ B₂)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom βR.toRingHom) := by
          rw [AlgebraicGeometry.pullbackSpecIso_inv_snd,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (RingHom.ext fun y => by simp [τ_R])
        refine (CategoryTheory.cancel_mono (AlgebraicGeometry.pullbackSpecIso k (A i') (B j')).inv).mp
          (CategoryTheory.Limits.pullback.hom_ext ?_ ?_)
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((CategoryTheory.Category.assoc q_O _ _).trans
              ((congrArg (q_O ≫ ·) h_mapL).trans
                ((CategoryTheory.Category.assoc q_O _ _).symm.trans
                  ((congrArg (· ≫ _) h_qO_inL).trans
                    (ho₁_R.trans
                      ((congrArg (πR ≫ ·) (hθ_fst (i', j')).symm).trans
                        ((congrArg (fun m => πR ≫ ((θ (i', j')).hom ≫ m))
                          (AlgebraicGeometry.pullbackSpecIso_inv_fst k (A i') (B j')).symm).trans
                          ((CategoryTheory.Category.assoc πR _ _).symm.trans
                            (CategoryTheory.Category.assoc _ _ _).symm))))))))
        · exact (CategoryTheory.Category.assoc _ _ _).trans
            ((CategoryTheory.Category.assoc q_O _ _).trans
              ((congrArg (q_O ≫ ·) h_mapR).trans
                ((CategoryTheory.Category.assoc q_O _ _).symm.trans
                  ((congrArg (· ≫ _) h_qO_inR).trans
                    (ho₂_R.trans
                      ((congrArg (πR ≫ ·) (hθ_snd (i', j')).symm).trans
                        ((congrArg (fun m => πR ≫ ((θ (i', j')).hom ≫ m))
                          (AlgebraicGeometry.pullbackSpecIso_inv_snd k (A i') (B j')).symm).trans
                          ((CategoryTheory.Category.assoc πR _ _).symm.trans
                            (CategoryTheory.Category.assoc _ _ _).symm))))))))

      have hw_L : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γL) ≫ 𝒰_M.f ν =
          AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X ν * MvPolynomial.X ν')
            (SetLike.GradedMonoid.toGradedMul.mul_mem (hX M ν) (hX M ν')) (by positivity) :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_M (hX M ν) zero_lt_one (hX M ν') rfl
      have hw_R : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γR) ≫ 𝒰_M.f ν' =
          AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X ν * MvPolynomial.X ν')
            (SetLike.GradedMonoid.toGradedMul.mul_mem (hX M ν) (hX M ν')) (by positivity) :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_M (hX M ν') zero_lt_one (hX M ν) (mul_comm _ _)

      have h_specL : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ (i, j))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom γL) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← h_cocycle_L, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      have h_specR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom γR) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ (i', j'))) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          h_cocycle_R, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      have h_mid : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ (i, j))) ≫ 𝒰_M.f ν =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ (i', j'))) ≫ 𝒰_M.f ν' :=
        (CategoryTheory.Category.assoc _ _ (𝒰_M.f ν)).symm.trans
          ((congrArg (· ≫ 𝒰_M.f ν) h_specL).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (_ ≫ ·) (hw_L.trans hw_R.symm)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ 𝒰_M.f ν') h_specR).trans
                    (CategoryTheory.Category.assoc _ _ _))))))
      exact (CategoryTheory.Category.assoc πL _ _).symm.trans
        ((congrArg (· ≫ _) hq_L.symm).trans
          ((CategoryTheory.Category.assoc q_O _ _).trans
            ((congrArg (q_O ≫ ·) h_mid).trans
              ((CategoryTheory.Category.assoc q_O _ _).symm.trans
                ((congrArg (· ≫ _) hq_R).trans
                  (CategoryTheory.Category.assoc πR _ _))))))

    let σ : CategoryTheory.Limits.pullback (p_hom N₁) (p_hom N₂) ⟶
        AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
      AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰₁₂ σ_loc h_glue
    have hσ_ι : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1), 𝒰₁₂.f ij ≫ σ = σ_loc ij :=
      AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰₁₂ σ_loc h_glue

    have hσ_hom : σ ≫ p_hom M =
        CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂) ≫ p_hom N₁ := by
      refine AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰₁₂ _ _
        fun (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) => ?_
      have h_alg_φ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (C (e.symm ij)))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.includeLeftRingHom :
              A ij.1 →+* TensorProduct k (A ij.1) (B ij.2))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (A ij.1))) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
          (RingHom.ext fun c => hφ_k ij c)
      exact (CategoryTheory.Category.assoc (𝒰₁₂.f ij) σ (p_hom M)).symm.trans
        ((congrArg (· ≫ p_hom M) (hσ_ι ij)).trans
          (((CategoryTheory.Category.assoc (θ ij).hom _ (p_hom M)).trans
            (congrArg ((θ ij).hom ≫ ·) (CategoryTheory.Category.assoc _ _ (p_hom M)))).trans
            ((congrArg ((θ ij).hom ≫ ·)
              ((congrArg (_ ≫ ·)
                (h_away_hom M (MvPolynomial.X (e.symm ij)) (hX M (e.symm ij)) zero_lt_one)).trans
                (h_alg_φ.trans
                  (congrArg (_ ≫ ·)
                    (h_away_hom N₁ (MvPolynomial.X ij.1) (hX N₁ ij.1) zero_lt_one).symm)))).trans
              ((CategoryTheory.Category.assoc (θ ij).hom _ _).symm.trans
                ((congrArg (· ≫ _) (hθ_fst ij)).trans
                  ((CategoryTheory.Category.assoc _ _ (p_hom N₁)).symm.trans
                    ((congrArg (· ≫ p_hom N₁) (h𝒰₁₂_fst ij).symm).trans
                      (CategoryTheory.Category.assoc _ _ _))))))))

    
    have hCl_σ : AlgebraicGeometry.IsClosedImmersion σ := by
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_openCover
        (P := @AlgebraicGeometry.IsClosedImmersion) 𝒰_M]
      intro (ν₀ : Fin (M + 1))
      obtain ⟨ij₀, rfl⟩ := e.symm.surjective ν₀
      have : AlgebraicGeometry.IsOpenImmersion (𝒰_M.f (e.symm ij₀)) := 𝒰_M.map_prop (e.symm ij₀)
      have : AlgebraicGeometry.IsOpenImmersion (𝒰₁₂.f ij₀) := 𝒰₁₂.map_prop ij₀
      have : AlgebraicGeometry.IsOpenImmersion (𝒰₁.f ij₀.1) := 𝒰₁.map_prop ij₀.1
      have : AlgebraicGeometry.IsOpenImmersion (𝒰₂.f ij₀.2) := 𝒰₂.map_prop ij₀.2
      let g₀ : 𝒰₁₂.X ij₀ ⟶ 𝒰_M.X (e.symm ij₀) :=
        (θ ij₀).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij₀))
      have h_comm₀ : 𝒰₁₂.f ij₀ ≫ σ = g₀ ≫ 𝒰_M.f (e.symm ij₀) :=
        (hσ_ι ij₀).trans (CategoryTheory.Category.assoc _ _ _).symm
      have h_opens : (TopologicalSpace.Opens.map σ.base).obj (𝒰_M.f (e.symm ij₀)).opensRange =
          (𝒰₁₂.f ij₀).opensRange := by
        ext p
        have h_coe_M : (σ.base p ∈ (𝒰_M.f (e.symm ij₀)).opensRange) ↔
            σ.base p ∈ Set.range (𝒰_M.f (e.symm ij₀)).base :=
          Eq.to_iff (congrArg (σ.base p ∈ ·)
            (AlgebraicGeometry.Scheme.Hom.coe_opensRange (𝒰_M.f (e.symm ij₀))))
        have h_coe_12 : (p ∈ (𝒰₁₂.f ij₀).opensRange) ↔
            p ∈ Set.range (𝒰₁₂.f ij₀).base :=
          Eq.to_iff (congrArg (p ∈ ·)
            (AlgebraicGeometry.Scheme.Hom.coe_opensRange (𝒰₁₂.f ij₀)))
        refine h_coe_M.trans (Iff.trans ?_ h_coe_12.symm)
        refine ⟨?_, ?_⟩
        · intro hp
          have h_rng_M : Set.range (𝒰_M.f (e.symm ij₀)).base =
              (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
                (MvPolynomial.X (e.symm ij₀)) :
                  Set (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k))) :=
            (AlgebraicGeometry.Scheme.Hom.coe_opensRange (𝒰_M.f (e.symm ij₀))).symm.trans
              (congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι _ _ _ _))
          have hp_basic : σ.base p ∈ AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) (MvPolynomial.X (e.symm ij₀)) :=
            h_rng_M.subset hp
          let ij : Fin (N₁ + 1) × Fin (N₂ + 1) := 𝒰₁₂.idx p
          obtain ⟨x, hx⟩ := 𝒰₁₂.covers p
          have hσ_x : (σ_loc ij).base x = σ.base p :=
            (congrArg (fun m => m.base x) (hσ_ι ij).symm).trans (congrArg σ.base hx)
          let q_pt : ↥(AlgebraicGeometry.Spec
              (CommRingCat.of (TensorProduct k (A ij.1) (B ij.2)))) := (θ ij).hom.base x
          let q : PrimeSpectrum (TensorProduct k (A ij.1) (B ij.2)) := q_pt
          have hq_pre : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij))).base q_pt ∈
              (TopologicalSpace.Opens.map
                (AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
                  (MvPolynomial.X (e.symm ij)) (hX M (e.symm ij)) zero_lt_one).base).obj
                (AlgebraicGeometry.Proj.basicOpen _ (MvPolynomial.X (e.symm ij₀))) :=
            Eq.mp (congrArg
              (· ∈ (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k)
                (MvPolynomial.X (e.symm ij₀)) : Set _)) hσ_x.symm) hp_basic
          rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen _ (hX M (e.symm ij)) zero_lt_one
            (hX M (e.symm ij₀)) zero_lt_one] at hq_pre
          have hq_not_mem : φ ij (r_M (e.symm ij) (e.symm ij₀)) ∉ q.asIdeal := hq_pre
          rw [hφ_ratio ij (e.symm ij₀), e.apply_symm_apply] at hq_not_mem
          have h_prod_tmul : (r₁ ij.1 ij₀.1) ⊗ₜ[k] (r₂ ij.2 ij₀.2) =
              (Algebra.TensorProduct.includeLeftRingHom (r₁ ij.1 ij₀.1)) *
              (Algebra.TensorProduct.includeRight (r₂ ij.2 ij₀.2)) := by
            change _ = ((r₁ ij.1 ij₀.1) ⊗ₜ[k] (1 : B ij.2)) * ((1 : A ij.1) ⊗ₜ[k] (r₂ ij.2 ij₀.2))
            simp
          rw [h_prod_tmul] at hq_not_mem
          have h_not_L : Algebra.TensorProduct.includeLeftRingHom (r₁ ij.1 ij₀.1) ∉ q.asIdeal :=
            fun h => hq_not_mem (q.asIdeal.mul_mem_right _ h)
          have h_not_R : (Algebra.TensorProduct.includeRight :
              B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2)) (r₂ ij.2 ij₀.2) ∉ q.asIdeal :=
            fun h => hq_not_mem (q.asIdeal.mul_mem_left _ h)
          have h_fst_mem : (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base p ∈
              Set.range (𝒰₁.f ij₀.1).base := by
            let inL_hom : A ij.1 →+* TensorProduct k (A ij.1) (B ij.2) :=
              Algebra.TensorProduct.includeLeftRingHom
            have h_pre₁ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inL_hom)).base q_pt ∈
                (TopologicalSpace.Opens.map
                  (AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k)
                    (MvPolynomial.X ij.1) (hX N₁ ij.1) zero_lt_one).base).obj
                  (AlgebraicGeometry.Proj.basicOpen _ (MvPolynomial.X ij₀.1)) := by
              rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen _ (hX N₁ ij.1) zero_lt_one
                (hX N₁ ij₀.1) zero_lt_one]
              exact h_not_L
            have h_eq₁ : (𝒰₁.f ij.1).base
                ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom inL_hom)).base q_pt) =
                (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base p :=
              (congrArg (fun m => (𝒰₁.f ij.1).base (m.base x)) (hθ_fst ij)).trans
                ((congrArg (fun m => m.base x) (h𝒰₁₂_fst ij).symm).trans
                  (congrArg (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base hx))
            have h_in_basic : (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base p ∈
                AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k) (MvPolynomial.X ij₀.1) :=
              Eq.mp (congrArg
                (· ∈ (AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k)
                  (MvPolynomial.X ij₀.1) : Set _)) h_eq₁) h_pre₁
            have h_rng₁ : (AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k) (MvPolynomial.X ij₀.1) :
                  Set (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k))) =
                Set.range (𝒰₁.f ij₀.1).base :=
              (congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι _ _ _ _)).symm.trans
                (AlgebraicGeometry.Scheme.Hom.coe_opensRange (𝒰₁.f ij₀.1))
            exact h_rng₁.subset h_in_basic
          have h_snd_mem : (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base p ∈
              Set.range (𝒰₂.f ij₀.2).base := by
            let inR_hom : B ij.2 →+* TensorProduct k (A ij.1) (B ij.2) :=
              ↑(Algebra.TensorProduct.includeRight :
                B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))
            have h_pre₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inR_hom)).base q_pt ∈
                (TopologicalSpace.Opens.map
                  (AlgebraicGeometry.Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k)
                    (MvPolynomial.X ij.2) (hX N₂ ij.2) zero_lt_one).base).obj
                  (AlgebraicGeometry.Proj.basicOpen _ (MvPolynomial.X ij₀.2)) := by
              rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen _ (hX N₂ ij.2) zero_lt_one
                (hX N₂ ij₀.2) zero_lt_one]
              exact h_not_R
            have h_eq₂ : (𝒰₂.f ij.2).base
                ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom inR_hom)).base q_pt) =
                (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base p :=
              (congrArg (fun m => (𝒰₂.f ij.2).base (m.base x)) (hθ_snd ij)).trans
                ((congrArg (fun m => m.base x) (h𝒰₁₂_snd ij).symm).trans
                  (congrArg (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base hx))
            have h_in_basic : (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base p ∈
                AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k) (MvPolynomial.X ij₀.2) :=
              Eq.mp (congrArg
                (· ∈ (AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k)
                  (MvPolynomial.X ij₀.2) : Set _)) h_eq₂) h_pre₂
            have h_rng₂ : (AlgebraicGeometry.Proj.basicOpen
                  (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k) (MvPolynomial.X ij₀.2) :
                  Set (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k))) =
                Set.range (𝒰₂.f ij₀.2).base :=
              (congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι _ _ _ _)).symm.trans
                (AlgebraicGeometry.Scheme.Hom.coe_opensRange (𝒰₂.f ij₀.2))
            exact h_rng₂.subset h_in_basic
          have h_rng12 : Set.range (𝒰₁₂.f ij₀).base =
              (CategoryTheory.Limits.pullback.fst (p_hom N₁) (p_hom N₂)).base ⁻¹' Set.range (𝒰₁.f ij₀.1).base ∩
                (CategoryTheory.Limits.pullback.snd (p_hom N₁) (p_hom N₂)).base ⁻¹' Set.range (𝒰₂.f ij₀.2).base :=
            (congrArg (fun m => Set.range m.base)
              (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰₁ 𝒰₂ (p_hom N₁) (p_hom N₂) ij₀)).trans
              (AlgebraicGeometry.Scheme.Pullback.range_map _ _ _ _ _ _ _ _ _)
          exact h_rng12.symm.subset ⟨h_fst_mem, h_snd_mem⟩
        · rintro ⟨x, rfl⟩
          exact ⟨g₀.base x, (congrArg (fun m => m.base x) h_comm₀).symm⟩

      have h_pb : CategoryTheory.IsPullback (𝒰₁₂.f ij₀) g₀ σ (𝒰_M.f (e.symm ij₀)) :=
        (AlgebraicGeometry.IsOpenImmersion.isPullback g₀ (𝒰₁₂.f ij₀)
          (𝒰_M.f (e.symm ij₀)) σ h_comm₀ h_opens).flip
      have h_pull_eq : AlgebraicGeometry.Scheme.Cover.pullbackHom 𝒰_M σ (e.symm ij₀) =
          h_pb.isoPullback.inv ≫ g₀ :=
        h_pb.isoPullback_inv_snd.symm
      have hCl_spec : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij₀))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ (hφ_surj ij₀)
      have hCl_g₀ : AlgebraicGeometry.IsClosedImmersion g₀ :=
        @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ (θ ij₀).hom _ inferInstance hCl_spec
      have hCl_inv_g₀ : AlgebraicGeometry.IsClosedImmersion (h_pb.isoPullback.inv ≫ g₀) :=
        @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ h_pb.isoPullback.inv g₀
          inferInstance hCl_g₀
      exact Eq.mpr (congrArg AlgebraicGeometry.IsClosedImmersion h_pull_eq) hCl_inv_g₀

    exact ⟨σ, hCl_σ, hσ_hom⟩

  
  obtain ⟨j, hCl_j, hj_hom⟩ := hPart1
  obtain ⟨σ, hCl_σ, hσ_hom⟩ := hPart3
  have hCl_comp : AlgebraicGeometry.IsClosedImmersion (j ≫ σ) :=
    @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ j σ hCl_j hCl_σ
  have h_over : (j ≫ σ) ≫ (weilProjectiveSpaceOver k M).hom =
      CategoryTheory.Limits.pullback.fst g₁.left g₂.left ≫ X₁.hom := by
    rw [CategoryTheory.Category.assoc, hσ_hom, ← CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, hj_hom]
  exact ⟨M, CategoryTheory.Over.homMk (j ≫ σ) h_over, hCl_comp⟩

theorem weil_projCenterCompl_linearProjection_and_point_unique (k : Type u) [Field k] (m : ℕ) :
    let P_amb := weilProjectiveSpaceOver k (m + 1)
    let B₀ := weilProjectiveSpaceOver k m
    let U_proj := weilProjCenterComplOpen k m
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
      MvPolynomial.gradedAlgebra
    (⨆ b : Fin (m + 1),
      AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) (MvPolynomial.X b) = ⊤) ∧
    Nonempty U_proj ∧
    CompactSpace ↥(U_proj : AlgebraicGeometry.Scheme.{u}) ∧
    AlgebraicGeometry.IsIntegral (U_proj : AlgebraicGeometry.Scheme.{u}) ∧
    ∃ (pr_p₀ : (U_proj : AlgebraicGeometry.Scheme.{u}) ⟶ B₀.left)
      (p₀_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P_amb.left),
      IsCenterComplLinearProjection k m pr_p₀ ∧
      (p₀_pt ≫ P_amb.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) ∧
      (Set.range p₀_pt.base ⊆ ((U_proj : Set P_amb.left)ᶜ)) ∧
      (∀ (g_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P_amb.left),
        g_pt ≫ P_amb.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        Set.range g_pt.base ⊆ ((U_proj : Set P_amb.left)ᶜ) →
        g_pt = p₀_pt) :=
by
  
  have hStdCoverAndEquiv : ∀ (N : ℕ),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) = ⊤) ∧
      ∀ (a : Fin (N + 1)) (ha : MvPolynomial.X a ∈ 𝒜 1),
        ∃ (e : MvPolynomial {r : Fin (N + 1) // r ≠ a} k ≃+*
            HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)),
          (∀ c : k,
            e (MvPolynomial.C c) =
              HomogeneousLocalization.fromZeroRingHom 𝒜
                (Submonoid.powers (MvPolynomial.X a))
                (algebraMap k ↥(𝒜 0) c)) ∧
          (∀ (r : Fin (N + 1)) (hr : r ≠ a) (hr_mem : MvPolynomial.X r ∈ 𝒜 1),
            e (MvPolynomial.X ⟨r, hr⟩) =
              HomogeneousLocalization.Away.isLocalizationElem ha hr_mem) := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    refine ⟨?_, ?_⟩
    · apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X
      rw [HomogeneousIdeal.irrelevant_eq_span, Ideal.span_le]
      intro p hp
      simp only [Set.mem_iUnion] at hp
      obtain ⟨i, hi, hpi⟩ := hp
      have hp_hom : p.IsHomogeneous i := (MvPolynomial.mem_homogeneousSubmodule i p).mp hpi
      have hrange : Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k) =
          MvPolynomial.X '' Set.univ := Set.image_univ.symm
      rw [SetLike.mem_coe, hrange, MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      have hd0 : d ≠ 0 := by
        intro h
        subst h
        have hw := hp_hom (MvPolynomial.mem_support_iff.mp hd)
        rw [map_zero] at hw
        exact hi.ne hw
      by_contra h_all
      apply hd0
      ext a
      by_contra ha_ne
      exact h_all ⟨a, Set.mem_univ a, ha_ne⟩
    · intro a ha
      let τ := {r : Fin (N + 1) // r ≠ a}
      let P := MvPolynomial (Fin (N + 1)) k
      let Pτ := MvPolynomial τ k
      let Xa : P := MvPolynomial.X a
      let S : Submonoid P := Submonoid.powers Xa
      let Ra := HomogeneousLocalization.Away 𝒜 Xa
      have hX : ∀ j : Fin (N + 1), (MvPolynomial.X j : P) ∈ 𝒜 1 := fun j =>
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k j)
      let ι_k : k →+* Ra :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S).comp (algebraMap k ↥(𝒜 0))
      let u : τ → Ra := fun r =>
        HomogeneousLocalization.Away.isLocalizationElem ha (hX r.1)
      let α : Pτ →+* Ra := MvPolynomial.eval₂Hom ι_k u
      let w : Fin (N + 1) → Pτ := fun j => if h : j = a then 1 else MvPolynomial.X ⟨j, h⟩
      let dehom : P →+* Pτ := MvPolynomial.eval₂Hom MvPolynomial.C w
      have hdehom_C : ∀ c : k, dehom (MvPolynomial.C c) = MvPolynomial.C c :=
        fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C w c
      have hdehom_X : ∀ j : Fin (N + 1), dehom (MvPolynomial.X j) = w j :=
        fun j => MvPolynomial.eval₂Hom_X' MvPolynomial.C w j
      have hdehom_S : ∀ y : S, dehom y.1 = 1 := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow, hdehom_X a]
        simp [w]
      have hunit_S : ∀ y : S, IsUnit (dehom y.1) := fun y => by
        rw [hdehom_S y]
        exact isUnit_one
      let β_loc : Localization S →+* Pτ := IsLocalization.lift hunit_S
      have hβ_loc_mk : ∀ (p : P) (y : S), β_loc (Localization.mk p y) = dehom p := by
        intro p y
        rw [Localization.mk_eq_mk']
        apply (IsLocalization.lift_mk'_spec hunit_S p (dehom p) y).mpr
        rw [hdehom_S y, one_mul]
      let valHom : Ra →+* Localization S :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      let β : Ra →+* Pτ := β_loc.comp valHom
      have hι_val : ∀ c : k, (ι_k c).val = Localization.mk (MvPolynomial.C c) 1 :=
        fun _ => rfl
      have hα_C : ∀ c : k, α (MvPolynomial.C c) = ι_k c :=
        fun c => MvPolynomial.eval₂Hom_C ι_k u c
      have hα_X : ∀ r : τ, α (MvPolynomial.X r) = u r :=
        fun r => MvPolynomial.eval₂Hom_X' ι_k u r
      have h_left_hom : β.comp α = RingHom.id Pτ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change β_loc (α (MvPolynomial.C c)).val = MvPolynomial.C c
          rw [hα_C, hι_val, hβ_loc_mk, hdehom_C]
        · intro r
          change β_loc (α (MvPolynomial.X r)).val = MvPolynomial.X r
          have hu_val : (u r).val =
              Localization.mk (MvPolynomial.X r.1 ^ 1) ⟨Xa ^ 1, pow_mem (Submonoid.mem_powers Xa) 1⟩ := rfl
          have hr_ne : r.1 ≠ a := r.2
          rw [hα_X, hu_val, hβ_loc_mk, pow_one, hdehom_X]
          simp [w, hr_ne]
      have h_left : ∀ x : Pτ, β (α x) = x := fun x =>
        congrArg (fun f : Pτ →+* Pτ => f x) h_left_hom
      have h_right : ∀ z : Ra, α (β z) = z := by
        let φ : P →+* Localization S := valHom.comp (α.comp dehom)
        have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
          intro c
          change (α (dehom (MvPolynomial.C c))).val = _
          rw [hdehom_C, hα_C, hι_val]
        have hφ_X : ∀ j : Fin (N + 1),
            φ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) ⟨Xa, Submonoid.mem_powers Xa⟩ := by
          intro j
          change (α (dehom (MvPolynomial.X j))).val = _
          rw [hdehom_X]
          dsimp [w]
          split_ifs with hj
          · subst hj
            rw [map_one, HomogeneousLocalization.val_one]
            exact (Localization.mk_self ⟨Xa, Submonoid.mem_powers Xa⟩).symm
          · rw [hα_X]
            change Localization.mk (MvPolynomial.X j ^ 1) ⟨Xa ^ 1, _⟩ = _
            exact congrArg₂ Localization.mk (pow_one _) (Subtype.ext (pow_one _))
        have hφ_X_pow : ∀ (j : Fin (N + 1)) (e : ℕ),
            φ (MvPolynomial.X j ^ e) =
              Localization.mk (MvPolynomial.X j ^ e) ⟨Xa ^ e, pow_mem (Submonoid.mem_powers Xa) e⟩ := by
          intro j e
          induction e with
          | zero =>
            simp only [pow_zero, map_one]
            rw [← Localization.mk_one]
            congr 1
          | succ e ih =>
            rw [pow_succ, map_mul, ih, hφ_X, Localization.mk_mul]
            exact congrArg₂ Localization.mk rfl (Subtype.ext (pow_succ Xa e).symm)
        have hφ_prod : ∀ (d : Fin (N + 1) →₀ ℕ) (F : Finset (Fin (N + 1))),
            φ (∏ j ∈ F, MvPolynomial.X j ^ d j) =
              Localization.mk (∏ j ∈ F, MvPolynomial.X j ^ d j)
                ⟨Xa ^ (∑ j ∈ F, d j), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
          intro d F
          induction F using Finset.induction_on with
          | empty =>
            simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
            rw [← Localization.mk_one]
            congr 1
          | @insert j F hjF ih =>
            rw [Finset.prod_insert hjF, Finset.sum_insert hjF, map_mul, hφ_X_pow, ih,
              Localization.mk_mul]
            exact congrArg₂ Localization.mk rfl (Subtype.ext (pow_add Xa (d j) _).symm)
        have hφ_mon : ∀ (d : Fin (N + 1) →₀ ℕ) (c : k),
            φ (MvPolynomial.monomial d c) =
              Localization.mk (MvPolynomial.monomial d c)
                ⟨Xa ^ ((Finsupp.weight 1) d), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
          intro d c
          have hw_eq : (Finsupp.weight (1 : Fin (N + 1) → ℕ)) d = ∑ j ∈ d.support, d j := by
            rw [Finsupp.weight_apply]
            change ∑ j ∈ d.support, d j • (1 : ℕ) = ∑ j ∈ d.support, d j
            simp
          rw [MvPolynomial.monomial_eq, map_mul, hφ_C]
          change Localization.mk (MvPolynomial.C c) 1 *
              φ (∏ j ∈ d.support, MvPolynomial.X j ^ d j) = _
          rw [hφ_prod d d.support, Localization.mk_mul]
          refine congrArg₂ Localization.mk ?_ ?_
          · rfl
          · apply Subtype.ext
            change 1 * Xa ^ (∑ j ∈ d.support, d j) = Xa ^ ((Finsupp.weight 1) d)
            rw [one_mul, hw_eq]
        have h_sum_mk : ∀ (F : Finset (Fin (N + 1) →₀ ℕ)) (g : (Fin (N + 1) →₀ ℕ) → P) (s : S),
            (∑ x ∈ F, Localization.mk (g x) s) = Localization.mk (∑ x ∈ F, g x) s := by
          intro F g s
          induction F using Finset.induction_on with
          | empty => simp [Localization.mk_zero]
          | @insert x F hxF ih =>
            rw [Finset.sum_insert hxF, Finset.sum_insert hxF, ih, Localization.add_mk_self]
        intro z
        obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 ha z
        have hp_hom : p.IsHomogeneous n := by
          have hp' : p ∈ 𝒜 n := by simpa using hp
          exact (MvPolynomial.mem_homogeneousSubmodule n p).mp hp'
        let sn : S := ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩
        have hφ_p : φ p = Localization.mk p sn := by
          conv_lhs => rw [MvPolynomial.as_sum p]
          rw [map_sum]
          have h_congr : ∑ d ∈ p.support, φ (MvPolynomial.monomial d (p.coeff d)) =
              ∑ d ∈ p.support, Localization.mk (MvPolynomial.monomial d (p.coeff d)) sn := by
            apply Finset.sum_congr rfl
            intro d hd
            rw [hφ_mon d (p.coeff d)]
            have hd_deg : (Finsupp.weight 1) d = n := hp_hom (MvPolynomial.mem_support_iff.mp hd)
            refine congrArg₂ Localization.mk rfl (Subtype.ext ?_)
            change Xa ^ ((Finsupp.weight 1) d) = Xa ^ n
            rw [hd_deg]
          rw [h_congr, h_sum_mk, ← MvPolynomial.as_sum p]
        apply HomogeneousLocalization.val_injective S
        have hβ_mk : β (HomogeneousLocalization.Away.mk 𝒜 ha n p hp) = dehom p := by
          change β_loc (HomogeneousLocalization.Away.mk 𝒜 ha n p hp).val = dehom p
          rw [HomogeneousLocalization.Away.val_mk, hβ_loc_mk]
        rw [hβ_mk]
        change φ p = (HomogeneousLocalization.Away.mk 𝒜 ha n p hp).val
        rw [hφ_p, HomogeneousLocalization.Away.val_mk]
      let e : Pτ ≃+* Ra :=
        { α with
          invFun := β
          left_inv := h_left
          right_inv := h_right }
      refine ⟨e, ?_, ?_⟩
      · intro c
        exact hα_C c
      · intro r hr hr_mem
        exact hα_X ⟨r, hr⟩

  
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
  let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k
  let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜₀
  let X₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜₁

  let D₀ : Fin (m + 1) → X₀.Opens := fun b =>
    AlgebraicGeometry.Proj.basicOpen 𝒜₀ (MvPolynomial.X b)
  let D₁ : Fin (m + 1) → X₁.Opens := fun b =>
    AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b.castSucc)
  let U₁ : X₁.Opens := ⨆ i : Fin (m + 1), D₁ i

  have hb₀ : ∀ b : Fin (m + 1), (MvPolynomial.X b : MvPolynomial (Fin (m + 1)) k) ∈ 𝒜₀ 1 :=
    fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k b)
  have hX₁ : ∀ r : Fin (m + 1 + 1), (MvPolynomial.X r : MvPolynomial (Fin (m + 1 + 1)) k) ∈ 𝒜₁ 1 :=
    fun r => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k r)
  have hb₁ : ∀ b : Fin (m + 1), (MvPolynomial.X b.castSucc : MvPolynomial (Fin (m + 1 + 1)) k) ∈ 𝒜₁ 1 :=
    fun b => hX₁ b.castSucc
  have hpos : 0 < 1 := zero_lt_one

  obtain ⟨hCov₀, _⟩ := hStdCoverAndEquiv m
  obtain ⟨hCov₁, hEquiv₁⟩ := hStdCoverAndEquiv (m + 1)

  
  have hUproj : Nonempty U₁ := by
    obtain ⟨e₀, _, _⟩ := hEquiv₁ (0 : Fin (m + 1)).castSucc (hb₁ 0)
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := default
    let y₀ : ↥(D₁ 0 : AlgebraicGeometry.Scheme.{u}) :=
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((MvPolynomial.eval 0).comp e₀.symm.toRingHom)) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁
          (MvPolynomial.X (0 : Fin (m + 1)).castSucc) (hb₁ 0) hpos).inv).base pt₀
    exact ⟨⟨y₀.1, le_iSup D₁ 0 y₀.2⟩⟩

  let 𝒰 : (U₁ : AlgebraicGeometry.Scheme.{u}).OpenCover :=
    AlgebraicGeometry.Scheme.Opens.iSupOpenCover D₁

  have hCompU : CompactSpace ↥(U₁ : AlgebraicGeometry.Scheme.{u}) := by
    have hAff : ∀ i : Fin (m + 1), AlgebraicGeometry.IsAffine (D₁ i : AlgebraicGeometry.Scheme.{u}) :=
      fun i => AlgebraicGeometry.IsAffine.of_isIso
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X i.castSucc) (hb₁ i) hpos).hom
    have : Finite 𝒰.I₀ := inferInstanceAs (Finite (Fin (m + 1)))
    have : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsAffine (𝒰.X i) := hAff
    have : ∀ i : 𝒰.I₀, CompactSpace ↥(𝒰.X i) :=
      fun i => AlgebraicGeometry.Scheme.compactSpace_of_isAffine (𝒰.X i)
    exact AlgebraicGeometry.Scheme.OpenCover.compactSpace 𝒰

  have hIntU : AlgebraicGeometry.IsIntegral (U₁ : AlgebraicGeometry.Scheme.{u}) := by
    have hRed_chart : ∀ i : Fin (m + 1),
        AlgebraicGeometry.IsReduced (D₁ i : AlgebraicGeometry.Scheme.{u}) := by
      intro i
      obtain ⟨eᵢ, _, _⟩ := hEquiv₁ i.castSucc (hb₁ i)
      have : IsDomain (HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X i.castSucc)) :=
        MulEquiv.isDomain (MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} k) eᵢ.symm.toMulEquiv
      exact AlgebraicGeometry.isReduced_of_isOpenImmersion
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X i.castSucc) (hb₁ i) hpos).hom
    have : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := hRed_chart
    have : AlgebraicGeometry.IsReduced (U₁ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsReduced.of_openCover (U₁ : AlgebraicGeometry.Scheme.{u}) 𝒰
    let η₀ : ProjectiveSpectrum 𝒜₁ :=
      { asHomogeneousIdeal := ⊥
        isPrime := by
          rw [HomogeneousIdeal.toIdeal_bot]
          exact Ideal.isPrime_bot
        not_irrelevant_le := by
          intro hle
          have hX0_mem : MvPolynomial.X (0 : Fin (m + 1 + 1)) ∈
              (HomogeneousIdeal.irrelevant 𝒜₁).toIdeal := by
            rw [HomogeneousIdeal.irrelevant_eq_span]
            exact Ideal.subset_span
              (Set.mem_iUnion.mpr ⟨1, Set.mem_iUnion.mpr ⟨zero_lt_one, hX₁ 0⟩⟩)
          have hbot : MvPolynomial.X (0 : Fin (m + 1 + 1)) ∈ (⊥ : HomogeneousIdeal 𝒜₁).toIdeal :=
            hle hX0_mem
          rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at hbot
          exact MvPolynomial.X_ne_zero (0 : Fin (m + 1 + 1)) hbot }
    have hη₀_D₁ : η₀ ∈ D₁ 0 := by
      change η₀ ∈ ProjectiveSpectrum.basicOpen 𝒜₁ (MvPolynomial.X (0 : Fin (m + 1)).castSucc)
      rw [ProjectiveSpectrum.mem_basicOpen]
      intro hmem
      change MvPolynomial.X _ ∈ (⊥ : HomogeneousIdeal 𝒜₁).toIdeal at hmem
      rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at hmem
      exact MvPolynomial.X_ne_zero _ hmem
    let u_gen : ↥(U₁ : AlgebraicGeometry.Scheme.{u}) := ⟨η₀, le_iSup D₁ 0 hη₀_D₁⟩
    have hu_gen_mem : ∀ (V : Set ↥(U₁ : AlgebraicGeometry.Scheme.{u})),
        IsOpen V → V.Nonempty → u_gen ∈ V := by
      intro V hV ⟨u, hu⟩
      obtain ⟨W, hW_open, rfl⟩ := U₁.ι.isOpenEmbedding.isInducing.isOpen_iff.mp hV
      let W' : Set (ProjectiveSpectrum 𝒜₁) := W
      obtain ⟨s, hs⟩ := (ProjectiveSpectrum.isOpen_iff 𝒜₁ W').mp hW_open
      by_contra h_not
      have hη₀_compl : η₀ ∈ W'ᶜ := fun h_in => h_not h_in
      rw [hs, ProjectiveSpectrum.mem_zeroLocus] at hη₀_compl
      let u₁ : ProjectiveSpectrum 𝒜₁ := u.1
      have hs_u : s ⊆ ↑u₁.asHomogeneousIdeal := fun f hf =>
        (@bot_le (HomogeneousIdeal 𝒜₁) _ _ u₁.asHomogeneousIdeal) (hη₀_compl hf)
      have hu_compl : u₁ ∈ W'ᶜ := by
        rw [hs, ProjectiveSpectrum.mem_zeroLocus]
        exact hs_u
      exact hu_compl hu
    have : IrreducibleSpace ↥(U₁ : AlgebraicGeometry.Scheme.{u}) :=
      { isPreirreducible_univ := fun V₁ V₂ hV₁ hV₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩ =>
          ⟨u_gen, trivial, hu_gen_mem V₁ hV₁ ⟨x₁, hx₁⟩, hu_gen_mem V₂ hV₂ ⟨x₂, hx₂⟩⟩
        toNonempty := ⟨u_gen⟩ }
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced
      (U₁ : AlgebraicGeometry.Scheme.{u})

  
  have hdeg : ∀ (i : ℕ) (p : MvPolynomial (Fin (m + 1)) k),
      p ∈ 𝒜₀ i → MvPolynomial.rename Fin.castSucc p ∈ 𝒜₁ i := by
    intro i p hp
    rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
    exact hp.rename_isHomogeneous

  let g_hom : 𝒜₀ →+*ᵍ 𝒜₁ :=
    { toRingHom := (MvPolynomial.rename Fin.castSucc).toRingHom
      map_mem := @hdeg }

  have h_le : ∀ b : Fin (m + 1), D₁ b ≤ U₁ := fun b => le_iSup D₁ b
  have hsub : ∀ b : Fin (m + 1),
      Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (m + 1)) k) ≤
        Submonoid.comap g_hom
          (Submonoid.powers (MvPolynomial.X b.castSucc : MvPolynomial (Fin (m + 1 + 1)) k)) := by
    rintro b _ ⟨n, rfl⟩
    exact ⟨n, by simp [g_hom, map_pow, MvPolynomial.rename_X]⟩

  let pr_loc : ∀ b : Fin (m + 1), (D₁ b : AlgebraicGeometry.Scheme.{u}) ⟶ X₀ := fun b =>
    (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos).hom ≫
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (HomogeneousLocalization.map g_hom (hsub b))) ≫
    (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₀ (MvPolynomial.X b) (hb₀ b) hpos).inv ≫
    (D₀ b).ι

  have h_pr_b : ∀ b : Fin (m + 1),
      pr_loc b =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (HomogeneousLocalization.map g_hom (hsub b))) ≫
        AlgebraicGeometry.Proj.awayι 𝒜₀ (MvPolynomial.X b) (hb₀ b) hpos := by
    intro b
    dsimp [pr_loc, D₀]
    rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]

  have h_glue : ∀ (b₁ b₂ : 𝒰.I₀),
      CategoryTheory.Limits.pullback.fst (𝒰.f b₁) (𝒰.f b₂) ≫ pr_loc b₁ =
        CategoryTheory.Limits.pullback.snd (𝒰.f b₁) (𝒰.f b₂) ≫ pr_loc b₂ := by
    intro b₁ b₂
    let b₁' : Fin (m + 1) := b₁
    let b₂' : Fin (m + 1) := b₂
    change CategoryTheory.Limits.pullback.fst
        (X₁.homOfLE (h_le b₁')) (X₁.homOfLE (h_le b₂')) ≫ pr_loc b₁' =
      CategoryTheory.Limits.pullback.snd
        (X₁.homOfLE (h_le b₁')) (X₁.homOfLE (h_le b₂')) ≫ pr_loc b₂'
    let sq := AlgebraicGeometry.isPullback_opens_inf_le (h_le b₁') (h_le b₂')
    rw [← CategoryTheory.cancel_epi sq.isoPullback.hom]
    have h_fst : sq.isoPullback.hom ≫
        CategoryTheory.Limits.pullback.fst
          (X₁.homOfLE (h_le b₁')) (X₁.homOfLE (h_le b₂')) =
        X₁.homOfLE inf_le_left := sq.isoPullback_hom_fst
    have h_snd : sq.isoPullback.hom ≫
        CategoryTheory.Limits.pullback.snd
          (X₁.homOfLE (h_le b₁')) (X₁.homOfLE (h_le b₂')) =
        X₁.homOfLE inf_le_right := sq.isoPullback_hom_snd
    rw [← CategoryTheory.Category.assoc sq.isoPullback.hom, h_fst,
      ← CategoryTheory.Category.assoc sq.isoPullback.hom, h_snd]
    let f₀ : MvPolynomial (Fin (m + 1)) k := MvPolynomial.X b₁' * MvPolynomial.X b₂'
    let f₁ : MvPolynomial (Fin (m + 1 + 1)) k := MvPolynomial.X b₁'.castSucc * MvPolynomial.X b₂'.castSucc
    have hf₀ : f₀ ∈ 𝒜₀ (1 + 1) := SetLike.GradedMonoid.toGradedMul.mul_mem (hb₀ b₁') (hb₀ b₂')
    have hf₁ : f₁ ∈ 𝒜₁ (1 + 1) := SetLike.GradedMonoid.toGradedMul.mul_mem (hb₁ b₁') (hb₁ b₂')
    have hpos₂ : 0 < 1 + 1 := by decide
    have hsub₁₂ : Submonoid.powers f₀ ≤ Submonoid.comap g_hom (Submonoid.powers f₁) := by
      rintro _ ⟨n, rfl⟩
      exact ⟨n, by simp [g_hom, f₀, f₁, map_pow, map_mul, MvPolynomial.rename_X]⟩
    have hmul₁ : AlgebraicGeometry.Proj.basicOpen 𝒜₁ f₁ = D₁ b₁' ⊓ D₁ b₂' :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜₁ (MvPolynomial.X b₁'.castSucc) (MvPolynomial.X b₂'.castSucc)
    let α₁₂ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜₁ f₁)) ⟶
        ((D₁ b₁' ⊓ D₁ b₂' : X₁.Opens) : AlgebraicGeometry.Scheme.{u}) :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ f₁ hf₁ hpos₂).inv ≫
        (X₁.isoOfEq hmul₁).hom
    have : CategoryTheory.IsIso α₁₂ := by
      dsimp [α₁₂]
      infer_instance
    rw [← CategoryTheory.cancel_epi α₁₂]
    have hBranch : ∀ (b b' : Fin (m + 1)) (h_inf : D₁ b₁' ⊓ D₁ b₂' ≤ D₁ b)
        (hx₀ : f₀ = MvPolynomial.X b * MvPolynomial.X b')
        (hx₁ : f₁ = MvPolynomial.X b.castSucc * MvPolynomial.X b'.castSucc),
        α₁₂ ≫ X₁.homOfLE h_inf ≫ pr_loc b =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map g_hom hsub₁₂)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜₀ f₀ hf₀ hpos₂ := by
      intro b b' h_inf hx₀ hx₁
      have h_trans₁ : α₁₂ ≫ X₁.homOfLE h_inf ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.awayMap 𝒜₁ (hb₁ b') hx₁)) := by
        rw [← CategoryTheory.cancel_mono
          (AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos)]
        rw [AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜₁ (hb₁ b) hpos (hb₁ b') hx₁]
        calc (α₁₂ ≫ X₁.homOfLE h_inf ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos).hom) ≫
              AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos
            = α₁₂ ≫ X₁.homOfLE h_inf ≫
                ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos).hom ≫
                ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b.castSucc) (hb₁ b) hpos).inv ≫
                  (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b.castSucc)).ι)) := by
                rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
                simp only [CategoryTheory.Category.assoc]
          _ = α₁₂ ≫ X₁.homOfLE h_inf ≫ (D₁ b).ι := by
                rw [CategoryTheory.Iso.hom_inv_id_assoc]
          _ = α₁₂ ≫ (D₁ b₁' ⊓ D₁ b₂' : X₁.Opens).ι := by
                rw [AlgebraicGeometry.Scheme.homOfLE_ι]
          _ = (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ f₁ hf₁ hpos₂).inv ≫
                ((X₁.isoOfEq hmul₁).hom ≫ (D₁ b₁' ⊓ D₁ b₂' : X₁.Opens).ι) := by
                dsimp [α₁₂]; rw [CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ f₁ hf₁ hpos₂).inv ≫
                (AlgebraicGeometry.Proj.basicOpen 𝒜₁ f₁).ι := by
                rw [AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
          _ = AlgebraicGeometry.Proj.awayι 𝒜₁ f₁ hf₁ hpos₂ :=
                AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₁ f₁ hf₁ hpos₂
      have h_rhs₀ : AlgebraicGeometry.Proj.awayι 𝒜₀ f₀ hf₀ hpos₂ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.awayMap 𝒜₀ (hb₀ b') hx₀)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜₀ (MvPolynomial.X b) (hb₀ b) hpos :=
        (AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜₀ (hb₀ b) hpos (hb₀ b') hx₀).symm
      rw [h_pr_b b, ← CategoryTheory.Category.assoc (X₁.homOfLE h_inf),
        ← CategoryTheory.Category.assoc α₁₂, h_trans₁, h_rhs₀,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 3
      apply RingHom.ext
      intro z
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜₀ (hb₀ b) z
      have ha₁ : g_hom a ∈ 𝒜₁ (n • 1) := hdeg (n • 1) a ha
      have h_map_b : HomogeneousLocalization.map g_hom (hsub b)
          (HomogeneousLocalization.Away.mk 𝒜₀ (hb₀ b) n a ha) =
          HomogeneousLocalization.Away.mk 𝒜₁ (hb₁ b) n (g_hom a) ha₁ := by
        apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X b.castSucc))
        change (HomogeneousLocalization.map g_hom (hsub b)
          (HomogeneousLocalization.mk ⟨n • 1, ⟨a, ha⟩, ⟨MvPolynomial.X b ^ n, _⟩, _⟩)).val = _
        rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.Away.val_mk]
        change Localization.mk (g_hom a) ⟨g_hom (MvPolynomial.X b ^ n), _⟩ =
          Localization.mk (g_hom a) ⟨MvPolynomial.X b.castSucc ^ n, _⟩
        refine congrArg₂ Localization.mk rfl (Subtype.ext ?_)
        simp [g_hom, map_pow, MvPolynomial.rename_X]
      simp only [RingHom.comp_apply, h_map_b, HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective (Submonoid.powers f₁)
      rw [HomogeneousLocalization.Away.val_mk]
      change _ = (HomogeneousLocalization.map g_hom hsub₁₂
        (HomogeneousLocalization.mk ⟨n • (1 + 1), ⟨a * MvPolynomial.X b' ^ n, _⟩, ⟨f₀ ^ n, _⟩, _⟩)).val
      rw [HomogeneousLocalization.map_mk]
      change Localization.mk (g_hom a * MvPolynomial.X b'.castSucc ^ n) ⟨f₁ ^ n, _⟩ =
        Localization.mk (g_hom (a * MvPolynomial.X b' ^ n)) ⟨g_hom (f₀ ^ n), _⟩
      refine congrArg₂ Localization.mk ?_ (Subtype.ext ?_)
      · simp [g_hom, map_mul, map_pow, MvPolynomial.rename_X]
      · simp [g_hom, map_pow, hx₀, hx₁, map_mul, MvPolynomial.rename_X]
    exact (hBranch b₁' b₂' inf_le_left rfl rfl).trans
      (hBranch b₂' b₁' inf_le_right (mul_comm _ _) (mul_comm _ _)).symm

  let pr_p₀ : (U₁ : AlgebraicGeometry.Scheme.{u}) ⟶ X₀ :=
    𝒰.glueMorphisms pr_loc h_glue

  let hom₀ : X₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜₀ ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₀ 0)))
  let hom₁ : X₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₁ 0)))

  have hPr : IsCenterComplLinearProjection k m pr_p₀ := by
    refine ⟨?_, hdeg, ?_⟩
    · change pr_p₀ ≫ hom₀ = U₁.ι ≫ hom₁
      apply 𝒰.hom_ext
      intro b
      let b' : Fin (m + 1) := b
      have h_gl_b : X₁.homOfLE (h_le b') ≫ pr_p₀ = pr_loc b' :=
        AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰 pr_loc h_glue b
      change X₁.homOfLE (h_le b') ≫ pr_p₀ ≫ hom₀ = X₁.homOfLE (h_le b') ≫ U₁.ι ≫ hom₁
      rw [← CategoryTheory.Category.assoc (X₁.homOfLE (h_le b')) pr_p₀, h_gl_b, h_pr_b b']
      have h_u_ι : X₁.homOfLE (h_le b') ≫ U₁.ι =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b'.castSucc) (hb₁ b') hpos).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X b'.castSucc) (hb₁ b') hpos := by
        calc X₁.homOfLE (h_le b') ≫ U₁.ι
            = (D₁ b').ι := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
          _ = (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b'.castSucc) (hb₁ b') hpos).hom ≫
              ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b'.castSucc) (hb₁ b') hpos).inv ≫
                (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b'.castSucc)).ι) := by
              rw [CategoryTheory.Iso.hom_inv_id_assoc]
          _ = (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X b'.castSucc) (hb₁ b') hpos).hom ≫
              AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X b'.castSucc) (hb₁ b') hpos := by
              rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
      rw [← CategoryTheory.Category.assoc (X₁.homOfLE (h_le b')) U₁.ι, h_u_ι]
      dsimp [X₀, X₁, hom₀, hom₁]
      simp only [CategoryTheory.Category.assoc]
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X b'.castSucc))
      change (HomogeneousLocalization.map g_hom (hsub b')
        (HomogeneousLocalization.mk ⟨0, algebraMap k ↥(𝒜₀ 0) c, 1, _⟩)).val =
        (HomogeneousLocalization.mk ⟨0, algebraMap k ↥(𝒜₁ 0) c, 1, _⟩ :
          HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X b'.castSucc)).val
      rw [HomogeneousLocalization.map_mk]
      change Localization.mk (g_hom (MvPolynomial.C c)) ⟨g_hom 1, _⟩ =
        Localization.mk (MvPolynomial.C c) 1
      refine congrArg₂ Localization.mk ?_ (Subtype.ext ?_)
      · simp [g_hom]
      · simp [g_hom]
    · intro b
      refine ⟨?_, hsub b, h_le b, hb₀ b, hb₁ b, hpos, ?_⟩
      · intro u
        let u' : ↥U₁ := u
        obtain ⟨i, hui⟩ := TopologicalSpace.Opens.mem_iSup.mp u'.2
        let v : ↥(D₁ i : AlgebraicGeometry.Scheme.{u}) := ⟨u'.1, hui⟩
        let q := (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁
          (MvPolynomial.X i.castSucc) (hb₁ i) hpos).hom.base v
        have hfv : (𝒰.f i).base v = u' := by
          apply Subtype.ext
          exact AlgebraicGeometry.Scheme.homOfLE_apply (h_le i) v
        have h_pr_u : pr_p₀.base u' =
            (AlgebraicGeometry.Proj.awayι 𝒜₀ (MvPolynomial.X i) (hb₀ i) hpos).base
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.map g_hom (hsub i)))).base q) := by
          have h_gl_i : 𝒰.f i ≫ pr_p₀ = pr_loc i :=
            AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰 pr_loc h_glue i
          have h_app := congrArg (fun φ => φ.base v) (h_gl_i.trans (h_pr_b i))
          rw [← hfv]
          exact h_app
        have h_u1 : u'.1 =
            (AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X i.castSucc) (hb₁ i) hpos).base q := by
          have h_ιv : (D₁ i).ι.base v = u'.1 := AlgebraicGeometry.Scheme.Opens.ι_apply (D₁ i) v
          have h_id : (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X i.castSucc)).ι =
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X i.castSucc) (hb₁ i) hpos).hom ≫
              AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X i.castSucc) (hb₁ i) hpos := by
            rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
          exact h_ιv.symm.trans (congrArg (fun φ => φ.base v) h_id)
        have hpre₀ := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₀ (hb₀ i) hpos (hb₀ b) hpos
        have hpre_spec := AlgebraicGeometry.SpecMap_preimage_basicOpen
          (CommRingCat.ofHom (HomogeneousLocalization.map g_hom (hsub i)))
          (HomogeneousLocalization.Away.isLocalizationElem (hb₀ i) (hb₀ b))
        have hpre₁ := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₁ (hb₁ i) hpos (hb₁ b) hpos
        let q₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (HomogeneousLocalization.map g_hom (hsub i)))).base q
        have h_lhs₁ : pr_p₀.base u' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜₀ (MvPolynomial.X b) ↔
            q₀ ∈ PrimeSpectrum.basicOpen
              (HomogeneousLocalization.Away.isLocalizationElem (hb₀ i) (hb₀ b)) := by
          rw [h_pr_u]
          exact iff_of_eq (congrArg (q₀ ∈ ·) hpre₀)
        have h_lhs₂ : q₀ ∈ PrimeSpectrum.basicOpen
              (HomogeneousLocalization.Away.isLocalizationElem (hb₀ i) (hb₀ b)) ↔
            q ∈ PrimeSpectrum.basicOpen
              (HomogeneousLocalization.map g_hom (hsub i)
                (HomogeneousLocalization.Away.isLocalizationElem (hb₀ i) (hb₀ b))) :=
          iff_of_eq (congrArg (q ∈ ·) hpre_spec)
        have h_rhs : u'.1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b.castSucc) ↔
            q ∈ PrimeSpectrum.basicOpen
              (HomogeneousLocalization.Away.isLocalizationElem (hb₁ i) (hb₁ b)) := by
          rw [h_u1]
          exact iff_of_eq (congrArg (q ∈ ·) hpre₁)
        have h_elem_eq : HomogeneousLocalization.map g_hom (hsub i)
            (HomogeneousLocalization.Away.isLocalizationElem (hb₀ i) (hb₀ b)) =
            HomogeneousLocalization.Away.isLocalizationElem (hb₁ i) (hb₁ b) := by
          apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X i.castSucc))
          change (HomogeneousLocalization.map g_hom (hsub i)
            (HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X b ^ 1, _⟩, ⟨MvPolynomial.X i ^ 1, _⟩, _⟩)).val =
            Localization.mk (MvPolynomial.X b.castSucc ^ 1) ⟨MvPolynomial.X i.castSucc ^ 1, _⟩
          rw [HomogeneousLocalization.map_mk]
          change Localization.mk (g_hom (MvPolynomial.X b ^ 1)) ⟨g_hom (MvPolynomial.X i ^ 1), _⟩ = _
          refine congrArg₂ Localization.mk ?_ (Subtype.ext ?_)
          · simp [g_hom, MvPolynomial.rename_X]
          · simp [g_hom, MvPolynomial.rename_X]
        exact (h_lhs₁.trans h_lhs₂).trans
          ((iff_of_eq (congrArg (fun x => q ∈ PrimeSpectrum.basicOpen x) h_elem_eq)).trans h_rhs.symm)
      · exact AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰 pr_loc h_glue b

  
  let ℓ : Fin (m + 1 + 1) := Fin.last (m + 1)
  obtain ⟨e_last, heC, heX⟩ := hEquiv₁ ℓ (hX₁ ℓ)
  let π_last : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X ℓ) →+* k :=
    (MvPolynomial.eval 0).comp e_last.symm.toRingHom
  let ι_ℓ : AlgebraicGeometry.Spec
      (CommRingCat.of (HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X ℓ))) ⟶ X₁ :=
    AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X ℓ) (hX₁ ℓ) hpos
  let p₀_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X₁ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_last) ≫ ι_ℓ

  have hp₀_hom : p₀_pt ≫ hom₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    dsimp [p₀_pt, ι_ℓ, hom₁]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_id]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    change π_last ((HomogeneousLocalization.fromZeroRingHom 𝒜₁ (Submonoid.powers (MvPolynomial.X ℓ)))
      ((algebraMap k ↥(𝒜₁ 0)) c)) = c
    rw [← heC c]
    simp [π_last]

  have hp₀_range : Set.range p₀_pt.base ⊆ ((U₁ : Set X₁)ᶜ) := by
    rintro _ ⟨x, rfl⟩ hxU
    have hxU' : p₀_pt.base x ∈ U₁ := hxU
    obtain ⟨i, hxi⟩ := TopologicalSpace.Opens.mem_iSup.mp hxU'
    have hpre₁ := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₁ (hX₁ ℓ) hpos (hb₁ i) hpos
    have hpre_spec := AlgebraicGeometry.SpecMap_preimage_basicOpen
      (CommRingCat.ofHom π_last)
      (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i))
    let q_x := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_last)).base x
    have hx_bo₁ : q_x ∈ PrimeSpectrum.basicOpen
        (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i)) :=
      (iff_of_eq (congrArg (q_x ∈ ·) hpre₁)).mp hxi
    have hx_bo : x ∈ PrimeSpectrum.basicOpen
        (π_last (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i))) :=
      (iff_of_eq (congrArg (x ∈ ·) hpre_spec)).mp hx_bo₁
    have hi_ne : i.castSucc ≠ ℓ := Fin.castSucc_ne_last i
    have h_eval_zero : π_last (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i)) = 0 := by
      rw [← heX i.castSucc hi_ne (hb₁ i)]
      simp [π_last]
    rw [h_eval_zero] at hx_bo
    exact hx_bo (zero_mem x.asIdeal)

  have hp₀_uniq : ∀ (g_pt : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ X₁),
      g_pt ≫ hom₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      Set.range g_pt.base ⊆ ((U₁ : Set X₁)ᶜ) →
      g_pt = p₀_pt := by
    intro g_pt hg_hom hg_range
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := default
    have h_top : g_pt.base pt₀ ∈ (⊤ : X₁.Opens) := trivial
    rw [← hCov₁, TopologicalSpace.Opens.mem_iSup] at h_top
    obtain ⟨a, ha⟩ := h_top
    have ha_last : g_pt.base pt₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X ℓ) := by
      revert ha
      refine Fin.lastCases (fun h => h) (fun i hi => False.elim ?_) a
      exact hg_range ⟨pt₀, rfl⟩ (le_iSup D₁ i hi)
    have h_range_ι : Set.range g_pt.base ⊆ Set.range ι_ℓ.base := by
      have h_open_eq : Set.range ι_ℓ.base =
          (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X ℓ) : Set X₁) := by
        rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange,
          AlgebraicGeometry.Proj.opensRange_awayι 𝒜₁ (MvPolynomial.X ℓ) (hX₁ ℓ) hpos]
      rw [h_open_eq]
      rintro _ ⟨x, rfl⟩
      rw [Subsingleton.elim x pt₀]
      exact ha_last
    let g_lift := AlgebraicGeometry.IsOpenImmersion.lift ι_ℓ g_pt h_range_ι
    have hg_lift : g_lift ≫ ι_ℓ = g_pt :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_ℓ g_pt h_range_ι
    let ψ : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X ℓ) →+* k :=
      (AlgebraicGeometry.Spec.preimage g_lift).hom
    have hg_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) = g_lift := by
      change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage g_lift) = g_lift
      exact AlgebraicGeometry.Spec.map_preimage g_lift
    have hg_fac : g_pt = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι_ℓ := by
      rw [hg_spec, hg_lift]
    have hψ_const : ∀ c : k, ψ (e_last (MvPolynomial.C c)) = c := by
      have h1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ ι_ℓ) ≫ hom₁ =
          AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
        rw [← hg_fac, hg_hom, AlgebraicGeometry.Spec.map_id]
      dsimp [ι_ℓ, hom₁] at h1
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at h1
      have h2 := AlgebraicGeometry.Spec.map_injective h1
      intro c
      rw [heC c]
      have h3 := congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom c) h2
      exact h3
    have hψ_var : ∀ r : {r : Fin (m + 1 + 1) // r ≠ ℓ}, ψ (e_last (MvPolynomial.X r)) = 0 := by
      rintro ⟨r, hr⟩
      obtain ⟨i, rfl⟩ := Fin.exists_castSucc_eq.mpr hr
      have h_not_D₁ : g_pt.base pt₀ ∉ AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X i.castSucc) := by
        intro h_in
        exact hg_range ⟨pt₀, rfl⟩ (le_iSup D₁ i h_in)
      have hpre₁ := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₁ (hX₁ ℓ) hpos (hb₁ i) hpos
      have hpre_spec := AlgebraicGeometry.SpecMap_preimage_basicOpen
        (CommRingCat.ofHom ψ)
        (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i))
      let q_pt := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base pt₀
      have h_not_bo : pt₀ ∉ PrimeSpectrum.basicOpen
          (ψ (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i))) := by
        intro h_bo
        apply h_not_D₁
        rw [hg_fac]
        have h_bo₁ : q_pt ∈ PrimeSpectrum.basicOpen
            (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i)) :=
          (iff_of_eq (congrArg (pt₀ ∈ ·) hpre_spec)).mpr h_bo
        exact (iff_of_eq (congrArg (q_pt ∈ ·) hpre₁)).mpr h_bo₁
      have h_mem_ideal : ψ (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ℓ) (hb₁ i)) ∈
          pt₀.asIdeal := by
        by_contra h_not_mem
        exact h_not_bo h_not_mem
      rw [heX i.castSucc hr (hb₁ i)]
      by_contra hne
      have h_top_ideal : pt₀.asIdeal = ⊤ :=
        Ideal.eq_top_of_isUnit_mem pt₀.asIdeal h_mem_ideal (IsUnit.mk0 _ hne)
      exact pt₀.isPrime.ne_top h_top_ideal
    have hψ_comp : ψ.comp e_last.toRingHom = MvPolynomial.eval 0 := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp [hψ_const c]
      · intro r
        simp [hψ_var r]
    have hψ_eq : ψ = π_last := by
      apply RingHom.ext
      intro z
      have hz : e_last (e_last.symm z) = z := e_last.apply_symm_apply z
      calc ψ z
          = (ψ.comp e_last.toRingHom) (e_last.symm z) := congrArg ψ hz.symm
        _ = (MvPolynomial.eval 0) (e_last.symm z) := by rw [hψ_comp]
        _ = π_last z := rfl
    rw [hg_fac, hψ_eq]

  exact ⟨hCov₀, hUproj, hCompU, hIntU, pr_p₀, p₀_pt, hPr, hp₀_hom, hp₀_range, hp₀_uniq⟩

theorem weil_schematicImage_graph_openIso_and_isIntegral (S X Y : AlgebraicGeometry.Scheme.{u})
    [CompactSpace ↥S] [QuasiSeparatedSpace ↥S]
    (fX : X ⟶ S) (fY : Y ⟶ S)
    [AlgebraicGeometry.IsProper fX] [AlgebraicGeometry.IsProper fY]
    (U : X.Opens) [CompactSpace ↥(U : AlgebraicGeometry.Scheme.{u})]
    (hIntU : AlgebraicGeometry.IsIntegral (U : AlgebraicGeometry.Scheme.{u}))
    (g : (U : AlgebraicGeometry.Scheme.{u}) ⟶ Y)
    (hg : U.ι ≫ fX = g ≫ fY) :
    let Q := CategoryTheory.Limits.pullback fX fY
    let γ : (U : AlgebraicGeometry.Scheme.{u}) ⟶ Q := CategoryTheory.Limits.pullback.lift U.ι g hg
    let Z := AlgebraicGeometry.Scheme.Hom.image γ
    let ι : Z ⟶ Q := AlgebraicGeometry.Scheme.Hom.imageι γ
    let p₁ : Z ⟶ X := ι ≫ CategoryTheory.Limits.pullback.fst fX fY
    let p₂ : Z ⟶ Y := ι ≫ CategoryTheory.Limits.pullback.snd fX fY
    AlgebraicGeometry.IsIntegral Z ∧
    AlgebraicGeometry.IsProper p₁ ∧
    AlgebraicGeometry.IsProper p₂ ∧
    (∀ (V : Q.Opens),
      AlgebraicGeometry.Scheme.Hom.ker (ι ∣_ V) = AlgebraicGeometry.Scheme.Hom.ker (γ ∣_ V)) ∧
    ∃ (hIso : CategoryTheory.IsIso (p₁ ∣_ U)),
      @CategoryTheory.inv _ _ _ _ (p₁ ∣_ U) hIso ≫ (p₁ ⁻¹ᵁ U).ι ≫ p₂ = g :=
by
  intro Q γ Z ι p₁ p₂
  let π₁ : Q ⟶ X := CategoryTheory.Limits.pullback.fst fX fY
  let π₂ : Q ⟶ Y := CategoryTheory.Limits.pullback.snd fX fY
  have hγ_fst : γ ≫ π₁ = U.ι := CategoryTheory.Limits.pullback.lift_fst U.ι g hg
  have hγ_snd : γ ≫ π₂ = g := CategoryTheory.Limits.pullback.lift_snd U.ι g hg

  have : AlgebraicGeometry.IsProper π₁ := inferInstance
  have : AlgebraicGeometry.IsProper π₂ := inferInstance
  have hQS_map : AlgebraicGeometry.QuasiSeparated (π₁ ≫ fX) := inferInstance
  have : QuasiSeparatedSpace ↥Q :=
    (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace (π₁ ≫ fX)).mp hQS_map
  have : AlgebraicGeometry.QuasiCompact γ := inferInstance

  have : AlgebraicGeometry.IsClosedImmersion ι := by
    dsimp [ι]
    infer_instance
  have : AlgebraicGeometry.IsProper ι := inferInstance
  have : AlgebraicGeometry.QuasiCompact ι := inferInstance
  have hProp_p₁ : AlgebraicGeometry.IsProper p₁ := by
    dsimp [p₁]
    infer_instance
  have hProp_p₂ : AlgebraicGeometry.IsProper p₂ := by
    dsimp [p₂]
    infer_instance

  have hKer_eq : AlgebraicGeometry.Scheme.Hom.ker ι = AlgebraicGeometry.Scheme.Hom.ker γ :=
    AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι γ.ker
  have hKerRestr : ∀ (V : Q.Opens),
      AlgebraicGeometry.Scheme.Hom.ker (ι ∣_ V) = AlgebraicGeometry.Scheme.Hom.ker (γ ∣_ V) := by
    intro V
    apply AlgebraicGeometry.Scheme.IdealSheafData.ext
    funext W
    rw [AlgebraicGeometry.Scheme.ker_morphismRestrict_ideal ι V W,
      AlgebraicGeometry.Scheme.ker_morphismRestrict_ideal γ V W, hKer_eq]

  have : AlgebraicGeometry.IsIntegral (U : AlgebraicGeometry.Scheme.{u}) := hIntU
  have : IrreducibleSpace ↥(U : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral (U : AlgebraicGeometry.Scheme.{u})
  have : AlgebraicGeometry.IsReduced (U : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.isReduced_of_isIntegral (U : AlgebraicGeometry.Scheme.{u})
  let e_γ : (U : AlgebraicGeometry.Scheme.{u}) ⟶ Z := AlgebraicGeometry.Scheme.Hom.toImage γ
  have : AlgebraicGeometry.IsDominant e_γ := by
    dsimp [e_γ, Z]
    infer_instance
  have hDense : DenseRange e_γ.base := (AlgebraicGeometry.isDominant_iff e_γ).mp inferInstance
  obtain ⟨u₀⟩ : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := IrreducibleSpace.toNonempty
  have hPre_univ : IsPreirreducible (Set.univ : Set ↥Z) := by
    rw [← hDense.closure_range, ← Set.image_univ]
    exact (PreirreducibleSpace.isPreirreducible_univ.image
      e_γ.base e_γ.continuous.continuousOn).closure
  have : IrreducibleSpace ↥Z :=
    { isPreirreducible_univ := hPre_univ
      toNonempty := ⟨e_γ.base u₀⟩ }

  let 𝒰_Z : Z.OpenCover := γ.ker.subschemeCover.openCover
  have hRed_charts : ∀ (W : 𝒰_Z.I₀), AlgebraicGeometry.IsReduced (𝒰_Z.X W) := by
    intro W
    change AlgebraicGeometry.IsReduced
      (AlgebraicGeometry.Spec (CommRingCat.of (↑(Q.presheaf.obj (Opposite.op W.1)) ⧸ γ.ker.ideal W)))
    let φ_W := (γ.app W.1).hom
    have : IsReduced ↑((U : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op (γ ⁻¹ᵁ W.1))) :=
      AlgebraicGeometry.IsReduced.component_reduced (γ ⁻¹ᵁ W.1)
    have h_ker_W : γ.ker.ideal W = RingHom.ker φ_W := γ.ker_apply W
    let ψ_W := φ_W.kerLift.comp (Ideal.quotEquivOfEq h_ker_W).toRingHom
    have h_inj_W : Function.Injective ψ_W :=
      (RingHom.kerLift_injective φ_W).comp (Ideal.quotEquivOfEq h_ker_W).injective
    have : IsReduced (↑(Q.presheaf.obj (Opposite.op W.1)) ⧸ γ.ker.ideal W) :=
      isReduced_of_injective ψ_W h_inj_W
    infer_instance
  have : AlgebraicGeometry.IsReduced Z := AlgebraicGeometry.IsReduced.of_openCover Z 𝒰_Z
  have hIntZ : AlgebraicGeometry.IsIntegral Z :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Z

  let V_U : Q.Opens := π₁ ⁻¹ᵁ U
  have h_pre_top : γ ⁻¹ᵁ V_U = (⊤ : (U : AlgebraicGeometry.Scheme.{u}).Opens) := by
    ext u
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    change π₁.base (γ.base u) ∈ U
    have h_eq : π₁.base (γ.base u) = U.ι.base u := by
      change (γ ≫ π₁).base u = U.ι.base u
      rw [hγ_fst]
    have h_app : U.ι.base u = u.1 := AlgebraicGeometry.Scheme.Opens.ι_apply U u
    rw [h_eq, h_app]
    exact u.2
  have h_range_top : AlgebraicGeometry.Scheme.Hom.opensRange (γ ⁻¹ᵁ V_U).ι = ⊤ := by
    rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι, h_pre_top]
  have hIso_ι_pre : CategoryTheory.IsIso (γ ⁻¹ᵁ V_U).ι :=
    AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top (γ ⁻¹ᵁ V_U).ι h_range_top
  have h_sec_VU : (γ ∣_ V_U) ≫ (π₁ ∣_ U) = (γ ⁻¹ᵁ V_U).ι := by
    rw [← CategoryTheory.cancel_mono U.ι]
    calc ((γ ∣_ V_U) ≫ (π₁ ∣_ U)) ≫ U.ι
        = (γ ∣_ V_U) ≫ ((π₁ ∣_ U) ≫ U.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (γ ∣_ V_U) ≫ (V_U.ι ≫ π₁) := by
            rw [AlgebraicGeometry.morphismRestrict_ι π₁ U]
      _ = ((γ ∣_ V_U) ≫ V_U.ι) ≫ π₁ := (CategoryTheory.Category.assoc _ _ _).symm
      _ = ((γ ⁻¹ᵁ V_U).ι ≫ γ) ≫ π₁ := by
            rw [AlgebraicGeometry.morphismRestrict_ι γ V_U]
      _ = (γ ⁻¹ᵁ V_U).ι ≫ (γ ≫ π₁) := CategoryTheory.Category.assoc _ _ _
      _ = (γ ⁻¹ᵁ V_U).ι ≫ U.ι := by rw [hγ_fst]

  have : AlgebraicGeometry.IsClosedImmersion ((γ ∣_ V_U) ≫ (π₁ ∣_ U)) := by
    rw [h_sec_VU]
    infer_instance
  have : AlgebraicGeometry.IsSeparated (π₁ ∣_ U) := inferInstance
  have : AlgebraicGeometry.IsClosedImmersion (γ ∣_ V_U) :=
    AlgebraicGeometry.IsClosedImmersion.of_comp (γ ∣_ V_U) (π₁ ∣_ U)

  have hKer_VU : AlgebraicGeometry.Scheme.Hom.ker (ι ∣_ V_U) =
      AlgebraicGeometry.Scheme.Hom.ker (γ ∣_ V_U) :=
    hKerRestr V_U
  let L : (γ ⁻¹ᵁ V_U : AlgebraicGeometry.Scheme.{u}) ⟶ (ι ⁻¹ᵁ V_U : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsClosedImmersion.lift (ι ∣_ V_U) (γ ∣_ V_U) hKer_VU.le
  have hIso_L : CategoryTheory.IsIso L :=
    AlgebraicGeometry.IsClosedImmersion.isIso_lift (ι ∣_ V_U) (γ ∣_ V_U) hKer_VU
  have hL_fac : L ≫ (ι ∣_ V_U) = γ ∣_ V_U :=
    AlgebraicGeometry.IsClosedImmersion.lift_fac (ι ∣_ V_U) (γ ∣_ V_U) hKer_VU.le

  let σ_U : (U : AlgebraicGeometry.Scheme.{u}) ⟶ (p₁ ⁻¹ᵁ U : AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ L
  have : CategoryTheory.IsIso σ_U :=
    @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ inferInstance hIso_L
  have hL_p₁ : L ≫ (p₁ ∣_ U) = (γ ⁻¹ᵁ V_U).ι := by
    change L ≫ ((ι ≫ π₁) ∣_ U) = (γ ⁻¹ᵁ V_U).ι
    rw [AlgebraicGeometry.morphismRestrict_comp ι π₁ U, ← CategoryTheory.Category.assoc,
      hL_fac, h_sec_VU]
  have h_sec_σ : σ_U ≫ (p₁ ∣_ U) = 𝟙 (U : AlgebraicGeometry.Scheme.{u}) := by
    calc (CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ L) ≫ (p₁ ∣_ U)
        = CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ (L ≫ (p₁ ∣_ U)) :=
            CategoryTheory.Category.assoc _ _ _
      _ = CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ (γ ⁻¹ᵁ V_U).ι := by rw [hL_p₁]
      _ = 𝟙 (U : AlgebraicGeometry.Scheme.{u}) := CategoryTheory.IsIso.inv_hom_id _
  have hp₁_eq : p₁ ∣_ U = CategoryTheory.inv σ_U := by
    calc p₁ ∣_ U
        = (CategoryTheory.inv σ_U ≫ σ_U) ≫ (p₁ ∣_ U) := by
            rw [CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
      _ = CategoryTheory.inv σ_U ≫ (σ_U ≫ (p₁ ∣_ U)) := CategoryTheory.Category.assoc _ _ _
      _ = CategoryTheory.inv σ_U := by
            rw [h_sec_σ, CategoryTheory.Category.comp_id]
  have hIso : CategoryTheory.IsIso (p₁ ∣_ U) := by
    rw [hp₁_eq]
    infer_instance
  have : CategoryTheory.IsIso (p₁ ∣_ U) := hIso
  have h_inv_eq : @CategoryTheory.inv _ _ _ _ (p₁ ∣_ U) hIso = σ_U := by
    calc @CategoryTheory.inv _ _ _ _ (p₁ ∣_ U) hIso
        = (σ_U ≫ (p₁ ∣_ U)) ≫ CategoryTheory.inv (p₁ ∣_ U) := by
            rw [h_sec_σ, CategoryTheory.Category.id_comp]
      _ = σ_U ≫ ((p₁ ∣_ U) ≫ CategoryTheory.inv (p₁ ∣_ U)) :=
            CategoryTheory.Category.assoc _ _ _
      _ = σ_U := by
            rw [CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]

  have h_σ_ι : σ_U ≫ (p₁ ⁻¹ᵁ U).ι ≫ ι = γ := by
    calc (CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ L) ≫ (ι ⁻¹ᵁ V_U).ι ≫ ι
        = CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ (L ≫ ((ι ⁻¹ᵁ V_U).ι ≫ ι)) := by
            simp only [CategoryTheory.Category.assoc]
      _ = CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ (L ≫ ((ι ∣_ V_U) ≫ V_U.ι)) := by
            rw [AlgebraicGeometry.morphismRestrict_ι ι V_U]
      _ = CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ ((L ≫ (ι ∣_ V_U)) ≫ V_U.ι) := by
            rw [CategoryTheory.Category.assoc L]
      _ = CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ ((γ ∣_ V_U) ≫ V_U.ι) := by rw [hL_fac]
      _ = CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ ((γ ⁻¹ᵁ V_U).ι ≫ γ) := by
            rw [AlgebraicGeometry.morphismRestrict_ι γ V_U]
      _ = (CategoryTheory.inv (γ ⁻¹ᵁ V_U).ι ≫ (γ ⁻¹ᵁ V_U).ι) ≫ γ := by
            rw [CategoryTheory.Category.assoc]
      _ = γ := by rw [CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
  have hComp_g : @CategoryTheory.inv _ _ _ _ (p₁ ∣_ U) hIso ≫ (p₁ ⁻¹ᵁ U).ι ≫ p₂ = g := by
    rw [h_inv_eq]
    calc σ_U ≫ (p₁ ⁻¹ᵁ U).ι ≫ (ι ≫ π₂)
        = (σ_U ≫ (p₁ ⁻¹ᵁ U).ι ≫ ι) ≫ π₂ := by simp only [CategoryTheory.Category.assoc]
      _ = γ ≫ π₂ := by rw [h_σ_ι]
      _ = g := hγ_snd

  exact ⟨hIntZ, hProp_p₁, hProp_p₂, hKerRestr, hIso, hComp_g⟩

theorem weil_pointCenter_blowup_chart_trivialization (k : Type u) [Field k] (m : ℕ)
    (pr_p₀ : ((weilProjCenterComplOpen k m :
      (weilProjectiveSpaceOver k (m + 1)).left.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
      (weilProjectiveSpaceOver k m).left)
    (hPr : IsCenterComplLinearProjection k m pr_p₀)
    (hg : (weilProjCenterComplOpen k m).ι ≫ (weilProjectiveSpaceOver k (m + 1)).hom =
      pr_p₀ ≫ (weilProjectiveSpaceOver k m).hom)
    (b : Fin (m + 1)) :
    let P_amb := weilProjectiveSpaceOver k (m + 1)
    let B₀ := weilProjectiveSpaceOver k m
    let P₁ := weilProjectiveSpaceOver k 1
    let U_proj := weilProjCenterComplOpen k m
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let D₀_b : B₀.left.Opens :=
      AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) (MvPolynomial.X b)
    let Q := CategoryTheory.Limits.pullback P_amb.hom B₀.hom
    let γ : (U_proj : AlgebraicGeometry.Scheme.{u}) ⟶ Q :=
      CategoryTheory.Limits.pullback.lift U_proj.ι pr_p₀ hg
    let Q_b : Q.Opens := (CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ⁻¹ᵁ D₀_b
    let E_b := CategoryTheory.Limits.pullback (D₀_b.ι ≫ B₀.hom) P₁.hom
    ∃ (Φ_b : E_b ⟶ (Q_b : AlgebraicGeometry.Scheme.{u}))
      (p₀_b : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P_amb.left)
      (s_b : (D₀_b : AlgebraicGeometry.Scheme.{u}) ⟶ E_b),
      AlgebraicGeometry.IsClosedImmersion Φ_b ∧
      (Φ_b ≫ ((CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ∣_ D₀_b) =
        CategoryTheory.Limits.pullback.fst (D₀_b.ι ≫ B₀.hom) P₁.hom) ∧
      (AlgebraicGeometry.Scheme.Hom.ker (γ ∣_ Q_b) = AlgebraicGeometry.Scheme.Hom.ker Φ_b) ∧
      (p₀_b ≫ P_amb.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) ∧
      (Set.range p₀_b.base ⊆ ((U_proj : Set P_amb.left)ᶜ)) ∧
