        have h1 := hChainHt s (le_of_eq hL_len.symm)
        have hIdx : (⟨s, Nat.lt_succ_of_le (le_of_eq hL_len.symm)⟩ : Fin (L.length + 1)) =
            Fin.last L.length := Fin.ext hL_len.symm
        rw [hIdx] at h1
        change (s : ℕ∞) ≤ (RelSeries.last L).asIdeal.height at h1
