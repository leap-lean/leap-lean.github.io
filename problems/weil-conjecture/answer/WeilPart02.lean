            obtain ⟨b₁, hb₁⟩ := EuclideanDomain.gcd_dvd_right a b
            have hb₁_ne : b₁ ≠ 0 := by
              intro hb₁0
              rw [hb₁0, mul_zero] at hb₁
              exact hb hb₁
