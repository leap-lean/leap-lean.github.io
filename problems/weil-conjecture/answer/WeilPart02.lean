        rw [← hJP_eq, Ideal.span_le]
        rintro _ (⟨i, rfl⟩ | rfl)
        · exact hI_le_JP (g i).2
        · exact u₀.2
      let K_sq : Ideal P := N_ideal ⊔ m_P ^ 2
      let lift_κ : IsLocalRing.ResidueField S → P := fun a => Classical.choose (hSurj_Pκ a)
