                change Ideal.Quotient.mk K_sq (lift_κ a * (x.1 + y.1)) = _
                rw [mul_add, map_add]
              map_smul' := fun r₀ x => by
                change Ideal.Quotient.mk K_sq (lift_κ a * (r₀ * x.1)) =
