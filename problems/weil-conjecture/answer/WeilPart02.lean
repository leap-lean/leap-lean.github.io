          rw [← map_mul, hq]
        have hmem := S.mul_mem (hPslope_mem q₁) (S.inv_mem (hPslope_mem q₂.1))
        rwa [← hmul, mul_inv_cancel_right₀ hq₂_ne] at hmem
      have hPoly_mem : ∀ f : Polynomial L,
          algebraMap R (FractionRing R) (algebraMap (Polynomial L) R f) ∈ S := by
        intro f
        induction f using Polynomial.induction_on' with
