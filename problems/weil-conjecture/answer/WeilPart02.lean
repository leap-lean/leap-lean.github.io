        exact hunit.map _
      let φ_gen : Localization M_R →+*
          TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R) :=
        IsLocalization.lift hMR_units
      let ι_D_loc : TensorProduct (MvPolynomial (Fin m) k) C R →+* Localization M_R :=
        algebraMap (TensorProduct (MvPolynomial (Fin m) k) C R) (Localization M_R)
      have hR_units_loc : ∀ s : nonZeroDivisors R, IsUnit ((ι_D_loc.comp ι_RD) s) := by
        intro s
        exact IsLocalization.map_units (Localization M_R)
          ⟨ι_RD s.1, Submonoid.mem_map_of_mem ι_RD s.2⟩
      let g_frac : FractionRing R →+* Localization M_R :=
        IsLocalization.lift (S := FractionRing R) hR_units_loc
      have hg_frac_eq : ∀ r : R,
