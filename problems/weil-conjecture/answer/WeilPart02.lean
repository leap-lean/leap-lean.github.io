            CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom φ₁ := rfl
        rw [hcomp, AlgebraicGeometry.Spec.map_comp] at hSpec₁_C
        simpa only [CategoryTheory.Category.assoc] using hSpec₁_C
      refine ⟨α₀, V₁, hAffV₁, hzV₁, hV₁U, hV₁α, s₀ + 1, φ₁, q₁, f_lift₁, x_coord, P_h,
        hSurj₁, hSpec₁, hKer₁, ?_, hDet3₁, hDet4₁, hUnit_Ph, hLoc_Ph, hLinForm, hHyp⟩
      intro j hFj hXα hpos
      rw [hf_lift₁_eq j, hf_lift₀_eq j hFj]
      have hiso_eq :
          (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₀) hXα₀ hpos₀).hom =
            (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X α₀) hXα hpos).hom := by
        rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom,
          ← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜 (MvPolynomial.X α₀) hXα hpos]
      let t₀ : HomogeneousLocalization.NumDenSameDeg 𝒜 (Submonoid.powers (MvPolynomial.X α₀)) :=
        ⟨1, ⟨F_prev j, hFj⟩, ⟨MvPolynomial.X α₀, hXα₀⟩, ⟨1, pow_one _⟩⟩
      let t₁ : HomogeneousLocalization.NumDenSameDeg 𝒜 (Submonoid.powers (MvPolynomial.X α₀)) :=
        ⟨1, ⟨F_prev j, hFj⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩
      have hmk_eq : HomogeneousLocalization.mk t₀ = HomogeneousLocalization.mk t₁ := rfl
      rw [hiso_eq]
