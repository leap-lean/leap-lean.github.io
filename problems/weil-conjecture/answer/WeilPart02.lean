      (fun z => (S.basicOpen (a_pt z)).isOpen) h_cov
    let s_set : Set ↑(S.presheaf.obj (Opposite.op V)) :=
      Set.range fun z : ↥F_pts => res_WV (a_pt z.1)
    have h_iSup_V : (⨆ f : ↥s_set, S.basicOpen f.1) = V := by
      apply le_antisymm
      · exact iSup_le fun f => S.basicOpen_le f.1
      · intro x hx
        have hxF := hF_pts hx
        rw [Set.mem_iUnion₂] at hxF
        obtain ⟨z, hzF, hxz⟩ := hxF
        let f₀ : ↥s_set := ⟨res_WV (a_pt z), ⟨⟨z, hzF⟩, rfl⟩⟩
        refine TopologicalSpace.Opens.mem_iSup.mpr ⟨f₀, ?_⟩
        rw [show f₀.1 = res_WV (a_pt z) from rfl, S.basicOpen_res]
        exact ⟨hx, hxz⟩
    have h_span_V : Ideal.span s_set = ⊤ :=
      (hV_aff.iSup_basicOpen_eq_self_iff).mp h_iSup_V
    have h_span_T : Ideal.span (π '' s_set) = ⊤ := by
      rw [← Ideal.map_span, h_span_V, Ideal.map_top]
    have h_img_rad : π '' s_set ⊆ (I_der.radical : Set T) := by
      rintro _ ⟨_, ⟨z, rfl⟩, rfl⟩
      let a := a_pt z.1
      let b := res_WV a
      have ha : S.basicOpen a ≤ V := ha_le z.1
      have h_bo : S.basicOpen b = S.basicOpen a := by
        rw [S.basicOpen_res, inf_eq_right.mpr ha]
      let R_a := ↑(S.presheaf.obj (Opposite.op (S.basicOpen a)))
      let R_b := ↑(S.presheaf.obj (Opposite.op (S.basicOpen b)))
      have _ : IsLocalization.Away a R_a := hW.isLocalization_basicOpen a
      have _ : IsLocalization.Away b R_b := hV_aff.isLocalization_basicOpen b
      let s_a : R_a := (S.presheaf.map (CategoryTheory.homOfLE ha).op).hom s₀
      obtain ⟨m, p₀, hp₀⟩ := IsLocalization.Away.surj a s_a
      let ρ : R_a →+* R_b := (S.presheaf.map (CategoryTheory.homOfLE h_bo.le).op).hom
      have hρ_W : ∀ w : ↑(S.presheaf.obj (Opposite.op W)),
          ρ (algebraMap _ R_a w) = algebraMap _ R_b (res_WV w) := by
        intro w
        change (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le a)).op ≫
          S.presheaf.map (CategoryTheory.homOfLE h_bo.le).op).hom w =
          (S.presheaf.map (CategoryTheory.homOfLE hV).op ≫
            S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le b)).op).hom w
        rw [← Functor.map_comp, ← Functor.map_comp,
          Subsingleton.elim
            ((CategoryTheory.homOfLE (S.basicOpen_le a)).op ≫ (CategoryTheory.homOfLE h_bo.le).op)
            ((CategoryTheory.homOfLE hV).op ≫ (CategoryTheory.homOfLE (S.basicOpen_le b)).op)]
      have hρ_sa : ρ s_a = algebraMap _ R_b s₀ := by
        change (S.presheaf.map (CategoryTheory.homOfLE ha).op ≫
          S.presheaf.map (CategoryTheory.homOfLE h_bo.le).op).hom s₀ =
          (S.presheaf.map (CategoryTheory.homOfLE (S.basicOpen_le b)).op).hom s₀
        rw [← Functor.map_comp,
          Subsingleton.elim
            ((CategoryTheory.homOfLE ha).op ≫ (CategoryTheory.homOfLE h_bo.le).op)
            (CategoryTheory.homOfLE (S.basicOpen_le b)).op]
      have h_eq_Rb : algebraMap _ R_b (s₀ * b ^ m) = algebraMap _ R_b (res_WV p₀) := by
        have h_ap := congrArg ρ hp₀
        rw [map_mul, map_pow, hρ_sa, hρ_W a, hρ_W p₀] at h_ap
        simpa only [map_mul, map_pow] using h_ap
      obtain ⟨c, hc_eq⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers b) R_b).mp h_eq_Rb
      obtain ⟨k₀, hk₀⟩ := c.2
      have h_clear_V : b ^ (k₀ + m) * s₀ = res_WV (a ^ k₀ * p₀) := by
        have hc_eq' : b ^ k₀ * (s₀ * b ^ m) = b ^ k₀ * res_WV p₀ := by
          rwa [← hk₀] at hc_eq
        calc
          b ^ (k₀ + m) * s₀ = b ^ k₀ * (s₀ * b ^ m) := by ring
          _ = b ^ k₀ * res_WV p₀ := hc_eq'
          _ = res_WV (a ^ k₀ * p₀) := by simp only [b, map_mul, map_pow]
      have h_π_eq : ψ (a ^ (k₀ + m)) * π s₀ = ψ (a ^ k₀ * p₀) := by
        have h_ap := congrArg π h_clear_V
        simpa only [ψ, b, RingHom.comp_apply, map_mul, map_pow] using h_ap
      have h_leib := congrArg der_T h_π_eq
      rw [der_T.leibniz, smul_eq_mul, smul_eq_mul, h_der_s₀] at h_leib
      have h_psi_pow : ψ (a ^ (k₀ + m)) = (π b) ^ (k₀ + m) := by
        simp only [ψ, b, RingHom.comp_apply, map_pow]
      have h_pow_eq : (π b) ^ (k₀ + m) =
          der_T (ψ (a ^ k₀ * p₀)) - π s₀ * der_T (ψ (a ^ (k₀ + m))) := by
        rw [← h_psi_pow, ← h_leib]
        ring
      refine Ideal.mem_radical_iff.mpr ⟨k₀ + m, ?_⟩
      rw [h_pow_eq]
      exact I_der.sub_mem (h_der_W (a ^ k₀ * p₀))
        (I_der.mul_mem_left (π s₀) (h_der_W (a ^ (k₀ + m))))
    have h_rad_top : (⊤ : Ideal T) ≤ I_der.radical :=
      h_span_T ▸ Ideal.span_le.mpr h_img_rad
    have h1_rad : (1 : T) ∈ I_der.radical := h_rad_top Submodule.mem_top
    obtain ⟨M, hM⟩ := Ideal.mem_radical_iff.mp h1_rad
    rwa [one_pow] at hM
  · 
    intro μ c H ιH hCartier V hV_aff hV
    obtain ⟨_, hFc, _, hKer⟩ := hCartier
    have hKer_V := hKer μ (hX_hom μ) V hV_aff hV
    change RingHom.ker (ιH.app V).hom =
      Ideal.span {(ι.appLE (U_proj μ) V hV).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)).hom
          (HomogeneousLocalization.Away.mk 𝒜 (hX_hom μ) d₀
            (weilHomogeneousPoly M₀ d₀ c) hFc))} at hKer_V
    rw [hKer_V, hs_dehomog μ c hFc, map_sum]
    congr 2
    refine Finset.sum_congr rfl fun e _ => ?_
    simp only [map_mul, map_prod, map_pow]
    congr 1
    exact RingHom.congr_fun (hk_V_compat μ V hV) (c e)

theorem weil_closedPoint_curve_fiber_sing_finite_and_smooth_charts (k : Type u) [Field k] [IsAlgClosed k] (M₀ : ℕ)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀)
    (W_proj : Fin (M₀ + 1) → V₁.left.Opens)
    (hW_top : (⨆ μ : Fin (M₀ + 1), W_proj μ) = ⊤)
    (y : B₀.left)
    (hy : IsClosed ({y} : Set B₀.left)) :
    ({v : V₁.left | f₁.left.base v = y ∧
      ¬ ∃ W_sm : V₁.left.Opens,
        v ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left)}).Finite ∧
    (∀ v : V₁.left,
      f₁.left.base v = y →
      (¬ ∃ W_sm : V₁.left.Opens,
        v ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left)) →
      IsClosed ({v} : Set V₁.left)) ∧
    ∃ (G : ℕ)
      (μ_chart : Fin G → Fin (M₀ + 1))
      (W_sm_chart : Fin G → V₁.left.Opens)
      (U_B_chart : Fin G → B₀.left.Opens)
      (V_chart : Fin G → V₁.left.Opens),
      (∀ v : V₁.left,
        f₁.left.base v = y →
        (∃ W_sm : V₁.left.Opens,
          v ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left)) →
        ∃ γ : Fin G, v ∈ V_chart γ) ∧
      ∀ γ : Fin G,
        AlgebraicGeometry.SmoothOfRelativeDimension 1 ((W_sm_chart γ).ι ≫ f₁.left) ∧
        V_chart γ ≤ W_sm_chart γ ∧
        V_chart γ ≤ W_proj (μ_chart γ) ∧
        AlgebraicGeometry.IsAffineOpen (U_B_chart γ) ∧
        y ∈ U_B_chart γ ∧
        AlgebraicGeometry.IsAffineOpen (V_chart γ) ∧
        ∃ (e_γ : V_chart γ ≤ (TopologicalSpace.Opens.map f₁.left.base).obj (U_B_chart γ))
          (ev_y : ↑(B₀.left.presheaf.obj (Opposite.op (U_B_chart γ))) →+* k),
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (f₁.left.appLE (U_B_chart γ) (V_chart γ) e_γ).hom ∧
          ev_y.comp ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            B₀.hom.appTop ≫ B₀.left.presheaf.map (CategoryTheory.homOfLE le_top).op).hom =
              RingHom.id k ∧
          ∀ (v : V₁.left) (hv : v ∈ V_chart γ),
            f₁.left.base v = y →
            Ideal.map (f₁.left.appLE (U_B_chart γ) (V_chart γ) e_γ).hom (RingHom.ker ev_y) ≤
              ((V_chart γ).toSpecΓ.base ⟨v, hv⟩).asIdeal :=
by
  
  have hProjNoethLFT : ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      IsProjectiveOverField k X →
      TopologicalSpace.NoetherianSpace ↥X.left ∧
      AlgebraicGeometry.LocallyOfFiniteType X.hom := by
    intro X ⟨N, ι, hCl⟩
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have h_adjoin : Algebra.adjoin (↥(𝒜 0))
        (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k)) = ⊤ := by
      rw [eq_top_iff]
      have h_mem_all : ∀ p : MvPolynomial (Fin (N + 1)) k,
          p ∈ Algebra.adjoin (↥(𝒜 0))
            (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k)) := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a =>
          let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
          exact (Algebra.adjoin (↥(𝒜 0))
            (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k))).algebraMap_mem c₀
        | add p q hp hq =>
          exact add_mem hp hq
        | mul_X p i hp =>
          exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
      intro p _
      exact h_mem_all p
    have : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨⟨(Set.finite_range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k)).toFinset,
        by simpa using h_adjoin⟩⟩
    have : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.instLocallyOfFiniteTypeToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
    have h_surj_zero : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
      have h_lhs : (algebraMap k ↥(𝒜 0) (p.1.coeff 0)).1 = MvPolynomial.C (p.1.coeff 0) := rfl
      rw [h_lhs]
      ext d
      by_cases hd : d = 0
      · subst hd
        simp
      · have hd_deg : Finsupp.degree d ≠ 0 := mt (Finsupp.degree_eq_zero_iff d).mp hd
        have hp_hom : p.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
        simp [MvPolynomial.coeff_C, Ne.symm hd, hp_hom.coeff_eq_zero hd_deg]
    let g₀ := CommRingCat.ofHom (algebraMap k ↥(𝒜 0))
    have : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map g₀) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective g₀ h_surj_zero
    have hLFT_P : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      change AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ AlgebraicGeometry.Spec.map g₀)
      infer_instance
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := hLFT_P
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    have hLFT_X : AlgebraicGeometry.LocallyOfFiniteType X.hom := by
      rw [← ι.w]
      infer_instance
    have : AlgebraicGeometry.LocallyOfFiniteType X.hom := hLFT_X
    have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      AlgebraicGeometry.isNoetherian_Spec.mpr inferInstance
    have : AlgebraicGeometry.IsLocallyNoetherian X.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian X.hom
    have hCompProj : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) := by
      have h_top : (⨆ i : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X
          (fun i => ⟨1, MvPolynomial.isHomogeneous_X k i⟩) h_adjoin
      rw [← isCompact_univ_iff]
      have h_univ : (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) =
          ⋃ i : Fin (N + 1), (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i) :
            Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
        rw [← TopologicalSpace.Opens.coe_top, ← h_top, TopologicalSpace.Opens.coe_iSup]
      rw [h_univ]
      refine isCompact_iUnion fun i => ?_
      let U_i := AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)
      let iso_i := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X i)
        (MvPolynomial.isHomogeneous_X k i) zero_lt_one
      have hHomeo : ↥(U_i : AlgebraicGeometry.Scheme.{u}) ≃ₜ ↥(AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i)))) :=
        TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso_i)
      exact isCompact_iff_compactSpace.mpr hHomeo.symm.compactSpace
    have : CompactSpace ↥(weilProjectiveSpaceOver k N).left := hCompProj
    have hCompX : CompactSpace ↥X.left :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι.left).compactSpace
    have : AlgebraicGeometry.IsNoetherian X.left :=
      (AlgebraicGeometry.isNoetherian_iff X.left).mpr ⟨inferInstance, hCompX⟩
    exact ⟨inferInstance, hLFT_X⟩

  have hNoethV₁ : TopologicalSpace.NoetherianSpace ↥V₁.left :=
    (hProjNoethLFT V₁ ⟨M₀, ι₁, hCl₁⟩).1
  have hLFT_B₀ : AlgebraicGeometry.LocallyOfFiniteType B₀.hom :=
    (hProjNoethLFT B₀ hProjB₀).2

  
  have hEvB₀ : ∀ (U : B₀.left.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      ∀ (hyU : y ∈ U),
      ∃ (ev_y : ↑(B₀.left.presheaf.obj (Opposite.op U)) →+* k),
        ev_y.comp ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          B₀.hom.appTop ≫ B₀.left.presheaf.map (CategoryTheory.homOfLE le_top).op).hom =
            RingHom.id k ∧
        RingHom.ker ev_y = (U.toSpecΓ.base ⟨y, hyU⟩).asIdeal := by
    intro U hU hyU
    let R : Type u := ↑(B₀.left.presheaf.obj (Opposite.op U))
    let φ_mor : CommRingCat.of k ⟶ B₀.left.presheaf.obj (Opposite.op U) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        B₀.hom.appTop ≫ B₀.left.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op
    let φ_k : k →+* R := φ_mor.hom
    have h_app_eq : B₀.hom.appTop ≫ B₀.left.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op =
        B₀.hom.appLE ⊤ U le_top := by
      simp [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.appTop]
    have hFT_app : (B₀.hom.appLE ⊤ U le_top).hom.FiniteType :=
      B₀.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hU le_top
    have hSurj_iso : Function.Surjective
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.commRingCatIsoToRingEquiv.surjective
    have hFT_iso : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom.FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj_iso
    have hFT_φ : φ_k.FiniteType := by
      have hφ_eq : φ_mor = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          B₀.hom.appLE ⊤ U le_top := by
        simpa [φ_mor] using congrArg
          (fun g => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ g) h_app_eq
      have hφ_hom : φ_k = (B₀.hom.appLE ⊤ U le_top).hom.comp
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom := by
        simpa [φ_k] using congrArg CommRingCat.Hom.hom hφ_eq
      rw [hφ_hom]
      exact RingHom.FiniteType.comp hFT_app hFT_iso
    let _ : Algebra k R := φ_k.toAlgebra
    have : Algebra.FiniteType k R := hFT_φ
    obtain ⟨S, hS_adjoin⟩ := Algebra.FiniteType.out (R := k) (A := R)
    let ψ_S : MvPolynomial ↥S k →ₐ[k] R := MvPolynomial.aeval (Subtype.val : ↥S → R)
    have hψ_surj : Function.Surjective ψ_S := by
      rw [← AlgHom.range_eq_top, MvPolynomial.aeval_range]
      have h_range : Set.range (Subtype.val : ↥S → R) = (↑S : Set R) := Subtype.range_coe
      rw [h_range]
      exact hS_adjoin
    let y_U : ↥U.toScheme := ⟨y, hyU⟩
    have h_pre_eq : ((Subtype.val : ↥U.toScheme → B₀.left) ⁻¹' ({y} : Set B₀.left)) = {y_U} := by
      ext z
      exact ⟨fun h => Set.mem_singleton_iff.mpr (Subtype.ext h),
        fun h => congrArg Subtype.val (Set.mem_singleton_iff.mp h)⟩
    have hyU_cl : IsClosed ({y_U} : Set ↥U.toScheme) :=
      h_pre_eq ▸ hy.preimage continuous_subtype_val
    let e_homeo := TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso hU.isoSpec)
    have h_img_eq : e_homeo '' ({y_U} : Set ↥U.toScheme) = {U.toSpecΓ.base y_U} := by
      rw [Set.image_singleton]
      rfl
    have h_cl_spec : IsClosed ({U.toSpecΓ.base y_U} :
        Set ↥(AlgebraicGeometry.Spec (B₀.left.presheaf.obj (Opposite.op U)))) :=
      h_img_eq ▸ e_homeo.isClosedMap _ hyU_cl
    have hMax_m : (U.toSpecΓ.base y_U).asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal (U.toSpecΓ.base y_U)).mp h_cl_spec
    have hMax_IS : (Ideal.comap ψ_S.toRingHom (U.toSpecΓ.base y_U).asIdeal).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective ψ_S.toRingHom hψ_surj
    obtain ⟨a, ha_eq⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k) (σ := ↥S)).mp hMax_IS
    let ev_poly : MvPolynomial ↥S k →+* k := (MvPolynomial.aeval a).toRingHom
    have h_ker_le : ∀ p ∈ RingHom.ker ψ_S.toRingHom, ev_poly p = 0 := by
      intro p hp
      have hp_in : p ∈ Ideal.comap ψ_S.toRingHom (U.toSpecΓ.base y_U).asIdeal := by
        rw [Ideal.mem_comap, RingHom.mem_ker.mp hp]
        exact Ideal.zero_mem _
      rw [ha_eq, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hp_in
      exact hp_in
    let ev_y : R →+* k :=
      (Ideal.Quotient.lift (RingHom.ker ψ_S.toRingHom) ev_poly h_ker_le).comp
        (RingHom.quotientKerEquivOfSurjective (f := ψ_S.toRingHom) hψ_surj).symm.toRingHom
    have hev_ψ : ∀ p : MvPolynomial ↥S k, ev_y (ψ_S p) = MvPolynomial.aeval a p := by
      intro p
      change Ideal.Quotient.lift _ ev_poly h_ker_le
        ((RingHom.quotientKerEquivOfSurjective (f := ψ_S.toRingHom) hψ_surj).symm
          (RingHom.quotientKerEquivOfSurjective (f := ψ_S.toRingHom) hψ_surj
            (Ideal.Quotient.mk _ p))) = _
      rw [RingEquiv.symm_apply_apply, Ideal.Quotient.lift_mk]
      rfl
    refine ⟨ev_y, ?_, ?_⟩
    · ext c
      change ev_y (algebraMap k R c) = c
      rw [← ψ_S.commutes c, hev_ψ, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
    · ext r
      obtain ⟨p, rfl⟩ := hψ_surj r
      change ev_y (ψ_S p) = 0 ↔ ψ_S p ∈ (U.toSpecΓ.base y_U).asIdeal
      rw [hev_ψ, ← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← ha_eq, Ideal.mem_comap]
      rfl

  
  have hImmB₀ : ∃ s_y : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ B₀.left,
      AlgebraicGeometry.IsClosedImmersion s_y ∧ Set.range s_y.base = {y} := by
    obtain ⟨U₀', hU₀', hy₀', _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    obtain ⟨ev₀, hev₀_id, hev₀_ker⟩ := hEvB₀ U₀' hU₀' hy₀'
    have hev₀_surj : Function.Surjective ev₀ :=
      Function.RightInverse.surjective (fun c => RingHom.congr_fun hev₀_id c)
    let j₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (B₀.left.presheaf.obj (Opposite.op U₀')) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)
    have : AlgebraicGeometry.IsClosedImmersion j₀ :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom ev₀) hev₀_surj
    let s_y : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ B₀.left := j₀ ≫ hU₀'.fromSpec
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := ⟨⊥, Ideal.isPrime_bot⟩
    have hj_pt₀ : j₀.base pt₀ = U₀'.toSpecΓ.base ⟨y, hy₀'⟩ := by
      apply PrimeSpectrum.ext
      change Ideal.comap ev₀ ⊥ = (U₀'.toSpecΓ.base ⟨y, hy₀'⟩).asIdeal
      rw [← RingHom.ker_eq_comap_bot, hev₀_ker]
    have hs_pt₀ : s_y.base pt₀ = y := by
      change hU₀'.fromSpec.base (j₀.base pt₀) = y
      rw [hj_pt₀]
      change (U₀'.toSpecΓ ≫ hU₀'.fromSpec).base ⟨y, hy₀'⟩ = y
      rw [hU₀'.toSpecΓ_fromSpec]
      rfl
    have hs_range : Set.range s_y.base = {y} := by
      ext z
      constructor
      · rintro ⟨q, rfl⟩
        have hq : q = pt₀ := by
          apply PrimeSpectrum.ext
          exact (Ideal.eq_bot_or_top q.asIdeal).resolve_right q.isPrime.ne_top
        rw [hq, hs_pt₀, Set.mem_singleton_iff]
      · rintro rfl
        exact ⟨pt₀, hs_pt₀⟩
    have hs_cl : AlgebraicGeometry.IsClosedImmersion s_y :=
      AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion s_y (hs_range ▸ hy)
    exact ⟨s_y, hs_cl, hs_range⟩

  
  have hS2 : ∀ (F : Type u) [TopologicalSpace F] [T0Space F] [TopologicalSpace.NoetherianSpace F]
      (U : Set F),
      IsOpen U →
      (∀ E ∈ irreducibleComponents F, topologicalKrullDim ↥E = (1 : WithBot ℕ∞) ∧ ∃ q ∈ E, q ∈ U) →
      (Uᶜ : Set F).Finite ∧ (∀ z : F, z ∉ U → IsClosed ({z} : Set F)) := by
    intro F _ _ _ U hU hComp
    have hPreirrSub : ∀ {E S : Set F}, S ⊆ E → IsPreirreducible S →
        IsPreirreducible ((Subtype.val : ↥E → F) ⁻¹' S) := by
      intro E S hSE hS V₁ V₂ hV₁ hV₂ ⟨a₁, ha₁S, ha₁V⟩ ⟨a₂, ha₂S, ha₂V⟩
      obtain ⟨O₁, hO₁, rfl⟩ := isOpen_induced_iff.mp hV₁
      obtain ⟨O₂, hO₂, rfl⟩ := isOpen_induced_iff.mp hV₂
      obtain ⟨x, hxS, hxO₁, hxO₂⟩ := hS O₁ O₂ hO₁ hO₂ ⟨a₁.1, ha₁S, ha₁V⟩ ⟨a₂.1, ha₂S, ha₂V⟩
      exact ⟨⟨x, hSE hxS⟩, hxS, hxO₁, hxO₂⟩
    have hNoStrict : ∀ (W Z : Set F),
        IsClosed W → IsIrreducible W →
        IsClosed Z → IsIrreducible Z →
        W ⊆ Z → Z ⊆ Uᶜ →
        ∀ z₀ ∈ Z, z₀ ∈ W := by
      intro W Z hW_cl hW_irr hZ_cl hZ_irr hWZ hZUc z₀ hz₀Z
      by_contra hz₀W
      obtain ⟨E, hE_mem, hZE⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible Z hZ_irr
      have hWE : W ⊆ E := hWZ.trans hZE
      obtain ⟨hDimE, q, hqE, hqU⟩ := hComp E hE_mem
      have hq_not_Z : q ∉ Z := fun hqZ => hZUc hqZ hqU
      obtain ⟨w₀, hw₀W⟩ := hW_irr.1
      let val_E : ↥E → F := Subtype.val
      let C₀ : TopologicalSpace.IrreducibleCloseds ↥E :=
        ⟨val_E ⁻¹' W, ⟨⟨⟨w₀, hWE hw₀W⟩, hw₀W⟩, hPreirrSub hWE hW_irr.2⟩,
          hW_cl.preimage continuous_subtype_val⟩
      let C₁ : TopologicalSpace.IrreducibleCloseds ↥E :=
        ⟨val_E ⁻¹' Z, ⟨⟨⟨z₀, hZE hz₀Z⟩, hz₀Z⟩, hPreirrSub hZE hZ_irr.2⟩,
          hZ_cl.preimage continuous_subtype_val⟩
      have h_univ_eq : val_E ⁻¹' E = (Set.univ : Set ↥E) := by
        ext x
        exact ⟨fun _ => trivial, fun _ => x.2⟩
      let C₂ : TopologicalSpace.IrreducibleCloseds ↥E :=
        ⟨Set.univ, ⟨⟨⟨q, hqE⟩, trivial⟩, h_univ_eq ▸ hPreirrSub Set.Subset.rfl hE_mem.1.2⟩,
          isClosed_univ⟩
      have hC01 : C₀ < C₁ := by
        rw [lt_iff_le_not_ge]
        simp only [← SetLike.coe_subset_coe]
        refine ⟨fun x hx => hWZ hx, fun h_sub => hz₀W ?_⟩
        exact h_sub (show (⟨z₀, hZE hz₀Z⟩ : ↥E) ∈ (C₁ : Set ↥E) from hz₀Z)
      have hC12 : C₁ < C₂ := by
        rw [lt_iff_le_not_ge]
        simp only [← SetLike.coe_subset_coe]
        refine ⟨Set.subset_univ _, fun h_sub => hq_not_Z ?_⟩
        exact h_sub (show (⟨q, hqE⟩ : ↥E) ∈ (C₂ : Set ↥E) from trivial)
      let l : LTSeries (TopologicalSpace.IrreducibleCloseds ↥E) :=
        RelSeries.mk 2 ![C₀, C₁, C₂] (Fin.forall_fin_two.mpr ⟨hC01, hC12⟩)
      have h2_le : ((2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥E :=
        Order.le_krullDim_iff.mpr ⟨l, rfl⟩
      rw [hDimE] at h2_le
      norm_num at h2_le
    have hSingClosed : ∀ z : F, z ∉ U → IsClosed ({z} : Set F) := by
      intro z hz
      by_contra h_not_cl
      let Z : Set F := closure {z}
      have hZUc : Z ⊆ Uᶜ := closure_minimal (Set.singleton_subset_iff.mpr hz) hU.isClosed_compl
      have h_exists_w : ∃ w ∈ Z, w ≠ z := by
        by_contra h_all
        have h_eq : Z = {z} := Set.Subset.antisymm
          (fun w hw => Set.mem_singleton_iff.mpr
            (by_contra fun hne => h_all ⟨w, hw, hne⟩))
          subset_closure
        exact h_not_cl (h_eq ▸ isClosed_closure)
      obtain ⟨w, hwZ, hw_ne⟩ := h_exists_w
      let W : Set F := closure {w}
      have hWZ : W ⊆ Z := closure_minimal (Set.singleton_subset_iff.mpr hwZ) isClosed_closure
      have hzW : z ∈ W := hNoStrict W Z isClosed_closure isIrreducible_singleton.closure
        isClosed_closure isIrreducible_singleton.closure hWZ hZUc z (subset_closure rfl)
      have hZW : Z ⊆ W := closure_minimal (Set.singleton_subset_iff.mpr hzW) isClosed_closure
      have h_cl_eq : closure ({w} : Set F) = closure ({z} : Set F) := Set.Subset.antisymm hWZ hZW
      exact hw_ne (inseparable_iff_closure_eq.mpr h_cl_eq).eq
    let K : Set F := Uᶜ
    have hK_cl : IsClosed K := hU.isClosed_compl
    have : TopologicalSpace.NoetherianSpace ↥K := TopologicalSpace.NoetherianSpace.set K
    have hFinCompK : (irreducibleComponents ↥K).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    have hEachFin : ∀ Z_K ∈ irreducibleComponents ↥K, Z_K.Finite := by
      intro Z_K hZK
      have hZK_cl : IsClosed Z_K := isClosed_of_mem_irreducibleComponents Z_K hZK
      let Z : Set F := (Subtype.val : ↥K → F) '' Z_K
      have hZ_cl : IsClosed Z := IsClosed.trans hZK_cl hK_cl
      have hZ_irr : IsIrreducible Z :=
        hZK.1.image (Subtype.val : ↥K → F) continuous_subtype_val.continuousOn
      have hZUc : Z ⊆ Uᶜ := by
        rintro _ ⟨x, _, rfl⟩
        exact x.2
      obtain ⟨x₁, hx₁⟩ := hZK.1.1
      have hz₁_cl : IsClosed ({x₁.1} : Set F) := hSingClosed x₁.1 x₁.2
      have hW_sub_Z : ({x₁.1} : Set F) ⊆ Z := Set.singleton_subset_iff.mpr ⟨x₁, hx₁, rfl⟩
      refine (Set.finite_singleton x₁).subset ?_
      intro x₂ hx₂
      have hx₂_in : x₂.1 ∈ ({x₁.1} : Set F) :=
        hNoStrict {x₁.1} Z hz₁_cl isIrreducible_singleton hZ_cl hZ_irr hW_sub_Z hZUc
          x₂.1 ⟨x₂, hx₂, rfl⟩
      exact Set.mem_singleton_iff.mpr (Subtype.ext (Set.mem_singleton_iff.mp hx₂_in))
    have hUnivFin : (Set.univ : Set ↥K).Finite := by
      refine (hFinCompK.biUnion hEachFin).subset ?_
      intro x _
      exact Set.mem_biUnion (irreducibleComponent_mem_irreducibleComponents x)
        mem_irreducibleComponent
    have : Finite ↥K := Set.finite_univ_iff.mp hUnivFin
    exact ⟨Set.toFinite K, hSingClosed⟩

  
  have hS3 : ∀ (X Y : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ Y)
      (W_sm W_p : X.Opens) (v : X),
      v ∈ W_sm → v ∈ W_p →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f) →
      ∃ (U_B : Y.Opens) (V : X.Opens),
        v ∈ V ∧ V ≤ W_sm ∧ V ≤ W_p ∧
        AlgebraicGeometry.IsAffineOpen U_B ∧
        f.base v ∈ U_B ∧
        AlgebraicGeometry.IsAffineOpen V ∧
        ∃ (e : V ≤ (TopologicalSpace.Opens.map f.base).obj U_B),
          RingHom.IsStandardSmoothOfRelativeDimension 1 (f.appLE U_B V e).hom := by
    intro X Y f W_sm W_p v hv_sm hv_p hSm
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f) := hSm
    let W' : X.Opens := W_sm ⊓ W_p
    let j : W'.toScheme ⟶ W_sm.toScheme := X.homOfLE inf_le_left
    have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (j ≫ (W_sm.ι ≫ f)) :=
      inferInstance
    have h_j_comp : j ≫ (W_sm.ι ≫ f) = W'.ι ≫ f := by
      rw [← CategoryTheory.Category.assoc, X.homOfLE_ι inf_le_left]
    have hSmW' : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W'.ι ≫ f) := by
      simpa only [Nat.zero_add, h_j_comp] using hSm01
    let x' : ↥W'.toScheme := ⟨v, ⟨hv_sm, hv_p⟩⟩
    obtain ⟨U_B, hUB, V_sub, hV_sub, hx_sub, e_sub, hStd_sub⟩ :=
      AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
        (n := 1) (f := W'.ι ≫ f) x'
    let V : X.Opens := W'.ι ''ᵁ V_sub
    have hV_aff : AlgebraicGeometry.IsAffineOpen V := hV_sub.image_of_isOpenImmersion W'.ι
    have hv_V : v ∈ V := ⟨x', hx_sub, rfl⟩
    have hV_le_sm : V ≤ W_sm := by
      rintro _ ⟨z, _, rfl⟩
      exact z.2.1
    have hV_le_p : V ≤ W_p := by
      rintro _ ⟨z, _, rfl⟩
      exact z.2.2
    have e : V ≤ (TopologicalSpace.Opens.map f.base).obj U_B := by
      rintro _ ⟨z, hz, rfl⟩
      exact e_sub hz
    have hfv_UB : f.base v ∈ U_B := e hv_V
    have e_V : V_sub ≤ (TopologicalSpace.Opens.map W'.ι.base).obj V := fun z hz => ⟨z, hz, rfl⟩
    have h_comp_app : f.appLE U_B V e ≫ W'.ι.appLE V V_sub e_V =
        (W'.ι ≫ f).appLE U_B V_sub e_sub :=
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W'.ι f U_B V V_sub e e_V
    have h_iso_eq : (W'.ι.appIso V_sub).hom = W'.ι.appLE V V_sub e_V :=
      AlgebraicGeometry.Scheme.Hom.appIso_hom' W'.ι V_sub
    rw [← h_iso_eq] at h_comp_app
    have h_app_eq : f.appLE U_B V e =
        (W'.ι ≫ f).appLE U_B V_sub e_sub ≫ (W'.ι.appIso V_sub).inv :=
      (CategoryTheory.Iso.eq_comp_inv (W'.ι.appIso V_sub)).mpr h_comp_app
    have h_hom_eq : (f.appLE U_B V e).hom =
        (W'.ι.appIso V_sub).symm.commRingCatIsoToRingEquiv.toRingHom.comp
          ((W'.ι ≫ f).appLE U_B V_sub e_sub).hom := by
      rw [h_app_eq, CommRingCat.hom_comp]
      rfl
    have hStd_V : RingHom.IsStandardSmoothOfRelativeDimension 1 (f.appLE U_B V e).hom := by
      rw [h_hom_eq]
      exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.1
        ((W'.ι ≫ f).appLE U_B V_sub e_sub).hom
        (W'.ι.appIso V_sub).symm.commRingCatIsoToRingEquiv hStd_sub
    exact ⟨U_B, V, hv_V, hV_le_sm, hV_le_p, hUB, hfv_UB, hV_aff, e, hStd_V⟩

  
  obtain ⟨s_y, hs_cl, hs_range⟩ := hImmB₀
  have : AlgebraicGeometry.IsClosedImmersion s_y := hs_cl
  let F_y := CategoryTheory.Limits.pullback f₁.left s_y
  let π_y : F_y ⟶ V₁.left := CategoryTheory.Limits.pullback.fst f₁.left s_y
  have hEmb : Topology.IsClosedEmbedding π_y.base :=
    AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding π_y
  have h_range_π : Set.range π_y.base = f₁.left.base ⁻¹' {y} := by
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst, hs_range]
  have : TopologicalSpace.NoetherianSpace ↥F_y := hEmb.isInducing.noetherianSpace
  let U_sm : V₁.left.Opens :=
    sSup {W : V₁.left.Opens | AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left)}
  have h_mem_Usm : ∀ v : V₁.left, v ∈ U_sm ↔
      ∃ W_sm : V₁.left.Opens,
        v ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left) := by
    intro v
    rw [TopologicalSpace.Opens.mem_sSup]
    exact ⟨fun ⟨W, hSm, hvW⟩ => ⟨W, hvW, hSm⟩, fun ⟨W, hvW, hSm⟩ => ⟨W, hSm, hvW⟩⟩
  let U_F : Set ↥F_y := π_y.base ⁻¹' (U_sm : Set V₁.left)
  have hUF_open : IsOpen U_F := U_sm.isOpen.preimage π_y.base.hom.continuous
  have hComp_Fy : ∀ E ∈ irreducibleComponents ↥F_y,
      topologicalKrullDim ↥E = (1 : WithBot ℕ∞) ∧ ∃ q ∈ E, q ∈ U_F := by
    intro E hE
    obtain ⟨hDimE, q, W, hqE, hqW, hSmW⟩ := (hFib₁.2.2.2 k s_y).2 E hE
    exact ⟨hDimE, q, hqE, (h_mem_Usm (π_y.base q)).mpr ⟨W, hqW, hSmW⟩⟩
  obtain ⟨hFin_UFc, hCl_UFc⟩ := hS2 ↥F_y U_F hUF_open hComp_Fy

  have hSingFin : ({v : V₁.left | f₁.left.base v = y ∧
      ¬ ∃ W_sm : V₁.left.Opens,
        v ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left)}).Finite := by
    refine (hFin_UFc.image π_y.base).subset ?_
    rintro v ⟨hvy, hv_nsm⟩
    have hv_range : v ∈ Set.range π_y.base := by
      rw [h_range_π]
      exact hvy
    obtain ⟨z, rfl⟩ := hv_range
    refine ⟨z, fun hz_UF => hv_nsm ?_, rfl⟩
    exact (h_mem_Usm (π_y.base z)).mp hz_UF

  have hSingCl : ∀ v : V₁.left,
      f₁.left.base v = y →
      (¬ ∃ W_sm : V₁.left.Opens,
        v ∈ W_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left)) →
      IsClosed ({v} : Set V₁.left) := by
    intro v hvy hv_nsm
    have hv_range : v ∈ Set.range π_y.base := by
      rw [h_range_π]
      exact hvy
    obtain ⟨z, rfl⟩ := hv_range
    have hz_nUF : z ∉ U_F := fun hz_UF => hv_nsm ((h_mem_Usm (π_y.base z)).mp hz_UF)
    simpa only [Set.image_singleton] using hEmb.isClosedMap {z} (hCl_UFc z hz_nUF)

  have hPtChart : ∀ p : ↥U_F,
      ∃ (μ : Fin (M₀ + 1)) (W_sm : V₁.left.Opens) (U_B : B₀.left.Opens) (V : V₁.left.Opens),
        π_y.base p.1 ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left) ∧
        V ≤ W_sm ∧
        V ≤ W_proj μ ∧
        AlgebraicGeometry.IsAffineOpen U_B ∧
        y ∈ U_B ∧
        AlgebraicGeometry.IsAffineOpen V ∧
        ∃ (e_γ : V ≤ (TopologicalSpace.Opens.map f₁.left.base).obj U_B)
          (ev_y : ↑(B₀.left.presheaf.obj (Opposite.op U_B)) →+* k),
          RingHom.IsStandardSmoothOfRelativeDimension 1 (f₁.left.appLE U_B V e_γ).hom ∧
          ev_y.comp ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            B₀.hom.appTop ≫ B₀.left.presheaf.map (CategoryTheory.homOfLE le_top).op).hom =
              RingHom.id k ∧
          ∀ (v : V₁.left) (hv : v ∈ V),
            f₁.left.base v = y →
            Ideal.map (f₁.left.appLE U_B V e_γ).hom (RingHom.ker ev_y) ≤
              (V.toSpecΓ.base ⟨v, hv⟩).asIdeal := by
    intro p
    let v : V₁.left := π_y.base p.1
    have hv_y : f₁.left.base v = y := by
      have hv_r : v ∈ Set.range π_y.base := ⟨p.1, rfl⟩
      rwa [h_range_π, Set.mem_preimage, Set.mem_singleton_iff] at hv_r
    obtain ⟨W_sm, hv_sm, hSmW⟩ := (h_mem_Usm v).mp p.2
    have hv_top : v ∈ (⨆ μ : Fin (M₀ + 1), W_proj μ) := by
      rw [hW_top]
      trivial
    obtain ⟨μ, hv_proj⟩ := TopologicalSpace.Opens.mem_iSup.mp hv_top
    obtain ⟨U_B, V, hv_V, hV_sm, hV_proj, hUB_aff, hfv_UB, hV_aff, e_γ, hStd⟩ :=
      hS3 V₁.left B₀.left f₁.left W_sm (W_proj μ) v hv_sm hv_proj hSmW
    have hy_UB : y ∈ U_B := hv_y ▸ hfv_UB
    obtain ⟨ev_y, hev_id, hev_ker⟩ := hEvB₀ U_B hUB_aff hy_UB
    refine ⟨μ, W_sm, U_B, V, hv_V, hSmW, hV_sm, hV_proj, hUB_aff, hy_UB, hV_aff,
      e_γ, ev_y, hStd, hev_id, ?_⟩
    intro w hw hw_y
    rw [Ideal.map_le_iff_le_comap, hev_ker]
    have h_nat := congrArg (fun g => (g.base ⟨w, hw⟩).asIdeal)
      (AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE f₁.left U_B V e_γ)
    have h_res_pt : (f₁.left.resLE U_B V e_γ).base ⟨w, hw⟩ = (⟨y, hy_UB⟩ : ↥U_B.toScheme) := by
      apply Subtype.ext
      have h_comp := congrArg (fun g => g.base ⟨w, hw⟩)
        (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι f₁.left e_γ)
      exact h_comp.trans hw_y
    change Ideal.comap (f₁.left.appLE U_B V e_γ).hom (V.toSpecΓ.base ⟨w, hw⟩).asIdeal =
      (U_B.toSpecΓ.base ((f₁.left.resLE U_B V e_γ).base ⟨w, hw⟩)).asIdeal at h_nat
    rw [h_res_pt] at h_nat
    exact le_of_eq h_nat.symm

  choose μ_pt W_sm_pt U_B_pt V_pt hv_pt hSm_pt hV_sm_pt hV_proj_pt hUB_aff_pt hy_UB_pt
    hV_aff_pt hRest_pt using hPtChart
  have h_cov_UF : U_F ⊆ ⋃ p : ↥U_F, π_y.base ⁻¹' (V_pt p : Set V₁.left) := by
    intro z hz
    exact Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hv_pt ⟨z, hz⟩⟩
  obtain ⟨S_cov, hS_cov⟩ :=
    (TopologicalSpace.NoetherianSpace.isCompact U_F).elim_finite_subcover
      (fun p : ↥U_F => π_y.base ⁻¹' (V_pt p : Set V₁.left))
      (fun p => (V_pt p).isOpen.preimage π_y.base.hom.continuous)
      h_cov_UF
  let e_fin : Fin S_cov.card ≃ ↥S_cov := S_cov.equivFin.symm
  refine ⟨hSingFin, hSingCl, S_cov.card,
    fun γ => μ_pt (e_fin γ).1,
    fun γ => W_sm_pt (e_fin γ).1,
    fun γ => U_B_pt (e_fin γ).1,
    fun γ => V_pt (e_fin γ).1,
    ?_, ?_⟩
  · intro v hvy hv_sm
    have hv_range : v ∈ Set.range π_y.base := by
      rw [h_range_π]
      exact hvy
    obtain ⟨z, rfl⟩ := hv_range
    have hz_UF : z ∈ U_F := (h_mem_Usm (π_y.base z)).mpr hv_sm
    have hz_cov := hS_cov hz_UF
    rw [Set.mem_iUnion₂] at hz_cov
    obtain ⟨p, hpS, hzp⟩ := hz_cov
    refine ⟨e_fin.symm ⟨p, hpS⟩, ?_⟩
    simpa using hzp
  · intro γ
    exact ⟨hSm_pt (e_fin γ).1, hV_sm_pt (e_fin γ).1, hV_proj_pt (e_fin γ).1,
      hUB_aff_pt (e_fin γ).1, hy_UB_pt (e_fin γ).1, hV_aff_pt (e_fin γ).1,
      hRest_pt (e_fin γ).1⟩

theorem weil_algClosed_bertini_closedPoint_etale_slice (k : Type u) [Field k] [IsAlgClosed k] (M₀ d₀ : ℕ) (hd₀ : 1 ≤ d₀)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀)
    (G_qf : MvPolynomial (weilDegMonomialIdx M₀ d₀) k)
    (hG_qf : G_qf ≠ 0)
    (y : B₀.left)
    (hy : IsClosed ({y} : Set B₀.left)) :
    ∃ (c : weilDegMonomialIdx M₀ d₀ → k),
      MvPolynomial.eval c G_qf ≠ 0 ∧
      (weilHomogeneousPoly M₀ d₀ c) ∈
        MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k d₀ ∧
      ∀ (H : AlgebraicGeometry.Scheme.{u}) (ιH : H ⟶ V₁.left),
        IsHomogeneousHypersurfacePullbackOver k M₀ d₀ ι₁
          (weilHomogeneousPoly M₀ d₀ c) ιH →
        ∃ (W_y : B₀.left.Opens),
          y ∈ W_y ∧
          AlgebraicGeometry.Etale ((ιH ≫ f₁.left) ∣_ W_y) ∧
          ∀ z : H, (ιH ≫ f₁.left).base z ∈ W_y →
            ∃ W_sm : V₁.left.Opens,
              ιH.base z ∈ W_sm ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f₁.left) :=
by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  obtain ⟨hHom, hEvalSing, W_proj, x_proj, hW_top, _hW_aff, hx_diag, hDerSpan, hKerCartier⟩ :=
    weil_proj_chart_dehomog_poly_and_closedPoint_eval k M₀ d₀ hd₀ V₁ ι₁ hCl₁
  obtain ⟨hSingFin, hSingCl, G, μ_chart, W_sm_chart, U_B_chart, V_chart, hCovSm, hCharts⟩ :=
    weil_closedPoint_curve_fiber_sing_finite_and_smooth_charts k M₀ B₀ U₀ hProjB₀ V₁ ι₁ hCl₁
      f₁ hFib₁ W_proj hW_top y hy
  have hSingPolys : ∀ v : ↥hSingFin.toFinset,
      ∃ E_v : MvPolynomial (weilDegMonomialIdx M₀ d₀) k,
        E_v ≠ 0 ∧
        ∀ c : weilDegMonomialIdx M₀ d₀ → k,
          MvPolynomial.eval c E_v ≠ 0 →
          v.1 ∈ (TopologicalSpace.Opens.map ι₁.left.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 (weilHomogeneousPoly M₀ d₀ c)) := by
    intro v
    have hv_mem := hSingFin.mem_toFinset.mp v.2
    exact hEvalSing v.1 (hSingCl v.1 hv_mem.1 hv_mem.2)
  choose E_sing hE_sing_ne hE_sing_mem using hSingPolys
  have hSm_W : ∀ γ : Fin G,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 ((W_sm_chart γ).ι ≫ f₁.left) :=
    fun γ => (hCharts γ).1
  have hV_le_Wsm : ∀ γ : Fin G, V_chart γ ≤ W_sm_chart γ :=
    fun γ => (hCharts γ).2.1
  have hV_le_Wproj : ∀ γ : Fin G, V_chart γ ≤ W_proj (μ_chart γ) :=
    fun γ => (hCharts γ).2.2.1
  have hUB_aff : ∀ γ : Fin G, AlgebraicGeometry.IsAffineOpen (U_B_chart γ) :=
    fun γ => (hCharts γ).2.2.2.1
  have hV_aff : ∀ γ : Fin G, AlgebraicGeometry.IsAffineOpen (V_chart γ) :=
    fun γ => (hCharts γ).2.2.2.2.2.1
  choose e_chart ev_y_chart hStdSm_chart hev_id_chart hIdeal_chart using
    fun γ => (hCharts γ).2.2.2.2.2.2
  let R_chart : Fin G → Type u :=
    fun γ => ↑(B₀.left.presheaf.obj (Opposite.op (U_B_chart γ)))
  let S_chart : Fin G → Type u :=
    fun γ => ↑(V₁.left.presheaf.obj (Opposite.op (V_chart γ)))
  let φ_chart : ∀ γ : Fin G, R_chart γ →+* S_chart γ :=
    fun γ => (f₁.left.appLE (U_B_chart γ) (V_chart γ) (e_chart γ)).hom
  have hS1_all : ∀ γ : Fin G,
      let _ : Algebra (R_chart γ) (S_chart γ) := (φ_chart γ).toAlgebra
      ∃ (ψ : MvPolynomial (Fin 1) (R_chart γ) →+* S_chart γ)
        (der_S : Derivation (R_chart γ) (S_chart γ) (S_chart γ)),
        ψ.comp MvPolynomial.C = φ_chart γ ∧
        ψ.Etale ∧
        der_S (ψ (MvPolynomial.X 0)) = 1 ∧
        (∀ (F₀ : Type u) [Field F₀] (k_R : F₀ →+* R_chart γ) (ev : R_chart γ →+* F₀),
          ev.comp k_R = RingHom.id F₀ →
          let _ : Algebra F₀ (S_chart γ ⧸ Ideal.map (φ_chart γ) (RingHom.ker ev)) :=
            ((Ideal.Quotient.mk (Ideal.map (φ_chart γ) (RingHom.ker ev))).comp
              ((φ_chart γ).comp k_R)).toAlgebra
          ∃ (ψ_k : MvPolynomial (Fin 1) F₀ →+*
              (S_chart γ ⧸ Ideal.map (φ_chart γ) (RingHom.ker ev)))
            (der_T : Derivation F₀ (S_chart γ ⧸ Ideal.map (φ_chart γ) (RingHom.ker ev))
              (S_chart γ ⧸ Ideal.map (φ_chart γ) (RingHom.ker ev))),
            ψ_k.comp MvPolynomial.C =
              algebraMap F₀ (S_chart γ ⧸ Ideal.map (φ_chart γ) (RingHom.ker ev)) ∧
            ψ_k.Etale ∧
            der_T (Ideal.Quotient.mk (Ideal.map (φ_chart γ) (RingHom.ker ev))
              (ψ (MvPolynomial.X 0))) = 1 ∧
            (∀ s : S_chart γ,
              der_T (Ideal.Quotient.mk (Ideal.map (φ_chart γ) (RingHom.ker ev)) s) =
                Ideal.Quotient.mk (Ideal.map (φ_chart γ) (RingHom.ker ev)) (der_S s))) ∧
        (∀ (h : S_chart γ) (Q B : Type u) [CommRing Q] [CommRing B] [Algebra Q B]
            (q : S_chart γ →+* Q),
          Function.Surjective q →
          RingHom.ker q = Ideal.span {h} →
          IsLocalization.Away (q (der_S h)) B →
          RingHom.IsStandardSmoothOfRelativeDimension 0
            ((algebraMap Q B).comp (q.comp (φ_chart γ)))) :=
    fun γ => weil_relDimOne_etale_derivation_and_slice_away (R_chart γ) (S_chart γ)
      (φ_chart γ) (hStdSm_chart γ)
  let _ : ∀ γ : Fin G, Algebra (R_chart γ) (S_chart γ) := fun γ => (φ_chart γ).toAlgebra
  choose ψ_S der_S _hψ_S_comp _hψ_S_et _hder_S_X hFibRed hSlice using hS1_all
  let k_RB : ∀ γ : Fin G, k →+* R_chart γ := fun γ =>
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      B₀.hom.appTop ≫ B₀.left.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
  let k_SV : ∀ γ : Fin G, k →+* S_chart γ := fun γ =>
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      V₁.hom.appTop ≫ V₁.left.presheaf.map (CategoryTheory.homOfLE le_top).op).hom
  have hk_compat : ∀ γ : Fin G, (φ_chart γ).comp (k_RB γ) = k_SV γ := by
    intro γ
    have h_comm :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          B₀.hom.appTop ≫ B₀.left.presheaf.map (CategoryTheory.homOfLE le_top).op) ≫
            f₁.left.appLE (U_B_chart γ) (V_chart γ) (e_chart γ) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          V₁.hom.appTop ≫ V₁.left.presheaf.map (CategoryTheory.homOfLE le_top).op := by
      simp only [CategoryTheory.Category.assoc]
      congr 1
      have hw : f₁.left ≫ B₀.hom = V₁.hom := f₁.w
      rw [← hw, AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc]
      congr 1
      rw [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.naturality_assoc,
        ← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp]
      rfl
    have h_hom := congrArg CommRingCat.Hom.hom h_comm
    rwa [CommRingCat.hom_comp] at h_hom
  have hTanPolys : ∀ γ : Fin G,
      ∃ (G_tan : MvPolynomial (weilDegMonomialIdx M₀ d₀) k),
        G_tan ≠ 0 ∧
        ∀ (c : weilDegMonomialIdx M₀ d₀ → k),
          MvPolynomial.eval c G_tan ≠ 0 →
          let I_γ := Ideal.map (φ_chart γ) (RingHom.ker (ev_y_chart γ))
          let π_γ := Ideal.Quotient.mk I_γ
          let h_c : S_chart γ := ∑ e : weilDegMonomialIdx M₀ d₀,
            k_SV γ (c e) *
              ∏ ν : Fin (M₀ + 1),
                ((V₁.left.presheaf.map (CategoryTheory.homOfLE (hV_le_Wproj γ)).op).hom
