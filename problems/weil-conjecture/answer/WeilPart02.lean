      exact RingHom.Finite.comp hFinφ₀ (RingHom.Finite.of_surjective _ e₀.surjective)
    exact ⟨hAff₀, hAff₁, hAff₀₁, u, v, hu, hv, huv, hFinEval⟩

  
  
  
  
  have h_s3 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
      (ϖ : R), IsLocalRing.maximalIdeal R = Ideal.span {ϖ} →
      ∀ (B₀ B₁ B₀₁ : Type u) [CommRing B₀] [CommRing B₁] [CommRing B₀₁]
      (r₀ : R →+* B₀) (r₁ : R →+* B₁) (r₀₁ : R →+* B₀₁)
      (res₀ : B₀ →+* B₀₁) (res₁ : B₁ →+* B₀₁),
      res₀.comp r₀ = r₀₁ → res₁.comp r₁ = r₀₁ →
      (∀ (x₀ : B₀) (x₁ : B₁), res₀ x₀ = res₁ x₁ → ∃ r : R, r₀ r = x₀ ∧ r₁ r = x₁) →
      ∀ (u : B₀) (v : B₁),
      res₀ u * res₁ v = 1 →
      (Polynomial.eval₂RingHom r₀ u).Finite →
      (∀ z : B₀₁, ∃ (m : ℕ) (b₀ : B₀), z * (res₀ u) ^ m = res₀ b₀) →
      (∀ z : B₀₁, ∃ (m : ℕ) (b₁ : B₁), z * (res₁ v) ^ m = res₁ b₁) →
      ∀ (x₀ : B₀) (x₁ : B₁),
      x₀ ^ 2 - x₀ ∈ Ideal.span {r₀ ϖ} →
      x₁ ^ 2 - x₁ ∈ Ideal.span {r₁ ϖ} →
      res₀ x₀ - res₁ x₁ ∈ Ideal.span {r₀₁ ϖ} →
      (x₀ ∈ Ideal.span {r₀ ϖ} ∧ x₁ ∈ Ideal.span {r₁ ϖ}) ∨
      (1 - x₀ ∈ Ideal.span {r₀ ϖ} ∧ 1 - x₁ ∈ Ideal.span {r₁ ϖ}) := by
    clear * -
    intro R _ _ _ ϖ hMax B₀ B₁ B₀₁ _ _ _ r₀ r₁ r₀₁ res₀ res₁ hr₀ hr₁ hGlued u v huv hFin₀ hLoc₀ hLoc₁ x₀ x₁ hx₀ hx₁ hx₀₁
    have hr₀_apply : ∀ c : R, res₀ (r₀ c) = r₀₁ c := fun c => by rw [← RingHom.comp_apply, hr₀]
    have hr₁_apply : ∀ c : R, res₁ (r₁ c) = r₀₁ c := fun c => by rw [← RingHom.comp_apply, hr₁]
    obtain ⟨E, hE⟩ : ∃ E : Finset B₀, ∀ b₀ : B₀, ∃ p : B₀ → Polynomial R,
        ∑ e ∈ E, Polynomial.eval₂ r₀ u (p e) * e = b₀ := by
      let : Algebra (Polynomial R) B₀ := (Polynomial.eval₂RingHom r₀ u).toAlgebra
      have hMF : Module.Finite (Polynomial R) B₀ := hFin₀
      obtain ⟨E, hE_top⟩ := hMF.fg_top
      refine ⟨E, fun b₀ => ?_⟩
      have hb : b₀ ∈ Submodule.span (Polynomial R) (E : Set B₀) := hE_top ▸ Submodule.mem_top
      obtain ⟨p, _, hp⟩ := Submodule.mem_span_finset.mp hb
      exact ⟨p, hp⟩
    have hPole : ∀ e : B₀, ∃ (d : ℕ) (g : B₁), res₀ e * (res₁ v) ^ d = res₁ g :=
      fun e => hLoc₁ (res₀ e)
    choose d_pole g_pole hg_pole using hPole
    let D : ℕ := 1 + E.sup d_pole
    have huv_ge : ∀ {j M : ℕ}, M ≤ j → (res₀ u) ^ j * (res₁ v) ^ M = (res₀ u) ^ (j - M) := by
      intro j M hMj
      have hj : j = (j - M) + M := (Nat.sub_add_cancel hMj).symm
      conv_lhs => rw [hj]
      rw [pow_add, mul_assoc, ← mul_pow, huv, one_pow, mul_one]
    have huv_le : ∀ {j M : ℕ}, j ≤ M → (res₀ u) ^ j * (res₁ v) ^ M = (res₁ v) ^ (M - j) := by
      intro j M hjM
      have hM : M = j + (M - j) := (Nat.add_sub_of_le hjM).symm
      conv_lhs => rw [hM]
      rw [pow_add, ← mul_assoc, ← mul_pow, huv, one_pow, one_mul]
    let : Algebra R B₀ := r₀.toAlgebra
    let : Algebra R B₁ := r₁.toAlgebra
    let : Algebra R B₀₁ := r₀₁.toAlgebra
    let res₀_lin : B₀ →ₗ[R] B₀₁ :=
      { toFun := res₀
        map_add' := res₀.map_add
        map_smul' := fun c a => by
          change res₀ (r₀ c * a) = r₀₁ c * res₀ a
          rw [map_mul, hr₀_apply] }
    let res₁_lin : B₁ →ₗ[R] B₀₁ :=
      { toFun := res₁
        map_add' := res₁.map_add
        map_smul' := fun c a => by
          change res₁ (r₁ c * a) = r₀₁ c * res₁ a
          rw [map_mul, hr₁_apply] }
    let δ : (B₀ × B₁) →ₗ[R] B₀₁ :=
      res₀_lin.comp (LinearMap.fst R B₀ B₁) - res₁_lin.comp (LinearMap.snd R B₀ B₁)
    let H1 := B₀₁ ⧸ LinearMap.range δ
    let qH : B₀₁ →ₗ[R] H1 := Submodule.mkQ (LinearMap.range δ)
    have hqH_res₀ : ∀ a₀ : B₀, qH (res₀ a₀) = 0 := by
      intro a₀
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨(a₀, 0), by simp [δ, res₀_lin, res₁_lin]⟩
    have hqH_res₁ : ∀ a₁ : B₁, qH (res₁ a₁) = 0 := by
      intro a₁
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨(0, -a₁), by simp [δ, res₀_lin, res₁_lin]⟩
    classical
    let G : Finset H1 :=
      E.biUnion (fun e => (Finset.Ico 1 D).image (fun k => qH ((res₁ v) ^ k * res₀ e)))
    have hTermMem : ∀ {e : B₀} (he : e ∈ E) (c : R) (j M : ℕ),
        qH (r₀₁ c * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e) ∈ Submodule.span R (G : Set H1) := by
      intro e he c j M
      by_cases hMj : M ≤ j
      · have hEq : r₀₁ c * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e =
            res₀ (r₀ c * u ^ (j - M) * e) := by
          calc r₀₁ c * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e
              = r₀₁ c * ((res₀ u) ^ j * (res₁ v) ^ M) * res₀ e := by ring
            _ = r₀₁ c * (res₀ u) ^ (j - M) * res₀ e := by rw [huv_ge hMj]
            _ = res₀ (r₀ c * u ^ (j - M) * e) := by rw [map_mul, map_mul, map_pow, hr₀_apply]
        rw [hEq, hqH_res₀]
        exact Submodule.zero_mem _
      · have hjM : j ≤ M := by omega
        by_cases hDM : D ≤ M - j
        · have hde_lt : d_pole e < D := by
            have : d_pole e ≤ E.sup d_pole := Finset.le_sup he
            omega
          have hde_le : d_pole e ≤ M - j := Nat.le_of_lt (lt_of_lt_of_le hde_lt hDM)
          have hsplit : M - j = (M - j - d_pole e) + d_pole e := (Nat.sub_add_cancel hde_le).symm
          have hEq : r₀₁ c * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e =
              res₁ (r₁ c * v ^ (M - j - d_pole e) * g_pole e) := by
            calc r₀₁ c * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e
                = r₀₁ c * ((res₀ u) ^ j * (res₁ v) ^ M) * res₀ e := by ring
              _ = r₀₁ c * (res₁ v) ^ (M - j) * res₀ e := by rw [huv_le hjM]
              _ = r₀₁ c * ((res₁ v) ^ (M - j - d_pole e) * (res₁ v) ^ (d_pole e)) * res₀ e := by
                  rw [← pow_add, ← hsplit]
              _ = r₀₁ c * (res₁ v) ^ (M - j - d_pole e) * (res₀ e * (res₁ v) ^ (d_pole e)) := by ring
              _ = r₀₁ c * (res₁ v) ^ (M - j - d_pole e) * res₁ (g_pole e) := by rw [hg_pole e]
              _ = res₁ (r₁ c * v ^ (M - j - d_pole e) * g_pole e) := by
                  rw [map_mul, map_mul, map_pow, hr₁_apply]
          rw [hEq, hqH_res₁]
          exact Submodule.zero_mem _
        · have hk_mem : M - j ∈ Finset.Ico 1 D := by rw [Finset.mem_Ico]; omega
          have hEq : r₀₁ c * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e =
              c • ((res₁ v) ^ (M - j) * res₀ e) := by
            calc r₀₁ c * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e
                = r₀₁ c * ((res₀ u) ^ j * (res₁ v) ^ M) * res₀ e := by ring
              _ = r₀₁ c * (res₁ v) ^ (M - j) * res₀ e := by rw [huv_le hjM]
              _ = r₀₁ c * ((res₁ v) ^ (M - j) * res₀ e) := by ring
              _ = c • ((res₁ v) ^ (M - j) * res₀ e) := rfl
          rw [hEq, map_smul]
          refine Submodule.smul_mem _ c (Submodule.subset_span ?_)
          change _ ∈ G
          exact Finset.mem_biUnion.mpr ⟨e, he, Finset.mem_image.mpr ⟨M - j, hk_mem, rfl⟩⟩
    have hFinH1 : Module.Finite R H1 := by
      refine ⟨⟨G, top_unique fun w _ => ?_⟩⟩
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ w
      change qH z ∈ Submodule.span R (G : Set H1)
      obtain ⟨M, b₀, hzM⟩ := hLoc₀ z
      have hzEq : z = res₀ b₀ * (res₁ v) ^ M := by
        calc z = z * 1 := (mul_one z).symm
          _ = z * (res₀ u * res₁ v) ^ M := by rw [huv, one_pow]
          _ = (z * (res₀ u) ^ M) * (res₁ v) ^ M := by rw [mul_pow, ← mul_assoc]
          _ = res₀ b₀ * (res₁ v) ^ M := by rw [hzM]
      rw [hzEq]
      obtain ⟨p, hp⟩ := hE b₀
      rw [← hp, map_sum res₀, Finset.sum_mul, map_sum qH]
      refine Submodule.sum_mem _ fun e he => ?_
      rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def, Finset.sum_mul, map_sum res₀,
        Finset.sum_mul, map_sum qH]
      refine Submodule.sum_mem _ fun j _ => ?_
      have hCoeff : res₀ (r₀ ((p e).coeff j) * u ^ j * e) * (res₁ v) ^ M =
          r₀₁ ((p e).coeff j) * (res₀ u) ^ j * (res₁ v) ^ M * res₀ e := by
        rw [map_mul, map_mul, map_pow, hr₀_apply]; ring
      rw [hCoeff]
      exact hTermMem he ((p e).coeff j) j M
    have : IsNoetherian R H1 := isNoetherian_of_isNoetherianRing_of_finite R H1
    let M_chain : ℕ →o Submodule R H1 :=
      { toFun := fun k => LinearMap.ker (LinearMap.lsmul R H1 (ϖ ^ k))
        monotone' := fun k m hkm w hw => by
          rw [LinearMap.mem_ker, LinearMap.lsmul_apply] at hw ⊢
          have hm : m = (m - k) + k := (Nat.sub_add_cancel hkm).symm
          rw [hm, pow_add, mul_smul, hw, smul_zero] }
    obtain ⟨K₀, hK₀⟩ := monotone_stabilizes_iff_noetherian.mpr ‹IsNoetherian R H1› M_chain
    have hStab : M_chain (K₀ + 1) = M_chain K₀ := (hK₀ (K₀ + 1) (Nat.le_succ K₀)).symm
    obtain ⟨c₀_init, hc₀_init⟩ := Ideal.mem_span_singleton.mp hx₀
    obtain ⟨c₁_init, hc₁_init⟩ := Ideal.mem_span_singleton.mp hx₁
    obtain ⟨d_init, hd_init⟩ := Ideal.mem_span_singleton.mp hx₀₁
    have hNewton : ∀ k : ℕ, ∃ (x₀k : B₀) (x₁k : B₁) (c₀k s₀k : B₀) (c₁k s₁k : B₁) (dk : B₀₁),
        x₀k ^ 2 - x₀k = r₀ (ϖ ^ (2 ^ k)) * c₀k ∧
        x₁k ^ 2 - x₁k = r₁ (ϖ ^ (2 ^ k)) * c₁k ∧
        x₀k - x₀ = r₀ ϖ * s₀k ∧
        x₁k - x₁ = r₁ ϖ * s₁k ∧
        res₀ x₀k - res₁ x₁k = r₀₁ (ϖ ^ (2 ^ k)) * dk := by
      intro k
      induction k with
      | zero =>
        refine ⟨x₀, x₁, c₀_init, 0, c₁_init, 0, d_init, ?_, ?_, ?_, ?_, ?_⟩
        · simpa using hc₀_init
        · simpa using hc₁_init
        · simp
        · simp
        · simpa using hd_init
      | succ k ih =>
        obtain ⟨x₀k, x₁k, c₀k, s₀k, c₁k, s₁k, dk, hc₀k, hc₁k, hs₀k, hs₁k, hdk⟩ := ih
        let x₀' : B₀ := 3 * x₀k ^ 2 - 2 * x₀k ^ 3
        let x₁' : B₁ := 3 * x₁k ^ 2 - 2 * x₁k ^ 3
        have hpow2 : ϖ ^ (2 ^ (k + 1)) = ϖ ^ (2 ^ k) * ϖ ^ (2 ^ k) := by
          rw [pow_succ, mul_two, pow_add]
        have hpow1 : ϖ ^ (2 ^ k) = ϖ * ϖ ^ (2 ^ k - 1) := by
          have h1 : 1 ≤ 2 ^ k := Nat.one_le_two_pow
          conv_lhs => rw [(Nat.add_sub_of_le h1).symm, pow_add, pow_one]
        refine ⟨x₀', x₁',
          c₀k ^ 2 * (4 * x₀k ^ 2 - 4 * x₀k - 3),
          r₀ (ϖ ^ (2 ^ k - 1)) * c₀k * (1 - 2 * x₀k) + s₀k,
          c₁k ^ 2 * (4 * x₁k ^ 2 - 4 * x₁k - 3),
          r₁ (ϖ ^ (2 ^ k - 1)) * c₁k * (1 - 2 * x₁k) + s₁k,
          -6 * dk * res₀ c₀k + dk ^ 2 * (6 * res₀ x₀k - 3 - 2 * (res₀ x₀k - res₁ x₁k)),
          ?_, ?_, ?_, ?_, ?_⟩
        · calc x₀' ^ 2 - x₀'
              = (x₀k ^ 2 - x₀k) ^ 2 * (4 * x₀k ^ 2 - 4 * x₀k - 3) := by dsimp [x₀']; ring
            _ = (r₀ (ϖ ^ (2 ^ k)) * c₀k) ^ 2 * (4 * x₀k ^ 2 - 4 * x₀k - 3) := by rw [hc₀k]
            _ = (r₀ (ϖ ^ (2 ^ k)) * r₀ (ϖ ^ (2 ^ k))) *
                  (c₀k ^ 2 * (4 * x₀k ^ 2 - 4 * x₀k - 3)) := by ring
            _ = r₀ (ϖ ^ (2 ^ (k + 1))) * (c₀k ^ 2 * (4 * x₀k ^ 2 - 4 * x₀k - 3)) := by
                rw [← map_mul, ← hpow2]
        · calc x₁' ^ 2 - x₁'
              = (x₁k ^ 2 - x₁k) ^ 2 * (4 * x₁k ^ 2 - 4 * x₁k - 3) := by dsimp [x₁']; ring
            _ = (r₁ (ϖ ^ (2 ^ k)) * c₁k) ^ 2 * (4 * x₁k ^ 2 - 4 * x₁k - 3) := by rw [hc₁k]
            _ = (r₁ (ϖ ^ (2 ^ k)) * r₁ (ϖ ^ (2 ^ k))) *
                  (c₁k ^ 2 * (4 * x₁k ^ 2 - 4 * x₁k - 3)) := by ring
            _ = r₁ (ϖ ^ (2 ^ (k + 1))) * (c₁k ^ 2 * (4 * x₁k ^ 2 - 4 * x₁k - 3)) := by
                rw [← map_mul, ← hpow2]
        · calc x₀' - x₀
              = (x₀' - x₀k) + (x₀k - x₀) := by ring
            _ = (x₀k ^ 2 - x₀k) * (1 - 2 * x₀k) + r₀ ϖ * s₀k := by rw [hs₀k]; dsimp [x₀']; ring
            _ = (r₀ (ϖ ^ (2 ^ k)) * c₀k) * (1 - 2 * x₀k) + r₀ ϖ * s₀k := by rw [hc₀k]
            _ = r₀ ϖ * (r₀ (ϖ ^ (2 ^ k - 1)) * c₀k * (1 - 2 * x₀k) + s₀k) := by
                rw [hpow1, map_mul]; ring
        · calc x₁' - x₁
              = (x₁' - x₁k) + (x₁k - x₁) := by ring
            _ = (x₁k ^ 2 - x₁k) * (1 - 2 * x₁k) + r₁ ϖ * s₁k := by rw [hs₁k]; dsimp [x₁']; ring
            _ = (r₁ (ϖ ^ (2 ^ k)) * c₁k) * (1 - 2 * x₁k) + r₁ ϖ * s₁k := by rw [hc₁k]
            _ = r₁ ϖ * (r₁ (ϖ ^ (2 ^ k - 1)) * c₁k * (1 - 2 * x₁k) + s₁k) := by
                rw [hpow1, map_mul]; ring
        · have ha2 : (res₀ x₀k) ^ 2 - res₀ x₀k = r₀₁ (ϖ ^ (2 ^ k)) * res₀ c₀k := by
            calc (res₀ x₀k) ^ 2 - res₀ x₀k
                = res₀ (x₀k ^ 2 - x₀k) := by rw [map_sub, map_pow]
              _ = res₀ (r₀ (ϖ ^ (2 ^ k)) * c₀k) := by rw [hc₀k]
              _ = r₀₁ (ϖ ^ (2 ^ k)) * res₀ c₀k := by rw [map_mul, hr₀_apply]
          have hId3 : res₀ x₀' - res₁ x₁' =
              -6 * (res₀ x₀k - res₁ x₁k) * ((res₀ x₀k) ^ 2 - res₀ x₀k) +
                (res₀ x₀k - res₁ x₁k) ^ 2 *
                  (6 * res₀ x₀k - 3 - 2 * (res₀ x₀k - res₁ x₁k)) := by
            dsimp [x₀', x₁']
            simp only [map_sub, map_mul, map_pow, map_ofNat]
            ring
          rw [hId3, ha2]
          conv_lhs =>
            congr
            · rw [hdk]
            · congr
              · rw [hdk]
              · rfl
          calc -6 * (r₀₁ (ϖ ^ (2 ^ k)) * dk) * (r₀₁ (ϖ ^ (2 ^ k)) * res₀ c₀k) +
                (r₀₁ (ϖ ^ (2 ^ k)) * dk) ^ 2 *
                  (6 * res₀ x₀k - 3 - 2 * (res₀ x₀k - res₁ x₁k))
              = (r₀₁ (ϖ ^ (2 ^ k)) * r₀₁ (ϖ ^ (2 ^ k))) *
                  (-6 * dk * res₀ c₀k +
                    dk ^ 2 * (6 * res₀ x₀k - 3 - 2 * (res₀ x₀k - res₁ x₁k))) := by ring
            _ = r₀₁ (ϖ ^ (2 ^ (k + 1))) *
                  (-6 * dk * res₀ c₀k +
                    dk ^ 2 * (6 * res₀ x₀k - 3 - 2 * (res₀ x₀k - res₁ x₁k))) := by
                rw [← map_mul, ← hpow2]
    let n : ℕ := K₀ + 1
    obtain ⟨e₀, e₁, _, s₀n, _, s₁n, dn, _, _, hs₀n, hs₁n, hdn⟩ := hNewton n
    have hn_le : n ≤ 2 ^ n := Nat.le_of_lt n.lt_two_pow_self
    let z_e : B₀₁ := r₀₁ (ϖ ^ (2 ^ n - n)) * dn
    have hze : res₀ e₀ - res₁ e₁ = r₀₁ (ϖ ^ n) * z_e := by
      rw [hdn]; dsimp [z_e]
      rw [← mul_assoc, ← map_mul, ← pow_add, Nat.add_sub_of_le hn_le]
    have hze_mem : qH z_e ∈ M_chain (K₀ + 1) := by
      change (ϖ ^ n) • qH z_e = 0
      rw [← map_smul]
      change qH (r₀₁ (ϖ ^ n) * z_e) = 0
      rw [← hze, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨(e₀, e₁), rfl⟩
    rw [hStab] at hze_mem
    have hze_K₀ : qH ((ϖ ^ K₀) • z_e) = 0 := by rw [map_smul]; exact hze_mem
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hze_K₀
    obtain ⟨⟨a₀, a₁⟩, ha₀₁⟩ := hze_K₀
    change res₀ a₀ - res₁ a₁ = r₀₁ (ϖ ^ K₀) * z_e at ha₀₁
    have hCompat : res₀ (e₀ - r₀ ϖ * a₀) = res₁ (e₁ - r₁ ϖ * a₁) := by
      have hmul : res₀ (r₀ ϖ * a₀) - res₁ (r₁ ϖ * a₁) = res₀ e₀ - res₁ e₁ := by
        calc res₀ (r₀ ϖ * a₀) - res₁ (r₁ ϖ * a₁)
            = r₀₁ ϖ * (res₀ a₀ - res₁ a₁) := by
              rw [map_mul, map_mul, hr₀_apply, hr₁_apply]; ring
          _ = r₀₁ ϖ * (r₀₁ (ϖ ^ K₀) * z_e) := by rw [ha₀₁]
          _ = r₀₁ (ϖ ^ n) * z_e := by dsimp [n]; rw [pow_succ', map_mul, mul_assoc]
          _ = res₀ e₀ - res₁ e₁ := hze.symm
      rw [map_sub, map_sub]
      linear_combination -hmul
    obtain ⟨r, hr0, hr1⟩ := hGlued (e₀ - r₀ ϖ * a₀) (e₁ - r₁ ϖ * a₁) hCompat
    have hx₀_eq : x₀ = r₀ r + r₀ ϖ * (a₀ - s₀n) := by linear_combination -hs₀n - hr0
    have hx₁_eq : x₁ = r₁ r + r₁ ϖ * (a₁ - s₁n) := by linear_combination -hs₁n - hr1
    by_cases hr : r ∈ IsLocalRing.maximalIdeal R
    · left
      rw [hMax, Ideal.mem_span_singleton] at hr
      obtain ⟨t, rfl⟩ := hr
      refine ⟨Ideal.mem_span_singleton.mpr ⟨r₀ t + (a₀ - s₀n), ?_⟩,
        Ideal.mem_span_singleton.mpr ⟨r₁ t + (a₁ - s₁n), ?_⟩⟩
      · rw [hx₀_eq, map_mul]; ring
      · rw [hx₁_eq, map_mul]; ring
    · right
      have hr_unit : IsUnit r := IsLocalRing.notMem_maximalIdeal.mp hr
      obtain ⟨u_r, rfl⟩ := hr_unit
      have hUnitIdem : ∀ {B : Type u} [CommRing B] (φ : R →+* B) (x c w : B),
          x ^ 2 - x = φ ϖ * c → x = φ ↑u_r + φ ϖ * w → 1 - x ∈ Ideal.span {φ ϖ} := by
        intro B _ φ x c w hxc hxw
        refine Ideal.mem_span_singleton.mpr ⟨φ ↑(u_r⁻¹) * (-w * (1 - x) - c), ?_⟩
        have hinv : φ ↑(u_r⁻¹) * φ ↑u_r = 1 := by rw [← map_mul, Units.inv_mul, map_one]
        calc 1 - x
            = (φ ↑(u_r⁻¹) * φ ↑u_r) * (1 - x) + φ ↑(u_r⁻¹) * ((x ^ 2 - x) - φ ϖ * c) := by
              rw [hinv, hxc]; ring
          _ = (φ ↑(u_r⁻¹) * (x - φ ϖ * w)) * (1 - x) + φ ↑(u_r⁻¹) * ((x ^ 2 - x) - φ ϖ * c) := by
              have hu_eq : φ ↑u_r = x - φ ϖ * w := by linear_combination -hxw
              rw [hu_eq]
          _ = φ ϖ * (φ ↑(u_r⁻¹) * (-w * (1 - x) - c)) := by ring
      exact ⟨hUnitIdem r₀ x₀ c₀_init (a₀ - s₀n) hc₀_init hx₀_eq,
        hUnitIdem r₁ x₁ c₁_init (a₁ - s₁n) hc₁_init hx₁_eq⟩

  
  
  
  have h_s4 : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (ϖ : R), IsLocalRing.maximalIdeal R = Ideal.span {ϖ} →
      ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) [AlgebraicGeometry.Surjective p]
      (U₀ U₁ : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U₀ →
      AlgebraicGeometry.IsAffineOpen U₁ →
      AlgebraicGeometry.IsAffineOpen (U₀ ⊓ U₁) →
      U₀ ⊔ U₁ = ⊤ →
      (let r₀ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom
       let r₁ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op).hom
       let r₀₁ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ⊓ U₁ ≤ ⊤)).op).hom
       let res₀ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom
       let res₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom
       ∀ (x₀ : ↑(Y.presheaf.obj (Opposite.op U₀)))
         (x₁ : ↑(Y.presheaf.obj (Opposite.op U₁))),
         x₀ ^ 2 - x₀ ∈ Ideal.span {r₀ ϖ} →
         x₁ ^ 2 - x₁ ∈ Ideal.span {r₁ ϖ} →
         res₀ x₀ - res₁ x₁ ∈ Ideal.span {r₀₁ ϖ} →
         (x₀ ∈ Ideal.span {r₀ ϖ} ∧ x₁ ∈ Ideal.span {r₁ ϖ}) ∨
         (1 - x₀ ∈ Ideal.span {r₀ ϖ} ∧ 1 - x₁ ∈ Ideal.span {r₁ ϖ})) →
      ConnectedSpace
        ↥(CategoryTheory.Limits.pullback p
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) := by
    clear * -
    intro R _ _ ϖ hMax Y p _ U₀ U₁ hAff₀ hAff₁ hAff₀₁ hCov hRig
    let I_ϖ : Ideal R := Ideal.span {ϖ}
    let q_R : R →+* R ⧸ I_ϖ := Ideal.Quotient.mk I_ϖ
    let ι₀ : AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ I_ϖ)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_R)
    let Y₀ := CategoryTheory.Limits.pullback p ι₀
    let fst₀ : Y₀ ⟶ Y := CategoryTheory.Limits.pullback.fst p ι₀
    let snd₀ : Y₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ I_ϖ)) :=
      CategoryTheory.Limits.pullback.snd p ι₀
    have hMaxI : I_ϖ.IsMaximal := by
      change (Ideal.span {ϖ}).IsMaximal
      rw [← hMax]; exact IsLocalRing.maximalIdeal.isMaximal R
    have hPrimeI : I_ϖ.IsPrime := hMaxI.isPrime
    let x_m_ps : PrimeSpectrum R := ⟨I_ϖ, hPrimeI⟩
    let x_m : ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) := x_m_ps
    let : Field (R ⧸ I_ϖ) := @Ideal.Quotient.field R _ I_ϖ hMaxI
    let s_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (R ⧸ I_ϖ))) :=
      (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (R ⧸ I_ϖ))
    obtain ⟨z_pt, _⟩ := snd₀.surjective s_pt
    have hNonemptyY₀ : Nonempty ↥Y₀ := ⟨z_pt⟩
    have : AlgebraicGeometry.IsClosedImmersion ι₀ :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom q_R) Ideal.Quotient.mk_surjective
    have hClEmb₀ : Topology.IsClosedEmbedding fst₀.base := fst₀.isClosedEmbedding
    have hRange_ι₀ : Set.range ι₀.base = ({x_m} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) := by
      ext x
      constructor
      · rintro ⟨q, rfl⟩
        apply Set.mem_singleton_iff.mpr
        let q' : PrimeSpectrum (R ⧸ I_ϖ) := q
        change PrimeSpectrum.comap q_R q' = x_m_ps
        apply PrimeSpectrum.ext
        apply le_antisymm
        · exact (IsLocalRing.le_maximalIdeal_of_isPrime
            (PrimeSpectrum.comap q_R q').asIdeal).trans_eq hMax
        · intro a ha
          change q_R a ∈ q'.asIdeal
          have h0 : q_R a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
          rw [h0]; exact q'.asIdeal.zero_mem
      · intro hx
        rw [Set.mem_singleton_iff] at hx
        subst hx
        refine ⟨s_pt, ?_⟩
        change PrimeSpectrum.comap q_R ⟨⊥, Ideal.isPrime_bot⟩ = x_m_ps
        apply PrimeSpectrum.ext
        ext a
        simpa [PrimeSpectrum.comap, x_m_ps] using Ideal.Quotient.eq_zero_iff_mem
    have hRange_fst₀ : Set.range fst₀.base = p.base ⁻¹' {x_m} := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_fst, hRange_ι₀]
    let rMap (U : Y.Opens) : R →+* ↑(Y.presheaf.obj (Opposite.op U)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op).hom
    have hFromSpec_p : ∀ (U : Y.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U),
        hAff.fromSpec ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (rMap U)) := by
      intro U hAff
      have h1 : CommRingCat.ofHom (rMap U) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op := rfl
      rw [h1, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        ← hAff.fromSpec_toSpecΓ, Category.assoc, Category.assoc,
        ← AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc,
        AlgebraicGeometry.toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
    have hChartInRange : ∀ (U : Y.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
        (q : PrimeSpectrum (↑(Y.presheaf.obj (Opposite.op U)) ⧸ Ideal.span {rMap U ϖ})),
        hAff.fromSpec.base
          (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {rMap U ϖ})) q) ∈
          Set.range fst₀.base := by
      intro U hAff q
      rw [hRange_fst₀, Set.mem_preimage, Set.mem_singleton_iff]
      let P := PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {rMap U ϖ})) q
      have hpP : p.base (hAff.fromSpec.base P) =
          (PrimeSpectrum.comap (rMap U) P : ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) := by
        change (hAff.fromSpec ≫ p).base P = _; rw [hFromSpec_p U hAff]; rfl
      rw [hpP]
      change PrimeSpectrum.comap (rMap U) P = x_m_ps
      apply PrimeSpectrum.ext
      apply le_antisymm
      · exact (IsLocalRing.le_maximalIdeal_of_isPrime
          (PrimeSpectrum.comap (rMap U) P).asIdeal).trans_eq hMax
      · rw [Ideal.span_singleton_le_iff_mem]
        change rMap U ϖ ∈ P.asIdeal
        change Ideal.Quotient.mk (Ideal.span {rMap U ϖ}) (rMap U ϖ) ∈ q.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)]
        exact q.asIdeal.zero_mem
    let r₀ := rMap U₀
    let r₁ := rMap U₁
    let r₀₁ := rMap (U₀ ⊓ U₁)
    let B₀ := ↑(Y.presheaf.obj (Opposite.op U₀))
    let B₁ := ↑(Y.presheaf.obj (Opposite.op U₁))
    let B₀₁ := ↑(Y.presheaf.obj (Opposite.op (U₀ ⊓ U₁)))
    let res₀ : B₀ →+* B₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom
    let res₁ : B₁ →+* B₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom
    let I₀ : Ideal B₀ := Ideal.span {r₀ ϖ}
    let I₁ : Ideal B₁ := Ideal.span {r₁ ϖ}
    let I₀₁ : Ideal B₀₁ := Ideal.span {r₀₁ ϖ}
    let π₀ : B₀ →+* B₀ ⧸ I₀ := Ideal.Quotient.mk I₀
    let π₁ : B₁ →+* B₁ ⧸ I₁ := Ideal.Quotient.mk I₁
    let π₀₁ : B₀₁ →+* B₀₁ ⧸ I₀₁ := Ideal.Quotient.mk I₀₁
    let γ₀ : PrimeSpectrum (B₀ ⧸ I₀) → ↥Y₀ := fun q => Classical.choose (hChartInRange U₀ hAff₀ q)
    let γ₁ : PrimeSpectrum (B₁ ⧸ I₁) → ↥Y₀ := fun q => Classical.choose (hChartInRange U₁ hAff₁ q)
    let γ₀₁ : PrimeSpectrum (B₀₁ ⧸ I₀₁) → ↥Y₀ :=
      fun q => Classical.choose (hChartInRange (U₀ ⊓ U₁) hAff₀₁ q)
    have hγ₀_spec : ∀ q, fst₀.base (γ₀ q) = hAff₀.fromSpec.base (PrimeSpectrum.comap π₀ q) :=
      fun q => Classical.choose_spec (hChartInRange U₀ hAff₀ q)
    have hγ₁_spec : ∀ q, fst₀.base (γ₁ q) = hAff₁.fromSpec.base (PrimeSpectrum.comap π₁ q) :=
      fun q => Classical.choose_spec (hChartInRange U₁ hAff₁ q)
    have hγ₀₁_spec : ∀ q, fst₀.base (γ₀₁ q) = hAff₀₁.fromSpec.base (PrimeSpectrum.comap π₀₁ q) :=
      fun q => Classical.choose_spec (hChartInRange (U₀ ⊓ U₁) hAff₀₁ q)
    have hCont₀ : Continuous γ₀ := by
      rw [hClEmb₀.toIsInducing.continuous_iff]
      have hEq : fst₀.base ∘ γ₀ = hAff₀.fromSpec.base ∘ PrimeSpectrum.comap π₀ := funext hγ₀_spec
      rw [hEq]
      exact hAff₀.fromSpec.continuous.comp (PrimeSpectrum.continuous_comap π₀)
    have hCont₁ : Continuous γ₁ := by
      rw [hClEmb₀.toIsInducing.continuous_iff]
      have hEq : fst₀.base ∘ γ₁ = hAff₁.fromSpec.base ∘ PrimeSpectrum.comap π₁ := funext hγ₁_spec
      rw [hEq]
      exact hAff₁.fromSpec.continuous.comp (PrimeSpectrum.continuous_comap π₁)
    have hres₀_r : res₀ (r₀ ϖ) = r₀₁ ϖ := by
      dsimp [res₀, r₀, r₀₁, rMap]
      have hcomp : (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op) =
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ⊓ U₁ ≤ ⊤)).op := by
        rw [← Y.presheaf.map_comp]; rfl
      exact ConcreteCategory.congr_hom
        (congrArg (fun m => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ p.appTop ≫ m) hcomp) ϖ
    have hres₁_r : res₁ (r₁ ϖ) = r₀₁ ϖ := by
      dsimp [res₁, r₁, r₀₁, rMap]
      have hcomp : (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op) =
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ⊓ U₁ ≤ ⊤)).op := by
        rw [← Y.presheaf.map_comp]; rfl
      exact ConcreteCategory.congr_hom
        (congrArg (fun m => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ p.appTop ≫ m) hcomp) ϖ
    let resBar₀ : B₀ ⧸ I₀ →+* B₀₁ ⧸ I₀₁ :=
      Ideal.Quotient.lift I₀ (π₀₁.comp res₀) (by
        intro a ha
        rw [Ideal.mem_span_singleton] at ha
        obtain ⟨c, rfl⟩ := ha
        simp only [RingHom.comp_apply, map_mul, hres₀_r]
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), zero_mul])
    let resBar₁ : B₁ ⧸ I₁ →+* B₀₁ ⧸ I₀₁ :=
      Ideal.Quotient.lift I₁ (π₀₁.comp res₁) (by
        intro a ha
        rw [Ideal.mem_span_singleton] at ha
        obtain ⟨c, rfl⟩ := ha
        simp only [RingHom.comp_apply, map_mul, hres₁_r]
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), zero_mul])
    have hγ₀_comp : ∀ q, γ₀ (PrimeSpectrum.comap resBar₀ q) = γ₀₁ q := by
      intro q
      apply hClEmb₀.injective
      rw [hγ₀_spec, hγ₀₁_spec, ← hAff₀.map_fromSpec hAff₀₁ (CategoryTheory.homOfLE inf_le_left).op]
      change hAff₀.fromSpec.base (PrimeSpectrum.comap π₀ (PrimeSpectrum.comap resBar₀ q)) =
        hAff₀.fromSpec.base (PrimeSpectrum.comap res₀ (PrimeSpectrum.comap π₀₁ q))
      rfl
    have hγ₁_comp : ∀ q, γ₁ (PrimeSpectrum.comap resBar₁ q) = γ₀₁ q := by
      intro q
      apply hClEmb₀.injective
      rw [hγ₁_spec, hγ₀₁_spec, ← hAff₁.map_fromSpec hAff₀₁ (CategoryTheory.homOfLE inf_le_right).op]
      change hAff₁.fromSpec.base (PrimeSpectrum.comap π₁ (PrimeSpectrum.comap resBar₁ q)) =
        hAff₁.fromSpec.base (PrimeSpectrum.comap res₁ (PrimeSpectrum.comap π₀₁ q))
      rfl
    have hChartSurjOn : ∀ (U : Y.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U) (z : ↥Y₀),
        fst₀.base z ∈ U →
        ∃ q : PrimeSpectrum (↑(Y.presheaf.obj (Opposite.op U)) ⧸ Ideal.span {rMap U ϖ}),
          hAff.fromSpec.base (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {rMap U ϖ})) q) =
            fst₀.base z := by
      intro U hAff z hzU
      have hzRange : fst₀.base z ∈ Set.range hAff.fromSpec.base := by
        have := hAff.opensRange_fromSpec
        exact Set.ext_iff.mp (congrArg SetLike.coe this) (fst₀.base z) |>.mpr hzU
      obtain ⟨P_raw, hP⟩ := hzRange
      let P : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)) := P_raw
      have hpz : p.base (fst₀.base z) = x_m := by
        have : fst₀.base z ∈ Set.range fst₀.base := ⟨z, rfl⟩
        rwa [hRange_fst₀, Set.mem_preimage, Set.mem_singleton_iff] at this
      have hIU_le : Ideal.span {rMap U ϖ} ≤ P.asIdeal := by
        rw [Ideal.span_singleton_le_iff_mem]
        have hcomap : (PrimeSpectrum.comap (rMap U) P :
            ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) = x_m := by
          have hstep : (PrimeSpectrum.comap (rMap U) P :
              ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) = p.base (hAff.fromSpec.base P_raw) := by
            change _ = (hAff.fromSpec ≫ p).base P_raw; rw [hFromSpec_p U hAff]; rfl
          rw [hstep, hP, hpz]
        have hmem : ϖ ∈ (PrimeSpectrum.comap (rMap U) P).asIdeal := by
          have hEqPs : PrimeSpectrum.comap (rMap U) P = x_m_ps := hcomap
          rw [hEqPs]; exact Ideal.mem_span_singleton_self ϖ
        exact hmem
      let π_U := Ideal.Quotient.mk (Ideal.span {rMap U ϖ})
      have hComapMap : (Ideal.map π_U P.asIdeal).comap π_U = P.asIdeal := by
        rw [Ideal.comap_map_of_surjective π_U Ideal.Quotient.mk_surjective]
        change P.asIdeal ⊔ RingHom.ker π_U = P.asIdeal
        rw [Ideal.mk_ker]
        exact sup_eq_left.mpr hIU_le
      have hPrimeQ : (Ideal.map π_U P.asIdeal).IsPrime := by
        refine ⟨?_, ?_⟩
        · intro hTop
          apply P.isPrime.ne_top
          rw [← hComapMap, hTop]
          exact Ideal.comap_top
        · intro a b hab
          obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective a
          obtain ⟨b₀, rfl⟩ := Ideal.Quotient.mk_surjective b
          rw [← map_mul] at hab
          have habP : a₀ * b₀ ∈ P.asIdeal := by rw [← hComapMap]; exact hab
          rcases P.isPrime.mem_or_mem habP with ha₀ | hb₀
          · exact Or.inl (Ideal.mem_map_of_mem π_U ha₀)
          · exact Or.inr (Ideal.mem_map_of_mem π_U hb₀)
      refine ⟨⟨Ideal.map π_U P.asIdeal, hPrimeQ⟩, ?_⟩
      have hEqP : PrimeSpectrum.comap π_U ⟨Ideal.map π_U P.asIdeal, hPrimeQ⟩ = P :=
        PrimeSpectrum.ext hComapMap
      rw [hEqP]; exact hP
    have hY₀_cov : ∀ z : ↥Y₀, (∃ q, γ₀ q = z) ∨ (∃ q, γ₁ q = z) := by
      intro z
      have hzTop : fst₀.base z ∈ (U₀ ⊔ U₁ : Y.Opens) := by rw [hCov]; trivial
      rcases hzTop with hz₀ | hz₁
      · obtain ⟨q, hq⟩ := hChartSurjOn U₀ hAff₀ z hz₀
        refine Or.inl ⟨q, hClEmb₀.injective ?_⟩; rw [hγ₀_spec, hq]
      · obtain ⟨q, hq⟩ := hChartSurjOn U₁ hAff₁ z hz₁
        refine Or.inr ⟨q, hClEmb₀.injective ?_⟩; rw [hγ₁_spec, hq]
    rw [connectedSpace_iff_clopen]
    refine ⟨hNonemptyY₀, fun F hF => ?_⟩
    obtain ⟨e₀, he₀_idem, hF₀⟩ := (PrimeSpectrum.isClopen_iff).mp (hF.preimage hCont₀)
    obtain ⟨e₁, he₁_idem, hF₁⟩ := (PrimeSpectrum.isClopen_iff).mp (hF.preimage hCont₁)
    have hBasicEq : (PrimeSpectrum.basicOpen (resBar₀ e₀) : Set (PrimeSpectrum (B₀₁ ⧸ I₀₁))) =
        (PrimeSpectrum.basicOpen (resBar₁ e₁) : Set (PrimeSpectrum (B₀₁ ⧸ I₀₁))) := by
      ext q
      simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      change PrimeSpectrum.comap resBar₀ q ∈ (PrimeSpectrum.basicOpen e₀ : Set _) ↔
        PrimeSpectrum.comap resBar₁ q ∈ (PrimeSpectrum.basicOpen e₁ : Set _)
      rw [← hF₀, ← hF₁]
      simp only [Set.mem_preimage, hγ₀_comp, hγ₁_comp]
    have hIdemZeroOfBasicSub : ∀ (a b : B₀₁ ⧸ I₀₁),
        IsIdempotentElem a → IsIdempotentElem b →
        (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum (B₀₁ ⧸ I₀₁))) ⊆
          (PrimeSpectrum.basicOpen b : Set (PrimeSpectrum (B₀₁ ⧸ I₀₁))) →
        a * (1 - b) = 0 := by
      intro a b ha hb hSub
      let w := a * (1 - b)
      have hw_idem : w * w = w := by
        have ha' : a * a = a := ha
        have hb' : b * b = b := hb
        calc w * w = (a * a) * (1 - 2 * b + b * b) := by dsimp [w]; ring
          _ = a * (1 - 2 * b + b) := by rw [ha', hb']
          _ = w := by dsimp [w]; ring
      have hw_nil : w ∈ nilradical (B₀₁ ⧸ I₀₁) := by
        rw [PrimeSpectrum.nilradical_eq_iInf, Ideal.mem_iInf]
        intro q
        by_contra hw_not
        have ha_not : a ∉ q.asIdeal := fun ha_in => hw_not (q.asIdeal.mul_mem_right (1 - b) ha_in)
        have h1b_not : 1 - b ∉ q.asIdeal := fun h1b_in => hw_not (q.asIdeal.mul_mem_left a h1b_in)
