          rw [← hMap_JP, ← Ideal.map_pow] at hx_mS2
          obtain ⟨y, hy2, hy_eq⟩ := hSurj_map_ideal (J_P ^ 2) _ hx_mS2
          obtain ⟨hy_JP, hy_zero⟩ := hJP2_zero y hy2
          have hxy_I : x.1 - y ∈ I := by
            rw [RingHom.mem_ker, map_sub, hy_eq, sub_self]
          have hx_decomp : x = ⟨x.1 - y, hI_le_JP hxy_I⟩ + ⟨y, hy_JP⟩ := by
            ext
            simp
          rw [hx_decomp, TensorProduct.tmul_add, hy_zero hy_JP, add_zero]
          exact ⟨(1 : IsLocalRing.ResidueField S) ⊗ₜ[P] ⟨x.1 - y, hxy_I⟩, rfl⟩
        · rintro _ ⟨t, rfl⟩
          rw [LinearMap.mem_ker]
          induction t using TensorProduct.induction_on with
          | zero => simp
          | tmul a g =>
            simp only [ψ_I, LinearMap.baseChange_tmul, ι_IJ, Submodule.inclusion_apply, hΦ_tmul]
            have hg0 : (⟨algebraMap P S g.1, hx_mem_mS ⟨g.1, hI_le_JP g.2⟩⟩ : ↥m_S) = 0 := by
              ext
              exact RingHom.mem_ker.mp g.2
            rw [show q_PS ⟨g.1, hI_le_JP g.2⟩ = m_S.toCotangent 0 from congrArg m_S.toCotangent hg0,
              map_zero, smul_zero]
          | add t₁ t₂ h₁ h₂ =>
            rw [map_add, map_add, h₁, h₂, add_zero]
      have hRN_ΦPS : Module.finrank (IsLocalRing.ResidueField S) ↥Φ_PS.range +
          Module.finrank (IsLocalRing.ResidueField S) ↥Φ_PS.ker =
          Module.finrank (IsLocalRing.ResidueField S)
            (TensorProduct P (IsLocalRing.ResidueField S) ↥J_P) :=
        LinearMap.finrank_range_add_finrank_ker Φ_PS
      rw [LinearMap.range_eq_top.mpr hSurj_ΦPS, finrank_top, hCotS, hKer_ΦPS, hFinrank_VP] at hRN_ΦPS
      let c : ℕ := Module.finrank (IsLocalRing.ResidueField S) ↥ψ_I.range
      have hPure_TI : ∀ t : TensorProduct P (IsLocalRing.ResidueField S) ↥I,
          ∃ g₀ : ↥I,
            ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] g₀ :
              TensorProduct P (IsLocalRing.ResidueField S) ↥I) = t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => exact ⟨0, by simp⟩
        | tmul a g₀ =>
          obtain ⟨p₀, rfl⟩ := hSurj_Pκ a
          exact ⟨p₀ • g₀, by rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]⟩
        | add t₁ t₂ ih₁ ih₂ =>
          obtain ⟨g₁, h₁⟩ := ih₁
          obtain ⟨g₂, h₂⟩ := ih₂
          exact ⟨g₁ + g₂, by rw [TensorProduct.tmul_add, h₁, h₂]⟩
      have _ : Module.Free (IsLocalRing.ResidueField S) ↥ψ_I.range :=
        Module.Free.of_divisionRing (IsLocalRing.ResidueField S) ↥ψ_I.range
      let bKer : Module.Basis (Fin c) (IsLocalRing.ResidueField S) ↥ψ_I.range :=
        Module.finBasis (IsLocalRing.ResidueField S) ↥ψ_I.range
      have hg_ex : ∀ i : Fin c, ∃ g₀ : ↥I,
          ψ_I ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] g₀) = (bKer i).1 := by
        intro i
        obtain ⟨t, ht⟩ := (bKer i).2
        obtain ⟨g₀, rfl⟩ := hPure_TI t
        exact ⟨g₀, ht⟩
      let g : Fin c → ↥I := fun i => Classical.choose (hg_ex i)
      have hg_spec : ∀ i : Fin c, ψ_I ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] g i) = (bKer i).1 :=
        fun i => Classical.choose_spec (hg_ex i)
      let bCotS := Module.finBasis (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S)
      let i₀S : Fin (Module.finrank (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S)) :=
        ⟨0, by omega⟩
      let v_S : IsLocalRing.CotangentSpace S := bCotS i₀S
      have hvS_ne : v_S ≠ 0 := bCotS.ne_zero i₀S
      have hvS_span : ∀ v : IsLocalRing.CotangentSpace S,
          ∃ a : IsLocalRing.ResidueField S, v = a • v_S := by
        intro v
        refine ⟨bCotS.repr v i₀S, ?_⟩
        conv_lhs => rw [← bCotS.sum_repr v]
        have hUniv : (Finset.univ : Finset (Fin (Module.finrank (IsLocalRing.ResidueField S)
            (IsLocalRing.CotangentSpace S)))) = {i₀S} := by
          ext j
          simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
          ext
          change j.1 = 0
          omega
        rw [hUniv, Finset.sum_singleton]
      obtain ⟨w_u, hw_u⟩ := hSurj_ΦPS v_S
      obtain ⟨u₀, rfl⟩ := hPure_VP w_u
