        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · calc (inv₂ ≫ fwd₂) ≫ fst_L
              _ = inv₂ ≫ (fwd₂ ≫ fst_L) := Category.assoc _ _ _
              _ = inv₂ ≫ (CategoryTheory.Limits.pullback.snd _ _ ≫ (isoD₀ ℓ).inv ≫ fst₀ ℓ) :=
