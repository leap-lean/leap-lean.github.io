          algebraMap P (IsLocalRing.ResidueField S) (lift_κ a) = a :=
        fun a => Classical.choose_spec (hSurj_Pκ a)
      have h_wd : ∀ (p₁ p₂ : P) (x : ↥J_P),
          algebraMap P (IsLocalRing.ResidueField S) p₁ =
            algebraMap P (IsLocalRing.ResidueField S) p₂ →
          Ideal.Quotient.mk K_sq (p₁ * x.1) = Ideal.Quotient.mk K_sq (p₂ * x.1) := by
        intro p₁ p₂ x hp_eq
        rw [Ideal.Quotient.eq, ← sub_mul]
        have hp_mem : p₁ - p₂ ∈ m_P := by
          rw [← hJP_eq, RingHom.mem_ker, map_sub, hp_eq, sub_self]
        have hx_mem : x.1 ∈ m_P := hJP_eq ▸ x.2
        exact Ideal.mem_sup_right (pow_two m_P ▸ Ideal.mul_mem_mul hp_mem hx_mem)
      have h_indep : ∀ (p₁ : P) (x : ↥J_P),
