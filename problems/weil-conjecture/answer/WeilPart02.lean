      · rintro ⟨hx_μ, hx_α⟩
        have hx_pre : (⟨x, hx_μ⟩ : ↥(U_proj μ)) ∈ (U_proj μ).ι ⁻¹ᵁ U_proj α := hx_α
        rw [h_pre] at hx_pre
        exact hx_pre
    have ht_poly : ∀ (μ : Fin (M₀ + 1)) (z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ)),
