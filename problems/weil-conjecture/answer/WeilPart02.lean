            have hjb : j.1 = b := not_ne_iff.mp j.2
            rw [hjb, hub_one, one_pow]
          rw [hCompl, mul_one] at hSplit
          exact hSplit
        rw [hProdEq, map_mul, map_prod]
        have hι_val : valHom (ιk (p.coeff d)) =
            Localization.mk (MvPolynomial.C (p.coeff d)) 1 := rfl
        have hu_val : ∀ i : Fin (m + 1), valHom ((u i) ^ (d i)) =
            Localization.mk ((MvPolynomial.X i) ^ (d i)) (m_b1 ^ (d i)) := by
          intro i
          rw [map_pow]
          change (HomogeneousLocalization.val (u i)) ^ (d i) = _
          rw [HomogeneousLocalization.Away.val_mk, ← hMkPow]
        simp_rw [hu_val]
        rw [hι_val]
        have hP := hMkProd (Finset.univ : Finset (Fin (m + 1)))
          (fun i => (MvPolynomial.X i) ^ (d i))
          (fun i => m_b1 ^ (d i))
        rw [hP, Localization.mk_mul, one_mul, MvPolynomial.monomial_eq,
          Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
        have hDeg : ∑ i : Fin (m + 1), d i = n := by
          have h1 := hp_hom (Finsupp.mem_support_iff.mp hd)
          change (∑ i ∈ d.support, d i • (1 : Fin (m + 1) → ℕ) i) = n at h1
          simp only [Pi.one_apply, smul_eq_mul, mul_one] at h1
          rw [← h1]
          symm
          exact Finset.sum_subset (Finset.subset_univ _) (fun j _ hj => Finsupp.notMem_support_iff.mp hj)
        have hDen : (∏ i : Fin (m + 1), m_b1 ^ (d i)) = m_bn := by
          apply Subtype.ext
          rw [SubmonoidClass.coe_finsetProd]
          simp only [m_b1, m_bn, SubmonoidClass.coe_pow, pow_one]
          rw [Finset.prod_pow_eq_pow_sum, hDeg]
        rw [hDen]
      rw [Finset.sum_congr rfl hTerm, hMkSum, ← MvPolynomial.as_sum p]
    let algA : Algebra k A := (φ₀.comp ιk).toAlgebra
    let algK : Algebra k K := (σ₀.comp ιk).toAlgebra
    let : Algebra k A := algA
    let : Algebra k K := algK
    let B : Type u := TensorProduct k K A
    let S : Finset B := Finset.univ.image
      (fun j : {j : Fin (m + 1) // j ≠ b} => (1 : K) ⊗ₜ[k] φ₀ (u j.1) - σ₀ (u j.1) ⊗ₜ[k] (1 : A))
    have hScard : S.card ≤ m := by
      calc S.card
          ≤ (Finset.univ : Finset {j : Fin (m + 1) // j ≠ b}).card := Finset.card_image_le
        _ = Fintype.card {j : Fin (m + 1) // j ≠ b} := Finset.card_univ
        _ = m := by
            rw [Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_unique]
            omega
    let IS : Ideal B := Ideal.span (S : Set B)
    let Q : Type u := B ⧸ IS
    let mkQ : B →+* Q := Ideal.Quotient.mk IS
    let inlQ : A →+* Q := mkQ.comp (Algebra.TensorProduct.includeRight (R := k) (A := K) (B := A)).toRingHom
    let inrQ : K →+* Q := mkQ.comp (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := K) (B := A))
    have hCondQ : inlQ.comp φ₀ = inrQ.comp σ₀ := by
      have hOnK : ∀ c : k, (inlQ.comp φ₀) (ιk c) = (inrQ.comp σ₀) (ιk c) := by
        intro c
        change mkQ ((1 : K) ⊗ₜ[k] (algebraMap k A c)) = mkQ ((algebraMap k K c) ⊗ₜ[k] (1 : A))
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
          TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      have hOnU : ∀ j : {j : Fin (m + 1) // j ≠ b},
          (inlQ.comp φ₀) (u j.1) = (inrQ.comp σ₀) (u j.1) := by
        intro j
        change mkQ ((1 : K) ⊗ₜ[k] φ₀ (u j.1)) = mkQ (σ₀ (u j.1) ⊗ₜ[k] (1 : A))
        rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ j)))
      ext z
      obtain ⟨p, rfl⟩ := hRb_expand z
      simp only [map_sum, map_mul, map_prod, map_pow, hOnK, hOnU]
    have hPush : CategoryTheory.IsPushout φ₀_hom σ₀_hom
        (CommRingCat.ofHom inlQ) (CommRingCat.ofHom inrQ) := by
      have hw : φ₀_hom ≫ CommRingCat.ofHom inlQ = σ₀_hom ≫ CommRingCat.ofHom inrQ :=
        CommRingCat.ofHom_comp φ₀ inlQ ▸ CommRingCat.ofHom_comp σ₀ inrQ ▸ congrArg CommRingCat.ofHom hCondQ
      let descHom : ∀ cocone : CategoryTheory.Limits.PushoutCocone φ₀_hom σ₀_hom,
          CommRingCat.of Q ⟶ cocone.pt := fun cocone =>
        let T := cocone.pt
        let fA : A →+* T := cocone.inl.hom
        let fK : K →+* T := cocone.inr.hom
        have hf_comm : fA.comp φ₀ = fK.comp σ₀ :=
          congrArg CommRingCat.Hom.hom cocone.condition
        let algT : Algebra k T := (fK.comp (σ₀.comp ιk)).toAlgebra
        letI : Algebra k T := algT
        let fK_alg : K →ₐ[k] T := { toRingHom := fK, commutes' := fun _ => rfl }
        let fA_alg : A →ₐ[k] T :=
          { toRingHom := fA
            commutes' := fun c => RingHom.congr_fun hf_comm (ιk c) }
        let liftB : B →+* T := (Algebra.TensorProduct.lift fK_alg fA_alg (fun _ _ => mul_comm _ _)).toRingHom
        have hKerIS : IS ≤ RingHom.ker liftB := by
          rw [Ideal.span_le]
          rintro _ hl
          rw [Finset.mem_coe, Finset.mem_image] at hl
          obtain ⟨j, _, rfl⟩ := hl
          change liftB ((1 : K) ⊗ₜ[k] φ₀ (u j.1) - σ₀ (u j.1) ⊗ₜ[k] (1 : A)) = 0
          rw [map_sub]
          change fK 1 * fA (φ₀ (u j.1)) - fK (σ₀ (u j.1)) * fA 1 = 0
          rw [map_one, map_one, one_mul, mul_one, sub_eq_zero]
          exact RingHom.congr_fun hf_comm (u j.1)
        CommRingCat.ofHom (Ideal.Quotient.lift IS liftB (fun x hx => hKerIS hx))
      refine CategoryTheory.IsPushout.of_isColimit (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw
        descHom (fun cocone => ?_) (fun cocone => ?_) (fun cocone m₀ hm₁ hm₂ => ?_))
      · apply CommRingCat.hom_ext
        ext a
        change cocone.inr.hom 1 * cocone.inl.hom a = cocone.inl.hom a
        rw [map_one, one_mul]
      · apply CommRingCat.hom_ext
        ext c
        change cocone.inr.hom c * cocone.inl.hom 1 = cocone.inr.hom c
        rw [map_one, mul_one]
      · apply CommRingCat.hom_ext
        refine RingHom.ext (fun q => ?_)
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
        refine TensorProduct.inductionOn x (fun c a => ?_)
          (fun x₁ x₂ hx₁ hx₂ => by simp only [map_add, hx₁, hx₂])
        have hSplit : mkQ (c ⊗ₜ[k] a) = inrQ c * inlQ a := by
          change mkQ (c ⊗ₜ[k] a) = mkQ (c ⊗ₜ[k] 1) * mkQ (1 ⊗ₜ[k] a)
          rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        change m₀.hom (mkQ (c ⊗ₜ[k] a)) = cocone.inr.hom c * cocone.inl.hom a
        rw [hSplit, map_mul]
        have hm₁' : ∀ a' : A, m₀.hom (inlQ a') = cocone.inl.hom a' :=
          fun a' => RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₁) a'
        have hm₂' : ∀ c' : K, m₀.hom (inrQ c') = cocone.inr.hom c' :=
          fun c' => RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₂) c'
        rw [hm₁', hm₂']
    let fst_s := CategoryTheory.Limits.pullback.fst f₁.left s
    let snd_s := CategoryTheory.Limits.pullback.snd f₁.left s
    let O_A : (CategoryTheory.Limits.pullback f₁.left s).Opens := fst_s ⁻¹ᵁ UA
    have hq₁_OA : q₁ ∈ O_A := hv₁A
    have hPb_Spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inlQ))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inrQ))
        (AlgebraicGeometry.Spec.map φ₀_hom)
        (AlgebraicGeometry.Spec.map σ₀_hom) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        φ₀_hom σ₀_hom (CommRingCat.ofHom inlQ) (CommRingCat.ofHom inrQ) hPush
    have hPb_OA : CategoryTheory.IsPullback
        ((fst_s ∣_ UA) ≫ hAffA.isoSpec.hom)
        (O_A.ι ≫ snd_s)
        (AlgebraicGeometry.Spec.map φ₀_hom)
        (AlgebraicGeometry.Spec.map σ₀_hom) := by
      have hTop : CategoryTheory.IsPullback (fst_s ∣_ UA) O_A.ι UA.ι fst_s :=
        AlgebraicGeometry.isPullback_morphismRestrict fst_s UA
      have hOuter := hTop.paste_vert (CategoryTheory.IsPullback.of_hasPullback f₁.left s)
      have hOuter_P : (fst_s ∣_ UA) ≫ UA.ι ≫ f₁_P = O_A.ι ≫ snd_s ≫ s_P := by
        change (fst_s ∣_ UA) ≫ UA.ι ≫ f₁.left = O_A.ι ≫ snd_s ≫ s
        simpa only [CategoryTheory.Category.assoc] using hOuter.w
      have hComm : ((fst_s ∣_ UA) ≫ hAffA.isoSpec.hom) ≫ AlgebraicGeometry.Spec.map φ₀_hom =
          (O_A.ι ≫ snd_s) ≫ AlgebraicGeometry.Spec.map σ₀_hom := by
        rw [hSpec_φ₀, hSpec_σ₀]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
        rw [← CategoryTheory.cancel_mono isoUb.inv]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.comp_id]
        rw [← CategoryTheory.cancel_mono Ub.ι]
        simp only [CategoryTheory.Category.assoc]
        have h1 : f₁_P.resLE Ub UA hUA_le ≫ Ub.ι = UA.ι ≫ f₁_P :=
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι f₁_P hUA_le
        rw [h1, hsb]
        exact hOuter_P
      have hGenCone : ∀ {W : AlgebraicGeometry.Scheme.{u}}
          (g₁ : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
          (g₂ : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
          g₁ ≫ AlgebraicGeometry.Spec.map φ₀_hom = g₂ ≫ AlgebraicGeometry.Spec.map σ₀_hom →
          (g₁ ≫ hAffA.isoSpec.inv) ≫ UA.ι ≫ f₁.left = g₂ ≫ s := by
        intro W g₁ g₂ hCond
        have hEq := hCond =≫ (isoUb.inv ≫ Ub.ι)
        rw [hSpec_φ₀, hSpec_σ₀] at hEq
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc] at hEq
        have h1 : f₁_P.resLE Ub UA hUA_le ≫ Ub.ι = UA.ι ≫ f₁_P :=
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι f₁_P hUA_le
        rw [h1, hsb] at hEq
        change g₁ ≫ hAffA.isoSpec.inv ≫ UA.ι ≫ f₁.left = g₂ ≫ s at hEq
        simpa only [CategoryTheory.Category.assoc] using hEq
      refine CategoryTheory.IsPullback.of_isLimit (CategoryTheory.Limits.PullbackCone.IsLimit.mk hComm
        (fun cone => hOuter.lift (cone.fst ≫ hAffA.isoSpec.inv) cone.snd
          (hGenCone cone.fst cone.snd cone.condition))
        (fun cone => ?_) (fun cone => ?_) (fun cone m₀ hm₁ hm₂ => ?_))
      · rw [← CategoryTheory.Category.assoc, hOuter.lift_fst, CategoryTheory.Category.assoc,
          CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.comp_id]
      · exact hOuter.lift_snd _ _ _
      · refine hOuter.hom_ext ?_ (hm₂.trans (hOuter.lift_snd _ _ _).symm)
        rw [hOuter.lift_fst, ← CategoryTheory.cancel_mono hAffA.isoSpec.hom,
          CategoryTheory.Category.assoc cone.fst, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.comp_id]
        exact hm₁
    let isoOA : O_A.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of Q) :=
      hPb_OA.isoIsPullback _ _ hPb_Spec
    exact ⟨UA, hAffA, hNonemptyUA, O_A, algA, algK, S, hq₁_OA, hκ_UA, hScard,
      ⟨AlgebraicGeometry.Scheme.homeoOfIso isoOA⟩⟩

  
  intro K _ _ s E hE
  let F_s := CategoryTheory.Limits.pullback f₁.left s
  let L_s := CategoryTheory.Limits.pullback p₂_left s
  let fst_f := CategoryTheory.Limits.pullback.fst f₁.left s
  let snd_f := CategoryTheory.Limits.pullback.snd f₁.left s
  let fst_p := CategoryTheory.Limits.pullback.fst p₂_left s
  let snd_p := CategoryTheory.Limits.pullback.snd p₂_left s

  have h_qs_cond : (fst_f ≫ q_tilde) ≫ p₂_left = snd_f ≫ s := by
    rw [CategoryTheory.Category.assoc, ← hf₁]
    exact CategoryTheory.Limits.pullback.condition
  let q_s : F_s ⟶ L_s :=
    CategoryTheory.Limits.pullback.lift (fst_f ≫ q_tilde) snd_f h_qs_cond
  have hPb_qs : CategoryTheory.IsPullback fst_f q_s q_tilde fst_p := by
    have hOuter : CategoryTheory.IsPullback fst_f (q_s ≫ snd_p) (q_tilde ≫ p₂_left) s := by
      rw [CategoryTheory.Limits.pullback.lift_snd, ← hf₁]
      exact CategoryTheory.IsPullback.of_hasPullback f₁.left s
    have hComm : fst_f ≫ q_tilde = q_s ≫ fst_p :=
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    exact CategoryTheory.IsPullback.of_bot hOuter hComm
      (CategoryTheory.IsPullback.of_hasPullback p₂_left s)
  have : AlgebraicGeometry.IsFinite q_s :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.IsFinite) hPb_qs ‹_›

  obtain ⟨hIrred_Ls, hDim_Ls, z₀, hz₀_exc⟩ := hFib_p₂ K s
  have hClosedE : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  have hIrredE : IsIrreducible E := hE.1
  obtain ⟨q₁, hq₁E⟩ := hIrredE.nonempty
  obtain ⟨hDim_le_Ls, hSurj_cond⟩ := h_s1 F_s L_s q_s E hClosedE
  have hDim_le : topologicalKrullDim ↥E ≤ (1 : WithBot ℕ∞) := by
    rwa [hDim_Ls] at hDim_le_Ls

  obtain ⟨UA, hAffA, hNonemptyUA, O_A, algA, algK, S, hq₁_OA, hκ_UA, hScard, ⟨e_homeo⟩⟩ :=
    h_s4b K s q₁
  let A : Type u := ↑(V₁.left.presheaf.obj (Opposite.op UA))
  have hAlgEq : algA =
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.hom ≫
        V₁.hom.appLE ⊤ UA (hTopPre UA)).hom.toAlgebra :=
    Algebra.algebra_ext _ _ (fun c => RingHom.congr_fun hκ_UA c)
  subst hAlgEq
  obtain ⟨hFT_A, s_A, g₀, hms, hg₀_inj, hg₀_int⟩ :=
    @h_s4a UA hAffA hNonemptyUA
  have : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral V₁.left hIntV₁ UA hNonemptyUA
  let : Algebra k A :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.hom ≫
      V₁.hom.appLE ⊤ UA (hTopPre UA)).hom.toAlgebra
  let : Algebra k K := algK
  obtain ⟨hDomB, g_K, hgK_inj, hgK_int⟩ := h_s2 K A s_A g₀ hg₀_inj hg₀_int
  let B : Type u := TensorProduct k K A
  have : IsDomain B := hDomB
  have : Algebra.FiniteType K B := Algebra.FiniteType.baseChange K

  let E_O : Set ↥O_A := (Subtype.val : ↥O_A → ↥F_s) ⁻¹' E
  have hIrredEO : IsIrreducible E_O :=
    ⟨⟨⟨q₁, hq₁_OA⟩, hq₁E⟩, hIrredE.isPreirreducible.preimage O_A.isOpen.isOpenEmbedding_subtypeVal⟩
  have hEO_comp : E_O ∈ irreducibleComponents ↥O_A := by
    refine ⟨hIrredEO, fun F' hIrredF' hSubF' => ?_⟩
    let Z : Set ↥F_s := closure ((Subtype.val : ↥O_A → ↥F_s) '' F')
    have hIrredZ : IsIrreducible Z :=
      (hIrredF'.image Subtype.val continuous_subtype_val.continuousOn).closure
    have hEZ : E ⊆ Z := by
      by_contra hNotSub
      obtain ⟨z₁, hz₁E, hz₁Z⟩ := Set.not_subset.mp hNotSub
      obtain ⟨w, hwE, hwZ, hwOA⟩ :=
        hIrredE.isPreirreducible Zᶜ (O_A : Set ↥F_s) isClosed_closure.isOpen_compl O_A.isOpen
          ⟨z₁, hz₁E, hz₁Z⟩ ⟨q₁, hq₁E, hq₁_OA⟩
      have hwF' : (⟨w, hwOA⟩ : ↥O_A) ∈ F' := hSubF' hwE
      exact hwZ (subset_closure ⟨⟨w, hwOA⟩, hwF', rfl⟩)
    have hZE : Z ⊆ E := hE.2 hIrredZ hEZ
    intro u huF'
    exact hZE (subset_closure ⟨u, huF', rfl⟩)
  let E_spec : Set (PrimeSpectrum (B ⧸ Ideal.span (S : Set B))) := e_homeo '' E_O
  have hEspec_comp : E_spec ∈ irreducibleComponents (PrimeSpectrum (B ⧸ Ideal.span (S : Set B))) := by
    refine ⟨hIrredEO.image e_homeo e_homeo.continuous.continuousOn, fun G hIrredG hSubG => ?_⟩
    have hIrredPre : IsIrreducible (e_homeo.symm '' G) :=
      hIrredG.image e_homeo.symm e_homeo.symm.continuous.continuousOn
    have hSubPre : E_O ⊆ e_homeo.symm '' G := by
      intro u hu
      exact ⟨e_homeo u, hSubG ⟨u, hu, rfl⟩, e_homeo.symm_apply_apply u⟩
    have hPreSub : e_homeo.symm '' G ⊆ E_O := hEO_comp.2 hIrredPre hSubPre
    intro y hyG
    exact ⟨e_homeo.symm y, hPreSub ⟨y, hyG, rfl⟩, e_homeo.apply_symm_apply y⟩
  have hDim_Espec : (1 : WithBot ℕ∞) ≤ topologicalKrullDim ↥E_spec :=
    h_s3 K B s_A hms g_K hgK_inj hgK_int S hScard E_spec hEspec_comp

  have hInvMem : ∀ v : ↥E_spec, e_homeo.symm v.1 ∈ E_O := by
    intro v
    obtain ⟨u, hu, huEq⟩ := v.2
    simpa [← huEq] using hu
  let e_sub1 : ↥E_O ≃ₜ ↥E_spec :=
    { toFun := fun u => ⟨e_homeo u.1, ⟨u.1, u.2, rfl⟩⟩
      invFun := fun v => ⟨e_homeo.symm v.1, hInvMem v⟩
      left_inv := fun u => Subtype.ext (e_homeo.symm_apply_apply u.1)
      right_inv := fun v => Subtype.ext (e_homeo.apply_symm_apply v.1)
      continuous_toFun := Continuous.subtype_mk (e_homeo.continuous.comp continuous_subtype_val)
        (fun u => ⟨u.1, u.2, rfl⟩)
      continuous_invFun := Continuous.subtype_mk (e_homeo.symm.continuous.comp continuous_subtype_val)
        hInvMem }
  let E_in_E : Set ↥E := {x : ↥E | x.1 ∈ O_A}
  let e_sub2 : ↥E_O ≃ₜ ↥E_in_E :=
    { toFun := fun u => ⟨⟨u.1.1, u.2⟩, u.1.2⟩
      invFun := fun v => ⟨⟨v.1.1, v.2⟩, v.1.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      continuous_toFun := Continuous.subtype_mk
        (Continuous.subtype_mk (continuous_subtype_val.comp continuous_subtype_val) (fun u => u.2))
        (fun u => u.1.2)
      continuous_invFun := Continuous.subtype_mk
        (Continuous.subtype_mk (continuous_subtype_val.comp continuous_subtype_val) (fun v => v.2))
        (fun v => v.1.2) }
  have hDim_ge : (1 : WithBot ℕ∞) ≤ topologicalKrullDim ↥E := by
    calc (1 : WithBot ℕ∞)
        ≤ topologicalKrullDim ↥E_spec := hDim_Espec
      _ = topologicalKrullDim ↥E_O := e_sub1.isHomeomorph.topologicalKrullDim_eq.symm
      _ = topologicalKrullDim ↥E_in_E := e_sub2.isHomeomorph.topologicalKrullDim_eq
      _ ≤ topologicalKrullDim ↥E := topologicalKrullDim_subspace_le ↥E E_in_E
  have hDim_eq : topologicalKrullDim ↥E = (1 : WithBot ℕ∞) := le_antisymm hDim_le hDim_ge

  have hSurj_E : q_s.base '' E = Set.univ := hSurj_cond hIrred_Ls hDim_Ls hDim_ge
  have hz₀_mem : z₀ ∈ q_s.base '' E := hSurj_E.symm ▸ Set.mem_univ z₀
  obtain ⟨q, hqE, hq_eq⟩ := hz₀_mem
  have hq_exc : fst_f.base q ∈ W_exc := by
    apply hz₀_exc
    change q_tilde.base (fst_f.base q) = fst_p.base z₀
    have hCommQ : q_s ≫ fst_p = fst_f ≫ q_tilde :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hApp := congrArg (fun f : F_s ⟶ P_tilde_left => f.base q) hCommQ
    change fst_p.base (q_s.base q) = q_tilde.base (fst_f.base q) at hApp
    rw [← hApp, hq_eq]
  exact ⟨hDim_eq, q, W_exc, hqE, hq_exc, hSm_exc⟩

theorem weil_algClosed_adapted_pencil_blowup_section (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntVn : AlgebraicGeometry.IsIntegral V_norm.left)
    (hProjVn : IsProjectiveOverField k V_norm)
    (hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (W_reg : V_norm.left.Opens)
    (hSmWreg : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (W_reg.ι ≫ V_norm.hom))
    (hDimSing : topologicalKrullDim ↥((W_reg : Set V_norm.left)ᶜ) + 2 ≤ ((m + 1 : ℕ) : WithBot ℕ∞))
    (Z_closed : Set V_norm.left)
    (hClosedZ : IsClosed Z_closed)
    (hProperZ : Z_closed ≠ Set.univ) :
    ∃ (U₀ : (weilProjectiveSpaceOver k m).left.Opens)
      (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f₁ : V₁ ⟶ weilProjectiveSpaceOver k m)
      (σ₁ : weilProjectiveSpaceOver k m ⟶ V₁)
      (Z₁ : AlgebraicGeometry.Scheme.{u})
      (ιZ₁ : Z₁ ⟶ V₁.left)
      (φ₁ : V₁ ⟶ V_norm)
      (U_φ₁ : V_norm.left.Opens),
      Nonempty U₀ ∧
      AlgebraicGeometry.IsIntegral V₁.left ∧
      IsProjectiveOverField k V₁ ∧
      AlgebraicGeometry.IsProper φ₁.left ∧
      AlgebraicGeometry.Surjective φ₁.left ∧
      Nonempty U_φ₁ ∧
      CategoryTheory.IsIso (φ₁.left ∣_ U_φ₁) ∧
      AlgebraicGeometry.IsProper f₁.left ∧
      AlgebraicGeometry.Surjective f₁.left ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U₀) ∧
      σ₁ ≫ f₁ = 𝟙 (weilProjectiveSpaceOver k m) ∧
      (∀ (K : Type u) [Field K] [IsAlgClosed K]
          (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left),
        ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₁.left s),
          topologicalKrullDim ↥E = (1 : WithBot ℕ∞) ∧
          ∃ (q : ↥(CategoryTheory.Limits.pullback f₁.left s)) (W : V₁.left.Opens),
            q ∈ E ∧
            (CategoryTheory.Limits.pullback.fst f₁.left s).base q ∈ W ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left)) ∧
      AlgebraicGeometry.IsClosedImmersion ιZ₁ ∧
      AlgebraicGeometry.IsReduced Z₁ ∧
      AlgebraicGeometry.IsFinite (ιZ₁ ≫ f₁.left) ∧
      AlgebraicGeometry.Etale ((ιZ₁ ≫ f₁.left) ∣_ U₀) ∧
      φ₁.left.base ⁻¹' Z_closed ⊆
        f₁.left.base ⁻¹' ((U₀ : Set (weilProjectiveSpaceOver k m).left)ᶜ) ∪ Set.range ιZ₁.base :=
by
  
  have hPullRestrict :
      ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) (U : Z.Opens),
        ∃ q_U : ((CategoryTheory.Limits.pullback.fst f g) ⁻¹ᵁ (f ⁻¹ᵁ U)).toScheme ⟶
            (g ⁻¹ᵁ U).toScheme,
          q_U ≫ (g ⁻¹ᵁ U).ι =
            ((CategoryTheory.Limits.pullback.fst f g) ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫
              CategoryTheory.Limits.pullback.snd f g ∧
          CategoryTheory.IsPullback
            ((CategoryTheory.Limits.pullback.fst f g) ∣_ (f ⁻¹ᵁ U)) q_U (f ∣_ U) (g ∣_ U) := by
    intro X Y Z f g U
    let fst := CategoryTheory.Limits.pullback.fst f g
    let snd := CategoryTheory.Limits.pullback.snd f g
    have hBase : CategoryTheory.IsPullback fst snd f g :=
      CategoryTheory.IsPullback.of_hasPullback f g
    have hTop : CategoryTheory.IsPullback (fst ∣_ (f ⁻¹ᵁ U)) (fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι
        (f ⁻¹ᵁ U).ι fst :=
      AlgebraicGeometry.isPullback_morphismRestrict fst (f ⁻¹ᵁ U)
    have hBot : CategoryTheory.IsPullback (g ∣_ U) (g ⁻¹ᵁ U).ι U.ι g :=
      AlgebraicGeometry.isPullback_morphismRestrict g U
    have hOuter : CategoryTheory.IsPullback (fst ∣_ (f ⁻¹ᵁ U)) ((fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ snd)
        ((f ∣_ U) ≫ U.ι) g := by
      rw [AlgebraicGeometry.morphismRestrict_ι f U]
      exact hTop.paste_vert hBase
    let q_U : (fst ⁻¹ᵁ (f ⁻¹ᵁ U)).toScheme ⟶ (g ⁻¹ᵁ U).toScheme :=
      hBot.lift ((fst ∣_ (f ⁻¹ᵁ U)) ≫ (f ∣_ U)) ((fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ snd)
        (by rw [CategoryTheory.Category.assoc]; exact hOuter.w)
    have hq_ι : q_U ≫ (g ⁻¹ᵁ U).ι = (fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ snd := hBot.lift_snd _ _ _
    have hq_comm : (fst ∣_ (f ⁻¹ᵁ U)) ≫ (f ∣_ U) = q_U ≫ (g ∣_ U) :=
      (hBot.lift_fst _ _ _).symm
    refine ⟨q_U, hq_ι, CategoryTheory.IsPullback.of_bot ?_ hq_comm hBot⟩
    rw [hq_ι]
    exact hOuter

  
  have hRestrictSub :
       ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (W : X.Opens) (U₀ : Y.Opens)
         (hle : f ⁻¹ᵁ U₀ ≤ W),
         CategoryTheory.IsPullback (f ∣_ U₀) (X.homOfLE hle) U₀.ι (W.ι ≫ f) := by
    intro X Y f W U₀ hle
    have h1 : CategoryTheory.IsPullback (f ∣_ U₀) (X.homOfLE hle ≫ W.ι) U₀.ι f := by
      rw [X.homOfLE_ι hle]
      exact AlgebraicGeometry.isPullback_morphismRestrict f U₀
    have hcomm : (f ∣_ U₀) ≫ U₀.ι = X.homOfLE hle ≫ (W.ι ≫ f) := h1.w
    refine CategoryTheory.IsPullback.of_isLimit (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
      (fun s => h1.lift s.fst (s.snd ≫ W.ι)
        (by rw [CategoryTheory.Category.assoc]; exact s.condition))
      (fun s => h1.lift_fst _ _ _)
      (fun s => by
        rw [← CategoryTheory.cancel_mono W.ι, CategoryTheory.Category.assoc]
        exact h1.lift_snd _ _ _)
      (fun s m hm₁ hm₂ => h1.hom_ext
        (hm₁.trans (h1.lift_fst _ _ _).symm)
        (by rw [← CategoryTheory.Category.assoc, hm₂]; exact (h1.lift_snd _ _ _).symm)))

  
  have hSmoothSup :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (W₁ W₂ : X.Opens),
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₁.ι ≫ f) →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₂.ι ≫ f) →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 ((W₁ ⊔ W₂ : X.Opens).ι ≫ f) := by
    intro X Y f W₁ W₂ h₁ h₂
    let W : X.Opens := W₁ ⊔ W₂
    have h_part : ∀ (W₀ : X.Opens) (hle : W₀ ≤ W),
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₀.ι ≫ f) →
        ∀ (z : ↥W.toScheme), z.1 ∈ W₀ →
          ∃ (U : Y.Opens) (_ : AlgebraicGeometry.IsAffineOpen U)
            (V : W.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
            (_ : z ∈ V) (e : V ≤ (W.ι ≫ f) ⁻¹ᵁ U),
            RingHom.IsStandardSmoothOfRelativeDimension 1
              ((W.ι ≫ f).appLE U V e).hom := by
      intro W₀ hle h₀ z hz₀
      let j : W₀.toScheme ⟶ W.toScheme := X.homOfLE hle
      have h₀' : AlgebraicGeometry.SmoothOfRelativeDimension 1 (j ≫ W.ι ≫ f) := by
        rw [AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
        exact h₀
      rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at h₀'
      obtain ⟨U, hAffU, V₀, hAffV₀, hzV₀, e₀, hStd₀⟩ := h₀' ⟨z.1, hz₀⟩
      let V : W.toScheme.Opens := j ''ᵁ V₀
      have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffV₀.image_of_isOpenImmersion j
      have hzV : z ∈ V := by
        refine ⟨⟨z.1, hz₀⟩, hzV₀, ?_⟩
        apply Subtype.ext
        exact AlgebraicGeometry.Scheme.homOfLE_apply hle ⟨z.1, hz₀⟩
      have e : V ≤ (W.ι ≫ f) ⁻¹ᵁ U := by
        rintro _ ⟨w, hw, rfl⟩
        exact e₀ hw
      have hpre_eq : j ⁻¹ᵁ V = V₀ := by
        ext w
        refine ⟨?_, fun hw => ⟨w, hw, rfl⟩⟩
        rintro ⟨w', hw', hEq⟩
        cases j.isOpenEmbedding.injective hEq
        exact hw'
      have hIso_app : CategoryTheory.IsIso (j.app V) :=
        AlgebraicGeometry.PresheafedSpace.IsOpenImmersion.c_iso V₀
      have hIso_map : CategoryTheory.IsIso
          (W₀.toScheme.presheaf.map (CategoryTheory.homOfLE hpre_eq.ge).op) := by
        have : CategoryTheory.IsIso (CategoryTheory.homOfLE hpre_eq.ge).op :=
          ⟨⟨(CategoryTheory.homOfLE hpre_eq.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
        infer_instance
      have hIso : CategoryTheory.IsIso (j.appLE V V₀ hpre_eq.ge) := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_app hIso_map
      refine ⟨U, hAffU, V, hAffV, hzV, e, ?_⟩
      let φ := (W.ι ≫ f).appLE U V e
      let ψ := j.appLE V V₀ hpre_eq.ge
      have hcomp : φ ≫ ψ = (j ≫ W.ι ≫ f).appLE U V₀ e₀ :=
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j (W.ι ≫ f) U V V₀ e hpre_eq.ge
      have hφ_eq : φ = (j ≫ W.ι ≫ f).appLE U V₀ e₀ ≫ CategoryTheory.inv ψ := by
        rw [← hcomp, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      let e_ring : ↑(W₀.toScheme.presheaf.obj (Opposite.op V₀)) ≃+*
          ↑(W.toScheme.presheaf.obj (Opposite.op V)) :=
        (CategoryTheory.asIso ψ).symm.commRingCatIsoToRingEquiv
      have h_std' : RingHom.IsStandardSmoothOfRelativeDimension 1
          (e_ring.toRingHom.comp ((j ≫ W.ι ≫ f).appLE U V₀ e₀).hom) :=
        RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _ e_ring hStd₀
      have hhom : φ.hom = e_ring.toRingHom.comp ((j ≫ W.ι ≫ f).appLE U V₀ e₀).hom := by
        rw [hφ_eq, CommRingCat.hom_comp]
        rfl
      rwa [hhom]
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro z
    rcases z.2 with hz₁ | hz₂
    · exact h_part W₁ le_sup_left h₁ z hz₁
    · exact h_part W₂ le_sup_right h₂ z hz₂

  
  have hFT_of_proj :
      ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        IsProjectiveOverField k Y → AlgebraicGeometry.LocallyOfFiniteType Y.hom := by
    intro Y ⟨N, ι, hClosed⟩
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  let P_amb := weilProjectiveSpaceOver k (m + 1)
  let B₀ := weilProjectiveSpaceOver k m
  let U_proj := weilProjCenterComplOpen k m

  
  obtain ⟨pr_p₀, P_tilde, p₁, p₂, ε_p₀,
      hPr, hUproj, hIntPt, hProjPt, hProp_p₁, hProp_p₂, hSm_p₂,
      hIso_p₁, hComp_pr, hSec_ε, hUniq_pt, hFib_p₂⟩ :=
    weil_pointCenter_incidence_blowup_package k m hm

  obtain ⟨π, U_et_π, q_sec, Z_div, ι_div, j_div, Z_low, b_star, W_sm₀, W_et₀,
      hFin_π, hSurj_π, hSub_et_π, hEt_π, hq_sec_hom, hq_sec_range, hPt_lift,
      hCl_div, hRed_div, hClosed_low, hZ_decomp, hj_div_ι, hZ_low_sub, hFin_div,
      hb_star_low, hb_star_sm, hSm_Wsm₀, hb_star_et, hEt_Wet₀⟩ :=
    weil_algClosed_adapted_bertini_linear_projection k m hm V_norm
      hIntVn hProjVn hDimVn W_reg hSmWreg hDimSing Z_closed hClosedZ hProperZ pr_p₀ hPr

  
  let V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk
      (CategoryTheory.Limits.pullback.fst π.left p₁.left ≫ V_norm.hom)
  let φ₁ : V₁ ⟶ V_norm :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst π.left p₁.left) rfl
  let q_tilde : V₁.left ⟶ P_tilde.left :=
    CategoryTheory.Limits.pullback.snd π.left p₁.left
  have hf₁_w : (q_tilde ≫ p₂.left) ≫ B₀.hom = V₁.hom := by
    have h_pb_cond : q_tilde ≫ p₁.left = φ₁.left ≫ π.left :=
      CategoryTheory.Limits.pullback.condition.symm
    calc (q_tilde ≫ p₂.left) ≫ B₀.hom
        = q_tilde ≫ (p₂.left ≫ B₀.hom) := CategoryTheory.Category.assoc _ _ _
      _ = q_tilde ≫ P_tilde.hom := by rw [CategoryTheory.Over.w p₂]
      _ = q_tilde ≫ (p₁.left ≫ P_amb.hom) := by rw [← CategoryTheory.Over.w p₁]
      _ = (q_tilde ≫ p₁.left) ≫ P_amb.hom := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (φ₁.left ≫ π.left) ≫ P_amb.hom := by rw [h_pb_cond]
      _ = φ₁.left ≫ (π.left ≫ P_amb.hom) := CategoryTheory.Category.assoc _ _ _
      _ = φ₁.left ≫ V_norm.hom := by rw [CategoryTheory.Over.w π]
      _ = V₁.hom := rfl
  let f₁ : V₁ ⟶ B₀ := CategoryTheory.Over.homMk (q_tilde ≫ p₂.left) hf₁_w
  let U_φ₁ : V_norm.left.Opens := π.left ⁻¹ᵁ U_proj

  have : AlgebraicGeometry.IsFinite π.left := hFin_π
  have : AlgebraicGeometry.Surjective π.left := hSurj_π
  have : AlgebraicGeometry.IsProper p₁.left := hProp_p₁
  have : AlgebraicGeometry.IsProper p₂.left := hProp_p₂
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 p₂.left := hSm_p₂
  have : CategoryTheory.IsIso (p₁.left ∣_ U_proj) := hIso_p₁

  have hFin_q : AlgebraicGeometry.IsFinite q_tilde := by
    dsimp [q_tilde]
    infer_instance
  have hProp_φ₁ : AlgebraicGeometry.IsProper φ₁.left := by
    change AlgebraicGeometry.IsProper (CategoryTheory.Limits.pullback.fst π.left p₁.left)
    infer_instance
  have hProp_f₁ : AlgebraicGeometry.IsProper f₁.left := by
    change AlgebraicGeometry.IsProper (q_tilde ≫ p₂.left)
    infer_instance

  have hUφ₁ : Nonempty U_φ₁ := by
    obtain ⟨⟨y₀, hy₀⟩⟩ := hUproj
    obtain ⟨x₀, hx₀⟩ := hSurj_π.surj y₀
    refine ⟨⟨x₀, ?_⟩⟩
    change π.left.base x₀ ∈ U_proj
    rwa [hx₀]

  
  have h_sec_comm : (B₀.hom ≫ q_sec) ≫ π.left = ε_p₀.left ≫ p₁.left := by
    rw [CategoryTheory.Category.assoc]
    apply hUniq_pt (q_sec ≫ π.left)
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w π]
      exact hq_sec_hom
    · exact hq_sec_range
  let σ₁_left : B₀.left ⟶ V₁.left :=
    CategoryTheory.Limits.pullback.lift (B₀.hom ≫ q_sec) ε_p₀.left h_sec_comm
  have hσ₁_w : σ₁_left ≫ V₁.hom = B₀.hom := by
    change σ₁_left ≫ CategoryTheory.Limits.pullback.fst π.left p₁.left ≫ V_norm.hom = B₀.hom
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
      CategoryTheory.Category.assoc, hq_sec_hom, CategoryTheory.Category.comp_id]
  let σ₁ : B₀ ⟶ V₁ := CategoryTheory.Over.homMk σ₁_left hσ₁_w
  have hSec₁ : σ₁ ≫ f₁ = 𝟙 B₀ := by
    ext : 1
    change σ₁_left ≫ q_tilde ≫ p₂.left = 𝟙 B₀.left
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
    exact congrArg CategoryTheory.CommaMorphism.left hSec_ε
  have hSurj_f₁ : AlgebraicGeometry.Surjective f₁.left := by
    refine ⟨fun b => ⟨σ₁.left.base b, ?_⟩⟩
    change (σ₁.left ≫ f₁.left).base b = b
    have hId : σ₁.left ≫ f₁.left = 𝟙 B₀.left :=
      congrArg CategoryTheory.CommaMorphism.left hSec₁
    rw [hId]
    rfl

  
  obtain ⟨q_U, hq_U_ι, hPb_U⟩ :
      ∃ q_U : (φ₁.left ⁻¹ᵁ U_φ₁).toScheme ⟶ (p₁.left ⁻¹ᵁ U_proj).toScheme,
        q_U ≫ (p₁.left ⁻¹ᵁ U_proj).ι = (φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ q_tilde ∧
        CategoryTheory.IsPullback (φ₁.left ∣_ U_φ₁) q_U
          (π.left ∣_ U_proj) (p₁.left ∣_ U_proj) :=
    hPullRestrict π.left p₁.left U_proj
  have hIso_φ₁ : CategoryTheory.IsIso (φ₁.left ∣_ U_φ₁) := hPb_U.isIso_fst_of_isIso
  have hInv_qU :
      CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ q_U =
        (π.left ∣_ U_proj) ≫ CategoryTheory.inv (p₁.left ∣_ U_proj) := by
    calc CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ q_U
        = CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫
            (q_U ≫ (p₁.left ∣_ U_proj)) ≫ CategoryTheory.inv (p₁.left ∣_ U_proj) := by
            rw [CategoryTheory.Category.assoc q_U, CategoryTheory.IsIso.hom_inv_id,
              CategoryTheory.Category.comp_id]
      _ = CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫
            ((φ₁.left ∣_ U_φ₁) ≫ (π.left ∣_ U_proj)) ≫ CategoryTheory.inv (p₁.left ∣_ U_proj) := by
            rw [hPb_U.w]
      _ = (π.left ∣_ U_proj) ≫ CategoryTheory.inv (p₁.left ∣_ U_proj) := by
            simp only [← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
              CategoryTheory.Category.id_comp]
  have hf₁_left : f₁.left = q_tilde ≫ p₂.left := rfl
  have hOpenId :
      CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ (φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ f₁.left =
        (π.left ∣_ U_proj) ≫ pr_p₀ := by
    calc CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ (φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ f₁.left
        = CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ ((φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ q_tilde) ≫ p₂.left := by
            rw [hf₁_left, CategoryTheory.Category.assoc]
      _ = CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ (q_U ≫ (p₁.left ⁻¹ᵁ U_proj).ι) ≫ p₂.left := by
            rw [hq_U_ι]
      _ = (CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ q_U) ≫ (p₁.left ⁻¹ᵁ U_proj).ι ≫ p₂.left := by
            simp only [CategoryTheory.Category.assoc]
      _ = ((π.left ∣_ U_proj) ≫ CategoryTheory.inv (p₁.left ∣_ U_proj)) ≫
            (p₁.left ⁻¹ᵁ U_proj).ι ≫ p₂.left := by
            rw [hInv_qU]
      _ = (π.left ∣_ U_proj) ≫
            (CategoryTheory.inv (p₁.left ∣_ U_proj) ≫ (p₁.left ⁻¹ᵁ U_proj).ι ≫ p₂.left) := by
            simp only [CategoryTheory.Category.assoc]
      _ = (π.left ∣_ U_proj) ≫ pr_p₀ := by
            rw [hComp_pr]

  have hSurj_φ₁ : AlgebraicGeometry.Surjective φ₁.left := by
    refine ⟨fun x => ?_⟩
    by_cases hx : x ∈ U_φ₁
    · let u : ↥U_φ₁.toScheme := ⟨x, hx⟩
      let v₀ : ↥(φ₁.left ⁻¹ᵁ U_φ₁).toScheme :=
        (CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base u
      refine ⟨(φ₁.left ⁻¹ᵁ U_φ₁).ι.base v₀, ?_⟩
      change (CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ (φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ φ₁.left).base u = x
      rw [← AlgebraicGeometry.morphismRestrict_ι φ₁.left U_φ₁, ← CategoryTheory.Category.assoc,
        CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
      exact AlgebraicGeometry.Scheme.Opens.ι_apply U_φ₁ u
    · have hx_not : π.left.base x ∉ U_proj := hx
      obtain ⟨q_x, hq_x_hom, pt₀, hpt₀⟩ := hPt_lift x hx_not
      have h_qx_comm : (B₀.hom ≫ q_x) ≫ π.left = ε_p₀.left ≫ p₁.left := by
        rw [CategoryTheory.Category.assoc]
        apply hUniq_pt (q_x ≫ π.left)
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w π]
          exact hq_x_hom
        · rintro _ ⟨s₀, rfl⟩
          have hs₀ : s₀ = pt₀ := Subsingleton.elim s₀ pt₀
          change π.left.base (q_x.base s₀) ∉ U_proj
          rw [hs₀, hpt₀]
          exact hx_not
      let σ_x : B₀.left ⟶ V₁.left :=
        CategoryTheory.Limits.pullback.lift (B₀.hom ≫ q_x) ε_p₀.left h_qx_comm
      refine ⟨σ_x.base b_star, ?_⟩
      change (σ_x ≫ φ₁.left).base b_star = x
      have hfst : σ_x ≫ φ₁.left = B₀.hom ≫ q_x :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hfst]
      change q_x.base (B₀.hom.base b_star) = x
      have h_sub : B₀.hom.base b_star = pt₀ := Subsingleton.elim _ _
      rw [h_sub, hpt₀]

  
  have : AlgebraicGeometry.IsSeparated P_amb.hom := by
    dsimp [P_amb, weilProjectiveSpaceOver]
    infer_instance
  have hProjV₁ : IsProjectiveOverField k V₁ :=
    weil_projectiveOverField_pullback_of_isSeparated k V_norm P_tilde P_amb π p₁ hProjVn hProjPt

  have hCov_Pamb : (U_proj : Set P_amb.left) ∪ (U_et_π : Set P_amb.left) = Set.univ := by
    ext y
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    by_cases hy : y ∈ U_proj
    · exact Or.inl hy
    · exact Or.inr (hSub_et_π hy)
  have hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left :=
    weil_etale_exc_open_iso_pullback_isIntegral V_norm.left P_tilde.left P_amb.left
      π.left p₁.left hIntVn hIntPt U_proj U_et_π hUφ₁ hEt_π hCov_Pamb

  have : AlgebraicGeometry.LocallyOfFiniteType V_norm.hom := hFT_of_proj V_norm hProjVn
  have hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
    (weil_birational_iso_on_open_krullDim_eq k V₁ V_norm
      hIntV₁ hProjV₁ hIntVn φ₁ U_φ₁ hUφ₁).trans hDimVn

  let W_exc : V₁.left.Opens := φ₁.left ⁻¹ᵁ (π.left ⁻¹ᵁ U_et_π)
  obtain ⟨q_exc, hq_exc_ι, hPb_exc⟩ :
      ∃ q_exc : W_exc.toScheme ⟶ (p₁.left ⁻¹ᵁ U_et_π).toScheme,
        q_exc ≫ (p₁.left ⁻¹ᵁ U_et_π).ι = W_exc.ι ≫ q_tilde ∧
        CategoryTheory.IsPullback (φ₁.left ∣_ (π.left ⁻¹ᵁ U_et_π)) q_exc
          (π.left ∣_ U_et_π) (p₁.left ∣_ U_et_π) :=
    hPullRestrict π.left p₁.left U_et_π
  have hEt_qexc : AlgebraicGeometry.Etale q_exc :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.Etale) hPb_exc hEt_π
  have hSm_Wexc : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_exc.ι ≫ f₁.left) := by
    have hEq : W_exc.ι ≫ f₁.left = (q_exc ≫ (p₁.left ⁻¹ᵁ U_et_π).ι) ≫ p₂.left := by
      rw [hf₁_left, ← CategoryTheory.Category.assoc, ← hq_exc_ι]
    rw [hEq]
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 q_exc := inferInstance
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 (p₁.left ⁻¹ᵁ U_et_π).ι := inferInstance
    have : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 0)
        (q_exc ≫ (p₁.left ⁻¹ᵁ U_et_π).ι) := inferInstance
    have h_sm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        ((q_exc ≫ (p₁.left ⁻¹ᵁ U_et_π).ι) ≫ p₂.left) := inferInstance
    rw [Nat.zero_add] at h_sm_comp
    exact h_sm_comp

  have hFib_p₂_exc :
      ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₀.left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback p₂.left s) ∧
      topologicalKrullDim ↥(CategoryTheory.Limits.pullback p₂.left s) = (1 : WithBot ℕ∞) ∧
      ∃ z₀ : ↥(CategoryTheory.Limits.pullback p₂.left s),
        q_tilde.base ⁻¹' {(CategoryTheory.Limits.pullback.fst p₂.left s).base z₀} ⊆
          (W_exc : Set V₁.left) := by
    intro K _ _ s
    obtain ⟨hIrred_s, hDim_s, z₀, hz₀_not⟩ := hFib_p₂ K s
    refine ⟨hIrred_s, hDim_s, z₀, ?_⟩
    intro v hv
    have hv_eq : q_tilde.base v = (CategoryTheory.Limits.pullback.fst p₂.left s).base z₀ := hv
    change π.left.base (φ₁.left.base v) ∈ U_et_π
    have h_cond_v : φ₁.left ≫ π.left = q_tilde ≫ p₁.left :=
      CategoryTheory.Limits.pullback.condition
    have h_comm_v : π.left.base (φ₁.left.base v) = p₁.left.base (q_tilde.base v) := by
      change (φ₁.left ≫ π.left).base v = (q_tilde ≫ p₁.left).base v
      rw [h_cond_v]
    rw [h_comm_v, hv_eq]
    exact hSub_et_π hz₀_not

  have hFibComp₁ :=
    weil_algClosed_finite_over_projLine_fiber_equidim k m hm V₁ hIntV₁ hProjV₁ hDimV₁
      P_tilde.left q_tilde p₂.left f₁ rfl W_exc hSm_Wexc hFib_p₂_exc

  
  let Z₁ : AlgebraicGeometry.Scheme.{u} := Z_div
  let ιZ₁ : Z₁ ⟶ V₁.left :=
    j_div ≫ CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ (φ₁.left ⁻¹ᵁ U_φ₁).ι
  have hRed_Z₁ : AlgebraicGeometry.IsReduced Z₁ := hRed_div
  have hιZ₁_φ₁ : ιZ₁ ≫ φ₁.left = ι_div := by
    calc ιZ₁ ≫ φ₁.left
        = j_div ≫ CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫
            ((φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ φ₁.left) := by
            dsimp [ιZ₁]; simp only [CategoryTheory.Category.assoc]
      _ = j_div ≫ CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫
            (φ₁.left ∣_ U_φ₁) ≫ U_φ₁.ι := by
            rw [AlgebraicGeometry.morphismRestrict_ι φ₁.left U_φ₁]
      _ = j_div ≫ U_φ₁.ι := by
            rw [← CategoryTheory.Category.assoc (CategoryTheory.inv (φ₁.left ∣_ U_φ₁)),
              CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
      _ = ι_div := hj_div_ι
  have hCl_Z₁ : AlgebraicGeometry.IsClosedImmersion ιZ₁ := by
    have : AlgebraicGeometry.IsClosedImmersion (ιZ₁ ≫ φ₁.left) := by
      rw [hιZ₁_φ₁]
      exact hCl_div
    exact AlgebraicGeometry.IsClosedImmersion.of_comp ιZ₁ φ₁.left

  have hιZ₁_f₁ : ιZ₁ ≫ f₁.left = j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀ := by
    calc ιZ₁ ≫ f₁.left
        = j_div ≫ (CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫
            (φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ f₁.left) := by
            dsimp [ιZ₁]; simp only [CategoryTheory.Category.assoc]
      _ = j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀ := by
            rw [hOpenId]
  have hFin_Z₁ : AlgebraicGeometry.IsFinite (ιZ₁ ≫ f₁.left) := by
    rw [hιZ₁_f₁]
    exact hFin_div

  let j_sm₁ : W_sm₀.toScheme ⟶ V₁.left :=
    W_sm₀.ι ≫ CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ (φ₁.left ⁻¹ᵁ U_φ₁).ι
  let W_sm₁ : V₁.left.Opens := j_sm₁.opensRange
  have hSm_Wsm₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm₁.ι ≫ f₁.left) := by
    have hEq : W_sm₁.ι ≫ f₁.left =
        j_sm₁.isoOpensRange.inv ≫ (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
      calc W_sm₁.ι ≫ f₁.left
          = (j_sm₁.isoOpensRange.inv ≫ j_sm₁.isoOpensRange.hom) ≫ W_sm₁.ι ≫ f₁.left := by
              rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = j_sm₁.isoOpensRange.inv ≫ (j_sm₁ ≫ f₁.left) := by
              rw [CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι_assoc]
        _ = j_sm₁.isoOpensRange.inv ≫ W_sm₀.ι ≫
              (CategoryTheory.inv (φ₁.left ∣_ U_φ₁) ≫ (φ₁.left ⁻¹ᵁ U_φ₁).ι ≫ f₁.left) := by
              dsimp [j_sm₁]; simp only [CategoryTheory.Category.assoc]
        _ = j_sm₁.isoOpensRange.inv ≫ (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
              rw [hOpenId]
    rw [hEq]
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 j_sm₁.isoOpensRange.inv := inferInstance
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := hSm_Wsm₀
    have : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        (j_sm₁.isoOpensRange.inv ≫ (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀)) := inferInstance
    simpa using this

  let W_sm_tot : V₁.left.Opens := W_exc ⊔ W_sm₁
  have hSm_Wtot : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm_tot.ι ≫ f₁.left) :=
    hSmoothSup f₁.left W_exc W_sm₁ hSm_Wexc hSm_Wsm₁

  
  have : AlgebraicGeometry.IsFinite (ιZ₁ ≫ f₁.left) := hFin_Z₁
  let K_sm : Set B₀.left := f₁.left.base '' ((W_sm_tot : Set V₁.left)ᶜ)
  let K_et : Set B₀.left := (ιZ₁ ≫ f₁.left).base '' ((W_et₀ : Set Z₁)ᶜ)
  let K_low : Set B₀.left := f₁.left.base '' (φ₁.left.base ⁻¹' Z_low)

  have hClosed_Ksm : IsClosed K_sm :=
    AlgebraicGeometry.Scheme.Hom.isClosedMap f₁.left _ W_sm_tot.isOpen.isClosed_compl
  have hClosed_Ket : IsClosed K_et :=
    AlgebraicGeometry.Scheme.Hom.isClosedMap (ιZ₁ ≫ f₁.left) _ W_et₀.isOpen.isClosed_compl
  have hClosed_Klow : IsClosed K_low :=
    AlgebraicGeometry.Scheme.Hom.isClosedMap f₁.left _ (hClosed_low.preimage φ₁.left.continuous)

  have hb_not_Ksm : b_star ∉ K_sm := by
    rintro ⟨v, hv_not, hv_eq⟩
    by_cases hvU : v ∈ φ₁.left ⁻¹ᵁ U_φ₁
    · let v₀ : ↥(φ₁.left ⁻¹ᵁ U_φ₁).toScheme := ⟨v, hvU⟩
      let x₀ : ↥U_φ₁.toScheme := (φ₁.left ∣_ U_φ₁).base v₀
      have h_inv_x₀ : (CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base x₀ = v₀ := by
        change ((φ₁.left ∣_ U_φ₁) ≫ CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base v₀ = v₀
        rw [CategoryTheory.IsIso.hom_inv_id]
        rfl
      have hx₀_b : ((π.left ∣_ U_proj) ≫ pr_p₀).base x₀ = b_star := by
        rw [← hOpenId]
        change f₁.left.base ((φ₁.left ⁻¹ᵁ U_φ₁).ι.base
          ((CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base x₀)) = b_star
        rw [h_inv_x₀]
        exact hv_eq
      have hx₀_sm : x₀ ∈ W_sm₀ := hb_star_sm x₀ hx₀_b
      have hv_sm₁ : v ∈ W_sm₁ := by
        refine ⟨⟨x₀, hx₀_sm⟩, ?_⟩
        change (φ₁.left ⁻¹ᵁ U_φ₁).ι.base
          ((CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base (W_sm₀.ι.base ⟨x₀, hx₀_sm⟩)) = v
        have hι_w : W_sm₀.ι.base ⟨x₀, hx₀_sm⟩ = x₀ :=
          AlgebraicGeometry.Scheme.Opens.ι_apply W_sm₀ ⟨x₀, hx₀_sm⟩
        rw [hι_w, h_inv_x₀]
        exact AlgebraicGeometry.Scheme.Opens.ι_apply (φ₁.left ⁻¹ᵁ U_φ₁) v₀
      exact hv_not (Or.inr hv_sm₁)
    · have hv_exc : v ∈ W_exc := hSub_et_π hvU
      exact hv_not (Or.inl hv_exc)

  have hb_not_Ket : b_star ∉ K_et := by
    rintro ⟨z, hz_not, hz_eq⟩
    have hz_b : (j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀).base z = b_star := by
      rwa [← hιZ₁_f₁]
    exact hz_not (hb_star_et z hz_b)

  have hb_not_Klow : b_star ∉ K_low := by
    rintro ⟨v, hv_low, hv_eq⟩
    have hvU : v ∈ φ₁.left ⁻¹ᵁ U_φ₁ := hZ_low_sub hv_low
    let v₀ : ↥(φ₁.left ⁻¹ᵁ U_φ₁).toScheme := ⟨v, hvU⟩
    let x₀ : ↥U_φ₁.toScheme := (φ₁.left ∣_ U_φ₁).base v₀
    have h_inv_x₀ : (CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base x₀ = v₀ := by
      change ((φ₁.left ∣_ U_φ₁) ≫ CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base v₀ = v₀
      rw [CategoryTheory.IsIso.hom_inv_id]
      rfl
    have hx₀_val : x₀.1 ∈ Z_low := by
      have hι : U_φ₁.ι.base x₀ = φ₁.left.base v := by
        change ((φ₁.left ∣_ U_φ₁) ≫ U_φ₁.ι).base v₀ = φ₁.left.base v
        rw [AlgebraicGeometry.morphismRestrict_ι φ₁.left U_φ₁]
        rfl
      have hcoe : U_φ₁.ι.base x₀ = x₀.1 := AlgebraicGeometry.Scheme.Opens.ι_apply U_φ₁ x₀
      rwa [← hcoe, hι]
    have hx₀_b : ((π.left ∣_ U_proj) ≫ pr_p₀).base x₀ = b_star := by
      rw [← hOpenId]
      change f₁.left.base ((φ₁.left ⁻¹ᵁ U_φ₁).ι.base
        ((CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base x₀)) = b_star
      rw [h_inv_x₀]
      exact hv_eq
    exact hb_star_low x₀ hx₀_val hx₀_b

  let U₀ : B₀.left.Opens :=
    ⟨(K_sm ∪ K_et ∪ K_low)ᶜ, ((hClosed_Ksm.union hClosed_Ket).union hClosed_Klow).isOpen_compl⟩
  have hb_U₀ : b_star ∈ U₀ := by
    rintro ((h₁ | h₂) | h₃)
    · exact hb_not_Ksm h₁
    · exact hb_not_Ket h₂
    · exact hb_not_Klow h₃
  have hU₀ : Nonempty U₀ := ⟨⟨b_star, hb_U₀⟩⟩

  have hPre_sm : f₁.left ⁻¹ᵁ U₀ ≤ W_sm_tot := by
    intro v hv
    by_contra hv_not
    have h_in_Ksm : f₁.left.base v ∈ K_sm := ⟨v, hv_not, rfl⟩
    exact hv (Or.inl (Or.inl h_in_Ksm))
  have hPb_f₁U₀ := hRestrictSub f₁.left W_sm_tot U₀ hPre_sm
  have hSm_f₁U₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U₀) :=
    (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
      hPb_f₁U₀.flip hSm_Wtot

  have hPre_et : (ιZ₁ ≫ f₁.left) ⁻¹ᵁ U₀ ≤ W_et₀ := by
    intro z hz
    by_contra hz_not
    have h_in_Ket : (ιZ₁ ≫ f₁.left).base z ∈ K_et := ⟨z, hz_not, rfl⟩
    exact hz (Or.inl (Or.inr h_in_Ket))
  have hPb_Z₁U₀ := hRestrictSub (ιZ₁ ≫ f₁.left) W_et₀ U₀ hPre_et
  have hEt_W_Z₁ : AlgebraicGeometry.Etale (W_et₀.ι ≫ (ιZ₁ ≫ f₁.left)) := by
    rw [hιZ₁_f₁]
    exact hEt_Wet₀
  have hEt_Z₁U₀ : AlgebraicGeometry.Etale ((ιZ₁ ≫ f₁.left) ∣_ U₀) :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.Etale)
      hPb_Z₁U₀.flip hEt_W_Z₁

  have hBdry :
      φ₁.left.base ⁻¹' Z_closed ⊆
        f₁.left.base ⁻¹' ((U₀ : Set B₀.left)ᶜ) ∪ Set.range ιZ₁.base := by
    intro v hv
    rw [hZ_decomp] at hv
    rcases hv with ⟨z, hz_eq⟩ | hv_low
    · right
      have hz_U : φ₁.left.base v ∈ U_φ₁ := by
        rw [← hz_eq, ← hj_div_ι]
        have h_app : U_φ₁.ι.base (j_div.base z) = (j_div.base z).1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply U_φ₁ (j_div.base z)
        change U_φ₁.ι.base (j_div.base z) ∈ U_φ₁
        rw [h_app]
        exact (j_div.base z).2
      let v₀ : ↥(φ₁.left ⁻¹ᵁ U_φ₁).toScheme := ⟨v, hz_U⟩
      have hj_eq : j_div.base z = (φ₁.left ∣_ U_φ₁).base v₀ := by
        apply U_φ₁.ι.isOpenEmbedding.injective
        change (j_div ≫ U_φ₁.ι).base z = ((φ₁.left ∣_ U_φ₁) ≫ U_φ₁.ι).base v₀
        rw [hj_div_ι, AlgebraicGeometry.morphismRestrict_ι φ₁.left U_φ₁]
        exact hz_eq
      have h_inv_z : (CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base (j_div.base z) = v₀ := by
        rw [hj_eq]
        change ((φ₁.left ∣_ U_φ₁) ≫ CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base v₀ = v₀
        rw [CategoryTheory.IsIso.hom_inv_id]
        rfl
      refine ⟨z, ?_⟩
      change (φ₁.left ⁻¹ᵁ U_φ₁).ι.base
        ((CategoryTheory.inv (φ₁.left ∣_ U_φ₁)).base (j_div.base z)) = v
      rw [h_inv_z]
      exact AlgebraicGeometry.Scheme.Opens.ι_apply (φ₁.left ⁻¹ᵁ U_φ₁) v₀
    · left
      change f₁.left.base v ∉ U₀
      intro hv_U₀
      exact hv_U₀ (Or.inr ⟨v, hv_low, rfl⟩)

  exact ⟨U₀, V₁, f₁, σ₁, Z₁, ιZ₁, φ₁, U_φ₁,
    hU₀, hIntV₁, hProjV₁, hProp_φ₁, hSurj_φ₁, hUφ₁, hIso_φ₁,
    hProp_f₁, hSurj_f₁, hSm_f₁U₀, hSec₁, hFibComp₁,
    hCl_Z₁, hRed_Z₁, hFin_Z₁, hEt_Z₁U₀, hBdry⟩

theorem weil_isProjectiveOverField_baseChange (E₀ F₁ : Type u) [Field E₀] [Field F₁] [Algebra E₀ F₁]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₀)))
    (hProj₀ : IsProjectiveOverField E₀ Y₀) :
    IsProjectiveOverField F₁ (weilBaseChangeOver E₀ F₁ Y₀) :=
by
  obtain ⟨N, ι₀, hClosed₀⟩ := hProj₀
  
  have hIrrel : ∀ (K : Type u) [CommRing K],
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
        MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)) := by
    intro K _
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    intro p hp
    have hp0 : (GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0) p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp
    have hcoeff0 : p.coeff 0 = 0 := by
      have h1 : (MvPolynomial.homogeneousComponent 0 p).coeff 0 =
          ((GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0) p).coeff 0 := by
        rw [GradedRing.proj_apply]
