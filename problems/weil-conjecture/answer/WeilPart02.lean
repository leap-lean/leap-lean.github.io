          have hsmul : (⟨a * b, hab⟩ : ↥J_P) = a • (⟨b, hb⟩ : ↥J_P) := rfl
          rw [hsmul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, RingHom.mem_ker.mp ha,
            TensorProduct.zero_tmul]
