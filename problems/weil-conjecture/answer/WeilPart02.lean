        · rw [Ideal.span_le, Set.singleton_subset_iff]
          exact Ideal.subset_span ⟨u₀.1, Set.mem_union_right _ (Set.mem_singleton u₀.1), rfl⟩
      have hKer_φ_tilde : ∀ x : B_tilde, φ_tilde x = 0 → x = 0 := by
        classical
        intro x hx0
        by_contra hx_ne
        have hmB_ne_top : m_B ≠ ⊤ := Ideal.IsPrime.ne_top inferInstance
        have hInf := Ideal.iInf_pow_eq_bot_of_isLocalRing m_B hmB_ne_top
        have hNotAll : ∃ n : ℕ, x ∉ m_B ^ (n + 1) := by
          by_contra! hAll
          have hx_inf : x ∈ ⨅ i : ℕ, m_B ^ i := Ideal.mem_iInf.mpr fun i => by
            cases i with
            | zero => simp
            | succ n => exact hAll n
          rw [hInf, Ideal.mem_bot] at hx_inf
          exact hx_ne hx_inf
        let n : ℕ := Nat.find hNotAll
        have hNotSucc : x ∉ m_B ^ (n + 1) := Nat.find_spec hNotAll
        have hx_pow_n : x ∈ m_B ^ n := by
          cases hn : n with
          | zero => simp
          | succ k =>
            have hk_lt : k < Nat.find hNotAll := by change k < n; omega
            exact Decidable.byContradiction (Nat.find_min hNotAll hk_lt)
        rw [hmB_span, Ideal.span_singleton_pow] at hx_pow_n hNotSucc
        obtain ⟨v, hv_eq⟩ := Ideal.mem_span_singleton.mp hx_pow_n
        have hv_not_mem : v ∉ m_B := by
          intro hv_mem
          rw [hmB_span] at hv_mem
          obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp hv_mem
          apply hNotSucc
          rw [hv_eq, Ideal.mem_span_singleton]
          exact ⟨w, by ring⟩
        have hv_unit : IsUnit v := IsLocalRing.notMem_maximalIdeal.mp hv_not_mem
        have hφv_ne : φ_tilde v ≠ 0 := (hv_unit.map φ_tilde).ne_zero
        have hφu_ne : (φ_tilde u_bar) ^ n ≠ 0 := pow_ne_zero n hu₀S_ne
        rw [hv_eq, map_mul, map_pow] at hx0
        exact mul_ne_zero hφu_ne hφv_ne hx0
      have hI_eq_J₀ : I = J₀ := by
        refine le_antisymm ?_ hJ₀_le_I
        intro x hx
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact hKer_φ_tilde (Ideal.Quotient.mk J₀ x) (RingHom.mem_ker.mp hx)
      let g_TI : Fin c → TensorProduct P (IsLocalRing.ResidueField S) ↥I :=
        fun i => (1 : IsLocalRing.ResidueField S) ⊗ₜ[P] g i
      let Φ_TI : (Fin c → IsLocalRing.ResidueField S) →ₗ[IsLocalRing.ResidueField S]
          TensorProduct P (IsLocalRing.ResidueField S) ↥I :=
        { toFun := fun f => ∑ i : Fin c, f i • g_TI i
          map_add' := fun f₁ f₂ => by simp [Finset.sum_add_distrib, add_smul]
          map_smul' := fun a f => by simp [Finset.smul_sum, mul_smul] }
      have hSpan_TI_pure : ∀ y ∈ J₀, y ∈ I ∧
          ∀ hy : y ∈ I,
            ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] (⟨y, hy⟩ : ↥I) :
              TensorProduct P (IsLocalRing.ResidueField S) ↥I) ∈ Φ_TI.range := by
        intro y hyJ₀
        refine Submodule.span_induction ?_ ⟨I.zero_mem, fun h0 => ?_⟩ ?_ ?_ hyJ₀
        · rintro _ ⟨i, rfl⟩
          refine ⟨(g i).2, fun hy => ?_⟩
          have hEq : (⟨(g i).1, hy⟩ : ↥I) = g i := rfl
          rw [hEq]
          refine ⟨Pi.single i 1, ?_⟩
          simp [Φ_TI, Pi.single_apply, g_TI]
        · have hEq0 : (⟨(0 : P), h0⟩ : ↥I) = 0 := rfl
          rw [hEq0, TensorProduct.tmul_zero]
          exact zero_mem _
        · rintro x z _ _ ⟨hx, ihx⟩ ⟨hz, ihz⟩
          refine ⟨add_mem hx hz, fun hxz => ?_⟩
          have hadd : (⟨x + z, hxz⟩ : ↥I) = ⟨x, hx⟩ + ⟨z, hz⟩ := rfl
          rw [hadd, TensorProduct.tmul_add]
          exact add_mem (ihx hx) (ihz hz)
        · rintro p₀ x _ ⟨hx, ihx⟩
          refine ⟨I.mul_mem_left p₀ hx, fun hpx => ?_⟩
          have hsmul : (⟨p₀ • x, hpx⟩ : ↥I) = p₀ • ⟨x, hx⟩ := rfl
          rw [hsmul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
            show (algebraMap P (IsLocalRing.ResidueField S) p₀) ⊗ₜ[P] (⟨x, hx⟩ : ↥I) =
              (algebraMap P (IsLocalRing.ResidueField S) p₀) •
                ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] (⟨x, hx⟩ : ↥I)) by
              rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]]
          exact Submodule.smul_mem _ _ (ihx hx)
      have hRange_TI_top : Φ_TI.range = ⊤ := by
        rw [eq_top_iff]
        intro t _
        obtain ⟨b, rfl⟩ := hPure_TI t
        exact (hSpan_TI_pure b.1 (hI_eq_J₀ ▸ b.2)).2 b.2
      have hRN_ΦTI : Module.finrank (IsLocalRing.ResidueField S) ↥Φ_TI.range +
          Module.finrank (IsLocalRing.ResidueField S) ↥Φ_TI.ker =
          Module.finrank (IsLocalRing.ResidueField S) (Fin c → IsLocalRing.ResidueField S) :=
        LinearMap.finrank_range_add_finrank_ker Φ_TI
      rw [hRange_TI_top, finrank_top, Module.finrank_fin_fun] at hRN_ΦTI
      have hRN_ψI : c + Module.finrank (IsLocalRing.ResidueField S) ↥ψ_I.ker =
          Module.finrank (IsLocalRing.ResidueField S)
            (TensorProduct P (IsLocalRing.ResidueField S) ↥I) :=
        LinearMap.finrank_range_add_finrank_ker ψ_I
      have hKer_finrank0 : Module.finrank (IsLocalRing.ResidueField S) ↥ψ_I.ker = 0 := by omega
      have _ : Subsingleton ↥ψ_I.ker := Module.finrank_zero_iff.mp hKer_finrank0
      have hKer_ψI_bot : ψ_I.ker = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro x hx
        exact congrArg Subtype.val (Subsingleton.elim (⟨x, hx⟩ : ↥ψ_I.ker) 0)
      have hInj_ψI : Function.Injective ψ_I := LinearMap.ker_eq_bot.mp hKer_ψI_bot
      let L_S : TensorProduct P (IsLocalRing.ResidueField S) ↥I →ₗ[IsLocalRing.ResidueField S]
          TensorProduct P (IsLocalRing.ResidueField S) Ω[P ⁄ k] :=
        KaehlerDifferential.cotangentComplexBaseChange k S P (IsLocalRing.ResidueField S)
      have hLS_apply : ∀ t, L_S t = L_κ (ψ_I t) := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul a b =>
          dsimp only [L_S, L_κ, ψ_I]
          rw [LinearMap.baseChange_tmul, KaehlerDifferential.cotangentComplexBaseChange_tmul,
            KaehlerDifferential.cotangentComplexBaseChange_tmul]
          rfl
        | add t₁ t₂ h₁ h₂ =>
          rw [map_add, map_add, map_add, h₁, h₂]
      have hInj_LS : Function.Injective L_S :=
        fun t₁ t₂ h => hInj_ψI (hInj_Lκ ((hLS_apply t₁).symm.trans (h.trans (hLS_apply t₂))))
      exact (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange_residueField
        (R := k) (S := S) P hSurj_φ hFG_I).mpr hInj_LS
    obtain ⟨r, π_A, hSurj_π⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType k A›
    let P_poly := MvPolynomial (Fin r) k
    let P_ideal : Ideal P_poly := Ideal.comap π_A.toRingHom p
    have _ : P_ideal.IsPrime := Ideal.IsPrime.comap π_A.toRingHom
    let P := Localization.AtPrime P_ideal
    let S := Localization.AtPrime p
    have _ : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
    have _ : IsNoetherianRing S := inferInstance
    have _ : Algebra.EssFiniteType (A ⧸ p) p.ResidueField :=
      Algebra.EssFiniteType.of_isLocalization p.ResidueField (nonZeroDivisors (A ⧸ p))
    have _ : Algebra.EssFiniteType k p.ResidueField :=
      Algebra.EssFiniteType.comp k (A ⧸ p) p.ResidueField
    have _ : Module.Finite (IsLocalRing.ResidueField S) Ω[IsLocalRing.ResidueField S ⁄ k] :=
      (inferInstance : Module.Finite p.ResidueField Ω[p.ResidueField ⁄ k])
    have _ : Algebra.FormallySmooth k (IsLocalRing.ResidueField S) :=
      (inferInstance : Algebra.FormallySmooth k p.ResidueField)
    let φ_ring : P →+* S := Localization.localRingHom P_ideal p π_A.toRingHom rfl
    have hSurj_φ : Function.Surjective φ_ring :=
      RingHom.surjective_localRingHom_of_surjective π_A.toRingHom hSurj_π p
    letI : Algebra P S := φ_ring.toAlgebra
    have _ : IsScalarTower k P S := IsScalarTower.of_algebraMap_eq' <| by
      ext c
      change algebraMap k S c = φ_ring (algebraMap P_poly P (algebraMap k P_poly c))
      rw [Localization.localRingHom_to_map]
      change algebraMap k S c = algebraMap A S (π_A (algebraMap k P_poly c))
      rw [π_A.commutes c]
      exact IsScalarTower.algebraMap_apply k A S c
    have _ : Module.Free P_poly Ω[P_poly ⁄ k] := instFreeMvPolynomialKaehlerDifferential k (Fin r)
    have _ : IsLocalizedModule P_ideal.primeCompl (KaehlerDifferential.map k k P_poly P) :=
      KaehlerDifferential.isLocalizedModule_map k P_poly P P_ideal.primeCompl
    have _ : Module.Free P Ω[P ⁄ k] :=
      Module.free_of_isLocalizedModule P_ideal.primeCompl (KaehlerDifferential.map k k P_poly P)
    have hFinrank_P : Module.finrank P Ω[P ⁄ k] = r := by
      have hLoc := Module.finrank_of_isLocalizedModule_of_free P P_ideal.primeCompl
        (KaehlerDifferential.map k k P_poly P)
      have hPoly : Module.finrank P_poly Ω[P_poly ⁄ k] = r := by
        rw [Module.finrank_eq_card_basis (KaehlerDifferential.mvPolynomialBasis k (Fin r)), Fintype.card_fin]
      exact hLoc.trans hPoly
    exact (h_local_smooth r P S inferInstance inferInstance hSurj_φ hFinrank_P hCotS hDiffRes).2

  
  rcases eq_or_ne p ⊥ with rfl | hp_ne
  · have _ : Algebra.IsSmoothAt k (⊥ : Ideal A) := (h_s2 d A hDimA (FractionRing A)).1
    exact h_s1 d A hDimA (⊥ : Ideal A)
  · obtain ⟨m, e_p, rfl, hCotS, hDimQuot, he_p⟩ := h_s3 d A hDimA p hp_ne hp
    have hDiffK : Module.finrank (FractionRing A) Ω[FractionRing A ⁄ k] = m + 1 :=
      (h_s2 (m + 1) A hDimA (FractionRing A)).2
    have hDiffRes0 : Module.finrank p.ResidueField Ω[p.ResidueField ⁄ k] = e_p :=
      (h_s2 e_p (A ⧸ p) hDimQuot p.ResidueField).2
    have _ : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
    have _ : IsNoetherianRing (Localization.AtPrime p) := inferInstance
    have _ : Algebra.EssFiniteType (A ⧸ p) p.ResidueField :=
      Algebra.EssFiniteType.of_isLocalization p.ResidueField (nonZeroDivisors (A ⧸ p))
    have _ : Algebra.EssFiniteType k p.ResidueField :=
      Algebra.EssFiniteType.comp k (A ⧸ p) p.ResidueField
    have _ : Module.Finite (IsLocalRing.ResidueField (Localization.AtPrime p))
        Ω[IsLocalRing.ResidueField (Localization.AtPrime p) ⁄ k] :=
      (inferInstance : Module.Finite p.ResidueField Ω[p.ResidueField ⁄ k])
    have _ : IsScalarTower k (Localization.AtPrime p) (FractionRing A) :=
      IsScalarTower.of_algebraMap_eq' <| by
        ext c
        calc algebraMap k (FractionRing A) c
            = algebraMap A (FractionRing A) (algebraMap k A c) :=
                IsScalarTower.algebraMap_apply k A (FractionRing A) c
          _ = algebraMap (Localization.AtPrime p) (FractionRing A)
                (algebraMap A (Localization.AtPrime p) (algebraMap k A c)) :=
                IsScalarTower.algebraMap_apply A (Localization.AtPrime p) (FractionRing A) (algebraMap k A c)
          _ = algebraMap (Localization.AtPrime p) (FractionRing A)
                (algebraMap k (Localization.AtPrime p) c) := by
                rw [← IsScalarTower.algebraMap_apply k A (Localization.AtPrime p) c]
    have hDiffRes : Module.finrank p.ResidueField Ω[p.ResidueField ⁄ k] = m :=
      h_s4 m (Localization.AtPrime p) (FractionRing A) hCotS hDiffK (hDiffRes0 ▸ he_p)
    have _ : Algebra.IsSmoothAt k p := h_s5 m A p hCotS hDiffRes
    exact h_s1 (m + 1) A hDimA p

theorem weil_affineNormal_scheme_codim2_smooth_open (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    (hProjY : IsProjectiveOverField k Y)
    (hDimY : topologicalKrullDim Y.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (hNormCov : ∀ x : Y.left, ∃ U : Y.left.Opens,
      AlgebraicGeometry.IsAffineOpen U ∧
      x ∈ U ∧
      IsIntegrallyClosed ↑(Y.left.presheaf.obj (Opposite.op U)))
    (hSmHt1 : ∀ (d : ℕ)
      (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Algebra k A] [Algebra.FiniteType k A],
      ringKrullDim A = (d : WithBot ℕ∞) →
      ∀ (p : Ideal A) [p.IsPrime],
      p.height ≤ 1 →
      ∃ f : A, f ∉ p ∧ Algebra.IsStandardSmoothOfRelativeDimension d k (Localization.Away f)) :
    ∃ (W_reg : Y.left.Opens),
      AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (W_reg.ι ≫ Y.hom) ∧
      topologicalKrullDim ↥((W_reg : Set Y.left)ᶜ) + 2 ≤ ((m + 1 : ℕ) : WithBot ℕ∞) :=
by
  
  
  
  let 𝒮 : Set Y.left.Opens :=
    { W : Y.left.Opens |
      AlgebraicGeometry.IsAffineOpen W ∧
      RingHom.IsStandardSmoothOfRelativeDimension (m + 1) (Y.hom.appLE ⊤ W le_top).hom }
  let W_reg : Y.left.Opens := sSup 𝒮

  have h_isIso_homOfLE : ∀ {O₁ O₂ : Y.left.Opens} (hle : O₁ ≤ O₂), O₁ = O₂ →
      CategoryTheory.IsIso (Y.left.presheaf.map (CategoryTheory.homOfLE hle).op) := by
    intro O₁ O₂ hle hEq
    subst hEq
    have h_id : CategoryTheory.homOfLE hle = 𝟙 O₁ := Subsingleton.elim _ _
    rw [h_id]
    infer_instance

  have hSmWreg : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (W_reg.ι ≫ Y.hom) := by
    refine ⟨fun x => ?_⟩
    obtain ⟨W, ⟨hW_aff, hW_sm⟩, hxW⟩ := TopologicalSpace.Opens.mem_sSup.mp x.2
    have hW_le : W ≤ W_reg := le_sSup ⟨hW_aff, hW_sm⟩
    let V_open : W_reg.toScheme.Opens := (TopologicalSpace.Opens.map W_reg.ι.base).obj W
    have hW_range : W ≤ W_reg.ι.opensRange := by
      rwa [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    have hV_aff : AlgebraicGeometry.IsAffineOpen V_open :=
      hW_aff.preimage_of_isOpenImmersion W_reg.ι hW_range
    have hxV : x ∈ V_open := hxW
    have he : V_open ≤
        (TopologicalSpace.Opens.map (W_reg.ι ≫ Y.hom).base).obj ⊤ := le_top
    refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top _, V_open, hV_aff, hxV, he, ?_⟩
    have h_comp : (W_reg.ι ≫ Y.hom).appLE ⊤ V_open he =
        Y.hom.appLE ⊤ W le_top ≫ W_reg.ι.appLE W V_open le_rfl :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W_reg.ι Y.hom ⊤ W V_open le_top le_rfl).symm
    have h_iota := AlgebraicGeometry.Scheme.Opens.ι_appLE W_reg W V_open le_rfl
    have : CategoryTheory.IsIso (W_reg.ι.appLE W V_open le_rfl) := by
      rw [h_iota]
      apply h_isIso_homOfLE
      apply le_antisymm _ (fun z hz => ⟨⟨z, hW_le hz⟩, hz, rfl⟩)
      intro z hz
      rcases hz with ⟨u, hu, rfl⟩
      exact hu
    let e_tgt : ↑(Y.left.presheaf.obj (Opposite.op W)) ≃+*
        ↑(W_reg.toScheme.presheaf.obj (Opposite.op V_open)) :=
      (CategoryTheory.asIso (W_reg.ι.appLE W V_open le_rfl)).commRingCatIsoToRingEquiv
    have h_sm' :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso (m + 1)).left
        (Y.hom.appLE ⊤ W le_top).hom e_tgt hW_sm
    have h_hom_eq : e_tgt.toRingHom.comp (Y.hom.appLE ⊤ W le_top).hom =
        ((W_reg.ι ≫ Y.hom).appLE ⊤ V_open he).hom := by
      rw [h_comp]
      rfl
    rwa [← h_hom_eq]

  have hBasicLE : ∀ (U : Y.left.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (f : ↑(Y.left.presheaf.obj (Opposite.op U))),
      letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op U)) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          Y.hom.appLE ⊤ U le_top).hom).toAlgebra
      Algebra.IsStandardSmoothOfRelativeDimension (m + 1) k (Localization.Away f) →
      Y.left.basicOpen f ≤ W_reg := by
    intro U hU f
    let R_k := CommRingCat.of k
    let A : Type u := ↑(Y.left.presheaf.obj (Opposite.op U))
    let φ_U : R_k ⟶ Y.left.presheaf.obj (Opposite.op U) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ Y.hom.appLE ⊤ U le_top
    let : Algebra k A := φ_U.hom.toAlgebra
    intro hf_sm
    have h_alg_sm : RingHom.IsStandardSmoothOfRelativeDimension (m + 1)
        (algebraMap k (Localization.Away f)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap (m + 1)).mpr hf_sm
    let e_src : ↑((AlgebraicGeometry.Spec R_k).presheaf.obj (Opposite.op ⊤)) ≃+* k :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R_k).commRingCatIsoToRingEquiv
    have h_sm1 :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso (m + 1)).right
        (algebraMap k (Localization.Away f)) e_src h_alg_sm
    let W : Y.left.Opens := Y.left.basicOpen f
    have hWU : W ≤ U := Y.left.basicOpen_le f
    have hW_aff : AlgebraicGeometry.IsAffineOpen W := hU.basicOpen f
    let B : Type u := ↑(Y.left.presheaf.obj (Opposite.op W))
    let res_UW : Y.left.presheaf.obj (Opposite.op U) ⟶ Y.left.presheaf.obj (Opposite.op W) :=
      Y.left.presheaf.map (CategoryTheory.homOfLE hWU).op
    let : Algebra A B := res_UW.hom.toAlgebra
    have : IsLocalization.Away f B := hU.isLocalization_basicOpen f
    let e_loc : Localization.Away f ≃ₐ[A] B :=
      IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f) B
    have h_sm2 :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso (m + 1)).left
        ((algebraMap k (Localization.Away f)).comp e_src.toRingHom) e_loc.toRingEquiv h_sm1
    have h_eq_app : e_loc.toRingEquiv.toRingHom.comp
        ((algebraMap k (Localization.Away f)).comp e_src.toRingHom) =
        (Y.hom.appLE ⊤ W le_top).hom := by
      have h_tower : algebraMap k (Localization.Away f) =
          (algebraMap A (Localization.Away f)).comp φ_U.hom :=
        IsScalarTower.algebraMap_eq k A (Localization.Away f)
      have h_res_app : Y.hom.appLE ⊤ U le_top ≫ res_UW = Y.hom.appLE ⊤ W le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map Y.hom le_top (CategoryTheory.homOfLE hWU).op
      ext x
      have hx_inv : ((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom (e_src x) = x := by
        change (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom) x = x
        rw [CategoryTheory.Iso.hom_inv_id]
        rfl
      have h_phi_x : φ_U.hom (e_src x) = (Y.hom.appLE ⊤ U le_top).hom x := by
        change (Y.hom.appLE ⊤ U le_top).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom (e_src x)) = _
        rw [hx_inv]
      have h_eloc_alg : ∀ a : A, e_loc (algebraMap A (Localization.Away f) a) = res_UW.hom a :=
        fun a => e_loc.commutes a
      calc e_loc (algebraMap k (Localization.Away f) (e_src x))
          = e_loc (algebraMap A (Localization.Away f) (φ_U.hom (e_src x))) := by
              rw [h_tower]; rfl
        _ = res_UW.hom ((Y.hom.appLE ⊤ U le_top).hom x) := by
              rw [h_phi_x, h_eloc_alg]
        _ = (Y.hom.appLE ⊤ W le_top).hom x := by
              rw [← h_res_app]; rfl
    rw [h_eq_app] at h_sm2
    exact le_sSup ⟨hW_aff, h_sm2⟩

  
  
  
  have hFT_Y : AlgebraicGeometry.LocallyOfFiniteType Y.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProjY
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  have h_loc_dim : ∀ (X : Type u) [TopologicalSpace X] [Nonempty X] (d : WithBot ℕ∞),
      (∀ x : X, ∃ V : TopologicalSpace.Opens X, x ∈ V ∧ topologicalKrullDim ↥V = d) →
      topologicalKrullDim X = d := by
    clear * -
    intro X _ hNeX d hX
    apply le_antisymm
    · change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds X)),
        (p.length : WithBot ℕ∞) ≤ d
      apply iSup_le
      intro p
      obtain ⟨x, hx0⟩ := (p 0).isIrreducible.nonempty
      obtain ⟨V, hxV, hVdim⟩ := hX x
      have hv_emb : Topology.IsOpenEmbedding (Subtype.val : ↥V → X) := V.isOpenEmbedding'
      let c : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V := fun i =>
        have hx_i : x ∈ (p i : Set X) := p.monotone (Fin.zero_le i) hx0
        have h_nonempty_i : ((p i : Set X) ∩ Set.range (Subtype.val : ↥V → X)).Nonempty :=
          ⟨x, hx_i, ⟨x, hxV⟩, rfl⟩
        { carrier := (Subtype.val : ↥V → X) ⁻¹' (p i : Set X)
          isIrreducible' := (p i).isIrreducible.preimage hv_emb h_nonempty_i
          isClosed' := (p i).isClosed.preimage continuous_subtype_val }
      have h_strict : ∀ i : Fin p.length, c (Fin.castSucc i) < c i.succ := by
        intro i
        have hp_lt : p (Fin.castSucc i) < p i.succ := p.step i
        have h_le : c (Fin.castSucc i) ≤ c i.succ := fun y hy =>
          (le_of_lt hp_lt) hy
        refine lt_of_le_not_ge h_le (fun h_ge => ?_)
        have h_not_sub : ¬ ((p i.succ : Set X) ⊆ (p (Fin.castSucc i) : Set X)) :=
          not_le_of_gt hp_lt
        obtain ⟨y, hy_succ, hy_not⟩ := Set.not_subset.mp h_not_sub
        have hO₁ : IsOpen ((p (Fin.castSucc i) : Set X)ᶜ) :=
          (p (Fin.castSucc i)).isClosed.isOpen_compl
        have hO₂ : IsOpen (V : Set X) := V.isOpen
        have hN₁ : ((p i.succ : Set X) ∩ (p (Fin.castSucc i) : Set X)ᶜ).Nonempty :=
          ⟨y, hy_succ, hy_not⟩
        have hN₂ : ((p i.succ : Set X) ∩ (V : Set X)).Nonempty :=
          ⟨x, p.monotone (Fin.zero_le i.succ) hx0, hxV⟩
        obtain ⟨w, hw_succ, hw_not, hw_V⟩ :=
          (p i.succ).isIrreducible.isPreirreducible _ _ hO₁ hO₂ hN₁ hN₂
        have hw_in : (⟨w, hw_V⟩ : ↥V) ∈ c i.succ := hw_succ
        exact hw_not (h_ge hw_in)
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
        { length := p.length, toFun := c, step := h_strict }
      calc (p.length : WithBot ℕ∞)
          = (q.length : WithBot ℕ∞) := rfl
        _ ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥V) :=
            Order.LTSeries.length_le_krullDim q
        _ = topologicalKrullDim ↥V := rfl
        _ = d := hVdim
    · obtain ⟨x₀⟩ := hNeX
      obtain ⟨V₀, _, hV₀⟩ := hX x₀
      calc d = topologicalKrullDim ↥V₀ := hV₀.symm
        _ = topologicalKrullDim ↥(V₀ : Set X) := rfl
        _ ≤ topologicalKrullDim X := topologicalKrullDim_subspace_le X (V₀ : Set X)

  have h_single_dom : ∀ (R K : Type u) [CommRing R] [IsDomain R] [Algebra k R]
      [Algebra.FiniteType k R] [Field K] [Algebra k K] [Algebra R K]
      [IsScalarTower k R K] [IsFractionRing R K],
      ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k K ∧
        ringKrullDim R = (s : WithBot ℕ∞) := by
    intro R K _ _ _ _ _ _ _ _ _
    have h_tr_RK_eq : Algebra.trdeg k R = Algebra.trdeg k K := by
      have : FaithfulSMul k R :=
        (faithfulSMul_iff_algebraMap_injective k R).mpr (algebraMap k R).injective
      have : FaithfulSMul R K :=
        (faithfulSMul_iff_algebraMap_injective R K).mpr (IsFractionRing.injective R K)
      have : Algebra.IsAlgebraic R K := IsLocalization.isAlgebraic K (nonZeroDivisors R)
      have h_tr_RK : Algebra.trdeg R K = 0 := trdeg_eq_zero
      have hadd := trdeg_add_eq k R (A := K)
      rw [h_tr_RK, add_zero] at hadd
      exact hadd
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k R
    let P : Type u := MvPolynomial (Fin s) k
    have h_dim_P : ringKrullDim P = (s : WithBot ℕ∞) := by
      change ringKrullDim (MvPolynomial (Fin s) k) = (s : WithBot ℕ∞)
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    let : Algebra P R := g.toRingHom.toAlgebra
    have : Algebra.IsIntegral P R := ⟨hg_int⟩
    have h_tr_kR : (s : Cardinal.{u}) = Algebra.trdeg k R := by
      have : IsScalarTower k P R := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
      have : FaithfulSMul k P :=
        (faithfulSMul_iff_algebraMap_injective k P).mpr (algebraMap k P).injective
      have : FaithfulSMul P R :=
        (faithfulSMul_iff_algebraMap_injective P R).mpr hg_inj
      have : Algebra.IsAlgebraic P R := Algebra.IsIntegral.isAlgebraic
      have h_tr_PR : Algebra.trdeg P R = 0 := trdeg_eq_zero
      have h_tr_kP : Algebra.trdeg k P = (s : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
      have hadd := trdeg_add_eq k P (A := R)
      rw [h_tr_kP, h_tr_PR, add_zero] at hadd
      exact hadd
    have h_dim_le : ringKrullDim R ≤ ringKrullDim P := by
      apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap P R))
      intro q₁ q₂ hlt
      have h_not_le : ¬ (q₂.asIdeal ≤ q₁.asIdeal) := not_le_of_gt hlt
      obtain ⟨x, hxq₂, hxq₁⟩ := Set.not_subset.mp h_not_le
      have hx_sdiff : x ∈ (q₂.asIdeal : Set R) \ (q₁.asIdeal : Set R) := ⟨hxq₂, hxq₁⟩
      have h_int_x : IsIntegral P x := Algebra.IsIntegral.isIntegral x
      have := q₁.isPrime
      exact Ideal.under_lt_under_of_integral_mem_sdiff (R := P) (le_of_lt hlt) hx_sdiff h_int_x
    have h_lift : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum P)), p.length = n →
        ∃ (q : LTSeries (PrimeSpectrum R)),
          q.length = n ∧ Ideal.under P q.last.asIdeal = p.last.asIdeal := by
      intro n
      induction n with
      | zero =>
        intro p _
        have h_bot : Ideal.under P (⊥ : Ideal R) ≤ p.last.asIdeal := by
          intro y hy
          have hy0 : g y = 0 := Ideal.mem_bot.mp hy
          have hy_eq : y = 0 := hg_inj (hy0.trans (map_zero g).symm)
          rw [hy_eq]
          exact p.last.asIdeal.zero_mem
        have := p.last.isPrime
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (R := P) (S := R)
            p.last.asIdeal (⊥ : Ideal R) h_bot
        refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, hQ₀_under⟩
      | succ n ih =>
        intro p hp_len
        let p' : LTSeries (PrimeSpectrum P) := p.eraseLast
        have hp'_len : p'.length = n := by
          rw [RelSeries.eraseLast_length, hp_len]
          omega
        have hp'_lt : p'.last < p.last :=
          p.eraseLast_last_rel_last (by omega)
        obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
        have h_le_under : Ideal.under P q'.last.asIdeal ≤ p.last.asIdeal := by
          rw [hq'_under]
          exact le_of_lt hp'_lt
        have := p.last.isPrime
        have := q'.last.isPrime
        obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (R := P) (S := R)
            p.last.asIdeal q'.last.asIdeal h_le_under
        have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum R) := by
          refine lt_of_le_not_ge hQ_ge (fun h_ge => ?_)
          have h_eq : Q_next = q'.last.asIdeal := le_antisymm h_ge hQ_ge
          have h_under_eq : p.last.asIdeal = p'.last.asIdeal := by
            rw [← hQ_under, h_eq, hq'_under]
          exact (ne_of_lt hp'_lt) (PrimeSpectrum.ext h_under_eq.symm)
        let q : LTSeries (PrimeSpectrum R) := q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q
        refine ⟨q, ?_, ?_⟩
        · rw [RelSeries.snoc_length, hq'_len]
        · rw [RelSeries.last_snoc]
          exact hQ_under
    have h_dim_ge : ringKrullDim P ≤ ringKrullDim R := by
      change ⨆ (p : LTSeries (PrimeSpectrum P)), (p.length : WithBot ℕ∞) ≤ ringKrullDim R
      apply iSup_le
      intro p
      obtain ⟨q, hq_len, _⟩ := h_lift p.length p rfl
      calc (p.length : WithBot ℕ∞)
          = (q.length : WithBot ℕ∞) := by rw [hq_len]
        _ ≤ Order.krullDim (PrimeSpectrum R) := Order.LTSeries.length_le_krullDim q
        _ = ringKrullDim R := rfl
    exact ⟨s, h_tr_kR.trans h_tr_RK_eq, (le_antisymm h_dim_le h_dim_ge).trans h_dim_P⟩

  have : AlgebraicGeometry.IsIntegral Y.left := hIntY
  have : IrreducibleSpace ↥Y.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y.left
  obtain ⟨y_ref⟩ : Nonempty ↥Y.left := IrreducibleSpace.toNonempty
  have : Nonempty ↥Y.left := ⟨y_ref⟩
  have : Nonempty ↥(⊤ : Y.left.Opens).toScheme :=
    ⟨⟨y_ref, TopologicalSpace.Opens.mem_top y_ref⟩⟩
  let K_Y : Type u := ↑Y.left.functionField
  let R_k := CommRingCat.of k
  let φ_top : R_k ⟶ Y.left.presheaf.obj (Opposite.op ⊤) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ Y.hom.appLE ⊤ ⊤ le_top
  let : Algebra k K_Y := ((Y.left.germToFunctionField ⊤).hom.comp φ_top.hom).toAlgebra
  have hSurjΓ : Function.Surjective ((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom := by
    intro y
    refine ⟨((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom).hom y, ?_⟩
    change (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom) y = y
    rw [CategoryTheory.Iso.hom_inv_id]
    rfl

  have h_aff_props : ∀ (U : Y.left.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
      (hNeU : Nonempty ↥U),
      letI : Algebra k ↑(Y.left.presheaf.obj (Opposite.op U)) :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ Y.hom.appLE ⊤ U le_top).hom).toAlgebra
      IsDomain ↑(Y.left.presheaf.obj (Opposite.op U)) ∧
      Algebra.FiniteType k ↑(Y.left.presheaf.obj (Opposite.op U)) ∧
      ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k K_Y ∧
        ringKrullDim ↑(Y.left.presheaf.obj (Opposite.op U)) = (s : WithBot ℕ∞) ∧
        topologicalKrullDim ↥U = (s : WithBot ℕ∞) := by
    intro U hAffU hNeU
    have : Nonempty ↥U.toScheme := hNeU
    let A : Type u := ↑(Y.left.presheaf.obj (Opposite.op U))
    have hDomA : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral Y.left hIntY U hNeU
    let φ_U : R_k ⟶ Y.left.presheaf.obj (Opposite.op U) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ Y.hom.appLE ⊤ U le_top
    let : Algebra k A := φ_U.hom.toAlgebra
    have hFT_appU : (Y.hom.appLE ⊤ U le_top).hom.FiniteType :=
      Y.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hAffU le_top
    have hFT_φU : φ_U.hom.FiniteType := by
      change ((Y.hom.appLE ⊤ U le_top).hom.comp
        ((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom).FiniteType
      exact RingHom.FiniteType.comp hFT_appU (RingHom.FiniteType.of_surjective _ hSurjΓ)
    have hFTA : Algebra.FiniteType k A := hFT_φU
    have h_comm_germ : Y.hom.appLE ⊤ U le_top ≫ Y.left.germToFunctionField U =
        Y.hom.appLE ⊤ ⊤ le_top ≫ Y.left.germToFunctionField ⊤ := by
      have h1 : Y.hom.appLE ⊤ ⊤ le_top ≫ Y.left.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op =
          Y.hom.appLE ⊤ U le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map Y.hom le_top (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op
      rw [← h1, CategoryTheory.Category.assoc]
      congr 1
      exact TopCat.Presheaf.germ_res Y.left.presheaf (CategoryTheory.homOfLE (le_top : U ≤ ⊤)) _ _
    have h_tower_eq : φ_U ≫ Y.left.germToFunctionField U =
        φ_top ≫ Y.left.germToFunctionField ⊤ := by
      dsimp [φ_U, φ_top]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_comm_germ]
    have : IsScalarTower k A K_Y :=
      IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h_tower_eq).symm
    have : IsFractionRing A K_Y :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y.left U hAffU
    obtain ⟨s, hs_tr, hs_ring⟩ := h_single_dom A K_Y
    let e_U := AlgebraicGeometry.Scheme.homeoOfIso hAffU.isoSpec
    have h_top_U : topologicalKrullDim ↥U = ringKrullDim A := by
      calc topologicalKrullDim ↥U
          = topologicalKrullDim ↥U.toScheme := rfl
        _ = topologicalKrullDim
              ↥(AlgebraicGeometry.Spec (Y.left.presheaf.obj (Opposite.op U))) :=
            e_U.isHomeomorph.topologicalKrullDim_eq
        _ = topologicalKrullDim (PrimeSpectrum A) := rfl
        _ = ringKrullDim A := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A
    exact ⟨hDomA, hFTA, s, hs_tr, hs_ring, h_top_U.trans hs_ring⟩

  obtain ⟨U_ref, hAff_ref, hy_ref, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top y_ref)
  obtain ⟨_, _, s₀, hs₀_tr, _, _⟩ := h_aff_props U_ref hAff_ref ⟨⟨y_ref, hy_ref⟩⟩

  have h_dim_Y_s₀ : topologicalKrullDim Y.left = (s₀ : WithBot ℕ∞) := by
    apply h_loc_dim ↥Y.left (s₀ : WithBot ℕ∞)
    intro x
    obtain ⟨U, hAffU, hxU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top x)
    obtain ⟨_, _, s, hs_tr, _, hs_top⟩ := h_aff_props U hAffU ⟨⟨x, hxU⟩⟩
    have hs_eq : s = s₀ := Nat.cast_injective (hs_tr.trans hs₀_tr.symm)
    exact ⟨U, hxU, hs_top.trans (by rw [hs_eq])⟩

  have h_s₀_eq : (s₀ : WithBot ℕ∞) = ((m + 1 : ℕ) : WithBot ℕ∞) :=
    h_dim_Y_s₀.symm.trans hDimY

  
  
  
  let S : Set Y.left := (W_reg : Set Y.left)ᶜ
  have hClosedS : IsClosed S := W_reg.isOpen.isClosed_compl

  have hCovS : ∀ x ∈ S, ∃ (U : Y.left.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      x ∈ U ∧
      ringKrullDim ↑(Y.left.presheaf.obj (Opposite.op U)) = ((m + 1 : ℕ) : WithBot ℕ∞) ∧
      ∀ (p : PrimeSpectrum ↑(Y.left.presheaf.obj (Opposite.op U))),
        p.asIdeal.height ≤ 1 → hU.fromSpec.base p ∉ S := by
    intro x _
    obtain ⟨U, hU, hxU, hIntClosedU⟩ := hNormCov x
    have hNeU : Nonempty ↥U := ⟨⟨x, hxU⟩⟩
    let A : Type u := ↑(Y.left.presheaf.obj (Opposite.op U))
    let : Algebra k A :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ Y.hom.appLE ⊤ U le_top).hom).toAlgebra
    obtain ⟨hDomA, hFTA, s, hs_tr, hs_ring, _⟩ := h_aff_props U hU hNeU
    have hs_eq : s = s₀ := Nat.cast_injective (hs_tr.trans hs₀_tr.symm)
    have hDimA : ringKrullDim A = ((m + 1 : ℕ) : WithBot ℕ∞) :=
      hs_ring.trans ((congrArg (fun n : ℕ => (n : WithBot ℕ∞)) hs_eq).trans h_s₀_eq)
    refine ⟨U, hU, hxU, hDimA, fun p hp hpS => ?_⟩
    have : IsDomain A := hDomA
    have : IsIntegrallyClosed A := hIntClosedU
    have : Algebra.FiniteType k A := hFTA
    have : p.asIdeal.IsPrime := p.isPrime
    obtain ⟨f, hf_not_mem, hf_sm⟩ := hSmHt1 (m + 1) A hDimA p.asIdeal hp
    have hBf_le : Y.left.basicOpen f ≤ W_reg := hBasicLE U hU f hf_sm
    have hp_mem_pre : p ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj (Y.left.basicOpen f) := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hU f]
      exact (PrimeSpectrum.mem_basicOpen f p).mpr hf_not_mem
    have hp_mem_Wreg : hU.fromSpec.base p ∈ W_reg := hBf_le hp_mem_pre
    exact hpS hp_mem_Wreg

  have hChainBound : ∀ (c : LTSeries (TopologicalSpace.IrreducibleCloseds ↥S)),
      c.length + 2 ≤ m + 1 := by
    intro c
    let ℓ : ℕ := c.length
    obtain ⟨z₀, hz₀⟩ := (c 0).isIrreducible.nonempty
    obtain ⟨U, hU, hz₀U, hDimA, hAvoid⟩ := hCovS z₀.1 z₀.2
    let A : Type u := ↑(Y.left.presheaf.obj (Opposite.op U))
    have hEmb : Topology.IsClosedEmbedding (Subtype.val : ↥S → Y.left) :=
      hClosedS.isClosedEmbedding_subtypeVal
    let Z_tilde : Fin (ℓ + 1) → Set Y.left :=
      fun i => (Subtype.val : ↥S → Y.left) '' (c i : Set ↥S)
    have hClZ : ∀ i : Fin (ℓ + 1), IsClosed (Z_tilde i) :=
      fun i => hEmb.isClosedMap _ (c i).isClosed
    have hIrrZ : ∀ i : Fin (ℓ + 1), IsIrreducible (Z_tilde i) :=
      fun i => (c i).isIrreducible.image Subtype.val continuous_subtype_val.continuousOn
    have hSubS : ∀ i : Fin (ℓ + 1), Z_tilde i ⊆ S := by
      intro i y hy
      rcases hy with ⟨w, _, rfl⟩
      exact w.2
    have hz₀Z : ∀ i : Fin (ℓ + 1), z₀.1 ∈ Z_tilde i :=
      fun i => ⟨z₀, c.monotone (Fin.zero_le i) hz₀, rfl⟩

    let e_U := AlgebraicGeometry.Scheme.homeoOfIso hU.isoSpec
    let V_set : Fin (ℓ + 1) → Set ↥U.toScheme :=
      fun i => (Subtype.val : ↥U.toScheme → Y.left) ⁻¹' (Z_tilde i)
    let F_set : Fin (ℓ + 1) → Set (PrimeSpectrum A) :=
      fun i => e_U '' (V_set i)
    have hClF : ∀ i : Fin (ℓ + 1), IsClosed (F_set i) := by
      intro i
      exact e_U.isClosedMap _ ((hClZ i).preimage continuous_subtype_val)
    have hIrrF : ∀ i : Fin (ℓ + 1), IsIrreducible (F_set i) := by
      intro i
      have h_ne_i : (Z_tilde i ∩ Set.range (Subtype.val : ↥U.toScheme → Y.left)).Nonempty :=
        ⟨z₀.1, hz₀Z i, ⟨z₀.1, hz₀U⟩, rfl⟩
      have hIrrV : IsIrreducible (V_set i) :=
        (hIrrZ i).preimage U.isOpenEmbedding' h_ne_i
      exact hIrrV.image e_U e_U.continuous.continuousOn

    let Q : Fin (ℓ + 1) → PrimeSpectrum A := fun i =>
      ⟨PrimeSpectrum.vanishingIdeal (F_set i),
        PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp (hIrrF i)⟩
    have hZeroF : ∀ i : Fin (ℓ + 1), PrimeSpectrum.zeroLocus (Q i).asIdeal = F_set i := by
      intro i
      change PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal (F_set i) : Set A) = F_set i
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, (hClF i).closure_eq]

    have hQ_rev : ∀ {i j : Fin (ℓ + 1)}, i < j → Q j < Q i := by
      intro i j hij
      have h_ci_lt : c i < c j := c.strictMono hij
      have h_sub_F : F_set i ⊆ F_set j := by
        intro p hp
        rcases hp with ⟨u, hu, rfl⟩
        refine ⟨u, ?_, rfl⟩
        rcases hu with ⟨y, hy, hy_eq⟩
        exact ⟨y, (le_of_lt h_ci_lt) hy, hy_eq⟩
      have hQ_le : Q j ≤ Q i := PrimeSpectrum.vanishingIdeal_anti_mono h_sub_F
      refine lt_of_le_not_ge hQ_le (fun hQ_ge => ?_)
      have hq_eq : (Q i).asIdeal = (Q j).asIdeal := le_antisymm hQ_ge hQ_le
      have hF_eq : F_set i = F_set j := by
        rw [← hZeroF i, ← hZeroF j, hq_eq]
      have hV_eq : V_set i = V_set j := (Set.image_injective.mpr e_U.injective) hF_eq
      have h_not_le : ¬ ((c j : Set ↥S) ⊆ (c i : Set ↥S)) := not_le_of_gt h_ci_lt
      obtain ⟨w, hw_j, hw_not_i⟩ := Set.not_subset.mp h_not_le
      have hw_Zj : w.1 ∈ Z_tilde j := ⟨w, hw_j, rfl⟩
      have hw_not_Zi : w.1 ∉ Z_tilde i := by
        rintro ⟨w', hw'_i, hw'_eq⟩
        exact hw_not_i (Subtype.ext hw'_eq ▸ hw'_i)
      have hN₁ : (Z_tilde j ∩ (Z_tilde i)ᶜ).Nonempty := ⟨w.1, hw_Zj, hw_not_Zi⟩
      have hN₂ : (Z_tilde j ∩ (U : Set Y.left)).Nonempty := ⟨z₀.1, hz₀Z j, hz₀U⟩
      obtain ⟨y, hy_Zj, hy_not_Zi, hy_U⟩ :=
        (hIrrZ j).isPreirreducible _ _ (hClZ i).isOpen_compl U.isOpen hN₁ hN₂
      have hy_Vj : (⟨y, hy_U⟩ : ↥U.toScheme) ∈ V_set j := hy_Zj
      rw [← hV_eq] at hy_Vj
      exact hy_not_Zi hy_Vj

    let p_rev : LTSeries (PrimeSpectrum A) :=
      { length := ℓ
        toFun := fun k => Q ⟨ℓ - k.val, by omega⟩
        step := fun k => by
          apply hQ_rev
          change ℓ - (k.val + 1) < ℓ - k.val
          omega }

    let i_top : Fin (ℓ + 1) := ⟨ℓ, Nat.lt_succ_self ℓ⟩
    have hp_head : p_rev.head = Q i_top := rfl

    have hQ_mem_F : Q i_top ∈ F_set i_top := by
      rw [← hZeroF i_top]
      change ((Q i_top).asIdeal : Set A) ⊆ (Q i_top).asIdeal
      exact Set.Subset.rfl
    rcases hQ_mem_F with ⟨u_top, hu_top, hu_eq⟩
    have hu_symm : e_U.symm (Q i_top) = u_top := by
      rw [← hu_eq, Homeomorph.symm_apply_apply]
    have h_fromSpec_Q : hU.fromSpec.base (Q i_top) = u_top.1 := by
      rw [← hu_symm, ← hU.isoSpec_inv_ι]
      rfl
    have hQ_in_S : hU.fromSpec.base (Q i_top) ∈ S := by
      rw [h_fromSpec_Q]
      exact hSubS i_top hu_top

    have hNotHt1 : ¬ ((Q i_top).asIdeal.height ≤ ((1 : ℕ) : ℕ∞)) := by
      intro hle1
      have hle1' : (Q i_top).asIdeal.height ≤ 1 := by simpa using hle1
      exact hAvoid (Q i_top) hle1' hQ_in_S

    have : (Q i_top).asIdeal.IsPrime := (Q i_top).isPrime
    rw [Ideal.height_le_iff] at hNotHt1
    push Not at hNotHt1
    obtain ⟨r₁, hr₁_prime, hr₁_lt, hr₁_ge⟩ := hNotHt1
    have : r₁.IsPrime := hr₁_prime
    have hNotHt0 : ¬ (r₁.height ≤ ((0 : ℕ) : ℕ∞)) := by
      intro hle0
      have h10 : ((1 : ℕ) : ℕ∞) ≤ ((0 : ℕ) : ℕ∞) := le_trans hr₁_ge hle0
      exact absurd (ENat.natCast_le_natCast.mp h10) (by omega)
    rw [Ideal.height_le_iff] at hNotHt0
    push Not at hNotHt0
    obtain ⟨r₀, hr₀_prime, hr₀_lt, _⟩ := hNotHt0

    let R₁ : PrimeSpectrum A := ⟨r₁, hr₁_prime⟩
    let R₀ : PrimeSpectrum A := ⟨r₀, hr₀_prime⟩
    have hR₁_lt_head : R₁ < p_rev.head := by
      rw [hp_head]
      exact hr₁_lt
    let p₁ : LTSeries (PrimeSpectrum A) := p_rev.cons R₁ hR₁_lt_head
    have hR₀_lt_head : R₀ < p₁.head := by
      rw [RelSeries.head_cons]
      exact hr₀_lt
    let p_tot : LTSeries (PrimeSpectrum A) := p₁.cons R₀ hR₀_lt_head
    have hp_tot_len : p_tot.length = ℓ + 2 := by
      change ((p_rev.cons R₁ hR₁_lt_head).cons R₀ hR₀_lt_head).length = ℓ + 2
      rw [RelSeries.cons_length, RelSeries.cons_length]
    have h_len_le : ((ℓ + 2 : ℕ) : WithBot ℕ∞) ≤ ((m + 1 : ℕ) : WithBot ℕ∞) := by
      calc ((ℓ + 2 : ℕ) : WithBot ℕ∞)
          = (p_tot.length : WithBot ℕ∞) := by rw [hp_tot_len]
        _ ≤ Order.krullDim (PrimeSpectrum A) := Order.LTSeries.length_le_krullDim p_tot
        _ = ringKrullDim A := rfl
        _ = ((m + 1 : ℕ) : WithBot ℕ∞) := hDimA
    have h_enat : ((ℓ + 2 : ℕ) : ℕ∞) ≤ ((m + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h_len_le
    exact ENat.natCast_le_natCast.mp h_enat

  refine ⟨W_reg, hSmWreg, ?_⟩
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · have hEmpty : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥S) := by
      refine ⟨fun x₀ => ?_⟩
      let c₀ : LTSeries (TopologicalSpace.IrreducibleCloseds ↥S) := RelSeries.singleton _ x₀
      have hbad : c₀.length + 2 ≤ 0 + 1 := hChainBound c₀
      change 0 + 2 ≤ 0 + 1 at hbad
      omega
    have hDimBot : topologicalKrullDim ↥S = ⊥ :=
      Order.krullDim_eq_bot_iff.mpr hEmpty
    rw [hDimBot]
    exact bot_le
  · have hDimLe : topologicalKrullDim ↥S ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
      change ⨆ (c : LTSeries (TopologicalSpace.IrreducibleCloseds ↥S)),
        (c.length : WithBot ℕ∞) ≤ ((m - 1 : ℕ) : WithBot ℕ∞)
      apply iSup_le
      intro c
      have hc : c.length + 2 ≤ m + 1 := hChainBound c
      have hc' : c.length ≤ m - 1 := by omega
      exact WithBot.coe_le_coe.mpr (ENat.natCast_le_natCast.mpr hc')
    have hAdd : topologicalKrullDim ↥S + 2 ≤ ((m - 1 : ℕ) : WithBot ℕ∞) + 2 :=
      add_le_add hDimLe le_rfl
    have hEqCast : ((m - 1 : ℕ) : WithBot ℕ∞) + 2 = ((m + 1 : ℕ) : WithBot ℕ∞) := by
      have hm_eq : m - 1 + 2 = m + 1 := by omega
      calc ((m - 1 : ℕ) : WithBot ℕ∞) + 2
          = ((m - 1 : ℕ) : WithBot ℕ∞) + ((2 : ℕ) : WithBot ℕ∞) := rfl
        _ = ((m - 1 + 2 : ℕ) : WithBot ℕ∞) := by norm_cast
        _ = ((m + 1 : ℕ) : WithBot ℕ∞) := by rw [hm_eq]
    exact hAdd.trans (le_of_eq hEqCast)

theorem weil_algClosed_projective_normalization_codim2_smooth (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ)
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV : AlgebraicGeometry.IsIntegral V.left)
    (hProjV : IsProjectiveOverField k V)
    (hDimV : topologicalKrullDim V.left = ((m + 1 : ℕ) : WithBot ℕ∞)) :
    ∃ (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ν : V_norm ⟶ V)
      (U_ν : V.left.Opens)
      (W_reg : V_norm.left.Opens),
      AlgebraicGeometry.IsIntegral V_norm.left ∧
      IsProjectiveOverField k V_norm ∧
      AlgebraicGeometry.IsProper ν.left ∧
      AlgebraicGeometry.Surjective ν.left ∧
      Nonempty U_ν ∧
      CategoryTheory.IsIso (ν.left ∣_ U_ν) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (W_reg.ι ≫ V_norm.hom) ∧
      topologicalKrullDim ↥((W_reg : Set V_norm.left)ᶜ) + 2 ≤ ((m + 1 : ℕ) : WithBot ℕ∞) :=
by
  obtain ⟨V_norm, ν, U_ν, hIntVn, hFinν, hPropν, hSurjν, hUν, hIsoν, hNormCov⟩ :=
    weil_algClosed_scheme_normalization_finite_birational k V hIntV hProjV
      (fun A _ _ _ _ K _ _ _ => weil_algClosed_finiteType_domain_integralClosure_finite k A K)
  obtain ⟨hProjVn, hDimVnEq⟩ :=
    weil_isFinite_projective_and_krullDim_over_field k ν hIntVn hIntV hProjV hFinν hSurjν
  have hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
    hDimVnEq.trans hDimV
  obtain ⟨W_reg, hSmWreg, hDimSing⟩ :=
    weil_affineNormal_scheme_codim2_smooth_open k m V_norm hIntVn hProjVn hDimVn hNormCov
      (fun d A _ _ _ _ _ hDimA p _ hp =>
        weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k d A hDimA p hp)
  exact ⟨V_norm, ν, U_ν, W_reg, hIntVn, hProjVn, hPropν, hSurjν, hUν, hIsoν, hSmWreg, hDimSing⟩

theorem weil_algClosed_dim_one_curve_fibration_m_zero (k : Type u) [Field k] [IsAlgClosed k]
    (V_norm B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral V_norm.left)
    (hProj : IsProjectiveOverField k V_norm)
    (hDim : topologicalKrullDim V_norm.left = ((0 + 1 : ℕ) : WithBot ℕ∞))
    (hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1 V_norm.hom)
    [CategoryTheory.IsIso B₀.hom]
    (f₁ : V_norm ⟶ B₀)
    (Z_closed : Set V_norm.left)
    (hClosedZ : IsClosed Z_closed)
    (hProperZ : Z_closed ≠ Set.univ) :
    IsEquidimGenSmoothCurveFibOver k f₁ (⊤ : B₀.left.Opens) ∧
    ∃ (Z₁ : AlgebraicGeometry.Scheme.{u}) (ιZ₁ : Z₁ ⟶ V_norm.left),
      AlgebraicGeometry.IsClosedImmersion ιZ₁ ∧
      AlgebraicGeometry.IsReduced Z₁ ∧
      AlgebraicGeometry.IsFinite (ιZ₁ ≫ f₁.left) ∧
      AlgebraicGeometry.Etale ((ιZ₁ ≫ f₁.left) ∣_ (⊤ : B₀.left.Opens)) ∧
      Z_closed ⊆ Set.range ιZ₁.base :=
by
  
  have : AlgebraicGeometry.IsProper V_norm.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProj
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    let f₀ := CommRingCat.ofHom (algebraMap k ↥(𝒜 0))
    have hSurj0 : Function.Surjective f₀.hom := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : Nontrivial ↥(𝒜 0) :=
      ⟨⟨⟨0, zero_mem _⟩, ⟨1, SetLike.GradedMonoid.toGradedOne.one_mem⟩,
        fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f₀) :=
      AlgebraicGeometry.isIso_SpecMap_iff.mpr ⟨f₀.hom.injective, hSurj0⟩
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance
  have : IrreducibleSpace ↥V_norm.left :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral V_norm.left hInt

  have hf₁_eq : f₁.left = V_norm.hom ≫ CategoryTheory.inv B₀.hom := by
    rw [← CategoryTheory.Over.w f₁, CategoryTheory.Category.assoc,
      CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]
  have : AlgebraicGeometry.IsProper f₁.left := by
    rw [hf₁_eq]
    infer_instance
  have hSurjf₁ : AlgebraicGeometry.Surjective f₁.left := by
    obtain ⟨x₀⟩ : Nonempty ↥V_norm.left := IrreducibleSpace.toNonempty
    refine ⟨fun b => ⟨x₀, ?_⟩⟩
    have hspec : B₀.hom.base (f₁.left.base x₀) = B₀.hom.base b := Subsingleton.elim _ _
    have hinv := congrArg (CategoryTheory.inv B₀.hom).base hspec
    change (B₀.hom ≫ CategoryTheory.inv B₀.hom).base (f₁.left.base x₀) =
      (B₀.hom ≫ CategoryTheory.inv B₀.hom).base b at hinv
    simpa [CategoryTheory.IsIso.hom_inv_id] using hinv
  have hSmf₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1 f₁.left := by
    rw [hf₁_eq]
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 V_norm.hom := hSm
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 (CategoryTheory.inv B₀.hom) :=
      inferInstance
    have h10 : AlgebraicGeometry.SmoothOfRelativeDimension (1 + 0)
        (V_norm.hom ≫ CategoryTheory.inv B₀.hom) := inferInstance
    simpa using h10
  have hSmf₁Top : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (f₁.left ∣_ (⊤ : B₀.left.Opens)) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)
      (AlgebraicGeometry.isPullback_morphismRestrict f₁.left ⊤).flip hSmf₁

  have hBotPrime : ∀ (D : Type u) [CommRing D] [IsDomain D], (⊥ : Ideal D).IsPrime :=
    fun D _ _ => ⟨bot_ne_top, fun {a b} hab => by
      rcases mul_eq_zero.mp (Ideal.mem_bot.mp hab) with rfl | rfl
      · exact Or.inl (Ideal.mem_bot.mpr rfl)
      · exact Or.inr (Ideal.mem_bot.mpr rfl)⟩

  
  have hNull_surj : ∀ (E : Type u) [Field E] [Algebra k E] [Algebra.FiniteType k E],
      Function.Surjective (algebraMap k E) := by
    intro E _ _ hFTE
    obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFTE
    let I : Ideal (MvPolynomial (Fin n) k) := RingHom.ker g
    let eQuot : (MvPolynomial (Fin n) k ⧸ I) ≃ₐ[k] E :=
      Ideal.quotientKerAlgEquivOfSurjective hg
    have hFieldQuot : IsField (MvPolynomial (Fin n) k ⧸ I) :=
      MulEquiv.isField (Field.toIsField E) eQuot.toRingEquiv.toMulEquiv
    have hMaxI : I.IsMaximal :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient I).mpr hFieldQuot
    obtain ⟨c, hcI⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hMaxI
    intro y
    obtain ⟨p, rfl⟩ := hg y
    refine ⟨MvPolynomial.aeval c p, ?_⟩
    let q : MvPolynomial (Fin n) k := p - MvPolynomial.C (MvPolynomial.aeval c p)
    have hq_mem : q ∈ I := by
      rw [hcI, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      simp [q]
    have hgq : g q = 0 := RingHom.mem_ker.mp hq_mem
    have hsub : g p - algebraMap k E (MvPolynomial.aeval c p) = 0 := by
      simpa [q, map_sub, AlgHom.commutes] using hgq
    exact (sub_eq_zero.mp hsub).symm

  
  have hAff_chart : ∀ (U : V_norm.left.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      ∃ (φ_U : CommRingCat.of k ⟶ V_norm.left.presheaf.obj (Opposite.op U))
        (eU_scheme : (U : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (V_norm.left.presheaf.obj (Opposite.op U))),
        eU_scheme.hom ≫ AlgebraicGeometry.Spec.map φ_U = U.ι ≫ V_norm.hom ∧
        φ_U.hom.FiniteType := by
    intro U hU
    let α_k : CommRingCat.of k ⟶ V_norm.left.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ V_norm.hom.appTop
    let φ_U : CommRingCat.of k ⟶ V_norm.left.presheaf.obj (Opposite.op U) :=
      α_k ≫ V_norm.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
    have : CategoryTheory.IsIso (U : AlgebraicGeometry.Scheme.{u}).toSpecΓ :=
      @AlgebraicGeometry.IsAffine.affine (U : AlgebraicGeometry.Scheme.{u}) hU
    let eU_top : AlgebraicGeometry.Spec Γ((U : AlgebraicGeometry.Scheme.{u}), ⊤) ≅
        AlgebraicGeometry.Spec (V_norm.left.presheaf.obj (Opposite.op U)) :=
      { hom := AlgebraicGeometry.Spec.map U.topIso.inv
        inv := AlgebraicGeometry.Spec.map U.topIso.hom
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.hom_inv_id,
            AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
            AlgebraicGeometry.Spec.map_id] }
    let eU_scheme : (U : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (V_norm.left.presheaf.obj (Opposite.op U)) :=
      CategoryTheory.asIso (U : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≪≫ eU_top
    have heU_hom : eU_scheme.hom =
        (U : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫ AlgebraicGeometry.Spec.map U.topIso.inv := rfl
    have hgU_eq : eU_scheme.hom ≫ AlgebraicGeometry.Spec.map φ_U = U.ι ≫ V_norm.hom := by
      have hres : V_norm.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ U.topIso.inv =
          U.ι.appTop := by
        rw [AlgebraicGeometry.Scheme.Opens.topIso_inv, AlgebraicGeometry.Scheme.Opens.ι_appTop]
        exact (V_norm.left.presheaf.map_comp _ _).symm.trans
          (congrArg V_norm.left.presheaf.map (Subsingleton.elim _ _))
      have hmap : φ_U ≫ U.topIso.inv =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (U.ι ≫ V_norm.hom).appTop := by
        have hφ_def : φ_U = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            V_norm.hom.appTop) ≫ V_norm.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op := rfl
        rw [hφ_def, CategoryTheory.Category.assoc, hres, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.Hom.comp_appTop]
      calc
        eU_scheme.hom ≫ AlgebraicGeometry.Spec.map φ_U
          = (U : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (φ_U ≫ U.topIso.inv) := by
            rw [heU_hom, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        _ = ((U : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (U.ι ≫ V_norm.hom).appTop) ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
            rw [hmap, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = (U.ι ≫ V_norm.hom) ≫ (AlgebraicGeometry.Spec (CommRingCat.of k)).toSpecΓ ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv := by
            rw [← AlgebraicGeometry.Scheme.toSpecΓ_naturality (U.ι ≫ V_norm.hom),
              CategoryTheory.Category.assoc]
        _ = U.ι ≫ V_norm.hom := by
            rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom (CommRingCat.of k),
              ← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
    have hSpec_eq : AlgebraicGeometry.Spec.map φ_U = eU_scheme.inv ≫ U.ι ≫ V_norm.hom := by
      rw [← hgU_eq, CategoryTheory.Iso.inv_hom_id_assoc]
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_U) := by
      rw [hSpec_eq]
      infer_instance
    exact ⟨φ_U, eU_scheme, hgU_eq,
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hLFT⟩

  refine ⟨?_, ?_⟩
  · 
    refine ⟨inferInstance, hSurjf₁, hSmf₁Top, ?_⟩
    intro K _ _ s
    
    let P_K := CategoryTheory.Limits.pullback f₁.left s
    let fst := CategoryTheory.Limits.pullback.fst f₁.left s
    let snd := CategoryTheory.Limits.pullback.snd f₁.left s
    let s_k := s ≫ B₀.hom
    have hp₁ : CategoryTheory.IsPullback fst snd f₁.left s :=
      CategoryTheory.IsPullback.of_hasPullback f₁.left s
    have hp_base : CategoryTheory.IsPullback (𝟙 V_norm.left) f₁.left V_norm.hom B₀.hom :=
      CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Over.w f₁]⟩
    have hPb_k : CategoryTheory.IsPullback fst snd V_norm.hom s_k := by
      simpa [s_k] using hp₁.paste_horiz hp_base

    let φ_cat : CommRingCat.of k ⟶ CommRingCat.of K :=
      (AlgebraicGeometry.Spec.fullyFaithful.preimage s_k).unop
    have hs_k_eq : AlgebraicGeometry.Spec.map φ_cat = s_k :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage s_k
    let _ : Algebra k K := φ_cat.hom.toAlgebra
    have hφ_cat_eq : CommRingCat.ofHom (algebraMap k K) = φ_cat := rfl

    
    have hTensorDomain : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A]
        [Algebra.FiniteType k A], IsDomain (TensorProduct k A K) := by
      intro A _ _ _ _
      have hEvalNonzero : ∀ (u : A), u ≠ 0 → ∃ ev : A →ₐ[k] k, ev u ≠ 0 := by
        intro u hu
        let A_u := Localization.Away u
        have hSub : Submonoid.powers u ≤ nonZeroDivisors A := by
          rintro _ ⟨m, rfl⟩
          exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m hu)
        have : IsDomain A_u := IsLocalization.isDomain_of_le_nonZeroDivisors A_u hSub
        have : Algebra.FinitePresentation A A_u :=
          IsLocalization.Away.finitePresentation u (S := A_u)
        have : Algebra.FiniteType k A_u :=
          Algebra.FiniteType.trans (S := A) inferInstance inferInstance
        obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal A_u
        let F_u := A_u ⧸ 𝔪
        let _ : Field F_u := @Ideal.Quotient.field A_u _ 𝔪 h𝔪
        have : Algebra.FiniteType A_u F_u :=
          Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ A_u 𝔪)
            (Ideal.Quotient.mkₐ_surjective A_u 𝔪)
        have : Algebra.FiniteType k F_u :=
          Algebra.FiniteType.trans (S := A_u) inferInstance inferInstance
        have hBij_Fu : Function.Bijective (Algebra.ofId k F_u) :=
          ⟨(algebraMap k F_u).injective, hNull_surj F_u⟩
        let e_Fu : F_u ≃ₐ[k] k := (AlgEquiv.ofBijective (Algebra.ofId k F_u) hBij_Fu).symm
        let ev_u : A_u →ₐ[k] k := e_Fu.toAlgHom.comp (Ideal.Quotient.mkₐ k 𝔪)
        let ev : A →ₐ[k] k := ev_u.comp (IsScalarTower.toAlgHom k A A_u)
        have hUnit_Au : IsUnit (algebraMap A A_u u) :=
          IsLocalization.Away.algebraMap_isUnit u
        have hUnit_k : IsUnit (ev u) := hUnit_Au.map ev_u.toRingHom.toMonoidHom
        exact ⟨ev, hUnit_k.ne_zero⟩
      let b := Module.Free.chooseBasis k K
      let B := Algebra.TensorProduct.basis A b
      have hΨ_coord : ∀ (ev : A →ₐ[k] k),
          let Ψ : TensorProduct k A K →ₐ[k] K :=
            Algebra.TensorProduct.lift ((Algebra.ofId k K).comp ev) (AlgHom.id k K)
              (fun _ _ => Commute.all _ _)
          ∀ (z : TensorProduct k A K) (i : Module.Free.ChooseBasisIndex k K),
            b.repr (Ψ z) i = ev (B.repr z i) := by
        intro ev Ψ z i
        suffices h_f : ∀ (f : Module.Free.ChooseBasisIndex k K →₀ A),
            b.repr (Ψ (B.repr.symm f)) i = ev (f i) by
          simpa using h_f (B.repr z)
        intro f
        refine Finsupp.induction_linear f ?_ ?_ ?_
        · simp
        · intro g₁ g₂ hg₁ hg₂
          rw [map_add, map_add, map_add, Finsupp.add_apply, Finsupp.add_apply, map_add, hg₁, hg₂]
        · intro j a
          have hsymm : B.repr.symm (Finsupp.single j a) = a ⊗ₜ[k] b j := by
            rw [Module.Basis.repr_symm_apply, Finsupp.linearCombination_single,
              Algebra.TensorProduct.basis_apply, Algebra.smul_def]
            change (a ⊗ₜ[k] (1 : K)) * (1 ⊗ₜ[k] b j) = a ⊗ₜ[k] b j
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          dsimp only [Ψ]
          rw [hsymm, Algebra.TensorProduct.lift_tmul, AlgHom.comp_apply, Algebra.ofId_apply,
            AlgHom.id_apply, ← Algebra.smul_def, map_smul, Module.Basis.repr_self,
            Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.single_apply, Finsupp.single_apply]
          split_ifs <;> simp
      obtain ⟨ev₁, _⟩ := hEvalNonzero 1 one_ne_zero
      let Ψ₁ : TensorProduct k A K →ₐ[k] K :=
        Algebra.TensorProduct.lift ((Algebra.ofId k K).comp ev₁) (AlgHom.id k K)
          (fun _ _ => Commute.all _ _)
      have : Nontrivial (TensorProduct k A K) :=
        ⟨⟨0, 1, fun h01 => (zero_ne_one : (0 : K) ≠ 1)
          (by simpa [map_zero, map_one] using congrArg Ψ₁ h01)⟩⟩
      have : NoZeroDivisors (TensorProduct k A K) :=
        ⟨fun {x y} hxy => by
          by_contra hnot
          have hx : x ≠ 0 := fun hx0 => hnot (Or.inl hx0)
          have hy : y ≠ 0 := fun hy0 => hnot (Or.inr hy0)
          have hx_repr : B.repr x ≠ 0 := fun h0 => hx (B.repr.injective (by simp [h0]))
          have hy_repr : B.repr y ≠ 0 := fun h0 => hy (B.repr.injective (by simp [h0]))
          obtain ⟨i₀, hi₀⟩ : ∃ i₀, B.repr x i₀ ≠ 0 := by
            by_contra hall
            exact hx_repr (Finsupp.ext fun i => by_contra fun hi => hall ⟨i, hi⟩)
          obtain ⟨j₀, hj₀⟩ : ∃ j₀, B.repr y j₀ ≠ 0 := by
            by_contra hall
            exact hy_repr (Finsupp.ext fun j => by_contra fun hj => hall ⟨j, hj⟩)
          obtain ⟨ev, hev⟩ := hEvalNonzero (B.repr x i₀ * B.repr y j₀) (mul_ne_zero hi₀ hj₀)
          have hev_x : ev (B.repr x i₀) ≠ 0 := fun h0 => hev (by rw [map_mul, h0, zero_mul])
          have hev_y : ev (B.repr y j₀) ≠ 0 := fun h0 => hev (by rw [map_mul, h0, mul_zero])
          let Ψ : TensorProduct k A K →ₐ[k] K :=
            Algebra.TensorProduct.lift ((Algebra.ofId k K).comp ev) (AlgHom.id k K)
              (fun _ _ => Commute.all _ _)
          have hΨx : Ψ x ≠ 0 := fun h0 => hev_x (by rw [← hΨ_coord ev x i₀, h0, map_zero]; rfl)
          have hΨy : Ψ y ≠ 0 := fun h0 => hev_y (by rw [← hΨ_coord ev y j₀, h0, map_zero]; rfl)
          exact mul_ne_zero hΨx hΨy (by rw [← map_mul, hxy, map_zero])⟩
      exact NoZeroDivisors.to_isDomain (TensorProduct k A K)

    
    have hChartInt : ∀ (U : V_norm.left.Opens),
        AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
        AlgebraicGeometry.IsIntegral (fst ⁻¹ᵁ U).toScheme ∧
        (∀ pU : ↥(fst ⁻¹ᵁ U),
          _root_.IsReduced ↑((fst ⁻¹ᵁ U).toScheme.presheaf.stalk pU)) := by
      intro U hU hneU
      obtain ⟨φ_U, eU_scheme, hgU_eq, hFT_φU⟩ := hAff_chart U hU
      let A_U : Type u := ↑(V_norm.left.presheaf.obj (Opposite.op U))
      have : IsDomain A_U :=
        @AlgebraicGeometry.IsIntegral.component_integral V_norm.left hInt U hneU
      let _ : Algebra k A_U := φ_U.hom.toAlgebra
      have : Algebra.FiniteType k A_U := hFT_φU
      have : IsDomain (TensorProduct k A_U K) := hTensorDomain A_U
      have hpU : CategoryTheory.IsPullback (fst ∣_ U) ((fst ⁻¹ᵁ U).ι ≫ snd)
          (U.ι ≫ V_norm.hom) s_k :=
        (AlgebraicGeometry.isPullback_morphismRestrict fst U).paste_vert hPb_k
      have hpU_spec : CategoryTheory.IsPullback ((fst ∣_ U) ≫ eU_scheme.hom) ((fst ⁻¹ᵁ U).ι ≫ snd)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A_U)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K))) := by
        refine hpU.of_iso (CategoryTheory.Iso.refl _) eU_scheme
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (CategoryTheory.Category.id_comp _).symm
          (CategoryTheory.Category.id_comp _).symm
          ((CategoryTheory.Category.comp_id _).trans hgU_eq.symm)
          ((CategoryTheory.Category.comp_id _).trans ?_)
        dsimp
        rw [hφ_cat_eq, hs_k_eq, CategoryTheory.Category.id_comp]
      let e_UP : (fst ⁻¹ᵁ U).toScheme ≅
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A_U K)) :=
        hpU_spec.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso k A_U K
      let R_T := CommRingCat.of (TensorProduct k A_U K)
      have : Nonempty ↥(AlgebraicGeometry.Spec R_T) :=
        ⟨(⟨⊥, hBotPrime (TensorProduct k A_U K)⟩ : PrimeSpectrum (TensorProduct k A_U K))⟩
      have : IsDomain ↑Γ(AlgebraicGeometry.Spec R_T, ⊤) :=
        MulEquiv.isDomain (TensorProduct k A_U K)
          (AlgebraicGeometry.Scheme.ΓSpecIso R_T).commRingCatIsoToRingEquiv.toMulEquiv
      have hIntSpec : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R_T) :=
        AlgebraicGeometry.isIntegral_of_isAffine_of_isDomain (AlgebraicGeometry.Spec R_T)
      have : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec R_T) := inferInstance
      have : IrreducibleSpace ↥(AlgebraicGeometry.Spec R_T) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (AlgebraicGeometry.Spec R_T)
      have : AlgebraicGeometry.IsReduced (fst ⁻¹ᵁ U).toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion e_UP.hom
      let h_homeo : ↥(AlgebraicGeometry.Spec R_T) ≃ₜ ↥(fst ⁻¹ᵁ U).toScheme :=
        TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e_UP.symm)
      have : IrreducibleSpace ↥(fst ⁻¹ᵁ U).toScheme :=
        { toNonempty := Nonempty.map h_homeo inferInstance
          isPreirreducible_univ := by
            rw [← h_homeo.surjective.range_eq, ← Set.image_univ]
            exact PreirreducibleSpace.isPreirreducible_univ.image h_homeo
              h_homeo.continuous.continuousOn }
      refine ⟨AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (fst ⁻¹ᵁ U).toScheme,
        fun pU => ?_⟩
      let Y_U := (fst ⁻¹ᵁ U).toScheme
      obtain ⟨W, hW, hpW, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y_U) (x := pU)
          (U := ⊤) trivial
      let pW : ↥W := ⟨pU, hpW⟩
      exact @isReduced_localizationPreserves ↑Γ(Y_U, W) _
        (hW.primeIdealOf pW).asIdeal.primeCompl
        ↑(Y_U.presheaf.stalk ↑pW) _
        (TopCat.Presheaf.algebra_section_stalk Y_U.presheaf pW)
        (hW.isLocalization_stalk pW) inferInstance

    
    have : ∀ p : ↥P_K, _root_.IsReduced ↑(P_K.presheaf.stalk p) := by
      intro p
      obtain ⟨U, hU, hxU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V_norm.left) (x := fst.base p)
          (U := ⊤) trivial
      let pU : ↥(fst ⁻¹ᵁ U) := ⟨p, hxU⟩
      have : _root_.IsReduced ↑((fst ⁻¹ᵁ U).toScheme.presheaf.stalk pU) :=
        (hChartInt U hU ⟨⟨fst.base p, hxU⟩⟩).2 pU
      let eStalk := (fst ⁻¹ᵁ U).stalkIso pU
      exact isReduced_of_injective eStalk.inv.hom
        ((ConcreteCategory.bijective_of_isIso eStalk.inv).1)
    have : AlgebraicGeometry.IsReduced P_K :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk P_K

    have : IrreducibleSpace ↥P_K := by
      obtain ⟨x₀⟩ : Nonempty ↥V_norm.left := IrreducibleSpace.toNonempty
      obtain ⟨U₀, hU₀, hx₀U₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V_norm.left) (x := x₀)
          (U := ⊤) trivial
      have hIntU₀ := (hChartInt U₀ hU₀ ⟨⟨x₀, hx₀U₀⟩⟩).1
      have hIrredU₀ : IrreducibleSpace ↥(fst ⁻¹ᵁ U₀) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (fst ⁻¹ᵁ U₀).toScheme
      obtain ⟨q₀⟩ : Nonempty ↥(fst ⁻¹ᵁ U₀) := IrreducibleSpace.toNonempty
      refine { toNonempty := ⟨q₀.1⟩, isPreirreducible_univ := ?_ }
      intro O₁ O₂ hO₁ hO₂ ⟨p₁, _, hp₁O₁⟩ ⟨p₂, _, hp₂O₂⟩
      obtain ⟨U₁, hU₁, hx₁U₁, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V_norm.left) (x := fst.base p₁)
          (U := ⊤) trivial
      obtain ⟨U₂, hU₂, hx₂U₂, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V_norm.left) (x := fst.base p₂)
          (U := ⊤) trivial
      obtain ⟨x₃, _, hx₃U₁, hx₃U₂⟩ :=
        PreirreducibleSpace.isPreirreducible_univ U₁.1 U₂.1 U₁.isOpen U₂.isOpen
          ⟨fst.base p₁, trivial, hx₁U₁⟩ ⟨fst.base p₂, trivial, hx₂U₂⟩
      obtain ⟨U₃, hU₃, hx₃U₃, hU₃_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V_norm.left) (x := x₃)
          (U := U₁ ⊓ U₂) ⟨hx₃U₁, hx₃U₂⟩
      have hIntU₃ := (hChartInt U₃ hU₃ ⟨⟨x₃, hx₃U₃⟩⟩).1
      have : IrreducibleSpace ↥(fst ⁻¹ᵁ U₃) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (fst ⁻¹ᵁ U₃).toScheme
      obtain ⟨q₃⟩ : Nonempty ↥(fst ⁻¹ᵁ U₃) := IrreducibleSpace.toNonempty
      have hq₃_12 : (fst.base q₃.1) ∈ (U₁ ⊓ U₂ : V_norm.left.Opens) := hU₃_sub q₃.2
      have hIntU₁ := (hChartInt U₁ hU₁ ⟨⟨fst.base p₁, hx₁U₁⟩⟩).1
      have hIrredU₁ : IrreducibleSpace ↥(fst ⁻¹ᵁ U₁) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (fst ⁻¹ᵁ U₁).toScheme
      have hPre₁ : IsPreirreducible ((fst ⁻¹ᵁ U₁ : P_K.Opens) : Set ↥P_K) := by
        have himg : (Subtype.val : ↥(fst ⁻¹ᵁ U₁) → ↥P_K) '' Set.univ =
            ((fst ⁻¹ᵁ U₁ : P_K.Opens) : Set ↥P_K) := by
          rw [Set.image_univ, Subtype.range_coe]
        rw [← himg]
        exact hIrredU₁.isPreirreducible_univ.image _ continuous_subtype_val.continuousOn
      have hIntU₂ := (hChartInt U₂ hU₂ ⟨⟨fst.base p₂, hx₂U₂⟩⟩).1
      have hIrredU₂ : IrreducibleSpace ↥(fst ⁻¹ᵁ U₂) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (fst ⁻¹ᵁ U₂).toScheme
      have hPre₂ : IsPreirreducible ((fst ⁻¹ᵁ U₂ : P_K.Opens) : Set ↥P_K) := by
        have himg : (Subtype.val : ↥(fst ⁻¹ᵁ U₂) → ↥P_K) '' Set.univ =
            ((fst ⁻¹ᵁ U₂ : P_K.Opens) : Set ↥P_K) := by
          rw [Set.image_univ, Subtype.range_coe]
        rw [← himg]
        exact hIrredU₂.isPreirreducible_univ.image _ continuous_subtype_val.continuousOn
      obtain ⟨r, _, hrO₁, hrU₂⟩ :=
        hPre₁ O₁ (fst ⁻¹ᵁ U₂).1 hO₁ (fst ⁻¹ᵁ U₂).isOpen
          ⟨p₁, hx₁U₁, hp₁O₁⟩ ⟨q₃.1, hq₃_12.1, hq₃_12.2⟩
      obtain ⟨w, _, hwO₁, hwO₂⟩ :=
        hPre₂ O₁ O₂ hO₁ hO₂ ⟨r, hrU₂, hrO₁⟩ ⟨p₂, hx₂U₂, hp₂O₂⟩
      exact ⟨w, trivial, hwO₁, hwO₂⟩

    have hIntPK : AlgebraicGeometry.IsIntegral P_K :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P_K

    
    have hSmSnd : AlgebraicGeometry.SmoothOfRelativeDimension 1 snd :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hp₁ inferInstance

    have hDimPK : topologicalKrullDim P_K = (1 : WithBot ℕ∞) := by
      obtain ⟨p₀⟩ : Nonempty ↥P_K := IrreducibleSpace.toNonempty
      have hcov : ∀ x : ↥P_K, ∃ V : P_K.Opens,
          x ∈ V ∧ topologicalKrullDim ↥V = (1 : WithBot ℕ∞) := by
        intro x
        obtain ⟨U_b, _, V, hV, hxV, e_b, hStd⟩ :=
          (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 snd).mp hSmSnd x
        have hUb_top : U_b = ⊤ := by
          ext pt
          exact ⟨fun _ => trivial, fun _ => Subsingleton.elim (snd.base x) pt ▸ e_b hxV⟩
        let e_Ub : K ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_b)) :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).symm.trans
            ((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.mapIso
              (CategoryTheory.eqToIso (congrArg Opposite.op hUb_top.symm)))).commRingCatIsoToRingEquiv
        obtain ⟨g_Ub, _, hg_Ub⟩ :=
          RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd
        let S : Type u := ↑(P_K.presheaf.obj (Opposite.op V))
        let e_poly := MvPolynomial.mapEquiv (Fin 1) e_Ub
        let g : MvPolynomial (Fin 1) K →+* S := g_Ub.comp e_poly.toRingHom
        have hg : g.Etale := RingHom.Etale.respectsIso.right g_Ub e_poly hg_Ub
        have : IsDomain S := @AlgebraicGeometry.IsIntegral.component_integral P_K hIntPK V ⟨⟨x, hxV⟩⟩
        let R₀ : Type u := MvPolynomial (Fin 1) K
        let _ : Algebra R₀ S := g.toAlgebra
        let _ : Algebra K S := (g.comp (algebraMap K R₀)).toAlgebra
        have : IsScalarTower K R₀ S := IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.Etale R₀ S := RingHom.etale_algebraMap.mp hg
        have : Algebra.FiniteType K S :=
          Algebra.FiniteType.trans (S := R₀) inferInstance inferInstance
        have : Algebra.Smooth R₀ S := inferInstance
        have : Module.Flat R₀ S := inferInstance
        have : Module.IsTorsionFree R₀ S := Module.Flat.isTorsionFree
        have : FaithfulSMul R₀ S := inferInstance
        have hInjR₀S : Function.Injective (algebraMap R₀ S) :=
          (faithfulSMul_iff_algebraMap_injective R₀ S).mp inferInstance
        let K₀ : Type u := FractionRing R₀
        let M : Submonoid S := Algebra.algebraMapSubmonoid S (nonZeroDivisors R₀)
        let B' : Type u := TensorProduct R₀ S K₀
        have : IsLocalization M B' := IsLocalization.tensor K₀ (nonZeroDivisors R₀)
        have hM : M ≤ nonZeroDivisors S := by
          rintro m ⟨r, hr, rfl⟩
          exact mem_nonZeroDivisors_of_ne_zero (fun h0 =>
            nonZeroDivisors.ne_zero hr (hInjR₀S (h0.trans (map_zero (algebraMap R₀ S)).symm)))
        have : IsDomain B' := IsLocalization.isDomain_of_le_nonZeroDivisors B' hM
        have : FaithfulSMul S B' :=
          (faithfulSMul_iff_algebraMap_injective S B').mpr (IsLocalization.injective B' hM)
        have : FaithfulSMul K S :=
          (faithfulSMul_iff_algebraMap_injective K S).mpr (RingHom.injective (algebraMap K S))
        have : IsScalarTower K S B' := inferInstance
        have : Algebra.IsAlgebraic S B' := IsLocalization.isAlgebraic B' M
        have h_trdeg_SB' : Algebra.trdeg K S = Algebra.trdeg K B' := by
          have hadd := trdeg_add_eq K S (A := B')
          rw [trdeg_eq_zero (R := S) (A := B'), add_zero] at hadd
          exact hadd
        let B_et : Type u := TensorProduct R₀ K₀ S
        let e_comm : B_et ≃ₐ[R₀] B' := Algebra.TensorProduct.comm R₀ K₀ S
        have : IsDomain B_et := MulEquiv.isDomain B' e_comm.toMulEquiv
        have h_trdeg_BB' : Algebra.trdeg K B_et = Algebra.trdeg K B' :=
          AlgEquiv.trdeg_eq (e_comm.restrictScalars K)
        have : Algebra.Etale K₀ B_et := Algebra.Etale.baseChange R₀ S K₀
        obtain ⟨I_et, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod K₀ B_et).mp inferInstance
        have : Algebra.IsAlgebraic K₀ B_et := by
          let _ : Finite I_et := hFinI
          let _ : ∀ i : I_et, Field (Ai i) := hFieldAi
          let _ : ∀ i : I_et, Algebra K₀ (Ai i) := hAlgAi
          have : ∀ i : I_et, Module.Finite K₀ (Ai i) := fun i => (hFinSep i).1
          have : Module.Finite K₀ ((i : I_et) → Ai i) := Module.Finite.pi
          have : Module.Finite K₀ B_et := Module.Finite.equiv e_prod.symm.toLinearEquiv
          have : Algebra.IsIntegral K₀ B_et := Algebra.IsIntegral.of_finite K₀ B_et
          exact Algebra.IsIntegral.isAlgebraic
        have : FaithfulSMul K₀ B_et :=
          (faithfulSMul_iff_algebraMap_injective K₀ B_et).mpr (RingHom.injective (algebraMap K₀ B_et))
        have : FaithfulSMul K K₀ :=
          (faithfulSMul_iff_algebraMap_injective K K₀).mpr (RingHom.injective (algebraMap K K₀))
        have : IsScalarTower K K₀ B_et := inferInstance
        have h_trdeg_K₀B : Algebra.trdeg K K₀ = Algebra.trdeg K B_et := by
          have hadd := trdeg_add_eq K K₀ (A := B_et)
          rw [trdeg_eq_zero (R := K₀) (A := B_et), add_zero] at hadd
          exact hadd
        have : FaithfulSMul K R₀ :=
          (faithfulSMul_iff_algebraMap_injective K R₀).mpr (RingHom.injective (algebraMap K R₀))
        have : FaithfulSMul R₀ K₀ :=
          (faithfulSMul_iff_algebraMap_injective R₀ K₀).mpr (IsFractionRing.injective R₀ K₀)
        have : Algebra.IsAlgebraic R₀ K₀ := IsLocalization.isAlgebraic K₀ (nonZeroDivisors R₀)
        have h_trdeg_R₀K₀ : Algebra.trdeg K R₀ = Algebra.trdeg K K₀ := by
          have hadd := trdeg_add_eq K R₀ (A := K₀)
          rw [trdeg_eq_zero (R := R₀) (A := K₀), add_zero] at hadd
          exact hadd
        have h_trdeg_R₀ : Algebra.trdeg K R₀ = (1 : Cardinal.{u}) := by
          rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype (Fin 1), Fintype.card_fin]
          simp
        have htrdegS : Algebra.trdeg K S = (1 : Cardinal.{u}) :=
          h_trdeg_SB'.trans (h_trdeg_BB'.symm.trans (h_trdeg_K₀B.symm.trans
            (h_trdeg_R₀K₀.symm.trans h_trdeg_R₀)))
        
        obtain ⟨r_n, g_n, hInj_n, hInt_gn⟩ := exists_integral_inj_algHom_of_fg K S
