            exact h_pow.mul ih
        simpa [e.2] using h_p Finset.univ
      simpa using (MvPolynomial.isHomogeneous_C (Fin (M₀ + 1)) (c e)).mul h_prod
    have h_dehom_eq : φ_P (HomogeneousLocalization.Away.isLocalizationElem hXμ hFc) =
        ∑ e : weilDegMonomialIdx M₀ d₀,
          algebraMap R_β S (algebraMap k R_β (c e)) *
            ∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ) := by
      rw [hu_dehom F_c hFc]
      change φ_P (MvPolynomial.aeval u_μ (weilHomogeneousPoly M₀ d₀ c)) = _
      unfold weilHomogeneousPoly
