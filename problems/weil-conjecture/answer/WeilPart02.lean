      haveI hDom_CkL : IsDomain (TensorProduct k C L) := (hAlgDom L C).1
      haveI hDom_CL : IsDomain (TensorProduct k L C) :=
        Function.Injective.isDomain e_comm.toRingHom e_comm.injective
