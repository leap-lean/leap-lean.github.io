                CommRingCat.ofHom c_hom ≫ ψ₀ V₁ hV₁α_f := rfl
            have hc_comp : CommRingCat.ofHom c_hom =
                CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) ≫
                  CommRingCat.ofHom
                    (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X α₀))) :=
              rfl
            let hom_P : AlgebraicGeometry.Proj 𝒜 ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
              AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
            have hf_w : f_X ≫ hom_P = X.hom := CategoryTheory.Over.w ι_X
            rw [hhom, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
              hSpec_sq V₁ hV₁α_f, hc_comp, AlgebraicGeometry.Spec.map_comp,
              ← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X α₀) hXα₀ zero_lt_one,
              ← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜 (MvPolynomial.X α₀) hXα₀ zero_lt_one]
            calc (f_X.resLE D_α₀ V₁ hV₁α_f ≫
                  (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X α₀) hXα₀ zero_lt_one).hom) ≫
                  (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X α₀) hXα₀ zero_lt_one ≫
                    AlgebraicGeometry.Proj.toSpecZero 𝒜) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
                = f_X.resLE D_α₀ V₁ hV₁α_f ≫
                    ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X α₀) hXα₀ zero_lt_one).hom ≫
                      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X α₀) hXα₀ zero_lt_one).inv ≫
                      D_α₀.ι) ≫
                    hom_P := by
                  rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X α₀) hXα₀ zero_lt_one]
                  simp only [hom_P, D_α₀, CategoryTheory.Category.assoc]
              _ = (f_X.resLE D_α₀ V₁ hV₁α_f ≫ D_α₀.ι) ≫ hom_P := by
                  rw [CategoryTheory.Iso.hom_inv_id_assoc, ← CategoryTheory.Category.assoc]
              _ = V₁.ι ≫ f_X ≫ hom_P := by
                  rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.assoc]
              _ = V₁.ι ≫ X.hom := by
                  rw [hf_w]
          have : CategoryTheory.IsIso V₁.toSpecΓ := by
            rw [← hAffV₁.isoSpec_hom]; infer_instance
          have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₁) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ₀ V₁ hV₁α_f).hom.comp c_hom)) :=
            (CategoryTheory.cancel_epi V₁.toSpecΓ).mp (hSpec₁.trans h1.symm)
          exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h2)
        have heval_eq :
            ∀ A : MvPolynomial (Fin N) k,
              MvPolynomial.eval₂ κ₁ x_coord A = (ψ₀ V₁ hV₁α_f).hom (Φ A) := by
          have h_hom_eq :
              MvPolynomial.eval₂Hom κ₁ x_coord = ((ψ₀ V₁ hV₁α_f).hom).comp Φ := by
            apply MvPolynomial.ringHom_ext'
            · ext r; simp [hκ₁_ψ]
            · intro m; simp [x_coord]
          intro A
          exact congrFun (congrArg DFunLike.coe h_hom_eq) A
        let W_h : X.left.Opens := X.left.basicOpen h_α₀
        let res_map : ↑(X.left.presheaf.obj (Opposite.op W_h)) →+*
            ↑(X.left.presheaf.obj (Opposite.op V₁)) :=
          (X.left.presheaf.map (CategoryTheory.homOfLE h_open.le).op).hom
        let res_inv : ↑(X.left.presheaf.obj (Opposite.op V₁)) →+*
            ↑(X.left.presheaf.obj (Opposite.op W_h)) :=
          (X.left.presheaf.map (CategoryTheory.homOfLE h_open.ge).op).hom
        have hres_id : ∀ r : ↑(X.left.presheaf.obj (Opposite.op V₁)), res_map (res_inv r) = r := by
          intro r
          have hcomp : X.left.presheaf.map (CategoryTheory.homOfLE h_open.ge).op ≫
              X.left.presheaf.map (CategoryTheory.homOfLE h_open.le).op = 𝟙 _ := by
            rw [← CategoryTheory.Functor.map_comp]
            have : (CategoryTheory.homOfLE h_open.ge).op ≫ (CategoryTheory.homOfLE h_open.le).op =
                𝟙 _ := Subsingleton.elim _ _
            rw [this, CategoryTheory.Functor.map_id]
          exact congrArg (fun f => f.hom r) hcomp
        have heval_Θ :
            ∀ A : MvPolynomial (Fin N) k,
              MvPolynomial.eval₂ κ₁ x_coord A =
                res_map (algebraMap ↑(X.left.presheaf.obj (Opposite.op X_α₀))
                  ↑(X.left.presheaf.obj (Opposite.op W_h)) (Θ A)) := by
          intro A
          rw [heval_eq]
          have hcomp :
              (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X α₀) ≫ f_X.app D_α₀) ≫
                X.left.presheaf.map (CategoryTheory.homOfLE (X.left.basicOpen_le h_α₀)).op ≫
                X.left.presheaf.map (CategoryTheory.homOfLE h_open.le).op =
                ψ₀ V₁ hV₁α_f := by
            dsimp only [ψ₀]
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, CategoryTheory.Category.assoc]
            congr 1
            rw [← CategoryTheory.Functor.map_comp, AlgebraicGeometry.Scheme.Hom.appLE_map]
          exact congrArg (fun f => f.hom (Φ A)) hcomp.symm
        have : IsLocalization.Away h_α₀ ↑(X.left.presheaf.obj (Opposite.op W_h)) :=
          hAffXα.isLocalization_basicOpen h_α₀
        refine ⟨hSpec₁, ?_, ?_, ?_⟩
        · rw [heval_Θ P_h, hP_h]
          exact (IsLocalization.Away.algebraMap_isUnit (S := ↑(X.left.presheaf.obj (Opposite.op W_h)))
            h_α₀).map res_map
        · intro r
          obtain ⟨⟨y, _, e, rfl⟩, hy_eq⟩ :=
            IsLocalization.surj (Submonoid.powers h_α₀) (res_inv r)
          dsimp only at hy_eq
          obtain ⟨A, hA⟩ := hSurjΘ y
          refine ⟨e, A, ?_⟩
          calc r * (MvPolynomial.eval₂ κ₁ x_coord P_h) ^ e
              = res_map (res_inv r) *
                  (res_map (algebraMap ↑(X.left.presheaf.obj (Opposite.op X_α₀))
                    ↑(X.left.presheaf.obj (Opposite.op W_h)) h_α₀)) ^ e := by
                rw [hres_id r, heval_Θ P_h, hP_h]
            _ = res_map (res_inv r *
                  algebraMap ↑(X.left.presheaf.obj (Opposite.op X_α₀))
                    ↑(X.left.presheaf.obj (Opposite.op W_h)) (h_α₀ ^ e)) := by
                rw [← map_pow, ← map_mul, map_pow]
            _ = res_map (algebraMap ↑(X.left.presheaf.obj (Opposite.op X_α₀))
                  ↑(X.left.presheaf.obj (Opposite.op W_h)) y) := by
                rw [hy_eq]
            _ = MvPolynomial.eval₂ κ₁ x_coord A := by
                rw [heval_Θ A, hA]
        · intro c hFc hXα hpos
          rw [hψ_eq V₁ hV₁α_f hV₁α hXα hpos]
          have hmk_eq :
              (HomogeneousLocalization.mk
                ⟨1, ⟨∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a, hFc⟩,
                  ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩ :
                HomogeneousLocalization.Away 𝒜 (MvPolynomial.X α₀)) =
              HomogeneousLocalization.mk
                ⟨1, ⟨∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a, hFc⟩,
                  ⟨MvPolynomial.X α₀, hXα₀⟩, Submonoid.mem_powers (MvPolynomial.X α₀)⟩ := rfl
          rw [hmk_eq, ← hΦLin c hFc, ← heval_eq]
          change (MvPolynomial.eval₂Hom κ₁ x_coord)
              (MvPolynomial.C (c α₀) +
                ∑ m : Fin N, MvPolynomial.C (c (α₀.succAbove m)) * MvPolynomial.X m) = _
          simp [map_add, map_sum, map_mul]
      · intro y G hG hXα hpos hyG
        rw [hψ_eq V₁ hV₁α_f hV₁α hXα hpos]
        let t : HomogeneousLocalization.NumDenSameDeg 𝒜 (Submonoid.powers (MvPolynomial.X α₀)) :=
          ⟨1, ⟨G, hG⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩
        let u : ↥D_α₀ := (f_X.resLE D_α₀ V₁ hV₁α_f).base y
        have hu_val : u.1 = ι_X.left.base y.1 := by
          change u.1 = f_X.base y.1
          rw [← AlgebraicGeometry.Scheme.Opens.ι_apply D_α₀ u,
            ← AlgebraicGeometry.Scheme.Opens.ι_apply V₁ y]
          exact congrArg (fun f => f.base y) (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι f_X hV₁α_f)
        have h_not_basic :
            (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 (MvPolynomial.X α₀)).base u ∉
              PrimeSpectrum.basicOpen (HomogeneousLocalization.mk t) := by
          have hpre := SetLike.ext_iff.mp
            (AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec_preimage_basicOpen 𝒜 t) u
          intro hmem
          have huG : u.1 ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 G := hpre.mp hmem
          exact hyG (hu_val ▸ huG)
        have h_sq_y :
            (AlgebraicGeometry.Spec.map (ψ₀ V₁ hV₁α_f)).base (V₁.toSpecΓ.base y) =
              (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 (MvPolynomial.X α₀)).base u :=
          congrArg (fun f => f.base y) (hSpec_sq V₁ hV₁α_f)
        rw [← h_sq_y] at h_not_basic
        have hprime_y : V₁.toSpecΓ.base y = hAffV₁.primeIdealOf y := rfl
        rw [hprime_y] at h_not_basic
        change PrimeSpectrum.comap (ψ₀ V₁ hV₁α_f).hom (hAffV₁.primeIdealOf y) ∉
          PrimeSpectrum.basicOpen (HomogeneousLocalization.mk t) at h_not_basic
        rw [PrimeSpectrum.mem_basicOpen, not_not] at h_not_basic
        exact h_not_basic
    · intro V hAffV hVα x hxV g hg_notMem κ hκ
      have hVα_f : V ≤ X_α₀ := hVα
      have hAffV' : AlgebraicGeometry.IsAffineOpen (X.left.basicOpen g) := hAffV.basicOpen g
      have hxV' : x ∈ X.left.basicOpen g := by
        have hmem_spec : V.toSpecΓ.base ⟨x, hxV⟩ ∈ PrimeSpectrum.basicOpen g := by
          change g ∉ (V.toSpecΓ.base ⟨x, hxV⟩).asIdeal
          exact hg_notMem
        have hpre := SetLike.ext_iff.mp (V.toSpecΓ_preimage_basicOpen g) ⟨x, hxV⟩
        exact hpre.mp hmem_spec
      have hV'α_f : X.left.basicOpen g ≤ X_α₀ := (X.left.basicOpen_le g).trans hVα_f
      have hV'α : X.left.basicOpen g ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X α₀)) := hV'α_f
      refine ⟨hAffV', hxV', hV'α, hSpec_res V g κ hκ, ?_⟩
      intro z hXα hpos
      rw [hψ_eq V hVα_f hVα hXα hpos, hψ_eq (X.left.basicOpen g) hV'α_f hV'α hXα hpos]
      exact hψ_res V hVα_f g hV'α_f z

  
  have hDetDiag :
      ∀ {A : Type u} [CommRing A] {m : ℕ} (M : Matrix (Fin (m + 1)) (Fin (m + 1)) A)
        (k₀ : Fin (m + 1)),
        (∀ i : Fin (m + 1), i ≠ k₀ → M i k₀ = 0) →
        M.det = M k₀ k₀ * (M.submatrix k₀.succAbove k₀.succAbove).det := by
    intro A _ m M k₀ hZero
    rw [Matrix.det_succ_column M k₀, Finset.sum_eq_single k₀]
    · have hsign : (-1 : A) ^ ((k₀ : ℕ) + (k₀ : ℕ)) = 1 := by
        rw [← two_mul, pow_mul, neg_one_sq, one_pow]
      rw [hsign, one_mul]
    · intro i _ hi
      rw [hZero i hi, mul_zero, zero_mul]
    · intro hk₀
      exact absurd (Finset.mem_univ k₀) hk₀

  have hAwayPres :
      ∀ {N_old N_new s : ℕ}
        (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R']
        (g : R) [IsLocalization.Away g R']
        (φ : MvPolynomial (Fin N_old) k →+* R) (hSurj : Function.Surjective φ)
        (q : Fin s → MvPolynomial (Fin N_old) k) (hKer : RingHom.ker φ = Ideal.span (Set.range q))
        (g_poly : MvPolynomial (Fin N_old) k) (hg_poly : φ g_poly = g)
        (e_fin : Fin (N_old + 1) ≃ Fin N_new) (p_slot : Fin (N_old + 1)),
        let z_new : Fin N_new := e_fin p_slot
        let ι_old : Fin N_old → Fin N_new := fun β => e_fin (p_slot.succAbove β)
        ∃ (φ' : MvPolynomial (Fin N_new) k →+* R'),
          let q' : Fin (s + 1) → MvPolynomial (Fin N_new) k :=
            Fin.snoc (fun a => MvPolynomial.rename ι_old (q a))
              (MvPolynomial.rename ι_old g_poly * MvPolynomial.X z_new - 1)
          Function.Surjective φ' ∧
          φ'.comp MvPolynomial.C = (algebraMap R R').comp (φ.comp MvPolynomial.C) ∧
          (∀ P : MvPolynomial (Fin N_old) k,
            φ' (MvPolynomial.rename ι_old P) = algebraMap R R' (φ P)) ∧
          RingHom.ker φ' = Ideal.span (Set.range q') ∧
          (∀ P : MvPolynomial (Fin N_old) k,
            MvPolynomial.pderiv z_new (MvPolynomial.rename ι_old P) = 0) ∧
          (∀ (β : Fin N_old) (P : MvPolynomial (Fin N_old) k),
            φ' (MvPolynomial.pderiv (ι_old β) (MvPolynomial.rename ι_old P)) =
              algebraMap R R' (φ (MvPolynomial.pderiv β P))) ∧
          φ' (MvPolynomial.pderiv z_new (q' (Fin.last s))) = algebraMap R R' g := by
    intro N_old N_new s R R' _ _ _ g _ φ hSurj q hKer g_poly hg_poly e_fin p_slot z_new ι_old
    have hInj_old : Function.Injective ι_old :=
      e_fin.injective.comp (Fin.succAbove_right_injective)
    let v_val : Fin N_new → R' := fun n =>
      p_slot.insertNth (α := fun _ => R') (IsLocalization.Away.invSelf (S := R') g)
        (fun β => algebraMap R R' (φ (MvPolynomial.X β))) (e_fin.symm n)
    let φ' : MvPolynomial (Fin N_new) k →+* R' :=
      MvPolynomial.eval₂Hom ((algebraMap R R').comp (φ.comp MvPolynomial.C)) v_val
    have hφ'_C : φ'.comp MvPolynomial.C = (algebraMap R R').comp (φ.comp MvPolynomial.C) :=
      RingHom.ext fun c => MvPolynomial.eval₂Hom_C _ _ c
    have hφ'_z : φ' (MvPolynomial.X z_new) = IsLocalization.Away.invSelf (S := R') g := by
      change (MvPolynomial.eval₂Hom _ v_val) (MvPolynomial.X z_new) = _
      rw [MvPolynomial.eval₂Hom_X']
      dsimp [v_val, z_new]
      rw [Equiv.symm_apply_apply, Fin.insertNth_apply_same]
    have hφ'_old_X : ∀ β : Fin N_old,
        φ' (MvPolynomial.X (ι_old β)) = algebraMap R R' (φ (MvPolynomial.X β)) := by
      intro β
      change (MvPolynomial.eval₂Hom _ v_val) (MvPolynomial.X (ι_old β)) = _
      rw [MvPolynomial.eval₂Hom_X']
      dsimp [v_val, ι_old]
      rw [Equiv.symm_apply_apply, Fin.insertNth_apply_succAbove]
    have hφ'_ren : ∀ P : MvPolynomial (Fin N_old) k,
        φ' (MvPolynomial.rename ι_old P) = algebraMap R R' (φ P) := by
      have h_hom : φ'.comp (MvPolynomial.rename ι_old).toRingHom = (algebraMap R R').comp φ := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
            MvPolynomial.rename_C]
          exact congrFun (congrArg DFunLike.coe hφ'_C) c
        · intro β
          simp [hφ'_old_X]
      intro P
      exact congrFun (congrArg DFunLike.coe h_hom) P
    let q' : Fin (s + 1) → MvPolynomial (Fin N_new) k :=
      Fin.snoc (fun a => MvPolynomial.rename ι_old (q a))
        (MvPolynomial.rename ι_old g_poly * MvPolynomial.X z_new - 1)
    have hSurj' : Function.Surjective φ' := by
      intro r'
      obtain ⟨⟨y, _, e, rfl⟩, hy_eq⟩ := IsLocalization.surj (Submonoid.powers g) r'
      obtain ⟨Y, rfl⟩ := hSurj y
      refine ⟨MvPolynomial.rename ι_old Y * MvPolynomial.X z_new ^ e, ?_⟩
      rw [map_mul, map_pow, hφ'_ren, hφ'_z, ← hy_eq, mul_assoc, map_pow, ← mul_pow,
        IsLocalization.Away.mul_invSelf, one_pow, mul_one]
    have hI_le : Ideal.span (Set.range q') ≤ RingHom.ker φ' := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      change φ' (q' i) = 0
      revert i
      refine Fin.lastCases ?_ (fun a => ?_)
      · simp only [q', Fin.snoc_last, map_sub, map_mul, map_one, hφ'_ren, hg_poly, hφ'_z,
          IsLocalization.Away.mul_invSelf, sub_self]
      · simp only [q', Fin.snoc_castSucc, hφ'_ren]
        have hqa : q a ∈ RingHom.ker φ := by
          rw [hKer]; exact Ideal.subset_span ⟨a, rfl⟩
        rw [RingHom.mem_ker.mp hqa, map_zero]
    have hKer_le : RingHom.ker φ' ≤ Ideal.span (Set.range q') := by
      let I' := Ideal.span (Set.range q')
      let mkQ := Ideal.Quotient.mk I'
      let G := MvPolynomial.rename ι_old g_poly
      let Z := (MvPolynomial.X z_new : MvPolynomial (Fin N_new) k)
      have hGZ : mkQ G * mkQ Z = 1 := by
        have hmem : G * Z - 1 ∈ I' := Ideal.subset_span ⟨Fin.last s, by simp [q', G, Z]⟩
        have h0 : mkQ (G * Z - 1) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
        rw [map_sub, map_mul, map_one, sub_eq_zero] at h0
        exact h0
      have hClear : ∀ F : MvPolynomial (Fin N_new) k,
          ∃ (D : ℕ) (P : MvPolynomial (Fin N_old) k),
            mkQ F * (mkQ G) ^ D = mkQ (MvPolynomial.rename ι_old P) := by
        intro F
        refine MvPolynomial.induction_on
          (motive := fun F => ∃ (D : ℕ) (P : MvPolynomial (Fin N_old) k),
            mkQ F * (mkQ G) ^ D = mkQ (MvPolynomial.rename ι_old P)) F ?_ ?_ ?_
        · intro c
          exact ⟨0, MvPolynomial.C c, by simp⟩
        · rintro f₁ f₂ ⟨D₁, P₁, h₁⟩ ⟨D₂, P₂, h₂⟩
          refine ⟨D₁ + D₂, P₁ * g_poly ^ D₂ + P₂ * g_poly ^ D₁, ?_⟩
          have hG_def : ∀ m : ℕ, (mkQ G) ^ m = mkQ (MvPolynomial.rename ι_old (g_poly ^ m)) :=
            fun m => by simp [G]
          calc mkQ (f₁ + f₂) * (mkQ G) ^ (D₁ + D₂)
              = (mkQ f₁ * (mkQ G) ^ D₁) * (mkQ G) ^ D₂ +
                  (mkQ f₂ * (mkQ G) ^ D₂) * (mkQ G) ^ D₁ := by
                rw [map_add, add_mul, pow_add]
                ring
            _ = mkQ (MvPolynomial.rename ι_old P₁) * mkQ (MvPolynomial.rename ι_old (g_poly ^ D₂)) +
                  mkQ (MvPolynomial.rename ι_old P₂) * mkQ (MvPolynomial.rename ι_old (g_poly ^ D₁)) := by
                rw [h₁, h₂, hG_def D₂, hG_def D₁]
            _ = mkQ (MvPolynomial.rename ι_old (P₁ * g_poly ^ D₂ + P₂ * g_poly ^ D₁)) := by
                simp [map_add, map_mul]
        · rintro f n ⟨D, P, hf⟩
          have hn_eq : e_fin (e_fin.symm n) = n := e_fin.apply_symm_apply n
          rcases Fin.eq_self_or_eq_succAbove p_slot (e_fin.symm n) with h_eq | ⟨β, h_succ⟩
          · have hn_z : n = z_new := by rw [← hn_eq, h_eq]
            rw [hn_z]
            refine ⟨D + 1, P, ?_⟩
            calc mkQ (f * MvPolynomial.X z_new) * (mkQ G) ^ (D + 1)
                = (mkQ f * (mkQ G) ^ D) * (mkQ G * mkQ Z) := by
                  rw [map_mul, pow_succ]
                  dsimp [Z]
                  ring
              _ = mkQ (MvPolynomial.rename ι_old P) := by
                  rw [hf, hGZ, mul_one]
          · have hn_old : n = ι_old β := by rw [← hn_eq, h_succ]
            rw [hn_old]
            refine ⟨D, P * MvPolynomial.X β, ?_⟩
            calc mkQ (f * MvPolynomial.X (ι_old β)) * (mkQ G) ^ D
                = (mkQ f * (mkQ G) ^ D) * mkQ (MvPolynomial.rename ι_old (MvPolynomial.X β)) := by
                  rw [map_mul, MvPolynomial.rename_X]
                  ring
              _ = mkQ (MvPolynomial.rename ι_old (P * MvPolynomial.X β)) := by
                  rw [hf, map_mul, map_mul]
      let φ'_lift : (MvPolynomial (Fin N_new) k ⧸ I') →+* R' :=
        Ideal.Quotient.lift I' φ' (fun x hx => RingHom.mem_ker.mp (hI_le hx))
      intro F hF
      obtain ⟨D, P, hDP⟩ := hClear F
      have h_eval_zero : algebraMap R R' (φ P) = 0 := by
        have h1 := congrArg φ'_lift hDP
        rw [map_mul, map_pow] at h1
        change φ' F * (φ' G) ^ D = φ' (MvPolynomial.rename ι_old P) at h1
        rw [RingHom.mem_ker.mp hF, zero_mul, hφ'_ren] at h1
        exact h1.symm
      obtain ⟨⟨_, m, rfl⟩, hm_zero⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers g) R' (φ P)).mp h_eval_zero
      have hgm_ker : g_poly ^ m * P ∈ Ideal.span (Set.range q) := by
        rw [← hKer, RingHom.mem_ker, map_mul, map_pow, hg_poly]
        exact hm_zero
      have hren_le : Ideal.map (MvPolynomial.rename ι_old).toRingHom (Ideal.span (Set.range q)) ≤ I' := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
        exact Ideal.subset_span ⟨a.castSucc, by simp [q']⟩
      have hgm_I' : MvPolynomial.rename ι_old (g_poly ^ m * P) ∈ I' :=
        hren_le (Ideal.mem_map_of_mem _ hgm_ker)
      have hgm_Q : (mkQ G) ^ m * mkQ (MvPolynomial.rename ι_old P) = 0 := by
        have h0 : mkQ (MvPolynomial.rename ι_old (g_poly ^ m * P)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hgm_I'
        simpa [G, map_mul, map_pow] using h0
      have hFG_zero : mkQ F * (mkQ G) ^ (D + m) = 0 := by
        calc mkQ F * (mkQ G) ^ (D + m)
            = (mkQ G) ^ m * (mkQ F * (mkQ G) ^ D) := by rw [pow_add]; ring
          _ = (mkQ G) ^ m * mkQ (MvPolynomial.rename ι_old P) := by rw [hDP]
          _ = 0 := hgm_Q
      have hF_Q : mkQ F = 0 := by
        calc mkQ F
            = mkQ F * (mkQ G * mkQ Z) ^ (D + m) := by rw [hGZ, one_pow, mul_one]
          _ = (mkQ F * (mkQ G) ^ (D + m)) * (mkQ Z) ^ (D + m) := by rw [mul_pow, mul_assoc]
          _ = 0 := by rw [hFG_zero, zero_mul]
      exact Ideal.Quotient.eq_zero_iff_mem.mp hF_Q
    have hpderiv_z : ∀ P : MvPolynomial (Fin N_old) k,
        MvPolynomial.pderiv z_new (MvPolynomial.rename ι_old P) = 0 := by
      intro P
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro hz_mem
      have hz_img := MvPolynomial.vars_rename ι_old P hz_mem
      rw [Finset.mem_image] at hz_img
      obtain ⟨β, _, hβ_eq⟩ := hz_img
      exact Fin.succAbove_ne p_slot β (e_fin.injective hβ_eq)
    have hpderiv_old : ∀ (β : Fin N_old) (P : MvPolynomial (Fin N_old) k),
        φ' (MvPolynomial.pderiv (ι_old β) (MvPolynomial.rename ι_old P)) =
          algebraMap R R' (φ (MvPolynomial.pderiv β P)) := by
      intro β P
      rw [MvPolynomial.pderiv_rename hInj_old β P, hφ'_ren]
    have hpderiv_last :
        φ' (MvPolynomial.pderiv z_new (q' (Fin.last s))) = algebraMap R R' g := by
      simp only [q', Fin.snoc_last, map_sub, MvPolynomial.pderiv_one, sub_zero,
        MvPolynomial.pderiv_mul, hpderiv_z g_poly, zero_mul, zero_add,
        MvPolynomial.pderiv_X_self, mul_one, hφ'_ren, hg_poly]
    exact ⟨φ', hSurj', hφ'_C, hφ'_ren, le_antisymm hKer_le hI_le, hpderiv_z, hpderiv_old,
      hpderiv_last⟩

  have hMod3 :
      ∀ (s₀ : ℕ)
        (R₀ R₁ : Type u) [CommRing R₀] [CommRing R₁] [Algebra R₀ R₁]
        (g₀ : R₀) [IsLocalization.Away g₀ R₁]
        (φ₀ : MvPolynomial (Fin (s₀ + ν + d)) k →+* R₀),
      Function.Surjective φ₀ →
      ∀ (q₀ : Fin s₀ → MvPolynomial (Fin (s₀ + ν + d)) k),
      RingHom.ker φ₀ = Ideal.span (Set.range q₀) →
      ∀ (f_lift₀ : Fin ν → MvPolynomial (Fin (s₀ + ν + d)) k)
        (idx₀ : Fin (s₀ + ν) → Fin (s₀ + ν + d)),
      Function.Injective idx₀ →
      IsUnit (Matrix.det (Matrix.of fun a b : Fin s₀ =>
        φ₀ (MvPolynomial.pderiv (idx₀ (Fin.castAdd ν b)) (q₀ a)))) →
      IsUnit (Matrix.det (Matrix.of fun a b : Fin (s₀ + ν) =>
        φ₀ (MvPolynomial.pderiv (idx₀ b) (Fin.addCases q₀ f_lift₀ a)))) →
      ∃ (φ₁ : MvPolynomial (Fin ((s₀ + 1) + ν + d)) k →+* R₁)
        (q₁ : Fin (s₀ + 1) → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
        (f_lift₁ : Fin ν → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k),
        Function.Surjective φ₁ ∧
        φ₁.comp MvPolynomial.C = (algebraMap R₀ R₁).comp (φ₀.comp MvPolynomial.C) ∧
        RingHom.ker φ₁ = Ideal.span (Set.range q₁) ∧
        (∀ j : Fin ν, φ₁ (f_lift₁ j) = algebraMap R₀ R₁ (φ₀ (f_lift₀ j))) ∧
        IsUnit (Matrix.det (Matrix.of fun a b : Fin (s₀ + 1) =>
          φ₁ (MvPolynomial.pderiv (Fin.castAdd d (Fin.castAdd ν b)) (q₁ a)))) ∧
        IsUnit (Matrix.det (Matrix.of fun a b : Fin ((s₀ + 1) + ν) =>
          φ₁ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q₁ f_lift₁ a)))) := by
    intro s₀ R₀ R₁ _ _ _ g₀ _ φ₀ hSurj₀ q₀ hKer₀ f_lift₀ idx₀ hInj₀ hDet3₀ hDet4₀
    let S_im : Finset (Fin (s₀ + ν + d)) := Finset.univ.image idx₀
    have hcard_compl : (S_imᶜ).card = d := by
      rw [Finset.card_compl, Fintype.card_fin, Finset.card_image_of_injective _ hInj₀,
        Finset.card_fin]
      omega
    let e_compl : Fin d ≃ ↥(S_imᶜ) :=
      (finCongr hcard_compl.symm).trans (S_imᶜ).equivFin.symm
    let σ₀_fn : Fin (s₀ + ν + d) → Fin (s₀ + ν + d) :=
      Fin.addCases idx₀ (fun γ => (e_compl γ).1)
    have hInj_σ₀ : Function.Injective σ₀_fn := by
      refine Fin.addCases (fun b₁ => Fin.addCases (fun b₂ h => ?_) (fun γ₂ h => ?_))
        (fun γ₁ => Fin.addCases (fun b₂ h => ?_) (fun γ₂ h => ?_))
      · simp only [σ₀_fn, Fin.addCases_left] at h
        exact congrArg (Fin.castAdd d) (hInj₀ h)
      · simp only [σ₀_fn, Fin.addCases_left, Fin.addCases_right] at h
        have hmem : idx₀ b₁ ∈ S_im := Finset.mem_image_of_mem idx₀ (Finset.mem_univ b₁)
        rw [h] at hmem
        exact absurd hmem (Finset.mem_compl.mp (e_compl γ₂).2)
      · simp only [σ₀_fn, Fin.addCases_left, Fin.addCases_right] at h
        have hmem : idx₀ b₂ ∈ S_im := Finset.mem_image_of_mem idx₀ (Finset.mem_univ b₂)
        rw [← h] at hmem
        exact absurd hmem (Finset.mem_compl.mp (e_compl γ₁).2)
      · simp only [σ₀_fn, Fin.addCases_right] at h
        exact congrArg (Fin.natAdd (s₀ + ν)) (e_compl.injective (Subtype.ext h))
    let σ₀ : Fin (s₀ + ν + d) ≃ Fin (s₀ + ν + d) :=
      Equiv.ofBijective σ₀_fn (Finite.injective_iff_bijective.mp hInj_σ₀)
    have hσ₀_cast : ∀ b : Fin (s₀ + ν), σ₀ (Fin.castAdd d b) = idx₀ b := by
      intro b
      change σ₀_fn (Fin.castAdd d b) = idx₀ b
      exact Fin.addCases_left b
    let e_poly : MvPolynomial (Fin (s₀ + ν + d)) k ≃+* MvPolynomial (Fin (s₀ + ν + d)) k :=
      (MvPolynomial.renameEquiv k σ₀).toRingEquiv
    let φ0_n : MvPolynomial (Fin (s₀ + ν + d)) k →+* R₀ := φ₀.comp e_poly.toRingHom
    let q0_n : Fin s₀ → MvPolynomial (Fin (s₀ + ν + d)) k := fun a => e_poly.symm (q₀ a)
    let f0_n : Fin ν → MvPolynomial (Fin (s₀ + ν + d)) k := fun j => e_poly.symm (f_lift₀ j)
    have hSurj_φ0n : Function.Surjective φ0_n := hSurj₀.comp e_poly.surjective
    have hφ0n_C : φ0_n.comp MvPolynomial.C = φ₀.comp MvPolynomial.C := by
      ext c; simp [φ0_n, e_poly]
    have hKer_φ0n : RingHom.ker φ0_n = Ideal.span (Set.range q0_n) := by
      have h1 : RingHom.ker φ0_n = Ideal.map e_poly.symm.toRingHom (RingHom.ker φ₀) := by
        ext P
        simp only [φ0_n, RingHom.mem_ker, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe]
        refine ⟨fun h => ?_, fun h => ?_⟩
        · rw [← e_poly.symm_apply_apply P]
          exact Ideal.mem_map_of_mem _ h
        · obtain ⟨Q, hQ, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ e_poly.symm.surjective).mp h
          simpa using hQ
      rw [h1, hKer₀, Ideal.map_span]
      congr 1
      ext P
      simp [q0_n]
    have hpderiv_norm :
        ∀ (b : Fin (s₀ + ν)) (P : MvPolynomial (Fin (s₀ + ν + d)) k),
          φ0_n (MvPolynomial.pderiv (Fin.castAdd d b) (e_poly.symm P)) =
            φ₀ (MvPolynomial.pderiv (idx₀ b) P) := by
      intro b P
      dsimp [φ0_n, e_poly]
      change φ₀ (MvPolynomial.rename σ₀
        (MvPolynomial.pderiv (Fin.castAdd d b) (MvPolynomial.rename σ₀.symm P))) = _
      rw [← MvPolynomial.pderiv_rename σ₀.injective (Fin.castAdd d b), hσ₀_cast,
        MvPolynomial.rename_rename, σ₀.self_comp_symm, MvPolynomial.rename_id_apply]
    obtain ⟨g0_n, hg0_n⟩ := hSurj_φ0n g₀
    let e_fin : Fin ((s₀ + ν + d) + 1) ≃ Fin ((s₀ + 1) + ν + d) := finCongr (by omega)
    let z_slot : Fin ((s₀ + 1) + ν + d) := Fin.castAdd d (Fin.castAdd ν (Fin.last s₀))
    let p_slot : Fin ((s₀ + ν + d) + 1) := e_fin.symm z_slot
    obtain ⟨φ₁, hSurj₁, hφ₁_C, hφ₁_ren, hKer₁, hpderiv_z, hpderiv_old, hpderiv_last⟩ :=
      hAwayPres R₀ R₁ g₀ φ0_n hSurj_φ0n q0_n hKer_φ0n g0_n hg0_n e_fin p_slot
    let ι_old : Fin (s₀ + ν + d) → Fin ((s₀ + 1) + ν + d) := fun β => e_fin (p_slot.succAbove β)
    let q₁ : Fin (s₀ + 1) → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k :=
      Fin.snoc (fun a => MvPolynomial.rename ι_old (q0_n a))
        (MvPolynomial.rename ι_old g0_n * MvPolynomial.X (e_fin p_slot) - 1)
    let f_lift₁ : Fin ν → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k :=
      fun j => MvPolynomial.rename ι_old (f0_n j)
    have hz_eq : e_fin p_slot = z_slot := e_fin.apply_symm_apply z_slot
    have hp_val : (p_slot : ℕ) = s₀ := by
      change (z_slot : ℕ) = s₀
      simp [z_slot]
    have hι_lt : ∀ β : Fin (s₀ + ν + d), (β : ℕ) < s₀ → (ι_old β : ℕ) = (β : ℕ) := by
      intro β hβ
      change ((p_slot.succAbove β) : ℕ) = (β : ℕ)
      have hlt : β.castSucc < p_slot := Fin.lt_def.mpr (by simpa [hp_val] using hβ)
      rw [Fin.succAbove_of_castSucc_lt p_slot β hlt]
      rfl
    have hι_ge : ∀ β : Fin (s₀ + ν + d), s₀ ≤ (β : ℕ) → (ι_old β : ℕ) = (β : ℕ) + 1 := by
      intro β hβ
      change ((p_slot.succAbove β) : ℕ) = (β : ℕ) + 1
      have hle : p_slot ≤ β.castSucc := Fin.le_def.mpr (by simpa [hp_val] using hβ)
      rw [Fin.succAbove_of_le_castSucc p_slot β hle]
      rfl
    refine ⟨φ₁, q₁, f_lift₁, hSurj₁, by rw [hφ₁_C, hφ0n_C], hKer₁, ?_, ?_, ?_⟩
    · intro j
      dsimp only [f_lift₁, f0_n]
      rw [hφ₁_ren]
      dsimp only [φ0_n]
      exact congrArg (algebraMap R₀ R₁ ∘ φ₀) (e_poly.apply_symm_apply (f_lift₀ j))
    · let M₃ := Matrix.of fun a b : Fin (s₀ + 1) =>
        φ₁ (MvPolynomial.pderiv (Fin.castAdd d (Fin.castAdd ν b)) (q₁ a))
      change IsUnit M₃.det
      rw [hDetDiag M₃ (Fin.last s₀) (by
        intro a ha
        obtain ⟨a₀, rfl⟩ := Fin.exists_castSucc_eq.mpr ha
        dsimp only [M₃, Matrix.of_apply, q₁]
        rw [Fin.snoc_castSucc,
          show Fin.castAdd d (Fin.castAdd ν (Fin.last s₀)) = e_fin p_slot from hz_eq.symm,
          hpderiv_z, map_zero])]
      have h_diag : M₃ (Fin.last s₀) (Fin.last s₀) = algebraMap R₀ R₁ g₀ := by
        dsimp only [M₃, Matrix.of_apply]
        rw [show Fin.castAdd d (Fin.castAdd ν (Fin.last s₀)) = e_fin p_slot from hz_eq.symm]
        exact hpderiv_last
      have h_sub : M₃.submatrix (Fin.last s₀).succAbove (Fin.last s₀).succAbove =
          (algebraMap R₀ R₁).mapMatrix (Matrix.of fun a b : Fin s₀ =>
            φ₀ (MvPolynomial.pderiv (idx₀ (Fin.castAdd ν b)) (q₀ a))) := by
        ext a₀ b₀
        simp only [M₃, Matrix.submatrix_apply, Fin.succAbove_last, Matrix.of_apply,
          RingHom.mapMatrix_apply, Matrix.map_apply, q₁, Fin.snoc_castSucc]
        have hcol : Fin.castAdd d (Fin.castAdd ν b₀.castSucc) =
            ι_old (Fin.castAdd d (Fin.castAdd ν b₀)) := by
          apply Fin.ext
          rw [hι_lt _ (by simp)]
          simp
        rw [hcol, hpderiv_old, hpderiv_norm]
      rw [h_diag, h_sub, ← RingHom.map_det]
      exact (IsLocalization.Away.algebraMap_isUnit (S := R₁) g₀).mul (hDet3₀.map (algebraMap R₀ R₁))
    · let M₄ := Matrix.of fun a b : Fin ((s₀ + 1) + ν) =>
        φ₁ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q₁ f_lift₁ a))
      change IsUnit M₄.det
      let e₄ : Fin ((s₀ + 1) + ν) ≃ Fin ((s₀ + ν) + 1) := finCongr (by omega)
      let M₄' := Matrix.reindex e₄ e₄ M₄
      rw [← Matrix.det_reindex_self e₄ M₄]
      let j_slot : Fin ((s₀ + ν) + 1) := e₄ (Fin.castAdd ν (Fin.last s₀))
      have hj_val : (j_slot : ℕ) = s₀ := by simp [j_slot, e₄]
      have hj_symm : e₄.symm j_slot = Fin.castAdd ν (Fin.last s₀) :=
        e₄.symm_apply_apply _
      have hrow_succ :
          ∀ i₀ : Fin (s₀ + ν),
            Fin.addCases q₁ f_lift₁ (e₄.symm (j_slot.succAbove i₀)) =
              MvPolynomial.rename ι_old (Fin.addCases q0_n f0_n i₀) := by
        refine Fin.addCases (fun a₀ => ?_) (fun j => ?_)
        · have h_idx : e₄.symm (j_slot.succAbove (Fin.castAdd ν a₀)) =
              Fin.castAdd ν a₀.castSucc := by
            apply Fin.ext
            have hlt : (Fin.castAdd ν a₀).castSucc < j_slot :=
              Fin.lt_def.mpr (by simp [hj_val])
            change ((j_slot.succAbove (Fin.castAdd ν a₀)) : ℕ) = (a₀ : ℕ)
            rw [Fin.succAbove_of_castSucc_lt _ _ hlt]
            rfl
          rw [h_idx]
          simp [q₁]
        · have h_idx : e₄.symm (j_slot.succAbove (Fin.natAdd s₀ j)) =
              Fin.natAdd (s₀ + 1) j := by
            apply Fin.ext
            have hle : j_slot ≤ (Fin.natAdd s₀ j).castSucc :=
              Fin.le_def.mpr (by simp [hj_val])
            change ((j_slot.succAbove (Fin.natAdd s₀ j)) : ℕ) = s₀ + 1 + (j : ℕ)
            rw [Fin.succAbove_of_le_castSucc _ _ hle]
            simp [Nat.add_right_comm, Nat.add_assoc]
          rw [h_idx]
          simp [f_lift₁]
      have hcol_succ :
          ∀ b₀ : Fin (s₀ + ν),
            Fin.castAdd d (e₄.symm (j_slot.succAbove b₀)) = ι_old (Fin.castAdd d b₀) := by
        refine Fin.addCases (fun a₀ => ?_) (fun j => ?_)
        · apply Fin.ext
          have hlt : (Fin.castAdd ν a₀).castSucc < j_slot :=
            Fin.lt_def.mpr (by simp [hj_val])
          rw [hι_lt _ (by simp)]
          change ((j_slot.succAbove (Fin.castAdd ν a₀)) : ℕ) = (a₀ : ℕ)
          rw [Fin.succAbove_of_castSucc_lt _ _ hlt]
          rfl
        · apply Fin.ext
          have hle : j_slot ≤ (Fin.natAdd s₀ j).castSucc :=
            Fin.le_def.mpr (by simp [hj_val])
          rw [hι_ge _ (by simp)]
          change ((j_slot.succAbove (Fin.natAdd s₀ j)) : ℕ) = s₀ + (j : ℕ) + 1
          rw [Fin.succAbove_of_le_castSucc _ _ hle]
          rfl
      rw [hDetDiag M₄' j_slot (by
        intro i hi
        obtain ⟨i₀, rfl⟩ := Fin.exists_succAbove_eq hi
        simp only [M₄', Matrix.reindex_apply, Matrix.submatrix_apply, M₄, Matrix.of_apply,
          hj_symm, hrow_succ]
        rw [show Fin.castAdd d (Fin.castAdd ν (Fin.last s₀)) = e_fin p_slot from hz_eq.symm,
          hpderiv_z, map_zero])]
      have h_diag4 : M₄' j_slot j_slot = algebraMap R₀ R₁ g₀ := by
        simp only [M₄', Matrix.reindex_apply, Matrix.submatrix_apply, M₄, Matrix.of_apply,
          hj_symm, Fin.addCases_left]
        rw [show Fin.castAdd d (Fin.castAdd ν (Fin.last s₀)) = e_fin p_slot from hz_eq.symm]
        exact hpderiv_last
      have h_sub4 : M₄'.submatrix j_slot.succAbove j_slot.succAbove =
          (algebraMap R₀ R₁).mapMatrix (Matrix.of fun a b : Fin (s₀ + ν) =>
            φ₀ (MvPolynomial.pderiv (idx₀ b) (Fin.addCases q₀ f_lift₀ a))) := by
        ext a₀ b₀
        simp only [M₄', Matrix.reindex_apply, Matrix.submatrix_apply, M₄, Matrix.of_apply,
          hrow_succ, hcol_succ, RingHom.mapMatrix_apply, Matrix.map_apply]
        have hadd_norm : Fin.addCases q0_n f0_n a₀ = e_poly.symm (Fin.addCases q₀ f_lift₀ a₀) := by
          revert a₀
          refine Fin.addCases (fun a => by simp [q0_n]) (fun j => by simp [f0_n])
        rw [hpderiv_old, hadd_norm, hpderiv_norm]
      rw [h_diag4, h_sub4, ← RingHom.map_det]
      exact (IsLocalization.Away.algebraMap_isUnit (S := R₁) g₀).mul (hDet4₀.map (algebraMap R₀ R₁))

  have hMod4 :
      1 ≤ d →
      ∀ (s : ℕ) (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R']
        (φ : MvPolynomial (Fin (s + ν + d)) k →+* R),
      Function.Surjective φ →
      ∀ (q : Fin s → MvPolynomial (Fin (s + ν + d)) k),
      RingHom.ker φ = Ideal.span (Set.range q) →
      ∀ (f_lift : Fin ν → MvPolynomial (Fin (s + ν + d)) k)
        (f_new_lift : MvPolynomial (Fin (s + ν + d)) k)
        (γ₀ : Fin d),
      IsUnit (Matrix.det (Matrix.of fun a b : Fin s =>
        φ (MvPolynomial.pderiv (Fin.castAdd d (Fin.castAdd ν b)) (q a)))) →
      ∀ (J : R) [IsLocalization.Away J R'],
      J = Matrix.det (Matrix.of fun a b : Fin (s + ν + 1) =>
        φ (MvPolynomial.pderiv
          (Fin.snoc (α := fun _ => Fin (s + ν + d)) (Fin.castAdd d) (Fin.natAdd (s + ν) γ₀) b)
          (Fin.snoc (α := fun _ => MvPolynomial (Fin (s + ν + d)) k)
            (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s + ν + d)) k) q f_lift)
            f_new_lift a))) →
      ∃ (φ' : MvPolynomial (Fin ((s + 1) + (ν + 1) + (d - 1))) k →+* R')
        (q' : Fin (s + 1) → MvPolynomial (Fin ((s + 1) + (ν + 1) + (d - 1))) k)
        (f_lift' : Fin (ν + 1) → MvPolynomial (Fin ((s + 1) + (ν + 1) + (d - 1))) k)
        (idx' : Fin ((s + 1) + (ν + 1)) → Fin ((s + 1) + (ν + 1) + (d - 1))),
        Function.Surjective φ' ∧
        Function.Injective idx' ∧
        φ'.comp MvPolynomial.C = (algebraMap R R').comp (φ.comp MvPolynomial.C) ∧
        RingHom.ker φ' = Ideal.span (Set.range q') ∧
        (∀ j : Fin ν, φ' (f_lift' j.castSucc) = algebraMap R R' (φ (f_lift j))) ∧
        φ' (f_lift' (Fin.last ν)) = algebraMap R R' (φ f_new_lift) ∧
