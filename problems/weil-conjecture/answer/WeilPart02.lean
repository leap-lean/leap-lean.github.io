        z = z * (algebraMap B₀ B_g s.1 * u_s) := by rw [hu_s, mul_one]
        _ = (z * algebraMap B₀ B_g s.1) * u_s := (mul_assoc _ _ _).symm
        _ = 0 := by rw [hbs, zero_mul]
    haveI : IsDomain B_g := Function.Injective.isDomain μ_g.toRingHom hμg_inj
    let ev_star : B₀ →+* Ai i_star := (Pi.evalRingHom Ai i_star).comp π_mod
    have hev_g_unit : IsUnit (ev_star g) := by
