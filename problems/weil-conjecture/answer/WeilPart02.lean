      have hmB_eq : Ideal.map (Ideal.Quotient.mk J₀) m_P = IsLocalRing.maximalIdeal B_tilde :=
        IsLocalRing.eq_maximalIdeal hmB_max
      let u_bar : B_tilde := Ideal.Quotient.mk J₀ u₀.1
      let m_B : Ideal B_tilde := IsLocalRing.maximalIdeal B_tilde
      have hmB_span : m_B = Ideal.span ({u_bar} : Set B_tilde) := by
        rw [show m_B = Ideal.map (Ideal.Quotient.mk J₀) m_P from hmB_eq.symm, hmP_eq_span, Ideal.map_span]
        refine le_antisymm ?_ ?_
        · rw [Ideal.span_le]
          rintro _ ⟨x, hx | hx, rfl⟩
          · obtain ⟨i, rfl⟩ := hx
            have hg0 : Ideal.Quotient.mk J₀ (g i).1 = 0 :=
