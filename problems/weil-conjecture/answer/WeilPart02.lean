        have hmul : algebraMap R (FractionRing R) r *
            algebraMap R (FractionRing R) (algebraMap (Polynomial L) R g.1) =
            algebraMap R (FractionRing R) (algebraMap (Polynomial L) R f) := by
          rw [← map_mul, hfg]
        have hmem := S.mul_mem (hPoly_mem f) (S.inv_mem (hPoly_mem g.1))
        rwa [← hmul, mul_inv_cancel_right₀ hg_ne] at hmem
      intro z
      obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj (nonZeroDivisors R) z
      have hs_ne : algebraMap R (FractionRing R) s.1 ≠ 0 := by
        have hs0 : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        exact fun hz => hs0 ((IsFractionRing.injective R (FractionRing R)) (hz.trans (map_zero _).symm))
      have hmul : z * algebraMap R (FractionRing R) s.1 = algebraMap R (FractionRing R) r := hrs
      have h := S.mul_mem (hR_mem r) (S.inv_mem (hR_mem s.1))
      rwa [← hmul, mul_inv_cancel_right₀ hs_ne] at h
    let Ξ : FractionRing (MvPolynomial (Fin m) K) ≃+* FractionRing R :=
      RingEquiv.ofBijective ξ ⟨ξ.injective, hSurj_ξ⟩
    have hΞ : ∀ p : MvPolynomial (Fin m) K,
