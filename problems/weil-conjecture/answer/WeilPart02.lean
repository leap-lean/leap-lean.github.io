      exact hInj_ιtot.comp hInj_Φpoly

    have hΦ_units : ∀ y : nonZeroDivisors (MvPolynomial (Fin m) K), IsUnit (Φ_K y) := by
      intro y
      have hy : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      exact isUnit_iff_ne_zero.mpr fun h0 => hy (hInjΦ (h0.trans (map_zero _).symm))
    let ξ : FractionRing (MvPolynomial (Fin m) K) →+* FractionRing R :=
      IsLocalization.lift (S := FractionRing (MvPolynomial (Fin m) K)) hΦ_units
    have hξ_alg : ∀ p : MvPolynomial (Fin m) K,
        ξ (algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K)) p) = Φ_K p :=
      IsLocalization.lift_eq hΦ_units
    have hSurj_ξ : Function.Surjective ξ := by
      let S : Subfield (FractionRing R) := ξ.fieldRange
      have hΦ_mem : ∀ p : MvPolynomial (Fin m) K, Φ_K p ∈ S := fun p =>
        ⟨algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K)) p, hξ_alg p⟩
      have hK_mem : ∀ c : K, algebraMap K (FractionRing R) c ∈ S := by
        intro c
        simpa [Φ_K] using hΦ_mem (MvPolynomial.C c)
      let t_F : FractionRing R := algebraMap R (FractionRing R) ϖ
      have ht_F_ne : t_F ≠ 0 :=
        fun h0 => hϖ_ne ((IsFractionRing.injective R (FractionRing R)) (h0.trans (map_zero _).symm))
      have ht_F_mem : t_F ∈ S := by
        have h1 := hΦ_mem (MvPolynomial.X idx0 - MvPolynomial.C (a idx0))
        have h2 : Φ_K (MvPolynomial.X idx0 - MvPolynomial.C (a idx0)) = t_F := by
          simp only [Φ_K, map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hw0, map_add]
          rw [← IsScalarTower.algebraMap_apply K R (FractionRing R)]
          ring
        rwa [← h2]
      have hu_mem : ∀ r : Fin (m - 1), algebraMap R (FractionRing R) (algebraMap L R (u r)) ∈ S := by
        intro r
        have h1 := hΦ_mem (MvPolynomial.X (idxSucc r) - MvPolynomial.C (a (idxSucc r)))
        have h2 : Φ_K (MvPolynomial.X (idxSucc r) - MvPolynomial.C (a (idxSucc r))) =
            algebraMap R (FractionRing R) (algebraMap L R (u r)) * t_F := by
          simp only [Φ_K, map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
            hwsucc, map_add, map_mul]
          rw [← IsScalarTower.algebraMap_apply K R (FractionRing R)]
          ring
        rw [h2] at h1
        have h3 := S.mul_mem h1 (S.inv_mem ht_F_mem)
        rwa [mul_inv_cancel_right₀ ht_F_ne] at h3
      let ψ_SL : MvPolynomial (Fin (m - 1)) K →+* FractionRing R :=
        (algebraMap R (FractionRing R)).comp
          ((algebraMap L R).comp (algebraMap (MvPolynomial (Fin (m - 1)) K) L))
      have hPslope_mem : ∀ q : MvPolynomial (Fin (m - 1)) K, ψ_SL q ∈ S := by
        intro q
        induction q using MvPolynomial.induction_on with
        | C c =>
          change algebraMap R (FractionRing R)
            (algebraMap L R (algebraMap (MvPolynomial (Fin (m - 1)) K) L (MvPolynomial.C c))) ∈ S
          have h1 : algebraMap (MvPolynomial (Fin (m - 1)) K) L (MvPolynomial.C c) = algebraMap K L c :=
            (IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (m - 1)) K) L c).symm
          rw [h1, ← IsScalarTower.algebraMap_apply K L R,
            ← IsScalarTower.algebraMap_apply K R (FractionRing R)]
          exact hK_mem c
        | add p₁ p₂ hp₁ hp₂ =>
          rw [map_add]
          exact S.add_mem hp₁ hp₂
        | mul_X p r hp =>
          rw [map_mul]
          exact S.mul_mem hp (hu_mem r)
      have hL_mem : ∀ ℓ : L, algebraMap R (FractionRing R) (algebraMap L R ℓ) ∈ S := by
        intro ℓ
        obtain ⟨⟨q₁, q₂⟩, hq⟩ := IsLocalization.surj (nonZeroDivisors (MvPolynomial (Fin (m - 1)) K)) ℓ
        have hq₂_ne : ψ_SL q₂.1 ≠ 0 := by
          have h0 : q₂.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp q₂.2
          have hInj : Function.Injective ψ_SL :=
            (IsFractionRing.injective R (FractionRing R)).comp
              ((algebraMap L R).injective.comp
                (IsFractionRing.injective (MvPolynomial (Fin (m - 1)) K) L))
          exact fun hz => h0 (hInj (hz.trans (map_zero ψ_SL).symm))
        have hmul : algebraMap R (FractionRing R) (algebraMap L R ℓ) * ψ_SL q₂.1 = ψ_SL q₁ := by
          change (algebraMap R (FractionRing R)).comp (algebraMap L R) ℓ *
            (algebraMap R (FractionRing R)).comp (algebraMap L R)
