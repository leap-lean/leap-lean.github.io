    refine ⟨α₀, V', hAffV', hxV', hV'U, hV'α, hXα₀, zero_lt_one,
      s + 1, φ', q', f_lift', idx', hSurj', hInj_idx', hSpec', hKer', ?_, hDet3', hDet4'⟩
    refine Fin.lastCases ?_ (fun j => ?_)
    · intro hFn
