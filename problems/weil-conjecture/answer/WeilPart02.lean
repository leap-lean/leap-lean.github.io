        ∏ ν : Fin (M₀ + 1),
          ((V₁.left.presheaf.map (CategoryTheory.homOfLE (hV_le_Wproj γ)).op).hom
            (x_proj (μ_chart γ) ν)) ^ (e.1 ν : ℕ)
  have hq_ker : ∀ γ : Fin G,
      RingHom.ker (ιH.app (V_chart γ)).hom = Ideal.span {h_poly γ} := fun γ =>
    hKerCartier (μ_chart γ) c H ιH hCartier (V_chart γ) (hV_aff γ) (hV_le_Wproj γ)
  let δ_chart : ∀ γ : Fin G, ↑(H.presheaf.obj (Opposite.op (V_H γ))) :=
    fun γ => (ιH.app (V_chart γ)).hom (der_S γ (h_poly γ))
  let V_et_chart : Fin G → H.Opens := fun γ => H.basicOpen (δ_chart γ)
  have hVet_le_VH : ∀ γ : Fin G, V_et_chart γ ≤ V_H γ :=
    fun γ => H.basicOpen_le (δ_chart γ)
  have hVet_aff : ∀ γ : Fin G, AlgebraicGeometry.IsAffineOpen (V_et_chart γ) :=
    fun γ => (hVH_aff γ).basicOpen (δ_chart γ)
  have e_p : ∀ γ : Fin G, V_et_chart γ ≤ p ⁻¹ᵁ U_B_chart γ := by
