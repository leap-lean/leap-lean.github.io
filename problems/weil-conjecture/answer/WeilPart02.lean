            rw [Algebra.smul_def, ← map_mul, h_indep, h_indep, Algebra.smul_def,
              Ideal.Quotient.algebraMap_eq, ← map_mul, mul_assoc] }
      have hmP_le_smul : m_P ≤ N_ideal ⊔ m_P • m_P := by
        intro z₀ hz₀
        let z : ↥J_P := ⟨z₀, hJP_eq.symm ▸ hz₀⟩
        obtain ⟨a₀, ha₀⟩ := hvS_span (Φ_PS ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] z))
