      have hCν_ne : ((C_chart ν : Set ↥C)).Nonempty := ⟨x_mn, hx_mn.2⟩
      have hBo_μz_ne : ((C.basicOpen (f_sec μ_z) : Set ↥C)).Nonempty := ⟨z_star, hz_f⟩
      obtain ⟨y₁, hy₁_bo, hy₁_ν⟩ := nonempty_preirreducible_inter
        (C.basicOpen (f_sec μ_z)).isOpen (C_chart ν).isOpen
        (by simpa using hBo_μz_ne) (by simpa using hCν_ne)
      have hy₁_inter : y₁ ∈ C_chart μ_z ⊓ C_chart ν :=
        ⟨C.basicOpen_le (f_sec μ_z) hy₁_bo, hy₁_ν⟩
      have hy₁_res : y₁ ∈ C.basicOpen
          ((C.presheaf.map (CategoryTheory.homOfLE
            (@inf_le_left _ _ (C_chart μ_z) (C_chart ν))).op).hom (f_sec μ_z)) := by
        rw [C.basicOpen_res]
        exact ⟨hy₁_inter, hy₁_bo⟩
      rw [hf_cocycle μ_z ν, C.basicOpen_mul, C.basicOpen_of_isUnit (hu_unit μ_z ν)] at hy₁_res
      have hy₁_fν : y₁ ∈ C.basicOpen (f_sec ν) := by
        have h2 : y₁ ∈ C.basicOpen
            ((C.presheaf.map (CategoryTheory.homOfLE
              (@inf_le_right _ _ (C_chart μ_z) (C_chart ν))).op).hom (f_sec ν)) := hy₁_res.2
        rw [C.basicOpen_res] at h2
        exact h2.2
      have hBo_ν_ne : ((C.basicOpen (f_sec ν) : Set ↥C)).Nonempty := ⟨y₁, hy₁_fν⟩
      have hInter_ne : (((C_chart μ ⊓ C_chart ν : C.Opens) : Set ↥C)).Nonempty := ⟨x_mn, hx_mn⟩
      obtain ⟨y₂, hy₂_bo, hy₂_mn⟩ := nonempty_preirreducible_inter
        (C.basicOpen (f_sec ν)).isOpen (C_chart μ ⊓ C_chart ν).isOpen
        (by simpa using hBo_ν_ne) (by simpa using hInter_ne)
      have hy₂_res : y₂ ∈ C.basicOpen
          ((C.presheaf.map (CategoryTheory.homOfLE
            (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν)) := by
        rw [C.basicOpen_res]
        exact ⟨hy₂_mn, hy₂_bo⟩
      have hfν_ne : (C.presheaf.map (CategoryTheory.homOfLE
          (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν) ≠ 0 := by
        intro hzero
        rw [hzero, C.basicOpen_zero] at hy₂_res
        exact hy₂_res
      have hufν_ne : u_cocycle μ ν *
          (C.presheaf.map (CategoryTheory.homOfLE
            (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν) ≠ 0 :=
        mul_ne_zero (hu_unit μ ν).ne_zero hfν_ne
      have h_eq :
          (C.presheaf.map (CategoryTheory.homOfLE
            (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (g_sec μ) *
            (u_cocycle μ ν *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν)) =
          (C.presheaf.map (CategoryTheory.homOfLE
            (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (g_sec ν) *
            (u_cocycle μ ν *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν)) := by
        calc (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (g_sec μ) *
              (u_cocycle μ ν *
                (C.presheaf.map (CategoryTheory.homOfLE
                  (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν))
            = (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (g_sec μ) *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec μ) := by
              rw [hf_cocycle μ ν]
          _ = (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (g_sec μ * f_sec μ) := by
              rw [map_mul]
          _ = (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_left _ _ (C_chart μ) (C_chart ν))).op).hom (p_sec μ) := by
              rw [hg_sec μ]
          _ = u_cocycle μ ν *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (p_sec ν) :=
              hp_cocycle μ ν
          _ = u_cocycle μ ν *
              (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (g_sec ν * f_sec ν) := by
              rw [hg_sec ν]
          _ = (C.presheaf.map (CategoryTheory.homOfLE
                (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (g_sec ν) *
              (u_cocycle μ ν *
                (C.presheaf.map (CategoryTheory.homOfLE
                  (@inf_le_right _ _ (C_chart μ) (C_chart ν))).op).hom (f_sec ν)) := by
              rw [map_mul]
              ring
      exact mul_right_cancel₀ hufν_ne h_eq
  obtain ⟨s_sup, hs_sup, _⟩ := C.sheaf.existsUnique_gluing C_chart g_sec hCompat
  let g_glob : ↑(C.presheaf.obj (Opposite.op ⊤)) :=
    (C.presheaf.map (CategoryTheory.eqToHom hCov_C.symm).op).hom s_sup
  have hg_glob_res : ∀ μ : Fin (M₀ + 1),
      (C.presheaf.map (CategoryTheory.homOfLE (le_top : C_chart μ ≤ ⊤)).op).hom g_glob =
        g_sec μ := by
    intro μ
    have h_le : CategoryTheory.homOfLE (le_top : C_chart μ ≤ ⊤) =
        CategoryTheory.homOfLE (le_iSup C_chart μ) ≫ CategoryTheory.eqToHom hCov_C :=
      Subsingleton.elim _ _
    dsimp [g_glob]
    rw [h_le, op_comp, C.presheaf.map_comp]
    change (C.presheaf.map (CategoryTheory.homOfLE (le_iSup C_chart μ)).op).hom
      ((C.presheaf.map (CategoryTheory.eqToHom hCov_C.symm).op ≫
        C.presheaf.map (CategoryTheory.eqToHom hCov_C).op).hom s_sup) = g_sec μ
    rw [← C.presheaf.map_comp, ← op_comp, CategoryTheory.eqToHom_trans,
      CategoryTheory.eqToHom_refl, op_id, C.presheaf.map_id]
    exact hs_sup μ
  have hField_top : IsField ↑(C.presheaf.obj (Opposite.op ⊤)) :=
    AlgebraicGeometry.isField_of_universallyClosed K (ι_C ≫ π₂)
  by_cases hg_zero : g_glob = 0
  · have hg_w : g_sec μ_w = 0 := by
      rw [← hg_glob_res μ_w, hg_zero, map_zero]
    have hp_w : p_sec μ_w = 0 := by
      rw [← hg_sec μ_w, hg_w, zero_mul]
    rw [hp_w, C.basicOpen_zero] at hw_p
    exact hw_p
  · obtain ⟨g_inv, hg_inv⟩ := hField_top.mul_inv_cancel hg_zero
    have hUnit_glob : IsUnit g_glob := isUnit_iff_exists_inv.mpr ⟨g_inv, hg_inv⟩
    have hUnit_gz : IsUnit (g_sec μ_z) := by
      rw [← hg_glob_res μ_z]
      exact hUnit_glob.map (C.presheaf.map (CategoryTheory.homOfLE (le_top : C_chart μ_z ≤ ⊤)).op).hom
    have hz_p : z_star ∈ C.basicOpen (p_sec μ_z) := by
      rw [← hg_sec μ_z, C.basicOpen_mul, C.basicOpen_of_isUnit hUnit_gz]
      exact ⟨hz_chart, hz_f⟩
    exact hz_not_p hz_p

theorem weil_algClosed_bertini_three_secant_finite_cover (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hIntB₀ : AlgebraicGeometry.IsIntegral B₀.left)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (hDimB₀ : topologicalKrullDim B₀.left = (m : WithBot ℕ∞))
    (hU₀ : Nonempty U₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hProjV₁ : IsProjectiveOverField k V₁)
    (hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀) :
    ∃ (r : ℕ)
      (W : Fin r → B₀.left.Opens)
      (H : Fin r → AlgebraicGeometry.Scheme.{u})
      (ιH : ∀ a : Fin r, H a ⟶ V₁.left),
      (⋃ a : Fin r, (W a : Set B₀.left)) = Set.univ ∧
      (∀ a : Fin r, Nonempty (W a)) ∧
      (∀ a : Fin r, AlgebraicGeometry.IsClosedImmersion (ιH a)) ∧
      (∀ a : Fin r, AlgebraicGeometry.IsFinite (ιH a ≫ f₁.left)) ∧
      (∀ a : Fin r, AlgebraicGeometry.Etale ((ιH a ≫ f₁.left) ∣_ (W a))) ∧
      (∀ a : Fin r, IsLocalThreeSecantSmoothSubschemeOver k f₁ (W a) (ιH a)) :=
by
  obtain ⟨M₀, ι₁, hCl₁⟩ := hProjV₁
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) :=
    MvPolynomial.gradedAlgebra
  obtain ⟨G_qf, hG_qf_ne, hG_qf_fin⟩ :=
    weil_algClosed_veronese_vandermonde_quasiFinite_open k m M₀
      B₀ U₀ hIntB₀ hProjB₀ hDimB₀ hU₀ V₁ hIntV₁ hDimV₁ ι₁ hCl₁ f₁ hFib₁
  have hLocal : ∀ p : {y : ↥B₀.left // IsClosed ({y} : Set ↥B₀.left)},
      ∃ (W_y : B₀.left.Opens) (H_y : AlgebraicGeometry.Scheme.{u}) (ιH_y : H_y ⟶ V₁.left),
        p.1 ∈ W_y ∧
        AlgebraicGeometry.IsClosedImmersion ιH_y ∧
        AlgebraicGeometry.IsFinite (ιH_y ≫ f₁.left) ∧
        AlgebraicGeometry.Etale ((ιH_y ≫ f₁.left) ∣_ W_y) ∧
        IsLocalThreeSecantSmoothSubschemeOver k f₁ W_y ιH_y := by
    intro ⟨y, hy⟩
    obtain ⟨c, hc_qf, hc_hom, hEtSlice⟩ :=
      weil_algClosed_bertini_closedPoint_etale_slice k M₀ (m + 3) (by omega)
        B₀ U₀ hProjB₀ V₁ ι₁ hCl₁ f₁ hFib₁ G_qf hG_qf_ne y hy
    obtain ⟨H_y, ιH_y, hCartier⟩ :=
      weil_projective_cartier_hypersurface_pullback k M₀ (m + 3) (by omega)
        V₁ ι₁ (weilHomogeneousPoly M₀ (m + 3) c) hc_hom
    obtain ⟨W_y, hy_W, hEt_W, hSm_W⟩ := hEtSlice H_y ιH_y hCartier
    have hClH_y : AlgebraicGeometry.IsClosedImmersion ιH_y := hCartier.1
    obtain ⟨_, hRange_y, _⟩ := hCartier.2
    have hFinFib_y : ∀ b : B₀.left, ((ιH_y ≫ f₁.left).base ⁻¹' {b}).Finite := by
      intro b
      have hInj : Function.Injective ιH_y.base :=
        (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ιH_y).injective
      have hSub : ((ιH_y ≫ f₁.left).base ⁻¹' {b}) ⊆
          ιH_y.base ⁻¹' {x : V₁.left | f₁.left.base x = b ∧
            x ∉ ((TopologicalSpace.Opens.map ι₁.left.base).obj
              (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k)
                (weilHomogeneousPoly M₀ (m + 3) c)) : Set V₁.left)} := by
        intro z hz
        have hfb : f₁.left.base (ιH_y.base z) = b := by
          simpa using hz
        have hmem_range : ιH_y.base z ∈ Set.range ιH_y.base := ⟨z, rfl⟩
        rw [hRange_y] at hmem_range
        exact ⟨hfb, hmem_range⟩
      exact ((hG_qf_fin c hc_qf b).preimage hInj.injOn).subset hSub
    have hFin_y : AlgebraicGeometry.IsFinite (ιH_y ≫ f₁.left) :=
      weil_projective_proper_finite_fibers_isFinite k M₀ B₀ hProjB₀ V₁ ι₁ hCl₁ f₁ hFib₁.1
        H_y ιH_y hClH_y hFinFib_y
    have hSec_y : IsLocalThreeSecantSmoothSubschemeOver k f₁ W_y ιH_y :=
      weil_algClosed_cartier_etale_three_secant_over_open k M₀ (m + 3) (by omega)
        B₀ U₀ hProjB₀ V₁ ι₁ hCl₁ f₁ hFib₁ (weilHomogeneousPoly M₀ (m + 3) c)
        H_y ιH_y hCartier hFin_y W_y hEt_W hSm_W
    exact ⟨W_y, H_y, ιH_y, hy_W, hClH_y, hFin_y, hEt_W, hSec_y⟩
  choose W_pt H_pt ιH_pt hMem_pt hCl_pt hFin_pt hEt_pt hSec_pt using hLocal
  have hCompB₀ : CompactSpace ↥B₀.left := by
    obtain ⟨N₀, ιB₀, hClB₀⟩ := hProjB₀
    let 𝒜_B := MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k
    letI : GradedAlgebra 𝒜_B := MvPolynomial.gradedAlgebra
    have hCompProj : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜_B) := by
      have h_adjoin : Algebra.adjoin (↥(𝒜_B 0))
          (Set.range (MvPolynomial.X : Fin (N₀ + 1) → MvPolynomial (Fin (N₀ + 1)) k)) = ⊤ := by
        rw [eq_top_iff]
        have h_mem_all : ∀ p : MvPolynomial (Fin (N₀ + 1)) k,
            p ∈ Algebra.adjoin (↥(𝒜_B 0))
              (Set.range (MvPolynomial.X : Fin (N₀ + 1) → MvPolynomial (Fin (N₀ + 1)) k)) := by
          intro p
          induction p using MvPolynomial.induction_on with
          | C a =>
            let c₀ : ↥(𝒜_B 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
            exact (Algebra.adjoin (↥(𝒜_B 0))
              (Set.range (MvPolynomial.X : Fin (N₀ + 1) → MvPolynomial (Fin (N₀ + 1)) k))).algebraMap_mem c₀
          | add p q hp hq =>
            exact add_mem hp hq
          | mul_X p i hp =>
            exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
        intro p _
        exact h_mem_all p
      have h_top : (⨆ i : Fin (N₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_B (MvPolynomial.X i)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜_B MvPolynomial.X
          (fun i => ⟨1, MvPolynomial.isHomogeneous_X k i⟩) h_adjoin
      rw [← isCompact_univ_iff]
      have h_univ : (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜_B)) =
          ⋃ i : Fin (N₀ + 1), (AlgebraicGeometry.Proj.basicOpen 𝒜_B (MvPolynomial.X i) :
            Set ↥(AlgebraicGeometry.Proj 𝒜_B)) := by
        rw [← TopologicalSpace.Opens.coe_top, ← h_top, TopologicalSpace.Opens.coe_iSup]
      rw [h_univ]
      refine isCompact_iUnion fun i => ?_
      let U_i := AlgebraicGeometry.Proj.basicOpen 𝒜_B (MvPolynomial.X i)
      let iso_i := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_B (MvPolynomial.X i)
        (MvPolynomial.isHomogeneous_X k i) zero_lt_one
      have hHomeo : ↥(U_i : AlgebraicGeometry.Scheme.{u}) ≃ₜ ↥(AlgebraicGeometry.Spec
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜_B (MvPolynomial.X i)))) :=
        TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso_i)
      exact isCompact_iff_compactSpace.mpr hHomeo.symm.compactSpace
    haveI : CompactSpace ↥(weilProjectiveSpaceOver k N₀).left := hCompProj
    exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ιB₀.left).compactSpace
  have h_union : (⋃ p : {y : ↥B₀.left // IsClosed ({y} : Set ↥B₀.left)},
      (W_pt p : Set ↥B₀.left)) = Set.univ := by
    by_contra h_ne
    have h_nonempty : ((⋃ p : {y : ↥B₀.left // IsClosed ({y} : Set ↥B₀.left)},
        (W_pt p : Set ↥B₀.left))ᶜ).Nonempty :=
      Set.nonempty_compl.mpr h_ne
    have h_closed : IsClosed ((⋃ p : {y : ↥B₀.left // IsClosed ({y} : Set ↥B₀.left)},
        (W_pt p : Set ↥B₀.left))ᶜ) :=
      (isOpen_iUnion fun p => (W_pt p).isOpen).isClosed_compl
    obtain ⟨y₀, hy₀_mem, hy₀_cl⟩ := h_closed.exists_closed_singleton h_nonempty
    exact hy₀_mem (Set.mem_iUnion.mpr ⟨⟨y₀, hy₀_cl⟩, hMem_pt ⟨y₀, hy₀_cl⟩⟩)
  have h_cov : (Set.univ : Set ↥B₀.left) ⊆
      ⋃ p : {y : ↥B₀.left // IsClosed ({y} : Set ↥B₀.left)}, (W_pt p : Set ↥B₀.left) := by
    rw [h_union]
  obtain ⟨S, hS⟩ := isCompact_univ.elim_finite_subcover
    (fun p : {y : ↥B₀.left // IsClosed ({y} : Set ↥B₀.left)} => (W_pt p : Set ↥B₀.left))
    (fun p => (W_pt p).isOpen) h_cov
  let e : Fin S.card ≃ ↥S := S.equivFin.symm
  refine ⟨S.card, fun a => W_pt (e a).1, fun a => H_pt (e a).1, fun a => ιH_pt (e a).1,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · apply Set.eq_univ_of_univ_subset
    intro x hx
    have hxS := hS hx
    rw [Set.mem_iUnion₂] at hxS
    obtain ⟨p, hpS, hxp⟩ := hxS
    rw [Set.mem_iUnion]
    refine ⟨e.symm ⟨p, hpS⟩, ?_⟩
    simpa using hxp
  · intro a
    exact ⟨(e a).1.1, hMem_pt (e a).1⟩
  · intro a
    exact hCl_pt (e a).1
  · intro a
    exact hFin_pt (e a).1
  · intro a
    exact hEt_pt (e a).1
  · intro a
    exact hSec_pt (e a).1

theorem weil_algClosed_galois_normalization_splits_finite_etale (k : Type u) [Field k] [IsAlgClosed k]
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntB₀ : AlgebraicGeometry.IsIntegral B₀.left)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (s : ℕ)
    (D : Fin s → AlgebraicGeometry.Scheme.{u})
    (p : ∀ ℓ : Fin s, D ℓ ⟶ B₀.left)
    (W : Fin s → B₀.left.Opens)
    (hW : ∀ ℓ : Fin s, Nonempty (W ℓ))
    (hFinD : ∀ ℓ : Fin s, AlgebraicGeometry.IsFinite (p ℓ))
    (hEtD : ∀ ℓ : Fin s, AlgebraicGeometry.Etale ((p ℓ) ∣_ (W ℓ))) :
    ∃ (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (ψ₀ : B₂ ⟶ B₀),
      AlgebraicGeometry.IsIntegral B₂.left ∧
      AlgebraicGeometry.IsFinite ψ₀.left ∧
      IsGenFiniteEtaleAlterationOver k ψ₀ ∧
      ∀ ℓ : Fin s, HasPullbackSectionCoverOverOpen (p ℓ) ψ₀.left (W ℓ) :=
by
  
  have weil_generic_etale_galois_splitting_points :
      ∀ (B₀ : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsIntegral B₀]
        (s : ℕ)
        (D : Fin s → AlgebraicGeometry.Scheme.{u})
        (p : ∀ ℓ : Fin s, D ℓ ⟶ B₀)
        (W : Fin s → B₀.Opens)
        (_ : ∀ ℓ : Fin s, Nonempty (W ℓ))
        (_ : ∀ ℓ : Fin s, AlgebraicGeometry.IsFinite (p ℓ))
        (_ : ∀ ℓ : Fin s, AlgebraicGeometry.Etale ((p ℓ) ∣_ (W ℓ))),
        ∃ (L : Type u) (_ : Field L) (_ : Algebra (↑B₀.functionField) L),
          FiniteDimensional (↑B₀.functionField) L ∧
          Algebra.IsSeparable (↑B₀.functionField) L ∧
          ∀ ℓ : Fin s,
            ∃ (k_D : ℕ)
              (z : Fin k_D → (AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ D ℓ))
              (hz : ∀ j : Fin k_D,
                z j ≫ p ℓ =
                  AlgebraicGeometry.Spec.map
                    (CommRingCat.ofHom (algebraMap (↑B₀.functionField) L)) ≫
                  B₀.fromSpecStalk (genericPoint ↥B₀)),
              ∀ q : ↥(CategoryTheory.Limits.pullback (p ℓ)
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap (↑B₀.functionField) L)) ≫
                B₀.fromSpecStalk (genericPoint ↥B₀))),
                ∃ j : Fin k_D,
                  q ∈ Set.range
                    (CategoryTheory.Limits.pullback.lift (z j)
                      (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L))) (hz j)).base := by
    clear hEtD hFinD hW W p D s hProjB₀ hIntB₀ B₀
    intro B₀ _ s D p W hW hFinD hEtD
    classical
    let K₀ : Type u := ↑B₀.functionField
    let ξ₀ : AlgebraicGeometry.Spec B₀.functionField ⟶ B₀ :=
      B₀.fromSpecStalk (genericPoint ↥B₀)
    have hSub_K₀ : Subsingleton ↥(AlgebraicGeometry.Spec B₀.functionField) := by
      constructor
      intro p₁ p₂
      change PrimeSpectrum K₀ at p₁ p₂
      refine PrimeSpectrum.ext ?_
      have h₁ : p₁.asIdeal = ⊥ :=
        (Ideal.eq_bot_or_top p₁.asIdeal).resolve_right p₁.isPrime.ne_top
      have h₂ : p₂.asIdeal = ⊥ :=
        (Ideal.eq_bot_or_top p₂.asIdeal).resolve_right p₂.isPrime.ne_top
      rw [h₁, h₂]
    let D₀ : Fin s → AlgebraicGeometry.Scheme.{u} := fun ℓ =>
