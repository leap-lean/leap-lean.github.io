        have : FaithfulSMul PK B := (faithfulSMul_iff_algebraMap_injective PK B).mpr hg_inj
        have : Algebra.IsIntegral PK B := ⟨hg_int⟩
        have : IsIntegrallyClosed PK := UniqueFactorizationMonoid.instIsIntegrallyClosed
        have : Algebra.HasGoingDown PK B := inferInstance
        have : 𝔪.LiesOver (RelSeries.last l).asIdeal := ⟨hp_last⟩
        obtain ⟨L, h1, h2, _⟩ := Ideal.exists_ltSeries_of_hasGoingDown l 𝔪
        exact ⟨L, h1, h2⟩
      have hChainHt : ∀ (n : ℕ) (hn : n ≤ L.length),
          (n : ℕ∞) ≤ (L ⟨n, Nat.lt_succ_of_le hn⟩).asIdeal.height := by
        intro n
        induction n with
        | zero =>
          intro _
          exact bot_le
        | succ n ih =>
          intro hn
          let P₀ := (L ⟨n, Nat.lt_succ_of_le (Nat.le_of_succ_le hn)⟩).asIdeal
          let P₁ := (L ⟨n + 1, Nat.lt_succ_of_le hn⟩).asIdeal
