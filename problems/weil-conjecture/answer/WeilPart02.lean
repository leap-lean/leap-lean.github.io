    let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin 2) R
    let : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    let P1_R := AlgebraicGeometry.Proj 𝒜_R
    let W₀ : A_R := MvPolynomial.X 0
    let W₁ : A_R := MvPolynomial.X 1
    have hW₀ : W₀ ∈ 𝒜_R 1 := MvPolynomial.isHomogeneous_X R 0
    have hW₁ : W₁ ∈ 𝒜_R 1 := MvPolynomial.isHomogeneous_X R 1
    have hChartBijective : ∀ (a b : Fin 2), a ≠ b →
        Function.Bijective (Polynomial.eval₂RingHom
          ((HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap R ↥(𝒜_R 0)))
          (HomogeneousLocalization.Away.isLocalizationElem
            (MvPolynomial.isHomogeneous_X R a) (MvPolynomial.isHomogeneous_X R b))) := by
      intro a b hab
      let hXa : (MvPolynomial.X a : A_R) ∈ 𝒜_R 1 := MvPolynomial.isHomogeneous_X R a
      let hXb : (MvPolynomial.X b : A_R) ∈ 𝒜_R 1 := MvPolynomial.isHomogeneous_X R b
      let cHom : R →+* HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap R ↥(𝒜_R 0))
      let tElem : HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a) :=
        HomogeneousLocalization.Away.isLocalizationElem hXa hXb
      let toAway : Polynomial R →+* HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a) :=
        Polynomial.eval₂RingHom cHom tElem
      let dehomog : A_R →ₐ[R] Polynomial R :=
        MvPolynomial.aeval (fun i : Fin 2 => if i = a then (1 : Polynomial R) else Polynomial.X)
      have hdehomog_Xa : dehomog (MvPolynomial.X a) = 1 := by
        dsimp [dehomog]; rw [MvPolynomial.aeval_X, ite_eq_left_iff.mpr (fun h => absurd rfl h)]
      have hdehomog_Xb : dehomog (MvPolynomial.X b) = Polynomial.X := by
        dsimp [dehomog]; rw [MvPolynomial.aeval_X, ite_eq_right_iff.mpr (fun h => absurd h hab.symm)]
      have hcHom_val : ∀ c : R, (cHom c).val = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        change (HomogeneousLocalization.mk
          { deg := 0
            num := algebraMap R ↥(𝒜_R 0) c
            den := ⟨1, SetLike.GradedMonoid.toGradedOne.one_mem⟩
            den_mem := (Submonoid.powers (MvPolynomial.X a)).one_mem }).val = _
        rw [HomogeneousLocalization.val_mk]
        congr 1
      have htElem_val : tElem.val =
          Localization.mk (MvPolynomial.X b) ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ := by
        change (HomogeneousLocalization.Away.mk 𝒜_R hXa 1 (MvPolynomial.X b ^ 1) _).val = _
        rw [HomogeneousLocalization.Away.val_mk]
        congr 1
        · exact pow_one _
        · apply Subtype.ext; exact pow_one _
      let S_a : Submonoid A_R := Submonoid.powers (MvPolynomial.X a)
      have hXa_mem : (MvPolynomial.X a : A_R) ∈ S_a := Submonoid.mem_powers _
      have hpow_val : ∀ k : ℕ, (tElem ^ k).val = (tElem.val) ^ k := by
        intro k
        induction k with
        | zero => exact HomogeneousLocalization.val_one
        | succ k ih => rw [pow_succ, pow_succ, HomogeneousLocalization.val_mul, ih]
      have hTermVal : ∀ (D j : ℕ) (hj : j ≤ D) (c : R),
          (cHom c * tElem ^ j).val =
            Localization.mk (MvPolynomial.C c * (MvPolynomial.X b) ^ j * (MvPolynomial.X a) ^ (D - j))
              ⟨(MvPolynomial.X a) ^ D, S_a.pow_mem hXa_mem D⟩ := by
        intro D j hj c
        rw [HomogeneousLocalization.val_mul, hcHom_val, hpow_val, htElem_val,
          Localization.mk_pow, Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_one, one_mul, SubmonoidClass.coe_pow]
        have hsub : (D - j) + j = D := Nat.sub_add_cancel hj
        conv_lhs => rw [← hsub, pow_add]
        ring
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro P hP0
        let D := P.natDegree
        have hP_sum : P = ∑ j ∈ Finset.range (D + 1), Polynomial.C (P.coeff j) * Polynomial.X ^ j :=
          Polynomial.as_sum_range_C_mul_X_pow P
        have hValSum : (toAway P).val =
            Localization.mk
              (∑ j ∈ Finset.range (D + 1),
                MvPolynomial.C (P.coeff j) * (MvPolynomial.X b) ^ j * (MvPolynomial.X a) ^ (D - j))
              ⟨(MvPolynomial.X a) ^ D, S_a.pow_mem hXa_mem D⟩ := by
          conv_lhs => rw [hP_sum]
          rw [map_sum]
          have hval_sum : ∀ (S : Finset ℕ) (g : ℕ → HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a)),
              (∑ j ∈ S, g j).val = ∑ j ∈ S, (g j).val := by
            intro S g
            induction S using Finset.cons_induction with
            | empty => exact HomogeneousLocalization.val_zero
            | cons k S _ ih => rw [Finset.sum_cons, Finset.sum_cons, HomogeneousLocalization.val_add, ih]
          rw [hval_sum]
          have hmk_sum : ∀ (S : Finset ℕ) (hS : ∀ j ∈ S, j ≤ D),
              (∑ j ∈ S, (toAway (Polynomial.C (P.coeff j) * Polynomial.X ^ j)).val) =
                Localization.mk
                  (∑ j ∈ S, MvPolynomial.C (P.coeff j) * (MvPolynomial.X b) ^ j * (MvPolynomial.X a) ^ (D - j))
                  ⟨(MvPolynomial.X a) ^ D, S_a.pow_mem hXa_mem D⟩ := by
            intro S hS
            induction S using Finset.cons_induction with
            | empty => simp [Localization.mk_zero]
            | cons k S _ ih =>
              rw [Finset.sum_cons, Finset.sum_cons, ih (fun j hj => hS j (Finset.mem_cons_of_mem hj))]
              have hkD : k ≤ D := hS k (Finset.mem_cons_self k S)
              have htk : toAway (Polynomial.C (P.coeff k) * Polynomial.X ^ k) =
                  cHom (P.coeff k) * tElem ^ k := by
                rw [map_mul, map_pow]
                dsimp [toAway]
                rw [Polynomial.eval₂_C, Polynomial.eval₂_X]
              rw [htk, hTermVal D k hkD (P.coeff k), Localization.add_mk_self]
          exact hmk_sum (Finset.range (D + 1)) (fun j hj => Nat.lt_succ_iff.mp (Finset.mem_range.mp hj))
        have h0val : (toAway P).val = Localization.mk 0 1 := by
          rw [hP0, HomogeneousLocalization.val_zero, Localization.mk_zero]
        rw [hValSum, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h0val
        obtain ⟨⟨s, m, rfl⟩, hs0⟩ := h0val
        simp only [Submonoid.coe_one, one_mul, mul_zero] at hs0
        have hdehom : dehomog ((MvPolynomial.X a) ^ m *
            ∑ j ∈ Finset.range (D + 1),
              MvPolynomial.C (P.coeff j) * (MvPolynomial.X b) ^ j * (MvPolynomial.X a) ^ (D - j)) = 0 := by
          rw [hs0, map_zero]
        rw [map_mul, map_pow, hdehomog_Xa, one_pow, one_mul, map_sum] at hdehom
        have hdehom_eq : (∑ j ∈ Finset.range (D + 1),
            dehomog (MvPolynomial.C (P.coeff j) * (MvPolynomial.X b) ^ j * (MvPolynomial.X a) ^ (D - j))) = P := by
          conv_rhs => rw [hP_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, map_mul, map_pow, map_pow, hdehomog_Xb, hdehomog_Xa, one_pow, mul_one]
          congr 1
          exact MvPolynomial.aeval_C _ (P.coeff j)
        rwa [hdehom_eq] at hdehom
      · intro z
        obtain ⟨n, f, hf, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_R hXa z
        refine ⟨dehomog f, ?_⟩
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk]
        have hf_hom : MvPolynomial.IsHomogeneous f n := by
          have hf' : f ∈ 𝒜_R (n • 1) := hf
          rw [smul_eq_mul, mul_one] at hf'
          exact (MvPolynomial.mem_homogeneousSubmodule n f).mp hf'
        obtain ⟨cf, hf_sum⟩ : ∃ cf : (Fin 2 →₀ ℕ) → R,
            f = ∑ d ∈ f.support, MvPolynomial.monomial d (cf d) :=
          ⟨_, MvPolynomial.as_sum f⟩
        have hMonEq : ∀ d ∈ f.support,
            MvPolynomial.monomial d (cf d) =
              MvPolynomial.C (cf d) * (MvPolynomial.X b) ^ (d b) * (MvPolynomial.X a) ^ (d a) := by
          intro d _
          rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
          fin_cases a <;> fin_cases b
          · exact absurd rfl hab
          · change MvPolynomial.C (cf d) * (MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) =
              MvPolynomial.C (cf d) * MvPolynomial.X 1 ^ d 1 * MvPolynomial.X 0 ^ d 0
            ring
          · change MvPolynomial.C (cf d) * (MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) =
              MvPolynomial.C (cf d) * MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1
            ring
          · exact absurd rfl hab
        have hd_sum : ∀ d ∈ f.support, d a + d b = n := by
          intro d hd
          have hdeg := hf_hom (MvPolynomial.mem_support_iff.mp hd)
          rw [Finsupp.weight_apply,
            Finsupp.sum_fintype d (fun i c => c • (1 : Fin 2 → ℕ) i)
              (fun i => zero_smul ℕ ((1 : Fin 2 → ℕ) i)),
            Fin.sum_univ_two] at hdeg
          simp at hdeg
          fin_cases a <;> fin_cases b
          · exact absurd rfl hab
          · exact hdeg
          · change d 1 + d 0 = n; rw [add_comm]; exact hdeg
          · exact absurd rfl hab
        conv_lhs => rw [hf_sum, map_sum, map_sum]
        have hval_sum2 : ∀ (S : Finset (Fin 2 →₀ ℕ))
            (g : (Fin 2 →₀ ℕ) → HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a)),
            (∑ d ∈ S, g d).val = ∑ d ∈ S, (g d).val := by
          intro S g
          induction S using Finset.cons_induction with
          | empty => exact HomogeneousLocalization.val_zero
          | cons d S _ ih => rw [Finset.sum_cons, Finset.sum_cons, HomogeneousLocalization.val_add, ih]
        rw [hval_sum2]
        have hmk_sum2 : ∀ (S : Finset (Fin 2 →₀ ℕ)) (hS : S ⊆ f.support),
            (∑ d ∈ S, (toAway (dehomog (MvPolynomial.monomial d (cf d)))).val) =
              Localization.mk (∑ d ∈ S, MvPolynomial.monomial d (cf d))
                ⟨(MvPolynomial.X a) ^ n, S_a.pow_mem hXa_mem n⟩ := by
          intro S hS
          induction S using Finset.cons_induction with
          | empty => simp [Localization.mk_zero]
          | cons d S _ ih =>
            have hd_supp : d ∈ f.support := hS (Finset.mem_cons_self d S)
            rw [Finset.sum_cons, Finset.sum_cons, ih (fun x hx => hS (Finset.mem_cons_of_mem hx))]
            have hd_ab : d a + d b = n := hd_sum d hd_supp
            have hdb_le : d b ≤ n := by omega
            have hda_eq : n - d b = d a := by omega
            have hdehom_mon : dehomog (MvPolynomial.monomial d (cf d)) =
                Polynomial.C (cf d) * Polynomial.X ^ (d b) := by
              rw [hMonEq d hd_supp, map_mul, map_mul, map_pow, map_pow,
                hdehomog_Xb, hdehomog_Xa, one_pow, mul_one]
              congr 1
              exact MvPolynomial.aeval_C _ (cf d)
            have hto_mon : toAway (Polynomial.C (cf d) * Polynomial.X ^ (d b)) =
                cHom (cf d) * tElem ^ (d b) := by
              rw [map_mul, map_pow]
              dsimp [toAway]
              rw [Polynomial.eval₂_C, Polynomial.eval₂_X]
            rw [hdehom_mon, hto_mon, hTermVal n (d b) hdb_le (cf d),
              hda_eq, ← hMonEq d hd_supp, Localization.add_mk_self]
        rw [hmk_sum2 f.support (fun _ hx => hx), ← hf_sum]
    let e₀ : Polynomial R ≃+* HomogeneousLocalization.Away 𝒜_R W₀ :=
      RingEquiv.ofBijective _ (hChartBijective 0 1 (by decide))
    let e₁ : Polynomial R ≃+* HomogeneousLocalization.Away 𝒜_R W₁ :=
      RingEquiv.ofBijective _ (hChartBijective 1 0 (by decide))
    let r₀ : R →+* B₀ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom
    let r₁ : R →+* B₁ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op).hom
    let r₀₁ : R →+* B₀₁ := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      p.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ⊓ U₁ ≤ ⊤)).op).hom
    have hr₀ : res₀.comp r₀ = r₀₁ := by
      ext c
      dsimp [res₀, r₀, r₀₁]
      have hcomp : (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op) =
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ⊓ U₁ ≤ ⊤)).op := by
        rw [← Y.presheaf.map_comp]; rfl
      exact ConcreteCategory.congr_hom
        (congrArg (fun m => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ p.appTop ≫ m) hcomp) c
    have hr₁ : res₁.comp r₁ = r₀₁ := by
      ext c
      dsimp [res₁, r₁, r₀₁]
      have hcomp : (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op) =
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ⊓ U₁ ≤ ⊤)).op := by
        rw [← Y.presheaf.map_comp]; rfl
      exact ConcreteCategory.congr_hom
        (congrArg (fun m => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ p.appTop ≫ m) hcomp) c
    let φ₀ : HomogeneousLocalization.Away 𝒜_R W₀ →+* B₀ :=
      (Polynomial.eval₂RingHom r₀ u).comp e₀.symm.toRingHom
    let φ₁ : HomogeneousLocalization.Away 𝒜_R W₁ →+* B₁ :=
      (Polynomial.eval₂RingHom r₁ v).comp e₁.symm.toRingHom
    let covObj : Bool → AlgebraicGeometry.Scheme.{u}
      | false => AlgebraicGeometry.Spec (CommRingCat.of B₀)
      | true => AlgebraicGeometry.Spec (CommRingCat.of B₁)
    let covMap : ∀ b : Bool, covObj b ⟶ Y
      | false => hAff₀.fromSpec
      | true => hAff₁.fromSpec
    have hCovImm : ∀ b : Bool, AlgebraicGeometry.IsOpenImmersion (covMap b) := by
      intro b; cases b <;> dsimp [covMap] <;> infer_instance
    have hCovSurj : ∀ y : ↥Y, ∃ (b : Bool) (x : ↥(covObj b)), (covMap b).base x = y := by
      intro y
      have hy : y ∈ (U₀ ⊔ U₁ : Y.Opens) := by rw [hCovY]; trivial
      rcases hy with hy₀ | hy₁
      · obtain ⟨x, hx⟩ := Set.ext_iff.mp (congrArg SetLike.coe hAff₀.opensRange_fromSpec) y |>.mpr hy₀
        exact ⟨false, x, hx⟩
      · obtain ⟨x, hx⟩ := Set.ext_iff.mp (congrArg SetLike.coe hAff₁.opensRange_fromSpec) y |>.mpr hy₁
        exact ⟨true, x, hx⟩
    let 𝒰 : Y.OpenCover :=
      AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
        Bool covObj covMap hCovSurj hCovImm
    let gChart : ∀ b : 𝒰.I₀, 𝒰.X b ⟶ P1_R := fun b =>
      match b with
      | false => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_R W₀ hW₀ zero_lt_one
      | true => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_R W₁ hW₁ zero_lt_one
    have hSpecOverlap :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res₀.comp φ₀)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_R W₀ hW₀ zero_lt_one =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res₁.comp φ₁)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_R W₁ hW₁ zero_lt_one := by
      let A₀_R := HomogeneousLocalization.Away 𝒜_R W₀
      let A₀₁_R := HomogeneousLocalization.Away 𝒜_R (W₀ * W₁)
      let ι₀_₀₁ : A₀_R →+* A₀₁_R := HomogeneousLocalization.awayMap 𝒜_R hW₁ rfl
      let ι₁_₀₁ : HomogeneousLocalization.Away 𝒜_R W₁ →+* A₀₁_R :=
        HomogeneousLocalization.awayMap 𝒜_R hW₀ (mul_comm W₀ W₁)
      let : Algebra A₀_R A₀₁_R := ι₀_₀₁.toAlgebra
      let : Algebra A₀_R B₀₁ := (res₀.comp φ₀).toAlgebra
      have hIsLocMul : IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁) A₀₁_R :=
        HomogeneousLocalization.Away.isLocalization_mul hW₀ hW₁ rfl one_ne_zero
      have hUnitU : IsUnit ((res₀.comp φ₀) (HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁)) := by
        have he₀X : e₀.symm (HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁) = Polynomial.X := by
          apply e₀.injective
          rw [RingEquiv.apply_symm_apply]
          exact (Polynomial.eval₂_X _ _).symm
        have hφ₀X : (res₀.comp φ₀) (HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁) = res₀ u := by
          simp only [RingHom.comp_apply, φ₀]
          change res₀ (Polynomial.eval₂ r₀ u (e₀.symm _)) = res₀ u
          rw [he₀X, Polynomial.eval₂_X]
        rw [hφ₀X]
        exact IsUnit.of_mul_eq_one (res₁ v) huv
      let φ₀₁ : A₀₁_R →+* B₀₁ :=
        IsLocalization.Away.lift (HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁)
          (S := A₀₁_R) hUnitU
      have hφ₀₁_0 : φ₀₁.comp ι₀_₀₁ = res₀.comp φ₀ := by
        apply RingHom.ext
        intro x
        exact IsLocalization.Away.lift_eq
          (HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁) (S := A₀₁_R) hUnitU x
      have hφ₀₁_1 : φ₀₁.comp ι₁_₀₁ = res₁.comp φ₁ := by
        have hOnE₁ : (φ₀₁.comp ι₁_₀₁).comp e₁.toRingHom = (res₁.comp φ₁).comp e₁.toRingHom := by
          apply Polynomial.ringHom_ext'
          · ext c
            have he₁C : e₁ (Polynomial.C c) =
                HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers W₁) (algebraMap R ↥(𝒜_R 0) c) :=
              Polynomial.eval₂_C _ _
            have he₀C : e₀ (Polynomial.C c) =
                HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers W₀) (algebraMap R ↥(𝒜_R 0) c) :=
              Polynomial.eval₂_C _ _
            simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
            have hRHS : res₁ (φ₁ (e₁ (Polynomial.C c))) = r₀₁ c := by
              dsimp [φ₁]
              rw [e₁.symm_apply_apply, Polynomial.eval₂_C, ← RingHom.comp_apply, hr₁]
            rw [hRHS, he₁C, HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜_R hW₀ (mul_comm W₀ W₁)]
            rw [← HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜_R hW₁ (f := W₀) (x := W₀ * W₁) rfl]
            rw [← he₀C]
            change (φ₀₁.comp ι₀_₀₁) (e₀ (Polynomial.C c)) = r₀₁ c
            rw [hφ₀₁_0, RingHom.comp_apply]
            dsimp [φ₀]
            rw [e₀.symm_apply_apply, Polynomial.eval₂_C, ← RingHom.comp_apply, hr₀]
          · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
            have he₁X : e₁ Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem hW₁ hW₀ :=
              Polynomial.eval₂_X _ _
            have he₀X : e₀ Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem hW₀ hW₁ :=
              Polynomial.eval₂_X _ _
            have hRHS : res₁ (φ₁ (e₁ Polynomial.X)) = res₁ v := by
              dsimp [φ₁]
              rw [e₁.symm_apply_apply]
              exact congrArg res₁ (Polynomial.eval₂_X r₁ v)
            have hLHS_u : φ₀₁ (ι₀_₀₁ (e₀ Polynomial.X)) = res₀ u := by
              change (φ₀₁.comp ι₀_₀₁) (e₀ Polynomial.X) = res₀ u
              rw [hφ₀₁_0, RingHom.comp_apply]
              dsimp [φ₀]
              rw [e₀.symm_apply_apply]
