    let Kfn : Type u := ↑V₁.left.functionField
    let algKfn : Algebra k Kfn := (κ ⊤ ≫ V₁.left.germToFunctionField ⊤).hom.toAlgebra
    have hAffTop : AlgebraicGeometry.IsAffineOpen (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Opens) :=
