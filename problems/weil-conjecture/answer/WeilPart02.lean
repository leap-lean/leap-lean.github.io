        = ψ (algebraMap R _ x) * ψ (IsLocalization.Away.invSelf x) := by rw [hψ_eq x]
      _ = ψ (algebraMap R _ x * IsLocalization.Away.invSelf x) := (map_mul _ _ _).symm
      _ = ψ 1 := by rw [IsLocalization.Away.mul_invSelf x]
      _ = 1 := map_one _
      _ = algebraMap S _ y * IsLocalization.Away.invSelf y :=
            (IsLocalization.Away.mul_invSelf y).symm
      _ = g x * IsLocalization.Away.invSelf y := by rw [hgx]

  
