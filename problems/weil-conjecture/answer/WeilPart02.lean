      rw [← trdeg_add_eq k K (A := F), htr_KF, Nat.cast_add, Nat.cast_one]
      exact add_le_add_left hTrK 1
    exact ⟨htr_kF, hTr_x₀, hFinF, hSepF⟩
  have h_val : ∀ (K R F : Type u)
      [Field K] [IsSepClosed K]
      [CommRing R] [IsDomain R] [Algebra K R]
      [Field F] [Algebra K F] [Algebra R F] [IsScalarTower K R F] [IsFractionRing R F]
      (ψ : Polynomial K →ₐ[K] R) (_ : ψ.toRingHom.Etale)
      (O_rel : ValuationSubring F) (_ : O_rel ≠ ⊤)
      (_ : ∀ r : R, algebraMap R F r ∈ O_rel),
      let x₀ : F := algebraMap R F (ψ Polynomial.X)
      let Lx₀ : IntermediateField K F := IntermediateField.adjoin K ({x₀} : Set F)
      let Ox₀ : ValuationSubring ↥Lx₀ := O_rel.comap Lx₀.val.toRingHom
      Transcendental K x₀ →
      FiniteDimensional ↥Lx₀ F →
      RingHom.Etale ((Lx₀.val.toRingHom.comp Ox₀.subtype).codRestrict O_rel.toSubring (fun y => y.2)) ∧
