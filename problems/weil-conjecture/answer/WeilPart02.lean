      simpa using this
    have hp_le_𝔪_bar : p_bar ≤ 𝔪_bar := by
      intro x hx
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact Ideal.mem_map_of_mem mk_I (hq_le_𝔪 hx)
