      have hMul : c ⊗ₜ[k] a = (c ⊗ₜ[k] (1 : A)) * ((1 : K) ⊗ₜ[k] a) := by simp
      rw [hMul]
      exact (hIntLeft c).mul (hIntRight a)
    exact ⟨‹_›, g_K, hgK_inj, hgK_int⟩

  
  have h_s3 :
      ∀ (K B : Type u) [Field K] [IsAlgClosed K]
        [CommRing B] [IsDomain B] [Algebra K B] [Algebra.FiniteType K B]
        (s : ℕ), m + 1 ≤ s →
        ∀ (g_K : MvPolynomial (Fin s) K →ₐ[K] B),
        Function.Injective g_K → g_K.IsIntegral →
        ∀ (S : Finset B), S.card ≤ m →
        ∀ (E_spec : Set (PrimeSpectrum (B ⧸ Ideal.span (S : Set B)))),
        E_spec ∈ irreducibleComponents (PrimeSpectrum (B ⧸ Ideal.span (S : Set B))) →
        (1 : WithBot ℕ∞) ≤ topologicalKrullDim ↥E_spec := by
    clear * -
    intro K B _ _ _ _ _ _ s hms g_K hg_inj hg_int S hS E_spec hE
    have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing K B
    let I : Ideal B := Ideal.span (S : Set B)
    have hE_min :
        E_spec ∈ (PrimeSpectrum.zeroLocus ∘ SetLike.coe) '' minimalPrimes (B ⧸ I) := by
      rwa [PrimeSpectrum.zeroLocus_minimalPrimes]
    obtain ⟨p_bar, hp_bar, hp_bar_ZL⟩ := hE_min
    have hp_bar_prime : p_bar.IsPrime := hp_bar.1.1
    let mk_I : B →+* B ⧸ I := Ideal.Quotient.mk I
    let q : Ideal B := Ideal.comap mk_I p_bar
    have hq_min : q ∈ I.minimalPrimes := by
      rw [Ideal.minimalPrimes_eq_comap]
      exact ⟨p_bar, hp_bar, rfl⟩
    have hq_prime : q.IsPrime := hq_min.1.1
    have hq_ht : q.height ≤ (m : ℕ∞) :=
      (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hq_min).trans (Nat.cast_le.mpr hS)
    obtain ⟨𝔪, h𝔪_max, hq_le_𝔪⟩ := Ideal.exists_le_maximal q hq_prime.ne_top
    have h𝔪_prime : 𝔪.IsPrime := h𝔪_max.isPrime
    have h𝔪_ht : ((m + 1 : ℕ) : ℕ∞) ≤ 𝔪.height := by
      obtain ⟨c, hc_eq⟩ : ∃ c : Fin s → K,
          Ideal.comap g_K.toRingHom 𝔪 = MvPolynomial.vanishingIdeal K {c} := by
        let PK := MvPolynomial (Fin s) K
        let : Algebra PK B := g_K.toRingHom.toAlgebra
        have : Algebra.IsIntegral PK B := ⟨hg_int⟩
        have h𝔪₀_max : (Ideal.under PK 𝔪).IsMaximal := Ideal.IsMaximal.under PK 𝔪
        exact (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp h𝔪₀_max
      let π : ∀ r : Fin (s + 1), MvPolynomial (Fin s) K →ₐ[K] MvPolynomial {i : Fin s // r.val ≤ i.val} K :=
        fun r => MvPolynomial.aeval
          (fun i => if h : r.val ≤ i.val then MvPolynomial.X ⟨i, h⟩ else MvPolynomial.C (c i))
      let p_chain : Fin (s + 1) → PrimeSpectrum (MvPolynomial (Fin s) K) :=
        fun r => ⟨RingHom.ker (π r).toRingHom, RingHom.ker_isPrime (π r).toRingHom⟩
      have hp_lt : ∀ r : Fin s, p_chain r.castSucc < p_chain r.succ := by
        intro r
        have hle : p_chain r.castSucc ≤ p_chain r.succ := by
          rw [← PrimeSpectrum.asIdeal_le_asIdeal]
          let ψ_step : MvPolynomial {i : Fin s // r.val ≤ i.val} K →ₐ[K]
              MvPolynomial {i : Fin s // r.val + 1 ≤ i.val} K :=
            MvPolynomial.aeval
              (fun j => if h : r.val + 1 ≤ j.1.val then MvPolynomial.X ⟨j.1, h⟩ else MvPolynomial.C (c j.1))
          have hComp : π r.succ = ψ_step.comp (π r.castSucc) := by
            apply MvPolynomial.algHom_ext
            intro i
            simp only [π, ψ_step, AlgHom.comp_apply, MvPolynomial.aeval_X,
              Fin.val_succ, Fin.val_castSucc]
            split_ifs with h1 h0
            · simp; omega
            · omega
            · simp; intro; omega
            · rw [MvPolynomial.aeval_C]; rfl
          intro f hf
          change (π r.succ) f = 0
          rw [hComp, AlgHom.comp_apply]
          have hf0 : (π r.castSucc) f = 0 := hf
          rw [hf0, map_zero]
        refine lt_of_le_of_ne hle (fun hEq => ?_)
        let u_r : MvPolynomial (Fin s) K := MvPolynomial.X r - MvPolynomial.C (c r)
        have hu_succ : u_r ∈ (p_chain r.succ).asIdeal := by
