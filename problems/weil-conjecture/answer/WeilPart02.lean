          rw [MvPolynomial.aeval_X, MvPolynomial.map_X]
      intro G₁ G₂ hG
      have h0 : (MvPolynomial.aeval C : MvPolynomial I k →ₐ[k] Ω).toRingHom (G₁ - G₂) = 0 := by
        rw [map_sub]
        exact sub_eq_zero.mpr hG
      rw [haeval_eq, RingHom.comp_apply, hπ_P_zero] at h0
      exact sub_eq_zero.mp (hP_bot (G₁ - G₂) h0)

    
    have hf_AB_iff : ∀ a : A, f_AB a ∈ Q.asIdeal ↔ a ∈ P.asIdeal := by
      intro a
      have h := hTrans_Q (Polynomial.C a)
      rw [Polynomial.eval₂_C] at h
      constructor
      · intro ha
        simpa using h.mp ha 0
      · intro ha
        refine h.mpr fun j => ?_
        rcases eq_or_ne j 0 with rfl | hj
        · simpa using ha
        · rw [Polynomial.coeff_C_of_ne_zero hj]
          exact Ideal.zero_mem P.asIdeal
    let D_B : Type u := B ⧸ Q.asIdeal
    have : IsDomain D_B := Ideal.Quotient.isDomain Q.asIdeal
    let L_Q : Type u := FractionRing D_B
    obtain ⟨Λ, instFieldΛ, instAlgClΛ, ι_LQ, _⟩ :
        ∃ (Λ : Type u) (_ : Field Λ) (_ : IsAlgClosed Λ) (_ : L_Q →+* Λ), True :=
      ⟨AlgebraicClosure L_Q, inferInstance, inferInstance, algebraMap L_Q (AlgebraicClosure L_Q), trivial⟩
    let π_Q : B →+* Λ :=
      ι_LQ.comp ((algebraMap D_B L_Q).comp (Ideal.Quotient.mk Q.asIdeal))
    have hπ_Q_zero : ∀ b : B, π_Q b = 0 ↔ b ∈ Q.asIdeal := by
      intro b
      change ι_LQ ((algebraMap D_B L_Q) (Ideal.Quotient.mk Q.asIdeal b)) = 0 ↔ b ∈ Q.asIdeal
      rw [map_eq_zero_iff _ ι_LQ.injective,
          map_eq_zero_iff _ (IsFractionRing.injective D_B L_Q),
          Ideal.Quotient.eq_zero_iff_mem]
    have hDA_ker : ∀ a : A, a ∈ P.asIdeal →
        (((algebraMap D_B L_Q).comp (Ideal.Quotient.mk Q.asIdeal)).comp f_AB) a = 0 := by
      intro a ha
      change (algebraMap D_B L_Q) (Ideal.Quotient.mk Q.asIdeal (f_AB a)) = 0
      rw [map_eq_zero_iff _ (IsFractionRing.injective D_B L_Q), Ideal.Quotient.eq_zero_iff_mem]
      exact (hf_AB_iff a).mpr ha
    let ψ_DA : D_A →+* L_Q :=
      Ideal.Quotient.lift P.asIdeal (((algebraMap D_B L_Q).comp (Ideal.Quotient.mk Q.asIdeal)).comp f_AB) hDA_ker
    have hψ_DA_inj : Function.Injective ψ_DA := by
      intro z₁ z₂ hz
      obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
      obtain ⟨a₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
      have h0 : ψ_DA (Ideal.Quotient.mk P.asIdeal (a₁ - a₂)) = 0 := by
        rw [map_sub, map_sub, hz, sub_self]
      change (algebraMap D_B L_Q) (Ideal.Quotient.mk Q.asIdeal (f_AB (a₁ - a₂))) = 0 at h0
      rw [map_eq_zero_iff _ (IsFractionRing.injective D_B L_Q), Ideal.Quotient.eq_zero_iff_mem, hf_AB_iff] at h0
      exact sub_eq_zero.mp (Ideal.Quotient.eq_zero_iff_mem.mpr h0)
    have hψ_DA_unit : ∀ y : nonZeroDivisors D_A, IsUnit (ψ_DA y) := by
      intro y
      exact isUnit_iff_ne_zero.mpr fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hψ_DA_inj (h0.trans ψ_DA.map_zero.symm))
    let ι_K : K_P →+* L_Q := IsLocalization.lift (M := nonZeroDivisors D_A) hψ_DA_unit
    let θ_K : K_P →+* Λ := ι_LQ.comp ι_K
    let : Algebra K_P Λ := θ_K.toAlgebra
    have : FaithfulSMul K_P Λ :=
      (faithfulSMul_iff_algebraMap_injective K_P Λ).mpr θ_K.injective
    have : Module.IsTorsionFree K_P Λ := FaithfulSMul.to_isTorsionFree K_P Λ
    have : Algebra.IsAlgebraic K_P Ω := IsAlgClosure.isAlgebraic
    let j_alg : Ω →ₐ[K_P] Λ := IsAlgClosed.lift (R := K_P) (S := Ω) (M := Λ)
    let j_Ω : Ω →+* Λ := j_alg.toRingHom
    have hj_Ω_comm : ∀ z : K_P, j_Ω (algebraMap K_P Ω z) = θ_K z := j_alg.commutes
    have hj_π_P : ∀ a : A, j_Ω (π_P a) = π_Q (f_AB a) := by
      intro a
      change j_Ω (algebraMap K_P Ω (algebraMap D_A K_P (Ideal.Quotient.mk P.asIdeal a))) = π_Q (f_AB a)
      rw [hj_Ω_comm]
      change ι_LQ (ι_K (algebraMap D_A K_P (Ideal.Quotient.mk P.asIdeal a))) = π_Q (f_AB a)
      rw [IsLocalization.lift_eq]
      rfl
    let σ_S : S →+* Λ := π_Q.comp MvPolynomial.C
    have hComm_R : ∀ r : R, σ_S (algebraMap R S r) = j_Ω (algebraMap F Ω (φ_F r)) := by
      intro r
      rw [hφ_F_val r, hj_π_P (MvPolynomial.C r)]
      change π_Q (MvPolynomial.C (algebraMap R S r)) = π_Q (MvPolynomial.map (algebraMap R S) (MvPolynomial.C r))
      rw [MvPolynomial.map_C]
    have hSum_Λ : (∑ e : I, σ_S (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * j_Ω (C e)) = 0 := by
      have hterm : ∀ e : I, σ_S (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * j_Ω (C e) =
          π_Q (MvPolynomial.C (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * MvPolynomial.X e) := by
        intro e
        change π_Q (MvPolynomial.C _) * j_Ω (π_P (MvPolynomial.X e)) = _
        rw [hj_π_P (MvPolynomial.X e)]
        change π_Q (MvPolynomial.C _) * π_Q (MvPolynomial.map (algebraMap R S) (MvPolynomial.X e)) = _
        rw [MvPolynomial.map_X, ← map_mul]
      simp_rw [hterm, ← map_sum]
      exact (hπ_Q_zero _).mpr hF_mem
    have hNotAlg_Ω : letI : Algebra Ω Λ := j_Ω.toAlgebra; ¬ IsAlgebraic Ω (σ_S (x ν)) := by
      let : Algebra Ω Λ := j_Ω.toAlgebra
      let : Algebra D_A Λ := (θ_K.comp (algebraMap D_A K_P)).toAlgebra
      have : IsScalarTower K_P Ω Λ :=
        IsScalarTower.of_algebraMap_eq' (RingHom.ext fun z => (hj_Ω_comm z).symm)
      have : IsScalarTower D_A K_P Λ := ⟨fun c x y => by
        have hcx : c • x = algebraMap D_A K_P c * x := by
          rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
        rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, hcx, map_mul, mul_assoc]
        rfl⟩
      have : Algebra.IsIntegral K_P Ω := Algebra.IsAlgebraic.isIntegral
      intro hAlgΩ
      have hIntKP : IsIntegral K_P (σ_S (x ν)) :=
        isIntegral_trans (R := K_P) (A := Ω) (B := Λ) (σ_S (x ν)) (isAlgebraic_iff_isIntegral.mp hAlgΩ)
      have hAlgDA : IsAlgebraic D_A (σ_S (x ν)) :=
        (IsFractionRing.isAlgebraic_iff D_A K_P Λ).mpr (isAlgebraic_iff_isIntegral.mpr hIntKP)
      obtain ⟨p₀_poly, hp₀_ne, hp₀_eval⟩ := hAlgDA
      obtain ⟨g, rfl⟩ := Polynomial.map_surjective (Ideal.Quotient.mk P.asIdeal) Ideal.Quotient.mk_surjective p₀_poly
      have hex_j : ∃ j : ℕ, g.coeff j ∉ P.asIdeal := by
        by_contra hall
        apply hp₀_ne
        ext j
        rw [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
        exact not_not.mp fun hnj => hall ⟨j, hnj⟩
      obtain ⟨j₀, hj₀⟩ := hex_j
      have hDA_hom : (algebraMap D_A Λ).comp (Ideal.Quotient.mk P.asIdeal) = π_Q.comp f_AB :=
        RingHom.ext fun (a : A) => by
          change ι_LQ (ι_K (algebraMap D_A K_P (Ideal.Quotient.mk P.asIdeal a))) = π_Q (f_AB a)
          rw [IsLocalization.lift_eq]
          rfl
      have heval_Q : Polynomial.eval₂ f_AB (MvPolynomial.C (x ν)) g ∈ Q.asIdeal := by
        rw [← hπ_Q_zero, Polynomial.hom_eval₂]
        rw [Polynomial.aeval_def, Polynomial.eval₂_map, hDA_hom] at hp₀_eval
        exact hp₀_eval
      exact hj₀ ((hTrans_Q g).mp heval_Q j₀)
    exact ⟨F, inferInstance, instAlgClF, inferInstance, Ω, inferInstance, inferInstance,
      inferInstance, instAlgFΩ, instTower, φ_F, C, Λ, instFieldΛ, σ_S, j_Ω,
      hTrdegF, hC_inj, hComm_R, hNotAlg_Ω, hSum_Λ⟩

  obtain ⟨F, instFieldF, instAlgClF, instAlgkF, Ω, instFieldΩ, instAlgClΩ, instAlgkΩ,
      instAlgFΩ, instTower, φ_F, C, Λ, instFieldΛ, σ_S, j_Ω,
      hTrdegF, hC_inj, hComm_R, hNotAlg_Ω, hSum_Λ⟩ := hStep1

  
  have hDomTensor : ∀ (C₀ : Type u) [CommRing C₀] [IsDomain C₀] [Algebra F C₀]
      [Algebra.FiniteType F C₀], IsDomain (TensorProduct F C₀ Ω) := by
    intro C₀ _ _ _ _
    obtain ⟨χ₀⟩ := hNullPoint F C₀
    let χ₀_hat : TensorProduct F C₀ Ω →ₐ[F] Ω :=
      Algebra.TensorProduct.lift ((Algebra.ofId F Ω).comp χ₀) (AlgHom.id F Ω) (fun _ _ => Commute.all _ _)
    have : Nontrivial (TensorProduct F C₀ Ω) := χ₀_hat.toRingHom.domain_nontrivial
    let b := Module.Basis.ofVectorSpace F Ω
    let B_bas := Algebra.TensorProduct.basis C₀ b
    have : NoZeroDivisors (TensorProduct F C₀ Ω) := by
      refine ⟨fun {u v} huv => ?_⟩
      rw [or_iff_not_imp_left]
      intro hu
      by_contra hv
      have hBu : B_bas.repr u ≠ 0 := fun h0 => hu (B_bas.repr.injective (h0.trans (map_zero B_bas.repr).symm))
      have hBv : B_bas.repr v ≠ 0 := fun h0 => hv (B_bas.repr.injective (h0.trans (map_zero B_bas.repr).symm))
      obtain ⟨i₀, ha₀⟩ : ∃ i, B_bas.repr u i ≠ 0 := by
        by_contra hall
        exact hBu (Finsupp.ext fun i => not_not.mp fun hi => hall ⟨i, hi⟩)
      obtain ⟨j₀, hb₀⟩ : ∃ j, B_bas.repr v j ≠ 0 := by
        by_contra hall
        exact hBv (Finsupp.ext fun j => not_not.mp fun hj => hall ⟨j, hj⟩)
      let g₀ : C₀ := B_bas.repr u i₀ * B_bas.repr v j₀
      have hg₀ : g₀ ≠ 0 := mul_ne_zero ha₀ hb₀
      let A' : Type u := Localization.Away g₀
      have hpow_le : Submonoid.powers g₀ ≤ nonZeroDivisors C₀ :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg₀)
      have : IsDomain A' := IsLocalization.isDomain_localization hpow_le
      have : Algebra.FinitePresentation C₀ A' := IsLocalization.Away.finitePresentation g₀
      have : Algebra.FiniteType F A' := Algebra.FiniteType.trans (S := C₀) inferInstance inferInstance
      obtain ⟨χ'⟩ := hNullPoint F A'
      let χ : C₀ →ₐ[F] F := χ'.comp (IsScalarTower.toAlgHom F C₀ A')
      have hχ_g₀ : χ g₀ ≠ 0 := by
        intro h0
        have h1 : χ' (algebraMap C₀ A' g₀ * IsLocalization.Away.invSelf (S := A') g₀) = 0 := by
          rw [map_mul]
          change χ g₀ * _ = 0
          rw [h0, zero_mul]
        rw [IsLocalization.Away.mul_invSelf g₀, map_one] at h1
        exact one_ne_zero h1
      have hχ_u : χ (B_bas.repr u i₀) ≠ 0 := fun h0 => hχ_g₀ (by simp [g₀, map_mul, h0])
      have hχ_v : χ (B_bas.repr v j₀) ≠ 0 := fun h0 => hχ_g₀ (by simp [g₀, map_mul, h0])
      let χ_hat : TensorProduct F C₀ Ω →ₐ[F] Ω :=
        Algebra.TensorProduct.lift ((Algebra.ofId F Ω).comp χ) (AlgHom.id F Ω) (fun _ _ => Commute.all _ _)
      have hcoord : ∀ (z : TensorProduct F C₀ Ω) (i : _), b.repr (χ_hat z) i = χ (B_bas.repr z i) := by
        intro z i
        refine TensorProduct.inductionOn z (fun a ω => ?_) (fun z₁ z₂ ih₁ ih₂ => ?_)
        · have h1 : χ_hat (TensorProduct.tmul F a ω) = χ a • ω := by
            change algebraMap F Ω (χ a) * ω = χ a • ω
            rw [Algebra.smul_def]
          have h2 : B_bas.repr (TensorProduct.tmul F a ω) i = a * algebraMap F C₀ (b.repr ω i) := by
            change ((Algebra.TensorProduct.basis C₀ b).repr (TensorProduct.tmul F a ω)) i = _
            rw [Algebra.TensorProduct.basis_repr_tmul]
            simp [smul_eq_mul]
          rw [h1, map_smul, Finsupp.smul_apply, smul_eq_mul, h2, map_mul, AlgHom.commutes]
          rfl
        · rw [map_add, map_add, Finsupp.add_apply, ih₁, ih₂, ← map_add, ← Finsupp.add_apply, ← map_add]
      have hχ_hat_u : χ_hat u ≠ 0 := fun h0 => hχ_u (by rw [← hcoord u i₀, h0, map_zero, Finsupp.zero_apply])
      have hχ_hat_v : χ_hat v ≠ 0 := fun h0 => hχ_v (by rw [← hcoord v j₀, h0, map_zero, Finsupp.zero_apply])
      have hmul0 : χ_hat u * χ_hat v = 0 := by rw [← map_mul, huv, map_zero]
      exact mul_ne_zero hχ_hat_u hχ_hat_v hmul0
    exact NoZeroDivisors.to_isDomain (TensorProduct F C₀ Ω)

  
  have hDescent : ∃ (A₀ : Type u) (_ : CommRing A₀) (_ : IsDomain A₀) (_ : Algebra F A₀)
      (_ : Algebra.FiniteType F A₀) (y : Fin (M₀ + 1) → A₀),
      y μ = 1 ∧
      ¬ IsAlgebraic F (y ν) ∧
      (∑ e : I,
        TensorProduct.tmul F (∏ α : Fin (M₀ + 1), (y α) ^ (e.1 α : ℕ)) (C e) :
          TensorProduct F A₀ Ω) = 0 := by
    let φ_Ω : R →+* Ω := (algebraMap F Ω).comp φ_F
    let : Algebra R F := φ_F.toAlgebra
    let : Algebra R Ω := φ_Ω.toAlgebra
    have : IsScalarTower R F Ω := IsScalarTower.of_algebraMap_eq' rfl
    let β_Ω : TensorProduct R S Ω →+* Λ := by
      letI : Algebra R Λ := (σ_S.comp (algebraMap R S)).toAlgebra
      let σ_alg : S →ₐ[R] Λ := { σ_S with commutes' := fun _ => rfl }
      let j_algR : Ω →ₐ[R] Λ := { j_Ω with commutes' := fun r => (hComm_R r).symm }
      exact (Algebra.TensorProduct.lift σ_alg j_algR (fun _ _ => Commute.all _ _)).toRingHom
    have hβ_tmul : ∀ (s : S) (ω : Ω), β_Ω (TensorProduct.tmul R s ω) = σ_S s * j_Ω ω := by
      intro s ω
      let : Algebra R Λ := (σ_S.comp (algebraMap R S)).toAlgebra
      let σ_alg : S →ₐ[R] Λ := { σ_S with commutes' := fun _ => rfl }
      let j_algR : Ω →ₐ[R] Λ := { j_Ω with commutes' := fun r => (hComm_R r).symm }
      exact Algebra.TensorProduct.lift_tmul σ_alg j_algR (fun _ _ => Commute.all _ _) s ω

    
    let J : Ideal (TensorProduct R S Ω) := RingHom.ker β_Ω
    have : J.IsPrime := RingHom.ker_isPrime β_Ω
    let Q_tilde : PrimeSpectrum (TensorProduct R S Ω) := ⟨J, inferInstance⟩
    have hExLt : ∃ M : PrimeSpectrum (TensorProduct R S Ω), Q_tilde < M := by
      let E_Ω : Type u := TensorProduct R S Ω ⧸ J
      have : IsDomain E_Ω := Ideal.Quotient.isDomain J
      obtain ⟨𝔪_bar, h𝔪_bar_max⟩ := Ideal.exists_maximal E_Ω
      let 𝔪₀ : Ideal (TensorProduct R S Ω) := Ideal.comap (Ideal.Quotient.mk J) 𝔪_bar
      have h𝔪₀_max : 𝔪₀.IsMaximal :=
        Ideal.comap_isMaximal_of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
      let M : PrimeSpectrum (TensorProduct R S Ω) := ⟨𝔪₀, h𝔪₀_max.isPrime⟩
      have hQ_le_M : Q_tilde ≤ M := by
        intro z hz
        change Ideal.Quotient.mk J z ∈ 𝔪_bar
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hz]
        exact Ideal.zero_mem 𝔪_bar
      refine ⟨M, lt_of_le_not_ge hQ_le_M ?_⟩
      intro hM_le_Q
      have h𝔪_bar_bot : 𝔪_bar = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro w hw
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective w
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hM_le_Q hw)
      have hbot_max : (⊥ : Ideal E_Ω).IsMaximal := h𝔪_bar_bot ▸ h𝔪_bar_max
      let : Algebra Ω (TensorProduct R S Ω) := Algebra.TensorProduct.rightAlgebra
      let Φ_Ω : MvPolynomial (Fin (M₀ + 1)) Ω →ₐ[Ω] E_Ω :=
        MvPolynomial.aeval (fun α => Ideal.Quotient.mk J (TensorProduct.tmul R (x α) (1 : Ω)))
      have hΦ_Ω_R : ∀ p : MvPolynomial (Fin (M₀ + 1)) R,
          Φ_Ω (MvPolynomial.map (algebraMap R Ω) p) =
            Ideal.Quotient.mk J (TensorProduct.tmul R (MvPolynomial.aeval x p) (1 : Ω)) := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C r =>
          rw [MvPolynomial.map_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C]
          change Ideal.Quotient.mk J (TensorProduct.tmul R (1 : S) (algebraMap R Ω r)) =
            Ideal.Quotient.mk J (TensorProduct.tmul R (algebraMap R S r) (1 : Ω))
          congr 1
          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
          exact (TensorProduct.smul_tmul r (1 : S) (1 : Ω)).symm
        | add p₁ p₂ ih₁ ih₂ =>
          rw [map_add, map_add, ih₁, ih₂, map_add, TensorProduct.add_tmul, map_add]
        | mul_X p₁ α ih =>
          rw [map_mul, MvPolynomial.map_X, map_mul, ih, MvPolynomial.aeval_X,
              map_mul, MvPolynomial.aeval_X, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      have hΦ_Ω_surj : Function.Surjective Φ_Ω := by
        intro w
        obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective w
        refine TensorProduct.inductionOn u (fun s ω => ?_) (fun u₁ u₂ ih₁ ih₂ => ?_)
        · obtain ⟨p, rfl⟩ := hx_surj s
          refine ⟨MvPolynomial.map (algebraMap R Ω) p * MvPolynomial.C ω, ?_⟩
          rw [map_mul, hΦ_Ω_R, MvPolynomial.aeval_C]
          change Ideal.Quotient.mk J (TensorProduct.tmul R (MvPolynomial.aeval x p) 1) *
              Ideal.Quotient.mk J (TensorProduct.tmul R 1 ω) = _
          rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
        · obtain ⟨q₁, hq₁⟩ := ih₁
          obtain ⟨q₂, hq₂⟩ := ih₂
          exact ⟨q₁ + q₂, by rw [map_add Φ_Ω, hq₁, hq₂, map_add]⟩
      have : Algebra.FiniteType Ω E_Ω := Algebra.FiniteType.of_surjective Φ_Ω hΦ_Ω_surj
      obtain ⟨χ_Ω⟩ := hNullPoint Ω E_Ω
      have hker_bot : RingHom.ker χ_Ω.toRingHom = ⊥ :=
        (hbot_max.eq_of_le (RingHom.ker_ne_top χ_Ω.toRingHom) bot_le).symm
      have hχ_Ω_inj : Function.Injective χ_Ω := by
        intro u₁ u₂ hu
        have hmem : u₁ - u₂ ∈ RingHom.ker χ_Ω.toRingHom := by
          change χ_Ω (u₁ - u₂) = 0
          rw [map_sub, hu, sub_self]
        rw [hker_bot, Submodule.mem_bot] at hmem
        exact sub_eq_zero.mp hmem
      let w_ν : E_Ω := Ideal.Quotient.mk J (TensorProduct.tmul R (x ν) (1 : Ω))
      let c_ν : Ω := χ_Ω w_ν
      have hw_eq : w_ν = Ideal.Quotient.mk J (TensorProduct.tmul R (1 : S) c_ν) := by
        apply hχ_Ω_inj
        change c_ν = χ_Ω (algebraMap Ω E_Ω c_ν)
        exact (χ_Ω.commutes c_ν).symm
      have hsub_mem : TensorProduct.tmul R (x ν) (1 : Ω) - TensorProduct.tmul R (1 : S) c_ν ∈ J :=
        Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, sub_eq_zero]; exact hw_eq)
      have hσ_eq : σ_S (x ν) = j_Ω c_ν := by
        have hβ0 : β_Ω (TensorProduct.tmul R (x ν) (1 : Ω) - TensorProduct.tmul R (1 : S) c_ν) = 0 := hsub_mem
        rw [map_sub, hβ_tmul, hβ_tmul, map_one, mul_one, map_one, one_mul, sub_eq_zero] at hβ0
        exact hβ0
      let : Algebra Ω Λ := j_Ω.toAlgebra
      apply hNotAlg_Ω
      refine ⟨Polynomial.X - Polynomial.C c_ν, Polynomial.X_sub_C_ne_zero c_ν, ?_⟩
      rw [hσ_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      exact sub_self (j_Ω c_ν)
    obtain ⟨M, hQ_lt_M⟩ := hExLt
    have hMin_Q : IsMin Q_tilde := hMin_Ω Ω φ_Ω Q_tilde M hQ_lt_M

    
    let B_F : Type u := TensorProduct R F S
    let ι_S : S →ₐ[R] B_F := Algebra.TensorProduct.includeRight
    let Φ_F : MvPolynomial (Fin (M₀ + 1)) F →ₐ[F] B_F :=
      MvPolynomial.aeval (fun α => ι_S (x α))
    have hΦ_F_R : ∀ p : MvPolynomial (Fin (M₀ + 1)) R,
        Φ_F (MvPolynomial.map (algebraMap R F) p) = ι_S (MvPolynomial.aeval x p) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r =>
        rw [MvPolynomial.map_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C]
        change TensorProduct.tmul R (algebraMap R F r) (1 : S) =
          TensorProduct.tmul R (1 : F) (algebraMap R S r)
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
        exact TensorProduct.smul_tmul r (1 : F) (1 : S)
      | add p₁ p₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂, map_add, map_add]
      | mul_X p₁ α ih =>
        rw [map_mul, MvPolynomial.map_X, map_mul, ih, MvPolynomial.aeval_X,
            map_mul, MvPolynomial.aeval_X, map_mul]
    have hΦ_F_surj : Function.Surjective Φ_F := by
      intro b
      refine TensorProduct.inductionOn b (fun c s => ?_) (fun b₁ b₂ ih₁ ih₂ => ?_)
      · obtain ⟨p, rfl⟩ := hx_surj s
        refine ⟨MvPolynomial.C c * MvPolynomial.map (algebraMap R F) p, ?_⟩
        rw [map_mul, MvPolynomial.aeval_C, hΦ_F_R]
        change TensorProduct.tmul R c (1 : S) * TensorProduct.tmul R (1 : F) (MvPolynomial.aeval x p) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · obtain ⟨q₁, hq₁⟩ := ih₁
        obtain ⟨q₂, hq₂⟩ := ih₂
        exact ⟨q₁ + q₂, by rw [map_add Φ_F, hq₁, hq₂]⟩
    have : Algebra.FiniteType F B_F := Algebra.FiniteType.of_surjective Φ_F hΦ_F_surj

    let κ : TensorProduct F B_F Ω ≃+* TensorProduct R S Ω :=
      (Algebra.TensorProduct.comm F B_F Ω).toRingEquiv.trans
        (((Algebra.TensorProduct.cancelBaseChange R F F Ω S).toRingEquiv).trans
          (Algebra.TensorProduct.comm R Ω S).toRingEquiv)
    have hκ_tmul : ∀ (c : F) (s : S) (ω : Ω),
        κ (TensorProduct.tmul F (TensorProduct.tmul R c s) ω) =
          TensorProduct.tmul R s (algebraMap F Ω c * ω) := by
      intro c s ω
      change (Algebra.TensorProduct.comm R Ω S)
        ((Algebra.TensorProduct.cancelBaseChange R F F Ω S)
          ((Algebra.TensorProduct.comm F B_F Ω)
            (TensorProduct.tmul F (TensorProduct.tmul R c s) ω))) = _
      rw [Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.cancelBaseChange_tmul,
          Algebra.TensorProduct.comm_tmul, Algebra.smul_def]
    let γ : TensorProduct F B_F Ω →+* Λ := β_Ω.comp κ.toRingHom
    let Q' : PrimeSpectrum (TensorProduct F B_F Ω) := ⟨RingHom.ker γ, RingHom.ker_isPrime γ⟩
    have hMin_Q' : IsMin Q' := by
      intro R' hR'_le
      let R_Ω : PrimeSpectrum (TensorProduct R S Ω) := PrimeSpectrum.comap κ.symm.toRingHom R'
      have hR_Ω_le : R_Ω ≤ Q_tilde := by
        intro u hu
        change β_Ω u = 0
        have hu' : κ.symm u ∈ R'.asIdeal := hu
        have hγ0 : γ (κ.symm u) = 0 := hR'_le hu'
        change β_Ω (κ (κ.symm u)) = 0 at hγ0
        rwa [RingEquiv.apply_symm_apply] at hγ0
      have hQ_le_R_Ω : Q_tilde ≤ R_Ω := hMin_Q hR_Ω_le
      intro z hz
      have hκz : κ z ∈ Q_tilde.asIdeal := hz
      have hκz_R : κ.symm (κ z) ∈ R'.asIdeal := hQ_le_R_Ω hκz
      rwa [RingEquiv.symm_apply_apply] at hκz_R

    
    let ι_L : B_F →+* TensorProduct F B_F Ω := Algebra.TensorProduct.includeLeftRingHom
    let q₀ : Ideal B_F := RingHom.ker (γ.comp ι_L)
    have : q₀.IsPrime := RingHom.ker_isPrime (γ.comp ι_L)
    let A₀ : Type u := B_F ⧸ q₀
    have : IsDomain A₀ := Ideal.Quotient.isDomain q₀
    have : Algebra.FiniteType F A₀ :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ F q₀) Ideal.Quotient.mk_surjective
    have : IsDomain (TensorProduct F A₀ Ω) := hDomTensor A₀
    let π₀ : TensorProduct F B_F Ω →ₐ[F] TensorProduct F A₀ Ω :=
      Algebra.TensorProduct.map (Ideal.Quotient.mkₐ F q₀) (AlgHom.id F Ω)
    have hπ₀_surj : Function.Surjective π₀ := by
      intro w
      refine TensorProduct.inductionOn w (fun a ω => ?_) (fun w₁ w₂ ih₁ ih₂ => ?_)
      · obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
        exact ⟨TensorProduct.tmul F b ω, Algebra.TensorProduct.map_tmul _ _ b ω⟩
      · obtain ⟨z₁, hz₁⟩ := ih₁
        obtain ⟨z₂, hz₂⟩ := ih₂
        exact ⟨z₁ + z₂, by rw [map_add π₀, hz₁, hz₂]⟩
    have hγ_F : ∀ c : F, (γ.comp ι_L) (algebraMap F B_F c) = j_Ω (algebraMap F Ω c) := by
      intro c
      change β_Ω (κ (TensorProduct.tmul F (TensorProduct.tmul R c (1 : S)) (1 : Ω))) = _
      rw [hκ_tmul, mul_one, hβ_tmul, map_one, one_mul]
    let γ_bar : TensorProduct F A₀ Ω →+* Λ := by
      letI : Algebra F Λ := (j_Ω.comp (algebraMap F Ω)).toAlgebra
      let γ_L_ring : A₀ →+* Λ := Ideal.Quotient.lift q₀ (γ.comp ι_L) (fun _ h => h)
      let γ_L_alg : A₀ →ₐ[F] Λ := {
        γ_L_ring with
        commutes' := fun c => hγ_F c
      }
      let j_algF : Ω →ₐ[F] Λ := {
        j_Ω with
        commutes' := fun _ => rfl
      }
      exact (Algebra.TensorProduct.lift γ_L_alg j_algF (fun _ _ => Commute.all _ _)).toRingHom
    have hγ_bar_tmul : ∀ (b : B_F) (ω : Ω),
        γ_bar (TensorProduct.tmul F (Ideal.Quotient.mk q₀ b) ω) = γ (ι_L b) * j_Ω ω := by
      intro b ω
      let : Algebra F Λ := (j_Ω.comp (algebraMap F Ω)).toAlgebra
      let γ_L_ring : A₀ →+* Λ := Ideal.Quotient.lift q₀ (γ.comp ι_L) (fun _ h => h)
      let γ_L_alg : A₀ →ₐ[F] Λ := { γ_L_ring with commutes' := fun c => hγ_F c }
      let j_algF : Ω →ₐ[F] Λ := { j_Ω with commutes' := fun _ => rfl }
      exact Algebra.TensorProduct.lift_tmul γ_L_alg j_algF (fun _ _ => Commute.all _ _) (Ideal.Quotient.mk q₀ b) ω
    have hγ_comp : ∀ z : TensorProduct F B_F Ω, γ_bar (π₀ z) = γ z := by
      intro z
      refine TensorProduct.inductionOn z (fun b ω => ?_) (fun z₁ z₂ ih₁ ih₂ => ?_)
      · rw [Algebra.TensorProduct.map_tmul]
        change γ_bar (TensorProduct.tmul F (Ideal.Quotient.mk q₀ b) ω) = γ (TensorProduct.tmul F b ω)
        rw [hγ_bar_tmul]
        have hmul : TensorProduct.tmul F b ω = ι_L b * TensorProduct.tmul F (1 : B_F) ω := by
          change TensorProduct.tmul F b ω = TensorProduct.tmul F b 1 * TensorProduct.tmul F 1 ω
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        have hright : γ (TensorProduct.tmul F (1 : B_F) ω) = j_Ω ω := by
          change β_Ω (κ (TensorProduct.tmul F (TensorProduct.tmul R (1 : F) (1 : S)) ω)) = j_Ω ω
          rw [hκ_tmul, map_one, one_mul, hβ_tmul, map_one, one_mul]
        rw [hmul, map_mul, hright]
      · rw [map_add π₀, map_add γ_bar, ih₁, ih₂, map_add γ]
    have hγ_inj : Function.Injective γ_bar := by
      let K_π₀ : PrimeSpectrum (TensorProduct F B_F Ω) :=
        ⟨RingHom.ker π₀.toRingHom, RingHom.ker_isPrime π₀.toRingHom⟩
      have hK_le : K_π₀ ≤ Q' := by
        intro z hz
        have hz0 : π₀ z = 0 := hz
        change γ z = 0
        rw [← hγ_comp z, hz0, map_zero]
      have hQ'_le : Q' ≤ K_π₀ := hMin_Q' hK_le
      intro w₁ w₂ hw
      obtain ⟨z, hz⟩ := hπ₀_surj (w₁ - w₂)
      have hγz : γ z = 0 := by
        rw [← hγ_comp z, hz, map_sub, hw, sub_self]
      have hπz : π₀ z = 0 := hQ'_le hγz
      exact sub_eq_zero.mp (hz.symm.trans hπz)

    
    let ψ_S : S →+* A₀ := (Ideal.Quotient.mk q₀).comp ι_S.toRingHom
    let y : Fin (M₀ + 1) → A₀ := fun α => ψ_S (x α)
    have hγ_psi : ∀ (s : S) (ω : Ω),
        γ_bar (TensorProduct.tmul F (ψ_S s) ω) = σ_S s * j_Ω ω := by
      intro s ω
      change γ_bar (TensorProduct.tmul F (Ideal.Quotient.mk q₀ (ι_S s)) ω) = _
      rw [hγ_bar_tmul]
      change β_Ω (κ (TensorProduct.tmul F (TensorProduct.tmul R (1 : F) s) (1 : Ω))) * j_Ω ω = _
      rw [hκ_tmul, map_one, one_mul, hβ_tmul, map_one, mul_one]
    have hγ_alg : ∀ c : F,
        γ_bar (TensorProduct.tmul F (algebraMap F A₀ c) (1 : Ω)) = j_Ω (algebraMap F Ω c) := by
      intro c
      change γ_bar (TensorProduct.tmul F (Ideal.Quotient.mk q₀ (algebraMap F B_F c)) 1) = _
      rw [hγ_bar_tmul, map_one, mul_one]
      exact hγ_F c
    refine ⟨A₀, inferInstance, inferInstance, inferInstance, inferInstance, y, ?_, ?_, ?_⟩
    · change ψ_S (x μ) = 1
      rw [hx_mu, map_one]
    · rintro ⟨f, hf_ne, hf_eval⟩
      let θ_A : A₀ →+* Λ := γ_bar.comp Algebra.TensorProduct.includeLeftRingHom
      have hθ_F : θ_A.comp (algebraMap F A₀) = j_Ω.comp (algebraMap F Ω) := by
        ext c
        exact hγ_alg c
      have hθ_y : θ_A (y ν) = σ_S (x ν) := by
        change γ_bar (TensorProduct.tmul F (ψ_S (x ν)) (1 : Ω)) = σ_S (x ν)
        rw [hγ_psi, map_one, mul_one]
      let : Algebra Ω Λ := j_Ω.toAlgebra
      apply hNotAlg_Ω
      have hf_Ω_ne : Polynomial.map (algebraMap F Ω) f ≠ 0 := fun h0 =>
        hf_ne (Polynomial.map_injective (algebraMap F Ω) (RingHom.injective (algebraMap F Ω))
          (h0.trans (Polynomial.map_zero (algebraMap F Ω)).symm))
      refine ⟨Polynomial.map (algebraMap F Ω) f, hf_Ω_ne, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      change Polynomial.eval₂ (j_Ω.comp (algebraMap F Ω)) (σ_S (x ν)) f = 0
      rw [← hθ_F, ← hθ_y, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, hf_eval, map_zero]
    · apply hγ_inj
      rw [map_zero, map_sum]
      have hprod_eq : ∀ e : I, (∏ α : Fin (M₀ + 1), (y α) ^ (e.1 α : ℕ)) =
          ψ_S (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) := by
        intro e
        rw [map_prod]
        refine Finset.prod_congr rfl fun α _ => ?_
        rw [map_pow]
      simp_rw [hprod_eq, hγ_psi]
      exact hSum_Λ

  obtain ⟨A₀, instCommA₀, instDomA₀, instAlgFA₀, instFTA₀, y, hy_mu, hy_nu, hRel⟩ := hDescent
  exact ⟨F, instFieldF, instAlgClF, instAlgkF, Ω, instFieldΩ, instAlgkΩ, instAlgFΩ, instTower,
    C, A₀, instCommA₀, instDomA₀, instAlgFA₀, instFTA₀, y, hTrdegF, hC_inj, hy_mu, hy_nu, hRel⟩

theorem weil_algClosed_vandermonde_trdeg_contradiction (k : Type u) [Field k] (m M₀ d₀ : ℕ)
    (hd₀ : m ≤ d₀)
    (μ ν : Fin (M₀ + 1))
    (F : Type u) [Field F] [IsAlgClosed F] [Algebra k F]
    (hTrdegF : Algebra.trdeg k F ≤ (m : Cardinal.{u}))
    (Ω : Type u) [Field Ω] [Algebra k Ω] [Algebra F Ω] [IsScalarTower k F Ω]
    (C : weilDegMonomialIdx M₀ d₀ → Ω)
    (hC_inj : Function.Injective (MvPolynomial.aeval C : MvPolynomial (weilDegMonomialIdx M₀ d₀) k →ₐ[k] Ω))
    (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [Algebra F A₀] [Algebra.FiniteType F A₀]
    (y : Fin (M₀ + 1) → A₀)
    (hy_mu : y μ = 1)
    (hy_nu : ¬ IsAlgebraic F (y ν))
    (hRel : (∑ e : weilDegMonomialIdx M₀ d₀,
      TensorProduct.tmul F (∏ α : Fin (M₀ + 1), (y α) ^ (e.1 α : ℕ)) (C e) :
        TensorProduct F A₀ Ω) = 0) :
    False :=
by
  classical
  have hνμ : ν ≠ μ := by
    rintro rfl
    have h1 : y ν = algebraMap F A₀ 1 := by simpa using hy_mu
    exact hy_nu (h1 ▸ isAlgebraic_algebraMap (1 : F))
  let φ_T : Polynomial F →ₐ[F] A₀ := Polynomial.aeval (y ν)
  have hFP : φ_T.toRingHom.FinitePresentation := by
    letI : Algebra (Polynomial F) A₀ := φ_T.toRingHom.toAlgebra
    have : IsScalarTower F (Polynomial F) A₀ :=
      IsScalarTower.of_algebraMap_eq fun r => (φ_T.commutes r).symm
    have hFT_alg : Algebra.FiniteType (Polynomial F) A₀ :=
      Algebra.FiniteType.of_restrictScalars_finiteType F (Polynomial F) A₀
    have hFT : φ_T.toRingHom.FiniteType := hFT_alg
    exact RingHom.FinitePresentation.of_finiteType.mp hFT
  let η_A₀ : PrimeSpectrum A₀ := ⟨⊥, inferInstance⟩
  let η_T : PrimeSpectrum (Polynomial F) := PrimeSpectrum.comap φ_T.toRingHom η_A₀
  have hη_bot : η_T.asIdeal = ⊥ := by
    refine le_antisymm (fun p hp => ?_) bot_le
    have hp0 : Polynomial.aeval (y ν) p = 0 := by
      simpa [η_T, η_A₀, φ_T, PrimeSpectrum.comap_asIdeal] using hp
    by_contra hp_ne
    have hp_ne' : p ≠ 0 := fun h => hp_ne (by simp [h])
    exact hy_nu ⟨p, hp_ne', hp0⟩
  have hConstr : Topology.IsConstructible (Set.range (PrimeSpectrum.comap φ_T.toRingHom)) :=
    PrimeSpectrum.isConstructible_range_comap hFP
  obtain ⟨S_data, hS_data⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hConstr
  have hη_mem : η_T ∈ S_data.toSet := by
    rw [hS_data]
    exact ⟨η_A₀, rfl⟩
  simp only [PrimeSpectrum.ConstructibleSetData.toSet, Set.mem_iUnion] at hη_mem
  obtain ⟨B₀, hB₀_mem, hη_B₀⟩ := hη_mem
  have hη_zl_g : Set.range B₀.g ⊆ (⊥ : Ideal (Polynomial F)) := by
    have h1 := hη_B₀.1
    rw [PrimeSpectrum.mem_zeroLocus, hη_bot] at h1
    exact h1
  have hf_ne : B₀.f ≠ 0 := by
    intro hf0
    apply hη_B₀.2
    rw [PrimeSpectrum.mem_zeroLocus, hη_bot, Set.singleton_subset_iff]
    simpa using hf0
  have h_lift : ∀ P : PrimeSpectrum (Polynomial F),
      B₀.f ∉ P.asIdeal → P ∈ Set.range (PrimeSpectrum.comap φ_T.toRingHom) := by
    intro P hPf
    rw [← hS_data]
    simp only [PrimeSpectrum.ConstructibleSetData.toSet, Set.mem_iUnion]
    refine ⟨B₀, hB₀_mem, ?_, ?_⟩
    · rw [PrimeSpectrum.mem_zeroLocus]
      exact Set.Subset.trans hη_zl_g (bot_le : (⊥ : Ideal (Polynomial F)) ≤ P.asIdeal)
    · rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
      exact hPf
  have : Infinite F := IsAlgClosed.instInfinite
  let U_F : Set F := Set.univ \ (B₀.f.roots.toFinset : Set F)
  have hU_inf : U_F.Infinite := Set.infinite_univ.sdiff (Finset.finite_toSet _)
  let emb := hU_inf.natEmbedding
  let a : Fin (d₀ + 1) → F := fun q => (emb q.1).1
  have ha_inj : Function.Injective a := by
    intro q₁ q₂ hq
    exact Fin.ext (emb.injective (Subtype.ext hq))
  have ha_eval : ∀ q : Fin (d₀ + 1), Polynomial.eval (a q) B₀.f ≠ 0 := by
    intro q h_ev0
    have h_mem : a q ∈ (B₀.f.roots.toFinset : Set F) := by
      rw [Finset.mem_coe, Multiset.mem_toFinset, Polynomial.mem_roots hf_ne]
      exact h_ev0
    exact (emb q.1).2.2 h_mem
  obtain ⟨n₀, π₀, hπ₀⟩ :=
    Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType F A₀›
  have h_exists_ev : ∀ q : Fin (d₀ + 1), ∃ ev_q : A₀ →ₐ[F] F, ev_q (y ν) = a q := by
    intro q
    let m_q : PrimeSpectrum (Polynomial F) :=
      ⟨RingHom.ker (Polynomial.evalRingHom (a q)),
        RingHom.ker_isPrime (Polynomial.evalRingHom (a q))⟩
    have hm_q : B₀.f ∉ m_q.asIdeal := by
      change Polynomial.evalRingHom (a q) B₀.f ≠ 0
      simpa using ha_eval q
    obtain ⟨p_q, hp_q⟩ := h_lift m_q hm_q
    obtain ⟨M_q, hM_q_max, hpM⟩ := Ideal.exists_le_maximal p_q.asIdeal p_q.isPrime.ne_top
    have : M_q.IsMaximal := hM_q_max
    let N_q : Ideal (MvPolynomial (Fin n₀) F) := Ideal.comap π₀.toRingHom M_q
    have hNq_max : N_q.IsMaximal := Ideal.comap_isMaximal_of_surjective π₀.toRingHom hπ₀
    obtain ⟨z_q, hz_q⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hNq_max
    have hker_le : ∀ P ∈ RingHom.ker π₀, MvPolynomial.aeval z_q P = 0 := by
      intro P hP
      rw [← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← hz_q]
      change π₀ P ∈ M_q
      have hP0 : π₀ P = 0 := hP
      rw [hP0]
      exact M_q.zero_mem
    let ev_quot : (MvPolynomial (Fin n₀) F ⧸ RingHom.ker π₀) →ₐ[F] F :=
      Ideal.Quotient.liftₐ (RingHom.ker π₀) (MvPolynomial.aeval z_q) hker_le
    let ev_q : A₀ →ₐ[F] F :=
      ev_quot.comp (Ideal.quotientKerAlgEquivOfSurjective hπ₀).symm.toAlgHom
    have hev_π₀ : ∀ P : MvPolynomial (Fin n₀) F, ev_q (π₀ P) = MvPolynomial.aeval z_q P := by
      intro P
      have hsymm : (Ideal.quotientKerAlgEquivOfSurjective hπ₀).symm (π₀ P) =
          Ideal.Quotient.mk (RingHom.ker π₀) P := by
        apply (Ideal.quotientKerAlgEquivOfSurjective hπ₀).injective
        simp
      simp [ev_q, ev_quot, hsymm]
    have hev_Mq : ∀ u ∈ M_q, ev_q u = 0 := by
      intro u hu
      obtain ⟨P, rfl⟩ := hπ₀ u
      rw [hev_π₀, ← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← hz_q]
      exact hu
    refine ⟨ev_q, ?_⟩
    have h_lin_mem : Polynomial.X - Polynomial.C (a q) ∈ m_q.asIdeal := by
      change Polynomial.evalRingHom (a q) (Polynomial.X - Polynomial.C (a q)) = 0
      simp
    rw [← hp_q] at h_lin_mem
    have h_diff_mem : φ_T (Polynomial.X - Polynomial.C (a q)) ∈ M_q :=
      hpM h_lin_mem
    have h_ev_diff : ev_q (φ_T (Polynomial.X - Polynomial.C (a q))) = 0 :=
      hev_Mq _ h_diff_mem
    have h_calc : ev_q (φ_T (Polynomial.X - Polynomial.C (a q))) = ev_q (y ν) - a q := by
      simp [φ_T]
    exact sub_eq_zero.mp (h_calc.symm.trans h_ev_diff)
  choose ev hev_nu using h_exists_ev
  let w : Fin (d₀ + 1) → Fin (M₀ + 1) → F := fun q α => ev q (y α)
  have hw_mu : ∀ q : Fin (d₀ + 1), w q μ = 1 := by
    intro q
    simp [w, hy_mu]
  have hw_nu : ∀ q : Fin (d₀ + 1), w q ν = a q := hev_nu
  have hLin : ∀ q : Fin (d₀ + 1),
      ∑ e : weilDegMonomialIdx M₀ d₀,
        (∏ α : Fin (M₀ + 1), (w q α) ^ (e.1 α : ℕ)) • C e = 0 := by
    intro q
    let L_q : TensorProduct F A₀ Ω →ₗ[F] Ω :=
      TensorProduct.lift ((LinearMap.lsmul F Ω).comp (ev q).toLinearMap)
    have h0 := congr_arg L_q hRel
    simpa [L_q, w, map_sum, map_prod, map_pow] using h0
  let I := weilDegMonomialIdx M₀ d₀
  let ε_fun : Fin (d₀ + 1) → Fin (M₀ + 1) → Fin (d₀ + 1) :=
    fun j α => if α = μ then ⟨d₀ - j.1, by omega⟩ else if α = ν then j else 0
  have hε_fun_val : ∀ (j : Fin (d₀ + 1)) (α : Fin (M₀ + 1)),
      (ε_fun j α : ℕ) = (if α = μ then d₀ - j.1 else 0) + (if α = ν then j.1 else 0) := by
    intro j α
    dsimp [ε_fun]
    by_cases hαμ : α = μ
    · subst hαμ
      simp [hνμ.symm]
    · by_cases hαν : α = ν
      · subst hαν
        simp [hαμ]
      · simp [hαμ, hαν]
  let ε : Fin (d₀ + 1) → I := fun j =>
    ⟨ε_fun j, by
      simp_rw [hε_fun_val j]
      rw [Finset.sum_add_distrib, Finset.sum_ite_eq' Finset.univ μ, Finset.sum_ite_eq' Finset.univ ν]
      simp only [Finset.mem_univ, ↓reduceIte]
      omega⟩
  have hε_val : ∀ (j : Fin (d₀ + 1)) (α : Fin (M₀ + 1)),
      ((ε j).1 α : ℕ) = (if α = μ then d₀ - j.1 else 0) + (if α = ν then j.1 else 0) :=
    hε_fun_val
  have hε_inj : Function.Injective ε := by
    intro j₁ j₂ h_eq
    have h₁ := hε_val j₁ ν
    have h₂ := hε_val j₂ ν
    rw [h_eq] at h₁
    simp only [hνμ, ↓reduceIte, zero_add] at h₁ h₂
    exact Fin.ext (h₁.symm.trans h₂)
  have hε_prod : ∀ q j : Fin (d₀ + 1),
      (∏ α : Fin (M₀ + 1), (w q α) ^ ((ε j).1 α : ℕ)) = Matrix.vandermonde a q j := by
    intro q j
    simp_rw [hε_val j, pow_add]
    rw [Finset.prod_mul_distrib]
    have hp₁ : (∏ α : Fin (M₀ + 1), (w q α) ^ (if α = μ then d₀ - j.1 else 0)) = 1 := by
      have h_ite₁ : ∀ α : Fin (M₀ + 1),
          (w q α) ^ (if α = μ then d₀ - j.1 else 0) = if α = μ then (w q α) ^ (d₀ - j.1) else 1 := by
        intro α; split_ifs <;> simp
      simp_rw [h_ite₁]
      rw [Finset.prod_ite_eq' Finset.univ μ]
      simp [hw_mu q]
    have hp₂ : (∏ α : Fin (M₀ + 1), (w q α) ^ (if α = ν then j.1 else 0)) = (a q) ^ j.1 := by
      have h_ite₂ : ∀ α : Fin (M₀ + 1),
          (w q α) ^ (if α = ν then j.1 else 0) = if α = ν then (w q α) ^ j.1 else 1 := by
        intro α; split_ifs <;> simp
      simp_rw [h_ite₂]
      rw [Finset.prod_ite_eq' Finset.univ ν]
      simp [hw_nu q]
    rw [hp₁, hp₂, one_mul, Matrix.vandermonde_apply]
  let S_pure : Finset I := Finset.univ.image ε
  let S_rem : Finset I := Finset.univ \ S_pure
  have hS_pure_card : S_pure.card = d₀ + 1 := by
    rw [Finset.card_image_of_injective _ hε_inj, Finset.card_univ, Fintype.card_fin]
  have hCard : S_rem.card + (d₀ + 1) = Fintype.card I := by
    have h_sdiff : S_rem.card + S_pure.card = Fintype.card I := by
      simpa [S_rem] using Finset.card_sdiff_add_card_eq_card (Finset.subset_univ S_pure)
    omega
  let f_rem : ↥S_rem → Ω := fun s => C s.1
  let R_rem : Subalgebra F Ω := (MvPolynomial.aeval f_rem : MvPolynomial ↥S_rem F →ₐ[F] Ω).range
  have hC_rem_mem : ∀ e ∈ S_rem, C e ∈ R_rem := by
    intro e he
    exact ⟨MvPolynomial.X ⟨e, he⟩, by simp [f_rem]⟩
  let V : Matrix (Fin (d₀ + 1)) (Fin (d₀ + 1)) F := Matrix.vandermonde a
  have hV_det : V.det ≠ 0 := Matrix.det_vandermonde_ne_zero_iff.mpr ha_inj
  have hV_inv : V⁻¹ * V = 1 := Matrix.nonsing_inv_mul V (isUnit_iff_ne_zero.mpr hV_det)
  have h_rq_mem : ∀ q : Fin (d₀ + 1),
      (∑ j : Fin (d₀ + 1), (V q j) • C (ε j)) ∈ R_rem := by
    intro q
    have h_split := Finset.sum_sdiff (f := fun e : I => (∏ α : Fin (M₀ + 1), (w q α) ^ (e.1 α : ℕ)) • C e)
      (Finset.subset_univ S_pure)
    change ∑ e ∈ S_rem, _ + ∑ e ∈ S_pure, _ = _ at h_split
    rw [hLin q] at h_split
    have h_pure_eq : ∑ e ∈ S_pure, (∏ α : Fin (M₀ + 1), (w q α) ^ (e.1 α : ℕ)) • C e =
        ∑ j : Fin (d₀ + 1), (V q j) • C (ε j) := by
      rw [Finset.sum_image (fun x _ y _ hxy => hε_inj hxy)]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hε_prod q j]
    rw [h_pure_eq] at h_split
    have h_eq_neg : ∑ j : Fin (d₀ + 1), (V q j) • C (ε j) =
        - ∑ e ∈ S_rem, (∏ α : Fin (M₀ + 1), (w q α) ^ (e.1 α : ℕ)) • C e :=
      eq_neg_of_add_eq_zero_right h_split
    rw [h_eq_neg]
    exact R_rem.neg_mem (R_rem.sum_mem fun e he => R_rem.smul_mem (hC_rem_mem e he) _)
  have hC_pure_mem : ∀ j₀ : Fin (d₀ + 1), C (ε j₀) ∈ R_rem := by
    intro j₀
    have h_inv_sum : ∑ q : Fin (d₀ + 1), (V⁻¹ j₀ q) • (∑ j : Fin (d₀ + 1), (V q j) • C (ε j)) =
        C (ε j₀) := by
      calc
        ∑ q : Fin (d₀ + 1), (V⁻¹ j₀ q) • (∑ j : Fin (d₀ + 1), (V q j) • C (ε j))
            = ∑ q : Fin (d₀ + 1), ∑ j : Fin (d₀ + 1), (V⁻¹ j₀ q * V q j) • C (ε j) := by
              refine Finset.sum_congr rfl fun q _ => ?_
              rw [Finset.smul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [smul_smul]
        _ = ∑ j : Fin (d₀ + 1), ∑ q : Fin (d₀ + 1), (V⁻¹ j₀ q * V q j) • C (ε j) :=
              Finset.sum_comm
        _ = ∑ j : Fin (d₀ + 1), ((V⁻¹ * V) j₀ j) • C (ε j) := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← Finset.sum_smul, Matrix.mul_apply]
        _ = ∑ j : Fin (d₀ + 1), ((1 : Matrix (Fin (d₀ + 1)) (Fin (d₀ + 1)) F) j₀ j) • C (ε j) := by
              rw [hV_inv]
        _ = C (ε j₀) := by
              simp [Matrix.one_apply]
    rw [← h_inv_sum]
    exact R_rem.sum_mem fun q _ => R_rem.smul_mem (h_rq_mem q) _
  have hC_all_mem : ∀ e : I, C e ∈ R_rem := by
    intro e
    by_cases he : e ∈ S_pure
    · obtain ⟨j₀, _, rfl⟩ := Finset.mem_image.mp he
      exact hC_pure_mem j₀
    · exact hC_rem_mem e (Finset.mem_sdiff.mpr ⟨Finset.mem_univ e, he⟩)
  have : IsScalarTower k F ↥R_rem :=
    IsScalarTower.of_algebraMap_eq fun x => Subtype.ext (IsScalarTower.algebraMap_apply k F Ω x)
  let φ_dual : MvPolynomial I k →ₐ[k] ↥R_rem :=
    MvPolynomial.aeval (fun e : I => ⟨C e, hC_all_mem e⟩)
  have hφ_comp : (R_rem.val.restrictScalars k).comp φ_dual = MvPolynomial.aeval C := by
    ext e
    simp [φ_dual]
  have hφ_inj : Function.Injective φ_dual := by
    apply Function.Injective.of_comp (f := R_rem.val.restrictScalars k)
    change Function.Injective ((R_rem.val.restrictScalars k).comp φ_dual)
    rw [hφ_comp]
    exact hC_inj
  have h_trdeg_low : (Fintype.card I : Cardinal.{u}) ≤ Algebra.trdeg k ↥R_rem := by
    calc
      (Fintype.card I : Cardinal.{u})
          = Cardinal.lift.{u, 0} (Cardinal.mk I) := by
            rw [Cardinal.mk_fintype, Cardinal.lift_natCast]
      _ = Algebra.trdeg k (MvPolynomial I k) :=
            (MvPolynomial.trdeg_of_isDomain (ι := I) (S := k)).symm
      _ ≤ Algebra.trdeg k ↥R_rem :=
            trdeg_le_of_injective φ_dual hφ_inj
  let ψ : MvPolynomial ↥S_rem F →ₐ[F] ↥R_rem :=
    (MvPolynomial.aeval f_rem : MvPolynomial ↥S_rem F →ₐ[F] Ω).rangeRestrict
  have hψ_surj : Function.Surjective ψ :=
    (MvPolynomial.aeval f_rem : MvPolynomial ↥S_rem F →ₐ[F] Ω).rangeRestrict_surjective
  have h_trdeg_up : Algebra.trdeg F ↥R_rem ≤ (S_rem.card : Cardinal.{u}) := by
    calc
      Algebra.trdeg F ↥R_rem
          ≤ Algebra.trdeg F (MvPolynomial ↥S_rem F) :=
            trdeg_le_of_surjective ψ hψ_surj
      _ = Cardinal.lift.{u, 0} (Cardinal.mk ↥S_rem) :=
            MvPolynomial.trdeg_of_isDomain (ι := ↥S_rem) (S := F)
      _ = (S_rem.card : Cardinal.{u}) := by
            rw [Cardinal.mk_fintype, Fintype.card_coe, Cardinal.lift_natCast]
  have h_trdeg_tower : Algebra.trdeg k ↥R_rem = Algebra.trdeg k F + Algebra.trdeg F ↥R_rem :=
    (trdeg_add_eq k F (A := ↥R_rem)).symm
  have h_card_le : (Fintype.card I : Cardinal.{u}) ≤ ((m + S_rem.card : ℕ) : Cardinal.{u}) := by
    calc
      (Fintype.card I : Cardinal.{u})
          ≤ Algebra.trdeg k ↥R_rem := h_trdeg_low
      _ = Algebra.trdeg k F + Algebra.trdeg F ↥R_rem := h_trdeg_tower
      _ ≤ (m : Cardinal.{u}) + (S_rem.card : Cardinal.{u}) := add_le_add hTrdegF h_trdeg_up
      _ = ((m + S_rem.card : ℕ) : Cardinal.{u}) := by rw [Nat.cast_add]
  have hBound : Fintype.card I ≤ m + S_rem.card := Nat.cast_le.mp h_card_le
  omega

theorem weil_chevalley_generic_algebraic_finite_fibers (k : Type u) [Field k] (M₀ d₀ : ℕ)
    (R : Type u) [CommRing R] [IsDomain R] [Algebra k R] [Algebra.FiniteType k R]
    (S : Type u) [CommRing S] [Algebra R S]
    (x : Fin (M₀ + 1) → S)
    (hx_surj : Function.Surjective (MvPolynomial.aeval x : MvPolynomial (Fin (M₀ + 1)) R →ₐ[R] S))
    (hGenAlg : ¬ ∃ (P : PrimeSpectrum (MvPolynomial (weilDegMonomialIdx M₀ d₀) R))
      (Q : PrimeSpectrum (MvPolynomial (weilDegMonomialIdx M₀ d₀) S))
      (ν : Fin (M₀ + 1)),
      (∀ G : MvPolynomial (weilDegMonomialIdx M₀ d₀) k,
        MvPolynomial.map (algebraMap k R) G ∈ P.asIdeal → G = 0) ∧
      (∑ e : weilDegMonomialIdx M₀ d₀,
        MvPolynomial.C (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * MvPolynomial.X e) ∈ Q.asIdeal ∧
      (∀ g : Polynomial (MvPolynomial (weilDegMonomialIdx M₀ d₀) R),
        Polynomial.eval₂ (MvPolynomial.map (algebraMap R S)) (MvPolynomial.C (x ν)) g ∈ Q.asIdeal ↔
          ∀ j : ℕ, g.coeff j ∈ P.asIdeal)) :
    ∃ (G : MvPolynomial (weilDegMonomialIdx M₀ d₀) k),
      G ≠ 0 ∧
      ∀ (c : weilDegMonomialIdx M₀ d₀ → k),
        MvPolynomial.eval c G ≠ 0 →
        ∀ (p : PrimeSpectrum R),
          ({q : PrimeSpectrum S | PrimeSpectrum.comap (algebraMap R S) q = p ∧
            (∑ e : weilDegMonomialIdx M₀ d₀,
              algebraMap R S (algebraMap k R (c e)) *
                ∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) ∈ q.asIdeal}).Finite :=
by
  let I := weilDegMonomialIdx M₀ d₀
  let P_dual := MvPolynomial I k
  let A := MvPolynomial I R
  let B := MvPolynomial I S
  have : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing k R
  have : IsNoetherianRing P_dual := inferInstance
  have : IsNoetherianRing A := inferInstance
  have : IsNoetherianRing (Polynomial A) := inferInstance
  let F_tilde : B :=
    ∑ e : I, MvPolynomial.C (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * MvPolynomial.X e
  let D := B ⧸ Ideal.span {F_tilde}
  let π_D : B →+* D := Ideal.Quotient.mk (Ideal.span {F_tilde})
  let φ_dual : P_dual →+* A := MvPolynomial.map (algebraMap k R)
  let ψ_tilde : Fin (M₀ + 1) → (Polynomial A →+* B) := fun ν =>
    Polynomial.eval₂RingHom (MvPolynomial.map (algebraMap R S)) (MvPolynomial.C (x ν))
  let ψ : Fin (M₀ + 1) → (Polynomial A →+* D) := fun ν =>
    π_D.comp (ψ_tilde ν)
  have hφ_fp : φ_dual.FinitePresentation := by
    rw [← RingHom.FinitePresentation.of_finiteType]
    have hFT_kA : Algebra.FiniteType k A :=
      Algebra.FiniteType.trans (R := k) (S := R) (A := A) inferInstance inferInstance
    have h_alg_ft : (algebraMap k A).FiniteType := RingHom.finiteType_algebraMap.mpr hFT_kA
    have h_comp : φ_dual.comp (MvPolynomial.C : k →+* P_dual) = algebraMap k A := by
      apply RingHom.ext
      intro a
      change MvPolynomial.map (algebraMap k R) (MvPolynomial.C a) =
        algebraMap k (MvPolynomial I R) a
      rw [MvPolynomial.map_C, IsScalarTower.algebraMap_apply k R (MvPolynomial I R),
        MvPolynomial.algebraMap_eq]
    rw [← h_comp] at h_alg_ft
    exact RingHom.FiniteType.of_comp_finiteType h_alg_ft
  have hψ_fp : ∀ ν : Fin (M₀ + 1), (ψ ν).FinitePresentation := by
    intro ν
    rw [← RingHom.FinitePresentation.of_finiteType]
    have : Algebra.FiniteType R S := Algebra.FiniteType.of_surjective (MvPolynomial.aeval x) hx_surj
    have : Algebra.FiniteType R B :=
      Algebra.FiniteType.trans (R := R) (S := S) (A := B) inferInstance inferInstance
    have : Algebra.FiniteType R D :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R (Ideal.span {F_tilde}))
        (Ideal.Quotient.mkₐ_surjective R _)
    have h_alg_ft : (algebraMap R D).FiniteType := RingHom.finiteType_algebraMap.mpr inferInstance
    have h_comp : (ψ ν).comp (Polynomial.C.comp (MvPolynomial.C : R →+* A)) = algebraMap R D := by
      apply RingHom.ext
      intro r₀
      simp only [ψ, ψ_tilde, π_D, RingHom.comp_apply, Polynomial.coe_eval₂RingHom,
        Polynomial.eval₂_C]
      rw [MvPolynomial.map_C]
      have hB : (MvPolynomial.C (algebraMap R S r₀) : B) = algebraMap R B r₀ := by
        change MvPolynomial.C (algebraMap R S r₀) = algebraMap R (MvPolynomial I S) r₀
        rw [IsScalarTower.algebraMap_apply R S (MvPolynomial I S), MvPolynomial.algebraMap_eq]
      rw [hB, ← Ideal.Quotient.mkₐ_eq_mk R, AlgHom.commutes]
    rw [← h_comp] at h_alg_ft
    exact RingHom.FiniteType.of_comp_finiteType h_alg_ft
  let σ : PrimeSpectrum A → PrimeSpectrum (Polynomial A) := fun P =>
    letI : P.asIdeal.IsPrime := P.isPrime
    letI : IsDomain (A ⧸ P.asIdeal) := Ideal.Quotient.isDomain P.asIdeal
    ⟨RingHom.ker (Polynomial.mapRingHom (Ideal.Quotient.mk P.asIdeal)),
      RingHom.ker_isPrime (Polynomial.mapRingHom (Ideal.Quotient.mk P.asIdeal))⟩
  have hσ_mem : ∀ (P : PrimeSpectrum A) (g : Polynomial A),
      g ∈ (σ P).asIdeal ↔ ∀ j : ℕ, g.coeff j ∈ P.asIdeal := by
    intro P g
    change Polynomial.mapRingHom (Ideal.Quotient.mk P.asIdeal) g = 0 ↔ _
    rw [Polynomial.coe_mapRingHom, Polynomial.ext_iff]
    simp only [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
  have hσ_cont : Continuous σ := by
    rw [continuous_iff_isClosed]
    intro Z hZ
    obtain ⟨s, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus Z).mp hZ
    let s' : Set A := {a : A | ∃ g ∈ s, ∃ j : ℕ, g.coeff j = a}
    have h_eq : σ ⁻¹' PrimeSpectrum.zeroLocus s = PrimeSpectrum.zeroLocus s' := by
      ext P
      simp only [Set.mem_preimage, PrimeSpectrum.mem_zeroLocus, Set.subset_def, SetLike.mem_coe,
        hσ_mem]
      constructor
      · rintro h a ⟨g, hg, j, rfl⟩
        exact h g hg j
      · intro h g hg j
        exact h (g.coeff j) ⟨g, hg, j, rfl⟩
    rw [h_eq]
    exact PrimeSpectrum.isClosed_zeroLocus s'
  have hσ_retro : ∀ (U : Set (PrimeSpectrum (Polynomial A))),
      IsOpen U → IsRetrocompact U → IsRetrocompact (σ ⁻¹' U) := by
    intro U hU _
    exact (TopologicalSpace.NoetherianSpace.isCompact (σ ⁻¹' U)).isRetrocompact
      (hU.preimage hσ_cont)
  let S_bad : Set (PrimeSpectrum P_dual) :=
    ⋃ ν : Fin (M₀ + 1),
      PrimeSpectrum.comap φ_dual '' (σ ⁻¹' Set.range (PrimeSpectrum.comap (ψ ν)))
  have hS_bad_compl_constr : Topology.IsConstructible S_badᶜ := by
    refine Topology.IsConstructible.compl (Topology.IsConstructible.iUnion fun ν => ?_)
    exact PrimeSpectrum.isConstructible_comap_image hφ_fp
      (Topology.IsConstructible.preimage hσ_cont hσ_retro
        (PrimeSpectrum.isConstructible_range_comap (hψ_fp ν)))
  let η₀ : PrimeSpectrum P_dual := ⟨⊥, Ideal.isPrime_bot⟩
  have hη₀ : η₀ ∈ S_badᶜ := by
    intro hmem
    rw [Set.mem_iUnion] at hmem
    obtain ⟨ν, P, ⟨Q', hQ'⟩, hP_comap⟩ := hmem
    let Q : PrimeSpectrum B := PrimeSpectrum.comap π_D Q'
    apply hGenAlg
    refine ⟨P, Q, ν, ?_, ?_, ?_⟩
    · intro G₀ hG₀
      have hG₀' : G₀ ∈ (PrimeSpectrum.comap φ_dual P).asIdeal := hG₀
      rw [hP_comap] at hG₀'
      exact Ideal.mem_bot.mp hG₀'
    · change π_D F_tilde ∈ Q'.asIdeal
      have h0 : π_D F_tilde = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton F_tilde))
      rw [h0]
      exact Q'.asIdeal.zero_mem
    · intro g
      have h1 : (Polynomial.eval₂ (MvPolynomial.map (algebraMap R S)) (MvPolynomial.C (x ν)) g ∈
          Q.asIdeal) ↔ g ∈ (PrimeSpectrum.comap (ψ ν) Q').asIdeal := Iff.rfl
      rw [h1, hQ', hσ_mem]
  have hBasis_ind : ∀ {s : Set (PrimeSpectrum P_dual)} (hs : Topology.IsConstructible s),
      (η₀ ∈ s → ∃ G : P_dual, G ≠ 0 ∧ (PrimeSpectrum.basicOpen G : Set (PrimeSpectrum P_dual)) ⊆ s) ∧
      (η₀ ∉ s → ∃ G : P_dual, G ≠ 0 ∧ (PrimeSpectrum.basicOpen G : Set (PrimeSpectrum P_dual)) ⊆ sᶜ) := by
    intro s hs
    refine Topology.IsConstructible.empty_union_induction ?_ ?_ ?_ hs
    · intro U hUopen _
      constructor
      · intro hηU
        obtain ⟨v, ⟨G, rfl⟩, hηG, hvU⟩ :=
          PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hηU hUopen
        refine ⟨G, ?_, hvU⟩
        intro hG0
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, hG0] at hηG
        exact hηG η₀.asIdeal.zero_mem
      · intro hηU
        refine ⟨1, one_ne_zero, ?_⟩
        intro q _
        have hle : η₀ ≤ q := bot_le
        have hcl : q ∈ closure ({η₀} : Set (PrimeSpectrum P_dual)) :=
          (PrimeSpectrum.le_iff_mem_closure η₀ q).mp hle
        exact closure_minimal (Set.singleton_subset_iff.mpr hηU) hUopen.isClosed_compl hcl
    · intro s₁ _ s₂ _ ih₁ ih₂
      constructor
      · intro hη
        rcases hη with hη₁ | hη₂
        · obtain ⟨G, hG, hsub⟩ := ih₁.1 hη₁
          exact ⟨G, hG, hsub.trans Set.subset_union_left⟩
        · obtain ⟨G, hG, hsub⟩ := ih₂.1 hη₂
          exact ⟨G, hG, hsub.trans Set.subset_union_right⟩
      · intro hη
        have hη₁ : η₀ ∉ s₁ := fun h => hη (Or.inl h)
        have hη₂ : η₀ ∉ s₂ := fun h => hη (Or.inr h)
        obtain ⟨G₁, hG₁, hsub₁⟩ := ih₁.2 hη₁
        obtain ⟨G₂, hG₂, hsub₂⟩ := ih₂.2 hη₂
        refine ⟨G₁ * G₂, mul_ne_zero hG₁ hG₂, ?_⟩
        intro q hq
        rw [SetLike.mem_coe, PrimeSpectrum.basicOpen_mul] at hq
        rintro (hq₁ | hq₂)
        · exact hsub₁ hq.1 hq₁
        · exact hsub₂ hq.2 hq₂
    · intro s₁ _ ih
      constructor
      · intro hη
        exact ih.2 hη
      · intro hη
        rw [compl_compl]
        exact ih.1 (not_not.mp hη)
  obtain ⟨G, hG_ne, hG_sub⟩ := (hBasis_ind hS_bad_compl_constr).1 hη₀
  refine ⟨G, hG_ne, ?_⟩
  intro c hc p
  let F_c : S :=
    ∑ e : I, algebraMap R S (algebraMap k R (c e)) * ∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)
  have : p.asIdeal.IsPrime := p.isPrime
  let R_bar := R ⧸ p.asIdeal
  have : IsDomain R_bar := Ideal.Quotient.isDomain p.asIdeal
  let K_p := FractionRing R_bar
  let ρ_p : R →+* K_p := algebraMap R K_p
  have hρ_def : ∀ r₀ : R, ρ_p r₀ = algebraMap R_bar K_p (Ideal.Quotient.mk p.asIdeal r₀) := by
    intro r₀
    exact IsScalarTower.algebraMap_apply R R_bar K_p r₀
  let T_p := TensorProduct R K_p S
  let _ : CommRing T_p := Algebra.TensorProduct.instCommRing
  let ι_S : S →+* T_p := (Algebra.TensorProduct.includeRight : S →ₐ[R] T_p).toRingHom
  let I_fib : Ideal T_p := Ideal.span {ι_S F_c}
  let B_fib := T_p ⧸ I_fib
  let _ : CommRing B_fib := Ideal.Quotient.commRing I_fib
  let _ : Algebra K_p B_fib := Ideal.Quotient.algebra K_p
  let π_fib : T_p →ₐ[K_p] B_fib := Ideal.Quotient.mkₐ K_p I_fib
  let τ : S →+* B_fib := π_fib.toRingHom.comp ι_S
  have hComp_ι : ∀ r₀ : R, ι_S (algebraMap R S r₀) = algebraMap K_p T_p (ρ_p r₀) := by
    intro r₀
    change (Algebra.TensorProduct.includeRight : S →ₐ[R] T_p) (algebraMap R S r₀) =
      algebraMap K_p T_p (algebraMap R K_p r₀)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R K_p T_p]
  have hComp_τ : ∀ r₀ : R, τ (algebraMap R S r₀) = algebraMap K_p B_fib (ρ_p r₀) := by
    intro r₀
    change π_fib (ι_S (algebraMap R S r₀)) = algebraMap K_p B_fib (ρ_p r₀)
    rw [hComp_ι, AlgHom.commutes]
  have hτ_Fc : τ F_c = 0 := by
    change Ideal.Quotient.mk I_fib (ι_S F_c) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hy_surj : Function.Surjective
      (MvPolynomial.aeval (fun α => τ (x α)) : MvPolynomial (Fin (M₀ + 1)) K_p →ₐ[K_p] B_fib) := by
    let Ψ : MvPolynomial (Fin (M₀ + 1)) K_p →ₐ[K_p] T_p := MvPolynomial.aeval (fun α => ι_S (x α))
    have hΨ_comp : π_fib.comp Ψ = MvPolynomial.aeval (fun α => τ (x α)) := by
      apply MvPolynomial.algHom_ext
      intro α
      change π_fib (Ψ (MvPolynomial.X α)) = MvPolynomial.aeval (fun α => τ (x α)) (MvPolynomial.X α)
      rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      rfl
    rw [← hΨ_comp, AlgHom.coe_comp]
    refine (Ideal.Quotient.mkₐ_surjective K_p I_fib).comp ?_
    have hΨ_map : Ψ.toRingHom.comp (MvPolynomial.map ρ_p) =
        ι_S.comp (MvPolynomial.aeval x).toRingHom := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro r₀
        change Ψ (MvPolynomial.map ρ_p (MvPolynomial.C r₀)) =
          ι_S (MvPolynomial.aeval x (MvPolynomial.C r₀))
        rw [MvPolynomial.map_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C, hComp_ι]
      · intro α
        change Ψ (MvPolynomial.map ρ_p (MvPolynomial.X α)) =
          ι_S (MvPolynomial.aeval x (MvPolynomial.X α))
        rw [MvPolynomial.map_X, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
    intro t
    refine TensorProduct.inductionOn t ?_ ?_
    · intro a s
      obtain ⟨P_s, rfl⟩ := hx_surj s
      refine ⟨MvPolynomial.C a * MvPolynomial.map ρ_p P_s, ?_⟩
      rw [map_mul]
      have h1 : Ψ (MvPolynomial.C a) = a ⊗ₜ[R] (1 : S) := by
        change MvPolynomial.aeval (fun α => ι_S (x α)) (MvPolynomial.C a) = a ⊗ₜ[R] (1 : S)
        rw [MvPolynomial.aeval_C]
        rfl
      have h2 : Ψ (MvPolynomial.map ρ_p P_s) = (1 : K_p) ⊗ₜ[R] (MvPolynomial.aeval x P_s) :=
        RingHom.congr_fun hΨ_map P_s
      rw [h1, h2, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    · rintro t₁ t₂ ⟨P₁, rfl⟩ ⟨P₂, rfl⟩
      exact ⟨P₁ + P₂, map_add Ψ P₁ P₂⟩
  have hLift_q : ∀ q : PrimeSpectrum S,
      PrimeSpectrum.comap (algebraMap R S) q = p →
      F_c ∈ q.asIdeal →
      q ∈ Set.range (PrimeSpectrum.comap τ) := by
    intro q hqp hFc
    have : q.asIdeal.IsPrime := q.isPrime
    let S_bar := S ⧸ q.asIdeal
    have : IsDomain S_bar := Ideal.Quotient.isDomain q.asIdeal
    let E_q := FractionRing S_bar
    let σ_q : S →+* E_q := (algebraMap S_bar E_q).comp (Ideal.Quotient.mk q.asIdeal)
    have hσ_q_zero : ∀ s : S, σ_q s = 0 ↔ s ∈ q.asIdeal := by
      intro s
      change algebraMap S_bar E_q (Ideal.Quotient.mk q.asIdeal s) = 0 ↔ s ∈ q.asIdeal
      rw [map_eq_zero_iff (algebraMap S_bar E_q) (IsFractionRing.injective S_bar E_q),
        Ideal.Quotient.eq_zero_iff_mem]
    have hp_iff : ∀ r₀ : R, r₀ ∈ p.asIdeal ↔ σ_q (algebraMap R S r₀) = 0 := by
      intro r₀
      rw [hσ_q_zero, ← hqp]
      rfl
    let φ_bar : R_bar →+* E_q :=
      Ideal.Quotient.lift p.asIdeal (σ_q.comp (algebraMap R S)) (fun r₀ hr₀ => (hp_iff r₀).mp hr₀)
    have hφ_bar_inj : Function.Injective φ_bar := by
      rw [injective_iff_map_eq_zero]
      intro u hu
      obtain ⟨r₀, rfl⟩ := Ideal.Quotient.mk_surjective u
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hp_iff r₀).mpr hu)
    have hφ_unit : ∀ m : nonZeroDivisors R_bar, IsUnit (φ_bar m) := by
      intro m
      exact IsUnit.mk0 (φ_bar m) (fun h0 =>
        nonZeroDivisors.ne_zero m.2 (hφ_bar_inj (h0.trans (map_zero φ_bar).symm)))
    let ψ_q : K_p →+* E_q := IsLocalization.lift (S := K_p) hφ_unit
    have hψ_q_comp : ∀ r₀ : R, ψ_q (ρ_p r₀) = σ_q (algebraMap R S r₀) := by
      intro r₀
      rw [hρ_def, IsLocalization.lift_eq]
      rfl
    have hAlg_Eq : ∀ r₀ : R, algebraMap R E_q r₀ = σ_q (algebraMap R S r₀) := by
      intro r₀
      rw [IsScalarTower.algebraMap_apply R S_bar E_q]
      rfl
    let ψ_q_alg : K_p →ₐ[R] E_q :=
      { ψ_q with commutes' := fun r₀ => (hψ_q_comp r₀).trans (hAlg_Eq r₀).symm }
    let σ_q_alg : S →ₐ[R] E_q :=
      { σ_q with commutes' := fun r₀ => (hAlg_Eq r₀).symm }
    let γ_tilde : T_p →ₐ[R] E_q :=
      Algebra.TensorProduct.lift ψ_q_alg σ_q_alg (fun _ _ => Commute.all _ _)
    have hγ_ι : ∀ s : S, γ_tilde (ι_S s) = σ_q s := by
      intro s
      change (Algebra.TensorProduct.lift ψ_q_alg σ_q_alg _) ((1 : K_p) ⊗ₜ[R] s) = σ_q s
      rw [Algebra.TensorProduct.lift_tmul]
      change ψ_q 1 * σ_q s = σ_q s
      rw [map_one, one_mul]
    have hI_ker : ∀ z ∈ I_fib, γ_tilde.toRingHom z = 0 := by
      intro z hz
      have hle : I_fib ≤ RingHom.ker γ_tilde.toRingHom := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change γ_tilde (ι_S F_c) = 0
        rw [hγ_ι]
        exact (hσ_q_zero F_c).mpr hFc
      exact RingHom.mem_ker.mp (hle hz)
    let γ_q : B_fib →+* E_q :=
      Ideal.Quotient.lift I_fib γ_tilde.toRingHom hI_ker
    let r_q : PrimeSpectrum B_fib := ⟨RingHom.ker γ_q, RingHom.ker_isPrime γ_q⟩
    refine ⟨r_q, ?_⟩
    ext s
    change γ_q (τ s) = 0 ↔ s ∈ q.asIdeal
    have hγ_τ : γ_q (τ s) = σ_q s := by
      change Ideal.Quotient.lift I_fib γ_tilde.toRingHom hI_ker
        (Ideal.Quotient.mk I_fib (ι_S s)) = σ_q s
      rw [Ideal.Quotient.lift_mk]
      exact hγ_ι s
    rw [hγ_τ, hσ_q_zero]
  let m_c : PrimeSpectrum P_dual :=
    ⟨RingHom.ker (MvPolynomial.eval c), RingHom.ker_isPrime (MvPolynomial.eval c)⟩
  have hm_c_good : m_c ∉ S_bad := by
    have hm_open : m_c ∈ (PrimeSpectrum.basicOpen G : Set (PrimeSpectrum P_dual)) := by
      rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      exact hc
    exact hG_sub hm_open
  have hAlg_all : ∀ (r : PrimeSpectrum B_fib) (ν : Fin (M₀ + 1)),
      IsAlgebraic K_p (Ideal.Quotient.mkₐ K_p r.asIdeal (τ (x ν))) := by
    intro r ν
    by_contra hNotAlg
    have : r.asIdeal.IsPrime := r.isPrime
    let L_r := B_fib ⧸ r.asIdeal
    let _ : CommRing L_r := Ideal.Quotient.commRing r.asIdeal
    let _ : Algebra K_p L_r := Ideal.Quotient.algebra K_p
    have : IsDomain L_r := Ideal.Quotient.isDomain r.asIdeal
    let q_r : B_fib →ₐ[K_p] L_r := Ideal.Quotient.mkₐ K_p r.asIdeal
    let z_ν : L_r := q_r (τ (x ν))
    let α_p : A →+* K_p :=
      MvPolynomial.eval₂Hom ρ_p (fun e => ρ_p (algebraMap k R (c e)))
    let P : PrimeSpectrum A := ⟨RingHom.ker α_p, RingHom.ker_isPrime α_p⟩
    have hP_comap : PrimeSpectrum.comap φ_dual P = m_c := by
      let θ_k : k →+* K_p := ρ_p.comp (algebraMap k R)
      have hα_comp : α_p.comp φ_dual = θ_k.comp (MvPolynomial.eval c) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro a
          change α_p (MvPolynomial.map (algebraMap k R) (MvPolynomial.C a)) =
            θ_k (MvPolynomial.eval c (MvPolynomial.C a))
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, MvPolynomial.eval_C]
          rfl
        · intro e
          change α_p (MvPolynomial.map (algebraMap k R) (MvPolynomial.X e)) =
            θ_k (MvPolynomial.eval c (MvPolynomial.X e))
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', MvPolynomial.eval_X]
          rfl
      ext G₀
      change (α_p.comp φ_dual) G₀ = 0 ↔ MvPolynomial.eval c G₀ = 0
      rw [hα_comp, RingHom.comp_apply, map_eq_zero_iff θ_k θ_k.injective]
    let τ_r : S →+* L_r := q_r.toRingHom.comp τ
    let ι_r : K_p →+* L_r := algebraMap K_p L_r
    have hτ_r_comp : ∀ r₀ : R, τ_r (algebraMap R S r₀) = ι_r (ρ_p r₀) := by
      intro r₀
      change q_r (τ (algebraMap R S r₀)) = algebraMap K_p L_r (ρ_p r₀)
      rw [hComp_τ, AlgHom.commutes]
    let β_r : B →+* L_r :=
      MvPolynomial.eval₂Hom τ_r (fun e => ι_r (ρ_p (algebraMap k R (c e))))
    have hβ_F : β_r F_tilde = 0 := by
      change MvPolynomial.eval₂Hom τ_r (fun e => ι_r (ρ_p (algebraMap k R (c e)))) F_tilde = 0
      simp only [F_tilde, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      have h_eq : (∑ e : I, τ_r (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) *
          ι_r (ρ_p (algebraMap k R (c e)))) = τ_r F_c := by
        simp only [F_c, map_sum, map_mul]
        refine Finset.sum_congr rfl fun e _ => ?_
        rw [hτ_r_comp, mul_comm]
      rw [h_eq]
      change q_r (τ F_c) = 0
      rw [hτ_Fc, map_zero]
    have hF_ker : ∀ z ∈ Ideal.span {F_tilde}, β_r z = 0 := by
      intro z hz
      have hle : Ideal.span {F_tilde} ≤ RingHom.ker β_r := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        exact hβ_F
      exact RingHom.mem_ker.mp (hle hz)
    let β_bar : D →+* L_r := Ideal.Quotient.lift (Ideal.span {F_tilde}) β_r hF_ker
    let Q' : PrimeSpectrum D := ⟨RingHom.ker β_bar, RingHom.ker_isPrime β_bar⟩
    have hβ_map : β_r.comp (MvPolynomial.map (algebraMap R S)) = ι_r.comp α_p := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro r₀
        change β_r (MvPolynomial.map (algebraMap R S) (MvPolynomial.C r₀)) =
          ι_r (α_p (MvPolynomial.C r₀))
        rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C, hτ_r_comp]
      · intro e
        change β_r (MvPolynomial.map (algebraMap R S) (MvPolynomial.X e)) =
          ι_r (α_p (MvPolynomial.X e))
        rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
    have hψ_eval : (β_bar.comp (ψ ν)) =
        (Polynomial.aeval z_ν).toRingHom.comp (Polynomial.mapRingHom α_p) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro a
        change Ideal.Quotient.lift (Ideal.span {F_tilde}) β_r hF_ker
            (Ideal.Quotient.mk (Ideal.span {F_tilde})
              (Polynomial.eval₂ (MvPolynomial.map (algebraMap R S)) (MvPolynomial.C (x ν))
                (Polynomial.C a))) =
          Polynomial.aeval z_ν (Polynomial.map α_p (Polynomial.C a))
        rw [Polynomial.eval₂_C, Ideal.Quotient.lift_mk, Polynomial.map_C, Polynomial.aeval_C]
        exact RingHom.congr_fun hβ_map a
      · change Ideal.Quotient.lift (Ideal.span {F_tilde}) β_r hF_ker
            (Ideal.Quotient.mk (Ideal.span {F_tilde})
              (Polynomial.eval₂ (MvPolynomial.map (algebraMap R S)) (MvPolynomial.C (x ν))
                Polynomial.X)) =
          Polynomial.aeval z_ν (Polynomial.map α_p Polynomial.X)
        rw [Polynomial.eval₂_X, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C,
          Polynomial.map_X, Polynomial.aeval_X]
        rfl
    have hInj_z : Function.Injective (Polynomial.aeval z_ν : Polynomial K_p →ₐ[K_p] L_r) := by
      rw [isAlgebraic_iff_not_injective] at hNotAlg
      exact not_not.mp hNotAlg
    have hQ'_comap : PrimeSpectrum.comap (ψ ν) Q' = σ P := by
      ext g
      rw [hσ_mem]
      change (β_bar.comp (ψ ν)) g = 0 ↔ ∀ j : ℕ, α_p (g.coeff j) = 0
      rw [hψ_eval, RingHom.comp_apply]
      change Polynomial.aeval z_ν (Polynomial.map α_p g) = 0 ↔ ∀ j : ℕ, α_p (g.coeff j) = 0
      rw [map_eq_zero_iff (Polynomial.aeval z_ν) hInj_z, Polynomial.ext_iff]
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero]
    apply hm_c_good
    rw [Set.mem_iUnion]
    exact ⟨ν, P, ⟨Q', hQ'_comap⟩, hP_comap⟩
  have : Algebra.FiniteType K_p B_fib :=
    Algebra.FiniteType.of_surjective _ hy_surj
  have : IsNoetherianRing B_fib := Algebra.FiniteType.isNoetherianRing K_p B_fib
  have hMax_all : ∀ r : PrimeSpectrum B_fib, r.asIdeal.IsMaximal := by
    intro r
    have : r.asIdeal.IsPrime := r.isPrime
    let L_r := B_fib ⧸ r.asIdeal
    let _ : CommRing L_r := Ideal.Quotient.commRing r.asIdeal
    let _ : Algebra K_p L_r := Ideal.Quotient.algebra K_p
    have : IsDomain L_r := Ideal.Quotient.isDomain r.asIdeal
    let q_r : B_fib →ₐ[K_p] L_r := Ideal.Quotient.mkₐ K_p r.asIdeal
    let Φ_r : MvPolynomial (Fin (M₀ + 1)) K_p →ₐ[K_p] L_r :=
      q_r.comp (MvPolynomial.aeval (fun α => τ (x α)))
    have hΦ_surj : Function.Surjective Φ_r :=
      (Ideal.Quotient.mkₐ_surjective K_p r.asIdeal).comp hy_surj
    have hΦ_int : ∀ p₀ : MvPolynomial (Fin (M₀ + 1)) K_p, IsIntegral K_p (Φ_r p₀) := by
      intro p₀
      induction p₀ using MvPolynomial.induction_on with
      | C a =>
        have hC : Φ_r (MvPolynomial.C a) = algebraMap K_p L_r a := by
          rw [MvPolynomial.C_eq_algebraMap, AlgHom.commutes]
        rw [hC]
        exact isIntegral_algebraMap
      | add p₁ p₂ hp₁ hp₂ =>
        rw [map_add]
        exact hp₁.add hp₂
      | mul_X p₁ ν hp₁ =>
        rw [map_mul]
        have hX : Φ_r (MvPolynomial.X ν) = q_r (τ (x ν)) := by
          simp only [Φ_r, AlgHom.comp_apply, MvPolynomial.aeval_X]
        rw [hX]
        exact hp₁.mul (hAlg_all r ν).isIntegral
    have : Algebra.IsIntegral K_p L_r := ⟨fun z => by
      obtain ⟨p₀, rfl⟩ := hΦ_surj z
      exact hΦ_int p₀⟩
    exact Ideal.Quotient.maximal_of_isField r.asIdeal
      (isField_of_isIntegral_of_isField' (Field.toIsField K_p))
  have hMin_all : ∀ r : PrimeSpectrum B_fib, IsMin r := by
    intro r r₀ hle
    have hle' : r₀.asIdeal ≤ r.asIdeal := hle
    have heq : r₀.asIdeal = r.asIdeal := (hMax_all r₀).eq_of_le r.isPrime.ne_top hle'
    exact heq.symm.le
  have hUniv_fin : (Set.univ : Set (PrimeSpectrum B_fib)).Finite := by
    have h_eq : {r : PrimeSpectrum B_fib | IsMin r} = Set.univ :=
      Set.eq_univ_of_forall hMin_all
    rw [← h_eq]
    exact PrimeSpectrum.finite_setOfPred_isMin B_fib
  refine (hUniv_fin.image (PrimeSpectrum.comap τ)).subset ?_
  rintro q ⟨hqp, hFc⟩
  obtain ⟨r_q, rfl⟩ := hLift_q q hqp hFc
  exact ⟨r_q, Set.mem_univ r_q, rfl⟩

theorem weil_algClosed_veronese_vandermonde_quasiFinite_open (k : Type u) [Field k] [IsAlgClosed k] (m M₀ : ℕ)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hIntB₀ : AlgebraicGeometry.IsIntegral B₀.left)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (hDimB₀ : topologicalKrullDim B₀.left = (m : WithBot ℕ∞))
    (hU₀ : Nonempty U₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k) :=
      MvPolynomial.gradedAlgebra
    ∃ (G_qf : MvPolynomial (weilDegMonomialIdx M₀ (m + 3)) k),
      G_qf ≠ 0 ∧
      ∀ (c : weilDegMonomialIdx M₀ (m + 3) → k),
        MvPolynomial.eval c G_qf ≠ 0 →
        ∀ b : B₀.left,
          ({x : V₁.left | f₁.left.base x = b ∧
            x ∉ ((TopologicalSpace.Opens.map ι₁.left.base).obj
              (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k)
                (weilHomogeneousPoly M₀ (m + 3) c)) : Set V₁.left)}).Finite :=
by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hd₀_1 : 1 ≤ m + 3 := by omega
  have hd₀_m : m ≤ m + 3 := by omega
  obtain ⟨hSepB₀, B_cov, R, instCommR, instDomR, instAlgR, instFTR, j,
      hOpen_j, hHom_j, hCov_j, hTrdeg_R⟩ :=
    weil_projective_integral_finite_affine_cover_trdeg_le k m B₀ hIntB₀ hProjB₀ hDimB₀
  letI : ∀ β, CommRing (R β) := instCommR
  letI : ∀ β, IsDomain (R β) := instDomR
  letI : ∀ β, Algebra k (R β) := instAlgR
  letI : ∀ β, Algebra.FiniteType k (R β) := instFTR
  have hChart : ∀ (β : Fin B_cov) (μ : Fin (M₀ + 1)),
      ∃ (G : MvPolynomial (weilDegMonomialIdx M₀ (m + 3)) k),
        G ≠ 0 ∧
        ∀ (c : weilDegMonomialIdx M₀ (m + 3) → k),
          MvPolynomial.eval c G ≠ 0 →
          ∀ (p : PrimeSpectrum (R β)),
            ({z : V₁.left | f₁.left.base z = (j β).base p ∧
              z ∈ ((TopologicalSpace.Opens.map ι₁.left.base).obj
                (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)) : Set V₁.left) ∧
              z ∉ ((TopologicalSpace.Opens.map ι₁.left.base).obj
                (AlgebraicGeometry.Proj.basicOpen 𝒜
                  (weilHomogeneousPoly M₀ (m + 3) c)) : Set V₁.left)}).Finite := by
    intro β μ
    obtain ⟨S, instCommS, instAlgS, x, hx_mu, hx_surj, hMin_Ω, hFib_red⟩ :=
      weil_projective_curve_fib_product_chart_reduction k M₀ (m + 3) hd₀_1
        B₀ U₀ hSepB₀ V₁ ι₁ hCl₁ f₁ hFib₁ (R β) (j β) (hOpen_j β) (hHom_j β) μ
    letI : CommRing S := instCommS
    letI : Algebra (R β) S := instAlgS
    have hGenAlg : ¬ ∃ (P : PrimeSpectrum (MvPolynomial (weilDegMonomialIdx M₀ (m + 3)) (R β)))
        (Q : PrimeSpectrum (MvPolynomial (weilDegMonomialIdx M₀ (m + 3)) S))
        (ν : Fin (M₀ + 1)),
        (∀ G : MvPolynomial (weilDegMonomialIdx M₀ (m + 3)) k,
          MvPolynomial.map (algebraMap k (R β)) G ∈ P.asIdeal → G = 0) ∧
        (∑ e : weilDegMonomialIdx M₀ (m + 3),
          MvPolynomial.C (∏ α : Fin (M₀ + 1), (x α) ^ (e.1 α : ℕ)) * MvPolynomial.X e) ∈ Q.asIdeal ∧
        (∀ g : Polynomial (MvPolynomial (weilDegMonomialIdx M₀ (m + 3)) (R β)),
          Polynomial.eval₂ (MvPolynomial.map (algebraMap (R β) S)) (MvPolynomial.C (x ν)) g ∈ Q.asIdeal ↔
            ∀ l : ℕ, g.coeff l ∈ P.asIdeal) := by
      rintro ⟨P, Q, ν, hP_bot, hF_mem, hTrans_Q⟩
      obtain ⟨F, instFieldF, instAlgClF, instAlgkF,
          Ω, instFieldΩ, instAlgkΩ, instAlgFΩ, instTower,
          C, A₀, instCommA₀, instDomA₀, instAlgFA₀, instFTA₀,
          y, hTrdegF, hC_inj, hy_mu, hy_nu, hRel⟩ :=
        weil_algClosed_minimal_prime_field_descent_of_curve_chart k m M₀ (m + 3) μ ν
          (R β) (hTrdeg_R β) S x hx_mu hx_surj hMin_Ω P Q hP_bot hF_mem hTrans_Q
      letI : Field F := instFieldF
      letI : IsAlgClosed F := instAlgClF
      letI : Algebra k F := instAlgkF
      letI : Field Ω := instFieldΩ
      letI : Algebra k Ω := instAlgkΩ
      letI : Algebra F Ω := instAlgFΩ
      letI : IsScalarTower k F Ω := instTower
      letI : CommRing A₀ := instCommA₀
      letI : IsDomain A₀ := instDomA₀
      letI : Algebra F A₀ := instAlgFA₀
      letI : Algebra.FiniteType F A₀ := instFTA₀
      exact weil_algClosed_vandermonde_trdeg_contradiction k m M₀ (m + 3) hd₀_m μ ν
        F hTrdegF Ω C hC_inj A₀ y hy_mu hy_nu hRel
    obtain ⟨G, hG_ne, hG_fin⟩ :=
      weil_chevalley_generic_algebraic_finite_fibers k M₀ (m + 3) (R β) S x hx_surj hGenAlg
    exact ⟨G, hG_ne, fun c hc p => hFib_red c p (hG_fin c hc p)⟩
  choose G hG_ne hG_fin using hChart
  let G_qf : MvPolynomial (weilDegMonomialIdx M₀ (m + 3)) k :=
    ∏ β : Fin B_cov, ∏ μ : Fin (M₀ + 1), G β μ
  have hG_qf_ne : G_qf ≠ 0 := by
    rw [Finset.prod_ne_zero_iff]
    intro β _
    rw [Finset.prod_ne_zero_iff]
    intro μ _
    exact hG_ne β μ
  have hProj_top : (⨆ μ : Fin (M₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)) = ⊤ := by
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X
      (fun μ => ⟨1, MvPolynomial.isHomogeneous_X k μ⟩)
    rw [eq_top_iff]
    have h_mem_all : ∀ p : MvPolynomial (Fin (M₀ + 1)) k,
        p ∈ Algebra.adjoin (↥(𝒜 0))
          (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k)) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a =>
        let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
        exact (Algebra.adjoin (↥(𝒜 0))
          (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k))).algebraMap_mem c₀
      | add p q hp hq => exact add_mem hp hq
      | mul_X p μ hp => exact mul_mem hp (Algebra.subset_adjoin ⟨μ, rfl⟩)
    intro p _
    exact h_mem_all p
  have hProj_univ : (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) =
      ⋃ μ : Fin (M₀ + 1), (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ) :
        Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    rw [← TopologicalSpace.Opens.coe_top, ← hProj_top, TopologicalSpace.Opens.coe_iSup]
  refine ⟨G_qf, hG_qf_ne, ?_⟩
  intro c hc b
  have hc_all : ∀ (β : Fin B_cov) (μ : Fin (M₀ + 1)), MvPolynomial.eval c (G β μ) ≠ 0 := by
    have hc' : ∏ β : Fin B_cov, ∏ μ : Fin (M₀ + 1), MvPolynomial.eval c (G β μ) ≠ 0 := by
      simpa only [G_qf, map_prod] using hc
    rw [Finset.prod_ne_zero_iff] at hc'
    intro β μ
    have hcβ := hc' β (Finset.mem_univ β)
    rw [Finset.prod_ne_zero_iff] at hcβ
    exact hcβ μ (Finset.mem_univ μ)
  have hb_mem : b ∈ (Set.univ : Set B₀.left) := Set.mem_univ b
  rw [← hCov_j, Set.mem_iUnion] at hb_mem
  obtain ⟨β, p, hp⟩ := hb_mem
  have hFin_union : (⋃ μ : Fin (M₀ + 1),
      ({z : V₁.left | f₁.left.base z = (j β).base p ∧
        z ∈ ((TopologicalSpace.Opens.map ι₁.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)) : Set V₁.left) ∧
        z ∉ ((TopologicalSpace.Opens.map ι₁.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜
            (weilHomogeneousPoly M₀ (m + 3) c)) : Set V₁.left)} : Set V₁.left)).Finite :=
    Set.finite_iUnion fun μ => hG_fin β μ c (hc_all β μ) p
  refine hFin_union.subset ?_
  intro z ⟨hz_b, hz_not⟩
  let w : ↥(AlgebraicGeometry.Proj 𝒜) := ι₁.left.base z
  have hw : w ∈ (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) := Set.mem_univ w
  rw [hProj_univ, Set.mem_iUnion] at hw
  obtain ⟨μ, hz_μ⟩ := hw
  rw [Set.mem_iUnion]
  exact ⟨μ, hz_b.trans hp.symm, hz_μ, hz_not⟩

theorem weil_projective_proper_finite_fibers_isFinite (k : Type u) [Field k] [IsAlgClosed k] (M₀ : ℕ)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjB₀ : IsProjectiveOverField k B₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₁ : V₁ ⟶ weilProjectiveSpaceOver k M₀)
    (hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left)
    (f₁ : V₁ ⟶ B₀)
    (hProp₁ : AlgebraicGeometry.IsProper f₁.left)
    (H : AlgebraicGeometry.Scheme.{u})
    (ιH : H ⟶ V₁.left)
    (hClH : AlgebraicGeometry.IsClosedImmersion ιH)
    (hFinFib : ∀ b : B₀.left, ((ιH ≫ f₁.left).base ⁻¹' {b}).Finite) :
    AlgebraicGeometry.IsFinite (ιH ≫ f₁.left) :=
by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let p : H ⟶ B₀.left := ιH ≫ f₁.left
  let j : H ⟶ AlgebraicGeometry.Proj 𝒜 := ιH ≫ ι₁.left
  have : AlgebraicGeometry.IsClosedImmersion ιH := hClH
  have : AlgebraicGeometry.IsClosedImmersion ι₁.left := hCl₁
  have : AlgebraicGeometry.IsProper f₁.left := hProp₁
  have hProp_p : AlgebraicGeometry.IsProper p := by
    dsimp [p]
    infer_instance
  have hAff_j : AlgebraicGeometry.IsAffineHom j := by
    change AlgebraicGeometry.IsAffineHom (ιH ≫ ι₁.left)
    infer_instance
  have hSepB₀ : AlgebraicGeometry.IsSeparated B₀.hom := by
    obtain ⟨N₀, ιB₀, hClB₀⟩ := hProjB₀
    have : AlgebraicGeometry.IsClosedImmersion ιB₀.left := hClB₀
    let 𝒜_B := MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k
    let _ : GradedAlgebra 𝒜_B := MvPolynomial.gradedAlgebra
    have : ((weilProjectiveSpaceOver k N₀).left).IsSeparated :=
      AlgebraicGeometry.Proj.instIsSeparated 𝒜_B
    have : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k N₀).hom :=
      inferInstance
    rw [← CategoryTheory.Over.w ιB₀]
    infer_instance
  
  have h_exists_X : ∀ q : ↥(AlgebraicGeometry.Proj 𝒜),
      ∃ μ₀ : Fin (M₀ + 1), MvPolynomial.X μ₀ ∉ q.asHomogeneousIdeal := by
    have h_adjoin : Algebra.adjoin (↥(𝒜 0))
        (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k)) = ⊤ := by
      rw [eq_top_iff]
      have h_mem_all : ∀ P : MvPolynomial (Fin (M₀ + 1)) k,
          P ∈ Algebra.adjoin (↥(𝒜 0))
            (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k)) := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C a =>
          let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩
          exact (Algebra.adjoin (↥(𝒜 0))
            (Set.range (MvPolynomial.X : Fin (M₀ + 1) → MvPolynomial (Fin (M₀ + 1)) k))).algebraMap_mem c₀
        | add P₁ P₂ hP₁ hP₂ => exact add_mem hP₁ hP₂
        | mul_X P₁ i hP₁ => exact mul_mem hP₁ (Algebra.subset_adjoin ⟨i, rfl⟩)
      intro P _
      exact h_mem_all P
    have h_top : (⨆ i : Fin (M₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X
        (fun i => ⟨1, MvPolynomial.isHomogeneous_X k i⟩) h_adjoin
    intro q
    have hq_mem : q ∈ (⨆ i : Fin (M₀ + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) := by
      rw [h_top]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hq_mem
    obtain ⟨μ₀, hμ₀⟩ := hq_mem
    exact ⟨μ₀, (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X μ₀) q).mp hμ₀⟩
  let L : k → MvPolynomial (Fin (M₀ + 1)) k := fun t =>
    ∑ μ : Fin (M₀ + 1), MvPolynomial.C (t ^ (μ : ℕ)) * MvPolynomial.X μ
  have hL_hom : ∀ t : k, L t ∈ 𝒜 1 := by
    intro t
    rw [MvPolynomial.mem_homogeneousSubmodule]
    dsimp only [L]
    exact MvPolynomial.IsHomogeneous.sum _ _ _
      (fun μ _ => (MvPolynomial.isHomogeneous_X k μ).C_mul (t ^ (μ : ℕ)))
  have hBq_fin : ∀ q : ↥(AlgebraicGeometry.Proj 𝒜),
      {t : k | L t ∈ q.asHomogeneousIdeal.toIdeal}.Finite := by
    intro q
    let I : Ideal (MvPolynomial (Fin (M₀ + 1)) k) := q.asHomogeneousIdeal.toIdeal
    by_contra hInf
    have hInf' : {t : k | L t ∈ I}.Infinite := hInf
    obtain ⟨T, hT_sub, hT_card⟩ := hInf'.exists_subset_card_eq (M₀ + 1)
    let e : Fin (M₀ + 1) ≃ ↥T :=
      (T.equivFin.trans (Equiv.cast (congrArg Fin hT_card))).symm
    let v : Fin (M₀ + 1) → k := fun r => (e r).1
    have hv_inj : Function.Injective v := Subtype.val_injective.comp e.injective
    have hLv : ∀ r : Fin (M₀ + 1), L (v r) ∈ I := fun r => hT_sub (e r).2
    let V : Matrix (Fin (M₀ + 1)) (Fin (M₀ + 1)) k := Matrix.vandermonde v
    have hV_inv : V⁻¹ * V = 1 :=
      Matrix.nonsing_inv_mul V
        (isUnit_iff_ne_zero.mpr (Matrix.det_vandermonde_ne_zero_iff.mpr hv_inj))
    obtain ⟨μ₀, hμ₀_notMem⟩ := h_exists_X q
    have h_sum_mem : ∑ r : Fin (M₀ + 1), MvPolynomial.C (V⁻¹ μ₀ r) * L (v r) ∈ I :=
      I.sum_mem fun r _ => I.mul_mem_left _ (hLv r)
    have h_recon : ∑ r : Fin (M₀ + 1), MvPolynomial.C (V⁻¹ μ₀ r) * L (v r) = MvPolynomial.X μ₀ := by
      calc ∑ r : Fin (M₀ + 1), MvPolynomial.C (V⁻¹ μ₀ r) * L (v r)
          = ∑ r : Fin (M₀ + 1), ∑ μ : Fin (M₀ + 1),
              MvPolynomial.C (V⁻¹ μ₀ r * v r ^ (μ : ℕ)) * MvPolynomial.X μ := by
            refine Finset.sum_congr rfl fun r _ => ?_
            dsimp only [L]
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun μ _ => ?_
            rw [← mul_assoc, ← MvPolynomial.C_mul]
        _ = ∑ μ : Fin (M₀ + 1),
              (∑ r : Fin (M₀ + 1), MvPolynomial.C (V⁻¹ μ₀ r * V r μ)) * MvPolynomial.X μ := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun μ _ => ?_
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun r _ => ?_
            have hVrμ : v r ^ (μ : ℕ) = V r μ := (Matrix.vandermonde_apply v r μ).symm
            rw [hVrμ]
        _ = ∑ μ : Fin (M₀ + 1),
              MvPolynomial.C ((V⁻¹ * V) μ₀ μ) * MvPolynomial.X μ := by
            refine Finset.sum_congr rfl fun μ _ => ?_
            rw [← map_sum, ← Matrix.mul_apply]
        _ = ∑ μ : Fin (M₀ + 1),
              MvPolynomial.C ((1 : Matrix (Fin (M₀ + 1)) (Fin (M₀ + 1)) k) μ₀ μ) * MvPolynomial.X μ := by
            rw [hV_inv]
        _ = MvPolynomial.X μ₀ := by
            simp [Matrix.one_apply, apply_ite]
    rw [h_recon] at h_sum_mem
    exact hμ₀_notMem h_sum_mem
  have hFibCov : ∀ b : B₀.left, ∃ V_b : H.Opens,
      AlgebraicGeometry.IsAffineOpen V_b ∧ p.base ⁻¹' {b} ⊆ (V_b : Set H) := by
    intro b
    let S_b : Set ↥(AlgebraicGeometry.Proj 𝒜) := j.base '' (p.base ⁻¹' {b})
    have hSb_fin : S_b.Finite := (hFinFib b).image j.base
    have hBS_fin : (⋃ q ∈ S_b, {t : k | L t ∈ q.asHomogeneousIdeal.toIdeal}).Finite :=
      hSb_fin.biUnion fun q _ => hBq_fin q
    obtain ⟨t₀, ht₀⟩ := hBS_fin.exists_notMem
    let D_L : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 (L t₀)
    have hAffDL : AlgebraicGeometry.IsAffineOpen D_L :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (L t₀) (hL_hom t₀) zero_lt_one
    let V_b : H.Opens := (TopologicalSpace.Opens.map j.base).obj D_L
    have hAffVb : AlgebraicGeometry.IsAffineOpen V_b := hAffDL.preimage j
    refine ⟨V_b, hAffVb, ?_⟩
    intro z hz
    have hzq : j.base z ∈ S_b := ⟨z, hz, rfl⟩
    have ht₀_q : L t₀ ∉ (j.base z).asHomogeneousIdeal := by
      intro hmem
      exact ht₀ (Set.mem_biUnion hzq hmem)
    exact (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (L t₀) (j.base z)).mpr ht₀_q
  
  change AlgebraicGeometry.IsFinite p
  rw [AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom]
  refine ⟨hProp_p, AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen p fun b => ?_⟩
  obtain ⟨V_b, hAffV, hFibSub⟩ := hFibCov b
  have hClosed_p : IsClosedMap (p.base : H → B₀.left) :=
    AlgebraicGeometry.Scheme.Hom.isClosedMap p
  let K_b : Set B₀.left := p.base '' ((V_b : Set H)ᶜ)
  have hKb_closed : IsClosed K_b := hClosed_p _ V_b.isOpen.isClosed_compl
  have hb_not_Kb : b ∉ K_b := by
    rintro ⟨z, hz_notV, hzb⟩
    exact hz_notV (hFibSub hzb)
  let W₀ : B₀.left.Opens := ⟨K_bᶜ, hKb_closed.isOpen_compl⟩
  obtain ⟨U_b, hAffU, hb_U, hUb_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := W₀) hb_not_Kb
  have hPre : ((TopologicalSpace.Opens.map p.base).obj U_b : Set H) ⊆ (V_b : Set H) := by
    intro x hx
    by_contra hx_notV
    have hpx_Kb : p.base x ∈ K_b := ⟨x, hx_notV, rfl⟩
    exact hUb_sub hx hpx_Kb
  let i_V := hAffV.fromSpec
  let i_U := hAffU.fromSpec
  have : AlgebraicGeometry.IsAffineHom (i_U ≫ B₀.hom) :=
    AlgebraicGeometry.isAffineHom_of_isAffine (i_U ≫ B₀.hom)
  have : AlgebraicGeometry.IsAffineHom i_U :=
    AlgebraicGeometry.IsAffineHom.of_comp i_U B₀.hom
  have : AlgebraicGeometry.IsOpenImmersion i_V := hAffV.isOpenImmersion_fromSpec
  have : AlgebraicGeometry.IsOpenImmersion i_U := hAffU.isOpenImmersion_fromSpec
  let π₁ := CategoryTheory.Limits.pullback.fst (i_V ≫ p) i_U
  let π₂ := CategoryTheory.Limits.pullback.snd (i_V ≫ p) i_U
  have : AlgebraicGeometry.IsOpenImmersion π₁ := inferInstance
  have : AlgebraicGeometry.IsOpenImmersion (π₁ ≫ i_V) := inferInstance
  have hAffRange : AlgebraicGeometry.IsAffineOpen (π₁ ≫ i_V).opensRange :=
    AlgebraicGeometry.isAffineOpen_opensRange (π₁ ≫ i_V)
  have hEqRange : (π₁ ≫ i_V).opensRange = (TopologicalSpace.Opens.map p.base).obj U_b := by
    apply SetLike.ext
    intro x
    constructor
    · intro hx
      rw [← SetLike.mem_coe, AlgebraicGeometry.Scheme.Hom.coe_opensRange] at hx
      obtain ⟨q, rfl⟩ := hx
      have hcomm : (π₁ ≫ (i_V ≫ p)).base q = (π₂ ≫ i_U).base q :=
        congrArg (fun g => g.base q)
          (CategoryTheory.Limits.pullback.condition (f := i_V ≫ p) (g := i_U))
      have hpx_eq : p.base ((π₁ ≫ i_V).base q) = i_U.base (π₂.base q) := by
        simpa [CategoryTheory.Category.assoc] using hcomm
      have hiU_mem : i_U.base (π₂.base q) ∈ i_U.opensRange := by
        rw [← SetLike.mem_coe, AlgebraicGeometry.Scheme.Hom.coe_opensRange]
        exact ⟨π₂.base q, rfl⟩
      rw [hAffU.opensRange_fromSpec] at hiU_mem
      change p.base ((π₁ ≫ i_V).base q) ∈ U_b
      rwa [hpx_eq]
    · intro hx
      have hxV : x ∈ V_b := hPre hx
      rw [← hAffV.opensRange_fromSpec, ← SetLike.mem_coe,
        AlgebraicGeometry.Scheme.Hom.coe_opensRange] at hxV
      obtain ⟨y, rfl⟩ := hxV
      have hy_π₁ : y ∈ π₁.opensRange := by
        rw [AlgebraicGeometry.Scheme.Hom.opensRange_pullbackFst, hAffU.opensRange_fromSpec]
        change (i_V ≫ p).base y ∈ U_b
        simpa using hx
      rw [← SetLike.mem_coe, AlgebraicGeometry.Scheme.Hom.coe_opensRange] at hy_π₁
      obtain ⟨q, rfl⟩ := hy_π₁
      rw [← SetLike.mem_coe, AlgebraicGeometry.Scheme.Hom.coe_opensRange]
      exact ⟨q, rfl⟩
  rw [hEqRange] at hAffRange
  exact ⟨U_b, hb_U, hAffU, hAffRange⟩

theorem weil_relDimOne_etale_derivation_and_slice_away (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S)
    (hSm : RingHom.IsStandardSmoothOfRelativeDimension 1 φ) :
    letI : Algebra R S := φ.toAlgebra
    ∃ (ψ : MvPolynomial (Fin 1) R →+* S) (der_S : Derivation R S S),
      ψ.comp MvPolynomial.C = φ ∧
      ψ.Etale ∧
      der_S (ψ (MvPolynomial.X 0)) = 1 ∧
      (∀ (F₀ : Type u) [Field F₀] (k_R : F₀ →+* R) (ev : R →+* F₀),
        ev.comp k_R = RingHom.id F₀ →
        letI : Algebra F₀ (S ⧸ Ideal.map φ (RingHom.ker ev)) :=
          ((Ideal.Quotient.mk (Ideal.map φ (RingHom.ker ev))).comp (φ.comp k_R)).toAlgebra
        ∃ (ψ_k : MvPolynomial (Fin 1) F₀ →+* (S ⧸ Ideal.map φ (RingHom.ker ev)))
          (der_T : Derivation F₀ (S ⧸ Ideal.map φ (RingHom.ker ev))
            (S ⧸ Ideal.map φ (RingHom.ker ev))),
          ψ_k.comp MvPolynomial.C = algebraMap F₀ (S ⧸ Ideal.map φ (RingHom.ker ev)) ∧
          ψ_k.Etale ∧
          der_T (Ideal.Quotient.mk (Ideal.map φ (RingHom.ker ev)) (ψ (MvPolynomial.X 0))) = 1 ∧
          (∀ s : S,
            der_T (Ideal.Quotient.mk (Ideal.map φ (RingHom.ker ev)) s) =
              Ideal.Quotient.mk (Ideal.map φ (RingHom.ker ev)) (der_S s))) ∧
      (∀ (h : S) (Q B : Type u) [CommRing Q] [CommRing B] [Algebra Q B] (q : S →+* Q),
        Function.Surjective q →
        RingHom.ker q = Ideal.span {h} →
        IsLocalization.Away (q (der_S h)) B →
        RingHom.IsStandardSmoothOfRelativeDimension 0 ((algebraMap Q B).comp (q.comp φ))) :=
by
  let _ : Algebra R S := φ.toAlgebra
  obtain ⟨ψ, hψ_comp, hψ_et⟩ :=
    RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hSm
  let P := MvPolynomial (Fin 1) R
  let _ : Algebra P S := ψ.toAlgebra
  have _ : IsScalarTower R P S := IsScalarTower.of_algebraMap_eq' hψ_comp.symm
  have _ : Algebra.Etale P S := hψ_et.toAlgebra
  let d₀ : Derivation R P S :=
    (Algebra.ofId P S).toLinearMap.compDer (MvPolynomial.pderiv (0 : Fin 1))
  let ℓ₀ : KaehlerDifferential R P →ₗ[P] S := d₀.liftKaehlerDifferential
  let eΩ := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R P S
  let f_S : KaehlerDifferential R S →ₗ[S] S :=
    (LinearMap.liftBaseChange S ℓ₀).comp eΩ.symm.toLinearMap
  let der_S : Derivation R S S := f_S.compDer (KaehlerDifferential.D R S)
  have hder_ψ : ∀ p : P, der_S (ψ p) = ψ (MvPolynomial.pderiv (0 : Fin 1) p) := by
    intro p
    change (LinearMap.liftBaseChange S ℓ₀)
      (eΩ.symm (KaehlerDifferential.D R S (algebraMap P S p))) =
      ψ (MvPolynomial.pderiv (0 : Fin 1) p)
