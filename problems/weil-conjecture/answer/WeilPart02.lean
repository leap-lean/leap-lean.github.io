    refine (hFinS.image ι_S.base).subset ?_
    rintro z ⟨hz_b, hz_μ, hz_not⟩
    have hz_range_i : ι₁.left.base z ∈ Set.range i_μ.base := by
      have h_open_range : Set.range ⇑i_μ =
          (AlgebraicGeometry.Proj.basicOpen 𝒜 f_μ : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
