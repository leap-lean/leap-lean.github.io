            Ideal.Quotient.mk K_sq (p₁ * x.1) :=
        fun p₁ x => h_wd _ _ x (hlift_κ _)
      let B_quot : IsLocalRing.ResidueField S →ₗ[P] ↥J_P →ₗ[P] (P ⧸ K_sq) :=
