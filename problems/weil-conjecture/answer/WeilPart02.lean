          refine ⟨q₁ * q₂, ι_AK q₂.1 * x₁ + ι_AK q₁.1 * x₂, ?_⟩
          have hqmul : ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K (q₁ * q₂).1) =
              ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q₁.1) *
                ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q₂.1) := by
            change ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K (q₁.1 * q₂.1)) = _
            rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
          have ht₁ : ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K (q₁ * q₂).1) * w₁ =
              η_CK (ι_AK q₂.1 * x₁) := by
            calc ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K (q₁ * q₂).1) * w₁
                = ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q₂.1) *
                    (((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q₁.1) * w₁) := by
                    rw [hqmul]; ring
              _ = η_CK (ι_AK q₂.1) * η_CK x₁ := by rw [hx₁, hηι]
              _ = η_CK (ι_AK q₂.1 * x₁) := (map_mul η_CK _ _).symm
          have ht₂ : ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K (q₁ * q₂).1) * w₂ =
              η_CK (ι_AK q₁.1 * x₂) := by
            calc ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K (q₁ * q₂).1) * w₂
                = ((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q₁.1) *
                    (((1 : C) ⊗ₜ[MvPolynomial (Fin m) k] Φ_K q₂.1) * w₂) := by
                    rw [hqmul, mul_assoc]
              _ = η_CK (ι_AK q₁.1) * η_CK x₂ := by rw [hx₂, hηι]
              _ = η_CK (ι_AK q₁.1 * x₂) := (map_mul η_CK _ _).symm
          rw [mul_add, ht₁, ht₂, ← map_add]
      have hInj_ϒ : Function.Injective ϒ := by
        rw [injective_iff_map_eq_zero]
        intro w hw
        obtain ⟨q, x, hqx⟩ := hClear w
        have hx0 : algebraMap (TensorProduct k C K) (FractionRing (TensorProduct k C K)) x = 0 := by
          rw [← hϒη, ← hqx, map_mul, hw, mul_zero]
        have hx_eq : x = 0 :=
