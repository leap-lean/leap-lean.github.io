theorem weil_algClosed_bertini_transversal_step (k : Type u) [Field k] [IsAlgClosed k] (N : ℕ) :
    (∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_X : X ⟶ weilProjectiveSpaceOver k N),
      AlgebraicGeometry.IsClosedImmersion ι_X.left →
      ∀ (U : X.left.Opens) (d : ℕ),
        AlgebraicGeometry.SmoothOfRelativeDimension d (U.ι ≫ X.hom) →
        IsTransversalLinearSlice k N X ι_X U d 0 Fin.elim0) ∧
    (∀ (p q_len : ℕ)
        (Y : Fin p → Set (weilProjectiveSpaceOver k N).left),
      (∀ a : Fin p, IsClosed (Y a)) →
      ∀ (X : Fin q_len → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_X : ∀ l : Fin q_len, X l ⟶ weilProjectiveSpaceOver k N),
      (∀ l : Fin q_len, AlgebraicGeometry.IsClosedImmersion (ι_X l).left) →
      ∀ (U : ∀ l : Fin q_len, (X l).left.Opens)
        (d ν : Fin q_len → ℕ),
      (∀ l : Fin q_len, 1 ≤ d l) →
      ∀ (F_prev : ∀ l : Fin q_len, Fin (ν l) → MvPolynomial (Fin (N + 1)) k),
      (∀ l : Fin q_len,
        IsTransversalLinearSlice k N (X l) (ι_X l) (U l) (d l) (ν l) (F_prev l)) →
      ∃ F_new : MvPolynomial (Fin (N + 1)) k,
        F_new ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 ∧
        F_new ≠ 0 ∧
        (∀ a : Fin p,
          topologicalKrullDim ↥(Y a ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y a)) ∧
        (∀ l : Fin q_len,
          IsTransversalLinearSlice k N (X l) (ι_X l) (U l) (d l - 1) (ν l + 1)
            (Fin.snoc (F_prev l) F_new))) :=
by
  refine ⟨weil_bertini_transversalLinearSlice_init_zero k N, ?_⟩
  intro p q_len Y hClosedY X ι_X hClX U d ν hd F_prev hSl
  have hLinHom : ∀ c : Fin (N + 1) → k,
      (∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 := by
    intro c
    exact Submodule.sum_mem _ fun a _ => MvPolynomial.isHomogeneous_C_mul_X (c a) a
  obtain ⟨Δ_closed, hΔcl_ne, hΔcl_drop⟩ :=
    weil_algClosed_proj_closedSet_avoidance_poly k N p Y hClosedY
  have hLocusPkg : ∀ l : Fin q_len,
      ∃ Δ_l : MvPolynomial (Fin (N + 1)) k,
        Δ_l ≠ 0 ∧
        ∀ c : Fin (N + 1) → k,
          MvPolynomial.eval c Δ_l ≠ 0 →
          IsTransversalLinearSlice k N (X l) (ι_X l) (U l) (d l - 1) (ν l + 1)
            (Fin.snoc (F_prev l)
              (∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a)) := by
    intro l
    have hSchemePkg := weil_bertini_scheme_chart_cover_and_advance k N
      (X l) (ι_X l) (hClX l) (U l) (d l) (ν l) (F_prev l) (hSl l)
    obtain ⟨m_charts, α₀, V, hAffV, hVU, hVα, s, φ, q, f_lift, x_coord, P_h, hCov, hCharts⟩ :=
      hSchemePkg.1
    have hChartElim : ∀ i : Fin m_charts,
        ∃ Δ_i : MvPolynomial (Fin (N + 1)) k,
          Δ_i ≠ 0 ∧
          ∀ (c : Fin (N + 1) → k) (x : (X l).left) (hxV : x ∈ V i),
            MvPolynomial.eval c Δ_i ≠ 0 →
            (∀ j : Fin (ν l),
              (ι_X l).left.base x ∈ weilProjHyperplaneSet k N (F_prev l j)) →
            (ι_X l).left.base x ∈ weilProjHyperplaneSet k N
              (∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a) →
            ∃ (f_new_lift : MvPolynomial (Fin (s i + ν l + d l)) k) (γ₀ : Fin (d l)),
              (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
                 MvPolynomial.gradedAlgebra
               ∀ (hFn : (∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ∈
                   MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
                 (hXα : (MvPolynomial.X (α₀ i) : MvPolynomial (Fin (N + 1)) k) ∈
                   MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
                 (hpos : 0 < 1),
                 (φ i) f_new_lift =
                   ((AlgebraicGeometry.Proj.basicOpenIsoAway
                     (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
                     (MvPolynomial.X (α₀ i)) hXα hpos).hom ≫
                     (ι_X l).left.appLE
                       (AlgebraicGeometry.Proj.basicOpen
                         (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
                         (MvPolynomial.X (α₀ i)))
                       (V i) (hVα i)).hom
                     (HomogeneousLocalization.mk
                       ⟨1, ⟨∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a, hFn⟩,
                         ⟨MvPolynomial.X (α₀ i), hXα⟩, ⟨1, pow_one _⟩⟩)) ∧
              Matrix.det (Matrix.of fun a b : Fin (s i + ν l + 1) =>
                (φ i) (MvPolynomial.pderiv
                  (Fin.snoc (α := fun _ => Fin (s i + ν l + d l))
                    (Fin.castAdd (d l)) (Fin.natAdd (s i + ν l) γ₀) b)
                  (Fin.snoc (α := fun _ => MvPolynomial (Fin (s i + ν l + d l)) k)
                    (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s i + ν l + d l)) k)
                      (q i) (f_lift i))
                    f_new_lift a))) ∉
                ((hAffV i).primeIdealOf ⟨x, hxV⟩).asIdeal := by
      intro i
      obtain ⟨hSurj, _hSpec, hKer, hf_lift_eq, _hDet_q, hDet_qf, hUnit_Ph, hLoc_Ph,
        hLinForm, hHypMem⟩ := hCharts i
      obtain ⟨Ψ, v, U_bar, hΨ, hUv, hSchur⟩ :=
        weil_bertini_tangent_frame_and_schur_det k N (s i) (ν l) (d l)
          ↑((X l).left.presheaf.obj (Opposite.op (V i)))
          (φ i) hSurj (q i) hKer (f_lift i) hDet_qf (α₀ i) (x_coord i) (P_h i) hUnit_Ph hLoc_Ph
      let I_sl : Ideal ↑((X l).left.presheaf.obj (Opposite.op (V i))) :=
        Ideal.span (Set.range (fun j : Fin (ν l) => (φ i) (f_lift i j)))
      let S := ↑((X l).left.presheaf.obj (Opposite.op (V i))) ⧸ I_sl
      let π_S : ↑((X l).left.presheaf.obj (Opposite.op (V i))) →+* S := Ideal.Quotient.mk I_sl
      let ψ : MvPolynomial (Fin ((s i + ν l) + d l)) k →+* S := π_S.comp (φ i)
      have hSurj_ψ : Function.Surjective ψ :=
        Ideal.Quotient.mk_surjective.comp hSurj
      let H : Fin (s i + ν l) → MvPolynomial (Fin ((s i + ν l) + d l)) k :=
        Fin.addCases (motive := fun _ => MvPolynomial (Fin ((s i + ν l) + d l)) k)
          (q i) (f_lift i)
      have hVanish : ∀ a : Fin (s i + ν l), ψ (H a) = 0 := by
        refine Fin.addCases ?_ ?_
        · intro a₀
          change π_S ((φ i) (H (Fin.castAdd (ν l) a₀))) = 0
          simp only [H, Fin.addCases_left]
          have hmem : q i a₀ ∈ RingHom.ker (φ i) := by
            rw [hKer]
            exact Ideal.subset_span ⟨a₀, rfl⟩
          rw [RingHom.mem_ker.mp hmem, map_zero]
        · intro j
          change π_S ((φ i) (H (Fin.natAdd (s i) j))) = 0
          simp only [H, Fin.addCases_right]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
      let M₀ : Matrix (Fin (s i + ν l)) (Fin (s i + ν l))
          ↑((X l).left.presheaf.obj (Opposite.op (V i))) :=
        Matrix.of fun a b : Fin (s i + ν l) =>
          (φ i) (MvPolynomial.pderiv (Fin.castAdd (d l) b) (H a))
      have hDet_M₀ : IsUnit M₀.det := hDet_qf
      have hDet_ψ : IsUnit (Matrix.det (Matrix.of fun a b : Fin (s i + ν l) =>
          ψ (MvPolynomial.pderiv (Fin.castAdd (d l) b) (H a)))) := by
        have hMatEq : (Matrix.of fun a b : Fin (s i + ν l) =>
            ψ (MvPolynomial.pderiv (Fin.castAdd (d l) b) (H a))) = π_S.mapMatrix M₀ := by
          ext a b
          rfl
        rw [hMatEq, ← RingHom.map_det]
        exact hDet_M₀.map π_S
      obtain ⟨Δ_i, hΔi_ne, hΔi_good⟩ :=
        weil_bertini_trdeg_bad_incidence_eliminant k N (s i + ν l) (d l) S ψ hSurj_ψ H
          hVanish hDet_ψ (α₀ i) (fun m => π_S (x_coord i m)) (v.map π_S) U_bar hUv
      refine ⟨Δ_i, hΔi_ne, ?_⟩
      intro c x hxV hc_ne hxPrev hxNew
      let 𝔭 := (hAffV i).primeIdealOf ⟨x, hxV⟩
      have : 𝔭.asIdeal.IsPrime := 𝔭.isPrime
      have hXα₀ : (MvPolynomial.X (α₀ i) : MvPolynomial (Fin (N + 1)) k) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 :=
        MvPolynomial.isHomogeneous_X k (α₀ i)
      have hIsl_le : I_sl ≤ 𝔭.asIdeal := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨j, rfl⟩
        change (φ i) (f_lift i j) ∈ 𝔭.asIdeal
        rw [hf_lift_eq j ((hSl l).1 j) hXα₀ zero_lt_one]
        exact hHypMem ⟨x, hxV⟩ (F_prev l j) ((hSl l).1 j) hXα₀ zero_lt_one (hxPrev j)
      have hKer_le : RingHom.ker π_S ≤ 𝔭.asIdeal := by
        dsimp [π_S]
        rwa [Ideal.mk_ker]
      have hPrime_q : (Ideal.map π_S 𝔭.asIdeal).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hKer_le
      let 𝔮 : PrimeSpectrum S := ⟨Ideal.map π_S 𝔭.asIdeal, hPrime_q⟩
      have hComap_q : Ideal.comap π_S 𝔮.asIdeal = 𝔭.asIdeal := by
        change Ideal.comap π_S (Ideal.map π_S 𝔭.asIdeal) = 𝔭.asIdeal
        rw [Ideal.comap_map_of_surjective' π_S Ideal.Quotient.mk_surjective]
        exact sup_eq_left.mpr hKer_le
      have hInc_p : (φ i) (MvPolynomial.C (c (α₀ i))) +
          ∑ m : Fin N, (φ i) (MvPolynomial.C (c ((α₀ i).succAbove m))) * x_coord i m ∈
          𝔭.asIdeal := by
        rw [← hLinForm c (hLinHom c) hXα₀ zero_lt_one]
        exact hHypMem ⟨x, hxV⟩ _ (hLinHom c) hXα₀ zero_lt_one hxNew
      have hInc_q : ψ (MvPolynomial.C (c (α₀ i))) +
          ∑ m : Fin N, ψ (MvPolynomial.C (c ((α₀ i).succAbove m))) * π_S (x_coord i m) ∈
          𝔮.asIdeal := by
        have hMap : π_S ((φ i) (MvPolynomial.C (c (α₀ i))) +
            ∑ m : Fin N, (φ i) (MvPolynomial.C (c ((α₀ i).succAbove m))) * x_coord i m) ∈
            𝔮.asIdeal := by
          rw [← Ideal.mem_comap, hComap_q]
          exact hInc_p
        simpa [ψ, map_add, map_sum, map_mul] using hMap
      obtain ⟨γ₀, hγ₀_notMem_q⟩ := hΔi_good c 𝔮 hc_ne hInc_q
      have hγ₀_notMem_p :
          ∑ m : Fin N, (φ i) (MvPolynomial.C (c ((α₀ i).succAbove m))) * v m γ₀ ∉ 𝔭.asIdeal := by
        intro hMem_p
        apply hγ₀_notMem_q
        have hMap : π_S (∑ m : Fin N,
            (φ i) (MvPolynomial.C (c ((α₀ i).succAbove m))) * v m γ₀) ∈ 𝔮.asIdeal := by
          rw [← Ideal.mem_comap, hComap_q]
          exact hMem_p
        simpa [ψ, map_sum, map_mul] using hMap
      let f_new_lift : MvPolynomial (Fin (s i + ν l + d l)) k :=
        MvPolynomial.C (c (α₀ i)) +
          ∑ m : Fin N, MvPolynomial.C (c ((α₀ i).succAbove m)) * Ψ m
      refine ⟨f_new_lift, γ₀, ?_, ?_⟩
      · intro hFn hXα hpos
        rw [hLinForm c hFn hXα hpos]
        simp only [f_new_lift, map_add, map_sum, map_mul, hΨ]
      · rw [hSchur c γ₀]
        have hM₀_notMem : M₀.det ∉ 𝔭.asIdeal := fun hMem =>
          𝔭.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hMem hDet_M₀)
        exact 𝔭.isPrime.mul_notMem hM₀_notMem hγ₀_notMem_p
    choose Δ_i hΔi_ne hΔi_step using hChartElim
    refine ⟨∏ i : Fin m_charts, Δ_i i, Finset.prod_ne_zero_iff.mpr fun i _ => hΔi_ne i, ?_⟩
    intro c hc_prod
    have hc_each : ∀ i : Fin m_charts, MvPolynomial.eval c (Δ_i i) ≠ 0 := by
      rw [map_prod, Finset.prod_ne_zero_iff] at hc_prod
      exact fun i => hc_prod i (Finset.mem_univ i)
    refine hSchemePkg.2 (hd l) _ (hLinHom c) ?_
    intro x hxU hxPrev hxNew
    obtain ⟨i, hxV⟩ := hCov x hxU hxPrev
    obtain ⟨hSurj, hSpec, hKer, hf_lift_eq, hDet_q, _⟩ := hCharts i
    obtain ⟨f_new_lift, γ₀, hf_new_eq, hDet_aug⟩ :=
      hΔi_step i c x hxV (hc_each i) hxPrev hxNew
    exact ⟨α₀ i, V i, hAffV i, hxV, hVU i, hVα i, s i, φ i, q i, f_lift i, f_new_lift, γ₀,
      hSurj, hSpec, hKer, hf_lift_eq, hf_new_eq, hDet_q, hDet_aug⟩
  choose Δ_l hΔl_ne hΔl_adv using hLocusPkg
  let Δ_tot : MvPolynomial (Fin (N + 1)) k :=
    MvPolynomial.X 0 * Δ_closed * ∏ l : Fin q_len, Δ_l l
  have hΔtot_ne : Δ_tot ≠ 0 := by
    refine mul_ne_zero (mul_ne_zero (MvPolynomial.X_ne_zero 0) hΔcl_ne) ?_
    exact Finset.prod_ne_zero_iff.mpr fun l _ => hΔl_ne l
  have hc_exists : ∃ c : Fin (N + 1) → k, MvPolynomial.eval c Δ_tot ≠ 0 := by
    by_contra! hAllZero
    apply hΔtot_ne
    exact MvPolynomial.funext fun c => by simp [hAllZero c]
  obtain ⟨c, hc_tot⟩ := hc_exists
  dsimp only [Δ_tot] at hc_tot
  rw [map_mul, map_mul, MvPolynomial.eval_X, mul_ne_zero_iff, mul_ne_zero_iff] at hc_tot
  obtain ⟨⟨hc0, hc_cl⟩, hc_prod⟩ := hc_tot
  have hc_each_l : ∀ l : Fin q_len, MvPolynomial.eval c (Δ_l l) ≠ 0 := by
    rw [map_prod, Finset.prod_ne_zero_iff] at hc_prod
    exact fun l => hc_prod l (Finset.mem_univ l)
  let F_new : MvPolynomial (Fin (N + 1)) k :=
    ∑ a : Fin (N + 1), MvPolynomial.C (c a) * MvPolynomial.X a
  have hFnew_ne : F_new ≠ 0 := by
    intro hZero
    have hEval : MvPolynomial.eval (Pi.single 0 1) F_new = 0 := by
      rw [hZero, map_zero]
    have hCalc : MvPolynomial.eval (Pi.single 0 1) F_new = c 0 := by
      simp [F_new, map_sum, Pi.single_apply]
    exact hc0 (hCalc.symm.trans hEval)
  exact ⟨F_new, hLinHom c, hFnew_ne, hΔcl_drop c hc_cl,
    fun l => hΔl_adv l c (hc_each_l l)⟩

theorem weil_transversalLinearSlice_relative_smooth_chart (k : Type u) [Field k] (N d ν : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : X ⟶ weilProjectiveSpaceOver k N)
    (hClX : AlgebraicGeometry.IsClosedImmersion ι_X.left)
    (U : X.left.Opens)
    (F : Fin ν → MvPolynomial (Fin (N + 1)) k)
    (hSlice : IsTransversalLinearSlice k N X ι_X U d ν F)
    (G : MvPolynomial (Fin (N + 1)) k)
    (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1) :
    ∃ W : X.left.Opens,
      (∀ x : X.left, x ∈ U →
        ι_X.left.base x ∉ weilProjHyperplaneSet k N G →
        (∀ j : Fin ν, ι_X.left.base x ∈ weilProjHyperplaneSet k N (F j)) →
        x ∈ W) ∧
      (∀ x : X.left, x ∈ W → ι_X.left.base x ∉ weilProjHyperplaneSet k N G) ∧
      (∀ ψ : (W : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k ν).left,
        IsLinearProjChartMorphism k N ν X.left ι_X.left F G W ψ →
        AlgebraicGeometry.SmoothOfRelativeDimension d ψ) :=
by
  let _ := hClX
  
  have h_s4 : ∀ {X_s Y_s : AlgebraicGeometry.Scheme.{u}}
      {ι : Type u} (W_fam : ι → X_s.Opens) (W_tot : X_s.Opens) (_ : W_tot = ⨆ i : ι, W_fam i)
      (ψ : (W_tot : AlgebraicGeometry.Scheme.{u}) ⟶ Y_s),
      (∀ (i : ι) (hle : W_fam i ≤ W_tot),
        AlgebraicGeometry.SmoothOfRelativeDimension d (X_s.homOfLE hle ≫ ψ)) →
      AlgebraicGeometry.SmoothOfRelativeDimension d ψ := by
    intro X_s Y_s ι W_fam W_tot hW ψ hSm
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro z
    have hzW : z.1 ∈ ⨆ i : ι, W_fam i := hW ▸ z.2
    obtain ⟨i, hzi⟩ := TopologicalSpace.Opens.mem_iSup.mp hzW
    have hle : W_fam i ≤ W_tot := hW ▸ le_iSup W_fam i
    let j : (W_fam i).toScheme ⟶ W_tot.toScheme := X_s.homOfLE hle
    have h₀ : AlgebraicGeometry.SmoothOfRelativeDimension d (j ≫ ψ) := hSm i hle
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at h₀
    obtain ⟨U_Y, hAffU, V₀, hAffV₀, hzV₀, e₀, hStd₀⟩ := h₀ ⟨z.1, hzi⟩
    let V_img : W_tot.toScheme.Opens := j ''ᵁ V₀
    have hAffV : AlgebraicGeometry.IsAffineOpen V_img := hAffV₀.image_of_isOpenImmersion j
    have hzV : z ∈ V_img := by
      refine ⟨⟨z.1, hzi⟩, hzV₀, ?_⟩
      apply Subtype.ext
      exact AlgebraicGeometry.Scheme.homOfLE_apply hle ⟨z.1, hzi⟩
    have e : V_img ≤ ψ ⁻¹ᵁ U_Y := by
      rintro _ ⟨w, hw, rfl⟩
      exact e₀ hw
    have hpre_eq : j ⁻¹ᵁ V_img = V₀ := by
      ext w
      refine ⟨?_, fun hw => ⟨w, hw, rfl⟩⟩
      rintro ⟨w', hw', hEq⟩
      cases j.isOpenEmbedding.injective hEq
      exact hw'
    have hIso_app : CategoryTheory.IsIso (j.app V_img) :=
      AlgebraicGeometry.PresheafedSpace.IsOpenImmersion.c_iso V₀
    have hIso_map : CategoryTheory.IsIso
        ((W_fam i).toScheme.presheaf.map (CategoryTheory.homOfLE hpre_eq.ge).op) := by
      have : CategoryTheory.IsIso (CategoryTheory.homOfLE hpre_eq.ge).op :=
        ⟨⟨(CategoryTheory.homOfLE hpre_eq.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
      infer_instance
    have hIso : CategoryTheory.IsIso (j.appLE V_img V₀ hpre_eq.ge) := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_app hIso_map
    refine ⟨U_Y, hAffU, V_img, hAffV, hzV, e, ?_⟩
    let φ_app := ψ.appLE U_Y V_img e
    let ξ := j.appLE V_img V₀ hpre_eq.ge
    have hcomp : φ_app ≫ ξ = (j ≫ ψ).appLE U_Y V₀ e₀ :=
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j ψ U_Y V_img V₀ e hpre_eq.ge
    have hφ_eq : φ_app = (j ≫ ψ).appLE U_Y V₀ e₀ ≫ CategoryTheory.inv ξ := by
      rw [← hcomp, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
        CategoryTheory.Category.comp_id]
    let e_ring : ↑((W_fam i).toScheme.presheaf.obj (Opposite.op V₀)) ≃+*
        ↑(W_tot.toScheme.presheaf.obj (Opposite.op V_img)) :=
      (CategoryTheory.asIso ξ).symm.commRingCatIsoToRingEquiv
    have h_std' : RingHom.IsStandardSmoothOfRelativeDimension d
        (e_ring.toRingHom.comp ((j ≫ ψ).appLE U_Y V₀ e₀).hom) :=
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _ e_ring hStd₀
    have hhom : φ_app.hom = e_ring.toRingHom.comp ((j ≫ ψ).appLE U_Y V₀ e₀).hom := by
      rw [hφ_eq, CommRingCat.hom_comp]
      rfl
    rwa [hhom]

  
  have h_s2 : ∀ (hT : (MvPolynomial.X (Fin.last ν) : MvPolynomial (Fin (ν + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k 1),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k) :=
        MvPolynomial.gradedAlgebra
      ∃ e_ν : MvPolynomial (Fin ν) k ≃+*
          HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k)
            (MvPolynomial.X (Fin.last ν)),
        (∀ c : k,
          e_ν (MvPolynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k)
              (Submonoid.powers (MvPolynomial.X (Fin.last ν)))
              (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k 0) c)) ∧
        (∀ (j : Fin ν)
            (hXj : (MvPolynomial.X j.castSucc : MvPolynomial (Fin (ν + 1)) k) ∈
              MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k 1),
          e_ν (MvPolynomial.X j) =
            HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X j.castSucc, hXj⟩,
                ⟨MvPolynomial.X (Fin.last ν), hT⟩,
                Submonoid.mem_powers (MvPolynomial.X (Fin.last ν))⟩) := by
    intro hT
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (ν + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let T_last : MvPolynomial (Fin (ν + 1)) k := MvPolynomial.X (Fin.last ν)
    let S : Submonoid (MvPolynomial (Fin (ν + 1)) k) := Submonoid.powers T_last
    let R_base := HomogeneousLocalization.Away 𝒜 T_last
    let ι_k : k →+* R_base :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S).comp (algebraMap k ↥(𝒜 0))
    let u : Fin ν → R_base := fun j =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X j.castSucc, MvPolynomial.isHomogeneous_X k j.castSucc⟩,
          ⟨T_last, hT⟩, Submonoid.mem_powers T_last⟩
    let α : MvPolynomial (Fin ν) k →+* R_base := MvPolynomial.eval₂Hom ι_k u
    let dehom : MvPolynomial (Fin (ν + 1)) k →+* MvPolynomial (Fin ν) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C (Fin.snoc MvPolynomial.X 1)
    have hdehom_T : dehom T_last = 1 := by
      simp [dehom, T_last]
    have hdehom_S : ∀ y : S, IsUnit (dehom y.1) := by
      rintro ⟨_, m, rfl⟩
      rw [map_pow, hdehom_T, one_pow]
      exact isUnit_one
    let valHom : R_base →+* Localization S :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let L_loc : Localization S →+* MvPolynomial (Fin ν) k := IsLocalization.lift hdehom_S
    have hL_mk : ∀ (a : MvPolynomial (Fin (ν + 1)) k) (b : S),
        L_loc (Localization.mk a b) = dehom a := by
      intro a b
      rw [Localization.mk_eq_mk']
      refine (IsLocalization.lift_mk'_spec hdehom_S a (dehom a) b).mpr ?_
      obtain ⟨m, hm⟩ := b.2
      have hb1 : dehom b.1 = 1 := by rw [← hm, map_pow, hdehom_T, one_pow]
      rw [hb1, one_mul]
    let β : R_base →+* MvPolynomial (Fin ν) k := L_loc.comp valHom
    have hβ_α : β.comp α = RingHom.id (MvPolynomial (Fin ν) k) := by
      apply MvPolynomial.ringHom_ext'
      · refine RingHom.ext fun c => ?_
        simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_C, β, valHom,
          RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, ι_k]
        have hval : (HomogeneousLocalization.fromZeroRingHom 𝒜 S (algebraMap k ↥(𝒜 0) c)).val =
            Localization.mk (MvPolynomial.C c) 1 := rfl
        rw [hval, hL_mk]
        simp [dehom]
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_X', β, valHom,
          RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, u]
        rw [HomogeneousLocalization.val_mk, hL_mk]
        simp [dehom]
    have h_monom : ∀ (m : ℕ) (deg_v : Fin (ν + 1) →₀ ℕ) (c : k),
        (∑ i : Fin (ν + 1), deg_v i) = m →
        (α (dehom (MvPolynomial.monomial deg_v c))).val =
          Localization.mk (MvPolynomial.monomial deg_v c)
            ⟨T_last ^ m, pow_mem (Submonoid.mem_powers T_last) m⟩ := by
      intro m deg_v c hdm
      have hmon_eq : MvPolynomial.monomial deg_v c =
          MvPolynomial.C c * ∏ i : Fin (ν + 1), MvPolynomial.X i ^ deg_v i := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_of_support_subset _ (Finset.subset_univ _) _
          (fun i _ => pow_zero _)]
      have hdehom_m : dehom (MvPolynomial.monomial deg_v c) =
          MvPolynomial.C c * ∏ j : Fin ν, MvPolynomial.X j ^ deg_v j.castSucc := by
        rw [hmon_eq, Fin.prod_univ_castSucc]
        simp only [dehom, map_mul, map_prod, map_pow, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', Fin.snoc_castSucc, Fin.snoc_last, one_pow, mul_one]
      rw [hdehom_m, hmon_eq, Fin.prod_univ_castSucc]
      change (valHom.comp α) (MvPolynomial.C c * ∏ j : Fin ν, MvPolynomial.X j ^ deg_v j.castSucc) = _
      rw [map_mul, map_prod]
      have hCc : (valHom.comp α) (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        simp only [RingHom.comp_apply, α, MvPolynomial.eval₂Hom_C]
        rfl
      have hXj : ∀ j : Fin ν, (valHom.comp α) (MvPolynomial.X j ^ deg_v j.castSucc) =
          Localization.mk (MvPolynomial.X j.castSucc ^ deg_v j.castSucc)
            ⟨T_last ^ deg_v j.castSucc, pow_mem (Submonoid.mem_powers T_last) _⟩ := by
        intro j
        rw [map_pow]
        have huj : (valHom.comp α) (MvPolynomial.X j) =
            Localization.mk (MvPolynomial.X j.castSucc) ⟨T_last, Submonoid.mem_powers T_last⟩ := by
          simp only [RingHom.comp_apply, α, MvPolynomial.eval₂Hom_X']
          exact HomogeneousLocalization.val_mk _
        rw [huj, Localization.mk_pow]
        rfl
      rw [hCc, Finset.prod_congr rfl fun j _ => hXj j]
      have hprod_mk : ∀ (s : Finset (Fin ν)),
          (∏ j ∈ s, Localization.mk (MvPolynomial.X j.castSucc ^ deg_v j.castSucc)
            (⟨T_last ^ deg_v j.castSucc, pow_mem (Submonoid.mem_powers T_last) _⟩ : S)) =
          Localization.mk (∏ j ∈ s, MvPolynomial.X j.castSucc ^ deg_v j.castSucc)
            ⟨T_last ^ (∑ j ∈ s, deg_v j.castSucc), pow_mem (Submonoid.mem_powers T_last) _⟩ := by
        intro s
        induction s using Finset.cons_induction with
        | empty => simp
        | cons j s hjs ih =>
          rw [Finset.prod_cons, Finset.prod_cons, Finset.sum_cons, ih, Localization.mk_mul]
          congr 1
          exact Subtype.ext (pow_add T_last (deg_v j.castSucc) _).symm
      rw [hprod_mk Finset.univ, Localization.mk_mul, one_mul, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      dsimp only
      rw [← hdm, Fin.sum_univ_castSucc, pow_add]
      dsimp only [T_last]
      ring
    have h_homog : ∀ (m : ℕ) (p : MvPolynomial (Fin (ν + 1)) k),
        p ∈ 𝒜 m →
        (α (dehom p)).val =
          Localization.mk p ⟨T_last ^ m, pow_mem (Submonoid.mem_powers T_last) m⟩ := by
      intro m p hp
      have hp_sum : p = ∑ deg_v ∈ p.support, MvPolynomial.monomial deg_v (p.coeff deg_v) :=
        p.as_sum
      conv_lhs => rw [hp_sum]
      conv_rhs => rw [hp_sum]
      change (valHom.comp α) (dehom (∑ deg_v ∈ p.support, MvPolynomial.monomial deg_v (p.coeff deg_v))) = _
      rw [map_sum, map_sum]
      have hdeg_d : ∀ deg_v ∈ p.support, (∑ i : Fin (ν + 1), deg_v i) = m := by
        intro deg_v hd
        have hne : p.coeff deg_v ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hwm := hp hne
        simpa [Finsupp.weight_apply, Finsupp.linearCombination_apply, Finsupp.sum_fintype] using hwm
      have hsum_mk : ∀ (s : Finset (Fin (ν + 1) →₀ ℕ)),
          (∀ deg_v ∈ s, (∑ i : Fin (ν + 1), deg_v i) = m) →
          (∑ deg_v ∈ s, ((valHom.comp α) (dehom (MvPolynomial.monomial deg_v (p.coeff deg_v))))) =
            Localization.mk (∑ deg_v ∈ s, MvPolynomial.monomial deg_v (p.coeff deg_v))
              ⟨T_last ^ m, pow_mem (Submonoid.mem_powers T_last) m⟩ := by
        intro s hs
        induction s using Finset.cons_induction with
        | empty =>
          simp only [Finset.sum_empty, Localization.mk_zero]
        | cons deg_v s hds ih =>
          rw [Finset.sum_cons, Finset.sum_cons, ih (fun x hx => hs x (Finset.mem_cons_of_mem hx))]
          have hd_eq : (valHom.comp α) (dehom (MvPolynomial.monomial deg_v (p.coeff deg_v))) =
              Localization.mk (MvPolynomial.monomial deg_v (p.coeff deg_v))
                ⟨T_last ^ m, pow_mem (Submonoid.mem_powers T_last) m⟩ :=
            h_monom m deg_v (p.coeff deg_v) (hs deg_v (Finset.mem_cons_self deg_v s))
          rw [hd_eq, Localization.add_mk_self]
      exact hsum_mk p.support hdeg_d
    have hα_β : α.comp β = RingHom.id R_base := by
      refine RingHom.ext fun z => ?_
      obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
      apply HomogeneousLocalization.val_injective
      change (α (L_loc (HomogeneousLocalization.mk nd).val)).val =
        (HomogeneousLocalization.mk nd).val
      rw [HomogeneousLocalization.val_mk, hL_mk]
      obtain ⟨m, hm⟩ := nd.den_mem
      dsimp only at hm
      have hTm_hom : (T_last ^ m).IsHomogeneous m := by
        have h := MvPolynomial.IsHomogeneous.pow (MvPolynomial.isHomogeneous_X k (Fin.last ν)) m
        rwa [one_mul] at h
      have hTm_ne : T_last ^ m ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) h0
        simp [T_last] at hev
      have hdeg_eq : nd.deg = m := by
        have hden_hom : (T_last ^ m).IsHomogeneous nd.deg := by
          rw [hm]
          exact nd.den.2
        exact MvPolynomial.IsHomogeneous.inj_right hden_hom hTm_hom hTm_ne
      have hnum_m : nd.num.1 ∈ 𝒜 m := hdeg_eq ▸ nd.num.2
      rw [h_homog m nd.num.1 hnum_m]
      congr 1
      exact Subtype.ext hm
    refine ⟨{ α with
        invFun := β
        left_inv := fun x => RingHom.congr_fun hβ_α x
        right_inv := fun x => RingHom.congr_fun hα_β x }, ?_, ?_⟩
    · intro c
