        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_id : Ψ_L.toRingHom.comp Ψ_L.symm.toRingHom = RingHom.id _ :=
            RingHom.ext (fun v => Ψ_L.apply_symm_apply v)
          rw [h_id]; simp
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_id : Ψ_L.symm.toRingHom.comp Ψ_L.toRingHom = RingHom.id _ :=
            RingHom.ext (fun b => Ψ_L.symm_apply_apply b)
