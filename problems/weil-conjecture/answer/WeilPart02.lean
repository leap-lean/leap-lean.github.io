          (((Algebra.TensorProduct.includeRight :
            FractionRing R →ₐ[MvPolynomial (Fin m) k]
              TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R)).restrictScalars k).comp
            (IsScalarTower.toAlgHom k K (FractionRing R)))
