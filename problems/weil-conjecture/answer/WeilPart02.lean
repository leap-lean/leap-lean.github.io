        rw [hsmul1, hsmul2]
        exact TensorProduct.smul_tmul (R := MvPolynomial (Fin m) k)
          (MvPolynomial.X j) (1 : C) (1 : R)
      have hπ_y0 : π_CL_D (y idx0) = (1 : C) ⊗ₜ[MvPolynomial (Fin m) k] ϖ := by
        simp only [y, map_sub, hπ_tmul, map_one, hπ_xC, hw0, a_L]
