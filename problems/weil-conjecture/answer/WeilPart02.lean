      rw [← CategoryTheory.Category.assoc e_pre_ℓ.inv, he_pre_ℓ_ι]
      apply CategoryTheory.Limits.pullback.hom_ext
      · simp only [CategoryTheory.Category.assoc]
        rw [hΦ'_fst, he_V₁_fst, he_Wℓ_fst, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        refine (congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_).symm
        apply RingHom.ext
        intro r
        dsimp only [Ψ_1, RingHom.comp_apply]
        rw [MvPolynomial.eval₂Hom_C]
      · simp only [CategoryTheory.Category.assoc]
        rw [hΦ'_snd, hφ'_1, he_Wℓ_snd]
        dsimp only [φ'_1]
        rw [← CategoryTheory.Category.assoc e_V₁.inv, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp_assoc,
          ← CommRingCat.ofHom_comp]
        refine (congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
          (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ?_).symm
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply]
          dsimp only [Ψ_1]
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, hθ₁_C]
        · intro r
          simp only [RingHom.comp_apply]
          dsimp only [Ψ_1]
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
    · 
      intro e_Wi he_Wi_fst he_Wi_snd hClosed_i
      by_cases hi : i = b
      · 
        subst hi
        have hpre_eq_V₀ : Φ'_b ⁻¹ᵁ W'_open i.castSucc = V'₀ := by
          rw [hpre_W' i.castSucc]
          ext z
          change φ'_b.base z ∈ U_m1 i.castSucc ↔ z ∈ V'₀
          constructor
          · intro hz_b
            have hz_cov : z ∈ V'₀ ⊔ V'₁ := by rw [hcov_V']; trivial
            rcases hz_cov with hz₀ | hz₁
            · exact hz₀
            · let q₁ : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₁)) := e_V₁.hom.base ⟨z, hz₁⟩
              have hq₁_z : (e_V₁.inv ≫ V'₁.ι).base q₁ = z := by
                change V'₁.ι.base ((e_V₁.hom ≫ e_V₁.inv).base ⟨z, hz₁⟩) = z
                rw [CategoryTheory.Iso.hom_inv_id]
                exact AlgebraicGeometry.Scheme.Opens.ι_apply V'₁ ⟨z, hz₁⟩
              have hq₁_map : (e_V₁.inv ≫ V'₁.ι ≫ φ'_b).base q₁ ∈ U_m1 i.castSucc := by
                change φ'_b.base ((e_V₁.inv ≫ V'₁.ι).base q₁) ∈ U_m1 i.castSucc
                rwa [hq₁_z]
              rw [hφ'_1] at hq₁_map
              have hq₁_θ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
                  (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι).base q₁ ∈ U_m1 i.castSucc := by
                dsimp only [φ'_1] at hq₁_map
                rwa [← CategoryTheory.Category.assoc e_V₁.inv, CategoryTheory.Iso.inv_hom_id,
                  CategoryTheory.Category.id_comp] at hq₁_map
              have hpre_s₀ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
                  (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ⁻¹ᵁ U_m1 i.castSucc =
                  PrimeSpectrum.basicOpen s₀ := by
                change AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ⁻¹ᵁ
                    (((iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ⁻¹ᵁ U_m1 i.castSucc) = _
                rw [hiso_m1_pre ℓ i.castSucc (Fin.castSucc_ne_last i),
                  AlgebraicGeometry.SpecMap_preimage_basicOpen]
                congr 1
                exact hθ₁_b (Fin.castSucc_ne_last i)
              have hq₁_bo : q₁ ∈ PrimeSpectrum.basicOpen s₀ := by
                have hmem : q₁ ∈ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
                    (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ⁻¹ᵁ U_m1 i.castSucc := hq₁_θ
                rwa [hpre_s₀] at hmem
              rw [← hpre_V₁_V₀] at hq₁_bo
              change z ∈ V'₀
              rwa [← hq₁_z]
          · intro hz₀
            have h1 : φ'_b.base (V'₀.ι.base ⟨z, hz₀⟩) = φ'_0.base ⟨z, hz₀⟩ := by
              rw [← hφ'_0]
              rfl
            rw [AlgebraicGeometry.Scheme.Opens.ι_apply] at h1
            rw [h1]
            exact ((e_V₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫
              (iso_m1 i.castSucc).inv).base ⟨z, hz₀⟩).2
        let iso_eq_0 : ((Φ'_b ⁻¹ᵁ W'_open i.castSucc) : AlgebraicGeometry.Scheme.{u}) ≅
            (V'₀ : AlgebraicGeometry.Scheme.{u}) :=
          { hom := E'_b.homOfLE hpre_eq_V₀.le
            inv := E'_b.homOfLE hpre_eq_V₀.ge
            hom_inv_id := by
              rw [← CategoryTheory.cancel_mono (Φ'_b ⁻¹ᵁ W'_open i.castSucc).ι,
                CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι,
                AlgebraicGeometry.Scheme.homOfLE_ι, CategoryTheory.Category.id_comp]
            inv_hom_id := by
              rw [← CategoryTheory.cancel_mono V'₀.ι, CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι,
                CategoryTheory.Category.id_comp] }
        let e_pre_0 := iso_eq_0 ≪≫ e_V₀
        let Ψ_0 : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} R_b →+* A₀ :=
          MvPolynomial.eval₂Hom MvPolynomial.C (fun r => θ₀ (MvPolynomial.X r))
        let ρ_0 : A₀ →+* MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} R_b :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun _ => MvPolynomial.X ⟨ℓ, (Fin.castSucc_ne_last i).symm⟩)
        have hSurj_0 : Function.Surjective Ψ_0 := by
          have hcomp : Ψ_0.comp ρ_0 = RingHom.id A₀ := by
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro p
              simp only [RingHom.comp_apply]
              dsimp only [Ψ_0, ρ_0]
              rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
              rfl
            · intro r
              rw [h_idx₁ r]
              simp only [RingHom.comp_apply]
              dsimp only [Ψ_0, ρ_0]
              rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
                hθ₀_ℓ (Fin.castSucc_ne_last i).symm]
              rfl
          intro P
          exact ⟨ρ_0 P, congrArg (fun f : A₀ →+* A₀ => f P) hcomp⟩
        apply hClosed_i A₀ e_pre_0 Ψ_0 hSurj_0
        have he_pre_0_ι : e_pre_0.inv ≫ (Φ'_b ⁻¹ᵁ W'_open i.castSucc).ι = e_V₀.inv ≫ V'₀.ι := by
          change (e_V₀.inv ≫ E'_b.homOfLE hpre_eq_V₀.ge) ≫ (Φ'_b ⁻¹ᵁ W'_open i.castSucc).ι = _
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
        rw [← CategoryTheory.Category.assoc e_pre_0.inv, he_pre_0_ι]
        apply CategoryTheory.Limits.pullback.hom_ext
        · simp only [CategoryTheory.Category.assoc]
          rw [hΦ'_fst, he_V₀_fst, he_Wi_fst, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp]
          refine (congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_).symm
          apply RingHom.ext
          intro r
          dsimp only [Ψ_0, RingHom.comp_apply]
          rw [MvPolynomial.eval₂Hom_C]
        · simp only [CategoryTheory.Category.assoc]
          rw [hΦ'_snd, hφ'_0, he_Wi_snd]
          dsimp only [φ'_0]
          rw [← CategoryTheory.Category.assoc e_V₀.inv, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp_assoc,
            ← CommRingCat.ofHom_comp]
          refine (congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
            (iso_m1 i.castSucc).inv ≫ (U_m1 i.castSucc).ι) ?_).symm
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            simp only [RingHom.comp_apply]
            dsimp only [Ψ_0]
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, hθ₀_C]
          · intro r
            simp only [RingHom.comp_apply]
            dsimp only [Ψ_0]
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · 
        have hi_cast : i.castSucc ≠ b.castSucc := fun h => hi (Fin.castSucc_inj.mp h)
        let t_i : R_b := MvPolynomial.X ⟨i, hi⟩
        let t_tilde : A₀ := MvPolynomial.C t_i
        have hle_V₀ : Φ'_b ⁻¹ᵁ W'_open i.castSucc ≤ V'₀ := by
          rw [hpre_W' i.castSucc]
          intro z hz_i
          have hz_cov : z ∈ V'₀ ⊔ V'₁ := by rw [hcov_V']; trivial
          rcases hz_cov with hz₀ | hz₁
          · exact hz₀
          · let q₁ : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₁)) := e_V₁.hom.base ⟨z, hz₁⟩
            have hq₁_z : (e_V₁.inv ≫ V'₁.ι).base q₁ = z := by
              change V'₁.ι.base ((e_V₁.hom ≫ e_V₁.inv).base ⟨z, hz₁⟩) = z
              rw [CategoryTheory.Iso.hom_inv_id]
              exact AlgebraicGeometry.Scheme.Opens.ι_apply V'₁ ⟨z, hz₁⟩
            have hq₁_map : (e_V₁.inv ≫ V'₁.ι ≫ φ'_b).base q₁ ∈ U_m1 i.castSucc := by
              change φ'_b.base ((e_V₁.inv ≫ V'₁.ι).base q₁) ∈ U_m1 i.castSucc
              rw [hq₁_z]
              exact hz_i
            rw [hφ'_1] at hq₁_map
            have hq₁_θ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
                (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι).base q₁ ∈ U_m1 i.castSucc := by
              dsimp only [φ'_1] at hq₁_map
              rwa [← CategoryTheory.Category.assoc e_V₁.inv, CategoryTheory.Iso.inv_hom_id,
                CategoryTheory.Category.id_comp] at hq₁_map
            have hpre_prod : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
                (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ⁻¹ᵁ U_m1 i.castSucc =
                PrimeSpectrum.basicOpen (MvPolynomial.C t_i * s₀) := by
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ⁻¹ᵁ
                  (((iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ⁻¹ᵁ U_m1 i.castSucc) = _
              rw [hiso_m1_pre ℓ i.castSucc (Fin.castSucc_ne_last i),
                AlgebraicGeometry.SpecMap_preimage_basicOpen]
              congr 1
              exact hθ₁_ne i (Fin.castSucc_ne_last i) hi
            have hq₁_bo : q₁ ∈ PrimeSpectrum.basicOpen (MvPolynomial.C t_i * s₀) := by
              have hmem : q₁ ∈ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
                  (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ⁻¹ᵁ U_m1 i.castSucc := hq₁_θ
              rwa [hpre_prod] at hmem
            rw [PrimeSpectrum.basicOpen_mul] at hq₁_bo
            have hq₁_s₀ : q₁ ∈ PrimeSpectrum.basicOpen s₀ := hq₁_bo.2
            rw [← hpre_V₁_V₀] at hq₁_s₀
            change z ∈ V'₀
            rwa [← hq₁_z]
        have hpre_ti : (e_V₀.inv ≫ V'₀.ι) ⁻¹ᵁ (Φ'_b ⁻¹ᵁ W'_open i.castSucc) =
            PrimeSpectrum.basicOpen t_tilde := by
          rw [hpre_W' i.castSucc]
          change (e_V₀.inv ≫ V'₀.ι ≫ φ'_b) ⁻¹ᵁ U_m1 i.castSucc = PrimeSpectrum.basicOpen t_tilde
          rw [hφ'_0]
          dsimp only [φ'_0]
          rw [← CategoryTheory.Category.assoc e_V₀.inv, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.id_comp]
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ⁻¹ᵁ
              (((iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι) ⁻¹ᵁ U_m1 i.castSucc) = _
          rw [hiso_m1_pre b.castSucc i.castSucc hi_cast,
            AlgebraicGeometry.SpecMap_preimage_basicOpen]
          congr 1
          exact hθ₀_cast i hi_cast hi
        obtain ⟨e_pre_i, he_pre_i_inv⟩ :=
          hLocChart t_tilde V'₀ (Φ'_b ⁻¹ᵁ W'_open i.castSucc) hle_V₀ e_V₀ hpre_ti
        let L_ti := Localization.Away t_tilde
        let y_i : P_amb_b := MvPolynomial.X ⟨i.castSucc, hi_cast⟩
        let g_yi : P_amb_b →+* L_ti := (algebraMap A₀ L_ti).comp θ₀
        have hg_yi_eq : g_yi y_i = algebraMap A₀ L_ti t_tilde := by
          change algebraMap A₀ L_ti (θ₀ (MvPolynomial.X ⟨i.castSucc, hi_cast⟩)) = _
          rw [hθ₀_cast i hi_cast hi]
        obtain ⟨lift_i, hg_yi_fac, hlift_i_eq, hlift_i_inv⟩ := hAwayLift y_i t_tilde g_yi hg_yi_eq
        let τ_bi : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} k →+*
            Localization.Away y_i :=
          MvPolynomial.eval₂Hom
            ((algebraMap P_amb_b (Localization.Away y_i)).comp MvPolynomial.C)
            (fun r => if h : r.1 = b.castSucc then IsLocalization.Away.invSelf y_i
              else algebraMap P_amb_b (Localization.Away y_i) (MvPolynomial.X ⟨r.1, h⟩) *
                IsLocalization.Away.invSelf y_i)
        let Ψ_3 : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} R_b →+* L_ti :=
          MvPolynomial.eval₂Hom ((algebraMap A₀ L_ti).comp MvPolynomial.C)
            (fun r => lift_i (τ_bi (MvPolynomial.X r)))
        have hSurj_3 : Function.Surjective Ψ_3 := by
          let w_b : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} R_b :=
            MvPolynomial.X ⟨b.castSucc, hi_cast.symm⟩
          let w_ℓ : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} R_b :=
            MvPolynomial.X ⟨ℓ, (Fin.castSucc_ne_last i).symm⟩
          have hΨ_wb : Ψ_3 w_b = IsLocalization.Away.invSelf t_tilde := by
            dsimp only [Ψ_3, w_b, τ_bi]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            simp only [↓reduceDIte]
            exact hlift_i_inv
          have hΨ_wℓ : Ψ_3 w_ℓ = algebraMap A₀ L_ti s₁ * IsLocalization.Away.invSelf t_tilde := by
            have hℓ_ne_b : ℓ ≠ b.castSucc := (Fin.castSucc_ne_last b).symm
            dsimp only [Ψ_3, w_ℓ, τ_bi]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
            simp only [hℓ_ne_b, ↓reduceDIte]
            rw [map_mul, hlift_i_eq, hlift_i_inv]
            congr 1
            change algebraMap A₀ L_ti (θ₀ (MvPolynomial.X ⟨ℓ, hℓ_ne_b⟩)) = _
            rw [hθ₀_ℓ hℓ_ne_b]
          have hΨ_prod : Ψ_3 (w_ℓ * MvPolynomial.C t_i) = algebraMap A₀ L_ti s₁ := by
            rw [map_mul, hΨ_wℓ]
            have hΨ_ti : Ψ_3 (MvPolynomial.C t_i) = algebraMap A₀ L_ti t_tilde := by
              dsimp only [Ψ_3]
              rw [MvPolynomial.eval₂Hom_C]
              rfl
            rw [hΨ_ti, mul_assoc, mul_comm (IsLocalization.Away.invSelf t_tilde),
              IsLocalization.Away.mul_invSelf (S := L_ti) t_tilde, mul_one]
          let η_i : A₀ →+* MvPolynomial {r : Fin (m + 1 + 1) // r ≠ i.castSucc} R_b :=
            MvPolynomial.eval₂Hom MvPolynomial.C (fun _ => w_ℓ * MvPolynomial.C t_i)
          have hΨ_η : Ψ_3.comp η_i = algebraMap A₀ L_ti := by
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro r
              simp only [RingHom.comp_apply]
              dsimp only [Ψ_3, η_i]
              rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
              rfl
            · intro r
              rw [h_idx₁ r]
              simp only [RingHom.comp_apply]
              dsimp only [η_i]
              rw [MvPolynomial.eval₂Hom_X', hΨ_prod]
          intro z
          obtain ⟨⟨p, _, n_z, rfl⟩, hz_eq⟩ := IsLocalization.surj (Submonoid.powers t_tilde) z
          refine ⟨η_i p * w_b ^ n_z, ?_⟩
          rw [map_mul, map_pow, hΨ_wb]
          have hη_p : Ψ_3 (η_i p) = algebraMap A₀ L_ti p :=
            congrArg (fun f : A₀ →+* L_ti => f p) hΨ_η
          rw [hη_p]
          have hunit_pow : IsUnit ((algebraMap A₀ L_ti t_tilde) ^ n_z) :=
            (IsLocalization.map_units L_ti ⟨t_tilde, Submonoid.mem_powers t_tilde⟩).pow n_z
          apply hunit_pow.mul_right_cancel
          rw [mul_assoc, ← mul_pow, mul_comm (IsLocalization.Away.invSelf t_tilde),
            IsLocalization.Away.mul_invSelf (S := L_ti) t_tilde, one_pow, mul_one]
          dsimp only at hz_eq
          rw [map_pow] at hz_eq
          exact hz_eq.symm
        apply hClosed_i L_ti e_pre_i Ψ_3 hSurj_3
        rw [← CategoryTheory.Category.assoc e_pre_i.inv, he_pre_i_inv]
        apply CategoryTheory.Limits.pullback.hom_ext
        · simp only [CategoryTheory.Category.assoc]
          rw [hΦ'_fst, he_V₀_fst, he_Wi_fst, ← AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
          apply RingHom.ext
          intro r
          dsimp only [Ψ_3, RingHom.comp_apply]
          rw [MvPolynomial.eval₂Hom_C]
          rfl
        · simp only [CategoryTheory.Category.assoc]
          rw [hΦ'_snd, hφ'_0, he_Wi_snd]
          dsimp only [φ'_0]
          rw [← CategoryTheory.Category.assoc e_V₀.inv, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp_assoc,
            ← CommRingCat.ofHom_comp]
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_yi) ≫
              (iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι = _
          rw [hg_yi_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp_assoc,
            hiso_m1_trans b.castSucc i.castSucc hi_cast,
            ← AlgebraicGeometry.Spec.map_comp_assoc, ← AlgebraicGeometry.Spec.map_comp_assoc,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
            (iso_m1 i.castSucc).inv ≫ (U_m1 i.castSucc).ι) ?_
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            simp only [RingHom.comp_apply]
            dsimp only [Ψ_3, τ_bi]
            rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hlift_i_eq,
              RingHom.comp_apply, hθ₀_C, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            rfl
          · intro r
            simp only [RingHom.comp_apply]
            dsimp only [Ψ_3, τ_bi]
            rw [MvPolynomial.eval₂Hom_X', MvPolynomial.map_X,
              MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']

  
  let ev0_1 : MvPolynomial {r : Fin (1 + 1) // r ≠ 1} k →+* k := MvPolynomial.eval 0
  let p_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P₁.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_1) ≫
      (iso_1 1).inv ≫ (U_1 1).ι
  have hp_inf_hom : p_inf ≫ P₁.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_1) ≫
        (iso_1 1).inv ≫ (U_1 1).ι) ≫ P₁.hom = _
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      hiso_1_inv_hom 1, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h1 : ev0_1.comp MvPolynomial.C = RingHom.id k := by
      apply RingHom.ext
      intro c
      exact MvPolynomial.eval_C c
    rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  have hs'_cond : 𝟙 S_b ≫ π_Rb = (π_Rb ≫ p_inf) ≫ P₁.hom := by
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hp_inf_hom,
      CategoryTheory.Category.comp_id]
  let s'_b : S_b ⟶ E'_b := CategoryTheory.Limits.pullback.lift (𝟙 S_b) (π_Rb ≫ p_inf) hs'_cond
  have hs'_fst : s'_b ≫ fst_E' = 𝟙 S_b := CategoryTheory.Limits.pullback.lift_fst _ _ _

  let ev0_A₁ : A₁ →+* R_b := MvPolynomial.eval 0
  have hs'_V₁ : s'_b =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_A₁) ≫ e_V₁.inv ≫ V'₁.ι := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [hs'_fst, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_V₁_fst,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h1 : ev0_A₁.comp MvPolynomial.C = RingHom.id R_b := by
        apply RingHom.ext
        intro r
        exact MvPolynomial.eval_C r
      rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, he_V₁_snd]
      dsimp only [π_Rb, p_inf]
      rw [← AlgebraicGeometry.Spec.map_comp_assoc, ← AlgebraicGeometry.Spec.map_comp_assoc,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        (iso_1 1).inv ≫ (U_1 1).ι) ?_
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply]
        dsimp only [ev0_1, ev0_A₁]
        rw [MvPolynomial.map_C, MvPolynomial.eval_C, MvPolynomial.eval_C]
        rfl
      · intro r
        simp only [RingHom.comp_apply]
        rw [MvPolynomial.eval_X, Pi.zero_apply, map_zero, MvPolynomial.map_X,
          MvPolynomial.eval_X, Pi.zero_apply]

  have hs'_p₀ : s'_b ≫ Φ'_b ≫ snd_Q' = π_Rb ≫ p₀_b := by
    rw [hΦ'_snd, hs'_V₁, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hφ'_1]
    dsimp only [φ'_1, π_Rb, p₀_b]
    rw [← CategoryTheory.Category.assoc e_V₁.inv, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp_assoc,
      ← AlgebraicGeometry.Spec.map_comp_assoc, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp]
    refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
      (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ?_
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      simp only [RingHom.comp_apply]
      dsimp only [ev0_A₁, ev0_ℓ]
      rw [hθ₁_C, MvPolynomial.eval_C, MvPolynomial.eval_C]
      rfl
    · rintro ⟨r, hr⟩
      obtain ⟨j, rfl⟩ := Fin.exists_castSucc_eq.mpr hr
      simp only [RingHom.comp_apply]
      have h_rhs : ev0_ℓ (MvPolynomial.X ⟨j.castSucc, hr⟩) = 0 := MvPolynomial.eval_X _
      rw [h_rhs, map_zero]
      by_cases hj : j = b
      · subst hj
        rw [hθ₁_b hr]
        exact MvPolynomial.eval_X _
      · rw [hθ₁_ne j hr hj, map_mul]
        have hs₀_0 : ev0_A₁ s₀ = 0 := MvPolynomial.eval_X _
        rw [hs₀_0, mul_zero]

  
  have : AlgebraicGeometry.IsSeparated P₁.hom := by
    dsimp [P₁, weilProjectiveSpaceOver]
    infer_instance
  have : AlgebraicGeometry.QuasiSeparated fst_E' := inferInstance
  have : QuasiSeparatedSpace ↥E'_b :=
    AlgebraicGeometry.quasiSeparatedSpace_of_quasiSeparated fst_E'

  have hPreIrred_chart : ∀ (C : Type u) [CommRing C] [IsDomain C] (W : E'_b.Opens)
      (_ : (W : AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec (CommRingCat.of C)),
      IsPreirreducible (W : Set ↥E'_b) := by
    intro C _ _ W e_W
    have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of C)) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (AlgebraicGeometry.Spec (CommRingCat.of C))
    let homeo := (AlgebraicGeometry.Scheme.homeoOfIso e_W).symm
    have hPre_W : IsPreirreducible (Set.univ : Set ↥(W : AlgebraicGeometry.Scheme.{u})) := by
      rw [← Set.image_univ_of_surjective homeo.surjective]
      exact PreirreducibleSpace.isPreirreducible_univ.image homeo homeo.continuous.continuousOn
    have himg : W.ι.base '' (Set.univ : Set ↥(W : AlgebraicGeometry.Scheme.{u})) = (W : Set ↥E'_b) := by
      rw [Set.image_univ, W.range_ι]
    rw [← himg]
    exact hPre_W.image W.ι.base W.ι.continuous.continuousOn

  have hPre₀ : IsPreirreducible (V'₀ : Set ↥E'_b) := hPreIrred_chart A₀ V'₀ e_V₀
  have hPre₁ : IsPreirreducible (V'₁ : Set ↥E'_b) := hPreIrred_chart A₁ V'₁ e_V₁

  obtain ⟨z_ov⟩ := hne_V'
  have : IrreducibleSpace ↥E'_b :=
    { isPreirreducible_univ := by
        have h_meet₀ : ∀ (U : Set ↥E'_b), IsOpen U → (Set.univ ∩ U).Nonempty →
            ((V'₀ : Set ↥E'_b) ∩ U).Nonempty := by
          intro U hU ⟨x, _, hxU⟩
          have hx_cov : x ∈ V'₀ ⊔ V'₁ := by rw [hcov_V']; trivial
          rcases hx_cov with hx₀ | hx₁
          · exact ⟨x, hx₀, hxU⟩
          · obtain ⟨w, _, hw₀, hwU⟩ :=
              hPre₁ (V'₀ : Set ↥E'_b) U V'₀.isOpen hU
                ⟨z_ov.1, z_ov.2.2, z_ov.2.1⟩ ⟨x, hx₁, hxU⟩
            exact ⟨w, hw₀, hwU⟩
        intro U_a U_b hUa hUb hNa hNb
        obtain ⟨w, _, hw_ab⟩ :=
          hPre₀ U_a U_b hUa hUb (h_meet₀ U_a hUa hNa) (h_meet₀ U_b hUb hNb)
        exact ⟨w, trivial, hw_ab⟩
      toNonempty := ⟨z_ov.1⟩ }

  have hRed_V₀ : AlgebraicGeometry.IsReduced (V'₀ : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.isReduced_of_isOpenImmersion e_V₀.hom
  have hRed_V₁ : AlgebraicGeometry.IsReduced (V'₁ : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.isReduced_of_isOpenImmersion e_V₁.hom
  have : ∀ c : 𝒰_E'.I₀, AlgebraicGeometry.IsReduced (𝒰_E'.X c) := by
    intro c
    cases c
    · exact hRed_V₀
    · exact hRed_V₁
  have : AlgebraicGeometry.IsReduced E'_b :=
    AlgebraicGeometry.IsReduced.of_openCover E'_b 𝒰_E'
  have : AlgebraicGeometry.IsIntegral E'_b :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced E'_b

  have hAff_V₀ : AlgebraicGeometry.IsAffine (V'₀ : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsAffine.of_isIso e_V₀.hom
  have hAff_V₁ : AlgebraicGeometry.IsAffine (V'₁ : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsAffine.of_isIso e_V₁.hom
  have : CompactSpace ↥(V'₀ : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.Scheme.compactSpace_of_isAffine (V'₀ : AlgebraicGeometry.Scheme.{u})
  have : Finite 𝒰_E'.I₀ := inferInstanceAs (Finite Bool)
  have : ∀ c : 𝒰_E'.I₀, AlgebraicGeometry.IsAffine (𝒰_E'.X c) := by
    intro c
    cases c
    · exact hAff_V₀
    · exact hAff_V₁
  have : ∀ c : 𝒰_E'.I₀, CompactSpace ↥(𝒰_E'.X c) :=
    fun c => AlgebraicGeometry.Scheme.compactSpace_of_isAffine (𝒰_E'.X c)
  have : CompactSpace ↥E'_b :=
    AlgebraicGeometry.Scheme.OpenCover.compactSpace 𝒰_E'
  have : AlgebraicGeometry.QuasiCompact V'₀.ι :=
    AlgebraicGeometry.quasiCompact_of_compactSpace V'₀.ι

  have hKer_V₀ : AlgebraicGeometry.Scheme.Hom.ker V'₀.ι = ⊥ := by
    ext U_aff : 2
    rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot,
      AlgebraicGeometry.Scheme.Opens.ι_app]
    by_cases hU : Nonempty ↥(U_aff.1 : E'_b.Opens)
    · obtain ⟨y₀⟩ := hU
      obtain ⟨z, _, hzV, hzU⟩ :=
        PreirreducibleSpace.isPreirreducible_univ V'₀.1 U_aff.1.1 V'₀.isOpen U_aff.1.isOpen
          ⟨z_ov.1, trivial, z_ov.2.1⟩ ⟨y₀.1, trivial, y₀.2⟩
      have hne_inter : Nonempty ↥(V'₀.ι ''ᵁ (TopologicalSpace.Opens.map V'₀.ι.base).obj U_aff.1) :=
        ⟨⟨z, ⟨⟨z, hzV⟩, hzU, rfl⟩⟩⟩
      have hle_inter : V'₀.ι ''ᵁ (TopologicalSpace.Opens.map V'₀.ι.base).obj U_aff.1 ≤ U_aff.1 := by
        rintro _ ⟨w, hw, rfl⟩
        exact hw
      have hinj := @AlgebraicGeometry.map_injective_of_isIntegral E'_b _
        (V'₀.ι ''ᵁ (TopologicalSpace.Opens.map V'₀.ι.base).obj U_aff.1) U_aff.1
        (CategoryTheory.homOfLE hle_inter) hne_inter
      exact (RingHom.injective_iff_ker_eq_bot _).mp hinj
    · rw [not_nonempty_iff] at hU
      have : IsEmpty ↥(U_aff.1 : AlgebraicGeometry.Scheme.{u}) := hU
      have h_emp_spec : IsEmpty ↥(AlgebraicGeometry.Spec (E'_b.presheaf.obj (Opposite.op U_aff.1))) :=
        (AlgebraicGeometry.Scheme.homeoOfIso U_aff.2.isoSpec).symm.isEmpty
      have : Subsingleton ↑(E'_b.presheaf.obj (Opposite.op U_aff.1)) :=
        PrimeSpectrum.isEmpty_iff_subsingleton.mp h_emp_spec
      ext x
      simp [Subsingleton.elim x 0]

  
  have hD₀_inv_hom : e_D₀.inv ≫ D₀_b.ι ≫ B₀.hom = π_Rb := by
    rw [hD₀_hom, CategoryTheory.Iso.inv_hom_id_assoc]

  let fst_Eb := CategoryTheory.Limits.pullback.fst (D₀_b.ι ≫ B₀.hom) P₁.hom
  let snd_Eb := CategoryTheory.Limits.pullback.snd (D₀_b.ι ≫ B₀.hom) P₁.hom

  have hisoE_hom_cond : (fst_Eb ≫ e_D₀.hom) ≫ π_Rb = snd_Eb ≫ P₁.hom := by
    rw [CategoryTheory.Category.assoc, ← hD₀_hom]
    exact CategoryTheory.Limits.pullback.condition
  have hisoE_inv_cond : (fst_E' ≫ e_D₀.inv) ≫ (D₀_b.ι ≫ B₀.hom) = snd_E' ≫ P₁.hom := by
    rw [CategoryTheory.Category.assoc, hD₀_inv_hom]
    exact CategoryTheory.Limits.pullback.condition

  let isoE : E_b ≅ E'_b :=
    { hom := CategoryTheory.Limits.pullback.lift (fst_Eb ≫ e_D₀.hom) snd_Eb hisoE_hom_cond
      inv := CategoryTheory.Limits.pullback.lift (fst_E' ≫ e_D₀.inv) snd_E' hisoE_inv_cond
      hom_inv_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc _ fst_E', CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc _ fst_Eb, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp] }

  let fst_Q := CategoryTheory.Limits.pullback.fst P_amb.hom B₀.hom
  let snd_Q := CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom
  have hTop_Qb : CategoryTheory.IsPullback (snd_Q ∣_ D₀_b) Q_b.ι D₀_b.ι snd_Q :=
    AlgebraicGeometry.isPullback_morphismRestrict snd_Q D₀_b
  have hBase_Qb : CategoryTheory.IsPullback snd_Q fst_Q B₀.hom P_amb.hom :=
    (CategoryTheory.IsPullback.of_hasPullback P_amb.hom B₀.hom).flip
  have hPb_Qb : CategoryTheory.IsPullback (snd_Q ∣_ D₀_b) (Q_b.ι ≫ fst_Q)
      (D₀_b.ι ≫ B₀.hom) P_amb.hom :=
    hTop_Qb.paste_vert hBase_Qb

  have hisoQ_hom_cond : ((snd_Q ∣_ D₀_b) ≫ e_D₀.hom) ≫ π_Rb = (Q_b.ι ≫ fst_Q) ≫ P_amb.hom := by
    rw [CategoryTheory.Category.assoc, ← hD₀_hom]
    exact hPb_Qb.w
  have hisoQ_inv_cond : (fst_Q' ≫ e_D₀.inv) ≫ (D₀_b.ι ≫ B₀.hom) = snd_Q' ≫ P_amb.hom := by
    rw [CategoryTheory.Category.assoc, hD₀_inv_hom]
    exact CategoryTheory.Limits.pullback.condition

  let isoQ : (Q_b : AlgebraicGeometry.Scheme.{u}) ≅ Q'_b :=
    { hom := CategoryTheory.Limits.pullback.lift ((snd_Q ∣_ D₀_b) ≫ e_D₀.hom)
        (Q_b.ι ≫ fst_Q) hisoQ_hom_cond
      inv := hPb_Qb.lift (fst_Q' ≫ e_D₀.inv) snd_Q' hisoQ_inv_cond
      hom_inv_id := by
        apply hPb_Qb.hom_ext
        · rw [CategoryTheory.Category.assoc, hPb_Qb.lift_fst,
            ← CategoryTheory.Category.assoc _ fst_Q', CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hPb_Qb.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc _ (snd_Q ∣_ D₀_b), hPb_Qb.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            hPb_Qb.lift_snd, CategoryTheory.Category.id_comp] }

  
  let Φ_b : E_b ⟶ (Q_b : AlgebraicGeometry.Scheme.{u}) :=
    isoE.hom ≫ Φ'_b ≫ isoQ.inv
  let s_b : (D₀_b : AlgebraicGeometry.Scheme.{u}) ⟶ E_b :=
    e_D₀.hom ≫ s'_b ≫ isoE.inv

  
  let g' : ((γ ⁻¹ᵁ Q_b) : AlgebraicGeometry.Scheme.{u}) ⟶ Q'_b :=
    (γ ∣_ Q_b) ≫ isoQ.hom
  let α_b : ((γ ⁻¹ᵁ Q_b) : AlgebraicGeometry.Scheme.{u}) ⟶
      (V'₀ : AlgebraicGeometry.Scheme.{u}) :=
    e_γ.hom ≫ β_b.hom

  have hfac_g' : g' = α_b ≫ V'₀.ι ≫ Φ'_b := by
    rw [← CategoryTheory.cancel_epi e_γ.inv]
    apply CategoryTheory.Limits.pullback.hom_ext
    · dsimp only [g', α_b, isoQ]
      simp only [CategoryTheory.Category.assoc]
      rw [CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc e_γ.inv e_γ.hom, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp]
      exact hγ_snd.trans hβ_fst.symm
    · dsimp only [g', α_b, isoQ]
      simp only [CategoryTheory.Category.assoc]
      rw [CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc e_γ.inv e_γ.hom, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp]
      exact hγ_fst.trans hβ_snd.symm

  have : CategoryTheory.IsIso e_γ.hom := e_γ.isIso_hom
  have : CategoryTheory.IsIso β_b.hom := β_b.isIso_hom
  have : CategoryTheory.IsIso isoE.hom := isoE.isIso_hom
  have : CategoryTheory.IsIso isoQ.inv := isoQ.isIso_inv
  have : CategoryTheory.IsIso α_b := by
    dsimp only [α_b]
    infer_instance

  have hKer_g' : AlgebraicGeometry.Scheme.Hom.ker g' =
      AlgebraicGeometry.Scheme.Hom.ker Φ'_b := by
    rw [hfac_g', AlgebraicGeometry.Scheme.Hom.ker_comp_of_isIso,
      AlgebraicGeometry.Scheme.Hom.ker_comp, hKer_V₀,
      AlgebraicGeometry.Scheme.IdealSheafData.map_bot]

  have hKer_b : AlgebraicGeometry.Scheme.Hom.ker (γ ∣_ Q_b) =
      AlgebraicGeometry.Scheme.Hom.ker Φ_b := by
    have hγ_eq : γ ∣_ Q_b = g' ≫ isoQ.inv := by
      dsimp only [g']
      rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.comp_id]
    have : AlgebraicGeometry.QuasiCompact isoQ.inv := inferInstance
    rw [hγ_eq, AlgebraicGeometry.Scheme.Hom.ker_comp, hKer_g',
      ← AlgebraicGeometry.Scheme.Hom.ker_comp]
    dsimp only [Φ_b]
    exact (AlgebraicGeometry.Scheme.Hom.ker_comp_of_isIso isoE.hom (Φ'_b ≫ isoQ.inv)).symm

  
  have hCl_Φ_final : AlgebraicGeometry.IsClosedImmersion Φ_b := by
    dsimp only [Φ_b]
    have : AlgebraicGeometry.IsClosedImmersion Φ'_b := hCl_Φ'
    infer_instance

  have hΦ_snd_final :
      Φ_b ≫ (snd_Q ∣_ D₀_b) = fst_Eb := by
    dsimp only [Φ_b]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    have hisoQ_snd : isoQ.inv ≫ (snd_Q ∣_ D₀_b) = fst_Q' ≫ e_D₀.inv :=
      hPb_Qb.lift_fst _ _ _
    rw [hisoQ_snd, ← CategoryTheory.Category.assoc Φ'_b, hΦ'_fst,
      ← CategoryTheory.Category.assoc isoE.hom]
    have hisoE_fst : isoE.hom ≫ fst_E' = fst_Eb ≫ e_D₀.hom :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    rw [hisoE_fst, CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
      CategoryTheory.Category.comp_id]

  have hs_fst_final :
      s_b ≫ fst_Eb = 𝟙 (D₀_b : AlgebraicGeometry.Scheme.{u}) := by
    dsimp only [s_b]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    have hisoE_inv_fst : isoE.inv ≫ fst_Eb = fst_E' ≫ e_D₀.inv :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    rw [hisoE_inv_fst, ← CategoryTheory.Category.assoc s'_b, hs'_fst,
      CategoryTheory.Category.id_comp, CategoryTheory.Iso.hom_inv_id]

  have hs_p₀_final :
      (s_b ≫ Φ_b ≫ Q_b.ι) ≫ fst_Q = D₀_b.ι ≫ B₀.hom ≫ p₀_b := by
    dsimp only [s_b, Φ_b]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc isoE.inv isoE.hom, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp]
    have hisoQ_fst : isoQ.inv ≫ Q_b.ι ≫ fst_Q = snd_Q' :=
      hPb_Qb.lift_snd _ _ _
    rw [hisoQ_fst, hs'_p₀, ← CategoryTheory.Category.assoc e_D₀.hom, ← hD₀_hom,
      CategoryTheory.Category.assoc]

  exact ⟨Φ_b, p₀_b, s_b, hCl_Φ_final, hΦ_snd_final, hKer_b,
    hp₀_hom, hp₀_range, hs_fst_final, hs_p₀_final⟩

theorem weil_projLine_smooth_and_baseChange_krullDim_one (k : Type u) [Field k] :
    let P₁ := weilProjectiveSpaceOver k 1
    AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁.hom ∧
    ∀ (K : Type u) [Field K]
      (α : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k)),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback P₁.hom α) ∧
      topologicalKrullDim ↥(CategoryTheory.Limits.pullback P₁.hom α) = (1 : WithBot ℕ∞) :=
by
  
  have hIrrel : ∀ (F : Type u) [Field F],
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) F) :=
        MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) F)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) F)) := by
    intro F _ p hp
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) F
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hp0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin 2) F) = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
    have hcoeff0 : p.coeff 0 = 0 := by
      classical
      conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 p]
      rw [MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro i _
      by_cases hi : i = 0
      · subst hi
        simp [hp0]
      · have hhom : ((DirectSum.decompose 𝒜 p i : 𝒜 i) : MvPolynomial (Fin 2) F).IsHomogeneous i :=
          (MvPolynomial.mem_homogeneousSubmodule i _).mp (DirectSum.decompose 𝒜 p i).2
        by_contra hne
        have hdeg := hhom hne
        rw [map_zero] at hdeg
        exact hi hdeg.symm
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm_ne : m ≠ 0 := by
      intro hm0
      subst hm0
      exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
    by_contra h_all
    push_neg at h_all
    apply hm_ne
    ext j
    exact h_all j (Set.mem_univ j)

  
  have hEquiv : ∀ (F : Type u) [Field F] (a : Fin 2)
      (x : MvPolynomial (Fin 2) F) (_ : x = MvPolynomial.X a),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) F) :=
        MvPolynomial.gradedAlgebra
      ∃ e : MvPolynomial (Fin 1) F ≃+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) F) x,
        (∀ c : F,
          e (MvPolynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin 2) F) (Submonoid.powers x)
              (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin 2) F 0) c)) ∧
        ∃ (hx1 : x ∈ MvPolynomial.homogeneousSubmodule (Fin 2) F 1)
          (hrev1 : MvPolynomial.X (Fin.rev a) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) F 1),
          e (MvPolynomial.X 0) =
            HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X (Fin.rev a), hrev1⟩, ⟨x, hx1⟩, Submonoid.mem_powers x⟩ := by
    intro F _ a x hx
    subst hx
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) F
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let S_a : Submonoid (MvPolynomial (Fin 2) F) := Submonoid.powers (MvPolynomial.X a)
    let a' : Fin 2 := Fin.rev a
    have ha' : a' ≠ a := by
      fin_cases a <;> decide
    have hX1 : ∀ j : Fin 2, (MvPolynomial.X j : MvPolynomial (Fin 2) F) ∈ 𝒜 1 :=
      fun j => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X F j)
    let ι₀ : F →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a).comp (algebraMap F ↥(𝒜 0))
    let t₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X a', hX1 a'⟩, ⟨MvPolynomial.X a, hX1 a⟩,
          Submonoid.mem_powers (MvPolynomial.X a)⟩
    let α_hom : MvPolynomial (Fin 1) F →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
      MvPolynomial.eval₂Hom ι₀ (fun _ => t₀)
    let w : Fin 2 → MvPolynomial (Fin 1) F :=
      fun j => if j = a then 1 else MvPolynomial.X 0
    let dehom : MvPolynomial (Fin 2) F →+* MvPolynomial (Fin 1) F :=
      MvPolynomial.eval₂Hom MvPolynomial.C w
    have hdehom_S : ∀ y : S_a, dehom y.1 = 1 := by
      rintro ⟨_, ⟨n, rfl⟩⟩
      simp [dehom, w]
    have hunit : ∀ y : S_a, IsUnit (dehom y.1) := by
      intro y
      rw [hdehom_S y]
      exact isUnit_one
    let β_loc : Localization S_a →+* MvPolynomial (Fin 1) F := IsLocalization.lift hunit
    have hβ_mk : ∀ (p : MvPolynomial (Fin 2) F) (y : S_a),
        β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      refine (IsLocalization.lift_mk'_spec hunit p (dehom p) y).mpr ?_
      rw [hdehom_S y, one_mul]
    let valHom : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) →+* Localization S_a :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let β_hom : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) →+* MvPolynomial (Fin 1) F :=
      β_loc.comp valHom
    have hι₀_val : ∀ c : F, (ι₀ c).val = Localization.mk (MvPolynomial.C c) 1 :=
      fun _ => rfl
    have h_left : β_hom.comp α_hom = RingHom.id (MvPolynomial (Fin 1) F) := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change β_loc (α_hom (MvPolynomial.C c)).val = MvPolynomial.C c
        rw [MvPolynomial.eval₂Hom_C, hι₀_val, hβ_mk]
        simp [dehom]
      · intro b
        have hb : b = 0 := Fin.eq_zero b
        subst hb
        change β_loc (α_hom (MvPolynomial.X 0)).val = MvPolynomial.X 0
        rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.val_mk, hβ_mk]
        simp [dehom, w, ha']
    have h_right : α_hom.comp β_hom =
        RingHom.id (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)) := by
      let ψ : MvPolynomial (Fin 2) F →+* Localization S_a := valHom.comp (α_hom.comp dehom)
      have hψ_C : ∀ c : F, ψ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        change (α_hom (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) 1
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        exact rfl
      have hψ_X : ∀ j : Fin 2,
          ψ (MvPolynomial.X j) =
            Localization.mk (MvPolynomial.X j)
              ⟨MvPolynomial.X a, Submonoid.mem_powers (MvPolynomial.X a)⟩ := by
        intro j
        change (α_hom (dehom (MvPolynomial.X j))).val = _
        rw [MvPolynomial.eval₂Hom_X']
        by_cases hja : j = a
        · subst hja
          simp only [w, ↓reduceIte, map_one, HomogeneousLocalization.val_one]
          exact (Localization.mk_self
            (⟨MvPolynomial.X j, Submonoid.mem_powers (MvPolynomial.X j)⟩ : S_a)).symm
        · have hja' : j = a' := by
            fin_cases a <;> fin_cases j <;> simp_all [a']
          simp only [w, hja, ↓reduceIte, α_hom, MvPolynomial.eval₂Hom_X']
          rw [hja']
          exact HomogeneousLocalization.val_mk _
      have hψ_mon : ∀ (m : Fin 2 →₀ ℕ) (c : F),
          ψ (MvPolynomial.monomial m c) =
            Localization.mk (MvPolynomial.monomial m c)
              ⟨MvPolynomial.X a ^ (m 0 + m 1),
                pow_mem (Submonoid.mem_powers (MvPolynomial.X a)) (m 0 + m 1)⟩ := by
        intro m c
        have hmon : (MvPolynomial.monomial m c : MvPolynomial (Fin 2) F) =
            MvPolynomial.C c * MvPolynomial.X 0 ^ m 0 * MvPolynomial.X 1 ^ m 1 := by
          rw [MvPolynomial.monomial_eq,
            Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two, mul_assoc]
        rw [hmon, map_mul, map_mul, map_pow, map_pow, hψ_C, hψ_X 0, hψ_X 1,
          Localization.mk_pow, Localization.mk_pow, Localization.mk_mul, Localization.mk_mul]
        congr 1
        apply Subtype.ext
        change (1 : MvPolynomial (Fin 2) F) * MvPolynomial.X a ^ m 0 * MvPolynomial.X a ^ m 1 =
          MvPolynomial.X a ^ (m 0 + m 1)
        rw [one_mul, ← pow_add]
      have hmk_sum : ∀ {α_idx : Type} (s : Finset α_idx)
          (g : α_idx → MvPolynomial (Fin 2) F) (y : S_a),
          (∑ m ∈ s, Localization.mk (g m) y) = Localization.mk (∑ m ∈ s, g m) y := by
        intro α_idx s g y
        classical
        induction s using Finset.induction_on with
        | empty => simp [Localization.mk_zero]
        | insert m s hms ih =>
          rw [Finset.sum_insert hms, Finset.sum_insert hms, ih, Localization.add_mk_self]
      have hwt : ∀ m : Fin 2 →₀ ℕ, (Finsupp.weight 1) m = m 0 + m 1 := by
        intro m
        rw [Finsupp.weight_apply,
          Finsupp.sum_fintype m _ (fun i => zero_smul ℕ ((1 : Fin 2 → ℕ) i)),
          Fin.sum_univ_two]
        simp
      have hψ_homog : ∀ (d : ℕ) (p : MvPolynomial (Fin 2) F),
          p ∈ 𝒜 d →
          ψ p = Localization.mk p
            ⟨MvPolynomial.X a ^ d,
              pow_mem (Submonoid.mem_powers (MvPolynomial.X a)) d⟩ := by
        intro d p hp
        have hp' : p.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d p).mp hp
        conv_lhs => rw [p.as_sum]
        rw [map_sum]
        have hcongr : ∀ m ∈ p.support,
            ψ (MvPolynomial.monomial m (p.coeff m)) =
              Localization.mk (MvPolynomial.monomial m (p.coeff m))
                ⟨MvPolynomial.X a ^ d,
                  pow_mem (Submonoid.mem_powers (MvPolynomial.X a)) d⟩ := by
          intro m hm
          have hmd : m 0 + m 1 = d := by
            rw [← hwt m]
            exact hp' (MvPolynomial.mem_support_iff.mp hm)
          rw [hψ_mon]
          congr 1
          apply Subtype.ext
          change MvPolynomial.X a ^ (m 0 + m 1) = MvPolynomial.X a ^ d
          rw [hmd]
        rw [Finset.sum_congr rfl hcongr, hmk_sum, ← p.as_sum]
      apply RingHom.ext
      intro z
      refine Quotient.inductionOn' z fun nd => ?_
      apply HomogeneousLocalization.val_injective
      change (α_hom (β_loc (HomogeneousLocalization.mk nd).val)).val =
        (HomogeneousLocalization.mk nd).val
      rw [HomogeneousLocalization.val_mk, hβ_mk]
      rcases nd.den_mem with ⟨n, hn⟩
      dsimp only at hn
      have hXa_pow_homog : ((MvPolynomial.X a : MvPolynomial (Fin 2) F) ^ n).IsHomogeneous n := by
        simpa using (MvPolynomial.isHomogeneous_X F a).pow n
      have hden_homog : nd.den.1.IsHomogeneous nd.deg :=
        (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
      rw [← hn] at hden_homog
      have hm₀_ne : ((MvPolynomial.X a : MvPolynomial (Fin 2) F) ^ n).coeff
          (Finsupp.single a n) ≠ 0 := by
        rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.coeff_monomial, if_pos rfl]
        exact one_ne_zero
      have hdeg_eq : nd.deg = n :=
        (hden_homog hm₀_ne).symm.trans (hXa_pow_homog hm₀_ne)
      have hnum_mem : nd.num.1 ∈ 𝒜 n := hdeg_eq ▸ nd.num.2
      change ψ nd.num.1 = Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩
      rw [hψ_homog n nd.num.1 hnum_mem]
      congr 1
      exact Subtype.ext hn
    let e : MvPolynomial (Fin 1) F ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a) :=
      { α_hom with
        invFun := β_hom
        left_inv := fun p => RingHom.congr_fun h_left p
        right_inv := fun z => RingHom.congr_fun h_right z }
    refine ⟨e, ?_, hX1 a, hX1 a', ?_⟩
    · intro c
      exact MvPolynomial.eval₂Hom_C ι₀ (fun _ => t₀) c
    · exact MvPolynomial.eval₂Hom_X' ι₀ (fun _ => t₀) 0

  
  have hSmoothCover : ∀ (R : Type u) [CommRing R]
      (X : AlgebraicGeometry.Scheme.{u})
      (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (U : Fin 2 → X.Opens),
      iSup U = ⊤ →
      (∀ a : Fin 2,
        ∃ iso_a : (U a).toScheme ≅
            AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) R)),
          (U a).ι ≫ p =
            iso_a.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 p := by
    intro R _ X p U hCov hChart
    have hStdC : RingHom.IsStandardSmoothOfRelativeDimension 1
        (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R) := by
      have hAlg := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial R (Fin 1)
      have hCard : Nat.card (Fin 1) = 1 := by simp
      rw [hCard] at hAlg
      exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hAlg
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk fun x => ?_
    have hx_top : x ∈ (⊤ : X.Opens) := trivial
    rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx_top
    obtain ⟨a, hxa⟩ := hx_top
    obtain ⟨iso_a, hfac_a⟩ := hChart a
    have hAff_scheme : AlgebraicGeometry.IsAffine (U a).toScheme :=
      @AlgebraicGeometry.IsAffine.of_isIso _ _ iso_a.hom _ inferInstance
    have hAffU : AlgebraicGeometry.IsAffineOpen (U a) := hAff_scheme
    let e_top : U a ≤ p ⁻¹ᵁ (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) :=
      fun _ _ => trivial
    let e_ι : (⊤ : (U a).toScheme.Opens) ≤ (U a).ι ⁻¹ᵁ U a := fun w _ => w.2
    have hpre_eq : (U a).ι ⁻¹ᵁ U a = ⊤ := by
      ext w
      exact ⟨fun _ => trivial, fun _ => w.2⟩
    have h_img : (U a).ι ''ᵁ (⊤ : (U a).toScheme.Opens) = U a := by
      ext y
      simp
    have hIso_app' : CategoryTheory.IsIso ((U a).ι.app ((U a).ι ''ᵁ ⊤)) :=
      AlgebraicGeometry.PresheafedSpace.IsOpenImmersion.c_iso ⊤
    have hIso_app : CategoryTheory.IsIso ((U a).ι.app (U a)) := by
      rwa [h_img] at hIso_app'
    have hIso_map : CategoryTheory.IsIso
        ((U a).toScheme.presheaf.map (CategoryTheory.homOfLE hpre_eq.ge).op) := by
      have : CategoryTheory.IsIso (CategoryTheory.homOfLE hpre_eq.ge).op :=
        ⟨⟨(CategoryTheory.homOfLE hpre_eq.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
      infer_instance
    have hIso_ι : CategoryTheory.IsIso ((U a).ι.appLE (U a) ⊤ e_ι) := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_app hIso_map
    let f_C := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R))
    have hcomp₁ : p.appLE ⊤ (U a) e_top ≫ (U a).ι.appLE (U a) ⊤ e_ι =
        ((U a).ι ≫ p).appTop := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
      exact AlgebraicGeometry.Scheme.Hom.appLE_eq_app ((U a).ι ≫ p) (U := ⊤)
    have hIso_iso_a : CategoryTheory.IsIso iso_a.hom.appTop :=
      ⟨⟨iso_a.inv.appTop,
        by rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_a.inv_hom_id]; rfl,
        by rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, iso_a.hom_inv_id]; rfl⟩⟩
    have hcomp₂ : ((U a).ι ≫ p).appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).hom ≫
          CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (MvPolynomial (Fin 1) R))).inv ≫
          iso_a.hom.appTop := by
      rw [hfac_a, AlgebraicGeometry.Scheme.Hom.comp_appTop]
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R))
      have hfC : f_C.appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).hom ≫
            CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R) ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (MvPolynomial (Fin 1) R))).inv := by
        rw [← CategoryTheory.cancel_mono
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) R))).hom]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.comp_id]
        exact hnat
      rw [hfC]
      simp only [CategoryTheory.Category.assoc]
    let e_iso_a : ((AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) R))).presheaf.obj
        (Opposite.op ⊤)) ≅ ((U a).toScheme.presheaf.obj (Opposite.op ⊤)) :=
      @CategoryTheory.asIso _ _ _ _ iso_a.hom.appTop hIso_iso_a
    let e_ι_iso : (X.presheaf.obj (Opposite.op (U a))) ≅
        ((U a).toScheme.presheaf.obj (Opposite.op ⊤)) :=
      @CategoryTheory.asIso _ _ _ _ ((U a).ι.appLE (U a) ⊤ e_ι) hIso_ι
    let rightIso : CommRingCat.of (MvPolynomial (Fin 1) R) ≅
        X.presheaf.obj (Opposite.op (U a)) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin 1) R))).symm ≪≫
        e_iso_a ≪≫ e_ι_iso.symm
    let leftIso := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)
    have happ_eq : p.appLE ⊤ (U a) e_top =
        leftIso.hom ≫
          CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R) ≫
          rightIso.hom := by
      rw [← CategoryTheory.cancel_mono e_ι_iso.hom]
      have h_lhs_eq : p.appLE ⊤ (U a) e_top ≫ e_ι_iso.hom = ((U a).ι ≫ p).appTop := hcomp₁
      rw [h_lhs_eq, hcomp₂]
      dsimp only [rightIso, leftIso, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id]
      simp only [CategoryTheory.Category.comp_id]
      rfl
    refine ⟨⊤, AlgebraicGeometry.isAffineOpen_top _, U a, hAffU, hxa, e_top, ?_⟩
    have hStd₁ : RingHom.IsStandardSmoothOfRelativeDimension 1
        (rightIso.commRingCatIsoToRingEquiv.toRingHom.comp
          (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R)) :=
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _
        rightIso.commRingCatIsoToRingEquiv hStdC
    have hStd₂ : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((rightIso.commRingCatIsoToRingEquiv.toRingHom.comp
          (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R)).comp
          leftIso.commRingCatIsoToRingEquiv.toRingHom) :=
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso.right _
        leftIso.commRingCatIsoToRingEquiv hStd₁
    have hhom_eq : (p.appLE ⊤ (U a) e_top).hom =
        ((rightIso.commRingCatIsoToRingEquiv.toRingHom.comp
          (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R)).comp
          leftIso.commRingCatIsoToRingEquiv.toRingHom) := by
      rw [happ_eq, CommRingCat.hom_comp, CommRingCat.hom_comp]
      rfl
    rwa [hhom_eq]

  
  have hProjBaseIso : ∀ (K : Type u) [Field K] (φ : k →+* K),
      letI instGA_k : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
        MvPolynomial.gradedAlgebra
      letI instGA_K : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) :=
        MvPolynomial.gradedAlgebra
      Nonempty (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≅
        CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) k) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin 2) k 0))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))) := by
    intro K _ φ
    letI instGA_k : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
      MvPolynomial.gradedAlgebra
    letI instGA_K : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) K) :=
      MvPolynomial.gradedAlgebra
    let p₀ := AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) k) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin 2) k 0)))
    let p₁ := AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))
    let f : MvPolynomial.homogeneousSubmodule (Fin 2) k →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin 2) K :=
      { toRingHom := MvPolynomial.map φ
        map_mem := fun {i p} hp =>
          (MvPolynomial.mem_homogeneousSubmodule i _).mpr
            (((MvPolynomial.mem_homogeneousSubmodule i _).mp hp).map φ) }
    have hfX : ∀ a : Fin 2, f (MvPolynomial.X a) = MvPolynomial.X a :=
      fun a => MvPolynomial.map_X φ a
    have hXa_k : ∀ a : Fin 2,
        (MvPolynomial.X a : MvPolynomial (Fin 2) k) ∈
          MvPolynomial.homogeneousSubmodule (Fin 2) k 1 :=
      fun a => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k a)
    have hfXa_K : ∀ a : Fin 2,
        f (MvPolynomial.X a) ∈ MvPolynomial.homogeneousSubmodule (Fin 2) K 1 :=
      fun a => f.map_mem (hXa_k a)
    have hf_irrel :
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) K) ≤
          HomogeneousIdeal.map f
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) k)) := by
      change (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) K)).toIdeal ≤
        Ideal.map f.toRingHom
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) k)).toIdeal
      refine (hIrrel K).trans (Ideal.span_le.mpr ?_)
      rintro _ ⟨a, rfl⟩
      rw [← hfX a]
      apply Ideal.mem_map_of_mem
      exact HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin 2) k) zero_lt_one (hXa_k a)
    have hPush₀ : CategoryTheory.IsPushout
        (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k))
        (CommRingCat.ofHom φ)
        (CommRingCat.ofHom
          (MvPolynomial.map φ : MvPolynomial (Fin 1) k →+* MvPolynomial (Fin 1) K))
        (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K)) := by
      have hcomm₀ :
          CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k) ≫
            CommRingCat.ofHom (MvPolynomial.map φ) =
          CommRingCat.ofHom φ ≫
            CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K) := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact MvPolynomial.map_C φ c
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm₀
          (fun sc => CommRingCat.ofHom
            (MvPolynomial.eval₂Hom sc.inr.hom (fun b => sc.inl.hom (MvPolynomial.X b))))
          (fun sc => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro c
              have hcond := congrArg (fun h => h.hom c) sc.condition
              simpa [MvPolynomial.map_C] using hcond.symm
            · intro b
              simp)
          (fun sc => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro c
            simp)
          (fun sc m hm₁ hm₂ => by
            apply CommRingCat.hom_ext
            apply MvPolynomial.ringHom_ext'
            · apply RingHom.ext
              intro c
              have h₂ := congrArg (fun h => h.hom c) hm₂
              simpa using h₂
            · intro b
              have h₁ := congrArg (fun h => h.hom (MvPolynomial.X b)) hm₁
              simpa using h₁))
    have hPush : ∀ a : Fin 2,
        CategoryTheory.IsPushout
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin 2) k)
            (Submonoid.powers (MvPolynomial.X a))).comp
              (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin 2) k 0))))
          (CommRingCat.ofHom φ)
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a)))
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) := by
      intro a
      obtain ⟨e₀, he₀_C, hXa_k', hXrev_k', he₀_X⟩ := hEquiv k a (MvPolynomial.X a) rfl
      obtain ⟨e₁, he₁_C, hXa_K', hXrev_K', he₁_X⟩ := hEquiv K a (f (MvPolynomial.X a)) (hfX a)
      refine hPush₀.of_iso (CategoryTheory.Iso.refl _) e₀.toCommRingCatIso
        (CategoryTheory.Iso.refl _) e₁.toCommRingCatIso ?_ ?_ ?_ ?_
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact he₀_C c
      · simp
      · apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          apply HomogeneousLocalization.val_injective
          change (e₁ (MvPolynomial.map φ (MvPolynomial.C c))).val =
            (HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e₀ (MvPolynomial.C c))).val
          rw [MvPolynomial.map_C, he₁_C]
          have he₀_mk : e₀ (MvPolynomial.C c) =
              HomogeneousLocalization.mk
                ⟨0, algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin 2) k 0) c,
                  ⟨1, SetLike.GradedOne.one_mem⟩,
                  Submonoid.one_mem (Submonoid.powers (MvPolynomial.X a))⟩ := by
            apply HomogeneousLocalization.val_injective
            rw [he₀_C, HomogeneousLocalization.val_mk]
            exact rfl
