    · apply (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding j_β).injective
      have h_eq : (ι_S ≫ f₁.left).base q = j_β.base p := by
        change f₁.left.base (ι_S.base q) = j_β.base p
        rw [hq_z, hz_b]
      rw [hcomm_f] at h_eq
      change j_β.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_β S))) q) =
        j_β.base p at h_eq
      rw [AlgebraicGeometry.Spec.map_apply] at h_eq
      exact h_eq
    · rw [← h_dehom_eq]
      by_contra h_not_mem
      have hq_basic : PrimeSpectrum.comap φ_P q ∈
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hXμ hFc) := by
        rw [PrimeSpectrum.mem_basicOpen]
        exact h_not_mem
      rw [← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hXμ zero_lt_one hFc (by omega : 0 < d₀)] at hq_basic
      have h_in_Fc : (ι_S ≫ ι₁_proj).base q ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 F_c := by
