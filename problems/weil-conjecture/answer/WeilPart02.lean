            change Ψ_slope (MvPolynomial.C (a j)) + Ψ_slope (MvPolynomial.X r) * d₀ = _
            simp only [Ψ_slope, MvPolynomial.eval₂Hom_X']
            rw [hC_aj, div_mul_cancel₀ _ hd₀, ← hj]
            have hK_FA : algebraMap K (FractionRing (MvPolynomial (Fin m) K)) (a j) =
                algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K))
                  (MvPolynomial.C (a j)) :=
              IsScalarTower.algebraMap_apply K (MvPolynomial (Fin m) K)
                (FractionRing (MvPolynomial (Fin m) K)) (a j)
