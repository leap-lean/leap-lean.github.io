      let x_C : Fin m → C := fun j => algebraMap (MvPolynomial (Fin m) k) C (MvPolynomial.X j)
      let y : Fin m → TensorProduct k L C := fun j =>
        (1 : L) ⊗ₜ[k] (x_C j) - (a_L j) ⊗ₜ[k] (1 : C)
      let g_line : Fin (m - 1) → TensorProduct k L C := fun r =>
        y (idxSucc r) - (u r) • (y idx0)
      let S_line : Finset (TensorProduct k L C) := Finset.univ.image g_line
      have hCardS : S_line.card ≤ m - 1 := Finset.card_image_le.trans (by simp)
