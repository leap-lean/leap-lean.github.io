by
  
  have hAwayLift : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (x : R) (y : S) (g : R →+* Localization.Away y),
      g x = algebraMap S (Localization.Away y) y →
      ∃ (ψ : Localization.Away x →+* Localization.Away y),
        g = ψ.comp (algebraMap R (Localization.Away x)) ∧
        (∀ r : R, ψ (algebraMap R (Localization.Away x) r) = g r) ∧
        ψ (IsLocalization.Away.invSelf x) = IsLocalization.Away.invSelf y := by
    intro R S _ _ x y g hgx
    have hg_unit : IsUnit (g x) := by
      rw [hgx]
      exact IsLocalization.map_units (Localization.Away y) ⟨y, Submonoid.mem_powers y⟩
