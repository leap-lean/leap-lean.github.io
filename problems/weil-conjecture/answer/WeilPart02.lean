    apply AlgebraicGeometry.Scheme.hom_ext_of_forall
    intro x
    have hx : x ∈ (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen ℬ (MvPolynomial.X a)) := by
      rw [hCov₁]
      trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    rw [← hfX a] at ha
    refine ⟨AlgebraicGeometry.Proj.basicOpen ℬ (f (MvPolynomial.X a)), ha, ?_⟩
    let e_iso := AlgebraicGeometry.Proj.basicOpenIsoSpec ℬ (f (MvPolynomial.X a)) (hXa₁ a)
      zero_lt_one
    rw [← cancel_epi e_iso.inv, ← Category.assoc, ← Category.assoc,
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
    calc
      AlgebraicGeometry.Proj.awayι ℬ (f (MvPolynomial.X a)) (hXa₁ a) zero_lt_one ≫ π ≫ p₀_hom
        = (AlgebraicGeometry.Proj.awayι ℬ (f (MvPolynomial.X a)) (hXa₁ a) zero_lt_one ≫ π) ≫
            p₀_hom := by rw [Category.assoc]
      _ = (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hXa₀ a) zero_lt_one) ≫ p₀_hom := by
          rw [AlgebraicGeometry.Proj.awayι_comp_map f hf_irrel zero_lt_one (MvPolynomial.X a)
            (hXa₀ a)]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hXa₀ a) zero_lt_one ≫ p₀_hom) := by
          rw [Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((HomogeneousLocalization.fromZeroRingHom 𝒜
                (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap E₀ ↥(𝒜 0)))) := by
          rw [← hfbot_eq a]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom ℬ
              (Submonoid.powers (f (MvPolynomial.X a)))).comp (algebraMap F₁ ↥(ℬ 0)))) ≫ s :=
          (hSpecPB a).w
      _ = (AlgebraicGeometry.Proj.awayι ℬ (f (MvPolynomial.X a)) (hXa₁ a) zero_lt_one ≫ p₁_hom) ≫
            s := by rw [hsnd_eq a]
      _ = AlgebraicGeometry.Proj.awayι ℬ (f (MvPolynomial.X a)) (hXa₁ a) zero_lt_one ≫ p₁_hom ≫
            s := by rw [Category.assoc]
  let U₀ : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
  have hCov₀ : iSup U₀ = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X (hIrrel E₀)
  have hChartPB : ∀ a : Fin (N + 1),
      CategoryTheory.IsPullback (π ∣_ U₀ a)
        (AlgebraicGeometry.Scheme.Opens.ι
          ((TopologicalSpace.Opens.map π.base).obj (U₀ a)) ≫ p₁_hom)
        ((U₀ a).ι ≫ p₀_hom) s := by
    intro a
    let U₁_a : (AlgebraicGeometry.Proj ℬ).Opens := (TopologicalSpace.Opens.map π.base).obj (U₀ a)
    have hEq_a : U₁_a = AlgebraicGeometry.Proj.basicOpen ℬ (f (MvPolynomial.X a)) :=
      AlgebraicGeometry.Proj.map_preimage_basicOpen f hf_irrel (MvPolynomial.X a)
    let e₁ : U₁_a.toScheme ≅
        AlgebraicGeometry.Spec (CommRingCat.of
          (HomogeneousLocalization.Away ℬ (f (MvPolynomial.X a)))) :=
      (AlgebraicGeometry.Proj ℬ).isoOfEq hEq_a ≪≫
        AlgebraicGeometry.Proj.basicOpenIsoSpec ℬ (f (MvPolynomial.X a)) (hXa₁ a) zero_lt_one
    let e₀ : (U₀ a).toScheme ≅
        AlgebraicGeometry.Spec (CommRingCat.of
          (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hXa₀ a) zero_lt_one
    have he₁_inv : e₁.inv ≫ AlgebraicGeometry.Scheme.Opens.ι U₁_a =
        AlgebraicGeometry.Proj.awayι ℬ (f (MvPolynomial.X a)) (hXa₁ a) zero_lt_one := by
      simp only [e₁, CategoryTheory.Iso.trans_inv, Category.assoc]
      rw [AlgebraicGeometry.Scheme.isoOfEq_inv_ι, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
    have he₀_inv : e₀.inv ≫ (U₀ a).ι =
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hXa₀ a) zero_lt_one :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X a) (hXa₀ a) zero_lt_one
    refine (hSpecPB a).of_iso e₁.symm e₀.symm (CategoryTheory.Iso.refl _)
      (CategoryTheory.Iso.refl _) ?_ ?_ ?_ rfl
    · rw [← cancel_mono (U₀ a).ι, Category.assoc, Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι]
      change AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
          (e₀.inv ≫ (U₀ a).ι) = (e₁.inv ≫ AlgebraicGeometry.Scheme.Opens.ι U₁_a) ≫ π
      rw [he₀_inv, he₁_inv]
      exact (AlgebraicGeometry.Proj.awayι_comp_map f hf_irrel zero_lt_one (MvPolynomial.X a)
        (hXa₀ a)).symm
    · simp only [CategoryTheory.Iso.refl_hom, Category.comp_id, CategoryTheory.Iso.symm_hom]
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom ℬ
              (Submonoid.powers (f (MvPolynomial.X a)))).comp (algebraMap F₁ ↥(ℬ 0))))
          = AlgebraicGeometry.Proj.awayι ℬ (f (MvPolynomial.X a)) (hXa₁ a) zero_lt_one ≫
              p₁_hom := hsnd_eq a
        _ = (e₁.inv ≫ AlgebraicGeometry.Scheme.Opens.ι U₁_a) ≫ p₁_hom := by
            rw [← he₁_inv]
        _ = e₁.inv ≫ AlgebraicGeometry.Scheme.Opens.ι
              ((TopologicalSpace.Opens.map π.base).obj (U₀ a)) ≫ p₁_hom := by
            rw [Category.assoc]
    · simp only [CategoryTheory.Iso.refl_hom, Category.comp_id, CategoryTheory.Iso.symm_hom]
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap E₀ ↥(𝒜 0))))
          = AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hXa₀ a) zero_lt_one ≫
              p₀_hom := hfbot_eq a
        _ = (e₀.inv ≫ (U₀ a).ι) ≫ p₀_hom := by rw [← he₀_inv]
        _ = e₀.inv ≫ (U₀ a).ι ≫ p₀_hom := by rw [Category.assoc]
  let Q := CategoryTheory.Limits.pullback p₀_hom s
  let p₁ := CategoryTheory.Limits.pullback.fst p₀_hom s
  let p₂ := CategoryTheory.Limits.pullback.snd p₀_hom s
  let Φ : AlgebraicGeometry.Proj ℬ ⟶ Q := CategoryTheory.Limits.pullback.lift π p₁_hom hComm
  let W : Fin (N + 1) → Q.Opens := fun a => (TopologicalSpace.Opens.map p₁.base).obj (U₀ a)
  have hCovW : iSup W = ⊤ := by
    calc
      iSup W = (TopologicalSpace.Opens.map p₁.base).obj (iSup U₀) :=
        (TopologicalSpace.Opens.map_iSup p₁.base U₀).symm
      _ = (TopologicalSpace.Opens.map p₁.base).obj ⊤ := by rw [hCov₀]
      _ = ⊤ := rfl
  haveI : CategoryTheory.IsIso Φ := by
    refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
      W hCovW).mpr (fun a => ?_)
    change CategoryTheory.IsIso (Φ ∣_ W a)
    let V_a : (AlgebraicGeometry.Proj ℬ).Opens := (TopologicalSpace.Opens.map Φ.base).obj (W a)
    let U₁_a : (AlgebraicGeometry.Proj ℬ).Opens := (TopologicalSpace.Opens.map π.base).obj (U₀ a)
    have hVU : V_a = U₁_a := by
      have hΦp₁ : Φ ≫ p₁ = π := CategoryTheory.Limits.pullback.lift_fst π p₁_hom hComm
      ext x
      change x ∈ Φ.base ⁻¹' (p₁.base ⁻¹' (U₀ a : Set (AlgebraicGeometry.Proj 𝒜))) ↔
        x ∈ π.base ⁻¹' (U₀ a : Set (AlgebraicGeometry.Proj 𝒜))
      rw [← hΦp₁]
      rfl
    let eV := (AlgebraicGeometry.Proj ℬ).isoOfEq hVU
    have hcomp_res : (Φ ∣_ W a) ≫ (p₁ ∣_ U₀ a) = eV.hom ≫ (π ∣_ U₀ a) := by
      rw [← cancel_mono (U₀ a).ι, Category.assoc, Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι, AlgebraicGeometry.morphismRestrict_ι,
        ← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc,
        AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
    have hPB_V : CategoryTheory.IsPullback ((Φ ∣_ W a) ≫ (p₁ ∣_ U₀ a))
        (AlgebraicGeometry.Scheme.Opens.ι V_a ≫ p₁_hom) ((U₀ a).ι ≫ p₀_hom) s := by
      refine (hChartPB a).of_iso eV.symm (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ rfl rfl
      · simp only [CategoryTheory.Iso.refl_hom, Category.comp_id, CategoryTheory.Iso.symm_hom,
          hcomp_res, CategoryTheory.Iso.inv_hom_id_assoc]
      · simp only [CategoryTheory.Iso.refl_hom, Category.comp_id, CategoryTheory.Iso.symm_hom]
        rw [← Category.assoc]
        congr 1
        exact (AlgebraicGeometry.Scheme.isoOfEq_inv_ι (AlgebraicGeometry.Proj ℬ) hVU).symm
    have hPB_W : CategoryTheory.IsPullback (p₁ ∣_ U₀ a)
        (AlgebraicGeometry.Scheme.Opens.ι (W a) ≫ p₂) ((U₀ a).ι ≫ p₀_hom) s :=
      (AlgebraicGeometry.isPullback_morphismRestrict p₁ (U₀ a)).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback p₀_hom s)
    let e_cone := CategoryTheory.IsPullback.isoIsPullback _ _ hPB_V hPB_W
    have hΦ_eq : Φ ∣_ W a = e_cone.hom := by
      apply hPB_W.hom_ext
      · exact (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_V hPB_W).symm
      · rw [CategoryTheory.IsPullback.isoIsPullback_hom_snd, ← Category.assoc,
          AlgebraicGeometry.morphismRestrict_ι, Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd]
    rw [hΦ_eq]
    infer_instance
  
  let Y₁ := weilBaseChangeOver E₀ F₁ Y₀
  let q₁ : Y₁.left ⟶ Y₀.left := CategoryTheory.Limits.pullback.fst Y₀.hom s
  let ι₀_left : Y₀.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι₀.left
  have hι₀_w : ι₀_left ≫ p₀_hom = Y₀.hom := CategoryTheory.Over.w ι₀
  have hj_comm : (q₁ ≫ ι₀_left) ≫ p₀_hom = Y₁.hom ≫ s := by
    rw [Category.assoc, hι₀_w]
    exact CategoryTheory.Limits.pullback.condition
  let j : Y₁.left ⟶ Q := CategoryTheory.Limits.pullback.lift (q₁ ≫ ι₀_left) Y₁.hom hj_comm
  have hPB_j : CategoryTheory.IsPullback q₁ j ι₀_left p₁ := by
    refine (CategoryTheory.IsPullback.of_right ?_ ?_
      (CategoryTheory.IsPullback.of_hasPullback p₀_hom s).flip).flip
    · rw [CategoryTheory.Limits.pullback.lift_snd, hι₀_w]
      exact (CategoryTheory.IsPullback.of_hasPullback Y₀.hom s).flip
    · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hClosed_j : AlgebraicGeometry.IsClosedImmersion j :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsClosedImmersion) hPB_j hClosed₀
  let f₁ : Y₁.left ⟶ AlgebraicGeometry.Proj ℬ := j ≫ CategoryTheory.inv Φ
  have hClosed_f₁ : AlgebraicGeometry.IsClosedImmersion f₁ :=
    AlgebraicGeometry.IsClosedImmersion.comp j (CategoryTheory.inv Φ)
  have hf₁_w : f₁ ≫ p₁_hom = Y₁.hom := by
    have hΦp₂ : Φ ≫ p₂ = p₁_hom := CategoryTheory.Limits.pullback.lift_snd π p₁_hom hComm
    calc
      f₁ ≫ p₁_hom = j ≫ CategoryTheory.inv Φ ≫ (Φ ≫ p₂) := by rw [hΦp₂]; rfl
      _ = j ≫ (CategoryTheory.inv Φ ≫ Φ) ≫ p₂ := by simp only [Category.assoc]
      _ = j ≫ p₂ := by rw [CategoryTheory.IsIso.inv_hom_id, Category.id_comp]
      _ = Y₁.hom := CategoryTheory.Limits.pullback.lift_snd _ _ _
  exact ⟨N, CategoryTheory.Over.homMk f₁ hf₁_w, hClosed_f₁⟩

theorem weil_algClosed_domain_tensor_and_minimalPrime_krullDim_ge_two (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (E : Type u) [Field E] [Algebra k E]
       (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C],
      IsDomain (TensorProduct k C E) ∧
      ringKrullDim (TensorProduct k C E) = ringKrullDim C) ∧
    (∀ (m : ℕ), 1 ≤ m →
      ∀ (L : Type u) [Field L]
        (C_L : Type u) [CommRing C_L] [IsDomain C_L] [Algebra L C_L] [Algebra.FiniteType L C_L],
        ringKrullDim C_L = ((m + 1 : ℕ) : WithBot ℕ∞) →
        ∀ (S : Finset C_L), S.card ≤ m - 1 →
        ∀ P ∈ (Ideal.span (S : Set C_L)).minimalPrimes,
          ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (C_L ⧸ P)) :=
by
  
  have hNull : ∀ (A : Type u) [CommRing A] [Nontrivial A] [Algebra k A] [Algebra.FiniteType k A],
      Nonempty (A →ₐ[k] k) := by
    intro A _ _ _ _
    obtain ⟨n, φ, hφ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := A)).mp inferInstance
    let J : Ideal (MvPolynomial (Fin n) k) := RingHom.ker φ.toRingHom
    have hJ_ne_top : J ≠ ⊤ := by
      rw [Ideal.ne_top_iff_one]
      change φ 1 ≠ 0
      rw [map_one]
      exact one_ne_zero
    obtain ⟨m_max, hm_max, hJ_le⟩ := Ideal.exists_le_maximal J hJ_ne_top
    obtain ⟨x₀, rfl⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k)).mp hm_max
    have hker : ∀ p : MvPolynomial (Fin n) k, φ p = 0 → MvPolynomial.aeval x₀ p = 0 := by
      intro p hp
      have hpm : p ∈ MvPolynomial.vanishingIdeal k ({x₀} : Set (Fin n → k)) := hJ_le hp
      rw [MvPolynomial.mem_vanishingIdeal_iff] at hpm
      exact hpm x₀ (Set.mem_singleton x₀)
    let pre : A → MvPolynomial (Fin n) k := fun a => Classical.choose (hφ_surj a)
    have hpre : ∀ a : A, φ (pre a) = a := fun a => Classical.choose_spec (hφ_surj a)
    have heval_eq : ∀ p : MvPolynomial (Fin n) k,
        MvPolynomial.aeval x₀ (pre (φ p)) = MvPolynomial.aeval x₀ p := by
      intro p
      have hsub : φ (pre (φ p) - p) = 0 := by rw [map_sub, hpre, sub_self]
      have h0 := hker _ hsub
      rwa [map_sub, sub_eq_zero] at h0
    refine ⟨{
      toFun := fun a => MvPolynomial.aeval x₀ (pre a)
      map_one' := by rw [← map_one φ, heval_eq, map_one]
      map_mul' := fun a b => by
        nth_rw 1 [← hpre a, ← hpre b]
        rw [← map_mul φ, heval_eq, map_mul]
      map_zero' := by rw [← map_zero φ, heval_eq, map_zero]
      map_add' := fun a b => by
        nth_rw 1 [← hpre a, ← hpre b]
        rw [← map_add φ, heval_eq, map_add]
      commutes' := fun c => by
        have hc : algebraMap k A c = φ (MvPolynomial.C c) := by simp
        rw [hc, heval_eq, MvPolynomial.aeval_C]
    }⟩

  
  have hs1 : ∀ (E : Type u) [Field E] [Algebra k E]
      (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C],
      IsDomain (TensorProduct k C E) := by
    intro E _ _ C _ _ _ _
    obtain ⟨ψ₀⟩ := hNull C
    let Ψ₀ : TensorProduct k C E →ₐ[k] E :=
      Algebra.TensorProduct.lift ((Algebra.ofId k E).comp ψ₀) (AlgHom.id k E)
        (fun _ _ => Commute.all _ _)
    have : Nontrivial (TensorProduct k C E) := by
      refine ⟨⟨1, 0, fun h10 => ?_⟩⟩
      have hE : (1 : E) = 0 := by
        calc (1 : E) = Ψ₀ 1 := (map_one Ψ₀).symm
          _ = Ψ₀ 0 := congrArg Ψ₀ h10
          _ = 0 := map_zero Ψ₀
      exact one_ne_zero hE
    let b := Module.Basis.ofVectorSpace k E
    let B := Algebra.TensorProduct.basis C b
    have hcoord : ∀ (ψ : C →ₐ[k] k) (z : TensorProduct k C E)
        (i : Module.Basis.ofVectorSpaceIndex k E),
        (b.repr (Algebra.TensorProduct.lift ((Algebra.ofId k E).comp ψ) (AlgHom.id k E)
          (fun _ _ => Commute.all _ _) z)) i = ψ ((B.repr z) i) := by
      intro ψ z i
      let Ψ : TensorProduct k C E →ₐ[k] E :=
        Algebra.TensorProduct.lift ((Algebra.ofId k E).comp ψ) (AlgHom.id k E)
          (fun _ _ => Commute.all _ _)
      change (b.repr (Ψ z)) i = ψ ((B.repr z) i)
      induction z using TensorProduct.inductionOn with
      | tmul c e =>
        have hΨ : Ψ (c ⊗ₜ[k] e) = ψ c • e := by
          simp [Ψ, Algebra.TensorProduct.lift_tmul, Algebra.smul_def]
        rw [hΨ, map_smul, Finsupp.smul_apply, smul_eq_mul]
        have hB : (B.repr (c ⊗ₜ[k] e)) i = c * algebraMap k C ((b.repr e) i) := by
          simp [B, Algebra.TensorProduct.basis_repr_tmul, Finsupp.mapRange_apply, smul_eq_mul]
        rw [hB, map_mul, AlgHom.commutes]
        simp
      | add x y hx hy =>
        simp [map_add, hx, hy]
    have : NoZeroDivisors (TensorProduct k C E) := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra hnot
      push Not at hnot
      rcases hnot with ⟨hx, hy⟩
      have hBx : B.repr x ≠ 0 := fun h => hx (B.repr.injective (by simpa using h))
      have hBy : B.repr y ≠ 0 := fun h => hy (B.repr.injective (by simpa using h))
      obtain ⟨i₀, ha₀⟩ : ∃ i₀, (B.repr x) i₀ ≠ 0 := by
        by_contra h; push Not at h; exact hBx (Finsupp.ext h)
      obtain ⟨j₀, hb₀⟩ : ∃ j₀, (B.repr y) j₀ ≠ 0 := by
        by_contra h; push Not at h; exact hBy (Finsupp.ext h)
      let c₀ : C := (B.repr x) i₀ * (B.repr y) j₀
      have hc₀ : c₀ ≠ 0 := mul_ne_zero ha₀ hb₀
      have hle : Submonoid.powers c₀ ≤ nonZeroDivisors C :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hc₀)
      let C' := Localization.Away c₀
      have : IsDomain C' := IsLocalization.isDomain_localization hle
      have : Algebra.FiniteType k C' :=
        Algebra.FiniteType.trans (S := C) inferInstance inferInstance
      obtain ⟨ψ'⟩ := hNull C'
      let ψ : C →ₐ[k] k := ψ'.comp (IsScalarTower.toAlgHom k C C')
      have hψc₀ : ψ c₀ ≠ 0 := by
        intro h0
        have hmul : ψ' (algebraMap C C' c₀ * IsLocalization.Away.invSelf (S := C') c₀) = ψ' 1 :=
          congrArg ψ' (IsLocalization.Away.mul_invSelf c₀)
        rw [map_mul, map_one] at hmul
        have h1 : ψ' (algebraMap C C' c₀) = ψ c₀ := rfl
        rw [h1, h0, zero_mul] at hmul
        exact zero_ne_one hmul
      have hψa₀ : ψ ((B.repr x) i₀) ≠ 0 := fun h0 => hψc₀ (by simp [c₀, map_mul, h0])
      have hψb₀ : ψ ((B.repr y) j₀) ≠ 0 := fun h0 => hψc₀ (by simp [c₀, map_mul, h0])
      let Ψ : TensorProduct k C E →ₐ[k] E :=
        Algebra.TensorProduct.lift ((Algebra.ofId k E).comp ψ) (AlgHom.id k E)
          (fun _ _ => Commute.all _ _)
      have hΨx : Ψ x ≠ 0 := by
        intro h0
        have := hcoord ψ x i₀
        change (b.repr (Ψ x)) i₀ = ψ ((B.repr x) i₀) at this
        rw [h0, map_zero, Finsupp.zero_apply] at this
        exact hψa₀ this.symm
      have hΨy : Ψ y ≠ 0 := by
        intro h0
        have := hcoord ψ y j₀
        change (b.repr (Ψ y)) j₀ = ψ ((B.repr y) j₀) at this
        rw [h0, map_zero, Finsupp.zero_apply] at this
        exact hψb₀ this.symm
      have hΨxy : Ψ x * Ψ y = 0 := by rw [← map_mul, hxy, map_zero]
      exact mul_ne_zero hΨx hΨy hΨxy
    exact NoZeroDivisors.to_isDomain (TensorProduct k C E)

  
  have hIntDim : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      [Algebra.IsIntegral A B], Function.Injective (algebraMap A B) →
      ringKrullDim B = ringKrullDim A := by
    intro A B _ _ _ _ hinj
    have hstrict : StrictMono (PrimeSpectrum.comap (algebraMap A B)) := by
      intro Q₁ Q₂ hlt
      have hle : Q₁.asIdeal ≤ Q₂.asIdeal := hlt.le
      have hnot : ¬ (Q₂.asIdeal ≤ Q₁.asIdeal) := hlt.not_ge
      obtain ⟨x, hx₂, hx₁⟩ := Set.not_subset.mp hnot
      exact Ideal.under_lt_under_of_integral_mem_sdiff hle ⟨hx₂, hx₁⟩
        (Algebra.IsIntegral.isIntegral x)
    have hle₁ : ringKrullDim B ≤ ringKrullDim A :=
      Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A B)) hstrict
    have hlift : ∀ (n : ℕ) (q : LTSeries (PrimeSpectrum A)), q.length = n →
        ∃ p : LTSeries (PrimeSpectrum B), p.length = n ∧
          Ideal.comap (algebraMap A B) (RelSeries.last p).asIdeal = (RelSeries.last q).asIdeal := by
      intro n
      induction n with
      | zero =>
        intro q _
        have hker : Ideal.comap (algebraMap A B) (⊥ : Ideal B) ≤ (RelSeries.last q).asIdeal := by
          intro x hx
          rw [Ideal.mem_comap, Ideal.mem_bot] at hx
          have hx0 : x = 0 := (map_eq_zero_iff (algebraMap A B) hinj).mp hx
          rw [hx0]
          exact Ideal.zero_mem _
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_over⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (RelSeries.last q).asIdeal (⊥ : Ideal B) hker
        refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, ?_⟩
        simpa using hQ₀_over
      | succ m ih =>
        intro q hq
        have hlen_er : q.eraseLast.length = m := by simp [hq]
        have hlt_q : (RelSeries.last q.eraseLast).asIdeal < (RelSeries.last q).asIdeal :=
          RelSeries.eraseLast_last_rel_last q (by omega)
        obtain ⟨p₀, hp₀_len, hp₀_over⟩ := ih q.eraseLast hlen_er
        have hle_over : Ideal.comap (algebraMap A B) (RelSeries.last p₀).asIdeal ≤
            (RelSeries.last q).asIdeal := by
          rw [hp₀_over]
          exact hlt_q.le
        obtain ⟨Q, hQ_ge, hQ_prime, hQ_over⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
            (RelSeries.last q).asIdeal (RelSeries.last p₀).asIdeal hle_over
        have hQ_lt : (RelSeries.last p₀) < (⟨Q, hQ_prime⟩ : PrimeSpectrum B) := by
          change (RelSeries.last p₀).asIdeal < Q
          refine lt_of_le_of_ne hQ_ge ?_
          intro heq
          apply hlt_q.ne
          rw [← hp₀_over, heq]
          exact hQ_over
        refine ⟨p₀.snoc ⟨Q, hQ_prime⟩ hQ_lt, ?_, ?_⟩
        · simp [hp₀_len]
        · simpa using hQ_over
    have hle₂ : ringKrullDim A ≤ ringKrullDim B := by
      change Order.krullDim (PrimeSpectrum A) ≤ Order.krullDim (PrimeSpectrum B)
      rw [Order.krullDim]
      refine iSup_le fun q => ?_
      obtain ⟨p, hp_len, _⟩ := hlift q.length q rfl
      rw [← hp_len]
      exact Order.LTSeries.length_le_krullDim p
    exact le_antisymm hle₁ hle₂

  
  have hMvDim : ∀ (F : Type u) [Field F] (s : ℕ),
      ringKrullDim (MvPolynomial (Fin s) F) = ((s : ℕ) : WithBot ℕ∞) := by
    intro F _ s
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing,
        ringKrullDim_eq_zero_of_isField (Field.toIsField F),
        ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
    rfl

  
  have hDimTrdeg : ∀ (F : Type u) [Field F]
      (R : Type u) [CommRing R] [IsDomain R] [Algebra F R] [Algebra.FiniteType F R],
      ∃ s : ℕ, ringKrullDim R = ((s : ℕ) : WithBot ℕ∞) ∧
        Algebra.trdeg F R = (s : Cardinal.{u}) := by
    intro F _ R _ _ _ _
    obtain ⟨s, g₀, hg₀_inj, hg₀_int⟩ := exists_integral_inj_algHom_of_fg F R
    let P₀ := MvPolynomial (Fin s) F
    refine ⟨s, ?_, ?_⟩
    · let : Algebra P₀ R := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ R := ⟨hg₀_int⟩
      rw [hIntDim P₀ R hg₀_inj, hMvDim F s]
    · let : Algebra P₀ R := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ R := ⟨hg₀_int⟩
      have : IsScalarTower F P₀ R := IsScalarTower.of_algebraMap_eq' g₀.comp_algebraMap.symm
      have : FaithfulSMul F P₀ :=
        (faithfulSMul_iff_algebraMap_injective F P₀).mpr (MvPolynomial.C_injective (Fin s) F)
      have : FaithfulSMul P₀ R :=
        (faithfulSMul_iff_algebraMap_injective P₀ R).mpr hg₀_inj
      have : Algebra.IsAlgebraic P₀ R := Algebra.IsIntegral.isAlgebraic
      have htr0 : Algebra.trdeg P₀ R = 0 := trdeg_eq_zero
      have hadd : Algebra.trdeg F P₀ + Algebra.trdeg P₀ R = Algebra.trdeg F R :=
        trdeg_add_eq F P₀ (A := R)
      have htrP : Algebra.trdeg F P₀ = (s : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain]
        simp
      rw [← hadd, htrP, htr0, add_zero]

  
  have hs2_tensor : ∀ (F : Type u) [Field F] (E : Type u) [Field E] [Algebra F E]
      (C : Type u) [CommRing C] [IsDomain C] [Algebra F C] [Algebra.FiniteType F C],
      ringKrullDim (TensorProduct F C E) = ringKrullDim C := by
    intro F _ E _ _ C _ _ _ _
    obtain ⟨s, g₀, hg₀_inj, hg₀_int⟩ := exists_integral_inj_algHom_of_fg F C
    let P₀ := MvPolynomial (Fin s) F
    have hDimC : ringKrullDim C = ((s : ℕ) : WithBot ℕ∞) := by
      let : Algebra P₀ C := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ C := ⟨hg₀_int⟩
      rw [hIntDim P₀ C hg₀_inj, hMvDim F s]
    let φ_E : TensorProduct F E P₀ →ₐ[F] TensorProduct F E C :=
      Algebra.TensorProduct.map (AlgHom.id F E) g₀
    have hφ_eq : (⇑φ_E : TensorProduct F E P₀ → TensorProduct F E C) =
        ⇑(LinearMap.lTensor E g₀.toLinearMap) := by
      ext z
      induction z using TensorProduct.inductionOn with
      | tmul e p => simp [φ_E]
      | add x y hx hy => simp [map_add, hx, hy]
    have hφ_inj : Function.Injective φ_E := by
      rw [hφ_eq]
      exact Module.Flat.lTensor_preserves_injective_linearMap g₀.toLinearMap hg₀_inj
    have hφ_int : φ_E.toRingHom.IsIntegral := by
      intro z
      induction z using TensorProduct.inductionOn with
      | tmul e c =>
        have hdecomp : (e ⊗ₜ[F] c : TensorProduct F E C) = (e ⊗ₜ[F] 1) * (1 ⊗ₜ[F] c) := by
          simp [Algebra.TensorProduct.tmul_mul_tmul]
        rw [hdecomp]
        refine RingHom.IsIntegralElem.mul φ_E.toRingHom ?_ ?_
        · have he : (e ⊗ₜ[F] (1 : C)) = φ_E.toRingHom (e ⊗ₜ[F] (1 : P₀)) := by simp [φ_E]
          rw [he]
          exact RingHom.isIntegralElem_map φ_E.toRingHom
        · let j₀ : P₀ →+* TensorProduct F E P₀ :=
            (Algebra.TensorProduct.includeRight (R := F) (A := E) (B := P₀)).toRingHom
          let j₁ : C →+* TensorProduct F E C :=
            (Algebra.TensorProduct.includeRight (R := F) (A := E) (B := C)).toRingHom
          have hcomp : j₁.comp g₀.toRingHom = φ_E.toRingHom.comp j₀ := by
            refine MvPolynomial.ringHom_ext ?_ ?_
            · intro a
              change (1 : E) ⊗ₜ[F] g₀ (MvPolynomial.C a) = φ_E ((1 : E) ⊗ₜ[F] MvPolynomial.C a)
              simp only [φ_E, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
                ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
              rw [g₀.commutes]
            · intro i
              change (1 : E) ⊗ₜ[F] g₀ (MvPolynomial.X i) = φ_E ((1 : E) ⊗ₜ[F] MvPolynomial.X i)
              simp [φ_E]
          have hc1 : (j₁.comp g₀.toRingHom).IsIntegralElem (j₁ c) := (hg₀_int c).map j₁
          rw [hcomp] at hc1
          exact hc1.of_comp
      | add x y hx hy => exact RingHom.IsIntegralElem.add φ_E.toRingHom hx hy
    have hDimEC : ringKrullDim (TensorProduct F E C) = ringKrullDim (TensorProduct F E P₀) := by
      let : Algebra (TensorProduct F E P₀) (TensorProduct F E C) := φ_E.toRingHom.toAlgebra
      have : Algebra.IsIntegral (TensorProduct F E P₀) (TensorProduct F E C) := ⟨hφ_int⟩
      exact hIntDim (TensorProduct F E P₀) (TensorProduct F E C) hφ_inj
    have hComm : ringKrullDim (TensorProduct F C E) = ringKrullDim (TensorProduct F E C) :=
      RingEquiv.ringKrullDim (Algebra.TensorProduct.comm F C E).toRingEquiv
    have hEP : ringKrullDim (TensorProduct F E P₀) = ringKrullDim (MvPolynomial (Fin s) E) :=
      RingEquiv.ringKrullDim
        (MvPolynomial.scalarRTensorAlgEquiv (R := F) (N := E) (σ := Fin s)).toRingEquiv
    rw [hComm, hDimEC, hEP, hMvDim E s, hDimC]

  
  have hs2_loc : ∀ (F : Type u) [Field F]
      (C : Type u) [CommRing C] [IsDomain C] [Algebra F C] [Algebra.FiniteType F C]
      (g : C), g ≠ 0 → ringKrullDim (Localization.Away g) = ringKrullDim C := by
    intro F _ C _ _ _ _ g hg
    have hle : Submonoid.powers g ≤ nonZeroDivisors C :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg)
    let C' := Localization.Away g
    have : IsDomain C' := IsLocalization.isDomain_localization hle
    have : Algebra.FiniteType F C' := Algebra.FiniteType.trans (S := C) inferInstance inferInstance
    obtain ⟨s, hDimC, hTrC⟩ := hDimTrdeg F C
    obtain ⟨s', hDimC', hTrC'⟩ := hDimTrdeg F C'
    have hhinj : Function.Injective (algebraMap C C') := IsLocalization.injective C' hle
    have : FaithfulSMul F C :=
      (faithfulSMul_iff_algebraMap_injective F C).mpr (algebraMap F C).injective
    have : FaithfulSMul C C' := (faithfulSMul_iff_algebraMap_injective C C').mpr hhinj
    have : Algebra.IsAlgebraic C C' := IsLocalization.isAlgebraic C' (Submonoid.powers g)
    have htr0 : Algebra.trdeg C C' = 0 := trdeg_eq_zero
    have hadd : Algebra.trdeg F C + Algebra.trdeg C C' = Algebra.trdeg F C' :=
      trdeg_add_eq F C (A := C')
    have hcast : (s' : Cardinal.{u}) = (s : Cardinal.{u}) := by
      rw [← hTrC', ← hadd, hTrC, htr0, add_zero]
    have hss : s' = s := Nat.cast_injective hcast
    rw [hDimC', hss, hDimC]

  
  have hs3 : ∀ (L : Type u) [Field L]
      (A : Type u) [CommRing A] [IsDomain A] [Algebra L A] [Algebra.FiniteType L A]
      (d : ℕ), ringKrullDim A = ((d : ℕ) : WithBot ℕ∞) →
      ∀ (M : Ideal A), M.IsMaximal → ((d : ℕ) : ℕ∞) ≤ M.height := by
    intro L _ A _ _ _ _ d hDimA M hM_max
    have : M.IsMaximal := hM_max
    have : M.IsPrime := hM_max.isPrime
    obtain ⟨s, g₀, hg₀_inj, hg₀_int⟩ := exists_integral_inj_algHom_of_fg L A
    let P₀ := MvPolynomial (Fin s) L
    have hs_eq_d : s = d := by
      have hDimA' : ringKrullDim A = ((s : ℕ) : WithBot ℕ∞) := by
        let : Algebra P₀ A := g₀.toRingHom.toAlgebra
        have : Algebra.IsIntegral P₀ A := ⟨hg₀_int⟩
        rw [hIntDim P₀ A hg₀_inj, hMvDim L s]
      have h1 : ((s : ℕ) : WithBot ℕ∞) = ((d : ℕ) : WithBot ℕ∞) := hDimA'.symm.trans hDimA
      exact Nat.cast_injective (WithBot.coe_inj.mp h1)
    subst hs_eq_d
    
    let m0 : Ideal P₀ := Ideal.comap g₀.toRingHom M
    have hm0_max : m0.IsMaximal := by
      let : Algebra P₀ A := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ A := ⟨hg₀_int⟩
      exact Ideal.IsMaximal.under P₀ M
    let Ω := AlgebraicClosure L
    let P_Ω := MvPolynomial (Fin s) Ω
    let ι : P₀ →+* P_Ω := MvPolynomial.map (algebraMap L Ω)
    have hι_inj : Function.Injective ι :=
      MvPolynomial.map_injective (algebraMap L Ω) (algebraMap L Ω).injective
    have hι_int : ι.IsIntegral := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C α =>
        have hα : (algebraMap L Ω).IsIntegralElem α :=
          Algebra.IsIntegral.isIntegral (R := L) α
        have hcomp : (MvPolynomial.C : Ω →+* P_Ω).comp (algebraMap L Ω) =
            ι.comp (MvPolynomial.C : L →+* P₀) := by
          ext x : 1
          dsimp [ι]
          exact (MvPolynomial.map_C (algebraMap L Ω) x).symm
        have h1 := hα.map (MvPolynomial.C : Ω →+* P_Ω)
        rw [hcomp] at h1
        exact h1.of_comp
      | add p₁ p₂ hp₁ hp₂ => exact RingHom.IsIntegralElem.add ι hp₁ hp₂
      | mul_X p₁ i hp₁ =>
        have hX : ι.IsIntegralElem (MvPolynomial.X i) := by
          have : (MvPolynomial.X i : P_Ω) = ι (MvPolynomial.X i) := by
            dsimp [ι]
            exact (MvPolynomial.map_X (algebraMap L Ω) i).symm
          rw [this]
          exact RingHom.isIntegralElem_map ι
        exact hp₁.mul _ hX
    have hl₀_exists : ∃ l₀ : LTSeries (PrimeSpectrum P₀),
        l₀.length = s ∧ (RelSeries.last l₀).asIdeal = m0 := by
      let : Algebra P₀ P_Ω := ι.toAlgebra
      have : Algebra.IsIntegral P₀ P_Ω := ⟨hι_int⟩
      have : m0.IsMaximal := hm0_max
      have hker : RingHom.ker (algebraMap P₀ P_Ω) ≤ m0 := by
        intro x hx
        rw [RingHom.mem_ker] at hx
        have hx0 : x = 0 := (map_eq_zero_iff ι hι_inj).mp hx
        rw [hx0]
        exact Ideal.zero_mem _
      obtain ⟨m0_tilde, hm0_tilde_max, hm0_tilde_over⟩ :=
        Ideal.exists_ideal_over_maximal_of_isIntegral m0 hker
      obtain ⟨c, hm_eq⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := Ω)).mp hm0_tilde_max
      let σ : Fin (s + 1) → (P_Ω →ₐ[Ω] P_Ω) := fun r =>
        MvPolynomial.aeval (fun i : Fin s =>
          if i.1 < r.1 then MvPolynomial.C (c i) else MvPolynomial.X i)
      let q : Fin (s + 1) → PrimeSpectrum P_Ω := fun r =>
        ⟨RingHom.ker (σ r).toRingHom, RingHom.ker_isPrime (σ r).toRingHom⟩
      have hq_step : ∀ r : Fin s, q r.castSucc < q r.succ := by
        intro r
        change RingHom.ker (σ r.castSucc).toRingHom < RingHom.ker (σ r.succ).toRingHom
        have hcomp_σ : (σ r.succ).comp (σ r.castSucc) = σ r.succ := by
          apply MvPolynomial.algHom_ext
          intro i
          rw [AlgHom.comp_apply]
          dsimp [σ]
          rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
          split_ifs with h1 h2 h2
          · rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          · exact absurd (Nat.lt_succ_of_lt h1) h2
          · rw [MvPolynomial.aeval_X]
            simp only [h2, ↓reduceIte]
          · rw [MvPolynomial.aeval_X]
            simp only [h2, ↓reduceIte]
        have hle : RingHom.ker (σ r.castSucc).toRingHom ≤ RingHom.ker (σ r.succ).toRingHom := by
          intro f hf
          rw [RingHom.mem_ker] at hf ⊢
          change (σ r.succ) f = 0
          rw [← hcomp_σ, AlgHom.comp_apply]
          change (σ r.succ) ((σ r.castSucc).toRingHom f) = 0
          rw [hf, map_zero]
        refine lt_of_le_of_ne hle ?_
        intro heq
        let w : P_Ω := MvPolynomial.X r - MvPolynomial.C (c r)
        have hw_in : w ∈ RingHom.ker (σ r.succ).toRingHom := by
          rw [RingHom.mem_ker]
          change (σ r.succ) (MvPolynomial.X r - MvPolynomial.C (c r)) = 0
          rw [map_sub]
          dsimp [σ]
          rw [MvPolynomial.aeval_X, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          split_ifs with hr_c
          · exact sub_self _
          · exact absurd (Nat.lt_succ_self r.1) hr_c
        have hw_in0 : w ∈ RingHom.ker (σ r.castSucc).toRingHom := heq ▸ hw_in
        rw [RingHom.mem_ker] at hw_in0
        change (σ r.castSucc) (MvPolynomial.X r - MvPolynomial.C (c r)) = 0 at hw_in0
        have hw_eq : (σ r.castSucc) (MvPolynomial.X r - MvPolynomial.C (c r)) = w := by
          rw [map_sub]
          dsimp [σ]
          rw [MvPolynomial.aeval_X, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
          split_ifs with hr_c
          · exact absurd hr_c (Nat.lt_irrefl r.1)
          · rfl
        rw [hw_eq] at hw_in0
        have heval := congrArg (MvPolynomial.aeval (Function.update c r (c r + 1))) hw_in0
        simp [w] at heval
      have hq_mono : StrictMono q := Fin.strictMono_iff_lt_succ.mpr hq_step
      have hq_last : (q (Fin.last s)).asIdeal = m0_tilde := by
        ext p
        have hmem1 : p ∈ (q (Fin.last s)).asIdeal ↔ (σ (Fin.last s)) p = 0 := Iff.rfl
        have hmem2 : p ∈ m0_tilde ↔ (MvPolynomial.aeval c) p = 0 := by
          rw [hm_eq, MvPolynomial.mem_vanishingIdeal_iff]
          simp
        have hσ_last : σ (Fin.last s) = (Algebra.ofId Ω P_Ω).comp (MvPolynomial.aeval c) := by
          apply MvPolynomial.algHom_ext
          intro i
          rw [AlgHom.comp_apply, MvPolynomial.aeval_X, Algebra.ofId_apply,
              MvPolynomial.algebraMap_eq]
          dsimp [σ]
          simp only [i.isLt, ↓reduceIte, MvPolynomial.eval_X]
        rw [hmem1, hmem2, hσ_last, AlgHom.comp_apply, Algebra.ofId_apply, MvPolynomial.algebraMap_eq]
        exact ⟨fun h => MvPolynomial.C_injective (Fin s) Ω (h.trans (map_zero MvPolynomial.C).symm),
          fun h => by rw [h, map_zero]⟩
      have hcomap_strict : StrictMono (PrimeSpectrum.comap (algebraMap P₀ P_Ω)) := by
        intro Q₁ Q₂ hlt
        have hle : Q₁.asIdeal ≤ Q₂.asIdeal := hlt.le
        obtain ⟨x, hx₂, hx₁⟩ := Set.not_subset.mp hlt.not_ge
        exact Ideal.under_lt_under_of_integral_mem_sdiff hle ⟨hx₂, hx₁⟩
          (Algebra.IsIntegral.isIntegral x)
      let l₀ : LTSeries (PrimeSpectrum P₀) :=
        LTSeries.mk s (PrimeSpectrum.comap (algebraMap P₀ P_Ω) ∘ q) (hcomap_strict.comp hq_mono)
      refine ⟨l₀, LTSeries.mk_length _ _ _, ?_⟩
      change Ideal.comap (algebraMap P₀ P_Ω) (q (Fin.last s)).asIdeal = m0
      rw [hq_last]
      exact hm0_tilde_over
    obtain ⟨l₀, hl₀_len, hl₀_last⟩ := hl₀_exists
    
    have hlA_exists : ∃ L_A : LTSeries (PrimeSpectrum A),
        L_A.length = s ∧ (RelSeries.last L_A).asIdeal = M := by
      let : Algebra P₀ A := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral P₀ A := ⟨hg₀_int⟩
      have : FaithfulSMul P₀ A := (faithfulSMul_iff_algebraMap_injective P₀ A).mpr hg₀_inj
      have : Algebra.HasGoingDown P₀ A := inferInstance
      have : M.LiesOver (RelSeries.last l₀).asIdeal := by
        rw [Ideal.liesOver_iff, hl₀_last]
        rfl
      obtain ⟨L_A, hLA_len, hLA_last, _⟩ := Ideal.exists_ltSeries_of_hasGoingDown l₀ M
      refine ⟨L_A, hLA_len.trans hl₀_len, ?_⟩
      exact congrArg PrimeSpectrum.asIdeal hLA_last
    obtain ⟨L_A, hLA_len, hLA_last⟩ := hlA_exists
    
    have hht_ge : ∀ (n : ℕ) (L' : LTSeries (PrimeSpectrum A)) (Q : Ideal A) [Q.IsPrime],
        L'.length = n → (RelSeries.last L').asIdeal ≤ Q → ((n : ℕ) : ℕ∞) ≤ Q.height := by
      intro n
      induction n with
      | zero =>
        intro _ _ _ _ _
        simp
      | succ n' ih =>
        intro L' Q hQ_prime hlen hleQ
        have hlt : (RelSeries.last L'.eraseLast).asIdeal < (RelSeries.last L').asIdeal :=
          RelSeries.eraseLast_last_rel_last L' (by omega)
        have hltQ : (RelSeries.last L'.eraseLast).asIdeal < Q := lt_of_lt_of_le hlt hleQ
        have ihQ' : ((n' : ℕ) : ℕ∞) ≤ (RelSeries.last L'.eraseLast).asIdeal.height :=
          @ih L'.eraseLast (RelSeries.last L'.eraseLast).asIdeal
            (RelSeries.last L'.eraseLast).isPrime (by simp [hlen]) le_rfl
        by_contra hnot
        have hQle : Q.height ≤ (n' : ℕ∞) := by
          cases hQh : Q.height with
          | top => exfalso; exact hnot (by simp [hQh])
          | coe r =>
            simp only [hQh, Nat.cast_le] at hnot ⊢
            omega
        have hlt_ht : (RelSeries.last L'.eraseLast).asIdeal.height < (n' : ℕ∞) :=
          (Ideal.height_le_iff.mp hQle) (RelSeries.last L'.eraseLast).asIdeal
            (RelSeries.last L'.eraseLast).isPrime hltQ
        exact (not_lt_of_ge ihQ') hlt_ht
    exact hht_ge s L_A M hLA_len hLA_last.le

  
  have hs4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
      (d k₀ : ℕ),
      (∀ (g : R), g ≠ 0 → ∀ (M : Ideal (Localization.Away g)),
        M.IsMaximal → ((d : ℕ) : ℕ∞) ≤ M.height) →
      ∀ (S : Finset R), S.card ≤ k₀ →
      ∀ P ∈ (Ideal.span (S : Set R)).minimalPrimes,
        ((d - k₀ : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ P) := by
    intro R _ _ _ d k₀ hMaxHt S hCard P hP
    classical
    let I : Ideal R := Ideal.span (S : Set R)
    have hP_prime : P.IsPrime := hP.1.1
    have hIP : I ≤ P := hP.1.2
    have hFinMin : I.minimalPrimes.Finite := Ideal.finite_minimalPrimes_of_isNoetherianRing R I
    have hFinT : (I.minimalPrimes \ {P}).Finite := hFinMin.sdiff
    let T_fin : Finset (Ideal R) := hFinT.toFinset
    have hnot_le : ∀ Q ∈ T_fin, ∃ x : R, x ∈ Q ∧ x ∉ P := by
      intro Q hQ
      have hQ_mem : Q ∈ I.minimalPrimes \ {P} := hFinT.mem_toFinset.mp hQ
      have hQ_min : Q ∈ I.minimalPrimes := hQ_mem.1
      have hQ_ne : Q ≠ P := hQ_mem.2
      have hnot : ¬ (Q ≤ P) := by
        intro hQP
        have hPQ : P ≤ Q := hP.2 hQ_min.1 hQP
        exact hQ_ne (le_antisymm hQP hPQ)
      exact Set.not_subset.mp hnot
    let g_fn : Ideal R → R := fun Q =>
      if h : ∃ x : R, x ∈ Q ∧ x ∉ P then Classical.choose h else 1
    let g : R := ∏ Q ∈ T_fin, g_fn Q
    have hg_not_mem : g ∉ P := by
      have hprod : ∀ (F_s : Finset (Ideal R)), (∀ Q ∈ F_s, g_fn Q ∉ P) →
          (∏ Q ∈ F_s, g_fn Q) ∉ P := by
        intro F_s
        induction F_s using Finset.induction_on with
        | empty =>
          intro _ h1
          rw [Finset.prod_empty] at h1
          exact ((Ideal.ne_top_iff_one P).mp hP_prime.ne_top) h1
        | @insert Q₀ s₀ hQ₀_notin ih =>
          intro hall hmem
          rw [Finset.prod_insert hQ₀_notin] at hmem
          rcases hP_prime.mem_or_mem hmem with h1 | h2
          · exact hall Q₀ (Finset.mem_insert_self Q₀ s₀) h1
          · exact ih (fun Q hQ => hall Q (Finset.mem_insert_of_mem hQ)) h2
      refine hprod T_fin fun Q hQ => ?_
      have hex := hnot_le Q hQ
      dsimp [g_fn]
      simp only [hex, ↓reduceDIte]
      exact (Classical.choose_spec hex).2
    have hg_ne : g ≠ 0 := fun h0 => hg_not_mem (h0 ▸ Ideal.zero_mem P)
    have hg_mem_other : ∀ Q ∈ T_fin, g ∈ Q := by
      intro Q hQ
      have hex := hnot_le Q hQ
      have hgQ_in : g_fn Q ∈ Q := by
        dsimp [g_fn]
        simp only [hex, ↓reduceDIte]
        exact (Classical.choose_spec hex).1
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem g_fn hQ
      change g = g_fn Q * c at hc
      rw [hc]
      exact Q.mul_mem_right c hgQ_in
    let M_sub : Submonoid R := Submonoid.powers g
    let R' := Localization.Away g
    have : IsNoetherianRing R' := IsLocalization.isNoetherianRing M_sub R' inferInstance
    have hDisj : Disjoint (M_sub : Set R) (P : Set R) := by
      rw [Set.disjoint_left]
      intro x hxM hxP
      rcases hxM with ⟨n, rfl⟩
      dsimp at hxP
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [pow_zero] at hxP
        exact ((Ideal.ne_top_iff_one P).mp hP_prime.ne_top) hxP
      · exact hg_not_mem (hP_prime.mem_of_pow_mem n hxP)
    let P' : Ideal R' := Ideal.map (algebraMap R R') P
    let I' : Ideal R' := Ideal.map (algebraMap R R') I
    have hP'_prime : P'.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M_sub R' P hP_prime hDisj
    have hP'_under : Ideal.under R P' = P :=
      IsLocalization.under_map_of_isPrime_disjoint M_sub R' hP_prime hDisj
    have hZeroEq : PrimeSpectrum.zeroLocus (I' : Set R') =
        PrimeSpectrum.zeroLocus (P' : Set R') := by
      ext q'
      simp only [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
      constructor
      · intro hI'q
        let Q : Ideal R := Ideal.under R q'.asIdeal
        have : Q.IsPrime := q'.isPrime.comap (algebraMap R R')
        have hIQ : I ≤ Q :=
          Ideal.le_comap_map.trans (Ideal.comap_mono hI'q)
        have hg_not_Q : g ∉ Q := by
          intro hgQ
          have hunit : IsUnit (algebraMap R R' g) :=
            IsUnit.of_mul_eq_one _ (IsLocalization.Away.mul_invSelf g)
          exact q'.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q'.asIdeal hgQ hunit)
        obtain ⟨M₀, hM₀_min, hM₀_le⟩ := Ideal.exists_minimalPrimes_le hIQ
        have hM₀_eq : M₀ = P := by
          by_contra hne
          have hM₀_T : M₀ ∈ T_fin := hFinT.mem_toFinset.mpr ⟨hM₀_min, hne⟩
          exact hg_not_Q (hM₀_le (hg_mem_other M₀ hM₀_T))
        rw [hM₀_eq] at hM₀_le
        calc P' = Ideal.map (algebraMap R R') P := rfl
          _ ≤ Ideal.map (algebraMap R R') Q := Ideal.map_mono hM₀_le
          _ = q'.asIdeal := IsLocalization.map_under M_sub R' q'.asIdeal
      · intro hP'q
        exact (Ideal.map_mono hIP).trans hP'q
    have hDimQuotLE : ringKrullDim (R' ⧸ I') ≤ ringKrullDim (R ⧸ P) := by
      rw [ringKrullDim_quotient, ringKrullDim_quotient, hZeroEq]
      let f_emb : ↥(PrimeSpectrum.zeroLocus (P' : Set R')) →
          ↥(PrimeSpectrum.zeroLocus (P : Set R)) := fun q' =>
        ⟨PrimeSpectrum.comap (algebraMap R R') q'.1, by
          rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
          have h1 : P' ≤ q'.1.asIdeal := by
            have hq2 := q'.2
            rwa [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe] at hq2
          calc P = Ideal.under R P' := hP'_under.symm
            _ ≤ Ideal.under R q'.1.asIdeal := Ideal.comap_mono h1⟩
      have hf_strict : StrictMono f_emb := by
        intro q₁' q₂' hlt
        change (PrimeSpectrum.comap (algebraMap R R') q₁'.1).asIdeal <
          (PrimeSpectrum.comap (algebraMap R R') q₂'.1).asIdeal
        exact (IsLocalization.orderEmbedding M_sub R').strictMono hlt
      exact Order.krullDim_le_of_strictMono f_emb hf_strict
    obtain ⟨M_max, hM_max, hP'_le_M⟩ := Ideal.exists_le_maximal P' hP'_prime.ne_top
    have : M_max.IsPrime := hM_max.isPrime
    let S' : Set R' := (algebraMap R R') '' (S : Set R)
    have hSpanS' : Ideal.span S' = I' := (Ideal.map_span (algebraMap R R') (S : Set R)).symm
    have hS'_sub : S' ⊆ (M_max : Set R') :=
      Ideal.span_le.mp (hSpanS'.trans_le ((Ideal.map_mono hIP).trans hP'_le_M))
    have hHtBound : (M_max.height : WithBot ℕ∞) ≤
        ringKrullDim (R' ⧸ Ideal.span S') + (S'.encard : WithBot ℕ∞) :=
      Ideal.height_le_ringKrullDim_quotient_add_encard S' hS'_sub
    rw [hSpanS'] at hHtBound
    have hMaxGe : ((d : ℕ) : WithBot ℕ∞) ≤ (M_max.height : WithBot ℕ∞) :=
      WithBot.coe_le_coe.mpr (hMaxHt g hg_ne M_max hM_max)
    have hEncardLE : (S'.encard : WithBot ℕ∞) ≤ ((k₀ : ℕ) : WithBot ℕ∞) := by
      refine WithBot.coe_le_coe.mpr ?_
      calc S'.encard ≤ (S : Set R).encard := Set.encard_image_le _ _
        _ = (S.card : ℕ∞) := Set.encard_coe_eq_coe_finsetCard S
        _ ≤ (k₀ : ℕ∞) := Nat.cast_le.mpr hCard
    have hComb : ((d : ℕ) : WithBot ℕ∞) ≤
        ringKrullDim (R ⧸ P) + ((k₀ : ℕ) : WithBot ℕ∞) :=
      hMaxGe.trans (hHtBound.trans (add_le_add hDimQuotLE hEncardLE))
    cases hq : ringKrullDim (R ⧸ P) with
    | bot =>
      rw [hq] at hComb
      exact absurd hComb (by simp)
    | coe e =>
      cases e with
      | top =>
        exact WithBot.coe_le_coe.mpr le_top
      | coe r =>
        rw [hq] at hComb
        have hdrk : d ≤ r + k₀ := by
          have h1 : ((d : ℕ) : ℕ∞) ≤ ((r + k₀ : ℕ) : ℕ∞) := by
            simpa [← WithBot.coe_add, ← Nat.cast_add] using hComb
          exact Nat.cast_le.mp h1
        have hsub : d - k₀ ≤ r := by omega
        exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hsub)

  
  refine ⟨?_, ?_⟩
  · intro E _ _ C _ _ _ _
    exact ⟨hs1 E C, hs2_tensor k E C⟩
  · intro m hm L _ C_L _ _ _ _ hDim S hCard P hP
    have : IsNoetherianRing C_L := Algebra.FiniteType.isNoetherianRing L C_L
    have hMaxHt : ∀ (g : C_L), g ≠ 0 → ∀ (M : Ideal (Localization.Away g)),
        M.IsMaximal → ((m + 1 : ℕ) : ℕ∞) ≤ M.height := by
      intro g hg M hM
      have hle : Submonoid.powers g ≤ nonZeroDivisors C_L :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg)
      have : IsDomain (Localization.Away g) := IsLocalization.isDomain_localization hle
      have : Algebra.FiniteType L (Localization.Away g) :=
        Algebra.FiniteType.trans (S := C_L) inferInstance inferInstance
      have hDimLoc : ringKrullDim (Localization.Away g) = ((m + 1 : ℕ) : WithBot ℕ∞) :=
        (hs2_loc L C_L g hg).trans hDim
      exact hs3 L (Localization.Away g) (m + 1) hDimLoc M hM
    have hBound := hs4 C_L (m + 1) (m - 1) hMaxHt S hCard P hP
    have hEq2 : (m + 1) - (m - 1) = 2 := by omega
    rwa [hEq2] at hBound

theorem weil_integral_proper_section_appTop_bijective (R : Type u) [CommRing R] [IsDomain R]
    (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
    (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) [AlgebraicGeometry.IsProper p]
    (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y)
    (hSec : σ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R))) :
    Function.Bijective (p.appTop).hom :=
by
  let φ := (p.appTop).hom
  let ψ := (σ.appTop).hom
  have hComp : ψ.comp φ = RingHom.id _ := by
    have h1 := congrArg (fun f => (f.appTop).hom) hSec
    rwa [AlgebraicGeometry.Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
      AlgebraicGeometry.Scheme.Hom.id_appTop, CommRingCat.hom_id] at h1
  have hLeft : Function.LeftInverse ψ φ := fun r => by
    simpa using RingHom.congr_fun hComp r
  have hInj : Function.Injective φ := hLeft.injective
  have : Nontrivial _ := φ.domain_nontrivial
  have hInt : φ.IsIntegral :=
    AlgebraicGeometry.isIntegral_appTop_of_universallyClosed p
  have hNoPoly : ∀ (b : _) (_ : ψ b = 0) (_ : b ≠ 0) (d : ℕ)
      (P : Polynomial _) (_ : P.natDegree = d) (_ : P ≠ 0),
      Polynomial.eval₂ φ b P ≠ 0 := by
    intro b hψb hb_ne d
    refine Nat.strong_induction_on d fun d ih P hd hP_ne hEval => ?_
    have hCoeff0 : P.coeff 0 = 0 := by
      have h0 : ψ (Polynomial.eval₂ φ b P) = 0 := by rw [hEval, map_zero]
      rw [Polynomial.hom_eval₂, hComp, hψb, Polynomial.eval₂_id,
        ← Polynomial.coeff_zero_eq_eval_zero] at h0
      exact h0
    obtain ⟨Q, rfl⟩ := Polynomial.X_dvd_iff.mpr hCoeff0
    have hQ_ne : Q ≠ 0 := right_ne_zero_of_mul hP_ne
    have hdeg : (Polynomial.X * Q).natDegree = Q.natDegree + 1 :=
      Polynomial.natDegree_X_mul hQ_ne
    have hQ_lt : Q.natDegree < d := by omega
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_X] at hEval
    have hEvalQ : Polynomial.eval₂ φ b Q = 0 :=
      (mul_eq_zero.mp hEval).resolve_left hb_ne
    exact ih Q.natDegree hQ_lt Q rfl hQ_ne hEvalQ
  refine ⟨hInj, fun a => ?_⟩
  let b := a - φ (ψ a)
  have hψb : ψ b = 0 := by
    simp [b, map_sub, hLeft (ψ a)]
  obtain ⟨P, hMonic, hEval⟩ := hInt b
  have hP_ne : P ≠ 0 := hMonic.ne_zero
  have hb0 : b = 0 := by
    by_contra hb_ne
    exact hNoPoly b hψb hb_ne P.natDegree P rfl hP_ne hEval
  exact ⟨ψ a, (sub_eq_zero.mp hb0).symm⟩

theorem weil_dvr_projective_curve_connected_special_fiber (L : Type u) [Field L] [Infinite L]
    (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [IsLocalRing R] [Algebra L R]
    (ϖ : R) (hϖ_ne : ϖ ≠ 0)
    (hMax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ})
    (hRes : Function.Bijective ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap L R)))
    (N : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
    (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    [AlgebraicGeometry.IsProper p] [AlgebraicGeometry.Surjective p]
    (hGlob : Function.Bijective (p.appTop).hom)
    (gProj : Y ⟶ (weilProjectiveSpaceOver L N).left)
    (hComm : gProj ≫ (weilProjectiveSpaceOver L N).hom =
      p ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L R)))
    (hClosed : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.lift gProj p hComm))
    (hDim0 : topologicalKrullDim
      ↥(CategoryTheory.Limits.pullback p
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) ≤
      (1 : WithBot ℕ∞)) :
    ConnectedSpace
      ↥(CategoryTheory.Limits.pullback p
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ϖ}))))) :=
by
  
  
  
  have h_s1 : ∀ (L : Type u) [Field L] [Infinite L] (N : ℕ)
      (S₀ : Set ↥(letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L) :=
        MvPolynomial.gradedAlgebra
        AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L))),
      IsClosed S₀ →
      topologicalKrullDim ↥S₀ ≤ (1 : WithBot ℕ∞) →
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L) :=
        MvPolynomial.gradedAlgebra
      ∃ (L₀ L₁ : MvPolynomial (Fin (N + 1)) L),
        L₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L 1 ∧
        L₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L 1 ∧
        S₀ ⊆ (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L) L₀ :
                Set ↥(AlgebraicGeometry.Proj
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L))) ∪
              (AlgebraicGeometry.Proj.basicOpen
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L) L₁ :
                Set ↥(AlgebraicGeometry.Proj
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L))) := by
    clear * -
    intro L _ _ N S₀ _hClosedS₀ hDimS₀
    classical
    let A := MvPolynomial (Fin (N + 1)) L
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P_L := AlgebraicGeometry.Proj 𝒜
    have hNoethP : TopologicalSpace.NoetherianSpace ↥P_L := by
      change TopologicalSpace.NoetherianSpace (ProjectiveSpectrum 𝒜)
      let ι_PS : ProjectiveSpectrum 𝒜 → PrimeSpectrum A :=
        fun q => ⟨q.asHomogeneousIdeal.toIdeal, q.isPrime⟩
      have hInd : Topology.IsInducing ι_PS := by
        rw [Topology.isInducing_iff]
        ext U
        constructor
        · intro hU
          rw [ProjectiveSpectrum.isOpen_iff] at hU
          obtain ⟨s, hs⟩ := hU
          refine ⟨(PrimeSpectrum.zeroLocus s)ᶜ, (PrimeSpectrum.isClosed_zeroLocus s).isOpen_compl, ?_⟩
          rw [← compl_inj_iff, Set.preimage_compl, compl_compl, hs]
          ext q
          simp [ProjectiveSpectrum.mem_zeroLocus, PrimeSpectrum.mem_zeroLocus, ι_PS]
        · rintro ⟨V, hV, rfl⟩
          rw [PrimeSpectrum.isOpen_iff] at hV
          obtain ⟨s, hs⟩ := hV
          rw [ProjectiveSpectrum.isOpen_iff]
          refine ⟨s, ?_⟩
          rw [← Set.preimage_compl, hs]
          ext q
          simp [ProjectiveSpectrum.mem_zeroLocus, PrimeSpectrum.mem_zeroLocus, ι_PS]
      exact hInd.noetherianSpace
    have hIrrelLe : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → A)) := by
      intro p hp
      have hp0 : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hdecomp : ∑ i ∈ (DirectSum.decompose 𝒜 p).support,
          (DirectSum.decompose 𝒜 p i : A) = p := DirectSum.sum_support_decompose 𝒜 p
      have h0_not_supp : (0 : Fin (N + 1) →₀ ℕ) ∉ p.support := by
        intro h0p
        rw [← hdecomp] at h0p
        obtain ⟨i, _, h0i⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum h0p)
        by_cases hi0 : i = 0
        · subst hi0
          change (0 : Fin (N + 1) →₀ ℕ) ∈ (GradedRing.proj 𝒜 0 p).support at h0i
          rw [hp0, MvPolynomial.support_zero] at h0i
          exact Finset.notMem_empty _ h0i
        · have hhom := (DirectSum.decompose 𝒜 p i).2
          rw [MvPolynomial.mem_homogeneousSubmodule] at hhom
          have hdeg := hhom (MvPolynomial.mem_support_iff.mp h0i)
          simp at hdeg
          exact hi0 hdeg.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      have hd_ne : d ≠ 0 := by rintro rfl; exact h0_not_supp hd
      obtain ⟨j, hj⟩ : ∃ j : Fin (N + 1), d j ≠ 0 := by
        by_contra hall
        exact hd_ne (Finsupp.ext fun j => Classical.not_not.mp (not_exists.mp hall j))
      exact ⟨j, Set.mem_univ j, hj⟩
    have hAvoidFinset : ∀ (F : Finset ↥P_L),
        ∃ ℓ : A, ℓ ∈ 𝒜 1 ∧ ∀ q ∈ F, q ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 ℓ := by
      intro F
      let V_pt : ↥P_L → Subspace L ↥(𝒜 1) := fun (q : ProjectiveSpectrum 𝒜) =>
        { carrier := {x : ↥(𝒜 1) | (x : A) ∈ q.asHomogeneousIdeal.toIdeal}
          add_mem' := fun ha hb => q.asHomogeneousIdeal.toIdeal.add_mem ha hb
          zero_mem' := q.asHomogeneousIdeal.toIdeal.zero_mem
          smul_mem' := fun c x hx => by
            change (c • x.1 : A) ∈ q.asHomogeneousIdeal.toIdeal
            rw [Algebra.smul_def]
            exact q.asHomogeneousIdeal.toIdeal.mul_mem_left _ hx }
      have hV_ne_top : ∀ q : ↥P_L, V_pt q ≠ ⊤ := by
        intro (q : ProjectiveSpectrum 𝒜) hTop
        apply q.not_irrelevant_le
        change (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ q.asHomogeneousIdeal.toIdeal
        refine hIrrelLe.trans (Ideal.span_le.mpr ?_)
        rintro _ ⟨j, rfl⟩
        have hXj : (⟨MvPolynomial.X j, MvPolynomial.isHomogeneous_X L j⟩ : ↥(𝒜 1)) ∈ V_pt q := by
          rw [hTop]; trivial
        exact hXj
      let s : Finset (Subspace L ↥(𝒜 1)) := F.image V_pt
      have hTopNotMem : ⊤ ∉ s := by
        intro hmem
        obtain ⟨q, _, hEq⟩ := Finset.mem_image.mp hmem
        exact hV_ne_top q hEq
      have hNeUniv : (⋃ W ∈ s, (W : Set ↥(𝒜 1))) ≠ Set.univ :=
        Subspace.biUnion_ne_univ_of_top_notMem hTopNotMem
      obtain ⟨ℓ, _, hℓ_not⟩ : ∃ ℓ ∈ (Set.univ : Set ↥(𝒜 1)), ℓ ∉ ⋃ W ∈ s, (W : Set ↥(𝒜 1)) :=
        Set.not_subset.mp (fun hsub => hNeUniv (Set.Subset.antisymm (Set.subset_univ _) hsub))
      refine ⟨ℓ.1, ℓ.2, fun q hq => ?_⟩
      have hq_not_V : ℓ ∉ (V_pt q : Set ↥(𝒜 1)) := by
        intro hmem
        exact hℓ_not (Set.mem_biUnion (Finset.mem_image_of_mem V_pt hq) hmem)
      let q_ps : ProjectiveSpectrum 𝒜 := q
      exact (ProjectiveSpectrum.mem_basicOpen 𝒜 ℓ.1 q_ps).mpr hq_not_V
    have : TopologicalSpace.NoetherianSpace ↥S₀ := TopologicalSpace.NoetherianSpace.set S₀
    have hFinComp₀ : (irreducibleComponents ↥S₀).Finite :=
