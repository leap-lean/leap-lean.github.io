      · dsimp [f_cone₀, f_cone₁]
        rw [Polynomial.eval₂_X, Polynomial.eval₂_X]
        exact hx01
    let cone := CategoryTheory.Limits.PullbackCone.mk f_cone₀ f_cone₁ hcone_eq
    let lift_sup : CommRingCat.of (Polynomial R) ⟶ Y.presheaf.obj (Opposite.op (U₀ ⊔ U₁)) :=
      Y.sheaf.interUnionPullbackConeLift U₀ U₁ cone
    let s_top : ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
      (lift_sup ≫ Y.presheaf.map (CategoryTheory.homOfLE hCovY.ge).op).hom Polynomial.X
    have hs_U₀ : (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom s_top = x₀ := by
      have hcomp : lift_sup ≫ Y.presheaf.map (CategoryTheory.homOfLE hCovY.ge).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op = f_cone₀ := by
        rw [← Y.presheaf.map_comp]
        change lift_sup ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_sup_left : U₀ ≤ U₀ ⊔ U₁)).op = f_cone₀
        exact Y.sheaf.interUnionPullbackConeLift_left U₀ U₁ cone
      change (lift_sup ≫ Y.presheaf.map (CategoryTheory.homOfLE hCovY.ge).op ≫
        Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom Polynomial.X = x₀
      rw [hcomp]
      exact Polynomial.eval₂_X r₀ x₀
    have hs_U₁ : (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op).hom s_top = x₁ := by
      have hcomp : lift_sup ≫ Y.presheaf.map (CategoryTheory.homOfLE hCovY.ge).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op = f_cone₁ := by
        rw [← Y.presheaf.map_comp]
        change lift_sup ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_sup_right : U₁ ≤ U₀ ⊔ U₁)).op = f_cone₁
        exact Y.sheaf.interUnionPullbackConeLift_right U₀ U₁ cone
      change (lift_sup ≫ Y.presheaf.map (CategoryTheory.homOfLE hCovY.ge).op ≫
        Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op).hom Polynomial.X = x₁
      rw [hcomp]
      exact Polynomial.eval₂_X r₁ x₁
    have hBijTop : Function.Bijective
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ p.appTop).hom) := by
      change Function.Bijective ((p.appTop).hom ∘ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom)
      refine hGlob.comp ?_
      exact (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).symm.commRingCatIsoToRingEquiv.bijective
    obtain ⟨r, hr_top⟩ := hBijTop.surjective s_top
    refine ⟨r, ?_, ?_⟩
    · change (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ p.appTop).hom r) = x₀
      rw [hr_top, hs_U₀]
    · change (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₁ ≤ ⊤)).op).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ p.appTop).hom r) = x₁
      rw [hr_top, hs_U₁]
  have : IsNoetherianRing R := PrincipalIdealRing.isNoetherianRing
  exact h_s4 R ϖ hMax Y p U₀ U₁ hAff₀ hAff₁ hAff₀₁ hCovY
    (fun x₀ x₁ hx₀ hx₁ hx₀₁ =>
      h_s3 R ϖ hMax B₀ B₁ B₀₁ r₀ r₁ r₀₁ res₀ res₁ hr₀ hr₁ hGlued u v huv hFin₀ hLoc₀ hLoc₁
        x₀ x₁ hx₀ hx₁ hx₀₁)

theorem weil_projSpace_standard_affine_chart_and_isSeparated (k : Type u) [Field k] (m : ℕ) (K : Type u) [Field K]
    (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ (weilProjectiveSpaceOver k m).left) :
    AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k m).hom ∧
    ∃ (ι_aff : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin m) k)) ⟶
        (weilProjectiveSpaceOver k m).left)
      (_ : AlgebraicGeometry.IsOpenImmersion ι_aff)
      (ψ_s : MvPolynomial (Fin m) k →+* K),
      ι_aff ≫ (weilProjectiveSpaceOver k m).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫ ι_aff = s :=
by
  classical
  let P := MvPolynomial (Fin (m + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  refine ⟨by dsimp [weilProjectiveSpaceOver]; infer_instance, ?_⟩
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := default
  let x₀ : ProjectiveSpectrum 𝒜 := s pt₀
  
  have hex_i₀ : ∃ i₀ : Fin (m + 1), MvPolynomial.X i₀ ∉ x₀.asHomogeneousIdeal := by
    by_contra! hAll
    apply x₀.not_irrelevant_le
    intro p hp
    have h0 : (((DirectSum.decompose 𝒜) p 0 : ↥(𝒜 0)) : MvPolynomial (Fin (m + 1)) k) = 0 := by
      have hp0 : GradedRing.proj 𝒜 0 p = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      rwa [GradedRing.proj_apply] at hp0
    have hcoeff0 : (p : MvPolynomial (Fin (m + 1)) k).coeff 0 = 0 := by
      conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 p]
      rw [MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro n _
      by_cases hn : n = 0
      · subst hn
        simp [h0]
      · let qn : ↥(𝒜 n) := (DirectSum.decompose 𝒜) p n
        have hqn : MvPolynomial.IsHomogeneous qn.1 n :=
          (MvPolynomial.mem_homogeneousSubmodule n qn.1).mp qn.2
        by_contra hne
        have hdeg := hqn hne
        rw [map_zero] at hdeg
        exact hn hdeg.symm
    have hp_span : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (m + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      have hd_ne : d ≠ 0 := by
        intro hd0
        subst hd0
        exact (MvPolynomial.mem_support_iff.mp hd) hcoeff0
      have hex_j : ∃ j : Fin (m + 1), d j ≠ 0 := by
        by_contra! hall0
        apply hd_ne
        ext j
        exact hall0 j
      obtain ⟨j, hj⟩ := hex_j
      exact ⟨j, Set.mem_univ j, hj⟩
    have hspan_le : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (m + 1)))) ≤
        x₀.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨j, _, rfl⟩
      exact hAll j
    exact hspan_le hp_span
  obtain ⟨i₀, hi₀⟩ := hex_i₀
  
  let X₀ : P := MvPolynomial.X i₀
  have hX_mem : ∀ r : Fin (m + 1), (MvPolynomial.X r : P) ∈ 𝒜 1 := fun r =>
    (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X r)).mpr
      (MvPolynomial.isHomogeneous_X k r)
  have hdeg : X₀ ∈ 𝒜 1 := hX_mem i₀
  let τ := {b : Fin (m + 1) // b ≠ i₀}
  let Pτ := MvPolynomial τ k
  let H₀ := HomogeneousLocalization.Away 𝒜 X₀
  let M₀ : Submonoid P := Submonoid.powers X₀
  have hpow_mem : ∀ n : ℕ, X₀ ^ n ∈ M₀ := fun n =>
    pow_mem (Submonoid.mem_powers X₀) n
  let ι_k : k →+* H₀ :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜 M₀).comp (algebraMap k ↥(𝒜 0))
  have hι_val : ∀ c : k, (ι_k c).val = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
    intro c
    change (HomogeneousLocalization.mk _).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
    rw [HomogeneousLocalization.val_mk]
    rfl
  let u : τ → H₀ := fun b =>
    HomogeneousLocalization.mk
      { deg := 1
        num := ⟨MvPolynomial.X b.1, hX_mem b.1⟩
        den := ⟨X₀, hdeg⟩
        den_mem := Submonoid.mem_powers X₀ }
  let α_sub : Pτ →+* H₀ := MvPolynomial.eval₂Hom ι_k u
  let w : Fin (m + 1) → Pτ := fun j =>
    if h : j = i₀ then 1 else MvPolynomial.X ⟨j, h⟩
  let dehom : P →+* Pτ := MvPolynomial.eval₂Hom MvPolynomial.C w
  have hdehom_X₀ : dehom X₀ = 1 := by
    dsimp [dehom, X₀, w]
    rw [MvPolynomial.eval₂Hom_X']
    simp only [↓reduceDIte]
  have hdehom_mem : ∀ y : M₀, dehom y.1 = 1 := by
    rintro ⟨_, n, rfl⟩
    simp [map_pow, hdehom_X₀]
  have hUnit : ∀ y : M₀, IsUnit (dehom y.1) := by
    intro y
    rw [hdehom_mem y]
    exact isUnit_one
  let β_loc : Localization M₀ →+* Pτ := IsLocalization.lift hUnit
  have hβ_loc_mk : ∀ (p : P) (y : M₀), β_loc (Localization.mk p y) = dehom p := by
    intro p y
    rw [Localization.mk_eq_mk']
    exact (IsLocalization.lift_mk'_spec hUnit p (dehom p) y).mpr
      (by rw [hdehom_mem y, one_mul])
  let valHom : H₀ →+* Localization M₀ :=
    { toFun := HomogeneousLocalization.val
      map_one' := HomogeneousLocalization.val_one
      map_mul' := fun x y => HomogeneousLocalization.val_mul x y
      map_zero' := HomogeneousLocalization.val_zero
      map_add' := fun x y => HomogeneousLocalization.val_add x y }
  let β_sub : H₀ →+* Pτ := β_loc.comp valHom
  have h_left : ∀ q : Pτ, β_sub (α_sub q) = q := by
    have hcomp : β_sub.comp α_sub = RingHom.id Pτ := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change β_loc (α_sub (MvPolynomial.C c)).val = MvPolynomial.C c
        dsimp [α_sub]
        rw [MvPolynomial.eval₂Hom_C, hι_val c, hβ_loc_mk]
        dsimp [dehom]
        rw [MvPolynomial.eval₂Hom_C]
      · intro b
        change β_loc (α_sub (MvPolynomial.X b)).val = MvPolynomial.X b
        dsimp [α_sub]
        rw [MvPolynomial.eval₂Hom_X']
        dsimp [u]
        rw [hβ_loc_mk]
        dsimp [dehom, w]
        rw [MvPolynomial.eval₂Hom_X']
        simp only [b.2, ↓reduceDIte]
        rfl
    intro q
    exact RingHom.congr_fun hcomp q
  let φ : P →+* Localization M₀ := valHom.comp (α_sub.comp dehom)
  have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) (1 : M₀) := by
    intro c
    change (α_sub (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) (1 : M₀)
    dsimp [dehom, α_sub]
    rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
    exact hι_val c
  have hφ_X : ∀ j : Fin (m + 1),
      φ (MvPolynomial.X j) =
        Localization.mk (MvPolynomial.X j) (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀) := by
    intro j
    change (α_sub (dehom (MvPolynomial.X j))).val =
      Localization.mk (MvPolynomial.X j) (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀)
    dsimp [dehom]
    rw [MvPolynomial.eval₂Hom_X']
    dsimp [w]
    by_cases hj : j = i₀
    · simp only [hj, ↓reduceDIte, map_one, HomogeneousLocalization.val_one]
      exact (Localization.mk_self (⟨X₀, Submonoid.mem_powers X₀⟩ : M₀)).symm
    · simp only [hj, ↓reduceDIte]
      dsimp [α_sub]
      rw [MvPolynomial.eval₂Hom_X']
      dsimp [u]
  have hφ_prod : ∀ (s_fin : Finset (Fin (m + 1))) (d : Fin (m + 1) →₀ ℕ),
      φ (∏ j ∈ s_fin, (MvPolynomial.X j : P) ^ d j) =
        Localization.mk (∏ j ∈ s_fin, (MvPolynomial.X j : P) ^ d j)
          ⟨X₀ ^ (∑ j ∈ s_fin, d j), hpow_mem (∑ j ∈ s_fin, d j)⟩ := by
    intro s_fin d
    induction s_fin using Finset.induction_on with
    | empty =>
      simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
      exact (Localization.mk_self (1 : M₀)).symm
    | @insert j s_fin hj ih =>
      rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul, map_pow, hφ_X j, ih,
        Localization.mk_pow, Localization.mk_mul]
      congr 1
      apply Subtype.ext
      change X₀ ^ d j * X₀ ^ (∑ r ∈ s_fin, d r) = X₀ ^ (d j + ∑ r ∈ s_fin, d r)
      rw [← pow_add]
  have hφ_monomial : ∀ (d : Fin (m + 1) →₀ ℕ) (c : k) (n : ℕ),
      (Finsupp.weight 1) d = n →
      φ (MvPolynomial.monomial d c) =
        Localization.mk (MvPolynomial.monomial d c) ⟨X₀ ^ n, hpow_mem n⟩ := by
    intro d c n hdn
    have hsum : ∑ j ∈ d.support, d j = n := by
      have hw : (Finsupp.weight (1 : Fin (m + 1) → ℕ)) d = ∑ j ∈ d.support, d j := by
        simp [Finsupp.weight_apply, Finsupp.sum]
      exact hw.symm.trans hdn
    rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C c, hφ_prod d.support d,
      Localization.mk_mul]
    congr 1
    apply Subtype.ext
    change (1 : P) * X₀ ^ (∑ j ∈ d.support, d j) = X₀ ^ n
    rw [one_mul, hsum]
  have hφ_homog : ∀ (n : ℕ) (p : P), p.IsHomogeneous n →
      φ p = Localization.mk p ⟨X₀ ^ n, hpow_mem n⟩ := by
    intro n p hp
    have h_sum_aux : ∀ (S_fin : Finset (Fin (m + 1) →₀ ℕ)),
        (∀ d ∈ S_fin, (Finsupp.weight 1) d = n) →
        φ (∑ d ∈ S_fin, MvPolynomial.monomial d ((p : MvPolynomial (Fin (m + 1)) k).coeff d)) =
          Localization.mk
            (∑ d ∈ S_fin, MvPolynomial.monomial d ((p : MvPolynomial (Fin (m + 1)) k).coeff d))
            ⟨X₀ ^ n, hpow_mem n⟩ := by
      intro S_fin hS
      induction S_fin using Finset.induction_on with
      | empty =>
        simp [Localization.mk_zero]
      | @insert d S_fin hd ih =>
        rw [Finset.sum_insert hd, map_add,
          hφ_monomial d ((p : MvPolynomial (Fin (m + 1)) k).coeff d) n
            (hS d (Finset.mem_insert_self d S_fin)),
          ih (fun d' hd' => hS d' (Finset.mem_insert_of_mem hd')),
          Localization.add_mk_self]
    conv_lhs => rw [MvPolynomial.as_sum p]
    conv_rhs => rw [MvPolynomial.as_sum p]
    exact h_sum_aux p.support (fun d hd => hp (MvPolynomial.mem_support_iff.mp hd))
  have h_right : ∀ z : H₀, α_sub (β_sub z) = z := by
    intro z
    refine Quotient.inductionOn' z fun nd => ?_
    apply HomogeneousLocalization.val_injective
    obtain ⟨n, hn⟩ := nd.den_mem
    dsimp only at hn
    have hX₀n_ne : (X₀ ^ n : MvPolynomial (Fin (m + 1)) k) ≠ 0 := by
      intro hzero
      have hev := congrArg (MvPolynomial.eval (fun _ : Fin (m + 1) => (1 : k))) hzero
      simp [X₀] at hev
    have hex_d₀ : ∃ d₀ : Fin (m + 1) →₀ ℕ,
        ((X₀ ^ n : MvPolynomial (Fin (m + 1)) k)).coeff d₀ ≠ 0 := by
      by_contra! hall0
      apply hX₀n_ne
      ext d₀
      simpa using hall0 d₀
    obtain ⟨d₀, hd₀⟩ := hex_d₀
    have hpow_homog : (X₀ ^ n : P).IsHomogeneous n := by
      simpa using (MvPolynomial.isHomogeneous_X k i₀).pow n
    have hden_homog : (X₀ ^ n : P).IsHomogeneous nd.deg := by
      rw [hn]
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
    have hdeg_eq : nd.deg = n := (hden_homog hd₀).symm.trans (hpow_homog hd₀)
    have hnum_homog : nd.num.1.IsHomogeneous n := by
      rw [← hdeg_eq]
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
    change valHom (α_sub (β_sub (HomogeneousLocalization.mk nd))) =
      (HomogeneousLocalization.mk nd).val
    simp only [β_sub, RingHom.comp_apply, valHom, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
    rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
    change φ nd.num.1 = _
    rw [hφ_homog n nd.num.1 hnum_homog]
    congr 1
    exact Subtype.ext hn
  let e_sub : Pτ ≃+* H₀ :=
    { α_sub with
      invFun := β_sub
      left_inv := h_left
      right_inv := h_right }
  let e : MvPolynomial (Fin m) k ≃+* H₀ :=
    ((MvPolynomial.renameEquiv k (finSuccAboveEquiv i₀)).toRingEquiv).trans e_sub
  have he_C : ∀ c : k, e (MvPolynomial.C c) =
      HomogeneousLocalization.fromZeroRingHom 𝒜 M₀ (algebraMap k ↥(𝒜 0) c) := by
    intro c
    simp only [e, RingEquiv.trans_apply, AlgEquiv.coe_ringEquiv,
      MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
    change α_sub (MvPolynomial.C c) = _
    dsimp [α_sub, ι_k]
    rw [MvPolynomial.eval₂Hom_C]
    rfl
  
  let φ_iso : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin m) k)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of H₀) :=
    AlgebraicGeometry.Spec.map e.toCommRingCatIso.inv
  let j_away : AlgebraicGeometry.Spec (CommRingCat.of H₀) ⟶ AlgebraicGeometry.Proj 𝒜 :=
    AlgebraicGeometry.Proj.awayι 𝒜 X₀ hdeg Nat.zero_lt_one
  have _ : AlgebraicGeometry.IsOpenImmersion j_away := by
    dsimp [j_away]
    infer_instance
  let ι_aff : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin m) k)) ⟶
      (weilProjectiveSpaceOver k m).left :=
    φ_iso ≫ j_away
  have hOpen : AlgebraicGeometry.IsOpenImmersion ι_aff := by
    dsimp [ι_aff, φ_iso, j_away, weilProjectiveSpaceOver]
    infer_instance
  have hBase : ι_aff ≫ (weilProjectiveSpaceOver k m).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
    dsimp [ι_aff, φ_iso, j_away, weilProjectiveSpaceOver]
    rw [Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      RingEquiv.toCommRingCatIso_inv, ← Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
    apply RingHom.ext
    intro c
    change e.symm (HomogeneousLocalization.fromZeroRingHom 𝒜 M₀ (algebraMap k ↥(𝒜 0) c)) =
      MvPolynomial.C c
    rw [← he_C c, e.symm_apply_apply]
  
  have hx₀_mem : x₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 X₀ :=
    (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 X₀ x₀).mpr hi₀
  have hx₀_range_j : x₀ ∈ j_away.opensRange := by
    dsimp [j_away]
    rwa [AlgebraicGeometry.Proj.opensRange_awayι]
  obtain ⟨z, hz⟩ := AlgebraicGeometry.Scheme.Hom.mem_opensRange.mp hx₀_range_j
  let w_pt := AlgebraicGeometry.Spec.map e.toCommRingCatIso.hom z
  have hw_pt : φ_iso w_pt = z := by
    dsimp [φ_iso, w_pt]
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Spec.map_comp,
      Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    rfl
  have hs_pt₀ : ι_aff w_pt = s pt₀ := by
    change j_away (φ_iso w_pt) = x₀
    rw [hw_pt]
    exact hz
  have hRange : Set.range ⇑s ⊆ Set.range ⇑ι_aff := by
    rintro _ ⟨pt, rfl⟩
    have hpt : pt = pt₀ := (Unique.eq_default pt).trans (Unique.eq_default pt₀).symm
    rw [hpt, ← hs_pt₀]
    exact ⟨w_pt, rfl⟩
  let s_aff := AlgebraicGeometry.IsOpenImmersion.lift ι_aff s hRange
  have hs_aff_fac : s_aff ≫ ι_aff = s :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac ι_aff s hRange
  let ψ_s : MvPolynomial (Fin m) k →+* K := (AlgebraicGeometry.Spec.preimage s_aff).hom
  have hψ_s : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫ ι_aff = s := by
    dsimp [ψ_s]
    rw [AlgebraicGeometry.Spec.map_preimage, hs_aff_fac]
  exact ⟨ι_aff, hOpen, ψ_s, hBase, hψ_s⟩

theorem weil_algClosed_generic_slope_dvr_algebra_package (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (hAlgDom : ∀ (E : Type u) [Field E] [Algebra k E]
        (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C],
      IsDomain (TensorProduct k C E) ∧
      ringKrullDim (TensorProduct k C E) = ringKrullDim C)
    (hMinPrimeDim : ∀ (L : Type u) [Field L]
        (C_L : Type u) [CommRing C_L] [IsDomain C_L] [Algebra L C_L] [Algebra.FiniteType L C_L],
      ringKrullDim C_L = ((m + 1 : ℕ) : WithBot ℕ∞) →
      ∀ (S : Finset C_L), S.card ≤ m - 1 →
      ∀ P ∈ (Ideal.span (S : Set C_L)).minimalPrimes,
        ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (C_L ⧸ P))
    (K : Type u) [Field K] [IsAlgClosed K]
    (ψ_s : MvPolynomial (Fin m) k →+* K) :
    ∃ (L : Type u) (_ : Field L) (_ : Infinite L)
      (_ : Algebra k K) (_ : Algebra k L) (_ : Algebra K L) (_ : IsScalarTower k K L)
      (R : Type u) (_ : CommRing R) (_ : IsDomain R)
      (_ : IsPrincipalIdealRing R) (_ : IsLocalRing R)
      (_ : Algebra k R) (_ : Algebra K R) (_ : Algebra L R)
      (_ : IsScalarTower k L R) (_ : IsScalarTower K L R)
      (_ : Algebra (MvPolynomial (Fin m) k) R)
      (_ : IsScalarTower k (MvPolynomial (Fin m) k) R)
      (ϖ : R),
      ψ_s.comp MvPolynomial.C = algebraMap k K ∧
      ϖ ≠ 0 ∧
      IsLocalRing.maximalIdeal R = Ideal.span {ϖ} ∧
      Function.Bijective ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap L R)) ∧
      (Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap (MvPolynomial (Fin m) k) R) =
        ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap K R)).comp ψ_s ∧
      (∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C]
          [Algebra (MvPolynomial (Fin m) k) C] [IsScalarTower k (MvPolynomial (Fin m) k) C],
        Function.Injective (algebraMap (MvPolynomial (Fin m) k) C) →
        IsDomain (TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R)) ∧
        (ringKrullDim C = ((m + 1 : ℕ) : WithBot ℕ∞) →
         ringKrullDim (TensorProduct (MvPolynomial (Fin m) k) C (R ⧸ Ideal.span {ϖ})) ≤
           (1 : WithBot ℕ∞) →
         ∀ q : PrimeSpectrum (TensorProduct (MvPolynomial (Fin m) k) C R),
           q ∈ closure (Set.range (PrimeSpectrum.comap
             (Algebra.TensorProduct.map
               (AlgHom.id (MvPolynomial (Fin m) k) C)
               (IsScalarTower.toAlgHom (MvPolynomial (Fin m) k) R (FractionRing R))).toRingHom)))) :=
by
  have hMain : ∀ [Algebra k K]
      (hψ_k : ψ_s.comp MvPolynomial.C = algebraMap k K)
      (L : Type u) [Field L] [Infinite L]
      [Algebra k L] [Algebra K L] [IsScalarTower k K L]
      [Algebra (MvPolynomial (Fin (m - 1)) K) L]
      [IsScalarTower K (MvPolynomial (Fin (m - 1)) K) L]
      [IsFractionRing (MvPolynomial (Fin (m - 1)) K) L]
      [(Ideal.span ({Polynomial.X} : Set (Polynomial L))).IsPrime]
      (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [IsLocalRing R]
      [Algebra k R] [Algebra K R] [Algebra L R]
      [IsScalarTower k L R] [IsScalarTower K L R] [IsScalarTower k K R]
      [Algebra (Polynomial L) R] [IsScalarTower L (Polynomial L) R]
      [IsLocalization.AtPrime R (Ideal.span ({Polynomial.X} : Set (Polynomial L)))],
      ∃ (_ : Algebra (MvPolynomial (Fin m) k) R)
        (_ : IsScalarTower k (MvPolynomial (Fin m) k) R)
        (ϖ : R),
        ψ_s.comp MvPolynomial.C = algebraMap k K ∧
        ϖ ≠ 0 ∧
        IsLocalRing.maximalIdeal R = Ideal.span {ϖ} ∧
        Function.Bijective ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap L R)) ∧
        (Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap (MvPolynomial (Fin m) k) R) =
          ((Ideal.Quotient.mk (Ideal.span {ϖ})).comp (algebraMap K R)).comp ψ_s ∧
        (∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra k C] [Algebra.FiniteType k C]
            [Algebra (MvPolynomial (Fin m) k) C] [IsScalarTower k (MvPolynomial (Fin m) k) C],
          Function.Injective (algebraMap (MvPolynomial (Fin m) k) C) →
          IsDomain (TensorProduct (MvPolynomial (Fin m) k) C (FractionRing R)) ∧
          (ringKrullDim C = ((m + 1 : ℕ) : WithBot ℕ∞) →
           ringKrullDim (TensorProduct (MvPolynomial (Fin m) k) C (R ⧸ Ideal.span {ϖ})) ≤
             (1 : WithBot ℕ∞) →
           ∀ q : PrimeSpectrum (TensorProduct (MvPolynomial (Fin m) k) C R),
             q ∈ closure (Set.range (PrimeSpectrum.comap
               (Algebra.TensorProduct.map
                 (AlgHom.id (MvPolynomial (Fin m) k) C)
                 (IsScalarTower.toAlgHom (MvPolynomial (Fin m) k) R (FractionRing R))).toRingHom)))) := by
    intro _ hψ_k L _ _ _ _ _ _ _ _ hPrimePt R _ _ _ _ _ _ _ _ _ _ _ _ _
    let P_t : Ideal (Polynomial L) := Ideal.span {Polynomial.X}
    let ϖ : R := algebraMap (Polynomial L) R Polynomial.X
    let a : Fin m → K := fun j => ψ_s (MvPolynomial.X j)
    let a_L : Fin m → L := fun j => algebraMap K L (a j)
    let u : Fin (m - 1) → L := fun r => algebraMap (MvPolynomial (Fin (m - 1)) K) L (MvPolynomial.X r)
    let idx0 : Fin m := ⟨0, hm⟩
    let idxSucc : Fin (m - 1) → Fin m := fun r => ⟨r.1 + 1, Nat.add_lt_of_lt_sub r.2⟩
    let w_R : Fin m → R := fun j =>
      if h : j.1 = 0 then algebraMap K R (a j) + ϖ
      else algebraMap K R (a j) + algebraMap L R (u ⟨j.1 - 1, by omega⟩) * ϖ
    have hw0 : w_R idx0 = algebraMap K R (a idx0) + ϖ := by
      simp [w_R, idx0]
    have hwsucc : ∀ r : Fin (m - 1),
        w_R (idxSucc r) = algebraMap K R (a (idxSucc r)) + algebraMap L R (u r) * ϖ := by
      intro r
      have hne : (idxSucc r).1 ≠ 0 := by simp [idxSucc]
      have hsub : (⟨(idxSucc r).1 - 1, by omega⟩ : Fin (m - 1)) = r := by
        ext; simp [idxSucc]
      simp [w_R, hne, hsub]
    letI : Algebra (MvPolynomial (Fin m) k) R := (MvPolynomial.aeval (R := k) w_R).toRingHom.toAlgebra
    have hAlgA₀R_X : ∀ j : Fin m, algebraMap (MvPolynomial (Fin m) k) R (MvPolynomial.X j) = w_R j :=
      fun j => MvPolynomial.aeval_X w_R j
    have hAlgA₀R_C : ∀ c : k, algebraMap (MvPolynomial (Fin m) k) R (MvPolynomial.C c) = algebraMap k R c :=
      fun c => MvPolynomial.aeval_C w_R c
    haveI : IsScalarTower k (MvPolynomial (Fin m) k) R :=
      IsScalarTower.of_algebraMap_eq fun c => (hAlgA₀R_C c).symm

    
    have hPt_le_nzd : P_t.primeCompl ≤ nonZeroDivisors (Polynomial L) := by
      intro f hf
      rw [mem_nonZeroDivisors_iff_ne_zero]
      rintro rfl
      exact hf P_t.zero_mem
    have hInjPolyR : Function.Injective (algebraMap (Polynomial L) R) :=
      IsLocalization.injective R hPt_le_nzd
    have hϖ_ne : ϖ ≠ 0 := by
      intro h0
      apply Polynomial.X_ne_zero (R := L)
      exact hInjPolyR (h0.trans (map_zero _).symm)
    have hMax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P_t R, Ideal.map_span,
        Set.image_singleton]
    let q₀ : R →+* (R ⧸ Ideal.span {ϖ}) := Ideal.Quotient.mk (Ideal.span {ϖ})
    have hq₀_ϖ : q₀ ϖ = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self ϖ)
    haveI hMaxSpan : (Ideal.span {ϖ}).IsMaximal := by
      rw [← hMax]
      exact IsLocalRing.maximalIdeal.isMaximal R
    letI : Field (R ⧸ Ideal.span {ϖ}) := Ideal.Quotient.field (Ideal.span {ϖ})
    have hRes : Function.Bijective (q₀.comp (algebraMap L R)) := by
      refine ⟨(q₀.comp (algebraMap L R)).injective, ?_⟩
      have hq₀_poly : ∀ p : Polynomial L,
          q₀ (algebraMap (Polynomial L) R p) = q₀ (algebraMap L R (p.coeff 0)) := by
        intro p
        have hc0 : (p - Polynomial.C (p.coeff 0)).coeff 0 = 0 := by simp
        obtain ⟨h, hh⟩ := Polynomial.X_dvd_iff.mpr hc0
        have hp_eq : p = Polynomial.C (p.coeff 0) + Polynomial.X * h := by
          calc p = (p - Polynomial.C (p.coeff 0)) + Polynomial.C (p.coeff 0) := (sub_add_cancel _ _).symm
            _ = Polynomial.C (p.coeff 0) + Polynomial.X * h := by rw [hh, add_comm]
        have hC : algebraMap (Polynomial L) R (Polynomial.C (p.coeff 0)) = algebraMap L R (p.coeff 0) := by
          rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply L (Polynomial L) R]
        conv_lhs => rw [hp_eq]
        rw [map_add, map_mul, map_add, map_mul, hC]
        change q₀ (algebraMap L R (p.coeff 0)) + q₀ ϖ * q₀ (algebraMap (Polynomial L) R h) = _
        rw [hq₀_ϖ, zero_mul, add_zero]
      intro z
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨f, g⟩, hfg⟩ := IsLocalization.surj P_t.primeCompl r
      have hg0 : g.1.coeff 0 ≠ 0 := by
        intro hg0
        have hdvd : Polynomial.X ∣ g.1 := Polynomial.X_dvd_iff.mpr hg0
        exact g.2 (Ideal.mem_span_singleton.mpr hdvd)
      have hfg_q : q₀ r * q₀ (algebraMap L R (g.1.coeff 0)) = q₀ (algebraMap L R (f.coeff 0)) := by
        calc q₀ r * q₀ (algebraMap L R (g.1.coeff 0))
            = q₀ r * q₀ (algebraMap (Polynomial L) R g.1) := by rw [hq₀_poly]
          _ = q₀ (r * algebraMap (Polynomial L) R g.1) := (map_mul q₀ _ _).symm
          _ = q₀ (algebraMap (Polynomial L) R f) := by rw [hfg]
          _ = q₀ (algebraMap L R (f.coeff 0)) := hq₀_poly f
      refine ⟨f.coeff 0 * (g.1.coeff 0)⁻¹, ?_⟩
      change q₀ (algebraMap L R (f.coeff 0 * (g.1.coeff 0)⁻¹)) = q₀ r
      calc q₀ (algebraMap L R (f.coeff 0 * (g.1.coeff 0)⁻¹))
          = q₀ (algebraMap L R (f.coeff 0)) * q₀ (algebraMap L R (g.1.coeff 0)⁻¹) := by
              rw [map_mul, map_mul]
        _ = q₀ r * (q₀ (algebraMap L R (g.1.coeff 0)) * q₀ (algebraMap L R (g.1.coeff 0)⁻¹)) := by
              rw [← hfg_q, mul_assoc]
        _ = q₀ r * q₀ (algebraMap L R (g.1.coeff 0 * (g.1.coeff 0)⁻¹)) := by
              rw [← map_mul q₀ (algebraMap L R _), ← map_mul (algebraMap L R)]
        _ = q₀ r := by rw [mul_inv_cancel₀ hg0, map_one, map_one, mul_one]

    have hPrimeMem : ∀ (q_R : Ideal R) [q_R.IsPrime], q_R ≠ ⊥ → ϖ ∈ q_R := by
      have hFactor : ∀ n : ℕ, ∀ f : Polynomial L, f.natDegree = n → f ≠ 0 →
          ∃ (e : ℕ) (u₀ : Polynomial L), u₀ ∈ P_t.primeCompl ∧ f = Polynomial.X ^ e * u₀ := by
        intro n
        induction n using Nat.strong_induction_on with
        | h n ih =>
          intro f hdeg hf_ne
          by_cases hmem : f ∈ P_t
          · obtain ⟨f₁, hf₁⟩ := Ideal.mem_span_singleton.mp hmem
            have hf₁_ne : f₁ ≠ 0 := by
              rintro rfl
              simp at hf₁
              exact hf_ne hf₁
            have hdeg_lt : f₁.natDegree < n := by
              rw [← hdeg, hf₁, Polynomial.natDegree_mul Polynomial.X_ne_zero hf₁_ne,
                Polynomial.natDegree_X]
              omega
            obtain ⟨e₁, u₀, hu₀, hf₁_eq⟩ := ih f₁.natDegree hdeg_lt f₁ rfl hf₁_ne
            exact ⟨e₁ + 1, u₀, hu₀, by rw [hf₁, hf₁_eq, pow_succ', mul_assoc]⟩
          · exact ⟨0, f, hmem, by simp⟩
      intro q_R hq_prime hq_ne
      obtain ⟨x, hx_mem, hx_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq_ne
      obtain ⟨⟨f, g⟩, hfg⟩ := IsLocalization.surj P_t.primeCompl x
      have hf_ne : f ≠ 0 := by
        rintro rfl
        rw [map_zero] at hfg
        have hunit : IsUnit (algebraMap (Polynomial L) R g.1) := IsLocalization.map_units R g
        exact hx_ne (hunit.mul_left_eq_zero.mp hfg)
      obtain ⟨e, u₀, hu₀, hf_eq⟩ := hFactor f.natDegree f rfl hf_ne
      have hf_mem : algebraMap (Polynomial L) R f ∈ q_R := by
        rw [← hfg]
        exact q_R.mul_mem_right _ hx_mem
      rw [hf_eq, map_mul, map_pow] at hf_mem
      change ϖ ^ e * algebraMap (Polynomial L) R u₀ ∈ q_R at hf_mem
      obtain ⟨u_unit, hu_unit_eq⟩ := IsLocalization.map_units R ⟨u₀, hu₀⟩
      have hpow_mem : ϖ ^ e ∈ q_R := by
        rw [← hu_unit_eq] at hf_mem
        have hmul := q_R.mul_mem_right (↑u_unit⁻¹ : R) hf_mem
        rwa [mul_assoc, Units.mul_inv, mul_one] at hmul
      exact hq_prime.mem_of_pow_mem e hpow_mem

    have hMod_ϖ : q₀.comp (algebraMap (MvPolynomial (Fin m) k) R) =
        (q₀.comp (algebraMap K R)).comp ψ_s := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, hAlgA₀R_C]
        have hcK : ψ_s (MvPolynomial.C c) = algebraMap k K c := RingHom.congr_fun hψ_k c
        rw [hcK, ← IsScalarTower.algebraMap_apply k K R]
      · intro j
        simp only [RingHom.comp_apply, hAlgA₀R_X]
        by_cases h : j.1 = 0
        · have hj : j = idx0 := Fin.ext h
          rw [hj, hw0, map_add, hq₀_ϖ, add_zero]
        · let r : Fin (m - 1) := ⟨j.1 - 1, by omega⟩
          have hj : j = idxSucc r := by ext; simp [idxSucc, r]; omega
          rw [hj, hwsucc, map_add, map_mul, hq₀_ϖ, mul_zero, add_zero]

    
    let Φ_K : MvPolynomial (Fin m) K →+* FractionRing R :=
      MvPolynomial.eval₂Hom (algebraMap K (FractionRing R))
        (fun j => algebraMap R (FractionRing R) (w_R j))
    have hΦ_C : Φ_K.comp MvPolynomial.C = algebraMap K (FractionRing R) := by
      ext c; simp [Φ_K]
    have hΦ_X : ∀ j : Fin m,
        Φ_K (MvPolynomial.X j) = algebraMap (MvPolynomial (Fin m) k) (FractionRing R) (MvPolynomial.X j) := by
      intro j
      rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin m) k) R (FractionRing R), hAlgA₀R_X]
      simp [Φ_K]
    have hInjΦ : Function.Injective Φ_K := by
      let v_poly : Fin m → Polynomial (MvPolynomial (Fin (m - 1)) K) := fun j =>
        if h : j.1 = 0 then
          Polynomial.C (MvPolynomial.C (a j)) + Polynomial.X
        else
          Polynomial.C (MvPolynomial.C (a j)) +
            Polynomial.C (MvPolynomial.X ⟨j.1 - 1, by omega⟩) * Polynomial.X
      let Φ_poly : MvPolynomial (Fin m) K →+* Polynomial (MvPolynomial (Fin (m - 1)) K) :=
        MvPolynomial.eval₂Hom (Polynomial.C.comp MvPolynomial.C) v_poly
      let ι_tot : Polynomial (MvPolynomial (Fin (m - 1)) K) →+* FractionRing R :=
        (algebraMap R (FractionRing R)).comp ((algebraMap (Polynomial L) R).comp
          (Polynomial.mapRingHom (algebraMap (MvPolynomial (Fin (m - 1)) K) L)))
      have hΦ_fac : Φ_K = ι_tot.comp Φ_poly := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [Φ_K, Φ_poly, ι_tot, RingHom.comp_apply, MvPolynomial.eval₂Hom_C,
            Polynomial.coe_mapRingHom, Polynomial.map_C]
          have h1 : algebraMap (MvPolynomial (Fin (m - 1)) K) L (MvPolynomial.C c) = algebraMap K L c :=
            (IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (m - 1)) K) L c).symm
          have h2 : algebraMap (Polynomial L) R (Polynomial.C (algebraMap K L c)) = algebraMap K R c := by
            rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply L (Polynomial L) R,
              ← IsScalarTower.algebraMap_apply K L R]
          rw [h1, h2, ← IsScalarTower.algebraMap_apply K R (FractionRing R)]
        · intro j
          simp only [Φ_K, Φ_poly, ι_tot, RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
          have hC_aj : algebraMap R (FractionRing R) (algebraMap (Polynomial L) R
              (Polynomial.C (algebraMap (MvPolynomial (Fin (m - 1)) K) L (MvPolynomial.C (a j))))) =
              algebraMap R (FractionRing R) (algebraMap K R (a j)) := by
            have h1 : algebraMap (MvPolynomial (Fin (m - 1)) K) L (MvPolynomial.C (a j)) =
                algebraMap K L (a j) :=
              (IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (m - 1)) K) L (a j)).symm
            rw [h1, ← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply L (Polynomial L) R,
              ← IsScalarTower.algebraMap_apply K L R]
          by_cases h : j.1 = 0
          · have hj : j = idx0 := Fin.ext h
            simp only [v_poly, h, ↓reduceDIte, map_add, Polynomial.coe_mapRingHom,
              Polynomial.map_C, Polynomial.map_X]
            rw [hC_aj, hj, hw0, map_add]
          · let r : Fin (m - 1) := ⟨j.1 - 1, by omega⟩
            have hj : j = idxSucc r := by ext; simp [idxSucc, r]; omega
            simp only [v_poly, h, ↓reduceDIte, map_add, map_mul, Polynomial.coe_mapRingHom,
              Polynomial.map_C, Polynomial.map_X]
            have hCu : algebraMap (Polynomial L) R (Polynomial.C (u r)) = algebraMap L R (u r) := by
              rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply L (Polynomial L) R]
            change _ = algebraMap R (FractionRing R) (algebraMap (Polynomial L) R
                (Polynomial.C (algebraMap (MvPolynomial (Fin (m - 1)) K) L (MvPolynomial.C (a j))))) +
              algebraMap R (FractionRing R) (algebraMap (Polynomial L) R (Polynomial.C (u r))) *
                algebraMap R (FractionRing R) ϖ
            rw [hC_aj, hCu, hj, hwsucc, map_add, map_mul]
      have hInj_ιtot : Function.Injective ι_tot :=
        (IsFractionRing.injective R (FractionRing R)).comp
          (hInjPolyR.comp
            (Polynomial.map_injective _ (IsFractionRing.injective (MvPolynomial (Fin (m - 1)) K) L)))
      let d₀ : FractionRing (MvPolynomial (Fin m) K) :=
        algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K))
          (MvPolynomial.X idx0 - MvPolynomial.C (a idx0))
      have hd₀ : d₀ ≠ 0 := by
        intro hd0
        have hp0 : (MvPolynomial.X idx0 - MvPolynomial.C (a idx0) : MvPolynomial (Fin m) K) = 0 :=
          (IsFractionRing.injective (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K)))
            (hd0.trans (map_zero _).symm)
        have heval := congrArg (MvPolynomial.eval (fun _ : Fin m => a idx0 + 1)) hp0
        simp at heval
      let Ψ_slope : MvPolynomial (Fin (m - 1)) K →+* FractionRing (MvPolynomial (Fin m) K) :=
        MvPolynomial.eval₂Hom (algebraMap K (FractionRing (MvPolynomial (Fin m) K))) (fun r =>
          (algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K))
              (MvPolynomial.X (idxSucc r)) -
            algebraMap K (FractionRing (MvPolynomial (Fin m) K)) (a (idxSucc r))) / d₀)
      let Ψ_poly : Polynomial (MvPolynomial (Fin (m - 1)) K) →+* FractionRing (MvPolynomial (Fin m) K) :=
        Polynomial.eval₂RingHom Ψ_slope d₀
      have hΨ_poly_C : ∀ q : MvPolynomial (Fin (m - 1)) K, Ψ_poly (Polynomial.C q) = Ψ_slope q := by
        intro q; simp [Ψ_poly]
      have hΨ_poly_X : Ψ_poly Polynomial.X = d₀ := by
        simp [Ψ_poly]
      have hLeftInv : Ψ_poly.comp Φ_poly =
          algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K)) := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [Φ_poly, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hΨ_poly_C, Ψ_slope]
          exact IsScalarTower.algebraMap_apply K (MvPolynomial (Fin m) K)
            (FractionRing (MvPolynomial (Fin m) K)) c
        · intro j
          simp only [Φ_poly, RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
          have hC_aj : Ψ_slope (MvPolynomial.C (a j)) =
              algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K))
                (MvPolynomial.C (a j)) := by
            simp only [Ψ_slope, MvPolynomial.eval₂Hom_C]
            exact IsScalarTower.algebraMap_apply K (MvPolynomial (Fin m) K)
              (FractionRing (MvPolynomial (Fin m) K)) (a j)
          by_cases h : j.1 = 0
          · have hj : j = idx0 := Fin.ext h
            simp only [v_poly, h, ↓reduceDIte, map_add, hΨ_poly_C, hΨ_poly_X]
            rw [hC_aj, hj]
            simp [d₀]
          · let r : Fin (m - 1) := ⟨j.1 - 1, by omega⟩
            have hj : j = idxSucc r := by ext; simp [idxSucc, r]; omega
