        intro d
        change ψ_gen (lam_gen d) = ι_D_loc d
        have hd : φ_gen (ι_D_loc d) = lam_gen d :=
          IsLocalization.lift_eq (S := Localization M_R) hMR_units d
        rw [← hd]
        exact RingHom.congr_fun hψφ_gen (ι_D_loc d)

      have hLiftRingHom : ∀ {B T : Type u} [CommRing B] [Algebra (MvPolynomial (Fin m) k) B]
