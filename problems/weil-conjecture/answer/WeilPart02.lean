          _ = (q₁ * Polynomial.C c₀).leadingCoeff := by rw [hc]
          _ = q₁.leadingCoeff * (Polynomial.C c₀).leadingCoeff := Polynomial.leadingCoeff_mul _ _
          _ = 1 * c₀ := by rw [(hS_props q₁ hq₁).1.leadingCoeff, Polynomial.leadingCoeff_C]
      rw [one_mul] at h_lc
      subst h_lc
      simp only [map_one, mul_one] at hc
      exact hne hc.symm
    let L : Type u := P_sep.SplittingField
    have _ : IsGalois K₀ L := IsGalois.of_separable_splitting_field hP_sep
    have hSepL : Algebra.IsSeparable K₀ L := IsGalois.to_isSeparable
    have hFinDimL : FiniteDimensional K₀ L := inferInstance
    have hP_splits : (P_sep.map (algebraMap K₀ L)).Splits :=
