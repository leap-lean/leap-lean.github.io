          apply CategoryTheory.Limits.pullback.hom_ext
          · calc (fwd₂ ≫ inv₂) ≫ CategoryTheory.Limits.pullback.fst π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ))
              _ = fwd₂ ≫ (inv₂ ≫ CategoryTheory.Limits.pullback.fst _ _) := Category.assoc _ _ _
              _ = fwd₂ ≫ snd_L := congrArg (fwd₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              _ = CategoryTheory.Limits.pullback.fst _ _ := CategoryTheory.Limits.pullback.lift_snd _ _ _
              _ = 𝟙 pb_mid ≫ CategoryTheory.Limits.pullback.fst _ _ := (Category.id_comp _).symm
          · rw [Category.assoc, Category.id_comp]
            have h_snd : inv₂ ≫ CategoryTheory.Limits.pullback.snd π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) =
                to_D₀ ≫ (isoD₀ ℓ).hom := CategoryTheory.Limits.pullback.lift_snd _ _ _
            rw [h_snd, ← Category.assoc]
            have h_to : fwd₂ ≫ to_D₀ =
                CategoryTheory.Limits.pullback.snd π_L (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) ≫
                  (isoD₀ ℓ).inv := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · calc (fwd₂ ≫ to_D₀) ≫ fst₀ ℓ
                  _ = fwd₂ ≫ (to_D₀ ≫ fst₀ ℓ) := Category.assoc _ _ _
                  _ = fwd₂ ≫ fst_L := congrArg (fwd₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                  _ = CategoryTheory.Limits.pullback.snd _ _ ≫ (isoD₀ ℓ).inv ≫ fst₀ ℓ :=
                      CategoryTheory.Limits.pullback.lift_fst _ _ _
                  _ = (CategoryTheory.Limits.pullback.snd _ _ ≫ (isoD₀ ℓ).inv) ≫ fst₀ ℓ :=
                      (Category.assoc _ _ _).symm
              · calc (fwd₂ ≫ to_D₀) ≫ snd₀ ℓ
                  _ = fwd₂ ≫ (to_D₀ ≫ snd₀ ℓ) := Category.assoc _ _ _
                  _ = fwd₂ ≫ (snd_L ≫ π_L) :=
                      congrArg (fwd₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)
                  _ = (fwd₂ ≫ snd_L) ≫ π_L := (Category.assoc _ _ _).symm
                  _ = CategoryTheory.Limits.pullback.fst _ _ ≫ π_L :=
                      congrArg (· ≫ π_L) (CategoryTheory.Limits.pullback.lift_snd _ _ _)
                  _ = CategoryTheory.Limits.pullback.snd _ _ ≫ AlgebraicGeometry.Spec.map (φ_K₀A ℓ) :=
                      CategoryTheory.Limits.pullback.condition
                  _ = CategoryTheory.Limits.pullback.snd _ _ ≫ ((isoD₀ ℓ).inv ≫ snd₀ ℓ) := by
