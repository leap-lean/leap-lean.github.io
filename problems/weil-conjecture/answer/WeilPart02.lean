        (Algebra.TensorProduct.comm k K C).toRingHom.comp (f_A₀C_alg.toRingHom.comp e_mv.toRingHom)
      have hInj_ιAK : Function.Injective ι_AK :=
        (Algebra.TensorProduct.comm k K C).injective.comp (hInj_fA₀C.comp e_mv.injective)
      have hιAK_C : ∀ κ : K, ι_AK (MvPolynomial.C κ) = (1 : C) ⊗ₜ[k] κ := by
        intro κ
        simp [ι_AK, f_A₀C_alg, he_mv_C]
      have hιAK_X : ∀ j : Fin m,
          ι_AK (MvPolynomial.X j) =
            (algebraMap (MvPolynomial (Fin m) k) C (MvPolynomial.X j)) ⊗ₜ[k] (1 : K) := by
        intro j
        simp [ι_AK, f_A₀C_alg, he_mv_X]
      let ι_E : MvPolynomial (Fin m) K →+* FractionRing (TensorProduct k C K) :=
        (algebraMap (TensorProduct k C K) (FractionRing (TensorProduct k C K))).comp ι_AK
      have hInj_ιE : Function.Injective ι_E :=
        (IsFractionRing.injective (TensorProduct k C K)
          (FractionRing (TensorProduct k C K))).comp hInj_ιAK
      have hιE_units : ∀ y : nonZeroDivisors (MvPolynomial (Fin m) K), IsUnit (ι_E y) := by
        intro y
        have hy : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        exact isUnit_iff_ne_zero.mpr fun h0 => hy (hInj_ιE (h0.trans (map_zero _).symm))
      let Λ : FractionRing (MvPolynomial (Fin m) K) →+* FractionRing (TensorProduct k C K) :=
        IsLocalization.lift (S := FractionRing (MvPolynomial (Fin m) K)) hιE_units
      have hΛ_alg : ∀ p : MvPolynomial (Fin m) K,
          Λ (algebraMap (MvPolynomial (Fin m) K) (FractionRing (MvPolynomial (Fin m) K)) p) = ι_E p :=
        IsLocalization.lift_eq hιE_units
      let j_C : C →+* FractionRing (TensorProduct k C K) :=
