          rw [map_add, map_add]
          exact S.add_mem hp₁ hp₂
        | monomial n c =>
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow]
          have hC : algebraMap (Polynomial L) R (Polynomial.C c) = algebraMap L R c := by
            rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply L (Polynomial L) R]
