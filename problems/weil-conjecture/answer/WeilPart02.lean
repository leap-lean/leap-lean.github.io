          (q_line (y idx0))
      let M_Q : Submonoid (TensorProduct k L C ⧸ I_line) := P_t.primeCompl.map τ_Q
      letI : CommRing (Localization M_Q) := inferInstance
      let π_CL_D : TensorProduct k L C →+* TensorProduct (MvPolynomial (Fin m) k) C R :=
        (Algebra.TensorProduct.lift
          (((Algebra.TensorProduct.includeRight :
            R →ₐ[MvPolynomial (Fin m) k]
              TensorProduct (MvPolynomial (Fin m) k) C R).restrictScalars k).comp
            (IsScalarTower.toAlgHom k L R))
          ((Algebra.TensorProduct.includeLeft :
            C →ₐ[MvPolynomial (Fin m) k]
              TensorProduct (MvPolynomial (Fin m) k) C R).restrictScalars k)
          (fun _ _ => Commute.all _ _)).toRingHom
      have hπ_tmul : ∀ (ℓ : L) (c : C),
          π_CL_D (ℓ ⊗ₜ[k] c) = c ⊗ₜ[MvPolynomial (Fin m) k] algebraMap L R ℓ := by
        intro ℓ c
        simp [π_CL_D, Algebra.TensorProduct.tmul_mul_tmul]
      have hπ_xC : ∀ j : Fin m,
