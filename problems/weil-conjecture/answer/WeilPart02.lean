          rw [h_den, hδ_loc_mk]
          change algebraMap P_a L (dehom_a (MvPolynomial.X r ^ 1 * MvPolynomial.X a' ^ 1)) =
            algebraMap P_a L (MvPolynomial.X ⟨r, hr⟩) * δ ((MvPolynomial.X a * MvPolynomial.X a') ^ 1)
          rw [pow_one, pow_one, pow_one, hδ_f, map_mul, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_X']
          simp [hr, ha', x_a']
      have hω_am₁ : ω.comp am₁ = (algebraMap P_a L).comp (e a).symm.toRingHom := by
        apply RingHom.ext
        intro z
        calc (ω.comp am₁) z
            = ((ω.comp am₁).comp (e a).toRingHom) ((e a).symm z) :=
                congrArg (ω.comp am₁) ((e a).apply_symm_apply z).symm
          _ = algebraMap P_a L ((e a).symm z) := by rw [hω_am₁_e]
          _ = ((algebraMap P_a L).comp (e a).symm.toRingHom) z := rfl
      have hω_am₂_e : (ω.comp am₂).comp (e a').toRingHom = τ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change ω (am₂ (e a' (MvPolynomial.C c))) = τ (MvPolynomial.C c)
          rw [heC a' c]
          change δ_loc (am₂ ((HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X a'))) ((algebraMap k ↥(𝒜 0)) c))).val = _
          rw [HomogeneousLocalization.awayMap_fromZeroRingHom]
          have hval : ((HomogeneousLocalization.fromZeroRingHom 𝒜 S_aa')
              ((algebraMap k ↥(𝒜 0)) c)).val = Localization.mk (MvPolynomial.C c) 1 := rfl
          rw [hval]
          have h1 := hδ_loc_mk (MvPolynomial.C c) 1
          simp only [Submonoid.coe_one, map_one, mul_one] at h1
          rw [h1]
          change algebraMap P_a L (dehom_a (MvPolynomial.C c)) = τ (MvPolynomial.C c)
          rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
          rfl
        · rintro ⟨r, hr'⟩
          change ω (am₂ (e a' (MvPolynomial.X ⟨r, hr'⟩))) = τ (MvPolynomial.X ⟨r, hr'⟩)
          rw [heX a' r hr']
          have h_mk : HomogeneousLocalization.Away.isLocalizationElem (hX a') (hX r) =
              HomogeneousLocalization.Away.mk 𝒜 (hX a') 1 (MvPolynomial.X r ^ 1)
                (by simpa using hX r) := rfl
          rw [h_mk]
          change δ_loc (am₂ (HomogeneousLocalization.Away.mk 𝒜 (hX a') 1 (MvPolynomial.X r ^ 1) _)).val = _
          rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
          apply hunit_x.mul_right_cancel
          rw [h_den, hδ_loc_mk]
          change algebraMap P_a L (dehom_a (MvPolynomial.X r ^ 1 * MvPolynomial.X a ^ 1)) =
            τ (MvPolynomial.X ⟨r, hr'⟩) * δ ((MvPolynomial.X a * MvPolynomial.X a') ^ 1)
          rw [pow_one, pow_one, pow_one, hδ_f, map_mul]
          dsimp only [dehom_a, τ]
          rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          have h_da : (if h : a = a then (1 : P_a) else MvPolynomial.X ⟨a, h⟩) = 1 := by
            simp only [↓reduceDIte]
          rw [h_da, mul_one]
          by_cases hra : r = a
          · subst hra
            simp only [↓reduceDIte, map_one]
            exact ((mul_comm (IsLocalization.Away.invSelf x_a') (algebraMap P_a L x_a')).trans
              (IsLocalization.Away.mul_invSelf (S := L) x_a')).symm
          · simp only [hra, ↓reduceDIte]
            rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf x_a'),
              IsLocalization.Away.mul_invSelf (S := L) x_a', mul_one]
      have hω_am₂ : ω.comp am₂ = τ.comp (e a').symm.toRingHom := by
        apply RingHom.ext
        intro z
        calc (ω.comp am₂) z
            = ((ω.comp am₂).comp (e a').toRingHom) ((e a').symm z) :=
                congrArg (ω.comp am₂) ((e a').apply_symm_apply z).symm
          _ = τ ((e a').symm z) := by rw [hω_am₂_e]
          _ = (τ.comp (e a').symm.toRingHom) z := rfl
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P_a L)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e a).symm.toRingHom) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e a').symm.toRingHom) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a') (hX a') zero_lt_one
      rw [← AlgebraicGeometry.Spec.map_comp_assoc, ← CommRingCat.ofHom_comp, ← hω_am₁,
        CommRingCat.ofHom_comp am₁ ω, AlgebraicGeometry.Spec.map_comp_assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX a) zero_lt_one (hX a') rfl]
      rw [← AlgebraicGeometry.Spec.map_comp_assoc, ← CommRingCat.ofHom_comp, ← hω_am₂,
        CommRingCat.ofHom_comp am₂ ω, AlgebraicGeometry.Spec.map_comp_assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX a') zero_lt_one (hX a)
          (mul_comm (MvPolynomial.X a) (MvPolynomial.X a'))]

  
  have hProjChart : ∀ (N : ℕ),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let P_N := weilProjectiveSpaceOver k N
      let U_N : Fin (N + 1) → P_N.left.Opens :=
        fun a => (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a) : P_N.left.Opens)
      let hX : ∀ j : Fin (N + 1), (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
        fun j => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k j)
      (⨆ a : Fin (N + 1), U_N a = ⊤) ∧
      ∃ (e : ∀ a : Fin (N + 1),
          MvPolynomial {r : Fin (N + 1) // r ≠ a} k ≃+*
            HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a))
        (iso : ∀ a : Fin (N + 1),
          (U_N a : AlgebraicGeometry.Scheme.{u}) ≅
            AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {r : Fin (N + 1) // r ≠ a} k))),
        (∀ (a : Fin (N + 1)) (c : k),
          e a (MvPolynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X a))
              (algebraMap k ↥(𝒜 0) c)) ∧
        (∀ (a : Fin (N + 1)) (r : Fin (N + 1)) (hr : r ≠ a),
          e a (MvPolynomial.X ⟨r, hr⟩) =
            HomogeneousLocalization.Away.isLocalizationElem (hX a) (hX r)) ∧
        (∀ a : Fin (N + 1),
          (iso a).hom =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one).hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e a).toRingHom)) ∧
        (∀ a : Fin (N + 1),
          (U_N a).ι ≫ P_N.hom =
            (iso a).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
        (∀ a : Fin (N + 1),
          (iso a).inv ≫ ((U_N a).ι ≫ P_N.hom) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
        (∀ (a a' : Fin (N + 1)) (ha' : a' ≠ a),
          ((iso a).inv ≫ (U_N a).ι) ⁻¹ᵁ U_N a' =
            PrimeSpectrum.basicOpen (MvPolynomial.X ⟨a', ha'⟩)) ∧
        (∀ (a a' : Fin (N + 1)) (ha' : a' ≠ a),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap (MvPolynomial {r : Fin (N + 1) // r ≠ a} k)
                (Localization.Away (MvPolynomial.X ⟨a', ha'⟩ :
                  MvPolynomial {r : Fin (N + 1) // r ≠ a} k)))) ≫
              (iso a).inv ≫ (U_N a).ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (MvPolynomial.eval₂Hom
                ((algebraMap (MvPolynomial {r : Fin (N + 1) // r ≠ a} k)
                  (Localization.Away (MvPolynomial.X ⟨a', ha'⟩ :
                    MvPolynomial {r : Fin (N + 1) // r ≠ a} k))).comp MvPolynomial.C)
                (fun r : {r : Fin (N + 1) // r ≠ a'} =>
                  if h : r.1 = a then
                    IsLocalization.Away.invSelf
                      (MvPolynomial.X ⟨a', ha'⟩ : MvPolynomial {r : Fin (N + 1) // r ≠ a} k)
                  else
                    algebraMap (MvPolynomial {r : Fin (N + 1) // r ≠ a} k) _
                      (MvPolynomial.X ⟨r.1, h⟩) *
                    IsLocalization.Away.invSelf
                      (MvPolynomial.X ⟨a', ha'⟩ : MvPolynomial {r : Fin (N + 1) // r ≠ a} k)))) ≫
              (iso a').inv ≫ (U_N a').ι) := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U_raw : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    have hX : ∀ j : Fin (N + 1), (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
      fun j => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k j)
    obtain ⟨hCov, e, heC, heX, hTrans⟩ := hProjStd N
    let iso_raw : ∀ a : Fin (N + 1),
        (U_raw a : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {r : Fin (N + 1) // r ≠ a} k)) :=
      fun a =>
        { hom := (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e a).toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e a).symm.toRingHom) ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one).inv
          hom_inv_id := by
            rw [CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have h1 : (e a).toRingHom.comp (e a).symm.toRingHom = RingHom.id _ :=
              RingHom.ext (e a).apply_symm_apply
            rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
              CategoryTheory.Category.id_comp, CategoryTheory.Iso.hom_inv_id]
          inv_hom_id := by
            rw [CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc (AlgebraicGeometry.Proj.basicOpenIsoSpec _ _ _ _).inv,
              CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp,
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have h1 : (e a).symm.toRingHom.comp (e a).toRingHom = RingHom.id _ :=
              RingHom.ext (e a).symm_apply_apply
            rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    have hiso_inv_ι : ∀ a : Fin (N + 1),
        (iso_raw a).inv ≫ (U_raw a).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e a).symm.toRingHom) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one := by
      intro a
      dsimp [iso_raw, U_raw]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
    have hiso_inv_hom : ∀ a : Fin (N + 1),
        (iso_raw a).inv ≫ ((U_raw a).ι ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      intro a
      rw [← CategoryTheory.Category.assoc (iso_raw a).inv, hiso_inv_ι a,
        CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
      apply RingHom.ext
      intro c
      change (e a).symm ((HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X a))) ((algebraMap k ↥(𝒜 0)) c)) = MvPolynomial.C c
      rw [← heC a c]
      exact (e a).symm_apply_apply (MvPolynomial.C c)
    have hiso_hom : ∀ a : Fin (N + 1),
        (U_raw a).ι ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) =
          (iso_raw a).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
      intro a
      calc (U_raw a).ι ≫ _
          = ((iso_raw a).hom ≫ (iso_raw a).inv) ≫ ((U_raw a).ι ≫ _) := by
              rw [CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
        _ = (iso_raw a).hom ≫ ((iso_raw a).inv ≫ ((U_raw a).ι ≫ _)) := by
              rw [CategoryTheory.Category.assoc]
        _ = (iso_raw a).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
              rw [hiso_inv_hom a]
    have hiso_pre : ∀ (a a' : Fin (N + 1)) (ha' : a' ≠ a),
        ((iso_raw a).inv ≫ (U_raw a).ι) ⁻¹ᵁ U_raw a' =
          PrimeSpectrum.basicOpen (MvPolynomial.X ⟨a', ha'⟩) := by
      intro a a' ha'
      rw [hiso_inv_ι a]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e a).symm.toRingHom) ⁻¹ᵁ
          (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hX a) zero_lt_one ⁻¹ᵁ U_raw a') = _
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX a) zero_lt_one (hX a') zero_lt_one,
        AlgebraicGeometry.SpecMap_preimage_basicOpen]
      congr 1
      change (e a).symm (HomogeneousLocalization.Away.isLocalizationElem (hX a) (hX a')) = _
      rw [← heX a a' ha']
      exact (e a).symm_apply_apply _
    have hiso_trans : ∀ (a a' : Fin (N + 1)) (ha' : a' ≠ a),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (MvPolynomial {r : Fin (N + 1) // r ≠ a} k)
              (Localization.Away (MvPolynomial.X ⟨a', ha'⟩ :
                MvPolynomial {r : Fin (N + 1) // r ≠ a} k)))) ≫
            (iso_raw a).inv ≫ (U_raw a).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (MvPolynomial.eval₂Hom
              ((algebraMap (MvPolynomial {r : Fin (N + 1) // r ≠ a} k)
                (Localization.Away (MvPolynomial.X ⟨a', ha'⟩ :
                  MvPolynomial {r : Fin (N + 1) // r ≠ a} k))).comp MvPolynomial.C)
              (fun r : {r : Fin (N + 1) // r ≠ a'} =>
                if h : r.1 = a then
                  IsLocalization.Away.invSelf
                    (MvPolynomial.X ⟨a', ha'⟩ : MvPolynomial {r : Fin (N + 1) // r ≠ a} k)
                else
                  algebraMap (MvPolynomial {r : Fin (N + 1) // r ≠ a} k) _
                    (MvPolynomial.X ⟨r.1, h⟩) *
                  IsLocalization.Away.invSelf
                    (MvPolynomial.X ⟨a', ha'⟩ : MvPolynomial {r : Fin (N + 1) // r ≠ a} k)))) ≫
            (iso_raw a').inv ≫ (U_raw a').ι := by
      intro a a' ha'
      rw [hiso_inv_ι a, hiso_inv_ι a']
      exact hTrans a a' ha'
    exact ⟨hCov, e, iso_raw, heC, heX, fun _ => rfl, hiso_hom, hiso_inv_hom, hiso_pre, hiso_trans⟩

  
  let P_amb := weilProjectiveSpaceOver k (m + 1)
  let B₀ := weilProjectiveSpaceOver k m
  let P₁ := weilProjectiveSpaceOver k 1
  let U_proj := weilProjCenterComplOpen k m

  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
  let 𝒜_m := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
  let 𝒜_m1 := MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k
  let instGA_1 : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
  let instGA_m : GradedAlgebra 𝒜_m := MvPolynomial.gradedAlgebra
  let instGA_m1 : GradedAlgebra 𝒜_m1 := MvPolynomial.gradedAlgebra

  let U_1 : Fin (1 + 1) → P₁.left.Opens :=
    fun a => (AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X a) : P₁.left.Opens)
  let U_m : Fin (m + 1) → B₀.left.Opens :=
    fun a => (AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X a) : B₀.left.Opens)
  let U_m1 : Fin (m + 1 + 1) → P_amb.left.Opens :=
    fun a => (AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X a) : P_amb.left.Opens)

  obtain ⟨hCov_1, _, iso_1, _, _, _, hiso_1_hom, hiso_1_inv_hom, hiso_1_pre, hiso_1_trans⟩ := hProjChart 1
  obtain ⟨_, e_m, iso_m, heC_m, heX_m, hiso_m_hom_def, hiso_m_hom, _, _, _⟩ := hProjChart m
  obtain ⟨hCov_m1, e_m1, iso_m1, heC_m1, heX_m1, hiso_m1_hom_def, hiso_m1_hom, hiso_m1_inv_hom, hiso_m1_pre, hiso_m1_trans⟩ :=
    hProjChart (m + 1)

  let D₀_b : B₀.left.Opens := U_m b
  let D₁_b : P_amb.left.Opens := U_m1 b.castSucc
  let R_b := MvPolynomial {j : Fin (m + 1) // j ≠ b} k
  let S_b := AlgebraicGeometry.Spec (CommRingCat.of R_b)
  let π_Rb : S_b ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_b))
  let e_D₀ : (D₀_b : AlgebraicGeometry.Scheme.{u}) ≅ S_b := iso_m b
  have hD₀_hom : D₀_b.ι ≫ B₀.hom = e_D₀.hom ≫ π_Rb := hiso_m_hom b

  let Q := CategoryTheory.Limits.pullback P_amb.hom B₀.hom
  let γ : (U_proj : AlgebraicGeometry.Scheme.{u}) ⟶ Q :=
    CategoryTheory.Limits.pullback.lift U_proj.ι pr_p₀ hg
  let Q_b : Q.Opens := (CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ⁻¹ᵁ D₀_b
  let E_b := CategoryTheory.Limits.pullback (D₀_b.ι ≫ B₀.hom) P₁.hom

  
  obtain ⟨_, hdeg_pr, hPr_b_all⟩ := hPr
  obtain ⟨h_pre_b, hsub_b, h_le_b_raw, hb₀_pr, hb₁_pr, hpos_pr, h_chart_b⟩ := hPr_b_all b
  have h_le_b : D₁_b ≤ U_proj := h_le_b_raw

  let j_γ : ((γ ⁻¹ᵁ Q_b) : AlgebraicGeometry.Scheme.{u}) ⟶ P_amb.left :=
    (γ ⁻¹ᵁ Q_b).ι ≫ U_proj.ι
  have hj_γ_range : Set.range j_γ.base = Set.range D₁_b.ι.base := by
    rw [D₁_b.range_ι]
    ext y
    constructor
    · rintro ⟨v, rfl⟩
      have hv_Qb : γ.base v.1 ∈ Q_b := v.2
      have hv_D₀ : pr_p₀.base v.1 ∈ D₀_b := by
        have h1 : (γ ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom).base v.1 ∈ D₀_b := hv_Qb
        rwa [CategoryTheory.Limits.pullback.lift_snd] at h1
      have hv_D₁ : v.1.1 ∈ D₁_b := (h_pre_b v.1).mp hv_D₀
      exact hv_D₁
    · intro hy
      have hyU : y ∈ U_proj := h_le_b hy
      let u : ↥U_proj := ⟨y, hyU⟩
      have hu_D₀ : pr_p₀.base u ∈ D₀_b := (h_pre_b u).mpr hy
      have hu_Qb : u ∈ γ ⁻¹ᵁ Q_b := by
        change (γ ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom).base u ∈ D₀_b
        rwa [CategoryTheory.Limits.pullback.lift_snd]
      exact ⟨⟨u, hu_Qb⟩, rfl⟩
  let e_γ : ((γ ⁻¹ᵁ Q_b) : AlgebraicGeometry.Scheme.{u}) ≅ (D₁_b : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq j_γ D₁_b.ι hj_γ_range
  have he_γ_inv_j : e_γ.inv ≫ j_γ = D₁_b.ι :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac j_γ D₁_b.ι hj_γ_range
  have he_γ_homOfLE : e_γ.inv ≫ (γ ⁻¹ᵁ Q_b).ι = P_amb.left.homOfLE h_le_b := by
    rw [← CategoryTheory.cancel_mono U_proj.ι, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.homOfLE_ι]
    exact he_γ_inv_j

  have hγ_fst :
      e_γ.inv ≫ (γ ∣_ Q_b) ≫ Q_b.ι ≫ CategoryTheory.Limits.pullback.fst P_amb.hom B₀.hom =
        D₁_b.ι := by
    rw [← CategoryTheory.Category.assoc (γ ∣_ Q_b), AlgebraicGeometry.morphismRestrict_ι,
      CategoryTheory.Category.assoc (γ ⁻¹ᵁ Q_b).ι, CategoryTheory.Limits.pullback.lift_fst]
    exact he_γ_inv_j

  let ι_Rb : R_b →+* MvPolynomial {r : Fin (m + 1 + 1) // r ≠ b.castSucc} k :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (fun j => MvPolynomial.X ⟨j.1.castSucc, fun h => j.2 (Fin.castSucc_inj.mp h)⟩)

  have hγ_snd :
      e_γ.inv ≫ (γ ∣_ Q_b) ≫ ((CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ∣_ D₀_b) ≫
        e_D₀.hom =
        (iso_m1 b.castSucc).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_Rb) := by
    let g_pr : 𝒜_m →+*ᵍ 𝒜_m1 :=
      { toRingHom := (MvPolynomial.rename Fin.castSucc).toRingHom, map_mem := @hdeg_pr }
    have hsub_b' : Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin (m + 1)) k) ≤
        Submonoid.comap g_pr (Submonoid.powers (MvPolynomial.X b.castSucc)) := hsub_b
    let mid_raw :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X b.castSucc) hb₁_pr zero_lt_one).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map g_pr hsub_b')) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) hb₀_pr zero_lt_one).inv
    let mid_map : (D₁_b : AlgebraicGeometry.Scheme.{u}) ⟶ (D₀_b : AlgebraicGeometry.Scheme.{u}) :=
      mid_raw
    have h1 : e_γ.inv ≫ (γ ∣_ Q_b) ≫ ((CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ∣_ D₀_b) =
        mid_map := by
      rw [← CategoryTheory.cancel_mono D₀_b.ι]
      calc (e_γ.inv ≫ (γ ∣_ Q_b) ≫ ((CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ∣_ D₀_b)) ≫ D₀_b.ι
          = e_γ.inv ≫ (γ ∣_ Q_b) ≫ (((CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) ∣_ D₀_b) ≫ D₀_b.ι) := by
              simp only [CategoryTheory.Category.assoc]
        _ = e_γ.inv ≫ ((γ ∣_ Q_b) ≫ Q_b.ι) ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom := by
              rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        _ = e_γ.inv ≫ (γ ⁻¹ᵁ Q_b).ι ≫ (γ ≫ CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom) := by
              rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        _ = (e_γ.inv ≫ (γ ⁻¹ᵁ Q_b).ι) ≫ pr_p₀ := by
              rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
        _ = P_amb.left.homOfLE h_le_b ≫ pr_p₀ := by rw [he_γ_homOfLE]
        _ = mid_map ≫ D₀_b.ι := by
              change P_amb.left.homOfLE h_le_b_raw ≫ pr_p₀ = _
              rw [h_chart_b]
              rfl
    have h_ring_eq : (HomogeneousLocalization.map g_pr hsub_b').comp (e_m b).toRingHom =
        (e_m1 b.castSucc).toRingHom.comp ι_Rb := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
        dsimp only [ι_Rb]
        rw [MvPolynomial.eval₂Hom_C, heC_m1 b.castSucc c, heC_m b c]
        apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X b.castSucc))
        change (HomogeneousLocalization.map g_pr hsub_b'
          (HomogeneousLocalization.mk ⟨0, ⟨MvPolynomial.C c, _⟩, 1, _⟩)).val =
          Localization.mk (MvPolynomial.C c) 1
        rw [HomogeneousLocalization.map_mk]
        exact congrArg₂ Localization.mk (MvPolynomial.rename_C Fin.castSucc c) (Subtype.ext (map_one _))
      · intro j
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
        dsimp only [ι_Rb]
        rw [MvPolynomial.eval₂Hom_X']
        have hj_ne : j.1.castSucc ≠ b.castSucc := fun h => j.2 (Fin.castSucc_inj.mp h)
        rw [heX_m1 b.castSucc j.1.castSucc hj_ne, heX_m b j.1 j.2]
        apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X b.castSucc))
        change (HomogeneousLocalization.map g_pr hsub_b'
          (HomogeneousLocalization.mk ⟨1, ⟨MvPolynomial.X j.1 ^ 1, _⟩,
            ⟨MvPolynomial.X b ^ 1, _⟩, _⟩)).val =
          Localization.mk (MvPolynomial.X j.1.castSucc ^ 1) ⟨MvPolynomial.X b.castSucc ^ 1, _⟩
        rw [HomogeneousLocalization.map_mk]
        refine congrArg₂ Localization.mk ?_ (Subtype.ext ?_)
        · simp [g_pr, MvPolynomial.rename_X]
        · simp [g_pr, MvPolynomial.rename_X]
    have h_raw_comp : mid_raw ≫
        ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) hb₀_pr zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_m b).toRingHom)) =
        ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X b.castSucc) hb₁_pr zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e_m1 b.castSucc).toRingHom)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_Rb) := by
      dsimp only [mid_raw]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) hb₀_pr zero_lt_one).inv,
        CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, h_ring_eq]
    have h_mid_e : mid_map ≫ e_D₀.hom =
        (iso_m1 b.castSucc).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_Rb) := by
      have hm_def := hiso_m_hom_def b
      have hm1_def := hiso_m1_hom_def b.castSucc
      exact (congrArg (fun f : (D₀_b : AlgebraicGeometry.Scheme.{u}) ⟶ S_b => mid_map ≫ f) hm_def).trans
        (h_raw_comp.trans
          (congrArg (fun f : (D₁_b : AlgebraicGeometry.Scheme.{u}) ⟶ _ =>
            f ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_Rb)) hm1_def.symm))
    rw [← CategoryTheory.Category.assoc (γ ∣_ Q_b), ← CategoryTheory.Category.assoc e_γ.inv, h1]
    exact h_mid_e

  
  let ℓ : Fin (m + 1 + 1) := Fin.last (m + 1)
  let ev0_ℓ : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ ℓ} k →+* k := MvPolynomial.eval 0
  let p₀_b : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P_amb.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_ℓ) ≫
      (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι
  have hp₀_hom : p₀_b ≫ P_amb.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_ℓ) ≫
        (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ≫ P_amb.hom = _
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      hiso_m1_inv_hom ℓ, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h1 : ev0_ℓ.comp MvPolynomial.C = RingHom.id k := by
      apply RingHom.ext
      intro c
      exact MvPolynomial.eval_C c
    rw [h1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  have hp₀_range : Set.range p₀_b.base ⊆ ((U_proj : Set P_amb.left)ᶜ) := by
    rintro _ ⟨x, rfl⟩ hxU
    have hxU' : p₀_b.base x ∈ U_proj := hxU
    obtain ⟨i, hxi⟩ := TopologicalSpace.Opens.mem_iSup.mp hxU'
    have hi_ne : i.castSucc ≠ ℓ := Fin.castSucc_ne_last i
    let x_i : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ ℓ} k := MvPolynomial.X ⟨i.castSucc, hi_ne⟩
    have hpre_i : p₀_b ⁻¹ᵁ U_m1 i.castSucc = PrimeSpectrum.basicOpen (ev0_ℓ x_i) := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_ℓ) ⁻¹ᵁ
          (((iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ⁻¹ᵁ U_m1 i.castSucc) = _
      rw [hiso_m1_pre ℓ i.castSucc hi_ne, AlgebraicGeometry.SpecMap_preimage_basicOpen]
      rfl
    have hx_bo : x ∈ PrimeSpectrum.basicOpen (ev0_ℓ x_i) := by
      have hx_pre : x ∈ p₀_b ⁻¹ᵁ U_m1 i.castSucc := hxi
      rwa [hpre_i] at hx_pre
    have hev_xi : ev0_ℓ x_i = 0 := MvPolynomial.eval_X _
    rw [hev_xi] at hx_bo
    exact hx_bo (zero_mem x.asIdeal)

  
  have hPullChart : ∀ (σ : Type) (X : AlgebraicGeometry.Scheme.{u})
      (f_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (U : X.Opens)
      (e_U : (U : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ k))),
      U.ι ≫ f_X = e_U.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) →
      ∃ (e_W : (((CategoryTheory.Limits.pullback.snd π_Rb f_X) ⁻¹ᵁ U) :
            AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R_b))),
        (e_W.inv ≫ ((CategoryTheory.Limits.pullback.snd π_Rb f_X) ⁻¹ᵁ U).ι ≫
          CategoryTheory.Limits.pullback.fst π_Rb f_X =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
        (e_W.inv ≫ ((CategoryTheory.Limits.pullback.snd π_Rb f_X) ⁻¹ᵁ U).ι ≫
          CategoryTheory.Limits.pullback.snd π_Rb f_X =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
            e_U.inv ≫ U.ι) := by
    intro σ X f_X U e_U he_U
    let T := MvPolynomial σ k
    let π_T : AlgebraicGeometry.Spec (CommRingCat.of T) ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k T))
    let fst_pb := CategoryTheory.Limits.pullback.fst π_Rb f_X
    let snd_pb := CategoryTheory.Limits.pullback.snd π_Rb f_X
    let W : (CategoryTheory.Limits.pullback π_Rb f_X).Opens := snd_pb ⁻¹ᵁ U
    have hTop : CategoryTheory.IsPullback (snd_pb ∣_ U) W.ι U.ι snd_pb :=
      AlgebraicGeometry.isPullback_morphismRestrict snd_pb U
    have hBase : CategoryTheory.IsPullback snd_pb fst_pb f_X π_Rb :=
      (CategoryTheory.IsPullback.of_hasPullback π_Rb f_X).flip
    have hSq : CategoryTheory.IsPullback (W.ι ≫ fst_pb) (snd_pb ∣_ U) π_Rb (U.ι ≫ f_X) :=
      (hTop.paste_vert hBase).flip
    have hu_cond : (W.ι ≫ fst_pb) ≫ π_Rb = ((snd_pb ∣_ U) ≫ e_U.hom) ≫ π_T := by
      rw [hSq.w, he_U, CategoryTheory.Category.assoc]
      rfl
    have hv_cond : CategoryTheory.Limits.pullback.fst π_Rb π_T ≫ π_Rb =
        (CategoryTheory.Limits.pullback.snd π_Rb π_T ≫ e_U.inv) ≫ (U.ι ≫ f_X) := by
      rw [he_U, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_U.inv, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.id_comp]
      exact CategoryTheory.Limits.pullback.condition
    let iso_pb : (W : AlgebraicGeometry.Scheme.{u}) ≅ CategoryTheory.Limits.pullback π_Rb π_T :=
      { hom := CategoryTheory.Limits.pullback.lift (W.ι ≫ fst_pb) ((snd_pb ∣_ U) ≫ e_U.hom) hu_cond
        inv := hSq.lift (CategoryTheory.Limits.pullback.fst π_Rb π_T)
          (CategoryTheory.Limits.pullback.snd π_Rb π_T ≫ e_U.inv) hv_cond
        hom_inv_id := by
          apply hSq.hom_ext
          · rw [CategoryTheory.Category.assoc, hSq.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, hSq.lift_snd,
              ← CategoryTheory.Category.assoc _ _ e_U.inv, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hSq.lift_fst, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc _ _ e_U.hom, hSq.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    let e_alg : TensorProduct k R_b T ≃ₐ[R_b] MvPolynomial σ R_b :=
      MvPolynomial.algebraTensorAlgEquiv k R_b
    let e_spec : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k R_b T)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial σ R_b)) :=
      (AlgebraicGeometry.Scheme.Spec.mapIso e_alg.toRingEquiv.toCommRingCatIso.op).symm
    let e_W := iso_pb ≪≫ AlgebraicGeometry.pullbackSpecIso k R_b T ≪≫ e_spec
    have he_spec_inv : e_spec.inv =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingEquiv.toRingHom) := rfl
    refine ⟨e_W, ?_, ?_⟩
    · change e_spec.inv ≫ (AlgebraicGeometry.pullbackSpecIso k R_b T).inv ≫
          (iso_pb.inv ≫ W.ι ≫ fst_pb) = _
      have hiso_fst : iso_pb.inv ≫ W.ι ≫ fst_pb = CategoryTheory.Limits.pullback.fst π_Rb π_T :=
        hSq.lift_fst _ _ _
      rw [hiso_fst]
      dsimp only [π_Rb, π_T]
      rw [he_spec_inv, AlgebraicGeometry.pullbackSpecIso_inv_fst,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
      apply RingHom.ext
      intro r
      exact e_alg.commutes r
    · change e_spec.inv ≫ (AlgebraicGeometry.pullbackSpecIso k R_b T).inv ≫
          (iso_pb.inv ≫ W.ι ≫ snd_pb) = _
      have hiso_snd : iso_pb.inv ≫ W.ι ≫ snd_pb =
          CategoryTheory.Limits.pullback.snd π_Rb π_T ≫ e_U.inv ≫ U.ι := by
        rw [← AlgebraicGeometry.morphismRestrict_ι snd_pb U,
          ← CategoryTheory.Category.assoc iso_pb.inv, hSq.lift_snd,
          CategoryTheory.Category.assoc]
      rw [hiso_snd]
      dsimp only [π_Rb, π_T]
      rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso k R_b T).inv,
        ← CategoryTheory.Category.assoc e_spec.inv]
      have h_right : e_spec.inv ≫ (AlgebraicGeometry.pullbackSpecIso k R_b T).inv ≫
          CategoryTheory.Limits.pullback.snd
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_b)))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k T))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) := by
        rw [he_spec_inv, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
        apply RingHom.ext
        intro p
        change e_alg (1 ⊗ₜ[k] p) = MvPolynomial.map (algebraMap k R_b) p
        rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
      rw [h_right]

  have hLocChart : ∀ {C : Type u} [CommRing C] (f : C)
      {E : AlgebraicGeometry.Scheme.{u}} (W W' : E.Opens)
      (hle : W' ≤ W)
      (e_W : (W : AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec (CommRingCat.of C)),
      (e_W.inv ≫ W.ι) ⁻¹ᵁ W' = PrimeSpectrum.basicOpen f →
      ∃ (e_loc : (W' : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f))),
        e_loc.inv ≫ W'.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away f))) ≫
            e_W.inv ≫ W.ι := by
    intro C _ f E W W' hle e_W hpre
    let locMap : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of C) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away f)))
    let j_loc := locMap ≫ e_W.inv ≫ W.ι
    have hrange_loc : Set.range locMap.base = (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum C)) :=
      PrimeSpectrum.localization_away_comap_range (Localization.Away f) f
    have hrange_eq : Set.range W'.ι.base = Set.range j_loc.base := by
      rw [W'.range_ι]
      ext z
      constructor
      · intro hz'
        have hzW : z ∈ W := hle hz'
        let q₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of C)) := e_W.hom.base ⟨z, hzW⟩
        have hq₀_z : (e_W.inv ≫ W.ι).base q₀ = z := by
          change W.ι.base ((e_W.hom ≫ e_W.inv).base ⟨z, hzW⟩) = z
          rw [CategoryTheory.Iso.hom_inv_id]
          exact AlgebraicGeometry.Scheme.Opens.ι_apply W ⟨z, hzW⟩
        have hq₀_W' : q₀ ∈ (e_W.inv ≫ W.ι) ⁻¹ᵁ W' := by
          change (e_W.inv ≫ W.ι).base q₀ ∈ W'
          rwa [hq₀_z]
        rw [hpre] at hq₀_W'
        have hq₀_range : q₀ ∈ Set.range locMap.base := by
          rw [hrange_loc]
          exact hq₀_W'
        obtain ⟨w, hw⟩ := hq₀_range
        refine ⟨w, ?_⟩
        change (e_W.inv ≫ W.ι).base (locMap.base w) = z
        rw [hw, hq₀_z]
      · rintro ⟨w, rfl⟩
        have hw_bo : locMap.base w ∈ PrimeSpectrum.basicOpen f := by
          have hmem : locMap.base w ∈ Set.range locMap.base := ⟨w, rfl⟩
          rwa [hrange_loc] at hmem
        have hw_pre : locMap.base w ∈ (e_W.inv ≫ W.ι) ⁻¹ᵁ W' := by
          rwa [hpre]
        exact hw_pre
    exact ⟨AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq W'.ι j_loc hrange_eq,
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac W'.ι j_loc hrange_eq⟩

  
  let E'_b := CategoryTheory.Limits.pullback π_Rb P₁.hom
  let Q'_b := CategoryTheory.Limits.pullback π_Rb P_amb.hom
  let fst_E' := CategoryTheory.Limits.pullback.fst π_Rb P₁.hom
  let snd_E' := CategoryTheory.Limits.pullback.snd π_Rb P₁.hom
  let fst_Q' := CategoryTheory.Limits.pullback.fst π_Rb P_amb.hom
  let snd_Q' := CategoryTheory.Limits.pullback.snd π_Rb P_amb.hom

  let A₀ := MvPolynomial {r : Fin (1 + 1) // r ≠ 0} R_b
  let A₁ := MvPolynomial {r : Fin (1 + 1) // r ≠ 1} R_b
  let V'₀ : E'_b.Opens := snd_E' ⁻¹ᵁ U_1 0
  let V'₁ : E'_b.Opens := snd_E' ⁻¹ᵁ U_1 1

  obtain ⟨e_V₀, he_V₀_fst, he_V₀_snd⟩ := hPullChart {r : Fin (1 + 1) // r ≠ 0} P₁.left P₁.hom (U_1 0)
    (iso_1 0) (hiso_1_hom 0)
  obtain ⟨e_V₁, he_V₁_fst, he_V₁_snd⟩ := hPullChart {r : Fin (1 + 1) // r ≠ 1} P₁.left P₁.hom (U_1 1)
    (iso_1 1) (hiso_1_hom 1)

  have hcov_V' : V'₀ ⊔ V'₁ = ⊤ := by
    ext z
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hz_top : snd_E'.base z ∈ (⊤ : P₁.left.Opens) := trivial
    have hCov_1' : ⨆ a : Fin (1 + 1), U_1 a = ⊤ := hCov_1
    rw [← hCov_1', TopologicalSpace.Opens.mem_iSup] at hz_top
    obtain ⟨⟨c, hc⟩, hzc⟩ := hz_top
    interval_cases c
    · exact Or.inl hzc
    · exact Or.inr hzc

  let idx₁ : {r : Fin (1 + 1) // r ≠ 0} := ⟨1, by decide⟩
  let idx₀ : {r : Fin (1 + 1) // r ≠ 1} := ⟨0, by decide⟩
  have h_idx₁ : ∀ r : {r : Fin (1 + 1) // r ≠ 0}, r = idx₁ := by
    rintro ⟨⟨r, hr_lt⟩, hr_ne⟩
    interval_cases r
    · exact absurd rfl hr_ne
    · rfl
  have h_idx₀ : ∀ r : {r : Fin (1 + 1) // r ≠ 1}, r = idx₀ := by
    rintro ⟨⟨r, hr_lt⟩, hr_ne⟩
    interval_cases r
    · rfl
    · exact absurd rfl hr_ne

  let s₁ : A₀ := MvPolynomial.X idx₁
  let s₀ : A₁ := MvPolynomial.X idx₀

  have hpre_V₀_V₁ : (e_V₀.inv ≫ V'₀.ι) ⁻¹ᵁ V'₁ = PrimeSpectrum.basicOpen s₁ := by
    change (e_V₀.inv ≫ V'₀.ι ≫ snd_E') ⁻¹ᵁ U_1 1 = PrimeSpectrum.basicOpen s₁
    rw [he_V₀_snd]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ⁻¹ᵁ
        (((iso_1 0).inv ≫ (U_1 0).ι) ⁻¹ᵁ U_1 1) = _
    rw [hiso_1_pre 0 1 (by decide), AlgebraicGeometry.SpecMap_preimage_basicOpen]
    congr 1
    exact MvPolynomial.map_X MvPolynomial.C idx₁

  have hpre_V₁_V₀ : (e_V₁.inv ≫ V'₁.ι) ⁻¹ᵁ V'₀ = PrimeSpectrum.basicOpen s₀ := by
    change (e_V₁.inv ≫ V'₁.ι ≫ snd_E') ⁻¹ᵁ U_1 0 = PrimeSpectrum.basicOpen s₀
    rw [he_V₁_snd]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ⁻¹ᵁ
        (((iso_1 1).inv ≫ (U_1 1).ι) ⁻¹ᵁ U_1 0) = _
    rw [hiso_1_pre 1 0 (by decide), AlgebraicGeometry.SpecMap_preimage_basicOpen]
    congr 1
    exact MvPolynomial.map_X MvPolynomial.C idx₀

  have hpre_V₀_inter : (e_V₀.inv ≫ V'₀.ι) ⁻¹ᵁ (V'₀ ⊓ V'₁) = PrimeSpectrum.basicOpen s₁ := by
    ext q
    change ((e_V₀.inv ≫ V'₀.ι).base q ∈ V'₀ ∧ (e_V₀.inv ≫ V'₀.ι).base q ∈ V'₁) ↔
      q ∈ PrimeSpectrum.basicOpen s₁
    have hq_V₀ : (e_V₀.inv ≫ V'₀.ι).base q ∈ V'₀ := (e_V₀.inv.base q).2
    rw [← hpre_V₀_V₁]
    exact ⟨fun h => h.2, fun h => ⟨hq_V₀, h⟩⟩

  have hne_V' : Nonempty ↥(V'₀ ⊓ V'₁ : E'_b.Opens) := by
    let ev_pt : A₀ →+* k := MvPolynomial.eval₂Hom (MvPolynomial.eval 0) (fun _ => 1)
    let pt₀ : PrimeSpectrum k := ⊥
    let q_pt := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_pt)).base pt₀
    have hq_bo : q_pt ∈ PrimeSpectrum.basicOpen s₁ := by
      change ev_pt s₁ ∉ pt₀.asIdeal
      have hev_s₁ : ev_pt s₁ = 1 := by
        dsimp only [ev_pt, s₁]
        rw [MvPolynomial.eval₂Hom_X']
      rw [hev_s₁]
      exact pt₀.isPrime.one_notMem
    rw [← hpre_V₀_inter] at hq_bo
    exact ⟨⟨(e_V₀.inv ≫ V'₀.ι).base q_pt, hq_bo⟩⟩

  obtain ⟨e_ov, he_ov_inv⟩ := hLocChart s₁ V'₀ (V'₀ ⊓ V'₁) inf_le_left e_V₀ hpre_V₀_inter

  
  let τ_P1 : A₁ →+* Localization.Away s₁ :=
    MvPolynomial.eval₂Hom ((algebraMap A₀ (Localization.Away s₁)).comp MvPolynomial.C)
      (fun _ => IsLocalization.Away.invSelf s₁)
  have hτ_P1_C : ∀ r : R_b,
      τ_P1 (MvPolynomial.C r) = algebraMap A₀ (Localization.Away s₁) (MvPolynomial.C r) := by
    intro r
    dsimp only [τ_P1]
    rw [MvPolynomial.eval₂Hom_C]
    rfl
  have hτ_P1_X : ∀ r : {r : Fin (1 + 1) // r ≠ 1},
      τ_P1 (MvPolynomial.X r) = IsLocalization.Away.invSelf s₁ := by
    intro r
    dsimp only [τ_P1]
    rw [MvPolynomial.eval₂Hom_X']

  have he_ov_V₁ : e_ov.inv ≫ (V'₀ ⊓ V'₁).ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_P1) ≫ e_V₁.inv ≫ V'₁.ι := by
    rw [he_ov_inv]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_V₀_fst,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_V₁_fst,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
      apply RingHom.ext
      intro r
      rw [RingHom.comp_apply, RingHom.comp_apply, hτ_P1_C]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_V₀_snd,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_V₁_snd]
      let x₁_k : MvPolynomial {r : Fin (1 + 1) // r ≠ 0} k := MvPolynomial.X idx₁
      let g_k : MvPolynomial {r : Fin (1 + 1) // r ≠ 0} k →+* Localization.Away s₁ :=
        (algebraMap A₀ (Localization.Away s₁)).comp (MvPolynomial.map MvPolynomial.C)
      have hg_x₁ : g_k x₁_k = algebraMap A₀ (Localization.Away s₁) s₁ := by
        change algebraMap A₀ _ (MvPolynomial.map MvPolynomial.C (MvPolynomial.X idx₁)) = _
        rw [MvPolynomial.map_X]
      obtain ⟨lift_k, hg_fac, hlift_eq, hlift_inv⟩ := hAwayLift x₁_k s₁ g_k hg_x₁
      rw [← AlgebraicGeometry.Spec.map_comp_assoc, ← CommRingCat.ofHom_comp]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_k) ≫ (iso_1 0).inv ≫ (U_1 0).ι = _
      rw [hg_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp_assoc,
        hiso_1_trans 0 1 (by decide), ← AlgebraicGeometry.Spec.map_comp_assoc,
        ← AlgebraicGeometry.Spec.map_comp_assoc, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp]
      refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        (iso_1 1).inv ≫ (U_1 1).ι) ?_
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply]
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hlift_eq,
          RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.map_C, hτ_P1_C]
      · intro r
        rw [h_idx₀ r]
        simp only [RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        change lift_k (if h : (0 : Fin (1 + 1)) = 0 then IsLocalization.Away.invSelf x₁_k else _) =
          τ_P1 (MvPolynomial.X idx₀)
        simp only [↓reduceDIte]
        rw [hlift_inv, hτ_P1_X]

  
  let P_amb_b := MvPolynomial {r : Fin (m + 1 + 1) // r ≠ b.castSucc} k
  let P_amb_ℓ := MvPolynomial {r : Fin (m + 1 + 1) // r ≠ ℓ} k

  let u_θ₀ : {r : Fin (m + 1 + 1) // r ≠ b.castSucc} → A₀ :=
    fun r => Fin.lastCases
      (motive := fun x => x ≠ b.castSucc → A₀)
      (fun _ => s₁)
      (fun j hj => MvPolynomial.C (MvPolynomial.X ⟨j, fun h => hj (congrArg Fin.castSucc h)⟩))
      r.1 r.2
  let θ₀ : P_amb_b →+* A₀ :=
    MvPolynomial.eval₂Hom (MvPolynomial.C.comp MvPolynomial.C) u_θ₀
  let θ₀_inv : A₀ →+* P_amb_b :=
    MvPolynomial.eval₂Hom ι_Rb (fun _ => MvPolynomial.X ⟨ℓ, (Fin.castSucc_ne_last b).symm⟩)

  have hθ₀_C : ∀ c : k, θ₀ (MvPolynomial.C c) = MvPolynomial.C (MvPolynomial.C c) := by
    intro c
    dsimp only [θ₀]
    rw [MvPolynomial.eval₂Hom_C]
    rfl
  have hθ₀_ℓ : ∀ h : ℓ ≠ b.castSucc, θ₀ (MvPolynomial.X ⟨ℓ, h⟩) = s₁ := by
    intro h
    dsimp only [θ₀]
    rw [MvPolynomial.eval₂Hom_X']
    dsimp only [u_θ₀, ℓ]
    rw [Fin.lastCases_last]
  have hθ₀_cast : ∀ (j : Fin (m + 1)) (h : j.castSucc ≠ b.castSucc) (hj : j ≠ b),
      θ₀ (MvPolynomial.X ⟨j.castSucc, h⟩) = MvPolynomial.C (MvPolynomial.X ⟨j, hj⟩) := by
    intro j h _
    dsimp only [θ₀]
    rw [MvPolynomial.eval₂Hom_X']
    dsimp only [u_θ₀]
    rw [Fin.lastCases_castSucc]
  have hθ₀_inv_C : ∀ p : R_b, θ₀_inv (MvPolynomial.C p) = ι_Rb p := by
    intro p
    dsimp only [θ₀_inv]
    rw [MvPolynomial.eval₂Hom_C]
  have hθ₀_inv_X : ∀ r : {r : Fin (1 + 1) // r ≠ 0},
      θ₀_inv (MvPolynomial.X r) = MvPolynomial.X ⟨ℓ, (Fin.castSucc_ne_last b).symm⟩ := by
    intro r
    dsimp only [θ₀_inv]
    rw [MvPolynomial.eval₂Hom_X']
  have hι_Rb_C : ∀ c : k, ι_Rb (MvPolynomial.C c) = MvPolynomial.C c := by
    intro c
    dsimp only [ι_Rb]
    rw [MvPolynomial.eval₂Hom_C]
  have hι_Rb_X : ∀ j : {j : Fin (m + 1) // j ≠ b},
      ι_Rb (MvPolynomial.X j) =
        MvPolynomial.X ⟨j.1.castSucc, fun h => j.2 (Fin.castSucc_inj.mp h)⟩ := by
    intro j
    dsimp only [ι_Rb]
    rw [MvPolynomial.eval₂Hom_X']

  have hθ₀_left : θ₀_inv.comp θ₀ = RingHom.id P_amb_b := by
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      simp only [RingHom.comp_apply]
      rw [hθ₀_C, hθ₀_inv_C, hι_Rb_C]
      rfl
    · rintro ⟨r, hr⟩
      simp only [RingHom.comp_apply]
      revert hr
      refine Fin.lastCases (fun hr => ?_) (fun j hr => ?_) r
      · rw [hθ₀_ℓ hr, hθ₀_inv_X]
        rfl
      · have hj : j ≠ b := fun h => hr (congrArg Fin.castSucc h)
        rw [hθ₀_cast j hr hj, hθ₀_inv_C, hι_Rb_X]
        rfl

  have hθ₀_right : θ₀.comp θ₀_inv = RingHom.id A₀ := by
    apply MvPolynomial.ringHom_ext'
    · apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply]
        change θ₀ (θ₀_inv (MvPolynomial.C (MvPolynomial.C c))) = _
        rw [hθ₀_inv_C, hι_Rb_C, hθ₀_C]
        rfl
      · intro j
        simp only [RingHom.comp_apply]
        change θ₀ (θ₀_inv (MvPolynomial.C (MvPolynomial.X j))) = _
        rw [hθ₀_inv_C, hι_Rb_X,
          hθ₀_cast j.1 (fun h => j.2 (Fin.castSucc_inj.mp h)) j.2]
        rfl
    · intro r
      rw [h_idx₁ r]
      simp only [RingHom.comp_apply]
      rw [hθ₀_inv_X, hθ₀_ℓ]
      rfl

  let u_θ₁ : {r : Fin (m + 1 + 1) // r ≠ ℓ} → A₁ :=
    fun r => Fin.lastCases
      (motive := fun x => x ≠ ℓ → A₁)
      (fun h => absurd rfl h)
      (fun j _ => if hj : j = b then s₀ else MvPolynomial.C (MvPolynomial.X ⟨j, hj⟩) * s₀)
      r.1 r.2
  let θ₁ : P_amb_ℓ →+* A₁ :=
    MvPolynomial.eval₂Hom (MvPolynomial.C.comp MvPolynomial.C) u_θ₁

  have hθ₁_C : ∀ c : k, θ₁ (MvPolynomial.C c) = MvPolynomial.C (MvPolynomial.C c) := by
    intro c
    dsimp only [θ₁]
    rw [MvPolynomial.eval₂Hom_C]
    rfl
  have hθ₁_b : ∀ h : b.castSucc ≠ ℓ, θ₁ (MvPolynomial.X ⟨b.castSucc, h⟩) = s₀ := by
    intro h
    dsimp only [θ₁]
    rw [MvPolynomial.eval₂Hom_X']
    dsimp only [u_θ₁]
    rw [Fin.lastCases_castSucc]
    simp only [↓reduceDIte]
  have hθ₁_ne : ∀ (j : Fin (m + 1)) (h : j.castSucc ≠ ℓ) (hj : j ≠ b),
      θ₁ (MvPolynomial.X ⟨j.castSucc, h⟩) = MvPolynomial.C (MvPolynomial.X ⟨j, hj⟩) * s₀ := by
    intro j h hj
    dsimp only [θ₁]
    rw [MvPolynomial.eval₂Hom_X']
    dsimp only [u_θ₁]
    rw [Fin.lastCases_castSucc]
    simp only [hj, ↓reduceDIte]

  let φ'_0 : (V'₀ : AlgebraicGeometry.Scheme.{u}) ⟶ P_amb.left :=
    e_V₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫
      (iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι
  let φ'_1 : (V'₁ : AlgebraicGeometry.Scheme.{u}) ⟶ P_amb.left :=
    e_V₁.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
      (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι

  have hov_φ' : E'_b.homOfLE inf_le_left ≫ φ'_0 = E'_b.homOfLE inf_le_right ≫ φ'_1 := by
    rw [← CategoryTheory.cancel_epi e_ov.inv]
    have h_left_ι : e_ov.inv ≫ E'_b.homOfLE inf_le_left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.Away s₁))) ≫
          e_V₀.inv := by
      rw [← CategoryTheory.cancel_mono V'₀.ι, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      exact he_ov_inv
    have h_right_ι : e_ov.inv ≫ E'_b.homOfLE inf_le_right =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_P1) ≫ e_V₁.inv := by
      rw [← CategoryTheory.cancel_mono V'₁.ι, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      exact he_ov_V₁
    rw [← CategoryTheory.Category.assoc e_ov.inv, h_left_ι,
      ← CategoryTheory.Category.assoc e_ov.inv, h_right_ι]
    dsimp [φ'_0, φ'_1]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc e_V₀.inv, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp,
      ← CategoryTheory.Category.assoc e_V₁.inv, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp]
    let y_ℓ : P_amb_b := MvPolynomial.X ⟨ℓ, (Fin.castSucc_ne_last b).symm⟩
    let g_b : P_amb_b →+* Localization.Away s₁ :=
      (algebraMap A₀ (Localization.Away s₁)).comp θ₀
    have hg_yℓ : g_b y_ℓ = algebraMap A₀ (Localization.Away s₁) s₁ := by
      change algebraMap A₀ _ (θ₀ (MvPolynomial.X ⟨ℓ, _⟩)) = _
      rw [hθ₀_ℓ]
    obtain ⟨lift_b, hg_b_fac, hlift_b_eq, hlift_b_inv⟩ := hAwayLift y_ℓ s₁ g_b hg_yℓ
    rw [← AlgebraicGeometry.Spec.map_comp_assoc, ← CommRingCat.ofHom_comp]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_b) ≫
        (iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι = _
    rw [hg_b_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp_assoc,
      hiso_m1_trans b.castSucc ℓ (Fin.castSucc_ne_last b).symm,
      ← AlgebraicGeometry.Spec.map_comp_assoc, ← AlgebraicGeometry.Spec.map_comp_assoc,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
      (iso_m1 ℓ).inv ≫ (U_m1 ℓ).ι) ?_
    apply MvPolynomial.ringHom_ext'
    · apply RingHom.ext
      intro c
      simp only [RingHom.comp_apply]
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hlift_b_eq,
        RingHom.comp_apply, hθ₀_C, hθ₁_C, hτ_P1_C]
    · rintro ⟨r, hr⟩
      obtain ⟨j, rfl⟩ := Fin.exists_castSucc_eq.mpr hr
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
      by_cases hj : j = b
      · subst hj
        simp only [↓reduceDIte]
        rw [hlift_b_inv, hθ₁_b hr, hτ_P1_X]
      · have hj_cast : j.castSucc ≠ b.castSucc := fun h => hj (Fin.castSucc_inj.mp h)
        simp only [hj_cast, ↓reduceDIte]
        rw [map_mul, hlift_b_eq, hlift_b_inv, hθ₁_ne j hr hj, map_mul,
          hτ_P1_X, hτ_P1_C]
        congr 1
        change algebraMap A₀ _ (θ₀ (MvPolynomial.X ⟨j.castSucc, hj_cast⟩)) = _
        rw [hθ₀_cast j hj_cast hj]

  have hPbInf : ∀ (W₁ W₂ : E'_b.Opens),
      CategoryTheory.IsPullback (E'_b.homOfLE inf_le_left) (E'_b.homOfLE inf_le_right)
        W₁.ι W₂.ι := by
    intro W₁ W₂
    have hcomm : E'_b.homOfLE inf_le_left ≫ W₁.ι = E'_b.homOfLE inf_le_right ≫ W₂.ι := by
      rw [AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι]
    refine CategoryTheory.IsPullback.of_isLimit (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
      (fun s => AlgebraicGeometry.IsOpenImmersion.lift (W₁ ⊓ W₂).ι (s.fst ≫ W₁.ι) (by
        rw [(W₁ ⊓ W₂).range_ι]
        rintro _ ⟨x, rfl⟩
        have hx₁ : (s.fst ≫ W₁.ι).base x ∈ W₁ := (s.fst.base x).2
        have hx₂ : (s.fst ≫ W₁.ι).base x ∈ W₂ := by
          have hcond : (s.fst ≫ W₁.ι).base x = (s.snd ≫ W₂.ι).base x :=
            congrArg (fun f => f.base x) s.condition
          rw [hcond]
          exact (s.snd.base x).2
        exact ⟨hx₁, hx₂⟩))
      (fun s => by
        rw [← CategoryTheory.cancel_mono W₁.ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι]
        exact AlgebraicGeometry.IsOpenImmersion.lift_fac (W₁ ⊓ W₂).ι (s.fst ≫ W₁.ι) _)
      (fun s => by
        rw [← CategoryTheory.cancel_mono W₂.ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι]
        exact (AlgebraicGeometry.IsOpenImmersion.lift_fac (W₁ ⊓ W₂).ι (s.fst ≫ W₁.ι) _).trans
          s.condition)
      (fun s m_hom hm₁ _ => by
        rw [← CategoryTheory.cancel_mono (W₁ ⊓ W₂).ι]
        calc m_hom ≫ (W₁ ⊓ W₂).ι
            = m_hom ≫ E'_b.homOfLE inf_le_left ≫ W₁.ι := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
          _ = s.fst ≫ W₁.ι := by rw [← CategoryTheory.Category.assoc, hm₁]
          _ = _ := (AlgebraicGeometry.IsOpenImmersion.lift_fac (W₁ ⊓ W₂).ι (s.fst ≫ W₁.ι) _).symm))

  let V'_fam : Bool → E'_b.Opens
    | false => V'₀
    | true => V'₁
  have hcov_fam : ⨆ c : Bool, V'_fam c = ⊤ := by
    apply le_antisymm le_top
    rw [← hcov_V']
    exact sup_le (le_iSup V'_fam false) (le_iSup V'_fam true)
  let 𝒰_E' := E'_b.openCoverOfIsOpenCover V'_fam (TopologicalSpace.IsOpenCover.mk hcov_fam)
  let φ'_fam : ∀ c : Bool, (V'_fam c : AlgebraicGeometry.Scheme.{u}) ⟶ P_amb.left
    | false => φ'_0
    | true => φ'_1
  have hglue_φ' : ∀ (c₁ c₂ : 𝒰_E'.I₀),
      CategoryTheory.Limits.pullback.fst (𝒰_E'.f c₁) (𝒰_E'.f c₂) ≫ φ'_fam c₁ =
        CategoryTheory.Limits.pullback.snd (𝒰_E'.f c₁) (𝒰_E'.f c₂) ≫ φ'_fam c₂ := by
    intro c₁ c₂
    let b₁ : Bool := c₁
    let b₂ : Bool := c₂
    change CategoryTheory.Limits.pullback.fst (V'_fam b₁).ι (V'_fam b₂).ι ≫ φ'_fam b₁ =
      CategoryTheory.Limits.pullback.snd (V'_fam b₁).ι (V'_fam b₂).ι ≫ φ'_fam b₂
    let sq := hPbInf (V'_fam b₁) (V'_fam b₂)
    rw [← CategoryTheory.cancel_epi sq.isoPullback.hom,
      ← CategoryTheory.Category.assoc, sq.isoPullback_hom_fst,
      ← CategoryTheory.Category.assoc, sq.isoPullback_hom_snd]
    cases b₁ <;> cases b₂
    · rfl
    · exact hov_φ'
    · have hswap : (V'₁ ⊓ V'₀ : E'_b.Opens) = V'₀ ⊓ V'₁ := inf_comm V'₁ V'₀
      have h_hom₁ : (E'_b.homOfLE inf_le_left :
          ((V'₁ ⊓ V'₀ : E'_b.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶ _) =
          E'_b.homOfLE hswap.le ≫ E'_b.homOfLE inf_le_right :=
        (E'_b.homOfLE_homOfLE hswap.le inf_le_right).symm
      have h_hom₂ : E'_b.homOfLE hswap.le ≫ E'_b.homOfLE inf_le_left =
          (E'_b.homOfLE inf_le_right :
            ((V'₁ ⊓ V'₀ : E'_b.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶ _) :=
        E'_b.homOfLE_homOfLE hswap.le inf_le_left
      exact (congrArg (· ≫ φ'_1) h_hom₁).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (E'_b.homOfLE hswap.le ≫ ·) hov_φ'.symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ φ'_0) h_hom₂))))
    · rfl

  let φ'_b : E'_b ⟶ P_amb.left := 𝒰_E'.glueMorphisms φ'_fam hglue_φ'
  have hφ'_0 : V'₀.ι ≫ φ'_b = φ'_0 :=
    AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰_E' φ'_fam hglue_φ' false
  have hφ'_1 : V'₁.ι ≫ φ'_b = φ'_1 :=
    AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰_E' φ'_fam hglue_φ' true

  have hφ'_over : fst_E' ≫ π_Rb = φ'_b ≫ P_amb.hom := by
    apply 𝒰_E'.hom_ext
    intro c
    cases c
    · change V'₀.ι ≫ fst_E' ≫ π_Rb = V'₀.ι ≫ φ'_b ≫ P_amb.hom
      rw [← CategoryTheory.Category.assoc V'₀.ι φ'_b, hφ'_0, ← CategoryTheory.cancel_epi e_V₀.inv]
      have h_lhs : e_V₀.inv ≫ (V'₀.ι ≫ fst_E' ≫ π_Rb) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫ π_Rb := by
        rw [← CategoryTheory.Category.assoc V'₀.ι, ← CategoryTheory.Category.assoc e_V₀.inv,
          he_V₀_fst]
      have h_b_hom : (iso_m1 b.castSucc).inv ≫ ((U_m1 b.castSucc).ι ≫ P_amb.hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
        hiso_m1_inv_hom b.castSucc
      have h_rhs : e_V₀.inv ≫ (φ'_0 ≫ P_amb.hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
        dsimp only [φ'_0]
        simp only [CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc e_V₀.inv e_V₀.hom, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp, h_b_hom]
      rw [h_lhs, h_rhs]
      dsimp only [π_Rb]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
      apply RingHom.ext
      intro c_k
      exact (hθ₀_C c_k).symm
    · change V'₁.ι ≫ fst_E' ≫ π_Rb = V'₁.ι ≫ φ'_b ≫ P_amb.hom
      rw [← CategoryTheory.Category.assoc V'₁.ι φ'_b, hφ'_1, ← CategoryTheory.cancel_epi e_V₁.inv]
      have h_lhs : e_V₁.inv ≫ (V'₁.ι ≫ fst_E' ≫ π_Rb) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫ π_Rb := by
        rw [← CategoryTheory.Category.assoc V'₁.ι, ← CategoryTheory.Category.assoc e_V₁.inv,
          he_V₁_fst]
      have h_ℓ_hom : (iso_m1 ℓ).inv ≫ ((U_m1 ℓ).ι ≫ P_amb.hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
        hiso_m1_inv_hom ℓ
      have h_rhs : e_V₁.inv ≫ (φ'_1 ≫ P_amb.hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
        dsimp only [φ'_1]
        simp only [CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc e_V₁.inv e_V₁.hom, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp, h_ℓ_hom]
      rw [h_lhs, h_rhs]
      dsimp only [π_Rb]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
      apply RingHom.ext
      intro c_k
      exact (hθ₁_C c_k).symm

  let Φ'_b : E'_b ⟶ Q'_b := CategoryTheory.Limits.pullback.lift fst_E' φ'_b hφ'_over
  have hΦ'_fst : Φ'_b ≫ fst_Q' = fst_E' := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΦ'_snd : Φ'_b ≫ snd_Q' = φ'_b := CategoryTheory.Limits.pullback.lift_snd _ _ _

  let β_b : (D₁_b : AlgebraicGeometry.Scheme.{u}) ≅ (V'₀ : AlgebraicGeometry.Scheme.{u}) :=
    { hom := (iso_m1 b.castSucc).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_inv) ≫ e_V₀.inv
      inv := e_V₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫ (iso_m1 b.castSucc).inv
      hom_inv_id := by
        simp only [CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc e_V₀.inv, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ₀_left,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
          CategoryTheory.Category.id_comp]
        exact CategoryTheory.Iso.hom_inv_id (iso_m1 b.castSucc)
      inv_hom_id := by
        simp only [CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc (iso_m1 b.castSucc).inv, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ₀_right,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
          CategoryTheory.Category.id_comp]
        exact CategoryTheory.Iso.hom_inv_id e_V₀ }

  have hβ_snd : β_b.hom ≫ V'₀.ι ≫ Φ'_b ≫ snd_Q' = D₁_b.ι := by
    rw [hΦ'_snd, hφ'_0]
    dsimp only [β_b, φ'_0]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc e_V₀.inv, CategoryTheory.Iso.inv_hom_id,
      CategoryTheory.Category.id_comp,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ₀_left,
      CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
      CategoryTheory.Category.id_comp]
    exact CategoryTheory.Iso.hom_inv_id_assoc (iso_m1 b.castSucc) D₁_b.ι

  have hβ_fst : β_b.hom ≫ V'₀.ι ≫ Φ'_b ≫ fst_Q' =
      (iso_m1 b.castSucc).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_Rb) := by
    rw [hΦ'_fst]
    dsimp only [β_b]
    rw [CategoryTheory.Category.assoc (iso_m1 b.castSucc).hom,
      CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_inv)),
      he_V₀_fst, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 1
    refine congrArg (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ?_
    apply RingHom.ext
    intro r
    exact hθ₀_inv_C r

  
  let W'_open : Fin (m + 1 + 1) → Q'_b.Opens := fun a => snd_Q' ⁻¹ᵁ U_m1 a
  have hpre_W' : ∀ a : Fin (m + 1 + 1), Φ'_b ⁻¹ᵁ W'_open a = φ'_b ⁻¹ᵁ U_m1 a := by
    intro a
    change (Φ'_b ≫ snd_Q') ⁻¹ᵁ U_m1 a = φ'_b ⁻¹ᵁ U_m1 a
    rw [hΦ'_snd]
  have hcov_W' : ⨆ a : Fin (m + 1 + 1), W'_open a = ⊤ := by
    ext q
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hq_top : snd_Q'.base q ∈ (⊤ : P_amb.left.Opens) := trivial
    have hCov_m1' : ⨆ a : Fin (m + 1 + 1), U_m1 a = ⊤ := hCov_m1
    rw [← hCov_m1', TopologicalSpace.Opens.mem_iSup] at hq_top
    exact TopologicalSpace.Opens.mem_iSup.mpr hq_top

  have hCl_Φ' : AlgebraicGeometry.IsClosedImmersion Φ'_b := by
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := @AlgebraicGeometry.IsClosedImmersion) W'_open hcov_W']
    intro a
    obtain ⟨e_Wa, he_Wa_fst, he_Wa_snd⟩ :=
      hPullChart {r : Fin (m + 1 + 1) // r ≠ a} P_amb.left P_amb.hom (U_m1 a)
        (iso_m1 a) (hiso_m1_hom a)
    let B_a := MvPolynomial {r : Fin (m + 1 + 1) // r ≠ a} R_b
    have hChartClosed :
        ∀ (C_a : Type u) [CommRing C_a]
          (e_pre : ((Φ'_b ⁻¹ᵁ W'_open a) : AlgebraicGeometry.Scheme.{u}) ≅
            AlgebraicGeometry.Spec (CommRingCat.of C_a))
          (Ψ_a : B_a →+* C_a),
          Function.Surjective Ψ_a →
          e_pre.inv ≫ (Φ'_b ⁻¹ᵁ W'_open a).ι ≫ Φ'_b =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ_a) ≫ e_Wa.inv ≫ (W'_open a).ι →
          AlgebraicGeometry.IsClosedImmersion (Φ'_b ∣_ W'_open a) := by
      intro C_a _ e_pre Ψ_a hSurj hComm_pre
      have hRestr_eq : Φ'_b ∣_ W'_open a =
          e_pre.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ_a) ≫ e_Wa.inv := by
        rw [← CategoryTheory.cancel_mono (W'_open a).ι, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.cancel_epi e_pre.inv]
        simp only [CategoryTheory.Category.assoc]
        rw [← CategoryTheory.Category.assoc e_pre.inv e_pre.hom, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc e_pre.inv]
        exact hComm_pre
      rw [hRestr_eq]
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ_a)) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom Ψ_a) hSurj
      infer_instance
    
    refine Fin.lastCases (motive := fun x =>
      ∀ (e_Wx : ((W'_open x) : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {r : Fin (m + 1 + 1) // r ≠ x} R_b))),
        e_Wx.inv ≫ (W'_open x).ι ≫ fst_Q' =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) →
        e_Wx.inv ≫ (W'_open x).ι ≫ snd_Q' =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map MvPolynomial.C)) ≫
            (iso_m1 x).inv ≫ (U_m1 x).ι →
        (∀ (C_x : Type u) [CommRing C_x]
          (e_pre : ((Φ'_b ⁻¹ᵁ W'_open x) : AlgebraicGeometry.Scheme.{u}) ≅
            AlgebraicGeometry.Spec (CommRingCat.of C_x))
          (Ψ_x : MvPolynomial {r : Fin (m + 1 + 1) // r ≠ x} R_b →+* C_x),
          Function.Surjective Ψ_x →
          e_pre.inv ≫ (Φ'_b ⁻¹ᵁ W'_open x).ι ≫ Φ'_b =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ_x) ≫ e_Wx.inv ≫ (W'_open x).ι →
          AlgebraicGeometry.IsClosedImmersion (Φ'_b ∣_ W'_open x)) →
        AlgebraicGeometry.IsClosedImmersion (Φ'_b ∣_ W'_open x))
      ?_ (fun i => ?_) a e_Wa he_Wa_fst he_Wa_snd hChartClosed
    · 
      intro e_Wℓ he_Wℓ_fst he_Wℓ_snd hClosed_ℓ
      have hpre_eq_V₁ : Φ'_b ⁻¹ᵁ W'_open ℓ = V'₁ := by
        rw [hpre_W' ℓ]
        ext z
        change φ'_b.base z ∈ U_m1 ℓ ↔ z ∈ V'₁
        constructor
        · intro hz_ℓ
          have hz_cov : z ∈ V'₀ ⊔ V'₁ := by rw [hcov_V']; trivial
          rcases hz_cov with hz₀ | hz₁
          · let q₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₀)) := e_V₀.hom.base ⟨z, hz₀⟩
            have hq₀_z : (e_V₀.inv ≫ V'₀.ι).base q₀ = z := by
              change V'₀.ι.base ((e_V₀.hom ≫ e_V₀.inv).base ⟨z, hz₀⟩) = z
              rw [CategoryTheory.Iso.hom_inv_id]
              exact AlgebraicGeometry.Scheme.Opens.ι_apply V'₀ ⟨z, hz₀⟩
            have hq₀_map : (e_V₀.inv ≫ V'₀.ι ≫ φ'_b).base q₀ ∈ U_m1 ℓ := by
              change φ'_b.base ((e_V₀.inv ≫ V'₀.ι).base q₀) ∈ U_m1 ℓ
              rwa [hq₀_z]
            rw [hφ'_0] at hq₀_map
            have hq₀_θ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫
                (iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι).base q₀ ∈ U_m1 ℓ := by
              dsimp only [φ'_0] at hq₀_map
              rwa [← CategoryTheory.Category.assoc e_V₀.inv, CategoryTheory.Iso.inv_hom_id,
                CategoryTheory.Category.id_comp] at hq₀_map
            have hpre_s₁ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫
                (iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι) ⁻¹ᵁ U_m1 ℓ =
                PrimeSpectrum.basicOpen s₁ := by
              change AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ⁻¹ᵁ
                  (((iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι) ⁻¹ᵁ U_m1 ℓ) = _
              rw [hiso_m1_pre b.castSucc ℓ (Fin.castSucc_ne_last b).symm,
                AlgebraicGeometry.SpecMap_preimage_basicOpen]
              congr 1
              exact hθ₀_ℓ (Fin.castSucc_ne_last b).symm
            have hq₀_bo : q₀ ∈ PrimeSpectrum.basicOpen s₁ := by
              have hmem : q₀ ∈ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫
                  (iso_m1 b.castSucc).inv ≫ (U_m1 b.castSucc).ι) ⁻¹ᵁ U_m1 ℓ := hq₀_θ
              rwa [hpre_s₁] at hmem
            rw [← hpre_V₀_V₁] at hq₀_bo
            change z ∈ V'₁
            rwa [← hq₀_z]
          · exact hz₁
        · intro hz₁
          have h1 : φ'_b.base (V'₁.ι.base ⟨z, hz₁⟩) = φ'_1.base ⟨z, hz₁⟩ := by
            rw [← hφ'_1]
            rfl
          rw [AlgebraicGeometry.Scheme.Opens.ι_apply] at h1
          rw [h1]
          exact ((e_V₁.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) ≫
            (iso_m1 ℓ).inv).base ⟨z, hz₁⟩).2
      let iso_eq_ℓ : ((Φ'_b ⁻¹ᵁ W'_open ℓ) : AlgebraicGeometry.Scheme.{u}) ≅
