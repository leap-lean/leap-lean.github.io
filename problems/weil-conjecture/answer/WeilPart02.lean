    have hX : ∀ μ : Fin (M₀ + 1), MvPolynomial.X μ ∈ 𝒜 1 :=
      fun μ => MvPolynomial.isHomogeneous_X k μ
    have hAff_U : ∀ μ : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (U_proj μ) :=
      fun μ => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X μ) (hX μ) zero_lt_one
    have hAff_Uinter : ∀ μ ν : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (U_proj μ ⊓ U_proj ν) := by
