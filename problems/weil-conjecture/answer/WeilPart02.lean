      have hRegMul : ∀ b : Localization.AtPrime q, π_B * b = 0 → b = 0 := by
        intro b hb
        apply hReg
        simpa [Algebra.smul_def, π_B] using hb
      have hRegPow : ∀ (k : ℕ) (b : Localization.AtPrime q), π_B ^ k * b = 0 → b = 0 := by
        intro k
        induction k with
        | zero =>
          intro b hb
          simpa using hb
        | succ k ih =>
          intro b hb
          apply ih
          apply hRegMul
          calc
            π_B * (π_B ^ k * b) = (π_B * π_B ^ k) * b := (mul_assoc _ _ _).symm
            _ = π_B ^ (k + 1) * b := by rw [← pow_succ']
            _ = 0 := hb
      have hKrull : (⨅ n : ℕ, I_B ^ n) = ⊥ := by
        rw [hMaxEq]
        exact Ideal.iInf_pow_eq_bot_of_isLocalRing
          (IsLocalRing.maximalIdeal (Localization.AtPrime q))
          (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime q)).ne_top
      have h_factor : ∀ x : Localization.AtPrime q, x ≠ 0 →
          ∃ (a : ℕ) (u : Localization.AtPrime q), IsUnit u ∧ x = π_B ^ a * u := by
        intro x hx_ne
        have hx_not_all : ∃ n : ℕ, x ∉ Ideal.span {π_B ^ n} := by
          by_contra hall
          push_neg at hall
          have hx_mem : x ∈ (⨅ n : ℕ, I_B ^ n) := by
            rw [Ideal.mem_iInf]
            intro n
            rw [show I_B ^ n = Ideal.span {π_B ^ n} from Ideal.span_singleton_pow π_B n]
            exact hall n
          rw [hKrull, Ideal.mem_bot] at hx_mem
          exact hx_ne hx_mem
        classical
        let n_x := Nat.find hx_not_all
        have hn_ne_zero : n_x ≠ 0 := by
          intro h0
          have hspec : x ∉ Ideal.span {π_B ^ n_x} := Nat.find_spec hx_not_all
          rw [h0, pow_zero, Ideal.span_singleton_one] at hspec
          exact hspec Submodule.mem_top
        obtain ⟨a, ha⟩ := Nat.exists_eq_succ_of_ne_zero hn_ne_zero
        have ha_lt : a < Nat.find hx_not_all := by omega
        have hx_in_a : x ∈ Ideal.span {π_B ^ a} := by
          by_contra hnot
          exact Nat.find_min hx_not_all ha_lt hnot
        obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton.mp hx_in_a
        have hu_not_IB : u ∉ I_B := by
          intro hu_mem
          obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp hu_mem
          have hx_in_succ : x ∈ Ideal.span {π_B ^ n_x} := by
            rw [ha, pow_succ]
            exact Ideal.mem_span_singleton.mpr ⟨w, by rw [hu_eq]; ring⟩
          exact Nat.find_spec hx_not_all hx_in_succ
        have hu_unit : IsUnit u :=
          IsLocalRing.notMem_maximalIdeal.mp (hMaxEq ▸ hu_not_IB)
        exact ⟨a, u, hu_unit, hu_eq⟩
      haveI : NoZeroDivisors (Localization.AtPrime q) := by
        refine ⟨fun {x y} hxy => ?_⟩
        by_contra hne
        push_neg at hne
        obtain ⟨hx_ne, hy_ne⟩ := hne
        obtain ⟨a, u, hu, rfl⟩ := h_factor x hx_ne
        obtain ⟨b, v, hv, rfl⟩ := h_factor y hy_ne
        have huv0 : u * v = 0 := by
          apply hRegPow (a + b)
          calc
            π_B ^ (a + b) * (u * v) = (π_B ^ a * u) * (π_B ^ b * v) := by rw [pow_add]; ring
            _ = 0 := hxy
        have huv_unit : IsUnit (u * v) := hu.mul hv
        rw [huv0] at huv_unit
        exact not_isUnit_zero huv_unit
      exact NoZeroDivisors.to_isDomain (Localization.AtPrime q)

  
  have h_spec_open_irred : ∀ (C : Type u) [CommRing C] [IsNoetherianRing C],
      (∀ (q : Ideal C) [q.IsPrime], IsDomain (Localization.AtPrime q)) →
      ∀ z : PrimeSpectrum C, ∃ Z : Set (PrimeSpectrum C), IsOpen Z ∧ z ∈ Z ∧ IsIrreducible Z := by
    intro C _ _ hDom z
    have h_uniq_min : ∀ (w : PrimeSpectrum C) {p₁ p₂ : Ideal C},
        p₁ ∈ minimalPrimes C → p₂ ∈ minimalPrimes C →
        p₁ ≤ w.asIdeal → p₂ ≤ w.asIdeal → p₁ = p₂ := by
      intro w p₁ p₂ hp₁ hp₂ h₁ h₂
      haveI : IsDomain (Localization.AtPrime w.asIdeal) := hDom w.asIdeal
      let p_star : Ideal C := Ideal.comap (algebraMap C (Localization.AtPrime w.asIdeal)) ⊥
      have hp_star_prime : p_star.IsPrime := Ideal.IsPrime.comap _
      have h_le : ∀ {p : Ideal C}, p.IsPrime → p ≤ w.asIdeal → p_star ≤ p := by
        intro p hp hpw c hc
        change algebraMap C (Localization.AtPrime w.asIdeal) c ∈ (⊥ : Ideal _) at hc
        rw [Ideal.mem_bot] at hc
        obtain ⟨s, hsc⟩ :=
          (IsLocalization.map_eq_zero_iff w.asIdeal.primeCompl
            (Localization.AtPrime w.asIdeal) c).mp hc
        have hs_not_p : s.1 ∉ p := fun hsp => s.2 (hpw hsp)
        have hmul_p : s.1 * c ∈ p := by rw [hsc]; exact p.zero_mem
        exact (hp.mem_or_mem hmul_p).resolve_left hs_not_p
      rw [minimalPrimes_eq_minimals] at hp₁ hp₂
      have heq₁ : p₁ = p_star := le_antisymm (hp₁.2 hp_star_prime (h_le hp₁.1 h₁)) (h_le hp₁.1 h₁)
      have heq₂ : p₂ = p_star := le_antisymm (hp₂.2 hp_star_prime (h_le hp₂.1 h₂)) (h_le hp₂.1 h₂)
      exact heq₁.trans heq₂.symm
    obtain ⟨p₀, hp₀, hp₀_z⟩ :=
      @Ideal.exists_minimalPrimes_le C _ ⊥ z.asIdeal z.isPrime bot_le
    change p₀ ∈ minimalPrimes C at hp₀
    let Z : Set (PrimeSpectrum C) := PrimeSpectrum.zeroLocus (p₀ : Set C)
    have hzZ : z ∈ Z := hp₀_z
    have hp₀_prime : p₀.IsPrime := (minimalPrimes_eq_minimals (R := C) ▸ hp₀).1
    have hIrredZ : IsIrreducible Z :=
      (PrimeSpectrum.isIrreducible_zeroLocus_iff p₀).mpr (hp₀_prime.radical.symm ▸ hp₀_prime)
    let S_other : Set (Ideal C) := minimalPrimes C \ {p₀}
    let K_other : Set (PrimeSpectrum C) := ⋃ p ∈ S_other, PrimeSpectrum.zeroLocus (p : Set C)
    have hFinMin : (minimalPrimes C).Finite := minimalPrimes.finite_of_isNoetherianRing C
    have hFinOther : S_other.Finite := hFinMin.sdiff
    have hClosedK : IsClosed K_other :=
      hFinOther.isClosed_biUnion fun p _ => PrimeSpectrum.isClosed_zeroLocus (p : Set C)
    have hZ_compl : Z = K_otherᶜ := by
      ext w
      simp only [Z, K_other, S_other, Set.mem_compl_iff, Set.mem_iUnion, Set.mem_sdiff,
        Set.mem_singleton_iff, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
      constructor
      · intro hw₀ ⟨p, ⟨hp_min, hp_ne⟩, hpw⟩
        exact hp_ne (h_uniq_min w hp_min hp₀ hpw hw₀)
      · intro hnot
        obtain ⟨p, hp_min, hpw⟩ :=
          @Ideal.exists_minimalPrimes_le C _ ⊥ w.asIdeal w.isPrime bot_le
        change p ∈ minimalPrimes C at hp_min
        by_cases hp_eq : p = p₀
        · exact hp_eq ▸ hpw
        · exact False.elim (hnot ⟨p, ⟨hp_min, hp_eq⟩, hpw⟩)
    have hOpenZ : IsOpen Z := hZ_compl ▸ hClosedK.isOpen_compl
    exact ⟨Z, hOpenZ, hzZ, hIrredZ⟩

  
  have h_chart : ∀ y : ↥Y, ∃ (V : Y.Opens) (hV : IsAffineOpen V),
      y ∈ V ∧
      IsNoetherianRing ↑(Y.presheaf.obj (Opposite.op V)) ∧
      (∀ (q : Ideal ↑(Y.presheaf.obj (Opposite.op V))) [q.IsPrime],
        IsDomain (Localization.AtPrime q)) := by
    intro y
    obtain ⟨U, _hU, V, hV, hy, e, hf₀⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 g).mp inferInstance y
    have hyU : g.base y ∈ U := e hy
    have hU_top : U = ⊤ := top_unique fun x _ => Subsingleton.elim x (g.base y) ▸ hyU
    let iso_KR : CommRingCat.of K ≅ (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj
        (Opposite.op U) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).symm ≪≫
        (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.mapIso (eqToIso hU_top).op
    let e_KR : K ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U)) :=
      iso_KR.commRingCatIsoToRingEquiv
    obtain ⟨g_et, _hg_comp, hg_et⟩ := hf₀.exists_etale_mvPolynomial
    let e_poly : Polynomial K ≃+*
        MvPolynomial (Fin 1) ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U)) :=
      (MvPolynomial.uniqueAlgEquiv K (Fin 1)).symm.toRingEquiv.trans
        (MvPolynomial.mapEquiv (Fin 1) e_KR)
    let h_et : Polynomial K →+* ↑(Y.presheaf.obj (Opposite.op V)) :=
      g_et.comp e_poly.toRingHom
    have hh_et : h_et.Etale := RingHom.Etale.respectsIso.right g_et e_poly hg_et
    let : Algebra (Polynomial K) ↑(Y.presheaf.obj (Opposite.op V)) := h_et.toAlgebra
    have : Algebra.Etale (Polynomial K) ↑(Y.presheaf.obj (Opposite.op V)) :=
      RingHom.etale_algebraMap.mp hh_et
    have hNoeth : IsNoetherianRing ↑(Y.presheaf.obj (Opposite.op V)) :=
      Algebra.FiniteType.isNoetherianRing (Polynomial K) ↑(Y.presheaf.obj (Opposite.op V))
    exact ⟨V, hV, hy, hNoeth, h_etale_poly_dom _ h_et hh_et⟩

  haveI hRedStalk : ∀ y : ↥Y, IsReduced ↑(Y.presheaf.stalk y) := by
    intro y
    obtain ⟨V, hV, hy, _, hDomC⟩ := h_chart y
    let q_y : Ideal ↑(Y.presheaf.obj (Opposite.op V)) := (hV.primeIdealOf ⟨y, hy⟩).asIdeal
    haveI : IsDomain (Localization.AtPrime q_y) := hDomC q_y
    letI : Algebra ↑(Y.presheaf.obj (Opposite.op V)) ↑(Y.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hy⟩
    haveI : IsLocalization.AtPrime ↑(Y.presheaf.stalk y) q_y :=
      hV.isLocalization_stalk ⟨y, hy⟩
    let e_st : ↑(Y.presheaf.stalk y) ≃ₐ[↑(Y.presheaf.obj (Opposite.op V))]
        Localization.AtPrime q_y :=
      IsLocalization.algEquiv q_y.primeCompl _ _
    exact isReduced_of_injective e_st.toRingHom e_st.injective

  haveI : AlgebraicGeometry.IsReduced Y := AlgebraicGeometry.isReduced_of_isReduced_stalk Y

  have hNhdsY : ∀ y : ↥Y, ∃ U_y : Set ↥Y, IsOpen U_y ∧ y ∈ U_y ∧ IsPreirreducible U_y := by
    intro y
    obtain ⟨V, hV, hy, hNoethC, hDomC⟩ := h_chart y
    haveI : IsNoetherianRing ↑(Y.presheaf.obj (Opposite.op V)) := hNoethC
    have hy_range : y ∈ Set.range hV.fromSpec.base := by
      rw [hV.range_fromSpec]
      exact hy
    obtain ⟨z_y, hz_eq⟩ := hy_range
    obtain ⟨Z, hOpenZ, hzZ, hIrredZ⟩ := h_spec_open_irred _ hDomC z_y
    haveI : AlgebraicGeometry.IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
    refine ⟨hV.fromSpec.base '' Z, ?_, ⟨z_y, hzZ, hz_eq⟩, ?_⟩
    · exact hV.fromSpec.isOpenEmbedding.isOpenMap Z hOpenZ
    · exact (hIrredZ.image hV.fromSpec.base hV.fromSpec.continuous.continuousOn).isPreirreducible

  haveI : IrreducibleSpace ↥Y := h_irred_of_nhds ↥Y hNhdsY
  exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y

theorem weil_flat_open_generic_integral_schematic_image (S Y P : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral S]
    (g : Y ⟶ S)
    [AlgebraicGeometry.Flat g]
    (hGenInt : ∀ (U : S.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) [Nonempty U],
      AlgebraicGeometry.IsIntegral
        (CategoryTheory.Limits.pullback g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↑(S.presheaf.obj (Opposite.op U))
              (FractionRing ↑(S.presheaf.obj (Opposite.op U))))) ≫
            hU.fromSpec)))
    (j : Y ⟶ P)
    [AlgebraicGeometry.QuasiCompact j] :
    AlgebraicGeometry.IsIntegral j.image :=
by
  
  have hSingleChart : ∀ (U : S.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (hUne : Nonempty U)
      (V : Y.Opens) (hV : AlgebraicGeometry.IsAffineOpen V) (hVne : Nonempty V)
      (e : V ≤ (TopologicalSpace.Opens.map g.base).obj U),
      IsDomain ↑(Y.presheaf.obj (Opposite.op V)) ∧
      Function.Injective (CommRingCat.Hom.hom (g.appLE U V e)) ∧
      ∃ z : ↥(CategoryTheory.Limits.pullback g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↑(S.presheaf.obj (Opposite.op U))
              (FractionRing ↑(S.presheaf.obj (Opposite.op U))))) ≫
            hU.fromSpec)),
        (CategoryTheory.Limits.pullback.fst g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↑(S.presheaf.obj (Opposite.op U))
              (FractionRing ↑(S.presheaf.obj (Opposite.op U))))) ≫
            hU.fromSpec)).base z ∈ V := by
    intro U hU hUne V hV hVne e
    have : Nonempty U := hUne
    have : IsDomain ↑(S.presheaf.obj (Opposite.op U)) :=
      AlgebraicGeometry.IsIntegral.component_integral U
    obtain ⟨v₀⟩ := hVne
    have : Nontrivial ↑(Y.presheaf.obj (Opposite.op V)) :=
      (PrimeSpectrum.nonempty_iff_nontrivial).mp ⟨hV.primeIdealOf v₀⟩
    let _ : Algebra ↑(S.presheaf.obj (Opposite.op U)) ↑(Y.presheaf.obj (Opposite.op V)) :=
      (CommRingCat.Hom.hom (g.appLE U V e)).toAlgebra
    have h_alg_eq : algebraMap ↑(S.presheaf.obj (Opposite.op U)) ↑(Y.presheaf.obj (Opposite.op V)) =
        CommRingCat.Hom.hom (g.appLE U V e) := rfl
    have : Module.Flat ↑(S.presheaf.obj (Opposite.op U)) ↑(Y.presheaf.obj (Opposite.op V)) :=
      (RingHom.flat_algebraMap_iff).mp (by rw [h_alg_eq]; exact g.flat_appLE hU hV e)
    have hInj_φ : Function.Injective (CommRingCat.Hom.hom (g.appLE U V e)) := by
      intro a₁ a₂ ha_eq
      by_contra h_ne
      have ha_sub : (CommRingCat.Hom.hom (g.appLE U V e)) (a₁ - a₂) = 0 := by
        rw [map_sub, sub_eq_zero]
        exact ha_eq
      have ha_reg : IsSMulRegular ↑(Y.presheaf.obj (Opposite.op V)) (a₁ - a₂) :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors
          (mem_nonZeroDivisors_of_ne_zero (sub_ne_zero.mpr h_ne))
      have h10 : (1 : ↑(Y.presheaf.obj (Opposite.op V))) = 0 := by
        apply ha_reg
        change algebraMap _ _ (a₁ - a₂) * 1 = algebraMap _ _ (a₁ - a₂) * 0
        rw [h_alg_eq, ha_sub, mul_one, mul_zero]
      exact one_ne_zero h10
    have hInj_incl : Function.Injective
        (Algebra.TensorProduct.includeLeftRingHom :
          ↑(Y.presheaf.obj (Opposite.op V)) →+*
            TensorProduct ↑(S.presheaf.obj (Opposite.op U))
              ↑(Y.presheaf.obj (Opposite.op V))
              (FractionRing ↑(S.presheaf.obj (Opposite.op U)))) := by
      intro c₁ c₂ hc
      have h_lin_inj : Function.Injective
          (LinearMap.lTensor ↑(Y.presheaf.obj (Opposite.op V))
            (Algebra.linearMap ↑(S.presheaf.obj (Opposite.op U))
              (FractionRing ↑(S.presheaf.obj (Opposite.op U))))) :=
        Module.Flat.lTensor_preserves_injective_linearMap _
          (IsFractionRing.injective ↑(S.presheaf.obj (Opposite.op U))
            (FractionRing ↑(S.presheaf.obj (Opposite.op U))))
      have hc' : LinearMap.lTensor ↑(Y.presheaf.obj (Opposite.op V))
          (Algebra.linearMap ↑(S.presheaf.obj (Opposite.op U))
            (FractionRing ↑(S.presheaf.obj (Opposite.op U)))) (c₁ ⊗ₜ 1) =
          LinearMap.lTensor ↑(Y.presheaf.obj (Opposite.op V))
          (Algebra.linearMap ↑(S.presheaf.obj (Opposite.op U))
            (FractionRing ↑(S.presheaf.obj (Opposite.op U)))) (c₂ ⊗ₜ 1) := by
        simpa [LinearMap.lTensor_tmul, Algebra.linearMap_apply, map_one] using hc
      have h_tmul := h_lin_inj hc'
      simpa using congrArg (TensorProduct.rid ↑(S.presheaf.obj (Opposite.op U))
        ↑(Y.presheaf.obj (Opposite.op V))) h_tmul
    let f_C := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap ↑(S.presheaf.obj (Opposite.op U)) ↑(Y.presheaf.obj (Opposite.op V))))
    let f_L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap ↑(S.presheaf.obj (Opposite.op U))
        (FractionRing ↑(S.presheaf.obj (Opposite.op U)))))
    let ξ_U := f_L ≫ hU.fromSpec
    let iso_T := AlgebraicGeometry.pullbackSpecIso
      ↑(S.presheaf.obj (Opposite.op U))
      ↑(Y.presheaf.obj (Opposite.op V))
      (FractionRing ↑(S.presheaf.obj (Opposite.op U)))
    let q_C := iso_T.inv ≫ CategoryTheory.Limits.pullback.fst f_C f_L
    let q_L := iso_T.inv ≫ CategoryTheory.Limits.pullback.snd f_C f_L
    have hPb_aff : CategoryTheory.IsPullback q_C q_L f_C f_L :=
      CategoryTheory.IsPullback.of_iso_pullback
        ⟨by simp only [q_C, q_L, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition]⟩
        iso_T.symm rfl rfl
    have : AlgebraicGeometry.IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
    have hPb_comp : CategoryTheory.IsPullback q_C q_L (f_C ≫ hU.fromSpec) ξ_U :=
      CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.isLimitOfCompMono f_C f_L hU.fromSpec
          hPb_aff.cone hPb_aff.isLimit)
    have hf_C_eq : f_C ≫ hU.fromSpec = hV.fromSpec ≫ g := by
      have h_map : f_C = AlgebraicGeometry.Spec.map (g.appLE U V e) :=
        congrArg AlgebraicGeometry.Spec.map (CommRingCat.Hom.ext rfl)
      rw [h_map]
      exact hU.SpecMap_appLE_fromSpec g hV e
    have hPb_outer : CategoryTheory.IsPullback q_C q_L (hV.fromSpec ≫ g) ξ_U := by
      rwa [hf_C_eq] at hPb_comp
    let ι_VL := CategoryTheory.Limits.pullback.lift (q_C ≫ hV.fromSpec) q_L
      ((CategoryTheory.Category.assoc _ _ _).trans hPb_outer.w)
    have hPb_top : CategoryTheory.IsPullback q_C ι_VL hV.fromSpec
        (CategoryTheory.Limits.pullback.fst g ξ_U) := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback g ξ_U)
      · simpa only [ι_VL, CategoryTheory.Limits.pullback.lift_snd] using hPb_outer
      · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    have : AlgebraicGeometry.IsOpenImmersion ι_VL :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_top hV.isOpenImmersion_fromSpec
    have : Nontrivial (TensorProduct ↑(S.presheaf.obj (Opposite.op U))
        ↑(Y.presheaf.obj (Opposite.op V))
        (FractionRing ↑(S.presheaf.obj (Opposite.op U)))) :=
      hInj_incl.nontrivial
    have hNe_T : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of
        (TensorProduct ↑(S.presheaf.obj (Opposite.op U))
          ↑(Y.presheaf.obj (Opposite.op V))
          (FractionRing ↑(S.presheaf.obj (Opposite.op U)))))) :=
      (PrimeSpectrum.nonempty_iff_nontrivial).mpr inferInstance
    have : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback g ξ_U) :=
      hGenInt U hU
    have hInt_T : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of
        (TensorProduct ↑(S.presheaf.obj (Opposite.op U))
          ↑(Y.presheaf.obj (Opposite.op V))
          (FractionRing ↑(S.presheaf.obj (Opposite.op U)))))) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion ι_VL
    have : IsDomain (TensorProduct ↑(S.presheaf.obj (Opposite.op U))
        ↑(Y.presheaf.obj (Opposite.op V))
        (FractionRing ↑(S.presheaf.obj (Opposite.op U)))) :=
      (AlgebraicGeometry.affine_isIntegral_iff _).mp hInt_T
    have hDom_C : IsDomain ↑(Y.presheaf.obj (Opposite.op V)) :=
      Function.Injective.isDomain _ hInj_incl
    obtain ⟨t₀⟩ := hNe_T
    refine ⟨hDom_C, hInj_φ, ⟨ι_VL.base t₀, ?_⟩⟩
    have h_fst_z : (CategoryTheory.Limits.pullback.fst g ξ_U).base (ι_VL.base t₀) =
        hV.fromSpec.base (q_C.base t₀) :=
      congr_fun (congr_arg (fun m : _ ⟶ Y => ⇑m.base)
        (CategoryTheory.Limits.pullback.lift_fst (q_C ≫ hV.fromSpec) q_L
          ((CategoryTheory.Category.assoc _ _ _).trans hPb_outer.w))) t₀
    rw [h_fst_z]
    exact hV.opensRange_fromSpec.le ⟨q_C.base t₀, rfl⟩

  
  have hIntY : AlgebraicGeometry.IsIntegral Y := by
    obtain ⟨s₀⟩ := AlgebraicGeometry.IsIntegral.nonempty (X := S)
    obtain ⟨U₀, hU₀, hs₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := s₀) (U := ⊤) trivial
    have hU₀_ne : Nonempty U₀ := ⟨⟨s₀, hs₀⟩⟩
    let ξ₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap ↑(S.presheaf.obj (Opposite.op U₀))
        (FractionRing ↑(S.presheaf.obj (Opposite.op U₀))))) ≫ hU₀.fromSpec
    have : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback g ξ₀) :=
      hGenInt U₀ hU₀
    have hIrredG₀ : IrreducibleSpace ↥(CategoryTheory.Limits.pullback g ξ₀) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral _
    let π₁ := CategoryTheory.Limits.pullback.fst g ξ₀
    obtain ⟨z₀⟩ := hIrredG₀.toNonempty
    have hNeY : Nonempty ↥Y := ⟨π₁.base z₀⟩
    have hStalkRedY : ∀ y : ↥Y, _root_.IsReduced ↑(Y.presheaf.stalk y) := by
      intro y
      obtain ⟨U, hU, hyU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := g.base y) (U := ⊤) trivial
      obtain ⟨V, hV, hyV, hV_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := y) (U := (TopologicalSpace.Opens.map g.base).obj U) hyU
      have e : V ≤ (TopologicalSpace.Opens.map g.base).obj U := hV_sub
      have : IsDomain ↑(Y.presheaf.obj (Opposite.op V)) :=
        (hSingleChart U hU ⟨⟨g.base y, hyU⟩⟩ V hV ⟨⟨y, hyV⟩⟩ e).1
      let _ : Algebra ↑(Y.presheaf.obj (Opposite.op V)) ↑(Y.presheaf.stalk y) :=
        TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hyV⟩
      have : IsLocalization.AtPrime ↑(Y.presheaf.stalk y) (hV.primeIdealOf ⟨y, hyV⟩).asIdeal :=
        hV.isLocalization_stalk ⟨y, hyV⟩
      have : IsDomain ↑(Y.presheaf.stalk y) :=
        IsLocalization.isDomain_of_atPrime ↑(Y.presheaf.stalk y) (hV.primeIdealOf ⟨y, hyV⟩).asIdeal
      infer_instance
    have : AlgebraicGeometry.IsReduced Y :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk Y
    have hHitOpen : ∀ (O : Set ↥Y), IsOpen O → O.Nonempty → (π₁.base ⁻¹' O).Nonempty := by
      intro O hO ⟨y, hyO⟩
      let O_op : Y.Opens := ⟨O, hO⟩
      obtain ⟨U₁, hU₁, hyU₁, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := g.base y) (U := ⊤) trivial
      obtain ⟨V₁, hV₁, hyV₁, hV₁_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := y) (U := O_op ⊓ (TopologicalSpace.Opens.map g.base).obj U₁) ⟨hyO, hyU₁⟩
      have hV₁_le : V₁ ≤ O_op ⊓ (TopologicalSpace.Opens.map g.base).obj U₁ := hV₁_sub
      have e₁ : V₁ ≤ (TopologicalSpace.Opens.map g.base).obj U₁ := hV₁_le.trans inf_le_right
      have : IrreducibleSpace ↥S := AlgebraicGeometry.irreducibleSpace_of_isIntegral S
      obtain ⟨s, hs₀_mem, hs₁_mem⟩ :=
        nonempty_preirreducible_inter U₀.isOpen U₁.isOpen ⟨s₀, hs₀⟩ ⟨g.base y, hyU₁⟩
      obtain ⟨a₁, ha₁_le, hs_a₁⟩ := hU₁.exists_basicOpen_le (⟨s, hs₀_mem⟩ : ↥U₀) hs₁_mem
      have ha₁_ne : a₁ ≠ 0 := by
        intro ha₁_zero
        rw [ha₁_zero, AlgebraicGeometry.Scheme.basicOpen_zero] at hs_a₁
        exact hs_a₁
      obtain ⟨hDom₁, hInj₁, _⟩ :=
        hSingleChart U₁ hU₁ ⟨⟨g.base y, hyU₁⟩⟩ V₁ hV₁ ⟨⟨y, hyV₁⟩⟩ e₁
      have : IsDomain ↑(Y.presheaf.obj (Opposite.op V₁)) := hDom₁
      let c₁ : ↑(Y.presheaf.obj (Opposite.op V₁)) := (CommRingCat.Hom.hom (g.appLE U₁ V₁ e₁)) a₁
      have hc₁_ne : c₁ ≠ 0 := by
        intro hc₁_zero
        apply ha₁_ne
        apply hInj₁
        simpa [c₁] using hc₁_zero
      let W : Y.Opens := Y.basicOpen c₁
      have hW : AlgebraicGeometry.IsAffineOpen W := hV₁.basicOpen c₁
      have : IsLocalization.Away c₁ ↑(Y.presheaf.obj (Opposite.op W)) :=
        hV₁.isLocalization_basicOpen c₁
      have hInj_loc : Function.Injective
          (algebraMap ↑(Y.presheaf.obj (Opposite.op V₁)) ↑(Y.presheaf.obj (Opposite.op W))) :=
        IsLocalization.injective _
          (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hc₁_ne))
      have : Nontrivial ↑(Y.presheaf.obj (Opposite.op W)) := hInj_loc.nontrivial
      have hNe_SpecW : Nonempty ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op W))) :=
        (PrimeSpectrum.nonempty_iff_nontrivial
          (R := ↑(Y.presheaf.obj (Opposite.op W)))).mpr inferInstance
      obtain ⟨pW⟩ := hNe_SpecW
      have hw_mem : hW.fromSpec.base pW ∈ W :=
        hW.opensRange_fromSpec.le ⟨pW, rfl⟩
      have hW_eq : W = V₁ ⊓ (TopologicalSpace.Opens.map g.base).obj (S.basicOpen a₁) :=
        AlgebraicGeometry.Scheme.basicOpen_appLE g V₁ U₁ e₁ a₁
      have hW_le_O : W ≤ O_op := by
        rw [hW_eq]
        exact inf_le_left.trans (hV₁_le.trans inf_le_left)
      have eW : W ≤ (TopologicalSpace.Opens.map g.base).obj U₀ := by
        rw [hW_eq]
        exact inf_le_right.trans ((TopologicalSpace.Opens.map g.base).monotone ha₁_le)
      obtain ⟨_, _, z, hzW⟩ :=
        hSingleChart U₀ hU₀ hU₀_ne W hW ⟨⟨hW.fromSpec.base pW, hw_mem⟩⟩ eW
      exact ⟨z, hW_le_O hzW⟩
    have hPreY : PreirreducibleSpace ↥Y := by
      refine ⟨fun u v hu hv ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩ => ?_⟩
      obtain ⟨z₁, hz₁⟩ := hHitOpen u hu ⟨y₁, hy₁⟩
      obtain ⟨z₂, hz₂⟩ := hHitOpen v hv ⟨y₂, hy₂⟩
      obtain ⟨z, hz_u, hz_v⟩ :=
        nonempty_preirreducible_inter (π₁.continuous.isOpen_preimage _ hu)
          (π₁.continuous.isOpen_preimage _ hv) ⟨z₁, hz₁⟩ ⟨z₂, hz₂⟩
      exact ⟨π₁.base z, trivial, hz_u, hz_v⟩
    have : IrreducibleSpace ↥Y := { toPreirreducibleSpace := hPreY, toNonempty := hNeY }
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y

  
  have : IrreducibleSpace ↥Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y
  have : AlgebraicGeometry.IsReduced Y := AlgebraicGeometry.isReduced_of_isIntegral Y
  obtain ⟨y₀⟩ := IrreducibleSpace.toNonempty (X := ↥Y)
  have hNeImg : Nonempty ↥j.image := ⟨j.toImage.base y₀⟩
  have hDense : DenseRange j.toImage.base := AlgebraicGeometry.IsDominant.denseRange (f := j.toImage)
  have hPreImg : PreirreducibleSpace ↥j.image := by
    refine ⟨fun u v hu hv ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩ => ?_⟩
    obtain ⟨y₁, hy₁⟩ := hDense.exists_mem_open hu ⟨x₁, hx₁⟩
    obtain ⟨y₂, hy₂⟩ := hDense.exists_mem_open hv ⟨x₂, hx₂⟩
    obtain ⟨y, hy_u, hy_v⟩ :=
      nonempty_preirreducible_inter (j.toImage.continuous.isOpen_preimage _ hu)
        (j.toImage.continuous.isOpen_preimage _ hv) ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩
    exact ⟨j.toImage.base y, trivial, hy_u, hy_v⟩
  have : IrreducibleSpace ↥j.image := { toPreirreducibleSpace := hPreImg, toNonempty := hNeImg }
  have hStalkRedImg : ∀ x : ↥j.image, _root_.IsReduced ↑(j.image.presheaf.stalk x) := by
    intro x
    obtain ⟨U_P, hUP, hxP, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := j.imageι.base x) (U := ⊤) trivial
    let W_x : j.image.Opens := (TopologicalSpace.Opens.map j.imageι.base).obj U_P
    have hxW : x ∈ W_x := hxP
    have hWx : AlgebraicGeometry.IsAffineOpen W_x := hUP.preimage j.imageι
    let iso_sub := j.ker.subschemeObjIso ⟨U_P, hUP⟩
    have h_iso_inj : Function.Injective (CommRingCat.Hom.hom iso_sub.hom) := by
      intro a b hab
      have h1 := congrArg (CommRingCat.Hom.hom iso_sub.inv) hab
      simpa [← CommRingCat.hom_comp, iso_sub.hom_inv_id] using h1
    let φ_P := CommRingCat.Hom.hom (j.app U_P)
    let e_quot := Ideal.quotEquivOfEq (j.ker_apply ⟨U_P, hUP⟩)
    let ψ : ↑(j.image.presheaf.obj (Opposite.op W_x)) →+*
        ↑(Y.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map j.base).obj U_P))) :=
      (RingHom.kerLift φ_P).comp (e_quot.toRingHom.comp (CommRingCat.Hom.hom iso_sub.hom))
    have hψ_inj : Function.Injective ψ :=
      (RingHom.kerLift_injective φ_P).comp (e_quot.injective.comp h_iso_inj)
    have : _root_.IsReduced
        ↑(Y.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map j.base).obj U_P))) :=
      AlgebraicGeometry.IsReduced.component_reduced ((TopologicalSpace.Opens.map j.base).obj U_P)
    have hRed_Wx : _root_.IsReduced ↑(j.image.presheaf.obj (Opposite.op W_x)) :=
      isReduced_of_injective ψ hψ_inj
    let _ : Algebra ↑(j.image.presheaf.obj (Opposite.op W_x)) ↑(j.image.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk j.image.presheaf ⟨x, hxW⟩
    have : IsLocalization.AtPrime ↑(j.image.presheaf.stalk x) (hWx.primeIdealOf ⟨x, hxW⟩).asIdeal :=
      hWx.isLocalization_stalk ⟨x, hxW⟩
    refine ⟨fun s ⟨n, hn⟩ => ?_⟩
    obtain ⟨⟨r, m⟩, hrm⟩ :=
      IsLocalization.surj (hWx.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl s
    have hpow : algebraMap ↑(j.image.presheaf.obj (Opposite.op W_x))
        ↑(j.image.presheaf.stalk x) (r ^ n) = 0 := by
      calc
        algebraMap _ _ (r ^ n) = (algebraMap _ _ r) ^ n := map_pow _ r n
        _ = (s * algebraMap _ _ (m : ↑(j.image.presheaf.obj (Opposite.op W_x)))) ^ n := by rw [hrm]
        _ = s ^ n * (algebraMap _ _ (m : ↑(j.image.presheaf.obj (Opposite.op W_x)))) ^ n :=
            mul_pow _ _ _
        _ = 0 := by rw [hn, zero_mul]
    obtain ⟨c, hc⟩ :=
      (IsLocalization.map_eq_zero_iff (hWx.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
        ↑(j.image.presheaf.stalk x) (r ^ n)).mp hpow
    have hcr_nil : ((c : ↑(j.image.presheaf.obj (Opposite.op W_x))) * r) ^ (n + 1) = 0 := by
      have hc' : (c : ↑(j.image.presheaf.obj (Opposite.op W_x))) * r ^ n = 0 := hc
      calc
        ((c : ↑(j.image.presheaf.obj (Opposite.op W_x))) * r) ^ (n + 1)
            = (c : ↑(j.image.presheaf.obj (Opposite.op W_x))) ^ n * r *
                ((c : ↑(j.image.presheaf.obj (Opposite.op W_x))) * r ^ n) := by ring
        _ = 0 := by rw [hc', mul_zero]
    have hcr_zero : (c : ↑(j.image.presheaf.obj (Opposite.op W_x))) * r = 0 :=
      hRed_Wx.eq_zero _ ⟨n + 1, hcr_nil⟩
    have hr_map_zero : algebraMap ↑(j.image.presheaf.obj (Opposite.op W_x))
        ↑(j.image.presheaf.stalk x) r = 0 :=
      (IsLocalization.map_eq_zero_iff (hWx.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
        ↑(j.image.presheaf.stalk x) r).mpr ⟨c, hcr_zero⟩
    have hsm_zero : s * algebraMap ↑(j.image.presheaf.obj (Opposite.op W_x))
        ↑(j.image.presheaf.stalk x) (m : ↑(j.image.presheaf.obj (Opposite.op W_x))) = 0 := by
      rwa [hr_map_zero] at hrm
    have hm_unit := IsLocalization.map_units ↑(j.image.presheaf.stalk x) m
    exact (hm_unit.mul_left_eq_zero).mp hsm_zero
  have : AlgebraicGeometry.IsReduced j.image :=
    AlgebraicGeometry.isReduced_of_isReduced_stalk j.image
  exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced j.image

theorem weil_schematic_closure_iso_on_flat_open_over_integral (B P : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral B]
    (U_B : B.Opens)
    (hUB : Nonempty U_B)
    (p₂ : P ⟶ B)
    [AlgebraicGeometry.QuasiCompact
      (AlgebraicGeometry.Scheme.Opens.ι (X := P) ((TopologicalSpace.Opens.map p₂.base).obj U_B))]
    (W_P : P.Opens)
    [AlgebraicGeometry.Flat (W_P.ι ≫ p₂)] :
    CategoryTheory.IsIso
      ((AlgebraicGeometry.Scheme.Opens.ι (X := P)
        ((TopologicalSpace.Opens.map p₂.base).obj U_B)).imageι ∣_ W_P) :=
by
  let 𝒰 : P.Opens := (TopologicalSpace.Opens.map p₂.base).obj U_B
  let j : 𝒰.toScheme ⟶ P := 𝒰.ι
  let ι : j.image ⟶ P := j.imageι
  have : AlgebraicGeometry.IsClosedImmersion (ι ∣_ W_P) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (AlgebraicGeometry.isPullback_morphismRestrict ι W_P).flip inferInstance
  rw [AlgebraicGeometry.IsClosedImmersion.isIso_iff_ker_eq_bot]
  apply AlgebraicGeometry.Scheme.IdealSheafData.ext
  funext W
  rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, Submodule.eq_bot_iff]
  intro s hs
  refine TopCat.Presheaf.IsSheaf.section_ext (F := W_P.toScheme.presheaf)
    W_P.toScheme.sheaf.property fun x hxW => ?_
  let g : W_P.toScheme ⟶ B := W_P.ι ≫ p₂
  obtain ⟨U'_B, hU'_B, hx_U'_B, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := g.base x) (U := ⊤) trivial
  have hx_O : x ∈ (TopologicalSpace.Opens.map g.base).obj U'_B := hx_U'_B
  obtain ⟨f, e₀, hx_V₀⟩ :=
    W.2.exists_basicOpen_le (⟨x, hx_O⟩ : ↥((TopologicalSpace.Opens.map g.base).obj U'_B)) hxW
  have hV₀_le : W_P.toScheme.basicOpen f ≤ W.1 := W_P.toScheme.basicOpen_le f
  refine ⟨W_P.toScheme.basicOpen f, hV₀_le, hx_V₀, ?_⟩
  let V₀ : W_P.toScheme.Opens := W_P.toScheme.basicOpen f
  let s₀ : ↑(W_P.toScheme.presheaf.obj (Opposite.op V₀)) :=
    (W_P.toScheme.presheaf.map (CategoryTheory.homOfLE hV₀_le).op).hom s
  change s₀ = (W_P.toScheme.presheaf.map (CategoryTheory.homOfLE hV₀_le).op).hom 0
  rw [map_zero]
  have hs₀_mem : s₀ ∈ ((ι ∣_ W_P).ker).ideal (W_P.toScheme.affineBasicOpen f) := by
    rw [← AlgebraicGeometry.Scheme.IdealSheafData.map_ideal_basicOpen]
    exact Ideal.mem_map_of_mem _ hs
  let V_P : P.Opens := (W_P.ι.opensFunctor).obj V₀
  have hV_P : AlgebraicGeometry.IsAffineOpen V_P :=
    (W_P.toScheme.affineBasicOpen f).2.image_of_isOpenImmersion W_P.ι
  let s₀' : ↑(P.presheaf.obj (Opposite.op V_P)) := s₀
  change s₀' = 0
  have hs₀_ker : s₀' ∈ RingHom.ker (j.app V_P).hom := by
    have hker_eq : ((ι ∣_ W_P).ker).ideal (W_P.toScheme.affineBasicOpen f) =
        RingHom.ker (j.app V_P).hom := by
      rw [AlgebraicGeometry.Scheme.ker_morphismRestrict_ideal]
      have hι_ker : ι.ker = j.ker := AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι j.ker
      rw [hι_ker]
      exact j.ker_apply ⟨V_P, hV_P⟩
    exact hker_eq ▸ hs₀_mem
  have hs₀_j : (j.app V_P).hom s₀' = 0 := hs₀_ker
  have : IrreducibleSpace ↥B := AlgebraicGeometry.irreducibleSpace_of_isIntegral B
  obtain ⟨⟨b₀, hb₀⟩⟩ := hUB
  obtain ⟨b₁, hb₁_U'_B, hb₁_UB⟩ :=
    nonempty_preirreducible_inter U'_B.isOpen U_B.isOpen ⟨g.base x, hx_U'_B⟩ ⟨b₀, hb₀⟩
  obtain ⟨a, ha_UB, hb₁_a⟩ := hU'_B.exists_basicOpen_le (⟨b₁, hb₁_UB⟩ : ↥U_B) hb₁_U'_B
  have ha_ne : a ≠ 0 := by
    intro ha0
    rw [ha0, AlgebraicGeometry.Scheme.basicOpen_zero] at hb₁_a
    exact hb₁_a
  have : Nonempty ↥U'_B.toScheme := ⟨⟨g.base x, hx_U'_B⟩⟩
  have : IsDomain ↑(B.presheaf.obj (Opposite.op U'_B)) :=
    AlgebraicGeometry.IsIntegral.component_integral U'_B
  have ha_nzd : a ∈ nonZeroDivisors ↑(B.presheaf.obj (Opposite.op U'_B)) :=
    mem_nonZeroDivisors_of_ne_zero ha_ne
  have hφ_flat : (g.appLE U'_B V₀ e₀).hom.Flat :=
    g.flat_appLE hU'_B (W_P.toScheme.affineBasicOpen f).2 e₀
  let r_a : ↑(P.presheaf.obj (Opposite.op V_P)) := (g.appLE U'_B V₀ e₀).hom a
  have hra_nzd : r_a ∈ nonZeroDivisors ↑(P.presheaf.obj (Opposite.op V_P)) := by
    let _ : Algebra ↑(B.presheaf.obj (Opposite.op U'_B)) ↑(P.presheaf.obj (Opposite.op V_P)) :=
      (g.appLE U'_B V₀ e₀).hom.toAlgebra
    have : Module.Flat ↑(B.presheaf.obj (Opposite.op U'_B)) ↑(P.presheaf.obj (Opposite.op V_P)) :=
      RingHom.flat_algebraMap_iff.mp hφ_flat
    have hreg : IsSMulRegular ↑(P.presheaf.obj (Opposite.op V_P)) a :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors ha_nzd
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    apply hreg.right_eq_zero_of_smul
    change r_a * y = 0
    rwa [mul_comm]
  have hpow_le : Submonoid.powers r_a ≤ nonZeroDivisors ↑(P.presheaf.obj (Opposite.op V_P)) :=
    Submonoid.powers_le.mpr hra_nzd
  have : IsLocalization.Away r_a ↑(P.presheaf.obj (Opposite.op (P.basicOpen r_a))) :=
    hV_P.isLocalization_basicOpen r_a
  have hinj : Function.Injective
      (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le r_a)).op).hom :=
    IsLocalization.injective ↑(P.presheaf.obj (Opposite.op (P.basicOpen r_a))) hpow_le
  have e_P : V_P ≤ (TopologicalSpace.Opens.map p₂.base).obj U'_B := by
    rintro _ ⟨y, hy, rfl⟩
    exact e₀ hy
  have hra_open : P.basicOpen r_a = V_P ⊓ (TopologicalSpace.Opens.map p₂.base).obj (B.basicOpen a) := by
    have h_app : g.appLE U'_B V₀ e₀ =
        p₂.app U'_B ≫ P.presheaf.map (CategoryTheory.homOfLE e_P).op :=
      (AlgebraicGeometry.Scheme.Hom.comp_appLE W_P.ι p₂ U'_B V₀ e₀).trans
        (congr_arg (p₂.app U'_B ≫ ·)
          (AlgebraicGeometry.Scheme.Opens.ι_appLE W_P
            ((TopologicalSpace.Opens.map p₂.base).obj U'_B) V₀ e₀))
    have hra_eq : r_a =
        (P.presheaf.map (CategoryTheory.homOfLE e_P).op).hom ((p₂.app U'_B).hom a) :=
      congr_arg (fun φ => φ.hom a) h_app
    rw [hra_eq, AlgebraicGeometry.Scheme.basicOpen_res, ← p₂.preimage_basicOpen]
  have h_le1 : (j.opensFunctor).obj ((TopologicalSpace.Opens.map j.base).obj V_P) ≤ V_P := by
    rintro _ ⟨y, hy, rfl⟩
    exact hy
  have h_le2 : P.basicOpen r_a ≤ (j.opensFunctor).obj ((TopologicalSpace.Opens.map j.base).obj V_P) := by
    intro z hz
    rw [hra_open] at hz
    have hz_𝒰 : z ∈ 𝒰 := ha_UB hz.2
    exact ⟨⟨z, hz_𝒰⟩, hz.1, rfl⟩
  have hj_app : j.app V_P = P.presheaf.map (CategoryTheory.homOfLE h_le1).op :=
    AlgebraicGeometry.Scheme.Opens.ι_app 𝒰 V_P
  have hs₀_le1 : (P.presheaf.map (CategoryTheory.homOfLE h_le1).op).hom s₀' = 0 :=
    (congr_arg (fun φ => φ.hom s₀') hj_app.symm).trans hs₀_j
  have h_map_fac :
      P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le r_a)).op =
        P.presheaf.map (CategoryTheory.homOfLE h_le1).op ≫
          P.presheaf.map (CategoryTheory.homOfLE h_le2).op :=
    (congr_arg P.presheaf.map (Subsingleton.elim _
      ((CategoryTheory.homOfLE h_le1).op ≫ (CategoryTheory.homOfLE h_le2).op))).trans
      (P.presheaf.map_comp (CategoryTheory.homOfLE h_le1).op (CategoryTheory.homOfLE h_le2).op)
  apply hinj
  have h_eval :
      (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le r_a)).op).hom s₀' =
        (P.presheaf.map (CategoryTheory.homOfLE h_le2).op).hom
          ((P.presheaf.map (CategoryTheory.homOfLE h_le1).op).hom s₀') :=
    congr_arg (fun φ => φ.hom s₀') h_map_fac
  rw [h_eval, hs₀_le1, map_zero, map_zero]

theorem weil_curve_fib_surjective_closed_immersion_pullback (k : Type u) [Field k]
    {B₀ V₁ B₂ X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (U₀ : B₀.left.Opens)
    (f₁ : V₁ ⟶ B₀)
    (ψ₀ : B₂ ⟶ B₀)
    (f₂ : X₂ ⟶ B₂)
    (φ₂ : X₂ ⟶ V₁)
    (ιX₂ : X₂.left ⟶ CategoryTheory.Limits.pullback f₁.left ψ₀.left)
    [AlgebraicGeometry.IsClosedImmersion ιX₂]
    (hf₂ : ιX₂ ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left = f₂.left)
    (hφ₂ : ιX₂ ≫ CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left = φ₂.left)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀)
    (hIsoU₀ : CategoryTheory.IsIso
      (ιX₂ ∣_ ((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left).base).obj
        ((TopologicalSpace.Opens.map ψ₀.left.base).obj U₀))))
    (hSmRange : ∀ W : V₁.left.Opens,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) →
      (CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left).base ⁻¹' (W : Set V₁.left) ⊆
        Set.range ιX₂.base)
    (hSmPull : ∀ W : V₁.left.Opens,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Scheme.Opens.ι (X := X₂.left)
          ((TopologicalSpace.Opens.map φ₂.left.base).obj W) ≫ f₂.left)) :
    AlgebraicGeometry.Surjective ιX₂ ∧
      IsEquidimGenSmoothCurveFibOver k f₂ ((TopologicalSpace.Opens.map ψ₀.left.base).obj U₀) :=
by
  let P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₁.left ψ₀.left
  let p₁ : P ⟶ V₁.left := CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left
  let p₂ : P ⟶ B₂.left := CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left
  let UB₂ : B₂.left.Opens := (TopologicalSpace.Opens.map ψ₀.left.base).obj U₀
  let 𝒰₂ : P.Opens := (TopologicalSpace.Opens.map p₂.base).obj UB₂
  have hPb : CategoryTheory.IsPullback p₁ p₂ f₁.left ψ₀.left :=
    CategoryTheory.IsPullback.of_hasPullback f₁.left ψ₀.left
  have hφf : φ₂.left ≫ f₁.left = f₂.left ≫ ψ₀.left := by
    rw [← hφ₂, ← hf₂, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc]
  let θ : ∀ {S : AlgebraicGeometry.Scheme.{u}} (s : S ⟶ B₂.left),
      CategoryTheory.Limits.pullback f₁.left (s ≫ ψ₀.left) ⟶ P :=
    fun s => CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst f₁.left (s ≫ ψ₀.left))
      (CategoryTheory.Limits.pullback.snd f₁.left (s ≫ ψ₀.left) ≫ s)
      (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
  have hθ_fst : ∀ {S : AlgebraicGeometry.Scheme.{u}} (s : S ⟶ B₂.left),
      θ s ≫ p₁ = CategoryTheory.Limits.pullback.fst f₁.left (s ≫ ψ₀.left) :=
    fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hθ_snd : ∀ {S : AlgebraicGeometry.Scheme.{u}} (s : S ⟶ B₂.left),
      θ s ≫ p₂ = CategoryTheory.Limits.pullback.snd f₁.left (s ≫ ψ₀.left) ≫ s :=
    fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_θ : ∀ {S : AlgebraicGeometry.Scheme.{u}} (s : S ⟶ B₂.left),
      CategoryTheory.IsPullback (θ s)
        (CategoryTheory.Limits.pullback.snd f₁.left (s ≫ ψ₀.left)) p₂ s := by
    intro S s
    have hPb_outer : CategoryTheory.IsPullback (θ s ≫ p₁)
        (CategoryTheory.Limits.pullback.snd f₁.left (s ≫ ψ₀.left))
        f₁.left (s ≫ ψ₀.left) := by
      rw [hθ_fst s]
      exact CategoryTheory.IsPullback.of_hasPullback f₁.left (s ≫ ψ₀.left)
    exact CategoryTheory.IsPullback.of_right hPb_outer (hθ_snd s) hPb
  have hSurj_ιX₂ : AlgebraicGeometry.Surjective ιX₂ := by
    constructor
    intro z
    let b₂ : ↥B₂.left := p₂.base z
    let K_b : Type u := AlgebraicClosure ↥(B₂.left.residueField b₂)
    let ι_b : AlgebraicGeometry.Spec (CommRingCat.of K_b) ⟶
        AlgebraicGeometry.Spec (B₂.left.residueField b₂) :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥(B₂.left.residueField b₂) K_b))
    let s_b : AlgebraicGeometry.Spec (CommRingCat.of K_b) ⟶ B₂.left :=
      ι_b ≫ B₂.left.fromSpecResidueField b₂
    let pt_b : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_b)) := default
    have hs_b_pt : p₂.base z = s_b.base pt_b :=
      (AlgebraicGeometry.Scheme.fromSpecResidueField_apply b₂ (ι_b.base pt_b)).symm
    obtain ⟨z₀, hz₀_θ, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback (hPb_θ s_b) z pt_b hs_b_pt
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of K_b) ⟶ B₀.left := s_b ≫ ψ₀.left
    let F₁ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₁.left s₀
    let E₀ : Set ↥F₁ := irreducibleComponent z₀
    have hz₀_E₀ : z₀ ∈ E₀ := mem_irreducibleComponent
    have hE₀_mem : E₀ ∈ irreducibleComponents ↥F₁ :=
      irreducibleComponent_mem_irreducibleComponents z₀
    have hE₀_pre : IsPreirreducible E₀ :=
      isIrreducible_irreducibleComponent.isPreirreducible
    obtain ⟨q₀, W, hq₀_E₀, hq₀_W, hSmW⟩ := ((hFib₁.2.2.2 K_b s₀).2 E₀ hE₀_mem).2
    let C₀ : Set ↥F₁ := (θ s_b).base ⁻¹' Set.range ιX₂.base
    have hC₀_closed : IsClosed C₀ :=
      ιX₂.isClosedEmbedding.isClosed_range.preimage (θ s_b).continuous
    let O_W : Set ↥F₁ :=
      (CategoryTheory.Limits.pullback.fst f₁.left s₀).base ⁻¹' (W : Set ↥V₁.left)
    have hOW_open : IsOpen O_W :=
      W.isOpen.preimage (CategoryTheory.Limits.pullback.fst f₁.left s₀).continuous
    have hOW_sub : O_W ⊆ C₀ := by
      intro y hy
      apply hSmRange W hSmW
      have h_eq_y : p₁.base ((θ s_b).base y) =
          (CategoryTheory.Limits.pullback.fst f₁.left s₀).base y :=
        congr_fun (congr_arg (fun h : F₁ ⟶ V₁.left => ⇑h.base) (hθ_fst s_b)) y
      change p₁.base ((θ s_b).base y) ∈ (W : Set ↥V₁.left)
      rwa [h_eq_y]
    have hz₀_C₀ : z₀ ∈ C₀ := by
      by_contra hz₀_not
      obtain ⟨w, _, hw_not, hw_OW⟩ :=
        hE₀_pre C₀ᶜ O_W hC₀_closed.isOpen_compl hOW_open
          ⟨z₀, hz₀_E₀, hz₀_not⟩ ⟨q₀, hq₀_E₀, hq₀_W⟩
      exact hw_not (hOW_sub hw_OW)
    change (θ s_b).base z₀ ∈ Set.range ιX₂.base at hz₀_C₀
    rwa [hz₀_θ] at hz₀_C₀
  have hProp_p₂ : AlgebraicGeometry.IsProper p₂ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hFib₁.1
  have hSurj_p₂ : AlgebraicGeometry.Surjective p₂ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hFib₁.2.1
  have hProp_f₂ : AlgebraicGeometry.IsProper f₂.left := by
    rw [← hf₂]
    exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsProper)
      ιX₂ p₂ inferInstance hProp_p₂
  have hSurj_f₂ : AlgebraicGeometry.Surjective f₂.left := by
    rw [← hf₂]
    infer_instance
  have hSm_f₂_UB₂ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₂.left ∣_ UB₂) := by
    let g_U2 : 𝒰₂.toScheme ⟶ UB₂.toScheme := p₂ ∣_ UB₂
    have hPb_gU2_p₂ : CategoryTheory.IsPullback 𝒰₂.ι g_U2 p₂ UB₂.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict p₂ UB₂).flip
    have hPb_gU2_f₁ : CategoryTheory.IsPullback (𝒰₂.ι ≫ p₁) g_U2 f₁.left (UB₂.ι ≫ ψ₀.left) :=
      hPb_gU2_p₂.paste_horiz hPb
    let U_V₁0 : V₁.left.Opens := (TopologicalSpace.Opens.map f₁.left.base).obj U₀
    have h_range_q₁ : Set.range (𝒰₂.ι ≫ p₁).base ⊆ Set.range U_V₁0.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      change f₁.left.base (p₁.base (𝒰₂.ι.base z)) ∈ U₀
      have hz : ψ₀.left.base (p₂.base (𝒰₂.ι.base z)) ∈ U₀ := z.2
      have hcomm_z : f₁.left.base (p₁.base (𝒰₂.ι.base z)) =
          ψ₀.left.base (p₂.base (𝒰₂.ι.base z)) :=
        congr_fun (congr_arg (fun h : P ⟶ B₀.left => ⇑h.base) hPb.w) (𝒰₂.ι.base z)
      rwa [hcomm_z]
    let q₁ : 𝒰₂.toScheme ⟶ U_V₁0.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_V₁0.ι (𝒰₂.ι ≫ p₁) h_range_q₁
    have hq₁_fac : q₁ ≫ U_V₁0.ι = 𝒰₂.ι ≫ p₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_V₁0.ι (𝒰₂.ι ≫ p₁) h_range_q₁
    have hψ_fac : (ψ₀.left ∣_ U₀) ≫ U₀.ι = UB₂.ι ≫ ψ₀.left :=
      AlgebraicGeometry.morphismRestrict_ι ψ₀.left U₀
    have h_sq_q₁ : q₁ ≫ (f₁.left ∣_ U₀) = g_U2 ≫ (ψ₀.left ∣_ U₀) := by
      rw [← CategoryTheory.cancel_mono U₀.ι]
      calc
        (q₁ ≫ (f₁.left ∣_ U₀)) ≫ U₀.ι
            = q₁ ≫ ((f₁.left ∣_ U₀) ≫ U₀.ι) := CategoryTheory.Category.assoc _ _ _
        _ = q₁ ≫ (U_V₁0.ι ≫ f₁.left) := by rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (q₁ ≫ U_V₁0.ι) ≫ f₁.left := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (𝒰₂.ι ≫ p₁) ≫ f₁.left := by rw [hq₁_fac]
        _ = g_U2 ≫ (UB₂.ι ≫ ψ₀.left) := hPb_gU2_f₁.w
        _ = g_U2 ≫ ((ψ₀.left ∣_ U₀) ≫ U₀.ι) := by rw [← hψ_fac]
        _ = (g_U2 ≫ (ψ₀.left ∣_ U₀)) ≫ U₀.ι := (CategoryTheory.Category.assoc _ _ _).symm
    have hPb_outer : CategoryTheory.IsPullback (q₁ ≫ U_V₁0.ι) g_U2
        f₁.left ((ψ₀.left ∣_ U₀) ≫ U₀.ι) := by
      rwa [hq₁_fac, hψ_fac]
    have hPb_left : CategoryTheory.IsPullback q₁ g_U2 (f₁.left ∣_ U₀) (ψ₀.left ∣_ U₀) :=
      CategoryTheory.IsPullback.of_right hPb_outer h_sq_q₁
        (AlgebraicGeometry.isPullback_morphismRestrict f₁.left U₀).flip
    have hSm_gU2 : AlgebraicGeometry.SmoothOfRelativeDimension 1 g_U2 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_left hFib₁.2.2.1
    rw [← hf₂, AlgebraicGeometry.morphismRestrict_comp]
    have : CategoryTheory.IsIso (ιX₂ ∣_ (p₂ ⁻¹ᵁ UB₂)) := hIsoU₀
    have hp_iso : CategoryTheory.IsPullback (ιX₂ ∣_ (p₂ ⁻¹ᵁ UB₂))
        ((ιX₂ ∣_ (p₂ ⁻¹ᵁ UB₂)) ≫ (p₂ ∣_ UB₂)) (p₂ ∣_ UB₂) (𝟙 UB₂.toScheme) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by simp⟩
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_iso hSm_gU2
  refine ⟨hSurj_ιX₂, hProp_f₂, hSurj_f₂, hSm_f₂_UB₂, ?_⟩
  intro K _ _ s
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₀.left := s ≫ ψ₀.left
  let F₂ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₂.left s
  let F₁ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₁.left s₀
  let fst₂ : F₂ ⟶ X₂.left := CategoryTheory.Limits.pullback.fst f₂.left s
  let snd₂ : F₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
    CategoryTheory.Limits.pullback.snd f₂.left s
  let fst₀ : F₁ ⟶ V₁.left := CategoryTheory.Limits.pullback.fst f₁.left s₀
  let snd₀ : F₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
    CategoryTheory.Limits.pullback.snd f₁.left s₀
  let Φ_s : F₂ ⟶ F₁ := CategoryTheory.Limits.pullback.lift (fst₂ ≫ φ₂.left) snd₂ (by
    change (fst₂ ≫ φ₂.left) ≫ f₁.left = snd₂ ≫ (s ≫ ψ₀.left)
    rw [CategoryTheory.Category.assoc, hφf, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc])
  have hΦ_fst : Φ_s ≫ fst₀ = fst₂ ≫ φ₂.left :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΦ_snd : Φ_s ≫ snd₀ = snd₂ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have h_sq_Φ : Φ_s ≫ θ s = fst₂ ≫ ιX₂ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc
        (Φ_s ≫ θ s) ≫ p₁ = Φ_s ≫ (θ s ≫ p₁) := CategoryTheory.Category.assoc _ _ _
        _ = Φ_s ≫ fst₀ := by rw [hθ_fst s]
        _ = fst₂ ≫ φ₂.left := hΦ_fst
        _ = fst₂ ≫ (ιX₂ ≫ p₁) := by rw [← hφ₂]
        _ = (fst₂ ≫ ιX₂) ≫ p₁ := (CategoryTheory.Category.assoc _ _ _).symm
    · calc
        (Φ_s ≫ θ s) ≫ p₂ = Φ_s ≫ (θ s ≫ p₂) := CategoryTheory.Category.assoc _ _ _
        _ = Φ_s ≫ (snd₀ ≫ s) := by rw [hθ_snd s]
        _ = (Φ_s ≫ snd₀) ≫ s := (CategoryTheory.Category.assoc _ _ _).symm
        _ = snd₂ ≫ s := by rw [hΦ_snd]
        _ = fst₂ ≫ f₂.left := CategoryTheory.Limits.pullback.condition.symm
        _ = fst₂ ≫ (ιX₂ ≫ p₂) := by rw [← hf₂]
        _ = (fst₂ ≫ ιX₂) ≫ p₂ := (CategoryTheory.Category.assoc _ _ _).symm
  have hPb_Φ_outer : CategoryTheory.IsPullback (Φ_s ≫ snd₀) fst₂ s (ιX₂ ≫ p₂) := by
    rw [hΦ_snd, hf₂]
    exact (CategoryTheory.IsPullback.of_hasPullback f₂.left s).flip
  have hPb_Φ : CategoryTheory.IsPullback fst₂ Φ_s ιX₂ (θ s) :=
    (CategoryTheory.IsPullback.of_right hPb_Φ_outer h_sq_Φ (hPb_θ s).flip).flip
  have hCl_Φ : AlgebraicGeometry.IsClosedImmersion Φ_s :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Φ inferInstance
  have hSurj_Φ : AlgebraicGeometry.Surjective Φ_s :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Φ hSurj_ιX₂
  let e_s : ↥F₂ ≃ₜ ↥F₁ :=
    Φ_s.isClosedEmbedding.isEmbedding.toHomeomorphOfSurjective Φ_s.surjective
  have he_s_apply : ∀ x : ↥F₂, e_s x = Φ_s.base x :=
    Topology.IsEmbedding.toHomeomorphOfSurjective_apply _ _
  have hConn_F₁ : ConnectedSpace ↥F₁ := (hFib₁.2.2.2 K s₀).1
  have hConn_F₂ : ConnectedSpace ↥F₂ :=
    e_s.symm.surjective.connectedSpace e_s.symm.continuous
  refine ⟨hConn_F₂, ?_⟩
  intro E hE
  have hE₁ : ⇑e_s '' E ∈ irreducibleComponents ↥F₁ :=
    image_mem_irreducibleComponents_of_isPreirreducible_fiber (⇑e_s)
      e_s.continuous e_s.isOpenMap
      (fun y => (show Set.Subsingleton (⇑e_s ⁻¹' {y}) from
        fun u hu v hv => e_s.injective (hu.trans hv.symm)).isPreirreducible)
      e_s.surjective hE
  obtain ⟨hDim₁, q₁, W₁, hq₁_E₁, hq₁_W₁, hSmW₁⟩ := (hFib₁.2.2.2 K s₀).2 (⇑e_s '' E) hE₁
  have hDim_E : topologicalKrullDim ↥E = (1 : WithBot ℕ∞) :=
    ((e_s.image E).isHomeomorph.topologicalKrullDim_eq).trans hDim₁
  refine ⟨hDim_E, e_s.symm q₁, (TopologicalSpace.Opens.map φ₂.left.base).obj W₁, ?_, ?_, ?_⟩
  · obtain ⟨w, hwE, rfl⟩ := hq₁_E₁
    simpa using hwE
  · change φ₂.left.base (fst₂.base (e_s.symm q₁)) ∈ W₁
    have h_eq : φ₂.left.base (fst₂.base (e_s.symm q₁)) = fst₀.base q₁ := by
      have h_eq1 : φ₂.left.base (fst₂.base (e_s.symm q₁)) =
          fst₀.base (Φ_s.base (e_s.symm q₁)) :=
        congr_fun (congr_arg (fun h : F₂ ⟶ V₁.left => ⇑h.base) hΦ_fst.symm) (e_s.symm q₁)
      rw [h_eq1, ← he_s_apply, e_s.apply_symm_apply]
    rwa [h_eq]
  · exact hSmPull W₁ hSmW₁

theorem weil_algClosed_strict_transform_curve_fib_pullback (k : Type u) [Field k] [IsAlgClosed k]
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hIntB₀ : AlgebraicGeometry.IsIntegral B₀.left)
    (hU₀ : Nonempty U₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hProjV₁ : IsProjectiveOverField k V₁)
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀)
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ψ₀ : B₂ ⟶ B₀)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (hFinψ₀ : AlgebraicGeometry.IsFinite ψ₀.left)
    (hAltψ₀ : IsGenFiniteEtaleAlterationOver k ψ₀) :
    ∃ (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f₂ : X₂ ⟶ B₂)
      (φ₂ : X₂ ⟶ V₁)
      (ιX₂ : X₂.left ⟶ CategoryTheory.Limits.pullback f₁.left ψ₀.left),
      AlgebraicGeometry.IsIntegral X₂.left ∧
      AlgebraicGeometry.IsClosedImmersion ιX₂ ∧
      AlgebraicGeometry.Surjective ιX₂ ∧
      ιX₂ ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left = f₂.left ∧
      ιX₂ ≫ CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left = φ₂.left ∧
      φ₂ ≫ f₁ = f₂ ≫ ψ₀ ∧
      AlgebraicGeometry.IsFinite φ₂.left ∧
      AlgebraicGeometry.Surjective φ₂.left ∧
      IsGenFiniteEtaleAlterationOver k φ₂ ∧
      IsEquidimGenSmoothCurveFibOver k f₂ ((TopologicalSpace.Opens.map ψ₀.left.base).obj U₀) ∧
      (∀ W : V₁.left.Opens,
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) →
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (AlgebraicGeometry.Scheme.Opens.ι (X := X₂.left)
            ((TopologicalSpace.Opens.map φ₂.left.base).obj W) ≫ f₂.left)) :=
by
  
  let P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₁.left ψ₀.left
  let p₁ : P ⟶ V₁.left := CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left
  let p₂ : P ⟶ B₂.left := CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left
  let UB₂ : B₂.left.Opens := (TopologicalSpace.Opens.map ψ₀.left.base).obj U₀
  let 𝒰₂ : P.Opens := (TopologicalSpace.Opens.map p₂.base).obj UB₂
  let j : 𝒰₂.toScheme ⟶ P := 𝒰₂.ι
  let ιX₂ : j.image ⟶ P := j.imageι
  let X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (ιX₂ ≫ p₂ ≫ B₂.hom)
  let f₂ : X₂ ⟶ B₂ := CategoryTheory.Over.homMk (ιX₂ ≫ p₂) rfl
  have hφ₂_w : (ιX₂ ≫ p₁) ≫ V₁.hom = X₂.hom := by
    change (ιX₂ ≫ p₁) ≫ V₁.hom = ιX₂ ≫ p₂ ≫ B₂.hom
    rw [← CategoryTheory.Over.w f₁, ← CategoryTheory.Over.w ψ₀]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc p₁, CategoryTheory.Limits.pullback.condition,
      CategoryTheory.Category.assoc]
  let φ₂ : X₂ ⟶ V₁ := CategoryTheory.Over.homMk (ιX₂ ≫ p₁) hφ₂_w
  have hf₂ : ιX₂ ≫ p₂ = f₂.left := rfl
  have hφ₂ : ιX₂ ≫ p₁ = φ₂.left := rfl
  have hcomm : φ₂ ≫ f₁ = f₂ ≫ ψ₀ := by
    ext1
    change (ιX₂ ≫ p₁) ≫ f₁.left = (ιX₂ ≫ p₂) ≫ ψ₀.left
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc]
  have hPb : CategoryTheory.IsPullback p₁ p₂ f₁.left ψ₀.left :=
    CategoryTheory.IsPullback.of_hasPullback f₁.left ψ₀.left
  have hProp_f₁ : AlgebraicGeometry.IsProper f₁.left := hFib₁.1
  have hSurj_f₁ : AlgebraicGeometry.Surjective f₁.left := hFib₁.2.1
  have hSm_f₁U₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U₀) := hFib₁.2.2.1
  have hSurj_ψ₀ : AlgebraicGeometry.Surjective ψ₀.left := hAltψ₀.2.1
  have hFin_p₁ : AlgebraicGeometry.IsFinite p₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hFinψ₀
  have hSurj_p₁ : AlgebraicGeometry.Surjective p₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hSurj_ψ₀
  have hProp_p₂ : AlgebraicGeometry.IsProper p₂ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hProp_f₁

  
  have hQC_j : AlgebraicGeometry.QuasiCompact j := by
    obtain ⟨N, ι₁, hClι₁⟩ := hProjV₁
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj_𝒜0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro x
      have hx : (x : MvPolynomial (Fin (N + 1)) k) ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        simpa [𝒜, MvPolynomial.homogeneousSubmodule_zero] using x.2
      rw [Submodule.mem_one] at hx
      obtain ⟨c, hc⟩ := hx
      exact ⟨c, Subtype.ext hc⟩
    have : IsNoetherianRing ↥(𝒜 0) :=
      isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) hSurj_𝒜0
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
    let i₁_proj : V₁.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι₁.left
    have : AlgebraicGeometry.IsClosedImmersion i₁_proj := hClι₁
    have hProp_i₁ : AlgebraicGeometry.IsProper i₁_proj := inferInstance
    have hProp_p₁ : AlgebraicGeometry.IsProper p₁ := inferInstance
    have : AlgebraicGeometry.IsProper (p₁ ≫ i₁_proj ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsProper) p₁
        (i₁_proj ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜) hProp_p₁
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsProper) i₁_proj
          (AlgebraicGeometry.Proj.toSpecZero 𝒜) hProp_i₁ inferInstance)
    have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0))) :=
      AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
    have : AlgebraicGeometry.IsLocallyNoetherian P :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
        (p₁ ≫ i₁_proj ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have : CompactSpace ↥P :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
        (p₁ ≫ i₁_proj ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have : AlgebraicGeometry.IsNoetherian P := ⟨⟩
    have : TopologicalSpace.NoetherianSpace ↥P := AlgebraicGeometry.IsNoetherian.noetherianSpace
    have h_emb : Topology.IsEmbedding j.base := 𝒰₂.ι.isOpenEmbedding.isEmbedding
    have h_comp : IsCompact (Set.range j.base) := TopologicalSpace.NoetherianSpace.isCompact _
    have : CompactSpace ↥𝒰₂.toScheme :=
      isCompact_univ_iff.mp (h_emb.isCompact_iff.mpr (by simpa [Set.image_univ] using h_comp))
    have : AlgebraicGeometry.IsLocallyNoetherian 𝒰₂.toScheme :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian j
    have : AlgebraicGeometry.IsNoetherian 𝒰₂.toScheme := ⟨⟩
    have : TopologicalSpace.NoetherianSpace ↥𝒰₂.toScheme :=
      AlgebraicGeometry.IsNoetherian.noetherianSpace
    exact AlgebraicGeometry.quasiCompact_of_noetherianSpace_source j

  
  have hUB₂ : Nonempty UB₂ := by
    obtain ⟨⟨b₀, hb₀⟩⟩ := hU₀
    obtain ⟨hSurj_ψ₀_fn⟩ := hSurj_ψ₀
    obtain ⟨b₂, rfl⟩ := hSurj_ψ₀_fn b₀
    exact ⟨⟨b₂, hb₀⟩⟩
  have hInt_UB₂ : AlgebraicGeometry.IsIntegral UB₂.toScheme := by
    have : Nonempty ↥UB₂.toScheme := hUB₂
    exact AlgebraicGeometry.isIntegral_of_isOpenImmersion UB₂.ι
  let g_U2 : 𝒰₂.toScheme ⟶ UB₂.toScheme := p₂ ∣_ UB₂
  have hPb_gU2_p₂ : CategoryTheory.IsPullback 𝒰₂.ι g_U2 p₂ UB₂.ι :=
    (AlgebraicGeometry.isPullback_morphismRestrict p₂ UB₂).flip
  have hProp_gU2 : AlgebraicGeometry.IsProper g_U2 :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_gU2_p₂ hProp_p₂
  have hPb_gU2_f₁ : CategoryTheory.IsPullback (𝒰₂.ι ≫ p₁) g_U2 f₁.left (UB₂.ι ≫ ψ₀.left) :=
    hPb_gU2_p₂.paste_horiz hPb
  have hSm_gU2 : AlgebraicGeometry.SmoothOfRelativeDimension 1 g_U2 := by
    let U_V₁0 : V₁.left.Opens := (TopologicalSpace.Opens.map f₁.left.base).obj U₀
    have h_range_q₁ : Set.range (𝒰₂.ι ≫ p₁).base ⊆ Set.range U_V₁0.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      change f₁.left.base (p₁.base (𝒰₂.ι.base z)) ∈ U₀
      have hz : ψ₀.left.base (p₂.base (𝒰₂.ι.base z)) ∈ U₀ := z.2
      have hcomm_z : f₁.left.base (p₁.base (𝒰₂.ι.base z)) = ψ₀.left.base (p₂.base (𝒰₂.ι.base z)) :=
        congr_fun (congr_arg (fun h : P ⟶ B₀.left => ⇑h.base) hPb.w) (𝒰₂.ι.base z)
      rwa [hcomm_z]
    let q₁ : 𝒰₂.toScheme ⟶ U_V₁0.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_V₁0.ι (𝒰₂.ι ≫ p₁) h_range_q₁
    have hq₁_fac : q₁ ≫ U_V₁0.ι = 𝒰₂.ι ≫ p₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_V₁0.ι (𝒰₂.ι ≫ p₁) h_range_q₁
    have hψ_fac : (ψ₀.left ∣_ U₀) ≫ U₀.ι = UB₂.ι ≫ ψ₀.left :=
      AlgebraicGeometry.morphismRestrict_ι ψ₀.left U₀
    have h_sq_q₁ : q₁ ≫ (f₁.left ∣_ U₀) = g_U2 ≫ (ψ₀.left ∣_ U₀) := by
      rw [← CategoryTheory.cancel_mono U₀.ι]
      calc
        (q₁ ≫ (f₁.left ∣_ U₀)) ≫ U₀.ι
            = q₁ ≫ ((f₁.left ∣_ U₀) ≫ U₀.ι) := CategoryTheory.Category.assoc _ _ _
        _ = q₁ ≫ (U_V₁0.ι ≫ f₁.left) := by rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (q₁ ≫ U_V₁0.ι) ≫ f₁.left := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (𝒰₂.ι ≫ p₁) ≫ f₁.left := by rw [hq₁_fac]
        _ = g_U2 ≫ (UB₂.ι ≫ ψ₀.left) := hPb_gU2_f₁.w
        _ = g_U2 ≫ ((ψ₀.left ∣_ U₀) ≫ U₀.ι) := by rw [← hψ_fac]
        _ = (g_U2 ≫ (ψ₀.left ∣_ U₀)) ≫ U₀.ι := (CategoryTheory.Category.assoc _ _ _).symm
    have hPb_outer : CategoryTheory.IsPullback (q₁ ≫ U_V₁0.ι) g_U2 f₁.left ((ψ₀.left ∣_ U₀) ≫ U₀.ι) := by
      rwa [hq₁_fac, hψ_fac]
    have hPb_left : CategoryTheory.IsPullback q₁ g_U2 (f₁.left ∣_ U₀) (ψ₀.left ∣_ U₀) :=
      CategoryTheory.IsPullback.of_right hPb_outer h_sq_q₁
        (AlgebraicGeometry.isPullback_morphismRestrict f₁.left U₀).flip
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_left hSm_f₁U₀
  have hFlat_gU2 : AlgebraicGeometry.Flat g_U2 := by
    have : AlgebraicGeometry.Smooth g_U2 := AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 g_U2
    infer_instance

  
  have hIntX₂ : AlgebraicGeometry.IsIntegral X₂.left := by
    refine weil_flat_open_generic_integral_schematic_image UB₂.toScheme 𝒰₂.toScheme P g_U2 ?_ j
    intro U hU _hUne
    let A := ↑(UB₂.toScheme.presheaf.obj (Opposite.op U))
    let L : Type u := FractionRing A
    let ξ_U : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ UB₂.toScheme :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A L)) ≫ hU.fromSpec
    let G_L : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g_U2 ξ_U
    let p_GL : G_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of L) :=
      CategoryTheory.Limits.pullback.snd g_U2 ξ_U
    have hPb_GL : CategoryTheory.IsPullback (CategoryTheory.Limits.pullback.fst g_U2 ξ_U) p_GL g_U2 ξ_U :=
      CategoryTheory.IsPullback.of_hasPullback g_U2 ξ_U
    have : AlgebraicGeometry.IsProper p_GL :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_GL hProp_gU2
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_GL :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_GL hSm_gU2
    let L_bar : Type u := AlgebraicClosure L
    let ι_L : AlgebraicGeometry.Spec (CommRingCat.of L_bar) ⟶ AlgebraicGeometry.Spec (CommRingCat.of L) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L L_bar))
    have hSurj_ιL : AlgebraicGeometry.Surjective ι_L := by
      constructor
      intro x
      exact ⟨⟨⊥, inferInstance⟩, Subsingleton.elim _ _⟩
    let G_Lbar : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p_GL ι_L
    have hPb_GLbar : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst p_GL ι_L)
        (CategoryTheory.Limits.pullback.snd p_GL ι_L) p_GL ι_L :=
      CategoryTheory.IsPullback.of_hasPullback p_GL ι_L
    have hSurj_fst_Lbar : AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst p_GL ι_L) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_GLbar.flip hSurj_ιL
    have hPb_tot : CategoryTheory.IsPullback
        ((CategoryTheory.Limits.pullback.fst p_GL ι_L ≫ CategoryTheory.Limits.pullback.fst g_U2 ξ_U) ≫
          (𝒰₂.ι ≫ p₁))
        (CategoryTheory.Limits.pullback.snd p_GL ι_L)
        f₁.left
        ((ι_L ≫ ξ_U) ≫ (UB₂.ι ≫ ψ₀.left)) :=
      (hPb_GLbar.paste_horiz hPb_GL).paste_horiz hPb_gU2_f₁
    let s_bar : AlgebraicGeometry.Spec (CommRingCat.of L_bar) ⟶ B₀.left :=
      (ι_L ≫ ξ_U) ≫ (UB₂.ι ≫ ψ₀.left)
    let iso_fib : G_Lbar ≅ CategoryTheory.Limits.pullback f₁.left s_bar := hPb_tot.isoPullback
    have hConn_fib : ConnectedSpace ↥(CategoryTheory.Limits.pullback f₁.left s_bar) :=
      (hFib₁.2.2.2 L_bar s_bar).1
    let q_surj : CategoryTheory.Limits.pullback f₁.left s_bar ⟶ G_L :=
      iso_fib.inv ≫ CategoryTheory.Limits.pullback.fst p_GL ι_L
    have hSurj_q : AlgebraicGeometry.Surjective q_surj := inferInstance
    obtain ⟨hSurj_q_fn⟩ := hSurj_q
    have hConn_GL : ConnectedSpace ↥G_L :=
      hSurj_q_fn.connectedSpace q_surj.continuous
    exact weil_smooth_one_connected_over_field_isIntegral L G_L p_GL hConn_GL

  
  have hFlat_U2_p₂ : AlgebraicGeometry.Flat (𝒰₂.ι ≫ p₂) := by
    have h_eq : 𝒰₂.ι ≫ p₂ = g_U2 ≫ UB₂.ι :=
      (AlgebraicGeometry.morphismRestrict_ι p₂ UB₂).symm
    rw [h_eq]
    infer_instance
  have hIsoU₀ : CategoryTheory.IsIso (ιX₂ ∣_ 𝒰₂) :=
    weil_schematic_closure_iso_on_flat_open_over_integral B₂.left P UB₂ hUB₂ p₂ 𝒰₂

  have hSmBoth : ∀ W : V₁.left.Opens,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) →
      (p₁.base ⁻¹' (W : Set V₁.left) ⊆ Set.range ιX₂.base) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Scheme.Opens.ι (X := X₂.left)
          ((TopologicalSpace.Opens.map φ₂.left.base).obj W) ≫ f₂.left) := by
    intro W hW
    let W_P : P.Opens := (TopologicalSpace.Opens.map p₁.base).obj W
    have hPb_WP : CategoryTheory.IsPullback (p₁ ∣_ W) (W_P.ι ≫ p₂) (W.ι ≫ f₁.left) ψ₀.left :=
      (AlgebraicGeometry.isPullback_morphismRestrict p₁ W).paste_vert hPb
    have hSm_WP : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_P.ι ≫ p₂) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_WP hW
    have : AlgebraicGeometry.Smooth (W_P.ι ≫ p₂) :=
      AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 (W_P.ι ≫ p₂)
    have : AlgebraicGeometry.Flat (W_P.ι ≫ p₂) := inferInstance
    have : CategoryTheory.IsIso (ιX₂ ∣_ W_P) :=
      weil_schematic_closure_iso_on_flat_open_over_integral B₂.left P UB₂ hUB₂ p₂ W_P
    refine ⟨?_, ?_⟩
    · intro z hz
      have hSurj_WP : AlgebraicGeometry.Surjective (ιX₂ ∣_ W_P) := inferInstance
      obtain ⟨hSurj_WP_fn⟩ := hSurj_WP
      obtain ⟨x', hx'⟩ := hSurj_WP_fn ⟨z, hz⟩
      let W_X₂ : X₂.left.Opens := (TopologicalSpace.Opens.map ιX₂.base).obj W_P
      refine ⟨W_X₂.ι.base x', ?_⟩
      have h_comm_x :=
        congr_fun (congr_arg (fun h : W_X₂.toScheme ⟶ P => ⇑h.base)
          (AlgebraicGeometry.morphismRestrict_ι ιX₂ W_P)) x'
      change W_P.ι.base ((ιX₂ ∣_ W_P).base x') = ιX₂.base (W_X₂.ι.base x') at h_comm_x
      rw [hx'] at h_comm_x
      exact h_comm_x.symm
    · let W_X₂ : X₂.left.Opens := (TopologicalSpace.Opens.map ιX₂.base).obj W_P
      have h_fac : AlgebraicGeometry.Scheme.Opens.ι (X := X₂.left)
          ((TopologicalSpace.Opens.map φ₂.left.base).obj W) ≫ f₂.left =
          (ιX₂ ∣_ W_P) ≫ (W_P.ι ≫ p₂) := by
        change W_X₂.ι ≫ (ιX₂ ≫ p₂) = (ιX₂ ∣_ W_P) ≫ (W_P.ι ≫ p₂)
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι ιX₂ W_P,
          CategoryTheory.Category.assoc]
      rw [h_fac]
      have hp_iso : CategoryTheory.IsPullback (ιX₂ ∣_ W_P) ((ιX₂ ∣_ W_P) ≫ (W_P.ι ≫ p₂))
          (W_P.ι ≫ p₂) (𝟙 B₂.left) :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by simp⟩
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_iso hSm_WP

  have hSmRange : ∀ W : V₁.left.Opens,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) →
      p₁.base ⁻¹' (W : Set V₁.left) ⊆ Set.range ιX₂.base :=
    fun W hW => (hSmBoth W hW).1
  have hSmPull : ∀ W : V₁.left.Opens,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Scheme.Opens.ι (X := X₂.left)
          ((TopologicalSpace.Opens.map φ₂.left.base).obj W) ≫ f₂.left) :=
    fun W hW => (hSmBoth W hW).2

  obtain ⟨hSurj_ιX₂, hFib₂⟩ :=
    weil_curve_fib_surjective_closed_immersion_pullback k U₀ f₁ ψ₀ f₂ φ₂ ιX₂
      hf₂ hφ₂ hFib₁ hIsoU₀ hSmRange hSmPull

  
  have hFin_φ₂ : AlgebraicGeometry.IsFinite φ₂.left := by
    change AlgebraicGeometry.IsFinite (ιX₂ ≫ p₁)
    infer_instance
  have hSurj_φ₂ : AlgebraicGeometry.Surjective φ₂.left := by
    change AlgebraicGeometry.Surjective (ιX₂ ≫ p₁)
    infer_instance
  have hAlt_φ₂ : IsGenFiniteEtaleAlterationOver k φ₂ := by
    refine ⟨inferInstance, hSurj_φ₂, ?_⟩
    obtain ⟨U_et, hU_et_ne, _, hEt_ψ₀, _⟩ := hAltψ₀.2.2
    let U'_0 : B₀.left.Opens := U₀ ⊓ U_et
    have hU'_0_ne : Nonempty U'_0 := by
      have hIrredB₀ : IrreducibleSpace ↥B₀.left :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral B₀.left hIntB₀
      obtain ⟨⟨x₀, hx₀⟩⟩ := hU₀
      obtain ⟨⟨x₁, hx₁⟩⟩ := hU_et_ne
      obtain ⟨y, _, hy₀, hy₁⟩ :=
        hIrredB₀.isPreirreducible_univ U₀ U_et U₀.isOpen U_et.isOpen
          ⟨x₀, trivial, hx₀⟩ ⟨x₁, trivial, hx₁⟩
      exact ⟨⟨y, hy₀, hy₁⟩⟩
    let U_V₁ : V₁.left.Opens := (TopologicalSpace.Opens.map f₁.left.base).obj U'_0
    have hU_V₁_ne : Nonempty U_V₁ := by
      obtain ⟨⟨b₀, hb₀⟩⟩ := hU'_0_ne
      obtain ⟨hSurj_f₁_fn⟩ := hSurj_f₁
      obtain ⟨v₁, rfl⟩ := hSurj_f₁_fn b₀
      exact ⟨⟨v₁, hb₀⟩⟩
    have hFin_φ₂_U : AlgebraicGeometry.IsFinite (φ₂.left ∣_ U_V₁) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict φ₂.left U_V₁).flip hFin_φ₂
    have hSurj_φ₂_U : AlgebraicGeometry.Surjective (φ₂.left ∣_ U_V₁) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict φ₂.left U_V₁).flip hSurj_φ₂
    have hEt_φ₂_U : AlgebraicGeometry.Etale (φ₂.left ∣_ U_V₁) := by
      let O_P : P.Opens := (TopologicalSpace.Opens.map p₁.base).obj U_V₁
      have h_le_O_P : O_P ≤ 𝒰₂ := by
        intro z hz
        change f₁.left.base (p₁.base z) ∈ U'_0 at hz
        have hcomm_z : f₁.left.base (p₁.base z) = ψ₀.left.base (p₂.base z) :=
          congr_fun (congr_arg (fun h : P ⟶ B₀.left => ⇑h.base) hPb.w) z
        rw [hcomm_z] at hz
        exact hz.1
      have h_fac_O_P : O_P.ι ≫ p₂ = P.homOfLE h_le_O_P ≫ (𝒰₂.ι ≫ p₂) := by
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      have : AlgebraicGeometry.Flat (O_P.ι ≫ p₂) := by
        rw [h_fac_O_P]
        infer_instance
      have hIso_OP : CategoryTheory.IsIso (ιX₂ ∣_ O_P) :=
        weil_schematic_closure_iso_on_flat_open_over_integral B₂.left P UB₂ hUB₂ p₂ O_P
      
      have hEt_ψ₀_U'0 : AlgebraicGeometry.Etale (ψ₀.left ∣_ U'_0) := by
        let UB₂_0' : B₂.left.Opens := (TopologicalSpace.Opens.map ψ₀.left.base).obj U'_0
        let UB₂_et : B₂.left.Opens := (TopologicalSpace.Opens.map ψ₀.left.base).obj U_et
        have h_le_B₂ : UB₂_0' ≤ UB₂_et := fun _ hb => hb.2
        have h_sq_B : B₂.left.homOfLE h_le_B₂ ≫ (ψ₀.left ∣_ U_et) =
            (ψ₀.left ∣_ U'_0) ≫ B₀.left.homOfLE inf_le_right := by
          rw [← CategoryTheory.cancel_mono U_et.ι]
          calc
            (B₂.left.homOfLE h_le_B₂ ≫ (ψ₀.left ∣_ U_et)) ≫ U_et.ι
                = B₂.left.homOfLE h_le_B₂ ≫ ((ψ₀.left ∣_ U_et) ≫ U_et.ι) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = B₂.left.homOfLE h_le_B₂ ≫ (UB₂_et.ι ≫ ψ₀.left) := by
                  rw [AlgebraicGeometry.morphismRestrict_ι]
            _ = (B₂.left.homOfLE h_le_B₂ ≫ UB₂_et.ι) ≫ ψ₀.left :=
                  (CategoryTheory.Category.assoc _ _ _).symm
            _ = UB₂_0'.ι ≫ ψ₀.left := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
            _ = (ψ₀.left ∣_ U'_0) ≫ U'_0.ι :=
                  (AlgebraicGeometry.morphismRestrict_ι ψ₀.left U'_0).symm
            _ = (ψ₀.left ∣_ U'_0) ≫ (B₀.left.homOfLE inf_le_right ≫ U_et.ι) := by
                  rw [AlgebraicGeometry.Scheme.homOfLE_ι]
            _ = ((ψ₀.left ∣_ U'_0) ≫ B₀.left.homOfLE inf_le_right) ≫ U_et.ι :=
                  (CategoryTheory.Category.assoc _ _ _).symm
        have hPb_B_outer : CategoryTheory.IsPullback
            (B₂.left.homOfLE h_le_B₂ ≫ UB₂_et.ι)
            (ψ₀.left ∣_ U'_0) ψ₀.left (B₀.left.homOfLE inf_le_right ≫ U_et.ι) := by
          simpa [AlgebraicGeometry.Scheme.homOfLE_ι] using
            (AlgebraicGeometry.isPullback_morphismRestrict ψ₀.left U'_0).flip
        have hPb_B_left : CategoryTheory.IsPullback (B₂.left.homOfLE h_le_B₂) (ψ₀.left ∣_ U'_0)
            (ψ₀.left ∣_ U_et) (B₀.left.homOfLE inf_le_right) :=
          CategoryTheory.IsPullback.of_right hPb_B_outer h_sq_B
            (AlgebraicGeometry.isPullback_morphismRestrict ψ₀.left U_et).flip
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hPb_B_left hEt_ψ₀
      
      have hEt_p₁_UV₁ : AlgebraicGeometry.Etale (p₁ ∣_ U_V₁) := by
        let UB₂' : B₂.left.Opens := (TopologicalSpace.Opens.map ψ₀.left.base).obj U'_0
        have h_range_q' : Set.range (O_P.ι ≫ p₂).base ⊆ Set.range UB₂'.ι.base := by
          rintro _ ⟨z, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          change ψ₀.left.base (p₂.base (O_P.ι.base z)) ∈ U'_0
          have hz : f₁.left.base (p₁.base (O_P.ι.base z)) ∈ U'_0 := z.2
          have hcomm_z : f₁.left.base (p₁.base (O_P.ι.base z)) =
              ψ₀.left.base (p₂.base (O_P.ι.base z)) :=
            congr_fun (congr_arg (fun h : P ⟶ B₀.left => ⇑h.base) hPb.w) (O_P.ι.base z)
          rwa [← hcomm_z]
        let q' : O_P.toScheme ⟶ UB₂'.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift UB₂'.ι (O_P.ι ≫ p₂) h_range_q'
        have hq'_fac : q' ≫ UB₂'.ι = O_P.ι ≫ p₂ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac UB₂'.ι (O_P.ι ≫ p₂) h_range_q'
        have hPb_OP_B₀ : CategoryTheory.IsPullback (O_P.ι ≫ p₂) (p₁ ∣_ U_V₁)
            ψ₀.left (U_V₁.ι ≫ f₁.left) :=
          (AlgebraicGeometry.isPullback_morphismRestrict p₁ U_V₁).flip.paste_horiz hPb.flip
        have hf₁_fac : (f₁.left ∣_ U'_0) ≫ U'_0.ι = U_V₁.ι ≫ f₁.left :=
          AlgebraicGeometry.morphismRestrict_ι f₁.left U'_0
        have h_sq_q' : q' ≫ (ψ₀.left ∣_ U'_0) = (p₁ ∣_ U_V₁) ≫ (f₁.left ∣_ U'_0) := by
          rw [← CategoryTheory.cancel_mono U'_0.ι]
          calc
            (q' ≫ (ψ₀.left ∣_ U'_0)) ≫ U'_0.ι
                = q' ≫ ((ψ₀.left ∣_ U'_0) ≫ U'_0.ι) := CategoryTheory.Category.assoc _ _ _
            _ = q' ≫ (UB₂'.ι ≫ ψ₀.left) := by rw [AlgebraicGeometry.morphismRestrict_ι]
            _ = (q' ≫ UB₂'.ι) ≫ ψ₀.left := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (O_P.ι ≫ p₂) ≫ ψ₀.left := by rw [hq'_fac]
            _ = (p₁ ∣_ U_V₁) ≫ (U_V₁.ι ≫ f₁.left) := hPb_OP_B₀.w
            _ = (p₁ ∣_ U_V₁) ≫ ((f₁.left ∣_ U'_0) ≫ U'_0.ι) := by rw [← hf₁_fac]
            _ = ((p₁ ∣_ U_V₁) ≫ (f₁.left ∣_ U'_0)) ≫ U'_0.ι :=
                (CategoryTheory.Category.assoc _ _ _).symm
        have hPb_OP_outer : CategoryTheory.IsPullback (q' ≫ UB₂'.ι) (p₁ ∣_ U_V₁)
            ψ₀.left ((f₁.left ∣_ U'_0) ≫ U'_0.ι) := by
          rwa [hq'_fac, hf₁_fac]
        have hPb_OP_left : CategoryTheory.IsPullback q' (p₁ ∣_ U_V₁)
            (ψ₀.left ∣_ U'_0) (f₁.left ∣_ U'_0) :=
          CategoryTheory.IsPullback.of_right hPb_OP_outer h_sq_q'
            (AlgebraicGeometry.isPullback_morphismRestrict ψ₀.left U'_0).flip
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hPb_OP_left hEt_ψ₀_U'0
      change AlgebraicGeometry.Etale ((ιX₂ ≫ p₁) ∣_ U_V₁)
      rw [AlgebraicGeometry.morphismRestrict_comp]
      have : CategoryTheory.IsIso (ιX₂ ∣_ (p₁ ⁻¹ᵁ U_V₁)) := hIso_OP
      have hp_et : CategoryTheory.IsPullback (ιX₂ ∣_ (p₁ ⁻¹ᵁ U_V₁))
          ((ιX₂ ∣_ (p₁ ⁻¹ᵁ U_V₁)) ≫ (p₁ ∣_ U_V₁)) (p₁ ∣_ U_V₁) (𝟙 U_V₁.toScheme) :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by simp⟩
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hp_et hEt_p₁_UV₁
    exact ⟨U_V₁, hU_V₁_ne, hFin_φ₂_U, hEt_φ₂_U, hSurj_φ₂_U⟩

  exact ⟨X₂, f₂, φ₂, ιX₂, hIntX₂, inferInstance, hSurj_ιX₂, hf₂, hφ₂, hcomm,
    hFin_φ₂, hSurj_φ₂, hAlt_φ₂, hFib₂, hSmPull⟩

theorem weil_algClosed_split_sections_three_secant_and_bdry (k : Type u) [Field k] [IsAlgClosed k]
    (B₀ V₁ B₂ X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hU₀ : Nonempty U₀)
    (f₁ : V₁ ⟶ B₀)
    (ψ₀ : B₂ ⟶ B₀)
    (f₂ : X₂ ⟶ B₂)
    (φ₂ : X₂ ⟶ V₁)
    (ιX₂ : X₂.left ⟶ CategoryTheory.Limits.pullback f₁.left ψ₀.left)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hClX₂ : AlgebraicGeometry.IsClosedImmersion ιX₂)
    (hSurjX₂ : AlgebraicGeometry.Surjective ιX₂)
    (hf₂ : ιX₂ ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left = f₂.left)
    (hφ₂ : ιX₂ ≫ CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left = φ₂.left)
    (hSurjψ₀ : AlgebraicGeometry.Surjective ψ₀.left)
    (hFib₂_U₀ : IsEquidimGenSmoothCurveFibOver k f₂
      ((TopologicalSpace.Opens.map ψ₀.left.base).obj U₀))
    (hSmPull : ∀ W : V₁.left.Opens,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f₁.left) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Scheme.Opens.ι (X := X₂.left)
          ((TopologicalSpace.Opens.map φ₂.left.base).obj W) ≫ f₂.left))
    (Z₁ : AlgebraicGeometry.Scheme.{u})
    (ιZ₁ : Z₁ ⟶ V₁.left)
    (hClZ₁ : AlgebraicGeometry.IsClosedImmersion ιZ₁)
    (r : ℕ)
    (W : Fin r → B₀.left.Opens)
    (H : Fin r → AlgebraicGeometry.Scheme.{u})
    (ιH : ∀ a : Fin r, H a ⟶ V₁.left)
    (hCovW : (⋃ a : Fin r, (W a : Set B₀.left)) = Set.univ)
    (hClH : ∀ a : Fin r, AlgebraicGeometry.IsClosedImmersion (ιH a))
    (hSec : ∀ a : Fin r, IsLocalThreeSecantSmoothSubschemeOver k f₁ (W a) (ιH a))
    (hSplitZ : HasPullbackSectionCoverOverOpen (ιZ₁ ≫ f₁.left) ψ₀.left U₀)
    (hSplitH : ∀ a : Fin r, HasPullbackSectionCoverOverOpen (ιH a ≫ f₁.left) ψ₀.left (W a)) :
    ∃ (U₂ : B₂.left.Opens)
      (n : ℕ)
      (σ : Fin n → (B₂ ⟶ X₂)),
      Nonempty U₂ ∧
      IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ ∧
      φ₂.left.base ⁻¹' (f₁.left.base ⁻¹' ((U₀ : Set B₀.left)ᶜ) ∪ Set.range ιZ₁.base) ⊆
        f₂.left.base ⁻¹' ((U₂ : Set B₂.left)ᶜ) ∪
          ⋃ j : Fin n, Set.range (σ j).left.base :=
by
  classical
  have : AlgebraicGeometry.IsIntegral B₂.left := hIntB₂
  have : AlgebraicGeometry.IsReduced B₂.left :=
    AlgebraicGeometry.isReduced_of_isIntegral B₂.left
  have : IrreducibleSpace ↥B₂.left :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral B₂.left
  have : AlgebraicGeometry.IsClosedImmersion ιX₂ := hClX₂
  have : AlgebraicGeometry.Surjective ιX₂ := hSurjX₂
  have hιX₂_inj : Function.Injective ιX₂.base :=
    ιX₂.isClosedEmbedding.injective
  have hφf : φ₂.left ≫ f₁.left = f₂.left ≫ ψ₀.left := by
    rw [← hφ₂, ← hf₂, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
  
  have hLift : ∀ (D : AlgebraicGeometry.Scheme.{u}) (ιD : D ⟶ V₁.left) (W_D : B₀.left.Opens),
      HasPullbackSectionCoverOverOpen (ιD ≫ f₁.left) ψ₀.left W_D →
      ∃ (k_D : ℕ) (τ : Fin k_D → (B₂ ⟶ X₂)),
        (∀ j : Fin k_D, τ j ≫ f₂ = 𝟙 B₂) ∧
        (∀ x : ↥X₂.left,
          f₂.left.base x ∈ ψ₀.left.base ⁻¹' (W_D : Set B₀.left) →
          φ₂.left.base x ∈ Set.range ιD.base →
          ∃ j : Fin k_D, x ∈ Set.range (τ j).left.base) := by
    intro D ιD W_D ⟨k_D, γ, hγ_sec, hγ_cov⟩
    let p_D : D ⟶ B₀.left := ιD ≫ f₁.left
    let m_D : CategoryTheory.Limits.pullback p_D ψ₀.left ⟶
        CategoryTheory.Limits.pullback f₁.left ψ₀.left :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p_D ψ₀.left ≫ ιD)
        (CategoryTheory.Limits.pullback.snd p_D ψ₀.left)
        (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    have hm_fst : m_D ≫ CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left =
        CategoryTheory.Limits.pullback.fst p_D ψ₀.left ≫ ιD :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm_snd : m_D ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left =
        CategoryTheory.Limits.pullback.snd p_D ψ₀.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_D : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst p_D ψ₀.left) m_D
        ιD (CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left) := by
      refine ⟨⟨hm_fst.symm⟩, ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
        (fun c => CategoryTheory.Limits.pullback.lift c.fst
          (c.snd ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left) (by
            change c.fst ≫ (ιD ≫ f₁.left) = _
            rw [← CategoryTheory.Category.assoc, c.condition, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]))
        (fun c => CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (fun c => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hm_fst, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst]
            exact c.condition
          · rw [CategoryTheory.Category.assoc, hm_snd,
              CategoryTheory.Limits.pullback.lift_snd])
        (fun c m hm₁ hm₂ => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst]
            exact hm₁
          · rw [CategoryTheory.Limits.pullback.lift_snd, ← hm_snd,
              ← CategoryTheory.Category.assoc, hm₂])⟩⟩
    let g : Fin k_D → (B₂.left ⟶ CategoryTheory.Limits.pullback f₁.left ψ₀.left) :=
      fun j => γ j ≫ m_D
    let q : ∀ j : Fin k_D, CategoryTheory.Limits.pullback ιX₂ (g j) ⟶ B₂.left :=
      fun j => CategoryTheory.Limits.pullback.snd ιX₂ (g j)
    have hIso_q : ∀ j : Fin k_D, CategoryTheory.IsIso (q j) :=
      fun j => AlgebraicGeometry.isIso_of_isClosedImmersion_of_surjective (q j)
    let s : Fin k_D → (B₂.left ⟶ X₂.left) :=
      fun j => @CategoryTheory.inv _ _ _ _ (q j) (hIso_q j) ≫
        CategoryTheory.Limits.pullback.fst ιX₂ (g j)
    have hs_ι : ∀ j : Fin k_D, s j ≫ ιX₂ = g j := by
      intro j
      haveI : CategoryTheory.IsIso (q j) := hIso_q j
      change (CategoryTheory.inv (q j) ≫ CategoryTheory.Limits.pullback.fst ιX₂ (g j)) ≫ ιX₂ = g j
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.id_comp]
    have hs_f₂ : ∀ j : Fin k_D, s j ≫ f₂.left = 𝟙 B₂.left := by
      intro j
      rw [← hf₂, ← CategoryTheory.Category.assoc, hs_ι j]
      change (γ j ≫ m_D) ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left = 𝟙 B₂.left
      rw [CategoryTheory.Category.assoc, hm_snd]
      exact hγ_sec j
    have hs_over : ∀ j : Fin k_D, s j ≫ X₂.hom = B₂.hom := by
      intro j
      rw [← CategoryTheory.Over.w f₂, ← CategoryTheory.Category.assoc, hs_f₂ j,
        CategoryTheory.Category.id_comp]
    let τ : Fin k_D → (B₂ ⟶ X₂) := fun j => CategoryTheory.Over.homMk (s j) (hs_over j)
    refine ⟨k_D, τ, ?_, ?_⟩
    · intro j
      apply CategoryTheory.Over.OverMorphism.ext
      exact hs_f₂ j
    · intro x hxW hxD
      have hyD : (CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left).base (ιX₂.base x) ∈
          Set.range ιD.base := by
        have h1 : (CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left).base (ιX₂.base x) =
            φ₂.left.base x := by
          rw [← hφ₂]
          rfl
        rwa [h1]
      have hy_snd : ιX₂.base x ∈
          Set.range (CategoryTheory.Limits.pullback.snd ιD
            (CategoryTheory.Limits.pullback.fst f₁.left ψ₀.left)).base := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_snd]
        exact hyD
      obtain ⟨w, hw⟩ := hy_snd
      let z : ↥(CategoryTheory.Limits.pullback p_D ψ₀.left) := hPb_D.isoPullback.inv.base w
      have hz : m_D.base z = ιX₂.base x := by
        change (hPb_D.isoPullback.inv ≫ m_D).base w = ιX₂.base x
        rw [hPb_D.isoPullback_inv_snd]
        exact hw
      have hzW : z ∈ (CategoryTheory.Limits.pullback.snd p_D ψ₀.left).base ⁻¹'
          (ψ₀.left.base ⁻¹' (W_D : Set B₀.left)) := by
        change ψ₀.left.base ((CategoryTheory.Limits.pullback.snd p_D ψ₀.left).base z) ∈
          (W_D : Set B₀.left)
        have h2 : (CategoryTheory.Limits.pullback.snd p_D ψ₀.left).base z = f₂.left.base x := by
          calc
            (CategoryTheory.Limits.pullback.snd p_D ψ₀.left).base z
              = (m_D ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left).base z := by rw [hm_snd]
            _ = (CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left).base (m_D.base z) := rfl
            _ = (CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left).base (ιX₂.base x) := by
              rw [hz]
            _ = (ιX₂ ≫ CategoryTheory.Limits.pullback.snd f₁.left ψ₀.left).base x := rfl
            _ = f₂.left.base x := by rw [hf₂]
        rw [h2]
        exact hxW
      have hz_cov := hγ_cov hzW
      rw [Set.mem_iUnion] at hz_cov
      obtain ⟨j, b, hb⟩ := hz_cov
      refine ⟨j, b, hιX₂_inj ?_⟩
      calc
        ιX₂.base ((τ j).left.base b)
          = (s j ≫ ιX₂).base b := rfl
        _ = (g j).base b := by rw [hs_ι j]
        _ = m_D.base ((γ j).base b) := rfl
        _ = m_D.base z := by rw [hb]
        _ = ιX₂.base x := hz
  
  obtain ⟨kZ, τZ, hτZ_sec, hτZ_cap⟩ := hLift Z₁ ιZ₁ U₀ hSplitZ
  have hLiftH := fun a : Fin r => hLift (H a) (ιH a) (W a) (hSplitH a)
  choose kH τH hτH_sec hτH_cap using hLiftH
  let S_sec : Finset (B₂ ⟶ X₂) :=
    Finset.univ.image τZ ∪ Finset.univ.biUnion (fun a : Fin r => Finset.univ.image (τH a))
  let n : ℕ := S_sec.card
  let eFin : ↥S_sec ≃ Fin n := S_sec.equivFin
  let σ : Fin n → (B₂ ⟶ X₂) := fun j => (eFin.symm j).1
  have hσ_inj : Function.Injective σ := Subtype.val_injective.comp eFin.symm.injective
  have hσ_sec : ∀ j : Fin n, σ j ≫ f₂ = 𝟙 B₂ := by
    intro j
    have hmem : σ j ∈ S_sec := (eFin.symm j).2
    rw [Finset.mem_union] at hmem
    rcases hmem with hZ | hH
    · rw [Finset.mem_image] at hZ
      obtain ⟨i, _, hi⟩ := hZ
      rw [← hi]
      exact hτZ_sec i
    · rw [Finset.mem_biUnion] at hH
      obtain ⟨a, _, ha⟩ := hH
      rw [Finset.mem_image] at ha
      obtain ⟨i, _, hi⟩ := ha
      rw [← hi]
      exact hτH_sec a i
  have hσ_left_sec : ∀ j : Fin n, (σ j).left ≫ f₂.left = 𝟙 B₂.left :=
    fun j => congrArg CategoryTheory.Over.Hom.left (hσ_sec j)
  have hCapZ : ∀ x : ↥X₂.left,
      f₂.left.base x ∈ ψ₀.left.base ⁻¹' (U₀ : Set B₀.left) →
      φ₂.left.base x ∈ Set.range ιZ₁.base →
      ∃ j : Fin n, x ∈ Set.range (σ j).left.base := by
    intro x hxU hxZ
    obtain ⟨i, hi⟩ := hτZ_cap x hxU hxZ
    have hmem : τZ i ∈ S_sec :=
      Finset.mem_union_left _ (Finset.mem_image_of_mem τZ (Finset.mem_univ i))
    let j : Fin n := eFin ⟨τZ i, hmem⟩
    have hj : σ j = τZ i := by
      change (eFin.symm (eFin ⟨τZ i, hmem⟩)).1 = τZ i
      rw [Equiv.symm_apply_apply]
    refine ⟨j, ?_⟩
    rwa [hj]
  have hCapH : ∀ (a : Fin r) (x : ↥X₂.left),
