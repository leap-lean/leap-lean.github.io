          1 ∈ Ideal.span { π_γ h_c, π_γ (der_S γ h_c) } := by
    intro γ
    let I_γ := Ideal.map (φ_chart γ) (RingHom.ker (ev_y_chart γ))
    let T_γ := S_chart γ ⧸ I_γ
    let π_γ : S_chart γ →+* T_γ := Ideal.Quotient.mk I_γ
