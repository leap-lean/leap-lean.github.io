        have hu_cast : u_r ∉ (p_chain r.castSucc).asIdeal := by
          intro hu
          have hEval0 : (π r.castSucc) u_r = 0 := hu
          have hEval1 : (π r.castSucc) u_r = MvPolynomial.X ⟨r, le_rfl⟩ - MvPolynomial.C (c r) := by
            simp [π, u_r]
