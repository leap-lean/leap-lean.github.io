      simp only [x_bar, hx_diag (μ_chart γ), map_one]
    have h_span_T : 1 ∈ Ideal.span (Set.range fun ν : Fin (M₀ + 1) => der_T (x_bar ν)) :=
      hDerSpan (μ_chart γ) (V_chart γ) (hV_aff γ) (hV_le_Wproj γ) T_γ π_γ hπ_alg
