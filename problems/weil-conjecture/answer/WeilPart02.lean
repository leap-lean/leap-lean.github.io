    have hTrdegF : Algebra.trdeg k F ≤ (m : Cardinal.{u}) := by
      have htr_R₀ : Algebra.trdeg k R₀ ≤ Algebra.trdeg k R :=
        trdeg_le_of_surjective (Ideal.Quotient.mkₐ k p₀) Ideal.Quotient.mk_surjective
      have : FaithfulSMul k R₀ :=
        (faithfulSMul_iff_algebraMap_injective k R₀).mpr (RingHom.injective (algebraMap k R₀))
      have : FaithfulSMul R₀ F₀ :=
        (faithfulSMul_iff_algebraMap_injective R₀ F₀).mpr (IsFractionRing.injective R₀ F₀)
      have : FaithfulSMul k F₀ :=
        (faithfulSMul_iff_algebraMap_injective k F₀).mpr (RingHom.injective (algebraMap k F₀))
      have : Algebra.IsAlgebraic R₀ F₀ := IsLocalization.isAlgebraic F₀ (nonZeroDivisors R₀)
      have : Algebra.IsAlgebraic F₀ F := algebraicClosure.isAlgebraic F₀ Ω
      have htr_F₀ : Algebra.trdeg k F₀ = Algebra.trdeg k R₀ := by
        have h := trdeg_add_eq k R₀ (A := F₀)
