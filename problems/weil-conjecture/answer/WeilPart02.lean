        have hwy_int : IsIntegral ↥Lx₀ w_y := Algebra.IsIntegral.isIntegral w_y
        let P_min : Polynomial ↥Lx₀ := minpoly ↥Lx₀ w_y
        have hP_irr : Irreducible P_min := minpoly.irreducible hwy_int
        have hP_ev : Polynomial.aeval w_y P_min = 0 := minpoly.aeval ↥Lx₀ w_y
        have hcoeff0_ne : P_min.coeff 0 ≠ 0 := by
          intro hc0
          obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hc0
          rcases hP_irr.isUnit_or_isUnit hq with hX_unit | hq_unit
