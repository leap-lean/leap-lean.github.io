              _ = (inv₂ ≫ CategoryTheory.Limits.pullback.snd _ _) ≫ (isoD₀ ℓ).inv ≫ fst₀ ℓ :=
                  (Category.assoc _ _ _).symm
              _ = (to_D₀ ≫ (isoD₀ ℓ).hom) ≫ (isoD₀ ℓ).inv ≫ fst₀ ℓ :=
                  congrArg (· ≫ ((isoD₀ ℓ).inv ≫ fst₀ ℓ)) (CategoryTheory.Limits.pullback.lift_snd _ _ _)
              _ = to_D₀ ≫ ((isoD₀ ℓ).hom ≫ (isoD₀ ℓ).inv ≫ fst₀ ℓ) := Category.assoc _ _ _
              _ = to_D₀ ≫ fst₀ ℓ := congrArg (to_D₀ ≫ ·) (Iso.hom_inv_id_assoc (isoD₀ ℓ) (fst₀ ℓ))
              _ = fst_L := CategoryTheory.Limits.pullback.lift_fst _ _ _
              _ = 𝟙 P_L ≫ fst_L := (Category.id_comp _).symm
          · calc (inv₂ ≫ fwd₂) ≫ snd_L
              _ = inv₂ ≫ (fwd₂ ≫ snd_L) := Category.assoc _ _ _
              _ = inv₂ ≫ CategoryTheory.Limits.pullback.fst _ _ :=
                  congrArg (inv₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)
              _ = snd_L := CategoryTheory.Limits.pullback.lift_fst _ _ _
