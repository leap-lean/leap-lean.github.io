      exact (htr_F.trans htr_F₀).le.trans (htr_R₀.trans hTrdegR)
    let C : I → Ω := fun e => π_P (MvPolynomial.X e)
    have hC_inj : Function.Injective (MvPolynomial.aeval C : MvPolynomial I k →ₐ[k] Ω) := by
      have haeval_eq : (MvPolynomial.aeval C : MvPolynomial I k →ₐ[k] Ω).toRingHom =
