    have hSepF : Algebra.IsSeparable ↥Lx₀ F := AlgEquiv.Algebra.isSeparable e_Ai_F
    have : FaithfulSMul K P :=
      (faithfulSMul_iff_algebraMap_injective K P).mpr Polynomial.C_injective
    have : FaithfulSMul P ↥Lx₀ :=
      (faithfulSMul_iff_algebraMap_injective P ↥Lx₀).mpr hιPL_inj
    have : FaithfulSMul K ↥Lx₀ :=
      (faithfulSMul_iff_algebraMap_injective K ↥Lx₀).mpr (RingHom.injective (algebraMap K ↥Lx₀))
    have : FaithfulSMul ↥Lx₀ F :=
      (faithfulSMul_iff_algebraMap_injective ↥Lx₀ F).mpr (RingHom.injective (algebraMap ↥Lx₀ F))
    have : FaithfulSMul k K :=
      (faithfulSMul_iff_algebraMap_injective k K).mpr (RingHom.injective (algebraMap k K))
    have : FaithfulSMul K F :=
      (faithfulSMul_iff_algebraMap_injective K F).mpr (RingHom.injective (algebraMap K F))
    have : Algebra.IsAlgebraic P ↥Lx₀ := IsLocalization.isAlgebraic ↥Lx₀ (nonZeroDivisors P)
    have htr_KP : Algebra.trdeg K P = 1 := Polynomial.trdeg_of_isDomain
    have htr_PL : Algebra.trdeg P ↥Lx₀ = 0 := trdeg_eq_zero
    have htr_KL : Algebra.trdeg K ↥Lx₀ = 1 := by
      rw [← trdeg_add_eq K P (A := ↥Lx₀), htr_KP, htr_PL, add_zero]
    have : Module.Finite ↥Lx₀ F := hFinF
    have : Algebra.IsAlgebraic ↥Lx₀ F := Algebra.IsAlgebraic.of_finite ↥Lx₀ F
    have htr_LF : Algebra.trdeg ↥Lx₀ F = 0 := trdeg_eq_zero
    have htr_KF : Algebra.trdeg K F = 1 := by
      rw [← trdeg_add_eq K ↥Lx₀ (A := F), htr_KL, htr_LF, add_zero]
