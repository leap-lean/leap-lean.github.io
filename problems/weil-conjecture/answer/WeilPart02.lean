    have hq_monic : ∀ (ℓ : Fin s) (i : I_idx ℓ), (q_min ℓ i).Monic :=
      fun ℓ i => minpoly.monic (Algebra.IsIntegral.isIntegral (α_prim ℓ i))
    have hq_irred : ∀ (ℓ : Fin s) (i : I_idx ℓ), Irreducible (q_min ℓ i) :=
      fun ℓ i => minpoly.irreducible (Algebra.IsIntegral.isIntegral (α_prim ℓ i))
    have hq_sep : ∀ (ℓ : Fin s) (i : I_idx ℓ), (q_min ℓ i).Separable :=
      fun ℓ i => Algebra.IsSeparable.isSeparable K₀ (α_prim ℓ i)
    let S_min : Finset (Polynomial K₀) :=
      Finset.univ.biUnion (fun ℓ : Fin s => Finset.univ.image (fun i : I_idx ℓ => q_min ℓ i))
    have hS_props : ∀ q ∈ S_min, q.Monic ∧ Irreducible q ∧ q.Separable := by
      intro q hq
      obtain ⟨ℓ, _, hq_im⟩ := Finset.mem_biUnion.mp hq
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hq_im
