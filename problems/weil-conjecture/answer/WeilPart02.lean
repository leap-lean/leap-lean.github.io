    have hComap_𝔪 : Ideal.comap mk_I 𝔪_bar = 𝔪 := by
      refine le_antisymm ?_ Ideal.le_comap_map
      intro b hb
      rw [Ideal.mem_comap, Ideal.mem_map_iff_of_surjective mk_I Ideal.Quotient.mk_surjective] at hb
      obtain ⟨b', hb'𝔪, hb'Eq⟩ := hb
      have hSub : b - b' ∈ I := by
        rw [← Ideal.Quotient.eq]
        exact hb'Eq.symm
