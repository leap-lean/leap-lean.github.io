        intro K s hs
        refine Submodule.span_induction ?_ ⟨0, K.zero_mem, map_zero _⟩ ?_ ?_ hs
        · rintro _ ⟨y, hy, rfl⟩
          exact ⟨y, hy, rfl⟩
        · rintro _ _ _ _ ⟨y₁, hy₁, rfl⟩ ⟨y₂, hy₂, rfl⟩
          exact ⟨y₁ + y₂, add_mem hy₁ hy₂, map_add _ y₁ y₂⟩
        · rintro s₀ _ _ ⟨y, hy, rfl⟩
          obtain ⟨p₀, rfl⟩ := hSurj_φ s₀
          exact ⟨p₀ * y, K.mul_mem_left p₀ hy, map_mul (algebraMap P S) p₀ y⟩
      have hJP2_zero : ∀ y ∈ J_P ^ 2, y ∈ J_P ∧
