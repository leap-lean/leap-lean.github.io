      obtain ⟨z₀, hz₀⟩ := hIrredZ𝔪.nonempty
      refine ⟨⟨⟨z₀, hz₀⟩, trivial⟩, ?_⟩
      intro U₁ U₂ hO₁ hO₂ ⟨a, _, ha⟩ ⟨b, _, hb⟩
      rw [isOpen_induced_iff] at hO₁ hO₂
      obtain ⟨V₁, hV₁, rfl⟩ := hO₁
      obtain ⟨V₂, hV₂, rfl⟩ := hO₂
      obtain ⟨w, hwZ, hw₁, hw₂⟩ := hIrredZ𝔪.isPreirreducible V₁ V₂ hV₁ hV₂ ⟨a.1, a.2, ha⟩ ⟨b.1, b.2, hb⟩
      exact ⟨⟨w, hwZ⟩, trivial, hw₁, hw₂⟩
    have hIrredC₀ : IsIrreducible C₀_set := by
      rw [← hC₀_img]
      exact hIrred_univ_Z𝔪.image fZ hfZ_cont.continuousOn
    have hClosedC₀ : IsClosed C₀_set :=
      (PrimeSpectrum.isClosed_zeroLocus _).preimage continuous_subtype_val
    have hIrredC₁ : IsIrreducible (Set.univ : Set ↥E_spec) := by
      obtain ⟨z₀, hz₀⟩ := hE.1.nonempty
      refine ⟨⟨⟨z₀, hz₀⟩, trivial⟩, ?_⟩
      intro U₁ U₂ hO₁ hO₂ ⟨a, _, ha⟩ ⟨b, _, hb⟩
      rw [isOpen_induced_iff] at hO₁ hO₂
      obtain ⟨V₁, hV₁, rfl⟩ := hO₁
      obtain ⟨V₂, hV₂, rfl⟩ := hO₂
      obtain ⟨w, hwE, hw₁, hw₂⟩ := hE.1.isPreirreducible V₁ V₂ hV₁ hV₂ ⟨a.1, a.2, ha⟩ ⟨b.1, b.2, hb⟩
      exact ⟨⟨w, hwE⟩, trivial, hw₁, hw₂⟩
    let C₀ : TopologicalSpace.IrreducibleCloseds ↥E_spec := ⟨C₀_set, hIrredC₀, hClosedC₀⟩
    let C₁ : TopologicalSpace.IrreducibleCloseds ↥E_spec := ⟨Set.univ, hIrredC₁, isClosed_univ⟩
    have hC₀_lt_C₁ : C₀ < C₁ := by
      refine lt_of_le_of_ne (Set.subset_univ _) (fun hEq => ?_)
      let zp : PrimeSpectrum (B ⧸ I) := ⟨p_bar, hp_bar_prime⟩
      have hzp_E : zp ∈ E_spec := by
        rw [← hp_bar_ZL]
        change zp ∈ PrimeSpectrum.zeroLocus (p_bar : Set (B ⧸ I))
        rw [PrimeSpectrum.mem_zeroLocus]
      have hzp_C₁ : (⟨zp, hzp_E⟩ : ↥E_spec) ∈ (C₁ : Set ↥E_spec) := trivial
      rw [← hEq] at hzp_C₁
      have h𝔪_le_p : 𝔪_bar ≤ p_bar := by
        change zp ∈ Z𝔪 at hzp_C₁
        rwa [PrimeSpectrum.mem_zeroLocus] at hzp_C₁
      exact hp_ne_𝔪_bar (le_antisymm hp_le_𝔪_bar h𝔪_le_p)
    let ser : LTSeries (TopologicalSpace.IrreducibleCloseds ↥E_spec) :=
      { length := 1
        toFun := ![C₀, C₁]
        step := fun i => by
          fin_cases i
          exact hC₀_lt_C₁ }
    exact Order.LTSeries.length_le_krullDim ser

  
  have hTopPre : ∀ U : V₁.left.Opens, U ≤ V₁.hom ⁻¹ᵁ ⊤ := fun _ _ _ => trivial
  have h_s4a :
      ∀ (UA : V₁.left.Opens) (hAffA : AlgebraicGeometry.IsAffineOpen UA) [Nonempty ↥UA.toScheme],
        let ek := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm
        let κA : CommRingCat.of k ⟶ V₁.left.presheaf.obj (Opposite.op UA) :=
          ek.hom ≫ V₁.hom.appLE ⊤ UA (hTopPre UA)
        letI : Algebra k ↑(V₁.left.presheaf.obj (Opposite.op UA)) := κA.hom.toAlgebra
