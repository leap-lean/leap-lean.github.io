    let φ_F : R →+* F :=
      (algebraMap F₀ F).comp ((algebraMap R₀ F₀).comp (Ideal.Quotient.mk p₀))
    have hφ_F_val : ∀ r : R, algebraMap F Ω (φ_F r) = π_P (MvPolynomial.C r) := by
      intro r
      change F_sub.val (algebraMap F₀ F (algebraMap R₀ F₀ (Ideal.Quotient.mk p₀ r))) = _
      rw [F_sub.val.commutes]
      change ψ_F₀ (algebraMap R₀ F₀ (Ideal.Quotient.mk p₀ r)) = _
