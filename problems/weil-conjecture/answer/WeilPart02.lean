      exact (mul_right_cancel₀ hQ_ne hCross).symm
    have hCop_rat : IsCoprime P_rat Q_rat := by
      obtain ⟨u, v, huv⟩ := hCopPQ
      refine ⟨πPoly u, πPoly v, ?_⟩
      rw [← hP_eq, ← hQ_eq] at huv
      ext n
      have hstep := congrArg (fun F => π (F.coeff n)) huv
      simp only [Polynomial.coeff_add, Polynomial.coeff_one, map_add] at hstep ⊢
      have hPull : ∀ (U : Polynomial ℂ) (G : Polynomial ℚ),
          π ((U * Polynomial.map (algebraMap ℚ ℂ) G).coeff n) = (πPoly U * G).coeff n := by
        intro U G
        rw [Polynomial.coeff_mul, Polynomial.coeff_mul, map_sum]
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [Polynomial.coeff_map, hπ_mul_right, hπPoly_coeff]
      rw [hPull u P_rat, hPull v Q_rat] at hstep
      rw [hstep]
      split_ifs <;> simp [hπ_one]
    exact ⟨P_rat, Q_rat, hCop_rat, hQ_rat0, hP_eq, hQ_eq, hEq_rat⟩
  obtain ⟨P_rat, Q_rat, hCop_rat, hQ0_rat, hP_rat, hQ_rat, hEq_rat⟩ :=
    hStage3 (PowerSeries.map (Int.castRingHom ℚ) Z) _ _ hCop hQ0 hEqC
  
  have hStage4 : ∃ P_int Q_int : Polynomial ℤ,
      Polynomial.map (Int.castRingHom ℚ) P_int = P_rat ∧
      Polynomial.map (Int.castRingHom ℚ) Q_int = Q_rat := by
    let HasDenom : Polynomial ℚ → ℕ → Prop := fun F m =>
      1 ≤ m ∧ ∃ G : Polynomial ℤ, Polynomial.map (Int.castRingHom ℚ) G = Polynomial.C (m : ℚ) * F
    have hHasDenom : ∀ F : Polynomial ℚ, ∃ m : ℕ, HasDenom F m := by
      intro F
      induction F using Polynomial.induction_on' with
      | add f₁ f₂ ihp ihq =>
        obtain ⟨mp, hmp1, Gp, hGp⟩ := ihp
        obtain ⟨mq, hmq1, Gq, hGq⟩ := ihq
        refine ⟨mp * mq, Nat.mul_pos hmp1 hmq1,
          Polynomial.C (mq : ℤ) * Gp + Polynomial.C (mp : ℤ) * Gq, ?_⟩
        ext k
        have hpk := congrArg (fun f => f.coeff k) hGp
        have hqk := congrArg (fun f => f.coeff k) hGq
        rw [Polynomial.coeff_map, Polynomial.coeff_C_mul, eq_intCast] at hpk hqk
        rw [Polynomial.coeff_map, Polynomial.coeff_add, Polynomial.coeff_C_mul,
          Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, Polynomial.coeff_add, eq_intCast]
        push_cast
        rw [hpk, hqk]
        ring
      | monomial n a =>
        refine ⟨a.den, a.den_pos, Polynomial.monomial n a.num, ?_⟩
        ext k
        simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul, Polynomial.coeff_monomial,
          eq_intCast]
        split_ifs with hnk
        · rw [mul_comm, Rat.mul_den_eq_num]
        · simp
    classical
    set d_Q : ℕ := Nat.find (hHasDenom Q_rat)
    have hQ_spec : HasDenom Q_rat d_Q := Nat.find_spec (hHasDenom Q_rat)
    obtain ⟨hd_Q_pos, Q_tilde, hQ_tilde⟩ := hQ_spec
    have hQ_tilde0 : Q_tilde.coeff 0 = (d_Q : ℤ) := by
      have h0 := congrArg (fun f => f.coeff 0) hQ_tilde
      simp only [Polynomial.coeff_map, Polynomial.coeff_C_mul, hQ0_rat, mul_one, eq_intCast] at h0
      exact_mod_cast h0
    have hMin_prime :
        ∀ {p : ℕ}, Nat.Prime p → p ∣ d_Q → ∃ k : ℕ, ¬ ((p : ℤ) ∣ Q_tilde.coeff k) := by
      intro p hp hp_dvd
      by_contra! hAll
      obtain ⟨d', hd'⟩ := hp_dvd
      have hp2 : 2 ≤ p := hp.two_le
      have hd'_pos : 1 ≤ d' := by
        rcases eq_or_lt_of_le (Nat.zero_le d') with rfl | hpos
        · simp at hd'
          omega
        · exact hpos
      have hd'_lt : d' < d_Q := by nlinarith
      let Q_div : Polynomial ℤ :=
        ∑ k ∈ Finset.range (Q_tilde.natDegree + 1),
          Polynomial.C (Q_tilde.coeff k / (p : ℤ)) * Polynomial.X ^ k
      have hQ_div_mul : Q_tilde = Polynomial.C (p : ℤ) * Q_div := by
        ext k
        simp only [Q_div, Polynomial.coeff_C_mul, Polynomial.finsetSum_coeff]
        by_cases hk : k ≤ Q_tilde.natDegree
        · rw [Finset.sum_eq_single k]
          · simp [Int.mul_ediv_cancel' (hAll k)]
          · intro b _ hbk
            simp [Ne.symm hbk]
          · intro hnot
            exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hk)) hnot
        · have hk' : Q_tilde.natDegree < k := lt_of_not_ge hk
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt hk']
          symm
          rw [mul_eq_zero]
          right
          refine Finset.sum_eq_zero fun b hb => ?_
          have hbk : k ≠ b := Nat.ne_of_gt (lt_of_lt_of_le (Finset.mem_range.mp hb) hk')
          simp [hbk]
      have hQ_div_rat :
          Polynomial.map (Int.castRingHom ℚ) Q_div = Polynomial.C (d' : ℚ) * Q_rat := by
        ext k
        have hk := congrArg (fun f => f.coeff k) hQ_tilde
        rw [hQ_div_mul, Polynomial.coeff_map, Polynomial.coeff_C_mul, Polynomial.coeff_C_mul,
          eq_intCast, Int.cast_mul, Int.cast_natCast, hd', Nat.cast_mul] at hk
        rw [Polynomial.coeff_map, Polynomial.coeff_C_mul, eq_intCast]
        have hpq_ne : (p : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
        apply mul_left_cancel₀ hpq_ne
        linarith
      exact Nat.find_min (hHasDenom Q_rat) hd'_lt ⟨hd'_pos, Q_div, hQ_div_rat⟩
    obtain ⟨u, v, huv⟩ := hCop_rat
    obtain ⟨d_u, hd_u_pos, U_tilde, hU_tilde⟩ := hHasDenom u
    obtain ⟨d_v, hd_v_pos, V_tilde, hV_tilde⟩ := hHasDenom v
    set M₀ : ℕ := d_u * d_v * d_Q
    have hM₀_pos : 1 ≤ M₀ := Nat.mul_pos (Nat.mul_pos hd_u_pos hd_v_pos) hd_Q_pos
    set S : PowerSeries ℤ :=
      PowerSeries.C (d_v : ℤ) * Polynomial.toPowerSeries U_tilde * Z +
        PowerSeries.C (d_u : ℤ) * Polynomial.toPowerSeries V_tilde
    have hMapCoeQ : ∀ G : Polynomial ℤ,
        PowerSeries.map (Int.castRingHom ℚ) (Polynomial.toPowerSeries G) =
          Polynomial.toPowerSeries (Polynomial.map (Int.castRingHom ℚ) G) := by
      intro G
      ext n
      rw [PowerSeries.coeff_map, Polynomial.coeff_coe, Polynomial.coeff_coe, Polynomial.coeff_map]
    have hMapC : ∀ {R₁ R₂ : Type} [Semiring R₁] [Semiring R₂] (f : R₁ →+* R₂) (a : R₁),
        PowerSeries.map f (PowerSeries.C a) = PowerSeries.C (f a) := by
      intro R₁ R₂ _ _ f a
      ext n
      cases n <;> simp
    have hBezout_int : S * Polynomial.toPowerSeries Q_tilde = PowerSeries.C (M₀ : ℤ) := by
      have h_rat : PowerSeries.map (Int.castRingHom ℚ) (S * Polynomial.toPowerSeries Q_tilde) =
          PowerSeries.map (Int.castRingHom ℚ) (PowerSeries.C (M₀ : ℤ)) := by
        have huv_ps : Polynomial.toPowerSeries u * Polynomial.toPowerSeries P_rat +
            Polynomial.toPowerSeries v * Polynomial.toPowerSeries Q_rat = 1 := by
          rw [← Polynomial.coe_mul, ← Polynomial.coe_mul, ← Polynomial.coe_add, huv,
            Polynomial.coe_one]
        have hCast : ∀ k : ℕ, (Int.castRingHom ℚ) (k : ℤ) = (k : ℚ) := fun k => by simp
        simp only [S, M₀, map_mul, map_add, hMapCoeQ, hMapC, hU_tilde, hV_tilde, hQ_tilde,
          Polynomial.coe_mul, Polynomial.coe_C, Nat.cast_mul, hCast]
        calc (PowerSeries.C (d_v : ℚ) * (PowerSeries.C (d_u : ℚ) * Polynomial.toPowerSeries u) *
                (PowerSeries.map (Int.castRingHom ℚ)) Z +
              PowerSeries.C (d_u : ℚ) * (PowerSeries.C (d_v : ℚ) * Polynomial.toPowerSeries v)) *
              (PowerSeries.C (d_Q : ℚ) * Polynomial.toPowerSeries Q_rat)
          _ = PowerSeries.C (d_u : ℚ) * PowerSeries.C (d_v : ℚ) * PowerSeries.C (d_Q : ℚ) *
                (Polynomial.toPowerSeries u *
                  ((PowerSeries.map (Int.castRingHom ℚ)) Z * Polynomial.toPowerSeries Q_rat) +
                  Polynomial.toPowerSeries v * Polynomial.toPowerSeries Q_rat) := by ring
          _ = PowerSeries.C (d_u : ℚ) * PowerSeries.C (d_v : ℚ) * PowerSeries.C (d_Q : ℚ) := by
              rw [hEq_rat, huv_ps, mul_one]
      ext n
      have hn := congrArg (PowerSeries.coeff n) h_rat
      simp only [PowerSeries.coeff_map, eq_intCast] at hn
      exact Int.cast_inj.mp hn
    have hd_Q_eq1 : d_Q = 1 := by
      by_contra hd_ne1
      obtain ⟨p, hp, hp_dvd⟩ := Nat.exists_prime_and_dvd hd_ne1
      have : Fact (Nat.Prime p) := ⟨hp⟩
      let π_p : PowerSeries ℤ →+* PowerSeries (ZMod p) := PowerSeries.map (Int.castRingHom (ZMod p))
      set B_bar : PowerSeries (ZMod p) := π_p (Polynomial.toPowerSeries Q_tilde)
      have hB_bar0 : PowerSeries.coeff 0 B_bar = 0 := by
        simp only [B_bar, π_p, PowerSeries.coeff_map, Polynomial.coeff_coe,
          hQ_tilde0, eq_intCast, Int.cast_natCast]
        exact (ZMod.natCast_eq_zero_iff d_Q p).mpr hp_dvd
      have hB_bar_ne : B_bar ≠ 0 := by
        obtain ⟨k, hk⟩ := hMin_prime hp hp_dvd
        intro h0
        have hk0 := congrArg (PowerSeries.coeff k) h0
        simp only [B_bar, π_p, PowerSeries.coeff_map, Polynomial.coeff_coe,
          map_zero, eq_intCast] at hk0
        exact hk ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp hk0)
      have hNoMult : ∀ m : ℕ, 1 ≤ m → ∀ T : PowerSeries ℤ,
          T * Polynomial.toPowerSeries Q_tilde ≠ PowerSeries.C (m : ℤ) := by
        intro m
        induction m using Nat.strong_induction_on with
        | h m ih =>
          intro hm1 T hT
          have hmod := congrArg π_p hT
          rw [map_mul] at hmod
          dsimp only [π_p] at hmod
          rw [hMapC] at hmod
          change π_p T * B_bar = PowerSeries.C ((m : ℤ) : ZMod p) at hmod
          have hc0 := congrArg (PowerSeries.coeff 0) hmod
          have hmul0 : PowerSeries.coeff 0 (π_p T * B_bar) = 0 := by
            simp [PowerSeries.coeff_mul, hB_bar0]
          rw [hmul0] at hc0
          simp only [Int.cast_natCast] at hc0
          have hm_zmod : (m : ZMod p) = 0 := by simpa using hc0.symm
          have hp_dvd_m : p ∣ m := (ZMod.natCast_eq_zero_iff m p).mp hm_zmod
          obtain ⟨m', hm'⟩ := hp_dvd_m
          have hp2 : 2 ≤ p := hp.two_le
          have hm'1 : 1 ≤ m' := by
            rcases eq_or_lt_of_le (Nat.zero_le m') with rfl | hpos
            · simp at hm'
              omega
            · exact hpos
          have hm'_lt : m' < m := by nlinarith
          have hC0 : PowerSeries.C ((m : ℤ) : ZMod p) = 0 := by
            simp [hm_zmod]
          rw [hC0] at hmod
          have hT_bar0 : π_p T = 0 := (mul_eq_zero.mp hmod).resolve_right hB_bar_ne
          have hT_dvd : ∀ n : ℕ, (p : ℤ) ∣ PowerSeries.coeff n T := by
            intro n
            have hn0 := congrArg (PowerSeries.coeff n) hT_bar0
            simp only [π_p, PowerSeries.coeff_map, map_zero, eq_intCast] at hn0
            exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp hn0
          let T' : PowerSeries ℤ := PowerSeries.mk (fun n => PowerSeries.coeff n T / (p : ℤ))
          have hT_eq : T = PowerSeries.C (p : ℤ) * T' := by
            ext n
            simp only [T', PowerSeries.coeff_C_mul, PowerSeries.coeff_mk]
            exact (Int.mul_ediv_cancel' (hT_dvd n)).symm
          have hT' : T' * Polynomial.toPowerSeries Q_tilde = PowerSeries.C (m' : ℤ) := by
            rw [hT_eq, hm', Nat.cast_mul, map_mul PowerSeries.C, mul_assoc] at hT
            ext n
            have hn := congrArg (PowerSeries.coeff n) hT
            rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul] at hn
            have hpz_ne : (p : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
            exact mul_left_cancel₀ hpz_ne hn
          exact ih m' hm'_lt hm'1 T' hT'
      exact hNoMult M₀ hM₀_pos S hBezout_int
    have hQ_int : Polynomial.map (Int.castRingHom ℚ) Q_tilde = Q_rat := by
      rw [hQ_tilde, hd_Q_eq1, Nat.cast_one, map_one, one_mul]
    let P_int : Polynomial ℤ :=
      ∑ k ∈ Finset.range (P_rat.natDegree + 1),
        Polynomial.C (PowerSeries.coeff k (Z * Polynomial.toPowerSeries Q_tilde)) * Polynomial.X ^ k
    have hP_int_coeff : ∀ k : ℕ, P_int.coeff k =
        if k ≤ P_rat.natDegree then PowerSeries.coeff k (Z * Polynomial.toPowerSeries Q_tilde)
        else 0 := by
      intro k
      simp only [P_int, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
      split_ifs with hk
      · rw [Finset.sum_eq_single k]
        · simp
        · intro b _ hbk
          simp [Ne.symm hbk]
        · intro hnot
          exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hk)) hnot
      · have hk' : P_rat.natDegree < k := lt_of_not_ge hk
        refine Finset.sum_eq_zero fun b hb => ?_
        have hbk : k ≠ b := Nat.ne_of_gt (lt_of_lt_of_le (Finset.mem_range.mp hb) hk')
        simp [hbk]
    have hP_int : Polynomial.map (Int.castRingHom ℚ) P_int = P_rat := by
      have hZQ : PowerSeries.map (Int.castRingHom ℚ) (Z * Polynomial.toPowerSeries Q_tilde) =
          Polynomial.toPowerSeries P_rat := by
        rw [map_mul, hMapCoeQ, hQ_int, hEq_rat]
      ext k
      rw [Polynomial.coeff_map, hP_int_coeff k, eq_intCast]
      split_ifs with hk
      · have hk_eq := congrArg (PowerSeries.coeff k) hZQ
        rw [PowerSeries.coeff_map, Polynomial.coeff_coe, eq_intCast] at hk_eq
        exact hk_eq
      · have hk' : P_rat.natDegree < k := lt_of_not_ge hk
        rw [Int.cast_zero, Polynomial.coeff_eq_zero_of_natDegree_lt hk']
    exact ⟨P_int, Q_tilde, hP_int, hQ_int⟩
  obtain ⟨P_int, Q_int, hP_int, hQ_int⟩ := hStage4
  
  set R_int : Polynomial ℤ := P_int * Q_int
  set M_tot : Multiset ℂ := ∑ j ∈ Finset.Iic (2 * d), A j
  have hR : Polynomial.map (Int.castRingHom ℂ) R_int =
      (M_tot.map (fun α => (1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X)).prod := by
    have hMapComp : ∀ G : Polynomial ℤ,
        Polynomial.map (Int.castRingHom ℂ) G =
          Polynomial.map (algebraMap ℚ ℂ) (Polynomial.map (Int.castRingHom ℚ) G) := by
      intro G
      rw [Polynomial.map_map]
      have hhom : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) = Int.castRingHom ℂ :=
        Subsingleton.elim _ _
      rw [hhom]
    rw [show R_int = P_int * Q_int from rfl, Polynomial.map_mul, hMapComp P_int, hMapComp Q_int,
      hP_int, hQ_int, hP_rat, hQ_rat, ← Multiset.prod_add, ← Multiset.map_add]
    have hPart : (∑ i ∈ (Finset.Iic (2 * d)).filter Odd, A i) +
        (∑ i ∈ (Finset.Iic (2 * d)).filter Even, A i) = M_tot := by
      rw [add_comm]
      have hOdd_filt : (Finset.Iic (2 * d)).filter Odd =
          (Finset.Iic (2 * d)).filter (fun x => ¬Even x) := by
        ext x
        simp [Nat.not_even_iff_odd]
      rw [hOdd_filt]
      exact Finset.sum_filter_add_sum_filter_not (Finset.Iic (2 * d)) Even A
    rw [hPart]
  have hStage5 : (∀ α ∈ M_tot, IsIntegral ℤ α) ∧ (∀ φ : ℂ ≃+* ℂ, M_tot.map φ = M_tot) := by
    let P : Multiset ℂ → Polynomial ℂ := fun S =>
      (S.map (fun α => (1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X)).prod
    let Q : Multiset ℂ → Polynomial ℂ := fun S =>
      (S.map (fun α => Polynomial.X - Polynomial.C α)).prod
    have hP0 : ∀ S : Multiset ℂ, (P S).coeff 0 = 1 := by
      intro S
      induction S using Multiset.induction_on with
      | empty => simp [P]
      | cons α S' ih =>
        simp only [P, Multiset.map_cons, Multiset.prod_cons]
        rw [Polynomial.mul_coeff_zero, ih, mul_one]
        simp
    have hP_step_zero : ∀ (α : ℂ) (f : Polynomial ℂ),
        (((1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X) * f).coeff 0 = f.coeff 0 := by
      intro α f
      rw [Polynomial.mul_coeff_zero]
      simp
    have hP_step_succ : ∀ (α : ℂ) (f : Polynomial ℂ) (j : ℕ),
        (((1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X) * f).coeff (j + 1) =
          f.coeff (j + 1) - α * f.coeff j := by
      intro α f j
      have heq : ((1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X) * f =
          f - Polynomial.C α * (Polynomial.X * f) := by ring
      rw [heq, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_mul]
    have hQ_step_zero : ∀ (α : ℂ) (g : Polynomial ℂ),
        ((Polynomial.X - Polynomial.C α) * g).coeff 0 = - α * g.coeff 0 := by
      intro α g
      rw [Polynomial.mul_coeff_zero]
      simp
    have hQ_step_succ : ∀ (α : ℂ) (g : Polynomial ℂ) (j : ℕ),
        ((Polynomial.X - Polynomial.C α) * g).coeff (j + 1) =
          g.coeff j - α * g.coeff (j + 1) := by
      intro α g j
      have heq : (Polynomial.X - Polynomial.C α) * g =
          Polynomial.X * g - Polynomial.C α * g := by ring
      rw [heq, Polynomial.coeff_sub, Polynomial.coeff_X_mul, Polynomial.coeff_C_mul]
    have hRev : ∀ S : Multiset ℂ,
        (P S).natDegree ≤ S.card ∧ ∀ k ≤ S.card, (Q S).coeff k = (P S).coeff (S.card - k) := by
      intro S
      induction S using Multiset.induction_on with
      | empty =>
        refine ⟨by simp [P], ?_⟩
        intro k hk
        have hk0 : k = 0 := Nat.eq_zero_of_le_zero hk
        subst hk0
        simp [P, Q]
      | cons α S' ih =>
        obtain ⟨hdeg, hcoeff⟩ := ih
        set n := S'.card
        have hlin_deg : ((1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X).natDegree ≤ 1 := by
          refine le_trans (Polynomial.natDegree_sub_le _ _) (max_le ?_ ?_)
          · simp
          · exact le_trans (Polynomial.natDegree_C_mul_le α Polynomial.X) Polynomial.natDegree_X_le
        have hdeg' : (P (α ::ₘ S')).natDegree ≤ (α ::ₘ S').card := by
          rw [Multiset.card_cons]
          dsimp only [P]
          rw [Multiset.map_cons, Multiset.prod_cons]
          exact le_trans Polynomial.natDegree_mul_le
            (by rw [add_comm]; exact Nat.add_le_add hdeg hlin_deg)
        refine ⟨hdeg', ?_⟩
        intro k hk
        simp only [Multiset.card_cons] at hk ⊢
        simp only [P, Q, Multiset.map_cons, Multiset.prod_cons]
        cases k with
        | zero =>
          change ((Polynomial.X - Polynomial.C α) * Q S').coeff 0 =
            (((1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X) * P S').coeff (n + 1)
          rw [hQ_step_zero, hP_step_succ, hcoeff 0 (Nat.zero_le n), Nat.sub_zero,
            Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_succ_of_le hdeg), zero_sub, neg_mul]
        | succ m =>
          by_cases hmn : m < n
          · obtain ⟨l, hl⟩ : ∃ l, n - m = l + 1 := ⟨n - 1 - m, by omega⟩
            have hl2 : n - (m + 1) = l := by omega
            have hsub : n + 1 - (m + 1) = l + 1 := by omega
            change ((Polynomial.X - Polynomial.C α) * Q S').coeff (m + 1) =
              (((1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X) * P S').coeff (n + 1 - (m + 1))
            rw [hQ_step_succ, hsub, hP_step_succ, hcoeff m (Nat.le_of_lt hmn),
              hcoeff (m + 1) hmn, hl, hl2]
          · have hmeq : m = n := by omega
            rw [hmeq]
            change ((Polynomial.X - Polynomial.C α) * Q S').coeff (n + 1) =
              (((1 : Polynomial ℂ) - Polynomial.C α * Polynomial.X) * P S').coeff (n + 1 - (n + 1))
            have hQdeg : (Q S').natDegree = n :=
              Polynomial.natDegree_multiset_prod_X_sub_C_eq_card S'
            have hQn1 : (Q S').coeff (n + 1) = 0 :=
              Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hQdeg]; exact Nat.lt_succ_self n)
            rw [Nat.sub_self, hQ_step_succ, hP_step_zero, hcoeff n (le_refl n), Nat.sub_self,
              hQn1, mul_zero, sub_zero]
    set B : ℕ := M_tot.card
    have hR0 : R_int.coeff 0 = 1 := by
      have h0 := congrArg (fun f => f.coeff 0) hR
      rw [Polynomial.coeff_map, eq_intCast, hP0 M_tot] at h0
      exact_mod_cast h0
    let Q_monic : Polynomial ℤ :=
      ∑ k ∈ Finset.range (B + 1), Polynomial.C (R_int.coeff (B - k)) * Polynomial.X ^ k
    have hQ_monic_coeff : ∀ m : ℕ, Q_monic.coeff m = if m ≤ B then R_int.coeff (B - m) else 0 := by
      intro m
      simp only [Q_monic, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
      split_ifs with hm
      · rw [Finset.sum_eq_single m]
        · simp
        · intro b _ hbm
          simp [Ne.symm hbm]
        · intro hnot
          exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hm)) hnot
      · have hm' : B < m := lt_of_not_ge hm
        refine Finset.sum_eq_zero fun b hb => ?_
        have hbm : m ≠ b := Nat.ne_of_gt (lt_of_lt_of_le (Finset.mem_range.mp hb) hm')
        simp [hbm]
    have hQ_monic_deg : Q_monic.natDegree ≤ B := by
      refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun m hm => ?_
      rw [hQ_monic_coeff m]
      simp [not_le.mpr hm]
    have hQ_monic_isMonic : Q_monic.Monic := by
      refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one B hQ_monic_deg ?_
      rw [hQ_monic_coeff B]
      simp [hR0]
    have hQ_map : Polynomial.map (Int.castRingHom ℂ) Q_monic = Q M_tot := by
      ext m
      rw [Polynomial.coeff_map, hQ_monic_coeff m, eq_intCast]
      split_ifs with hm
      · rw [(hRev M_tot).2 m hm]
        have hRm := congrArg (fun f => f.coeff (B - m)) hR
        rw [Polynomial.coeff_map, eq_intCast] at hRm
        exact hRm
      · rw [Int.cast_zero]
        have hm' : B < m := lt_of_not_ge hm
        have hQM_deg : (Q M_tot).natDegree = B :=
          Polynomial.natDegree_multiset_prod_X_sub_C_eq_card M_tot
        exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hQM_deg]; exact hm')).symm
    refine ⟨?_, ?_⟩
    · intro α hα
      refine ⟨Q_monic, hQ_monic_isMonic, ?_⟩
      have hmapAlg : Polynomial.mapAlg ℤ ℂ Q_monic = Q M_tot := by
        rw [Polynomial.mapAlg_eq_map]
        have hhom : algebraMap ℤ ℂ = Int.castRingHom ℂ := Subsingleton.elim _ _
        rw [hhom, hQ_map]
      exact Polynomial.aeval_root_of_mapAlg_eq_multiset_prod_X_sub_C M_tot hα hmapAlg
    · intro φ
      have hQM_map : ∀ S : Multiset ℂ, Polynomial.map φ.toRingHom (Q S) = Q (S.map φ) := by
        intro S
        induction S using Multiset.induction_on with
        | empty => simp [Q]
        | cons a S' ih =>
          simp only [Q, Multiset.map_cons, Multiset.prod_cons, Polynomial.map_mul,
            Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, ih]
          rfl
      have hFixed : Polynomial.map φ.toRingHom (Q M_tot) = Q M_tot := by
        rw [← hQ_map, Polynomial.map_map]
        have hhom : φ.toRingHom.comp (Int.castRingHom ℂ) = Int.castRingHom ℂ :=
          Subsingleton.elim _ _
        rw [hhom, hQ_map]
      rw [hQM_map M_tot] at hFixed
      have hRoots := congrArg Polynomial.roots hFixed
      dsimp only [Q] at hRoots
      rw [Polynomial.roots_multiset_prod_X_sub_C, Polynomial.roots_multiset_prod_X_sub_C] at hRoots
      exact hRoots
  obtain ⟨hInt_tot, hAut_tot⟩ := hStage5
  intro i hi
  refine ⟨hFilter hAut_tot i hi, ?_⟩
  intro α hα
  refine ⟨hInt_tot α ?_, hNorm i hi α hα⟩
  have hi_mem : i ∈ Finset.Iic (2 * d) := Finset.mem_Iic.mpr hi
  change α ∈ ∑ j ∈ Finset.Iic (2 * d), A j
  rw [← Finset.add_sum_erase _ _ hi_mem]
  exact Multiset.mem_add.mpr (Or.inl hα)

theorem weil_smooth_algClosure_baseChange_integral (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible X.hom]
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom] :
    AlgebraicGeometry.IsIntegral (weilBaseChangeOver F (AlgebraicClosure F) X).left ∧
    AlgebraicGeometry.IsProper (weilBaseChangeOver F (AlgebraicClosure F) X).hom ∧
    AlgebraicGeometry.SmoothOfRelativeDimension d (weilBaseChangeOver F (AlgebraicClosure F) X).hom :=
by
  let g := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
  let X_bar := weilBaseChangeOver F (AlgebraicClosure F) X
  have hp : CategoryTheory.IsPullback (CategoryTheory.Limits.pullback.fst X.hom g) X_bar.hom X.hom g :=
    CategoryTheory.IsPullback.of_hasPullback X.hom g
  have hProp : AlgebraicGeometry.IsProper X_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hp inferInstance
  have hSm : AlgebraicGeometry.SmoothOfRelativeDimension d X_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension d) hp inferInstance
  have hGeomIrred : AlgebraicGeometry.GeometricallyIrreducible X_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.GeometricallyIrreducible) hp inferInstance
  have hIrredX : IrreducibleSpace ↥X_bar.left :=
    AlgebraicGeometry.GeometricallyIrreducible.irreducibleSpace X_bar.hom
      (fun s _ => isOpen_discrete (⇑X_bar.hom '' s))
  have hRedStalk : ∀ x : ↥X_bar.left, _root_.IsReduced ↑(X_bar.left.presheaf.stalk x) := by
    intro x
    obtain ⟨U, _hU, V, hV, hx, e, hf⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d X_bar.hom).mp hSm x
    have : Nonempty U := ⟨⟨X_bar.hom.base x, e hx⟩⟩
    obtain ⟨g_et, _, hg_et⟩ := hf.exists_etale_mvPolynomial
    letI : Algebra
        (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
        ↑Γ(X_bar.left, V) := g_et.toAlgebra
    have : Algebra.Etale
        (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
        ↑Γ(X_bar.left, V) := hg_et.toAlgebra
    have : _root_.IsReduced
        (TensorProduct
          (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
          (FractionRing (MvPolynomial (Fin d)
            ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U)))
          ↑Γ(X_bar.left, V)) :=
      Algebra.FormallyUnramified.isReduced_of_field
        (FractionRing (MvPolynomial (Fin d)
          ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))) _
    have hInjPK : Function.Injective
        (Algebra.linearMap
          (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
          (FractionRing (MvPolynomial (Fin d)
            ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U)))) :=
      fun _ _ h => IsFractionRing.injective _ _ h
    have hInjRT : Function.Injective
        (LinearMap.rTensor ↑Γ(X_bar.left, V)
          (Algebra.linearMap
            (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
            (FractionRing (MvPolynomial (Fin d)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))))) :=
      Module.Flat.rTensor_preserves_injective_linearMap _ hInjPK
    have hEq : ∀ s : ↑Γ(X_bar.left, V),
        LinearMap.rTensor ↑Γ(X_bar.left, V)
          (Algebra.linearMap
            (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
            (FractionRing (MvPolynomial (Fin d)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))))
          ((TensorProduct.lid
            (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
            ↑Γ(X_bar.left, V)).symm s) =
          (Algebra.TensorProduct.includeRight :
            ↑Γ(X_bar.left, V) →ₐ[MvPolynomial (Fin d)
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U)]
              TensorProduct
                (MvPolynomial (Fin d)
                  ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
                (FractionRing (MvPolynomial (Fin d)
                  ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U)))
                ↑Γ(X_bar.left, V)) s := by
      intro s
      rw [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, Algebra.linearMap_apply, map_one,
        Algebra.TensorProduct.includeRight_apply]
    have hInj : Function.Injective
        (Algebra.TensorProduct.includeRight :
          ↑Γ(X_bar.left, V) →ₐ[MvPolynomial (Fin d)
            ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U)]
            TensorProduct
              (MvPolynomial (Fin d)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
              (FractionRing (MvPolynomial (Fin d)
                ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U)))
              ↑Γ(X_bar.left, V)) := by
      intro s₁ s₂ hs
      apply (TensorProduct.lid
        (MvPolynomial (Fin d) ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)), U))
        ↑Γ(X_bar.left, V)).symm.injective
      apply hInjRT
      rw [hEq, hEq, hs]
    have hRedS : _root_.IsReduced ↑Γ(X_bar.left, V) :=
      isReduced_of_injective _ hInj
    let xV : ↥V := ⟨x, hx⟩
    exact @isReduced_localizationPreserves ↑Γ(X_bar.left, V) _
      (hV.primeIdealOf xV).asIdeal.primeCompl
      ↑(X_bar.left.presheaf.stalk ↑xV) _
      (TopCat.Presheaf.algebra_section_stalk X_bar.left.presheaf xV)
      (hV.isLocalization_stalk xV) hRedS
  have hRedX : AlgebraicGeometry.IsReduced X_bar.left :=
    AlgebraicGeometry.isReduced_of_isReduced_stalk X_bar.left
  have hIntX : AlgebraicGeometry.IsIntegral X_bar.left :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X_bar.left
  exact ⟨hIntX, hProp, hSm⟩

theorem weil_smooth_integral_krullDim_over_field (k : Type u) [Field k] (d : ℕ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral Y.left)
    [AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom] :
    topologicalKrullDim Y.left = (d : WithBot ℕ∞) :=
by
  
  have h_open_nhds : ∀ (T : Type u) [TopologicalSpace T] [Nonempty T],
      (∀ x : T, ∃ V : TopologicalSpace.Opens T,
        x ∈ V ∧ topologicalKrullDim ↥V = (d : WithBot ℕ∞)) →
      topologicalKrullDim T = (d : WithBot ℕ∞) := by
    intro T _ hne hcov
    obtain ⟨t₀⟩ := hne
    apply le_antisymm
    · have : Nonempty (TopologicalSpace.IrreducibleCloseds T) :=
        ⟨⟨closure {t₀}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      change Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ ((d : ℕ∞) : WithBot ℕ∞)
      rw [Order.krullDim_eq_iSup_length]
      refine WithBot.coe_le_coe.mpr (iSup_le fun l => ?_)
      obtain ⟨x, hxF₀⟩ := (l 0).isIrreducible.nonempty
      obtain ⟨V, hxV, hDimV⟩ := hcov x
      let G : Fin (l.length + 1) → Set ↥V :=
        fun i => Subtype.val ⁻¹' ((l i : TopologicalSpace.IrreducibleCloseds T) : Set T)
      have hxG : ∀ i : Fin (l.length + 1), (⟨x, hxV⟩ : ↥V) ∈ G i :=
        fun i => l.strictMono.monotone (Fin.zero_le i) hxF₀
      let G' : Fin (l.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V :=
        fun i =>
          { carrier := G i
            isIrreducible' := ⟨⟨⟨x, hxV⟩, hxG i⟩,
              (l i).isIrreducible.isPreirreducible.preimage V.isOpen.isOpenEmbedding_subtypeVal⟩
            isClosed' := (l i).isClosed.preimage continuous_subtype_val }
      have hStrict : StrictMono G' := by
        intro i j hij
        have hle : G' i ≤ G' j := fun y hy => l.strictMono.monotone (le_of_lt hij) hy
        refine lt_of_le_not_ge hle (fun hge => ?_)
        have hsub : ((l j : TopologicalSpace.IrreducibleCloseds T) : Set T) ⊆
            ((l i : TopologicalSpace.IrreducibleCloseds T) : Set T) ∪ (V : Set T)ᶜ := by
          intro y hy
          by_cases hyV : y ∈ V
          · exact Or.inl (@hge ⟨y, hyV⟩ hy)
          · exact Or.inr hyV
        rcases isPreirreducible_iff_isClosed_union_isClosed.mp
            (l j).isIrreducible.isPreirreducible
            ((l i : TopologicalSpace.IrreducibleCloseds T) : Set T) (V : Set T)ᶜ
            (l i).isClosed V.isOpen.isClosed_compl hsub with
          h1 | h2
        · exact not_le_of_gt (l.strictMono hij) h1
        · exact h2 (l.strictMono.monotone (Fin.zero_le j) hxF₀) hxV
      let l_V : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
        { length := l.length
          toFun := G'
          step := fun _ => hStrict Fin.castSucc_lt_succ }
      exact WithBot.coe_le_coe.mp ((Order.LTSeries.length_le_krullDim l_V).trans_eq hDimV)
    · obtain ⟨V₀, _, hDimV₀⟩ := hcov t₀
      exact hDimV₀.symm.trans_le (topologicalKrullDim_subspace_le T (V₀ : Set T))

  
  have h_trdeg : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
      [Algebra (MvPolynomial (Fin d) k) S] [IsScalarTower k (MvPolynomial (Fin d) k) S]
      [Algebra.Etale (MvPolynomial (Fin d) k) S],
      Algebra.FiniteType k S ∧ Algebra.trdeg k S = (d : Cardinal.{u}) := by
    intro S _ _ _ _ _ _
    let R₀ : Type u := MvPolynomial (Fin d) k
    have hFT : Algebra.FiniteType k S :=
      Algebra.FiniteType.trans (S := R₀) inferInstance inferInstance
    refine ⟨hFT, ?_⟩
    have : Algebra.Smooth R₀ S := inferInstance
    have : Module.Flat R₀ S := inferInstance
    have : Module.IsTorsionFree R₀ S := Module.Flat.isTorsionFree
    have : FaithfulSMul R₀ S := inferInstance
    have hInjR₀S : Function.Injective (algebraMap R₀ S) :=
      (faithfulSMul_iff_algebraMap_injective R₀ S).mp inferInstance
    let K₀ : Type u := FractionRing R₀
    let M : Submonoid S := Algebra.algebraMapSubmonoid S (nonZeroDivisors R₀)
    let B' : Type u := TensorProduct R₀ S K₀
    have : IsLocalization M B' := IsLocalization.tensor K₀ (nonZeroDivisors R₀)
    have hM : M ≤ nonZeroDivisors S := by
      rintro m ⟨r, hr, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (fun h0 =>
        nonZeroDivisors.ne_zero hr (hInjR₀S (h0.trans (map_zero (algebraMap R₀ S)).symm)))
    have : IsDomain B' := IsLocalization.isDomain_of_le_nonZeroDivisors B' hM
    have hInjSB' : Function.Injective (algebraMap S B') := IsLocalization.injective B' hM
    have : FaithfulSMul S B' := (faithfulSMul_iff_algebraMap_injective S B').mpr hInjSB'
    have : FaithfulSMul k S :=
      (faithfulSMul_iff_algebraMap_injective k S).mpr (RingHom.injective (algebraMap k S))
    have : IsScalarTower k S B' := inferInstance
    have : Algebra.IsAlgebraic S B' := IsLocalization.isAlgebraic B' M
    have h_trdeg_SB' : Algebra.trdeg k S = Algebra.trdeg k B' := by
      have hadd := trdeg_add_eq k S (A := B')
      rw [trdeg_eq_zero (R := S) (A := B'), add_zero] at hadd
      exact hadd
    let B : Type u := TensorProduct R₀ K₀ S
    let e_comm : B ≃ₐ[R₀] B' := Algebra.TensorProduct.comm R₀ K₀ S
    have : IsDomain B := MulEquiv.isDomain B' e_comm.toMulEquiv
    let e_k : B ≃ₐ[k] B' := e_comm.restrictScalars k
    have h_trdeg_BB' : Algebra.trdeg k B = Algebra.trdeg k B' := AlgEquiv.trdeg_eq e_k
    have : Algebra.Etale K₀ B := Algebra.Etale.baseChange R₀ S K₀
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ B).mp inferInstance
    have : Algebra.IsAlgebraic K₀ B := by
      let _ : Finite I := hFinI
      let _ : ∀ i : I, Field (Ai i) := hFieldAi
      let _ : ∀ i : I, Algebra K₀ (Ai i) := hAlgAi
      have : ∀ i : I, Module.Finite K₀ (Ai i) := fun i => (hFinSep i).1
      have : Module.Finite K₀ ((i : I) → Ai i) := Module.Finite.pi
      have : Module.Finite K₀ B := Module.Finite.equiv e_prod.symm.toLinearEquiv
      have : Algebra.IsIntegral K₀ B := Algebra.IsIntegral.of_finite K₀ B
      exact Algebra.IsIntegral.isAlgebraic
    have : FaithfulSMul K₀ B :=
      (faithfulSMul_iff_algebraMap_injective K₀ B).mpr (RingHom.injective (algebraMap K₀ B))
    have : FaithfulSMul k K₀ :=
      (faithfulSMul_iff_algebraMap_injective k K₀).mpr (RingHom.injective (algebraMap k K₀))
    have : IsScalarTower k K₀ B := inferInstance
    have h_trdeg_K₀B : Algebra.trdeg k K₀ = Algebra.trdeg k B := by
      have hadd := trdeg_add_eq k K₀ (A := B)
      rw [trdeg_eq_zero (R := K₀) (A := B), add_zero] at hadd
      exact hadd
    have : FaithfulSMul k R₀ :=
      (faithfulSMul_iff_algebraMap_injective k R₀).mpr (RingHom.injective (algebraMap k R₀))
    have : FaithfulSMul R₀ K₀ :=
      (faithfulSMul_iff_algebraMap_injective R₀ K₀).mpr (IsFractionRing.injective R₀ K₀)
    have : Algebra.IsAlgebraic R₀ K₀ := IsLocalization.isAlgebraic K₀ (nonZeroDivisors R₀)
    have h_trdeg_R₀K₀ : Algebra.trdeg k R₀ = Algebra.trdeg k K₀ := by
      have hadd := trdeg_add_eq k R₀ (A := K₀)
      rw [trdeg_eq_zero (R := R₀) (A := K₀), add_zero] at hadd
      exact hadd
    have h_trdeg_R₀ : Algebra.trdeg k R₀ = (d : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype (Fin d), Fintype.card_fin,
        Cardinal.lift_natCast]
    exact h_trdeg_SB'.trans (h_trdeg_BB'.symm.trans (h_trdeg_K₀B.symm.trans
      (h_trdeg_R₀K₀.symm.trans h_trdeg_R₀)))

  
  have h_krull_ft : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
      [Algebra.FiniteType k S],
      Algebra.trdeg k S = (d : Cardinal.{u}) → ringKrullDim S = (d : WithBot ℕ∞) := by
    intro S _ _ _ _ htrdegS
    obtain ⟨s, g, hInj, hInt_g⟩ := exists_integral_inj_algHom_of_fg k S
    let A : Type u := MvPolynomial (Fin s) k
    let _ : Algebra A S := g.toRingHom.toAlgebra
    have : IsScalarTower k A S := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
    have hInjAS : Function.Injective (algebraMap A S) := hInj
    have : FaithfulSMul A S := (faithfulSMul_iff_algebraMap_injective A S).mpr hInjAS
    have : FaithfulSMul k A :=
      (faithfulSMul_iff_algebraMap_injective k A).mpr (RingHom.injective (algebraMap k A))
    have : Algebra.IsIntegral A S := ⟨hInt_g⟩
    have : Algebra.IsAlgebraic A S := Algebra.IsIntegral.isAlgebraic
    have h_trdeg_AS : Algebra.trdeg k A = Algebra.trdeg k S := by
      have hadd := trdeg_add_eq k A (A := S)
      rw [trdeg_eq_zero (R := A) (A := S), add_zero] at hadd
      exact hadd
    have h_trdeg_A : Algebra.trdeg k A = (s : Cardinal.{u}) := by
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype (Fin s), Fintype.card_fin,
        Cardinal.lift_natCast]
    have hsd : s = d := Nat.cast_inj.mp (h_trdeg_A.symm.trans (h_trdeg_AS.trans htrdegS))
    have hDimA : ringKrullDim A = (d : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin, hsd]
      rfl
    apply le_antisymm
    · 
      have hStrict : StrictMono (PrimeSpectrum.comap (algebraMap A S)) := by
        intro Q₁ Q₂ hQ
        have hlt_ideal : Q₁.asIdeal < Q₂.asIdeal := hQ
        obtain ⟨x, hxQ₂, hxQ₁⟩ := SetLike.exists_of_lt hlt_ideal
        exact @Ideal.under_lt_under_of_integral_mem_sdiff A _ S _ Q₁.asIdeal Q₂.asIdeal _
          Q₁.isPrime (le_of_lt hlt_ideal) x ⟨hxQ₂, hxQ₁⟩ (Algebra.IsIntegral.isIntegral x)
      exact (Order.krullDim_le_of_strictMono _ hStrict).trans_eq hDimA
    · 
      obtain ⟨l_A, hl_A⟩ := Order.le_krullDim_iff.mp (le_of_eq hDimA.symm)
      have h_lift : ∀ (m : ℕ) (p : LTSeries (PrimeSpectrum A)), p.length = m →
          ∃ q : LTSeries (PrimeSpectrum S),
            q.length = m ∧ Ideal.under A (q.last).asIdeal = (p.last).asIdeal := by
        intro m
        induction m with
        | zero =>
          intro p _
          have hker : Ideal.under A (⊥ : Ideal S) ≤ (p.last).asIdeal := by
            have hbot : Ideal.under A (⊥ : Ideal S) = ⊥ :=
              (RingHom.injective_iff_ker_eq_bot (algebraMap A S)).mp hInjAS
            rw [hbot]
            exact bot_le
          obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
            @Ideal.exists_ideal_over_prime_of_isIntegral A _ S _ _ _
              (p.last).asIdeal (p.last).isPrime (⊥ : Ideal S) hker
          refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, ?_⟩
          rw [RelSeries.last_singleton]
          exact hQ₀_under
        | succ m ih =>
          intro p hp
          let p' : LTSeries (PrimeSpectrum A) := p.eraseLast
          have hp'_len : p'.length = m := by
            rw [RelSeries.eraseLast_length, hp]
            omega
          have hstep : p'.last < p.last :=
            RelSeries.eraseLast_last_rel_last p (by omega)
          obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
          have hle_under : Ideal.under A (q'.last).asIdeal ≤ (p.last).asIdeal := by
            rw [hq'_under]
            exact le_of_lt hstep
          obtain ⟨Q, hQ_ge, hQ_prime, hQ_under⟩ :=
            @Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime A _ S _ _ _
              (p.last).asIdeal (p.last).isPrime (q'.last).asIdeal (q'.last).isPrime hle_under
          have hne : (q'.last).asIdeal ≠ Q := by
            intro heq
            apply ne_of_lt (show (p'.last).asIdeal < (p.last).asIdeal from hstep)
            rw [← hq'_under, heq, hQ_under]
          have hlt_Q : q'.last < (⟨Q, hQ_prime⟩ : PrimeSpectrum S) :=
            lt_of_le_of_ne hQ_ge (fun h => hne (congrArg PrimeSpectrum.asIdeal h))
          refine ⟨q'.snoc ⟨Q, hQ_prime⟩ hlt_Q, ?_, ?_⟩
          · rw [RelSeries.snoc_length, hq'_len]
          · rw [RelSeries.last_snoc]
            exact hQ_under
      obtain ⟨l_S, hl_S, _⟩ := h_lift d l_A hl_A
      exact Order.le_krullDim_iff.mpr ⟨l_S, hl_S⟩

  
  have : AlgebraicGeometry.IsIntegral Y.left := hInt
  have : IrreducibleSpace ↥Y.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y.left
  have : Nonempty ↥Y.left := IrreducibleSpace.toNonempty
  apply h_open_nhds Y.left
  intro x
  obtain ⟨U, _, V, hV, hxV, e, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff d Y.hom).mp inferInstance x
  have hU_top : U = ⊤ := by
    ext p
    exact ⟨fun _ => trivial, fun _ => Subsingleton.elim (Y.hom.base x) p ▸ e hxV⟩
  let e_U : k ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op U)) :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.trans
      ((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.mapIso
        (CategoryTheory.eqToIso (congrArg Opposite.op hU_top.symm)))).commRingCatIsoToRingEquiv
  obtain ⟨g_U, _, hg_U⟩ := RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd
  let S : Type u := ↑(Y.left.presheaf.obj (Opposite.op V))
  let e_poly := MvPolynomial.mapEquiv (Fin d) e_U
  let g : MvPolynomial (Fin d) k →+* S := g_U.comp e_poly.toRingHom
  have hg : g.Etale := RingHom.Etale.respectsIso.right g_U e_poly hg_U
  have hneV : Nonempty ↥(V : AlgebraicGeometry.Scheme) := ⟨⟨x, hxV⟩⟩
  have : IsDomain S := @AlgebraicGeometry.IsIntegral.component_integral Y.left hInt V hneV
  let _ : Algebra (MvPolynomial (Fin d) k) S := g.toAlgebra
  let _ : Algebra k S := (g.comp (algebraMap k (MvPolynomial (Fin d) k))).toAlgebra
  have : IsScalarTower k (MvPolynomial (Fin d) k) S := IsScalarTower.of_algebraMap_eq' rfl
  have : Algebra.Etale (MvPolynomial (Fin d) k) S := RingHom.etale_algebraMap.mp hg
  obtain ⟨hFT_S, hTrdeg_S⟩ := h_trdeg S
  have : Algebra.FiniteType k S := hFT_S
  have hDimS : ringKrullDim S = (d : WithBot ℕ∞) := h_krull_ft S hTrdeg_S
  refine ⟨V, hxV, ?_⟩
  have hHomeo := (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso hV.isoSpec)).isHomeomorph
  exact hHomeo.topologicalKrullDim_eq.trans
    ((PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim S).trans hDimS)

theorem weil_birational_iso_on_open_krullDim_eq (k : Type u) [Field k]
    (V Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV : AlgebraicGeometry.IsIntegral V.left)
    (hProjV : IsProjectiveOverField k V)
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    [AlgebraicGeometry.LocallyOfFiniteType Y.hom]
    (π : V ⟶ Y) (U₀ : Y.left.Opens) (hU₀ : Nonempty U₀)
    [CategoryTheory.IsIso (π.left ∣_ U₀)] :
    topologicalKrullDim V.left = topologicalKrullDim Y.left :=
by
  
  have hFTV : AlgebraicGeometry.LocallyOfFiniteType V.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProjV
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr
        (RingHom.FiniteType.of_surjective _ hSurj0)
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    infer_instance

  
  have h_loc_dim : ∀ (X : Type u) [TopologicalSpace X] [Nonempty X] (d : WithBot ℕ∞),
      (∀ x : X, ∃ V : TopologicalSpace.Opens X, x ∈ V ∧ topologicalKrullDim ↥V = d) →
      topologicalKrullDim X = d := by
    clear * -
    intro X _ hNeX d hX
    apply le_antisymm
    · change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds X)),
        (p.length : WithBot ℕ∞) ≤ d
      apply iSup_le
      intro p
      obtain ⟨x, hx0⟩ := (p 0).isIrreducible.nonempty
      obtain ⟨V, hxV, hVdim⟩ := hX x
      have hv_emb : Topology.IsOpenEmbedding (Subtype.val : ↥V → X) := V.isOpenEmbedding'
      let c : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V := fun i =>
        have hx_i : x ∈ (p i : Set X) := p.monotone (Fin.zero_le i) hx0
        have h_nonempty_i : ((p i : Set X) ∩ Set.range (Subtype.val : ↥V → X)).Nonempty :=
          ⟨x, hx_i, ⟨x, hxV⟩, rfl⟩
        { carrier := (Subtype.val : ↥V → X) ⁻¹' (p i : Set X)
          isIrreducible' := (p i).isIrreducible.preimage hv_emb h_nonempty_i
          isClosed' := (p i).isClosed.preimage continuous_subtype_val }
      have h_strict : ∀ i : Fin p.length, c (Fin.castSucc i) < c i.succ := by
        intro i
        have hp_lt : p (Fin.castSucc i) < p i.succ := p.step i
        have h_le : c (Fin.castSucc i) ≤ c i.succ := fun y hy =>
          (le_of_lt hp_lt) hy
        refine lt_of_le_not_ge h_le (fun h_ge => ?_)
        have h_not_sub : ¬ ((p i.succ : Set X) ⊆ (p (Fin.castSucc i) : Set X)) :=
          not_le_of_gt hp_lt
        obtain ⟨y, hy_succ, hy_not⟩ := Set.not_subset.mp h_not_sub
        have hO₁ : IsOpen ((p (Fin.castSucc i) : Set X)ᶜ) :=
          (p (Fin.castSucc i)).isClosed.isOpen_compl
        have hO₂ : IsOpen (V : Set X) := V.isOpen
        have hN₁ : ((p i.succ : Set X) ∩ (p (Fin.castSucc i) : Set X)ᶜ).Nonempty :=
          ⟨y, hy_succ, hy_not⟩
        have hN₂ : ((p i.succ : Set X) ∩ (V : Set X)).Nonempty :=
          ⟨x, p.monotone (Fin.zero_le i.succ) hx0, hxV⟩
        obtain ⟨w, hw_succ, hw_not, hw_V⟩ :=
          (p i.succ).isIrreducible.isPreirreducible _ _ hO₁ hO₂ hN₁ hN₂
        have hw_in : (⟨w, hw_V⟩ : ↥V) ∈ c i.succ := hw_succ
        exact hw_not (h_ge hw_in)
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
        { length := p.length, toFun := c, step := h_strict }
      calc (p.length : WithBot ℕ∞)
          = (q.length : WithBot ℕ∞) := rfl
        _ ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥V) :=
            Order.LTSeries.length_le_krullDim q
        _ = topologicalKrullDim ↥V := rfl
        _ = d := hVdim
    · obtain ⟨x₀⟩ := hNeX
      obtain ⟨V₀, _, hV₀⟩ := hX x₀
      calc d = topologicalKrullDim ↥V₀ := hV₀.symm
        _ = topologicalKrullDim ↥(V₀ : Set X) := rfl
        _ ≤ topologicalKrullDim X := topologicalKrullDim_subspace_le X (V₀ : Set X)

  
  have h_single_dom : ∀ (R K : Type u) [CommRing R] [IsDomain R] [Algebra k R]
      [Algebra.FiniteType k R] [Field K] [Algebra k K] [Algebra R K]
      [IsScalarTower k R K] [IsFractionRing R K],
      ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k K ∧
        ringKrullDim R = (s : WithBot ℕ∞) := by
    intro R K _ _ _ _ _ _ _ _ _
    have h_tr_RK_eq : Algebra.trdeg k R = Algebra.trdeg k K := by
      have : FaithfulSMul k R :=
        (faithfulSMul_iff_algebraMap_injective k R).mpr (algebraMap k R).injective
      have : FaithfulSMul R K :=
        (faithfulSMul_iff_algebraMap_injective R K).mpr (IsFractionRing.injective R K)
      have : Algebra.IsAlgebraic R K := IsLocalization.isAlgebraic K (nonZeroDivisors R)
      have h_tr_RK : Algebra.trdeg R K = 0 := trdeg_eq_zero
      have hadd := trdeg_add_eq k R (A := K)
      rw [h_tr_RK, add_zero] at hadd
      exact hadd
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k R
    let P : Type u := MvPolynomial (Fin s) k
    have h_dim_P : ringKrullDim P = (s : WithBot ℕ∞) := by
      change ringKrullDim (MvPolynomial (Fin s) k) = (s : WithBot ℕ∞)
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    let : Algebra P R := g.toRingHom.toAlgebra
    have : Algebra.IsIntegral P R := ⟨hg_int⟩
    have h_tr_kR : (s : Cardinal.{u}) = Algebra.trdeg k R := by
      have : IsScalarTower k P R := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
      have : FaithfulSMul k P :=
        (faithfulSMul_iff_algebraMap_injective k P).mpr (algebraMap k P).injective
      have : FaithfulSMul P R :=
        (faithfulSMul_iff_algebraMap_injective P R).mpr hg_inj
      have : Algebra.IsAlgebraic P R := Algebra.IsIntegral.isAlgebraic
      have h_tr_PR : Algebra.trdeg P R = 0 := trdeg_eq_zero
      have h_tr_kP : Algebra.trdeg k P = (s : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast]
      have hadd := trdeg_add_eq k P (A := R)
      rw [h_tr_kP, h_tr_PR, add_zero] at hadd
      exact hadd
    have h_dim_le : ringKrullDim R ≤ ringKrullDim P := by
      apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap P R))
      intro q₁ q₂ hlt
      have h_not_le : ¬ (q₂.asIdeal ≤ q₁.asIdeal) := not_le_of_gt hlt
      obtain ⟨x, hxq₂, hxq₁⟩ := Set.not_subset.mp h_not_le
      have hx_sdiff : x ∈ (q₂.asIdeal : Set R) \ (q₁.asIdeal : Set R) := ⟨hxq₂, hxq₁⟩
      have h_int_x : IsIntegral P x := Algebra.IsIntegral.isIntegral x
      have := q₁.isPrime
      exact Ideal.under_lt_under_of_integral_mem_sdiff (R := P) (le_of_lt hlt) hx_sdiff h_int_x
    have h_lift : ∀ (m : ℕ) (p : LTSeries (PrimeSpectrum P)), p.length = m →
        ∃ (q : LTSeries (PrimeSpectrum R)),
          q.length = m ∧ Ideal.under P q.last.asIdeal = p.last.asIdeal := by
      intro m
      induction m with
      | zero =>
        intro p _
        have h_bot : Ideal.under P (⊥ : Ideal R) ≤ p.last.asIdeal := by
          intro y hy
          have hy0 : g y = 0 := Ideal.mem_bot.mp hy
          have hy_eq : y = 0 := hg_inj (hy0.trans (map_zero g).symm)
          rw [hy_eq]
          exact p.last.asIdeal.zero_mem
        have := p.last.isPrime
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (R := P) (S := R)
            p.last.asIdeal (⊥ : Ideal R) h_bot
        refine ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, hQ₀_under⟩
      | succ m ih =>
        intro p hp_len
        let p' : LTSeries (PrimeSpectrum P) := p.eraseLast
        have hp'_len : p'.length = m := by
          rw [RelSeries.eraseLast_length, hp_len]
          omega
        have hp'_lt : p'.last < p.last :=
          p.eraseLast_last_rel_last (by omega)
        obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
        have h_le_under : Ideal.under P q'.last.asIdeal ≤ p.last.asIdeal := by
          rw [hq'_under]
          exact le_of_lt hp'_lt
        have := p.last.isPrime
        have := q'.last.isPrime
        obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (R := P) (S := R)
            p.last.asIdeal q'.last.asIdeal h_le_under
        have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum R) := by
          refine lt_of_le_not_ge hQ_ge (fun h_ge => ?_)
          have h_eq : Q_next = q'.last.asIdeal := le_antisymm h_ge hQ_ge
          have h_under_eq : p.last.asIdeal = p'.last.asIdeal := by
            rw [← hQ_under, h_eq, hq'_under]
          exact (ne_of_lt hp'_lt) (PrimeSpectrum.ext h_under_eq.symm)
        let q : LTSeries (PrimeSpectrum R) := q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q
        refine ⟨q, ?_, ?_⟩
        · rw [RelSeries.snoc_length, hq'_len]
        · rw [RelSeries.last_snoc]
          exact hQ_under
    have h_dim_ge : ringKrullDim P ≤ ringKrullDim R := by
      change ⨆ (p : LTSeries (PrimeSpectrum P)), (p.length : WithBot ℕ∞) ≤ ringKrullDim R
      apply iSup_le
      intro p
      obtain ⟨q, hq_len, _⟩ := h_lift p.length p rfl
      calc (p.length : WithBot ℕ∞)
          = (q.length : WithBot ℕ∞) := by rw [hq_len]
        _ ≤ Order.krullDim (PrimeSpectrum R) := Order.LTSeries.length_le_krullDim q
        _ = ringKrullDim R := rfl
    exact ⟨s, h_tr_kR.trans h_tr_RK_eq, (le_antisymm h_dim_le h_dim_ge).trans h_dim_P⟩

  
  have h_open_eq : ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (_ : AlgebraicGeometry.IsIntegral Z.left) [AlgebraicGeometry.LocallyOfFiniteType Z.hom]
      (W : Z.left.Opens) (_ : Nonempty ↥W),
      topologicalKrullDim ↥W = topologicalKrullDim Z.left := by
    intro Z hIntZ _ W hW
    have : Nonempty ↥W := hW
    have : AlgebraicGeometry.IsIntegral Z.left := hIntZ
    have : IrreducibleSpace ↥Z.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z.left
    obtain ⟨⟨w₀, _⟩⟩ := hW
    have : Nonempty ↥Z.left := ⟨w₀⟩
    have : Nonempty ↥(⊤ : Z.left.Opens).toScheme := ⟨⟨w₀, TopologicalSpace.Opens.mem_top w₀⟩⟩
    let K : Type u := ↑Z.left.functionField
    let R_k := CommRingCat.of k
    let φ_top : R_k ⟶ Z.left.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ Z.hom.appLE ⊤ ⊤ le_top
    let : Algebra k K := ((Z.left.germToFunctionField ⊤).hom.comp φ_top.hom).toAlgebra
    have hSurjΓ : Function.Surjective ((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom := by
      intro y
      refine ⟨((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom).hom y, ?_⟩
      change (((AlgebraicGeometry.Scheme.ΓSpecIso R_k).hom ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom) y = y
      rw [Iso.hom_inv_id]
      rfl
    have h_aff_dim : ∀ (U : Z.left.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
        ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k K ∧
          topologicalKrullDim ↥U = (s : WithBot ℕ∞) := by
      intro U hAffU hU
      have : Nonempty ↥U.toScheme := hU
      let A : Type u := ↑(Z.left.presheaf.obj (Opposite.op U))
      have : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral Z.left hIntZ U hU
      let φ_U : R_k ⟶ Z.left.presheaf.obj (Opposite.op U) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv ≫ Z.hom.appLE ⊤ U le_top
      let : Algebra k A := φ_U.hom.toAlgebra
      have hFT_appU : (Z.hom.appLE ⊤ U le_top).hom.FiniteType :=
        Z.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hAffU le_top
      have hFT_φU : φ_U.hom.FiniteType := by
        change ((Z.hom.appLE ⊤ U le_top).hom.comp
          ((AlgebraicGeometry.Scheme.ΓSpecIso R_k).inv).hom).FiniteType
        exact RingHom.FiniteType.comp hFT_appU (RingHom.FiniteType.of_surjective _ hSurjΓ)
      have : Algebra.FiniteType k A := hFT_φU
      have h_comm_germ : Z.hom.appLE ⊤ U le_top ≫ Z.left.germToFunctionField U =
          Z.hom.appLE ⊤ ⊤ le_top ≫ Z.left.germToFunctionField ⊤ := by
        have h1 : Z.hom.appLE ⊤ ⊤ le_top ≫ Z.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op =
            Z.hom.appLE ⊤ U le_top :=
          AlgebraicGeometry.Scheme.Hom.appLE_map Z.hom le_top (homOfLE (le_top : U ≤ ⊤)).op
        rw [← h1, Category.assoc]
        congr 1
        exact TopCat.Presheaf.germ_res Z.left.presheaf (homOfLE (le_top : U ≤ ⊤)) _ _
      have h_tower_eq : φ_U ≫ Z.left.germToFunctionField U =
          φ_top ≫ Z.left.germToFunctionField ⊤ := by
        dsimp [φ_U, φ_top]
        rw [Category.assoc, Category.assoc, h_comm_germ]
      have : IsScalarTower k A K :=
        IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h_tower_eq).symm
      have : IsFractionRing A K :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z.left U hAffU
      obtain ⟨s, hs_tr, hs_ring⟩ := h_single_dom A K
      let e_U := AlgebraicGeometry.Scheme.homeoOfIso hAffU.isoSpec
      have h_top_U : topologicalKrullDim ↥U = ringKrullDim A := by
        calc topologicalKrullDim ↥U
            = topologicalKrullDim ↥U.toScheme := rfl
          _ = topologicalKrullDim
                ↥(AlgebraicGeometry.Spec (Z.left.presheaf.obj (Opposite.op U))) :=
              e_U.isHomeomorph.topologicalKrullDim_eq
          _ = topologicalKrullDim (PrimeSpectrum A) := rfl
          _ = ringKrullDim A := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A
      exact ⟨s, hs_tr, h_top_U.trans hs_ring⟩
    obtain ⟨U_ref, hAff_ref, hw₀_ref, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top w₀)
    obtain ⟨s₀, hs₀_tr, _⟩ := h_aff_dim U_ref hAff_ref ⟨⟨w₀, hw₀_ref⟩⟩
    have h_basis : ∀ (O : TopologicalSpace.Opens ↥Z.left) (x : ↥Z.left), x ∈ O →
        ∃ U : TopologicalSpace.Opens ↥Z.left,
          x ∈ U ∧ U ≤ O ∧ topologicalKrullDim ↥U = (s₀ : WithBot ℕ∞) := by
      intro O x hxO
      obtain ⟨U, hAffU, hxU, hUO⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hxO
      obtain ⟨s, hs_tr, hs_dim⟩ := h_aff_dim U hAffU ⟨⟨x, hxU⟩⟩
      have hs_eq : s = s₀ := Nat.cast_injective (hs_tr.trans hs₀_tr.symm)
      exact ⟨U, hxU, hUO, hs_dim.trans (by rw [hs_eq])⟩
    have h_dim_Z : topologicalKrullDim ↥Z.left = (s₀ : WithBot ℕ∞) := by
      apply h_loc_dim ↥Z.left (s₀ : WithBot ℕ∞)
      intro x
      obtain ⟨U, hxU, _, hUdim⟩ := h_basis ⊤ x (TopologicalSpace.Opens.mem_top x)
      exact ⟨U, hxU, hUdim⟩
    have h_dim_W : topologicalKrullDim ↥W = (s₀ : WithBot ℕ∞) := by
      apply h_loc_dim ↥W (s₀ : WithBot ℕ∞)
      intro y
      obtain ⟨U, hyU, hUW, hUdim⟩ := h_basis W y.1 y.2
      let U_W : TopologicalSpace.Opens ↥W :=
        ⟨(Subtype.val : ↥W → ↥Z.left) ⁻¹' (U : Set ↥Z.left),
          U.isOpen.preimage continuous_subtype_val⟩
      let e_UW : ↥U_W ≃ₜ ↥U :=
        { toFun := fun z => ⟨z.1.1, z.2⟩
          invFun := fun u => ⟨⟨u.1, hUW u.2⟩, u.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          continuous_toFun :=
            Continuous.subtype_mk (continuous_subtype_val.comp continuous_subtype_val) _
          continuous_invFun :=
            Continuous.subtype_mk (Continuous.subtype_mk continuous_subtype_val _) _ }
      refine ⟨U_W, hyU, ?_⟩
      exact e_UW.isHomeomorph.topologicalKrullDim_eq.trans hUdim
    exact h_dim_W.trans h_dim_Z.symm

  
  let W₀ : V.left.Opens := (TopologicalSpace.Opens.map π.left.base).obj U₀
  let e₀ := AlgebraicGeometry.Scheme.homeoOfIso (CategoryTheory.asIso (π.left ∣_ U₀))
  have ⟨u₀⟩ := hU₀
  have hW₀ : Nonempty ↥W₀ := ⟨e₀.symm u₀⟩
  have h_iso_dim : topologicalKrullDim ↥W₀ = topologicalKrullDim ↥U₀ :=
    e₀.isHomeomorph.topologicalKrullDim_eq
  exact (h_open_eq V hIntV W₀ hW₀).symm.trans (h_iso_dim.trans (h_open_eq Y hIntY U₀ hU₀))

theorem weil_chow_birational_projective_modification (k : Type u) [Field k]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    [AlgebraicGeometry.IsProper Y.hom] :
    ∃ (V₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π₀ : V₀ ⟶ Y) (U₀ : Y.left.Opens),
      AlgebraicGeometry.IsIntegral V₀.left ∧
      IsProjectiveOverField k V₀ ∧
      AlgebraicGeometry.IsProper π₀.left ∧
      AlgebraicGeometry.Surjective π₀.left ∧
      Nonempty U₀ ∧
      CategoryTheory.IsIso (π₀.left ∣_ U₀) :=
by
  
  have step1 :
      Y.left.IsSeparated ∧
      ∃ (r : ℕ) (_ : 0 < r)
        (U : Fin r → Y.left.Opens),
        (⨆ j : Fin r, U j = ⊤) ∧
        (∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j)) ∧
        (∀ j : Fin r, Nonempty (U j)) ∧
        ∃ (n : Fin r → ℕ)
          (f : ∀ j : Fin r, Fin (n j) → ↑(Y.left.presheaf.obj (Opposite.op (U j)))),
          (∀ j : Fin r, Function.Surjective (MvPolynomial.eval₂Hom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ (U j) le_top).hom) (f j))) ∧
          ∃ (U₀ : Y.left.Opens),
            (∀ j : Fin r, U₀ ≤ U j) ∧
            Nonempty U₀ ∧
            AlgebraicGeometry.IsAffineOpen U₀ := by
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    have hSepSk : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S_k) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff S_k).mp inferInstance
    have hTermEq : CategoryTheory.Limits.terminal.from Y.left =
        Y.hom ≫ CategoryTheory.Limits.terminal.from S_k :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    have hSepTermY : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from Y.left) := by
      rw [hTermEq]; infer_instance
    have hSepY : Y.left.IsSeparated :=
      (AlgebraicGeometry.Scheme.isSeparated_iff Y.left).mpr hSepTermY
    have : AlgebraicGeometry.Scheme.IsSeparated Y.left := hSepY
    have : AlgebraicGeometry.IsIntegral Y.left := hIntY
    have : IrreducibleSpace ↥Y.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y.left
    have : CompactSpace ↥Y.left := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace Y.hom
    have hAffPoint : ∀ y : Y.left, ∃ W : Y.left.Opens, AlgebraicGeometry.IsAffineOpen W ∧ y ∈ W := by
      intro y
      obtain ⟨W, hAffW, hyW, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Y.left.Opens)) (Set.mem_univ y)
      exact ⟨W, hAffW, hyW⟩
    choose W hAffW hyW using hAffPoint
    obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover
      (fun y : Y.left => (W y : Set Y.left))
      (fun y => (W y).isOpen)
      (fun y _ => Set.mem_iUnion.mpr ⟨y, hyW y⟩)
    let r : ℕ := s.card
    let e_s : Fin r ≃ ↥s := (Fintype.equivFinOfCardEq (Fintype.card_coe s)).symm
    let U : Fin r → Y.left.Opens := fun j => W (e_s j).1
    have hCovU : ⨆ j : Fin r, U j = ⊤ := by
      apply le_antisymm le_top
      intro y _
      have hyUniv : y ∈ (⋃ x ∈ s, (W x : Set Y.left)) := hs (Set.mem_univ y)
      rcases Set.mem_iUnion₂.mp hyUniv with ⟨x, hx_s, hyWx⟩
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨e_s.symm ⟨x, hx_s⟩, by simpa [U] using hyWx⟩
    have hAffU : ∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j) := fun j => hAffW (e_s j).1
    have hNonU : ∀ j : Fin r, Nonempty (U j) := fun j => ⟨⟨(e_s j).1, hyW (e_s j).1⟩⟩
    obtain ⟨y₀⟩ := (inferInstance : Nonempty ↥Y.left)
    have hy₀ : y₀ ∈ (⨆ j : Fin r, U j) := by rw [hCovU]; trivial
    obtain ⟨j₀, _⟩ := TopologicalSpace.Opens.mem_iSup.mp hy₀
    have hr : 0 < r := Fin.pos j₀
    have hGenEx : ∀ j : Fin r, ∃ (nj : ℕ)
        (fj : Fin nj → ↑(Y.left.presheaf.obj (Opposite.op (U j)))),
        Function.Surjective (MvPolynomial.eval₂Hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ (U j) le_top).hom) fj) := by
      intro j
      let A_j := ↑(Y.left.presheaf.obj (Opposite.op (U j)))
      let κ_j : k →+* A_j :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ (U j) le_top).hom)
      have hFT_app : RingHom.FiniteType (AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ (U j) le_top).hom :=
        Y.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_k) (hAffU j) le_top
      have hSurjIso : Function.Surjective ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv.symm).surjective
      have hFT_κ : RingHom.FiniteType κ_j := by
        change RingHom.FiniteType
          ((AlgebraicGeometry.Scheme.Hom.appLE Y.hom ⊤ (U j) le_top).hom.comp
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv).hom)
        exact hFT_app.comp (RingHom.FiniteType.of_surjective _ hSurjIso)
      letI : Algebra k A_j := κ_j.toAlgebra
      have hAlgFT : Algebra.FiniteType k A_j := hFT_κ
      obtain ⟨nj, ψ, hSurjψ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hAlgFT
      refine ⟨nj, fun m => ψ (MvPolynomial.X m), ?_⟩
      have hEqHom : ψ.toRingHom = MvPolynomial.eval₂Hom κ_j (fun m => ψ (MvPolynomial.X m)) := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.eval₂Hom_C]
          exact ψ.commutes c
        · intro m
          simp
      rw [← hEqHom]
      exact hSurjψ
    choose n f hGen using hGenEx
    have hInter : ∀ (m : ℕ) (V : Fin (m + 1) → Y.left.Opens),
        (∀ i, Nonempty (V i)) → (∀ i, AlgebraicGeometry.IsAffineOpen (V i)) →
        Nonempty (⨅ i : Fin (m + 1), V i : Y.left.Opens) ∧
          AlgebraicGeometry.IsAffineOpen (⨅ i : Fin (m + 1), V i : Y.left.Opens) := by
      intro m
      induction m with
      | zero =>
        intro V hNonV hAffV
        have hEq : (⨅ i : Fin 1, V i) = V 0 := ciInf_unique
        rw [hEq]
        exact ⟨hNonV 0, hAffV 0⟩
      | succ m ih =>
        intro V hNonV hAffV
        have hEq : (⨅ i : Fin (m + 2), V i) = V 0 ⊓ (⨅ i : Fin (m + 1), V i.succ) := by
          apply le_antisymm
          · exact le_inf (iInf_le V 0) (le_iInf fun i => iInf_le V i.succ)
          · refine le_iInf fun i => ?_
            refine Fin.cases ?_ ?_ i
            · exact inf_le_left
            · intro j
              exact inf_le_right.trans (iInf_le (fun k : Fin (m + 1) => V k.succ) j)
        rw [hEq]
        let Vrest : Y.left.Opens := ⨅ i : Fin (m + 1), V i.succ
        obtain ⟨hNonRest, hAffRest⟩ := ih (fun i => V i.succ) (fun i => hNonV i.succ) (fun i => hAffV i.succ)
        obtain ⟨⟨x₁, hx₁⟩⟩ := hNonV 0
        obtain ⟨⟨x₂, hx₂⟩⟩ := hNonRest
        obtain ⟨z, _, hz₁, hz₂⟩ := PreirreducibleSpace.isPreirreducible_univ
          (V 0 : Set Y.left) (Vrest : Set Y.left)
          (V 0).isOpen Vrest.isOpen ⟨x₁, trivial, hx₁⟩ ⟨x₂, trivial, hx₂⟩
        exact ⟨⟨⟨z, hz₁, hz₂⟩⟩, (hAffV 0).inf hAffRest⟩
    let U₀ : Y.left.Opens := ⨅ j : Fin r, U j
    obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hr)
    have hU₀_eq : U₀ = ⨅ i : Fin (m + 1), U (Fin.cast hm.symm i) := by
      apply le_antisymm
      · exact le_iInf fun i => iInf_le U (Fin.cast hm.symm i)
      · exact le_iInf fun j => (iInf_le (fun i : Fin (m + 1) => U (Fin.cast hm.symm i)) (Fin.cast hm j)).trans (by simp)
    have hU₀_props : Nonempty U₀ ∧ AlgebraicGeometry.IsAffineOpen U₀ := by
      rw [hU₀_eq]
      exact hInter m (fun i => U (Fin.cast hm.symm i))
        (fun i => hNonU (Fin.cast hm.symm i)) (fun i => hAffU (Fin.cast hm.symm i))
    exact ⟨hSepY, r, hr, U, hCovU, hAffU, hNonU, n, f, hGen, U₀, fun j => iInf_le U j,
      hU₀_props.1, hU₀_props.2⟩
  obtain ⟨hSepY, r, hr, U, hCovU, hAffU, _hNonU, n, f, hGen, U₀, hU₀_le, hU₀, hAffU₀⟩ := step1
  
  have step2 :
      ∃ (N : ℕ)
        (Φ : (U₀ : AlgebraicGeometry.Scheme) ⟶ (weilProjectiveSpaceOver k N).left)
        (D : Fin (N + 1) → (weilProjectiveSpaceOver k N).left.Opens)
        (z : ∀ (_β γ : Fin (N + 1)),
          ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D γ))))
        (IsZeroAt : Fin r → Fin (N + 1) → Prop),
        (Φ ≫ (weilProjectiveSpaceOver k N).hom = U₀.ι ≫ Y.hom) ∧
        ((⨆ γ : Fin (N + 1), D γ = ⊤) ∧
          (∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ)) ∧
          (∀ β γ : Fin (N + 1),
            (weilProjectiveSpaceOver k N).left.basicOpen (z β γ) ≤ D β)) ∧
        (∀ (j₀ : Fin r) (γ : Fin (N + 1)),
          ∃ (β : Fin (N + 1)) (u : ↑(Y.left.presheaf.obj (Opposite.op (U j₀)))),
            IsZeroAt j₀ β ∧
            ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
              ((AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j₀)
                ((TopologicalSpace.Opens.map Φ.base).obj (D γ))
                (fun x _ => hU₀_le j₀ x.2)).hom u) = 1) ∧
        (∀ (j : Fin r) (β : Fin (N + 1)), IsZeroAt j β → ∀ m : Fin (n j),
          ∃ β_m : Fin (N + 1),
            (AlgebraicGeometry.Scheme.Hom.app Φ (D β)).hom (z β_m β) =
              (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j)
                ((TopologicalSpace.Opens.map Φ.base).obj (D β))
                (fun x _ => hU₀_le j x.2)).hom (f j m)) := by
    clear hSepY hCovU hAffU _hNonU hGen hU₀ hAffU₀ hIntY
    let f_tilde : ∀ j : Fin r, Fin (n j + 1) → ↑(Y.left.presheaf.obj (Opposite.op (U j))) :=
      fun j => Fin.cases 1 (f j)
    let M : ℕ := ∏ j : Fin r, (n j + 1)
    have hM_pos : 1 ≤ M := Finset.one_le_prod (fun j _ => Nat.succ_pos (n j))
    let N : ℕ := M - 1
    have hNM : N + 1 = M := Nat.sub_add_cancel hM_pos
    have hCard : Fintype.card (∀ j : Fin r, Fin (n j + 1)) = N + 1 := by
      simp [Fintype.card_pi, M, hNM]
    let e : Fin (N + 1) ≃ (∀ j : Fin r, Fin (n j + 1)) :=
      (Fintype.equivFinOfCardEq hCard).symm
    let IsZeroAt : Fin r → Fin (N + 1) → Prop := fun j β => (e β) j = 0
    let i₀ : Fin (N + 1) := e.symm (fun _ => 0)
    let ρ : ∀ j : Fin r, ↑(Y.left.presheaf.obj (Opposite.op (U j))) →+*
        ↑((U₀ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)) :=
      fun j => (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) ⊤ (fun x _ => hU₀_le j x.2)).hom
    let κ₀_cat : CommRingCat.of k ⟶ (U₀ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (U₀.ι ≫ Y.hom).appTop
    let κ₀ : k →+* ↑((U₀ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)) := κ₀_cat.hom
    let g : Fin (N + 1) → ↑((U₀ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)) :=
      fun α => ∏ j : Fin r, ρ j (f_tilde j ((e α) j))
    have hg_i₀ : g i₀ = 1 := by
      simp [g, i₀, f_tilde]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    letI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x q => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) q⟩
    have hX : ∀ α : Fin (N + 1), (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
      fun α => MvPolynomial.isHomogeneous_X k α
    let ψ : MvPolynomial (Fin (N + 1)) k →+*
        ↑((U₀ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)) :=
      MvPolynomial.eval₂Hom κ₀ g
    have hUnit₀ : IsUnit (ψ (MvPolynomial.X i₀)) := by
      rw [MvPolynomial.eval₂Hom_X', hg_i₀]
      exact isUnit_one
    let valHom : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) →+*
        Localization.Away (MvPolynomial.X i₀) :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
    let φ₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) →+*
        ↑((U₀ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤)) :=
      (IsLocalization.Away.lift (MvPolynomial.X i₀) hUnit₀).comp valHom
    let Φ_aff : (U₀ : AlgebraicGeometry.Scheme) ⟶ AlgebraicGeometry.Spec
        (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀))) :=
      (U₀ : AlgebraicGeometry.Scheme).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)
    let ι_away : ∀ γ : Fin (N + 1),
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X γ))) ⟶
          AlgebraicGeometry.Proj 𝒜 :=
      fun γ => AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X γ) (hX γ) zero_lt_one
    let Φ : (U₀ : AlgebraicGeometry.Scheme) ⟶ AlgebraicGeometry.Proj 𝒜 := Φ_aff ≫ ι_away i₀
    have toSpecΓ_SpecMap_of_hom : ∀ {X : AlgebraicGeometry.Scheme} {R : CommRingCat}
        (m : X ⟶ AlgebraicGeometry.Spec R),
        X.toSpecΓ ≫ AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ m.appTop) = m := by
      intro X R m
      calc
        X.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ m.appTop)
          = (X.toSpecΓ ≫ AlgebraicGeometry.Spec.map m.appTop) ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv := by
            rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
        _ = m ≫ (AlgebraicGeometry.Spec R).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv := by
            rw [← AlgebraicGeometry.Scheme.toSpecΓ_naturality m, Category.assoc]
        _ = m := by
            rw [← AlgebraicGeometry.SpecMap_ΓSpecIso_hom, ← AlgebraicGeometry.Spec.map_comp,
              Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id, Category.comp_id]
    have hom_ext_Spec : ∀ {X : AlgebraicGeometry.Scheme} {R : CommRingCat}
        {m₁ m₂ : X ⟶ AlgebraicGeometry.Spec R},
        (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ m₁.appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ m₂.appTop → m₁ = m₂ := by
      intro X R m₁ m₂ h
      rw [← toSpecΓ_SpecMap_of_hom m₁, ← toSpecΓ_SpecMap_of_hom m₂, h]
    have specHom_SpecMap : ∀ {R S : CommRingCat} (φ : R ⟶ S),
        (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ (AlgebraicGeometry.Spec.map φ).appTop =
          φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso S).inv := by
      intro R S φ
      rw [← cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso S).hom, Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc, Category.assoc,
        Iso.inv_hom_id, Category.comp_id]
    have specHom_toSpecΓ_SpecMap : ∀ {X : AlgebraicGeometry.Scheme} {R : CommRingCat}
        (φ : R ⟶ X.presheaf.obj (Opposite.op ⊤)),
        (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫
          (X.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ).appTop = φ := by
      intro X R φ
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc, specHom_SpecMap,
        Category.assoc, AlgebraicGeometry.Scheme.toSpecΓ_appTop, Iso.inv_hom_id, Category.comp_id]
    have hΦ_hom : Φ ≫ (weilProjectiveSpaceOver k N).hom = U₀.ι ≫ Y.hom := by
      have hAwayZero : ι_away i₀ ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X i₀)))) :=
        AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X i₀) (hX i₀) zero_lt_one
      let ψ_k : CommRingCat.of k ⟶ (U₀ : AlgebraicGeometry.Scheme).presheaf.obj (Opposite.op ⊤) :=
        CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X i₀))) ≫
          CommRingCat.ofHom φ₀
      have hCompP : Φ ≫ (weilProjectiveSpaceOver k N).hom =
          (U₀ : AlgebraicGeometry.Scheme).toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_k := by
        change (((U₀ : AlgebraicGeometry.Scheme).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) ≫ ι_away i₀) ≫
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _
        rw [Category.assoc, Category.assoc, ← Category.assoc (ι_away i₀), hAwayZero]
        congr 1
        dsimp only [ψ_k]
        rw [AlgebraicGeometry.Spec.map_comp]
        erw [AlgebraicGeometry.Spec.map_comp]
        rw [Category.assoc]
      have hRingEq : ψ_k = κ₀_cat := by
        ext c
        change φ₀ (HomogeneousLocalization.fromZeroRingHom 𝒜
