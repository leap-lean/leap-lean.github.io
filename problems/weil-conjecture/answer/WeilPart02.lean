          obtain ⟨r, _, rfl⟩ := Multiset.mem_map.mp hf_mem
          simp only [map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at hf_zero
          exact ⟨r, hf_zero.symm⟩
      | add x₁ x₂ hx₁ hx₂ =>
        rw [map_add]
        exact add_mem hx₁ hx₂
    let k_D : ℕ := Nat.card J
    let equivJ : J ≃ Fin k_D := Finite.equivFin J
    let e_FL : ∀ j : J, F_j j ≃ₐ[L] L := fun j =>
