      have hv_fin : v ∈ hSingFin.toFinset := hSingFin.mem_toFinset.mpr ⟨hv_y, h_not_sm⟩
      have hv_bo : v ∈ (TopologicalSpace.Opens.map ι₁.left.base).obj
