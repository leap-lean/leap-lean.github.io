    have hEt_A₀ : ∀ ℓ : Fin s, @Algebra.Etale K₀ (A₀ ℓ) _ _ (instAlgK₀A ℓ) := by
      intro ℓ
      let _ : Algebra K₀ (A₀ ℓ) := instAlgK₀A ℓ
      rw [← RingHom.etale_algebraMap]
      have _ : AlgebraicGeometry.Etale (snd₀ ℓ) := hEt_snd₀ ℓ
      have hEt_comp : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (φ_K₀A ℓ)) := by
        rw [hSpec_φ ℓ]
        infer_instance
      exact (@AlgebraicGeometry.HasRingHomProperty.Spec_iff @AlgebraicGeometry.Etale _ _ _ _
