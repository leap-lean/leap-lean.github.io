    choose α₀_z V₁_z hAffV₁_z hzV₁_z hV₁U_z hV₁α_z s₁_z φ₁_z q₁_z f_lift₁_z x_coord_z P_h_z
      hProps_z using hPtChart
    have hCompK : IsCompact K := TopologicalSpace.NoetherianSpace.isCompact K
    obtain ⟨t, ht_cov⟩ :=
      hCompK.elim_finite_subcover (fun z : ↥K => (V₁_z z : Set X.left))
        (fun z => (V₁_z z).isOpen)
        (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hzV₁_z ⟨x, hx⟩⟩)
    let m_charts : ℕ := t.card
    let e_t : Fin m_charts ≃ ↥t := t.equivFin.symm
    refine ⟨m_charts,
      fun i => α₀_z (e_t i).1,
      fun i => V₁_z (e_t i).1,
      fun i => hAffV₁_z (e_t i).1,
      fun i => hV₁U_z (e_t i).1,
      fun i => hV₁α_z (e_t i).1,
      fun i => s₁_z (e_t i).1,
      fun i => φ₁_z (e_t i).1,
      fun i => q₁_z (e_t i).1,
