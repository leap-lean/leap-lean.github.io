              exact hm₁
            · rw [CategoryTheory.Limits.pullback.lift_snd, ← hΦ_snd,
                ← CategoryTheory.Category.assoc, hm₂])⟩⟩
    have : AlgebraicGeometry.IsClosedImmersion Φ_s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Φ hClX₂
    have : AlgebraicGeometry.Surjective Φ_s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Φ hSurjX₂
    let e_s : ↥(CategoryTheory.Limits.pullback f₂.left s) ≃ₜ
        ↥(CategoryTheory.Limits.pullback f₁.left s₀) :=
      Φ_s.isClosedEmbedding.isEmbedding.toHomeomorphOfSurjective Φ_s.surjective
    have he_s_apply : ∀ q : ↥(CategoryTheory.Limits.pullback f₂.left s),
        e_s q = Φ_s.base q := fun _ => rfl
    have hE' : e_s '' E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback f₁.left s₀) := by
      refine image_mem_irreducibleComponents_of_isPreirreducible_fiber
        e_s e_s.continuous e_s.isOpenMap (fun y => ?_) e_s.surjective hE
      have hsub : Set.Subsingleton (e_s ⁻¹' {y}) := by
        intro u hu v hv
        exact e_s.injective (hu.trans hv.symm)
      exact hsub.isPreirreducible
    let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_f)) := default
    have hmem_univ : s₀.base pt_K ∈ (⋃ a : Fin r, (W a : Set B₀.left)) := by
      rw [hCovW]
      trivial
    rw [Set.mem_iUnion] at hmem_univ
    obtain ⟨a, ha⟩ := hmem_univ
    have hs₀_range : Set.range s₀.base ⊆ (W a : Set B₀.left) := by
      rintro _ ⟨z, rfl⟩
      have hz : z = pt_K := Subsingleton.elim z pt_K
      rwa [hz]
    obtain ⟨q₁, q₂, q₃, W₁, W₂, W₃, hq₁₂, hq₁₃, hq₂₃, hq₁E', hq₂E', hq₃E',
        hq₁H, hq₂H, hq₃H, hq₁W₁, hSmW₁, hq₂W₂, hSmW₂, hq₃W₃, hSmW₃⟩ :=
      hSec a K_f s₀ hs₀_range (e_s '' E) hE'
    let q₁' := e_s.symm q₁
    let q₂' := e_s.symm q₂
    let q₃' := e_s.symm q₃
    let W₁' : X₂.left.Opens := (TopologicalSpace.Opens.map φ₂.left.base).obj W₁
    let W₂' : X₂.left.Opens := (TopologicalSpace.Opens.map φ₂.left.base).obj W₂
    let W₃' : X₂.left.Opens := (TopologicalSpace.Opens.map φ₂.left.base).obj W₃
    have hproj_φ : ∀ q : ↥(CategoryTheory.Limits.pullback f₁.left s₀),
        φ₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base (e_s.symm q)) =
          (CategoryTheory.Limits.pullback.fst f₁.left s₀).base q := by
      intro q
      calc
        φ₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base (e_s.symm q))
          = (CategoryTheory.Limits.pullback.fst f₂.left s ≫ φ₂.left).base (e_s.symm q) := rfl
        _ = (Φ_s ≫ CategoryTheory.Limits.pullback.fst f₁.left s₀).base (e_s.symm q) := by
            rw [hΦ_fst]
        _ = (CategoryTheory.Limits.pullback.fst f₁.left s₀).base (Φ_s.base (e_s.symm q)) := rfl
        _ = (CategoryTheory.Limits.pullback.fst f₁.left s₀).base (e_s (e_s.symm q)) := rfl
        _ = (CategoryTheory.Limits.pullback.fst f₁.left s₀).base q := by
            rw [e_s.apply_symm_apply]
    have hproj_f₂ : ∀ q' : ↥(CategoryTheory.Limits.pullback f₂.left s),
        f₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base q') ∈
          ψ₀.left.base ⁻¹' (W a : Set B₀.left) := by
      intro q'
      change ψ₀.left.base (f₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base q')) ∈
        (W a : Set B₀.left)
      have h1 : ψ₀.left.base
          (f₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base q')) =
          s₀.base ((CategoryTheory.Limits.pullback.snd f₂.left s).base q') := by
        change ((CategoryTheory.Limits.pullback.fst f₂.left s ≫ f₂.left) ≫ ψ₀.left).base q' =
          (CategoryTheory.Limits.pullback.snd f₂.left s ≫ s₀).base q'
        rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
      rw [h1, Subsingleton.elim ((CategoryTheory.Limits.pullback.snd f₂.left s).base q') pt_K]
      exact ha
    have hmemE : ∀ {q : ↥(CategoryTheory.Limits.pullback f₁.left s₀)},
        q ∈ e_s '' E → e_s.symm q ∈ E := by
      rintro q ⟨w, hwE, rfl⟩
      simpa using hwE
    obtain ⟨j₁, hj₁⟩ := hCapH a ((CategoryTheory.Limits.pullback.fst f₂.left s).base q₁')
      (hproj_f₂ q₁') (by rw [hproj_φ q₁]; exact hq₁H)
    obtain ⟨j₂, hj₂⟩ := hCapH a ((CategoryTheory.Limits.pullback.fst f₂.left s).base q₂')
      (hproj_f₂ q₂') (by rw [hproj_φ q₂]; exact hq₂H)
    obtain ⟨j₃, hj₃⟩ := hCapH a ((CategoryTheory.Limits.pullback.fst f₂.left s).base q₃')
      (hproj_f₂ q₃') (by rw [hproj_φ q₃]; exact hq₃H)
    refine ⟨j₁, j₂, j₃, q₁', q₂', q₃', W₁', W₂', W₃',
      fun h => hq₁₂ (e_s.symm.injective h),
      fun h => hq₁₃ (e_s.symm.injective h),
      fun h => hq₂₃ (e_s.symm.injective h),
      hmemE hq₁E', hmemE hq₂E', hmemE hq₃E',
      hj₁, hj₂, hj₃,
      ?_, hSmPull W₁ hSmW₁,
      ?_, hSmPull W₂ hSmW₂,
      ?_, hSmPull W₃ hSmW₃⟩
    · change φ₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base q₁') ∈ W₁
      rw [hproj_φ q₁]
      exact hq₁W₁
    · change φ₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base q₂') ∈ W₂
      rw [hproj_φ q₂]
      exact hq₂W₂
    · change φ₂.left.base ((CategoryTheory.Limits.pullback.fst f₂.left s).base q₃') ∈ W₃
      rw [hproj_φ q₃]
      exact hq₃W₃
  have h3 : 3 ≤ n := by
    obtain ⟨⟨b₂, _⟩⟩ := hU₁
    let K₀ : Type u := AlgebraicClosure ↥(B₂.left.residueField b₂)
    let s_b : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ B₂.left :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥(B₂.left.residueField b₂) K₀)) ≫
        B₂.left.fromSpecResidueField b₂
    have hConn := (hFib₂_U₀.2.2.2 K₀ s_b).1
    obtain ⟨z₀⟩ := hConn.toNonempty
    obtain ⟨j₁, j₂, j₃, q₁', q₂', q₃', _, _, _,
        hq₁₂, hq₁₃, hq₂₃, _, _, _, hq₁σ, hq₂σ, hq₃σ, _⟩ :=
      hSec₂ K₀ s_b (irreducibleComponent z₀) (irreducibleComponent_mem_irreducibleComponents z₀)
    have hSub_j : ∀ (j : Fin n)
        (u v : ↥(CategoryTheory.Limits.pullback f₂.left s_b)),
        (CategoryTheory.Limits.pullback.fst f₂.left s_b).base u ∈ Set.range (σ j).left.base →
        (CategoryTheory.Limits.pullback.fst f₂.left s_b).base v ∈ Set.range (σ j).left.base →
        u = v := by
      intro j u v hu hv
      let S₀ := AlgebraicGeometry.Spec (CommRingCat.of K₀)
      let σ_s : S₀ ⟶ CategoryTheory.Limits.pullback f₂.left s_b :=
        CategoryTheory.Limits.pullback.lift (s_b ≫ (σ j).left) (𝟙 S₀)
          (by rw [CategoryTheory.Category.assoc, hσ_left_sec j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have hσs_fst : σ_s ≫ CategoryTheory.Limits.pullback.fst f₂.left s_b = s_b ≫ (σ j).left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hσs_snd : σ_s ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b = 𝟙 S₀ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hc_eq : ∀ c : CategoryTheory.Limits.PullbackCone (σ j).left
          (CategoryTheory.Limits.pullback.fst f₂.left s_b),
          (c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b) ≫ s_b = c.fst := by
        intro c
        calc
          (c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b) ≫ s_b
            = c.snd ≫ (CategoryTheory.Limits.pullback.snd f₂.left s_b ≫ s_b) :=
                CategoryTheory.Category.assoc _ _ _
          _ = c.snd ≫ (CategoryTheory.Limits.pullback.fst f₂.left s_b ≫ f₂.left) := by
                rw [CategoryTheory.Limits.pullback.condition]
          _ = (c.snd ≫ CategoryTheory.Limits.pullback.fst f₂.left s_b) ≫ f₂.left :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = (c.fst ≫ (σ j).left) ≫ f₂.left := by rw [← c.condition]
          _ = c.fst ≫ ((σ j).left ≫ f₂.left) := CategoryTheory.Category.assoc _ _ _
          _ = c.fst := by rw [hσ_left_sec j, CategoryTheory.Category.comp_id]
      have hPb_σ : CategoryTheory.IsPullback s_b σ_s
          (σ j).left (CategoryTheory.Limits.pullback.fst f₂.left s_b) := by
        refine ⟨⟨hσs_fst.symm⟩, ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
          (fun c => c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b)
          (fun c => hc_eq c)
          (fun c => by
            apply CategoryTheory.Limits.pullback.hom_ext
            · calc
                ((c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b) ≫ σ_s) ≫
                    CategoryTheory.Limits.pullback.fst f₂.left s_b
                  = (c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b) ≫
                      (σ_s ≫ CategoryTheory.Limits.pullback.fst f₂.left s_b) :=
                      CategoryTheory.Category.assoc _ _ _
                _ = (c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b) ≫
                      (s_b ≫ (σ j).left) := by rw [hσs_fst]
                _ = ((c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b) ≫ s_b) ≫
                      (σ j).left := (CategoryTheory.Category.assoc _ _ _).symm
                _ = c.fst ≫ (σ j).left := by rw [hc_eq c]
                _ = c.snd ≫ CategoryTheory.Limits.pullback.fst f₂.left s_b := c.condition
            · rw [CategoryTheory.Category.assoc, hσs_snd, CategoryTheory.Category.comp_id])
          (fun c m _ hm₂ => by
            calc
              m = m ≫ 𝟙 S₀ := (CategoryTheory.Category.comp_id m).symm
              _ = m ≫ (σ_s ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b) := by rw [hσs_snd]
              _ = (m ≫ σ_s) ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b :=
                    (CategoryTheory.Category.assoc _ _ _).symm
              _ = c.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left s_b := by rw [hm₂])⟩⟩
      have hu_snd : u ∈ Set.range (CategoryTheory.Limits.pullback.snd (σ j).left
          (CategoryTheory.Limits.pullback.fst f₂.left s_b)).base := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_snd]
        exact hu
      have hv_snd : v ∈ Set.range (CategoryTheory.Limits.pullback.snd (σ j).left
          (CategoryTheory.Limits.pullback.fst f₂.left s_b)).base := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_snd]
        exact hv
      obtain ⟨wu, hwu⟩ := hu_snd
      obtain ⟨wv, hwv⟩ := hv_snd
      let zu : ↥S₀ := hPb_σ.isoPullback.inv.base wu
      let zv : ↥S₀ := hPb_σ.isoPullback.inv.base wv
      have hzu : σ_s.base zu = u := by
        change (hPb_σ.isoPullback.inv ≫ σ_s).base wu = u
        rw [hPb_σ.isoPullback_inv_snd]
        exact hwu
      have hzv : σ_s.base zv = v := by
        change (hPb_σ.isoPullback.inv ≫ σ_s).base wv = v
        rw [hPb_σ.isoPullback_inv_snd]
        exact hwv
      rw [← hzu, ← hzv, Subsingleton.elim zu zv]
    have hj₁₂ : j₁ ≠ j₂ := fun h => hq₁₂ (hSub_j j₁ q₁' q₂' hq₁σ (h ▸ hq₂σ))
    have hj₁₃ : j₁ ≠ j₃ := fun h => hq₁₃ (hSub_j j₁ q₁' q₃' hq₁σ (h ▸ hq₃σ))
    have hj₂₃ : j₂ ≠ j₃ := fun h => hq₂₃ (hSub_j j₂ q₂' q₃' hq₂σ (h ▸ hq₃σ))
    let S₃ : Finset (Fin n) := {j₁, j₂, j₃}
    have hcard : S₃.card = 3 := by
      simp [S₃, hj₁₂, hj₁₃, hj₂₃]
    have hle : S₃.card ≤ (Finset.univ : Finset (Fin n)).card := Finset.card_le_univ S₃
    simpa [hcard] using hle
  
  refine ⟨U₂, n, σ, hU₂, ⟨h3, hFib₂_U₂, hσ_sec, hDisj, hSec₂⟩, ?_⟩
  intro x hx
  by_cases hxU₂ : f₂.left.base x ∈ (U₂ : Set B₂.left)
  · have hxU₁ : f₂.left.base x ∈ ψ₀.left.base ⁻¹' (U₀ : Set B₀.left) := hU₂_le hxU₂
    have hfxU₀ : f₁.left.base (φ₂.left.base x) ∈ (U₀ : Set B₀.left) := by
      have h1 : f₁.left.base (φ₂.left.base x) = ψ₀.left.base (f₂.left.base x) := by
        change (φ₂.left ≫ f₁.left).base x = (f₂.left ≫ ψ₀.left).base x
        rw [hφf]
      rw [h1]
      exact hxU₁
    rcases hx with hx_compl | hx_Z₁
    · exact False.elim (hx_compl hfxU₀)
    · obtain ⟨j, hj⟩ := hCapZ x hxU₁ hx_Z₁
      exact Or.inr (Set.mem_iUnion.mpr ⟨j, hj⟩)
  · exact Or.inl hxU₂

theorem weil_gen_finite_etale_alteration_comp (k : Type u) [Field k]
    {X₁ X₂ X₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (α : X₃ ⟶ X₂) (γ : X₂ ⟶ X₁)
    (hInt₂ : AlgebraicGeometry.IsIntegral X₂.left)
    (hα : IsGenFiniteEtaleAlterationOver k α)
    (hγ : IsGenFiniteEtaleAlterationOver k γ) :
    IsGenFiniteEtaleAlterationOver k (α ≫ γ) :=
by
  
  have hPullbackRestrict : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      {W U : Y.Opens} (hWU : W ≤ U),
      CategoryTheory.IsPullback
        (X.homOfLE ((TopologicalSpace.Opens.map f.base).monotone hWU))
        (f ∣_ W) (f ∣_ U) (Y.homOfLE hWU) := by
    intro X Y f W U hWU
    have hWU' : f ⁻¹ᵁ W ≤ f ⁻¹ᵁ U := (TopologicalSpace.Opens.map f.base).monotone hWU
    have hOuter := (AlgebraicGeometry.isPullback_morphismRestrict f W).flip
    have hRight := (AlgebraicGeometry.isPullback_morphismRestrict f U).flip
    rw [← X.homOfLE_ι hWU', ← Y.homOfLE_ι hWU] at hOuter
    have hComm : X.homOfLE hWU' ≫ (f ∣_ U) = (f ∣_ W) ≫ Y.homOfLE hWU := by
      have hMono : CategoryTheory.Mono U.ι := AlgebraicGeometry.IsOpenImmersion.mono U.ι
      revert hMono; intro hMono
      rw [← cancel_mono U.ι]
      calc
        (X.homOfLE hWU' ≫ (f ∣_ U)) ≫ U.ι
            = X.homOfLE hWU' ≫ ((f ∣_ U) ≫ U.ι) := CategoryTheory.Category.assoc _ _ _
        _ = X.homOfLE hWU' ≫ ((f ⁻¹ᵁ U).ι ≫ f) := by rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (X.homOfLE hWU' ≫ (f ⁻¹ᵁ U).ι) ≫ f := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (f ⁻¹ᵁ W).ι ≫ f := by rw [X.homOfLE_ι hWU']
        _ = (f ∣_ W) ≫ W.ι := (AlgebraicGeometry.morphismRestrict_ι f W).symm
        _ = (f ∣_ W) ≫ (Y.homOfLE hWU ≫ U.ι) := by rw [Y.homOfLE_ι hWU]
        _ = ((f ∣_ W) ≫ Y.homOfLE hWU) ≫ U.ι := (CategoryTheory.Category.assoc _ _ _).symm
    exact CategoryTheory.IsPullback.of_right hOuter hComm hRight

  
  have hBotFiber : ∀ {V₁ V₂ : AlgebraicGeometry.Scheme.{u}} (g : V₂ ⟶ V₁)
      [AlgebraicGeometry.IsAffine V₁] [AlgebraicGeometry.IsAffine V₂]
      [AlgebraicGeometry.IsIntegral V₂] [AlgebraicGeometry.IsIntegralHom g],
      ∃ z₀ : V₂, (∀ w : V₂, z₀ ⤳ w) ∧ (∀ x : V₂, g.base x = g.base z₀ → x = z₀) := by
    intro V₁ V₂ g _ _ _ _
    let A₁ := V₁.presheaf.obj (Opposite.op ⊤)
    let A₂ := V₂.presheaf.obj (Opposite.op ⊤)
    obtain ⟨v₂⟩ : Nonempty ↥V₂ := inferInstance
    have hTopNonempty : Nonempty (⊤ : V₂.Opens) := ⟨⟨v₂, trivial⟩⟩
    have hDomA₂ : IsDomain ↑A₂ :=
      @AlgebraicGeometry.IsIntegral.component_integral V₂ _ ⊤ hTopNonempty
    revert hTopNonempty hDomA₂
    intro hTopNonempty hDomA₂
    let z₀ : V₂ := V₂.isoSpec.inv.base (⊥ : PrimeSpectrum ↑A₂)
    refine ⟨z₀, ?_, ?_⟩
    · intro w
      have hspec : (⊥ : PrimeSpectrum ↑A₂) ⤳ V₂.isoSpec.hom.base w :=
        (PrimeSpectrum.le_iff_specializes ⊥ (V₂.isoSpec.hom.base w)).mp bot_le
      have hmap : z₀ ⤳ V₂.isoSpec.inv.base (V₂.isoSpec.hom.base w) :=
        hspec.map V₂.isoSpec.inv.continuous
      have hinv : V₂.isoSpec.inv.base (V₂.isoSpec.hom.base w) = w := by
        change (V₂.isoSpec.hom ≫ V₂.isoSpec.inv).base w = w
        rw [V₂.isoSpec.hom_inv_id]
        rfl
      rwa [hinv] at hmap
    · intro x hx
      have hz₀_hom : V₂.isoSpec.hom.base z₀ = (⊥ : PrimeSpectrum ↑A₂) := by
        change (V₂.isoSpec.inv ≫ V₂.isoSpec.hom).base (⊥ : PrimeSpectrum ↑A₂) =
          (⊥ : PrimeSpectrum ↑A₂)
        rw [V₂.isoSpec.inv_hom_id]
        rfl
      let q : PrimeSpectrum ↑A₂ := V₂.isoSpec.hom.base x
      have hmap_eq :
          (AlgebraicGeometry.Spec.map g.appTop).base q =
            (AlgebraicGeometry.Spec.map g.appTop).base (⊥ : PrimeSpectrum ↑A₂) := by
        have h1 : (V₂.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g.appTop).base x =
            (V₂.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g.appTop).base z₀ := by
          rw [AlgebraicGeometry.Scheme.isoSpec_hom V₂,
            ← AlgebraicGeometry.Scheme.toSpecΓ_naturality g]
          exact congrArg V₁.toSpecΓ.base hx
        have h2 : (V₂.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g.appTop).base z₀ =
            (AlgebraicGeometry.Spec.map g.appTop).base (⊥ : PrimeSpectrum ↑A₂) := by
          change (AlgebraicGeometry.Spec.map g.appTop).base (V₂.isoSpec.hom.base z₀) = _
          exact congrArg (AlgebraicGeometry.Spec.map g.appTop).base hz₀_hom
        exact h1.trans h2
      have hcomap_spec : PrimeSpectrum.comap g.appTop.hom q =
          PrimeSpectrum.comap g.appTop.hom (⊥ : PrimeSpectrum ↑A₂) :=
        ((AlgebraicGeometry.Spec.map_apply g.appTop q).symm.trans hmap_eq).trans
          (AlgebraicGeometry.Spec.map_apply g.appTop (⊥ : PrimeSpectrum ↑A₂))
      have hcomap : Ideal.comap g.appTop.hom q.asIdeal =
          Ideal.comap g.appTop.hom (⊥ : Ideal ↑A₂) := by
        simpa only [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.asIdeal_bot] using
          congrArg PrimeSpectrum.asIdeal hcomap_spec
      have hIntφ : g.appTop.hom.IsIntegral :=
        AlgebraicGeometry.IsIntegralHom.isIntegral_app g ⊤ (AlgebraicGeometry.isAffineOpen_top V₁)
      let _ : Algebra ↑A₁ ↑A₂ := g.appTop.hom.toAlgebra
      have hq_bot : q.asIdeal = ⊥ := by
        refine le_antisymm ?_ bot_le
        intro s hs
        by_contra hs_ne
        have hlt : Ideal.under ↑A₁ (⊥ : Ideal ↑A₂) <
            Ideal.under ↑A₁ q.asIdeal :=
          @Ideal.under_lt_under_of_integral_mem_sdiff ↑A₁ _ ↑A₂ _
            (⊥ : Ideal ↑A₂) q.asIdeal _
            Ideal.isPrime_bot bot_le s ⟨hs, hs_ne⟩ (hIntφ s)
        change Ideal.comap g.appTop.hom (⊥ : Ideal ↑A₂) <
          Ideal.comap g.appTop.hom q.asIdeal at hlt
        rw [hcomap] at hlt
        exact lt_irrefl _ hlt
      have hq_eq : V₂.isoSpec.hom.base x = (⊥ : PrimeSpectrum ↑A₂) :=
        PrimeSpectrum.ext hq_bot
      have hx_inv := congrArg V₂.isoSpec.inv.base hq_eq
      have hinvx : V₂.isoSpec.inv.base (V₂.isoSpec.hom.base x) = x := by
        change (V₂.isoSpec.hom ≫ V₂.isoSpec.inv).base x = x
        rw [V₂.isoSpec.hom_inv_id]
        rfl
      rwa [hinvx] at hx_inv

  
  have hShrinkOpen : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (f : Y₂ ⟶ Y₁)
      [AlgebraicGeometry.UniversallyClosed f]
      (U₁ : Y₁.Opens) (U₂ : Y₂.Opens) (z₂ : Y₂)
      (hz₁ : f.base z₂ ∈ U₁)
      (hfiber : ∀ x₂ : Y₂, f.base x₂ = f.base z₂ → x₂ ∈ U₂),
      ∃ U : Y₁.Opens,
        Nonempty U ∧ U ≤ U₁ ∧ f ⁻¹ᵁ U ≤ U₂ := by
    intro Y₁ Y₂ f _ U₁ U₂ z₂ hz₁ hfiber
    let W₁ : Y₁.Opens :=
      ⟨(f.base '' (U₂ : Set Y₂)ᶜ)ᶜ, (f.isClosedMap _ U₂.isOpen.isClosed_compl).isOpen_compl⟩
    let U : Y₁.Opens := U₁ ⊓ W₁
    refine ⟨U, ?_, inf_le_left, ?_⟩
    · refine ⟨⟨f.base z₂, hz₁, ?_⟩⟩
      rintro ⟨x₂, hx₂_not, hx₂_eq⟩
      exact hx₂_not (hfiber x₂ hx₂_eq)
    · intro x₂ hx₂
      by_contra hnot
      exact hx₂.2 ⟨x₂, hnot, rfl⟩

  
  rcases hα with ⟨hPropα, hSurjα, U₂, hU₂, hFinα, hEtα, hSurjαU⟩
  rcases hγ with ⟨hPropγ, hSurjγ, U₁, hU₁, hFinγ, hEtγ, hSurjγU⟩
  obtain ⟨⟨y₁, hy₁⟩⟩ := hU₁
  obtain ⟨V₁, hAffV₁, hy₁V₁, hV₁U₁⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy₁
  let V₂ : X₂.left.Opens := γ.left ⁻¹ᵁ V₁
  have hFinγV₁ : AlgebraicGeometry.IsFinite (γ.left ∣_ V₁) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsFinite) (hPullbackRestrict γ.left hV₁U₁) hFinγ
  have hAffV₁' : AlgebraicGeometry.IsAffine ↑V₁ := hAffV₁
  obtain ⟨y₂, hy₂⟩ := AlgebraicGeometry.Scheme.Hom.surjective γ.left y₁
  have hy₂V₂ : y₂ ∈ V₂ := by
    show γ.left.base y₂ ∈ V₁
    rwa [hy₂]
  have hV₂Nonempty : Nonempty ↥V₂.toScheme := ⟨⟨y₂, hy₂V₂⟩⟩
  revert hFinγV₁ hAffV₁' hV₂Nonempty
  intro hFinγV₁ hAffV₁' hV₂Nonempty
  have hIntHomV₁ : AlgebraicGeometry.IsIntegralHom (γ.left ∣_ V₁) := inferInstance
  have hAffHomV₁ : AlgebraicGeometry.IsAffineHom (γ.left ∣_ V₁) := inferInstance
  have hAffV₂ : AlgebraicGeometry.IsAffine ↑V₂ :=
    @AlgebraicGeometry.isAffine_of_isAffineHom _ _ (γ.left ∣_ V₁) hAffHomV₁ hAffV₁'
  have hIntV₂ : AlgebraicGeometry.IsIntegral ↑V₂ :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion V₂.ι
  revert hIntHomV₁ hAffV₂ hIntV₂
  intro hIntHomV₁ hAffV₂ hIntV₂
  obtain ⟨z₀, hz₀_spec, hz₀_uniq⟩ := hBotFiber (γ.left ∣_ V₁)
  let z₂ : X₂.left := z₀.1
  have hz₂V₁ : γ.left.base z₂ ∈ V₁ := z₀.2
  have hz₁ : γ.left.base z₂ ∈ U₁ := hV₁U₁ hz₂V₁
  have hz₂U₂ : z₂ ∈ U₂ := by
    have hIrredX₂ : IrreducibleSpace ↥X₂.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral X₂.left
    revert hIrredX₂; intro hIrredX₂
    obtain ⟨⟨u₂, hu₂⟩⟩ := hU₂
    obtain ⟨w₂, hw₂V₂, hw₂U₂⟩ :=
      nonempty_preirreducible_inter V₂.isOpen U₂.isOpen ⟨y₂, hy₂V₂⟩ ⟨u₂, hu₂⟩
    have hspecV₂ : z₀ ⤳ (⟨w₂, hw₂V₂⟩ : ↥V₂.toScheme) := hz₀_spec ⟨w₂, hw₂V₂⟩
    have hspecX₂ : V₂.ι.base z₀ ⤳ V₂.ι.base ⟨w₂, hw₂V₂⟩ :=
      hspecV₂.map V₂.ι.continuous
    simp only [AlgebraicGeometry.Scheme.Opens.ι_apply] at hspecX₂
    exact hspecX₂.mem_open U₂.isOpen hw₂U₂
  have hfiber : ∀ x₂ : X₂.left, γ.left.base x₂ = γ.left.base z₂ → x₂ ∈ U₂ := by
    intro x₂ hx₂
    have hx₂V₂ : x₂ ∈ V₂ := by
      show γ.left.base x₂ ∈ V₁
      rwa [hx₂]
    let x' : ↥V₂.toScheme := ⟨x₂, hx₂V₂⟩
    have hgx' : (γ.left ∣_ V₁).base x' = (γ.left ∣_ V₁).base z₀ := by
      apply Subtype.ext
      exact (AlgebraicGeometry.morphismRestrict_base_coe γ.left V₁ x').trans
        (hx₂.trans (AlgebraicGeometry.morphismRestrict_base_coe γ.left V₁ z₀).symm)
    have hx'_eq : x' = z₀ := hz₀_uniq x' hgx'
    have hx₂_eq : x₂ = z₂ := congrArg Subtype.val hx'_eq
    rwa [hx₂_eq]
  obtain ⟨U, hU, hUU₁, hγUU₂⟩ := hShrinkOpen γ.left U₁ U₂ z₂ hz₁ hfiber

  
  have pbγ := hPullbackRestrict γ.left hUU₁
  have pbα := hPullbackRestrict α.left hγUU₂
  have hFinγU : AlgebraicGeometry.IsFinite (γ.left ∣_ U) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsFinite) pbγ hFinγ
  have hEtγU : AlgebraicGeometry.Etale (γ.left ∣_ U) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Etale) pbγ hEtγ
  have hSurjγU' : AlgebraicGeometry.Surjective (γ.left ∣_ U) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Surjective) pbγ hSurjγU
  have hFinαU : AlgebraicGeometry.IsFinite (α.left ∣_ (γ.left ⁻¹ᵁ U)) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsFinite) pbα hFinα
  have hEtαU : AlgebraicGeometry.Etale (α.left ∣_ (γ.left ⁻¹ᵁ U)) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Etale) pbα hEtα
  have hSurjαU' : AlgebraicGeometry.Surjective (α.left ∣_ (γ.left ⁻¹ᵁ U)) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Surjective) pbα hSurjαU
  have hCompFin : ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
      [AlgebraicGeometry.IsFinite f] [AlgebraicGeometry.IsFinite g],
      AlgebraicGeometry.IsFinite (f ≫ g) := fun _ _ => inferInstance
  have hCompEt : ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
      [AlgebraicGeometry.Etale f] [AlgebraicGeometry.Etale g],
      AlgebraicGeometry.Etale (f ≫ g) := fun _ _ => inferInstance
  have hCompSurj : ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
      [AlgebraicGeometry.Surjective f] [AlgebraicGeometry.Surjective g],
      AlgebraicGeometry.Surjective (f ≫ g) := fun _ _ => inferInstance
  refine ⟨?_, ?_, U, hU, ?_, ?_, ?_⟩
  · change AlgebraicGeometry.IsProper (α.left ≫ γ.left)
    infer_instance
  · change AlgebraicGeometry.Surjective (α.left ≫ γ.left)
    infer_instance
  · change AlgebraicGeometry.IsFinite ((α.left ≫ γ.left) ∣_ U)
    rw [AlgebraicGeometry.morphismRestrict_comp]
    exact @hCompFin _ _ _ _ _ hFinαU hFinγU
  · change AlgebraicGeometry.Etale ((α.left ≫ γ.left) ∣_ U)
    rw [AlgebraicGeometry.morphismRestrict_comp]
    exact @hCompEt _ _ _ _ _ hEtαU hEtγU
  · change AlgebraicGeometry.Surjective ((α.left ≫ γ.left) ∣_ U)
    rw [AlgebraicGeometry.morphismRestrict_comp]
    exact @hCompSurj _ _ _ _ _ hSurjαU' hSurjγU'

theorem weil_algClosed_bertini_multisection_galois_split (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV : AlgebraicGeometry.IsIntegral V.left)
    (U_V : V.left.Opens)
    (B₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : B₀.left.Opens)
    (hIntB₀ : AlgebraicGeometry.IsIntegral B₀.left)
    (hProjB₀ : IsProjectiveOverField k B₀)
    (hDimB₀ : topologicalKrullDim B₀.left = (m : WithBot ℕ∞))
    (hU₀ : Nonempty U₀)
    (V₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntV₁ : AlgebraicGeometry.IsIntegral V₁.left)
    (hProjV₁ : IsProjectiveOverField k V₁)
    (hDimV₁ : topologicalKrullDim V₁.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (f₁ : V₁ ⟶ B₀)
    (hFib₁ : IsEquidimGenSmoothCurveFibOver k f₁ U₀)
    (Z₁ : AlgebraicGeometry.Scheme.{u})
    (ιZ₁ : Z₁ ⟶ V₁.left)
    (hClZ₁ : AlgebraicGeometry.IsClosedImmersion ιZ₁)
    (hRedZ₁ : AlgebraicGeometry.IsReduced Z₁)
    (hFinZ₁ : AlgebraicGeometry.IsFinite (ιZ₁ ≫ f₁.left))
    (hEtZ₁ : AlgebraicGeometry.Etale ((ιZ₁ ≫ f₁.left) ∣_ U₀))
    (α₁ : V₁ ⟶ V)
    (hα₁ : IsGenFiniteEtaleAlterationOver k α₁)
    (hBdry₁ : α₁.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
      f₁.left.base ⁻¹' ((U₀ : Set B₀.left)ᶜ) ∪ Set.range ιZ₁.base) :
    ∃ (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₂ : B₂.left.Opens)
      (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f₂ : X₂ ⟶ B₂)
      (n : ℕ)
      (σ : Fin n → (B₂ ⟶ X₂))
      (α₂ : X₂ ⟶ V),
      AlgebraicGeometry.IsIntegral B₂.left ∧
      IsProjectiveOverField k B₂ ∧
      topologicalKrullDim B₂.left = (m : WithBot ℕ∞) ∧
      Nonempty U₂ ∧
      AlgebraicGeometry.IsIntegral X₂.left ∧
      IsProjectiveOverField k X₂ ∧
      topologicalKrullDim X₂.left = ((m + 1 : ℕ) : WithBot ℕ∞) ∧
      IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ ∧
      IsGenFiniteEtaleAlterationOver k α₂ ∧
      α₂.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
        f₂.left.base ⁻¹' ((U₂ : Set B₂.left)ᶜ) ∪
          ⋃ j : Fin n, Set.range (σ j).left.base :=
by
  obtain ⟨r, W, H, ιH, hCovW, hW_ne, hClH, hFinH, hEtH, hSec⟩ :=
    weil_algClosed_bertini_three_secant_finite_cover k m
      B₀ U₀ hIntB₀ hProjB₀ hDimB₀ hU₀
      V₁ hIntV₁ hProjV₁ hDimV₁ f₁ hFib₁
  let D : Fin (r + 1) → AlgebraicGeometry.Scheme.{u} := Fin.cases Z₁ H
  let p : ∀ ℓ : Fin (r + 1), D ℓ ⟶ B₀.left :=
    Fin.cases (ιZ₁ ≫ f₁.left) (fun a => ιH a ≫ f₁.left)
  let W_D : Fin (r + 1) → B₀.left.Opens := Fin.cases U₀ W
  have hW_D : ∀ ℓ : Fin (r + 1), Nonempty (W_D ℓ) := Fin.cases hU₀ hW_ne
  have hFin_D : ∀ ℓ : Fin (r + 1), AlgebraicGeometry.IsFinite (p ℓ) :=
    Fin.cases hFinZ₁ hFinH
  have hEt_D : ∀ ℓ : Fin (r + 1), AlgebraicGeometry.Etale ((p ℓ) ∣_ (W_D ℓ)) :=
    Fin.cases hEtZ₁ hEtH
  obtain ⟨B₂, ψ₀, hIntB₂, hFinψ₀, hAltψ₀, hSplit⟩ :=
    weil_algClosed_galois_normalization_splits_finite_etale k B₀ hIntB₀ hProjB₀
      (r + 1) D p W_D hW_D hFin_D hEt_D
  obtain ⟨hProjB₂, hDimB₂_eq⟩ :=
    weil_isFinite_projective_and_krullDim_over_field k ψ₀
      hIntB₂ hIntB₀ hProjB₀ hFinψ₀ hAltψ₀.2.1
  have hDimB₂ : topologicalKrullDim B₂.left = (m : WithBot ℕ∞) :=
    hDimB₂_eq.trans hDimB₀
  obtain ⟨X₂, f₂, φ₂, ιX₂, hIntX₂, hClX₂, hSurjX₂, hf₂, hφ₂, _hcomm,
      hFinφ₂, hSurjφ₂, hAltφ₂, hFib₂_U₀, hSmPull⟩ :=
    weil_algClosed_strict_transform_curve_fib_pullback k B₀ U₀ hIntB₀ hU₀
      V₁ hIntV₁ hProjV₁ f₁ hFib₁
      B₂ ψ₀ hIntB₂ hProjB₂ hFinψ₀ hAltψ₀
  obtain ⟨hProjX₂, hDimX₂_eq⟩ :=
    weil_isFinite_projective_and_krullDim_over_field k φ₂
      hIntX₂ hIntV₁ hProjV₁ hFinφ₂ hSurjφ₂
  have hDimX₂ : topologicalKrullDim X₂.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
    hDimX₂_eq.trans hDimV₁
  obtain ⟨U₂, n, σ, hU₂, hFib₂, hBdry₂⟩ :=
    weil_algClosed_split_sections_three_secant_and_bdry k B₀ V₁ B₂ X₂ U₀ hU₀
      f₁ ψ₀ f₂ φ₂ ιX₂ hIntB₂ hClX₂ hSurjX₂ hf₂ hφ₂ hAltψ₀.2.1 hFib₂_U₀ hSmPull
      Z₁ ιZ₁ hClZ₁ r W H ιH hCovW hClH hSec
      (hSplit 0) (fun a => hSplit a.succ)
  let α₂ : X₂ ⟶ V := φ₂ ≫ α₁
  have hα₂ : IsGenFiniteEtaleAlterationOver k α₂ :=
    weil_gen_finite_etale_alteration_comp k φ₂ α₁ hIntV₁ hAltφ₂ hα₁
  refine ⟨B₂, U₂, X₂, f₂, n, σ, α₂,
    hIntB₂, hProjB₂, hDimB₂, hU₂, hIntX₂, hProjX₂, hDimX₂, hFib₂, hα₂, ?_⟩
  intro x hx
  have hx' : φ₂.left.base x ∈ α₁.left.base ⁻¹' ((U_V : Set V.left)ᶜ) := by
    simpa [α₂] using hx
  exact hBdry₂ (hBdry₁ hx')

theorem weil_integral_scheme_functionField_over_field (E : Type u) [Field E]
    (Y : AlgebraicGeometry.Scheme.{u})
    (hInt : AlgebraicGeometry.IsIntegral Y)
    (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of E)) :
    ∃ (F : Type u) (_ : Field F) (_ : Algebra E F)
      (η : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y),
      η ≫ p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E F)) ∧
      IsSchemeFunctionField Y F η ∧
      ∀ (U : Y.Opens), Nonempty U →
        ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)), η.base pt ∈ U :=
by
  have : AlgebraicGeometry.IsIntegral Y := hInt
  have : IrreducibleSpace ↥Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y
  have hGenMem : ∀ (U : Y.Opens), Nonempty ↥U → genericPoint ↥Y ∈ U := by
    intro U ⟨⟨u₀, hu₀⟩⟩
    exact ((genericPoint_spec ↥Y).mem_open_set_iff U.isOpen).mpr ⟨u₀, trivial, hu₀⟩
  let η : AlgebraicGeometry.Spec (CommRingCat.of ↑Y.functionField) ⟶ Y :=
    Y.fromSpecStalk (genericPoint ↥Y)
  let α : CommRingCat.of E ⟶ CommRingCat.of ↑Y.functionField :=
    AlgebraicGeometry.Spec.preimage (η ≫ p)
  let instAlgEF : Algebra E ↑Y.functionField := RingHom.toAlgebra α.hom
  refine ⟨↑Y.functionField, inferInstance, instAlgEF, η, ?_, ?_, ?_⟩
  · exact (AlgebraicGeometry.Spec.map_preimage (η ≫ p)).symm
  · intro U hU hUne
    have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hUne
    let φ : Y.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of ↑Y.functionField :=
      Y.germToFunctionField U
    refine ⟨φ, @AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y hInt U hU hUne, ?_⟩
    have hxU : genericPoint ↥Y ∈ U := hGenMem U hUne
    change AlgebraicGeometry.Spec.map (Y.presheaf.germ U (genericPoint ↥Y) hxU) ≫ hU.fromSpec =
      Y.fromSpecStalk (genericPoint ↥Y)
    rw [← U.fromSpecStalkOfMem_toSpecΓ_assoc (genericPoint ↥Y) hxU hU.fromSpec,
      hU.toSpecΓ_fromSpec, U.fromSpecStalkOfMem_ι]
  · intro U hUne pt
    have hpt : pt = IsLocalRing.closedPoint ↑(Y.presheaf.stalk (genericPoint ↥Y)) :=
      @Subsingleton.elim ↥(AlgebraicGeometry.Spec (CommRingCat.of ↑Y.functionField)) inferInstance
        pt (IsLocalRing.closedPoint ↑(Y.presheaf.stalk (genericPoint ↥Y)))
    rw [hpt]
    have hcl : η.base (IsLocalRing.closedPoint ↑(Y.presheaf.stalk (genericPoint ↥Y))) =
        genericPoint ↥Y :=
      @AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint Y (genericPoint ↥Y)
    rw [hcl]
    exact hGenMem U hUne

theorem weil_projective_integral_sepClosure_trdeg_le (k : Type u) [Field k] (m : ℕ)
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (hDimB₂ : topologicalKrullDim B₂.left = (m : WithBot ℕ∞))
    (K₀ : Type u) [Field K₀] [Algebra k K₀]
    (η₀ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ B₂.left)
    (hη₀_hom : η₀ ≫ B₂.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K₀)))
    (hFuncK₀ : IsSchemeFunctionField B₂.left K₀ η₀) :
    ∃ (K : Type u) (_ : Field K) (_ : IsSepClosed K)
      (_ : Algebra k K) (_ : Algebra K₀ K) (_ : IsScalarTower k K₀ K) (_ : IsSepClosure K₀ K),
      Algebra.trdeg k K ≤ (m : Cardinal.{u}) :=
by
  
  have : AlgebraicGeometry.LocallyOfFiniteType B₂.hom := by
    obtain ⟨N, ι, hClosed⟩ := hProjB₂
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz : z.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        simpa [𝒜, MvPolynomial.homogeneousSubmodule_zero] using z.2
      rw [Submodule.mem_one] at hz
      obtain ⟨c, hc⟩ := hz
      refine ⟨c, Subtype.ext ?_⟩
      rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul_of_tower]
      change c • (1 : MvPolynomial (Fin (N + 1)) k) = ↑z
      rw [← Algebra.algebraMap_eq_smul_one]
      exact hc
    have hFT0 : (CommRingCat.Hom.hom (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj0
    have h1 : AlgebraicGeometry.LocallyOfFiniteType ι.left := inferInstance
    have h2 : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    have h3 : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT0
    have h23 : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ h2 h3
    exact CategoryTheory.MorphismProperty.comp_mem _ _ _ h1 h23
  
  
  have : AlgebraicGeometry.IsIntegral B₂.left := hIntB₂
  have : IrreducibleSpace ↥B₂.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral B₂.left
  obtain ⟨x₀⟩ := IrreducibleSpace.toNonempty (X := ↥B₂.left)
  obtain ⟨U₀, hU₀, hx₀, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top x₀)
  have hU₀_ne : Nonempty ↥U₀ := ⟨⟨x₀, hx₀⟩⟩
  have : Nonempty ↥U₀.toScheme := hU₀_ne
  let R₀_cat : CommRingCat.{u} := B₂.left.presheaf.obj (Opposite.op U₀)
  let R₀ : Type u := ↑R₀_cat
  have : IsDomain R₀ := @AlgebraicGeometry.IsIntegral.component_integral B₂.left hIntB₂ U₀ hU₀_ne
  let g_spec : AlgebraicGeometry.Spec R₀_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    hU₀.fromSpec ≫ B₂.hom
  let α₀ : CommRingCat.of k ⟶ R₀_cat := AlgebraicGeometry.Spec.preimage g_spec
  have hSpec_α₀ : AlgebraicGeometry.Spec.map α₀ = g_spec :=
    AlgebraicGeometry.Spec.map_preimage g_spec
  have hLFT_α₀ : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map α₀) := by
    rw [hSpec_α₀]
    infer_instance
  have hFT_α₀ : (CommRingCat.Hom.hom α₀).FiniteType :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_α₀
  let : Algebra k R₀ := (CommRingCat.Hom.hom α₀).toAlgebra
  have : Algebra.FiniteType k R₀ := hFT_α₀
  obtain ⟨φ₀, hFrac₀, hSpec₀⟩ := hFuncK₀ U₀ hU₀ hU₀_ne
  let : Algebra R₀ K₀ := (CommRingCat.Hom.hom φ₀).toAlgebra
  have : IsFractionRing R₀ K₀ := hFrac₀
  have hSpec_comp : AlgebraicGeometry.Spec.map (α₀ ≫ φ₀) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K₀)) := by
    rw [AlgebraicGeometry.Spec.map_comp, hSpec_α₀]
    dsimp [g_spec]
    rw [← CategoryTheory.Category.assoc, hSpec₀, hη₀_hom]
  have hHom_comp : α₀ ≫ φ₀ = CommRingCat.ofHom (algebraMap k K₀) := by
    simpa [AlgebraicGeometry.Spec.preimage_map] using
      congrArg AlgebraicGeometry.Spec.preimage hSpec_comp
  have hAlg_comp : (algebraMap R₀ K₀).comp (algebraMap k R₀) = algebraMap k K₀ := by
    change (CommRingCat.Hom.hom φ₀).comp (CommRingCat.Hom.hom α₀) = algebraMap k K₀
    have h1 := congrArg CommRingCat.Hom.hom hHom_comp
    simpa [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using h1
  have : IsScalarTower k R₀ K₀ := IsScalarTower.of_algebraMap_eq' hAlg_comp.symm
  let e_U := AlgebraicGeometry.Scheme.homeoOfIso hU₀.isoSpec
  have hDimR₀ : ringKrullDim R₀ ≤ (m : WithBot ℕ∞) := by
    have h1 : ringKrullDim R₀ = topologicalKrullDim (PrimeSpectrum R₀) :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim R₀).symm
    have h2 : topologicalKrullDim ↥U₀.toScheme =
        topologicalKrullDim ↥(AlgebraicGeometry.Spec R₀_cat) :=
      e_U.isHomeomorph.topologicalKrullDim_eq
    have h3 : topologicalKrullDim ↥(U₀ : Set ↥B₂.left) ≤ topologicalKrullDim ↥B₂.left :=
      topologicalKrullDim_subspace_le ↥B₂.left (U₀ : Set ↥B₂.left)
    calc ringKrullDim R₀
      _ = topologicalKrullDim ↥(AlgebraicGeometry.Spec R₀_cat) := h1
      _ = topologicalKrullDim ↥U₀.toScheme := h2.symm
      _ = topologicalKrullDim ↥(U₀ : Set ↥B₂.left) := rfl
      _ ≤ topologicalKrullDim ↥B₂.left := h3
      _ = (m : WithBot ℕ∞) := hDimB₂
  
  
  have hTrK₀ : Algebra.trdeg k K₀ ≤ (m : Cardinal.{u}) := by
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k R₀
    let P : Type u := MvPolynomial (Fin s) k
    have hDimP : ringKrullDim P = (s : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    have hs_le_m : s ≤ m := by
      let : Algebra P R₀ := g.toRingHom.toAlgebra
      have : Algebra.IsIntegral P R₀ := ⟨hg_int⟩
      have hLift : ∀ (len : ℕ) (p : LTSeries (PrimeSpectrum P)), p.length = len →
          ∃ q : LTSeries (PrimeSpectrum R₀),
            q.length = len ∧ Ideal.under P q.last.asIdeal = p.last.asIdeal := by
        intro len
        induction len with
        | zero =>
          intro p _
          have h_bot : Ideal.under P (⊥ : Ideal R₀) ≤ p.last.asIdeal := by
            intro y hy
            have hy0 : g y = 0 := Ideal.mem_bot.mp hy
            have hy_eq : y = 0 := hg_inj (by simpa using hy0)
            rw [hy_eq]
            exact p.last.asIdeal.zero_mem
          have : p.last.asIdeal.IsPrime := p.last.isPrime
          obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal (⊥ : Ideal R₀) h_bot
          exact ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, hQ₀_under⟩
        | succ len ih =>
          intro p hp_len
          let p' : LTSeries (PrimeSpectrum P) := p.eraseLast
          have hp'_len : p'.length = len := by
            rw [RelSeries.eraseLast_length, hp_len]
            omega
          have hp'_lt : p'.last < p.last :=
            p.eraseLast_last_rel_last (by omega)
          obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
          have h_le_under : Ideal.under P q'.last.asIdeal ≤ p.last.asIdeal := by
            rw [hq'_under]
            exact le_of_lt hp'_lt
          have : p.last.asIdeal.IsPrime := p.last.isPrime
          have : q'.last.asIdeal.IsPrime := q'.last.isPrime
          obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
              p.last.asIdeal q'.last.asIdeal h_le_under
          have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum R₀) := by
            refine lt_of_le_of_ne hQ_ge ?_
            intro h_eq
            have h_asIdeal : q'.last.asIdeal = Q_next := congrArg PrimeSpectrum.asIdeal h_eq
            have h_p_eq : p'.last = p.last := by
              ext1
              rw [← hq'_under, h_asIdeal, hQ_under]
            exact (ne_of_lt hp'_lt) h_p_eq
          refine ⟨q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q, ?_, ?_⟩
          · rw [RelSeries.snoc_length, hq'_len]
          · rw [RelSeries.last_snoc]
            exact hQ_under
      have hs_le_P : (s : WithBot ℕ∞) ≤ ringKrullDim P := le_of_eq hDimP.symm
      obtain ⟨p₀, hp₀_len⟩ := Order.le_krullDim_iff.mp hs_le_P
      obtain ⟨q₀, hq₀_len, -⟩ := hLift p₀.length p₀ rfl
      have hq₀_le : (q₀.length : WithBot ℕ∞) ≤ ringKrullDim R₀ :=
        Order.LTSeries.length_le_krullDim q₀
      have hs_cast_le : (s : WithBot ℕ∞) ≤ (m : WithBot ℕ∞) := by
        calc (s : WithBot ℕ∞)
          _ = (p₀.length : WithBot ℕ∞) := by rw [hp₀_len]
          _ = (q₀.length : WithBot ℕ∞) := by rw [hq₀_len]
          _ ≤ ringKrullDim R₀ := hq₀_le
          _ ≤ (m : WithBot ℕ∞) := hDimR₀
      exact (Nat.cast_le (α := WithBot ℕ∞)).mp hs_cast_le
    have h_tr_kR₀ : Algebra.trdeg k R₀ = (s : Cardinal.{u}) := by
      let : Algebra P R₀ := g.toRingHom.toAlgebra
      have : IsScalarTower k P R₀ := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
      have : FaithfulSMul k P :=
        (faithfulSMul_iff_algebraMap_injective k P).mpr (algebraMap k P).injective
      have : FaithfulSMul P R₀ :=
        (faithfulSMul_iff_algebraMap_injective P R₀).mpr hg_inj
      have : Algebra.IsIntegral P R₀ := ⟨hg_int⟩
      have : Algebra.IsAlgebraic P R₀ := Algebra.IsIntegral.isAlgebraic
      have h_tr_PR₀ : Algebra.trdeg P R₀ = 0 := trdeg_eq_zero
      have h_tr_kP : Algebra.trdeg k P = (s : Cardinal.{u}) := by
        simp [P]
      have h_add := trdeg_add_eq k P (A := R₀)
      rw [h_tr_kP, h_tr_PR₀, add_zero] at h_add
      exact h_add.symm
    have : FaithfulSMul k R₀ :=
      (faithfulSMul_iff_algebraMap_injective k R₀).mpr (algebraMap k R₀).injective
    have : FaithfulSMul R₀ K₀ :=
      (faithfulSMul_iff_algebraMap_injective R₀ K₀).mpr (IsFractionRing.injective R₀ K₀)
    have : Algebra.IsAlgebraic R₀ K₀ := IsLocalization.isAlgebraic K₀ (nonZeroDivisors R₀)
    have h_tr_RK₀ : Algebra.trdeg R₀ K₀ = 0 := trdeg_eq_zero
    have h_add_K₀ := trdeg_add_eq k R₀ (A := K₀)
    rw [h_tr_kR₀, h_tr_RK₀, add_zero] at h_add_K₀
    rw [← h_add_K₀]
    exact (Nat.cast_le (α := Cardinal.{u})).mpr hs_le_m
  
  let alg_k_K : Algebra k (SeparableClosure K₀) :=
    ((algebraMap K₀ (SeparableClosure K₀)).comp (algebraMap k K₀)).toAlgebra
  have : IsScalarTower k K₀ (SeparableClosure K₀) := IsScalarTower.of_algebraMap_eq' rfl
  have : FaithfulSMul k K₀ :=
    (faithfulSMul_iff_algebraMap_injective k K₀).mpr (algebraMap k K₀).injective
  have : FaithfulSMul K₀ (SeparableClosure K₀) :=
    (faithfulSMul_iff_algebraMap_injective K₀ (SeparableClosure K₀)).mpr
      (algebraMap K₀ (SeparableClosure K₀)).injective
  have hTrSep : Algebra.trdeg K₀ (SeparableClosure K₀) = 0 := trdeg_eq_zero
  have hAdd := trdeg_add_eq k K₀ (A := SeparableClosure K₀)
  rw [hTrSep, add_zero] at hAdd
  exact ⟨SeparableClosure K₀, inferInstance, inferInstance, alg_k_K, inferInstance,
    inferInstance, inferInstance, hAdd.symm.trans_le hTrK₀⟩

theorem weil_generic_fiber_curve_pullback_and_proj_embedding (k : Type u) [Field k]
    (B₂ X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (K : Type u) [Field K] [Algebra k K]
    (hProjXK : IsProjectiveOverField K (weilBaseChangeOver k K X₂))
    (η_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₂.left)
    (hηK_hom : η_K ≫ B₂.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K)))
    (hηK_mem : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)), η_K.base pt ∈ U₂) :
    ∃ (C_K : AlgebraicGeometry.Scheme.{u})
      (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (ι_K : C_K ⟶ X₂.left)
      (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
      (M_K : ℕ)
      (ι_proj : C_K ⟶ (weilProjectiveSpaceOver K M_K).left),
      CategoryTheory.IsPullback ι_K p_K f₂.left η_K ∧
      (∀ j : Fin n, σ_K j ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K))) ∧
      (∀ j : Fin n, σ_K j ≫ ι_K = η_K ≫ (σ j).left) ∧
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (σ_K i).base) (Set.range (σ_K j).base)) ∧
      AlgebraicGeometry.IsProper p_K ∧
      AlgebraicGeometry.Surjective p_K ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
        ConnectedSpace ↥(CategoryTheory.Limits.pullback p_K s)) ∧
      AlgebraicGeometry.IsClosedImmersion ι_proj ∧
      ι_proj ≫ (weilProjectiveSpaceOver K M_K).hom = p_K :=
by
  obtain ⟨_hn, ⟨hProp_f₂, hSurj_f₂, hSm_U₂, hFib_geom⟩, hσ_sec, hσ_disj, _hThree⟩ := hFib₂
  let S_K : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let C_K : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₂.left η_K
  let ι_K : C_K ⟶ X₂.left := CategoryTheory.Limits.pullback.fst f₂.left η_K
  let p_K : C_K ⟶ S_K := CategoryTheory.Limits.pullback.snd f₂.left η_K
  have hPbK : CategoryTheory.IsPullback ι_K p_K f₂.left η_K :=
    CategoryTheory.IsPullback.of_hasPullback f₂.left η_K
  have hPropCK : AlgebraicGeometry.IsProper p_K :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbK hProp_f₂
  have hSurjCK : AlgebraicGeometry.Surjective p_K :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbK hSurj_f₂
  have h_sec_comm : ∀ j : Fin n, (η_K ≫ (σ j).left) ≫ f₂.left = 𝟙 S_K ≫ η_K := by
    intro j
    have hσ_left : (σ j).left ≫ f₂.left = 𝟙 B₂.left := by
      simpa using congrArg CategoryTheory.Over.Hom.left (hσ_sec j)
    rw [CategoryTheory.Category.assoc, hσ_left, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.id_comp]
  let σ_K : Fin n → (S_K ⟶ C_K) :=
    fun j => CategoryTheory.Limits.pullback.lift (η_K ≫ (σ j).left) (𝟙 S_K) (h_sec_comm j)
  have hSecK : ∀ j : Fin n, σ_K j ≫ p_K = 𝟙 S_K :=
    fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hσK_ι : ∀ j : Fin n, σ_K j ≫ ι_K = η_K ≫ (σ j).left :=
    fun j => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hDisjK : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (σ_K i).base) (Set.range (σ_K j).base) := by
    intro i j hij
    rw [Set.disjoint_left]
    rintro z ⟨pt₁, rfl⟩ ⟨pt₂, hpt₂⟩
    have h₁ : ι_K.base ((σ_K i).base pt₁) = (σ i).left.base (η_K.base pt₁) := by
      have hcomp := congrArg (fun φ : S_K ⟶ X₂.left => φ.base pt₁) (hσK_ι i)
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using hcomp
    have h₂ : ι_K.base ((σ_K j).base pt₂) = (σ j).left.base (η_K.base pt₂) := by
      have hcomp := congrArg (fun φ : S_K ⟶ X₂.left => φ.base pt₂) (hσK_ι j)
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using hcomp
    have hx_i : ι_K.base ((σ_K i).base pt₁) ∈ (σ i).left.base '' (U₂ : Set B₂.left) :=
      ⟨η_K.base pt₁, hηK_mem pt₁, h₁.symm⟩
    have hx_j : ι_K.base ((σ_K i).base pt₁) ∈ (σ j).left.base '' (U₂ : Set B₂.left) := by
      rw [← hpt₂]
      exact ⟨η_K.base pt₂, hηK_mem pt₂, h₂.symm⟩
    exact Set.disjoint_left.mp (hσ_disj hij) hx_i hx_j
  have hRange : Set.range ⇑η_K ⊆ Set.range ⇑U₂.ι := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    exact hηK_mem pt
  let η_U : S_K ⟶ U₂.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U₂.ι η_K hRange
  have hηU_fac : η_U ≫ U₂.ι = η_K := AlgebraicGeometry.IsOpenImmersion.lift_fac U₂.ι η_K hRange
  have hPb_outer : CategoryTheory.IsPullback p_K ι_K (η_U ≫ U₂.ι) f₂.left := by
    rw [hηU_fac]
    exact hPbK.flip
  have hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_bot' hPb_outer
        (AlgebraicGeometry.isPullback_morphismRestrict f₂.left U₂)).flip hSm_U₂
  have hConnCK : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S_K),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback p_K s) := by
    intro Ω _ _ s
    have h_paste := (CategoryTheory.IsPullback.of_hasPullback p_K s).paste_horiz hPbK
    let h_homeo := (AlgebraicGeometry.Scheme.homeoOfIso h_paste.isoPullback).symm
    have : ConnectedSpace ↥(CategoryTheory.Limits.pullback f₂.left (s ≫ η_K)) :=
      (hFib_geom Ω (s ≫ η_K)).1
    exact h_homeo.surjective.connectedSpace h_homeo.continuous
  have hSepB₂ : AlgebraicGeometry.IsSeparated B₂.hom := by
    obtain ⟨N_B, ι_B, hClB⟩ := hProjB₂
    let : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N_B + 1)) k) :=
      MvPolynomial.gradedAlgebra
    have : AlgebraicGeometry.IsClosedImmersion ι_B.left := hClB
    have hSep1 : AlgebraicGeometry.IsSeparated
        (AlgebraicGeometry.Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N_B + 1)) k)) :=
      inferInstance
    have hSep2 : AlgebraicGeometry.IsSeparated
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N_B + 1)) k 0)))) :=
      inferInstance
    have hSepProj : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k N_B).hom :=
      CategoryTheory.MorphismProperty.comp_mem @AlgebraicGeometry.IsSeparated _ _ hSep1 hSep2
    rw [← CategoryTheory.Over.w ι_B]
    exact CategoryTheory.MorphismProperty.comp_mem @AlgebraicGeometry.IsSeparated _ _
      inferInstance hSepProj
  let s_K : S_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K))
  let Q_B : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback (η_K ≫ B₂.hom) B₂.hom
  let q₁ : Q_B ⟶ S_K := CategoryTheory.Limits.pullback.fst (η_K ≫ B₂.hom) B₂.hom
  let q₂ : Q_B ⟶ B₂.left := CategoryTheory.Limits.pullback.snd (η_K ≫ B₂.hom) B₂.hom
  let Γ₀ : S_K ⟶ Q_B :=
    CategoryTheory.Limits.pullback.lift (𝟙 S_K) η_K (CategoryTheory.Category.id_comp _)
  have hClΓ₀ : AlgebraicGeometry.IsClosedImmersion Γ₀ :=
    AlgebraicGeometry.IsSeparated.instIsClosedImmersionLiftSchemeId η_K B₂.hom
  let P_X : AlgebraicGeometry.Scheme.{u} := (weilBaseChangeOver k K X₂).left
  let π_X : P_X ⟶ X₂.left := CategoryTheory.Limits.pullback.fst X₂.hom s_K
  let q_X : P_X ⟶ S_K := CategoryTheory.Limits.pullback.snd X₂.hom s_K
  have hF_comm : q_X ≫ (η_K ≫ B₂.hom) = (π_X ≫ f₂.left) ≫ B₂.hom := by
    rw [hηK_hom, CategoryTheory.Category.assoc, CategoryTheory.Over.w f₂]
    exact CategoryTheory.Limits.pullback.condition.symm
  let F_K : P_X ⟶ Q_B := CategoryTheory.Limits.pullback.lift q_X (π_X ≫ f₂.left) hF_comm
  have hF_q₁ : F_K ≫ q₁ = q_X := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hF_q₂ : F_K ≫ q₂ = π_X ≫ f₂.left := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_mid_outer :
      CategoryTheory.IsPullback π_X (F_K ≫ q₁) (f₂.left ≫ B₂.hom) (η_K ≫ B₂.hom) := by
    rw [hF_q₁, CategoryTheory.Over.w f₂, hηK_hom]
    exact CategoryTheory.IsPullback.of_hasPullback X₂.hom s_K
  have hPb_mid : CategoryTheory.IsPullback π_X F_K f₂.left q₂ :=
    CategoryTheory.IsPullback.of_bot hPb_mid_outer hF_q₂.symm
      (CategoryTheory.IsPullback.of_hasPullback (η_K ≫ B₂.hom) B₂.hom).flip
  have hj_comm : ι_K ≫ X₂.hom = p_K ≫ s_K := by
    rw [← CategoryTheory.Over.w f₂, ← CategoryTheory.Category.assoc, hPbK.w,
      CategoryTheory.Category.assoc, hηK_hom]
  let j_K : C_K ⟶ P_X := CategoryTheory.Limits.pullback.lift ι_K p_K hj_comm
  have hj_π : j_K ≫ π_X = ι_K := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hj_q : j_K ≫ q_X = p_K := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have h_comm_top : p_K ≫ Γ₀ = j_K ≫ F_K := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc, hF_q₁, hj_q]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← hPbK.w, CategoryTheory.Category.assoc, hF_q₂, ← CategoryTheory.Category.assoc, hj_π]
  have hPb_top_outer : CategoryTheory.IsPullback p_K (j_K ≫ π_X) (Γ₀ ≫ q₂) f₂.left := by
    have hΓ₀_q₂ : Γ₀ ≫ q₂ = η_K := CategoryTheory.Limits.pullback.lift_snd _ _ _
    rw [hj_π, hΓ₀_q₂]
    exact hPbK.flip
  have hPb_top : CategoryTheory.IsPullback p_K j_K Γ₀ F_K :=
    CategoryTheory.IsPullback.of_bot hPb_top_outer h_comm_top hPb_mid.flip
  have hCl_jK : AlgebraicGeometry.IsClosedImmersion j_K :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top hClΓ₀
  obtain ⟨M_K, ι_XK, hClXK⟩ := hProjXK
  have : AlgebraicGeometry.IsClosedImmersion ι_XK.left := hClXK
  let ι_proj : C_K ⟶ (weilProjectiveSpaceOver K M_K).left := j_K ≫ ι_XK.left
  have hCl_proj : AlgebraicGeometry.IsClosedImmersion ι_proj := by
    dsimp [ι_proj]
    infer_instance
  have hProjComm : ι_proj ≫ (weilProjectiveSpaceOver K M_K).hom = p_K := by
    dsimp [ι_proj]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_XK]
    exact hj_q
  exact ⟨C_K, p_K, ι_K, σ_K, M_K, ι_proj,
    hPbK, hSecK, hσK_ι, hDisjK, hPropCK, hSurjCK, hSmCK, hConnCK, hCl_proj, hProjComm⟩

theorem weil_smooth_threeSecant_curve_over_field_integral_and_stable (K : Type u) [Field K]
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hn : 3 ≤ n)
    (hProp : AlgebraicGeometry.IsProper p_K)
    (hSurj : AlgebraicGeometry.Surjective p_K)
    (hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hSec : ∀ j : Fin n, σ_K j ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (hDisj : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (σ_K i).base) (Set.range (σ_K j).base))
    (hConn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback p_K s)) :
    AlgebraicGeometry.IsIntegral C_K ∧
    IsGeometricStablePointedCurve p_K n σ_K :=
by
  have h_etale_max_zero : ∀ (L : Type u) [Field L] (B : Type u) [CommRing B] [Algebra L B]
      [Algebra.Etale L B] (R_loc : Type u) [CommRing R_loc] [IsLocalRing R_loc]
      (Φ : B →+* R_loc) (z : B),
      Φ z ∈ IsLocalRing.maximalIdeal R_loc → Φ z = 0 := by
    intro L _ B _ _ _ R_loc _ _ Φ z hz
    classical
    obtain ⟨I, _, Ai, hFieldAi, hAlgAi, hEquiv, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod L B).mp inferInstance
    let _ : ∀ i : I, Field (Ai i) := hFieldAi
    let _ : ∀ i : I, Algebra L (Ai i) := hAlgAi
    let z' : ∀ i : I, Ai i := hEquiv z
    let e' : ∀ i : I, Ai i := fun i => if z' i = 0 then 1 else 0
    let e : B := hEquiv.symm e'
    have hze : z * e = 0 := by
      apply hEquiv.injective
      rw [map_mul, hEquiv.apply_symm_apply, map_zero]
      ext i
      change z' i * (if z' i = 0 then 1 else 0) = 0
      split_ifs with h <;> simp [h]
    have hu_ze' : IsUnit (z' + e') := by
      rw [Pi.isUnit_iff]
      intro i
      rw [isUnit_iff_ne_zero]
      change z' i + (if z' i = 0 then 1 else 0) ≠ 0
      split_ifs with h
      · simp [h]
      · simpa using h
    have hu_ze : IsUnit (z + e) := by
      have h1 : IsUnit (hEquiv.symm.toRingHom (z' + e')) := hu_ze'.map hEquiv.symm.toRingHom
      simpa [e, z', map_add] using h1
    have hu_sum : IsUnit (Φ z + Φ e) := by
      simpa [map_add] using hu_ze.map Φ
    have he_not_max : Φ e ∉ IsLocalRing.maximalIdeal R_loc := by
      intro he_mem
      exact IsLocalRing.notMem_maximalIdeal.mpr hu_sum (Ideal.add_mem _ hz he_mem)
    rcases IsLocalRing.notMem_maximalIdeal.mp he_not_max with ⟨u, hu⟩
    have hmul_zero : Φ z * Φ e = 0 := by
      rw [← map_mul, hze, map_zero]
    calc Φ z = Φ z * (↑u * ↑u⁻¹) := by simp
      _ = (Φ z * Φ e) * ↑u⁻¹ := by rw [← mul_assoc, hu]
      _ = 0 := by rw [hmul_zero, zero_mul]
  have h_stalk_dom : ∀ (R₀ : Type u) [Field R₀] (S : Type u) [CommRing S]
      [Algebra (Polynomial R₀) S] [Algebra.Etale (Polynomial R₀) S]
      (q : Ideal S) [q.IsPrime],
      True ∧ IsDomain (Localization.AtPrime q) := by
    intro R₀ _ S _ _ _ q _
    refine ⟨trivial, ?_⟩
    have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing (Polynomial R₀) S
    have : Module.Flat (Polynomial R₀) S := Algebra.Smooth.flat (Polynomial R₀) S
    have : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) inferInstance
    have : Module.Flat (Polynomial R₀) (Localization.AtPrime q) :=
      Localization.flat S q.primeCompl
    have : Module.IsTorsionFree (Polynomial R₀) (Localization.AtPrime q) :=
      Module.Flat.isTorsionFree
    let p : Ideal (Polynomial R₀) := Ideal.comap (algebraMap (Polynomial R₀) S) q
    have : p.IsPrime := Ideal.IsPrime.comap _
    by_cases hp : p = ⊥
    · have hunits : ∀ y : nonZeroDivisors (Polynomial R₀),
          IsUnit (algebraMap (Polynomial R₀) (Localization.AtPrime q) y) := by
        intro y
        have hy_ne : (y : Polynomial R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        have hy_not_p : (y : Polynomial R₀) ∉ p := by
          rw [hp]
          exact hy_ne
        have hy_compl : algebraMap (Polynomial R₀) S y ∈ q.primeCompl := hy_not_p
        rw [IsScalarTower.algebraMap_apply (Polynomial R₀) S (Localization.AtPrime q)]
        exact IsLocalization.map_units (Localization.AtPrime q)
          ⟨algebraMap (Polynomial R₀) S y, hy_compl⟩
      let ψ_ring : FractionRing (Polynomial R₀) →+* Localization.AtPrime q :=
        IsLocalization.lift hunits
      let ψ_alg : FractionRing (Polynomial R₀) →ₐ[Polynomial R₀] Localization.AtPrime q :=
        { ψ_ring with
          commutes' := fun a => IsLocalization.lift_eq hunits a }
      let Φ_alg : TensorProduct (Polynomial R₀) (FractionRing (Polynomial R₀)) S →ₐ[Polynomial R₀]
          Localization.AtPrime q :=
        Algebra.TensorProduct.lift ψ_alg
          (IsScalarTower.toAlgHom (Polynomial R₀) S (Localization.AtPrime q))
          (fun _ _ => Commute.all _ _)
      have hmax_bot : IsLocalRing.maximalIdeal (Localization.AtPrime q) = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro w hw
        obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl w
        have hΦ_mem : Φ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          have hΦ_eq : Φ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) =
              w * algebraMap S (Localization.AtPrime q) t.1 := by
            change Φ_alg (1 ⊗ₜ[Polynomial R₀] s) = _
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            exact hst.symm
          rw [hΦ_eq]
          exact Ideal.mul_mem_right _ _ hw
        have hs_zero : algebraMap S (Localization.AtPrime q) s = 0 := by
          have h0 := h_etale_max_zero (FractionRing (Polynomial R₀))
            (TensorProduct (Polynomial R₀) (FractionRing (Polynomial R₀)) S)
            (Localization.AtPrime q) Φ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) hΦ_mem
          simpa [Φ_alg, Algebra.TensorProduct.lift_tmul] using h0
        have hwt_zero : w * algebraMap S (Localization.AtPrime q) t.1 = 0 :=
          hst.trans hs_zero
        rcases IsLocalization.map_units (Localization.AtPrime q) t with ⟨u, hu⟩
        calc w = w * (↑u * ↑u⁻¹) := by simp
          _ = (w * algebraMap S (Localization.AtPrime q) t.1) * ↑u⁻¹ := by rw [← mul_assoc, hu]
          _ = 0 := by rw [hwt_zero, zero_mul]
      let _ : Field (Localization.AtPrime q) :=
        (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hmax_bot).toField
      exact inferInstance
    · have : p.IsMaximal := IsPrime.to_maximal_ideal hp
      let _ : Field (Polynomial R₀ ⧸ p) := Ideal.Quotient.field p
      let π₀ : Polynomial R₀ := Submodule.IsPrincipal.generator p
      have hspan_p : Ideal.span {π₀} = p := Submodule.IsPrincipal.span_singleton_generator p
      have hπ₀_ne : π₀ ≠ 0 := by
        intro h0
        apply hp
        rw [← hspan_p, h0, Set.singleton_zero, Ideal.span_zero]
      have hπ₀_mem : π₀ ∈ p := by
        rw [← hspan_p]
        exact Ideal.subset_span (Set.mem_singleton π₀)
      let π_S : S := algebraMap (Polynomial R₀) S π₀
      have hπS_mem : π_S ∈ q := hπ₀_mem
      let π_bar : Localization.AtPrime q := algebraMap S (Localization.AtPrime q) π_S
      have hπbar_max : π_bar ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q π_S).mpr hπS_mem
      let I_bar : Ideal (Localization.AtPrime q) := Ideal.span {π_bar}
      have hI_le_max : I_bar ≤ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπbar_max)
      have hI_ne_top : I_bar ≠ ⊤ := by
        intro htop
        apply Ideal.IsMaximal.ne_top
          (inferInstance : (IsLocalRing.maximalIdeal (Localization.AtPrime q)).IsMaximal)
        exact top_unique (htop ▸ hI_le_max)
      let Q := Localization.AtPrime q ⧸ I_bar
      have : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
      have : IsLocalRing Q :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I_bar) Ideal.Quotient.mk_surjective
      let toQ_S : S →ₐ[Polynomial R₀] Q :=
        (Ideal.Quotient.mkₐ (Polynomial R₀) I_bar).comp
          (IsScalarTower.toAlgHom (Polynomial R₀) S (Localization.AtPrime q))
      let toQ_P : Polynomial R₀ →ₐ[Polynomial R₀] Q :=
        (Ideal.Quotient.mkₐ (Polynomial R₀) I_bar).comp
          (Algebra.ofId (Polynomial R₀) (Localization.AtPrime q))
      have hker_p : ∀ a ∈ p, toQ_P a = 0 := by
        intro a ha
        rw [← hspan_p, Ideal.mem_span_singleton] at ha
        rcases ha with ⟨r, rfl⟩
        change Ideal.Quotient.mk I_bar
          (algebraMap (Polynomial R₀) (Localization.AtPrime q) (π₀ * r)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem, map_mul]
        have hπ_eq : algebraMap (Polynomial R₀) (Localization.AtPrime q) π₀ = π_bar :=
          IsScalarTower.algebraMap_apply (Polynomial R₀) S (Localization.AtPrime q) π₀
        rw [hπ_eq]
        exact Ideal.mul_mem_right _ I_bar (Ideal.subset_span (Set.mem_singleton π_bar))
      let ψ_k : (Polynomial R₀ ⧸ p) →ₐ[Polynomial R₀] Q :=
        Ideal.Quotient.liftₐ p toQ_P hker_p
      let Ψ_alg : TensorProduct (Polynomial R₀) (Polynomial R₀ ⧸ p) S →ₐ[Polynomial R₀] Q :=
        Algebra.TensorProduct.lift ψ_k toQ_S (fun _ _ => Commute.all _ _)
      have hmaxQ_bot : IsLocalRing.maximalIdeal Q = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro w_bar hw_bar
        obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w_bar
        obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl w
        have hΨ_mem : Ψ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) ∈ IsLocalRing.maximalIdeal Q := by
          have hΨ_eq : Ψ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) =
              Ideal.Quotient.mk I_bar w *
                Ideal.Quotient.mk I_bar (algebraMap S (Localization.AtPrime q) t.1) := by
            change Ψ_alg (1 ⊗ₜ[Polynomial R₀] s) = _
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            change Ideal.Quotient.mk I_bar (algebraMap S (Localization.AtPrime q) s) = _
            rw [← hst, map_mul]
          rw [hΨ_eq]
          exact Ideal.mul_mem_right _ _ hw_bar
        have hs_zero : Ideal.Quotient.mk I_bar (algebraMap S (Localization.AtPrime q) s) = 0 := by
          have h0 := h_etale_max_zero (Polynomial R₀ ⧸ p)
            (TensorProduct (Polynomial R₀) (Polynomial R₀ ⧸ p) S) Q
            Ψ_alg.toRingHom (1 ⊗ₜ[Polynomial R₀] s) hΨ_mem
          simpa [Ψ_alg, toQ_S, Algebra.TensorProduct.lift_tmul] using h0
        have hwt_zero : Ideal.Quotient.mk I_bar w *
            Ideal.Quotient.mk I_bar (algebraMap S (Localization.AtPrime q) t.1) = 0 := by
          rw [← map_mul, hst, hs_zero]
        have hu_t : IsUnit (Ideal.Quotient.mk I_bar (algebraMap S (Localization.AtPrime q) t.1)) :=
          (IsLocalization.map_units (Localization.AtPrime q) t).map (Ideal.Quotient.mk I_bar)
        rcases hu_t with ⟨u, hu⟩
        calc Ideal.Quotient.mk I_bar w = Ideal.Quotient.mk I_bar w * (↑u * ↑u⁻¹) := by simp
          _ = (Ideal.Quotient.mk I_bar w *
                Ideal.Quotient.mk I_bar (algebraMap S (Localization.AtPrime q) t.1)) * ↑u⁻¹ := by
              rw [← mul_assoc, hu]
          _ = 0 := by rw [hwt_zero, zero_mul]
      have hFieldQ : IsField Q := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hmaxQ_bot
      have hMaxI : I_bar.IsMaximal :=
        (Ideal.Quotient.maximal_ideal_iff_isField_quotient I_bar).mpr hFieldQ
      have hI_eq_max : I_bar = IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
        IsLocalRing.eq_maximalIdeal hMaxI
      have : NoZeroDivisors (Localization.AtPrime q) := by
        refine ⟨fun {x y} hxy => ?_⟩
        by_contra hnot
        have hx : x ≠ 0 := fun hx0 => hnot (Or.inl hx0)
        have hy : y ≠ 0 := fun hy0 => hnot (Or.inr hy0)
        have hiInf : (⨅ i : ℕ, I_bar ^ i) = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing I_bar hI_ne_top
        have hy_not_iInf : y ∉ (⨅ i : ℕ, I_bar ^ i) := by
          rw [hiInf]
          exact hy
        rw [Ideal.mem_iInf] at hy_not_iInf
        have hex : ∃ i : ℕ, y ∉ I_bar ^ i := not_forall.mp hy_not_iInf
        classical
        let m : ℕ := Nat.find hex
        have hm_not : y ∉ I_bar ^ m := Nat.find_spec hex
        have hm_ne_zero : m ≠ 0 := by
          intro hm0
          apply hm_not
          rw [hm0, pow_zero, Ideal.one_eq_top]
          trivial
        obtain ⟨b, hb⟩ := Nat.exists_eq_succ_of_ne_zero hm_ne_zero
        have hb_lt : b < Nat.find hex := by
          change b < m
          omega
        have hy_in_b : y ∈ I_bar ^ b := by
          by_contra hyb
          exact Nat.find_min hex hb_lt hyb
        have hpow_b : I_bar ^ b = Ideal.span {π_bar ^ b} := Ideal.span_singleton_pow π_bar b
        rw [hpow_b, Ideal.mem_span_singleton] at hy_in_b
        rcases hy_in_b with ⟨u, rfl⟩
        have hu_not_I : u ∉ I_bar := by
          intro hu_in
          rw [Ideal.mem_span_singleton] at hu_in
          rcases hu_in with ⟨v, rfl⟩
          apply hm_not
          rw [hb, Nat.succ_eq_add_one, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          exact ⟨v, by ring⟩
        have hu_not_max : u ∉ IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
          hI_eq_max ▸ hu_not_I
        rcases IsLocalRing.notMem_maximalIdeal.mp hu_not_max with ⟨u_unit, hu_unit⟩
        have hxπ_zero : x * π_bar ^ b = 0 := by
          calc x * π_bar ^ b = (x * π_bar ^ b) * (↑u_unit * ↑u_unit⁻¹) := by simp
            _ = (x * (π_bar ^ b * u)) * ↑u_unit⁻¹ := by rw [← mul_assoc, mul_assoc x, hu_unit]
            _ = 0 := by rw [hxy, zero_mul]
        have hsmul_zero : (π₀ ^ b) • x = 0 := by
          rw [Algebra.smul_def, map_pow]
          have hπ_eq : algebraMap (Polynomial R₀) (Localization.AtPrime q) π₀ = π_bar :=
            IsScalarTower.algebraMap_apply (Polynomial R₀) S (Localization.AtPrime q) π₀
          rw [hπ_eq, mul_comm, hxπ_zero]
        rcases smul_eq_zero.mp hsmul_zero with hπb0 | hx0
        · exact pow_ne_zero b hπ₀_ne hπb0
        · exact hx hx0
      exact NoZeroDivisors.to_isDomain (Localization.AtPrime q)
  have h_smooth_int : ∀ (E : Type u) [Field E] (Y : AlgebraicGeometry.Scheme.{u})
      (q : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of E))
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 q] [ConnectedSpace ↥Y],
      True ∧ AlgebraicGeometry.IsIntegral Y := by
    intro E _ Y q _ _
    refine ⟨trivial, ?_⟩
    have h_chart : ∀ z : ↥Y, ∃ (V_z : Y.Opens) (hVz : AlgebraicGeometry.IsAffineOpen V_z)
        (hz : z ∈ V_z),
        IsNoetherianRing ↑(Y.presheaf.obj (Opposite.op V_z)) ∧
        IsDomain (Localization.AtPrime (hVz.primeIdealOf ⟨z, hz⟩).asIdeal) := by
      intro z
      obtain ⟨U₀, _hU₀, V_z, hVz, hz, e_z, hf₀⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 q).mp inferInstance z
      have hU₀_top : U₀ = ⊤ := by
        ext pt
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hsub : q.base z = pt := Subsingleton.elim _ _
        exact hsub ▸ e_z hz
      let R₀ : Type u := ↑((AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.obj (Opposite.op U₀))
      let iso_E : (AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.obj (Opposite.op U₀) ≅
          CommRingCat.of E :=
        ((AlgebraicGeometry.Spec (CommRingCat.of E)).presheaf.mapIso
          (eqToIso (congrArg Opposite.op hU₀_top))) ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of E)
      let e_E : R₀ ≃+* E := CategoryTheory.Iso.commRingCatIsoToRingEquiv iso_E
      let _ : Field R₀ := (MulEquiv.isField (Field.toIsField E) e_E.toMulEquiv).toField
      let S : Type u := ↑(Y.presheaf.obj (Opposite.op V_z))
      obtain ⟨g_mv, _, hg_mv⟩ := hf₀.exists_etale_mvPolynomial
      let e_poly : Polynomial R₀ ≃+* MvPolynomial (Fin 1) R₀ :=
        (MvPolynomial.uniqueAlgEquiv R₀ (Fin 1)).symm.toRingEquiv
      let _ : Algebra (MvPolynomial (Fin 1) R₀) S := g_mv.toAlgebra
      let _ : Algebra (Polynomial R₀) (MvPolynomial (Fin 1) R₀) := e_poly.toRingHom.toAlgebra
      let _ : Algebra (Polynomial R₀) S := (g_mv.comp e_poly.toRingHom).toAlgebra
      have : IsScalarTower (Polynomial R₀) (MvPolynomial (Fin 1) R₀) S :=
        IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.Etale (Polynomial R₀) (MvPolynomial (Fin 1) R₀) :=
        RingHom.Etale.toAlgebra (RingHom.Etale.of_bijective e_poly.bijective)
      have : Algebra.Etale (MvPolynomial (Fin 1) R₀) S := RingHom.Etale.toAlgebra hg_mv
      have : Algebra.Etale (Polynomial R₀) S :=
        Algebra.Etale.comp (Polynomial R₀) (MvPolynomial (Fin 1) R₀) S
      refine ⟨V_z, hVz, hz, Algebra.FiniteType.isNoetherianRing (Polynomial R₀) S,
        (h_stalk_dom R₀ S (hVz.primeIdealOf ⟨z, hz⟩).asIdeal).2⟩
    have hStalkRed : ∀ z : ↥Y, _root_.IsReduced ↑(Y.presheaf.stalk z) := by
      intro z
      obtain ⟨V_z, hVz, hz, _, hDom⟩ := h_chart z
      have : IsDomain (Localization.AtPrime (hVz.primeIdealOf ⟨z, hz⟩).asIdeal) := hDom
      let _ : Algebra ↑(Y.presheaf.obj (Opposite.op V_z)) ↑(Y.presheaf.stalk z) :=
        TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨z, hz⟩
      have : IsLocalization (hVz.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl ↑(Y.presheaf.stalk z) :=
        hVz.isLocalization_stalk ⟨z, hz⟩
      exact isReduced_of_injective
        (IsLocalization.algEquiv (hVz.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl
          ↑(Y.presheaf.stalk z) (Localization.AtPrime (hVz.primeIdealOf ⟨z, hz⟩).asIdeal))
        (AlgEquiv.injective _)
    have : AlgebraicGeometry.IsReduced Y := @AlgebraicGeometry.isReduced_of_isReduced_stalk Y hStalkRed
    have h_loc_preirred : ∀ z : ↥Y, ∃ U_z : Set ↥Y,
        IsOpen U_z ∧ z ∈ U_z ∧ IsPreirreducible U_z := by
      intro z
      obtain ⟨V_z, hVz, hz, hNoeth, hDom⟩ := h_chart z
      let S : Type u := ↑(Y.presheaf.obj (Opposite.op V_z))
      have : IsNoetherianRing S := hNoeth
      let q_pt : PrimeSpectrum S := hVz.primeIdealOf ⟨z, hz⟩
      let q₀ : Ideal S := q_pt.asIdeal
      have : IsDomain (Localization.AtPrime q₀) := hDom
      let p_bot : Ideal S := Ideal.comap (algebraMap S (Localization.AtPrime q₀)) ⊥
      have hp_bot_prime : p_bot.IsPrime := Ideal.IsPrime.comap _
      have hp_bot_le : ∀ (r : Ideal S), r.IsPrime → r ≤ q₀ → p_bot ≤ r := by
        intro r hr hr_le x hx
        have hx0 : algebraMap S (Localization.AtPrime q₀) x = 0 := hx
        obtain ⟨c, hc⟩ :=
          (IsLocalization.map_eq_zero_iff q₀.primeCompl (Localization.AtPrime q₀) x).mp hx0
        have hcx_mem : (c : S) * x ∈ r := hc ▸ r.zero_mem
        rcases hr.mem_or_mem hcx_mem with hc_in | hx_in
        · exact False.elim (c.2 (hr_le hc_in))
        · exact hx_in
      let M_other : Set (Ideal S) := minimalPrimes S \ {p_bot}
      have hFin : M_other.Finite := (minimalPrimes.finite_of_isNoetherianRing S).sdiff
      let F_other : Set (PrimeSpectrum S) :=
        ⋃ m ∈ M_other, PrimeSpectrum.zeroLocus (m : Set S)
      have hClosedF : IsClosed F_other :=
        hFin.isClosed_biUnion (fun m _ => PrimeSpectrum.isClosed_zeroLocus _)
      let U_spec : Set (PrimeSpectrum S) := F_otherᶜ
      have hOpenU : IsOpen U_spec := hClosedF.isOpen_compl
      have hq_in_U : q_pt ∈ U_spec := by
        intro hmem
        simp only [F_other, Set.mem_iUnion] at hmem
        rcases hmem with ⟨m, ⟨hm_min, hm_ne⟩, hq_zl⟩
        have hm_le_q : m ≤ q₀ := hq_zl
        have hm_prime : m.IsPrime := hm_min.1.1
        have hp_le_m : p_bot ≤ m := hp_bot_le m hm_prime hm_le_q
        have hm_le_p : m ≤ p_bot := hm_min.2 ⟨hp_bot_prime, bot_le⟩ hp_le_m
        exact hm_ne (le_antisymm hm_le_p hp_le_m)
      let Z₀ : Set (PrimeSpectrum S) := PrimeSpectrum.zeroLocus (p_bot : Set S)
      have hU_sub_Z₀ : U_spec ⊆ Z₀ := by
        intro x_sp hx_sp
        obtain ⟨m, hm_min, hm_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ x_sp.asIdeal)
        by_cases hm_eq : m = p_bot
        · change p_bot ≤ x_sp.asIdeal
          exact hm_eq ▸ hm_le
        · exfalso
          apply hx_sp
          simp only [F_other, Set.mem_iUnion]
          exact ⟨m, ⟨hm_min, hm_eq⟩, hm_le⟩
      have hIrredZ₀ : IsIrreducible Z₀ :=
        (PrimeSpectrum.isIrreducible_zeroLocus_iff_of_radical p_bot hp_bot_prime.isRadical).mpr
          hp_bot_prime
      have hPreU : IsPreirreducible U_spec := by
        intro u v hu hv ⟨x₁, hx₁U, hx₁u⟩ ⟨x₂, hx₂U, hx₂v⟩
        obtain ⟨w, _, ⟨hwU, hwu⟩, ⟨_, hwv⟩⟩ :=
          hIrredZ₀.isPreirreducible (U_spec ∩ u) (U_spec ∩ v) (hOpenU.inter hu) (hOpenU.inter hv)
            ⟨x₁, hU_sub_Z₀ hx₁U, hx₁U, hx₁u⟩ ⟨x₂, hU_sub_Z₀ hx₂U, hx₂U, hx₂v⟩
        exact ⟨w, hwU, hwu, hwv⟩
      refine ⟨hVz.fromSpec.base '' U_spec,
        hVz.fromSpec.isOpenEmbedding.isOpenMap U_spec hOpenU,
        ⟨q_pt, hq_in_U, hVz.fromSpec_primeIdealOf ⟨z, hz⟩⟩,
        hPreU.image hVz.fromSpec.base hVz.fromSpec.continuous.continuousOn⟩
    have : IrreducibleSpace ↥Y :=
      { isPreirreducible_univ := by
          intro W₁ W₂ hW₁ hW₂ ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩
          have hOpenCl : IsOpen (closure W₁) := by
            rw [isOpen_iff_forall_mem_open]
            intro z hz_cl
            obtain ⟨U_z, hOpenUz, hzUz, hPreUz⟩ := h_loc_preirred z
            have hUzW₁ : (U_z ∩ W₁).Nonempty :=
              mem_closure_iff.mp hz_cl U_z hOpenUz hzUz
            refine ⟨U_z, ?_, hOpenUz, hzUz⟩
            intro y hyUz
            rw [mem_closure_iff]
            intro O hOpenO hyO
            obtain ⟨w, _, hwO, hwW₁⟩ :=
              hPreUz O W₁ hOpenO hW₁ ⟨y, hyUz, hyO⟩ hUzW₁
            exact ⟨w, hwO, hwW₁⟩
          have hCl_univ : closure W₁ = Set.univ :=
            IsClopen.eq_univ ⟨isClosed_closure, hOpenCl⟩ ⟨y₁, subset_closure hy₁⟩
          have hy₂_cl : y₂ ∈ closure W₁ := hCl_univ ▸ Set.mem_univ y₂
          obtain ⟨w, hwW₂, hwW₁⟩ := mem_closure_iff.mp hy₂_cl W₂ hW₂ hy₂
          exact ⟨w, Set.mem_univ w, hwW₁, hwW₂⟩
        toNonempty := ConnectedSpace.toNonempty }
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K := hSm
  have : AlgebraicGeometry.Smooth p_K := AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 p_K
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of K) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
  have : AlgebraicGeometry.Surjective s₀ :=
    ⟨fun x => ⟨Nonempty.some inferInstance, Subsingleton.elim _ x⟩⟩
  have : ConnectedSpace ↥(CategoryTheory.Limits.pullback p_K s₀) :=
    hConn (AlgebraicClosure K) s₀
  have : ConnectedSpace ↥C_K :=
    (CategoryTheory.Limits.pullback.fst p_K s₀).surjective.connectedSpace
      (CategoryTheory.Limits.pullback.fst p_K s₀).continuous
  have hIntCK : AlgebraicGeometry.IsIntegral C_K := (h_smooth_int K C_K p_K).2
  refine ⟨hIntCK, hn, inferInstance, hProp, inferInstance, hSurj, hSec, hDisj, ?_, ?_⟩
  · intro _ _
    exact ⟨⊤, trivial, Nat.zero_add 1 ▸
      @AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 _ _ (⊤ : C_K.Opens).ι _ p_K
        inferInstance inferInstance⟩
  · intro Ω _ _ s
    let p_Ω := CategoryTheory.Limits.pullback.snd p_K s
    let fst_Ω := CategoryTheory.Limits.pullback.fst p_K s
    have hConn_Ω : ConnectedSpace ↥(CategoryTheory.Limits.pullback p_K s) := hConn Ω s
    have hSm_Ω : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_Ω :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback p_K s) hSm
    refine ⟨hConn_Ω, ?_, ?_⟩
    · intro _
      exact Or.inl ⟨⊤, trivial, Nat.zero_add 1 ▸
        @AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 _ _
          (⊤ : (CategoryTheory.Limits.pullback p_K s).Opens).ι _ p_Ω inferInstance inferInstance⟩
    · intro E _E_sch _ιE hE_mem _hCl _hIntE _hRange _hP1
      have : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback p_K s) :=
        (h_smooth_int Ω (CategoryTheory.Limits.pullback p_K s) p_Ω).2
      have hIrred_Ω : IrreducibleSpace ↥(CategoryTheory.Limits.pullback p_K s) :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral _
      have hComp_Ω : irreducibleComponents ↥(CategoryTheory.Limits.pullback p_K s) = {Set.univ} :=
        @irreducibleComponents_eq_singleton _ _ hIrred_Ω
      have hE_univ : E = Set.univ := Set.mem_singleton_iff.mp (hComp_Ω ▸ hE_mem)
      have hcomm_Ω : ∀ j : Fin n,
          (s ≫ σ_K j) ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ≫ s := by
        intro j
        rw [CategoryTheory.Category.assoc, hSec j, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
      let τ_Ω : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          CategoryTheory.Limits.pullback p_K s) :=
        fun j => CategoryTheory.Limits.pullback.lift (s ≫ σ_K j) (𝟙 _) (hcomm_Ω j)
      have hτ_fst : ∀ (j : Fin n) (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
          fst_Ω.base ((τ_Ω j).base pt) = (σ_K j).base (s.base pt) := by
        intro j pt
        have hcomp : τ_Ω j ≫ fst_Ω = s ≫ σ_K j :=
          CategoryTheory.Limits.pullback.lift_fst (s ≫ σ_K j) (𝟙 _) (hcomm_Ω j)
        simpa [AlgebraicGeometry.Scheme.Hom.comp_apply] using
          congrArg (fun f => f.base pt) hcomp
      let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := Nonempty.some inferInstance
      have hτ_inj : ∀ {i j : Fin n}, i ≠ j → (τ_Ω i).base pt_Ω ≠ (τ_Ω j).base pt_Ω := by
        intro i j hij heq
        have hσ_eq : (σ_K i).base (s.base pt_Ω) = (σ_K j).base (s.base pt_Ω) := by
          rw [← hτ_fst i pt_Ω, ← hτ_fst j pt_Ω, heq]
        exact Set.disjoint_left.mp (hDisj hij)
          ⟨s.base pt_Ω, rfl⟩ ⟨s.base pt_Ω, hσ_eq.symm⟩
      let j₁ : Fin n := ⟨0, by omega⟩
      let j₂ : Fin n := ⟨1, by omega⟩
      let j₃ : Fin n := ⟨2, by omega⟩
      have hj₁₂ : j₁ ≠ j₂ := by intro h; have h01 : (0 : ℕ) = 1 := congrArg Fin.val h; omega
      have hj₁₃ : j₁ ≠ j₃ := by intro h; have h02 : (0 : ℕ) = 2 := congrArg Fin.val h; omega
      have hj₂₃ : j₂ ≠ j₃ := by intro h; have h12 : (1 : ℕ) = 2 := congrArg Fin.val h; omega
      refine ⟨(τ_Ω j₁).base pt_Ω, (τ_Ω j₂).base pt_Ω, (τ_Ω j₃).base pt_Ω,
        hτ_inj hj₁₂, hτ_inj hj₁₃, hτ_inj hj₂₃,
        hE_univ ▸ Set.mem_univ _, hE_univ ▸ Set.mem_univ _, hE_univ ▸ Set.mem_univ _, ?_⟩
      intro q hq
      rcases hq with rfl | rfl | rfl
      · exact Or.inr ⟨j₁, s.base pt_Ω, (hτ_fst j₁ pt_Ω).symm⟩
      · exact Or.inr ⟨j₂, s.base pt_Ω, (hτ_fst j₂ pt_Ω).symm⟩
      · exact Or.inr ⟨j₃, s.base pt_Ω, (hτ_fst j₃ pt_Ω).symm⟩

theorem weil_threeSecant_generic_smooth_curve_setup (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (hDimB₂ : topologicalKrullDim B₂.left = (m : WithBot ℕ∞))
    (hU₂ : Nonempty U₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX₂ : AlgebraicGeometry.IsIntegral X₂.left)
    (hProjX₂ : IsProjectiveOverField k X₂)
    (hDimX₂ : topologicalKrullDim X₂.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ) :
    ∃ (K₀ : Type u) (_ : Field K₀) (_ : Algebra k K₀)
      (η₀ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ B₂.left),
      η₀ ≫ B₂.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K₀)) ∧
      IsSchemeFunctionField B₂.left K₀ η₀ ∧
      ∃ (K : Type u) (_ : Field K) (_ : IsSepClosed K)
        (_ : Algebra k K) (_ : Algebra K₀ K) (_ : IsScalarTower k K₀ K) (_ : IsSepClosure K₀ K),
        Algebra.trdeg k K ≤ (m : Cardinal.{u}) ∧
        ∃ (C_K : AlgebraicGeometry.Scheme.{u})
          (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
          (ι_K : C_K ⟶ X₂.left)
          (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
          (M_K : ℕ)
          (ι_proj : C_K ⟶ (weilProjectiveSpaceOver K M_K).left)
          (F : Type u) (_ : Field F) (_ : Algebra k F) (_ : Algebra K F) (_ : IsScalarTower k K F)
          (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K),
          CategoryTheory.IsPullback ι_K p_K f₂.left
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀) ∧
          (∀ j : Fin n, σ_K j ≫ ι_K =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀ ≫ (σ j).left) ∧
          AlgebraicGeometry.IsIntegral C_K ∧
          AlgebraicGeometry.IsProper p_K ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K ∧
          IsGeometricStablePointedCurve p_K n σ_K ∧
          AlgebraicGeometry.IsClosedImmersion ι_proj ∧
          ι_proj ≫ (weilProjectiveSpaceOver K M_K).hom = p_K ∧
          η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)) ∧
          IsSchemeFunctionField C_K F η_F :=
by
  obtain ⟨K₀, instFieldK₀, instAlgkK₀, η₀, hη₀_hom, hFuncK₀, hη₀_open⟩ :=
    weil_integral_scheme_functionField_over_field k B₂.left hIntB₂ B₂.hom
  let : Field K₀ := instFieldK₀
  let : Algebra k K₀ := instAlgkK₀
  obtain ⟨K, instFieldK, instSepClosedK, instAlgkK, instAlgK₀K, instTowerkK₀K, instSepClosK₀K, hTrK⟩ :=
    weil_projective_integral_sepClosure_trdeg_le k m B₂ hIntB₂ hProjB₂ hDimB₂ K₀ η₀ hη₀_hom hFuncK₀
  let : Field K := instFieldK
  have : IsSepClosed K := instSepClosedK
  let : Algebra k K := instAlgkK
  let : Algebra K₀ K := instAlgK₀K
  have : IsScalarTower k K₀ K := instTowerkK₀K
  have : IsSepClosure K₀ K := instSepClosK₀K
  have hProjXK : IsProjectiveOverField K (weilBaseChangeOver k K X₂) :=
    weil_isProjectiveOverField_baseChange k K X₂ hProjX₂
  let η_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ B₂.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀
  have hηK_hom : η_K ≫ B₂.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K)) := by
    dsimp [η_K]
    rw [CategoryTheory.Category.assoc, hη₀_hom, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq k K₀ K]
  have hηK_mem : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)), η_K.base pt ∈ U₂ := by
    intro pt
    simpa [η_K] using hη₀_open U₂ hU₂
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K))).base pt)
  obtain ⟨C_K, p_K, ι_K, σ_K, M_K, ι_proj,
      hPbK, hSecK, hσK, hDisjK, hPropCK, hSurjCK, hSmCK, hConnCK, hClProj, hProjComm⟩ :=
    weil_generic_fiber_curve_pullback_and_proj_embedding k B₂ X₂ U₂ hProjB₂ f₂ n σ hFib₂
      K hProjXK η_K hηK_hom hηK_mem
  obtain ⟨hIntCK, hStabCK⟩ :=
    weil_smooth_threeSecant_curve_over_field_integral_and_stable K C_K p_K n σ_K
      hFib₂.1 hPropCK hSurjCK hSmCK hSecK hDisjK hConnCK
  obtain ⟨F, instFieldF, instAlgKF, η_F, hηF_comm, hFuncF, _⟩ :=
    weil_integral_scheme_functionField_over_field K C_K hIntCK p_K
  let : Field F := instFieldF
  let : Algebra K F := instAlgKF
  let : Algebra k F := ((algebraMap K F).comp (algebraMap k K)).toAlgebra
  have : IsScalarTower k K F := IsScalarTower.of_algebraMap_eq' rfl
  exact ⟨K₀, instFieldK₀, instAlgkK₀, η₀, hη₀_hom, hFuncK₀,
    K, instFieldK, instSepClosedK, instAlgkK, instAlgK₀K, instTowerkK₀K, instSepClosK₀K, hTrK,
    C_K, p_K, ι_K, σ_K, M_K, ι_proj,
    F, instFieldF, inferInstance, instAlgKF, inferInstance, η_F,
    hPbK, fun j => (hσK j).trans (CategoryTheory.Category.assoc _ _ _),
    hIntCK, hPropCK, hSmCK, hStabCK, hClProj, hProjComm, hηF_comm, hFuncF⟩

theorem weil_valuationSubring_abhyankar_primeSpectrum_bound (k₀ E : Type u) [Field k₀] [Field E] [Algebra k₀ E] (d : ℕ)
    (hTr : Algebra.trdeg k₀ E ≤ (d : Cardinal.{u}))
    (V : ValuationSubring E)
    (hkV : ∀ c : k₀, algebraMap k₀ E c ∈ V) :
    Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) ∧
    Nat.card (PrimeSpectrum ↥V) ≤ d + 1 :=
by
  have hNoChain : ∀ P : Fin (d + 2) → PrimeSpectrum ↥V, ¬ StrictMono P := by
    intro P hP
    let n : ℕ := d + 1
    
    have hex : ∀ i : Fin n, ∃ a : ↥V, a ∈ (P i.succ).asIdeal ∧ a ∉ (P i.castSucc).asIdeal := by
      intro i
      have hlt : (P i.castSucc).asIdeal < (P i.succ).asIdeal :=
        (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr (hP Fin.castSucc_lt_succ)
      have hnle : ¬ ((P i.succ).asIdeal : Set ↥V) ⊆ ((P i.castSucc).asIdeal : Set ↥V) :=
        fun hsub => not_le_of_gt hlt hsub
      exact Set.not_subset.mp hnle
    let a : Fin n → ↥V := fun i => Classical.choose (hex i)
    have ha_mem : ∀ i : Fin n, a i ∈ (P i.succ).asIdeal :=
      fun i => (Classical.choose_spec (hex i)).1
    have ha_nmem : ∀ i : Fin n, a i ∉ (P i.castSucc).asIdeal :=
      fun i => (Classical.choose_spec (hex i)).2
    let x : Fin n → E := fun i => (a i : E)
    let v : Valuation E V.ValueGroup := V.valuation
    have hx_ne : ∀ i : Fin n, x i ≠ 0 := by
      intro i h0
      have ha0 : a i = 0 := Subtype.ext h0
      exact ha_nmem i (ha0 ▸ Ideal.zero_mem _)
    have hx_bounds : ∀ i : Fin n, 0 < v (x i) ∧ v (x i) < 1 := by
      intro i
      refine ⟨(Valuation.pos_iff v).mpr (hx_ne i), ?_⟩
      rcases ValuationSubring.valuation_lt_one_or_eq_one V (a i) with hlt | heq
      · exact hlt
      · exfalso
        have hinv_le : v ((x i)⁻¹) ≤ 1 := by
          rw [map_inv₀, heq, inv_one]
        have hinv_mem : (x i)⁻¹ ∈ V := (ValuationSubring.valuation_le_one_iff V _).mp hinv_le
        let b : ↥V := ⟨(x i)⁻¹, hinv_mem⟩
        have hab : a i * b = 1 := Subtype.ext (mul_inv_cancel₀ (hx_ne i))
        have h1_mem : (1 : ↥V) ∈ (P i.succ).asIdeal :=
          hab ▸ Ideal.mul_mem_right b (P i.succ).asIdeal (ha_mem i)
        exact (P i.succ).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
    have hx_sep : ∀ (i j : Fin n), i < j → ∀ N : ℕ, v (x i) < v (x j) ^ N := by
      intro i j hij N
      by_contra h_not_lt
      have h_le : v (x j) ^ N ≤ v (x i) := not_lt.mp h_not_lt
      have hv_ne : v (x i) ≠ 0 := (Valuation.ne_zero_iff v).mpr (hx_ne i)
      have hq_le : v ((x j) ^ N * (x i)⁻¹) ≤ 1 := by
        rw [map_mul, map_pow, map_inv₀]
        calc v (x j) ^ N * (v (x i))⁻¹
            ≤ v (x i) * (v (x i))⁻¹ := mul_le_mul' h_le le_rfl
          _ = 1 := mul_inv_cancel₀ hv_ne
      have hq_mem : (x j) ^ N * (x i)⁻¹ ∈ V :=
        (ValuationSubring.valuation_le_one_iff V _).mp hq_le
      let q : ↥V := ⟨(x j) ^ N * (x i)⁻¹, hq_mem⟩
      have haj_eq : (a j) ^ N = a i * q := by
        apply Subtype.ext
        push_cast
        change (x j) ^ N = x i * ((x j) ^ N * (x i)⁻¹)
        calc (x j) ^ N = (x j) ^ N * (x i * (x i)⁻¹) := by rw [mul_inv_cancel₀ (hx_ne i), mul_one]
          _ = x i * ((x j) ^ N * (x i)⁻¹) := by ring
      have haj_pow_succ : (a j) ^ N ∈ (P i.succ).asIdeal :=
        haj_eq ▸ Ideal.mul_mem_right q (P i.succ).asIdeal (ha_mem i)
      have h_idx_le : i.succ ≤ j.castSucc := Fin.succ_le_castSucc_iff.mpr hij
      have h_ideal_le : (P i.succ).asIdeal ≤ (P j.castSucc).asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (hP.monotone h_idx_le)
      have haj_pow_cast : (a j) ^ N ∈ (P j.castSucc).asIdeal := h_ideal_le haj_pow_succ
      have haj_mem : a j ∈ (P j.castSucc).asIdeal :=
        (P j.castSucc).isPrime.mem_of_pow_mem N haj_pow_cast
      exact ha_nmem j haj_mem
    
    have hk₀ : ∀ c : k₀, v (algebraMap k₀ E c) ≤ 1 :=
      fun c => (ValuationSubring.valuation_le_one_iff V _).mpr (hkV c)
    have hv_scalar : ∀ c : k₀, c ≠ 0 → v (algebraMap k₀ E c) = 1 := by
      intro c hc
      apply le_antisymm (hk₀ c)
      have h1 : (1 : V.ValueGroup) = v (algebraMap k₀ E c) * v (algebraMap k₀ E c⁻¹) := by
        rw [← map_mul, ← map_mul, mul_inv_cancel₀ hc, map_one, map_one]
      calc (1 : V.ValueGroup)
          = v (algebraMap k₀ E c) * v (algebraMap k₀ E c⁻¹) := h1
        _ ≤ v (algebraMap k₀ E c) * 1 := mul_le_mul' le_rfl (hk₀ c⁻¹)
        _ = v (algebraMap k₀ E c) := mul_one _
    let γ : Fin n → V.ValueGroup := fun i => v (x i)
    let monVal : (Fin n →₀ ℕ) → V.ValueGroup := fun μ => ∏ i : Fin n, (γ i) ^ (μ i)
    have h_prod_pos : ∀ (S : Finset (Fin n)) (f : Fin n → ℕ),
        0 < ∏ i ∈ S, (γ i) ^ (f i) := by
      intro S f
      rw [zero_lt_iff, Finset.prod_ne_zero_iff]
      intro i _
      exact pow_ne_zero (f i) (ne_of_gt (hx_bounds i).1)
    have h_lex_lt : ∀ (μ ν : Fin n →₀ ℕ) (i₀ : Fin n),
        (∀ i : Fin n, i < i₀ → μ i = ν i) → ν i₀ < μ i₀ → monVal μ < monVal ν := by
      intro μ ν i₀ h_eq_lt h_gt
      let L : Finset (Fin n) := Finset.univ.filter (fun j : Fin n => j ≤ i₀)
      let U : Finset (Fin n) := Finset.univ.filter (fun j : Fin n => ¬ j ≤ i₀)
      have hi₀_L : i₀ ∈ L := Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, le_rfl⟩
      have h_decomp : ∀ f : Fin n → ℕ,
          (∏ j : Fin n, (γ j) ^ (f j)) =
            ((γ i₀) ^ (f i₀) * ∏ j ∈ L \ {i₀}, (γ j) ^ (f j)) * ∏ j ∈ U, (γ j) ^ (f j) := by
        intro f
        rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun j : Fin n => j ≤ i₀)
          (fun j => (γ j) ^ (f j))]
        congr 1
        exact Finset.prod_eq_mul_prod_sdiff_singleton i₀ (fun j => (γ j) ^ (f j))
          (fun h => absurd hi₀_L h)
      have h_pre_eq : (∏ j ∈ L \ {i₀}, (γ j) ^ (μ j)) = ∏ j ∈ L \ {i₀}, (γ j) ^ (ν j) := by
        apply Finset.prod_congr rfl
        intro j hj
        have hj_le : j ≤ i₀ := (Finset.mem_filter.mp (Finset.mem_sdiff.mp hj).1).2
        have hj_ne : j ≠ i₀ := by
          intro h_eq
          exact (Finset.mem_sdiff.mp hj).2 (Finset.mem_singleton.mpr h_eq)
        rw [h_eq_lt j (lt_of_le_of_ne hj_le hj_ne)]
      have h_i₀_pow : (γ i₀) ^ (μ i₀) ≤ (γ i₀) ^ (ν i₀) * (γ i₀) := by
        have h_exp : μ i₀ = (ν i₀ + 1) + (μ i₀ - (ν i₀ + 1)) := by omega
        rw [h_exp, pow_add, pow_add, pow_one]
        calc ((γ i₀) ^ (ν i₀) * (γ i₀)) * (γ i₀) ^ (μ i₀ - (ν i₀ + 1))
            ≤ ((γ i₀) ^ (ν i₀) * (γ i₀)) * 1 :=
              mul_le_mul' le_rfl (pow_le_one' (le_of_lt (hx_bounds i₀).2) _)
          _ = (γ i₀) ^ (ν i₀) * (γ i₀) := mul_one _
      let K_neg : Finset (Fin n) := U.filter (fun j : Fin n => μ j < ν j)
      let K_pos : Finset (Fin n) := U.filter (fun j : Fin n => ¬ μ j < ν j)
      have h_U_decomp : ∀ f : Fin n → ℕ,
          (∏ j ∈ U, (γ j) ^ (f j)) =
            (∏ j ∈ K_neg, (γ j) ^ (f j)) * ∏ j ∈ K_pos, (γ j) ^ (f j) :=
        fun f => (Finset.prod_filter_mul_prod_filter_not U (fun j : Fin n => μ j < ν j)
          (fun j => (γ j) ^ (f j))).symm
      have h_pos_le : (∏ j ∈ K_pos, (γ j) ^ (μ j)) ≤ ∏ j ∈ K_pos, (γ j) ^ (ν j) := by
        apply Finset.prod_le_prod
        intro j hj
        have h_le_exp : ν j ≤ μ j := not_lt.mp (Finset.mem_filter.mp hj).2
        have h_exp : μ j = ν j + (μ j - ν j) := (Nat.add_sub_of_le h_le_exp).symm
        rw [h_exp, pow_add]
        calc (γ j) ^ (ν j) * (γ j) ^ (μ j - ν j)
            ≤ (γ j) ^ (ν j) * 1 :=
              mul_le_mul' le_rfl (pow_le_one' (le_of_lt (hx_bounds j).2) _)
          _ = (γ j) ^ (ν j) := mul_one _
      have h_neg_lt : (γ i₀) * (∏ j ∈ K_neg, (γ j) ^ (μ j)) < ∏ j ∈ K_neg, (γ j) ^ (ν j) := by
        by_cases hK : K_neg.Nonempty
        · let j_star : Fin n := K_neg.min' hK
          let M : ℕ := ∑ j ∈ K_neg, (ν j - μ j)
          have hj_star_mem : j_star ∈ K_neg := Finset.min'_mem K_neg hK
          have hj_star_U : j_star ∈ U := (Finset.mem_filter.mp hj_star_mem).1
          have hi₀_lt_j : i₀ < j_star := not_le.mp (Finset.mem_filter.mp hj_star_U).2
          have h_sep_M : γ i₀ < (γ j_star) ^ M := hx_sep i₀ j_star hi₀_lt_j M
          have h_step1 : (γ i₀) * (∏ j ∈ K_neg, (γ j) ^ (μ j)) <
              (γ j_star) ^ M * (∏ j ∈ K_neg, (γ j) ^ (μ j)) :=
            mul_lt_mul_of_pos_right h_sep_M (h_prod_pos K_neg μ)
          have h_step2 : (γ j_star) ^ M * (∏ j ∈ K_neg, (γ j) ^ (μ j)) =
              ∏ j ∈ K_neg, ((γ j_star) ^ (ν j - μ j) * (γ j) ^ (μ j)) := by
            rw [← Finset.prod_pow_eq_pow_sum K_neg (fun j => ν j - μ j) (γ j_star),
              ← Finset.prod_mul_distrib]
          have h_step3 : (∏ j ∈ K_neg, ((γ j_star) ^ (ν j - μ j) * (γ j) ^ (μ j))) ≤
              ∏ j ∈ K_neg, (γ j) ^ (ν j) := by
            apply Finset.prod_le_prod
            intro j hj
            have hj_ge : j_star ≤ j := Finset.min'_le K_neg j hj
            have hγ_le : γ j_star ≤ γ j := by
              rcases eq_or_lt_of_le hj_ge with rfl | hj_lt
              · exact le_rfl
              · have h1 := hx_sep j_star j hj_lt 1
                rw [pow_one] at h1
                exact le_of_lt h1
            have hj_exp_lt : μ j < ν j := (Finset.mem_filter.mp hj).2
            calc (γ j_star) ^ (ν j - μ j) * (γ j) ^ (μ j)
                ≤ (γ j) ^ (ν j - μ j) * (γ j) ^ (μ j) :=
                  mul_le_mul' (pow_le_pow_left' hγ_le _) le_rfl
              _ = (γ j) ^ (ν j - μ j + μ j) := (pow_add _ _ _).symm
              _ = (γ j) ^ (ν j) := by rw [Nat.sub_add_cancel (le_of_lt hj_exp_lt)]
          exact lt_of_lt_of_le (h_step2 ▸ h_step1) h_step3
        · have hK_empty : K_neg = ∅ := Finset.not_nonempty_iff_eq_empty.mp hK
          rw [hK_empty, Finset.prod_empty, mul_one]
          exact (hx_bounds i₀).2
      have h_U_lt : (γ i₀) * (∏ j ∈ U, (γ j) ^ (μ j)) < ∏ j ∈ U, (γ j) ^ (ν j) := by
        rw [h_U_decomp μ, h_U_decomp ν, ← mul_assoc]
        calc ((γ i₀) * ∏ j ∈ K_neg, (γ j) ^ (μ j)) * ∏ j ∈ K_pos, (γ j) ^ (μ j)
            < (∏ j ∈ K_neg, (γ j) ^ (ν j)) * ∏ j ∈ K_pos, (γ j) ^ (μ j) :=
              mul_lt_mul_of_pos_right h_neg_lt (h_prod_pos K_pos μ)
          _ ≤ (∏ j ∈ K_neg, (γ j) ^ (ν j)) * ∏ j ∈ K_pos, (γ j) ^ (ν j) :=
              mul_le_mul' le_rfl h_pos_le
      let P_pre : V.ValueGroup := ∏ j ∈ L \ {i₀}, (γ j) ^ (ν j)
      have h_pre_factor_pos : 0 < (γ i₀) ^ (ν i₀) * P_pre := by
        rw [zero_lt_iff]
        exact mul_ne_zero (pow_ne_zero _ (ne_of_gt (hx_bounds i₀).1))
          (ne_of_gt (h_prod_pos (L \ {i₀}) ν))
      change (∏ j : Fin n, (γ j) ^ (μ j)) < ∏ j : Fin n, (γ j) ^ (ν j)
      rw [h_decomp μ, h_decomp ν, h_pre_eq]
      change ((γ i₀) ^ (μ i₀) * P_pre) * (∏ j ∈ U, (γ j) ^ (μ j)) <
        ((γ i₀) ^ (ν i₀) * P_pre) * (∏ j ∈ U, (γ j) ^ (ν j))
      calc ((γ i₀) ^ (μ i₀) * P_pre) * (∏ j ∈ U, (γ j) ^ (μ j))
          ≤ (((γ i₀) ^ (ν i₀) * (γ i₀)) * P_pre) * (∏ j ∈ U, (γ j) ^ (μ j)) :=
            mul_le_mul' (mul_le_mul' h_i₀_pow le_rfl) le_rfl
        _ = ((γ i₀) ^ (ν i₀) * P_pre) * ((γ i₀) * ∏ j ∈ U, (γ j) ^ (μ j)) := by
            rw [mul_right_comm ((γ i₀) ^ (ν i₀)) (γ i₀) P_pre, mul_assoc]
        _ < ((γ i₀) ^ (ν i₀) * P_pre) * (∏ j ∈ U, (γ j) ^ (ν j)) :=
            mul_lt_mul_of_pos_left h_U_lt h_pre_factor_pos
    have h_mon_ne : ∀ μ ν : Fin n →₀ ℕ, μ ≠ ν → monVal μ ≠ monVal ν := by
      intro μ ν h_ne
      have hex_diff : ∃ i : Fin n, μ i ≠ ν i :=
        not_forall.mp (fun h_all => h_ne (Finsupp.ext h_all))
      let S_diff : Finset (Fin n) := Finset.univ.filter (fun i : Fin n => μ i ≠ ν i)
      have hS_ne : S_diff.Nonempty := by
        rcases hex_diff with ⟨i, hi⟩
        exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
      let i₀ : Fin n := S_diff.min' hS_ne
      have hi₀_ne : μ i₀ ≠ ν i₀ := (Finset.mem_filter.mp (Finset.min'_mem S_diff hS_ne)).2
      have hi₀_min : ∀ i : Fin n, i < i₀ → μ i = ν i := by
        intro i hi
        by_contra hi_ne
        have hi_mem : i ∈ S_diff := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi_ne⟩
        exact not_le_of_gt hi (Finset.min'_le S_diff i hi_mem)
      rcases lt_or_gt_of_ne hi₀_ne with h_lt | h_gt
      · exact ne_of_gt (h_lex_lt ν μ i₀ (fun i hi => (hi₀_min i hi).symm) h_lt)
      · exact ne_of_lt (h_lex_lt μ ν i₀ hi₀_min h_gt)
    have hIndep : AlgebraicIndependent k₀ x := by
      rw [algebraicIndependent_iff]
      intro p hp_eval
      by_contra hp_ne
      have hp_supp : p.support.Nonempty := MvPolynomial.support_nonempty.mpr hp_ne
      let term : (Fin n →₀ ℕ) → E :=
        fun μ => algebraMap k₀ E (p.coeff μ) * ∏ i : Fin n, (x i) ^ (μ i)
      have h_sum_zero : ∑ μ ∈ p.support, term μ = 0 := by
        have heval : MvPolynomial.aeval x p = ∑ μ ∈ p.support, term μ := by
          rw [MvPolynomial.aeval_eq_eval₂Hom, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_eq']
        exact heval.symm.trans hp_eval
      have hv_term : ∀ μ ∈ p.support, v (term μ) = monVal μ := by
        intro μ hμ
        have hc_ne : p.coeff μ ≠ 0 := MvPolynomial.mem_support_iff.mp hμ
        dsimp only [term, monVal, γ]
        rw [map_mul, hv_scalar _ hc_ne, one_mul, map_prod]
        apply Finset.prod_congr rfl
        intro i _
        exact map_pow v (x i) (μ i)
      obtain ⟨μ_max, hμ_max_mem, hμ_max_ge⟩ :=
        Finset.exists_max_image p.support (fun μ => v (term μ)) hp_supp
      have h_strict_lt : ∀ μ ∈ p.support \ {μ_max}, v (term μ) < v (term μ_max) := by
        intro μ hμ_sdiff
        have hμ_mem : μ ∈ p.support := (Finset.mem_sdiff.mp hμ_sdiff).1
        have hμ_ne : μ ≠ μ_max := by
          intro h_eq
          exact (Finset.mem_sdiff.mp hμ_sdiff).2 (Finset.mem_singleton.mpr h_eq)
        have h_le : v (term μ) ≤ v (term μ_max) := hμ_max_ge μ hμ_mem
        have h_val_ne : v (term μ) ≠ v (term μ_max) := by
          rw [hv_term μ hμ_mem, hv_term μ_max hμ_max_mem]
          exact h_mon_ne μ μ_max hμ_ne
        exact lt_of_le_of_ne h_le h_val_ne
      have hv_sum : v (∑ μ ∈ p.support, term μ) = v (term μ_max) :=
        Valuation.map_sum_eq_of_lt v hμ_max_mem h_strict_lt
      rw [h_sum_zero, Valuation.map_zero, hv_term μ_max hμ_max_mem] at hv_sum
      exact (ne_of_gt (h_prod_pos Finset.univ μ_max)) hv_sum.symm
    
    have hCard := AlgebraicIndependent.lift_cardinalMk_le_trdeg hIndep
    rw [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at hCard
    have h_nat_le : n ≤ d := (Nat.cast_le (α := Cardinal.{u})).mp (le_trans hCard hTr)
    omega
  
  have hNoInj : ∀ g : Fin (d + 2) → PrimeSpectrum ↥V, ¬ Function.Injective g := by
    intro g hg
    let r : PrimeSpectrum ↥V → PrimeSpectrum ↥V → Prop := (· ≤ ·)
    let _ : DecidableRel r := Classical.decRel r
    have _ : Std.Total r := ⟨fun p q => by
      rcases (ValuationRing.le_total_ideal ↥V).total p.asIdeal q.asIdeal with hpq | hqp
      · exact Or.inl ((PrimeSpectrum.asIdeal_le_asIdeal p q).mp hpq)
      · exact Or.inr ((PrimeSpectrum.asIdeal_le_asIdeal q p).mp hqp)⟩
    let l : List (PrimeSpectrum ↥V) := List.insertionSort r (List.ofFn g)
    have hlen : l.length = d + 2 :=
      (List.length_insertionSort r (List.ofFn g)).trans List.length_ofFn
    have hpw : List.Pairwise r l := List.pairwise_insertionSort r (List.ofFn g)
    have hnd : l.Nodup :=
      (List.perm_insertionSort r (List.ofFn g)).nodup_iff.mpr (List.nodup_ofFn.mpr hg)
    let P : Fin (d + 2) → PrimeSpectrum ↥V := fun i => l.get (Fin.cast hlen.symm i)
    have hP_strict : StrictMono P := by
      intro i j hij
      let i' : Fin l.length := Fin.cast hlen.symm i
      let j' : Fin l.length := Fin.cast hlen.symm j
      have hi'j' : i' < j' := hij
      have h_le : P i ≤ P j := List.pairwise_iff_get.mp hpw i' j' hi'j'
      have h_ne : P i ≠ P j := (List.nodup_iff_injective_get.mp hnd).ne (ne_of_lt hi'j')
      exact lt_of_le_of_ne h_le h_ne
    exact hNoChain P hP_strict
  have hFin : Finite (PrimeSpectrum ↥V) := by
    by_contra hNotFin
    have _ : Infinite (PrimeSpectrum ↥V) := not_finite_iff_infinite.mp hNotFin
    let g : Fin (d + 2) → PrimeSpectrum ↥V :=
      fun i => Infinite.natEmbedding (PrimeSpectrum ↥V) i.val
    have hg : Function.Injective g :=
      (Infinite.natEmbedding (PrimeSpectrum ↥V)).injective.comp Fin.val_injective
    exact hNoInj g hg
  refine ⟨Set.finite_univ, ?_⟩
  let _ : Fintype (PrimeSpectrum ↥V) := Fintype.ofFinite (PrimeSpectrum ↥V)
  rw [Nat.card_eq_fintype_card]
  by_contra hNotLe
  have hCardGe : Fintype.card (Fin (d + 2)) ≤ Fintype.card (PrimeSpectrum ↥V) := by
    rw [Fintype.card_fin]
    omega
  obtain ⟨emb⟩ := Function.Embedding.nonempty_of_card_le hCardGe
  exact hNoInj emb emb.injective

theorem weil_smooth_proper_curve_unbounded_and_funcField (k : Type u) [Field k] (m : ℕ)
    (K : Type u) [Field K] [IsSepClosed K] [Algebra k K]
    (hTrK : Algebra.trdeg k K ≤ (m : Cardinal.{u}))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (F : Type u) [Field F] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F) :
    Algebra.trdeg k F ≤ ((m + 1 : ℕ) : Cardinal.{u}) ∧
    (∃ (x_sep : F), Transcendental K x_sep ∧
      let L0 := IntermediateField.adjoin K ({x_sep} : Set F)
      FiniteDimensional ↥L0 F ∧ Algebra.IsSeparable ↥L0 F) ∧
    (∀ (O_rel : ValuationSubring F), O_rel ≠ ⊤ → (∀ a : K, algebraMap K F a ∈ O_rel) →
      ∃ (x₀ : F), Transcendental K x₀ ∧
        let Lx₀ := IntermediateField.adjoin K ({x₀} : Set F)
        let Ox₀ := O_rel.comap Lx₀.val.toRingHom
        RingHom.Etale ((Lx₀.val.toRingHom.comp Ox₀.subtype).codRestrict O_rel.toSubring (fun y => y.2)) ∧
        (∀ w : F, w ∈ O_rel → ∃ u : ↥Lx₀, (u : F) ∈ O_rel ∧ (w - (u : F) = 0 ∨ (w - (u : F))⁻¹ ∉ O_rel))) :=
by
  have h_chart : ∀ (K : Type u) [Field K]
      (C_K : AlgebraicGeometry.Scheme.{u})
      (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (_ : AlgebraicGeometry.IsIntegral C_K)
      (_ : AlgebraicGeometry.IsProper p_K)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
      (F : Type u) [Field F] [Algebra K F]
      (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
      (_ : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
      (_ : IsSchemeFunctionField C_K F η_F)
      (O_rel : ValuationSubring F)
      (_ : ∀ a : K, algebraMap K F a ∈ O_rel),
      ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R)
        (_ : Algebra K R) (_ : Algebra R F) (_ : IsScalarTower K R F) (_ : IsFractionRing R F)
        (ψ : Polynomial K →ₐ[K] R),
        ψ.toRingHom.Etale ∧
        (∀ r : R, algebraMap R F r ∈ O_rel) := by
    clear! k m K C_K F
    intro K _ C_K p_K hIntCK hPropCK hSmCK F _ _ η_F hηF_comm hFuncF O_rel hKO
    haveI := hIntCK
    haveI := hPropCK
    haveI := hSmCK
    have hValEx : AlgebraicGeometry.ValuativeCriterion.Existence p_K :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap p_K
        (CategoryTheory.MorphismProperty.universally_mono
          (fun _ _ _ hg => IsClosedMap.specializingMap hg) p_K
          ((AlgebraicGeometry.universallyClosed_iff p_K).mp inferInstance))
    let φ_KO : K →+* ↥O_rel :=
      { toFun := fun a => ⟨algebraMap K F a, hKO a⟩
        map_one' := Subtype.ext (map_one _)
        map_mul' := fun _ _ => Subtype.ext (map_mul _ _ _)
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun _ _ => Subtype.ext (map_add _ _ _) }
    have hφ_KO_comp : (algebraMap ↥O_rel F).comp φ_KO = algebraMap K F := by
      ext a
      rfl
    have hCommSq : CategoryTheory.CommSq η_F
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥O_rel F)))
        p_K
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_KO)) := by
      refine ⟨?_⟩
      rw [hηF_comm, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_KO_comp]
    let sq_O : AlgebraicGeometry.ValuativeCommSq p_K :=
      AlgebraicGeometry.ValuativeCommSq.mk ↥O_rel F η_F
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_KO)) hCommSq
    obtain ⟨⟨η_O, hηO_top, _⟩⟩ := (hValEx sq_O).exists_lift
    let m_O : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥O_rel)) := IsLocalRing.closedPoint ↥O_rel
    let z : ↥C_K := η_O.base m_O
    obtain ⟨UB, hAffUB, Vx, hAffVx, hz, eVx, hStd⟩ :=
      AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
        (n := 1) (f := p_K) z
    have hVx_ne : Nonempty ↥Vx := ⟨⟨z, hz⟩⟩
    let R_cat : CommRingCat.{u} := C_K.presheaf.obj (Opposite.op Vx)
    let R : Type u := ↑R_cat
    haveI : IsDomain R := @AlgebraicGeometry.IsIntegral.component_integral C_K hIntCK Vx hVx_ne
    obtain ⟨φ_V, hFrac_V, hSpec_V⟩ := hFuncF Vx hAffVx hVx_ne
    letI algRF : Algebra R F := φ_V.hom.toAlgebra
    haveI : IsFractionRing R F := hFrac_V
    let α_K : CommRingCat.of K ⟶ R_cat :=
      AlgebraicGeometry.Spec.preimage (hAffVx.fromSpec ≫ p_K)
    letI algKR : Algebra K R := α_K.hom.toAlgebra
    have hα_φ : α_K ≫ φ_V = CommRingCat.ofHom (algebraMap K F) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        ← CategoryTheory.Category.assoc, hSpec_V, hηF_comm]
    haveI : IsScalarTower K R F := by
      apply IsScalarTower.of_algebraMap_eq
      intro c
      exact congrArg (fun (f : CommRingCat.of K ⟶ CommRingCat.of F) => f.hom c) hα_φ.symm
    have hmO_mem : m_O ∈ (TopologicalSpace.Opens.map η_O.base).obj Vx := hz
    have hPre_top : (TopologicalSpace.Opens.map η_O.base).obj Vx = ⊤ :=
      (IsLocalRing.closedPoint_mem_iff ((TopologicalSpace.Opens.map η_O.base).obj Vx)).mp hmO_mem
    have hRange : Set.range ⇑η_O ⊆ Set.range ⇑Vx.ι := by
