                      ring
                _ = a * EuclideanDomain.gcdA a b + b * EuclideanDomain.gcdB a b := by
                      rw [← ha₁, ← hb₁]
                _ = d := (EuclideanDomain.gcd_eq_gcd_ab a b).symm
                _ = d * 1 := (mul_one d).symm
            have hd_eval_ne : Polynomial.aeval x₀ d ≠ 0 :=
              fun h0 => hd_ne (haeval_inj (h0.trans (map_zero _).symm))
            have hb₁_eval_ne : Polynomial.aeval x₀ b₁ ≠ 0 :=
              fun h0 => hb₁_ne (haeval_inj (h0.trans (map_zero _).symm))
            have hz_mul : z * ι_PO b₁ = ι_PO a₁ := by
              apply Subtype.ext
              apply Subtype.ext
              change z.1.1 * Polynomial.aeval x₀ b₁ = Polynomial.aeval x₀ a₁
              have ha_eval : Polynomial.aeval x₀ a = Polynomial.aeval x₀ d * Polynomial.aeval x₀ a₁ := by
                conv_lhs => rw [ha₁]
                exact map_mul _ d a₁
              have hb_eval : Polynomial.aeval x₀ b = Polynomial.aeval x₀ d * Polynomial.aeval x₀ b₁ := by
                conv_lhs => rw [hb₁]
                exact map_mul _ d b₁
              have hdiv : z.1.1 = Polynomial.aeval x₀ a₁ / Polynomial.aeval x₀ b₁ := by
                rw [hab, ha_eval, hb_eval, mul_div_mul_left _ _ hd_eval_ne]
              rw [hdiv, div_mul_cancel₀ _ hb₁_eval_ne]
            have hb₁_not_p₀ : b₁ ∉ p₀ := by
              intro hb₁_mem
              have hιb₁_max : ι_PO b₁ ∈ IsLocalRing.maximalIdeal ↥Ox₀ := hb₁_mem
              have hιa₁_max : ι_PO a₁ ∈ IsLocalRing.maximalIdeal ↥Ox₀ := by
                rw [← hz_mul]
                exact (IsLocalRing.maximalIdeal ↥Ox₀).mul_mem_left z hιb₁_max
              have ha₁_mem : a₁ ∈ p₀ := hιa₁_max
              have h1_mem : (1 : P) ∈ p₀ := by
                rw [← hBez]
                exact p₀.add_mem (p₀.mul_mem_right _ ha₁_mem) (p₀.mul_mem_right _ hb₁_mem)
              exact hp₀_prime.ne_top (p₀.eq_top_iff_one.mpr h1_mem)
            exact ⟨(a₁, ⟨b₁, hb₁_not_p₀⟩), hz_mul⟩
        exists_of_eq := by
          intro f₁ f₂ hf
          exact ⟨1, by rw [hιPO_inj hf]⟩ }
    haveI : IsNoetherianRing ↥Ox₀ :=
      IsLocalization.isNoetherianRing p₀.primeCompl ↥Ox₀ inferInstance
    let ϖ₀ : ↥Ox₀ := ι_PO π₀
    have hϖ₀_ne : ϖ₀ ≠ 0 := fun h0 => hπ₀_ne (hιPO_inj (h0.trans (map_zero _).symm))
    have hϖ₀_mem_max : ϖ₀ ∈ IsLocalRing.maximalIdeal ↥Ox₀ := by
      change π₀ ∈ p₀
      rw [← hπ₀_span]
      exact Ideal.subset_span rfl
    have hMax_Ox₀ : IsLocalRing.maximalIdeal ↥Ox₀ = Ideal.span {ϖ₀} := by
      apply le_antisymm
      · intro z hz
        obtain ⟨⟨f, s⟩, hfs⟩ := IsLocalization.surj p₀.primeCompl z
        dsimp only at hfs
        change z * ι_PO s.1 = ι_PO f at hfs
        have hs_unit : IsUnit (ι_PO s.1) := IsLocalization.map_units ↥Ox₀ s
        have hf_mem : f ∈ p₀ := by
          change ι_PO f ∈ IsLocalRing.maximalIdeal ↥Ox₀
          rw [← hfs]
          exact (IsLocalRing.maximalIdeal ↥Ox₀).mul_mem_right _ hz
        rw [← hπ₀_span, Ideal.mem_span_singleton] at hf_mem
        obtain ⟨q, rfl⟩ := hf_mem
        obtain ⟨u_s, hu_s⟩ := hs_unit.exists_right_inv
        rw [Ideal.mem_span_singleton]
        refine ⟨ι_PO q * u_s, ?_⟩
        calc
          z = z * 1 := (mul_one z).symm
          _ = z * (ι_PO s.1 * u_s) := by rw [hu_s]
          _ = (z * ι_PO s.1) * u_s := (mul_assoc _ _ _).symm
          _ = ι_PO (π₀ * q) * u_s := by rw [hfs]
          _ = ϖ₀ * (ι_PO q * u_s) := by rw [map_mul, mul_assoc]
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hϖ₀_mem_max
    have hPrime_Ox₀ : ∀ (Q₀ : Ideal ↥Ox₀), Q₀.IsPrime →
        Q₀ = ⊥ ∨ Q₀ = IsLocalRing.maximalIdeal ↥Ox₀ := by
      intro Q₀ hQ₀
      let p' : Ideal P := Q₀.comap ι_PO
      haveI hp'_prime : p'.IsPrime := Ideal.IsPrime.comap ι_PO
      by_cases hp'0 : p' = ⊥
      · left
        ext z
        simp only [Ideal.mem_bot]
        refine ⟨fun hz => ?_, fun hz => hz.symm ▸ Q₀.zero_mem⟩
        obtain ⟨⟨f, s⟩, hfs⟩ := IsLocalization.surj p₀.primeCompl z
        dsimp only at hfs
        change z * ι_PO s.1 = ι_PO f at hfs
        have hf_p' : f ∈ p' := by
          change ι_PO f ∈ Q₀
          rw [← hfs]
          exact Q₀.mul_mem_right _ hz
        rw [hp'0, Ideal.mem_bot] at hf_p'
        rw [hf_p', map_zero] at hfs
        obtain ⟨u_s, hu_s⟩ := (IsLocalization.map_units ↥Ox₀ s).exists_right_inv
        change ι_PO s.1 * u_s = 1 at hu_s
        calc
          z = z * (ι_PO s.1 * u_s) := by rw [hu_s, mul_one]
          _ = (z * ι_PO s.1) * u_s := (mul_assoc _ _ _).symm
          _ = 0 := by rw [hfs, zero_mul]
      · right
        have hp'_max : p'.IsMaximal := IsPrime.to_maximal_ideal hp'0
        have hQ₀_le : Q₀ ≤ IsLocalRing.maximalIdeal ↥Ox₀ :=
          IsLocalRing.le_maximalIdeal hQ₀.ne_top
        have hp'_le : p' ≤ p₀ := fun f hf => hQ₀_le hf
        have hp'_eq : p' = p₀ := hp'_max.eq_of_le hp₀_prime.ne_top hp'_le
        have hϖ₀_Q₀ : ϖ₀ ∈ Q₀ := by
          change π₀ ∈ p'
          rw [hp'_eq, ← hπ₀_span]
          exact Ideal.subset_span rfl
        apply le_antisymm hQ₀_le
        rw [hMax_Ox₀, Ideal.span_le, Set.singleton_subset_iff]
        exact hϖ₀_Q₀
    letI algPR : Algebra P R := ψ.toRingHom.toAlgebra
    haveI : Algebra.Etale P R := RingHom.etale_algebraMap.mp hEt
    let B₀ := TensorProduct P ↥Ox₀ R
    haveI : Algebra.Etale ↥Ox₀ B₀ := Algebra.Etale.baseChange P R ↥Ox₀
    haveI : IsNoetherianRing B₀ := Algebra.FiniteType.isNoetherianRing ↥Ox₀ B₀
    let φ_RO : R →+* ↥O_rel := (algebraMap R F).codRestrict O_rel.toSubring hRO
    letI algOxO : Algebra ↥Ox₀ ↥O_rel := j.toAlgebra
    letI algPOrel : Algebra P ↥O_rel := (j.comp ι_PO).toAlgebra
    haveI : IsScalarTower P ↥Ox₀ ↥O_rel := IsScalarTower.of_algebraMap_eq' rfl
    let φ_RO_alg : R →ₐ[P] ↥O_rel :=
      { φ_RO with
        commutes' := fun f => by
          apply Subtype.ext
          change algebraMap R F (ψ f) = Polynomial.aeval x₀ f
          exact (AlgHom.congr_fun haeval_eq f).symm }
    let μ_P : B₀ →ₐ[P] ↥O_rel :=
      Algebra.TensorProduct.lift (IsScalarTower.toAlgHom P ↥Ox₀ ↥O_rel) φ_RO_alg
        (fun _ _ => Commute.all _ _)
    have hμ_P_tmul : ∀ (u : ↥Ox₀) (r : R), μ_P (u ⊗ₜ[P] r) = j u * φ_RO r :=
      fun u r => Algebra.TensorProduct.lift_tmul _ _ _ u r
    let μ_B : B₀ →ₐ[↥Ox₀] ↥O_rel :=
      { μ_P.toRingHom with
        commutes' := fun u => by
          change μ_P (u ⊗ₜ[P] 1) = j u
          rw [hμ_P_tmul, map_one, mul_one] }
    let μ_F : B₀ →+* F := O_rel.subtype.comp μ_B.toRingHom
    have h_smul_Ox₀ : ∀ f : P, ι_PO f = f • (1 : ↥Ox₀) := by
      intro f
      change ι_PO f = ι_PO f * 1
      rw [mul_one]
    have hB₀_denom : ∀ x : B₀, ∃ (s : p₀.primeCompl) (r₀ : R),
        (ι_PO s.1 ⊗ₜ[P] (1 : R)) * x = (1 : ↥Ox₀) ⊗ₜ[P] r₀ := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨1, 0, by simp⟩
      | tmul u r =>
        obtain ⟨⟨f, s⟩, hfs⟩ := IsLocalization.surj p₀.primeCompl u
        dsimp only at hfs
        change u * ι_PO s.1 = ι_PO f at hfs
        refine ⟨s, f • r, ?_⟩
        have hmul : ι_PO s.1 * u = f • (1 : ↥Ox₀) := by
          rw [mul_comm, hfs, h_smul_Ox₀]
        rw [Algebra.TensorProduct.tmul_mul_tmul, hmul, one_mul, TensorProduct.smul_tmul]
      | add x₁ x₂ ih₁ ih₂ =>
        obtain ⟨s₁, r₁, hx₁⟩ := ih₁
        obtain ⟨s₂, r₂, hx₂⟩ := ih₂
        refine ⟨s₁ * s₂, s₂.1 • r₁ + s₁.1 • r₂, ?_⟩
        have h1 : (ι_PO (s₁ * s₂).1 ⊗ₜ[P] (1 : R)) * x₁ = (1 : ↥Ox₀) ⊗ₜ[P] (s₂.1 • r₁) := by
          have hsplit : (ι_PO (s₁ * s₂).1 ⊗ₜ[P] (1 : R)) =
              (ι_PO s₂.1 ⊗ₜ[P] (1 : R)) * (ι_PO s₁.1 ⊗ₜ[P] (1 : R)) := by
            change (ι_PO (s₁.1 * s₂.1) ⊗ₜ[P] (1 : R)) = _
            rw [map_mul, mul_comm (ι_PO s₁.1), Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          rw [hsplit, mul_assoc, hx₁, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
            h_smul_Ox₀, TensorProduct.smul_tmul]
        have h2 : (ι_PO (s₁ * s₂).1 ⊗ₜ[P] (1 : R)) * x₂ = (1 : ↥Ox₀) ⊗ₜ[P] (s₁.1 • r₂) := by
          have hsplit : (ι_PO (s₁ * s₂).1 ⊗ₜ[P] (1 : R)) =
              (ι_PO s₁.1 ⊗ₜ[P] (1 : R)) * (ι_PO s₂.1 ⊗ₜ[P] (1 : R)) := by
            change (ι_PO (s₁.1 * s₂.1) ⊗ₜ[P] (1 : R)) = _
            rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          rw [hsplit, mul_assoc, hx₂, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
            h_smul_Ox₀, TensorProduct.smul_tmul]
        rw [mul_add, h1, h2, TensorProduct.tmul_add]
    have hμF_inj : Function.Injective μ_F := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨s, r₀, hsr⟩ := hB₀_denom x
      have hr₀_map : algebraMap R F r₀ = 0 := by
        have happ := congrArg μ_F hsr
        have hL : μ_F ((ι_PO s.1 ⊗ₜ[P] (1 : R)) * x) = 0 := by
          rw [map_mul, hx, mul_zero]
        have hR : μ_F ((1 : ↥Ox₀) ⊗ₜ[P] r₀) = algebraMap R F r₀ := by
          change (μ_P ((1 : ↥Ox₀) ⊗ₜ[P] r₀) : F) = algebraMap R F r₀
          rw [hμ_P_tmul, map_one, one_mul]
          rfl
        rw [← hR, ← happ, hL]
      have hr₀ : r₀ = 0 := IsFractionRing.injective R F (hr₀_map.trans (map_zero _).symm)
      rw [hr₀, TensorProduct.tmul_zero] at hsr
      obtain ⟨u_s, hu_s⟩ := (IsLocalization.map_units ↥Ox₀ s).exists_left_inv
      change u_s * ι_PO s.1 = 1 at hu_s
      calc
        x = ((1 : ↥Ox₀) ⊗ₜ[P] (1 : R)) * x := (one_mul x).symm
        _ = ((u_s * ι_PO s.1) ⊗ₜ[P] ((1 : R) * 1)) * x := by rw [hu_s, mul_one]
        _ = (u_s ⊗ₜ[P] (1 : R)) * ((ι_PO s.1 ⊗ₜ[P] (1 : R)) * x) := by
              rw [← Algebra.TensorProduct.tmul_mul_tmul, mul_assoc]
        _ = 0 := by rw [hsr, mul_zero]
    have hμB_inj : Function.Injective μ_B := fun x₁ x₂ h => hμF_inj (congrArg Subtype.val h)
    haveI : IsDomain B₀ := Function.Injective.isDomain μ_F hμF_inj
    let κ₀ := IsLocalRing.ResidueField ↥Ox₀
    let res₀ : ↥Ox₀ →+* κ₀ := IsLocalRing.residue ↥Ox₀
    have hres₀_surj : Function.Surjective res₀ := Ideal.Quotient.mk_surjective
    haveI : Algebra.Etale κ₀ (TensorProduct ↥Ox₀ κ₀ B₀) := Algebra.Etale.baseChange ↥Ox₀ B₀ κ₀
    obtain ⟨I, hFinI, Ai, instFieldAi, instAlgAi, e_res, hModSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ₀ (TensorProduct ↥Ox₀ κ₀ B₀)).mp inferInstance
    letI := instFieldAi
    letI := instAlgAi
    letI : Finite I := hFinI
    letI : Fintype I := Fintype.ofFinite I
    letI : DecidableEq I := Classical.decEq I
    let π_mod : B₀ →+* (∀ i : I, Ai i) :=
      e_res.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom
    have hπ_mod_surj : Function.Surjective π_mod := by
      intro f
      have h_inc_surj : ∀ t : TensorProduct ↥Ox₀ κ₀ B₀, ∃ b : B₀, ((1 : κ₀) ⊗ₜ[↥Ox₀] b) = t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => exact ⟨0, by simp⟩
        | tmul c b =>
          obtain ⟨u, rfl⟩ := hres₀_surj c
          refine ⟨u • b, ?_⟩
          rw [← TensorProduct.smul_tmul]
          change (res₀ u * 1) ⊗ₜ[↥Ox₀] b = res₀ u ⊗ₜ[↥Ox₀] b
          rw [mul_one]
        | add t₁ t₂ ih₁ ih₂ =>
          obtain ⟨b₁, rfl⟩ := ih₁
          obtain ⟨b₂, rfl⟩ := ih₂
          exact ⟨b₁ + b₂, TensorProduct.tmul_add 1 b₁ b₂⟩
      obtain ⟨b, hb⟩ := h_inc_surj (e_res.symm f)
      refine ⟨b, ?_⟩
      change e_res ((1 : κ₀) ⊗ₜ[↥Ox₀] b) = f
      rw [hb, AlgEquiv.apply_symm_apply]
    let ϖ_B₀ : B₀ := algebraMap ↥Ox₀ B₀ ϖ₀
    have hker_π_mod : RingHom.ker π_mod = Ideal.span {ϖ_B₀} := by
      apply le_antisymm
      · intro b hb
        let I_ϖ : Ideal B₀ := Ideal.span {ϖ_B₀}
        let q_ϖ : B₀ →ₐ[↥Ox₀] B₀ ⧸ I_ϖ := Ideal.Quotient.mkₐ ↥Ox₀ I_ϖ
        have hkill_max : ∀ u ∈ IsLocalRing.maximalIdeal ↥Ox₀,
            ((Ideal.Quotient.mk I_ϖ).comp (algebraMap ↥Ox₀ B₀)) u = 0 := by
          intro u hu
          rw [hMax_Ox₀, Ideal.mem_span_singleton] at hu
          obtain ⟨v, rfl⟩ := hu
          simp only [RingHom.comp_apply, map_mul]
          change Ideal.Quotient.mk I_ϖ (ϖ_B₀ * algebraMap ↥Ox₀ B₀ v) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem]
