          rw [AddSubmonoidClass.coe_finsetSum]
          refine add_mem
            (N_ideal.mul_mem_left p₀ (Ideal.subset_span (Set.mem_union_right _ rfl))) ?_
          exact sum_mem fun i _ =>
            N_ideal.mul_mem_left (p_coeff i) (Ideal.subset_span (Set.mem_union_left _ ⟨i, rfl⟩))
        have hTensor_nz : ((1 : IsLocalRing.ResidueField S) ⊗ₜ[P] n_z :
