    clear * - hIntV₁ hProjV₁ hDimV₁ hTopPre
    intro UA hAffA _
    have hFT_V₁ : AlgebraicGeometry.LocallyOfFiniteType V₁.hom := by
      obtain ⟨N, ι, hClosed⟩ := hProjV₁
      have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
      rw [← CategoryTheory.Over.w ι]
