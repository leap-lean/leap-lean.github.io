      have hKer_ΦPS : Φ_PS.ker = ψ_I.range := by
        refine le_antisymm ?_ ?_
        · intro w hw
          rw [LinearMap.mem_ker] at hw
          obtain ⟨x, rfl⟩ := hPure_VP w
          rw [hΦ_tmul, one_smul] at hw
