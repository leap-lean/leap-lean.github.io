        let den_fn : ℕ → nonZeroDivisors ↥Ox₀ := fun i =>
          (Classical.choose (IsLocalization.surj (nonZeroDivisors ↥Ox₀) (P_min.coeff i))).2
        have hnd_spec : ∀ i : ℕ, P_min.coeff i * algebraMap ↥Ox₀ ↥Lx₀ (den_fn i).1 =
