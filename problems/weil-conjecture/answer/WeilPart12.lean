        rw [IsLocalization.Away.lift_eq, hev_X ℓ]
      rw [h_aℓ, ← map_mul, ht_away_spec ℓ b, IsLocalization.Away.lift_eq, hev_X b]
    have hψ_in_range : ∀ (ℓ : Fin (d + 1)) (s : ↑(P_A.presheaf.obj (Opposite.op (D ℓ)))),
        ψ_sec ℓ s ∈ (ι_chart ℓ).range := by
      intro ℓ s
      have h_sub : Subring.closure (Set.range (c_A ℓ) ∪ Set.range (t_A ℓ)) ≤
          (ι_chart ℓ).range.comap (ψ_sec ℓ) := by
        rw [Subring.closure_le]
