          change e_V (e_V.symm q_elem) ∈ Q
          rwa [e_V.apply_symm_apply]
        rw [hbot, Ideal.mem_bot] at hmem
        exact hq_ne (e_V.symm.injective (hmem.trans (map_zero _).symm))
      have hQ_eq := hPu_uniq (Ideal.comap e_V.toRingHom Q)
        ⟨hQ_comap_ne, Ideal.comap_isPrime e_V.toRingHom Q⟩
      ext v
      change v ∈ Q ↔ e_V.symm v ∈ P_u
      rw [← hQ_eq, Ideal.mem_comap]
      change v ∈ Q ↔ e_V (e_V.symm v) ∈ Q
      rw [e_V.apply_symm_apply]
  let v_Γ : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ Γ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑B_Γ) V)) ≫ ι_UΓ
  let v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W := v_Γ ≫ p₁
  let v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ Y := v_Γ ≫ p₂
  let η_V : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V L))
  have hηV_vΓ_pt : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)),
      (η_V ≫ v_Γ).base q = ι_UΓ.base η_B_spec := by
    intro q
    have hq_bot : q.asIdeal = ⊥ := by
      rcases Ideal.eq_bot_or_top q.asIdeal with hbot | htop
      · exact hbot
      · exact False.elim (q.isPrime.ne_top htop)
    have h_eq_ηB : (η_V ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (↑B_Γ) V))).base q = η_B_spec := by
      apply PrimeSpectrum.ext
      ext b
      change algebraMap V L (algebraMap (↑B_Γ) V b) ∈ q.asIdeal ↔ b ∈ η_B.asIdeal
      rw [hq_bot, hηB_asIdeal, Ideal.mem_bot, Ideal.mem_bot,
        ← IsScalarTower.algebraMap_apply (↑B_Γ) V L]
      exact map_eq_zero_iff (algebraMap (↑B_Γ) L) (IsFractionRing.injective (↑B_Γ) L)
    change ι_UΓ.base ((η_V ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (↑B_Γ) V))).base q) = ι_UΓ.base η_B_spec
    rw [h_eq_ηB]
  have hRange_ηV : Set.range (η_V ≫ v_Γ).base ⊆ Set.range e_K.base := by
    rintro _ ⟨q, rfl⟩
    rw [hηV_vΓ_pt q, ← hx_K]
    exact ⟨x_K, rfl⟩
  let u_K : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
      CategoryTheory.Limits.pullback g_W η_K :=
    AlgebraicGeometry.IsOpenImmersion.lift e_K (η_V ≫ v_Γ) hRange_ηV
  have hu_K_fac : u_K ≫ e_K = η_V ≫ v_Γ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac e_K (η_V ≫ v_Γ) hRange_ηV
  let η_L : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := (⊥ : PrimeSpectrum L)
  have huK_pt : u_K.base η_L = x_K := by
    apply e_K.isOpenEmbedding.injective
    change (u_K ≫ e_K).base η_L = e_K.base x_K
    rw [hu_K_fac, hηV_vΓ_pt η_L, hx_K]
  have hDom_uK : AlgebraicGeometry.IsDominant u_K := by
    refine ⟨denseRange_iff_closure_range.mpr ?_⟩
    ext y
    simp only [Set.mem_univ, iff_true]
    rw [mem_closure_iff]
    intro O hO hyO
    have hO_img_open : IsOpen (e_K.base '' O) := e_K.isOpenEmbedding.isOpenMap O hO
    have hInter : ((Set.univ : Set ↥Γ) ∩
        ((U_Γ : Set ↥Γ) ∩ (e_K.base '' O))).Nonempty :=
      PreirreducibleSpace.isPreirreducible_univ (U_Γ : Set ↥Γ) (e_K.base '' O)
        U_Γ.isOpen hO_img_open ⟨z, trivial, hz_UΓ⟩ ⟨e_K.base y, trivial, ⟨y, hyO, rfl⟩⟩
    obtain ⟨w₀, _, hw₀_U, hw₀_O⟩ := hInter
    have hw₀_range : w₀ ∈ Set.range ι_UΓ.base := by
      rw [hAff_UΓ.range_fromSpec]
      exact hw₀_U
    obtain ⟨q₀, rfl⟩ := hw₀_range
    have hSpec₀ : η_B_spec ⤳ q₀ := by
      change (η_B : PrimeSpectrum ↑B_Γ) ⤳ (q₀ : PrimeSpectrum ↑B_Γ)
      exact (PrimeSpectrum.le_iff_specializes η_B q₀).mp (by
        change η_B.asIdeal ≤ (q₀ : PrimeSpectrum ↑B_Γ).asIdeal
        rw [hηB_asIdeal]
        exact bot_le)
    have hη_in : ι_UΓ.base η_B_spec ∈ e_K.base '' O :=
      hSpec₀.mem_open (hO_img_open.preimage ι_UΓ.continuous) hw₀_O
    obtain ⟨y', hy'O, hy'_eq⟩ := hη_in
    have hy'_xK : y' = x_K := e_K.isOpenEmbedding.injective (hy'_eq.trans hx_K.symm)
    refine ⟨u_K.base η_L, ?_, ⟨η_L, rfl⟩⟩
    rwa [huK_pt, ← hy'_xK]
  let m_V : ↥(AlgebraicGeometry.Spec (CommRingCat.of V)) := IsLocalRing.closedPoint V
  have hmV_id : m_V.asIdeal = IsLocalRing.maximalIdeal V := rfl
  have hvΓ_mV : v_Γ.base m_V = z := by
    have h_comap : (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (↑B_Γ) V))).base m_V = Q_z_spec := by
      apply PrimeSpectrum.ext
      exact IsLocalization.AtPrime.under_maximalIdeal V Q_z.asIdeal
    change ι_UΓ.base ((AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (↑B_Γ) V))).base m_V) = z
    rw [h_comap, hQz_eq]
  apply hCenters V L u_K v_W v_Y m_V q_W q_Y hDom_uK
  · change η_V ≫ v_Γ ≫ p₁ = u_K ≫ CategoryTheory.Limits.pullback.fst g_W η_K
    rw [← CategoryTheory.Category.assoc, ← hu_K_fac, CategoryTheory.Category.assoc,
      hGraph.2.2.2.2.2.2.1]
  · change η_V ≫ v_Γ ≫ p₂ = u_K ≫ α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K
    rw [← CategoryTheory.Category.assoc, ← hu_K_fac, CategoryTheory.Category.assoc,
      hGraph.2.2.2.2.2.2.2.1]
  · change (v_Γ ≫ ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y) ≫ g_W =
      (v_Γ ≫ ι_Γ ≫ CategoryTheory.Limits.pullback.snd g_W g_Y) ≫ g_Y
    simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
  · exact hmV_id
  · change p₁.base (v_Γ.base m_V) = _
    rw [hvΓ_mV, hz₁]
  · change p₂.base (v_Γ.base m_V) = _
    rw [hvΓ_mV, hz₂]
  · exact hComp
  · exact hqW

theorem weil_nc2d_graph_isIso_and_pointed_extension_of_finite_fibers (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W Y Γ : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (ι_Γ : Γ ⟶ CategoryTheory.Limits.pullback g_W g_Y)
    (e_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ⟶ Γ)
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hNormW : ∀ U : W.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
      IsIntegrallyClosed ↑(W.presheaf.obj (Opposite.op U)))
    (hαK_sec : ∀ j : Fin n,
      ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
          CategoryTheory.Limits.pullback g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ_W j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
        (s₁ ≫ α_K.hom) ≫ CategoryTheory.Limits.pullback.fst g_Y
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ_Y j)
    (hGraph : IsNC2DGraphClosure Ω g_W g_Y α_K ι_Γ e_K)
    (hFib : ∀ w : ↥W, ((ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y).base ⁻¹' {w}).Finite) :
    let η_K := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
    ∃ h : W ⟶ Y,
      h ≫ g_Y = g_W ∧
      (∀ j : Fin n, τ_W j ≫ h = τ_Y j) ∧
      CategoryTheory.Limits.pullback.fst g_W η_K ≫ h =
        α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K :=
by
  intro η_K
  let RStar := PowerSeries Ω
  let KStar := FractionRing RStar
  let S := AlgebraicGeometry.Spec (CommRingCat.of RStar)
  let S_K := AlgebraicGeometry.Spec (CommRingCat.of KStar)
  let p₁ : Γ ⟶ W := ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y
  let p₂ : Γ ⟶ Y := ι_Γ ≫ CategoryTheory.Limits.pullback.snd g_W g_Y
  have hIntW : AlgebraicGeometry.IsIntegral W := hW.1
  have hSurjW : AlgebraicGeometry.Surjective g_W := hW.2.2.2.2.1
  have hSecW : ∀ j : Fin n, τ_W j ≫ g_W = 𝟙 S := hW.2.2.2.2.2.2.1
  have hPropY : AlgebraicGeometry.IsProper g_Y := hY.2.2.1
  have hSecY : ∀ j : Fin n, τ_Y j ≫ g_Y = 𝟙 S := hY.2.2.2.2.2.2.1
  obtain ⟨hIntΓ, _hClΓ, hProp_p₁, hOpen_eK, hOpen_fstW, _hOpen_fstY,
    he_p₁, he_p₂, hRange₁, _hRange₂⟩ := hGraph
  
  have hFin_p₁ : AlgebraicGeometry.IsFinite p₁ := by
    have : AlgebraicGeometry.IsProper p₁ := hProp_p₁
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType p₁ :=
      AlgebraicGeometry.IsProper.toLocallyOfFiniteType
    have : AlgebraicGeometry.LocallyQuasiFinite p₁ := by
      refine AlgebraicGeometry.LocallyQuasiFinite.mk ?_
      intro U hU V hV e
      let R_U := ↑(W.presheaf.obj (Opposite.op U))
      let S_V := ↑(Γ.presheaf.obj (Opposite.op V))
      let φ : R_U →+* S_V := (p₁.appLE U V e).hom
      have hFT_φ : φ.FiniteType :=
        AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.LocallyOfFiniteType
          p₁ hLFT ⟨U, hU⟩ ⟨V, hV⟩ e
      let _ : Algebra R_U S_V := φ.toAlgebra
      have : Algebra.FiniteType R_U S_V := hFT_φ
      change Algebra.QuasiFinite R_U S_V
      rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
      intro P
      have hResEq : hV.isoSpec.inv ≫ p₁.resLE U V e =
          AlgebraicGeometry.Spec.map (p₁.appLE U V e) ≫ hU.isoSpec.inv := by
        rw [← CategoryTheory.cancel_mono hU.isoSpec.hom]
        calc (hV.isoSpec.inv ≫ p₁.resLE U V e) ≫ hU.isoSpec.hom
            = hV.isoSpec.inv ≫ (p₁.resLE U V e ≫ U.toSpecΓ) := by
                rw [CategoryTheory.Category.assoc, hU.isoSpec_hom]
          _ = hV.isoSpec.inv ≫ (V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (p₁.appLE U V e)) := by
                rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]
          _ = AlgebraicGeometry.Spec.map (p₁.appLE U V e) := by
                rw [← hV.isoSpec_hom, CategoryTheory.Iso.inv_hom_id_assoc]
          _ = (AlgebraicGeometry.Spec.map (p₁.appLE U V e) ≫ hU.isoSpec.inv) ≫ hU.isoSpec.hom := by
                simp [CategoryTheory.Category.assoc]
      have hCommSpec : hV.isoSpec.inv ≫ V.ι ≫ p₁ =
          AlgebraicGeometry.Spec.map (p₁.appLE U V e) ≫ hU.isoSpec.inv ≫ U.ι := by
        calc hV.isoSpec.inv ≫ V.ι ≫ p₁
            = hV.isoSpec.inv ≫ p₁.resLE U V e ≫ U.ι := by
                rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
          _ = (hV.isoSpec.inv ≫ p₁.resLE U V e) ≫ U.ι := by
                rw [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (p₁.appLE U V e) ≫ hU.isoSpec.inv ≫ U.ι := by
                rw [hResEq, CategoryTheory.Category.assoc]
      let θ : PrimeSpectrum S_V → ↥Γ := (hV.isoSpec.inv ≫ V.ι).base
      have hInj_invV : Function.Injective hV.isoSpec.inv.base := by
        intro q₁ q₂ hq
        have h1 : (hV.isoSpec.inv ≫ hV.isoSpec.hom).base q₁ =
            (hV.isoSpec.inv ≫ hV.isoSpec.hom).base q₂ := by
          change hV.isoSpec.hom.base (hV.isoSpec.inv.base q₁) =
            hV.isoSpec.hom.base (hV.isoSpec.inv.base q₂)
          rw [hq]
        simpa using h1
      have hInj_θ : Function.Injective θ :=
        V.ι.isOpenEmbedding.injective.comp hInj_invV
      let w_P : ↥W := (hU.isoSpec.inv ≫ U.ι).base P
      have hSub : θ '' (PrimeSpectrum.comap φ ⁻¹' {P}) ⊆ p₁.base ⁻¹' {w_P} := by
        rintro _ ⟨Q, hQ, rfl⟩
        have hQ_eq : (AlgebraicGeometry.Spec.map (p₁.appLE U V e)).base Q = P := hQ
        change (hV.isoSpec.inv ≫ V.ι ≫ p₁).base Q = w_P
        rw [hCommSpec]
        change (hU.isoSpec.inv ≫ U.ι).base
          ((AlgebraicGeometry.Spec.map (p₁.appLE U V e)).base Q) = w_P
        rw [hQ_eq]
      exact Set.Finite.of_finite_image ((hFib w_P).subset hSub) hInj_θ.injOn
    exact AlgebraicGeometry.IsFinite.of_isProper_of_locallyQuasiFinite p₁
  
  let ι_WK := CategoryTheory.Limits.pullback.fst g_W η_K
  have : AlgebraicGeometry.IsOpenImmersion e_K := hOpen_eK
  have : AlgebraicGeometry.IsOpenImmersion ι_WK := hOpen_fstW
  let U₀ : W.Opens := ι_WK.opensRange
  have hNE₀ : Nonempty ↥U₀ := by
    have : AlgebraicGeometry.Surjective g_W := hSurjW
    have hSurj_snd : AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.snd g_W η_K) :=
      inferInstance
    obtain ⟨x_K, _⟩ := hSurj_snd.surj (⊥ : PrimeSpectrum KStar)
    exact ⟨⟨ι_WK.base x_K, ⟨x_K, rfl⟩⟩⟩
  have hIso₀ : CategoryTheory.IsIso (p₁ ∣_ U₀) := by
    let V₀ : Γ.Opens := (TopologicalSpace.Opens.map p₁.base).obj U₀
    have hRangeEq : Set.range ⇑V₀.ι = Set.range ⇑e_K := by
      rw [hRange₁]
      ext z
      simp only [V₀, U₀, AlgebraicGeometry.Scheme.Opens.range_ι]
      rfl
    let β : V₀.toScheme ≅ CategoryTheory.Limits.pullback g_W η_K :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq V₀.ι e_K hRangeEq
    have hβ_inv : β.inv ≫ V₀.ι = e_K :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac V₀.ι e_K hRangeEq
    have hFactor : β.inv ≫ (p₁ ∣_ U₀) = ι_WK.isoOpensRange.hom := by
      rw [← CategoryTheory.cancel_mono U₀.ι]
      calc (β.inv ≫ (p₁ ∣_ U₀)) ≫ U₀.ι
          = β.inv ≫ ((p₁ ∣_ U₀) ≫ U₀.ι) := by rw [CategoryTheory.Category.assoc]
        _ = β.inv ≫ (V₀.ι ≫ p₁) := by rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (β.inv ≫ V₀.ι) ≫ p₁ := by rw [← CategoryTheory.Category.assoc]
        _ = e_K ≫ p₁ := by rw [hβ_inv]
        _ = ι_WK := he_p₁
        _ = ι_WK.isoOpensRange.hom ≫ U₀.ι :=
            (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_WK).symm
    have hp₁_eq : (p₁ ∣_ U₀) = β.hom ≫ ι_WK.isoOpensRange.hom := by
      rw [← hFactor, CategoryTheory.Iso.hom_inv_id_assoc]
    rw [hp₁_eq]
    infer_instance
  
  have : AlgebraicGeometry.IsIntegral Γ := hIntΓ
  have : AlgebraicGeometry.IsIntegral W := hIntW
  have : CategoryTheory.IsIso (p₁ ∣_ U₀) := hIso₀
  obtain ⟨hAffHom, hFinApp⟩ := (AlgebraicGeometry.isFinite_iff p₁).mp hFin_p₁
  have hMapEqIso : ∀ {a b : Γ.Opens} (h : a = b),
      CategoryTheory.IsIso (Γ.presheaf.map (CategoryTheory.eqToHom h).op) := by
    rintro a _ rfl
    simp
    infer_instance
  have hIso_p₁ : CategoryTheory.IsIso p₁ := by
    let P_iso := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme
    change P_iso p₁
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := P_iso)
      (fun U : W.affineOpens => U.1) (AlgebraicGeometry.iSup_affineOpens_eq_top W)]
    intro U
    change CategoryTheory.IsIso (p₁ ∣_ U.1)
    have hAffU : AlgebraicGeometry.IsAffineOpen U.1 := U.2
    let V : Γ.Opens := (TopologicalSpace.Opens.map p₁.base).obj U.1
    have hAffV : AlgebraicGeometry.IsAffineOpen V :=
      (AlgebraicGeometry.isAffineHom_iff p₁).mp hAffHom U.1 hAffU
    have hBij : Function.Bijective (p₁.app U.1).hom := by
      by_cases hNE : Nonempty ↥U.1
      · have hIrredW : IrreducibleSpace ↥W := AlgebraicGeometry.irreducibleSpace_of_isIntegral W
        obtain ⟨w₀, hw₀_U, hw₀_U₀⟩ :=
          nonempty_preirreducible_inter U.1.isOpen U₀.isOpen
            (Set.nonempty_coe_sort.mp hNE) (Set.nonempty_coe_sort.mp hNE₀)
        have hNE_V : Nonempty ↥V := by
          obtain ⟨x_K, hx_K⟩ : w₀ ∈ Set.range ι_WK.base := hw₀_U₀
          refine ⟨⟨e_K.base x_K, ?_⟩⟩
          change p₁.base (e_K.base x_K) ∈ U.1
          have h_eq : (e_K ≫ p₁).base x_K = ι_WK.base x_K := by rw [he_p₁]
          change (e_K ≫ p₁).base x_K ∈ U.1
          rw [h_eq, hx_K]
          exact hw₀_U
        let A := ↑(W.presheaf.obj (Opposite.op U.1))
        let B := ↑(Γ.presheaf.obj (Opposite.op V))
        let φ : A →+* B := (p₁.app U.1).hom
        have : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral W hIntW U.1 hNE
        have : IsDomain B := @AlgebraicGeometry.IsIntegral.component_integral Γ hIntΓ V hNE_V
        have : IsIntegrallyClosed A := hNormW U.1 hAffU hNE
        obtain ⟨x₀, hx₀_le_U₀, hw₀_x₀⟩ :=
          hAffU.exists_basicOpen_le (⟨w₀, hw₀_U₀⟩ : ↥U₀) hw₀_U
        let O : W.Opens := W.basicOpen x₀
        have hx₀_ne : x₀ ≠ 0 := by
          intro h0
          rw [h0, AlgebraicGeometry.Scheme.basicOpen_zero] at hw₀_x₀
          exact hw₀_x₀
        
        let V_O' : (↑U₀ : AlgebraicGeometry.Scheme.{u}).Opens :=
          (TopologicalSpace.Opens.map U₀.ι.base).obj O
        have hVO' : (U₀.ι.opensFunctor).obj V_O' = O := by
          ext y
          simp only [V_O', AlgebraicGeometry.Scheme.Hom.opensFunctor, SetLike.mem_coe]
          exact ⟨by rintro ⟨z, hz, rfl⟩; exact hz, fun hy => ⟨⟨y, hx₀_le_U₀ hy⟩, hy, rfl⟩⟩
        have hAppIso0 : CategoryTheory.IsIso ((p₁ ∣_ U₀).app V_O') := inferInstance
        rw [AlgebraicGeometry.morphismRestrict_app p₁ U₀ V_O'] at hAppIso0
        have : CategoryTheory.IsIso (p₁.app ((U₀.ι.opensFunctor).obj V_O')) :=
          @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
            (p₁.app ((U₀.ι.opensFunctor).obj V_O')) _ (hMapEqIso _) hAppIso0
        have hIso_appO : CategoryTheory.IsIso (p₁.app O) := by
          rwa [hVO'] at this
        have hPre : (TopologicalSpace.Opens.map p₁.base).obj O = Γ.basicOpen (φ x₀) :=
          p₁.preimage_basicOpen x₀
        let A_loc := ↑(W.presheaf.obj (Opposite.op O))
        let B_loc := ↑(Γ.presheaf.obj (Opposite.op (Γ.basicOpen (φ x₀))))
        let iso_loc : W.presheaf.obj (Opposite.op O) ≅
            Γ.presheaf.obj (Opposite.op (Γ.basicOpen (φ x₀))) :=
          @CategoryTheory.asIso _ _ _ _ (p₁.app O) hIso_appO ≪≫
            Γ.presheaf.mapIso (CategoryTheory.eqToIso hPre.symm).op
        have hComm_loc : ∀ a : A, iso_loc.hom.hom (algebraMap A A_loc a) =
            algebraMap B B_loc (φ a) := by
          intro a
          have hNat := p₁.naturality (CategoryTheory.homOfLE (W.basicOpen_le x₀)).op
          have hComp : (W.presheaf.map (CategoryTheory.homOfLE (W.basicOpen_le x₀)).op ≫
              p₁.app O) ≫ Γ.presheaf.map (CategoryTheory.eqToHom hPre.symm).op =
              p₁.app U.1 ≫
                Γ.presheaf.map (CategoryTheory.homOfLE (Γ.basicOpen_le (φ x₀))).op := by
            rw [hNat, CategoryTheory.Category.assoc, ← Γ.presheaf.map_comp]
            congr 2
          exact congrArg (fun f : W.presheaf.obj (Opposite.op U.1) ⟶
            Γ.presheaf.obj (Opposite.op (Γ.basicOpen (φ x₀))) => f.hom a) hComp
        have : IsLocalization.Away x₀ A_loc := hAffU.isLocalization_basicOpen x₀
        have : IsLocalization.Away (φ x₀) B_loc := hAffV.isLocalization_basicOpen (φ x₀)
        have hPowA : Submonoid.powers x₀ ≤ nonZeroDivisors A := by
          rintro _ ⟨k, rfl⟩
          exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero k hx₀_ne)
        have hInj_αA : Function.Injective (algebraMap A A_loc) :=
          IsLocalization.injective A_loc hPowA
        have hInj_φ : Function.Injective φ := by
          intro a₁ a₂ ha_eq
          apply sub_eq_zero.mp
          let a : A := a₁ - a₂
          have ha0 : φ a = 0 := by simp [a, ha_eq]
          have h1 : iso_loc.hom.hom (algebraMap A A_loc a) = 0 := by
            rw [hComm_loc, ha0, map_zero]
          have h2 : algebraMap A A_loc a = 0 := by
            have h_inv : iso_loc.inv.hom (iso_loc.hom.hom (algebraMap A A_loc a)) =
                algebraMap A A_loc a := by
              change (iso_loc.hom ≫ iso_loc.inv).hom (algebraMap A A_loc a) = _
              simp
            rw [← h_inv, h1, map_zero]
          exact hInj_αA (h2.trans (map_zero _).symm)
        have hφx₀_ne : φ x₀ ≠ 0 :=
          fun h => hx₀_ne (hInj_φ (h.trans (map_zero φ).symm))
        have hPowB : Submonoid.powers (φ x₀) ≤ nonZeroDivisors B := by
          rintro _ ⟨k, rfl⟩
          exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero k hφx₀_ne)
        have hInj_αB : Function.Injective (algebraMap B B_loc) :=
          IsLocalization.injective B_loc hPowB
        let K_A := FractionRing A
        have hInj_AK : Function.Injective (algebraMap A K_A) :=
          IsFractionRing.injective A K_A
        have hx₀_K_ne : algebraMap A K_A x₀ ≠ 0 :=
          fun h => hx₀_ne (hInj_AK (h.trans (map_zero _).symm))
        have hx₀_unit : IsUnit (algebraMap A K_A x₀) := Ne.isUnit hx₀_K_ne
        let lam : A_loc →+* K_A := IsLocalization.Away.lift x₀ hx₀_unit
        have hInj_lam : Function.Injective lam := by
          intro z₁ z₂ hz_eq
          apply sub_eq_zero.mp
          let z : A_loc := z₁ - z₂
          have hz0 : lam z = 0 := by simp [z, hz_eq]
          obtain ⟨⟨a, y⟩, hy⟩ := IsLocalization.surj (Submonoid.powers x₀) z
          have ha_K : algebraMap A K_A a = 0 := by
            calc algebraMap A K_A a
                = lam (algebraMap A A_loc a) := (IsLocalization.Away.lift_eq x₀ hx₀_unit a).symm
              _ = lam (z * algebraMap A A_loc y.1) := by rw [hy]
              _ = lam z * lam (algebraMap A A_loc y.1) := map_mul lam _ _
              _ = 0 := by rw [hz0, zero_mul]
          have ha0 : a = 0 := hInj_AK (ha_K.trans (map_zero _).symm)
          rw [ha0, map_zero] at hy
          obtain ⟨u_inv, hu_inv⟩ := (IsLocalization.map_units A_loc y).exists_right_inv
          calc z
              = z * (algebraMap A A_loc y.1 * u_inv) := by rw [hu_inv, mul_one]
            _ = (z * algebraMap A A_loc y.1) * u_inv := by ring
            _ = 0 := by rw [hy, zero_mul]
        let ι_BK : B →+* K_A := lam.comp (iso_loc.inv.hom.comp (algebraMap B B_loc))
        have hInj_ιBK : Function.Injective ι_BK := by
          intro b₁ b₂ hb
          apply hInj_αB
          have h1 : iso_loc.inv.hom (algebraMap B B_loc b₁) =
              iso_loc.inv.hom (algebraMap B B_loc b₂) := hInj_lam hb
          have h_left : ∀ w : B_loc, iso_loc.hom.hom (iso_loc.inv.hom w) = w := by
            intro w
            change (iso_loc.inv ≫ iso_loc.hom).hom w = w
            simp
          rw [← h_left (algebraMap B B_loc b₁), ← h_left (algebraMap B B_loc b₂), h1]
        have hComp_ιBK : (algebraMap A K_A).comp (RingHom.id A) = ι_BK.comp φ := by
          ext a
          simp only [RingHom.comp_apply, RingHom.id_apply, ι_BK]
          rw [← hComm_loc]
          have h_inv_hom : iso_loc.inv.hom (iso_loc.hom.hom (algebraMap A A_loc a)) =
              algebraMap A A_loc a := by
            change (iso_loc.hom ≫ iso_loc.inv).hom (algebraMap A A_loc a) = _
            simp
          rw [h_inv_hom]
          exact (IsLocalization.Away.lift_eq x₀ hx₀_unit a).symm
        let _ : Algebra A B := φ.toAlgebra
        have : Module.Finite A B := hFinApp U.1 hAffU
        have : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
        refine ⟨hInj_φ, ?_⟩
        intro b
        have hb_int : IsIntegral A b := Algebra.IsIntegral.isIntegral b
        have hb_int_K : IsIntegral A (ι_BK b) :=
          IsIntegral.map_of_comp_eq (RingHom.id A) ι_BK hComp_ιBK hb_int
        obtain ⟨a₀, ha₀⟩ := (IsIntegrallyClosed.isIntegral_iff (R := A) (K := K_A)).mp hb_int_K
        refine ⟨a₀, hInj_ιBK ?_⟩
        have h_eq := congrArg (fun f : A →+* K_A => f a₀) hComp_ιBK
        dsimp only [RingHom.comp_apply, RingHom.id_apply] at h_eq
        rw [← h_eq, ha₀]
      · have hU_bot : U.1 = ⊥ := by
          ext x
          simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
          exact fun hx => hNE ⟨x, hx⟩
        have hV_bot : V = ⊥ := by
          ext z
          simp only [V, TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
          exact fun hz => hNE ⟨p₁.base z, hz⟩
        have : Subsingleton ↑(W.presheaf.obj (Opposite.op U.1)) := by
          rw [hU_bot]; infer_instance
        have : Subsingleton ↑(Γ.presheaf.obj (Opposite.op V)) := by
          rw [hV_bot]; infer_instance
        exact ⟨fun a₁ a₂ _ => Subsingleton.elim a₁ a₂, fun b => ⟨0, Subsingleton.elim _ b⟩⟩
    have : CategoryTheory.IsIso (p₁.app U.1) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (p₁.app U.1)).mpr hBij
    have hSpecNat : (p₁ ∣_ U.1) =
        hAffV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (p₁.app U.1) ≫ hAffU.isoSpec.inv := by
      rw [← CategoryTheory.cancel_mono hAffU.isoSpec.hom]
      calc (p₁ ∣_ U.1) ≫ hAffU.isoSpec.hom
          = (p₁ ∣_ U.1) ≫ U.1.toSpecΓ := by rw [hAffU.isoSpec_hom]
        _ = V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (p₁.app U.1) :=
            (AlgebraicGeometry.Scheme.Opens.toSpecΓ_naturality p₁ U.1).symm
        _ = (hAffV.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (p₁.app U.1) ≫
              hAffU.isoSpec.inv) ≫ hAffU.isoSpec.hom := by
            rw [← hAffV.isoSpec_hom]
            simp [CategoryTheory.Category.assoc]
    rw [hSpecNat]
    infer_instance
  
  have : CategoryTheory.IsIso p₁ := hIso_p₁
  let h : W ⟶ Y := CategoryTheory.inv p₁ ≫ p₂
  have hh_g : h ≫ g_Y = g_W := by
    rw [← CategoryTheory.cancel_epi p₁]
    calc p₁ ≫ (h ≫ g_Y)
        = (p₁ ≫ CategoryTheory.inv p₁) ≫ p₂ ≫ g_Y := by
            simp only [h, CategoryTheory.Category.assoc]
      _ = ι_Γ ≫ (CategoryTheory.Limits.pullback.snd g_W g_Y ≫ g_Y) := by
            simp [p₂, CategoryTheory.Category.assoc]
      _ = ι_Γ ≫ (CategoryTheory.Limits.pullback.fst g_W g_Y ≫ g_W) := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = p₁ ≫ g_W := by
            simp only [p₁, CategoryTheory.Category.assoc]
  have hh_gen : ι_WK ≫ h = α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K := by
    calc ι_WK ≫ (CategoryTheory.inv p₁ ≫ p₂)
        = (e_K ≫ p₁) ≫ CategoryTheory.inv p₁ ≫ p₂ := by rw [he_p₁]
      _ = e_K ≫ (p₁ ≫ CategoryTheory.inv p₁) ≫ p₂ := by
            simp only [CategoryTheory.Category.assoc]
      _ = e_K ≫ p₂ := by simp
      _ = α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K := he_p₂
  have hh_sec : ∀ j : Fin n, τ_W j ≫ h = τ_Y j := by
    let ψ_RK : CommRingCat.of RStar ⟶ CommRingCat.of KStar :=
      CommRingCat.ofHom (algebraMap RStar KStar)
    have hInj_appTop : Function.Injective η_K.appTop.hom := by
      have hNat := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality ψ_RK
      let iR := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of RStar)
      let iK := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of KStar)
      intro u₁ u₂ hu
      have h1 : (iR.inv ≫ η_K.appTop).hom (iR.hom.hom u₁) =
          (iR.inv ≫ η_K.appTop).hom (iR.hom.hom u₂) := by
        simp only [CommRingCat.hom_comp, RingHom.comp_apply]
        have hu1 : iR.inv.hom (iR.hom.hom u₁) = u₁ := by
          change (iR.hom ≫ iR.inv).hom u₁ = u₁; simp
        have hu2 : iR.inv.hom (iR.hom.hom u₂) = u₂ := by
          change (iR.hom ≫ iR.inv).hom u₂ = u₂; simp
        rw [hu1, hu2, hu]
      rw [← hNat] at h1
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
      have h2 : ψ_RK.hom (iR.hom.hom u₁) = ψ_RK.hom (iR.hom.hom u₂) := by
        have h_eq := congrArg iK.hom.hom h1
        have hk1 : iK.hom.hom (iK.inv.hom (ψ_RK.hom (iR.hom.hom u₁))) =
            ψ_RK.hom (iR.hom.hom u₁) := by
          change (iK.inv ≫ iK.hom).hom _ = _; simp
        have hk2 : iK.hom.hom (iK.inv.hom (ψ_RK.hom (iR.hom.hom u₂))) =
            ψ_RK.hom (iR.hom.hom u₂) := by
          change (iK.inv ≫ iK.hom).hom _ = _; simp
        rwa [hk1, hk2] at h_eq
      have h3 : iR.hom.hom u₁ = iR.hom.hom u₂ :=
        IsFractionRing.injective RStar KStar h2
      have h_eq := congrArg iR.inv.hom h3
      have hr1 : iR.inv.hom (iR.hom.hom u₁) = u₁ := by
        change (iR.hom ≫ iR.inv).hom u₁ = u₁; simp
      have hr2 : iR.inv.hom (iR.hom.hom u₂) = u₂ := by
        change (iR.hom ≫ iR.inv).hom u₂ = u₂; simp
      rwa [hr1, hr2] at h_eq
    have : AlgebraicGeometry.IsDominant η_K :=
      AlgebraicGeometry.isDominant_of_of_appTop_injective hInj_appTop
    have : AlgebraicGeometry.IsProper g_Y := hPropY
    have : AlgebraicGeometry.IsSeparated g_Y := AlgebraicGeometry.IsProper.toIsSeparated
    intro j
    let s₁ : S_K ⟶ CategoryTheory.Limits.pullback g_W η_K :=
      CategoryTheory.Limits.pullback.lift (η_K ≫ τ_W j) (𝟙 S_K) (by
        rw [CategoryTheory.Category.assoc, hSecW j, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp])
    have hs₁_sec : (s₁ ≫ α_K.hom) ≫ CategoryTheory.Limits.pullback.fst g_Y η_K =
        η_K ≫ τ_Y j :=
      hαK_sec j s₁ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have hGenEq : η_K ≫ (τ_W j ≫ h) = η_K ≫ τ_Y j := by
      calc η_K ≫ (τ_W j ≫ h)
          = (η_K ≫ τ_W j) ≫ h := by rw [CategoryTheory.Category.assoc]
        _ = (s₁ ≫ ι_WK) ≫ h := by rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = s₁ ≫ (ι_WK ≫ h) := by rw [CategoryTheory.Category.assoc]
        _ = (s₁ ≫ α_K.hom) ≫ CategoryTheory.Limits.pullback.fst g_Y η_K := by
              rw [hh_gen, CategoryTheory.Category.assoc]
        _ = η_K ≫ τ_Y j := hs₁_sec
    have hOverS : (τ_W j ≫ h) ≫ g_Y = τ_Y j ≫ g_Y := by
      rw [CategoryTheory.Category.assoc, hh_g, hSecW j, hSecY j]
    exact AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_Y hOverS η_K hGenEq
  exact ⟨h, hh_g, hh_sec, hh_gen⟩

theorem weil_nc2d_morphism_of_nonclosed_component_centers (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W Y : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hNormW : ∀ U : W.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
      IsIntegrallyClosed ↑(W.presheaf.obj (Opposite.op U)))
    (hαK_snd : α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hαK_sec : ∀ j : Fin n,
      ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
          CategoryTheory.Limits.pullback g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ_W j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
        (s₁ ≫ α_K.hom) ≫ CategoryTheory.Limits.pullback.fst g_Y
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ_Y j)
    (hCenters : HasNonclosedComponentCenters Ω g_W g_Y α_K) :
    let η_K := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
    ∃ h : W ⟶ Y,
      h ≫ g_Y = g_W ∧
      (∀ j : Fin n, τ_W j ≫ h = τ_Y j) ∧
      CategoryTheory.Limits.pullback.fst g_W η_K ≫ h =
        α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K :=
by
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  obtain ⟨Γ, ι_Γ, e_K, hGraph, hDichot⟩ :=
    weil_nc2d_graph_closure_exists Ω n W Y g_W τ_W g_Y τ_Y α_K hW hY hαK_snd
  have hFib : ∀ w : ↥W,
      ((ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y).base ⁻¹' {w}).Finite := by
    intro w
    rcases hDichot w with hw_gen | ⟨q_W, rfl⟩
    · apply Set.Subsingleton.finite
      intro z₁ hz₁ z₂ hz₂
      let p₁ := ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y
      have : AlgebraicGeometry.IsOpenImmersion
          (CategoryTheory.Limits.pullback.fst g_W η_K) := hGraph.2.2.2.2.1
      have he_p₁ : e_K ≫ p₁ = CategoryTheory.Limits.pullback.fst g_W η_K :=
        hGraph.2.2.2.2.2.2.1
      have hRange₁ : Set.range e_K.base =
          p₁.base ⁻¹' Set.range (CategoryTheory.Limits.pullback.fst g_W η_K).base :=
        hGraph.2.2.2.2.2.2.2.2.1
      have hz₁_mem : z₁ ∈ Set.range e_K.base := by
        rw [hRange₁]
        change p₁.base z₁ ∈ Set.range (CategoryTheory.Limits.pullback.fst g_W η_K).base
        have hz₁_eq : p₁.base z₁ = w := hz₁
        rw [hz₁_eq]
        exact hw_gen
      have hz₂_mem : z₂ ∈ Set.range e_K.base := by
        rw [hRange₁]
        change p₁.base z₂ ∈ Set.range (CategoryTheory.Limits.pullback.fst g_W η_K).base
        have hz₂_eq : p₁.base z₂ = w := hz₂
        rw [hz₂_eq]
        exact hw_gen
      obtain ⟨x₁, rfl⟩ := hz₁_mem
      obtain ⟨x₂, rfl⟩ := hz₂_mem
      have hInj : Function.Injective (CategoryTheory.Limits.pullback.fst g_W η_K).base :=
        (CategoryTheory.Limits.pullback.fst g_W η_K).isOpenEmbedding.injective
      have hx₁_eq : (CategoryTheory.Limits.pullback.fst g_W η_K).base x₁ = w := by
        rw [← he_p₁]
        exact hz₁
      have hx₂_eq : (CategoryTheory.Limits.pullback.fst g_W η_K).base x₂ = w := by
        rw [← he_p₁]
        exact hz₂
      rw [hInj (hx₁_eq.trans hx₂_eq.symm)]
    · by_cases hClosed : IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback g_W s_Ω))
      · exact weil_nc2d_graph_fiber_finite_at_closed_point
          Ω n W Y Γ g_W τ_W g_Y τ_Y α_K ι_Γ e_K hW hY hCenters hGraph q_W hClosed
      · exact weil_nc2d_graph_fiber_finite_at_nonclosed_point
          Ω n W Y Γ g_W τ_W g_Y α_K ι_Γ e_K hW hGraph q_W hClosed
  exact weil_nc2d_graph_isIso_and_pointed_extension_of_finite_fibers
    Ω n W Y Γ g_W τ_W g_Y τ_Y α_K ι_Γ e_K hW hY hNormW hαK_sec hGraph hFib

theorem weil_nc2d_blowup_tower_eliminating_closed_centers (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C₂))
    (ψ_K : CategoryTheory.Limits.pullback g₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g₂
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hNC₁ : IsNC2DPointedSurface Ω n g₁ τ₁)
    (hNC₂ : IsNC2DPointedSurface Ω n g₂ τ₂)
    (hψK_snd : ψ_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g₁
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hψK_sec : ∀ j : Fin n,
      ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
          CategoryTheory.Limits.pullback g₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
        (s₁ ≫ ψ_K.hom) ≫ CategoryTheory.Limits.pullback.fst g₂
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))) ≫
            τ₂ j)
    (hBlowup : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
      (q₀ : ↥(CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))),
      IsNC2DPointedSurface Ω n g_W τ_W →
      IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))) →
      ∃ (W' : AlgebraicGeometry.Scheme.{u})
        (g_W' : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
        (τ_W' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W'))
        (π : W' ⟶ W),
        IsNC2DClosedPointBlowup Ω n g_W τ_W g_W' τ_W' q₀ π) :
    let η_K := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∃ (N : ℕ)
      (W_seq : Fin (N + 1) → AlgebraicGeometry.Scheme.{u})
      (g_seq : ∀ i : Fin (N + 1), W_seq i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_seq : ∀ i : Fin (N + 1), Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W_seq i))
      (centers : ∀ i : Fin N, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω))
      (maps : ∀ i : Fin N, W_seq i.succ ⟶ W_seq i.castSucc)
      (π_from : ∀ i : Fin (N + 1), W_seq i ⟶ C₁)
      (α_N : CategoryTheory.Limits.pullback (g_seq (Fin.last N)) η_K ≅
        CategoryTheory.Limits.pullback g₂ η_K),
      IsNC2DBlowupTower Ω n g₁ τ₁ N W_seq g_seq τ_seq centers maps π_from ∧
      α_N.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
        CategoryTheory.Limits.pullback.snd (g_seq (Fin.last N)) η_K ∧
      CategoryTheory.Limits.pullback.fst (g_seq (Fin.last N)) η_K ≫ π_from (Fin.last N) =
        (α_N.hom ≫ ψ_K.inv) ≫ CategoryTheory.Limits.pullback.fst g₁ η_K ∧
      (∀ j : Fin n,
        ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω))) ⟶
            CategoryTheory.Limits.pullback (g_seq (Fin.last N)) η_K),
          s₁ ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last N)) η_K =
            η_K ≫ τ_seq (Fin.last N) j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd (g_seq (Fin.last N)) η_K =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) →
          (s₁ ≫ α_N.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_K = η_K ≫ τ₂ j) ∧
      HasNonclosedComponentCenters Ω (g_seq (Fin.last N)) g₂ α_N :=
by
  let RStar := PowerSeries Ω
  let KStar := FractionRing RStar
  let S := AlgebraicGeometry.Spec (CommRingCat.of RStar)
  let η_K : AlgebraicGeometry.Spec (CommRingCat.of KStar) ⟶ S :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap RStar KStar))
  let s_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (PowerSeries.constantCoeff : RStar →+* Ω))

  
  
  
  have bot_prime_of_domain : ∀ (D : Type u) [CommRing D] [IsDomain D], (⊥ : Ideal D).IsPrime :=
    fun D _ _ => ⟨bot_ne_top, fun {a b} hab => by simpa using hab⟩

  have dvr_unit_mul_pow : ∀ {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      {ϖ : R}, Irreducible ϖ → ∀ {x : R}, x ≠ 0 → ∃ (u : Rˣ) (d : ℕ), x = (u : R) * ϖ ^ d := by
    intro R _ _ _ ϖ hϖ x hx
    obtain ⟨d, hd⟩ := IsDiscreteValuationRing.associated_pow_irreducible hx hϖ
    obtain ⟨u, hux⟩ := hd.symm
    exact ⟨u, d, by rw [← hux, mul_comm]⟩

  have hsΩ_surj : Function.Surjective (PowerSeries.constantCoeff : RStar →+* Ω) :=
    fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩
  have hsΩ_closed : AlgebraicGeometry.IsClosedImmersion s_Ω :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (PowerSeries.constantCoeff : RStar →+* Ω)) hsΩ_surj

  let pt_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) := ⟨⊥, bot_prime_of_domain Ω⟩
  have pt_field_eq : ∀ {F : Type u} [Field F] (p q : AlgebraicGeometry.Spec (CommRingCat.of F)),
      p = q := by
    intro F _ p q
    have hbot : ∀ x : AlgebraicGeometry.Spec (CommRingCat.of F), x.asIdeal = ⊥ := by
      intro x
      ext a
      simp only [Ideal.mem_bot]
      constructor
      · intro ha
        by_contra ha0
        exact x.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem x.asIdeal ha (Ne.isUnit ha0))
      · rintro rfl; exact Ideal.zero_mem _
    exact PrimeSpectrum.ext ((hbot p).trans (hbot q).symm)

  have hsΩ_pt : ∀ P : AlgebraicGeometry.Spec (CommRingCat.of RStar),
      (PowerSeries.X : RStar) ∈ P.asIdeal ↔ P = s_Ω.base pt_Ω := by
    intro P
    have hmem_sΩ : ∀ f : RStar,
        f ∈ (s_Ω.base pt_Ω).asIdeal ↔ (PowerSeries.constantCoeff : RStar →+* Ω) f = 0 := by
      intro f
      change f ∈ Ideal.comap (PowerSeries.constantCoeff : RStar →+* Ω) ⊥ ↔ _
      rw [Ideal.mem_comap, Ideal.mem_bot]
    constructor
    · intro hX
      apply PrimeSpectrum.ext
      ext f
      rw [hmem_sΩ]
      constructor
      · intro hf
        by_contra hc0
        have hdiff : (PowerSeries.constantCoeff : RStar →+* Ω)
            (f - PowerSeries.C ((PowerSeries.constantCoeff : RStar →+* Ω) f)) = 0 := by
          simp
        obtain ⟨g, hg⟩ := PowerSeries.X_dvd_iff.mpr hdiff
        have hsub_mem :
            f - PowerSeries.C ((PowerSeries.constantCoeff : RStar →+* Ω) f) ∈ P.asIdeal := by
          rw [hg]; exact Ideal.mul_mem_right g P.asIdeal hX
        have hC_mem : PowerSeries.C ((PowerSeries.constantCoeff : RStar →+* Ω) f) ∈ P.asIdeal := by
          have := P.asIdeal.sub_mem hf hsub_mem
          simpa using this
        have hC_unit : IsUnit (PowerSeries.C ((PowerSeries.constantCoeff : RStar →+* Ω) f)) :=
          (Ne.isUnit hc0).map PowerSeries.C
        exact P.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem P.asIdeal hC_mem hC_unit)
      · intro hf0
        obtain ⟨g, rfl⟩ := PowerSeries.X_dvd_iff.mpr hf0
        exact Ideal.mul_mem_right g P.asIdeal hX
    · rintro rfl
      rw [hmem_sΩ]
      exact PowerSeries.constantCoeff_X

  have hLocAwayX : IsLocalization.Away (PowerSeries.X : RStar) KStar := by
    have hinj : Function.Injective (algebraMap RStar KStar) := IsFractionRing.injective RStar KStar
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · rintro ⟨y, k, rfl⟩
      have hy_ne : ((PowerSeries.X : RStar) ^ k) ≠ 0 := pow_ne_zero k PowerSeries.X_ne_zero
      have hmap_ne : algebraMap RStar KStar ((PowerSeries.X : RStar) ^ k) ≠ 0 :=
        fun h => hy_ne (hinj (h.trans (map_zero _).symm))
      exact Ne.isUnit hmap_ne
    · intro z
      obtain ⟨⟨a, b⟩, hzb⟩ := IsLocalization.surj (nonZeroDivisors RStar) z
      have hb_ne : (b : RStar) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
      obtain ⟨u, k, hbu⟩ := dvr_unit_mul_pow PowerSeries.X_irreducible hb_ne
      refine ⟨⟨↑u⁻¹ * a, ⟨(PowerSeries.X : RStar) ^ k, k, rfl⟩⟩, ?_⟩
      have hu_inv : algebraMap RStar KStar ↑u⁻¹ * algebraMap RStar KStar ↑u = 1 := by
        rw [← map_mul, Units.inv_mul, map_one]
      calc z * algebraMap RStar KStar ((PowerSeries.X : RStar) ^ k)
          = z * ((algebraMap RStar KStar ↑u⁻¹ * algebraMap RStar KStar ↑u) *
              algebraMap RStar KStar ((PowerSeries.X : RStar) ^ k)) := by
              rw [hu_inv, one_mul]
        _ = algebraMap RStar KStar ↑u⁻¹ *
              (z * (algebraMap RStar KStar ↑u * algebraMap RStar KStar ((PowerSeries.X : RStar) ^ k))) := by
              ring
        _ = algebraMap RStar KStar ↑u⁻¹ * (z * algebraMap RStar KStar (b : RStar)) := by
              rw [hbu, map_mul]
        _ = algebraMap RStar KStar (↑u⁻¹ * a) := by
              rw [hzb, map_mul]
    · intro x y hxy
      exact ⟨1, by simp [hinj hxy]⟩
  have hηK_open : AlgebraicGeometry.IsOpenImmersion η_K :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization (PowerSeries.X : RStar)

  have lift_spec_local : ∀ {V : Type u} [CommRing V] [IsLocalRing V]
      (m_V : AlgebraicGeometry.Spec (CommRingCat.of V))
      (hm_V : m_V.asIdeal = IsLocalRing.maximalIdeal V)
      {Y X : AlgebraicGeometry.Scheme.{u}} (ι : Y ⟶ X) [AlgebraicGeometry.IsOpenImmersion ι]
      (f : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ X),
      f.base m_V ∈ Set.range ι.base →
      ∃ g : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ Y, g ≫ ι = f := by
    intro V _ _ m_V hm_V Y X ι _ f hmem
    have hrange : Set.range f.base ⊆ Set.range ι.base := by
      rintro _ ⟨q, rfl⟩
      have hle : q.asIdeal ≤ m_V.asIdeal := hm_V ▸ IsLocalRing.le_maximalIdeal q.isPrime.ne_top
      have hspec : q ⤳ m_V := (PrimeSpectrum.le_iff_specializes q m_V).mp hle
      exact (hspec.map f.continuous).mem_open ι.isOpenEmbedding.isOpen_range hmem
    exact ⟨AlgebraicGeometry.IsOpenImmersion.lift ι f hrange,
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι f hrange⟩

  have dominant_of_injective : ∀ {A B : Type u} [CommRing A] [IsDomain A] [Field B]
      (φ : A →+* B), Function.Injective φ →
      AlgebraicGeometry.IsDominant (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro A B _ _ _ φ hinj
    rw [AlgebraicGeometry.isDominant_iff]
    intro p
    let pt_B : AlgebraicGeometry.Spec (CommRingCat.of B) := ⟨⊥, bot_prime_of_domain B⟩
    let p₀ : AlgebraicGeometry.Spec (CommRingCat.of A) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base pt_B
    have hp₀_bot : p₀.asIdeal = ⊥ := by
      change Ideal.comap φ ⊥ = ⊥
      ext x
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      exact ⟨fun hx => hinj (hx.trans (map_zero φ).symm), fun hx => by rw [hx, map_zero]⟩
    have hle : p₀.asIdeal ≤ p.asIdeal := by rw [hp₀_bot]; exact bot_le
    have hspec : p₀ ⤳ p := (PrimeSpectrum.le_iff_specializes p₀ p).mp hle
    have hp₀_mem : p₀ ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base :=
      ⟨pt_B, rfl⟩
    exact closure_mono (Set.singleton_subset_iff.mpr hp₀_mem) hspec.mem_closure

  
  let IsCompDVR : ∀ (F' : Set ↥(CategoryTheory.Limits.pullback g₂ s_Ω))
      (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
      (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
      (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
        CategoryTheory.Limits.pullback g₂ η_K)
      (ξ : V), Prop :=
    fun F' V _ _ _ v_Y u_Y ξ =>
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_Y =
        u_Y ≫ CategoryTheory.Limits.pullback.fst g₂ η_K ∧
      (∀ c : Ω, ξ - (AlgebraicGeometry.Spec.preimage (v_Y ≫ g₂)).hom (PowerSeries.C c) ∉
        IsLocalRing.maximalIdeal V) ∧
      ∃ (m_V : AlgebraicGeometry.Spec (CommRingCat.of V))
        (q_Y : ↥(CategoryTheory.Limits.pullback g₂ s_Ω))
        (R_Y : CommRingCat.{u})
        (ι_Y : AlgebraicGeometry.Spec R_Y ⟶ C₂)
        (P_Y : AlgebraicGeometry.Spec R_Y)
        (φ_Y : R_Y ⟶ CommRingCat.of V)
        (r_ξ : R_Y),
        m_V.asIdeal = IsLocalRing.maximalIdeal V ∧
        IsGenericPoint q_Y F' ∧
        v_Y.base m_V = (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base q_Y ∧
        AlgebraicGeometry.IsOpenImmersion ι_Y ∧
        IsDomain R_Y ∧
        Function.Injective φ_Y.hom ∧
        AlgebraicGeometry.Spec.map φ_Y ≫ ι_Y = v_Y ∧
        φ_Y.hom r_ξ = ξ ∧
        ι_Y.base P_Y = (CategoryTheory.Limits.pullback.fst g₂ s_Ω).base q_Y ∧
        (∀ v : V, ∃ r s : R_Y, s ∉ P_Y.asIdeal ∧ φ_Y.hom s * v = φ_Y.hom r) ∧
        (∀ (B : Type u) [CommRing B] (ρ : R_Y →+* B),
          (∀ s : R_Y, s ∉ P_Y.asIdeal → IsUnit (ρ s)) →
          ∃ ψ : V →+* B, ψ.comp φ_Y.hom = ρ)

  let IsDVRCenter : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      (g_W : W ⟶ S)
      (α_K : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g₂ η_K)
      (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
      (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
      (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
        CategoryTheory.Limits.pullback g₂ η_K)
      (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W)
      (q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω)), Prop :=
    fun {W} g_W α_K V _ _ _ v_Y u_Y v_W q_W =>
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_W =
        u_Y ≫ α_K.inv ≫ CategoryTheory.Limits.pullback.fst g_W η_K ∧
      v_W ≫ g_W = v_Y ≫ g₂ ∧
      ∃ m_V : AlgebraicGeometry.Spec (CommRingCat.of V),
        m_V.asIdeal = IsLocalRing.maximalIdeal V ∧
        v_W.base m_V = (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W

  let HasValBound : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
      (ϖ ξ : V) (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W) (d : ℕ), Prop :=
    fun {W} V _ _ _ ϖ ξ v_W d =>
      ∃ (A : CommRingCat.{u}) (ι_A : AlgebraicGeometry.Spec A ⟶ W)
        (ρ_A : A ⟶ CommRingCat.of V) (a b : A) (u_b : Vˣ),
        AlgebraicGeometry.IsOpenImmersion ι_A ∧
        AlgebraicGeometry.Spec.map ρ_A ≫ ι_A = v_W ∧
        ρ_A.hom b = (u_b : V) * ϖ ^ d ∧
        ρ_A.hom b * ξ = ρ_A.hom a

  let IsTowerIso : ∀ (k : ℕ)
      (W_seq : Fin (k + 1) → AlgebraicGeometry.Scheme.{u})
      (g_seq : ∀ i : Fin (k + 1), W_seq i ⟶ S)
      (τ_seq : ∀ i : Fin (k + 1), Fin n → (S ⟶ W_seq i))
      (centers : ∀ i : Fin k, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω))
      (maps : ∀ i : Fin k, W_seq i.succ ⟶ W_seq i.castSucc)
      (π_from : ∀ i : Fin (k + 1), W_seq i ⟶ C₁)
      (α_k : CategoryTheory.Limits.pullback (g_seq (Fin.last k)) η_K ≅
        CategoryTheory.Limits.pullback g₂ η_K), Prop :=
    fun k W_seq g_seq τ_seq centers maps π_from α_k =>
      IsNC2DBlowupTower Ω n g₁ τ₁ k W_seq g_seq τ_seq centers maps π_from ∧
      α_k.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
        CategoryTheory.Limits.pullback.snd (g_seq (Fin.last k)) η_K ∧
      CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K ≫ π_from (Fin.last k) =
        (α_k.hom ≫ ψ_K.inv) ≫ CategoryTheory.Limits.pullback.fst g₁ η_K ∧
      (∀ j : Fin n,
        ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of KStar) ⟶
            CategoryTheory.Limits.pullback (g_seq (Fin.last k)) η_K),
          s₁ ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K =
            η_K ≫ τ_seq (Fin.last k) j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd (g_seq (Fin.last k)) η_K =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of KStar)) →
          (s₁ ≫ α_k.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_K = η_K ≫ τ₂ j)

  
  
  
  let C₂_0 := CategoryTheory.Limits.pullback g₂ s_Ω
  let fst₂ := CategoryTheory.Limits.pullback.fst g₂ s_Ω
  let snd₂ := CategoryTheory.Limits.pullback.snd g₂ s_Ω
  have : AlgebraicGeometry.IsIntegral C₂ := hNC₂.1
  have : AlgebraicGeometry.IsProper g₂ := hNC₂.2.2.1
  have : AlgebraicGeometry.LocallyOfFinitePresentation g₂ := hNC₂.2.2.2.1
  have : CompactSpace ↥C₂_0 := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace snd₂
  have : AlgebraicGeometry.IsLocallyNoetherian C₂_0 :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian snd₂
  have : AlgebraicGeometry.IsNoetherian C₂_0 := AlgebraicGeometry.IsNoetherian.mk
  have hFinComp : (irreducibleComponents ↥C₂_0).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian

  have hCompDVR : ∀ F' ∈ irreducibleComponents ↥C₂_0,
      ∃ (V : Type u) (_ : CommRing V) (_ : IsDomain V) (_ : IsDiscreteValuationRing V)
        (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
        (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
          CategoryTheory.Limits.pullback g₂ η_K)
        (ξ : V),
        IsCompDVR F' V v_Y u_Y ξ := by
    intro F' hF'
    have hIrredF' : IsIrreducible F' := hF'.1
    have hClF' : IsClosed F' := isClosed_of_mem_irreducibleComponents F' hF'
    let q_Y : ↥C₂_0 := hIrredF'.genericPoint
    have hGen_Y : IsGenericPoint q_Y F' := hIrredF'.isGenericPoint_genericPoint hClF'
    obtain ⟨q₀, hq₀_in_F', hq₀_cl⟩ := hClF'.exists_closed_singleton hIrredF'.nonempty
    obtain ⟨a, b, R_Y, p₀, ι_Y, z₁, z₂, A', v₀, e_U, u, v, ε,
        hιY_open, hp₀_q₀, hDom_RY, hp₀_span, _hz₁_ne, _hz₂_reg, _hRY_res,
        hEt_eU, hDom_A', heU_pre, hv₀_span, hu_ne, hv_reg, _hA'_res,
        hε_unit, ha_pos, hX_eq⟩ := hNC₂.2.2.2.2.2.2.2.2 q₀ hq₀_cl
    have : AlgebraicGeometry.IsOpenImmersion ι_Y := hιY_open
    have : AlgebraicGeometry.Etale e_U := hEt_eU
    have : IsDomain R_Y := hDom_RY
    have : IsDomain A' := hDom_A'
    let J_p0 : Ideal R_Y := p₀.asIdeal
    let J_v0 : Ideal A' := v₀.asIdeal
    have : J_p0.IsPrime := p₀.isPrime
    have : J_v0.IsPrime := v₀.isPrime
    have hqY_ne_q₀ : q_Y ≠ q₀ := by
      intro hq_eq
      have hF'_eq : F' = {q₀} := by
        rw [← hGen_Y, hq_eq, hq₀_cl.closure_eq]
      let f₀ : A' →+* Localization.AtPrime J_v0 := algebraMap A' (Localization.AtPrime J_v0)
      have hinj_f₀ : Function.Injective f₀ :=
        IsLocalization.injective (Localization.AtPrime J_v0)
          (Ideal.primeCompl_le_nonZeroDivisors J_v0)
      have hv_pow_reg : ∀ (k : ℕ) (s : A'),
          v ^ k * s ∈ Ideal.span ({u} : Set A') → s ∈ Ideal.span ({u} : Set A') := by
        intro k
        induction k with
        | zero => intro s hs; simpa using hs
        | succ k ih =>
          intro s hs
          rw [pow_succ', mul_assoc] at hs
          exact ih s (hv_reg _ hs)
      have hfv_not_rad : f₀ v ∉ (Ideal.span ({f₀ u} : Set (Localization.AtPrime J_v0))).radical := by
        rintro ⟨k, hk⟩
        rw [Ideal.mem_span_singleton] at hk
        obtain ⟨c, hc⟩ := hk
        obtain ⟨⟨y, s⟩, hcs⟩ := IsLocalization.surj J_v0.primeCompl c
        have h_eqA : v ^ k * (s : A') = u * y := by
          apply hinj_f₀
          calc f₀ (v ^ k * (s : A'))
              = (f₀ v) ^ k * f₀ (s : A') := by rw [map_mul, map_pow]
            _ = (f₀ u * c) * f₀ (s : A') := by rw [hc]
            _ = f₀ u * (c * f₀ (s : A')) := by ring
            _ = f₀ (u * y) := by rw [hcs, map_mul]
        have hs_in_u : (s : A') ∈ Ideal.span ({u} : Set A') :=
          hv_pow_reg k s (Ideal.mem_span_singleton.mpr ⟨y, h_eqA⟩)
        have hu_in_v0 : u ∈ J_v0 := by
          change u ∈ v₀.asIdeal
