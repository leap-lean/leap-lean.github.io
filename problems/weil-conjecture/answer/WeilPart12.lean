          rw [IsLocalization.lift_eq, hρ_D_α]
        have hρ_loc_ker : RingHom.ker ρ_loc = IsLocalRing.maximalIdeal R_loc :=
          IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ρ_loc hρ_loc_surj)
        have hρ_loc_res : ∀ x : R_loc,
            x - ψ₁_loc (algebraMap R₀ R_y (α_R (ρ_loc x))) ∈ IsLocalRing.maximalIdeal R_loc := by
          intro x
          rw [← hρ_loc_ker, RingHom.mem_ker, map_sub, Localization.localRingHom_to_map,
            IsLocalization.lift_eq, hρ_D_α, sub_self]
        have hLift_max : ∀ 𝔪 : Ideal S_E, 𝔪.IsPrime → Ideal.comap φ₀ 𝔪 = p_y →
            ∃ M : Ideal S_loc, M.IsMaximal ∧ Ideal.comap j_S M = 𝔪 := by
          intro 𝔪 h𝔪_prime h𝔪_over
          have h𝔪_max : 𝔪.IsMaximal := hMax_of_over 𝔪 h𝔪_prime h𝔪_over
          let _ : 𝔪.IsMaximal := h𝔪_max
          obtain ⟨_, h𝔪_res, _⟩ := @hS_pir 𝔪 h𝔪_max h𝔪_over
          let β_𝔪 : Ω →+* (S_E ⧸ 𝔪) := (Ideal.Quotient.mk 𝔪).comp (φ₀.comp α_R)
          have hβ_𝔪_bij : Function.Bijective β_𝔪 := by
            refine ⟨β_𝔪.injective, fun z => ?_⟩
            obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective z
            obtain ⟨c, hc⟩ := h𝔪_res s
            exact ⟨c, (Ideal.Quotient.eq.mpr hc).symm⟩
          let e_𝔪 : Ω ≃+* (S_E ⧸ 𝔪) := RingEquiv.ofBijective β_𝔪 hβ_𝔪_bij
          let ρ_𝔪 : S_E →+* Ω := e_𝔪.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪)
          have hρ_𝔪_ker : ∀ s : S_E, ρ_𝔪 s = 0 ↔ s ∈ 𝔪 := by
            intro s
            change e_𝔪.symm (Ideal.Quotient.mk 𝔪 s) = 0 ↔ s ∈ 𝔪
            rw [map_eq_zero_iff e_𝔪.symm e_𝔪.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
          have hρ_𝔪_α : ∀ c : Ω, ρ_𝔪 (φ₀ (α_R c)) = c := fun c => e_𝔪.symm_apply_apply c
          have hρ_agree_R₀ : ∀ r : R₀, ρ_D (ψ₁ r) = ρ_𝔪 (φ₀ r) := by
            intro r
            let c := ρ_𝔪 (φ₀ r)
            have hmem_m : φ₀ (r - α_R c) ∈ 𝔪 := by
              rw [← hρ_𝔪_ker, map_sub, map_sub, hρ_𝔪_α, sub_self]
            have hmem_py : r - α_R c ∈ p_y := by
              rw [← h𝔪_over]; exact hmem_m
            have hmem_w₀ : ψ₁ (r - α_R c) ∈ w₀ := by
              rw [← Ideal.mem_comap, hw₀_over]; exact hmem_py
            have hsub0 : ρ_D (ψ₁ (r - α_R c)) = 0 := (hρ_D_ker _).mpr hmem_w₀
            rw [map_sub, map_sub, hρ_D_α, sub_eq_zero] at hsub0
            exact hsub0
          have hρ_𝔪_units : ∀ v : M_y, IsUnit (ρ_𝔪 v) := by
            rintro ⟨_, c, hc, rfl⟩
            exact IsUnit.mk0 _ (fun h => hc (h𝔪_over ▸ (hρ_𝔪_ker (φ₀ c)).mp h))
          let ρ_Sy : S_y →+* Ω := IsLocalization.lift hρ_𝔪_units
          have hρ_agree_Ry : ∀ r_y : R_y, ρ_loc (ψ₁_loc r_y) = ρ_Sy (φ_y r_y) := by
            suffices ρ_loc.comp ψ₁_loc = ρ_Sy.comp φ_y from RingHom.congr_fun this
            apply IsLocalization.ringHom_ext p_y.primeCompl
            ext r
            change ρ_loc (ψ₁_loc (algebraMap R₀ R_y r)) = ρ_Sy (φ_y (algebraMap R₀ R_y r))
            rw [Localization.localRingHom_to_map, IsLocalization.lift_eq,
              IsLocalization.map_eq, IsLocalization.lift_eq]
            exact hρ_agree_R₀ r
          let _ : Algebra R_y Ω := (ρ_loc.comp ψ₁_loc).toAlgebra
          have : IsScalarTower R_y R_y Ω := IsScalarTower.left R_y
          let f_L : R_loc →ₐ[R_y] Ω := { ρ_loc with commutes' := fun _ => rfl }
          let f_R : S_y →ₐ[R_y] Ω := { ρ_Sy with commutes' := fun r_y => (hρ_agree_Ry r_y).symm }
          let ev_alg : S_loc →ₐ[R_y] Ω :=
            Algebra.TensorProduct.lift f_L f_R (fun _ _ => mul_comm _ _)
          let ev_𝔪 : S_loc →+* Ω := ev_alg.toRingHom
          have hev_tmul : ∀ (x : R_loc) (y : S_y), ev_𝔪 (x ⊗ₜ[R_y] y) = ρ_loc x * ρ_Sy y :=
            fun x y => Algebra.TensorProduct.lift_tmul f_L f_R (fun _ _ => mul_comm _ _) x y
          have hev_surj : Function.Surjective ev_𝔪 := by
            intro c
            obtain ⟨x, hx⟩ := hρ_loc_surj c
            refine ⟨Φ_loc x, ?_⟩
            change ev_𝔪 (x ⊗ₜ[R_y] (1 : S_y)) = c
            rw [hev_tmul, map_one, mul_one, hx]
          refine ⟨RingHom.ker ev_𝔪, RingHom.ker_isMaximal_of_surjective ev_𝔪 hev_surj, ?_⟩
          ext s
          change ev_𝔪 ((1 : R_loc) ⊗ₜ[R_y] algebraMap S_E S_y s) = 0 ↔ s ∈ 𝔪
          rw [hev_tmul, map_one, one_mul, IsLocalization.lift_eq, hρ_𝔪_ker]
        have hMax_comap_Rloc : ∀ M : Ideal S_loc, M.IsMaximal →
            Ideal.comap Φ_loc M = IsLocalRing.maximalIdeal R_loc := by
          intro M hM
          let _ : M.IsMaximal := hM
          have hmax : (Ideal.comap Φ_loc M).IsMaximal :=
            Ideal.isMaximal_comap_of_isIntegral_of_isMaximal Φ_loc
              (fun z => Algebra.IsIntegral.isIntegral z) M
          exact IsLocalRing.eq_maximalIdeal hmax
        have hMax_over_py : ∀ M : Ideal S_loc, M.IsMaximal →
            (Ideal.comap j_S M).IsPrime ∧ Ideal.comap φ₀ (Ideal.comap j_S M) = p_y := by
          intro M hM
          let _ : M.IsMaximal := hM
          refine ⟨Ideal.IsPrime.comap j_S, ?_⟩
          have hcomp_eq : j_S.comp φ₀ = (Φ_loc.comp (algebraMap D_Ω R_loc)).comp ψ₁ :=
            RingHom.ext fun r => (hComm_R₀ r).symm
          change Ideal.comap (j_S.comp φ₀) M = p_y
          rw [hcomp_eq, ← Ideal.comap_comap, ← Ideal.comap_comap, hMax_comap_Rloc M hM]
          have hunder : Ideal.under D_Ω (IsLocalRing.maximalIdeal R_loc) = w₀ :=
            IsLocalization.AtPrime.under_maximalIdeal R_loc w₀
          change Ideal.comap ψ₁ (Ideal.under D_Ω (IsLocalRing.maximalIdeal R_loc)) = p_y
          rw [hunder, hw₀_over]
        have hMax_inj : ∀ M₁ M₂ : Ideal S_loc, M₁.IsMaximal → M₂.IsMaximal →
            Ideal.comap j_S M₁ = Ideal.comap j_S M₂ → M₁ = M₂ := by
          intro M₁ M₂ hM₁ hM₂ hcomap_eq
          have hSy_eq : Ideal.comap j_Sy M₁ = Ideal.comap j_Sy M₂ := by
            ext y
            obtain ⟨p_surj, hyu⟩ := IsLocalization.surj M_y y
            rcases p_surj with ⟨s, u⟩
            dsimp only at hyu
            have hu_unit : IsUnit (algebraMap S_E S_y u.1) := IsLocalization.map_units S_y u
            have h_iff : ∀ M : Ideal S_loc, y ∈ Ideal.comap j_Sy M ↔ s ∈ Ideal.comap j_S M := by
              intro M
              constructor
              · intro hy
                have hmul : y * algebraMap S_E S_y u.1 ∈ Ideal.comap j_Sy M :=
                  Ideal.mul_mem_right _ _ hy
                rw [hyu] at hmul
                exact hmul
              · intro hs
                obtain ⟨v, hv⟩ := hu_unit.exists_right_inv
                have hs' : algebraMap S_E S_y s ∈ Ideal.comap j_Sy M := hs
                have hmul : algebraMap S_E S_y s * v ∈ Ideal.comap j_Sy M :=
                  Ideal.mul_mem_right _ _ hs'
                have hy_eq : y = algebraMap S_E S_y s * v := by
                  calc y = y * (algebraMap S_E S_y u.1 * v) := by rw [hv, mul_one]
                    _ = (y * algebraMap S_E S_y u.1) * v := by ring
                    _ = algebraMap S_E S_y s * v := by rw [hyu]
                rwa [← hy_eq] at hmul
            rw [h_iff M₁, hcomap_eq, ← h_iff M₂]
          have hMod_Rloc : ∀ z : S_loc, ∃ y_z : S_y,
              z - j_Sy y_z ∈ Ideal.map Φ_loc (IsLocalRing.maximalIdeal R_loc) := by
            intro z
            induction z using TensorProduct.induction_on with
            | zero => exact ⟨0, by simp⟩
            | tmul x y =>
              let r_x : R_y := algebraMap R₀ R_y (α_R (ρ_loc x))
              let m_x : R_loc := x - ψ₁_loc r_x
              have hm_x : m_x ∈ IsLocalRing.maximalIdeal R_loc := hρ_loc_res x
              refine ⟨φ_y r_x * y, ?_⟩
              have heq : (x ⊗ₜ[R_y] y : S_loc) - j_Sy (φ_y r_x * y) = Φ_loc m_x * j_Sy y := by
                have h1 : j_Sy (φ_y r_x * y) = (ψ₁_loc r_x) ⊗ₜ[R_y] y := by
                  calc (1 : R_loc) ⊗ₜ[R_y] (r_x • y)
                      = (r_x • (1 : R_loc)) ⊗ₜ[R_y] y := (TensorProduct.smul_tmul r_x 1 y).symm
                    _ = (ψ₁_loc r_x) ⊗ₜ[R_y] y := by
                          change (ψ₁_loc r_x * 1) ⊗ₜ[R_y] y = _
                          rw [mul_one]
                change (x ⊗ₜ[R_y] y) - j_Sy (φ_y r_x * y) = (m_x ⊗ₜ[R_y] 1) * (1 ⊗ₜ[R_y] y)
                rw [h1, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, ← TensorProduct.sub_tmul]
              rw [heq]
              exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem Φ_loc hm_x)
            | add z₁ z₂ ih₁ ih₂ =>
              obtain ⟨y₁, hy₁⟩ := ih₁
              obtain ⟨y₂, hy₂⟩ := ih₂
              refine ⟨y₁ + y₂, ?_⟩
              have heq : (z₁ + z₂) - j_Sy (y₁ + y₂) = (z₁ - j_Sy y₁) + (z₂ - j_Sy y₂) := by
                rw [map_add]; ring
              rw [heq]
              exact add_mem hy₁ hy₂
          have hMap_le₁ : Ideal.map Φ_loc (IsLocalRing.maximalIdeal R_loc) ≤ M₁ := by
            rw [Ideal.map_le_iff_le_comap, hMax_comap_Rloc M₁ hM₁]
          have hMap_le₂ : Ideal.map Φ_loc (IsLocalRing.maximalIdeal R_loc) ≤ M₂ := by
            rw [Ideal.map_le_iff_le_comap, hMax_comap_Rloc M₂ hM₂]
          ext z
          obtain ⟨y_z, hy_z⟩ := hMod_Rloc z
          have h1 : z - j_Sy y_z ∈ M₁ := hMap_le₁ hy_z
          have h2 : z - j_Sy y_z ∈ M₂ := hMap_le₂ hy_z
          have hiff₁ : z ∈ M₁ ↔ y_z ∈ Ideal.comap j_Sy M₁ := by
            constructor
            · intro hz
              have hmem : z - (z - j_Sy y_z) ∈ M₁ := sub_mem hz h1
              simpa using hmem
            · intro hy
              have hmem : (z - j_Sy y_z) + j_Sy y_z ∈ M₁ := add_mem h1 hy
              simpa using hmem
          have hiff₂ : z ∈ M₂ ↔ y_z ∈ Ideal.comap j_Sy M₂ := by
            constructor
            · intro hz
              have hmem : z - (z - j_Sy y_z) ∈ M₂ := sub_mem hz h2
              simpa using hmem
            · intro hy
              have hmem : (z - j_Sy y_z) + j_Sy y_z ∈ M₂ := add_mem h2 hy
              simpa using hmem
          rw [hiff₁, hSy_eq, ← hiff₂]
        have hStalk_dvr : ∀ M : Ideal S_loc, (hM : M.IsMaximal) →
            let _ : M.IsPrime := hM.isPrime
            ∃ (_ : IsDomain (Localization.AtPrime M)),
              IsLocalRing.maximalIdeal (Localization.AtPrime M) ≠ ⊥ := by
          intro M hM
          let _ : M.IsMaximal := hM
          obtain ⟨h𝔪M_prime, h𝔪M_over⟩ := hMax_over_py M hM
          have h𝔪M_max : (Ideal.comap j_S M).IsMaximal :=
            hMax_of_over (Ideal.comap j_S M) h𝔪M_prime h𝔪M_over
          obtain ⟨h𝔪M_ne, _, h𝔪M_pir⟩ := @hS_pir (Ideal.comap j_S M) h𝔪M_max h𝔪M_over
          let _ : Algebra R₀ S_E := φ₀.toAlgebra
          let _ : Algebra R₀ D_Ω := ψ₁.toAlgebra
          let T_Ω := TensorProduct R₀ S_E D_Ω
          have hEt_T : (algebraMap S_E T_Ω).Etale := by
            have : Algebra.Etale R₀ D_Ω := RingHom.etale_algebraMap.mp hψ₁
            have : Algebra.Etale S_E T_Ω := Algebra.Etale.baseChange R₀ D_Ω S_E
            exact RingHom.etale_algebraMap.mpr ‹_›
          have hAlgMap_R₀_Sloc : ∀ r : R₀, algebraMap R₀ S_loc r = j_S (φ₀ r) := hComm_R₀
          let j_L : S_E →ₐ[R₀] S_loc :=
            { j_S with commutes' := fun r => (hAlgMap_R₀_Sloc r).symm }
          let j_R : D_Ω →ₐ[R₀] S_loc :=
            { Φ_loc.comp (algebraMap D_Ω R_loc) with
              commutes' := fun r => (hComm_R₀ r).trans (hAlgMap_R₀_Sloc r).symm }
          let j_alg : T_Ω →ₐ[R₀] S_loc :=
            Algebra.TensorProduct.lift j_L j_R (fun _ _ => mul_comm _ _)
          let j_loc : T_Ω →+* S_loc := j_alg.toRingHom
          have hj_loc_tmul : ∀ (s : S_E) (d : D_Ω),
              j_loc (s ⊗ₜ[R₀] d) = j_S s * Φ_loc (algebraMap D_Ω R_loc d) := fun s d =>
            Algebra.TensorProduct.lift_tmul j_L j_R (fun _ _ => mul_comm _ _) s d
          let M' : Ideal T_Ω := Ideal.comap j_loc M
          have _ : M'.IsPrime := Ideal.IsPrime.comap j_loc
          have hM'_over : Ideal.comap (algebraMap S_E T_Ω) M' = Ideal.comap j_S M := by
            ext s
            change j_loc (s ⊗ₜ[R₀] (1 : D_Ω)) ∈ M ↔ j_S s ∈ M
            rw [hj_loc_tmul, map_one, map_one, mul_one]
          let _ : (Ideal.comap j_S M).IsPrime := h𝔪M_prime
          obtain ⟨hDom_M', hDvr_M'⟩ :=
            hEtDvr S_E T_Ω (algebraMap S_E T_Ω) hEt_T (Ideal.comap j_S M) h𝔪M_ne h𝔪M_pir M' hM'_over
          let _ : IsDomain (Localization.AtPrime M') := hDom_M'
          let _ : IsDiscreteValuationRing (Localization.AtPrime M') := hDvr_M'
          let α_M : Localization.AtPrime M' →+* Localization.AtPrime M :=
            Localization.localRingHom M' M j_loc rfl
          have : IsLocalHom α_M := Localization.isLocalHom_localRingHom M' M j_loc rfl
          let ι_S : S_E →+* T_Ω := algebraMap S_E T_Ω
          let ι_D : D_Ω →+* T_Ω := Algebra.TensorProduct.includeRight.toRingHom
          have hι_comm : ∀ r : R₀, ι_D (ψ₁ r) = ι_S (φ₀ r) := by
            intro r
            calc ι_D (ψ₁ r)
                = (1 : S_E) ⊗ₜ[R₀] (r • (1 : D_Ω)) := by
                    change (1 : S_E) ⊗ₜ[R₀] (ψ₁ r) = (1 : S_E) ⊗ₜ[R₀] (ψ₁ r * 1)
                    rw [mul_one]
              _ = (r • (1 : S_E)) ⊗ₜ[R₀] (1 : D_Ω) := (TensorProduct.smul_tmul r 1 1).symm
              _ = ι_S (φ₀ r) := by
                    change (φ₀ r * 1) ⊗ₜ[R₀] (1 : D_Ω) = (φ₀ r) ⊗ₜ[R₀] (1 : D_Ω)
                    rw [mul_one]
          have hg_D_units : ∀ u : w₀.primeCompl,
              IsUnit (((algebraMap T_Ω (Localization.AtPrime M')).comp ι_D) u) := by
            intro u
            have hu_not_M' : ι_D u.1 ∉ M' := by
              intro hmem
              have hj_u : j_loc (ι_D u.1) = Φ_loc (algebraMap D_Ω R_loc u.1) := by
                change j_loc (1 ⊗ₜ[R₀] u.1) = _
                rw [hj_loc_tmul, map_one, one_mul]
              have hmem_M : Φ_loc (algebraMap D_Ω R_loc u.1) ∈ M := hj_u ▸ hmem
              have hmem_max : algebraMap D_Ω R_loc u.1 ∈ IsLocalRing.maximalIdeal R_loc := by
                rw [← hMax_comap_Rloc M hM]; exact hmem_M
              exact u.2 ((IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc w₀ u.1).mp hmem_max)
            exact IsLocalization.map_units (Localization.AtPrime M')
              (⟨ι_D u.1, hu_not_M'⟩ : M'.primeCompl)
          let g_loc : R_loc →+* Localization.AtPrime M' := IsLocalization.lift hg_D_units
          have hg_S_units : ∀ v : M_y,
              IsUnit (((algebraMap T_Ω (Localization.AtPrime M')).comp ι_S) v) := by
            rintro ⟨_, c, hc, rfl⟩
            have hc_not_M' : ι_S (φ₀ c) ∉ M' := by
              intro hmem
              have hc_m : φ₀ c ∈ Ideal.comap j_S M := hM'_over ▸ hmem
              exact hc (h𝔪M_over ▸ hc_m)
            exact IsLocalization.map_units (Localization.AtPrime M')
              (⟨ι_S (φ₀ c), hc_not_M'⟩ : M'.primeCompl)
          let g_Sy : S_y →+* Localization.AtPrime M' := IsLocalization.lift hg_S_units
          have hg_agree_Ry : ∀ r_y : R_y, g_loc (ψ₁_loc r_y) = g_Sy (φ_y r_y) := by
            suffices g_loc.comp ψ₁_loc = g_Sy.comp φ_y from RingHom.congr_fun this
            apply IsLocalization.ringHom_ext p_y.primeCompl
            ext r
            change g_loc (ψ₁_loc (algebraMap R₀ R_y r)) = g_Sy (φ_y (algebraMap R₀ R_y r))
            rw [Localization.localRingHom_to_map, IsLocalization.lift_eq,
              IsLocalization.map_eq, IsLocalization.lift_eq]
            exact congrArg (algebraMap T_Ω (Localization.AtPrime M')) (hι_comm r)
          let _ : Algebra R_y (Localization.AtPrime M') := (g_loc.comp ψ₁_loc).toAlgebra
          have : IsScalarTower R_y R_y (Localization.AtPrime M') := IsScalarTower.left R_y
          let g_L : R_loc →ₐ[R_y] Localization.AtPrime M' := { g_loc with commutes' := fun _ => rfl }
          let g_R : S_y →ₐ[R_y] Localization.AtPrime M' :=
            { g_Sy with commutes' := fun r_y => (hg_agree_Ry r_y).symm }
          let β_M0_alg : S_loc →ₐ[R_y] Localization.AtPrime M' :=
            Algebra.TensorProduct.lift g_L g_R (fun _ _ => mul_comm _ _)
          let β_M0 : S_loc →+* Localization.AtPrime M' := β_M0_alg.toRingHom
          have hβ_M0_tmul : ∀ (x : R_loc) (y : S_y), β_M0 (x ⊗ₜ[R_y] y) = g_loc x * g_Sy y :=
            fun x y => Algebra.TensorProduct.lift_tmul g_L g_R (fun _ _ => mul_comm _ _) x y
          have hα_β0 : α_M.comp β_M0 = algebraMap S_loc (Localization.AtPrime M) := by
            apply ringHom_ext_tensor
            · intro x
              have hcomp : α_M.comp g_loc = (algebraMap S_loc (Localization.AtPrime M)).comp Φ_loc := by
                apply IsLocalization.ringHom_ext w₀.primeCompl
                ext d
                change α_M (g_loc (algebraMap D_Ω R_loc d)) =
                  algebraMap S_loc (Localization.AtPrime M) (Φ_loc (algebraMap D_Ω R_loc d))
                rw [IsLocalization.lift_eq]
                change α_M (algebraMap T_Ω (Localization.AtPrime M') (1 ⊗ₜ[R₀] d)) = _
                rw [Localization.localRingHom_to_map, hj_loc_tmul, map_one, one_mul]
              change α_M (β_M0 (x ⊗ₜ[R_y] 1)) = _
              rw [hβ_M0_tmul, map_one, mul_one]
              exact RingHom.congr_fun hcomp x
            · intro y
              have hcomp : α_M.comp g_Sy = (algebraMap S_loc (Localization.AtPrime M)).comp j_Sy := by
                apply IsLocalization.ringHom_ext M_y
                ext s
                change α_M (g_Sy (algebraMap S_E S_y s)) =
                  algebraMap S_loc (Localization.AtPrime M) (j_S s)
                rw [IsLocalization.lift_eq]
                change α_M (algebraMap T_Ω (Localization.AtPrime M') (s ⊗ₜ[R₀] 1)) = _
                rw [Localization.localRingHom_to_map, hj_loc_tmul, map_one, map_one, mul_one]
              change α_M (β_M0 (1 ⊗ₜ[R_y] y)) = _
              rw [hβ_M0_tmul, map_one, one_mul]
              exact RingHom.congr_fun hcomp y
          have hβ0_j : β_M0.comp j_loc = algebraMap T_Ω (Localization.AtPrime M') := by
            apply ringHom_ext_tensor
            · intro s
              change β_M0 (j_loc (s ⊗ₜ[R₀] 1)) = algebraMap T_Ω (Localization.AtPrime M') (ι_S s)
              rw [hj_loc_tmul, map_one, map_one, mul_one]
              change β_M0 (1 ⊗ₜ[R_y] algebraMap S_E S_y s) = _
              rw [hβ_M0_tmul, map_one, one_mul, IsLocalization.lift_eq]
              rfl
            · intro d
              change β_M0 (j_loc (1 ⊗ₜ[R₀] d)) = algebraMap T_Ω (Localization.AtPrime M') (ι_D d)
              rw [hj_loc_tmul, map_one, one_mul]
              change β_M0 (algebraMap D_Ω R_loc d ⊗ₜ[R_y] 1) = _
              rw [hβ_M0_tmul, map_one, mul_one, IsLocalization.lift_eq]
              rfl
          have hβ0_units : ∀ z : M.primeCompl, IsUnit (β_M0 z) := by
            intro z
            apply isUnit_of_map_unit α_M
            have heq : α_M (β_M0 z.1) = algebraMap S_loc (Localization.AtPrime M) z.1 :=
              RingHom.congr_fun hα_β0 z.1
            rw [heq]
            exact IsLocalization.map_units (Localization.AtPrime M) z
          let β_M : Localization.AtPrime M →+* Localization.AtPrime M' := IsLocalization.lift hβ0_units
          have hβα_M : β_M.comp α_M = RingHom.id (Localization.AtPrime M') := by
            apply IsLocalization.ringHom_ext M'.primeCompl
            apply RingHom.ext
            intro t
            change β_M (α_M (algebraMap T_Ω (Localization.AtPrime M') t)) =
              algebraMap T_Ω (Localization.AtPrime M') t
            rw [Localization.localRingHom_to_map, IsLocalization.lift_eq]
            exact RingHom.congr_fun hβ0_j t
          have hαβ_M : α_M.comp β_M = RingHom.id (Localization.AtPrime M) := by
            apply IsLocalization.ringHom_ext M.primeCompl
            apply RingHom.ext
            intro z
            change α_M (β_M (algebraMap S_loc (Localization.AtPrime M) z)) =
              algebraMap S_loc (Localization.AtPrime M) z
            rw [IsLocalization.lift_eq]
            exact RingHom.congr_fun hα_β0 z
          let e_M : Localization.AtPrime M' ≃+* Localization.AtPrime M :=
            { α_M with
              invFun := β_M
              left_inv := RingHom.congr_fun hβα_M
              right_inv := RingHom.congr_fun hαβ_M }
          refine ⟨e_M.symm.toMulEquiv.isDomain (Localization.AtPrime M'), ?_⟩
          obtain ⟨π_M', hπ_M'⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime M')
          intro hMax_bot
          have hπ_ne : e_M π_M' ≠ 0 :=
            fun h0 => hπ_M'.ne_zero (e_M.injective (h0.trans (map_zero e_M).symm))
          have hπ_not_max : e_M π_M' ∉ IsLocalRing.maximalIdeal (Localization.AtPrime M) := by
            rw [hMax_bot, Ideal.mem_bot]
            exact hπ_ne
          have hπ_unit : IsUnit (e_M π_M') := IsLocalRing.notMem_maximalIdeal.mp hπ_not_max
          have hπ_M'_unit : IsUnit π_M' := by
            simpa using hπ_unit.map e_M.symm.toRingHom
          exact hπ_M'.not_isUnit hπ_M'_unit
        have hMin_at_max : ∀ M : Ideal S_loc, M.IsMaximal →
            ∃ P_M : Ideal S_loc, P_M ∈ minimalPrimes S_loc ∧ P_M < M ∧
              ∀ P : Ideal S_loc, P ∈ minimalPrimes S_loc → P ≤ M → P = P_M := by
          intro M hM
          let _ : M.IsMaximal := hM
          obtain ⟨hDom_M, hMax_ne_bot⟩ := hStalk_dvr M hM
          let _ : IsDomain (Localization.AtPrime M) := hDom_M
          let P_M : Ideal S_loc := RingHom.ker (algebraMap S_loc (Localization.AtPrime M))
          have hPM_prime : P_M.IsPrime := RingHom.ker_isPrime _
          have hPM_le_P : ∀ P : Ideal S_loc, P.IsPrime → P ≤ M → P_M ≤ P := by
            intro P hP hPle z hz
            rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff M.primeCompl] at hz
            obtain ⟨u, huz⟩ := hz
            have hmem : u.1 * z ∈ P := huz ▸ P.zero_mem
            have hu_not_P : u.1 ∉ P := fun huP => u.2 (hPle huP)
            exact (hP.mem_or_mem hmem).resolve_left hu_not_P
          have hPM_le_M : P_M ≤ M := hPM_le_P M hM.isPrime le_rfl
          have hPM_ne_M : P_M ≠ M := by
            intro heq
            obtain ⟨w, hw_max, hw_ne⟩ :=
              (Submodule.ne_bot_iff (IsLocalRing.maximalIdeal (Localization.AtPrime M))).mp hMax_ne_bot
            obtain ⟨p_surj, hwu⟩ := IsLocalization.surj M.primeCompl w
            rcases p_surj with ⟨z, u⟩
            dsimp only at hwu
            have hz_max : algebraMap S_loc (Localization.AtPrime M) z ∈
                IsLocalRing.maximalIdeal (Localization.AtPrime M) := by
              rw [← hwu]
              exact Ideal.mul_mem_right _ _ hw_max
            have hz_M : z ∈ M :=
              (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime M) M z).mp hz_max
            rw [← heq, RingHom.mem_ker] at hz_M
            have hu_unit : IsUnit (algebraMap S_loc (Localization.AtPrime M) u.1) :=
              IsLocalization.map_units (Localization.AtPrime M) u
            exact hw_ne (mul_right_cancel₀ hu_unit.ne_zero ((hwu.trans hz_M).trans (zero_mul _).symm))
          have hPM_min : P_M ∈ minimalPrimes S_loc :=
            ⟨⟨hPM_prime, bot_le⟩, fun Q hQ hQle => hPM_le_P Q hQ.1 (le_trans hQle hPM_le_M)⟩
          refine ⟨P_M, hPM_min, lt_of_le_of_ne hPM_le_M hPM_ne_M, fun P hP hPle => ?_⟩
          exact le_antisymm (hP.2 ⟨hPM_prime, bot_le⟩ (hPM_le_P P hP.1.1 hPle))
            (hPM_le_P P hP.1.1 hPle)
        have hj_S_nzd : ∀ s : S_E, s ≠ 0 → j_S s ∈ nonZeroDivisors S_loc := by
          intro s hs_ne
          let s' : S_y := algebraMap S_E S_y s
          have hs'_ne : s' ≠ 0 := fun h => hs_ne (hinj_Sy (h.trans (map_zero _).symm))
          let μ_s : S_y →ₗ[R_y] S_y := LinearMap.mulLeft R_y s'
          have hμ_inj : Function.Injective μ_s := mul_right_injective₀ hs'_ne
          have hlT_inj : Function.Injective (LinearMap.lTensor R_loc μ_s) :=
            Module.Flat.lTensor_preserves_injective_linearMap μ_s hμ_inj
          have hlT_eq : ∀ z : S_loc, LinearMap.lTensor R_loc μ_s z = j_S s * z := by
            intro z
            induction z using TensorProduct.induction_on with
            | zero => simp
            | tmul x y =>
              change x ⊗ₜ[R_y] (s' * y) = ((1 : R_loc) ⊗ₜ[R_y] s') * (x ⊗ₜ[R_y] y)
              rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            | add z₁ z₂ hz₁ hz₂ => rw [map_add, mul_add, hz₁, hz₂]
          rw [mem_nonZeroDivisors_iff_right]
          intro z hzs
          apply hlT_inj
          rw [hlT_eq, mul_comm, hzs, map_zero]
        let t₀ : R_loc := ψ₁_loc (algebraMap R₀ R_y r₀)
        have hΦ_t₀ : Φ_loc t₀ = j_S (φ₀ r₀) := by
          rw [hComm_Ry, IsLocalization.map_eq]; rfl
        have hΦ_t₀_nzd : Φ_loc t₀ ∈ nonZeroDivisors S_loc := by
          rw [hΦ_t₀]; exact hj_S_nzd (φ₀ r₀) hr₀_ne
        have hMin_comap_jS : ∀ P : Ideal S_loc, P ∈ minimalPrimes S_loc →
            Ideal.comap j_S P = ⊥ ∧ Φ_loc t₀ ∉ P := by
          intro P hP
          have hdisj := Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hP
          refine ⟨?_, fun htP => Set.disjoint_left.mp hdisj htP hΦ_t₀_nzd⟩
          rw [eq_bot_iff]
          intro s hs
          rw [Ideal.mem_bot]
          by_contra hs_ne
          exact Set.disjoint_left.mp hdisj hs (hj_S_nzd s hs_ne)
        have hMin_comap_Φ : ∀ P : Ideal S_loc, P ∈ minimalPrimes S_loc →
            Ideal.comap Φ_loc P = q₀_min ∨ Ideal.comap Φ_loc P = q₁_min := by
          intro P hP
          obtain ⟨M, hM_max, hP_le_M⟩ := Ideal.exists_le_maximal P hP.1.1.ne_top
          obtain ⟨P_M, _, hPM_lt_M, hPM_uniq⟩ := hMin_at_max M hM_max
          have hP_eq : P = P_M := hPM_uniq P hP hP_le_M
          have hP_lt_M : P < M := hP_eq ▸ hPM_lt_M
          obtain ⟨m_el, hm_M, hm_not_P⟩ := Set.not_subset.mp (not_le_of_gt hP_lt_M)
          let _ : P.IsPrime := hP.1.1
          have hlt := Ideal.under_lt_under_of_integral_mem_sdiff (R := R_loc) (I := P) (J := M)
            hP_lt_M.le (x := m_el) ⟨hm_M, hm_not_P⟩ (Algebra.IsIntegral.isIntegral m_el)
          change Ideal.comap Φ_loc P < Ideal.comap Φ_loc M at hlt
          rw [hMax_comap_Rloc M hM_max] at hlt
          exact hq_lt (Ideal.comap Φ_loc P) (Ideal.IsPrime.comap Φ_loc) hlt
        have hBirat_Sloc : ∀ z : S_loc, ∃ (k : ℕ) (x : R_loc), Φ_loc (t₀ ^ k) * z = Φ_loc x := by
          intro z
          induction z using TensorProduct.induction_on with
          | zero => exact ⟨0, 0, by simp⟩
          | tmul u y =>
            obtain ⟨p_surj, hy_surj⟩ := IsLocalization.surj M_y y
            rcases p_surj with ⟨s, v⟩
            dsimp only at hy_surj
            rcases v.2 with ⟨c, hc, hv_eq⟩
            obtain ⟨k, a, hka⟩ := hBirat s
            let r_ac : R_y := IsLocalization.mk' R_y a ⟨c, hc⟩
            refine ⟨k, u * ψ₁_loc r_ac, ?_⟩
            have hSy_eq : φ_y (algebraMap R₀ R_y (r₀ ^ k)) * y = φ_y r_ac := by
              have hv_ne : algebraMap S_E S_y v.1 ≠ 0 :=
                fun h => (mem_nonZeroDivisors_iff_ne_zero.mp (hMy_le v.2))
                  (hinj_Sy (h.trans (map_zero _).symm))
              apply mul_right_cancel₀ hv_ne
              calc (φ_y (algebraMap R₀ R_y (r₀ ^ k)) * y) * algebraMap S_E S_y v.1
                  = algebraMap S_E S_y (φ₀ (r₀ ^ k)) * (y * algebraMap S_E S_y v.1) := by
                      rw [IsLocalization.map_eq]; ring
                _ = algebraMap S_E S_y (φ₀ (r₀ ^ k) * s) := by rw [hy_surj, map_mul]
                _ = algebraMap S_E S_y (φ₀ a) := by rw [hka]
                _ = φ_y (algebraMap R₀ R_y a) := (IsLocalization.map_eq _ a).symm
                _ = φ_y (r_ac * algebraMap R₀ R_y c) := by
                      rw [← IsLocalization.mk'_spec R_y a ⟨c, hc⟩]
                _ = φ_y r_ac * algebraMap S_E S_y v.1 := by
                      rw [map_mul, IsLocalization.map_eq, hv_eq]
            change ((t₀ ^ k) ⊗ₜ[R_y] (1 : S_y)) * (u ⊗ₜ[R_y] y) = (u * ψ₁_loc r_ac) ⊗ₜ[R_y] (1 : S_y)
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            have hsmul_tmul : ∀ (r : R_y) (w : S_y),
                (u * ψ₁_loc r) ⊗ₜ[R_y] w = u ⊗ₜ[R_y] (φ_y r * w) := by
              intro r w
              calc (u * ψ₁_loc r) ⊗ₜ[R_y] w
                  = (r • u) ⊗ₜ[R_y] w := by
                      change (u * ψ₁_loc r) ⊗ₜ[R_y] w = (ψ₁_loc r * u) ⊗ₜ[R_y] w
                      rw [mul_comm]
                _ = u ⊗ₜ[R_y] (r • w) := TensorProduct.smul_tmul r u w
                _ = u ⊗ₜ[R_y] (φ_y r * w) := rfl
            have h1 : (t₀ ^ k * u) ⊗ₜ[R_y] y = u ⊗ₜ[R_y] (φ_y (algebraMap R₀ R_y (r₀ ^ k)) * y) := by
              have hpow : t₀ ^ k = ψ₁_loc (algebraMap R₀ R_y (r₀ ^ k)) := by
                rw [map_pow, map_pow]
              rw [hpow, mul_comm]
              exact hsmul_tmul (algebraMap R₀ R_y (r₀ ^ k)) y
            have h2 : (u * ψ₁_loc r_ac) ⊗ₜ[R_y] (1 : S_y) = u ⊗ₜ[R_y] (φ_y r_ac) := by
              rw [hsmul_tmul r_ac 1, mul_one]
            rw [h1, hSy_eq, h2]
          | add z₁ z₂ ih₁ ih₂ =>
            obtain ⟨k₁, x₁, hx₁⟩ := ih₁
            obtain ⟨k₂, x₂, hx₂⟩ := ih₂
            refine ⟨k₁ + k₂, t₀ ^ k₂ * x₁ + t₀ ^ k₁ * x₂, ?_⟩
            calc Φ_loc (t₀ ^ (k₁ + k₂)) * (z₁ + z₂)
                = Φ_loc (t₀ ^ k₂) * (Φ_loc (t₀ ^ k₁) * z₁) +
                    Φ_loc (t₀ ^ k₁) * (Φ_loc (t₀ ^ k₂) * z₂) := by
                    rw [pow_add, map_mul]; ring
              _ = Φ_loc (t₀ ^ k₂ * x₁ + t₀ ^ k₁ * x₂) := by
                    rw [hx₁, hx₂, map_add, map_mul, map_mul]
        have hComap_Φ_inj : ∀ P₁ P₂ : Ideal S_loc,
            P₁ ∈ minimalPrimes S_loc → P₂ ∈ minimalPrimes S_loc →
            Ideal.comap Φ_loc P₁ = Ideal.comap Φ_loc P₂ → P₁ = P₂ := by
          have hSub : ∀ P₁ P₂ : Ideal S_loc,
              P₁ ∈ minimalPrimes S_loc → P₂ ∈ minimalPrimes S_loc →
              Ideal.comap Φ_loc P₁ = Ideal.comap Φ_loc P₂ → P₁ ≤ P₂ := by
            intro P₁ P₂ _ hP₂ h_eq z hz₁
            obtain ⟨k, x, hkx⟩ := hBirat_Sloc z
            have hx₁ : x ∈ Ideal.comap Φ_loc P₁ := by
              change Φ_loc x ∈ P₁
              rw [← hkx]
              exact Ideal.mul_mem_left P₁ _ hz₁
            rw [h_eq] at hx₁
            have hmul₂ : Φ_loc t₀ ^ k * z ∈ P₂ := by
              rw [← map_pow, hkx]; exact hx₁
            have ht₀_not_P₂ : Φ_loc t₀ ^ k ∉ P₂ :=
              fun hpow => (hMin_comap_jS P₂ hP₂).2 (hP₂.1.1.mem_of_pow_mem k hpow)
            exact (hP₂.1.1.mem_or_mem hmul₂).resolve_left ht₀_not_P₂
          intro P₁ P₂ hP₁ hP₂ h_eq
          exact le_antisymm (hSub P₁ P₂ hP₁ hP₂ h_eq) (hSub P₂ P₁ hP₂ hP₁ h_eq.symm)
        have hBranch_surj : ∀ P : Ideal S_loc, P ∈ minimalPrimes S_loc →
            Function.Surjective ((Ideal.Quotient.mk P).comp Φ_loc) := by
          intro P hP
          let _ : P.IsPrime := hP.1.1
          have hOfEq : ∀ (q_P : Ideal R_loc) [q_P.IsPrime] [IsIntegrallyClosed (R_loc ⧸ q_P)],
              Ideal.comap Φ_loc P = q_P →
              Function.Surjective ((Ideal.Quotient.mk P).comp Φ_loc) := by
            intro q_P _ _ hq_eq
            let Phi_bar_P : (R_loc ⧸ q_P) →+* (S_loc ⧸ P) :=
              Ideal.Quotient.lift q_P ((Ideal.Quotient.mk P).comp Φ_loc) (fun _ hx => by
                rw [← hq_eq] at hx
                exact Ideal.Quotient.eq_zero_iff_mem.mpr hx)
            have hPhi_bar_inj : Function.Injective Phi_bar_P := by
              rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
              intro y hy
              obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
              rw [Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem, ← hq_eq]
              change Ideal.Quotient.mk P (Φ_loc x) = 0 at hy
              exact (Ideal.Quotient.eq_zero_iff_mem.mp hy : Φ_loc x ∈ P)
            have hPhi_bar_int : Phi_bar_P.IsIntegral := by
              intro z_bar
              obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z_bar
              obtain ⟨F, hF_monic, hF_eval⟩ :=
                (Algebra.IsIntegral.isIntegral (R := R_loc) z)
              refine ⟨F.map (Ideal.Quotient.mk q_P), hF_monic.map _, ?_⟩
              rw [Polynomial.eval₂_map]
              have hcomp : Phi_bar_P.comp (Ideal.Quotient.mk q_P) = (Ideal.Quotient.mk P).comp Φ_loc :=
                RingHom.ext fun _ => rfl
              rw [hcomp, ← Polynomial.hom_eval₂]
              change Ideal.Quotient.mk P (Polynomial.eval₂ (algebraMap R_loc S_loc) z F) = 0
              rw [hF_eval, map_zero]
            have hPhi_bar_birat : ∀ z_bar : S_loc ⧸ P,
                ∃ d_bar a_bar : R_loc ⧸ q_P, d_bar ≠ 0 ∧ Phi_bar_P d_bar * z_bar = Phi_bar_P a_bar := by
              intro z_bar
              obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z_bar
              obtain ⟨k, x, hkx⟩ := hBirat_Sloc z
              refine ⟨Ideal.Quotient.mk q_P (t₀ ^ k), Ideal.Quotient.mk q_P x, ?_, ?_⟩
              · intro hd0
                rw [Ideal.Quotient.eq_zero_iff_mem, ← hq_eq] at hd0
                have htP : Φ_loc t₀ ^ k ∈ P := by rw [← map_pow]; exact hd0
                exact (hMin_comap_jS P hP).2 (hP.1.1.mem_of_pow_mem k htP)
              · change Ideal.Quotient.mk P (Φ_loc (t₀ ^ k)) * Ideal.Quotient.mk P z =
                  Ideal.Quotient.mk P (Φ_loc x)
                rw [← map_mul, hkx]
            have hPhi_bar_bij : Function.Bijective Phi_bar_P :=
              birational_integral_bijective (R_loc ⧸ q_P) (S_loc ⧸ P) Phi_bar_P
                hPhi_bar_inj hPhi_bar_int hPhi_bar_birat
            exact hPhi_bar_bij.2.comp Ideal.Quotient.mk_surjective
          rcases hMin_comap_Φ P hP with h₀ | h₁
          · let _ : IsIntegrallyClosed (R_loc ⧸ q₀_min) := hIntCl₀
            exact hOfEq q₀_min h₀
          · let _ : IsIntegrallyClosed (R_loc ⧸ q₁_min) := hIntCl₁
            exact hOfEq q₁_min h₁
        refine ⟨?_, ?_⟩
        · rintro ⟨𝔪₁, 𝔪₂, h𝔪₁, h𝔪₂, h𝔪_ne, hover₁, hover₂⟩ Q hQ_min hQ_le_w₀
          obtain ⟨M₁, hM₁_max, hM₁_comap⟩ := hLift_max 𝔪₁ h𝔪₁ hover₁
          obtain ⟨M₂, hM₂_max, hM₂_comap⟩ := hLift_max 𝔪₂ h𝔪₂ hover₂
          have hM_ne : M₁ ≠ M₂ := fun heq => h𝔪_ne (by rw [← hM₁_comap, heq, hM₂_comap])
          obtain ⟨P₁, hP₁_min, hP₁_lt, _⟩ := hMin_at_max M₁ hM₁_max
          obtain ⟨P₂, hP₂_min, hP₂_lt, _⟩ := hMin_at_max M₂ hM₂_max
          have hP_ne : P₁ ≠ P₂ := by
            intro hP_eq
            have hSurj_P₁ : Function.Surjective ((Ideal.Quotient.mk P₁).comp Φ_loc) :=
              hBranch_surj P₁ hP₁_min
            have hP₁_le_M₂ : P₁ ≤ M₂ := hP_eq ▸ hP₂_lt.le
            have hM₁_eq_M₂ : M₁ = M₂ := by
              ext z
              obtain ⟨x, hx⟩ := hSurj_P₁ (Ideal.Quotient.mk P₁ z)
              have hdiff : Φ_loc x - z ∈ P₁ := Ideal.Quotient.eq.mp hx
              have hd₁ : Φ_loc x - z ∈ M₁ := hP₁_lt.le hdiff
              have hd₂ : Φ_loc x - z ∈ M₂ := hP₁_le_M₂ hdiff
              have hiff₁ : z ∈ M₁ ↔ x ∈ Ideal.comap Φ_loc M₁ := by
                constructor
                · intro hz; change Φ_loc x ∈ M₁; simpa using add_mem hd₁ hz
                · intro hxM; have hm : Φ_loc x - (Φ_loc x - z) ∈ M₁ := sub_mem hxM hd₁; simpa using hm
              have hiff₂ : z ∈ M₂ ↔ x ∈ Ideal.comap Φ_loc M₂ := by
                constructor
                · intro hz; change Φ_loc x ∈ M₂; simpa using add_mem hd₂ hz
                · intro hxM; have hm : Φ_loc x - (Φ_loc x - z) ∈ M₂ := sub_mem hxM hd₂; simpa using hm
              rw [hiff₁, hMax_comap_Rloc M₁ hM₁_max, ← hMax_comap_Rloc M₂ hM₂_max, ← hiff₂]
            exact hM_ne hM₁_eq_M₂
          have hComap_ne : Ideal.comap Φ_loc P₁ ≠ Ideal.comap Φ_loc P₂ :=
            fun heq => hP_ne (hComap_Φ_inj P₁ P₂ hP₁_min hP₂_min heq)
          have hExhaust : ∀ q_br : Ideal R_loc, (q_br = q₀_min ∨ q_br = q₁_min) →
              ∃ P : Ideal S_loc, P ∈ minimalPrimes S_loc ∧ Ideal.comap Φ_loc P = q_br := by
            rintro q_br (rfl | rfl)
            · rcases hMin_comap_Φ P₁ hP₁_min with h₁0 | h₁1
              · exact ⟨P₁, hP₁_min, h₁0⟩
              · rcases hMin_comap_Φ P₂ hP₂_min with h₂0 | h₂1
                · exact ⟨P₂, hP₂_min, h₂0⟩
                · exact absurd (h₁1.trans h₂1.symm) hComap_ne
            · rcases hMin_comap_Φ P₁ hP₁_min with h₁0 | h₁1
              · rcases hMin_comap_Φ P₂ hP₂_min with h₂0 | h₂1
                · exact absurd (h₁0.trans h₂0.symm) hComap_ne
                · exact ⟨P₂, hP₂_min, h₂1⟩
              · exact ⟨P₁, hP₁_min, h₁1⟩
          have hQ_disj : Disjoint (w₀.primeCompl : Set D_Ω) (Q : Set D_Ω) :=
            Set.disjoint_left.mpr fun _ hnot hmem => hnot (hQ_le_w₀ hmem)
          let Q_loc : Ideal R_loc := Ideal.map (algebraMap D_Ω R_loc) Q
          have hQ_loc_prime : Q_loc.IsPrime :=
            IsLocalization.isPrime_of_isPrime_disjoint w₀.primeCompl R_loc Q hQ_min.1.1 hQ_disj
          have hQ_loc_under : Ideal.comap (algebraMap D_Ω R_loc) Q_loc = Q :=
            IsLocalization.under_map_of_isPrime_disjoint w₀.primeCompl R_loc hQ_min.1.1 hQ_disj
          have hQ_loc_min : Q_loc ∈ minimalPrimes R_loc := by
            refine ⟨⟨hQ_loc_prime, bot_le⟩, fun q' hq' hq'_le => ?_⟩
            let _ : q'.IsPrime := hq'.1
            have hunder_le : Ideal.comap (algebraMap D_Ω R_loc) q' ≤ Q := by
              rw [← hQ_loc_under]; exact Ideal.comap_mono hq'_le
            have hQ_le_under : Q ≤ Ideal.comap (algebraMap D_Ω R_loc) q' :=
              hQ_min.2 ⟨Ideal.IsPrime.comap _, bot_le⟩ hunder_le
            have hunder_eq : Ideal.under D_Ω q' = Q := le_antisymm hunder_le hQ_le_under
            rw [← IsLocalization.map_under w₀.primeCompl R_loc q', hunder_eq]
          obtain ⟨P_hit, hPhit_min, hPhit_eq⟩ := hExhaust Q_loc ((hq_min Q_loc).mp hQ_loc_min)
          have hQ_eq : Q = Ideal.comap (Φ_loc.comp (algebraMap D_Ω R_loc)) P_hit := by
            rw [← Ideal.comap_comap, hPhit_eq, hQ_loc_under]
          have hcomp_eq : (Φ_loc.comp (algebraMap D_Ω R_loc)).comp ψ₁ = j_S.comp φ₀ :=
            RingHom.ext hComm_R₀
          rw [hQ_eq, Ideal.comap_comap, hcomp_eq, ← Ideal.comap_comap,
            (hMin_comap_jS P_hit hPhit_min).1]
          rfl
        · intro hUnique s
          obtain ⟨M₀, hM₀_max, hM₀_comap⟩ := hLift_max 𝔪₀ h𝔪₀_prime h𝔪₀_over
          have hM₀_uniq : ∀ M : Ideal S_loc, M.IsMaximal → M = M₀ := by
            intro M hM
            obtain ⟨h𝔪M_prime, h𝔪M_over⟩ := hMax_over_py M hM
            have h𝔪_eq : Ideal.comap j_S M = Ideal.comap j_S M₀ := by
              rw [hM₀_comap]
              exact hUnique (Ideal.comap j_S M) 𝔪₀ h𝔪M_prime h𝔪₀_prime h𝔪M_over h𝔪₀_over
            exact hMax_inj M M₀ hM hM₀_max h𝔪_eq
          have hUnits_M₀ : ∀ u : M₀.primeCompl, IsUnit (u : S_loc) := by
            intro u
            by_contra hnot_unit
            have hne_top : Ideal.span ({u.1} : Set S_loc) ≠ ⊤ :=
              fun htop => hnot_unit (Ideal.span_singleton_eq_top.mp htop)
            obtain ⟨M, hM_max, hle_M⟩ := Ideal.exists_le_maximal _ hne_top
            rw [hM₀_uniq M hM_max, Ideal.span_singleton_le_iff_mem] at hle_M
            exact u.2 hle_M
          let _ : M₀.IsMaximal := hM₀_max
          obtain ⟨hDom_M₀, _⟩ := hStalk_dvr M₀ hM₀_max
          let _ : IsDomain (Localization.AtPrime M₀) := hDom_M₀
          have hLoc_bij : Function.Bijective (algebraMap S_loc (Localization.AtPrime M₀)) := by
            refine ⟨?_, ?_⟩
            · rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
              intro z hz
              rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff M₀.primeCompl] at hz
              obtain ⟨u, huz⟩ := hz
              obtain ⟨v, hv⟩ := (hUnits_M₀ u).exists_left_inv
              rw [Ideal.mem_bot]
              calc z = (v * u.1) * z := by rw [hv, one_mul]
                _ = v * (u.1 * z) := by ring
                _ = 0 := by rw [huz, mul_zero]
            · intro w
              obtain ⟨p_surj, hwu⟩ := IsLocalization.surj M₀.primeCompl w
              rcases p_surj with ⟨z, u⟩
              dsimp only at hwu
              obtain ⟨v, hv⟩ := (hUnits_M₀ u).exists_right_inv
              refine ⟨z * v, ?_⟩
              have hu_loc : IsUnit (algebraMap S_loc (Localization.AtPrime M₀) u.1) :=
                IsLocalization.map_units (Localization.AtPrime M₀) u
              apply mul_left_cancel₀ hu_loc.ne_zero
              calc algebraMap S_loc (Localization.AtPrime M₀) u.1 *
                    algebraMap S_loc (Localization.AtPrime M₀) (z * v)
                  = algebraMap S_loc (Localization.AtPrime M₀) (z * (u.1 * v)) := by
                      rw [← map_mul]; congr 1; ring
                _ = algebraMap S_loc (Localization.AtPrime M₀) z := by rw [hv, mul_one]
                _ = algebraMap S_loc (Localization.AtPrime M₀) u.1 * w := by rw [← hwu, mul_comm]
          let e_Sloc : S_loc ≃+* Localization.AtPrime M₀ :=
            RingEquiv.ofBijective (algebraMap S_loc (Localization.AtPrime M₀)) hLoc_bij
          have hDom_Sloc : IsDomain S_loc := e_Sloc.toMulEquiv.isDomain (Localization.AtPrime M₀)
          let _ : IsDomain S_loc := hDom_Sloc
          have hBot_prime : (⊥ : Ideal S_loc).IsPrime :=
            ⟨bot_ne_top, fun {a b} hab => by
              simp only [Ideal.mem_bot] at hab ⊢
              exact mul_eq_zero.mp hab⟩
          have hBot_min : (⊥ : Ideal S_loc) ∈ minimalPrimes S_loc :=
            ⟨⟨hBot_prime, le_rfl⟩, fun _ _ _ => bot_le⟩
          have hMk_bot_surj : Function.Surjective ((Ideal.Quotient.mk (⊥ : Ideal S_loc)).comp Φ_loc) :=
            hBranch_surj ⊥ hBot_min
          have hΦ_surj : Function.Surjective (algebraMap R_loc (TensorProduct R_y R_loc S_y)) := by
            intro z
            obtain ⟨x, hx⟩ := hMk_bot_surj (Ideal.Quotient.mk (⊥ : Ideal S_loc) z)
            refine ⟨x, ?_⟩
            have hmem : Φ_loc x - z ∈ (⊥ : Ideal S_loc) := Ideal.Quotient.eq.mp hx
            rwa [Ideal.mem_bot, sub_eq_zero] at hmem
          have hφy_surj : Function.Surjective φ_y :=
            Module.FaithfullyFlat.surjective_of_tensorProduct (R := R_y) (S := R_loc) (T := S_y) hΦ_surj
          obtain ⟨r_y, hry⟩ := hφy_surj (algebraMap S_E S_y s)
          obtain ⟨p_rc, hrc⟩ := IsLocalization.surj p_y.primeCompl r_y
          rcases p_rc with ⟨a, c⟩
          dsimp only at hrc
          refine ⟨a, c.1, c.2, ?_⟩
          apply hinj_Sy
          calc algebraMap S_E S_y (φ₀ c.1 * s)
              = algebraMap S_E S_y s * φ_y (algebraMap R₀ R_y c.1) := by
                  rw [map_mul, IsLocalization.map_eq, mul_comm]
            _ = φ_y (r_y * algebraMap R₀ R_y c.1) := by rw [← hry, map_mul]
            _ = φ_y (algebraMap R₀ R_y a) := by rw [hrc]
            _ = algebraMap S_E S_y (φ₀ a) := IsLocalization.map_eq _ a
      refine ⟨?_, ?_⟩
      · intro hex₂
        rcases hex₂ with ⟨𝔪₁, 𝔪₂, h𝔪₁, h𝔪₂, h𝔪_ne, hover₁, hover₂⟩
        exact (hCore ⟨𝔪₁, h𝔪₁, hover₁⟩).1 ⟨𝔪₁, 𝔪₂, h𝔪₁, h𝔪₂, h𝔪_ne, hover₁, hover₂⟩
      · intro hUnique hex₁
        exact (hCore hex₁).2 hUnique
    intro D_Ω _ ψ₁ ψ₂ w₀ _ hψ₁ hψ₂ hw₀_over hw₀_X h_comp
    obtain ⟨hNoeth_N, hu01, ⟨e_res, he_res⟩, hBr⟩ := hNodalQuot
    let _ := hNoeth_N
    obtain ⟨hRes_ψ₂, q₀_min, q₁_min, hq₀, hq₁, hq_ne, hq_min, hq_lt, hIntCl₀, hIntCl₁⟩ :=
      hAbstractRoof
        (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) D_Ω
        ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})).comp MvPolynomial.C)
        (fun i => Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X i))
        hu01 e_res he_res hBr ψ₂ hψ₂ w₀ hw₀_X
    let _ : q₀_min.IsPrime := hq₀
    let _ : q₁_min.IsPrime := hq₁
    have hRes_D : ∀ d : D_Ω, ∃ c : Ω, d - ψ₁ (α_R c) ∈ w₀ := by
      intro d
      obtain ⟨c, hc⟩ := hRes_ψ₂ d
      refine ⟨c, ?_⟩
      have h_eq : ψ₁ (α_R c) =
          ψ₂ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
            (MvPolynomial.C c)) :=
        RingHom.congr_fun h_comp c
      rwa [h_eq]
    exact hTwoBranch D_Ω ψ₁ w₀ hψ₁ hw₀_over hRes_D q₀_min q₁_min hq_ne hq_min hq_lt hIntCl₀ hIntCl₁

theorem weil_powerSeries_terminal_rational_component_dichotomy_and_contraction (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C C_res : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (g_res : C_res ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_res : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C_res))
    (q_res : C_res ⟶ C)
    (Z_blown : Set C)
    (pts : Fin 0 → C_res)
    (mults : Fin 0 → ℕ)
    (hTerm : IsPartialPowerSeriesNodeResolution Ω n g τ g_res τ_res q_res Z_blown 0 pts mults)
    (hP1Prop : ∀ (E_sch : AlgebraicGeometry.Scheme.{u})
        (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
      (∀ Z : Set ↥E_sch, IsClosed Z → Z ≠ Set.univ → Z.Finite) ∧
      (∀ (V : E_sch.Opens) (hV : AlgebraicGeometry.IsAffineOpen V),
        Nonempty ↥V →
        let α_Ω : Ω →+* ↑(E_sch.presheaf.obj (Opposite.op V)) :=
          (AlgebraicGeometry.Spec.preimage
            (hV.fromSpec ≫ isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom)).hom
        ∀ (𝔪 : Ideal ↑(E_sch.presheaf.obj (Opposite.op V))) [𝔪.IsMaximal],
          𝔪 ≠ ⊥ ∧
          (∀ s : ↑(E_sch.presheaf.obj (Opposite.op V)), ∃ c : Ω, s - α_Ω c ∈ 𝔪) ∧
          IsPrincipalIdealRing (Localization.AtPrime 𝔪)))
    (hLocAlg : ∀ (R₀ S_E : Type u) [CommRing R₀] [CommRing S_E] [IsDomain S_E]
        (α_R : Ω →+* R₀) (φ₀ : R₀ →+* S_E),
      φ₀.Finite →
      ∀ (r₀ : R₀), φ₀ r₀ ≠ 0 →
      (∀ s : S_E, ∃ (k : ℕ) (a : R₀), φ₀ (r₀ ^ k) * s = φ₀ a) →
      ∀ (p_y : Ideal R₀) [p_y.IsMaximal],
      (∀ (𝔪 : Ideal S_E) [𝔪.IsMaximal],
        Ideal.comap φ₀ 𝔪 = p_y →
        𝔪 ≠ ⊥ ∧ (∀ s : S_E, ∃ c : Ω, s - φ₀ (α_R c) ∈ 𝔪) ∧
          IsPrincipalIdealRing (Localization.AtPrime 𝔪)) →
      ((∃ g_sm : MvPolynomial (Fin 1) Ω →+* R₀, g_sm.comp MvPolynomial.C = α_R ∧ g_sm.Etale) →
        (∀ (𝔪₁ 𝔪₂ : Ideal S_E),
          𝔪₁.IsPrime → 𝔪₂.IsPrime →
          Ideal.comap φ₀ 𝔪₁ = p_y → Ideal.comap φ₀ 𝔪₂ = p_y → 𝔪₁ = 𝔪₂) ∧
        ((∃ 𝔪 : Ideal S_E, 𝔪.IsPrime ∧ Ideal.comap φ₀ 𝔪 = p_y) →
          ∀ s : S_E, ∃ (a c : R₀), c ∉ p_y ∧ φ₀ c * s = φ₀ a)) ∧
      (∀ (D_Ω : Type u) [CommRing D_Ω]
          (ψ₁ : R₀ →+* D_Ω)
          (ψ₂ : (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D_Ω)
          (w₀ : Ideal D_Ω) [w₀.IsPrime],
        ψ₁.Etale →
        ψ₂.Etale →
        Ideal.comap ψ₁ w₀ = p_y →
        (∀ i : Fin 2,
          ψ₂ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
            (MvPolynomial.X i)) ∈ w₀) →
        ψ₁.comp α_R =
          ψ₂.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})).comp
            MvPolynomial.C) →
        ((∃ (𝔪₁ 𝔪₂ : Ideal S_E),
            𝔪₁.IsPrime ∧ 𝔪₂.IsPrime ∧ 𝔪₁ ≠ 𝔪₂ ∧
            Ideal.comap φ₀ 𝔪₁ = p_y ∧ Ideal.comap φ₀ 𝔪₂ = p_y) →
          ∀ (Q : Ideal D_Ω), Q ∈ minimalPrimes D_Ω → Q ≤ w₀ →
            Ideal.comap ψ₁ Q = RingHom.ker φ₀) ∧
        ((∀ (𝔪₁ 𝔪₂ : Ideal S_E),
            𝔪₁.IsPrime → 𝔪₂.IsPrime →
            Ideal.comap φ₀ 𝔪₁ = p_y → Ideal.comap φ₀ 𝔪₂ = p_y → 𝔪₁ = 𝔪₂) →
          (∃ 𝔪 : Ideal S_E, 𝔪.IsPrime ∧ Ideal.comap φ₀ 𝔪 = p_y) →
          ∀ s : S_E, ∃ (a c : R₀), c ∉ p_y ∧ φ₀ c * s = φ₀ a))) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    (∀ (E : Set ↥(CategoryTheory.Limits.pullback g_res s_Ω))
        (E_sch : AlgebraicGeometry.Scheme.{u})
        (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g_res s_Ω),
      E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_res s_Ω) →
      AlgebraicGeometry.IsClosedImmersion ιE →
      AlgebraicGeometry.IsIntegral E_sch →
      Set.range ιE.base = E →
      (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
        ιE ≫ CategoryTheory.Limits.pullback.snd g_res s_Ω =
          isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
      IsTwoBridgeRationalComponent Ω n g_res τ_res E ∨
      (∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g_res s_Ω),
        q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
        q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
        (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g_res s_Ω)),
          (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_res s_Ω),
            E' ≠ E ∧ q ∈ E') ∨
          (∃ j : Fin n,
            (CategoryTheory.Limits.pullback.fst g_res s_Ω).base q ∈ Set.range (τ_res j).base)))) ∧
    (∀ E : Set ↥(CategoryTheory.Limits.pullback g_res s_Ω),
      IsTwoBridgeRationalComponent Ω n g_res τ_res E →
      ((fun q => q_res.base ((CategoryTheory.Limits.pullback.fst g_res s_Ω).base q)) '' E).Subsingleton) :=
by
  intro s_Ω
  
  have hIrred_union : ∀ {X : Type u} [TopologicalSpace X] {s u v : Set X},
      IsIrreducible s → IsClosed u → IsClosed v → s ⊆ u ∪ v → s ⊆ u ∨ s ⊆ v := by
    intro X _ s u v hs hu hv hsub
    by_contra hnot
    push Not at hnot
    obtain ⟨hnu, hnv⟩ := hnot
    obtain ⟨x₁, hx₁s, hx₁u⟩ := Set.not_subset.mp hnu
    obtain ⟨x₂, hx₂s, hx₂v⟩ := Set.not_subset.mp hnv
    obtain ⟨x, hxs, hxu, hxv⟩ :=
      hs.2 uᶜ vᶜ hu.isOpen_compl hv.isOpen_compl ⟨x₁, hx₁s, hx₁u⟩ ⟨x₂, hx₂s, hx₂v⟩
    rcases hsub hxs with hu' | hv'
    · exact hxu hu'
    · exact hxv hv'

  have hIrred_fin_biUnion : ∀ {X : Type u} [TopologicalSpace X] {s : Set X} {ℱ : Set (Set X)},
      IsIrreducible s → ℱ.Finite → (∀ F ∈ ℱ, IsClosed F) → s ⊆ (⋃ F ∈ ℱ, F) →
      ∃ F ∈ ℱ, s ⊆ F := by
    intro X _ s ℱ hs hFin
    induction ℱ, hFin using Set.Finite.induction_on with
    | empty =>
      intro _ hsub
      obtain ⟨x, hx⟩ := hs.1
      rw [Set.biUnion_empty, Set.subset_empty_iff] at hsub
      rw [hsub] at hx
      exact False.elim hx
    | @insert F₀ ℱ₀ _ hFin₀ ih =>
      intro hCl hsub
      have hCl₀ : IsClosed F₀ := hCl F₀ (Set.mem_insert F₀ ℱ₀)
      have hCl_rest : IsClosed (⋃ F ∈ ℱ₀, F) :=
        hFin₀.isClosed_biUnion (fun F hF => hCl F (Set.mem_insert_of_mem F₀ hF))
      have hsub' : s ⊆ F₀ ∪ (⋃ F ∈ ℱ₀, F) := by
        simpa [Set.biUnion_insert] using hsub
      rcases hIrred_union hs hCl₀ hCl_rest hsub' with hF₀ | hrest
      · exact ⟨F₀, Set.mem_insert F₀ ℱ₀, hF₀⟩
      · obtain ⟨F, hF, hsF⟩ := ih (fun F hF => hCl F (Set.mem_insert_of_mem F₀ hF)) hrest
        exact ⟨F, Set.mem_insert_of_mem F₀ hF, hsF⟩

  
  have h_s2 : ∀ (C₀ E_sch : AlgebraicGeometry.Scheme.{u})
      (p₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (U_iso₀ : C₀.Opens)
      (hCl_compl : ∀ y : ↥C₀, y ∉ U_iso₀ → IsClosed ({y} : Set ↥C₀))
      (f_E : E_sch ⟶ C₀)
      (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
      AlgebraicGeometry.IsIntegral E_sch →
      AlgebraicGeometry.IsProper f_E →
      f_E ≫ p₀ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom →
      (∀ u₁ u₂ : ↥E_sch, f_E u₁ ∈ U_iso₀ → f_E u₁ = f_E u₂ → u₁ = u₂) →
      (∀ (D₀ : C₀.Opens), AlgebraicGeometry.IsAffineOpen D₀ →
        D₀ ≤ U_iso₀ → Function.Surjective (f_E.app D₀).hom) →
      (∃ u_gen : ↥E_sch, f_E u_gen ∈ U_iso₀) →
      AlgebraicGeometry.IsFinite f_E ∧
      (∀ (U₀ : C₀.Opens) (hU₀ : AlgebraicGeometry.IsAffineOpen U₀),
        Nonempty ↥(f_E ⁻¹ᵁ U₀) →
        AlgebraicGeometry.IsAffineOpen (f_E ⁻¹ᵁ U₀) ∧
        ((f_E.app U₀).hom).Finite ∧
        (∃ r₀ : ↑Γ(C₀, U₀), (f_E.app U₀).hom r₀ ≠ 0 ∧
          ∀ s : ↑Γ(E_sch, f_E ⁻¹ᵁ U₀),
            ∃ (k : ℕ) (a : ↑Γ(C₀, U₀)),
              (f_E.app U₀).hom (r₀ ^ k) * s = (f_E.app U₀).hom a) ∧
        (∀ (p_y : Ideal ↑Γ(C₀, U₀)) [p_y.IsMaximal]
            (𝔪 : Ideal ↑Γ(E_sch, f_E ⁻¹ᵁ U₀)) [𝔪.IsMaximal],
          Ideal.comap (f_E.app U₀).hom 𝔪 = p_y →
          𝔪 ≠ ⊥ ∧
          (∀ s : ↑Γ(E_sch, f_E ⁻¹ᵁ U₀),
            ∃ c : Ω, s - (f_E.app U₀).hom ((Spec.preimage (hU₀.fromSpec ≫ p₀)).hom c) ∈ 𝔪) ∧
          IsPrincipalIdealRing (Localization.AtPrime 𝔪))) := by
    intro C₀ E_sch p₀ U_iso₀ hCl_compl f_E isoP1 hInt_E hProp_fE hComm_E
      hfE_inj_open hfE_surj_on_Uiso ⟨u_gen, hfu_gen_U⟩
    obtain ⟨hP1_fin, hP1_stalk⟩ := hP1Prop E_sch isoP1
    have hLFT_fE : AlgebraicGeometry.LocallyOfFiniteType f_E := inferInstance
    have hFib_fin : ∀ y : ↥C₀, (f_E ⁻¹' {y}).Finite := by
      intro y
      by_cases hyU : y ∈ U_iso₀
      · refine Set.Subsingleton.finite (fun u₁ hu₁ u₂ hu₂ => ?_)
        rw [Set.mem_preimage, Set.mem_singleton_iff] at hu₁ hu₂
        exact hfE_inj_open u₁ u₂ (hu₁.symm ▸ hyU) (hu₁.trans hu₂.symm)
      · have hCl_fib : IsClosed (f_E ⁻¹' {y}) :=
          (hCl_compl y hyU).preimage f_E.continuous
        have hNe_univ : f_E ⁻¹' {y} ≠ Set.univ := by
          intro hUniv
