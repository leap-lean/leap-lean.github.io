  have hgR0_eq : g_R₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) :=
    (AlgebraicGeometry.Spec.map_preimage g_R₀).symm
  have hChart1_g : ι_U1.opensRange.ι ≫ (π_U ≫ g_R₀) =
      ι_U1.isoOpensRange.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.hom.comp φ₀)) := by
    apply (Iso.eq_inv_comp ι_U1.isoOpensRange).mpr
    rw [← Category.assoc, ι_U1.isoOpensRange_hom_ι, ← Category.assoc, hι1_π,
