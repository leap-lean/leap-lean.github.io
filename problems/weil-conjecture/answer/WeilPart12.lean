    have ht₂_not_I₁ : t₂_B ∉ I₁ := by
      intro ht₂_in
      have ht₂_Q₁ : t₂ ∈ Q₁ := by
        rw [← hComap_I₁]
        exact ht₂_in
      have hv₀_le : v₀_ps.asIdeal ≤ Q₁ := by
        rw [hv₀_t, Ideal.span_le]
        rintro x (rfl | rfl)
        · exact ht₁_Q₁
        · exact ht₂_Q₁
      exact not_le_of_gt hQ₁_lt hv₀_le
