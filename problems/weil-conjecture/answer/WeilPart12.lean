          rw [Ideal.mem_comap, RingHom.mem_ker]
          change (1 : R ⧸ I) ⊗ₜ[R] (algebraMap R S r) = 0
          rw [htmul_map r, Ideal.Quotient.eq_zero_iff_mem.mpr hr, TensorProduct.zero_tmul]
        exact fun s hs => hle hs
      let g_ring : (S ⧸ J) →+* TensorProduct R (R ⧸ I) S := Ideal.Quotient.lift J g₀ hker
      let g_alg : (S ⧸ J) →ₐ[R ⧸ I] TensorProduct R (R ⧸ I) S :=
        { g_ring with
