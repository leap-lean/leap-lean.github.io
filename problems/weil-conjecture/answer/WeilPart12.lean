        rw [hpw]
        rfl
      let j₁ := AlgebraicGeometry.IsOpenImmersion.lift (hW₀.fromSpec ≫ V_sm.ι) hU₁.fromSpec hRange_U₁_W₀
      have hj₁ : j₁ ≫ hW₀.fromSpec ≫ V_sm.ι = hU₁.fromSpec :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (hW₀.fromSpec ≫ V_sm.ι) hU₁.fromSpec hRange_U₁_W₀
      have : AlgebraicGeometry.IsOpenImmersion j₁ :=
        AlgebraicGeometry.IsOpenImmersion.of_comp j₁ (hW₀.fromSpec ≫ V_sm.ι)
      have hEt_j₁ : AlgebraicGeometry.Etale j₁ := inferInstance
      let θ : ↑Γ(V_sm.toScheme, W₀) →+* ↑Γ(C₀, C₀.basicOpen h) := (Spec.preimage j₁).hom
      have hEt_θ : θ.Etale := by
        have h1 : AlgebraicGeometry.Etale (Spec.map (Spec.preimage j₁)) := by
          rwa [Spec.map_preimage]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp h1
      let g_sm : MvPolynomial (Fin 1) Ω →+* ↑Γ(C₀, C₀.basicOpen h) :=
        θ.comp (g₀.comp (MvPolynomial.map ι_Ω))
      have hEt_gsm : g_sm.Etale :=
        RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _ hEt_mv hg₀_Et) hEt_θ
      have hg_sm_C : g_sm.comp MvPolynomial.C = (Spec.preimage (hU₁.fromSpec ≫ p₀)).hom := by
        have hSpec_sm : hU₁.fromSpec ≫ p₀ =
            j₁ ≫ Spec.map ((V_sm.ι ≫ p₀).appLE U_Ω W₀ e_W₀) ≫ hU_Ω.fromSpec := by
          calc hU₁.fromSpec ≫ p₀
              = j₁ ≫ hW₀.fromSpec ≫ (V_sm.ι ≫ p₀) := by
                  rw [← hj₁, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
            _ = j₁ ≫ Spec.map ((V_sm.ι ≫ p₀).appLE U_Ω W₀ e_W₀) ≫ hU_Ω.fromSpec := by
                  rw [hU_Ω.SpecMap_appLE_fromSpec (V_sm.ι ≫ p₀) hW₀ e_W₀]
        have hpre := congrArg Spec.preimage hSpec_sm
        rw [Spec.preimage_comp, Spec.preimage_comp, Spec.preimage_map] at hpre
        ext c
        have hc : ((Spec.preimage (hU₁.fromSpec ≫ p₀)).hom c) =
            θ (((V_sm.ι ≫ p₀).appLE U_Ω W₀ e_W₀).hom (ι_Ω c)) :=
          congrArg (fun φ => φ.hom c) hpre
        simp only [g_sm, RingHom.comp_apply, MvPolynomial.map_C]
        have hg₀_c : g₀ (MvPolynomial.C (ι_Ω c)) =
            ((V_sm.ι ≫ p₀).appLE U_Ω W₀ e_W₀).hom (ι_Ω c) :=
          congrArg (fun φ => φ (ι_Ω c)) hg₀_C
        rw [hg₀_c, hc]
      exact ⟨h, hy₁, hh_not_py, hp_y1_max, hcomap_py1, g_sm, hg_sm_C, hEt_gsm⟩

    
    have hNodalChart : ∀ (U₀ : C₀.Opens) (hU₀ : AlgebraicGeometry.IsAffineOpen U₀)
        (y : ↥C₀) (hy₀ : y ∈ U₀)
        (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ C₀)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) Ω ⧸ J_nod))),
        AlgebraicGeometry.Etale e₁ →
        AlgebraicGeometry.Etale e₂ →
        e₁.base u₀ = y →
        (∀ i : Fin 2, Ideal.Quotient.mk J_nod (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) →
        e₁ ≫ p₀ =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk J_nod).comp MvPolynomial.C)) →
        ∃ (W' : U'.Opens) (hW' : AlgebraicGeometry.IsAffineOpen W') (hu₀ : u₀ ∈ W')
          (hW'_le : W' ≤ e₁ ⁻¹ᵁ U₀),
          (((hW'.primeIdealOf ⟨u₀, hu₀⟩).asIdeal)).IsPrime ∧
          ((e₁.appLE U₀ W' hW'_le).hom).Etale ∧
          ((Spec.preimage (hW'.fromSpec ≫ e₂)).hom).Etale ∧
          Ideal.comap (e₁.appLE U₀ W' hW'_le).hom ((hW'.primeIdealOf ⟨u₀, hu₀⟩).asIdeal) =
            (hU₀.primeIdealOf ⟨y, hy₀⟩).asIdeal ∧
          (∀ i : Fin 2,
            (Spec.preimage (hW'.fromSpec ≫ e₂)).hom
              (Ideal.Quotient.mk J_nod (MvPolynomial.X i)) ∈
              (hW'.primeIdealOf ⟨u₀, hu₀⟩).asIdeal) ∧
          ((e₁.appLE U₀ W' hW'_le).hom).comp (Spec.preimage (hU₀.fromSpec ≫ p₀)).hom =
            ((Spec.preimage (hW'.fromSpec ≫ e₂)).hom).comp
              ((Ideal.Quotient.mk J_nod).comp MvPolynomial.C) := by
      intro U₀ hU₀ y hy₀ U' u₀ e₁ e₂ hEt₁ hEt₂ hu₀_y hXi_mem he_comm
      have hu₀_pre : u₀ ∈ e₁ ⁻¹ᵁ U₀ := by
        show e₁.base u₀ ∈ U₀
        rwa [hu₀_y]
      obtain ⟨W', hW', hu₀_W', hW'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_pre
      have hW'_le : W' ≤ e₁ ⁻¹ᵁ U₀ := hW'_sub
      let ψ₁ : ↑Γ(C₀, U₀) →+* ↑Γ(U', W') := (e₁.appLE U₀ W' hW'_le).hom
      let ψ₂ : (MvPolynomial (Fin 2) Ω ⧸ J_nod) →+* ↑Γ(U', W') :=
        (Spec.preimage (hW'.fromSpec ≫ e₂)).hom
      have hw₀_prime : ((hW'.primeIdealOf ⟨u₀, hu₀_W'⟩).asIdeal).IsPrime :=
        (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩).isPrime
      have hEt_ψ₁ : ψ₁.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE
          (P := @AlgebraicGeometry.Etale) e₁ hEt₁ ⟨U₀, hU₀⟩ ⟨W', hW'⟩ hW'_le
      have hEt_ψ₂ : ψ₂.Etale := by
        have : AlgebraicGeometry.Etale e₂ := hEt₂
        have hEt_comp : AlgebraicGeometry.Etale (hW'.fromSpec ≫ e₂) := inferInstance
        have hEt_map : AlgebraicGeometry.Etale (Spec.map (Spec.preimage (hW'.fromSpec ≫ e₂))) := by
          rwa [Spec.map_preimage]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_map
      have hSpec_e₁ : Spec.map (e₁.appLE U₀ W' hW'_le) ≫ hU₀.fromSpec = hW'.fromSpec ≫ e₁ :=
        hU₀.SpecMap_appLE_fromSpec e₁ hW' hW'_le
      have hcomap_w₀ : Ideal.comap ψ₁ ((hW'.primeIdealOf ⟨u₀, hu₀_W'⟩).asIdeal) =
          (hU₀.primeIdealOf ⟨y, hy₀⟩).asIdeal := by
        have h1 : (Spec.map (e₁.appLE U₀ W' hW'_le) ≫ hU₀.fromSpec)
            (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩) =
            (hW'.fromSpec ≫ e₁) (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩) := by rw [hSpec_e₁]
        have h1' : (hU₀.fromSpec : PrimeSpectrum ↑Γ(C₀, U₀) → ↥C₀)
            (PrimeSpectrum.comap ψ₁ (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩)) =
            e₁ (hW'.fromSpec (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩)) := h1
        have h2 : (hU₀.fromSpec : PrimeSpectrum ↑Γ(C₀, U₀) → ↥C₀)
            (PrimeSpectrum.comap ψ₁ (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩)) =
            (hU₀.fromSpec : PrimeSpectrum ↑Γ(C₀, U₀) → ↥C₀) (hU₀.primeIdealOf ⟨y, hy₀⟩) := by
          rw [h1', hW'.fromSpec_primeIdealOf]
          exact hu₀_y.trans (hU₀.fromSpec_primeIdealOf ⟨y, hy₀⟩).symm
        exact congrArg PrimeSpectrum.asIdeal (hU₀.fromSpec.isOpenEmbedding.injective h2)
      have hXi_w₀ : ∀ i : Fin 2,
          ψ₂ (Ideal.Quotient.mk J_nod (MvPolynomial.X i)) ∈
            (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩).asIdeal := by
        intro i
        have hmap : Spec.map (Spec.preimage (hW'.fromSpec ≫ e₂)) = hW'.fromSpec ≫ e₂ :=
          Spec.map_preimage _
        let p_u₀ : ↥(Spec Γ(U', W')) := hW'.primeIdealOf ⟨u₀, hu₀_W'⟩
        have h1 : (Spec.map (Spec.preimage (hW'.fromSpec ≫ e₂))) p_u₀ = e₂ u₀ := by
          rw [hmap, Scheme.Hom.comp_apply]
          have hpu₀ : hW'.fromSpec p_u₀ = u₀ := hW'.fromSpec_primeIdealOf ⟨u₀, hu₀_W'⟩
          rw [hpu₀]
        have h2 : PrimeSpectrum.comap ψ₂ (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩) = e₂ u₀ := h1
        change Ideal.Quotient.mk J_nod (MvPolynomial.X i) ∈
          (PrimeSpectrum.comap ψ₂ (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩)).asIdeal
        rw [h2]
        exact hXi_mem i
      have hcomp_Ω : ψ₁.comp (Spec.preimage (hU₀.fromSpec ≫ p₀)).hom =
          ψ₂.comp ((Ideal.Quotient.mk J_nod).comp MvPolynomial.C) := by
        have hSpec_Ω : Spec.map (e₁.appLE U₀ W' hW'_le) ≫ (hU₀.fromSpec ≫ p₀) =
            (hW'.fromSpec ≫ e₂) ≫
              Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J_nod).comp MvPolynomial.C)) := by
          rw [← CategoryTheory.Category.assoc, hSpec_e₁, CategoryTheory.Category.assoc,
            he_comm, CategoryTheory.Category.assoc]
        have hpre := congrArg Spec.preimage hSpec_Ω
        rw [Spec.preimage_comp, Spec.preimage_comp, Spec.preimage_map, Spec.preimage_map] at hpre
        exact congrArg CommRingCat.Hom.hom hpre
      exact ⟨W', hW', hu₀_W', hW'_le, hw₀_prime, hEt_ψ₁, hEt_ψ₂, hcomap_w₀, hXi_w₀, hcomp_Ω⟩

    refine ⟨?_, ?_⟩
    · 
      intro u₁ u₂ y₀ hu_ne hfu₁ hfu₂ hCl_y₀
      obtain ⟨U₀, hU₀, hy₀_U₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y₀) (U := ⊤) trivial
      have hu₁_VE : u₁ ∈ f_E ⁻¹ᵁ U₀ := by show f_E u₁ ∈ U₀; rwa [hfu₁]
      have hu₂_VE : u₂ ∈ f_E ⁻¹ᵁ U₀ := by show f_E u₂ ∈ U₀; rwa [hfu₂]
      have hNE : Nonempty ↥(f_E ⁻¹ᵁ U₀) := ⟨⟨u₁, hu₁_VE⟩⟩
      obtain ⟨hVE, hFin₀, ⟨r₀, hr₀_ne, hBirat₀⟩, hS_pir₀⟩ := hAffPkg U₀ hU₀ hNE
      have : IsDomain ↑Γ(E_sch, f_E ⁻¹ᵁ U₀) :=
        @AlgebraicGeometry.IsIntegral.component_integral E_sch hInt_E (f_E ⁻¹ᵁ U₀) hNE
      let pt_y₀ : PrimeSpectrum ↑Γ(C₀, U₀) := hU₀.primeIdealOf ⟨y₀, hy₀_U₀⟩
      have hp_y₀_max : pt_y₀.asIdeal.IsMaximal := by
        rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal pt_y₀]
        let g_U₀ : PrimeSpectrum ↑Γ(C₀, U₀) → ↥C₀ := hU₀.fromSpec
        have hpre : g_U₀ ⁻¹' ({y₀} : Set ↥C₀) = ({pt_y₀} : Set (PrimeSpectrum ↑Γ(C₀, U₀))) := by
          ext q
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact ⟨fun h => hU₀.fromSpec.isOpenEmbedding.injective
            (h.trans (hU₀.fromSpec_primeIdealOf ⟨y₀, hy₀_U₀⟩).symm),
            fun h => h ▸ hU₀.fromSpec_primeIdealOf ⟨y₀, hy₀_U₀⟩⟩
        rw [← hpre]
        exact hCl_y₀.preimage hU₀.fromSpec.continuous
      have : pt_y₀.asIdeal.IsMaximal := hp_y₀_max
      rcases hGeom y₀ with ⟨V_sm, hy₀_sm, hSm⟩ |
        ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀_y₀, hXi, he_comm⟩
      · obtain ⟨h, hy₁, _, hp_y1_max, _, g_sm, hg_sm_C, hEt_gsm⟩ :=
          hSmoothChart U₀ hU₀ y₀ hy₀_U₀ V_sm hy₀_sm hSm hp_y₀_max
        let hU₁ : AlgebraicGeometry.IsAffineOpen (C₀.basicOpen h) := hU₀.basicOpen h
        have hu₁_VE1 : u₁ ∈ f_E ⁻¹ᵁ C₀.basicOpen h := by show f_E u₁ ∈ C₀.basicOpen h; rwa [hfu₁]
        have hu₂_VE1 : u₂ ∈ f_E ⁻¹ᵁ C₀.basicOpen h := by show f_E u₂ ∈ C₀.basicOpen h; rwa [hfu₂]
        have hNE₁ : Nonempty ↥(f_E ⁻¹ᵁ C₀.basicOpen h) := ⟨⟨u₁, hu₁_VE1⟩⟩
        obtain ⟨hVE₁, hFin₁, ⟨r₁, hr₁_ne, hBirat₁⟩, hS_pir₁⟩ :=
          hAffPkg (C₀.basicOpen h) hU₁ hNE₁
        have : IsDomain ↑Γ(E_sch, f_E ⁻¹ᵁ C₀.basicOpen h) :=
          @AlgebraicGeometry.IsIntegral.component_integral E_sch hInt_E (f_E ⁻¹ᵁ C₀.basicOpen h) hNE₁
        let p_y1 : Ideal ↑Γ(C₀, C₀.basicOpen h) := (hU₁.primeIdealOf ⟨y₀, hy₁⟩).asIdeal
        have : p_y1.IsMaximal := hp_y1_max
        let φ₁ := (f_E.app (C₀.basicOpen h)).hom
        let q₁_1 := hVE₁.primeIdealOf ⟨u₁, hu₁_VE1⟩
        let q₂_1 := hVE₁.primeIdealOf ⟨u₂, hu₂_VE1⟩
        have hcomm₁ : Spec.map (f_E.app (C₀.basicOpen h)) ≫ hU₁.fromSpec = hVE₁.fromSpec ≫ f_E := by
          rw [f_E.app_eq_appLE]
          exact hU₁.SpecMap_appLE_fromSpec f_E hVE₁ le_rfl
        have hcom₁ : Ideal.comap φ₁ q₁_1.asIdeal = p_y1 := by
          have hc : (Spec.map (f_E.app (C₀.basicOpen h)) ≫ hU₁.fromSpec) q₁_1 =
              (hVE₁.fromSpec ≫ f_E) q₁_1 := by rw [hcomm₁]
          have hc' : (hU₁.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₁ q₁_1) =
              f_E (hVE₁.fromSpec q₁_1) := hc
          have h2 : (hU₁.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₁ q₁_1) =
              (hU₁.fromSpec : PrimeSpectrum _ → ↥C₀) (hU₁.primeIdealOf ⟨y₀, hy₁⟩) := by
            rw [hc', hVE₁.fromSpec_primeIdealOf]
            exact hfu₁.trans (hU₁.fromSpec_primeIdealOf ⟨y₀, hy₁⟩).symm
          exact congrArg PrimeSpectrum.asIdeal (hU₁.fromSpec.isOpenEmbedding.injective h2)
        have hcom₂ : Ideal.comap φ₁ q₂_1.asIdeal = p_y1 := by
          have hc : (Spec.map (f_E.app (C₀.basicOpen h)) ≫ hU₁.fromSpec) q₂_1 =
              (hVE₁.fromSpec ≫ f_E) q₂_1 := by rw [hcomm₁]
          have hc' : (hU₁.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₁ q₂_1) =
              f_E (hVE₁.fromSpec q₂_1) := hc
          have h2 : (hU₁.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₁ q₂_1) =
              (hU₁.fromSpec : PrimeSpectrum _ → ↥C₀) (hU₁.primeIdealOf ⟨y₀, hy₁⟩) := by
            rw [hc', hVE₁.fromSpec_primeIdealOf]
            exact hfu₂.trans (hU₁.fromSpec_primeIdealOf ⟨y₀, hy₁⟩).symm
          exact congrArg PrimeSpectrum.asIdeal (hU₁.fromSpec.isOpenEmbedding.injective h2)
        have hq_eq_idl : q₁_1.asIdeal = q₂_1.asIdeal :=
          ((hLocAlg ↑Γ(C₀, C₀.basicOpen h) ↑Γ(E_sch, f_E ⁻¹ᵁ C₀.basicOpen h)
            (Spec.preimage (hU₁.fromSpec ≫ p₀)).hom φ₁ hFin₁ r₁ hr₁_ne hBirat₁ p_y1
            (hS_pir₁ p_y1)).1 ⟨g_sm, hg_sm_C, hEt_gsm⟩).1
            q₁_1.asIdeal q₂_1.asIdeal q₁_1.isPrime q₂_1.isPrime hcom₁ hcom₂
        have hq12 : q₁_1 = q₂_1 := PrimeSpectrum.ext hq_eq_idl
        have hu12 : u₁ = u₂ :=
          (hVE₁.fromSpec_primeIdealOf ⟨u₁, hu₁_VE1⟩).symm.trans
            ((congrArg hVE₁.fromSpec hq12).trans (hVE₁.fromSpec_primeIdealOf ⟨u₂, hu₂_VE1⟩))
        exact False.elim (hu_ne hu12)
      · obtain ⟨W', hW', hu₀_W', hW'_le, hw₀_prime, hEt_ψ₁, hEt_ψ₂,
            hcomap_w₀, hXi_w₀, hcomp_Ω⟩ :=
          hNodalChart U₀ hU₀ y₀ hy₀_U₀ U' u₀ e₁ e₂ hEt₁ hEt₂ hu₀_y₀ hXi he_comm
        let w₀ : Ideal ↑Γ(U', W') := (hW'.primeIdealOf ⟨u₀, hu₀_W'⟩).asIdeal
        have : w₀.IsPrime := hw₀_prime
        let φ₀ := (f_E.app U₀).hom
        let ψ₁ := (e₁.appLE U₀ W' hW'_le).hom
        let ψ₂ := (Spec.preimage (hW'.fromSpec ≫ e₂)).hom
        let q₁_0 := hVE.primeIdealOf ⟨u₁, hu₁_VE⟩
        let q₂_0 := hVE.primeIdealOf ⟨u₂, hu₂_VE⟩
        have hcomm₀ : Spec.map (f_E.app U₀) ≫ hU₀.fromSpec = hVE.fromSpec ≫ f_E := by
          rw [f_E.app_eq_appLE]
          exact hU₀.SpecMap_appLE_fromSpec f_E hVE le_rfl
        have hcom₁ : Ideal.comap φ₀ q₁_0.asIdeal = pt_y₀.asIdeal := by
          have hc : (Spec.map (f_E.app U₀) ≫ hU₀.fromSpec) q₁_0 =
              (hVE.fromSpec ≫ f_E) q₁_0 := by rw [hcomm₀]
          have hc' : (hU₀.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₀ q₁_0) =
              f_E (hVE.fromSpec q₁_0) := hc
          have h2 : (hU₀.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₀ q₁_0) =
              (hU₀.fromSpec : PrimeSpectrum _ → ↥C₀) pt_y₀ := by
            rw [hc', hVE.fromSpec_primeIdealOf]
            exact hfu₁.trans (hU₀.fromSpec_primeIdealOf ⟨y₀, hy₀_U₀⟩).symm
          exact congrArg PrimeSpectrum.asIdeal (hU₀.fromSpec.isOpenEmbedding.injective h2)
        have hcom₂ : Ideal.comap φ₀ q₂_0.asIdeal = pt_y₀.asIdeal := by
          have hc : (Spec.map (f_E.app U₀) ≫ hU₀.fromSpec) q₂_0 =
              (hVE.fromSpec ≫ f_E) q₂_0 := by rw [hcomm₀]
          have hc' : (hU₀.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₀ q₂_0) =
              f_E (hVE.fromSpec q₂_0) := hc
          have h2 : (hU₀.fromSpec : PrimeSpectrum _ → ↥C₀) (PrimeSpectrum.comap φ₀ q₂_0) =
              (hU₀.fromSpec : PrimeSpectrum _ → ↥C₀) pt_y₀ := by
            rw [hc', hVE.fromSpec_primeIdealOf]
            exact hfu₂.trans (hU₀.fromSpec_primeIdealOf ⟨y₀, hy₀_U₀⟩).symm
          exact congrArg PrimeSpectrum.asIdeal (hU₀.fromSpec.isOpenEmbedding.injective h2)
        have hq12_ne : q₁_0.asIdeal ≠ q₂_0.asIdeal := by
          intro heq
          have hq_eq : q₁_0 = q₂_0 := PrimeSpectrum.ext heq
          exact hu_ne ((hVE.fromSpec_primeIdealOf ⟨u₁, hu₁_VE⟩).symm.trans
            ((congrArg hVE.fromSpec hq_eq).trans (hVE.fromSpec_primeIdealOf ⟨u₂, hu₂_VE⟩)))
        have hMinExhaust : ∀ Q ∈ minimalPrimes ↑Γ(U', W'), Q ≤ w₀ →
            Ideal.comap ψ₁ Q = RingHom.ker φ₀ :=
          ((hLocAlg ↑Γ(C₀, U₀) ↑Γ(E_sch, f_E ⁻¹ᵁ U₀)
            (Spec.preimage (hU₀.fromSpec ≫ p₀)).hom φ₀ hFin₀ r₀ hr₀_ne hBirat₀ pt_y₀.asIdeal
            (hS_pir₀ pt_y₀.asIdeal)).2
            ↑Γ(U', W') ψ₁ ψ₂ w₀ hEt_ψ₁ hEt_ψ₂ hcomap_w₀ hXi_w₀ hcomp_Ω).1
            ⟨q₁_0.asIdeal, q₂_0.asIdeal, q₁_0.isPrime, q₂_0.isPrime, hq12_ne, hcom₁, hcom₂⟩
        let _ : Algebra (MvPolynomial (Fin 2) Ω ⧸ J_nod) ↑Γ(U', W') := ψ₂.toAlgebra
        have : Algebra.Etale (MvPolynomial (Fin 2) Ω ⧸ J_nod) ↑Γ(U', W') := hEt_ψ₂
