  let ι₀ : Spec (CommRingCat.of C_1) ⟶ M_m := ι_fam 0
  let ι₁ : Spec (CommRingCat.of C_1) ⟶ M_m := ι_fam 1
  let ι₂ : Spec (CommRingCat.of C_m2) ⟶ M_m := ι_fam 2
  have hI_nod : I_nod = Ideal.span (Set.range g_vec) := by
