          have h_sub : CategoryTheory.homOfLE h' ≫ incP U₀ = incP U₁ := Subsingleton.elim _ _
          rw [h_sub]; rfl
        · have hnat := RingHom.congr_fun
            (congrArg CommRingCat.Hom.hom (fst.naturality (CategoryTheory.homOfLE h).op)) c
          exact hnat.symm
      exact fun z => LinearMap.congr_fun h_eq z
