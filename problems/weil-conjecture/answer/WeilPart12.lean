      rintro y ⟨hyZ, hyW⟩
      rw [← hφ_range a] at hyW
      obtain ⟨q, rfl⟩ := hyW
      exact ⟨q, hyZ, rfl⟩
    refine ((hWaFin 0).union (hWaFin 1)).subset ?_
    intro y hyZ
    have hyCov : y ∈ (W 0 ⊔ W 1 : E_sch.Opens) := by
      rw [hCovW]
      trivial
    rcases hyCov with hy0 | hy1
    · exact Or.inl ⟨hyZ, hy0⟩
    · exact Or.inr ⟨hyZ, hy1⟩

  · 
    intro V hV _hV_ne α_Ω 𝔪 h𝔪_max
    let S := ↑(E_sch.presheaf.obj (Opposite.op V))
    have h𝔪_prime : 𝔪.IsPrime := h𝔪_max.isPrime
    let p_𝔪 : PrimeSpectrum S := ⟨𝔪, h𝔪_prime⟩
    let u : ↥E_sch := hV.fromSpec.base p_𝔪
    have hu_V : u ∈ V := by
      have h_mem : u ∈ hV.fromSpec.opensRange := ⟨p_𝔪, rfl⟩
      rwa [hV.opensRange_fromSpec] at h_mem
    have hu_Cov : u ∈ (W 0 ⊔ W 1 : E_sch.Opens) := by
      rw [hCovW]
      trivial
    obtain ⟨a, hu_Wa⟩ : ∃ a : Fin 2, u ∈ W a := by
      rcases hu_Cov with h0 | h1
      · exact ⟨0, h0⟩
      · exact ⟨1, h1⟩
    obtain ⟨f, g₀, h_bo, hu_f⟩ :=
      AlgebraicGeometry.exists_basicOpen_le_affine_inter hV (hW a) u ⟨hu_V, hu_Wa⟩
    have hf_not_𝔪 : f ∉ 𝔪 := by
      have hp_bo : p_𝔪 ∈ (TopologicalSpace.Opens.map hV.fromSpec.base).obj (E_sch.basicOpen f) :=
        hu_f
      rw [hV.fromSpec_preimage_basicOpen f] at hp_bo
      exact hp_bo
    let U₀ : E_sch.Opens := E_sch.basicOpen f
    have hU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hV.basicOpen f
    let B := ↑(E_sch.presheaf.obj (Opposite.op U₀))
    let Ta := ↑(E_sch.presheaf.obj (Opposite.op (W a)))
    let i_V : U₀ ⟶ V := CategoryTheory.homOfLE (E_sch.basicOpen_le f)
    let i_a : U₀ ⟶ W a :=
      CategoryTheory.homOfLE (le_of_eq_of_le h_bo (E_sch.basicOpen_le g₀))
    let ρ_S : S →+* B := (E_sch.presheaf.map i_V.op).hom
    let ρ_a : Ta →+* B := (E_sch.presheaf.map i_a.op).hom
    have hLocS : @IsLocalization.Away S _ f B _ ρ_S.toAlgebra := hV.isLocalization_basicOpen f
    have hLocTa : @IsLocalization.Away Ta _ g₀ B _ ρ_a.toAlgebra :=
      (hW a).isLocalization_of_eq_basicOpen g₀ i_a h_bo
    let g : Polynomial Ω := (θ a).symm g₀
    have hθg : θ a g = g₀ := (θ a).apply_symm_apply g₀
    let ψ_P : Polynomial Ω →+* B := ρ_a.comp (θ a).toRingHom
    have hLocP : @IsLocalization.Away (Polynomial Ω) _ g B _ ψ_P.toAlgebra := by
      let _ : Algebra Ta B := ρ_a.toAlgebra
      let _ : Algebra (Polynomial Ω) B := ψ_P.toAlgebra
      have _ : IsLocalization.Away g₀ B := hLocTa
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, ⟨k, rfl⟩⟩
        change IsUnit (ρ_a ((θ a) (g ^ k)))
        rw [map_pow, hθg]
        exact IsLocalization.map_units B (⟨g₀ ^ k, ⟨k, rfl⟩⟩ : Submonoid.powers g₀)
      · intro z
        obtain ⟨⟨x, ⟨_, ⟨k, rfl⟩⟩⟩, hxz⟩ := IsLocalization.surj (Submonoid.powers g₀) z
        refine ⟨⟨(θ a).symm x, ⟨g ^ k, ⟨k, rfl⟩⟩⟩, ?_⟩
        change z * ρ_a (θ a (g ^ k)) = ρ_a (θ a ((θ a).symm x))
        rw [map_pow, hθg, (θ a).apply_symm_apply]
