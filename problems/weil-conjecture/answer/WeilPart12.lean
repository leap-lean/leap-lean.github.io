      · rintro c m₁ _ ⟨a₁, b₁, rfl⟩
        exact ⟨c * a₁, c * b₁, by ring⟩
    let 𝔪' : Ideal L' := IsLocalRing.maximalIdeal L'
    have hu_mem : u ∈ 𝔪' := by
      change u ∈ IsLocalRing.maximalIdeal L'
      rw [hSpan]; exact Ideal.subset_span (Set.mem_insert u {v})
    have hv_mem : v ∈ 𝔪' := by
      change v ∈ IsLocalRing.maximalIdeal L'
      rw [hSpan]; exact Ideal.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton v))
    have hPowDecomp : ∀ (k : ℕ) (z : L'), z ∈ 𝔪' ^ (k + 1) →
        ∃ w ∈ 𝔪' ^ k, ∃ r : L', z = u * w + r * v ^ (k + 1) := by
      intro k
      induction k with
      | zero =>
        intro z hz
        simp only [Nat.zero_add, pow_one, pow_zero, Ideal.one_eq_top] at hz ⊢
        change z ∈ IsLocalRing.maximalIdeal L' at hz
        rw [hSpan] at hz
        obtain ⟨r₁, r₂, rfl⟩ := hSpanPair u v z hz
        exact ⟨r₁, Submodule.mem_top, r₂, by ring⟩
      | succ k ih =>
        intro z hz
        rw [pow_succ' 𝔪' (k + 1)] at hz
        refine Submodule.mul_induction_on hz ?_ ?_
        · intro m hm z₀ hz₀
          have hm' : m ∈ Ideal.span ({u, v} : Set L') := hSpan ▸ hm
          obtain ⟨a, b, rfl⟩ := hSpanPair u v m hm'
          obtain ⟨w₀, hw₀, r₀, rfl⟩ := ih z₀ hz₀
          have hz₀_orig : u * w₀ + r₀ * v ^ (k + 1) ∈ 𝔪' ^ (k + 1) := hz₀
          have hw_new_mem : a * (u * w₀ + r₀ * v ^ (k + 1)) + b * v * w₀ ∈ 𝔪' ^ (k + 1) := by
            refine (𝔪' ^ (k + 1)).add_mem ((𝔪' ^ (k + 1)).mul_mem_left a hz₀_orig) ?_
            have hbv : b * v ∈ 𝔪' := 𝔪'.mul_mem_left b hv_mem
            have hmul : (b * v) * w₀ ∈ 𝔪' * 𝔪' ^ k := Ideal.mul_mem_mul hbv hw₀
            rwa [← pow_succ' 𝔪' k] at hmul
          refine ⟨a * (u * w₀ + r₀ * v ^ (k + 1)) + b * v * w₀, hw_new_mem, b * r₀, ?_⟩
          rw [pow_succ' v (k + 1)]
          ring
        · rintro x₁ x₂ ⟨w₁, hw₁, r₁, rfl⟩ ⟨w₂, hw₂, r₂, rfl⟩
          exact ⟨w₁ + w₂, (𝔪' ^ (k + 1)).add_mem hw₁ hw₂, r₁ + r₂, by ring⟩
    have hv_pow_reg : ∀ (n : ℕ) (y : L'),
        v ^ n * y ∈ Ideal.span ({u} : Set L') → y ∈ Ideal.span ({u} : Set L') := by
      intro n
      induction n with
      | zero =>
        intro y hy
        simpa using hy
      | succ n ih =>
        intro y hy
        apply ih y
        apply hv_reg (v ^ n * y)
        have h_eq : v * (v ^ n * y) = v ^ (n + 1) * y := by rw [pow_succ']; ring
