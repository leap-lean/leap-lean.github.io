      let R_mul := Localization.Away (X_var ℓ * X_var ℓ')
      let α_mul : M_poly →+* R_mul := algebraMap M_poly R_mul
      have hu_mul : IsUnit (α_mul (X_var ℓ * X_var ℓ')) :=
