theorem weil_nc2d_graph_closure_exists (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W Y : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hαK_snd : α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))) :
    let η_K := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∃ (Γ : AlgebraicGeometry.Scheme.{u})
      (ι_Γ : Γ ⟶ CategoryTheory.Limits.pullback g_W g_Y)
      (e_K : CategoryTheory.Limits.pullback g_W η_K ⟶ Γ),
      IsNC2DGraphClosure Ω g_W g_Y α_K ι_Γ e_K ∧
      (∀ w : ↥W,
        w ∈ Set.range (CategoryTheory.Limits.pullback.fst g_W η_K).base ∨
        ∃ q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω),
          (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W = w) :=
by
  let RStar := PowerSeries Ω
  let KStar := FractionRing RStar
  let X_ps : RStar := PowerSeries.X
  let η_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap RStar KStar))
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : RStar →+* Ω))
  have hinj : Function.Injective (algebraMap RStar KStar) :=
    IsFractionRing.injective RStar KStar
  have : IsLocalization.Away X_ps KStar := by
    apply IsLocalization.Away.mk X_ps
    · apply isUnit_iff_ne_zero.mpr
      intro h0
      exact PowerSeries.X_ne_zero (hinj (h0.trans (map_zero _).symm))
    · intro s
      obtain ⟨a, b, hb_nzd, hs_eq⟩ := IsFractionRing.div_surjective (A := RStar) s
      have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
      have hbK_ne : algebraMap RStar KStar b ≠ 0 :=
        fun h => hb_ne (hinj (h.trans (map_zero _).symm))
      obtain ⟨m, u, hu⟩ :=
        IsDiscreteValuationRing.associated_pow_irreducible hb_ne PowerSeries.X_irreducible
      refine ⟨m, a * ↑u, ?_⟩
      have hXm : (algebraMap RStar KStar X_ps) ^ m =
          algebraMap RStar KStar b * algebraMap RStar KStar ↑u := by
        rw [← map_pow, ← hu, map_mul]
      calc s * (algebraMap RStar KStar X_ps) ^ m
          = (algebraMap RStar KStar a / algebraMap RStar KStar b) *
              (algebraMap RStar KStar b * algebraMap RStar KStar ↑u) := by
                rw [← hs_eq, hXm]
        _ = (algebraMap RStar KStar a / algebraMap RStar KStar b *
              algebraMap RStar KStar b) * algebraMap RStar KStar ↑u := by ring
        _ = algebraMap RStar KStar (a * ↑u) := by
              rw [div_mul_cancel₀ _ hbK_ne, map_mul]
    · intro a₁ a₂ ha
      exact ⟨0, by rw [hinj ha]⟩
  have : AlgebraicGeometry.IsOpenImmersion η_K :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization X_ps
  let ι_WK := CategoryTheory.Limits.pullback.fst g_W η_K
  let ι_YK := CategoryTheory.Limits.pullback.fst g_Y η_K
  have : AlgebraicGeometry.IsOpenImmersion ι_WK := inferInstance
  have : AlgebraicGeometry.IsOpenImmersion ι_YK := inferInstance
  have hDichot : ∀ w : ↥W,
      w ∈ Set.range ι_WK.base ∨
      ∃ q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω),
        (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W = w := by
    intro w
    change w ∈ Set.range (CategoryTheory.Limits.pullback.fst g_W η_K).base ∨
      w ∈ Set.range (CategoryTheory.Limits.pullback.fst g_W s_Ω).base
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst,
        AlgebraicGeometry.Scheme.Pullback.range_fst]
    let p : PrimeSpectrum RStar := g_W.base w
    change p ∈ Set.range η_K.base ∨ p ∈ Set.range s_Ω.base
    by_cases hX : X_ps ∈ p.asIdeal
    · right
      refine ⟨(⊥ : PrimeSpectrum Ω), ?_⟩
      apply PrimeSpectrum.ext
      ext f
      have hs_mem : f ∈ (s_Ω.base (⊥ : PrimeSpectrum Ω)).asIdeal ↔
          PowerSeries.constantCoeff f = 0 := by
        change f ∈ (PrimeSpectrum.comap (PowerSeries.constantCoeff : RStar →+* Ω) ⊥).asIdeal ↔ _
        simp
      rw [hs_mem]
      let δ : RStar := f - PowerSeries.C (PowerSeries.constantCoeff f)
      have hδ_coeff : PowerSeries.constantCoeff δ = 0 := by
        simp [δ]
      obtain ⟨f₁, hf₁⟩ := PowerSeries.X_dvd_iff.mpr hδ_coeff
      have hδ_mem : δ ∈ p.asIdeal := by
        rw [hf₁]
        exact Ideal.mul_mem_right f₁ p.asIdeal hX
      constructor
      · intro hf0
        have hfeq : f = δ := by simp [δ, hf0]
        rw [hfeq]
        exact hδ_mem
      · intro hf_mem
        by_contra hc_ne
        have hC_mem : PowerSeries.C (PowerSeries.constantCoeff f) ∈ p.asIdeal := by
          have hsub : f - δ = PowerSeries.C (PowerSeries.constantCoeff f) := by simp [δ]
          rw [← hsub]
          exact Ideal.sub_mem p.asIdeal hf_mem hδ_mem
        have h1_mem : (1 : RStar) ∈ p.asIdeal := by
          have hmul : PowerSeries.C (PowerSeries.constantCoeff f)⁻¹ *
              PowerSeries.C (PowerSeries.constantCoeff f) = 1 := by
            rw [← map_mul, inv_mul_cancel₀ hc_ne, map_one]
          rw [← hmul]
          exact Ideal.mul_mem_left p.asIdeal _ hC_mem
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1_mem)
    · left
      have hrange : Set.range (PrimeSpectrum.comap (algebraMap RStar KStar)) =
          (PrimeSpectrum.basicOpen X_ps : Set (PrimeSpectrum RStar)) :=
        PrimeSpectrum.localization_away_comap_range KStar X_ps
      change p ∈ Set.range (PrimeSpectrum.comap (algebraMap RStar KStar))
      rw [hrange]
      exact hX
  have : AlgebraicGeometry.IsIntegral W := hW.1
  have : AlgebraicGeometry.Surjective g_W := hW.2.2.2.2.1
  have : AlgebraicGeometry.IsProper g_Y := hY.2.2.1
  let W_K := CategoryTheory.Limits.pullback g_W η_K
  let P := CategoryTheory.Limits.pullback g_W g_Y
  let pr₁ := CategoryTheory.Limits.pullback.fst g_W g_Y
  let pr₂ := CategoryTheory.Limits.pullback.snd g_W g_Y
  have hcomm_γ : ι_WK ≫ g_W = (α_K.hom ≫ ι_YK) ≫ g_Y := by
    calc ι_WK ≫ g_W
        = CategoryTheory.Limits.pullback.snd g_W η_K ≫ η_K :=
            CategoryTheory.Limits.pullback.condition
      _ = (α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y η_K) ≫ η_K := by
            rw [hαK_snd]
      _ = α_K.hom ≫ (CategoryTheory.Limits.pullback.snd g_Y η_K ≫ η_K) := by
            rw [CategoryTheory.Category.assoc]
      _ = (α_K.hom ≫ ι_YK) ≫ g_Y := by
            rw [← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
  let γ_K : W_K ⟶ P := CategoryTheory.Limits.pullback.lift ι_WK (α_K.hom ≫ ι_YK) hcomm_γ
  have hγ_pr₁ : γ_K ≫ pr₁ = ι_WK := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hγ_pr₂ : γ_K ≫ pr₂ = α_K.hom ≫ ι_YK := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have : AlgebraicGeometry.IsProper pr₁ := inferInstance
  have : AlgebraicGeometry.IsImmersion (γ_K ≫ pr₁) := by
    rw [hγ_pr₁]; infer_instance
  have : AlgebraicGeometry.QuasiCompact (γ_K ≫ pr₁) := by
    rw [hγ_pr₁]; infer_instance
  have : AlgebraicGeometry.IsImmersion γ_K :=
    AlgebraicGeometry.IsImmersion.of_comp γ_K pr₁
  have : AlgebraicGeometry.QuasiCompact γ_K :=
    AlgebraicGeometry.QuasiCompact.of_comp γ_K pr₁
  let Γ := γ_K.image
  let ι_Γ : Γ ⟶ P := γ_K.imageι
  let e_K : W_K ⟶ Γ := γ_K.toImage
  let p₁ : Γ ⟶ W := ι_Γ ≫ pr₁
  let p₂ : Γ ⟶ Y := ι_Γ ≫ pr₂
  have : AlgebraicGeometry.IsClosedImmersion ι_Γ := inferInstance
  have : AlgebraicGeometry.IsProper p₁ := inferInstance
  have : AlgebraicGeometry.IsOpenImmersion e_K := inferInstance
  have : AlgebraicGeometry.IsDominant e_K := inferInstance
  have he_p₁ : e_K ≫ p₁ = ι_WK := by
    change e_K ≫ (ι_Γ ≫ pr₁) = ι_WK
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι, hγ_pr₁]
  have he_p₂ : e_K ≫ p₂ = α_K.hom ≫ ι_YK := by
    change e_K ≫ (ι_Γ ≫ pr₂) = α_K.hom ≫ ι_YK
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι, hγ_pr₂]
  let η₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of KStar)) := (⊥ : PrimeSpectrum KStar)
  obtain ⟨w_η, hw_η⟩ := g_W.surjective (η_K.base η₀)
  obtain ⟨x_η, _, _⟩ :=
    AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w_η η₀ hw_η
  have : Nonempty ↥W_K := ⟨x_η⟩
  have : AlgebraicGeometry.IsIntegral W_K :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion ι_WK
  have hPreΓ : PreirreducibleSpace ↥Γ := by
    refine ⟨?_⟩
    have h1 : IsPreirreducible (Set.range e_K.base) := by
      rw [← Set.image_univ]
      exact PreirreducibleSpace.isPreirreducible_univ.image e_K.base
        e_K.base.hom.continuous.continuousOn
    have h2 : IsPreirreducible (closure (Set.range e_K.base)) := h1.closure
    rwa [e_K.denseRange.closure_eq] at h2
  have : IrreducibleSpace ↥Γ :=
    { toPreirreducibleSpace := hPreΓ, toNonempty := ⟨e_K.base x_η⟩ }
  have hStalkRed : ∀ z : ↥Γ, _root_.IsReduced ↑(Γ.presheaf.stalk z) := by
    intro z
    obtain ⟨U₀, hAffU₀, hzU₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := ι_Γ.base z) (U := ⊤) trivial
    let U : ↑P.affineOpens := ⟨U₀, hAffU₀⟩
    let V_U : Γ.Opens := (TopologicalSpace.Opens.map ι_Γ.base).obj U.1
    have hzV : z ∈ V_U := hzU₀
    have hAffV : AlgebraicGeometry.IsAffineOpen V_U := U.2.preimage ι_Γ
    have hinj_e : Function.Injective (e_K.app V_U).hom := by
      have happ := AlgebraicGeometry.Scheme.Hom.toImage_app γ_K U
      change Function.Injective ((γ_K.toImage).app ((TopologicalSpace.Opens.map γ_K.imageι.base).obj U.1)).hom
      rw [happ]
      intro a b hab
      have hker : γ_K.ker.ideal U = RingHom.ker (γ_K.app U.1).hom :=
        AlgebraicGeometry.Scheme.Hom.ker_apply γ_K U
      have hH : ∀ x ∈ γ_K.ker.ideal U, (γ_K.app U.1).hom x = 0 := by
        rw [hker]
        exact fun _ hx => hx
      let q₁ : ↑(P.presheaf.obj (Opposite.op U.1)) ⧸ γ_K.ker.ideal U :=
        (γ_K.ker.subschemeObjIso U).hom.hom a
      let q₂ : ↑(P.presheaf.obj (Opposite.op U.1)) ⧸ γ_K.ker.ideal U :=
        (γ_K.ker.subschemeObjIso U).hom.hom b
      change Ideal.Quotient.lift (γ_K.ker.ideal U) (γ_K.app U.1).hom hH q₁ =
        Ideal.Quotient.lift (γ_K.ker.ideal U) (γ_K.app U.1).hom hH q₂ at hab
      have hq_eq : q₁ = q₂ := by
        obtain ⟨r₁, hr₁⟩ := Ideal.Quotient.mk_surjective q₁
        obtain ⟨r₂, hr₂⟩ := Ideal.Quotient.mk_surjective q₂
        rw [← hr₁, ← hr₂] at hab ⊢
        simp only [Ideal.Quotient.lift_mk] at hab
        apply Ideal.Quotient.eq.mpr
        rw [hker, RingHom.mem_ker, map_sub, sub_eq_zero]
        exact hab
      have hiso_inj : Function.Injective (γ_K.ker.subschemeObjIso U).hom.hom :=
        (γ_K.ker.subschemeObjIso U).commRingCatIsoToRingEquiv.injective
      exact hiso_inj hq_eq
    have : _root_.IsReduced ↑(Γ.presheaf.obj (Opposite.op V_U)) :=
      isReduced_of_injective (e_K.app V_U).hom hinj_e
    have : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (Γ.presheaf.obj (Opposite.op V_U))) :=
      (AlgebraicGeometry.affine_isReduced_iff _).mpr inferInstance
    have : AlgebraicGeometry.IsReduced V_U.toScheme :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion hAffV.isoSpec.hom
    have : _root_.IsReduced ↑(V_U.toScheme.presheaf.stalk ⟨z, hzV⟩) :=
      AlgebraicGeometry.isReduced_stalk_of_isReduced V_U.toScheme ⟨z, hzV⟩
    exact isReduced_of_injective (V_U.stalkIso ⟨z, hzV⟩).inv.hom
      (V_U.stalkIso ⟨z, hzV⟩).symm.commRingCatIsoToRingEquiv.injective
  have : AlgebraicGeometry.IsReduced Γ :=
    @AlgebraicGeometry.isReduced_of_isReduced_stalk Γ hStalkRed
  have hIntΓ : AlgebraicGeometry.IsIntegral Γ :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Γ
  let U_K : W.Opens := ι_WK.opensRange
  let O_K : Γ.Opens := (TopologicalSpace.Opens.map p₁.base).obj U_K
  have hSub : Set.range e_K.base ⊆ Set.range O_K.ι.base := by
    rintro _ ⟨x, rfl⟩
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    change p₁.base (e_K.base x) ∈ Set.range ι_WK.base
    have hx : p₁.base (e_K.base x) = ι_WK.base x := by
      change (e_K ≫ p₁).base x = ι_WK.base x
      rw [he_p₁]
    rw [hx]
    exact ⟨x, rfl⟩
  let tilde_e_K : W_K ⟶ O_K.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift O_K.ι e_K hSub
  have htilde_fac : tilde_e_K ≫ O_K.ι = e_K :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac O_K.ι e_K hSub
  have htilde_comp : tilde_e_K ≫ (p₁ ∣_ U_K) = ι_WK.isoOpensRange.hom := by
    rw [← CategoryTheory.cancel_mono U_K.ι]
    calc (tilde_e_K ≫ (p₁ ∣_ U_K)) ≫ U_K.ι
        = tilde_e_K ≫ ((p₁ ∣_ U_K) ≫ U_K.ι) := by rw [CategoryTheory.Category.assoc]
      _ = tilde_e_K ≫ (O_K.ι ≫ p₁) := by rw [AlgebraicGeometry.morphismRestrict_ι]
      _ = (tilde_e_K ≫ O_K.ι) ≫ p₁ := by rw [← CategoryTheory.Category.assoc]
      _ = e_K ≫ p₁ := by rw [htilde_fac]
      _ = ι_WK := he_p₁
      _ = ι_WK.isoOpensRange.hom ≫ U_K.ι := ι_WK.isoOpensRange_hom_ι.symm
  have : AlgebraicGeometry.IsClosedImmersion (tilde_e_K ≫ (p₁ ∣_ U_K)) := by
    rw [htilde_comp]; infer_instance
  have : AlgebraicGeometry.IsClosedImmersion tilde_e_K :=
    AlgebraicGeometry.IsClosedImmersion.of_comp tilde_e_K (p₁ ∣_ U_K)
  have hClosed_tilde : IsClosed (Set.range tilde_e_K.base) :=
    tilde_e_K.isClosedEmbedding.isClosed_range
  have hPre_eq : O_K.ι.base ⁻¹' Set.range e_K.base = Set.range tilde_e_K.base := by
    ext u
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · rintro ⟨x, hx⟩
      refine ⟨x, ?_⟩
      apply O_K.ι.isOpenEmbedding.toIsEmbedding.injective
      have h1 : O_K.ι.base (tilde_e_K.base x) = e_K.base x := by
        change (tilde_e_K ≫ O_K.ι).base x = e_K.base x
        rw [htilde_fac]
      exact h1.trans hx
    · rintro ⟨x, rfl⟩
      refine ⟨x, ?_⟩
      change e_K.base x = (tilde_e_K ≫ O_K.ι).base x
      rw [htilde_fac]
  have hDense_tilde : Dense (Set.range tilde_e_K.base) := by
    rw [← hPre_eq]
    exact e_K.denseRange.preimage O_K.ι.isOpenEmbedding.isOpenMap
  have hRange_tilde : Set.range tilde_e_K.base = Set.univ := by
    rw [← hClosed_tilde.closure_eq, hDense_tilde.closure_eq]
  have hRange₁ : Set.range e_K.base = p₁.base ⁻¹' Set.range ι_WK.base := by
    calc Set.range e_K.base
        = Set.range (tilde_e_K ≫ O_K.ι).base := by rw [htilde_fac]
      _ = O_K.ι.base '' Set.range tilde_e_K.base := by
            ext z
            constructor
            · rintro ⟨x, rfl⟩
              exact ⟨tilde_e_K.base x, ⟨x, rfl⟩, rfl⟩
            · rintro ⟨u, ⟨x, rfl⟩, rfl⟩
              exact ⟨x, rfl⟩
      _ = O_K.ι.base '' Set.univ := by rw [hRange_tilde]
      _ = Set.range O_K.ι.base := Set.image_univ
      _ = (O_K : Set ↥Γ) := AlgebraicGeometry.Scheme.Opens.range_ι O_K
      _ = p₁.base ⁻¹' Set.range ι_WK.base := rfl
  have hp_g : p₁ ≫ g_W = p₂ ≫ g_Y := by
    change (ι_Γ ≫ pr₁) ≫ g_W = (ι_Γ ≫ pr₂) ≫ g_Y
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition]
  have hRange₂ : Set.range e_K.base = p₂.base ⁻¹' Set.range ι_YK.base := by
    rw [hRange₁, AlgebraicGeometry.Scheme.Pullback.range_fst,
        AlgebraicGeometry.Scheme.Pullback.range_fst]
    ext z
    simp only [Set.mem_preimage]
    have hz : g_W.base (p₁.base z) = g_Y.base (p₂.base z) := by
      change (p₁ ≫ g_W).base z = (p₂ ≫ g_Y).base z
      rw [hp_g]
    rw [hz]
  exact ⟨Γ, ι_Γ, e_K,
    ⟨hIntΓ, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      he_p₁, he_p₂, hRange₁, hRange₂⟩,
    hDichot⟩

theorem weil_nc2d_graph_fiber_finite_at_nonclosed_point (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W Y Γ : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (ι_Γ : Γ ⟶ CategoryTheory.Limits.pullback g_W g_Y)
    (e_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ⟶ Γ)
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hGraph : IsNC2DGraphClosure Ω g_W g_Y α_K ι_Γ e_K)
    (q_W : ↥(CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hqW : ¬ IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ((ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y).base ⁻¹'
      {(CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W}).Finite :=
by
  intro s_Ω
  let RStar := PowerSeries Ω
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap RStar (FractionRing RStar)))
  let W₀ := CategoryTheory.Limits.pullback g_W s_Ω
  let fst₀ := CategoryTheory.Limits.pullback.fst g_W s_Ω
  let snd₀ := CategoryTheory.Limits.pullback.snd g_W s_Ω
  let w := fst₀.base q_W
  have : AlgebraicGeometry.IsIntegral W := hW.1
  have : AlgebraicGeometry.IsProper g_W := hW.2.2.1
  have : AlgebraicGeometry.LocallyOfFinitePresentation g_W := hW.2.2.2.1
  have hSurj_gW : AlgebraicGeometry.Surjective g_W := hW.2.2.2.2.1
  have hNC_all := hW.2.2.2.2.2.2.2.2
  have : AlgebraicGeometry.IsProper snd₀ := inferInstance
  have : AlgebraicGeometry.IsSeparated snd₀ := inferInstance
  have : AlgebraicGeometry.LocallyOfFiniteType snd₀ := inferInstance

  
  obtain ⟨U₀, hU₀_aff, hqW_U₀, _⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (AlgebraicGeometry.Scheme.isBasis_affineOpens W₀) (show q_W ∈ (⊤ : W₀.Opens) from trivial)
  have hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hU₀_aff
  let B₀ : CommRingCat.{u} := W₀.presheaf.obj (Opposite.op U₀)
  have hqW_range : q_W ∈ Set.range hAffU₀.fromSpec.base := by
    rw [hAffU₀.range_fromSpec]
    exact hqW_U₀
  obtain ⟨p'₀, hp'₀⟩ := hqW_range
  obtain ⟨M, hMaxM, hp'₀_le_M⟩ := Ideal.exists_le_maximal p'₀.asIdeal p'₀.isPrime.ne_top
  let x_M : AlgebraicGeometry.Spec B₀ := ⟨M, hMaxM.isPrime⟩
  let q₀ : ↥W₀ := hAffU₀.fromSpec.base x_M
  have hq₀_cl_mem : q₀ ∈ closure ({q_W} : Set ↥W₀) := by
    have hxM_spec : p'₀ ⤳ x_M := (PrimeSpectrum.le_iff_specializes p'₀ x_M).mp hp'₀_le_M
    have hxM_cl : x_M ∈ closure ({p'₀} : Set ↥(AlgebraicGeometry.Spec B₀)) :=
      specializes_iff_mem_closure.mp hxM_spec
    rw [← hp'₀, ← Set.image_singleton]
    exact image_closure_subset_closure_image hAffU₀.fromSpec.continuous ⟨x_M, hxM_cl, rfl⟩

  have hClosed_q₀ : IsClosed ({q₀} : Set ↥W₀) := by
    let f_U₀ : AlgebraicGeometry.Spec B₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      hAffU₀.fromSpec ≫ snd₀
    let φ_Ω : CommRingCat.of Ω ⟶ B₀ := AlgebraicGeometry.Spec.preimage f_U₀
    have hSpec_φΩ : AlgebraicGeometry.Spec.map φ_Ω = f_U₀ :=
      AlgebraicGeometry.Spec.map_preimage f_U₀
    have hLFT_fU₀ : AlgebraicGeometry.LocallyOfFiniteType f_U₀ := inferInstance
    have hFT_φΩ : φ_Ω.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (by rwa [hSpec_φΩ])
    let K₀ := ↑B₀ ⧸ M
    let _ : Field K₀ := Ideal.Quotient.field M
    let π_M : ↑B₀ →+* K₀ := Ideal.Quotient.mk M
    let _ : Algebra Ω ↑B₀ := φ_Ω.hom.toAlgebra
    have hFT_ΩB₀ : Algebra.FiniteType Ω ↑B₀ := hFT_φΩ
    have hFT_B₀K₀ : Algebra.FiniteType ↑B₀ K₀ :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ↑B₀ M) Ideal.Quotient.mk_surjective
    have : Algebra.FiniteType Ω K₀ := Algebra.FiniteType.trans hFT_ΩB₀ hFT_B₀K₀
    obtain ⟨s, g, hg_inj, hg_fin⟩ := exists_finite_inj_algHom_of_fg Ω K₀
    have : Algebra.IsIntegral Ω K₀ := by
      let _ : Algebra (MvPolynomial (Fin s) Ω) K₀ := g.toRingHom.toAlgebra
      have : Module.Finite (MvPolynomial (Fin s) Ω) K₀ := hg_fin
      have : Algebra.IsIntegral (MvPolynomial (Fin s) Ω) K₀ :=
        Algebra.IsIntegral.of_finite (MvPolynomial (Fin s) Ω) K₀
      have hFieldMv : IsField (MvPolynomial (Fin s) Ω) :=
        isField_of_isIntegral_of_isField hg_inj (Field.toIsField K₀)
      have : IsEmpty (Fin s) := ⟨fun i => by
        obtain ⟨v, hv⟩ := hFieldMv.mul_inv_cancel (MvPolynomial.X_ne_zero i)
        have hc := congrArg MvPolynomial.constantCoeff hv
        simp [map_mul, MvPolynomial.constantCoeff_X] at hc⟩
      have : IsScalarTower Ω (MvPolynomial (Fin s) Ω) K₀ :=
        IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
      have : Module.Finite Ω (MvPolynomial (Fin s) Ω) :=
        Module.Finite.of_surjective
          (MvPolynomial.isEmptyAlgEquiv Ω (Fin s)).symm.toLinearMap
          (MvPolynomial.isEmptyAlgEquiv Ω (Fin s)).symm.surjective
      have hFin_ΩK₀ : Module.Finite Ω K₀ := Module.Finite.trans (MvPolynomial (Fin s) Ω) K₀
      exact @Algebra.IsIntegral.of_finite Ω K₀ _ _ _ hFin_ΩK₀
    have hBij_ΩK₀ : Function.Bijective (algebraMap Ω K₀) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let α₀ : Ω ≃+* K₀ := RingEquiv.ofBijective (algebraMap Ω K₀) hBij_ΩK₀
    let π₀ : ↑B₀ →+* Ω := α₀.symm.toRingHom.comp π_M
    have hφ_π₀ : φ_Ω ≫ CommRingCat.ofHom π₀ = 𝟙 (CommRingCat.of Ω) := by
      ext c
      change α₀.symm (π_M (φ_Ω.hom c)) = c
      exact α₀.symm_apply_apply c
    let σ_q₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀) ≫ hAffU₀.fromSpec
    have hσ_snd : σ_q₀ ≫ snd₀ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀) ≫ f_U₀ = _
      rw [← hSpec_φΩ, ← AlgebraicGeometry.Spec.map_comp, hφ_π₀, AlgebraicGeometry.Spec.map_id]
    have : AlgebraicGeometry.IsClosedImmersion (σ_q₀ ≫ snd₀) := by
      rw [hσ_snd]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion σ_q₀ :=
      AlgebraicGeometry.IsClosedImmersion.of_comp σ_q₀ snd₀
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
    have hpt_bot : pt_Ω.asIdeal = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro c hc
      by_contra hc0
      exact pt_Ω.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hc0))
    have hπ₀_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀)).base pt_Ω = x_M := by
      apply PrimeSpectrum.ext
      change Ideal.comap π₀ pt_Ω.asIdeal = M
      rw [hpt_bot]
      ext b
      rw [Ideal.mem_comap, Ideal.mem_bot]
      constructor
      · intro h0
        exact Ideal.Quotient.eq_zero_iff_mem.mp
          (α₀.symm.injective (h0.trans (map_zero α₀.symm).symm))
      · intro hb
        change α₀.symm (Ideal.Quotient.mk M b) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb, map_zero]
    have hRange_σ : Set.range σ_q₀.base = {q₀} := by
      ext y
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨z, rfl⟩
        rw [Unique.eq_default z]
        change hAffU₀.fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀)).base pt_Ω) = q₀
        rw [hπ₀_pt]
      · rintro rfl
        exact ⟨pt_Ω, by
          change hAffU₀.fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀)).base pt_Ω) = q₀
          rw [hπ₀_pt]⟩
    rw [← hRange_σ]
    exact σ_q₀.isClosedEmbedding.isClosed_range

  
  obtain ⟨a, b, R₀, p₀, ι_U, z₁, z₂, A', v₀, e_U, u, v, ε,
      hOpen_U, hp₀_q₀, hDomR₀, _, _, _, _, hEt_eU, hDomA', heU_pre,
      hv₀_span, hu_ne, hreg, _, hε, ha, hX_eq⟩ := hNC_all q₀ hClosed_q₀
  have : IsDomain R₀ := hDomR₀
  have : IsDomain A' := hDomA'
  have : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_U
  have : AlgebraicGeometry.Etale e_U := hEt_eU

  have hw_mem_U : w ∈ Set.range ι_U.base := by
    let O₀ : Set ↥W₀ := fst₀.base ⁻¹' Set.range ι_U.base
    have hOpen_O₀ : IsOpen O₀ := ι_U.isOpenEmbedding.isOpen_range.preimage fst₀.continuous
    have hq₀_O₀ : q₀ ∈ O₀ := ⟨p₀, hp₀_q₀⟩
    obtain ⟨y, hy_O₀, hy_eq⟩ := mem_closure_iff.mp hq₀_cl_mem O₀ hOpen_O₀ hq₀_O₀
    rw [Set.mem_singleton_iff] at hy_eq
    subst hy_eq
    exact hy_O₀
  obtain ⟨p, hp_w⟩ := hw_mem_U

  have hSurj_cc : Function.Surjective (PowerSeries.constantCoeff : RStar →+* Ω) :=
    fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩
  have : AlgebraicGeometry.IsClosedImmersion s_Ω :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (PowerSeries.constantCoeff : RStar →+* Ω)) hSurj_cc
  have : AlgebraicGeometry.IsClosedImmersion fst₀ := inferInstance

  have hp_lt : p.asIdeal < p₀.asIdeal := by
    have hp₀_cl : ι_U.base p₀ ∈ closure ({ι_U.base p} : Set ↥W) := by
      rw [hp₀_q₀, hp_w, ← Set.image_singleton]
      exact image_closure_subset_closure_image fst₀.continuous ⟨q₀, hq₀_cl_mem, rfl⟩
    have hp_spec_img : ι_U.base p ⤳ ι_U.base p₀ := specializes_iff_mem_closure.mpr hp₀_cl
    have hp_spec : p ⤳ p₀ := ι_U.isOpenEmbedding.isInducing.specializes_iff.mp hp_spec_img
    have hp_le : p.asIdeal ≤ p₀.asIdeal := (PrimeSpectrum.le_iff_specializes p p₀).mpr hp_spec
    refine lt_of_le_of_ne hp_le ?_
    intro hEq
    have hp_eq : p = p₀ := PrimeSpectrum.ext hEq
    have hfst_eq : fst₀.base q_W = fst₀.base q₀ := by
      change w = fst₀.base q₀
      rw [← hp_w, hp_eq, hp₀_q₀]
    have hq_eq : q_W = q₀ := fst₀.isClosedEmbedding.injective hfst_eq
    rw [hq_eq] at hqW
    exact hqW hClosed_q₀

  let θ : R₀ ⟶ A' := AlgebraicGeometry.Spec.preimage e_U
  have hSpec_θ : AlgebraicGeometry.Spec.map θ = e_U := AlgebraicGeometry.Spec.map_preimage e_U
  let φ₀_c : CommRingCat.of RStar ⟶ R₀ := AlgebraicGeometry.Spec.preimage (ι_U ≫ g_W)
  have hSpec_φ₀ : AlgebraicGeometry.Spec.map φ₀_c = ι_U ≫ g_W :=
    AlgebraicGeometry.Spec.map_preimage (ι_U ≫ g_W)
  let x_X : ↑R₀ := φ₀_c.hom PowerSeries.X

  have hx_mem : x_X ∈ p.asIdeal := by
    have h_base_eq : (AlgebraicGeometry.Spec.map φ₀_c).base p = s_Ω.base (snd₀.base q_W) := by
      rw [hSpec_φ₀]
      calc (ι_U ≫ g_W).base p
          = g_W.base (ι_U.base p) := rfl
        _ = (fst₀ ≫ g_W).base q_W := by rw [hp_w]; rfl
        _ = (snd₀ ≫ s_Ω).base q_W := by rw [CategoryTheory.Limits.pullback.condition]
        _ = s_Ω.base (snd₀.base q_W) := rfl
    have h_ideal_eq : Ideal.comap φ₀_c.hom p.asIdeal =
        Ideal.comap (PowerSeries.constantCoeff : RStar →+* Ω) (snd₀.base q_W).asIdeal :=
      congrArg PrimeSpectrum.asIdeal h_base_eq
    change PowerSeries.X ∈ Ideal.comap φ₀_c.hom p.asIdeal
    rw [h_ideal_eq, Ideal.mem_comap, PowerSeries.constantCoeff_X]
    exact (snd₀.base q_W).asIdeal.zero_mem

  have hx_eq : θ.hom x_X = ε * u ^ a * v ^ b := by
    have h_comp : AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g_W) = φ₀_c ≫ θ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_comp, hSpec_θ, hSpec_φ₀]
    have hX' := hX_eq
    rw [h_comp] at hX'
    exact hX'

  have hv₀_over : Ideal.comap θ.hom v₀.asIdeal = p₀.asIdeal := by
    have hv₀_mem : v₀ ∈ e_U.base ⁻¹' {p₀} := by rw [heU_pre]; rfl
    have hv₀_eq : (AlgebraicGeometry.Spec.map θ).base v₀ = p₀ := by
      rw [hSpec_θ]
      exact hv₀_mem
    exact congrArg PrimeSpectrum.asIdeal hv₀_eq

  have hEtθ : θ.hom.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      (by rwa [hSpec_θ])

  have hNoethR₀ : IsNoetherianRing R₀ := by
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType (ι_U ≫ g_W) := inferInstance
    have hFT : φ₀_c.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (by rwa [hSpec_φ₀])
    let _ : Algebra RStar R₀ := φ₀_c.hom.toAlgebra
    have : Algebra.FiniteType RStar R₀ := hFT
    exact Algebra.FiniteType.isNoetherianRing RStar R₀

  let _ : Algebra R₀ A' := θ.hom.toAlgebra
  have : Algebra.Etale R₀ A' := RingHom.Etale.toAlgebra hEtθ
  have hNoethA' : IsNoetherianRing A' := by
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType e_U := inferInstance
    have hFT : θ.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (by rwa [hSpec_θ])
    have : Algebra.FiniteType R₀ A' := hFT
    exact Algebra.FiniteType.isNoetherianRing R₀ A'

  have : p.asIdeal.IsPrime := p.isPrime
  have : p₀.asIdeal.IsPrime := p₀.isPrime
  have : v₀.asIdeal.IsPrime := v₀.isPrime

  
  have hDVR : IsDiscreteValuationRing (Localization.AtPrime p.asIdeal) := by
    have hv_ne : v ≠ 0 := by
      intro hv0
      have h1_mem_u : (1 : ↑A') ∈ Ideal.span ({u} : Set ↑A') := by
        apply hreg 1
        rw [hv0, zero_mul]
        exact Ideal.zero_mem _
      have h1_mem_v₀ : (1 : ↑A') ∈ v₀.asIdeal := by
        rw [hv₀_span]
        exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert u {v})) h1_mem_u
      exact v₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem_v₀)

    have hx_ne : x_X ≠ 0 := by
      intro hx0
      have h_rhs_ne : ε * u ^ a * v ^ b ≠ 0 :=
        mul_ne_zero (mul_ne_zero hε.ne_zero (pow_ne_zero a hu_ne)) (pow_ne_zero b hv_ne)
      apply h_rhs_ne
      rw [← hx_eq, hx0, map_zero]

    have : Algebra.HasGoingDown R₀ A' := Algebra.HasGoingDown.of_flat
    have : v₀.asIdeal.LiesOver p₀.asIdeal := ⟨hv₀_over.symm⟩
    obtain ⟨P₁, hP₁_lt, hP₁_prime, hP₁_over_inst⟩ :=
      Ideal.exists_ideal_lt_liesOver_of_lt (S := A') v₀.asIdeal hp_lt
    have : P₁.IsPrime := hP₁_prime
    have hP₁_over : p.asIdeal = Ideal.comap (algebraMap R₀ A') P₁ := hP₁_over_inst.over

    let L₁ := Localization.AtPrime P₁
    have : IsDomain L₁ :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors P₁)
    have hinj_A'L₁ : Function.Injective (algebraMap A' L₁) :=
      IsLocalization.injective L₁ (Ideal.primeCompl_le_nonZeroDivisors P₁)

    have hProd_P₁ : ε * u ^ a * v ^ b ∈ P₁ := by
      rw [← show algebraMap R₀ A' x_X = ε * u ^ a * v ^ b from hx_eq]
      rw [← Ideal.mem_comap, ← hP₁_over]
      exact hx_mem

    have hBranch : ∃ (t₁ t₂ : ↑A') (u_tilde : L₁) (N : ℕ),
        v₀.asIdeal = Ideal.span ({t₁, t₂} : Set ↑A') ∧
        t₁ ≠ 0 ∧
        t₁ ∈ P₁ ∧
        t₂ ∉ P₁ ∧
        IsUnit u_tilde ∧
        1 ≤ N ∧
        algebraMap A' L₁ (ε * u ^ a * v ^ b) = u_tilde * (algebraMap A' L₁ t₁) ^ N := by
      rcases hP₁_prime.mem_or_mem hProd_P₁ with hεu | hvb
      · have hε_not_P₁ : ε ∉ P₁ :=
          fun h => hP₁_prime.ne_top (Ideal.eq_top_of_isUnit_mem P₁ h hε)
        have hua_P₁ : u ^ a ∈ P₁ := (hP₁_prime.mem_or_mem hεu).resolve_left hε_not_P₁
        have hu_P₁ : u ∈ P₁ := hP₁_prime.mem_of_pow_mem a hua_P₁
        have hv_not_P₁ : v ∉ P₁ := by
          intro hv_P₁
          apply not_le_of_gt hP₁_lt
          rw [hv₀_span, Ideal.span_le]
          rintro x (rfl | rfl)
          · exact hu_P₁
          · exact hv_P₁
        have hv_unit : IsUnit (algebraMap A' L₁ v) :=
          IsLocalization.map_units L₁ (⟨v, hv_not_P₁⟩ : P₁.primeCompl)
        refine ⟨u, v, algebraMap A' L₁ ε * (algebraMap A' L₁ v) ^ b, a,
          hv₀_span, hu_ne, hu_P₁, hv_not_P₁, (hε.map _).mul (hv_unit.pow b), ha, ?_⟩
        simp only [map_mul, map_pow]
        ring
      · have hb_pos : 1 ≤ b := by
          rcases Nat.eq_zero_or_pos b with rfl | hb_pos
          · exfalso
            rw [pow_zero] at hvb
            exact hP₁_prime.ne_top ((Ideal.eq_top_iff_one _).mpr hvb)
          · exact hb_pos
        have hv_P₁ : v ∈ P₁ := hP₁_prime.mem_of_pow_mem b hvb
        have hu_not_P₁ : u ∉ P₁ := by
          intro hu_P₁
          apply not_le_of_gt hP₁_lt
          rw [hv₀_span, Ideal.span_le]
          rintro x (rfl | rfl)
          · exact hu_P₁
          · exact hv_P₁
        have hu_unit : IsUnit (algebraMap A' L₁ u) :=
          IsLocalization.map_units L₁ (⟨u, hu_not_P₁⟩ : P₁.primeCompl)
        have hv₀_swap : v₀.asIdeal = Ideal.span ({v, u} : Set ↑A') := by
          rw [hv₀_span, Set.pair_comm]
        refine ⟨v, u, algebraMap A' L₁ ε * (algebraMap A' L₁ u) ^ a, b,
          hv₀_swap, hv_ne, hv_P₁, hu_not_P₁, (hε.map _).mul (hu_unit.pow a), hb_pos, ?_⟩
        simp only [map_mul, map_pow]

    obtain ⟨t₁, t₂, u_tilde, N, hv₀_t, ht₁_ne, ht₁_P₁, ht₂_not_P₁, hu_tilde, _, hL₁_prod⟩ :=
      hBranch
    let τ₁ : L₁ := algebraMap A' L₁ t₁
    have hτ₁_ne : τ₁ ≠ 0 :=
      fun h => ht₁_ne (hinj_A'L₁ (h.trans (map_zero _).symm))

    
    have hExpand : ∀ (x : ↑A'), x ∈ P₁ → ∀ r : ℕ,
        ∃ (c b_r : ↑A'), b_r ∈ P₁ ∧ x = c * t₁ + b_r * t₂ ^ r := by
      intro x hx r
      induction r with
      | zero =>
        exact ⟨0, x, hx, by ring⟩
      | succ r ih =>
        obtain ⟨c, b_r, hb_r, hx_eq_r⟩ := ih
        have hb_v₀ : b_r ∈ Ideal.span ({t₁, t₂} : Set ↑A') := by
          rw [← hv₀_t]
          exact le_of_lt hP₁_lt hb_r
        obtain ⟨α, β, hαβ⟩ := Ideal.mem_span_pair.mp hb_v₀
        have hβt₂_P₁ : β * t₂ ∈ P₁ := by
          have h_sub : β * t₂ = b_r - α * t₁ := by rw [← hαβ]; ring
          rw [h_sub]
          exact P₁.sub_mem hb_r (Ideal.mul_mem_left P₁ α ht₁_P₁)
        have hβ_P₁ : β ∈ P₁ := (hP₁_prime.mem_or_mem hβt₂_P₁).resolve_right ht₂_not_P₁
        refine ⟨c + α * t₂ ^ r, β, hβ_P₁, ?_⟩
        calc x = c * t₁ + b_r * t₂ ^ r := hx_eq_r
          _ = c * t₁ + (α * t₁ + β * t₂) * t₂ ^ r := by rw [← hαβ]
          _ = (c + α * t₂ ^ r) * t₁ + β * t₂ ^ (r + 1) := by ring

    have hm_L₁ : IsLocalRing.maximalIdeal L₁ = Ideal.span ({τ₁} : Set L₁) := by
      let L₀ := Localization.AtPrime v₀.asIdeal
      have : IsNoetherianRing L₀ :=
        IsLocalization.isNoetherianRing v₀.asIdeal.primeCompl L₀ hNoethA'
      have hinj_A'L₀ : Function.Injective (algebraMap A' L₀) :=
        IsLocalization.injective L₀ (Ideal.primeCompl_le_nonZeroDivisors v₀.asIdeal)
      let I₁ : Ideal L₀ := Ideal.span ({algebraMap A' L₀ t₁} : Set L₀)
      let Q₀ := L₀ ⧸ I₁
      have : Module.Finite L₀ Q₀ :=
        Module.Finite.of_surjective
          (Ideal.Quotient.mkₐ L₀ I₁).toLinearMap Ideal.Quotient.mk_surjective
      have ht₂_v₀ : t₂ ∈ v₀.asIdeal := by
        rw [hv₀_t]
        exact Ideal.subset_span (Set.mem_insert_of_mem t₁ (Set.mem_singleton t₂))
      have ht₂_max₀ : algebraMap A' L₀ t₂ ∈ IsLocalRing.maximalIdeal L₀ :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff L₀ v₀.asIdeal t₂).mpr ht₂_v₀
      have hP₁_in_τ₁ : ∀ x : ↑A', x ∈ P₁ → algebraMap A' L₁ x ∈ Ideal.span ({τ₁} : Set L₁) := by
        intro x hx
        have hx_Q₀_zero : Ideal.Quotient.mk I₁ (algebraMap A' L₀ x) = 0 := by
          rw [← Submodule.mem_bot (R := L₀)]
          rw [← Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := Q₀)
            (IsLocalRing.maximalIdeal L₀) (IsLocalRing.maximalIdeal.isMaximal L₀).ne_top]
          rw [Submodule.mem_iInf]
          intro r
          obtain ⟨c, b_r, _, hx_r⟩ := hExpand x hx r
          have hmk_eq : Ideal.Quotient.mk I₁ (algebraMap A' L₀ x) =
              ((algebraMap A' L₀ t₂) ^ r) • Ideal.Quotient.mk I₁ (algebraMap A' L₀ b_r) := by
            have hct₁_mem : algebraMap A' L₀ (c * t₁) ∈ I₁ := by
              rw [map_mul]
              exact Ideal.mul_mem_left I₁ _ (Ideal.subset_span rfl)
            have hct₁_zero : Ideal.Quotient.mk I₁ (algebraMap A' L₀ (c * t₁)) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr hct₁_mem
            calc Ideal.Quotient.mk I₁ (algebraMap A' L₀ x)
                = Ideal.Quotient.mk I₁ (algebraMap A' L₀ (c * t₁) +
                    (algebraMap A' L₀ t₂) ^ r * algebraMap A' L₀ b_r) := by
                      congr 1; rw [hx_r]; simp [map_add, map_mul, map_pow]; ring
              _ = ((algebraMap A' L₀ t₂) ^ r) • Ideal.Quotient.mk I₁ (algebraMap A' L₀ b_r) := by
                    rw [map_add, hct₁_zero, zero_add]
                    rfl
          rw [hmk_eq]
          exact Submodule.smul_mem_smul (Ideal.pow_mem_pow ht₂_max₀ r) Submodule.mem_top
        have hx_I₁ : algebraMap A' L₀ x ∈ I₁ :=
          Ideal.Quotient.eq_zero_iff_mem.mp hx_Q₀_zero
        obtain ⟨z₀, hz₀⟩ := Ideal.mem_span_singleton.mp hx_I₁
        obtain ⟨⟨y, s⟩, hzs⟩ := IsLocalization.surj v₀.asIdeal.primeCompl z₀
        have hsx_eq : (s : ↑A') * x = t₁ * y := by
          apply hinj_A'L₀
          calc algebraMap A' L₀ ((s : ↑A') * x)
              = algebraMap A' L₀ (s : ↑A') * (algebraMap A' L₀ t₁ * z₀) := by rw [map_mul, hz₀]
            _ = algebraMap A' L₀ t₁ * (z₀ * algebraMap A' L₀ (s : ↑A')) := by ring
            _ = algebraMap A' L₀ (t₁ * y) := by rw [hzs, map_mul]
        have hs_not_P₁ : (s : ↑A') ∉ P₁ :=
          fun hs_P₁ => s.2 (le_of_lt hP₁_lt hs_P₁)
        obtain ⟨s_inv, hs_inv⟩ :=
          (IsLocalization.map_units L₁ (⟨(s : ↑A'), hs_not_P₁⟩ : P₁.primeCompl)).exists_right_inv
        rw [Ideal.mem_span_singleton]
        refine ⟨algebraMap A' L₁ y * s_inv, ?_⟩
        calc algebraMap A' L₁ x
            = algebraMap A' L₁ x * (algebraMap A' L₁ (s : ↑A') * s_inv) := by rw [hs_inv, mul_one]
          _ = algebraMap A' L₁ ((s : ↑A') * x) * s_inv := by rw [map_mul]; ring
          _ = τ₁ * (algebraMap A' L₁ y * s_inv) := by rw [hsx_eq, map_mul]; ring
      apply le_antisymm
      · intro w₁ hw₁
        obtain ⟨⟨x, s'⟩, hw₁_s⟩ := IsLocalization.surj P₁.primeCompl w₁
        have hx_max₁ : algebraMap A' L₁ x ∈ IsLocalRing.maximalIdeal L₁ := by
          rw [← hw₁_s]
          exact Ideal.mul_mem_right _ _ hw₁
        have hx_P₁ : x ∈ P₁ :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff L₁ P₁ x).mp hx_max₁
        obtain ⟨q₁, hq₁⟩ := Ideal.mem_span_singleton.mp (hP₁_in_τ₁ x hx_P₁)
        obtain ⟨s'_inv, hs'_inv⟩ := (IsLocalization.map_units L₁ s').exists_right_inv
        rw [Ideal.mem_span_singleton]
        refine ⟨q₁ * s'_inv, ?_⟩
        calc w₁ = (w₁ * algebraMap A' L₁ (s' : ↑A')) * s'_inv := by
              rw [mul_assoc, hs'_inv, mul_one]
          _ = τ₁ * (q₁ * s'_inv) := by rw [hw₁_s, hq₁, mul_assoc]
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff L₁ P₁ t₁).mpr ht₁_P₁

    
    let V_w := Localization.AtPrime p.asIdeal
    have : IsDomain V_w :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p.asIdeal)
    have : IsNoetherianRing V_w :=
      IsLocalization.isNoetherianRing p.asIdeal.primeCompl V_w hNoethR₀
    have hinj_R₀Vw : Function.Injective (algebraMap R₀ V_w) :=
      IsLocalization.injective V_w (Ideal.primeCompl_le_nonZeroDivisors p.asIdeal)

    let θ_loc : V_w →+* L₁ :=
      Localization.localRingHom p.asIdeal P₁ (algebraMap R₀ A') hP₁_over
    let _ : Algebra V_w L₁ := θ_loc.toAlgebra
    have : IsScalarTower R₀ V_w L₁ := IsScalarTower.of_algebraMap_eq' <| by
      ext r
      exact (Localization.localRingHom_to_map p.asIdeal P₁ (algebraMap R₀ A') hP₁_over r).symm
    have hFlat_R₀L₁ : Module.Flat R₀ L₁ := Module.Flat.trans R₀ A' L₁
    have : Module.Flat V_w L₁ :=
      (Module.flat_iff_of_isLocalization (S := V_w) p.asIdeal.primeCompl L₁).mpr hFlat_R₀L₁
    have : IsLocalHom θ_loc :=
      Localization.isLocalHom_localRingHom p.asIdeal P₁ (algebraMap R₀ A') hP₁_over
    have : Module.FaithfullyFlat V_w L₁ := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have : Algebra.FormallyUnramified R₀ L₁ := Algebra.FormallyUnramified.comp R₀ A' L₁
    have : Algebra.FormallyUnramified V_w L₁ :=
      Algebra.FormallyUnramified.localization_base p.asIdeal.primeCompl
    have : Algebra.EssFiniteType R₀ L₁ := Algebra.EssFiniteType.comp R₀ A' L₁
    have : Algebra.EssFiniteType V_w L₁ := Algebra.EssFiniteType.of_comp R₀ V_w L₁

    let m_p : Ideal V_w := IsLocalRing.maximalIdeal V_w
    let J : Ideal L₁ := Ideal.map θ_loc m_p
    have hRed_quot : IsReduced (L₁ ⧸ J) := by
      let κ_p := V_w ⧸ m_p
      let _ : Field κ_p := Ideal.Quotient.field m_p
      have : IsReduced (TensorProduct V_w κ_p L₁) :=
        Algebra.FormallyUnramified.isReduced_of_field κ_p (TensorProduct V_w κ_p L₁)
      let e : (L₁ ⧸ J) ≃+* TensorProduct V_w κ_p L₁ :=
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (A := V_w) L₁ m_p).toRingEquiv.trans
          (Algebra.TensorProduct.comm V_w L₁ κ_p).toRingEquiv
      exact ⟨fun x ⟨k, hk⟩ => e.injective <| by
        rw [map_zero]
        exact IsReduced.eq_zero (e x) ⟨k, by rw [← map_pow, hk, map_zero]⟩⟩

    let m_X : V_w := algebraMap R₀ V_w x_X
    have hmX_mem : m_X ∈ m_p :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff V_w p.asIdeal x_X).mpr hx_mem
    have hmX_ne : m_X ≠ 0 :=
      fun h => hx_ne (hinj_R₀Vw (h.trans (map_zero _).symm))

    have hτ₁_in_J : τ₁ ∈ J := by
      have hθ_mX : θ_loc m_X = u_tilde * τ₁ ^ N := by
        calc θ_loc (algebraMap R₀ V_w x_X)
            = algebraMap A' L₁ (algebraMap R₀ A' x_X) :=
                Localization.localRingHom_to_map p.asIdeal P₁ (algebraMap R₀ A') hP₁_over x_X
          _ = algebraMap A' L₁ (ε * u ^ a * v ^ b) := by rw [show algebraMap R₀ A' x_X = _ from hx_eq]
          _ = u_tilde * τ₁ ^ N := hL₁_prod
      obtain ⟨u_inv, hu_inv⟩ := hu_tilde.exists_left_inv
      have hτ₁N_J : τ₁ ^ N ∈ J := by
        have hmem : θ_loc m_X ∈ J := Ideal.mem_map_of_mem θ_loc hmX_mem
        have heq : τ₁ ^ N = u_inv * θ_loc m_X := by
          rw [hθ_mX, ← mul_assoc, hu_inv, one_mul]
        rw [heq]
        exact Ideal.mul_mem_left J u_inv hmem
      have hmk_zero : Ideal.Quotient.mk J τ₁ = 0 :=
        IsReduced.eq_zero _ ⟨N, by
          rw [← map_pow]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hτ₁N_J⟩
      exact Ideal.Quotient.eq_zero_iff_mem.mp hmk_zero

    have hex_m₀ : ∃ m₀ ∈ m_p, θ_loc m₀ ∉ Ideal.span ({τ₁ ^ 2} : Set L₁) := by
      by_contra hAll
      push Not at hAll
      have hJ_le : J ≤ Ideal.span ({τ₁ ^ 2} : Set L₁) :=
        Ideal.map_le_iff_le_comap.mpr hAll
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (hJ_le hτ₁_in_J)
      have h1_eq : (1 : L₁) = τ₁ * c := by
        apply mul_left_cancel₀ hτ₁_ne
        calc τ₁ * 1 = τ₁ := mul_one τ₁
          _ = τ₁ ^ 2 * c := hc
          _ = τ₁ * (τ₁ * c) := by ring
      have h1_max : (1 : L₁) ∈ IsLocalRing.maximalIdeal L₁ := by
        rw [hm_L₁, Ideal.mem_span_singleton]
        exact ⟨c, h1_eq⟩
      exact (IsLocalRing.maximalIdeal.isMaximal L₁).ne_top ((Ideal.eq_top_iff_one _).mpr h1_max)

    have h_map_max : ∀ m ∈ m_p, θ_loc m ∈ IsLocalRing.maximalIdeal L₁ := by
      intro m hm
      by_contra hm_not
      have hUnit : IsUnit (θ_loc m) := IsLocalRing.notMem_maximalIdeal.mp hm_not
      exact (IsLocalRing.notMem_maximalIdeal.mpr ((isUnit_map_iff θ_loc m).mp hUnit)) hm
    obtain ⟨m₀, hm₀_mem, hm₀_not_sq⟩ := hex_m₀
    have hθ_m₀_max : θ_loc m₀ ∈ IsLocalRing.maximalIdeal L₁ := h_map_max m₀ hm₀_mem
    rw [hm_L₁] at hθ_m₀_max
    obtain ⟨u', hu'⟩ := Ideal.mem_span_singleton.mp hθ_m₀_max
    have hu'_not_max : u' ∉ IsLocalRing.maximalIdeal L₁ := by
      intro hu'_max
      rw [hm_L₁] at hu'_max
      obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton.mp hu'_max
      apply hm₀_not_sq
      rw [Ideal.mem_span_singleton]
      exact ⟨c', by rw [hu', hc']; ring⟩
    obtain ⟨v', hv'⟩ := (IsLocalRing.notMem_maximalIdeal.mp hu'_not_max).exists_right_inv
    have hmap_eq : Ideal.map θ_loc m_p = Ideal.map θ_loc (Ideal.span ({m₀} : Set V_w)) := by
      apply le_antisymm
      · calc Ideal.map θ_loc m_p
            ≤ IsLocalRing.maximalIdeal L₁ := Ideal.map_le_iff_le_comap.mpr h_map_max
          _ = Ideal.span ({τ₁} : Set L₁) := hm_L₁
          _ ≤ Ideal.map θ_loc (Ideal.span ({m₀} : Set V_w)) := by
              rw [Ideal.span_le, Set.singleton_subset_iff]
              have hτ₁_eq : τ₁ = v' * θ_loc m₀ := by
                calc τ₁ = τ₁ * (u' * v') := by rw [hv', mul_one]
                  _ = v' * (τ₁ * u') := by ring
                  _ = v' * θ_loc m₀ := by rw [hu']
              rw [hτ₁_eq]
              exact Ideal.mul_mem_left _ v' (Ideal.mem_map_of_mem θ_loc (Ideal.subset_span rfl))
      · exact Ideal.map_mono (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hm₀_mem))

    have hm_p_eq : m_p = Ideal.span ({m₀} : Set V_w) := by
      calc m_p
          = Ideal.comap (algebraMap V_w L₁) (Ideal.map (algebraMap V_w L₁) m_p) :=
              (Ideal.comap_map_eq_self_of_faithfullyFlat m_p).symm
        _ = Ideal.comap (algebraMap V_w L₁)
              (Ideal.map (algebraMap V_w L₁) (Ideal.span ({m₀} : Set V_w))) := by
              change Ideal.comap θ_loc (Ideal.map θ_loc m_p) =
                Ideal.comap θ_loc (Ideal.map θ_loc (Ideal.span ({m₀} : Set V_w)))
              rw [hmap_eq]
        _ = Ideal.span ({m₀} : Set V_w) :=
              Ideal.comap_map_eq_self_of_faithfullyFlat (Ideal.span ({m₀} : Set V_w))

    have hNotFieldVw : ¬ IsField V_w := by
      intro hF
      obtain ⟨w_inv, hw_inv⟩ := hF.mul_inv_cancel hmX_ne
      exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨w_inv, hw_inv⟩))
        hmX_mem

    apply ((IsDiscreteValuationRing.TFAE V_w hNotFieldVw).out 1 5).mpr
    exact ⟨⟨m₀, by rw [Ideal.submodule_span_eq]; exact hm_p_eq⟩⟩

  
  let p₁ := ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y
  let W_K := CategoryTheory.Limits.pullback g_W η_K
  let ι_WK := CategoryTheory.Limits.pullback.fst g_W η_K
  have : AlgebraicGeometry.IsIntegral Γ := hGraph.1
  have : AlgebraicGeometry.IsProper p₁ := hGraph.2.2.1
  have : AlgebraicGeometry.IsOpenImmersion e_K := hGraph.2.2.2.1
  have : AlgebraicGeometry.IsOpenImmersion ι_WK := hGraph.2.2.2.2.1
  have he_p₁ : e_K ≫ p₁ = ι_WK := hGraph.2.2.2.2.2.2.1
  have hRange_eK : Set.range e_K.base = p₁.base ⁻¹' Set.range ι_WK.base :=
    hGraph.2.2.2.2.2.2.2.2.1

  have hNE_WK : Nonempty ↥W_K := by
    let y_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of (FractionRing RStar))) := default
    obtain ⟨x_W, hx_W⟩ := hSurj_gW.surj (η_K.base y_K)
    obtain ⟨z_K, _, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x_W y_K hx_W
    exact ⟨z_K⟩

  let U_W : W.Opens := ι_U.opensRange
  let O_Γ : Γ.Opens := (TopologicalSpace.Opens.map p₁.base).obj U_W
  have hAff_UW : AlgebraicGeometry.IsAffineOpen U_W := AlgebraicGeometry.isAffineOpen_opensRange ι_U
  have hComp_OΓ : IsCompact (O_Γ : Set ↥Γ) := p₁.isCompact_preimage hAff_UW.isCompact

  have hSub_aff : ∀ (V : Γ.Opens), AlgebraicGeometry.IsAffineOpen V → V ≤ O_Γ →
      ((V : Set ↥Γ) ∩ (p₁.base ⁻¹' {ι_U.base p})).Subsingleton := by
    intro V hAffV hV_le z₁_pt ⟨hz₁_V, hz₁_fib⟩ z₂_pt ⟨hz₂_V, hz₂_fib⟩
    have : Nonempty V := ⟨⟨z₁_pt, hz₁_V⟩⟩
    let B : CommRingCat.{u} := Γ.presheaf.obj (Opposite.op V)
    have : IsDomain B := inferInstance
    have hRange_lift : Set.range (hAffV.fromSpec ≫ p₁).base ⊆ Set.range ι_U.base := by
      rintro y ⟨q, rfl⟩
      have hq_V : hAffV.fromSpec.base q ∈ (V : Set ↥Γ) := by
        rw [← hAffV.range_fromSpec]
        exact ⟨q, rfl⟩
      exact hV_le hq_V
    let f_V : AlgebraicGeometry.Spec B ⟶ AlgebraicGeometry.Spec R₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift ι_U (hAffV.fromSpec ≫ p₁) hRange_lift
    have hfV_fac : f_V ≫ ι_U = hAffV.fromSpec ≫ p₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_U (hAffV.fromSpec ≫ p₁) hRange_lift
    let ψ_c : R₀ ⟶ B := AlgebraicGeometry.Spec.preimage f_V
    have hSpec_ψ : AlgebraicGeometry.Spec.map ψ_c = f_V :=
      AlgebraicGeometry.Spec.map_preimage f_V
    let ψ : ↑R₀ →+* ↑B := ψ_c.hom

    obtain ⟨Q₁, hQ₁_z⟩ := show z₁_pt ∈ Set.range hAffV.fromSpec.base by
      rw [hAffV.range_fromSpec]; exact hz₁_V
    obtain ⟨Q₂, hQ₂_z⟩ := show z₂_pt ∈ Set.range hAffV.fromSpec.base by
      rw [hAffV.range_fromSpec]; exact hz₂_V

    have hQ₁_over : Ideal.comap ψ Q₁.asIdeal = p.asIdeal := by
      have hfQ₁ : (AlgebraicGeometry.Spec.map ψ_c).base Q₁ = p := by
        rw [hSpec_ψ]
        apply ι_U.isOpenEmbedding.injective
        calc (f_V ≫ ι_U).base Q₁
            = (hAffV.fromSpec ≫ p₁).base Q₁ := by rw [hfV_fac]
          _ = p₁.base z₁_pt := by change p₁.base (hAffV.fromSpec.base Q₁) = _; rw [hQ₁_z]
          _ = ι_U.base p := hz₁_fib
      exact congrArg PrimeSpectrum.asIdeal hfQ₁

    have hQ₂_over : Ideal.comap ψ Q₂.asIdeal = p.asIdeal := by
      have hfQ₂ : (AlgebraicGeometry.Spec.map ψ_c).base Q₂ = p := by
        rw [hSpec_ψ]
        apply ι_U.isOpenEmbedding.injective
        calc (f_V ≫ ι_U).base Q₂
            = (hAffV.fromSpec ≫ p₁).base Q₂ := by rw [hfV_fac]
          _ = p₁.base z₂_pt := by change p₁.base (hAffV.fromSpec.base Q₂) = _; rw [hQ₂_z]
          _ = ι_U.base p := hz₂_fib
      exact congrArg PrimeSpectrum.asIdeal hfQ₂

    have : IrreducibleSpace ↥Γ := AlgebraicGeometry.irreducibleSpace_of_isIntegral Γ
    obtain ⟨x_K0⟩ := hNE_WK
    obtain ⟨z₀, hz₀_V, x₀, hx₀_z₀⟩ :=
      nonempty_preirreducible_inter V.isOpen e_K.isOpenEmbedding.isOpen_range
        ⟨z₁_pt, hz₁_V⟩ ⟨e_K.base x_K0, x_K0, rfl⟩
    obtain ⟨Q₀, hQ₀_z⟩ := show z₀ ∈ Set.range hAffV.fromSpec.base by
      rw [hAffV.range_fromSpec]; exact hz₀_V

    let Ω_gen : TopologicalSpace.Opens ↥(AlgebraicGeometry.Spec R₀) :=
      ⟨ι_U.base ⁻¹' (ι_WK.base '' (e_K.base ⁻¹' (V : Set ↥Γ))),
        (ι_WK.isOpenEmbedding.isOpenMap _ (V.isOpen.preimage e_K.continuous)).preimage
          ι_U.continuous⟩
    have hQ₀_in_Ω : f_V.base Q₀ ∈ Ω_gen := by
      refine ⟨x₀, ?_, ?_⟩
      · change e_K.base x₀ ∈ (V : Set ↥Γ)
        rw [hx₀_z₀]
        exact hz₀_V
      · calc ι_WK.base x₀
            = (e_K ≫ p₁).base x₀ := by rw [he_p₁]
          _ = p₁.base z₀ := by change p₁.base (e_K.base x₀) = _; rw [hx₀_z₀]
          _ = (hAffV.fromSpec ≫ p₁).base Q₀ := by
                change p₁.base z₀ = p₁.base (hAffV.fromSpec.base Q₀); rw [hQ₀_z]
          _ = (f_V ≫ ι_U).base Q₀ := by rw [← hfV_fac]
          _ = ι_U.base (f_V.base Q₀) := rfl

    obtain ⟨_, ⟨f₀, rfl⟩, hf₀_Q₀, hf₀_sub⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens hQ₀_in_Ω
    have hψf₀_not_Q₀ : ψ f₀ ∉ Q₀.asIdeal := by
      have hf₀_not : f₀ ∉ (f_V.base Q₀).asIdeal := hf₀_Q₀
      rw [← hSpec_ψ] at hf₀_not
      exact hf₀_not
    have hψf₀_ne : ψ f₀ ≠ 0 :=
      fun h0 => hψf₀_not_Q₀ (by rw [h0]; exact Q₀.asIdeal.zero_mem)

    let R_f₀ := Localization.Away f₀
    let B_f₀ := Localization.Away (ψ f₀)
    let ψ_f₀ : R_f₀ →+* B_f₀ := IsLocalization.Away.map R_f₀ B_f₀ ψ f₀
    let α_R : AlgebraicGeometry.Spec (CommRingCat.of R_f₀) ⟶ AlgebraicGeometry.Spec R₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑R₀) R_f₀))
    let α_B : AlgebraicGeometry.Spec (CommRingCat.of B_f₀) ⟶ AlgebraicGeometry.Spec B :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑B) B_f₀))
    let g_loc : AlgebraicGeometry.Spec (CommRingCat.of B_f₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_f₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_f₀)

    have : AlgebraicGeometry.IsOpenImmersion α_R :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization f₀
    have : AlgebraicGeometry.IsOpenImmersion α_B :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (ψ f₀)

    have hg_loc_comm : g_loc ≫ α_R = α_B ≫ f_V := by
      rw [← hSpec_ψ]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_f₀) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑R₀) R_f₀)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑B) B_f₀)) ≫
          AlgebraicGeometry.Spec.map ψ_c
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext r
      change ψ_f₀ (algebraMap (↑R₀) R_f₀ r) = algebraMap (↑B) B_f₀ (ψ r)
      exact IsLocalization.map_eq _ r

    let j_R : AlgebraicGeometry.Spec (CommRingCat.of R_f₀) ⟶ W := α_R ≫ ι_U
    let j_B : AlgebraicGeometry.Spec (CommRingCat.of B_f₀) ⟶ Γ := α_B ≫ hAffV.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion j_R := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion j_B := inferInstance

    have hRange_αR : Set.range α_R.base =
        (PrimeSpectrum.basicOpen f₀ : Set (PrimeSpectrum ↑R₀)) :=
      PrimeSpectrum.localization_away_comap_range R_f₀ f₀
    have hRange_αB : Set.range α_B.base =
        (PrimeSpectrum.basicOpen (ψ f₀) : Set (PrimeSpectrum ↑B)) :=
      PrimeSpectrum.localization_away_comap_range B_f₀ (ψ f₀)

    have hjR_sub : Set.range j_R.base ⊆ Set.range ι_WK.base := by
      rintro w' ⟨x', rfl⟩
      have hx'_basic : α_R.base x' ∈
          (PrimeSpectrum.basicOpen f₀ : Set (PrimeSpectrum ↑R₀)) := by
        rw [← hRange_αR]
        exact ⟨x', rfl⟩
      obtain ⟨x_k, _, hx_k_eq⟩ := hf₀_sub hx'_basic
      exact ⟨x_k, hx_k_eq⟩

    let j_R_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_f₀) ⟶ W_K :=
      AlgebraicGeometry.IsOpenImmersion.lift ι_WK j_R hjR_sub
    have hjR_fac : j_R_tilde ≫ ι_WK = j_R :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_WK j_R hjR_sub
    have : AlgebraicGeometry.IsOpenImmersion (j_R_tilde ≫ ι_WK) := by
      rw [hjR_fac]
      infer_instance
    have : AlgebraicGeometry.IsOpenImmersion j_R_tilde :=
      AlgebraicGeometry.IsOpenImmersion.of_comp j_R_tilde ι_WK
    have : AlgebraicGeometry.IsOpenImmersion (j_R_tilde ≫ e_K) := inferInstance

    have hRangeEq : Set.range j_B.base = Set.range (j_R_tilde ≫ e_K).base := by
      ext z
      constructor
      · rintro ⟨y', rfl⟩
        have hQ'_basic : α_B.base y' ∈
            (PrimeSpectrum.basicOpen (ψ f₀) : Set (PrimeSpectrum ↑B)) := by
          rw [← hRange_αB]
          exact ⟨y', rfl⟩
        have hfQ'_basic : f_V.base (α_B.base y') ∈
            (PrimeSpectrum.basicOpen f₀ : Set (PrimeSpectrum ↑R₀)) := by
          rw [← hSpec_ψ]
          exact hQ'_basic
        rw [← hRange_αR] at hfQ'_basic
        obtain ⟨x', hx'⟩ := hfQ'_basic
        have hp₁_z : p₁.base (j_B.base y') = ι_WK.base (j_R_tilde.base x') := by
          calc p₁.base (j_B.base y')
              = (α_B ≫ hAffV.fromSpec ≫ p₁).base y' := rfl
            _ = (α_B ≫ f_V ≫ ι_U).base y' := by rw [← hfV_fac]
            _ = ι_U.base (f_V.base (α_B.base y')) := rfl
            _ = j_R.base x' := by rw [← hx']; rfl
            _ = (j_R_tilde ≫ ι_WK).base x' := by rw [← hjR_fac]
            _ = ι_WK.base (j_R_tilde.base x') := rfl
        have hz_mem_eK : j_B.base y' ∈ Set.range e_K.base := by
          rw [hRange_eK]
          exact ⟨j_R_tilde.base x', hp₁_z.symm⟩
        obtain ⟨x'', hx''⟩ := hz_mem_eK
        have hx''_eq : x'' = j_R_tilde.base x' := by
          apply ι_WK.isOpenEmbedding.injective
          calc ι_WK.base x''
              = (e_K ≫ p₁).base x'' := by rw [he_p₁]
            _ = p₁.base (j_B.base y') := by change p₁.base (e_K.base x'') = _; rw [hx'']
            _ = ι_WK.base (j_R_tilde.base x') := hp₁_z
        exact ⟨x', by rw [← hx'', hx''_eq]; rfl⟩
      · rintro ⟨x', rfl⟩
        have hx'_basic : α_R.base x' ∈
            (PrimeSpectrum.basicOpen f₀ : Set (PrimeSpectrum ↑R₀)) := by
          rw [← hRange_αR]
          exact ⟨x', rfl⟩
        obtain ⟨x'', hx''_V, hx''_eq⟩ := hf₀_sub hx'_basic
        have hj_eq : j_R_tilde.base x' = x'' := by
          apply ι_WK.isOpenEmbedding.injective
          calc ι_WK.base (j_R_tilde.base x')
              = (j_R_tilde ≫ ι_WK).base x' := rfl
            _ = j_R.base x' := by rw [hjR_fac]
            _ = ι_WK.base x'' := hx''_eq.symm
        have hz_V : (j_R_tilde ≫ e_K).base x' ∈ (V : Set ↥Γ) := by
          change e_K.base (j_R_tilde.base x') ∈ (V : Set ↥Γ)
          rw [hj_eq]
          exact hx''_V
        obtain ⟨Q', hQ'⟩ := show (j_R_tilde ≫ e_K).base x' ∈ Set.range hAffV.fromSpec.base by
          rw [hAffV.range_fromSpec]; exact hz_V
        have hfQ' : f_V.base Q' = α_R.base x' := by
          apply ι_U.isOpenEmbedding.injective
          calc (f_V ≫ ι_U).base Q'
              = (hAffV.fromSpec ≫ p₁).base Q' := by rw [hfV_fac]
            _ = p₁.base ((j_R_tilde ≫ e_K).base x') := by
                  change p₁.base (hAffV.fromSpec.base Q') = _; rw [hQ']
            _ = (j_R_tilde ≫ e_K ≫ p₁).base x' := rfl
            _ = (j_R_tilde ≫ ι_WK).base x' := by rw [he_p₁]
            _ = j_R.base x' := by rw [hjR_fac]
            _ = ι_U.base (α_R.base x') := rfl
        have hQ'_basic : Q' ∈ (PrimeSpectrum.basicOpen (ψ f₀) : Set (PrimeSpectrum ↑B)) := by
          have hf_mem : f_V.base Q' ∈
              (PrimeSpectrum.basicOpen f₀ : Set (PrimeSpectrum ↑R₀)) := by
            rw [hfQ']
            exact hx'_basic
          rw [← hSpec_ψ] at hf_mem
          exact hf_mem
        rw [← hRange_αB] at hQ'_basic
        obtain ⟨y', hy'⟩ := hQ'_basic
        exact ⟨y', by
          change hAffV.fromSpec.base (α_B.base y') = (j_R_tilde ≫ e_K).base x'
          rw [hy', hQ']⟩

    let e_iso := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq j_B (j_R_tilde ≫ e_K) hRangeEq
    have h_gloc_eq : g_loc = e_iso.hom := by
      have : CategoryTheory.Mono j_R := AlgebraicGeometry.IsOpenImmersion.mono j_R
      rw [← CategoryTheory.cancel_mono j_R]
      calc g_loc ≫ j_R
          = (g_loc ≫ α_R) ≫ ι_U := by rw [CategoryTheory.Category.assoc]
        _ = α_B ≫ (f_V ≫ ι_U) := by rw [hg_loc_comm, CategoryTheory.Category.assoc]
        _ = j_B ≫ p₁ := by rw [hfV_fac, CategoryTheory.Category.assoc]
        _ = (e_iso.hom ≫ j_R_tilde ≫ e_K) ≫ p₁ := by
              rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
        _ = e_iso.hom ≫ j_R_tilde ≫ (e_K ≫ p₁) := by simp [CategoryTheory.Category.assoc]
        _ = e_iso.hom ≫ j_R := by rw [he_p₁, hjR_fac]

    have : CategoryTheory.IsIso g_loc := by
      rw [h_gloc_eq]
      infer_instance
    let ψ_f₀_inv := AlgebraicGeometry.Spec.preimage (CategoryTheory.inv g_loc)
    have h_inv_comp : ψ_f₀_inv ≫ CommRingCat.ofHom ψ_f₀ = 𝟙 (CommRingCat.of B_f₀) :=
      AlgebraicGeometry.Spec.map_injective <| by
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          show AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_f₀) = g_loc from rfl,
          CategoryTheory.IsIso.hom_inv_id, AlgebraicGeometry.Spec.map_id]

    have hinj_Bf₀ : Function.Injective (algebraMap (↑B) B_f₀) :=
      IsLocalization.injective B_f₀
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hψf₀_ne))

    have hbirat : ∀ b_el : ↑B, ∃ d : ↑R₀, ψ d ≠ 0 ∧ ∃ a_el : ↑R₀, ψ d * b_el = ψ a_el := by
      intro b_el
      let w₀ : R_f₀ := ψ_f₀_inv.hom (algebraMap (↑B) B_f₀ b_el)
      have hw₀_map : ψ_f₀ w₀ = algebraMap (↑B) B_f₀ b_el := by
        change (ψ_f₀_inv ≫ CommRingCat.ofHom ψ_f₀).hom (algebraMap (↑B) B_f₀ b_el) = _
        rw [h_inv_comp]
        rfl
      let a_el : ↑R₀ := (IsLocalization.Away.sec f₀ w₀).1
      let k : ℕ := (IsLocalization.Away.sec f₀ w₀).2
      have hsec := IsLocalization.Away.sec_spec f₀ w₀
      refine ⟨f₀ ^ k, by rw [map_pow]; exact pow_ne_zero k hψf₀_ne, a_el, ?_⟩
      apply hinj_Bf₀
      calc algebraMap (↑B) B_f₀ (ψ (f₀ ^ k) * b_el)
          = ψ_f₀ w₀ * ψ_f₀ (algebraMap (↑R₀) R_f₀ (f₀ ^ k)) := by
              rw [map_mul, hw₀_map, show algebraMap (↑B) B_f₀ (ψ (f₀ ^ k)) =
                ψ_f₀ (algebraMap (↑R₀) R_f₀ (f₀ ^ k)) from (IsLocalization.map_eq _ _).symm]
              ring
        _ = ψ_f₀ (w₀ * algebraMap (↑R₀) R_f₀ (f₀ ^ k)) := by rw [← map_mul]
        _ = ψ_f₀ (algebraMap (↑R₀) R_f₀ a_el) := by rw [hsec]
        _ = algebraMap (↑B) B_f₀ (ψ a_el) := IsLocalization.map_eq _ a_el

    
    let V_w := Localization.AtPrime p.asIdeal
    have : IsDomain V_w :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p.asIdeal)
    have : ValuationRing V_w := inferInstance
    have hinj_Vw : Function.Injective (algebraMap (↑R₀) V_w) :=
      IsLocalization.injective V_w (Ideal.primeCompl_le_nonZeroDivisors p.asIdeal)

    have hQ_eq : Q₁ = Q₂ := by
      apply PrimeSpectrum.ext
      ext b_el
      obtain ⟨d, hψd_ne, a_el, hdb⟩ := hbirat b_el
      rcases ValuationRing.dvd_total
          (algebraMap (↑R₀) V_w d) (algebraMap (↑R₀) V_w a_el) with ⟨z, hz⟩ | ⟨z, hz⟩
      · obtain ⟨⟨r, s⟩, hzs⟩ := IsLocalization.surj p.asIdeal.primeCompl z
        have hsa_dr : (s : ↑R₀) * a_el = d * r := by
          apply hinj_Vw
          calc algebraMap (↑R₀) V_w ((s : ↑R₀) * a_el)
              = algebraMap (↑R₀) V_w (s : ↑R₀) * (algebraMap (↑R₀) V_w d * z) := by
                  rw [map_mul, hz]
            _ = algebraMap (↑R₀) V_w d * (z * algebraMap (↑R₀) V_w (s : ↑R₀)) := by ring
            _ = algebraMap (↑R₀) V_w (d * r) := by rw [hzs, map_mul]
        have hψs_b : ψ (s : ↑R₀) * b_el = ψ r := by
          apply mul_left_cancel₀ hψd_ne
          calc ψ d * (ψ (s : ↑R₀) * b_el)
              = ψ (s : ↑R₀) * (ψ d * b_el) := by ring
            _ = ψ ((s : ↑R₀) * a_el) := by rw [hdb, map_mul]
            _ = ψ (d * r) := by rw [hsa_dr]
            _ = ψ d * ψ r := by rw [map_mul]
        have h_iff : ∀ (Q : AlgebraicGeometry.Spec B),
            Ideal.comap ψ Q.asIdeal = p.asIdeal → (b_el ∈ Q.asIdeal ↔ r ∈ p.asIdeal) := by
          intro Q hQ_over
          have hψs_not_Q : ψ (s : ↑R₀) ∉ Q.asIdeal :=
            fun h_in => s.2 ((congrArg ((s : ↑R₀) ∈ ·) hQ_over).mp h_in)
          constructor
          · intro hb_Q
            have hψr_Q : ψ r ∈ Q.asIdeal := by
              rw [← hψs_b]
              exact Ideal.mul_mem_left Q.asIdeal _ hb_Q
            exact (congrArg (r ∈ ·) hQ_over).mp hψr_Q
          · intro hr_p
            have hψr_Q : ψ r ∈ Q.asIdeal := (congrArg (r ∈ ·) hQ_over).mpr hr_p
            rw [← hψs_b] at hψr_Q
            exact (Q.isPrime.mem_or_mem hψr_Q).resolve_left hψs_not_Q
        rw [h_iff Q₁ hQ₁_over, h_iff Q₂ hQ₂_over]
      · obtain ⟨⟨r, s⟩, hzs⟩ := IsLocalization.surj p.asIdeal.primeCompl z
        have hsd_ar : (s : ↑R₀) * d = a_el * r := by
          apply hinj_Vw
          calc algebraMap (↑R₀) V_w ((s : ↑R₀) * d)
              = algebraMap (↑R₀) V_w (s : ↑R₀) * (algebraMap (↑R₀) V_w a_el * z) := by
                  rw [map_mul, hz]
            _ = algebraMap (↑R₀) V_w a_el * (z * algebraMap (↑R₀) V_w (s : ↑R₀)) := by ring
            _ = algebraMap (↑R₀) V_w (a_el * r) := by rw [hzs, map_mul]
        have hψr_b : ψ r * b_el = ψ (s : ↑R₀) := by
          apply mul_left_cancel₀ hψd_ne
          calc ψ d * (ψ r * b_el)
              = ψ r * (ψ d * b_el) := by ring
            _ = ψ (a_el * r) := by rw [hdb, ← map_mul, mul_comm]
            _ = ψ ((s : ↑R₀) * d) := by rw [← hsd_ar]
            _ = ψ d * ψ (s : ↑R₀) := by rw [map_mul, mul_comm]
        have h_not : ∀ (Q : AlgebraicGeometry.Spec B),
            Ideal.comap ψ Q.asIdeal = p.asIdeal → b_el ∉ Q.asIdeal := by
          intro Q hQ_over hb_Q
          have hψs_Q : ψ (s : ↑R₀) ∈ Q.asIdeal := by
            rw [← hψr_b]
            exact Ideal.mul_mem_left Q.asIdeal _ hb_Q
          exact s.2 ((congrArg ((s : ↑R₀) ∈ ·) hQ_over).mp hψs_Q)
        exact iff_of_false (h_not Q₁ hQ₁_over) (h_not Q₂ hQ₂_over)

    rw [← hQ₁_z, ← hQ₂_z, hQ_eq]

  
  have hAff_nbhd : ∀ z : ↥O_Γ, ∃ V : Γ.Opens,
      AlgebraicGeometry.IsAffineOpen V ∧ z.1 ∈ V ∧ V ≤ O_Γ := by
    intro z
    obtain ⟨V, hV_aff, hz_V, hV_le⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (AlgebraicGeometry.Scheme.isBasis_affineOpens Γ) z.2
    exact ⟨V, hV_aff, hz_V, hV_le⟩
  choose V_cov hAff_cov hz_cov hle_cov using hAff_nbhd
  obtain ⟨S_fin, hS_cover⟩ := hComp_OΓ.elim_finite_subcover
    (fun z : ↥O_Γ => (V_cov z : Set ↥Γ))
    (fun z => (V_cov z).isOpen)
    (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hz_cov ⟨y, hy⟩⟩)

  change (p₁.base ⁻¹' {w}).Finite
  rw [← hp_w]
  refine Set.Finite.subset
    (S_fin.finite_toSet.biUnion fun z _ =>
      (hSub_aff (V_cov z) (hAff_cov z) (hle_cov z)).finite) ?_
  intro y hy
  have hy_OΓ : y ∈ (O_Γ : Set ↥Γ) := ⟨p, hy.symm⟩
  obtain ⟨z, hz_S, hy_Vz⟩ := Set.mem_iUnion₂.mp (hS_cover hy_OΓ)
  exact Set.mem_iUnion₂.mpr ⟨z, hz_S, hy_Vz, hy⟩

theorem weil_nc2d_graph_fiber_finite_at_closed_point (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W Y Γ : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (ι_Γ : Γ ⟶ CategoryTheory.Limits.pullback g_W g_Y)
    (e_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ⟶ Γ)
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hCenters : HasNonclosedComponentCenters Ω g_W g_Y α_K)
    (hGraph : IsNC2DGraphClosure Ω g_W g_Y α_K ι_Γ e_K)
    (q_W : ↥(CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hqW : IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ((ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y).base ⁻¹'
      {(CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W}).Finite :=
by
  intro s_Ω
  by_contra hInf
  
  have h_part1 : ∃ K_w : Set ↥(CategoryTheory.Limits.pullback g_Y s_Ω),
      IsClosed K_w ∧
      (K_w.Finite →
        ((ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y).base ⁻¹'
          {(CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W}).Finite) ∧
      (∀ q ∈ K_w, ∃ z : ↥Γ,
        (ι_Γ ≫ CategoryTheory.Limits.pullback.fst g_W g_Y).base z =
          (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W ∧
        (ι_Γ ≫ CategoryTheory.Limits.pullback.snd g_W g_Y).base z =
          (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q) := by
    let w := (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W
    obtain ⟨a, b, R₀, p₀, ι_U, z₁, z₂, A', v₀, e_U, u, v, ε,
        hOpen_ιU, hp₀_eq, _hDomR₀, _hp₀_id, _hz₁, _hregR₀, hRes, _⟩ :=
      hW.2.2.2.2.2.2.2.2 q_W hqW
    let φ₀ : PowerSeries Ω →+* R₀ := (AlgebraicGeometry.Spec.preimage (ι_U ≫ g_W)).hom
    have hSpecΩ_bot : ∀ x : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), x.asIdeal = ⊥ := by
      intro x
      rcases Ideal.eq_bot_or_top x.asIdeal with hbot | htop
      · exact hbot
      · exact False.elim (x.isPrime.ne_top htop)
    have hX_p₀ : φ₀ PowerSeries.X ∈ p₀.asIdeal := by
      have h_base : (AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (ι_U ≫ g_W))).base p₀ =
          s_Ω.base ((CategoryTheory.Limits.pullback.snd g_W s_Ω).base q_W) := by
        rw [AlgebraicGeometry.Spec.map_preimage]
        change g_W.base (ι_U.base p₀) = _
        rw [hp₀_eq]
        change (CategoryTheory.Limits.pullback.fst g_W s_Ω ≫ g_W).base q_W =
          (CategoryTheory.Limits.pullback.snd g_W s_Ω ≫ s_Ω).base q_W
        rw [CategoryTheory.Limits.pullback.condition]
      have h_ideal := congrArg PrimeSpectrum.asIdeal h_base
      change Ideal.comap φ₀ p₀.asIdeal =
        Ideal.comap (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)
          ((CategoryTheory.Limits.pullback.snd g_W s_Ω).base q_W).asIdeal at h_ideal
      rw [hSpecΩ_bot] at h_ideal
      change PowerSeries.X ∈ Ideal.comap φ₀ p₀.asIdeal
      rw [h_ideal, Ideal.mem_comap, Ideal.mem_bot]
      exact PowerSeries.constantCoeff_X
    let σ₀ : Ω →+* (R₀ ⧸ p₀.asIdeal) :=
      (Ideal.Quotient.mk p₀.asIdeal).comp (φ₀.comp PowerSeries.C)
    have : Nontrivial (R₀ ⧸ p₀.asIdeal) :=
      Ideal.Quotient.nontrivial_iff.mpr p₀.isPrime.ne_top
    have hσ₀_surj : Function.Surjective σ₀ := by
      intro y
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨c, hc⟩ := hRes r
      refine ⟨c, Ideal.Quotient.eq.mpr ?_⟩
      have hneg : -(r - φ₀ (PowerSeries.C c)) ∈ p₀.asIdeal := p₀.asIdeal.neg_mem hc
      simpa [sub_eq_add_neg, add_comm] using hneg
    let e_Ω : Ω ≃+* (R₀ ⧸ p₀.asIdeal) :=
      RingEquiv.ofBijective σ₀ ⟨σ₀.injective, hσ₀_surj⟩
    let π_w : R₀ →+* Ω := e_Ω.symm.toRingHom.comp (Ideal.Quotient.mk p₀.asIdeal)
    let i_w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_w) ≫ ι_U
    have hi_w_pt : ∀ x : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), i_w.base x = w := by
      intro x
      have h_eq_p₀ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_w)).base x = p₀ := by
        apply PrimeSpectrum.ext
        ext r
        change π_w r ∈ x.asIdeal ↔ r ∈ p₀.asIdeal
        rw [hSpecΩ_bot x, Ideal.mem_bot]
        change e_Ω.symm (Ideal.Quotient.mk p₀.asIdeal r) = 0 ↔ r ∈ p₀.asIdeal
        rw [map_eq_zero_iff e_Ω.symm e_Ω.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
      change ι_U.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_w)).base x) = w
      rw [h_eq_p₀, hp₀_eq]
    have hi_w_gW : i_w ≫ g_W = s_Ω := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_w) ≫ ι_U) ≫ g_W = s_Ω
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_preimage (ι_U ≫ g_W),
        ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext f
      change π_w (φ₀ f) = (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) f
      set c : Ω := (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) f
      have h_dvd : (PowerSeries.X : PowerSeries Ω) ∣ f - PowerSeries.C c := by
        rw [PowerSeries.X_dvd_iff, map_sub, PowerSeries.constantCoeff_C, sub_self]
      obtain ⟨f₁, hf₁⟩ := h_dvd
      have h_mem : φ₀ f - φ₀ (PowerSeries.C c) ∈ p₀.asIdeal := by
        have hmap : φ₀ (f - PowerSeries.C c) = φ₀ PowerSeries.X * φ₀ f₁ := by
          rw [hf₁, map_mul]
        rw [← map_sub, hmap]
        exact Ideal.mul_mem_right _ _ hX_p₀
      have hq_eq : Ideal.Quotient.mk p₀.asIdeal (φ₀ f) = e_Ω c :=
        Ideal.Quotient.eq.mpr h_mem
      change e_Ω.symm (Ideal.Quotient.mk p₀.asIdeal (φ₀ f)) = c
      rw [hq_eq, e_Ω.symm_apply_apply]
    let P := CategoryTheory.Limits.pullback g_W g_Y
    let pr₁ := CategoryTheory.Limits.pullback.fst g_W g_Y
    let pr₂ := CategoryTheory.Limits.pullback.snd g_W g_Y
    let Y₀ := CategoryTheory.Limits.pullback g_Y s_Ω
    let fst_Y₀ := CategoryTheory.Limits.pullback.fst g_Y s_Ω
    let snd_Y₀ := CategoryTheory.Limits.pullback.snd g_Y s_Ω
    let δ_w : Y₀ ⟶ P := CategoryTheory.Limits.pullback.lift (snd_Y₀ ≫ i_w) fst_Y₀ (by
      rw [CategoryTheory.Category.assoc, hi_w_gW, ← CategoryTheory.Limits.pullback.condition])
    have hPb_outer : CategoryTheory.IsPullback (δ_w ≫ pr₂) snd_Y₀ g_Y (i_w ≫ g_W) := by
      have h₀ := CategoryTheory.IsPullback.of_hasPullback g_Y s_Ω
      rwa [CategoryTheory.Limits.pullback.lift_snd, hi_w_gW]
    have hPb_δ : CategoryTheory.IsPullback δ_w snd_Y₀ pr₁ i_w :=
      CategoryTheory.IsPullback.of_right hPb_outer
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback g_W g_Y).flip
    let Γ_w := CategoryTheory.Limits.pullback ι_Γ δ_w
    let f_w := CategoryTheory.Limits.pullback.fst ι_Γ δ_w
    let j_w := CategoryTheory.Limits.pullback.snd ι_Γ δ_w
    have : AlgebraicGeometry.IsClosedImmersion ι_Γ := hGraph.2.1
    have : AlgebraicGeometry.IsClosedImmersion j_w := inferInstance
    refine ⟨Set.range j_w.base, j_w.isClosedEmbedding.isClosed_range, ?_, ?_⟩
    · intro hFinK
      have hUniv_fin : (Set.univ : Set ↥Γ_w).Finite := by
        apply Set.Finite.of_finite_image _ j_w.isClosedEmbedding.injective.injOn
        simpa [Set.image_univ] using hFinK
      have hSub : (ι_Γ ≫ pr₁).base ⁻¹' {w} ⊆ Set.range f_w.base := by
        intro z hz
        let x_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
          (CategoryTheory.Limits.pullback.snd g_W s_Ω).base q_W
        have hz_eq : pr₁.base (ι_Γ.base z) = i_w.base x_Ω := by
          rw [hi_w_pt x_Ω]
          exact hz
        obtain ⟨u₀, hu₀_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (ι_Γ.base z) x_Ω hz_eq
        let q : ↥Y₀ := (hPb_δ.isoPullback.inv).base u₀
        have hq_eq : ι_Γ.base z = δ_w.base q := by
          have hcomp : hPb_δ.isoPullback.inv ≫ δ_w =
              CategoryTheory.Limits.pullback.fst pr₁ i_w :=
            hPb_δ.isoPullback_inv_fst
          have hbase := congrArg (fun h => h.base u₀) hcomp
          exact hu₀_fst.symm.trans hbase.symm
        obtain ⟨u, hu_fst, _⟩ :=
