              = δ_P (E₁ w) := LinearMap.congr_fun hSq₂ w
            _ = δ_P (ρ_P y) := by simp [w]
            _ = 0 := (hExact_P (ρ_P y)).mpr ⟨y, rfl⟩
        obtain ⟨z, hz⟩ := (hExact_lT w).mp hw_ker
        refine ⟨z, ?_⟩
        apply hInj_ρP
        calc ρ_P (μ_lin ⊤ z)
            = E₁ (LinearMap.lTensor ↑B ρ_Y z) := (LinearMap.congr_fun hSq₁ z).symm
          _ = E₁ w := by rw [hz]
          _ = ρ_P y := E₁.apply_symm_apply (ρ_P y)
    let u_top_lin : ↑S →ₗ[↑S] AY ⊤ := @Algebra.linearMap ↑S (AY ⊤) _ _ (instAlgAY ⊤)
    have hAlgTop : instAlgAY ⊤ = u_Y.toAlgebra := by
      apply Algebra.algebra_ext
      intro r
      change (Y.presheaf.map (incY ⊤).op).hom (u_Y r) = u_Y r
      have h_idY : incY ⊤ = 𝟙 ⊤ := Subsingleton.elim _ _
      rw [h_idY, op_id, CategoryTheory.Functor.map_id]
      rfl
    have h_comp_vB : ∀ z : TensorProduct ↑S ↑B ↑S,
        μ_lin ⊤ (LinearMap.lTensor ↑B u_top_lin z) =
          v_B ((TensorProduct.rid ↑S ↑B) z) := by
      intro z
      refine TensorProduct.inductionOn z ?_ ?_
      · intro b r
        change γP ⊤ b * (fst.app ⊤).hom ((Y.presheaf.map (incY ⊤).op).hom (u_Y r)) =
          v_B (r • b)
        have h_idY : incY ⊤ = 𝟙 ⊤ := Subsingleton.elim _ _
        have h_γ_top : γP ⊤ b = v_B b := by
          have h1 : (incP ⊤).op = 𝟙 (Opposite.op (⊤ : P.Opens)) :=
            Opposite.unop_injective (Subsingleton.elim _ _)
          have h_map_P : P.presheaf.map (incP ⊤).op = 𝟙 (P.presheaf.obj (Opposite.op ⊤)) :=
            (congrArg P.presheaf.map h1).trans (CategoryTheory.Functor.map_id P.presheaf _)
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom h_map_P) (v_B b)
        have h_u_top : (Y.presheaf.map (incY ⊤).op).hom (u_Y r) = u_Y r := by
          rw [h_idY, op_id, CategoryTheory.Functor.map_id]; rfl
        have h_fst_top : (fst.app ⊤).hom (u_Y r) = v_B (φ r) := h_top_comm r
        have h_smul : r • b = φ r * b := rfl
        rw [h_γ_top, h_u_top, h_fst_top, h_smul, map_mul]
        exact mul_comm _ _
      · intro x y hx hy
        rw [map_add, map_add, map_add, map_add, hx, hy]
        rfl
    have hBij_rid : Function.Bijective (TensorProduct.rid ↑S ↑B) := (TensorProduct.rid ↑S ↑B).bijective
    have hBij_Γinv : Function.Bijective (AlgebraicGeometry.Scheme.ΓSpecIso B).inv.hom :=
      CategoryTheory.ConcreteCategory.bijective_of_isIso (AlgebraicGeometry.Scheme.ΓSpecIso B).inv
    rw [CategoryTheory.ConcreteCategory.isIso_iff_bijective]
    have h_vB_iff : Function.Bijective v_B ↔ Function.Bijective (snd.app ⊤).hom := by
      have hv : (v_B : ↑B → _) = (snd.app ⊤).hom ∘ (AlgebraicGeometry.Scheme.ΓSpecIso B).inv.hom := rfl
      rw [hv]
      refine ⟨fun h => ⟨?_, ?_⟩, fun h => h.comp hBij_Γinv⟩
      · intro y₁ y₂ hy
        obtain ⟨x₁, rfl⟩ := hBij_Γinv.2 y₁
        obtain ⟨x₂, rfl⟩ := hBij_Γinv.2 y₂
        exact congrArg _ (h.1 hy)
      · intro z
        obtain ⟨x, hx⟩ := h.2 z
        exact ⟨(AlgebraicGeometry.Scheme.ΓSpecIso B).inv.hom x, hx⟩
