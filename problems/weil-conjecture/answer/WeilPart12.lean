    have hψ₁_flat : ψ₁.Flat :=
      ((RingHom.etale_iff_formallyUnramified_and_smooth ψ₁).mp hψ₁_et).2.flat
    have hX_in_map : ψ₁ (φ₁.hom (φ₀ PowerSeries.X)) ∈
        Ideal.map ψ₁ (Ideal.span ({(φ₁.hom z₁) ^ 2} : Set R₁)) := by
      rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton]
      obtain ⟨ℓ₁_inv, hℓ₁_inv⟩ := hℓ₁_unit.exists_right_inv
      have hz1_C1 : ψ₁ (φ₁.hom z₁) = ι_C1 (φ_B1.hom u) * ι_C1 ℓ₁ := by
        have hc : ψ₁ (φ₁.hom z₁) = ι_C1 (φ_B1.hom (φ_e z₁)) :=
          RingHom.congr_fun hψ₁_comp z₁
        rw [hc, hm₁, map_add, map_mul, map_mul, hQuot_B1.1]
        dsimp [ℓ₁]
        simp only [map_add, map_mul]
        ring
      have hu_C1 : ι_C1 (φ_B1.hom u) = ψ₁ (φ₁.hom z₁) * ℓ₁_inv := by
        rw [hz1_C1, mul_assoc, hℓ₁_inv, mul_one]
      have hX_C1 : ψ₁ (φ₁.hom (φ₀ PowerSeries.X)) =
          ι_C1 (φ_B1.hom ε) * (ι_C1 (φ_B1.hom u)) ^ (a + b) * (ι_C1 s_tilde) ^ b := by
        have hc : ψ₁ (φ₁.hom (φ₀ PowerSeries.X)) = ι_C1 (φ_B1.hom (φ_e (φ₀ PowerSeries.X))) :=
          RingHom.congr_fun hψ₁_comp (φ₀ PowerSeries.X)
        rw [hc, hX_eq]
        simp only [map_mul, map_pow, hQuot_B1.1]
        rw [pow_add, mul_pow]
        ring
      refine ⟨ℓ₁_inv ^ 2 * ι_C1 (φ_B1.hom ε) * (ι_C1 (φ_B1.hom u)) ^ k * (ι_C1 s_tilde) ^ b, ?_⟩
      rw [hX_C1, hk, pow_add, hu_C1, map_pow]
      ring
    obtain ⟨y, hy_mem, hy_not_Q⟩ :=
      hFlatColon C₁ ψ₁ hψ₁_flat (Ideal.span ({(φ₁.hom z₁) ^ 2} : Set R₁))
        (φ₁.hom (φ₀ PowerSeries.X)) Q h1_not_Q hX_in_map
    have hy_not_qexc : y ∉ q_exc.asIdeal := by
      intro hy_q
      rw [hq_exc, Ideal.mem_span_singleton] at hy_q
      obtain ⟨r, rfl⟩ := hy_q
      apply hy_not_Q
      rw [Ideal.mem_span_singleton, map_mul]
      have hz1_C1 : ψ₁ (φ₁.hom z₁) = ι_C1 (φ_B1.hom u) * ι_C1 ℓ₁ := by
        have hc : ψ₁ (φ₁.hom z₁) = ι_C1 (φ_B1.hom (φ_e z₁)) :=
          RingHom.congr_fun hψ₁_comp z₁
        rw [hc, hm₁, map_add, map_mul, map_mul, hQuot_B1.1]
        dsimp [ℓ₁]
        simp only [map_add, map_mul]
        ring
      exact ⟨ι_C1 ℓ₁ * ψ₁ r, by rw [hz1_C1]; ring⟩
    exact hNoSq y hy_not_qexc hy_mem

theorem weil_nc2d_global_nc_transfer_and_node_subsingleton (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
