      have h_eq := sub_eq_zero.mp hv_mem
      rw [RingHom.comp_apply, h_eq]
      have h_c : φ_q_hom.hom (φ_Pm (PowerSeries.C (ε_Pm f))) =
          φ_e_hom.hom (φ_R (PowerSeries.C (ε_Pm f))) :=
        (RingHom.congr_fun hφ_comm (PowerSeries.C (ε_Pm f))).symm
      rw [h_c]
      exact hC_εA' (ε_Pm f)
    let σ_A : S_0 ⟶ AlgebraicGeometry.Spec R_A :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_A)
    let σ_A' : S_0 ⟶ AlgebraicGeometry.Spec A' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_A')
    let σ_Pm : S_0 ⟶ AlgebraicGeometry.Spec R_Pm :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_Pm)
    have hCl_sΩ : AlgebraicGeometry.IsClosedImmersion s_Ω :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
        (fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩)
    have hCl_σPm : AlgebraicGeometry.IsClosedImmersion σ_Pm :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom ε_Pm) hSurj_εPm
    have hσ_eU : σ_A' ≫ e_U = σ_A := by
      rw [← he_U_map, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext x
      exact RingHom.congr_fun hεA'_φe x
    have hσ_qm : σ_A' ≫ q_m = σ_Pm := by
      rw [← hq_m_map, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext x
      exact RingHom.congr_fun hεA'_φq x
    have hσ_A_g' : (σ_A ≫ hAffU.fromSpec) ≫ g' = s_Ω := by
      rw [CategoryTheory.Category.assoc, h_fromSpec_g', ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hεA_φR]
    have hσ_Pm_gPm : σ_Pm ≫ g_Pm = s_Ω := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hεPm_φPm]
    let X_ov := CategoryTheory.Limits.pullback π_U e_U
    let fst_U := CategoryTheory.Limits.pullback.fst π_U e_U
    let snd_ov := CategoryTheory.Limits.pullback.snd π_U e_U
    let α_X : X_ov ⟶ C'' := fst_U ≫ ι_tilde
    let β_X : X_ov ⟶ M_m := Φ_A'.hom ≫ CategoryTheory.Limits.pullback.fst p_m q_m
    let g_ov : X_ov ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
      snd_ov ≫ q_m ≫ g_Pm
    have hα_gov : α_X ≫ (π ≫ g') = g_ov := by
      change fst_U ≫ ι_tilde ≫ π ≫ g' = snd_ov ≫ q_m ≫ g_Pm
      rw [← CategoryTheory.Category.assoc ι_tilde π g', hπ_tilde,
        CategoryTheory.Category.assoc π_U hAffU.fromSpec g', h_fromSpec_g',
        ← CategoryTheory.Category.assoc fst_U π_U _, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc snd_ov e_U _, hComm_eq]
    have hβ_gov : β_X ≫ (p_m ≫ g_Pm) = g_ov := by
      change Φ_A'.hom ≫ CategoryTheory.Limits.pullback.fst p_m q_m ≫ p_m ≫ g_Pm =
        snd_ov ≫ q_m ≫ g_Pm
      rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst p_m q_m) p_m g_Pm,
        CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.snd p_m q_m) q_m g_Pm,
        ← CategoryTheory.Category.assoc Φ_A'.hom _ _, hΦ_snd]
    have _ : AlgebraicGeometry.Etale e_U := hEt_e
    have _ : AlgebraicGeometry.Etale q_m := hEt_q
    have _ : AlgebraicGeometry.IsOpenImmersion ι_tilde := hOpen_tilde
    have _ : AlgebraicGeometry.Etale fst_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback π_U e_U).flip hEt_e
    have _ : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst p_m q_m) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback p_m q_m).flip hEt_q
    have hEt_αX : AlgebraicGeometry.Etale α_X := inferInstance
    have hEt_βX : AlgebraicGeometry.Etale β_X := inferInstance
    let Y_ov := CategoryTheory.Limits.pullback g_ov s_Ω
    let fst_ov := CategoryTheory.Limits.pullback.fst g_ov s_Ω
    let snd_ov0 := CategoryTheory.Limits.pullback.snd g_ov s_Ω
    let α_ov0 : Y_ov ⟶ Y'' := CategoryTheory.Limits.pullback.lift (fst_ov ≫ α_X) snd_ov0
      (by rw [CategoryTheory.Category.assoc, hα_gov]; exact CategoryTheory.Limits.pullback.condition)
    let β_ov0 : Y_ov ⟶ Y_m := CategoryTheory.Limits.pullback.lift (fst_ov ≫ β_X) snd_ov0
      (by rw [CategoryTheory.Category.assoc, hβ_gov]; exact CategoryTheory.Limits.pullback.condition)
    have hPb_α0 : CategoryTheory.IsPullback α_ov0 fst_ov fst'' α_X := by
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback (π ≫ g') s_Ω).flip
      rw [CategoryTheory.Limits.pullback.lift_snd]
      change CategoryTheory.IsPullback snd_ov0 fst_ov s_Ω (α_X ≫ (π ≫ g'))
      rw [hα_gov]
      exact (CategoryTheory.IsPullback.of_hasPullback g_ov s_Ω).flip
    have hPb_β0 : CategoryTheory.IsPullback β_ov0 fst_ov fst_m β_X := by
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback (p_m ≫ g_Pm) s_Ω).flip
      rw [CategoryTheory.Limits.pullback.lift_snd]
      change CategoryTheory.IsPullback snd_ov0 fst_ov s_Ω (β_X ≫ (p_m ≫ g_Pm))
      rw [hβ_gov]
      exact (CategoryTheory.IsPullback.of_hasPullback g_ov s_Ω).flip
    have _ : AlgebraicGeometry.Etale α_ov0 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_α0.flip hEt_αX
    have _ : AlgebraicGeometry.Etale β_ov0 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_β0.flip hEt_βX
    have _ : AlgebraicGeometry.UniversallyOpen α_ov0 :=
      AlgebraicGeometry.UniversallyOpen.of_flat α_ov0
    have _ : AlgebraicGeometry.UniversallyOpen β_ov0 :=
      AlgebraicGeometry.UniversallyOpen.of_flat β_ov0
    have hFib_ov : α_ov0.base ⁻¹' F'' = β_ov0.base ⁻¹' F_m := by
      ext w
      have hα_eq : π.base (fst''.base (α_ov0.base w)) =
          hAffU.fromSpec.base (e_U.base (snd_ov.base (fst_ov.base w))) := by
        have h_mor : α_ov0 ≫ fst'' ≫ π = fst_ov ≫ snd_ov ≫ e_U ≫ hAffU.fromSpec := by
          rw [← CategoryTheory.Category.assoc α_ov0 fst'' π,
            CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc fst_ov α_X π]
          congr 1
          change fst_U ≫ ι_tilde ≫ π = snd_ov ≫ e_U ≫ hAffU.fromSpec
          rw [hπ_tilde, ← CategoryTheory.Category.assoc fst_U π_U _,
            CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
        exact congrArg (fun f => f.base w) h_mor
      have hβ_eq : p_m.base (fst_m.base (β_ov0.base w)) =
          q_m.base (snd_ov.base (fst_ov.base w)) := by
        have h_mor : β_ov0 ≫ fst_m ≫ p_m = fst_ov ≫ snd_ov ≫ q_m := by
          rw [← CategoryTheory.Category.assoc β_ov0 fst_m p_m,
            CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc fst_ov β_X p_m]
          congr 1
          change Φ_A'.hom ≫ CategoryTheory.Limits.pullback.fst p_m q_m ≫ p_m = snd_ov ≫ q_m
          rw [CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc, hΦ_snd]
        exact congrArg (fun f => f.base w) h_mor
      have h_lhs : α_ov0.base w ∈ F'' ↔ snd_ov.base (fst_ov.base w) = v'₀ := by
        change π.base (fst''.base (α_ov0.base w)) = x₀ ↔ _
        rw [hα_eq]
        refine ⟨fun h => hUniq_e _ (hAffU.fromSpec.isOpenEmbedding.injective (h.trans hp_x₀.symm)),
          fun h => ?_⟩
        rw [h, hev'₀, hp_x₀]
      have h_rhs : β_ov0.base w ∈ F_m ↔ snd_ov.base (fst_ov.base w) = v'₀ := by
        change p_m.base (fst_m.base (β_ov0.base w)) ∈ PrimeSpectrum.zeroLocus (I_nod : Set ↑R_Pm) ↔ _
        rw [hβ_eq]
        refine ⟨hUniq_q _, fun h r hr => ?_⟩
        rw [h, hqv'₀]
        exact hr
      exact h_lhs.trans h_rhs.symm
    have hCl_ov : α_ov0.base ⁻¹' closure (F''ᶜ) = β_ov0.base ⁻¹' closure (F_mᶜ) := by
      have h_compl : α_ov0.base ⁻¹' (F''ᶜ) = β_ov0.base ⁻¹' (F_mᶜ) :=
        congrArg Compl.compl hFib_ov
      rw [α_ov0.isOpenMap.preimage_closure_eq_closure_preimage α_ov0.continuous,
        β_ov0.isOpenMap.preimage_closure_eq_closure_preimage β_ov0.continuous, h_compl]
    let F_sch := CategoryTheory.Limits.pullback snd_ov σ_A'
    let fst_F := CategoryTheory.Limits.pullback.fst snd_ov σ_A'
    let snd_F := CategoryTheory.Limits.pullback.snd snd_ov σ_A'
    have hF_gov : fst_F ≫ g_ov = snd_F ≫ s_Ω := by
      change fst_F ≫ snd_ov ≫ q_m ≫ g_Pm = snd_F ≫ s_Ω
      rw [← CategoryTheory.Category.assoc fst_F snd_ov _,
        CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc snd_F σ_A' _,
        ← CategoryTheory.Category.assoc σ_A' q_m g_Pm, hσ_qm, hσ_Pm_gPm]
    let j_ov : F_sch ⟶ Y_ov := CategoryTheory.Limits.pullback.lift fst_F snd_F hF_gov
    let j'' : F_sch ⟶ Y'' := j_ov ≫ α_ov0
    let j_m : F_sch ⟶ Y_m := j_ov ≫ β_ov0
    have hj_snd : j'' ≫ snd'' = j_m ≫ snd_m := by
      have h1 : j'' ≫ snd'' = snd_F := by
        change j_ov ≫ α_ov0 ≫ snd'' = snd_F
        rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
      have h2 : j_m ≫ snd_m = snd_F := by
        change j_ov ≫ β_ov0 ≫ snd_m = snd_F
        rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
      exact h1.trans h2.symm
    have hCl_equiv : ∀ u : ↥F_sch, j''.base u ∈ closure (F''ᶜ) ↔ j_m.base u ∈ closure (F_mᶜ) := by
      intro u
      change j_ov.base u ∈ α_ov0.base ⁻¹' closure (F''ᶜ) ↔
        j_ov.base u ∈ β_ov0.base ⁻¹' closure (F_mᶜ)
      rw [hCl_ov]
    have hjm_fst : j_m ≫ fst_m = fst_F ≫ β_X := by
      change j_ov ≫ β_ov0 ≫ fst_m = fst_F ≫ β_X
      rw [CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst]
    have hj''_fst : j'' ≫ fst'' = fst_F ≫ α_X := by
      change j_ov ≫ α_ov0 ≫ fst'' = fst_F ≫ α_X
      rw [CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst]
    have hPb_Φ : CategoryTheory.IsPullback Φ_A'.hom snd_ov
        (CategoryTheory.Limits.pullback.snd p_m q_m) (𝟙 (AlgebraicGeometry.Spec A')) := by
      apply CategoryTheory.IsPullback.of_horiz_isIso
      exact ⟨by rw [CategoryTheory.Category.comp_id, hΦ_snd]⟩
    have hPb_βX : CategoryTheory.IsPullback β_X snd_ov p_m q_m := by
      have h := CategoryTheory.IsPullback.paste_horiz hPb_Φ
        (CategoryTheory.IsPullback.of_hasPullback p_m q_m)
      simpa only [CategoryTheory.Category.id_comp] using h
    have hPb_Fm : CategoryTheory.IsPullback (fst_F ≫ β_X) snd_F p_m σ_Pm := by
      have h := CategoryTheory.IsPullback.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback snd_ov σ_A') hPb_βX
      rwa [hσ_qm] at h
    have _ : AlgebraicGeometry.IsClosedImmersion fst_m :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (p_m ≫ g_Pm) s_Ω).flip hCl_sΩ
    have _ : AlgebraicGeometry.IsClosedImmersion (j_m ≫ fst_m) := by
      rw [hjm_fst]
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_Fm.flip hCl_σPm
    have hCl_jm : AlgebraicGeometry.IsClosedImmersion j_m :=
      AlgebraicGeometry.IsClosedImmersion.of_comp j_m fst_m
    have hPb_open : CategoryTheory.IsPullback π_U ι_tilde hAffU.fromSpec π := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback π_U ι_tilde hAffU.fromSpec π hπ_tilde
      ext z
      rw [hAffU.opensRange_fromSpec]
      change z ∈ π.base ⁻¹' (U : Set C') ↔ z ∈ Set.range ι_tilde.base
      rw [hPre_U]
    have hPb_αX : CategoryTheory.IsPullback α_X snd_ov π (e_U ≫ hAffU.fromSpec) :=
      CategoryTheory.IsPullback.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback π_U e_U) hPb_open.flip
    have hPb_F'' : CategoryTheory.IsPullback (fst_F ≫ α_X) snd_F π (σ_A ≫ hAffU.fromSpec) := by
      have h := CategoryTheory.IsPullback.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback snd_ov σ_A') hPb_αX
      rwa [← CategoryTheory.Category.assoc σ_A' e_U hAffU.fromSpec, hσ_eU] at h
    have _ : AlgebraicGeometry.IsProper g' := hProp'
    have _ : AlgebraicGeometry.IsClosedImmersion ((σ_A ≫ hAffU.fromSpec) ≫ g') := by
      rw [hσ_A_g']
      exact hCl_sΩ
    have hCl_σA_U : AlgebraicGeometry.IsClosedImmersion (σ_A ≫ hAffU.fromSpec) :=
      AlgebraicGeometry.IsClosedImmersion.of_comp (σ_A ≫ hAffU.fromSpec) g'
    have _ : AlgebraicGeometry.IsClosedImmersion fst'' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (π ≫ g') s_Ω).flip hCl_sΩ
    have _ : AlgebraicGeometry.IsClosedImmersion (j'' ≫ fst'') := by
      rw [hj''_fst]
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_F''.flip hCl_σA_U
    have hCl_j'' : AlgebraicGeometry.IsClosedImmersion j'' :=
      AlgebraicGeometry.IsClosedImmersion.of_comp j'' fst''
    let pt_Ω : PrimeSpectrum Ω := ⟨⊥, inferInstance⟩
    have hUniq_S0 : ∀ p : ↥S_0, p = pt_Ω := by
      intro p
      apply PrimeSpectrum.ext
      ext c
      simp only [pt_Ω, Ideal.mem_bot]
      refine ⟨fun hc => ?_, fun h0 => h0 ▸ p.asIdeal.zero_mem⟩
      by_contra hc_ne
      exact p.isPrime.ne_top (p.asIdeal.eq_top_of_isUnit_mem hc (IsUnit.mk0 c hc_ne))
    have hσPm_pt : (σ_Pm.base pt_Ω).asIdeal = I_nod := by
      change Ideal.comap ε_Pm ⊥ = I_nod
      rw [← RingHom.ker_eq_comap_bot, hKer_εPm]
    have hσA_pt : σ_A.base pt_Ω = p_x₀ := by
      apply PrimeSpectrum.ext
      change Ideal.comap ε_A ⊥ = p_x₀.asIdeal
      rw [← RingHom.ker_eq_comap_bot, hKer_εA]
    have hRange_jm : Set.range j_m.base = F_m := by
      ext q
      constructor
      · rintro ⟨u, rfl⟩
        change p_m.base (fst_m.base (j_m.base u)) ∈ PrimeSpectrum.zeroLocus (I_nod : Set ↑R_Pm)
        have h_eq : p_m.base (fst_m.base (j_m.base u)) = σ_Pm.base (snd_F.base u) := by
          change ((j_m ≫ fst_m) ≫ p_m).base u = (snd_F ≫ σ_Pm).base u
          rw [hjm_fst, hPb_Fm.w]
        rw [h_eq, hUniq_S0 (snd_F.base u)]
        intro r hr
        rw [hσPm_pt]
        exact hr
      · intro hq
        have hq_sub : I_nod ≤ (p_m.base (fst_m.base q)).asIdeal := fun r hr => hq hr
        have h_id_eq : (p_m.base (fst_m.base q)).asIdeal = I_nod :=
          (‹I_nod.IsMaximal›.eq_of_le (p_m.base (fst_m.base q)).isPrime.ne_top hq_sub).symm
        have h_pt_eq : p_m.base (fst_m.base q) = σ_Pm.base (snd_m.base q) := by
          rw [hUniq_S0 (snd_m.base q)]
          exact PrimeSpectrum.ext (h_id_eq.trans hσPm_pt.symm)
        obtain ⟨z, hz_fst, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := p_m) (g := σ_Pm) (fst_m.base q) (snd_m.base q) h_pt_eq
        let u : ↥F_sch := hPb_Fm.isoPullback.inv.base z
        refine ⟨u, fst_m.isClosedEmbedding.injective ?_⟩
        change (j_m ≫ fst_m).base u = fst_m.base q
        rw [hjm_fst]
        change (hPb_Fm.isoPullback.inv ≫ (fst_F ≫ β_X)).base z = fst_m.base q
        rw [CategoryTheory.IsPullback.isoPullback_inv_fst]
        exact hz_fst
    have hRange_j'' : Set.range j''.base = F'' := by
      ext q
      constructor
      · rintro ⟨u, rfl⟩
        change π.base (fst''.base (j''.base u)) = x₀
        have h_eq : π.base (fst''.base (j''.base u)) =
            (σ_A ≫ hAffU.fromSpec).base (snd_F.base u) := by
          change ((j'' ≫ fst'') ≫ π).base u = (snd_F ≫ (σ_A ≫ hAffU.fromSpec)).base u
          rw [hj''_fst, hPb_F''.w]
        rw [h_eq, hUniq_S0 (snd_F.base u)]
        change hAffU.fromSpec.base (σ_A.base pt_Ω) = x₀
        rw [hσA_pt, hp_x₀]
      · intro hq
        change π.base (fst''.base q) = x₀ at hq
        have h_pt_eq : π.base (fst''.base q) = (σ_A ≫ hAffU.fromSpec).base (snd''.base q) := by
          rw [hUniq_S0 (snd''.base q), hq]
          change x₀ = hAffU.fromSpec.base (σ_A.base pt_Ω)
          rw [hσA_pt, hp_x₀]
        obtain ⟨z, hz_fst, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := π) (g := σ_A ≫ hAffU.fromSpec) (fst''.base q) (snd''.base q) h_pt_eq
        let u : ↥F_sch := hPb_F''.isoPullback.inv.base z
        refine ⟨u, fst''.isClosedEmbedding.injective ?_⟩
        change (j'' ≫ fst'').base u = fst''.base q
        rw [hj''_fst]
        change (hPb_F''.isoPullback.inv ≫ (fst_F ≫ α_X)).base z = fst''.base q
        rw [CategoryTheory.IsPullback.isoPullback_inv_fst]
        exact hz_fst
    have hLift_F : ∀ (E : AlgebraicGeometry.Scheme.{u}) (ι : E ⟶ Y_m),
        AlgebraicGeometry.IsReduced E → Set.range ι.base ⊆ F_m →
        ∃ κ : E ⟶ F_sch, κ ≫ j_m = ι := by
      intro E ι hRedE hRange_E
      have _ : AlgebraicGeometry.IsReduced E := hRedE
      let u₁ : E ⟶ AlgebraicGeometry.Spec R_Pm := (ι ≫ fst_m) ≫ p_m
      let φ₁ : R_Pm ⟶ E.presheaf.obj (Opposite.op ⊤) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso R_Pm).inv ≫ u₁.appTop
      have hu₁_fac : E.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ₁ = u₁ := by
        dsimp only [φ₁]
        rw [AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Scheme.toSpecΓ_naturality_assoc u₁,
          ← AlgebraicGeometry.SpecMap_ΓSpecIso_hom R_Pm,
          ← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
          AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
      have hInod_ker : I_nod ≤ RingHom.ker φ₁.hom := by
        intro r hr
        rw [RingHom.mem_ker]
        rw [← AlgebraicGeometry.basicOpen_eq_bot_iff (X := E) (U := ⊤)]
        have h_bo : E.basicOpen (φ₁.hom r) =
            (TopologicalSpace.Opens.map u₁.base).obj (PrimeSpectrum.basicOpen r) := by
          change E.basicOpen (u₁.appTop.hom ((AlgebraicGeometry.Scheme.ΓSpecIso R_Pm).inv.hom r)) = _
          rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen_top,
            AlgebraicGeometry.basicOpen_eq_of_affine]
        rw [h_bo]
        ext x
        change r ∉ (u₁.base x).asIdeal ↔ False
        simp only [iff_false, not_not]
        have hx_Fm : ι.base x ∈ F_m := hRange_E ⟨x, rfl⟩
        exact hx_Fm hr
      let ψ_E : Ω →+* ↑(E.presheaf.obj (Opposite.op ⊤)) :=
        (Ideal.Quotient.lift I_nod φ₁.hom hInod_ker).comp e_Pm.toRingHom
      have hψ_comp : CommRingCat.ofHom ε_Pm ≫ CommRingCat.ofHom ψ_E = φ₁ := by
        ext r
        change ψ_E (ε_Pm r) = φ₁.hom r
        rw [hεPm_def]
        change (Ideal.Quotient.lift I_nod φ₁.hom hInod_ker)
          (e_Pm (e_Pm.symm (Ideal.Quotient.mk I_nod r))) = φ₁.hom r
