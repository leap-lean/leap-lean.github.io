      _ = ι_tilde.base '' Set.range ι_U1.base ∪ ι_tilde.base '' Set.range ι_U2.base :=
            Set.image_union _ _ _
      _ = Set.range ι₁.base ∪ Set.range ι₂.base := by
            rw [← Set.range_comp, ← Set.range_comp]; rfl
  have hOv_ι : ι₁.base '' (PrimeSpectrum.basicOpen s₁).1 =
      ι₂.base '' (PrimeSpectrum.basicOpen s₂).1 := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      have hmem : ι_U1.base x ∈ ι_U2.base '' (PrimeSpectrum.basicOpen s₂).1 :=
        hBasic_12 ▸ ⟨x, hx, rfl⟩
      obtain ⟨x', hx', hx_eq⟩ := hmem
      exact ⟨x', hx', congrArg ι_tilde.base hx_eq⟩
    · rintro ⟨x, hx, rfl⟩
      have hmem : ι_U2.base x ∈ ι_U1.base '' (PrimeSpectrum.basicOpen s₁).1 :=
        hBasic_12.symm ▸ ⟨x, hx, rfl⟩
      obtain ⟨x', hx', hx_eq⟩ := hmem
      exact ⟨x', hx', congrArg ι_tilde.base hx_eq⟩
  have hz₁_R0_ne : z₁ ≠ 0 := fun h => hz1_ne (by rw [h, map_zero])
  let p_bot : AlgebraicGeometry.Spec R₀ := ⟨⊥, inferInstance⟩
  have hp_bot_ne : p_bot ≠ p₀ := by
    intro heq
    have hz_in : z₁ ∈ p₀.asIdeal := by
      rw [hp₀_span]; exact Ideal.subset_span (by simp)
    have hz_bot : z₁ ∈ (⊥ : Ideal R₀) := by
      change z₁ ∈ p_bot.asIdeal
      rwa [heq]
    exact hz₁_R0_ne (Ideal.mem_bot.mp hz_bot)
  have h_bot_w0 : ι₀.base p_bot ≠ w₀ := by
    rw [← hp₀_w₀']
    exact fun h => hp_bot_ne (ι₀.isOpenEmbedding.injective h)
  obtain ⟨u_bot, hu_bot⟩ := hSurj_U.surj p_bot
  have hInter_ne : (Set.range ι_tilde.base ∩ Set.range ι_compl.base).Nonempty := by
    refine ⟨ι_tilde.base u_bot, ⟨u_bot, rfl⟩, ?_⟩
    rw [← hPre_compl]
    change (ι_tilde ≫ π).base u_bot ≠ w₀
    rw [h_tilde_π]
    change ι₀.base (π_U.base u_bot) ≠ w₀
    rw [hu_bot]
    exact h_bot_w0
  have hFlat_U_g : AlgebraicGeometry.Flat (ι_tilde ≫ π ≫ g_W) := by
    rw [← Category.assoc, h_tilde_π, Category.assoc]
    exact hFlat_Ug
  have hLFP_U_g : AlgebraicGeometry.LocallyOfFinitePresentation (ι_tilde ≫ π ≫ g_W) := by
    rw [← Category.assoc, h_tilde_π, Category.assoc]
    exact hLFP_Ug
  obtain ⟨hInt_W', hFlat_W', hProp_W', hLFP_W', hSurj_W', hSm_W', hvK_iso,
      ⟨τ_W', hτ_π, hτ_g, hDisj_W'⟩⟩ :=
    part2_sections W W' U_tilde g_W τ_W w₀ W_compl π ι_tilde ι_compl
      rfl hX_mem_w₀ hInt_W hFlat_W hProp_W hLFP_W hSurj_W hSm_W hSec_W hDisj_W
      hInt_U hFlat_U_g hLFP_U_g hOpen_tilde hOpen_compl hCov_W' hInter_ne
      h_compl_π hPre_compl hProp_π hSurj_π
  have hComm_Φ : (Φ_U ≫ ι_tilde) ≫ g_W' =
      (weilProjectiveSpaceOver Ω 1).hom ≫ s_Ω := by
    have h1 : (Φ_U ≫ ι_tilde) ≫ g_W' = (Φ_U ≫ π_U) ≫ (ι₀ ≫ g_W) := by
      dsimp [g_W']
      rw [Category.assoc, ← Category.assoc ι_tilde, h_tilde_π, Category.assoc, Category.assoc]
    rw [h1, hΦ_πU, Category.assoc]
    congr 1
    dsimp [s_Ω]
    conv_lhs =>
      rw [← AlgebraicGeometry.Spec.map_preimage (ι₀ ≫ g_W), ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    ext f
    exact RingHom.congr_fun hres_const f
  have hPre_w₀ : π.base ⁻¹' {w₀} = Set.range (Φ_U ≫ ι_tilde).base := by
    ext y
    constructor
    · intro hy
      have hy_U0 : y ∈ π.base ⁻¹' (Set.range ι₀.base) := by
        change π.base y ∈ Set.range ι₀.base
        rw [Set.mem_singleton_iff.mp hy, ← hp₀_w₀']
        exact ⟨p₀, rfl⟩
      rw [hPre_U0] at hy_U0
      obtain ⟨u, rfl⟩ := hy_U0
      have hu_p0 : π_U.base u = p₀ := by
        apply ι₀.isOpenEmbedding.injective
        rw [hp₀_w₀']
        change (π_U ≫ ι₀).base u = w₀
        rw [← h_tilde_π]
        exact hy
      have hu_Φ : u ∈ Set.range Φ_U.base := by
        rw [hRange_Φ]; exact hu_p0
      obtain ⟨x, rfl⟩ := hu_Φ
      exact ⟨x, rfl⟩
    · rintro ⟨x, rfl⟩
      have hx_p0 : π_U.base (Φ_U.base x) = p₀ := by
        have : Φ_U.base x ∈ π_U.base ⁻¹' {p₀} := by
          rw [← hRange_Φ]; exact ⟨x, rfl⟩
        exact this
      change (ι_tilde ≫ π).base (Φ_U.base x) = w₀
      rw [h_tilde_π]
      change ι₀.base (π_U.base (Φ_U.base x)) = w₀
      rw [hx_p0, hp₀_w₀']
  have hLFP₁ : AlgebraicGeometry.LocallyOfFinitePresentation (ι₁ ≫ g_W') := by
    have heq : ι₁ ≫ g_W' = ι_U1 ≫ (π_U ≫ (ι₀ ≫ g_W)) := by
      dsimp [ι₁, g_W']
      rw [Category.assoc, ← Category.assoc ι_tilde, h_tilde_π, Category.assoc]
    rw [heq]
    infer_instance
  have hpre_ι₁ : (AlgebraicGeometry.Spec.preimage (ι₁ ≫ g_W')).hom =
      φ₁.hom.comp (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom := by
    have heq : ι₁ ≫ g_W' = AlgebraicGeometry.Spec.map φ₁ ≫ (ι₀ ≫ g_W) := by
      dsimp [g_W']
      rw [← Category.assoc, hι₁_π, Category.assoc]
    rw [heq, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map,
      CommRingCat.hom_comp]
  have hX1_ne' : (AlgebraicGeometry.Spec.preimage (ι₁ ≫ g_W')).hom PowerSeries.X ≠ 0 := by
    rw [hpre_ι₁]; exact hX1_ne
  have hq_exc_not' : ∀ c : Ω,
      s₁ - (AlgebraicGeometry.Spec.preimage (ι₁ ≫ g_W')).hom (PowerSeries.C c) ∉
        q_exc.asIdeal := by
    intro c
    rw [hpre_ι₁]
    exact hq_exc_not c
  have hη_qexc : (Φ_U ≫ ι_tilde).base η_P1 = ι₁.base q_exc := by
    change ι_tilde.base (Φ_U.base η_P1) = ι_tilde.base (ι_U1.base q_exc)
    rw [hΦ_η]
  obtain ⟨E_exc, η_exc, ι_exc, hE_irred, hGen_exc, hCl_exc, hRange_exc, hSnd_exc,
      hPre_exc, hImg_exc, hq_exc_η⟩ :=
    part3_exceptional W W' U_tilde (weilProjectiveSpaceOver Ω 1).left
      (weilProjectiveSpaceOver Ω 1).hom g_W' π w₀ ι_tilde Φ_U η_P1 R₁ ι₁ (φ₁.hom z₁) q_exc
      hw₀_cl hOpen_tilde hInt_P1 hCl_Φ hComm_Φ hPre_w₀ hGen_P1 hOpen₁ hDom₁ hLFP₁
      hX1_ne' hq_exc_id hη_qexc
  refine ⟨W', g_W', τ_W', π, E_exc, η_exc, ι_exc, ι₁, ι₂,
    hInt_W', hFlat_W', hProp_W', hLFP_W', hSurj_W', hSm_W', hτ_g, hDisj_W',
    rfl, hτ_π, hProp_π, hSurj_π, hvK_iso, hIso_off, hApp_all,
    ⟨hw₀_cl, ι_compl, hOpen_compl, h_compl_π, hPre_compl⟩,
    hE_irred, hGen_exc, hCl_exc, hRange_exc, hSnd_exc, hPre_exc, hImg_exc,
    hOpen₀, hOpen₁, hOpen₂, hDom₀, hDom₁, hDom₂, hp₀_w₀, hp₀_span, hres,
    hι₁_π, hι₂_π, hCov_ι, hOv_ι,
    hz1_ne, hrel1, hz2_ne, hrel2, hq_exc_id, hq_exc_η, hq_exc_not'⟩

theorem weil_nc2d_mobius_etale_nc_chart_and_ord_one (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (R₀ R₁ A' : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (v₀ : AlgebraicGeometry.Spec A')
    (g_R₀ : AlgebraicGeometry.Spec R₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (e_U : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec R₀)
    (z₁ z₂ : R₀) (φ₁ : R₀ ⟶ R₁) (s₁ : R₁)
    (u v ε : A') (a b : ℕ)
    (hDom₀ : IsDomain R₀)
    (hLFP₀ : AlgebraicGeometry.LocallyOfFinitePresentation g_R₀)
    (hp₀_span : p₀.asIdeal = Ideal.span ({z₁, z₂} : Set R₀))
    (hz₁_ne : z₁ ≠ 0)
    (hreg₀ : ∀ y : R₀, z₂ * y ∈ Ideal.span ({z₁} : Set R₀) → y ∈ Ideal.span ({z₁} : Set R₀))
    (hres₀ : ∀ r : R₀, ∃ c : Ω,
      r - (AlgebraicGeometry.Spec.preimage g_R₀).hom (PowerSeries.C c) ∈ p₀.asIdeal)
    (hDom₁ : IsDomain R₁)
    (hQuot₁ : IsLinearBlowupQuot z₁ z₂ φ₁ s₁)
    (hEt : AlgebraicGeometry.Etale e_U)
    (hDomA : IsDomain A')
    (he_pre : e_U.base ⁻¹' {p₀} = {v₀})
    (hv₀_span : v₀.asIdeal = Ideal.span ({u, v} : Set A'))
    (hu_ne : u ≠ 0)
    (hregA : ∀ y : A', v * y ∈ Ideal.span ({u} : Set A') → y ∈ Ideal.span ({u} : Set A'))
    (hresA : ∀ r' : A', ∃ c : Ω,
      r' - (AlgebraicGeometry.Spec.preimage e_U).hom
        ((AlgebraicGeometry.Spec.preimage g_R₀).hom (PowerSeries.C c)) ∈ v₀.asIdeal)
    (hε : IsUnit ε)
    (ha_pos : 1 ≤ a)
    (hX_eq : (AlgebraicGeometry.Spec.preimage e_U).hom
      ((AlgebraicGeometry.Spec.preimage g_R₀).hom PowerSeries.X) = ε * u ^ a * v ^ b) :
    let φ₀ : PowerSeries Ω →+* R₀ := (AlgebraicGeometry.Spec.preimage g_R₀).hom
    (∃ m₁₁ m₁₂ m₂₁ m₂₂ : A',
      (AlgebraicGeometry.Spec.preimage e_U).hom z₁ = m₁₁ * u + m₁₂ * v ∧
      (AlgebraicGeometry.Spec.preimage e_U).hom z₂ = m₂₁ * u + m₂₂ * v ∧
      m₁₁ * m₂₂ - m₁₂ * m₂₁ ∉ v₀.asIdeal) ∧
    (∀ (m₁₁ m₁₂ m₂₁ m₂₂ : A'),
      (AlgebraicGeometry.Spec.preimage e_U).hom z₁ = m₁₁ * u + m₁₂ * v →
      (AlgebraicGeometry.Spec.preimage e_U).hom z₂ = m₂₁ * u + m₂₂ * v →
      m₁₁ * m₂₂ - m₁₂ * m₂₁ ∉ v₀.asIdeal →
      ∀ (c₁ : Ω) (P₁ : AlgebraicGeometry.Spec R₁),
        P₁.asIdeal = Ideal.span ({φ₁.hom z₁, s₁ - φ₁.hom (φ₀ (PowerSeries.C c₁))} : Set R₁) →
        (∃ a' b' : ℕ, HasAffineNCChartAt Ω R₁ P₁ (φ₁.hom.comp φ₀) a' b') ∧
        (a = 1 → b = 0 →
          m₂₂ - (AlgebraicGeometry.Spec.preimage e_U).hom (φ₀ (PowerSeries.C c₁)) * m₁₂ ∉ v₀.asIdeal →
          HasAffineNCChartAt Ω R₁ P₁ (φ₁.hom.comp φ₀) 1 0)) ∧
    (∀ q_exc : AlgebraicGeometry.Spec R₁,
      q_exc.asIdeal = Ideal.span ({φ₁.hom z₁} : Set R₁) →
      (∀ c : Ω, s₁ - φ₁.hom (φ₀ (PowerSeries.C c)) ∉ q_exc.asIdeal) →
      (∀ y : R₁, y ∉ q_exc.asIdeal →
        y * φ₁.hom (φ₀ PowerSeries.X) ∉ Ideal.span ({(φ₁.hom z₁) ^ 2} : Set R₁)) →
      a = 1 ∧ b = 0) :=
by
  classical
  have _ := hLFP₀
  have _ : IsDomain R₀ := hDom₀
  have _ : IsDomain R₁ := hDom₁
  have _ : IsDomain A' := hDomA
  intro φ₀
  let φ_e : R₀ →+* A' := (AlgebraicGeometry.Spec.preimage e_U).hom
  let c₀ : Ω →+* R₀ := φ₀.comp PowerSeries.C
  let c_A : Ω →+* A' := φ_e.comp c₀

  
  have he_map : e_U = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_U) :=
    (AlgebraicGeometry.Spec.map_preimage e_U).symm
  have hφ_e_et : φ_e.Etale := by
    have hEt_map : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_U)) := by
      rwa [← he_map]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_map
  have hpre_v₀ : Ideal.comap φ_e v₀.asIdeal = p₀.asIdeal := by
    have hv_mem : v₀ ∈ e_U.base ⁻¹' ({p₀} : Set (AlgebraicGeometry.Spec R₀)) := by
      rw [he_pre]; exact Set.mem_singleton v₀
    have hv₀_p₀ : e_U.base v₀ = p₀ := Set.mem_singleton_iff.mp hv_mem
    conv_rhs => rw [← hv₀_p₀, he_map, AlgebraicGeometry.Spec.map_apply]
    rfl
  have hpre_uniq : ∀ (q : Ideal A'), q.IsPrime → Ideal.comap φ_e q = p₀.asIdeal → q = v₀.asIdeal := by
    intro q hq_prime hq_comap
    let q_pt : AlgebraicGeometry.Spec A' := ⟨q, hq_prime⟩
    have hbase : e_U.base q_pt = p₀ := by
      apply PrimeSpectrum.ext
      rw [he_map, AlgebraicGeometry.Spec.map_apply]
      exact hq_comap
    have hmem : q_pt ∈ e_U.base ⁻¹' ({p₀} : Set (AlgebraicGeometry.Spec R₀)) := hbase
    rw [he_pre, Set.mem_singleton_iff] at hmem
    exact congrArg PrimeSpectrum.asIdeal hmem

  
  have hv_ne : v ≠ 0 := by
    intro hv0
    have h1u : (1 : A') ∈ Ideal.span ({u} : Set A') := by
      apply hregA 1
      rw [hv0, zero_mul]
      exact Ideal.zero_mem _
    have h1v0 : (1 : A') ∈ v₀.asIdeal := by
      rw [hv₀_span]
      exact Ideal.span_mono (by simp) h1u
    exact v₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1v0)
  have hregA_symm : ∀ y : A', u * y ∈ Ideal.span ({v} : Set A') → y ∈ Ideal.span ({v} : Set A') := by
    intro y hy
    rw [Ideal.mem_span_singleton] at hy ⊢
    obtain ⟨x, hx⟩ := hy
    have hvx : v * x ∈ Ideal.span ({u} : Set A') :=
      Ideal.mem_span_singleton.mpr ⟨y, hx.symm⟩
    obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp (hregA x hvx)
    refine ⟨w, ?_⟩
    apply mul_left_cancel₀ hu_ne
    linear_combination hx
  have hMax_p₀ : p₀.asIdeal.IsMaximal := by
    have _ : Nontrivial (R₀ ⧸ p₀.asIdeal) :=
      Ideal.Quotient.nontrivial_iff.mpr p₀.isPrime.ne_top
    let α_res : Ω →+* R₀ ⧸ p₀.asIdeal := (Ideal.Quotient.mk p₀.asIdeal).comp c₀
    have hα_bij : Function.Bijective α_res := by
      refine ⟨α_res.injective, ?_⟩
      intro q
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨c, hc⟩ := hres₀ r
      refine ⟨c, ?_⟩
      dsimp [α_res, c₀]
      rw [eq_comm, Ideal.Quotient.eq]
      exact hc
    let e_res : Ω ≃+* R₀ ⧸ p₀.asIdeal := RingEquiv.ofBijective α_res hα_bij
    exact (Ideal.Quotient.maximal_ideal_iff_isField_quotient p₀.asIdeal).mpr
      (e_res.symm.toMulEquiv.isField (Field.toIsField Ω))
  have hMap_p₀_v₀ : Ideal.map φ_e p₀.asIdeal = v₀.asIdeal := by
    let _ : Field (R₀ ⧸ p₀.asIdeal) := Ideal.Quotient.field p₀.asIdeal
    let _ : Algebra R₀ A' := φ_e.toAlgebra
    have _ : Algebra.Etale R₀ A' := RingHom.etale_algebraMap.mp hφ_e_et
    let K₀ := R₀ ⧸ p₀.asIdeal
    have _ : IsReduced (TensorProduct R₀ K₀ A') :=
      Algebra.FormallyUnramified.isReduced_of_field K₀ (TensorProduct R₀ K₀ A')
    let I₀ : Ideal A' := Ideal.map φ_e p₀.asIdeal
    let e_Q : (A' ⧸ I₀) ≃+* TensorProduct R₀ K₀ A' :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A' p₀.asIdeal).toRingEquiv.trans
        (Algebra.TensorProduct.comm R₀ A' K₀).toRingEquiv
    have _ : IsReduced (A' ⧸ I₀) := ⟨fun q ⟨n, hn⟩ => by
      apply e_Q.injective
      rw [map_zero]
      have hnil : IsNilpotent (e_Q q) := ⟨n, by rw [← map_pow, hn, map_zero]⟩
      exact hnil.eq_zero⟩
    have hnil_bot : nilradical (A' ⧸ I₀) = ⊥ := nilradical_eq_bot_iff.mpr inferInstance
    apply le_antisymm
    · exact Ideal.map_le_iff_le_comap.mpr hpre_v₀.symm.le
    · intro x hx
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Submodule.mem_bot (R := A' ⧸ I₀),
        ← hnil_bot, nilradical_eq_sInf, Ideal.mem_sInf]
      intro P hP
      have _ : P.IsPrime := hP
      let q_A : Ideal A' := Ideal.comap (Ideal.Quotient.mk I₀) P
      have hq_prime : q_A.IsPrime := Ideal.comap_isPrime (Ideal.Quotient.mk I₀) P
      have hI₀_le : I₀ ≤ q_A := by
        intro y hy
        rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hy]
        exact P.zero_mem
      have hp₀_le : p₀.asIdeal ≤ Ideal.comap φ_e q_A := Ideal.map_le_iff_le_comap.mp hI₀_le
      have hcomap_prime : (Ideal.comap φ_e q_A).IsPrime := Ideal.comap_isPrime φ_e q_A
      have hp₀_eq : Ideal.comap φ_e q_A = p₀.asIdeal :=
        (hMax_p₀.eq_of_le hcomap_prime.ne_top hp₀_le).symm
      have hq_eq : q_A = v₀.asIdeal := hpre_uniq q_A hq_prime hp₀_eq
      change x ∈ q_A
      rwa [hq_eq]
  have hPart1 : ∃ m₁₁ m₁₂ m₂₁ m₂₂ : A',
      φ_e z₁ = m₁₁ * u + m₁₂ * v ∧
      φ_e z₂ = m₂₁ * u + m₂₂ * v ∧
      m₁₁ * m₂₂ - m₁₂ * m₂₁ ∉ v₀.asIdeal := by
    have hspan_eq : Ideal.span ({φ_e z₁, φ_e z₂} : Set A') = Ideal.span ({u, v} : Set A') := by
      have hmap_span : Ideal.map φ_e p₀.asIdeal = Ideal.span ({φ_e z₁, φ_e z₂} : Set A') := by
        rw [hp₀_span, Ideal.map_span, Set.image_pair]
      rw [← hmap_span, hMap_p₀_v₀, hv₀_span]
    have hz1_mem : φ_e z₁ ∈ Ideal.span ({u, v} : Set A') := by
      rw [← hspan_eq]; exact Ideal.subset_span (by simp)
    have hz2_mem : φ_e z₂ ∈ Ideal.span ({u, v} : Set A') := by
      rw [← hspan_eq]; exact Ideal.subset_span (by simp)
    have hu_mem : u ∈ Ideal.span ({φ_e z₁, φ_e z₂} : Set A') := by
      rw [hspan_eq]; exact Ideal.subset_span (by simp)
    have hv_mem : v ∈ Ideal.span ({φ_e z₁, φ_e z₂} : Set A') := by
      rw [hspan_eq]; exact Ideal.subset_span (by simp)
    obtain ⟨m₁₁, m₁₂, hm₁⟩ := Ideal.mem_span_pair.mp hz1_mem
    obtain ⟨m₂₁, m₂₂, hm₂⟩ := Ideal.mem_span_pair.mp hz2_mem
    obtain ⟨n₁₁, n₁₂, hn₁⟩ := Ideal.mem_span_pair.mp hu_mem
    obtain ⟨n₂₁, n₂₂, hn₂⟩ := Ideal.mem_span_pair.mp hv_mem
    have huv_rel : ∀ α β : A', α * u + β * v = 0 → α ∈ v₀.asIdeal ∧ β ∈ v₀.asIdeal := by
      intro α β hrel
      have hvβ : v * β ∈ Ideal.span ({u} : Set A') := by
        rw [Ideal.mem_span_singleton]
        exact ⟨-α, by linear_combination hrel⟩
      obtain ⟨γ, rfl⟩ := Ideal.mem_span_singleton.mp (hregA β hvβ)
      have hu_in : u ∈ v₀.asIdeal := by rw [hv₀_span]; exact Ideal.subset_span (by simp)
      have hv_in : v ∈ v₀.asIdeal := by rw [hv₀_span]; exact Ideal.subset_span (by simp)
      have hβ_in : u * γ ∈ v₀.asIdeal := Ideal.mul_mem_right γ _ hu_in
      have hα_eq : u * (α + γ * v) = 0 := by linear_combination hrel
      have hαγ : α + γ * v = 0 := (mul_eq_zero.mp hα_eq).resolve_left hu_ne
      have hα_in : α ∈ v₀.asIdeal := by
        have hα_neg : α = -γ * v := by linear_combination hαγ
        rw [hα_neg]; exact Ideal.mul_mem_left _ (-γ) hv_in
      exact ⟨hα_in, hβ_in⟩
    have hrel₁ : (n₁₁ * m₁₁ + n₁₂ * m₂₁ - 1) * u + (n₁₁ * m₁₂ + n₁₂ * m₂₂) * v = 0 := by
      calc (n₁₁ * m₁₁ + n₁₂ * m₂₁ - 1) * u + (n₁₁ * m₁₂ + n₁₂ * m₂₂) * v
          = n₁₁ * (m₁₁ * u + m₁₂ * v) + n₁₂ * (m₂₁ * u + m₂₂ * v) - u := by ring
        _ = n₁₁ * φ_e z₁ + n₁₂ * φ_e z₂ - u := by rw [hm₁, hm₂]
        _ = 0 := by rw [hn₁, sub_self]
    have hrel₂ : (n₂₁ * m₁₁ + n₂₂ * m₂₁) * u + (n₂₁ * m₁₂ + n₂₂ * m₂₂ - 1) * v = 0 := by
      calc (n₂₁ * m₁₁ + n₂₂ * m₂₁) * u + (n₂₁ * m₁₂ + n₂₂ * m₂₂ - 1) * v
          = n₂₁ * (m₁₁ * u + m₁₂ * v) + n₂₂ * (m₂₁ * u + m₂₂ * v) - v := by ring
        _ = n₂₁ * φ_e z₁ + n₂₂ * φ_e z₂ - v := by rw [hm₁, hm₂]
        _ = 0 := by rw [hn₂, sub_self]
    obtain ⟨hd₁₁, hd₁₂⟩ := huv_rel _ _ hrel₁
    obtain ⟨hd₂₁, hd₂₂⟩ := huv_rel _ _ hrel₂
    refine ⟨m₁₁, m₁₂, m₂₁, m₂₂, hm₁.symm, hm₂.symm, ?_⟩
    intro hDet_mem
    let d₁₁ := n₁₁ * m₁₁ + n₁₂ * m₂₁ - 1
    let d₁₂ := n₁₁ * m₁₂ + n₁₂ * m₂₂
    let d₂₁ := n₂₁ * m₁₁ + n₂₂ * m₂₁
    let d₂₂ := n₂₁ * m₁₂ + n₂₂ * m₂₂ - 1
    have h1_eq : (1 : A') =
        (n₁₁ * n₂₂ - n₁₂ * n₂₁) * (m₁₁ * m₂₂ - m₁₂ * m₂₁) -
          (d₁₁ + d₂₂ + d₁₁ * d₂₂ - d₁₂ * d₂₁) := by
      dsimp [d₁₁, d₁₂, d₂₁, d₂₂]; ring
    have h1_mem : (1 : A') ∈ v₀.asIdeal := by
      rw [h1_eq]
      exact v₀.asIdeal.sub_mem
        (Ideal.mul_mem_left _ _ hDet_mem)
        (v₀.asIdeal.sub_mem
          (v₀.asIdeal.add_mem (v₀.asIdeal.add_mem hd₁₁ hd₂₂) (Ideal.mul_mem_left _ _ hd₂₂))
          (Ideal.mul_mem_left _ _ hd₂₁))
    exact v₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)

  
  have hLinearBlowup : ∀ (R : CommRingCat.{u}) (p : Ideal R),
      p.IsPrime →
      IsDomain R →
      ∀ (c_R : Ω →+* R) (w₁ w₂ : R),
        p = Ideal.span ({w₁, w₂} : Set R) →
        w₁ ≠ 0 →
        (∀ y : R, w₂ * y ∈ Ideal.span ({w₁} : Set R) → y ∈ Ideal.span ({w₁} : Set R)) →
        (∀ r : R, ∃ c : Ω, r - c_R c ∈ p) →
        (∃ (B : CommRingCat.{u}) (φ_B : R ⟶ B) (s_B : B),
          IsDomain B ∧ IsLinearBlowupQuot w₁ w₂ φ_B s_B) ∧
        (∀ (B : CommRingCat.{u}) (φ_B : R ⟶ B) (s_B : B),
          IsDomain B →
          IsLinearBlowupQuot w₁ w₂ φ_B s_B →
          φ_B.hom w₁ ≠ 0 ∧
          ∃ (φ_res : R →+* Ω) (ψ_exc : B →+* Polynomial Ω),
            Function.Surjective φ_res ∧
            RingHom.ker φ_res = p ∧
            (∀ c : Ω, φ_res (c_R c) = c) ∧
            Function.Surjective ψ_exc ∧
            RingHom.ker ψ_exc = Ideal.span ({φ_B.hom w₁} : Set B) ∧
            ψ_exc s_B = Polynomial.X ∧
            (∀ r : R, ψ_exc (φ_B.hom r) = Polynomial.C (φ_res r)) ∧
            ∀ c₁ : Ω,
              let I_c1 : Ideal B := Ideal.span ({φ_B.hom w₁, s_B - φ_B.hom (c_R c₁)} : Set B)
              RingHom.ker ((Polynomial.evalRingHom c₁).comp ψ_exc) = I_c1 ∧
              I_c1.IsMaximal ∧
              Ideal.comap φ_B.hom I_c1 = p ∧
              (∀ y : B, (s_B - φ_B.hom (c_R c₁)) * y ∈ Ideal.span ({φ_B.hom w₁} : Set B) →
                y ∈ Ideal.span ({φ_B.hom w₁} : Set B)) ∧
              (∀ x : B, ∃ c : Ω, x - φ_B.hom (c_R c) ∈ I_c1)) := by
    intro R p hp_prime hDomR c_R w₁ w₂ hp_span hw₁_ne hreg_w hres_w
    have _ : IsDomain R := hDomR
    have hw₂_ne : w₂ ≠ 0 := by
      intro h0
      have h1 : (1 : R) ∈ Ideal.span ({w₁} : Set R) := by
        apply hreg_w 1
        rw [h0, zero_mul]; exact Ideal.zero_mem _
      have h1p : (1 : R) ∈ p := by
        rw [hp_span]; exact Ideal.span_mono (by simp) h1
      exact hp_prime.ne_top ((Ideal.eq_top_iff_one _).mpr h1p)
    have hw₁₂ : w₁ * w₂ ≠ 0 := mul_ne_zero hw₁_ne hw₂_ne
    let L := Localization.Away (w₁ * w₂)
    let ι_L : R →+* L := algebraMap R L
    have hSubNzd : Submonoid.powers (w₁ * w₂) ≤ nonZeroDivisors R :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hw₁₂)
    have _ : IsDomain L := IsLocalization.isDomain_of_le_nonZeroDivisors L hSubNzd
    have hinj_L : Function.Injective ι_L := IsLocalization.injective L hSubNzd
    let u₁₂ : L := IsLocalization.Away.invSelf (S := L) (w₁ * w₂)
    have hu₁₂ : ι_L (w₁ * w₂) * u₁₂ = 1 := IsLocalization.Away.mul_invSelf (S := L) (w₁ * w₂)
    let t_L : L := ι_L w₂ * (ι_L w₂ * u₁₂)
    have ht_L : ι_L w₂ = ι_L w₁ * t_L := by
      dsimp [t_L]
      calc ι_L w₂ = ι_L w₂ * (ι_L (w₁ * w₂) * u₁₂) := by rw [hu₁₂, mul_one]
        _ = ι_L w₁ * (ι_L w₂ * (ι_L w₂ * u₁₂)) := by rw [map_mul]; ring
    let J_w : Ideal (Polynomial R) :=
      Ideal.span ({Polynomial.C w₂ - Polynomial.C w₁ * Polynomial.X} : Set (Polynomial R))
    let B_std : CommRingCat.{u} := CommRingCat.of (Polynomial R ⧸ J_w)
    let φ_std : R ⟶ B_std := CommRingCat.ofHom ((Ideal.Quotient.mk J_w).comp Polynomial.C)
    let s_std : B_std := Ideal.Quotient.mk J_w Polynomial.X
    have hQuot_std : IsLinearBlowupQuot w₁ w₂ φ_std s_std := by
      refine ⟨?_, ?_⟩
      · change Ideal.Quotient.mk J_w (Polynomial.C w₂) =
          Ideal.Quotient.mk J_w (Polynomial.C w₁) * Ideal.Quotient.mk J_w Polynomial.X
        rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span rfl
      · intro B' _ ρ t hρt
        let ev : Polynomial R →+* B' := Polynomial.eval₂RingHom ρ t
        have hker' : ∀ a₀ ∈ J_w, ev a₀ = 0 := by
          intro a₀ ha₀
          have hker : J_w ≤ RingHom.ker ev := by
            rw [Ideal.span_le]
            intro q hq
            rcases Set.mem_singleton_iff.mp hq with rfl
            simp [ev, hρt]
          exact RingHom.mem_ker.mp (hker ha₀)
        refine ⟨⟨Ideal.Quotient.lift J_w ev hker', ?_, ?_⟩, ?_⟩
        · ext r
          exact (Ideal.Quotient.lift_mk J_w ev hker').trans (by simp [ev])
        · exact (Ideal.Quotient.lift_mk J_w ev hker').trans (by simp [ev])
        · intro ψ₁ ψ₂ h1c h1s h2c h2s
          apply Ideal.Quotient.ringHom_ext
          apply Polynomial.ringHom_ext'
          · exact h1c.trans h2c.symm
          · exact h1s.trans h2s.symm
    obtain ⟨⟨f_Lw, hf_Lw_comp, hf_Lw_s⟩, _⟩ := hQuot_std.2 L ι_L t_L ht_L
    have hw₂_pow_reg : ∀ (k : ℕ) (y : R),
        w₂ ^ k * y ∈ Ideal.span ({w₁} : Set R) → y ∈ Ideal.span ({w₁} : Set R) := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        intro y hy
        apply ih
        apply hreg_w
        simpa [pow_succ', mul_assoc] using hy
    have hker_deg : ∀ (N : ℕ) (P : Polynomial R),
        (∀ j > N, P.coeff j = 0) →
        Polynomial.eval₂ ι_L t_L P = 0 →
        P ∈ J_w := by
      intro N
      induction N with
      | zero =>
        intro P hdeg hev
        have hP : P = Polynomial.C (P.coeff 0) := by
          ext j
          cases j with
          | zero => simp
          | succ j => simp [hdeg (j + 1) (Nat.succ_pos j)]
        rw [hP] at hev ⊢
        simp only [Polynomial.eval₂_C] at hev
        rw [hinj_L (hev.trans (map_zero _).symm), map_zero]
        exact Ideal.zero_mem J_w
      | succ N ih =>
        intro P hdeg hev
        have hsum : P = ∑ j ∈ Finset.range (N + 2), Polynomial.C (P.coeff j) * Polynomial.X ^ j := by
          ext k
          rw [Polynomial.finsetSum_coeff]
          simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
          by_cases hk : k < N + 2
          · rw [Finset.sum_eq_single k]
            · simp
            · intro b₀ _ hbk; simp [Ne.symm hbk]
            · intro hnot; exact absurd (Finset.mem_range.mpr hk) hnot
          · rw [Finset.sum_eq_zero]
            · exact hdeg k (by omega)
            · intro b₀ hb₀
              have hbk : k ≠ b₀ := by have := Finset.mem_range.mp hb₀; omega
              simp [hbk]
        have hmul : (ι_L w₁) ^ (N + 1) * Polynomial.eval₂ ι_L t_L P =
            ι_L (∑ j ∈ Finset.range (N + 2), P.coeff j * w₁ ^ (N + 1 - j) * w₂ ^ j) := by
          conv_lhs => rw [hsum]
          rw [Polynomial.eval₂_finsetSum, Finset.mul_sum, map_sum]
          apply Finset.sum_congr rfl
          intro j hj
          have hj_le : j ≤ N + 1 := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow,
            map_mul, map_mul, map_pow, map_pow]
          have hpow : (ι_L w₁) ^ (N + 1) * t_L ^ j = (ι_L w₁) ^ (N + 1 - j) * (ι_L w₂) ^ j := by
            calc (ι_L w₁) ^ (N + 1) * t_L ^ j
                = (ι_L w₁) ^ (N + 1 - j + j) * t_L ^ j := by rw [Nat.sub_add_cancel hj_le]
              _ = (ι_L w₁) ^ (N + 1 - j) * ((ι_L w₁) ^ j * t_L ^ j) := by rw [pow_add, mul_assoc]
              _ = (ι_L w₁) ^ (N + 1 - j) * (ι_L w₁ * t_L) ^ j := by rw [← mul_pow]
              _ = (ι_L w₁) ^ (N + 1 - j) * (ι_L w₂) ^ j := by rw [← ht_L]
          calc (ι_L w₁) ^ (N + 1) * (ι_L (P.coeff j) * t_L ^ j)
              = ι_L (P.coeff j) * ((ι_L w₁) ^ (N + 1) * t_L ^ j) := by ring
            _ = ι_L (P.coeff j) * ((ι_L w₁) ^ (N + 1 - j) * (ι_L w₂) ^ j) := by rw [hpow]
            _ = ι_L (P.coeff j) * (ι_L w₁) ^ (N + 1 - j) * (ι_L w₂) ^ j := by ring
        rw [hev, mul_zero] at hmul
        have hsum_zero : (∑ j ∈ Finset.range (N + 2),
            P.coeff j * w₁ ^ (N + 1 - j) * w₂ ^ j) = 0 :=
          hinj_L (hmul.symm.trans (map_zero _).symm)
        rw [Finset.sum_range_succ] at hsum_zero
        simp only [Nat.sub_self, pow_zero, mul_one] at hsum_zero
        have htop_mem : w₂ ^ (N + 1) * P.coeff (N + 1) ∈ Ideal.span ({w₁} : Set R) := by
          rw [Ideal.mem_span_singleton]
          refine ⟨- ∑ x ∈ Finset.range (N + 1), P.coeff x * w₁ ^ (N - x) * w₂ ^ x, ?_⟩
          have hsplit : ∑ x ∈ Finset.range (N + 1), P.coeff x * w₁ ^ (N + 1 - x) * w₂ ^ x =
              w₁ * ∑ x ∈ Finset.range (N + 1), P.coeff x * w₁ ^ (N - x) * w₂ ^ x := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro x hx
            have _ : x ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hx)
            have hsub : N + 1 - x = (N - x) + 1 := by omega
            rw [hsub, pow_succ]
            ring
          rw [hsplit] at hsum_zero
          linear_combination hsum_zero
        obtain ⟨b₀, hb₀⟩ := Ideal.mem_span_singleton.mp (hw₂_pow_reg (N + 1) _ htop_mem)
        let Q : Polynomial R :=
          P + Polynomial.C b₀ * Polynomial.X ^ N * (Polynomial.C w₂ - Polynomial.C w₁ * Polynomial.X)
        have hQ_eq : Q = P + Polynomial.C (b₀ * w₂) * Polynomial.X ^ N -
            Polynomial.C (b₀ * w₁) * Polynomial.X ^ (N + 1) := by
          dsimp [Q]; simp only [Polynomial.C_mul]; ring
        have hQ_deg : ∀ j > N, Q.coeff j = 0 := by
          intro j hj
          rw [hQ_eq, Polynomial.coeff_sub, Polynomial.coeff_add,
            Polynomial.coeff_C_mul, Polynomial.coeff_C_mul,
            Polynomial.coeff_X_pow, Polynomial.coeff_X_pow]
          by_cases hj1 : j = N + 1
          · subst hj1
            have hne : N + 1 ≠ N := by omega
            simp only [hne, ↓reduceIte, mul_zero, add_zero, mul_one, hb₀]
            ring
          · have hj2 : j > N + 1 := by omega
            have hne1 : j ≠ N := by omega
            simp only [hdeg j hj2, hne1, hj1, ↓reduceIte, mul_zero, add_zero, sub_zero]
        have hQ_ev : Polynomial.eval₂ ι_L t_L Q = 0 := by
          dsimp [Q]; simp [hev, ht_L]
        have hQ_mem : Q ∈ J_w := ih Q hQ_deg hQ_ev
        have hdiff : Q - P ∈ J_w := by
          dsimp [Q]; rw [add_sub_cancel_left]
          exact Ideal.mul_mem_left J_w _ (Ideal.subset_span rfl)
        rw [← sub_sub_cancel Q P]
        exact J_w.sub_mem hQ_mem hdiff
    have hinj_fLw : Function.Injective f_Lw := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [RingHom.mem_ker] at hx
      have hev : Polynomial.eval₂ ι_L t_L P = 0 := by
        have hcomp : f_Lw.comp (Ideal.Quotient.mk J_w) = Polynomial.eval₂RingHom ι_L t_L := by
          apply Polynomial.ringHom_ext'
          · ext r; simpa [φ_std] using RingHom.congr_fun hf_Lw_comp r
          · simpa [s_std] using hf_Lw_s
        exact (RingHom.congr_fun hcomp P).symm.trans hx
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact hker_deg P.natDegree P (fun j hj => Polynomial.coeff_eq_zero_of_natDegree_lt hj) hev
    have hDom_std : IsDomain B_std := hinj_fLw.isDomain f_Lw
    refine ⟨⟨B_std, φ_std, s_std, hDom_std, hQuot_std⟩, ?_⟩
    intro B φ_B s_B hDomB hQuotB
    have _ : IsDomain B := hDomB
    obtain ⟨⟨ι_BL, hι_BL_comp, _⟩, _⟩ := hQuotB.2 L ι_L t_L ht_L
    have hw1_B_ne : φ_B.hom w₁ ≠ 0 := by
      intro h0
      have h1 : ι_L w₁ = 0 := by
        rw [← RingHom.congr_fun hι_BL_comp w₁, RingHom.comp_apply, h0, map_zero]
      exact hw₁_ne (hinj_L (h1.trans (map_zero _).symm))
    obtain ⟨⟨α_std, hα_comp, hα_s⟩, _⟩ := hQuotB.2 B_std φ_std.hom s_std hQuot_std.1
    obtain ⟨⟨β_std, hβ_comp, hβ_s⟩, _⟩ := hQuot_std.2 B φ_B.hom s_B hQuotB.1
    have hβα_id : β_std.comp α_std = RingHom.id B := by
      apply (hQuotB.2 B φ_B.hom s_B hQuotB.1).2
      · rw [RingHom.comp_assoc, hα_comp, hβ_comp]
      · rw [RingHom.comp_apply, hα_s, hβ_s]
      · rfl
      · rfl
    have hSurj_poly : ∀ x : B, ∃ P : Polynomial R,
        x = ∑ j ∈ Finset.range (P.natDegree + 1), φ_B.hom (P.coeff j) * s_B ^ j := by
      intro x
      obtain ⟨P, hP_mk⟩ := Ideal.Quotient.mk_surjective (α_std x)
      refine ⟨P, ?_⟩
      have hx_β : x = β_std (Ideal.Quotient.mk J_w P) := by
        rw [hP_mk]
        exact (RingHom.congr_fun hβα_id x).symm
      have hP_sum : P = ∑ j ∈ Finset.range (P.natDegree + 1),
          Polynomial.C (P.coeff j) * Polynomial.X ^ j := by
        ext m
        rw [Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
        by_cases hm : m < P.natDegree + 1
        · rw [Finset.sum_eq_single m]
          · simp
          · intro b₀ _ hbm; simp [Ne.symm hbm]
          · intro hnot; exact absurd (Finset.mem_range.mpr hm) hnot
        · rw [Finset.sum_eq_zero]
          · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
          · intro b₀ hb₀
            have hmb : m ≠ b₀ := by have := Finset.mem_range.mp hb₀; omega
            simp [hmb]
      rw [hx_β]
      conv_lhs => rw [hP_sum]
      rw [map_sum, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [map_mul, map_pow, map_mul, map_pow]
      have hβ_r : β_std (φ_std.hom (P.coeff j)) = φ_B.hom (P.coeff j) :=
        RingHom.congr_fun hβ_comp (P.coeff j)
      change β_std (φ_std.hom (P.coeff j)) * (β_std s_std) ^ j = _
      rw [hβ_r, hβ_s]
    have _ : Nontrivial (R ⧸ p) := Ideal.Quotient.nontrivial_iff.mpr hp_prime.ne_top
    let α_R : Ω →+* R ⧸ p := (Ideal.Quotient.mk p).comp c_R
    have hαR_bij : Function.Bijective α_R := by
      refine ⟨α_R.injective, ?_⟩
      intro q
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨c, hc⟩ := hres_w r
      refine ⟨c, ?_⟩
      dsimp [α_R]
      rw [eq_comm, Ideal.Quotient.eq]
      exact hc
    let e_R : Ω ≃+* R ⧸ p := RingEquiv.ofBijective α_R hαR_bij
    let φ_res : R →+* Ω := e_R.symm.toRingHom.comp (Ideal.Quotient.mk p)
    have hSurj_res : Function.Surjective φ_res :=
      e_R.symm.surjective.comp Ideal.Quotient.mk_surjective
    have hKer_res : RingHom.ker φ_res = p := by
      ext r
      change e_R.symm (Ideal.Quotient.mk p r) = 0 ↔ r ∈ p
      rw [RingEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
    have hC_res : ∀ c : Ω, φ_res (c_R c) = c := fun c => e_R.symm_apply_apply c
    have hz_ker : Polynomial.C (φ_res w₂) = Polynomial.C (φ_res w₁) * (Polynomial.X : Polynomial Ω) := by
      have hw1_p : w₁ ∈ RingHom.ker φ_res := by
        rw [hKer_res, hp_span]; exact Ideal.subset_span (by simp)
      have hw2_p : w₂ ∈ RingHom.ker φ_res := by
        rw [hKer_res, hp_span]; exact Ideal.subset_span (by simp)
      rw [RingHom.mem_ker] at hw1_p hw2_p
      simp [hw1_p, hw2_p]
    obtain ⟨⟨ψ_exc, hψ_comp, hψ_s⟩, _⟩ :=
      hQuotB.2 (Polynomial Ω) (Polynomial.C.comp φ_res) Polynomial.X hz_ker
    have hψ_r : ∀ r : R, ψ_exc (φ_B.hom r) = Polynomial.C (φ_res r) :=
      RingHom.congr_fun hψ_comp
    have hSurj_ψ : Function.Surjective ψ_exc := by
      intro Q
      induction Q using Polynomial.induction_on' with
      | add q₁ q₂ hq₁ hq₂ =>
        obtain ⟨x₁, rfl⟩ := hq₁; obtain ⟨x₂, rfl⟩ := hq₂
        exact ⟨x₁ + x₂, map_add _ _ _⟩
      | monomial m c =>
        obtain ⟨r, rfl⟩ := hSurj_res c
        refine ⟨φ_B.hom r * s_B ^ m, ?_⟩
        rw [map_mul, map_pow, hψ_r, hψ_s, Polynomial.C_mul_X_pow_eq_monomial]
    have hKer_ψ : RingHom.ker ψ_exc = Ideal.span ({φ_B.hom w₁} : Set B) := by
      apply le_antisymm
      · intro x hx
        rw [RingHom.mem_ker] at hx
        obtain ⟨P, hP_sum⟩ := hSurj_poly x
        rw [hP_sum] at hx ⊢
        apply Ideal.sum_mem
        intro j hj
        have hj_coeff : φ_res (P.coeff j) = 0 := by
          have hpoly : ψ_exc (∑ i ∈ Finset.range (P.natDegree + 1), φ_B.hom (P.coeff i) * s_B ^ i) =
              ∑ i ∈ Finset.range (P.natDegree + 1), Polynomial.C (φ_res (P.coeff i)) * Polynomial.X ^ i := by
            rw [map_sum]
            apply Finset.sum_congr rfl
            intro i _
            rw [map_mul, map_pow, hψ_r, hψ_s]
          rw [hpoly] at hx
          have hcj := congrArg (fun q => Polynomial.coeff q j) hx
          rw [Polynomial.coeff_zero, Polynomial.finsetSum_coeff] at hcj
          simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero] at hcj
          rw [Finset.sum_eq_single j] at hcj
          · simpa using hcj
          · intro b₀ _ hbj; simp [Ne.symm hbj]
          · intro hnot; exact absurd hj hnot
        have hmem_p : P.coeff j ∈ p := by rw [← hKer_res]; exact hj_coeff
        rw [hp_span, Ideal.mem_span_pair] at hmem_p
        obtain ⟨a₀, b₀, hab⟩ := hmem_p
        have hφ_coeff : φ_B.hom (P.coeff j) ∈ Ideal.span ({φ_B.hom w₁} : Set B) := by
          rw [Ideal.mem_span_singleton]
          refine ⟨φ_B.hom a₀ + φ_B.hom b₀ * s_B, ?_⟩
          calc φ_B.hom (P.coeff j)
              = φ_B.hom (a₀ * w₁ + b₀ * w₂) := by rw [← hab]
            _ = φ_B.hom a₀ * φ_B.hom w₁ + φ_B.hom b₀ * (φ_B.hom w₁ * s_B) := by
                  rw [map_add, map_mul, map_mul, hQuotB.1]
            _ = φ_B.hom w₁ * (φ_B.hom a₀ + φ_B.hom b₀ * s_B) := by ring
        exact Ideal.mul_mem_right _ _ hφ_coeff
      · rw [Ideal.span_le]
        intro x hx
        rcases Set.mem_singleton_iff.mp hx with rfl
        change ψ_exc (φ_B.hom w₁) = 0
        rw [hψ_r]
        have hw1_p : w₁ ∈ RingHom.ker φ_res := by
          rw [hKer_res, hp_span]; exact Ideal.subset_span (by simp)
        rw [RingHom.mem_ker.mp hw1_p, map_zero]
    refine ⟨hw1_B_ne, φ_res, ψ_exc, hSurj_res, hKer_res, hC_res,
      hSurj_ψ, hKer_ψ, hψ_s, hψ_r, ?_⟩
    intro c₁ I_c1
    let ev_c1 : B →+* Ω := (Polynomial.evalRingHom c₁).comp ψ_exc
    have hev_c : ∀ c : Ω, ev_c1 (φ_B.hom (c_R c)) = c := by
      intro c
      change Polynomial.eval c₁ (ψ_exc (φ_B.hom (c_R c))) = c
      rw [hψ_r, hC_res, Polynomial.eval_C]
    have hSurj_ev : Function.Surjective ev_c1 := fun c => ⟨φ_B.hom (c_R c), hev_c c⟩
    have hKer_ev : RingHom.ker ev_c1 = I_c1 := by
      apply le_antisymm
      · intro x hx
        rw [RingHom.mem_ker] at hx
        have hroot : Polynomial.IsRoot (ψ_exc x) c₁ := hx
        obtain ⟨Q, hQ⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
        obtain ⟨h, rfl⟩ := hSurj_ψ Q
        have hdiff_ker : x - (s_B - φ_B.hom (c_R c₁)) * h ∈ RingHom.ker ψ_exc := by
          rw [RingHom.mem_ker, map_sub, map_mul, map_sub, hψ_s, hψ_r, hC_res, hQ, sub_self]
        rw [hKer_ψ] at hdiff_ker
        have hw1_le : Ideal.span ({φ_B.hom w₁} : Set B) ≤ I_c1 :=
          Ideal.span_mono (by simp)
        have hs_mem : s_B - φ_B.hom (c_R c₁) ∈ I_c1 :=
          Ideal.subset_span (by simp)
        have hx_eq : x = (x - (s_B - φ_B.hom (c_R c₁)) * h) + (s_B - φ_B.hom (c_R c₁)) * h := by
          ring
        rw [hx_eq]
        exact I_c1.add_mem (hw1_le hdiff_ker) (Ideal.mul_mem_right h I_c1 hs_mem)
      · rw [Ideal.span_le]
        intro y hy
        rcases Set.mem_insert_iff.mp hy with rfl | hy
        · change Polynomial.eval c₁ (ψ_exc (φ_B.hom w₁)) = 0
          have hw1_0 : ψ_exc (φ_B.hom w₁) = 0 := by
            rw [← RingHom.mem_ker, hKer_ψ]; exact Ideal.subset_span rfl
          rw [hw1_0, Polynomial.eval_zero]
        · rcases Set.mem_singleton_iff.mp hy with rfl
          change ev_c1 (s_B - φ_B.hom (c_R c₁)) = 0
          rw [map_sub, hev_c]
          change Polynomial.eval c₁ (ψ_exc s_B) - c₁ = 0
          rw [hψ_s, Polynomial.eval_X, sub_self]
    have hMax_Ic1 : I_c1.IsMaximal := by
      rw [← hKer_ev]
      let e_ev : B ⧸ RingHom.ker ev_c1 ≃+* Ω := RingHom.quotientKerEquivOfSurjective hSurj_ev
      exact (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mpr
        (e_ev.toMulEquiv.isField (Field.toIsField Ω))
    have hComap_Ic1 : Ideal.comap φ_B.hom I_c1 = p := by
      ext r
      rw [← hKer_ev, Ideal.mem_comap, RingHom.mem_ker]
      change Polynomial.eval c₁ (ψ_exc (φ_B.hom r)) = 0 ↔ r ∈ p
      rw [hψ_r, Polynomial.eval_C, ← RingHom.mem_ker, hKer_res]
    have hReg_Ic1 : ∀ y : B, (s_B - φ_B.hom (c_R c₁)) * y ∈ Ideal.span ({φ_B.hom w₁} : Set B) →
        y ∈ Ideal.span ({φ_B.hom w₁} : Set B) := by
      intro y hy
      rw [← hKer_ψ, RingHom.mem_ker] at hy ⊢
      rw [map_mul, map_sub, hψ_s, hψ_r, hC_res] at hy
      exact (mul_eq_zero.mp hy).resolve_left (Polynomial.X_sub_C_ne_zero c₁)
    have hRes_Ic1 : ∀ x : B, ∃ c : Ω, x - φ_B.hom (c_R c) ∈ I_c1 := by
      intro x
      refine ⟨ev_c1 x, ?_⟩
      rw [← hKer_ev, RingHom.mem_ker, map_sub, hev_c, sub_self]
    exact ⟨hKer_ev, hMax_Ic1, hComap_Ic1, hReg_Ic1, hRes_Ic1⟩

  
  have hMobiusLocEtale : ∀ (B₁ : CommRingCat.{u})
      (u₀ v₀_el : A') (φ_B1 : A' ⟶ B₁) (s_tilde : B₁)
      (m₁₁ m₁₂ m₂₁ m₂₂ : A') (w_unit : B₁),
      IsLinearBlowupQuot u₀ v₀_el φ_B1 s_tilde →
      φ_e z₁ = m₁₁ * u₀ + m₁₂ * v₀_el →
      φ_e z₂ = m₂₁ * u₀ + m₂₂ * v₀_el →
      (w_unit = 1 ∨ w_unit = s_tilde) →
      let Δ : A' := m₁₁ * m₂₂ - m₁₂ * m₂₁
      let ℓ₁ : B₁ := φ_B1.hom m₁₁ + φ_B1.hom m₁₂ * s_tilde
      let ℓ₂ : B₁ := φ_B1.hom m₂₁ + φ_B1.hom m₂₂ * s_tilde
      let g₁ : B₁ := φ_B1.hom Δ * ℓ₁ * w_unit
      let ι_C1 : B₁ →+* Localization.Away g₁ := algebraMap B₁ (Localization.Away g₁)
      ∃ ψ₁ : R₁ →+* Localization.Away g₁,
        ψ₁.Etale ∧
        ψ₁.comp φ₁.hom = ι_C1.comp (φ_B1.hom.comp φ_e) ∧
        ψ₁ s₁ * ι_C1 ℓ₁ = ι_C1 ℓ₂ ∧
        IsUnit (ι_C1 (φ_B1.hom Δ)) ∧
        IsUnit (ι_C1 ℓ₁) ∧
        IsUnit (ι_C1 w_unit) := by
    intro B₁ u₀ v₀_el φ_B1 s_tilde m₁₁ m₁₂ m₂₁ m₂₂ w_unit hQuot_B1 hm₁ hm₂ hw Δ ℓ₁ ℓ₂ g₁ ι_C1
    let C₁ := Localization.Away g₁
    let inv_g₁ : C₁ := IsLocalization.Away.invSelf (S := C₁) g₁
    have hg₁_inv : ι_C1 g₁ * inv_g₁ = 1 := IsLocalization.Away.mul_invSelf (S := C₁) g₁
    have hg₁_expand : ι_C1 g₁ = ι_C1 (φ_B1.hom Δ) * ι_C1 ℓ₁ * ι_C1 w_unit := by
      dsimp [g₁]; rw [map_mul, map_mul]
    have hΔ_unit : IsUnit (ι_C1 (φ_B1.hom Δ)) :=
      isUnit_iff_exists_inv.mpr ⟨ι_C1 ℓ₁ * ι_C1 w_unit * inv_g₁,
        by linear_combination hg₁_inv - inv_g₁ * hg₁_expand⟩
    let ℓ₁_inv : C₁ := ι_C1 (φ_B1.hom Δ) * ι_C1 w_unit * inv_g₁
    have hℓ₁_mul_inv : ι_C1 ℓ₁ * ℓ₁_inv = 1 := by
      dsimp [ℓ₁_inv]; linear_combination hg₁_inv - inv_g₁ * hg₁_expand
    have hℓ₁_unit : IsUnit (ι_C1 ℓ₁) := isUnit_iff_exists_inv.mpr ⟨ℓ₁_inv, hℓ₁_mul_inv⟩
    have hw_unit : IsUnit (ι_C1 w_unit) :=
      isUnit_iff_exists_inv.mpr ⟨ι_C1 (φ_B1.hom Δ) * ι_C1 ℓ₁ * inv_g₁,
        by linear_combination hg₁_inv - inv_g₁ * hg₁_expand⟩
    have hz1_B1 : φ_B1.hom (φ_e z₁) = φ_B1.hom u₀ * ℓ₁ := by
      dsimp [ℓ₁]
      rw [hm₁, map_add, map_mul, map_mul, hQuot_B1.1]
      ring
    have hz2_B1 : φ_B1.hom (φ_e z₂) = φ_B1.hom u₀ * ℓ₂ := by
      dsimp [ℓ₂]
      rw [hm₂, map_add, map_mul, map_mul, hQuot_B1.1]
      ring
    let t_C1 : C₁ := ι_C1 ℓ₂ * ℓ₁_inv
    have ht_C1_mul : t_C1 * ι_C1 ℓ₁ = ι_C1 ℓ₂ := by
      dsimp [t_C1]
      calc ι_C1 ℓ₂ * ℓ₁_inv * ι_C1 ℓ₁ = ι_C1 ℓ₂ * (ι_C1 ℓ₁ * ℓ₁_inv) := by ring
        _ = ι_C1 ℓ₂ := by rw [hℓ₁_mul_inv, mul_one]
    have hz_rel_C1 : (ι_C1.comp (φ_B1.hom.comp φ_e)) z₂ =
        (ι_C1.comp (φ_B1.hom.comp φ_e)) z₁ * t_C1 := by
      simp only [RingHom.comp_apply]
      rw [hz1_B1, hz2_B1, map_mul, map_mul, mul_assoc, mul_comm (ι_C1 ℓ₁) t_C1, ht_C1_mul]
    obtain ⟨⟨ψ₁, hψ₁_comp, hψ₁_s⟩, _⟩ :=
      hQuot₁.2 C₁ (ι_C1.comp (φ_B1.hom.comp φ_e)) t_C1 hz_rel_C1
    have hψ₁_s_mul : ψ₁ s₁ * ι_C1 ℓ₁ = ι_C1 ℓ₂ := by
      rw [hψ₁_s]; exact ht_C1_mul
    have hψ₁_et : ψ₁.Etale := by
      let _ : Algebra R₀ R₁ := φ₁.hom.toAlgebra
      let _ : Algebra R₀ A' := φ_e.toAlgebra
      have _ : Algebra.Etale R₀ A' := RingHom.etale_algebraMap.mp hφ_e_et
      let D₀ := TensorProduct R₀ R₁ A'
      let ι_R1 : R₁ →+* D₀ := algebraMap R₁ D₀
      let ι_A' : A' →+* D₀ := (Algebra.TensorProduct.includeRight (R := R₀) (A := R₁) (B := A')).toRingHom
      have hι_comm : ∀ r₀ : R₀, ι_A' (φ_e r₀) = ι_R1 (φ₁.hom r₀) := by
        intro r₀
        change (1 : R₁) ⊗ₜ[R₀] (φ_e r₀) = (φ₁.hom r₀) ⊗ₜ[R₀] (1 : A')
        have h1 : φ_e r₀ = r₀ • (1 : A') := (mul_one _).symm
        have h2 : φ₁.hom r₀ = r₀ • (1 : R₁) := (mul_one _).symm
        rw [h1, TensorProduct.tmul_smul, TensorProduct.smul_tmul', ← h2]
      let T : D₀ := ι_R1 s₁
      let μ₁ : D₀ := ι_A' m₂₂ - ι_A' m₁₂ * T
      let μ₂ : D₀ := - ι_A' m₂₁ + ι_A' m₁₁ * T
      let w_D : D₀ := if w_unit = 1 then 1 else μ₂
      let δ₁ : D₀ := ι_A' Δ * μ₁ * w_D
      let E₁ := Localization.Away δ₁
      let j_D : D₀ →+* E₁ := algebraMap D₀ E₁
      
      let _ : Algebra R₀ C₁ := (ι_C1.comp (φ_B1.hom.comp φ_e)).toAlgebra
      let f_R1 : R₁ →ₐ[R₀] C₁ :=
        { toRingHom := ψ₁
          commutes' := fun r₀ => RingHom.congr_fun hψ₁_comp r₀ }
      let f_A' : A' →ₐ[R₀] C₁ :=
        { toRingHom := ι_C1.comp φ_B1.hom
          commutes' := fun _ => rfl }
      let Φ₀ : D₀ →+* C₁ :=
        (Algebra.TensorProduct.lift f_R1 f_A' (fun _ _ => Commute.all _ _)).toRingHom
      have hΦ₀_R1 : ∀ r₁ : R₁, Φ₀ (ι_R1 r₁) = ψ₁ r₁ := by
        intro r₁
        change (Algebra.TensorProduct.lift f_R1 f_A' _) (r₁ ⊗ₜ[R₀] 1) = ψ₁ r₁
        rw [Algebra.TensorProduct.lift_tmul]
        change ψ₁ r₁ * ι_C1 (φ_B1.hom 1) = ψ₁ r₁
        rw [map_one, map_one, mul_one]
      have hΦ₀_A' : ∀ x : A', Φ₀ (ι_A' x) = ι_C1 (φ_B1.hom x) := by
        intro x
        change (Algebra.TensorProduct.lift f_R1 f_A' _) (1 ⊗ₜ[R₀] x) = ι_C1 (φ_B1.hom x)
        rw [Algebra.TensorProduct.lift_tmul]
        change ψ₁ 1 * ι_C1 (φ_B1.hom x) = ι_C1 (φ_B1.hom x)
        rw [map_one, one_mul]
      have hΦ₀_μ₁ : Φ₀ μ₁ * ι_C1 ℓ₁ = ι_C1 (φ_B1.hom Δ) := by
        dsimp [μ₁, T]
        rw [map_sub, map_mul, hΦ₀_A', hΦ₀_A', hΦ₀_R1]
        calc (ι_C1 (φ_B1.hom m₂₂) - ι_C1 (φ_B1.hom m₁₂) * ψ₁ s₁) * ι_C1 ℓ₁
            = ι_C1 (φ_B1.hom m₂₂) * ι_C1 ℓ₁ - ι_C1 (φ_B1.hom m₁₂) * (ψ₁ s₁ * ι_C1 ℓ₁) := by ring
          _ = ι_C1 (φ_B1.hom m₂₂ * ℓ₁ - φ_B1.hom m₁₂ * ℓ₂) := by
                rw [hψ₁_s_mul, ← map_mul, ← map_mul, ← map_sub]
          _ = ι_C1 (φ_B1.hom Δ) := by
                congr 1; dsimp [ℓ₁, ℓ₂, Δ]; simp only [map_sub, map_mul]; ring
      have hΦ₀_μ₂ : Φ₀ μ₂ * ι_C1 ℓ₁ = ι_C1 (φ_B1.hom Δ) * ι_C1 s_tilde := by
        dsimp [μ₂, T]
        rw [map_add, map_neg, map_mul, hΦ₀_A', hΦ₀_A', hΦ₀_R1]
        calc (-ι_C1 (φ_B1.hom m₂₁) + ι_C1 (φ_B1.hom m₁₁) * ψ₁ s₁) * ι_C1 ℓ₁
            = -ι_C1 (φ_B1.hom m₂₁) * ι_C1 ℓ₁ + ι_C1 (φ_B1.hom m₁₁) * (ψ₁ s₁ * ι_C1 ℓ₁) := by ring
          _ = ι_C1 (-φ_B1.hom m₂₁ * ℓ₁ + φ_B1.hom m₁₁ * ℓ₂) := by
                rw [hψ₁_s_mul]; simp only [map_add, map_neg, map_mul]
          _ = ι_C1 (φ_B1.hom Δ * s_tilde) := by
                congr 1; dsimp [ℓ₁, ℓ₂, Δ]; simp only [map_sub, map_mul]; ring
          _ = ι_C1 (φ_B1.hom Δ) * ι_C1 s_tilde := map_mul _ _ _
      have hΦ₀_μ₁_unit : IsUnit (Φ₀ μ₁) := by
        have hprod : IsUnit (Φ₀ μ₁ * ι_C1 ℓ₁) := hΦ₀_μ₁.symm ▸ hΔ_unit
        exact isUnit_of_mul_isUnit_left hprod
      have hΦ₀_wD_unit : IsUnit (Φ₀ w_D) := by
        dsimp [w_D]
        split_ifs with hw1
        · rw [map_one]; exact isUnit_one
        · have hws : w_unit = s_tilde := hw.resolve_left hw1
          have hprod : IsUnit (Φ₀ μ₂ * ι_C1 ℓ₁) := by
            rw [hΦ₀_μ₂, ← hws]
            exact hΔ_unit.mul hw_unit
          exact isUnit_of_mul_isUnit_left hprod
      have hΦ₀_δ₁_unit : IsUnit (Φ₀ δ₁) := by
        dsimp [δ₁]
        rw [map_mul, map_mul, hΦ₀_A']
        exact (hΔ_unit.mul hΦ₀_μ₁_unit).mul hΦ₀_wD_unit
      have hΦ₀_powers : ∀ y : Submonoid.powers δ₁, IsUnit (Φ₀ y.1) := by
        rintro ⟨_, k, rfl⟩
        rw [map_pow]
        exact hΦ₀_δ₁_unit.pow k
      let Φ : E₁ →+* C₁ := IsLocalization.lift (M := Submonoid.powers δ₁) hΦ₀_powers
      have hΦ_jD : ∀ d : D₀, Φ (j_D d) = Φ₀ d :=
        fun d => IsLocalization.lift_eq (M := Submonoid.powers δ₁) hΦ₀_powers d
      
      let inv_δ₁ : E₁ := IsLocalization.Away.invSelf (S := E₁) δ₁
      have hδ₁_inv : j_D δ₁ * inv_δ₁ = 1 := IsLocalization.Away.mul_invSelf (S := E₁) δ₁
      have hδ₁_expand : j_D δ₁ = j_D (ι_A' Δ) * j_D μ₁ * j_D w_D := by
        dsimp [δ₁]; rw [map_mul, map_mul]
      have hjΔ_unit : IsUnit (j_D (ι_A' Δ)) :=
        isUnit_iff_exists_inv.mpr ⟨j_D μ₁ * j_D w_D * inv_δ₁,
          by linear_combination hδ₁_inv - inv_δ₁ * hδ₁_expand⟩
      let μ₁_inv : E₁ := j_D (ι_A' Δ) * j_D w_D * inv_δ₁
      have hμ₁_mul_inv : j_D μ₁ * μ₁_inv = 1 := by
        dsimp [μ₁_inv]; linear_combination hδ₁_inv - inv_δ₁ * hδ₁_expand
      have hjwD_unit : IsUnit (j_D w_D) :=
        isUnit_iff_exists_inv.mpr ⟨j_D (ι_A' Δ) * j_D μ₁ * inv_δ₁,
          by linear_combination hδ₁_inv - inv_δ₁ * hδ₁_expand⟩
      have hv_μ₁ : ι_A' v₀_el * μ₁ = ι_A' u₀ * μ₂ := by
        have hrel_D0 : ι_A' (φ_e z₂) = ι_A' (φ_e z₁) * T := by
          rw [hι_comm z₁, hι_comm z₂, hQuot₁.1, map_mul]
        rw [hm₁, hm₂, map_add, map_add, map_mul, map_mul, map_mul, map_mul] at hrel_D0
        dsimp [μ₁, μ₂]
        linear_combination hrel_D0
      let s_E : E₁ := j_D μ₂ * μ₁_inv
      have hs_E_mul : s_E * j_D μ₁ = j_D μ₂ := by
        dsimp [s_E]
        calc j_D μ₂ * μ₁_inv * j_D μ₁ = j_D μ₂ * (j_D μ₁ * μ₁_inv) := by ring
          _ = j_D μ₂ := by rw [hμ₁_mul_inv, mul_one]
      have huv_E1 : (j_D.comp ι_A') v₀_el = (j_D.comp ι_A') u₀ * s_E := by
        simp only [RingHom.comp_apply]
        calc j_D (ι_A' v₀_el) = j_D (ι_A' v₀_el) * (j_D μ₁ * μ₁_inv) := by rw [hμ₁_mul_inv, mul_one]
          _ = j_D (ι_A' v₀_el * μ₁) * μ₁_inv := by rw [map_mul]; ring
          _ = j_D (ι_A' u₀ * μ₂) * μ₁_inv := by rw [hv_μ₁]
          _ = j_D (ι_A' u₀) * s_E := by rw [map_mul, mul_assoc]
      obtain ⟨⟨Ψ₀, hΨ₀_comp, hΨ₀_s⟩, _⟩ :=
        hQuot_B1.2 E₁ (j_D.comp ι_A') s_E huv_E1
      have hΨ₀_A' : ∀ x : A', Ψ₀ (φ_B1.hom x) = j_D (ι_A' x) := RingHom.congr_fun hΨ₀_comp
      have hΨ₀_ℓ₁ : Ψ₀ ℓ₁ * j_D μ₁ = j_D (ι_A' Δ) := by
        dsimp [ℓ₁]
        rw [map_add, map_mul, hΨ₀_A', hΨ₀_A', hΨ₀_s]
        calc (j_D (ι_A' m₁₁) + j_D (ι_A' m₁₂) * s_E) * j_D μ₁
            = j_D (ι_A' m₁₁) * j_D μ₁ + j_D (ι_A' m₁₂) * (s_E * j_D μ₁) := by ring
          _ = j_D (ι_A' m₁₁ * μ₁ + ι_A' m₁₂ * μ₂) := by rw [hs_E_mul, ← map_mul, ← map_mul, ← map_add]
          _ = j_D (ι_A' Δ) := by
                congr 1; dsimp [μ₁, μ₂, Δ]; simp only [map_sub, map_mul]; ring
      have hΨ₀_ℓ₂ : Ψ₀ ℓ₂ * j_D μ₁ = j_D (ι_A' Δ) * j_D T := by
        dsimp [ℓ₂]
        rw [map_add, map_mul, hΨ₀_A', hΨ₀_A', hΨ₀_s]
        calc (j_D (ι_A' m₂₁) + j_D (ι_A' m₂₂) * s_E) * j_D μ₁
            = j_D (ι_A' m₂₁) * j_D μ₁ + j_D (ι_A' m₂₂) * (s_E * j_D μ₁) := by ring
          _ = j_D (ι_A' m₂₁ * μ₁ + ι_A' m₂₂ * μ₂) := by rw [hs_E_mul, ← map_mul, ← map_mul, ← map_add]
          _ = j_D (ι_A' Δ * T) := by
                congr 1; dsimp [μ₁, μ₂, Δ]; simp only [map_sub, map_mul]; ring
          _ = j_D (ι_A' Δ) * j_D T := map_mul _ _ _
      have hΨ₀_ℓ₁_unit : IsUnit (Ψ₀ ℓ₁) :=
        isUnit_of_mul_isUnit_left (hΨ₀_ℓ₁.symm ▸ hjΔ_unit)
      have hμ₁_inv_unit : IsUnit μ₁_inv :=
        isUnit_iff_exists_inv'.mpr ⟨j_D μ₁, hμ₁_mul_inv⟩
      have hΨ₀_w_unit : IsUnit (Ψ₀ w_unit) := by
        by_cases hw1 : w_unit = 1
        · rw [hw1, map_one]; exact isUnit_one
        · have hws : w_unit = s_tilde := hw.resolve_left hw1
          have hwD_eq : w_D = μ₂ := by simp [w_D, hw1]
          have hjμ₂_unit : IsUnit (j_D μ₂) := hwD_eq ▸ hjwD_unit
          rw [hws, hΨ₀_s]
          exact hjμ₂_unit.mul hμ₁_inv_unit
      have hΨ₀_g₁_unit : IsUnit (Ψ₀ g₁) := by
        dsimp [g₁]
        rw [map_mul, map_mul, hΨ₀_A']
        exact (hjΔ_unit.mul hΨ₀_ℓ₁_unit).mul hΨ₀_w_unit
      have hΨ₀_powers : ∀ y : Submonoid.powers g₁, IsUnit (Ψ₀ y.1) := by
        rintro ⟨_, k, rfl⟩
        rw [map_pow]
        exact hΨ₀_g₁_unit.pow k
      let Ψ : C₁ →+* E₁ := IsLocalization.lift (M := Submonoid.powers g₁) hΨ₀_powers
      have hΨ_ιC1 : ∀ b₁ : B₁, Ψ (ι_C1 b₁) = Ψ₀ b₁ :=
        fun b₁ => IsLocalization.lift_eq (M := Submonoid.powers g₁) hΨ₀_powers b₁
      
      have hΨ_ψ₁ : Ψ.comp ψ₁ = j_D.comp ι_R1 := by
        have hrel_E1 : ((j_D.comp ι_R1).comp φ₁.hom) z₂ =
            ((j_D.comp ι_R1).comp φ₁.hom) z₁ * j_D T := by
          simp only [RingHom.comp_apply, T, ← map_mul, hQuot₁.1]
        apply (hQuot₁.2 E₁ ((j_D.comp ι_R1).comp φ₁.hom) (j_D T) hrel_E1).2
        · ext r₀
          simp only [RingHom.comp_apply]
          have hc : ψ₁ (φ₁.hom r₀) = ι_C1 (φ_B1.hom (φ_e r₀)) :=
            RingHom.congr_fun hψ₁_comp r₀
          rw [hc, hΨ_ιC1, hΨ₀_A', hι_comm]
        · apply hjΔ_unit.mul_right_cancel
          calc Ψ (ψ₁ s₁) * j_D (ι_A' Δ)
              = Ψ (ψ₁ s₁) * (Ψ₀ ℓ₁ * j_D μ₁) := by rw [hΨ₀_ℓ₁]
            _ = (Ψ (ψ₁ s₁) * Ψ (ι_C1 ℓ₁)) * j_D μ₁ := by rw [hΨ_ιC1]; ring
            _ = Ψ (ψ₁ s₁ * ι_C1 ℓ₁) * j_D μ₁ := by rw [← map_mul]
            _ = Ψ₀ ℓ₂ * j_D μ₁ := by rw [hψ₁_s_mul, hΨ_ιC1]
            _ = j_D T * j_D (ι_A' Δ) := by rw [hΨ₀_ℓ₂, mul_comm]
        · rfl
        · rfl
      have hΨΦ : Ψ.comp Φ = RingHom.id E₁ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers δ₁)
        apply RingHom.ext
        intro d
        simp only [RingHom.comp_apply, RingHom.id_apply]
        change Ψ (Φ (j_D d)) = j_D d
        rw [hΦ_jD]
        refine TensorProduct.inductionOn (motive := fun d => Ψ (Φ₀ d) = j_D d) d
          (fun r₁ x => ?_) (fun x y hx hy => ?_)
        · have htmul : (r₁ ⊗ₜ[R₀] x : D₀) = ι_R1 r₁ * ι_A' x := by
            change r₁ ⊗ₜ[R₀] x = (r₁ ⊗ₜ[R₀] 1) * (1 ⊗ₜ[R₀] x)
            simp
          rw [htmul, map_mul, map_mul, map_mul, hΦ₀_R1, hΦ₀_A', hΨ_ιC1, hΨ₀_A']
          have hr : Ψ (ψ₁ r₁) = j_D (ι_R1 r₁) := RingHom.congr_fun hΨ_ψ₁ r₁
          rw [hr]
        · rw [map_add, map_add, map_add, hx, hy]
      have hΦ_Ψ₀ : Φ.comp Ψ₀ = ι_C1 := by
        have hrel_B1C1 : (ι_C1.comp φ_B1.hom) v₀_el = (ι_C1.comp φ_B1.hom) u₀ * ι_C1 s_tilde := by
          simp only [RingHom.comp_apply, ← map_mul, hQuot_B1.1]
        apply (hQuot_B1.2 C₁ (ι_C1.comp φ_B1.hom) (ι_C1 s_tilde) hrel_B1C1).2
        · ext x
          simp only [RingHom.comp_apply, hΨ₀_A', hΦ_jD, hΦ₀_A']
        · apply hΔ_unit.mul_right_cancel
          calc Φ (Ψ₀ s_tilde) * ι_C1 (φ_B1.hom Δ)
              = Φ (Ψ₀ s_tilde) * (Φ₀ μ₁ * ι_C1 ℓ₁) := by rw [hΦ₀_μ₁]
            _ = (Φ (s_E) * Φ (j_D μ₁)) * ι_C1 ℓ₁ := by rw [hΨ₀_s, hΦ_jD]; ring
            _ = Φ (s_E * j_D μ₁) * ι_C1 ℓ₁ := by rw [← map_mul]
            _ = Φ₀ μ₂ * ι_C1 ℓ₁ := by rw [hs_E_mul, hΦ_jD]
            _ = ι_C1 s_tilde * ι_C1 (φ_B1.hom Δ) := by rw [hΦ₀_μ₂, mul_comm]
        · rfl
        · rfl
      have hΦΨ : Φ.comp Ψ = RingHom.id C₁ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers g₁)
        apply RingHom.ext
        intro b₁
        simp only [RingHom.comp_apply, RingHom.id_apply]
        change Φ (Ψ (ι_C1 b₁)) = ι_C1 b₁
        rw [hΨ_ιC1]
        exact RingHom.congr_fun hΦ_Ψ₀ b₁
      have hEt_D0 : ι_R1.Etale := RingHom.etale_algebraMap.mpr inferInstance
      have hEt_jD : j_D.Etale :=
        RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway δ₁)
      have hEt_Φ : Φ.Etale := RingHom.Etale.of_bijective
        ⟨Function.LeftInverse.injective (g := Ψ) (fun x => RingHom.congr_fun hΨΦ x),
         Function.RightInverse.surjective (g := Ψ) (fun x => RingHom.congr_fun hΦΨ x)⟩
      have hψ₁_eq : ψ₁ = Φ.comp (j_D.comp ι_R1) := by
        ext r₁
        simp only [RingHom.comp_apply, hΦ_jD, hΦ₀_R1]
      rw [hψ₁_eq]
      exact RingHom.Etale.stableUnderComposition _ Φ
        (RingHom.Etale.stableUnderComposition ι_R1 j_D hEt_D0 hEt_jD) hEt_Φ
    exact ⟨ψ₁, hψ₁_et, hψ₁_comp, hψ₁_s_mul, hΔ_unit, hℓ₁_unit, hw_unit⟩

  
  have hFlatColon : ∀ (C : Type u) [CommRing C] (ψ : R₁ →+* C),
      ψ.Flat →
      ∀ (I : Ideal R₁) (x : R₁) (Q : Ideal C),
        (1 : C) ∉ Q →
        ψ x ∈ Ideal.map ψ I →
        ∃ y : R₁, y * x ∈ I ∧ ψ y ∉ Q := by
    intro C _ ψ hFlat I x Q h1Q hx
    let _ : Algebra R₁ C := ψ.toAlgebra
    have _ : Module.Flat R₁ C := hFlat
    let f : R₁ →ₗ[R₁] (R₁ ⧸ I) :=
      { toFun := fun y => Ideal.Quotient.mk I (y * x)
        map_add' := fun a₁ b₁ => by rw [add_mul, map_add]
        map_smul' := fun r a₁ => by
          simp only [smul_eq_mul, mul_assoc, RingHom.id_apply]
          rfl }
    let J : Ideal R₁ := LinearMap.ker f
    let f_bar : (R₁ ⧸ J) →ₗ[R₁] (R₁ ⧸ I) := J.liftQ f le_rfl
    have hinj_bar : Function.Injective f_bar :=
      LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot J f le_rfl le_rfl)
    have hinj_tens : Function.Injective (LinearMap.lTensor C f_bar) :=
      Module.Flat.lTensor_preserves_injective_linearMap f_bar hinj_bar
    have hzero_I : ∀ z ∈ Ideal.map ψ I,
        (z ⊗ₜ[R₁] Ideal.Quotient.mk I (1 : R₁) : TensorProduct R₁ C (R₁ ⧸ I)) = 0 := by
      intro z hz
      rw [Ideal.map] at hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨a₁, ha₁, rfl⟩
        have hsm : ψ a₁ = a₁ • (1 : C) := by
          change ψ a₁ = algebraMap R₁ C a₁ * 1
          rw [mul_one]; rfl
        rw [hsm, TensorProduct.smul_tmul]
        have hmk : a₁ • Ideal.Quotient.mk I (1 : R₁) = 0 := by
          change Ideal.Quotient.mk I (a₁ * 1) = 0
          rw [mul_one, Ideal.Quotient.eq_zero_iff_mem]
          exact ha₁
        rw [hmk, TensorProduct.tmul_zero]
      · simp
      · intro u₁ v₁ _ _ hu₁ hv₁
        rw [TensorProduct.add_tmul, hu₁, hv₁, add_zero]
      · intro c u₁ _ hu₁
        change (c • (u₁ ⊗ₜ[R₁] Ideal.Quotient.mk I (1 : R₁) : TensorProduct R₁ C (R₁ ⧸ I))) = 0
        rw [hu₁, smul_zero]
    have h1x_zero : ((1 : C) ⊗ₜ[R₁] Ideal.Quotient.mk I x : TensorProduct R₁ C (R₁ ⧸ I)) = 0 := by
      have h1 : Ideal.Quotient.mk I x = x • Ideal.Quotient.mk I (1 : R₁) := by
        change Ideal.Quotient.mk I x = Ideal.Quotient.mk I (x * 1)
        rw [mul_one]
      have h2 : (x • (1 : C)) = ψ x := mul_one (ψ x)
      rw [h1, ← TensorProduct.smul_tmul, h2]
      exact hzero_I (ψ x) hx
    have h1J_zero : ((1 : C) ⊗ₜ[R₁] Ideal.Quotient.mk J (1 : R₁) : TensorProduct R₁ C (R₁ ⧸ J)) = 0 := by
      apply hinj_tens
      rw [map_zero, LinearMap.lTensor_tmul]
      change (1 : C) ⊗ₜ[R₁] Ideal.Quotient.mk I (1 * x) = 0
      rwa [one_mul]
    let JC : Ideal C := Ideal.map ψ J
    let mkJC : C →ₐ[R₁] (C ⧸ JC) := Ideal.Quotient.mkₐ R₁ JC
    let B_map : C →ₗ[R₁] (R₁ ⧸ J) →ₗ[R₁] (C ⧸ JC) :=
      { toFun := fun c =>
          J.liftQ (mkJC.toLinearMap.comp ((Algebra.lmul R₁ C c).comp (Algebra.linearMap R₁ C)))
            (fun r hr => by
              rw [LinearMap.mem_ker]
              change Ideal.Quotient.mk JC (c * ψ r) = 0
              rw [Ideal.Quotient.eq_zero_iff_mem]
              exact Ideal.mul_mem_left JC c (Ideal.mem_map_of_mem ψ hr))
        map_add' := fun c₁ c₂ => by
          apply Submodule.linearMap_qext
          apply LinearMap.ext
          intro r
          change Ideal.Quotient.mk JC ((c₁ + c₂) * ψ r) =
            Ideal.Quotient.mk JC (c₁ * ψ r) + Ideal.Quotient.mk JC (c₂ * ψ r)
          rw [add_mul, map_add]
        map_smul' := fun r₀ c => by
          apply Submodule.linearMap_qext
          apply LinearMap.ext
          intro r
          change Ideal.Quotient.mk JC ((ψ r₀ * c) * ψ r) =
            Ideal.Quotient.mk JC (ψ r₀ * (c * ψ r))
          rw [mul_assoc] }
    have h1_in_JC : (1 : C) ∈ JC := by
      have h := congrArg (TensorProduct.lift B_map) h1J_zero
      rw [map_zero, TensorProduct.lift.tmul] at h
      change Ideal.Quotient.mk JC (1 * ψ 1) = 0 at h
      rw [map_one, mul_one, Ideal.Quotient.eq_zero_iff_mem] at h
      exact h
    by_contra hAll
    push Not at hAll
    apply h1Q
    have hle : JC ≤ Q := by
      rw [Ideal.map_le_iff_le_comap]
      intro y hy
      have hyx : y * x ∈ I := by
        rwa [← Ideal.Quotient.eq_zero_iff_mem]
      exact hAll y hyx
    exact hle h1_in_JC

  
  have hSingleBranch : ∀ (u₀ v₀_el : A') (a₀ b₀ : ℕ)
      (m₁₁ m₁₂ m₂₁ m₂₂ : A') (c₁ : Ω) (P₁ : AlgebraicGeometry.Spec R₁),
      v₀.asIdeal = Ideal.span ({u₀, v₀_el} : Set A') →
      u₀ ≠ 0 →
      (∀ y : A', v₀_el * y ∈ Ideal.span ({u₀} : Set A') → y ∈ Ideal.span ({u₀} : Set A')) →
      1 ≤ a₀ + b₀ →
      φ_e (φ₀ PowerSeries.X) = ε * u₀ ^ a₀ * v₀_el ^ b₀ →
      φ_e z₁ = m₁₁ * u₀ + m₁₂ * v₀_el →
      φ_e z₂ = m₂₁ * u₀ + m₂₂ * v₀_el →
      m₁₁ * m₂₂ - m₁₂ * m₂₁ ∉ v₀.asIdeal →
      m₂₂ - c_A c₁ * m₁₂ ∉ v₀.asIdeal →
      P₁.asIdeal = Ideal.span ({φ₁.hom z₁, s₁ - φ₁.hom (φ₀ (PowerSeries.C c₁))} : Set R₁) →
      (∃ b' : ℕ, HasAffineNCChartAt Ω R₁ P₁ (φ₁.hom.comp φ₀) (a₀ + b₀) b') ∧
      (b₀ = 0 → HasAffineNCChartAt Ω R₁ P₁ (φ₁.hom.comp φ₀) (a₀ + b₀) 0) := by
    intro u₀ v₀_el a₀ b₀ m₁₁ m₁₂ m₂₁ m₂₂ c₁ P₁
      hv_span₀ hu₀_ne hreg₀_A hab_pos hX₀ hm₁ hm₂ hDet hNonvan hP₁
    
    obtain ⟨_, hLB_R₀⟩ := hLinearBlowup R₀ p₀.asIdeal p₀.isPrime hDom₀ c₀ z₁ z₂ hp₀_span hz₁_ne hreg₀ hres₀
    obtain ⟨hz1_R1_ne, _, _, _, _, _, _, _, _, _, hP1_props⟩ := hLB_R₀ R₁ φ₁ s₁ hDom₁ hQuot₁
    obtain ⟨_, hP₁_max, hP₁_comap, hP₁_reg, hP₁_res⟩ := hP1_props c₁
    dsimp only [c₀, RingHom.comp_apply] at hP₁_max hP₁_comap hP₁_reg hP₁_res
    rw [← hP₁] at hP₁_max hP₁_comap hP₁_res
    
    obtain ⟨⟨B₁, φ_B1, s_tilde, hDomB1, hQuot_B1⟩, hLB_A⟩ :=
      hLinearBlowup A' v₀.asIdeal v₀.isPrime hDomA c_A u₀ v₀_el hv_span₀ hu₀_ne hreg₀_A hresA
    have _ : IsDomain B₁ := hDomB1
    obtain ⟨hu0_B1_ne, φ_resA, ψ_exc_B1, _, hKer_resA, hC_resA,
        _, hKer_ψ_B1, hψ_B1_s, hψ_B1_r, hIc1_B1⟩ := hLB_A B₁ φ_B1 s_tilde hDomB1 hQuot_B1
    
    let Δ : A' := m₁₁ * m₂₂ - m₁₂ * m₂₁
    let mb11 : Ω := φ_resA m₁₁
    let mb12 : Ω := φ_resA m₁₂
    let mb21 : Ω := φ_resA m₂₁
    let mb22 : Ω := φ_resA m₂₂
    let Db : Ω := φ_resA Δ
    have hDb_eq : Db = mb11 * mb22 - mb12 * mb21 := by
      dsimp [Db, Δ, mb11, mb12, mb21, mb22]; rw [map_sub, map_mul, map_mul]
    have hDb_ne : Db ≠ 0 := by
      intro h0
      apply hDet
      rw [← hKer_resA, RingHom.mem_ker]
      exact h0
    let mub1 : Ω := mb22 - c₁ * mb12
    have hmub1_eq : mub1 = φ_resA (m₂₂ - c_A c₁ * m₁₂) := by
      dsimp [mub1, mb22, mb12]
      rw [map_sub, map_mul, hC_resA]
    have hmub1_ne : mub1 ≠ 0 := by
      intro h0
      apply hNonvan
      rw [← hKer_resA, RingHom.mem_ker, ← hmub1_eq]
      exact h0
    let ct1 : Ω := (c₁ * mb11 - mb21) * mub1⁻¹
    let Qt1 : Ideal B₁ := Ideal.span ({φ_B1.hom u₀, s_tilde - φ_B1.hom (c_A ct1)} : Set B₁)
    obtain ⟨hKer_evB1, hQt1_max, _, hQt1_reg, _⟩ := hIc1_B1 ct1
    have hQt1_prime : Qt1.IsPrime := hQt1_max.isPrime
    let ev_B1 : B₁ →+* Ω := (Polynomial.evalRingHom ct1).comp ψ_exc_B1
    change RingHom.ker ev_B1 = Qt1 at hKer_evB1
    have hev_B1_r : ∀ r' : A', ev_B1 (φ_B1.hom r') = φ_resA r' := by
      intro r'
      change Polynomial.eval ct1 (ψ_exc_B1 (φ_B1.hom r')) = φ_resA r'
      rw [hψ_B1_r, Polynomial.eval_C]
    have hev_B1_s : ev_B1 s_tilde = ct1 := by
      change Polynomial.eval ct1 (ψ_exc_B1 s_tilde) = ct1
      rw [hψ_B1_s, Polynomial.eval_X]
    let ℓ₁ : B₁ := φ_B1.hom m₁₁ + φ_B1.hom m₁₂ * s_tilde
    let ℓ₂ : B₁ := φ_B1.hom m₂₁ + φ_B1.hom m₂₂ * s_tilde
    have hev_ℓ₁_ne : ev_B1 ℓ₁ ≠ 0 := by
      have hmul_Db : ev_B1 ℓ₁ * mub1 = Db := by
        dsimp [ℓ₁]
        rw [map_add, map_mul, hev_B1_r, hev_B1_r, hev_B1_s]
        change (mb11 + mb12 * ((c₁ * mb11 - mb21) * mub1⁻¹)) * mub1 = Db
        calc (mb11 + mb12 * ((c₁ * mb11 - mb21) * mub1⁻¹)) * mub1
            = mb11 * mub1 + mb12 * ((c₁ * mb11 - mb21) * (mub1⁻¹ * mub1)) := by ring
          _ = mb11 * (mb22 - c₁ * mb12) + mb12 * (c₁ * mb11 - mb21) := by
                rw [inv_mul_cancel₀ hmub1_ne, mul_one]
          _ = Db := by rw [hDb_eq]; ring
      intro h0
      rw [h0, zero_mul] at hmul_Db
      exact hDb_ne hmul_Db.symm
    have hℓ_diff_mem : ℓ₂ - φ_B1.hom (c_A c₁) * ℓ₁ ∈ Qt1 := by
      rw [← hKer_evB1, RingHom.mem_ker]
      dsimp [ℓ₁, ℓ₂]
      rw [map_sub, map_add, map_mul, map_mul, map_add, map_mul,
        hev_B1_r, hev_B1_r, hev_B1_r, hev_B1_r, hev_B1_r, hC_resA, hev_B1_s]
      change (mb21 + mb22 * ct1) - c₁ * (mb11 + mb12 * ct1) = 0
      have h1 : (mb21 + mb22 * ct1) - c₁ * (mb11 + mb12 * ct1) =
          (mb21 - c₁ * mb11) + ct1 * mub1 := by dsimp [mub1]; ring
      rw [h1]
      dsimp [ct1]
      rw [mul_assoc, inv_mul_cancel₀ hmub1_ne, mul_one]
      ring
    let w_unit : B₁ := if ct1 = 0 then 1 else s_tilde
    let b' : ℕ := if ct1 = 0 then b₀ else 0
    have hw_or : w_unit = 1 ∨ w_unit = s_tilde := by
      dsimp [w_unit]; split_ifs <;> simp
    have hev_w_ne : ev_B1 w_unit ≠ 0 := by
      dsimp [w_unit]
      split_ifs with hct0
      · rw [map_one]; exact one_ne_zero
      · rw [hev_B1_s]; exact hct0
    let g₁ : B₁ := φ_B1.hom Δ * ℓ₁ * w_unit
    have hev_g₁_ne : ev_B1 g₁ ≠ 0 := by
      dsimp [g₁]
      rw [map_mul, map_mul, hev_B1_r]
      exact mul_ne_zero (mul_ne_zero hDb_ne hev_ℓ₁_ne) hev_w_ne
    have hg₁_not_Qt1 : g₁ ∉ Qt1 := by
      intro hmem
      rw [← hKer_evB1, RingHom.mem_ker] at hmem
      exact hev_g₁_ne hmem
    have hg₁_ne : g₁ ≠ 0 := fun h0 => hg₁_not_Qt1 (h0 ▸ Qt1.zero_mem)
    have hDisj : Disjoint (Submonoid.powers g₁ : Set B₁) (Qt1 : Set B₁) := by
      rw [Set.disjoint_left]
      rintro _ ⟨k, rfl⟩ hmem
      exact hg₁_not_Qt1 (hQt1_prime.mem_of_pow_mem k hmem)
    obtain ⟨ψ₁, hψ₁_et, hψ₁_comp, hψ₁_s_mul, _, hℓ₁_unit, hw_unit_C1⟩ :=
      hMobiusLocEtale B₁ u₀ v₀_el φ_B1 s_tilde m₁₁ m₁₂ m₂₁ m₂₂ w_unit hQuot_B1 hm₁ hm₂ hw_or
    let C₁ := Localization.Away g₁
    let ι_C1 : B₁ →+* C₁ := algebraMap B₁ C₁
    have hSubNzd_C1 : Submonoid.powers g₁ ≤ nonZeroDivisors B₁ :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg₁_ne)
    have hDomC1 : IsDomain C₁ := IsLocalization.isDomain_of_le_nonZeroDivisors C₁ hSubNzd_C1
    have hinj_C1 : Function.Injective ι_C1 := IsLocalization.injective C₁ hSubNzd_C1
    let A'_ch : CommRingCat.{u} := CommRingCat.of C₁
    have hψ₁_s_C1 : (ψ₁ s₁ : A'_ch) * (ι_C1 ℓ₁ : A'_ch) = (ι_C1 ℓ₂ : A'_ch) := hψ₁_s_mul
    have hℓ₁_unit_C1 : IsUnit (ι_C1 ℓ₁ : A'_ch) := hℓ₁_unit
    have hw_unit_C1' : IsUnit (ι_C1 w_unit : A'_ch) := hw_unit_C1
    let e_ch : AlgebraicGeometry.Spec A'_ch ⟶ AlgebraicGeometry.Spec R₁ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)
    have hpre_ech : (AlgebraicGeometry.Spec.preimage e_ch).hom = ψ₁ := by
      have h1 : AlgebraicGeometry.Spec.preimage e_ch = CommRingCat.ofHom ψ₁ :=
        AlgebraicGeometry.Spec.map_injective (AlgebraicGeometry.Spec.map_preimage e_ch)
      exact congrArg CommRingCat.Hom.hom h1
    have hEt_ech : AlgebraicGeometry.Etale e_ch :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ₁_et
    have hv'_prime : (Ideal.map ι_C1 Qt1).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g₁) C₁ Qt1 hQt1_prime hDisj
    let v'_ch : AlgebraicGeometry.Spec A'_ch := ⟨Ideal.map ι_C1 Qt1, hv'_prime⟩
    let u' : A'_ch := ι_C1 (φ_B1.hom u₀)
    let v' : A'_ch := ι_C1 (s_tilde - φ_B1.hom (c_A ct1))
    
    have he_ch_pre : e_ch.base ⁻¹' {P₁} = {v'_ch} := by
      ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hq_P1
        have _ : q.asIdeal.IsPrime := q.isPrime
        have hq_comap : Ideal.comap ψ₁ q.asIdeal = P₁.asIdeal := by
          have h1 := congrArg PrimeSpectrum.asIdeal hq_P1
          rwa [AlgebraicGeometry.Spec.map_apply] at h1
        let q₀ : Ideal B₁ := Ideal.comap ι_C1 q.asIdeal
        have hq₀_prime : q₀.IsPrime := Ideal.comap_isPrime ι_C1 q.asIdeal
        have hq_map : Ideal.map ι_C1 q₀ = q.asIdeal :=
          IsLocalization.map_under (Submonoid.powers g₁) C₁ q.asIdeal
        have hq₀_A : Ideal.comap φ_B1.hom q₀ = v₀.asIdeal := by
          apply hpre_uniq _ (Ideal.comap_isPrime φ_B1.hom q₀)
          ext r₀
          simp only [Ideal.mem_comap]
          change ι_C1 (φ_B1.hom (φ_e r₀)) ∈ q.asIdeal ↔ r₀ ∈ p₀.asIdeal
          have hc : ι_C1 (φ_B1.hom (φ_e r₀)) = ψ₁ (φ₁.hom r₀) :=
            (RingHom.congr_fun hψ₁_comp r₀).symm
          rw [hc, ← Ideal.mem_comap, hq_comap, ← hP₁_comap, Ideal.mem_comap]
        have hu0_q₀ : φ_B1.hom u₀ ∈ q₀ := by
          rw [← Ideal.mem_comap, hq₀_A, hv_span₀]
          exact Ideal.subset_span (by simp)
        have hres_q₀ : ∀ r' : A', φ_B1.hom r' - φ_B1.hom (c_A (φ_resA r')) ∈ q₀ := by
          intro r'
          rw [← map_sub, ← Ideal.mem_comap, hq₀_A, ← hKer_resA, RingHom.mem_ker,
            map_sub, hC_resA, sub_self]
        have hs1_q : ψ₁ s₁ - ψ₁ (φ₁.hom (φ₀ (PowerSeries.C c₁))) ∈ q.asIdeal := by
          rw [← map_sub, ← Ideal.mem_comap, hq_comap, hP₁]
          exact Ideal.subset_span (by simp)
        have hℓ_q₀ : ℓ₂ - φ_B1.hom (c_A c₁) * ℓ₁ ∈ q₀ := by
          rw [Ideal.mem_comap]
          have heq : (ι_C1 (ℓ₂ - φ_B1.hom (c_A c₁) * ℓ₁) : A'_ch) =
              ((ψ₁ s₁ : A'_ch) - ψ₁ (φ₁.hom (φ₀ (PowerSeries.C c₁)))) * ι_C1 ℓ₁ := by
            have hc1 : (ψ₁ (φ₁.hom (φ₀ (PowerSeries.C c₁))) : A'_ch) = ι_C1 (φ_B1.hom (c_A c₁)) :=
              RingHom.congr_fun hψ₁_comp (φ₀ (PowerSeries.C c₁))
            rw [sub_mul, hψ₁_s_C1, hc1, ← map_mul, ← map_sub]
          change (ι_C1 (ℓ₂ - φ_B1.hom (c_A c₁) * ℓ₁) : A'_ch) ∈ q.asIdeal
          rw [heq]
          exact Ideal.mul_mem_right _ _ hs1_q
        have hdiff_q₀ : (ℓ₂ - φ_B1.hom (c_A c₁) * ℓ₁) -
            (φ_B1.hom (c_A (mb21 - c₁ * mb11)) + φ_B1.hom (c_A mub1) * s_tilde) ∈ q₀ := by
          have hid : (ℓ₂ - φ_B1.hom (c_A c₁) * ℓ₁) -
              (φ_B1.hom (c_A (mb21 - c₁ * mb11)) + φ_B1.hom (c_A mub1) * s_tilde) =
              ((φ_B1.hom m₂₁ - φ_B1.hom (c_A mb21)) -
                φ_B1.hom (c_A c₁) * (φ_B1.hom m₁₁ - φ_B1.hom (c_A mb11))) +
              ((φ_B1.hom m₂₂ - φ_B1.hom (c_A mb22)) -
                φ_B1.hom (c_A c₁) * (φ_B1.hom m₁₂ - φ_B1.hom (c_A mb12))) * s_tilde := by
            dsimp [ℓ₁, ℓ₂, mub1]
            simp only [map_sub, map_mul]
            ring
          rw [hid]
          exact q₀.add_mem
            (q₀.sub_mem (hres_q₀ m₂₁) (Ideal.mul_mem_left _ _ (hres_q₀ m₁₁)))
            (Ideal.mul_mem_right s_tilde _
              (q₀.sub_mem (hres_q₀ m₂₂) (Ideal.mul_mem_left _ _ (hres_q₀ m₁₂))))
        have hlin_q₀ : φ_B1.hom (c_A (mb21 - c₁ * mb11)) + φ_B1.hom (c_A mub1) * s_tilde ∈ q₀ := by
          have := q₀.sub_mem hℓ_q₀ hdiff_q₀
          simpa using this
        have hs_tilde_q₀ : s_tilde - φ_B1.hom (c_A ct1) ∈ q₀ := by
          have hmul := Ideal.mul_mem_left q₀ (φ_B1.hom (c_A mub1⁻¹)) hlin_q₀
          have heq : φ_B1.hom (c_A mub1⁻¹) *
              (φ_B1.hom (c_A (mb21 - c₁ * mb11)) + φ_B1.hom (c_A mub1) * s_tilde) =
              s_tilde - φ_B1.hom (c_A ct1) := by
            have h1 : mub1⁻¹ * (mb21 - c₁ * mb11) = -ct1 := by dsimp [ct1]; ring
            have h2 : mub1⁻¹ * mub1 = 1 := inv_mul_cancel₀ hmub1_ne
            calc φ_B1.hom (c_A mub1⁻¹) *
                  (φ_B1.hom (c_A (mb21 - c₁ * mb11)) + φ_B1.hom (c_A mub1) * s_tilde)
                = φ_B1.hom (c_A (mub1⁻¹ * (mb21 - c₁ * mb11))) +
                    φ_B1.hom (c_A (mub1⁻¹ * mub1)) * s_tilde := by
                      simp only [map_mul]; ring
              _ = s_tilde - φ_B1.hom (c_A ct1) := by
                    rw [h1, h2, map_neg, map_neg, map_one, map_one, one_mul]; ring
          rwa [heq] at hmul
        have hQt1_le : Qt1 ≤ q₀ := by
          rw [Ideal.span_le]
          intro y hy
          rcases Set.mem_insert_iff.mp hy with rfl | hy
          · exact hu0_q₀
          · rcases Set.mem_singleton_iff.mp hy with rfl
            exact hs_tilde_q₀
        have hQt1_eq : Qt1 = q₀ := hQt1_max.eq_of_le hq₀_prime.ne_top hQt1_le
        apply PrimeSpectrum.ext
        change q.asIdeal = Ideal.map ι_C1 Qt1
        rw [← hq_map, hQt1_eq]
      · rintro rfl
        apply PrimeSpectrum.ext
        rw [AlgebraicGeometry.Spec.map_apply]
        have hle : P₁.asIdeal ≤ Ideal.comap ψ₁ v'_ch.asIdeal := by
          rw [hP₁, Ideal.span_le]
          intro y hy
          rcases Set.mem_insert_iff.mp hy with rfl | hy
          · change ψ₁ (φ₁.hom z₁) ∈ v'_ch.asIdeal
            have hz1_C1 : (ψ₁ (φ₁.hom z₁) : A'_ch) = u' * ι_C1 ℓ₁ := by
              have hc : (ψ₁ (φ₁.hom z₁) : A'_ch) = ι_C1 (φ_B1.hom (φ_e z₁)) :=
                RingHom.congr_fun hψ₁_comp z₁
              rw [hc, hm₁, map_add, map_mul, map_mul, hQuot_B1.1]
              dsimp [u', ℓ₁]
              simp only [map_add, map_mul]
              ring
            rw [hz1_C1]
            exact Ideal.mul_mem_right _ _
              (Ideal.mem_map_of_mem ι_C1 (Ideal.subset_span (by simp)))
          · rcases Set.mem_singleton_iff.mp hy with rfl
            change (ψ₁ (s₁ - φ₁.hom (φ₀ (PowerSeries.C c₁))) : A'_ch) ∈ v'_ch.asIdeal
            obtain ⟨ℓ₁_inv, hℓ₁_inv⟩ := hℓ₁_unit_C1.exists_right_inv
            have hprod_mem : ((ψ₁ s₁ : A'_ch) - ψ₁ (φ₁.hom (φ₀ (PowerSeries.C c₁)))) * ι_C1 ℓ₁ ∈
                v'_ch.asIdeal := by
              have hc1 : (ψ₁ (φ₁.hom (φ₀ (PowerSeries.C c₁))) : A'_ch) = ι_C1 (φ_B1.hom (c_A c₁)) :=
                RingHom.congr_fun hψ₁_comp (φ₀ (PowerSeries.C c₁))
              have heq : ((ψ₁ s₁ : A'_ch) - ψ₁ (φ₁.hom (φ₀ (PowerSeries.C c₁)))) * ι_C1 ℓ₁ =
                  ι_C1 (ℓ₂ - φ_B1.hom (c_A c₁) * ℓ₁) := by
                rw [sub_mul, hψ₁_s_C1, hc1, ← map_mul, ← map_sub]
              rw [heq]
              exact Ideal.mem_map_of_mem ι_C1 hℓ_diff_mem
            have hmul := Ideal.mul_mem_right ℓ₁_inv v'_ch.asIdeal hprod_mem
            rw [mul_assoc, hℓ₁_inv, mul_one, ← map_sub] at hmul
            exact hmul
        exact (hP₁_max.eq_of_le (Ideal.comap_isPrime ψ₁ v'_ch.asIdeal).ne_top hle).symm
    have hv'_span : v'_ch.asIdeal = Ideal.span ({u', v'} : Set A'_ch) := by
      change Ideal.map ι_C1 Qt1 = Ideal.span ({u', v'} : Set A'_ch)
      dsimp [Qt1, u', v']
      rw [Ideal.map_span, Set.image_pair]
    have hu'_ne : u' ≠ 0 :=
      fun h0 => hu0_B1_ne (hinj_C1 (h0.trans (map_zero _).symm))
    have hu0_prime : (Ideal.span ({φ_B1.hom u₀} : Set B₁)).IsPrime := by
      rw [← hKer_ψ_B1]; exact RingHom.ker_isPrime ψ_exc_B1
    have hg₁_not_u0 : g₁ ∉ Ideal.span ({φ_B1.hom u₀} : Set B₁) :=
      fun hmem => hg₁_not_Qt1 (Ideal.span_mono (by simp) hmem)
    have hg₁_unit_C1 : IsUnit (ι_C1 g₁ : A'_ch) :=
      IsLocalization.map_units C₁ ⟨g₁, Submonoid.mem_powers g₁⟩
    have hv'_reg : ∀ y : A'_ch, v' * y ∈ Ideal.span ({u'} : Set A'_ch) →
        y ∈ Ideal.span ({u'} : Set A'_ch) := by
      intro y hy
      rw [Ideal.mem_span_singleton] at hy ⊢
      obtain ⟨x, hx⟩ := hy
      obtain ⟨⟨y₀, _, ky, rfl⟩, hy₀⟩ := IsLocalization.surj (Submonoid.powers g₁) y
      obtain ⟨⟨x₀, _, kx, rfl⟩, hx₀⟩ := IsLocalization.surj (Submonoid.powers g₁) x
      change y * ι_C1 (g₁ ^ ky) = ι_C1 y₀ at hy₀
      change x * ι_C1 (g₁ ^ kx) = ι_C1 x₀ at hx₀
      have hB1_eq : (s_tilde - φ_B1.hom (c_A ct1)) * (y₀ * g₁ ^ kx) =
          φ_B1.hom u₀ * (x₀ * g₁ ^ ky) := by
        apply hinj_C1
        simp only [map_mul]
        calc (ι_C1 (s_tilde - φ_B1.hom (c_A ct1)) : A'_ch) * (ι_C1 y₀ * ι_C1 (g₁ ^ kx))
            = (v' * y) * ι_C1 (g₁ ^ kx) * ι_C1 (g₁ ^ ky) := by rw [← hy₀]; ring
          _ = (u' * x) * ι_C1 (g₁ ^ kx) * ι_C1 (g₁ ^ ky) := by rw [hx]
          _ = u' * (x * ι_C1 (g₁ ^ kx)) * ι_C1 (g₁ ^ ky) := by ring
          _ = ι_C1 (φ_B1.hom u₀) * (ι_C1 x₀ * ι_C1 (g₁ ^ ky)) := by rw [hx₀]; ring
      have hmem_u0 : (s_tilde - φ_B1.hom (c_A ct1)) * (y₀ * g₁ ^ kx) ∈
          Ideal.span ({φ_B1.hom u₀} : Set B₁) :=
        Ideal.mem_span_singleton.mpr ⟨x₀ * g₁ ^ ky, hB1_eq⟩
      have hy0g_mem : y₀ * g₁ ^ kx ∈ Ideal.span ({φ_B1.hom u₀} : Set B₁) :=
        hQt1_reg _ hmem_u0
      have hg_pow_not : g₁ ^ kx ∉ Ideal.span ({φ_B1.hom u₀} : Set B₁) :=
        fun hp => hg₁_not_u0 (hu0_prime.mem_of_pow_mem kx hp)
      have hy0_mem : y₀ ∈ Ideal.span ({φ_B1.hom u₀} : Set B₁) :=
        (hu0_prime.mul_mem_iff_mem_or_mem.mp hy0g_mem).resolve_right hg_pow_not
      obtain ⟨w₀, rfl⟩ := Ideal.mem_span_singleton.mp hy0_mem
      have hunit_gk : IsUnit (ι_C1 (g₁ ^ ky) : A'_ch) := by
        rw [map_pow]; exact hg₁_unit_C1.pow ky
      obtain ⟨inv_gk, hinv_gk⟩ := hunit_gk.exists_right_inv
      refine ⟨ι_C1 w₀ * inv_gk, ?_⟩
      symm
      calc u' * (ι_C1 w₀ * inv_gk)
          = (ι_C1 (φ_B1.hom u₀ * w₀) : A'_ch) * inv_gk := by rw [map_mul]; ring
        _ = (y * ι_C1 (g₁ ^ ky)) * inv_gk := by rw [← hy₀]
        _ = y := by rw [mul_assoc, hinv_gk, mul_one]
    have hv'_res : ∀ r' : A'_ch, ∃ c : Ω,
        r' - (AlgebraicGeometry.Spec.preimage e_ch).hom ((φ₁.hom.comp φ₀) (PowerSeries.C c)) ∈
          v'_ch.asIdeal := by
      intro r'
      rw [hpre_ech]
      obtain ⟨⟨y₀, _, k, rfl⟩, hy₀⟩ := IsLocalization.surj (Submonoid.powers g₁) r'
      change r' * ι_C1 (g₁ ^ k) = ι_C1 y₀ at hy₀
      have hev_gk_ne : ev_B1 (g₁ ^ k) ≠ 0 := by
        rw [map_pow]; exact pow_ne_zero k hev_g₁_ne
      let c : Ω := ev_B1 y₀ * (ev_B1 (g₁ ^ k))⁻¹
      refine ⟨c, ?_⟩
      have hc_eq : (ψ₁ ((φ₁.hom.comp φ₀) (PowerSeries.C c)) : A'_ch) = ι_C1 (φ_B1.hom (c_A c)) :=
        RingHom.congr_fun hψ₁_comp (φ₀ (PowerSeries.C c))
      rw [hc_eq]
      have hB1_mem : y₀ - φ_B1.hom (c_A c) * g₁ ^ k ∈ Qt1 := by
        rw [← hKer_evB1, RingHom.mem_ker]
        rw [map_sub, map_mul, hev_B1_r, hC_resA]
        dsimp [c]
        rw [mul_assoc, inv_mul_cancel₀ hev_gk_ne, mul_one, sub_self]
      have hprod_mem : (r' - ι_C1 (φ_B1.hom (c_A c))) * ι_C1 (g₁ ^ k) ∈ v'_ch.asIdeal := by
        have heq : (r' - ι_C1 (φ_B1.hom (c_A c))) * ι_C1 (g₁ ^ k) =
            ι_C1 (y₀ - φ_B1.hom (c_A c) * g₁ ^ k) := by
          rw [sub_mul, hy₀, ← map_mul, ← map_sub]
        rw [heq]
        exact Ideal.mem_map_of_mem ι_C1 hB1_mem
      have hunit_gk : IsUnit (ι_C1 (g₁ ^ k) : A'_ch) := by
        rw [map_pow]; exact hg₁_unit_C1.pow k
      obtain ⟨inv_gk, hinv_gk⟩ := hunit_gk.exists_right_inv
      have hmul := Ideal.mul_mem_right inv_gk v'_ch.asIdeal hprod_mem
      rwa [mul_assoc, hinv_gk, mul_one] at hmul
    let ε' : A'_ch := if ct1 = 0 then ι_C1 (φ_B1.hom ε) else ι_C1 (φ_B1.hom ε) * (ι_C1 s_tilde) ^ b₀
    have hε'_unit : IsUnit ε' := by
      dsimp [ε']
      have hε_C1 : IsUnit (ι_C1 (φ_B1.hom ε) : A'_ch) := (hε.map φ_B1.hom).map ι_C1
      split_ifs with hct0
      · exact hε_C1
      · have hw_eq : w_unit = s_tilde := by simp [w_unit, hct0]
        have hs_unit : IsUnit (ι_C1 s_tilde : A'_ch) := hw_eq ▸ hw_unit_C1'
        exact hε_C1.mul (hs_unit.pow b₀)
    have hX'_eq : (AlgebraicGeometry.Spec.preimage e_ch).hom ((φ₁.hom.comp φ₀) PowerSeries.X) =
        ε' * u' ^ (a₀ + b₀) * v' ^ b' := by
      rw [hpre_ech]
      have hc : (ψ₁ ((φ₁.hom.comp φ₀) PowerSeries.X) : A'_ch) =
          ι_C1 (φ_B1.hom (φ_e (φ₀ PowerSeries.X))) :=
        RingHom.congr_fun hψ₁_comp (φ₀ PowerSeries.X)
      have hexp : (ι_C1 (φ_B1.hom (ε * u₀ ^ a₀ * v₀_el ^ b₀)) : A'_ch) =
          ι_C1 (φ_B1.hom ε) * u' ^ (a₀ + b₀) * (ι_C1 s_tilde) ^ b₀ := by
        dsimp [u']
        simp only [map_mul, map_pow, hQuot_B1.1]
        rw [pow_add, mul_pow]
        ring
      rw [hc, hX₀, hexp]
      dsimp [ε', b', v']
      split_ifs with hct0
      · rw [hct0, map_zero, map_zero, sub_zero]
      · rw [pow_zero, mul_one]; ring
    have hChart : HasAffineNCChartAt Ω R₁ P₁ (φ₁.hom.comp φ₀) (a₀ + b₀) b' :=
      ⟨φ₁.hom z₁, s₁ - φ₁.hom (φ₀ (PowerSeries.C c₁)), A'_ch, v'_ch, e_ch, u', v', ε',
        hDom₁, hP₁, hz1_R1_ne, hP₁_reg, hP₁_res, hEt_ech, hDomC1, he_ch_pre, hv'_span,
        hu'_ne, hv'_reg, hv'_res, hε'_unit, hab_pos, hX'_eq⟩
    refine ⟨⟨b', hChart⟩, ?_⟩
    intro hb₀
    have hb'_zero : b' = 0 := by dsimp [b']; rw [hb₀, ite_self]
    rwa [hb'_zero] at hChart

  
  refine ⟨hPart1, ?_, ?_⟩
  · 
    intro m₁₁ m₁₂ m₂₁ m₂₂ hm₁ hm₂ hDet c₁ P₁ hP₁
    by_cases hNonvan : m₂₂ - φ_e (φ₀ (PowerSeries.C c₁)) * m₁₂ ∉ v₀.asIdeal
    · obtain ⟨⟨b', hCh⟩, hCh0⟩ := hSingleBranch u v a b m₁₁ m₁₂ m₂₁ m₂₂ c₁ P₁
        hv₀_span hu_ne hregA (by omega) hX_eq hm₁ hm₂ hDet hNonvan hP₁
      refine ⟨⟨a + b, b', hCh⟩, ?_⟩
      intro ha1 hb0 _
      have h0 := hCh0 hb0
      rwa [ha1, hb0] at h0
    · push Not at hNonvan
      refine ⟨?_, fun _ _ hNot => absurd hNonvan hNot⟩
      have hNonvan_swap : m₂₁ - c_A c₁ * m₁₁ ∉ v₀.asIdeal := by
        intro hMem2
        apply hDet
        have hid : m₁₁ * m₂₂ - m₁₂ * m₂₁ =
            m₁₁ * (m₂₂ - c_A c₁ * m₁₂) - m₁₂ * (m₂₁ - c_A c₁ * m₁₁) := by ring
        rw [hid]
        exact v₀.asIdeal.sub_mem
          (Ideal.mul_mem_left _ m₁₁ hNonvan)
          (Ideal.mul_mem_left _ m₁₂ hMem2)
      have hv_span_swap : v₀.asIdeal = Ideal.span ({v, u} : Set A') := by
        rw [hv₀_span, Set.pair_comm]
      have hX_swap : φ_e (φ₀ PowerSeries.X) = ε * v ^ b * u ^ a := by
        rw [hX_eq]; ring
      have hm₁_swap : φ_e z₁ = m₁₂ * v + m₁₁ * u := by rw [hm₁]; ring
      have hm₂_swap : φ_e z₂ = m₂₂ * v + m₂₁ * u := by rw [hm₂]; ring
      have hDet_swap : m₁₂ * m₂₁ - m₁₁ * m₂₂ ∉ v₀.asIdeal := by
        intro hMem
        apply hDet
        have hneg : m₁₁ * m₂₂ - m₁₂ * m₂₁ = -(m₁₂ * m₂₁ - m₁₁ * m₂₂) := by ring
        rw [hneg]
        exact v₀.asIdeal.neg_mem hMem
      obtain ⟨⟨b', hCh⟩, _⟩ := hSingleBranch v u b a m₁₂ m₁₁ m₂₂ m₂₁ c₁ P₁
        hv_span_swap hv_ne hregA_symm (by omega) hX_swap hm₁_swap hm₂_swap
        hDet_swap hNonvan_swap hP₁
      exact ⟨b + a, b', hCh⟩
  · 
    intro q_exc hq_exc _ hNoSq
    by_contra hNot10
    have hab_ge2 : 2 ≤ a + b := by omega
    obtain ⟨k, hk⟩ : ∃ k : ℕ, a + b = k + 2 := ⟨a + b - 2, by omega⟩
    obtain ⟨m₁₁, m₁₂, m₂₁, m₂₂, hm₁, hm₂, hDet⟩ := hPart1
    obtain ⟨⟨B₁, φ_B1, s_tilde, hDomB1, hQuot_B1⟩, hLB_A⟩ :=
