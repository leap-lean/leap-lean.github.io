        have hDiff : ∀ G : MvPolynomial (Fin 2) RStar,
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) G -
              Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
                (MvPolynomial.C (MvPolynomial.eval 0 G)) ∈ p.asIdeal := by
          intro G
          induction G using MvPolynomial.induction_on with
          | C a =>
            simp [p.asIdeal.zero_mem]
          | add P Q hP hQ =>
            have h_eq : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (P + Q) -
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
                  (MvPolynomial.C (MvPolynomial.eval 0 (P + Q))) =
                (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) P -
                  Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
                    (MvPolynomial.C (MvPolynomial.eval 0 P))) +
                (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) Q -
                  Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
                    (MvPolynomial.C (MvPolynomial.eval 0 Q))) := by
