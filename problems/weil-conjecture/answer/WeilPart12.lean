  have hDom_of_inj : ∀ (α : Laur →+* L), Function.Injective α →
      IsDominant (Spec.map (CommRingCat.ofHom α)) := by
    intro α hInjα
    refine ⟨by
      rw [denseRange_iff_closure_range]
      ext q
      simp only [Set.mem_univ, iff_true]
      let p_bot_L : PrimeSpectrum L := ⟨⊥, inferInstance⟩
      let p_bot_Laur : PrimeSpectrum Laur := ⟨⊥, inferInstance⟩
      have hcomap_bot : (Spec.map (CommRingCat.ofHom α)).base p_bot_L = p_bot_Laur := by
        apply PrimeSpectrum.ext
        ext x
        change α x ∈ (⊥ : Ideal L) ↔ x ∈ (⊥ : Ideal Laur)
        simp only [Ideal.mem_bot]
        exact ⟨fun hx => hInjα (hx.trans (map_zero α).symm), fun hx => by rw [hx, map_zero]⟩
      have hp_in_cl : p_bot_Laur ∈ closure (Set.range (Spec.map (CommRingCat.ofHom α)).base) :=
        subset_closure ⟨p_bot_L, hcomap_bot⟩
      have hbot_le_q : p_bot_Laur ≤ q := bot_le
      have hq_in_bot : q ∈ closure ({p_bot_Laur} : Set (PrimeSpectrum Laur)) :=
        (PrimeSpectrum.le_iff_mem_closure p_bot_Laur q).mp hbot_le_q
      exact isClosed_closure.closure_subset_iff.mpr
        (Set.singleton_subset_iff.mpr hp_in_cl) hq_in_bot⟩
  have _ : IsDominant (Spec.map (CommRingCat.ofHom α_02)) := hDom_of_inj α_02 hInj_α02
  have _ : IsDominant (Spec.map (CommRingCat.ofHom α_12)) := hDom_of_inj α_12 hInj_α12
  have _ : IsSeparated (Limits.terminal.from M_m) := hSep_M.1
  have hLaur_02 : Spec.map (CommRingCat.ofHom f_02) ≫ ι₀ =
      Spec.map (CommRingCat.ofHom f_20) ≫ ι₂ := by
    apply ext_of_isDominant_of_isSeparated (Limits.terminal.from M_m)
      (Limits.terminal.hom_ext _ _) (Spec.map (CommRingCat.ofHom α_02))
    have hL : Spec.map (CommRingCat.ofHom α_02) ≫ Spec.map (CommRingCat.ofHom f_02) ≫ ι₀ = γ_M := by
