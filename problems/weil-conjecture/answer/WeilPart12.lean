        have hcomp1 : p₁.comp ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) =
            (Ideal.Quotient.mk J_1).comp MvPolynomial.C := RingHom.ext fun c => (hp_C c).2.1
        have hhom1 : CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) ≫
            CommRingCat.ofHom p₁ =
