      intro R S _ _ _ _ I
      let J : Ideal S := Ideal.map (algebraMap R S) I
      have : IsScalarTower R (R ⧸ I) (S ⧸ J) :=
        IsScalarTower.of_algebraMap_eq fun r =>
          (Ideal.Quotient.algebraMap_quotient_map_quotient r).symm
      have : IsScalarTower R S (S ⧸ J) := IsScalarTower.of_algebraMap_eq' rfl
      let f_alg : TensorProduct R (R ⧸ I) S →ₐ[R ⧸ I] (S ⧸ J) :=
        Algebra.TensorProduct.lift (Algebra.ofId (R ⧸ I) (S ⧸ J))
