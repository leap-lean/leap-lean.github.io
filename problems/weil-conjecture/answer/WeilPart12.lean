      exact (hMob₁ m₁₁ m₁₂ m₂₁ m₂₂ hm₁ hm₂ hDet c₁ P₁ hP₁).2 ha1 hb0 hnonvan
    · left
      refine ⟨c₂₂ * c₁₂⁻¹, ⟨?_, ?_⟩⟩
