          _ = (θ_hom F * algebraMap A_hom L_a (MvPolynomial.X a ^ n)) * u_inv := by ring
          _ = ((HomogeneousLocalization.Away.mk 𝒜 (hXa a) n F hF).val *
                algebraMap A_hom L_a (MvPolynomial.X a ^ n)) * u_inv := by rw [h_eq_mul, hz_mul]
          _ = (HomogeneousLocalization.Away.mk 𝒜 (hXa a) n F hF).val *
