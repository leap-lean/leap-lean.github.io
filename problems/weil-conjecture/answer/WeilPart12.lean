    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    (∀ q' : ↥(CategoryTheory.Limits.pullback g_W' s_Ω),
      IsClosed ({q'} : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) →
      ∃ a' b' : ℕ, HasNCBranchAt Ω g_W' q' a' b') ∧
    ((∀ y : R₁, y ∉ q_exc.asIdeal →
        y * (AlgebraicGeometry.Spec.preimage (ι₁ ≫ g_W')).hom PowerSeries.X ∉
          Ideal.span ({(φ₁.hom z₁) ^ 2} : Set R₁)) →
      {q : ↥(CategoryTheory.Limits.pullback g_W' s_Ω) |
        q ∈ E_exc ∧ IsClosed ({q} : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) ∧
        ∃ a' b' : ℕ, 1 ≤ b' ∧ HasNCBranchAt Ω g_W' q a' b'}.Subsingleton) :=
by
  classical
  dsimp only
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let fst_0 := CategoryTheory.Limits.pullback.fst g_W s_Ω
  let fst'_0 := CategoryTheory.Limits.pullback.fst g_W' s_Ω
  
  have hS1 : ∀ q' : ↥(CategoryTheory.Limits.pullback g_W' s_Ω),
      IsClosed ({q'} : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) →
      π.base (fst'_0.base q') ≠ fst_0.base q₀ →
      ∃ a' b' : ℕ, HasNCBranchAt Ω g_W' q' a' b' := by
    have hLocReg : ∀ (D : Type u) [CommRing D] [IsDomain D] (f z₁_d z₂_d : D),
        f ≠ 0 →
        (∀ y : D, z₂_d * y ∈ Ideal.span ({z₁_d} : Set D) → y ∈ Ideal.span ({z₁_d} : Set D)) →
        ∀ y : Localization.Away f,
          algebraMap D (Localization.Away f) z₂_d * y ∈
            Ideal.span ({algebraMap D (Localization.Away f) z₁_d} : Set (Localization.Away f)) →
          y ∈ Ideal.span ({algebraMap D (Localization.Away f) z₁_d} : Set (Localization.Away f)) := by
      intro D _ _ f z₁_d z₂_d hf_ne hreg y hy
      have hSub : Submonoid.powers f ≤ nonZeroDivisors D :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf_ne)
      have hinj : Function.Injective (algebraMap D (Localization.Away f)) :=
        IsLocalization.injective (Localization.Away f) hSub
      rw [Ideal.mem_span_singleton] at hy ⊢
      obtain ⟨x, hx⟩ := hy
      obtain ⟨⟨y₀, _, ky, rfl⟩, hy₀⟩ := IsLocalization.surj (Submonoid.powers f) y
      obtain ⟨⟨x₀, _, kx, rfl⟩, hx₀⟩ := IsLocalization.surj (Submonoid.powers f) x
      dsimp only at hy₀ hx₀
      have heq_D : z₂_d * (y₀ * f ^ kx) = z₁_d * (x₀ * f ^ ky) := by
        apply hinj
        calc algebraMap D (Localization.Away f) (z₂_d * (y₀ * f ^ kx))
            = (algebraMap D (Localization.Away f) z₂_d *
                (y * algebraMap D (Localization.Away f) (f ^ ky))) *
                algebraMap D (Localization.Away f) (f ^ kx) := by
                  rw [hy₀]; simp only [map_mul]; ring
          _ = (algebraMap D (Localization.Away f) z₁_d * x) *
                algebraMap D (Localization.Away f) (f ^ kx) *
                algebraMap D (Localization.Away f) (f ^ ky) := by
                  rw [← hx]; ring
          _ = algebraMap D (Localization.Away f) (z₁_d * (x₀ * f ^ ky)) := by
                have hx₀' : algebraMap D (Localization.Away f) z₁_d *
                    (x * algebraMap D (Localization.Away f) (f ^ kx)) =
                    algebraMap D (Localization.Away f) z₁_d *
                      algebraMap D (Localization.Away f) x₀ := by rw [hx₀]
                calc (algebraMap D (Localization.Away f) z₁_d * x) *
                      algebraMap D (Localization.Away f) (f ^ kx) *
                      algebraMap D (Localization.Away f) (f ^ ky)
                    = (algebraMap D (Localization.Away f) z₁_d *
                        (x * algebraMap D (Localization.Away f) (f ^ kx))) *
                        algebraMap D (Localization.Away f) (f ^ ky) := by ring
                  _ = algebraMap D (Localization.Away f) (z₁_d * (x₀ * f ^ ky)) := by
                        rw [hx₀']; simp only [map_mul]; ring
      obtain ⟨w_d, hw_d⟩ := Ideal.mem_span_singleton.mp
        (hreg (y₀ * f ^ kx) (Ideal.mem_span_singleton.mpr ⟨x₀ * f ^ ky, heq_D⟩))
      have hu_f : IsUnit (algebraMap D (Localization.Away f) f) :=
        IsLocalization.Away.algebraMap_isUnit f
      let uf : (Localization.Away f)ˣ := hu_f.unit
      let uf_pow : (Localization.Away f)ˣ := uf ^ (ky + kx)
      have huf_val : (uf : Localization.Away f) = algebraMap D (Localization.Away f) f := rfl
      refine ⟨algebraMap D (Localization.Away f) w_d * ↑(uf_pow⁻¹), ?_⟩
      apply uf_pow.isUnit.mul_left_injective
      dsimp only
      calc y * (uf_pow : Localization.Away f)
          = (y * algebraMap D (Localization.Away f) (f ^ ky)) *
              algebraMap D (Localization.Away f) (f ^ kx) := by
                dsimp [uf_pow]
                rw [huf_val, pow_add, map_pow, map_pow]; ring
        _ = algebraMap D (Localization.Away f) (y₀ * f ^ kx) := by rw [hy₀, map_mul]
        _ = algebraMap D (Localization.Away f) z₁_d * algebraMap D (Localization.Away f) w_d := by
              rw [hw_d, map_mul]
        _ = (algebraMap D (Localization.Away f) z₁_d *
              (algebraMap D (Localization.Away f) w_d * ↑(uf_pow⁻¹))) *
              (uf_pow : Localization.Away f) := by simp [mul_assoc]
    have hLocRes : ∀ (D : Type u) [CommRing D] (P : Ideal D) [P.IsPrime]
        (f : D) (φ_D : PowerSeries Ω →+* D),
        f ∉ P →
        (∀ r : D, ∃ c : Ω, r - φ_D (PowerSeries.C c) ∈ P) →
        ∀ r' : Localization.Away f,
          ∃ c : Ω,
            r' - (algebraMap D (Localization.Away f)) (φ_D (PowerSeries.C c)) ∈
              Ideal.map (algebraMap D (Localization.Away f)) P := by
      intro D _ P _ f φ_D hf_not hres r'
      obtain ⟨⟨a₀, _, k, rfl⟩, ha₀⟩ := IsLocalization.surj (Submonoid.powers f) r'
      dsimp only at ha₀
      have hfk_not : f ^ k ∉ P := fun h => hf_not (Ideal.IsPrime.mem_of_pow_mem ‹P.IsPrime› k h)
