        (∀ d : D_Ω, ∃ c : Ω, d - ψ₂ (c_N c) ∈ w₀) ∧
        ∃ (q₀_min q₁_min : Ideal (Localization.AtPrime w₀))
          (hq₀ : q₀_min.IsPrime) (hq₁ : q₁_min.IsPrime),
          letI : q₀_min.IsPrime := hq₀
          letI : q₁_min.IsPrime := hq₁
          q₀_min ≠ q₁_min ∧
          (∀ P : Ideal (Localization.AtPrime w₀),
            P ∈ minimalPrimes (Localization.AtPrime w₀) ↔ P = q₀_min ∨ P = q₁_min) ∧
          (∀ P : Ideal (Localization.AtPrime w₀),
            P.IsPrime → P < IsLocalRing.maximalIdeal (Localization.AtPrime w₀) →
              P = q₀_min ∨ P = q₁_min) ∧
          IsIntegrallyClosed (Localization.AtPrime w₀ ⧸ q₀_min) ∧
          IsIntegrallyClosed (Localization.AtPrime w₀ ⧸ q₁_min) := by
      intro N_Ω D_Ω _ _ _ c_N u hu01 e_res he_res hBr_equiv ψ₂ hψ₂ w₀ _ hw₀_u
      let R_loc := Localization.AtPrime w₀
      let _ : Algebra N_Ω D_Ω := ψ₂.toAlgebra
      have hAlgEt : Algebra.Etale N_Ω D_Ω := RingHom.etale_algebraMap.mp hψ₂
      let m_nod : Ideal N_Ω := Ideal.span {u 0, u 1}
      have hm_nod_max : m_nod.IsMaximal := by
        let q_res : N_Ω →+* Ω := e_res.symm.toRingHom.comp (Ideal.Quotient.mk m_nod)
        have hq_surj : Function.Surjective q_res := e_res.symm.surjective.comp Ideal.Quotient.mk_surjective
        have hq_ker : RingHom.ker q_res = m_nod := by
          ext y
          change e_res.symm (Ideal.Quotient.mk m_nod y) = 0 ↔ y ∈ m_nod
          rw [map_eq_zero_iff e_res.symm e_res.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
        rw [← hq_ker]
        exact RingHom.ker_isMaximal_of_surjective q_res hq_surj
      have hRes_w₀ : ∀ d : D_Ω, ∃ c : Ω, d - ψ₂ (c_N c) ∈ w₀ := by
        let J_fib : Ideal D_Ω := Ideal.map (algebraMap N_Ω D_Ω) m_nod
        have hJ_le_w₀ : J_fib ≤ w₀ := by
          rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
          rintro _ (rfl | rfl)
          · exact hw₀_u 0
          · exact hw₀_u 1
        have hEt_bc : Algebra.Etale (N_Ω ⧸ m_nod) (TensorProduct N_Ω (N_Ω ⧸ m_nod) D_Ω) :=
          Algebra.Etale.baseChange N_Ω D_Ω (N_Ω ⧸ m_nod)
        let e_fib : TensorProduct N_Ω (N_Ω ⧸ m_nod) D_Ω ≃+* (D_Ω ⧸ J_fib) :=
          (Algebra.TensorProduct.comm N_Ω (N_Ω ⧸ m_nod) D_Ω).toRingEquiv.trans
            (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D_Ω m_nod).symm.toRingEquiv
        let φ_Ω_fib : Ω →+* (D_Ω ⧸ J_fib) :=
          e_fib.toRingHom.comp
            ((algebraMap (N_Ω ⧸ m_nod) (TensorProduct N_Ω (N_Ω ⧸ m_nod) D_Ω)).comp
              e_res.toRingHom)
        have hφ_Ω_et : φ_Ω_fib.Etale :=
          ringHom_etale_comp
            (ringHom_etale_comp (RingHom.Etale.of_bijective e_res.bijective)
              (RingHom.etale_algebraMap.mpr hEt_bc))
            (RingHom.Etale.of_bijective e_fib.bijective)
        have hφ_Ω_apply : ∀ c : Ω, φ_Ω_fib c = Ideal.Quotient.mk J_fib (ψ₂ (c_N c)) := by
          intro c
          change e_fib ((e_res c) ⊗ₜ[N_Ω] (1 : D_Ω)) = Ideal.Quotient.mk J_fib (ψ₂ (c_N c))
          rw [he_res c]
          have hmid : (Ideal.Quotient.mk m_nod (c_N c)) ⊗ₜ[N_Ω] (1 : D_Ω) =
              (1 : N_Ω ⧸ m_nod) ⊗ₜ[N_Ω] (ψ₂ (c_N c)) := by
            calc (Ideal.Quotient.mk m_nod (c_N c)) ⊗ₜ[N_Ω] (1 : D_Ω)
                = (c_N c • (1 : N_Ω ⧸ m_nod)) ⊗ₜ[N_Ω] (1 : D_Ω) := by
                    change (Ideal.Quotient.mk m_nod (c_N c)) ⊗ₜ[N_Ω] (1 : D_Ω) =
                      (Ideal.Quotient.mk m_nod (c_N c) * 1) ⊗ₜ[N_Ω] (1 : D_Ω)
                    rw [mul_one]
              _ = (1 : N_Ω ⧸ m_nod) ⊗ₜ[N_Ω] (c_N c • (1 : D_Ω)) :=
                  TensorProduct.smul_tmul (c_N c) 1 1
              _ = (1 : N_Ω ⧸ m_nod) ⊗ₜ[N_Ω] (ψ₂ (c_N c)) := by
                    change (1 : N_Ω ⧸ m_nod) ⊗ₜ[N_Ω] (ψ₂ (c_N c) * 1) =
                      (1 : N_Ω ⧸ m_nod) ⊗ₜ[N_Ω] (ψ₂ (c_N c))
                    rw [mul_one]
          rw [hmid]
          change (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D_Ω m_nod).symm
            ((ψ₂ (c_N c)) ⊗ₜ[N_Ω] (1 : N_Ω ⧸ m_nod)) = Ideal.Quotient.mk J_fib (ψ₂ (c_N c))
          exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D_Ω m_nod).symm.commutes (ψ₂ (c_N c))
        let _ : Algebra Ω (D_Ω ⧸ J_fib) := φ_Ω_fib.toAlgebra
        have : Algebra.Etale Ω (D_Ω ⧸ J_fib) := RingHom.etale_algebraMap.mp hφ_Ω_et
        obtain ⟨I_idx, hFin_I, Ai, instFieldAi, instAlgAi, e_prod, hAi⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod Ω (D_Ω ⧸ J_fib)).mp ‹_›
        let _ : Finite I_idx := hFin_I
        let _ : ∀ i, Field (Ai i) := instFieldAi
        let _ : ∀ i, Algebra Ω (Ai i) := instAlgAi
        have hFin_Ai : ∀ i : I_idx, Module.Finite Ω (Ai i) := fun i => (hAi i).1
        have hFin_prod : Module.Finite Ω (∀ i : I_idx, Ai i) := Module.Finite.pi
        have hFin_Jfib : Module.Finite Ω (D_Ω ⧸ J_fib) :=
          Module.Finite.equiv e_prod.symm.toLinearEquiv
        let φ_Ω_w₀ : Ω →+* (D_Ω ⧸ w₀) := (Ideal.Quotient.factor hJ_le_w₀).comp φ_Ω_fib
        let _ : Algebra Ω (D_Ω ⧸ w₀) := φ_Ω_w₀.toAlgebra
        have : IsScalarTower Ω Ω (D_Ω ⧸ w₀) := IsScalarTower.left Ω
        let fac_alg : (D_Ω ⧸ J_fib) →ₐ[Ω] (D_Ω ⧸ w₀) :=
          { Ideal.Quotient.factor hJ_le_w₀ with commutes' := fun _ => rfl }
        have hFac_surj : Function.Surjective fac_alg.toLinearMap :=
          Ideal.Quotient.factor_surjective hJ_le_w₀
        have hFin_w₀ : Module.Finite Ω (D_Ω ⧸ w₀) :=
          Module.Finite.of_surjective fac_alg.toLinearMap hFac_surj
        have hInt_w₀ : Algebra.IsIntegral Ω (D_Ω ⧸ w₀) := Algebra.IsIntegral.of_finite Ω (D_Ω ⧸ w₀)
        have hBij_w₀ : Function.Bijective (algebraMap Ω (D_Ω ⧸ w₀)) :=
          IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := D_Ω ⧸ w₀)
        intro d
        obtain ⟨c, hc⟩ := hBij_w₀.2 (Ideal.Quotient.mk w₀ d)
        refine ⟨c, ?_⟩
        have hc' : Ideal.Quotient.mk w₀ (ψ₂ (c_N c)) = Ideal.Quotient.mk w₀ d := by
          change Ideal.Quotient.factor hJ_le_w₀ (Ideal.Quotient.mk J_fib (ψ₂ (c_N c))) = _
          rw [← hφ_Ω_apply c]
          exact hc
        exact Ideal.Quotient.eq.mp hc'.symm
      have hBranch : ∀ ν : Fin 2,
          let b_ν : R_loc := algebraMap D_Ω R_loc (ψ₂ (u ν))
          ∃ (hq : (Ideal.span {b_ν}).IsPrime),
            let _ : (Ideal.span {b_ν}).IsPrime := hq
            IsPrincipalIdealRing (R_loc ⧸ Ideal.span {b_ν}) ∧
            ¬ IsField (R_loc ⧸ Ideal.span {b_ν}) := by
        intro ν
        let ν' : Fin 2 := if ν = 0 then 1 else 0
        obtain ⟨e_ν, he_ν_X⟩ := hBr_equiv ν
        let I_ν : Ideal N_Ω := Ideal.span {u ν}
        let Q_ν := N_Ω ⧸ I_ν
        let x_ν : D_Ω := ψ₂ (u ν)
        let J_ν : Ideal D_Ω := Ideal.span {x_ν}
        have hJ_ν_eq : Ideal.map (algebraMap N_Ω D_Ω) I_ν = J_ν := by
          rw [Ideal.map_span, Set.image_singleton]
          rfl
        let B_ν := D_Ω ⧸ J_ν
        have hEt_bc_ν : Algebra.Etale Q_ν (TensorProduct N_Ω Q_ν D_Ω) :=
          Algebra.Etale.baseChange N_Ω D_Ω Q_ν
        let e_Bν : TensorProduct N_Ω Q_ν D_Ω ≃+* B_ν :=
          ((Algebra.TensorProduct.comm N_Ω Q_ν D_Ω).toRingEquiv.trans
            (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D_Ω I_ν).symm.toRingEquiv).trans
            (Ideal.quotEquivOfEq hJ_ν_eq)
        let η_ν : Polynomial Ω →+* B_ν :=
          e_Bν.toRingHom.comp ((algebraMap Q_ν (TensorProduct N_Ω Q_ν D_Ω)).comp e_ν.toRingHom)
        have hη_ν_et : η_ν.Etale :=
          ringHom_etale_comp
            (ringHom_etale_comp (RingHom.Etale.of_bijective e_ν.bijective)
              (RingHom.etale_algebraMap.mpr hEt_bc_ν))
            (RingHom.Etale.of_bijective e_Bν.bijective)
        have hη_ν_X : η_ν Polynomial.X = Ideal.Quotient.mk J_ν (ψ₂ (u ν')) := by
          change e_Bν ((e_ν Polynomial.X) ⊗ₜ[N_Ω] (1 : D_Ω)) = Ideal.Quotient.mk J_ν (ψ₂ (u ν'))
          rw [he_ν_X]
          have htmul : (Ideal.Quotient.mk I_ν (u ν')) ⊗ₜ[N_Ω] (1 : D_Ω) =
              (1 : Q_ν) ⊗ₜ[N_Ω] (ψ₂ (u ν')) := by
            calc (Ideal.Quotient.mk I_ν (u ν')) ⊗ₜ[N_Ω] (1 : D_Ω)
                = (u ν' • (1 : Q_ν)) ⊗ₜ[N_Ω] (1 : D_Ω) := by
                    change (Ideal.Quotient.mk I_ν (u ν')) ⊗ₜ[N_Ω] (1 : D_Ω) =
                      (Ideal.Quotient.mk I_ν (u ν') * 1) ⊗ₜ[N_Ω] (1 : D_Ω)
                    rw [mul_one]
              _ = (1 : Q_ν) ⊗ₜ[N_Ω] (u ν' • (1 : D_Ω)) :=
                  TensorProduct.smul_tmul (u ν') 1 1
              _ = (1 : Q_ν) ⊗ₜ[N_Ω] (ψ₂ (u ν')) := by
                    change (1 : Q_ν) ⊗ₜ[N_Ω] (ψ₂ (u ν') * 1) = (1 : Q_ν) ⊗ₜ[N_Ω] (ψ₂ (u ν'))
                    rw [mul_one]
          rw [htmul]
          have hcomm_ν : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D_Ω I_ν).symm
              ((ψ₂ (u ν')) ⊗ₜ[N_Ω] (1 : Q_ν)) =
              Ideal.Quotient.mk (Ideal.map (algebraMap N_Ω D_Ω) I_ν) (ψ₂ (u ν')) :=
            (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D_Ω I_ν).symm.commutes (ψ₂ (u ν'))
          change Ideal.quotEquivOfEq hJ_ν_eq
            ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot D_Ω I_ν).symm
              ((ψ₂ (u ν')) ⊗ₜ[N_Ω] (1 : Q_ν))) = Ideal.Quotient.mk J_ν (ψ₂ (u ν'))
          rw [hcomm_ν]
          rfl
        let π_Dν : D_Ω →+* B_ν := Ideal.Quotient.mk J_ν
        have hJν_le_w₀ : J_ν ≤ w₀ := by
          rw [Ideal.span_singleton_le_iff_mem]
          exact hw₀_u ν
        let w_bar_ν : Ideal B_ν := Ideal.map π_Dν w₀
        have hker_πDν : RingHom.ker π_Dν ≤ w₀ := by rwa [Ideal.mk_ker]
        have hw_bar_ν_prime : w_bar_ν.IsPrime :=
          Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_πDν
        let _ : w_bar_ν.IsPrime := hw_bar_ν_prime
        have hcomap_w_bar : Ideal.comap π_Dν w_bar_ν = w₀ := by
          rw [Ideal.comap_map_of_surjective' π_Dν Ideal.Quotient.mk_surjective]
          exact sup_eq_left.mpr hker_πDν
        let p_X : Ideal (Polynomial Ω) := Ideal.span {Polynomial.X}
        have hpX_max : p_X.IsMaximal := by
          have hsurj_ev : Function.Surjective (Polynomial.evalRingHom (0 : Ω)) := fun c =>
            ⟨Polynomial.C c, by simp⟩
          have hker_ev : RingHom.ker (Polynomial.evalRingHom (0 : Ω)) = p_X := by
            ext P
            simp only [RingHom.mem_ker, Polynomial.coe_evalRingHom, p_X, Ideal.mem_span_singleton]
            constructor
            · intro h
              have hdiv := (Polynomial.X_mul_divX_add P).symm
              rw [Polynomial.coeff_zero_eq_eval_zero, h, map_zero, add_zero] at hdiv
              exact ⟨P.divX, hdiv⟩
            · rintro ⟨Q, rfl⟩
              simp
          rw [← hker_ev]
          exact RingHom.ker_isMaximal_of_surjective _ hsurj_ev
        have _ : p_X.IsPrime := hpX_max.isPrime
        have hpX_ne : p_X ≠ ⊥ := by
          intro hbot
          have hmem : Polynomial.X ∈ p_X := Ideal.subset_span rfl
          rw [hbot, Ideal.mem_bot] at hmem
          exact Polynomial.X_ne_zero hmem
        have hpX_pir : IsPrincipalIdealRing (Localization.AtPrime p_X) := by
          refine ⟨fun J => ?_⟩
          obtain ⟨p₀, hp₀⟩ := Submodule.IsPrincipal.principal (Ideal.under (Polynomial Ω) J)
          have hp₀_ideal : Ideal.under (Polynomial Ω) J = Ideal.span {p₀} := by
            rwa [Ideal.submodule_span_eq] at hp₀
          refine ⟨algebraMap (Polynomial Ω) (Localization.AtPrime p_X) p₀, ?_⟩
          rw [Ideal.submodule_span_eq, ← Set.image_singleton, ← Ideal.map_span, ← hp₀_ideal,
            IsLocalization.map_under p_X.primeCompl (Localization.AtPrime p_X) J]
        have hw_bar_over : Ideal.comap η_ν w_bar_ν = p_X := by
          have hle : p_X ≤ Ideal.comap η_ν w_bar_ν := by
            rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hη_ν_X]
            exact Ideal.mem_map_of_mem π_Dν (hw₀_u ν')
          exact (hpX_max.eq_of_le (Ideal.IsPrime.comap η_ν).ne_top hle).symm
        obtain ⟨hDom_Bν, hDvr_Bν⟩ :=
          hEtDvr (Polynomial Ω) B_ν η_ν hη_ν_et p_X hpX_ne hpX_pir w_bar_ν hw_bar_over
        let _ : IsDomain (Localization.AtPrime w_bar_ν) := hDom_Bν
        let _ : IsDiscreteValuationRing (Localization.AtPrime w_bar_ν) := hDvr_Bν
        let b_ν : R_loc := algebraMap D_Ω R_loc x_ν
        let q_ν : Ideal R_loc := Ideal.span {b_ν}
        have hα_units : ∀ v_u : w₀.primeCompl,
            IsUnit (((algebraMap B_ν (Localization.AtPrime w_bar_ν)).comp π_Dν) v_u) := by
          intro v_u
          have hu_not_w_bar : π_Dν v_u.1 ∉ w_bar_ν := by
            intro h
            have hmem : v_u.1 ∈ Ideal.comap π_Dν w_bar_ν := h
            rw [hcomap_w_bar] at hmem
            exact v_u.2 hmem
          exact IsLocalization.map_units (Localization.AtPrime w_bar_ν)
            (⟨π_Dν v_u.1, hu_not_w_bar⟩ : w_bar_ν.primeCompl)
        let α₀ : R_loc →+* Localization.AtPrime w_bar_ν := IsLocalization.lift hα_units
        have hq_ker_α₀ : q_ν ≤ RingHom.ker α₀ := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          change α₀ (algebraMap D_Ω R_loc x_ν) = 0
          rw [IsLocalization.lift_eq]
          change algebraMap B_ν (Localization.AtPrime w_bar_ν) (Ideal.Quotient.mk J_ν x_ν) = 0
          have hx0 : Ideal.Quotient.mk J_ν x_ν = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [hx0, map_zero]
        let α_ν : (R_loc ⧸ q_ν) →+* Localization.AtPrime w_bar_ν :=
          Ideal.Quotient.lift q_ν α₀ (fun _ hz => hq_ker_α₀ hz)
        have hJ_ker_β : J_ν ≤ RingHom.ker ((Ideal.Quotient.mk q_ν).comp (algebraMap D_Ω R_loc)) := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        let β₀ : B_ν →+* (R_loc ⧸ q_ν) :=
          Ideal.Quotient.lift J_ν ((Ideal.Quotient.mk q_ν).comp (algebraMap D_Ω R_loc))
            (fun _ hd => hJ_ker_β hd)
        have hβ_units : ∀ v : w_bar_ν.primeCompl, IsUnit (β₀ v) := by
          intro v
          obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective v.1
          have hd_not_w₀ : d ∉ w₀ := fun h => v.2 (hd ▸ Ideal.mem_map_of_mem π_Dν h)
          have hu_loc : IsUnit (algebraMap D_Ω R_loc d) :=
            IsLocalization.map_units R_loc (⟨d, hd_not_w₀⟩ : w₀.primeCompl)
          have hβ_eq : β₀ v.1 = Ideal.Quotient.mk q_ν (algebraMap D_Ω R_loc d) := by
            rw [← hd]; rfl
          rw [hβ_eq]
          exact hu_loc.map (Ideal.Quotient.mk q_ν)
        let β_ν : Localization.AtPrime w_bar_ν →+* (R_loc ⧸ q_ν) := IsLocalization.lift hβ_units
        have hβα : β_ν.comp α_ν = RingHom.id (R_loc ⧸ q_ν) := by
          apply Ideal.Quotient.ringHom_ext
          apply IsLocalization.ringHom_ext w₀.primeCompl
          apply RingHom.ext
          intro d
          change β_ν (α₀ (algebraMap D_Ω R_loc d)) = Ideal.Quotient.mk q_ν (algebraMap D_Ω R_loc d)
          rw [IsLocalization.lift_eq]
          exact IsLocalization.lift_eq hβ_units (π_Dν d)
        have hαβ : α_ν.comp β_ν = RingHom.id (Localization.AtPrime w_bar_ν) := by
          apply IsLocalization.ringHom_ext w_bar_ν.primeCompl
          apply Ideal.Quotient.ringHom_ext
          apply RingHom.ext
          intro d
          change α_ν (β_ν (algebraMap B_ν (Localization.AtPrime w_bar_ν) (π_Dν d))) =
            algebraMap B_ν (Localization.AtPrime w_bar_ν) (π_Dν d)
          rw [IsLocalization.lift_eq]
          change α₀ (algebraMap D_Ω R_loc d) = _
          exact IsLocalization.lift_eq hα_units d
        let e_stalk : (R_loc ⧸ q_ν) ≃+* Localization.AtPrime w_bar_ν :=
          { α_ν with
            invFun := β_ν
            left_inv := RingHom.congr_fun hβα
            right_inv := RingHom.congr_fun hαβ }
        have hDom_quot : IsDomain (R_loc ⧸ q_ν) :=
          e_stalk.toMulEquiv.isDomain (Localization.AtPrime w_bar_ν)
        have hq_prime : q_ν.IsPrime := (Ideal.Quotient.isDomain_iff_prime q_ν).mp hDom_quot
        let _ : q_ν.IsPrime := hq_prime
        have hPir_quot : IsPrincipalIdealRing (R_loc ⧸ q_ν) :=
          IsPrincipalIdealRing.of_surjective e_stalk.symm.toRingHom e_stalk.symm.surjective
        have hNotField_quot : ¬ IsField (R_loc ⧸ q_ν) := by
          intro hF
          obtain ⟨π_w, hπ_w⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime w_bar_ν)
          have hπ_ne : e_stalk.symm π_w ≠ 0 :=
            fun h0 => hπ_w.ne_zero (e_stalk.symm.injective (h0.trans (map_zero _).symm))
          obtain ⟨v, hv⟩ := hF.mul_inv_cancel hπ_ne
          have hu : IsUnit (e_stalk.symm π_w) := isUnit_iff_exists_inv.mpr ⟨v, hv⟩
          have hu_w : IsUnit π_w := by simpa using hu.map e_stalk.toRingHom
          exact hπ_w.not_isUnit hu_w
        exact ⟨hq_prime, hPir_quot, hNotField_quot⟩
      let b₀ : R_loc := algebraMap D_Ω R_loc (ψ₂ (u 0))
      let b₁ : R_loc := algebraMap D_Ω R_loc (ψ₂ (u 1))
      let q₀_min : Ideal R_loc := Ideal.span {b₀}
      let q₁_min : Ideal R_loc := Ideal.span {b₁}
      obtain ⟨hq₀, hPir₀, hNotField₀⟩ := hBranch 0
      obtain ⟨hq₁, hPir₁, hNotField₁⟩ := hBranch 1
      let _ : q₀_min.IsPrime := hq₀
      let _ : q₁_min.IsPrime := hq₁
      let _ : IsPrincipalIdealRing (R_loc ⧸ q₀_min) := hPir₀
      let _ : IsPrincipalIdealRing (R_loc ⧸ q₁_min) := hPir₁
      have _ : m_nod.IsPrime := hm_nod_max.isPrime
      have hw₀_over_nod : Ideal.comap ψ₂ w₀ = m_nod := by
        have hle : m_nod ≤ Ideal.comap ψ₂ w₀ := by
          rw [Ideal.span_le]
          rintro _ (rfl | rfl)
          · exact hw₀_u 0
          · exact hw₀_u 1
        exact (hm_nod_max.eq_of_le (Ideal.IsPrime.comap ψ₂).ne_top hle).symm
      have hMax_Rloc : IsLocalRing.maximalIdeal R_loc = Ideal.span {b₀, b₁} := by
        let ψ₂_loc : Localization.AtPrime m_nod →+* R_loc :=
          Localization.localRingHom m_nod w₀ ψ₂ hw₀_over_nod.symm
        let _ : Algebra (Localization.AtPrime m_nod) R_loc := ψ₂_loc.toAlgebra
        have : IsScalarTower N_Ω (Localization.AtPrime m_nod) R_loc :=
          IsScalarTower.of_algebraMap_eq fun y => by
