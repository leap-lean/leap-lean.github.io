      calc ρ₀.hom (x_b * s₀ ^ k₁)
          = ρ₀.hom x_b * (ρ₀.hom s₀) ^ k₁ := by rw [map_mul, map_pow]
        _ = (ρ_A.hom b * (ρ₀.hom s₀) ^ k₂) * (ρ₀.hom s₀) ^ k₁ := by rw [← h_b_eq]
        _ = ρ_A.hom b * (ρ₀.hom s₀) ^ (k₁ + k₂) := by rw [pow_add]; ring
        _ = (u_b : V) * ϖ ^ d * (u_s : V) := by rw [hb_val, hu_s_val]
        _ = (u₀ : V) * ϖ ^ d := by simp [u₀]; ring
    have hb₀_ξ : ρ₀.hom b₀ * ξ = ρ₀.hom a₀ := by
      calc ρ₀.hom (x_b * s₀ ^ k₁) * ξ
          = (ρ_A.hom b * (ρ₀.hom s₀) ^ k₂) * (ρ₀.hom s₀) ^ k₁ * ξ := by
              rw [map_mul, map_pow, ← h_b_eq]
        _ = (ρ_A.hom b * ξ) * (ρ₀.hom s₀) ^ k₁ * (ρ₀.hom s₀) ^ k₂ := by ring
        _ = ρ₀.hom x_a * (ρ₀.hom s₀) ^ k₂ := by rw [hb_ξ, h_a_eq]
        _ = ρ₀.hom (x_a * s₀ ^ k₂) := by rw [map_mul, map_pow]
    have hb₀_mem : b₀ ∈ p₀.asIdeal := by
      by_contra hb₀_not
      have hb₀_unit : IsUnit (ρ₀.hom b₀) :=
        IsLocalRing.notMem_maximalIdeal.mp ((hp₀_mem_iff b₀).not.mp hb₀_not)
      obtain ⟨c_a, hc_a⟩ := hR₀_res a₀
      obtain ⟨c_b, hc_b⟩ := hR₀_res b₀
      let φ_R₀ := (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom
      have hφ_comp : (AlgebraicGeometry.Spec.preimage (v_W ≫ g_W)).hom = ρ₀.hom.comp φ_R₀ := by
        have h1 : AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W) ≫ ρ₀ =
            AlgebraicGeometry.Spec.preimage (v_W ≫ g_W) := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.Spec.map_preimage, ← CategoryTheory.Category.assoc, hf₀]
          exact (AlgebraicGeometry.Spec.map_preimage _).symm
        exact congrArg CommRingCat.Hom.hom h1.symm
      have hcb_ne : c_b ≠ 0 := by
        rintro rfl
        apply hb₀_not
        simpa using hc_b
      let c : Ω := c_a / c_b
      have hcc : PowerSeries.C c_b * PowerSeries.C c = (PowerSeries.C c_a : RStar) := by
        rw [← map_mul, mul_div_cancel₀ c_a hcb_ne]
      have hprod_in_max :
          ρ₀.hom b₀ * (ξ - (AlgebraicGeometry.Spec.preimage (v_W ≫ g_W)).hom (PowerSeries.C c)) ∈
            IsLocalRing.maximalIdeal V := by
        rw [hφ_comp]
        have heq :
            ρ₀.hom b₀ * (ξ - (ρ₀.hom.comp φ_R₀) (PowerSeries.C c)) =
              ρ₀.hom (a₀ - φ_R₀ (PowerSeries.C c_a)) -
                ρ₀.hom (φ_R₀ (PowerSeries.C c)) * ρ₀.hom (b₀ - φ_R₀ (PowerSeries.C c_b)) := by
          simp only [RingHom.comp_apply, map_sub]
          have hmulC : ρ₀.hom (φ_R₀ (PowerSeries.C c_a)) =
              ρ₀.hom (φ_R₀ (PowerSeries.C c)) * ρ₀.hom (φ_R₀ (PowerSeries.C c_b)) := by
            rw [← hcc, map_mul, map_mul]; ring
          rw [hmulC, ← hb₀_ξ]
          ring
        rw [heq]
        exact (IsLocalRing.maximalIdeal V).sub_mem ((hp₀_mem_iff _).mp hc_a)
          (Ideal.mul_mem_left _ _ ((hp₀_mem_iff _).mp hc_b))
      obtain ⟨v_inv, hv_inv⟩ := hb₀_unit.exists_left_inv
      have hξ_in : ξ - (AlgebraicGeometry.Spec.preimage (v_W ≫ g_W)).hom (PowerSeries.C c) ∈
          IsLocalRing.maximalIdeal V := by
        have := Ideal.mul_mem_left (IsLocalRing.maximalIdeal V) v_inv hprod_in_max
        rwa [← mul_assoc, hv_inv, one_mul] at this
      exact hξ c hξ_in
    have hb₀_max : ρ₀.hom b₀ ∈ IsLocalRing.maximalIdeal V := (hp₀_mem_iff b₀).mp hb₀_mem
    have hd_pos : 1 ≤ d := by
      rcases Nat.eq_zero_or_pos d with rfl | hpos
      · rw [pow_zero, mul_one] at hb₀_val
        rw [hb₀_val] at hb₀_max
        exact False.elim ((IsLocalRing.notMem_maximalIdeal.mpr u₀.isUnit) hb₀_max)
      · exact hpos
    have ha₀_mem : a₀ ∈ p₀.asIdeal := by
      rw [hp₀_mem_iff, ← hb₀_ξ]
      exact Ideal.mul_mem_right ξ (IsLocalRing.maximalIdeal V) hb₀_max
    have chart_drop : ∀ (R_i : CommRingCat.{u}) (ι_i : AlgebraicGeometry.Spec R_i ⟶ W')
        [AlgebraicGeometry.IsOpenImmersion ι_i]
        (φ_i : R₀ ⟶ R_i) (z_m z_o : R₀) (s_i : R_i) (α_m α_o β_m β_o : R₀),
        z_m ∈ p₀.asIdeal →
        α_m * z_m + α_o * z_o = a₀ →
        β_m * z_m + β_o * z_o = b₀ →
        φ_i.hom z_o = φ_i.hom z_m * s_i →
        ι_i ≫ π = AlgebraicGeometry.Spec.map φ_i ≫ ι₀ →
        v_W'.base m_V ∈ Set.range ι_i.base →
        ∃ d' < d, HasValBound V ϖ ξ v_W' d' := by
      intro R_i ι_i _ φ_i z_m z_o s_i α_m α_o β_m β_o hzm_mem ha₀_sp hb₀_sp hzo_eq hιi_π hmem_i
      obtain ⟨f_i, hf_i⟩ := lift_spec_local m_V hm_V ι_i v_W' hmem_i
      let ρ_i : R_i ⟶ CommRingCat.of V := AlgebraicGeometry.Spec.preimage f_i
      have hρi_fac : AlgebraicGeometry.Spec.map ρ_i ≫ ι_i = v_W' := by
        rw [AlgebraicGeometry.Spec.map_preimage, hf_i]
      have hφi_ρi : φ_i ≫ ρ_i = ρ₀ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp]
        apply (CategoryTheory.cancel_mono ι₀).mp
        rw [CategoryTheory.Category.assoc, ← hιi_π, ← CategoryTheory.Category.assoc,
          hρi_fac, hv_lift, hρ₀_fac]
      let a_i : R_i := φ_i.hom α_m + φ_i.hom α_o * s_i
      let b_i : R_i := φ_i.hom β_m + φ_i.hom β_o * s_i
      have ha_div : φ_i.hom z_m * a_i = φ_i.hom a₀ := by
        calc φ_i.hom z_m * (φ_i.hom α_m + φ_i.hom α_o * s_i)
            = φ_i.hom α_m * φ_i.hom z_m + φ_i.hom α_o * (φ_i.hom z_m * s_i) := by ring
          _ = φ_i.hom (α_m * z_m + α_o * z_o) := by rw [← hzo_eq, map_add, map_mul, map_mul]
          _ = φ_i.hom a₀ := by rw [ha₀_sp]
      have hb_div : φ_i.hom z_m * b_i = φ_i.hom b₀ := by
        calc φ_i.hom z_m * (φ_i.hom β_m + φ_i.hom β_o * s_i)
            = φ_i.hom β_m * φ_i.hom z_m + φ_i.hom β_o * (φ_i.hom z_m * s_i) := by ring
          _ = φ_i.hom (β_m * z_m + β_o * z_o) := by rw [← hzo_eq, map_add, map_mul, map_mul]
          _ = φ_i.hom b₀ := by rw [hb₀_sp]
      have h_ρ_b : ρ₀.hom z_m * ρ_i.hom b_i = ρ₀.hom b₀ := by
        calc ρ₀.hom z_m * ρ_i.hom b_i
            = ρ_i.hom (φ_i.hom z_m * b_i) := by
                rw [map_mul, ← hφi_ρi]; rfl
          _ = ρ₀.hom b₀ := by rw [hb_div, ← hφi_ρi]; rfl
      have h_ρ_a : ρ₀.hom z_m * ρ_i.hom a_i = ρ₀.hom a₀ := by
        calc ρ₀.hom z_m * ρ_i.hom a_i
            = ρ_i.hom (φ_i.hom z_m * a_i) := by
                rw [map_mul, ← hφi_ρi]; rfl
          _ = ρ₀.hom a₀ := by rw [ha_div, ← hφi_ρi]; rfl
      have hb₀V_ne : ρ₀.hom b₀ ≠ 0 := by
        rw [hb₀_val]
        exact mul_ne_zero u₀.ne_zero (pow_ne_zero d hϖ.ne_zero)
      have hzmV_ne : ρ₀.hom z_m ≠ 0 := left_ne_zero_of_mul (h_ρ_b.trans_ne hb₀V_ne)
      have hbiV_ne : ρ_i.hom b_i ≠ 0 := right_ne_zero_of_mul (h_ρ_b.trans_ne hb₀V_ne)
      obtain ⟨u_z, e, hzm_val⟩ := dvr_unit_mul_pow hϖ hzmV_ne
      have hzm_max : ρ₀.hom z_m ∈ IsLocalRing.maximalIdeal V := (hp₀_mem_iff z_m).mp hzm_mem
      have he_pos : 1 ≤ e := by
        rcases Nat.eq_zero_or_pos e with rfl | hpos
        · rw [pow_zero, mul_one] at hzm_val
          rw [hzm_val] at hzm_max
          exact False.elim ((IsLocalRing.notMem_maximalIdeal.mpr u_z.isUnit) hzm_max)
        · exact hpos
      obtain ⟨u_i, d', hbi_val⟩ := dvr_unit_mul_pow hϖ hbiV_ne
      have hd_eq : d = e + d' := by
        apply IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ u₀ (u_z * u_i) d (e + d')
        calc (u₀ : V) * ϖ ^ d
            = ρ₀.hom b₀ := hb₀_val.symm
          _ = ρ₀.hom z_m * ρ_i.hom b_i := h_ρ_b.symm
          _ = ((u_z : V) * ϖ ^ e) * ((u_i : V) * ϖ ^ d') := by rw [hzm_val, hbi_val]
          _ = ((u_z * u_i : Vˣ) : V) * ϖ ^ (e + d') := by push_cast; rw [pow_add]; ring
      have hbi_ξ : ρ_i.hom b_i * ξ = ρ_i.hom a_i := by
        apply mul_left_cancel₀ hzmV_ne
        calc ρ₀.hom z_m * (ρ_i.hom b_i * ξ)
            = (ρ₀.hom z_m * ρ_i.hom b_i) * ξ := by ring
          _ = ρ₀.hom b₀ * ξ := by rw [h_ρ_b]
          _ = ρ₀.hom a₀ := hb₀_ξ
          _ = ρ₀.hom z_m * ρ_i.hom a_i := h_ρ_a.symm
      exact ⟨d', by omega, R_i, ι_i, ρ_i, a_i, b_i, u_i, inferInstance, hρi_fac, hbi_val, hbi_ξ⟩
    rw [hp₀_span] at ha₀_mem hb₀_mem
    obtain ⟨α₁, α₂, ha₀_pair⟩ := Ideal.mem_span_pair.mp ha₀_mem
    obtain ⟨β₁, β₂, hb₀_pair⟩ := Ideal.mem_span_pair.mp hb₀_mem
    have hv'_cov : v_W'.base m_V ∈ Set.range ι₁.base ∪ Set.range ι₂.base := by
      rw [← hπ_cov]
      change (v_W' ≫ π).base m_V ∈ Set.range ι₀.base
      rw [hv_lift]
      exact ⟨p₀, hp₀_w₀.trans hv_center.symm⟩
    refine ⟨hd_pos, ?_⟩
    rcases hv'_cov with h_in1 | h_in2
    · exact chart_drop R₁ ι₁ φ₁ z₁ z₂ s₁ α₁ α₂ β₁ β₂
        (hp₀_span ▸ Ideal.subset_span (by simp))
        ha₀_pair hb₀_pair hz₂_eq hι₁_π h_in1
    · exact chart_drop R₂ ι₂ φ₂ z₂ z₁ s₂ α₂ α₁ β₂ β₁
        (hp₀_span ▸ Ideal.subset_span (by simp))
        (by rw [add_comm]; exact ha₀_pair)
        (by rw [add_comm]; exact hb₀_pair)
        hz₁_eq hι₂_π h_in2

  
  
  
  have hInit0 : ∃ (W_seq₀ : Fin 1 → AlgebraicGeometry.Scheme.{u})
      (g_seq₀ : ∀ i : Fin 1, W_seq₀ i ⟶ S)
      (τ_seq₀ : ∀ i : Fin 1, Fin n → (S ⟶ W_seq₀ i))
      (centers₀ : ∀ i : Fin 0, ↥(CategoryTheory.Limits.pullback (g_seq₀ i.castSucc) s_Ω))
      (maps₀ : ∀ i : Fin 0, W_seq₀ i.succ ⟶ W_seq₀ i.castSucc)
      (π_from₀ : ∀ i : Fin 1, W_seq₀ i ⟶ C₁)
      (α₀ : CategoryTheory.Limits.pullback (g_seq₀ (Fin.last 0)) η_K ≅
        CategoryTheory.Limits.pullback g₂ η_K),
      IsTowerIso 0 W_seq₀ g_seq₀ τ_seq₀ centers₀ maps₀ π_from₀ α₀ := by
    refine ⟨fun _ => C₁, fun _ => g₁, fun _ => τ₁, Fin.elim0, Fin.elim0, fun _ => 𝟙 C₁, ψ_K,
      ⟨hNC₁, inferInstance, CategoryTheory.Category.id_comp g₁,
        fun j => CategoryTheory.Category.comp_id (τ₁ j),
        fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩,
      hψK_snd, ?_, hψK_sec⟩
    simp

  have hSnoc : ∀ (k : ℕ)
      (W_seq : Fin (k + 1) → AlgebraicGeometry.Scheme.{u})
      (g_seq : ∀ i : Fin (k + 1), W_seq i ⟶ S)
      (τ_seq : ∀ i : Fin (k + 1), Fin n → (S ⟶ W_seq i))
      (centers : ∀ i : Fin k, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω))
      (maps : ∀ i : Fin k, W_seq i.succ ⟶ W_seq i.castSucc)
      (π_from : ∀ i : Fin (k + 1), W_seq i ⟶ C₁)
      (α_k : CategoryTheory.Limits.pullback (g_seq (Fin.last k)) η_K ≅
        CategoryTheory.Limits.pullback g₂ η_K)
      (W' : AlgebraicGeometry.Scheme.{u})
      (g_W' : W' ⟶ S)
      (τ_W' : Fin n → (S ⟶ W'))
      (q₀ : ↥(CategoryTheory.Limits.pullback (g_seq (Fin.last k)) s_Ω))
      (π : W' ⟶ W_seq (Fin.last k)),
      IsTowerIso k W_seq g_seq τ_seq centers maps π_from α_k →
      IsNC2DClosedPointBlowup Ω n (g_seq (Fin.last k)) (τ_seq (Fin.last k)) g_W' τ_W' q₀ π →
      ∃ (W_seq' : Fin (k + 2) → AlgebraicGeometry.Scheme.{u})
        (g_seq' : ∀ i : Fin (k + 2), W_seq' i ⟶ S)
        (τ_seq' : ∀ i : Fin (k + 2), Fin n → (S ⟶ W_seq' i))
        (centers' : ∀ i : Fin (k + 1), ↥(CategoryTheory.Limits.pullback (g_seq' i.castSucc) s_Ω))
        (maps' : ∀ i : Fin (k + 1), W_seq' i.succ ⟶ W_seq' i.castSucc)
        (π_from' : ∀ i : Fin (k + 2), W_seq' i ⟶ C₁)
        (α_next : CategoryTheory.Limits.pullback (g_seq' (Fin.last (k + 1))) η_K ≅
          CategoryTheory.Limits.pullback g₂ η_K)
        (e_top : W_seq' (Fin.last (k + 1)) ≅ W'),
        IsTowerIso (k + 1) W_seq' g_seq' τ_seq' centers' maps' π_from' α_next ∧
        IsNC2DPointedSurface Ω n (g_seq' (Fin.last (k + 1))) (τ_seq' (Fin.last (k + 1))) ∧
        e_top.hom ≫ g_W' = g_seq' (Fin.last (k + 1)) ∧
        AlgebraicGeometry.IsProper (e_top.hom ≫ π) ∧
        (e_top.hom ≫ π) ≫ g_seq (Fin.last k) = g_seq' (Fin.last (k + 1)) ∧
        CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K ≫ (e_top.hom ≫ π) =
          (α_next.hom ≫ α_k.inv) ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K := by
    intro k W_seq g_seq τ_seq centers maps π_from α_k W' g_W' τ_W' q₀ π hT hBlow
    let Bundle := Σ W : AlgebraicGeometry.Scheme.{u}, (W ⟶ S) × (Fin n → (S ⟶ W)) × (W ⟶ C₁)
    let B_seq : Fin (k + 1) → Bundle := fun i => ⟨W_seq i, g_seq i, τ_seq i, π_from i⟩
    let B_top : Bundle := ⟨W', g_W', τ_W', π ≫ π_from (Fin.last k)⟩
    let B_seq' : Fin (k + 2) → Bundle := Fin.lastCases B_top B_seq
    let W_seq' : Fin (k + 2) → AlgebraicGeometry.Scheme.{u} := fun i => (B_seq' i).1
    let g_seq' : ∀ i : Fin (k + 2), W_seq' i ⟶ S := fun i => (B_seq' i).2.1
    let τ_seq' : ∀ i : Fin (k + 2), Fin n → (S ⟶ W_seq' i) := fun i => (B_seq' i).2.2.1
    let π_from' : ∀ i : Fin (k + 2), W_seq' i ⟶ C₁ := fun i => (B_seq' i).2.2.2
    have h_last : B_seq' (Fin.last (k + 1)) = B_top := Fin.lastCases_last
    have h_cast : ∀ i : Fin (k + 1), B_seq' i.castSucc = B_seq i :=
      fun i => Fin.lastCases_castSucc i
    have h_zero : B_seq' 0 = B_seq 0 := by
      rw [← Fin.castSucc_zero]
      exact h_cast 0
    have mk_zero_props : ∀ (b₀ c₀ : Bundle), b₀ = c₀ →
        IsNC2DPointedSurface Ω n c₀.2.1 c₀.2.2.1 →
        CategoryTheory.IsIso c₀.2.2.2 →
        c₀.2.2.2 ≫ g₁ = c₀.2.1 →
        (∀ j : Fin n, c₀.2.2.1 j ≫ c₀.2.2.2 = τ₁ j) →
        IsNC2DPointedSurface Ω n b₀.2.1 b₀.2.2.1 ∧
        CategoryTheory.IsIso b₀.2.2.2 ∧
        b₀.2.2.2 ≫ g₁ = b₀.2.1 ∧
        (∀ j : Fin n, b₀.2.2.1 j ≫ b₀.2.2.2 = τ₁ j) := by
      rintro b₀ _ rfl h1 h2 h3 h4
      exact ⟨h1, h2, h3, h4⟩
    have mk_surf_top : ∀ (b c : Bundle), b = c →
        IsNC2DPointedSurface Ω n c.2.1 c.2.2.1 →
        IsNC2DPointedSurface Ω n b.2.1 b.2.2.1 := by
      rintro b _ rfl h; exact h
    have mk_eq_top : ∀ (b c : Bundle) (h : b = c),
        (eqToIso (congrArg Sigma.fst h)).hom ≫ c.2.1 = b.2.1 ∧
        (eqToIso (congrArg Sigma.fst h)).hom ≫ c.2.2.2 = b.2.2.2 ∧
        ∀ j : Fin n, b.2.2.1 j ≫ (eqToIso (congrArg Sigma.fst h)).hom = c.2.2.1 j := by
      rintro b _ rfl
      simp
    have mk_step_props : ∀ (b_lo b_hi c_lo c_hi : Bundle)
        (h_lo : b_lo = c_lo) (h_hi : b_hi = c_hi)
        (q : ↥(CategoryTheory.Limits.pullback c_lo.2.1 s_Ω))
        (m : c_hi.1 ⟶ c_lo.1),
        m ≫ c_lo.2.2.2 = c_hi.2.2.2 →
        IsNC2DClosedPointBlowup Ω n c_lo.2.1 c_lo.2.2.1 c_hi.2.1 c_hi.2.2.1 q m →
        let q' : ↥(CategoryTheory.Limits.pullback b_lo.2.1 s_Ω) :=
          (congrArg (fun x : Bundle => ↥(CategoryTheory.Limits.pullback x.2.1 s_Ω)) h_lo).mpr q
        let m' : b_hi.1 ⟶ b_lo.1 :=
          eqToHom (congrArg Sigma.fst h_hi) ≫ m ≫ eqToHom (congrArg Sigma.fst h_lo).symm
        m' ≫ b_lo.2.2.2 = b_hi.2.2.2 ∧
        IsNC2DClosedPointBlowup Ω n b_lo.2.1 b_lo.2.2.1 b_hi.2.1 b_hi.2.2.1 q' m' := by
      rintro b_lo b_hi _ _ rfl rfl q m hm hb
      dsimp only [eq_mp_eq_cast, eq_mpr_eq_cast, cast_eq]
      rw [CategoryTheory.eqToHom_refl, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      exact ⟨hm, hb⟩
    let centers' : ∀ i : Fin (k + 1), ↥(CategoryTheory.Limits.pullback (g_seq' i.castSucc) s_Ω) :=
      Fin.lastCases
        ((congrArg (fun x : Bundle => ↥(CategoryTheory.Limits.pullback x.2.1 s_Ω))
          (h_cast (Fin.last k))).mpr q₀)
        (fun j => (congrArg (fun x : Bundle => ↥(CategoryTheory.Limits.pullback x.2.1 s_Ω))
          (h_cast j.castSucc)).mpr (centers j))
    have h_succ_last : B_seq' (Fin.last k).succ = B_top := by
      rw [Fin.succ_last]; exact h_last
    have h_succ_cast : ∀ j : Fin k, B_seq' j.castSucc.succ = B_seq j.succ := by
      intro j; rw [← Fin.castSucc_succ]; exact h_cast j.succ
    let maps' : ∀ i : Fin (k + 1), W_seq' i.succ ⟶ W_seq' i.castSucc :=
      Fin.lastCases
        (eqToHom (congrArg Sigma.fst h_succ_last) ≫ π ≫
          eqToHom (congrArg Sigma.fst (h_cast (Fin.last k))).symm)
        (fun j => eqToHom (congrArg Sigma.fst (h_succ_cast j)) ≫ maps j ≫
          eqToHom (congrArg Sigma.fst (h_cast j.castSucc)).symm)
    obtain ⟨hT_0, hT_iso0, hT_g0, hT_sec0⟩ :=
      mk_zero_props (B_seq' 0) (B_seq 0) h_zero hT.1.1 hT.1.2.1 hT.1.2.2.1 hT.1.2.2.2.1
    have hSteps' : ∀ i : Fin (k + 1),
        maps' i ≫ π_from' i.castSucc = π_from' i.succ ∧
        IsNC2DClosedPointBlowup Ω n (g_seq' i.castSucc) (τ_seq' i.castSucc)
          (g_seq' i.succ) (τ_seq' i.succ) (centers' i) (maps' i) := by
      refine Fin.lastCases ?_ ?_
      · dsimp only [centers', maps']
        rw [Fin.lastCases_last, Fin.lastCases_last]
        exact mk_step_props (B_seq' (Fin.last k).castSucc) (B_seq' (Fin.last k).succ)
          (B_seq (Fin.last k)) B_top (h_cast (Fin.last k)) h_succ_last q₀ π rfl hBlow
      · intro j
        dsimp only [centers', maps']
        rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc]
        exact mk_step_props (B_seq' j.castSucc.castSucc) (B_seq' j.castSucc.succ)
          (B_seq j.castSucc) (B_seq j.succ) (h_cast j.castSucc) (h_succ_cast j)
          (centers j) (maps j) (hT.1.2.2.2.2.1 j) (hT.1.2.2.2.2.2 j)
    let e_top : W_seq' (Fin.last (k + 1)) ≅ W' := eqToIso (congrArg Sigma.fst h_last)
    obtain ⟨he_g_raw, he_π_raw, he_τ_raw⟩ := mk_eq_top (B_seq' (Fin.last (k + 1))) B_top h_last
    have he_g : e_top.hom ≫ g_W' = g_seq' (Fin.last (k + 1)) := he_g_raw
    have he_π : e_top.hom ≫ (π ≫ π_from (Fin.last k)) = π_from' (Fin.last (k + 1)) := he_π_raw
    have he_τ : ∀ j : Fin n, τ_seq' (Fin.last (k + 1)) j ≫ e_top.hom = τ_W' j := he_τ_raw
    have hSurf_top : IsNC2DPointedSurface Ω n
        (g_seq' (Fin.last (k + 1))) (τ_seq' (Fin.last (k + 1))) :=
      mk_surf_top (B_seq' (Fin.last (k + 1))) B_top h_last hBlow.2.1
    have hπ_g : π ≫ g_seq (Fin.last k) = g_W' := hBlow.2.2.1
    have hProp_π : AlgebraicGeometry.IsProper π := hBlow.2.2.2.2.1
    have : AlgebraicGeometry.IsProper π := hProp_π
    have hProp_eπ : AlgebraicGeometry.IsProper (e_top.hom ≫ π) := inferInstance
    have heπ_g : (e_top.hom ≫ π) ≫ g_seq (Fin.last k) = g_seq' (Fin.last (k + 1)) := by
      rw [CategoryTheory.Category.assoc, hπ_g, he_g]
    let u_top_hom : CategoryTheory.Limits.pullback (g_seq' (Fin.last (k + 1))) η_K ⟶
        CategoryTheory.Limits.pullback g_W' η_K :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K ≫ e_top.hom)
        (CategoryTheory.Limits.pullback.snd (g_seq' (Fin.last (k + 1))) η_K)
        (by rw [CategoryTheory.Category.assoc, he_g, CategoryTheory.Limits.pullback.condition])
    let u_top_inv : CategoryTheory.Limits.pullback g_W' η_K ⟶
        CategoryTheory.Limits.pullback (g_seq' (Fin.last (k + 1))) η_K :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_W' η_K ≫ e_top.inv)
        (CategoryTheory.Limits.pullback.snd g_W' η_K)
        (by
          rw [CategoryTheory.Category.assoc]
          have : e_top.inv ≫ g_seq' (Fin.last (k + 1)) = g_W' := by
            rw [← he_g, e_top.inv_hom_id_assoc]
          rw [this, CategoryTheory.Limits.pullback.condition])
    let u_top : CategoryTheory.Limits.pullback (g_seq' (Fin.last (k + 1))) η_K ≅
        CategoryTheory.Limits.pullback g_W' η_K :=
      { hom := u_top_hom
        inv := u_top_inv
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, e_top.hom_inv_id, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, e_top.inv_hom_id, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp] }
    let v_K : CategoryTheory.Limits.pullback g_W' η_K ⟶
        CategoryTheory.Limits.pullback (g_seq (Fin.last k)) η_K :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_W' η_K ≫ π)
        (CategoryTheory.Limits.pullback.snd g_W' η_K)
        (by rw [CategoryTheory.Category.assoc, hπ_g, CategoryTheory.Limits.pullback.condition])
    have : CategoryTheory.IsIso v_K :=
      hBlow.2.2.2.2.2.2.1 v_K
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    let α_next : CategoryTheory.Limits.pullback (g_seq' (Fin.last (k + 1))) η_K ≅
        CategoryTheory.Limits.pullback g₂ η_K :=
      u_top ≪≫ CategoryTheory.asIso v_K ≪≫ α_k
    have hα_snd : α_next.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
        CategoryTheory.Limits.pullback.snd (g_seq' (Fin.last (k + 1))) η_K := by
      calc α_next.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K
          = u_top_hom ≫ v_K ≫ (α_k.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K) := by
              simp [α_next, u_top, CategoryTheory.Category.assoc]
        _ = u_top_hom ≫ (v_K ≫ CategoryTheory.Limits.pullback.snd (g_seq (Fin.last k)) η_K) := by
              rw [hT.2.1]
        _ = CategoryTheory.Limits.pullback.snd (g_seq' (Fin.last (k + 1))) η_K := by
              rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    have hu_top_fst : u_top_hom ≫ CategoryTheory.Limits.pullback.fst g_W' η_K =
        CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K ≫ e_top.hom :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hv_K_fst : v_K ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K =
        CategoryTheory.Limits.pullback.fst g_W' η_K ≫ π :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hα_rel : CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K ≫
        (e_top.hom ≫ π) =
        (α_next.hom ≫ α_k.inv) ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K := by
      calc CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K ≫ (e_top.hom ≫ π)
          = (CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K ≫ e_top.hom) ≫ π := by
              rw [CategoryTheory.Category.assoc]
        _ = (u_top_hom ≫ CategoryTheory.Limits.pullback.fst g_W' η_K) ≫ π := by
              rw [← hu_top_fst]
        _ = u_top_hom ≫ (v_K ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K) := by
              rw [CategoryTheory.Category.assoc, ← hv_K_fst]
        _ = (α_next.hom ≫ α_k.inv) ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K := by
              simp [α_next, u_top, CategoryTheory.Category.assoc]
    have hα_fst : CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K ≫
        π_from' (Fin.last (k + 1)) =
        (α_next.hom ≫ ψ_K.inv) ≫ CategoryTheory.Limits.pullback.fst g₁ η_K := by
      have hπ_top : π_from' (Fin.last (k + 1)) = (e_top.hom ≫ π) ≫ π_from (Fin.last k) := by
        rw [CategoryTheory.Category.assoc]; exact he_π.symm
      rw [hπ_top, ← CategoryTheory.Category.assoc, hα_rel, CategoryTheory.Category.assoc,
        hT.2.2.1]
      simp [CategoryTheory.Category.assoc]
    have hα_sec : ∀ j : Fin n,
        ∀ (s₁ : AlgebraicGeometry.Spec (CommRingCat.of KStar) ⟶
            CategoryTheory.Limits.pullback (g_seq' (Fin.last (k + 1))) η_K),
          s₁ ≫ CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K =
            η_K ≫ τ_seq' (Fin.last (k + 1)) j →
          s₁ ≫ CategoryTheory.Limits.pullback.snd (g_seq' (Fin.last (k + 1))) η_K =
            𝟙 (AlgebraicGeometry.Spec (CommRingCat.of KStar)) →
          (s₁ ≫ α_next.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ η_K = η_K ≫ τ₂ j := by
      intro j s₁ hs₁_fst hs₁_snd
      let s_prev := s₁ ≫ u_top.hom ≫ v_K
      have hs_prev_fst : s_prev ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K =
          η_K ≫ τ_seq (Fin.last k) j := by
        calc s_prev ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K
            = s₁ ≫ u_top_hom ≫ (v_K ≫ CategoryTheory.Limits.pullback.fst (g_seq (Fin.last k)) η_K) := by
                simp [s_prev, u_top, CategoryTheory.Category.assoc]
          _ = s₁ ≫ (u_top_hom ≫ CategoryTheory.Limits.pullback.fst g_W' η_K) ≫ π := by
                rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
          _ = (s₁ ≫ CategoryTheory.Limits.pullback.fst (g_seq' (Fin.last (k + 1))) η_K) ≫
                e_top.hom ≫ π := by
                rw [CategoryTheory.Limits.pullback.lift_fst]; simp [CategoryTheory.Category.assoc]
          _ = η_K ≫ (τ_seq' (Fin.last (k + 1)) j ≫ e_top.hom) ≫ π := by
                rw [hs₁_fst]; simp [CategoryTheory.Category.assoc]
          _ = η_K ≫ τ_seq (Fin.last k) j := by
                rw [he_τ j, hBlow.2.2.2.1 j]
      have hs_prev_snd : s_prev ≫ CategoryTheory.Limits.pullback.snd (g_seq (Fin.last k)) η_K =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of KStar)) := by
        dsimp [s_prev, u_top, u_top_hom, v_K]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd, hs₁_snd]
      have := hT.2.2.2 j s_prev hs_prev_fst hs_prev_snd
      simpa [s_prev, α_next, CategoryTheory.Category.assoc] using this
    exact ⟨W_seq', g_seq', τ_seq', centers', maps', π_from', α_next, e_top,
      ⟨⟨hT_0, hT_iso0, hT_g0, hT_sec0, fun i => (hSteps' i).1, fun i => (hSteps' i).2⟩,
        hα_snd, hα_fst, hα_sec⟩,
      hSurf_top, he_g, hProp_eπ, heπ_g, hα_rel⟩

  
  
  
  let EliminatesOn : Finset (Set ↥C₂_0) →
      ∀ (k : ℕ)
        (W_seq : Fin (k + 1) → AlgebraicGeometry.Scheme.{u})
        (g_seq : ∀ i : Fin (k + 1), W_seq i ⟶ S)
        (_τ_seq : ∀ i : Fin (k + 1), Fin n → (S ⟶ W_seq i))
        (_centers : ∀ i : Fin k, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω))
        (_maps : ∀ i : Fin k, W_seq i.succ ⟶ W_seq i.castSucc)
        (_π_from : ∀ i : Fin (k + 1), W_seq i ⟶ C₁)
        (_α_k : CategoryTheory.Limits.pullback (g_seq (Fin.last k)) η_K ≅
          CategoryTheory.Limits.pullback g₂ η_K), Prop :=
    fun S_done k W_seq g_seq τ_seq centers maps π_from α_k =>
      IsTowerIso k W_seq g_seq τ_seq centers maps π_from α_k ∧
      ∀ F'' ∈ S_done,
        ∃ (V : Type u) (_ : CommRing V) (_ : IsDomain V) (_ : IsDiscreteValuationRing V)
          (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
          (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
            CategoryTheory.Limits.pullback g₂ η_K)
          (ξ : V)
          (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W_seq (Fin.last k))
          (q_W : ↥(CategoryTheory.Limits.pullback (g_seq (Fin.last k)) s_Ω)),
          IsCompDVR F'' V v_Y u_Y ξ ∧
          IsDVRCenter (g_seq (Fin.last k)) α_k V v_Y u_Y v_W q_W ∧
          ¬ IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback (g_seq (Fin.last k)) s_Ω))

  letI : DecidableEq (Set ↥C₂_0) := Classical.decEq _
  have hElimOne : ∀ (S_done : Finset (Set ↥C₂_0))
      (F' : Set ↥C₂_0)
      (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
      (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
      (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
        CategoryTheory.Limits.pullback g₂ η_K)
      (ξ ϖ : V),
      IsCompDVR F' V v_Y u_Y ξ →
      Irreducible ϖ →
      ∀ (d : ℕ) (k : ℕ)
        (W_seq : Fin (k + 1) → AlgebraicGeometry.Scheme.{u})
        (g_seq : ∀ i : Fin (k + 1), W_seq i ⟶ S)
        (τ_seq : ∀ i : Fin (k + 1), Fin n → (S ⟶ W_seq i))
        (centers : ∀ i : Fin k, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω))
        (maps : ∀ i : Fin k, W_seq i.succ ⟶ W_seq i.castSucc)
        (π_from : ∀ i : Fin (k + 1), W_seq i ⟶ C₁)
        (α_k : CategoryTheory.Limits.pullback (g_seq (Fin.last k)) η_K ≅
          CategoryTheory.Limits.pullback g₂ η_K)
        (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W_seq (Fin.last k))
        (q_W : ↥(CategoryTheory.Limits.pullback (g_seq (Fin.last k)) s_Ω)),
        EliminatesOn S_done k W_seq g_seq τ_seq centers maps π_from α_k →
        IsDVRCenter (g_seq (Fin.last k)) α_k V v_Y u_Y v_W q_W →
        HasValBound V ϖ ξ v_W d →
        ∃ (N : ℕ)
          (W_seq_N : Fin (N + 1) → AlgebraicGeometry.Scheme.{u})
          (g_seq_N : ∀ i : Fin (N + 1), W_seq_N i ⟶ S)
          (τ_seq_N : ∀ i : Fin (N + 1), Fin n → (S ⟶ W_seq_N i))
          (centers_N : ∀ i : Fin N, ↥(CategoryTheory.Limits.pullback (g_seq_N i.castSucc) s_Ω))
          (maps_N : ∀ i : Fin N, W_seq_N i.succ ⟶ W_seq_N i.castSucc)
          (π_from_N : ∀ i : Fin (N + 1), W_seq_N i ⟶ C₁)
          (α_N : CategoryTheory.Limits.pullback (g_seq_N (Fin.last N)) η_K ≅
            CategoryTheory.Limits.pullback g₂ η_K),
          EliminatesOn (insert F' S_done) N W_seq_N g_seq_N τ_seq_N centers_N maps_N π_from_N α_N := by
    intro S_done F' V _ _ _ v_Y u_Y ξ ϖ hData hϖ d
    refine Nat.strongRecOn d fun d ih => ?_
    intro k W_seq g_seq τ_seq centers maps π_from α_k v_W q_W hElim hCent hBound
    by_cases hCl : IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback (g_seq (Fin.last k)) s_Ω))
    · have hSurf_k : IsNC2DPointedSurface Ω n (g_seq (Fin.last k)) (τ_seq (Fin.last k)) :=
        Fin.cases hElim.1.1.1 (fun j => (hElim.1.1.2.2.2.2.2 j).2.1) (Fin.last k)
      obtain ⟨W', g_W', τ_W', π, hBlow⟩ :=
        hBlowup (W_seq (Fin.last k)) (g_seq (Fin.last k)) (τ_seq (Fin.last k)) q_W hSurf_k hCl
      obtain ⟨W_seq', g_seq', τ_seq', centers', maps', π_from', α_next, e_top,
          hT_next, hSurf_next, _he_g, hProp_eπ, heπ_g, hα_rel⟩ :=
        hSnoc k W_seq g_seq τ_seq centers maps π_from α_k W' g_W' τ_W' q_W π hElim.1 hBlow
      have hα_next_snd := hT_next.2.1
      have hElim_next : EliminatesOn S_done (k + 1)
          W_seq' g_seq' τ_seq' centers' maps' π_from' α_next := by
        refine ⟨hT_next, ?_⟩
        intro F'' hF''
        obtain ⟨V'', instCR'', instDom'', instDVR'', v_Y'', u_Y'', ξ'', v_W'', q_W'',
            hData'', hCent'', hNotCl''⟩ := hElim.2 F'' hF''
        letI : CommRing V'' := instCR''
        have : IsDomain V'' := instDom''
        have : IsDiscreteValuationRing V'' := instDVR''
        obtain ⟨v_next'', q_next'', hCent_next'', _⟩ :=
          hCenterInit (g_seq' (Fin.last (k + 1))) (τ_seq' (Fin.last (k + 1)))
            α_next F'' V'' v_Y'' u_Y'' ξ'' hSurf_next hα_next_snd hData''
        have hNotCl_next'' :
            ¬ IsClosed ({q_next''} : Set ↥(CategoryTheory.Limits.pullback
              (g_seq' (Fin.last (k + 1))) s_Ω)) :=
          (hProperPres (g_seq (Fin.last k)) (g_seq' (Fin.last (k + 1)))
            α_k α_next (e_top.hom ≫ π) V'' v_Y'' u_Y'' v_W'' q_W'' v_next'' q_next''
            hSurf_k.2.2.1 hProp_eπ heπ_g hα_rel hCent'' hCent_next'').2 hNotCl''
        exact ⟨V'', instCR'', instDom'', instDVR'', v_Y'', u_Y'', ξ'',
          v_next'', q_next'', hData'', hCent_next'', hNotCl_next''⟩
      obtain ⟨v_next, q_next, hCent_next, _⟩ :=
        hCenterInit (g_seq' (Fin.last (k + 1))) (τ_seq' (Fin.last (k + 1)))
          α_next F' V v_Y u_Y ξ hSurf_next hα_next_snd hData
      have hv_comp : v_next ≫ (e_top.hom ≫ π) = v_W :=
        (hProperPres (g_seq (Fin.last k)) (g_seq' (Fin.last (k + 1)))
          α_k α_next (e_top.hom ≫ π) V v_Y u_Y v_W q_W v_next q_next
          hSurf_k.2.2.1 hProp_eπ heπ_g hα_rel hCent hCent_next).1
      obtain ⟨_, hvW_base, m_V, hm_V, hvW_center⟩ := hCent
      have hξ_W : ∀ c : Ω,
          ξ - (AlgebraicGeometry.Spec.preimage (v_W ≫ g_seq (Fin.last k))).hom (PowerSeries.C c) ∉
            IsLocalRing.maximalIdeal V := by
        intro c
        rw [hvW_base]
        exact hData.2.1 c
      obtain ⟨_, d', hd'_lt, hBound_W'⟩ :=
        hValDrop (g_seq (Fin.last k)) (τ_seq (Fin.last k)) g_W' τ_W' q_W π
          V ϖ ξ v_W (v_next ≫ e_top.hom) m_V d
          hBlow hϖ hm_V hvW_center
          (by rw [CategoryTheory.Category.assoc]; exact hv_comp)
          hξ_W hBound
      have hBound_next : HasValBound V ϖ ξ v_next d' := by
        obtain ⟨A', ι_A', ρ_A', a', b', u_b', hιA'_open, hρA'_fac, hb'_val, hb'_ξ⟩ := hBound_W'
        have : AlgebraicGeometry.IsOpenImmersion ι_A' := hιA'_open
        refine ⟨A', ι_A' ≫ e_top.inv, ρ_A', a', b', u_b', inferInstance, ?_, hb'_val, hb'_ξ⟩
        rw [← CategoryTheory.Category.assoc, hρA'_fac, CategoryTheory.Category.assoc,
          e_top.hom_inv_id, CategoryTheory.Category.comp_id]
      exact ih d' hd'_lt (k + 1) W_seq' g_seq' τ_seq' centers' maps' π_from' α_next
        v_next q_next hElim_next hCent_next hBound_next
    · refine ⟨k, W_seq, g_seq, τ_seq, centers, maps, π_from, α_k, hElim.1, ?_⟩
      intro F'' hF''
      rcases Finset.mem_insert.mp hF'' with rfl | h_in_S
      · exact ⟨V, inferInstance, inferInstance, inferInstance,
          v_Y, u_Y, ξ, v_W, q_W, hData, hCent, hCl⟩
      · exact hElim.2 F'' h_in_S

  have hElimSet : ∀ (S_fin : Finset (Set ↥C₂_0)),
      (↑S_fin : Set (Set ↥C₂_0)) ⊆ irreducibleComponents ↥C₂_0 →
      ∃ (N : ℕ)
        (W_seq : Fin (N + 1) → AlgebraicGeometry.Scheme.{u})
        (g_seq : ∀ i : Fin (N + 1), W_seq i ⟶ S)
        (τ_seq : ∀ i : Fin (N + 1), Fin n → (S ⟶ W_seq i))
        (centers : ∀ i : Fin N, ↥(CategoryTheory.Limits.pullback (g_seq i.castSucc) s_Ω))
        (maps : ∀ i : Fin N, W_seq i.succ ⟶ W_seq i.castSucc)
        (π_from : ∀ i : Fin (N + 1), W_seq i ⟶ C₁)
        (α_N : CategoryTheory.Limits.pullback (g_seq (Fin.last N)) η_K ≅
          CategoryTheory.Limits.pullback g₂ η_K),
        EliminatesOn S_fin N W_seq g_seq τ_seq centers maps π_from α_N := by
    intro S_fin
    refine Finset.induction_on S_fin ?_ ?_
    · intro _
      obtain ⟨W_seq₀, g_seq₀, τ_seq₀, centers₀, maps₀, π_from₀, α₀, h0⟩ := hInit0
      exact ⟨0, W_seq₀, g_seq₀, τ_seq₀, centers₀, maps₀, π_from₀, α₀,
        h0, fun _ hmem => False.elim (Finset.notMem_empty _ hmem)⟩
    · intro F' S_prev _hnot ih hsub
      have hF' : F' ∈ irreducibleComponents ↥C₂_0 :=
        hsub (Finset.mem_coe.mpr (Finset.mem_insert_self F' S_prev))
      have hsub_prev : (↑S_prev : Set (Set ↥C₂_0)) ⊆ irreducibleComponents ↥C₂_0 :=
        fun x hx => hsub (Finset.mem_coe.mpr (Finset.mem_insert_of_mem (Finset.mem_coe.mp hx)))
      obtain ⟨k, W_seq, g_seq, τ_seq, centers, maps, π_from, α_k, hElim_prev⟩ := ih hsub_prev
      obtain ⟨V, instCR, instDom, instDVR, v_Y, u_Y, ξ, hData⟩ := hCompDVR F' hF'
      letI : CommRing V := instCR
      have : IsDomain V := instDom
      have : IsDiscreteValuationRing V := instDVR
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible V
      have hSurf_k : IsNC2DPointedSurface Ω n (g_seq (Fin.last k)) (τ_seq (Fin.last k)) :=
        Fin.cases hElim_prev.1.1.1 (fun j => (hElim_prev.1.1.2.2.2.2.2 j).2.1) (Fin.last k)
      obtain ⟨v_W, q_W, hCent, hAllϖ⟩ :=
        hCenterInit (g_seq (Fin.last k)) (τ_seq (Fin.last k)) α_k F' V v_Y u_Y ξ
          hSurf_k hElim_prev.1.2.1 hData
      obtain ⟨d, hBound⟩ := hAllϖ ϖ hϖ
      exact hElimOne S_prev F' V v_Y u_Y ξ ϖ hData hϖ d k
        W_seq g_seq τ_seq centers maps π_from α_k v_W q_W hElim_prev hCent hBound

  obtain ⟨N, W_seq, g_seq, τ_seq, centers, maps, π_from, α_N, hElimAll⟩ :=
    hElimSet hFinComp.toFinset (by intro F' hF'; exact hFinComp.mem_toFinset.mp hF')
  have hSurf_N : IsNC2DPointedSurface Ω n (g_seq (Fin.last N)) (τ_seq (Fin.last N)) :=
    Fin.cases hElimAll.1.1.1 (fun j => (hElimAll.1.1.2.2.2.2.2 j).2.1) (Fin.last N)
  have hNonclosed_N : HasNonclosedComponentCenters Ω (g_seq (Fin.last N)) g₂ α_N :=
    hUnivBridge (g_seq (Fin.last N)) (τ_seq (Fin.last N)) α_N
      hSurf_N hElimAll.1.2.1 (fun F' hF' => hElimAll.2 F' (hFinComp.mem_toFinset.mpr hF'))
  exact ⟨N, W_seq, g_seq, τ_seq, centers, maps, π_from, α_N,
    hElimAll.1.1, hElimAll.1.2.1, hElimAll.1.2.2.1, hElimAll.1.2.2.2, hNonclosed_N⟩

theorem weil_nc2d_specialFiber_components_ncard_and_blowup_lt (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ) :
    let η_K := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    (∀ (Z : AlgebraicGeometry.Scheme.{u})
       (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z)),
       IsNC2DPointedSurface Ω n g_Z τ_Z →
       (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z s_Ω)).Finite ∧
       ∀ (F : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω))
         (q_F : ↥(CategoryTheory.Limits.pullback g_Z s_Ω)),
         F ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z s_Ω) →
         IsGenericPoint q_F F →
         ¬ IsClosed ({q_F} : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω))) ∧
    (∀ (W Y : AlgebraicGeometry.Scheme.{u})
       (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
       (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
       (α_K : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g_Y η_K)
       (h : W ⟶ Y),
       IsNC2DPointedSurface Ω n g_W τ_W →
       IsNC2DPointedSurface Ω n g_Y τ_Y →
       h ≫ g_Y = g_W →
       CategoryTheory.Limits.pullback.fst g_W η_K ≫ h =
         α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K →
       (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω)).ncard ≤
         (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_W s_Ω)).ncard) ∧
    (∀ (Y Y' : AlgebraicGeometry.Scheme.{u})
       (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
       (g_Y' : Y' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_Y' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y'))
       (q₀ : ↥(CategoryTheory.Limits.pullback g_Y s_Ω))
       (π : Y' ⟶ Y),
       IsNC2DPointedSurface Ω n g_Y τ_Y →
       IsNC2DClosedPointBlowup Ω n g_Y τ_Y g_Y' τ_Y' q₀ π →
       (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω)).ncard + 1 ≤
         (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y' s_Ω)).ncard) :=
by
  intro η_K s_Ω
  have hbot_prime : ∀ (D : Type u) [CommRing D] [IsDomain D], (⊥ : Ideal D).IsPrime := by
    intro D _ _
    refine ⟨fun htop => one_ne_zero (α := D) (Ideal.mem_bot.mp (htop ▸ Submodule.mem_top)), ?_⟩
    intro x y hxy
    simpa [Ideal.mem_bot] using hxy
  have hs_surj : Function.Surjective
      (ConcreteCategory.hom (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) :=
    fun c => ⟨PowerSeries.C c, by simp⟩
  have : AlgebraicGeometry.IsClosedImmersion s_Ω :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ hs_surj
  have hNoClosedGen : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_Z : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Z))
      (F : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω))
      (q_F : ↥(CategoryTheory.Limits.pullback g_Z s_Ω)),
      IsNC2DPointedSurface Ω n g_Z τ_Z →
      F ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z s_Ω) →
      IsGenericPoint q_F F →
      ¬ IsClosed ({q_F} : Set ↥(CategoryTheory.Limits.pullback g_Z s_Ω)) := by
    intro Z g_Z τ_Z F q_F hZ hF hGen hqF_cl
    let Z₀ := CategoryTheory.Limits.pullback g_Z s_Ω
    let fst₀ := CategoryTheory.Limits.pullback.fst g_Z s_Ω
    have hF_eq : F = ({q_F} : Set ↥Z₀) := by
      rw [← hGen.def, hqF_cl.closure_eq]
    obtain ⟨a, b, R₀, p₀, ι_U, z₁, z₂, A', v₀, e_U, u, v, ε,
        hOpen_ι, hp₀_eq, _, _, _, _, _, _, _, h_fib, hv₀_ideal, _, hreg, _, _, ha, hX⟩ :=
      hZ.2.2.2.2.2.2.2.2 q_F hqF_cl
    have he_v₀ : e_U.base v₀ = p₀ := by
      have hv_mem : v₀ ∈ e_U.base ⁻¹' ({p₀} : Set ↥(AlgebraicGeometry.Spec R₀)) := by
        rw [h_fib]; exact Set.mem_singleton v₀
      exact hv_mem
    have hu_v₀ : u ∈ v₀.asIdeal := by
      rw [hv₀_ideal]; exact Ideal.subset_span (by simp)
    have hv_v₀ : v ∈ v₀.asIdeal := by
      rw [hv₀_ideal]; exact Ideal.subset_span (by simp)
    have hreg_pow : ∀ (k : ℕ) (s : A'),
        s * v ^ k ∈ Ideal.span ({u} : Set A') → s ∈ Ideal.span ({u} : Set A') := by
      intro k
      induction k with
      | zero =>
        intro s hs
        simpa using hs
      | succ k ih =>
        intro s hs
        apply ih s
        apply hreg (s * v ^ k)
        have heq : v * (s * v ^ k) = s * v ^ (k + 1) := by ring
        rwa [heq]
    have : v₀.asIdeal.IsPrime := v₀.isPrime
    let L' := Localization.AtPrime v₀.asIdeal
    let u' : L' := algebraMap A' L' u
    let I_u' : Ideal L' := Ideal.span ({u'} : Set L')
    let φ : A' →+* (L' ⧸ I_u') := (Ideal.Quotient.mk I_u').comp (algebraMap A' L')
    have hv_not_nil : ¬ IsNilpotent (φ v) := by
      rintro ⟨k, hk⟩
      have hφvk : φ (v ^ k) = 0 := by
        simpa [map_pow] using hk
      have hmem_Iu' : algebraMap A' L' (v ^ k) ∈ I_u' :=
        Ideal.Quotient.eq_zero_iff_mem.mp hφvk
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hmem_Iu'
      obtain ⟨⟨r₁, s₁⟩, hws₁⟩ := IsLocalization.surj v₀.asIdeal.primeCompl w
      have halg_eq : algebraMap A' L' ((s₁ : A') * v ^ k) = algebraMap A' L' (u * r₁) := by
        calc algebraMap A' L' ((s₁ : A') * v ^ k)
            = algebraMap A' L' (s₁ : A') * algebraMap A' L' (v ^ k) := map_mul _ _ _
          _ = algebraMap A' L' (s₁ : A') * (u' * w) := by rw [hw]
          _ = u' * (w * algebraMap A' L' (s₁ : A')) := by ring
          _ = algebraMap A' L' u * algebraMap A' L' r₁ := by rw [hws₁]
          _ = algebraMap A' L' (u * r₁) := (map_mul _ _ _).symm
      obtain ⟨s₂, hs₂⟩ := (IsLocalization.eq_iff_exists v₀.asIdeal.primeCompl L').mp halg_eq
      have hmul_span : ((s₂ : A') * (s₁ : A')) * v ^ k ∈ Ideal.span ({u} : Set A') := by
        rw [Ideal.mem_span_singleton]
        refine ⟨(s₂ : A') * r₁, ?_⟩
        calc ((s₂ : A') * (s₁ : A')) * v ^ k
            = (s₂ : A') * ((s₁ : A') * v ^ k) := by ring
          _ = (s₂ : A') * (u * r₁) := hs₂
          _ = u * ((s₂ : A') * r₁) := by ring
      have hs₂s₁_span : (s₂ : A') * (s₁ : A') ∈ Ideal.span ({u} : Set A') :=
        hreg_pow k _ hmul_span
      have hs₂s₁_v₀ : (s₂ : A') * (s₁ : A') ∈ v₀.asIdeal :=
        (Ideal.span_singleton_le_iff_mem v₀.asIdeal).mpr hu_v₀ hs₂s₁_span
      exact (s₂ * s₁).2 hs₂s₁_v₀
    have hv_not_sInf : φ v ∉ sInf {J : Ideal (L' ⧸ I_u') | J.IsPrime} := by
      rw [← nilradical_eq_sInf]
      exact fun h => hv_not_nil (mem_nilradical.mp h)
    have hex_J : ∃ J : Ideal (L' ⧸ I_u'), J.IsPrime ∧ φ v ∉ J := by
      by_contra hAll
      apply hv_not_sInf
      rw [Submodule.mem_sInf]
      intro J hJ
      by_contra hvJ
      exact hAll ⟨J, hJ, hvJ⟩
    obtain ⟨J, hJ_prime, hv_not_J⟩ := hex_J
    have : J.IsPrime := hJ_prime
    let Q : Ideal A' := Ideal.comap φ J
    have hQ_prime : Q.IsPrime := Ideal.IsPrime.comap φ
    have hu_Q : u ∈ Q := by
      change Ideal.Quotient.mk I_u' u' ∈ J
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self u')]
      exact J.zero_mem
    have hv_not_Q : v ∉ Q := hv_not_J
    have hQ_le : Q ≤ v₀.asIdeal := by
      intro x hxQ
      by_contra hx_not
      have hu_L : IsUnit (algebraMap A' L' x) :=
        IsLocalization.map_units L' (⟨x, hx_not⟩ : v₀.asIdeal.primeCompl)
      have hu_φ : IsUnit (φ x) := hu_L.map (Ideal.Quotient.mk I_u')
      exact hJ_prime.ne_top (Ideal.eq_top_of_isUnit_mem J hxQ hu_φ)
    let q_pt : AlgebraicGeometry.Spec A' := ⟨Q, hQ_prime⟩
    have hX_Q : (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g_Z)).hom PowerSeries.X ∈ Q := by
      rw [hX]
      have hua_Q : u ^ a ∈ Q := by
        obtain ⟨a', rfl⟩ : ∃ a', a = a' + 1 := ⟨a - 1, (Nat.sub_add_cancel ha).symm⟩
        rw [pow_succ]
        exact Q.mul_mem_left _ hu_Q
      exact Q.mul_mem_right _ (Q.mul_mem_left _ hua_Q)
    let p₁ : AlgebraicGeometry.Spec R₀ := e_U.base q_pt
    have hp₁_le_p₀ : p₁.asIdeal ≤ p₀.asIdeal := by
      change (e_U.base q_pt).asIdeal ≤ p₀.asIdeal
      rw [← he_v₀, ← AlgebraicGeometry.Spec.map_preimage e_U]
      intro x hx
      exact hQ_le hx
    have hp₀_cl : p₀ ∈ closure ({p₁} : Set ↥(AlgebraicGeometry.Spec R₀)) :=
      (PrimeSpectrum.le_iff_mem_closure p₁ p₀).mp hp₁_le_p₀
    have hp₁_ne : p₁ ≠ p₀ := by
      intro heq
      have hq_mem : q_pt ∈ e_U.base ⁻¹' ({p₀} : Set ↥(AlgebraicGeometry.Spec R₀)) := heq
      rw [h_fib, Set.mem_singleton_iff] at hq_mem
      have hQ_eq : Q = v₀.asIdeal := congrArg PrimeSpectrum.asIdeal hq_mem
      exact hv_not_Q (hQ_eq ▸ hv_v₀)
    have : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_ι
    let z₁_pt : ↥Z := ι_U.base p₁
    have hz₁_ne : z₁_pt ≠ fst₀.base q_F := by
      rw [← hp₀_eq]
      exact fun h => hp₁_ne (ι_U.isOpenEmbedding.injective h)
    have hqF_cl_z₁ : fst₀.base q_F ∈ closure ({z₁_pt} : Set ↥Z) := by
      rw [← hp₀_eq]
      have hmem : ι_U.base p₀ ∈ ι_U.base '' closure ({p₁} : Set ↥(AlgebraicGeometry.Spec R₀)) :=
        ⟨p₀, hp₀_cl, rfl⟩
      have hsub := image_closure_subset_closure_image (f := ι_U.base) (s := {p₁}) ι_U.continuous
      simpa [z₁_pt] using hsub hmem
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, hbot_prime Ω⟩
    have hz₁_g : g_Z.base z₁_pt = s_Ω.base pt₀ := by
      have hX_mem : (PowerSeries.X : PowerSeries Ω) ∈ (g_Z.base z₁_pt).asIdeal := by
        have hcomp_eq : g_Z.base z₁_pt = (e_U ≫ ι_U ≫ g_Z).base q_pt := rfl
        rw [hcomp_eq, ← AlgebraicGeometry.Spec.map_preimage (e_U ≫ ι_U ≫ g_Z)]
        exact hX_Q
      apply PrimeSpectrum.ext
      ext f_ps
      change f_ps ∈ (g_Z.base z₁_pt).asIdeal ↔ PowerSeries.constantCoeff f_ps ∈ (⊥ : Ideal Ω)
      rw [Ideal.mem_bot]
      constructor
      · intro hf_in
        by_contra hc_ne
        have hu_ps : IsUnit f_ps :=
          PowerSeries.isUnit_iff_constantCoeff.mpr (IsUnit.mk0 _ hc_ne)
        exact (g_Z.base z₁_pt).isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem (g_Z.base z₁_pt).asIdeal hf_in hu_ps)
      · intro hc_eq
        obtain ⟨g_ps, rfl⟩ := PowerSeries.X_dvd_iff.mpr hc_eq
        exact (g_Z.base z₁_pt).asIdeal.mul_mem_right g_ps hX_mem
    obtain ⟨q₁, hq₁_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₁_pt pt₀ hz₁_g
    have hq₁_ne : q₁ ≠ q_F := by
      intro heq
      apply hz₁_ne
      rw [← heq]
      exact hq₁_fst.symm
    have hqF_in_cl : q_F ∈ closure ({q₁} : Set ↥Z₀) := by
      rw [fst₀.isClosedEmbedding.isEmbedding.closure_eq_preimage_closure_image]
      simpa [fst₀, Set.image_singleton, hq₁_fst] using hqF_cl_z₁
    have hF_sub_cl : F ⊆ closure ({q₁} : Set ↥Z₀) := by
      rw [hF_eq, Set.singleton_subset_iff]
      exact hqF_in_cl
    have hcl_sub_F : closure ({q₁} : Set ↥Z₀) ⊆ F :=
      hF.2 isIrreducible_singleton.closure hF_sub_cl
    have hq₁_in_F : q₁ ∈ F := hcl_sub_F (subset_closure (Set.mem_singleton q₁))
    rw [hF_eq, Set.mem_singleton_iff] at hq₁_in_F
    exact hq₁_ne hq₁_in_F
  have hFinComp : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))),
      AlgebraicGeometry.IsProper g_Z →
      (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z s_Ω)).Finite := by
    intro Z g_Z hgZ
    have : AlgebraicGeometry.IsProper g_Z := hgZ
    let Z₀ := CategoryTheory.Limits.pullback g_Z s_Ω
    let p₀ := CategoryTheory.Limits.pullback.snd g_Z s_Ω
    have : CompactSpace ↥Z₀ := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p₀
    have : AlgebraicGeometry.IsLocallyNoetherian Z₀ :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p₀
    have : AlgebraicGeometry.IsNoetherian Z₀ := AlgebraicGeometry.IsNoetherian.mk
    exact AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
  have hCompCover : ∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u})
      (g_Z₁ : Z₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (g_Z₂ : Z₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (f : Z₁ ⟶ Z₂)
      (f₀ : CategoryTheory.Limits.pullback g_Z₁ s_Ω ⟶
        CategoryTheory.Limits.pullback g_Z₂ s_Ω),
      AlgebraicGeometry.IsProper g_Z₁ →
      AlgebraicGeometry.IsProper f →
      AlgebraicGeometry.Surjective f →
      f ≫ g_Z₂ = g_Z₁ →
      f₀ ≫ CategoryTheory.Limits.pullback.fst g_Z₂ s_Ω =
        CategoryTheory.Limits.pullback.fst g_Z₁ s_Ω ≫ f →
      ∀ F ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z₂ s_Ω),
        ∃ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z₁ s_Ω),
          f₀.base '' E = F := by
    intro Z₁ Z₂ g_Z₁ g_Z₂ f f₀ hgZ₁ hf_prop hf_surj hf_comm hf₀_fst F hF
    have : AlgebraicGeometry.IsProper g_Z₁ := hgZ₁
    have : AlgebraicGeometry.IsProper f := hf_prop
    have : AlgebraicGeometry.Surjective f := hf_surj
    let fst₁ := CategoryTheory.Limits.pullback.fst g_Z₁ s_Ω
    let fst₂ := CategoryTheory.Limits.pullback.fst g_Z₂ s_Ω
    have : AlgebraicGeometry.IsProper (f₀ ≫ fst₂) := by
      rw [hf₀_fst]
      infer_instance
    have : AlgebraicGeometry.IsProper f₀ := AlgebraicGeometry.IsProper.of_comp f₀ fst₂
    have hf₀_closed : IsClosedMap ⇑f₀ := f₀.isClosedMap
    have hf₀_surj : Function.Surjective ⇑f₀ := by
      intro q₂
      obtain ⟨z₁, hz₁⟩ := f.surjective (fst₂.base q₂)
      have hz₁_eq : g_Z₁.base z₁ =
          s_Ω.base ((CategoryTheory.Limits.pullback.snd g_Z₂ s_Ω).base q₂) := by
        calc g_Z₁.base z₁
            = (f ≫ g_Z₂).base z₁ := by rw [hf_comm]
          _ = g_Z₂.base (fst₂.base q₂) := by change g_Z₂.base (f.base z₁) = _; rw [hz₁]
          _ = (fst₂ ≫ g_Z₂).base q₂ := rfl
          _ = (CategoryTheory.Limits.pullback.snd g_Z₂ s_Ω ≫ s_Ω).base q₂ := by
                rw [CategoryTheory.Limits.pullback.condition]
          _ = s_Ω.base ((CategoryTheory.Limits.pullback.snd g_Z₂ s_Ω).base q₂) := rfl
      obtain ⟨q₁, hq₁_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₁
          ((CategoryTheory.Limits.pullback.snd g_Z₂ s_Ω).base q₂) hz₁_eq
      refine ⟨q₁, fst₂.isClosedEmbedding.injective ?_⟩
      calc fst₂.base (f₀.base q₁)
          = (f₀ ≫ fst₂).base q₁ := rfl
        _ = (fst₁ ≫ f).base q₁ := by rw [hf₀_fst]
        _ = f.base (fst₁.base q₁) := rfl
        _ = f.base z₁ := by rw [hq₁_fst]
        _ = fst₂.base q₂ := hz₁
    have hFin₁ := hFinComp Z₁ g_Z₁ hgZ₁
    classical
    let t : Finset (Set ↥(CategoryTheory.Limits.pullback g_Z₂ s_Ω)) :=
      hFin₁.toFinset.image (fun E => f₀.base '' E)
    have ht_closed : ∀ C ∈ t, IsClosed C := by
      intro C hC
      rcases Finset.mem_image.mp hC with ⟨E, hE_mem, rfl⟩
      exact hf₀_closed E (isClosed_of_mem_irreducibleComponents E (hFin₁.mem_toFinset.mp hE_mem))
    have hF_cov : F ⊆ ⋃₀ (t : Set (Set ↥(CategoryTheory.Limits.pullback g_Z₂ s_Ω))) := by
      intro y hy
      obtain ⟨x, rfl⟩ := hf₀_surj y
      refine Set.mem_sUnion.mpr ⟨f₀.base '' irreducibleComponent x, ?_, ⟨x, mem_irreducibleComponent, rfl⟩⟩
      exact Finset.mem_coe.mpr (Finset.mem_image.mpr
        ⟨irreducibleComponent x, hFin₁.mem_toFinset.mpr (irreducibleComponent_mem_irreducibleComponents x), rfl⟩)
    obtain ⟨C, hC_t, hFC⟩ := (isIrreducible_iff_sUnion_isClosed.mp hF.1) t ht_closed hF_cov
    rcases Finset.mem_image.mp hC_t with ⟨E, hE_fin, rfl⟩
    have hE : E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Z₁ s_Ω) :=
      hFin₁.mem_toFinset.mp hE_fin
    have hImg_irred : IsIrreducible (f₀.base '' E) :=
      hE.1.image f₀.base f₀.continuous.continuousOn
    exact ⟨E, hE, Set.Subset.antisymm (hF.2 hImg_irred hFC) hFC⟩
  have hBiratPropSurj : ∀ (W Y : AlgebraicGeometry.Scheme.{u})
      (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (α_K : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g_Y η_K)
      (h : W ⟶ Y),
      AlgebraicGeometry.IsProper g_W →
      AlgebraicGeometry.IsIntegral Y →
      AlgebraicGeometry.IsProper g_Y →
      AlgebraicGeometry.Surjective g_Y →
      h ≫ g_Y = g_W →
      CategoryTheory.Limits.pullback.fst g_W η_K ≫ h =
        α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K →
      AlgebraicGeometry.IsProper h ∧ AlgebraicGeometry.Surjective h := by
    intro W Y g_W g_Y α_K h hgW hIntY hgY hSurjY hh_comm hh_gen
    have : AlgebraicGeometry.IsProper g_W := hgW
    have : AlgebraicGeometry.IsIntegral Y := hIntY
    have : AlgebraicGeometry.IsProper g_Y := hgY
    have : AlgebraicGeometry.Surjective g_Y := hSurjY
    have hProp_comp : AlgebraicGeometry.IsProper (h ≫ g_Y) := by
      rw [hh_comm]
      infer_instance
    have hProp_h : AlgebraicGeometry.IsProper h := AlgebraicGeometry.IsProper.of_comp h g_Y
    refine ⟨hProp_h, AlgebraicGeometry.Surjective.mk ?_⟩
    have hRange_cl : IsClosed (Set.range ⇑h) := by
      rw [← Set.image_univ]
      exact h.isClosedMap Set.univ isClosed_univ
    let ξ_Y : ↥Y := genericPoint ↥Y
    have hξ_cl : closure ({ξ_Y} : Set ↥Y) = Set.univ := (genericPoint_spec ↥Y).def
    let η_S : ↥(AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))) :=
      ⟨⊥, hbot_prime (PowerSeries Ω)⟩
    obtain ⟨y₁, hy₁⟩ := g_Y.surjective η_S
    have hη_in_cl : η_S ∈ closure ({g_Y.base ξ_Y} :
        Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))) := by
      have hy₁_mem : y₁ ∈ closure ({ξ_Y} : Set ↥Y) := by
        rw [hξ_cl]; trivial
      have himg : g_Y.base y₁ ∈ g_Y.base '' closure ({ξ_Y} : Set ↥Y) := ⟨y₁, hy₁_mem, rfl⟩
      have hsub := image_closure_subset_closure_image (f := g_Y.base) (s := {ξ_Y}) g_Y.continuous
      simpa [hy₁] using hsub himg
    have hgY_ξ : g_Y.base ξ_Y = η_S := by
      have hle : (g_Y.base ξ_Y).asIdeal ≤ (⊥ : Ideal (PowerSeries Ω)) :=
        (PrimeSpectrum.le_iff_mem_closure (g_Y.base ξ_Y) η_S).mpr hη_in_cl
      exact PrimeSpectrum.ext (le_bot_iff.mp hle)
    let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))) :=
      ⟨⊥, hbot_prime (FractionRing (PowerSeries Ω))⟩
    have hηK_pt : η_K.base pt_K = η_S := by
      apply PrimeSpectrum.ext
      ext f_ps
      change algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)) f_ps ∈ (⊥ : Ideal _) ↔
        f_ps ∈ (⊥ : Ideal (PowerSeries Ω))
      simp only [Ideal.mem_bot]
      exact ⟨fun h0 => IsFractionRing.injective (PowerSeries Ω) (FractionRing (PowerSeries Ω))
        (h0.trans (map_zero _).symm), fun h0 => by rw [h0, map_zero]⟩
    obtain ⟨z_K, hz_K, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback ξ_Y pt_K (hgY_ξ.trans hηK_pt.symm)
    have hξ_in_range : ξ_Y ∈ Set.range ⇑h := by
      refine ⟨(α_K.inv ≫ CategoryTheory.Limits.pullback.fst g_W η_K).base z_K, ?_⟩
      calc h.base ((α_K.inv ≫ CategoryTheory.Limits.pullback.fst g_W η_K).base z_K)
          = ((α_K.inv ≫ CategoryTheory.Limits.pullback.fst g_W η_K) ≫ h).base z_K := rfl
        _ = (α_K.inv ≫ α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y η_K).base z_K := by
              rw [CategoryTheory.Category.assoc, hh_gen]
        _ = (CategoryTheory.Limits.pullback.fst g_Y η_K).base z_K := by
              rw [α_K.inv_hom_id_assoc]
        _ = ξ_Y := hz_K
    have huniv_sub : (Set.univ : Set ↥Y) ⊆ Set.range ⇑h := by
      rw [← hξ_cl]
      exact closure_minimal (Set.singleton_subset_iff.mpr hξ_in_range) hRange_cl
    intro y
    exact huniv_sub (Set.mem_univ y)
  refine ⟨?_, ?_, ?_⟩
  · intro Z g_Z τ_Z hZ
    exact ⟨hFinComp Z g_Z hZ.2.2.1, fun F q_F hF hGen => hNoClosedGen Z g_Z τ_Z F q_F hZ hF hGen⟩
  · intro W Y g_W τ_W g_Y τ_Y α_K h hW hY hh_comm hh_gen
    obtain ⟨hProp_h, hSurj_h⟩ :=
      hBiratPropSurj W Y g_W g_Y α_K h hW.2.2.1 hY.1 hY.2.2.1 hY.2.2.2.2.1 hh_comm hh_gen
    let h₀ : CategoryTheory.Limits.pullback g_W s_Ω ⟶ CategoryTheory.Limits.pullback g_Y s_Ω :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_W s_Ω ≫ h)
        (CategoryTheory.Limits.pullback.snd g_W s_Ω)
        (by rw [CategoryTheory.Category.assoc, hh_comm, CategoryTheory.Limits.pullback.condition])
    have hSub : irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω) ⊆
        (fun E => h₀.base '' E) '' irreducibleComponents ↥(CategoryTheory.Limits.pullback g_W s_Ω) := by
      intro F hF
      obtain ⟨E, hE, hImg⟩ := hCompCover W Y g_W g_Y h h₀ hW.2.2.1 hProp_h hSurj_h hh_comm
        (CategoryTheory.Limits.pullback.lift_fst _ _ _) F hF
      exact ⟨E, hE, hImg⟩
    have hFinW := hFinComp W g_W hW.2.2.1
    exact le_trans (Set.ncard_le_ncard hSub (hFinW.image _)) (Set.ncard_image_le hFinW)
  · intro Y Y' g_Y τ_Y g_Y' τ_Y' q₀ π hY hBlow
    have hq₀_cl : IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_Y s_Ω)) := hBlow.1
    have hY' : IsNC2DPointedSurface Ω n g_Y' τ_Y' := hBlow.2.1
    have hπ_comm : π ≫ g_Y = g_Y' := hBlow.2.2.1
    have hProp_π : AlgebraicGeometry.IsProper π := hBlow.2.2.2.2.1
    have hSurj_π : AlgebraicGeometry.Surjective π := hBlow.2.2.2.2.2.1
    obtain ⟨E_exc, η_exc, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
        hE_exc_mem, hη_exc_gen, _, _, _, h_pre_exc, _⟩ :=
      hBlow.2.2.2.2.2.2.2.2.2
    let π₀ : CategoryTheory.Limits.pullback g_Y' s_Ω ⟶ CategoryTheory.Limits.pullback g_Y s_Ω :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_Y' s_Ω ≫ π)
        (CategoryTheory.Limits.pullback.snd g_Y' s_Ω)
        (by rw [CategoryTheory.Category.assoc, hπ_comm, CategoryTheory.Limits.pullback.condition])
    have hπ₀_fst : π₀ ≫ CategoryTheory.Limits.pullback.fst g_Y s_Ω =
        CategoryTheory.Limits.pullback.fst g_Y' s_Ω ≫ π :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hπ₀_on_exc : ∀ q' ∈ E_exc, π₀.base q' = q₀ := by
      intro q' hq'_mem
      have hq'_pre : q' ∈ (CategoryTheory.Limits.pullback.fst g_Y' s_Ω).base ⁻¹'
          (π.base ⁻¹' {(CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q₀}) := by
        rwa [h_pre_exc]
      apply (CategoryTheory.Limits.pullback.fst g_Y s_Ω).isClosedEmbedding.injective
      calc (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base (π₀.base q')
          = (π₀ ≫ CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q' := rfl
        _ = (CategoryTheory.Limits.pullback.fst g_Y' s_Ω ≫ π).base q' := by rw [hπ₀_fst]
        _ = π.base ((CategoryTheory.Limits.pullback.fst g_Y' s_Ω).base q') := rfl
        _ = (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q₀ := hq'_pre
    have hπ₀_exc : π₀.base '' E_exc = ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_Y s_Ω)) := by
      ext y
      simp only [Set.mem_image, Set.mem_singleton_iff]
      exact ⟨fun ⟨q', hq', hEq⟩ => hEq.symm.trans (hπ₀_on_exc q' hq'),
        fun hy => ⟨η_exc, hη_exc_gen.mem, (hπ₀_on_exc η_exc hη_exc_gen.mem).trans hy.symm⟩⟩
    have hNotSingleton : ∀ F ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω),
        F ≠ ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_Y s_Ω)) := by
      intro F hF hF_eq
      have hF_cl : IsClosed F := isClosed_of_mem_irreducibleComponents F hF
      let q_gen := hF.1.genericPoint
      have hGenF : IsGenericPoint q_gen F := hF.1.isGenericPoint_genericPoint hF_cl
      have hgp_eq : q_gen = q₀ := Set.mem_singleton_iff.mp (hF_eq ▸ hGenF.mem)
      have hgp_cl : IsClosed ({q_gen} : Set ↥(CategoryTheory.Limits.pullback g_Y s_Ω)) := by
        rwa [hgp_eq]
      exact hNoClosedGen Y g_Y τ_Y F q_gen hY hF hGenF hgp_cl
    let C_Y' := irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y' s_Ω)
    have hFinY' : C_Y'.Finite := hFinComp Y' g_Y' hY'.2.2.1
    have hSub' : irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω) ⊆
        (fun E => π₀.base '' E) '' (C_Y' \ {E_exc}) := by
      intro F hF
      obtain ⟨E', hE'_mem, hE'_img⟩ :=
        hCompCover Y' Y g_Y' g_Y π π₀ hY'.2.2.1 hProp_π hSurj_π hπ_comm hπ₀_fst F hF
      refine ⟨E', ⟨hE'_mem, ?_⟩, hE'_img⟩
      intro hEq_exc
      rw [Set.mem_singleton_iff] at hEq_exc
      rw [hEq_exc, hπ₀_exc] at hE'_img
      exact hNotSingleton F hF hE'_img.symm
    have hle1 : (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω)).ncard ≤
        (C_Y' \ {E_exc}).ncard :=
      le_trans (Set.ncard_le_ncard hSub' ((hFinY'.sdiff).image _)) (Set.ncard_image_le hFinY'.sdiff)
    have hdiff_eq : (C_Y' \ {E_exc}).ncard = C_Y'.ncard - 1 :=
      Set.ncard_sdiff_singleton_of_mem hE_exc_mem
    have hpos : 0 < C_Y'.ncard := Set.Nonempty.ncard_pos hFinY' ⟨E_exc, hE_exc_mem⟩
    change (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_Ω)).ncard + 1 ≤ C_Y'.ncard
    omega

theorem weil_nc2d_exists_nonIso_closedPoint_and_local_birational_not_surj (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (n : ℕ)
    (W Y : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_Y : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ Y))
    (α_K : CategoryTheory.Limits.pullback g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≅
      CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (h : W ⟶ Y)
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hY : IsNC2DPointedSurface Ω n g_Y τ_Y)
    (hαK_snd : α_K.hom ≫ CategoryTheory.Limits.pullback.snd g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) =
      CategoryTheory.Limits.pullback.snd g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hh_comm : h ≫ g_Y = g_W)
    (hh_gen : CategoryTheory.Limits.pullback.fst g_W
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))) ≫ h =
      α_K.hom ≫ CategoryTheory.Limits.pullback.fst g_Y
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))
    (hNotIso : ¬ CategoryTheory.IsIso h) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∃ q₀ : ↥(CategoryTheory.Limits.pullback g_Y s_Ω),
      IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_Y s_Ω)) ∧
      ∀ (R₀ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀) [p₀.asIdeal.IsPrime]
        (ι₀ : AlgebraicGeometry.Spec R₀ ⟶ Y)
        (R_W : CommRingCat.{u}) (p_W : AlgebraicGeometry.Spec R_W) [p_W.asIdeal.IsPrime]
        (ι_W : AlgebraicGeometry.Spec R_W ⟶ W),
        AlgebraicGeometry.IsOpenImmersion ι₀ →
        IsDomain R₀ →
        ι₀.base p₀ = (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q₀ →
        AlgebraicGeometry.IsOpenImmersion ι_W →
        IsDomain R_W →
        h.base (ι_W.base p_W) = (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q₀ →
        ∃ θ : Localization.AtPrime p₀.asIdeal →+* Localization.AtPrime p_W.asIdeal,
          IsLocalHom θ ∧
          Function.Injective θ ∧
          θ.comp ((algebraMap R₀ (Localization.AtPrime p₀.asIdeal)).comp
            ((AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_Y)).hom.comp PowerSeries.C)) =
            (algebraMap R_W (Localization.AtPrime p_W.asIdeal)).comp
              ((AlgebraicGeometry.Spec.preimage (ι_W ≫ g_W)).hom.comp PowerSeries.C) ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime p₀.asIdeal))) ≫ ι₀ =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R_W (Localization.AtPrime p_W.asIdeal))) ≫
              ι_W ≫ h ∧
          (∀ b : Localization.AtPrime p_W.asIdeal,
            ∃ f g : Localization.AtPrime p₀.asIdeal, g ≠ 0 ∧ θ g * b = θ f) ∧
          ¬ Function.Surjective θ :=
by
  intro s_Ω
  have hPart1 : ∃ (V_K : Y.Opens) (q₀ : ↥(CategoryTheory.Limits.pullback g_Y s_Ω)),
      (∀ y : ↥Y, y ∈ V_K ↔ PowerSeries.X ∉ (g_Y.base y).asIdeal) ∧
      CategoryTheory.IsIso (h ∣_ V_K) ∧
      IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_Y s_Ω)) ∧
      (∀ U : Y.Opens,
        (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q₀ ∈ U →
        ¬ CategoryTheory.IsIso (h ∣_ U)) := by
    let RStar := PowerSeries Ω
    let KStar := FractionRing RStar
    let η_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap RStar KStar))
    have hinj_RK : Function.Injective (algebraMap RStar KStar) :=
      IsFractionRing.injective RStar KStar
    have hLocK : IsLocalization.Away (PowerSeries.X : RStar) KStar :=
      { map_units := by
          rintro ⟨y, k, rfl⟩
          have hy : (PowerSeries.X : RStar) ^ k ≠ 0 := pow_ne_zero k PowerSeries.X_ne_zero
          exact IsUnit.mk0 _ (fun h0 => hy (hinj_RK (h0.trans (map_zero _).symm)))
        surj := by
          intro z
          obtain ⟨a, b, hb_nzd, rfl⟩ := IsFractionRing.div_surjective (A := RStar) z
          have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
          obtain ⟨k, u, hu⟩ :=
            IsDiscreteValuationRing.associated_pow_irreducible hb_ne PowerSeries.X_irreducible
          refine ⟨⟨a * (u : RStar), ⟨(PowerSeries.X : RStar) ^ k, k, rfl⟩⟩, ?_⟩
          have hbK_ne : algebraMap RStar KStar b ≠ 0 :=
            fun h0 => hb_ne (hinj_RK (h0.trans (map_zero _).symm))
          dsimp only
          apply mul_right_cancel₀ hbK_ne
          calc (algebraMap RStar KStar a / algebraMap RStar KStar b *
                  algebraMap RStar KStar ((PowerSeries.X : RStar) ^ k)) *
                algebraMap RStar KStar b
              = (algebraMap RStar KStar a / algebraMap RStar KStar b *
                  algebraMap RStar KStar b) *
                algebraMap RStar KStar ((PowerSeries.X : RStar) ^ k) := by ring
            _ = algebraMap RStar KStar a *
                algebraMap RStar KStar (b * (u : RStar)) := by
                rw [div_mul_cancel₀ _ hbK_ne, ← hu]
            _ = algebraMap RStar KStar (a * (u : RStar)) *
                algebraMap RStar KStar b := by
                simp only [map_mul]; ring
        exists_of_eq := by
          intro x₁ x₂ h_eq
          exact ⟨1, by rw [hinj_RK h_eq]⟩ }
    have hOpen_ηK : AlgebraicGeometry.IsOpenImmersion η_K :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (PowerSeries.X : RStar)
    have hRange_ηK : ∀ s : AlgebraicGeometry.Spec (CommRingCat.of RStar),
        s ∈ Set.range η_K.base ↔ (PowerSeries.X : RStar) ∉ s.asIdeal := by
      intro s
      constructor
      · rintro ⟨q, rfl⟩ hx
        change algebraMap RStar KStar PowerSeries.X ∈ q.asIdeal at hx
        have hX_ne : algebraMap RStar KStar PowerSeries.X ≠ 0 :=
          fun h0 => PowerSeries.X_ne_zero (hinj_RK (h0.trans (map_zero _).symm))
        exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (IsUnit.mk0 _ hX_ne))
      · intro hX_not
        let η₀ : AlgebraicGeometry.Spec (CommRingCat.of KStar) := ⟨⊥, inferInstance⟩
        refine ⟨η₀, PrimeSpectrum.ext ?_⟩
        ext f
        have h_bot : f ∈ (η_K.base η₀).asIdeal ↔ f = 0 := by
          change algebraMap RStar KStar f ∈ (⊥ : Ideal KStar) ↔ f = 0
          rw [Ideal.mem_bot]
          exact ⟨fun h0 => hinj_RK (h0.trans (map_zero _).symm), fun hf => by rw [hf, map_zero]⟩
        rw [h_bot]
        refine ⟨fun hf => by rw [hf]; exact s.asIdeal.zero_mem, fun hf => ?_⟩
        by_contra hf_ne
        obtain ⟨k, u, hu⟩ :=
          IsDiscreteValuationRing.associated_pow_irreducible hf_ne PowerSeries.X_irreducible
        have hpow_mem : (PowerSeries.X : RStar) ^ k ∈ s.asIdeal := by
          rw [← hu]
          exact s.asIdeal.mul_mem_right (u : RStar) hf
        rcases k with _ | k
        · rw [pow_zero] at hpow_mem
          exact s.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hpow_mem)
        · exact hX_not (s.isPrime.mem_of_pow_mem (k + 1) hpow_mem)
    have hRange_sΩ : ∀ s : AlgebraicGeometry.Spec (CommRingCat.of RStar),
        (PowerSeries.X : RStar) ∈ s.asIdeal →
          s = s_Ω.base (⟨⊥, inferInstance⟩ : AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
      intro s hX_in
      apply PrimeSpectrum.ext
      ext f
      have h_bot :
          f ∈ (s_Ω.base (⟨⊥, inferInstance⟩ : AlgebraicGeometry.Spec (CommRingCat.of Ω))).asIdeal ↔
            PowerSeries.constantCoeff f = 0 := by
        change PowerSeries.constantCoeff f ∈ (⊥ : Ideal Ω) ↔ PowerSeries.constantCoeff f = 0
        exact Ideal.mem_bot
      rw [h_bot]
      constructor
      · intro hf
        by_contra hc_ne
        have hu : IsUnit f := PowerSeries.isUnit_iff_constantCoeff.mpr (IsUnit.mk0 _ hc_ne)
        exact s.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hf hu)
      · intro hc
        obtain ⟨g, rfl⟩ := PowerSeries.X_dvd_iff.mpr hc
        exact s.asIdeal.mul_mem_right g hX_in
    let V_K : Y.Opens := (TopologicalSpace.Opens.map g_Y.base).obj η_K.opensRange
    have hVK_mem : ∀ y : ↥Y, y ∈ V_K ↔ PowerSeries.X ∉ (g_Y.base y).asIdeal := by
      intro y
      change g_Y.base y ∈ Set.range η_K.base ↔ _
      exact hRange_ηK (g_Y.base y)
    let fst_Y := CategoryTheory.Limits.pullback.fst g_Y η_K
    let fst_W := CategoryTheory.Limits.pullback.fst g_W η_K
    let W_K : W.Opens := (TopologicalSpace.Opens.map h.base).obj V_K
    have hRange_Y : Set.range ⇑fst_Y = Set.range ⇑V_K.ι := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
      exact Subtype.range_coe.symm
    have hRange_W : Set.range ⇑fst_W = Set.range ⇑W_K.ι := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
      have h_eq : ⇑g_W ⁻¹' Set.range ⇑η_K = (W_K : Set ↥W) := by
        ext w
        change g_W.base w ∈ Set.range η_K.base ↔ g_Y.base (h.base w) ∈ Set.range η_K.base
        rw [← hh_comm]
        rfl
      rw [h_eq]
      exact Subtype.range_coe.symm
    let e_Y := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq fst_Y V_K.ι hRange_Y
    let e_W := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq fst_W W_K.ι hRange_W
    have hVK_eq : h ∣_ V_K = e_W.inv ≫ α_K.hom ≫ e_Y.hom := by
      rw [← CategoryTheory.cancel_mono V_K.ι]
      calc (h ∣_ V_K) ≫ V_K.ι
          = W_K.ι ≫ h := AlgebraicGeometry.morphismRestrict_ι h V_K
        _ = (e_W.inv ≫ fst_W) ≫ h := by
            rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac]
        _ = e_W.inv ≫ (fst_W ≫ h) := CategoryTheory.Category.assoc _ _ _
        _ = e_W.inv ≫ (α_K.hom ≫ fst_Y) := by rw [hh_gen]
        _ = e_W.inv ≫ α_K.hom ≫ (e_Y.hom ≫ V_K.ι) := by
            rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
        _ = (e_W.inv ≫ α_K.hom ≫ e_Y.hom) ≫ V_K.ι := by
            simp only [CategoryTheory.Category.assoc]
    have hVK_iso : CategoryTheory.IsIso (h ∣_ V_K) := by
      rw [hVK_eq]
      infer_instance
    let S_iso : Set Y.Opens := {U : Y.Opens | CategoryTheory.IsIso (h ∣_ U)}
    let U_iso : Y.Opens := sSup S_iso
    have hVK_le : V_K ≤ U_iso := le_sSup hVK_iso
    have hU_iso_ne_top : U_iso ≠ ⊤ := by
      intro htop
      have hiSup : (⨆ U : S_iso, (U : Y.Opens)) = ⊤ := by
        rw [← sSup_eq_iSup']
        exact htop
      have hIso_h : CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme h :=
        AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
          (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
          (fun U : S_iso => (U : Y.Opens)) hiSup (fun U => U.2)
      exact hNotIso hIso_h
    have hex_y₁ : ∃ y₁ : ↥Y, y₁ ∉ U_iso := by
      by_contra hall
      push Not at hall
      apply hU_iso_ne_top
      ext y
      exact ⟨fun _ => trivial, fun _ => hall y⟩
    obtain ⟨y₁, hy₁_not⟩ := hex_y₁
    have hy₁_not_VK : y₁ ∉ V_K := fun hy₁ => hy₁_not (hVK_le hy₁)
    have hX_y₁ : (PowerSeries.X : RStar) ∈ (g_Y.base y₁).asIdeal := by
      by_contra hnot
      exact hy₁_not_VK ((hVK_mem y₁).mpr hnot)
    obtain ⟨q₁, hq₁_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := g_Y) (g := s_Ω) y₁
        (⟨⊥, inferInstance⟩ : AlgebraicGeometry.Spec (CommRingCat.of Ω))
        (hRange_sΩ (g_Y.base y₁) hX_y₁)
    let Y₀ := CategoryTheory.Limits.pullback g_Y s_Ω
    let K₀ : Set ↥Y₀ :=
      (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base ⁻¹' ((U_iso : Set ↥Y)ᶜ)
    have hK₀_nonempty : K₀.Nonempty := ⟨q₁, by change _ ∉ U_iso; rw [hq₁_fst]; exact hy₁_not⟩
    have hK₀_closed : IsClosed K₀ :=
      U_iso.isOpen.isClosed_compl.preimage (CategoryTheory.Limits.pullback.fst g_Y s_Ω).continuous
    have : AlgebraicGeometry.IsProper g_Y := hY.2.2.1
    have : CompactSpace ↥Y₀ :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
        (CategoryTheory.Limits.pullback.snd g_Y s_Ω)
    obtain ⟨q₀, hq₀_in, hq₀_cl⟩ := hK₀_closed.exists_closed_singleton hK₀_nonempty
    refine ⟨V_K, q₀, hVK_mem, hVK_iso, hq₀_cl, ?_⟩
    intro U hq₀_U hIso_U
    have hU_le : U ≤ U_iso := le_sSup hIso_U
    exact hq₀_in (hU_le hq₀_U)
  obtain ⟨V_K, q₀, hVK_mem, hVK_iso, hq₀_cl, hq₀_noIso⟩ := hPart1
  refine ⟨q₀, hq₀_cl, ?_⟩
  intro R₀ p₀ _ ι₀ R_W p_W _ ι_W hOpen₀ hDom₀ hp₀ hOpenW hDomW hpW
  let y₀ : ↥Y := (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q₀
  have hp_eq : h.base (ι_W.base p_W) = ι₀.base p₀ := hpW.trans hp₀.symm
  have hPart2a : ∃ (f_W : R_W)
      (_ : f_W ∉ p_W.asIdeal)
      (_ : f_W ≠ 0)
      (θ₀ : R₀ →+* Localization.Away f_W)
      (ψ_W : Localization.Away f_W →+* Localization.AtPrime p_W.asIdeal)
      (θ : Localization.AtPrime p₀.asIdeal →+* Localization.AtPrime p_W.asIdeal),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫ ι₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_W (Localization.Away f_W))) ≫
          ι_W ≫ h ∧
      (Ideal.map (algebraMap R_W (Localization.Away f_W)) p_W.asIdeal).comap θ₀ = p₀.asIdeal ∧
      Function.Injective ψ_W ∧
      (∀ r : R_W, ψ_W (algebraMap R_W (Localization.Away f_W) r) =
        algebraMap R_W (Localization.AtPrime p_W.asIdeal) r) ∧
      (∀ r : R₀, θ (algebraMap R₀ (Localization.AtPrime p₀.asIdeal) r) = ψ_W (θ₀ r)) ∧
      IsLocalHom θ ∧
      θ.comp ((algebraMap R₀ (Localization.AtPrime p₀.asIdeal)).comp
        ((AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_Y)).hom.comp PowerSeries.C)) =
        (algebraMap R_W (Localization.AtPrime p_W.asIdeal)).comp
          ((AlgebraicGeometry.Spec.preimage (ι_W ≫ g_W)).hom.comp PowerSeries.C) ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime p₀.asIdeal))) ≫ ι₀ =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R_W (Localization.AtPrime p_W.asIdeal))) ≫
          ι_W ≫ h := by
    have : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
    have : IsDomain R₀ := hDom₀
    have : AlgebraicGeometry.IsOpenImmersion ι_W := hOpenW
    have : IsDomain R_W := hDomW
    have : IsDomain (Localization.AtPrime p₀.asIdeal) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p₀.asIdeal)
    have : IsDomain (Localization.AtPrime p_W.asIdeal) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p_W.asIdeal)
    have hinj_RWB : Function.Injective (algebraMap R_W (Localization.AtPrime p_W.asIdeal)) :=
      IsLocalization.injective (Localization.AtPrime p_W.asIdeal)
        (Ideal.primeCompl_le_nonZeroDivisors p_W.asIdeal)
    let O_W : (AlgebraicGeometry.Spec R_W).Opens :=
      (TopologicalSpace.Opens.map (ι_W ≫ h).base).obj ι₀.opensRange
    have hpW_OW : p_W ∈ O_W := by
      change h.base (ι_W.base p_W) ∈ Set.range ι₀.base
      rw [hp_eq]
      exact ⟨p₀, rfl⟩
    obtain ⟨_, ⟨f_W, rfl⟩, hpf_W, hf_sub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hpW_OW
    have hf_not_pW : f_W ∉ p_W.asIdeal := (PrimeSpectrum.mem_basicOpen f_W p_W).mp hpf_W
    have hf_pc : f_W ∈ p_W.asIdeal.primeCompl := hf_not_pW
    have hf_ne : f_W ≠ 0 := fun h0 => hf_not_pW (h0 ▸ p_W.asIdeal.zero_mem)
    have hf_powers_nzd : Submonoid.powers f_W ≤ nonZeroDivisors R_W := by
      rw [Submonoid.powers_le, mem_nonZeroDivisors_iff_ne_zero]
      exact hf_ne
    have : IsDomain (Localization.Away f_W) := IsLocalization.isDomain_localization hf_powers_nzd
    let lam_W : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f_W)) ⟶
        AlgebraicGeometry.Spec R_W :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_W (Localization.Away f_W)))
    have : AlgebraicGeometry.IsOpenImmersion lam_W :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization f_W
    have hRange_B₀ : Set.range ⇑(lam_W ≫ ι_W ≫ h) ⊆ Set.range ⇑ι₀ := by
      rintro _ ⟨q, rfl⟩
      apply hf_sub
      refine (PrimeSpectrum.mem_basicOpen f_W (lam_W.base q)).mpr fun h_in => ?_
      change algebraMap R_W (Localization.Away f_W) f_W ∈ q.asIdeal at h_in
      have hu : IsUnit (algebraMap R_W (Localization.Away f_W) f_W) :=
        @IsLocalization.map_units R_W _ (Submonoid.powers f_W) (Localization.Away f_W) _ _ _
          ⟨f_W, Submonoid.mem_powers f_W⟩
      exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h_in hu)
    let Φ₀ := AlgebraicGeometry.IsOpenImmersion.lift ι₀ (lam_W ≫ ι_W ≫ h) hRange_B₀
    have hΦ₀_fac : Φ₀ ≫ ι₀ = lam_W ≫ ι_W ≫ h :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι₀ (lam_W ≫ ι_W ≫ h) hRange_B₀
    obtain ⟨θ₀, hΦ₀_map⟩ : ∃ θ₀ : R₀ →+* Localization.Away f_W,
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) = Φ₀ :=
      ⟨(AlgebraicGeometry.Spec.preimage Φ₀).hom, AlgebraicGeometry.Spec.map_preimage Φ₀⟩
    let P_x : Ideal (Localization.Away f_W) :=
      Ideal.map (algebraMap R_W (Localization.Away f_W)) p_W.asIdeal
    have hDisj_fW : Disjoint (Submonoid.powers f_W : Set R_W) (p_W.asIdeal : Set R_W) := by
      rw [Set.disjoint_left]
      intro x hx hp
      exact (Submonoid.powers_le.mpr hf_pc) hx hp
    have hPx_prime : P_x.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f_W) (Localization.Away f_W)
        p_W.asIdeal inferInstance hDisj_fW
    have hPx_under : P_x.comap (algebraMap R_W (Localization.Away f_W)) = p_W.asIdeal :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f_W) (Localization.Away f_W)
        inferInstance hDisj_fW
    let q_x : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f_W)) := ⟨P_x, hPx_prime⟩
    have hlamW_qx : lam_W.base q_x = p_W := PrimeSpectrum.ext hPx_under
    have hΦ₀_qx : Φ₀.base q_x = p₀ := by
      apply ι₀.isOpenEmbedding.injective
      calc ι₀.base (Φ₀.base q_x)
          = (Φ₀ ≫ ι₀).base q_x := rfl
        _ = (lam_W ≫ ι_W ≫ h).base q_x := by rw [hΦ₀_fac]
        _ = h.base (ι_W.base (lam_W.base q_x)) := rfl
        _ = ι₀.base p₀ := by rw [hlamW_qx, hp_eq]
    have hPx_θ₀ : P_x.comap θ₀ = p₀.asIdeal := by
      have h1 : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀)).base q_x).asIdeal =
          p₀.asIdeal := by
        rw [hΦ₀_map, hΦ₀_qx]
      exact h1
    have hfW_units_B : ∀ y : Submonoid.powers f_W,
        IsUnit (algebraMap R_W (Localization.AtPrime p_W.asIdeal) y.1) := by
      intro y
      exact @IsLocalization.map_units R_W _ p_W.asIdeal.primeCompl
        (Localization.AtPrime p_W.asIdeal) _ _ _ ⟨y.1, (Submonoid.powers_le.mpr hf_pc) y.2⟩
    obtain ⟨ψ_W, hψW_eq⟩ : ∃ ψ_W : Localization.Away f_W →+* Localization.AtPrime p_W.asIdeal,
        ∀ r : R_W, ψ_W (algebraMap R_W (Localization.Away f_W) r) =
          algebraMap R_W (Localization.AtPrime p_W.asIdeal) r :=
      ⟨@IsLocalization.lift R_W _ (Submonoid.powers f_W) (Localization.Away f_W) _ _
          (Localization.AtPrime p_W.asIdeal) _ _ _ hfW_units_B,
       @IsLocalization.lift_eq R_W _ (Submonoid.powers f_W) (Localization.Away f_W) _ _
          (Localization.AtPrime p_W.asIdeal) _ _ _ hfW_units_B⟩
    have hinj_ψW : Function.Injective ψ_W := by
      intro b₁ b₂ hb_eq
      apply sub_eq_zero.mp
      have hb₀ : ψ_W (b₁ - b₂) = 0 := by rw [map_sub, hb_eq, sub_self]
      obtain ⟨⟨r, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers f_W) (b₁ - b₂)
      have hr0 : algebraMap R_W (Localization.AtPrime p_W.asIdeal) r = 0 := by
        calc algebraMap R_W (Localization.AtPrime p_W.asIdeal) r
            = ψ_W (algebraMap R_W (Localization.Away f_W) r) := (hψW_eq r).symm
          _ = ψ_W ((b₁ - b₂) * algebraMap R_W (Localization.Away f_W) s.1) := by rw [hs]
          _ = ψ_W (b₁ - b₂) * ψ_W (algebraMap R_W (Localization.Away f_W) s.1) := map_mul _ _ _
          _ = 0 := by rw [hb₀, zero_mul]
      have hr : r = 0 := hinj_RWB (hr0.trans (map_zero _).symm)
      have hs_unit : IsUnit (algebraMap R_W (Localization.Away f_W) s.1) :=
        @IsLocalization.map_units R_W _ (Submonoid.powers f_W) (Localization.Away f_W) _ _ _ s
      exact mul_right_cancel₀ hs_unit.ne_zero (hs.trans (by rw [hr, map_zero, zero_mul]))
    have hψW_Px : P_x ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime p_W.asIdeal)).comap ψ_W := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, Ideal.mem_comap, hψW_eq r]
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (Localization.AtPrime p_W.asIdeal) p_W.asIdeal r).mpr hr
    have hψW_unit : ∀ u : Localization.Away f_W, IsUnit (ψ_W u) ↔ u ∉ P_x := by
      intro u
      constructor
      · intro hu hu_in
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu) (hψW_Px hu_in)
      · intro hu_not
        obtain ⟨⟨r, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers f_W) u
        have hjr_not : algebraMap R_W (Localization.Away f_W) r ∉ P_x := by
          intro hjr
          rw [← hs] at hjr
          rcases hPx_prime.mem_or_mem hjr with hu_in | hs_in
          · exact hu_not hu_in
          · have hs_unit : IsUnit (algebraMap R_W (Localization.Away f_W) s.1) :=
              @IsLocalization.map_units R_W _ (Submonoid.powers f_W) (Localization.Away f_W) _ _ _ s
            exact hPx_prime.ne_top (Ideal.eq_top_of_isUnit_mem _ hs_in hs_unit)
        have hr_not : r ∉ p_W.asIdeal :=
          fun hr => hjr_not ((Ideal.ext_iff.mp hPx_under r).mpr hr)
        have hr_unit : IsUnit (ψ_W (algebraMap R_W (Localization.Away f_W) r)) := by
          rw [hψW_eq r]
          exact @IsLocalization.map_units R_W _ p_W.asIdeal.primeCompl
            (Localization.AtPrime p_W.asIdeal) _ _ _ ⟨r, hr_not⟩
        rw [← hs, map_mul] at hr_unit
        exact isUnit_of_mul_isUnit_left hr_unit
    have hp0_units_B : ∀ s : p₀.asIdeal.primeCompl, IsUnit ((ψ_W.comp θ₀) s.1) := by
      intro s
      apply (hψW_unit (θ₀ s.1)).mpr
      intro hs_in
      exact s.2 ((Ideal.ext_iff.mp hPx_θ₀ s.1).mp hs_in)
    obtain ⟨θ, hθ_eq⟩ :
        ∃ θ : Localization.AtPrime p₀.asIdeal →+* Localization.AtPrime p_W.asIdeal,
          ∀ r : R₀, θ (algebraMap R₀ (Localization.AtPrime p₀.asIdeal) r) = ψ_W (θ₀ r) :=
      ⟨@IsLocalization.lift R₀ _ p₀.asIdeal.primeCompl (Localization.AtPrime p₀.asIdeal) _ _
          (Localization.AtPrime p_W.asIdeal) _ _ (ψ_W.comp θ₀) hp0_units_B,
       @IsLocalization.lift_eq R₀ _ p₀.asIdeal.primeCompl (Localization.AtPrime p₀.asIdeal) _ _
          (Localization.AtPrime p_W.asIdeal) _ _ (ψ_W.comp θ₀) hp0_units_B⟩
    have hC1 : IsLocalHom θ := by
      refine ⟨fun a ha_unit => ?_⟩
      obtain ⟨⟨r, s⟩, hs⟩ := IsLocalization.surj p₀.asIdeal.primeCompl a
      have hr_unit_B : IsUnit (ψ_W (θ₀ r)) := by
        have heq : ψ_W (θ₀ r) = θ a * ψ_W (θ₀ s.1) := by
          calc ψ_W (θ₀ r)
              = θ (algebraMap R₀ (Localization.AtPrime p₀.asIdeal) r) := (hθ_eq r).symm
            _ = θ (a * algebraMap R₀ (Localization.AtPrime p₀.asIdeal) s.1) := by rw [hs]
            _ = θ a * θ (algebraMap R₀ (Localization.AtPrime p₀.asIdeal) s.1) := map_mul _ _ _
            _ = θ a * ψ_W (θ₀ s.1) := by rw [hθ_eq s.1]
        rw [heq]
        exact ha_unit.mul (hp0_units_B s)
      have hr_not_p0 : r ∉ p₀.asIdeal :=
        fun hr_in => (hψW_unit (θ₀ r)).mp hr_unit_B ((Ideal.ext_iff.mp hPx_θ₀ r).mpr hr_in)
      have hr_unit_A : IsUnit (algebraMap R₀ (Localization.AtPrime p₀.asIdeal) r) :=
        @IsLocalization.map_units R₀ _ p₀.asIdeal.primeCompl
          (Localization.AtPrime p₀.asIdeal) _ _ _ ⟨r, hr_not_p0⟩
      rw [← hs] at hr_unit_A
      exact isUnit_of_mul_isUnit_left hr_unit_A
    let φ_Y : PowerSeries Ω →+* R₀ := (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_Y)).hom
    let φ_W : PowerSeries Ω →+* R_W := (AlgebraicGeometry.Spec.preimage (ι_W ≫ g_W)).hom
    have hθ₀_φ : θ₀.comp φ_Y = (algebraMap R_W (Localization.Away f_W)).comp φ_W := by
      have h_mor : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫ (ι₀ ≫ g_Y) =
          lam_W ≫ (ι_W ≫ g_W) := by
        calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) ≫ (ι₀ ≫ g_Y)
            = (Φ₀ ≫ ι₀) ≫ g_Y := by rw [hΦ₀_map, CategoryTheory.Category.assoc]
          _ = (lam_W ≫ ι_W ≫ h) ≫ g_Y := by rw [hΦ₀_fac]
          _ = lam_W ≫ ι_W ≫ (h ≫ g_Y) := by simp only [CategoryTheory.Category.assoc]
          _ = lam_W ≫ (ι_W ≫ g_W) := by rw [hh_comm]
      have h_pre := congrArg AlgebraicGeometry.Spec.preimage h_mor
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
        AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at h_pre
      exact congrArg CommRingCat.Hom.hom h_pre
    have hC3 : θ.comp ((algebraMap R₀ (Localization.AtPrime p₀.asIdeal)).comp
          (φ_Y.comp PowerSeries.C)) =
        (algebraMap R_W (Localization.AtPrime p_W.asIdeal)).comp
          (φ_W.comp PowerSeries.C) := by
      ext c
      simp only [RingHom.comp_apply, hθ_eq]
      have h1 := RingHom.congr_fun hθ₀_φ (PowerSeries.C c)
      simp only [RingHom.comp_apply] at h1
      rw [h1, hψW_eq]
    have hC4 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime p₀.asIdeal))) ≫ ι₀ =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R_W (Localization.AtPrime p_W.asIdeal))) ≫
          ι_W ≫ h := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime p₀.asIdeal))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1; ext r; exact hθ_eq r
      have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W) ≫ lam_W =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R_W (Localization.AtPrime p_W.asIdeal))) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1; ext r; exact hψW_eq r
      calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime p₀.asIdeal))) ≫ ι₀
          = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime p₀.asIdeal)))) ≫ ι₀ :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W) ≫ (Φ₀ ≫ ι₀) := by
              rw [h1, hΦ₀_map, CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W) ≫ lam_W) ≫ ι_W ≫ h := by
              rw [hΦ₀_fac]; simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R_W (Localization.AtPrime p_W.asIdeal))) ≫
              ι_W ≫ h := by rw [h2]
    exact ⟨f_W, hf_not_pW, hf_ne, θ₀, ψ_W, θ, hΦ₀_map ▸ hΦ₀_fac, hPx_θ₀,
      hinj_ψW, hψW_eq, hθ_eq, hC1, hC3, hC4⟩
  obtain ⟨f_W, hf_not_pW, hf_ne, θ₀, ψ_W, θ, hΦ₀_fac, hPx_θ₀,
    hinj_ψW, hψW_eq, hθ_eq, hC1, hC3, hC4⟩ := hPart2a
  have hPart2b : Function.Injective θ₀ ∧
      Function.Injective θ ∧
      (∀ b : Localization.AtPrime p_W.asIdeal,
        ∃ f g : Localization.AtPrime p₀.asIdeal, g ≠ 0 ∧ θ g * b = θ f) := by
    have : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
    have : IsDomain R₀ := hDom₀
    have : AlgebraicGeometry.IsOpenImmersion ι_W := hOpenW
    have : IsDomain R_W := hDomW
    have : AlgebraicGeometry.IsIntegral W := hW.1
    have : AlgebraicGeometry.IsIntegral Y := hY.1
    have : CategoryTheory.IsIso (h ∣_ V_K) := hVK_iso
    have : IsDomain (Localization.AtPrime p₀.asIdeal) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p₀.asIdeal)
    have : IsDomain (Localization.AtPrime p_W.asIdeal) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p_W.asIdeal)
    have hinj_RA : Function.Injective (algebraMap R₀ (Localization.AtPrime p₀.asIdeal)) :=
      IsLocalization.injective (Localization.AtPrime p₀.asIdeal)
        (Ideal.primeCompl_le_nonZeroDivisors p₀.asIdeal)
    have hf_powers_nzd : Submonoid.powers f_W ≤ nonZeroDivisors R_W := by
      rw [Submonoid.powers_le, mem_nonZeroDivisors_iff_ne_zero]; exact hf_ne
    let B₀ := Localization.Away f_W
    have : IsDomain B₀ := IsLocalization.isDomain_localization hf_powers_nzd
    have hinj_jW : Function.Injective (algebraMap R_W B₀) :=
      IsLocalization.injective B₀ hf_powers_nzd
    let lam_W : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ AlgebraicGeometry.Spec R_W :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_W B₀))
    have : AlgebraicGeometry.IsOpenImmersion lam_W :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization f_W
    let ι_B₀ : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ W := lam_W ≫ ι_W
    let Φ₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀)
    let φ_Y : PowerSeries Ω →+* R₀ := (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_Y)).hom
    let X₀ : R₀ := φ_Y PowerSeries.X
    let X_B : B₀ := θ₀ X₀
    let η_S : AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) := ⟨⊥, inferInstance⟩
    have hVK_nonempty : (V_K : Set ↥Y).Nonempty := by
      obtain ⟨y_η, hy_η⟩ := hY.2.2.2.2.1.surj η_S
      refine ⟨y_η, (hVK_mem y_η).mpr ?_⟩
      rw [hy_η]
      change PowerSeries.X ∉ (⊥ : Ideal (PowerSeries Ω))
      rw [Ideal.mem_bot]
      exact PowerSeries.X_ne_zero
    let W_K : W.Opens := (TopologicalSpace.Opens.map h.base).obj V_K
    have hWK_nonempty : (W_K : Set ↥W).Nonempty := by
      obtain ⟨w_η, hw_η⟩ := hW.2.2.2.2.1.surj η_S
      refine ⟨w_η, (hVK_mem (h.base w_η)).mpr ?_⟩
      have hg_eq : g_Y.base (h.base w_η) = g_W.base w_η := by rw [← hh_comm]; rfl
      rw [hg_eq, hw_η]
      change PowerSeries.X ∉ (⊥ : Ideal (PowerSeries Ω))
      rw [Ideal.mem_bot]
      exact PowerSeries.X_ne_zero
    have : IrreducibleSpace ↥Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y
    have : IrreducibleSpace ↥W := AlgebraicGeometry.irreducibleSpace_of_isIntegral W
    have hX₀_ne : X₀ ≠ 0 := by
      have hDense₀ : Dense (Set.range ⇑ι₀) :=
        ι₀.isOpenEmbedding.isOpen_range.dense ⟨ι₀.base p₀, p₀, rfl⟩
      obtain ⟨_, hy_VK, q₀', rfl⟩ :=
        hDense₀.inter_open_nonempty (V_K : Set ↥Y) V_K.isOpen hVK_nonempty
      have hX_not : PowerSeries.X ∉ ((ι₀ ≫ g_Y).base q₀').asIdeal :=
        (hVK_mem (ι₀.base q₀')).mp hy_VK
      have h_map_gY : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Y) = ι₀ ≫ g_Y :=
        AlgebraicGeometry.Spec.map_preimage (ι₀ ≫ g_Y)
      rw [← h_map_gY] at hX_not
      change X₀ ∉ q₀'.asIdeal at hX_not
      exact fun h0 => hX_not (h0 ▸ q₀'.asIdeal.zero_mem)
    have hXB_ne : X_B ≠ 0 := by
      have hf_pc : f_W ∈ p_W.asIdeal.primeCompl := hf_not_pW
      have hDisj : Disjoint (Submonoid.powers f_W : Set R_W) (p_W.asIdeal : Set R_W) := by
        rw [Set.disjoint_left]; intro x hx hp; exact (Submonoid.powers_le.mpr hf_pc) hx hp
      let q_x : AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
        ⟨Ideal.map (algebraMap R_W B₀) p_W.asIdeal,
         IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f_W) B₀ p_W.asIdeal
           inferInstance hDisj⟩
      have hDenseB : Dense (Set.range ⇑ι_B₀) :=
        ι_B₀.isOpenEmbedding.isOpen_range.dense ⟨ι_B₀.base q_x, q_x, rfl⟩
      obtain ⟨_, hw_WK, q_B', rfl⟩ :=
        hDenseB.inter_open_nonempty (W_K : Set ↥W) W_K.isOpen hWK_nonempty
      have hX_not : PowerSeries.X ∉ ((ι_B₀ ≫ h ≫ g_Y).base q_B').asIdeal :=
        (hVK_mem (h.base (ι_B₀.base q_B'))).mp hw_WK
      have h_map_gY : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Y) = ι₀ ≫ g_Y :=
        AlgebraicGeometry.Spec.map_preimage (ι₀ ≫ g_Y)
      have h_eq_mor : ι_B₀ ≫ h ≫ g_Y =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ₀.comp φ_Y)) := by
        calc ι_B₀ ≫ h ≫ g_Y
            = (lam_W ≫ ι_W ≫ h) ≫ g_Y := by simp only [ι_B₀, CategoryTheory.Category.assoc]
          _ = (Φ₀ ≫ ι₀) ≫ g_Y := by rw [hΦ₀_fac]
          _ = Φ₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Y) := by
              rw [CategoryTheory.Category.assoc, h_map_gY]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ₀.comp φ_Y)) := by
              rw [← AlgebraicGeometry.Spec.map_comp]
              congr 1
      rw [h_eq_mor] at hX_not
      change X_B ∉ q_B'.asIdeal at hX_not
      exact fun h0 => hX_not (h0 ▸ q_B'.asIdeal.zero_mem)
    let R₀_K := Localization.Away X₀
    let B₀_K := Localization.Away X_B
    have hX₀_nzd : Submonoid.powers X₀ ≤ nonZeroDivisors R₀ :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hX₀_ne)
    have hXB_nzd : Submonoid.powers X_B ≤ nonZeroDivisors B₀ :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hXB_ne)
    have : IsDomain R₀_K := IsLocalization.isDomain_localization hX₀_nzd
    have : IsDomain B₀_K := IsLocalization.isDomain_localization hXB_nzd
    have hinj_R₀K : Function.Injective (algebraMap R₀ R₀_K) := IsLocalization.injective R₀_K hX₀_nzd
    have hinj_B₀K : Function.Injective (algebraMap B₀ B₀_K) := IsLocalization.injective B₀_K hXB_nzd
    have hsub_K : Submonoid.powers X₀ ≤ Submonoid.comap θ₀ (Submonoid.powers X_B) :=
      Submonoid.powers_le.mpr ⟨1, pow_one X_B⟩
    obtain ⟨θ_K, hθK_eq⟩ : ∃ θ_K : R₀_K →+* B₀_K,
        ∀ r : R₀, θ_K (algebraMap R₀ R₀_K r) = algebraMap B₀ B₀_K (θ₀ r) :=
      ⟨IsLocalization.map (S := R₀_K) B₀_K θ₀ hsub_K,
       IsLocalization.map_eq (S := R₀_K) (Q := B₀_K) hsub_K⟩
    let lam_0K : AlgebraicGeometry.Spec (CommRingCat.of R₀_K) ⟶ AlgebraicGeometry.Spec R₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₀_K))
    let lam_BK : AlgebraicGeometry.Spec (CommRingCat.of B₀_K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ B₀_K))
    have : AlgebraicGeometry.IsOpenImmersion lam_0K :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization X₀
    have : AlgebraicGeometry.IsOpenImmersion lam_BK :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization X_B
    let Φ_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_K)
    have hΦK_sq : Φ_K ≫ lam_0K = lam_BK ≫ Φ₀ := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1; ext r; exact hθK_eq r
    have h_in_VK : ∀ z : ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀_K)),
        (lam_0K ≫ ι₀).base z ∈ V_K := by
      intro z
      apply (hVK_mem ((lam_0K ≫ ι₀).base z)).mpr
      intro hX_in
      have h_map_gY : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Y) = ι₀ ≫ g_Y :=
        AlgebraicGeometry.Spec.map_preimage (ι₀ ≫ g_Y)
      have h_in2 : PowerSeries.X ∈
