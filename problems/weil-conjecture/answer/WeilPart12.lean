import WeilPart11
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_powerSeries_fibral_relDimOne_smooth_away (Ω A₀ : Type u) [Field Ω] [CommRing A₀]
    (f₀ : PowerSeries Ω →+* A₀)
    (hFlat : f₀.Flat)
    (hFP : f₀.FinitePresentation)
    (q₀ : PrimeSpectrum A₀) :
    letI : Algebra (PowerSeries Ω) Ω :=
      (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
    letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
    ∀ (q_Ω : PrimeSpectrum (TensorProduct (PowerSeries Ω) Ω A₀))
      (_hq_Ω : PrimeSpectrum.comap Algebra.TensorProduct.includeRight.toRingHom q_Ω = q₀)
      (h_Ω : TensorProduct (PowerSeries Ω) Ω A₀)
      (_hh_Ω : h_Ω ∉ q_Ω.asIdeal)
      (_hSmΩ : Algebra.IsStandardSmoothOfRelativeDimension 1 Ω (Localization.Away h_Ω)),
      ∃ s₀ : A₀,
        s₀ ∉ q₀.asIdeal ∧
        RingHom.IsStandardSmoothOfRelativeDimension 1
          ((algebraMap A₀ (Localization.Away s₀)).comp f₀) :=
by
  letI : Algebra (PowerSeries Ω) Ω :=
    (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
  letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
  intro q_Ω hq_Ω h_Ω hh_Ω hSmΩ
  let R₀ := PowerSeries Ω
  let F_Ω := TensorProduct R₀ Ω A₀
  have : Module.Flat R₀ A₀ := hFlat
  have : Algebra.FinitePresentation R₀ A₀ := hFP
  have : q_Ω.asIdeal.IsPrime := q_Ω.isPrime
  have : q₀.asIdeal.IsPrime := q₀.isPrime

  
  suffices hMain : ∀ (F : Type u) [Field F] [Algebra F_Ω F],
      RingHom.ker (algebraMap F_Ω F) = q_Ω.asIdeal →
      ∃ s₀ : A₀,
        s₀ ∉ q₀.asIdeal ∧
        RingHom.IsStandardSmoothOfRelativeDimension 1
          ((algebraMap A₀ (Localization.Away s₀)).comp f₀) from
    hMain q_Ω.asIdeal.ResidueField (Ideal.ker_algebraMap_residueField q_Ω.asIdeal)
  intro F _ _ hKerF_Ω

  
  have hSmAtΩ : Algebra.IsSmoothAt Ω q_Ω.asIdeal := by
    have : Algebra.IsStandardSmooth Ω (Localization.Away h_Ω) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
    have hSub : (PrimeSpectrum.basicOpen h_Ω : Set (PrimeSpectrum F_Ω)) ⊆
        Algebra.smoothLocus Ω F_Ω :=
      Algebra.basicOpen_subset_smoothLocus_iff.mpr inferInstance
    exact hSub hh_Ω

  obtain ⟨N, π₀, hSurj₀, hFG₀⟩ := Algebra.FinitePresentation.out (R := R₀) (A := A₀)
  let P₀ := MvPolynomial (Fin N) R₀

  
  have hSmoothIff : ∀ (R A P K : Type u) [CommRing R] [CommRing A] [CommRing P] [Field K]
      [Algebra R P] [Algebra P A] [Algebra R A] [IsScalarTower R P A]
      [Algebra A K] [Algebra P K] [IsScalarTower P A K]
      [Algebra.FormallySmooth R P] [Module.Free P Ω[P ⁄ R]] [Module.Finite P Ω[P ⁄ R]]
      (hSurj : Function.Surjective (algebraMap P A))
      (hFG : (RingHom.ker (algebraMap P A)).FG)
      (q : PrimeSpectrum A)
      (hKerK : RingHom.ker (algebraMap A K) = q.asIdeal),
      Algebra.IsSmoothAt R q.asIdeal ↔
        Function.Injective (KaehlerDifferential.cotangentComplexBaseChange R A P K) := by
    intro R A P K _ _ _ _ _ _ _ _ _ _ _ _ _ _ hSurj hFG q hKerK
    have : q.asIdeal.IsPrime := q.isPrime
    let Q_id : Ideal P := Ideal.comap (algebraMap P A) q.asIdeal
    have : Q_id.IsPrime := Ideal.IsPrime.comap (algebraMap P A)
    let M_P : Submonoid P := Q_id.primeCompl
    let M_A : Submonoid A := q.asIdeal.primeCompl
    let P_loc := Localization.AtPrime Q_id
    let S_loc := Localization.AtPrime q.asIdeal
    have h_M : Submonoid.map (algebraMap P A) M_P = M_A := by
      ext a
      simp only [Submonoid.mem_map]
      constructor
      · rintro ⟨p, hp, rfl⟩
        exact hp
      · intro ha
        obtain ⟨p, rfl⟩ := hSurj a
        exact ⟨p, ha, rfl⟩
    have h_M_le : M_P ≤ Submonoid.comap (algebraMap P A) M_A :=
      Submonoid.map_le_iff_le_comap.mp h_M.le
    let π_loc : P_loc →+* S_loc := IsLocalization.map S_loc (algebraMap P A) h_M_le
    letI : Algebra P_loc S_loc := π_loc.toAlgebra
    have hπ_alg : algebraMap P_loc S_loc = π_loc := rfl
    have : IsScalarTower R P_loc S_loc := IsScalarTower.of_algebraMap_eq fun r => by
      change algebraMap R S_loc r = π_loc (algebraMap R P_loc r)
      rw [IsScalarTower.algebraMap_apply R P P_loc r, IsLocalization.map_eq,
        ← IsScalarTower.algebraMap_apply R P A r, ← IsScalarTower.algebraMap_apply R A S_loc r]
    have hSurj_loc : Function.Surjective (algebraMap P_loc S_loc) := by
      intro z
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj M_A z
      dsimp only at hzs
      obtain ⟨pa, rfl⟩ := hSurj a
      obtain ⟨ps, hps_eq⟩ := hSurj (s : A)
      have hps_mem : ps ∈ M_P := by
        change algebraMap P A ps ∉ q.asIdeal
        rw [hps_eq]
        exact s.2
      refine ⟨IsLocalization.mk' P_loc pa ⟨ps, hps_mem⟩, ?_⟩
      have hs_unit : IsUnit (algebraMap A S_loc (s : A)) := IsLocalization.map_units S_loc s
      apply hs_unit.mul_left_inj.mp
      calc algebraMap P_loc S_loc (IsLocalization.mk' P_loc pa ⟨ps, hps_mem⟩) *
              algebraMap A S_loc (s : A)
          = π_loc (IsLocalization.mk' P_loc pa ⟨ps, hps_mem⟩) * π_loc (algebraMap P P_loc ps) := by
              rw [hπ_alg, IsLocalization.map_eq, hps_eq]
        _ = π_loc (IsLocalization.mk' P_loc pa ⟨ps, hps_mem⟩ * algebraMap P P_loc ps) :=
              (map_mul π_loc _ _).symm
        _ = π_loc (algebraMap P P_loc pa) := by rw [IsLocalization.mk'_spec]
        _ = algebraMap A S_loc (algebraMap P A pa) := IsLocalization.map_eq _ _
        _ = z * algebraMap A S_loc (s : A) := hzs.symm
    have hKer_loc : RingHom.ker (algebraMap P_loc S_loc) =
        Ideal.map (algebraMap P P_loc) (RingHom.ker (algebraMap P A)) :=
      IsLocalization.ker_map S_loc (algebraMap P A) h_M
    have hFG_loc : (RingHom.ker (algebraMap P_loc S_loc)).FG := by
      rw [hKer_loc]
      exact hFG.map (algebraMap P P_loc)
    have : Algebra.FormallySmooth R P_loc := Algebra.FormallySmooth.instLocalization M_P
    have hLocΩ : IsLocalizedModule M_P (KaehlerDifferential.map R R P P_loc) :=
      KaehlerDifferential.isLocalizedModule_map R P P_loc M_P
    have hBC_Ω : IsBaseChange P_loc (KaehlerDifferential.map R R P P_loc) :=
      IsLocalizedModule.isBaseChange M_P P_loc (KaehlerDifferential.map R R P P_loc)
    let e_Ω : TensorProduct P P_loc Ω[P ⁄ R] ≃ₗ[P_loc] Ω[P_loc ⁄ R] := hBC_Ω.equiv
    have : Module.Free P_loc Ω[P_loc ⁄ R] := Module.Free.of_equiv e_Ω
    have : Module.Finite P_loc Ω[P_loc ⁄ R] := Module.Finite.equiv e_Ω
    have h_units : ∀ y : M_A, IsUnit (algebraMap A K (y : A)) := by
      intro y
      apply Ne.isUnit
      intro hy0
      have hy_ker : (y : A) ∈ RingHom.ker (algebraMap A K) := hy0
      rw [hKerK] at hy_ker
      exact y.2 hy_ker
    let ρ_S : S_loc →+* K := IsLocalization.lift h_units
    letI : Algebra S_loc K := ρ_S.toAlgebra
    letI : Algebra P_loc K := (ρ_S.comp π_loc).toAlgebra
    have : IsScalarTower P_loc S_loc K := IsScalarTower.of_algebraMap_eq' rfl
    have : IsScalarTower A S_loc K := IsScalarTower.of_algebraMap_eq fun a =>
      (IsLocalization.lift_eq h_units a).symm
    have : IsScalarTower P P_loc K := IsScalarTower.of_algebraMap_eq fun p => by
      change algebraMap P K p = ρ_S (π_loc (algebraMap P P_loc p))
      rw [IsLocalization.map_eq, IsLocalization.lift_eq, IsScalarTower.algebraMap_apply P A K p]
    have hMaxLe : IsLocalRing.maximalIdeal S_loc ≤ RingHom.ker (algebraMap S_loc K) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal S_loc, Ideal.map_le_iff_le_comap]
      intro a ha
      change ρ_S (algebraMap A S_loc a) = 0
      rw [IsLocalization.lift_eq]
      have ha_ker : a ∈ RingHom.ker (algebraMap A K) := by rwa [hKerK]
      exact ha_ker
    have hLocJ : IsLocalizedModule M_P
        (RingHom.toKerIsLocalization P_loc S_loc (algebraMap P A) h_M_le) :=
      RingHom.toKerIsLocalization_isLocalizedModule S_loc (algebraMap P A) h_M
    have hBC_J : IsBaseChange P_loc
        (RingHom.toKerIsLocalization P_loc S_loc (algebraMap P A) h_M_le) :=
      IsLocalizedModule.isBaseChange M_P P_loc _
    let e_J : TensorProduct P P_loc ↥(RingHom.ker (algebraMap P A)) ≃ₗ[P_loc]
        ↥(RingHom.ker (algebraMap P_loc S_loc)) := hBC_J.equiv
    let α : TensorProduct P K ↥(RingHom.ker (algebraMap P A)) ≃ₗ[K]
        TensorProduct P_loc K ↥(RingHom.ker (algebraMap P_loc S_loc)) :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange P P_loc K K
        ↥(RingHom.ker (algebraMap P A))).symm.trans (e_J.baseChange P_loc K _ _)
    let β : TensorProduct P K Ω[P ⁄ R] ≃ₗ[K] TensorProduct P_loc K Ω[P_loc ⁄ R] :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange P P_loc K K Ω[P ⁄ R]).symm.trans
        (e_Ω.baseChange P_loc K _ _)
    let δ_loc := KaehlerDifferential.cotangentComplexBaseChange R S_loc P_loc K
    let δ := KaehlerDifferential.cotangentComplexBaseChange R A P K
    have hComm : ∀ v, δ_loc (α v) = β (δ v) := by
      let L := δ_loc.comp α.toLinearMap
      let R_map := β.toLinearMap.comp δ
      intro v
      refine TensorProduct.inductionOn v (fun c b => ?_)
        (fun x y ihx ihy => by
          change L (x + y) = R_map (x + y)
          rw [L.map_add, R_map.map_add]
          exact congrArg₂ (· + ·) ihx ihy)
      simp only [α, β, LinearEquiv.trans_apply,
        TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul]
      change δ_loc ((e_J.toLinearMap.baseChange K) (c ⊗ₜ[P_loc] (1 ⊗ₜ[P] b))) =
        (e_Ω.toLinearMap.baseChange K)
          ((TensorProduct.AlgebraTensorModule.cancelBaseChange P P_loc K K Ω[P ⁄ R]).symm
            (δ (c ⊗ₜ[P] b)))
      rw [LinearMap.baseChange_tmul]
      change δ_loc (c ⊗ₜ[P_loc] e_J (1 ⊗ₜ[P] b)) = _
      simp only [δ_loc, δ, KaehlerDifferential.cotangentComplexBaseChange_tmul,
        KaehlerDifferential.kerToTensor_apply, map_smul]
      congr 1
      rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
        LinearMap.baseChange_tmul]
      congr 1
      change KaehlerDifferential.D R P_loc ↑(hBC_J.equiv (1 ⊗ₜ[P] b)) =
        hBC_Ω.equiv (1 ⊗ₜ[P] KaehlerDifferential.D R P ↑b)
      rw [hBC_J.equiv_tmul, one_smul, RingHom.toKerIsLocalization_apply,
        hBC_Ω.equiv_tmul, one_smul, KaehlerDifferential.map_D]
    have hInjIff : Function.Injective δ_loc ↔ Function.Injective δ := by
      constructor
      · intro hInj x y hxy
        apply α.injective
        apply hInj
        rw [hComm, hComm, hxy]
      · intro hInj x y hxy
        obtain ⟨x', rfl⟩ := α.surjective x
        obtain ⟨y', rfl⟩ := α.surjective y
        congr 1
        apply hInj
        apply β.injective
        rw [← hComm, ← hComm, hxy]
    exact (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange
      P_loc K hSurj_loc hFG_loc hMaxLe).trans hInjIff

  
  letI : Algebra P₀ A₀ := π₀.toRingHom.toAlgebra
  have : IsScalarTower R₀ P₀ A₀ := IsScalarTower.of_algebraMap_eq fun r => (π₀.commutes r).symm
  let P_Ω := TensorProduct R₀ Ω P₀
  letI : Algebra P₀ P_Ω := Algebra.TensorProduct.rightAlgebra
  letI : Algebra A₀ F_Ω := Algebra.TensorProduct.rightAlgebra
  have : IsScalarTower R₀ P₀ P_Ω := Algebra.TensorProduct.right_isScalarTower
  have : IsScalarTower R₀ A₀ F_Ω := Algebra.TensorProduct.right_isScalarTower
  have : Algebra.IsPushout R₀ Ω P₀ P_Ω := Algebra.IsPushout.symm TensorProduct.isPushout'
  have : Algebra.IsPushout R₀ Ω A₀ F_Ω := Algebra.IsPushout.symm TensorProduct.isPushout'
  let π_Ω : P_Ω →ₐ[Ω] F_Ω :=
    Algebra.TensorProduct.map (AlgHom.id Ω Ω) (IsScalarTower.toAlgHom R₀ P₀ A₀)
  letI : Algebra P_Ω F_Ω := π_Ω.toRingHom.toAlgebra

  have hSurj_Ω : Function.Surjective (algebraMap P_Ω F_Ω) :=
    Algebra.TensorProduct.map_surjective (AlgHom.id Ω Ω) (IsScalarTower.toAlgHom R₀ P₀ A₀)
      Function.surjective_id hSurj₀

  have hFG_Ω : (RingHom.ker (algebraMap P_Ω F_Ω)).FG := by
    have hKerEq : RingHom.ker (algebraMap P_Ω F_Ω) =
        RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R₀ Ω) π₀) := by
      ext x
      rfl
    rw [hKerEq, Algebra.TensorProduct.lTensor_ker π₀ hSurj₀]
    exact hFG₀.map Algebra.TensorProduct.includeRight.toRingHom

  let e_diff : TensorProduct P₀ P_Ω Ω[P₀ ⁄ R₀] ≃ₗ[P_Ω] Ω[P_Ω ⁄ Ω] :=
    KaehlerDifferential.tensorKaehlerEquiv R₀ Ω P₀ P_Ω
  have : Module.Free P_Ω Ω[P_Ω ⁄ Ω] := Module.Free.of_equiv e_diff
  have : Module.Finite P_Ω Ω[P_Ω ⁄ Ω] := Module.Finite.equiv e_diff

  letI : Algebra P_Ω F := ((algebraMap F_Ω F).comp π_Ω.toRingHom).toAlgebra
  have : IsScalarTower P_Ω F_Ω F := IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra A₀ F :=
    ((algebraMap F_Ω F).comp Algebra.TensorProduct.includeRight.toRingHom).toAlgebra
  have : IsScalarTower A₀ F_Ω F := IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra P₀ F := ((algebraMap A₀ F).comp (algebraMap P₀ A₀)).toAlgebra
  have : IsScalarTower P₀ A₀ F := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower P₀ P_Ω F := IsScalarTower.of_algebraMap_eq fun p => by
    change algebraMap F_Ω F (Algebra.TensorProduct.includeRight (algebraMap P₀ A₀ p)) =
      algebraMap F_Ω F (π_Ω (Algebra.TensorProduct.includeRight p))
    congr 1

  have hKerF_0 : RingHom.ker (algebraMap A₀ F) = q₀.asIdeal := by
    ext a
    change a ∈ Ideal.comap Algebra.TensorProduct.includeRight.toRingHom
      (RingHom.ker (algebraMap F_Ω F)) ↔ a ∈ q₀.asIdeal
    rw [hKerF_Ω, ← hq_Ω]
    rfl

  have hInj_Ω : Function.Injective (KaehlerDifferential.cotangentComplexBaseChange Ω F_Ω P_Ω F) :=
    (hSmoothIff Ω F_Ω P_Ω F hSurj_Ω hFG_Ω q_Ω hKerF_Ω).mp hSmAtΩ

  have hInj_0 : Function.Injective (KaehlerDifferential.cotangentComplexBaseChange R₀ A₀ P₀ F) := by
    let e_ker₀ := Algebra.kerTensorProductMapIdToAlgHomEquiv R₀ P₀ A₀ Ω hSurj₀
    have hKerSubEq : RingHom.ker π_Ω = RingHom.ker (algebraMap P_Ω F_Ω) :=
      RingHom.ker_coe_toRingHom π_Ω
    let e_ker_cast : ↥(RingHom.ker π_Ω) ≃ₗ[P_Ω] ↥(RingHom.ker (algebraMap P_Ω F_Ω)) :=
      LinearEquiv.ofEq _ _ hKerSubEq
    let e_ker_inv : TensorProduct P₀ P_Ω ↥(RingHom.ker (algebraMap P₀ A₀)) ≃ₗ[P_Ω]
        ↥(RingHom.ker (algebraMap P_Ω F_Ω)) :=
      e_ker₀.symm.trans e_ker_cast
    let Φ_dom : TensorProduct P₀ F ↥(RingHom.ker (algebraMap P₀ A₀)) ≃ₗ[F]
        TensorProduct P_Ω F ↥(RingHom.ker (algebraMap P_Ω F_Ω)) :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange P₀ P_Ω F F
        ↥(RingHom.ker (algebraMap P₀ A₀))).symm.trans (e_ker_inv.baseChange P_Ω F _ _)
    let Φ_cod : TensorProduct P₀ F Ω[P₀ ⁄ R₀] ≃ₗ[F] TensorProduct P_Ω F Ω[P_Ω ⁄ Ω] :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange P₀ P_Ω F F Ω[P₀ ⁄ R₀]).symm.trans
        (e_diff.baseChange P_Ω F _ _)
    let δ_Ω := KaehlerDifferential.cotangentComplexBaseChange Ω F_Ω P_Ω F
    let δ_0 := KaehlerDifferential.cotangentComplexBaseChange R₀ A₀ P₀ F
    have hCommBC : ∀ v, δ_Ω (Φ_dom v) = Φ_cod (δ_0 v) := by
      let L := δ_Ω.comp Φ_dom.toLinearMap
      let R_map := Φ_cod.toLinearMap.comp δ_0
      intro v
      refine TensorProduct.inductionOn v (fun c z => ?_)
        (fun x y ihx ihy => by
          change L (x + y) = R_map (x + y)
          rw [L.map_add, R_map.map_add]
          exact congrArg₂ (· + ·) ihx ihy)
      simp only [Φ_dom, Φ_cod, LinearEquiv.trans_apply,
        TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul]
      change δ_Ω ((e_ker_inv.toLinearMap.baseChange F) (c ⊗ₜ[P_Ω] (1 ⊗ₜ[P₀] z))) =
        (e_diff.toLinearMap.baseChange F)
          ((TensorProduct.AlgebraTensorModule.cancelBaseChange P₀ P_Ω F F Ω[P₀ ⁄ R₀]).symm
            (δ_0 (c ⊗ₜ[P₀] z)))
      rw [LinearMap.baseChange_tmul]
      change δ_Ω (c ⊗ₜ[P_Ω] e_ker_inv (1 ⊗ₜ[P₀] z)) = _
      simp only [δ_Ω, δ_0, KaehlerDifferential.cotangentComplexBaseChange_tmul,
        KaehlerDifferential.kerToTensor_apply, map_smul]
      congr 1
      rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
        LinearMap.baseChange_tmul]
      congr 1
      have hz_coe : (↑(e_ker_inv (1 ⊗ₜ[P₀] z)) : P_Ω) = algebraMap P₀ P_Ω ↑z := by
        have h1 : (1 : P_Ω) = (1 : Ω) ⊗ₜ[R₀] (1 : P₀) := rfl
        change (↑(e_ker_cast (e_ker₀.symm ((1 : P_Ω) ⊗ₜ[P₀] z))) : P_Ω) = _
        rw [LinearEquiv.coe_ofEq_apply, h1,
          Algebra.kerTensorProductMapIdToAlgHomEquiv_symm_apply, one_mul]
        rfl
      rw [hz_coe]
      change KaehlerDifferential.D Ω P_Ω (algebraMap P₀ P_Ω ↑z) =
        (KaehlerDifferential.tensorKaehlerEquiv R₀ Ω P₀ P_Ω)
          (1 ⊗ₜ[P₀] KaehlerDifferential.D R₀ P₀ ↑z)
      rw [KaehlerDifferential.tensorKaehlerEquiv_tmul_D]
      exact (one_smul P_Ω (KaehlerDifferential.D Ω P_Ω (algebraMap P₀ P_Ω ↑z))).symm
    intro x y hxy
    apply Φ_dom.injective
    apply hInj_Ω
    rw [hCommBC, hCommBC, hxy]

  have hSmAt₀ : Algebra.IsSmoothAt R₀ q₀.asIdeal :=
    (hSmoothIff R₀ A₀ P₀ F hSurj₀ hFG₀ q₀ hKerF_0).mpr hInj_0

  
  obtain ⟨s₀, hs₀, hStd₀⟩ :=
    @Algebra.IsSmoothAt.exists_notMem_isStandardSmooth R₀ A₀ _ _ _ _ q₀.asIdeal _ hSmAt₀
  let B := Localization.Away s₀
  let B_Ω := Localization.Away h_Ω
  have : Algebra.IsStandardSmooth R₀ B := hStd₀
  have : Algebra.IsStandardSmooth Ω B_Ω :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1

  have hh_unit : IsUnit (algebraMap F_Ω F h_Ω) := by
    apply Ne.isUnit
    intro h0
    have hmem : h_Ω ∈ RingHom.ker (algebraMap F_Ω F) := h0
    rw [hKerF_Ω] at hmem
    exact hh_Ω hmem

  have hs_unit : IsUnit (algebraMap A₀ F s₀) := by
    apply Ne.isUnit
    intro h0
    have hmem : s₀ ∈ RingHom.ker (algebraMap A₀ F) := h0
    rw [hKerF_0] at hmem
    exact hs₀ hmem

  let ρ_Ω : B_Ω →+* F := IsLocalization.Away.lift h_Ω hh_unit
  let ρ_B : B →+* F := IsLocalization.Away.lift s₀ hs_unit
  letI : Algebra B_Ω F := ρ_Ω.toAlgebra
  letI : Algebra B F := ρ_B.toAlgebra
  have : IsScalarTower F_Ω B_Ω F := IsScalarTower.of_algebraMap_eq fun x =>
    (IsLocalization.Away.lift_eq h_Ω hh_unit x).symm
  have : IsScalarTower A₀ B F := IsScalarTower.of_algebraMap_eq fun x =>
    (IsLocalization.Away.lift_eq s₀ hs_unit x).symm

  have : Nontrivial B_Ω := RingHom.domain_nontrivial ρ_Ω
  have : Nontrivial B := RingHom.domain_nontrivial ρ_B

  have : Module.Free B Ω[B ⁄ R₀] := Algebra.IsStandardSmooth.free_kaehlerDifferential
  have : Module.Finite B Ω[B ⁄ R₀] := KaehlerDifferential.finite R₀ B
  have : Module.Free B_Ω Ω[B_Ω ⁄ Ω] := Algebra.IsStandardSmooth.free_kaehlerDifferential
  have : Module.Finite B_Ω Ω[B_Ω ⁄ Ω] := KaehlerDifferential.finite Ω B_Ω

  have hRank_Ω : Module.rank B_Ω Ω[B_Ω ⁄ Ω] = (1 : Cardinal) := by
    simpa using Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := Ω) (S := B_Ω) 1
  have hFinrank_BΩ : Module.finrank B_Ω Ω[B_Ω ⁄ Ω] = 1 :=
    Module.finrank_eq_of_rank_eq (n := 1) (by simpa using hRank_Ω)
  have hFinrank_F_BΩ : Module.finrank F (TensorProduct B_Ω F Ω[B_Ω ⁄ Ω]) = 1 := by
    rw [Module.finrank_baseChange, hFinrank_BΩ]

  have hLocB : IsLocalizedModule (Submonoid.powers s₀) (KaehlerDifferential.map R₀ R₀ A₀ B) :=
    KaehlerDifferential.isLocalizedModule_map R₀ A₀ B (Submonoid.powers s₀)
  let e_AB : TensorProduct A₀ B Ω[A₀ ⁄ R₀] ≃ₗ[B] Ω[B ⁄ R₀] :=
    (IsLocalizedModule.isBaseChange (Submonoid.powers s₀) B
      (KaehlerDifferential.map R₀ R₀ A₀ B)).equiv
  let E₁ : TensorProduct B F Ω[B ⁄ R₀] ≃ₗ[F] TensorProduct A₀ F Ω[A₀ ⁄ R₀] :=
    (e_AB.symm.baseChange B F _ _).trans
      (TensorProduct.AlgebraTensorModule.cancelBaseChange A₀ B F F Ω[A₀ ⁄ R₀])

  let e_AF : TensorProduct A₀ F_Ω Ω[A₀ ⁄ R₀] ≃ₗ[F_Ω] Ω[F_Ω ⁄ Ω] :=
    KaehlerDifferential.tensorKaehlerEquiv R₀ Ω A₀ F_Ω
  let E₂ : TensorProduct A₀ F Ω[A₀ ⁄ R₀] ≃ₗ[F] TensorProduct F_Ω F Ω[F_Ω ⁄ Ω] :=
    (TensorProduct.AlgebraTensorModule.cancelBaseChange A₀ F_Ω F F Ω[A₀ ⁄ R₀]).symm.trans
      (e_AF.baseChange F_Ω F _ _)

  have hLocBΩ : IsLocalizedModule (Submonoid.powers h_Ω)
      (KaehlerDifferential.map Ω Ω F_Ω B_Ω) :=
    KaehlerDifferential.isLocalizedModule_map Ω F_Ω B_Ω (Submonoid.powers h_Ω)
  let e_FBΩ : TensorProduct F_Ω B_Ω Ω[F_Ω ⁄ Ω] ≃ₗ[B_Ω] Ω[B_Ω ⁄ Ω] :=
    (IsLocalizedModule.isBaseChange (Submonoid.powers h_Ω) B_Ω
      (KaehlerDifferential.map Ω Ω F_Ω B_Ω)).equiv
  let E₃ : TensorProduct F_Ω F Ω[F_Ω ⁄ Ω] ≃ₗ[F] TensorProduct B_Ω F Ω[B_Ω ⁄ Ω] :=
    (TensorProduct.AlgebraTensorModule.cancelBaseChange F_Ω B_Ω F F Ω[F_Ω ⁄ Ω]).symm.trans
      (e_FBΩ.baseChange B_Ω F _ _)

  have hFinrank_F_B : Module.finrank F (TensorProduct B F Ω[B ⁄ R₀]) = 1 := by
    rw [(E₁.trans (E₂.trans E₃)).finrank_eq, hFinrank_F_BΩ]

  have hFinrank_B : Module.finrank B Ω[B ⁄ R₀] = 1 := by
    rw [← Module.finrank_baseChange (R := F) (S := B) (M' := Ω[B ⁄ R₀]), hFinrank_F_B]

  have hRank_B : Module.rank B Ω[B ⁄ R₀] = (1 : Cardinal) := by
    rw [← Module.finrank_eq_rank B Ω[B ⁄ R₀], hFinrank_B, Nat.cast_one]

  have hSmRel_B : Algebra.IsStandardSmoothOfRelativeDimension 1 R₀ B :=
    (Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth 1).mpr hRank_B

  refine ⟨s₀, hs₀, ?_⟩
  exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hSmRel_B

theorem weil_powerSeries_algClosed_nodal_roof_tangent_and_cotangent (Ω A₀ D_Ω : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing A₀] [CommRing D_Ω]
    (f₀ : PowerSeries Ω →+* A₀)
    (hFP : f₀.FinitePresentation)
    (q₀ : PrimeSpectrum A₀)
    (hq₀_max : (PrimeSpectrum.comap f₀ q₀).asIdeal = IsLocalRing.maximalIdeal (PowerSeries Ω)) :
    letI : Algebra (PowerSeries Ω) Ω :=
      (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
    letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
    let J_N : Ideal (MvPolynomial (Fin 2) Ω) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    ∀ (q_Ω : PrimeSpectrum (TensorProduct (PowerSeries Ω) Ω A₀))
      (_hq_Ω : PrimeSpectrum.comap Algebra.TensorProduct.includeRight.toRingHom q_Ω = q₀)
      (m₀ : PrimeSpectrum D_Ω)
      (ψ₁ : TensorProduct (PowerSeries Ω) Ω A₀ →+* D_Ω)
      (ψ₂ : (MvPolynomial (Fin 2) Ω ⧸ J_N) →+* D_Ω)
      (_hψ₁ : ψ₁.Etale)
      (_hψ₂ : ψ₂.Etale)
      (_hm₀_qΩ : PrimeSpectrum.comap ψ₁ m₀ = q_Ω)
      (_hXi : ∀ i : Fin 2, ψ₂ (Ideal.Quotient.mk J_N (MvPolynomial.X i)) ∈ m₀.asIdeal)
      (_hCommΩ : ψ₁.comp Algebra.TensorProduct.includeLeftRingHom =
        ψ₂.comp ((Ideal.Quotient.mk J_N).comp MvPolynomial.C)),
      (∀ a : A₀, ∃ c : Ω, a - f₀ (PowerSeries.C c) ∈ q₀.asIdeal) ∧
      (∃ u₁ v₁ : A₀,
        u₁ ∈ q₀.asIdeal ∧
        v₁ ∈ q₀.asIdeal ∧
        let L_F := Localization.AtPrime q_Ω.asIdeal
        let loc : TensorProduct (PowerSeries Ω) Ω A₀ →+* L_F :=
          algebraMap (TensorProduct (PowerSeries Ω) Ω A₀) L_F
        let 𝔪 : Ideal L_F := IsLocalRing.maximalIdeal L_F
        Ideal.span
          {loc (Algebra.TensorProduct.includeRight u₁),
           loc (Algebra.TensorProduct.includeRight v₁)} = 𝔪 ∧
        (∀ c₀ c₁ : Ω,
          loc (Algebra.TensorProduct.includeLeftRingHom c₀) *
              loc (Algebra.TensorProduct.includeRight u₁) +
            loc (Algebra.TensorProduct.includeLeftRingHom c₁) *
              loc (Algebra.TensorProduct.includeRight v₁) ∈ 𝔪 ^ 2 →
          c₀ = 0 ∧ c₁ = 0) ∧
        loc (Algebra.TensorProduct.includeRight u₁) *
          loc (Algebra.TensorProduct.includeRight v₁) ∈ 𝔪 ^ 3) ∧
      (letI : Algebra Ω D_Ω := (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom).toAlgebra
       Subsingleton (Algebra.H1Cotangent Ω D_Ω) ∧
       ∃ (i_rel : D_Ω →ₗ[D_Ω] (Fin 2 → D_Ω)) (p_rel : (Fin 2 → D_Ω) →ₗ[D_Ω] Ω[D_Ω ⁄ Ω]),
         Function.Injective i_rel ∧ Function.Surjective p_rel ∧ Function.Exact i_rel p_rel) :=
by
  let _ := hq₀_max
  
  have h_part1 : ∀ (R D : Type u) [CommRing R] [CommRing D]
      [Algebra Ω R] [Algebra.FiniteType Ω R] [Algebra Ω D]
      (ψ : R →+* D) (_ : ψ.Etale) (_ : ψ.comp (algebraMap Ω R) = algebraMap Ω D)
      (p₀ : PrimeSpectrum R) (m : PrimeSpectrum D) (hp₀ : PrimeSpectrum.comap ψ m = p₀)
      (_ : ∀ r : R, ∃ c : Ω, r - algebraMap Ω R c ∈ p₀.asIdeal),
      let L_R := Localization.AtPrime p₀.asIdeal
      let L_D := Localization.AtPrime m.asIdeal
      let 𝔪_R : Ideal L_R := IsLocalRing.maximalIdeal L_R
      let 𝔪_D : Ideal L_D := IsLocalRing.maximalIdeal L_D
      let ψ_loc : L_R →+* L_D :=
        Localization.localRingHom p₀.asIdeal m.asIdeal ψ (congrArg PrimeSpectrum.asIdeal hp₀.symm)
      (∀ d : D, ∃ c : Ω, d - algebraMap Ω D c ∈ m.asIdeal) ∧
      (∀ y : L_D, ∃ c : Ω, y - algebraMap Ω L_D c ∈ 𝔪_D) ∧
      Ideal.map ψ_loc 𝔪_R = 𝔪_D ∧
      (∀ (k : ℕ) (x : L_R), ψ_loc x ∈ 𝔪_D ^ k ↔ x ∈ 𝔪_R ^ k) ∧
      (∀ (k : ℕ) (y : L_D), ∃ x : L_R, y - ψ_loc x ∈ 𝔪_D ^ k) := by
    intro R D _ _ _ _ _ ψ hψ hComm p₀ m hp₀ hResR L_R L_D 𝔪_R 𝔪_D ψ_loc
    let _ : Algebra R D := ψ.toAlgebra
    have : IsScalarTower Ω R D := IsScalarTower.of_algebraMap_eq' hComm.symm
    have : Algebra.Etale R D := RingHom.Etale.toAlgebra hψ
    have : IsScalarTower Ω R L_D := IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply Ω D L_D, IsScalarTower.algebraMap_apply Ω R D,
        ← IsScalarTower.algebraMap_apply R D L_D]
    have : IsLocalHom ψ_loc :=
      Localization.isLocalHom_localRingHom p₀.asIdeal m.asIdeal ψ
        (congrArg PrimeSpectrum.asIdeal hp₀.symm)
    let J : Ideal L_D := Ideal.map ψ_loc 𝔪_R
    have hJ_le : J ≤ 𝔪_D := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap]
      by_contra hnot
      have hu : IsUnit (ψ_loc x) := IsLocalRing.notMem_maximalIdeal.mp hnot
      exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_of_map_unit ψ_loc x hu)) hx
    have hJ_ne_top : J ≠ ⊤ := by
      intro htop
      exact (IsLocalRing.maximalIdeal.isMaximal L_D).ne_top (top_unique (htop ▸ hJ_le))
    let Q_J := L_D ⧸ J
    have : Nontrivial Q_J :=
      ⟨⟨0, 1, fun h01 => hJ_ne_top (Ideal.eq_top_of_isUnit_mem J
        (by simpa using Ideal.Quotient.eq.mp h01.symm) isUnit_one)⟩⟩
    have : IsLocalRing Q_J :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    have : Algebra.EssFiniteType L_D Q_J :=
      Algebra.EssFiniteType.of_surjective (Ideal.Quotient.mkₐ L_D J) Ideal.Quotient.mk_surjective
    have : Algebra.EssFiniteType D Q_J := Algebra.EssFiniteType.comp D L_D Q_J
    have : Algebra.EssFiniteType R Q_J := Algebra.EssFiniteType.comp R D Q_J
    have : Algebra.EssFiniteType Ω Q_J := Algebra.EssFiniteType.comp Ω R Q_J
    have : Algebra.FormallyUnramified L_D Q_J :=
      Algebra.FormallyUnramified.of_surjective (Ideal.Quotient.mkₐ L_D J) Ideal.Quotient.mk_surjective
    have : Algebra.FormallyUnramified D Q_J := Algebra.FormallyUnramified.comp D L_D Q_J
    have : Algebra.FormallyUnramified R Q_J := Algebra.FormallyUnramified.comp R D Q_J
    have h_to_map : ∀ r : R, ψ_loc (algebraMap R L_R r) = algebraMap R L_D r := fun r =>
      Localization.localRingHom_to_map p₀.asIdeal m.asIdeal ψ
        (congrArg PrimeSpectrum.asIdeal hp₀.symm) r
    have : Algebra.FormallyUnramified Ω Q_J := by
      refine ⟨⟨fun ω₁ ω₂ => ?_⟩⟩
      suffices hzero : ∀ ω : Ω[Q_J ⁄ Ω], ω = 0 by rw [hzero ω₁, hzero ω₂]
      intro ω
      have h_sub : Subsingleton Ω[Q_J ⁄ R] :=
        Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
      have h_map0 : KaehlerDifferential.map Ω R Q_J Q_J ω = 0 := Subsingleton.elim _ _
      obtain ⟨z, rfl⟩ := (KaehlerDifferential.exact_mapBaseChange_map Ω R Q_J ω).mp h_map0
      clear h_map0
      induction z using TensorProduct.induction_on with
      | zero => exact map_zero _
      | add x y hx hy => rw [map_add, hx, hy, add_zero]
      | tmul q u =>
        have hu_top : u ∈ (⊤ : Submodule R Ω[R ⁄ Ω]) := Submodule.mem_top
        rw [← KaehlerDifferential.span_range_derivation Ω R] at hu_top
        revert q
        induction hu_top using Submodule.span_induction with
        | mem x hx =>
          intro q
          rcases hx with ⟨r, rfl⟩
          rw [KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D]
          obtain ⟨c, hc⟩ := hResR r
          have hc_mR : algebraMap R L_R (r - algebraMap Ω R c) ∈ 𝔪_R :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff L_R p₀.asIdeal _).mpr hc
          have hc_J : algebraMap R L_D (r - algebraMap Ω R c) ∈ J := by
            rw [← h_to_map]
            exact Ideal.mem_map_of_mem ψ_loc hc_mR
          have h_eq_Q : algebraMap R Q_J r = algebraMap Ω Q_J c := by
            rw [IsScalarTower.algebraMap_apply Ω R Q_J]
            change Ideal.Quotient.mk J (algebraMap R L_D r) =
              Ideal.Quotient.mk J (algebraMap R L_D (algebraMap Ω R c))
            rw [Ideal.Quotient.eq, ← map_sub]
            exact hc_J
          rw [h_eq_Q, Derivation.map_algebraMap, smul_zero]
        | zero => intro q; rw [TensorProduct.tmul_zero, map_zero]
        | add x y _ _ hx hy => intro q; rw [TensorProduct.tmul_add, map_add, hx, hy, add_zero]
        | smul a x _ hx =>
          intro q
          rw [← TensorProduct.smul_tmul]
          exact hx (a • q)
    have hField : IsField Q_J :=
      Algebra.FormallyUnramified.isField_of_isAlgClosed_of_isLocalRing Ω Q_J
    have hBij : Function.Bijective (algebraMap Ω Q_J) :=
      Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing Ω Q_J
    have hJ_eq : J = 𝔪_D := by
      apply le_antisymm hJ_le
      intro y hy
      by_contra hyJ
      have hybar_ne : Ideal.Quotient.mk J y ≠ 0 :=
        fun h0 => hyJ (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      obtain ⟨zbar, hzy⟩ := hField.mul_inv_cancel hybar_ne
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective zbar
      have h1_sub : y * z - 1 ∈ J := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub, map_mul, map_one, hzy, sub_self]
      have h1_in : (1 : L_D) ∈ 𝔪_D := by
        have h_eq : (1 : L_D) = y * z - (y * z - 1) := by ring
        rw [h_eq]
        exact Ideal.sub_mem 𝔪_D (Ideal.mul_mem_right z 𝔪_D hy) (hJ_le h1_sub)
      exact (IsLocalRing.maximalIdeal.isMaximal L_D).ne_top
        (Ideal.eq_top_of_isUnit_mem 𝔪_D h1_in isUnit_one)
    have hResLD : ∀ y : L_D, ∃ c : Ω, y - algebraMap Ω L_D c ∈ 𝔪_D := by
      intro y
      obtain ⟨c, hc⟩ := hBij.2 (Ideal.Quotient.mk J y)
      refine ⟨c, ?_⟩
      rw [← hJ_eq]
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [map_sub]
      change Ideal.Quotient.mk J y - algebraMap Ω Q_J c = 0
      rw [hc, sub_self]
    have hResD : ∀ d : D, ∃ c : Ω, d - algebraMap Ω D c ∈ m.asIdeal := by
      intro d
      obtain ⟨c, hc⟩ := hResLD (algebraMap D L_D d)
      refine ⟨c, ?_⟩
      apply (IsLocalization.AtPrime.to_map_mem_maximal_iff L_D m.asIdeal _).mp
      rw [map_sub]
      exact hc
    let _ : Algebra L_R L_D := ψ_loc.toAlgebra
    have hFlat_ψ : ψ.Flat := show Module.Flat R D from inferInstance
    have hFlat_loc : ψ_loc.Flat := hFlat_ψ.localRingHom _ _ _
    have : Module.Flat L_R L_D := hFlat_loc
    have : Module.FaithfullyFlat L_R L_D := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hMapPow : ∀ k : ℕ, Ideal.map ψ_loc (𝔪_R ^ k) = 𝔪_D ^ k := fun k => by
      rw [Ideal.map_pow]
      exact congrArg (· ^ k) hJ_eq
    have hPow : ∀ (k : ℕ) (x : L_R), ψ_loc x ∈ 𝔪_D ^ k ↔ x ∈ 𝔪_R ^ k := by
      intro k x
      rw [← hMapPow k]
      change x ∈ Ideal.comap (algebraMap L_R L_D) (Ideal.map (algebraMap L_R L_D) (𝔪_R ^ k)) ↔
        x ∈ 𝔪_R ^ k
      rw [Ideal.comap_map_eq_self_of_faithfullyFlat (𝔪_R ^ k)]
    have hPsiAlg : ∀ c : Ω, ψ_loc (algebraMap Ω L_R c) = algebraMap Ω L_D c := fun c => by
      rw [IsScalarTower.algebraMap_apply Ω R L_R, h_to_map,
        ← IsScalarTower.algebraMap_apply Ω R L_D]
    have hLift : ∀ (k : ℕ) (y : L_D), ∃ x : L_R, y - ψ_loc x ∈ 𝔪_D ^ k := by
      intro k
      induction k with
      | zero =>
        intro y
        refine ⟨0, ?_⟩
        rw [pow_zero, Ideal.one_eq_top]
        trivial
      | succ k ih =>
        intro y
        obtain ⟨x_k, hxk⟩ := ih y
        have hw : y - ψ_loc x_k ∈ Ideal.map ψ_loc (𝔪_R ^ k) := by
          rwa [hMapPow k]
        have hStep : ∀ w ∈ Ideal.map ψ_loc (𝔪_R ^ k), ∃ x' : L_R, w - ψ_loc x' ∈ 𝔪_D ^ (k + 1) := by
          intro w hw_in
          induction hw_in using Submodule.span_induction with
          | mem z hz =>
            rcases hz with ⟨m_el, _, rfl⟩
            exact ⟨m_el, by rw [sub_self]; exact zero_mem _⟩
          | zero =>
            exact ⟨0, by rw [map_zero, sub_self]; exact zero_mem _⟩
          | add w₁ w₂ _ _ hw₁ hw₂ =>
            rcases hw₁ with ⟨x₁, hx₁⟩
            rcases hw₂ with ⟨x₂, hx₂⟩
            refine ⟨x₁ + x₂, ?_⟩
            have h_eq : (w₁ + w₂) - ψ_loc (x₁ + x₂) = (w₁ - ψ_loc x₁) + (w₂ - ψ_loc x₂) := by
              rw [map_add]; ring
            rw [h_eq]
            exact Ideal.add_mem _ hx₁ hx₂
          | smul u w₀ hw₀ ihw₀ =>
            rcases ihw₀ with ⟨x₀, hx₀⟩
            obtain ⟨c, hc⟩ := hResLD u
            refine ⟨algebraMap Ω L_R c * x₀, ?_⟩
            have hw₀_mk : w₀ ∈ 𝔪_D ^ k := by rwa [← hMapPow k]
            have hpsi_x₀_mk : ψ_loc x₀ ∈ 𝔪_D ^ k := by
              have h_eq : ψ_loc x₀ = w₀ - (w₀ - ψ_loc x₀) := by ring
              rw [h_eq]
              exact Ideal.sub_mem _ hw₀_mk (Ideal.pow_le_pow_right (Nat.le_succ k) hx₀)
            have h_eq : u • w₀ - ψ_loc (algebraMap Ω L_R c * x₀) =
                u * (w₀ - ψ_loc x₀) + (u - algebraMap Ω L_D c) * ψ_loc x₀ := by
              rw [smul_eq_mul, map_mul, hPsiAlg]
              ring
            rw [h_eq]
            refine Ideal.add_mem _ (Ideal.mul_mem_left _ u hx₀) ?_
            rw [pow_succ']
            exact Ideal.mul_mem_mul hc hpsi_x₀_mk
        obtain ⟨x', hx'⟩ := hStep (y - ψ_loc x_k) hw
        refine ⟨x_k + x', ?_⟩
        have h_eq : y - ψ_loc (x_k + x') = (y - ψ_loc x_k) - ψ_loc x' := by
          rw [map_add]; ring
        rw [h_eq]
        exact hx'
    exact ⟨hResD, hResLD, hJ_eq, hPow, hLift⟩
  
  letI : Algebra (PowerSeries Ω) Ω :=
    (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
  letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
  intro J_N q_Ω _hq_Ω m₀ ψ₁ ψ₂ _hψ₁ _hψ₂ _hm₀_qΩ _hXi _hCommΩ
  letI : Algebra Ω D_Ω := (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom).toAlgebra
  
  have h_part3 :
      (∃ p_N : PrimeSpectrum (MvPolynomial (Fin 2) Ω ⧸ J_N),
        p_N.asIdeal = Ideal.span
          {Ideal.Quotient.mk J_N (MvPolynomial.X 0),
           Ideal.Quotient.mk J_N (MvPolynomial.X 1)} ∧
        PrimeSpectrum.comap ψ₂ m₀ = p_N ∧
        (∀ r : MvPolynomial (Fin 2) Ω ⧸ J_N,
          ∃ c : Ω, r - algebraMap Ω (MvPolynomial (Fin 2) Ω ⧸ J_N) c ∈ p_N.asIdeal) ∧
        (let L_N := Localization.AtPrime p_N.asIdeal
         let loc_N : (MvPolynomial (Fin 2) Ω ⧸ J_N) →+* L_N :=
           algebraMap (MvPolynomial (Fin 2) Ω ⧸ J_N) L_N
         let 𝔪_N : Ideal L_N := IsLocalRing.maximalIdeal L_N
         ∀ c₀ c₁ : Ω,
           loc_N (algebraMap Ω (MvPolynomial (Fin 2) Ω ⧸ J_N) c₀) *
               loc_N (Ideal.Quotient.mk J_N (MvPolynomial.X 0)) +
             loc_N (algebraMap Ω (MvPolynomial (Fin 2) Ω ⧸ J_N) c₁) *
               loc_N (Ideal.Quotient.mk J_N (MvPolynomial.X 1)) ∈ 𝔪_N ^ 2 →
           c₀ = 0 ∧ c₁ = 0)) ∧
      Subsingleton (Algebra.H1Cotangent Ω D_Ω) ∧
      ∃ (i_rel : D_Ω →ₗ[D_Ω] (Fin 2 → D_Ω)) (p_rel : (Fin 2 → D_Ω) →ₗ[D_Ω] Ω[D_Ω ⁄ Ω]),
        Function.Injective i_rel ∧ Function.Surjective p_rel ∧ Function.Exact i_rel p_rel := by
    let P₂ := MvPolynomial (Fin 2) Ω
    let N_Ω := P₂ ⧸ J_N
    let π_N : P₂ →+* N_Ω := Ideal.Quotient.mk J_N
    let Xbar : Fin 2 → N_Ω := fun i => π_N (MvPolynomial.X i)
    let I_max : Ideal N_Ω := Ideal.span {Xbar 0, Xbar 1}
    have hJ_ker0 : ∀ x ∈ J_N, (MvPolynomial.aeval (0 : Fin 2 → Ω)).toRingHom x = 0 := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      rcases hx with ⟨q, rfl⟩
      change MvPolynomial.aeval (0 : Fin 2 → Ω) (MvPolynomial.X 0 * MvPolynomial.X 1 * q) = 0
      rw [map_mul, map_mul, MvPolynomial.aeval_X, Pi.zero_apply, zero_mul, zero_mul]
    let ev₀ : N_Ω →+* Ω :=
      Ideal.Quotient.lift J_N (MvPolynomial.aeval (0 : Fin 2 → Ω)).toRingHom hJ_ker0
    have h_mod_Imax : ∀ P : P₂,
        π_N P - algebraMap Ω N_Ω (MvPolynomial.aeval (0 : Fin 2 → Ω) P) ∈ I_max := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C c =>
        rw [MvPolynomial.aeval_C]
        change π_N (MvPolynomial.C c) - π_N (MvPolynomial.C c) ∈ I_max
        rw [sub_self]
        exact zero_mem _
      | add p q hp hq =>
        have heq : π_N (p + q) - algebraMap Ω N_Ω (MvPolynomial.aeval (0 : Fin 2 → Ω) (p + q)) =
            (π_N p - algebraMap Ω N_Ω (MvPolynomial.aeval (0 : Fin 2 → Ω) p)) +
            (π_N q - algebraMap Ω N_Ω (MvPolynomial.aeval (0 : Fin 2 → Ω) q)) := by
          rw [map_add, map_add, map_add]; ring
        rw [heq]
        exact Ideal.add_mem _ hp hq
      | mul_X p i _ =>
        rw [map_mul (MvPolynomial.aeval (0 : Fin 2 → Ω)), MvPolynomial.aeval_X,
          Pi.zero_apply, mul_zero, map_zero, sub_zero, map_mul]
        refine Ideal.mul_mem_left _ (π_N p) (Ideal.subset_span ?_)
        fin_cases i
        · exact Or.inl rfl
        · exact Or.inr rfl
    have hResN_ev : ∀ r : N_Ω, r - algebraMap Ω N_Ω (ev₀ r) ∈ I_max := by
      intro r
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      exact h_mod_Imax P
    have hKer_ev₀ : RingHom.ker ev₀ = I_max := by
      apply le_antisymm
      · intro r hr
        have hr0 : ev₀ r = 0 := hr
        simpa [hr0] using hResN_ev r
      · rw [Ideal.span_le]
        rintro x (rfl | rfl)
        · change Ideal.Quotient.lift J_N _ hJ_ker0 (Ideal.Quotient.mk J_N (MvPolynomial.X 0)) = 0
          rw [Ideal.Quotient.lift_mk]
          exact MvPolynomial.aeval_X (0 : Fin 2 → Ω) 0
        · change Ideal.Quotient.lift J_N _ hJ_ker0 (Ideal.Quotient.mk J_N (MvPolynomial.X 1)) = 0
          rw [Ideal.Quotient.lift_mk]
          exact MvPolynomial.aeval_X (0 : Fin 2 → Ω) 1
    have hev₀_surj : Function.Surjective ev₀ :=
      fun c => ⟨algebraMap Ω N_Ω c, MvPolynomial.aeval_C (0 : Fin 2 → Ω) c⟩
    have hI_max : I_max.IsMaximal :=
      hKer_ev₀ ▸ RingHom.ker_isMaximal_of_surjective ev₀ hev₀_surj
    let p_N : PrimeSpectrum N_Ω := ⟨I_max, hI_max.isPrime⟩
    have hp_N_comap : PrimeSpectrum.comap ψ₂ m₀ = p_N := by
      ext x
      have h_le : I_max ≤ (PrimeSpectrum.comap ψ₂ m₀).asIdeal := by
        rw [Ideal.span_le]
        rintro y (rfl | rfl)
        · exact _hXi 0
        · exact _hXi 1
      change x ∈ (PrimeSpectrum.comap ψ₂ m₀).asIdeal ↔ x ∈ I_max
      rw [hI_max.eq_of_le (PrimeSpectrum.comap ψ₂ m₀).isPrime.ne_top h_le]
    have hLinIndepN :
        let L_N := Localization.AtPrime p_N.asIdeal
        let loc_N : N_Ω →+* L_N := algebraMap N_Ω L_N
        let 𝔪_N : Ideal L_N := IsLocalRing.maximalIdeal L_N
        ∀ c₀ c₁ : Ω,
          loc_N (algebraMap Ω N_Ω c₀) * loc_N (Xbar 0) +
            loc_N (algebraMap Ω N_Ω c₁) * loc_N (Xbar 1) ∈ 𝔪_N ^ 2 →
          c₀ = 0 ∧ c₁ = 0 := by
      intro L_N loc_N 𝔪_N c₀ c₁ h_mem
      let L_poly : P₂ := MvPolynomial.C c₀ * MvPolynomial.X 0 + MvPolynomial.C c₁ * MvPolynomial.X 1
      have h_loc_eq : loc_N (π_N L_poly) =
          loc_N (algebraMap Ω N_Ω c₀) * loc_N (Xbar 0) +
            loc_N (algebraMap Ω N_Ω c₁) * loc_N (Xbar 1) := by
        dsimp only [L_poly, Xbar]
        rw [map_add, map_mul, map_mul, map_add, map_mul, map_mul]
        rfl
      rw [← h_loc_eq] at h_mem
      have hmN_sq : 𝔪_N ^ 2 = Ideal.map loc_N (I_max ^ 2) := by
        have hmax_eq : 𝔪_N = Ideal.map loc_N p_N.asIdeal :=
          Localization.AtPrime.map_eq_maximalIdeal.symm
        rw [hmax_eq]
        exact (Ideal.map_pow loc_N I_max 2).symm
      rw [hmN_sq] at h_mem
      rcases (IsLocalization.mem_map_algebraMap_iff p_N.asIdeal.primeCompl L_N).mp h_mem with
        ⟨⟨⟨y_in, hy_in⟩, s_sub⟩, hs_eq⟩
      dsimp only at hs_eq
      have hs_eq' : loc_N (π_N L_poly * (s_sub : N_Ω)) = loc_N y_in := by
        rw [map_mul]
        exact hs_eq
      obtain ⟨t_sub, ht_eq⟩ :=
        IsLocalization.exists_of_eq (M := p_N.asIdeal.primeCompl) hs_eq'
      let st_sub : p_N.asIdeal.primeCompl := t_sub * s_sub
      obtain ⟨S, hS_mk⟩ := Ideal.Quotient.mk_surjective (st_sub : N_Ω)
      have hS0_ne : MvPolynomial.aeval (0 : Fin 2 → Ω) S ≠ 0 := by
        intro h0
        apply st_sub.2
        rw [← hS_mk]
        change π_N S ∈ I_max
        rw [← hKer_ev₀]
        exact h0
      let I₀ : Ideal P₂ := Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
      have hMapI₀ : Ideal.map π_N (I₀ ^ 2) = I_max ^ 2 := by
        rw [Ideal.map_pow, Ideal.map_span, Set.image_pair]
      have hJN_le_I₀sq : J_N ≤ I₀ ^ 2 := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, sq]
        exact Ideal.mul_mem_mul (Ideal.subset_span (Or.inl rfl)) (Ideal.subset_span (Or.inr rfl))
      have hSL_in_I₀sq : S * L_poly ∈ I₀ ^ 2 := by
        have h_comap : S * L_poly ∈ Ideal.comap π_N (Ideal.map π_N (I₀ ^ 2)) := by
          rw [Ideal.mem_comap, hMapI₀, map_mul]
          have h_prod : π_N S * π_N L_poly = (t_sub : N_Ω) * y_in := by
            calc π_N S * π_N L_poly
                = ((t_sub : N_Ω) * (s_sub : N_Ω)) * π_N L_poly := by rw [hS_mk]; rfl
              _ = (t_sub : N_Ω) * (π_N L_poly * (s_sub : N_Ω)) := by ring
              _ = (t_sub : N_Ω) * y_in := ht_eq
          rw [h_prod]
          exact Ideal.mul_mem_left _ _ hy_in
        rw [Ideal.comap_map_of_surjective π_N Ideal.Quotient.mk_surjective] at h_comap
        change S * L_poly ∈ I₀ ^ 2 ⊔ RingHom.ker π_N at h_comap
        have hker : RingHom.ker π_N = J_N := Ideal.mk_ker
        rw [hker, sup_eq_left.mpr hJN_le_I₀sq] at h_comap
        exact h_comap
      have haeval_I₀ : ∀ f ∈ I₀, MvPolynomial.aeval (0 : Fin 2 → Ω) f = 0 := by
        intro f hf
        have hle : I₀ ≤ RingHom.ker (MvPolynomial.aeval (0 : Fin 2 → Ω)).toRingHom := by
          rw [Ideal.span_le]
          rintro x (rfl | rfl)
          · exact MvPolynomial.aeval_X (0 : Fin 2 → Ω) 0
          · exact MvPolynomial.aeval_X (0 : Fin 2 → Ω) 1
        exact hle hf
      have hpderiv_I₀sq : ∀ Q ∈ I₀ ^ 2, ∀ i : Fin 2,
          MvPolynomial.aeval (0 : Fin 2 → Ω) (MvPolynomial.pderiv i Q) = 0 := by
        intro Q hQ i
        rw [sq] at hQ
        refine Submodule.mul_induction_on hQ ?_ ?_
        · intro f hf g hg
          rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
            haeval_I₀ f hf, haeval_I₀ g hg, zero_mul, zero_mul, add_zero]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy, add_zero]
      have h0 := hpderiv_I₀sq (S * L_poly) hSL_in_I₀sq 0
      have h1 := hpderiv_I₀sq (S * L_poly) hSL_in_I₀sq 1
      have hL0 : MvPolynomial.aeval (0 : Fin 2 → Ω) L_poly = 0 := by
        simp [L_poly]
      have hp0 : MvPolynomial.aeval (0 : Fin 2 → Ω) (MvPolynomial.pderiv 0 L_poly) = c₀ := by
        simp [L_poly, MvPolynomial.pderiv_X]
      have hp1 : MvPolynomial.aeval (0 : Fin 2 → Ω) (MvPolynomial.pderiv 1 L_poly) = c₁ := by
        simp [L_poly, MvPolynomial.pderiv_X]
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
        hL0, hp0, zero_mul, add_zero] at h0
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
        hL0, hp1, zero_mul, add_zero] at h1
      exact ⟨(mul_eq_zero.mp h0).resolve_left hS0_ne, (mul_eq_zero.mp h1).resolve_left hS0_ne⟩
    let μ_N : N_Ω →ₗ[N_Ω] (Fin 2 → N_Ω) :=
      { toFun := fun y => ![y * Xbar 1, y * Xbar 0]
        map_add' := fun y₁ y₂ => by
          ext i; fin_cases i <;> simp [add_mul]
        map_smul' := fun r y => by
          ext i; fin_cases i <;> simp [smul_eq_mul, mul_assoc] }
    have hμ_inj : Function.Injective μ_N := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro y hy
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hy0 : π_N (f * MvPolynomial.X 1) = 0 := by
        have h := congr_fun hy 0
        simpa [μ_N, Xbar] using h
      have hy1 : π_N (f * MvPolynomial.X 0) = 0 := by
        have h := congr_fun hy 1
        simpa [μ_N, Xbar] using h
      obtain ⟨g, hg⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hy0)
      obtain ⟨h, hh⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hy1)
      have hf_eq : f = MvPolynomial.X 0 * g := by
        apply mul_right_cancel₀ (MvPolynomial.X_ne_zero (R := Ω) (1 : Fin 2))
        linear_combination hg
      have hg_eq : g * MvPolynomial.X 0 = MvPolynomial.X 1 * h := by
        apply mul_right_cancel₀ (MvPolynomial.X_ne_zero (R := Ω) (0 : Fin 2))
        linear_combination hh - MvPolynomial.X 0 * hf_eq
      let φ₀ : P₂ →ₐ[Ω] P₂ := MvPolynomial.aeval (![MvPolynomial.X 0, 0] : Fin 2 → P₂)
      have hφ₀_X0 : φ₀ (MvPolynomial.X 0) = MvPolynomial.X 0 := by
        dsimp only [φ₀]
        rw [MvPolynomial.aeval_X, Matrix.cons_val_zero]
      have hφ₀_X1 : φ₀ (MvPolynomial.X 1) = 0 := by
        dsimp only [φ₀]
        rw [MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero]
      have hφ₀_g_mul : φ₀ g * MvPolynomial.X 0 = 0 := by
        have hmap := congrArg φ₀ hg_eq
        rw [map_mul, map_mul, hφ₀_X0, hφ₀_X1, zero_mul] at hmap
        exact hmap
      have hφ₀_g : φ₀ g = 0 :=
        (mul_eq_zero.mp hφ₀_g_mul).resolve_right (MvPolynomial.X_ne_zero (R := Ω) (0 : Fin 2))
      have h_sub_X1 : ∀ P : P₂, P - φ₀ P ∈ Ideal.span {MvPolynomial.X (1 : Fin 2)} := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C c =>
          dsimp only [φ₀]
          rw [MvPolynomial.aeval_C]
          change MvPolynomial.C c - MvPolynomial.C c ∈ _
          rw [sub_self]
          exact zero_mem _
        | add p q hp hq =>
          have heq : (p + q) - φ₀ (p + q) = (p - φ₀ p) + (q - φ₀ q) := by
            rw [map_add]; ring
          rw [heq]
          exact Ideal.add_mem _ hp hq
        | mul_X p i ih =>
          have hi : i = 0 ∨ i = 1 := by
            fin_cases i
            · exact Or.inl rfl
            · exact Or.inr rfl
          rcases hi with rfl | rfl
          · have heq : p * MvPolynomial.X 0 - φ₀ (p * MvPolynomial.X 0) =
                (p - φ₀ p) * MvPolynomial.X 0 := by
              rw [map_mul, hφ₀_X0]; ring
            rw [heq]
            exact Ideal.mul_mem_right _ _ ih
          · have heq : p * MvPolynomial.X 1 - φ₀ (p * MvPolynomial.X 1) =
                p * MvPolynomial.X 1 := by
              rw [map_mul, hφ₀_X1, mul_zero, sub_zero]
            rw [heq]
            exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      have hg_in_X1 : g ∈ Ideal.span {MvPolynomial.X (1 : Fin 2)} := by
        simpa [hφ₀_g] using h_sub_X1 g
      obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hg_in_X1
      change π_N f = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      refine Ideal.mem_span_singleton.mpr ⟨q, ?_⟩
      rw [hf_eq, hq]
      ring
    let I_ker : Ideal P₂ := RingHom.ker (algebraMap P₂ N_Ω)
    have hI_ker_eq : I_ker = J_N := Ideal.mk_ker
    let b_P := KaehlerDifferential.mvPolynomialBasis Ω (Fin 2)
    let e_free : (TensorProduct P₂ N_Ω Ω[P₂ ⁄ Ω]) ≃ₗ[N_Ω] (Fin 2 → N_Ω) :=
      (b_P.baseChange N_Ω).equivFun
    have h_free_D : ∀ F : P₂,
        e_free (TensorProduct.tmul P₂ (1 : N_Ω) (KaehlerDifferential.D Ω P₂ F)) =
          fun i => π_N (MvPolynomial.pderiv i F) := by
      intro F
      ext i
      rw [Module.Basis.equivFun_apply, Module.Basis.baseChange_repr_tmul,
        KaehlerDifferential.mvPolynomialBasis_repr_apply]
      change π_N (MvPolynomial.pderiv i F) * 1 = π_N (MvPolynomial.pderiv i F)
      exact mul_one _
    have h_X0X1_zero : π_N (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have h_cot_eq : ∀ (f : P₂) (hx : (MvPolynomial.X 0 * MvPolynomial.X 1) * f ∈ I_ker),
        e_free (KaehlerDifferential.kerCotangentToTensor Ω P₂ N_Ω
          (I_ker.toCotangent ⟨(MvPolynomial.X 0 * MvPolynomial.X 1) * f, hx⟩)) =
          μ_N (π_N f) := by
      intro f hx
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent, h_free_D]
      ext i
      have hi : i = 0 ∨ i = 1 := by
        fin_cases i
        · exact Or.inl rfl
        · exact Or.inr rfl
      rcases hi with rfl | rfl
      · dsimp only [μ_N, Xbar, LinearMap.coe_mk, AddHom.coe_mk, Matrix.cons_val_zero]
        simp only [Derivation.leibniz, smul_eq_mul]
        rw [MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_X_of_ne (by decide : (1 : Fin 2) ≠ 0),
          map_add, map_mul, h_X0X1_zero, zero_mul, zero_add, map_mul, map_add]
        simp only [map_one, map_zero, map_mul]
        ring
      · dsimp only [μ_N, Xbar, LinearMap.coe_mk, AddHom.coe_mk, Matrix.cons_val_one, Matrix.cons_val_zero]
        simp only [Derivation.leibniz, smul_eq_mul]
        rw [MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_X_of_ne (by decide : (0 : Fin 2) ≠ 1),
          map_add, map_mul, h_X0X1_zero, zero_mul, zero_add, map_mul, map_add]
        simp only [map_one, map_zero, map_mul]
        ring
    have h_ker_inj : Function.Injective (KaehlerDifferential.kerCotangentToTensor Ω P₂ N_Ω) := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro c hc
      obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective I_ker c
      obtain ⟨f, rfl⟩ := Ideal.mem_span_singleton.mp (hI_ker_eq ▸ hx)
      have hμ0 : μ_N (π_N f) = 0 := by
        rw [← h_cot_eq f hx, LinearMap.mem_ker.mp hc, map_zero]
      have hf0 : π_N f = 0 := hμ_inj (hμ0.trans (map_zero μ_N).symm)
      have hf_in : f ∈ I_ker := hf0
      have hx01_in : MvPolynomial.X 0 * MvPolynomial.X 1 ∈ I_ker :=
        hI_ker_eq.symm ▸ Ideal.subset_span rfl
      rw [Submodule.mem_bot, Ideal.toCotangent_eq_zero, sq]
      exact Ideal.mul_mem_mul hx01_in hf_in
    have : Subsingleton (Algebra.H1Cotangent Ω N_Ω) :=
      (Algebra.FormallySmooth.kerCotangentToTensor_injective_iff (P := P₂)
        Ideal.Quotient.mk_surjective).mp h_ker_inj
    let p_N_diff : (Fin 2 → N_Ω) →ₗ[N_Ω] Ω[N_Ω ⁄ Ω] :=
      (KaehlerDifferential.mapBaseChange Ω P₂ N_Ω).comp e_free.symm.toLinearMap
    have hp_N_surj : Function.Surjective p_N_diff :=
      (KaehlerDifferential.mapBaseChange_surjective Ω P₂ N_Ω Ideal.Quotient.mk_surjective).comp
        e_free.symm.surjective
    have h_exact_N : Function.Exact μ_N p_N_diff := by
      intro v
      have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange Ω P₂ N_Ω
        Ideal.Quotient.mk_surjective (e_free.symm v)
      change KaehlerDifferential.mapBaseChange Ω P₂ N_Ω (e_free.symm v) = 0 ↔
        v ∈ Set.range μ_N
      rw [hex]
      constructor
      · rintro ⟨c, hc⟩
        obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective I_ker c
        obtain ⟨f, rfl⟩ := Ideal.mem_span_singleton.mp (hI_ker_eq ▸ hx)
        refine ⟨π_N f, ?_⟩
        rw [← h_cot_eq f hx, hc, LinearEquiv.apply_symm_apply]
      · rintro ⟨y, rfl⟩
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hx : (MvPolynomial.X 0 * MvPolynomial.X 1) * f ∈ I_ker :=
          hI_ker_eq.symm ▸ Ideal.mem_span_singleton.mpr ⟨f, rfl⟩
        refine ⟨I_ker.toCotangent ⟨(MvPolynomial.X 0 * MvPolynomial.X 1) * f, hx⟩, ?_⟩
        apply e_free.injective
        rw [LinearEquiv.apply_symm_apply, h_cot_eq f hx]
    let _ : Algebra N_Ω D_Ω := ψ₂.toAlgebra
    have : IsScalarTower Ω N_Ω D_Ω :=
      @IsScalarTower.of_algebraMap_eq Ω N_Ω D_Ω _ _ _ _ _ _ fun c => by
        change (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom) c = _
        rw [_hCommΩ]
        rfl
    have : Algebra.Etale N_Ω D_Ω := RingHom.Etale.toAlgebra _hψ₂
    have hH1_D : Subsingleton (Algebra.H1Cotangent Ω D_Ω) := by
      let P := Algebra.Generators.self Ω N_Ω
      let Q := Algebra.Generators.self N_Ω D_Ω
      have : Algebra.FormallySmooth Ω P.toExtension.Ring :=
        show Algebra.FormallySmooth Ω (MvPolynomial _ Ω) from inferInstance
      have : Algebra.FormallySmooth N_Ω Q.toExtension.Ring :=
        show Algebra.FormallySmooth N_Ω (MvPolynomial _ N_Ω) from inferInstance
      have : Algebra.FormallySmooth Ω (Q.comp P).toExtension.Ring :=
        show Algebra.FormallySmooth Ω (MvPolynomial _ Ω) from inferInstance
      rw [← Algebra.Extension.cotangentComplex_injective_iff (Q.comp P).toExtension,
        ← LinearMap.ker_eq_bot, eq_bot_iff]
      intro x hx
      rw [LinearMap.mem_ker] at hx
      have hP_inj : Function.Injective P.toExtension.cotangentComplex :=
        (Algebra.Extension.cotangentComplex_injective_iff P.toExtension).mpr inferInstance
      have hQ_inj : Function.Injective Q.toExtension.cotangentComplex :=
        (Algebra.Extension.cotangentComplex_injective_iff Q.toExtension).mpr
          Algebra.FormallyEtale.subsingleton_h1Cotangent
      have hxQ : Algebra.Extension.Cotangent.map (Q.ofComp P).toExtensionHom x = 0 := by
        apply hQ_inj
        rw [← Algebra.Extension.CotangentSpace.map_cotangentComplex, hx, map_zero, map_zero]
      obtain ⟨z, rfl⟩ := (Algebra.Generators.Cotangent.exact Q P x).mp hxQ
      have hcomm := LinearMap.congr_fun
        (Algebra.Generators.H1Cotangent.map_comp_cotangentComplex_baseChange Q P) z
      dsimp only [LinearMap.comp_apply] at hcomm
      rw [hx] at hcomm
      have hz_bc : LinearMap.baseChange D_Ω P.toExtension.cotangentComplex z = 0 :=
        Algebra.Generators.CotangentSpace.map_toComp_injective Q P
          (hcomm.trans (map_zero _).symm)
      have hbc_inj : Function.Injective (LinearMap.lTensor D_Ω P.toExtension.cotangentComplex) :=
        Module.Flat.lTensor_preserves_injective_linearMap P.toExtension.cotangentComplex hP_inj
      have hz0 : z = 0 := hbc_inj (hz_bc.trans (map_zero _).symm)
      rw [Submodule.mem_bot, hz0, map_zero]
