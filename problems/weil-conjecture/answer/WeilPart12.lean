    let Pi1_Y := ∀ i : Fin M, AY (W i)
    let Pi2_Y := ∀ p : Fin M × Fin M, AY (W p.1 ⊓ W p.2)
    let Pi1_P := ∀ i : Fin M, AP (W i)
    let Pi2_P := ∀ p : Fin M × Fin M, AP (W p.1 ⊓ W p.2)
