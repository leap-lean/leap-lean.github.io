                (AlgebraicGeometry.Spec.map ιR_hom).app (hU₀.fromSpec ⁻¹ᵁ U₀)) ≫ m₂) ≫
                (m₃ ≫ g_hom) :=
                congrArg (· ≫ (m₃ ≫ g_hom)) h_app_eq
          _ = (((AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).inv ≫
                ((AlgebraicGeometry.Spec.map ιR_hom).app ⊤ ≫ m₁)) ≫ m₂) ≫
                (m₃ ≫ g_hom) :=
                congrArg (fun x => (x ≫ m₂) ≫ (m₃ ≫ g_hom)) h_mid
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).inv ≫
                ((AlgebraicGeometry.Spec.map ιR_hom).app ⊤ ≫
                  (((m₁ ≫ m₂) ≫ m₃) ≫ g_hom)) := by
                simp only [CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).inv ≫
                ((AlgebraicGeometry.Spec.map ιR_hom).app ⊤ ≫ (𝟙 _ ≫ g_hom)) :=
