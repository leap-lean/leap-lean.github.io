    fun c₁ P₁ hP₁ => (hMob₁ m₁₁ m₁₂ m₂₁ m₂₂ hm₁ hm₂ hDet c₁ P₁ hP₁).1
  have hCh2 : ∀ (P₂ : AlgebraicGeometry.Spec R₂),
