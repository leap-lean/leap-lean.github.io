      have hGD_step : ∀ (R_1 R_2 : CommRingCat.{u})
          (q_hom : AlgebraicGeometry.Spec R_2 ⟶ AlgebraicGeometry.Spec R_1)
          (_ : AlgebraicGeometry.Etale q_hom)
          (p : Ideal ↑R_1) (_ : p.IsPrime)
          (v₀ : AlgebraicGeometry.Spec R_2),
