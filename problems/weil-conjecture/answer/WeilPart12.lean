    have hRange_W'' : Set.range (W''.ι ≫ fst'').base ⊆ Set.range (π ⁻¹ᵁ U_compl).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
