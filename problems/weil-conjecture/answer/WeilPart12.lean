          (IsLocalization.Away.lift_eq (X_var ℓ) hu_L (X_var ℓ)).symm
        conv_lhs => rhs; rw [h_u]
        rw [← map_mul, ht_away_spec ℓ c, IsLocalization.Away.lift_eq]
      have h_step_R : f_R (t_away ℓ' b).val * α_mul (X_var ℓ') = α_mul (X_var b) := by
        change (IsLocalization.Away.lift (X_var ℓ') hu_R (t_away ℓ' b).val) *
          α_mul (X_var ℓ') = α_mul (X_var b)
        have h_u : α_mul (X_var ℓ') =
            IsLocalization.Away.lift (X_var ℓ') hu_R
              (algebraMap M_poly (Localization.Away (X_var ℓ')) (X_var ℓ')) :=
          (IsLocalization.Away.lift_eq (X_var ℓ') hu_R (X_var ℓ')).symm
        conv_lhs => rhs; rw [h_u]
        rw [← map_mul, ht_away_spec ℓ' b, IsLocalization.Away.lift_eq]
      calc (f_R (t_away ℓ' b).val * f_L (t_away ℓ ℓ').val) * α_mul (X_var ℓ * X_var ℓ')
          = (f_R (t_away ℓ' b).val * α_mul (X_var ℓ')) *
            (f_L (t_away ℓ ℓ').val * α_mul (X_var ℓ)) := by rw [map_mul]; ring
        _ = α_mul (X_var b) * α_mul (X_var ℓ') := by rw [h_step_R, h_step_L ℓ']
        _ = (f_L (t_away ℓ b).val * α_mul (X_var ℓ)) * α_mul (X_var ℓ') := by rw [h_step_L b]
        _ = f_L (t_away ℓ b).val * α_mul (X_var ℓ * X_var ℓ') := by rw [map_mul]; ring
    exact ⟨P_A, p_P, D, hAff_A, c_A, t_A, π_proj, hProp_P, hCov_P, hBase_P, ht_diag_P,
      hClos_P, hπ_c, hπ_t, hInter_P, hCocyc_c, hCocyc_t⟩
  obtain ⟨P_A, p_P, D, hAff_A, c_A, t_A, π_proj, hProp_P, hCov_P, hBase_P, ht_diag_P,
    hClos_P, hπ_c, hπ_t, hInter_P, hCocyc_c, hCocyc_t⟩ := hPart0
  
  have hPart2 :
      ∃ (U_tilde : Scheme.{u})
        (π_U : U_tilde ⟶ Spec (CommRingCat.of A))
        (ι_cov : ∀ ℓ : Fin (d + 1), Spec (CommRingCat.of (C_chart ℓ)) ⟶ U_tilde),
        U_tilde.IsSeparated ∧
        IsProper π_U ∧
        AlgebraicGeometry.IsIntegral U_tilde ∧
        (∀ ℓ : Fin (d + 1), IsOpenImmersion (ι_cov ℓ)) ∧
        ((⋃ ℓ : Fin (d + 1), Set.range (ι_cov ℓ).base) = Set.univ) ∧
        (∀ ℓ : Fin (d + 1),
          ι_cov ℓ ≫ π_U = Spec.map (CommRingCat.ofHom (p_chart ℓ))) ∧
        (∀ ℓ ℓ' : Fin (d + 1),
          (ι_cov ℓ).base ⁻¹' Set.range (ι_cov ℓ').base =
            (PrimeSpectrum.basicOpen (r_chart ℓ ℓ')).1) ∧
        AlgebraicGeometry.Flat (π_U ≫ Spec.map (CommRingCat.ofHom φ_R)) ∧
        AlgebraicGeometry.LocallyOfFinitePresentation
          (π_U ≫ Spec.map (CommRingCat.ofHom φ_R)) ∧
        (∃ (N_cov : ℕ) (V_cov : Fin N_cov → U_tilde.Opens)
            (hAffV : ∀ ℓ : Fin N_cov, IsAffineOpen (V_cov ℓ))
            (t_gen : ∀ ℓ : Fin N_cov, ↑(U_tilde.presheaf.obj (Opposite.op (V_cov ℓ)))),
          ((⋃ ℓ : Fin N_cov, (V_cov ℓ : Set U_tilde)) = Set.univ) ∧
          ∀ ℓ : Fin N_cov,
            t_gen ℓ ∈ nonZeroDivisors ↑(U_tilde.presheaf.obj (Opposite.op (V_cov ℓ))) ∧
            Ideal.map (Spec.preimage ((hAffV ℓ).fromSpec ≫ π_U)).hom m_A =
              Ideal.span {t_gen ℓ}) := by
    have haK_ne : ∀ ℓ : Fin (d + 1), ι_K (a ℓ) ≠ 0 :=
      fun ℓ h => ha_ne ℓ (hinj_K (h.trans (map_zero _).symm))
    have hSurj_π : ∀ ℓ : Fin (d + 1), Function.Surjective (π_proj ℓ) := by
      intro ℓ
      have hRange_top : (π_proj ℓ).range = ⊤ := by
        rw [eq_top_iff, ← hClosure ℓ, Subring.closure_le]
        rintro y (⟨x, rfl⟩ | ⟨j, rfl⟩)
        · exact ⟨c_A ℓ x, congrFun (congrArg DFunLike.coe (hπ_c ℓ)) x⟩
        · exact ⟨t_A ℓ j, hπ_t ℓ j⟩
      intro y
      exact (eq_top_iff.mp hRange_top) trivial
    let ψ : ∀ ℓ : Fin (d + 1), ↑(P_A.presheaf.obj (Opposite.op (D ℓ))) →+* K_A :=
      fun ℓ => (ι_chart ℓ).comp (π_proj ℓ)
    have hψ_c : ∀ (ℓ : Fin (d + 1)) (r : A), ψ ℓ (c_A ℓ r) = ι_K r := by
      intro ℓ r
      change (ι_chart ℓ) (π_proj ℓ (c_A ℓ r)) = ι_K r
      have h1 : π_proj ℓ (c_A ℓ r) = p_chart ℓ r :=
        congrFun (congrArg DFunLike.coe (hπ_c ℓ)) r
      rw [h1]
      exact congrFun (congrArg DFunLike.coe (hComp_ιp ℓ)) r
    have hψ_t : ∀ (ℓ j : Fin (d + 1)), ψ ℓ (t_A ℓ j) = ι_K (a j) * (ι_K (a ℓ))⁻¹ := by
      intro ℓ j
      change ι_chart ℓ (π_proj ℓ (t_A ℓ j)) = _
      rw [hπ_t ℓ j, hr_val ℓ j]
    let γ : ∀ ℓ : Fin (d + 1), Spec (CommRingCat.of K_A) ⟶ P_A :=
      fun ℓ => Spec.map (CommRingCat.ofHom (ψ ℓ)) ≫ (hAff_A ℓ).fromSpec
    have hLocInter : ∀ {U W : P_A.Opens} (hAffU : IsAffineOpen U)
        (s : ↑(P_A.presheaf.obj (Opposite.op U))) (hBW : P_A.basicOpen s = W) (hWU : W ≤ U),
        @IsLocalization.Away ↑(P_A.presheaf.obj (Opposite.op U)) _ s
          ↑(P_A.presheaf.obj (Opposite.op W)) _
          ((P_A.presheaf.map (homOfLE hWU).op).hom).toAlgebra := by
      intro U W hAffU s hBW hWU
      let R_U := ↑(P_A.presheaf.obj (Opposite.op U))
      let res_B := (P_A.presheaf.map (homOfLE (P_A.basicOpen_le s)).op).hom
      let res_W := (P_A.presheaf.map (homOfLE hWU).op).hom
      let _ : Algebra R_U ↑(P_A.presheaf.obj (Opposite.op (P_A.basicOpen s))) := res_B.toAlgebra
      let _ : Algebra R_U ↑(P_A.presheaf.obj (Opposite.op W)) := res_W.toAlgebra
      have _ : IsLocalization.Away s ↑(P_A.presheaf.obj (Opposite.op (P_A.basicOpen s))) :=
        hAffU.isLocalization_basicOpen s
      let iso_BW := P_A.presheaf.mapIso (eqToIso hBW.symm).op
      have hcomp_eq : iso_BW.hom.hom.comp res_B = res_W := by
        have h_cat : P_A.presheaf.map (homOfLE (P_A.basicOpen_le s)).op ≫ iso_BW.hom =
            P_A.presheaf.map (homOfLE hWU).op := by
          change P_A.presheaf.map (homOfLE (P_A.basicOpen_le s)).op ≫
            P_A.presheaf.map (eqToHom hBW.symm).op = _
          rw [← P_A.presheaf.map_comp]
          congr 1
        exact congrArg ConcreteCategory.hom h_cat
      let e_alg : ↑(P_A.presheaf.obj (Opposite.op (P_A.basicOpen s))) ≃ₐ[R_U]
          ↑(P_A.presheaf.obj (Opposite.op W)) :=
        AlgEquiv.ofRingEquiv (f := iso_BW.commRingCatIsoToRingEquiv)
          (fun x => congrFun (congrArg DFunLike.coe hcomp_eq) x)
      exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers s) e_alg
    have hγ_eq : ∀ ℓ ℓ' : Fin (d + 1), γ ℓ = γ ℓ' := by
      intro ℓ ℓ'
      let U_inter : P_A.Opens := D ℓ ⊓ D ℓ'
      have hEq_L : P_A.basicOpen (t_A ℓ ℓ') = U_inter := hInter_P ℓ ℓ'
      have hEq_R : P_A.basicOpen (t_A ℓ' ℓ) = U_inter := (hInter_P ℓ' ℓ).trans (inf_comm _ _)
      have hAff_inter : IsAffineOpen U_inter := hEq_L ▸ (hAff_A ℓ).basicOpen (t_A ℓ ℓ')
      let res_L := (P_A.presheaf.map (homOfLE (inf_le_left : U_inter ≤ D ℓ)).op).hom
      let res_R := (P_A.presheaf.map (homOfLE (inf_le_right : U_inter ≤ D ℓ')).op).hom
      let algL : Algebra ↑(P_A.presheaf.obj (Opposite.op (D ℓ)))
          ↑(P_A.presheaf.obj (Opposite.op U_inter)) := res_L.toAlgebra
      have locL : @IsLocalization.Away _ _ (t_A ℓ ℓ')
          ↑(P_A.presheaf.obj (Opposite.op U_inter)) _ algL :=
        hLocInter (hAff_A ℓ) (t_A ℓ ℓ') hEq_L inf_le_left
      have hu_L : IsUnit (ψ ℓ (t_A ℓ ℓ')) := by
        rw [hψ_t ℓ ℓ']
        exact IsUnit.mk0 _ (mul_ne_zero (haK_ne ℓ') (inv_ne_zero (haK_ne ℓ)))
      let φ₁ : ↑(P_A.presheaf.obj (Opposite.op U_inter)) →+* K_A :=
        @IsLocalization.Away.lift _ _ _ _ algL K_A _ (t_A ℓ ℓ') locL (ψ ℓ) hu_L
      have hφ₁_comp : φ₁.comp res_L = ψ ℓ := by
        ext x
        exact @IsLocalization.Away.lift_eq _ _ _ _ algL K_A _ (t_A ℓ ℓ') locL (ψ ℓ) hu_L x
      let algR : Algebra ↑(P_A.presheaf.obj (Opposite.op (D ℓ')))
          ↑(P_A.presheaf.obj (Opposite.op U_inter)) := res_R.toAlgebra
      have locR : @IsLocalization.Away _ _ (t_A ℓ' ℓ)
          ↑(P_A.presheaf.obj (Opposite.op U_inter)) _ algR :=
        hLocInter (hAff_A ℓ') (t_A ℓ' ℓ) hEq_R inf_le_right
      have hu_R : IsUnit (ψ ℓ' (t_A ℓ' ℓ)) := by
        rw [hψ_t ℓ' ℓ]
        exact IsUnit.mk0 _ (mul_ne_zero (haK_ne ℓ) (inv_ne_zero (haK_ne ℓ')))
      let φ₂ : ↑(P_A.presheaf.obj (Opposite.op U_inter)) →+* K_A :=
        @IsLocalization.Away.lift _ _ _ _ algR K_A _ (t_A ℓ' ℓ) locR (ψ ℓ') hu_R
      have hφ₂_comp : φ₂.comp res_R = ψ ℓ' := by
        ext x
        exact @IsLocalization.Away.lift_eq _ _ _ _ algR K_A _ (t_A ℓ' ℓ) locR (ψ ℓ') hu_R x
      have hφ₂_resR : ∀ y, φ₂ (res_R y) = ψ ℓ' y :=
        fun y => congrFun (congrArg DFunLike.coe hφ₂_comp) y
      have hφ_eq : φ₁ = φ₂ := by
        apply @IsLocalization.ringHom_ext _ _ (Submonoid.powers (t_A ℓ ℓ'))
          ↑(P_A.presheaf.obj (Opposite.op U_inter)) _ algL locL K_A _
        change φ₁.comp res_L = φ₂.comp res_L
        rw [hφ₁_comp]
        have hEq_sub : RingHom.eqLocus (ψ ℓ) (φ₂.comp res_L) = ⊤ := by
          rw [eq_top_iff, ← hClos_P ℓ, Subring.closure_le]
          rintro y (⟨r, rfl⟩ | ⟨j, rfl⟩)
          · show ψ ℓ (c_A ℓ r) = φ₂ (res_L (c_A ℓ r))
            rw [← hCocyc_c ℓ ℓ' r, hφ₂_resR, hψ_c ℓ' r, hψ_c ℓ r]
          · show ψ ℓ (t_A ℓ j) = φ₂ (res_L (t_A ℓ j))
            have h_inv_step : φ₂ (res_L (t_A ℓ ℓ')) = ι_K (a ℓ') * (ι_K (a ℓ))⁻¹ := by
              have hc0 := congrArg φ₂ (hCocyc_t ℓ ℓ' ℓ)
              rw [ht_diag_P ℓ, map_one, map_one, map_mul, hφ₂_resR, hψ_t ℓ' ℓ] at hc0
              have h_unit_cancel :
                  (ι_K (a ℓ') * (ι_K (a ℓ))⁻¹) * (ι_K (a ℓ) * (ι_K (a ℓ'))⁻¹) = 1 := by
                calc (ι_K (a ℓ') * (ι_K (a ℓ))⁻¹) * (ι_K (a ℓ) * (ι_K (a ℓ'))⁻¹)
                    = (ι_K (a ℓ') * (ι_K (a ℓ'))⁻¹) * (ι_K (a ℓ) * (ι_K (a ℓ))⁻¹) := by ring
                  _ = 1 := by rw [mul_inv_cancel₀ (haK_ne ℓ'), mul_inv_cancel₀ (haK_ne ℓ), mul_one]
              calc φ₂ (res_L (t_A ℓ ℓ'))
                  = ((ι_K (a ℓ') * (ι_K (a ℓ))⁻¹) * (ι_K (a ℓ) * (ι_K (a ℓ'))⁻¹)) *
                      φ₂ (res_L (t_A ℓ ℓ')) := by rw [h_unit_cancel, one_mul]
                _ = (ι_K (a ℓ') * (ι_K (a ℓ))⁻¹) *
                      ((ι_K (a ℓ) * (ι_K (a ℓ'))⁻¹) * φ₂ (res_L (t_A ℓ ℓ'))) := by ring
                _ = ι_K (a ℓ') * (ι_K (a ℓ))⁻¹ := by rw [hc0, mul_one]
            have hcj := congrArg φ₂ (hCocyc_t ℓ ℓ' j)
            rw [map_mul, hφ₂_resR, hψ_t ℓ' j, h_inv_step] at hcj
            rw [← hcj, hψ_t ℓ j]
            symm
            calc (ι_K (a j) * (ι_K (a ℓ'))⁻¹) * (ι_K (a ℓ') * (ι_K (a ℓ))⁻¹)
                = ι_K (a j) * ((ι_K (a ℓ'))⁻¹ * ι_K (a ℓ')) * (ι_K (a ℓ))⁻¹ := by ring
              _ = ι_K (a j) * (ι_K (a ℓ))⁻¹ := by rw [inv_mul_cancel₀ (haK_ne ℓ'), mul_one]
        ext y
        exact (eq_top_iff.mp hEq_sub) trivial
      have hγL : Spec.map (CommRingCat.ofHom φ₁) ≫ hAff_inter.fromSpec = γ ℓ := by
        rw [← (hAff_A ℓ).map_fromSpec hAff_inter (homOfLE inf_le_left).op, ← Category.assoc,
          ← Spec.map_comp]
        have h_resL : P_A.presheaf.map (homOfLE (inf_le_left : U_inter ≤ D ℓ)).op ≫
            CommRingCat.ofHom φ₁ = CommRingCat.ofHom (ψ ℓ) := by
          ext x; exact congrFun (congrArg DFunLike.coe hφ₁_comp) x
        rw [h_resL]
      have hγR : Spec.map (CommRingCat.ofHom φ₂) ≫ hAff_inter.fromSpec = γ ℓ' := by
        rw [← (hAff_A ℓ').map_fromSpec hAff_inter (homOfLE inf_le_right).op, ← Category.assoc,
