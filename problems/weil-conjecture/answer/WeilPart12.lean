      intro X f _
      have hTermSpec :
          AlgebraicGeometry.IsSeparated (Limits.terminal.from (Spec (CommRingCat.of A))) :=
        (Scheme.isSeparated_iff _).mp inferInstance
      have hfSep : AlgebraicGeometry.IsSeparated f := inferInstance
      refine ⟨?_⟩
      rw [← Limits.terminal.hom_ext (f ≫ Limits.terminal.from (Spec (CommRingCat.of A)))
        (Limits.terminal.from X)]
      exact MorphismProperty.comp_mem _ f _ hfSep hTermSpec
    have _ : P_A.IsSeparated := hSepOfProper p_P
    have _ : QuasiSeparatedSpace ↥P_A := inferInstance
    let γ₀ : Spec (CommRingCat.of K_A) ⟶ P_A := γ 0
    have _ : QuasiCompact γ₀ := quasiCompact_of_compactSpace γ₀
    let U_tilde : Scheme.{u} := γ₀.image
    let ι_U : U_tilde ⟶ P_A := γ₀.imageι
    let π_U : U_tilde ⟶ Spec (CommRingCat.of A) := ι_U ≫ p_P
    have _ : IsProper π_U := MorphismProperty.comp_mem _ ι_U p_P inferInstance hProp_P
    have hSep_U : U_tilde.IsSeparated := hSepOfProper π_U
    let U_aff : Fin (d + 1) → P_A.affineOpens := fun ℓ => ⟨D ℓ, hAff_A ℓ⟩
    let V_cov : Fin (d + 1) → U_tilde.Opens := fun ℓ => ι_U ⁻¹ᵁ (D ℓ)
    have _ : IsAffineHom ι_U := (isClosedImmersion_iff_isAffineHom.mp inferInstance).1
    have hAffV : ∀ ℓ : Fin (d + 1), IsAffineOpen (V_cov ℓ) :=
      fun ℓ => (hAff_A ℓ).preimage ι_U
    have hCov_V_iSup : (⨆ ℓ : Fin (d + 1), V_cov ℓ) = ⊤ := by
      apply le_antisymm le_top
      intro y _
      have hyP : ι_U.base y ∈ (⊤ : P_A.Opens) := trivial
      rw [← hCov_P, TopologicalSpace.Opens.mem_iSup] at hyP
      obtain ⟨ℓ, hℓ⟩ := hyP
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨ℓ, hℓ⟩
    have hCov_V_set : ((⋃ ℓ : Fin (d + 1), (V_cov ℓ : Set U_tilde)) = Set.univ) := by
      ext y
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hy : y ∈ (⨆ ℓ : Fin (d + 1), V_cov ℓ) := by rw [hCov_V_iSup]; trivial
      exact TopologicalSpace.Opens.mem_iSup.mp hy
    have hKer_eq : ∀ ℓ : Fin (d + 1),
        γ₀.ker.ideal (U_aff ℓ) = RingHom.ker (π_proj ℓ) := by
      intro ℓ
      rw [Scheme.Hom.ker_apply γ₀ (U_aff ℓ)]
      have hγ0_ℓ : γ₀ = γ ℓ := hγ_eq 0 ℓ
      rw [hγ0_ℓ]
      let X_K : Scheme.{u} := Spec (CommRingCat.of K_A)
      have h_pre_top : (γ ℓ) ⁻¹ᵁ (D ℓ) = ⊤ := by
        ext q
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        change ((hAff_A ℓ).fromSpec).base ((Spec.map (CommRingCat.ofHom (ψ ℓ))).base q) ∈ D ℓ
        have h_mem : ((hAff_A ℓ).fromSpec).base ((Spec.map (CommRingCat.ofHom (ψ ℓ))).base q) ∈
            Set.range ((hAff_A ℓ).fromSpec).base := ⟨_, rfl⟩
        rwa [(hAff_A ℓ).range_fromSpec] at h_mem
      have h_le_top : (⊤ : X_K.Opens) ≤ (γ ℓ) ⁻¹ᵁ (D ℓ) :=
        le_of_eq h_pre_top.symm
      have hSpec_eq : Spec.map ((γ ℓ).appLE (D ℓ) ⊤ h_le_top) =
          (isAffineOpen_top X_K).fromSpec ≫ Spec.map (CommRingCat.ofHom (ψ ℓ)) := by
        rw [← cancel_mono (hAff_A ℓ).fromSpec, Category.assoc]
        exact IsAffineOpen.SpecMap_appLE_fromSpec (γ ℓ) (hAff_A ℓ) (isAffineOpen_top X_K) h_le_top
      let id_XK : X_K ⟶ X_K := 𝟙 X_K
      have hRange_topSpec : Set.range (isAffineOpen_top X_K).fromSpec.base = Set.range id_XK.base := by
        rw [(isAffineOpen_top X_K).range_fromSpec]
        ext q
        exact ⟨fun _ => ⟨q, rfl⟩, fun _ => trivial⟩
      let iso_topSpec :=
        IsOpenImmersion.isoOfRangeEq (isAffineOpen_top X_K).fromSpec id_XK hRange_topSpec
      have h_fromSpec_iso : (isAffineOpen_top X_K).fromSpec = iso_topSpec.hom := by
        have hf := IsOpenImmersion.isoOfRangeEq_hom_fac
          (isAffineOpen_top X_K).fromSpec id_XK hRange_topSpec
        change iso_topSpec.hom ≫ 𝟙 X_K = _ at hf
        rw [Category.comp_id] at hf
        exact hf.symm
      have _ : IsIso (isAffineOpen_top X_K).fromSpec := by rw [h_fromSpec_iso]; infer_instance
      let α_top := Spec.preimage (isAffineOpen_top X_K).fromSpec
      let α_top_inv := Spec.preimage (inv (isAffineOpen_top X_K).fromSpec)
      have h_α_inv : α_top ≫ α_top_inv = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, IsIso.inv_hom_id, Spec.map_id]
      have h_inj_α : Function.Injective α_top.hom := by
        intro x y hxy
        have h1 : (α_top ≫ α_top_inv).hom x = (α_top ≫ α_top_inv).hom y := by
          change α_top_inv.hom (α_top.hom x) = α_top_inv.hom (α_top.hom y)
          rw [hxy]
        rwa [h_α_inv] at h1
      have happLE_eq : (γ ℓ).appLE (D ℓ) ⊤ h_le_top = CommRingCat.ofHom (ψ ℓ) ≫ α_top := by
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, hSpec_eq]
      have happ_iso : (γ ℓ).appLE (D ℓ) ⊤ h_le_top =
          (γ ℓ).app (D ℓ) ≫
            X_K.presheaf.map (eqToHom h_pre_top.symm).op := by
        rfl
      ext s
      simp only [RingHom.mem_ker]
      have h_inj_res : Function.Injective
          ((X_K.presheaf.map (eqToHom h_pre_top.symm).op).hom) :=
        (X_K.presheaf.mapIso (eqToIso h_pre_top.symm).op).commRingCatIsoToRingEquiv.injective
      calc ((γ ℓ).app (U_aff ℓ).1).hom s = 0
          ↔ (((γ ℓ).app (D ℓ) ≫
              X_K.presheaf.map (eqToHom h_pre_top.symm).op).hom s) = 0 := by
              constructor
              · intro h
                change (X_K.presheaf.map (eqToHom h_pre_top.symm).op).hom
                  (((γ ℓ).app (D ℓ)).hom s) = 0
                rw [h, map_zero]
              · intro h; exact h_inj_res (h.trans (map_zero _).symm)
        _ ↔ ((γ ℓ).appLE (D ℓ) ⊤ h_le_top).hom s = 0 := by rw [← happ_iso]
        _ ↔ (CommRingCat.ofHom (ψ ℓ) ≫ α_top).hom s = 0 := by rw [happLE_eq]
        _ ↔ ψ ℓ s = 0 := by
              constructor
              · intro h; exact h_inj_α (h.trans (map_zero _).symm)
              · intro h; change α_top.hom (ψ ℓ s) = 0; rw [h, map_zero]
        _ ↔ π_proj ℓ s = 0 := by
              constructor
