        have hComap_ne_top : Ideal.comap ρ_S J ≠ ⊤ := by
          intro htop
          apply hJ_ne_top
          rw [← hMapUnder, htop, Ideal.map_top]
        have hle_comap : 𝔪 ≤ Ideal.comap ρ_S J := by
          rw [← hComapB]
          exact Ideal.comap_mono hlt.le
        have hEq_comap : Ideal.comap ρ_S J = 𝔪 :=
