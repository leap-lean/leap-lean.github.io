        obtain ⟨g, hg⟩ := PowerSeries.X_dvd_iff.mpr hevF
        have hC_mem : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
            (MvPolynomial.C (MvPolynomial.eval 0 F)) ∈ p.asIdeal := by
          rw [hg, map_mul, map_mul]
