        have h1 : (hU₀.fromSpec ≫ pE) =
            AlgebraicGeometry.Spec.map (E_sch.presheaf.map i_a.op) ≫ ((hW a).fromSpec ≫ pE) := by
          rw [← hMapW, Category.assoc]
        change _ = ρ_a.comp ((θIso a).hom.hom.comp Polynomial.C)
        rw [hθ_C a, h1, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
        rfl
      exact hPreW.symm.trans hPreV

    
    let 𝔪_B : Ideal B := Ideal.map ρ_S 𝔪
    have h𝔪B_prime_max : 𝔪_B.IsPrime ∧ Ideal.comap ρ_S 𝔪_B = 𝔪 ∧ 𝔪_B.IsMaximal := by
      let _ : Algebra S B := ρ_S.toAlgebra
      have _ : IsLocalization.Away f B := hLocS
      have hDisj : Disjoint (Submonoid.powers f : Set S) (𝔪 : Set S) := by
        rw [Set.disjoint_left]
        rintro _ ⟨k, rfl⟩ hfk
        exact hf_not_𝔪 (h𝔪_prime.mem_of_pow_mem k hfk)
      have hPrimeB : 𝔪_B.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) B 𝔪 h𝔪_prime hDisj
      have hComapB : Ideal.comap ρ_S 𝔪_B = 𝔪 :=
        IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) B h𝔪_prime hDisj
      have hMaxB : 𝔪_B.IsMaximal := by
        refine ⟨hPrimeB.ne_top, ?_⟩
        intro J hlt
        by_contra hJ_ne_top
        have hMapUnder : Ideal.map ρ_S (Ideal.comap ρ_S J) = J :=
