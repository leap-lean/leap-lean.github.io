    have hSupW : (⨆ i : Fin M, W i) = ⊤ := by
      apply le_antisymm le_top
      intro y _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hy : y ∈ (Set.univ : Set Y) := trivial
      rwa [← hCovW, Set.mem_iUnion] at hy
    have hSupWP : (⨆ i : Fin M, (TopologicalSpace.Opens.map fst.base).obj (W i)) = ⊤ := by
      apply le_antisymm le_top
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hz : fst.base z ∈ (Set.univ : Set Y) := trivial
      rw [← hCovW, Set.mem_iUnion] at hz
      exact hz
    have hInj_ρY : Function.Injective ρ_Y := by
      intro s₁ s₂ hs
      let eY : Opposite.op (⊤ : Y.Opens) ≅ Opposite.op (⨆ i : Fin M, W i) :=
        CategoryTheory.eqToIso (congrArg Opposite.op hSupW.symm)
      apply (CategoryTheory.ConcreteCategory.bijective_of_isIso (Y.presheaf.map eY.hom)).1
      apply Y.sheaf.eq_of_locally_eq W
      intro i
      have h_eq : eY.hom ≫ (TopologicalSpace.Opens.leSupr W i).op =
          (CategoryTheory.homOfLE (le_top : W i ≤ ⊤)).op := Subsingleton.elim _ _
      have h1 : (Y.presheaf.map (TopologicalSpace.Opens.leSupr W i).op).hom
