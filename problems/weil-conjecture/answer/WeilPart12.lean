          congr 1; ext y; exact e_ring.apply_symm_apply y,
        by
          rw [← AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Spec.map_id (CommRingCat.of R₀_s)]
          congr 1; ext x; exact e_ring.symm_apply_apply x⟩⟩
    let lam_Rs : AlgebraicGeometry.Spec (CommRingCat.of R₀_s) ⟶ AlgebraicGeometry.Spec R₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₀_s))
    let lam_Bs : AlgebraicGeometry.Spec (CommRingCat.of B₀_s) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ B₀_s))
    have : AlgebraicGeometry.IsOpenImmersion lam_Rs :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization s
    have : AlgebraicGeometry.IsOpenImmersion lam_Bs :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (θ₀ s)
    let ι_Rs : AlgebraicGeometry.Spec (CommRingCat.of R₀_s) ⟶ Y := lam_Rs ≫ ι₀
    let ι_Bs : AlgebraicGeometry.Spec (CommRingCat.of B₀_s) ⟶ W := lam_Bs ≫ ι_B₀
    let U_s : Y.Opens := ι_Rs.opensRange
    have hy₀_Us : y₀ ∈ U_s := by
      change (CategoryTheory.Limits.pullback.fst g_Y s_Ω).base q₀ ∈ U_s
      rw [← hp₀]
      change ι₀.base p₀ ∈ Set.range ⇑ι_Rs
      have hDisj_s : Disjoint (Submonoid.powers s : Set R₀) (p₀.asIdeal : Set R₀) := by
        rw [Set.disjoint_left]; intro x hx hp; exact (Submonoid.powers_le.mpr hs_mem) hx hp
      let P_0s : Ideal R₀_s := Ideal.map (algebraMap R₀ R₀_s) p₀.asIdeal
      have hP0s_prime : P_0s.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s) R₀_s p₀.asIdeal
          inferInstance hDisj_s
      have hP0s_under : P_0s.comap (algebraMap R₀ R₀_s) = p₀.asIdeal :=
        IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s) R₀_s inferInstance hDisj_s
      let q_0s : AlgebraicGeometry.Spec (CommRingCat.of R₀_s) := ⟨P_0s, hP0s_prime⟩
      have hlam_q0s : lam_Rs.base q_0s = p₀ := PrimeSpectrum.ext hP0s_under
      refine ⟨q_0s, ?_⟩
      change ι₀.base (lam_Rs.base q_0s) = ι₀.base p₀
      rw [hlam_q0s]
    have hRange_Us : Set.range ⇑ι_Rs = Set.range ⇑U_s.ι := Subtype.range_coe.symm
    let e_U := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ι_Rs U_s.ι hRange_Us
    have hNonempty_Bs : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of B₀_s)) := by
      have : P_x.IsPrime := hPx_prime
      have hθ₀s_pc : θ₀ s ∈ P_x.primeCompl := hθ₀s_not_Px
      have hDisj_Bs : Disjoint (Submonoid.powers (θ₀ s) : Set B₀) (P_x : Set B₀) := by
        rw [Set.disjoint_left]; intro x hx hp; exact (Submonoid.powers_le.mpr hθ₀s_pc) hx hp
      exact ⟨⟨Ideal.map (algebraMap B₀ B₀_s) P_x,
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (θ₀ s)) B₀_s P_x
          hPx_prime hDisj_Bs⟩⟩
    have hΦs_sq : Φ_s ≫ lam_Rs = lam_Bs ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1; ext r; exact hθs_eq r
    have hιBs_h : ι_Bs ≫ h = Φ_s ≫ ι_Rs := by
      calc ι_Bs ≫ h
          = lam_Bs ≫ (lam_W ≫ ι_W ≫ h) := by simp only [ι_Bs, ι_B₀, CategoryTheory.Category.assoc]
        _ = (lam_Bs ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀)) ≫ ι₀ := by
              rw [← hΦ₀_fac, CategoryTheory.Category.assoc]
        _ = Φ_s ≫ ι_Rs := by rw [← hΦs_sq, CategoryTheory.Category.assoc]
    let W_s : W.Opens := (TopologicalSpace.Opens.map h.base).obj U_s
    have hRange_Bs : Set.range ⇑ι_Bs ⊆ Set.range ⇑W_s.ι := by
      rintro _ ⟨z, rfl⟩
      refine ⟨⟨ι_Bs.base z, ?_⟩, rfl⟩
      change (ι_Bs ≫ h).base z ∈ Set.range ⇑ι_Rs
      rw [hιBs_h]
      exact ⟨Φ_s.base z, rfl⟩
    let j_V := AlgebraicGeometry.IsOpenImmersion.lift W_s.ι ι_Bs hRange_Bs
    have hjV_fac : j_V ≫ W_s.ι = ι_Bs :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_s.ι ι_Bs hRange_Bs
    have : AlgebraicGeometry.IsOpenImmersion (j_V ≫ W_s.ι) := by
      rw [hjV_fac]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion j_V :=
      AlgebraicGeometry.IsOpenImmersion.of_comp j_V W_s.ι
    let φ_s : AlgebraicGeometry.Spec (CommRingCat.of B₀_s) ≅ U_s.toScheme :=
      CategoryTheory.asIso Φ_s ≪≫ e_U
    have hjV_h : j_V ≫ (h ∣_ U_s) = φ_s.hom := by
      rw [← CategoryTheory.cancel_mono U_s.ι]
      calc (j_V ≫ (h ∣_ U_s)) ≫ U_s.ι
          = j_V ≫ ((h ∣_ U_s) ≫ U_s.ι) := CategoryTheory.Category.assoc _ _ _
        _ = j_V ≫ (W_s.ι ≫ h) := by rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = ι_Bs ≫ h := by rw [← CategoryTheory.Category.assoc, hjV_fac]
        _ = Φ_s ≫ ι_Rs := hιBs_h
        _ = Φ_s ≫ (e_U.hom ≫ U_s.ι) := by
            rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
        _ = φ_s.hom ≫ U_s.ι := by simp [φ_s, CategoryTheory.Category.assoc]
    let σ : U_s.toScheme ⟶ W_s.toScheme := φ_s.inv ≫ j_V
    have hσ_right : σ ≫ (h ∣_ U_s) = 𝟙 U_s.toScheme := by
      calc (φ_s.inv ≫ j_V) ≫ (h ∣_ U_s)
          = φ_s.inv ≫ (j_V ≫ (h ∣_ U_s)) := CategoryTheory.Category.assoc _ _ _
        _ = φ_s.inv ≫ φ_s.hom := by rw [hjV_h]
        _ = 𝟙 U_s.toScheme := φ_s.inv_hom_id
    have hDom_ιBs : AlgebraicGeometry.IsDominant ι_Bs := by
      obtain ⟨z₀⟩ := hNonempty_Bs
      exact (AlgebraicGeometry.isDominant_iff ι_Bs).mpr
        (ι_Bs.isOpenEmbedding.isOpen_range.dense ⟨ι_Bs.base z₀, z₀, rfl⟩)
    have : AlgebraicGeometry.IsDominant (j_V ≫ W_s.ι) := by rwa [hjV_fac]
    have : AlgebraicGeometry.IsDominant j_V :=
      AlgebraicGeometry.IsDominant.of_comp_of_isOpenImmersion j_V W_s.ι
    have hσ_left : (h ∣_ U_s) ≫ σ = 𝟙 W_s.toScheme := by
      apply AlgebraicGeometry.ext_of_isDominant_of_isSeparated (h ∣_ U_s) _ j_V
      · calc j_V ≫ ((h ∣_ U_s) ≫ σ)
            = (j_V ≫ (h ∣_ U_s)) ≫ φ_s.inv ≫ j_V := by
                simp only [σ, CategoryTheory.Category.assoc]
          _ = (φ_s.hom ≫ φ_s.inv) ≫ j_V := by
                rw [hjV_h, CategoryTheory.Category.assoc]
          _ = j_V ≫ 𝟙 W_s.toScheme := by
                rw [φ_s.hom_inv_id, CategoryTheory.Category.id_comp,
                  CategoryTheory.Category.comp_id]
      · calc ((h ∣_ U_s) ≫ σ) ≫ (h ∣_ U_s)
            = (h ∣_ U_s) ≫ (σ ≫ (h ∣_ U_s)) := CategoryTheory.Category.assoc _ _ _
          _ = (h ∣_ U_s) ≫ 𝟙 U_s.toScheme := by rw [hσ_right]
          _ = 𝟙 W_s.toScheme ≫ (h ∣_ U_s) := by
              rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    have hIso_Us : CategoryTheory.IsIso (h ∣_ U_s) := ⟨⟨σ, hσ_left, hσ_right⟩⟩
    exact hq₀_noIso U_s hy₀_Us hIso_Us
  exact ⟨θ, hC1, hC2, hC3, hC4, hC5, hC6⟩

