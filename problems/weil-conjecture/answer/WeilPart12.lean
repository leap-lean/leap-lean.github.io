        exact s.2 (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu_in_v0) hs_in_u)
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf] at hfv_not_rad
      push Not at hfv_not_rad
      obtain ⟨Q₀, ⟨hfu_Q₀, hQ₀_prime⟩, hfv_not_Q₀⟩ := hfv_not_rad
      let q_u : Ideal A' := Ideal.comap f₀ Q₀
      have : q_u.IsPrime := hQ₀_prime.comap f₀
      have hu_qu : u ∈ q_u := hfu_Q₀ (Ideal.subset_span (Set.mem_singleton _))
      have hv_not_qu : v ∉ q_u := hfv_not_Q₀
      have hqu_le_v0 : q_u ≤ J_v0 := by
        intro x hx
        by_contra hx_not
        exact hQ₀_prime.ne_top
          (Ideal.eq_top_of_isUnit_mem Q₀ hx
            (IsLocalization.map_units (Localization.AtPrime J_v0)
              (⟨x, hx_not⟩ : J_v0.primeCompl)))
      let w_u : AlgebraicGeometry.Spec A' := ⟨q_u, inferInstance⟩
      have hwu_ne_v0 : w_u ≠ v₀ := by
        intro h
        apply hv_not_qu
        have hv_in : v ∈ v₀.asIdeal := hv₀_span ▸ Ideal.subset_span (by simp)
        rwa [← h] at hv_in
      let p_u : AlgebraicGeometry.Spec R_Y := e_U.base w_u
      have hpu_ne_p0 : p_u ≠ p₀ := by
        intro h
        have hw_in : w_u ∈ e_U.base ⁻¹' {p₀} := h
        rw [heU_pre, Set.mem_singleton_iff] at hw_in
        exact hwu_ne_v0 hw_in
      have hv0_p0 : e_U.base v₀ = p₀ := by
        have : v₀ ∈ e_U.base ⁻¹' {p₀} := by rw [heU_pre]; exact Set.mem_singleton v₀
        exact this
      have hwu_spec : w_u ⤳ v₀ := (PrimeSpectrum.le_iff_specializes w_u v₀).mp hqu_le_v0
      have hpu_spec : p_u ⤳ p₀ := hv0_p0 ▸ hwu_spec.map e_U.continuous
      have hX_pu : (PowerSeries.X : RStar) ∈ (g₂.base (ι_Y.base p_u)).asIdeal := by
        change (PowerSeries.X : RStar) ∈ ((e_U ≫ ι_Y ≫ g₂).base w_u).asIdeal
        let ψ_top := AlgebraicGeometry.Spec.preimage (e_U ≫ ι_Y ≫ g₂)
        have hmap_top : AlgebraicGeometry.Spec.map ψ_top = e_U ≫ ι_Y ≫ g₂ :=
          AlgebraicGeometry.Spec.map_preimage _
        rw [← hmap_top]
        change ψ_top.hom PowerSeries.X ∈ q_u
        rw [hX_eq]
        obtain ⟨a', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : a ≠ 0)
        rw [pow_succ']
        have : ε * (u * u ^ a') * v ^ b = u * (ε * u ^ a' * v ^ b) := by ring
        rw [this]
        exact Ideal.mul_mem_right _ q_u hu_qu
      obtain ⟨q'_Y, hq'_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (ι_Y.base p_u) pt_Ω ((hsΩ_pt _).mp hX_pu)
      have hq'_ne_q0 : q'_Y ≠ q₀ := by
        intro h
        apply hpu_ne_p0
        apply ι_Y.isOpenEmbedding.injective
        rw [← hq'_fst, h, hp₀_q₀]
      have hq'_spec : q'_Y ⤳ q₀ := by
        apply fst₂.isClosedEmbedding.isInducing.specializes_iff.mp
        rw [hq'_fst, ← hp₀_q₀]
        exact hpu_spec.map ι_Y.continuous
      have hq0_in_comp : F' ⊆ irreducibleComponent q'_Y := by
        rw [hF'_eq, Set.singleton_subset_iff]
        exact closure_minimal
          (Set.singleton_subset_iff.mpr mem_irreducibleComponent)
          isClosed_irreducibleComponent hq'_spec.mem_closure
      have hcomp_le : irreducibleComponent q'_Y ⊆ F' :=
        hF'.2 isIrreducible_irreducibleComponent hq0_in_comp
      have : q'_Y ∈ ({q₀} : Set ↥C₂_0) := by
        rw [← hF'_eq]; exact hcomp_le mem_irreducibleComponent
      exact hq'_ne_q0 (Set.mem_singleton_iff.mp this)
    have hqY_spec_q0 : q_Y ⤳ q₀ := by
      rw [specializes_iff_mem_closure, hGen_Y]; exact hq₀_in_F'
    have hqY_in_ιY : fst₂.base q_Y ∈ Set.range ι_Y.base :=
      (hqY_spec_q0.map fst₂.continuous).mem_open ι_Y.isOpenEmbedding.isOpen_range ⟨p₀, hp₀_q₀⟩
    obtain ⟨P_Y, hPY_qY⟩ := hqY_in_ιY
    obtain ⟨J_PY, hJPY_eq⟩ : ∃ J : Ideal R_Y, J = P_Y.asIdeal := ⟨P_Y.asIdeal, rfl⟩
    have : J_PY.IsPrime := hJPY_eq ▸ P_Y.isPrime
    have hPY_spec_p0 : P_Y ⤳ p₀ := by
      rw [← ι_Y.isOpenEmbedding.isInducing.specializes_iff, hPY_qY, hp₀_q₀]
      exact hqY_spec_q0.map fst₂.continuous
    have hPY_le_p0 : J_PY ≤ J_p0 := by
      rw [hJPY_eq]
      exact (PrimeSpectrum.le_iff_specializes P_Y p₀).mpr hPY_spec_p0
    have hPY_ne_p0 : P_Y ≠ p₀ := by
      intro h
      apply hqY_ne_q₀
      apply fst₂.isClosedEmbedding.injective
      rw [← hPY_qY, h, hp₀_q₀]
    have hPY_lt_p0 : J_PY < J_p0 :=
      lt_of_le_of_ne hPY_le_p0 (fun h => hPY_ne_p0 (PrimeSpectrum.ext (hJPY_eq.symm.trans h)))
    let φ_RY := (AlgebraicGeometry.Spec.preimage (ι_Y ≫ g₂)).hom
    let ψ_et := (AlgebraicGeometry.Spec.preimage e_U).hom
    have hψ_φ_X : ψ_et (φ_RY PowerSeries.X) = ε * u ^ a * v ^ b := by
      have h1 : AlgebraicGeometry.Spec.preimage (ι_Y ≫ g₂) ≫ AlgebraicGeometry.Spec.preimage e_U =
          AlgebraicGeometry.Spec.preimage (e_U ≫ ι_Y ≫ g₂) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      calc ψ_et (φ_RY PowerSeries.X)
          = (AlgebraicGeometry.Spec.preimage (ι_Y ≫ g₂) ≫
              AlgebraicGeometry.Spec.preimage e_U).hom PowerSeries.X := rfl
        _ = (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_Y ≫ g₂)).hom PowerSeries.X := by rw [h1]
        _ = ε * u ^ a * v ^ b := hX_eq
    have hv_ne : v ≠ 0 := by
      rintro rfl
      have h0 : (0 : A') * 1 ∈ Ideal.span ({u} : Set A') := by simp
      have h1 : (1 : A') ∈ Ideal.span ({u} : Set A') := hv_reg 1 h0
      have hu_in : u ∈ v₀.asIdeal := hv₀_span ▸ Ideal.subset_span (by simp)
      exact v₀.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem v₀.asIdeal
          (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu_in) h1) isUnit_one)
    have hφX_ne : φ_RY PowerSeries.X ≠ 0 := by
      intro h0
      have hA0 : ε * u ^ a * v ^ b = 0 := by rw [← hψ_φ_X, h0, map_zero]
      exact mul_ne_zero (mul_ne_zero hε_unit.ne_zero (pow_ne_zero a hu_ne))
        (pow_ne_zero b hv_ne) hA0
    have hφX_in_PY : φ_RY PowerSeries.X ∈ J_PY := by
      have hbase : (ι_Y ≫ g₂).base P_Y = s_Ω.base pt_Ω := by
        calc (ι_Y ≫ g₂).base P_Y
            = g₂.base (ι_Y.base P_Y) := rfl
          _ = (fst₂ ≫ g₂).base q_Y := by rw [hPY_qY]; rfl
          _ = (snd₂ ≫ s_Ω).base q_Y := by rw [CategoryTheory.Limits.pullback.condition]
          _ = s_Ω.base (snd₂.base q_Y) := rfl
          _ = s_Ω.base pt_Ω := congrArg s_Ω.base (pt_field_eq _ _)
      have hX_in : (PowerSeries.X : RStar) ∈ ((ι_Y ≫ g₂).base P_Y).asIdeal :=
        (hsΩ_pt _).mpr hbase
      rw [← AlgebraicGeometry.Spec.map_preimage (ι_Y ≫ g₂)] at hX_in
      rw [hJPY_eq]
      exact hX_in
    have hFT_RY : RingHom.FiniteType φ_RY := by
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType (ι_Y ≫ g₂) := inferInstance
      rw [← AlgebraicGeometry.Spec.map_preimage (ι_Y ≫ g₂)] at hLFT
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
    have : IsNoetherianRing R_Y := by
      letI : Algebra RStar R_Y := φ_RY.toAlgebra
      have : Algebra.FiniteType RStar R_Y := hFT_RY
      exact Algebra.FiniteType.isNoetherianRing RStar R_Y
    have hFT_A' : RingHom.FiniteType (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_Y ≫ g₂)).hom := by
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType (e_U ≫ ι_Y ≫ g₂) := inferInstance
      rw [← AlgebraicGeometry.Spec.map_preimage (e_U ≫ ι_Y ≫ g₂)] at hLFT
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
    have : IsNoetherianRing A' := by
      letI : Algebra RStar A' :=
        (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_Y ≫ g₂)).hom.toAlgebra
      have : Algebra.FiniteType RStar A' := hFT_A'
      exact Algebra.FiniteType.isNoetherianRing RStar A'
    have hFlat_et : RingHom.Flat ψ_et := by
      have hFl : AlgebraicGeometry.Flat e_U := inferInstance
      rw [← AlgebraicGeometry.Spec.map_preimage e_U] at hFl
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Flat)).mp hFl
    have hv0_p0 : e_U.base v₀ = p₀ := by
      have : v₀ ∈ e_U.base ⁻¹' {p₀} := by rw [heU_pre]; exact Set.mem_singleton v₀
      exact this
    have hv0_over : J_p0 = Ideal.comap ψ_et J_v0 := by
      have h1 := congrArg PrimeSpectrum.asIdeal hv0_p0.symm
      rw [← AlgebraicGeometry.Spec.map_preimage e_U] at h1
      exact h1
    obtain ⟨Q, hQ_prime, hQ_lt_v0, hQ_over⟩ :
        ∃ Q : Ideal A', Q.IsPrime ∧ Q < J_v0 ∧ J_PY = Ideal.comap ψ_et Q := by
      letI : Algebra R_Y A' := ψ_et.toAlgebra
      have : Module.Flat R_Y A' := hFlat_et
      have : Algebra.HasGoingDown R_Y A' := Algebra.HasGoingDown.of_flat
      have : J_v0.LiesOver J_p0 := ⟨hv0_over⟩
      obtain ⟨Q, hQ_lt, hQ_pr, hQ_ov⟩ :=
        Ideal.exists_ideal_lt_liesOver_of_lt J_v0 hPY_lt_p0
      exact ⟨Q, hQ_pr, hQ_lt, hQ_ov.over⟩
    have : Q.IsPrime := hQ_prime
    have hDVR_AQ : IsDiscreteValuationRing (Localization.AtPrime Q) := by
      have hDVR_branch : ∀ (u' v' : A'),
          u' ≠ 0 →
          J_v0 = Ideal.span ({u', v'} : Set A') →
          u' ∈ Q →
          v' ∉ Q →
          IsDiscreteValuationRing (Localization.AtPrime Q) := by
        intro u' v' hu'_ne hsp_uv hu'_Q hv'_not_Q
        have hinj_AQ : Function.Injective (algebraMap A' (Localization.AtPrime Q)) :=
          IsLocalization.injective (Localization.AtPrime Q)
            (Ideal.primeCompl_le_nonZeroDivisors Q)
        have hu'AQ_ne : algebraMap A' (Localization.AtPrime Q) u' ≠ 0 :=
          fun h => hu'_ne (hinj_AQ (h.trans (map_zero _).symm))
        have hu'AQ_max : algebraMap A' (Localization.AtPrime Q) u' ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q u').mpr hu'_Q
        have hNotField_AQ : ¬ IsField (Localization.AtPrime Q) := by
          intro hF
          obtain ⟨w, hw⟩ := hF.mul_inv_cancel hu'AQ_ne
          exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨w, hw⟩)) hu'AQ_max
        apply ((IsDiscreteValuationRing.TFAE (Localization.AtPrime Q) hNotField_AQ).out 1 5).mpr
        refine ⟨⟨algebraMap A' (Localization.AtPrime Q) u', ?_⟩⟩
        ext y
        simp only [Ideal.submodule_span_eq, Ideal.mem_span_singleton]
        constructor
        · intro hy_max
          obtain ⟨⟨x, s⟩, hys⟩ := IsLocalization.surj Q.primeCompl y
          have hx_max : algebraMap A' (Localization.AtPrime Q) x ∈
              IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
            rw [← hys]; exact Ideal.mul_mem_right _ _ hy_max
          have hx_Q : x ∈ Q :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q x).mp hx_max
          have hx_mod : ∀ m : ℕ, ∃ q_m r_m : A', r_m ∈ Q ∧ x = u' * q_m + v' ^ m * r_m := by
            intro m
            induction m with
            | zero => exact ⟨0, x, hx_Q, by simp⟩
            | succ m ih =>
              obtain ⟨q_m, r_m, hrm_Q, hx_eq⟩ := ih
              have hrm_sp : r_m ∈ Ideal.span ({u', v'} : Set A') :=
                hsp_uv ▸ hQ_lt_v0.le hrm_Q
              obtain ⟨c₁, c₂, hrm_pair⟩ := Ideal.mem_span_pair.mp hrm_sp
              have hc₂v_Q : c₂ * v' ∈ Q := by
                have hsub : r_m - c₁ * u' ∈ Q :=
                  Q.sub_mem hrm_Q (Ideal.mul_mem_left Q c₁ hu'_Q)
                have heq : r_m - c₁ * u' = c₂ * v' := by rw [← hrm_pair]; ring
                rwa [heq] at hsub
              have hc₂_Q : c₂ ∈ Q :=
                (hQ_prime.mem_or_mem hc₂v_Q).resolve_right hv'_not_Q
              refine ⟨q_m + v' ^ m * c₁, c₂, hc₂_Q, ?_⟩
              rw [hx_eq, ← hrm_pair, pow_succ]
              ring
          let f₀ : A' →+* Localization.AtPrime J_v0 := algebraMap A' (Localization.AtPrime J_v0)
          have hinj_L₀ : Function.Injective f₀ :=
            IsLocalization.injective (Localization.AtPrime J_v0)
              (Ideal.primeCompl_le_nonZeroDivisors J_v0)
          let J : Ideal (Localization.AtPrime J_v0) := Ideal.span ({f₀ u'} : Set _)
          have hfx_in_iInf :
              Ideal.Quotient.mk J (f₀ x) ∈
                ⨅ m : ℕ, (IsLocalRing.maximalIdeal (Localization.AtPrime J_v0)) ^ m •
                  (⊤ : Submodule (Localization.AtPrime J_v0)
                    ((Localization.AtPrime J_v0) ⧸ J)) := by
            rw [Submodule.mem_iInf]
            intro m
            obtain ⟨q_m, r_m, _, hx_eq⟩ := hx_mod m
            have hmk_eq : Ideal.Quotient.mk J (f₀ x) =
                ((f₀ v') ^ m) • Ideal.Quotient.mk J (f₀ r_m) := by
              change Ideal.Quotient.mk J (f₀ x) = Ideal.Quotient.mk J ((f₀ v') ^ m * f₀ r_m)
              rw [Ideal.Quotient.eq]
              have hdiff : f₀ x - (f₀ v') ^ m * f₀ r_m = f₀ u' * f₀ q_m := by
                rw [hx_eq, map_add, map_mul, map_mul, map_pow]; ring
              rw [hdiff]
              exact Ideal.mem_span_singleton.mpr ⟨f₀ q_m, rfl⟩
            rw [hmk_eq]
            have hfv'_max : f₀ v' ∈ IsLocalRing.maximalIdeal (Localization.AtPrime J_v0) :=
              (IsLocalization.AtPrime.to_map_mem_maximal_iff
                (Localization.AtPrime J_v0) J_v0 v').mpr
                (hsp_uv ▸ Ideal.subset_span (by simp))
            exact Submodule.smul_mem_smul (Ideal.pow_mem_pow hfv'_max m) Submodule.mem_top
          rw [Ideal.iInf_pow_smul_eq_bot_of_isLocalRing
            (IsLocalRing.maximalIdeal (Localization.AtPrime J_v0))
            (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime J_v0)).ne_top,
            Submodule.mem_bot] at hfx_in_iInf
          have hfx_J : f₀ x ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp hfx_in_iInf
          rw [Ideal.mem_span_singleton] at hfx_J
          obtain ⟨c_L, hc_L⟩ := hfx_J
          obtain ⟨⟨z, t⟩, hct⟩ := IsLocalization.surj J_v0.primeCompl c_L
          have htx_eq : (t : A') * x = u' * z := by
            apply hinj_L₀
            calc f₀ ((t : A') * x)
                = (f₀ u' * c_L) * f₀ (t : A') := by rw [map_mul, mul_comm, hc_L]
              _ = f₀ u' * (c_L * f₀ (t : A')) := by ring
              _ = f₀ (u' * z) := by rw [hct, map_mul]
          have ht_not_Q : (t : A') ∉ Q := fun h => t.2 (hQ_lt_v0.le h)
          let st : Q.primeCompl := s * ⟨(t : A'), ht_not_Q⟩
          refine ⟨IsLocalization.mk' (Localization.AtPrime Q) z st, ?_⟩
          have hst_ne : algebraMap A' (Localization.AtPrime Q) (st : A') ≠ 0 :=
            fun h => st.2 (by rw [hinj_AQ (h.trans (map_zero _).symm)]; exact Q.zero_mem)
          apply mul_right_cancel₀ hst_ne
          have hmk_st := IsLocalization.mk'_spec (Localization.AtPrime Q) z st
          calc y * algebraMap A' (Localization.AtPrime Q) (st : A')
              = (y * algebraMap A' (Localization.AtPrime Q) (s : A')) *
                  algebraMap A' (Localization.AtPrime Q) (t : A') := by
                  change y * algebraMap A' (Localization.AtPrime Q) ((s : A') * (t : A')) = _
                  rw [map_mul]; ring
            _ = algebraMap A' (Localization.AtPrime Q) ((t : A') * x) := by
                  rw [hys, ← map_mul, mul_comm]
            _ = algebraMap A' (Localization.AtPrime Q) u' *
                  algebraMap A' (Localization.AtPrime Q) z := by rw [htx_eq, map_mul]
            _ = (algebraMap A' (Localization.AtPrime Q) u' *
                  IsLocalization.mk' (Localization.AtPrime Q) z st) *
                  algebraMap A' (Localization.AtPrime Q) (st : A') := by rw [← hmk_st, mul_assoc]
        · rintro ⟨w, rfl⟩
          exact Ideal.mul_mem_right _ _ hu'AQ_max
      have hprod_Q : ε * u ^ a * v ^ b ∈ Q := by
        rw [← hψ_φ_X]
        have : φ_RY PowerSeries.X ∈ Ideal.comap ψ_et Q := hQ_over ▸ hφX_in_PY
        exact this
      have huv_Q : u ^ a * v ^ b ∈ Q := by
        have h1 : u ^ a * v ^ b = ↑hε_unit.unit⁻¹ * (ε * u ^ a * v ^ b) := by
          rw [← mul_assoc, ← mul_assoc]
          have : (↑hε_unit.unit⁻¹ : A') * ε = 1 := hε_unit.val_inv_mul
          rw [this, one_mul]
        rw [h1]
        exact Ideal.mul_mem_left Q _ hprod_Q
      have hnot_both : ¬ (u ∈ Q ∧ v ∈ Q) := by
        rintro ⟨huQ, hvQ⟩
        have hv0_le : J_v0 ≤ Q := by
          change v₀.asIdeal ≤ Q
          rw [hv₀_span, Ideal.span_le]
          rintro x (rfl | rfl) <;> assumption
        exact not_le_of_gt hQ_lt_v0 hv0_le
      rcases hQ_prime.mem_or_mem huv_Q with hua_Q | hvb_Q
      · have hu_Q : u ∈ Q := hQ_prime.mem_of_pow_mem a hua_Q
        exact hDVR_branch u v hu_ne hv₀_span hu_Q (fun hvQ => hnot_both ⟨hu_Q, hvQ⟩)
      · have hb_ne : b ≠ 0 := by
          rintro rfl; rw [pow_zero] at hvb_Q
          exact hQ_prime.ne_top (Ideal.eq_top_of_isUnit_mem Q hvb_Q isUnit_one)
        have hv_Q : v ∈ Q := hQ_prime.mem_of_pow_mem b hvb_Q
        exact hDVR_branch v u hv_ne (by rw [show J_v0 = v₀.asIdeal from rfl, hv₀_span, Set.pair_comm])
          hv_Q (fun huQ => hnot_both ⟨huQ, hv_Q⟩)
    have hFF_DVR : ∀ (V A_Q : Type u) [CommRing V] [IsDomain V] [IsNoetherianRing V] [IsLocalRing V]
        [CommRing A_Q] [IsDomain A_Q] [IsDiscreteValuationRing A_Q]
        (ψ_loc : V →+* A_Q) [IsLocalHom ψ_loc],
        RingHom.Flat ψ_loc →
        ¬ IsField V →
        (∃ x₀ : V, x₀ ≠ 0 ∧ x₀ ∈ IsLocalRing.maximalIdeal V) →
        IsDiscreteValuationRing V := by
      intro V A_Q _ _ _ _ _ _ _ ψ_loc _ hFlat_loc hNotField_V ⟨x₀, hx₀_ne, hx₀_max⟩
      have hcomap_map : ∀ I : Ideal V, Ideal.comap ψ_loc (Ideal.map ψ_loc I) = I := by
        letI : Algebra V A_Q := ψ_loc.toAlgebra
        have : Module.Flat V A_Q := hFlat_loc
        have : Module.FaithfullyFlat V A_Q := Module.FaithfullyFlat.of_flat_of_isLocalHom
        intro I
        exact Ideal.comap_map_eq_self_of_faithfullyFlat I
      have hinj_ψloc : Function.Injective ψ_loc := by
        rw [RingHom.injective_iff_ker_eq_bot]
        have h0 := hcomap_map ⊥
        rw [Ideal.map_bot] at h0
        exact h0
      have hIC_V : IsIntegrallyClosed V := by
        apply (isIntegrallyClosed_iff (R := V) (FractionRing V)).mpr
        intro x hx_int
        obtain ⟨⟨a_V, b_V⟩, hxb⟩ := IsLocalization.surj (nonZeroDivisors V) x
        have hbV_ne : (b_V : V) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b_V.2
        let θ_K : V →+* FractionRing A_Q := (algebraMap A_Q (FractionRing A_Q)).comp ψ_loc
        have hinj_θK : Function.Injective θ_K :=
          (IsFractionRing.injective A_Q (FractionRing A_Q)).comp hinj_ψloc
        have hθK_units : ∀ s : nonZeroDivisors V, IsUnit (θ_K s) := by
          intro s
          have hs_ne : (s : V) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
          exact Ne.isUnit (fun h => hs_ne (hinj_θK (h.trans (map_zero _).symm)))
        let lift_K : FractionRing V →+* FractionRing A_Q := IsLocalization.lift hθK_units
        have hlift_comp : lift_K.comp (algebraMap V (FractionRing V)) = θ_K :=
          IsLocalization.lift_comp hθK_units
        obtain ⟨P_mon, hP_monic, hP_eval⟩ := hx_int
        have h_int_AQ : IsIntegral A_Q (lift_K x) := by
          refine ⟨P_mon.map ψ_loc, hP_monic.map ψ_loc, ?_⟩
          rw [Polynomial.eval₂_map]
          have hcomp_eq : (algebraMap A_Q (FractionRing A_Q)).comp ψ_loc =
              lift_K.comp (algebraMap V (FractionRing V)) := hlift_comp.symm
          rw [hcomp_eq, ← Polynomial.hom_eval₂, hP_eval, map_zero]
        obtain ⟨y_AQ, hy_AQ⟩ :=
          (IsIntegrallyClosed.isIntegral_iff (R := A_Q) (K := FractionRing A_Q)).mp h_int_AQ
        have ha_eq_by : ψ_loc a_V = ψ_loc (b_V : V) * y_AQ := by
          apply IsFractionRing.injective A_Q (FractionRing A_Q)
          calc algebraMap A_Q (FractionRing A_Q) (ψ_loc a_V)
              = lift_K (algebraMap V (FractionRing V) a_V) :=
                  (IsLocalization.lift_eq hθK_units a_V).symm
            _ = lift_K (x * algebraMap V (FractionRing V) (b_V : V)) := by rw [← hxb]
            _ = lift_K x * algebraMap A_Q (FractionRing A_Q) (ψ_loc (b_V : V)) := by
                  rw [map_mul, IsLocalization.lift_eq]; rfl
            _ = algebraMap A_Q (FractionRing A_Q) (ψ_loc (b_V : V) * y_AQ) := by
                  rw [← hy_AQ, map_mul, mul_comm]
        have ha_in_comap : a_V ∈ Ideal.comap ψ_loc (Ideal.map ψ_loc (Ideal.span {(b_V : V)})) := by
          change ψ_loc a_V ∈ Ideal.map ψ_loc (Ideal.span {(b_V : V)})
          rw [Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton]
          exact ⟨y_AQ, ha_eq_by⟩
        rw [hcomap_map] at ha_in_comap
        obtain ⟨y_V, rfl⟩ := Ideal.mem_span_singleton.mp ha_in_comap
        refine ⟨y_V, ?_⟩
        have hb_K_ne : algebraMap V (FractionRing V) (b_V : V) ≠ 0 :=
          fun h => hbV_ne ((IsFractionRing.injective V (FractionRing V)) (h.trans (map_zero _).symm))
        apply mul_right_cancel₀ hb_K_ne
        rw [hxb, ← map_mul, mul_comm]
      have hUniquePrime_V : ∃! P : Ideal V, P ≠ ⊥ ∧ P.IsPrime := by
        refine ⟨IsLocalRing.maximalIdeal V, ⟨?_, inferInstance⟩, ?_⟩
        · intro hbot
          rw [hbot, Ideal.mem_bot] at hx₀_max
          exact hx₀_ne hx₀_max
        · rintro P ⟨hP_ne_bot, hP_prime⟩
          apply le_antisymm (IsLocalRing.le_maximalIdeal hP_prime.ne_top)
          obtain ⟨p_el, hp_in_P, hp_ne⟩ := (Submodule.ne_bot_iff P).mp hP_ne_bot
          obtain ⟨ϖ_AQ, hϖ_AQ⟩ := IsDiscreteValuationRing.exists_irreducible A_Q
          have hmax_AQ : IsLocalRing.maximalIdeal A_Q = Ideal.span {ϖ_AQ} :=
            (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ_AQ).mp hϖ_AQ
          have hψp_ne : ψ_loc p_el ≠ 0 := fun h => hp_ne (hinj_ψloc (h.trans (map_zero _).symm))
          obtain ⟨u_p, k_p, hψp_eq⟩ := dvr_unit_mul_pow hϖ_AQ hψp_ne
          intro m hm_max
          have hψm_max : ψ_loc m ∈ IsLocalRing.maximalIdeal A_Q := by
            by_contra hnot
            have hu_m : IsUnit (ψ_loc m) := IsLocalRing.notMem_maximalIdeal.mp hnot
            exact (IsLocalRing.notMem_maximalIdeal.mpr (IsLocalHom.map_nonunit m hu_m)) hm_max
          rw [hmax_AQ, Ideal.mem_span_singleton] at hψm_max
          obtain ⟨c_m, hψm_eq⟩ := hψm_max
          have hmk_in : m ^ k_p ∈ Ideal.comap ψ_loc (Ideal.map ψ_loc P) := by
            change ψ_loc (m ^ k_p) ∈ Ideal.map ψ_loc P
            have heq : ψ_loc (m ^ k_p) = ψ_loc p_el * (↑u_p⁻¹ * c_m ^ k_p) := by
              calc ψ_loc (m ^ k_p)
                  = (ϖ_AQ * c_m) ^ k_p := by rw [map_pow, hψm_eq]
                _ = ((↑u_p⁻¹ * ↑u_p) * ϖ_AQ ^ k_p) * c_m ^ k_p := by
                      rw [Units.inv_mul, one_mul, mul_pow]
                _ = (↑u_p * ϖ_AQ ^ k_p) * (↑u_p⁻¹ * c_m ^ k_p) := by ring
                _ = ψ_loc p_el * (↑u_p⁻¹ * c_m ^ k_p) := by rw [← hψp_eq]
            rw [heq]
            exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem ψ_loc hp_in_P)
          rw [hcomap_map] at hmk_in
          exact hP_prime.mem_of_pow_mem k_p hmk_in
      apply ((IsDiscreteValuationRing.TFAE V hNotField_V).out 1 4).mpr
      exact ⟨hIC_V, hUniquePrime_V⟩
    have hinj_RY_V : Function.Injective (algebraMap R_Y (Localization.AtPrime J_PY)) :=
      IsLocalization.injective (Localization.AtPrime J_PY)
        (Ideal.primeCompl_le_nonZeroDivisors J_PY)
    have hX_V_ne : algebraMap R_Y (Localization.AtPrime J_PY) (φ_RY PowerSeries.X) ≠ 0 :=
      fun h => hφX_ne (hinj_RY_V (h.trans (map_zero _).symm))
    have hX_V_max : algebraMap R_Y (Localization.AtPrime J_PY) (φ_RY PowerSeries.X) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime J_PY) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime J_PY) J_PY _).mpr
        hφX_in_PY
    have hNotField_V : ¬ IsField (Localization.AtPrime J_PY) := by
      intro hF
      obtain ⟨w, hw⟩ := hF.mul_inv_cancel hX_V_ne
      exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨w, hw⟩)) hX_V_max
    let ψ_loc : Localization.AtPrime J_PY →+* Localization.AtPrime Q :=
      Localization.localRingHom J_PY Q ψ_et hQ_over
    have hFlat_loc : RingHom.Flat ψ_loc :=
      RingHom.Flat.localRingHom hFlat_et Q J_PY hQ_over
    have : IsLocalHom ψ_loc :=
      Localization.isLocalHom_localRingHom J_PY Q ψ_et hQ_over
    have : IsDiscreteValuationRing (Localization.AtPrime Q) := hDVR_AQ
    have hDVR_V : IsDiscreteValuationRing (Localization.AtPrime J_PY) :=
      hFF_DVR (Localization.AtPrime J_PY) (Localization.AtPrime Q) ψ_loc hFlat_loc hNotField_V
        ⟨_, hX_V_ne, hX_V_max⟩
    have hFinishV : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
        [Algebra R_Y V] [IsLocalization.AtPrime V J_PY],
        Function.Injective (algebraMap R_Y V) →
        algebraMap R_Y V (φ_RY PowerSeries.X) ≠ 0 →
        ∃ (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
          (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
            CategoryTheory.Limits.pullback g₂ η_K)
          (ξ : V),
          IsCompDVR F' V v_Y u_Y ξ := by
      intro V _ _ _ _ _ hinj_V hXV_ne
      obtain ⟨r_ξ, hrξ_p0, hrξ_not_PY⟩ := SetLike.exists_of_lt hPY_lt_p0
      let φ_Y : R_Y ⟶ CommRingCat.of V := CommRingCat.ofHom (algebraMap R_Y V)
      let v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂ :=
        AlgebraicGeometry.Spec.map φ_Y ≫ ι_Y
      let ξ : V := φ_Y.hom r_ξ
      let m_V : AlgebraicGeometry.Spec (CommRingCat.of V) :=
        ⟨IsLocalRing.maximalIdeal V, inferInstance⟩
      have hmV_PY : (AlgebraicGeometry.Spec.map φ_Y).base m_V = P_Y := by
        apply PrimeSpectrum.ext
        rw [← hJPY_eq]
        exact IsLocalization.AtPrime.under_maximalIdeal V J_PY
      have hvY_mV : v_Y.base m_V = fst₂.base q_Y := by
        calc v_Y.base m_V = ι_Y.base ((AlgebraicGeometry.Spec.map φ_Y).base m_V) := rfl
          _ = ι_Y.base P_Y := by rw [hmV_PY]
          _ = fst₂.base q_Y := hPY_qY
      have hpre_vY_g2 : (AlgebraicGeometry.Spec.preimage (v_Y ≫ g₂)).hom = φ_Y.hom.comp φ_RY := by
        have h1 : AlgebraicGeometry.Spec.preimage (ι_Y ≫ g₂) ≫ φ_Y =
            AlgebraicGeometry.Spec.preimage (v_Y ≫ g₂) := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc]
        exact congrArg CommRingCat.Hom.hom h1.symm
      have hξ_res : ∀ c : Ω,
          ξ - (AlgebraicGeometry.Spec.preimage (v_Y ≫ g₂)).hom (PowerSeries.C c) ∉
            IsLocalRing.maximalIdeal V := by
        intro c hc_in
        rw [hpre_vY_g2, RingHom.comp_apply] at hc_in
        have hdiff_in : φ_Y.hom (r_ξ - φ_RY (PowerSeries.C c)) ∈ IsLocalRing.maximalIdeal V := by
          rwa [map_sub]
        have hr_PY : r_ξ - φ_RY (PowerSeries.C c) ∈ J_PY :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff V J_PY _).mp hdiff_in
        by_cases hc0 : c = 0
        · subst hc0
          simp at hr_PY
          exact hrξ_not_PY hr_PY
        · have hC_in_p0 : φ_RY (PowerSeries.C c) ∈ J_p0 := by
            have := J_p0.sub_mem hrξ_p0 (hPY_le_p0 hr_PY)
            simpa using this
          have hC_unit : IsUnit (φ_RY (PowerSeries.C c)) :=
            ((Ne.isUnit hc0).map PowerSeries.C).map φ_RY
          exact p₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem J_p0 hC_in_p0 hC_unit)
      let θ_KV : RStar →+* FractionRing V :=
        (algebraMap V (FractionRing V)).comp (AlgebraicGeometry.Spec.preimage (v_Y ≫ g₂)).hom
      have hθKV_X_ne : θ_KV PowerSeries.X ≠ 0 := by
        change algebraMap V (FractionRing V)
          ((AlgebraicGeometry.Spec.preimage (v_Y ≫ g₂)).hom PowerSeries.X) ≠ 0
        rw [hpre_vY_g2, RingHom.comp_apply]
        intro h0
        exact hXV_ne ((IsFractionRing.injective V (FractionRing V)) (h0.trans (map_zero _).symm))
      let ψ_KV : KStar →+* FractionRing V :=
        IsLocalization.Away.lift (PowerSeries.X : RStar) (Ne.isUnit hθKV_X_ne)
      have hψKV_hom : ψ_KV.comp (algebraMap RStar KStar) = θ_KV :=
        IsLocalization.lift_comp _
      have hψKV_comp : CommRingCat.ofHom (algebraMap RStar KStar) ≫ CommRingCat.ofHom ψ_KV =
          AlgebraicGeometry.Spec.preimage (v_Y ≫ g₂) ≫
            CommRingCat.ofHom (algebraMap V (FractionRing V)) := by
        rw [← CommRingCat.ofHom_comp, hψKV_hom]
        rfl
      let u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
          CategoryTheory.Limits.pullback g₂ η_K :=
        CategoryTheory.Limits.pullback.lift
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_Y)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_KV))
          (by
            rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_preimage (v_Y ≫ g₂),
              ← AlgebraicGeometry.Spec.map_comp, ← hψKV_comp, AlgebraicGeometry.Spec.map_comp])
      have huY_fst_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_Y =
            u_Y ≫ CategoryTheory.Limits.pullback.fst g₂ η_K :=
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      refine ⟨v_Y, u_Y, ξ, huY_fst_eq, hξ_res,
        m_V, q_Y, R_Y, ι_Y, P_Y, φ_Y, r_ξ,
        rfl, hGen_Y, hvY_mV, hιY_open, hDom_RY, hinj_V, rfl, rfl, hPY_qY, ?_, ?_⟩
      · intro val_v
        obtain ⟨⟨r, s⟩, hsv⟩ := IsLocalization.surj J_PY.primeCompl val_v
        exact ⟨r, s, hJPY_eq ▸ s.2, by rw [mul_comm]; exact hsv⟩
      · intro B _ ρ hρ_units
        have h_units : ∀ y : J_PY.primeCompl, IsUnit (ρ y) :=
          fun y => hρ_units y.1 (hJPY_eq ▸ y.2)
        exact ⟨IsLocalization.lift h_units, IsLocalization.lift_comp h_units⟩
    have : IsDiscreteValuationRing (Localization.AtPrime J_PY) := hDVR_V
    obtain ⟨v_Y, u_Y, ξ, hComp⟩ :=
      hFinishV (Localization.AtPrime J_PY) hinj_RY_V hX_V_ne
    exact ⟨Localization.AtPrime J_PY, inferInstance, inferInstance, hDVR_V, v_Y, u_Y, ξ, hComp⟩

  
  
  
  have hCenterInit : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      (g_W : W ⟶ S) (τ_W : Fin n → (S ⟶ W))
      (α_K : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g₂ η_K)
      (F' : Set ↥C₂_0)
      (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
      (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
      (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
        CategoryTheory.Limits.pullback g₂ η_K)
      (ξ : V),
      IsNC2DPointedSurface Ω n g_W τ_W →
      α_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
        CategoryTheory.Limits.pullback.snd g_W η_K →
      IsCompDVR F' V v_Y u_Y ξ →
      ∃ (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W)
        (q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω)),
        IsDVRCenter g_W α_K V v_Y u_Y v_W q_W ∧
        ∀ ϖ : V, Irreducible ϖ → ∃ d : ℕ, HasValBound V ϖ ξ v_W d := by
    intro W g_W τ_W α_K F' V _ _ _ v_Y u_Y ξ hNC_W hα_snd hData
    have : AlgebraicGeometry.IsProper g_W := hNC_W.2.2.1
    obtain ⟨huY_fst, _hξ_res, m_V, q_Y, R_Y, ι_Y, P_Y, φ_Y, r_ξ,
      hm_V, _hGen_Y, hvY_mV, hιY_open, _hDom_RY, _hinj_φY, hvY_fac, hrξ_eq, _hPY_qY,
      _hsurj_V, _hlift_V⟩ := hData
    have : AlgebraicGeometry.IsOpenImmersion ι_Y := hιY_open
    let u_W := u_Y ≫ α_K.inv
    have hα_inv_snd : α_K.inv ≫ CategoryTheory.Limits.pullback.snd g_W η_K =
        CategoryTheory.Limits.pullback.snd g₂ η_K := by
      rw [← hα_snd, α_K.inv_hom_id_assoc]
    have h_sq : (u_W ≫ CategoryTheory.Limits.pullback.fst g_W η_K) ≫ g_W =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫
          (v_Y ≫ g₂) := by
      calc (u_W ≫ CategoryTheory.Limits.pullback.fst g_W η_K) ≫ g_W
          = u_Y ≫ (α_K.inv ≫ CategoryTheory.Limits.pullback.snd g_W η_K) ≫ η_K := by
              dsimp [u_W]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
              simp [CategoryTheory.Category.assoc]
        _ = u_Y ≫ CategoryTheory.Limits.pullback.snd g₂ η_K ≫ η_K := by rw [hα_inv_snd]
        _ = (u_Y ≫ CategoryTheory.Limits.pullback.fst g₂ η_K) ≫ g₂ := by
              rw [← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫
              (v_Y ≫ g₂) := by rw [← huY_fst, CategoryTheory.Category.assoc]
    have hUnivSpec : (AlgebraicGeometry.topologically @SpecializingMap).universally g_W := by
      have hUC : AlgebraicGeometry.UniversallyClosed g_W := inferInstance
      rw [AlgebraicGeometry.universallyClosed_eq_universallySpecializing] at hUC
      exact hUC.1
    have hVC : AlgebraicGeometry.ValuativeCriterion.Existence g_W :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap g_W hUnivSpec
    let sq : AlgebraicGeometry.ValuativeCommSq g_W :=
      ⟨V, FractionRing V, u_W ≫ CategoryTheory.Limits.pullback.fst g_W η_K, v_Y ≫ g₂, ⟨h_sq⟩⟩
    have : sq.commSq.HasLift := hVC sq
    let v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W := sq.commSq.lift
    have hv_W_gen : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_W =
        u_W ≫ CategoryTheory.Limits.pullback.fst g_W η_K := sq.commSq.fac_left
    have hv_W_base : v_W ≫ g_W = v_Y ≫ g₂ := sq.commSq.fac_right
    have h_mV_sΩ : g_W.base (v_W.base m_V) = s_Ω.base (snd₂.base q_Y) := by
      calc g_W.base (v_W.base m_V)
          = (v_W ≫ g_W).base m_V := rfl
        _ = g₂.base (v_Y.base m_V) := by rw [hv_W_base]; rfl
        _ = (fst₂ ≫ g₂).base q_Y := by rw [hvY_mV]; rfl
        _ = s_Ω.base (snd₂.base q_Y) := by rw [CategoryTheory.Limits.pullback.condition]; rfl
    obtain ⟨q_W, hqW_fst, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (v_W.base m_V) (snd₂.base q_Y) h_mV_sΩ
    refine ⟨v_W, q_W, ⟨hv_W_gen, hv_W_base, m_V, hm_V, hqW_fst.symm⟩, ?_⟩
    intro ϖ hϖ
    obtain ⟨_, ⟨U_A, hUA_aff, rfl⟩, hxA, -⟩ :=
      (AlgebraicGeometry.Scheme.isBasis_affineOpens W).exists_subset_of_mem_open
        (Set.mem_univ (v_W.base m_V)) isOpen_univ
    let A : CommRingCat.{u} := W.presheaf.obj (Opposite.op U_A)
    let ι_A : AlgebraicGeometry.Spec A ⟶ W := hUA_aff.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion ι_A := hUA_aff.isOpenImmersion_fromSpec
    have hmem_A : v_W.base m_V ∈ Set.range ι_A.base := by
      rw [hUA_aff.range_fromSpec]; exact hxA
    obtain ⟨f_A, hf_A⟩ := lift_spec_local m_V hm_V ι_A v_W hmem_A
    let ρ_A : A ⟶ CommRingCat.of V := AlgebraicGeometry.Spec.preimage f_A
    have hρA_fac : AlgebraicGeometry.Spec.map ρ_A ≫ ι_A = v_W := by
      rw [AlgebraicGeometry.Spec.map_preimage, hf_A]
    let U_K := CategoryTheory.Limits.pullback g_W η_K
    let j_W : U_K ⟶ W := CategoryTheory.Limits.pullback.fst g_W η_K
    let j₂ : U_K ⟶ C₂ := α_K.hom ≫ CategoryTheory.Limits.pullback.fst g₂ η_K
    let pt_KV : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) :=
      ⟨⊥, bot_prime_of_domain (FractionRing V)⟩
    have hm_KV : pt_KV.asIdeal = IsLocalRing.maximalIdeal (FractionRing V) := by
      ext z
      constructor
      · intro hz
        rw [Ideal.mem_bot.mp hz]
        exact Ideal.zero_mem _
      · intro hz
        by_contra hz0
        exact (IsLocalRing.notMem_maximalIdeal.mpr (Ne.isUnit hz0)) hz
    let O_UK : Set ↥U_K := j_W.base ⁻¹' Set.range ι_A.base ∩ j₂.base ⁻¹' Set.range ι_Y.base
    have hOpen_O : IsOpen O_UK :=
      (ι_A.isOpenEmbedding.isOpen_range.preimage j_W.continuous).inter
        (ι_Y.isOpenEmbedding.isOpen_range.preimage j₂.continuous)
    have hmem_O : u_W.base pt_KV ∈ O_UK := by
      refine ⟨?_, ?_⟩
      · change (u_W ≫ j_W).base pt_KV ∈ Set.range ι_A.base
        rw [← hv_W_gen, ← hρA_fac]
        exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫
          AlgebraicGeometry.Spec.map ρ_A).base pt_KV, rfl⟩
      · change (u_W ≫ j₂).base pt_KV ∈ Set.range ι_Y.base
        have huW_j2 : u_W ≫ j₂ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_Y := by
          dsimp [u_W, j₂]
          rw [CategoryTheory.Category.assoc, α_K.inv_hom_id_assoc, huY_fst]
        rw [huW_j2, ← hvY_fac]
        exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫
          AlgebraicGeometry.Spec.map φ_Y).base pt_KV, rfl⟩
    obtain ⟨_, ⟨U_D, hUD_aff, rfl⟩, hxD, hUD_sub⟩ :=
      (AlgebraicGeometry.Scheme.isBasis_affineOpens U_K).exists_subset_of_mem_open hmem_O hOpen_O
    let D_ring : CommRingCat.{u} := U_K.presheaf.obj (Opposite.op U_D)
    let ι_D : AlgebraicGeometry.Spec D_ring ⟶ U_K := hUD_aff.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion ι_D := hUD_aff.isOpenImmersion_fromSpec
    have hmem_D : u_W.base pt_KV ∈ Set.range ι_D.base := by
      rw [hUD_aff.range_fromSpec]; exact hxD
    obtain ⟨f_D, hf_D⟩ := lift_spec_local pt_KV hm_KV ι_D u_W hmem_D
    let ρ_D : D_ring ⟶ CommRingCat.of (FractionRing V) := AlgebraicGeometry.Spec.preimage f_D
    have hρD_fac : AlgebraicGeometry.Spec.map ρ_D ≫ ι_D = u_W := by
      rw [AlgebraicGeometry.Spec.map_preimage, hf_D]
    have hrange_DA : Set.range (ι_D ≫ j_W).base ⊆ Set.range ι_A.base := by
      rintro _ ⟨q, rfl⟩
      have hq_UD : ι_D.base q ∈ (U_D : Set ↥U_K) := by
        rw [← hUD_aff.range_fromSpec]; exact ⟨q, rfl⟩
      exact (hUD_sub hq_UD).1
    have hrange_DY : Set.range (ι_D ≫ j₂).base ⊆ Set.range ι_Y.base := by
      rintro _ ⟨q, rfl⟩
      have hq_UD : ι_D.base q ∈ (U_D : Set ↥U_K) := by
        rw [← hUD_aff.range_fromSpec]; exact ⟨q, rfl⟩
      exact (hUD_sub hq_UD).2
    let lift_DA := AlgebraicGeometry.IsOpenImmersion.lift ι_A (ι_D ≫ j_W) hrange_DA
    have hlift_DA : lift_DA ≫ ι_A = ι_D ≫ j_W :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    have : AlgebraicGeometry.IsOpenImmersion (ι_D ≫ j_W) := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion lift_DA :=
      @AlgebraicGeometry.IsOpenImmersion.of_comp _ _ _ lift_DA ι_A _
        (by rw [hlift_DA]; infer_instance)
    let β_A : A ⟶ D_ring := AlgebraicGeometry.Spec.preimage lift_DA
    have hβA_map : AlgebraicGeometry.Spec.map β_A = lift_DA :=
      AlgebraicGeometry.Spec.map_preimage _
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map β_A) := by
      rw [hβA_map]; infer_instance
    let lift_DY := AlgebraicGeometry.IsOpenImmersion.lift ι_Y (ι_D ≫ j₂) hrange_DY
    have hlift_DY : lift_DY ≫ ι_Y = ι_D ≫ j₂ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    let β_Y : R_Y ⟶ D_ring := AlgebraicGeometry.Spec.preimage lift_DY
    have hβY_map : AlgebraicGeometry.Spec.map β_Y = lift_DY :=
      AlgebraicGeometry.Spec.map_preimage _
    have hβA_ρD : β_A ≫ ρ_D = ρ_A ≫ CommRingCat.ofHom (algebraMap V (FractionRing V)) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp, hβA_map]
      apply (CategoryTheory.cancel_mono ι_A).mp
      calc (AlgebraicGeometry.Spec.map ρ_D ≫ lift_DA) ≫ ι_A
          = AlgebraicGeometry.Spec.map ρ_D ≫ (ι_D ≫ j_W) := by
              rw [CategoryTheory.Category.assoc, hlift_DA]
        _ = u_W ≫ j_W := by rw [← CategoryTheory.Category.assoc, hρD_fac]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_W :=
              hv_W_gen.symm
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫
              AlgebraicGeometry.Spec.map ρ_A) ≫ ι_A := by
              rw [← hρA_fac, CategoryTheory.Category.assoc]
    have hβY_ρD : β_Y ≫ ρ_D = φ_Y ≫ CommRingCat.ofHom (algebraMap V (FractionRing V)) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp, hβY_map]
      apply (CategoryTheory.cancel_mono ι_Y).mp
      have huW_j2 : u_W ≫ j₂ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V))) ≫ v_Y := by
        dsimp [u_W, j₂]
        rw [CategoryTheory.Category.assoc, α_K.inv_hom_id_assoc, huY_fst]
      rw [CategoryTheory.Category.assoc, hlift_DY, ← CategoryTheory.Category.assoc, hρD_fac,
        huW_j2, CategoryTheory.Category.assoc, hvY_fac]
    let p_A : AlgebraicGeometry.Spec A := (AlgebraicGeometry.Spec.map β_A).base
      ((AlgebraicGeometry.Spec.map ρ_D).base pt_KV)
    have hpA_in_βA : p_A ∈ Set.range (AlgebraicGeometry.Spec.map β_A).base :=
      ⟨(AlgebraicGeometry.Spec.map ρ_D).base pt_KV, rfl⟩
    obtain ⟨_, ⟨_, ⟨b₀, rfl⟩, rfl⟩, hpA_b0, hb0_sub⟩ :=
      (PrimeSpectrum.isBasis_basic_opens (R := A)).exists_subset_of_mem_open
        hpA_in_βA (AlgebraicGeometry.Spec.map β_A).isOpenEmbedding.isOpen_range
    have hb0_not_pA : b₀ ∉ p_A.asIdeal := (PrimeSpectrum.mem_basicOpen b₀ p_A).mp hpA_b0
    have hρA_b0_ne : ρ_A.hom b₀ ≠ 0 := by
      intro h0
      apply hb0_not_pA
      have h1 : p_A =
          (AlgebraicGeometry.Spec.map
            (ρ_A ≫ CommRingCat.ofHom (algebraMap V (FractionRing V)))).base pt_KV := by
        rw [← hβA_ρD, AlgebraicGeometry.Spec.map_comp]; rfl
      rw [h1]
      change algebraMap V (FractionRing V) (ρ_A.hom b₀) ∈ (⊥ : Ideal (FractionRing V))
      rw [h0, map_zero]
      exact Ideal.zero_mem _
    let ι_b0 : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away b₀)) ⟶
        AlgebraicGeometry.Spec A :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away b₀)))
    have hrange_b0 : Set.range ι_b0.base ⊆ Set.range (AlgebraicGeometry.Spec.map β_A).base := by
      refine Set.Subset.trans ?_ hb0_sub
      rintro _ ⟨q, rfl⟩
      apply (PrimeSpectrum.mem_basicOpen b₀ (ι_b0.base q)).mpr
      intro hb_in
      exact q.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem q.asIdeal hb_in (IsLocalization.Away.algebraMap_isUnit b₀))
    let δ_A := AlgebraicGeometry.IsOpenImmersion.lift (AlgebraicGeometry.Spec.map β_A) ι_b0 hrange_b0
    have hδA_fac : δ_A ≫ AlgebraicGeometry.Spec.map β_A = ι_b0 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    let θ_A : D_ring ⟶ CommRingCat.of (Localization.Away b₀) :=
      AlgebraicGeometry.Spec.preimage δ_A
    have hθA_map : AlgebraicGeometry.Spec.map θ_A = δ_A :=
      AlgebraicGeometry.Spec.map_preimage _
    have hb0_KV_ne : (((algebraMap V (FractionRing V)).comp ρ_A.hom) b₀) ≠ 0 :=
      fun h => hρA_b0_ne ((IsFractionRing.injective V (FractionRing V)) (h.trans (map_zero _).symm))
    have hb0_KV_unit : IsUnit (((algebraMap V (FractionRing V)).comp ρ_A.hom) b₀) :=
      Ne.isUnit hb0_KV_ne
    let ψ_b0 : CommRingCat.of (Localization.Away b₀) ⟶ CommRingCat.of (FractionRing V) :=
      CommRingCat.ofHom (IsLocalization.Away.lift b₀ hb0_KV_unit)
    have hψb0_hom :
        (IsLocalization.Away.lift b₀ hb0_KV_unit).comp (algebraMap A (Localization.Away b₀)) =
          (algebraMap V (FractionRing V)).comp ρ_A.hom :=
      IsLocalization.lift_comp _
    have hψb0_comp : CommRingCat.ofHom (algebraMap A (Localization.Away b₀)) ≫ ψ_b0 =
        ρ_A ≫ CommRingCat.ofHom (algebraMap V (FractionRing V)) := by
      dsimp [ψ_b0]
      rw [← CommRingCat.ofHom_comp, hψb0_hom, CommRingCat.ofHom_comp, CommRingCat.ofHom_hom]
    have hθA_ψ : θ_A ≫ ψ_b0 = ρ_D := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hθA_map]
      apply (CategoryTheory.cancel_mono (AlgebraicGeometry.Spec.map β_A)).mp
      rw [CategoryTheory.Category.assoc, hδA_fac, ← AlgebraicGeometry.Spec.map_comp,
        hψb0_comp, ← hβA_ρD, AlgebraicGeometry.Spec.map_comp]
    obtain ⟨⟨a_el, ⟨_, k, rfl⟩⟩, hak⟩ :=
      IsLocalization.surj (Submonoid.powers b₀) (θ_A.hom (β_Y.hom r_ξ))
    have hb_ξ_eq : ρ_A.hom (b₀ ^ k) * ξ = ρ_A.hom a_el := by
      apply IsFractionRing.injective V (FractionRing V)
      have h1 := congrArg ψ_b0.hom hak
      rw [map_mul] at h1
      have hlhs1 : ψ_b0.hom (θ_A.hom (β_Y.hom r_ξ)) = algebraMap V (FractionRing V) ξ := by
        change (β_Y ≫ θ_A ≫ ψ_b0).hom r_ξ = _
        rw [hθA_ψ, hβY_ρD]
        change algebraMap V (FractionRing V) (φ_Y.hom r_ξ) = _
        rw [hrξ_eq]
      have hlhs2 : ψ_b0.hom (algebraMap A (Localization.Away b₀) (b₀ ^ k)) =
          algebraMap V (FractionRing V) (ρ_A.hom (b₀ ^ k)) :=
        IsLocalization.Away.lift_eq b₀ hb0_KV_unit (b₀ ^ k)
      have hrhs : ψ_b0.hom (algebraMap A (Localization.Away b₀) a_el) =
          algebraMap V (FractionRing V) (ρ_A.hom a_el) :=
        IsLocalization.Away.lift_eq b₀ hb0_KV_unit a_el
      rw [hlhs1, hlhs2, hrhs] at h1
      rw [map_mul, mul_comm, h1]
    have hbk_ne : ρ_A.hom (b₀ ^ k) ≠ 0 := by
      rw [map_pow]; exact pow_ne_zero k hρA_b0_ne
    obtain ⟨u_b, d, hbk_val⟩ := dvr_unit_mul_pow hϖ hbk_ne
    exact ⟨d, A, ι_A, ρ_A, a_el, b₀ ^ k, u_b, inferInstance, hρA_fac, hbk_val, hb_ξ_eq⟩

  have hProperPres : ∀ {W W' : AlgebraicGeometry.Scheme.{u}}
      (g_W : W ⟶ S) (g_W' : W' ⟶ S)
      (α_K : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g₂ η_K)
      (α_K' : CategoryTheory.Limits.pullback g_W' η_K ≅ CategoryTheory.Limits.pullback g₂ η_K)
      (ρ : W' ⟶ W)
      (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
      (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
      (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
        CategoryTheory.Limits.pullback g₂ η_K)
      (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W)
      (q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω))
      (v_W' : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W')
      (q_W' : ↥(CategoryTheory.Limits.pullback g_W' s_Ω)),
      AlgebraicGeometry.IsProper g_W →
      AlgebraicGeometry.IsProper ρ →
      ρ ≫ g_W = g_W' →
      CategoryTheory.Limits.pullback.fst g_W' η_K ≫ ρ =
        (α_K'.hom ≫ α_K.inv) ≫ CategoryTheory.Limits.pullback.fst g_W η_K →
      IsDVRCenter g_W α_K V v_Y u_Y v_W q_W →
      IsDVRCenter g_W' α_K' V v_Y u_Y v_W' q_W' →
      v_W' ≫ ρ = v_W ∧
      (¬ IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback g_W s_Ω)) →
        ¬ IsClosed ({q_W'} : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω))) := by
    intro W W' g_W g_W' α_K α_K' ρ V _ _ _ v_Y u_Y v_W q_W v_W' q_W'
      hProp_W hProp_ρ hρ_g hρ_fst hC_W hC_W'
    have : AlgebraicGeometry.IsProper g_W := hProp_W
    have : AlgebraicGeometry.IsProper ρ := hProp_ρ
    obtain ⟨hvW_gen, hvW_base, m_V, hm_V, hqW_eq⟩ := hC_W
    obtain ⟨hvW'_gen, hvW'_base, m_V', hm_V', hqW'_eq⟩ := hC_W'
    let j_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap V (FractionRing V)))
    have : AlgebraicGeometry.IsDominant j_V :=
      dominant_of_injective (algebraMap V (FractionRing V)) (IsFractionRing.injective V _)
    have hv_eq : v_W' ≫ ρ = v_W := by
      apply AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_W
        (by rw [CategoryTheory.Category.assoc, hρ_g, hvW'_base, hvW_base])
        j_V
      rw [← CategoryTheory.Category.assoc, hvW'_gen, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hρ_fst, hvW_gen]
      simp [CategoryTheory.Category.assoc]
    refine ⟨hv_eq, ?_⟩
    intro hnot_cl hcl'
    apply hnot_cl
    have hm_eq : m_V' = m_V := PrimeSpectrum.ext (hm_V'.trans hm_V.symm)
    have hpt_eq : ρ.base ((CategoryTheory.Limits.pullback.fst g_W' s_Ω).base q_W') =
        (CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W := by
      rw [← hqW'_eq, hm_eq]
      change (v_W' ≫ ρ).base m_V = _
      rw [hv_eq, hqW_eq]
    have hcl_W' : IsClosed ({(CategoryTheory.Limits.pullback.fst g_W' s_Ω).base q_W'} : Set ↥W') := by
      rw [← Set.image_singleton]
      exact (CategoryTheory.Limits.pullback.fst g_W' s_Ω).isClosedEmbedding.isClosedMap _ hcl'
    have hcl_W : IsClosed ({(CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W} : Set ↥W) := by
      rw [← hpt_eq, ← Set.image_singleton]
      exact ρ.isClosedMap _ hcl_W'
    have hpre : (CategoryTheory.Limits.pullback.fst g_W s_Ω).base ⁻¹'
        ({(CategoryTheory.Limits.pullback.fst g_W s_Ω).base q_W} : Set ↥W) = {q_W} := by
      ext x
      simp [(CategoryTheory.Limits.pullback.fst g_W s_Ω).isClosedEmbedding.injective.eq_iff]
    rw [← hpre]
    exact hcl_W.preimage (CategoryTheory.Limits.pullback.fst g_W s_Ω).continuous

  have hUnivBridge : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      (g_W : W ⟶ S) (τ_W : Fin n → (S ⟶ W))
      (α_K : CategoryTheory.Limits.pullback g_W η_K ≅ CategoryTheory.Limits.pullback g₂ η_K),
      IsNC2DPointedSurface Ω n g_W τ_W →
      α_K.hom ≫ CategoryTheory.Limits.pullback.snd g₂ η_K =
        CategoryTheory.Limits.pullback.snd g_W η_K →
      (∀ F' ∈ irreducibleComponents ↥C₂_0,
        ∃ (V : Type u) (_ : CommRing V) (_ : IsDomain V) (_ : IsDiscreteValuationRing V)
          (v_Y : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ C₂)
          (u_Y : AlgebraicGeometry.Spec (CommRingCat.of (FractionRing V)) ⟶
            CategoryTheory.Limits.pullback g₂ η_K)
          (ξ : V)
          (v_W : AlgebraicGeometry.Spec (CommRingCat.of V) ⟶ W)
          (q_W : ↥(CategoryTheory.Limits.pullback g_W s_Ω)),
          IsCompDVR F' V v_Y u_Y ξ ∧
          IsDVRCenter g_W α_K V v_Y u_Y v_W q_W ∧
          ¬ IsClosed ({q_W} : Set ↥(CategoryTheory.Limits.pullback g_W s_Ω))) →
      HasNonclosedComponentCenters Ω g_W g₂ α_K := by
    intro W g_W τ_W α_K hNC_W _hα_snd hAll V_t L_t _ _ _ _ _ _
      u_K v_Wt v_Yt m_t q_Wt q_Yt huK_dom hu_Wt hu_Yt hv_eq_t hm_t hq_Wt hq_Yt ⟨F', hF', hGen_t⟩
    have : AlgebraicGeometry.IsProper g_W := hNC_W.2.2.1
    obtain ⟨V, instCR_V, instDom_V, instDVR_V, v_Y, u_Y, ξ, v_W, q_W, hData, hCent, hNotCl_W⟩ :=
      hAll F' hF'
    letI : CommRing V := instCR_V
    have : IsDomain V := instDom_V
    have : IsDiscreteValuationRing V := instDVR_V
    obtain ⟨huY_fst, _hξ_res, m_V, q_Y, R_Y, ι_Y, P_Y, φ_Y, _r_ξ,
      hm_V, hGen_Y, hvY_mV, hιY_open, hDom_RY, hinj_φY, hvY_fac, _hrξ_eq, hPY_qY,
      hsurj_V, hlift_V⟩ := hData
    have : AlgebraicGeometry.IsOpenImmersion ι_Y := hιY_open
    have : IsDomain R_Y := hDom_RY
    obtain ⟨hvW_gen, hvW_base, m_V', hm_V', hqW_eq⟩ := hCent
    have hmV_eq : m_V' = m_V := PrimeSpectrum.ext (hm_V'.trans hm_V.symm)
    rw [hmV_eq] at hqW_eq
    have hqY_eq : q_Yt = q_Y := hGen_t.eq hGen_Y
    have hmem_Yt : v_Yt.base m_t ∈ Set.range ι_Y.base := by
      rw [hq_Yt, hqY_eq, ← hPY_qY]
      exact ⟨P_Y, rfl⟩
    obtain ⟨f_Yt, hf_Yt⟩ := lift_spec_local m_t hm_t ι_Y v_Yt hmem_Yt
    let ρ_mor : R_Y ⟶ CommRingCat.of V_t := AlgebraicGeometry.Spec.preimage f_Yt
    have hρ_fac : AlgebraicGeometry.Spec.map ρ_mor ≫ ι_Y = v_Yt := by
      rw [AlgebraicGeometry.Spec.map_preimage, hf_Yt]
    have hρ_PY : (AlgebraicGeometry.Spec.map ρ_mor).base m_t = P_Y := by
      apply ι_Y.isOpenEmbedding.injective
      calc ι_Y.base ((AlgebraicGeometry.Spec.map ρ_mor).base m_t)
          = v_Yt.base m_t := by rw [← hρ_fac]; rfl
        _ = ι_Y.base P_Y := by rw [hq_Yt, hqY_eq, ← hPY_qY]
    have hρ_units : ∀ s : R_Y, s ∉ P_Y.asIdeal → IsUnit (ρ_mor.hom s) := by
      intro s hs_not
      apply IsLocalRing.notMem_maximalIdeal.mp
      rw [← hm_t, ← hρ_PY] at *
      exact hs_not
    obtain ⟨ψ, hψ_comp⟩ := hlift_V V_t ρ_mor.hom hρ_units
    have hinj_ρ : Function.Injective ρ_mor.hom := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro r hr_ker
      by_contra hr_ne
      rw [RingHom.mem_ker] at hr_ker
      have hIrred_C₂ : IrreducibleSpace ↥C₂ :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral C₂ hNC₂.1
      let pt_Lt : AlgebraicGeometry.Spec (CommRingCat.of L_t) := ⟨⊥, bot_prime_of_domain L_t⟩
      let fst₂_K := CategoryTheory.Limits.pullback.fst g₂ η_K
      let O_r : Set ↥C₂ := ι_Y.base '' (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R_Y))
      have hOpen_Or : IsOpen O_r :=
        ι_Y.isOpenEmbedding.isOpenMap _ (PrimeSpectrum.basicOpen r).isOpen
      have hNonempty_Or : O_r.Nonempty := by
        refine ⟨ι_Y.base ⟨⊥, bot_prime_of_domain R_Y⟩, ⟨⊥, bot_prime_of_domain R_Y⟩, ?_, rfl⟩
        change (⟨⊥, bot_prime_of_domain R_Y⟩ : PrimeSpectrum R_Y) ∈ PrimeSpectrum.basicOpen r
        rw [PrimeSpectrum.mem_basicOpen, Ideal.mem_bot]
        exact hr_ne
      have hOpen_rngK : IsOpen (Set.range (α_K.hom ≫ fst₂_K).base) := by
        have : AlgebraicGeometry.IsOpenImmersion (α_K.hom ≫ fst₂_K) := inferInstance
        exact (α_K.hom ≫ fst₂_K).isOpenEmbedding.isOpen_range
      have hNonempty_rngK : (Set.range (α_K.hom ≫ fst₂_K).base).Nonempty :=
        ⟨(u_K ≫ α_K.hom ≫ fst₂_K).base pt_Lt, u_K.base pt_Lt, rfl⟩
      obtain ⟨z_int, -, hz_Or, w_UK, rfl⟩ :=
        hIrred_C₂.isPreirreducible_univ O_r (Set.range (α_K.hom ≫ fst₂_K).base) hOpen_Or hOpen_rngK
          ⟨_, trivial, hNonempty_Or.some_mem⟩ ⟨_, trivial, hNonempty_rngK.some_mem⟩
      have hPre_open : IsOpen ((α_K.hom ≫ fst₂_K).base ⁻¹' O_r) :=
        hOpen_Or.preimage (α_K.hom ≫ fst₂_K).continuous
      have hd_uK : DenseRange u_K.base := (AlgebraicGeometry.isDominant_iff u_K).mp huK_dom
      have hw_cl : w_UK ∈ closure (Set.range u_K.base) := hd_uK w_UK
      obtain ⟨_, ⟨hz_pre, q_Lt, rfl⟩⟩ := mem_closure_iff.mp hw_cl _ hPre_open hz_Or
      rw [pt_field_eq q_Lt pt_Lt] at hz_pre
      change (u_K ≫ α_K.hom ≫ fst₂_K).base pt_Lt ∈ O_r at hz_pre
      rw [← hu_Yt, ← hρ_fac] at hz_pre
      obtain ⟨p_r, hp_r, hp_img⟩ := hz_pre
