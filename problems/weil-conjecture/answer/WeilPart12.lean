theorem weil_powerSeries_leibniz_rescale_to_plane_hypersurface (Ω A₀ B₀ : Type u) [Field Ω] [CommRing A₀] [CommRing B₀]
    (f₀ : PowerSeries Ω →+* A₀)
    (q₀ : PrimeSpectrum A₀)
    (hq₀_max : (PrimeSpectrum.comap f₀ q₀).asIdeal = IsLocalRing.maximalIdeal (PowerSeries Ω))
    (hRes : ∀ a : A₀, ∃ c : Ω, a - f₀ (PowerSeries.C c) ∈ q₀.asIdeal)
    (u₁ v₁ : A₀)
    (hu₁ : u₁ ∈ q₀.asIdeal)
    (hv₁ : v₁ ∈ q₀.asIdeal)
    (s_A : A₀)
    (hs_A : s_A ∉ q₀.asIdeal)
    (q'₀ : PrimeSpectrum (Localization.Away s_A))
    (hq'₀ : PrimeSpectrum.comap (algebraMap A₀ (Localization.Away s_A)) q'₀ = q₀)
    (φ₀ : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B₀)
    (hEt₀ : φ₀.Etale)
    (π₀ : B₀ →+* Localization.Away s_A)
    (hSurj₀ : Function.Surjective π₀)
    (hComm₀_full :
      letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
      π₀.comp φ₀ =
        (algebraMap A₀ (Localization.Away s_A)).comp
          (MvPolynomial.aeval (R := PowerSeries Ω) ![u₁, v₁]).toRingHom)
    (Q₀ : PrimeSpectrum B₀)
    (hQ₀ : PrimeSpectrum.comap π₀ q'₀ = Q₀)
    (s₁ g₀ : B₀)
    (hs₁ : s₁ ∉ Q₀.asIdeal)
    (hg₀ : g₀ ∈ RingHom.ker π₀)
    (hPrin : ∀ j ∈ RingHom.ker π₀, ∃ b : B₀, s₁ * j = b * g₀) :
    letI : Algebra (PowerSeries Ω) Ω :=
      (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
    letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
    ∀ (q_Ω : PrimeSpectrum (TensorProduct (PowerSeries Ω) Ω A₀))
      (_hq_Ω : PrimeSpectrum.comap Algebra.TensorProduct.includeRight.toRingHom q_Ω = q₀)
      (_hTangent :
        let L_F := Localization.AtPrime q_Ω.asIdeal
        let loc : TensorProduct (PowerSeries Ω) Ω A₀ →+* L_F :=
          algebraMap (TensorProduct (PowerSeries Ω) Ω A₀) L_F
        let 𝔪 : Ideal L_F := IsLocalRing.maximalIdeal L_F
        Ideal.span
          {loc (Algebra.TensorProduct.includeRight u₁),
           loc (Algebra.TensorProduct.includeRight v₁)} = 𝔪 ∧
        (∀ c₀ c₁ : Ω,
          loc (Algebra.TensorProduct.includeLeftRingHom c₀) *
              loc (Algebra.TensorProduct.includeRight u₁) +
            loc (Algebra.TensorProduct.includeLeftRingHom c₁) *
              loc (Algebra.TensorProduct.includeRight v₁) ∈ 𝔪 ^ 2 →
          c₀ = 0 ∧ c₁ = 0) ∧
        loc (Algebra.TensorProduct.includeRight u₁) *
          loc (Algebra.TensorProduct.includeRight v₁) ∈ 𝔪 ^ 3),
      ∃ (B : Type u) (_ : CommRing B)
        (φ_P : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B)
        (Q : PrimeSpectrum B)
        (F : B)
        (e_hyp : A₀ →+* (B ⧸ Ideal.span {F})),
        φ_P.Etale ∧
        e_hyp.Etale ∧
        Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = IsLocalRing.maximalIdeal (PowerSeries Ω) ∧
        (∀ b : B, ∃ c : PowerSeries Ω, b - φ_P (MvPolynomial.C c) ∈ Q.asIdeal) ∧
        (∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal) ∧
        F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
          Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal (PowerSeries Ω)) ⊔
            Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3 ∧
        e_hyp.comp f₀ =
          (Ideal.Quotient.mk (Ideal.span {F})).comp (φ_P.comp MvPolynomial.C) ∧
        ∃ q_bar : PrimeSpectrum (B ⧸ Ideal.span {F}),
          PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {F})) q_bar = Q ∧
          PrimeSpectrum.comap e_hyp q_bar = q₀ :=
by
  letI : Algebra (PowerSeries Ω) Ω :=
    (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
  letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
  intro q_Ω hq_Ω hTangent
  
  
  
  let R_ps := PowerSeries Ω
  let P₂ := MvPolynomial (Fin 2) R_ps
  letI : Algebra R_ps B₀ := (φ₀.comp MvPolynomial.C).toAlgebra
  have hStep1 : ∃ (d_U d_V : Derivation R_ps B₀ B₀),
      d_U (φ₀ (MvPolynomial.X 0)) = 1 ∧
      d_U (φ₀ (MvPolynomial.X 1)) = 0 ∧
      d_V (φ₀ (MvPolynomial.X 0)) = 0 ∧
      d_V (φ₀ (MvPolynomial.X 1)) = 1 ∧
      ∀ (M : Type u) [AddCommGroup M] [Module R_ps M] [Module B₀ M] [IsScalarTower R_ps B₀ M]
        (δ : Derivation R_ps B₀ M) (b : B₀),
        δ b = d_U b • δ (φ₀ (MvPolynomial.X 0)) + d_V b • δ (φ₀ (MvPolynomial.X 1)) := by
    letI : Algebra P₂ B₀ := φ₀.toAlgebra
    haveI : IsScalarTower R_ps P₂ B₀ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale P₂ B₀ := hEt₀
    haveI : Algebra.FormallyEtale P₂ B₀ := Algebra.Etale.formallyEtale
    let e_K := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R_ps P₂ B₀
    let liftDer : Derivation R_ps P₂ B₀ → Derivation R_ps B₀ B₀ := fun D₀ =>
      KaehlerDifferential.linearMapEquivDerivation R_ps B₀
        ((LinearMap.liftBaseChange B₀ D₀.liftKaehlerDifferential).comp e_K.symm.toLinearMap)
    have hLift_apply : ∀ (D₀ : Derivation R_ps P₂ B₀) (P : P₂),
        liftDer D₀ (φ₀ P) = D₀ P := by
      intro D₀ P
      have heK : e_K (1 ⊗ₜ[P₂] KaehlerDifferential.D R_ps P₂ P) =
          KaehlerDifferential.D R_ps B₀ (φ₀ P) := by
        rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
          KaehlerDifferential.mapBaseChange_tmul, one_smul]
        exact KaehlerDifferential.map_D R_ps R_ps P₂ B₀ P
      have heK_symm : e_K.symm (KaehlerDifferential.D R_ps B₀ (φ₀ P)) =
          1 ⊗ₜ[P₂] KaehlerDifferential.D R_ps P₂ P := by
        rw [← heK, LinearEquiv.symm_apply_apply]
      change ((LinearMap.liftBaseChange B₀ D₀.liftKaehlerDifferential)
        (e_K.symm (KaehlerDifferential.D R_ps B₀ (φ₀ P)))) = D₀ P
      rw [heK_symm, LinearMap.liftBaseChange_tmul, one_smul]
      exact Derivation.liftKaehlerDifferential_comp_D D₀ P
    let D₀_U : Derivation R_ps P₂ B₀ := MvPolynomial.mkDerivation R_ps ![(1 : B₀), 0]
    let D₀_V : Derivation R_ps P₂ B₀ := MvPolynomial.mkDerivation R_ps ![(0 : B₀), 1]
    let d_U : Derivation R_ps B₀ B₀ := liftDer D₀_U
    let d_V : Derivation R_ps B₀ B₀ := liftDer D₀_V
    have hdU0 : d_U (φ₀ (MvPolynomial.X 0)) = 1 := by
      rw [hLift_apply]
      exact MvPolynomial.mkDerivation_X R_ps ![(1 : B₀), 0] (0 : Fin 2)
    have hdU1 : d_U (φ₀ (MvPolynomial.X 1)) = 0 := by
      rw [hLift_apply]
      exact MvPolynomial.mkDerivation_X R_ps ![(1 : B₀), 0] (1 : Fin 2)
    have hdV0 : d_V (φ₀ (MvPolynomial.X 0)) = 0 := by
      rw [hLift_apply]
      exact MvPolynomial.mkDerivation_X R_ps ![(0 : B₀), 1] (0 : Fin 2)
    have hdV1 : d_V (φ₀ (MvPolynomial.X 1)) = 1 := by
      rw [hLift_apply]
      exact MvPolynomial.mkDerivation_X R_ps ![(0 : B₀), 1] (1 : Fin 2)
    refine ⟨d_U, d_V, hdU0, hdU1, hdV0, hdV1, ?_⟩
    intro M _ _ _ _ δ b
    let δ_tilde : Derivation R_ps B₀ M :=
      (LinearMap.toSpanSingleton B₀ M (δ (φ₀ (MvPolynomial.X 0)))).compDer d_U +
        (LinearMap.toSpanSingleton B₀ M (δ (φ₀ (MvPolynomial.X 1)))).compDer d_V
    have htilde_apply : ∀ x : B₀,
        δ_tilde x = d_U x • δ (φ₀ (MvPolynomial.X 0)) + d_V x • δ (φ₀ (MvPolynomial.X 1)) := by
      intro x
      rfl
    letI : Module P₂ M := Module.compHom M φ₀
    haveI : IsScalarTower R_ps P₂ M := IsScalarTower.of_algebraMap_smul fun r m => by
      change φ₀ (MvPolynomial.C r) • m = r • m
      exact IsScalarTower.algebraMap_smul B₀ r m
    haveI : IsScalarTower P₂ B₀ M := IsScalarTower.of_algebraMap_smul fun P m => rfl
    have hCompEq : δ.compAlgebraMap P₂ = δ_tilde.compAlgebraMap P₂ := by
      apply MvPolynomial.derivation_ext
      intro i
      fin_cases i
      · change δ (φ₀ (MvPolynomial.X 0)) = δ_tilde (φ₀ (MvPolynomial.X 0))
        rw [htilde_apply, hdU0, hdV0, one_smul, zero_smul, add_zero]
      · change δ (φ₀ (MvPolynomial.X 1)) = δ_tilde (φ₀ (MvPolynomial.X 1))
        rw [htilde_apply, hdU1, hdV1, zero_smul, one_smul, zero_add]
    let diff : Derivation R_ps B₀ M := δ - δ_tilde
    have hdiff_P₂ : ∀ P : P₂, diff (φ₀ P) = 0 := by
      intro P
      have hP := DFunLike.congr_fun hCompEq P
      change δ (φ₀ P) = δ_tilde (φ₀ P) at hP
      exact sub_eq_zero.mpr hP
    let diff_P₂ : Derivation P₂ B₀ M :=
      { toFun := diff
        map_add' := diff.map_add
        map_smul' := fun P x => by
          change diff (φ₀ P * x) = φ₀ P • diff x
          rw [diff.leibniz, hdiff_P₂ P, smul_zero, add_zero]
        map_one_eq_zero' := diff.map_one_eq_zero
        leibniz' := diff.leibniz }
    have hSub : Subsingleton Ω[B₀⁄P₂] :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    have hdiff_zero : diff_P₂ b = 0 := by
      rw [← Derivation.liftKaehlerDifferential_comp_D diff_P₂ b,
        Subsingleton.elim (KaehlerDifferential.D P₂ B₀ b) 0, map_zero]
    exact sub_eq_zero.mp hdiff_zero
  obtain ⟨d_U, d_V, hdU0, hdU1, hdV0, hdV1, hUniv⟩ := hStep1

  
  
  
  let F_Ω := TensorProduct R_ps Ω A₀
  let L_F := Localization.AtPrime q_Ω.asIdeal
  let loc : F_Ω →+* L_F := algebraMap F_Ω L_F
  let 𝔪 : Ideal L_F := IsLocalRing.maximalIdeal L_F
  have hSpan : Ideal.span
      {loc (Algebra.TensorProduct.includeRight u₁),
       loc (Algebra.TensorProduct.includeRight v₁)} = 𝔪 := hTangent.1
  have hLinIndep := hTangent.2.1
  have hProd : loc (Algebra.TensorProduct.includeRight u₁) *
      loc (Algebra.TensorProduct.includeRight v₁) ∈ 𝔪 ^ 3 := hTangent.2.2

  
  have hSurj_incR : Function.Surjective
      (Algebra.TensorProduct.includeRight : A₀ →ₐ[R_ps] F_Ω) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | tmul c a =>
      refine ⟨f₀ (PowerSeries.C c) * a, ?_⟩
      have hc : (PowerSeries.C c : R_ps) • (1 : Ω) = c := by
        change PowerSeries.constantCoeff (PowerSeries.C c) * 1 = c
        rw [PowerSeries.constantCoeff_C, mul_one]
      calc Algebra.TensorProduct.includeRight (f₀ (PowerSeries.C c) * a)
          = (1 : Ω) ⊗ₜ[R_ps] ((PowerSeries.C c : R_ps) • a) := rfl
        _ = ((PowerSeries.C c : R_ps) • (1 : Ω)) ⊗ₜ[R_ps] a :=
            (TensorProduct.smul_tmul (PowerSeries.C c : R_ps) (1 : Ω) a).symm
        _ = c ⊗ₜ[R_ps] a := by rw [hc]
    | add x y ihx ihy =>
      rcases ihx with ⟨ax, rfl⟩
      rcases ihy with ⟨ay, rfl⟩
      exact ⟨ax + ay, map_add _ ax ay⟩

  have hXdvd : ∀ r : R_ps, PowerSeries.X ∣ PowerSeries.C (PowerSeries.constantCoeff r) - r := by
    intro r
    rw [PowerSeries.X_dvd_iff, map_sub, PowerSeries.constantCoeff_C, sub_self]

  have hKer_incR : ∀ a : A₀,
      (Algebra.TensorProduct.includeRight : A₀ →ₐ[R_ps] F_Ω) a = 0 →
      ∃ r_A : A₀, a = r_A * f₀ PowerSeries.X := by
    intro a ha
    let I_X : Ideal A₀ := Ideal.span {f₀ PowerSeries.X}
    let mk_X := Ideal.Quotient.mk I_X
    let α_Ω : Ω →ₐ[R_ps] (A₀ ⧸ I_X) :=
      { (mk_X.comp (f₀.comp PowerSeries.C)) with
        commutes' := fun r => by
          change mk_X (f₀ (PowerSeries.C (PowerSeries.constantCoeff r))) = mk_X (f₀ r)
          rw [Ideal.Quotient.eq]
          rcases hXdvd r with ⟨h, hh⟩
          have hmap := congrArg f₀ hh
          rw [map_sub, map_mul] at hmap
          rw [hmap]
          exact Ideal.mem_span_singleton.mpr ⟨f₀ h, rfl⟩ }
    let Λ : F_Ω →ₐ[R_ps] (A₀ ⧸ I_X) :=
      Algebra.TensorProduct.lift α_Ω (Ideal.Quotient.mkₐ R_ps I_X) (fun _ _ => Commute.all _ _)
    have hΛa : mk_X a = 0 := by
      have h1 : Λ (Algebra.TensorProduct.includeRight a) = mk_X a := by
        change Λ (1 ⊗ₜ[R_ps] a) = mk_X a
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rw [← h1, ha, map_zero]
    have ha_mem : a ∈ I_X := Ideal.Quotient.eq_zero_iff_mem.mp hΛa
    rcases Ideal.mem_span_singleton.mp ha_mem with ⟨r_A, hr_A⟩
    exact ⟨r_A, by rw [hr_A, mul_comm]⟩

  
  have hf₀X_mem : f₀ PowerSeries.X ∈ q₀.asIdeal := by
    change PowerSeries.X ∈ (PrimeSpectrum.comap f₀ q₀).asIdeal
    rw [hq₀_max, PowerSeries.maximalIdeal_eq_span_X]
    exact Ideal.subset_span rfl

  have hRetract : ∃ ρ : L_F →+* Ω,
      (∀ w : L_F, ρ w = 0 ↔ w ∈ 𝔪) ∧
      (∀ c : Ω, ρ (loc (Algebra.TensorProduct.includeLeftRingHom c)) = c) := by
    let ι_res : Ω →+* (A₀ ⧸ q₀.asIdeal) :=
      (Ideal.Quotient.mk q₀.asIdeal).comp (f₀.comp PowerSeries.C)
    haveI : Nontrivial (A₀ ⧸ q₀.asIdeal) :=
      Ideal.Quotient.nontrivial_iff.mpr q₀.isPrime.ne_top
    have hBij_res : Function.Bijective ι_res := by
      refine ⟨ι_res.injective, ?_⟩
      intro y
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨c, hc⟩ := hRes a
      refine ⟨c, ?_⟩
      change Ideal.Quotient.mk q₀.asIdeal (f₀ (PowerSeries.C c)) =
        Ideal.Quotient.mk q₀.asIdeal a
      rw [Ideal.Quotient.eq]
      have hneg : f₀ (PowerSeries.C c) - a = -(a - f₀ (PowerSeries.C c)) := by ring
      rw [hneg]
      exact q₀.asIdeal.neg_mem hc
    let e_res : Ω ≃+* (A₀ ⧸ q₀.asIdeal) := RingEquiv.ofBijective ι_res hBij_res
    let ρ_A : A₀ →+* Ω := e_res.symm.toRingHom.comp (Ideal.Quotient.mk q₀.asIdeal)
    have hρA_ker : ∀ a : A₀, ρ_A a = 0 ↔ a ∈ q₀.asIdeal := by
      intro a
      change e_res.symm (Ideal.Quotient.mk q₀.asIdeal a) = 0 ↔ a ∈ q₀.asIdeal
      rw [map_eq_zero_iff _ e_res.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hρA_C : ∀ c : Ω, ρ_A (f₀ (PowerSeries.C c)) = c := by
      intro c
      exact e_res.symm_apply_apply c
    let ρ_A_alg : A₀ →ₐ[R_ps] Ω :=
      { ρ_A with
        commutes' := fun r => by
          change ρ_A (f₀ r) = PowerSeries.constantCoeff r
          rcases hXdvd r with ⟨h, hh⟩
          have hsub : f₀ (PowerSeries.C (PowerSeries.constantCoeff r)) - f₀ r ∈ q₀.asIdeal := by
            have hmap := congrArg f₀ hh
            rw [map_sub, map_mul] at hmap
            rw [hmap]
            exact Ideal.mul_mem_right _ _ hf₀X_mem
          have hzero : ρ_A (f₀ (PowerSeries.C (PowerSeries.constantCoeff r)) - f₀ r) = 0 :=
            (hρA_ker _).mpr hsub
          rw [map_sub, hρA_C, sub_eq_zero] at hzero
          exact hzero.symm }
    let ρ_F : F_Ω →+* Ω :=
      (Algebra.TensorProduct.lift (AlgHom.id R_ps Ω) ρ_A_alg
        (fun _ _ => Commute.all _ _)).toRingHom
    have hρF_left : ∀ c : Ω, ρ_F (Algebra.TensorProduct.includeLeftRingHom c) = c := by
      intro c
      change (Algebra.TensorProduct.lift (AlgHom.id R_ps Ω) ρ_A_alg _) (c ⊗ₜ[R_ps] 1) = c
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    have hρF_right : ∀ a : A₀, ρ_F (Algebra.TensorProduct.includeRight a) = ρ_A a := by
      intro a
      change (Algebra.TensorProduct.lift (AlgHom.id R_ps Ω) ρ_A_alg _) (1 ⊗ₜ[R_ps] a) = ρ_A a
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have hρF_ker : ∀ z : F_Ω, ρ_F z = 0 ↔ z ∈ q_Ω.asIdeal := by
      intro z
      obtain ⟨a, rfl⟩ := hSurj_incR z
      rw [hρF_right, hρA_ker]
      have hcomap : a ∈ q₀.asIdeal ↔
          Algebra.TensorProduct.includeRight a ∈ q_Ω.asIdeal := by
        rw [← hq_Ω]
        rfl
      exact hcomap
    have hρF_units : ∀ s : q_Ω.asIdeal.primeCompl, IsUnit (ρ_F s) := by
      intro s
      exact isUnit_iff_ne_zero.mpr (fun hs0 => s.2 ((hρF_ker s).mp hs0))
    let ρ : L_F →+* Ω := IsLocalization.lift (M := q_Ω.asIdeal.primeCompl) hρF_units
    refine ⟨ρ, ?_, ?_⟩
    · intro w
      obtain ⟨⟨z, s⟩, hws⟩ := IsLocalization.surj q_Ω.asIdeal.primeCompl w
      dsimp only at hws
      have hs_unit_LF : IsUnit (loc s) := IsLocalization.map_units L_F s
      have hs_ne_Ω : ρ_F s ≠ 0 := fun hs0 => s.2 ((hρF_ker s).mp hs0)
      have hρ_loc : ∀ y : F_Ω, ρ (loc y) = ρ_F y :=
        IsLocalization.lift_eq (M := q_Ω.asIdeal.primeCompl) hρF_units
      have hw_ρ : ρ w = 0 ↔ z ∈ q_Ω.asIdeal := by
        rw [← mul_eq_zero_iff_right hs_ne_Ω, ← hρ_loc s, ← map_mul, hws, hρ_loc z, hρF_ker]
      have hw_m : w ∈ 𝔪 ↔ z ∈ q_Ω.asIdeal := by
        have hmul_m : w ∈ 𝔪 ↔ w * loc s ∈ 𝔪 := by
          constructor
          · intro hw; exact Ideal.mul_mem_right _ _ hw
          · intro hws_m
            rcases hs_unit_LF.exists_right_inv with ⟨u_inv, hu_inv⟩
            have h1 : (w * loc s) * u_inv ∈ 𝔪 := Ideal.mul_mem_right _ _ hws_m
            rwa [mul_assoc, hu_inv, mul_one] at h1
        rw [hmul_m, hws]
        exact IsLocalization.AtPrime.to_map_mem_maximal_iff L_F q_Ω.asIdeal z
      exact hw_ρ.trans hw_m.symm
    · intro c
      rw [IsLocalization.lift_eq (M := q_Ω.asIdeal.primeCompl) hρF_units, hρF_left]
  obtain ⟨ρ, hKer_ρ, hSec_ρ⟩ := hRetract

  
  have hCubicLift : ∃ (w_A d₀ d₁ d₂ d₃ r_A : A₀),
      w_A ∉ q₀.asIdeal ∧
      w_A * u₁ * v₁ =
        d₀ * u₁ ^ 3 + d₁ * u₁ ^ 2 * v₁ + d₂ * u₁ * v₁ ^ 2 + d₃ * v₁ ^ 3 +
          r_A * f₀ PowerSeries.X := by
    let u_bar : L_F := loc (Algebra.TensorProduct.includeRight u₁)
    let v_bar : L_F := loc (Algebra.TensorProduct.includeRight v₁)
    let I_pair : Ideal L_F := Ideal.span {u_bar, v_bar}
    have hSq : ∀ z ∈ I_pair ^ 2, ∃ q₀' q₁' q₂' : L_F,
        z = q₀' * u_bar ^ 2 + q₁' * u_bar * v_bar + q₂' * v_bar ^ 2 := by
      intro z hz
      rw [pow_two] at hz
      refine Submodule.mul_induction_on hz ?_ ?_
      · intro a ha b hb
        rcases Ideal.mem_span_pair.mp ha with ⟨a₁, a₂, rfl⟩
        rcases Ideal.mem_span_pair.mp hb with ⟨b₁, b₂, rfl⟩
        exact ⟨a₁ * b₁, a₁ * b₂ + a₂ * b₁, a₂ * b₂, by ring⟩
      · rintro x y ⟨qx₀, qx₁, qx₂, rfl⟩ ⟨qy₀, qy₁, qy₂, rfl⟩
        exact ⟨qx₀ + qy₀, qx₁ + qy₁, qx₂ + qy₂, by ring⟩
    have hCube : ∀ w ∈ I_pair ^ 3, ∃ l₀ l₁ l₂ l₃ : L_F,
        w = l₀ * u_bar ^ 3 + l₁ * u_bar ^ 2 * v_bar + l₂ * u_bar * v_bar ^ 2 +
          l₃ * v_bar ^ 3 := by
      intro w hw
      have hw' : w ∈ I_pair ^ 2 * I_pair := by rwa [← pow_succ]
      refine Submodule.mul_induction_on hw' ?_ ?_
      · intro z hz b hb
        rcases hSq z hz with ⟨q₀', q₁', q₂', rfl⟩
        rcases Ideal.mem_span_pair.mp hb with ⟨b₁, b₂, rfl⟩
        exact ⟨q₀' * b₁, q₀' * b₂ + q₁' * b₁, q₁' * b₂ + q₂' * b₁, q₂' * b₂, by ring⟩
      · rintro x y ⟨lx₀, lx₁, lx₂, lx₃, rfl⟩ ⟨ly₀, ly₁, ly₂, ly₃, rfl⟩
        exact ⟨lx₀ + ly₀, lx₁ + ly₁, lx₂ + ly₂, lx₃ + ly₃, by ring⟩
    have hProd_pair : u_bar * v_bar ∈ I_pair ^ 3 := by
      change u_bar * v_bar ∈ (Ideal.span {u_bar, v_bar}) ^ 3
      rwa [hSpan]
    obtain ⟨l₀, l₁, l₂, l₃, hl_eq⟩ := hCube (u_bar * v_bar) hProd_pair
    obtain ⟨⟨z₀, t₀⟩, hz₀⟩ := IsLocalization.surj q_Ω.asIdeal.primeCompl l₀
    obtain ⟨⟨z₁, t₁⟩, hz₁⟩ := IsLocalization.surj q_Ω.asIdeal.primeCompl l₁
    obtain ⟨⟨z₂, t₂⟩, hz₂⟩ := IsLocalization.surj q_Ω.asIdeal.primeCompl l₂
    obtain ⟨⟨z₃, t₃⟩, hz₃⟩ := IsLocalization.surj q_Ω.asIdeal.primeCompl l₃
    dsimp only at hz₀ hz₁ hz₂ hz₃
    let u_F : F_Ω := Algebra.TensorProduct.includeRight u₁
    let v_F : F_Ω := Algebra.TensorProduct.includeRight v₁
    have hClear_LF :
        loc ((t₀.1 * t₁.1 * t₂.1 * t₃.1) * (u_F * v_F)) =
          loc ((z₀ * t₁.1 * t₂.1 * t₃.1) * u_F ^ 3 +
            (z₁ * t₀.1 * t₂.1 * t₃.1) * u_F ^ 2 * v_F +
            (z₂ * t₀.1 * t₁.1 * t₃.1) * u_F * v_F ^ 2 +
            (z₃ * t₀.1 * t₁.1 * t₂.1) * v_F ^ 3) := by
      simp only [map_mul, map_add, map_pow]
      change (loc t₀.1 * loc t₁.1 * loc t₂.1 * loc t₃.1) * (u_bar * v_bar) =
        (loc z₀ * loc t₁.1 * loc t₂.1 * loc t₃.1) * u_bar ^ 3 +
          (loc z₁ * loc t₀.1 * loc t₂.1 * loc t₃.1) * u_bar ^ 2 * v_bar +
          (loc z₂ * loc t₀.1 * loc t₁.1 * loc t₃.1) * u_bar * v_bar ^ 2 +
          (loc z₃ * loc t₀.1 * loc t₁.1 * loc t₂.1) * v_bar ^ 3
      rw [hl_eq, ← hz₀, ← hz₁, ← hz₂, ← hz₃]
      ring
    obtain ⟨t₄, ht₄_eq⟩ :=
      IsLocalization.exists_of_eq (M := q_Ω.asIdeal.primeCompl) hClear_LF
    let t_prod : q_Ω.asIdeal.primeCompl := t₄ * (t₀ * t₁ * t₂ * t₃)
    obtain ⟨w_A, hw_A_eq⟩ := hSurj_incR t_prod.1
    obtain ⟨d₀, hd₀_eq⟩ := hSurj_incR (t₄.1 * z₀ * t₁.1 * t₂.1 * t₃.1)
    obtain ⟨d₁, hd₁_eq⟩ := hSurj_incR (t₄.1 * z₁ * t₀.1 * t₂.1 * t₃.1)
    obtain ⟨d₂, hd₂_eq⟩ := hSurj_incR (t₄.1 * z₂ * t₀.1 * t₁.1 * t₃.1)
    obtain ⟨d₃, hd₃_eq⟩ := hSurj_incR (t₄.1 * z₃ * t₀.1 * t₁.1 * t₂.1)
    have hw_A_notMem : w_A ∉ q₀.asIdeal := by
      intro hw_in
      have h1 : Algebra.TensorProduct.includeRight w_A ∈ q_Ω.asIdeal := by
        rw [← hq_Ω] at hw_in
        exact hw_in
      rw [hw_A_eq] at h1
      exact t_prod.2 h1
    have hDiff_ker :
        (Algebra.TensorProduct.includeRight : A₀ →ₐ[R_ps] F_Ω)
          (w_A * u₁ * v₁ -
            (d₀ * u₁ ^ 3 + d₁ * u₁ ^ 2 * v₁ + d₂ * u₁ * v₁ ^ 2 + d₃ * v₁ ^ 3)) = 0 := by
      simp only [map_sub, map_add, map_mul, map_pow, hw_A_eq, hd₀_eq, hd₁_eq, hd₂_eq, hd₃_eq]
      change t_prod.1 * u_F * v_F -
        ((t₄.1 * z₀ * t₁.1 * t₂.1 * t₃.1) * u_F ^ 3 +
          (t₄.1 * z₁ * t₀.1 * t₂.1 * t₃.1) * u_F ^ 2 * v_F +
          (t₄.1 * z₂ * t₀.1 * t₁.1 * t₃.1) * u_F * v_F ^ 2 +
          (t₄.1 * z₃ * t₀.1 * t₁.1 * t₂.1) * v_F ^ 3) = 0
      have hsub := sub_eq_zero.mpr ht₄_eq
      have heq_poly :
          t_prod.1 * u_F * v_F -
            ((t₄.1 * z₀ * t₁.1 * t₂.1 * t₃.1) * u_F ^ 3 +
              (t₄.1 * z₁ * t₀.1 * t₂.1 * t₃.1) * u_F ^ 2 * v_F +
              (t₄.1 * z₂ * t₀.1 * t₁.1 * t₃.1) * u_F * v_F ^ 2 +
              (t₄.1 * z₃ * t₀.1 * t₁.1 * t₂.1) * v_F ^ 3) =
          t₄.1 * ((t₀.1 * t₁.1 * t₂.1 * t₃.1) * (u_F * v_F)) -
            t₄.1 * ((z₀ * t₁.1 * t₂.1 * t₃.1) * u_F ^ 3 +
              (z₁ * t₀.1 * t₂.1 * t₃.1) * u_F ^ 2 * v_F +
              (z₂ * t₀.1 * t₁.1 * t₃.1) * u_F * v_F ^ 2 +
              (z₃ * t₀.1 * t₁.1 * t₂.1) * v_F ^ 3) := by
        change (t₄.1 * (t₀.1 * t₁.1 * t₂.1 * t₃.1)) * u_F * v_F - _ = _
        ring
      rw [heq_poly]
      exact hsub
    obtain ⟨r_A, hr_A⟩ := hKer_incR _ hDiff_ker
    refine ⟨w_A, d₀, d₁, d₂, d₃, r_A, hw_A_notMem, ?_⟩
    linear_combination hr_A
  obtain ⟨w_A, d₀, d₁, d₂, d₃, r_A, hw_A, hCubic_A⟩ := hCubicLift

  
  
  
  let A'₀ := Localization.Away s_A
  let U₀ : B₀ := φ₀ (MvPolynomial.X 0)
  let V₀ : B₀ := φ₀ (MvPolynomial.X 1)
  let z_X : B₀ := φ₀ (MvPolynomial.C PowerSeries.X)

  have hπ₀_U₀ : π₀ U₀ = algebraMap A₀ A'₀ u₁ := by
    have h := RingHom.congr_fun hComm₀_full (MvPolynomial.X 0)
    simpa [U₀] using h
  have hπ₀_V₀ : π₀ V₀ = algebraMap A₀ A'₀ v₁ := by
    have h := RingHom.congr_fun hComm₀_full (MvPolynomial.X 1)
    simpa [V₀] using h
  have hComm₀_C : π₀.comp (φ₀.comp MvPolynomial.C) = (algebraMap A₀ A'₀).comp f₀ := by
    ext r
    have h := RingHom.congr_fun hComm₀_full (MvPolynomial.C r)
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      MvPolynomial.aeval_C] at h
    exact h

  have hMem_q'₀ : ∀ a : A₀, algebraMap A₀ A'₀ a ∈ q'₀.asIdeal ↔ a ∈ q₀.asIdeal := by
    intro a
    change a ∈ (PrimeSpectrum.comap (algebraMap A₀ A'₀) q'₀).asIdeal ↔ a ∈ q₀.asIdeal
    rw [hq'₀]
  have hMem_Q₀ : ∀ b : B₀, b ∈ Q₀.asIdeal ↔ π₀ b ∈ q'₀.asIdeal := by
    intro b
    rw [← hQ₀]
    rfl

  have hU₀_mem : U₀ ∈ Q₀.asIdeal := by
    rw [hMem_Q₀, hπ₀_U₀, hMem_q'₀]
    exact hu₁
  have hV₀_mem : V₀ ∈ Q₀.asIdeal := by
    rw [hMem_Q₀, hπ₀_V₀, hMem_q'₀]
    exact hv₁
  have hg₀_mem : g₀ ∈ Q₀.asIdeal := by
    rw [hMem_Q₀, RingHom.mem_ker.mp hg₀]
    exact q'₀.asIdeal.zero_mem
  have hQ₀_comap_C : Q₀.asIdeal.comap (φ₀.comp MvPolynomial.C) =
      IsLocalRing.maximalIdeal R_ps := by
    ext r
    change φ₀ (MvPolynomial.C r) ∈ Q₀.asIdeal ↔ r ∈ IsLocalRing.maximalIdeal R_ps
    rw [hMem_Q₀]
    have hCr : π₀ (φ₀ (MvPolynomial.C r)) = algebraMap A₀ A'₀ (f₀ r) :=
      RingHom.congr_fun hComm₀_C r
    rw [hCr, hMem_q'₀]
    change r ∈ (PrimeSpectrum.comap f₀ q₀).asIdeal ↔ r ∈ IsLocalRing.maximalIdeal R_ps
    rw [hq₀_max]
  have hz_X_mem : z_X ∈ Q₀.asIdeal := by
    change PowerSeries.X ∈ Q₀.asIdeal.comap (φ₀.comp MvPolynomial.C)
    rw [hQ₀_comap_C, PowerSeries.maximalIdeal_eq_span_X]
    exact Ideal.subset_span rfl

  
  let θ₀ : A₀ →+* L_F := loc.comp Algebra.TensorProduct.includeRight.toRingHom
  have hθ₀_mem : ∀ a : A₀, θ₀ a ∈ 𝔪 ↔ a ∈ q₀.asIdeal := by
    intro a
    change loc (Algebra.TensorProduct.includeRight a) ∈ 𝔪 ↔ a ∈ q₀.asIdeal
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff L_F q_Ω.asIdeal]
    rw [← hq_Ω]
    rfl
  have hθ₀_sA_unit : IsUnit (θ₀ s_A) :=
    IsLocalRing.notMem_maximalIdeal.mp (fun h => hs_A ((hθ₀_mem s_A).mp h))
  let θ_loc : A'₀ →+* L_F := IsLocalization.Away.lift s_A hθ₀_sA_unit
  have hθ_loc_eq : ∀ a : A₀, θ_loc (algebraMap A₀ A'₀ a) = θ₀ a :=
    IsLocalization.Away.lift_eq s_A hθ₀_sA_unit
  have hθ_loc_mem : ∀ z : A'₀, θ_loc z ∈ 𝔪 ↔ z ∈ q'₀.asIdeal := by
    intro z
    obtain ⟨⟨a, _, k, rfl⟩, hza⟩ := IsLocalization.surj (Submonoid.powers s_A) z
    dsimp only at hza
    have hsA_pow_unit : IsUnit (θ_loc (algebraMap A₀ A'₀ (s_A ^ k))) := by
      rw [hθ_loc_eq, map_pow]
      exact hθ₀_sA_unit.pow k
    have hsA_not_q'₀ : algebraMap A₀ A'₀ (s_A ^ k) ∉ q'₀.asIdeal := by
      rw [map_pow]
      exact fun h => hs_A ((hMem_q'₀ s_A).mp (q'₀.isPrime.mem_of_pow_mem k h))
    have hm_iff : θ_loc z ∈ 𝔪 ↔ a ∈ q₀.asIdeal := by
      have hmul : θ_loc z ∈ 𝔪 ↔ θ_loc z * θ_loc (algebraMap A₀ A'₀ (s_A ^ k)) ∈ 𝔪 := by
        constructor
        · intro hz_m; exact Ideal.mul_mem_right _ _ hz_m
        · intro hprod
          rcases hsA_pow_unit.exists_right_inv with ⟨u_inv, hu_inv⟩
          have h1 : (θ_loc z * θ_loc (algebraMap A₀ A'₀ (s_A ^ k))) * u_inv ∈ 𝔪 :=
            Ideal.mul_mem_right _ _ hprod
          rwa [mul_assoc, hu_inv, mul_one] at h1
      rw [hmul, ← map_mul, hza, hθ_loc_eq, hθ₀_mem]
    have hq_iff : z ∈ q'₀.asIdeal ↔ a ∈ q₀.asIdeal := by
      have hmul : z ∈ q'₀.asIdeal ↔ z * algebraMap A₀ A'₀ (s_A ^ k) ∈ q'₀.asIdeal := by
        constructor
        · intro hz_q; exact Ideal.mul_mem_right _ _ hz_q
        · intro hprod
          rcases q'₀.isPrime.mem_or_mem hprod with h1 | h2
          · exact h1
          · exact False.elim (hsA_not_q'₀ h2)
      rw [hmul, hza, hMem_q'₀]
    exact hm_iff.trans hq_iff.symm

  let Ψ : B₀ →+* L_F := θ_loc.comp π₀
  let ι_Ω : Ω →+* L_F := loc.comp Algebra.TensorProduct.includeLeftRingHom
  have hSec_ι : ∀ c : Ω, ρ (ι_Ω c) = c := hSec_ρ
  have hΨ_mem : ∀ b : B₀, Ψ b ∈ 𝔪 ↔ b ∈ Q₀.asIdeal := by
    intro b
    exact (hθ_loc_mem (π₀ b)).trans (hMem_Q₀ b).symm
  have hΨ_g₀ : Ψ g₀ = 0 := by
    change θ_loc (π₀ g₀) = 0
    rw [RingHom.mem_ker.mp hg₀, map_zero]
  have hΨ_U₀ : Ψ U₀ = loc (Algebra.TensorProduct.includeRight u₁) := by
    change θ_loc (π₀ U₀) = _
    rw [hπ₀_U₀, hθ_loc_eq]
    rfl
  have hΨ_V₀ : Ψ V₀ = loc (Algebra.TensorProduct.includeRight v₁) := by
    change θ_loc (π₀ V₀) = _
    rw [hπ₀_V₀, hθ_loc_eq]
    rfl
  have hΨ_C : ∀ r : R_ps, Ψ (φ₀ (MvPolynomial.C r)) = ι_Ω (PowerSeries.constantCoeff r) := by
    intro r
    have hCr : π₀ (φ₀ (MvPolynomial.C r)) = algebraMap A₀ A'₀ (f₀ r) :=
      RingHom.congr_fun hComm₀_C r
    change θ_loc (π₀ (φ₀ (MvPolynomial.C r))) = loc ((PowerSeries.constantCoeff r) ⊗ₜ[R_ps] 1)
    rw [hCr, hθ_loc_eq]
    have hrA : f₀ r = r • (1 : A₀) := by
      change f₀ r = f₀ r * 1
      rw [mul_one]
    have hrΩ : PowerSeries.constantCoeff r = r • (1 : Ω) := by
      change PowerSeries.constantCoeff r = PowerSeries.constantCoeff r * 1
      rw [mul_one]
    change loc ((1 : Ω) ⊗ₜ[R_ps] f₀ r) = loc ((PowerSeries.constantCoeff r) ⊗ₜ[R_ps] (1 : A₀))
    rw [hrA, hrΩ, TensorProduct.smul_tmul]

  
  let Q₂ : Type u := L_F ⧸ (𝔪 ^ 2 : Ideal L_F)
  let mk₂ : L_F →+* Q₂ := Ideal.Quotient.mk (𝔪 ^ 2 : Ideal L_F)
  letI : Module B₀ Q₂ := Module.compHom Q₂ (mk₂.comp Ψ)
  have hTower_Q₂ : IsScalarTower R_ps B₀ Q₂ := IsScalarTower.of_algebraMap_smul fun r q => by
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
    have hsmul_B₀ : (algebraMap R_ps B₀ r) • mk₂ x = mk₂ (Ψ (φ₀ (MvPolynomial.C r))) * mk₂ x := rfl
    have hsmul_R : r • mk₂ x = mk₂ (r • x) :=
      (map_smul (Ideal.Quotient.mkₐ R_ps (𝔪 ^ 2 : Ideal L_F)) r x).symm
    have hsmul_LF : r • x = ι_Ω (PowerSeries.constantCoeff r) * x := by
      rw [Algebra.smul_def]
      congr 1
    rw [hsmul_B₀, hΨ_C r, ← mk₂.map_mul, hsmul_R, hsmul_LF]
  haveI : IsScalarTower R_ps B₀ Q₂ := hTower_Q₂

  have hSub_ρ_mem : ∀ z : L_F, z - ι_Ω (ρ z) ∈ 𝔪 := by
    intro z
    rw [← hKer_ρ, map_sub, hSec_ι, sub_self]

  let δ : Derivation R_ps B₀ Q₂ :=
    { toFun := fun b => mk₂ (Ψ b - ι_Ω (ρ (Ψ b)))
      map_add' := fun x y => by
        rw [← map_add]
        congr 1
        simp only [map_add]
        ring
      map_smul' := fun r b => by
        rw [RingHom.id_apply,
          ← IsScalarTower.algebraMap_smul B₀ r (mk₂ (Ψ b - ι_Ω (ρ (Ψ b))))]
        change mk₂ (Ψ (φ₀ (MvPolynomial.C r) * b) - ι_Ω (ρ (Ψ (φ₀ (MvPolynomial.C r) * b)))) =
          mk₂ (Ψ (φ₀ (MvPolynomial.C r))) * mk₂ (Ψ b - ι_Ω (ρ (Ψ b)))
        rw [← mk₂.map_mul]
        congr 1
        rw [Ψ.map_mul, hΨ_C r, ρ.map_mul, hSec_ι (PowerSeries.constantCoeff r), ι_Ω.map_mul]
        ring
      map_one_eq_zero' := by
        change mk₂ (Ψ 1 - ι_Ω (ρ (Ψ 1))) = 0
        rw [map_one, map_one, map_one, sub_self, map_zero]
      leibniz' := fun b₁ b₂ => by
        change mk₂ (Ψ (b₁ * b₂) - ι_Ω (ρ (Ψ (b₁ * b₂)))) =
          mk₂ (Ψ b₁) * mk₂ (Ψ b₂ - ι_Ω (ρ (Ψ b₂))) +
            mk₂ (Ψ b₂) * mk₂ (Ψ b₁ - ι_Ω (ρ (Ψ b₁)))
        rw [← mk₂.map_mul, ← mk₂.map_mul, ← mk₂.map_add, Ideal.Quotient.eq]
        simp only [map_mul]
        have h_ident :
            (Ψ b₁ * Ψ b₂ - ι_Ω (ρ (Ψ b₁)) * ι_Ω (ρ (Ψ b₂))) -
              (Ψ b₁ * (Ψ b₂ - ι_Ω (ρ (Ψ b₂))) + Ψ b₂ * (Ψ b₁ - ι_Ω (ρ (Ψ b₁)))) =
            -((Ψ b₁ - ι_Ω (ρ (Ψ b₁))) * (Ψ b₂ - ι_Ω (ρ (Ψ b₂)))) := by ring
        rw [h_ident]
        apply (𝔪 ^ 2).neg_mem
        rw [pow_two]
        exact Ideal.mul_mem_mul (hSub_ρ_mem (Ψ b₁)) (hSub_ρ_mem (Ψ b₂)) }

  have hdUg₀_mem : d_U g₀ ∈ Q₀.asIdeal ∧ d_V g₀ ∈ Q₀.asIdeal := by
    have hExp := @hUniv Q₂ _ _ _ hTower_Q₂ δ g₀
    have hδ_g₀ : δ g₀ = 0 := by
      change mk₂ (Ψ g₀ - ι_Ω (ρ (Ψ g₀))) = 0
      rw [hΨ_g₀, map_zero, map_zero, sub_zero, map_zero]
    have hδ_U₀ : δ U₀ = mk₂ (Ψ U₀) := by
      change mk₂ (Ψ U₀ - ι_Ω (ρ (Ψ U₀))) = mk₂ (Ψ U₀)
      have hρU : ρ (Ψ U₀) = 0 := (hKer_ρ (Ψ U₀)).mpr ((hΨ_mem U₀).mpr hU₀_mem)
      rw [hρU, map_zero, sub_zero]
    have hδ_V₀ : δ V₀ = mk₂ (Ψ V₀) := by
      change mk₂ (Ψ V₀ - ι_Ω (ρ (Ψ V₀))) = mk₂ (Ψ V₀)
      have hρV : ρ (Ψ V₀) = 0 := (hKer_ρ (Ψ V₀)).mpr ((hΨ_mem V₀).mpr hV₀_mem)
      rw [hρV, map_zero, sub_zero]
    rw [hδ_g₀] at hExp
    change (0 : Q₂) = mk₂ (Ψ (d_U g₀)) * δ U₀ + mk₂ (Ψ (d_V g₀)) * δ V₀ at hExp
    rw [hδ_U₀, hδ_V₀, ← mk₂.map_mul, ← mk₂.map_mul, ← mk₂.map_add] at hExp
    have hSum_m2 : Ψ (d_U g₀) * Ψ U₀ + Ψ (d_V g₀) * Ψ V₀ ∈ 𝔪 ^ 2 :=
      Ideal.Quotient.eq_zero_iff_mem.mp hExp.symm
    let c₀ : Ω := ρ (Ψ (d_U g₀))
    let c₁ : Ω := ρ (Ψ (d_V g₀))
    have hDiff0_m2 : (Ψ (d_U g₀) - ι_Ω c₀) * Ψ U₀ ∈ 𝔪 ^ 2 := by
      rw [pow_two]
      exact Ideal.mul_mem_mul (hSub_ρ_mem (Ψ (d_U g₀))) ((hΨ_mem U₀).mpr hU₀_mem)
    have hDiff1_m2 : (Ψ (d_V g₀) - ι_Ω c₁) * Ψ V₀ ∈ 𝔪 ^ 2 := by
      rw [pow_two]
      exact Ideal.mul_mem_mul (hSub_ρ_mem (Ψ (d_V g₀))) ((hΨ_mem V₀).mpr hV₀_mem)
    have hLin_m2 : ι_Ω c₀ * Ψ U₀ + ι_Ω c₁ * Ψ V₀ ∈ 𝔪 ^ 2 := by
      have heq : ι_Ω c₀ * Ψ U₀ + ι_Ω c₁ * Ψ V₀ =
          (Ψ (d_U g₀) * Ψ U₀ + Ψ (d_V g₀) * Ψ V₀) -
            ((Ψ (d_U g₀) - ι_Ω c₀) * Ψ U₀ + (Ψ (d_V g₀) - ι_Ω c₁) * Ψ V₀) := by ring
      rw [heq]
      exact (𝔪 ^ 2).sub_mem hSum_m2 ((𝔪 ^ 2).add_mem hDiff0_m2 hDiff1_m2)
    rw [hΨ_U₀, hΨ_V₀] at hLin_m2
    obtain ⟨hc₀, hc₁⟩ := hLinIndep c₀ c₁ hLin_m2
    exact ⟨(hΨ_mem (d_U g₀)).mp ((hKer_ρ _).mp hc₀),
           (hΨ_mem (d_V g₀)).mp ((hKer_ρ _).mp hc₁)⟩
  obtain ⟨hdUg₀, hdVg₀⟩ := hdUg₀_mem

  
  obtain ⟨w_B, hw_B_eq⟩ := hSurj₀ (algebraMap A₀ A'₀ w_A)
  obtain ⟨D₀_B, hD₀_eq⟩ := hSurj₀ (algebraMap A₀ A'₀ d₀)
  obtain ⟨D₁_B, hD₁_eq⟩ := hSurj₀ (algebraMap A₀ A'₀ d₁)
  obtain ⟨D₂_B, hD₂_eq⟩ := hSurj₀ (algebraMap A₀ A'₀ d₂)
  obtain ⟨D₃_B, hD₃_eq⟩ := hSurj₀ (algebraMap A₀ A'₀ d₃)
  obtain ⟨r_B, hr_B_eq⟩ := hSurj₀ (algebraMap A₀ A'₀ r_A)

  have hw_B_notMem : w_B ∉ Q₀.asIdeal := by
    rw [hMem_Q₀, hw_B_eq, hMem_q'₀]
    exact hw_A

  let c₃ : B₀ :=
    D₀_B * U₀ ^ 3 + D₁_B * U₀ ^ 2 * V₀ + D₂_B * U₀ * V₀ ^ 2 + D₃_B * V₀ ^ 3
  have hj₀_ker : w_B * U₀ * V₀ - c₃ - r_B * z_X ∈ RingHom.ker π₀ := by
    rw [RingHom.mem_ker]
    have hπ_zX : π₀ z_X = algebraMap A₀ A'₀ (f₀ PowerSeries.X) :=
      RingHom.congr_fun hComm₀_C PowerSeries.X
    simp only [c₃, map_sub, map_add, map_mul, map_pow,
      hw_B_eq, hD₀_eq, hD₁_eq, hD₂_eq, hD₃_eq, hr_B_eq, hπ₀_U₀, hπ₀_V₀, hπ_zX]
    rw [← map_pow, ← map_pow, ← map_pow, ← map_pow]
    simp only [← map_mul, ← map_add, ← map_sub]
    rw [sub_sub, hCubic_A, sub_self, map_zero]

  obtain ⟨β, hβ_prin⟩ := hPrin _ hj₀_ker
  let w_tot : B₀ := s₁ * w_B
  have hw_tot_notMem : w_tot ∉ Q₀.asIdeal := Q₀.isPrime.mul_notMem hs₁ hw_B_notMem

  have hRel_B₀ : w_tot * U₀ * V₀ = β * g₀ + s₁ * c₃ + s₁ * r_B * z_X := by
    change (s₁ * w_B) * U₀ * V₀ = _
    linear_combination hβ_prin

  have hdU_prod2 : ∀ (k p q : B₀), p ∈ Q₀.asIdeal → q ∈ Q₀.asIdeal →
      d_U (k * (p * q)) ∈ Q₀.asIdeal := by
    intro k p q hp hq
    have h1 : d_U (k * (p * q)) =
        k * (p * d_U q + q * d_U p) + (p * q) * d_U k := by
      rw [d_U.leibniz, d_U.leibniz]
      rfl
    rw [h1]
    exact Q₀.asIdeal.add_mem
      (Q₀.asIdeal.mul_mem_left k
        (Q₀.asIdeal.add_mem (Q₀.asIdeal.mul_mem_right _ hp) (Q₀.asIdeal.mul_mem_right _ hq)))
      (Q₀.asIdeal.mul_mem_right _ (Q₀.asIdeal.mul_mem_right _ hp))

  have hdUdV_prod3 : ∀ (h x y z : B₀),
      x ∈ Q₀.asIdeal → y ∈ Q₀.asIdeal → z ∈ Q₀.asIdeal →
      d_U (d_V (h * x * y * z)) ∈ Q₀.asIdeal := by
    intro h x y z hx hy hz
    have h_assoc : h * x * y * z = (h * x) * (y * z) := by ring
    have hdV_eq : d_V ((h * x) * (y * z)) =
        (h * d_V z) * (x * y) + (h * d_V y) * (x * z) + d_V (h * x) * (y * z) := by
      have h1 : d_V ((h * x) * (y * z)) =
          (h * x) * (y * d_V z + z * d_V y) + (y * z) * d_V (h * x) := by
        rw [d_V.leibniz, d_V.leibniz]
        rfl
      rw [h1]
      ring
    rw [h_assoc, hdV_eq, map_add, map_add]
    exact Q₀.asIdeal.add_mem
      (Q₀.asIdeal.add_mem (hdU_prod2 _ x y hx hy) (hdU_prod2 _ x z hx hz))
      (hdU_prod2 _ y z hy hz)

  have hPieceA : d_U (d_V (w_tot * U₀ * V₀)) - w_tot ∈ Q₀.asIdeal := by
    have hdV_lhs : d_V (w_tot * U₀ * V₀) = w_tot * U₀ + d_V w_tot * (U₀ * V₀) := by
      have h1 : d_V ((w_tot * U₀) * V₀) =
          (w_tot * U₀) * d_V V₀ + V₀ * (w_tot * d_V U₀ + U₀ * d_V w_tot) := by
        rw [d_V.leibniz, d_V.leibniz]
        rfl
      change d_V ((w_tot * U₀) * V₀) = _
      rw [h1, hdV1, hdV0]
      ring
    have hdU_wU : d_U (w_tot * U₀) = w_tot + U₀ * d_U w_tot := by
      have h1 : d_U (w_tot * U₀) = w_tot * d_U U₀ + U₀ * d_U w_tot := d_U.leibniz w_tot U₀
      rw [h1, hdU0, mul_one]
    rw [hdV_lhs, map_add, hdU_wU]
    have hring : w_tot + U₀ * d_U w_tot + d_U (d_V w_tot * (U₀ * V₀)) - w_tot =
        U₀ * d_U w_tot + d_U (d_V w_tot * (U₀ * V₀)) := by ring
    rw [hring]
    exact Q₀.asIdeal.add_mem (Q₀.asIdeal.mul_mem_right _ hU₀_mem)
      (hdU_prod2 (d_V w_tot) U₀ V₀ hU₀_mem hV₀_mem)

  have hPieceB : d_U (d_V (β * g₀)) - β * d_U (d_V g₀) ∈ Q₀.asIdeal := by
    have h1 : d_V (β * g₀) = β * d_V g₀ + g₀ * d_V β := d_V.leibniz β g₀
    have h2 : d_U (β * d_V g₀ + g₀ * d_V β) =
        (β * d_U (d_V g₀) + d_V g₀ * d_U β) + (g₀ * d_U (d_V β) + d_V β * d_U g₀) := by
      rw [map_add, d_U.leibniz, d_U.leibniz]
      rfl
    rw [h1, h2]
    have hring : ((β * d_U (d_V g₀) + d_V g₀ * d_U β) + (g₀ * d_U (d_V β) + d_V β * d_U g₀)) -
        β * d_U (d_V g₀) =
        d_V g₀ * d_U β + g₀ * d_U (d_V β) + d_V β * d_U g₀ := by ring
    rw [hring]
    exact Q₀.asIdeal.add_mem
      (Q₀.asIdeal.add_mem (Q₀.asIdeal.mul_mem_right _ hdVg₀)
        (Q₀.asIdeal.mul_mem_right _ hg₀_mem))
      (Q₀.asIdeal.mul_mem_left _ hdUg₀)

  have hPieceC : d_U (d_V (s₁ * c₃)) ∈ Q₀.asIdeal := by
    have hc3_exp : s₁ * c₃ =
        (s₁ * D₀_B) * U₀ * U₀ * U₀ + (s₁ * D₁_B) * U₀ * U₀ * V₀ +
          (s₁ * D₂_B) * U₀ * V₀ * V₀ + (s₁ * D₃_B) * V₀ * V₀ * V₀ := by
      dsimp only [c₃]
      ring
    rw [hc3_exp, map_add, map_add, map_add, map_add, map_add, map_add]
    exact Q₀.asIdeal.add_mem
      (Q₀.asIdeal.add_mem
        (Q₀.asIdeal.add_mem
          (hdUdV_prod3 _ U₀ U₀ U₀ hU₀_mem hU₀_mem hU₀_mem)
          (hdUdV_prod3 _ U₀ U₀ V₀ hU₀_mem hU₀_mem hV₀_mem))
        (hdUdV_prod3 _ U₀ V₀ V₀ hU₀_mem hV₀_mem hV₀_mem))
      (hdUdV_prod3 _ V₀ V₀ V₀ hV₀_mem hV₀_mem hV₀_mem)

  have hPieceD : d_U (d_V (s₁ * r_B * z_X)) ∈ Q₀.asIdeal := by
    have hdV_zX : d_V z_X = 0 := Derivation.map_algebraMap d_V PowerSeries.X
    have hdU_zX : d_U z_X = 0 := Derivation.map_algebraMap d_U PowerSeries.X
    have h1 : d_V ((s₁ * r_B) * z_X) = z_X * d_V (s₁ * r_B) := by
      have hl : d_V ((s₁ * r_B) * z_X) = (s₁ * r_B) * d_V z_X + z_X * d_V (s₁ * r_B) :=
        d_V.leibniz (s₁ * r_B) z_X
      rw [hl, hdV_zX, mul_zero, zero_add]
    have h2 : d_U (z_X * d_V (s₁ * r_B)) = z_X * d_U (d_V (s₁ * r_B)) := by
      have hl : d_U (z_X * d_V (s₁ * r_B)) =
          z_X * d_U (d_V (s₁ * r_B)) + d_V (s₁ * r_B) * d_U z_X :=
        d_U.leibniz z_X (d_V (s₁ * r_B))
      rw [hl, hdU_zX, mul_zero, add_zero]
    change d_U (d_V ((s₁ * r_B) * z_X)) ∈ Q₀.asIdeal
    rw [h1, h2]
    exact Q₀.asIdeal.mul_mem_right _ hz_X_mem

  have hw_sub_β : w_tot - β * d_U (d_V g₀) ∈ Q₀.asIdeal := by
    have hEq_dUdV : d_U (d_V (w_tot * U₀ * V₀)) =
        d_U (d_V (β * g₀)) + d_U (d_V (s₁ * c₃)) + d_U (d_V (s₁ * r_B * z_X)) := by
      rw [hRel_B₀, map_add, map_add, map_add, map_add]
    have hident : w_tot - β * d_U (d_V g₀) =
        (d_U (d_V (β * g₀)) - β * d_U (d_V g₀)) + d_U (d_V (s₁ * c₃)) +
          d_U (d_V (s₁ * r_B * z_X)) - (d_U (d_V (w_tot * U₀ * V₀)) - w_tot) := by
      linear_combination hEq_dUdV
    rw [hident]
    exact Q₀.asIdeal.sub_mem
      (Q₀.asIdeal.add_mem (Q₀.asIdeal.add_mem hPieceB hPieceC) hPieceD)
      hPieceA

  have hβ_notMem : β ∉ Q₀.asIdeal := by
    intro hβ_in
    apply hw_tot_notMem
    have h1 : β * d_U (d_V g₀) ∈ Q₀.asIdeal := Q₀.asIdeal.mul_mem_right _ hβ_in
    have h2 : (w_tot - β * d_U (d_V g₀)) + β * d_U (d_V g₀) ∈ Q₀.asIdeal :=
      Q₀.asIdeal.add_mem hw_sub_β h1
    rwa [sub_add_cancel] at h2

  
  
  
  let s_B : B₀ := w_tot * β * s₁
  have hs_B_notMem : s_B ∉ Q₀.asIdeal :=
    Q₀.isPrime.mul_notMem (Q₀.isPrime.mul_notMem hw_tot_notMem hβ_notMem) hs₁
  let B : Type u := Localization.Away s_B
  let ι_B : B₀ →+* B := algebraMap B₀ B
  let φ_P : P₂ →+* B := ι_B.comp φ₀

  have hEtP : φ_P.Etale :=
    RingHom.Etale.stableUnderComposition φ₀ ι_B hEt₀
      (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway s_B))

  have hQ_range : Q₀ ∈ Set.range (PrimeSpectrum.comap ι_B) := by
    rw [PrimeSpectrum.localization_away_comap_range B s_B]
    exact hs_B_notMem
  obtain ⟨Q, hQ⟩ := hQ_range

  have hQmax : Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = IsLocalRing.maximalIdeal R_ps := by
    rw [← hQ₀_comap_C]
    ext r
    change ι_B (φ₀ (MvPolynomial.C r)) ∈ Q.asIdeal ↔ φ₀ (MvPolynomial.C r) ∈ Q₀.asIdeal
    rw [← hQ]
    rfl

  have hXiP : ∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal := by
    intro i
    fin_cases i
    · change ι_B U₀ ∈ Q.asIdeal
      rw [← hQ] at hU₀_mem
      exact hU₀_mem
    · change ι_B V₀ ∈ Q.asIdeal
      rw [← hQ] at hV₀_mem
      exact hV₀_mem

  
  have hResAway : ∀ {R_loc : Type u} [CommRing R_loc]
      (α : Ω →+* R_loc) (p_loc : PrimeSpectrum R_loc)
      (_hRes_loc : ∀ r : R_loc, ∃ ω : Ω, r - α ω ∈ p_loc.asIdeal)
      (t : R_loc) (ht : t ∉ p_loc.asIdeal)
      (P_loc : PrimeSpectrum (Localization.Away t))
      (hP_loc : PrimeSpectrum.comap (algebraMap R_loc (Localization.Away t)) P_loc = p_loc)
      (z : Localization.Away t),
      ∃ ω : Ω, z - algebraMap R_loc (Localization.Away t) (α ω) ∈ P_loc.asIdeal := by
    intro R_loc _ α p_loc hRes_loc t ht P_loc hP_loc z
    let j_t := algebraMap R_loc (Localization.Away t)
    have hMem_P : ∀ r : R_loc, j_t r ∈ P_loc.asIdeal ↔ r ∈ p_loc.asIdeal := by
      intro r
      rw [← hP_loc]
      rfl
    obtain ⟨⟨r_num, _, k, rfl⟩, hzt⟩ := IsLocalization.surj (Submonoid.powers t) z
    dsimp only at hzt
    obtain ⟨ω_r, hω_r⟩ := hRes_loc r_num
    obtain ⟨ω_t, hω_t⟩ := hRes_loc (t ^ k)
    have htk_not : t ^ k ∉ p_loc.asIdeal :=
      fun h => ht (p_loc.isPrime.mem_of_pow_mem k h)
    have hω_t_ne : ω_t ≠ 0 := by
      intro h0
      rw [h0, map_zero, sub_zero] at hω_t
      exact htk_not hω_t
    let ω : Ω := ω_r / ω_t
    have hω_mul : α ω * α ω_t = α ω_r := by
      rw [← map_mul]
      exact congrArg α (div_mul_cancel₀ ω_r hω_t_ne)
    have hprod_in : (z - j_t (α ω)) * j_t (t ^ k) ∈ P_loc.asIdeal := by
      have heq : (z - j_t (α ω)) * j_t (t ^ k) =
          j_t ((r_num - α ω_r) - α ω * (t ^ k - α ω_t)) := by
        calc (z - j_t (α ω)) * j_t (t ^ k)
            = z * j_t (t ^ k) - j_t (α ω * t ^ k) := by rw [sub_mul, j_t.map_mul]
          _ = j_t r_num - j_t (α ω * t ^ k) := by rw [hzt]
          _ = j_t (r_num - α ω * t ^ k) := by rw [← j_t.map_sub]
          _ = j_t ((r_num - α ω_r) - α ω * (t ^ k - α ω_t)) := by
              congr 1
              linear_combination -hω_mul
      rw [heq, hMem_P]
      exact p_loc.asIdeal.sub_mem hω_r (p_loc.asIdeal.mul_mem_left _ hω_t)
    rcases P_loc.isPrime.mem_or_mem hprod_in with hz_in | htk_in
    · exact ⟨ω, hz_in⟩
    · exact False.elim (htk_not ((hMem_P (t ^ k)).mp htk_in))

  have hRes_A'₀ := hResAway (f₀.comp PowerSeries.C) q₀ hRes s_A hs_A q'₀ hq'₀
  have hRes_B₀ : ∀ b₀ : B₀,
      ∃ ω : Ω, b₀ - φ₀ (MvPolynomial.C (PowerSeries.C ω)) ∈ Q₀.asIdeal := by
    intro b₀
    obtain ⟨ω, hω⟩ := hRes_A'₀ (π₀ b₀)
    refine ⟨ω, ?_⟩
    rw [hMem_Q₀, map_sub]
    have hCω : π₀ (φ₀ (MvPolynomial.C (PowerSeries.C ω))) =
        algebraMap A₀ A'₀ (f₀ (PowerSeries.C ω)) :=
      RingHom.congr_fun hComm₀_C (PowerSeries.C ω)
    rw [hCω]
    exact hω
  have hResB : ∀ b : B, ∃ c : R_ps, b - φ_P (MvPolynomial.C c) ∈ Q.asIdeal := by
    intro b
    obtain ⟨ω, hω⟩ := hResAway
      (φ₀.comp (MvPolynomial.C.comp PowerSeries.C)) Q₀ hRes_B₀ s_B hs_B_notMem Q hQ b
    exact ⟨PowerSeries.C ω, hω⟩

  
  let u_tot : Bˣ := (IsLocalization.Away.algebraMap_isUnit s_B).unit
  have hu_tot_inv : ι_B s_B * (↑u_tot⁻¹ : B) = 1 := u_tot.val_inv
  let w_inv : B := ι_B (β * s₁) * (↑u_tot⁻¹ : B)
  let β_inv : B := ι_B (w_tot * s₁) * (↑u_tot⁻¹ : B)
  let s₁_inv : B := ι_B (w_tot * β) * (↑u_tot⁻¹ : B)
  have hw_inv_spec : ι_B w_tot * w_inv = 1 := by
    calc ι_B w_tot * (ι_B (β * s₁) * (↑u_tot⁻¹ : B))
        = (ι_B w_tot * ι_B (β * s₁)) * (↑u_tot⁻¹ : B) := by ring
      _ = ι_B s_B * (↑u_tot⁻¹ : B) := by
          rw [← map_mul]; congr 1; exact congrArg ι_B (by dsimp only [s_B]; ring)
      _ = 1 := hu_tot_inv
  have hβ_inv_spec : ι_B β * β_inv = 1 := by
    calc ι_B β * (ι_B (w_tot * s₁) * (↑u_tot⁻¹ : B))
        = (ι_B β * ι_B (w_tot * s₁)) * (↑u_tot⁻¹ : B) := by ring
      _ = ι_B s_B * (↑u_tot⁻¹ : B) := by
          rw [← map_mul]; congr 1; exact congrArg ι_B (by dsimp only [s_B]; ring)
      _ = 1 := hu_tot_inv
  have hs₁_inv_spec : ι_B s₁ * s₁_inv = 1 := by
    calc ι_B s₁ * (ι_B (w_tot * β) * (↑u_tot⁻¹ : B))
        = (ι_B s₁ * ι_B (w_tot * β)) * (↑u_tot⁻¹ : B) := by ring
      _ = ι_B s_B * (↑u_tot⁻¹ : B) := by
          rw [← map_mul]; congr 1; exact congrArg ι_B (by dsimp only [s_B]; ring)
      _ = 1 := hu_tot_inv

  let F : B := w_inv * ι_B (β * g₀)
  have hg₀_in_F : ι_B g₀ = (β_inv * ι_B w_tot) * F := by
    calc ι_B g₀
        = (ι_B β * β_inv) * ι_B g₀ := by rw [hβ_inv_spec, one_mul]
      _ = β_inv * ι_B (β * g₀) := by rw [map_mul]; ring
      _ = β_inv * ((ι_B w_tot * w_inv) * ι_B (β * g₀)) := by rw [hw_inv_spec, one_mul]
      _ = (β_inv * ι_B w_tot) * F := by dsimp only [F]; ring

  have hFcong : F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
      Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal R_ps) ⊔
        Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3 := by
    have hRel_B : ι_B (β * g₀) - ι_B w_tot * φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) =
        -ι_B (s₁ * r_B) * (φ_P.comp MvPolynomial.C) PowerSeries.X - ι_B s₁ * ι_B c₃ := by
      have hmap := congrArg ι_B hRel_B₀
      rw [ι_B.map_mul, ι_B.map_mul, ι_B.map_add, ι_B.map_add,
        ι_B.map_mul s₁ c₃, ι_B.map_mul (s₁ * r_B) z_X] at hmap
      have hφ_mul : φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) = ι_B U₀ * ι_B V₀ := by
        change ι_B (φ₀ (MvPolynomial.X 0 * MvPolynomial.X 1)) = ι_B U₀ * ι_B V₀
        rw [φ₀.map_mul, ι_B.map_mul]
      have hφ_X : (φ_P.comp MvPolynomial.C) PowerSeries.X = ι_B z_X := rfl
      rw [hφ_mul, hφ_X]
      linear_combination -hmap
    have hF_sub : F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) =
        (-w_inv * ι_B (s₁ * r_B)) * (φ_P.comp MvPolynomial.C) PowerSeries.X +
          (-w_inv * ι_B s₁) * ι_B c₃ := by
      calc F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1)
          = w_inv * ι_B (β * g₀) - (w_inv * ι_B w_tot) * φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) := by
              rw [mul_comm w_inv (ι_B w_tot), hw_inv_spec, one_mul]
        _ = w_inv * (ι_B (β * g₀) - ι_B w_tot * φ_P (MvPolynomial.X 0 * MvPolynomial.X 1)) := by ring
        _ = w_inv * (-ι_B (s₁ * r_B) * (φ_P.comp MvPolynomial.C) PowerSeries.X - ι_B s₁ * ι_B c₃) := by
              rw [hRel_B]
        _ = (-w_inv * ι_B (s₁ * r_B)) * (φ_P.comp MvPolynomial.C) PowerSeries.X +
              (-w_inv * ι_B s₁) * ι_B c₃ := by ring
    rw [hF_sub]
    have hTerm1 : (-w_inv * ι_B (s₁ * r_B)) * (φ_P.comp MvPolynomial.C) PowerSeries.X ∈
        Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal R_ps) := by
      apply Ideal.mul_mem_left
      apply Ideal.mem_map_of_mem
      rw [PowerSeries.maximalIdeal_eq_span_X]
      exact Ideal.subset_span rfl
    let U_P := φ_P (MvPolynomial.X 0)
    let V_P := φ_P (MvPolynomial.X 1)
    let I_UV : Ideal B := Ideal.span {U_P, V_P}
    have hU_in : U_P ∈ I_UV := Ideal.subset_span (Set.mem_insert U_P {V_P})
    have hV_in : V_P ∈ I_UV :=
      Ideal.subset_span (Set.mem_insert_of_mem U_P (Set.mem_singleton V_P))
    have hCube_mem : ∀ (d_coeff x y z : B), x ∈ I_UV → y ∈ I_UV → z ∈ I_UV →
        d_coeff * (x * y * z) ∈ I_UV ^ 3 := by
      intro d_coeff x y z hx hy hz
      apply Ideal.mul_mem_left
      rw [pow_three]
      have hxy : x * y ∈ I_UV * I_UV := Ideal.mul_mem_mul hx hy
      have hxyz : (x * y) * z ∈ (I_UV * I_UV) * I_UV := Ideal.mul_mem_mul hxy hz
      simpa [mul_assoc] using hxyz
    have hc3_mem : ι_B c₃ ∈ I_UV ^ 3 := by
      have hc3_B : ι_B c₃ =
          ι_B D₀_B * (U_P * U_P * U_P) + ι_B D₁_B * (U_P * U_P * V_P) +
            ι_B D₂_B * (U_P * V_P * V_P) + ι_B D₃_B * (V_P * V_P * V_P) := by
        dsimp only [c₃, U_P, V_P]
        change ι_B (D₀_B * U₀ ^ 3 + D₁_B * U₀ ^ 2 * V₀ + D₂_B * U₀ * V₀ ^ 2 + D₃_B * V₀ ^ 3) =
          ι_B D₀_B * (ι_B U₀ * ι_B U₀ * ι_B U₀) +
            ι_B D₁_B * (ι_B U₀ * ι_B U₀ * ι_B V₀) +
            ι_B D₂_B * (ι_B U₀ * ι_B V₀ * ι_B V₀) +
            ι_B D₃_B * (ι_B V₀ * ι_B V₀ * ι_B V₀)
        simp only [map_add, map_mul, map_pow]
        ring
      rw [hc3_B]
      exact (I_UV ^ 3).add_mem
        ((I_UV ^ 3).add_mem
          ((I_UV ^ 3).add_mem
            (hCube_mem _ U_P U_P U_P hU_in hU_in hU_in)
            (hCube_mem _ U_P U_P V_P hU_in hU_in hV_in))
          (hCube_mem _ U_P V_P V_P hU_in hV_in hV_in))
        (hCube_mem _ V_P V_P V_P hV_in hV_in hV_in)
    have hTerm2 : (-w_inv * ι_B s₁) * ι_B c₃ ∈ I_UV ^ 3 :=
      Ideal.mul_mem_left _ _ hc3_mem
    exact Ideal.add_mem _ (Submodule.mem_sup_left hTerm1) (Submodule.mem_sup_right hTerm2)

  
  let t_A : A'₀ := π₀ s_B
  have ht_A_notMem : t_A ∉ q'₀.asIdeal := fun h => hs_B_notMem ((hMem_Q₀ s_B).mpr h)
  let A''₀ : Type u := Localization.Away t_A
  let mk_F : B →+* (B ⧸ Ideal.span {F}) := Ideal.Quotient.mk (Ideal.span {F})

  let ν : B₀ →+* A''₀ := (algebraMap A'₀ A''₀).comp π₀
  have hν_unit : IsUnit (ν s_B) := IsLocalization.Away.algebraMap_isUnit t_A
  let π_B : B →+* A''₀ := IsLocalization.Away.lift s_B hν_unit
  have hπB_eq : ∀ b₀ : B₀, π_B (ι_B b₀) = algebraMap A'₀ A''₀ (π₀ b₀) :=
    IsLocalization.Away.lift_eq s_B hν_unit
  have hπB_F_ker : Ideal.span {F} ≤ RingHom.ker π_B := by
    rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    dsimp only [F]
    rw [π_B.map_mul, hπB_eq, π₀.map_mul, RingHom.mem_ker.mp hg₀, mul_zero, map_zero, mul_zero]
  let Φ_fwd : (B ⧸ Ideal.span {F}) →+* A''₀ := Ideal.Quotient.lift (Ideal.span {F}) π_B hπB_F_ker

  let μ : B₀ →+* (B ⧸ Ideal.span {F}) := mk_F.comp ι_B
  have hker_π₀_le_μ : RingHom.ker π₀ ≤ RingHom.ker μ := by
    intro j hj
    rw [RingHom.mem_ker]
    obtain ⟨b, hs₁j⟩ := hPrin j hj
    change mk_F (ι_B j) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
    refine ⟨s₁_inv * ι_B b * (β_inv * ι_B w_tot), ?_⟩
    calc ι_B j
        = (ι_B s₁ * s₁_inv) * ι_B j := by rw [hs₁_inv_spec, one_mul]
      _ = s₁_inv * ι_B (s₁ * j) := by rw [map_mul]; ring
      _ = s₁_inv * ι_B (b * g₀) := by rw [hs₁j]
      _ = s₁_inv * ι_B b * ι_B g₀ := by rw [map_mul]; ring
      _ = F * (s₁_inv * ι_B b * (β_inv * ι_B w_tot)) := by rw [hg₀_in_F]; ring
  let μ_bar₀ : A'₀ →+* (B ⧸ Ideal.span {F}) :=
    (Ideal.Quotient.lift (RingHom.ker π₀) μ hker_π₀_le_μ).comp
      (RingHom.quotientKerEquivOfSurjective hSurj₀).symm.toRingHom
  have hμ_bar₀_eq : ∀ b₀ : B₀, μ_bar₀ (π₀ b₀) = mk_F (ι_B b₀) := by
    intro b₀
    have heq_symm : (RingHom.quotientKerEquivOfSurjective hSurj₀).symm (π₀ b₀) =
        Ideal.Quotient.mk (RingHom.ker π₀) b₀ :=
      (RingHom.quotientKerEquivOfSurjective hSurj₀).symm_apply_apply
        (Ideal.Quotient.mk (RingHom.ker π₀) b₀)
    change (Ideal.Quotient.lift (RingHom.ker π₀) μ hker_π₀_le_μ)
      ((RingHom.quotientKerEquivOfSurjective hSurj₀).symm (π₀ b₀)) = mk_F (ι_B b₀)
    rw [heq_symm]
    rfl
  have hμ_bar₀_unit : IsUnit (μ_bar₀ t_A) := by
    change IsUnit (μ_bar₀ (π₀ s_B))
    rw [hμ_bar₀_eq]
    exact (IsLocalization.Away.algebraMap_isUnit s_B).map mk_F
  let Φ_bwd : A''₀ →+* (B ⧸ Ideal.span {F}) :=
    IsLocalization.Away.lift t_A hμ_bar₀_unit
  have hΦ_bwd_eq : ∀ y : A'₀, Φ_bwd (algebraMap A'₀ A''₀ y) = μ_bar₀ y :=
    IsLocalization.Away.lift_eq t_A hμ_bar₀_unit

  have hbwd_fwd : Φ_bwd.comp Φ_fwd = RingHom.id (B ⧸ Ideal.span {F}) := by
    apply Ideal.Quotient.ringHom_ext
    apply IsLocalization.ringHom_ext (Submonoid.powers s_B)
    ext b₀
    change Φ_bwd (Φ_fwd (mk_F (ι_B b₀))) = mk_F (ι_B b₀)
    change Φ_bwd (π_B (ι_B b₀)) = mk_F (ι_B b₀)
    rw [hπB_eq, hΦ_bwd_eq, hμ_bar₀_eq]
  have hfwd_bwd : Φ_fwd.comp Φ_bwd = RingHom.id A''₀ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers t_A)
    ext y
    obtain ⟨b₀, rfl⟩ := hSurj₀ y
    change Φ_fwd (Φ_bwd (algebraMap A'₀ A''₀ (π₀ b₀))) = algebraMap A'₀ A''₀ (π₀ b₀)
    rw [hΦ_bwd_eq, hμ_bar₀_eq]
    change π_B (ι_B b₀) = algebraMap A'₀ A''₀ (π₀ b₀)
    exact hπB_eq b₀
  have hBij_bwd : Function.Bijective Φ_bwd :=
    ⟨Function.LeftInverse.injective (fun y => RingHom.congr_fun hfwd_bwd y),
     Function.RightInverse.surjective (fun x => RingHom.congr_fun hbwd_fwd x)⟩

  let e_hyp : A₀ →+* (B ⧸ Ideal.span {F}) :=
    Φ_bwd.comp ((algebraMap A'₀ A''₀).comp (algebraMap A₀ A'₀))
  have hEt_bwd : Φ_bwd.Etale := RingHom.Etale.of_bijective hBij_bwd
  have hEt_A₁ : (algebraMap A₀ A'₀).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway s_A)
  have hEt_A₂ : (algebraMap A'₀ A''₀).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway t_A)
  have hEtHyp : e_hyp.Etale :=
    RingHom.Etale.stableUnderComposition
      ((algebraMap A'₀ A''₀).comp (algebraMap A₀ A'₀)) Φ_bwd
      (RingHom.Etale.stableUnderComposition
        (algebraMap A₀ A'₀) (algebraMap A'₀ A''₀) hEt_A₁ hEt_A₂)
      hEt_bwd

  have hCommP : e_hyp.comp f₀ = mk_F.comp (φ_P.comp MvPolynomial.C) := by
    ext r
    have hCr : algebraMap A₀ A'₀ (f₀ r) = π₀ (φ₀ (MvPolynomial.C r)) :=
      (RingHom.congr_fun hComm₀_C r).symm
    change Φ_bwd (algebraMap A'₀ A''₀ (algebraMap A₀ A'₀ (f₀ r))) =
      mk_F (ι_B (φ₀ (MvPolynomial.C r)))
    rw [hCr, hΦ_bwd_eq, hμ_bar₀_eq]

  have hq''₀_range : q'₀ ∈ Set.range (PrimeSpectrum.comap (algebraMap A'₀ A''₀)) := by
    rw [PrimeSpectrum.localization_away_comap_range A''₀ t_A]
    exact ht_A_notMem
  obtain ⟨q''₀, hq''₀⟩ := hq''₀_range
  let q_bar : PrimeSpectrum (B ⧸ Ideal.span {F}) := PrimeSpectrum.comap Φ_fwd q''₀

  have hqbar_Q : PrimeSpectrum.comap mk_F q_bar = Q := by
    apply PrimeSpectrum.localization_comap_injective B (Submonoid.powers s_B)
    rw [hQ]
    ext b₀
    change Φ_fwd (mk_F (ι_B b₀)) ∈ q''₀.asIdeal ↔ b₀ ∈ Q₀.asIdeal
    change π_B (ι_B b₀) ∈ q''₀.asIdeal ↔ b₀ ∈ Q₀.asIdeal
    rw [hπB_eq]
    have hmem'' : algebraMap A'₀ A''₀ (π₀ b₀) ∈ q''₀.asIdeal ↔ π₀ b₀ ∈ q'₀.asIdeal := by
      rw [← hq''₀]
      rfl
    exact hmem''.trans (hMem_Q₀ b₀).symm

  have hqbar_q₀ : PrimeSpectrum.comap e_hyp q_bar = q₀ := by
    ext a
    change Φ_fwd (Φ_bwd (algebraMap A'₀ A''₀ (algebraMap A₀ A'₀ a))) ∈ q''₀.asIdeal ↔
      a ∈ q₀.asIdeal
    have hid : Φ_fwd (Φ_bwd (algebraMap A'₀ A''₀ (algebraMap A₀ A'₀ a))) =
        algebraMap A'₀ A''₀ (algebraMap A₀ A'₀ a) :=
      RingHom.congr_fun hfwd_bwd _
    rw [hid]
    have hmem'' : algebraMap A'₀ A''₀ (algebraMap A₀ A'₀ a) ∈ q''₀.asIdeal ↔
        algebraMap A₀ A'₀ a ∈ q'₀.asIdeal := by
      rw [← hq''₀]
      rfl
    exact hmem''.trans (hMem_q'₀ a)

  exact ⟨B, inferInstance, φ_P, Q, F, e_hyp, hEtP, hEtHyp, hQmax, hResB, hXiP,
    hFcong, hCommP, ⟨q_bar, hqbar_Q, hqbar_q₀⟩⟩

theorem weil_powerSeries_curve_smooth_or_etale_plane_hypersurface (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (hSmK : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.snd g
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))))
    (x : C) :
    (∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∨
    (∃ (U_C : C.Opens) (hAffC : AlgebraicGeometry.IsAffineOpen U_C)
        (q₀ : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op U_C)))
        (B : Type u) (_ : CommRing B)
        (φ_P : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B)
        (Q : PrimeSpectrum B)
        (F : B)
        (e_hyp : ↑(C.presheaf.obj (Opposite.op U_C)) →+* (B ⧸ Ideal.span {F})),
      hAffC.fromSpec.base q₀ = x ∧
      φ_P.Etale ∧
      e_hyp.Etale ∧
      Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = IsLocalRing.maximalIdeal (PowerSeries Ω) ∧
      (∀ b : B, ∃ c : PowerSeries Ω, b - φ_P (MvPolynomial.C c) ∈ Q.asIdeal) ∧
      (∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal) ∧
      F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
        Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal (PowerSeries Ω)) ⊔
          Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3 ∧
      e_hyp.comp (AlgebraicGeometry.Spec.preimage (hAffC.fromSpec ≫ g)).hom =
        (Ideal.Quotient.mk (Ideal.span {F})).comp (φ_P.comp MvPolynomial.C) ∧
      ∃ q_bar : PrimeSpectrum (B ⧸ Ideal.span {F}),
        PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {F})) q_bar = Q ∧
        PrimeSpectrum.comap e_hyp q_bar = q₀) :=
by
  by_cases hxX : (PowerSeries.X : PowerSeries Ω) ∈ (g.base x).asIdeal
  · 
    have hgx_max : (g.base x).asIdeal = IsLocalRing.maximalIdeal (PowerSeries Ω) := by
      have hle : IsLocalRing.maximalIdeal (PowerSeries Ω) ≤ (g.base x).asIdeal := by
        rw [PowerSeries.maximalIdeal_eq_span_X, Ideal.span_singleton_le_iff_mem]
        exact hxX
      exact ((IsLocalRing.maximalIdeal.isMaximal (PowerSeries Ω)).eq_of_le
        (g.base x).isPrime.ne_top hle).symm
    obtain ⟨U_C, hAffC, hxU, _⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
    let A₀ : Type u := ↑(C.presheaf.obj (Opposite.op U_C))
    let q₀ : PrimeSpectrum A₀ := hAffC.isoSpec.hom.base ⟨x, hxU⟩
    have hq₀_x : hAffC.fromSpec.base q₀ = x := by
      change (hAffC.isoSpec.hom ≫ hAffC.fromSpec).base ⟨x, hxU⟩ = x
      rw [hAffC.isoSpec_hom_fromSpec]
      rfl
    let f₀ : PowerSeries Ω →+* A₀ := (Spec.preimage (hAffC.fromSpec ≫ g)).hom
    have hf₀_map : Spec.map (CommRingCat.ofHom f₀) = hAffC.fromSpec ≫ g :=
      Spec.map_preimage (hAffC.fromSpec ≫ g)
    obtain ⟨_, hFlat_g, _, hLFP_g, _, _, _, _, hGeom_all⟩ := hStab
    have hFlat : f₀.Flat := by
      have hSpecFlat : Flat (Spec.map (CommRingCat.ofHom f₀)) := by
        rw [hf₀_map]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Flat)).mp hSpecFlat
    have hFP : f₀.FinitePresentation := by
      have hSpecFP : LocallyOfFinitePresentation (Spec.map (CommRingCat.ofHom f₀)) := by
        rw [hf₀_map]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mp hSpecFP
    have hq₀_max : (PrimeSpectrum.comap f₀ q₀).asIdeal =
        IsLocalRing.maximalIdeal (PowerSeries Ω) := by
      have hbase : PrimeSpectrum.comap f₀ q₀ = g.base x := by
        change (Spec.map (CommRingCat.ofHom f₀)).base q₀ = g.base x
        rw [hf₀_map]
        exact congrArg g.base hq₀_x
      rw [hbase, hgx_max]
    letI : Algebra (PowerSeries Ω) Ω :=
      (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
    letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
    let F_Ω := TensorProduct (PowerSeries Ω) Ω A₀
    have hf₀X_mem : f₀ PowerSeries.X ∈ q₀.asIdeal := by
      change PowerSeries.X ∈ (PrimeSpectrum.comap f₀ q₀).asIdeal
      rw [hq₀_max, PowerSeries.maximalIdeal_eq_span_X]
      exact Ideal.subset_span rfl
    let φ_Ω_quot : Ω →ₐ[PowerSeries Ω] (A₀ ⧸ q₀.asIdeal) :=
      { (((Ideal.Quotient.mk q₀.asIdeal).comp f₀).comp
          (PowerSeries.C : Ω →+* PowerSeries Ω)) with
        commutes' := fun r => by
          change Ideal.Quotient.mk q₀.asIdeal (f₀ (PowerSeries.C (PowerSeries.constantCoeff r))) =
            Ideal.Quotient.mk q₀.asIdeal (f₀ r)
          rw [Ideal.Quotient.eq]
          have hdvd : PowerSeries.X ∣ PowerSeries.C (PowerSeries.constantCoeff r) - r := by
            rw [PowerSeries.X_dvd_iff, map_sub, PowerSeries.constantCoeff_C, sub_self]
          rcases hdvd with ⟨h, hh⟩
          have hmap := congrArg f₀ hh
          rw [map_sub, map_mul] at hmap
          rw [hmap]
          exact Ideal.mul_mem_right _ _ hf₀X_mem }
    let Φ_q : F_Ω →+* (A₀ ⧸ q₀.asIdeal) :=
      (Algebra.TensorProduct.lift φ_Ω_quot (Ideal.Quotient.mkₐ (PowerSeries Ω) q₀.asIdeal)
        (fun _ _ => Commute.all _ _)).toRingHom
    have hDomQuot : IsDomain (A₀ ⧸ q₀.asIdeal) := Ideal.Quotient.isDomain q₀.asIdeal
    have hBotPrime : (⊥ : Ideal (A₀ ⧸ q₀.asIdeal)).IsPrime :=
      ⟨bot_ne_top, fun {_ _} hab => mul_eq_zero.mp hab⟩
    let q_Ω : PrimeSpectrum F_Ω := PrimeSpectrum.comap Φ_q ⟨⊥, hBotPrime⟩
    have hq_Ω : PrimeSpectrum.comap Algebra.TensorProduct.includeRight.toRingHom q_Ω = q₀ := by
      ext a
      change Φ_q (Algebra.TensorProduct.includeRight a) ∈ (⊥ : Ideal (A₀ ⧸ q₀.asIdeal)) ↔
        a ∈ q₀.asIdeal
      have hΦa : Φ_q (Algebra.TensorProduct.includeRight a) =
          Ideal.Quotient.mk q₀.asIdeal a := by
        change (Algebra.TensorProduct.lift φ_Ω_quot
          (Ideal.Quotient.mkₐ (PowerSeries Ω) q₀.asIdeal) _) (1 ⊗ₜ[PowerSeries Ω] a) = _
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rw [hΦa, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
    let s_Ω : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of (PowerSeries Ω)) :=
      Spec.map (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    let u_Ω : Spec (CommRingCat.of F_Ω) ⟶ Spec (CommRingCat.of A₀) :=
      Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
    let v_Ω : Spec (CommRingCat.of F_Ω) ⟶ Spec (CommRingCat.of Ω) :=
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : Ω →+* F_Ω))
    have huv_pb : IsPullback v_Ω u_Ω s_Ω (Spec.map (CommRingCat.ofHom f₀)) := by
      exact (IsPullback.of_hasPullback s_Ω (Spec.map (CommRingCat.ofHom f₀))).of_iso
        (pullbackSpecIso (PowerSeries Ω) Ω A₀) (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by simp only [Iso.refl_hom, Category.comp_id];
            exact (pullbackSpecIso_hom_fst (PowerSeries Ω) Ω A₀).symm)
        (by simp only [Iso.refl_hom, Category.comp_id];
            exact (pullbackSpecIso_hom_snd (PowerSeries Ω) Ω A₀).symm)
        (by simp) (by simp)
    have huv_comm : (u_Ω ≫ hAffC.fromSpec) ≫ g = v_Ω ≫ s_Ω := by
      rw [Category.assoc, ← hf₀_map]
      exact huv_pb.flip.w
    let ι_Ω : Spec (CommRingCat.of F_Ω) ⟶ Limits.pullback g s_Ω :=
      Limits.pullback.lift (u_Ω ≫ hAffC.fromSpec) v_Ω huv_comm
    have hι_pb : IsPullback u_Ω ι_Ω hAffC.fromSpec (Limits.pullback.fst g s_Ω) := by
      apply IsPullback.of_bot (v₂₁ := Limits.pullback.snd g s_Ω) (v₂₂ := g) (h₃₁ := s_Ω)
      · rw [Limits.pullback.lift_snd, ← hf₀_map]
        exact huv_pb.flip
      · exact (Limits.pullback.lift_fst _ _ _).symm
      · exact IsPullback.of_hasPullback g s_Ω
    have hOpen_ι : IsOpenImmersion ι_Ω :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hι_pb inferInstance
    rcases (hGeom_all Ω s_Ω).2.1 (ι_Ω.base q_Ω) with
      ⟨V₀, hyV₀, hSmV₀⟩ | ⟨U', u₀, e₁, e₂, he₁, he₂, hu₀_y, hXi, he_comm⟩
    · 
      left
      let W₀ : (Spec (CommRingCat.of F_Ω)).Opens := (TopologicalSpace.Opens.map ι_Ω.base).obj V₀
      have hqW₀ : q_Ω ∈ W₀ := hyV₀
      have hnhds := W₀.isOpen.mem_nhds hqW₀
      obtain ⟨_, ⟨b₀, rfl⟩, hqb₀, hb₀_sub⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.mem_nhds_iff.mp hnhds
      let j_b₀ : Spec (CommRingCat.of (Localization.Away b₀)) ⟶ Spec (CommRingCat.of F_Ω) :=
        Spec.map (CommRingCat.ofHom (algebraMap F_Ω (Localization.Away b₀)))
      have hOpen_jb₀ : IsOpenImmersion j_b₀ := IsOpenImmersion.of_isLocalization b₀
      have hj_range : Set.range (j_b₀ ≫ ι_Ω).base ⊆ Set.range V₀.ι.base := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨z, rfl⟩
        have hz_range : PrimeSpectrum.comap (algebraMap F_Ω (Localization.Away b₀)) z ∈
            Set.range (PrimeSpectrum.comap (algebraMap F_Ω (Localization.Away b₀))) := ⟨z, rfl⟩
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away b₀) b₀] at hz_range
        exact hb₀_sub hz_range
      let k_b₀ : Spec (CommRingCat.of (Localization.Away b₀)) ⟶ V₀.toScheme :=
        IsOpenImmersion.lift V₀.ι (j_b₀ ≫ ι_Ω) hj_range
      have hk_fac : k_b₀ ≫ V₀.ι = j_b₀ ≫ ι_Ω :=
        IsOpenImmersion.lift_fac V₀.ι (j_b₀ ≫ ι_Ω) hj_range
      have hOpen_kb₀ : IsOpenImmersion k_b₀ := by
        have : IsOpenImmersion (k_b₀ ≫ V₀.ι) := by rw [hk_fac]; infer_instance
        exact IsOpenImmersion.of_comp k_b₀ V₀.ι
      have hSm_kb₀ : SmoothOfRelativeDimension 1
          (Spec.map (CommRingCat.ofHom
            ((algebraMap F_Ω (Localization.Away b₀)).comp
              Algebra.TensorProduct.includeLeftRingHom))) := by
        have heq_map : Spec.map (CommRingCat.ofHom
            ((algebraMap F_Ω (Localization.Away b₀)).comp
              Algebra.TensorProduct.includeLeftRingHom)) =
            k_b₀ ≫ (V₀.ι ≫ Limits.pullback.snd g s_Ω) := by
          rw [← Category.assoc, hk_fac, Category.assoc, Limits.pullback.lift_snd,
            CommRingCat.ofHom_comp, Spec.map_comp]
        rw [heq_map]
        simpa using smoothOfRelativeDimension_comp 0 1 k_b₀ (V₀.ι ≫ Limits.pullback.snd g s_Ω)
      have hLocSm : RingHom.Locally (@RingHom.IsStandardSmoothOfRelativeDimension 1)
          ((algebraMap F_Ω (Localization.Away b₀)).comp
            Algebra.TensorProduct.includeLeftRingHom) :=
        (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1)).mp hSm_kb₀
      obtain ⟨S_fin, hSpanTop, hSmEach⟩ := hLocSm
      have hq_range_b₀ :
          q_Ω ∈ Set.range (PrimeSpectrum.comap (algebraMap F_Ω (Localization.Away b₀))) := by
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away b₀) b₀]
        exact hqb₀
      obtain ⟨q'_Ω, hq'_Ω⟩ := hq_range_b₀
      have hExNotMem : ∃ t ∈ S_fin, t ∉ q'_Ω.asIdeal := by
        by_contra! hAllMem
        have hTopLe : (⊤ : Ideal (Localization.Away b₀)) ≤ q'_Ω.asIdeal := by
          rw [← hSpanTop, Ideal.span_le]
          intro t ht
          exact hAllMem t ht
        exact q'_Ω.isPrime.ne_top (top_unique hTopLe)
      obtain ⟨t, htS, ht_notMem⟩ := hExNotMem
      obtain ⟨⟨a₀, _, m_exp, rfl⟩, ht_sec⟩ := IsLocalization.surj (Submonoid.powers b₀) t
      dsimp only at ht_sec
      have ha₀_notMem : a₀ ∉ q_Ω.asIdeal := by
        intro ha₀_in
        have h1 : algebraMap F_Ω (Localization.Away b₀) a₀ ∈ q'_Ω.asIdeal := by
          change a₀ ∈ (PrimeSpectrum.comap (algebraMap F_Ω (Localization.Away b₀)) q'_Ω).asIdeal
          rwa [hq'_Ω]
        rw [← ht_sec] at h1
        rcases q'_Ω.isPrime.mem_or_mem h1 with ht_in | hb_in
        · exact ht_notMem ht_in
        · have hb_pow : b₀ ^ m_exp ∈ q_Ω.asIdeal := by
            rw [← hq'_Ω]
            exact hb_in
          exact hqb₀ (q_Ω.isPrime.mem_of_pow_mem m_exp hb_pow)
      let s_pow : Submonoid.powers b₀ := ⟨b₀ ^ m_exp, m_exp, rfl⟩
      have hb₀_unit : IsUnit (algebraMap F_Ω (Localization.Away b₀) (b₀ ^ m_exp)) :=
        IsLocalization.map_units (Localization.Away b₀) s_pow
      let u_pow : (Localization.Away b₀)ˣ := hb₀_unit.unit
      have ht_unit_eq : t * ↑u_pow = algebraMap F_Ω (Localization.Away b₀) a₀ := ht_sec
      have hLoc_a₀ : IsLocalization.Away (algebraMap F_Ω (Localization.Away b₀) a₀)
          (Localization.Away t) := by
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · rintro ⟨_, r, rfl⟩
          dsimp only
          rw [← ht_unit_eq, mul_pow, map_mul]
