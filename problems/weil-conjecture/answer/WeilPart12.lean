    have hExists_z₁ : ∃ z₁ : ↥Y', z₁ ≠ z₀ ∧ z₀ ∈ closure ({z₁} : Set ↥Y') := by
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      let R_Pm : CommRingCat.{u} :=
        CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m)
      let I_nod : Ideal ↑R_Pm := Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
      have hMax_Inod' : I_nod.IsMaximal := hMax_Inod
      let ψ_raw : MvPolynomial (Fin 2) (PowerSeries Ω) →+* Polynomial Ω :=
        MvPolynomial.eval₂Hom (Polynomial.C.comp PowerSeries.constantCoeff) ![Polynomial.X, 0]
      have hm_ne : m ≠ 0 := by omega
      have hJm_ker : J_m ≤ RingHom.ker ψ_raw := by
        rw [Ideal.span_le]
        rintro _ rfl
        rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul]
        simp only [ψ_raw, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
