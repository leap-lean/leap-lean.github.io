          ψ₁_loc (loc (Algebra.TensorProduct.includeLeftRingHom c₀) * u_bar +
            loc (Algebra.TensorProduct.includeLeftRingHom c₁) * v_bar) -
            algebraMap Ω L_D c₀ * δ₀ - algebraMap Ω L_D c₁ * δ₁ := by
        dsimp only [w_N, δ₀, δ₁]
        rw [map_add, map_mul, map_mul, map_add, map_mul, map_mul,
          hψ₁_c, hψ₁_c, hψ₂_c, hψ₂_c]
        ring
      rw [hcalc]
      exact Ideal.sub_mem _
        (Ideal.sub_mem _ hL_mD2 (Ideal.mul_mem_left _ _ hδ₀_m2))
        (Ideal.mul_mem_left _ _ hδ₁_m2)
    exact hLinIndepN c₀ c₁ ((hPowN 2 w_N).mp hwN_mD2)
  
  have hProdF : u_bar * v_bar ∈ 𝔪_F ^ 3 := by
    have ht01 : t₀ * t₁ = 0 := by
      have h0_N : Ideal.Quotient.mk J_N (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      dsimp only [t₀, t₁]
      rw [← map_mul, ← map_mul, h0_N, map_zero]
    have hprod_mD3 : ψ₁_loc (u_bar * v_bar) ∈ 𝔪_D ^ 3 := by
      have h0 : ψ₂_loc t₀ * ψ₂_loc t₁ = 0 := by
        rw [← map_mul, ht01, map_zero]
      have hcalc : ψ₁_loc (u_bar * v_bar) =
          ψ₂_loc t₀ * δ₁ + δ₀ * ψ₂_loc t₁ + δ₀ * δ₁ := by
        calc ψ₁_loc (u_bar * v_bar)
            = (ψ₂_loc t₀ + δ₀) * (ψ₂_loc t₁ + δ₁) := by
                rw [map_mul]; dsimp only [δ₀, δ₁]; ring
          _ = ψ₂_loc t₀ * ψ₂_loc t₁ + ψ₂_loc t₀ * δ₁ + δ₀ * ψ₂_loc t₁ + δ₀ * δ₁ := by ring
          _ = ψ₂_loc t₀ * δ₁ + δ₀ * ψ₂_loc t₁ + δ₀ * δ₁ := by rw [h0, zero_add]
      rw [hcalc]
      exact Ideal.add_mem _
        (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hδ₁_m3) (Ideal.mul_mem_right _ _ hδ₀_m3))
        (Ideal.mul_mem_left _ _ hδ₁_m3)
    exact (hPowF 3 (u_bar * v_bar)).mp hprod_mD3
  exact ⟨hResA₀, ⟨u₁, v₁, hu₁_q₀, hv₁_q₀, hSpan, hLinIndepF, hProdF⟩, hH1_D, hSeq_D⟩

theorem weil_powerSeries_split_tangent_to_etale_plane_surjection (Ω A₀ : Type u) [Field Ω] [CommRing A₀]
    (f₀ : PowerSeries Ω →+* A₀)
    (hFP : f₀.FinitePresentation)
    (q₀ : PrimeSpectrum A₀)
    (hq₀_max : (PrimeSpectrum.comap f₀ q₀).asIdeal = IsLocalRing.maximalIdeal (PowerSeries Ω))
    (hRes : ∀ a : A₀, ∃ c : Ω, a - f₀ (PowerSeries.C c) ∈ q₀.asIdeal)
    (u₁ v₁ : A₀)
    (hu₁ : u₁ ∈ q₀.asIdeal)
    (hv₁ : v₁ ∈ q₀.asIdeal) :
    letI : Algebra (PowerSeries Ω) Ω :=
      (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
    letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
    ∀ (q_Ω : PrimeSpectrum (TensorProduct (PowerSeries Ω) Ω A₀))
      (_hq_Ω : PrimeSpectrum.comap Algebra.TensorProduct.includeRight.toRingHom q_Ω = q₀)
      (_hSpan :
        let L_F := Localization.AtPrime q_Ω.asIdeal
        let loc : TensorProduct (PowerSeries Ω) Ω A₀ →+* L_F :=
          algebraMap (TensorProduct (PowerSeries Ω) Ω A₀) L_F
        Ideal.span
          {loc (Algebra.TensorProduct.includeRight u₁),
           loc (Algebra.TensorProduct.includeRight v₁)} =
        IsLocalRing.maximalIdeal L_F),
      ∃ (B₀ : Type u) (_ : CommRing B₀)
        (φ₀ : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B₀)
        (Q₀ : PrimeSpectrum B₀)
        (s_A : A₀)
        (q'₀ : PrimeSpectrum (Localization.Away s_A))
        (π₀ : B₀ →+* Localization.Away s_A),
        φ₀.Etale ∧
        s_A ∉ q₀.asIdeal ∧
        PrimeSpectrum.comap (algebraMap A₀ (Localization.Away s_A)) q'₀ = q₀ ∧
        PrimeSpectrum.comap π₀ q'₀ = Q₀ ∧
        Function.Surjective π₀ ∧
        (RingHom.ker π₀).FG ∧
        π₀.comp φ₀ =
          (algebraMap A₀ (Localization.Away s_A)).comp
            (MvPolynomial.aeval (R := PowerSeries Ω) ![u₁, v₁]).toRingHom :=
by
  have hStep3 : ∀ (P₂ : Type u) [CommRing P₂] [IsNoetherianRing P₂]
      (α_hom : P₂ →+* A₀)
      (r : ℕ),
      letI : Algebra P₂ A₀ := α_hom.toAlgebra
      ∀ (Φ : MvPolynomial (Fin r) P₂ →ₐ[P₂] A₀)
        (G : Fin r → MvPolynomial (Fin r) P₂),
        Function.Surjective Φ →
        (∀ j : Fin r, Φ (G j) = 0) →
        Φ (Matrix.of (fun i j : Fin r => MvPolynomial.pderiv i (G j))).det ∉ q₀.asIdeal →
        ∃ (B₀ : Type u) (_ : CommRing B₀)
          (φ₀ : P₂ →+* B₀)
          (Q₀ : PrimeSpectrum B₀)
          (s_A : A₀)
          (q'₀ : PrimeSpectrum (Localization.Away s_A))
          (π₀ : B₀ →+* Localization.Away s_A),
          φ₀.Etale ∧
          s_A ∉ q₀.asIdeal ∧
          PrimeSpectrum.comap (algebraMap A₀ (Localization.Away s_A)) q'₀ = q₀ ∧
          PrimeSpectrum.comap π₀ q'₀ = Q₀ ∧
          Function.Surjective π₀ ∧
          (RingHom.ker π₀).FG ∧
          π₀.comp φ₀ = (algebraMap A₀ (Localization.Away s_A)).comp α_hom := by
    intro P₂ _ _ α_hom r
    let _ : Algebra P₂ A₀ := α_hom.toAlgebra
    intro Φ G hSurjΦ hKerG hDet
    let I_G : Ideal (MvPolynomial (Fin r) P₂) := Ideal.span (Set.range G)
    let P_pre : Algebra.PreSubmersivePresentation P₂
        (MvPolynomial (Fin r) P₂ ⧸ I_G) (Fin r) (Fin r) :=
      Algebra.PreSubmersivePresentation.naive (v := G) id Function.injective_id
    have hJM_eq : P_pre.jacobiMatrix =
        Matrix.of (fun i j : Fin r => MvPolynomial.pderiv i (G j)) := by
      apply Matrix.ext
      intro i j
      exact P_pre.jacobiMatrix_apply i j
    have hJac_eq : P_pre.jacobian =
        Ideal.Quotient.mk I_G (Matrix.of (fun i j : Fin r => MvPolynomial.pderiv i (G j))).det := by
      rw [P_pre.jacobian_eq_jacobiMatrix_det, hJM_eq]
      rfl
    have hIG_le : I_G ≤ RingHom.ker Φ.toRingHom := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hKerG j
    have hIG_zero : ∀ p ∈ I_G, Φ.toRingHom p = 0 :=
      fun p hp => RingHom.mem_ker.mp (hIG_le hp)
    let π_pre : (MvPolynomial (Fin r) P₂ ⧸ I_G) →+* A₀ :=
      Ideal.Quotient.lift I_G Φ.toRingHom hIG_zero
    have hSurj_pre : Function.Surjective π_pre := by
      intro a
      obtain ⟨p, rfl⟩ := hSurjΦ a
      exact ⟨Ideal.Quotient.mk I_G p, Ideal.Quotient.lift_mk I_G Φ.toRingHom hIG_zero⟩
    have hπ_pre_alg : ∀ p : P₂,
        π_pre (algebraMap P₂ (MvPolynomial (Fin r) P₂ ⧸ I_G) p) = α_hom p := by
      intro p
      change Ideal.Quotient.lift I_G Φ.toRingHom hIG_zero (Ideal.Quotient.mk I_G (MvPolynomial.C p)) =
        α_hom p
      rw [Ideal.Quotient.lift_mk]
      exact Φ.commutes p
    let s_A : A₀ := π_pre P_pre.jacobian
    have hs_A : s_A ∉ q₀.asIdeal := by
      change π_pre P_pre.jacobian ∉ q₀.asIdeal
      rw [hJac_eq]
      dsimp only [π_pre]
      rw [Ideal.Quotient.lift_mk]
      exact hDet
    let φ₀ : P₂ →+* Localization.Away P_pre.jacobian :=
      algebraMap P₂ (Localization.Away P_pre.jacobian)
    let Q_away : Algebra.PreSubmersivePresentation
        (MvPolynomial (Fin r) P₂ ⧸ I_G) (Localization.Away P_pre.jacobian) Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway
        (Localization.Away P_pre.jacobian) P_pre.jacobian
    let P_comp : Algebra.PreSubmersivePresentation P₂
        (Localization.Away P_pre.jacobian) (Unit ⊕ Fin r) (Unit ⊕ Fin r) :=
      Q_away.comp P_pre
    have hUnit_comp : IsUnit P_comp.jacobian := by
      change IsUnit (Q_away.comp P_pre).jacobian
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.smul_def, Algebra.PreSubmersivePresentation.localizationAway_jacobian]
      exact (IsLocalization.Away.algebraMap_isUnit
          (S := Localization.Away P_pre.jacobian) P_pre.jacobian).mul
        (IsLocalization.Away.algebraMap_isUnit
          (S := Localization.Away P_pre.jacobian) P_pre.jacobian)
    let P_subm : Algebra.SubmersivePresentation P₂
        (Localization.Away P_pre.jacobian) (Unit ⊕ Fin r) (Unit ⊕ Fin r) :=
      { P_comp with jacobian_isUnit := hUnit_comp }
    have hDim0 : P_subm.dimension = 0 := Nat.sub_self (Nat.card (Unit ⊕ Fin r))
    have _ : Algebra.IsStandardSmoothOfRelativeDimension 0 P₂
        (Localization.Away P_pre.jacobian) :=
      P_subm.isStandardSmoothOfRelativeDimension hDim0
    have hEt₀ : φ₀.Etale := RingHom.etale_algebraMap.mpr inferInstance
    have hq₀_range : q₀ ∈ Set.range (PrimeSpectrum.comap (algebraMap A₀ (Localization.Away s_A))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s_A) s_A]
      exact hs_A
    obtain ⟨q'₀, hq'₀⟩ := hq₀_range
    let g_pre : (MvPolynomial (Fin r) P₂ ⧸ I_G) →+* Localization.Away s_A :=
      (algebraMap A₀ (Localization.Away s_A)).comp π_pre
    have hg_unit : IsUnit (g_pre P_pre.jacobian) := by
      change IsUnit (algebraMap A₀ (Localization.Away s_A) s_A)
      exact IsLocalization.Away.algebraMap_isUnit (S := Localization.Away s_A) s_A
    let π₀ : Localization.Away P_pre.jacobian →+* Localization.Away s_A :=
      IsLocalization.Away.lift P_pre.jacobian hg_unit
    let Q₀ : PrimeSpectrum (Localization.Away P_pre.jacobian) := PrimeSpectrum.comap π₀ q'₀
    have hSurj₀ : Function.Surjective π₀ := by
      intro z
      obtain ⟨n, a, hz⟩ := IsLocalization.Away.surj s_A z
      obtain ⟨b, rfl⟩ := hSurj_pre a
      let u_J : (Localization.Away P_pre.jacobian)ˣ :=
        (IsLocalization.Away.algebraMap_isUnit
          (S := Localization.Away P_pre.jacobian) P_pre.jacobian).unit
      have hu_J_val : (u_J : Localization.Away P_pre.jacobian) =
          algebraMap (MvPolynomial (Fin r) P₂ ⧸ I_G)
            (Localization.Away P_pre.jacobian) P_pre.jacobian := rfl
      have hπ_uJ : π₀ (u_J : Localization.Away P_pre.jacobian) =
          algebraMap A₀ (Localization.Away s_A) s_A := by
        rw [hu_J_val, IsLocalization.Away.lift_eq]
        rfl
      refine ⟨algebraMap (MvPolynomial (Fin r) P₂ ⧸ I_G)
          (Localization.Away P_pre.jacobian) b * ((↑u_J⁻¹ : Localization.Away P_pre.jacobian) ^ n),
        ?_⟩
      apply (hg_unit.pow n).mul_right_cancel
      change π₀ (algebraMap _ (Localization.Away P_pre.jacobian) b *
            ((↑u_J⁻¹ : Localization.Away P_pre.jacobian) ^ n)) *
          (algebraMap A₀ (Localization.Away s_A) s_A) ^ n =
        z * (algebraMap A₀ (Localization.Away s_A) s_A) ^ n
      rw [hz, ← hπ_uJ, ← map_pow, ← map_mul, mul_assoc, ← mul_pow, Units.inv_mul, one_pow,
        mul_one, IsLocalization.Away.lift_eq]
      rfl
    have _ : IsNoetherianRing (Localization.Away P_pre.jacobian) :=
      Algebra.FiniteType.isNoetherianRing P₂ (Localization.Away P_pre.jacobian)
    have hKerFG : (RingHom.ker π₀).FG := IsNoetherian.noetherian (RingHom.ker π₀)
    have hComm₀ : π₀.comp φ₀ = (algebraMap A₀ (Localization.Away s_A)).comp α_hom := by
      ext p
      simp only [RingHom.comp_apply]
      change π₀ (algebraMap P₂ (Localization.Away P_pre.jacobian) p) =
        algebraMap A₀ (Localization.Away s_A) (α_hom p)
      rw [IsScalarTower.algebraMap_apply P₂ (MvPolynomial (Fin r) P₂ ⧸ I_G)
        (Localization.Away P_pre.jacobian) p, IsLocalization.Away.lift_eq]
      change algebraMap A₀ (Localization.Away s_A)
        (π_pre (algebraMap P₂ (MvPolynomial (Fin r) P₂ ⧸ I_G) p)) =
        algebraMap A₀ (Localization.Away s_A) (α_hom p)
      rw [hπ_pre_alg]
    exact ⟨Localization.Away P_pre.jacobian, inferInstance, φ₀, Q₀, s_A, q'₀, π₀,
      hEt₀, hs_A, hq'₀, rfl, hSurj₀, hKerFG, hComm₀⟩
  let _ : Algebra (PowerSeries Ω) Ω :=
    (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
  let _ : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
  intro q_Ω hq_Ω hSpan
  let ι_R : A₀ →ₐ[PowerSeries Ω] TensorProduct (PowerSeries Ω) Ω A₀ :=
    Algebra.TensorProduct.includeRight
  have hSurj_ι : Function.Surjective ι_R := by
    intro t
    refine TensorProduct.inductionOn t (fun ω a => ?_) (fun x y ihx ihy => ?_)
    · refine ⟨f₀ (PowerSeries.C ω) * a, ?_⟩
      have hω : (PowerSeries.C ω : PowerSeries Ω) • (1 : Ω) = ω := by
        change (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) (PowerSeries.C ω) * 1 = ω
        rw [PowerSeries.constantCoeff_C, mul_one]
      have hsmul : (PowerSeries.C ω : PowerSeries Ω) • a = f₀ (PowerSeries.C ω) * a := rfl
      calc ι_R (f₀ (PowerSeries.C ω) * a)
          = (1 : Ω) ⊗ₜ[PowerSeries Ω] ((PowerSeries.C ω : PowerSeries Ω) • a) := by
              rw [hsmul]; rfl
        _ = ((PowerSeries.C ω : PowerSeries Ω) • (1 : Ω)) ⊗ₜ[PowerSeries Ω] a :=
            (TensorProduct.smul_tmul (PowerSeries.C ω : PowerSeries Ω) (1 : Ω) a).symm
        _ = ω ⊗ₜ[PowerSeries Ω] a := by rw [hω]
    · rcases ihx with ⟨ax, rfl⟩
      rcases ihy with ⟨ay, rfl⟩
      exact ⟨ax + ay, map_add ι_R ax ay⟩
  have hKer_ι : ∀ a : A₀, ι_R a = 0 → ∃ r₀ : A₀, a = r₀ * f₀ PowerSeries.X := by
    let J_X : Ideal A₀ := Ideal.span {f₀ PowerSeries.X}
    let q_X : A₀ →ₐ[PowerSeries Ω] (A₀ ⧸ J_X) := Ideal.Quotient.mkₐ (PowerSeries Ω) J_X
    let ψ_Ω : Ω →ₐ[PowerSeries Ω] (A₀ ⧸ J_X) :=
      { (((Ideal.Quotient.mk J_X).comp f₀).comp (PowerSeries.C : Ω →+* PowerSeries Ω)) with
        commutes' := fun r => by
          change Ideal.Quotient.mk J_X (f₀ (PowerSeries.C (PowerSeries.constantCoeff r))) =
            Ideal.Quotient.mk J_X (f₀ r)
          rw [Ideal.Quotient.eq]
          have hdvd : (PowerSeries.X : PowerSeries Ω) ∣
              PowerSeries.C (PowerSeries.constantCoeff r) - r := by
            rw [PowerSeries.X_dvd_iff, map_sub, PowerSeries.constantCoeff_C, sub_self]
          rcases hdvd with ⟨h, hh⟩
          have hmap := congrArg f₀ hh
          rw [map_sub, map_mul] at hmap
          rw [hmap]
          exact Ideal.mem_span_singleton.mpr ⟨f₀ h, rfl⟩ }
    let Ψ_X : TensorProduct (PowerSeries Ω) Ω A₀ →ₐ[PowerSeries Ω] (A₀ ⧸ J_X) :=
      Algebra.TensorProduct.lift ψ_Ω q_X (fun _ _ => Commute.all _ _)
    intro a ha
    have hΨa : Ψ_X (ι_R a) = Ideal.Quotient.mk J_X a := by
      change Ψ_X (1 ⊗ₜ[PowerSeries Ω] a) = Ideal.Quotient.mk J_X a
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    rw [ha, map_zero] at hΨa
    have ha_mem : a ∈ J_X := Ideal.Quotient.eq_zero_iff_mem.mp hΨa.symm
    rcases Ideal.mem_span_singleton.mp ha_mem with ⟨r₀, hr₀⟩
    exact ⟨r₀, by rw [hr₀, mul_comm]⟩
  have hLin : ∀ z : A₀, z ∈ q₀.asIdeal →
      ∃ w b₀ b₁ r₀ : A₀, w ∉ q₀.asIdeal ∧
        w * z = b₀ * u₁ + b₁ * v₁ + r₀ * f₀ PowerSeries.X := by
    let loc : TensorProduct (PowerSeries Ω) Ω A₀ →+* Localization.AtPrime q_Ω.asIdeal :=
      algebraMap (TensorProduct (PowerSeries Ω) Ω A₀) (Localization.AtPrime q_Ω.asIdeal)
    intro z hz
    have hz_qΩ : ι_R z ∈ q_Ω.asIdeal := by
      change z ∈ (PrimeSpectrum.comap Algebra.TensorProduct.includeRight.toRingHom q_Ω).asIdeal
      rwa [hq_Ω]
    have hz_max : loc (ι_R z) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime q_Ω.asIdeal) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q_Ω.asIdeal)
        q_Ω.asIdeal (ι_R z)).mpr hz_qΩ
    have hSpan' : Ideal.span {loc (ι_R u₁), loc (ι_R v₁)} =
        IsLocalRing.maximalIdeal (Localization.AtPrime q_Ω.asIdeal) := hSpan
    rw [← hSpan'] at hz_max
    obtain ⟨α₀, α₁, hα⟩ := Ideal.mem_span_pair.mp hz_max
    obtain ⟨⟨n₀, s₀⟩, hs₀⟩ := IsLocalization.surj q_Ω.asIdeal.primeCompl α₀
    obtain ⟨⟨n₁, s₁⟩, hs₁⟩ := IsLocalization.surj q_Ω.asIdeal.primeCompl α₁
    dsimp only at hs₀ hs₁
    have hloc_eq : loc (((s₀ : TensorProduct (PowerSeries Ω) Ω A₀) *
          (s₁ : TensorProduct (PowerSeries Ω) Ω A₀)) * ι_R z) =
        loc ((n₀ * (s₁ : TensorProduct (PowerSeries Ω) Ω A₀)) * ι_R u₁ +
          (n₁ * (s₀ : TensorProduct (PowerSeries Ω) Ω A₀)) * ι_R v₁) := by
      simp only [map_mul, map_add]
      calc (loc ↑s₀ * loc ↑s₁) * loc (ι_R z)
          = (loc ↑s₀ * loc ↑s₁) * (α₀ * loc (ι_R u₁) + α₁ * loc (ι_R v₁)) := by rw [hα]
        _ = (α₀ * loc ↑s₀) * loc ↑s₁ * loc (ι_R u₁) +
            (α₁ * loc ↑s₁) * loc ↑s₀ * loc (ι_R v₁) := by ring
        _ = loc n₀ * loc ↑s₁ * loc (ι_R u₁) +
            loc n₁ * loc ↑s₀ * loc (ι_R v₁) := by rw [hs₀, hs₁]
    obtain ⟨s₂, hs₂⟩ :=
      (IsLocalization.eq_iff_exists q_Ω.asIdeal.primeCompl (Localization.AtPrime q_Ω.asIdeal)).mp
        hloc_eq
    have hw_tilde_notMem :
        (s₂ : TensorProduct (PowerSeries Ω) Ω A₀) * ↑s₀ * ↑s₁ ∉ q_Ω.asIdeal :=
      q_Ω.asIdeal.primeCompl.mul_mem
        (q_Ω.asIdeal.primeCompl.mul_mem s₂.2 s₀.2) s₁.2
    obtain ⟨w, hw_eq⟩ :=
      hSurj_ι ((s₂ : TensorProduct (PowerSeries Ω) Ω A₀) * ↑s₀ * ↑s₁)
    obtain ⟨b₀, hb₀_eq⟩ :=
      hSurj_ι ((s₂ : TensorProduct (PowerSeries Ω) Ω A₀) * n₀ * ↑s₁)
    obtain ⟨b₁, hb₁_eq⟩ :=
      hSurj_ι ((s₂ : TensorProduct (PowerSeries Ω) Ω A₀) * n₁ * ↑s₀)
    have hw_notMem : w ∉ q₀.asIdeal := by
      intro hw_in
      have h1 : ι_R w ∈ q_Ω.asIdeal := by
        change w ∈ (PrimeSpectrum.comap Algebra.TensorProduct.includeRight.toRingHom q_Ω).asIdeal
        rwa [hq_Ω]
      rw [hw_eq] at h1
      exact hw_tilde_notMem h1
    have hdiff_ker : ι_R (w * z - b₀ * u₁ - b₁ * v₁) = 0 := by
      simp only [map_sub, map_mul, hw_eq, hb₀_eq, hb₁_eq]
      linear_combination hs₂
    obtain ⟨r₀, hr₀⟩ := hKer_ι (w * z - b₀ * u₁ - b₁ * v₁) hdiff_ker
    refine ⟨w, b₀, b₁, r₀, hw_notMem, ?_⟩
    linear_combination hr₀
  have hFP_alg : Algebra.FinitePresentation (PowerSeries Ω) A₀ := hFP
  obtain ⟨r, Φ₀, hSurjΦ₀, _⟩ := hFP_alg.out
  let y : Fin r → A₀ := fun j => Φ₀ (MvPolynomial.X j)
  let α₀ : MvPolynomial (Fin 2) (PowerSeries Ω) →+* A₀ :=
    (MvPolynomial.aeval (R := PowerSeries Ω) ![u₁, v₁]).toRingHom
  let _ : Algebra (MvPolynomial (Fin 2) (PowerSeries Ω)) A₀ := α₀.toAlgebra
  let Φ : MvPolynomial (Fin r) (MvPolynomial (Fin 2) (PowerSeries Ω)) →ₐ[MvPolynomial (Fin 2) (PowerSeries Ω)] A₀ :=
    MvPolynomial.aeval (R := MvPolynomial (Fin 2) (PowerSeries Ω)) y
  let ι_poly : MvPolynomial (Fin r) (PowerSeries Ω) →+*
      MvPolynomial (Fin r) (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
    MvPolynomial.map (MvPolynomial.C : PowerSeries Ω →+* MvPolynomial (Fin 2) (PowerSeries Ω))
  have hΦ_comp : Φ.toRingHom.comp ι_poly = Φ₀.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro s
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ι_poly,
        MvPolynomial.map_C]
      change Φ (MvPolynomial.C (MvPolynomial.C s)) = Φ₀ (MvPolynomial.C s)
      rw [MvPolynomial.aeval_C]
      change α₀ (MvPolynomial.C s) = Φ₀ (MvPolynomial.C s)
      have hαs : α₀ (MvPolynomial.C s) = f₀ s := by
        change (MvPolynomial.aeval (R := PowerSeries Ω) ![u₁, v₁]) (MvPolynomial.C s) = f₀ s
        rw [MvPolynomial.aeval_C]
        rfl
      rw [hαs]
      exact (Φ₀.commutes s).symm
    · intro j
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ι_poly,
        MvPolynomial.map_X]
      change (MvPolynomial.aeval (R := MvPolynomial (Fin 2) (PowerSeries Ω)) y)
        (MvPolynomial.X j) = Φ₀ (MvPolynomial.X j)
      rw [MvPolynomial.aeval_X]
  have hSurjΦ : Function.Surjective Φ := by
    intro a
    obtain ⟨p, rfl⟩ := hSurjΦ₀ a
    exact ⟨ι_poly p, RingHom.congr_fun hΦ_comp p⟩
  have hf₀X : f₀ PowerSeries.X ∈ q₀.asIdeal := by
    change PowerSeries.X ∈ (PrimeSpectrum.comap f₀ q₀).asIdeal
    rw [hq₀_max, PowerSeries.maximalIdeal_eq_span_X]
    exact Ideal.subset_span rfl
  choose c hc using fun j : Fin r => hRes (y j)
  choose w b₀ b₁ r₀ hw hEq using fun j : Fin r => hLin (y j - f₀ (PowerSeries.C (c j))) (hc j)
  choose W hW using fun j : Fin r => hSurjΦ (w j)
  choose B₀_poly hB₀ using fun j : Fin r => hSurjΦ (b₀ j)
  choose B₁_poly hB₁ using fun j : Fin r => hSurjΦ (b₁ j)
  choose R_poly hR using fun j : Fin r => hSurjΦ (r₀ j)
  let C₂ : MvPolynomial (Fin 2) (PowerSeries Ω) →+*
      MvPolynomial (Fin r) (MvPolynomial (Fin 2) (PowerSeries Ω)) := MvPolynomial.C
  let C₁ : PowerSeries Ω →+*
      MvPolynomial (Fin r) (MvPolynomial (Fin 2) (PowerSeries Ω)) := C₂.comp MvPolynomial.C
  have hΦ_C₂ : ∀ p : MvPolynomial (Fin 2) (PowerSeries Ω), Φ (C₂ p) = α₀ p :=
    fun p => MvPolynomial.aeval_C (R := MvPolynomial (Fin 2) (PowerSeries Ω)) y p
  have hΦ_C₁ : ∀ s : PowerSeries Ω, Φ (C₁ s) = f₀ s := by
    intro s
    change Φ (C₂ (MvPolynomial.C s)) = f₀ s
    rw [hΦ_C₂]
    change (MvPolynomial.aeval (R := PowerSeries Ω) ![u₁, v₁]) (MvPolynomial.C s) = f₀ s
    rw [MvPolynomial.aeval_C]
    rfl
  have hα_X0 : α₀ (MvPolynomial.X 0) = u₁ := by
    change (MvPolynomial.aeval (R := PowerSeries Ω) ![u₁, v₁]) (MvPolynomial.X 0) = u₁
    rw [MvPolynomial.aeval_X]
    rfl
  have hα_X1 : α₀ (MvPolynomial.X 1) = v₁ := by
    change (MvPolynomial.aeval (R := PowerSeries Ω) ![u₁, v₁]) (MvPolynomial.X 1) = v₁
    rw [MvPolynomial.aeval_X]
    rfl
  let G : Fin r → MvPolynomial (Fin r) (MvPolynomial (Fin 2) (PowerSeries Ω)) := fun j =>
    W j * (MvPolynomial.X j - C₁ (PowerSeries.C (c j))) -
      B₀_poly j * C₂ (MvPolynomial.X 0) -
      B₁_poly j * C₂ (MvPolynomial.X 1) -
      R_poly j * C₁ PowerSeries.X
  have hKerG : ∀ j : Fin r, Φ (G j) = 0 := by
    intro j
    dsimp only [G]
    simp only [map_sub, map_mul, hW, hB₀, hB₁, hR, hΦ_C₁, hΦ_C₂, hα_X0, hα_X1]
    have hΦX : Φ (MvPolynomial.X j) = y j :=
      MvPolynomial.aeval_X (R := MvPolynomial (Fin 2) (PowerSeries Ω)) y j
    rw [hΦX]
    linear_combination hEq j
  let M_G : Matrix (Fin r) (Fin r) (MvPolynomial (Fin r) (MvPolynomial (Fin 2) (PowerSeries Ω))) :=
    Matrix.of (fun i j : Fin r => MvPolynomial.pderiv i (G j))
  have hDet : Φ M_G.det ∉ q₀.asIdeal := by
    let qbar : A₀ →+* (A₀ ⧸ q₀.asIdeal) := Ideal.Quotient.mk q₀.asIdeal
    let ψ_q : MvPolynomial (Fin r) (MvPolynomial (Fin 2) (PowerSeries Ω)) →+*
        (A₀ ⧸ q₀.asIdeal) := qbar.comp Φ.toRingHom
    have hq_yj : ∀ j : Fin r, ψ_q (MvPolynomial.X j - C₁ (PowerSeries.C (c j))) = 0 := by
      intro j
      change qbar (Φ (MvPolynomial.X j - C₁ (PowerSeries.C (c j)))) = 0
      rw [map_sub, MvPolynomial.aeval_X, hΦ_C₁]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hc j)
    have hq_u1 : ψ_q (C₂ (MvPolynomial.X 0)) = 0 := by
      change qbar (Φ (C₂ (MvPolynomial.X 0))) = 0
      rw [hΦ_C₂, hα_X0]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hu₁
    have hq_v1 : ψ_q (C₂ (MvPolynomial.X 1)) = 0 := by
      change qbar (Φ (C₂ (MvPolynomial.X 1))) = 0
      rw [hΦ_C₂, hα_X1]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hv₁
    have hq_X : ψ_q (C₁ PowerSeries.X) = 0 := by
      change qbar (Φ (C₁ PowerSeries.X)) = 0
      rw [hΦ_C₁]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hf₀X
    have hpderiv_C₂ : ∀ (i : Fin r) (p : MvPolynomial (Fin 2) (PowerSeries Ω)),
        MvPolynomial.pderiv i (C₂ p) = 0 :=
      fun _ _ => MvPolynomial.pderiv_C
    have hpderiv_C₁ : ∀ (i : Fin r) (s : PowerSeries Ω), MvPolynomial.pderiv i (C₁ s) = 0 :=
      fun _ _ => MvPolynomial.pderiv_C
    have hMat_diag : ψ_q.mapMatrix M_G = Matrix.diagonal (fun i : Fin r => qbar (w i)) := by
      ext i j
      have hLHS : (ψ_q.mapMatrix M_G) i j = ψ_q (MvPolynomial.pderiv i (G j)) := rfl
      rw [hLHS]
      dsimp only [G]
      simp only [map_sub, MvPolynomial.pderiv_mul, hpderiv_C₂, hpderiv_C₁, mul_zero, add_zero]
      simp only [map_sub, map_add, map_mul, map_zero, hq_yj, hq_u1, hq_v1, hq_X, mul_zero,
        zero_add, sub_zero]
      have hψW : ψ_q (W j) = qbar (w j) := by
        change qbar (Φ (W j)) = qbar (w j)
        rw [hW]
      rw [hψW]
      by_cases hij : i = j
      · subst hij
        rw [MvPolynomial.pderiv_X_self, map_one, mul_one, Matrix.diagonal_apply_eq]
      · rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hij), map_zero, mul_zero,
          Matrix.diagonal_apply_ne _ hij]
    have hdet_q : qbar (Φ M_G.det) = qbar (∏ i : Fin r, w i) := by
      have hmap_det : ψ_q M_G.det = (ψ_q.mapMatrix M_G).det := RingHom.map_det ψ_q M_G
      change ψ_q M_G.det = qbar (∏ i : Fin r, w i)
      rw [hmap_det, hMat_diag, Matrix.det_diagonal, map_prod]
    intro h_in
    have hzero : qbar (Φ M_G.det) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h_in
    rw [hdet_q] at hzero
    have hprod_in : (∏ i : Fin r, w i) ∈ q₀.asIdeal := Ideal.Quotient.eq_zero_iff_mem.mp hzero
    exact q₀.asIdeal.primeCompl.prod_mem (fun i _ => hw i) hprod_in
  exact hStep3 (MvPolynomial (Fin 2) (PowerSeries Ω)) α₀ r Φ G hSurjΦ hKerG hDet

theorem weil_powerSeries_flat_nodal_cotangent_principal_at_prime (Ω A₀ B₀ D_Ω : Type u) [Field Ω] [CommRing A₀] [CommRing B₀] [CommRing D_Ω]
    (f₀ : PowerSeries Ω →+* A₀)
    (hFlat : f₀.Flat)
    (q₀ : PrimeSpectrum A₀)
    (s_A : A₀)
    (hs_A : s_A ∉ q₀.asIdeal)
    (q'₀ : PrimeSpectrum (Localization.Away s_A))
    (hq'₀ : PrimeSpectrum.comap (algebraMap A₀ (Localization.Away s_A)) q'₀ = q₀)
    (φ₀ : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B₀)
    (hEt₀ : φ₀.Etale)
    (π₀ : B₀ →+* Localization.Away s_A)
    (hSurj₀ : Function.Surjective π₀)
    (hKerFG : (RingHom.ker π₀).FG)
    (hComm₀ : π₀.comp (φ₀.comp MvPolynomial.C) =
      (algebraMap A₀ (Localization.Away s_A)).comp f₀)
    (Q₀ : PrimeSpectrum B₀)
    (hQ₀ : PrimeSpectrum.comap π₀ q'₀ = Q₀) :
    letI : Algebra (PowerSeries Ω) Ω :=
      (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).toAlgebra
    letI : Algebra (PowerSeries Ω) A₀ := f₀.toAlgebra
    ∀ (m₀ : PrimeSpectrum D_Ω)
      (ψ₁ : TensorProduct (PowerSeries Ω) Ω A₀ →+* D_Ω)
      (_hψ₁ : ψ₁.Etale)
      (_hm₀ : PrimeSpectrum.comap
        (ψ₁.comp Algebra.TensorProduct.includeRight.toRingHom) m₀ = q₀),
      letI : Algebra Ω D_Ω := (ψ₁.comp Algebra.TensorProduct.includeLeftRingHom).toAlgebra
      Subsingleton (Algebra.H1Cotangent Ω D_Ω) →
      (∃ (i_rel : D_Ω →ₗ[D_Ω] (Fin 2 → D_Ω)) (p_rel : (Fin 2 → D_Ω) →ₗ[D_Ω] Ω[D_Ω ⁄ Ω]),
        Function.Injective i_rel ∧ Function.Surjective p_rel ∧ Function.Exact i_rel p_rel) →
      ∃ (s₁ g₀ : B₀),
        s₁ ∉ Q₀.asIdeal ∧
        g₀ ∈ RingHom.ker π₀ ∧
        ∀ j ∈ RingHom.ker π₀, ∃ b : B₀, s₁ * j = b * g₀ :=
by
  have hPart2 : ∀ (B_Ω A'_Ω D'_Ω : Type u)
      [CommRing B_Ω] [CommRing A'_Ω] [CommRing D'_Ω]
      [Algebra Ω B_Ω] [Algebra Ω A'_Ω] [Algebra Ω D'_Ω]
      (φ_Ω : MvPolynomial (Fin 2) Ω →ₐ[Ω] B_Ω)
      (_ : φ_Ω.toRingHom.Etale)
      (π_Ω : B_Ω →ₐ[Ω] A'_Ω)
      (_ : Function.Surjective π_Ω)
      (ψ'₁ : A'_Ω →ₐ[Ω] D'_Ω)
      (_ : ψ'₁.toRingHom.Etale)
      (_ : Subsingleton (Algebra.H1Cotangent Ω D'_Ω)),
      letI : Algebra B_Ω D'_Ω := (ψ'₁.comp π_Ω).toRingHom.toAlgebra
      ∃ (i_amb : TensorProduct B_Ω D'_Ω ↥(RingHom.ker π_Ω.toRingHom) →ₗ[D'_Ω] (Fin 2 → D'_Ω))
        (p_amb : (Fin 2 → D'_Ω) →ₗ[D'_Ω] KaehlerDifferential Ω D'_Ω),
        Function.Injective i_amb ∧ Function.Surjective p_amb ∧ Function.Exact i_amb p_amb := by
    intro B_Ω A'_Ω D'_Ω _ _ _ _ _ _ φ_Ω hEtB π_Ω hSurj ψ'₁ hEtD hH1
    letI : Algebra B_Ω D'_Ω := (ψ'₁.comp π_Ω).toRingHom.toAlgebra
    let P₂Ω := MvPolynomial (Fin 2) Ω
    let _ : Algebra P₂Ω B_Ω := φ_Ω.toRingHom.toAlgebra
    have : IsScalarTower Ω P₂Ω B_Ω := IsScalarTower.of_algebraMap_eq fun c => (φ_Ω.commutes c).symm
    have : Algebra.Etale P₂Ω B_Ω := hEtB.toAlgebra
    let _ : Algebra A'_Ω D'_Ω := ψ'₁.toRingHom.toAlgebra
    have : Algebra.Etale A'_Ω D'_Ω := hEtD.toAlgebra
    have hSS0 : Algebra.IsStandardSmoothOfRelativeDimension 0 A'_Ω D'_Ω :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    obtain ⟨ι, σ, hFinσ, hFinι, P_sub, hdim0⟩ := hSS0.out
    classical
    let _ : Fintype σ := Fintype.ofFinite σ
    let _ : Fintype ι := Fintype.ofFinite ι
    let P_B : Type u := MvPolynomial ι B_Ω
    let Φ_poly : P_B →+* MvPolynomial ι A'_Ω := MvPolynomial.map π_Ω.toRingHom
    have hSurj_poly : Function.Surjective Φ_poly :=
      MvPolynomial.map_surjective π_Ω.toRingHom hSurj
    have hKer_poly : RingHom.ker Φ_poly = Ideal.map MvPolynomial.C (RingHom.ker π_Ω.toRingHom) :=
      MvPolynomial.ker_map π_Ω.toRingHom
    choose H_tilde hH_tilde using fun s : σ => hSurj_poly (P_sub.relation s)
    let I_H : Ideal P_B := Ideal.span (Set.range H_tilde)
    let B_pre : Type u := P_B ⧸ I_H
    let q_pre : P_B →+* B_pre := Ideal.Quotient.mk I_H
    let α_D : P_B →+* D'_Ω := (algebraMap P_sub.Ring D'_Ω).comp Φ_poly
    have hIH_le : I_H ≤ RingHom.ker α_D := by
      rw [Ideal.span_le]
      rintro _ ⟨s, rfl⟩
      change algebraMap P_sub.Ring D'_Ω (Φ_poly (H_tilde s)) = 0
      rw [hH_tilde s]
      have hmem : P_sub.relation s ∈ P_sub.ker := by
        rw [← P_sub.span_range_relation_eq_ker]
        exact Ideal.subset_span ⟨s, rfl⟩
      exact hmem
    let π_pre : B_pre →+* D'_Ω := Ideal.Quotient.lift I_H α_D hIH_le
    have hSurj_pre : Function.Surjective π_pre := by
      intro d
      obtain ⟨p, rfl⟩ := P_sub.algebraMap_surjective d
      obtain ⟨f, rfl⟩ := hSurj_poly p
      exact ⟨q_pre f, rfl⟩
    have hπ_pre_B : ∀ b : B_Ω, π_pre (algebraMap B_Ω B_pre b) = ψ'₁ (π_Ω b) := by
      intro b
      change algebraMap P_sub.Ring D'_Ω (MvPolynomial.map π_Ω.toRingHom (MvPolynomial.C b)) = ψ'₁ (π_Ω b)
      rw [MvPolynomial.map_C]
      exact IsScalarTower.algebraMap_apply A'_Ω P_sub.Ring D'_Ω (π_Ω b) |>.symm.trans rfl
    let J_Ω : Ideal B_Ω := RingHom.ker π_Ω.toRingHom
    have hKer_pre : RingHom.ker π_pre = Ideal.map (algebraMap B_Ω B_pre) J_Ω := by
      apply le_antisymm
      · intro x hx
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hf_ker : Φ_poly f ∈ Ideal.span (Set.range P_sub.relation) := by
          rw [P_sub.span_range_relation_eq_ker]
          exact hx
        have hLift_rel : ∀ g ∈ Ideal.span (Set.range P_sub.relation),
            ∃ h ∈ I_H, Φ_poly h = g := by
          intro g hg
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hg
          · rintro _ ⟨s, rfl⟩
            exact ⟨H_tilde s, Ideal.subset_span ⟨s, rfl⟩, hH_tilde s⟩
          · exact ⟨0, I_H.zero_mem, map_zero _⟩
          · intro g₁ g₂ _ _ ⟨h₁, hh₁, eq₁⟩ ⟨h₂, hh₂, eq₂⟩
            exact ⟨h₁ + h₂, I_H.add_mem hh₁ hh₂, by rw [map_add, eq₁, eq₂]⟩
          · intro a g₁ _ ⟨h₁, hh₁, eq₁⟩
            obtain ⟨a', rfl⟩ := hSurj_poly a
            exact ⟨a' * h₁, I_H.mul_mem_left a' hh₁, by rw [map_mul, eq₁, smul_eq_mul]⟩
        obtain ⟨h, hh_mem, hh_eq⟩ := hLift_rel (Φ_poly f) hf_ker
        have hdiff_ker : f - h ∈ RingHom.ker Φ_poly := by
          rw [RingHom.mem_ker, map_sub, hh_eq, sub_self]
        rw [hKer_poly] at hdiff_ker
        have hq_eq : Ideal.Quotient.mk I_H f = q_pre (f - h) := by
          change q_pre f = q_pre (f - h)
          rw [map_sub, (Ideal.Quotient.eq_zero_iff_mem).mpr hh_mem, sub_zero]
        rw [hq_eq]
        have hmap_eq : Ideal.map q_pre (Ideal.map MvPolynomial.C J_Ω) =
            Ideal.map (algebraMap B_Ω B_pre) J_Ω := by
          rw [Ideal.map_map]
          rfl
        rw [← hmap_eq]
        exact Ideal.mem_map_of_mem q_pre hdiff_ker
      · rw [Ideal.map_le_iff_le_comap]
        intro b hb
        change π_pre (algebraMap B_Ω B_pre b) = 0
        have hb0 : π_Ω b = 0 := hb
        rw [hπ_pre_B, hb0, map_zero]
    let P_naive : Algebra.Presentation B_Ω B_pre ι σ :=
      Algebra.Presentation.naive (v := H_tilde)
    let P_B_pre : Algebra.PreSubmersivePresentation B_Ω B_pre ι σ :=
      Algebra.PreSubmersivePresentation.mk P_naive P_sub.map P_sub.map_inj
    let Δ_pre : B_pre := P_B_pre.jacobian
    have hJac_eq : π_pre Δ_pre = P_sub.jacobian := by
      rw [show Δ_pre = P_B_pre.jacobian from rfl,
        P_B_pre.jacobian_eq_jacobiMatrix_det, P_sub.jacobian_eq_jacobiMatrix_det]
      have hmat : Φ_poly.mapMatrix P_B_pre.jacobiMatrix = P_sub.jacobiMatrix := by
        apply Matrix.ext
        intro i j
        rw [RingHom.mapMatrix_apply, Matrix.map_apply,
          P_B_pre.jacobiMatrix_apply, P_sub.jacobiMatrix_apply]
        change MvPolynomial.map π_Ω.toRingHom (MvPolynomial.pderiv (P_sub.map i) (H_tilde j)) =
          MvPolynomial.pderiv (P_sub.map i) (P_sub.relation j)
        rw [← hH_tilde j, ← MvPolynomial.pderiv_map]
      rw [← hmat, ← RingHom.map_det Φ_poly P_B_pre.jacobiMatrix]
      rfl
    have hUnit_Δ : IsUnit (π_pre Δ_pre) := hJac_eq ▸ P_sub.jacobian_isUnit
    let B_til := Localization.Away Δ_pre
    let Q_loc : Algebra.PreSubmersivePresentation B_pre B_til Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway B_til Δ_pre
    have hUnit_comp : IsUnit (Q_loc.comp P_B_pre).jacobian := by
      rw [Q_loc.comp_jacobian_eq_jacobian_smul_jacobian P_B_pre,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact (IsLocalization.Away.algebraMap_isUnit Δ_pre).mul
        (IsLocalization.Away.algebraMap_isUnit Δ_pre)
    let P_B_til : Algebra.SubmersivePresentation B_Ω B_til (Unit ⊕ ι) (Unit ⊕ σ) :=
      { Q_loc.comp P_B_pre with jacobian_isUnit := hUnit_comp }
    have hdim_B_til : P_B_til.dimension = 0 := by
      change Nat.card (Unit ⊕ ι) - Nat.card (Unit ⊕ σ) = 0
      have h1 : Nat.card (Unit ⊕ ι) = 1 + Nat.card ι := by simp
      have h2 : Nat.card (Unit ⊕ σ) = 1 + Nat.card σ := by simp
      have h0 : Nat.card ι - Nat.card σ = 0 := hdim0
      omega
    have : Algebra.IsStandardSmoothOfRelativeDimension 0 B_Ω B_til :=
      P_B_til.isStandardSmoothOfRelativeDimension hdim_B_til
    have : Algebra.Etale B_Ω B_til :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr this
    have : Module.Flat B_Ω B_til := inferInstance
    let π_til_ring : B_til →+* D'_Ω := IsLocalization.Away.lift Δ_pre hUnit_Δ
    have hSurj_π_til : Function.Surjective π_til_ring := by
      intro d
      obtain ⟨x, rfl⟩ := hSurj_pre d
      exact ⟨algebraMap B_pre B_til x, IsLocalization.Away.lift_eq Δ_pre hUnit_Δ x⟩
    have hπ_til_B : ∀ b : B_Ω, π_til_ring (algebraMap B_Ω B_til b) = ψ'₁ (π_Ω b) := by
      intro b
      rw [IsScalarTower.algebraMap_apply B_Ω B_pre B_til b,
        IsLocalization.Away.lift_eq Δ_pre hUnit_Δ, hπ_pre_B]
    let π_til_Ω : B_til →ₐ[Ω] D'_Ω :=
      { π_til_ring with
        commutes' := fun c => by
          change π_til_ring (algebraMap Ω B_til c) = algebraMap Ω D'_Ω c
          rw [IsScalarTower.algebraMap_apply Ω B_Ω B_til c, hπ_til_B, AlgHom.commutes, AlgHom.commutes] }
    let J'_Ω : Ideal B_til := RingHom.ker π_til_Ω.toRingHom
    have hKer_π_til : J'_Ω = Ideal.map (algebraMap B_Ω B_til) J_Ω := by
      apply le_antisymm
      · intro z hz
        obtain ⟨⟨x, _, n, rfl⟩, hzx⟩ := IsLocalization.surj (Submonoid.powers Δ_pre) z
        dsimp only at hzx
        have hx_ker : x ∈ RingHom.ker π_pre := by
          rw [RingHom.mem_ker, ← IsLocalization.Away.lift_eq (S := B_til) Δ_pre hUnit_Δ x, ← hzx, map_mul]
          have hz0 : π_til_ring z = 0 := hz
          rw [hz0, zero_mul]
