        let h' : (TopologicalSpace.Opens.map fst.base).obj U₁ ≤
          (TopologicalSpace.Opens.map fst.base).obj U₀ :=
          (TopologicalSpace.Opens.map fst.base).monotone h
        { toFun := (P.presheaf.map (CategoryTheory.homOfLE h').op).hom
          map_add' := map_add _
          map_smul' := fun r x => by
            change (P.presheaf.map (CategoryTheory.homOfLE h').op).hom (γP U₀ (φ r) * x) =
              γP U₁ (φ r) * (P.presheaf.map (CategoryTheory.homOfLE h').op).hom x
