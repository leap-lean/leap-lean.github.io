      intro U₀ hU₀
      obtain ⟨μ_eqv, hμ_eqv⟩ := hAffPullback S B Y q f U₀ hU₀
      have h_same : μ_lin U₀ = μ_eqv.toLinearMap := by
        apply TensorProduct.ext'
        intro b c
        change γP U₀ b * (fst.app U₀).hom c = μ_eqv (b ⊗ₜ[↑S] c)
        exact (hμ_eqv b c).symm
      rw [h_same]
      exact μ_eqv.bijective
    have hPiTensorEquiv : ∀ (ι : Type) [Fintype ι] [DecidableEq ι]
