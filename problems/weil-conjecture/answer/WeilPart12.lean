    rfl
  have hChart2_g : ι_U2.opensRange.ι ≫ (π_U ≫ g_R₀) =
      ι_U2.isoOpensRange.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₂.hom.comp φ₀)) := by
    apply (Iso.eq_inv_comp ι_U2.isoOpensRange).mpr
    rw [← Category.assoc, ι_U2.isoOpensRange_hom_ι, ← Category.assoc, hι2_π,
      hgR0_eq, ← AlgebraicGeometry.Spec.map_comp]
    rfl
  have hFlat_g : AlgebraicGeometry.Flat (π_U ≫ g_R₀) := by
    have := AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource (P := @AlgebraicGeometry.Flat)
    apply AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top U_cov hiSup_cov
    intro b; cases b
    · change AlgebraicGeometry.Flat (ι_U2.opensRange.ι ≫ (π_U ≫ g_R₀)); rw [hChart2_g]
      have : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₂.hom.comp φ₀))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr hFlat₂
      infer_instance
    · change AlgebraicGeometry.Flat (ι_U1.opensRange.ι ≫ (π_U ≫ g_R₀)); rw [hChart1_g]
      have : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.hom.comp φ₀))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr hFlat₁
      infer_instance
  have hLFP_g : AlgebraicGeometry.LocallyOfFinitePresentation (π_U ≫ g_R₀) := by
    have := AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
      (P := @AlgebraicGeometry.LocallyOfFinitePresentation)
    apply AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top U_cov hiSup_cov
    intro b; cases b
    · change AlgebraicGeometry.LocallyOfFinitePresentation (ι_U2.opensRange.ι ≫ (π_U ≫ g_R₀)); rw [hChart2_g]
      have : AlgebraicGeometry.LocallyOfFinitePresentation
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₂.hom.comp φ₀))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr hFP₂
      infer_instance
    · change AlgebraicGeometry.LocallyOfFinitePresentation (ι_U1.opensRange.ι ≫ (π_U ≫ g_R₀)); rw [hChart1_g]
      have : AlgebraicGeometry.LocallyOfFinitePresentation
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.hom.comp φ₀))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr hFP₁
      infer_instance

  have hq_exc_p0 : π_U.base (ι_U1.base q_exc) = p₀ := by
    have hcomp_base := congrFun (congrArg (fun m => (m.base : _ → _)) hι1_π) q_exc
    dsimp at hcomp_base; rw [hcomp_base]
    apply PrimeSpectrum.ext; symm
    apply hp₀_max.eq_of_le ((AlgebraicGeometry.Spec.map φ₁).base q_exc).isPrime.ne_top
    rw [hp₀_eq]; apply sup_le
    · rw [Ideal.span_singleton_le_iff_mem]; change φ₁.hom z₁ ∈ q_exc.asIdeal
      rw [hq_exc_id]; exact Ideal.mem_span_singleton_self _
    · rw [Ideal.span_singleton_le_iff_mem]; change φ₁.hom z₂ ∈ q_exc.asIdeal
      rw [hQuot₁.1, hq_exc_id]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

  have hSurj_π : AlgebraicGeometry.Surjective π_U := by
    refine ⟨fun y => ?_⟩
    by_cases hy : y = p₀
    · subst hy; exact ⟨ι_U1.base q_exc, hq_exc_p0⟩
    · let U_off : (AlgebraicGeometry.Spec R₀).Opens :=
        ⟨(PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀))ᶜ,
          (PrimeSpectrum.isClosed_zeroLocus (p₀.asIdeal : Set R₀)).isOpen_compl⟩
      have hy_off : y ∈ U_off := fun hmem => hy (Set.mem_singleton_iff.mp (hZero_p₀ ▸ hmem))
      have : CategoryTheory.IsIso (π_U ∣_ U_off) := hIso_off
      let V_off : U_tilde.Opens := (TopologicalSpace.Opens.map π_U.base).obj U_off
      let w_sub := (CategoryTheory.inv (π_U ∣_ U_off)).base ⟨y, hy_off⟩
      refine ⟨V_off.ι.base w_sub, ?_⟩
      have hcomm_off := AlgebraicGeometry.morphismRestrict_ι π_U U_off
      have hinv_id : CategoryTheory.inv (π_U ∣_ U_off) ≫ ((π_U ∣_ U_off) ≫ U_off.ι) = U_off.ι := by
        rw [← Category.assoc, CategoryTheory.IsIso.inv_hom_id, Category.id_comp]
      rw [hcomm_off, ← Category.assoc] at hinv_id
      exact congrFun (congrArg (fun m => (m.base : _ → _)) hinv_id) ⟨y, hy_off⟩

  let s_res := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_res)
  have hCl_sres : AlgebraicGeometry.IsClosedImmersion s_res :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom φ_res) hSurj_res
  have hCl_ΦU : AlgebraicGeometry.IsClosedImmersion Φ_U :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPB_ΦU.flip hCl_sres
  have : AlgebraicGeometry.IsClosedImmersion Φ_U := hCl_ΦU
  have hSpecΩ_eq : ∀ q : AlgebraicGeometry.Spec (CommRingCat.of Ω), q = ⟨⊥, Ideal.isPrime_bot⟩ := by
    intro q; apply PrimeSpectrum.ext; rw [Submodule.eq_bot_iff]
    intro c hc; by_contra hc_ne
    exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hc_ne))
  have hs_res_bot : s_res.base ⟨⊥, Ideal.isPrime_bot⟩ = p₀ := by
    apply PrimeSpectrum.ext; change Ideal.comap φ_res ⊥ = p₀.asIdeal
    rw [← RingHom.ker_eq_comap_bot, hKer_res]
  have hRange_ΦU : Set.range Φ_U.base = π_U.base ⁻¹' {p₀} := by
    ext x; simp only [Set.mem_range, Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · rintro ⟨e, rfl⟩
      have hw := congrFun (congrArg (fun m => (m.base : _ → _)) hPB_ΦU.w) e
      dsimp at hw; rw [hw, hSpecΩ_eq ((weilProjectiveSpaceOver Ω 1).hom.base e), hs_res_bot]
    · intro hx
      let pt_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) := ⟨⊥, Ideal.isPrime_bot⟩
      have hxy : π_U.base x = s_res.base pt_Ω := hx.trans hs_res_bot.symm
      obtain ⟨w, hw_fst, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x pt_Ω hxy
      refine ⟨hPB_ΦU.isoPullback.inv.base w, ?_⟩
      have hinv_fst := congrFun (congrArg (fun m => (m.base : _ → _)) hPB_ΦU.isoPullback_inv_fst) w
      exact hinv_fst.trans hw_fst

  have : IrreducibleSpace ↥(weilProjectiveSpaceOver Ω 1).left :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hIntP1
  have hIrr_P1 : IsIrreducible (Set.univ : Set ↥(weilProjectiveSpaceOver Ω 1).left) :=
    IrreducibleSpace.isIrreducible_univ _
  let η_P1 : ↥(weilProjectiveSpaceOver Ω 1).left := hIrr_P1.genericPoint
  have hGen_P1 : IsGenericPoint η_P1 Set.univ := hIrr_P1.isGenericPoint_genericPoint isClosed_univ
  have hΦ_η_eq : Φ_U.base η_P1 = ι_U1.base q_exc := by
    have hcl_img : closure ({Φ_U.base η_P1} : Set ↥U_tilde) = π_U.base ⁻¹' {p₀} := by
      have h1 := Φ_U.isClosedEmbedding.closure_image_eq ({η_P1} : Set _)
      rw [Set.image_singleton, hGen_P1.def, Set.image_univ, hRange_ΦU] at h1; exact h1
    have hq_in_cl : ι_U1.base q_exc ∈ closure ({Φ_U.base η_P1} : Set ↥U_tilde) := by
      rw [hcl_img, Set.mem_preimage, Set.mem_singleton_iff]; exact hq_exc_p0
    have hη_in_U1 : Φ_U.base η_P1 ∈ Set.range ι_U1.base := by
      obtain ⟨z, hzU1, hzs⟩ := mem_closure_iff.mp hq_in_cl
        (Set.range ι_U1.base) ι_U1.isOpenEmbedding.isOpen_range ⟨q_exc, rfl⟩
      rwa [Set.mem_singleton_iff.mp hzs] at hzU1
    obtain ⟨P_gen, hP_gen⟩ := hη_in_U1
    have hP_p0 : (AlgebraicGeometry.Spec.map φ₁).base P_gen = p₀ := by
      have h1 := congrFun (congrArg (fun m => (m.base : _ → _)) hι1_π) P_gen
      dsimp at h1; rw [← h1, hP_gen]
      have hmem : Φ_U.base η_P1 ∈ Set.range Φ_U.base := ⟨η_P1, rfl⟩
      rw [hRange_ΦU, Set.mem_preimage, Set.mem_singleton_iff] at hmem; exact hmem
    have hle_P : q_exc.asIdeal ≤ P_gen.asIdeal := by
      rw [hq_exc_id, Ideal.span_singleton_le_iff_mem]
      have hz1_p0 : z₁ ∈ p₀.asIdeal := by
        rw [hp₀_eq]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self z₁)
      rw [← hP_p0] at hz1_p0; exact hz1_p0
    have hP_cl : P_gen ∈ closure ({q_exc} : Set (AlgebraicGeometry.Spec R₁)) :=
      (Set.ext_iff.mp (PrimeSpectrum.closure_singleton q_exc) P_gen).mpr
        (show (q_exc.asIdeal : Set R₁) ⊆ P_gen.asIdeal from hle_P)
    have hη_in_cl : Φ_U.base η_P1 ∈ closure ({ι_U1.base q_exc} : Set ↥U_tilde) := by
      rw [← hP_gen, ← Set.image_singleton]
      exact image_closure_subset_closure_image ι_U1.continuous ⟨P_gen, hP_cl, rfl⟩
    exact Inseparable.eq (inseparable_iff_mem_closure.mpr ⟨hη_in_cl, hq_in_cl⟩)

  
  have hf10_ap : ∀ r : R₀, ι_L1.hom (φ₁.hom r) = ι_L0.hom r := RingHom.congr_fun hf10_eq
  have hf20_ap : ∀ r : R₀, ι_L2.hom (φ₂.hom r) = ι_L0.hom r := RingHom.congr_fun hf20_eq
  have hSpecAppAlg : ∀ {R S : CommRingCat.{u}} (ψ : R ⟶ S) (f : R) (g : S) (hg : g = ψ.hom f)
      (h : PrimeSpectrum.basicOpen g ≤
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map ψ).base).obj
          (PrimeSpectrum.basicOpen f)) (r : R),
      ((AlgebraicGeometry.Spec.map ψ).appLE
        (PrimeSpectrum.basicOpen f) (PrimeSpectrum.basicOpen g) h).hom
          (algebraMap ↥R ↑((AlgebraicGeometry.Spec.structureSheaf ↥R).obj.obj
            (Opposite.op (PrimeSpectrum.basicOpen f))) r) =
        algebraMap ↥S ↑((AlgebraicGeometry.Spec.structureSheaf ↥S).obj.obj
          (Opposite.op (PrimeSpectrum.basicOpen g))) (ψ.hom r) := by
    intro R S ψ f g hg h r; subst hg
    let D_R : (AlgebraicGeometry.Spec R).Opens := PrimeSpectrum.basicOpen f
    let D_S : (AlgebraicGeometry.Spec S).Opens := PrimeSpectrum.basicOpen (ψ.hom f)
    change ((Scheme.ΓSpecIso R).inv ≫ (AlgebraicGeometry.Spec R).presheaf.map (homOfLE le_top).op ≫
        (AlgebraicGeometry.Spec.map ψ).appLE D_R D_S h).hom r =
      (ψ ≫ (Scheme.ΓSpecIso S).inv ≫ (AlgebraicGeometry.Spec S).presheaf.map (homOfLE le_top).op).hom r
    have hnat1 := (AlgebraicGeometry.Spec.map ψ).c.naturality (homOfLE (le_top : D_R ≤ ⊤)).op
    have hnat : (AlgebraicGeometry.Spec R).presheaf.map (homOfLE (le_top : D_R ≤ ⊤)).op ≫
        (AlgebraicGeometry.Spec.map ψ).appLE D_R D_S h =
      (AlgebraicGeometry.Spec.map ψ).appTop ≫
        (AlgebraicGeometry.Spec S).presheaf.map (homOfLE (le_top : D_S ≤ ⊤)).op := by
      dsimp [Scheme.Hom.appLE, Scheme.Hom.appTop]; rw [← Category.assoc]
      change ((AlgebraicGeometry.Spec R).toLocallyRingedSpace.presheaf.map
          (homOfLE (le_top : D_R ≤ ⊤)).op ≫
          (AlgebraicGeometry.Spec.map ψ).c.app (Opposite.op D_R)) ≫
          (AlgebraicGeometry.Spec S).presheaf.map (homOfLE h).op = _
      rw [hnat1, Category.assoc]; congr 1
    rw [hnat, Scheme.ΓSpecIso_inv_naturality_assoc]
  have hinj_φ1 : Function.Injective φ₁.hom :=
    fun _ _ h => hinj_L0 (by rw [← hf10_ap, ← hf10_ap, h])
  have hinj_φ2 : Function.Injective φ₂.hom :=
    fun _ _ h => hinj_L0 (by rw [← hf20_ap, ← hf20_ap, h])
  have hBasicBij : ∀ f : R₀, Function.Bijective (π_U.app (PrimeSpectrum.basicOpen f)).hom := by
    intro f
    by_cases hf : f = 0
    · subst hf
      have hbot0 : PrimeSpectrum.basicOpen (0 : R₀) = ⊥ := PrimeSpectrum.basicOpen_zero
      rw [hbot0]
      refine ⟨fun a b _ => ?_, fun y => ⟨0, ?_⟩⟩
      · exact TopCat.Sheaf.eq_of_locally_eq' (AlgebraicGeometry.Spec R₀).sheaf
          (fun _ : PEmpty.{u + 1} => ⊥) ⊥ (fun i => i.elim) (fun _ hx => False.elim hx) a b (fun i => i.elim)
      · exact TopCat.Sheaf.eq_of_locally_eq' U_tilde.sheaf
          (fun _ : PEmpty.{u + 1} => ⊥) ((TopologicalSpace.Opens.map π_U.base).obj ⊥)
          (fun i => i.elim) (fun _ hx => False.elim hx) _ y (fun i => i.elim)
    · let D₀ : (AlgebraicGeometry.Spec R₀).Opens := PrimeSpectrum.basicOpen f
      let W_f : U_tilde.Opens := (TopologicalSpace.Opens.map π_U.base).obj D₀
      let D₁ : (AlgebraicGeometry.Spec R₁).Opens := PrimeSpectrum.basicOpen (φ₁.hom f)
      let D₂ : (AlgebraicGeometry.Spec R₂).Opens := PrimeSpectrum.basicOpen (φ₂.hom f)
      let D_L : (AlgebraicGeometry.Spec L₀).Opens := PrimeSpectrum.basicOpen (ι_L0.hom f)
      let Γ₀ : Type u := ↑((AlgebraicGeometry.Spec.structureSheaf ↥R₀).obj.obj (Opposite.op D₀))
      let Γ₁ : Type u := ↑((AlgebraicGeometry.Spec.structureSheaf ↥R₁).obj.obj (Opposite.op D₁))
      let Γ₂ : Type u := ↑((AlgebraicGeometry.Spec.structureSheaf ↥R₂).obj.obj (Opposite.op D₂))
      let Γ_L : Type u := ↑((AlgebraicGeometry.Spec.structureSheaf ↥L₀).obj.obj (Opposite.op D_L))
      have : IsLocalization.Away f Γ₀ := AlgebraicGeometry.StructureSheaf.IsLocalization.to_basicOpen ↥R₀ f
      have : IsLocalization.Away (φ₁.hom f) Γ₁ := AlgebraicGeometry.StructureSheaf.IsLocalization.to_basicOpen ↥R₁ (φ₁.hom f)
      have : IsLocalization.Away (φ₂.hom f) Γ₂ := AlgebraicGeometry.StructureSheaf.IsLocalization.to_basicOpen ↥R₂ (φ₂.hom f)
      have : IsLocalization.Away (ι_L0.hom f) Γ_L := AlgebraicGeometry.StructureSheaf.IsLocalization.to_basicOpen ↥L₀ (ι_L0.hom f)
      have hf1_ne : φ₁.hom f ≠ 0 := fun h => hf (hinj_φ1 (h.trans (map_zero _).symm))
      have hf2_ne : φ₂.hom f ≠ 0 := fun h => hf (hinj_φ2 (h.trans (map_zero _).symm))
      have hfL_ne : ι_L0.hom f ≠ 0 := fun h => hf (hinj_L0 (h.trans (map_zero _).symm))
      let τ₀ : ↥R₀ →+* Γ₀ := algebraMap ↥R₀ Γ₀
      let τ₁ : ↥R₁ →+* Γ₁ := algebraMap ↥R₁ Γ₁
      let τ₂ : ↥R₂ →+* Γ₂ := algebraMap ↥R₂ Γ₂
      let τ_L : ↥L₀ →+* Γ_L := algebraMap ↥L₀ Γ_L
      have hinj_τ₁ : Function.Injective τ₁ :=
        IsLocalization.injective Γ₁ (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf1_ne))
      have hinj_τ_L : Function.Injective τ_L :=
        IsLocalization.injective Γ_L (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hfL_ne))
      have hD₁_eq : (TopologicalSpace.Opens.map ι_U1.base).obj W_f = D₁ := by
        change (TopologicalSpace.Opens.map (ι_U1 ≫ π_U).base).obj D₀ = D₁
        rw [hι1_π]; exact AlgebraicGeometry.SpecMap_preimage_basicOpen φ₁ f
      have hD₂_eq : (TopologicalSpace.Opens.map ι_U2.base).obj W_f = D₂ := by
        change (TopologicalSpace.Opens.map (ι_U2 ≫ π_U).base).obj D₀ = D₂
        rw [hι2_π]; exact AlgebraicGeometry.SpecMap_preimage_basicOpen φ₂ f
      have hD₁_le : D₁ ≤ (TopologicalSpace.Opens.map ι_U1.base).obj W_f := le_of_eq hD₁_eq.symm
      have hD₂_le : D₂ ≤ (TopologicalSpace.Opens.map ι_U2.base).obj W_f := le_of_eq hD₂_eq.symm
      have hD₁_D₀ : D₁ ≤ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map φ₁).base).obj D₀ :=
        le_of_eq (AlgebraicGeometry.SpecMap_preimage_basicOpen φ₁ f).symm
      have hD₂_D₀ : D₂ ≤ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map φ₂).base).obj D₀ :=
        le_of_eq (AlgebraicGeometry.SpecMap_preimage_basicOpen φ₂ f).symm
      have hf1_L : ι_L1.hom (φ₁.hom f) = ι_L0.hom f := hf10_ap f
      have hf2_L : ι_L2.hom (φ₂.hom f) = ι_L0.hom f := hf20_ap f
      have hDL_D₁ : D_L ≤ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map ι_L1).base).obj D₁ := by
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen]
        exact le_of_eq (congrArg PrimeSpectrum.basicOpen hf1_L.symm)
      have hDL_D₂ : D_L ≤ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map ι_L2).base).obj D₂ := by
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen]
        exact le_of_eq (congrArg PrimeSpectrum.basicOpen hf2_L.symm)
      have hcomp_π1 : π_U.app D₀ ≫ ι_U1.appLE W_f D₁ hD₁_le =
          (AlgebraicGeometry.Spec.map φ₁).appLE D₀ D₁ hD₁_D₀ := by
        rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]; congr 1
      have hcomp_π2 : π_U.app D₀ ≫ ι_U2.appLE W_f D₂ hD₂_le =
          (AlgebraicGeometry.Spec.map φ₂).appLE D₀ D₂ hD₂_D₀ := by
        rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]; congr 1
      refine ⟨?_, ?_⟩
      · rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
        intro s₀ hs₀; rw [RingHom.mem_ker] at hs₀
        let s₀_Γ : Γ₀ := s₀
        obtain ⟨⟨a, _, k, rfl⟩, hs₀_eq⟩ := IsLocalization.surj (Submonoid.powers f) s₀_Γ
        dsimp only at hs₀_eq
        have hmap1 := congrArg ((ι_U1.appLE W_f D₁ hD₁_le).hom) hs₀
        rw [map_zero] at hmap1
        have hψ1_s0 : (((AlgebraicGeometry.Spec.map φ₁).appLE D₀ D₁ hD₁_D₀).hom s₀) = 0 := by
          rw [← hcomp_π1]; exact hmap1
        have hτ1_a : τ₁ (φ₁.hom a) = 0 := by
          let ψ₁ : Γ₀ →+* Γ₁ := ((AlgebraicGeometry.Spec.map φ₁).appLE D₀ D₁ hD₁_D₀).hom
          have h1 : ψ₁ (s₀_Γ * τ₀ (f ^ k)) = ψ₁ (τ₀ a) := congrArg ψ₁ hs₀_eq
          rw [map_mul] at h1
          have h0 : ψ₁ s₀_Γ = 0 := hψ1_s0
          rw [h0, zero_mul] at h1
          exact (hSpecAppAlg φ₁ f (φ₁.hom f) rfl hD₁_D₀ a).symm.trans h1.symm
        have ha0 : a = 0 :=
          hinj_φ1 (hinj_τ₁ (hτ1_a.trans (map_zero τ₁).symm) |>.trans (map_zero φ₁.hom).symm)
        rw [ha0, map_zero] at hs₀_eq
        have hu_fk : IsUnit (τ₀ (f ^ k)) :=
          IsLocalization.map_units Γ₀ (⟨f ^ k, k, rfl⟩ : Submonoid.powers f)
        exact hu_fk.mul_left_eq_zero.mp hs₀_eq
      · intro s_tilde
        let s₁_sec : Γ₁ := (ι_U1.appLE W_f D₁ hD₁_le).hom s_tilde
        let s₂_sec : Γ₂ := (ι_U2.appLE W_f D₂ hD₂_le).hom s_tilde
        obtain ⟨⟨x₁, _, k₁, rfl⟩, hx₁⟩ := IsLocalization.surj (Submonoid.powers (φ₁.hom f)) s₁_sec
        obtain ⟨⟨x₂, _, k₂, rfl⟩, hx₂⟩ := IsLocalization.surj (Submonoid.powers (φ₂.hom f)) s₂_sec
        dsimp only at hx₁ hx₂
        let ψ_L1 : Γ₁ →+* Γ_L := ((AlgebraicGeometry.Spec.map ι_L1).appLE D₁ D_L hDL_D₁).hom
        let ψ_L2 : Γ₂ →+* Γ_L := ((AlgebraicGeometry.Spec.map ι_L2).appLE D₂ D_L hDL_D₂).hom
        have hL_sec : ψ_L1 s₁_sec = ψ_L2 s₂_sec := by
          have hcompL : ι_U1.appLE W_f D₁ hD₁_le ≫ (AlgebraicGeometry.Spec.map ι_L1).appLE D₁ D_L hDL_D₁ =
              ι_U2.appLE W_f D₂ hD₂_le ≫ (AlgebraicGeometry.Spec.map ι_L2).appLE D₂ D_L hDL_D₂ := by
            rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]; congr 1
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcompL) s_tilde
        have hψL1_alg : ∀ r₁ : R₁, ψ_L1 (τ₁ r₁) = τ_L (ι_L1.hom r₁) :=
          fun r₁ => hSpecAppAlg ι_L1 (φ₁.hom f) (ι_L0.hom f) hf1_L.symm hDL_D₁ r₁
        have hψL2_alg : ∀ r₂ : R₂, ψ_L2 (τ₂ r₂) = τ_L (ι_L2.hom r₂) :=
          fun r₂ => hSpecAppAlg ι_L2 (φ₂.hom f) (ι_L0.hom f) hf2_L.symm hDL_D₂ r₂
        have hL_cross : ι_L1.hom x₁ * (ι_L0.hom f) ^ k₂ = ι_L2.hom x₂ * (ι_L0.hom f) ^ k₁ := by
          apply hinj_τ_L
          have heq1 : ψ_L1 (s₁_sec * τ₁ ((φ₁.hom f) ^ k₁)) = ψ_L1 (τ₁ x₁) := congrArg ψ_L1 hx₁
          rw [map_mul, hψL1_alg, hψL1_alg, map_pow, hf1_L] at heq1
          have heq2 : ψ_L2 (s₂_sec * τ₂ ((φ₂.hom f) ^ k₂)) = ψ_L2 (τ₂ x₂) := congrArg ψ_L2 hx₂
          rw [map_mul, hψL2_alg, hψL2_alg, map_pow, hf2_L] at heq2
          calc τ_L (ι_L1.hom x₁ * (ι_L0.hom f) ^ k₂)
              = (ψ_L1 s₁_sec * τ_L ((ι_L0.hom f) ^ k₁)) * τ_L ((ι_L0.hom f) ^ k₂) := by
                  rw [map_mul, ← heq1]
            _ = (ψ_L2 s₂_sec * τ_L ((ι_L0.hom f) ^ k₂)) * τ_L ((ι_L0.hom f) ^ k₁) := by
                  rw [hL_sec]; ring
            _ = τ_L (ι_L2.hom x₂ * (ι_L0.hom f) ^ k₁) := by rw [heq2, ← map_mul]
        obtain ⟨a₀, m, ha₀_1⟩ := hInter f hf x₁ x₂ k₁ k₂ hL_cross
        have ha₀_2 : ι_L0.hom a₀ * (ι_L0.hom f) ^ k₂ = ι_L2.hom x₂ * (ι_L0.hom f) ^ m := by
          apply mul_right_cancel₀ (pow_ne_zero k₁ hfL_ne)
          calc (ι_L0.hom a₀ * (ι_L0.hom f) ^ k₂) * (ι_L0.hom f) ^ k₁
              = (ι_L0.hom a₀ * (ι_L0.hom f) ^ k₁) * (ι_L0.hom f) ^ k₂ := by ring
            _ = (ι_L1.hom x₁ * (ι_L0.hom f) ^ k₂) * (ι_L0.hom f) ^ m := by rw [ha₀_1]; ring
            _ = (ι_L2.hom x₂ * (ι_L0.hom f) ^ m) * (ι_L0.hom f) ^ k₁ := by rw [hL_cross]; ring
        have hR1_eq : φ₁.hom a₀ * (φ₁.hom f) ^ k₁ = x₁ * (φ₁.hom f) ^ m := by
          apply hinj_L1; simp only [map_mul, map_pow, hf1_L, hf10_ap, ha₀_1]
        have hR2_eq : φ₂.hom a₀ * (φ₂.hom f) ^ k₂ = x₂ * (φ₂.hom f) ^ m := by
          apply hinj_L2; simp only [map_mul, map_pow, hf2_L, hf20_ap, ha₀_2]
        let pow_fm : Submonoid.powers f := ⟨f ^ m, m, rfl⟩
        let s₀ : Γ₀ := IsLocalization.mk' Γ₀ a₀ pow_fm
        have hs₀_spec : s₀ * τ₀ (f ^ m) = τ₀ a₀ := IsLocalization.mk'_spec Γ₀ a₀ pow_fm
        have hs₀_1 : (ι_U1.appLE W_f D₁ hD₁_le).hom ((π_U.app D₀).hom s₀) = s₁_sec := by
          change ((π_U.app D₀ ≫ ι_U1.appLE W_f D₁ hD₁_le).hom s₀) = s₁_sec; rw [hcomp_π1]
          let ψ₁ : Γ₀ →+* Γ₁ := ((AlgebraicGeometry.Spec.map φ₁).appLE D₀ D₁ hD₁_D₀).hom
          have h1 : ψ₁ (s₀ * τ₀ (f ^ m)) = ψ₁ (τ₀ a₀) := congrArg ψ₁ hs₀_spec
          rw [map_mul] at h1
          have h1_fm : ψ₁ (τ₀ (f ^ m)) = τ₁ ((φ₁.hom f) ^ m) :=
            (hSpecAppAlg φ₁ f (φ₁.hom f) rfl hD₁_D₀ (f ^ m)).trans (congrArg τ₁ (map_pow φ₁.hom f m))
          have h1_a0 : ψ₁ (τ₀ a₀) = τ₁ (φ₁.hom a₀) :=
            hSpecAppAlg φ₁ f (φ₁.hom f) rfl hD₁_D₀ a₀
          rw [h1_fm, h1_a0] at h1
          have hu_m : IsUnit (τ₁ ((φ₁.hom f) ^ m)) :=
            IsLocalization.map_units Γ₁ (⟨(φ₁.hom f) ^ m, m, rfl⟩ : Submonoid.powers (φ₁.hom f))
          have hu_k1 : IsUnit (τ₁ ((φ₁.hom f) ^ k₁)) :=
            IsLocalization.map_units Γ₁ (⟨(φ₁.hom f) ^ k₁, k₁, rfl⟩ : Submonoid.powers (φ₁.hom f))
          apply (hu_m.mul hu_k1).mul_left_inj.mp
          calc ψ₁ s₀ * (τ₁ ((φ₁.hom f) ^ m) * τ₁ ((φ₁.hom f) ^ k₁))
              = (ψ₁ s₀ * τ₁ ((φ₁.hom f) ^ m)) * τ₁ ((φ₁.hom f) ^ k₁) := by ring
            _ = τ₁ (φ₁.hom a₀ * (φ₁.hom f) ^ k₁) := by rw [h1, ← map_mul]
            _ = τ₁ (x₁ * (φ₁.hom f) ^ m) := by rw [hR1_eq]
            _ = (s₁_sec * τ₁ ((φ₁.hom f) ^ k₁)) * τ₁ ((φ₁.hom f) ^ m) := by rw [map_mul]; rw [← hx₁]
            _ = s₁_sec * (τ₁ ((φ₁.hom f) ^ m) * τ₁ ((φ₁.hom f) ^ k₁)) := by ring
        have hs₀_2 : (ι_U2.appLE W_f D₂ hD₂_le).hom ((π_U.app D₀).hom s₀) = s₂_sec := by
          change ((π_U.app D₀ ≫ ι_U2.appLE W_f D₂ hD₂_le).hom s₀) = s₂_sec; rw [hcomp_π2]
          let ψ₂ : Γ₀ →+* Γ₂ := ((AlgebraicGeometry.Spec.map φ₂).appLE D₀ D₂ hD₂_D₀).hom
          have h2 : ψ₂ (s₀ * τ₀ (f ^ m)) = ψ₂ (τ₀ a₀) := congrArg ψ₂ hs₀_spec
          rw [map_mul] at h2
          have h2_fm : ψ₂ (τ₀ (f ^ m)) = τ₂ ((φ₂.hom f) ^ m) :=
            (hSpecAppAlg φ₂ f (φ₂.hom f) rfl hD₂_D₀ (f ^ m)).trans (congrArg τ₂ (map_pow φ₂.hom f m))
          have h2_a0 : ψ₂ (τ₀ a₀) = τ₂ (φ₂.hom a₀) :=
            hSpecAppAlg φ₂ f (φ₂.hom f) rfl hD₂_D₀ a₀
          rw [h2_fm, h2_a0] at h2
          have hu_m : IsUnit (τ₂ ((φ₂.hom f) ^ m)) :=
            IsLocalization.map_units Γ₂ (⟨(φ₂.hom f) ^ m, m, rfl⟩ : Submonoid.powers (φ₂.hom f))
          have hu_k2 : IsUnit (τ₂ ((φ₂.hom f) ^ k₂)) :=
            IsLocalization.map_units Γ₂ (⟨(φ₂.hom f) ^ k₂, k₂, rfl⟩ : Submonoid.powers (φ₂.hom f))
          apply (hu_m.mul hu_k2).mul_left_inj.mp
          calc ψ₂ s₀ * (τ₂ ((φ₂.hom f) ^ m) * τ₂ ((φ₂.hom f) ^ k₂))
              = (ψ₂ s₀ * τ₂ ((φ₂.hom f) ^ m)) * τ₂ ((φ₂.hom f) ^ k₂) := by ring
            _ = τ₂ (φ₂.hom a₀ * (φ₂.hom f) ^ k₂) := by rw [h2, ← map_mul]
            _ = τ₂ (x₂ * (φ₂.hom f) ^ m) := by rw [hR2_eq]
            _ = (s₂_sec * τ₂ ((φ₂.hom f) ^ k₂)) * τ₂ ((φ₂.hom f) ^ m) := by rw [map_mul]; rw [← hx₂]
            _ = s₂_sec * (τ₂ ((φ₂.hom f) ^ m) * τ₂ ((φ₂.hom f) ^ k₂)) := by ring
        refine ⟨s₀, hJointInj W_f ((π_U.app D₀).hom s₀) s_tilde ?_ ?_⟩
        · have hres_id1 : (AlgebraicGeometry.Spec R₁).presheaf.map
              (homOfLE hD₁_le).op ≫ (AlgebraicGeometry.Spec R₁).presheaf.map
              (homOfLE (le_of_eq hD₁_eq)).op = 𝟙 _ := by
            rw [← (AlgebraicGeometry.Spec R₁).presheaf.map_comp, ← op_comp]
            exact CategoryTheory.Functor.map_id _ _
          have heq1 := congrArg (((AlgebraicGeometry.Spec R₁).presheaf.map (homOfLE (le_of_eq hD₁_eq)).op).hom) hs₀_1
          have h1L : (((AlgebraicGeometry.Spec R₁).presheaf.map (homOfLE (le_of_eq hD₁_eq)).op).hom)
              ((ι_U1.appLE W_f D₁ hD₁_le).hom ((π_U.app D₀).hom s₀)) =
              (ι_U1.app W_f).hom ((π_U.app D₀).hom s₀) := by
            change ((ι_U1.app W_f ≫ ((AlgebraicGeometry.Spec R₁).presheaf.map (homOfLE hD₁_le).op ≫
              (AlgebraicGeometry.Spec R₁).presheaf.map (homOfLE (le_of_eq hD₁_eq)).op)).hom _) = _
            rw [hres_id1]; rfl
          have h1R : (((AlgebraicGeometry.Spec R₁).presheaf.map (homOfLE (le_of_eq hD₁_eq)).op).hom) s₁_sec =
              (ι_U1.app W_f).hom s_tilde := by
            change ((ι_U1.app W_f ≫ ((AlgebraicGeometry.Spec R₁).presheaf.map (homOfLE hD₁_le).op ≫
              (AlgebraicGeometry.Spec R₁).presheaf.map (homOfLE (le_of_eq hD₁_eq)).op)).hom _) = _
            rw [hres_id1]; rfl
          exact h1L.symm.trans (heq1.trans h1R)
        · have hres_id2 : (AlgebraicGeometry.Spec R₂).presheaf.map
              (homOfLE hD₂_le).op ≫ (AlgebraicGeometry.Spec R₂).presheaf.map
              (homOfLE (le_of_eq hD₂_eq)).op = 𝟙 _ := by
            rw [← (AlgebraicGeometry.Spec R₂).presheaf.map_comp, ← op_comp]
            exact CategoryTheory.Functor.map_id _ _
          have heq2 := congrArg (((AlgebraicGeometry.Spec R₂).presheaf.map (homOfLE (le_of_eq hD₂_eq)).op).hom) hs₀_2
          have h2L : (((AlgebraicGeometry.Spec R₂).presheaf.map (homOfLE (le_of_eq hD₂_eq)).op).hom)
              ((ι_U2.appLE W_f D₂ hD₂_le).hom ((π_U.app D₀).hom s₀)) =
              (ι_U2.app W_f).hom ((π_U.app D₀).hom s₀) := by
            change ((ι_U2.app W_f ≫ ((AlgebraicGeometry.Spec R₂).presheaf.map (homOfLE hD₂_le).op ≫
              (AlgebraicGeometry.Spec R₂).presheaf.map (homOfLE (le_of_eq hD₂_eq)).op)).hom _) = _
            rw [hres_id2]; rfl
          have h2R : (((AlgebraicGeometry.Spec R₂).presheaf.map (homOfLE (le_of_eq hD₂_eq)).op).hom) s₂_sec =
              (ι_U2.app W_f).hom s_tilde := by
            change ((ι_U2.app W_f ≫ ((AlgebraicGeometry.Spec R₂).presheaf.map (homOfLE hD₂_le).op ≫
              (AlgebraicGeometry.Spec R₂).presheaf.map (homOfLE (le_of_eq hD₂_eq)).op)).hom _) = _
            rw [hres_id2]; rfl
          exact h2L.symm.trans (heq2.trans h2R)

  have hAppIso : ∀ V : (AlgebraicGeometry.Spec R₀).Opens, CategoryTheory.IsIso (π_U.app V) := by
    intro V
    rw [CategoryTheory.ConcreteCategory.isIso_iff_bijective]
    let ι := {f : R₀ // PrimeSpectrum.basicOpen f ≤ V}
    let U : ι → (AlgebraicGeometry.Spec R₀).Opens := fun i => PrimeSpectrum.basicOpen i.1
    let iUV : ∀ i : ι, U i ⟶ V := fun i => homOfLE i.2
    have hV_le : V ≤ iSup U := by
      intro p hp
      obtain ⟨B, ⟨f, rfl⟩, hpB, hBV⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hp
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hBV⟩, hpB⟩
    let U_tilde_fam : ι → U_tilde.Opens := fun i => (TopologicalSpace.Opens.map π_U.base).obj (U i)
    let V_tilde : U_tilde.Opens := (TopologicalSpace.Opens.map π_U.base).obj V
    let iUV_tilde : ∀ i : ι, U_tilde_fam i ⟶ V_tilde :=
      fun i => (TopologicalSpace.Opens.map π_U.base).map (iUV i)
    have hVtilde_le : V_tilde ≤ iSup U_tilde_fam := by
      intro x hx
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hV_le hx)
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
    refine ⟨?_, ?_⟩
    · intro a b hab
      apply TopCat.Sheaf.eq_of_locally_eq' (AlgebraicGeometry.Spec R₀).sheaf U V iUV hV_le a b
      intro i; apply (hBasicBij i.1).1
      have hnat := π_U.naturality (iUV i).op
      have hna := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hnat) a
      have hnb := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hnat) b
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hna hnb
      exact hna.trans ((congrArg ((U_tilde.presheaf.map (iUV_tilde i).op).hom) hab).trans hnb.symm)
    · intro s_tilde
      choose sf hsf using fun i : ι =>
        (hBasicBij i.1).2 ((U_tilde.presheaf.map (iUV_tilde i).op).hom s_tilde)
      have hCompat : TopCat.Presheaf.IsCompatible (AlgebraicGeometry.Spec R₀).presheaf U sf := by
        intro i j
        have hinj_ij : Function.Injective (π_U.app (U i ⊓ U j)).hom := by
          have hmul : U i ⊓ U j = PrimeSpectrum.basicOpen (i.1 * j.1) :=
            (PrimeSpectrum.basicOpen_mul i.1 j.1).symm
          rw [hmul]; exact (hBasicBij (i.1 * j.1)).1
        apply hinj_ij
        have hnat_i := π_U.naturality (TopologicalSpace.Opens.infLELeft (U i) (U j)).op
        have hnat_j := π_U.naturality (TopologicalSpace.Opens.infLERight (U i) (U j)).op
        have hi_eq := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hnat_i) (sf i)
        have hj_eq := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hnat_j) (sf j)
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hi_eq hj_eq
        exact hi_eq.trans ((congrArg _ (hsf i)).trans
          ((by
            change ((U_tilde.presheaf.map (iUV_tilde i).op ≫ U_tilde.presheaf.map _).hom s_tilde) =
              ((U_tilde.presheaf.map (iUV_tilde j).op ≫ U_tilde.presheaf.map _).hom s_tilde)
            rw [← U_tilde.presheaf.map_comp, ← U_tilde.presheaf.map_comp, ← op_comp, ← op_comp]
            rfl : _ = _).trans
            ((congrArg _ (hsf j).symm).trans hj_eq.symm)))
      obtain ⟨s, hs, _⟩ :=
        TopCat.Sheaf.existsUnique_gluing' (AlgebraicGeometry.Spec R₀).sheaf U V iUV hV_le sf hCompat
      refine ⟨s, ?_⟩
      apply TopCat.Sheaf.eq_of_locally_eq' U_tilde.sheaf U_tilde_fam V_tilde iUV_tilde hVtilde_le
      intro i
      have hnat := π_U.naturality (iUV i).op
      have hns := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hnat) s
      simp only [CommRingCat.hom_comp] at hns
      exact hns.symm.trans ((congrArg ((π_U.app (U i)).hom) (hs i)).trans (hsf i))

  refine ⟨U_tilde, π_U, ι_U1, ι_U2, Φ_U, η_P1,
    hIntU, hIntP1, hFlat_g, hLFP_g, hProp_π, hSurj_π, hIso_off, hAppIso,
    hOpen₁, hOpen₂, hCov_range, hι1_π, hι2_π, hOv_img,
    hCl_ΦU, hPB_ΦU.w, hRange_ΦU, hGen_P1, hΦ_η_eq, hTwoPts⟩

theorem weil_nc2d_blowup_gluing_sections_and_exceptional (Ω : Type u) [Field Ω] (n : ℕ)
    (W U_tilde : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (q₀ : ↥(CategoryTheory.Limits.pullback g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (R₀ R₁ R₂ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (ι₀ : AlgebraicGeometry.Spec R₀ ⟶ W)
    (z₁ z₂ : R₀) (φ_res : R₀ →+* Ω)
    (φ₁ : R₀ ⟶ R₁) (φ₂ : R₀ ⟶ R₂) (s₁ : R₁) (s₂ : R₂)
    (q_exc : AlgebraicGeometry.Spec R₁)
    (π_U : U_tilde ⟶ AlgebraicGeometry.Spec R₀)
    (ι_U1 : AlgebraicGeometry.Spec R₁ ⟶ U_tilde)
    (ι_U2 : AlgebraicGeometry.Spec R₂ ⟶ U_tilde)
    (Φ_U : (weilProjectiveSpaceOver Ω 1).left ⟶ U_tilde)
    (η_P1 : ↥(weilProjectiveSpaceOver Ω 1).left)
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hq₀ : IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))))
    (hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι₀)
    (hp₀_w₀ : ι₀.base p₀ = (CategoryTheory.Limits.pullback.fst g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))).base q₀)
    (hDom₀ : IsDomain R₀) (hDom₁ : IsDomain R₁) (hDom₂ : IsDomain R₂)
    (hp₀_span : p₀.asIdeal = Ideal.span ({z₁, z₂} : Set R₀))
    (hZero_p₀ : PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀) = {p₀})
    (hres_const : φ_res.comp (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom =
      (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    (hres : ∀ r : R₀, ∃ c : Ω,
      r - (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom (PowerSeries.C c) ∈ p₀.asIdeal)
    (hX1_ne : φ₁.hom ((AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom PowerSeries.X) ≠ 0)
    (hz1_ne : φ₁.hom z₁ ≠ 0)
    (hrel1 : φ₁.hom z₂ = φ₁.hom z₁ * s₁)
    (hz2_ne : φ₂.hom z₂ ≠ 0)
    (hrel2 : φ₂.hom z₁ = φ₂.hom z₂ * s₂)
    (hq_exc_id : q_exc.asIdeal = Ideal.span ({φ₁.hom z₁} : Set R₁))
    (hq_exc_not : ∀ c : Ω,
      s₁ - φ₁.hom ((AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom (PowerSeries.C c)) ∉
        q_exc.asIdeal)
    (hAffBl : IsNC2DAffineBlowupModel Ω R₀ R₁ R₂ p₀ (ι₀ ≫ g_W) φ_res φ₁ φ₂ s₁ s₂ q_exc
      π_U ι_U1 ι_U2 Φ_U η_P1) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∃ (W' : AlgebraicGeometry.Scheme.{u})
      (g_W' : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_W' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W'))
      (π : W' ⟶ W)
      (E_exc : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω))
      (η_exc : ↥(CategoryTheory.Limits.pullback g_W' s_Ω))
      (ι_exc : (weilProjectiveSpaceOver Ω 1).left ⟶ CategoryTheory.Limits.pullback g_W' s_Ω)
      (ι₁ : AlgebraicGeometry.Spec R₁ ⟶ W')
      (ι₂ : AlgebraicGeometry.Spec R₂ ⟶ W'),
      IsNC2DGluedBlowupGeom Ω n g_W τ_W g_W' τ_W' q₀ π E_exc η_exc ι_exc
        R₀ R₁ R₂ p₀ ι₀ ι₁ ι₂ φ₁ φ₂ z₁ z₂ s₁ s₂ q_exc :=
by
  classical
  have part1_patching :
      ∀ (W U_tilde : AlgebraicGeometry.Scheme.{u})
        (R₀ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
        (w₀ : ↥W)
        (ι₀ : AlgebraicGeometry.Spec R₀ ⟶ W)
        (π_U : U_tilde ⟶ AlgebraicGeometry.Spec R₀)
        (hw₀_cl : IsClosed ({w₀} : Set ↥W)),
        AlgebraicGeometry.IsOpenImmersion ι₀ →
        ι₀.base p₀ = w₀ →
        PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀) = {p₀} →
        AlgebraicGeometry.IsProper π_U →
        AlgebraicGeometry.Surjective π_U →
        CategoryTheory.IsIso
          (π_U ∣_ ⟨(PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀))ᶜ,
            (PrimeSpectrum.isClosed_zeroLocus (p₀.asIdeal : Set R₀)).isOpen_compl⟩) →
        (∀ V : (AlgebraicGeometry.Spec R₀).Opens, CategoryTheory.IsIso (π_U.app V)) →
        let W_compl : W.Opens := ⟨({w₀} : Set ↥W)ᶜ, hw₀_cl.isOpen_compl⟩
        ∃ (W' : AlgebraicGeometry.Scheme.{u})
          (ι_tilde : U_tilde ⟶ W')
          (ι_compl : W_compl.toScheme ⟶ W')
          (π : W' ⟶ W),
          AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
          AlgebraicGeometry.IsOpenImmersion ι_compl ∧
          Set.range ι_tilde.base ∪ Set.range ι_compl.base = Set.univ ∧
          ι_tilde ≫ π = π_U ≫ ι₀ ∧
          ι_compl ≫ π = W_compl.ι ∧
          π.base ⁻¹' (Set.range ι₀.base) = Set.range ι_tilde.base ∧
          π.base ⁻¹' (W_compl : Set ↥W) = Set.range ι_compl.base ∧
          CategoryTheory.IsPullback π_U ι_tilde ι₀ π ∧
          CategoryTheory.IsPullback (𝟙 W_compl.toScheme) ι_compl W_compl.ι π ∧
          AlgebraicGeometry.IsProper π ∧
          AlgebraicGeometry.Surjective π ∧
          (∀ U : W.Opens, w₀ ∉ (U : Set ↥W) → CategoryTheory.IsIso (π ∣_ U)) ∧
          (∀ U : W.Opens, CategoryTheory.IsIso (π.app U)) := by
    intro W U_tilde R₀ p₀ w₀ ι₀ π_U hw₀_cl hOpen₀ hp₀_w₀ hZero_p₀ hProp_U hSurj_U
      hIso_U_off hApp_U W_compl
    let U_off : (AlgebraicGeometry.Spec R₀).Opens :=
      ⟨(PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (p₀.asIdeal : Set R₀)).isOpen_compl⟩
    have h_mem_Uoff : ∀ p : AlgebraicGeometry.Spec R₀,
        p ∈ U_off ↔ ι₀.base p ∈ W_compl := by
      intro p
      let p' : PrimeSpectrum R₀ := p
      let p₀' : PrimeSpectrum R₀ := p₀
      have hZ' : PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀) = {p₀'} := hZero_p₀
      change p' ∉ PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀) ↔ ι₀.base p ≠ w₀
      rw [hZ', Set.mem_singleton_iff]
      change p ≠ p₀ ↔ ι₀.base p ≠ w₀
      rw [← hp₀_w₀]
      exact not_congr ι₀.isOpenEmbedding.injective.eq_iff.symm
    have h_sub_j1 : Set.range (U_off.ι ≫ ι₀).base ⊆ Set.range W_compl.ι.base := by
      rintro _ ⟨u, rfl⟩
      exact ⟨⟨ι₀.base u.1, (h_mem_Uoff u.1).mp u.2⟩, rfl⟩
    let j₁ : U_off.toScheme ⟶ W_compl.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W_compl.ι (U_off.ι ≫ ι₀) h_sub_j1
    have hj₁_fac : j₁ ≫ W_compl.ι = U_off.ι ≫ ι₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_compl.ι (U_off.ι ≫ ι₀) h_sub_j1
    have hOpen_j₁ : AlgebraicGeometry.IsOpenImmersion j₁ := by
      have : AlgebraicGeometry.IsOpenImmersion (j₁ ≫ W_compl.ι) := by
        rw [hj₁_fac]; infer_instance
      exact AlgebraicGeometry.IsOpenImmersion.of_comp j₁ W_compl.ι
    have hRange_j1 : ∀ x : ↥W_compl.toScheme,
        x.1 ∈ Set.range ι₀.base → x ∈ Set.range j₁.base := by
      rintro x ⟨p, hp⟩
      have hp_off : p ∈ U_off := (h_mem_Uoff p).mpr (hp.symm ▸ x.2)
      refine ⟨⟨p, hp_off⟩, W_compl.ι.isOpenEmbedding.injective ?_⟩
      change (j₁ ≫ W_compl.ι).base ⟨p, hp_off⟩ = W_compl.ι.base x
      rw [hj₁_fac]
      exact hp
    let U_tilde_off : U_tilde.Opens := (TopologicalSpace.Opens.map π_U.base).obj U_off
    let V_01 : AlgebraicGeometry.Scheme.{u} := U_tilde_off.toScheme
    let f₀ : V_01 ⟶ U_tilde := U_tilde_off.ι
    let f₁ : V_01 ⟶ W_compl.toScheme := (π_U ∣_ U_off) ≫ j₁
    have hOpen_f₀ : AlgebraicGeometry.IsOpenImmersion f₀ := inferInstance
    have hOpen_f₁ : AlgebraicGeometry.IsOpenImmersion f₁ := by
      dsimp [f₁]; infer_instance
    have hf₀₁_comm : f₀ ≫ (π_U ≫ ι₀) = f₁ ≫ W_compl.ι := by
      calc f₀ ≫ (π_U ≫ ι₀)
          = (U_tilde_off.ι ≫ π_U) ≫ ι₀ := (Category.assoc _ _ _).symm
        _ = ((π_U ∣_ U_off) ≫ U_off.ι) ≫ ι₀ := by rw [← AlgebraicGeometry.morphismRestrict_ι]
        _ = (π_U ∣_ U_off) ≫ (j₁ ≫ W_compl.ι) := by rw [Category.assoc, hj₁_fac]
        _ = f₁ ≫ W_compl.ι := (Category.assoc _ _ _).symm
    let J : Type u := ULift.{u} Bool
    let U_ch : J → AlgebraicGeometry.Scheme.{u} :=
      fun i => match i with | ⟨false⟩ => U_tilde | ⟨true⟩ => W_compl.toScheme
    let f_ch : ∀ (i j : J) (_ : i ≠ j), V_01 ⟶ U_ch i :=
      fun i j hij =>
        match i, j with
        | ⟨false⟩, ⟨true⟩ => f₀
        | ⟨true⟩, ⟨false⟩ => f₁
        | ⟨false⟩, ⟨false⟩ => (hij rfl).elim
        | ⟨true⟩, ⟨true⟩ => (hij rfl).elim
    have hOpen_fch : ∀ (i j : J) (hij : i ≠ j),
        AlgebraicGeometry.IsOpenImmersion (f_ch i j hij) := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩ hij
      · exact (hij rfl).elim
      · exact hOpen_f₀
      · exact hOpen_f₁
      · exact (hij rfl).elim
    have hMono_fch : ∀ (i j : J) (hij : i ≠ j), CategoryTheory.Mono (f_ch i j hij) := by
      intro i j hij
      have := hOpen_fch i j hij
      infer_instance
    have hFalse3 : ∀ (i j k : J), i ≠ j → i ≠ k → j ≠ k → False := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;> contradiction
    let D' : CategoryTheory.GlueData' AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.GlueData'.mk J U_ch (fun _ _ _ => V_01) f_ch hMono_fch inferInstance
        (fun _ _ _ => 𝟙 V_01)
        (fun i j k hij hik hjk => (hFalse3 i j k hij hik hjk).elim)
        (fun i j k hij hik hjk => (hFalse3 i j k hij hik hjk).elim)
        (fun _ _ _ => Category.id_comp _)
        (fun i j k hij hik hjk => (hFalse3 i j k hij hik hjk).elim)
    let D₀ : CategoryTheory.GlueData AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.GlueData.ofGlueData' D'
    have hOpen_D₀ : ∀ i j : D₀.J, AlgebraicGeometry.IsOpenImmersion (D₀.f i j) := by
      intro i j
      dsimp [D₀, CategoryTheory.GlueData.ofGlueData', CategoryTheory.GlueData'.f']
      split_ifs with hij
      · infer_instance
      · have : AlgebraicGeometry.IsOpenImmersion (D'.f i j hij) := hOpen_fch i j hij
        infer_instance
    let D : AlgebraicGeometry.Scheme.GlueData := AlgebraicGeometry.Scheme.GlueData.mk D₀ hOpen_D₀
    have : Limits.HasMulticoequalizer D.diagram :=
      AlgebraicGeometry.Scheme.GlueData.instHasMulticoequalizerDiagram D
    let W' : AlgebraicGeometry.Scheme.{u} := D.glued
    let ι_tilde : U_tilde ⟶ W' := D.ι ⟨false⟩
    let ι_compl : W_compl.toScheme ⟶ W' := D.ι ⟨true⟩
    have hOpen_tilde : AlgebraicGeometry.IsOpenImmersion ι_tilde :=
      AlgebraicGeometry.Scheme.GlueData.ι_isOpenImmersion D ⟨false⟩
    have hOpen_compl : AlgebraicGeometry.IsOpenImmersion ι_compl :=
      AlgebraicGeometry.Scheme.GlueData.ι_isOpenImmersion D ⟨true⟩
    have h_glue_01 : f₀ ≫ ι_tilde = f₁ ≫ ι_compl := by
      have hne : (⟨false⟩ : J) ≠ ⟨true⟩ := fun h => by cases h
      have hne' : (⟨true⟩ : J) ≠ ⟨false⟩ := fun h => by cases h
      have e01 : D₀.V (⟨false⟩, ⟨true⟩) = V_01 := dite_eq_right_of_eq_false (eq_false hne)
      have e10 : D₀.V (⟨true⟩, ⟨false⟩) = V_01 := dite_eq_right_of_eq_false (eq_false hne')
      have hf01 : D₀.f ⟨false⟩ ⟨true⟩ = eqToHom e01 ≫ f₀ :=
        dite_eq_right_of_eq_false (eq_false hne)
      have hf10 : D₀.f ⟨true⟩ ⟨false⟩ = eqToHom e10 ≫ f₁ :=
        dite_eq_right_of_eq_false (eq_false hne')
      have ht01 : D₀.t ⟨false⟩ ⟨true⟩ = eqToHom e01 ≫ (𝟙 V_01 ≫ eqToHom e10.symm) :=
        dite_eq_right_of_eq_false (eq_false hne)
      have h1 : eqToHom e01 ≫ (f₀ ≫ ι_tilde) = D.f ⟨false⟩ ⟨true⟩ ≫ D.ι ⟨false⟩ :=
        (Category.assoc (eqToHom e01) f₀ ι_tilde).symm.trans (congrArg (· ≫ ι_tilde) hf01.symm)
      have h2 : D.t ⟨false⟩ ⟨true⟩ ≫ D.f ⟨true⟩ ⟨false⟩ ≫ D.ι ⟨true⟩ =
          eqToHom e01 ≫ (f₁ ≫ ι_compl) :=
        calc D₀.t ⟨false⟩ ⟨true⟩ ≫ (D₀.f ⟨true⟩ ⟨false⟩ ≫ ι_compl)
            = (eqToHom e01 ≫ (𝟙 V_01 ≫ eqToHom e10.symm)) ≫ ((eqToHom e10 ≫ f₁) ≫ ι_compl) :=
                congrArg₂ (· ≫ ·) ht01 (congrArg (· ≫ ι_compl) hf10)
          _ = (eqToHom e01 ≫ eqToHom e10.symm) ≫ (eqToHom e10 ≫ (f₁ ≫ ι_compl)) :=
                congrArg₂ (· ≫ ·) (congrArg (eqToHom e01 ≫ ·) (Category.id_comp _))
                  (Category.assoc _ _ _)
          _ = eqToHom e01 ≫ (eqToHom e10.symm ≫ eqToHom e10 ≫ (f₁ ≫ ι_compl)) :=
                Category.assoc _ _ _
          _ = eqToHom e01 ≫ (f₁ ≫ ι_compl) :=
                congrArg (eqToHom e01 ≫ ·)
                  ((eqToHom_trans_assoc e10.symm e10 _).trans
                    ((congrArg (· ≫ _) (eqToHom_refl V_01 rfl)).trans (Category.id_comp _)))
      exact (cancel_epi (eqToHom e01)).mp
        ((h1.trans (D.glue_condition ⟨false⟩ ⟨true⟩).symm).trans h2)
    have hCov_W' : Set.range ι_tilde.base ∪ Set.range ι_compl.base = Set.univ := by
      ext y
      simp only [Set.mem_union, Set.mem_univ, iff_true]
      obtain ⟨i, x, rfl⟩ := D.openCover.exists_eq y
      rcases i with ⟨_ | _⟩
      · left; exact ⟨x, rfl⟩
      · right; exact ⟨x, rfl⟩
    let k_desc : ∀ b : J, U_ch b ⟶ W :=
      fun b => match b with | ⟨false⟩ => π_U ≫ ι₀ | ⟨true⟩ => W_compl.ι
    have hk_desc : ∀ a : J × J,
        D.diagram.fst a ≫ k_desc a.1 = D.diagram.snd a ≫ k_desc a.2 := by
      rintro ⟨i, j⟩
      change D₀.f i j ≫ k_desc i = (D₀.t i j ≫ D₀.f j i) ≫ k_desc j
      by_cases hij : i = j
      · subst hij
        have htii : D₀.t i i = 𝟙 (D₀.V (i, i)) :=
          (dite_eq_left_of_eq_true (eq_true rfl)).trans (eqToHom_refl _ rfl)
        exact congrArg (· ≫ k_desc i)
          ((congrArg (· ≫ D₀.f i i) htii).trans (Category.id_comp _)).symm
      · have hji : j ≠ i := Ne.symm hij
        have eij : D₀.V (i, j) = V_01 := dite_eq_right_of_eq_false (eq_false hij)
        have eji : D₀.V (j, i) = V_01 := dite_eq_right_of_eq_false (eq_false hji)
        have hfij : D₀.f i j = eqToHom eij ≫ f_ch i j hij :=
          dite_eq_right_of_eq_false (eq_false hij)
        have hfji : D₀.f j i = eqToHom eji ≫ f_ch j i hji :=
          dite_eq_right_of_eq_false (eq_false hji)
        have htij : D₀.t i j = eqToHom eij ≫ (𝟙 V_01 ≫ eqToHom eji.symm) :=
          dite_eq_right_of_eq_false (eq_false hij)
        have hcomm_ij : f_ch i j hij ≫ k_desc i = f_ch j i hji ≫ k_desc j := by
          rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
          · exact (hij rfl).elim
          · exact hf₀₁_comm
          · exact hf₀₁_comm.symm
          · exact (hij rfl).elim
        have hL : D₀.f i j ≫ k_desc i = eqToHom eij ≫ (f_ch i j hij ≫ k_desc i) :=
          (congrArg (· ≫ k_desc i) hfij).trans (Category.assoc _ _ _)
        have hR : (D₀.t i j ≫ D₀.f j i) ≫ k_desc j = eqToHom eij ≫ (f_ch j i hji ≫ k_desc j) :=
          calc (D₀.t i j ≫ D₀.f j i) ≫ k_desc j
              = D₀.t i j ≫ (D₀.f j i ≫ k_desc j) := Category.assoc _ _ _
            _ = (eqToHom eij ≫ (𝟙 V_01 ≫ eqToHom eji.symm)) ≫
                  ((eqToHom eji ≫ f_ch j i hji) ≫ k_desc j) :=
                  congrArg₂ (· ≫ ·) htij (congrArg (· ≫ k_desc j) hfji)
            _ = (eqToHom eij ≫ eqToHom eji.symm) ≫ (eqToHom eji ≫ (f_ch j i hji ≫ k_desc j)) :=
                  congrArg₂ (· ≫ ·) (congrArg (eqToHom eij ≫ ·) (Category.id_comp _))
                    (Category.assoc _ _ _)
            _ = eqToHom eij ≫ (eqToHom eji.symm ≫ eqToHom eji ≫ (f_ch j i hji ≫ k_desc j)) :=
                  Category.assoc _ _ _
            _ = eqToHom eij ≫ (f_ch j i hji ≫ k_desc j) :=
                  congrArg (eqToHom eij ≫ ·)
                    ((eqToHom_trans_assoc eji.symm eji _).trans
                      ((congrArg (· ≫ _) (eqToHom_refl V_01 rfl)).trans (Category.id_comp _)))
        exact (hL.trans (congrArg (eqToHom eij ≫ ·) hcomm_ij)).trans hR.symm
    let π : W' ⟶ W := Limits.Multicoequalizer.desc D.diagram W k_desc hk_desc
    have h_tilde_π : ι_tilde ≫ π = π_U ≫ ι₀ :=
      Limits.Multicoequalizer.π_desc D.diagram W k_desc hk_desc ⟨false⟩
    have h_compl_π : ι_compl ≫ π = W_compl.ι :=
      Limits.Multicoequalizer.π_desc D.diagram W k_desc hk_desc ⟨true⟩
    have hPre_U0 : π.base ⁻¹' (Set.range ι₀.base) = Set.range ι_tilde.base := by
      ext y
      constructor
      · intro hy
        rcases Set.eq_univ_iff_forall.mp hCov_W' y with hy0 | ⟨x, rfl⟩
        · exact hy0
        · have hx_in : x.1 ∈ Set.range ι₀.base := by
            have h1 : π.base (ι_compl.base x) = x.1 := by
              change (ι_compl ≫ π).base x = W_compl.ι.base x
              rw [h_compl_π]
            rwa [← h1]
          obtain ⟨u, rfl⟩ := hRange_j1 x hx_in
          let v : V_01 := (CategoryTheory.inv (π_U ∣_ U_off)).base u
          have hv : (π_U ∣_ U_off).base v = u := by
            change (CategoryTheory.inv (π_U ∣_ U_off) ≫ (π_U ∣_ U_off)).base u = u
            rw [CategoryTheory.IsIso.inv_hom_id]; rfl
          have hf1v : f₁.base v = j₁.base u := by
            change j₁.base ((π_U ∣_ U_off).base v) = j₁.base u
            rw [hv]
          refine ⟨f₀.base v, ?_⟩
          calc ι_tilde.base (f₀.base v)
              = (f₀ ≫ ι_tilde).base v := rfl
            _ = (f₁ ≫ ι_compl).base v := by rw [h_glue_01]
            _ = ι_compl.base (f₁.base v) := rfl
            _ = ι_compl.base (j₁.base u) := by rw [hf1v]
      · rintro ⟨u, rfl⟩
        change (ι_tilde ≫ π).base u ∈ Set.range ι₀.base
        rw [h_tilde_π]
        exact ⟨π_U.base u, rfl⟩
    have hPre_compl : π.base ⁻¹' (W_compl : Set ↥W) = Set.range ι_compl.base := by
      ext y
      constructor
      · intro hy
        rcases Set.eq_univ_iff_forall.mp hCov_W' y with ⟨u, rfl⟩ | hy1
        · have hu_off : π_U.base u ∈ U_off := by
            apply (h_mem_Uoff (π_U.base u)).mpr
            have h1 : ι₀.base (π_U.base u) = π.base (ι_tilde.base u) := by
              change (π_U ≫ ι₀).base u = (ι_tilde ≫ π).base u
              rw [h_tilde_π]
            rwa [h1]
          let v : V_01 := ⟨u, hu_off⟩
          refine ⟨f₁.base v, ?_⟩
          calc ι_compl.base (f₁.base v)
              = (f₁ ≫ ι_compl).base v := rfl
            _ = (f₀ ≫ ι_tilde).base v := by rw [← h_glue_01]
            _ = ι_tilde.base u := rfl
        · exact hy1
      · rintro ⟨x, rfl⟩
        change (ι_compl ≫ π).base x ∈ (W_compl : Set ↥W)
        rw [h_compl_π]
        exact x.2
    have hOpens_U0 : π ⁻¹ᵁ ι₀.opensRange = ι_tilde.opensRange := by
      ext y; exact Set.ext_iff.mp hPre_U0 y
    have hOpens_compl : π ⁻¹ᵁ W_compl.ι.opensRange = ι_compl.opensRange := by
      ext y
      rw [Scheme.Opens.opensRange_ι]
      exact Set.ext_iff.mp hPre_compl y
    have hPb_U : CategoryTheory.IsPullback π_U ι_tilde ι₀ π :=
      AlgebraicGeometry.IsOpenImmersion.isPullback π_U ι_tilde ι₀ π h_tilde_π hOpens_U0
    have hPb_compl : CategoryTheory.IsPullback (𝟙 W_compl.toScheme) ι_compl W_compl.ι π :=
      AlgebraicGeometry.IsOpenImmersion.isPullback (𝟙 W_compl.toScheme) ι_compl W_compl.ι π
        (by rw [h_compl_π, Category.id_comp]) hOpens_compl
    have hSub_lift : ∀ (U : W.Opens), w₀ ∉ (U : Set ↥W) →
        ∃ (j_U : U.toScheme ⟶ W') (_ : AlgebraicGeometry.IsOpenImmersion j_U),
          j_U ≫ π = U.ι ∧
          π ⁻¹ᵁ U = j_U.opensRange := by
      intro U hwU
      have hU_le : U ≤ W_compl := fun x hx hxw => hwU (hxw ▸ hx)
      let j_U : U.toScheme ⟶ W' := W.homOfLE hU_le ≫ ι_compl
      have hOpen_jU : AlgebraicGeometry.IsOpenImmersion j_U := by
        dsimp [j_U]; infer_instance
      have hjU_π : j_U ≫ π = U.ι := by
        dsimp [j_U]
        rw [Category.assoc, h_compl_π, AlgebraicGeometry.Scheme.homOfLE_ι]
      refine ⟨j_U, hOpen_jU, hjU_π, ?_⟩
      ext y
      change π.base y ∈ U ↔ y ∈ Set.range j_U.base
      constructor
      · intro hyU
        have hy_c : y ∈ π.base ⁻¹' (W_compl : Set ↥W) := hU_le hyU
        rw [hPre_compl] at hy_c
        obtain ⟨x, rfl⟩ := hy_c
        have hx_eq : x.1 = π.base (ι_compl.base x) := by
          change W_compl.ι.base x = (ι_compl ≫ π).base x
          rw [h_compl_π]
        have hxU : x.1 ∈ U := hx_eq.symm ▸ hyU
        refine ⟨⟨x.1, hxU⟩, ?_⟩
        change ι_compl.base ((W.homOfLE hU_le).base ⟨x.1, hxU⟩) = ι_compl.base x
        congr 1
        apply W_compl.ι.isOpenEmbedding.injective
        change (W.homOfLE hU_le ≫ W_compl.ι).base ⟨x.1, hxU⟩ = x.1
        rw [AlgebraicGeometry.Scheme.homOfLE_ι]
        rfl
      · rintro ⟨u, rfl⟩
        change (j_U ≫ π).base u ∈ U
        rw [hjU_π]
        exact u.2
    have hIso_off : ∀ U : W.Opens, w₀ ∉ (U : Set ↥W) → CategoryTheory.IsIso (π ∣_ U) := by
      intro U hwU
      obtain ⟨j_U, hOpen_jU, hjU_π, hOpens_jU⟩ := hSub_lift U hwU
      have hOpens_jU' : π ⁻¹ᵁ U.ι.opensRange = j_U.opensRange := by
        rwa [Scheme.Opens.opensRange_ι]
      have hPb_sub : CategoryTheory.IsPullback (𝟙 U.toScheme) j_U U.ι π :=
        AlgebraicGeometry.IsOpenImmersion.isPullback (𝟙 U.toScheme) j_U U.ι π
          (by rw [hjU_π, Category.id_comp]) hOpens_jU'
      let e_sub := CategoryTheory.IsPullback.isoIsPullback _ _ hPb_sub
        (AlgebraicGeometry.isPullback_morphismRestrict π U)
      have he_fst : e_sub.hom ≫ (π ∣_ U) = 𝟙 U.toScheme :=
        CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_sub
          (AlgebraicGeometry.isPullback_morphismRestrict π U)
      have h_comp_iso : CategoryTheory.IsIso (e_sub.hom ≫ (π ∣_ U)) := by
        rw [he_fst]; infer_instance
      exact @CategoryTheory.IsIso.of_isIso_comp_left _ _ _ _ _ e_sub.hom (π ∣_ U)
        inferInstance h_comp_iso
    let U₀ : W.Opens := ι₀.opensRange
    let W_cov : Bool → W.Opens := fun b => if b then W_compl else U₀
    have hSup_W : iSup W_cov = ⊤ := by
      rw [eq_top_iff]
      intro w _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hw : w = w₀
      · refine ⟨false, ?_⟩
        change w ∈ U₀
        rw [hw, ← hp₀_w₀]
        exact ⟨p₀, rfl⟩
      · exact ⟨true, hw⟩
    have hProp_U0 : AlgebraicGeometry.IsProper (π ∣_ U₀) := by
      have hfac₀ : (π_U ≫ ι₀.isoOpensRange.hom) ≫ U₀.ι = ι_tilde ≫ π := by
        rw [Category.assoc, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι, h_tilde_π]
      have hOpens_U0' : π ⁻¹ᵁ U₀.ι.opensRange = ι_tilde.opensRange := by
        rwa [Scheme.Opens.opensRange_ι]
      have hPb_U0 : CategoryTheory.IsPullback (π_U ≫ ι₀.isoOpensRange.hom) ι_tilde U₀.ι π :=
        AlgebraicGeometry.IsOpenImmersion.isPullback
          (π_U ≫ ι₀.isoOpensRange.hom) ι_tilde U₀.ι π hfac₀.symm hOpens_U0'
      let e_U0 := CategoryTheory.IsPullback.isoIsPullback _ _ hPb_U0
        (AlgebraicGeometry.isPullback_morphismRestrict π U₀)
      have he_U0 : e_U0.hom ≫ (π ∣_ U₀) = π_U ≫ ι₀.isoOpensRange.hom :=
        CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_U0
          (AlgebraicGeometry.isPullback_morphismRestrict π U₀)
      have h_eq : π ∣_ U₀ = e_U0.inv ≫ π_U ≫ ι₀.isoOpensRange.hom := by
        rw [← he_U0, Iso.inv_hom_id_assoc]
      rw [h_eq]
      infer_instance
    have hProp_π : AlgebraicGeometry.IsProper π := by
      apply (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsProper) W_cov hSup_W).mpr
      rintro (_ | _)
      · exact hProp_U0
      · change AlgebraicGeometry.IsProper (π ∣_ W_compl)
        let e_Wc := CategoryTheory.IsPullback.isoIsPullback _ _ hPb_compl
          (AlgebraicGeometry.isPullback_morphismRestrict π W_compl)
        have he_Wc : e_Wc.hom ≫ (π ∣_ W_compl) = 𝟙 W_compl.toScheme :=
          CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_compl
            (AlgebraicGeometry.isPullback_morphismRestrict π W_compl)
        have h_eq_Wc : π ∣_ W_compl = e_Wc.inv := by
          rw [← Category.comp_id e_Wc.inv, ← he_Wc, Iso.inv_hom_id_assoc]
        rw [h_eq_Wc]
        infer_instance
    have hSurj_π : AlgebraicGeometry.Surjective π := by
      refine ⟨fun w => ?_⟩
      by_cases hw : w = w₀
      · obtain ⟨u, hu⟩ := hSurj_U.surj p₀
        refine ⟨ι_tilde.base u, ?_⟩
        change (ι_tilde ≫ π).base u = w
        rw [h_tilde_π]
        change ι₀.base (π_U.base u) = w
        rw [hu, hp₀_w₀, hw]
      · refine ⟨ι_compl.base ⟨w, hw⟩, ?_⟩
        change (ι_compl ≫ π).base ⟨w, hw⟩ = w
        rw [h_compl_π]
        rfl
    have hApp_compl : ∀ V : W.Opens, V ≤ W_compl → CategoryTheory.IsIso (π.app V) := by
      intro V hV
      have hwV : w₀ ∉ (V : Set ↥W) := fun h => hV h rfl
      obtain ⟨j_V, hOpen_jV, hjV_π, hOpens_jV⟩ := hSub_lift V hwV
      have h_comp_iso : CategoryTheory.IsIso ((j_V ≫ π).app V) := by
        rw [hjV_π]
        exact AlgebraicGeometry.Scheme.Hom.isIso_app V.ι V
          (by rw [Scheme.Opens.opensRange_ι])
      rw [AlgebraicGeometry.Scheme.Hom.comp_app] at h_comp_iso
      have hj_iso : CategoryTheory.IsIso (j_V.app (π ⁻¹ᵁ V)) :=
        AlgebraicGeometry.Scheme.Hom.isIso_app j_V (π ⁻¹ᵁ V) (le_of_eq hOpens_jV)
      exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
        (π.app V) (j_V.app (π ⁻¹ᵁ V)) hj_iso h_comp_iso
    have hApp_U0 : ∀ V : W.Opens, V ≤ U₀ → CategoryTheory.IsIso (π.app V) := by
      intro V hV
      have h1 : CategoryTheory.IsIso (ι₀.app V) :=
        AlgebraicGeometry.Scheme.Hom.isIso_app ι₀ V hV
      have h2 : CategoryTheory.IsIso (π_U.app (ι₀ ⁻¹ᵁ V)) := hApp_U (ι₀ ⁻¹ᵁ V)
      have h_rhs_iso : CategoryTheory.IsIso ((π_U ≫ ι₀).app V) := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_app]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ h1 h2
      have h_lhs_iso : CategoryTheory.IsIso ((ι_tilde ≫ π).app V) := by
        rwa [h_tilde_π]
      rw [AlgebraicGeometry.Scheme.Hom.comp_app] at h_lhs_iso
      have hPre_le : π ⁻¹ᵁ V ≤ ι_tilde.opensRange := by
        rw [← hOpens_U0]
        exact fun y hy => hV hy
      have h_t_iso : CategoryTheory.IsIso (ι_tilde.app (π ⁻¹ᵁ V)) :=
        AlgebraicGeometry.Scheme.Hom.isIso_app ι_tilde (π ⁻¹ᵁ V) hPre_le
      exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
        (π.app V) (ι_tilde.app (π ⁻¹ᵁ V)) h_t_iso h_lhs_iso
    have hApp_all : ∀ U : W.Opens, CategoryTheory.IsIso (π.app U) := by
      intro U
      let V_cov : Bool → W.Opens := fun b => if b then U ⊓ W_compl else U ⊓ U₀
      have hV_iso : ∀ b : Bool, CategoryTheory.IsIso (π.app (V_cov b)) := by
        rintro (_ | _)
        · exact hApp_U0 _ inf_le_right
        · exact hApp_compl _ inf_le_right
      have hV_bij : ∀ b : Bool, Function.Bijective (π.app (V_cov b)).hom :=
        fun b => (CategoryTheory.ConcreteCategory.isIso_iff_bijective (π.app (V_cov b))).mp
          (hV_iso b)
      have hSup_U : iSup V_cov = U := by
        apply le_antisymm
        · exact iSup_le fun b => by cases b <;> exact inf_le_left
        · intro x hx
          rw [TopologicalSpace.Opens.mem_iSup]
          by_cases hxw : x = w₀
          · exact ⟨false, hx, hxw ▸ hp₀_w₀ ▸ ⟨p₀, rfl⟩⟩
          · exact ⟨true, hx, hxw⟩
      have hNat : ∀ {A B : W.Opens} (hAB : A ≤ B) (s : ↑(W.presheaf.obj (Opposite.op B))),
          (π.app A).hom ((W.presheaf.map (CategoryTheory.homOfLE hAB).op).hom s) =
            (W'.presheaf.map (CategoryTheory.homOfLE
              ((TopologicalSpace.Opens.map π.base).monotone hAB)).op).hom ((π.app B).hom s) := by
        intro A B hAB s
        have hnat := AlgebraicGeometry.Scheme.Hom.naturality π (CategoryTheory.homOfLE hAB).op
        exact ConcreteCategory.congr_hom hnat s
      have hRes_comp : ∀ {X_s : AlgebraicGeometry.Scheme.{u}} {A B C : X_s.Opens}
          (hAB : A ≤ B) (hBC : B ≤ C) (s : ↑(X_s.presheaf.obj (Opposite.op C))),
          (X_s.presheaf.map (CategoryTheory.homOfLE hAB).op).hom
            ((X_s.presheaf.map (CategoryTheory.homOfLE hBC).op).hom s) =
            (X_s.presheaf.map (CategoryTheory.homOfLE (hAB.trans hBC)).op).hom s := by
        intro X_s A B C hAB hBC s
        have hm := X_s.presheaf.map_comp
          (CategoryTheory.homOfLE hBC).op (CategoryTheory.homOfLE hAB).op
        exact ConcreteCategory.congr_hom hm.symm s
      rw [CategoryTheory.ConcreteCategory.isIso_iff_bijective]
      refine ⟨?_, ?_⟩
      · intro s₁ s₂ hs
        apply TopCat.Presheaf.IsSheaf.section_ext (F := W.presheaf) W.sheaf.2
        intro x hxU
        have hxSup : x ∈ iSup V_cov := hSup_U.symm ▸ hxU
        rw [TopologicalSpace.Opens.mem_iSup] at hxSup
        obtain ⟨b, hxb⟩ := hxSup
        have hb_le : V_cov b ≤ U := by cases b <;> exact inf_le_left
        refine ⟨V_cov b, hb_le, hxb, (hV_bij b).1 ?_⟩
        change (π.app (V_cov b)).hom ((W.presheaf.map (CategoryTheory.homOfLE hb_le).op).hom s₁) =
          (π.app (V_cov b)).hom ((W.presheaf.map (CategoryTheory.homOfLE hb_le).op).hom s₂)
        rw [hNat hb_le s₁, hNat hb_le s₂]
        exact congrArg _ hs
      · intro t
        have hb_le : ∀ b : Bool, V_cov b ≤ U := by rintro (_ | _) <;> exact inf_le_left
        choose sf hsf using fun b : Bool =>
          (hV_bij b).2
            ((W'.presheaf.map (CategoryTheory.homOfLE
              ((TopologicalSpace.Opens.map π.base).monotone (hb_le b))).op).hom t)
        have hCompat : TopCat.Presheaf.IsCompatible W.presheaf V_cov sf := by
          intro i j
          have h_inter_iso : CategoryTheory.IsIso (π.app (V_cov i ⊓ V_cov j)) := by
            cases i <;> cases j
            · exact hApp_U0 _ (le_trans inf_le_left inf_le_right)
            · exact hApp_compl _ (le_trans inf_le_right inf_le_right)
            · exact hApp_compl _ (le_trans inf_le_left inf_le_right)
            · exact hApp_compl _ (le_trans inf_le_left inf_le_right)
          have h_inter_inj : Function.Injective (π.app (V_cov i ⊓ V_cov j)).hom :=
            ((CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mp h_inter_iso).1
          apply h_inter_inj
          change (π.app (V_cov i ⊓ V_cov j)).hom
              ((W.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (sf i)) =
            (π.app (V_cov i ⊓ V_cov j)).hom
              ((W.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (sf j))
          rw [hNat inf_le_left (sf i), hNat inf_le_right (sf j), hsf i, hsf j,
            hRes_comp, hRes_comp]
        obtain ⟨s_sup, hs_gluing, _⟩ := TopCat.Sheaf.existsUnique_gluing W.sheaf V_cov sf hCompat
        let s : ↑(W.presheaf.obj (Opposite.op U)) :=
          (W.presheaf.map (CategoryTheory.homOfLE (le_of_eq hSup_U.symm)).op).hom s_sup
        refine ⟨s, ?_⟩
        apply TopCat.Presheaf.IsSheaf.section_ext (F := W'.presheaf) W'.sheaf.2
        intro y hyU
        have hySup : π.base y ∈ iSup V_cov := hSup_U.symm ▸ hyU
        rw [TopologicalSpace.Opens.mem_iSup] at hySup
        obtain ⟨b, hyb⟩ := hySup
        let hπ_le := (TopologicalSpace.Opens.map π.base).monotone (hb_le b)
        refine ⟨π ⁻¹ᵁ V_cov b, hπ_le, hyb, ?_⟩
        change (W'.presheaf.map (CategoryTheory.homOfLE hπ_le).op).hom ((π.app U).hom s) =
          (W'.presheaf.map (CategoryTheory.homOfLE hπ_le).op).hom t
        rw [← hNat (hb_le b) s]
        have hs_b : (W.presheaf.map (CategoryTheory.homOfLE (hb_le b)).op).hom s = sf b :=
          (hRes_comp (hb_le b) (le_of_eq hSup_U.symm) s_sup).trans (hs_gluing b)
        rw [hs_b, hsf b]
    exact ⟨W', ι_tilde, ι_compl, π, hOpen_tilde, hOpen_compl, hCov_W', h_tilde_π, h_compl_π,
      hPre_U0, hPre_compl, hPb_U, hPb_compl, hProp_π, hSurj_π, hIso_off, hApp_all⟩

  have part2_sections :
      ∀ (W W' U_tilde : AlgebraicGeometry.Scheme.{u})
        (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
        (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
        (w₀ : ↥W)
        (W_compl : W.Opens)
        (π : W' ⟶ W)
        (ι_tilde : U_tilde ⟶ W')
        (ι_compl : W_compl.toScheme ⟶ W'),
        (W_compl : Set ↥W) = ({w₀} : Set ↥W)ᶜ →
        PowerSeries.X ∈ (g_W.base w₀).asIdeal →
        AlgebraicGeometry.IsIntegral W →
        AlgebraicGeometry.Flat g_W →
        AlgebraicGeometry.IsProper g_W →
        AlgebraicGeometry.LocallyOfFinitePresentation g_W →
        AlgebraicGeometry.Surjective g_W →
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (CategoryTheory.Limits.pullback.snd g_W
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))) →
        (∀ j : Fin n,
          τ_W j ≫ g_W = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))) →
        (_root_.Pairwise fun i j : Fin n =>
          Disjoint (Set.range (τ_W i).base) (Set.range (τ_W j).base)) →
        AlgebraicGeometry.IsIntegral U_tilde →
        AlgebraicGeometry.Flat (ι_tilde ≫ π ≫ g_W) →
        AlgebraicGeometry.LocallyOfFinitePresentation (ι_tilde ≫ π ≫ g_W) →
        AlgebraicGeometry.IsOpenImmersion ι_tilde →
        AlgebraicGeometry.IsOpenImmersion ι_compl →
        Set.range ι_tilde.base ∪ Set.range ι_compl.base = Set.univ →
        (Set.range ι_tilde.base ∩ Set.range ι_compl.base).Nonempty →
        ι_compl ≫ π = W_compl.ι →
        π.base ⁻¹' (W_compl : Set ↥W) = Set.range ι_compl.base →
        AlgebraicGeometry.IsProper π →
        AlgebraicGeometry.Surjective π →
        let η_K := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
        let g_W' := π ≫ g_W
        AlgebraicGeometry.IsIntegral W' ∧
        AlgebraicGeometry.Flat g_W' ∧
        AlgebraicGeometry.IsProper g_W' ∧
        AlgebraicGeometry.LocallyOfFinitePresentation g_W' ∧
        AlgebraicGeometry.Surjective g_W' ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Limits.pullback.snd g_W' η_K) ∧
        (∀ (v_K : CategoryTheory.Limits.pullback g_W' η_K ⟶ CategoryTheory.Limits.pullback g_W η_K),
          v_K ≫ CategoryTheory.Limits.pullback.fst g_W η_K =
            CategoryTheory.Limits.pullback.fst g_W' η_K ≫ π →
          v_K ≫ CategoryTheory.Limits.pullback.snd g_W η_K =
            CategoryTheory.Limits.pullback.snd g_W' η_K →
          CategoryTheory.IsIso v_K) ∧
        ∃ (τ_W' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W')),
          (∀ j : Fin n, τ_W' j ≫ π = τ_W j) ∧
          (∀ j : Fin n, τ_W' j ≫ g_W' = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))) ∧
          (_root_.Pairwise fun i j : Fin n =>
            Disjoint (Set.range (τ_W' i).base) (Set.range (τ_W' j).base)) := by
    intro W W' U_tilde g_W τ_W w₀ W_compl π ι_tilde ι_compl hW_compl_eq hX_mem_w₀
      hInt_W hFlat_W hProp_W hLFP_W hSurj_W hSm_W hSec_W hDisj_W hInt_U hFlat_U hLFP_U
      hOpen_tilde hOpen_compl hCov_W' hInter_ne h_compl_π hPre_compl hProp_π hSurj_π η_K g_W'
    have ⟨y₀, hy₀_0, ⟨x₀_c, hx₀_c⟩⟩ := hInter_ne
    have hNe_W' : Nonempty ↥W' := ⟨y₀⟩
    have : Nonempty ↥W_compl.toScheme := ⟨x₀_c⟩
    have : AlgebraicGeometry.IsIntegral W_compl.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion W_compl.ι
    let O_cov : ULift.{u} Bool → W'.Opens :=
      fun i => if i.down then ι_compl.opensRange else ι_tilde.opensRange
    have hSup_O : TopologicalSpace.IsOpenCover O_cov := by
      rw [TopologicalSpace.IsOpenCover, eq_top_iff]
      intro y _
      rw [TopologicalSpace.Opens.mem_iSup]
      rcases Set.eq_univ_iff_forall.mp hCov_W' y with hy0 | hy1
      · exact ⟨⟨false⟩, hy0⟩
      · exact ⟨⟨true⟩, hy1⟩
    let 𝒰 : W'.OpenCover := W'.openCoverOfIsOpenCover O_cov hSup_O
    have : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := by
      rintro ⟨_ | _⟩
      · dsimp [𝒰, AlgebraicGeometry.Scheme.openCoverOfIsOpenCover, O_cov]
        exact AlgebraicGeometry.isReduced_of_isOpenImmersion ι_tilde.isoOpensRange.inv
      · dsimp [𝒰, AlgebraicGeometry.Scheme.openCoverOfIsOpenCover, O_cov]
        exact AlgebraicGeometry.isReduced_of_isOpenImmersion ι_compl.isoOpensRange.inv
    have hRed_W' : AlgebraicGeometry.IsReduced W' :=
      AlgebraicGeometry.IsReduced.of_openCover W' 𝒰
    have hPre_W' : PreirreducibleSpace ↥W' := by
      refine ⟨?_⟩
      let S₀ : Set ↥W' := Set.range ι_tilde.base
      let S₁ : Set ↥W' := Set.range ι_compl.base
      have hOpen_S0 : IsOpen S₀ := ι_tilde.isOpenEmbedding.isOpen_range
      have hOpen_S1 : IsOpen S₁ := ι_compl.isOpenEmbedding.isOpen_range
      have hPre_S0 : IsPreirreducible S₀ := by
        dsimp [S₀]
        rw [← Set.image_univ]
        exact (IrreducibleSpace.isIrreducible_univ ↥U_tilde).isPreirreducible.image _
          ι_tilde.continuous.continuousOn
      have hPre_S1 : IsPreirreducible S₁ := by
        dsimp [S₁]
        rw [← Set.image_univ]
        exact (IrreducibleSpace.isIrreducible_univ ↥W_compl.toScheme).isPreirreducible.image _
          ι_compl.continuous.continuousOn
      have hMeet_S1 : ∀ {O : Set ↥W'}, IsOpen O → O.Nonempty → (S₁ ∩ O).Nonempty := by
        intro O hO hOne
        obtain ⟨z, hz⟩ := hOne
        rcases Set.eq_univ_iff_forall.mp hCov_W' z with hz0 | hz1
        · obtain ⟨w, _, hwO, hw1⟩ :=
            hPre_S0 O S₁ hO hOpen_S1 ⟨z, hz0, hz⟩ hInter_ne
          exact ⟨w, hw1, hwO⟩
        · exact ⟨z, hz1, hz⟩
      intro O₁ O₂ hO₁ hO₂ ⟨z₁, hz₁⟩ ⟨z₂, hz₂⟩
      obtain ⟨w, _, hw1, hw2⟩ :=
        hPre_S1 O₁ O₂ hO₁ hO₂
          (hMeet_S1 hO₁ ⟨z₁, hz₁.2⟩) (hMeet_S1 hO₂ ⟨z₂, hz₂.2⟩)
      exact ⟨w, trivial, hw1, hw2⟩
    have hIrred_W' : IrreducibleSpace ↥W' :=
      { toPreirreducibleSpace := hPre_W', toNonempty := hNe_W' }
    have hInt_W' : AlgebraicGeometry.IsIntegral W' :=
      (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced W').mpr ⟨hIrred_W', hRed_W'⟩
    have h_inv_ι_tilde : (O_cov ⟨false⟩).ι = ι_tilde.isoOpensRange.inv ≫ ι_tilde := by
      dsimp [O_cov]
      rw [Iso.eq_inv_comp]
      exact AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_tilde
    have h_inv_ι_compl : (O_cov ⟨true⟩).ι = ι_compl.isoOpensRange.inv ≫ ι_compl := by
      dsimp [O_cov]
      rw [Iso.eq_inv_comp]
      exact AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι ι_compl
    have : AlgebraicGeometry.IsZariskiLocalAtSource @AlgebraicGeometry.Flat :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource (Q := @RingHom.Flat)
    have : AlgebraicGeometry.IsZariskiLocalAtSource @AlgebraicGeometry.LocallyOfFinitePresentation :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (Q := @RingHom.FinitePresentation)
    have hFlat_W' : AlgebraicGeometry.Flat g_W' := by
      apply (AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_openCover
        (P := @AlgebraicGeometry.Flat) 𝒰).mpr
      rintro ⟨_ | _⟩
      · change AlgebraicGeometry.Flat ((O_cov ⟨false⟩).ι ≫ g_W')
        rw [h_inv_ι_tilde, Category.assoc]
        infer_instance
      · change AlgebraicGeometry.Flat ((O_cov ⟨true⟩).ι ≫ g_W')
        rw [h_inv_ι_compl, Category.assoc]
        dsimp [g_W']
        rw [← Category.assoc ι_compl, h_compl_π]
        infer_instance
    have hLFP_W' : AlgebraicGeometry.LocallyOfFinitePresentation g_W' := by
      apply (AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_openCover
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation) 𝒰).mpr
      rintro ⟨_ | _⟩
      · change AlgebraicGeometry.LocallyOfFinitePresentation ((O_cov ⟨false⟩).ι ≫ g_W')
        rw [h_inv_ι_tilde, Category.assoc]
        infer_instance
      · change AlgebraicGeometry.LocallyOfFinitePresentation ((O_cov ⟨true⟩).ι ≫ g_W')
        rw [h_inv_ι_compl, Category.assoc]
        dsimp [g_W']
        rw [← Category.assoc ι_compl, h_compl_π]
        infer_instance
    have hProp_W' : AlgebraicGeometry.IsProper g_W' := by
      dsimp [g_W']; infer_instance
    have hSurj_W' : AlgebraicGeometry.Surjective g_W' := by
      dsimp [g_W']; infer_instance
    have hηK_ne_w0 : ∀ x_K : AlgebraicGeometry.Spec
        (CommRingCat.of (FractionRing (PowerSeries Ω))),
        η_K.base x_K ≠ g_W.base w₀ := by
      intro x_K heq
      have hinj : Function.Injective
          (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))) :=
        IsFractionRing.injective (PowerSeries Ω) (FractionRing (PowerSeries Ω))
      have hX_ne : algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))
          (PowerSeries.X : PowerSeries Ω) ≠ 0 :=
        fun h => PowerSeries.X_ne_zero (hinj (h.trans (map_zero _).symm))
      have hUnit : IsUnit (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))
          (PowerSeries.X : PowerSeries Ω)) := IsUnit.mk0 _ hX_ne
      have hX_in : (PowerSeries.X : PowerSeries Ω) ∈ (η_K.base x_K).asIdeal :=
        heq.symm ▸ hX_mem_w₀
      have hX_in_K : algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))
          (PowerSeries.X : PowerSeries Ω) ∈ x_K.asIdeal := hX_in
      exact x_K.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hX_in_K hUnit)
    have hOpens_compl : π ⁻¹ᵁ W_compl.ι.opensRange = ι_compl.opensRange := by
      ext y
      rw [Scheme.Opens.opensRange_ι]
      exact Set.ext_iff.mp hPre_compl y
    have hPb_compl_flip : CategoryTheory.IsPullback ι_compl (𝟙 W_compl.toScheme) π W_compl.ι :=
      (AlgebraicGeometry.IsOpenImmersion.isPullback (𝟙 W_compl.toScheme) ι_compl W_compl.ι π
        (by rw [h_compl_π, Category.id_comp]) hOpens_compl).flip
    have hvK_iso : ∀ (v_K : CategoryTheory.Limits.pullback g_W' η_K ⟶
          CategoryTheory.Limits.pullback g_W η_K),
        v_K ≫ CategoryTheory.Limits.pullback.fst g_W η_K =
          CategoryTheory.Limits.pullback.fst g_W' η_K ≫ π →
        v_K ≫ CategoryTheory.Limits.pullback.snd g_W η_K =
          CategoryTheory.Limits.pullback.snd g_W' η_K →
        CategoryTheory.IsIso v_K := by
      intro v_K hv_fst hv_snd
      let fst_W := CategoryTheory.Limits.pullback.fst g_W η_K
      let snd_W := CategoryTheory.Limits.pullback.snd g_W η_K
      let fst_W' := CategoryTheory.Limits.pullback.fst g_W' η_K
      let snd_W' := CategoryTheory.Limits.pullback.snd g_W' η_K
      have hPb_outer : CategoryTheory.IsPullback fst_W' (v_K ≫ snd_W) (π ≫ g_W) η_K := by
        rw [hv_snd]
        exact CategoryTheory.IsPullback.of_hasPullback g_W' η_K
      have hPb_vK : CategoryTheory.IsPullback fst_W' v_K π fst_W :=
        (CategoryTheory.IsPullback.of_right hPb_outer.flip hv_fst
          (CategoryTheory.IsPullback.of_hasPullback g_W η_K).flip).flip
      have h_range_W : Set.range fst_W.base ⊆ Set.range W_compl.ι.base := by
        rintro _ ⟨z, rfl⟩
        have hne_z : fst_W.base z ≠ w₀ := by
          intro hzw0
          have hcomm_z : g_W.base (fst_W.base z) = η_K.base (snd_W.base z) := by
            change (fst_W ≫ g_W).base z = (snd_W ≫ η_K).base z
            rw [CategoryTheory.Limits.pullback.condition]
          rw [hzw0] at hcomm_z
          exact hηK_ne_w0 (snd_W.base z) hcomm_z.symm
        have hz_mem : fst_W.base z ∈ W_compl := by
          change fst_W.base z ∈ (W_compl : Set ↥W)
          rw [hW_compl_eq]
          exact hne_z
        exact ⟨⟨fst_W.base z, hz_mem⟩, rfl⟩
      let f_W := AlgebraicGeometry.IsOpenImmersion.lift W_compl.ι fst_W h_range_W
      have hf_W : f_W ≫ W_compl.ι = fst_W :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac W_compl.ι fst_W h_range_W
      have h_range_W' : Set.range fst_W'.base ⊆ Set.range ι_compl.base := by
        rw [← hPre_compl]
        rintro _ ⟨z', rfl⟩
        change (fst_W' ≫ π).base z' ∈ (W_compl : Set ↥W)
        rw [← hv_fst]
        obtain ⟨x, hx⟩ := h_range_W ⟨v_K.base z', rfl⟩
        change (v_K ≫ fst_W).base z' ∈ (W_compl : Set ↥W)
        have hx' : W_compl.ι.base x = (v_K ≫ fst_W).base z' := hx
        rw [← hx']
        exact x.2
      let f_W' := AlgebraicGeometry.IsOpenImmersion.lift ι_compl fst_W' h_range_W'
      have hf_W' : f_W' ≫ ι_compl = fst_W' :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_compl fst_W' h_range_W'
      have hPb_vK_outer : CategoryTheory.IsPullback (f_W' ≫ ι_compl) v_K π (f_W ≫ W_compl.ι) := by
        rw [hf_W', hf_W]
        exact hPb_vK
      have hf_top_comm : f_W' ≫ 𝟙 W_compl.toScheme = v_K ≫ f_W := by
        rw [Category.comp_id, ← cancel_mono W_compl.ι]
        calc f_W' ≫ W_compl.ι
            = f_W' ≫ (ι_compl ≫ π) := by rw [h_compl_π]
          _ = fst_W' ≫ π := by rw [← Category.assoc, hf_W']
          _ = v_K ≫ fst_W := hv_fst.symm
          _ = (v_K ≫ f_W) ≫ W_compl.ι := by rw [Category.assoc, hf_W]
      have hPb_top : CategoryTheory.IsPullback v_K f_W' f_W (𝟙 W_compl.toScheme) :=
        (CategoryTheory.IsPullback.of_right hPb_vK_outer hf_top_comm hPb_compl_flip).flip
