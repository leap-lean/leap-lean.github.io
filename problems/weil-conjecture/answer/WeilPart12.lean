  have hPart4 :
      ∀ (L₀ L' : Type u) [CommRing L₀] [IsLocalRing L₀] [IsNoetherianRing L₀]
        [CommRing L'] [IsLocalRing L'] [IsNoetherianRing L']
        (θ : L₀ →+* L') [IsLocalHom θ],
        θ.Flat →
        Ideal.map θ (IsLocalRing.maximalIdeal L₀) = IsLocalRing.maximalIdeal L' →
        (∀ b : L', ∃ a : L₀, b - θ a ∈ IsLocalRing.maximalIdeal L') →
        ∀ (u v : L'),
          IsLocalRing.maximalIdeal L' = Ideal.span ({u, v} : Set L') →
          Function.Injective (fun x : L' => u * x) →
          (∀ y : L', v * y ∈ Ideal.span ({u} : Set L') → y ∈ Ideal.span ({u} : Set L')) →
