        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
        AlgebraicGeometry.Spec.map ιR_hom := by
      dsimp only [iso_spec_comm]
      rw [← AlgebraicGeometry.Spec.map_comp]
      refine congrArg AlgebraicGeometry.Spec.map ?_
      apply CommRingCat.hom_ext; apply RingHom.ext; intro c
      rfl
    have h_comm_R : iso_spec_comm.hom ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            (Algebra.TensorProduct.includeRight : ↑B →ₐ[↑S] TensorProduct ↑S AY₀ ↑B)) =
        AlgebraicGeometry.Spec.map ιL_hom := by
      dsimp only [iso_spec_comm]
      rw [← AlgebraicGeometry.Spec.map_comp]
      refine congrArg AlgebraicGeometry.Spec.map ?_
      apply CommRingCat.hom_ext; apply RingHom.ext; intro b
      rfl
    have hPb_outer : CategoryTheory.IsPullback
