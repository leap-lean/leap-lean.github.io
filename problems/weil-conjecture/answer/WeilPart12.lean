    have h_lT_top_eq :
        Function.Bijective
          (@LinearMap.lTensor ↑S _ ↑B ↑S (AY ⊤) _ _ _ _ _ (u_Y.toAlgebra.toModule)
            (@Algebra.linearMap ↑S (AY ⊤) _ _ u_Y.toAlgebra)) ↔
        Function.Bijective (LinearMap.lTensor ↑B u_top_lin) := by
      dsimp only [u_top_lin]
      rw [hAlgTop]
    change Function.Bijective
        (@LinearMap.lTensor ↑S _ ↑B ↑S (AY ⊤) _ _ _ _ _ (u_Y.toAlgebra.toModule)
          (@Algebra.linearMap ↑S (AY ⊤) _ _ u_Y.toAlgebra)) ↔
      Function.Bijective v_B
    rw [h_lT_top_eq]
    have h_fun_eq : (μ_lin ⊤ ∘ LinearMap.lTensor ↑B u_top_lin) =
        (v_B ∘ TensorProduct.rid ↑S ↑B) := funext h_comp_vB
    constructor
    · intro hBij_lT
      have h_comp : Function.Bijective (v_B ∘ TensorProduct.rid ↑S ↑B) := by
        rw [← h_fun_eq]
        exact hBij_μ_top.comp hBij_lT
      refine ⟨?_, ?_⟩
      · intro b₁ b₂ hb
        obtain ⟨z₁, rfl⟩ := hBij_rid.2 b₁
        obtain ⟨z₂, rfl⟩ := hBij_rid.2 b₂
        exact congrArg _ (h_comp.1 hb)
      · intro y
        obtain ⟨z, hz⟩ := h_comp.2 y
        exact ⟨TensorProduct.rid ↑S ↑B z, hz⟩
    · intro hBij_vB
      have h_comp : Function.Bijective (μ_lin ⊤ ∘ LinearMap.lTensor ↑B u_top_lin) := by
        rw [h_fun_eq]
        exact hBij_vB.comp hBij_rid
      refine ⟨fun z₁ z₂ hz => h_comp.1 (congrArg (μ_lin ⊤) hz), ?_⟩
      intro w
      obtain ⟨z, hz⟩ := h_comp.2 (μ_lin ⊤ w)
      exact ⟨z, hBij_μ_top.1 hz⟩
  have hAlgDescent : ∀ (R₀ A₀ B' : Type u) [CommRing R₀] [CommRing A₀] [CommRing B']
      [Algebra R₀ A₀] [Algebra R₀ B'] [Module.Flat R₀ B']
      (m₀ : Ideal R₀) [m₀.IsMaximal]
      (q'₀ : Ideal B') [q'₀.IsPrime],
      Ideal.comap (algebraMap R₀ B') q'₀ = m₀ →
      Function.Bijective (LinearMap.lTensor B' (Algebra.linearMap R₀ A₀)) →
      (∀ f ∈ m₀, Function.Bijective
        (LinearMap.lTensor (Localization.Away f) (Algebra.linearMap R₀ A₀))) →
      Function.Bijective (Algebra.linearMap R₀ A₀) := by
    clear! R₁ R₂ X₁ X₂ N₁ N₂ A' hOpenAppIso hSheafGlue hAffPullback hFlatBC
    intro R₀ A₀ B' _ _ _ _ _ _ m₀ hMax_m₀ q'₀ _ hq'₀ hBij_B' hBij_away
    let u_lin : R₀ →ₗ[R₀] A₀ := Algebra.linearMap R₀ A₀
    let u₀ : R₀ →+* A₀ := algebraMap R₀ A₀
    have hBaseChange : ∀ (C₁ C₂ : Type u) [CommRing C₁] [CommRing C₂]
        [Algebra R₀ C₁] [Algebra R₀ C₂] (ψ : C₁ →ₐ[R₀] C₂),
        (Function.Bijective (LinearMap.lTensor C₁ u_lin) →
          Function.Bijective (LinearMap.lTensor C₂ u_lin)) ∧
        ((letI : Algebra C₁ C₂ := ψ.toRingHom.toAlgebra
          Module.FaithfullyFlat C₁ C₂) →
          Function.Bijective (LinearMap.lTensor C₂ u_lin) →
          Function.Bijective (LinearMap.lTensor C₁ u_lin)) := by
      intro C₁ C₂ _ _ _ _ ψ
      letI : Algebra C₁ C₂ := ψ.toRingHom.toAlgebra
      have : IsScalarTower R₀ C₁ C₂ :=
        IsScalarTower.of_algebraMap_eq' ψ.comp_algebraMap.symm
      let E_R : TensorProduct C₁ C₂ (TensorProduct R₀ C₁ R₀) ≃ₗ[C₁] TensorProduct R₀ C₂ R₀ :=
        (Algebra.TensorProduct.cancelBaseChange R₀ C₁ C₁ C₂ R₀).toLinearEquiv
      let E_A : TensorProduct C₁ C₂ (TensorProduct R₀ C₁ A₀) ≃ₗ[C₁] TensorProduct R₀ C₂ A₀ :=
        (Algebra.TensorProduct.cancelBaseChange R₀ C₁ C₁ C₂ A₀).toLinearEquiv
      let u_C₁_alg : TensorProduct R₀ C₁ R₀ →ₐ[C₁] TensorProduct R₀ C₁ A₀ :=
        { (Algebra.TensorProduct.map (AlgHom.id R₀ C₁) (Algebra.ofId R₀ A₀)).toRingHom with
          commutes' := fun c₁ => by
            change c₁ ⊗ₜ[R₀] (algebraMap R₀ A₀ 1) = c₁ ⊗ₜ[R₀] 1
            rw [map_one] }
      let u_C₁_lin : TensorProduct R₀ C₁ R₀ →ₗ[C₁] TensorProduct R₀ C₁ A₀ := u_C₁_alg.toLinearMap
      have hu_C₁_eq : (u_C₁_lin : TensorProduct R₀ C₁ R₀ → TensorProduct R₀ C₁ A₀) =
          LinearMap.lTensor C₁ u_lin := by
        have h_lin : u_C₁_lin.restrictScalars R₀ = LinearMap.lTensor C₁ u_lin := by
          apply TensorProduct.ext'
          intro c₁ r
          rfl
        exact congrArg DFunLike.coe h_lin
      have hSq : ∀ w : TensorProduct C₁ C₂ (TensorProduct R₀ C₁ R₀),
          E_A (LinearMap.lTensor C₂ u_C₁_lin w) =
            LinearMap.lTensor C₂ u_lin (E_R w) := by
        intro w
        refine TensorProduct.inductionOn w ?_ ?_
        · intro c₂ z
          refine TensorProduct.inductionOn z ?_ ?_
          · intro c₁ r
            change Algebra.TensorProduct.cancelBaseChange R₀ C₁ C₁ C₂ A₀
                (c₂ ⊗ₜ[C₁] (c₁ ⊗ₜ[R₀] u_lin r)) =
              LinearMap.lTensor C₂ u_lin
                (Algebra.TensorProduct.cancelBaseChange R₀ C₁ C₁ C₂ R₀
                  (c₂ ⊗ₜ[C₁] (c₁ ⊗ₜ[R₀] r)))
            rw [Algebra.TensorProduct.cancelBaseChange_tmul,
              Algebra.TensorProduct.cancelBaseChange_tmul, LinearMap.lTensor_tmul]
          · intro x y hx hy
            rw [TensorProduct.tmul_add, map_add, map_add, map_add, map_add, hx, hy]
        · intro x y hx hy
          rw [map_add, map_add, map_add, map_add, hx, hy]
      have h_fun : (E_A ∘ LinearMap.lTensor C₂ u_C₁_lin) =
          (LinearMap.lTensor C₂ u_lin ∘ E_R) := funext hSq
      constructor
      · intro hBij₁
        have hBij_uC₁ : Function.Bijective u_C₁_lin := by rwa [hu_C₁_eq]
        let e_uC₁ : TensorProduct R₀ C₁ R₀ ≃ₗ[C₁] TensorProduct R₀ C₁ A₀ :=
          LinearEquiv.ofBijective u_C₁_lin hBij_uC₁
        have hBij_lT : Function.Bijective (LinearMap.lTensor C₂ u_C₁_lin) :=
          (LinearEquiv.lTensor C₂ e_uC₁).bijective
        have h_comp : Function.Bijective (LinearMap.lTensor C₂ u_lin ∘ E_R) := by
          rw [← h_fun]; exact E_A.bijective.comp hBij_lT
        refine ⟨?_, ?_⟩
        · intro x₁ x₂ hx
          obtain ⟨w₁, rfl⟩ := E_R.bijective.2 x₁
          obtain ⟨w₂, rfl⟩ := E_R.bijective.2 x₂
          exact congrArg E_R (h_comp.1 hx)
        · intro y
          obtain ⟨w, hw⟩ := h_comp.2 y
          exact ⟨E_R w, hw⟩
      · intro hFF hBij₂
        have h_comp : Function.Bijective (E_A ∘ LinearMap.lTensor C₂ u_C₁_lin) := by
          rw [h_fun]; exact hBij₂.comp E_R.bijective
        have hBij_lT : Function.Bijective (LinearMap.lTensor C₂ u_C₁_lin) := by
          refine ⟨fun w₁ w₂ hw => h_comp.1 (congrArg E_A hw), ?_⟩
          intro z
          obtain ⟨w, hw⟩ := h_comp.2 (E_A z)
          exact ⟨w, E_A.injective hw⟩
        have hBij_uC₁ : Function.Bijective u_C₁_lin :=
          (Module.FaithfullyFlat.lTensor_bijective_iff_bijective C₁ C₂ u_C₁_lin).mp hBij_lT
        rwa [← hu_C₁_eq]
    have hBij_at_max : ∀ (𝔪 : Ideal R₀) [𝔪.IsMaximal],
        Function.Bijective (LinearMap.lTensor (Localization.AtPrime 𝔪) u_lin) := by
      intro 𝔪 hMax_𝔪
      by_cases h_eq : 𝔪 = m₀
      · subst 𝔪
        have hFlat_α : (algebraMap R₀ B').Flat := by
          have h_mod : (algebraMap R₀ B').toModule = (inferInstance : Module R₀ B') :=
            Module.ext' _ _ fun r x => (Algebra.smul_def r x).symm
          change @Module.Flat R₀ B' _ _ (algebraMap R₀ B').toModule
          rw [h_mod]
          infer_instance
        let ψ_loc : Localization.AtPrime m₀ →+* Localization.AtPrime q'₀ :=
          Localization.localRingHom m₀ q'₀ (algebraMap R₀ B') hq'₀.symm
        have hFlat_ψloc : ψ_loc.Flat :=
          RingHom.Flat.localRingHom hFlat_α q'₀ m₀ hq'₀.symm
        have : IsLocalHom ψ_loc :=
          Localization.isLocalHom_localRingHom m₀ q'₀ (algebraMap R₀ B') hq'₀.symm
        letI : Algebra R₀ (Localization.AtPrime q'₀) :=
          ((algebraMap B' (Localization.AtPrime q'₀)).comp (algebraMap R₀ B')).toAlgebra
        let j_B'_alg : B' →ₐ[R₀] Localization.AtPrime q'₀ :=
          { algebraMap B' (Localization.AtPrime q'₀) with commutes' := fun _ => rfl }
        have hBij_q'₀ := (hBaseChange B' (Localization.AtPrime q'₀) j_B'_alg).1 hBij_B'
        let ψ_loc_alg : Localization.AtPrime m₀ →ₐ[R₀] Localization.AtPrime q'₀ :=
          { ψ_loc with
            commutes' := fun r => by
              change Localization.localRingHom m₀ q'₀ (algebraMap R₀ B') hq'₀.symm
