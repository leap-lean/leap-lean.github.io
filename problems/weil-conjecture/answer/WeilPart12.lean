            Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom) s =
          ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : W j ≤ ⊤)).op ≫
            Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom) s
        rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
        have h_eq : (CategoryTheory.homOfLE (le_top : W i ≤ ⊤)).op ≫
            (CategoryTheory.homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op =
            (CategoryTheory.homOfLE (le_top : W j ≤ ⊤)).op ≫
              (CategoryTheory.homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op :=
          Subsingleton.elim _ _
        rw [h_eq]
    have hInj_ρP : Function.Injective ρ_P := by
      intro s₁ s₂ hs
      let WP : Fin M → P.Opens := fun i => (TopologicalSpace.Opens.map fst.base).obj (W i)
