        rw [h_fst_snd]
      · apply hCancel_compl
        · rw [CategoryTheory.Category.assoc, hg_π₀ b₁,
            CategoryTheory.Category.assoc, hg_π₀ b₂,
            CategoryTheory.Limits.pullback.condition_assoc]
        · let b0 : 𝒰.I₀ := (⟨false⟩ : ULift.{u} Bool)
          let b1 : 𝒰.I₀ := (⟨true⟩ : ULift.{u} Bool)
          rcases b₁ with ⟨_ | _⟩ <;> rcases b₂ with ⟨_ | _⟩
          · exact False.elim (h_eq rfl)
          · change Set.range ((CategoryTheory.Limits.pullback.fst (𝒰.f b0) (𝒰.f b1) ≫
                g_cov b0) ≫ π₀).base ⊆ (Y'_compl : Set ↥Y')
            rw [CategoryTheory.Category.assoc, hg_π₀ b0,
              CategoryTheory.Limits.pullback.condition_assoc]
            rintro _ ⟨p, rfl⟩
            change ((CategoryTheory.Limits.pullback.snd (𝒰.f b0) (𝒰.f b1) ≫
              𝒰.f b1 ≫ ιE) ≫ fst').base p ≠ x₀
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
            exact hW₁_ne_x₀ ((CategoryTheory.Limits.pullback.snd (𝒰.f b0) (𝒰.f b1)).base p)
          · change Set.range ((CategoryTheory.Limits.pullback.fst (𝒰.f b1) (𝒰.f b0) ≫
                g_cov b1) ≫ π₀).base ⊆ (Y'_compl : Set ↥Y')
            rw [CategoryTheory.Category.assoc, hg_π₀ b1]
            rintro _ ⟨p, rfl⟩
            change ((CategoryTheory.Limits.pullback.fst (𝒰.f b1) (𝒰.f b0) ≫
              𝒰.f b1 ≫ ιE) ≫ fst').base p ≠ x₀
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
            exact hW₁_ne_x₀ ((CategoryTheory.Limits.pullback.fst (𝒰.f b1) (𝒰.f b0)).base p)
          · exact False.elim (h_eq rfl)
    refine ⟨AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰 g_cov hg_glue, ?_⟩
    apply AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰
    intro b
    rw [← CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms, hg_π₀ b]
  · 
    have hRange_A : Set.range ιE.base ⊆ Set.range Y'_compl.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨u, rfl⟩
      change f_E.base u ≠ x₀
      intro hu
      exact hHit ⟨u, hu⟩
    let ιE'' : E_sch ⟶ Y'' :=
      AlgebraicGeometry.IsOpenImmersion.lift Y'_compl.ι ιE hRange_A ≫
        CategoryTheory.inv (π₀ ∣_ Y'_compl) ≫ W''.ι
    refine ⟨ιE'', ?_⟩
    dsimp [ιE'']
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.morphismRestrict_ι π₀ Y'_compl,
      CategoryTheory.IsIso.inv_hom_id_assoc,
      AlgebraicGeometry.IsOpenImmersion.lift_fac]

theorem weil_powerSeries_twoBridge_preservation_from_fiber_and_strict_transform (Ω : Type u) [Field Ω]
    (n : ℕ)
    (C C' C'' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C'))
    (q' : C' ⟶ C)
    (Z_blown : Set C)
    (hContract' :
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      ∀ x ∈ Z_blown, ∀ z ∈ q'.base ⁻¹' {x},
        ∃ q₀ : ↥(CategoryTheory.Limits.pullback g' s_Ω),
          (CategoryTheory.Limits.pullback.fst g' s_Ω).base q₀ = z ∧
          ∃ E : Set ↥(CategoryTheory.Limits.pullback g' s_Ω),
            IsTwoBridgeRationalComponent Ω n g' τ' E ∧ q₀ ∈ E ∧
            ((fun q => q'.base ((CategoryTheory.Limits.pullback.fst g' s_Ω).base q)) '' E).Subsingleton)
    (x₀ : C')
    (hX_x₀ : PowerSeries.X ∈ (g'.base x₀).asIdeal)
    (hInj_q'_x₀ : q'.base x₀ ∉ Z_blown → ∀ y : C', q'.base y = q'.base x₀ → y = x₀)
    (π : C'' ⟶ C')
    (hInj_π_compl : ∀ w₁ w₂ : C'', π.base w₁ ≠ x₀ → π.base w₁ = π.base w₂ → w₁ = w₂)
    (τ'' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C''))
    (hτ''_π : ∀ j : Fin n, τ'' j ≫ π = τ' j)
    (π₀ : CategoryTheory.Limits.pullback (π ≫ g')
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) ⟶
      CategoryTheory.Limits.pullback g'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (hπ₀_fst : π₀ ≫ CategoryTheory.Limits.pullback.fst g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      CategoryTheory.Limits.pullback.fst (π ≫ g')
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) ≫ π)
    (hπ₀_snd : π₀ ≫ CategoryTheory.Limits.pullback.snd g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      CategoryTheory.Limits.pullback.snd (π ≫ g')
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (z₀ : ↥(CategoryTheory.Limits.pullback g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hz₀_x₀ : ∀ y : ↥(CategoryTheory.Limits.pullback g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))),
      (CategoryTheory.Limits.pullback.fst g'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))).base y = x₀ ↔
        y = z₀)
    (hBij_compl :
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      Set.BijOn π₀.base
        {q : ↥(CategoryTheory.Limits.pullback (π ≫ g') s_Ω) | π₀.base q ≠ z₀}
        {y : ↥(CategoryTheory.Limits.pullback g' s_Ω) | y ≠ z₀})
    (hStrict_compl :
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      ∀ K' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g' s_Ω),
        closure (π₀.base ⁻¹' (K' \ {z₀})) ∩
          {q : ↥(CategoryTheory.Limits.pullback (π ≫ g') s_Ω) | π₀.base q ≠ z₀} =
          π₀.base ⁻¹' (K' \ {z₀}))
    (hStrict_inj :
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      ∀ K₁' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g' s_Ω),
        ∀ K₂' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g' s_Ω),
          closure (π₀.base ⁻¹' (K₁' \ {z₀})) = closure (π₀.base ⁻¹' (K₂' \ {z₀})) →
            K₁' = K₂')
    (k_exc : ℕ)
    (E''_exc : Fin k_exc → Set ↥(CategoryTheory.Limits.pullback (π ≫ g')
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hFib_cov : π₀.base ⁻¹' {z₀} = ⋃ a : Fin k_exc, E''_exc a)
    (hExc_tb : ∀ a : Fin k_exc,
      IsTwoBridgeRationalComponent Ω n (π ≫ g') τ'' (E''_exc a))
    (hIrred_Y'' :
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      irreducibleComponents ↥(CategoryTheory.Limits.pullback (π ≫ g') s_Ω) =
        (⋃ a : Fin k_exc, {E''_exc a}) ∪
          (fun K' => closure (π₀.base ⁻¹' (K' \ {z₀}))) ''
            irreducibleComponents ↥(CategoryTheory.Limits.pullback g' s_Ω))
    (b₀ b₁ : ↥(CategoryTheory.Limits.pullback (π ≫ g')
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hb_ne : b₀ ≠ b₁)
    (hBridge_eq :
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      (⋃ K' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g' s_Ω),
        closure (π₀.base ⁻¹' (K' \ {z₀}))) ∩ π₀.base ⁻¹' {z₀} = {b₀, b₁})
    (hLift_rat :
      let s_Ω := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
      ∀ (E_sch : AlgebraicGeometry.Scheme.{u})
        (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g' s_Ω)
        (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
        AlgebraicGeometry.IsClosedImmersion ιE →
        AlgebraicGeometry.IsIntegral E_sch →
        ιE ≫ CategoryTheory.Limits.pullback.snd g' s_Ω =
          isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom →
        ∃ (ιE'' : E_sch ⟶ CategoryTheory.Limits.pullback (π ≫ g') s_Ω),
          AlgebraicGeometry.IsClosedImmersion ιE'' ∧
          ιE'' ≫ π₀ = ιE ∧
          Set.range ιE''.base =
            closure (π₀.base ⁻¹' {q ∈ Set.range ιE.base |
              (CategoryTheory.Limits.pullback.fst g' s_Ω).base q ≠ x₀}) ∧
          (Set.range ιE''.base ∩ {q : ↥(CategoryTheory.Limits.pullback (π ≫ g') s_Ω) |
            π.base ((CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω).base q) = x₀}).Subsingleton) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∀ x ∈ insert (q'.base x₀) Z_blown, ∀ z ∈ (π ≫ q').base ⁻¹' {x},
      ∃ q₀ : ↥(CategoryTheory.Limits.pullback (π ≫ g') s_Ω),
        (CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω).base q₀ = z ∧
        ∃ E : Set ↥(CategoryTheory.Limits.pullback (π ≫ g') s_Ω),
          IsTwoBridgeRationalComponent Ω n (π ≫ g') τ'' E ∧ q₀ ∈ E ∧
          ((fun q => (π ≫ q').base
            ((CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω).base q)) '' E).Subsingleton :=
by
  intro s_Ω x hx z hz
  let Y' := CategoryTheory.Limits.pullback g' s_Ω
  let fst' := CategoryTheory.Limits.pullback.fst g' s_Ω
  let Y'' := CategoryTheory.Limits.pullback (π ≫ g') s_Ω
  let fst'' := CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω
  have hπ₀_fst_pt : ∀ q : ↥Y'', fst'.base (π₀.base q) = π.base (fst''.base q) := by
    intro q
    change (π₀ ≫ fst').base q = (fst'' ≫ π).base q
    rw [hπ₀_fst]
  have hq_fib_iff : ∀ q : ↥Y'', π₀.base q = z₀ ↔ π.base (fst''.base q) = x₀ := by
    intro q
    rw [← hz₀_x₀ (π₀.base q), hπ₀_fst_pt q]
  have hz_eq : q'.base (π.base z) = x := hz
  by_cases hz_x₀ : π.base z = x₀
  · have hBotPrime : (⊥ : Ideal Ω).IsPrime :=
      ⟨bot_ne_top, fun {a b} hab => by
        rw [Ideal.mem_bot, mul_eq_zero] at hab
        rcases hab with rfl | rfl
        · left; exact Ideal.zero_mem ⊥
        · right; exact Ideal.zero_mem ⊥⟩
    let pt_Ω : PrimeSpectrum Ω := ⟨⊥, hBotPrime⟩
    have hEq_pt : (π ≫ g').base z = s_Ω.base pt_Ω := by
      apply PrimeSpectrum.ext
      ext φ
      change φ ∈ (g'.base (π.base z)).asIdeal ↔
        φ ∈ Ideal.comap (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) pt_Ω.asIdeal
      rw [hz_x₀]
      change φ ∈ (g'.base x₀).asIdeal ↔ PowerSeries.constantCoeff φ = 0
      constructor
      · intro hφ
        by_contra hc
        have hUnit : IsUnit φ :=
          PowerSeries.isUnit_iff_constantCoeff.mpr (IsUnit.mk0 _ hc)
        exact (g'.base x₀).isPrime.ne_top
          ((g'.base x₀).asIdeal.eq_top_of_isUnit_mem hφ hUnit)
      · intro hc
        obtain ⟨ψ, rfl⟩ := PowerSeries.X_dvd_iff.mpr hc
        exact (g'.base x₀).asIdeal.mul_mem_right ψ hX_x₀
    obtain ⟨q₀, hq₀_z, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := π ≫ g') (g := s_Ω) z pt_Ω hEq_pt
    have hq₀_fib : q₀ ∈ π₀.base ⁻¹' {z₀} := by
      change π₀.base q₀ = z₀
      rw [hq_fib_iff, hq₀_z]
      exact hz_x₀
    rw [hFib_cov, Set.mem_iUnion] at hq₀_fib
    obtain ⟨a, hq₀_a⟩ := hq₀_fib
    refine ⟨q₀, hq₀_z, E''_exc a, hExc_tb a, hq₀_a, ?_⟩
    rintro _ ⟨q₁, hq₁, rfl⟩ _ ⟨q₂, hq₂, rfl⟩
    have hq₁_x₀ : π.base (fst''.base q₁) = x₀ := by
      rw [← hq_fib_iff]
      have hmem : q₁ ∈ ⋃ b : Fin k_exc, E''_exc b := Set.mem_iUnion.mpr ⟨a, hq₁⟩
      rw [← hFib_cov] at hmem
      exact hmem
    have hq₂_x₀ : π.base (fst''.base q₂) = x₀ := by
      rw [← hq_fib_iff]
      have hmem : q₂ ∈ ⋃ b : Fin k_exc, E''_exc b := Set.mem_iUnion.mpr ⟨a, hq₂⟩
      rw [← hFib_cov] at hmem
      exact hmem
    change q'.base (π.base (fst''.base q₁)) = q'.base (π.base (fst''.base q₂))
    rw [hq₁_x₀, hq₂_x₀]
  · have hxZ : x ∈ Z_blown := by
      by_contra hx_not_Z
      have hx_eq : x = q'.base x₀ := (Set.mem_insert_iff.mp hx).resolve_right hx_not_Z
      have hx₀_not_Z : q'.base x₀ ∉ Z_blown := hx_eq ▸ hx_not_Z
      have hqz_eq : q'.base (π.base z) = q'.base x₀ := hz_eq.trans hx_eq
      exact hz_x₀ (hInj_q'_x₀ hx₀_not_Z (π.base z) hqz_eq)
    obtain ⟨q'_0, hq'_0_fst, E_old, hTB_old, hq'_0_E, hSub_old⟩ :=
      hContract' x hxZ (π.base z) hz_eq
    have hq'_0_ne : q'_0 ≠ z₀ := by
      intro h_eq
      exact hz_x₀ (hq'_0_fst.symm.trans ((hz₀_x₀ q'_0).mpr h_eq))
    obtain ⟨q₀, hq₀_ne_mem, hq₀_eq⟩ := hBij_compl.surjOn hq'_0_ne
    have hq₀_ne : π₀.base q₀ ≠ z₀ := hq₀_ne_mem
    have hq₀_π_eq : π.base (fst''.base q₀) = π.base z := by
      rw [← hπ₀_fst_pt q₀, hq₀_eq, hq'_0_fst]
    have hq₀_z : fst''.base q₀ = z :=
      hInj_π_compl (fst''.base q₀) z (by rw [hq₀_π_eq]; exact hz_x₀) hq₀_π_eq
    obtain ⟨hE_irred, ⟨E_sch, ιE, isoP1, hCl_E, hInt_E, hRange_E, hE_snd⟩,
      hUnmark_old, ⟨p'₁, p'₂, hp'₁₂_ne, hp'₁_E, hp'₂_E,
        ⟨K'₁, hK'₁_irred, hK'₁_ne, hp'₁_K₁⟩,
        ⟨K'₂, hK'₂_irred, hK'₂_ne, hp'₂_K₂⟩, hOnly_old⟩⟩ := hTB_old
    obtain ⟨ιE'', hCl_E'', hιE''_π₀, hRange_E'', hSub_fib⟩ :=
      hLift_rat E_sch ιE isoP1 hCl_E hInt_E hE_snd
    let E_tilde : Set ↥Y'' := Set.range ιE''.base
    have hSet_diff :
        {q ∈ Set.range ιE.base | fst'.base q ≠ x₀} = E_old \ {z₀} := by
      ext y
      change (y ∈ Set.range ιE.base ∧ fst'.base y ≠ x₀) ↔ (y ∈ E_old ∧ y ≠ z₀)
      rw [hRange_E]
      exact and_congr_right fun _ => not_congr (hz₀_x₀ y)
    have hE_tilde_eq : E_tilde = closure (π₀.base ⁻¹' (E_old \ {z₀})) := by
      change Set.range ιE''.base = _
      rw [hRange_E'', hSet_diff]
    have hFib_set_eq :
        {q : ↥Y'' | π.base (fst''.base q) = x₀} = π₀.base ⁻¹' {z₀} := by
      ext q
      change π.base (fst''.base q) = x₀ ↔ π₀.base q = z₀
      exact (hq_fib_iff q).symm
    have hSub_F'' : (E_tilde ∩ π₀.base ⁻¹' {z₀}).Subsingleton := by
      change (Set.range ιE''.base ∩ π₀.base ⁻¹' {z₀}).Subsingleton
      rwa [← hFib_set_eq]
    have hMap_E : ∀ q ∈ E_tilde, π₀.base q ∈ E_old := by
      rintro _ ⟨u, rfl⟩
      rw [← hRange_E]
      refine ⟨u, ?_⟩
      change ιE.base u = (ιE'' ≫ π₀).base u
      rw [hιE''_π₀]
    have hq₀_E_tilde : q₀ ∈ E_tilde := by
      rw [hE_tilde_eq]
      apply subset_closure
      change π₀.base q₀ ∈ E_old ∧ π₀.base q₀ ≠ z₀
      exact ⟨hq₀_eq ▸ hq'_0_E, hq₀_ne⟩
    have hSub_tilde :
        ((fun q => (π ≫ q').base (fst''.base q)) '' E_tilde).Subsingleton := by
      rintro _ ⟨w₁, hw₁, rfl⟩ _ ⟨w₂, hw₂, rfl⟩
      apply hSub_old
      · refine ⟨π₀.base w₁, hMap_E w₁ hw₁, ?_⟩
        change q'.base (fst'.base (π₀.base w₁)) = q'.base (π.base (fst''.base w₁))
        rw [hπ₀_fst_pt]
      · refine ⟨π₀.base w₂, hMap_E w₂ hw₂, ?_⟩
        change q'.base (fst'.base (π₀.base w₂)) = q'.base (π.base (fst''.base w₂))
        rw [hπ₀_fst_pt]
    refine ⟨q₀, hq₀_z, E_tilde, ?_, hq₀_E_tilde, hSub_tilde⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hIrred_Y'']
      exact Or.inr ⟨E_old, hE_irred, hE_tilde_eq.symm⟩
    · refine ⟨E_sch, ιE'', isoP1, hCl_E'', hInt_E, rfl, ?_⟩
      rw [← hπ₀_snd, ← CategoryTheory.Category.assoc, hιE''_π₀, hE_snd]
    · rintro q hq j ⟨b, hb⟩
      have h_app : π.base ((τ'' j).base b) = π.base (fst''.base q) :=
        congrArg (fun u => π.base u) hb
      have h_lhs : π.base ((τ'' j).base b) = (τ' j).base b := by
        change (τ'' j ≫ π).base b = (τ' j).base b
        rw [hτ''_π j]
      rw [h_lhs, ← hπ₀_fst_pt q] at h_app
      exact hUnmark_old (π₀.base q) (hMap_E q hq) j ⟨b, h_app⟩
    · have hExc_ne : ∀ a : Fin k_exc, E''_exc a ≠ E_tilde := by
        intro a h_eq
        have hmem : q₀ ∈ ⋃ b : Fin k_exc, E''_exc b :=
          Set.mem_iUnion.mpr ⟨a, h_eq.symm ▸ hq₀_E_tilde⟩
        rw [← hFib_cov] at hmem
        exact hq₀_ne hmem
      have hCl_proj : ∀ K' ∈ irreducibleComponents ↥Y',
          ∀ w ∈ closure (π₀.base ⁻¹' (K' \ {z₀})), π₀.base w ∈ K' := by
        intro K' hK' w hw
        have hCl_K' : IsClosed (π₀.base ⁻¹' K') :=
          (isClosed_of_mem_irreducibleComponents K' hK').preimage π₀.base.hom.continuous_toFun
        exact closure_minimal (fun u (hu : π₀.base u ∈ K' \ {z₀}) => hu.1) hCl_K' hw
      have hExt_compl : ∀ q ∈ E_tilde, π₀.base q ≠ z₀ →
          (∃ E' ∈ irreducibleComponents ↥Y'', E' ≠ E_tilde ∧ q ∈ E') →
          π₀.base q = p'₁ ∨ π₀.base q = p'₂ := by
        rintro q hq_E hq_ne ⟨E', hE'_irred, hE'_ne, hq_E'⟩
        rw [hIrred_Y''] at hE'_irred
        rcases hE'_irred with hExc | ⟨K', hK'_irred, rfl⟩
        · rw [Set.mem_iUnion] at hExc
          obtain ⟨a, ha⟩ := hExc
          rw [Set.mem_singleton_iff] at ha
          subst ha
          have hmem : q ∈ ⋃ b : Fin k_exc, E''_exc b := Set.mem_iUnion.mpr ⟨a, hq_E'⟩
          rw [← hFib_cov] at hmem
          exact False.elim (hq_ne hmem)
        · have hK'_ne : K' ≠ E_old := by
            rintro rfl
            exact hE'_ne hE_tilde_eq.symm
          exact hOnly_old (π₀.base q) (hMap_E q hq_E)
            ⟨K', hK'_irred, hK'_ne, hCl_proj K' hK'_irred q hq_E'⟩
      by_cases hz₀_E : z₀ ∈ E_old
      · have hz₀_range : z₀ ∈ Set.range ιE.base := hRange_E.symm ▸ hz₀_E
        obtain ⟨u₀, hu₀⟩ := hz₀_range
        let q_exc : ↥Y'' := ιE''.base u₀
        have hq_exc_E : q_exc ∈ E_tilde := ⟨u₀, rfl⟩
        have hq_exc_z₀ : π₀.base q_exc = z₀ := by
          change (ιE'' ≫ π₀).base u₀ = z₀
          rw [hιE''_π₀, hu₀]
        have hq_exc_uniq : ∀ w : ↥Y'', w ∈ E_tilde → π₀.base w = z₀ → w = q_exc := by
          intro w hw_E hw_z₀
          exact hSub_F'' ⟨hw_E, hw_z₀⟩ ⟨hq_exc_E, hq_exc_z₀⟩
        have hq_exc_fib : q_exc ∈ π₀.base ⁻¹' {z₀} := hq_exc_z₀
        rw [hFib_cov, Set.mem_iUnion] at hq_exc_fib
        obtain ⟨a₀, hq_exc_a₀⟩ := hq_exc_fib
        have hb_other_ex : ∃ b_other : ↥Y'',
            b_other ∈ ({b₀, b₁} : Set ↥Y'') ∧ b_other ≠ q_exc := by
          by_cases hb₀ : b₀ = q_exc
          · exact ⟨b₁, Or.inr rfl, fun hb₁ => hb_ne (hb₀.trans hb₁.symm)⟩
          · exact ⟨b₀, Or.inl rfl, hb₀⟩
        obtain ⟨b_other, hb_mem, hb_ne_exc⟩ := hb_other_ex
        rw [← hBridge_eq] at hb_mem
        obtain ⟨hb_un, hb_z₀⟩ := hb_mem
        rw [Set.mem_iUnion₂] at hb_un
        obtain ⟨K'_br, hK'_br_irred, hb_cl⟩ := hb_un
        have hK'_br_ne : K'_br ≠ E_old := by
          rintro rfl
          rw [← hE_tilde_eq] at hb_cl
          exact hb_ne_exc (hq_exc_uniq b_other hb_cl hb_z₀)
        have hz₀_K_br : z₀ ∈ K'_br := by
          have h := hCl_proj K'_br hK'_br_irred b_other hb_cl
          rwa [hb_z₀] at h
        have hz₀_p : z₀ = p'₁ ∨ z₀ = p'₂ :=
          hOnly_old z₀ hz₀_E ⟨K'_br, hK'_br_irred, hK'_br_ne, hz₀_K_br⟩
        have hExt_node : ∃ (p'_ext : ↥Y') (K'_ext : Set ↥Y'),
            p'_ext ∈ E_old ∧ p'_ext ≠ z₀ ∧
            (∀ y : ↥Y', (y = p'₁ ∨ y = p'₂) → y ≠ z₀ → y = p'_ext) ∧
            K'_ext ∈ irreducibleComponents ↥Y' ∧ K'_ext ≠ E_old ∧ p'_ext ∈ K'_ext := by
          rcases hz₀_p with rfl | rfl
          · refine ⟨p'₂, K'₂, hp'₂_E, hp'₁₂_ne.symm, ?_, hK'₂_irred, hK'₂_ne, hp'₂_K₂⟩
            rintro y (rfl | rfl) hy_ne
            · exact False.elim (hy_ne rfl)
            · rfl
          · refine ⟨p'₁, K'₁, hp'₁_E, hp'₁₂_ne, ?_, hK'₁_irred, hK'₁_ne, hp'₁_K₁⟩
            rintro y (rfl | rfl) hy_ne
            · rfl
            · exact False.elim (hy_ne rfl)
        obtain ⟨p'_ext, K'_ext, hp'_ext_E, hp'_ext_ne, hOnly_ext,
          hK'_ext_irred, hK'_ext_ne, hp'_ext_K⟩ := hExt_node
        obtain ⟨q₂, hq₂_ne_mem, hq₂_eq⟩ := hBij_compl.surjOn hp'_ext_ne
        have hq₂_ne : π₀.base q₂ ≠ z₀ := hq₂_ne_mem
        have hq_exc_ne_q₂ : q_exc ≠ q₂ := by
          intro h_eq
          apply hq₂_ne
          rw [← h_eq, hq_exc_z₀]
        have hq₂_E : q₂ ∈ E_tilde := by
          rw [hE_tilde_eq]
          apply subset_closure
          exact ⟨hq₂_eq ▸ hp'_ext_E, hq₂_ne⟩
        refine ⟨q_exc, q₂, hq_exc_ne_q₂, hq_exc_E, hq₂_E,
          ⟨E''_exc a₀, (hExc_tb a₀).1, hExc_ne a₀, hq_exc_a₀⟩,
          ⟨closure (π₀.base ⁻¹' (K'_ext \ {z₀})), ?_, ?_, ?_⟩, ?_⟩
        · rw [hIrred_Y'']
          exact Or.inr ⟨K'_ext, hK'_ext_irred, rfl⟩
        · intro h_eq
          rw [hE_tilde_eq] at h_eq
          exact hK'_ext_ne (hStrict_inj K'_ext hK'_ext_irred E_old hE_irred h_eq)
        · apply subset_closure
          exact ⟨hq₂_eq ▸ hp'_ext_K, hq₂_ne⟩
        · intro q hq_E hExt
          by_cases hq_z₀ : π₀.base q = z₀
          · exact Or.inl (hq_exc_uniq q hq_E hq_z₀)
          · have hp_or := hExt_compl q hq_E hq_z₀ hExt
            have hp_eq : π₀.base q = π₀.base q₂ :=
              (hOnly_ext (π₀.base q) hp_or hq_z₀).trans hq₂_eq.symm
            exact Or.inr (hBij_compl.injOn hq_z₀ hq₂_ne hp_eq)
      · have hp'₁_ne : p'₁ ≠ z₀ := fun h => hz₀_E (h ▸ hp'₁_E)
        have hp'₂_ne : p'₂ ≠ z₀ := fun h => hz₀_E (h ▸ hp'₂_E)
        obtain ⟨q₁, hq₁_ne_mem, hq₁_eq⟩ := hBij_compl.surjOn hp'₁_ne
        obtain ⟨q₂, hq₂_ne_mem, hq₂_eq⟩ := hBij_compl.surjOn hp'₂_ne
        have hq₁_ne : π₀.base q₁ ≠ z₀ := hq₁_ne_mem
        have hq₂_ne : π₀.base q₂ ≠ z₀ := hq₂_ne_mem
        have hq₁₂_ne : q₁ ≠ q₂ := by
          intro h_eq
          apply hp'₁₂_ne
          rw [← hq₁_eq, ← hq₂_eq, h_eq]
        have hq₁_E : q₁ ∈ E_tilde := by
          rw [hE_tilde_eq]
          apply subset_closure
          exact ⟨hq₁_eq ▸ hp'₁_E, hq₁_ne⟩
        have hq₂_E : q₂ ∈ E_tilde := by
          rw [hE_tilde_eq]
          apply subset_closure
          exact ⟨hq₂_eq ▸ hp'₂_E, hq₂_ne⟩
        refine ⟨q₁, q₂, hq₁₂_ne, hq₁_E, hq₂_E,
          ⟨closure (π₀.base ⁻¹' (K'₁ \ {z₀})), ?_, ?_, ?_⟩,
          ⟨closure (π₀.base ⁻¹' (K'₂ \ {z₀})), ?_, ?_, ?_⟩, ?_⟩
        · rw [hIrred_Y'']
          exact Or.inr ⟨K'₁, hK'₁_irred, rfl⟩
        · intro h_eq
          rw [hE_tilde_eq] at h_eq
          exact hK'₁_ne (hStrict_inj K'₁ hK'₁_irred E_old hE_irred h_eq)
        · apply subset_closure
          exact ⟨hq₁_eq ▸ hp'₁_K₁, hq₁_ne⟩
        · rw [hIrred_Y'']
          exact Or.inr ⟨K'₂, hK'₂_irred, rfl⟩
        · intro h_eq
          rw [hE_tilde_eq] at h_eq
          exact hK'₂_ne (hStrict_inj K'₂ hK'₂_irred E_old hE_irred h_eq)
        · apply subset_closure
          exact ⟨hq₂_eq ▸ hp'₂_K₂, hq₂_ne⟩
        · intro q hq_E hExt
          have hq_ne : π₀.base q ≠ z₀ := fun h => hz₀_E (h ▸ hMap_E q hq_E)
          rcases hExt_compl q hq_E hq_ne hExt with hp₁ | hp₂
          · exact Or.inl (hBij_compl.injOn hq_ne hq₁_ne (hp₁.trans hq₁_eq.symm))
          · exact Or.inr (hBij_compl.injOn hq_ne hq₂_ne (hp₂.trans hq₂_eq.symm))

theorem weil_powerSeries_single_node_blowup_step (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C C' : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C'))
    (q' : C' ⟶ C)
    (Z_blown : Set C)
    (r : ℕ) (pts : Fin r → C') (mults : Fin r → ℕ)
    (hPart : IsPartialPowerSeriesNodeResolution Ω n g τ g' τ' q' Z_blown r pts mults)
    (i₀ : Fin r)
    (M_m : AlgebraicGeometry.Scheme.{u})
    (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))))
    (hLoc : IsLocalPowerSeriesNodeBlowupModel Ω (mults i₀) p_m) :
    ∃ (C'' : AlgebraicGeometry.Scheme.{u})
      (g'' : C'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ'' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C''))
      (q'' : C'' ⟶ C)
      (Z_blown'' : Set C)
      (r'' : ℕ) (pts'' : Fin r'' → C'') (mults'' : Fin r'' → ℕ),
      IsPartialPowerSeriesNodeResolution Ω n g τ g'' τ'' q'' Z_blown'' r'' pts'' mults'' ∧
      (∑ i : Fin r'', mults'' i / 2) < (∑ i : Fin r, mults i / 2) :=
by
  clear hStab
  obtain ⟨hInt', hFlat', hProp', hLFP', hSurj', hSmK', hτ'_g, hDisj_τ', hSm_τ',
    hq'_g, hτ'_q, hProp_q', hSurj_q', hApp_q', hConn_q', hZ_fin, hZ_pts,
    ⟨U_iso, hU_iso_eq, hIso_q'⟩, hContract', hInj_pts, hMults, hRem'⟩ := hPart
  obtain ⟨hNonSm, hx₀_cl, hxbar₀_cl, hX_x₀, hMax_Inod, hRes_Pm,
    U, hAffU, p_x₀, A', v'₀, e_U, q_m,
    hp_x₀, hMax_px₀, hMax_v'₀, hDom_A, hNoeth_A,
    hX_mem, hX_ne, hFlat_A, hFinType_A,
    hEt_e, hEt_q, hComm_eq, hev'₀, hqv'₀, hMap_e, hMap_q,
    hUniq_e, hUniq_q, hRes_A, hRes_A'⟩ :=
    weil_powerSeries_nodal_point_closed_and_shrunk_roof Ω C C' g' q'
      hInt' hFlat' hLFP' hProp_q' (pts i₀) (mults i₀) (hMults i₀).2
  haveI : p_x₀.asIdeal.IsMaximal := hMax_px₀
  haveI : v'₀.asIdeal.IsMaximal := hMax_v'₀
  haveI : IsDomain ↑(C'.presheaf.obj (Opposite.op U)) := hDom_A
  haveI : IsNoetherianRing ↑(C'.presheaf.obj (Opposite.op U)) := hNoeth_A
  obtain ⟨U_tilde, π_U, hBlU⟩ :=
    weil_powerSeries_affine_maximal_ideal_blowup Ω ↑(C'.presheaf.obj (Opposite.op U))
      (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom
      hFlat_A hFinType_A p_x₀.asIdeal hX_mem hX_ne
  obtain ⟨C'', π, ι_tilde, ι_compl, Φ_A',
    hOpen_tilde, hOpen_compl, _hCov_C'', hπ_tilde, hπ_compl,
    hPre_U, hPre_compl, hIso_compl, hΦ_snd,
    hInt'', hProp_π, hSurj_π, hFlat'', hLFP'', hApp_π, hConn_π⟩ :=
    weil_powerSeries_blowup_etale_baseChange_and_gluing Ω C' U_tilde M_m g'
      hInt' hFlat' hProp' hLFP' (pts i₀) hx₀_cl U hAffU p_x₀ hp_x₀ hDom_A
      hX_mem hX_ne hRes_A π_U hBlU (mults i₀) hMax_Inod hRes_Pm p_m hLoc
      A' v'₀ e_U q_m hEt_e hEt_q hComm_eq hev'₀ hqv'₀ hMap_e hMap_q hRes_A'
  obtain ⟨r'', pts'', mults'', hInj_pts'', hMults'', hRem'', hWeightLt⟩ :=
    weil_powerSeries_blowup_nodal_roof_transfer_and_weight_drop Ω C' C'' U_tilde M_m g'
      r pts mults hInj_pts hMults hRem' i₀ hx₀_cl U hAffU p_x₀ hp_x₀ hRes_A π_U
      hMax_Inod hRes_Pm p_m hLoc A' v'₀ e_U q_m hEt_e hEt_q hComm_eq hev'₀ hqv'₀
      hUniq_e hUniq_q hRes_A' π ι_tilde ι_compl Φ_A' hOpen_tilde hOpen_compl
      hπ_tilde hπ_compl hPre_U hPre_compl hΦ_snd hFlat'' hLFP''
  let U_compl : C'.Opens := ⟨({pts i₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩
  have hx₀_not_τ' : ∀ j : Fin n, pts i₀ ∉ Set.range (τ' j).base := by
    rintro j ⟨b, hb⟩
    obtain ⟨V, hbV, hSmV⟩ := hSm_τ' j b
    rw [hb] at hbV
    exact hNonSm V hbV hSmV
  have hRange_τ' : ∀ j : Fin n, Set.range (τ' j).base ⊆ Set.range U_compl.ι.base := by
    intro j
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨b, rfl⟩
    change (τ' j).base b ≠ pts i₀
    intro h_eq
    exact hx₀_not_τ' j ⟨b, h_eq⟩
  let τ'' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C'') :=
    fun j => AlgebraicGeometry.IsOpenImmersion.lift U_compl.ι (τ' j) (hRange_τ' j) ≫ ι_compl
  have hτ''_π : ∀ j : Fin n, τ'' j ≫ π = τ' j := by
    intro j
    dsimp [τ'']
    rw [CategoryTheory.Category.assoc, hπ_compl]
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac U_compl.ι (τ' j) (hRange_τ' j)
  have hx₀_not_π_τ'' : ∀ j : Fin n, pts i₀ ∉ Set.range (τ'' j ≫ π).base := by
    intro j
    rw [hτ''_π j]
    exact hx₀_not_τ' j
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let π₀ : CategoryTheory.Limits.pullback (π ≫ g') s_Ω ⟶
      CategoryTheory.Limits.pullback g' s_Ω :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω ≫ π)
      (CategoryTheory.Limits.pullback.snd (π ≫ g') s_Ω)
      (by
        rw [CategoryTheory.Category.assoc]
        exact CategoryTheory.Limits.pullback.condition)
  have hπ₀_fst : π₀ ≫ CategoryTheory.Limits.pullback.fst g' s_Ω =
      CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω ≫ π :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ₀_snd : π₀ ≫ CategoryTheory.Limits.pullback.snd g' s_Ω =
      CategoryTheory.Limits.pullback.snd (π ≫ g') s_Ω :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  obtain ⟨z₀, k_exc, E''_exc, b₀, b₁,
    hz₀_x₀, _hz₀_cl, hBij_compl, hStrict_compl, hStrict_inj,
    _hk_pos, hFib_cov, hExc_tb, hIrred_Y'', _hb₀_mem, _hb₁_mem, hb_ne, hBridge_eq⟩ :=
    weil_powerSeries_blowup_special_fiber_exceptional_and_bridge_locus
      Ω n C' C'' U_tilde M_m g' hProp' hLFP' (pts i₀) hx₀_cl hX_x₀ U hAffU p_x₀ hp_x₀ hRes_A
      π_U (mults i₀) hMax_Inod hRes_Pm p_m hLoc A' v'₀ e_U q_m hEt_e hEt_q hComm_eq
      hev'₀ hqv'₀ hUniq_e hUniq_q hRes_A' π ι_tilde Φ_A' hOpen_tilde hπ_tilde hPre_U
      hIso_compl hProp_π hΦ_snd τ'' hx₀_not_π_τ'' π₀ hπ₀_fst hπ₀_snd
  have hLift_rat :=
    fun (E_sch : AlgebraicGeometry.Scheme.{u})
        (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g' s_Ω)
        (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left)
        (hCl_E : AlgebraicGeometry.IsClosedImmersion ιE)
        (hInt_E : AlgebraicGeometry.IsIntegral E_sch)
        (hE_snd : ιE ≫ CategoryTheory.Limits.pullback.snd g' s_Ω =
          isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) =>
      weil_powerSeries_blowup_rational_component_strict_transform_lift
        Ω C' C'' U_tilde g' (pts i₀) hx₀_cl U hAffU p_x₀ hp_x₀ π_U hBlU π ι_tilde hπ_tilde
        hIso_compl hProp_π π₀ hπ₀_fst hπ₀_snd E_sch ιE isoP1 hCl_E hInt_E hE_snd
  clear _hCov_C'' hΦ_snd Φ_A' hOpen_tilde hπ_tilde hPre_U ι_tilde hBlU π_U U_tilde
    hLoc p_m M_m hEt_q hComm_eq hqv'₀ hMap_q hUniq_q q_m hMax_Inod hRes_Pm
  have hInj_of_iso_res : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (W : Y.Opens),
      CategoryTheory.IsIso (f ∣_ W) →
      ∀ (x₁ x₂ : X), f.base x₁ ∈ W → f.base x₁ = f.base x₂ → x₁ = x₂ := by
    intro X Y f W hIso_fW x₁ x₂ hx₁ h_eq
    haveI : CategoryTheory.IsIso (f ∣_ W) := hIso_fW
    let W_X : X.Opens := (TopologicalSpace.Opens.map f.base).obj W
    have hx₁_WX : x₁ ∈ (W_X : Set X) := hx₁
    have hx₂_WX : x₂ ∈ (W_X : Set X) := by
      change f.base x₂ ∈ W
      rwa [← h_eq]
    rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hx₁_WX hx₂_WX
    rcases hx₁_WX with ⟨u₁, rfl⟩
    rcases hx₂_WX with ⟨u₂, rfl⟩
    have hfW_eq : (f ∣_ W).base u₁ = (f ∣_ W).base u₂ := by
      apply W.ι.isOpenEmbedding.injective
      have h1 : W.ι.base ((f ∣_ W).base u₁) = ((f ∣_ W) ≫ W.ι).base u₁ := rfl
      have h2 : W.ι.base ((f ∣_ W).base u₂) = ((f ∣_ W) ≫ W.ι).base u₂ := rfl
      rw [h1, h2, AlgebraicGeometry.morphismRestrict_ι]
      exact h_eq
    have hu_eq : u₁ = u₂ := by
      have h_inv := congrArg (CategoryTheory.inv (f ∣_ W)).base hfW_eq
      change ((f ∣_ W) ≫ CategoryTheory.inv (f ∣_ W)).base u₁ =
        ((f ∣_ W) ≫ CategoryTheory.inv (f ∣_ W)).base u₂ at h_inv
      simpa [CategoryTheory.IsIso.hom_inv_id] using h_inv
    rw [hu_eq]
  have hInj_q'_x₀ : q'.base (pts i₀) ∉ Z_blown →
      ∀ y : C', q'.base y = q'.base (pts i₀) → y = pts i₀ := by
    intro hxbar_not_Z y hy_eq
    have hy_Uiso : q'.base y ∈ U_iso := by
      change q'.base y ∈ (U_iso : Set C)
      rw [hy_eq, hU_iso_eq]
      exact hxbar_not_Z
    exact hInj_of_iso_res q' U_iso hIso_q' y (pts i₀) hy_Uiso hy_eq
  have hInj_π_compl : ∀ w₁ w₂ : C'', π.base w₁ ≠ pts i₀ → π.base w₁ = π.base w₂ → w₁ = w₂ := by
    intro w₁ w₂ hw₁_ne hw_eq
    exact hInj_of_iso_res π U_compl hIso_compl w₁ w₂ hw₁_ne hw_eq
  have hContract'' :=
    weil_powerSeries_twoBridge_preservation_from_fiber_and_strict_transform
      Ω n C C' C'' g' τ' q' Z_blown hContract' (pts i₀) hX_x₀ hInj_q'_x₀ π hInj_π_compl
      τ'' hτ''_π π₀ hπ₀_fst hπ₀_snd z₀ hz₀_x₀ hBij_compl hStrict_compl hStrict_inj
      k_exc E''_exc hFib_cov hExc_tb hIrred_Y'' b₀ b₁ hb_ne hBridge_eq hLift_rat
  have hIso_res_le : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (W₁ W₂ : Y.Opens),
      W₁ ≤ W₂ → CategoryTheory.IsIso (f ∣_ W₂) → CategoryTheory.IsIso (f ∣_ W₁) := by
    intro X Y f W₁ W₂ hle hIso₂
    haveI : CategoryTheory.IsIso (f ∣_ W₂) := hIso₂
    let WX₁ : X.Opens := (TopologicalSpace.Opens.map f.base).obj W₁
    let WX₂ : X.Opens := (TopologicalSpace.Opens.map f.base).obj W₂
