        apply TensorProduct.ext'
        intro b c
        let h' : (TopologicalSpace.Opens.map fst.base).obj U₁ ≤
          (TopologicalSpace.Opens.map fst.base).obj U₀ :=
          (TopologicalSpace.Opens.map fst.base).monotone h
