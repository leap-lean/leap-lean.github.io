        obtain ⟨qm₁, qm₂, hqm_ne, hqm₁_in, hqm₂_in, hqm₁_ext, hqm₂_ext, hqm_only⟩ := hExc_two a
        have hqm₁_Fm : qm₁ ∈ Set.range j_m.base := by
          rw [hRange_jm, hFm_eq]
          exact Set.mem_iUnion.mpr ⟨a, hqm₁_in⟩
        have hqm₂_Fm : qm₂ ∈ Set.range j_m.base := by
          rw [hRange_jm, hFm_eq]
          exact Set.mem_iUnion.mpr ⟨a, hqm₂_in⟩
        rcases hqm₁_Fm with ⟨u₁, hu₁⟩
        rcases hqm₂_Fm with ⟨u₂, hu₂⟩
        refine ⟨j''.base u₁, j''.base u₂, ?_,
          (hMem_exc_iff a u₁).mpr (hu₁.symm ▸ hqm₁_in),
          (hMem_exc_iff a u₂).mpr (hu₂.symm ▸ hqm₂_in),
          (hExt_iff u₁).mpr (hu₁.symm ▸ hqm₁_ext),
          (hExt_iff u₂).mpr (hu₂.symm ▸ hqm₂_ext), ?_⟩
        · intro h_eq
          have hu_eq : u₁ = u₂ := hj''_inj h_eq
          exact hqm_ne (hu₁.symm.trans ((congrArg j_m.base hu_eq).trans hu₂))
        · intro q hq hq_ext
          have hq_fib : q ∈ Set.range j''.base := by
            rw [hRange_j'', hFib_cov]
            exact Set.mem_iUnion.mpr ⟨a, hq⟩
          rcases hq_fib with ⟨u, rfl⟩
          rcases hqm_only (j_m.base u) ((hMem_exc_iff a u).mp hq) ((hExt_iff u).mp hq_ext) with
            h_eq1 | h_eq2
          · exact Or.inl (congrArg j''.base (hjm_inj (h_eq1.trans hu₁.symm)))
          · exact Or.inr (congrArg j''.base (hjm_inj (h_eq2.trans hu₂.symm)))
    exact ⟨E''_exc, b₀, b₁, hFib_cov, hExc_tb, hIrred_Y'', hb₀_mem, hb₁_mem, hb_ne, hBridge_eq⟩
  clear hProp_π
  obtain ⟨hm, _, _, _, _, _, _, _, _, _, _, _,
    k_exc, E_exc, ι_exc, iso_exc, L_br,
    hk_pos, hExc_m, hBr_m, hDisj_br, hFm_eq, hIrred_Ym, hBr_uniq, hExc_two⟩ := hLoc
  obtain ⟨z₀, hz₀_x₀, hz₀_cl, hFin_Y', hBij_compl,
    hStrict_nonempty, hStrict_irred, hStrict_compl, hStrict_sub⟩ :=
    h_part1 Ω C' C'' g' hProp' hLFP' x₀ hx₀_cl hX_x₀ U hAffU p_x₀ hp_x₀
      m hm hMax_Inod A' v'₀ e_U q_m hEt_q hComm_eq hev'₀ hqv'₀ hUniq_e
      π hIso_compl π₀ hπ₀_fst hπ₀_snd
  let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
      Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
  let R_Pm : CommRingCat.{u} :=
    CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m)
  let φ_Pm : PowerSeries Ω →+* ↑R_Pm := (Ideal.Quotient.mk J_m).comp MvPolynomial.C
  let I_nod_R : Ideal ↑R_Pm := Ideal.span
    {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
     Ideal.Quotient.mk J_m (MvPolynomial.X 1),
     Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
  have _ : I_nod_R.IsMaximal := hMax_Inod
  have hX_Inod : φ_Pm PowerSeries.X ∈ I_nod_R :=
    Ideal.subset_span (Or.inr (Or.inr (Set.mem_singleton _)))
  obtain ⟨F_sch, j'', j_m, hCl_j'', hCl_jm, hRange_j'', hRange_jm, hj_snd, hCl_equiv, hLift_F⟩ :=
    h_part2 Ω C' C'' U_tilde M_m g' hProp' x₀ hX_x₀ U hAffU p_x₀ hp_x₀ hRes_A π_U
      R_Pm A' φ_Pm I_nod_R hX_Inod hRes_Pm p_m v'₀ e_U q_m hEt_e hEt_q hComm_eq
      hev'₀ hqv'₀ hUniq_e hUniq_q hRes_A' π ι_tilde Φ_A' hOpen_tilde hπ_tilde hPre_U hΦ_snd
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let Y'' := CategoryTheory.Limits.pullback (π ≫ g') s_Ω
  let fst' := CategoryTheory.Limits.pullback.fst g' s_Ω
  let fst'' := CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω
  have hF''_eq : {q : ↥Y'' | π.base (fst''.base q) = x₀} = π₀.base ⁻¹' {z₀} := by
    ext q
    change π.base (fst''.base q) = x₀ ↔ π₀.base q = z₀
    have h_eq : π.base (fst''.base q) = fst'.base (π₀.base q) := by
      change (fst'' ≫ π).base q = (π₀ ≫ fst').base q
      rw [hπ₀_fst]
    rw [h_eq]
    exact hz₀_x₀ (π₀.base q)
  have hRange_j''_z₀ : Set.range j''.base = π₀.base ⁻¹' {z₀} := hRange_j''.trans hF''_eq
  have hCl_equiv_z₀ : ∀ u : ↥F_sch,
      j''.base u ∈ closure ((π₀.base ⁻¹' {z₀})ᶜ) ↔
        j_m.base u ∈ closure ({q | p_m.base ((CategoryTheory.Limits.pullback.fst
          (p_m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Pm)) s_Ω).base q) ∈
          PrimeSpectrum.zeroLocus (I_nod_R : Set ↑R_Pm)}ᶜ) := by
    intro u
    rw [← hF''_eq]
    exact hCl_equiv u
  have hBr_m' : ∀ b : Fin 2,
      L_br b ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback
        (p_m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Pm)) s_Ω) ∧
      (L_br b ∩ {q | p_m.base ((CategoryTheory.Limits.pullback.fst
        (p_m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Pm)) s_Ω).base q) ∈
        PrimeSpectrum.zeroLocus (I_nod_R : Set ↑R_Pm)}ᶜ).Nonempty := hBr_m
  obtain ⟨E''_exc, b₀, b₁, hFib_cov, hExc_tb, hIrred_Y'', hb₀_mem, hb₁_mem, hb_ne, hBridge_eq⟩ :=
    h_part3 Ω n C' C'' _ F_sch g' x₀ π τ'' hx₀_not_π_τ''
      π₀ hπ₀_fst z₀ hz₀_x₀ hFin_Y' hBij_compl hStrict_nonempty hStrict_irred
      hStrict_sub _ _ j'' j_m hCl_j'' hCl_jm hRange_j''_z₀ hRange_jm hj_snd hCl_equiv_z₀
      hLift_F k_exc E_exc ι_exc iso_exc L_br hExc_m hBr_m' hDisj_br hFm_eq hIrred_Ym
      hBr_uniq hExc_two
  exact ⟨z₀, k_exc, E''_exc, b₀, b₁, hz₀_x₀, hz₀_cl, hBij_compl, hStrict_compl,
    fun K₁' hK₁' K₂' hK₂' h_eq => hStrict_sub K₁' hK₁' K₂' hK₂' h_eq.subset,
    hk_pos, hFib_cov, hExc_tb, hIrred_Y'', hb₀_mem, hb₁_mem, hb_ne, hBridge_eq⟩

theorem weil_powerSeries_blowup_rational_component_strict_transform_lift (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C' C'' U_tilde : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (x₀ : C')
    (hx₀_cl : IsClosed ({x₀} : Set C'))
    (U : C'.Opens)
    (hAffU : AlgebraicGeometry.IsAffineOpen U)
    (p_x₀ : PrimeSpectrum ↑(C'.presheaf.obj (Opposite.op U)))
    [p_x₀.asIdeal.IsMaximal]
    (hp_x₀ : hAffU.fromSpec.base p_x₀ = x₀)
    (π_U : U_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))))
    (hBlU : IsAffinePowerSeriesPointBlowup Ω
      (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom p_x₀.asIdeal π_U)
    (π : C'' ⟶ C')
    (ι_tilde : U_tilde ⟶ C'')
    (hπ_tilde : ι_tilde ≫ π = π_U ≫ hAffU.fromSpec)
    (hIso_compl : CategoryTheory.IsIso
      (π ∣_ (⟨({x₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩ : C'.Opens)))
    (hProp_π : AlgebraicGeometry.IsProper π)
    (π₀ : CategoryTheory.Limits.pullback (π ≫ g')
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) ⟶
      CategoryTheory.Limits.pullback g'
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (hπ₀_fst : π₀ ≫ CategoryTheory.Limits.pullback.fst g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      CategoryTheory.Limits.pullback.fst (π ≫ g')
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) ≫ π)
    (hπ₀_snd : π₀ ≫ CategoryTheory.Limits.pullback.snd g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      CategoryTheory.Limits.pullback.snd (π ≫ g')
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (E_sch : AlgebraicGeometry.Scheme.{u})
    (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))
    (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left)
    (hCl_E : AlgebraicGeometry.IsClosedImmersion ιE)
    (hInt_E : AlgebraicGeometry.IsIntegral E_sch)
    (hE_snd : ιE ≫ CategoryTheory.Limits.pullback.snd g'
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))) =
      isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    ∃ (ιE'' : E_sch ⟶ CategoryTheory.Limits.pullback (π ≫ g') s_Ω),
      AlgebraicGeometry.IsClosedImmersion ιE'' ∧
      ιE'' ≫ π₀ = ιE ∧
      Set.range ιE''.base =
        closure (π₀.base ⁻¹' {q ∈ Set.range ιE.base |
          (CategoryTheory.Limits.pullback.fst g' s_Ω).base q ≠ x₀}) ∧
      (Set.range ιE''.base ∩ {q : ↥(CategoryTheory.Limits.pullback (π ≫ g') s_Ω) |
        π.base ((CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω).base q) = x₀}).Subsingleton :=
by
  clear hE_snd
  
  have hAtlas : ∃ (W_line : Fin 2 → E_sch.Opens)
      (hW_line : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (W_line a))
      (θ_line : ∀ a : Fin 2, Polynomial Ω ≃+* ↑(E_sch.presheaf.obj (Opposite.op (W_line a))))
      (y₁ y₂ : ↥E_sch),
      W_line 0 ⊔ W_line 1 = ⊤ ∧ y₁ ≠ y₂ := by
    classical
    let A_hom := MvPolynomial (Fin (1 + 1)) Ω
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P1 : AlgebraicGeometry.Scheme.{u} := (weilProjectiveSpaceOver Ω 1).left
    have hXa : ∀ a : Fin 2, (MvPolynomial.X a : A_hom) ∈ 𝒜 1 :=
      fun a => MvPolynomial.isHomogeneous_X Ω a
    let D : Fin 2 → P1.Opens := fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    have hAffD : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (D a) :=
      fun a => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X a) (hXa a) zero_lt_one
    have hDegTwo : ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 = Finsupp.degree d := by
      intro d
      change d 0 + d 1 = d.sum (fun _ m => m)
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
    have hMonomTwo : ∀ (d : Fin 2 →₀ ℕ) (c : Ω),
        MvPolynomial.monomial d c =
          MvPolynomial.C c * MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1 := by
      intro d c
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two, mul_assoc]
    have hCovD : D 0 ⊔ D 1 = ⊤ := by
      rw [eq_top_iff]
      intro p _
      by_contra hp
      have hp0 : (MvPolynomial.X 0 : A_hom) ∈ p.asHomogeneousIdeal := by
        by_contra h0
        exact hp (Or.inl ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 0) p).mpr h0))
      have hp1 : (MvPolynomial.X 1 : A_hom) ∈ p.asHomogeneousIdeal := by
        by_contra h1
        exact hp (Or.inr ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 1) p).mpr h1))
      apply p.not_irrelevant_le
      rw [HomogeneousIdeal.irrelevant_le]
      intro i hi F hF
      have hF_eq : F = ∑ d ∈ F.support with Finsupp.degree d = i,
          MvPolynomial.monomial d (F.coeff d) := by
        have hcomp := MvPolynomial.homogeneousComponent_of_mem (m := i) hF
        simp only [ite_true] at hcomp
        exact hcomp.symm.trans (MvPolynomial.homogeneousComponent_apply i F)
      change F ∈ p.asHomogeneousIdeal.toIdeal
      rw [hF_eq]
      apply Ideal.sum_mem
      intro d hd
      have hdeg : d 0 + d 1 = i := (hDegTwo d).trans (Finset.mem_filter.mp hd).2
      rw [hMonomTwo]
      have hpos : 1 ≤ d 0 ∨ 1 ≤ d 1 := by omega
      rcases hpos with hd0 | hd1
      · have hx0 : (MvPolynomial.X 0 : A_hom) ^ d 0 ∈ p.asHomogeneousIdeal.toIdeal :=
          Ideal.pow_mem_of_mem p.asHomogeneousIdeal.toIdeal hp0 (d 0) hd0
        exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hx0)
      · have hx1 : (MvPolynomial.X 1 : A_hom) ^ d 1 ∈ p.asHomogeneousIdeal.toIdeal :=
          Ideal.pow_mem_of_mem p.asHomogeneousIdeal.toIdeal hp1 (d 1) hd1
        exact Ideal.mul_mem_left _ _ hx1
    have hEquivD : ∀ a : Fin 2,
        Nonempty (Polynomial Ω ≃+* ↑(P1.presheaf.obj (Opposite.op (D a)))) := by
      intro a
      let b : Fin 2 := if a = 0 then 1 else 0
      have hba : b ≠ a := by fin_cases a <;> decide
      let H_a := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)
      let L_a := Localization.Away (MvPolynomial.X a : A_hom)
      let valHom : H_a →+* L_a :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      let c0_fn : Ω → H_a := fun c =>
        HomogeneousLocalization.Away.mk 𝒜 (hXa a) 0 (MvPolynomial.C c)
          ((MvPolynomial.mem_homogeneousSubmodule (0 • 1) (MvPolynomial.C c)).mpr
            (by simpa using MvPolynomial.isHomogeneous_C (Fin (1 + 1)) c))
      have hc0_val : ∀ c : Ω, (c0_fn c).val = algebraMap A_hom L_a (MvPolynomial.C c) := by
        intro c
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        let s₀ : Submonoid.powers (MvPolynomial.X a : A_hom) :=
          ⟨(MvPolynomial.X a : A_hom) ^ 0, 0, rfl⟩
        have hs₀ : algebraMap A_hom L_a (s₀ : A_hom) = 1 := by
          change algebraMap A_hom L_a ((MvPolynomial.X a : A_hom) ^ 0) = 1
          rw [pow_zero, map_one]
        have hspec := IsLocalization.mk'_spec L_a (MvPolynomial.C c) s₀
        rwa [hs₀, mul_one] at hspec
      let c0_a : Ω →+* H_a :=
        { toFun := c0_fn
          map_one' := HomogeneousLocalization.val_injective _ (by
            rw [HomogeneousLocalization.val_one, hc0_val, map_one, map_one])
          map_mul' := fun x y => HomogeneousLocalization.val_injective _ (by
            rw [HomogeneousLocalization.val_mul, hc0_val, hc0_val, hc0_val, map_mul, map_mul])
          map_zero' := HomogeneousLocalization.val_injective _ (by
            rw [HomogeneousLocalization.val_zero, hc0_val, map_zero, map_zero])
          map_add' := fun x y => HomogeneousLocalization.val_injective _ (by
            rw [HomogeneousLocalization.val_add, hc0_val, hc0_val, hc0_val, map_add, map_add]) }
      let t_a : H_a :=
        HomogeneousLocalization.Away.mk 𝒜 (hXa a) 1 (MvPolynomial.X b) (by simpa using hXa b)
      have hta_mul : t_a.val * algebraMap A_hom L_a (MvPolynomial.X a) =
          algebraMap A_hom L_a (MvPolynomial.X b) := by
        change (HomogeneousLocalization.Away.mk 𝒜 (hXa a) 1 (MvPolynomial.X b) _).val *
            algebraMap A_hom L_a (MvPolynomial.X a) = algebraMap A_hom L_a (MvPolynomial.X b)
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        let s₁ : Submonoid.powers (MvPolynomial.X a : A_hom) :=
          ⟨(MvPolynomial.X a : A_hom) ^ 1, 1, rfl⟩
        have hs₁ : (s₁ : A_hom) = MvPolynomial.X a := pow_one _
        have hspec := IsLocalization.mk'_spec L_a (MvPolynomial.X b) s₁
        rwa [hs₁] at hspec
      let Φ_a : Polynomial Ω →+* H_a := Polynomial.eval₂RingHom c0_a t_a
      let ε_a : A_hom →+* Polynomial Ω :=
        MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = a then 1 else Polynomial.X)
      have hε_Xa : ε_a (MvPolynomial.X a) = 1 := by
        dsimp [ε_a]
        rw [MvPolynomial.eval₂Hom_X']
        simp
      have hε_Xb : ε_a (MvPolynomial.X b) = Polynomial.X := by
        dsimp [ε_a]
        rw [MvPolynomial.eval₂Hom_X']
        simp [hba]
      have hε_unit : IsUnit (ε_a (MvPolynomial.X a)) := by rw [hε_Xa]; exact isUnit_one
      let ev_loc : L_a →+* Polynomial Ω := IsLocalization.Away.lift (MvPolynomial.X a) hε_unit
      let Ψ_a : H_a →+* Polynomial Ω := ev_loc.comp valHom
      have hLeft : Function.LeftInverse Ψ_a Φ_a := by
        have hcomp : Ψ_a.comp Φ_a = RingHom.id (Polynomial Ω) := by
          apply Polynomial.ringHom_ext
          · intro c
            change ev_loc (Polynomial.eval₂ c0_a t_a (Polynomial.C c)).val = Polynomial.C c
            rw [Polynomial.eval₂_C]
            change ev_loc (c0_fn c).val = Polynomial.C c
            rw [hc0_val, IsLocalization.Away.lift_eq]
            dsimp [ε_a]
            exact MvPolynomial.eval₂Hom_C Polynomial.C _ c
          · change ev_loc (Polynomial.eval₂ c0_a t_a Polynomial.X).val = Polynomial.X
            rw [Polynomial.eval₂_X]
            have h1 := congrArg ev_loc hta_mul
            rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
              hε_Xa, hε_Xb, mul_one] at h1
            exact h1
        intro P
        exact RingHom.congr_fun hcomp P
      have hRight : Function.RightInverse Ψ_a Φ_a := by
        intro z
        obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hXa a) z
        apply HomogeneousLocalization.val_injective
        have hz_mul :
            (HomogeneousLocalization.Away.mk 𝒜 (hXa a) n F hF).val *
                algebraMap A_hom L_a (MvPolynomial.X a ^ n) =
              algebraMap A_hom L_a F := by
          rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          exact IsLocalization.mk'_spec L_a F
            (⟨MvPolynomial.X a ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X a))
        have hΨ_z : Ψ_a (HomogeneousLocalization.Away.mk 𝒜 (hXa a) n F hF) = ε_a F := by
          have h1 := congrArg ev_loc hz_mul
          rw [map_mul, map_pow, map_pow, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
            hε_Xa, one_pow, mul_one] at h1
          exact h1
        change (valHom (Φ_a (Ψ_a (HomogeneousLocalization.Away.mk 𝒜 (hXa a) n F hF)))) =
          (HomogeneousLocalization.Away.mk 𝒜 (hXa a) n F hF).val
        rw [hΨ_z]
        let θ_hom : A_hom →+* L_a := valHom.comp (Φ_a.comp ε_a)
        have hθ_C : ∀ c : Ω, θ_hom (MvPolynomial.C c) = algebraMap A_hom L_a (MvPolynomial.C c) := by
          intro c
          change (Polynomial.eval₂ c0_a t_a (ε_a (MvPolynomial.C c))).val =
            algebraMap A_hom L_a (MvPolynomial.C c)
          have hε_C : ε_a (MvPolynomial.C c) = Polynomial.C c :=
            MvPolynomial.eval₂Hom_C Polynomial.C _ c
          rw [hε_C, Polynomial.eval₂_C]
          exact hc0_val c
        have hθ_Xa : θ_hom (MvPolynomial.X a) = 1 := by
          change (Φ_a (ε_a (MvPolynomial.X a))).val = 1
          rw [hε_Xa, map_one, HomogeneousLocalization.val_one]
        have hθ_Xb : θ_hom (MvPolynomial.X b) = t_a.val := by
          change (Polynomial.eval₂ c0_a t_a (ε_a (MvPolynomial.X b))).val = t_a.val
          rw [hε_Xb, Polynomial.eval₂_X]
        have h_eq_mul :
            θ_hom F * algebraMap A_hom L_a (MvPolynomial.X a ^ n) = algebraMap A_hom L_a F := by
          have hF_hom : F ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω n := by
            simpa [𝒜] using hF
          have hF_eq : F = ∑ d ∈ F.support with Finsupp.degree d = n,
              MvPolynomial.monomial d (F.coeff d) := by
            have hcomp := MvPolynomial.homogeneousComponent_of_mem (m := n) hF_hom
            simp only [ite_true] at hcomp
            exact hcomp.symm.trans (MvPolynomial.homogeneousComponent_apply n F)
          conv_lhs => rw [hF_eq]
          conv_rhs => rw [hF_eq]
          rw [map_sum, Finset.sum_mul, map_sum]
          apply Finset.sum_congr rfl
          intro d hd
          have hdeg01 : d 0 + d 1 = n := (hDegTwo d).trans (Finset.mem_filter.mp hd).2
          have hdegab : d a + d b = n := by
            fin_cases a <;> simp [b] <;> omega
          have hmon_ab : MvPolynomial.monomial d (F.coeff d) =
              MvPolynomial.C (F.coeff d) *
                MvPolynomial.X a ^ d a * MvPolynomial.X b ^ d b := by
            rw [hMonomTwo]
            fin_cases a <;> simp [b] <;> ring
