            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 1) := by
          rw [hswap_mk]
          simp [s_tilde, τ]
        rw [hswap_x0] at hmem'
        exact hp1 hmem'
      obtain ⟨V, hp'V, hSmV⟩ := hSmoothX0 k (σ_k ≫ ι) hOpen_ι' hι'_base p' hp'0
      have hp'_eq : (σ_k ≫ ι).base p' = ι.base p := by
        calc (σ_k ≫ ι).base (σ_k.base p)
            = ι.base (σ_k.base (σ_k.base p)) := AlgebraicGeometry.Scheme.Hom.comp_apply σ_k ι _
          _ = ι.base ((σ_k ≫ σ_k).base p) := by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply σ_k σ_k p]
          _ = ι.base p := by rw [hσ_sq]; rfl
      rw [hp'_eq] at hp'V
      exact ⟨V, hp'V, hSmV⟩
  
  have hZeroK : ∀ (k : ℕ), k = 0 →
      ∀ (p : AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot RStar (X_ps ^ k)))),
        Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 0) ∉ p.asIdeal := by
    rintro k rfl p hmem0
    have h1_eq : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 0)) (MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 0)) (MvPolynomial.X 1) = 1 := by
      have hC0 : (MvPolynomial.C (X_ps ^ 0) : MvPolynomial (Fin 2) RStar) = 1 := by
        rw [pow_zero, map_one]
      exact (hRel 0).trans (by rw [hC0, map_one])
    have h1_mem : (1 : weilNodalQuot RStar (X_ps ^ 0)) ∈ p.asIdeal := by
      rw [← h1_eq]
      exact p.asIdeal.mul_mem_right _ hmem0
    exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1_mem)
  let ev_tilde : MvPolynomial (Fin 2) RStar →+* Ω :=
    (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω).comp (MvPolynomial.eval 0)
  have hPosK : ∀ (k : ℕ) (hk : 1 ≤ k)
      (ι : AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot RStar (X_ps ^ k))) ⟶ M_m)
      (_ : AlgebraicGeometry.IsOpenImmersion ι),
      ι ≫ (p_m ≫ g_Pm) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
            ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))).comp MvPolynomial.C)) →
      ∃ (v0 : AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot RStar (X_ps ^ k))))
        (ev_k : weilNodalQuot RStar (X_ps ^ k) →+* Ω),
        v0.asIdeal = RingHom.ker ev_k ∧
        (∀ F : MvPolynomial (Fin 2) RStar,
          ev_k (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) F) = ev_tilde F) ∧
        HasPowerSeriesNodalRoofAt Ω (p_m ≫ g_Pm) (ι.base v0) k ∧
        ∀ (p : AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot RStar (X_ps ^ k)))),
          Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 0) ∈ p.asIdeal →
          Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 1) ∈ p.asIdeal →
          p = v0 := by
    intro k hk ι _ hι_base
    have hev_ker : ∀ a ∈ weilNodalIdeal RStar (X_ps ^ k), ev_tilde a = 0 := by
      intro a ha
      have hle : weilNodalIdeal RStar (X_ps ^ k) ≤ RingHom.ker ev_tilde := by
        change Ideal.span _ ≤ RingHom.ker ev_tilde
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        simp only [ev_tilde, RingHom.comp_apply, map_sub, map_mul, map_pow,
          MvPolynomial.eval_X, MvPolynomial.eval_C, Pi.zero_apply, map_zero, mul_zero, zero_sub]
        have hcX : (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) X_ps = 0 :=
          PowerSeries.constantCoeff_X
        rw [hcX, zero_pow (by omega : k ≠ 0), neg_zero]
      exact RingHom.mem_ker.mp (hle ha)
    obtain ⟨ev_k, hev_mk⟩ : ∃ ev_k : weilNodalQuot RStar (X_ps ^ k) →+* Ω,
        ∀ F : MvPolynomial (Fin 2) RStar,
          ev_k (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) F) = ev_tilde F :=
      ⟨Ideal.Quotient.lift (weilNodalIdeal RStar (X_ps ^ k)) ev_tilde hev_ker,
       fun _ => Ideal.Quotient.lift_mk (weilNodalIdeal RStar (X_ps ^ k)) ev_tilde hev_ker⟩
    have hSurj_ev : Function.Surjective ev_k := by
      intro a
      refine ⟨Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
        (MvPolynomial.C (PowerSeries.C a)), ?_⟩
      rw [hev_mk]
      simp [ev_tilde, PowerSeries.constantCoeff_C]
    have hMax_ev : (RingHom.ker ev_k).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ev_k hSurj_ev
    let v0 : AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot RStar (X_ps ^ k))) :=
      ⟨RingHom.ker ev_k, hMax_ev.isPrime⟩
    refine ⟨v0, ev_k, rfl, hev_mk, ?_, ?_⟩
    · refine ⟨hk, CommRingCat.of (weilNodalQuot RStar (X_ps ^ k)), v0, ι, 𝟙 _,
        inferInstance, inferInstance, rfl, ?_, ?_, ?_⟩
      · intro i
        change ev_k (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X i)) = 0
        rw [hev_mk]
        simp [ev_tilde]
      · change ev_k (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
          (MvPolynomial.C X_ps)) = 0
        rw [hev_mk]
        simp [ev_tilde, X_ps, PowerSeries.constantCoeff_X]
      · rw [CategoryTheory.Category.id_comp]
        exact hι_base
    · intro p h0 h1
      have hX_pow : (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
          (MvPolynomial.C X_ps)) ^ k ∈ p.asIdeal := by
        rw [← map_pow, ← map_pow, ← hRel k]
        exact p.asIdeal.mul_mem_left _ h1
      have hX : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
          (MvPolynomial.C X_ps) ∈ p.asIdeal :=
        p.isPrime.mem_of_pow_mem k hX_pow
      have h_le : RingHom.ker ev_k ≤ p.asIdeal := by
        intro z hz
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
        have hevF : (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) (MvPolynomial.eval 0 F) = 0 := by
          have h := hz
          rw [RingHom.mem_ker, hev_mk] at h
