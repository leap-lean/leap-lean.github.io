        have hCD : C = D := h𝒞_antichain C hC D hD_𝒞 (hCZ.trans hZD)
        rwa [hCD]
    have hExc_tb : ∀ a : Fin k_exc, IsTwoBridgeRationalComponent Ω n (π ≫ g') τ'' (E''_exc a) := by
      intro a
      have ha_comp : E''_exc a ∈ irreducibleComponents ↥Y'' := by
        rw [hIrred_Y'']
        exact Or.inl (Set.mem_iUnion.mpr ⟨a, Set.mem_singleton _⟩)
      refine ⟨ha_comp, ⟨E_exc a, ι''_exc a, iso_exc a, hCl_ι'' a, (hExc_m a).2.1, rfl, hι''_snd a⟩,
        ?_, ?_⟩
      · intro q hq j h_in_range
