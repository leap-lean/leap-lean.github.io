  have hFlat_LFP : Flat (p_m ≫ g_Pm) ∧ LocallyOfFinitePresentation (p_m ≫ g_Pm) := by
    have hChart_prop : ∀ r : Fin 3,
        Flat ((U_src r).ι ≫ p_m ≫ g_Pm) ∧
        LocallyOfFinitePresentation ((U_src r).ι ≫ p_m ≫ g_Pm) := by
      have h_fac_gen : ∀ r : Fin 3,
