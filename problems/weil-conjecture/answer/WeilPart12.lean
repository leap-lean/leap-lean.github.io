    have hu'' : u'' ≫ (π ⁻¹ᵁ U_compl).ι = W''.ι ≫ fst'' :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    have hComm_u : (π₀ ∣_ W') ≫ u' = u'' ≫ (π ∣_ U_compl) := by
      rw [← CategoryTheory.cancel_mono U_compl.ι]
      calc ((π₀ ∣_ W') ≫ u') ≫ U_compl.ι
          = (π₀ ∣_ W') ≫ (W'.ι ≫ fst') := by rw [CategoryTheory.Category.assoc, hu']
        _ = W''.ι ≫ (π₀ ≫ fst') := by
            rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              CategoryTheory.Category.assoc]
        _ = (W''.ι ≫ fst'') ≫ π := by rw [hπ₀_fst, CategoryTheory.Category.assoc]
        _ = (u'' ≫ (π ⁻¹ᵁ U_compl).ι) ≫ π := by rw [hu'']
        _ = (u'' ≫ (π ∣_ U_compl)) ≫ U_compl.ι := by
            rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι π U_compl,
              ← CategoryTheory.Category.assoc]
    have hPb_res : CategoryTheory.IsPullback u'' (π₀ ∣_ W') (π ∣_ U_compl) u' := by
      refine CategoryTheory.IsPullback.of_right ?_ hComm_u.symm
        (AlgebraicGeometry.isPullback_morphismRestrict π U_compl).flip
      rw [hu'', hu']
      exact CategoryTheory.IsPullback.paste_horiz
        (AlgebraicGeometry.isPullback_morphismRestrict π₀ W').flip hPb_π₀.flip
    have _ : CategoryTheory.IsIso (π ∣_ U_compl) := hIso_compl
    have _ : CategoryTheory.IsIso (π₀ ∣_ W') :=
      CategoryTheory.IsPullback.isIso_fst_of_isIso hPb_res.flip
    let σ_inv : W'.toScheme ⟶ Y'' := CategoryTheory.inv (π₀ ∣_ W') ≫ W''.ι
    have hπ₀_σ : ∀ u : ↥W'.toScheme, π₀.base (σ_inv.base u) = W'.ι.base u := by
      intro u
