        change ((Y.presheaf.map eY.hom ≫
          Y.presheaf.map (TopologicalSpace.Opens.leSupr W i).op).hom) s₁ = _
        rw [← CategoryTheory.Functor.map_comp, h_eq]; rfl
      have h2 : (Y.presheaf.map (TopologicalSpace.Opens.leSupr W i).op).hom
          ((Y.presheaf.map eY.hom).hom s₂) = ρ_Y s₂ i := by
        change ((Y.presheaf.map eY.hom ≫
          Y.presheaf.map (TopologicalSpace.Opens.leSupr W i).op).hom) s₂ = _
        rw [← CategoryTheory.Functor.map_comp, h_eq]; rfl
      exact (h1.trans (congrFun hs i)).trans h2.symm
    have hExact_Y : Function.Exact ρ_Y δ_Y := by
      intro sf
      constructor
      · intro hδ
        have hCompat : TopCat.Presheaf.IsCompatible Y.presheaf W sf := by
          intro i j
          have hij := congrFun hδ (i, j)
          exact sub_eq_zero.mp hij
        obtain ⟨s₀, hs₀, _⟩ := Y.sheaf.existsUnique_gluing W sf hCompat
        let eY : Opposite.op (⊤ : Y.Opens) ≅ Opposite.op (⨆ i : Fin M, W i) :=
          CategoryTheory.eqToIso (congrArg Opposite.op hSupW.symm)
        refine ⟨(Y.presheaf.map eY.inv).hom s₀, ?_⟩
        ext i
        have h_eq : eY.inv ≫ (CategoryTheory.homOfLE (le_top : W i ≤ ⊤)).op =
            (TopologicalSpace.Opens.leSupr W i).op := Subsingleton.elim _ _
        change ((Y.presheaf.map eY.inv ≫
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : W i ≤ ⊤)).op).hom) s₀ = sf i
        rw [← CategoryTheory.Functor.map_comp, h_eq]
        exact hs₀ i
      · rintro ⟨s, rfl⟩
        ext ⟨i, j⟩
        change (Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
            ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : W i ≤ ⊤)).op).hom s) -
