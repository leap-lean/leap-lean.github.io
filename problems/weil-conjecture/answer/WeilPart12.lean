            obtain ⟨q, rfl⟩ := hw
            apply hz
            rw [Ideal.mem_span_singleton]
            refine ⟨q, ?_⟩
            rw [pow_succ']
            ring
          obtain ⟨k, u, hu, rfl⟩ := ih w hw_not
          refine ⟨k + 1, u, hu, ?_⟩
          rw [pow_succ']
          ring
        · exact ⟨0, z, IsLocalRing.notMem_maximalIdeal.mp hmem, by simp⟩
    have hFactor : ∀ z : L_bar, z ≠ 0 → ∃ (k : ℕ) (u : L_bar), IsUnit u ∧ z = u * ϖ ^ k := by
      intro z hz_ne
      have hex : ∃ n : ℕ, z ∉ Ideal.span ({ϖ ^ n} : Set L_bar) := by
        by_contra hAll
        push Not at hAll
        have hmem_iInf : z ∈ ⨅ n : ℕ, (IsLocalRing.maximalIdeal L_bar) ^ n := by
          rw [Ideal.mem_iInf]
          intro n
          rw [hMax_L, Ideal.span_singleton_pow]
          exact hAll n
        rw [hKrull, Ideal.mem_bot] at hmem_iInf
        exact hz_ne hmem_iInf
      obtain ⟨n, hn⟩ := hex
      exact hUnitPow n z hn
    have hMulNeZero_L : ∀ z₁ z₂ : L_bar, z₁ ≠ 0 → z₂ ≠ 0 → z₁ * z₂ ≠ 0 := by
      intro z₁ z₂ hz₁ hz₂ hmul
      obtain ⟨k₁, u₁', hu₁', rfl⟩ := hFactor z₁ hz₁
      obtain ⟨k₂, u₂', hu₂', rfl⟩ := hFactor z₂ hz₂
      have hprod : (u₁' * u₂') * ϖ ^ (k₁ + k₂) = 0 := by
        calc (u₁' * u₂') * ϖ ^ (k₁ + k₂)
            = (u₁' * ϖ ^ k₁) * (u₂' * ϖ ^ k₂) := by rw [pow_add]; ring
          _ = 0 := hmul
      exact (hu₁'.mul hu₂').ne_zero (hϖ_pow_reg (k₁ + k₂) (u₁' * u₂') hprod)
    have hPowEqZero_L : ∀ (m : ℕ) (z : L_bar), z ^ m = 0 → z = 0 := by
      intro m z hzm
      by_contra hz_ne
      induction m with
      | zero =>
        rw [pow_zero] at hzm
        exact one_ne_zero hzm
      | succ m ih =>
        rw [pow_succ] at hzm
        by_cases hzm0 : z ^ m = 0
        · exact ih hzm0
        · exact hMulNeZero_L (z ^ m) z hzm0 hz_ne hzm
    have : Module.Flat A₂ B := Algebra.Smooth.flat A₂ B
    have hu₂_B_reg : ∀ b : B, algebraMap A₂ B u₂ * b = 0 → b = 0 :=
      hFlatNzd A₂ B u₂ (fun x hx => (mul_eq_zero.mp hx).resolve_left hu₂_ne)
    have ht₂_B_reg : ∀ b : B, algebraMap A₂ B t₂ * b = 0 → b = 0 :=
      hFlatNzd A₂ B t₂ (fun x hx => (mul_eq_zero.mp hx).resolve_left ht₂_ne)
    let θ : B →+* L_bar := (algebraMap B_bar L_bar).comp mk_B
    have hθ_u₁ : θ (algebraMap A₁ B u₁) = 0 := by
      change algebraMap B_bar L_bar (mk_B (algebraMap A₁ B u₁)) = 0
      have h0 : mk_B (algebraMap A₁ B u₁) = 0 := by
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        rw [hJu₁_span]
        exact Ideal.subset_span rfl
      rw [h0, map_zero]
    have hθ_prod : θ δ * (θ (algebraMap A₂ B u₂)) ^ a' * (θ (algebraMap A₂ B t₂)) ^ b' = 0 := by
      have h := congrArg θ hEq
      rw [hθ_u₁, map_mul, map_mul, map_pow, map_pow] at h
      exact h.symm
    have hθ_δ_ne : θ δ ≠ 0 := (hδ.map θ).ne_zero
    have hθ_zero_or : θ (algebraMap A₂ B u₂) = 0 ∨ θ (algebraMap A₂ B t₂) = 0 := by
      by_contra hNeither
      push Not at hNeither
      obtain ⟨hne1, hne2⟩ := hNeither
      have hp1 : (θ (algebraMap A₂ B u₂)) ^ a' ≠ 0 := fun h => hne1 (hPowEqZero_L a' _ h)
      have hp2 : (θ (algebraMap A₂ B t₂)) ^ b' ≠ 0 := fun h => hne2 (hPowEqZero_L b' _ h)
      exact hMulNeZero_L _ _ (hMulNeZero_L _ _ hθ_δ_ne hp1) hp2 hθ_prod
    have hUnpackZero : ∀ y : B, θ y = 0 → ∃ s w : B, s ∉ q_B ∧ s * y = algebraMap A₁ B u₁ * w := by
      intro y hy
      obtain ⟨c_sub, hc⟩ :=
        (IsLocalization.map_eq_zero_iff q_bar.primeCompl L_bar (mk_B y)).mp hy
      obtain ⟨s, hs_mk⟩ := Ideal.Quotient.mk_surjective c_sub.1
      have hs_not : s ∉ q_B := by
        intro hs_in
        exact c_sub.2 (hs_mk ▸ Ideal.mem_map_of_mem mk_B hs_in)
      have hsy_mem : s * y ∈ J_u₁ := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, hs_mk]
        exact hc
      rw [hJu₁_span, Ideal.mem_span_singleton] at hsy_mem
      obtain ⟨w, hw⟩ := hsy_mem
      exact ⟨s, w, hs_not, hw⟩
    obtain ⟨a₀, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : a' ≠ 0)
    obtain ⟨b₀, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : b' ≠ 0)
    have hu₂_qB : algebraMap A₂ B u₂ ∈ q_B := by
      rw [← Ideal.mem_comap, hv₂_comap]; exact hu₂_mem
    have ht₂_qB : algebraMap A₂ B t₂ ∈ q_B := by
      rw [← Ideal.mem_comap, hv₂_comap]; exact ht₂_mem
    rcases hθ_zero_or with hu₂_0 | ht₂_0
    · obtain ⟨s, w, hs_not, hsw⟩ := hUnpackZero (algebraMap A₂ B u₂) hu₂_0
      have hcancel : algebraMap A₂ B u₂ *
          (s - algebraMap A₂ B t₂ *
            (δ * (algebraMap A₂ B u₂) ^ a₀ * (algebraMap A₂ B t₂) ^ b₀ * w)) = 0 := by
        calc algebraMap A₂ B u₂ *
              (s - algebraMap A₂ B t₂ *
                (δ * (algebraMap A₂ B u₂) ^ a₀ * (algebraMap A₂ B t₂) ^ b₀ * w))
            = s * algebraMap A₂ B u₂ -
                (δ * (algebraMap A₂ B u₂) ^ (a₀ + 1) * (algebraMap A₂ B t₂) ^ (b₀ + 1)) * w := by
                rw [pow_succ, pow_succ]; ring
          _ = 0 := by rw [hsw, hEq, sub_self]
      have hs_eq : s = algebraMap A₂ B t₂ *
          (δ * (algebraMap A₂ B u₂) ^ a₀ * (algebraMap A₂ B t₂) ^ b₀ * w) :=
        sub_eq_zero.mp (hu₂_B_reg _ hcancel)
      exact hs_not (hs_eq ▸ q_B.mul_mem_right _ ht₂_qB)
    · obtain ⟨s, w, hs_not, hsw⟩ := hUnpackZero (algebraMap A₂ B t₂) ht₂_0
      have hcancel : algebraMap A₂ B t₂ *
          (s - algebraMap A₂ B u₂ *
            (δ * (algebraMap A₂ B u₂) ^ a₀ * (algebraMap A₂ B t₂) ^ b₀ * w)) = 0 := by
        calc algebraMap A₂ B t₂ *
              (s - algebraMap A₂ B u₂ *
                (δ * (algebraMap A₂ B u₂) ^ a₀ * (algebraMap A₂ B t₂) ^ b₀ * w))
            = s * algebraMap A₂ B t₂ -
                (δ * (algebraMap A₂ B u₂) ^ (a₀ + 1) * (algebraMap A₂ B t₂) ^ (b₀ + 1)) * w := by
                rw [pow_succ, pow_succ]; ring
          _ = 0 := by rw [hsw, hEq, sub_self]
      have hs_eq : s = algebraMap A₂ B u₂ *
          (δ * (algebraMap A₂ B u₂) ^ a₀ * (algebraMap A₂ B t₂) ^ b₀ * w) :=
        sub_eq_zero.mp (ht₂_B_reg _ hcancel)
      exact hs_not (hs_eq ▸ q_B.mul_mem_right _ hu₂_qB)
  
  have hLiftChart : ∀ (R_ch : CommRingCat.{u})
      (ι_ch : AlgebraicGeometry.Spec R_ch ⟶ W')
      (φ_ch : R₀ ⟶ R_ch) (P_ch : AlgebraicGeometry.Spec R_ch)
      (q' : ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) (a' b' : ℕ),
      AlgebraicGeometry.IsOpenImmersion ι_ch →
      ι_ch ≫ π = AlgebraicGeometry.Spec.map φ_ch ≫ ι₀ →
      ι_ch.base P_ch = fst'_0.base q' →
      HasAffineNCChartAt Ω R_ch P_ch
        (φ_ch.hom.comp (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom) a' b' →
      HasNCBranchAt Ω g_W' q' a' b' := by
    intro R_ch ι_ch φ_ch P_ch q' a' b' hOpen_ch hι_ch_π hP_w hAffCh
    obtain ⟨z₁', z₂', A'_ch, v'_ch, e_ch, u', v', ε',
        hDomR, hP_span, hz₁'_ne, hregR, hresR,
        hEt_e, hDomA, he_pre, hv_span, hu'_ne, hregA, hresA, hε', ha'_pos, hX_ch⟩ := hAffCh
    have hι_g : ι_ch ≫ g_W' = AlgebraicGeometry.Spec.map φ_ch ≫ (ι₀ ≫ g_W) := by
      rw [← hπ_g, ← CategoryTheory.Category.assoc, hι_ch_π, CategoryTheory.Category.assoc]
    have hpre_map : AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map φ_ch) = φ_ch :=
      AlgebraicGeometry.Spec.map_injective
        (AlgebraicGeometry.Spec.map_preimage (AlgebraicGeometry.Spec.map φ_ch))
    have hpre_ι : (AlgebraicGeometry.Spec.preimage (ι_ch ≫ g_W')).hom =
        φ_ch.hom.comp (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom := by
      rw [hι_g, AlgebraicGeometry.Spec.preimage_comp, hpre_map, CommRingCat.hom_comp]
    have hpre_e : (AlgebraicGeometry.Spec.preimage (e_ch ≫ ι_ch ≫ g_W')).hom =
        (AlgebraicGeometry.Spec.preimage e_ch).hom.comp
          (φ_ch.hom.comp (AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom) := by
      rw [AlgebraicGeometry.Spec.preimage_comp, CommRingCat.hom_comp, hpre_ι]
    exact ⟨R_ch, P_ch, ι_ch, z₁', z₂', A'_ch, v'_ch, e_ch, u', v', ε',
      hOpen_ch, hP_w, hDomR, hP_span, hz₁'_ne, hregR,
      fun r => by rw [hpre_ι]; exact hresR r,
      hEt_e, hDomA, he_pre, hv_span, hu'_ne, hregA,
      fun r' => by rw [hpre_e]; exact hresA r',
      hε', ha'_pos,
      by rw [hpre_e]; exact hX_ch⟩
  constructor
  · intro q' hq'_cl
    by_cases hq'_exc : q' ∈ E_exc
    · rcases hS2 q' hq'_exc hq'_cl with ⟨c₁, P₁, hP₁_w, hP₁_id⟩ | ⟨_, P₂, hP₂_w, hP₂_id⟩
      · obtain ⟨a', b', hCh⟩ := hCh1 c₁ P₁ hP₁_id
        exact ⟨a', b', hLiftChart R₁ ι₁ φ₁ P₁ q' a' b' hOpen₁ hι₁_π hP₁_w hCh⟩
      · obtain ⟨a', b', hCh⟩ := hCh2 P₂ hP₂_id
        exact ⟨a', b', hLiftChart R₂ ι₂ φ₂ P₂ q' a' b' hOpen₂ hι₂_π hP₂_w hCh⟩
    · have hw'_ne : π.base (fst'_0.base q') ≠ fst_0.base q₀ := by
        intro hw_eq
        apply hq'_exc
        rw [← hPre_exc]
        exact hw_eq
      exact hS1 q' hq'_cl hw'_ne
  · intro hNoSq
    have hExcl : ∀ (q : ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) (a' b' : ℕ),
        1 ≤ b' → HasNCBranchAt Ω g_W' q 1 0 → HasNCBranchAt Ω g_W' q a' b' → False := by
      intro q a' b' hb' hNC_sm hNC_nod
      obtain ⟨A₁, A₂, B, instR₁, hDom₁, instR₂, hDom₂, instRB, hNoethB,
          instAlg₁, hEt₁, instAlg₂, hEt₂,
          v₁, hv₁_max, v₂, hv₂_pr, q_B, hqB_pr,
          u₁, t₁, u₂, t₂, δ,
          hc₁, hc₂, hv₁_sp, hreg₁,
          hu₂_m, ht₂_m, hu₂_ne, ht₂_ne, hδ, ha', hEq⟩ :=
        hS3 q a' b' hNC_sm hNC_nod
      exact @hS4 A₁ A₂ B instR₁ hDom₁ instR₂ hDom₂ instRB hNoethB
        instAlg₁ hEt₁ instAlg₂ hEt₂ v₁ hv₁_max v₂ hv₂_pr q_B hqB_pr
        u₁ t₁ u₂ t₂ δ a' b' hc₁ hc₂ hv₁_sp hreg₁
        hu₂_m ht₂_m hu₂_ne ht₂_ne hδ ha' hb' hEq
    rcases hOrd_dichot hNoSq with ⟨c_bad, h1_good, h2_good⟩ | h1_all
    · have hAtBad : ∀ q : ↥(CategoryTheory.Limits.pullback g_W' s_Ω),
          q ∈ E_exc →
          IsClosed ({q} : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) →
          (∃ a' b' : ℕ, 1 ≤ b' ∧ HasNCBranchAt Ω g_W' q a' b') →
          ∃ P₁ : AlgebraicGeometry.Spec R₁,
            ι₁.base P₁ = fst'_0.base q ∧
            P₁.asIdeal = Ideal.span
              ({φ₁.hom z₁,
                s₁ - φ₁.hom ((AlgebraicGeometry.Spec.preimage (ι₀ ≫ g_W)).hom (PowerSeries.C c_bad))} :
                Set R₁) := by
        intro q hq_exc hq_cl ⟨a', b', hb', hNC_nod⟩
        rcases hS2 q hq_exc hq_cl with ⟨c₁, P₁, hP₁_w, hP₁_id⟩ | ⟨_, P₂, hP₂_w, hP₂_id⟩
        · by_cases hc_eq : c₁ = c_bad
          · subst hc_eq
            exact ⟨P₁, hP₁_w, hP₁_id⟩
          · exfalso
            exact hExcl q a' b' hb'
              (hLiftChart R₁ ι₁ φ₁ P₁ q 1 0 hOpen₁ hι₁_π hP₁_w (h1_good c₁ P₁ hc_eq hP₁_id))
              hNC_nod
        · exfalso
          exact hExcl q a' b' hb'
            (hLiftChart R₂ ι₂ φ₂ P₂ q 1 0 hOpen₂ hι₂_π hP₂_w (h2_good P₂ hP₂_id))
            hNC_nod
      intro q₁ ⟨hq₁_exc, hq₁_cl, hq₁_nod⟩ q₂ ⟨hq₂_exc, hq₂_cl, hq₂_nod⟩
      obtain ⟨P₁_1, hP₁_1_w, hP₁_1_id⟩ := hAtBad q₁ hq₁_exc hq₁_cl hq₁_nod
      obtain ⟨P₁_2, hP₁_2_w, hP₁_2_id⟩ := hAtBad q₂ hq₂_exc hq₂_cl hq₂_nod
      have hP_eq : P₁_1 = P₁_2 := PrimeSpectrum.ext (hP₁_1_id.trans hP₁_2_id.symm)
      apply hinj_fst'
      rw [← hP₁_1_w, ← hP₁_2_w, hP_eq]
    · have hAtInf : ∀ q : ↥(CategoryTheory.Limits.pullback g_W' s_Ω),
          q ∈ E_exc →
          IsClosed ({q} : Set ↥(CategoryTheory.Limits.pullback g_W' s_Ω)) →
          (∃ a' b' : ℕ, 1 ≤ b' ∧ HasNCBranchAt Ω g_W' q a' b') →
          ∃ P₂ : AlgebraicGeometry.Spec R₂,
            ι₂.base P₂ = fst'_0.base q ∧
            P₂.asIdeal = Ideal.span ({φ₂.hom z₂, s₂} : Set R₂) := by
        intro q hq_exc hq_cl ⟨a', b', hb', hNC_nod⟩
        rcases hS2 q hq_exc hq_cl with ⟨c₁, P₁, hP₁_w, hP₁_id⟩ | ⟨_, P₂, hP₂_w, hP₂_id⟩
        · exfalso
          exact hExcl q a' b' hb'
            (hLiftChart R₁ ι₁ φ₁ P₁ q 1 0 hOpen₁ hι₁_π hP₁_w (h1_all c₁ P₁ hP₁_id))
            hNC_nod
        · exact ⟨P₂, hP₂_w, hP₂_id⟩
      intro q₁ ⟨hq₁_exc, hq₁_cl, hq₁_nod⟩ q₂ ⟨hq₂_exc, hq₂_cl, hq₂_nod⟩
      obtain ⟨P₂_1, hP₂_1_w, hP₂_1_id⟩ := hAtInf q₁ hq₁_exc hq₁_cl hq₁_nod
      obtain ⟨P₂_2, hP₂_2_w, hP₂_2_id⟩ := hAtInf q₂ hq₂_exc hq₂_cl hq₂_nod
      have hP_eq : P₂_1 = P₂_2 := PrimeSpectrum.ext (hP₂_1_id.trans hP₂_2_id.symm)
      apply hinj_fst'
      rw [← hP₂_1_w, ← hP₂_2_w, hP_eq]

theorem weil_nc2d_single_closed_point_blowup (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (q₀ : ↥(CategoryTheory.Limits.pullback g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (hq₀ : IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g_W
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))) :
    ∃ (W' : AlgebraicGeometry.Scheme.{u})
      (g_W' : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_W' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W'))
      (π : W' ⟶ W),
      IsNC2DClosedPointBlowup Ω n g_W τ_W g_W' τ_W' q₀ π :=
by
  classical
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  obtain ⟨hAff_proj, c_proj, t_proj, hCoord_proj, hBC_proj⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  obtain ⟨a, b, R₀, p₀, ι₀, z₁, z₂, A', v₀, e_U, u, v, ε,
      hOpen₀, hp₀_w₀, hDom₀, hp₀_span, hz₁_ne, hreg₀, hres₀,
      hEt, hDomA, he_pre, hv₀_span, hu_ne, hregA, hresA_comp, hε, ha_pos, hX_comp⟩ :=
    hW.2.2.2.2.2.2.2.2 q₀ hq₀
  have _ : IsDomain R₀ := hDom₀
  have _ : IsDomain A' := hDomA
  let g_R₀ : AlgebraicGeometry.Spec R₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
    ι₀ ≫ g_W
  let φ₀ : PowerSeries Ω →+* R₀ := (AlgebraicGeometry.Spec.preimage g_R₀).hom
  let φ_e : R₀ →+* A' := (AlgebraicGeometry.Spec.preimage e_U).hom
  have hLFP₀ : AlgebraicGeometry.LocallyOfFinitePresentation g_R₀ := by
    have _ : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
    have _ : AlgebraicGeometry.LocallyOfFinitePresentation g_W := hW.2.2.2.1
    dsimp [g_R₀]
    infer_instance
  have hpre_eU_gR0 : (AlgebraicGeometry.Spec.preimage (e_U ≫ ι₀ ≫ g_W)).hom = φ_e.comp φ₀ := by
    change (AlgebraicGeometry.Spec.preimage (e_U ≫ g_R₀)).hom = φ_e.comp φ₀
    rw [AlgebraicGeometry.Spec.preimage_comp, CommRingCat.hom_comp]
  have hresA : ∀ r' : A', ∃ c : Ω, r' - φ_e (φ₀ (PowerSeries.C c)) ∈ v₀.asIdeal := by
    intro r'
    obtain ⟨c, hc⟩ := hresA_comp r'
    rw [hpre_eU_gR0] at hc
    exact ⟨c, hc⟩
  have hX_eq : φ_e (φ₀ PowerSeries.X) = ε * u ^ a * v ^ b := by
    have htmp := hX_comp
    rw [hpre_eU_gR0] at htmp
    exact htmp
  have hv_ne : v ≠ 0 := by
    intro hv0
    have h1u : (1 : A') ∈ Ideal.span ({u} : Set A') := by
      apply hregA 1
      rw [hv0, zero_mul]
      exact Ideal.zero_mem _
    have h1v0 : (1 : A') ∈ v₀.asIdeal := by
      rw [hv₀_span]
      exact Ideal.span_mono (by simp) h1u
    exact v₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1v0)
  have hX_ne : φ₀ PowerSeries.X ≠ 0 := by
    intro h0
    have h1 : φ_e (φ₀ PowerSeries.X) = 0 := by rw [h0, map_zero]
    rw [hX_eq] at h1
    exact mul_ne_zero (mul_ne_zero hε.ne_zero (pow_ne_zero a hu_ne)) (pow_ne_zero b hv_ne) h1
  
  have hPS_decomp : ∀ f : PowerSeries Ω,
      f = PowerSeries.C (PowerSeries.constantCoeff f) +
        PowerSeries.X * PowerSeries.mk (fun k => PowerSeries.coeff (k + 1) f) := by
    intro f
    ext k
    cases k with
    | zero => simp [PowerSeries.coeff_zero_eq_constantCoeff]
    | succ k => simp [PowerSeries.coeff_succ_X_mul]
  have hPS_inj : ∀ (B : Type u) [CommRing B] [IsDomain B] (ψ : PowerSeries Ω →+* B),
      ψ PowerSeries.X ≠ 0 → Function.Injective ψ := by
    intro B _ _ ψ hX_B
    rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
    intro f hf
    rw [RingHom.mem_ker] at hf
    have hpow : ∀ m : ℕ, ∃ g : PowerSeries Ω, f = PowerSeries.X ^ m * g ∧ ψ g = 0 := by
      intro m
      induction m with
      | zero => exact ⟨f, by simp, hf⟩
      | succ m ih =>
        obtain ⟨g, hfg, hψg⟩ := ih
        let g' : PowerSeries Ω := PowerSeries.mk (fun k => PowerSeries.coeff (k + 1) g)
        have hg_eq : g = PowerSeries.C (PowerSeries.constantCoeff g) + PowerSeries.X * g' :=
          hPS_decomp g
        have hc0 : PowerSeries.constantCoeff g = 0 := by
          by_contra hc_ne
          have hunit_g : IsUnit g :=
            PowerSeries.isUnit_iff_constantCoeff.mpr (IsUnit.mk0 _ hc_ne)
          have hunit_ψg : IsUnit (ψ g) := hunit_g.map ψ
          rw [hψg] at hunit_ψg
          exact not_isUnit_zero hunit_ψg
        have hg_mul : g = PowerSeries.X * g' := by
          rw [hg_eq, hc0, map_zero, zero_add]
        have hψg' : ψ g' = 0 := by
          have hmul0 : ψ PowerSeries.X * ψ g' = 0 := by
            rw [← map_mul, ← hg_mul, hψg]
          exact (mul_eq_zero.mp hmul0).resolve_left hX_B
        refine ⟨g', ?_, hψg'⟩
        rw [hfg, hg_mul, pow_succ, mul_assoc]
    ext m
    obtain ⟨g, hfg, _⟩ := hpow (m + 1)
    rw [hfg, map_zero]
    simp [PowerSeries.coeff_X_pow_mul']
  
  have hFP₀ : φ₀.FinitePresentation := by
    have hmap : AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage g_R₀)) := by
      rwa [AlgebraicGeometry.Spec.map_preimage]
    exact (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hmap
  have hz₂_ne : z₂ ≠ 0 := by
    intro h0
    have h1 : (1 : R₀) ∈ Ideal.span ({z₁} : Set R₀) := by
      apply hreg₀ 1
      rw [h0, zero_mul]
      exact Ideal.zero_mem _
    have h1p : (1 : R₀) ∈ p₀.asIdeal := by
      rw [hp₀_span]
      exact Ideal.span_mono (by simp) h1
    exact p₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1p)
  have hreg_symm : ∀ y : R₀, z₁ * y ∈ Ideal.span ({z₂} : Set R₀) → y ∈ Ideal.span ({z₂} : Set R₀) := by
    intro y hy
    rw [Ideal.mem_span_singleton] at hy ⊢
    obtain ⟨x, hx⟩ := hy
    have hzx : z₂ * x ∈ Ideal.span ({z₁} : Set R₀) :=
      Ideal.mem_span_singleton.mpr ⟨y, hx.symm⟩
    obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp (hreg₀ x hzx)
    refine ⟨w, ?_⟩
    apply mul_left_cancel₀ hz₁_ne
    linear_combination hx
  have hz₁₂ : z₁ * z₂ ≠ 0 := mul_ne_zero hz₁_ne hz₂_ne
  have _ : Nontrivial (R₀ ⧸ p₀.asIdeal) :=
    Ideal.Quotient.nontrivial_iff.mpr p₀.isPrime.ne_top
  let α_res : Ω →+* R₀ ⧸ p₀.asIdeal :=
    (Ideal.Quotient.mk p₀.asIdeal).comp (φ₀.comp PowerSeries.C)
  have hα_bij : Function.Bijective α_res := by
    refine ⟨α_res.injective, ?_⟩
    intro q
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨c, hc⟩ := hres₀ r
    refine ⟨c, ?_⟩
    dsimp [α_res]
    rw [eq_comm, Ideal.Quotient.eq]
    exact hc
  let e_res : Ω ≃+* R₀ ⧸ p₀.asIdeal := RingEquiv.ofBijective α_res hα_bij
  have hMax : p₀.asIdeal.IsMaximal :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient p₀.asIdeal).mpr
      (e_res.symm.toMulEquiv.isField (Field.toIsField Ω))
  have hZero_p₀ : PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀) = {p₀} := by
    ext q
    simp only [PrimeSpectrum.mem_zeroLocus]
    refine ⟨fun hle => PrimeSpectrum.ext (hMax.eq_of_le q.isPrime.ne_top hle).symm, ?_⟩
    rintro rfl; exact le_rfl
  let φ_res : R₀ →+* Ω := e_res.symm.toRingHom.comp (Ideal.Quotient.mk p₀.asIdeal)
  have hSurj_res : Function.Surjective φ_res :=
    e_res.symm.surjective.comp Ideal.Quotient.mk_surjective
  have hKer_res : RingHom.ker φ_res = p₀.asIdeal := by
    ext r
    change e_res.symm (Ideal.Quotient.mk p₀.asIdeal r) = 0 ↔ r ∈ p₀.asIdeal
    rw [RingEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
  have hC_res : ∀ c : Ω, φ_res (φ₀ (PowerSeries.C c)) = c :=
    fun c => e_res.symm_apply_apply c
  
  have hres_const : φ_res.comp φ₀ = (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) := by
    have hv₀_p₀ : e_U.base v₀ = p₀ := by
      have hv_mem : v₀ ∈ e_U.base ⁻¹' ({p₀} : Set (AlgebraicGeometry.Spec R₀)) := by
        rw [he_pre]; exact Set.mem_singleton v₀
      exact Set.mem_singleton_iff.mp hv_mem
    have he_map : e_U = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_U) :=
      (AlgebraicGeometry.Spec.map_preimage e_U).symm
    have hp₀_comap : p₀.asIdeal = Ideal.comap φ_e v₀.asIdeal := by
      conv_lhs => rw [← hv₀_p₀, he_map, AlgebraicGeometry.Spec.map_apply]
      rfl
    have hX_in_p0 : φ₀ PowerSeries.X ∈ p₀.asIdeal := by
      rw [hp₀_comap, Ideal.mem_comap, hX_eq]
      obtain ⟨a', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : a ≠ 0)
      have hu_mem : u ∈ v₀.asIdeal := by
        rw [hv₀_span]; exact Ideal.subset_span (by simp)
      have hmul_u : ε * u ^ (a' + 1) * v ^ b = u * (ε * u ^ a' * v ^ b) := by
        rw [pow_succ]; ring
      rw [hmul_u]
      exact Ideal.mul_mem_right _ _ hu_mem
    have hX_res : φ_res (φ₀ PowerSeries.X) = 0 := by
      rw [← RingHom.mem_ker, hKer_res]; exact hX_in_p0
    ext f
    conv_lhs => rw [hPS_decomp f]
    simp only [RingHom.comp_apply, map_add, map_mul, hC_res, hX_res, zero_mul, add_zero]
  let L₀ : CommRingCat.{u} := CommRingCat.of (Localization.Away (z₁ * z₂))
  let ι_L0 : R₀ ⟶ L₀ := CommRingCat.ofHom (algebraMap R₀ (Localization.Away (z₁ * z₂)))
  have hSubNzd : Submonoid.powers (z₁ * z₂) ≤ nonZeroDivisors R₀ :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hz₁₂)
  have hDomL : IsDomain L₀ :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away (z₁ * z₂)) hSubNzd
  have _ : IsDomain L₀ := hDomL
  have hinj_L0 : Function.Injective ι_L0.hom :=
    IsLocalization.injective (Localization.Away (z₁ * z₂)) hSubNzd
  have hLoc_L0 : @IsLocalization.Away R₀ _ (z₁ * z₂) L₀ _ ι_L0.hom.toAlgebra := by
    have halg_eq : ι_L0.hom.toAlgebra =
        (inferInstance : Algebra R₀ (Localization.Away (z₁ * z₂))) :=
      Algebra.algebra_ext _ _ (fun _ => rfl)
    exact halg_eq ▸ (inferInstance : IsLocalization.Away (z₁ * z₂) (Localization.Away (z₁ * z₂)))
  let u₁₂ : L₀ := IsLocalization.Away.invSelf (S := Localization.Away (z₁ * z₂)) (z₁ * z₂)
  have hu₁₂ : ι_L0.hom (z₁ * z₂) * u₁₂ = 1 :=
    IsLocalization.Away.mul_invSelf (S := Localization.Away (z₁ * z₂)) (z₁ * z₂)
  let t₁ : L₀ := ι_L0.hom z₂ * (ι_L0.hom z₂ * u₁₂)
  let t₂ : L₀ := ι_L0.hom z₁ * (ι_L0.hom z₁ * u₁₂)
  have ht₁ : ι_L0.hom z₂ = ι_L0.hom z₁ * t₁ := by
    dsimp [t₁]
    calc ι_L0.hom z₂
        = ι_L0.hom z₂ * (ι_L0.hom (z₁ * z₂) * u₁₂) := by rw [hu₁₂, mul_one]
      _ = ι_L0.hom z₁ * (ι_L0.hom z₂ * (ι_L0.hom z₂ * u₁₂)) := by rw [map_mul]; ring
  have ht₂ : ι_L0.hom z₁ = ι_L0.hom z₂ * t₂ := by
    dsimp [t₂]
    calc ι_L0.hom z₁
        = ι_L0.hom z₁ * (ι_L0.hom (z₁ * z₂) * u₁₂) := by rw [hu₁₂, mul_one]
      _ = ι_L0.hom z₂ * (ι_L0.hom z₁ * (ι_L0.hom z₁ * u₁₂)) := by rw [map_mul]; ring
  have ht₁₂_mul : t₁ * t₂ = 1 := by
    dsimp [t₁, t₂]
    calc (ι_L0.hom z₂ * (ι_L0.hom z₂ * u₁₂)) * (ι_L0.hom z₁ * (ι_L0.hom z₁ * u₁₂))
        = (ι_L0.hom (z₁ * z₂) * u₁₂) * (ι_L0.hom (z₁ * z₂) * u₁₂) := by rw [map_mul]; ring
      _ = 1 := by rw [hu₁₂, mul_one]
  
  have hBuildChart : ∀ (w₁ w₂ : R₀),
      p₀.asIdeal = Ideal.span ({w₁, w₂} : Set R₀) →
      w₁ ≠ 0 →
      w₂ ≠ 0 →
      (∀ y : R₀, w₂ * y ∈ Ideal.span ({w₁} : Set R₀) → y ∈ Ideal.span ({w₁} : Set R₀)) →
      @IsLocalization.Away R₀ _ (w₁ * w₂) L₀ _ ι_L0.hom.toAlgebra →
      ∀ (t_w : L₀), ι_L0.hom w₂ = ι_L0.hom w₁ * t_w →
      ∃ (R_w : CommRingCat.{u}) (φ_w : R₀ ⟶ R_w) (s_w : R_w)
        (ι_Lw : R_w ⟶ L₀) (ψ_exc_w : R_w →+* Polynomial Ω),
        IsDomain R_w ∧
        IsLinearBlowupQuot w₁ w₂ φ_w s_w ∧
        (φ_w.hom.comp φ₀).Flat ∧
        (φ_w.hom.comp φ₀).FinitePresentation ∧
        φ_w.hom (φ₀ PowerSeries.X) ≠ 0 ∧
        φ_w.hom w₁ ≠ 0 ∧
        s_w ≠ 0 ∧
        Function.Injective ι_Lw.hom ∧
        φ_w ≫ ι_Lw = ι_L0 ∧
        ι_Lw.hom s_w = t_w ∧
        (∀ x_w : R_w, ∃ d : ℕ, ∃ A : R₀, (φ_w.hom w₁) ^ d * x_w = φ_w.hom A) ∧
        @IsLocalization.Away R_w _ (φ_w.hom w₁ * s_w) L₀ _ ι_Lw.hom.toAlgebra ∧
        (∀ (C_loc : Type u) [CommRing C_loc] [Algebra R_w C_loc],
          IsLocalization.Away (φ_w.hom w₁) C_loc →
          @IsLocalization.Away R₀ _ w₁ C_loc _ ((algebraMap R_w C_loc).comp φ_w.hom).toAlgebra) ∧
        Function.Surjective ψ_exc_w ∧
        RingHom.ker ψ_exc_w = Ideal.span ({φ_w.hom w₁} : Set R_w) ∧
        ψ_exc_w s_w = Polynomial.X ∧
        (∀ r : R₀, ψ_exc_w (φ_w.hom r) = Polynomial.C (φ_res r)) := by
    intro w₁ w₂ hp_w hw₁ hw₂ hreg_w hLoc_w t_w ht_w
    let J_w : Ideal (Polynomial R₀) :=
      Ideal.span ({Polynomial.C w₂ - Polynomial.C w₁ * Polynomial.X} : Set (Polynomial R₀))
    let R_w : CommRingCat.{u} := CommRingCat.of (Polynomial R₀ ⧸ J_w)
    let φ_w : R₀ ⟶ R_w := CommRingCat.ofHom ((Ideal.Quotient.mk J_w).comp Polynomial.C)
    let s_w : R_w := Ideal.Quotient.mk J_w Polynomial.X
    have hQuot_w : IsLinearBlowupQuot w₁ w₂ φ_w s_w := by
      refine ⟨?_, ?_⟩
      · change Ideal.Quotient.mk J_w (Polynomial.C w₂) =
          Ideal.Quotient.mk J_w (Polynomial.C w₁) * Ideal.Quotient.mk J_w Polynomial.X
        rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span rfl
      · intro B _ ρ t hρt
        let ev : Polynomial R₀ →+* B := Polynomial.eval₂RingHom ρ t
        have hker' : ∀ a ∈ J_w, ev a = 0 := by
          intro a ha
          have hker : J_w ≤ RingHom.ker ev := by
            rw [Ideal.span_le]
            intro p hp
            rcases Set.mem_singleton_iff.mp hp with rfl
            simp [ev, hρt]
          exact RingHom.mem_ker.mp (hker ha)
        refine ⟨⟨Ideal.Quotient.lift J_w ev hker', ?_, ?_⟩, ?_⟩
        · ext r
          exact (Ideal.Quotient.lift_mk J_w ev hker').trans (by simp [ev])
        · exact (Ideal.Quotient.lift_mk J_w ev hker').trans (by simp [ev])
        · intro ψ₁ ψ₂ h1c h1s h2c h2s
          apply Ideal.Quotient.ringHom_ext
          apply Polynomial.ringHom_ext'
          · exact h1c.trans h2c.symm
          · exact h1s.trans h2s.symm
    obtain ⟨⟨f_Lw, hf_Lw_comp, hf_Lw_s⟩, _⟩ := hQuot_w.2 L₀ ι_L0.hom t_w ht_w
    let ι_Lw : R_w ⟶ L₀ := CommRingCat.ofHom f_Lw
    have hw₂_pow_reg : ∀ (k : ℕ) (y : R₀),
        w₂ ^ k * y ∈ Ideal.span ({w₁} : Set R₀) → y ∈ Ideal.span ({w₁} : Set R₀) := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        intro y hy
        apply ih
        apply hreg_w
        simpa [pow_succ', mul_assoc] using hy
    have hker_deg : ∀ (N : ℕ) (P : Polynomial R₀),
        (∀ j > N, P.coeff j = 0) →
        Polynomial.eval₂ ι_L0.hom t_w P = 0 →
        P ∈ J_w := by
      intro N
      induction N with
      | zero =>
        intro P hdeg hev
        have hP : P = Polynomial.C (P.coeff 0) := by
          ext j
          cases j with
          | zero => simp
          | succ j => simp [hdeg (j + 1) (Nat.succ_pos j)]
        rw [hP] at hev ⊢
        simp only [Polynomial.eval₂_C] at hev
        rw [hinj_L0 (hev.trans (map_zero _).symm), map_zero]
        exact Ideal.zero_mem J_w
      | succ N ih =>
        intro P hdeg hev
        have hsum : P = ∑ j ∈ Finset.range (N + 2), Polynomial.C (P.coeff j) * Polynomial.X ^ j := by
          ext k
          rw [Polynomial.finsetSum_coeff]
          simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
          by_cases hk : k < N + 2
          · rw [Finset.sum_eq_single k]
            · simp
            · intro b _ hbk; simp [Ne.symm hbk]
            · intro hnot; exact absurd (Finset.mem_range.mpr hk) hnot
          · rw [Finset.sum_eq_zero]
            · exact hdeg k (by omega)
            · intro b hb
              have hbk : k ≠ b := by have := Finset.mem_range.mp hb; omega
              simp [hbk]
        have hmul : (ι_L0.hom w₁) ^ (N + 1) * Polynomial.eval₂ ι_L0.hom t_w P =
            ι_L0.hom (∑ j ∈ Finset.range (N + 2),
              P.coeff j * w₁ ^ (N + 1 - j) * w₂ ^ j) := by
          conv_lhs => rw [hsum]
          rw [Polynomial.eval₂_finsetSum, Finset.mul_sum, map_sum]
          apply Finset.sum_congr rfl
          intro j hj
          have hj_le : j ≤ N + 1 := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow,
            map_mul, map_mul, map_pow, map_pow]
          have hpow : (ι_L0.hom w₁) ^ (N + 1) * t_w ^ j =
              (ι_L0.hom w₁) ^ (N + 1 - j) * (ι_L0.hom w₂) ^ j := by
            calc (ι_L0.hom w₁) ^ (N + 1) * t_w ^ j
                = (ι_L0.hom w₁) ^ (N + 1 - j + j) * t_w ^ j := by rw [Nat.sub_add_cancel hj_le]
              _ = (ι_L0.hom w₁) ^ (N + 1 - j) * ((ι_L0.hom w₁) ^ j * t_w ^ j) := by
                    rw [pow_add, mul_assoc]
              _ = (ι_L0.hom w₁) ^ (N + 1 - j) * (ι_L0.hom w₁ * t_w) ^ j := by rw [mul_pow]
              _ = (ι_L0.hom w₁) ^ (N + 1 - j) * (ι_L0.hom w₂) ^ j := by rw [← ht_w]
          calc (ι_L0.hom w₁) ^ (N + 1) * (ι_L0.hom (P.coeff j) * t_w ^ j)
              = ι_L0.hom (P.coeff j) * ((ι_L0.hom w₁) ^ (N + 1) * t_w ^ j) := by ring
            _ = ι_L0.hom (P.coeff j) *
                  ((ι_L0.hom w₁) ^ (N + 1 - j) * (ι_L0.hom w₂) ^ j) := by rw [hpow]
            _ = ι_L0.hom (P.coeff j) *
                  (ι_L0.hom w₁) ^ (N + 1 - j) * (ι_L0.hom w₂) ^ j := by ring
        rw [hev, mul_zero] at hmul
        have hsum_zero : (∑ j ∈ Finset.range (N + 2),
            P.coeff j * w₁ ^ (N + 1 - j) * w₂ ^ j) = 0 :=
          hinj_L0 (hmul.symm.trans (map_zero _).symm)
        rw [Finset.sum_range_succ] at hsum_zero
        simp only [Nat.sub_self, pow_zero, mul_one] at hsum_zero
        have htop_mem : w₂ ^ (N + 1) * P.coeff (N + 1) ∈ Ideal.span ({w₁} : Set R₀) := by
          rw [Ideal.mem_span_singleton]
          refine ⟨- ∑ x ∈ Finset.range (N + 1), P.coeff x * w₁ ^ (N - x) * w₂ ^ x, ?_⟩
          have hsplit : ∑ x ∈ Finset.range (N + 1), P.coeff x * w₁ ^ (N + 1 - x) * w₂ ^ x =
              w₁ * ∑ x ∈ Finset.range (N + 1), P.coeff x * w₁ ^ (N - x) * w₂ ^ x := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro x hx
            have hx_le : x ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hx)
            have hsub : N + 1 - x = (N - x) + 1 := by omega
            rw [hsub, pow_succ]
            ring
          rw [hsplit] at hsum_zero
          linear_combination hsum_zero
        obtain ⟨b₀, hb₀⟩ := Ideal.mem_span_singleton.mp (hw₂_pow_reg (N + 1) _ htop_mem)
        let Q : Polynomial R₀ :=
          P + Polynomial.C b₀ * Polynomial.X ^ N * (Polynomial.C w₂ - Polynomial.C w₁ * Polynomial.X)
        have hQ_eq : Q = P + Polynomial.C (b₀ * w₂) * Polynomial.X ^ N -
            Polynomial.C (b₀ * w₁) * Polynomial.X ^ (N + 1) := by
          dsimp [Q]
          simp only [Polynomial.C_mul]
          ring
        have hQ_deg : ∀ j > N, Q.coeff j = 0 := by
          intro j hj
          rw [hQ_eq, Polynomial.coeff_sub, Polynomial.coeff_add,
            Polynomial.coeff_C_mul, Polynomial.coeff_C_mul,
            Polynomial.coeff_X_pow, Polynomial.coeff_X_pow]
          by_cases hj1 : j = N + 1
          · subst hj1
            have hne : N + 1 ≠ N := by omega
            simp only [hne, ↓reduceIte, mul_zero, add_zero, mul_one, hb₀]
            ring
          · have hj2 : j > N + 1 := by omega
            have hne1 : j ≠ N := by omega
            simp only [hdeg j hj2, hne1, hj1, ↓reduceIte, mul_zero, add_zero, sub_zero]
        have hQ_ev : Polynomial.eval₂ ι_L0.hom t_w Q = 0 := by
          dsimp [Q]
          simp [hev, ht_w]
        have hQ_mem : Q ∈ J_w := ih Q hQ_deg hQ_ev
        have hdiff : Q - P ∈ J_w := by
          dsimp [Q]
          rw [add_sub_cancel_left]
          exact Ideal.mul_mem_left J_w _ (Ideal.subset_span rfl)
        have hQP : Q - (Q - P) = P := sub_sub_cancel Q P
        rw [← hQP]
        exact J_w.sub_mem hQ_mem hdiff
    have hinj_fLw : Function.Injective ι_Lw.hom := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [RingHom.mem_ker] at hx
      have hev : Polynomial.eval₂ ι_L0.hom t_w P = 0 := by
        have hcomp : f_Lw.comp (Ideal.Quotient.mk J_w) = Polynomial.eval₂RingHom ι_L0.hom t_w := by
          apply Polynomial.ringHom_ext'
          · ext r
            simpa [φ_w] using RingHom.congr_fun hf_Lw_comp r
          · simpa [s_w] using hf_Lw_s
        exact (RingHom.congr_fun hcomp P).symm.trans hx
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact hker_deg P.natDegree P (fun j hj => Polynomial.coeff_eq_zero_of_natDegree_lt hj) hev
    have hDom_w : IsDomain R_w := hinj_fLw.isDomain ι_Lw.hom
    have _ : IsDomain R_w := hDom_w
    have hcomp_Lw : φ_w ≫ ι_Lw = ι_L0 := CommRingCat.hom_ext hf_Lw_comp
    have hinj_φw : Function.Injective φ_w.hom := by
      intro x y hxy
      apply hinj_L0
      rw [← hf_Lw_comp]
      change f_Lw (φ_w.hom x) = f_Lw (φ_w.hom y)
      rw [hxy]
    have hXw_ne : φ_w.hom (φ₀ PowerSeries.X) ≠ 0 :=
      fun h => hX_ne (hinj_φw (h.trans (map_zero _).symm))
    have hw1_Rw_ne : φ_w.hom w₁ ≠ 0 :=
      fun h => hw₁ (hinj_φw (h.trans (map_zero _).symm))
    have hw2_Rw_ne : φ_w.hom w₂ ≠ 0 :=
      fun h => hw₂ (hinj_φw (h.trans (map_zero _).symm))
    have hsw_ne : s_w ≠ 0 := by
      intro h0
      have hw2 : φ_w.hom w₂ = 0 := by rw [hQuot_w.1, h0, mul_zero]
      exact hw2_Rw_ne hw2
    have hFlat_w : (φ_w.hom.comp φ₀).Flat := by
      let _ : Algebra (PowerSeries Ω) R_w := (φ_w.hom.comp φ₀).toAlgebra
      have hinj_ps : Function.Injective (algebraMap (PowerSeries Ω) R_w) :=
        hPS_inj R_w (φ_w.hom.comp φ₀) hXw_ne
      have hTF : Module.IsTorsionFree (PowerSeries Ω) R_w :=
        (Module.isTorsionFree_iff_algebraMap_injective (R := PowerSeries Ω) (A := R_w)).mpr hinj_ps
      exact @Module.Flat.instOfIsDedekindDomainOfIsTorsionFree (PowerSeries Ω) R_w _ _ _ inferInstance hTF
    have hFP_φw : φ_w.hom.FinitePresentation := by
      let _ : Algebra R₀ R_w := φ_w.hom.toAlgebra
      change Algebra.FinitePresentation R₀ R_w
      let ev_mv : MvPolynomial (Fin 1) R₀ →ₐ[R₀] R_w :=
        MvPolynomial.aeval (fun _ : Fin 1 => s_w)
      have hSurj_mv : Function.Surjective ev_mv := by
        intro x
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        refine ⟨Polynomial.aeval (MvPolynomial.X (0 : Fin 1)) P, ?_⟩
        induction P using Polynomial.induction_on' with
        | add p q hp hq => simp only [map_add, hp, hq]
        | monomial m a₀ =>
          rw [Polynomial.aeval_monomial, map_mul, AlgHom.commutes, map_pow, MvPolynomial.aeval_X,
            ← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
          rfl
      have hNoeth₀ : IsNoetherianRing R₀ := by
        let _ : Algebra (PowerSeries Ω) R₀ := φ₀.toAlgebra
        have : Algebra.FiniteType (PowerSeries Ω) R₀ :=
          RingHom.FiniteType.of_finitePresentation hFP₀
        exact Algebra.FiniteType.isNoetherianRing (PowerSeries Ω) R₀
      have _ : IsNoetherianRing (MvPolynomial (Fin 1) R₀) := inferInstance
      exact Algebra.FinitePresentation.of_surjective hSurj_mv
        (IsNoetherian.noetherian (RingHom.ker ev_mv.toRingHom))
    have hFP_w : (φ_w.hom.comp φ₀).FinitePresentation := hFP_φw.comp hFP₀
    have hClear_w : ∀ x_w : R_w, ∃ d : ℕ, ∃ A : R₀, (φ_w.hom w₁) ^ d * x_w = φ_w.hom A := by
      intro x_w
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x_w
      let d := P.natDegree
      refine ⟨d, ∑ j ∈ Finset.range (d + 1), P.coeff j * w₁ ^ (d - j) * w₂ ^ j, ?_⟩
      have hP : P = ∑ j ∈ Finset.range (d + 1), Polynomial.C (P.coeff j) * Polynomial.X ^ j := by
        ext m
        rw [Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
        by_cases hm : m < d + 1
        · rw [Finset.sum_eq_single m]
          · simp
          · intro b₀ _ hbm; simp [Ne.symm hbm]
          · intro hnot; exact absurd (Finset.mem_range.mpr hm) hnot
        · rw [Finset.sum_eq_zero]
          · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
          · intro b₀ hb
            have hmb : m ≠ b₀ := by have := Finset.mem_range.mp hb; omega
            simp [hmb]
      conv_lhs => rw [hP]
      rw [map_sum, Finset.mul_sum, map_sum]
      apply Finset.sum_congr rfl
      intro j hj
      have hj_le : j ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      change (φ_w.hom w₁) ^ d * (φ_w.hom (P.coeff j) * s_w ^ j) =
        φ_w.hom (P.coeff j * w₁ ^ (d - j) * w₂ ^ j)
      have hpow : (φ_w.hom w₁) ^ d * s_w ^ j = (φ_w.hom w₁) ^ (d - j) * (φ_w.hom w₂) ^ j := by
        calc (φ_w.hom w₁) ^ d * s_w ^ j
            = (φ_w.hom w₁) ^ (d - j + j) * s_w ^ j := by rw [Nat.sub_add_cancel hj_le]
          _ = (φ_w.hom w₁) ^ (d - j) * ((φ_w.hom w₁) ^ j * s_w ^ j) := by rw [pow_add, mul_assoc]
          _ = (φ_w.hom w₁) ^ (d - j) * (φ_w.hom w₁ * s_w) ^ j := by rw [mul_pow]
          _ = (φ_w.hom w₁) ^ (d - j) * (φ_w.hom w₂) ^ j := by rw [← hQuot_w.1]
      calc (φ_w.hom w₁) ^ d * (φ_w.hom (P.coeff j) * s_w ^ j)
          = φ_w.hom (P.coeff j) * ((φ_w.hom w₁) ^ d * s_w ^ j) := by ring
        _ = φ_w.hom (P.coeff j) * ((φ_w.hom w₁) ^ (d - j) * (φ_w.hom w₂) ^ j) := by rw [hpow]
        _ = φ_w.hom (P.coeff j * w₁ ^ (d - j) * w₂ ^ j) := by
              simp only [map_mul, map_pow]; ring
    have hLoc_Lw : @IsLocalization.Away R_w _ (φ_w.hom w₁ * s_w) L₀ _ ι_Lw.hom.toAlgebra := by
      let _ : Algebra R₀ L₀ := ι_L0.hom.toAlgebra
      let _ : Algebra R_w L₀ := ι_Lw.hom.toAlgebra
      have halg0 : algebraMap R₀ L₀ = ι_L0.hom := rfl
      have halg1 : algebraMap R_w L₀ = ι_Lw.hom := rfl
      have hu12_w : IsUnit (ι_L0.hom (w₁ * w₂)) := by
        have := @IsLocalization.map_units R₀ _ (Submonoid.powers (w₁ * w₂)) L₀ _ _ hLoc_w
          ⟨w₁ * w₂, Submonoid.mem_powers _⟩
        simpa [halg0] using this
      have hu_w2 : IsUnit (ι_L0.hom w₂) := by
        rw [map_mul] at hu12_w
        exact isUnit_of_mul_isUnit_right hu12_w
      refine ⟨⟨?_, ?_, ?_⟩⟩
      · rintro ⟨_, k, rfl⟩
        rw [halg1, map_pow, ← hQuot_w.1]
        change IsUnit ((f_Lw (φ_w.hom w₂)) ^ k)
        have hf0 : f_Lw (φ_w.hom w₂) = ι_L0.hom w₂ := RingHom.congr_fun hf_Lw_comp w₂
        rw [hf0]
        exact IsUnit.pow k hu_w2
      · intro x
        obtain ⟨⟨r, _, k, rfl⟩, hxr⟩ :=
          @IsLocalization.surj R₀ _ (Submonoid.powers (w₁ * w₂)) L₀ _ _ hLoc_w x
        refine ⟨⟨φ_w.hom r * s_w ^ k, ⟨(φ_w.hom w₁ * s_w) ^ (2 * k), 2 * k, rfl⟩⟩, ?_⟩
        dsimp only at hxr ⊢
        rw [halg0] at hxr
        rw [halg1]
        have hden : (φ_w.hom w₁ * s_w) ^ (2 * k) = φ_w.hom ((w₁ * w₂) ^ k) * s_w ^ k := by
          calc (φ_w.hom w₁ * s_w) ^ (2 * k)
              = ((φ_w.hom w₁ * s_w) * (φ_w.hom w₁ * s_w)) ^ k := by rw [pow_mul, sq]
            _ = (φ_w.hom w₂ * (φ_w.hom w₁ * s_w)) ^ k := by rw [← hQuot_w.1]
            _ = ((φ_w.hom w₁ * φ_w.hom w₂) * s_w) ^ k := by ring
            _ = φ_w.hom ((w₁ * w₂) ^ k) * s_w ^ k := by rw [mul_pow, map_pow, map_mul]
        rw [hden, map_mul, ← mul_assoc]
        have h1 : x * ι_Lw.hom (φ_w.hom ((w₁ * w₂) ^ k)) = ι_Lw.hom (φ_w.hom r) := by
          have hf0 : ∀ a₀ : R₀, ι_Lw.hom (φ_w.hom a₀) = ι_L0.hom a₀ := RingHom.congr_fun hf_Lw_comp
          rw [hf0, hf0]
          exact hxr
        rw [h1, ← map_mul]
      · intro a₀ b₀ hab
        exact ⟨1, by simp [hinj_fLw hab]⟩
    have hLoc_w₁ : ∀ (C_loc : Type u) [CommRing C_loc] [Algebra R_w C_loc],
        IsLocalization.Away (φ_w.hom w₁) C_loc →
        @IsLocalization.Away R₀ _ w₁ C_loc _ ((algebraMap R_w C_loc).comp φ_w.hom).toAlgebra := by
      intro C_loc _ _ hLoc1
      let _ : Algebra R₀ C_loc := ((algebraMap R_w C_loc).comp φ_w.hom).toAlgebra
      have halg : algebraMap R₀ C_loc = (algebraMap R_w C_loc).comp φ_w.hom := rfl
      refine ⟨⟨?_, ?_, ?_⟩⟩
      · rintro ⟨_, k, rfl⟩
        rw [halg, RingHom.comp_apply, map_pow, map_pow]
        exact IsUnit.pow k (IsLocalization.map_units C_loc ⟨φ_w.hom w₁, Submonoid.mem_powers _⟩)
      · intro c
        obtain ⟨⟨x, _, k, rfl⟩, hcx⟩ := IsLocalization.surj (Submonoid.powers (φ_w.hom w₁)) c
        obtain ⟨d, A, hclear⟩ := hClear_w x
        refine ⟨⟨A, ⟨w₁ ^ (k + d), k + d, rfl⟩⟩, ?_⟩
        dsimp only at hcx ⊢
        rw [halg, RingHom.comp_apply, map_pow, pow_add, map_mul, ← mul_assoc, hcx,
          ← map_mul, mul_comm x, hclear]
        rfl
      · intro r₁ r₂ hr
        have hinj_C1 : Function.Injective (algebraMap R_w C_loc) :=
          IsLocalization.injective C_loc
            (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hw1_Rw_ne))
        exact ⟨1, by simp [hinj_φw (hinj_C1 hr)]⟩
    have hz_ker : Polynomial.C (φ_res w₂) = Polynomial.C (φ_res w₁) * (Polynomial.X : Polynomial Ω) := by
      have hw1_p : w₁ ∈ RingHom.ker φ_res := by
        rw [hKer_res, hp_w]; exact Ideal.subset_span (by simp)
      have hw2_p : w₂ ∈ RingHom.ker φ_res := by
        rw [hKer_res, hp_w]; exact Ideal.subset_span (by simp)
      rw [RingHom.mem_ker] at hw1_p hw2_p
      simp [hw1_p, hw2_p]
    obtain ⟨⟨ψ_exc_w, hψ_comp, hψ_s⟩, _⟩ :=
      hQuot_w.2 (Polynomial Ω) (Polynomial.C.comp φ_res) Polynomial.X hz_ker
    have hψ_r : ∀ r : R₀, ψ_exc_w (φ_w.hom r) = Polynomial.C (φ_res r) :=
      RingHom.congr_fun hψ_comp
    have hSurj_ψw : Function.Surjective ψ_exc_w := by
      intro Q
      induction Q using Polynomial.induction_on' with
      | add p q hp hq =>
        obtain ⟨xp, rfl⟩ := hp
        obtain ⟨xq, rfl⟩ := hq
        exact ⟨xp + xq, map_add _ _ _⟩
      | monomial m c =>
        obtain ⟨r, rfl⟩ := hSurj_res c
        refine ⟨φ_w.hom r * s_w ^ m, ?_⟩
        rw [map_mul, map_pow, hψ_r, hψ_s, Polynomial.C_mul_X_pow_eq_monomial]
    have hKer_ψw : RingHom.ker ψ_exc_w = Ideal.span ({φ_w.hom w₁} : Set R_w) := by
      apply le_antisymm
      · intro x hx
        rw [RingHom.mem_ker] at hx
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        let d := P.natDegree
        have hP : (Ideal.Quotient.mk J_w P : R_w) =
            ∑ j ∈ Finset.range (d + 1), φ_w.hom (P.coeff j) * s_w ^ j := by
          have hP_eq : P = ∑ j ∈ Finset.range (d + 1), Polynomial.C (P.coeff j) * Polynomial.X ^ j := by
            ext m
            rw [Polynomial.finsetSum_coeff]
            simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
            by_cases hm : m < d + 1
            · rw [Finset.sum_eq_single m]
              · simp
              · intro b₀ _ hbm; simp [Ne.symm hbm]
              · intro hnot; exact absurd (Finset.mem_range.mpr hm) hnot
            · rw [Finset.sum_eq_zero]
              · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
              · intro b₀ hb
                have hmb : m ≠ b₀ := by have := Finset.mem_range.mp hb; omega
                simp [hmb]
          conv_lhs => rw [hP_eq]
          rw [map_sum]
          rfl
        rw [hP] at hx ⊢
        apply Ideal.sum_mem
        intro j hj
        have hj_coeff : φ_res (P.coeff j) = 0 := by
          have hpoly : ψ_exc_w (∑ i ∈ Finset.range (d + 1), φ_w.hom (P.coeff i) * s_w ^ i) =
              ∑ i ∈ Finset.range (d + 1), Polynomial.C (φ_res (P.coeff i)) * Polynomial.X ^ i := by
            rw [map_sum]
            apply Finset.sum_congr rfl
            intro i _
            rw [map_mul, map_pow, hψ_r, hψ_s]
          rw [hpoly] at hx
          have hcj := congrArg (fun q => Polynomial.coeff q j) hx
          rw [Polynomial.coeff_zero, Polynomial.finsetSum_coeff] at hcj
          simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero] at hcj
          rw [Finset.sum_eq_single j] at hcj
          · simpa using hcj
          · intro b₀ _ hbj; simp [Ne.symm hbj]
          · intro hnot; exact absurd hj hnot
        have hmem_p0 : P.coeff j ∈ p₀.asIdeal := by
          rw [← hKer_res]; exact hj_coeff
        rw [hp_w, Ideal.mem_span_pair] at hmem_p0
        obtain ⟨a₀, b₀, hab⟩ := hmem_p0
        have hφ_coeff : φ_w.hom (P.coeff j) ∈ Ideal.span ({φ_w.hom w₁} : Set R_w) := by
          rw [Ideal.mem_span_singleton]
          refine ⟨φ_w.hom a₀ + φ_w.hom b₀ * s_w, ?_⟩
          calc φ_w.hom (P.coeff j)
              = φ_w.hom (a₀ * w₁ + b₀ * w₂) := by rw [← hab]
            _ = φ_w.hom a₀ * φ_w.hom w₁ + φ_w.hom b₀ * (φ_w.hom w₁ * s_w) := by
                  rw [map_add, map_mul, map_mul, hQuot_w.1]
            _ = φ_w.hom w₁ * (φ_w.hom a₀ + φ_w.hom b₀ * s_w) := by ring
        exact Ideal.mul_mem_right _ _ hφ_coeff
      · rw [Ideal.span_le]
        intro x hx
        rcases Set.mem_singleton_iff.mp hx with rfl
        change ψ_exc_w (φ_w.hom w₁) = 0
        rw [hψ_r]
        have hw1_p : w₁ ∈ RingHom.ker φ_res := by
          rw [hKer_res, hp_w]; exact Ideal.subset_span (by simp)
        rw [RingHom.mem_ker.mp hw1_p, map_zero]
    exact ⟨R_w, φ_w, s_w, ι_Lw, ψ_exc_w, hDom_w, hQuot_w, hFlat_w, hFP_w, hXw_ne, hw1_Rw_ne,
      hsw_ne, hinj_fLw, hcomp_Lw, hf_Lw_s, hClear_w, hLoc_Lw, hLoc_w₁,
      hSurj_ψw, hKer_ψw, hψ_s, hψ_r⟩
  obtain ⟨R₁, φ₁, s₁, ι_L1, ψ_exc1, hDom₁, hQuot₁, hFlat₁, hFP₁, hX1_ne, hz1_ne, hs1_ne,
      hinj_L1, hcomp_L1, hs1_L, hClear₁, hLoc_L1, hLoc_z₁, hSurj_ψ1, hKer_ψ1, hψ1_s, hψ1_r⟩ :=
    hBuildChart z₁ z₂ hp₀_span hz₁_ne hz₂_ne hreg₀ hLoc_L0 t₁ ht₁
  have hp₀_symm : p₀.asIdeal = Ideal.span ({z₂, z₁} : Set R₀) := by
    rw [hp₀_span, Set.pair_comm]
  have hLoc_L0_symm : @IsLocalization.Away R₀ _ (z₂ * z₁) L₀ _ ι_L0.hom.toAlgebra := by
    rw [mul_comm z₂ z₁]; exact hLoc_L0
  obtain ⟨R₂, φ₂, s₂, ι_L2, ψ_exc2, hDom₂, hQuot₂, hFlat₂, hFP₂, _, hz2_ne, hs2_ne,
      hinj_L2, hcomp_L2, hs2_L, hClear₂, hLoc_L2, hLoc_z₂, hSurj_ψ2, hKer_ψ2, hψ2_s, hψ2_r⟩ :=
    hBuildChart z₂ z₁ hp₀_symm hz₂_ne hz₁_ne hreg_symm hLoc_L0_symm t₂ ht₂
  have hz₂_pow_reg : ∀ (k : ℕ) (y : R₀),
      z₂ ^ k * y ∈ Ideal.span ({z₁} : Set R₀) → y ∈ Ideal.span ({z₁} : Set R₀) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      intro y hy
      apply ih
      apply hreg₀
      simpa [pow_succ', mul_assoc] using hy
  have hInter : ∀ (f : R₀), f ≠ 0 →
      ∀ (x₁ : R₁) (x₂ : R₂) (k₁ k₂ : ℕ),
        ι_L1.hom x₁ * (ι_L0.hom f) ^ k₂ = ι_L2.hom x₂ * (ι_L0.hom f) ^ k₁ →
        ∃ (a₀ : R₀) (m : ℕ),
          ι_L0.hom a₀ * (ι_L0.hom f) ^ k₁ = ι_L1.hom x₁ * (ι_L0.hom f) ^ m := by
    intro f hf x₁ x₂ k₁ k₂ hEq
    obtain ⟨d₁, A₁, hA₁⟩ := hClear₁ x₁
    obtain ⟨d₂, B₂, hB₂⟩ := hClear₂ x₂
    have hA₁_L : (ι_L0.hom z₁) ^ d₁ * ι_L1.hom x₁ = ι_L0.hom A₁ := by
      have hf10 : ∀ r : R₀, ι_L1.hom (φ₁.hom r) = ι_L0.hom r :=
        RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp_L1)
      rw [← hf10 z₁, ← map_pow, ← map_mul, hA₁, hf10]
    have hB₂_L : (ι_L0.hom z₂) ^ d₂ * ι_L2.hom x₂ = ι_L0.hom B₂ := by
      have hf20 : ∀ r : R₀, ι_L2.hom (φ₂.hom r) = ι_L0.hom r :=
        RingHom.congr_fun (congrArg CommRingCat.Hom.hom hcomp_L2)
      rw [← hf20 z₂, ← map_pow, ← map_mul, hB₂, hf20]
    let P_exp : ℕ → Prop := fun m_exp =>
      ∃ (a₀ : R₀) (m : ℕ),
        ι_L0.hom a₀ * (ι_L0.hom f) ^ k₁ = (ι_L0.hom z₁) ^ m_exp * ι_L1.hom x₁ * (ι_L0.hom f) ^ m
    have hex_P : ∃ m_exp, P_exp m_exp := ⟨d₁, A₁, k₁, by rw [hA₁_L]⟩
    let n₀ : ℕ := Nat.find hex_P
    have hn₀_spec : P_exp n₀ := Nat.find_spec hex_P
    have hn₀_zero : n₀ = 0 := by
      by_contra hne0
      obtain ⟨n', hn'⟩ := Nat.exists_eq_succ_of_ne_zero hne0
      rw [hn'] at hn₀_spec
      obtain ⟨a₀, m, ha₀⟩ := hn₀_spec
      have hfL_ne : ι_L0.hom f ≠ 0 := fun h => hf (hinj_L0 (h.trans (map_zero _).symm))
      have hmul_eq : ι_L0.hom (z₂ ^ d₂ * (a₀ * f ^ k₂)) * (ι_L0.hom f) ^ k₁ =
          ι_L0.hom (z₁ ^ (n' + 1) * B₂ * f ^ m) * (ι_L0.hom f) ^ k₁ := by
        calc ι_L0.hom (z₂ ^ d₂ * (a₀ * f ^ k₂)) * (ι_L0.hom f) ^ k₁
            = (ι_L0.hom z₂) ^ d₂ * (ι_L0.hom a₀ * (ι_L0.hom f) ^ k₁) * (ι_L0.hom f) ^ k₂ := by
                simp only [map_mul, map_pow]; ring
          _ = (ι_L0.hom z₂) ^ d₂ * ((ι_L0.hom z₁) ^ (n' + 1) * ι_L1.hom x₁ * (ι_L0.hom f) ^ m) *
                (ι_L0.hom f) ^ k₂ := by rw [ha₀]
          _ = (ι_L0.hom z₁) ^ (n' + 1) * (ι_L0.hom z₂) ^ d₂ *
                (ι_L1.hom x₁ * (ι_L0.hom f) ^ k₂) * (ι_L0.hom f) ^ m := by ring
          _ = (ι_L0.hom z₁) ^ (n' + 1) * ((ι_L0.hom z₂) ^ d₂ * ι_L2.hom x₂) *
                (ι_L0.hom f) ^ k₁ * (ι_L0.hom f) ^ m := by rw [hEq]; ring
          _ = ι_L0.hom (z₁ ^ (n' + 1) * B₂ * f ^ m) * (ι_L0.hom f) ^ k₁ := by
                rw [hB₂_L]; simp only [map_mul, map_pow]; ring
      have hR0_eq : z₂ ^ d₂ * (a₀ * f ^ k₂) = z₁ ^ (n' + 1) * B₂ * f ^ m :=
        hinj_L0 (mul_right_cancel₀ (pow_ne_zero k₁ hfL_ne) hmul_eq)
      have hmem_z1 : z₂ ^ d₂ * (a₀ * f ^ k₂) ∈ Ideal.span ({z₁} : Set R₀) := by
        rw [hR0_eq, pow_succ', Ideal.mem_span_singleton]
        exact ⟨z₁ ^ n' * B₂ * f ^ m, by ring⟩
      obtain ⟨a', ha'⟩ := Ideal.mem_span_singleton.mp (hz₂_pow_reg d₂ _ hmem_z1)
      have hPn' : P_exp n' := by
        refine ⟨a', m + k₂, ?_⟩
        have hz1L_ne : ι_L0.hom z₁ ≠ 0 := fun h => hz₁_ne (hinj_L0 (h.trans (map_zero _).symm))
        apply mul_left_cancel₀ hz1L_ne
        calc ι_L0.hom z₁ * (ι_L0.hom a' * (ι_L0.hom f) ^ k₁)
            = ι_L0.hom (z₁ * a') * (ι_L0.hom f) ^ k₁ := by rw [map_mul, mul_assoc]
          _ = (ι_L0.hom a₀ * (ι_L0.hom f) ^ k₁) * (ι_L0.hom f) ^ k₂ := by
                rw [← ha']; simp only [map_mul, map_pow]; ring
          _ = ((ι_L0.hom z₁) ^ (n' + 1) * ι_L1.hom x₁ * (ι_L0.hom f) ^ m) *
                (ι_L0.hom f) ^ k₂ := by rw [ha₀]
          _ = ι_L0.hom z₁ * ((ι_L0.hom z₁) ^ n' * ι_L1.hom x₁ * (ι_L0.hom f) ^ (m + k₂)) := by
                rw [pow_succ', pow_add]; ring
      exact Nat.find_min hex_P (by omega : n' < n₀) hPn'
    rw [hn₀_zero] at hn₀_spec
    obtain ⟨a₀, m, ha₀⟩ := hn₀_spec
    exact ⟨a₀, m, by simpa using ha₀⟩
  have hPrime_qexc : (Ideal.span ({φ₁.hom z₁} : Set R₁)).IsPrime := by
    rw [← hKer_ψ1]
    exact RingHom.ker_isPrime ψ_exc1
  let q_exc : AlgebraicGeometry.Spec R₁ := ⟨Ideal.span ({φ₁.hom z₁} : Set R₁), hPrime_qexc⟩
