        by_contra hne_top
        obtain ⟨𝔪, hMax_𝔪, hI_le⟩ := Ideal.exists_le_maximal I_cond hne_top
        obtain ⟨z, hz⟩ := (hBij_at_max 𝔪).2 ((1 : Localization.AtPrime 𝔪) ⊗ₜ[R₀] t)
        let q_loc : Localization.AtPrime 𝔪 := (TensorProduct.rid R₀ (Localization.AtPrime 𝔪)) z
