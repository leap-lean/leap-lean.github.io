        have h2 : (AlgebraicGeometry.Spec.map ιR_hom ≫ hU₀.fromSpec).app U₀ =
            hU₀.fromSpec.app U₀ ≫
              (AlgebraicGeometry.Spec.map ιR_hom).app (hU₀.fromSpec ⁻¹ᵁ U₀) :=
          AlgebraicGeometry.Scheme.Hom.comp_app (AlgebraicGeometry.Spec.map ιR_hom) hU₀.fromSpec U₀
