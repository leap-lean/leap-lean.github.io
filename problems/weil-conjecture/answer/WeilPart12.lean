      let ψ_br : ↑R_Pm →+* Polynomial Ω := Ideal.Quotient.lift J_m ψ_raw hJm_ker
      let ε₀ : ↑R_Pm →+* Ω := (Polynomial.evalRingHom 0).comp ψ_br
      have hInod_le : I_nod ≤ RingHom.ker ε₀ := by
        rw [Ideal.span_le]
        intro x hx
        rw [SetLike.mem_coe, RingHom.mem_ker]
        rcases hx with rfl | rfl | rfl
        · change Polynomial.eval 0 (ψ_raw (MvPolynomial.X 0)) = 0
          simp [ψ_raw]
        · change Polynomial.eval 0 (ψ_raw (MvPolynomial.X 1)) = 0
          simp [ψ_raw]
        · change Polynomial.eval 0 (ψ_raw (MvPolynomial.C PowerSeries.X)) = 0
          simp [ψ_raw]
      have hPrime_ε₀ : (RingHom.ker ε₀).IsPrime := RingHom.ker_isPrime ε₀
      have hInod_eq : I_nod = RingHom.ker ε₀ :=
        hMax_Inod'.eq_of_le hPrime_ε₀.ne_top hInod_le
      let q_br : Ideal ↑R_Pm := RingHom.ker ψ_br
      have hq_le : q_br ≤ I_nod := by
