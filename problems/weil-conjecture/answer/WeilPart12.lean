theorem weil_powerSeries_etale_plane_critical_retraction (Ω : Type u) [Field Ω]
    (B : Type u) [CommRing B]
    (φ_P : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B)
    (Q : PrimeSpectrum B)
    (F : B)
    (hφEt : φ_P.Etale)
    (hQcomap : Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = IsLocalRing.maximalIdeal (PowerSeries Ω))
    (hRes : ∀ b : B, ∃ c : PowerSeries Ω, b - φ_P (MvPolynomial.C c) ∈ Q.asIdeal)
    (hXi : ∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal)
    (hF : F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
      Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal (PowerSeries Ω)) ⊔
        Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3) :
    F ∈ Q.asIdeal ∧
    ∃ (s : B) (u₀ v₀ h : PowerSeries Ω) (A₂₀ A₁₁ A₀₂ : Localization.Away s),
      s ∉ Q.asIdeal ∧
      u₀ ∈ IsLocalRing.maximalIdeal (PowerSeries Ω) ∧
      v₀ ∈ IsLocalRing.maximalIdeal (PowerSeries Ω) ∧
      h ∈ IsLocalRing.maximalIdeal (PowerSeries Ω) ∧
      let φ_s := (algebraMap B (Localization.Away s)).comp φ_P
      let Q_s := Ideal.map (algebraMap B (Localization.Away s)) Q.asIdeal
      A₂₀ ∈ Q_s ∧
      A₀₂ ∈ Q_s ∧
      A₁₁ - 1 ∈ Q_s ∧
      algebraMap B (Localization.Away s) F + φ_s (MvPolynomial.C h) =
        A₂₀ * φ_s (MvPolynomial.X 0 - MvPolynomial.C u₀) ^ 2 +
        A₁₁ * φ_s (MvPolynomial.X 0 - MvPolynomial.C u₀) *
          φ_s (MvPolynomial.X 1 - MvPolynomial.C v₀) +
        A₀₂ * φ_s (MvPolynomial.X 1 - MvPolynomial.C v₀) ^ 2 :=
by
  
  obtain ⟨D₀, D₁, h_add₀, h_mul₀, h_pderiv₀, h_add₁, h_mul₁, h_pderiv₁, h_taylor,
      hFQ, hF₁, hF₂, hDet1⟩ :
      ∃ (D₀ D₁ : B → B),
        (∀ x y : B, D₀ (x + y) = D₀ x + D₀ y) ∧
        (∀ x y : B, D₀ (x * y) = x * D₀ y + D₀ x * y) ∧
        (∀ p : MvPolynomial (Fin 2) (PowerSeries Ω),
          D₀ (φ_P p) = φ_P (MvPolynomial.pderiv 0 p)) ∧
        (∀ x y : B, D₁ (x + y) = D₁ x + D₁ y) ∧
        (∀ x y : B, D₁ (x * y) = x * D₁ y + D₁ x * y) ∧
        (∀ p : MvPolynomial (Fin 2) (PowerSeries Ω),
          D₁ (φ_P p) = φ_P (MvPolynomial.pderiv 1 p)) ∧
        (∀ (S : Type u) [CommRing S] (K : Ideal S),
          K ^ 2 = ⊥ →
          ∀ (g₁ g₂ : B →+* S),
            g₁.comp (φ_P.comp MvPolynomial.C) = g₂.comp (φ_P.comp MvPolynomial.C) →
            (∀ b : B, g₂ b - g₁ b ∈ K) →
            ∀ b : B,
              g₂ b - g₁ b =
                g₁ (D₀ b) * (g₂ (φ_P (MvPolynomial.X 0)) - g₁ (φ_P (MvPolynomial.X 0))) +
                g₁ (D₁ b) * (g₂ (φ_P (MvPolynomial.X 1)) - g₁ (φ_P (MvPolynomial.X 1)))) ∧
        F ∈ Q.asIdeal ∧
        D₀ F ∈ Q.asIdeal ∧
        D₁ F ∈ Q.asIdeal ∧
        D₀ (D₀ F) * D₁ (D₁ F) - D₁ (D₀ F) * D₀ (D₁ F) + 1 ∈ Q.asIdeal := by
    let R := PowerSeries Ω
    let P₂ := MvPolynomial (Fin 2) R
    let instAlgPB : Algebra P₂ B := φ_P.toAlgebra
    let instAlgRB : Algebra R B := (φ_P.comp MvPolynomial.C).toAlgebra
    have instTowerRPB : IsScalarTower R P₂ B := IsScalarTower.of_algebraMap_eq' rfl
    have instEtPB : Algebra.Etale P₂ B := hφEt
    let e_K : TensorProduct P₂ B Ω[P₂⁄R] ≃ₗ[B] Ω[B⁄R] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R P₂ B
    let b_P := KaehlerDifferential.mvPolynomialBasis R (Fin 2)
    let mkDer : Fin 2 → Derivation R B B := fun i =>
      let ω_i : Ω[P₂⁄R] →ₗ[P₂] P₂ := (Finsupp.lapply i).comp b_P.repr.toLinearMap
      let ω_B : TensorProduct P₂ B Ω[P₂⁄R] →ₗ[B] B :=
        LinearMap.liftBaseChange B ((Algebra.linearMap P₂ B).comp ω_i)
      let proj_i : Ω[B⁄R] →ₗ[B] B := ω_B.comp e_K.symm.toLinearMap
      proj_i.compDer (KaehlerDifferential.D R B)
    let der₀ : Derivation R B B := mkDer 0
    let der₁ : Derivation R B B := mkDer 1
    have h_mkDer_pderiv : ∀ (i : Fin 2) (p : P₂), mkDer i (φ_P p) = φ_P (MvPolynomial.pderiv i p) := by
      intro i p
      change LinearMap.liftBaseChange B ((Algebra.linearMap P₂ B).comp
        ((Finsupp.lapply i).comp b_P.repr.toLinearMap))
          (e_K.symm (KaehlerDifferential.D R B (algebraMap P₂ B p))) = φ_P (MvPolynomial.pderiv i p)
      rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap R P₂ B p,
        LinearMap.liftBaseChange_tmul, one_smul]
      change algebraMap P₂ B ((b_P.repr (KaehlerDifferential.D R P₂ p)) i) = φ_P (MvPolynomial.pderiv i p)
      rw [KaehlerDifferential.mvPolynomialBasis_repr_apply]
      rfl
    have h_mul : ∀ (d : Derivation R B B) (x y : B), d (x * y) = x * d y + d x * y := by
      intro d x y
      have h := d.leibniz x y
      simp only [smul_eq_mul] at h
      rw [h]
      ring
    let u : B := φ_P (MvPolynomial.X 0)
    let v : B := φ_P (MvPolynomial.X 1)
    have h_der0_u : der₀ u = 1 := by
      change mkDer 0 (φ_P (MvPolynomial.X 0)) = 1
      rw [h_mkDer_pderiv, MvPolynomial.pderiv_X]
      simp
    have h_der0_v : der₀ v = 0 := by
      change mkDer 0 (φ_P (MvPolynomial.X 1)) = 0
      rw [h_mkDer_pderiv, MvPolynomial.pderiv_X]
      simp
    have h_der1_u : der₁ u = 0 := by
      change mkDer 1 (φ_P (MvPolynomial.X 0)) = 0
      rw [h_mkDer_pderiv, MvPolynomial.pderiv_X]
      simp
    have h_der1_v : der₁ v = 1 := by
      change mkDer 1 (φ_P (MvPolynomial.X 1)) = 1
      rw [h_mkDer_pderiv, MvPolynomial.pderiv_X]
      simp
    have h_tay_fn : ∀ (S : Type u) [CommRing S] (K : Ideal S),
        K ^ 2 = ⊥ →
        ∀ (g₁ g₂ : B →+* S),
          g₁.comp (φ_P.comp MvPolynomial.C) = g₂.comp (φ_P.comp MvPolynomial.C) →
          (∀ b : B, g₂ b - g₁ b ∈ K) →
          ∀ b : B,
            g₂ b - g₁ b =
              g₁ (der₀ b) * (g₂ u - g₁ u) + g₁ (der₁ b) * (g₂ v - g₁ v) := by
      intro S _ K hK g₁ g₂ hgC hdiff b
      let instAlgBS : Algebra B S := g₁.toAlgebra
      let instAlgPS : Algebra P₂ S := (g₁.comp φ_P).toAlgebra
      let instAlgRS : Algebra R S := (g₁.comp (φ_P.comp MvPolynomial.C)).toAlgebra
      have instTowerRPS : IsScalarTower R P₂ S := IsScalarTower.of_algebraMap_eq' rfl
      have instTowerPBS : IsScalarTower P₂ B S := IsScalarTower.of_algebraMap_eq' rfl
      have instTowerRBS : IsScalarTower R B S := IsScalarTower.of_algebraMap_eq' rfl
      let g₂_alg : B →ₐ[R] S :=
        { g₂ with
          commutes' := fun r => RingHom.congr_fun hgC.symm r }
      have h_mod : (Ideal.Quotient.mkₐ R K).comp g₂_alg = IsScalarTower.toAlgHom R B (S ⧸ K) := by
        ext x
        change Ideal.Quotient.mk K (g₂ x) = Ideal.Quotient.mk K (g₁ x)
        exact Ideal.Quotient.eq.mpr (hdiff x)
      let δ : Derivation R B S :=
        (K.subtype.restrictScalars B).compDer (derivationToSquareZeroOfLift K hK g₂_alg h_mod)
      have hδ_apply : ∀ x : B, δ x = g₂ x - g₁ x := by
        intro x
        exact derivationToSquareZeroOfLift_apply K hK g₂_alg h_mod x
      let mulRightLin : S → (B →ₗ[B] S) := fun s₀ =>
        { toFun := fun x => g₁ x * s₀
          map_add' := fun x y => by rw [map_add, add_mul]
          map_smul' := fun c x => by
            simp only [RingHom.id_apply]
            change g₁ (c * x) * s₀ = g₁ c * (g₁ x * s₀)
            rw [map_mul, mul_assoc] }
      let Δ_der : Derivation R B S :=
        δ - (mulRightLin (δ u)).compDer der₀ - (mulRightLin (δ v)).compDer der₁
      have hΔ_apply : ∀ x : B, Δ_der x = δ x - g₁ (der₀ x) * δ u - g₁ (der₁ x) * δ v := fun _ => rfl
      have hΔ_u : Δ_der u = 0 := by
        rw [hΔ_apply, h_der0_u, h_der1_u, map_one, map_zero, one_mul, zero_mul, sub_zero, sub_self]
      have hΔ_v : Δ_der v = 0 := by
        rw [hΔ_apply, h_der0_v, h_der1_v, map_zero, map_one, zero_mul, one_mul, sub_zero, sub_self]
      have hΔ_P₂ : Δ_der.compAlgebraMap P₂ = 0 := by
        apply MvPolynomial.derivation_ext
        intro i
        fin_cases i
        · exact hΔ_u
        · exact hΔ_v
      let Δ_P₂_der : Derivation P₂ B S :=
        { toLinearMap :=
            { toFun := ⇑Δ_der
              map_add' := Δ_der.map_add
              map_smul' := fun p x => by
                simp only [RingHom.id_apply]
                change Δ_der (φ_P p * x) = g₁ (φ_P p) * Δ_der x
                have hp0 : Δ_der (φ_P p) = 0 := DFunLike.congr_fun hΔ_P₂ p
                have hleib := Δ_der.leibniz (φ_P p) x
                change Δ_der (φ_P p * x) = g₁ (φ_P p) * Δ_der x + g₁ x * Δ_der (φ_P p) at hleib
                rw [hp0, mul_zero, add_zero] at hleib
                exact hleib }
          map_one_eq_zero' := Δ_der.map_one_eq_zero
          leibniz' := Δ_der.leibniz }
      have instSubK : Subsingleton Ω[B⁄P₂] :=
        Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
      have hΔ_zero : Δ_P₂_der = 0 := by
        apply (KaehlerDifferential.linearMapEquivDerivation P₂ B).symm.injective
        exact Subsingleton.elim _ _
      have hb0 : Δ_der b = 0 := DFunLike.congr_fun hΔ_zero b
      rw [hΔ_apply, hδ_apply b, hδ_apply u, hδ_apply v] at hb0
      linear_combination hb0
    let J := Q.asIdeal
    let I_C : Ideal B := Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal R)
    let I_uv : Ideal B := Ideal.span {u, v}
    have hIC_le : I_C ≤ J := Ideal.map_le_iff_le_comap.mpr (le_of_eq hQcomap.symm)
    have huJ : u ∈ J := hXi 0
    have hvJ : v ∈ J := hXi 1
    have hIuv_le : I_uv ≤ J := by
      rw [Ideal.span_le]
      intro x hx
      rcases hx with rfl | rfl
      · exact huJ
      · exact hvJ
    have hDer_IC : ∀ (i : Fin 2) {x : B}, x ∈ I_C → mkDer i x ∈ I_C := by
      intro i x hx
      have hboth : x ∈ I_C ∧ mkDer i x ∈ I_C := by
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
        · rintro _ ⟨r, hr, rfl⟩
          refine ⟨Ideal.mem_map_of_mem _ hr, ?_⟩
          change mkDer i (φ_P (MvPolynomial.C r)) ∈ I_C
          rw [h_mkDer_pderiv, MvPolynomial.pderiv_C, map_zero]
          exact I_C.zero_mem
        · exact ⟨I_C.zero_mem, by rw [map_zero]; exact I_C.zero_mem⟩
        · intro x₁ x₂ _ _ hx₁ hx₂
          exact ⟨I_C.add_mem hx₁.1 hx₂.1, by rw [map_add]; exact I_C.add_mem hx₁.2 hx₂.2⟩
        · intro b₀ x₁ _ hx₁
          refine ⟨I_C.mul_mem_left b₀ hx₁.1, ?_⟩
          change mkDer i (b₀ * x₁) ∈ I_C
          rw [h_mul]
          exact I_C.add_mem (I_C.mul_mem_left b₀ hx₁.2) (I_C.mul_mem_left (mkDer i b₀) hx₁.1)
      exact hboth.2
    have hDer_Iuv2 : ∀ (i : Fin 2) {x : B}, x ∈ I_uv ^ 2 → mkDer i x ∈ I_uv := by
      intro i x hx
      rw [sq] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro a ha c hc
        rw [h_mul]
        exact I_uv.add_mem (I_uv.mul_mem_right (mkDer i c) ha) (I_uv.mul_mem_left (mkDer i a) hc)
      · intro x₁ x₂ hx₁ hx₂
        rw [map_add]
        exact I_uv.add_mem hx₁ hx₂
    have hDer_Iuv3 : ∀ (i : Fin 2) {x : B}, x ∈ I_uv ^ 3 → mkDer i x ∈ I_uv ^ 2 := by
      intro i x hx
      rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro a ha c hc
        rw [h_mul]
        refine (I_uv ^ 2).add_mem ((I_uv ^ 2).mul_mem_right (mkDer i c) ha) ?_
        rw [sq]
        exact Submodule.mul_mem_mul (hDer_Iuv2 i ha) hc
      · intro x₁ x₂ hx₁ hx₂
        rw [map_add]
        exact (I_uv ^ 2).add_mem hx₁ hx₂
    let E : B := F - u * v
    have hE_mem : E ∈ I_C ⊔ I_uv ^ 3 := by
      have huv : φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) = u * v := map_mul φ_P _ _
      rwa [huv] at hF
    obtain ⟨y, hy, w, hw, hyw⟩ := Submodule.mem_sup.mp hE_mem
    have hIuv2_le : I_uv ^ 2 ≤ J := le_trans (Ideal.pow_le_self (by norm_num)) hIuv_le
    have hIuv3_le : I_uv ^ 3 ≤ J := le_trans (Ideal.pow_le_self (by norm_num)) hIuv_le
    have hEJ : E ∈ J := by
      rw [← hyw]
      exact J.add_mem (hIC_le hy) (hIuv3_le hw)
    have hDerE : ∀ i : Fin 2, mkDer i E ∈ J := by
      intro i
      rw [← hyw, map_add]
      exact J.add_mem (hIC_le (hDer_IC i hy)) (hIuv2_le (hDer_Iuv3 i hw))
    have hDer2E : ∀ i j : Fin 2, mkDer j (mkDer i E) ∈ J := by
      intro i j
      rw [← hyw, map_add, map_add]
      exact J.add_mem (hIC_le (hDer_IC j (hDer_IC i hy)))
        (hIuv_le (hDer_Iuv2 j (hDer_Iuv3 i hw)))
    have hF_eq : F = u * v + E := by
      dsimp only [E]
      ring
    have hFJ : F ∈ J := by
      rw [hF_eq]
      exact J.add_mem (J.mul_mem_right v huJ) hEJ
    have hD0_F_eq : der₀ F = v + der₀ E := by
      rw [hF_eq, map_add, h_mul der₀, h_der0_u, h_der0_v]
      ring
    have hD1_F_eq : der₁ F = u + der₁ E := by
      rw [hF_eq, map_add, h_mul der₁, h_der1_u, h_der1_v]
      ring
    have hD0FJ : der₀ F ∈ J := by
      rw [hD0_F_eq]
      exact J.add_mem hvJ (hDerE 0)
    have hD1FJ : der₁ F ∈ J := by
      rw [hD1_F_eq]
      exact J.add_mem huJ (hDerE 1)
    have h00 : der₀ (der₀ F) ∈ J := by
      have heq : der₀ (der₀ F) = der₀ (der₀ E) := by
        rw [hD0_F_eq, map_add, h_der0_v, zero_add]
      rw [heq]
      exact hDer2E 0 0
    have h11 : der₁ (der₁ F) ∈ J := by
      have heq : der₁ (der₁ F) = der₁ (der₁ E) := by
        rw [hD1_F_eq, map_add, h_der1_u, zero_add]
      rw [heq]
      exact hDer2E 1 1
    have h10 : der₁ (der₀ F) - 1 ∈ J := by
      have heq : der₁ (der₀ F) - 1 = der₁ (der₀ E) := by
        rw [hD0_F_eq, map_add, h_der1_v]
        ring
      rw [heq]
      exact hDer2E 0 1
    have h01 : der₀ (der₁ F) - 1 ∈ J := by
      have heq : der₀ (der₁ F) - 1 = der₀ (der₁ E) := by
        rw [hD1_F_eq, map_add, h_der0_u]
        ring
      rw [heq]
      exact hDer2E 1 0
    have hDet_mem : der₀ (der₀ F) * der₁ (der₁ F) - der₁ (der₀ F) * der₀ (der₁ F) + 1 ∈ J := by
      let b₁ : B := der₁ (der₀ F) - 1
      let c₁ : B := der₀ (der₁ F) - 1
      have h_alg : der₀ (der₀ F) * der₁ (der₁ F) - der₁ (der₀ F) * der₀ (der₁ F) + 1 =
          der₀ (der₀ F) * der₁ (der₁ F) - b₁ - c₁ - b₁ * c₁ := by
        dsimp only [b₁, c₁]
        ring
      rw [h_alg]
      exact J.sub_mem (J.sub_mem (J.sub_mem (J.mul_mem_right _ h00) h10) h01)
        (J.mul_mem_right _ h10)
    exact ⟨⇑der₀, ⇑der₁, der₀.map_add, h_mul der₀, h_mkDer_pderiv 0,
      der₁.map_add, h_mul der₁, h_mkDer_pderiv 1, h_tay_fn, hFJ, hD0FJ, hD1FJ, hDet_mem⟩
  have hDet : D₀ (D₀ F) * D₁ (D₁ F) - D₁ (D₀ F) * D₀ (D₁ F) ∉ Q.asIdeal := by
    intro hmem
    have h1 : (1 : B) ∈ Q.asIdeal := by
      have heq : (1 : B) =
          (D₀ (D₀ F) * D₁ (D₁ F) - D₁ (D₀ F) * D₀ (D₁ F) + 1) -
            (D₀ (D₀ F) * D₁ (D₁ F) - D₁ (D₀ F) * D₀ (D₁ F)) := by ring
      rw [heq]
      exact Q.asIdeal.sub_mem hDet1 hmem
    exact Q.isPrime.ne_top ((Ideal.eq_top_iff_one Q.asIdeal).mpr h1)

  
  obtain ⟨π_crit, hπC, hπQ, hπF₀, hπF₁⟩ :
      ∃ (π_crit : B →+* PowerSeries Ω),
        π_crit.comp (φ_P.comp MvPolynomial.C) = RingHom.id (PowerSeries Ω) ∧
        Q.asIdeal = Ideal.comap π_crit (IsLocalRing.maximalIdeal (PowerSeries Ω)) ∧
        π_crit (D₀ F) = 0 ∧
        π_crit (D₁ F) = 0 := by
    let F₁ : B := D₀ F
    let F₂ : B := D₁ F
    have hI_anti : ∀ {k₁ k₂ : ℕ}, k₁ ≤ k₂ →
        Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ k₂} ≤
          Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ k₁} := by
      intro k₁ k₂ hle
      rw [Ideal.span_singleton_le_span_singleton]
      exact pow_dvd_pow _ hle
    have hMax_eq_I1 : IsLocalRing.maximalIdeal (PowerSeries Ω) =
        Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ 1} := by
      rw [PowerSeries.maximalIdeal_eq_span_X, pow_one]
    obtain ⟨τ₀, hτ₀_C, hτ₀_ker⟩ :
        ∃ τ₀ : B →+* (PowerSeries Ω ⧸ Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ 1}),
          τ₀.comp (φ_P.comp MvPolynomial.C) =
            Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ 1}) ∧
          (∀ b : B, τ₀ b = 0 ↔ b ∈ Q.asIdeal) := by
      let ι_bar : PowerSeries Ω →+* (B ⧸ Q.asIdeal) :=
        (Ideal.Quotient.mk Q.asIdeal).comp (φ_P.comp MvPolynomial.C)
      have h_surj_bar : Function.Surjective ι_bar := by
        intro x
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨c, hc⟩ := hRes b
        refine ⟨c, ?_⟩
        symm
        exact Ideal.Quotient.eq.mpr hc
      have h_ker_bar : RingHom.ker ι_bar = Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ 1} := by
        ext c
        change Ideal.Quotient.mk Q.asIdeal (φ_P (MvPolynomial.C c)) = 0 ↔ _
        rw [Ideal.Quotient.eq_zero_iff_mem, ← hMax_eq_I1, ← hQcomap]
        rfl
      let e₁ := (Ideal.quotEquivOfEq h_ker_bar.symm).trans
        (RingHom.quotientKerEquivOfSurjective h_surj_bar)
      refine ⟨e₁.symm.toRingHom.comp (Ideal.Quotient.mk Q.asIdeal), ?_, ?_⟩
      · apply RingHom.ext
        intro c
        apply e₁.injective
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
          e₁.apply_symm_apply]
        rfl
      · intro b
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
          map_eq_zero_iff e₁.symm e₁.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hτ₀_Δ : τ₀ (D₀ F₁ * D₁ F₂ - D₁ F₁ * D₀ F₂) ≠ 0 :=
      fun h0 => hDet ((hτ₀_ker _).mp h0)
    have hIndStep : ∀ (m : ℕ)
        (τ : B →+* (PowerSeries Ω ⧸ Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)})),
        τ.comp (φ_P.comp MvPolynomial.C) =
          Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}) →
        (Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ (Nat.zero_le m)))).comp τ = τ₀ →
        τ F₁ = 0 →
        τ F₂ = 0 →
        ∃ τ' : B →+* (PowerSeries Ω ⧸ Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 2)}),
          (Ideal.Quotient.factor (hI_anti (Nat.le_succ (m + 1)))).comp τ' = τ ∧
          τ'.comp (φ_P.comp MvPolynomial.C) =
            Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 2)}) ∧
          (Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ (Nat.zero_le (m + 1))))).comp τ' = τ₀ ∧
          τ' F₁ = 0 ∧
          τ' F₂ = 0 := by
      intro m τ hτ_C hτ_p hτ_F₁ hτ_F₂
      let Im1 := Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}
      let Im2 := Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 2)}
      let q_m : (PowerSeries Ω ⧸ Im2) →+* (PowerSeries Ω ⧸ Im1) :=
        Ideal.Quotient.factor (hI_anti (Nat.le_succ (m + 1)))
      let K_m : Ideal (PowerSeries Ω ⧸ Im2) := RingHom.ker q_m
      have hKm_sq : K_m ^ 2 = ⊥ := by
        rw [sq, eq_bot_iff]
        refine Submodule.mul_le.mpr ?_
        intro x hx y hy
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        have ha : a ∈ Im1 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.factor_mk (hI_anti (Nat.le_succ (m + 1))) a]
          exact hx
        have hb : b ∈ Im1 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.factor_mk (hI_anti (Nat.le_succ (m + 1))) b]
          exact hy
        rw [Ideal.mem_span_singleton] at ha hb
        obtain ⟨a', rfl⟩ := ha
        obtain ⟨b', rfl⟩ := hb
        rw [Submodule.mem_bot, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
        refine ⟨(PowerSeries.X : PowerSeries Ω) ^ m * a' * b', ?_⟩
        ring
      obtain ⟨u_tilde, hu_tilde⟩ := Ideal.Quotient.mk_surjective (τ (φ_P (MvPolynomial.X 0)))
      obtain ⟨v_tilde, hv_tilde⟩ := Ideal.Quotient.mk_surjective (τ (φ_P (MvPolynomial.X 1)))
      have hParamLift : ∀ δ₀ δ₁ : PowerSeries Ω,
          ∃ τ' : B →+* (PowerSeries Ω ⧸ Im2),
            q_m.comp τ' = τ ∧
            τ'.comp (φ_P.comp MvPolynomial.C) = Ideal.Quotient.mk Im2 ∧
            τ' (φ_P (MvPolynomial.X 0)) =
              Ideal.Quotient.mk Im2 (u_tilde + δ₀ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) ∧
            τ' (φ_P (MvPolynomial.X 1)) =
              Ideal.Quotient.mk Im2 (v_tilde + δ₁ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) := by
        intro δ₀ δ₁
        obtain ⟨α_δ, hα_C, hα_X0, hα_X1⟩ :
            ∃ α_δ : MvPolynomial (Fin 2) (PowerSeries Ω) →+* (PowerSeries Ω ⧸ Im2),
              (∀ r, α_δ (MvPolynomial.C r) = Ideal.Quotient.mk Im2 r) ∧
              α_δ (MvPolynomial.X 0) =
                Ideal.Quotient.mk Im2 (u_tilde + δ₀ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) ∧
              α_δ (MvPolynomial.X 1) =
                Ideal.Quotient.mk Im2 (v_tilde + δ₁ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) := by
          refine ⟨MvPolynomial.eval₂Hom (Ideal.Quotient.mk Im2)
            ![Ideal.Quotient.mk Im2 (u_tilde + δ₀ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)),
              Ideal.Quotient.mk Im2 (v_tilde + δ₁ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1))],
            fun r => MvPolynomial.eval₂Hom_C _ _ r,
            by rw [MvPolynomial.eval₂Hom_X']; rfl,
            by rw [MvPolynomial.eval₂Hom_X']; rfl⟩
        have hq_α : q_m.comp α_δ = τ.comp φ_P := by
          apply MvPolynomial.ringHom_ext
          · intro r
            simp only [RingHom.comp_apply, hα_C]
            rw [Ideal.Quotient.factor_mk]
            exact (RingHom.congr_fun hτ_C r).symm
          · intro i
            have hX_zero : ∀ δ : PowerSeries Ω,
                Ideal.Quotient.mk Im1 (δ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) = 0 := by
              intro δ
              rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
              exact ⟨δ, mul_comm _ _⟩
            fin_cases i
            · change q_m (α_δ (MvPolynomial.X 0)) = τ (φ_P (MvPolynomial.X 0))
              rw [hα_X0, Ideal.Quotient.factor_mk, map_add, hu_tilde, hX_zero, add_zero]
            · change q_m (α_δ (MvPolynomial.X 1)) = τ (φ_P (MvPolynomial.X 1))
              rw [hα_X1, Ideal.Quotient.factor_mk, map_add, hv_tilde, hX_zero, add_zero]
        let instAlgB : Algebra (MvPolynomial (Fin 2) (PowerSeries Ω)) B := φ_P.toAlgebra
        have instEtB : @Algebra.Etale (MvPolynomial (Fin 2) (PowerSeries Ω)) B _ _ instAlgB := hφEt
        let instAlg2 : Algebra (MvPolynomial (Fin 2) (PowerSeries Ω)) (PowerSeries Ω ⧸ Im2) :=
          α_δ.toAlgebra
        let instAlg1 : Algebra (MvPolynomial (Fin 2) (PowerSeries Ω)) (PowerSeries Ω ⧸ Im1) :=
          (τ.comp φ_P).toAlgebra
        let f_alg : B →ₐ[MvPolynomial (Fin 2) (PowerSeries Ω)] (PowerSeries Ω ⧸ Im1) :=
          { τ with commutes' := fun _ => rfl }
        let g_alg : (PowerSeries Ω ⧸ Im2) →ₐ[MvPolynomial (Fin 2) (PowerSeries Ω)] (PowerSeries Ω ⧸ Im1) :=
          { q_m with commutes' := fun p => RingHom.congr_fun hq_α p }
        have hg_surj : Function.Surjective ⇑g_alg :=
          Ideal.Quotient.factor_surjective (hI_anti (Nat.le_succ (m + 1)))
        have hg_nilp : IsNilpotent (RingHom.ker (g_alg : (PowerSeries Ω ⧸ Im2) →+* (PowerSeries Ω ⧸ Im1))) :=
          ⟨2, hKm_sq⟩
        obtain ⟨L, hL_app⟩ :
            ∃ L : B →ₐ[MvPolynomial (Fin 2) (PowerSeries Ω)] (PowerSeries Ω ⧸ Im2),
              ∀ b : B, q_m (L b) = τ b :=
          ⟨Algebra.FormallySmooth.liftOfSurjective f_alg g_alg hg_surj hg_nilp,
            Algebra.FormallySmooth.liftOfSurjective_apply f_alg g_alg hg_surj hg_nilp⟩
        have hL_P₂ : ∀ p, L.toRingHom (φ_P p) = α_δ p := L.commutes
        refine ⟨L.toRingHom, RingHom.ext hL_app, ?_, ?_, ?_⟩
        · apply RingHom.ext
          intro r
          change L.toRingHom (φ_P (MvPolynomial.C r)) = Ideal.Quotient.mk Im2 r
          rw [hL_P₂, hα_C]
        · rw [hL_P₂, hα_X0]
        · rw [hL_P₂, hα_X1]
      obtain ⟨τ_zero, hτ0_q, hτ0_C, hτ0_u, hτ0_v⟩ := hParamLift 0 0
      have hτ0_q_app : ∀ b : B, q_m (τ_zero b) = τ b := RingHom.congr_fun hτ0_q
      have h_lift_rem : ∀ f_b : B, τ f_b = 0 →
          ∃ r : PowerSeries Ω,
            τ_zero f_b = Ideal.Quotient.mk Im2 (r * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) := by
        intro f_b hf_b
        obtain ⟨f_hat, hf_hat⟩ := Ideal.Quotient.mk_surjective (τ_zero f_b)
        have hf_in : f_hat ∈ Im1 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.factor_mk (hI_anti (Nat.le_succ (m + 1))) f_hat]
          change q_m (Ideal.Quotient.mk Im2 f_hat) = 0
          rw [hf_hat, hτ0_q_app, hf_b]
        rw [Ideal.mem_span_singleton] at hf_in
        obtain ⟨r, hr⟩ := hf_in
        exact ⟨r, by rw [← hf_hat, hr, mul_comm]⟩
      obtain ⟨r₁, hr₁⟩ := h_lift_rem F₁ hτ_F₁
      obtain ⟨r₂, hr₂⟩ := h_lift_rem F₂ hτ_F₂
      obtain ⟨m₁₀, hm₁₀⟩ := Ideal.Quotient.mk_surjective (τ_zero (D₀ F₁))
      obtain ⟨m₁₁, hm₁₁⟩ := Ideal.Quotient.mk_surjective (τ_zero (D₁ F₁))
      obtain ⟨m₂₀, hm₂₀⟩ := Ideal.Quotient.mk_surjective (τ_zero (D₀ F₂))
      obtain ⟨m₂₁, hm₂₁⟩ := Ideal.Quotient.mk_surjective (τ_zero (D₁ F₂))
      let d_M : PowerSeries Ω := m₁₀ * m₂₁ - m₁₁ * m₂₀
      have hd_M_eq : τ_zero (D₀ F₁ * D₁ F₂ - D₁ F₁ * D₀ F₂) = Ideal.Quotient.mk Im2 d_M := by
        rw [map_sub, map_mul, map_mul, ← hm₁₀, ← hm₂₁, ← hm₁₁, ← hm₂₀]
        simp only [d_M, map_sub, map_mul]
      have hd_M_notMem : d_M ∉ IsLocalRing.maximalIdeal (PowerSeries Ω) := by
        rw [hMax_eq_I1, ← Ideal.Quotient.eq_zero_iff_mem]
        intro hd0
        apply hτ₀_Δ
        have hp_app := RingHom.congr_fun hτ_p (D₀ F₁ * D₁ F₂ - D₁ F₁ * D₀ F₂)
        simp only [RingHom.comp_apply] at hp_app
        rw [← hp_app, ← hτ0_q_app, hd_M_eq, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk]
        exact hd0
      obtain ⟨u_M, hu_M⟩ := (IsLocalRing.notMem_maximalIdeal.mp hd_M_notMem).exists_right_inv
      let δ₀ : PowerSeries Ω := -u_M * (m₂₁ * r₁ - m₁₁ * r₂)
      let δ₁ : PowerSeries Ω := -u_M * (-m₂₀ * r₁ + m₁₀ * r₂)
      obtain ⟨τ_next, hτn_q, hτn_C, hτn_u, hτn_v⟩ := hParamLift δ₀ δ₁
      have hτn_q_app : ∀ b : B, q_m (τ_next b) = τ b := RingHom.congr_fun hτn_q
      have h_diff_Km : ∀ b : B, τ_next b - τ_zero b ∈ K_m := by
        intro b
        change q_m (τ_next b - τ_zero b) = 0
        rw [map_sub, hτn_q_app b, hτ0_q_app b, sub_self]
      have h_tay := h_taylor (PowerSeries Ω ⧸ Im2) K_m hKm_sq τ_zero τ_next
        (hτ0_C.trans hτn_C.symm) h_diff_Km
      have h_du : τ_next (φ_P (MvPolynomial.X 0)) - τ_zero (φ_P (MvPolynomial.X 0)) =
          Ideal.Quotient.mk Im2 (δ₀ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) := by
        rw [hτn_u, hτ0_u, zero_mul, add_zero, ← map_sub]
        congr 1
        ring
      have h_dv : τ_next (φ_P (MvPolynomial.X 1)) - τ_zero (φ_P (MvPolynomial.X 1)) =
          Ideal.Quotient.mk Im2 (δ₁ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) := by
        rw [hτn_v, hτ0_v, zero_mul, add_zero, ← map_sub]
        congr 1
        ring
      have hτn_F₁ : τ_next F₁ = 0 := by
        have ht1 := h_tay F₁
        rw [hr₁, ← hm₁₀, ← hm₁₁, h_du, h_dv, ← map_mul, ← map_mul, ← map_add, sub_eq_iff_eq_add] at ht1
        rw [ht1, ← map_add]
        have h_cancel₁ : (m₁₀ * (δ₀ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) +
            m₁₁ * (δ₁ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1))) +
            r₁ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1) =
            (r₁ - (d_M * u_M) * r₁) * (PowerSeries.X : PowerSeries Ω) ^ (m + 1) := by
          dsimp only [δ₀, δ₁, d_M]
          ring
        rw [h_cancel₁, hu_M, one_mul, sub_self, zero_mul, map_zero]
      have hτn_F₂ : τ_next F₂ = 0 := by
        have ht2 := h_tay F₂
        rw [hr₂, ← hm₂₀, ← hm₂₁, h_du, h_dv, ← map_mul, ← map_mul, ← map_add, sub_eq_iff_eq_add] at ht2
        rw [ht2, ← map_add]
        have h_cancel₂ : (m₂₀ * (δ₀ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1)) +
            m₂₁ * (δ₁ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1))) +
            r₂ * (PowerSeries.X : PowerSeries Ω) ^ (m + 1) =
            (r₂ - (d_M * u_M) * r₂) * (PowerSeries.X : PowerSeries Ω) ^ (m + 1) := by
          dsimp only [δ₀, δ₁, d_M]
          ring
        rw [h_cancel₂, hu_M, one_mul, sub_self, zero_mul, map_zero]
      have hτn_p : (Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ (Nat.zero_le (m + 1))))).comp τ_next = τ₀ := by
        apply RingHom.ext
        intro b
        simp only [RingHom.comp_apply]
        obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (τ_next b)
        have h1 : Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ (Nat.zero_le (m + 1)))) (τ_next b) =
            Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ (Nat.zero_le m))) (q_m (τ_next b)) := by
          rw [← hc, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk]
        rw [h1, hτn_q_app b]
        exact RingHom.congr_fun hτ_p b
      exact ⟨τ_next, hτn_q, hτn_C, hτn_p, hτn_F₁, hτn_F₂⟩
    obtain ⟨τ_seq, hτ_zero_eq, hτ_step, hτ_C_seq, hτ_F₁_seq, hτ_F₂_seq⟩ :
        ∃ τ_seq : ∀ m : ℕ, B →+* (PowerSeries Ω ⧸ Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}),
          τ_seq 0 = τ₀ ∧
          (∀ m : ℕ, (Ideal.Quotient.factor (hI_anti (Nat.le_succ (m + 1)))).comp (τ_seq (m + 1)) = τ_seq m) ∧
          (∀ m : ℕ, (τ_seq m).comp (φ_P.comp MvPolynomial.C) =
            Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)})) ∧
          (∀ m : ℕ, τ_seq m F₁ = 0) ∧
          (∀ m : ℕ, τ_seq m F₂ = 0) := by
      let StepData (m : ℕ) : Type u :=
        {τ : B →+* (PowerSeries Ω ⧸ Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}) //
          τ.comp (φ_P.comp MvPolynomial.C) =
            Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}) ∧
          (Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ (Nat.zero_le m)))).comp τ = τ₀ ∧
          τ F₁ = 0 ∧
          τ F₂ = 0}
      have hp0_τ₀ : (Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ (Nat.zero_le 0)))).comp τ₀ = τ₀ := by
        apply RingHom.ext
        intro b
        obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (τ₀ b)
        rw [RingHom.comp_apply, ← hc, Ideal.Quotient.factor_mk]
      let baseStep : StepData 0 :=
        ⟨τ₀, hτ₀_C, hp0_τ₀, (hτ₀_ker F₁).mpr hF₁, (hτ₀_ker F₂).mpr hF₂⟩
      have hStepPacked : ∀ (m : ℕ) (st : StepData m),
          ∃ st' : StepData (m + 1),
            (Ideal.Quotient.factor (hI_anti (Nat.le_succ (m + 1)))).comp st'.1 = st.1 := by
        intro m ⟨τ, h1, h2, h3, h4⟩
        obtain ⟨τ', hq, hc, hp, hf1, hf2⟩ := hIndStep m τ h1 h2 h3 h4
        exact ⟨⟨τ', hc, hp, hf1, hf2⟩, hq⟩
      choose nextStep hNextStep using hStepPacked
      let tower : ∀ m : ℕ, StepData m := fun m => Nat.rec baseStep (fun k st => nextStep k st) m
      exact ⟨fun m => (tower m).1, rfl, fun m => hNextStep m (tower m),
        fun m => (tower m).2.1, fun m => (tower m).2.2.2.1, fun m => (tower m).2.2.2.2⟩
    have hTower_le : ∀ {d m : ℕ} (h : d ≤ m) (b : B),
        Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ h)) (τ_seq m b) = τ_seq d b := by
      intro d m h b
      induction m with
      | zero =>
        have hd0 : d = 0 := Nat.le_zero.mp h
        subst hd0
        obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (τ_seq 0 b)
        rw [← hc, Ideal.Quotient.factor_mk]
      | succ m ih =>
        rcases Nat.of_le_succ h with hle | rfl
        · obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (τ_seq (m + 1) b)
          have hfac : Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ h)) (τ_seq (m + 1) b) =
              Ideal.Quotient.factor (hI_anti (Nat.succ_le_succ hle))
                (Ideal.Quotient.factor (hI_anti (Nat.le_succ (m + 1))) (τ_seq (m + 1) b)) := by
            rw [← hc, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk]
          have hst : Ideal.Quotient.factor (hI_anti (Nat.le_succ (m + 1))) (τ_seq (m + 1) b) =
              τ_seq m b := RingHom.congr_fun (hτ_step m) b
          rw [hfac, hst, ih hle]
        · obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (τ_seq (m + 1) b)
          rw [← hc, Ideal.Quotient.factor_mk]
    choose s_lift hs_lift using fun (m : ℕ) (b : B) => Ideal.Quotient.mk_surjective (τ_seq m b)
    obtain ⟨π_fun, hπ_coeff⟩ :
        ∃ π_fun : B → PowerSeries Ω,
          ∀ (b : B) (d : ℕ), (PowerSeries.coeff d) (π_fun b) = (PowerSeries.coeff d) (s_lift d b) :=
      ⟨fun b => PowerSeries.mk (fun d => (PowerSeries.coeff d) (s_lift d b)),
        fun b d => PowerSeries.coeff_mk d _⟩
    have hπ_mod : ∀ (m : ℕ) (b : B),
        Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}) (π_fun b) =
          τ_seq m b := by
      intro m b
      rw [← hs_lift m b, Ideal.Quotient.eq, Ideal.mem_span_singleton, PowerSeries.X_pow_dvd_iff]
      intro d hd
      have hd_le : d ≤ m := Nat.lt_succ_iff.mp hd
      have h_eq_mod : Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (d + 1)}) (s_lift m b) =
          Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (d + 1)}) (s_lift d b) := by
        rw [← Ideal.Quotient.factor_mk (hI_anti (Nat.succ_le_succ hd_le)) (s_lift m b),
          hs_lift m b, hTower_le hd_le b, ← hs_lift d b]
      have hdvd : (PowerSeries.X : PowerSeries Ω) ^ (d + 1) ∣ (s_lift m b - s_lift d b) := by
        rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq]
        exact h_eq_mod
      have hcoeff_sub : (PowerSeries.coeff d) (s_lift m b - s_lift d b) = 0 :=
        (PowerSeries.X_pow_dvd_iff.mp hdvd) d (Nat.lt_succ_self d)
      rw [map_sub, hπ_coeff b d]
      rw [map_sub, sub_eq_zero] at hcoeff_sub
      exact sub_eq_zero.mpr hcoeff_sub.symm
    have hRStar_ext : ∀ {f g : PowerSeries Ω},
        (∀ m : ℕ,
          Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}) f =
            Ideal.Quotient.mk (Ideal.span {(PowerSeries.X : PowerSeries Ω) ^ (m + 1)}) g) →
        f = g := by
      intro f g hfg
      ext d
      have hdvd : (PowerSeries.X : PowerSeries Ω) ^ (d + 1) ∣ (f - g) := by
        rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq]
        exact hfg d
      have h0 := (PowerSeries.X_pow_dvd_iff.mp hdvd) d (Nat.lt_succ_self d)
      rwa [map_sub, sub_eq_zero] at h0
    let π_crit : B →+* PowerSeries Ω :=
      { toFun := π_fun
        map_one' := hRStar_ext fun m => by rw [hπ_mod, map_one, map_one]
        map_mul' := fun x y => hRStar_ext fun m => by rw [hπ_mod, map_mul, map_mul, hπ_mod, hπ_mod]
        map_zero' := hRStar_ext fun m => by rw [hπ_mod, map_zero, map_zero]
        map_add' := fun x y => hRStar_ext fun m => by rw [hπ_mod, map_add, map_add, hπ_mod, hπ_mod] }
    refine ⟨π_crit, ?_, ?_, ?_, ?_⟩
    · apply RingHom.ext
      intro c
      exact hRStar_ext fun m => by
        change Ideal.Quotient.mk _ (π_fun ((φ_P.comp MvPolynomial.C) c)) = Ideal.Quotient.mk _ c
        rw [hπ_mod]
        exact RingHom.congr_fun (hτ_C_seq m) c
    · ext b
      change b ∈ Q.asIdeal ↔ π_fun b ∈ IsLocalRing.maximalIdeal (PowerSeries Ω)
      rw [hMax_eq_I1]
      refine (hτ₀_ker b).symm.trans ?_
      rw [← hτ_zero_eq, ← hπ_mod 0 b]
      exact Ideal.Quotient.eq_zero_iff_mem
    · exact hRStar_ext fun m => by
        change Ideal.Quotient.mk _ (π_fun F₁) = Ideal.Quotient.mk _ 0
        rw [hπ_mod, hτ_F₁_seq m, map_zero]
    · exact hRStar_ext fun m => by
        change Ideal.Quotient.mk _ (π_fun F₂) = Ideal.Quotient.mk _ 0
        rw [hπ_mod, hτ_F₂_seq m, map_zero]

  let u₀ : PowerSeries Ω := π_crit (φ_P (MvPolynomial.X 0))
  let v₀ : PowerSeries Ω := π_crit (φ_P (MvPolynomial.X 1))
  let h : PowerSeries Ω := -π_crit F
  have hu₀ : u₀ ∈ IsLocalRing.maximalIdeal (PowerSeries Ω) := by
    have hx := hXi 0
    rwa [hπQ] at hx
  have hv₀ : v₀ ∈ IsLocalRing.maximalIdeal (PowerSeries Ω) := by
    have hx := hXi 1
    rwa [hπQ] at hx
  have hh : h ∈ IsLocalRing.maximalIdeal (PowerSeries Ω) := by
    have hF_m := hFQ
    rw [hπQ] at hF_m
    exact (IsLocalRing.maximalIdeal (PowerSeries Ω)).neg_mem hF_m

  
  obtain ⟨s, c₀₀, c_mid, c₁₁, hs1, hQuadB⟩ :
      ∃ (s c₀₀ c_mid c₁₁ : B),
        s - 1 ∈ Q.asIdeal ∧
        s ^ 2 * (F + φ_P (MvPolynomial.C h)) =
          c₀₀ * φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀) ^ 2 +
          c_mid * φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀) *
            φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀) +
          c₁₁ * φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀) ^ 2 := by
    let R := PowerSeries Ω
    let P₂ := MvPolynomial (Fin 2) R
    let ι_C : R →+* B := φ_P.comp MvPolynomial.C
    have hπ_ιC : ∀ r : R, π_crit (ι_C r) = r := fun r => RingHom.congr_fun hπC r
    let U_tilde : B := φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀)
    let V_tilde : B := φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀)
    let K : Ideal B := RingHom.ker π_crit
    let J₀ : Ideal B := Ideal.span {U_tilde, V_tilde}
    have hKQ : K ≤ Q.asIdeal := by
      intro b hb
      rw [hπQ]
      change π_crit b ∈ IsLocalRing.maximalIdeal R
      have hb0 : π_crit b = 0 := hb
      rw [hb0]
      exact (IsLocalRing.maximalIdeal R).zero_mem
    have hK_le : K ≤ J₀ ⊔ K ^ 2 := by
      let D₂ := B ⧸ (J₀ ⊔ K ^ 2)
      let q_J : B →+* D₂ := Ideal.Quotient.mk (J₀ ⊔ K ^ 2)
      let g₂_ring : B →+* D₂ := q_J.comp (ι_C.comp π_crit)
      have hg_P₂ : g₂_ring.comp φ_P = q_J.comp φ_P := by
        apply MvPolynomial.ringHom_ext
        · intro r
          change q_J (ι_C (π_crit (ι_C r))) = q_J (ι_C r)
          rw [hπ_ιC]
        · intro i
          fin_cases i
          · change q_J (ι_C u₀) = q_J (φ_P (MvPolynomial.X 0))
            symm
            rw [Ideal.Quotient.eq]
            have hmem : φ_P (MvPolynomial.X 0) - ι_C u₀ ∈ J₀ := by
              have heq : φ_P (MvPolynomial.X 0) - ι_C u₀ = U_tilde := by
                dsimp only [U_tilde, ι_C, RingHom.comp_apply]
                rw [map_sub]
              rw [heq]
              exact Ideal.subset_span (by simp)
            exact Ideal.mem_sup_left hmem
          · change q_J (ι_C v₀) = q_J (φ_P (MvPolynomial.X 1))
            symm
            rw [Ideal.Quotient.eq]
            have hmem : φ_P (MvPolynomial.X 1) - ι_C v₀ ∈ J₀ := by
              have heq : φ_P (MvPolynomial.X 1) - ι_C v₀ = V_tilde := by
                dsimp only [V_tilde, ι_C, RingHom.comp_apply]
                rw [map_sub]
              rw [heq]
              exact Ideal.subset_span (by simp)
            exact Ideal.mem_sup_left hmem
      have h_eq_fn : q_J = g₂_ring := by
        let instAlgB : Algebra P₂ B := φ_P.toAlgebra
        have instEtB : @Algebra.Etale P₂ B _ _ instAlgB := hφEt
        let instAlgD : Algebra P₂ D₂ := (q_J.comp φ_P).toAlgebra
        let g₁_alg : B →ₐ[P₂] D₂ := { q_J with commutes' := fun _ => rfl }
        let g₂_alg : B →ₐ[P₂] D₂ := { g₂_ring with commutes' := fun p => RingHom.congr_fun hg_P₂ p }
        let K_bar : Ideal D₂ := Ideal.map q_J K
        have hKbar_sq : K_bar ^ 2 = ⊥ := by
          rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
          exact le_sup_right
        have hKbar_nilp : IsNilpotent K_bar := ⟨2, hKbar_sq⟩
        have h_mod : ∀ b : B, Ideal.Quotient.mk K_bar (g₁_alg b) = Ideal.Quotient.mk K_bar (g₂_alg b) := by
          intro b
          rw [Ideal.Quotient.eq]
          change q_J b - q_J (ι_C (π_crit b)) ∈ K_bar
          rw [← map_sub]
          refine Ideal.mem_map_of_mem q_J ?_
          change π_crit (b - ι_C (π_crit b)) = 0
          rw [map_sub, hπ_ιC, sub_self]
        have h_alg_eq : g₁_alg = g₂_alg := Algebra.FormallyUnramified.ext K_bar hKbar_nilp h_mod
        ext b
        exact AlgHom.congr_fun h_alg_eq b
      intro b hb
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change q_J b = 0
      rw [h_eq_fn]
      change q_J (ι_C (π_crit b)) = 0
      have hb0 : π_crit b = 0 := hb
      rw [hb0, map_zero, map_zero]
    have instNoethB : IsNoetherianRing B := by
      let instAlgB : Algebra P₂ B := φ_P.toAlgebra
      have instEtB : @Algebra.Etale P₂ B _ _ instAlgB := hφEt
      have instFP : @Algebra.FinitePresentation P₂ B _ _ instAlgB := inferInstance
      have instFT : @Algebra.FiniteType P₂ B _ _ instAlgB := Algebra.FiniteType.of_finitePresentation
      exact Algebra.FiniteType.isNoetherianRing P₂ B
    have hK_fg : K.FG := IsNoetherian.noetherian K
    have hK_le_smul : K ≤ J₀ ⊔ Q.asIdeal • K := by
      refine le_trans hK_le (sup_le_sup_left ?_ J₀)
      rw [sq, ← Ideal.smul_eq_mul]
      exact Submodule.smul_mono_left hKQ
    obtain ⟨s, hs1, hsK⟩ :=
      Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hK_fg (le_refl K) hK_le_smul
    have hsK_mem : ∀ x ∈ K, s * x ∈ J₀ := fun x hx =>
      hsK (Submodule.smul_mem_pointwise_smul x s K hx)
    let G : B := F + φ_P (MvPolynomial.C h)
    have hG_K : G ∈ K := by
      change π_crit (F + ι_C (-π_crit F)) = 0
      rw [map_add, hπ_ιC, add_neg_cancel]
    obtain ⟨β₀, β₁, hβ⟩ := Ideal.mem_span_pair.mp (hsK_mem G hG_K)
    have hπ_U : π_crit U_tilde = 0 := by
      dsimp only [U_tilde]
      rw [map_sub, map_sub]
      change u₀ - π_crit (ι_C u₀) = 0
      rw [hπ_ιC u₀, sub_self]
    have hπ_V : π_crit V_tilde = 0 := by
      dsimp only [V_tilde]
      rw [map_sub, map_sub]
      change v₀ - π_crit (ι_C v₀) = 0
      rw [hπ_ιC v₀, sub_self]
    have hD0_U : D₀ U_tilde = 1 := by
      dsimp only [U_tilde]
      rw [h_pderiv₀, map_sub, MvPolynomial.pderiv_X, MvPolynomial.pderiv_C]
      simp
    have hD0_V : D₀ V_tilde = 0 := by
      dsimp only [V_tilde]
      rw [h_pderiv₀, map_sub, MvPolynomial.pderiv_X, MvPolynomial.pderiv_C]
      simp
    have hD1_U : D₁ U_tilde = 0 := by
      dsimp only [U_tilde]
      rw [h_pderiv₁, map_sub, MvPolynomial.pderiv_X, MvPolynomial.pderiv_C]
      simp
    have hD1_V : D₁ V_tilde = 1 := by
      dsimp only [V_tilde]
      rw [h_pderiv₁, map_sub, MvPolynomial.pderiv_X, MvPolynomial.pderiv_C]
      simp
    have hD0_G : D₀ G = D₀ F := by
      dsimp only [G]
      rw [h_add₀, h_pderiv₀, MvPolynomial.pderiv_C, map_zero, add_zero]
    have hD1_G : D₁ G = D₁ F := by
      dsimp only [G]
      rw [h_add₁, h_pderiv₁, MvPolynomial.pderiv_C, map_zero, add_zero]
    have hβ₀_K : β₀ ∈ K := by
      have hd0 := congrArg D₀ hβ
      rw [h_add₀, h_mul₀, h_mul₀, h_mul₀, hD0_U, hD0_V, hD0_G] at hd0
      have hπ0 := congrArg π_crit hd0
      have hG0 : π_crit G = 0 := hG_K
      simp only [map_add, map_mul, map_zero, hπ_U, hπ_V, hπF₀, hG0,
        mul_one, mul_zero, add_zero] at hπ0
      exact hπ0
    have hβ₁_K : β₁ ∈ K := by
      have hd1 := congrArg D₁ hβ
      rw [h_add₁, h_mul₁, h_mul₁, h_mul₁, hD1_U, hD1_V, hD1_G] at hd1
      have hπ1 := congrArg π_crit hd1
      have hG0 : π_crit G = 0 := hG_K
      simp only [map_add, map_mul, hπ_U, hπ_V, hπF₁, hG0,
        mul_one, mul_zero, add_zero, zero_add] at hπ1
      exact hπ1
    obtain ⟨c₀₀, c₀₁, hc₀⟩ := Ideal.mem_span_pair.mp (hsK_mem β₀ hβ₀_K)
    obtain ⟨c₁₀, c₁₁, hc₁⟩ := Ideal.mem_span_pair.mp (hsK_mem β₁ hβ₁_K)
    refine ⟨s, c₀₀, c₀₁ + c₁₀, c₁₁, hs1, ?_⟩
    change s ^ 2 * G = c₀₀ * U_tilde ^ 2 + (c₀₁ + c₁₀) * U_tilde * V_tilde + c₁₁ * V_tilde ^ 2
    calc s ^ 2 * G
        = s * (s * G) := by ring
      _ = s * (β₀ * U_tilde + β₁ * V_tilde) := by rw [← hβ]
      _ = (s * β₀) * U_tilde + (s * β₁) * V_tilde := by ring
      _ = (c₀₀ * U_tilde + c₀₁ * V_tilde) * U_tilde + (c₁₀ * U_tilde + c₁₁ * V_tilde) * V_tilde := by
            rw [← hc₀, ← hc₁]
      _ = c₀₀ * U_tilde ^ 2 + (c₀₁ + c₁₀) * U_tilde * V_tilde + c₁₁ * V_tilde ^ 2 := by ring

  have hsQ : s ∉ Q.asIdeal := by
    intro hs_mem
    have h1 : (1 : B) ∈ Q.asIdeal := by
      have heq : (1 : B) = s - (s - 1) := by ring
      rw [heq]
      exact Q.asIdeal.sub_mem hs_mem hs1
    exact Q.isPrime.ne_top ((Ideal.eq_top_iff_one Q.asIdeal).mpr h1)

  
  have ⟨hc₀₀_Q, hc₁₁_Q, hcmid_Q⟩ :
      c₀₀ ∈ Q.asIdeal ∧ c₁₁ ∈ Q.asIdeal ∧ c_mid - s ^ 2 ∈ Q.asIdeal := by
    let RStar := PowerSeries Ω
    let P₂ := MvPolynomial (Fin 2) RStar
    let cCoeff : RStar →+* Ω := PowerSeries.constantCoeff
    let res_Q : B →+* Ω := cCoeff.comp π_crit
    have hRes_ker : ∀ b : B, res_Q b = 0 ↔ b ∈ Q.asIdeal := by
      intro b
      change cCoeff (π_crit b) = 0 ↔ b ∈ Q.asIdeal
      rw [← RingHom.mem_ker, PowerSeries.ker_coeff_eq_max_ideal, hπQ]
      rfl
    have hResC : res_Q.comp (φ_P.comp MvPolynomial.C) = cCoeff := by
      dsimp only [res_Q]
      rw [RingHom.comp_assoc, hπC, RingHom.comp_id]
    have hResXi : ∀ i : Fin 2, res_Q (φ_P (MvPolynomial.X i)) = 0 :=
      fun i => (hRes_ker _).mpr (hXi i)
    let I_t3 : Ideal (Polynomial Ω) := Ideal.span {(Polynomial.X : Polynomial Ω) ^ 3}
    let T₃ := Polynomial Ω ⧸ I_t3
    let mk₃ : Polynomial Ω →+* T₃ := Ideal.Quotient.mk I_t3
    let t_bar : T₃ := mk₃ Polynomial.X
    let ι_Ω : Ω →+* T₃ := mk₃.comp Polynomial.C
    have h_eval_ker : ∀ p ∈ I_t3, (Polynomial.evalRingHom (0 : Ω)) p = 0 := by
      intro p hp
      rw [Ideal.mem_span_singleton] at hp
      obtain ⟨q, rfl⟩ := hp
      simp
    let aug : T₃ →+* Ω := Ideal.Quotient.lift I_t3 (Polynomial.evalRingHom (0 : Ω)) h_eval_ker
    have haug_ι : ∀ α : Ω, aug (ι_Ω α) = α := by
      intro α
      change Polynomial.eval 0 (Polynomial.C α) = α
      simp
    have haug_surj : Function.Surjective aug := fun α => ⟨ι_Ω α, haug_ι α⟩
    have haug_t : aug t_bar = 0 := by
      change Polynomial.eval 0 (Polynomial.X : Polynomial Ω) = 0
      simp
    let N₃ : Ideal T₃ := RingHom.ker aug
    have ht_N3 : t_bar ∈ N₃ := haug_t
    have hN3_dvd : ∀ z ∈ N₃, ∃ q : Polynomial Ω, z = mk₃ (Polynomial.X * q) := by
      intro z hz
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hp0 : p.coeff 0 = 0 := by
        rw [Polynomial.coeff_zero_eq_eval_zero]
        exact hz
      obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hp0
      exact ⟨q, congrArg mk₃ hq⟩
    have hN3_mul3 : ∀ z₁ ∈ N₃, ∀ z₂ ∈ N₃, ∀ z₃ ∈ N₃, z₁ * z₂ * z₃ = 0 := by
      intro z₁ hz₁ z₂ hz₂ z₃ hz₃
      obtain ⟨q₁, rfl⟩ := hN3_dvd z₁ hz₁
      obtain ⟨q₂, rfl⟩ := hN3_dvd z₂ hz₂
      obtain ⟨q₃, rfl⟩ := hN3_dvd z₃ hz₃
      rw [← map_mul, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
      refine ⟨q₁ * q₂ * q₃, ?_⟩
      ring
    have hN3_cube : N₃ ^ 3 = ⊥ := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ, sq, eq_bot_iff]
      refine Submodule.mul_le.mpr ?_
      intro xy hxy z₃ hz₃
      refine Submodule.mul_induction_on hxy ?_ ?_
      · intro z₁ hz₁ z₂ hz₂
        rw [Submodule.mem_bot]
        exact hN3_mul3 z₁ hz₁ z₂ hz₂ z₃ hz₃
      · intro a b ha hb
        rw [Submodule.mem_bot] at ha hb ⊢
        rw [add_mul, ha, hb, add_zero]
    have h_t2_inj : ∀ α β : Ω, ι_Ω α * t_bar ^ 2 = ι_Ω β * t_bar ^ 2 → α = β := by
      intro α β h_eq
      have h_mk : mk₃ (Polynomial.C (α - β) * Polynomial.X ^ 2) = 0 := by
        calc mk₃ (Polynomial.C (α - β) * Polynomial.X ^ 2)
            = (mk₃ (Polynomial.C α) - mk₃ (Polynomial.C β)) * mk₃ Polynomial.X ^ 2 := by
                rw [Polynomial.C_sub, map_mul, map_sub, map_pow]
          _ = ι_Ω α * t_bar ^ 2 - ι_Ω β * t_bar ^ 2 := by
                change (ι_Ω α - ι_Ω β) * t_bar ^ 2 = ι_Ω α * t_bar ^ 2 - ι_Ω β * t_bar ^ 2
                ring
          _ = 0 := sub_eq_zero.mpr h_eq
      have hdvd : (Polynomial.X : Polynomial Ω) ^ 3 ∣ Polynomial.C (α - β) * Polynomial.X ^ 2 :=
        Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h_mk)
      have hcoeff := (Polynomial.X_pow_dvd_iff.mp hdvd) 2 (by norm_num)
      simp only [Polynomial.coeff_C_mul_X_pow, ↓reduceIte] at hcoeff
      exact sub_eq_zero.mp hcoeff
    have h_const_zero : ∀ r : RStar, r ∈ IsLocalRing.maximalIdeal RStar → cCoeff r = 0 := by
      intro r hr
      rw [← PowerSeries.ker_coeff_eq_max_ideal] at hr
      exact hr
    have h_jet : ∀ c₀ c₁ : Ω,
        res_Q (s ^ 2) * c₀ * c₁ =
          res_Q c₀₀ * c₀ ^ 2 + res_Q c_mid * c₀ * c₁ + res_Q c₁₁ * c₁ ^ 2 := by
      intro c₀ c₁
      let α_c : P₂ →+* T₃ :=
        MvPolynomial.eval₂Hom (ι_Ω.comp cCoeff) ![ι_Ω c₀ * t_bar, ι_Ω c₁ * t_bar]
      have haug_α : aug.comp α_c = res_Q.comp φ_P := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [RingHom.comp_apply, α_c, MvPolynomial.eval₂Hom_C, haug_ι]
          exact (RingHom.congr_fun hResC r).symm
        · intro i
          fin_cases i
          · change aug (α_c (MvPolynomial.X 0)) = res_Q (φ_P (MvPolynomial.X 0))
            have hx0 : α_c (MvPolynomial.X 0) = ι_Ω c₀ * t_bar := by
              dsimp only [α_c]
              rw [MvPolynomial.eval₂Hom_X']
              rfl
            rw [hx0, map_mul, haug_t, mul_zero]
            exact (hResXi 0).symm
          · change aug (α_c (MvPolynomial.X 1)) = res_Q (φ_P (MvPolynomial.X 1))
            have hx1 : α_c (MvPolynomial.X 1) = ι_Ω c₁ * t_bar := by
              dsimp only [α_c]
              rw [MvPolynomial.eval₂Hom_X']
              rfl
            rw [hx1, map_mul, haug_t, mul_zero]
            exact (hResXi 1).symm
      have hψ_exists : ∃ ψ : B →+* T₃, aug.comp ψ = res_Q ∧ ψ.comp φ_P = α_c := by
        let instAlgB : Algebra P₂ B := φ_P.toAlgebra
        have instEtB : @Algebra.Etale P₂ B _ _ instAlgB := hφEt
        let instAlgT : Algebra P₂ T₃ := α_c.toAlgebra
        let instAlgO : Algebra P₂ Ω := (res_Q.comp φ_P).toAlgebra
        let f_alg : B →ₐ[P₂] Ω := { res_Q with commutes' := fun _ => rfl }
        let g_alg : T₃ →ₐ[P₂] Ω := { aug with commutes' := fun p => RingHom.congr_fun haug_α p }
        have hg_nilp : IsNilpotent (RingHom.ker (g_alg : T₃ →+* Ω)) := ⟨3, hN3_cube⟩
        let L : B →ₐ[P₂] T₃ := Algebra.FormallySmooth.liftOfSurjective f_alg g_alg haug_surj hg_nilp
        refine ⟨L.toRingHom, ?_, ?_⟩
        · apply RingHom.ext
          intro b
          exact Algebra.FormallySmooth.liftOfSurjective_apply f_alg g_alg haug_surj hg_nilp b
        · apply RingHom.ext
          intro p
          exact L.commutes p
      obtain ⟨ψ, hψ_aug, hψ_P₂⟩ := hψ_exists
      have hψ_aug_app : ∀ b : B, aug (ψ b) = res_Q b := RingHom.congr_fun hψ_aug
      have hψ_C : ∀ r : RStar, ψ (φ_P (MvPolynomial.C r)) = ι_Ω (cCoeff r) := by
        intro r
        calc ψ (φ_P (MvPolynomial.C r))
            = α_c (MvPolynomial.C r) := RingHom.congr_fun hψ_P₂ (MvPolynomial.C r)
          _ = ι_Ω (cCoeff r) := MvPolynomial.eval₂Hom_C _ _ r
      have hψ_X0 : ψ (φ_P (MvPolynomial.X 0)) = ι_Ω c₀ * t_bar := by
        calc ψ (φ_P (MvPolynomial.X 0))
            = α_c (MvPolynomial.X 0) := RingHom.congr_fun hψ_P₂ (MvPolynomial.X 0)
          _ = ι_Ω c₀ * t_bar := by
                dsimp only [α_c]
                rw [MvPolynomial.eval₂Hom_X']
                rfl
      have hψ_X1 : ψ (φ_P (MvPolynomial.X 1)) = ι_Ω c₁ * t_bar := by
        calc ψ (φ_P (MvPolynomial.X 1))
            = α_c (MvPolynomial.X 1) := RingHom.congr_fun hψ_P₂ (MvPolynomial.X 1)
          _ = ι_Ω c₁ * t_bar := by
                dsimp only [α_c]
                rw [MvPolynomial.eval₂Hom_X']
                rfl
      have hψ_t2 : ∀ b : B, ψ b * t_bar ^ 2 = ι_Ω (res_Q b) * t_bar ^ 2 := by
        intro b
        have hdiff_N3 : ψ b - ι_Ω (res_Q b) ∈ N₃ := by
          change aug (ψ b - ι_Ω (res_Q b)) = 0
          rw [map_sub, hψ_aug_app b, haug_ι, sub_self]
        have h0 := hN3_mul3 (ψ b - ι_Ω (res_Q b)) hdiff_N3 t_bar ht_N3 t_bar ht_N3
        linear_combination h0
      have hψ_U : ψ (φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀)) = ι_Ω c₀ * t_bar := by
        rw [map_sub, map_sub, hψ_X0, hψ_C, h_const_zero u₀ hu₀, map_zero, sub_zero]
      have hψ_V : ψ (φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀)) = ι_Ω c₁ * t_bar := by
        rw [map_sub, map_sub, hψ_X1, hψ_C, h_const_zero v₀ hv₀, map_zero, sub_zero]
      have hψ_h : ψ (φ_P (MvPolynomial.C h)) = 0 := by
        rw [hψ_C, h_const_zero h hh, map_zero]
      have hψ_F : ψ F = ι_Ω (c₀ * c₁) * t_bar ^ 2 := by
        obtain ⟨y, hy, w, hw, hyw⟩ := Submodule.mem_sup.mp hF
        have hψ_y : ψ y = 0 := by
          have h_ic : Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal RStar) ≤
              RingHom.ker ψ := by
            rw [Ideal.map_le_iff_le_comap]
            intro r hr
            change ψ (φ_P (MvPolynomial.C r)) = 0
            rw [hψ_C, h_const_zero r hr, map_zero]
          exact h_ic hy
        have hψ_w : ψ w = 0 := by
          let I_uv : Ideal B := Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)}
          have hIuv_N3 : I_uv ≤ Ideal.comap ψ N₃ := by
            rw [Ideal.span_le]
            intro x hx
            rcases hx with rfl | rfl
            · change aug (ψ (φ_P (MvPolynomial.X 0))) = 0
              rw [hψ_X0, map_mul, haug_t, mul_zero]
            · change aug (ψ (φ_P (MvPolynomial.X 1))) = 0
              rw [hψ_X1, map_mul, haug_t, mul_zero]
          have h_map3 : Ideal.map ψ (I_uv ^ 3) ≤ N₃ ^ 3 := by
            rw [Ideal.map_pow]
            exact pow_le_pow_left' (Ideal.map_le_iff_le_comap.mpr hIuv_N3) 3
          have hw_bot : ψ w ∈ (⊥ : Ideal T₃) := by
            rw [← hN3_cube]
            exact h_map3 (Ideal.mem_map_of_mem ψ hw)
          rwa [Ideal.mem_bot] at hw_bot
        have hψ_diff : ψ (F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1)) = 0 := by
          rw [← hyw, map_add, hψ_y, hψ_w, add_zero]
        rw [map_sub, sub_eq_zero] at hψ_diff
        rw [hψ_diff, map_mul, map_mul, hψ_X0, hψ_X1]
        calc (ι_Ω c₀ * t_bar) * (ι_Ω c₁ * t_bar)
            = (ι_Ω c₀ * ι_Ω c₁) * t_bar ^ 2 := by ring
          _ = ι_Ω (c₀ * c₁) * t_bar ^ 2 := by rw [← map_mul]
      have hψ_quad := congrArg ψ hQuadB
      simp only [map_mul, map_add, map_pow] at hψ_quad
      rw [hψ_F, hψ_h, add_zero, hψ_U, hψ_V] at hψ_quad
      have h_lhs : ψ s ^ 2 * (ι_Ω (c₀ * c₁) * t_bar ^ 2) =
          ι_Ω (res_Q (s ^ 2) * c₀ * c₁) * t_bar ^ 2 := by
        calc ψ s ^ 2 * (ι_Ω (c₀ * c₁) * t_bar ^ 2)
            = ι_Ω (c₀ * c₁) * (ψ (s ^ 2) * t_bar ^ 2) := by rw [map_pow]; ring
          _ = ι_Ω (c₀ * c₁) * (ι_Ω (res_Q (s ^ 2)) * t_bar ^ 2) := by rw [hψ_t2]
          _ = (ι_Ω (res_Q (s ^ 2)) * ι_Ω (c₀ * c₁)) * t_bar ^ 2 := by ring
          _ = ι_Ω (res_Q (s ^ 2) * c₀ * c₁) * t_bar ^ 2 := by rw [← map_mul, mul_assoc]
      have h_rhs : ψ c₀₀ * (ι_Ω c₀ * t_bar) ^ 2 +
          ψ c_mid * (ι_Ω c₀ * t_bar) * (ι_Ω c₁ * t_bar) +
          ψ c₁₁ * (ι_Ω c₁ * t_bar) ^ 2 =
          ι_Ω (res_Q c₀₀ * c₀ ^ 2 + res_Q c_mid * c₀ * c₁ + res_Q c₁₁ * c₁ ^ 2) * t_bar ^ 2 := by
        calc ψ c₀₀ * (ι_Ω c₀ * t_bar) ^ 2 +
                ψ c_mid * (ι_Ω c₀ * t_bar) * (ι_Ω c₁ * t_bar) +
                ψ c₁₁ * (ι_Ω c₁ * t_bar) ^ 2
            = ι_Ω c₀ ^ 2 * (ψ c₀₀ * t_bar ^ 2) +
                (ι_Ω c₀ * ι_Ω c₁) * (ψ c_mid * t_bar ^ 2) +
                ι_Ω c₁ ^ 2 * (ψ c₁₁ * t_bar ^ 2) := by ring
          _ = ι_Ω c₀ ^ 2 * (ι_Ω (res_Q c₀₀) * t_bar ^ 2) +
                (ι_Ω c₀ * ι_Ω c₁) * (ι_Ω (res_Q c_mid) * t_bar ^ 2) +
                ι_Ω c₁ ^ 2 * (ι_Ω (res_Q c₁₁) * t_bar ^ 2) := by
                  rw [hψ_t2 c₀₀, hψ_t2 c_mid, hψ_t2 c₁₁]
          _ = (ι_Ω (res_Q c₀₀) * ι_Ω c₀ ^ 2 +
                ι_Ω (res_Q c_mid) * ι_Ω c₀ * ι_Ω c₁ +
                ι_Ω (res_Q c₁₁) * ι_Ω c₁ ^ 2) * t_bar ^ 2 := by ring
          _ = ι_Ω (res_Q c₀₀ * c₀ ^ 2 + res_Q c_mid * c₀ * c₁ + res_Q c₁₁ * c₁ ^ 2) * t_bar ^ 2 := by
                simp only [map_add, map_mul, map_pow]
      rw [h_lhs, h_rhs] at hψ_quad
      exact h_t2_inj _ _ hψ_quad
    have hc₀₀ : res_Q c₀₀ = 0 := by
      have h10 := h_jet 1 0
      linear_combination -h10
    have hc₁₁ : res_Q c₁₁ = 0 := by
      have h01 := h_jet 0 1
      linear_combination -h01
    have hc_mid : res_Q (c_mid - s ^ 2) = 0 := by
      have h11 := h_jet 1 1
      rw [hc₀₀, hc₁₁] at h11
      rw [map_sub]
      linear_combination -h11
    exact ⟨(hRes_ker c₀₀).mp hc₀₀, (hRes_ker c₁₁).mp hc₁₁, (hRes_ker _).mp hc_mid⟩

  
  let B_s := Localization.Away s
  let ι_s : B →+* B_s := algebraMap B B_s
  let s2_sub : Submonoid.powers s := ⟨s ^ 2, Submonoid.pow_mem _ (Submonoid.mem_powers s) 2⟩
  obtain ⟨inv_s2, hinv_s2⟩ : ∃ inv_s2 : B_s, ι_s (s ^ 2) * inv_s2 = 1 := by
    refine ⟨IsLocalization.mk' B_s 1 s2_sub, ?_⟩
    have hspec := IsLocalization.mk'_spec' B_s 1 s2_sub
    rwa [map_one] at hspec
  let A₂₀ : B_s := inv_s2 * ι_s c₀₀
  let A₁₁ : B_s := inv_s2 * ι_s c_mid
  let A₀₂ : B_s := inv_s2 * ι_s c₁₁
  refine ⟨hFQ, s, u₀, v₀, h, A₂₀, A₁₁, A₀₂, hsQ, hu₀, hv₀, hh, ?_, ?_, ?_, ?_⟩
  · exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem ι_s hc₀₀_Q)
  · exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem ι_s hc₁₁_Q)
  · have hA11_eq : A₁₁ - 1 = inv_s2 * ι_s (c_mid - s ^ 2) := by
      calc A₁₁ - 1
          = inv_s2 * ι_s c_mid - ι_s (s ^ 2) * inv_s2 := by rw [hinv_s2]
        _ = inv_s2 * (ι_s c_mid - ι_s (s ^ 2)) := by ring
        _ = inv_s2 * ι_s (c_mid - s ^ 2) := by rw [map_sub]
    rw [hA11_eq]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem ι_s hcmid_Q)
  · have h_map_quad := congrArg ι_s hQuadB
    simp only [map_mul, map_add, map_pow] at h_map_quad
    calc ι_s F + (ι_s.comp φ_P) (MvPolynomial.C h)
        = (inv_s2 * ι_s (s ^ 2)) * (ι_s F + ι_s (φ_P (MvPolynomial.C h))) := by
            rw [mul_comm inv_s2, hinv_s2, one_mul]
            rfl
      _ = inv_s2 * (ι_s s ^ 2 * (ι_s F + ι_s (φ_P (MvPolynomial.C h)))) := by
            rw [map_pow]
            ring
      _ = inv_s2 * (ι_s c₀₀ * ι_s (φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀)) ^ 2 +
            ι_s c_mid * ι_s (φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀)) *
              ι_s (φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀)) +
            ι_s c₁₁ * ι_s (φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀)) ^ 2) := by
            rw [h_map_quad]
      _ = A₂₀ * (ι_s.comp φ_P) (MvPolynomial.X 0 - MvPolynomial.C u₀) ^ 2 +
            A₁₁ * (ι_s.comp φ_P) (MvPolynomial.X 0 - MvPolynomial.C u₀) *
              (ι_s.comp φ_P) (MvPolynomial.X 1 - MvPolynomial.C v₀) +
            A₀₂ * (ι_s.comp φ_P) (MvPolynomial.X 1 - MvPolynomial.C v₀) ^ 2 := by
            dsimp only [A₂₀, A₁₁, A₀₂, RingHom.comp_apply]
            ring

theorem weil_powerSeries_quadratic_etale_quotient_roof (Ω : Type u) [Field Ω]
    (B : Type u) [CommRing B]
    (φ_P : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B)
    (Q : PrimeSpectrum B)
    (F s : B)
    (u₀ v₀ h : PowerSeries Ω)
    (A₂₀ A₁₁ A₀₂ : Localization.Away s)
    (hφEt : φ_P.Etale)
    (hQcomap : Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = IsLocalRing.maximalIdeal (PowerSeries Ω))
    (hXi : ∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal)
    (hFQ : F ∈ Q.asIdeal)
    (hsQ : s ∉ Q.asIdeal)
    (hu₀ : u₀ ∈ IsLocalRing.maximalIdeal (PowerSeries Ω))
    (hv₀ : v₀ ∈ IsLocalRing.maximalIdeal (PowerSeries Ω))
    (hA₂₀ : A₂₀ ∈ Ideal.map (algebraMap B (Localization.Away s)) Q.asIdeal)
    (hA₀₂ : A₀₂ ∈ Ideal.map (algebraMap B (Localization.Away s)) Q.asIdeal)
    (hA₁₁ : A₁₁ - 1 ∈ Ideal.map (algebraMap B (Localization.Away s)) Q.asIdeal)
    (hQuad :
      let φ_s := (algebraMap B (Localization.Away s)).comp φ_P
      algebraMap B (Localization.Away s) F + φ_s (MvPolynomial.C h) =
        A₂₀ * φ_s (MvPolynomial.X 0 - MvPolynomial.C u₀) ^ 2 +
        A₁₁ * φ_s (MvPolynomial.X 0 - MvPolynomial.C u₀) *
          φ_s (MvPolynomial.X 1 - MvPolynomial.C v₀) +
        A₀₂ * φ_s (MvPolynomial.X 1 - MvPolynomial.C v₀) ^ 2) :
    let J_h : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}
    ∃ (D : CommRingCat.{u})
      (e_BF : CommRingCat.of (B ⧸ Ideal.span {F}) ⟶ D)
      (e_Nh : CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_h) ⟶ D)
      (v₀ : PrimeSpectrum D),
      e_BF.hom.Etale ∧
      e_Nh.hom.Etale ∧
      PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {F}))
        (PrimeSpectrum.comap e_BF.hom v₀) = Q ∧
      (∀ i : Fin 2,
        Ideal.Quotient.mk J_h (MvPolynomial.X i) ∈ (PrimeSpectrum.comap e_Nh.hom v₀).asIdeal) ∧
      Ideal.Quotient.mk J_h (MvPolynomial.C (PowerSeries.X : PowerSeries Ω)) ∈
        (PrimeSpectrum.comap e_Nh.hom v₀).asIdeal ∧
      e_BF.hom.comp ((Ideal.Quotient.mk (Ideal.span {F})).comp (φ_P.comp MvPolynomial.C)) =
        e_Nh.hom.comp ((Ideal.Quotient.mk J_h).comp MvPolynomial.C) :=
by
  have h_s2 : ∀ (B₁ : Type u) [CommRing B₁]
      (Q₁ : PrimeSpectrum B₁)
      (A₂₀ A₁₁ A₀₂ : B₁),
      A₂₀ ∈ Q₁.asIdeal →
      A₀₂ ∈ Q₁.asIdeal →
      A₁₁ - 1 ∈ Q₁.asIdeal →
      ∃ (B' : Type u) (_ : CommRing B') (α : B₁ →+* B') (Q' : PrimeSpectrum B')
        (c₀₀ c₀₁ c₁₀ c₁₁ : B'),
        α.Etale ∧
        PrimeSpectrum.comap α Q' = Q₁ ∧
        c₀₀ ∈ Q'.asIdeal ∧
        c₀₁ - 1 ∈ Q'.asIdeal ∧
        c₁₀ - 1 ∈ Q'.asIdeal ∧
        c₁₁ ∈ Q'.asIdeal ∧
        ∀ u v : B',
          (c₀₀ * u + c₀₁ * v) * (c₁₀ * u + c₁₁ * v) =
            α A₂₀ * u ^ 2 + α A₁₁ * u * v + α A₀₂ * v ^ 2 := by
    intro B₁ _ Q₁ A₂₀ A₁₁ A₀₂ hA₂₀ hA₀₂ hA₁₁
    let C₂ : B₁ := A₂₀ + A₁₁ + A₀₂
    have hC₂_sub : C₂ - 1 ∈ Q₁.asIdeal := by
      have h_eq : C₂ - 1 = A₂₀ + (A₁₁ - 1) + A₀₂ := by ring
      rw [h_eq]
      exact Q₁.asIdeal.add_mem (Q₁.asIdeal.add_mem hA₂₀ hA₁₁) hA₀₂
    have hC₂_notMem : C₂ ∉ Q₁.asIdeal := by
      intro hmem
      have h1 : (1 : B₁) ∈ Q₁.asIdeal := by
        have h_eq : (1 : B₁) = C₂ - (C₂ - 1) := by ring
        rw [h_eq]
        exact Q₁.asIdeal.sub_mem hmem hC₂_sub
      exact Q₁.isPrime.ne_top (Q₁.asIdeal.eq_top_iff_one.mpr h1)
    let B₂ : Type u := Localization.Away C₂
    let ι₂ : B₁ →+* B₂ := algebraMap B₁ B₂
    have : Algebra.Etale B₁ B₂ := Algebra.Etale.of_isLocalizationAway C₂
    have hι₂Et : ι₂.Etale := RingHom.etale_algebraMap.mpr inferInstance
    have hDisj₂ : Disjoint (Submonoid.powers C₂ : Set B₁) Q₁.asIdeal :=
      (Ideal.disjoint_powers_iff_notMem C₂ Q₁.isPrime.isRadical).mpr hC₂_notMem
    have hQ₂_prime : (Ideal.map ι₂ Q₁.asIdeal).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers C₂) B₂ Q₁.asIdeal Q₁.isPrime hDisj₂
    let Q₂ : PrimeSpectrum B₂ := ⟨Ideal.map ι₂ Q₁.asIdeal, hQ₂_prime⟩
    have hQ₂_under : Q₂.asIdeal.comap ι₂ = Q₁.asIdeal :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers C₂) B₂ Q₁.isPrime hDisj₂
    obtain ⟨u_C₂, hu_C₂⟩ := IsLocalization.Away.algebraMap_isUnit (S := B₂) C₂
    let w₂ : B₂ := ↑u_C₂⁻¹
    have hw₂ : ι₂ C₂ * w₂ = 1 := by
      change ι₂ C₂ * ↑u_C₂⁻¹ = 1
      rw [← hu_C₂]
      exact Units.mul_inv u_C₂
    let b_star : B₂ := w₂ * ι₂ (2 * A₂₀ + A₁₁)
    let c_star : B₂ := w₂ * ι₂ A₂₀
    have hc_mem : c_star ∈ Q₂.asIdeal :=
      Q₂.asIdeal.mul_mem_left w₂ (Ideal.mem_map_of_mem ι₂ hA₂₀)
    have hb_mem : b_star - 1 ∈ Q₂.asIdeal := by
      have h_eq : b_star - 1 = w₂ * ι₂ (A₂₀ - A₀₂) := by
        calc b_star - 1
            = w₂ * ι₂ (2 * A₂₀ + A₁₁) - ι₂ C₂ * w₂ := by rw [hw₂]
          _ = w₂ * (ι₂ (2 * A₂₀ + A₁₁) - ι₂ (A₂₀ + A₁₁ + A₀₂)) := by ring
          _ = w₂ * ι₂ (A₂₀ - A₀₂) := by
            rw [← map_sub]
            congr 2
            ring
      rw [h_eq]
      exact Q₂.asIdeal.mul_mem_left w₂ (Ideal.mem_map_of_mem ι₂ (Q₁.asIdeal.sub_mem hA₂₀ hA₀₂))
    let P_mon : Polynomial B₂ :=
      Polynomial.X ^ 2 - Polynomial.C b_star * Polynomial.X + Polynomial.C c_star
    let g_der : Polynomial B₂ := 2 * Polynomial.X - Polynomial.C b_star
    have hMon : P_mon.Monic := by
      have h_eq : P_mon = Polynomial.X ^ 2 + (-(Polynomial.C b_star * Polynomial.X) + Polynomial.C c_star) := by
        dsimp only [P_mon]
        ring
      rw [h_eq]
      apply Polynomial.monic_X_pow_add
      refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt ?_ ?_)
      · rw [Polynomial.degree_neg]
        exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le b_star) (by decide)
      · exact lt_of_le_of_lt Polynomial.degree_C_le (by decide)
    have hDer : Polynomial.derivative P_mon = g_der := by
      dsimp only [P_mon, g_der]
      rw [Polynomial.derivative_add, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
        Polynomial.derivative_C_mul_X, Polynomial.derivative_C]
      simp only [Nat.cast_ofNat, map_ofNat]
      ring
    let P_pair : StandardEtalePair B₂ := ⟨P_mon, hMon, g_der, ⟨1, 0, 1, by rw [hDer]; ring⟩⟩
    let B' : Type u := P_pair.Ring
    let α : B₁ →+* B' := (algebraMap B₂ B').comp ι₂
    have hαEt : α.Etale :=
      RingHom.Etale.stableUnderComposition ι₂ (algebraMap B₂ B') hι₂Et
        (RingHom.etale_algebraMap.mpr inferInstance)
    let κ₀ : Type u := B₂ ⧸ Q₂.asIdeal
    have : Q₂.asIdeal.IsPrime := Q₂.isPrime
    have : IsDomain κ₀ := Ideal.Quotient.isDomain Q₂.asIdeal
    have hHasMap0 : P_pair.HasMap (0 : κ₀) := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval (0 : κ₀) P_mon = 0
        simp only [P_mon, map_add, map_sub, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        have hc0 : algebraMap B₂ κ₀ c_star = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hc_mem
        rw [hc0]
        ring
      · change IsUnit (Polynomial.aeval (0 : κ₀) g_der)
        simp only [g_der, map_sub, map_mul, map_ofNat, Polynomial.aeval_X, Polynomial.aeval_C,
          mul_zero, zero_sub]
        have hb1 : algebraMap B₂ κ₀ b_star = 1 := by
          have hb0 : algebraMap B₂ κ₀ (b_star - 1) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb_mem
          rw [map_sub, map_one, sub_eq_zero] at hb0
          exact hb0
        rw [hb1]
        exact isUnit_one.neg
    let lam0 : B' →ₐ[B₂] κ₀ := P_pair.lift (0 : κ₀) hHasMap0
    let Q' : PrimeSpectrum B' := ⟨RingHom.ker lam0.toRingHom, RingHom.ker_isPrime lam0.toRingHom⟩
    have hQ'_comap_B₂ : Q'.asIdeal.comap (algebraMap B₂ B') = Q₂.asIdeal := by
      ext y
      change lam0 (algebraMap B₂ B' y) = 0 ↔ y ∈ Q₂.asIdeal
      rw [lam0.commutes y]
      exact Ideal.Quotient.eq_zero_iff_mem
    have hQ'_comap : PrimeSpectrum.comap α Q' = Q₁ := by
      apply PrimeSpectrum.ext
      change Q'.asIdeal.comap ((algebraMap B₂ B').comp ι₂) = Q₁.asIdeal
      rw [← Ideal.comap_comap, hQ'_comap_B₂, hQ₂_under]
    let z : B' := P_pair.X
    have hz_mem : z ∈ Q'.asIdeal := P_pair.lift_X (0 : κ₀) hHasMap0
    let b' : B' := algebraMap B₂ B' b_star
    let c' : B' := algebraMap B₂ B' c_star
    let C₂' : B' := α C₂
    have hz_root : z * (b' - z) = c' := by
      have h0 : Polynomial.aeval z P_mon = 0 := P_pair.hasMap_X.1
      simp only [P_mon, map_add, map_sub, map_mul, map_pow, Polynomial.aeval_X,
        Polynomial.aeval_C] at h0
      calc z * (b' - z)
          = c' - (z ^ 2 - b' * z + c') := by ring
        _ = c' - 0 := by rw [h0]
        _ = c' := sub_zero _
    have hC₂b : C₂' * b' = 2 * α A₂₀ + α A₁₁ := by
      have h_B₂ : ι₂ C₂ * b_star = ι₂ (2 * A₂₀ + A₁₁) := by
        calc ι₂ C₂ * (w₂ * ι₂ (2 * A₂₀ + A₁₁))
            = (ι₂ C₂ * w₂) * ι₂ (2 * A₂₀ + A₁₁) := by ring
          _ = ι₂ (2 * A₂₀ + A₁₁) := by rw [hw₂, one_mul]
      have hmul : C₂' * b' = algebraMap B₂ B' (ι₂ C₂ * b_star) :=
        (map_mul (algebraMap B₂ B') (ι₂ C₂) b_star).symm
      rw [hmul, h_B₂]
      change α (2 * A₂₀ + A₁₁) = 2 * α A₂₀ + α A₁₁
      simp only [map_add, map_mul, map_ofNat]
    have hC₂c : C₂' * c' = α A₂₀ := by
      have h_B₂ : ι₂ C₂ * c_star = ι₂ A₂₀ := by
        calc ι₂ C₂ * (w₂ * ι₂ A₂₀)
            = (ι₂ C₂ * w₂) * ι₂ A₂₀ := by ring
          _ = ι₂ A₂₀ := by rw [hw₂, one_mul]
      have hmul : C₂' * c' = algebraMap B₂ B' (ι₂ C₂ * c_star) :=
        (map_mul (algebraMap B₂ B') (ι₂ C₂) c_star).symm
      rw [hmul, h_B₂]
      rfl
    have hC₂_def : C₂' = α A₂₀ + α A₁₁ + α A₀₂ := by
      simp only [C₂', C₂, map_add]
    have hα_mem : ∀ x ∈ Q₁.asIdeal, α x ∈ Q'.asIdeal := by
      intro x hx
      have h_eq : Q'.asIdeal.comap α = Q₁.asIdeal := congrArg PrimeSpectrum.asIdeal hQ'_comap
      rw [← h_eq] at hx
      exact hx
    let c₀₀ : B' := z
    let c₀₁ : B' := 1 - z
    let c₁₀ : B' := C₂' * (b' - z)
    let c₁₁ : B' := C₂' * (1 - b' + z)
    refine ⟨B', inferInstance, α, Q', c₀₀, c₀₁, c₁₀, c₁₁, hαEt, hQ'_comap, hz_mem, ?_, ?_, ?_, ?_⟩
    · have h_eq : c₀₁ - 1 = -z := by dsimp [c₀₁]; ring
      rw [h_eq]
      exact Q'.asIdeal.neg_mem hz_mem
    · have h_eq : c₁₀ - 1 = 2 * α A₂₀ + α (A₁₁ - 1) - C₂' * z := by
        calc c₁₀ - 1
            = C₂' * b' - C₂' * z - 1 := by dsimp [c₁₀]; ring
          _ = 2 * α A₂₀ + α A₁₁ - 1 - C₂' * z := by rw [hC₂b]; ring
          _ = 2 * α A₂₀ + α (A₁₁ - 1) - C₂' * z := by rw [map_sub, map_one]; ring
      rw [h_eq]
      exact Q'.asIdeal.sub_mem
        (Q'.asIdeal.add_mem (Q'.asIdeal.mul_mem_left 2 (hα_mem A₂₀ hA₂₀)) (hα_mem _ hA₁₁))
        (Q'.asIdeal.mul_mem_left C₂' hz_mem)
    · have h_eq : c₁₁ = α (A₀₂ - A₂₀) + C₂' * z := by
        calc c₁₁
            = C₂' - C₂' * b' + C₂' * z := by dsimp [c₁₁]; ring
          _ = C₂' - (2 * α A₂₀ + α A₁₁) + C₂' * z := by rw [hC₂b]
          _ = (α A₂₀ + α A₁₁ + α A₀₂) - (2 * α A₂₀ + α A₁₁) + C₂' * z := by
            nth_rw 1 [hC₂_def]
          _ = (α A₀₂ - α A₂₀) + C₂' * z := by ring
          _ = α (A₀₂ - A₂₀) + C₂' * z := by rw [map_sub]
      rw [h_eq]
      exact Q'.asIdeal.add_mem (hα_mem _ (Q₁.asIdeal.sub_mem hA₀₂ hA₂₀))
        (Q'.asIdeal.mul_mem_left C₂' hz_mem)
    · intro u v
      calc (c₀₀ * u + c₀₁ * v) * (c₁₀ * u + c₁₁ * v)
          = (C₂' * (z * (b' - z))) * u ^ 2 +
            (C₂' * b' - 2 * (C₂' * (z * (b' - z)))) * u * v +
            (C₂' - C₂' * b' + C₂' * (z * (b' - z))) * v ^ 2 := by
            dsimp [c₀₀, c₀₁, c₁₀, c₁₁]; ring
        _ = α A₂₀ * u ^ 2 + α A₁₁ * u * v + α A₀₂ * v ^ 2 := by
            rw [hz_root, hC₂c, hC₂b, hC₂_def]; ring
  have h_s3 : ∀ (R B' : Type u) [CommRing R] [CommRing B']
      (φ_old : MvPolynomial (Fin 2) R →+* B'),
      φ_old.Etale →
      ∀ (Q' : PrimeSpectrum B')
        (u₀ v₀ : R)
        (c₀₀ c₀₁ c₁₀ c₁₁ : B'),
        φ_old (MvPolynomial.X 0 - MvPolynomial.C u₀) ∈ Q'.asIdeal →
        φ_old (MvPolynomial.X 1 - MvPolynomial.C v₀) ∈ Q'.asIdeal →
        c₀₀ * c₁₁ - c₀₁ * c₁₀ ∉ Q'.asIdeal →
        ∃ (B'' : Type u) (_ : CommRing B'') (γ : B' →+* B'') (Q'' : PrimeSpectrum B'')
          (ψ_P : MvPolynomial (Fin 2) R →+* B''),
          γ.Etale ∧
          ψ_P.Etale ∧
          PrimeSpectrum.comap γ Q'' = Q' ∧
          ψ_P.comp MvPolynomial.C = γ.comp (φ_old.comp MvPolynomial.C) ∧
          ψ_P (MvPolynomial.X 0) =
            γ (c₀₀ * φ_old (MvPolynomial.X 0 - MvPolynomial.C u₀) +
               c₀₁ * φ_old (MvPolynomial.X 1 - MvPolynomial.C v₀)) ∧
          ψ_P (MvPolynomial.X 1) =
            γ (c₁₀ * φ_old (MvPolynomial.X 0 - MvPolynomial.C u₀) +
               c₁₁ * φ_old (MvPolynomial.X 1 - MvPolynomial.C v₀)) := by
    intro R B' _ _ φ_old hφEt Q' u₀ v₀ c₀₀ c₀₁ c₁₀ c₁₁ hU hV hDet
    let P₂ := MvPolynomial (Fin 2) R
    let U' : B' := φ_old (MvPolynomial.X 0 - MvPolynomial.C u₀)
    let V' : B' := φ_old (MvPolynomial.X 1 - MvPolynomial.C v₀)
    let x₀ : B' := c₀₀ * U' + c₀₁ * V'
    let x₁ : B' := c₁₀ * U' + c₁₁ * V'
    letI : Algebra R B' := (φ_old.comp MvPolynomial.C).toAlgebra
    let b_P : Module.Basis (Fin 2) P₂ Ω[P₂⁄R] := KaehlerDifferential.mvPolynomialBasis R (Fin 2)
    have hB'_pkg :
        Algebra.FormallySmooth R B' ∧
        (φ_old.comp MvPolynomial.C).FinitePresentation ∧
        ∃ (b_B' : Module.Basis (Fin 2) B' Ω[B'⁄R]),
          ∀ (p : P₂) (j : Fin 2),
            (b_B'.coord j) (KaehlerDifferential.D R B' (φ_old p)) =
              φ_old (MvPolynomial.pderiv j p) := by
      letI : Algebra P₂ B' := φ_old.toAlgebra
      have : IsScalarTower R P₂ B' := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.Etale P₂ B' := RingHom.etale_algebraMap.mp hφEt
      have hFS : Algebra.FormallySmooth R B' := Algebra.FormallySmooth.comp R P₂ B'
      have hFP_P₂ : (MvPolynomial.C : R →+* P₂).FinitePresentation :=
        RingHom.finitePresentation_algebraMap.mpr inferInstance
      have hFP_φ : φ_old.FinitePresentation :=
        RingHom.finitePresentation_algebraMap.mpr inferInstance
      have hFP : (φ_old.comp MvPolynomial.C).FinitePresentation :=
        RingHom.FinitePresentation.comp hFP_φ hFP_P₂
      have ibc' : IsBaseChange B' (KaehlerDifferential.map R R P₂ B') :=
        KaehlerDifferential.isBaseChange_of_formallyEtale R P₂ B'
      let b_B' : Module.Basis (Fin 2) B' Ω[B'⁄R] := IsBaseChange.basis b_P ibc'
      refine ⟨hFS, hFP, b_B', ?_⟩
      intro p j
      change (b_B'.repr (KaehlerDifferential.D R B' (algebraMap P₂ B' p))) j =
        algebraMap P₂ B' (MvPolynomial.pderiv j p)
      rw [← KaehlerDifferential.map_D R R P₂ B' p,
        IsBaseChange.basis_repr_comp_apply b_P ibc' (KaehlerDifferential.D R P₂ p) j,
        KaehlerDifferential.mvPolynomialBasis_repr_apply]
    obtain ⟨hFS_RB', hFP_RB', b_B', hb_B'_pderiv⟩ := hB'_pkg
    let derB' : Fin 2 → Derivation R B' B' :=
      fun j => (b_B'.coord j).compDer (KaehlerDifferential.D R B')
    have hder_φ : ∀ (p : P₂) (j : Fin 2), derB' j (φ_old p) = φ_old (MvPolynomial.pderiv j p) :=
      hb_B'_pderiv
    have hder0U : derB' 0 U' = 1 := by
      rw [hder_φ]
      simp [MvPolynomial.pderiv_X]
    have hder1U : derB' 1 U' = 0 := by
      rw [hder_φ]
      simp [MvPolynomial.pderiv_X]
    have hder0V : derB' 0 V' = 0 := by
      rw [hder_φ]
      simp [MvPolynomial.pderiv_X]
    have hder1V : derB' 1 V' = 1 := by
      rw [hder_φ]
      simp [MvPolynomial.pderiv_X]
    have hLeib : ∀ (j : Fin 2) (a b : B'),
        derB' j (a * U' + b * V') =
          a * derB' j U' + b * derB' j V' + (U' * derB' j a + V' * derB' j b) := by
      intro j a b
      rw [map_add, Derivation.leibniz, Derivation.leibniz, smul_eq_mul, smul_eq_mul,
        smul_eq_mul, smul_eq_mul]
      ring
    have hder0x₀_mem : derB' 0 x₀ - c₀₀ ∈ Q'.asIdeal := by
      have h_eq : derB' 0 x₀ - c₀₀ = U' * derB' 0 c₀₀ + V' * derB' 0 c₀₁ := by
        dsimp [x₀]; rw [hLeib, hder0U, hder0V]; ring
      rw [h_eq]
      exact Q'.asIdeal.add_mem (Q'.asIdeal.mul_mem_right _ hU) (Q'.asIdeal.mul_mem_right _ hV)
    have hder1x₀_mem : derB' 1 x₀ - c₀₁ ∈ Q'.asIdeal := by
      have h_eq : derB' 1 x₀ - c₀₁ = U' * derB' 1 c₀₀ + V' * derB' 1 c₀₁ := by
        dsimp [x₀]; rw [hLeib, hder1U, hder1V]; ring
      rw [h_eq]
      exact Q'.asIdeal.add_mem (Q'.asIdeal.mul_mem_right _ hU) (Q'.asIdeal.mul_mem_right _ hV)
    have hder0x₁_mem : derB' 0 x₁ - c₁₀ ∈ Q'.asIdeal := by
      have h_eq : derB' 0 x₁ - c₁₀ = U' * derB' 0 c₁₀ + V' * derB' 0 c₁₁ := by
        dsimp [x₁]; rw [hLeib, hder0U, hder0V]; ring
      rw [h_eq]
      exact Q'.asIdeal.add_mem (Q'.asIdeal.mul_mem_right _ hU) (Q'.asIdeal.mul_mem_right _ hV)
    have hder1x₁_mem : derB' 1 x₁ - c₁₁ ∈ Q'.asIdeal := by
      have h_eq : derB' 1 x₁ - c₁₁ = U' * derB' 1 c₁₀ + V' * derB' 1 c₁₁ := by
        dsimp [x₁]; rw [hLeib, hder1U, hder1V]; ring
      rw [h_eq]
      exact Q'.asIdeal.add_mem (Q'.asIdeal.mul_mem_right _ hU) (Q'.asIdeal.mul_mem_right _ hV)
    let Δ_J : B' := derB' 0 x₀ * derB' 1 x₁ - derB' 1 x₀ * derB' 0 x₁
    have hΔ_diff : Δ_J - (c₀₀ * c₁₁ - c₀₁ * c₁₀) ∈ Q'.asIdeal := by
      have h_eq : Δ_J - (c₀₀ * c₁₁ - c₀₁ * c₁₀) =
          (derB' 0 x₀ - c₀₀) * derB' 1 x₁ + c₀₀ * (derB' 1 x₁ - c₁₁) -
          (derB' 1 x₀ - c₀₁) * derB' 0 x₁ - c₀₁ * (derB' 0 x₁ - c₁₀) := by
        dsimp [Δ_J]; ring
      rw [h_eq]
      exact Q'.asIdeal.sub_mem
        (Q'.asIdeal.sub_mem
          (Q'.asIdeal.add_mem
            (Q'.asIdeal.mul_mem_right _ hder0x₀_mem)
            (Q'.asIdeal.mul_mem_left _ hder1x₁_mem))
          (Q'.asIdeal.mul_mem_right _ hder1x₀_mem))
        (Q'.asIdeal.mul_mem_left _ hder0x₁_mem)
    have hΔ_notMem : Δ_J ∉ Q'.asIdeal := by
      intro hmem
      apply hDet
      have h_eq : c₀₀ * c₁₁ - c₀₁ * c₁₀ = Δ_J - (Δ_J - (c₀₀ * c₁₁ - c₀₁ * c₁₀)) := by ring
      rw [h_eq]
      exact Q'.asIdeal.sub_mem hmem hΔ_diff
    have hD_B' : ∀ z : B',
        KaehlerDifferential.D R B' z = derB' 0 z • b_B' 0 + derB' 1 z • b_B' 1 := by
      intro z
      have hsum := (b_B'.sum_repr (KaehlerDifferential.D R B' z)).symm
      rw [Fin.sum_univ_two] at hsum
      exact hsum
    let B'' : Type u := Localization.Away Δ_J
    let γ : B' →+* B'' := algebraMap B' B''
    have : Algebra.Etale B' B'' := Algebra.Etale.of_isLocalizationAway Δ_J
    have hγEt : γ.Etale := RingHom.etale_algebraMap.mpr inferInstance
    have hDisjΔ : Disjoint (Submonoid.powers Δ_J : Set B') Q'.asIdeal :=
      (Ideal.disjoint_powers_iff_notMem Δ_J Q'.isPrime.isRadical).mpr hΔ_notMem
    have hQ''_prime : (Ideal.map γ Q'.asIdeal).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers Δ_J) B'' Q'.asIdeal Q'.isPrime hDisjΔ
    let Q'' : PrimeSpectrum B'' := ⟨Ideal.map γ Q'.asIdeal, hQ''_prime⟩
    have hQ''_comap : PrimeSpectrum.comap γ Q'' = Q' :=
      PrimeSpectrum.ext (IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers Δ_J) B'' Q'.isPrime hDisjΔ)
    have : Algebra.FormallySmooth R B' := hFS_RB'
    have : Algebra.FormallySmooth R B'' := Algebra.FormallySmooth.comp R B' B''
    have hH1_RB'' : Subsingleton (Algebra.H1Cotangent R B'') := inferInstance
    have hFP_γ : γ.FinitePresentation := RingHom.finitePresentation_algebraMap.mpr inferInstance
    have hFP_RB'' : (γ.comp (φ_old.comp MvPolynomial.C)).FinitePresentation :=
      RingHom.FinitePresentation.comp hFP_γ hFP_RB'
    have ibc'' : IsBaseChange B'' (KaehlerDifferential.map R R B' B'') :=
      KaehlerDifferential.isBaseChange_of_formallyEtale R B' B''
    let e_old : Module.Basis (Fin 2) B'' Ω[B''⁄R] := IsBaseChange.basis b_B' ibc''
    have hD_B'' : ∀ z : B',
        KaehlerDifferential.D R B'' (γ z) =
          γ (derB' 0 z) • e_old 0 + γ (derB' 1 z) • e_old 1 := by
      intro z
      calc KaehlerDifferential.D R B'' (algebraMap B' B'' z)
          = KaehlerDifferential.map R R B' B'' (KaehlerDifferential.D R B' z) :=
            (KaehlerDifferential.map_D R R B' B'' z).symm
        _ = KaehlerDifferential.map R R B' B'' (derB' 0 z • b_B' 0 + derB' 1 z • b_B' 1) := by
            rw [hD_B' z]
        _ = γ (derB' 0 z) • e_old 0 + γ (derB' 1 z) • e_old 1 := by
            rw [map_add, LinearMap.CompatibleSMul.map_smul, LinearMap.CompatibleSMul.map_smul,
              ← IsBaseChange.basis_apply b_B' ibc'' 0, ← IsBaseChange.basis_apply b_B' ibc'' 1,
              ← IsScalarTower.algebraMap_smul B'' (derB' 0 z),
              ← IsScalarTower.algebraMap_smul B'' (derB' 1 z)]
    let ψ_P : P₂ →+* B'' :=
      MvPolynomial.eval₂Hom (γ.comp (φ_old.comp MvPolynomial.C))
        (Fin.cases (γ x₀) (fun _ => γ x₁))
    have hψC : ψ_P.comp MvPolynomial.C = γ.comp (φ_old.comp MvPolynomial.C) := by
      ext r
      exact MvPolynomial.eval₂Hom_C _ _ r
    have hψX0 : ψ_P (MvPolynomial.X 0) = γ x₀ :=
      MvPolynomial.eval₂Hom_X' _ _ 0
    have hψX1 : ψ_P (MvPolynomial.X 1) = γ x₁ :=
      MvPolynomial.eval₂Hom_X' _ _ 1
    have hψFP : ψ_P.FinitePresentation :=
      RingHom.FinitePresentation.of_comp_finiteType MvPolynomial.C
        (by rw [hψC]; exact hFP_RB'')
        (RingHom.finiteType_algebraMap.mpr inferInstance)
    have hψEt : ψ_P.Etale := by
      letI : Algebra P₂ B'' := ψ_P.toAlgebra
      have : IsScalarTower R P₂ B'' := ⟨fun r p x => by
        change ψ_P (r • p) * x = r • (ψ_P p * x)
        rw [Algebra.smul_def r p, map_mul, Algebra.smul_def r (ψ_P p * x),
          IsScalarTower.algebraMap_eq R B' B'', RingHom.comp_apply]
        have hr : ψ_P (algebraMap R P₂ r) = γ (algebraMap R B' r) :=
          RingHom.congr_fun hψC r
        rw [hr, mul_assoc]⟩
      have : Algebra.FinitePresentation P₂ B'' := RingHom.finitePresentation_algebraMap.mp hψFP
      let b_new : Module.Basis (Fin 2) B'' (TensorProduct P₂ B'' Ω[P₂⁄R]) :=
        Module.Basis.baseChange B'' b_P
      let M_map : TensorProduct P₂ B'' Ω[P₂⁄R] →ₗ[B''] Ω[B''⁄R] :=
        KaehlerDifferential.mapBaseChange R P₂ B''
      have hM0 : M_map (b_new 0) = γ (derB' 0 x₀) • e_old 0 + γ (derB' 1 x₀) • e_old 1 := by
        calc M_map (b_new 0)
            = M_map ((1 : B'') ⊗ₜ[P₂] KaehlerDifferential.D R P₂ (MvPolynomial.X 0)) := by
              rw [Module.Basis.baseChange_apply, KaehlerDifferential.mvPolynomialBasis_apply]
          _ = KaehlerDifferential.D R B'' (ψ_P (MvPolynomial.X 0)) := by
              rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
              rfl
          _ = γ (derB' 0 x₀) • e_old 0 + γ (derB' 1 x₀) • e_old 1 := by
              rw [hψX0, hD_B'' x₀]
      have hM1 : M_map (b_new 1) = γ (derB' 0 x₁) • e_old 0 + γ (derB' 1 x₁) • e_old 1 := by
        calc M_map (b_new 1)
            = M_map ((1 : B'') ⊗ₜ[P₂] KaehlerDifferential.D R P₂ (MvPolynomial.X 1)) := by
              rw [Module.Basis.baseChange_apply, KaehlerDifferential.mvPolynomialBasis_apply]
          _ = KaehlerDifferential.D R B'' (ψ_P (MvPolynomial.X 1)) := by
              rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
              rfl
          _ = γ (derB' 0 x₁) • e_old 0 + γ (derB' 1 x₁) • e_old 1 := by
              rw [hψX1, hD_B'' x₁]
      obtain ⟨u_Δ, hu_Δ⟩ := IsLocalization.Away.algebraMap_isUnit (S := B'') Δ_J
      let w_Δ : B'' := ↑u_Δ⁻¹
      have hw_Δ : γ Δ_J * w_Δ = 1 := by
        change γ Δ_J * ↑u_Δ⁻¹ = 1
        rw [← hu_Δ]
        exact Units.mul_inv u_Δ
      let a' : B'' := γ (derB' 0 x₀)
      let b' : B'' := γ (derB' 1 x₀)
      let c' : B'' := γ (derB' 0 x₁)
      let d' : B'' := γ (derB' 1 x₁)
      have hDet_B'' : (a' * d' - b' * c') * w_Δ = 1 := by
        have hγΔ : γ Δ_J = a' * d' - b' * c' := by
          simp only [Δ_J, a', b', c', d', map_sub, map_mul]
        rwa [← hγΔ]
      let v_inv : Fin 2 → TensorProduct P₂ B'' Ω[P₂⁄R] :=
        Fin.cases
          (w_Δ • (d' • b_new 0 + (-b') • b_new 1))
          (fun _ => w_Δ • ((-c') • b_new 0 + a' • b_new 1))
      let L_inv : Ω[B''⁄R] →ₗ[B''] TensorProduct P₂ B'' Ω[P₂⁄R] :=
        e_old.constr B'' v_inv
      have hL0 : L_inv (e_old 0) = w_Δ • (d' • b_new 0 + (-b') • b_new 1) :=
        e_old.constr_basis B'' v_inv 0
      have hL1 : L_inv (e_old 1) = w_Δ • ((-c') • b_new 0 + a' • b_new 1) :=
        e_old.constr_basis B'' v_inv 1
      have hLM : L_inv.comp M_map = LinearMap.id := by
        apply b_new.ext
        rw [Fin.forall_fin_two]
        refine ⟨?_, ?_⟩
        · simp only [LinearMap.comp_apply, LinearMap.id_apply, hM0, map_add, map_smul, hL0, hL1]
          change a' • (w_Δ • (d' • b_new 0 + (-b') • b_new 1)) +
            b' • (w_Δ • ((-c') • b_new 0 + a' • b_new 1)) = b_new 0
          simp only [smul_add, smul_smul]
          rw [add_add_add_comm, ← add_smul, ← add_smul]
          have hs1 : a' * (w_Δ * d') + b' * (w_Δ * -c') = 1 := by
            calc a' * (w_Δ * d') + b' * (w_Δ * -c')
                = (a' * d' - b' * c') * w_Δ := by ring
              _ = 1 := hDet_B''
          have hs2 : a' * (w_Δ * -b') + b' * (w_Δ * a') = 0 := by ring
          rw [hs1, hs2, one_smul, zero_smul, add_zero]
        · simp only [LinearMap.comp_apply, LinearMap.id_apply, hM1, map_add, map_smul, hL0, hL1]
          change c' • (w_Δ • (d' • b_new 0 + (-b') • b_new 1)) +
            d' • (w_Δ • ((-c') • b_new 0 + a' • b_new 1)) = b_new 1
          simp only [smul_add, smul_smul]
          rw [add_add_add_comm, ← add_smul, ← add_smul]
          have hs1 : c' * (w_Δ * d') + d' * (w_Δ * -c') = 0 := by ring
          have hs2 : c' * (w_Δ * -b') + d' * (w_Δ * a') = 1 := by
            calc c' * (w_Δ * -b') + d' * (w_Δ * a')
                = (a' * d' - b' * c') * w_Δ := by ring
              _ = 1 := hDet_B''
          rw [hs1, hs2, zero_smul, one_smul, zero_add]
      have hML : M_map.comp L_inv = LinearMap.id := by
        apply e_old.ext
        rw [Fin.forall_fin_two]
        refine ⟨?_, ?_⟩
        · simp only [LinearMap.comp_apply, LinearMap.id_apply, hL0, map_add, map_smul, hM0, hM1]
          change w_Δ • (d' • (a' • e_old 0 + b' • e_old 1) +
            (-b') • (c' • e_old 0 + d' • e_old 1)) = e_old 0
          simp only [smul_add, smul_smul]
          rw [add_add_add_comm, ← add_smul, ← add_smul]
          have hs1 : w_Δ * (d' * a') + w_Δ * (-b' * c') = 1 := by
            calc w_Δ * (d' * a') + w_Δ * (-b' * c')
                = (a' * d' - b' * c') * w_Δ := by ring
              _ = 1 := hDet_B''
          have hs2 : w_Δ * (d' * b') + w_Δ * (-b' * d') = 0 := by ring
          rw [hs1, hs2, one_smul, zero_smul, add_zero]
        · simp only [LinearMap.comp_apply, LinearMap.id_apply, hL1, map_add, map_smul, hM0, hM1]
          change w_Δ • ((-c') • (a' • e_old 0 + b' • e_old 1) +
            a' • (c' • e_old 0 + d' • e_old 1)) = e_old 1
          simp only [smul_add, smul_smul]
          rw [add_add_add_comm, ← add_smul, ← add_smul]
          have hs1 : w_Δ * (-c' * a') + w_Δ * (a' * c') = 0 := by ring
          have hs2 : w_Δ * (-c' * b') + w_Δ * (a' * d') = 1 := by
            calc w_Δ * (-c' * b') + w_Δ * (a' * d')
                = (a' * d' - b' * c') * w_Δ := by ring
              _ = 1 := hDet_B''
          rw [hs1, hs2, zero_smul, one_smul, zero_add]
      have hInj : Function.Injective M_map := by
        intro u v huv
        have h1 := congrArg L_inv huv
        simpa using (LinearMap.congr_fun hLM u).symm.trans (h1.trans (LinearMap.congr_fun hLM v))
      have hSurj : Function.Surjective M_map := by
        intro y
        exact ⟨L_inv y, LinearMap.congr_fun hML y⟩
      have hSubΩ : Subsingleton Ω[B''⁄P₂] := by
        refine Subsingleton.intro fun ω₁ ω₂ => ?_
        have h0 : ∀ ω : Ω[B''⁄P₂], ω = 0 := by
          intro ω
          obtain ⟨ω_R, rfl⟩ := KaehlerDifferential.map_surjective R P₂ B'' ω
          obtain ⟨τ, rfl⟩ := hSurj ω_R
          exact (KaehlerDifferential.exact_mapBaseChange_map R P₂ B'').apply_apply_eq_zero τ
        rw [h0 ω₁, h0 ω₂]
      have hSubH1 : Subsingleton (Algebra.H1Cotangent P₂ B'') := by
        refine Subsingleton.intro fun c₁ c₂ => ?_
        have h0 : ∀ c : Algebra.H1Cotangent P₂ B'', c = 0 := by
          intro c
          have hMδ : M_map (Algebra.H1Cotangent.δ R P₂ B'' c) = 0 :=
            (Algebra.H1Cotangent.exact_δ_mapBaseChange R P₂ B'').apply_apply_eq_zero c
          have hδ0 : Algebra.H1Cotangent.δ R P₂ B'' c = 0 :=
            hInj (hMδ.trans (map_zero M_map).symm)
          obtain ⟨c₀, hc₀⟩ := (Algebra.H1Cotangent.exact_map_δ R P₂ B'' c).mp hδ0
          rw [← hc₀, Subsingleton.elim c₀ 0, map_zero]
        rw [h0 c₁, h0 c₂]
      have : Algebra.FormallyEtale P₂ B'' := Algebra.FormallyEtale.mk hSubΩ hSubH1
      have : Algebra.Etale P₂ B'' := ⟨inferInstance, inferInstance⟩
      exact RingHom.etale_algebraMap.mpr inferInstance
    exact ⟨B'', inferInstance, γ, Q'', ψ_P, hγEt, hψEt, hQ''_comap, hψC, hψX0, hψX1⟩
  have h_s4 : ∀ (R A P B'' : Type u) [CommRing R] [CommRing A] [CommRing P] [CommRing B'']
      (φ_A : R →+* A) (φ_P : R →+* P)
      (β : A →+* B'') (ψ : P →+* B'')
      (a : A) (p : P)
      (Q'' : PrimeSpectrum B''),
      β.Etale →
      ψ.Etale →
      β.comp φ_A = ψ.comp φ_P →
      β a = ψ p →
      β a ∈ Q''.asIdeal →
      ∃ (D : CommRingCat.{u})
        (e_A : CommRingCat.of (A ⧸ Ideal.span {a}) ⟶ D)
        (e_P : CommRingCat.of (P ⧸ Ideal.span {p}) ⟶ D)
        (v₀ : PrimeSpectrum D),
        e_A.hom.Etale ∧
        e_P.hom.Etale ∧
        PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {a}))
          (PrimeSpectrum.comap e_A.hom v₀) = PrimeSpectrum.comap β Q'' ∧
        PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {p}))
          (PrimeSpectrum.comap e_P.hom v₀) = PrimeSpectrum.comap ψ Q'' ∧
        e_A.hom.comp ((Ideal.Quotient.mk (Ideal.span {a})).comp φ_A) =
          e_P.hom.comp ((Ideal.Quotient.mk (Ideal.span {p})).comp φ_P) := by
    intro R A P B'' _ _ _ _ φ_A φ_P β ψ a p Q'' hβEt hψEt hScalar hEq haQ
    have hEtQuot : ∀ (S T : Type u) [CommRing S] [CommRing T]
        (f : S →+* T), f.Etale → ∀ (I : Ideal S) (J : Ideal T)
        (hIJ : Ideal.map f I = J) (hle : I ≤ Ideal.comap f J),
        (Ideal.quotientMap J f hle).Etale := by
      intro S T _ _ f hf I J hIJ hle
      letI : Algebra S T := f.toAlgebra
      have : Algebra.Etale S T := RingHom.etale_algebraMap.mp hf
      have : Algebra.Etale (S ⧸ I) (TensorProduct S (S ⧸ I) T) :=
        Algebra.Etale.baseChange S T (S ⧸ I)
      let g₀ : (S ⧸ I) →+* TensorProduct S (S ⧸ I) T :=
        algebraMap (S ⧸ I) (TensorProduct S (S ⧸ I) T)
      have hg₀Et : g₀.Etale := RingHom.etale_algebraMap.mpr inferInstance
      let e₁ : TensorProduct S (S ⧸ I) T ≃+* TensorProduct S T (S ⧸ I) :=
        (Algebra.TensorProduct.comm S (S ⧸ I) T).toRingEquiv
      let e₂ : TensorProduct S T (S ⧸ I) ≃+* (T ⧸ Ideal.map f I) :=
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I).symm.toRingEquiv
      let e₃ : (T ⧸ Ideal.map f I) ≃+* (T ⧸ J) := Ideal.quotEquivOfEq hIJ
      let e_iso : TensorProduct S (S ⧸ I) T ≃+* (T ⧸ J) := e₁.trans (e₂.trans e₃)
      have hcomp : Ideal.quotientMap J f hle = e_iso.toRingHom.comp g₀ := by
        ext s
        change Ideal.quotientMap J f hle (Ideal.Quotient.mk I s) =
          e₃ (e₂ (e₁ ((Ideal.Quotient.mk I s) ⊗ₜ[S] (1 : T))))
        rw [Ideal.quotientMap_mk]
        have h_tmul : e₁ ((Ideal.Quotient.mk I s) ⊗ₜ[S] (1 : T)) =
            (f s) ⊗ₜ[S] (1 : S ⧸ I) := by
          change (1 : T) ⊗ₜ[S] (Ideal.Quotient.mk I s) = (f s) ⊗ₜ[S] (1 : S ⧸ I)
          have hsm : Ideal.Quotient.mk I s = s • (1 : S ⧸ I) := by
            rw [Algebra.smul_def, mul_one]; rfl
          rw [hsm, TensorProduct.tmul_smul]
          change (f s * 1) ⊗ₜ[S] (1 : S ⧸ I) = (f s) ⊗ₜ[S] (1 : S ⧸ I)
          rw [mul_one]
        rw [h_tmul]
        have he₂ : e₂ ((f s) ⊗ₜ[S] (1 : S ⧸ I)) = Ideal.Quotient.mk (Ideal.map f I) (f s) := by
          apply (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I).injective
          change (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I)
              ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I).symm ((f s) ⊗ₜ[S] 1)) =
            (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I)
              (Ideal.Quotient.mk (Ideal.map f I) (f s))
          rw [AlgEquiv.apply_symm_apply]
          rfl
        rw [he₂]
        rfl
      rw [hcomp]
      exact RingHom.Etale.stableUnderComposition g₀ e_iso.toRingHom hg₀Et
        (RingHom.Etale.of_bijective e_iso.bijective)
    let I_D : Ideal B'' := Ideal.span {β a}
    have hMapA : Ideal.map β (Ideal.span {a}) = I_D := by
      rw [Ideal.map_span, Set.image_singleton]
    have hMapP : Ideal.map ψ (Ideal.span {p}) = I_D := by
      rw [Ideal.map_span, Set.image_singleton, ← hEq]
    have hleA : Ideal.span {a} ≤ Ideal.comap β I_D := Ideal.map_le_iff_le_comap.mp hMapA.le
    have hleP : Ideal.span {p} ≤ Ideal.comap ψ I_D := Ideal.map_le_iff_le_comap.mp hMapP.le
    let D : CommRingCat.{u} := CommRingCat.of (B'' ⧸ I_D)
    let e_A : CommRingCat.of (A ⧸ Ideal.span {a}) ⟶ D :=
      CommRingCat.ofHom (Ideal.quotientMap I_D β hleA)
    let e_P : CommRingCat.of (P ⧸ Ideal.span {p}) ⟶ D :=
      CommRingCat.ofHom (Ideal.quotientMap I_D ψ hleP)
    have heAEt : e_A.hom.Etale := hEtQuot A B'' β hβEt _ _ hMapA hleA
    have hePEt : e_P.hom.Etale := hEtQuot P B'' ψ hψEt _ _ hMapP hleP
    have hID_le : I_D ≤ Q''.asIdeal := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr haQ)
    have : Q''.asIdeal.IsPrime := Q''.isPrime
    have hv_prime : (Ideal.map (Ideal.Quotient.mk I_D) Q''.asIdeal).IsPrime :=
      Ideal.isPrime_map_quotientMk_of_isPrime hID_le
    let v₀ : PrimeSpectrum D := ⟨Ideal.map (Ideal.Quotient.mk I_D) Q''.asIdeal, hv_prime⟩
    have hv_comap : v₀.asIdeal.comap (Ideal.Quotient.mk I_D) = Q''.asIdeal := by
      change (Ideal.map (Ideal.Quotient.mk I_D) Q''.asIdeal).comap (Ideal.Quotient.mk I_D) = Q''.asIdeal
      rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I_D) Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hID_le]
    refine ⟨D, e_A, e_P, v₀, heAEt, hePEt, ?_, ?_, ?_⟩
    · apply PrimeSpectrum.ext
      ext x
      change Ideal.Quotient.mk I_D (β x) ∈ v₀.asIdeal ↔ β x ∈ Q''.asIdeal
      rw [← Ideal.mem_comap, hv_comap]
    · apply PrimeSpectrum.ext
      ext x
      change Ideal.Quotient.mk I_D (ψ x) ∈ v₀.asIdeal ↔ ψ x ∈ Q''.asIdeal
      rw [← Ideal.mem_comap, hv_comap]
    · ext r
      change Ideal.Quotient.mk I_D (β (φ_A r)) = Ideal.Quotient.mk I_D (ψ (φ_P r))
      exact congrArg (Ideal.Quotient.mk I_D) (RingHom.congr_fun hScalar r)
  intro J_h
  let R := PowerSeries Ω
  let P₂ := MvPolynomial (Fin 2) R
  let B₁ := Localization.Away s
  let ι₁ : B →+* B₁ := algebraMap B B₁
  have : Algebra.Etale B B₁ := Algebra.Etale.of_isLocalizationAway s
  have hι₁Et : ι₁.Etale := RingHom.etale_algebraMap.mpr inferInstance
  have hDisj₁ : Disjoint (Submonoid.powers s : Set B) Q.asIdeal :=
    (Ideal.disjoint_powers_iff_notMem s Q.isPrime.isRadical).mpr hsQ
  have hQ₁_prime : (Ideal.map ι₁ Q.asIdeal).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s) B₁ Q.asIdeal Q.isPrime hDisj₁
  let Q₁ : PrimeSpectrum B₁ := ⟨Ideal.map ι₁ Q.asIdeal, hQ₁_prime⟩
  have hQ₁_under : Q₁.asIdeal.comap ι₁ = Q.asIdeal :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s) B₁ Q.isPrime hDisj₁
  have hCu₀_Q : φ_P (MvPolynomial.C u₀) ∈ Q.asIdeal := by
    change u₀ ∈ Q.asIdeal.comap (φ_P.comp MvPolynomial.C)
    rwa [hQcomap]
  have hCv₀_Q : φ_P (MvPolynomial.C v₀) ∈ Q.asIdeal := by
    change v₀ ∈ Q.asIdeal.comap (φ_P.comp MvPolynomial.C)
    rwa [hQcomap]
  have hU_Q : φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀) ∈ Q.asIdeal := by
    rw [map_sub]
    exact Q.asIdeal.sub_mem (hXi 0) hCu₀_Q
  have hV_Q : φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀) ∈ Q.asIdeal := by
    rw [map_sub]
    exact Q.asIdeal.sub_mem (hXi 1) hCv₀_Q
  have hX_max : (PowerSeries.X : R) ∈ IsLocalRing.maximalIdeal R := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hUnit
    have hmap := hUnit.map (PowerSeries.constantCoeff : R →+* Ω)
    simp at hmap
  have hX_Q : φ_P (MvPolynomial.C (PowerSeries.X : R)) ∈ Q.asIdeal := by
    change (PowerSeries.X : R) ∈ Q.asIdeal.comap (φ_P.comp MvPolynomial.C)
    rwa [hQcomap]
  obtain ⟨B', instB', α, Q', c₀₀, c₀₁, c₁₀, c₁₁, hαEt, hQ'Q₁, hc₀₀, hc₀₁, hc₁₀, hc₁₁, hUnivQuad⟩ :=
    h_s2 B₁ Q₁ A₂₀ A₁₁ A₀₂ hA₂₀ hA₀₂ hA₁₁
  letI : CommRing B' := instB'
  let φ_s : P₂ →+* B₁ := ι₁.comp φ_P
  let φ_old : P₂ →+* B' := α.comp φ_s
  have hφoldEt : φ_old.Etale :=
    RingHom.Etale.stableUnderComposition φ_s α
      (RingHom.Etale.stableUnderComposition φ_P ι₁ hφEt hι₁Et) hαEt
  have hQ'_under_B : Q'.asIdeal.comap (α.comp ι₁) = Q.asIdeal := by
    have h1 : Q'.asIdeal.comap α = Q₁.asIdeal := congrArg PrimeSpectrum.asIdeal hQ'Q₁
    rw [← Ideal.comap_comap, h1, hQ₁_under]
  have hU' : φ_old (MvPolynomial.X 0 - MvPolynomial.C u₀) ∈ Q'.asIdeal := by
    change φ_P (MvPolynomial.X 0 - MvPolynomial.C u₀) ∈ Q'.asIdeal.comap (α.comp ι₁)
    rwa [hQ'_under_B]
  have hV' : φ_old (MvPolynomial.X 1 - MvPolynomial.C v₀) ∈ Q'.asIdeal := by
    change φ_P (MvPolynomial.X 1 - MvPolynomial.C v₀) ∈ Q'.asIdeal.comap (α.comp ι₁)
    rwa [hQ'_under_B]
  have hDet : c₀₀ * c₁₁ - c₀₁ * c₁₀ ∉ Q'.asIdeal := by
    have h_add1 : (c₀₀ * c₁₁ - c₀₁ * c₁₀) + 1 ∈ Q'.asIdeal := by
      have h_eq : (c₀₀ * c₁₁ - c₀₁ * c₁₀) + 1 =
          c₀₀ * c₁₁ - (c₀₁ - 1) * (c₁₀ - 1) - (c₀₁ - 1) - (c₁₀ - 1) := by ring
      rw [h_eq]
      exact Q'.asIdeal.sub_mem
        (Q'.asIdeal.sub_mem
          (Q'.asIdeal.sub_mem (Q'.asIdeal.mul_mem_left _ hc₁₁) (Q'.asIdeal.mul_mem_left _ hc₁₀))
          hc₀₁)
        hc₁₀
    intro hmem
    have h1 : (1 : B') ∈ Q'.asIdeal := by
      have h_eq : (1 : B') = ((c₀₀ * c₁₁ - c₀₁ * c₁₀) + 1) - (c₀₀ * c₁₁ - c₀₁ * c₁₀) := by ring
      rw [h_eq]
      exact Q'.asIdeal.sub_mem h_add1 hmem
    exact Q'.isPrime.ne_top (Q'.asIdeal.eq_top_iff_one.mpr h1)
  obtain ⟨B'', instB'', γ, Q'', ψ_P, hγEt, hψEt, hQ''Q', hψC, hψX0, hψX1⟩ :=
    h_s3 R B' φ_old hφoldEt Q' u₀ v₀ c₀₀ c₀₁ c₁₀ c₁₁ hU' hV' hDet
  letI : CommRing B'' := instB''
  let β : B →+* B'' := γ.comp (α.comp ι₁)
  have hβEt : β.Etale :=
    RingHom.Etale.stableUnderComposition (α.comp ι₁) γ
      (RingHom.Etale.stableUnderComposition ι₁ α hι₁Et hαEt) hγEt
  have hβ_under : Q''.asIdeal.comap β = Q.asIdeal := by
    have h1 : Q''.asIdeal.comap γ = Q'.asIdeal := congrArg PrimeSpectrum.asIdeal hQ''Q'
    change Q''.asIdeal.comap (γ.comp (α.comp ι₁)) = Q.asIdeal
    rw [← Ideal.comap_comap, h1, hQ'_under_B]
  have hβQ'' : PrimeSpectrum.comap β Q'' = Q := PrimeSpectrum.ext hβ_under
  have hScalar : β.comp (φ_P.comp MvPolynomial.C) = ψ_P.comp MvPolynomial.C := by
    rw [hψC]
    rfl
  let U' : B' := φ_old (MvPolynomial.X 0 - MvPolynomial.C u₀)
  let V' : B' := φ_old (MvPolynomial.X 1 - MvPolynomial.C v₀)
  have hEq : β F = ψ_P (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) := by
    have hrhs : ψ_P (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) =
        γ ((c₀₀ * U' + c₀₁ * V') * (c₁₀ * U' + c₁₁ * V') - α (φ_s (MvPolynomial.C h))) := by
      rw [map_sub, map_mul, hψX0, hψX1]
      have hCh : ψ_P (MvPolynomial.C h) = γ (α (φ_s (MvPolynomial.C h))) :=
        RingHom.congr_fun hψC h
      rw [hCh, ← map_mul, ← map_sub]
    rw [hrhs, hUnivQuad U' V']
    have hQuad_α :
        α A₂₀ * U' ^ 2 + α A₁₁ * U' * V' + α A₀₂ * V' ^ 2 =
          α (ι₁ F + φ_s (MvPolynomial.C h)) := by
      calc α A₂₀ * U' ^ 2 + α A₁₁ * U' * V' + α A₀₂ * V' ^ 2
          = α (A₂₀ * φ_s (MvPolynomial.X 0 - MvPolynomial.C u₀) ^ 2 +
              A₁₁ * φ_s (MvPolynomial.X 0 - MvPolynomial.C u₀) *
                φ_s (MvPolynomial.X 1 - MvPolynomial.C v₀) +
              A₀₂ * φ_s (MvPolynomial.X 1 - MvPolynomial.C v₀) ^ 2) := by
            simp only [U', V', φ_old, RingHom.comp_apply, map_add, map_mul, map_pow]
        _ = α (ι₁ F + φ_s (MvPolynomial.C h)) := congrArg α hQuad.symm
    rw [hQuad_α, map_add, add_sub_cancel_right]
    rfl
  have hβFQ : β F ∈ Q''.asIdeal := by
    change F ∈ Q''.asIdeal.comap β
    rwa [hβ_under]
  obtain ⟨D, e_BF, e_Nh, v_D, heBFEt, heNhEt, hvBF, hvNh, heComm⟩ :=
    h_s4 R B P₂ B'' (φ_P.comp MvPolynomial.C) MvPolynomial.C β ψ_P
      F (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) Q''
      hβEt hψEt hScalar hEq hβFQ
  refine ⟨D, e_BF, e_Nh, v_D, heBFEt, heNhEt, hvBF.trans hβQ'', ?_, ?_, heComm⟩
  · rw [Fin.forall_fin_two]
    have hvNh_id :
        (PrimeSpectrum.comap e_Nh.hom v_D).asIdeal.comap (Ideal.Quotient.mk J_h) =
          Q''.asIdeal.comap ψ_P :=
      congrArg PrimeSpectrum.asIdeal hvNh
    have hQ''Q'_id : Q''.asIdeal.comap γ = Q'.asIdeal := congrArg PrimeSpectrum.asIdeal hQ''Q'
    refine ⟨?_, ?_⟩
    · change MvPolynomial.X 0 ∈
        (PrimeSpectrum.comap e_Nh.hom v_D).asIdeal.comap (Ideal.Quotient.mk J_h)
      rw [hvNh_id, Ideal.mem_comap, hψX0, ← Ideal.mem_comap, hQ''Q'_id]
      exact Q'.asIdeal.add_mem (Q'.asIdeal.mul_mem_left _ hU') (Q'.asIdeal.mul_mem_left _ hV')
    · change MvPolynomial.X 1 ∈
        (PrimeSpectrum.comap e_Nh.hom v_D).asIdeal.comap (Ideal.Quotient.mk J_h)
      rw [hvNh_id, Ideal.mem_comap, hψX1, ← Ideal.mem_comap, hQ''Q'_id]
      exact Q'.asIdeal.add_mem (Q'.asIdeal.mul_mem_left _ hU') (Q'.asIdeal.mul_mem_left _ hV')
  · have hvNh_id :
        (PrimeSpectrum.comap e_Nh.hom v_D).asIdeal.comap (Ideal.Quotient.mk J_h) =
          Q''.asIdeal.comap ψ_P :=
      congrArg PrimeSpectrum.asIdeal hvNh
    change MvPolynomial.C (PowerSeries.X : R) ∈
      (PrimeSpectrum.comap e_Nh.hom v_D).asIdeal.comap (Ideal.Quotient.mk J_h)
    rw [hvNh_id, Ideal.mem_comap]
    have hX_ψ : ψ_P (MvPolynomial.C (PowerSeries.X : R)) =
        β (φ_P (MvPolynomial.C (PowerSeries.X : R))) :=
      (RingHom.congr_fun hScalar (PowerSeries.X : R)).symm
    rw [hX_ψ, ← Ideal.mem_comap, hβ_under]
    exact hX_Q

theorem weil_powerSeries_etale_ch_roof_to_nodalRoof (Ω : Type u) [Field Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (hSmK : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.snd g
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))))
    (x : C)
    (h : PowerSeries Ω)
    (hh : h ∈ IsLocalRing.maximalIdeal (PowerSeries Ω))
    (D : CommRingCat.{u})
    (v₀ : AlgebraicGeometry.Spec D)
    (e_C : AlgebraicGeometry.Spec D ⟶ C)
    (q : AlgebraicGeometry.Spec D ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})))
    (heEt : AlgebraicGeometry.Etale e_C)
    (hqEt : AlgebraicGeometry.Etale q)
    (hv₀ : e_C.base v₀ = x)
    (hXi : ∀ i : Fin 2,
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})
        (MvPolynomial.X i) ∈ (q.base v₀).asIdeal)
    (hX : Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})
      (MvPolynomial.C (PowerSeries.X : PowerSeries Ω)) ∈ (q.base v₀).asIdeal)
    (hComm : e_C ≫ g =
      q ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h})).comp
          MvPolynomial.C))) :
    ∃ m : ℕ, HasPowerSeriesNodalRoofAt Ω g x m :=
by
  have hs2 : ∀ (R₀ : Type u) [CommRing R₀]
      (A S : CommRingCat.{u})
      (φ_A : CommRingCat.of R₀ ⟶ A)
      (φ_AS : A ⟶ S)
      (e_NS : CommRingCat.of (MvPolynomial (Fin 2) R₀ ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) ⟶ S)
      (P : Ideal S),
      P.IsPrime →
      φ_A.hom.Etale →
      RingHom.IsStandardSmoothOfRelativeDimension 1 φ_AS.hom →
      e_NS.hom.Etale →
      φ_A ≫ φ_AS =
        CommRingCat.ofHom ((Ideal.Quotient.mk
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})).comp MvPolynomial.C) ≫ e_NS →
      (∀ i : Fin 2,
        e_NS.hom (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
          (MvPolynomial.X i)) ∈ P) →
      False := by
    intro R₀ _ A S φ_A φ_AS e_NS P hPrime hEtA hSmAS hEtNS hSq hXP
    let P₂ := MvPolynomial (Fin 2) R₀
    let J₀ : Ideal P₂ := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let N₀ := P₂ ⧸ J₀
    have : P.IsPrime := hPrime
    let L := ↥S ⧸ P
    let mkP : ↥S →+* L := Ideal.Quotient.mk P
    have : IsDomain L := Ideal.Quotient.isDomain P
    have : Nontrivial ↥S := mkP.domain_nontrivial
    letI : Algebra R₀ ↥A := φ_A.hom.toAlgebra
    letI : Algebra ↥A ↥S := φ_AS.hom.toAlgebra
    letI : Algebra R₀ ↥S := (φ_A ≫ φ_AS).hom.toAlgebra
    have : IsScalarTower R₀ ↥A ↥S := IsScalarTower.of_algebraMap_eq' rfl
    letI : Algebra N₀ ↥S := e_NS.hom.toAlgebra
    have hAlgNS : algebraMap R₀ ↥S = (algebraMap N₀ ↥S).comp (algebraMap R₀ N₀) := by
      ext r
      exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hSq) r
    have : IsScalarTower R₀ N₀ ↥S := IsScalarTower.of_algebraMap_eq' hAlgNS
    have : IsScalarTower R₀ ↥S L := inferInstance
    have : IsScalarTower ↥A ↥S L := inferInstance
    have : IsScalarTower N₀ ↥S L := inferInstance
    have : IsScalarTower R₀ N₀ L :=
      ⟨fun r y z => by
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective z
        exact congrArg mkP (smul_assoc r y s)⟩
    letI : Algebra P₂ L := ((algebraMap N₀ L).comp (Ideal.Quotient.mk J₀)).toAlgebra
    have : IsScalarTower R₀ P₂ L :=
      ⟨fun r p z => by
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective z
