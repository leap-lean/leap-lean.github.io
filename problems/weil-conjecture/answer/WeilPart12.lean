                  (S := ↑Γ(E_sch, f_E ⁻¹ᵁ U₀)) p_y hKer_le
              exact hExPrime ⟨Q, hQ_prime, hQ_over⟩
            obtain ⟨c, hc_ker, hc_not_py⟩ := Set.not_subset.mp hNotKer
            have hc_Is : c ∈ I_s := ⟨0, by
              have hφc : φ₀ c = 0 := hc_ker
              rw [hφc, zero_mul, map_zero]⟩
            exact hc_not_py (hIs_le hc_Is)
        have h1_mem : (1 : ↑Γ(C₀, U₀)) ∈ I_s := hIs_top ▸ trivial
        obtain ⟨a, ha⟩ := h1_mem
        exact ⟨a, by rw [← ha, map_one, one_mul]⟩
      · have hV_bot : f_E ⁻¹ᵁ U₀ = ⊥ := by
          ext x
          exact ⟨fun hx => False.elim (hNE ⟨⟨x, hx⟩⟩), False.elim⟩
        have : Subsingleton ↑Γ(E_sch, f_E ⁻¹ᵁ U₀) := by
          rw [hV_bot]
          infer_instance
        exact fun s => ⟨0, Subsingleton.elim _ _⟩

  
  let Y_res := CategoryTheory.Limits.pullback g_res s_Ω
  let C₀ := CategoryTheory.Limits.pullback g s_Ω
  let fst_res := CategoryTheory.Limits.pullback.fst g_res s_Ω
  let snd_res := CategoryTheory.Limits.pullback.snd g_res s_Ω
  let fst₀ := CategoryTheory.Limits.pullback.fst g s_Ω
  let snd₀ := CategoryTheory.Limits.pullback.snd g s_Ω
  have h3n : 3 ≤ n := hStab.1
  have hProp_g : AlgebraicGeometry.IsProper g := hStab.2.2.1
  obtain ⟨hConn_C₀, hGeom_C₀, hStab_C₀⟩ := hStab.2.2.2.2.2.2.2.2 Ω s_Ω
  obtain ⟨_hInt_res, _hFlat_res, hProp_res, _hLFP_res, _hSurj_res, _hSmK_res,
    hSec_res, _hDisj_res, _hSecSm_res, hq_g, hq_τ, hq_prop, _hq_surj,
    _hq_app, _hq_conn, hZ_fin, hZ_pts, ⟨U_iso, hU_eq, hq_iso⟩, hZ_exc,
    _hPts_inj, _hMults, _hOutside⟩ := hTerm

  let q₀ : Y_res ⟶ C₀ :=
    CategoryTheory.Limits.pullback.lift (fst_res ≫ q_res) snd_res (by
      rw [CategoryTheory.Category.assoc, hq_g, CategoryTheory.Limits.pullback.condition])
  have hq₀_fst : q₀ ≫ fst₀ = fst_res ≫ q_res :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq₀_snd : q₀ ≫ snd₀ = snd_res :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hq₀_fst_pt : ∀ q : ↥Y_res, fst₀ (q₀ q) = q_res (fst_res q) := by
    intro q
    rw [← Scheme.Hom.comp_apply, hq₀_fst, Scheme.Hom.comp_apply]
  have hPb_outer : CategoryTheory.IsPullback fst_res (q₀ ≫ snd₀) (q_res ≫ g) s_Ω := by
    rw [hq₀_snd, hq_g]
    exact CategoryTheory.IsPullback.of_hasPullback g_res s_Ω
  have hPb_bot : CategoryTheory.IsPullback fst₀ snd₀ g s_Ω :=
    CategoryTheory.IsPullback.of_hasPullback g s_Ω
  have hPb_res : CategoryTheory.IsPullback fst_res snd_res g_res s_Ω :=
    CategoryTheory.IsPullback.of_hasPullback g_res s_Ω
  have hPb_q₀ : CategoryTheory.IsPullback fst_res q₀ q_res fst₀ :=
    CategoryTheory.IsPullback.of_bot hPb_outer hq₀_fst.symm hPb_bot
  have hProp_q₀ : AlgebraicGeometry.IsProper q₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_q₀ hq_prop
  have hProp_snd₀ : AlgebraicGeometry.IsProper snd₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bot hProp_g
  have hProp_snd_res : AlgebraicGeometry.IsProper snd_res :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_res hProp_res
  have hSurj_coeff : Function.Surjective (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) :=
    fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩
  have hCl_sΩ : AlgebraicGeometry.IsClosedImmersion s_Ω :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)) hSurj_coeff
  have hCl_fst₀ : AlgebraicGeometry.IsClosedImmersion fst₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bot.flip hCl_sΩ
  have hCl_fst_res : AlgebraicGeometry.IsClosedImmersion fst_res :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_res.flip hCl_sΩ

  have hFin_C₀ : (irreducibleComponents ↥C₀).Finite := by
    have : AlgebraicGeometry.IsLocallyNoetherian C₀ :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian snd₀
    have : CompactSpace ↥C₀ :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace snd₀
    have : AlgebraicGeometry.IsNoetherian C₀ := AlgebraicGeometry.IsNoetherian.mk
    exact AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
  have hFin_Y : (irreducibleComponents ↥Y_res).Finite := by
    have : AlgebraicGeometry.IsLocallyNoetherian Y_res :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian snd_res
    have : CompactSpace ↥Y_res :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace snd_res
    have : AlgebraicGeometry.IsNoetherian Y_res := AlgebraicGeometry.IsNoetherian.mk
    exact AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian

  let W_iso : C_res.Opens := q_res ⁻¹ᵁ U_iso
  let e_iso : W_iso.toScheme ≅ U_iso.toScheme :=
    @CategoryTheory.asIso _ _ _ _ (q_res ∣_ U_iso) hq_iso
  have he_hom_ι : e_iso.hom ≫ U_iso.ι = W_iso.ι ≫ q_res :=
    AlgebraicGeometry.morphismRestrict_ι q_res U_iso
  have he_inv_q : e_iso.inv ≫ W_iso.ι ≫ q_res = U_iso.ι := by
    rw [← he_hom_ι, CategoryTheory.Iso.inv_hom_id_assoc]
  have hq_res_inj_W : ∀ z₁ z₂ : ↥C_res,
      q_res z₁ ∈ U_iso → q_res z₁ = q_res z₂ → z₁ = z₂ := by
    intro z₁ z₂ hz₁ heq
    have hz₂ : q_res z₂ ∈ U_iso := heq ▸ hz₁
    let p₁ : ↥W_iso.toScheme := ⟨z₁, hz₁⟩
    let p₂ : ↥W_iso.toScheme := ⟨z₂, hz₂⟩
    have hp₁ : U_iso.ι (e_iso.hom p₁) = q_res z₁ := by
      rw [← Scheme.Hom.comp_apply, he_hom_ι, Scheme.Hom.comp_apply]
      rfl
    have hp₂ : U_iso.ι (e_iso.hom p₂) = q_res z₂ := by
      rw [← Scheme.Hom.comp_apply, he_hom_ι, Scheme.Hom.comp_apply]
      rfl
    have he_eq : e_iso.hom p₁ = e_iso.hom p₂ :=
      U_iso.ι.isOpenEmbedding.injective (hp₁.trans (heq.trans hp₂.symm))
    have hp_eq : p₁ = p₂ := by
      have h1' : e_iso.inv (e_iso.hom p₁) = p₁ := by simp
      have h2' : e_iso.inv (e_iso.hom p₂) = p₂ := by simp
      rw [← h1', he_eq, h2']
    exact congrArg W_iso.ι hp_eq

  let U_iso₀ : C₀.Opens := fst₀ ⁻¹ᵁ U_iso
  let W_iso₀ : Y_res.Opens := q₀ ⁻¹ᵁ U_iso₀
  have hCl_compl : ∀ y : ↥C₀, y ∉ U_iso₀ → IsClosed ({y} : Set ↥C₀) := by
    intro y hy
    have hx_not_U : fst₀ y ∉ (U_iso : Set C) := hy
    rw [hU_eq, Set.mem_compl_iff, not_not] at hx_not_U
    have hx_cl : IsClosed ({fst₀ y} : Set C) := (hZ_pts (fst₀ y) hx_not_U).1
    have hpre : fst₀ ⁻¹' ({fst₀ y} : Set C) = ({y} : Set ↥C₀) := by
      ext y'
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => fst₀.isClosedEmbedding.injective h, fun h => h ▸ rfl⟩
    rw [← hpre]
    exact hx_cl.preimage fst₀.continuous

  have hq₀_iso : CategoryTheory.IsIso (q₀ ∣_ U_iso₀) := by
    have hRange_U₀ : Set.range (U_iso₀.ι ≫ fst₀) ⊆ Set.range U_iso.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨u, rfl⟩
      exact u.2
    let α_U := AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι (U_iso₀.ι ≫ fst₀) hRange_U₀
    have hα_U : α_U ≫ U_iso.ι = U_iso₀.ι ≫ fst₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι (U_iso₀.ι ≫ fst₀) hRange_U₀
    have hRange_W₀ : Set.range (W_iso₀.ι ≫ fst_res) ⊆ Set.range W_iso.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      show q_res (fst_res w.1) ∈ U_iso
      rw [← hq₀_fst_pt w.1]
      exact w.2
    let α_W := AlgebraicGeometry.IsOpenImmersion.lift W_iso.ι (W_iso₀.ι ≫ fst_res) hRange_W₀
    have hα_W : α_W ≫ W_iso.ι = W_iso₀.ι ≫ fst_res :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_iso.ι (W_iso₀.ι ≫ fst_res) hRange_W₀
    have hβ_cond : (α_U ≫ e_iso.inv ≫ W_iso.ι) ≫ g_res = (U_iso₀.ι ≫ snd₀) ≫ s_Ω := by
      calc (α_U ≫ e_iso.inv ≫ W_iso.ι) ≫ g_res
          = α_U ≫ (e_iso.inv ≫ W_iso.ι ≫ q_res) ≫ g := by
              rw [← hq_g]
              simp only [CategoryTheory.Category.assoc]
        _ = (α_U ≫ U_iso.ι) ≫ g := by rw [he_inv_q, CategoryTheory.Category.assoc]
        _ = U_iso₀.ι ≫ (fst₀ ≫ g) := by rw [hα_U, CategoryTheory.Category.assoc]
        _ = (U_iso₀.ι ≫ snd₀) ≫ s_Ω := by
              rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
    let β_lift : U_iso₀.toScheme ⟶ Y_res :=
      CategoryTheory.Limits.pullback.lift (α_U ≫ e_iso.inv ≫ W_iso.ι) (U_iso₀.ι ≫ snd₀) hβ_cond
    have hβ_q₀ : β_lift ≫ q₀ = U_iso₀.ι := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hq₀_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_inv_q, hα_U]
      · rw [CategoryTheory.Category.assoc, hq₀_snd,
          CategoryTheory.Limits.pullback.lift_snd]
    have hRange_β : Set.range β_lift ⊆ Set.range W_iso₀.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨u, rfl⟩
      show q₀ (β_lift u) ∈ U_iso₀
      have h2 : q₀ (β_lift u) = u.1 := by
        rw [← Scheme.Hom.comp_apply, hβ_q₀]
        rfl
      rw [h2]
      exact u.2
    let w₀ := AlgebraicGeometry.IsOpenImmersion.lift W_iso₀.ι β_lift hRange_β
    have hw₀ : w₀ ≫ W_iso₀.ι = β_lift :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_iso₀.ι β_lift hRange_β
    refine ⟨⟨w₀, ?_, ?_⟩⟩
    · apply (cancel_mono W_iso₀.ι).mp
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hw₀]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        have h_mono : ((q₀ ∣_ U_iso₀) ≫ α_U ≫ e_iso.inv) ≫ e_iso.hom ≫ U_iso.ι =
            α_W ≫ e_iso.hom ≫ U_iso.ι := by
          calc ((q₀ ∣_ U_iso₀) ≫ α_U ≫ e_iso.inv) ≫ e_iso.hom ≫ U_iso.ι
              = (q₀ ∣_ U_iso₀) ≫ α_U ≫ (e_iso.inv ≫ e_iso.hom) ≫ U_iso.ι := by
                  simp only [CategoryTheory.Category.assoc]
            _ = (q₀ ∣_ U_iso₀) ≫ α_U ≫ U_iso.ι := by
                  rw [e_iso.inv_hom_id, CategoryTheory.Category.id_comp]
            _ = ((q₀ ∣_ U_iso₀) ≫ U_iso₀.ι) ≫ fst₀ := by
                  rw [hα_U, CategoryTheory.Category.assoc]
            _ = W_iso₀.ι ≫ q₀ ≫ fst₀ := by
                  rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
            _ = (W_iso₀.ι ≫ fst_res) ≫ q_res := by
                  rw [hq₀_fst, CategoryTheory.Category.assoc]
            _ = α_W ≫ e_iso.hom ≫ U_iso.ι := by
                  rw [← hα_W, CategoryTheory.Category.assoc, he_hom_ι]
        have h_eq1 : ((q₀ ∣_ U_iso₀) ≫ α_U ≫ e_iso.inv) ≫ e_iso.hom = α_W ≫ e_iso.hom := by
          apply (cancel_mono U_iso.ι).mp
          simpa only [CategoryTheory.Category.assoc] using h_mono
        have h_eq2 : (q₀ ∣_ U_iso₀) ≫ α_U ≫ e_iso.inv = α_W :=
          (cancel_mono e_iso.hom).mp h_eq1
        calc (q₀ ∣_ U_iso₀) ≫ α_U ≫ e_iso.inv ≫ W_iso.ι
            = ((q₀ ∣_ U_iso₀) ≫ α_U ≫ e_iso.inv) ≫ W_iso.ι := by
                simp only [CategoryTheory.Category.assoc]
          _ = α_W ≫ W_iso.ι := by rw [h_eq2]
          _ = W_iso₀.ι ≫ fst_res := hα_W
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, hq₀_snd]
    · apply (cancel_mono U_iso₀.ι).mp
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc, hw₀, hβ_q₀]

  let e₀ : W_iso₀.toScheme ≅ U_iso₀.toScheme :=
    @CategoryTheory.asIso _ _ _ _ (q₀ ∣_ U_iso₀) hq₀_iso
  have he₀_hom_ι : e₀.hom ≫ U_iso₀.ι = W_iso₀.ι ≫ q₀ :=
    AlgebraicGeometry.morphismRestrict_ι q₀ U_iso₀
  have he₀_inv_q : e₀.inv ≫ W_iso₀.ι ≫ q₀ = U_iso₀.ι := by
    rw [← he₀_hom_ι, CategoryTheory.Iso.inv_hom_id_assoc]
  have hq₀_inj_W : ∀ w₁ w₂ : ↥Y_res,
      q₀ w₁ ∈ U_iso₀ → q₀ w₁ = q₀ w₂ → w₁ = w₂ := by
    intro w₁ w₂ hw₁ heq
    have hw₂ : q₀ w₂ ∈ U_iso₀ := heq ▸ hw₁
    let p₁ : ↥W_iso₀.toScheme := ⟨w₁, hw₁⟩
    let p₂ : ↥W_iso₀.toScheme := ⟨w₂, hw₂⟩
    have hp₁ : U_iso₀.ι (e₀.hom p₁) = q₀ w₁ := by
      rw [← Scheme.Hom.comp_apply, he₀_hom_ι, Scheme.Hom.comp_apply]
      rfl
    have hp₂ : U_iso₀.ι (e₀.hom p₂) = q₀ w₂ := by
      rw [← Scheme.Hom.comp_apply, he₀_hom_ι, Scheme.Hom.comp_apply]
      rfl
    have he_eq : e₀.hom p₁ = e₀.hom p₂ :=
      U_iso₀.ι.isOpenEmbedding.injective (hp₁.trans (heq.trans hp₂.symm))
    have hp_eq : p₁ = p₂ := by
      have h1' : e₀.inv (e₀.hom p₁) = p₁ := by simp
      have h2' : e₀.inv (e₀.hom p₂) = p₂ := by simp
      rw [← h1', he_eq, h2']
    exact congrArg W_iso₀.ι hp_eq

  have hOpenPullbackIrred : ∀ (F₁ : Set ↥C₀),
      IsIrreducible F₁ → (∃ y₀ ∈ F₁, y₀ ∈ U_iso₀) →
      IsIrreducible (q₀ ⁻¹' F₁ ∩ (W_iso₀ : Set ↥Y_res)) ∧
        F₁ ∩ (U_iso₀ : Set ↥C₀) ⊆ q₀ '' (q₀ ⁻¹' F₁ ∩ (W_iso₀ : Set ↥Y_res)) := by
    intro F₁ hF₁ ⟨y₀, hy₀_F, hy₀_U⟩
    let F_U : Set ↥U_iso₀.toScheme := U_iso₀.ι ⁻¹' F₁
    have hFU_ne : F_U.Nonempty := ⟨⟨y₀, hy₀_U⟩, hy₀_F⟩
    have hFU_pre : IsPreirreducible F_U := by
      intro V₁ V₂ hV₁ hV₂ ⟨u₁, hu₁F, hu₁V⟩ ⟨u₂, hu₂F, hu₂V⟩
      have hOpen₁ : IsOpen (U_iso₀.ι '' V₁) := U_iso₀.ι.isOpenEmbedding.isOpenMap V₁ hV₁
      have hOpen₂ : IsOpen (U_iso₀.ι '' V₂) := U_iso₀.ι.isOpenEmbedding.isOpenMap V₂ hV₂
      obtain ⟨y, hyF, ⟨v₁, hv₁, rfl⟩, ⟨v₂, hv₂, hv_eq⟩⟩ :=
        hF₁.2 (U_iso₀.ι '' V₁) (U_iso₀.ι '' V₂) hOpen₁ hOpen₂
          ⟨U_iso₀.ι u₁, hu₁F, u₁, hu₁V, rfl⟩
          ⟨U_iso₀.ι u₂, hu₂F, u₂, hu₂V, rfl⟩
      have hv12 : v₂ = v₁ := U_iso₀.ι.isOpenEmbedding.injective hv_eq
      rw [hv12] at hv₂
      exact ⟨v₁, hyF, hv₁, hv₂⟩
    have hFU_irred : IsIrreducible F_U := ⟨hFU_ne, hFU_pre⟩
    have hG_eq : q₀ ⁻¹' F₁ ∩ (W_iso₀ : Set ↥Y_res) = (e₀.inv ≫ W_iso₀.ι) '' F_U := by
      ext w
      constructor
      · rintro ⟨hwF, hwW⟩
        let p_w : ↥W_iso₀.toScheme := ⟨w, hwW⟩
        refine ⟨e₀.hom p_w, ?_, ?_⟩
        · show U_iso₀.ι (e₀.hom p_w) ∈ F₁
          have h2 : U_iso₀.ι (e₀.hom p_w) = q₀ w := by
            rw [← Scheme.Hom.comp_apply, he₀_hom_ι, Scheme.Hom.comp_apply]
            rfl
          rwa [h2]
        · rw [Scheme.Hom.comp_apply]
          have h1 : e₀.inv (e₀.hom p_w) = p_w := by simp
          rw [h1]
          rfl
      · rintro ⟨u, huF, rfl⟩
        have hq_u : q₀ ((e₀.inv ≫ W_iso₀.ι) u) = u.1 := by
          rw [← Scheme.Hom.comp_apply (e₀.inv ≫ W_iso₀.ι) q₀, CategoryTheory.Category.assoc,
            he₀_inv_q]
          rfl
        refine ⟨?_, ?_⟩
        · show q₀ ((e₀.inv ≫ W_iso₀.ι) u) ∈ F₁
          rw [hq_u]
          exact huF
        · show q₀ ((e₀.inv ≫ W_iso₀.ι) u) ∈ U_iso₀
          rw [hq_u]
          exact u.2
    refine ⟨?_, ?_⟩
    · rw [hG_eq]
      exact hFU_irred.image _ (e₀.inv ≫ W_iso₀.ι).continuous.continuousOn
    · rintro y ⟨hyF, hyU⟩
      let u : ↥U_iso₀.toScheme := ⟨y, hyU⟩
      have hq_u : q₀ ((e₀.inv ≫ W_iso₀.ι) u) = y := by
        rw [← Scheme.Hom.comp_apply (e₀.inv ≫ W_iso₀.ι) q₀, CategoryTheory.Category.assoc,
          he₀_inv_q]
        rfl
      refine ⟨(e₀.inv ≫ W_iso₀.ι) u, ?_, hq_u⟩
      rw [hG_eq]
      exact ⟨u, hyF, rfl⟩

  
  have hCaseI : ∀ E ∈ irreducibleComponents ↥Y_res,
      ((fun q => q_res (fst_res q)) '' E) ⊆ Z_blown →
      ((fun q => q_res (fst_res q)) '' E).Subsingleton ∧
      IsTwoBridgeRationalComponent Ω n g_res τ_res E := by
    intro E hE hSub
    let S_E : Set C := (fun q => q_res (fst_res q)) '' E
    obtain ⟨q₀_E, hq₀_E⟩ := hE.1.1
    let x₀ : C := q_res (fst_res q₀_E)
    have hx₀_S : x₀ ∈ S_E := ⟨q₀_E, hq₀_E, rfl⟩
    have hx₀_Z : x₀ ∈ Z_blown := hSub hx₀_S
    have hIrred_S : IsIrreducible S_E :=
      hE.1.image _ (q_res.continuous.comp fst_res.continuous).continuousOn
    let K₂ : Set C := ⋃ x ∈ Z_blown \ {x₀}, ({x} : Set C)
    have hK₁ : IsClosed ({x₀} : Set C) := (hZ_pts x₀ hx₀_Z).1
    have hK₂ : IsClosed K₂ :=
      hZ_fin.sdiff.isClosed_biUnion (fun x hx => (hZ_pts x hx.1).1)
    have hCov : S_E ⊆ ({x₀} : Set C) ∪ K₂ := by
      intro x hx
      by_cases hx_eq : x = x₀
      · exact Or.inl hx_eq
      · exact Or.inr (Set.mem_biUnion ⟨hSub hx, hx_eq⟩ rfl)
    have hSE_single : S_E ⊆ ({x₀} : Set C) := by
      rcases hIrred_union hIrred_S hK₁ hK₂ hCov with h | h
      · exact h
      · exfalso
        have hx₀_K₂ := h hx₀_S
        simp [K₂] at hx₀_K₂
    have hSubsing : S_E.Subsingleton := fun a ha b hb =>
      (Set.mem_singleton_iff.mp (hSE_single ha)).trans
        (Set.mem_singleton_iff.mp (hSE_single hb)).symm
    let ℱ : Set (Set ↥Y_res) :=
      {F ∈ irreducibleComponents ↥Y_res | IsTwoBridgeRationalComponent Ω n g_res τ_res F}
    have hℱ_fin : ℱ.Finite := hFin_Y.subset (fun _ hF => hF.1)
    have hE_cov : E ⊆ ⋃ F ∈ ℱ, F := by
      intro q hq
      have hqx₀ : fst_res q ∈ q_res ⁻¹' {x₀} := hSE_single ⟨q, hq, rfl⟩
      obtain ⟨q', hq'_fst, F_q, hFq_2br, hq'_Fq, _⟩ :=
        hZ_exc x₀ hx₀_Z (fst_res q) hqx₀
      have hq_eq : q' = q := fst_res.isClosedEmbedding.injective hq'_fst
      rw [hq_eq] at hq'_Fq
      exact Set.mem_biUnion ⟨hFq_2br.1, hFq_2br⟩ hq'_Fq
    obtain ⟨F₀, ⟨hF₀_irred, hF₀_2br⟩, hE_sub_F₀⟩ :=
      hIrred_fin_biUnion hE.1 hℱ_fin
        (fun F hF => isClosed_of_mem_irreducibleComponents F hF.1) hE_cov
    have hF₀_eq : E = F₀ := Set.Subset.antisymm hE_sub_F₀ (hE.2 hF₀_irred.1 hE_sub_F₀)
    rw [hF₀_eq]
    exact ⟨hF₀_eq ▸ hSubsing, hF₀_2br⟩

  
  have hUncontr : ∀ (E : Set ↥Y_res)
      (E_sch : AlgebraicGeometry.Scheme.{u})
      (ιE : E_sch ⟶ Y_res),
      E ∈ irreducibleComponents ↥Y_res →
      AlgebraicGeometry.IsClosedImmersion ιE →
      AlgebraicGeometry.IsIntegral E_sch →
      Set.range ιE = E →
      ∀ (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
      ιE ≫ snd_res = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom →
      ¬(((fun q => q_res (fst_res q)) '' E) ⊆ Z_blown) →
      ∃ q₁ q₂ q₃ : ↥Y_res,
        q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
        q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
        (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y_res),
          (∃ E' ∈ irreducibleComponents ↥Y_res, E' ≠ E ∧ q ∈ E') ∨
          (∃ j : Fin n, fst_res q ∈ Set.range (τ_res j))) := by
    intro E E_sch ιE hE_mem hCl_ιE hInt_E hRange_ιE isoP1 hComm_P1 hNotSub
    obtain ⟨_, ⟨q_gen, hq_gen_E, rfl⟩, hq_gen_not_Z⟩ := Set.not_subset.mp hNotSub
    have hq_gen_U : q₀ q_gen ∈ U_iso₀ := by
      show fst₀ (q₀ q_gen) ∈ (U_iso : Set C)
      rw [hq₀_fst_pt q_gen, hU_eq]
      exact hq_gen_not_Z
    obtain ⟨u_gen, hu_gen_eq⟩ : q_gen ∈ Set.range ιE := hRange_ιE ▸ hq_gen_E
    let f_E : E_sch ⟶ C₀ := ιE ≫ q₀
    have hfu_gen_U : f_E u_gen ∈ U_iso₀ := by
      show (ιE ≫ q₀) u_gen ∈ U_iso₀
      rw [Scheme.Hom.comp_apply, hu_gen_eq]
      exact hq_gen_U
    let E_bar : Set ↥C₀ := q₀ '' E
    have hRange_fE : Set.range f_E = E_bar := by
      ext y
      simp only [Set.mem_range, E_bar, Set.mem_image, f_E, Scheme.Hom.comp_apply]
      constructor
      · rintro ⟨u, rfl⟩
        exact ⟨ιE u, hRange_ιE ▸ ⟨u, rfl⟩, rfl⟩
      · rintro ⟨q, hqE, rfl⟩
        obtain ⟨u, rfl⟩ : q ∈ Set.range ιE := hRange_ιE ▸ hqE
        exact ⟨u, rfl⟩
    have hIrred_Ebar : IsIrreducible E_bar :=
      hE_mem.1.image q₀ q₀.continuous.continuousOn
    have hCl_Ebar : IsClosed E_bar :=
      q₀.isClosedMap E (isClosed_of_mem_irreducibleComponents E hE_mem)
    have hEbar_mem : E_bar ∈ irreducibleComponents ↥C₀ := by
      refine ⟨hIrred_Ebar, ?_⟩
      intro F hF hEbar_sub_F
      let F₁ : Set ↥C₀ := closure F
      have hF₁_irred : IsIrreducible F₁ := hF.closure
      have hEbar_sub_F₁ : E_bar ⊆ F₁ := hEbar_sub_F.trans subset_closure
      obtain ⟨hG_irred, hF₁_inter_sub⟩ :=
        hOpenPullbackIrred F₁ hF₁_irred ⟨q₀ q_gen, hEbar_sub_F₁ ⟨q_gen, hq_gen_E, rfl⟩, hq_gen_U⟩
      let G_open : Set ↥Y_res := q₀ ⁻¹' F₁ ∩ (W_iso₀ : Set ↥Y_res)
      have hEW_sub_G : E ∩ (W_iso₀ : Set ↥Y_res) ⊆ G_open := by
        rintro q ⟨hqE, hqW⟩
        exact ⟨hEbar_sub_F₁ ⟨q, hqE, rfl⟩, hqW⟩
      have hE_cov : E ⊆ closure G_open ∪ (W_iso₀ : Set ↥Y_res)ᶜ := by
        intro q hqE
        by_cases hqW : q ∈ (W_iso₀ : Set ↥Y_res)
        · exact Or.inl (subset_closure (hEW_sub_G ⟨hqE, hqW⟩))
        · exact Or.inr hqW
      have hE_sub_clG : E ⊆ closure G_open := by
        rcases hIrred_union hE_mem.1 isClosed_closure W_iso₀.2.isClosed_compl hE_cov with h | h
        · exact h
        · exact False.elim (h hq_gen_E hq_gen_U)
      have hG_sub_E : G_open ⊆ E :=
        subset_closure.trans (hE_mem.2 hG_irred.closure hE_sub_clG)
      have hF₁_cov : F₁ ⊆ E_bar ∪ (U_iso₀ : Set ↥C₀)ᶜ := by
        intro y hyF₁
        by_cases hyU : y ∈ (U_iso₀ : Set ↥C₀)
        · exact Or.inl ((hF₁_inter_sub ⟨hyF₁, hyU⟩).elim fun q ⟨hqG, hqy⟩ => ⟨q, hG_sub_E hqG, hqy⟩)
        · exact Or.inr hyU
      have hF₁_sub_Ebar : F₁ ⊆ E_bar := by
        rcases hIrred_union hF₁_irred hCl_Ebar U_iso₀.2.isClosed_compl hF₁_cov with h | h
        · exact h
        · exact False.elim (h (hEbar_sub_F₁ ⟨q_gen, hq_gen_E, rfl⟩) hq_gen_U)
      exact subset_closure.trans hF₁_sub_Ebar

    have hExt_nonU : ∀ q ∈ E, q₀ q ∉ U_iso₀ →
        ∃ E' ∈ irreducibleComponents ↥Y_res, E' ≠ E ∧ q ∈ E' := by
      intro q hqE hq_not_U
      have hx_not_U : q_res (fst_res q) ∉ (U_iso : Set C) := by
        rw [← hq₀_fst_pt q]
        exact hq_not_U
      rw [hU_eq, Set.mem_compl_iff, not_not] at hx_not_U
      obtain ⟨q', hq'_fst, E', hE'_2br, hq'_E', hE'_sub⟩ :=
        hZ_exc (q_res (fst_res q)) hx_not_U (fst_res q) rfl
      have hq_eq : q' = q := fst_res.isClosedEmbedding.injective hq'_fst
      rw [hq_eq] at hq'_E'
      refine ⟨E', hE'_2br.1, ?_, hq'_E'⟩
      intro hEq
      rw [hEq] at hE'_sub
      apply hNotSub
      rintro _ ⟨w, hwE, rfl⟩
      have hw_eq : q_res (fst_res w) = q_res (fst_res q) :=
        hE'_sub ⟨w, hwE, rfl⟩ ⟨q, hqE, rfl⟩
      dsimp only
      rwa [hw_eq]

    have hLift_sp : ∀ q ∈ E,
        ((∃ E'_bar ∈ irreducibleComponents ↥C₀, E'_bar ≠ E_bar ∧ q₀ q ∈ E'_bar) ∨
          (∃ j : Fin n, fst₀ (q₀ q) ∈ Set.range (τ j))) →
        (∃ E' ∈ irreducibleComponents ↥Y_res, E' ≠ E ∧ q ∈ E') ∨
          (∃ j : Fin n, fst_res q ∈ Set.range (τ_res j)) := by
      intro q hqE hSp
      rcases hSp with ⟨E'_bar, hE'_mem, hE'_ne, hq_E'⟩ | ⟨j, b, hjb⟩
      · by_cases hqU : q₀ q ∈ U_iso₀
        · obtain ⟨hG'_irred, hE'_inter_sub⟩ :=
            hOpenPullbackIrred E'_bar hE'_mem.1 ⟨q₀ q, hq_E', hqU⟩
          obtain ⟨E', hE'_Y, hG'_sub_E'⟩ :=
            exists_mem_irreducibleComponents_subset_of_isIrreducible _ hG'_irred
          have hq_in_E' : q ∈ E' := hG'_sub_E' ⟨hq_E', hqU⟩
          refine Or.inl ⟨E', hE'_Y, ?_, hq_in_E'⟩
          intro hEq
          rw [hEq] at hG'_sub_E'
          apply hE'_ne
          have hE'_cov : E'_bar ⊆ E_bar ∪ (U_iso₀ : Set ↥C₀)ᶜ := by
            intro y hy
            by_cases hyU : y ∈ (U_iso₀ : Set ↥C₀)
            · exact Or.inl ((hE'_inter_sub ⟨hy, hyU⟩).elim fun w ⟨hwG, hwy⟩ => ⟨w, hG'_sub_E' hwG, hwy⟩)
            · exact Or.inr hyU
          have hE'_sub_Ebar : E'_bar ⊆ E_bar := by
            rcases hIrred_union hE'_mem.1 hCl_Ebar U_iso₀.2.isClosed_compl hE'_cov with h | h
            · exact h
            · exact False.elim (h hq_E' hqU)
          exact Set.Subset.antisymm hE'_sub_Ebar (hE'_mem.2 hIrred_Ebar hE'_sub_Ebar)
        · exact Or.inl (hExt_nonU q hqE hqU)
      · right
        refine ⟨j, b, ?_⟩
        have hτ_U : τ j b ∈ U_iso := by
          change τ j b ∈ (U_iso : Set C)
          rw [hU_eq]
          intro hZ
          exact (hZ_pts (τ j b) hZ).2.2 j ⟨b, rfl⟩
        have hq_τ_b : q_res (τ_res j b) = τ j b := by
          rw [← Scheme.Hom.comp_apply, hq_τ j]
        have hq_q : q_res (fst_res q) = τ j b := by
          rw [← hq₀_fst_pt q, hjb]
        exact hq_res_inj_W (τ_res j b) (fst_res q) (hq_τ_b.symm ▸ hτ_U)
          (hq_τ_b.trans hq_q.symm)

    have hfE_inj_open : ∀ u₁ u₂ : ↥E_sch,
        f_E u₁ ∈ U_iso₀ → f_E u₁ = f_E u₂ → u₁ = u₂ := by
      intro u₁ u₂ hu₁ heq
      exact ιE.isClosedEmbedding.injective (hq₀_inj_W (ιE u₁) (ιE u₂) hu₁ heq)

    have hfE_surj_on_Uiso : ∀ (D₀ : C₀.Opens), AlgebraicGeometry.IsAffineOpen D₀ →
        D₀ ≤ U_iso₀ → Function.Surjective (f_E.app D₀).hom := by
      intro D₀ hD₀ hD₀_le
      have hRange_D : Set.range hD₀.fromSpec ⊆ Set.range U_iso₀.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hD₀.range_fromSpec]
        exact hD₀_le
      let j_D := AlgebraicGeometry.IsOpenImmersion.lift U_iso₀.ι hD₀.fromSpec hRange_D
      have hj_D : j_D ≫ U_iso₀.ι = hD₀.fromSpec :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso₀.ι hD₀.fromSpec hRange_D
      have : AlgebraicGeometry.IsOpenImmersion j_D :=
        AlgebraicGeometry.IsOpenImmersion.of_comp j_D U_iso₀.ι
      let k_D : Spec Γ(C₀, D₀) ⟶ Y_res := j_D ≫ e₀.inv ≫ W_iso₀.ι
      have : AlgebraicGeometry.IsOpenImmersion k_D := inferInstance
      have hk_q₀ : k_D ≫ q₀ = hD₀.fromSpec := by
        dsimp only [k_D]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he₀_inv_q, hj_D]
      have hk_range : k_D.opensRange = q₀ ⁻¹ᵁ D₀ := by
        ext z
        constructor
        · rintro ⟨p, rfl⟩
          show q₀ (k_D p) ∈ D₀
          have h2 : q₀ (k_D p) = hD₀.fromSpec p := by
            rw [← Scheme.Hom.comp_apply, hk_q₀]
          rw [h2]
          change hD₀.fromSpec p ∈ (D₀ : Set ↥C₀)
          rw [← hD₀.range_fromSpec]
          exact ⟨p, rfl⟩
        · intro hz
          have hz_D₀ : q₀ z ∈ Set.range hD₀.fromSpec := by
            rw [hD₀.range_fromSpec]
            exact hz
          obtain ⟨p, hp⟩ := hz_D₀
          have hk_p : q₀ (k_D p) = q₀ z := by
            have h1 : q₀ (k_D p) = hD₀.fromSpec p := by
              rw [← Scheme.Hom.comp_apply, hk_q₀]
            exact h1.trans hp
          exact ⟨p, hq₀_inj_W (k_D p) z (hk_p.symm ▸ hD₀_le hz) hk_p⟩
      have hWD₀ : AlgebraicGeometry.IsAffineOpen (q₀ ⁻¹ᵁ D₀) := by
        rw [← hk_range]
        exact AlgebraicGeometry.isAffineOpen_opensRange k_D
      have hRange_kW : Set.range k_D ⊆ Set.range hWD₀.fromSpec := by
        rw [hWD₀.range_fromSpec]
        intro z hz
        have hz' : z ∈ k_D.opensRange := hz
        rwa [hk_range] at hz'
      let m_D := AlgebraicGeometry.IsOpenImmersion.lift hWD₀.fromSpec k_D hRange_kW
      have hm_D : m_D ≫ hWD₀.fromSpec = k_D :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hWD₀.fromSpec k_D hRange_kW
      have hRange_WD_W₀ : Set.range hWD₀.fromSpec ⊆ Set.range W_iso₀.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hWD₀.range_fromSpec]
        exact fun z hz => hD₀_le hz
      let l_W := AlgebraicGeometry.IsOpenImmersion.lift W_iso₀.ι hWD₀.fromSpec hRange_WD_W₀
      have hl_W : l_W ≫ W_iso₀.ι = hWD₀.fromSpec :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac W_iso₀.ι hWD₀.fromSpec hRange_WD_W₀
      have hcomm_q₀ : Spec.map (q₀.app D₀) ≫ hD₀.fromSpec = hWD₀.fromSpec ≫ q₀ := by
        rw [q₀.app_eq_appLE]
        exact hD₀.SpecMap_appLE_fromSpec q₀ hWD₀ le_rfl
      have h_eq_W : (Spec.map (q₀.app D₀) ≫ j_D ≫ e₀.inv) ≫ e₀.hom ≫ U_iso₀.ι =
          l_W ≫ e₀.hom ≫ U_iso₀.ι := by
        calc (Spec.map (q₀.app D₀) ≫ j_D ≫ e₀.inv) ≫ e₀.hom ≫ U_iso₀.ι
            = Spec.map (q₀.app D₀) ≫ j_D ≫ (e₀.inv ≫ e₀.hom) ≫ U_iso₀.ι := by
                simp only [CategoryTheory.Category.assoc]
          _ = Spec.map (q₀.app D₀) ≫ j_D ≫ U_iso₀.ι := by
                rw [e₀.inv_hom_id, CategoryTheory.Category.id_comp]
          _ = Spec.map (q₀.app D₀) ≫ hD₀.fromSpec := by rw [hj_D]
          _ = hWD₀.fromSpec ≫ q₀ := hcomm_q₀
          _ = (l_W ≫ W_iso₀.ι) ≫ q₀ := by rw [hl_W]
          _ = l_W ≫ e₀.hom ≫ U_iso₀.ι := by rw [CategoryTheory.Category.assoc, he₀_hom_ι]
      have h_eq_lW : Spec.map (q₀.app D₀) ≫ j_D ≫ e₀.inv = l_W :=
        (cancel_mono e₀.hom).mp ((cancel_mono U_iso₀.ι).mp
          (by simpa only [CategoryTheory.Category.assoc] using h_eq_W))
      have h_spec_id : Spec.map (q₀.app D₀) ≫ m_D = 𝟙 _ := by
        apply (cancel_mono hWD₀.fromSpec).mp
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hm_D]
        calc Spec.map (q₀.app D₀) ≫ k_D
            = (Spec.map (q₀.app D₀) ≫ j_D ≫ e₀.inv) ≫ W_iso₀.ι := by
                simp only [k_D, CategoryTheory.Category.assoc]
          _ = l_W ≫ W_iso₀.ι := by rw [h_eq_lW]
          _ = hWD₀.fromSpec := hl_W
      have h_pre_id : Spec.preimage m_D ≫ q₀.app D₀ = 𝟙 _ := by
        have h1 := congrArg Spec.preimage h_spec_id
        rwa [Spec.preimage_comp, Spec.preimage_map, Spec.preimage_id] at h1
      have hSurj_q₀ : Function.Surjective (q₀.app D₀).hom := fun y =>
        ⟨(Spec.preimage m_D).hom y, by
          have h1 := congrArg (fun φ => φ.hom y) h_pre_id
          simpa using h1⟩
      have hSurj_ιE : Function.Surjective (ιE.app (q₀ ⁻¹ᵁ D₀)).hom :=
        ιE.app_surjective (q₀ ⁻¹ᵁ D₀) hWD₀
      intro z
      obtain ⟨y, hy⟩ := hSurj_ιE z
      obtain ⟨x, hx⟩ := hSurj_q₀ y
      refine ⟨x, ?_⟩
      change ((ιE ≫ q₀).app D₀).hom x = z
      rw [Scheme.Hom.comp_app]
      change (ιE.app (q₀ ⁻¹ᵁ D₀)).hom ((q₀.app D₀).hom x) = z
      rw [hx, hy]

    have hProp_fE : AlgebraicGeometry.IsProper f_E :=
      CategoryTheory.MorphismProperty.comp_mem _ ιE q₀ inferInstance hProp_q₀
    have hComm_E : f_E ≫ snd₀ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom := by
      dsimp only [f_E]
      rw [CategoryTheory.Category.assoc, hq₀_snd, hComm_P1]

    obtain ⟨hFin_fE, hAffPkg⟩ :=
      h_s2 C₀ E_sch snd₀ U_iso₀ hCl_compl f_E isoP1 hInt_E hProp_fE hComm_E
        hfE_inj_open hfE_surj_on_Uiso ⟨u_gen, hfu_gen_U⟩
    obtain ⟨hOpenNhd_gen, hClosedImm_gen⟩ :=
      h_s3 C₀ E_sch snd₀ hGeom_C₀ f_E hInt_E hFin_fE hAffPkg

    by_cases hInj : Function.Injective f_E
    · 
      have hCl_fE : AlgebraicGeometry.IsClosedImmersion f_E := hClosedImm_gen hInj
      obtain ⟨y₁, y₂, y₃, hy12, hy13, hy23, hy₁_E, hy₂_E, hy₃_E, hy_sp⟩ :=
        hStab_C₀ E_bar E_sch f_E hEbar_mem hCl_fE hInt_E hRange_fE ⟨isoP1, hComm_E⟩
      obtain ⟨q₁, hq₁_E, hq₁_y⟩ := hy₁_E
      obtain ⟨q₂, hq₂_E, hq₂_y⟩ := hy₂_E
      obtain ⟨q₃, hq₃_E, hq₃_y⟩ := hy₃_E
      refine ⟨q₁, q₂, q₃,
        fun h => hy12 (hq₁_y.symm.trans ((congrArg q₀ h).trans hq₂_y)),
        fun h => hy13 (hq₁_y.symm.trans ((congrArg q₀ h).trans hq₃_y)),
        fun h => hy23 (hq₂_y.symm.trans ((congrArg q₀ h).trans hq₃_y)),
        hq₁_E, hq₂_E, hq₃_E, ?_⟩
      intro q hq_set
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq_set
      rcases hq_set with hq | hq | hq <;> rw [hq]
      · exact hLift_sp q₁ hq₁_E (hq₁_y ▸ hy_sp y₁ (by simp))
      · exact hLift_sp q₂ hq₂_E (hq₂_y ▸ hy_sp y₂ (by simp))
      · exact hLift_sp q₃ hq₃_E (hq₃_y ▸ hy_sp y₃ (by simp))
    · 
      obtain ⟨u₁, u₂, hfu_eq, hu_ne⟩ : ∃ u₁ u₂ : ↥E_sch, f_E u₁ = f_E u₂ ∧ u₁ ≠ u₂ := by
        by_contra hAll
        push Not at hAll
        exact hInj (fun u₁ u₂ h => hAll u₁ u₂ h)
      let y₀ : ↥C₀ := f_E u₁
      have hy₀_not_U : y₀ ∉ U_iso₀ := fun hyU => hu_ne (hfE_inj_open u₁ u₂ hyU hfu_eq)
      have hCl_y₀ : IsClosed ({y₀} : Set ↥C₀) := hCl_compl y₀ hy₀_not_U
      let p₁ : ↥Y_res := ιE u₁
      let p₂ : ↥Y_res := ιE u₂
      have hp₁_E : p₁ ∈ E := hRange_ιE ▸ ⟨u₁, rfl⟩
      have hp₂_E : p₂ ∈ E := hRange_ιE ▸ ⟨u₂, rfl⟩
      have hp12_ne : p₁ ≠ p₂ := fun h => hu_ne (ιE.isClosedEmbedding.injective h)
      have hqp₁ : q₀ p₁ = y₀ := by rw [← Scheme.Hom.comp_apply]
      have hqp₂ : q₀ p₂ = y₀ := by
        have h1 : q₀ p₂ = f_E u₂ := by rw [← Scheme.Hom.comp_apply]
        exact h1.trans hfu_eq.symm
      obtain ⟨E₁', hE₁'_mem, hE₁'_ne, hp₁_E₁'⟩ := hExt_nonU p₁ hp₁_E (hqp₁ ▸ hy₀_not_U)
      obtain ⟨E₂', hE₂'_mem, hE₂'_ne, hp₂_E₂'⟩ := hExt_nonU p₂ hp₂_E (hqp₂ ▸ hy₀_not_U)
      obtain ⟨Ω_nhd, hOpen_nhd, hy₀_nhd, hnhd_sub⟩ :=
        hOpenNhd_gen u₁ u₂ y₀ hu_ne rfl hfu_eq.symm hCl_y₀
      rw [hRange_fE] at hnhd_sub
      by_cases hUniv : E_bar = Set.univ
      · let j₀ : Fin n := ⟨0, by omega⟩
        have hσ_cond : (s_Ω ≫ τ_res j₀) ≫ g_res =
            𝟙 (Spec (CommRingCat.of Ω)) ≫ s_Ω := by
          rw [CategoryTheory.Category.assoc, hSec_res j₀,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        let σ_res₀ : Spec (CommRingCat.of Ω) ⟶ Y_res :=
          CategoryTheory.Limits.pullback.lift (s_Ω ≫ τ_res j₀) (𝟙 _) hσ_cond
        let pt_Ω : ↥(Spec (CommRingCat.of Ω)) := (⊥ : PrimeSpectrum Ω)
        let p₃ : ↥Y_res := σ_res₀ pt_Ω
        have hp₃_fst : fst_res p₃ = τ_res j₀ (s_Ω pt_Ω) := by
          rw [← Scheme.Hom.comp_apply σ_res₀ fst_res,
            CategoryTheory.Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
        have hp₃_U : q₀ p₃ ∈ U_iso₀ := by
          show fst₀ (q₀ p₃) ∈ (U_iso : Set C)
          rw [hq₀_fst_pt p₃, hp₃_fst, hU_eq]
          have h2 : q_res (τ_res j₀ (s_Ω pt_Ω)) = τ j₀ (s_Ω pt_Ω) := by
            rw [← Scheme.Hom.comp_apply, hq_τ j₀]
          rw [h2]
          intro hZ
          exact (hZ_pts _ hZ).2.2 j₀ ⟨s_Ω pt_Ω, rfl⟩
        have hp₃_E : p₃ ∈ E := by
          have hy₃ : q₀ p₃ ∈ E_bar := hUniv.symm ▸ Set.mem_univ _
          obtain ⟨p₃', hp₃'_E, hp₃'_eq⟩ := hy₃
          have hp_eq : p₃' = p₃ := (hq₀_inj_W p₃ p₃' hp₃_U hp₃'_eq.symm).symm
          rwa [← hp_eq]
        refine ⟨p₁, p₂, p₃, hp12_ne,
          fun h => hy₀_not_U (hqp₁ ▸ h ▸ hp₃_U),
          fun h => hy₀_not_U (hqp₂ ▸ h ▸ hp₃_U),
          hp₁_E, hp₂_E, hp₃_E, ?_⟩
        intro q hq_set
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq_set
        rcases hq_set with hq | hq | hq <;> rw [hq]
        · exact Or.inl ⟨E₁', hE₁'_mem, hE₁'_ne, hp₁_E₁'⟩
        · exact Or.inl ⟨E₂', hE₂'_mem, hE₂'_ne, hp₂_E₂'⟩
        · exact Or.inr ⟨j₀, s_Ω pt_Ω, hp₃_fst.symm⟩
      · let K₂ : Set ↥C₀ := ⋃ E'_bar ∈ (irreducibleComponents ↥C₀) \ {E_bar}, E'_bar
        have hK₂_cl : IsClosed K₂ :=
          hFin_C₀.sdiff.isClosed_biUnion (fun F hF => isClosed_of_mem_irreducibleComponents F hF.1)
        have hCov_C₀ : (Set.univ : Set ↥C₀) ⊆ E_bar ∪ K₂ := by
          intro y _
          obtain ⟨F, hF_mem, hy_F⟩ :=
            exists_mem_irreducibleComponents_subset_of_isIrreducible ({y} : Set ↥C₀)
              isIrreducible_singleton
          by_cases hF_eq : F = E_bar
          · exact Or.inl (hF_eq ▸ hy_F rfl)
          · exact Or.inr (Set.mem_biUnion ⟨hF_mem, hF_eq⟩ (hy_F rfl))
        obtain ⟨y_out, hy_out⟩ : (Set.univ \ E_bar).Nonempty := by
          by_contra hempty
          rw [Set.not_nonempty_iff_eq_empty, Set.sdiff_eq_empty] at hempty
          exact hUniv (Set.Subset.antisymm (Set.subset_univ _) hempty)
        have hy_out_K₂ : y_out ∈ K₂ := by
          rcases hCov_C₀ (Set.mem_univ y_out) with h1 | h2
          · exact False.elim (hy_out.2 h1)
          · exact h2
        obtain ⟨y₃, _, hy₃_Ebar, hy₃_K₂⟩ :=
          isPreconnected_closed_iff.mp (@isPreconnected_univ ↥C₀ _ hConn_C₀.toPreconnectedSpace)
            E_bar K₂ hCl_Ebar hK₂_cl hCov_C₀
            ⟨y₀, trivial, ⟨p₁, hp₁_E, hqp₁⟩⟩ ⟨y_out, trivial, hy_out_K₂⟩
        obtain ⟨E'_bar, ⟨hE'_mem, hE'_ne⟩, hy₃_E'⟩ := Set.mem_iUnion₂.mp hy₃_K₂
        have hy₃_ne_y₀ : y₃ ≠ y₀ := by
          intro hEq
          subst hEq
          have hE'_cov : E'_bar ⊆ E_bar ∪ Ω_nhdᶜ := by
            intro y hy
            by_cases hyn : y ∈ Ω_nhd
            · exact Or.inl (hnhd_sub hyn)
            · exact Or.inr hyn
          have hE'_sub : E'_bar ⊆ E_bar := by
            rcases hIrred_union hE'_mem.1 hCl_Ebar hOpen_nhd.isClosed_compl hE'_cov with h | h
            · exact h
            · exact False.elim (h hy₃_E' hy₀_nhd)
          exact hE'_ne (Set.Subset.antisymm hE'_sub (hE'_mem.2 hIrred_Ebar hE'_sub))
        obtain ⟨p₃, hp₃_E, hqp₃⟩ := hy₃_Ebar
        refine ⟨p₁, p₂, p₃, hp12_ne,
          fun h => hy₃_ne_y₀ (hqp₃.symm.trans ((congrArg q₀ h.symm).trans hqp₁)),
          fun h => hy₃_ne_y₀ (hqp₃.symm.trans ((congrArg q₀ h.symm).trans hqp₂)),
          hp₁_E, hp₂_E, hp₃_E, ?_⟩
        intro q hq_set
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq_set
        rcases hq_set with hq | hq | hq <;> rw [hq]
        · exact Or.inl ⟨E₁', hE₁'_mem, hE₁'_ne, hp₁_E₁'⟩
        · exact Or.inl ⟨E₂', hE₂'_mem, hE₂'_ne, hp₂_E₂'⟩
        · exact hLift_sp p₃ hp₃_E (Or.inl ⟨E'_bar, hE'_mem, hE'_ne, hqp₃ ▸ hy₃_E'⟩)

  
  refine ⟨?_, ?_⟩
  · intro E E_sch ιE hE_mem hCl_ιE hInt_E hRange_ιE ⟨isoP1, hComm_P1⟩
    by_cases hSub : ((fun q => q_res (fst_res q)) '' E) ⊆ Z_blown
    · exact Or.inl (hCaseI E hE_mem hSub).2
    · exact Or.inr (hUncontr E E_sch ιE hE_mem hCl_ιE hInt_E hRange_ιE isoP1 hComm_P1 hSub)
  · intro E h2br
    by_cases hSub : ((fun q => q_res (fst_res q)) '' E) ⊆ Z_blown
    · exact (hCaseI E h2br.1 hSub).1
    · obtain ⟨hE_mem, ⟨E_sch, ιE, isoP1, hCl_ιE, hInt_E, hRange_ιE, hComm_P1⟩,
        hNoMark, b₁, b₂, _, _, _, _, _, hOnlyTwo⟩ := h2br
      obtain ⟨q₁, q₂, q₃, h12, h13, h23, hq₁_E, hq₂_E, hq₃_E, hq_sp⟩ :=
        hUncontr E E_sch ιE hE_mem hCl_ιE hInt_E hRange_ιE isoP1 hComm_P1 hSub
      have hTwo : ∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y_res), q ∈ E → q = b₁ ∨ q = b₂ := by
        intro q hq_set hqE
        rcases hq_sp q hq_set with hExt | ⟨j, hj⟩
        · exact hOnlyTwo q hqE hExt
        · exact False.elim (hNoMark q hqE j hj)
      rcases hTwo q₁ (by simp) hq₁_E with rfl | rfl <;>
        rcases hTwo q₂ (by simp) hq₂_E with rfl | rfl <;>
        rcases hTwo q₃ (by simp) hq₃_E with rfl | rfl
      · exact False.elim (h12 rfl)
      · exact False.elim (h12 rfl)
      · exact False.elim (h13 rfl)
      · exact False.elim (h23 rfl)
      · exact False.elim (h23 rfl)
      · exact False.elim (h13 rfl)
      · exact False.elim (h12 rfl)
      · exact False.elim (h12 rfl)

theorem weil_powerSeries_terminal_partial_to_node_resolution (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C C_res : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (g_res : C_res ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_res : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C_res))
    (q_res : C_res ⟶ C)
    (Z_blown : Set C)
    (pts : Fin 0 → C_res)
    (mults : Fin 0 → ℕ)
    (hTerm : IsPartialPowerSeriesNodeResolution Ω n g τ g_res τ_res q_res Z_blown 0 pts mults) :
    IsPowerSeriesNodeResolution Ω n g τ g_res τ_res q_res :=
by
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  let η_K := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))
  have hTermCopy := hTerm
  obtain ⟨hInt_res, hFlat_res, hProp_res, hLFP_res, hSurj_res, hSmK_res,
    hSec_res, hDisj_res, hSecSm_res, hq_g, hq_τ, hq_prop, hq_surj,
    hq_app, hq_conn, _hZ_fin, hZ_pts, ⟨U_iso, hU_eq, hq_iso⟩, hZ_exc,
    _hPts_inj, _hMults, hOutside⟩ := hTermCopy
  
  have hSurf : IsRegularSimpleNodalSurface Ω n g_res τ_res := by
    refine ⟨hInt_res, hFlat_res, hProp_res, hLFP_res, hSurj_res, hSmK_res,
      hSec_res, hDisj_res, hSecSm_res, ?_⟩
    intro x
    have hx_not : x ∉ Set.range pts := by
      rintro ⟨i, _⟩
      exact Fin.elim0 i
    rcases hOutside x hx_not with hSm | hRoof
    · exact Or.inl hSm
    · have hSubst : ∀ (t : PowerSeries Ω), t = PowerSeries.X →
          (∃ (A' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec A')
              (e_C : AlgebraicGeometry.Spec A' ⟶ C_res)
              (q : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
                  {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C t}))),
            AlgebraicGeometry.Etale e_C ∧
            AlgebraicGeometry.Etale q ∧
            e_C.base v₀ = x ∧
            (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (q.base v₀).asIdeal) ∧
            Ideal.Quotient.mk _ (MvPolynomial.C PowerSeries.X) ∈ (q.base v₀).asIdeal ∧
            e_C ≫ g_res =
              q ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) →
          (∃ (A' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec A')
              (e_C : AlgebraicGeometry.Spec A' ⟶ C_res)
              (q : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
                  {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X}))),
            AlgebraicGeometry.Etale e_C ∧
            AlgebraicGeometry.Etale q ∧
            e_C.base v₀ = x ∧
            (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (q.base v₀).asIdeal) ∧
            Ideal.Quotient.mk _ (MvPolynomial.C PowerSeries.X) ∈ (q.base v₀).asIdeal ∧
            e_C ≫ g_res =
              q ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
        rintro t rfl h
        exact h
      exact Or.inr (hSubst ((PowerSeries.X : PowerSeries Ω) ^ 1) (pow_one _) hRoof.2)
  
  let W_iso : C_res.Opens := (TopologicalSpace.Opens.map q_res.base).obj U_iso
  let e_iso : W_iso.toScheme ≅ U_iso.toScheme :=
    @CategoryTheory.asIso _ _ _ _ (q_res ∣_ U_iso) hq_iso
  have he_hom_ι : e_iso.hom ≫ U_iso.ι = W_iso.ι ≫ q_res :=
    AlgebraicGeometry.morphismRestrict_ι q_res U_iso
  have he_inv_q : e_iso.inv ≫ W_iso.ι ≫ q_res = U_iso.ι := by
    rw [← he_hom_ι, CategoryTheory.Iso.inv_hom_id_assoc]
  
  have hConnY : ConnectedSpace ↥(CategoryTheory.Limits.pullback g_res s_Ω) := by
    let Y_res := CategoryTheory.Limits.pullback g_res s_Ω
    let C₀ := CategoryTheory.Limits.pullback g s_Ω
    let fst_res := CategoryTheory.Limits.pullback.fst g_res s_Ω
    let snd_res := CategoryTheory.Limits.pullback.snd g_res s_Ω
    let fst₀ := CategoryTheory.Limits.pullback.fst g s_Ω
    let snd₀ := CategoryTheory.Limits.pullback.snd g s_Ω
    let q₀ : Y_res ⟶ C₀ :=
      CategoryTheory.Limits.pullback.lift (fst_res ≫ q_res) snd_res (by
        rw [CategoryTheory.Category.assoc, hq_g, CategoryTheory.Limits.pullback.condition])
    have hq₀_fst : q₀ ≫ fst₀ = fst_res ≫ q_res :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hq₀_snd : q₀ ≫ snd₀ = snd_res :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_outer : CategoryTheory.IsPullback fst_res (q₀ ≫ snd₀) (q_res ≫ g) s_Ω := by
      rw [hq₀_snd, hq_g]
      exact CategoryTheory.IsPullback.of_hasPullback g_res s_Ω
    have hPb_bot : CategoryTheory.IsPullback fst₀ snd₀ g s_Ω :=
      CategoryTheory.IsPullback.of_hasPullback g s_Ω
    have hPb_q₀ : CategoryTheory.IsPullback fst_res q₀ q_res fst₀ :=
      CategoryTheory.IsPullback.of_bot hPb_outer hq₀_fst.symm hPb_bot
    have : AlgebraicGeometry.IsProper q₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_q₀ hq_prop
    have : AlgebraicGeometry.Surjective q₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_q₀ hq_surj
    have hSurj_coeff : Function.Surjective (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) :=
      fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩
    have : AlgebraicGeometry.IsClosedImmersion s_Ω :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)) hSurj_coeff
    have : AlgebraicGeometry.IsClosedImmersion fst₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bot.flip
        ‹AlgebraicGeometry.IsClosedImmersion s_Ω›
    have : AlgebraicGeometry.IsClosedImmersion fst_res :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g_res s_Ω).flip
        ‹AlgebraicGeometry.IsClosedImmersion s_Ω›
    have hFib_preconn : ∀ y : ↥C₀, _root_.IsPreconnected (q₀.base ⁻¹' {y}) := by
      intro y
      have hImg : fst_res.base '' (q₀.base ⁻¹' {y}) = q_res.base ⁻¹' {fst₀.base y} := by
        ext z
        constructor
        · rintro ⟨w, hw, rfl⟩
          rw [Set.mem_preimage, Set.mem_singleton_iff] at hw ⊢
          have h1 : (fst_res ≫ q_res).base w = (q₀ ≫ fst₀).base w := by rw [hq₀_fst]
          simpa [hw] using h1
        · intro hz
          rw [Set.mem_preimage, Set.mem_singleton_iff] at hz
          have hz_range : g_res.base z ∈ Set.range s_Ω.base := by
            have h1 : g_res.base z = (q_res ≫ g).base z := by rw [hq_g]
            have h2 : (fst₀ ≫ g).base y = (snd₀ ≫ s_Ω).base y := by
              rw [CategoryTheory.Limits.pullback.condition]
            have h3 : g_res.base z = s_Ω.base (snd₀.base y) := by
              calc g_res.base z = g.base (q_res.base z) := by simpa using h1
                _ = g.base (fst₀.base y) := by rw [hz]
                _ = s_Ω.base (snd₀.base y) := by simpa using h2
            exact ⟨snd₀.base y, h3.symm⟩
          have hz_fst : z ∈ Set.range fst_res.base := by
            rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
            exact hz_range
          obtain ⟨w, rfl⟩ := hz_fst
          refine ⟨w, ?_, rfl⟩
          rw [Set.mem_preimage, Set.mem_singleton_iff]
          apply fst₀.isClosedEmbedding.injective
          have h1 : (q₀ ≫ fst₀).base w = (fst_res ≫ q_res).base w := by rw [hq₀_fst]
          simpa [hz] using h1
      rw [← fst_res.isClosedEmbedding.isEmbedding.isInducing.isPreconnected_image, hImg]
      exact (hq_conn (fst₀.base y)).isPreconnected
    have hConnC₀ : ConnectedSpace ↥C₀ := (hStab.2.2.2.2.2.2.2.2 Ω s_Ω).1
    obtain ⟨y₀⟩ := hConnC₀.toNonempty
    obtain ⟨w₀, _⟩ := q₀.surjective y₀
    have : Nonempty ↥Y_res := ⟨w₀⟩
    rw [connectedSpace_iff_univ]
    refine ⟨Set.univ_nonempty, isPreconnected_closed_iff.mpr ?_⟩
    intro K₁ K₂ hK₁ hK₂ hCov hN₁ hN₂
    let L₁ : Set ↥C₀ := q₀.base '' K₁
    let L₂ : Set ↥C₀ := q₀.base '' K₂
    have hL₁_cl : IsClosed L₁ := q₀.isClosedMap K₁ hK₁
    have hL₂_cl : IsClosed L₂ := q₀.isClosedMap K₂ hK₂
    have hCov_L : (Set.univ : Set ↥C₀) ⊆ L₁ ∪ L₂ := by
      intro y _
      obtain ⟨w, rfl⟩ := q₀.surjective y
      rcases hCov (Set.mem_univ w) with hw₁ | hw₂
      · exact Or.inl ⟨w, hw₁, rfl⟩
      · exact Or.inr ⟨w, hw₂, rfl⟩
    obtain ⟨w₁, _, hw₁⟩ := hN₁
    obtain ⟨w₂, _, hw₂⟩ := hN₂
    have hN_L₁ : ((Set.univ : Set ↥C₀) ∩ L₁).Nonempty := ⟨q₀.base w₁, trivial, w₁, hw₁, rfl⟩
    have hN_L₂ : ((Set.univ : Set ↥C₀) ∩ L₂).Nonempty := ⟨q₀.base w₂, trivial, w₂, hw₂, rfl⟩
    obtain ⟨y, _, ⟨u₁, hu₁, hu₁_eq⟩, ⟨u₂, hu₂, hu₂_eq⟩⟩ :=
      isPreconnected_closed_iff.mp (@isPreconnected_univ ↥C₀ _ hConnC₀.toPreconnectedSpace)
        L₁ L₂ hL₁_cl hL₂_cl hCov_L hN_L₁ hN_L₂
    have hFib_cov : q₀.base ⁻¹' {y} ⊆ K₁ ∪ K₂ := fun w _ => hCov (Set.mem_univ w)
    have hFib_N₁ : (q₀.base ⁻¹' {y} ∩ K₁).Nonempty := ⟨u₁, hu₁_eq, hu₁⟩
    have hFib_N₂ : (q₀.base ⁻¹' {y} ∩ K₂).Nonempty := ⟨u₂, hu₂_eq, hu₂⟩
    obtain ⟨u, _, hu_inter⟩ :=
      isPreconnected_closed_iff.mp (hFib_preconn y) K₁ K₂ hK₁ hK₂ hFib_cov hFib_N₁ hFib_N₂
    exact ⟨u, trivial, hu_inter⟩
  
  have hGenIso : ∀ (v₁ : CategoryTheory.Limits.pullback g_res η_K ⟶
      CategoryTheory.Limits.pullback g η_K),
      v₁ ≫ CategoryTheory.Limits.pullback.fst g η_K =
        CategoryTheory.Limits.pullback.fst g_res η_K ≫ q_res →
      v₁ ≫ CategoryTheory.Limits.pullback.snd g η_K =
        CategoryTheory.Limits.pullback.snd g_res η_K →
      CategoryTheory.IsIso v₁ := by
    intro v₁ hv₁_fst hv₁_snd
    let fst_K := CategoryTheory.Limits.pullback.fst g η_K
    let snd_K := CategoryTheory.Limits.pullback.snd g η_K
    let fst_K_res := CategoryTheory.Limits.pullback.fst g_res η_K
    let snd_K_res := CategoryTheory.Limits.pullback.snd g_res η_K
    have hX_not_η : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (FractionRing (PowerSeries Ω)))),
        (PowerSeries.X : PowerSeries Ω) ∉ (η_K.base pt).asIdeal := by
      intro pt hmem
      rw [AlgebraicGeometry.Spec.map_apply] at hmem
      change algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)) PowerSeries.X ∈ pt.asIdeal at hmem
      have hX_ne : algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)) PowerSeries.X ≠ 0 := by
        intro hzero
        exact PowerSeries.X_ne_zero
          (IsFractionRing.injective (PowerSeries Ω) (FractionRing (PowerSeries Ω))
            (hzero.trans (map_zero _).symm))
      exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem pt.asIdeal hmem (IsUnit.mk0 _ hX_ne))
    have hRange_K : Set.range fst_K.base ⊆ Set.range U_iso.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, hU_eq]
      rintro _ ⟨w, rfl⟩ hw_Z
      have hcond : (fst_K ≫ g).base w = (snd_K ≫ η_K).base w := by
        rw [CategoryTheory.Limits.pullback.condition]
      have h_eq : g.base (fst_K.base w) = η_K.base (snd_K.base w) := by simpa using hcond
      have hX_mem := (hZ_pts (fst_K.base w) hw_Z).2.1
      rw [h_eq] at hX_mem
      exact hX_not_η (snd_K.base w) hX_mem
    have hRange_K_res : Set.range fst_K_res.base ⊆ Set.range W_iso.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      show q_res.base (fst_K_res.base w) ∈ U_iso
      change q_res.base (fst_K_res.base w) ∈ (U_iso : Set C)
      rw [hU_eq]
      intro hw_Z
      have hcond : (fst_K_res ≫ q_res ≫ g).base w = (snd_K_res ≫ η_K).base w := by
        rw [hq_g, CategoryTheory.Limits.pullback.condition]
      have h_eq : g.base (q_res.base (fst_K_res.base w)) = η_K.base (snd_K_res.base w) := by
        simpa using hcond
      have hX_mem := (hZ_pts (q_res.base (fst_K_res.base w)) hw_Z).2.1
      rw [h_eq] at hX_mem
      exact hX_not_η (snd_K_res.base w) hX_mem
    let j_K := AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι fst_K hRange_K
    have hj_K : j_K ≫ U_iso.ι = fst_K :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι fst_K hRange_K
    let j_K_res := AlgebraicGeometry.IsOpenImmersion.lift W_iso.ι fst_K_res hRange_K_res
    have hj_K_res : j_K_res ≫ W_iso.ι = fst_K_res :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_iso.ι fst_K_res hRange_K_res
    let u_lift : CategoryTheory.Limits.pullback g η_K ⟶ C_res :=
      j_K ≫ e_iso.inv ≫ W_iso.ι
    have hu_q : u_lift ≫ q_res = fst_K := by
      dsimp only [u_lift]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_inv_q, hj_K]
    have hu_cond : u_lift ≫ g_res = snd_K ≫ η_K := by
      rw [← hq_g, ← CategoryTheory.Category.assoc, hu_q,
        CategoryTheory.Limits.pullback.condition]
    let w₁ : CategoryTheory.Limits.pullback g η_K ⟶
        CategoryTheory.Limits.pullback g_res η_K :=
      CategoryTheory.Limits.pullback.lift u_lift snd_K hu_cond
    refine ⟨⟨w₁, ?_, ?_⟩⟩
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.id_comp]
        have h_mono : (v₁ ≫ j_K ≫ e_iso.inv) ≫ e_iso.hom ≫ U_iso.ι =
            j_K_res ≫ e_iso.hom ≫ U_iso.ι := by
          calc (v₁ ≫ j_K ≫ e_iso.inv) ≫ e_iso.hom ≫ U_iso.ι
              = v₁ ≫ j_K ≫ (e_iso.inv ≫ e_iso.hom) ≫ U_iso.ι := by simp [CategoryTheory.Category.assoc]
            _ = v₁ ≫ (j_K ≫ U_iso.ι) := by rw [e_iso.inv_hom_id, CategoryTheory.Category.id_comp]
            _ = v₁ ≫ fst_K := by rw [hj_K]
            _ = fst_K_res ≫ q_res := hv₁_fst
            _ = (j_K_res ≫ W_iso.ι) ≫ q_res := by rw [hj_K_res]
            _ = j_K_res ≫ e_iso.hom ≫ U_iso.ι := by rw [CategoryTheory.Category.assoc, he_hom_ι]
        have h_eq1 : (v₁ ≫ j_K ≫ e_iso.inv) ≫ e_iso.hom = j_K_res ≫ e_iso.hom := by
          apply (cancel_mono U_iso.ι).mp
          simpa [CategoryTheory.Category.assoc] using h_mono
        have h_eq2 : v₁ ≫ j_K ≫ e_iso.inv = j_K_res :=
          (cancel_mono e_iso.hom).mp h_eq1
        calc v₁ ≫ u_lift
            = (v₁ ≫ j_K ≫ e_iso.inv) ≫ W_iso.ι := by simp [u_lift, CategoryTheory.Category.assoc]
          _ = j_K_res ≫ W_iso.ι := by rw [h_eq2]
          _ = fst_K_res := hj_K_res
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          hv₁_snd, CategoryTheory.Category.id_comp]
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hv₁_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hu_q, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, hv₁_snd,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
  
  have hConj9 : ∀ x : C, ¬(q_res.base ⁻¹' {x}).Subsingleton →
      ∀ z ∈ q_res.base ⁻¹' {x},
        ∃ q₀ : ↥(CategoryTheory.Limits.pullback g_res s_Ω),
          (CategoryTheory.Limits.pullback.fst g_res s_Ω).base q₀ = z ∧
          ∃ E : Set ↥(CategoryTheory.Limits.pullback g_res s_Ω),
            IsTwoBridgeRationalComponent Ω n g_res τ_res E ∧ q₀ ∈ E := by
    intro x hNotSub z hz
    have hx_Z : x ∈ Z_blown := by
      by_contra hx_not_Z
      apply hNotSub
      have hx_U : x ∈ U_iso := by
        change x ∈ (U_iso : Set C)
        rw [hU_eq]
        exact hx_not_Z
      intro z₁ hz₁ z₂ hz₂
      rw [Set.mem_preimage, Set.mem_singleton_iff] at hz₁ hz₂
      have hz₁_W : z₁ ∈ W_iso := by
        show q_res.base z₁ ∈ U_iso
        rwa [hz₁]
      have hz₂_W : z₂ ∈ W_iso := by
        show q_res.base z₂ ∈ U_iso
        rwa [hz₂]
      let p₁ : ↥W_iso.toScheme := ⟨z₁, hz₁_W⟩
      let p₂ : ↥W_iso.toScheme := ⟨z₂, hz₂_W⟩
      have hp₁_eq : U_iso.ι.base (e_iso.hom.base p₁) = x := by
        have h1 : (e_iso.hom ≫ U_iso.ι).base p₁ = (W_iso.ι ≫ q_res).base p₁ := by rw [he_hom_ι]
        have h2 : U_iso.ι.base (e_iso.hom.base p₁) = q_res.base (W_iso.ι.base p₁) := by
          simpa using h1
        have h3 : W_iso.ι.base p₁ = z₁ := rfl
        rw [h2, h3, hz₁]
      have hp₂_eq : U_iso.ι.base (e_iso.hom.base p₂) = x := by
        have h1 : (e_iso.hom ≫ U_iso.ι).base p₂ = (W_iso.ι ≫ q_res).base p₂ := by rw [he_hom_ι]
        have h2 : U_iso.ι.base (e_iso.hom.base p₂) = q_res.base (W_iso.ι.base p₂) := by
          simpa using h1
        have h3 : W_iso.ι.base p₂ = z₂ := rfl
        rw [h2, h3, hz₂]
      have he_eq : e_iso.hom.base p₁ = e_iso.hom.base p₂ :=
        U_iso.ι.isOpenEmbedding.injective (hp₁_eq.trans hp₂_eq.symm)
      have hp_eq : p₁ = p₂ := by
        have h1' : e_iso.inv.base (e_iso.hom.base p₁) = p₁ := by simp
        have h2' : e_iso.inv.base (e_iso.hom.base p₂) = p₂ := by simp
        rw [← h1', he_eq, h2']
      exact congrArg (fun p : ↥W_iso.toScheme => W_iso.ι.base p) hp_eq
    obtain ⟨q₀, hq₀, E, hE, hq₀_E, _⟩ := hZ_exc x hx_Z z hz
    exact ⟨q₀, hq₀, E, hE, hq₀_E⟩
  
  obtain ⟨hConj1d, hConj10⟩ :=
    weil_powerSeries_terminal_rational_component_dichotomy_and_contraction
      Ω n C C_res g τ hStab g_res τ_res q_res Z_blown pts mults hTerm
      (weil_proj_line_algClosed_proper_closed_finite_and_dvr_stalk Ω)
      (fun R₀ S_E _ _ _ α_R φ₀ hFin r₀ hr₀_ne hBirat p_y _ hS_pir =>
        weil_algClosed_smooth_or_nodal_birational_finite_local_algebra
          Ω R₀ S_E α_R φ₀ hFin r₀ hr₀_ne hBirat p_y hS_pir)
  exact ⟨⟨hStab.1, hSurf, hConnY, hConj1d⟩,
    hq_g, hq_τ, hq_prop, hq_surj, hGenIso, hq_app, hq_conn, hConj9, hConj10⟩

theorem weil_powerSeries_stable_curve_node_resolution (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (hInt : AlgebraicGeometry.IsIntegral C)
    (hSmK : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.snd g
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω))))))) :
    ∃ (C_res : AlgebraicGeometry.Scheme.{u})
      (g_res : C_res ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ_res : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C_res))
      (q_res : C_res ⟶ C),
      IsPowerSeriesNodeResolution Ω n g τ g_res τ_res q_res :=
by
  have hHyp :=
    weil_powerSeries_curve_smooth_or_etale_plane_hypersurface Ω n C g τ hStab hSmK
  obtain ⟨r₀, pts₀, mults₀, hPart₀⟩ :=
    weil_powerSeries_henselian_hypersurface_to_initial_partial_resolution
      Ω n C g τ hStab hInt hSmK hHyp
  have hInd : ∀ (W : ℕ)
      (C' : AlgebraicGeometry.Scheme.{u})
      (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
      (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C'))
      (q' : C' ⟶ C)
      (Z_blown : Set C)
      (r : ℕ) (pts : Fin r → C') (mults : Fin r → ℕ),
      IsPartialPowerSeriesNodeResolution Ω n g τ g' τ' q' Z_blown r pts mults →
      (∑ i : Fin r, mults i / 2) = W →
      ∃ (C_res : AlgebraicGeometry.Scheme.{u})
        (g_res : C_res ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
        (τ_res : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C_res))
        (q_res : C_res ⟶ C)
        (Z_res : Set C)
        (pts_res : Fin 0 → C_res)
        (mults_res : Fin 0 → ℕ),
        IsPartialPowerSeriesNodeResolution Ω n g τ g_res τ_res q_res Z_res 0 pts_res mults_res := by
    intro W
    induction W using Nat.strong_induction_on with
    | h W ih =>
      intro C' g' τ' q' Z_blown r pts mults hPart hW
      cases r with
      | zero =>
        exact ⟨C', g', τ', q', Z_blown, pts, mults, hPart⟩
      | succ r' =>
        let i₀ : Fin (r' + 1) := ⟨0, Nat.succ_pos r'⟩
        have hPartCopy := hPart
        obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hMults, _⟩ :=
          hPartCopy
        obtain ⟨M_m, p_m, hLoc⟩ :=
          weil_powerSeries_local_node_blowup_model Ω (mults i₀) (hMults i₀).1
        obtain ⟨C'', g'', τ'', q'', Z_blown'', r'', pts'', mults'', hPart'', hLt⟩ :=
          weil_powerSeries_single_node_blowup_step Ω n C C' g τ hStab
            g' τ' q' Z_blown (r' + 1) pts mults hPart i₀ M_m p_m hLoc
        rw [hW] at hLt
        exact ih (∑ i : Fin r'', mults'' i / 2) hLt C'' g'' τ'' q'' Z_blown'' r'' pts'' mults''
          hPart'' rfl
  obtain ⟨C_res, g_res, τ_res, q_res, Z_res, pts_res, mults_res, hTerm⟩ :=
    hInd (∑ i : Fin r₀, mults₀ i / 2) C g τ (𝟙 C) ∅ r₀ pts₀ mults₀ hPart₀ rfl
  exact ⟨C_res, g_res, τ_res, q_res,
    weil_powerSeries_terminal_partial_to_node_resolution
      Ω n C C_res g τ hStab g_res τ_res q_res Z_res pts_res mults_res hTerm⟩

theorem weil_regularSimpleNodal_specialFiber_isReduced (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (hSurf : IsRegularSimpleNodalSurface Ω n g τ) :
    AlgebraicGeometry.IsReduced
      (CategoryTheory.Limits.pullback g
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))) :=
by
  let s_Ω := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
  refine @AlgebraicGeometry.isReduced_of_isReduced_stalk _ ?_
  intro q
  have hEtaleStalk : ∀ (U : AlgebraicGeometry.Scheme.{u}) (e : U ⟶ C),
      AlgebraicGeometry.Etale e →
      AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback (e ≫ g) s_Ω) →
      ∀ u₀ : ↥U, e.base u₀ = (CategoryTheory.Limits.pullback.fst g s_Ω).base q →
        _root_.IsReduced ↑((CategoryTheory.Limits.pullback g s_Ω).presheaf.stalk q) := by
    intro U e he hRedP' u₀ hu₀
    let P := CategoryTheory.Limits.pullback g s_Ω
    let P' := CategoryTheory.Limits.pullback (e ≫ g) s_Ω
    let e₀ : P' ⟶ P := CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (e ≫ g) s_Ω ≫ e)
      (CategoryTheory.Limits.pullback.snd (e ≫ g) s_Ω)
      (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
    have hRight : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd g s_Ω)
        (CategoryTheory.Limits.pullback.fst g s_Ω) s_Ω g :=
      (CategoryTheory.IsPullback.of_hasPullback g s_Ω).flip
    have hOuter : CategoryTheory.IsPullback
        (e₀ ≫ CategoryTheory.Limits.pullback.snd g s_Ω)
        (CategoryTheory.Limits.pullback.fst (e ≫ g) s_Ω) s_Ω (e ≫ g) := by
      rw [CategoryTheory.Limits.pullback.lift_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (e ≫ g) s_Ω).flip
    have hLeft : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (e ≫ g) s_Ω) e₀ e
        (CategoryTheory.Limits.pullback.fst g s_Ω) :=
      (CategoryTheory.IsPullback.of_right hOuter
        (CategoryTheory.Limits.pullback.lift_fst _ _ _) hRight).flip
    haveI : AlgebraicGeometry.Etale e₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hLeft he
    haveI : AlgebraicGeometry.IsReduced P' := hRedP'
    obtain ⟨w₀, _, hw₀⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hLeft u₀ q hu₀
    change _root_.IsReduced ↑(P.presheaf.stalk q)
    rw [← hw₀]
    haveI : _root_.IsReduced ↑(P'.presheaf.stalk w₀) :=
      AlgebraicGeometry.isReduced_stalk_of_isReduced P' w₀
    let θ := (e₀.stalkMap w₀).hom
    have hθ_flat : θ.Flat := AlgebraicGeometry.Flat.stalkMap e₀ w₀
    letI : Algebra ↑(P.presheaf.stalk (e₀.base w₀)) ↑(P'.presheaf.stalk w₀) := θ.toAlgebra
    haveI : Module.Flat ↑(P.presheaf.stalk (e₀.base w₀)) ↑(P'.presheaf.stalk w₀) :=
      RingHom.flat_algebraMap_iff.mp hθ_flat
    haveI : IsLocalHom (algebraMap ↑(P.presheaf.stalk (e₀.base w₀)) ↑(P'.presheaf.stalk w₀)) := by
      change IsLocalHom θ
      infer_instance
    haveI : Module.FaithfullyFlat ↑(P.presheaf.stalk (e₀.base w₀)) ↑(P'.presheaf.stalk w₀) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hθ_inj : Function.Injective θ :=
      FaithfulSMul.algebraMap_injective ↑(P.presheaf.stalk (e₀.base w₀)) ↑(P'.presheaf.stalk w₀)
    exact isReduced_of_injective θ hθ_inj
  rcases hSurf.2.2.2.2.2.2.2.2.2 ((CategoryTheory.Limits.pullback.fst g s_Ω).base q) with
    ⟨V, hxV, hSmV⟩ | ⟨A', v₀, e_C, q_nod, heC, hq, hv₀, _, _, hcomm⟩
  · let Y := CategoryTheory.Limits.pullback (V.ι ≫ g) s_Ω
    let f₀ := CategoryTheory.Limits.pullback.snd (V.ι ≫ g) s_Ω
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g) := hSmV
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (V.ι ≫ g) s_Ω) hSmV
    have hRedY : AlgebraicGeometry.IsReduced Y := by
      refine @AlgebraicGeometry.isReduced_of_isReduced_stalk _ ?_
      intro y
      obtain ⟨U, _, W, hW_aff, hyW, e_UW, hStd⟩ :=
        AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
          (n := 1) (f := f₀) y
      let R_U := ↑((AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.obj (Opposite.op U))
      let B_W := ↑(Y.presheaf.obj (Opposite.op W))
      have hU_top : U = ⊤ := by
        haveI : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
          change Subsingleton (PrimeSpectrum Ω)
          infer_instance
        ext z
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        have hz : z = f₀.base y := Subsingleton.elim z (f₀.base y)
        rw [hz]
        exact e_UW hyW
      let iso_RU : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.obj (Opposite.op U) ≅
          CommRingCat.of Ω :=
        ((AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.mapIso
          (CategoryTheory.eqToIso hU_top.symm).op) ≪≫
          AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)
      haveI : IsDomain R_U :=
        MulEquiv.isDomain Ω iso_RU.commRingCatIsoToRingEquiv.toMulEquiv
      obtain ⟨ψ_sm, _, hψ_sm_et⟩ := hStd.exists_etale_mvPolynomial
      let M₁ := MvPolynomial (Fin 1) R_U
      let L := FractionRing M₁
      letI : Algebra M₁ B_W := ψ_sm.toAlgebra
      haveI : Algebra.Etale M₁ B_W := by
        rwa [← RingHom.etale_algebraMap]
      have hInc_inj : Function.Injective
          (Algebra.TensorProduct.includeLeftRingHom : B_W →+* TensorProduct M₁ B_W L) :=
        Algebra.TensorProduct.includeLeft_injective (S := M₁) (IsFractionRing.injective M₁ L)
      haveI : _root_.IsReduced (TensorProduct M₁ L B_W) :=
        Algebra.FormallyUnramified.isReduced_of_field L (TensorProduct M₁ L B_W)
      haveI : _root_.IsReduced (TensorProduct M₁ B_W L) :=
        isReduced_of_injective (Algebra.TensorProduct.comm M₁ B_W L).toRingHom
          (AlgEquiv.injective _)
      haveI : _root_.IsReduced B_W := isReduced_of_injective _ hInc_inj
      haveI : AlgebraicGeometry.IsReduced W.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion hW_aff.isoSpec.hom
      let y_W : ↥W.toScheme := ⟨y, hyW⟩
      haveI : _root_.IsReduced ↑(W.toScheme.presheaf.stalk y_W) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced W.toScheme y_W
      let θ_W := (W.ι.stalkMap y_W).hom
      have hθW_flat : θ_W.Flat := AlgebraicGeometry.Flat.stalkMap W.ι y_W
      letI : Algebra ↑(Y.presheaf.stalk (W.ι.base y_W)) ↑(W.toScheme.presheaf.stalk y_W) :=
        θ_W.toAlgebra
      haveI : Module.Flat ↑(Y.presheaf.stalk (W.ι.base y_W)) ↑(W.toScheme.presheaf.stalk y_W) :=
        RingHom.flat_algebraMap_iff.mp hθW_flat
      haveI : IsLocalHom
          (algebraMap ↑(Y.presheaf.stalk (W.ι.base y_W)) ↑(W.toScheme.presheaf.stalk y_W)) := by
        change IsLocalHom θ_W
        infer_instance
      haveI : Module.FaithfullyFlat
          ↑(Y.presheaf.stalk (W.ι.base y_W)) ↑(W.toScheme.presheaf.stalk y_W) :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      have hθW_inj : Function.Injective θ_W :=
        FaithfulSMul.algebraMap_injective
          ↑(Y.presheaf.stalk (W.ι.base y_W)) ↑(W.toScheme.presheaf.stalk y_W)
      exact isReduced_of_injective θ_W hθW_inj
    exact hEtaleStalk V.toScheme V.ι inferInstance hRedY
      ⟨(CategoryTheory.Limits.pullback.fst g s_Ω).base q, hxV⟩ rfl
  · let RStar := PowerSeries Ω
    let J₁ : Ideal (MvPolynomial (Fin 2) RStar) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X}
    let P₁ := MvPolynomial (Fin 2) RStar ⧸ J₁
    let J₀ : Ideal (MvPolynomial (Fin 2) Ω) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let Q₀ := MvPolynomial (Fin 2) Ω ⧸ J₀
    let ψ_mor : CommRingCat.of P₁ ⟶ A' := AlgebraicGeometry.Spec.preimage q_nod
    have hq_map : AlgebraicGeometry.Spec.map ψ_mor = q_nod :=
      AlgebraicGeometry.Spec.map_preimage q_nod
    let mkJ₁_mor : CommRingCat.of (MvPolynomial (Fin 2) RStar) ⟶ CommRingCat.of P₁ :=
      CommRingCat.ofHom (Ideal.Quotient.mk J₁)
    let mkJ₀_mor : CommRingCat.of (MvPolynomial (Fin 2) Ω) ⟶ CommRingCat.of Q₀ :=
      CommRingCat.ofHom (Ideal.Quotient.mk J₀)
    letI : Algebra RStar Ω := (PowerSeries.constantCoeff : RStar →+* Ω).toAlgebra
    letI : Algebra P₁ (↑A') := RingHom.toAlgebra ψ_mor.hom
    letI : Algebra RStar (↑A') :=
      RingHom.toAlgebra (ψ_mor.hom.comp (mkJ₁_mor.hom.comp MvPolynomial.C))
    haveI : Algebra.Etale P₁ (↑A') := by
      rw [← RingHom.etale_algebraMap]
      rw [← hq_map] at hq
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hq
    let π₀_raw_mor : CommRingCat.of (MvPolynomial (Fin 2) RStar) ⟶ CommRingCat.of Q₀ :=
      CommRingCat.ofHom
        (MvPolynomial.eval₂Hom
          (mkJ₀_mor.hom.comp
            (MvPolynomial.C.comp (PowerSeries.constantCoeff : RStar →+* Ω)))
          (fun i => mkJ₀_mor.hom (MvPolynomial.X i)))
    have hπ₀_ker : J₁ ≤ RingHom.ker π₀_raw_mor.hom := by
      rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      change π₀_raw_mor.hom (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X) = 0
      rw [map_sub, map_mul]
      have hX0 : π₀_raw_mor.hom (MvPolynomial.X 0) = mkJ₀_mor.hom (MvPolynomial.X 0) :=
        MvPolynomial.eval₂Hom_X' _ _ 0
      have hX1 : π₀_raw_mor.hom (MvPolynomial.X 1) = mkJ₀_mor.hom (MvPolynomial.X 1) :=
        MvPolynomial.eval₂Hom_X' _ _ 1
      have hCX : π₀_raw_mor.hom (MvPolynomial.C PowerSeries.X) = 0 := by
        change (MvPolynomial.eval₂Hom
          (mkJ₀_mor.hom.comp
            (MvPolynomial.C.comp (PowerSeries.constantCoeff : RStar →+* Ω)))
          (fun i => mkJ₀_mor.hom (MvPolynomial.X i))) (MvPolynomial.C PowerSeries.X) = 0
        rw [MvPolynomial.eval₂Hom_C]
        change mkJ₀_mor.hom (MvPolynomial.C (PowerSeries.constantCoeff PowerSeries.X)) = 0
        rw [PowerSeries.constantCoeff_X, map_zero, map_zero]
      rw [hX0, hX1, hCX, sub_zero, ← map_mul]
      exact (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton _))
    let π₀_mor : CommRingCat.of P₁ ⟶ CommRingCat.of Q₀ :=
      CommRingCat.ofHom (Ideal.Quotient.lift J₁ π₀_raw_mor.hom hπ₀_ker)
    let π₀ := π₀_mor.hom
    letI : Algebra P₁ Q₀ := RingHom.toAlgebra π₀
    let T₁ := TensorProduct RStar (↑A') Ω
    let T₂ := TensorProduct P₁ Q₀ (↑A')
    haveI : IsScalarTower P₁ Q₀ Q₀ := ⟨fun p q₁ q₂ => by
      change (π₀ p * q₁) * q₂ = π₀ p * (q₁ * q₂)
      exact mul_assoc (π₀ p) q₁ q₂⟩
    letI : Algebra RStar T₂ :=
      RingHom.toAlgebra'
        ((Algebra.TensorProduct.includeLeftRingHom : Q₀ →+* T₂).comp
          (mkJ₀_mor.hom.comp
            (MvPolynomial.C.comp (PowerSeries.constantCoeff : RStar →+* Ω))))
        (fun _ _ => @mul_comm T₂ Algebra.TensorProduct.instCommSemiring.toCommMagma _ _)
    let f_Φ : (↑A') →ₐ[RStar] T₂ :=
      { Algebra.TensorProduct.includeRight.toRingHom with
        commutes' := fun r => by
          have hc :=
            (Algebra.TensorProduct.includeRight : (↑A') →ₐ[P₁] T₂).commutes
              (mkJ₁_mor.hom (MvPolynomial.C r))
          have hπ : π₀ (mkJ₁_mor.hom (MvPolynomial.C r)) =
              mkJ₀_mor.hom (MvPolynomial.C (PowerSeries.constantCoeff r)) := by
            change (MvPolynomial.eval₂Hom
              (mkJ₀_mor.hom.comp
                (MvPolynomial.C.comp (PowerSeries.constantCoeff : RStar →+* Ω)))
              (fun i => mkJ₀_mor.hom (MvPolynomial.X i))) (MvPolynomial.C r) = _
            exact MvPolynomial.eval₂Hom_C _ _ r
          exact hc.trans (congrArg (fun q => q ⊗ₜ[P₁] (1 : ↑A')) hπ) }
    let g_Φ : Ω →ₐ[RStar] T₂ :=
      { (Algebra.TensorProduct.includeLeftRingHom : Q₀ →+* T₂).comp
          (mkJ₀_mor.hom.comp MvPolynomial.C) with
        commutes' := fun _ => rfl }
    let Φ : T₁ →+* T₂ :=
      (Algebra.TensorProduct.lift f_Φ g_Φ
        (fun _ _ => @Commute.all T₂ Algebra.TensorProduct.instCommSemiring.toCommMagma _ _)).toRingHom
    have hRStar_tmul : ∀ r : RStar,
        (algebraMap RStar (↑A') r) ⊗ₜ[RStar] (1 : Ω) =
          (1 : ↑A') ⊗ₜ[RStar] (PowerSeries.constantCoeff r) := by
      intro r
      calc (algebraMap RStar (↑A') r) ⊗ₜ[RStar] (1 : Ω)
          = (r • (1 : ↑A')) ⊗ₜ[RStar] (1 : Ω) := by rw [Algebra.smul_def, mul_one]
        _ = (1 : ↑A') ⊗ₜ[RStar] (r • (1 : Ω)) := TensorProduct.smul_tmul r 1 1
        _ = (1 : ↑A') ⊗ₜ[RStar] (PowerSeries.constantCoeff r) := by
            rw [Algebra.smul_def, mul_one]; rfl
    let f_Ψ_raw : MvPolynomial (Fin 2) Ω →+* T₁ :=
      MvPolynomial.eval₂Hom
        (Algebra.TensorProduct.includeRight.toRingHom : Ω →+* T₁)
        (fun i => (ψ_mor.hom (mkJ₁_mor.hom (MvPolynomial.X i))) ⊗ₜ[RStar] (1 : Ω))
    have hf_Ψ_ker : J₀ ≤ RingHom.ker f_Ψ_raw := by
      rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      change f_Ψ_raw (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      change ((ψ_mor.hom (mkJ₁_mor.hom (MvPolynomial.X 0))) ⊗ₜ[RStar] (1 : Ω)) *
        ((ψ_mor.hom (mkJ₁_mor.hom (MvPolynomial.X 1))) ⊗ₜ[RStar] (1 : Ω)) = 0
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul, ← map_mul]
      have hX01 : mkJ₁_mor.hom (MvPolynomial.X 0 * MvPolynomial.X 1) =
          mkJ₁_mor.hom (MvPolynomial.C PowerSeries.X) :=
        Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [hX01]
      change (algebraMap RStar (↑A') PowerSeries.X) ⊗ₜ[RStar] (1 : Ω) = 0
      rw [hRStar_tmul, PowerSeries.constantCoeff_X, TensorProduct.tmul_zero]
    let f_Ψ_mor : CommRingCat.of Q₀ ⟶ CommRingCat.of T₁ :=
      CommRingCat.ofHom (Ideal.Quotient.lift J₀ f_Ψ_raw hf_Ψ_ker)
    let f_Ψ_ring := f_Ψ_mor.hom
    have hf_Ψ_comm : ∀ p : P₁,
        f_Ψ_ring (π₀ p) = (ψ_mor.hom p) ⊗ₜ[RStar] (1 : Ω) := by
      intro p
      obtain ⟨P_mv, rfl⟩ := Ideal.Quotient.mk_surjective p
      have hExt : f_Ψ_ring.comp (π₀.comp mkJ₁_mor.hom) =
          ((Algebra.TensorProduct.includeLeftRingHom : (↑A') →+* T₁).comp
            (ψ_mor.hom.comp mkJ₁_mor.hom)) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          have hπ : π₀ (mkJ₁_mor.hom (MvPolynomial.C r)) =
              mkJ₀_mor.hom (MvPolynomial.C (PowerSeries.constantCoeff r)) := by
            change (MvPolynomial.eval₂Hom
              (mkJ₀_mor.hom.comp
                (MvPolynomial.C.comp (PowerSeries.constantCoeff : RStar →+* Ω)))
              (fun i => mkJ₀_mor.hom (MvPolynomial.X i))) (MvPolynomial.C r) = _
            exact MvPolynomial.eval₂Hom_C _ _ r
          have hfC : f_Ψ_ring (mkJ₀_mor.hom (MvPolynomial.C (PowerSeries.constantCoeff r))) =
              (1 : ↑A') ⊗ₜ[RStar] (PowerSeries.constantCoeff r) := by
            change f_Ψ_raw (MvPolynomial.C (PowerSeries.constantCoeff r)) = _
            exact MvPolynomial.eval₂Hom_C _ _ (PowerSeries.constantCoeff r)
          change f_Ψ_ring (π₀ (mkJ₁_mor.hom (MvPolynomial.C r))) =
            (algebraMap RStar (↑A') r) ⊗ₜ[RStar] (1 : Ω)
          rw [hπ, hfC]
          exact (hRStar_tmul r).symm
        · intro i
          change f_Ψ_ring (π₀ (mkJ₁_mor.hom (MvPolynomial.X i))) =
            (ψ_mor.hom (mkJ₁_mor.hom (MvPolynomial.X i))) ⊗ₜ[RStar] (1 : Ω)
          have hπX : π₀ (mkJ₁_mor.hom (MvPolynomial.X i)) = mkJ₀_mor.hom (MvPolynomial.X i) :=
            MvPolynomial.eval₂Hom_X' _ _ i
          rw [hπX]
          exact MvPolynomial.eval₂Hom_X' _ _ i
      exact RingHom.congr_fun hExt P_mv
    letI : Algebra P₁ T₁ :=
      @RingHom.toAlgebra' P₁ T₁ CommRing.toCommSemiring Algebra.TensorProduct.instSemiring
        ((Algebra.TensorProduct.includeLeftRingHom : (↑A') →+* T₁).comp ψ_mor.hom)
        (fun _ _ => @mul_comm T₁ Algebra.TensorProduct.instCommSemiring.toCommMagma _ _)
    let f_Ψ : Q₀ →ₐ[P₁] T₁ :=
      { f_Ψ_ring with commutes' := hf_Ψ_comm }
    let g_Ψ : (↑A') →ₐ[P₁] T₁ :=
      { (Algebra.TensorProduct.includeLeftRingHom : (↑A') →+* T₁) with
        commutes' := fun _ => rfl }
    haveI : IsScalarTower P₁ P₁ Q₀ := ⟨fun x y z => by
      change π₀ (x * y) * z = π₀ x * (π₀ y * z)
      rw [map_mul, mul_assoc]⟩
    haveI : IsScalarTower P₁ P₁ T₁ := ⟨fun x y z => by
      change ((Algebra.TensorProduct.includeLeftRingHom : (↑A') →+* T₁) (ψ_mor.hom (x * y))) * z =
        ((Algebra.TensorProduct.includeLeftRingHom : (↑A') →+* T₁) (ψ_mor.hom x)) *
          (((Algebra.TensorProduct.includeLeftRingHom : (↑A') →+* T₁) (ψ_mor.hom y)) * z)
      rw [map_mul, map_mul, @mul_assoc T₁ Algebra.TensorProduct.instSemiring.toSemigroup]⟩
    let Ψ : T₂ →+* T₁ :=
      (Algebra.TensorProduct.lift f_Ψ g_Ψ
        (fun _ _ => @Commute.all T₁ Algebra.TensorProduct.instCommSemiring.toCommMagma _ _)).toRingHom
    have hΨΦ : Function.LeftInverse Ψ Φ := by
      intro z
      refine TensorProduct.induction_on (motive := fun w => Ψ (Φ w) = w) z ?_ ?_ ?_
      · rw [map_zero, map_zero]
      · intro a c
        have hΦ_tmul : Φ (a ⊗ₜ[RStar] c) =
            ((1 : Q₀) ⊗ₜ[P₁] a) *
              ((mkJ₀_mor.hom (MvPolynomial.C c)) ⊗ₜ[P₁] (1 : ↑A')) :=
          Algebra.TensorProduct.lift_tmul f_Φ g_Φ
            (fun _ _ => @Commute.all T₂ Algebra.TensorProduct.instCommSemiring.toCommMagma _ _) a c
        rw [hΦ_tmul, map_mul]
        have hΨ1 : Ψ ((1 : Q₀) ⊗ₜ[P₁] a) = a ⊗ₜ[RStar] (1 : Ω) := by
          change (Algebra.TensorProduct.lift f_Ψ g_Ψ _) ((1 : Q₀) ⊗ₜ[P₁] a) = _
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl
        have hΨ2 : Ψ ((mkJ₀_mor.hom (MvPolynomial.C c)) ⊗ₜ[P₁] (1 : ↑A')) =
            (1 : ↑A') ⊗ₜ[RStar] c := by
          change (Algebra.TensorProduct.lift f_Ψ g_Ψ _) _ = _
          rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
          exact MvPolynomial.eval₂Hom_C _ _ c
        rw [hΨ1, hΨ2, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · intro x y hx hy
        rw [map_add, map_add, hx, hy]
    have hΦ_inj : Function.Injective Φ := hΨΦ.injective
    let q_L_raw : MvPolynomial (Fin 2) Ω →+* Polynomial Ω :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = 0 then Polynomial.X else 0)
    let q_R_raw : MvPolynomial (Fin 2) Ω →+* Polynomial Ω :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = 0 then 0 else Polynomial.X)
    have hqL_ker : J₀ ≤ RingHom.ker q_L_raw := by
      rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      simp [q_L_raw]
    have hqR_ker : J₀ ≤ RingHom.ker q_R_raw := by
      rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      simp [q_R_raw]
    let q_L_mor : CommRingCat.of Q₀ ⟶ CommRingCat.of (Polynomial Ω) :=
      CommRingCat.ofHom (Ideal.Quotient.lift J₀ q_L_raw hqL_ker)
    let q_R_mor : CommRingCat.of Q₀ ⟶ CommRingCat.of (Polynomial Ω) :=
      CommRingCat.ofHom (Ideal.Quotient.lift J₀ q_R_raw hqR_ker)
    let q_L := q_L_mor.hom
    let q_R := q_R_mor.hom
    have hqL_aeval0 : ∀ f : Polynomial Ω,
        q_L_raw (Polynomial.aeval (MvPolynomial.X 0) f) = f := by
      have hExt : q_L_raw.comp (Polynomial.aeval (MvPolynomial.X 0)).toRingHom =
          RingHom.id (Polynomial Ω) := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [q_L_raw]
        · simp [q_L_raw]
      intro f
      exact RingHom.congr_fun hExt f
    have hqR_aeval1 : ∀ f : Polynomial Ω,
        q_R_raw (Polynomial.aeval (MvPolynomial.X 1) f) = f := by
      have hExt : q_R_raw.comp (Polynomial.aeval (MvPolynomial.X 1)).toRingHom =
          RingHom.id (Polynomial Ω) := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [q_R_raw]
        · simp [q_R_raw]
      intro f
      exact RingHom.congr_fun hExt f
    have hNormForm : ∀ P : MvPolynomial (Fin 2) Ω,
        ∃ (c₀ : Ω) (f₀ g₀ : Polynomial Ω),
          Ideal.Quotient.mk J₀ P =
            Ideal.Quotient.mk J₀
              (MvPolynomial.C c₀ +
                MvPolynomial.X 0 * Polynomial.aeval (MvPolynomial.X 0) f₀ +
                MvPolynomial.X 1 * Polynomial.aeval (MvPolynomial.X 1) g₀) := by
      intro P
      refine MvPolynomial.induction_on (motive := fun P =>
        ∃ (c₀ : Ω) (f₀ g₀ : Polynomial Ω),
          Ideal.Quotient.mk J₀ P =
            Ideal.Quotient.mk J₀
              (MvPolynomial.C c₀ +
                MvPolynomial.X 0 * Polynomial.aeval (MvPolynomial.X 0) f₀ +
                MvPolynomial.X 1 * Polynomial.aeval (MvPolynomial.X 1) g₀)) P ?_ ?_ ?_
      · intro c
        refine ⟨c, 0, 0, ?_⟩
        simp
      · rintro p₁ p₂ ⟨c₁, f₁, g₁, h₁⟩ ⟨c₂, f₂, g₂, h₂⟩
        refine ⟨c₁ + c₂, f₁ + f₂, g₁ + g₂, ?_⟩
        rw [map_add, h₁, h₂, ← map_add]
        congr 1
        simp only [map_add]
        ring
      · rintro p i ⟨c₀, f₀, g₀, hp⟩
        rw [map_mul, hp]
        refine Fin.cases ?_ ?_ i
        · refine ⟨0, Polynomial.C c₀ + Polynomial.X * f₀, 0, ?_⟩
          rw [← map_mul]
          apply Ideal.Quotient.eq.mpr
          have hEq : (MvPolynomial.C c₀ +
                MvPolynomial.X (0 : Fin 2) * (Polynomial.aeval (MvPolynomial.X (0 : Fin 2))) f₀ +
                MvPolynomial.X (1 : Fin 2) * (Polynomial.aeval (MvPolynomial.X (1 : Fin 2))) g₀) *
              MvPolynomial.X (0 : Fin 2) -
              (MvPolynomial.C (0 : Ω) +
                MvPolynomial.X (0 : Fin 2) *
                  (Polynomial.aeval (MvPolynomial.X (0 : Fin 2))) (Polynomial.C c₀ + Polynomial.X * f₀) +
                MvPolynomial.X (1 : Fin 2) *
                  (Polynomial.aeval (MvPolynomial.X (1 : Fin 2))) (0 : Polynomial Ω)) =
              (MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) *
                (Polynomial.aeval (MvPolynomial.X (1 : Fin 2))) g₀ := by
            simp only [map_zero, map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X,
              MvPolynomial.algebraMap_eq]
            ring
          rw [hEq]
          exact Ideal.mul_mem_right _ J₀ (Ideal.subset_span (Set.mem_singleton _))
        · intro j
          have hj : j = 0 := Subsingleton.elim j 0
          subst hj
          have hsucc : Fin.succ (0 : Fin 1) = (1 : Fin 2) := rfl
          rw [hsucc]
          refine ⟨0, 0, Polynomial.C c₀ + Polynomial.X * g₀, ?_⟩
          rw [← map_mul]
          apply Ideal.Quotient.eq.mpr
          have hEq : (MvPolynomial.C c₀ +
                MvPolynomial.X (0 : Fin 2) * (Polynomial.aeval (MvPolynomial.X (0 : Fin 2))) f₀ +
                MvPolynomial.X (1 : Fin 2) * (Polynomial.aeval (MvPolynomial.X (1 : Fin 2))) g₀) *
              MvPolynomial.X (1 : Fin 2) -
              (MvPolynomial.C (0 : Ω) +
                MvPolynomial.X (0 : Fin 2) *
                  (Polynomial.aeval (MvPolynomial.X (0 : Fin 2))) (0 : Polynomial Ω) +
                MvPolynomial.X (1 : Fin 2) *
                  (Polynomial.aeval (MvPolynomial.X (1 : Fin 2))) (Polynomial.C c₀ + Polynomial.X * g₀)) =
              (MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) *
                (Polynomial.aeval (MvPolynomial.X (0 : Fin 2))) f₀ := by
            simp only [map_zero, map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X,
              MvPolynomial.algebraMap_eq]
            ring
          rw [hEq]
          exact Ideal.mul_mem_right _ J₀ (Ideal.subset_span (Set.mem_singleton _))
    have hq_inj : ∀ z : Q₀, q_L z = 0 → q_R z = 0 → z = 0 := by
      intro z hzL hzR
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨c₀, f₀, g₀, hP⟩ := hNormForm P
      rw [hP] at hzL hzR ⊢
      have evalL : q_L (Ideal.Quotient.mk J₀
          (MvPolynomial.C c₀ +
            MvPolynomial.X 0 * Polynomial.aeval (MvPolynomial.X 0) f₀ +
            MvPolynomial.X 1 * Polynomial.aeval (MvPolynomial.X 1) g₀)) =
          Polynomial.C c₀ + Polynomial.X * f₀ := by
        change q_L_raw _ = _
        simp only [map_add, map_mul, hqL_aeval0]
        have hC : q_L_raw (MvPolynomial.C c₀) = Polynomial.C c₀ := by simp [q_L_raw]
        have hX0 : q_L_raw (MvPolynomial.X 0) = Polynomial.X := by simp [q_L_raw]
        have hX1 : q_L_raw (MvPolynomial.X 1) = 0 := by simp [q_L_raw]
        rw [hC, hX0, hX1, zero_mul, add_zero]
      have evalR : q_R (Ideal.Quotient.mk J₀
          (MvPolynomial.C c₀ +
            MvPolynomial.X 0 * Polynomial.aeval (MvPolynomial.X 0) f₀ +
            MvPolynomial.X 1 * Polynomial.aeval (MvPolynomial.X 1) g₀)) =
          Polynomial.C c₀ + Polynomial.X * g₀ := by
        change q_R_raw _ = _
        simp only [map_add, map_mul, hqR_aeval1]
        have hC : q_R_raw (MvPolynomial.C c₀) = Polynomial.C c₀ := by simp [q_R_raw]
        have hX0 : q_R_raw (MvPolynomial.X 0) = 0 := by simp [q_R_raw]
        have hX1 : q_R_raw (MvPolynomial.X 1) = Polynomial.X := by simp [q_R_raw]
        rw [hC, hX0, hX1, zero_mul, add_zero]
      rw [evalL] at hzL
      rw [evalR] at hzR
      have hc₀ : c₀ = 0 := by
        have h0 := congrArg (fun p => Polynomial.coeff p 0) hzL
        simpa using h0
      subst hc₀
      simp only [map_zero, zero_add] at hzL hzR
      have hf₀ : f₀ = 0 := mul_left_cancel₀ Polynomial.X_ne_zero (hzL.trans (mul_zero _).symm)
      have hg₀ : g₀ = 0 := mul_left_cancel₀ Polynomial.X_ne_zero (hzR.trans (mul_zero _).symm)
      subst hf₀ hg₀
      simp
    let K_L := FractionRing (Polynomial Ω)
    let K_R := FractionRing (MvPolynomial Unit Ω)
    have hT₂_red : ∀ (P₁' Q₀' : Type u) [CommRing P₁'] [CommRing Q₀']
        [Algebra P₁' (↑A')] [Algebra.Etale P₁' (↑A')] [Algebra P₁' Q₀']
        (π_L' : Q₀' →+* K_L) (π_R' : Q₀' →+* K_R),
        (∀ z : Q₀', π_L' z = 0 → π_R' z = 0 → z = 0) →
        _root_.IsReduced (TensorProduct P₁' Q₀' (↑A')) := by
      intro P₁' Q₀' _ _ _ _ _ π_L' π_R' h_inj
      let _ : Algebra Q₀' K_L := π_L'.toAlgebra
      let _ : Algebra Q₀' K_R := π_R'.toAlgebra
      have hδ'_inj : Function.Injective (algebraMap Q₀' (K_L × K_R)) := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        exact h_inj z (Prod.ext_iff.mp hz).1 (Prod.ext_iff.mp hz).2
      let T₂' := TensorProduct P₁' Q₀' (↑A')
      let incT₂' : T₂' →ₐ[Q₀'] TensorProduct Q₀' T₂' (K_L × K_R) :=
        Algebra.TensorProduct.includeLeft
      have hInc'_inj : Function.Injective incT₂'.toRingHom :=
        Algebra.TensorProduct.includeLeft_injective (S := Q₀') hδ'_inj
      have : _root_.IsReduced (TensorProduct Q₀' K_L T₂') :=
        Algebra.FormallyUnramified.isReduced_of_field K_L (TensorProduct Q₀' K_L T₂')
      have : _root_.IsReduced (TensorProduct Q₀' K_R T₂') :=
        Algebra.FormallyUnramified.isReduced_of_field K_R (TensorProduct Q₀' K_R T₂')
      have : _root_.IsReduced (TensorProduct Q₀' T₂' K_L) :=
        isReduced_of_injective (Algebra.TensorProduct.comm Q₀' T₂' K_L).toRingHom
          (AlgEquiv.injective _)
      have : _root_.IsReduced (TensorProduct Q₀' T₂' K_R) :=
        isReduced_of_injective (Algebra.TensorProduct.comm Q₀' T₂' K_R).toRingHom
          (AlgEquiv.injective _)
      have : _root_.IsReduced (TensorProduct Q₀' T₂' (K_L × K_R)) :=
        isReduced_of_injective (Algebra.TensorProduct.prodRight Q₀' Q₀' T₂' K_L K_R).toRingHom
          (AlgEquiv.injective _)
      exact isReduced_of_injective incT₂'.toRingHom hInc'_inj
    let ι_L : Polynomial Ω →+* K_L := algebraMap (Polynomial Ω) K_L
    let ι_R : Polynomial Ω →+* K_R :=
      (algebraMap (MvPolynomial Unit Ω) K_R).comp
        (MvPolynomial.uniqueAlgEquiv Ω Unit).symm.toRingHom
    let π_L_mor : CommRingCat.of Q₀ ⟶ CommRingCat.of K_L :=
      CommRingCat.ofHom (ι_L.comp q_L)
    let π_R_mor : CommRingCat.of Q₀ ⟶ CommRingCat.of K_R :=
      CommRingCat.ofHom (ι_R.comp q_R)
    have hιL_inj : Function.Injective ι_L := IsFractionRing.injective (Polynomial Ω) K_L
    have hιR_inj : Function.Injective ι_R :=
      (IsFractionRing.injective (MvPolynomial Unit Ω) K_R).comp
        (AlgEquiv.injective (MvPolynomial.uniqueAlgEquiv Ω Unit).symm)
    haveI : _root_.IsReduced T₂ :=
      hT₂_red P₁ Q₀ π_L_mor.hom π_R_mor.hom (fun z hzL hzR =>
        hq_inj z
          (hιL_inj (hzL.trans (map_zero _).symm))
          (hιR_inj (hzR.trans (map_zero _).symm)))
    haveI : _root_.IsReduced T₁ := isReduced_of_injective Φ hΦ_inj
    have h_eg : e_C ≫ g =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap RStar (↑A'))) := by
      rw [hcomm, ← hq_map, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    let iso_pb : CategoryTheory.Limits.pullback (e_C ≫ g) s_Ω ≅
        AlgebraicGeometry.Spec (CommRingCat.of T₁) :=
      CategoryTheory.Limits.pullback.congrHom h_eg rfl ≪≫
        AlgebraicGeometry.pullbackSpecIso RStar (↑A') Ω
    have hRedA' : AlgebraicGeometry.IsReduced
        (CategoryTheory.Limits.pullback (e_C ≫ g) s_Ω) :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion iso_pb.hom
    exact hEtaleStalk (AlgebraicGeometry.Spec A') e_C heC hRedA' v₀ hv₀

theorem weil_smoothSpecialPoint_hasNCBranchAt (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (hInt : AlgebraicGeometry.IsIntegral C)
    (hFlat : AlgebraicGeometry.Flat g)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (q₀ : ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hq₀ : IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))))
    (V : C.Opens)
    (hwV : (CategoryTheory.Limits.pullback.fst g
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))).base q₀ ∈ V)
    (hSmV : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) :
    HasNCBranchAt Ω g q₀ 1 0 :=
by
  have _ := hFlat
  have _ := hLFP
  let cCoeff : PowerSeries Ω →+* Ω := PowerSeries.constantCoeff
  let s_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom cCoeff)
  let fst₀ := CategoryTheory.Limits.pullback.fst g s_Ω
  let snd₀ := CategoryTheory.Limits.pullback.snd g s_Ω
  let w : C := fst₀.base q₀
  
  have hChart : ∃ (R_sm : CommRingCat.{u}) (p_sm : AlgebraicGeometry.Spec R_sm)
      (ι_sm : AlgebraicGeometry.Spec R_sm ⟶ C)
      (ψ_et : MvPolynomial (Fin 1) (PowerSeries Ω) →+* R_sm),
      AlgebraicGeometry.IsOpenImmersion ι_sm ∧
      ι_sm.base p_sm = w ∧
      IsDomain R_sm ∧
      p_sm.asIdeal.IsMaximal ∧
      (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom PowerSeries.X ∈ p_sm.asIdeal ∧
      ψ_et.comp MvPolynomial.C = (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom ∧
      ψ_et.Etale := by
    have hgw_eq : g.base w = s_Ω.base (snd₀.base q₀) := by
      have hcond := congrArg (fun φ => φ.base q₀)
        (CategoryTheory.Limits.pullback.condition (f := g) (g := s_Ω))
      simpa [w, fst₀, snd₀] using hcond
    have hy_bot : (snd₀.base q₀).asIdeal = ⊥ := by
      ext a
      simp only [Ideal.mem_bot]
      constructor
      · intro ha
        by_contra hne
        apply (snd₀.base q₀).isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have hmul := (snd₀.base q₀).asIdeal.mul_mem_left a⁻¹ ha
        rwa [inv_mul_cancel₀ hne] at hmul
      · rintro rfl
        exact (snd₀.base q₀).asIdeal.zero_mem
    have hgw_ideal : (g.base w).asIdeal = IsLocalRing.maximalIdeal (PowerSeries Ω) := by
      rw [hgw_eq]
      change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom cCoeff)).base (snd₀.base q₀)).asIdeal = _
      rw [AlgebraicGeometry.Spec.map_apply]
      change Ideal.comap cCoeff (snd₀.base q₀).asIdeal = _
      rw [hy_bot]
      exact PowerSeries.ker_coeff_eq_max_ideal
    have hX_gw : (PowerSeries.X : PowerSeries Ω) ∈ (g.base w).asIdeal := by
      rw [hgw_ideal, ← PowerSeries.ker_coeff_eq_max_ideal, RingHom.mem_ker]
      exact PowerSeries.constantCoeff_X
    let x_V : ↥V.toScheme := ⟨w, hwV⟩
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g) := hSmV
    obtain ⟨U_S, hU_S, V_sm, hV_sm, hx_V, e_le, h_std⟩ :=
      AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
        (n := 1) (f := V.ι ≫ g) x_V
    have hgw_in_US : g.base w ∈ U_S := by
      have hx_in : g.base (V.ι.base x_V) ∈ U_S := e_le hx_V
      simpa [x_V] using hx_in
    have hUS_univ : (U_S : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))) =
        Set.univ := by
      ext q
      simp only [Set.mem_univ, iff_true]
      by_contra hq_not
      obtain ⟨I_cl, hI_cl⟩ :=
        (PrimeSpectrum.isClosed_iff_zeroLocus _).mp U_S.isOpen.isClosed_compl
      have hq_zl : (q : PrimeSpectrum (PowerSeries Ω)) ∈ PrimeSpectrum.zeroLocus I_cl :=
        hI_cl ▸ Set.mem_compl hq_not
      have hq_sub : I_cl ⊆ q.asIdeal := (PrimeSpectrum.mem_zeroLocus q I_cl).mp hq_zl
      have hq_le : q.asIdeal ≤ (g.base w).asIdeal := by
        rw [hgw_ideal]
        exact IsLocalRing.le_maximalIdeal q.isPrime.ne_top
      have hgw_zl : (g.base w : PrimeSpectrum (PowerSeries Ω)) ∈ PrimeSpectrum.zeroLocus I_cl :=
        (PrimeSpectrum.mem_zeroLocus (g.base w) I_cl).mpr (Set.Subset.trans hq_sub hq_le)
      have hgw_compl : g.base w ∈ (U_S : Set _)ᶜ := hI_cl ▸ hgw_zl
      exact hgw_compl hgw_in_US
    have hSurj_US : AlgebraicGeometry.Surjective hU_S.fromSpec :=
      ⟨fun q => by
        have hq : q ∈ Set.range hU_S.fromSpec.base := by
          rw [hU_S.range_fromSpec, hUS_univ]
          trivial
        exact hq⟩
    have : CategoryTheory.IsIso hU_S.fromSpec :=
      (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective hU_S.fromSpec).mpr
        ⟨inferInstance, hSurj_US⟩
    let R_sm : CommRingCat.{u} := V.toScheme.presheaf.obj (Opposite.op V_sm)
    let ι_sm : AlgebraicGeometry.Spec R_sm ⟶ C := hV_sm.fromSpec ≫ V.ι
    let p_sm : AlgebraicGeometry.Spec R_sm := hV_sm.primeIdealOf ⟨x_V, hx_V⟩
    have : AlgebraicGeometry.IsOpenImmersion ι_sm := inferInstance
    have hp_base : ι_sm.base p_sm = w := by
      change V.ι.base (hV_sm.fromSpec.base p_sm) = w
      rw [hV_sm.fromSpec_primeIdealOf]
      simp [x_V]
    have : Nonempty ↥(AlgebraicGeometry.Spec R_sm) := ⟨p_sm⟩
    have : AlgebraicGeometry.IsIntegral C := hInt
    have hInt_sm : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R_sm) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion ι_sm
    have hDom_sm : IsDomain R_sm :=
      (AlgebraicGeometry.affine_isIntegral_iff R_sm).mp hInt_sm
    have hcCoeff_surj : Function.Surjective cCoeff :=
      fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩
    have : AlgebraicGeometry.IsClosedImmersion s_Ω :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom cCoeff) hcCoeff_surj
    have : AlgebraicGeometry.IsClosedImmersion fst₀ := inferInstance
    have hw_closed : IsClosed ({w} : Set ↥C) := by
      have himg := fst₀.isClosedEmbedding.isClosedMap {q₀} hq₀
      rwa [Set.image_singleton] at himg
    have hp_pre : ι_sm.base ⁻¹' ({w} : Set ↥C) = {p_sm} := by
      ext p
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun hp => ι_sm.isOpenEmbedding.injective (hp.trans hp_base.symm),
        fun hp => hp.symm ▸ hp_base⟩
    have hp_closed : IsClosed ({p_sm} : Set (PrimeSpectrum R_sm)) := by
      have hpre : IsClosed (ι_sm.base ⁻¹' ({w} : Set ↥C)) :=
        hw_closed.preimage ι_sm.continuous
      rwa [hp_pre] at hpre
    have hp_max : p_sm.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_sm).mp hp_closed
    let θ_hom := AlgebraicGeometry.Spec.preimage hU_S.fromSpec
    let θ_inv := AlgebraicGeometry.Spec.preimage (CategoryTheory.inv hU_S.fromSpec)
    have hθ_hom_inv : θ_hom ≫ θ_inv = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.preimage_comp, CategoryTheory.IsIso.inv_hom_id,
        AlgebraicGeometry.Spec.preimage_id]
    have hθ_inv_hom : θ_inv ≫ θ_hom = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.preimage_comp, CategoryTheory.IsIso.hom_inv_id,
        AlgebraicGeometry.Spec.preimage_id]
    let e_θ : PowerSeries Ω ≃+*
        ↑((AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))).presheaf.obj
          (Opposite.op U_S)) :=
      { toFun := θ_hom.hom
        invFun := θ_inv.hom
        left_inv := fun x => congrArg (fun φ : CommRingCat.of (PowerSeries Ω) ⟶ _ => φ.hom x) hθ_hom_inv
        right_inv := fun y => congrArg
          (fun φ : (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))).presheaf.obj
            (Opposite.op U_S) ⟶ _ => φ.hom y) hθ_inv_hom
        map_mul' := θ_hom.hom.map_mul
        map_add' := θ_hom.hom.map_add }
    have h_app_comp : ι_sm ≫ g =
        AlgebraicGeometry.Spec.map ((V.ι ≫ g).appLE U_S V_sm e_le) ≫ hU_S.fromSpec := by
      rw [hU_S.SpecMap_appLE_fromSpec (V.ι ≫ g) hV_sm e_le, CategoryTheory.Category.assoc]
    have h_pre_eq : (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom =
        ((V.ι ≫ g).appLE U_S V_sm e_le).hom.comp e_θ.toRingHom := by
      rw [h_app_comp, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
      rfl
    have h_std_sm : RingHom.IsStandardSmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom := by
      rw [h_pre_eq]
      exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).right
        ((V.ι ≫ g).appLE U_S V_sm e_le).hom e_θ h_std
    obtain ⟨ψ_et, hψ_comp, hEt⟩ :=
      RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial h_std_sm
    have hX_mem : (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom PowerSeries.X ∈ p_sm.asIdeal := by
      have hmap_p : (AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g))).base p_sm = g.base w := by
        rw [AlgebraicGeometry.Spec.map_preimage]
        change g.base (ι_sm.base p_sm) = g.base w
        rw [hp_base]
      have hcomap : Ideal.comap (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom p_sm.asIdeal =
          (g.base w).asIdeal := by
        have h1 := congrArg PrimeSpectrum.asIdeal hmap_p
        rwa [AlgebraicGeometry.Spec.map_apply] at h1
      change PowerSeries.X ∈ Ideal.comap (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom p_sm.asIdeal
      rwa [hcomap]
    exact ⟨R_sm, p_sm, ι_sm, ψ_et, inferInstance, hp_base, hDom_sm, hp_max, hX_mem, hψ_comp, hEt⟩
  obtain ⟨R_sm, p_sm, ι_sm, ψ_et, hOpen_sm, hp_base, hDom_sm, hp_max, hX_sm, hψ_comp, hEt⟩ := hChart
  have : IsDomain R_sm := hDom_sm
  let m_sm : Ideal R_sm := p_sm.asIdeal
  have : m_sm.IsMaximal := hp_max
  have hX_ψ : ψ_et (MvPolynomial.C PowerSeries.X) ∈ m_sm := by
    have h1 : (ψ_et.comp MvPolynomial.C) PowerSeries.X =
        (AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom PowerSeries.X := by
      rw [hψ_comp]
    simpa [RingHom.comp_apply, m_sm] using h1.symm ▸ hX_sm
  
  have hCrux : ∃ (c₀ : Ω) (f : R_sm),
      f ∉ m_sm ∧
      ψ_et (MvPolynomial.X 0 - MvPolynomial.C (PowerSeries.C c₀)) ∈ m_sm ∧
      (∀ x ∈ m_sm, f * x ∈ Ideal.span ({ψ_et (MvPolynomial.C PowerSeries.X),
        ψ_et (MvPolynomial.X 0 - MvPolynomial.C (PowerSeries.C c₀))} : Set R_sm)) ∧
      (∀ r : R_sm, ∃ c : Ω, r - ψ_et (MvPolynomial.C (PowerSeries.C c)) ∈ m_sm) := by
    let P := MvPolynomial (Fin 1) (PowerSeries Ω)
    let κ := R_sm ⧸ m_sm
    let : Field κ := Ideal.Quotient.field m_sm
    let : Algebra P R_sm := ψ_et.toAlgebra
    let : Algebra (PowerSeries Ω) R_sm := (ψ_et.comp MvPolynomial.C).toAlgebra
    let : Algebra Ω R_sm := (ψ_et.comp (MvPolynomial.C.comp PowerSeries.C)).toAlgebra
    have : IsScalarTower (PowerSeries Ω) P R_sm := IsScalarTower.of_algebraMap_eq' rfl
    have : IsScalarTower Ω (PowerSeries Ω) R_sm := IsScalarTower.of_algebraMap_eq' rfl
    have : IsScalarTower Ω (PowerSeries Ω) κ := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale P R_sm := (RingHom.etale_algebraMap (R := P) (S := R_sm)).mp hEt
    have : Algebra.FiniteType (PowerSeries Ω) R_sm :=
      Algebra.FiniteType.trans (R := PowerSeries Ω) (S := P) (A := R_sm) inferInstance inferInstance
    have hFT_ps : Algebra.FiniteType (PowerSeries Ω) κ :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ (PowerSeries Ω) m_sm)
        Ideal.Quotient.mk_surjective
    obtain ⟨G₀, hG₀⟩ := hFT_ps.out
    have hX_zero_κ : algebraMap (PowerSeries Ω) κ PowerSeries.X = 0 := by
      change Ideal.Quotient.mk m_sm (ψ_et (MvPolynomial.C PowerSeries.X)) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hX_ψ
    have hFG_Ω : Algebra.FiniteType Ω κ := by
      refine ⟨⟨G₀, eq_top_iff.mpr ?_⟩⟩
      intro x _
      have hx_ps : x ∈ Algebra.adjoin (PowerSeries Ω) (G₀ : Set κ) := by
        rw [hG₀]
        trivial
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx_ps
      · intro s hs
        exact Algebra.subset_adjoin hs
      · intro s
        have hc0 : PowerSeries.constantCoeff (s - PowerSeries.C (PowerSeries.constantCoeff s)) = 0 := by
          simp [PowerSeries.constantCoeff_C]
        obtain ⟨h_s, hh_s⟩ := PowerSeries.X_dvd_iff.mpr hc0
        have hs_eq : s = PowerSeries.C (PowerSeries.constantCoeff s) + PowerSeries.X * h_s :=
          sub_eq_iff_eq_add'.mp hh_s
        have hmap_s : algebraMap (PowerSeries Ω) κ s =
            algebraMap Ω κ (PowerSeries.constantCoeff s) := by
          conv_lhs => rw [hs_eq]
          rw [map_add, map_mul, hX_zero_κ, zero_mul, add_zero]
          rfl
        rw [hmap_s]
        exact (Algebra.adjoin Ω (G₀ : Set κ)).algebraMap_mem _
      · intro a b _ _ ha hb
        exact (Algebra.adjoin Ω (G₀ : Set κ)).add_mem ha hb
      · intro a b _ _ ha hb
        exact (Algebra.adjoin Ω (G₀ : Set κ)).mul_mem ha hb
    have hRes : ∀ r : R_sm, ∃ c : Ω, r - ψ_et (MvPolynomial.C (PowerSeries.C c)) ∈ m_sm := by
      obtain ⟨k_mv, Φ, hΦ_surj⟩ :=
        (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := Ω) (S := κ)).mp hFG_Ω
      have hKer_max : (RingHom.ker Φ.toRingHom).IsMaximal :=
        RingHom.ker_isMaximal_of_surjective Φ.toRingHom hΦ_surj
      obtain ⟨x₀, hx₀⟩ :=
        MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hKer_max
      intro r
      obtain ⟨p_r, hp_r⟩ := hΦ_surj (Ideal.Quotient.mk m_sm r)
      let c : Ω := MvPolynomial.aeval x₀ p_r
      refine ⟨c, ?_⟩
      have hmem_van : p_r - MvPolynomial.C c ∈ MvPolynomial.vanishingIdeal Ω {x₀} := by
        rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp [c]
      have hmem_ker : p_r - MvPolynomial.C c ∈ RingHom.ker Φ.toRingHom := hx₀ ▸ hmem_van
      rw [RingHom.mem_ker, map_sub] at hmem_ker
      have hΦ_eq : Φ p_r = Φ (MvPolynomial.C c) := sub_eq_zero.mp hmem_ker
      have hΦ_C : Φ (MvPolynomial.C c) =
          Ideal.Quotient.mk m_sm (ψ_et (MvPolynomial.C (PowerSeries.C c))) := by
        rw [MvPolynomial.C_eq_algebraMap, AlgHom.commutes]
        rfl
      have hquot_eq : Ideal.Quotient.mk m_sm r =
          Ideal.Quotient.mk m_sm (ψ_et (MvPolynomial.C (PowerSeries.C c))) := by
        rw [← hp_r, hΦ_eq, hΦ_C]
      exact Ideal.Quotient.eq.mp hquot_eq
    obtain ⟨c₀, hc₀_mem⟩ := hRes (ψ_et (MvPolynomial.X 0))
    let w₁ : P := MvPolynomial.C PowerSeries.X
    let w₂ : P := MvPolynomial.X 0 - MvPolynomial.C (PowerSeries.C c₀)
    have hz₂_mem : ψ_et w₂ ∈ m_sm := by
      simpa [w₂, map_sub] using hc₀_mem
    let q_P : Ideal P := Ideal.comap ψ_et m_sm
    have : q_P.IsPrime := Ideal.comap_isPrime ψ_et m_sm
    have h_span_le : Ideal.span ({w₁, w₂} : Set P) ≤ q_P := by
      rw [Ideal.span_le]
      intro p hp
      rcases Set.mem_insert_iff.mp hp with rfl | hp'
      · exact hX_ψ
      · rcases Set.mem_singleton_iff.mp hp' with rfl
        exact hz₂_mem
    let ev₀ : P →+* Ω := MvPolynomial.eval₂Hom cCoeff (fun _ => c₀)
    have hev_mod : ∀ p : P,
        p - MvPolynomial.C (PowerSeries.C (ev₀ p)) ∈ Ideal.span ({w₁, w₂} : Set P) := by
      intro p
      refine MvPolynomial.induction_on
        (motive := fun p => p - MvPolynomial.C (PowerSeries.C (ev₀ p)) ∈ Ideal.span ({w₁, w₂} : Set P))
        p ?_ ?_ ?_
      · intro s
        have hev_C : ev₀ (MvPolynomial.C s) = PowerSeries.constantCoeff s :=
          MvPolynomial.eval₂Hom_C cCoeff (fun _ => c₀) s
        rw [hev_C]
        have hc0 : PowerSeries.constantCoeff (s - PowerSeries.C (PowerSeries.constantCoeff s)) = 0 := by
          simp [PowerSeries.constantCoeff_C]
        obtain ⟨h_s, hh_s⟩ := PowerSeries.X_dvd_iff.mpr hc0
        have hs_eq : MvPolynomial.C s - MvPolynomial.C (PowerSeries.C (PowerSeries.constantCoeff s)) =
            w₁ * MvPolynomial.C h_s := by
          rw [← map_sub, hh_s, map_mul]
        rw [hs_eq]
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
