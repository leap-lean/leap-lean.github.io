    have _ : IsDomain B₁ := hDomB1
    obtain ⟨_, φ_resA, ψ_exc_B1, _, hKer_resA, _, _, hKer_ψ_B1, hψ_B1_s, hψ_B1_r, _⟩ :=
      hLB_A B₁ φ_B1 s_tilde hDomB1 hQuot_B1
    let Δ : A' := m₁₁ * m₂₂ - m₁₂ * m₂₁
    let ℓ₁ : B₁ := φ_B1.hom m₁₁ + φ_B1.hom m₁₂ * s_tilde
    let g₀ : B₁ := φ_B1.hom Δ * ℓ₁ * 1
    obtain ⟨ψ₁, hψ₁_et, hψ₁_comp, _, _, hℓ₁_unit, _⟩ :=
      hMobiusLocEtale B₁ u v φ_B1 s_tilde m₁₁ m₁₂ m₂₁ m₂₂ 1 hQuot_B1 hm₁ hm₂ (Or.inl rfl)
    let C₁ := Localization.Away g₀
    let ι_C1 : B₁ →+* C₁ := algebraMap B₁ C₁
    have hψ_g₀_ne : ψ_exc_B1 g₀ ≠ 0 := by
      dsimp [g₀, ℓ₁]
      rw [mul_one, map_mul, map_add, map_mul, hψ_B1_r, hψ_B1_r, hψ_B1_r, hψ_B1_s]
      have hΔ_res_ne : φ_resA Δ ≠ 0 := by
        intro h0
        apply hDet
        rw [← hKer_resA, RingHom.mem_ker]
        exact h0
      have hCΔ_ne : (Polynomial.C (φ_resA Δ) : Polynomial Ω) ≠ 0 :=
        Polynomial.C_ne_zero.mpr hΔ_res_ne
      have hlin_ne : Polynomial.C (φ_resA m₁₁) + Polynomial.C (φ_resA m₁₂) * Polynomial.X ≠ 0 := by
        intro hlin0
        have hc0 := congrArg (fun p => Polynomial.coeff p 0) hlin0
        have hc1 := congrArg (fun p => Polynomial.coeff p 1) hlin0
        simp at hc0 hc1
        apply hΔ_res_ne
        dsimp [Δ]
        rw [map_sub, map_mul, map_mul, hc0, hc1, zero_mul, zero_mul, sub_self]
      exact mul_ne_zero hCΔ_ne hlin_ne
    have hg₀_ne : g₀ ≠ 0 := fun h0 => hψ_g₀_ne (by rw [h0, map_zero])
    have hinj_C1 : Function.Injective ι_C1 :=
      IsLocalization.injective C₁ (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg₀_ne))
    let Q : Ideal C₁ := Ideal.span ({ι_C1 (φ_B1.hom u)} : Set C₁)
    have h1_not_Q : (1 : C₁) ∉ Q := by
      intro h1Q
      rw [Ideal.mem_span_singleton] at h1Q
      obtain ⟨w, hw⟩ := h1Q
      obtain ⟨⟨w₀, _, m, rfl⟩, hw₀⟩ := IsLocalization.surj (Submonoid.powers g₀) w
      dsimp only at hw₀
      have hB1_eq : φ_B1.hom u * w₀ = g₀ ^ m := by
        apply hinj_C1
        rw [map_mul, ← hw₀, ← mul_assoc, ← hw, one_mul]
