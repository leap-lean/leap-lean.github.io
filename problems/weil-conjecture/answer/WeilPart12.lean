    have hComap_I₁ : Ideal.comap (algebraMap (↑A') B_loc) I₁ = Q₁ :=
      IsLocalization.under_map_of_isPrime_disjoint v₀_ps.asIdeal.primeCompl B_loc hQ₁_prime hDisj_Q₁
