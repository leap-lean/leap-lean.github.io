          change ((Proj.awayToSection 𝒜 (X_var ℓ)) ≫
            (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv).hom (t_away ℓ ℓ') = _
          rw [← Proj.basicOpenIsoAway_hom 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one, Iso.hom_inv_id]
          rfl
        have h_comap := PrimeSpectrum.comap_basicOpen
          (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv.hom (t_A ℓ ℓ')
        rw [h_inv_t] at h_comap
        exact (h_mem1.trans h_mem2).trans (SetLike.ext_iff.mp h_comap q)
      have h_le_lhs : P_A.basicOpen (t_A ℓ ℓ') ≤ D ℓ := P_A.basicOpen_le (t_A ℓ ℓ')
