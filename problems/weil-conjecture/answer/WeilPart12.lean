    have hPb_π₀ : CategoryTheory.IsPullback π₀ fst'' fst' π := by
      refine CategoryTheory.IsPullback.of_right ?_ hπ₀_fst
        (CategoryTheory.IsPullback.of_hasPullback g' s_Ω).flip
      rw [hπ₀_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (π ≫ g') s_Ω).flip
    let W' : Y'.Opens := ⟨({z₀} : Set ↥Y')ᶜ, hz₀_cl.isOpen_compl⟩
    let W'' : Y''.Opens := π₀ ⁻¹ᵁ W'
    let U_compl : C'.Opens := ⟨({x₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩
    have hRange_W' : Set.range (W'.ι ≫ fst').base ⊆ Set.range U_compl.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      change fst'.base w.1 ≠ x₀
