      have hbot_K : (⊥ : Ideal KStar).IsPrime :=
        ⟨bot_ne_top, fun {x y} hxy => by simpa only [Ideal.mem_bot, mul_eq_zero] using hxy⟩
      let pt_K : AlgebraicGeometry.Spec (CommRingCat.of KStar) := ⟨⊥, hbot_K⟩
      have h_ptK_eq : g_W w = η_K pt_K := by
        apply PrimeSpectrum.ext
        ext f
        change f ∈ (g_W w).asIdeal ↔ f ∈ (η_K pt_K).asIdeal
        rw [hgw_bot]
        simp only [Ideal.mem_bot]
        change f = 0 ↔ algebraMap RStar KStar f = 0
        exact ⟨fun h => by rw [h, map_zero],
          fun h => IsFractionRing.injective RStar KStar (h.trans (map_zero _).symm)⟩
      obtain ⟨w_K, hwK_fst, _hwK_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w pt_K h_ptK_eq
      haveI : CategoryTheory.IsIso (fst_K.stalkMap w_K) :=
        AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap fst_K w_K
      let e_fst : ↑(W.presheaf.stalk (fst_K w_K)) ≃+* ↑(W_K.presheaf.stalk w_K) :=
        (CategoryTheory.asIso (fst_K.stalkMap w_K)).commRingCatIsoToRingEquiv
      let e_wK : ↑(W.presheaf.stalk (fst_K w_K)) ≃+* ↑(W.presheaf.stalk w) :=
        (TopCat.Presheaf.stalkCongr W.presheaf (Inseparable.of_eq hwK_fst)).commRingCatIsoToRingEquiv
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 snd_K := hW.2.2.2.2.2.1
      obtain ⟨U_base, _hU_base, V_sm, hV_sm, hw_V, h_le, hStd⟩ :=
        AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
          (n := 1) (f := snd_K) w_K
      have hU_top : U_base = ⊤ := by
        ext q_K
        constructor
        · intro _; trivial
        · intro _
          have hw_in_U : snd_K w_K ∈ U_base := h_le hw_V
          have hq_eq : q_K = snd_K w_K := by
            apply PrimeSpectrum.ext
            have hz1 : q_K.asIdeal = ⊥ :=
              (Ideal.eq_bot_or_top q_K.asIdeal).resolve_right q_K.isPrime.ne_top
            have hz2 : (snd_K w_K).asIdeal = ⊥ :=
              (Ideal.eq_bot_or_top (snd_K w_K).asIdeal).resolve_right (snd_K w_K).isPrime.ne_top
            rw [hz1, hz2]
          rwa [hq_eq]
      let F_base : Type u := ↑((AlgebraicGeometry.Spec (CommRingCat.of KStar)).presheaf.obj
        (Opposite.op U_base))
      let iso_F : (AlgebraicGeometry.Spec (CommRingCat.of KStar)).presheaf.obj
          (Opposite.op U_base) ≅ CommRingCat.of KStar :=
        ((AlgebraicGeometry.Spec (CommRingCat.of KStar)).presheaf.mapIso
          (eqToIso (congrArg Opposite.op hU_top))) ≪≫
          AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of KStar)
      let e_F : F_base ≃+* KStar := iso_F.commRingCatIsoToRingEquiv
      letI : Field F_base :=
        (@MulEquiv.isField _ _ _ _ (Field.toIsField KStar) e_F.toMulEquiv).toField
      let B : Type u := ↑(W_K.presheaf.obj (Opposite.op V_sm))
      obtain ⟨ψ, _hψ_comp, hψ_et⟩ := hStd.exists_etale_mvPolynomial
      let p_sm : Ideal B := (hV_sm.primeIdealOf ⟨w_K, hw_V⟩).asIdeal
      haveI : p_sm.IsPrime := (hV_sm.primeIdealOf ⟨w_K, hw_V⟩).isPrime
      letI : Algebra B ↑(W_K.presheaf.stalk w_K) := (W_K.presheaf.germ V_sm w_K hw_V).hom.toAlgebra
      have hLoc_sm : IsLocalization.AtPrime ↑(W_K.presheaf.stalk w_K) p_sm :=
        hV_sm.isLocalization_stalk ⟨w_K, hw_V⟩
      let e_sm : Localization.AtPrime p_sm ≃+* ↑(W_K.presheaf.stalk w_K) :=
        (IsLocalization.algEquiv p_sm.primeCompl (Localization.AtPrime p_sm)
          ↑(W_K.presheaf.stalk w_K)).toRingEquiv
      let e_stalk : Localization.AtPrime p_sm ≃+* Localization.AtPrime P :=
        e_sm.trans (e_fst.symm.trans (e_wK.trans e_P.symm))
      exact ⟨F_base, B, inferInstance, inferInstance, ψ, p_sm, inferInstance, e_stalk, hψ_et⟩
  have : IsDomain ↑(W.presheaf.obj (Opposite.op U)) :=
    @AlgebraicGeometry.IsIntegral.component_integral W hW.1 U hNE
  apply IsIntegrallyClosed.of_localization_maximal
  intro P _hP_ne_bot hP_max
  have : P.IsMaximal := hP_max
  have hDom_P : IsDomain (Localization.AtPrime P) :=
    IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors P)
  rcases h_s4 P with
    ⟨F_base, B, instF, instB, ψ, p_sm, instPrime, e_stalk, hEt⟩ |
    ⟨L, instCommL, instDomL, instNoethL, instLocL, σ, u₁, u₂, e_stalk, hMax, hu₁, hReg, hRes⟩
  · let : Field F_base := instF
    let : CommRing B := instB
    have : p_sm.IsPrime := instPrime
    have hDom_sm : IsDomain (Localization.AtPrime p_sm) :=
      @MulEquiv.isDomain _ (Localization.AtPrime P) _ _ hDom_P e_stalk.toMulEquiv
    have : IsIntegrallyClosed (Localization.AtPrime p_sm) :=
      h_s1 F_base B ψ hEt p_sm hDom_sm
    exact IsIntegrallyClosed.of_equiv e_stalk
  · let : CommRing L := instCommL
    have : IsDomain L := instDomL
    have : IsNoetherianRing L := instNoethL
    have : IsLocalRing L := instLocL
    obtain ⟨Ψ, hEval1⟩ := h_s2 L σ u₁ u₂ hMax hu₁ hReg hRes
    have : IsIntegrallyClosed L := h_s3 L σ Ψ hEval1
    exact IsIntegrallyClosed.of_equiv e_stalk

theorem weil_regularSimpleNodal_to_nc2d_and_normal (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ) :
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver Ω 1).left ∧
    (∀ (C : AlgebraicGeometry.Scheme.{u})
       (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C)),
       IsRegularSimpleNodalSurface Ω n g τ →
       IsNC2DPointedSurface Ω n g τ ∧
       AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback g s_Ω)) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u})
       (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
       (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W)),
       IsNC2DPointedSurface Ω n g_W τ_W →
       ∀ U : W.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
         IsIntegrallyClosed ↑(W.presheaf.obj (Opposite.op U))) :=
by
  intro s_Ω
  refine ⟨(weil_projectiveSpace_integral_krullDim_and_dim_zero_iso Ω 1).1, ?_, ?_⟩
  · intro C g τ hSurf
    refine ⟨?_, weil_regularSimpleNodal_specialFiber_isReduced Ω n C g τ hSurf⟩
    refine ⟨hSurf.1, hSurf.2.1, hSurf.2.2.1, hSurf.2.2.2.1, hSurf.2.2.2.2.1,
      hSurf.2.2.2.2.2.1, hSurf.2.2.2.2.2.2.1, hSurf.2.2.2.2.2.2.2.1, ?_⟩
    intro q₀ hq₀
    rcases hSurf.2.2.2.2.2.2.2.2.2 ((CategoryTheory.Limits.pullback.fst g s_Ω).base q₀) with
      ⟨V, hwV, hSmV⟩ | ⟨A', v₀, e_C, q, heC, hq, hv₀, hX_mem, _, hcomm⟩
    · exact ⟨1, 0, weil_smoothSpecialPoint_hasNCBranchAt Ω C g
        hSurf.1 hSurf.2.1 hSurf.2.2.2.1 q₀ hq₀ V hwV hSmV⟩
    · exact ⟨1, 1, weil_nodalRoofSpecialPoint_hasNCBranchAt Ω C g
        hSurf.1 hSurf.2.2.2.1 q₀ hq₀ A' v₀ e_C q heC hq hv₀ hX_mem hcomm⟩
  · intro W g_W τ_W hW U hAff hNE
    exact weil_nc2d_affineOpen_isIntegrallyClosed Ω n W g_W τ_W hW U hAff hNE

theorem weil_nc2d_affine_projective_blowup_model (Ω : Type u) [Field Ω]
    (R₀ R₁ R₂ L₀ : CommRingCat.{u}) (p₀ : AlgebraicGeometry.Spec R₀)
    (g_R₀ : AlgebraicGeometry.Spec R₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (z₁ z₂ : R₀) (φ_res : R₀ →+* Ω)
    (φ₁ : R₀ ⟶ R₁) (φ₂ : R₀ ⟶ R₂) (s₁ : R₁) (s₂ : R₂)
    (ι_L0 : R₀ ⟶ L₀) (ι_L1 : R₁ ⟶ L₀) (ι_L2 : R₂ ⟶ L₀)
    (ψ_exc1 : R₁ →+* Polynomial Ω) (ψ_exc2 : R₂ →+* Polynomial Ω)
    (q_exc : AlgebraicGeometry.Spec R₁)
    (hAff_R0 : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R₀ 1 a))
    (c_R0 : ∀ a : Fin 2, R₀ →+* ↑((weilProjectiveSpaceOver R₀ 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen R₀ 1 a))))
    (t_R0 : ∀ a : Fin 2, Fin 2 → ↑((weilProjectiveSpaceOver R₀ 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen R₀ 1 a))))
    (hAff_Ω : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen Ω 1 a))
    (c_Ω : ∀ a : Fin 2, Ω →+* ↑((weilProjectiveSpaceOver Ω 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen Ω 1 a))))
    (t_Ω : ∀ a : Fin 2, Fin 2 → ↑((weilProjectiveSpaceOver Ω 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen Ω 1 a))))
    (Φ_P1 : (weilProjectiveSpaceOver Ω 1).left ⟶ (weilProjectiveSpaceOver R₀ 1).left)
    (hAlg : IsNC2DRegularSeqBlowupRingPkg Ω R₀ R₁ R₂ L₀ p₀
      (AlgebraicGeometry.Spec.preimage g_R₀).hom
      z₁ z₂ φ_res φ₁ φ₂ s₁ s₂ ι_L0 ι_L1 ι_L2 ψ_exc1 ψ_exc2 q_exc)
    (hCoord_R0 : IsCommRingProjCoordSystem R₀ 1 hAff_R0 c_R0 t_R0)
    (hCoord_Ω : IsCommRingProjCoordSystem Ω 1 hAff_Ω c_Ω t_Ω)
    (hBC_P1 : IsCommRingProjBaseChange R₀ Ω φ_res 1 c_R0 t_R0 c_Ω t_Ω Φ_P1) :
    ∃ (U_tilde : AlgebraicGeometry.Scheme.{u})
      (π_U : U_tilde ⟶ AlgebraicGeometry.Spec R₀)
      (ι_U1 : AlgebraicGeometry.Spec R₁ ⟶ U_tilde)
      (ι_U2 : AlgebraicGeometry.Spec R₂ ⟶ U_tilde)
      (Φ_U : (weilProjectiveSpaceOver Ω 1).left ⟶ U_tilde)
      (η_P1 : ↥(weilProjectiveSpaceOver Ω 1).left),
      IsNC2DAffineBlowupModel Ω R₀ R₁ R₂ p₀ g_R₀ φ_res φ₁ φ₂ s₁ s₂ q_exc
        π_U ι_U1 ι_U2 Φ_U η_P1 :=
by
  classical
  let φ₀ : PowerSeries Ω →+* R₀ := (AlgebraicGeometry.Spec.preimage g_R₀).hom
  obtain ⟨hDom₀, hDom₁, hDom₂, hDomL, _hz₁_R0_ne, _hz₂_R0_ne, _hz₁₂_ne, _hreg_symm,
      hp₀_max, hZero_p₀, hSurj_res, hKer_res, _hC_res, hQuot₁, hQuot₂,
      hFlat₁, hFlat₂, hFP₁, hFP₂, _hX1_ne,
      _hz1_ne, _hz2_ne, hs1_ne, hs2_ne,
      hinj_L0, hinj_L1, hinj_L2, hcomp_L1, hcomp_L2, hs12_L,
      _hLoc_L0, _hLoc_L1, _hLoc_L2, hLoc_z1, hLoc_z2, hInter,
      _hSurj_ψ1, hKer_ψ1, hψ1_s, hψ1_r,
      _hSurj_ψ2, hKer_ψ2, hψ2_s, hψ2_r,
      hq_exc_id, _hq_exc_not⟩ := hAlg
  have : IsDomain R₀ := hDom₀
  have : IsDomain R₁ := hDom₁
  have : IsDomain R₂ := hDom₂
  have : IsDomain L₀ := hDomL

  
  have hSubClos : ∀ {B : CommRingCat.{u}} (w₁ w₂ : R₀) (φ_w : R₀ ⟶ B) (s_w : B),
      IsLinearBlowupQuot w₁ w₂ φ_w s_w →
      Subring.closure (Set.range φ_w.hom ∪ {s_w}) = ⊤ := by
    intro B w₁ w₂ φ_w s_w hQ
    let S : Subring B := Subring.closure (Set.range φ_w.hom ∪ {s_w})
    let ρ_S : R₀ →+* ↥S :=
      φ_w.hom.codRestrict S (fun r => Subring.subset_closure (Or.inl ⟨r, rfl⟩))
    let t_S : ↥S := ⟨s_w, Subring.subset_closure (Or.inr rfl)⟩
    have hrel_S : ρ_S w₂ = ρ_S w₁ * t_S := Subtype.ext hQ.1
    obtain ⟨⟨ψ_S, hψ_comp, hψ_s⟩, _⟩ := hQ.2 ↥S ρ_S t_S hrel_S
    have hid : S.subtype.comp ψ_S = RingHom.id B := by
      apply (hQ.2 B φ_w.hom s_w hQ.1).2
      · ext r; exact congrArg Subtype.val (RingHom.congr_fun hψ_comp r)
      · exact congrArg Subtype.val hψ_s
      · rfl
      · rfl
    rw [eq_top_iff]
    intro x _
    have hx : (ψ_S x).1 = x := RingHom.congr_fun hid x
    rw [← hx]; exact (ψ_S x).2
  have hgen₀ := hSubClos z₁ z₂ φ₁ s₁ hQuot₁
  have hgen₁ := hSubClos z₂ z₁ φ₂ s₂ hQuot₂

  let I₁₂ : Ideal R₀ := Ideal.span ({z₁} : Set R₀) ⊔ Ideal.span ({z₂} : Set R₀)
  have hp₀_eq : p₀.asIdeal = I₁₂ := by
    apply le_antisymm
    · intro r hr
      have hres_r : φ_res r = 0 := by rw [← RingHom.mem_ker, hKer_res]; exact hr
      have hker_r : φ₁.hom r ∈ Ideal.span ({φ₁.hom z₁} : Set R₁) := by
        rw [← hKer_ψ1, RingHom.mem_ker, hψ1_r, hres_r, map_zero]
      obtain ⟨y₁, hy₁⟩ := Ideal.mem_span_singleton.mp hker_r
      let q₁₂ : R₀ →+* (↥R₀ ⧸ I₁₂) := Ideal.Quotient.mk I₁₂
      have hq₁₂_z1 : q₁₂ z₁ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.mem_span_singleton_self z₁))
      have hq₁₂_z2 : q₁₂ z₂ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.mem_span_singleton_self z₂))
      have hrel_q : q₁₂ z₂ = q₁₂ z₁ * 0 := by rw [hq₁₂_z2, mul_zero]
      obtain ⟨⟨ψ₀, hψ₀_comp, _⟩, _⟩ := hQuot₁.2 (↥R₀ ⧸ I₁₂) q₁₂ 0 hrel_q
      have hψ₀_r : ∀ a : R₀, ψ₀ (φ₁.hom a) = q₁₂ a := RingHom.congr_fun hψ₀_comp
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change q₁₂ r = 0
      rw [← hψ₀_r r, hy₁, map_mul, hψ₀_r z₁, hq₁₂_z1, zero_mul]
    · apply sup_le
      · rw [Ideal.span_singleton_le_iff_mem, ← hKer_res, RingHom.mem_ker]
        have h1 : ψ_exc1 (φ₁.hom z₁) = 0 := by
          rw [← RingHom.mem_ker, hKer_ψ1]; exact Ideal.mem_span_singleton_self _
        rw [hψ1_r] at h1; exact Polynomial.C_injective (h1.trans Polynomial.C_0.symm)
      · rw [Ideal.span_singleton_le_iff_mem, ← hKer_res, RingHom.mem_ker]
        have h2 : ψ_exc2 (φ₂.hom z₂) = 0 := by
          rw [← RingHom.mem_ker, hKer_ψ2]; exact Ideal.mem_span_singleton_self _
        rw [hψ2_r] at h2; exact Polynomial.C_injective (h2.trans Polynomial.C_0.symm)

  have hg₀_mem : ∀ q : PrimeSpectrum R₂, φ₂.hom z₁ ∉ q.asIdeal → s₂ ∉ q.asIdeal := by
    intro q hnot hs2; apply hnot; rw [hQuot₂.1]; exact q.asIdeal.mul_mem_left _ hs2
  have hg₁_mem : ∀ q : PrimeSpectrum R₁, φ₁.hom z₂ ∉ q.asIdeal → s₁ ∉ q.asIdeal := by
    intro q hnot hs1; apply hnot; rw [hQuot₁.1]; exact q.asIdeal.mul_mem_left _ hs1

  let C₀₁ := Localization.Away s₂
  let α₂ : R₂ →+* C₀₁ := algebraMap R₂ C₀₁
  obtain ⟨u₂, hu₂⟩ : ∃ u₂ : C₀₁, α₂ s₂ * u₂ = 1 :=
    ⟨IsLocalization.Away.invSelf (S := C₀₁) s₂, IsLocalization.Away.mul_invSelf (S := C₀₁) s₂⟩
  have hrel_01 : (α₂.comp φ₂.hom) z₂ = (α₂.comp φ₂.hom) z₁ * u₂ := by
    simp only [RingHom.comp_apply]
    calc α₂ (φ₂.hom z₂) = α₂ (φ₂.hom z₂) * (α₂ s₂ * u₂) := by rw [hu₂, mul_one]
      _ = α₂ (φ₂.hom z₂ * s₂) * u₂ := by rw [map_mul, mul_assoc]
      _ = α₂ (φ₂.hom z₁) * u₂ := by rw [← hQuot₂.1]
  obtain ⟨⟨f₀₁, hf₀₁_comp, hf₀₁_s⟩, _⟩ := hQuot₁.2 C₀₁ (α₂.comp φ₂.hom) u₂ hrel_01
  have hinv : α₂ s₂ * f₀₁ s₁ = 1 := by rw [hf₀₁_s, hu₂]
  have hu_f01 : IsUnit (f₀₁ s₁) := isUnit_iff_exists_inv.mpr ⟨α₂ s₂, by rw [mul_comm, hinv]⟩

  have hu_L2 : IsUnit (ι_L2.hom s₂) :=
    isUnit_iff_exists_inv.mpr ⟨ι_L1.hom s₁, by rw [mul_comm, hs12_L]⟩
  obtain ⟨h_L, hhL_2, hhL_s2⟩ :
      ∃ h_L : C₀₁ →+* L₀, h_L.comp α₂ = ι_L2.hom ∧ h_L (α₂ s₂) = ι_L2.hom s₂ :=
    ⟨IsLocalization.Away.lift s₂ hu_L2,
      RingHom.ext (fun x => IsLocalization.Away.lift_eq s₂ hu_L2 x),
      IsLocalization.Away.lift_eq s₂ hu_L2 s₂⟩
  have hhL_u₂ : h_L u₂ = ι_L1.hom s₁ := by
    calc h_L u₂ = h_L u₂ * (ι_L1.hom s₁ * ι_L2.hom s₂) := by rw [hs12_L, mul_one]
      _ = (h_L (α₂ s₂) * h_L u₂) * ι_L1.hom s₁ := by rw [hhL_s2]; ring
      _ = h_L (α₂ s₂ * u₂) * ι_L1.hom s₁ := by rw [← map_mul]
      _ = ι_L1.hom s₁ := by rw [hu₂, map_one, one_mul]
  have hf10_eq : ι_L1.hom.comp φ₁.hom = ι_L0.hom := congrArg CommRingCat.Hom.hom hcomp_L1
  have hf20_eq : ι_L2.hom.comp φ₂.hom = ι_L0.hom := congrArg CommRingCat.Hom.hom hcomp_L2
  have hhL_1 : h_L.comp f₀₁ = ι_L1.hom := by
    apply (hQuot₁.2 L₀ ι_L0.hom (ι_L1.hom s₁)
      (by rw [← hf10_eq]; simp only [RingHom.comp_apply, hQuot₁.1, map_mul])).2
    · rw [RingHom.comp_assoc, hf₀₁_comp, ← RingHom.comp_assoc, hhL_2, hf20_eq]
    · rw [RingHom.comp_apply, hf₀₁_s, hhL_u₂]
    · exact hf10_eq
    · rfl

  have hR2_clear : ∀ y : R₂, ∃ (d : ℕ) (x₁ : R₁), α₂ y * f₀₁ (s₁ ^ d) = f₀₁ x₁ := by
    intro y
    have hy_mem : y ∈ Subring.closure (Set.range φ₂.hom ∪ {s₂}) := by rw [hgen₁]; trivial
    refine Subring.closure_induction (fun w hw => ?_) ?_ ?_ (fun a b _ _ ha hb => ?_)
      (fun a _ ha => ?_) (fun a b _ _ ha hb => ?_) hy_mem
    · rcases hw with ⟨r, rfl⟩ | rfl
      · refine ⟨0, φ₁.hom r, ?_⟩
        rw [pow_zero, map_one, mul_one]
        exact (RingHom.congr_fun hf₀₁_comp r).symm
      · exact ⟨1, 1, by rw [pow_one, map_one]; exact hinv⟩
    · exact ⟨0, 0, by simp⟩
    · exact ⟨0, 1, by simp⟩
    · obtain ⟨da, xa, hxa⟩ := ha; obtain ⟨db, xb, hxb⟩ := hb
      refine ⟨da + db, xa * s₁ ^ db + xb * s₁ ^ da, ?_⟩
      calc α₂ (a + b) * f₀₁ (s₁ ^ (da + db))
          = (α₂ a * f₀₁ (s₁ ^ da)) * f₀₁ (s₁ ^ db) + (α₂ b * f₀₁ (s₁ ^ db)) * f₀₁ (s₁ ^ da) := by
              rw [map_add, pow_add, map_mul]; ring
        _ = f₀₁ (xa * s₁ ^ db + xb * s₁ ^ da) := by rw [hxa, hxb, map_add, map_mul, map_mul]
    · obtain ⟨da, xa, hxa⟩ := ha
      exact ⟨da, -xa, by rw [map_neg, neg_mul, hxa, map_neg]⟩
    · obtain ⟨da, xa, hxa⟩ := ha; obtain ⟨db, xb, hxb⟩ := hb
      refine ⟨da + db, xa * xb, ?_⟩
      calc α₂ (a * b) * f₀₁ (s₁ ^ (da + db))
          = (α₂ a * f₀₁ (s₁ ^ da)) * (α₂ b * f₀₁ (s₁ ^ db)) := by
              rw [map_mul, pow_add, map_mul]; ring
        _ = f₀₁ (xa * xb) := by rw [hxa, hxb, map_mul]

  have hloc₀ : @IsLocalization.Away R₁ _ s₁ C₀₁ _ f₀₁.toAlgebra := by
    let _ : Algebra R₁ C₀₁ := f₀₁.toAlgebra
    have halg : algebraMap R₁ C₀₁ = f₀₁ := rfl
    refine ⟨⟨?_, ?_, ?_⟩⟩
    · rintro ⟨_, k, rfl⟩; rw [halg, map_pow]; exact IsUnit.pow k hu_f01
    · intro z
      obtain ⟨⟨y, _, k, rfl⟩, hzy⟩ := IsLocalization.surj (Submonoid.powers s₂) z
      dsimp only at hzy
      obtain ⟨d, x₁, hx₁⟩ := hR2_clear y
      refine ⟨⟨x₁ * s₁ ^ k, ⟨s₁ ^ d, d, rfl⟩⟩, ?_⟩
      dsimp only; rw [halg]
      have hpow_inv : (α₂ s₂) ^ k * (f₀₁ s₁) ^ k = 1 := by rw [← mul_pow, hinv, one_pow]
      calc z * f₀₁ (s₁ ^ d)
          = z * ((α₂ s₂) ^ k * (f₀₁ s₁) ^ k) * f₀₁ (s₁ ^ d) := by rw [hpow_inv, mul_one]
        _ = (z * (α₂ s₂) ^ k) * f₀₁ (s₁ ^ d) * (f₀₁ s₁) ^ k := by ring
        _ = (z * α₂ (s₂ ^ k)) * f₀₁ (s₁ ^ d) * f₀₁ (s₁ ^ k) := by rw [map_pow, map_pow, map_pow]
        _ = (α₂ y * f₀₁ (s₁ ^ d)) * f₀₁ (s₁ ^ k) := by rw [hzy]
        _ = f₀₁ (x₁ * s₁ ^ k) := by rw [hx₁, map_mul]
    · intro a b hab; rw [halg] at hab
      have hab' : ι_L1.hom a = ι_L1.hom b := by
        have h1 := RingHom.congr_fun hhL_1 a; have h2 := RingHom.congr_fun hhL_1 b
        simp only [RingHom.comp_apply] at h1 h2; rw [← h1, ← h2, hab]
      exact ⟨1, by simp [hinj_L1 hab']⟩

  
  obtain ⟨U_tilde, π_U, ι_U1, ι_U2, hOpen₁, hOpen₂, ι_M, φ₀_proj, φ₁_proj,
      hCl_M, hιM_p, hProp_π, hIso_span, hι1_π, hι2_π, hOv_comm, hCov_opens,
      _hPre0, hPre1, hφ0_proj, hφ1_proj, hι1_M, hι2_M⟩ :=
    weil_twoChart_glued_p1_closedImmersion_and_compl_iso
      ↥R₀ ↥R₁ ↥R₂ C₀₁ φ₁.hom φ₂.hom s₁ s₂ f₀₁ hloc₀ hf₀₁_comp hgen₀ hgen₁ hinv
      z₁ z₂ hg₀_mem (hLoc_z1 _ inferInstance) hg₁_mem (hLoc_z2 _ inferInstance)
      hAff_R0 c_R0 t_R0 hCoord_R0
  have : AlgebraicGeometry.IsOpenImmersion ι_U1 := hOpen₁
  have : AlgebraicGeometry.IsOpenImmersion ι_U2 := hOpen₂
  have : AlgebraicGeometry.IsClosedImmersion ι_M := hCl_M

  have hIso_off : CategoryTheory.IsIso
      (π_U ∣_ ⟨(PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (p₀.asIdeal : Set R₀)).isOpen_compl⟩) := by
    have hOpenEq : (⟨(PrimeSpectrum.zeroLocus (p₀.asIdeal : Set R₀))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (p₀.asIdeal : Set R₀)).isOpen_compl⟩ :
        (AlgebraicGeometry.Spec R₀).Opens) =
      ⟨(PrimeSpectrum.zeroLocus (I₁₂ : Set R₀))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (I₁₂ : Set R₀)).isOpen_compl⟩ := by
      congr 1; rw [hp₀_eq]
    rw [hOpenEq]; exact hIso_span

  have hCov_range : Set.range ι_U1.base ∪ Set.range ι_U2.base = Set.univ :=
    congrArg (fun U : U_tilde.Opens => (U : Set ↥U_tilde)) hCov_opens

  have hL_comm : AlgebraicGeometry.Spec.map ι_L1 ≫ ι_U1 =
      AlgebraicGeometry.Spec.map ι_L2 ≫ ι_U2 := by
    have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom h_L) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι_U1) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom h_L) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₂) ≫ ι_U2) :=
      congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom h_L) ≫ ·) hOv_comm
    rw [← Category.assoc, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      hhL_1, hhL_2] at h1
    exact h1

  have hEvalExc : ∀ {R_ch : CommRingCat.{u}} {S_ring : Type u} [CommRing S_ring]
      (φ_ch : R₀ ⟶ R_ch) (s_ch : R_ch) (ψ_ch : R_ch →+* Polynomial Ω)
      (hψ_r : ∀ r : R₀, ψ_ch (φ_ch.hom r) = Polynomial.C (φ_res r))
      (hψ_s : ψ_ch s_ch = Polynomial.X)
      (c_ch : Ω →+* S_ring) (t_ch : S_ring),
      ((Polynomial.eval₂RingHom c_ch t_ch).comp ψ_ch).comp φ_ch.hom = c_ch.comp φ_res ∧
      ((Polynomial.eval₂RingHom c_ch t_ch).comp ψ_ch) s_ch = t_ch := by
    intro R_ch S_ring _ φ_ch s_ch ψ_ch hψ_r hψ_s c_ch t_ch
    refine ⟨?_, ?_⟩
    · ext r; simp [hψ_r]
    · simp [hψ_s]
  let B_Ω0 := (weilProjectiveSpaceOver Ω 1).left.presheaf.obj
    (Opposite.op (weilProjBasicOpen Ω 1 0))
  let B_Ω1 := (weilProjectiveSpaceOver Ω 1).left.presheaf.obj
    (Opposite.op (weilProjBasicOpen Ω 1 1))
  let α₀_exc : ↥R₁ →+* ↥B_Ω0 :=
    (@Polynomial.eval₂RingHom Ω ↥B_Ω0 _ _ (c_Ω 0) (t_Ω 0 1)).comp ψ_exc1
  let α₁_exc : ↥R₂ →+* ↥B_Ω1 :=
    (@Polynomial.eval₂RingHom Ω ↥B_Ω1 _ _ (c_Ω 1) (t_Ω 1 0)).comp ψ_exc2
  have hα₀_exc : α₀_exc.comp φ₁.hom = (c_Ω 0).comp φ_res ∧ α₀_exc s₁ = t_Ω 0 1 :=
    @hEvalExc R₁ ↥B_Ω0 _ φ₁ s₁ ψ_exc1 hψ1_r hψ1_s (c_Ω 0) (t_Ω 0 1)
  have hα₁_exc : α₁_exc.comp φ₂.hom = (c_Ω 1).comp φ_res ∧ α₁_exc s₂ = t_Ω 1 0 :=
    @hEvalExc R₂ ↥B_Ω1 _ φ₂ s₂ ψ_exc2 hψ2_r hψ2_s (c_Ω 1) (t_Ω 1 0)

  obtain ⟨Φ_U, s_e1, _ψ_e1, hPB_ΦU, hNe_D1, _hs_e1_hom, _, _, _, hInf_iff⟩ :=
    @weil_p1_closedSubscheme_fiber_pullback_and_infinity_point
      ↥R₀ ↥R₁ ↥R₂ _ _ _ hAff_R0 c_R0 t_R0 U_tilde π_U ι_U1 ι_U2 hOpen₂ ι_M hCl_M hιM_p hPre1
      φ₁.hom φ₂.hom s₁ s₂ φ₀_proj φ₁_proj hCoord_R0 hφ0_proj hφ1_proj hι1_M hι2_M
      Ω _ φ_res hAff_Ω c_Ω t_Ω hCoord_Ω Φ_P1 hBC_P1 α₀_exc α₁_exc hα₀_exc hα₁_exc

  have hIntP1 : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver Ω 1).left :=
    (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso Ω 1).1

  have hTwoPts : ∃ y₀ y₁ : ↥(weilProjectiveSpaceOver Ω 1).left, y₀ ≠ y₁ := by
    obtain ⟨⟨y₀, hy₀⟩⟩ := hNe_D1
    let pt_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) := ⟨⊥, Ideal.isPrime_bot⟩
    let y₁ : ↥(weilProjectiveSpaceOver Ω 1).left := s_e1.base pt_Ω
    refine ⟨y₀, y₁, ?_⟩
    intro heq
    have hnot : Φ_U.base y₁ ∉ ι_U2.opensRange := (hInf_iff y₁).mpr ⟨pt_Ω, rfl⟩
    rw [heq] at hy₀; exact hnot hy₀

  
  have hOv_img : ι_U1.base '' (PrimeSpectrum.basicOpen s₁).1 =
      ι_U2.base '' (PrimeSpectrum.basicOpen s₂).1 := by
    have hrange1 : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁)).base =
        (PrimeSpectrum.basicOpen s₁).1 := by
      let _ : Algebra R₁ C₀₁ := f₀₁.toAlgebra
      have : IsLocalization.Away s₁ C₀₁ := hloc₀
      exact PrimeSpectrum.localization_away_comap_range C₀₁ s₁
    have hrange2 : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₂)).base =
        (PrimeSpectrum.basicOpen s₂).1 :=
      PrimeSpectrum.localization_away_comap_range C₀₁ s₂
    rw [← hrange1, ← hrange2, ← Set.range_comp, ← Set.range_comp]
    exact congrArg (fun m => Set.range m.base) hOv_comm

  have hJointInj : ∀ (W : U_tilde.Opens) (a b : ↑(U_tilde.presheaf.obj (Opposite.op W))),
      (ι_U1.app W).hom a = (ι_U1.app W).hom b →
      (ι_U2.app W).hom a = (ι_U2.app W).hom b → a = b := by
    intro W a b h1 h2
    let U₁ : U_tilde.Opens :=
      (LocallyRingedSpace.IsOpenImmersion.opensFunctor ι_U1.toLRSHom).obj
        ((TopologicalSpace.Opens.map ι_U1.toLRSHom.base).obj W)
    let U₂ : U_tilde.Opens :=
      (LocallyRingedSpace.IsOpenImmersion.opensFunctor ι_U2.toLRSHom).obj
        ((TopologicalSpace.Opens.map ι_U2.toLRSHom.base).obj W)
    have hU₁ : U₁ ≤ W := by rintro _ ⟨p, hp, rfl⟩; exact hp
    have hU₂ : U₂ ≤ W := by rintro _ ⟨p, hp, rfl⟩; exact hp
    have hW_le : W ≤ U₁ ⊔ U₂ := by
      intro x hx
      have hx_univ : x ∈ Set.range ι_U1.base ∪ Set.range ι_U2.base := by rw [hCov_range]; trivial
      rcases hx_univ with ⟨p, rfl⟩ | ⟨p, rfl⟩
      · exact Or.inl ⟨p, hx, rfl⟩
      · exact Or.inr ⟨p, hx, rfl⟩
    apply TopCat.Sheaf.eq_of_locally_eq₂ U_tilde.sheaf (homOfLE hU₁) (homOfLE hU₂) hW_le a b
    · have eq1 := LocallyRingedSpace.IsOpenImmersion.app_invApp ι_U1.toLRSHom W
      have eq1a := RingHom.congr_fun (congrArg CommRingCat.Hom.hom eq1) a
      have eq1b := RingHom.congr_fun (congrArg CommRingCat.Hom.hom eq1) b
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at eq1a eq1b
      exact eq1a.symm.trans ((congrArg _ h1).trans eq1b)
    · have eq2 := LocallyRingedSpace.IsOpenImmersion.app_invApp ι_U2.toLRSHom W
      have eq2a := RingHom.congr_fun (congrArg CommRingCat.Hom.hom eq2) a
      have eq2b := RingHom.congr_fun (congrArg CommRingCat.Hom.hom eq2) b
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at eq2a eq2b
      exact eq2a.symm.trans ((congrArg _ h2).trans eq2b)

  have hRedU : AlgebraicGeometry.IsReduced U_tilde := by
    refine AlgebraicGeometry.IsReduced.mk (fun W => ⟨fun a ⟨m, hm⟩ => ?_⟩)
    apply hJointInj W a 0
    · have hm1 : ((ι_U1.app W).hom a) ^ m = 0 := by rw [← map_pow, hm, map_zero]
      rw [map_zero]; exact IsNilpotent.eq_zero ⟨m, hm1⟩
    · have hm2 : ((ι_U2.app W).hom a) ^ m = 0 := by rw [← map_pow, hm, map_zero]
      rw [map_zero]; exact IsNilpotent.eq_zero ⟨m, hm2⟩

  have hDomC01 : IsDomain C₀₁ :=
    IsLocalization.isDomain_of_le_nonZeroDivisors C₀₁
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hs2_ne))
  have : IsDomain C₀₁ := hDomC01
  have hinj_f01 : Function.Injective f₀₁ := by
    let _ : Algebra R₁ C₀₁ := f₀₁.toAlgebra
    have : IsLocalization.Away s₁ C₀₁ := hloc₀
    exact IsLocalization.injective C₀₁ (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hs1_ne))
  have hinj_α2 : Function.Injective α₂ :=
    IsLocalization.injective C₀₁ (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hs2_ne))

  have hIrredU : IrreducibleSpace ↥U_tilde := by
    let p_bot1 : AlgebraicGeometry.Spec R₁ := ⟨⊥, Ideal.isPrime_bot⟩
    let p_bot2 : AlgebraicGeometry.Spec R₂ := ⟨⊥, Ideal.isPrime_bot⟩
    let q_bot : AlgebraicGeometry.Spec (CommRingCat.of C₀₁) := ⟨⊥, Ideal.isPrime_bot⟩
    have hq1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁)).base q_bot = p_bot1 := by
      apply PrimeSpectrum.ext; ext r
      change f₀₁ r ∈ (⊥ : Ideal C₀₁) ↔ r ∈ (⊥ : Ideal R₁)
      simp only [Ideal.mem_bot]
      exact ⟨fun h => hinj_f01 (h.trans (map_zero f₀₁).symm), fun h => by rw [h, map_zero]⟩
    have hq2 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₂)).base q_bot = p_bot2 := by
      apply PrimeSpectrum.ext; ext r
      change α₂ r ∈ (⊥ : Ideal C₀₁) ↔ r ∈ (⊥ : Ideal R₂)
      simp only [Ideal.mem_bot]
      exact ⟨fun h => hinj_α2 (h.trans (map_zero α₂).symm), fun h => by rw [h, map_zero]⟩
    have hgen_eq : ι_U1.base p_bot1 = ι_U2.base p_bot2 := by
      have hcomm_q := congrFun (congrArg (fun m => (m.base : _ → ↥U_tilde)) hOv_comm) q_bot
      simpa [hq1, hq2] using hcomm_q
    let x_gen : ↥U_tilde := ι_U1.base p_bot1
    have hx_in_open : ∀ O : Set ↥U_tilde, IsOpen O → O.Nonempty → x_gen ∈ O := by
      intro O hO ⟨y, hy⟩
      have hy_cov : y ∈ Set.range ι_U1.base ∪ Set.range ι_U2.base := by rw [hCov_range]; trivial
      rcases hy_cov with ⟨q₁, rfl⟩ | ⟨q₂, rfl⟩
      · have hO1 : IsOpen (ι_U1.base ⁻¹' O) := hO.preimage ι_U1.continuous
        have hcl1 : q₁ ∈ closure ({p_bot1} : Set (AlgebraicGeometry.Spec R₁)) :=
          (Set.ext_iff.mp (PrimeSpectrum.closure_singleton p_bot1) q₁).mpr
            (show p_bot1.asIdeal ≤ q₁.asIdeal from bot_le)
        obtain ⟨z, hzO, hzs⟩ := mem_closure_iff.mp hcl1 (ι_U1.base ⁻¹' O) hO1 hy
        rw [Set.mem_singleton_iff.mp hzs] at hzO; exact hzO
      · have hO2 : IsOpen (ι_U2.base ⁻¹' O) := hO.preimage ι_U2.continuous
        have hcl2 : q₂ ∈ closure ({p_bot2} : Set (AlgebraicGeometry.Spec R₂)) :=
          (Set.ext_iff.mp (PrimeSpectrum.closure_singleton p_bot2) q₂).mpr
            (show p_bot2.asIdeal ≤ q₂.asIdeal from bot_le)
        obtain ⟨z, hzO, hzs⟩ := mem_closure_iff.mp hcl2 (ι_U2.base ⁻¹' O) hO2 hy
        rw [Set.mem_singleton_iff.mp hzs] at hzO
        change ι_U1.base p_bot1 ∈ O; rw [hgen_eq]; exact hzO
    refine { isPreirreducible_univ := ?_, toNonempty := ⟨x_gen⟩ }
    intro O₁ O₂ hO₁ hO₂ h1ne h2ne
    simp only [Set.univ_inter] at h1ne h2ne ⊢
    exact ⟨x_gen, hx_in_open O₁ hO₁ h1ne, hx_in_open O₂ hO₂ h2ne⟩

  have hIntU : AlgebraicGeometry.IsIntegral U_tilde := by
    have : AlgebraicGeometry.IsReduced U_tilde := hRedU
    have : IrreducibleSpace ↥U_tilde := hIrredU
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced U_tilde

  let U_cov : Bool → U_tilde.Opens := fun b => if b then ι_U1.opensRange else ι_U2.opensRange
  have hiSup_cov : iSup U_cov = ⊤ := by
