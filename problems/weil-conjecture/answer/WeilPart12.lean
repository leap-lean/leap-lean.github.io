        rw [h_map_gY]; exact hX_in
      rw [← AlgebraicGeometry.Spec.map_comp] at h_in2
      change algebraMap R₀ R₀_K X₀ ∈ z.asIdeal at h_in2
      have hu : IsUnit (algebraMap R₀ R₀_K X₀) :=
        @IsLocalization.map_units R₀ _ (Submonoid.powers X₀) R₀_K _ _ _
          ⟨X₀, Submonoid.mem_powers X₀⟩
      exact z.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h_in2 hu)
    have hRange_0K : Set.range ⇑(lam_0K ≫ ι₀) ⊆ Set.range ⇑V_K.ι := by
      rintro _ ⟨z, rfl⟩
      exact ⟨⟨(lam_0K ≫ ι₀).base z, h_in_VK z⟩, rfl⟩
    let ι_0K_lift := AlgebraicGeometry.IsOpenImmersion.lift V_K.ι (lam_0K ≫ ι₀) hRange_0K
    have hι0K_fac : ι_0K_lift ≫ V_K.ι = lam_0K ≫ ι₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V_K.ι (lam_0K ≫ ι₀) hRange_0K
    have : AlgebraicGeometry.IsOpenImmersion (ι_0K_lift ≫ V_K.ι) := by
      rw [hι0K_fac]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion ι_0K_lift :=
      AlgebraicGeometry.IsOpenImmersion.of_comp ι_0K_lift V_K.ι
    have hRange_BK : Set.range ⇑(lam_BK ≫ ι_B₀) ⊆ Set.range ⇑W_K.ι := by
      rintro _ ⟨z, rfl⟩
      refine ⟨⟨(lam_BK ≫ ι_B₀).base z, ?_⟩, rfl⟩
      change h.base ((lam_BK ≫ ι_B₀).base z) ∈ V_K
      have heq_z : h.base ((lam_BK ≫ ι_B₀).base z) = (lam_0K ≫ ι₀).base (Φ_K.base z) := by
        calc h.base ((lam_BK ≫ ι_B₀).base z)
            = (lam_BK ≫ (lam_W ≫ ι_W ≫ h)).base z := rfl
          _ = ((lam_BK ≫ Φ₀) ≫ ι₀).base z := by rw [← hΦ₀_fac]; rfl
          _ = ((Φ_K ≫ lam_0K) ≫ ι₀).base z := by rw [hΦK_sq]
          _ = (lam_0K ≫ ι₀).base (Φ_K.base z) := rfl
      rw [heq_z]
      exact h_in_VK (Φ_K.base z)
    let ι_BK_lift := AlgebraicGeometry.IsOpenImmersion.lift W_K.ι (lam_BK ≫ ι_B₀) hRange_BK
    have hιBK_fac : ι_BK_lift ≫ W_K.ι = lam_BK ≫ ι_B₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_K.ι (lam_BK ≫ ι_B₀) hRange_BK
    have : AlgebraicGeometry.IsOpenImmersion (ι_BK_lift ≫ W_K.ι) := by
      rw [hιBK_fac]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion ι_BK_lift :=
      AlgebraicGeometry.IsOpenImmersion.of_comp ι_BK_lift W_K.ι
    have hΦK_lift_comm : Φ_K ≫ ι_0K_lift = ι_BK_lift ≫ (h ∣_ V_K) := by
      rw [← CategoryTheory.cancel_mono V_K.ι]
      calc (Φ_K ≫ ι_0K_lift) ≫ V_K.ι
          = Φ_K ≫ (ι_0K_lift ≫ V_K.ι) := CategoryTheory.Category.assoc _ _ _
        _ = (Φ_K ≫ lam_0K) ≫ ι₀ := by rw [hι0K_fac, CategoryTheory.Category.assoc]
        _ = lam_BK ≫ (Φ₀ ≫ ι₀) := by rw [hΦK_sq, CategoryTheory.Category.assoc]
        _ = (lam_BK ≫ ι_B₀) ≫ h := by
            rw [hΦ₀_fac]; simp only [ι_B₀, lam_W, CategoryTheory.Category.assoc]
        _ = ι_BK_lift ≫ (W_K.ι ≫ h) := by rw [← hιBK_fac, CategoryTheory.Category.assoc]
        _ = (ι_BK_lift ≫ (h ∣_ V_K)) ≫ V_K.ι := by
            rw [← AlgebraicGeometry.morphismRestrict_ι h V_K, CategoryTheory.Category.assoc]
    have : AlgebraicGeometry.IsOpenImmersion (Φ_K ≫ ι_0K_lift) := by
      rw [hΦK_lift_comm]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion Φ_K :=
      AlgebraicGeometry.IsOpenImmersion.of_comp Φ_K ι_0K_lift
    let η_BK : AlgebraicGeometry.Spec (CommRingCat.of B₀_K) := ⟨⊥, inferInstance⟩
    let O_K : TopologicalSpace.Opens (PrimeSpectrum R₀_K) :=
      ⟨Set.range ⇑Φ_K, Φ_K.isOpenEmbedding.isOpen_range⟩
    have hη_OK : (Φ_K.base η_BK : PrimeSpectrum R₀_K) ∈ O_K := ⟨η_BK, rfl⟩
    obtain ⟨_, ⟨g_K, rfl⟩, hη_gK, hgK_sub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hη_OK
    have hθKgK_ne : θ_K g_K ≠ 0 := by
      have hnot := (PrimeSpectrum.mem_basicOpen g_K (Φ_K.base η_BK)).mp hη_gK
      change θ_K g_K ∉ (⊥ : Ideal B₀_K) at hnot
      rwa [Ideal.mem_bot] at hnot
    have hgK_ne : g_K ≠ 0 := fun h0 => hθKgK_ne (by rw [h0, map_zero])
    let R₀_Kg := Localization.Away g_K
    let B₀_Kg := Localization.Away (θ_K g_K)
    have hgK_nzd : Submonoid.powers g_K ≤ nonZeroDivisors R₀_K :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hgK_ne)
    have hθKgK_nzd : Submonoid.powers (θ_K g_K) ≤ nonZeroDivisors B₀_K :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hθKgK_ne)
    have : IsDomain R₀_Kg := IsLocalization.isDomain_localization hgK_nzd
    have : IsDomain B₀_Kg := IsLocalization.isDomain_localization hθKgK_nzd
    have hinj_R₀Kg : Function.Injective (algebraMap R₀_K R₀_Kg) :=
      IsLocalization.injective R₀_Kg hgK_nzd
    have hinj_B₀Kg : Function.Injective (algebraMap B₀_K B₀_Kg) :=
      IsLocalization.injective B₀_Kg hθKgK_nzd
    have hsub_Kg : Submonoid.powers g_K ≤ Submonoid.comap θ_K (Submonoid.powers (θ_K g_K)) :=
      Submonoid.powers_le.mpr ⟨1, pow_one (θ_K g_K)⟩
    obtain ⟨θ_Kg, hθKg_eq⟩ : ∃ θ_Kg : R₀_Kg →+* B₀_Kg,
        ∀ x : R₀_K, θ_Kg (algebraMap R₀_K R₀_Kg x) = algebraMap B₀_K B₀_Kg (θ_K x) :=
      ⟨IsLocalization.map (S := R₀_Kg) B₀_Kg θ_K hsub_Kg,
       IsLocalization.map_eq (S := R₀_Kg) (Q := B₀_Kg) hsub_Kg⟩
    let lam_Rg : AlgebraicGeometry.Spec (CommRingCat.of R₀_Kg) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀_K) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀_K R₀_Kg))
    let lam_Bg : AlgebraicGeometry.Spec (CommRingCat.of B₀_Kg) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B₀_K) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀_K B₀_Kg))
    have : AlgebraicGeometry.IsOpenImmersion lam_Rg :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization g_K
    have : AlgebraicGeometry.IsOpenImmersion lam_Bg :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (θ_K g_K)
    let Φ_Kg : AlgebraicGeometry.Spec (CommRingCat.of B₀_Kg) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀_Kg) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (R := R₀_Kg) (S := B₀_Kg) θ_Kg)
    have hΦKg_sq : Φ_Kg ≫ lam_Rg = lam_Bg ≫ Φ_K := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1; ext x; exact hθKg_eq x
    have hRange_Kg : Set.range ⇑(lam_Bg ≫ Φ_K) = Set.range ⇑lam_Rg := by
      apply Set.Subset.antisymm
      · rw [← hΦKg_sq]
        rintro _ ⟨w, rfl⟩
        exact ⟨Φ_Kg.base w, rfl⟩
      · rintro _ ⟨z, rfl⟩
        have hz_gK : lam_Rg.base z ∈ PrimeSpectrum.basicOpen g_K := by
          refine (PrimeSpectrum.mem_basicOpen g_K (lam_Rg.base z)).mpr fun hg_in => ?_
          change algebraMap R₀_K R₀_Kg g_K ∈ z.asIdeal at hg_in
          have hu : IsUnit (algebraMap R₀_K R₀_Kg g_K) :=
            @IsLocalization.map_units R₀_K _ (Submonoid.powers g_K) R₀_Kg _ _ _
              ⟨g_K, Submonoid.mem_powers g_K⟩
          exact z.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hg_in hu)
        obtain ⟨u, hu_eq⟩ : lam_Rg.base z ∈ Set.range ⇑Φ_K := hgK_sub hz_gK
        have : u.asIdeal.IsPrime := u.isPrime
        have hu_θgK : θ_K g_K ∈ u.asIdeal.primeCompl := by
          have h1 : Φ_K.base u ∈ PrimeSpectrum.basicOpen g_K := hu_eq ▸ hz_gK
          exact (PrimeSpectrum.mem_basicOpen g_K (Φ_K.base u)).mp h1
        have hDisj_u : Disjoint (Submonoid.powers (θ_K g_K) : Set B₀_K) (u.asIdeal : Set B₀_K) := by
          rw [Set.disjoint_left]
          intro x hx hp
          exact (Submonoid.powers_le.mpr hu_θgK) hx hp
        let j_Bg : B₀_K →+* B₀_Kg := algebraMap B₀_K B₀_Kg
        let Q_u : Ideal B₀_Kg := Ideal.map j_Bg (u.asIdeal : Ideal B₀_K)
        have hQu_prime : Q_u.IsPrime :=
          IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (θ_K g_K)) B₀_Kg
            (u.asIdeal : Ideal B₀_K) u.isPrime hDisj_u
        have hQu_under : Q_u.comap j_Bg = (u.asIdeal : Ideal B₀_K) :=
          IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers (θ_K g_K)) B₀_Kg
            u.isPrime hDisj_u
        let q_u : AlgebraicGeometry.Spec (CommRingCat.of B₀_Kg) := ⟨Q_u, hQu_prime⟩
        have hlam_qu : lam_Bg.base q_u = u := PrimeSpectrum.ext hQu_under
        refine ⟨q_u, ?_⟩
        change Φ_K.base (lam_Bg.base q_u) = lam_Rg.base z
        rw [hlam_qu, hu_eq]
    let e_Kg := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (lam_Bg ≫ Φ_K) lam_Rg hRange_Kg
    have hΦKg_eq_e : Φ_Kg = e_Kg.hom := by
      rw [← CategoryTheory.cancel_mono lam_Rg, hΦKg_sq,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
    let θ_Kg_inv : B₀_Kg →+* R₀_Kg := (AlgebraicGeometry.Spec.preimage e_Kg.inv).hom
    have hinj_θKg : Function.Injective θ_Kg := by
      intro x₁ x₂ hx
      have hcomp : θ_Kg_inv.comp θ_Kg = RingHom.id R₀_Kg := by
        have h1 : e_Kg.inv ≫ e_Kg.hom = 𝟙 _ := e_Kg.inv_hom_id
        rw [← hΦKg_eq_e] at h1
        have h2 := congrArg AlgebraicGeometry.Spec.preimage h1
        rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map] at h2
