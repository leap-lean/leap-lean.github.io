              algebraMap A_hom L_a (MvPolynomial.X b) ^ d b := by
            rw [← mul_pow, hta_mul]
          calc (algebraMap A_hom L_a (MvPolynomial.C (F.coeff d)) * t_a.val ^ d b) *
                (algebraMap A_hom L_a (MvPolynomial.X a) ^ d a *
                  algebraMap A_hom L_a (MvPolynomial.X a) ^ d b)
              = algebraMap A_hom L_a (MvPolynomial.C (F.coeff d)) *
                  algebraMap A_hom L_a (MvPolynomial.X a) ^ d a *
                  (t_a.val ^ d b * algebraMap A_hom L_a (MvPolynomial.X a) ^ d b) := by ring
            _ = algebraMap A_hom L_a (MvPolynomial.C (F.coeff d)) *
                  algebraMap A_hom L_a (MvPolynomial.X a) ^ d a *
                  algebraMap A_hom L_a (MvPolynomial.X b) ^ d b := by rw [hpow_b]
        let s_n : Submonoid.powers (MvPolynomial.X a : A_hom) :=
          ⟨(MvPolynomial.X a : A_hom) ^ n, n, rfl⟩
        obtain ⟨u_inv, hu_inv⟩ := (IsLocalization.map_units L_a s_n).exists_right_inv
        change θ_hom F = (HomogeneousLocalization.Away.mk 𝒜 (hXa a) n F hF).val
