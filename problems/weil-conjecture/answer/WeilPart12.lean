        have hhom0 : CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) ≫
            CommRingCat.ofHom p₀ =
            CommRingCat.ofHom ((Ideal.Quotient.mk J_1).comp MvPolynomial.C) := by
          rw [← CommRingCat.ofHom_comp, hcomp0]
        have hspec0 : Spec.map (CommRingCat.ofHom p₀) ≫ g_Pm =
            Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J_1).comp MvPolynomial.C)) := by
          change Spec.map (CommRingCat.ofHom p₀) ≫
              Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C)) = _
