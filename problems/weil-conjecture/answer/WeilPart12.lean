        have _ : LocallyOfFinitePresentation (Spec.map (CommRingCat.ofHom
            ((Ideal.Quotient.mk J_1).comp MvPolynomial.C))) :=
          (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mpr (hNodal_k 1).2.2
        exact ⟨inferInstance, inferInstance⟩
      have h1 : Flat ((U_src 1).ι ≫ p_m ≫ g_Pm) ∧
          LocallyOfFinitePresentation ((U_src 1).ι ≫ p_m ≫ g_Pm) := by
