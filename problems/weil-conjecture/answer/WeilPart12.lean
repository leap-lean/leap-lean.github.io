    obtain ⟨L_br, h1k, hConnZ, hE_mem, hL_mem, hDisjL, hZ_union, hCompEq, hUniqL, hTwoPt⟩ :=
      hS3 Y_m Z_center j₀ j₁ j₂ hCovY h01 h10 h02 h20 h12 h21 hZ0 hZ1 hZ2
        2 (fun a => Set.range (ι_exc a).base)
        (by
          intro a; fin_cases a
          · exact hClosedIrredRange ι_E0 hCl0
          · exact hClosedIrredRange ι_E1 hCl1)
        (Or.inr ⟨hm3, 0, 1,
          (fun h01' => absurd (congrArg Fin.val h01') (by omega)),
          (fun a => by fin_cases a; exact Or.inl rfl; exact Or.inr rfl),
          hR0_0, hR0_1, hR0_2, hR1_0, hR1_1, hR1_2⟩)
    refine ⟨hConnZ, 2, E_exc, ι_exc, iso_exc, L_br, h1k, ?_, hL_mem, hDisjL,
      hZ_union, hCompEq, hUniqL, hTwoPt⟩
    intro a; fin_cases a
    · refine ⟨hCl0, hIntP1, hE_mem 0, ?_⟩
      change ι_E0 ≫ snd_m = 𝟙 _ ≫ (weilProjectiveSpaceOver Ω 1).hom
      rw [Category.id_comp]; exact hsnd0
    · refine ⟨hCl1, hIntP1, hE_mem 1, ?_⟩
      change ι_E1 ≫ snd_m = 𝟙 _ ≫ (weilProjectiveSpaceOver Ω 1).hom
      rw [Category.id_comp]; exact hsnd1

theorem weil_powerSeries_local_node_blowup_model (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (m : ℕ) (hm : 2 ≤ m) :
    ∃ (M_m : AlgebraicGeometry.Scheme.{u})
      (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
          ({MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
            Set (MvPolynomial (Fin 2) (PowerSeries Ω)))))),
      IsLocalPowerSeriesNodeBlowupModel Ω m p_m :=
by
  obtain ⟨hAff_pkg, c_pkg, t_pkg, hCoord_pkg, _⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  obtain ⟨L, Laur, instL, instLaur, p₀, p₁, p₂, ι_base, ι₀_L, ι₁_L, ι₂_L,
      φ_Laur, ξ, ξ_inv, f_02, f_12, f_20, f_21, hAlg⟩ :=
    weil_powerSeries_nodalQuotient_laurent_and_chart_algebra Ω m hm
  letI : CommRing L := instL
  letI : CommRing Laur := instLaur
  let P_m := weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m)
  obtain ⟨M_m, p_m, ι₀, ι₁, ι₂, hData, hInt, hFlat, hLFP, hProp,
      hIsoCompl, hAppIso, hCharts, hUniv⟩ :=
    weil_powerSeries_blowup_scheme_pushforward_and_universal Ω m hm
      (hAff_pkg P_m 2) (c_pkg P_m 2) (t_pkg P_m 2) (hCoord_pkg P_m 2)
      L Laur p₀ p₁ p₂ ι_base ι₀_L ι₁_L ι₂_L φ_Laur ξ ξ_inv f_02 f_12 f_20 f_21 hAlg
  have hRed :=
    weil_powerSeries_blowup_smooth_and_nodal_reduction Ω m hm M_m p_m ι₀ ι₁ ι₂ hData
  obtain ⟨hSurj, hConn, hFib⟩ :=
    weil_powerSeries_blowup_special_fiber_chain_and_connected Ω m hm
      (hAff_pkg Ω 1) (c_pkg Ω 1) (t_pkg Ω 1) (hCoord_pkg Ω 1)
      M_m p_m ι₀ ι₁ ι₂ hData hIsoCompl
  exact ⟨M_m, p_m, hm, hInt, hFlat, hLFP, hProp, hSurj, hIsoCompl, hAppIso,
    hConn, hCharts, hUniv, hRed, hFib⟩

theorem weil_powerSeries_nodal_point_closed_and_shrunk_roof (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (q' : C' ⟶ C)
    (hInt' : AlgebraicGeometry.IsIntegral C')
    (hFlat' : AlgebraicGeometry.Flat g')
    (hLFP' : AlgebraicGeometry.LocallyOfFinitePresentation g')
    (hProp_q' : AlgebraicGeometry.IsProper q')
    (x₀ : C') (m : ℕ)
    (hRoof : HasPowerSeriesNodalRoofAt Ω g' x₀ m) :
    let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
        Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
    let P_m := MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m
    let I_nod : Ideal P_m := Ideal.span
      {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
       Ideal.Quotient.mk J_m (MvPolynomial.X 1),
       Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
    let g_Pm := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C))
    (∀ V : C'.Opens, x₀ ∈ V → ¬AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g')) ∧
    IsClosed ({x₀} : Set C') ∧
    IsClosed ({q'.base x₀} : Set C) ∧
    PowerSeries.X ∈ (g'.base x₀).asIdeal ∧
    I_nod.IsMaximal ∧
    (∀ f : P_m, ∃ c : Ω,
      f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c)) ∈ I_nod) ∧
    ∃ (U : C'.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
      (p_x₀ : PrimeSpectrum ↑(C'.presheaf.obj (Opposite.op U)))
      (A' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec A')
      (e_U : AlgebraicGeometry.Spec A' ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))))
      (q_m : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of P_m)),
      let A := ↑(C'.presheaf.obj (Opposite.op U))
      let φ_R : PowerSeries Ω →+* A :=
        (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom
      hAffU.fromSpec.base p_x₀ = x₀ ∧
      p_x₀.asIdeal.IsMaximal ∧
      v'₀.asIdeal.IsMaximal ∧
      IsDomain A ∧
      IsNoetherianRing A ∧
      φ_R PowerSeries.X ∈ p_x₀.asIdeal ∧
      φ_R PowerSeries.X ≠ 0 ∧
      φ_R.Flat ∧
      φ_R.FiniteType ∧
      AlgebraicGeometry.Etale e_U ∧
      AlgebraicGeometry.Etale q_m ∧
      e_U ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R) = q_m ≫ g_Pm ∧
      e_U.base v'₀ = p_x₀ ∧
      (q_m.base v'₀).asIdeal = I_nod ∧
      Ideal.map (AlgebraicGeometry.Spec.preimage e_U).hom p_x₀.asIdeal = v'₀.asIdeal ∧
      Ideal.map (AlgebraicGeometry.Spec.preimage q_m).hom I_nod = v'₀.asIdeal ∧
      (∀ w : AlgebraicGeometry.Spec A', e_U.base w = p_x₀ → w = v'₀) ∧
      (∀ w : AlgebraicGeometry.Spec A',
        q_m.base w ∈ PrimeSpectrum.zeroLocus (I_nod : Set P_m) → w = v'₀) ∧
      (∀ a : A, ∃ c : Ω, a - φ_R (PowerSeries.C c) ∈ p_x₀.asIdeal) ∧
      (∀ b : ↑A', ∃ c : Ω,
        b - (AlgebraicGeometry.Spec.preimage e_U).hom (φ_R (PowerSeries.C c)) ∈ v'₀.asIdeal) :=
by
  have h_p1 : ∀ (Ω₁ : Type u) [Field Ω₁] (m₁ : ℕ) (_ : 1 ≤ m₁),
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω₁)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω₁) ^ m₁)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω₁)))
      let P_m := MvPolynomial (Fin 2) (PowerSeries Ω₁) ⧸ J_m
      let I_nod : Ideal P_m := Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω₁))}
      I_nod.IsMaximal ∧
      (∀ f : P_m, ∃ c : Ω₁,
        f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c)) ∈ I_nod) ∧
      (∀ (R₀ B₀ D : Type u) [CommRing R₀] [CommRing B₀] [CommRing D]
          (e_R : PowerSeries Ω₁ ≃+* R₀)
          (ψ₀ : R₀ →+* B₀) (α_D : B₀ →+* D)
          (β_D : CommRingCat.of P_m ⟶ CommRingCat.of D)
          (q_D : Ideal D) [q_D.IsPrime],
        RingHom.IsStandardSmoothOfRelativeDimension 1 ψ₀ →
        α_D.Etale →
        β_D.hom.Etale →
        (α_D.comp ψ₀).comp e_R.toRingHom =
          β_D.hom.comp ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) →
        I_nod ≤ Ideal.comap β_D.hom q_D →
        False) := by
    intro Ω₁ _ m₁ hm J_m P_m I_nod
    let ev₀ : MvPolynomial (Fin 2) (PowerSeries Ω₁) →+* Ω₁ :=
      PowerSeries.constantCoeff.comp MvPolynomial.constantCoeff
    have hm0 : m₁ ≠ 0 := Nat.ne_of_gt hm
    have hJm_ker : J_m ≤ RingHom.ker ev₀ := by
      rw [Ideal.span_le]
      intro p hp
      rw [Set.mem_singleton_iff] at hp
      rw [hp, SetLike.mem_coe, RingHom.mem_ker]
      dsimp only [ev₀, RingHom.comp_apply]
      rw [map_sub, map_mul, MvPolynomial.constantCoeff_X, zero_mul, zero_sub, map_neg,
        MvPolynomial.constantCoeff_C, map_pow, PowerSeries.constantCoeff_X, zero_pow hm0, neg_zero]
    let ev_bar : P_m →+* Ω₁ := Ideal.Quotient.lift J_m ev₀ hJm_ker
    let ι_Ω : Ω₁ →+* P_m := ((Ideal.Quotient.mk J_m).comp MvPolynomial.C).comp PowerSeries.C
    have h_ev_ι : ∀ c : Ω₁, ev_bar (ι_Ω c) = c := by
      intro c
      change PowerSeries.constantCoeff (MvPolynomial.constantCoeff
        (MvPolynomial.C (PowerSeries.C c) : MvPolynomial (Fin 2) (PowerSeries Ω₁))) = c
      rw [MvPolynomial.constantCoeff_C, PowerSeries.constantCoeff_C]
    have h_surj : Function.Surjective ev_bar := fun c => ⟨ι_Ω c, h_ev_ι c⟩
    have h_ind : ∀ F : MvPolynomial (Fin 2) (PowerSeries Ω₁),
        Ideal.Quotient.mk J_m F - ι_Ω (ev₀ F) ∈ I_nod := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C φ =>
        have hc0 : PowerSeries.constantCoeff (φ - PowerSeries.C (PowerSeries.constantCoeff φ)) = 0 := by
          simp
        obtain ⟨ψ, hψ⟩ := PowerSeries.X_dvd_iff.mpr hc0
        have h_eq : Ideal.Quotient.mk J_m (MvPolynomial.C φ) - ι_Ω (ev₀ (MvPolynomial.C φ)) =
            Ideal.Quotient.mk J_m (MvPolynomial.C ψ) *
              Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω₁)) := by
          have h1 : ev₀ (MvPolynomial.C φ) = PowerSeries.constantCoeff φ := by
            change PowerSeries.constantCoeff (MvPolynomial.constantCoeff (MvPolynomial.C φ)) = _
            rw [MvPolynomial.constantCoeff_C]
          rw [h1]
          change ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) φ -
              ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) (PowerSeries.C (PowerSeries.constantCoeff φ)) = _
          rw [← map_sub, hψ, mul_comm (PowerSeries.X : PowerSeries Ω₁) ψ, map_mul]
          rfl
        rw [h_eq]
        exact Ideal.mul_mem_left I_nod _ (Ideal.subset_span (by simp))
      | add p q hp hq =>
        have h_eq : Ideal.Quotient.mk J_m (p + q) - ι_Ω (ev₀ (p + q)) =
            (Ideal.Quotient.mk J_m p - ι_Ω (ev₀ p)) +
              (Ideal.Quotient.mk J_m q - ι_Ω (ev₀ q)) := by
          simp only [map_add]
          ring
        rw [h_eq]
        exact I_nod.add_mem hp hq
      | mul_X p i _hp =>
        have hev : ev₀ (p * MvPolynomial.X i) = 0 := by
          change PowerSeries.constantCoeff (MvPolynomial.constantCoeff (p * MvPolynomial.X i)) = 0
          rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero]
        rw [hev, map_zero, sub_zero, map_mul]
        apply Ideal.mul_mem_left I_nod
        fin_cases i
        · exact Ideal.subset_span (by simp)
        · exact Ideal.subset_span (by simp)
    have hRes_Pm : ∀ f : P_m, ∃ c : Ω₁,
        f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c)) ∈ I_nod := by
      intro f
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
      exact ⟨ev₀ F, h_ind F⟩
    have hKer_eq : I_nod = RingHom.ker ev_bar := by
      apply le_antisymm
      · rw [Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl | rfl
        · rw [SetLike.mem_coe, RingHom.mem_ker]
          change PowerSeries.constantCoeff (MvPolynomial.constantCoeff
            (MvPolynomial.X 0 : MvPolynomial (Fin 2) (PowerSeries Ω₁))) = 0
          rw [MvPolynomial.constantCoeff_X, map_zero]
        · rw [SetLike.mem_coe, RingHom.mem_ker]
          change PowerSeries.constantCoeff (MvPolynomial.constantCoeff
            (MvPolynomial.X 1 : MvPolynomial (Fin 2) (PowerSeries Ω₁))) = 0
          rw [MvPolynomial.constantCoeff_X, map_zero]
        · rw [SetLike.mem_coe, RingHom.mem_ker]
          change PowerSeries.constantCoeff (MvPolynomial.constantCoeff
            (MvPolynomial.C (PowerSeries.X : PowerSeries Ω₁) : MvPolynomial (Fin 2) (PowerSeries Ω₁))) = 0
          rw [MvPolynomial.constantCoeff_C, PowerSeries.constantCoeff_X]
      · intro f hf
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
        have hevF : ev₀ F = 0 := hf
        simpa [hevF] using h_ind F
    have hMax_Inod : I_nod.IsMaximal := by
      rw [hKer_eq]
      exact RingHom.ker_isMaximal_of_surjective ev_bar h_surj
    refine ⟨hMax_Inod, hRes_Pm, ?_⟩
    intro R₀ B₀ D _ _ _ e_R ψ₀ α_D β_D q_D hqD_prime hStd1 hEt_α hEt_β hComm hInod_le
    let RStar := PowerSeries Ω₁
    let Q₂ := MvPolynomial (Fin 2) RStar
    letI : Algebra RStar D := ((α_D.comp ψ₀).comp e_R.toRingHom).toAlgebra
    obtain ⟨m_D, hmD_max, hq_le_m⟩ := q_D.exists_le_maximal hqD_prime.ne_top
    letI : Field (D ⧸ m_D) := Ideal.Quotient.field m_D
    let κ := D ⧸ m_D
    have h_upper : Module.Finite κ (TensorProduct D κ Ω[D⁄RStar]) ∧
        Module.finrank κ (TensorProduct D κ Ω[D⁄RStar]) = 1 := by
      letI : Algebra RStar R₀ := e_R.toRingHom.toAlgebra
      letI : Algebra R₀ B₀ := ψ₀.toAlgebra
      letI : Algebra RStar B₀ := (ψ₀.comp e_R.toRingHom).toAlgebra
      haveI : IsScalarTower RStar R₀ B₀ := IsScalarTower.of_algebraMap_eq' rfl
      letI : Algebra B₀ D := α_D.toAlgebra
      haveI : IsScalarTower RStar B₀ D := IsScalarTower.of_algebraMap_eq' rfl
      have h_qB : (Ideal.comap α_D q_D).IsPrime := Ideal.comap_isPrime α_D q_D
      haveI : Nontrivial B₀ := ⟨⟨0, 1, fun h01 =>
        h_qB.ne_top ((Ideal.eq_top_iff_one _).mpr (by rw [← h01]; exact Ideal.zero_mem _))⟩⟩
      haveI : Nontrivial D := ⟨⟨0, 1, fun h01 =>
        hqD_prime.ne_top ((Ideal.eq_top_iff_one _).mpr (by rw [← h01]; exact Ideal.zero_mem _))⟩⟩
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 R₀ B₀ :=
        @RingHom.IsStandardSmoothOfRelativeDimension.toAlgebra 1 _ _ _ _ ψ₀ hStd1
      haveI : Algebra.IsStandardSmooth R₀ B₀ :=
        Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
      haveI : Module.Free B₀ Ω[B₀⁄R₀] := Algebra.IsStandardSmooth.free_kaehlerDifferential
      haveI : Algebra.FinitePresentation R₀ B₀ := inferInstance
      haveI : Module.Finite B₀ Ω[B₀⁄R₀] := inferInstance
      have h_rank_R₀ : Module.rank B₀ Ω[B₀⁄R₀] = (1 : ℕ) :=
        Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential 1
      have h_finrank_R₀ : Module.finrank B₀ Ω[B₀⁄R₀] = 1 :=
        Module.finrank_eq_of_rank_eq h_rank_R₀
      let f_to : Ω[B₀⁄RStar] →ₗ[B₀] Ω[B₀⁄R₀] := KaehlerDifferential.map RStar R₀ B₀ B₀
      let f_inv : Ω[B₀⁄R₀] →ₗ[B₀] Ω[B₀⁄RStar] := by
        letI : Algebra R₀ RStar := e_R.symm.toRingHom.toAlgebra
        haveI : IsScalarTower R₀ RStar B₀ := IsScalarTower.of_algebraMap_eq (fun x =>
          (congrArg ψ₀ (e_R.apply_symm_apply x)).symm)
        exact KaehlerDifferential.map R₀ RStar B₀ B₀
      have hf_to_D : ∀ b : B₀, f_to (KaehlerDifferential.D RStar B₀ b) = KaehlerDifferential.D R₀ B₀ b := by
        intro b
        exact KaehlerDifferential.map_D RStar R₀ B₀ B₀ b
      have hf_inv_D : ∀ b : B₀, f_inv (KaehlerDifferential.D R₀ B₀ b) = KaehlerDifferential.D RStar B₀ b := by
        intro b
        letI : Algebra R₀ RStar := e_R.symm.toRingHom.toAlgebra
        haveI : IsScalarTower R₀ RStar B₀ := IsScalarTower.of_algebraMap_eq (fun x =>
          (congrArg ψ₀ (e_R.apply_symm_apply x)).symm)
        exact KaehlerDifferential.map_D R₀ RStar B₀ B₀ b
      have hf_left : ∀ ω : Ω[B₀⁄RStar], f_inv (f_to ω) = ω := by
        have h_lin : f_inv.comp f_to = LinearMap.id := by
          apply (KaehlerDifferential.linearMapEquivDerivation RStar B₀).injective
          ext b
          change f_inv (f_to (KaehlerDifferential.D RStar B₀ b)) = KaehlerDifferential.D RStar B₀ b
          rw [hf_to_D, hf_inv_D]
        intro ω
        exact LinearMap.congr_fun h_lin ω
      have hf_right : ∀ ω : Ω[B₀⁄R₀], f_to (f_inv ω) = ω := by
        have h_lin : f_to.comp f_inv = LinearMap.id := by
          apply (KaehlerDifferential.linearMapEquivDerivation R₀ B₀).injective
          ext b
          change f_to (f_inv (KaehlerDifferential.D R₀ B₀ b)) = KaehlerDifferential.D R₀ B₀ b
          rw [hf_inv_D, hf_to_D]
        intro ω
        exact LinearMap.congr_fun h_lin ω
      let e_ΩB : Ω[B₀⁄RStar] ≃ₗ[B₀] Ω[B₀⁄R₀] :=
        { toFun := f_to
          map_add' := f_to.map_add
          map_smul' := f_to.map_smul
          invFun := f_inv
          left_inv := hf_left
          right_inv := hf_right }
      haveI : Module.Free B₀ Ω[B₀⁄RStar] := Module.Free.of_equiv e_ΩB.symm
      haveI : Module.Finite B₀ Ω[B₀⁄RStar] := Module.Finite.equiv e_ΩB.symm
      have h_finrank_RStar : Module.finrank B₀ Ω[B₀⁄RStar] = 1 :=
        (LinearEquiv.finrank_eq e_ΩB).trans h_finrank_R₀
      haveI : Algebra.Etale B₀ D := RingHom.Etale.toAlgebra hEt_α
      let e_ΩD : TensorProduct B₀ D Ω[B₀⁄RStar] ≃ₗ[D] Ω[D⁄RStar] :=
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale RStar B₀ D
      haveI : Module.Free D Ω[D⁄RStar] := Module.Free.of_equiv e_ΩD
      haveI : Module.Finite D Ω[D⁄RStar] := Module.Finite.equiv e_ΩD
      have h_finrank_D : Module.finrank D Ω[D⁄RStar] = 1 := by
        rw [← LinearEquiv.finrank_eq e_ΩD, Module.finrank_baseChange, h_finrank_RStar]
      refine ⟨inferInstance, ?_⟩
      rw [Module.finrank_baseChange, h_finrank_D]
    have h_abs_lower : ∀ (P₀ : Type u) [CommRing P₀]
        (mk_P₀ : Q₂ →+* P₀) (β₀ : P₀ →+* D),
        Function.Surjective mk_P₀ →
        β₀.Etale →
        (α_D.comp ψ₀).comp e_R.toRingHom = β₀.comp (mk_P₀.comp MvPolynomial.C) →
        mk_P₀ (MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : RStar) ^ m₁)) = 0 →
        (∀ p : Q₂, mk_P₀ p = 0 ↔ p ∈ J_m) →
        (∀ j : Fin 2, β₀ (mk_P₀ (MvPolynomial.X j)) ∈ q_D) →
        2 ≤ Module.finrank κ (TensorProduct D κ Ω[D⁄RStar]) := by
      intro P₀ _ mk_P₀ β₀ hSurj_mk hEt_β₀ hComm₀ hGm₀ hKer_mk hXj_qD
      let φ_P₀ : RStar →+* P₀ := mk_P₀.comp MvPolynomial.C
      letI : Algebra RStar P₀ := φ_P₀.toAlgebra
      letI : Algebra P₀ D := β₀.toAlgebra
      haveI : IsScalarTower RStar P₀ D := IsScalarTower.of_algebraMap_eq' hComm₀
