    clear! Ω n m C' C'' U_tilde M_m A'
    intro Ω _ C' C'' g' hProp' hLFP' x₀ hx₀_cl hX_x₀ U hAffU p_x₀ hp_x₀
      m hm hMax_Inod A' v'₀ e_U q_m hEt_q hComm_eq hev'₀ hqv'₀ hUniq_e
