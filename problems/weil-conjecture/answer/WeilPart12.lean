    have hev_X : ∀ j : Fin (d + 1), ev_homog (X_var j) = ι_K (a j) :=
      fun j => MvPolynomial.eval₂_X _ _ j
    have hev_X_unit : ∀ ℓ : Fin (d + 1), IsUnit (ev_homog (X_var ℓ)) := by
