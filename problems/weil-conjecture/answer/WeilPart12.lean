  have _ : ∀ r : Fin 3, IsOpenImmersion (ι_fam r) := hOpen_fam
  let U_src : Fin 3 → M_m.Opens := fun r => (ι_fam r).opensRange
  have hU_src_top : (⨆ r : Fin 3, U_src r) = ⊤ := by
