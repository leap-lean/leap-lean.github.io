    have hcomp_eq : AlgebraicGeometry.Spec.preimage (ι_U ≫ g) =
        AlgebraicGeometry.Spec.preimage (ι_sm ≫ g) ≫ j_f := by
      change AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map j_f ≫ (ι_sm ≫ g)) = _
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
    have h1 := congrArg (fun φ : CommRingCat.of (PowerSeries Ω) ⟶ R₀ => φ.hom s) hcomp_eq
    change (AlgebraicGeometry.Spec.preimage (ι_U ≫ g)).hom s =
      j_f.hom ((AlgebraicGeometry.Spec.preimage (ι_sm ≫ g)).hom s) at h1
    rw [h1, ← hψ_comp]
    rfl
  have hRes_R₀ : ∀ r : R₀, ∃ c : Ω,
      r - (AlgebraicGeometry.Spec.preimage (ι_U ≫ g)).hom (PowerSeries.C c) ∈ p₀.asIdeal := by
    intro r
    obtain ⟨⟨a, ⟨_, ⟨k, rfl⟩⟩⟩, hr_eq⟩ := IsLocalization.surj (Submonoid.powers f) r
    obtain ⟨c_a, hc_a⟩ := hRes_sm a
    obtain ⟨c_fk, hc_fk⟩ := hRes_sm (f ^ k)
    have hcfk_ne : c_fk ≠ 0 := by
      intro hc0
      rw [hc0, map_zero, map_zero, map_zero, sub_zero] at hc_fk
      exact hf_not_mem (p_sm.isPrime.mem_of_pow_mem k hc_fk)
    let c : Ω := c_a * c_fk⁻¹
    refine ⟨c, ?_⟩
    have hc_mul : c * c_fk = c_a := inv_mul_cancel_right₀ hcfk_ne c_a
    have hdiff_sm : a - f ^ k * ψ_et (MvPolynomial.C (PowerSeries.C c)) ∈ m_sm := by
      have h_id : a - f ^ k * ψ_et (MvPolynomial.C (PowerSeries.C c)) =
          (a - ψ_et (MvPolynomial.C (PowerSeries.C c_a))) -
          ψ_et (MvPolynomial.C (PowerSeries.C c)) *
            (f ^ k - ψ_et (MvPolynomial.C (PowerSeries.C c_fk))) := by
        have hmul_c : ψ_et (MvPolynomial.C (PowerSeries.C c)) *
            ψ_et (MvPolynomial.C (PowerSeries.C c_fk)) =
            ψ_et (MvPolynomial.C (PowerSeries.C c_a)) := by
          rw [← map_mul, ← map_mul, ← map_mul, hc_mul]
        rw [← hmul_c]
        ring
      rw [h_id]
      exact m_sm.sub_mem hc_a (m_sm.mul_mem_left _ hc_fk)
    have hmap_diff : algebraMap R_sm (Localization.Away f)
        (a - f ^ k * ψ_et (MvPolynomial.C (PowerSeries.C c))) ∈ p₀.asIdeal :=
      Ideal.mem_map_of_mem _ hdiff_sm
    let inv_f : R₀ := IsLocalization.Away.invSelf (S := Localization.Away f) f
    have hinv_pow : (algebraMap R_sm (Localization.Away f) f) ^ k * inv_f ^ k = 1 := by
      rw [← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
    have hmul_p₀ := p₀.asIdeal.mul_mem_right (inv_f ^ k) hmap_diff
    have hr_sub : algebraMap R_sm (Localization.Away f)
        (a - f ^ k * ψ_et (MvPolynomial.C (PowerSeries.C c))) * inv_f ^ k =
        r - (AlgebraicGeometry.Spec.preimage (ι_U ≫ g)).hom (PowerSeries.C c) := by
      rw [hPre_U, map_sub, map_mul, map_pow]
      have hr_fk : algebraMap R_sm (Localization.Away f) a =
          r * (algebraMap R_sm (Localization.Away f) f) ^ k := by
        simpa [map_pow] using hr_eq.symm
      rw [hr_fk, sub_mul, mul_assoc r, hinv_pow, mul_one]
      have h_rhs : (algebraMap R_sm (Localization.Away f) f) ^ k *
          algebraMap R_sm (Localization.Away f) (ψ_et (MvPolynomial.C (PowerSeries.C c))) *
          inv_f ^ k =
          algebraMap R_sm (Localization.Away f) (ψ_et (MvPolynomial.C (PowerSeries.C c))) *
          ((algebraMap R_sm (Localization.Away f) f) ^ k * inv_f ^ k) := by ring
      rw [h_rhs, hinv_pow, mul_one]
    rwa [hr_sub] at hmul_p₀
  
  refine ⟨R₀, p₀, ι_U, z₁, z₂, R₀, p₀, 𝟙 (AlgebraicGeometry.Spec R₀), z₁, z₂, 1,
    inferInstance, hp₀_base, hDom_R₀, hp₀_span, hReg_R₀.1, hReg_R₀.2, hRes_R₀,
    inferInstance, hDom_R₀, ?_, hp₀_span, hReg_R₀.1, hReg_R₀.2, ?_, isUnit_one, le_rfl, ?_⟩
  · exact Set.preimage_id
  · intro r'
    rw [CategoryTheory.Category.id_comp]
    exact hRes_R₀ r'
  · rw [CategoryTheory.Category.id_comp, hPre_U, pow_one, pow_zero, one_mul, mul_one]

theorem weil_nodalRoofSpecialPoint_hasNCBranchAt (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (hInt : AlgebraicGeometry.IsIntegral C)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (q₀ : ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))))
    (hq₀ : IsClosed ({q₀} : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))))))
    (A' : CommRingCat.{u})
    (v₀ : AlgebraicGeometry.Spec A')
    (e_C : AlgebraicGeometry.Spec A' ⟶ C)
    (q : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X})))
    (heC : AlgebraicGeometry.Etale e_C)
    (hq : AlgebraicGeometry.Etale q)
    (hv₀ : e_C.base v₀ = (CategoryTheory.Limits.pullback.fst g
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)))).base q₀)
    (hX_mem : ∀ i : Fin 2, Ideal.Quotient.mk
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X})
      (MvPolynomial.X i) ∈ (q.base v₀).asIdeal)
    (hcomm : e_C ≫ g =
      q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X})).comp
          MvPolynomial.C))) :
    HasNCBranchAt Ω g q₀ 1 1 :=
by
  
  have hPart1 :
      let J₁ : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X}
      let P₁ := MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J₁
      let x₀ : P₁ := Ideal.Quotient.mk J₁ (MvPolynomial.X 0)
      let x₁ : P₁ := Ideal.Quotient.mk J₁ (MvPolynomial.X 1)
      Function.Injective (fun z : P₁ => x₀ * z) ∧
      (∀ y : P₁, x₁ * y ∈ Ideal.span ({x₀} : Set P₁) → y ∈ Ideal.span ({x₀} : Set P₁)) ∧
      (Ideal.span ({x₀, x₁} : Set P₁)).IsMaximal ∧
      (∀ r : P₁, ∃ c : Ω,
        r - Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C c)) ∈
          Ideal.span ({x₀, x₁} : Set P₁)) ∧
      Ideal.Quotient.mk J₁ (MvPolynomial.C PowerSeries.X) = x₀ * x₁ := by
    intro J₁ P₁ x₀ x₁
    let : CommRing P₁ := Ideal.Quotient.commRing J₁
    let RStar := PowerSeries Ω
    let gen : MvPolynomial (Fin 2) RStar :=
      MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X
    have hrel : Ideal.Quotient.mk J₁ (MvPolynomial.C PowerSeries.X) = x₀ * x₁ := by
      have hmem : gen ∈ J₁ := Ideal.subset_span (Set.mem_singleton gen)
      have h0 : Ideal.Quotient.mk J₁ gen = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      change Ideal.Quotient.mk J₁ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X) = 0 at h0
      rw [map_sub, map_mul] at h0
      exact (sub_eq_zero.mp h0).symm
    have hx₀_inj : Function.Injective (fun z : P₁ => x₀ * z) := by
      let πX₀ : MvPolynomial (Fin 2) RStar →+* Polynomial RStar :=
        MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin 2 => if i = 0 then 0 else Polynomial.X)
      let ιX₁ : Polynomial RStar →+* MvPolynomial (Fin 2) RStar :=
        Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)
      have hmod_X₀ : ∀ p : MvPolynomial (Fin 2) RStar,
          p - ιX₁ (πX₀ p) ∈ Ideal.span ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 2) RStar)) := by
        intro p
        refine MvPolynomial.induction_on
          (motive := fun p =>
            p - ιX₁ (πX₀ p) ∈ Ideal.span ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 2) RStar)))
          p ?_ ?_ ?_
        · intro r
          have h1 : ιX₁ (πX₀ (MvPolynomial.C r)) = MvPolynomial.C r := by simp [πX₀, ιX₁]
          rw [h1, sub_self]
          exact Ideal.zero_mem _
        · intro p₁ p₂ hp₁ hp₂
          have h_add : (p₁ + p₂) - ιX₁ (πX₀ (p₁ + p₂)) =
              (p₁ - ιX₁ (πX₀ p₁)) + (p₂ - ιX₁ (πX₀ p₂)) := by
            simp only [map_add]
            ring
          rw [h_add]
          exact Ideal.add_mem _ hp₁ hp₂
        · intro p₁ i hp₁
          by_cases hi0 : i = 0
          · subst hi0
            have h0 : πX₀ (p₁ * MvPolynomial.X 0) = 0 := by simp [πX₀]
            rw [h0, map_zero, sub_zero]
            exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
          · have hi1 : i = 1 := by omega
            subst hi1
            have h1 : ιX₁ (πX₀ (p₁ * MvPolynomial.X 1)) = ιX₁ (πX₀ p₁) * MvPolynomial.X 1 := by
              simp [πX₀, ιX₁]
            rw [h1]
            have h_sub : p₁ * MvPolynomial.X 1 - ιX₁ (πX₀ p₁) * MvPolynomial.X 1 =
                (p₁ - ιX₁ (πX₀ p₁)) * MvPolynomial.X 1 := by ring
            rw [h_sub]
            exact Ideal.mul_mem_right _ _ hp₁
      have hX_ps_ne : (PowerSeries.X : RStar) ≠ 0 := PowerSeries.X_ne_zero
      have hCX_ne : (Polynomial.C (PowerSeries.X : RStar) : Polynomial RStar) ≠ 0 :=
        Polynomial.C_ne_zero.mpr hX_ps_ne
      have hX₀_mv_ne : (MvPolynomial.X 0 : MvPolynomial (Fin 2) RStar) ≠ 0 :=
        MvPolynomial.X_ne_zero 0
      have hzero : ∀ z : P₁, x₀ * z = 0 → z = 0 := by
        intro z hz
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
        change Ideal.Quotient.mk J₁ (MvPolynomial.X 0 * F) = 0 at hz
        rw [Ideal.Quotient.eq_zero_iff_mem] at hz ⊢
        obtain ⟨G, hFG⟩ := Ideal.mem_span_singleton.mp hz
        have hπ : πX₀ (MvPolynomial.X 0 * F) = πX₀ (gen * G) := congrArg πX₀ hFG
        have hπ_lhs : πX₀ (MvPolynomial.X 0 * F) = 0 := by simp [πX₀]
        have hπ_gen : πX₀ gen = - Polynomial.C (PowerSeries.X : RStar) := by simp [gen, πX₀]
        rw [hπ_lhs, map_mul, hπ_gen] at hπ
        have hπG : πX₀ G = 0 := by
          rcases mul_eq_zero.mp hπ.symm with hneg | hG0
          · exact False.elim (hCX_ne (neg_eq_zero.mp hneg))
          · exact hG0
        have hG_mem : G ∈ Ideal.span ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 2) RStar)) := by
          have hm := hmod_X₀ G
          rwa [hπG, map_zero, sub_zero] at hm
        obtain ⟨H, rfl⟩ := Ideal.mem_span_singleton.mp hG_mem
        have hcancel : MvPolynomial.X 0 * F = MvPolynomial.X 0 * (gen * H) := by
          calc MvPolynomial.X 0 * F = gen * (MvPolynomial.X 0 * H) := hFG
            _ = MvPolynomial.X 0 * (gen * H) := by ring
        have hF_eq : F = gen * H := mul_left_cancel₀ hX₀_mv_ne hcancel
        rw [hF_eq]
        exact Ideal.mem_span_singleton.mpr ⟨H, rfl⟩
      intro z₁ z₂ hz
      dsimp only at hz
      have hsub : x₀ * (z₁ - z₂) = 0 := by rw [mul_sub, hz, sub_self]
      exact sub_eq_zero.mp (hzero (z₁ - z₂) hsub)
    have hC_mod : ∀ s : RStar,
        Ideal.Quotient.mk J₁ (MvPolynomial.C s) -
          Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (PowerSeries.constantCoeff s))) ∈
          Ideal.span ({x₀} : Set P₁) := by
      intro s
      have hc0 : PowerSeries.constantCoeff (s - PowerSeries.C (PowerSeries.constantCoeff s)) = 0 := by
        rw [map_sub, PowerSeries.constantCoeff_C, sub_self]
      obtain ⟨h_s, hh_s⟩ := PowerSeries.X_dvd_iff.mpr hc0
      have h_eq : Ideal.Quotient.mk J₁ (MvPolynomial.C s) -
          Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (PowerSeries.constantCoeff s))) =
          x₀ * (x₁ * Ideal.Quotient.mk J₁ (MvPolynomial.C h_s)) := by
        rw [← map_sub, ← MvPolynomial.C_sub, hh_s, MvPolynomial.C_mul, map_mul, hrel]
        ring
      rw [h_eq]
      exact (Ideal.span ({x₀} : Set P₁)).mul_mem_right _ (Ideal.subset_span (Set.mem_singleton x₀))
    have hx₁_reg : ∀ y : P₁, x₁ * y ∈ Ideal.span ({x₀} : Set P₁) → y ∈ Ideal.span ({x₀} : Set P₁) := by
      let cCoeff : RStar →+* Ω := PowerSeries.constantCoeff
      let π₁_mv : MvPolynomial (Fin 2) RStar →+* Polynomial Ω :=
        MvPolynomial.eval₂Hom (Polynomial.C.comp cCoeff) (fun i : Fin 2 => if i = 0 then 0 else Polynomial.X)
      have hJ₁_ker₁ : J₁ ≤ RingHom.ker π₁_mv := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        change π₁_mv (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X) = 0
        simp only [π₁_mv, cCoeff, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          RingHom.comp_apply, ↓reduceIte, zero_mul, zero_sub, neg_eq_zero, Polynomial.C_eq_zero]
        exact PowerSeries.constantCoeff_X
      let π₁ : P₁ →+* Polynomial Ω := Ideal.Quotient.lift J₁ π₁_mv hJ₁_ker₁
      let σ₁ : Polynomial Ω →+* P₁ :=
        Polynomial.eval₂RingHom ((Ideal.Quotient.mk J₁).comp (MvPolynomial.C.comp PowerSeries.C)) x₁
      have hπ₁_x₀ : π₁ x₀ = 0 := by
        change π₁_mv (MvPolynomial.X 0) = 0
        simp [π₁_mv]
      have hπ₁_x₁ : π₁ x₁ = Polynomial.X := by
        change π₁_mv (MvPolynomial.X 1) = Polynomial.X
        simp [π₁_mv]
      have hmod_1 : ∀ F : MvPolynomial (Fin 2) RStar,
          Ideal.Quotient.mk J₁ F - σ₁ (π₁_mv F) ∈ Ideal.span ({x₀} : Set P₁) := by
        intro F
        refine MvPolynomial.induction_on
          (motive := fun F => Ideal.Quotient.mk J₁ F - σ₁ (π₁_mv F) ∈ Ideal.span ({x₀} : Set P₁))
          F ?_ ?_ ?_
        · intro s
          have hσC : σ₁ (π₁_mv (MvPolynomial.C s)) =
              Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (PowerSeries.constantCoeff s))) := by
            simp [π₁_mv, σ₁, cCoeff]
          rw [hσC]
          exact hC_mod s
        · intro p₁ p₂ hp₁ hp₂
          have h_add : Ideal.Quotient.mk J₁ (p₁ + p₂) - σ₁ (π₁_mv (p₁ + p₂)) =
              (Ideal.Quotient.mk J₁ p₁ - σ₁ (π₁_mv p₁)) +
              (Ideal.Quotient.mk J₁ p₂ - σ₁ (π₁_mv p₂)) := by
            simp only [map_add]
            ring
          rw [h_add]
          exact (Ideal.span ({x₀} : Set P₁)).add_mem hp₁ hp₂
        · intro p₁ i hp₁
          by_cases hi0 : i = 0
          · subst hi0
            have h0 : π₁_mv (p₁ * MvPolynomial.X 0) = 0 := by simp [π₁_mv]
            rw [h0, map_zero, sub_zero, map_mul]
            exact (Ideal.span ({x₀} : Set P₁)).mul_mem_left _ (Ideal.subset_span (Set.mem_singleton x₀))
          · have hi1 : i = 1 := by omega
            subst hi1
            have h1 : σ₁ (π₁_mv (p₁ * MvPolynomial.X 1)) = σ₁ (π₁_mv p₁) * x₁ := by
              simp [π₁_mv, σ₁]
            rw [h1, map_mul]
            change Ideal.Quotient.mk J₁ p₁ * x₁ - σ₁ (π₁_mv p₁) * x₁ ∈ Ideal.span ({x₀} : Set P₁)
            rw [← sub_mul]
            exact (Ideal.span ({x₀} : Set P₁)).mul_mem_right _ hp₁
      have hker_π₁ : RingHom.ker π₁ = Ideal.span ({x₀} : Set P₁) := by
        refine le_antisymm ?_ ?_
        · intro y hy
          obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
          rw [RingHom.mem_ker] at hy
          change π₁_mv F = 0 at hy
          have hm := hmod_1 F
          rwa [hy, map_zero, sub_zero] at hm
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          exact hπ₁_x₀
      intro y hy
      rw [← hker_π₁, RingHom.mem_ker] at hy ⊢
      rw [map_mul, hπ₁_x₁] at hy
      exact (mul_eq_zero.mp hy).resolve_left Polynomial.X_ne_zero
    let cCoeff : RStar →+* Ω := PowerSeries.constantCoeff
    let π₀_mv : MvPolynomial (Fin 2) RStar →+* Ω := MvPolynomial.eval₂Hom cCoeff 0
    have hJ₁_ker₀ : J₁ ≤ RingHom.ker π₀_mv := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      change π₀_mv (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C PowerSeries.X) = 0
      simp only [π₀_mv, cCoeff, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Pi.zero_apply, mul_zero, zero_sub, neg_eq_zero]
      exact PowerSeries.constantCoeff_X
    let π₀ : P₁ →+* Ω := Ideal.Quotient.lift J₁ π₀_mv hJ₁_ker₀
    have hspan_sub : Ideal.span ({x₀} : Set P₁) ≤ Ideal.span ({x₀, x₁} : Set P₁) :=
      Ideal.span_mono (by simp)
    have hmod_0 : ∀ F : MvPolynomial (Fin 2) RStar,
        Ideal.Quotient.mk J₁ F -
          Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (π₀_mv F))) ∈
          Ideal.span ({x₀, x₁} : Set P₁) := by
      intro F
      refine MvPolynomial.induction_on
        (motive := fun F => Ideal.Quotient.mk J₁ F -
          Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (π₀_mv F))) ∈
          Ideal.span ({x₀, x₁} : Set P₁))
        F ?_ ?_ ?_
      · intro s
        have h0 : π₀_mv (MvPolynomial.C s) = PowerSeries.constantCoeff s := by simp [π₀_mv, cCoeff]
        rw [h0]
        exact hspan_sub (hC_mod s)
      · intro p₁ p₂ hp₁ hp₂
        have h_add : Ideal.Quotient.mk J₁ (p₁ + p₂) -
            Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (π₀_mv (p₁ + p₂)))) =
            (Ideal.Quotient.mk J₁ p₁ -
              Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (π₀_mv p₁)))) +
            (Ideal.Quotient.mk J₁ p₂ -
              Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C (π₀_mv p₂)))) := by
          simp only [map_add]
          ring
        rw [h_add]
        exact (Ideal.span ({x₀, x₁} : Set P₁)).add_mem hp₁ hp₂
      · intro p₁ i _
        have h0 : π₀_mv (p₁ * MvPolynomial.X i) = 0 := by simp [π₀_mv]
        rw [h0, map_zero, map_zero, map_zero, sub_zero, map_mul]
        refine (Ideal.span ({x₀, x₁} : Set P₁)).mul_mem_left _ ?_
        by_cases hi0 : i = 0
        · subst hi0
          exact Ideal.subset_span (Set.mem_insert x₀ {x₁})
        · have hi1 : i = 1 := by omega
          subst hi1
          exact Ideal.subset_span (Set.mem_insert_of_mem x₀ (Set.mem_singleton x₁))
    have hRes_P₁ : ∀ r : P₁, ∃ c : Ω,
        r - Ideal.Quotient.mk J₁ (MvPolynomial.C (PowerSeries.C c)) ∈
          Ideal.span ({x₀, x₁} : Set P₁) := by
      intro r
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
