      rw [TensorProduct.tmul_sub, map_sub]
      exact congrArg₂ Sub.sub
        (hμ_nat inf_le_left (b ⊗ₜ[↑S] sf p.1)).symm
        (hμ_nat inf_le_right (b ⊗ₜ[↑S] sf p.2)).symm
    have hInj_lT_ρ : Function.Injective (LinearMap.lTensor ↑B ρ_Y) :=
      Module.Flat.lTensor_preserves_injective_linearMap ρ_Y hInj_ρY
    have hExact_lT : Function.Exact (LinearMap.lTensor ↑B ρ_Y) (LinearMap.lTensor ↑B δ_Y) :=
      Module.Flat.lTensor_exact ↑B hExact_Y
    have hBij_μ_top : Function.Bijective (μ_lin ⊤) := by
      constructor
      · intro z₁ z₂ hz
        apply hInj_lT_ρ
        apply E₁.injective
        calc E₁ (LinearMap.lTensor ↑B ρ_Y z₁)
            = ρ_P (μ_lin ⊤ z₁) := LinearMap.congr_fun hSq₁ z₁
          _ = ρ_P (μ_lin ⊤ z₂) := by rw [hz]
          _ = E₁ (LinearMap.lTensor ↑B ρ_Y z₂) := (LinearMap.congr_fun hSq₁ z₂).symm
      · intro y
        let w := E₁.symm (ρ_P y)
        have hw_ker : LinearMap.lTensor ↑B δ_Y w = 0 := by
          apply E₂.injective
          rw [map_zero]
