    · exact ⟨hd1_nzd, hd1_map⟩
    · exact ⟨hd2_nzd, hd2_map⟩
  have hLoc_fam : ∀ (r : Fin 3) (C_loc : Type u) [CommRing C_loc] [Algebra ↑(C_fam r) C_loc],
      IsLocalization.Away (p_fam r (g_vec r)) C_loc →
      @IsLocalization.Away Q_m _ (g_vec r) C_loc _
        ((algebraMap ↑(C_fam r) C_loc).comp (p_fam r)).toAlgebra := by
    intro r; fin_cases r
    · intro C_loc instR instA hL; exact @hLoc_0 C_loc instR instA hL
    · intro C_loc instR instA hL; exact @hLoc_1 C_loc instR instA hL
    · intro C_loc instR instA hL; exact @hLoc_2 C_loc instR instA hL
  have hLiftAlg_fam : ∀ (B : Type u) [CommRing B] (θ : Q_m →+* B) (d : B),
