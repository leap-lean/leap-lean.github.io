    constructor
    · intro s₁ s₂ hs
      apply TopCat.Sheaf.eq_of_locally_eq' C'.sheaf cov_W W i_W hle_sup_W s₁ s₂
      intro b
      apply (hBij_b b).1
      change (π.app (cov_W b)).hom ((C'.presheaf.map (i_W b).op).hom s₁) =
        (π.app (cov_W b)).hom ((C'.presheaf.map (i_W b).op).hom s₂)
      have hs' : (π.app W).hom s₁ = (π.app W).hom s₂ := hs
      rw [hNatApp (i_W b) s₁, hNatApp (i_W b) s₂, hs']
    · intro t
      let t_b : ∀ b : Bool, ↑(C''.presheaf.obj (Opposite.op (cov_W'' b))) :=
        fun b => (C''.presheaf.map (i_W'' b).op).hom t
      choose s_b hs_b using fun b : Bool => (hBij_b b).2 (t_b b)
      have hCompat : TopCat.Presheaf.IsCompatible C'.presheaf cov_W s_b := by
        intro b₁ b₂
        apply (hBij_bb b₁ b₂).1
        let p₁ := (cov_W b₁).infLELeft (cov_W b₂)
        let p₂ := (cov_W b₁).infLERight (cov_W b₂)
        change (π.app (cov_W b₁ ⊓ cov_W b₂)).hom ((C'.presheaf.map p₁.op).hom (s_b b₁)) =
          (π.app (cov_W b₁ ⊓ cov_W b₂)).hom ((C'.presheaf.map p₂.op).hom (s_b b₂))
        rw [hNatApp p₁ (s_b b₁), hNatApp p₂ (s_b b₂), hs_b b₁, hs_b b₂]
        dsimp [t_b]
        change (C''.presheaf.map (i_W'' b₁).op ≫
            C''.presheaf.map ((TopologicalSpace.Opens.map π.base).map p₁).op).hom t =
          (C''.presheaf.map (i_W'' b₂).op ≫
            C''.presheaf.map ((TopologicalSpace.Opens.map π.base).map p₂).op).hom t
        rw [← C''.presheaf.map_comp, ← C''.presheaf.map_comp,
          Subsingleton.elim ((i_W'' b₁).op ≫ ((TopologicalSpace.Opens.map π.base).map p₁).op)
            ((i_W'' b₂).op ≫ ((TopologicalSpace.Opens.map π.base).map p₂).op)]
      obtain ⟨s, hs_res, _⟩ :=
        TopCat.Sheaf.existsUnique_gluing' C'.sheaf cov_W W i_W hle_sup_W s_b hCompat
      refine ⟨s, ?_⟩
      apply TopCat.Sheaf.eq_of_locally_eq' C''.sheaf cov_W''
        ((TopologicalSpace.Opens.map π.base).obj W) i_W'' hle_sup_W''
      intro b
      change (C''.presheaf.map (i_W'' b).op).hom ((π.app W).hom s) =
        (C''.presheaf.map (i_W'' b).op).hom t
      have hs_res_b : (C'.presheaf.map (i_W b).op).hom s = s_b b := hs_res b
      rw [← hNatApp (i_W b) s, hs_res_b, hs_b b]
  exact ⟨C'', π, ι_tilde, ι_compl, hOpen_tilde, hOpen_compl, hCover'', hπ_tilde, hπ_compl,
    hPre_U, hPre_compl, hIso_compl, hPb_U, hInt_C'', hProp_π, hSurj_π, hFlat'', hLFP'',
    hTransferApp⟩

theorem weil_proper_modification_pushforward_iso_of_flat_roof (R₁ R₂ : CommRingCat.{u})
    (m₁ : Ideal ↑R₁) [m₁.IsMaximal]
    (X₁ X₂ : AlgebraicGeometry.Scheme.{u})
    (π₁ : X₁ ⟶ AlgebraicGeometry.Spec R₁)
    (π₂ : X₂ ⟶ AlgebraicGeometry.Spec R₂)
    (hProp₁ : AlgebraicGeometry.IsProper π₁)
    (hProp₂ : AlgebraicGeometry.IsProper π₂)
    (N₁ : ℕ) (V₁ : Fin N₁ → X₁.Opens)
    (hAff₁ : ∀ i : Fin N₁, AlgebraicGeometry.IsAffineOpen (V₁ i))
    (hCov₁ : (⋃ i : Fin N₁, (V₁ i : Set X₁)) = Set.univ)
    (N₂ : ℕ) (V₂ : Fin N₂ → X₂.Opens)
    (hAff₂ : ∀ j : Fin N₂, AlgebraicGeometry.IsAffineOpen (V₂ j))
    (hCov₂ : (⋃ j : Fin N₂, (V₂ j : Set X₂)) = Set.univ)
    (hIso₁_compl : CategoryTheory.IsIso
      (π₁ ∣_ ⟨(PrimeSpectrum.zeroLocus (m₁ : Set ↑R₁))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (m₁ : Set ↑R₁)).isOpen_compl⟩))
    (hIso₂_top : CategoryTheory.IsIso (π₂.app ⊤))
    (A' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec A')
    (e₁ : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec R₁)
    (e₂ : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec R₂)
    (hFlat₁ : AlgebraicGeometry.Flat e₁)
    (hFlat₂ : AlgebraicGeometry.Flat e₂)
    (hev'₀ : (e₁.base v'₀).asIdeal = m₁)
    (Φ : CategoryTheory.Limits.pullback π₁ e₁ ≅ CategoryTheory.Limits.pullback π₂ e₂)
    (hΦ_snd : Φ.hom ≫ CategoryTheory.Limits.pullback.snd π₂ e₂ =
      CategoryTheory.Limits.pullback.snd π₁ e₁) :
    ∀ V : (AlgebraicGeometry.Spec R₁).Opens,
      CategoryTheory.IsIso (π₁.app V) :=
by
  have hOpenAppIso : ∀ {Z T_sch : AlgebraicGeometry.Scheme.{u}} (g : Z ⟶ T_sch)
      [AlgebraicGeometry.IsOpenImmersion g] (U₀ : T_sch.Opens),
      (U₀ : Set T_sch) ⊆ Set.range g.base → CategoryTheory.IsIso (g.app U₀) := by
    clear! R₁ R₂ X₁ X₂ N₁ N₂ A'
    intro Z T_sch g _ U₀ hU₀
    have hEq : g ''ᵁ (g ⁻¹ᵁ U₀) = U₀ := by
      ext y
      exact ⟨by rintro ⟨x, hx, rfl⟩; exact hx,
        fun hy => by obtain ⟨x, rfl⟩ := hU₀ hy; exact ⟨x, hy, rfl⟩⟩
    rw [← hEq]; infer_instance
  have hSheafGlue : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      {ι : Type u} (U : ι → Y.Opens) (W : Y.Opens),
      (⨆ i : ι, U i) = W →
      (∀ i : ι, CategoryTheory.IsIso (f.app (U i))) →
      (∀ i j : ι, CategoryTheory.IsIso (f.app (U i ⊓ U j))) →
      CategoryTheory.IsIso (f.app W) := by
    clear! R₁ R₂ X₁ X₂ N₁ N₂ A'
    intro X Y f ι U W hSup hIso₁ hIso₂
    subst hSup
    let W_sup : Y.Opens := ⨆ i : ι, U i
    rw [CategoryTheory.ConcreteCategory.isIso_iff_bijective]
    have hBij₁ : ∀ i : ι, Function.Bijective (f.app (U i)).hom :=
      fun i => (CategoryTheory.ConcreteCategory.isIso_iff_bijective (f.app (U i))).mp (hIso₁ i)
    have hBij₂ : ∀ i j : ι, Function.Bijective (f.app (U i ⊓ U j)).hom :=
      fun i j =>
        (CategoryTheory.ConcreteCategory.isIso_iff_bijective (f.app (U i ⊓ U j))).mp (hIso₂ i j)
    constructor
    · intro s₁ s₂ hs
      apply Y.sheaf.eq_of_locally_eq U s₁ s₂
      intro i
      apply (hBij₁ i).1
      let inc_i : U i ⟶ W_sup := TopologicalSpace.Opens.leSupr U i
      have h₁ := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (f.naturality inc_i.op)) s₁
      have h₂ := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (f.naturality inc_i.op)) s₂
      change (f.app (U i)).hom ((Y.presheaf.map inc_i.op).hom s₁) =
        (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map inc_i).op).hom
          ((f.app W_sup).hom s₁) at h₁
      change (f.app (U i)).hom ((Y.presheaf.map inc_i.op).hom s₂) =
        (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map inc_i).op).hom
          ((f.app W_sup).hom s₂) at h₂
      change (f.app (U i)).hom ((Y.presheaf.map inc_i.op).hom s₁) =
        (f.app (U i)).hom ((Y.presheaf.map inc_i.op).hom s₂)
      rw [h₁, h₂, hs]
    · intro t
      let inc : ∀ i : ι, U i ⟶ W_sup := fun i => TopologicalSpace.Opens.leSupr U i
      let t_loc : ∀ i : ι, ↑(X.presheaf.obj (Opposite.op (f ⁻¹ᵁ U i))) :=
        fun i => (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map (inc i)).op).hom t
      choose sf hsf using fun i : ι => (hBij₁ i).2 (t_loc i)
      have hCompat : TopCat.Presheaf.IsCompatible Y.presheaf U sf := by
        intro i j
        apply (hBij₂ i j).1
        let p₁ : U i ⊓ U j ⟶ U i := TopologicalSpace.Opens.infLELeft (U i) (U j)
        let p₂ : U i ⊓ U j ⟶ U j := TopologicalSpace.Opens.infLERight (U i) (U j)
        have hnat₁ := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (f.naturality p₁.op)) (sf i)
        have hnat₂ := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (f.naturality p₂.op)) (sf j)
        change (f.app (U i ⊓ U j)).hom ((Y.presheaf.map p₁.op).hom (sf i)) =
          (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map p₁).op).hom
            ((f.app (U i)).hom (sf i)) at hnat₁
        change (f.app (U i ⊓ U j)).hom ((Y.presheaf.map p₂.op).hom (sf j)) =
          (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map p₂).op).hom
            ((f.app (U j)).hom (sf j)) at hnat₂
        change (f.app (U i ⊓ U j)).hom ((Y.presheaf.map p₁.op).hom (sf i)) =
          (f.app (U i ⊓ U j)).hom ((Y.presheaf.map p₂.op).hom (sf j))
        rw [hnat₁, hnat₂, hsf i, hsf j]
        dsimp only [t_loc]
        have h_comp₁ :
            (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map (inc i)).op ≫
              X.presheaf.map ((TopologicalSpace.Opens.map f.base).map p₁).op) =
            X.presheaf.map ((TopologicalSpace.Opens.map f.base).map (p₁ ≫ inc i)).op := by
          rw [← Functor.map_comp, ← op_comp, ← Functor.map_comp]
        have h_comp₂ :
            (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map (inc j)).op ≫
              X.presheaf.map ((TopologicalSpace.Opens.map f.base).map p₂).op) =
            X.presheaf.map ((TopologicalSpace.Opens.map f.base).map (p₂ ≫ inc j)).op := by
          rw [← Functor.map_comp, ← op_comp, ← Functor.map_comp]
        have h_eq_hom : p₁ ≫ inc i = p₂ ≫ inc j := Subsingleton.elim _ _
        exact RingHom.congr_fun
          (congrArg CommRingCat.Hom.hom (h_comp₁.trans (h_eq_hom ▸ h_comp₂.symm))) t
      obtain ⟨s, hs_gl, _⟩ := Y.sheaf.existsUnique_gluing U sf hCompat
      refine ⟨s, ?_⟩
      let UX : ι → X.Opens := fun i => f ⁻¹ᵁ U i
      have hSupX : (⨆ i : ι, UX i) = f ⁻¹ᵁ W_sup := by
        apply le_antisymm
        · exact iSup_le fun i => (TopologicalSpace.Opens.map f.base).monotone (le_iSup U i)
        · intro x hx
          rw [TopologicalSpace.Opens.mem_iSup]
          have hx' : f.base x ∈ ⨆ i : ι, U i := hx
          rwa [TopologicalSpace.Opens.mem_iSup] at hx'
      let eX : Opposite.op (f ⁻¹ᵁ W_sup) ≅ Opposite.op (⨆ i : ι, UX i) :=
        CategoryTheory.eqToIso (congrArg Opposite.op hSupX.symm)
      apply (CategoryTheory.ConcreteCategory.bijective_of_isIso (X.presheaf.map eX.hom)).1
      apply X.sheaf.eq_of_locally_eq UX
      intro i
      let incX_i : UX i ⟶ ⨆ k : ι, UX k := TopologicalSpace.Opens.leSupr UX i
      have h_map_eq : eX.hom ≫ incX_i.op =
          ((TopologicalSpace.Opens.map f.base).map (inc i)).op :=
        Subsingleton.elim _ _
      have h_lhs :
          (X.presheaf.map incX_i.op).hom
            ((X.presheaf.map eX.hom).hom ((f.app W_sup).hom s)) =
          (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map (inc i)).op).hom
            ((f.app W_sup).hom s) := by
        change ((X.presheaf.map eX.hom ≫ X.presheaf.map incX_i.op).hom) ((f.app W_sup).hom s) = _
        rw [← Functor.map_comp, h_map_eq]
      have h_rhs :
          (X.presheaf.map incX_i.op).hom ((X.presheaf.map eX.hom).hom t) = t_loc i := by
        change ((X.presheaf.map eX.hom ≫ X.presheaf.map incX_i.op).hom) t = _
        rw [← Functor.map_comp, h_map_eq]
      change (X.presheaf.map incX_i.op).hom
          ((X.presheaf.map eX.hom).hom ((f.app W_sup).hom s)) =
        (X.presheaf.map incX_i.op).hom ((X.presheaf.map eX.hom).hom t)
      rw [h_lhs, h_rhs]
      have hnat := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (f.naturality (inc i).op)) s
      change (f.app (U i)).hom ((Y.presheaf.map (inc i).op).hom s) =
        (X.presheaf.map ((TopologicalSpace.Opens.map f.base).map (inc i)).op).hom
          ((f.app W_sup).hom s) at hnat
      have hs_i : (Y.presheaf.map (inc i).op).hom s = sf i := hs_gl i
      rw [← hnat, hs_i, hsf i]
  have hAffPullback : ∀ (S B : CommRingCat.{u})
      (Y : AlgebraicGeometry.Scheme.{u})
      (q : Y ⟶ AlgebraicGeometry.Spec S)
      (f : AlgebraicGeometry.Spec B ⟶ AlgebraicGeometry.Spec S)
      (U₀ : Y.Opens),
      AlgebraicGeometry.IsAffineOpen U₀ →
      let P := CategoryTheory.Limits.pullback q f
      let fst := CategoryTheory.Limits.pullback.fst q f
      let snd := CategoryTheory.Limits.pullback.snd q f
      let U_P : P.Opens := (TopologicalSpace.Opens.map fst.base).obj U₀
      let φ : ↑S →+* ↑B := (AlgebraicGeometry.Spec.preimage f).hom
      let u_top : ↑S →+* ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso S).inv ≫ q.appTop).hom
      let v_top : ↑B →+* ↑(P.presheaf.obj (Opposite.op ⊤)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso B).inv ≫ snd.appTop).hom
      let β₀ : ↑S →+* ↑(Y.presheaf.obj (Opposite.op U₀)) :=
        (Y.presheaf.map (CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)).op).hom.comp u_top
      let γ₀ : ↑B →+* ↑(P.presheaf.obj (Opposite.op U_P)) :=
        (P.presheaf.map (CategoryTheory.homOfLE (le_top : U_P ≤ ⊤)).op).hom.comp v_top
      letI : Algebra ↑S ↑B := φ.toAlgebra
      letI : Algebra ↑S ↑(Y.presheaf.obj (Opposite.op U₀)) := β₀.toAlgebra
      letI : Algebra ↑S ↑(P.presheaf.obj (Opposite.op U_P)) := (γ₀.comp φ).toAlgebra
      ∃ μ : TensorProduct ↑S ↑B ↑(Y.presheaf.obj (Opposite.op U₀)) ≃ₗ[↑S]
          ↑(P.presheaf.obj (Opposite.op U_P)),
        ∀ (b : ↑B) (c : ↑(Y.presheaf.obj (Opposite.op U₀))),
          μ (b ⊗ₜ[↑S] c) = γ₀ b * (fst.app U₀).hom c := by
    clear! R₁ R₂ X₁ X₂ N₁ N₂ A' hSheafGlue
    intro S B Y q f U₀ hU₀
    let P := CategoryTheory.Limits.pullback q f
    let fst := CategoryTheory.Limits.pullback.fst q f
    let snd := CategoryTheory.Limits.pullback.snd q f
    let U_P : P.Opens := (TopologicalSpace.Opens.map fst.base).obj U₀
    let φ : ↑S →+* ↑B := (AlgebraicGeometry.Spec.preimage f).hom
    let u_top : ↑S →+* ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso S).inv ≫ q.appTop).hom
    let v_top : ↑B →+* ↑(P.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso B).inv ≫ snd.appTop).hom
    let incY : U₀ ⟶ ⊤ := CategoryTheory.homOfLE (le_top : U₀ ≤ ⊤)
    let incP : U_P ⟶ ⊤ := CategoryTheory.homOfLE (le_top : U_P ≤ ⊤)
    let β₀ : ↑S →+* ↑(Y.presheaf.obj (Opposite.op U₀)) :=
      (Y.presheaf.map incY.op).hom.comp u_top
    let γ₀ : ↑B →+* ↑(P.presheaf.obj (Opposite.op U_P)) :=
      (P.presheaf.map incP.op).hom.comp v_top
    let R_U₀ : CommRingCat.{u} := Y.presheaf.obj (Opposite.op U₀)
    let AY₀ : Type u := ↑R_U₀
    letI : CommRing AY₀ := inferInstance
    let AP₀ : Type u := ↑(P.presheaf.obj (Opposite.op U_P))
    letI : CommRing AP₀ := inferInstance
    letI : Algebra ↑S ↑B := φ.toAlgebra
    letI : Algebra ↑S AY₀ := β₀.toAlgebra
    letI : Algebra ↑S AP₀ := (γ₀.comp φ).toAlgebra
    have hf_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = f := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage f).hom) = f
      rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
    have h_top_comm : ∀ r : ↑S, (fst.appTop).hom (u_top r) = v_top (φ r) := by
      intro r
      have hcond_top : q.appTop ≫ fst.appTop = f.appTop ≫ snd.appTop := by
        have hc := congrArg AlgebraicGeometry.Scheme.Hom.appTop
          (CategoryTheory.Limits.pullback.condition (f := q) (g := f))
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_appTop] using hc
      have hf_nat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (AlgebraicGeometry.Spec.preimage f)
      rw [AlgebraicGeometry.Spec.map_preimage] at hf_nat
      have hf_inv : (AlgebraicGeometry.Scheme.ΓSpecIso S).inv ≫ f.appTop =
          AlgebraicGeometry.Spec.preimage f ≫ (AlgebraicGeometry.Scheme.ΓSpecIso B).inv := by
        rw [CategoryTheory.Iso.inv_comp_eq, ← CategoryTheory.Category.assoc, ← hf_nat,
          CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      have h_full : ((AlgebraicGeometry.Scheme.ΓSpecIso S).inv ≫ q.appTop) ≫ fst.appTop =
          AlgebraicGeometry.Spec.preimage f ≫
            ((AlgebraicGeometry.Scheme.ΓSpecIso B).inv ≫ snd.appTop) := by
        rw [CategoryTheory.Category.assoc, hcond_top, ← CategoryTheory.Category.assoc, hf_inv,
          CategoryTheory.Category.assoc]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom h_full) r
    have h_fst_comm : ∀ r : ↑S, (fst.app U₀).hom (β₀ r) = γ₀ (φ r) := by
      intro r
      have hnat := RingHom.congr_fun
        (congrArg CommRingCat.Hom.hom (fst.naturality incY.op)) (u_top r)
      change (fst.app U₀).hom (β₀ r) =
        (P.presheaf.map ((TopologicalSpace.Opens.map fst.base).map incY).op).hom
          ((fst.appTop).hom (u_top r)) at hnat
      have h_inc : (TopologicalSpace.Opens.map fst.base).map incY = incP :=
        Subsingleton.elim _ _
      rw [hnat, h_inc, h_top_comm r]
      rfl
    let γ_alg : ↑B →ₐ[↑S] AP₀ := { γ₀ with commutes' := fun _ => rfl }
    let fst_alg : AY₀ →ₐ[↑S] AP₀ := { (fst.app U₀).hom with commutes' := h_fst_comm }
    let μ_alg : TensorProduct ↑S ↑B AY₀ →ₐ[↑S] AP₀ :=
      Algebra.TensorProduct.lift γ_alg fst_alg (fun _ _ => mul_comm _ _)
    let μ_lin : TensorProduct ↑S ↑B AY₀ →ₗ[↑S] AP₀ := μ_alg.toLinearMap
    have hβ_pre : (AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ q)).hom = β₀ := by
      have hnat_q := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ q))
      rw [AlgebraicGeometry.Spec.map_preimage] at hnat_q
      have h_pre_eq : AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ q) =
          (AlgebraicGeometry.Scheme.ΓSpecIso S).inv ≫ q.appTop ≫
            hU₀.fromSpec.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).hom := by
        rw [CategoryTheory.Iso.eq_inv_comp, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hnat_q]
      have h_from_nat := hU₀.fromSpec.naturality incY.op
      rw [hU₀.fromSpec_app_self] at h_from_nat
      have h_op_same :
          ((TopologicalSpace.Opens.map hU₀.fromSpec.base).map incY.op.unop).op =
            (CategoryTheory.eqToHom hU₀.fromSpec_preimage_self).op :=
        congrArg Opposite.op (Subsingleton.elim _ _)
      rw [h_op_same, ← CategoryTheory.Category.assoc] at h_from_nat
      have h_cancel : Y.presheaf.map incY.op ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).inv =
          hU₀.fromSpec.appTop :=
        (CategoryTheory.cancel_mono
          ((AlgebraicGeometry.Spec R_U₀).presheaf.map
            (CategoryTheory.eqToHom hU₀.fromSpec_preimage_self).op)).mp h_from_nat
      have h_appTop : hU₀.fromSpec.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).hom =
          Y.presheaf.map incY.op := by
        rw [← h_cancel, CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.comp_id]
      rw [h_appTop] at h_pre_eq
      exact congrArg CommRingCat.Hom.hom h_pre_eq
    have hβ_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↑S AY₀)) =
        hU₀.fromSpec ≫ q := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀) = hU₀.fromSpec ≫ q
      rw [← hβ_pre, CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
    let T₀ := TensorProduct ↑S ↑B AY₀
    let ιL : ↑B →+* T₀ := Algebra.TensorProduct.includeLeftRingHom
    let ιL_hom : B ⟶ CommRingCat.of T₀ := CommRingCat.ofHom ιL
    let ιR : AY₀ →+* T₀ := (Algebra.TensorProduct.includeRight : AY₀ →ₐ[↑S] T₀)
    let ιR_hom : R_U₀ ⟶ CommRingCat.of T₀ := CommRingCat.ofHom ιR
    let e_comm : TensorProduct ↑S AY₀ ↑B ≃+* T₀ :=
      (Algebra.TensorProduct.comm ↑S AY₀ ↑B).toRingEquiv
    let iso_spec_comm : AlgebraicGeometry.Spec (CommRingCat.of T₀) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↑S AY₀ ↑B)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_comm.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          refine (congrArg AlgebraicGeometry.Spec.map ?_).trans (AlgebraicGeometry.Spec.map_id _)
          apply CommRingCat.hom_ext; apply RingHom.ext; intro z
          exact e_comm.apply_symm_apply z
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          refine (congrArg AlgebraicGeometry.Spec.map ?_).trans (AlgebraicGeometry.Spec.map_id _)
          apply CommRingCat.hom_ext; apply RingHom.ext; intro z
