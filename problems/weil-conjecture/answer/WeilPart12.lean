        rcases hP.mem_or_mem h0 with hb₀_P | hb₁_P
        · left; rw [Ideal.span_singleton_le_iff_mem]; exact hb₀_P
        · right; rw [Ideal.span_singleton_le_iff_mem]; exact hb₁_P
