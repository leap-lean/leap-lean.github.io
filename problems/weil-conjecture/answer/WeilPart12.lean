            (Proj.awayToSection 𝒜 (X_var ℓ)).hom := by
        rw [Subring.closure_le]
        rintro z (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · exact Subring.subset_closure (Or.inl ⟨r, rfl⟩)
        · exact Subring.subset_closure (Or.inr ⟨b, rfl⟩)
      exact h_map_le hx_mem
    have haK_ne : ∀ ℓ : Fin (d + 1), ι_K (a ℓ) ≠ 0 :=
      fun ℓ h => ha_ne ℓ (hinj_K (h.trans (map_zero _).symm))
    let ev_homog : M_poly →+* K_A :=
      MvPolynomial.eval₂Hom ι_K (fun j => ι_K (a j))
