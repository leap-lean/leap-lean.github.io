        have h_elem_eq : HomogeneousLocalization.Away.isLocalizationElem (hX1 ℓ) (hX1 ℓ') =
            t_away ℓ ℓ' := by
          apply HomogeneousLocalization.val_injective (Submonoid.powers (X_var ℓ))
          rw [HomogeneousLocalization.Away.val_mk, ht_away_val ℓ ℓ']
          congr 1
          exact pow_one _
        change (j_ℓ ⁻¹ᵁ D ℓ) ⊓ (j_ℓ ⁻¹ᵁ D ℓ') = _
        rw [h_pre_Dℓ, top_inf_eq, h_pre_Dℓ', h_elem_eq]
      have hPre_lhs : j_ℓ ⁻¹ᵁ (P_A.basicOpen (t_A ℓ ℓ')) =
          PrimeSpectrum.basicOpen (t_away ℓ ℓ') := by
        have hj_eq : j_ℓ =
            Spec.map (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv ≫
              (hAff_A ℓ).fromSpec := by
          have hb := hBridge ℓ
          rw [← Proj.basicOpenIsoAway_hom 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one] at hb
          calc j_ℓ = (Spec.map (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv ≫
                Spec.map (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).hom) ≫ j_ℓ := by
                rw [← Spec.map_comp, Iso.hom_inv_id, Spec.map_id, Category.id_comp]
            _ = Spec.map (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv ≫
                  (hAff_A ℓ).fromSpec := by rw [Category.assoc, hb]
        ext q
        have h_mem1 : q ∈ j_ℓ ⁻¹ᵁ (P_A.basicOpen (t_A ℓ ℓ')) ↔
