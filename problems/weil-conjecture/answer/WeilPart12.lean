        have h1 : (hU₀.fromSpec ≫ pE) =
            AlgebraicGeometry.Spec.map (E_sch.presheaf.map i_V.op) ≫ (hV.fromSpec ≫ pE) := by
          rw [← hMapV, Category.assoc]
        dsimp [α_Ω, pE, pP1]
        rw [h1, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
