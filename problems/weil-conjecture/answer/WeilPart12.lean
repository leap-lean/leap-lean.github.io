            Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)
          let q₀ := Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 2) Ω)))
          have h_id : q₀.comp (ψ₀.comp φ₀) = q₀ := by
            apply MvPolynomial.ringHom_ext
            · intro c
              simp [φ₀, ψ₀]
            · intro i
              fin_cases i
              · simp [φ₀, ψ₀, q₀]
              · simp [φ₀, ψ₀]
          have h_eq := RingHom.congr_fun h_id F
          simp only [RingHom.comp_apply, hF, map_zero] at h_eq
          exact Ideal.Quotient.eq_zero_iff_mem.mp h_eq.symm
        · rw [Ideal.span_le]
          rintro _ rfl
          rw [SetLike.mem_coe, RingHom.mem_ker]
          simp [φ₀]
      have hKer1 : RingHom.ker φ₁ = Ideal.span {MvPolynomial.X 1} := by
        apply le_antisymm
        · intro F hF
          rw [RingHom.mem_ker] at hF
          let ψ₁ : Polynomial Ω →+* MvPolynomial (Fin 2) Ω :=
            Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
          let q₁ := Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω)))
          have h_id : q₁.comp (ψ₁.comp φ₁) = q₁ := by
            apply MvPolynomial.ringHom_ext
            · intro c
              simp [φ₁, ψ₁]
            · intro i
              fin_cases i
              · simp [φ₁, ψ₁]
              · simp [φ₁, ψ₁, q₁]
          have h_eq := RingHom.congr_fun h_id F
          simp only [RingHom.comp_apply, hF, map_zero] at h_eq
          exact Ideal.Quotient.eq_zero_iff_mem.mp h_eq.symm
        · rw [Ideal.span_le]
          rintro _ rfl
          rw [SetLike.mem_coe, RingHom.mem_ker]
          simp [φ₁]
      have hHom0 : Ideal.IsHomogeneous 𝒜 (RingHom.ker φ₀) := by
        rw [hKer0]
        exact Ideal.homogeneous_span 𝒜 _ (by rintro _ rfl; exact ⟨1, hX0_mem⟩)
      have hHom1 : Ideal.IsHomogeneous 𝒜 (RingHom.ker φ₁) := by
        rw [hKer1]
        exact Ideal.homogeneous_span 𝒜 _ (by rintro _ rfl; exact ⟨1, hX1_mem⟩)
      let H_bot : HomogeneousIdeal 𝒜 := ⊥
      let H_0 : HomogeneousIdeal 𝒜 := Ideal.homogeneousCore 𝒜 (RingHom.ker φ₀)
      let H_1 : HomogeneousIdeal 𝒜 := Ideal.homogeneousCore 𝒜 (RingHom.ker φ₁)
      have hH0_id : H_0.toIdeal = RingHom.ker φ₀ := (Ideal.IsHomogeneous.iff_eq 𝒜 _).mp hHom0
      have hH1_id : H_1.toIdeal = RingHom.ker φ₁ := (Ideal.IsHomogeneous.iff_eq 𝒜 _).mp hHom1
      have hNotIrr_bot : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ H_bot := by
        rw [HomogeneousIdeal.irrelevant_le]
        intro h_all
        have hX0_bot : (MvPolynomial.X 0 : MvPolynomial (Fin 2) Ω) ∈ H_bot.toIdeal :=
          h_all 1 zero_lt_one hX0_mem
        change (MvPolynomial.X 0 : MvPolynomial (Fin 2) Ω) ∈ (⊥ : Ideal _) at hX0_bot
        rw [Ideal.mem_bot] at hX0_bot
        have h_ev : φ₁ (MvPolynomial.X 0) = 0 := by rw [hX0_bot, map_zero]
        have h_X : φ₁ (MvPolynomial.X 0) = Polynomial.X := by simp [φ₁]
        exact Polynomial.X_ne_zero (h_X ▸ h_ev)
      have hNotIrr_0 : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ H_0 := by
        rw [HomogeneousIdeal.irrelevant_le]
        intro h_all
        have hX1_in : (MvPolynomial.X 1 : MvPolynomial (Fin 2) Ω) ∈ H_0.toIdeal :=
          h_all 1 zero_lt_one hX1_mem
        rw [hH0_id, RingHom.mem_ker] at hX1_in
        have h_X : φ₀ (MvPolynomial.X 1) = Polynomial.X := by simp [φ₀]
        exact Polynomial.X_ne_zero (h_X ▸ hX1_in)
      have hNotIrr_1 : ¬HomogeneousIdeal.irrelevant 𝒜 ≤ H_1 := by
        rw [HomogeneousIdeal.irrelevant_le]
        intro h_all
        have hX0_in : (MvPolynomial.X 0 : MvPolynomial (Fin 2) Ω) ∈ H_1.toIdeal :=
          h_all 1 zero_lt_one hX0_mem
        rw [hH1_id, RingHom.mem_ker] at hX0_in
        have h_X : φ₁ (MvPolynomial.X 0) = Polynomial.X := by simp [φ₁]
        exact Polynomial.X_ne_zero (h_X ▸ hX0_in)
      have hPrime_bot : H_bot.toIdeal.IsPrime := by
        change (⊥ : Ideal (MvPolynomial (Fin 2) Ω)).IsPrime
        infer_instance
      have hPrime_0 : H_0.toIdeal.IsPrime := hH0_id ▸ RingHom.ker_isPrime φ₀
      have hPrime_1 : H_1.toIdeal.IsPrime := hH1_id ▸ RingHom.ker_isPrime φ₁
      let p_bot : ProjectiveSpectrum 𝒜 := ⟨H_bot, hPrime_bot, hNotIrr_bot⟩
      let p_0 : ProjectiveSpectrum 𝒜 := ⟨H_0, hPrime_0, hNotIrr_0⟩
      let p_1 : ProjectiveSpectrum 𝒜 := ⟨H_1, hPrime_1, hNotIrr_1⟩
      refine ⟨p_bot, p_0, p_1, ?_, ?_, ?_⟩
      · intro h
        have h_id : (⊥ : Ideal (MvPolynomial (Fin 2) Ω)) = RingHom.ker φ₀ :=
          (congrArg (fun p : ProjectiveSpectrum 𝒜 => p.asHomogeneousIdeal.toIdeal) h).trans hH0_id
        have hX0_bot : (MvPolynomial.X 0 : MvPolynomial (Fin 2) Ω) ∈ (⊥ : Ideal _) := by
          rw [h_id, RingHom.mem_ker]
          simp [φ₀]
        rw [Ideal.mem_bot] at hX0_bot
        have h_ev : φ₁ (MvPolynomial.X 0) = 0 := by rw [hX0_bot, map_zero]
        have h_X : φ₁ (MvPolynomial.X 0) = Polynomial.X := by simp [φ₁]
        exact Polynomial.X_ne_zero (h_X ▸ h_ev)
      · intro h
        have h_id : (⊥ : Ideal (MvPolynomial (Fin 2) Ω)) = RingHom.ker φ₁ :=
          (congrArg (fun p : ProjectiveSpectrum 𝒜 => p.asHomogeneousIdeal.toIdeal) h).trans hH1_id
        have hX1_bot : (MvPolynomial.X 1 : MvPolynomial (Fin 2) Ω) ∈ (⊥ : Ideal _) := by
          rw [h_id, RingHom.mem_ker]
          simp [φ₁]
        rw [Ideal.mem_bot] at hX1_bot
        have h_ev : φ₀ (MvPolynomial.X 1) = 0 := by rw [hX1_bot, map_zero]
        have h_X : φ₀ (MvPolynomial.X 1) = Polynomial.X := by simp [φ₀]
        exact Polynomial.X_ne_zero (h_X ▸ h_ev)
      · intro h
        have h_id : RingHom.ker φ₀ = RingHom.ker φ₁ :=
          hH0_id.symm.trans
            ((congrArg (fun p : ProjectiveSpectrum 𝒜 => p.asHomogeneousIdeal.toIdeal) h).trans hH1_id)
        have hX0_in1 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) Ω) ∈ RingHom.ker φ₁ := by
          rw [← h_id, RingHom.mem_ker]
          simp [φ₀]
        rw [RingHom.mem_ker] at hX0_in1
        have h_X : φ₁ (MvPolynomial.X 0) = Polynomial.X := by simp [φ₁]
        exact Polynomial.X_ne_zero (h_X ▸ hX0_in1)
    have hThreePts : ∀ a : Fin k_exc, ∃ y₀ y₁ y₂ : ↥Y'',
        y₀ ≠ y₁ ∧ y₀ ≠ y₂ ∧ y₁ ≠ y₂ ∧
        y₀ ∈ E''_exc a ∧ y₁ ∈ E''_exc a ∧ y₂ ∈ E''_exc a := by
      intro a
      obtain ⟨p₀, p₁, p₂, hp01, hp02, hp12⟩ := hP1_pts
      let f_emb := (iso_exc a).inv ≫ ι''_exc a
      have _ : AlgebraicGeometry.IsClosedImmersion (ι''_exc a) := hCl_ι'' a
      have hf_inj : Function.Injective f_emb.base := by
        intro u v huv
        have h1 := (ι''_exc a).isClosedEmbedding.injective huv
        have h2 := congrArg (iso_exc a).hom.base h1
        change ((iso_exc a).inv ≫ (iso_exc a).hom).base u =
          ((iso_exc a).inv ≫ (iso_exc a).hom).base v at h2
        rwa [CategoryTheory.Iso.inv_hom_id] at h2
      refine ⟨f_emb.base p₀, f_emb.base p₁, f_emb.base p₂,
        fun h => hp01 (hf_inj h), fun h => hp02 (hf_inj h), fun h => hp12 (hf_inj h),
        ⟨(iso_exc a).inv.base p₀, rfl⟩, ⟨(iso_exc a).inv.base p₁, rfl⟩,
        ⟨(iso_exc a).inv.base p₂, rfl⟩⟩
    have hExc_not_sub_strict : ∀ (a : Fin k_exc) (K' : Set ↥Y'),
        K' ∈ irreducibleComponents ↥Y' → ¬(E''_exc a ⊆ closure (π₀.base ⁻¹' (K' \ {z₀}))) := by
      intro a K' hK' h_sub
      have h_exc_fib : E''_exc a ⊆ π₀.base ⁻¹' {z₀} := by
        rw [hFib_cov]
        exact Set.subset_iUnion E''_exc a
      have h_exc_pair : E''_exc a ⊆ ({b₀, b₁} : Set ↥Y'') := by
        rw [← hBridge_eq]
        exact Set.subset_inter
          (h_sub.trans (Set.subset_biUnion_of_mem (u := fun K => closure (π₀.base ⁻¹' (K \ {z₀}))) hK'))
          h_exc_fib
      obtain ⟨y₀, y₁, y₂, h01, h02, h12, hy₀, hy₁, hy₂⟩ := hThreePts a
      rcases h_exc_pair hy₀ with rfl | h0b1 <;>
        rcases h_exc_pair hy₁ with h1b0 | h1b1 <;>
        rcases h_exc_pair hy₂ with h2b0 | h2b1
      · exact h01 h1b0.symm
      · exact h01 h1b0.symm
      · exact h02 h2b0.symm
      · rw [Set.mem_singleton_iff] at h1b1 h2b1
        exact h12 (h1b1.trans h2b1.symm)
      · exact h12 (h1b0.trans h2b0.symm)
      · rw [Set.mem_singleton_iff] at h0b1 h2b1
        exact h02 (h0b1.trans h2b1.symm)
      · rw [Set.mem_singleton_iff] at h0b1 h1b1
        exact h01 (h0b1.trans h1b1.symm)
      · rw [Set.mem_singleton_iff] at h0b1 h1b1
        exact h01 (h0b1.trans h1b1.symm)
    have hStrict_not_sub_exc : ∀ (K' : Set ↥Y') (a : Fin k_exc),
        K' ∈ irreducibleComponents ↥Y' → ¬(closure (π₀.base ⁻¹' (K' \ {z₀})) ⊆ E''_exc a) := by
      intro K' a hK' h_sub
      obtain ⟨y, hyK, hyz⟩ := hStrict_nonempty K' hK'
      obtain ⟨q, hq_ne, hq_eq⟩ := hBij_compl.surjOn hyz
      have hq_pre : q ∈ π₀.base ⁻¹' (K' \ {z₀}) := by
        change π₀.base q ∈ K' \ {z₀}
        rw [hq_eq]
        exact ⟨hyK, hyz⟩
      have hq_exc : q ∈ E''_exc a := h_sub (subset_closure hq_pre)
      have hq_fib : q ∈ π₀.base ⁻¹' {z₀} := by
        rw [hFib_cov]
        exact Set.mem_iUnion.mpr ⟨a, hq_exc⟩
      exact hq_ne hq_fib
    let 𝒞 : Set (Set ↥Y'') :=
      (⋃ a : Fin k_exc, {E''_exc a}) ∪
        (fun K' => closure (π₀.base ⁻¹' (K' \ {z₀}))) '' irreducibleComponents ↥Y'
    have h𝒞_fin : 𝒞.Finite :=
      (Set.finite_iUnion fun a => Set.finite_singleton (E''_exc a)).union (hFin_Y'.image _)
    have h𝒞_closed : ∀ C ∈ 𝒞, IsClosed C := by
      intro C hC
      rcases hC with h_exc | ⟨K', _, rfl⟩
      · rcases Set.mem_iUnion.mp h_exc with ⟨a, ha⟩
        rw [Set.mem_singleton_iff.mp ha]
        have _ := hCl_ι'' a
        exact (ι''_exc a).isClosedEmbedding.isClosed_range
      · exact isClosed_closure
    have h𝒞_irred : ∀ C ∈ 𝒞, IsIrreducible C := by
      intro C hC
      rcases hC with h_exc | ⟨K', hK', rfl⟩
      · rcases Set.mem_iUnion.mp h_exc with ⟨a, ha⟩
        rw [Set.mem_singleton_iff.mp ha]
        dsimp only [E''_exc]
        have _ : AlgebraicGeometry.IsIntegral (E_exc a) := (hExc_m a).2.1
        have _ : IrreducibleSpace ↥(E_exc a) :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral (E_exc a)
        rw [← Set.image_univ]
        exact (IrreducibleSpace.isIrreducible_univ ↥(E_exc a)).image
          (ι''_exc a).base (ι''_exc a).continuous.continuousOn
      · exact hStrict_irred K' hK'
    have h𝒞_sUnion : ⋃₀ 𝒞 = Set.univ := by
      ext q
      simp only [Set.mem_sUnion, Set.mem_univ, iff_true]
      by_cases hqz : π₀.base q = z₀
      · have hq_fib : q ∈ π₀.base ⁻¹' {z₀} := hqz
        rw [hFib_cov, Set.mem_iUnion] at hq_fib
        rcases hq_fib with ⟨a, ha⟩
        exact ⟨E''_exc a, Or.inl (Set.mem_iUnion.mpr ⟨a, Set.mem_singleton _⟩), ha⟩
      · have hq_cl : q ∈ closure ((π₀.base ⁻¹' {z₀})ᶜ) := subset_closure hqz
        rw [hCl_F''c, Set.mem_iUnion] at hq_cl
        rcases hq_cl with ⟨K', hqK'⟩
        rw [Set.mem_iUnion] at hqK'
        rcases hqK' with ⟨hK', hq_mem⟩
        exact ⟨closure (π₀.base ⁻¹' (K' \ {z₀})), Or.inr ⟨K', hK', rfl⟩, hq_mem⟩
    have h𝒞_antichain : ∀ C₁ ∈ 𝒞, ∀ C₂ ∈ 𝒞, C₁ ⊆ C₂ → C₁ = C₂ := by
      intro C₁ hC₁ C₂ hC₂ h_sub
      rcases hC₁ with h1_exc | ⟨K₁', hK₁', rfl⟩ <;> rcases hC₂ with h2_exc | ⟨K₂', hK₂', rfl⟩
      · rcases Set.mem_iUnion.mp h1_exc with ⟨a₁, ha₁⟩
        rcases Set.mem_iUnion.mp h2_exc with ⟨a₂, ha₂⟩
        rw [Set.mem_singleton_iff] at ha₁ ha₂
        subst ha₁; subst ha₂
        exact hExc_sub_eq a₁ a₂ h_sub
      · rcases Set.mem_iUnion.mp h1_exc with ⟨a₁, ha₁⟩
        rw [Set.mem_singleton_iff] at ha₁
        subst ha₁
        exact False.elim (hExc_not_sub_strict a₁ K₂' hK₂' h_sub)
      · rcases Set.mem_iUnion.mp h2_exc with ⟨a₂, ha₂⟩
        rw [Set.mem_singleton_iff] at ha₂
        subst ha₂
        exact False.elim (hStrict_not_sub_exc K₁' a₂ hK₁' h_sub)
      · rw [hStrict_sub K₁' hK₁' K₂' hK₂' h_sub]
    have hIrred_sub_𝒞 : ∀ Z : Set ↥Y'', IsIrreducible Z → ∃ D ∈ 𝒞, Z ⊆ D := by
      intro Z hZ
      let t := h𝒞_fin.toFinset
      have ht_cl : ∀ D ∈ t, IsClosed D := fun D hD => h𝒞_closed D (h𝒞_fin.mem_toFinset.mp hD)
      have ht_cov : Z ⊆ ⋃₀ (t : Set (Set ↥Y'')) := by
