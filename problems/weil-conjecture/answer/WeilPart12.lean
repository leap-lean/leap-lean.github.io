    let π_proj : ∀ ℓ : Fin (d + 1), ↑(P_A.presheaf.obj (Opposite.op (D ℓ))) →+* C_chart ℓ :=
      fun ℓ => (e_range ℓ).symm.toRingHom.comp
        ((ψ_sec ℓ).codRestrict (ι_chart ℓ).range (hψ_in_range ℓ))
    have hι_π_eq : ∀ (ℓ : Fin (d + 1)) (s), ι_chart ℓ (π_proj ℓ s) = ψ_sec ℓ s := by
      intro ℓ s
