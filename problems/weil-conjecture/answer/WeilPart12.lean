          calc c₁ = (c₁ * c₁₂) * c₁₂⁻¹ := by rw [mul_inv_cancel_right₀ hc12_zero]
            _ = c₂₂ * c₁₂⁻¹ := by rw [hmul]
        have hnonvan : m₂₂ - φ_e (φ₀ (PowerSeries.C c₁)) * m₁₂ ∉ v₀.asIdeal := by
          intro hmem
