      ⟨N_cov, V_cov, hAffV, t_gen, hCov_U, hGen_U⟩, hUniv_U⟩ := hBlU
  have hProp_M : AlgebraicGeometry.IsProper p_m := hLoc.2.2.2.2.1
  have hIso_M_top : CategoryTheory.IsIso (p_m.app ⊤) := hLoc.2.2.2.2.2.2.2.1 ⊤
  have hConn_M := hLoc.2.2.2.2.2.2.2.2.1
  obtain ⟨W_cov, hAffW, d_gen, hCov_M, hGen_M⟩ := hLoc.2.2.2.2.2.2.2.2.2.1
  have hUniv_M := hLoc.2.2.2.2.2.2.2.2.2.2.1
  have hSpec_φR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R) =
      hAffU.fromSpec ≫ g' := by
    change AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom) =
      hAffU.fromSpec ≫ g'
    rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
  have hFlat_U : AlgebraicGeometry.Flat (π_U ≫ hAffU.fromSpec ≫ g') := by
    rwa [← hSpec_φR]
  have hLFP_U : AlgebraicGeometry.LocallyOfFinitePresentation (π_U ≫ hAffU.fromSpec ≫ g') := by
    rwa [← hSpec_φR]
  have hNeBot : p_x₀.asIdeal ≠ ⊥ := by
    intro hbot
    have hmem : φ_R PowerSeries.X ∈ p_x₀.asIdeal := hX_mem
    rw [hbot, Ideal.mem_bot] at hmem
    exact hX_ne hmem
  obtain ⟨Φ_A', hΦ_snd⟩ :=
    h_s1 R_A R_Pm p_x₀.asIdeal I_nod U_tilde M_m π_U p_m
      N_cov V_cov hAffV t_gen hCov_U hGen_U hUniv_U
      3 W_cov hAffW d_gen hCov_M hGen_M hUniv_M
      A' e_U q_m inferInstance inferInstance (hMap_e.trans hMap_q.symm)
  obtain ⟨C'', π, ι_tilde, ι_compl,
      hOpen_tilde, hOpen_compl, hCover'', hπ_tilde, hπ_compl,
      hPre_U, hPre_compl, hIso_compl, _hPb_U,
      hInt'', hProp_π, hSurj_π, hFlat'', hLFP'', hTransferApp⟩ :=
    weil_closed_point_affine_modification_two_open_gluing
      C' U_tilde (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω))) g'
      hInt' hFlat' hLFP' x₀ hx₀_cl U hAffU p_x₀ hp_x₀ hDom_A hNeBot
      π_U hInt_U hProp_U hSurj_U hFlat_U hLFP_U hIso_U
  have hIso_πU_app : ∀ V : (AlgebraicGeometry.Spec R_A).Opens,
      CategoryTheory.IsIso (π_U.app V) :=
    weil_proper_modification_pushforward_iso_of_flat_roof
      R_A R_Pm p_x₀.asIdeal U_tilde M_m π_U p_m hProp_U hProp_M
      N_cov V_cov hAffV hCov_U 3 W_cov hAffW hCov_M
      hIso_U hIso_M_top A' v'₀ e_U q_m inferInstance inferInstance
      (congrArg PrimeSpectrum.asIdeal hev'₀) Φ_A' hΦ_snd
  have hIso_π_app : ∀ W : C'.Opens, CategoryTheory.IsIso (π.app W) :=
    hTransferApp hIso_πU_app
  obtain ⟨ε_A, _hSurj_A, hKer_A, hε_A_σ⟩ :=
    hMkRes R_A p_x₀.asIdeal (φ_R.comp PowerSeries.C) hRes_A
  obtain ⟨ε_Pm, hSurj_Pm, hKer_Pm, hε_Pm_σ⟩ :=
    hMkRes R_Pm I_nod (((Ideal.Quotient.mk J_m).comp MvPolynomial.C).comp PowerSeries.C) hRes_Pm
  obtain ⟨ε_A', _hSurj_A', hKer_A', hε_A'_σ⟩ :=
    hMkRes A' v'₀.asIdeal
      ((AlgebraicGeometry.Spec.preimage e_U).hom.comp (φ_R.comp PowerSeries.C)) hRes_A'
  have hComp₁ : ε_A'.comp (AlgebraicGeometry.Spec.preimage e_U).hom = ε_A := by
    apply RingHom.ext
    intro a
    obtain ⟨c, hc⟩ := hRes_A a
    have ha_A : ε_A a = c := by
      have h0 : ε_A (a - φ_R (PowerSeries.C c)) = 0 := by
        rw [← RingHom.mem_ker, hKer_A]; exact hc
      rw [map_sub, sub_eq_zero] at h0
      exact h0.trans (hε_A_σ c)
    have ha_A' : ε_A' ((AlgebraicGeometry.Spec.preimage e_U).hom a) = c := by
      have hmem : (AlgebraicGeometry.Spec.preimage e_U).hom (a - φ_R (PowerSeries.C c)) ∈
          v'₀.asIdeal := hMap_e ▸ Ideal.mem_map_of_mem _ hc
      have h0 : ε_A' ((AlgebraicGeometry.Spec.preimage e_U).hom (a - φ_R (PowerSeries.C c))) = 0 := by
        rw [← RingHom.mem_ker, hKer_A']; exact hmem
      rw [map_sub, map_sub, sub_eq_zero] at h0
      exact h0.trans (hε_A'_σ c)
    exact ha_A'.trans ha_A.symm
  have hComm_ring :
      (AlgebraicGeometry.Spec.preimage e_U).hom.comp φ_R =
        (AlgebraicGeometry.Spec.preimage q_m).hom.comp
          ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) := by
    have hpre := congrArg AlgebraicGeometry.Spec.preimage hComm_eq
    rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
      AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
    exact congrArg CommRingCat.Hom.hom hpre
  have hComp₂ : ε_A'.comp (AlgebraicGeometry.Spec.preimage q_m).hom = ε_Pm := by
    apply RingHom.ext
    intro f
    obtain ⟨c, hc⟩ := hRes_Pm f
    have hf_Pm : ε_Pm f = c := by
      have h0 : ε_Pm (f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c))) = 0 := by
        rw [← RingHom.mem_ker, hKer_Pm]; exact hc
      rw [map_sub, sub_eq_zero] at h0
      exact h0.trans (hε_Pm_σ c)
    have hf_A' : ε_A' ((AlgebraicGeometry.Spec.preimage q_m).hom f) = c := by
      have hmem : (AlgebraicGeometry.Spec.preimage q_m).hom
          (f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c))) ∈ v'₀.asIdeal :=
        hMap_q ▸ Ideal.mem_map_of_mem _ hc
      have h0 : ε_A' ((AlgebraicGeometry.Spec.preimage q_m).hom
          (f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c)))) = 0 := by
        rw [← RingHom.mem_ker, hKer_A']; exact hmem
      rw [map_sub, map_sub, sub_eq_zero] at h0
      have hC_eq : (AlgebraicGeometry.Spec.preimage q_m).hom
          (Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c))) =
          (AlgebraicGeometry.Spec.preimage e_U).hom (φ_R (PowerSeries.C c)) :=
        (RingHom.congr_fun hComm_ring (PowerSeries.C c)).symm
      rw [hC_eq] at h0
      exact h0.trans (hε_A'_σ c)
    exact hf_A'.trans hf_Pm.symm
  let p_nod : AlgebraicGeometry.Spec R_Pm := q_m.base v'₀
  have hKer_Pm' : RingHom.ker ε_Pm = p_nod.asIdeal := hKer_Pm.trans hqv'₀.symm
  have hConn_px₀ : _root_.IsConnected (π_U.base ⁻¹' {p_x₀}) :=
    h_s4 R_A R_Pm p_x₀ p_nod U_tilde M_m π_U p_m A' e_U q_m Φ_A' hΦ_snd
      ε_A ε_Pm ε_A' hSurj_Pm hKer_A hKer_Pm' hComp₁ hComp₂ (hConn_M p_nod)
  let U_compl : C'.Opens := ⟨({x₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩
  have hConn_π : ∀ y : C', _root_.IsConnected (π.base ⁻¹' {y}) := by
    intro y
    by_cases hy : y = x₀
    · rw [hy]
      have hFib_x₀ : π.base ⁻¹' {x₀} = ι_tilde.base '' (π_U.base ⁻¹' {p_x₀}) := by
        ext z
        simp only [Set.mem_preimage, Set.mem_image]
        constructor
        · intro hz
          have hz' : π.base z = x₀ := hz
          have hx₀_U : x₀ ∈ (U : Set C') := by
            rw [← hp_x₀, ← hAffU.range_fromSpec]
            exact ⟨p_x₀, rfl⟩
          have hz_U : z ∈ π.base ⁻¹' (U : Set C') := by
            change π.base z ∈ (U : Set C')
            rwa [hz']
          rw [hPre_U] at hz_U
          obtain ⟨u, rfl⟩ := hz_U
          refine ⟨u, ?_, rfl⟩
          apply hAffU.fromSpec.isOpenEmbedding.injective
          calc hAffU.fromSpec.base (π_U.base u)
              = (π_U ≫ hAffU.fromSpec).base u := rfl
            _ = (ι_tilde ≫ π).base u := by rw [← hπ_tilde]
            _ = x₀ := hz'
            _ = hAffU.fromSpec.base p_x₀ := hp_x₀.symm
        · rintro ⟨u, hu, rfl⟩
          have hu' : π_U.base u = p_x₀ := hu
          show π.base (ι_tilde.base u) = x₀
          calc π.base (ι_tilde.base u)
              = (ι_tilde ≫ π).base u := rfl
            _ = (π_U ≫ hAffU.fromSpec).base u := by rw [hπ_tilde]
            _ = hAffU.fromSpec.base (π_U.base u) := rfl
            _ = hAffU.fromSpec.base p_x₀ := by rw [hu']
            _ = x₀ := hp_x₀
      rw [hFib_x₀]
      exact hConn_px₀.image ι_tilde.base ι_tilde.continuous.continuousOn
    · have hy_compl : y ∈ (U_compl : Set C') := hy
      have hFib_y : π.base ⁻¹' {y} = {ι_compl.base ⟨y, hy_compl⟩} := by
        ext z
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hz
          have hz_compl : z ∈ π.base ⁻¹' (U_compl : Set C') := by
            change π.base z ∈ (U_compl : Set C')
            rwa [hz]
          rw [hPre_compl] at hz_compl
          obtain ⟨w, rfl⟩ := hz_compl
          congr 1
          apply U_compl.ι.isOpenEmbedding.injective
          calc U_compl.ι.base w
              = (ι_compl ≫ π).base w := by rw [← hπ_compl]
            _ = y := hz
            _ = U_compl.ι.base ⟨y, hy_compl⟩ := rfl
        · rintro rfl
          calc π.base (ι_compl.base ⟨y, hy_compl⟩)
              = (ι_compl ≫ π).base ⟨y, hy_compl⟩ := rfl
            _ = U_compl.ι.base ⟨y, hy_compl⟩ := by rw [hπ_compl]
            _ = y := rfl
      rw [hFib_y]
      exact isConnected_singleton
  exact ⟨C'', π, ι_tilde, ι_compl, Φ_A',
    hOpen_tilde, hOpen_compl, hCover'', hπ_tilde, hπ_compl,
    hPre_U, hPre_compl, hIso_compl, hΦ_snd,
    hInt'', hProp_π, hSurj_π, hFlat'', hLFP'', hIso_π_app, hConn_π⟩

theorem weil_powerSeries_blowup_nodal_roof_transfer_and_weight_drop (Ω : Type u) [Field Ω]
    [IsAlgClosed Ω]
    (C' C'' U_tilde M_m : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (r : ℕ) (pts : Fin r → C') (mults : Fin r → ℕ)
    (hInj_pts : Function.Injective pts)
    (hMults : ∀ i : Fin r, 2 ≤ mults i ∧ HasPowerSeriesNodalRoofAt Ω g' (pts i) (mults i))
    (hRem' : ∀ z : C', z ∉ Set.range pts →
      (∃ V : C'.Opens, z ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g')) ∨
      HasPowerSeriesNodalRoofAt Ω g' z 1)
    (i₀ : Fin r)
    (hx₀_cl : IsClosed ({pts i₀} : Set C'))
    (U : C'.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
    (p_x₀ : PrimeSpectrum ↑(C'.presheaf.obj (Opposite.op U)))
    [p_x₀.asIdeal.IsMaximal]
    (hp_x₀ : hAffU.fromSpec.base p_x₀ = pts i₀)
    (hRes_A : ∀ a : ↑(C'.presheaf.obj (Opposite.op U)), ∃ c : Ω,
      a - (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom (PowerSeries.C c) ∈
        p_x₀.asIdeal)
    (π_U : U_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))))
    (hMax_Inod :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      (Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}).IsMaximal)
    (hRes_Pm :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      let I_nod := Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
      ∀ f : MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m, ∃ c : Ω,
        f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c)) ∈ I_nod)
    (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))))
    (hLoc : IsLocalPowerSeriesNodeBlowupModel Ω (mults i₀) p_m)
    (A' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec A')
    [v'₀.asIdeal.IsMaximal]
    (e_U : AlgebraicGeometry.Spec A' ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))))
    (q_m : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))))
    (hEt_e : AlgebraicGeometry.Etale e_U)
    (hEt_q : AlgebraicGeometry.Etale q_m)
    (hComm_eq :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      e_U ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom) =
        q_m ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C)))
    (hev'₀ : e_U.base v'₀ = p_x₀)
    (hqv'₀ :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      (q_m.base v'₀).asIdeal = Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))})
    (hUniq_e : ∀ w : AlgebraicGeometry.Spec A', e_U.base w = p_x₀ → w = v'₀)
    (hUniq_q :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      let I_nod := Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
      ∀ w : AlgebraicGeometry.Spec A',
        q_m.base w ∈ PrimeSpectrum.zeroLocus (I_nod : Set _) → w = v'₀)
    (hRes_A' : ∀ b : ↑A', ∃ c : Ω,
      b - (AlgebraicGeometry.Spec.preimage e_U).hom
        ((AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom (PowerSeries.C c)) ∈
        v'₀.asIdeal)
    (π : C'' ⟶ C')
    (ι_tilde : U_tilde ⟶ C'')
    (ι_compl : AlgebraicGeometry.Scheme.Opens.toScheme
      (⟨({pts i₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩ : C'.Opens) ⟶ C'')
    (Φ_A' : CategoryTheory.Limits.pullback π_U e_U ≅
      CategoryTheory.Limits.pullback p_m q_m)
    (hOpen_tilde : AlgebraicGeometry.IsOpenImmersion ι_tilde)
    (hOpen_compl : AlgebraicGeometry.IsOpenImmersion ι_compl)
    (hπ_tilde : ι_tilde ≫ π = π_U ≫ hAffU.fromSpec)
    (hπ_compl : ι_compl ≫ π =
      AlgebraicGeometry.Scheme.Opens.ι (⟨({pts i₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩ : C'.Opens))
    (hPre_U : π.base ⁻¹' (U : Set C') = Set.range ι_tilde.base)
    (hPre_compl : π.base ⁻¹' ((⟨({pts i₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩ : C'.Opens) : Set C') =
      Set.range ι_compl.base)
    (hΦ_snd : Φ_A'.hom ≫ CategoryTheory.Limits.pullback.snd p_m q_m =
      CategoryTheory.Limits.pullback.snd π_U e_U)
    (hFlat'' : AlgebraicGeometry.Flat (π ≫ g'))
    (hLFP'' : AlgebraicGeometry.LocallyOfFinitePresentation (π ≫ g')) :
    ∃ (r'' : ℕ) (pts'' : Fin r'' → C'') (mults'' : Fin r'' → ℕ),
      Function.Injective pts'' ∧
      (∀ i : Fin r'', 2 ≤ mults'' i ∧ HasPowerSeriesNodalRoofAt Ω (π ≫ g') (pts'' i) (mults'' i)) ∧
      (∀ z : C'', z ∉ Set.range pts'' →
        (∃ V : C''.Opens, z ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ π ≫ g')) ∨
        HasPowerSeriesNodalRoofAt Ω (π ≫ g') z 1) ∧
      (∑ i : Fin r'', mults'' i / 2) < (∑ i : Fin r, mults i / 2) :=
by
  
  have hAlgSm : ∀ (A B : Type u) [CommRing A] [CommRing B]
      (φ_A : PowerSeries Ω →+* A) (ψ : A →+* B),
      φ_A.FinitePresentation → ψ.Etale →
      (ψ.comp φ_A).IsStandardSmoothOfRelativeDimension 1 →
      ∀ q : PrimeSpectrum B, ∃ s : A, s ∉ Ideal.comap ψ q.asIdeal ∧
        ((algebraMap A (Localization.Away s)).comp φ_A).IsStandardSmoothOfRelativeDimension 1 := by
    intro A B _ _ φ_A ψ hFP_A hEt_ψ hSm_B q
    let R := PowerSeries Ω
    letI : Algebra R A := φ_A.toAlgebra
    letI : Algebra R B := (ψ.comp φ_A).toAlgebra
    letI : Algebra A B := ψ.toAlgebra
    have : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.FinitePresentation R A := hFP_A
    have : Algebra.Etale A B := hEt_ψ
    have : Algebra.IsStandardSmoothOfRelativeDimension 1 R B := hSm_B
    let p : Ideal A := Ideal.comap ψ q.asIdeal
    have : p.IsPrime := q.isPrime.comap ψ
    let K : Type u := q.asIdeal.ResidueField
    have : Algebra.IsStandardSmooth R B :=
      RingHom.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1 (ψ.comp φ_A) hSm_B
    have : Algebra.FormallySmooth R B := inferInstance
    have : Module.Free B Ω[B⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have : Nontrivial B := ⟨⟨0, 1, fun h01 =>
      q.isPrime.ne_top (q.asIdeal.eq_top_iff_one.mpr (h01 ▸ q.asIdeal.zero_mem))⟩⟩
    have hRankB : Module.rank B Ω[B⁄R] = (1 : Cardinal.{u}) := by
      have hr :=
        (Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth (R := R) (S := B) 1).mp
          inferInstance
      simpa using hr
    have hRankKB : Module.rank K (TensorProduct B K Ω[B⁄R]) = (1 : Cardinal.{u}) := by
      rw [Module.rank_baseChange, hRankB, Cardinal.lift_one]
    have : Algebra.FormallyEtale A B := inferInstance
    let e_Ω_AB : TensorProduct A B Ω[A⁄R] ≃ₗ[B] Ω[B⁄R] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R A B
    let e_Ω_AK : TensorProduct A K Ω[A⁄R] ≃ₗ[K] TensorProduct B K Ω[B⁄R] :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange A B K K Ω[A⁄R]).symm.trans
        (e_Ω_AB.baseChange B K (TensorProduct A B Ω[A⁄R]) Ω[B⁄R])
    have hRankKA : Module.rank K (TensorProduct A K Ω[A⁄R]) = (1 : Cardinal.{u}) := by
      rw [e_Ω_AK.rank_eq, hRankKB]
    let A_p : Type u := Localization.AtPrime p
    let B_q : Type u := Localization.AtPrime q.asIdeal
    let ψ_loc : A_p →+* B_q := Localization.localRingHom p q.asIdeal ψ rfl
    let _ : Algebra A_p B_q := ψ_loc.toAlgebra
    have : IsScalarTower A A_p B_q := IsScalarTower.of_algebraMap_eq fun a =>
      (Localization.localRingHom_to_map p q.asIdeal ψ rfl a).symm
    have : IsScalarTower R A_p B_q := IsScalarTower.of_algebraMap_eq fun r => by
      rw [IsScalarTower.algebraMap_apply R A B_q, IsScalarTower.algebraMap_apply A A_p B_q,
        ← IsScalarTower.algebraMap_apply R A A_p]
    have hFlat_ψ : ψ.Flat := by
      change Module.Flat A B
      infer_instance
    have : Module.Flat A_p B_q := RingHom.Flat.localRingHom hFlat_ψ q.asIdeal p rfl
    have : IsLocalHom (algebraMap A_p B_q) := Localization.isLocalHom_localRingHom p q.asIdeal ψ rfl
    have : Module.FaithfullyFlat A_p B_q := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have : Algebra.FormallyEtale B B_q := Algebra.FormallyEtale.of_isLocalization q.asIdeal.primeCompl
    have : Algebra.FormallyEtale A B_q := Algebra.FormallyEtale.comp A B B_q
    have : Algebra.FormallyEtale A_p B_q := Algebra.FormallyEtale.localization_base p.primeCompl
    have : Algebra.FormallySmooth B B_q := inferInstance
    have : Algebra.FormallySmooth R B_q := Algebra.FormallySmooth.comp R B B_q
    have : Module.Projective B_q Ω[B_q⁄R] := ((Algebra.formallySmooth_iff R B_q).mp inferInstance).1
    have : Module.Flat B_q Ω[B_q⁄R] := inferInstance
    let e_Ω_loc : TensorProduct A_p B_q Ω[A_p⁄R] ≃ₗ[B_q] Ω[B_q⁄R] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R A_p B_q
    have : Module.Flat B_q (TensorProduct A_p B_q Ω[A_p⁄R]) :=
      Module.Flat.of_linearEquiv e_Ω_loc
    have : Module.Flat A_p Ω[A_p⁄R] :=
      Module.Flat.of_flat_tensorProduct A_p Ω[A_p⁄R] B_q
    have : Module.FinitePresentation A Ω[A⁄R] := inferInstance
    have : Algebra.FormallyEtale A A_p := Algebra.FormallyEtale.of_isLocalization p.primeCompl
    let e_Ω_Ap : TensorProduct A A_p Ω[A⁄R] ≃ₗ[A_p] Ω[A_p⁄R] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R A A_p
    have : Module.FinitePresentation A_p Ω[A_p⁄R] :=
      Module.FinitePresentation.of_equiv e_Ω_Ap
    have : Module.Projective A_p Ω[A_p⁄R] := Module.Flat.projective_of_finitePresentation
    let P_gen : Algebra.Generators R A A := Algebra.Generators.self R A
    let P_ext : Algebra.Extension R A := P_gen.toExtension
    let P₀ : Type u := P_ext.Ring
    have hSurj_P₀ : Function.Surjective (algebraMap P₀ A) := P_ext.algebraMap_surjective
    have : Algebra.FormallySmooth R P₀ := by
      change Algebra.FormallySmooth R (MvPolynomial A R)
      infer_instance
    have hDim0_AB : Algebra.IsStandardSmoothOfRelativeDimension 0 A B :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    obtain ⟨ι', σ', hFin_σ', hFin_ι', Q_pres, hDim_Q⟩ := hDim0_AB.out
    have hSurj_map : Function.Surjective (MvPolynomial.map (algebraMap P₀ A) :
        MvPolynomial ι' P₀ →+* MvPolynomial ι' A) :=
      MvPolynomial.map_surjective (algebraMap P₀ A) hSurj_P₀
    choose r_tilde hr_tilde using fun k : σ' => hSurj_map (Q_pres.relation k)
    let J_tilde : Ideal (MvPolynomial ι' P₀) := Ideal.span (Set.range r_tilde)
    let R₀ : Type u := MvPolynomial ι' P₀ ⧸ J_tilde
    let val_R₀ : ι' → R₀ := fun i => Ideal.Quotient.mk J_tilde (MvPolynomial.X i)
    have haeval_R₀ : (MvPolynomial.aeval val_R₀ : MvPolynomial ι' P₀ →ₐ[P₀] R₀) =
        Ideal.Quotient.mkₐ P₀ J_tilde := by
      ext i
      simp only [MvPolynomial.aeval_X, val_R₀]
      rfl
    have hSurj_aeval_R₀ : Function.Surjective (MvPolynomial.aeval (R := P₀) val_R₀) := by
      rw [haeval_R₀]
      exact Ideal.Quotient.mk_surjective
    let G_R₀ : Algebra.Generators P₀ R₀ ι' := Algebra.Generators.ofSurjective val_R₀ hSurj_aeval_R₀
    have hKer_G_R₀ : Ideal.span (Set.range r_tilde) = G_R₀.ker := by
      change J_tilde = RingHom.ker (algebraMap G_R₀.Ring R₀)
      have halg_G : algebraMap G_R₀.Ring R₀ = (MvPolynomial.aeval val_R₀).toRingHom := rfl
      rw [halg_G, haeval_R₀]
      exact (Ideal.mk_ker).symm
    let Pres_R₀ : Algebra.Presentation P₀ R₀ ι' σ' :=
      Algebra.Presentation.mk G_R₀ r_tilde hKer_G_R₀
    let P₁ : Algebra.PreSubmersivePresentation P₀ R₀ ι' σ' :=
      Algebra.PreSubmersivePresentation.mk Pres_R₀ Q_pres.map Q_pres.map_inj
    let Φ_poly : MvPolynomial ι' P₀ →+* B :=
      (algebraMap Q_pres.Ring B).comp (MvPolynomial.map (algebraMap P₀ A))
    have hJ_le_ker : J_tilde ≤ RingHom.ker Φ_poly := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker, Φ_poly, RingHom.comp_apply, hr_tilde]
      have hmem : Q_pres.relation k ∈ Q_pres.ker := by
        rw [← Q_pres.span_range_relation_eq_ker]
        exact Ideal.subset_span ⟨k, rfl⟩
      exact hmem
    let π_R₀ : R₀ →+* B := Ideal.Quotient.lift J_tilde Φ_poly hJ_le_ker
    have hπ_R₀_P₀ : π_R₀.comp (algebraMap P₀ R₀) = ψ.comp (algebraMap P₀ A) := by
      ext x
      change Φ_poly (MvPolynomial.C x) = ψ (algebraMap P₀ A x)
      simp only [Φ_poly, RingHom.comp_apply, MvPolynomial.map_C]
      exact (IsScalarTower.algebraMap_apply A Q_pres.Ring B (algebraMap P₀ A x)).symm
    have hSurj_π_R₀ : Function.Surjective π_R₀ := by
      intro b
      obtain ⟨fA, rfl⟩ := Q_pres.algebraMap_surjective b
      obtain ⟨fP, rfl⟩ := hSurj_map fA
      exact ⟨Ideal.Quotient.mk J_tilde fP, rfl⟩
    have hKer_π_R₀ : RingHom.ker π_R₀ = Ideal.map (algebraMap P₀ R₀) P_ext.ker := by
      ext x
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [RingHom.mem_ker]
      change Φ_poly F = 0 ↔ Ideal.Quotient.mk J_tilde F ∈ Ideal.map (algebraMap P₀ R₀) P_ext.ker
      constructor
      · intro hF
        have hF_ker : MvPolynomial.map (algebraMap P₀ A) F ∈ Q_pres.ker := hF
        rw [← Q_pres.span_range_relation_eq_ker] at hF_ker
        have hSpanEq : Ideal.span (Set.range Q_pres.relation) =
            Ideal.map (MvPolynomial.map (algebraMap P₀ A)) J_tilde := by
          dsimp [J_tilde]
          rw [Ideal.map_span]
          congr 1
          ext f
          simp only [Set.mem_range, Set.mem_image]
          constructor
          · rintro ⟨k, rfl⟩
            exact ⟨r_tilde k, ⟨k, rfl⟩, hr_tilde k⟩
          · rintro ⟨_, ⟨k, rfl⟩, rfl⟩
            exact ⟨k, (hr_tilde k).symm⟩
        rw [hSpanEq] at hF_ker
        obtain ⟨G, hG_J, hFG_eq⟩ :=
          (Ideal.mem_map_iff_of_surjective _ hSurj_map).mp hF_ker
        have hSub_ker : F - G ∈ RingHom.ker (MvPolynomial.map (algebraMap P₀ A)) := by
          rw [RingHom.mem_ker, map_sub, hFG_eq, sub_self]
        rw [MvPolynomial.ker_map] at hSub_ker
        have hSub_img : Ideal.Quotient.mk J_tilde (F - G) ∈
            Ideal.map ((Ideal.Quotient.mk J_tilde).comp MvPolynomial.C) P_ext.ker := by
          rw [← Ideal.map_map]
          exact Ideal.mem_map_of_mem _ hSub_ker
        have hG_zero : Ideal.Quotient.mk J_tilde G = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hG_J
        rw [map_sub, hG_zero, sub_zero] at hSub_img
        exact hSub_img
      · intro hx_mem
        have hle : Ideal.map (algebraMap P₀ R₀) P_ext.ker ≤ RingHom.ker π_R₀ := by
          rw [Ideal.map_le_iff_le_comap]
          intro p₀ hp₀
          rw [Ideal.mem_comap, RingHom.mem_ker]
          change (π_R₀.comp (algebraMap P₀ R₀)) p₀ = 0
          rw [hπ_R₀_P₀, RingHom.comp_apply]
          have hp₀_zero : algebraMap P₀ A p₀ = 0 := hp₀
          rw [hp₀_zero, map_zero]
        exact hle hx_mem
    have hJac_eq : π_R₀ P₁.jacobian = Q_pres.jacobian := by
      classical
      let _ : Fintype σ' := Fintype.ofFinite σ'
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
        Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      have h_alg_P₁ : algebraMap P₁.Ring R₀ P₁.jacobiMatrix.det =
          Ideal.Quotient.mk J_tilde P₁.jacobiMatrix.det := by
        change (MvPolynomial.aeval (R := P₀) val_R₀) P₁.jacobiMatrix.det = _
        rw [haeval_R₀]
        rfl
      rw [h_alg_P₁]
      change Φ_poly P₁.jacobiMatrix.det =
        algebraMap Q_pres.Ring B Q_pres.toPreSubmersivePresentation.jacobiMatrix.det
      dsimp [Φ_poly]
      congr 1
      rw [RingHom.map_det]
      congr 1
      ext i j : 2
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      dsimp [P₁, Pres_R₀]
      rw [← hr_tilde j, MvPolynomial.pderiv_map]
    have hJac_unit_B : IsUnit (π_R₀ P₁.jacobian) := by
      rw [hJac_eq]
      exact Q_pres.jacobian_isUnit
    let Q₀ : Type u := Localization.Away P₁.jacobian
    let Sub_loc : Algebra.SubmersivePresentation R₀ Q₀ Unit Unit :=
      Algebra.SubmersivePresentation.localizationAway Q₀ P₁.jacobian
    let P_comp : Algebra.PreSubmersivePresentation P₀ Q₀ (Unit ⊕ ι') (Unit ⊕ σ') :=
      Sub_loc.toPreSubmersivePresentation.comp P₁
    have hUnit_comp : IsUnit P_comp.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.smul_def]
      exact (IsLocalization.Away.algebraMap_isUnit P₁.jacobian).mul Sub_loc.jacobian_isUnit
    let Sub_Q₀ : Algebra.SubmersivePresentation P₀ Q₀ (Unit ⊕ ι') (Unit ⊕ σ') :=
      Algebra.SubmersivePresentation.mk P_comp hUnit_comp
    have hDim_Sub_Q₀ : Sub_Q₀.dimension = 0 := by
      change P_comp.dimension = 0
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension]
      have h1 : Sub_loc.toPreSubmersivePresentation.dimension = 0 :=
        Algebra.Presentation.localizationAway_dimension_zero P₁.jacobian
      have h2 : P₁.dimension = Q_pres.dimension := rfl
      rw [h1, h2, hDim_Q]
    have hSm0_P₀Q₀ : Algebra.IsStandardSmoothOfRelativeDimension 0 P₀ Q₀ :=
      ⟨Unit ⊕ ι', Unit ⊕ σ', inferInstance, inferInstance, Sub_Q₀, hDim_Sub_Q₀⟩
    have : Algebra.Etale P₀ Q₀ :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hSm0_P₀Q₀
    have : Module.Flat P₀ Q₀ := inferInstance
    have : Algebra.FormallySmooth P₀ Q₀ := inferInstance
    have : Algebra.FormallySmooth R Q₀ := Algebra.FormallySmooth.comp R P₀ Q₀
    let π_Q : Q₀ →+* B := IsLocalization.Away.lift P₁.jacobian hJac_unit_B
    have hπ_Q_R₀ : π_Q.comp (algebraMap R₀ Q₀) = π_R₀ :=
      RingHom.ext (IsLocalization.Away.lift_eq P₁.jacobian hJac_unit_B)
    have hπ_Q_P₀ : π_Q.comp (algebraMap P₀ Q₀) = ψ.comp (algebraMap P₀ A) := by
      have h_tower : algebraMap P₀ Q₀ = (algebraMap R₀ Q₀).comp (algebraMap P₀ R₀) := rfl
      rw [h_tower, ← RingHom.comp_assoc, hπ_Q_R₀, hπ_R₀_P₀]
    have hSurj_π_Q : Function.Surjective π_Q := by
      intro b
      obtain ⟨r₀, rfl⟩ := hSurj_π_R₀ b
      exact ⟨algebraMap R₀ Q₀ r₀, IsLocalization.Away.lift_eq P₁.jacobian hJac_unit_B r₀⟩
    letI : Algebra Q₀ B := π_Q.toAlgebra
    have : IsScalarTower R Q₀ B := IsScalarTower.of_algebraMap_eq fun r => by
      symm
      change π_Q (algebraMap R Q₀ r) = algebraMap R B r
      rw [IsScalarTower.algebraMap_apply R P₀ Q₀]
      change (π_Q.comp (algebraMap P₀ Q₀)) (algebraMap R P₀ r) = algebraMap R B r
      rw [hπ_Q_P₀, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply R P₀ A]
      rfl
    let Q_ext : Algebra.Extension R B :=
      Algebra.Extension.mk Q₀ (Function.surjInv hSurj_π_Q) (Function.surjInv_eq hSurj_π_Q)
    have hKer_Q_ext : Q_ext.ker = Ideal.map (algebraMap P₀ Q₀) P_ext.ker := by
      change RingHom.ker π_Q = Ideal.map (algebraMap P₀ Q₀) P_ext.ker
      have h_alg_comp : algebraMap P₀ Q₀ = (algebraMap R₀ Q₀).comp (algebraMap P₀ R₀) := rfl
      have h_map_comp : Ideal.map (algebraMap P₀ Q₀) P_ext.ker =
          Ideal.map (algebraMap R₀ Q₀) (Ideal.map (algebraMap P₀ R₀) P_ext.ker) := by
        rw [h_alg_comp, ← Ideal.map_map]
      rw [h_map_comp, ← hKer_π_R₀]
      ext q₀
      constructor
      · intro hq₀
        obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj (Submonoid.powers P₁.jacobian) q₀
        have hy_ker : y ∈ RingHom.ker π_R₀ := by
          rw [RingHom.mem_ker, ← RingHom.congr_fun hπ_Q_R₀ y]
          change π_Q (algebraMap R₀ Q₀ y) = 0
          rw [← hys, map_mul, RingHom.mem_ker.mp hq₀, zero_mul]
        have hs_unit_Q₀ : IsUnit (algebraMap R₀ Q₀ s) :=
          IsLocalization.map_units Q₀ s
        obtain ⟨u_inv, hu_inv⟩ := hs_unit_Q₀.exists_right_inv
        have hq₀_eq : q₀ = u_inv * algebraMap R₀ Q₀ y := by
          calc q₀ = q₀ * (algebraMap R₀ Q₀ s * u_inv) := by rw [hu_inv, mul_one]
            _ = u_inv * (q₀ * algebraMap R₀ Q₀ s) := by ring
            _ = u_inv * algebraMap R₀ Q₀ y := by rw [hys]
        rw [hq₀_eq]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hy_ker)
      · intro hq₀
        have hle : Ideal.map (algebraMap R₀ Q₀) (RingHom.ker π_R₀) ≤ RingHom.ker π_Q := by
          rw [Ideal.map_le_iff_le_comap]
          intro r₀ hr₀
          rw [Ideal.mem_comap, RingHom.mem_ker, IsLocalization.Away.lift_eq]
          exact hr₀
        exact hle hq₀
    let f_ext : P_ext.Hom Q_ext :=
      Algebra.Extension.Hom.mk (algebraMap P₀ Q₀)
        (fun r => by
          rw [Algebra.algebraMap_self, RingHom.id_apply]
          exact (IsScalarTower.algebraMap_apply R P₀ Q₀ r).symm)
        (fun x => by
          change π_Q (algebraMap P₀ Q₀ x) = ψ (algebraMap P₀ A x)
          exact RingHom.congr_fun hπ_Q_P₀ x)
    have hBij_ker : Function.Bijective (LinearMap.liftBaseChange Q₀ (f_ext.mapKer rfl)) := by
      let m_ker := LinearMap.liftBaseChange Q₀ (f_ext.mapKer rfl)
      let incl_P : P_ext.ker →ₗ[P₀] P₀ := P_ext.ker.subtype
      let incl_Q : Q_ext.ker →ₗ[Q₀] Q₀ := Q_ext.ker.subtype
      have h_comp_eq : (incl_Q.comp m_ker).restrictScalars P₀ =
          ((TensorProduct.AlgebraTensorModule.rid P₀ Q₀ Q₀).toLinearMap.restrictScalars P₀).comp
            (LinearMap.lTensor Q₀ incl_P) := by
        apply TensorProduct.ext'
        intro q₀ x
        simp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars, Function.comp_apply,
          LinearMap.lTensor_tmul, LinearEquiv.coe_coe, TensorProduct.AlgebraTensorModule.rid_tmul]
        change q₀ * algebraMap P₀ Q₀ x.1 = x.1 • q₀
        rw [Algebra.smul_def, mul_comm]
      refine ⟨?_, ?_⟩
      · have hinj_lTensor : Function.Injective (LinearMap.lTensor Q₀ incl_P) :=
          Module.Flat.lTensor_preserves_injective_linearMap incl_P Subtype.val_injective
        have hinj_comp : Function.Injective ((incl_Q.comp m_ker).restrictScalars P₀) := by
          rw [h_comp_eq]
          exact (TensorProduct.AlgebraTensorModule.rid P₀ Q₀ Q₀).injective.comp hinj_lTensor
        exact Function.Injective.of_comp (f := incl_Q) hinj_comp
      · intro y
        have hy_mem : y.1 ∈ Ideal.map (algebraMap P₀ Q₀) P_ext.ker := by
          rw [← hKer_Q_ext]
          exact y.2
        have h_le_range : Ideal.map (algebraMap P₀ Q₀) P_ext.ker ≤
            LinearMap.range (incl_Q.comp m_ker) := by
          rw [Ideal.map_le_iff_le_comap]
          intro p₀ hp₀
          refine ⟨(1 : Q₀) ⊗ₜ[P₀] ⟨p₀, hp₀⟩, ?_⟩
          change incl_Q (LinearMap.liftBaseChange Q₀ (f_ext.mapKer rfl)
            ((1 : Q₀) ⊗ₜ[P_ext.Ring] ⟨p₀, hp₀⟩)) = algebraMap P₀ Q₀ p₀
          rw [LinearMap.liftBaseChange_tmul, one_smul]
          rfl
        obtain ⟨z, hz⟩ := h_le_range hy_mem
        exact ⟨z, Subtype.ext hz⟩
    let e_cot : TensorProduct A B P_ext.Cotangent ≃ₗ[B] Q_ext.Cotangent :=
      Algebra.Extension.tensorCotangent f_ext rfl hBij_ker
    have he_cot_eq : e_cot.toLinearMap =
        LinearMap.liftBaseChange B (Algebra.Extension.Cotangent.map f_ext) := by
      apply LinearMap.restrictScalars_injective A
      apply TensorProduct.ext'
      intro b x
      obtain ⟨p₀, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective x
      simp [e_cot, Algebra.Extension.tensorCotangent]
    have hInj_Q_cc : Function.Injective Q_ext.cotangentComplex := by
      have : Algebra.FormallySmooth R Q_ext.Ring := ‹Algebra.FormallySmooth R Q₀›
      exact (Algebra.Extension.cotangentComplex_injective_iff Q_ext).mpr
        Algebra.FormallySmooth.subsingleton_h1Cotangent
    have hComm_cc : (LinearMap.liftBaseChange B (Algebra.Extension.CotangentSpace.map f_ext)).comp
        (LinearMap.baseChange B P_ext.cotangentComplex) =
        Q_ext.cotangentComplex.comp
          (LinearMap.liftBaseChange B (Algebra.Extension.Cotangent.map f_ext)) := by
      apply LinearMap.restrictScalars_injective A
      apply TensorProduct.ext'
      intro b x
      simp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars, Function.comp_apply,
        LinearMap.baseChange_tmul, LinearMap.liftBaseChange_tmul, map_smul,
        Algebra.Extension.CotangentSpace.map_cotangentComplex]
    have hInj_bc_P : Function.Injective (LinearMap.baseChange B P_ext.cotangentComplex) := by
      have hInj_rhs : Function.Injective
          (Q_ext.cotangentComplex.comp
            (LinearMap.liftBaseChange B (Algebra.Extension.Cotangent.map f_ext))) := by
        rw [← he_cot_eq]
        exact hInj_Q_cc.comp e_cot.injective
      rw [← hComm_cc] at hInj_rhs
      exact Function.Injective.of_comp hInj_rhs
    have : Module.Flat A B := inferInstance
    have hSub_BP : Subsingleton (TensorProduct A B P_ext.H1Cotangent) := by
      let ι_H1 : P_ext.H1Cotangent →ₗ[A] P_ext.Cotangent :=
        (LinearMap.ker P_ext.cotangentComplex).subtype
      have hInj_lT : Function.Injective (LinearMap.lTensor B ι_H1) :=
        Module.Flat.lTensor_preserves_injective_linearMap ι_H1 Subtype.val_injective
      have hComp_zero : (LinearMap.lTensor B P_ext.cotangentComplex).comp
          (LinearMap.lTensor B ι_H1) = 0 := by
        rw [← LinearMap.lTensor_comp]
        have h0 : P_ext.cotangentComplex.comp ι_H1 = 0 := by
          ext x
          exact x.2
        rw [h0, LinearMap.lTensor_zero]
      have hEq_bc_lT : (LinearMap.baseChange B P_ext.cotangentComplex).restrictScalars A =
          LinearMap.lTensor B P_ext.cotangentComplex := by
        apply TensorProduct.ext'
        intro _ _
        rfl
      refine Subsingleton.intro fun z₁ z₂ => ?_
      apply hInj_lT
      apply hInj_bc_P
      change (LinearMap.baseChange B P_ext.cotangentComplex).restrictScalars A _ =
        (LinearMap.baseChange B P_ext.cotangentComplex).restrictScalars A _
      rw [hEq_bc_lT]
      have hz₁ : LinearMap.lTensor B P_ext.cotangentComplex (LinearMap.lTensor B ι_H1 z₁) = 0 :=
        LinearMap.congr_fun hComp_zero z₁
      have hz₂ : LinearMap.lTensor B P_ext.cotangentComplex (LinearMap.lTensor B ι_H1 z₂) = 0 :=
        LinearMap.congr_fun hComp_zero z₂
      rw [hz₁, hz₂]
    have hSub_BA : Subsingleton (TensorProduct A B (Algebra.H1Cotangent R A)) := hSub_BP
    have hSub_BqB : Subsingleton
        (TensorProduct B B_q (TensorProduct A B (Algebra.H1Cotangent R A))) := by
      have h_zero : ∀ z : TensorProduct B B_q (TensorProduct A B (Algebra.H1Cotangent R A)),
          z = 0 := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rfl
        | tmul bq x => rw [Subsingleton.elim x 0, TensorProduct.tmul_zero]
        | add u v hu hv => rw [hu, hv, add_zero]
      exact Subsingleton.intro fun z₁ z₂ => (h_zero z₁).trans (h_zero z₂).symm
    let e_H1_Bq : TensorProduct B B_q (TensorProduct A B (Algebra.H1Cotangent R A)) ≃ₗ[B_q]
        TensorProduct A_p B_q (Algebra.H1Cotangent R A_p) :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange A B B_q B_q (Algebra.H1Cotangent R A)).trans
