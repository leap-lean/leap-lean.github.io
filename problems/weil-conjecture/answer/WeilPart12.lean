        congr 1
      exact (congrFun (congrArg (fun f => f.hom) h_map) _).symm
    have hCocyc_c : ∀ (ℓ ℓ' : Fin (d + 1)) (r : A),
        (P_A.presheaf.map (homOfLE inf_le_right).op).hom (c_A ℓ' r) =
