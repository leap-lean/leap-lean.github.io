    have hSq : φ_A ≫ φ_AS =
        CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C) ≫ e_NS := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, IsAffineOpen.SpecMap_appLE_fromSpec f hU hV e_UV]
      dsimp [f, e_NS]
      rw [hComm, Spec.map_comp, Spec.map_comp, Spec.map_preimage]
      simp only [Category.assoc]
      congr 3
      rw [← Spec.map_comp]
      congr 1
    have hXP : ∀ i : Fin 2, e_NS.hom (Ideal.Quotient.mk J₀ (MvPolynomial.X i)) ∈ P := by
      intro i
      change (Spec.preimage (hV.fromSpec ≫ p_D ≫ q)).hom
        (ι₀ (Ideal.Quotient.mk J₀ (MvPolynomial.X i))) ∈ P_pt.asIdeal
      have hιX : ι₀ (Ideal.Quotient.mk J₀ (MvPolynomial.X i)) =
          Ideal.Quotient.mk J'₀ (MvPolynomial.X i) := rfl
      rw [hιX]
      change Ideal.Quotient.mk J'₀ (MvPolynomial.X i) ∈
        (PrimeSpectrum.comap (Spec.preimage (hV.fromSpec ≫ p_D ≫ q)).hom P_pt).asIdeal
      have hcomap : PrimeSpectrum.comap (Spec.preimage (hV.fromSpec ≫ p_D ≫ q)).hom P_pt =
          q.base v_gen := by
        change (Spec.map (Spec.preimage (hV.fromSpec ≫ p_D ≫ q))).base P_pt = q.base v_gen
        rw [Spec.map_preimage]
        change q.base (p_D.base (hV.fromSpec.base P_pt)) = q.base v_gen
        have hfrom : hV.fromSpec.base P_pt = u_gen :=
          IsAffineOpen.fromSpec_primeIdealOf hV ⟨u_gen, huV⟩
        rw [hfrom, hu_gen]
      rw [hcomap, hv_gen_q]
      exact hev₀_X i
    exact False.elim (hs2 RStar A S φ_A φ_AS e_NS P P_pt.isPrime hEtA hSmAS hEtNS hSq hXP)
  · let RStar := PowerSeries Ω
    let P₂ := MvPolynomial (Fin 2) RStar
    let J_h : Ideal P₂ := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}
    let m : ℕ := h.order.toNat
    let ε : RStarˣ := h.Unit_of_divided_by_X_pow_order
    have hε_eq : (ε : RStar) = h.divXPowOrder :=
      PowerSeries.Unit_of_divided_by_X_pow_order_nonzero hh0
    have h_fac : (PowerSeries.X : RStar) ^ m * (ε : RStar) = h := by
      rw [hε_eq]
      exact PowerSeries.X_pow_order_mul_divXPowOrder
    have hm1 : 1 ≤ m := by
      by_contra hm0
      have hm_zero : m = 0 := by omega
      have hh_eq : (ε : RStar) = h := by
        simpa [hm_zero] using h_fac
      have hUnit : IsUnit h := hh_eq ▸ ε.isUnit
      exact (IsLocalRing.notMem_maximalIdeal.mpr hUnit) hh
    let J_m : Ideal P₂ := Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ((PowerSeries.X : RStar) ^ m)}
    let f_mh : Fin 2 → P₂ ⧸ J_h :=
      Fin.cases (Ideal.Quotient.mk J_h (MvPolynomial.C (↑ε⁻¹ : RStar) * MvPolynomial.X 0))
        (fun _ => Ideal.Quotient.mk J_h (MvPolynomial.X 1))
    let α_mh : P₂ →+* (P₂ ⧸ J_h) := (MvPolynomial.aeval f_mh).toRingHom
    have hα_mh_C : ∀ r : RStar, α_mh (MvPolynomial.C r) = Ideal.Quotient.mk J_h (MvPolynomial.C r) :=
      fun r => MvPolynomial.aeval_C f_mh r
    have hα_mh_X0 : α_mh (MvPolynomial.X 0) =
        Ideal.Quotient.mk J_h (MvPolynomial.C (↑ε⁻¹ : RStar) * MvPolynomial.X 0) :=
      MvPolynomial.aeval_X f_mh 0
    have hα_mh_X1 : α_mh (MvPolynomial.X 1) = Ideal.Quotient.mk J_h (MvPolynomial.X 1) :=
      MvPolynomial.aeval_X f_mh 1
    have h_inv_h : (↑ε⁻¹ : RStar) * h = (PowerSeries.X : RStar) ^ m := by
      calc (↑ε⁻¹ : RStar) * h
          = (↑ε⁻¹ : RStar) * ((PowerSeries.X : RStar) ^ m * (ε : RStar)) := by rw [h_fac]
        _ = (PowerSeries.X : RStar) ^ m * ((↑ε⁻¹ : RStar) * (ε : RStar)) := by ring
        _ = (PowerSeries.X : RStar) ^ m := by rw [Units.inv_mul, mul_one]
    have h_ker_mh : ∀ u ∈ J_m, α_mh u = 0 := by
      intro u hu
      change u ∈ RingHom.ker α_mh
      refine Ideal.span_le.mpr ?_ hu
      rw [Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      rw [map_sub, map_mul, hα_mh_X0, hα_mh_X1, hα_mh_C, ← map_mul, ← map_sub,
        Ideal.Quotient.eq_zero_iff_mem]
      convert Ideal.mul_mem_left J_h (MvPolynomial.C (↑ε⁻¹ : RStar)) (Ideal.subset_span rfl) using 1
      rw [← h_inv_h, map_mul]
      ring
    let ψ_mh : (P₂ ⧸ J_m) →+* (P₂ ⧸ J_h) := Ideal.Quotient.lift J_m α_mh h_ker_mh
    let f_hm : Fin 2 → P₂ ⧸ J_m :=
      Fin.cases (Ideal.Quotient.mk J_m (MvPolynomial.C (ε : RStar) * MvPolynomial.X 0))
        (fun _ => Ideal.Quotient.mk J_m (MvPolynomial.X 1))
    let α_hm : P₂ →+* (P₂ ⧸ J_m) := (MvPolynomial.aeval f_hm).toRingHom
    have hα_hm_C : ∀ r : RStar, α_hm (MvPolynomial.C r) = Ideal.Quotient.mk J_m (MvPolynomial.C r) :=
      fun r => MvPolynomial.aeval_C f_hm r
    have hα_hm_X0 : α_hm (MvPolynomial.X 0) =
        Ideal.Quotient.mk J_m (MvPolynomial.C (ε : RStar) * MvPolynomial.X 0) :=
      MvPolynomial.aeval_X f_hm 0
    have hα_hm_X1 : α_hm (MvPolynomial.X 1) = Ideal.Quotient.mk J_m (MvPolynomial.X 1) :=
      MvPolynomial.aeval_X f_hm 1
    have h_eps_Xm : (ε : RStar) * (PowerSeries.X : RStar) ^ m = h := by
      rw [mul_comm, h_fac]
    have h_ker_hm : ∀ u ∈ J_h, α_hm u = 0 := by
      intro u hu
      change u ∈ RingHom.ker α_hm
      refine Ideal.span_le.mpr ?_ hu
      rw [Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      rw [map_sub, map_mul, hα_hm_X0, hα_hm_X1, hα_hm_C, ← map_mul, ← map_sub,
        Ideal.Quotient.eq_zero_iff_mem]
      convert Ideal.mul_mem_left J_m (MvPolynomial.C (ε : RStar)) (Ideal.subset_span rfl) using 1
      rw [← h_eps_Xm, map_mul]
      ring
    let ψ_hm : (P₂ ⧸ J_h) →+* (P₂ ⧸ J_m) := Ideal.Quotient.lift J_h α_hm h_ker_hm
    have h_hm_mh : ψ_hm.comp ψ_mh = RingHom.id (P₂ ⧸ J_m) := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        change ψ_hm (α_mh (MvPolynomial.C r)) = Ideal.Quotient.mk J_m (MvPolynomial.C r)
        rw [hα_mh_C]
        exact hα_hm_C r
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · change ψ_hm (α_mh (MvPolynomial.X 0)) = Ideal.Quotient.mk J_m (MvPolynomial.X 0)
          rw [hα_mh_X0]
          change α_hm (MvPolynomial.C (↑ε⁻¹ : RStar) * MvPolynomial.X 0) =
            Ideal.Quotient.mk J_m (MvPolynomial.X 0)
          rw [map_mul, hα_hm_C, hα_hm_X0, ← map_mul, ← mul_assoc, ← map_mul,
            Units.inv_mul, map_one, one_mul]
        · rw [Subsingleton.elim j 0]
          change ψ_hm (α_mh (MvPolynomial.X 1)) = Ideal.Quotient.mk J_m (MvPolynomial.X 1)
          rw [hα_mh_X1]
          exact hα_hm_X1
    have h_mh_hm : ψ_mh.comp ψ_hm = RingHom.id (P₂ ⧸ J_h) := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        change ψ_mh (α_hm (MvPolynomial.C r)) = Ideal.Quotient.mk J_h (MvPolynomial.C r)
        rw [hα_hm_C]
        exact hα_mh_C r
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · change ψ_mh (α_hm (MvPolynomial.X 0)) = Ideal.Quotient.mk J_h (MvPolynomial.X 0)
          rw [hα_hm_X0]
          change α_mh (MvPolynomial.C (ε : RStar) * MvPolynomial.X 0) =
            Ideal.Quotient.mk J_h (MvPolynomial.X 0)
          rw [map_mul, hα_mh_C, hα_mh_X0, ← map_mul, ← mul_assoc, ← map_mul,
            Units.mul_inv, map_one, one_mul]
        · rw [Subsingleton.elim j 0]
          change ψ_mh (α_hm (MvPolynomial.X 1)) = Ideal.Quotient.mk J_h (MvPolynomial.X 1)
          rw [hα_hm_X1]
          exact hα_mh_X1
    let e_iso : CommRingCat.of (P₂ ⧸ J_m) ≅ CommRingCat.of (P₂ ⧸ J_h) :=
      { hom := CommRingCat.ofHom ψ_mh
        inv := CommRingCat.ofHom ψ_hm
        hom_inv_id := by
          rw [← CommRingCat.ofHom_comp, h_hm_mh, CommRingCat.ofHom_id]
        inv_hom_id := by
          rw [← CommRingCat.ofHom_comp, h_mh_hm, CommRingCat.ofHom_id] }
    have hIsoC : CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) ≫ e_iso.hom =
        CommRingCat.ofHom ((Ideal.Quotient.mk J_h).comp MvPolynomial.C) := by
      dsimp only [e_iso]
      rw [← CommRingCat.ofHom_comp]
      congr 1
      ext r
      exact hα_mh_C r
    let q' : Spec D ⟶ Spec (CommRingCat.of (P₂ ⧸ J_m)) := q ≫ Spec.map e_iso.hom
    have hIsoSpec : IsIso (Spec.map e_iso.hom) :=
      ⟨⟨Spec.map e_iso.inv,
        by rw [← Spec.map_comp, e_iso.inv_hom_id, Spec.map_id],
        by rw [← Spec.map_comp, e_iso.hom_inv_id, Spec.map_id]⟩⟩
    have hq'Et : Etale q' := inferInstance
    have hq'_base : q'.base v₀ = PrimeSpectrum.comap ψ_mh (q.base v₀) := by
      change (Spec.map e_iso.hom).base (q.base v₀) = PrimeSpectrum.comap ψ_mh (q.base v₀)
      rw [Spec.map_base]
      rfl
    refine ⟨m, hm1, D, v₀, e_C, q', heEt, hq'Et, hv₀, ?_, ?_, ?_⟩
    · intro i
      rw [hq'_base]
      change ψ_mh (Ideal.Quotient.mk J_m (MvPolynomial.X i)) ∈ (q.base v₀).asIdeal
      refine Fin.cases ?_ (fun j => ?_) i
      · change α_mh (MvPolynomial.X 0) ∈ (q.base v₀).asIdeal
        rw [hα_mh_X0, map_mul]
        exact Ideal.mul_mem_left (q.base v₀).asIdeal _ (hXi 0)
      · rw [Subsingleton.elim j 0]
        change α_mh (MvPolynomial.X 1) ∈ (q.base v₀).asIdeal
        rw [hα_mh_X1]
        exact hXi 1
    · rw [hq'_base]
      change α_mh (MvPolynomial.C (PowerSeries.X : RStar)) ∈ (q.base v₀).asIdeal
      rw [hα_mh_C]
      exact hX
    · dsimp only [q']
      rw [Category.assoc, ← Spec.map_comp, hIsoC, hComm]

theorem weil_powerSeries_nodalRoof_dichotomy_finite_singular (Ω : Type u) [Field Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (hProp : AlgebraicGeometry.IsProper g)
    (hDich : ∀ x : C,
      (∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∨
      ∃ m : ℕ, HasPowerSeriesNodalRoofAt Ω g x m) :
    ∃ (r₀ : ℕ) (pts₀ : Fin r₀ → C) (mults₀ : Fin r₀ → ℕ),
      Function.Injective pts₀ ∧
      (∀ i : Fin r₀, 2 ≤ mults₀ i ∧ HasPowerSeriesNodalRoofAt Ω g (pts₀ i) (mults₀ i)) ∧
      (∀ z : C, z ∉ Set.range pts₀ →
        (∃ V : C.Opens, z ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∨
        HasPowerSeriesNodalRoofAt Ω g z 1) :=
by
  classical
  
  have hShrink : ∀ (m : ℕ), 1 ≤ m →
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)}
      ∀ (A' : CommRingCat.{u})
        (φ_q : CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m) ⟶ A')
        (v₀ : PrimeSpectrum A'),
        φ_q.hom.Etale →
        (∀ i : Fin 2, Ideal.Quotient.mk J_m (MvPolynomial.X i) ∈
          (PrimeSpectrum.comap φ_q.hom v₀).asIdeal) →
        Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω)) ∈
          (PrimeSpectrum.comap φ_q.hom v₀).asIdeal →
        ∃ s : A', s ∉ v₀.asIdeal ∧
          ∀ v : PrimeSpectrum A', s ∉ v.asIdeal → v ≠ v₀ →
            ∃ i : Fin 2, Ideal.Quotient.mk J_m (MvPolynomial.X i) ∉
              (PrimeSpectrum.comap φ_q.hom v).asIdeal := by
    intro m hm J_m A' φ_q v₀ hEt _hXi _hX
    let RStar := PowerSeries Ω
    let P₂ := MvPolynomial (Fin 2) RStar
    let P_m := P₂ ⧸ J_m
    let x₀ : P_m := Ideal.Quotient.mk J_m (MvPolynomial.X 0)
    let x₁ : P_m := Ideal.Quotient.mk J_m (MvPolynomial.X 1)
    let π_m : P_m := Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : RStar))
    let m_nod : Ideal P_m := Ideal.span {x₀, x₁, π_m}
    let ev₀ : P₂ →+* Ω := (PowerSeries.constantCoeff (R := Ω)).comp MvPolynomial.constantCoeff
    have hJ_ev : J_m ≤ RingHom.ker ev₀ := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      have hm_ne : m ≠ 0 := Nat.one_le_iff_ne_zero.mp hm
      simp [ev₀, MvPolynomial.constantCoeff_X, PowerSeries.constantCoeff_X, zero_pow hm_ne]
    let ev_bar : P_m →+* Ω :=
      Ideal.Quotient.lift J_m ev₀ (fun a ha => RingHom.mem_ker.mp (hJ_ev ha))
    let sec_Ω : Ω →+* P_m :=
      (Ideal.Quotient.mk J_m).comp (MvPolynomial.C.comp (PowerSeries.C (R := Ω)))
    have h_ev_sec : ∀ c : Ω, ev_bar (sec_Ω c) = c := by
      intro c
      change PowerSeries.constantCoeff (MvPolynomial.constantCoeff
        (MvPolynomial.C (PowerSeries.C c) : P₂)) = c
      rw [MvPolynomial.constantCoeff_C, PowerSeries.constantCoeff_C]
    have h_ind : ∀ p : P₂,
        Ideal.Quotient.mk J_m (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈ m_nod := by
      intro p
      refine MvPolynomial.induction_on
        (motive := fun q =>
          Ideal.Quotient.mk J_m (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) ∈ m_nod)
        p ?_ ?_ ?_
      · intro r
        simp
      · intro f₁ f₂ hf₁ hf₂
        have h_eq : f₁ + f₂ - MvPolynomial.C (MvPolynomial.constantCoeff (f₁ + f₂)) =
            (f₁ - MvPolynomial.C (MvPolynomial.constantCoeff f₁)) +
              (f₂ - MvPolynomial.C (MvPolynomial.constantCoeff f₂)) := by
          simp only [map_add]
          ring
        rw [h_eq, map_add]
        exact m_nod.add_mem hf₁ hf₂
      · intro f₁ i _hf₁
        have hcc : MvPolynomial.constantCoeff (f₁ * MvPolynomial.X i) = 0 := by
          simp [MvPolynomial.constantCoeff_X]
        rw [hcc, map_zero, sub_zero, map_mul]
        have hXi_mem : Ideal.Quotient.mk J_m (MvPolynomial.X i) ∈ m_nod := by
          fin_cases i <;> exact Ideal.subset_span (by simp [x₀, x₁])
        exact m_nod.mul_mem_left _ hXi_mem
    have hKer_le : RingHom.ker ev_bar ≤ m_nod := by
      intro z hz
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [RingHom.mem_ker] at hz
      have hp0 : (PowerSeries.constantCoeff (R := Ω)) (MvPolynomial.constantCoeff p) = 0 := hz
      obtain ⟨r, hr⟩ := PowerSeries.X_dvd_iff.mpr hp0
      have hC_mem : Ideal.Quotient.mk J_m (MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈ m_nod := by
        have h_prod : Ideal.Quotient.mk J_m (MvPolynomial.C (MvPolynomial.constantCoeff p)) =
            Ideal.Quotient.mk J_m (MvPolynomial.C r) * π_m := by
          dsimp only [π_m]
          rw [hr, map_mul, map_mul]
          ring
        rw [h_prod]
        exact m_nod.mul_mem_left _ (Ideal.subset_span (by simp [π_m]))
      have h_sum := m_nod.add_mem (h_ind p) hC_mem
      rwa [← map_add, sub_add_cancel] at h_sum
    have hArtHelper : ∀ (P B : Type u) [CommRing P] [CommRing B]
        (ev : P →+* Ω) (sec : Ω →+* P) (φ : P →+* B) (m_P : Ideal P),
        (∀ c : Ω, ev (sec c) = c) →
        RingHom.ker ev ≤ m_P →
        φ.Etale →
        IsArtinianRing (B ⧸ Ideal.map φ m_P) := by
      intro P B _ _ ev sec φ m_P hsec hker hφEt
      let _ : Algebra P B := φ.toAlgebra
      have : Algebra.Etale P B := hφEt
      let _ : Algebra P Ω := ev.toAlgebra
      have : Algebra.Etale Ω (TensorProduct P Ω B) := inferInstance
      have : IsArtinianRing (TensorProduct P Ω B) := by
        obtain ⟨I_idx, instFinI, Ai, instFieldAi, instAlgAi, e_prod, hFinAi⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod Ω (TensorProduct P Ω B)).mp ‹_›
        let _ : ∀ i, Field (Ai i) := instFieldAi
        let _ : ∀ i, Algebra Ω (Ai i) := instAlgAi
        have : ∀ i, Module.Finite Ω (Ai i) := fun i => (hFinAi i).1
        have : Module.Finite Ω (TensorProduct P Ω B) :=
          Module.Finite.equiv e_prod.symm.toLinearEquiv
        exact IsArtinianRing.of_finite Ω (TensorProduct P Ω B)
      let I_B : Ideal B := Ideal.map φ m_P
      let B₀ := B ⧸ I_B
      let fq : B →+* B₀ := Ideal.Quotient.mk I_B
      let ψ_Ω : Ω →+* B₀ := (fq.comp φ).comp sec
      have hψ_comm : ∀ x : P, ψ_Ω (ev x) = algebraMap P B₀ x := by
        intro x
        have hmem_ker : sec (ev x) - x ∈ RingHom.ker ev := by
          rw [RingHom.mem_ker, map_sub, hsec, sub_self]
        have hmem_I : φ (sec (ev x) - x) ∈ I_B :=
          Ideal.mem_map_of_mem φ (hker hmem_ker)
        have hzero : fq (φ (sec (ev x) - x)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hmem_I
        rw [map_sub, map_sub, sub_eq_zero] at hzero
        exact hzero
      let ψ_Ω_alg : Ω →ₐ[P] B₀ := { ψ_Ω with commutes' := hψ_comm }
      let fq_alg : B →ₐ[P] B₀ := IsScalarTower.toAlgHom P B B₀
      let Φ : TensorProduct P Ω B →ₐ[P] B₀ :=
        Algebra.TensorProduct.lift ψ_Ω_alg fq_alg (fun _ _ => Commute.all _ _)
      have hSurj_Φ : Function.Surjective Φ.toRingHom := by
        intro y
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective y
        refine ⟨1 ⊗ₜ[P] b, ?_⟩
        change Φ (1 ⊗ₜ[P] b) = y
        dsimp only [Φ]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        exact hb
      exact Function.Surjective.isArtinianRing hSurj_Φ
    let I_A : Ideal A' := Ideal.map φ_q.hom m_nod
    let A'_0 := A' ⧸ I_A
    let f_quot : A' →+* A'_0 := Ideal.Quotient.mk I_A
    have : IsArtinianRing A'_0 :=
      hArtHelper P_m A' ev_bar sec_Ω φ_q.hom m_nod h_ev_sec hKer_le hEt
    let F_nod : Set (PrimeSpectrum A') := Set.range (PrimeSpectrum.comap f_quot)
    have hF_fin : F_nod.Finite := Set.finite_range (PrimeSpectrum.comap f_quot)
    have hF_mem : ∀ v : PrimeSpectrum A',
        m_nod ≤ (PrimeSpectrum.comap φ_q.hom v).asIdeal → v ∈ F_nod := by
      intro v hv_le
      have hIA : I_A ≤ v.asIdeal := Ideal.map_le_iff_le_comap.mpr hv_le
      have hker : RingHom.ker f_quot ≤ v.asIdeal := by rwa [Ideal.mk_ker]
      refine ⟨⟨Ideal.map f_quot v.asIdeal,
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker⟩, ?_⟩
      ext a
      change a ∈ Ideal.comap f_quot (Ideal.map f_quot v.asIdeal) ↔ a ∈ v.asIdeal
      rw [v.asIdeal.comap_map_of_surjective f_quot Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hIA]
    have hF_max : ∀ v ∈ F_nod, v.asIdeal.IsMaximal := by
      rintro v ⟨w, rfl⟩
      have : w.asIdeal.IsMaximal := IsArtinianRing.isMaximal_of_isPrime w.asIdeal
      exact Ideal.comap_isMaximal_of_surjective f_quot Ideal.Quotient.mk_surjective
    have hDiff_fin : (F_nod \ {v₀}).Finite := hF_fin.sdiff
    let S_other : Finset (PrimeSpectrum A') := hDiff_fin.toFinset
    have h_sep : ∀ v ∈ S_other, ∃ a : A', a ∈ v.asIdeal ∧ a ∉ v₀.asIdeal := by
      intro v hv
      rw [Set.Finite.mem_toFinset, Set.mem_sdiff, Set.mem_singleton_iff] at hv
      by_contra h_all
      push Not at h_all
      have hv_eq : v.asIdeal = v₀.asIdeal :=
        (hF_max v hv.1).eq_of_le v₀.isPrime.ne_top h_all
      exact hv.2 (PrimeSpectrum.ext hv_eq)
    let sep : PrimeSpectrum A' → A' :=
      fun v => if hv : v ∈ S_other then (h_sep v hv).choose else 1
    refine ⟨∏ v ∈ S_other, sep v, ?_, ?_⟩
    · refine Finset.prod_induction sep (· ∉ v₀.asIdeal)
        (fun _ _ ha hb => v₀.isPrime.mul_notMem ha hb) v₀.isPrime.one_notMem ?_
      intro v hv
      simp only [sep, hv, ↓reduceDIte]
      exact (h_sep v hv).choose_spec.2
    · intro v hs_v hne
      by_contra h_all
      push Not at h_all
      have hrel : x₀ * x₁ = π_m ^ m := by
        dsimp only [x₀, x₁, π_m]
        rw [← map_mul, ← map_pow, ← map_pow, Ideal.Quotient.eq]
        exact Ideal.subset_span rfl
      have hpow : π_m ^ m ∈ (PrimeSpectrum.comap φ_q.hom v).asIdeal := by
        rw [← hrel]
        exact (PrimeSpectrum.comap φ_q.hom v).asIdeal.mul_mem_left x₀ (h_all 1)
      have hπ_in : π_m ∈ (PrimeSpectrum.comap φ_q.hom v).asIdeal :=
        (PrimeSpectrum.comap φ_q.hom v).isPrime.mem_of_pow_mem m hpow
      have hm_le : m_nod ≤ (PrimeSpectrum.comap φ_q.hom v).asIdeal := by
        rw [Ideal.span_le]
        rintro y (rfl | rfl | rfl)
        · exact h_all 0
        · exact h_all 1
        · exact hπ_in
      have hv_S : v ∈ S_other := hDiff_fin.mem_toFinset.mpr ⟨hF_mem v hm_le, hne⟩
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem sep hv_S
      have hsep_in : sep v ∈ v.asIdeal := by
        simp only [sep, hv_S, ↓reduceDIte]
        exact (h_sep v hv_S).choose_spec.1
      exact hs_v (hc ▸ v.asIdeal.mul_mem_right c hsep_in)

  
  have hLocRoof : ∀ (U : C.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      (p : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op U)))
      (A' : CommRingCat.{u}) (v : AlgebraicGeometry.Spec A')
      (e_C : AlgebraicGeometry.Spec A' ⟶ C),
      AlgebraicGeometry.Etale e_C →
      e_C.base v = hAff.fromSpec.base p →
      ∃ (t : A') (α : ↑(C.presheaf.obj (Opposite.op U)) →+* Localization.Away t)
        (q_t : PrimeSpectrum (Localization.Away t)),
        t ∉ v.asIdeal ∧
        α.Etale ∧
        PrimeSpectrum.comap (algebraMap A' (Localization.Away t)) q_t = v ∧
        PrimeSpectrum.comap α q_t = p ∧
        α.comp (AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ g)).hom =
          (algebraMap A' (Localization.Away t)).comp
            (AlgebraicGeometry.Spec.preimage (e_C ≫ g)).hom := by
    intro U hAff p A' v e_C heEt hv
    have hv_U : v ∈ (TopologicalSpace.Opens.map e_C.base).obj U := by
      change e_C.base v ∈ (U : Set C)
      rw [hv, ← hAff.range_fromSpec]
      exact ⟨p, rfl⟩
    obtain ⟨_, ⟨b, ⟨t, rfl⟩, rfl⟩, hv_t, ht_U⟩ :=
      PrimeSpectrum.isBasis_basic_opens.mem_nhds_iff.mp
        (((TopologicalSpace.Opens.map e_C.base).obj U).isOpen.mem_nhds hv_U)
    have ht_not_mem : t ∉ v.asIdeal := (PrimeSpectrum.mem_basicOpen t v).mp hv_t
    let A'_t : CommRingCat.{u} := CommRingCat.of (Localization.Away t)
    let ι_t : AlgebraicGeometry.Spec A'_t ⟶ AlgebraicGeometry.Spec A' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A' (Localization.Away t)))
    have hv_range : v ∈ Set.range (PrimeSpectrum.comap (algebraMap A' (Localization.Away t))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away t) t]
      exact hv_t
    obtain ⟨q_t, hqt_v⟩ := hv_range
    have h_range : Set.range (ι_t ≫ e_C).base ⊆ Set.range hAff.fromSpec.base := by
      rw [hAff.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      change e_C.base (ι_t.base q) ∈ (U : Set C)
      apply ht_U
      have hq_mem : PrimeSpectrum.comap (algebraMap A' (Localization.Away t)) q ∈
          Set.range (PrimeSpectrum.comap (algebraMap A' (Localization.Away t))) := ⟨q, rfl⟩
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away t) t] at hq_mem
      simpa [ι_t, AlgebraicGeometry.Spec.map_apply] using hq_mem
    have : AlgebraicGeometry.IsOpenImmersion hAff.fromSpec := hAff.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsOpenImmersion ι_t :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization t
    have : AlgebraicGeometry.Etale e_C := heEt
    let u_t : AlgebraicGeometry.Spec A'_t ⟶
        AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op U)) :=
      AlgebraicGeometry.IsOpenImmersion.lift hAff.fromSpec (ι_t ≫ e_C) h_range
    have hu_fac : u_t ≫ hAff.fromSpec = ι_t ≫ e_C :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hAff.fromSpec (ι_t ≫ e_C) h_range
    have hEt_comp : AlgebraicGeometry.Etale (u_t ≫ hAff.fromSpec) := by
      rw [hu_fac]
      infer_instance
    have hEt_ut : AlgebraicGeometry.Etale u_t :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) u_t hAff.fromSpec
        (inferInstance : AlgebraicGeometry.Etale hAff.fromSpec) hEt_comp
    let φ_u := AlgebraicGeometry.Spec.preimage u_t
    have hEt_α : φ_u.hom.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rwa [AlgebraicGeometry.Spec.map_preimage]
    have hut_p : u_t.base q_t = p := by
      apply hAff.fromSpec.isOpenEmbedding.injective
      change (u_t ≫ hAff.fromSpec).base q_t = hAff.fromSpec.base p
      rw [hu_fac]
      change e_C.base (ι_t.base q_t) = hAff.fromSpec.base p
      have hι_qt : ι_t.base q_t = v :=
        (AlgebraicGeometry.Spec.map_apply
          (CommRingCat.ofHom (algebraMap A' (Localization.Away t)))
          (q_t : AlgebraicGeometry.Spec A'_t)).trans hqt_v
      rw [hι_qt, hv]
    have hcomap_α : PrimeSpectrum.comap φ_u.hom q_t = p := by
      have h1 : (AlgebraicGeometry.Spec.map φ_u).base q_t = u_t.base q_t := by
        rw [AlgebraicGeometry.Spec.map_preimage]
      exact (AlgebraicGeometry.Spec.map_apply φ_u q_t).symm.trans (h1.trans hut_p)
    have hcomm_pre : φ_u.hom.comp (AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ g)).hom =
        (algebraMap A' (Localization.Away t)).comp
          (AlgebraicGeometry.Spec.preimage (e_C ≫ g)).hom := by
      have h1 : u_t ≫ (hAff.fromSpec ≫ g) = ι_t ≫ (e_C ≫ g) := by
        rw [← CategoryTheory.Category.assoc, hu_fac, CategoryTheory.Category.assoc]
      have h2 := congrArg AlgebraicGeometry.Spec.preimage h1
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
        AlgebraicGeometry.Spec.preimage_map] at h2
      exact congrArg CommRingCat.Hom.hom h2
    exact ⟨t, φ_u.hom, q_t, ht_not_mem, hEt_α, hqt_v, hcomap_α, hcomm_pre⟩

  
  have hDerivFalse : ∀ (A_y B₁ B₂ : CommRingCat.{u})
      (p_y : PrimeSpectrum A_y) (q₁ : PrimeSpectrum B₁) (q₂ : PrimeSpectrum B₂)
      (m₁ m₂ : ℕ)
      (φ_R : CommRingCat.of (PowerSeries Ω) ⟶ A_y)
      (α₁ : A_y ⟶ B₁) (α₂ : A_y ⟶ B₂),
      let J₁ : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m₁)}
      let J₂ : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m₂)}
      ∀ (β₁ : CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J₁) ⟶ B₁)
        (β₂ : CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J₂) ⟶ B₂)
        (i : Fin 2),
        α₁.hom.Etale →
        α₂.hom.Etale →
        β₁.hom.Etale →
        β₂.hom.Etale →
        PrimeSpectrum.comap α₁.hom q₁ = p_y →
        PrimeSpectrum.comap α₂.hom q₂ = p_y →
        (φ_R ≫ α₁).hom = β₁.hom.comp ((Ideal.Quotient.mk J₁).comp MvPolynomial.C) →
        (φ_R ≫ α₂).hom = β₂.hom.comp ((Ideal.Quotient.mk J₂).comp MvPolynomial.C) →
        Ideal.Quotient.mk J₁ (MvPolynomial.X i) ∉ (PrimeSpectrum.comap β₁.hom q₁).asIdeal →
        (∀ j : Fin 2, Ideal.Quotient.mk J₂ (MvPolynomial.X j) ∈
          (PrimeSpectrum.comap β₂.hom q₂).asIdeal) →
        False := by
    intro A_y B₁ B₂ p_y q₁ q₂ m₁ m₂ φ_R α₁ α₂ J₁ J₂ β₁ β₂ i
      hα₁Et hα₂Et hβ₁Et hβ₂Et hq₁ hq₂ hComm₁ hComm₂ hXi_not hXj_mem
    let RStar := PowerSeries Ω
    let K_y := p_y.asIdeal.ResidueField
    let K₁ := q₁.asIdeal.ResidueField
    let K₂ := q₂.asIdeal.ResidueField
    let ι₁ : K_y →+* K₁ :=
      Ideal.ResidueField.map p_y.asIdeal q₁.asIdeal α₁.hom (congrArg PrimeSpectrum.asIdeal hq₁.symm)
    let ι₂ : K_y →+* K₂ :=
      Ideal.ResidueField.map p_y.asIdeal q₂.asIdeal α₂.hom (congrArg PrimeSpectrum.asIdeal hq₂.symm)
    let _ : Algebra K_y K₁ := ι₁.toAlgebra
    let _ : Algebra K_y K₂ := ι₂.toAlgebra
    let T_res := TensorProduct K_y K₁ K₂
    have : Nontrivial T_res :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_right
        K_y K₁ K₂ (RingHom.injective _)
    obtain ⟨m_T, hm_T⟩ := Ideal.exists_maximal T_res
    have : m_T.IsPrime := hm_T.isPrime
    obtain ⟨L, instFieldL, q_T, _⟩ :
        ∃ (L : Type u) (instL : Field L) (_ : @RingHom T_res L _ instL.toNonAssocSemiring), True :=
      ⟨m_T.ResidueField, inferInstance, algebraMap T_res m_T.ResidueField, trivial⟩
    let _ : Field L := instFieldL
    let j₁ : K₁ →+* L := q_T.comp Algebra.TensorProduct.includeLeftRingHom
    let j₂ : K₂ →+* L := q_T.comp Algebra.TensorProduct.includeRight.toRingHom
    let π₁ : B₁ →+* L := j₁.comp (algebraMap B₁ K₁)
    let π₂ : B₂ →+* L := j₂.comp (algebraMap B₂ K₂)
    have hπ₁_zero : ∀ b : B₁, π₁ b = 0 ↔ b ∈ q₁.asIdeal := by
      intro b
      change j₁ (algebraMap B₁ K₁ b) = 0 ↔ b ∈ q₁.asIdeal
      rw [map_eq_zero_iff j₁ (RingHom.injective j₁), Ideal.algebraMap_residueField_eq_zero]
    have hπ₂_zero : ∀ b : B₂, π₂ b = 0 ↔ b ∈ q₂.asIdeal := by
      intro b
      change j₂ (algebraMap B₂ K₂ b) = 0 ↔ b ∈ q₂.asIdeal
      rw [map_eq_zero_iff j₂ (RingHom.injective j₂), Ideal.algebraMap_residueField_eq_zero]
    have hπ_agree : π₁.comp α₁.hom = π₂.comp α₂.hom := by
      ext a
      simp only [RingHom.comp_apply, π₁, π₂, j₁, j₂]
      rw [← Ideal.ResidueField.map_algebraMap p_y.asIdeal q₁.asIdeal α₁.hom
            (congrArg PrimeSpectrum.asIdeal hq₁.symm) a,
          ← Ideal.ResidueField.map_algebraMap p_y.asIdeal q₂.asIdeal α₂.hom
            (congrArg PrimeSpectrum.asIdeal hq₂.symm) a]
      change q_T (algebraMap K_y K₁ (algebraMap A_y K_y a) ⊗ₜ[K_y] 1) =
        q_T (1 ⊗ₜ[K_y] algebraMap K_y K₂ (algebraMap A_y K_y a))
      rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
    let IsRDer : ∀ {S : Type u} [CommRing S], (RStar →+* S) → (S →+* L) → (S → L) → Prop :=
      fun φ_S π_S d =>
        (∀ x y, d (x + y) = d x + d y) ∧
        (∀ r : RStar, d (φ_S r) = 0) ∧
        (∀ x y, d (x * y) = π_S x * d y + π_S y * d x)
    have hEtDer : ∀ {S T : Type u} [CommRing S] [CommRing T]
        (φ_S : RStar →+* S) (f : S →+* T) (_ : f.Etale) (π_T : T →+* L),
        (∀ (d₁ d₂ : T → L),
          IsRDer (f.comp φ_S) π_T d₁ →
          IsRDer (f.comp φ_S) π_T d₂ →
          (∀ s : S, d₁ (f s) = d₂ (f s)) →
          ∀ t : T, d₁ t = d₂ t) ∧
        (∀ d_S : S → L, IsRDer φ_S (π_T.comp f) d_S →
          ∃ d_T : T → L, IsRDer (f.comp φ_S) π_T d_T ∧ ∀ s : S, d_T (f s) = d_S s) := by
      intro S T _ _ φ_S f hf π_T
      let _ : Algebra RStar S := φ_S.toAlgebra
      let _ : Algebra S T := f.toAlgebra
      let _ : Algebra RStar T := (f.comp φ_S).toAlgebra
      have : IsScalarTower RStar S T := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.Etale S T := hf
      let _ : Algebra T L := π_T.toAlgebra
      let _ : Algebra S L := (π_T.comp f).toAlgebra
      let _ : Algebra RStar L := (π_T.comp (f.comp φ_S)).toAlgebra
      have : IsScalarTower S T L := IsScalarTower.of_algebraMap_eq' rfl
      have : IsScalarTower RStar T L := IsScalarTower.of_algebraMap_eq' rfl
      have : IsScalarTower RStar S L := IsScalarTower.of_algebraMap_eq' rfl
      let e₁ := (KaehlerDifferential.linearMapEquivDerivation RStar T (M := L)).symm
      let e₂ := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale RStar S T
      let e₃ := LinearMap.liftBaseChangeEquiv (R := S) (M := KaehlerDifferential RStar S) (N := L) T
      let e₄ := KaehlerDifferential.linearMapEquivDerivation RStar S (M := L)
      let Φ : Derivation RStar T L → Derivation RStar S L :=
        fun D => e₄ (e₃.symm ((e₁ D).comp e₂.toLinearMap))
      have hΦ_apply : ∀ (D : Derivation RStar T L) (s : S), Φ D s = D (f s) := by
        intro D s
        have he₂_D : e₂ (1 ⊗ₜ[S] KaehlerDifferential.D RStar S s) =
            KaehlerDifferential.D RStar T (algebraMap S T s) := by
          rw [← KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap RStar S T s,
            e₂.apply_symm_apply]
        change (e₄ (e₃.symm ((e₁ D).comp e₂.toLinearMap))) s = D (algebraMap S T s)
        rw [KaehlerDifferential.linearMapEquivDerivation_apply_apply,
          LinearMap.liftBaseChangeEquiv_symm_apply, LinearMap.comp_apply,
          LinearEquiv.coe_coe, he₂_D]
        have h_inv := e₁.symm_apply_apply D
        have h_ev := congrArg (fun d : Derivation RStar T L => d (algebraMap S T s)) h_inv
        dsimp only [e₁] at h_ev ⊢
        rwa [LinearEquiv.symm_symm,
          KaehlerDifferential.linearMapEquivDerivation_apply_apply] at h_ev
      have hΦ_bij : Function.Bijective Φ := by
        refine ⟨?_, ?_⟩
        · intro D₁ D₂ hEq
          apply e₁.injective
          have hEq' : (e₁ D₁).comp e₂.toLinearMap = (e₁ D₂).comp e₂.toLinearMap :=
            e₃.symm.injective (e₄.injective hEq)
          apply LinearMap.ext
          intro x
          have hx := congrArg (fun l => l (e₂.symm x)) hEq'
          simpa [LinearMap.comp_apply] using hx
        · intro D_S
          refine ⟨e₁.symm ((e₃ (e₄.symm D_S)).comp e₂.symm.toLinearMap), ?_⟩
          dsimp only [Φ]
          have h_comp : ((e₃ (e₄.symm D_S)).comp e₂.symm.toLinearMap).comp e₂.toLinearMap =
              e₃ (e₄.symm D_S) := by
            apply LinearMap.ext
            intro z
            simp [LinearMap.comp_apply]
          simp [h_comp]
      let mkDerT : ∀ (d : T → L), IsRDer (f.comp φ_S) π_T d → Derivation RStar T L :=
        fun d hd =>
          { toFun := d
            map_add' := hd.1
            map_smul' := fun r t => by
              change d (f (φ_S r) * t) = π_T (f (φ_S r)) * d t
              have hr0 : d (f (φ_S r)) = 0 := hd.2.1 r
              rw [hd.2.2, hr0, mul_zero, add_zero]
            map_one_eq_zero' := by
              change d 1 = 0
              simpa only [map_one] using hd.2.1 1
            leibniz' := fun a b => hd.2.2 a b }
      let mkDerS : ∀ (d : S → L), IsRDer φ_S (π_T.comp f) d → Derivation RStar S L :=
        fun d hd =>
          { toFun := d
            map_add' := hd.1
            map_smul' := fun r s => by
              change d (φ_S r * s) = π_T (f (φ_S r)) * d s
              have hr0 : d (φ_S r) = 0 := hd.2.1 r
              rw [hd.2.2, hr0, mul_zero, add_zero]
              rfl
            map_one_eq_zero' := by
              change d 1 = 0
              simpa only [map_one] using hd.2.1 1
            leibniz' := fun a b => hd.2.2 a b }
      refine ⟨?_, ?_⟩
      · intro d₁ d₂ hd₁ hd₂ h_eq t
        have hΦ_eq : Φ (mkDerT d₁ hd₁) = Φ (mkDerT d₂ hd₂) := by
          ext s
          rw [hΦ_apply, hΦ_apply]
          exact h_eq s
        have hD_eq := hΦ_bij.1 hΦ_eq
        exact congrArg (fun D : Derivation RStar T L => D t) hD_eq
      · intro d_S hd_S
        obtain ⟨D_T, hDT⟩ := hΦ_bij.2 (mkDerS d_S hd_S)
        refine ⟨fun t => D_T t, ⟨D_T.map_add, fun r => D_T.map_algebraMap r, fun a b => D_T.leibniz a b⟩, ?_⟩
        intro s
        dsimp only
        rw [← hΦ_apply D_T s, hDT]
        rfl
    let P₂ := MvPolynomial (Fin 2) RStar
    let P_m₁ := P₂ ⧸ J₁
    let P_m₂ := P₂ ⧸ J₂
    let φ_P₁ : RStar →+* P_m₁ := (Ideal.Quotient.mk J₁).comp MvPolynomial.C
    let φ_P₂ : RStar →+* P_m₂ := (Ideal.Quotient.mk J₂).comp MvPolynomial.C
    let ψ₁ : P_m₁ →+* L := π₁.comp β₁.hom
    let ψ₂ : P_m₂ →+* L := π₂.comp β₂.hom
    let ψ₂_tilde : P₂ →+* L := ψ₂.comp (Ideal.Quotient.mk J₂)
    have hψ₂_X : ∀ j : Fin 2, ψ₂_tilde (MvPolynomial.X j) = 0 := by
      intro j
      change π₂ (β₂.hom (Ideal.Quotient.mk J₂ (MvPolynomial.X j))) = 0
      exact (hπ₂_zero _).mpr (hXj_mem j)
    let G₂ : P₂ := MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C ((PowerSeries.X : RStar) ^ m₂)
    have hψ₂_G₂ : ψ₂_tilde G₂ = 0 := by
      change ψ₂ (Ideal.Quotient.mk J₂ G₂) = 0
      have hG₂_zero : Ideal.Quotient.mk J₂ G₂ = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [hG₂_zero, map_zero]
    let δ_tilde : Fin 2 → P₂ → L := fun a p => ψ₂_tilde (MvPolynomial.pderiv a p)
    have hδ_tilde_J₂ : ∀ (a : Fin 2) (p : P₂), p ∈ J₂ → δ_tilde a p = 0 := by
      intro a p hp
      rw [Ideal.mem_span_singleton] at hp
      obtain ⟨q, rfl⟩ := hp
      dsimp only [δ_tilde]
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, hψ₂_G₂, zero_mul, zero_add]
      have hdG : ψ₂_tilde (MvPolynomial.pderiv a G₂) = 0 := by
        dsimp only [G₂]
        rw [map_sub, MvPolynomial.pderiv_C, sub_zero, Derivation.leibniz,
          smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, hψ₂_X 0, hψ₂_X 1]
        ring
      rw [hdG, mul_zero]
    let δ : Fin 2 → P_m₂ → L := fun a =>
      Quotient.lift (δ_tilde a) (fun p q hpq => by
        have hsub : p - q ∈ J₂ := Ideal.Quotient.eq.mp (Quotient.sound hpq)
        have h0 := hδ_tilde_J₂ a (p - q) hsub
        dsimp only [δ_tilde] at h0 ⊢
        rw [map_sub, map_sub, sub_eq_zero] at h0
        exact h0)
    have hδ_der : ∀ a : Fin 2, IsRDer φ_P₂ ψ₂ (δ a) := by
      intro a
      refine ⟨?_, ?_, ?_⟩
      · intro x y
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
        change δ_tilde a (p + q) = δ_tilde a p + δ_tilde a q
        simp [δ_tilde]
      · intro r
        change ψ₂_tilde (MvPolynomial.pderiv a (MvPolynomial.C r)) = 0
        simp
      · intro x y
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
        change ψ₂_tilde (MvPolynomial.pderiv a (p * q)) =
          ψ₂_tilde p * δ_tilde a q + ψ₂_tilde q * δ_tilde a p
        simp [δ_tilde, Derivation.leibniz, smul_eq_mul]
    have hβ₂_comp : β₂.hom.comp φ_P₂ = α₂.hom.comp φ_R.hom := hComm₂.symm
    have hβ₁_comp : β₁.hom.comp φ_P₁ = α₁.hom.comp φ_R.hom := hComm₁.symm
    obtain ⟨dB₂_0, hdB₂_0, hdB₂_0_eq⟩ := (hEtDer φ_P₂ β₂.hom hβ₂Et π₂).2 (δ 0) (hδ_der 0)
    obtain ⟨dB₂_1, hdB₂_1, hdB₂_1_eq⟩ := (hEtDer φ_P₂ β₂.hom hβ₂Et π₂).2 (δ 1) (hδ_der 1)
    have hdB₂_der : ∀ d : B₂ → L, IsRDer (β₂.hom.comp φ_P₂) π₂ d →
        IsRDer (α₂.hom.comp φ_R.hom) π₂ d := fun d hd => hβ₂_comp ▸ hd
    let dAy_0 : A_y → L := fun x => dB₂_0 (α₂.hom x)
    let dAy_1 : A_y → L := fun x => dB₂_1 (α₂.hom x)
    have hRestr : ∀ {S T : Type u} [CommRing S] [CommRing T]
        (φ_S : RStar →+* S) (f : S →+* T) (π_T : T →+* L) (d : T → L),
        IsRDer (f.comp φ_S) π_T d → IsRDer φ_S (π_T.comp f) (fun s => d (f s)) := by
      intro S T _ _ φ_S f π_T d hd
      exact ⟨fun x y => by dsimp only; rw [map_add, hd.1],
             fun r => hd.2.1 r,
             fun x y => by dsimp only; rw [map_mul, hd.2.2]; rfl⟩
    have hdAy_0 : IsRDer φ_R.hom (π₁.comp α₁.hom) dAy_0 :=
      hπ_agree.symm ▸ hRestr φ_R.hom α₂.hom π₂ dB₂_0 (hdB₂_der dB₂_0 hdB₂_0)
    have hdAy_1 : IsRDer φ_R.hom (π₁.comp α₁.hom) dAy_1 :=
      hπ_agree.symm ▸ hRestr φ_R.hom α₂.hom π₂ dB₂_1 (hdB₂_der dB₂_1 hdB₂_1)
    obtain ⟨dB₁_0, hdB₁_0, hdB₁_0_eq⟩ := (hEtDer φ_R.hom α₁.hom hα₁Et π₁).2 dAy_0 hdAy_0
    obtain ⟨dB₁_1, hdB₁_1, hdB₁_1_eq⟩ := (hEtDer φ_R.hom α₁.hom hα₁Et π₁).2 dAy_1 hdAy_1
    have hdB₁_der : ∀ d : B₁ → L, IsRDer (α₁.hom.comp φ_R.hom) π₁ d →
        IsRDer (β₁.hom.comp φ_P₁) π₁ d := fun d hd => hβ₁_comp.symm ▸ hd
    let D₀ : P_m₁ → L := fun x => dB₁_0 (β₁.hom x)
    let D₁ : P_m₁ → L := fun x => dB₁_1 (β₁.hom x)
    have hD₀ : IsRDer φ_P₁ ψ₁ D₀ := hRestr φ_P₁ β₁.hom π₁ dB₁_0 (hdB₁_der dB₁_0 hdB₁_0)
    have hD₁ : IsRDer φ_P₁ ψ₁ D₁ := hRestr φ_P₁ β₁.hom π₁ dB₁_1 (hdB₁_der dB₁_1 hdB₁_1)
    have hLin : ∀ {S : Type u} [CommRing S] (φ_S : RStar →+* S) (π_S : S →+* L)
        (a₀ a₁ : L) (d₀ d₁ : S → L),
        IsRDer φ_S π_S d₀ → IsRDer φ_S π_S d₁ →
        IsRDer φ_S π_S (fun s => a₀ * d₀ s + a₁ * d₁ s) := by
      intro S _ φ_S π_S a₀ a₁ d₀ d₁ hd₀ hd₁
      refine ⟨fun x y => by dsimp only; rw [hd₀.1, hd₁.1]; ring,
              fun r => by dsimp only; rw [hd₀.2.1, hd₁.2.1, mul_zero, mul_zero, add_zero],
              fun x y => by dsimp only; rw [hd₀.2.2, hd₁.2.2]; ring⟩
    have hZeroDer : ∀ {S : Type u} [CommRing S] (φ_S : RStar →+* S) (π_S : S →+* L),
        IsRDer φ_S π_S (fun _ => 0) :=
      fun _ _ => ⟨fun _ _ => by simp, fun _ => rfl, fun _ _ => by simp⟩
    let u_i : P_m₁ := Ideal.Quotient.mk J₁ (MvPolynomial.X i)
    let a₀ : L := if D₀ u_i = 0 then 1 else - D₁ u_i
    let a₁ : L := if D₀ u_i = 0 then 0 else D₀ u_i
    let D_comb : P_m₁ → L := fun x => a₀ * D₀ x + a₁ * D₁ x
    have hD_comb_der : IsRDer φ_P₁ ψ₁ D_comb := hLin φ_P₁ ψ₁ a₀ a₁ D₀ D₁ hD₀ hD₁
    have hD_comb_ui : D_comb u_i = 0 := by
      dsimp only [D_comb, a₀, a₁]
      split_ifs with h0
      · simp [h0]
      · ring
    have hψ₁_ui_ne : ψ₁ u_i ≠ 0 := by
      intro h0
      exact hXi_not ((hπ₁_zero (β₁.hom u_i)).mp h0)
    have hD_comb_X : ∀ k : Fin 2, D_comb (Ideal.Quotient.mk J₁ (MvPolynomial.X k)) = 0 := by
      have hrel : Ideal.Quotient.mk J₁ (MvPolynomial.X 0) *
          Ideal.Quotient.mk J₁ (MvPolynomial.X 1) =
          φ_P₁ ((PowerSeries.X : RStar) ^ m₁) := by
        dsimp only [φ_P₁, RingHom.comp_apply]
        rw [← map_mul, Ideal.Quotient.eq]
        exact Ideal.subset_span rfl
      have hleib := hD_comb_der.2.2 (Ideal.Quotient.mk J₁ (MvPolynomial.X 0))
        (Ideal.Quotient.mk J₁ (MvPolynomial.X 1))
      rw [hrel, hD_comb_der.2.1] at hleib
      fin_cases i
      · have hi0 : D_comb (Ideal.Quotient.mk J₁ (MvPolynomial.X 0)) = 0 := hD_comb_ui
        have hu0 : ψ₁ (Ideal.Quotient.mk J₁ (MvPolynomial.X 0)) ≠ 0 := hψ₁_ui_ne
        rw [hi0, mul_zero, add_zero] at hleib
        have hi1 : D_comb (Ideal.Quotient.mk J₁ (MvPolynomial.X 1)) = 0 :=
          (mul_eq_zero.mp hleib.symm).resolve_left hu0
        intro k; fin_cases k <;> assumption
      · have hi1 : D_comb (Ideal.Quotient.mk J₁ (MvPolynomial.X 1)) = 0 := hD_comb_ui
        have hu1 : ψ₁ (Ideal.Quotient.mk J₁ (MvPolynomial.X 1)) ≠ 0 := hψ₁_ui_ne
        rw [hi1, mul_zero, zero_add] at hleib
        have hi0 : D_comb (Ideal.Quotient.mk J₁ (MvPolynomial.X 0)) = 0 :=
          (mul_eq_zero.mp hleib.symm).resolve_left hu1
        intro k; fin_cases k <;> assumption
    have hD_comb_zero : ∀ x : P_m₁, D_comb x = 0 := by
      intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      refine MvPolynomial.induction_on
        (motive := fun q => D_comb (Ideal.Quotient.mk J₁ q) = 0) p ?_ ?_ ?_
      · intro r
        exact hD_comb_der.2.1 r
      · intro f₁ f₂ hf₁ hf₂
        rw [map_add, hD_comb_der.1, hf₁, hf₂, add_zero]
      · intro f₁ k hf₁
        rw [map_mul, hD_comb_der.2.2, hD_comb_X k, hf₁, mul_zero, mul_zero, add_zero]
    have hdB₁_zero : ∀ b : B₁, a₀ * dB₁_0 b + a₁ * dB₁_1 b = 0 :=
      (hEtDer φ_P₁ β₁.hom hβ₁Et π₁).1
        (fun b => a₀ * dB₁_0 b + a₁ * dB₁_1 b) (fun _ => 0)
        (hLin _ _ a₀ a₁ _ _ (hdB₁_der _ hdB₁_0) (hdB₁_der _ hdB₁_1))
        (hZeroDer (β₁.hom.comp φ_P₁) π₁)
        (fun x => hD_comb_zero x)
    have hdAy_zero : ∀ y_el : A_y, a₀ * dAy_0 y_el + a₁ * dAy_1 y_el = 0 := by
      intro y_el
      rw [← hdB₁_0_eq y_el, ← hdB₁_1_eq y_el]
      exact hdB₁_zero (α₁.hom y_el)
    have hdB₂_zero : ∀ b : B₂, a₀ * dB₂_0 b + a₁ * dB₂_1 b = 0 :=
      (hEtDer φ_R.hom α₂.hom hα₂Et π₂).1
        (fun b => a₀ * dB₂_0 b + a₁ * dB₂_1 b) (fun _ => 0)
        (hLin _ _ a₀ a₁ _ _ (hdB₂_der _ hdB₂_0) (hdB₂_der _ hdB₂_1))
        (hZeroDer (α₂.hom.comp φ_R.hom) π₂)
        (fun y_el => hdAy_zero y_el)
    have hδ_zero : ∀ x : P_m₂, a₀ * δ 0 x + a₁ * δ 1 x = 0 := by
      intro x
      rw [← hdB₂_0_eq x, ← hdB₂_1_eq x]
      exact hdB₂_zero (β₂.hom x)
    have ha₀_zero : a₀ = 0 := by
      have h0 := hδ_zero (Ideal.Quotient.mk J₂ (MvPolynomial.X 0))
      change a₀ * ψ₂_tilde (MvPolynomial.pderiv (0 : Fin 2) (MvPolynomial.X 0)) +
        a₁ * ψ₂_tilde (MvPolynomial.pderiv (1 : Fin 2) (MvPolynomial.X 0)) = 0 at h0
      simp [MvPolynomial.pderiv_X] at h0
      exact h0
    have ha₁_zero : a₁ = 0 := by
      have h1 := hδ_zero (Ideal.Quotient.mk J₂ (MvPolynomial.X 1))
      change a₀ * ψ₂_tilde (MvPolynomial.pderiv (0 : Fin 2) (MvPolynomial.X 1)) +
        a₁ * ψ₂_tilde (MvPolynomial.pderiv (1 : Fin 2) (MvPolynomial.X 1)) = 0 at h1
      simp [MvPolynomial.pderiv_X] at h1
      exact h1
    by_cases h0 : D₀ u_i = 0
    · simp [a₀, h0] at ha₀_zero
    · simp [a₁, h0] at ha₁_zero

  
  let U_sm : Set C :=
    {x : C | ∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)}
  let Z_sing : Set C := U_smᶜ
  have hOpen_Usm : IsOpen U_sm := by
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨V, hxV, hSm⟩
    exact ⟨(V : Set C), fun y hy => ⟨V, hy, hSm⟩, V.isOpen, hxV⟩
  have hClosed_Zsing : IsClosed Z_sing := hOpen_Usm.isClosed_compl
  have hIso : ∀ x ∈ Z_sing, ∃ W : Set C, IsOpen W ∧ x ∈ W ∧ ∀ y ∈ W, y ∈ Z_sing → y = x := by
    intro x hx
    have hNod_x : ∃ m : ℕ, HasPowerSeriesNodalRoofAt Ω g x m :=
      (hDich x).resolve_left hx
    obtain ⟨m, hm, A', v₀, e_C, q, heEt, hqEt, hv₀, hXi, hX, hComm⟩ := hNod_x
    let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)}
    let φ_q := AlgebraicGeometry.Spec.preimage q
    have hφqEt : φ_q.hom.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rwa [AlgebraicGeometry.Spec.map_preimage]
    have hq_base : ∀ w : AlgebraicGeometry.Spec A',
        PrimeSpectrum.comap φ_q.hom w = q.base w := by
      intro w
      rw [← AlgebraicGeometry.Spec.map_apply, AlgebraicGeometry.Spec.map_preimage]
    obtain ⟨s, hs_v₀, hs_off⟩ := hShrink m hm A' φ_q v₀ hφqEt
      (fun i => by rw [hq_base]; exact hXi i)
      (by rw [hq_base]; exact hX)
    have : AlgebraicGeometry.Etale e_C := heEt
    let U_s : (AlgebraicGeometry.Spec A').Opens := PrimeSpectrum.basicOpen s
    let W : Set C := e_C.base '' (U_s : Set (AlgebraicGeometry.Spec A'))
    refine ⟨W, e_C.isOpenMap _ U_s.isOpen,
      ⟨v₀, (PrimeSpectrum.mem_basicOpen s v₀).mpr hs_v₀, hv₀⟩, ?_⟩
    intro y hyW hyZ
    by_contra hne_yx
    obtain ⟨v, hv_basic, hv_y⟩ := hyW
    have hs_v : s ∉ v.asIdeal := (PrimeSpectrum.mem_basicOpen s v).mp hv_basic
    have hv_ne : v ≠ v₀ := fun h_eq => hne_yx (by rw [← hv_y, h_eq, hv₀])
    obtain ⟨i, hXi_not⟩ := hs_off v hs_v hv_ne
    obtain ⟨m₂, _hm₂, A'', w₀, e''_C, q'', he''Et, hq''Et, hw₀, hXj'', _hX'', hComm''⟩ :=
      (hDich y).resolve_left hyZ
    let J₂ : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m₂)}
    let φ_q'' := AlgebraicGeometry.Spec.preimage q''
    have hφq''Et : φ_q''.hom.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rwa [AlgebraicGeometry.Spec.map_preimage]
    obtain ⟨U_y, hAff_y, hy_Uy, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    have hy_range : y ∈ Set.range hAff_y.fromSpec.base := by
      rw [hAff_y.range_fromSpec]
      exact hy_Uy
    obtain ⟨p_y, hp_y⟩ := hy_range
    obtain ⟨t₁, α₁_hom, q₁, _ht₁, hα₁Et, hq₁_v, hq₁_py, hα₁_comm⟩ :=
      hLocRoof U_y hAff_y p_y A' v e_C heEt (hv_y.trans hp_y.symm)
    obtain ⟨t₂, α₂_hom, q₂, _ht₂, hα₂Et, hq₂_w₀, hq₂_py, hα₂_comm⟩ :=
      hLocRoof U_y hAff_y p_y A'' w₀ e''_C he''Et (hw₀.trans hp_y.symm)
    let A_y_cat : CommRingCat.{u} := C.presheaf.obj (Opposite.op U_y)
    let B₁ : CommRingCat.{u} := CommRingCat.of (Localization.Away t₁)
    let B₂ : CommRingCat.{u} := CommRingCat.of (Localization.Away t₂)
    let φ_R : CommRingCat.of (PowerSeries Ω) ⟶ A_y_cat :=
      AlgebraicGeometry.Spec.preimage (hAff_y.fromSpec ≫ g)
    let α₁ : A_y_cat ⟶ B₁ := CommRingCat.ofHom α₁_hom
    let α₂ : A_y_cat ⟶ B₂ := CommRingCat.ofHom α₂_hom
    let β₁ : CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m) ⟶ B₁ :=
      φ_q ≫ CommRingCat.ofHom (algebraMap A' (Localization.Away t₁))
    let β₂ : CommRingCat.of (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J₂) ⟶ B₂ :=
      φ_q'' ≫ CommRingCat.ofHom (algebraMap A'' (Localization.Away t₂))
    have hβ₁Et : β₁.hom.Etale :=
      RingHom.Etale.stableUnderComposition φ_q.hom (algebraMap A' (Localization.Away t₁))
        hφqEt (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway t₁))
    have hβ₂Et : β₂.hom.Etale :=
      RingHom.Etale.stableUnderComposition φ_q''.hom (algebraMap A'' (Localization.Away t₂))
        hφq''Et (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway t₂))
    have hComm_β₁ : (φ_R ≫ α₁).hom = β₁.hom.comp ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) := by
      change α₁_hom.comp (AlgebraicGeometry.Spec.preimage (hAff_y.fromSpec ≫ g)).hom =
        ((algebraMap A' (Localization.Away t₁)).comp φ_q.hom).comp
          ((Ideal.Quotient.mk J_m).comp MvPolynomial.C)
      rw [hα₁_comm]
      have hpre := congrArg AlgebraicGeometry.Spec.preimage hComm
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map] at hpre
      have hpre_hom := congrArg CommRingCat.Hom.hom hpre
      rw [hpre_hom]
      rfl
    have hComm_β₂ : (φ_R ≫ α₂).hom = β₂.hom.comp ((Ideal.Quotient.mk J₂).comp MvPolynomial.C) := by
      change α₂_hom.comp (AlgebraicGeometry.Spec.preimage (hAff_y.fromSpec ≫ g)).hom =
        ((algebraMap A'' (Localization.Away t₂)).comp φ_q''.hom).comp
          ((Ideal.Quotient.mk J₂).comp MvPolynomial.C)
      rw [hα₂_comm]
      have hpre := congrArg AlgebraicGeometry.Spec.preimage hComm''
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map] at hpre
      have hpre_hom := congrArg CommRingCat.Hom.hom hpre
      rw [hpre_hom]
      rfl
    have hXi_not_β₁ : Ideal.Quotient.mk J_m (MvPolynomial.X i) ∉
        (PrimeSpectrum.comap β₁.hom q₁).asIdeal := by
      have hcomap : (PrimeSpectrum.comap β₁.hom q₁).asIdeal =
          (PrimeSpectrum.comap φ_q.hom v).asIdeal := by
        rw [← hq₁_v]
        rfl
      rwa [hcomap]
    have hXj_mem_β₂ : ∀ j : Fin 2, Ideal.Quotient.mk J₂ (MvPolynomial.X j) ∈
        (PrimeSpectrum.comap β₂.hom q₂).asIdeal := by
      intro j
      have hq_base'' : PrimeSpectrum.comap φ_q''.hom w₀ = q''.base w₀ := by
        rw [← AlgebraicGeometry.Spec.map_apply, AlgebraicGeometry.Spec.map_preimage]
      have hcomap : (PrimeSpectrum.comap β₂.hom q₂).asIdeal = (q''.base w₀).asIdeal := by
        rw [← hq_base'', ← hq₂_w₀]
        rfl
      rw [hcomap]
      exact hXj'' j
    exact hDerivFalse A_y_cat B₁ B₂ p_y q₁ q₂ m m₂ φ_R α₁ α₂ β₁ β₂ i
      hα₁Et hα₂Et hβ₁Et hβ₂Et hq₁_py hq₂_py hComm_β₁ hComm_β₂ hXi_not_β₁ hXj_mem_β₂
  have : AlgebraicGeometry.IsProper g := hProp
  have : CompactSpace ↥C := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g
  have hCompact_Z : IsCompact Z_sing := hClosed_Zsing.isCompact
  let W_cov : ↥Z_sing → Set C := fun x => (hIso x.1 x.2).choose
  have hW_open : ∀ x : ↥Z_sing, IsOpen (W_cov x) := fun x => (hIso x.1 x.2).choose_spec.1
  have hW_sub : Z_sing ⊆ ⋃ x : ↥Z_sing, W_cov x := by
    intro y hy
    exact Set.mem_iUnion.mpr ⟨⟨y, hy⟩, (hIso y hy).choose_spec.2.1⟩
  obtain ⟨S_fin, hS_fin⟩ := hCompact_Z.elim_finite_subcover W_cov hW_open hW_sub
  have hZ_fin : Z_sing.Finite := by
    refine (S_fin.image Subtype.val).finite_toSet.subset ?_
    intro y hy
    have hy_un := hS_fin hy
    simp only [Set.mem_iUnion, exists_prop] at hy_un
    obtain ⟨x, hx_mem, hy_W⟩ := hy_un
    have hy_eq : y = x.1 := (hIso x.1 x.2).choose_spec.2.2 y hy_W hy
    rw [hy_eq]
    exact Finset.mem_coe.mpr (Finset.mem_image_of_mem Subtype.val hx_mem)
  have hex_nod : ∀ (z : C), z ∈ Z_sing → ∃ m : ℕ, HasPowerSeriesNodalRoofAt Ω g z m :=
    fun z hz => (hDich z).resolve_left hz
  let μ : ∀ (z : C), z ∈ Z_sing → ℕ := fun z hz => (hex_nod z hz).choose
  have hμ : ∀ (z : C) (hz : z ∈ Z_sing), HasPowerSeriesNodalRoofAt Ω g z (μ z hz) :=
    fun z hz => (hex_nod z hz).choose_spec
  let Z_2 : Set C := {z : C | ∃ hz : z ∈ Z_sing, 2 ≤ μ z hz}
  have hZ2_fin : Z_2.Finite := hZ_fin.subset (fun _ ⟨hz, _⟩ => hz)
  have : Finite ↥Z_2 := hZ2_fin
  obtain ⟨r₀, ⟨e₀⟩⟩ := Finite.exists_equiv_fin ↥Z_2
  let pts₀ : Fin r₀ → C := fun i => (e₀.symm i).1
  let mults₀ : Fin r₀ → ℕ := fun i => μ (pts₀ i) (e₀.symm i).2.choose
  refine ⟨r₀, pts₀, mults₀, Subtype.val_injective.comp e₀.symm.injective, ?_, ?_⟩
  · intro i
    exact ⟨(e₀.symm i).2.choose_spec, hμ (pts₀ i) (e₀.symm i).2.choose⟩
  · intro z hz_not_range
    by_cases hz_sing : z ∈ Z_sing
    · right
      have h_not_two : ¬ (2 ≤ μ z hz_sing) := by
        intro h2
        apply hz_not_range
        have hz2 : z ∈ Z_2 := ⟨hz_sing, h2⟩
        exact ⟨e₀ ⟨z, hz2⟩, by simp [pts₀]⟩
      have h1 : 1 ≤ μ z hz_sing := (hμ z hz_sing).1
      have h_eq1 : μ z hz_sing = 1 := by omega
      exact h_eq1 ▸ hμ z hz_sing
    · left
      exact not_not.mp hz_sing

theorem weil_powerSeries_henselian_hypersurface_to_initial_partial_resolution (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (hInt : AlgebraicGeometry.IsIntegral C)
    (hSmK : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (CategoryTheory.Limits.pullback.snd g
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (PowerSeries Ω) (FractionRing (PowerSeries Ω)))))))
    (hHyp : ∀ x : C,
      (∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∨
      (∃ (U_C : C.Opens) (hAffC : AlgebraicGeometry.IsAffineOpen U_C)
          (q₀ : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op U_C)))
          (B : Type u) (_ : CommRing B)
          (φ_P : MvPolynomial (Fin 2) (PowerSeries Ω) →+* B)
          (Q : PrimeSpectrum B)
          (F : B)
          (e_hyp : ↑(C.presheaf.obj (Opposite.op U_C)) →+* (B ⧸ Ideal.span {F})),
        hAffC.fromSpec.base q₀ = x ∧
        φ_P.Etale ∧
        e_hyp.Etale ∧
        Q.asIdeal.comap (φ_P.comp MvPolynomial.C) = IsLocalRing.maximalIdeal (PowerSeries Ω) ∧
        (∀ b : B, ∃ c : PowerSeries Ω, b - φ_P (MvPolynomial.C c) ∈ Q.asIdeal) ∧
        (∀ i : Fin 2, φ_P (MvPolynomial.X i) ∈ Q.asIdeal) ∧
        F - φ_P (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
          Ideal.map (φ_P.comp MvPolynomial.C) (IsLocalRing.maximalIdeal (PowerSeries Ω)) ⊔
            Ideal.span {φ_P (MvPolynomial.X 0), φ_P (MvPolynomial.X 1)} ^ 3 ∧
        e_hyp.comp (AlgebraicGeometry.Spec.preimage (hAffC.fromSpec ≫ g)).hom =
          (Ideal.Quotient.mk (Ideal.span {F})).comp (φ_P.comp MvPolynomial.C) ∧
        ∃ q_bar : PrimeSpectrum (B ⧸ Ideal.span {F}),
          PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {F})) q_bar = Q ∧
          PrimeSpectrum.comap e_hyp q_bar = q₀)) :
    ∃ (r₀ : ℕ) (pts₀ : Fin r₀ → C) (mults₀ : Fin r₀ → ℕ),
      IsPartialPowerSeriesNodeResolution Ω n g τ g τ (𝟙 C) ∅ r₀ pts₀ mults₀ :=
by
  have hDich : ∀ x : C,
      (∃ V : C.Opens, x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∨
      ∃ m : ℕ, HasPowerSeriesNodalRoofAt Ω g x m := by
    intro x
    rcases hHyp x with hSm | ⟨U_C, hAffC, q₀, B, instCommRingB, φ_P, Q, F, e_hyp,
      hx, hφEt, heEt, hQcomap, hRes, hXi, hF, hComm, q_bar, hqQ, hqq₀⟩
    · exact Or.inl hSm
    · right
      letI : CommRing B := instCommRingB
      obtain ⟨hFQ, s, u₀, v₀, h, A₂₀, A₁₁, A₀₂, hsQ, hu₀, hv₀, hh, hA₂₀, hA₀₂, hA₁₁, hQuad⟩ :=
        weil_powerSeries_etale_plane_critical_retraction Ω B φ_P Q F hφEt hQcomap hRes hXi hF
      obtain ⟨D, e_BF, e_Nh, v_D, heBFEt, heNhEt, hvDQ, hvDXi, hvDX, heComm⟩ :=
        weil_powerSeries_quadratic_etale_quotient_roof Ω B φ_P Q F s u₀ v₀ h A₂₀ A₁₁ A₀₂
          hφEt hQcomap hXi hFQ hsQ hu₀ hv₀ hA₂₀ hA₀₂ hA₁₁ hQuad
      let J_h : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}
      let φ_AD := CommRingCat.ofHom e_hyp ≫ e_BF
      let e_C : AlgebraicGeometry.Spec D ⟶ C :=
        AlgebraicGeometry.Spec.map φ_AD ≫ hAffC.fromSpec
      let q : AlgebraicGeometry.Spec D ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_h)) :=
        AlgebraicGeometry.Spec.map e_Nh
      have hEtAD : φ_AD.hom.Etale :=
        RingHom.Etale.stableUnderComposition e_hyp e_BF.hom heEt heBFEt
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_AD) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEtAD
      have hEtq : AlgebraicGeometry.Etale q :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr heNhEt
      have hEt_eC : AlgebraicGeometry.Etale e_C := inferInstance
      have hvD_qbar : PrimeSpectrum.comap e_BF.hom v_D = q_bar :=
        PrimeSpectrum.comap_injective_of_surjective (Ideal.Quotient.mk (Ideal.span {F}))
          Ideal.Quotient.mk_surjective (hvDQ.trans hqQ.symm)
      have hvD_x : e_C.base v_D = x := by
        change hAffC.fromSpec.base (PrimeSpectrum.comap e_hyp (PrimeSpectrum.comap e_BF.hom v_D)) = x
        rw [hvD_qbar, hqq₀, hx]
      have hCommEq : e_C ≫ g = q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk J_h).comp MvPolynomial.C)) := by
        change (AlgebraicGeometry.Spec.map φ_AD ≫ hAffC.fromSpec) ≫ g =
          AlgebraicGeometry.Spec.map e_Nh ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk J_h).comp MvPolynomial.C))
        rw [CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_preimage (hAffC.fromSpec ≫ g),
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext r
        change e_BF.hom (e_hyp ((AlgebraicGeometry.Spec.preimage (hAffC.fromSpec ≫ g)).hom r)) =
          e_Nh.hom (((Ideal.Quotient.mk J_h).comp MvPolynomial.C) r)
        have h1 := RingHom.congr_fun hComm r
        dsimp only [RingHom.comp_apply] at h1
        rw [h1]
        exact RingHom.congr_fun heComm r
      exact weil_powerSeries_etale_ch_roof_to_nodalRoof Ω C g hSmK x h hh D v_D e_C q
        hEt_eC hEtq hvD_x hvDXi hvDX hCommEq
  obtain ⟨r₀, pts₀, mults₀, hInj, hMults, hRest⟩ :=
    weil_powerSeries_nodalRoof_dichotomy_finite_singular Ω C g hStab.2.2.1 hDich
  refine ⟨r₀, pts₀, mults₀,
    hInt, hStab.2.1, hStab.2.2.1, hStab.2.2.2.1, hStab.2.2.2.2.1,
    hSmK, hStab.2.2.2.2.2.1, hStab.2.2.2.2.2.2.1, hStab.2.2.2.2.2.2.2.1,
    CategoryTheory.Category.id_comp g,
    fun j => CategoryTheory.Category.comp_id (τ j),
    inferInstance, inferInstance, fun U => inferInstance, ?_,
    Set.finite_empty,
    fun _ hx => False.elim hx,
    ⟨⊤, Set.compl_empty.symm, inferInstance⟩,
    fun _ hx => False.elim hx,
    hInj, hMults, hRest⟩
  intro x
  simpa [AlgebraicGeometry.Scheme.Hom.id_base] using isConnected_singleton (x := x)

theorem weil_powerSeries_nodalQuotient_laurent_and_chart_algebra (Ω : Type u) [Field Ω]
    (m : ℕ) (hm : 2 ≤ m) :
    ∃ (L Laur : Type u) (instL : CommRing L) (instLaur : CommRing Laur),
      letI : CommRing L := instL
      letI : CommRing Laur := instLaur
      ∃ (p₀ p₁ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+*
          weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1))
        (p₂ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+*
          weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)))
        (ι_base : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+* L)
        (ι₀ ι₁ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1) →+* L)
        (ι₂ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)) →+* L)
        (φ_Laur : PowerSeries Ω →+* Laur) (ξ ξ_inv : Laur)
        (f_02 f_12 : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1) →+* Laur)
        (f_20 f_21 : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)) →+* Laur),
        IsPowerSeriesNodalBlowupRingPkg Ω m L Laur p₀ p₁ p₂ ι_base ι₀ ι₁ ι₂
          φ_Laur ξ ξ_inv f_02 f_12 f_20 f_21 :=
by
  let RStar : Type u := PowerSeries Ω
  let X_ps : RStar := PowerSeries.X
  let I_nod : Ideal (weilNodalQuot RStar (X_ps ^ m)) := Ideal.span
    {Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0),
     Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1),
     Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)}
  have hm1 : (m - 1) + 1 = m := by omega
  have hm2 : (m - 2) + 2 = m := by omega
  have hm21 : (m - 2) + 1 = m - 1 := by omega
  have hXps_m1 : X_ps ^ m = X_ps ^ (m - 1) * X_ps := by rw [← pow_succ, hm1]
  have hXps_m1_1 : X_ps ^ m = X_ps ^ (m - 1) * X_ps ^ 1 := by rw [pow_one, hXps_m1]
  have hXps_m2 : X_ps ^ m = X_ps ^ (m - 2) * X_ps ^ 2 := by rw [← pow_add, hm2]
  have hXps_m2_mul : X_ps ^ m = X_ps * (X_ps * X_ps ^ (m - 2)) := by
    rw [hXps_m2, pow_two]
    ring
  have hXps_m21 : X_ps ^ (m - 1) = X_ps ^ (m - 2) * X_ps ^ 1 := by rw [← pow_add, hm21]

  
  have nodal_rel : ∀ {R : Type u} [CommRing R] (a : R),
      Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1) =
      Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C a) := by
    intro R _ a
    have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a ∈ weilNodalIdeal R a :=
      Ideal.mem_span_singleton_self _
    have hzero : Ideal.Quotient.mk (weilNodalIdeal R a)
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rw [map_sub, map_mul] at hzero
    exact sub_eq_zero.mp hzero

  have nodal_lift_pkg : ∀ {R B : Type u} [CommRing R] [CommRing B] (a : R)
      (φ₀ : R →+* B) (x₀ x₁ : B),
      x₀ * x₁ = φ₀ a →
      ∃ g : weilNodalQuot R a →+* B,
        (∀ r : R, g (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C r)) = φ₀ r) ∧
        g (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0)) = x₀ ∧
        g (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1)) = x₁ := by
    intro R B _ _ a φ₀ x₀ x₁ hrel
    let vars : Fin 2 → B := fun i => if i = 0 then x₀ else x₁
    let ev : MvPolynomial (Fin 2) R →+* B := MvPolynomial.eval₂Hom φ₀ vars
    have hker : ∀ f ∈ weilNodalIdeal R a, ev f = 0 := by
      intro f hf
      rcases Ideal.mem_span_singleton.mp hf with ⟨q, rfl⟩
      rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C]
      have hv0 : vars 0 = x₀ := if_pos rfl
      have hv1 : vars 1 = x₁ := if_neg (by decide)
      rw [hv0, hv1, hrel, sub_self, zero_mul]
    refine ⟨Ideal.Quotient.lift (weilNodalIdeal R a) ev hker, ?_, ?_, ?_⟩
    · intro r
      change ev (MvPolynomial.C r) = φ₀ r
      exact MvPolynomial.eval₂Hom_C φ₀ vars r
    · change ev (MvPolynomial.X 0) = x₀
      rw [MvPolynomial.eval₂Hom_X']
      exact if_pos rfl
    · change ev (MvPolynomial.X 1) = x₁
      rw [MvPolynomial.eval₂Hom_X']
      exact if_neg (by decide)

  have nodalHom_ext : ∀ {R B : Type u} [CommRing R] [CommRing B] {a : R}
      {g₁ g₂ : weilNodalQuot R a →+* B},
      (∀ r : R, g₁ (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C r)) =
        g₂ (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C r))) →
      g₁ (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0)) =
        g₂ (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0)) →
      g₁ (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1)) =
        g₂ (Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1)) →
      g₁ = g₂ := by
    intro R B _ _ a g₁ g₂ hC hX0 hX1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      exact hC r
    · intro i
      fin_cases i
      · exact hX0
      · exact hX1

  
  have away_lift_pkg : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (f : A →+* B) (x : A) (v : B),
      f x * v = 1 →
      ∃ α : Localization.Away x →+* B,
        (∀ a : A, α (algebraMap A (Localization.Away x) a) = f a) ∧
        α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
    intro A B _ _ f x v hfv
    have hfx : IsUnit (f x) := isUnit_iff_exists.mpr ⟨v, hfv, by rw [mul_comm]; exact hfv⟩
    let α : Localization.Away x →+* B := IsLocalization.Away.lift x hfx
    have hα_eq : ∀ a : A, α (algebraMap A (Localization.Away x) a) = f a :=
      fun a => IsLocalization.Away.lift_eq x hfx a
    have hmul : α (algebraMap A (Localization.Away x) x *
        IsLocalization.Away.invSelf (S := Localization.Away x) x) = α 1 :=
      congrArg α (IsLocalization.Away.mul_invSelf x)
    rw [map_mul, map_one, hα_eq x] at hmul
    have hα_inv : α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
      calc α (IsLocalization.Away.invSelf (S := Localization.Away x) x)
          = (v * f x) * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) := by
            rw [mul_comm v (f x), hfv, one_mul]
        _ = v * (f x * α (IsLocalization.Away.invSelf (S := Localization.Away x) x)) := by ring
        _ = v := by rw [hmul, mul_one]
    exact ⟨α, hα_eq, hα_inv⟩

  have isLoc_of_ret : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (x : A) (f : A →+* B)
      (α : Localization.Away x →+* B) (β : B →+* Localization.Away x),
      (∀ a : A, α (algebraMap A (Localization.Away x) a) = f a) →
      (∀ a : A, β (f a) = algebraMap A (Localization.Away x) a) →
      α.comp β = RingHom.id B →
      @IsLocalization.Away A _ x B _ f.toAlgebra := by
    intro A B _ _ x f α β hα hβ hαβ
    have hβα : β.comp α = RingHom.id (Localization.Away x) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x)
      ext a
      simp only [RingHom.comp_apply, RingHom.id_apply, hα a, hβ a]
    letI : Algebra A B := f.toAlgebra
    let e_ring : Localization.Away x ≃+* B := RingEquiv.ofRingHom α β hαβ hβα
    let e_alg : Localization.Away x ≃ₐ[A] B := AlgEquiv.ofRingEquiv (f := e_ring) hα
    exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers x) e_alg

  have comp_away_isLocalization : ∀ {A C : Type u} [CommRing A] [CommRing C]
      (p : A →+* C) (d : A) (ψ : C →+* Localization.Away d),
      ψ.comp p = algebraMap A (Localization.Away d) →
      (∀ (α : Localization.Away d →+* Localization.Away (p d)),
        (∀ a : A, α (algebraMap A (Localization.Away d) a) =
          algebraMap C (Localization.Away (p d)) (p a)) →
        α (IsLocalization.Away.invSelf (S := Localization.Away d) d) =
          IsLocalization.Away.invSelf (S := Localization.Away (p d)) (p d) →
        α.comp ψ = algebraMap C (Localization.Away (p d))) →
      @IsLocalization.Away A _ d (Localization.Away (p d)) _
        ((algebraMap C (Localization.Away (p d))).comp p).toAlgebra := by
    intro A C _ _ p d ψ hψ_p h_id
    let f : A →+* Localization.Away (p d) :=
      (algebraMap C (Localization.Away (p d))).comp p
    have hf_unit : f d * IsLocalization.Away.invSelf (S := Localization.Away (p d)) (p d) = 1 :=
      IsLocalization.Away.mul_invSelf (p d)
    obtain ⟨α, hα_eq, hα_inv⟩ := away_lift_pkg f d
      (IsLocalization.Away.invSelf (S := Localization.Away (p d)) (p d)) hf_unit
    have hψ_pd : ψ (p d) = algebraMap A (Localization.Away d) d :=
      RingHom.congr_fun hψ_p d
    have hψ_unit : ψ (p d) * IsLocalization.Away.invSelf (S := Localization.Away d) d = 1 := by
      rw [hψ_pd]
      exact IsLocalization.Away.mul_invSelf d
    obtain ⟨β, hβ_eq, _⟩ := away_lift_pkg ψ (p d)
      (IsLocalization.Away.invSelf (S := Localization.Away d) d) hψ_unit
    have hα_ψ : α.comp ψ = algebraMap C (Localization.Away (p d)) :=
      h_id α hα_eq hα_inv
    have hαβ : α.comp β = RingHom.id (Localization.Away (p d)) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (p d))
      ext c
      simp only [RingHom.comp_apply, RingHom.id_apply, hβ_eq c]
      exact RingHom.congr_fun hα_ψ c
    exact isLoc_of_ret d f α β hα_eq (fun a => by
      change β (algebraMap C (Localization.Away (p d)) (p a)) = _
      rw [hβ_eq (p a)]
      exact RingHom.congr_fun hψ_p a) hαβ

  have comp_away_transfer : ∀ {A C : Type u} [CommRing A] [CommRing C]
      (p : A →+* C) (d : A),
      @IsLocalization.Away A _ d (Localization.Away (p d)) _
        ((algebraMap C (Localization.Away (p d))).comp p).toAlgebra →
      ∀ (C_loc : Type u) [CommRing C_loc] [Algebra C C_loc],
        IsLocalization.Away (p d) C_loc →
        @IsLocalization.Away A _ d C_loc _ ((algebraMap C C_loc).comp p).toAlgebra := by
    intro A C _ _ p d hLoc0 C_loc _ _ hC
    let e_C : Localization.Away (p d) ≃ₐ[C] C_loc :=
      IsLocalization.algEquiv (Submonoid.powers (p d)) (Localization.Away (p d)) C_loc
    letI : Algebra A (Localization.Away (p d)) :=
      ((algebraMap C (Localization.Away (p d))).comp p).toAlgebra
    letI : Algebra A C_loc := ((algebraMap C C_loc).comp p).toAlgebra
    let e_A : Localization.Away (p d) ≃ₐ[A] C_loc :=
      AlgEquiv.ofRingEquiv (f := e_C.toRingEquiv) (fun a => e_C.commutes (p a))
    exact @IsLocalization.isLocalization_of_algEquiv A _ (Submonoid.powers d)
      (Localization.Away (p d)) _ _ C_loc _ _ hLoc0 e_A

  
  let nfEval : ∀ {R : Type u} [CommRing R] (a : R),
      ℕ → R → (ℕ → R) → (ℕ → R) → weilNodalQuot R a :=
    fun {R} _ a N c₀ α β =>
      Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C c₀) +
      (∑ i ∈ Finset.range N,
        Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (α i)) *
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0) ^ (i + 1)) +
      (∑ j ∈ Finset.range N,
        Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (β j)) *
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1) ^ (j + 1))

  have nodal_nf_pad : ∀ {R : Type u} [CommRing R] (a : R) {M N : ℕ},
      M ≤ N → ∀ (c₀ : R) (α β : ℕ → R),
      nfEval a N c₀ (fun i => if i < M then α i else 0)
        (fun j => if j < M then β j else 0) = nfEval a M c₀ α β := by
    intro R _ a M N hMN c₀ α β
    have hsum0 : (∑ i ∈ Finset.range N,
        Ideal.Quotient.mk (weilNodalIdeal R a)
          (MvPolynomial.C (if i < M then α i else 0)) *
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0) ^ (i + 1)) =
        (∑ i ∈ Finset.range M,
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (α i)) *
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0) ^ (i + 1)) := by
      rw [← Finset.sum_subset (Finset.range_mono hMN)]
      · apply Finset.sum_congr rfl
        intro i hi
        rw [if_pos (Finset.mem_range.mp hi)]
      · intro i _ hi_not
        have hi : ¬ i < M := fun h => hi_not (Finset.mem_range.mpr h)
        rw [if_neg hi, map_zero, map_zero, zero_mul]
    have hsum1 : (∑ j ∈ Finset.range N,
        Ideal.Quotient.mk (weilNodalIdeal R a)
          (MvPolynomial.C (if j < M then β j else 0)) *
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1) ^ (j + 1)) =
        (∑ j ∈ Finset.range M,
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (β j)) *
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1) ^ (j + 1)) := by
      rw [← Finset.sum_subset (Finset.range_mono hMN)]
      · apply Finset.sum_congr rfl
        intro j hj
        rw [if_pos (Finset.mem_range.mp hj)]
      · intro j _ hj_not
        have hj : ¬ j < M := fun h => hj_not (Finset.mem_range.mpr h)
        rw [if_neg hj, map_zero, map_zero, zero_mul]
    dsimp only [nfEval]
    rw [hsum0, hsum1]

  have nodal_normal_form : ∀ {R : Type u} [CommRing R] {a : R} (x : weilNodalQuot R a),
      ∃ (N : ℕ) (c₀ : R) (α β : ℕ → R), x = nfEval a N c₀ α β := by
    intro R _ a x
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    induction p using MvPolynomial.induction_on' with
    | monomial u r =>
      let mk_a := Ideal.Quotient.mk (weilNodalIdeal R a)
      have hmon : mk_a (MvPolynomial.monomial u r) =
          mk_a (MvPolynomial.C r) *
            (mk_a (MvPolynomial.X 0) ^ (u 0) * mk_a (MvPolynomial.X 1) ^ (u 1)) := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Fin.prod_univ_two, map_mul, map_mul, map_pow, map_pow]
      have hdiag : ∀ d : ℕ,
          mk_a (MvPolynomial.X 0) ^ d * mk_a (MvPolynomial.X 1) ^ d =
            mk_a (MvPolynomial.C (a ^ d)) := by
        intro d
        rw [← mul_pow, nodal_rel a, ← map_pow, ← map_pow]
      have hc0 : Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C 0) = 0 := by
        rw [MvPolynomial.C_0, map_zero]
      rcases lt_trichotomy (u 0) (u 1) with hlt | heq | hgt
      · let j₀ : ℕ := u 1 - u 0 - 1
        have hu1 : u 1 = u 0 + (j₀ + 1) := by omega
        refine ⟨j₀ + 1, 0, fun _ => 0, fun j => if j = j₀ then r * a ^ (u 0) else 0, ?_⟩
        dsimp only [nfEval]
        have hs0 : (∑ i ∈ Finset.range (j₀ + 1),
            mk_a (MvPolynomial.C 0) * mk_a (MvPolynomial.X 0) ^ (i + 1)) = 0 := by
          simp
        have hs1 : (∑ j ∈ Finset.range (j₀ + 1),
            mk_a (MvPolynomial.C (if j = j₀ then r * a ^ (u 0) else 0)) *
              mk_a (MvPolynomial.X 1) ^ (j + 1)) =
            mk_a (MvPolynomial.C (r * a ^ (u 0))) *
              mk_a (MvPolynomial.X 1) ^ (j₀ + 1) := by
          have hcongr : ∀ j ∈ Finset.range (j₀ + 1),
              mk_a (MvPolynomial.C (if j = j₀ then r * a ^ (u 0) else 0)) *
                mk_a (MvPolynomial.X 1) ^ (j + 1) =
              if j = j₀ then
                mk_a (MvPolynomial.C (r * a ^ (u 0))) * mk_a (MvPolynomial.X 1) ^ (j + 1)
              else 0 := by
            intro j _
            by_cases hj : j = j₀
            · simp [hj]
            · simp [hj]
          rw [Finset.sum_congr rfl hcongr, Finset.sum_ite_eq',
            if_pos (Finset.mem_range.mpr (Nat.lt_succ_self j₀))]
        change mk_a (MvPolynomial.monomial u r) = _
        rw [hmon, hu1, pow_add, ← mul_assoc (mk_a (MvPolynomial.X 0) ^ (u 0)),
          hdiag (u 0), hs0, hs1, hc0, zero_add, zero_add,
          ← mul_assoc, ← map_mul, ← map_mul]
      · refine ⟨0, r * a ^ (u 0), fun _ => 0, fun _ => 0, ?_⟩
        dsimp only [nfEval]
        change mk_a (MvPolynomial.monomial u r) = _
        rw [hmon, ← heq, hdiag (u 0), Finset.range_zero, Finset.sum_empty, Finset.sum_empty,
          add_zero, add_zero, ← map_mul, ← map_mul]
      · let i₀ : ℕ := u 0 - u 1 - 1
        have hu0 : u 0 = u 1 + (i₀ + 1) := by omega
        refine ⟨i₀ + 1, 0, fun i => if i = i₀ then r * a ^ (u 1) else 0, fun _ => 0, ?_⟩
        dsimp only [nfEval]
        have hs1 : (∑ j ∈ Finset.range (i₀ + 1),
            mk_a (MvPolynomial.C 0) * mk_a (MvPolynomial.X 1) ^ (j + 1)) = 0 := by
          simp
        have hs0 : (∑ i ∈ Finset.range (i₀ + 1),
            mk_a (MvPolynomial.C (if i = i₀ then r * a ^ (u 1) else 0)) *
              mk_a (MvPolynomial.X 0) ^ (i + 1)) =
            mk_a (MvPolynomial.C (r * a ^ (u 1))) *
              mk_a (MvPolynomial.X 0) ^ (i₀ + 1) := by
          have hcongr : ∀ i ∈ Finset.range (i₀ + 1),
              mk_a (MvPolynomial.C (if i = i₀ then r * a ^ (u 1) else 0)) *
                mk_a (MvPolynomial.X 0) ^ (i + 1) =
              if i = i₀ then
                mk_a (MvPolynomial.C (r * a ^ (u 1))) * mk_a (MvPolynomial.X 0) ^ (i + 1)
              else 0 := by
            intro i _
            by_cases hi : i = i₀
            · simp [hi]
            · simp [hi]
          rw [Finset.sum_congr rfl hcongr, Finset.sum_ite_eq',
            if_pos (Finset.mem_range.mpr (Nat.lt_succ_self i₀))]
        change mk_a (MvPolynomial.monomial u r) = _
        have hpow : mk_a (MvPolynomial.X 0) ^ (u 0) * mk_a (MvPolynomial.X 1) ^ (u 1) =
            mk_a (MvPolynomial.C (a ^ (u 1))) * mk_a (MvPolynomial.X 0) ^ (i₀ + 1) := by
          calc mk_a (MvPolynomial.X 0) ^ (u 0) * mk_a (MvPolynomial.X 1) ^ (u 1)
              = (mk_a (MvPolynomial.X 0) ^ (u 1) * mk_a (MvPolynomial.X 1) ^ (u 1)) *
                  mk_a (MvPolynomial.X 0) ^ (i₀ + 1) := by rw [hu0, pow_add]; ring
            _ = mk_a (MvPolynomial.C (a ^ (u 1))) * mk_a (MvPolynomial.X 0) ^ (i₀ + 1) := by
                rw [hdiag (u 1)]
        rw [hmon, hpow, hs0, hs1, hc0, zero_add, add_zero,
          ← mul_assoc, ← map_mul, ← map_mul]
    | add p q ihp ihq =>
      obtain ⟨N₁, c₁, α₁, β₁, hp_eq⟩ := ihp
      obtain ⟨N₂, c₂, α₂, β₂, hq_eq⟩ := ihq
      let N := max N₁ N₂
      let α₁' : ℕ → R := fun i => if i < N₁ then α₁ i else 0
      let β₁' : ℕ → R := fun j => if j < N₁ then β₁ j else 0
      let α₂' : ℕ → R := fun i => if i < N₂ then α₂ i else 0
      let β₂' : ℕ → R := fun j => if j < N₂ then β₂ j else 0
      have hp' : Ideal.Quotient.mk (weilNodalIdeal R a) p = nfEval a N c₁ α₁' β₁' := by
        rw [hp_eq, ← nodal_nf_pad a (le_max_left N₁ N₂) c₁ α₁ β₁]
      have hq' : Ideal.Quotient.mk (weilNodalIdeal R a) q = nfEval a N c₂ α₂' β₂' := by
        rw [hq_eq, ← nodal_nf_pad a (le_max_right N₁ N₂) c₂ α₂ β₂]
      refine ⟨N, c₁ + c₂, fun i => α₁' i + α₂' i, fun j => β₁' j + β₂' j, ?_⟩
      rw [map_add, hp', hq']
      dsimp only [nfEval]
      have hadd0 : (∑ i ∈ Finset.range N,
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (α₁' i + α₂' i)) *
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0) ^ (i + 1)) =
          (∑ i ∈ Finset.range N,
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (α₁' i)) *
              Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0) ^ (i + 1)) +
          (∑ i ∈ Finset.range N,
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (α₂' i)) *
              Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 0) ^ (i + 1)) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro i _
        rw [map_add, map_add, add_mul]
      have hadd1 : (∑ j ∈ Finset.range N,
          Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (β₁' j + β₂' j)) *
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1) ^ (j + 1)) =
          (∑ j ∈ Finset.range N,
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (β₁' j)) *
              Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1) ^ (j + 1)) +
          (∑ j ∈ Finset.range N,
            Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.C (β₂' j)) *
              Ideal.Quotient.mk (weilNodalIdeal R a) (MvPolynomial.X 1) ^ (j + 1)) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro j _
        rw [map_add, map_add, add_mul]
      rw [hadd0, hadd1, map_add, map_add]
      ring

  
  have hX_ne : X_ps ≠ 0 := PowerSeries.X_ne_zero
  have hX_pow_nzd : Submonoid.powers X_ps ≤ nonZeroDivisors RStar :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hX_ne)
  let K_X : Type u := Localization.Away X_ps
  let η_K : RStar →+* K_X := algebraMap RStar K_X
  let X_K : K_X := η_K X_ps
  let X_K_inv : K_X := IsLocalization.Away.invSelf (S := K_X) X_ps
  have hXK_mul : X_K * X_K_inv = 1 := IsLocalization.Away.mul_invSelf X_ps
  have hXK_inv_mul : X_K_inv * X_K = 1 := by rw [mul_comm, hXK_mul]
  haveI : IsDomain K_X := IsLocalization.isDomain_of_le_nonZeroDivisors K_X hX_pow_nzd
  have hηK_inj : Function.Injective η_K := IsLocalization.injective K_X hX_pow_nzd

  have hXK_m1 : X_K ^ m = X_K ^ (m - 1) * X_K := by rw [← pow_succ, hm1]
  have hXK_m1_1 : X_K ^ m = X_K ^ (m - 1) * X_K ^ 1 := by rw [pow_one, hXK_m1]
  have hXK_1_m1 : X_K * X_K ^ (m - 1) = X_K ^ m := by rw [mul_comm, ← hXK_m1]
  have hXK_m21 : X_K ^ (m - 1) = X_K ^ (m - 2) * X_K := by rw [← pow_succ, hm21]
  have hXKi_m21 : X_K_inv ^ (m - 1) = X_K_inv ^ (m - 2) * X_K_inv := by rw [← pow_succ, hm21]

  have hPolyKX_nzd :
      Submonoid.powers (Polynomial.X : Polynomial K_X) ≤ nonZeroDivisors (Polynomial K_X) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr Polynomial.X_ne_zero)
  let L : Type u := Localization.Away (Polynomial.X : Polynomial K_X)
  let η_L : Polynomial K_X →+* L := algebraMap (Polynomial K_X) L
  let C_L : K_X →+* L := η_L.comp Polynomial.C
  let T : L := η_L Polynomial.X
  let T_inv : L := IsLocalization.Away.invSelf (S := L) (Polynomial.X : Polynomial K_X)
  have hT_mul : T * T_inv = 1 := IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial K_X)
  have hT_inv_mul : T_inv * T = 1 := by rw [mul_comm, hT_mul]
  haveI : IsDomain L := IsLocalization.isDomain_of_le_nonZeroDivisors L hPolyKX_nzd
  have hηL_inj : Function.Injective η_L := IsLocalization.injective L hPolyKX_nzd
  have hCL_inj : Function.Injective C_L := hηL_inj.comp Polynomial.C_injective

  have hPolyR_nzd :
      Submonoid.powers (Polynomial.X : Polynomial RStar) ≤ nonZeroDivisors (Polynomial RStar) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr Polynomial.X_ne_zero)
  let Laur : Type u := Localization.Away (Polynomial.X : Polynomial RStar)
  let η_Laur : Polynomial RStar →+* Laur := algebraMap (Polynomial RStar) Laur
  let φ_Laur : RStar →+* Laur := η_Laur.comp Polynomial.C
  let ξ : Laur := η_Laur Polynomial.X
  let ξ_inv : Laur := IsLocalization.Away.invSelf (S := Laur) (Polynomial.X : Polynomial RStar)
  have hξ_mul : ξ * ξ_inv = 1 := IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial RStar)
  have hξ_inv_mul : ξ_inv * ξ = 1 := by rw [mul_comm, hξ_mul]
  haveI : IsDomain Laur := IsLocalization.isDomain_of_le_nonZeroDivisors Laur hPolyR_nzd

  let laurSeries : ℕ → K_X → (ℕ → K_X) → (ℕ → K_X) → L :=
    fun N c₀ A B =>
      C_L c₀ +
      (∑ i ∈ Finset.range N, C_L (A i) * T ^ (i + 1)) +
      (∑ j ∈ Finset.range N, C_L (B j) * T_inv ^ (j + 1))

  let shiftPoly : ℕ → K_X → (ℕ → K_X) → (ℕ → K_X) → Polynomial K_X :=
    fun N c₀ A B =>
      Polynomial.C c₀ * Polynomial.X ^ N +
      (∑ i ∈ Finset.range N, Polynomial.C (A i) * Polynomial.X ^ (N + i + 1)) +
      (∑ j ∈ Finset.range N, Polynomial.C (B j) * Polynomial.X ^ (N - 1 - j))

  have laurent_poly_shift_coeff : ∀ (N : ℕ) (c₀ : K_X) (A B : ℕ → K_X),
      laurSeries N c₀ A B * T ^ N = η_L (shiftPoly N c₀ A B) ∧
      (shiftPoly N c₀ A B).coeff N = c₀ ∧
      (∀ i₀ < N, (shiftPoly N c₀ A B).coeff (N + i₀ + 1) = A i₀) ∧
      (∀ j₀ < N, (shiftPoly N c₀ A B).coeff (N - 1 - j₀) = B j₀) := by
    intro N c₀ A B
    refine ⟨?_, ?_, ?_, ?_⟩
    · dsimp only [laurSeries, shiftPoly]
      rw [add_mul, add_mul, Finset.sum_mul, Finset.sum_mul, map_add, map_add, map_sum, map_sum]
      congr 1
      · congr 1
        · change C_L c₀ * η_L Polynomial.X ^ N = η_L (Polynomial.C c₀ * Polynomial.X ^ N)
          rw [map_mul, map_pow]
          rfl
        · apply Finset.sum_congr rfl
          intro i _
          have hexp : (i + 1) + N = N + i + 1 := by omega
          calc C_L (A i) * T ^ (i + 1) * T ^ N
              = C_L (A i) * (T ^ (i + 1) * T ^ N) := by ring
            _ = C_L (A i) * T ^ (N + i + 1) := by rw [← pow_add, hexp]
            _ = η_L (Polynomial.C (A i) * Polynomial.X ^ (N + i + 1)) := by
                rw [map_mul, map_pow]; rfl
      · apply Finset.sum_congr rfl
        intro j hj
        have hj_lt : j < N := Finset.mem_range.mp hj
        have hexp : (j + 1) + (N - 1 - j) = N := by omega
        have hT_split : T ^ N = T ^ (j + 1) * T ^ (N - 1 - j) := by
          rw [← pow_add, hexp]
        have hT_cancel : T_inv ^ (j + 1) * T ^ N = T ^ (N - 1 - j) := by
          calc T_inv ^ (j + 1) * T ^ N
              = T_inv ^ (j + 1) * (T ^ (j + 1) * T ^ (N - 1 - j)) := by rw [hT_split]
            _ = (T_inv * T) ^ (j + 1) * T ^ (N - 1 - j) := by rw [← mul_assoc, ← mul_pow]
            _ = T ^ (N - 1 - j) := by rw [hT_inv_mul, one_pow, one_mul]
        calc C_L (B j) * T_inv ^ (j + 1) * T ^ N
            = C_L (B j) * (T_inv ^ (j + 1) * T ^ N) := by ring
          _ = C_L (B j) * T ^ (N - 1 - j) := by rw [hT_cancel]
          _ = η_L (Polynomial.C (B j) * Polynomial.X ^ (N - 1 - j)) := by
              rw [map_mul, map_pow]; rfl
    · dsimp only [shiftPoly]
      rw [Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.coeff_C_mul_X_pow, if_pos rfl,
        Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
      have hs1 : (∑ i ∈ Finset.range N,
          (Polynomial.C (A i) * Polynomial.X ^ (N + i + 1)).coeff N) = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
      have hs2 : (∑ j ∈ Finset.range N,
          (Polynomial.C (B j) * Polynomial.X ^ (N - 1 - j)).coeff N) = 0 := by
        apply Finset.sum_eq_zero
        intro j hj
        have hj_lt : j < N := Finset.mem_range.mp hj
        rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
      rw [hs1, hs2, add_zero, add_zero]
    · intro i₀ hi₀
      dsimp only [shiftPoly]
      rw [Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.coeff_C_mul_X_pow,
        if_neg (by omega), Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
      have hs1 : (∑ i ∈ Finset.range N,
          (Polynomial.C (A i) * Polynomial.X ^ (N + i + 1)).coeff (N + i₀ + 1)) = A i₀ := by
        have hcongr : ∀ i ∈ Finset.range N,
            (Polynomial.C (A i) * Polynomial.X ^ (N + i + 1)).coeff (N + i₀ + 1) =
              if i = i₀ then A i else 0 := by
          intro i _
          rw [Polynomial.coeff_C_mul_X_pow]
          have hiff : (N + i₀ + 1 = N + i + 1) ↔ (i = i₀) := by omega
          by_cases h : i = i₀
          · rw [if_pos (hiff.mpr h), if_pos h]
          · rw [if_neg (mt hiff.mp h), if_neg h]
        rw [Finset.sum_congr rfl hcongr, Finset.sum_ite_eq',
          if_pos (Finset.mem_range.mpr hi₀)]
      have hs2 : (∑ j ∈ Finset.range N,
          (Polynomial.C (B j) * Polynomial.X ^ (N - 1 - j)).coeff (N + i₀ + 1)) = 0 := by
        apply Finset.sum_eq_zero
        intro j hj
        have hj_lt : j < N := Finset.mem_range.mp hj
        rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
      rw [hs1, hs2, zero_add, add_zero]
    · intro j₀ hj₀
      dsimp only [shiftPoly]
      rw [Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.coeff_C_mul_X_pow,
        if_neg (by omega), Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
      have hs1 : (∑ i ∈ Finset.range N,
          (Polynomial.C (A i) * Polynomial.X ^ (N + i + 1)).coeff (N - 1 - j₀)) = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        rw [Polynomial.coeff_C_mul_X_pow, if_neg (by omega)]
      have hs2 : (∑ j ∈ Finset.range N,
          (Polynomial.C (B j) * Polynomial.X ^ (N - 1 - j)).coeff (N - 1 - j₀)) = B j₀ := by
        have hcongr : ∀ j ∈ Finset.range N,
            (Polynomial.C (B j) * Polynomial.X ^ (N - 1 - j)).coeff (N - 1 - j₀) =
              if j = j₀ then B j else 0 := by
          intro j hj
          have hj_lt : j < N := Finset.mem_range.mp hj
          rw [Polynomial.coeff_C_mul_X_pow]
          have hiff : (N - 1 - j₀ = N - 1 - j) ↔ (j = j₀) := by omega
          by_cases h : j = j₀
          · rw [if_pos (hiff.mpr h), if_pos h]
          · rw [if_neg (mt hiff.mp h), if_neg h]
        rw [Finset.sum_congr rfl hcongr, Finset.sum_ite_eq',
          if_pos (Finset.mem_range.mpr hj₀)]
      rw [hs1, hs2, add_zero, zero_add]

  
  have nodal_laurent_embed : ∀ (k : ℕ) (u₀ u₁ v₀ v₁ : K_X),
      u₀ * v₀ = 1 → u₁ * v₁ = 1 → u₀ * u₁ = X_K ^ k →
      ∃ ι_u : weilNodalQuot RStar (X_ps ^ k) →+* L,
        Function.Injective ι_u ∧
        (∀ c : RStar, ι_u (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
          (MvPolynomial.C c)) = C_L (η_K c)) ∧
        ι_u (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 0)) =
          C_L u₀ * T ∧
        ι_u (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 1)) =
          C_L u₁ * T_inv ∧
        (∀ (N : ℕ) (c₀ : RStar) (α β : ℕ → RStar),
          ι_u (nfEval (X_ps ^ k) N c₀ α β) =
            laurSeries N (η_K c₀) (fun i => η_K (α i) * u₀ ^ (i + 1))
              (fun j => η_K (β j) * u₁ ^ (j + 1))) := by
    intro k u₀ u₁ v₀ v₁ hu₀ hu₁ hprod
    have hrel_L : (C_L u₀ * T) * (C_L u₁ * T_inv) = (C_L.comp η_K) (X_ps ^ k) := by
      calc (C_L u₀ * T) * (C_L u₁ * T_inv)
          = C_L (u₀ * u₁) * (T * T_inv) := by rw [map_mul]; ring
        _ = C_L (X_K ^ k) := by rw [hprod, hT_mul, mul_one]
        _ = (C_L.comp η_K) (X_ps ^ k) := by
            simp only [RingHom.comp_apply, map_pow]; rfl
    obtain ⟨ι_u, hι_C, hι_X0, hι_X1⟩ :=
      nodal_lift_pkg (X_ps ^ k) (C_L.comp η_K) (C_L u₀ * T) (C_L u₁ * T_inv) hrel_L
    have hι_nf : ∀ (N : ℕ) (c₀ : RStar) (α β : ℕ → RStar),
        ι_u (nfEval (X_ps ^ k) N c₀ α β) =
          laurSeries N (η_K c₀) (fun i => η_K (α i) * u₀ ^ (i + 1))
            (fun j => η_K (β j) * u₁ ^ (j + 1)) := by
      intro N c₀ α β
      dsimp only [nfEval, laurSeries]
      rw [map_add, map_add, hι_C c₀, RingHom.comp_apply, map_sum, map_sum]
      congr 1
      · congr 1
        apply Finset.sum_congr rfl
        intro i _
        rw [map_mul, map_pow, hι_C (α i), RingHom.comp_apply, hι_X0, mul_pow,
          ← mul_assoc, ← map_pow, ← map_mul]
      · apply Finset.sum_congr rfl
        intro j _
        rw [map_mul, map_pow, hι_C (β j), RingHom.comp_apply, hι_X1, mul_pow,
          ← mul_assoc, ← map_pow, ← map_mul]
    have hι_inj : Function.Injective ι_u := by
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
      intro x hx
      obtain ⟨N, c₀, α, β, rfl⟩ := nodal_normal_form x
      rw [hι_nf] at hx
      let A : ℕ → K_X := fun i => η_K (α i) * u₀ ^ (i + 1)
      let B : ℕ → K_X := fun j => η_K (β j) * u₁ ^ (j + 1)
      obtain ⟨hshift, hcoeff_N, hcoeff_pos, hcoeff_neg⟩ :=
        laurent_poly_shift_coeff N (η_K c₀) A B
      have hpoly_zero : shiftPoly N (η_K c₀) A B = 0 := by
        apply hηL_inj
        rw [← hshift, hx, zero_mul, map_zero]
      have hc₀ : c₀ = 0 := by
        apply hηK_inj
        rw [← hcoeff_N, hpoly_zero, Polynomial.coeff_zero, map_zero]
      have hα : ∀ i ∈ Finset.range N, α i = 0 := by
        intro i hi
        have hAi : A i = 0 := by
          rw [← hcoeff_pos i (Finset.mem_range.mp hi), hpoly_zero, Polynomial.coeff_zero]
        apply hηK_inj
        have hmul0 : η_K (α i) * (u₀ * v₀) ^ (i + 1) = 0 := by
          calc η_K (α i) * (u₀ * v₀) ^ (i + 1)
              = (η_K (α i) * u₀ ^ (i + 1)) * v₀ ^ (i + 1) := by rw [mul_pow]; ring
            _ = A i * v₀ ^ (i + 1) := rfl
            _ = 0 := by rw [hAi, zero_mul]
        rw [hu₀, one_pow, mul_one] at hmul0
        rwa [map_zero]
      have hβ : ∀ j ∈ Finset.range N, β j = 0 := by
        intro j hj
        have hBj : B j = 0 := by
          rw [← hcoeff_neg j (Finset.mem_range.mp hj), hpoly_zero, Polynomial.coeff_zero]
        apply hηK_inj
        have hmul1 : η_K (β j) * (u₁ * v₁) ^ (j + 1) = 0 := by
          calc η_K (β j) * (u₁ * v₁) ^ (j + 1)
              = (η_K (β j) * u₁ ^ (j + 1)) * v₁ ^ (j + 1) := by rw [mul_pow]; ring
            _ = B j * v₁ ^ (j + 1) := rfl
            _ = 0 := by rw [hBj, zero_mul]
        rw [hu₁, one_pow, mul_one] at hmul1
        rwa [map_zero]
      dsimp only [nfEval]
      rw [hc₀, map_zero, map_zero, zero_add]
      have hs0 : (∑ i ∈ Finset.range N,
          Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.C (α i)) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 0) ^ (i + 1)) =
          0 := by
        apply Finset.sum_eq_zero
        intro i hi
        rw [hα i hi, map_zero, map_zero, zero_mul]
      have hs1 : (∑ j ∈ Finset.range N,
          Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.C (β j)) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k)) (MvPolynomial.X 1) ^ (j + 1)) =
          0 := by
        apply Finset.sum_eq_zero
        intro j hj
        rw [hβ j hj, map_zero, map_zero, zero_mul]
      rw [hs0, hs1, add_zero]
    exact ⟨ι_u, hι_inj, hι_C, hι_X0, hι_X1, hι_nf⟩

  have hConj4 : ∀ k : ℕ,
      IsDomain (weilNodalQuot RStar (X_ps ^ k)) ∧
      ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))).comp MvPolynomial.C).Flat ∧
      ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))).comp
        MvPolynomial.C).FinitePresentation := by
    intro k
    let P_k := weilNodalQuot RStar (X_ps ^ k)
    let f_k : RStar →+* P_k :=
      (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))).comp MvPolynomial.C
    have hu_inv : X_K ^ k * X_K_inv ^ k = 1 := by rw [← mul_pow, hXK_mul, one_pow]
    obtain ⟨ι_k, hιk_inj, hιk_C, _, _, _⟩ :=
      nodal_laurent_embed k 1 (X_K ^ k) 1 (X_K_inv ^ k) (mul_one 1) hu_inv (one_mul _)
    haveI hDom_k : IsDomain P_k := Function.Injective.isDomain ι_k hιk_inj
    have hf_k_inj : Function.Injective f_k := by
      have hcomp_inj : Function.Injective (ι_k.comp f_k) := by
        have heq : ι_k.comp f_k = C_L.comp η_K := by
          ext c
          exact hιk_C c
        rw [heq]
        exact hCL_inj.comp hηK_inj
      exact Function.Injective.of_comp hcomp_inj
    have hFlat_k : f_k.Flat := by
      have halg : (algebraMap RStar P_k : RStar →+* P_k) = f_k := RingHom.ext (fun _ => rfl)
      have hinj_alg : Function.Injective (algebraMap RStar P_k) := by
        rw [halg]
        exact hf_k_inj
      have hTF : Module.IsTorsionFree RStar P_k :=
        Module.isTorsionFree_iff_algebraMap_injective.mpr hinj_alg
      have hFlatMod : Module.Flat RStar P_k :=
        @Module.Flat.instOfIsDedekindDomainOfIsTorsionFree RStar P_k _ _ _ _ hTF
      rw [← halg]
      exact (RingHom.flat_algebraMap_iff (R := RStar) (S := P_k)).mpr hFlatMod
    have hFP_k : f_k.FinitePresentation := by
      have hFP_C : (MvPolynomial.C : RStar →+* MvPolynomial (Fin 2) RStar).FinitePresentation := by
        rw [← MvPolynomial.algebraMap_eq]
        exact RingHom.finitePresentation_algebraMap.mpr
          (inferInstance : Algebra.FinitePresentation RStar (MvPolynomial (Fin 2) RStar))
      have hFP_mk :
          (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))).FinitePresentation := by
        apply RingHom.FinitePresentation.of_surjective _ Ideal.Quotient.mk_surjective
        rw [Ideal.mk_ker]
        exact Submodule.fg_span_singleton _
      exact RingHom.FinitePresentation.comp hFP_mk hFP_C
    exact ⟨hDom_k, hFlat_k, hFP_k⟩

  
  have hXm_inv : X_K ^ m * X_K_inv ^ m = 1 := by rw [← mul_pow, hXK_mul, one_pow]
  have hX1_inv : X_K ^ 1 * X_K_inv ^ 1 = 1 := by rw [← mul_pow, hXK_mul, one_pow]
  have hXm1_inv : X_K_inv ^ (m - 1) * X_K ^ (m - 1) = 1 := by
    rw [← mul_pow, hXK_inv_mul, one_pow]
  have hprod_1 : X_K_inv ^ (m - 1) * X_K ^ m = X_K ^ 1 := by
    calc X_K_inv ^ (m - 1) * X_K ^ m
        = (X_K_inv ^ (m - 1) * X_K ^ (m - 1)) * X_K ^ 1 := by rw [hXK_m1_1]; ring
      _ = X_K ^ 1 := by rw [hXm1_inv, one_mul]
  have hXm1_pos_inv : X_K ^ (m - 1) * X_K_inv ^ (m - 1) = 1 := by
    rw [← mul_pow, hXK_mul, one_pow]
  have hprod_2 : X_K_inv * X_K ^ (m - 1) = X_K ^ (m - 2) := by
    calc X_K_inv * X_K ^ (m - 1)
        = (X_K_inv * X_K) * X_K ^ (m - 2) := by rw [hXK_m21]; ring
      _ = X_K ^ (m - 2) := by rw [hXK_inv_mul, one_mul]

  obtain ⟨ι_base, hι_base_inj, hι_base_C, hι_base_X0, hι_base_X1, hι_base_nf⟩ :=
    nodal_laurent_embed m 1 (X_K ^ m) 1 (X_K_inv ^ m) (mul_one 1) hXm_inv (one_mul _)
  obtain ⟨ι₀, hι₀_inj, hι₀_C, hι₀_X0, hι₀_X1, hι₀_nf⟩ :=
    nodal_laurent_embed 1 1 (X_K ^ 1) 1 (X_K_inv ^ 1) (mul_one 1) hX1_inv (one_mul _)
  obtain ⟨ι₁, hι₁_inj, hι₁_C, hι₁_X0, hι₁_X1, hι₁_nf⟩ :=
    nodal_laurent_embed 1 (X_K_inv ^ (m - 1)) (X_K ^ m) (X_K ^ (m - 1)) (X_K_inv ^ m)
      hXm1_inv hXm_inv hprod_1
  obtain ⟨ι₂, hι₂_inj, hι₂_C, hι₂_X0, hι₂_X1, _⟩ :=
    nodal_laurent_embed (m - 2) X_K_inv (X_K ^ (m - 1)) X_K (X_K_inv ^ (m - 1))
      hXK_inv_mul hXm1_pos_inv hprod_2

  have hp₀_rel :
      Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))
          (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 1) =
      ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp MvPolynomial.C) (X_ps ^ m) := by
    rw [map_mul, RingHom.comp_apply]
    calc Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0) *
          (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ (m - 1))) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 1))
        = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ (m - 1))) *
            (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0) *
              Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 1)) := by ring
      _ = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ (m - 1))) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ 1)) := by
          rw [nodal_rel (X_ps ^ 1)]
      _ = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ m)) := by
          rw [← map_mul, ← map_mul, ← hXps_m1_1]
  obtain ⟨p₀, hp₀_C, hp₀_X0, hp₀_X1⟩ :=
    nodal_lift_pkg (X_ps ^ m) ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp
      MvPolynomial.C)
      (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0))
      (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))
        (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 1)) hp₀_rel

  have hp₁_rel :
      Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))
          (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 1) =
      ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp MvPolynomial.C) (X_ps ^ m) := by
    rw [map_mul, RingHom.comp_apply]
    calc (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ (m - 1))) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0)) *
          Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 1)
        = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ (m - 1))) *
            (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0) *
              Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 1)) := by ring
      _ = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ (m - 1))) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ 1)) := by
          rw [nodal_rel (X_ps ^ 1)]
      _ = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.C (X_ps ^ m)) := by
          rw [← map_mul, ← map_mul, ← hXps_m1_1]
  obtain ⟨p₁, hp₁_C, hp₁_X0, hp₁_X1⟩ :=
    nodal_lift_pkg (X_ps ^ m) ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp
      MvPolynomial.C)
      (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))
        (MvPolynomial.C (X_ps ^ (m - 1)) * MvPolynomial.X 0))
      (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 1)) hp₁_rel

  have hp₂_rel :
      Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
          (MvPolynomial.C X_ps * MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
          (MvPolynomial.C X_ps * MvPolynomial.X 1) =
      ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))).comp MvPolynomial.C)
        (X_ps ^ m) := by
    rw [map_mul, map_mul, RingHom.comp_apply]
    calc (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.C X_ps) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.X 0)) *
          (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.C X_ps) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.X 1))
        = (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.X 0) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.X 1)) *
            Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.C X_ps) ^ 2 := by
          ring
      _ = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
            (MvPolynomial.C (X_ps ^ (m - 2))) *
          Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
            (MvPolynomial.C (X_ps ^ 2)) := by
          rw [nodal_rel (X_ps ^ (m - 2)), ← map_pow, ← map_pow]
      _ = Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
            (MvPolynomial.C (X_ps ^ m)) := by
          rw [← map_mul, ← map_mul, ← hXps_m2]
  obtain ⟨p₂, hp₂_C, hp₂_X0, hp₂_X1⟩ :=
    nodal_lift_pkg (X_ps ^ m) ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))).comp
      MvPolynomial.C)
      (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
        (MvPolynomial.C X_ps * MvPolynomial.X 0))
      (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
        (MvPolynomial.C X_ps * MvPolynomial.X 1)) hp₂_rel

  have hcomp₀ : ι₀.comp p₀ = ι_base := by
    apply nodalHom_ext
    · intro c
      rw [RingHom.comp_apply, hp₀_C c, RingHom.comp_apply, hι₀_C c, hι_base_C c]
    · rw [RingHom.comp_apply, hp₀_X0, hι₀_X0, hι_base_X0]
    · rw [RingHom.comp_apply, hp₀_X1, map_mul, map_mul, hι₀_C, hι₀_X1, hι_base_X1]
      have hx : η_K (X_ps ^ (m - 1)) * X_K ^ 1 = X_K ^ m := by
        rw [map_pow]
        exact hXK_m1_1.symm
      calc C_L (η_K (X_ps ^ (m - 1))) * (C_L (X_K ^ 1) * T_inv)
          = C_L (η_K (X_ps ^ (m - 1)) * X_K ^ 1) * T_inv := by rw [← mul_assoc, ← map_mul]
        _ = C_L (X_K ^ m) * T_inv := by rw [hx]

  have hcomp₁ : ι₁.comp p₁ = ι_base := by
    apply nodalHom_ext
    · intro c
      rw [RingHom.comp_apply, hp₁_C c, RingHom.comp_apply, hι₁_C c, hι_base_C c]
    · rw [RingHom.comp_apply, hp₁_X0, map_mul, map_mul, hι₁_C, hι₁_X0, hι_base_X0]
      have hx : η_K (X_ps ^ (m - 1)) * X_K_inv ^ (m - 1) = 1 := by
        rw [map_pow]
        exact hXm1_pos_inv
      calc C_L (η_K (X_ps ^ (m - 1))) * (C_L (X_K_inv ^ (m - 1)) * T)
          = C_L (η_K (X_ps ^ (m - 1)) * X_K_inv ^ (m - 1)) * T := by
            rw [← mul_assoc, ← map_mul]
        _ = C_L 1 * T := by rw [hx]
    · rw [RingHom.comp_apply, hp₁_X1, hι₁_X1, hι_base_X1]

  have hcomp₂ : ι₂.comp p₂ = ι_base := by
    apply nodalHom_ext
    · intro c
      rw [RingHom.comp_apply, hp₂_C c, RingHom.comp_apply, hι₂_C c, hι_base_C c]
    · rw [RingHom.comp_apply, hp₂_X0, map_mul, map_mul, hι₂_C, hι₂_X0, hι_base_X0]
      calc C_L (η_K X_ps) * (C_L X_K_inv * T)
          = C_L (X_K * X_K_inv) * T := by rw [← mul_assoc, ← map_mul]
        _ = C_L 1 * T := by rw [hXK_mul]
    · rw [RingHom.comp_apply, hp₂_X1, map_mul, map_mul, hι₂_C, hι₂_X1, hι_base_X1]
      calc C_L (η_K X_ps) * (C_L (X_K ^ (m - 1)) * T_inv)
          = C_L (X_K * X_K ^ (m - 1)) * T_inv := by rw [← mul_assoc, ← map_mul]
        _ = C_L (X_K ^ m) * T_inv := by rw [hXK_1_m1]

  
  have hLoc_base :
      @IsLocalization.Away (weilNodalQuot RStar (X_ps ^ m)) _
        (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) L _
        ι_base.toAlgebra := by
    let d_X : weilNodalQuot RStar (X_ps ^ m) :=
      Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)
    let M_X : Type u := Localization.Away d_X
    let η_M : weilNodalQuot RStar (X_ps ^ m) →+* M_X :=
      algebraMap (weilNodalQuot RStar (X_ps ^ m)) M_X
    let d_X_inv : M_X := IsLocalization.Away.invSelf (S := M_X) d_X
    have hd_mul : η_M d_X * d_X_inv = 1 := IsLocalization.Away.mul_invSelf d_X
    have hα_unit : ι_base d_X * C_L X_K_inv = 1 := by
      rw [hι_base_C X_ps, ← map_mul, hXK_mul, map_one]
    obtain ⟨α, hα_eq, _⟩ := away_lift_pkg ι_base d_X (C_L X_K_inv) hα_unit
    have hκ_unit :
        (η_M.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp
          MvPolynomial.C)) X_ps * d_X_inv = 1 := hd_mul
    obtain ⟨κ, hκ_eq, _⟩ :=
      away_lift_pkg
        (η_M.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp MvPolynomial.C))
        X_ps d_X_inv hκ_unit
    have hβ_unit :
        (Polynomial.eval₂RingHom κ
          (η_M (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0))))
