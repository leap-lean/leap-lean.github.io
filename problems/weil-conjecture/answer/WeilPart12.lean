      have h_inc : (TopologicalSpace.Opens.map fst.base).map (incY U₀) = incP U₀ :=
        Subsingleton.elim _ _
      rw [hnat, h_inc, h_top_comm r]
      rfl
    let γ_alg : ∀ U₀ : Y.Opens, ↑B →ₐ[↑S] AP U₀ :=
      fun U₀ => { γP U₀ with commutes' := fun _ => rfl }
    let fst_alg : ∀ U₀ : Y.Opens, AY U₀ →ₐ[↑S] AP U₀ :=
      fun U₀ => { (fst.app U₀).hom with commutes' := h_fst_comm U₀ }
    let μ_alg : ∀ U₀ : Y.Opens, TensorProduct ↑S ↑B (AY U₀) →ₐ[↑S] AP U₀ :=
