            congr 1
            change ((Y.presheaf.map (incY U₀).op ≫
              Y.presheaf.map (CategoryTheory.homOfLE h).op).hom) (u_Y r) = _
            rw [← Functor.map_comp, ← op_comp]
            have h_sub : CategoryTheory.homOfLE h ≫ incY U₀ = incY U₁ := Subsingleton.elim _ _
