    intro L₀ L' _ _ _ _ _ _ θ _ hFlat hMaxMap hResSurj u v hSpan hu_inj hv_reg
    have hSpanPair : ∀ {R : Type u} [CommRing R] (x y m : R),
        m ∈ Ideal.span ({x, y} : Set R) → ∃ r₁ r₂ : R, m = r₁ * x + r₂ * y := by
      intro R _ x y m hm
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hm
      · intro z hz
        rcases Set.mem_insert_iff.mp hz with rfl | hz'
        · exact ⟨1, 0, by ring⟩
        · rcases Set.mem_singleton_iff.mp hz' with rfl
          exact ⟨0, 1, by ring⟩
      · exact ⟨0, 0, by ring⟩
      · rintro m₁ m₂ _ _ ⟨a₁, b₁, rfl⟩ ⟨a₂, b₂, rfl⟩
