      have hunit_cancel : (r' - algebraMap D (Localization.Away f) (φ_D (PowerSeries.C c))) *
          algebraMap D (Localization.Away f) (f ^ k) * ↑(hu_fk.unit⁻¹) =
          r' - algebraMap D (Localization.Away f) (φ_D (PowerSeries.C c)) := by
        rw [mul_assoc]
        change _ * ((hu_fk.unit : Localization.Away f) * ↑(hu_fk.unit⁻¹)) = _
