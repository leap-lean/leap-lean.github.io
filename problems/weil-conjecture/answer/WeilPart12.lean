    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    let Y' := CategoryTheory.Limits.pullback g' s_Ω
    let Y'' := CategoryTheory.Limits.pullback (π ≫ g') s_Ω
    let fst' := CategoryTheory.Limits.pullback.fst g' s_Ω
    let snd' := CategoryTheory.Limits.pullback.snd g' s_Ω
    let fst'' := CategoryTheory.Limits.pullback.fst (π ≫ g') s_Ω
    let hSurj_cc : Function.Surjective (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω) :=
      fun c => ⟨PowerSeries.C c, PowerSeries.constantCoeff_C c⟩
    have hs_Ω_cl : AlgebraicGeometry.IsClosedImmersion s_Ω :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω)) hSurj_cc
    have _ : AlgebraicGeometry.IsClosedImmersion fst' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g' s_Ω).flip hs_Ω_cl
    let pt_Ω : PrimeSpectrum Ω := ⟨⊥, inferInstance⟩
    have hSpec_X : ∀ p : PrimeSpectrum (PowerSeries Ω),
        PowerSeries.X ∈ p.asIdeal → p = s_Ω.base pt_Ω := by
      intro p hX
      apply PrimeSpectrum.ext
      ext f
      change f ∈ p.asIdeal ↔ PowerSeries.constantCoeff f ∈ (⊥ : Ideal Ω)
      rw [Ideal.mem_bot]
      let c : Ω := PowerSeries.constantCoeff f
      have h_dvd : PowerSeries.X ∣ f - PowerSeries.C c := by
        rw [PowerSeries.X_dvd_iff, map_sub, PowerSeries.constantCoeff_C]
        exact sub_self c
