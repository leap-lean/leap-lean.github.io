          have hm0_mem : MvPolynomial.monomial (0 : Fin 2 →₀ ℕ) (F.coeff 0) ∈ 𝒜 0 := by
            simpa using hm_mem
          exact DirectSum.decompose_of_mem_same 𝒜 hm0_mem
        · simp only [hm0, ↓reduceIte, GradedRing.proj_apply]
          have hdeg_ne : Finsupp.degree m ≠ 0 := by
            intro hdeg0
            apply hm0
            ext i
            rw [Finsupp.zero_apply]
            have hi : m i ≤ Finsupp.degree m := by
              dsimp [Finsupp.degree]
              by_cases his : i ∈ m.support
              · exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) his
              · rw [Finsupp.notMem_support_iff.mp his]
                exact Nat.zero_le _
            omega
          exact DirectSum.decompose_of_mem_ne 𝒜 hm_mem hdeg_ne
      rw [hproj_sum, Finset.sum_congr rfl hterm, Finset.sum_ite_eq' F.support 0] at hF
      simp only [h0s, ↓reduceIte] at hF
      have hc0 : F.coeff 0 = 0 := by
        have := congrArg (MvPolynomial.constantCoeff) hF
        simpa using this
      exact (MvPolynomial.mem_support_iff.mp h0s) hc0
    change F ∈ x.asHomogeneousIdeal.toIdeal
    rw [F.as_sum]
    refine Ideal.sum_mem _ fun m hm => ?_
    have hm_ne : m ≠ 0 := fun h => h0_not_supp (h ▸ hm)
    have hm01 : m 0 ≠ 0 ∨ m 1 ≠ 0 := by
      by_contra hboth
      push Not at hboth
      apply hm_ne
      ext i
      fin_cases i
      · exact hboth.1
      · exact hboth.2
    rw [MvPolynomial.monomial_eq]
    have hprod : (m.prod fun n e => (MvPolynomial.X n : A) ^ e) =
        (MvPolynomial.X 0 : A) ^ (m 0) * (MvPolynomial.X 1 : A) ^ (m 1) := by
      rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
    rw [hprod]
    apply Ideal.mul_mem_left
    rcases hm01 with h0 | h1
    · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero h0
      rw [hk, pow_succ]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hx0)
    · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero h1
      rw [hk, pow_succ]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hx1)

  have hBot_prime : (⊥ : HomogeneousIdeal 𝒜).toIdeal.IsPrime := by
    rw [HomogeneousIdeal.toIdeal_bot]
    exact Ideal.isPrime_bot
  have hBot_not_irrel : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥ := by
    intro hle
    have hX0_irrel : (MvPolynomial.X 0 : A) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne 𝒜 (hXa 0) (by decide : (1 : ℕ) ≠ 0)
    have hX0_zero : (MvPolynomial.X 0 : A) = 0 := hle hX0_irrel
    exact MvPolynomial.X_ne_zero (0 : Fin 2) hX0_zero
  let η₀ : ProjectiveSpectrum 𝒜 := ⟨⊥, hBot_prime, hBot_not_irrel⟩
  have hη₀_D : ∀ a : Fin 2, η₀ ∈ D a := by
    intro a
    refine (ProjectiveSpectrum.mem_basicOpen 𝒜 (MvPolynomial.X a) η₀).mpr ?_
    intro hmem
    have hzero : (MvPolynomial.X a : A) = 0 := hmem
    exact MvPolynomial.X_ne_zero a hzero

  
  have hChartP1 : ∀ a : Fin 2,
      ∃ (θP : CommRingCat.of (Polynomial Ω) ≅ P1.presheaf.obj (Opposite.op (D a))),
        (hDa a).fromSpec ≫ pP1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C ≫ θP.hom) := by
    intro a
    let b : Fin 2 := if a = 0 then 1 else 0
    have hba : b ≠ a := by fin_cases a <;> decide
    let Ha := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X a)
    let c0a : Ω →+* Ha :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap Ω ↥(𝒜 0))
    let ta : Ha := HomogeneousLocalization.Away.mk 𝒜 (hXa a) 1 (MvPolynomial.X b) (hXa b)
    let Φa : Polynomial Ω →+* Ha := Polynomial.eval₂RingHom c0a ta
    let εa : A →+* Polynomial Ω :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin 2 => if i = a then 1 else Polynomial.X)
    have hεa_Xa : IsUnit (εa (MvPolynomial.X a)) := by
      dsimp [εa]
      rw [MvPolynomial.eval₂Hom_X']
      simp
    let εa_loc : Localization.Away (MvPolynomial.X a : A) →+* Polynomial Ω :=
      IsLocalization.Away.lift (MvPolynomial.X a : A) hεa_Xa
    let valHom : Ha →+* Localization.Away (MvPolynomial.X a : A) :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let Ψa : Ha →+* Polynomial Ω := εa_loc.comp valHom
    have hΦ_C : ∀ c : Ω, Φa (Polynomial.C c) = c0a c := fun c => Polynomial.eval₂_C c0a ta
    have hΦ_X : Φa Polynomial.X = ta := Polynomial.eval₂_X c0a ta
    have hε_C : ∀ c : Ω, εa (MvPolynomial.C c) = Polynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C _ _ c
    have hε_Xa : εa (MvPolynomial.X a) = 1 := by
      dsimp [εa]
      rw [MvPolynomial.eval₂Hom_X']
      simp
    have hε_Xb : εa (MvPolynomial.X b) = Polynomial.X := by
      dsimp [εa]
      rw [MvPolynomial.eval₂Hom_X']
      simp [hba]
    have hεa_mk : ∀ (F : A) (k : ℕ),
        εa_loc (Localization.mk F ⟨(MvPolynomial.X a : A) ^ k, ⟨k, rfl⟩⟩) = εa F := by
      intro F k
      let sk : Submonoid.powers (MvPolynomial.X a : A) := ⟨(MvPolynomial.X a : A) ^ k, ⟨k, rfl⟩⟩
      rw [Localization.mk_eq_mk']
      have hspec := congrArg εa_loc
        (IsLocalization.mk'_spec' (Localization.Away (MvPolynomial.X a : A)) F sk)
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hspec
      have hsk1 : εa sk.1 = 1 := by
        change εa ((MvPolynomial.X a : A) ^ k) = 1
        rw [map_pow, hε_Xa, one_pow]
      rw [hsk1, one_mul] at hspec
      exact hspec
    have hLeftInv : Ψa.comp Φa = RingHom.id (Polynomial Ω) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change εa_loc (valHom (Φa (Polynomial.C c))) = Polynomial.C c
        rw [hΦ_C]
        have hval_c : valHom (c0a c) =
            algebraMap A (Localization.Away (MvPolynomial.X a : A)) (MvPolynomial.C c) := by
          change (HomogeneousLocalization.mk
            ⟨0, algebraMap Ω ↥(𝒜 0) c, 1, Submonoid.one_mem _⟩).val = Localization.mk _ 1
          rw [HomogeneousLocalization.val_mk]
          rfl
        rw [hval_c, IsLocalization.Away.lift_eq, hε_C]
      · change εa_loc (valHom (Φa Polynomial.X)) = Polynomial.X
        rw [hΦ_X]
        change εa_loc ta.val = Polynomial.X
        rw [HomogeneousLocalization.Away.val_mk, hεa_mk, hε_Xb]
    have hMkPow : ∀ (u : A) (s : Submonoid.powers (MvPolynomial.X a : A)) (n : ℕ),
        (Localization.mk u s) ^ n = Localization.mk (u ^ n) (s ^ n) := by
      intro u s n
      induction n with
      | zero => simp [Localization.mk_one]
      | succ n ih => rw [pow_succ, pow_succ, pow_succ, ih, Localization.mk_mul]
    have hMkSum : ∀ (S_fin : Finset (Fin 2 →₀ ℕ)) (g_fn : (Fin 2 →₀ ℕ) → A)
        (s : Submonoid.powers (MvPolynomial.X a : A)),
        Localization.mk (∑ i ∈ S_fin, g_fn i) s = ∑ i ∈ S_fin, Localization.mk (g_fn i) s := by
      intro S_fin g_fn s
      induction S_fin using Finset.induction_on with
      | empty => simp [Localization.mk_zero]
      | insert i S' hi ih =>
        rw [Finset.sum_insert hi, Finset.sum_insert hi, ← ih, Localization.add_mk_self]
    have hRightInv : ∀ z : Ha, Φa (Ψa z) = z := by
      intro z
      obtain ⟨k, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hXa a) z
      apply HomogeneousLocalization.val_injective
      have hΨ : Ψa (HomogeneousLocalization.Away.mk 𝒜 (hXa a) k F hF) = εa F := by
        change εa_loc (HomogeneousLocalization.Away.mk 𝒜 (hXa a) k F hF).val = εa F
        rw [HomogeneousLocalization.Away.val_mk]
        exact hεa_mk F k
      rw [hΨ, HomogeneousLocalization.Away.val_mk]
      have hF_hom : F.IsHomogeneous k := by
        have hk : k • (1 : ℕ) = k := nsmul_one k
        exact (MvPolynomial.mem_homogeneousSubmodule k F).mp (hk ▸ hF)
      let sk : Submonoid.powers (MvPolynomial.X a : A) := ⟨(MvPolynomial.X a : A) ^ k, ⟨k, rfl⟩⟩
      let s1 : Submonoid.powers (MvPolynomial.X a : A) := ⟨(MvPolynomial.X a : A) ^ 1, ⟨1, rfl⟩⟩
      let s0 : Submonoid.powers (MvPolynomial.X a : A) :=
        ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩
      have hXa_one : Localization.mk (MvPolynomial.X a : A) s1 = 1 := by
        have hs1 : s1 = s0 := Subtype.ext (pow_one _)
        rw [hs1]
        exact Localization.mk_self s0
      change valHom (Φa (εa F)) = Localization.mk F sk
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [map_sum, map_sum, map_sum, hMkSum]
      refine Finset.sum_congr rfl fun m hm => ?_
      have hm_deg : m a + m b = k := by
        have hdeg := hF_hom (MvPolynomial.mem_support_iff.mp hm)
        rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => by simp),
          Fin.sum_univ_two] at hdeg
        simp only [Pi.one_apply, smul_eq_mul, mul_one] at hdeg
        fin_cases a <;> dsimp [b] <;> omega
      have hmon_ab : MvPolynomial.monomial m (F.coeff m) =
          MvPolynomial.C (F.coeff m) * (MvPolynomial.X a : A) ^ (m a) *
            (MvPolynomial.X b : A) ^ (m b) := by
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Fin.prod_univ_two]
        fin_cases a <;> dsimp [b] <;> ring
      rw [hmon_ab]
      have hε_mon : εa (MvPolynomial.C (F.coeff m) * (MvPolynomial.X a : A) ^ (m a) *
          (MvPolynomial.X b : A) ^ (m b)) =
          Polynomial.C (F.coeff m) * Polynomial.X ^ (m b) := by
        rw [map_mul, map_mul, map_pow, map_pow, hε_C, hε_Xa, hε_Xb, one_pow, mul_one]
      rw [hε_mon, map_mul, map_pow, hΦ_C, hΦ_X, map_mul, map_pow]
      have hval_c : valHom (c0a (F.coeff m)) = Localization.mk (MvPolynomial.C (F.coeff m)) 1 := by
        change (HomogeneousLocalization.mk ⟨0, algebraMap Ω ↥(𝒜 0) (F.coeff m), 1,
          Submonoid.one_mem _⟩).val = _
        rw [HomogeneousLocalization.val_mk]
        rfl
      have hval_t : valHom ta = Localization.mk (MvPolynomial.X b) s1 := by
        change ta.val = _
        rw [HomogeneousLocalization.Away.val_mk]
      rw [hval_c, hval_t]
      calc Localization.mk (MvPolynomial.C (F.coeff m)) 1 * (Localization.mk (MvPolynomial.X b) s1) ^ (m b)
          = Localization.mk (MvPolynomial.C (F.coeff m)) 1 *
              (Localization.mk (MvPolynomial.X a : A) s1) ^ (m a) *
              (Localization.mk (MvPolynomial.X b) s1) ^ (m b) := by
            rw [hXa_one, one_pow, mul_one]
        _ = Localization.mk
              (MvPolynomial.C (F.coeff m) * (MvPolynomial.X a : A) ^ (m a) *
                (MvPolynomial.X b : A) ^ (m b))
              (1 * s1 ^ (m a) * s1 ^ (m b)) := by
            rw [hMkPow, hMkPow, Localization.mk_mul, Localization.mk_mul]
        _ = Localization.mk
              (MvPolynomial.C (F.coeff m) * (MvPolynomial.X a : A) ^ (m a) *
                (MvPolynomial.X b : A) ^ (m b)) sk := by
            congr 1
            apply Subtype.ext
            change 1 * ((MvPolynomial.X a : A) ^ 1) ^ (m a) * ((MvPolynomial.X a : A) ^ 1) ^ (m b) =
              (MvPolynomial.X a : A) ^ k
            rw [one_mul, pow_one, ← pow_add, hm_deg]
    let eHL : Polynomial Ω ≃+* Ha :=
      { toFun := Φa
        invFun := Ψa
        left_inv := fun P => RingHom.congr_fun hLeftInv P
        right_inv := hRightInv
        map_mul' := Φa.map_mul
        map_add' := Φa.map_add }
    let U_a : (AlgebraicGeometry.Proj 𝒜).Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    let hU_a : AlgebraicGeometry.IsAffineOpen U_a :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X a) (hXa a) zero_lt_one
    let σaIso : CommRingCat.of Ha ≅ (AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op U_a) :=
      AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X a) (hXa a) zero_lt_one
    let θP : CommRingCat.of (Polynomial Ω) ≅ P1.presheaf.obj (Opposite.op (D a)) :=
      eHL.toCommRingCatIso ≪≫ σaIso
    refine ⟨θP, ?_⟩
    
    have hBridge : AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X a) (hXa a) zero_lt_one =
        hU_a.fromSpec := by
      let B_f : CommRingCat.{u} := CommRingCat.of Ha
      have hg_eq : U_a.toSpecΓ ≫ AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)) =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a)
            (hXa a) zero_lt_one).hom := by
        rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom]
        let g₁ : U_a.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
          U_a.toSpecΓ ≫ AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a))
        let g₂ : U_a.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 (MvPolynomial.X a)
        change g₁ = g₂
        have happ : g₁.appTop = g₂.appTop := by
          dsimp only [g₁, g₂]
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop]
          change (AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a))).appTop ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom ≫ U_a.topIso.inv) =
            (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 (MvPolynomial.X a)).app ⊤
          rw [AlgebraicGeometry.Proj.basicOpenToSpec_app_top]
          have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
            (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a))
          rw [← Category.assoc, hnat, Category.assoc]
        let e_adj := AlgebraicGeometry.ΓSpec.adjunction.homEquiv U_a.toScheme (Opposite.op B_f)
        apply e_adj.symm.injective
        apply Quiver.Hom.unop_inj
        let φ₁ : B_f ⟶ U_a.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm g₁).unop
        let φ₂ : B_f ⟶ U_a.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm g₂).unop
        have h1 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₁
        have h2 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₂
        have hg₁ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U_a.toScheme
            (Opposite.op B_f)) φ₁.op = g₁ := e_adj.apply_symm_apply g₁
        have hg₂ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U_a.toScheme
            (Opposite.op B_f)) φ₂.op = g₂ := e_adj.apply_symm_apply g₂
        rw [hg₁] at h1
        rw [hg₂] at h2
        change φ₁ = φ₂
        rw [← h1, ← h2, happ]
      have hiso_hom : hU_a.isoSpec.hom = U_a.toSpecΓ :=
        AlgebraicGeometry.IsAffineOpen.isoSpec_hom hU_a
      have hspec_eq : AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)) =
          hU_a.isoSpec.inv ≫ (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X a)
            (hXa a) zero_lt_one).hom := by
        rw [← hiso_hom] at hg_eq
        rw [← hg_eq, Iso.inv_hom_id_assoc]
      rw [hspec_eq, ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X a)
        (hXa a) zero_lt_one, Category.assoc, Iso.hom_inv_id_assoc,
        AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
    have hθC : CommRingCat.ofHom Polynomial.C ≫ (eHL.toCommRingCatIso ≪≫ σaIso).hom =
        CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X a))) ≫
          AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change σaIso.hom.hom (Φa (Polynomial.C c)) = _
      rw [hΦ_C, AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
      rfl
    change hU_a.fromSpec ≫ (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω ↥(𝒜 0)))) =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom Polynomial.C ≫ (eHL.toCommRingCatIso ≪≫ σaIso).hom)
    rw [hθC, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
    rw [← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 (MvPolynomial.X a) (hXa a) zero_lt_one]
    simp only [← Category.assoc]
    rw [hBridge]

  
  let W : Fin 2 → E_sch.Opens := fun a => (TopologicalSpace.Opens.map isoP1.hom.base).obj (D a)
  have hW : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (W a) := fun a =>
    (hDa a).preimage_of_isIso isoP1.hom
  have hCovW : W 0 ⊔ W 1 = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : isoP1.hom.base x ∈ (⊤ : P1.Opens) := trivial
    rw [← hCovD] at hx
    exact hx
  let x₀ : ↥E_sch := isoP1.inv.base η₀
  have hx₀_W : ∀ a : Fin 2, x₀ ∈ W a := by
    intro a
    change isoP1.hom.base (isoP1.inv.base η₀) ∈ D a
    have h_inv_hom : (isoP1.inv ≫ isoP1.hom).base η₀ = η₀ := by
      rw [isoP1.inv_hom_id]
      rfl
    exact h_inv_hom.symm ▸ hη₀_D a
  let pE : E_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) := isoP1.hom ≫ pP1
  have hChartE : ∀ a : Fin 2,
      ∃ (θIso : CommRingCat.of (Polynomial Ω) ≅ E_sch.presheaf.obj (Opposite.op (W a))),
        θIso.hom.hom.comp Polynomial.C =
          (AlgebraicGeometry.Spec.preimage ((hW a).fromSpec ≫ pE)).hom := by
    intro a
    obtain ⟨θP, hθP⟩ := hChartP1 a
    have hDa_range : D a ≤ isoP1.hom.opensRange := by
      intro y _
      refine ⟨isoP1.inv.base y, ?_⟩
      change (isoP1.inv ≫ isoP1.hom).base y = y
      rw [isoP1.inv_hom_id]
      rfl
    have _ : CategoryTheory.IsIso (isoP1.hom.app (D a)) :=
      AlgebraicGeometry.Scheme.Hom.isIso_app isoP1.hom (D a) hDa_range
    let θIso : CommRingCat.of (Polynomial Ω) ≅ E_sch.presheaf.obj (Opposite.op (W a)) :=
      θP ≪≫ asIso (isoP1.hom.app (D a))
    refine ⟨θIso, ?_⟩
    have hSpecApp : AlgebraicGeometry.Spec.map (isoP1.hom.app (D a)) ≫ (hDa a).fromSpec =
        (hW a).fromSpec ≫ isoP1.hom := by
      have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
        isoP1.hom (hDa a) (hW a) (le_refl (W a))
      rwa [AlgebraicGeometry.Scheme.Hom.appLE_eq_app] at h1
    have hComp : (hW a).fromSpec ≫ pE =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C ≫ θIso.hom) := by
      calc (hW a).fromSpec ≫ pE
          = ((hW a).fromSpec ≫ isoP1.hom) ≫ pP1 := (Category.assoc _ _ _).symm
        _ = (AlgebraicGeometry.Spec.map (isoP1.hom.app (D a)) ≫ (hDa a).fromSpec) ≫ pP1 := by
            rw [← hSpecApp]
        _ = AlgebraicGeometry.Spec.map (isoP1.hom.app (D a)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C ≫ θP.hom) := by
            rw [Category.assoc, hθP]
        _ = AlgebraicGeometry.Spec.map
              ((CommRingCat.ofHom Polynomial.C ≫ θP.hom) ≫ isoP1.hom.app (D a)) := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C ≫ θIso.hom) := by
            simp [θIso, Category.assoc]
    rw [hComp, AlgebraicGeometry.Spec.preimage_map]
    rfl
  choose θIso hθ_C using hChartE
  let θ : ∀ a : Fin 2, Polynomial Ω ≃+* ↑(E_sch.presheaf.obj (Opposite.op (W a))) :=
    fun a => (θIso a).commRingCatIsoToRingEquiv

  
  let φ_chart : ∀ a : Fin 2,
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶ E_sch :=
    fun a => AlgebraicGeometry.Spec.map (θIso a).inv ≫ (hW a).fromSpec
  have hφ_range : ∀ a : Fin 2, Set.range (φ_chart a).base = (W a : Set ↥E_sch) := by
    intro a
    have hSurjSpec : Function.Surjective (AlgebraicGeometry.Spec.map (θIso a).inv).base := by
      intro q
      refine ⟨(AlgebraicGeometry.Spec.map (θIso a).hom).base q, ?_⟩
      change (AlgebraicGeometry.Spec.map (θIso a).hom ≫
        AlgebraicGeometry.Spec.map (θIso a).inv).base q = q
      rw [← AlgebraicGeometry.Spec.map_comp, (θIso a).inv_hom_id, AlgebraicGeometry.Spec.map_id]
      rfl
    change Set.range ((hW a).fromSpec.base ∘
      (AlgebraicGeometry.Spec.map (θIso a).inv).base) = (W a : Set ↥E_sch)
    rw [Set.range_comp, hSurjSpec.range_eq, Set.image_univ]
    exact congrArg SetLike.coe (hW a).opensRange_fromSpec

  
  have hPreirredW : ∀ a : Fin 2, IsPreirreducible (W a : Set ↥E_sch) := by
    intro a
    have _ : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))) :=
      PrimeSpectrum.irreducibleSpace
    have hImg : (φ_chart a).base '' Set.univ = (W a : Set ↥E_sch) := by
      rw [Set.image_univ, hφ_range a]
    rw [← hImg]
    exact PreirreducibleSpace.isPreirreducible_univ.image
      (φ_chart a).base (φ_chart a).continuous.continuousOn
  have hPreirredUniv : IsPreirreducible (Set.univ : Set ↥E_sch) := by
    intro u v hu hv ⟨yu, _, hyu⟩ ⟨yv, _, hyv⟩
    have hyu_cov : yu ∈ (W 0 ⊔ W 1 : E_sch.Opens) := by rw [hCovW]; trivial
    have hyv_cov : yv ∈ (W 0 ⊔ W 1 : E_sch.Opens) := by rw [hCovW]; trivial
    obtain ⟨a, hya⟩ : ∃ a : Fin 2, yu ∈ W a := by
      rcases hyu_cov with h0 | h1
      · exact ⟨0, h0⟩
      · exact ⟨1, h1⟩
    obtain ⟨b, hyb⟩ : ∃ b : Fin 2, yv ∈ W b := by
      rcases hyv_cov with h0 | h1
      · exact ⟨0, h0⟩
      · exact ⟨1, h1⟩
    have hWa_u_Wb : ((W a : Set ↥E_sch) ∩ (u ∩ (W b : Set ↥E_sch))).Nonempty :=
      hPreirredW a u (W b : Set ↥E_sch) hu (W b).isOpen ⟨yu, hya, hyu⟩ ⟨x₀, hx₀_W a, hx₀_W b⟩
    obtain ⟨z, _, hzu, hzb⟩ := hWa_u_Wb
    obtain ⟨w, _, hwu, hwv⟩ := hPreirredW b u v hu hv ⟨z, hzb, hzu⟩ ⟨yv, hyb, hyv⟩
    exact ⟨w, trivial, hwu, hwv⟩
  have _ : PreirreducibleSpace ↥E_sch := ⟨hPreirredUniv⟩
  have _ : IrreducibleSpace ↥E_sch := ⟨⟨x₀⟩⟩

  refine ⟨?_, ?_⟩
  · 
    intro Z hZ_cl hZ_ne
    have hSpecFin : ∀ (Z₀ : Set (PrimeSpectrum (Polynomial Ω))),
        IsClosed Z₀ → Z₀ ≠ Set.univ → Z₀.Finite := by
      intro Z₀ hCl₀ hNe₀
      obtain ⟨I, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z₀).mp hCl₀
      have hExistsNe : ∃ P ∈ I, P ≠ (0 : Polynomial Ω) := by
        by_contra hAllZero
        push Not at hAllZero
        apply hNe₀
        ext q
        simp only [Set.mem_univ, iff_true, PrimeSpectrum.mem_zeroLocus]
        intro P hP
        rw [hAllZero P hP]
        exact q.asIdeal.zero_mem
      obtain ⟨P, hPI, hP_ne⟩ := hExistsNe
      let Φ_pt : Ω → PrimeSpectrum (Polynomial Ω) := fun c =>
        ⟨RingHom.ker (Polynomial.evalRingHom c), RingHom.ker_isPrime (Polynomial.evalRingHom c)⟩
      refine ((P.roots.toFinset.finite_toSet).image Φ_pt).subset ?_
      intro q hq
      have hPq : P ∈ q.asIdeal := hq hPI
      have hq_ne_bot : q.asIdeal ≠ ⊥ := by
        intro hbot
        rw [hbot, Ideal.mem_bot] at hPq
        exact hP_ne hPq
      have _ : q.asIdeal.IsPrime := q.isPrime
      have hq_max : q.asIdeal.IsMaximal := q.isPrime.isMaximal hq_ne_bot
      obtain ⟨h, hh_span⟩ := Submodule.IsPrincipal.principal q.asIdeal
      have hq_span : q.asIdeal = Ideal.span {h} := by
        simpa [Ideal.submodule_span_eq] using hh_span
      have hh_ne : h ≠ 0 := by
        intro hh0
        apply hq_ne_bot
        rw [hq_span, hh0, Ideal.span_singleton_eq_bot]
      have hh_deg : h.degree ≠ 0 := by
        intro hdeg0
        have hC := Polynomial.eq_C_of_degree_eq_zero hdeg0
        have hc0_ne : h.coeff 0 ≠ 0 := by
          intro hc0
          rw [hC, hc0, map_zero] at hh_ne
          exact hh_ne rfl
        have hUnit : IsUnit h := by
          rw [hC]
          exact Polynomial.isUnit_C.mpr (IsUnit.mk0 _ hc0_ne)
        exact q.isPrime.ne_top (hq_span.trans (Ideal.span_singleton_eq_top.mpr hUnit))
      obtain ⟨c, hc_root⟩ := IsAlgClosed.exists_root h hh_deg
      have hle_ker : q.asIdeal ≤ RingHom.ker (Polynomial.evalRingHom c) := by
        rw [hq_span, Ideal.span_le]
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        subst hy
        exact hc_root
      have hker_ne_top : RingHom.ker (Polynomial.evalRingHom c) ≠ ⊤ :=
        (RingHom.ker_isPrime (Polynomial.evalRingHom c)).ne_top
      have hq_eq_ker : q.asIdeal = RingHom.ker (Polynomial.evalRingHom c) :=
        hq_max.eq_of_le hker_ne_top hle_ker
      have hP_root : P.IsRoot c := by
        change (Polynomial.evalRingHom c) P = 0
        rw [← RingHom.mem_ker, ← hq_eq_ker]
        exact hPq
      refine ⟨c, Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hP_ne).mpr hP_root), ?_⟩
      ext1
      exact hq_eq_ker.symm
    have hWaFin : ∀ a : Fin 2, (Z ∩ (W a : Set ↥E_sch)).Finite := by
      intro a
      let Za : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))) :=
        (φ_chart a).base ⁻¹' Z
      have hZa_cl : IsClosed Za := hZ_cl.preimage (φ_chart a).continuous
      have hZa_ne : Za ≠ Set.univ := by
        intro hZa_univ
        have hWa_sub : (W a : Set ↥E_sch) ⊆ Z := by
          rw [← hφ_range a]
          rintro _ ⟨q, rfl⟩
