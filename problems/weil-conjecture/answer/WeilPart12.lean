                algebraMap B' (Localization.AtPrime q'₀) (algebraMap R₀ B' r)
              exact Localization.localRingHom_to_map m₀ q'₀ (algebraMap R₀ B') hq'₀.symm r }
        have hFF_loc : (letI : Algebra (Localization.AtPrime m₀) (Localization.AtPrime q'₀) :=
              ψ_loc_alg.toRingHom.toAlgebra
            Module.FaithfullyFlat (Localization.AtPrime m₀) (Localization.AtPrime q'₀)) := by
          letI : Algebra (Localization.AtPrime m₀) (Localization.AtPrime q'₀) :=
            ψ_loc.toAlgebra
          have : Module.Flat (Localization.AtPrime m₀) (Localization.AtPrime q'₀) :=
            hFlat_ψloc
          have : IsLocalHom (algebraMap (Localization.AtPrime m₀) (Localization.AtPrime q'₀)) :=
            ‹IsLocalHom ψ_loc›
          exact Module.FaithfullyFlat.of_flat_of_isLocalHom
        exact (hBaseChange (Localization.AtPrime m₀) (Localization.AtPrime q'₀)
          ψ_loc_alg).2 hFF_loc hBij_q'₀
      · have h_not_le : ¬(m₀ ≤ 𝔪) := fun hle =>
          h_eq (Ideal.IsMaximal.eq_of_le hMax_m₀ hMax_𝔪.ne_top hle).symm
        obtain ⟨f, hf_m₀, hf_not_𝔪⟩ : ∃ f ∈ m₀, f ∉ 𝔪 := Set.not_subset.mp h_not_le
        have hUnits_f : ∀ y : Submonoid.powers f,
            IsUnit (algebraMap R₀ (Localization.AtPrime 𝔪) y.1) := by
          rintro ⟨_, k, rfl⟩
          exact IsLocalization.map_units (M := 𝔪.primeCompl) (Localization.AtPrime 𝔪)
            ⟨f ^ k, fun h => hf_not_𝔪 (hMax_𝔪.isPrime.mem_of_pow_mem k h)⟩
        let ψ_f : Localization.Away f →ₐ[R₀] Localization.AtPrime 𝔪 :=
          { IsLocalization.lift (M := Submonoid.powers f) (S := Localization.Away f) hUnits_f with
            commutes' := fun r =>
