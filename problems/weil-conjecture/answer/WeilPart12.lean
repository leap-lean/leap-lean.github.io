        rwa [Nat.zero_add, h_assoc_V₁] at hSm_V₁
  
  let x₀ : C' := pts i₀
  let m : ℕ := mults i₀
  let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
      MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
      Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
  let I_nod : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m) := Ideal.span
    {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
     Ideal.Quotient.mk J_m (MvPolynomial.X 1),
     Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
  let U_compl : C'.Opens := ⟨({pts i₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩
  let X_ov := CategoryTheory.Limits.pullback π_U e_U
  let α_ov := CategoryTheory.Limits.pullback.fst π_U e_U ≫ ι_tilde
  let β_ov := Φ_A'.hom ≫ CategoryTheory.Limits.pullback.fst p_m q_m
  let g_Pm : AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
          ({MvPolynomial.X 0 * MvPolynomial.X 1 -
            MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
            Set (MvPolynomial (Fin 2) (PowerSeries Ω))))) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C))
  have hMax_Inod' : I_nod.IsMaximal := hMax_Inod
  have hRes_Pm' : ∀ f : MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m, ∃ c : Ω,
      f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c)) ∈ I_nod := hRes_Pm
  have hqv'₀' : (q_m.base v'₀).asIdeal = I_nod := hqv'₀
  have hComm_eq' : e_U ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom) =
      q_m ≫ g_Pm := hComm_eq
  have : AlgebraicGeometry.Etale e_U := hEt_e
  have : AlgebraicGeometry.Etale q_m := hEt_q
  have : AlgebraicGeometry.IsOpenImmersion ι_tilde := hOpen_tilde
  have : AlgebraicGeometry.IsOpenImmersion ι_compl := hOpen_compl
  have hEt_αov : AlgebraicGeometry.Etale α_ov := inferInstance
  have hEt_βov : AlgebraicGeometry.Etale β_ov := inferInstance
  have hComm_ov : α_ov ≫ (π ≫ g') = β_ov ≫ (p_m ≫ g_Pm) := by
    have hSpec_pre : hAffU.fromSpec ≫ g' =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom) :=
      (AlgebraicGeometry.Spec.map_preimage (hAffU.fromSpec ≫ g')).symm
    calc (CategoryTheory.Limits.pullback.fst π_U e_U ≫ ι_tilde) ≫ (π ≫ g')
        = CategoryTheory.Limits.pullback.fst π_U e_U ≫ (ι_tilde ≫ π) ≫ g' := by
            simp only [CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Limits.pullback.fst π_U e_U ≫ π_U) ≫ (hAffU.fromSpec ≫ g') := by
            rw [hπ_tilde]; simp only [CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Limits.pullback.snd π_U e_U ≫ e_U) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom) := by
            conv_lhs => rw [CategoryTheory.Limits.pullback.condition, hSpec_pre]
      _ = CategoryTheory.Limits.pullback.snd π_U e_U ≫ (q_m ≫ g_Pm) := by
            rw [CategoryTheory.Category.assoc, hComm_eq']
      _ = (Φ_A'.hom ≫ CategoryTheory.Limits.pullback.snd p_m q_m) ≫ (q_m ≫ g_Pm) := by
            rw [hΦ_snd]
      _ = Φ_A'.hom ≫ (CategoryTheory.Limits.pullback.snd p_m q_m ≫ q_m) ≫ g_Pm := by
            simp only [CategoryTheory.Category.assoc]
      _ = (Φ_A'.hom ≫ CategoryTheory.Limits.pullback.fst p_m q_m) ≫ (p_m ≫ g_Pm) := by
            rw [← CategoryTheory.Limits.pullback.condition]
            simp only [CategoryTheory.Category.assoc]
  have hLift_compl : ∀ z : C'', π.base z ≠ pts i₀ →
      ∃ u : U_compl.toScheme, ι_compl.base u = z ∧ U_compl.ι.base u = π.base z := by
    intro z hz_ne
    have hz_pre : z ∈ π.base ⁻¹' (U_compl : Set C') := hz_ne
    rw [hPre_compl] at hz_pre
    obtain ⟨u, hu⟩ := hz_pre
    refine ⟨u, hu, ?_⟩
    calc U_compl.ι.base u = (ι_compl ≫ π).base u := by rw [hπ_compl]
      _ = π.base z := by change π.base (ι_compl.base u) = π.base z; rw [hu]
  have hLift_x₀ : ∀ z : C'', π.base z = pts i₀ →
      ∃ w : X_ov, α_ov.base w = z ∧ (CategoryTheory.Limits.pullback.snd π_U e_U).base w = v'₀ := by
    intro z hz_eq
    have hx₀_U : pts i₀ ∈ (U : Set C') := by
      rw [← hAffU.range_fromSpec]
      exact ⟨p_x₀, hp_x₀⟩
    have hz_pre : z ∈ π.base ⁻¹' (U : Set C') := by
      change π.base z ∈ (U : Set C')
      rwa [hz_eq]
    rw [hPre_U] at hz_pre
    obtain ⟨u_tilde, hu_tilde⟩ := hz_pre
    have hπU_eq : π_U.base u_tilde = e_U.base v'₀ := by
      rw [hev'₀]
      apply hAffU.fromSpec.isOpenEmbedding.injective
      calc hAffU.fromSpec.base (π_U.base u_tilde)
          = (π_U ≫ hAffU.fromSpec).base u_tilde := rfl
        _ = (ι_tilde ≫ π).base u_tilde := by rw [← hπ_tilde]
        _ = π.base z := by change π.base (ι_tilde.base u_tilde) = π.base z; rw [hu_tilde]
        _ = hAffU.fromSpec.base p_x₀ := by rw [hz_eq, hp_x₀]
    obtain ⟨w, hw_fst, hw_snd⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u_tilde v'₀ hπU_eq
    refine ⟨w, ?_, hw_snd⟩
    change ι_tilde.base ((CategoryTheory.Limits.pullback.fst π_U e_U).base w) = z
    rw [hw_fst, hu_tilde]
  have hLift_Mm : ∀ y : M_m, p_m.base y ∈ PrimeSpectrum.zeroLocus (I_nod : Set _) →
      ∃ w : X_ov, β_ov.base w = y ∧ π.base (α_ov.base w) = pts i₀ ∧
        (CategoryTheory.Limits.pullback.snd π_U e_U).base w = v'₀ := by
    intro y hy_zero
    have hI_le : I_nod ≤ (p_m.base y).asIdeal := hy_zero
    have hI_eq : I_nod = (p_m.base y).asIdeal :=
      hMax_Inod'.eq_of_le (p_m.base y).isPrime.ne_top hI_le
    have hpm_eq : p_m.base y = q_m.base v'₀ := by
      apply PrimeSpectrum.ext
      change (p_m.base y).asIdeal = (q_m.base v'₀).asIdeal
      rw [← hI_eq, hqv'₀']
    obtain ⟨w_m, hwm_fst, hwm_snd⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y v'₀ hpm_eq
    let w : X_ov := Φ_A'.inv.base w_m
    have hw_snd : (CategoryTheory.Limits.pullback.snd π_U e_U).base w = v'₀ := by
      calc (CategoryTheory.Limits.pullback.snd π_U e_U).base (Φ_A'.inv.base w_m)
          = (Φ_A'.inv ≫ CategoryTheory.Limits.pullback.snd π_U e_U).base w_m := rfl
        _ = (Φ_A'.inv ≫ Φ_A'.hom ≫ CategoryTheory.Limits.pullback.snd p_m q_m).base w_m := by
              rw [hΦ_snd]
        _ = (CategoryTheory.Limits.pullback.snd p_m q_m).base w_m := by
              rw [Φ_A'.inv_hom_id_assoc]
        _ = v'₀ := hwm_snd
    refine ⟨w, ?_, ?_, hw_snd⟩
    · calc β_ov.base (Φ_A'.inv.base w_m)
          = (Φ_A'.inv ≫ Φ_A'.hom ≫ CategoryTheory.Limits.pullback.fst p_m q_m).base w_m := rfl
        _ = (CategoryTheory.Limits.pullback.fst p_m q_m).base w_m := by
              rw [Φ_A'.inv_hom_id_assoc]
        _ = y := hwm_fst
    · calc π.base (α_ov.base w)
          = (CategoryTheory.Limits.pullback.fst π_U e_U ≫ (ι_tilde ≫ π)).base w := rfl
        _ = ((CategoryTheory.Limits.pullback.fst π_U e_U ≫ π_U) ≫ hAffU.fromSpec).base w := by
              rw [hπ_tilde, CategoryTheory.Category.assoc]
        _ = ((CategoryTheory.Limits.pullback.snd π_U e_U ≫ e_U) ≫ hAffU.fromSpec).base w := by
              rw [CategoryTheory.Limits.pullback.condition]
        _ = hAffU.fromSpec.base (e_U.base ((CategoryTheory.Limits.pullback.snd π_U e_U).base w)) :=
              rfl
        _ = pts i₀ := by rw [hw_snd, hev'₀, hp_x₀]
  have hInj_v'₀ : ∀ w₁ w₂ : X_ov,
      (CategoryTheory.Limits.pullback.snd π_U e_U).base w₁ = v'₀ →
      (CategoryTheory.Limits.pullback.snd π_U e_U).base w₂ = v'₀ →
      β_ov.base w₁ = β_ov.base w₂ → w₁ = w₂ := by
    intro w₁ w₂ hw₁_snd hw₂_snd hβ_eq
    let R_Pm : CommRingCat.{u} := CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ (mults i₀))} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))
    let φ_A_U := (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom
    let φ_e := (AlgebraicGeometry.Spec.preimage e_U).hom
    let φ_q : ↑R_Pm →+* ↑A' := (AlgebraicGeometry.Spec.preimage q_m).hom
    let I_nod_R : Ideal ↑R_Pm := (q_m.base v'₀).asIdeal
    have hMax_R : I_nod_R.IsMaximal := by
      change (q_m.base v'₀).asIdeal.IsMaximal
      rw [hqv'₀]
      exact hMax_Inod
    let κ_Pm_hom : CommRingCat.of (PowerSeries Ω) ⟶ R_Pm :=
      CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C)
    let c_Pm : Ω →+* ↑R_Pm := κ_Pm_hom.hom.comp PowerSeries.C
    have hRes_R : ∀ f : ↑R_Pm, ∃ c : Ω, f - c_Pm c ∈ I_nod_R := by
      intro f
      change ∃ c : Ω, f - c_Pm c ∈ (q_m.base v'₀).asIdeal
      rw [hqv'₀]
      exact hRes_Pm f
    have : Nontrivial (↑A' ⧸ v'₀.asIdeal) := Ideal.Quotient.nontrivial_iff.mpr v'₀.isPrime.ne_top
    let ι_A' : Ω →+* (↑A' ⧸ v'₀.asIdeal) :=
      (Ideal.Quotient.mk v'₀.asIdeal).comp (φ_e.comp (φ_A_U.comp PowerSeries.C))
    have hSurj_ιA' : Function.Surjective ι_A' := by
      intro q_bar
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q_bar
      obtain ⟨c, hc⟩ := hRes_A' b
      refine ⟨c, ?_⟩
      symm
      exact Ideal.Quotient.eq.mpr hc
    let e_res_A' : Ω ≃+* (↑A' ⧸ v'₀.asIdeal) :=
      RingEquiv.ofBijective ι_A' ⟨RingHom.injective ι_A', hSurj_ιA'⟩
    let α_A' : ↑A' →+* Ω := e_res_A'.symm.toRingHom.comp (Ideal.Quotient.mk v'₀.asIdeal)
    have hUniq_c_Pm : ∀ (f : ↑R_Pm) (c₁ c₂ : Ω),
        f - c_Pm c₁ ∈ I_nod_R → f - c_Pm c₂ ∈ I_nod_R → c₁ = c₂ := by
      intro f c₁ c₂ h₁ h₂
      by_contra hne
      have h_diff_ne : c₂ - c₁ ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
      have h_mem : c_Pm (c₂ - c₁) ∈ I_nod_R := by
        have h_sub := I_nod_R.sub_mem h₁ h₂
        have h_eq : (f - c_Pm c₁) - (f - c_Pm c₂) = c_Pm (c₂ - c₁) := by
          rw [map_sub]
          ring
        rwa [h_eq] at h_sub
      have h_one_mem : (1 : ↑R_Pm) ∈ I_nod_R := by
        have h_mul := I_nod_R.mul_mem_left (c_Pm (c₂ - c₁)⁻¹) h_mem
        rw [← map_mul, inv_mul_cancel₀ h_diff_ne, map_one] at h_mul
        exact h_mul
      exact hMax_R.ne_top (I_nod_R.eq_top_iff_one.mpr h_one_mem)
    let fn_Pm : ↑R_Pm → Ω := fun f => Classical.choose (hRes_R f)
    have hfn_Pm : ∀ f : ↑R_Pm, f - c_Pm (fn_Pm f) ∈ I_nod_R :=
      fun f => Classical.choose_spec (hRes_R f)
    have hfn_c : ∀ c : Ω, fn_Pm (c_Pm c) = c := fun c =>
      hUniq_c_Pm (c_Pm c) (fn_Pm (c_Pm c)) c (hfn_Pm (c_Pm c)) (by simp)
    let α_Pm : ↑R_Pm →+* Ω :=
      { toFun := fn_Pm
        map_one' := by
          have h1 : c_Pm 1 = 1 := map_one c_Pm
          rw [← h1]
          exact hfn_c 1
        map_mul' := fun x y => by
          apply hUniq_c_Pm (x * y) (fn_Pm (x * y)) (fn_Pm x * fn_Pm y) (hfn_Pm (x * y))
          have h_id : x * y - c_Pm (fn_Pm x * fn_Pm y) =
              y * (x - c_Pm (fn_Pm x)) + c_Pm (fn_Pm x) * (y - c_Pm (fn_Pm y)) := by
            rw [map_mul]
            ring
          rw [h_id]
          exact I_nod_R.add_mem (I_nod_R.mul_mem_left y (hfn_Pm x))
            (I_nod_R.mul_mem_left (c_Pm (fn_Pm x)) (hfn_Pm y))
        map_zero' := by
          have h0 : c_Pm 0 = 0 := map_zero c_Pm
          rw [← h0]
          exact hfn_c 0
        map_add' := fun x y => by
          apply hUniq_c_Pm (x + y) (fn_Pm (x + y)) (fn_Pm x + fn_Pm y) (hfn_Pm (x + y))
          have h_id : x + y - c_Pm (fn_Pm x + fn_Pm y) =
              (x - c_Pm (fn_Pm x)) + (y - c_Pm (fn_Pm y)) := by
            rw [map_add]
            ring
          rw [h_id]
          exact I_nod_R.add_mem (hfn_Pm x) (hfn_Pm y) }
    have hSurj_αPm : Function.Surjective α_Pm := fun c => ⟨c_Pm c, hfn_c c⟩
    have hComm_ring : φ_e.comp φ_A_U = φ_q.comp κ_Pm_hom.hom := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A_U ≫ AlgebraicGeometry.Spec.preimage e_U) =
          AlgebraicGeometry.Spec.map (κ_Pm_hom ≫ AlgebraicGeometry.Spec.preimage q_m) := by
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
        exact hComm_eq'
      have hCat_eq := AlgebraicGeometry.Spec.map_injective hSpec_eq
      exact RingHom.ext fun x => ConcreteCategory.congr_hom hCat_eq x
    have hComap_q_v'₀ : Ideal.comap φ_q v'₀.asIdeal = I_nod_R := by
      have hq_spec : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage q_m) = q_m :=
        AlgebraicGeometry.Spec.map_preimage q_m
      change ((AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage q_m)).base v'₀).asIdeal =
        (q_m.base v'₀).asIdeal
      rw [hq_spec]
    have hα_comp : α_A'.comp φ_q = α_Pm := by
      apply RingHom.ext
      intro f
      obtain ⟨c, hc⟩ := hRes_R f
      have h_f_Pm : α_Pm f = c :=
        hUniq_c_Pm f (fn_Pm f) c (hfn_Pm f) hc
      have h_f_A' : α_A' (φ_q f) = c := by
        have hc_v'₀ : φ_q (f - c_Pm c) ∈ v'₀.asIdeal := by
          change f - c_Pm c ∈ Ideal.comap φ_q v'₀.asIdeal
          rwa [hComap_q_v'₀]
        have h_sub : α_A' (φ_q (f - c_Pm c)) = 0 := by
          change e_res_A'.symm (Ideal.Quotient.mk v'₀.asIdeal _) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hc_v'₀, map_zero]
        have h_const_eq : φ_q (c_Pm c) = φ_e (φ_A_U (PowerSeries.C c)) :=
          (RingHom.congr_fun hComm_ring (PowerSeries.C c)).symm
        have h_c : α_A' (φ_e (φ_A_U (PowerSeries.C c))) = c :=
          e_res_A'.symm_apply_apply c
        rw [map_sub, h_const_eq, map_sub, h_c, sub_eq_zero] at h_sub
        exact h_sub
      exact h_f_A'.trans h_f_Pm.symm
    let α_Pm_cat : R_Pm ⟶ CommRingCat.of Ω := CommRingCat.ofHom α_Pm
    let s_A' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec A' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A')
    let s_Pm : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec R_Pm :=
      AlgebraicGeometry.Spec.map α_Pm_cat
    have hs_comm : s_A' ≫ q_m = s_Pm := by
      calc s_A' ≫ q_m
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A') ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage q_m) := by
            rw [AlgebraicGeometry.Spec.map_preimage]
        _ = AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Spec.preimage q_m ≫ CommRingCat.ofHom α_A') := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = s_Pm := by
            congr 1
            have h_pre : AlgebraicGeometry.Spec.preimage q_m = CommRingCat.ofHom φ_q := rfl
            rw [h_pre, ← CommRingCat.ofHom_comp, hα_comp]
    let pt_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) := ⟨⊥, inferInstance⟩
    have hs_pt : s_A'.base pt_Ω = v'₀ := by
      apply PrimeSpectrum.ext
      ext b
      change α_A' b ∈ (⊥ : Ideal Ω) ↔ b ∈ v'₀.asIdeal
      rw [Ideal.mem_bot]
      change e_res_A'.symm (Ideal.Quotient.mk v'₀.asIdeal b) = 0 ↔ b ∈ v'₀.asIdeal
      rw [map_eq_zero_iff _ e_res_A'.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    have : AlgebraicGeometry.IsClosedImmersion s_Pm :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective α_Pm_cat hSurj_αPm
    let snd_m := CategoryTheory.Limits.pullback.snd p_m q_m
    let fst_m := CategoryTheory.Limits.pullback.fst p_m q_m
    let π₁ := CategoryTheory.Limits.pullback.fst snd_m s_A'
    let π₂ := CategoryTheory.Limits.pullback.snd snd_m s_A'
    have h_pb_paste : CategoryTheory.IsPullback (π₁ ≫ fst_m) π₂ p_m s_Pm := by
      have h := (CategoryTheory.IsPullback.of_hasPullback snd_m s_A').paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback p_m q_m)
      rwa [hs_comm] at h
    have h_cl_jF : AlgebraicGeometry.IsClosedImmersion (π₁ ≫ fst_m) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        h_pb_paste.flip inferInstance
    have : AlgebraicGeometry.IsClosedImmersion (π₁ ≫ fst_m) := h_cl_jF
    let u₁ := Φ_A'.hom.base w₁
    let u₂ := Φ_A'.hom.base w₂
    have hu₁_snd : snd_m.base u₁ = s_A'.base pt_Ω := by
      calc snd_m.base (Φ_A'.hom.base w₁)
          = (Φ_A'.hom ≫ snd_m).base w₁ := rfl
        _ = (CategoryTheory.Limits.pullback.snd π_U e_U).base w₁ := by rw [hΦ_snd]
        _ = s_A'.base pt_Ω := by rw [hw₁_snd, hs_pt]
    have hu₂_snd : snd_m.base u₂ = s_A'.base pt_Ω := by
      calc snd_m.base (Φ_A'.hom.base w₂)
          = (Φ_A'.hom ≫ snd_m).base w₂ := rfl
        _ = (CategoryTheory.Limits.pullback.snd π_U e_U).base w₂ := by rw [hΦ_snd]
        _ = s_A'.base pt_Ω := by rw [hw₂_snd, hs_pt]
    obtain ⟨z₁, hz₁_π₁, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u₁ pt_Ω hu₁_snd
    obtain ⟨z₂, hz₂_π₁, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u₂ pt_Ω hu₂_snd
    have hz_eq : z₁ = z₂ := by
      apply (π₁ ≫ fst_m).isClosedEmbedding.injective
      calc (π₁ ≫ fst_m).base z₁
          = fst_m.base (π₁.base z₁) := rfl
        _ = β_ov.base w₁ := by rw [hz₁_π₁]; rfl
        _ = β_ov.base w₂ := hβ_eq
        _ = fst_m.base (π₁.base z₂) := by rw [hz₂_π₁]; rfl
        _ = (π₁ ≫ fst_m).base z₂ := rfl
    have hu_eq : u₁ = u₂ := by
      rw [← hz₁_π₁, ← hz₂_π₁, hz_eq]
    calc w₁ = (Φ_A'.hom ≫ Φ_A'.inv).base w₁ := by rw [Φ_A'.hom_inv_id]; rfl
      _ = Φ_A'.inv.base u₁ := rfl
      _ = Φ_A'.inv.base u₂ := by rw [hu_eq]
