    exact hc
  obtain ⟨hX_x₀, hx₀_cl, hxbar₀_cl, hSmBridge, U, hAffU, p_x₀, s₀, hs₀_not_v₀, α₁,
      hp_x₀, hMax_px₀, hDom_A, hNoeth_A, hX_mem, hX_ne, hFlat_A, hFinType_A,
      hRes_A, hEt_α₁, hComm_α₁, hv₁_comap⟩ :=
    h_p3 A'₀ v₀ e_C hEt_eC hv₀_x hX_v₀ hRes_v₀
  have hNonSm : ∀ V : C'.Opens, x₀ ∈ V →
      ¬AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g') := by
    intro V hx₀_V hSm
    obtain ⟨R₀, B₀, D, instR₀, instB₀, instD, e_R, ψ₀, α_D, γ_D, q_D,
        hqD_prime, hStd1, hEt_αD, hEt_γD, hComap_qD, hComm_tot⟩ := hSmBridge V hx₀_V hSm
    letI : CommRing R₀ := instR₀
    letI : CommRing B₀ := instB₀
    letI : CommRing D := instD
    haveI : q_D.IsPrime := hqD_prime
    let β_D : R_Pm ⟶ CommRingCat.of D :=
      AlgebraicGeometry.Spec.preimage q₀ ≫ CommRingCat.ofHom γ_D
    have hEt_βD : β_D.hom.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hEt_q₀_hom hEt_γD
    have hComm_D : (α_D.comp ψ₀).comp e_R.toRingHom =
        β_D.hom.comp ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) := by
      rw [hComm_tot, hPre_comm]
      rfl
    have hInod_qD : I_nod ≤ Ideal.comap β_D.hom q_D := by
      have h_comap : Ideal.comap β_D.hom q_D =
          Ideal.comap (AlgebraicGeometry.Spec.preimage q₀).hom (Ideal.comap γ_D q_D) := rfl
      rw [h_comap, hComap_qD]
      exact hInod_le_q₀
    exact hKaehlerObs R₀ B₀ D e_R ψ₀ α_D β_D q_D hStd1 hEt_αD hEt_βD hComm_D hInod_qD
  let A := ↑(C'.presheaf.obj (Opposite.op U))
  let φ_R : PowerSeries Ω →+* A := (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom
  let A'_1 := Localization.Away s₀
  have hDisj₀ : Disjoint (Submonoid.powers s₀ : Set ↑A'₀) (v₀.asIdeal : Set ↑A'₀) := by
    rw [Set.disjoint_left]
    rintro _ ⟨k, rfl⟩ hsk
    exact hs₀_not_v₀ (v₀.isPrime.mem_of_pow_mem k hsk)
  have hUnder₀ : Ideal.under (↑A'₀) (Ideal.map (algebraMap (↑A'₀) A'_1) v₀.asIdeal) = v₀.asIdeal :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s₀) A'_1 v₀.isPrime hDisj₀
  have hPrime₁ : (Ideal.map (algebraMap (↑A'₀) A'_1) v₀.asIdeal).IsPrime :=
    (IsLocalization.isPrime_iff_isPrime_disjoint (Submonoid.powers s₀) A'_1 _).mpr
      ⟨by rw [hUnder₀]; exact v₀.isPrime, by rw [hUnder₀]; exact hDisj₀⟩
  let v₁ : PrimeSpectrum A'_1 := ⟨Ideal.map (algebraMap (↑A'₀) A'_1) v₀.asIdeal, hPrime₁⟩
  have hv₁_v₀ : PrimeSpectrum.comap (algebraMap (↑A'₀) A'_1) v₁ = v₀ :=
    PrimeSpectrum.ext hUnder₀
  have hv₁_p : PrimeSpectrum.comap α₁ v₁ = p_x₀ := hv₁_comap v₁ hv₁_v₀
  let β₁_cat : R_Pm ⟶ CommRingCat.of A'_1 :=
    AlgebraicGeometry.Spec.preimage q₀ ≫ CommRingCat.ofHom (algebraMap (↑A'₀) A'_1)
  have hEt_β₁ : β₁_cat.hom.Etale := by
    haveI : Algebra.Etale (↑A'₀) A'_1 := Algebra.Etale.of_isLocalizationAway s₀
    exact RingHom.Etale.stableUnderComposition _ _ hEt_q₀_hom
      (RingHom.etale_algebraMap.mpr inferInstance)
  have hMap_β₁_le : Ideal.map β₁_cat.hom I_nod ≤ v₁.asIdeal := by
    rw [Ideal.map_le_iff_le_comap]
    have h_comap : Ideal.comap β₁_cat.hom v₁.asIdeal =
        Ideal.comap (AlgebraicGeometry.Spec.preimage q₀).hom v₀.asIdeal := by
      change Ideal.comap (AlgebraicGeometry.Spec.preimage q₀).hom (Ideal.under (↑A'₀) v₁.asIdeal) = _
      rw [hUnder₀]
    rw [h_comap]
    exact hInod_le_q₀
  obtain ⟨_, _, h₁, hh₁_not_v₁, hAway_h₁⟩ :=
    h_p2 Ω (↑R_Pm) A'_1 ι_Pm.hom I_nod β₁_cat.hom hEt_β₁ v₁ hMap_β₁_le hRes_Pm
  let A'_2 := Localization.Away h₁
  have hDisj₁ : Disjoint (Submonoid.powers h₁ : Set A'_1) (v₁.asIdeal : Set A'_1) := by
    rw [Set.disjoint_left]
    rintro _ ⟨k, rfl⟩ hhk
    exact hh₁_not_v₁ (v₁.isPrime.mem_of_pow_mem k hhk)
  have hUnder₁ : Ideal.under A'_1 (Ideal.map (algebraMap A'_1 A'_2) v₁.asIdeal) = v₁.asIdeal :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h₁) A'_2 v₁.isPrime hDisj₁
  have hPrime₂ : (Ideal.map (algebraMap A'_1 A'_2) v₁.asIdeal).IsPrime :=
    (IsLocalization.isPrime_iff_isPrime_disjoint (Submonoid.powers h₁) A'_2 _).mpr
      ⟨by rw [hUnder₁]; exact v₁.isPrime, by rw [hUnder₁]; exact hDisj₁⟩
  let v₂ : PrimeSpectrum A'_2 := ⟨Ideal.map (algebraMap A'_1 A'_2) v₁.asIdeal, hPrime₂⟩
  have hv₂_v₁ : PrimeSpectrum.comap (algebraMap A'_1 A'_2) v₂ = v₁ :=
    PrimeSpectrum.ext hUnder₁
  obtain ⟨_, hMap_β₂, _, _⟩ := hAway_h₁ A'_2 v₂ hv₂_v₁
  let α₂ : A →+* A'_2 := (algebraMap A'_1 A'_2).comp α₁
  have hEt_α₂ : α₂.Etale := by
    haveI : Algebra.Etale A'_1 A'_2 := Algebra.Etale.of_isLocalizationAway h₁
    exact RingHom.Etale.stableUnderComposition _ _ hEt_α₁
      (RingHom.etale_algebraMap.mpr inferInstance)
  let β₂_cat : R_Pm ⟶ CommRingCat.of A'_2 :=
    β₁_cat ≫ CommRingCat.ofHom (algebraMap A'_1 A'_2)
  have hEt_β₂ : β₂_cat.hom.Etale := by
    haveI : Algebra.Etale A'_1 A'_2 := Algebra.Etale.of_isLocalizationAway h₁
    exact RingHom.Etale.stableUnderComposition _ _ hEt_β₁
      (RingHom.etale_algebraMap.mpr inferInstance)
  have hv₂_p : PrimeSpectrum.comap α₂ v₂ = p_x₀ := by
    apply PrimeSpectrum.ext
    change Ideal.comap α₁ (Ideal.under A'_1 v₂.asIdeal) = p_x₀.asIdeal
    rw [hUnder₁]
    exact congrArg PrimeSpectrum.asIdeal hv₁_p
  have hMap_α₂_le : Ideal.map α₂ p_x₀.asIdeal ≤ v₂.asIdeal := by
    rw [Ideal.map_le_iff_le_comap]
    exact le_of_eq (congrArg PrimeSpectrum.asIdeal hv₂_p).symm
  obtain ⟨_, _, h₂, hh₂_not_v₂, hAway_h₂⟩ :=
    h_p2 Ω A A'_2 (φ_R.comp PowerSeries.C) p_x₀.asIdeal α₂ hEt_α₂ v₂ hMap_α₂_le hRes_A
  let A'_3 := Localization.Away h₂
  have hDisj₂ : Disjoint (Submonoid.powers h₂ : Set A'_2) (v₂.asIdeal : Set A'_2) := by
    rw [Set.disjoint_left]
    rintro _ ⟨k, rfl⟩ hhk
    exact hh₂_not_v₂ (v₂.isPrime.mem_of_pow_mem k hhk)
  have hUnder₂ : Ideal.under A'_2 (Ideal.map (algebraMap A'_2 A'_3) v₂.asIdeal) = v₂.asIdeal :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h₂) A'_3 v₂.isPrime hDisj₂
  have hPrime₃ : (Ideal.map (algebraMap A'_2 A'_3) v₂.asIdeal).IsPrime :=
    (IsLocalization.isPrime_iff_isPrime_disjoint (Submonoid.powers h₂) A'_3 _).mpr
      ⟨by rw [hUnder₂]; exact v₂.isPrime, by rw [hUnder₂]; exact hDisj₂⟩
  let A' : CommRingCat.{u} := CommRingCat.of A'_3
  let v'₀ : AlgebraicGeometry.Spec A' :=
    ⟨Ideal.map (algebraMap A'_2 A'_3) v₂.asIdeal, hPrime₃⟩
  have hv'₀_v₂ : PrimeSpectrum.comap (algebraMap A'_2 A'_3) v'₀ = v₂ :=
    PrimeSpectrum.ext hUnder₂
  obtain ⟨hMax_v'₀, hMap_α₃, hRes_A'3, hUniq_α₃⟩ := hAway_h₂ A'_3 v'₀ hv'₀_v₂
  let α₃_cat : CommRingCat.of A ⟶ A' :=
    CommRingCat.ofHom ((algebraMap A'_2 A'_3).comp α₂)
  let β₃_cat : R_Pm ⟶ A' :=
    β₂_cat ≫ CommRingCat.ofHom (algebraMap A'_2 A'_3)
  let e_U : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
    AlgebraicGeometry.Spec.map α₃_cat
  let q_m : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec R_Pm :=
    AlgebraicGeometry.Spec.map β₃_cat
  have hEt_α₃ : α₃_cat.hom.Etale := by
    haveI : Algebra.Etale A'_2 A'_3 := Algebra.Etale.of_isLocalizationAway h₂
    exact RingHom.Etale.stableUnderComposition _ _ hEt_α₂
      (RingHom.etale_algebraMap.mpr inferInstance)
  have hEt_β₃ : β₃_cat.hom.Etale := by
    haveI : Algebra.Etale A'_2 A'_3 := Algebra.Etale.of_isLocalizationAway h₂
    exact RingHom.Etale.stableUnderComposition _ _ hEt_β₂
      (RingHom.etale_algebraMap.mpr inferInstance)
  have hEt_eU : AlgebraicGeometry.Etale e_U :=
    AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_α₃
  have hEt_qm : AlgebraicGeometry.Etale q_m :=
    AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_β₃
  have hComm_eq : e_U ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R) = q_m ≫ g_Pm := by
    dsimp only [e_U, q_m, g_Pm]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    let j₁₂ : A'_1 →+* A'_2 := algebraMap A'_1 A'_2
    let j₂₃ : A'_2 →+* A'_3 := algebraMap A'_2 A'_3
    have h1 : α₁.comp φ_R =
        (algebraMap (↑A'₀) A'_1).comp
          ((AlgebraicGeometry.Spec.preimage q₀).hom.comp
            ((Ideal.Quotient.mk J_m).comp MvPolynomial.C)) := by
      rw [hComm_α₁, hPre_comm]
    apply CommRingCat.hom_ext
    ext r
    exact congrArg j₂₃ (congrArg j₁₂ (RingHom.congr_fun h1 r))
  have hev'₀ : e_U.base v'₀ = p_x₀ := by
    apply PrimeSpectrum.ext
    change Ideal.comap α₂ (Ideal.under A'_2 v'₀.asIdeal) = p_x₀.asIdeal
    rw [hUnder₂]
    exact congrArg PrimeSpectrum.asIdeal hv₂_p
  have hMap_e : Ideal.map (AlgebraicGeometry.Spec.preimage e_U).hom p_x₀.asIdeal = v'₀.asIdeal := by
    rw [AlgebraicGeometry.Spec.preimage_map]
    exact hMap_α₃
  have hMap_q : Ideal.map (AlgebraicGeometry.Spec.preimage q_m).hom I_nod = v'₀.asIdeal := by
    rw [AlgebraicGeometry.Spec.preimage_map]
    change Ideal.map ((algebraMap A'_2 A'_3).comp ((algebraMap A'_1 A'_2).comp β₁_cat.hom)) I_nod =
      Ideal.map (algebraMap A'_2 A'_3) v₂.asIdeal
    rw [← Ideal.map_map, hMap_β₂]
  have hqv'₀ : (q_m.base v'₀).asIdeal = I_nod := by
    have h_le : I_nod ≤ (q_m.base v'₀).asIdeal := by
      have h1 : Ideal.map β₃_cat.hom I_nod ≤ v'₀.asIdeal := by
        have hpre : (AlgebraicGeometry.Spec.preimage q_m).hom = β₃_cat.hom := by
          rw [AlgebraicGeometry.Spec.preimage_map]
        rw [← hpre, hMap_q]
      exact Ideal.map_le_iff_le_comap.mp h1
    exact (hMax_Inod.eq_of_le (q_m.base v'₀).isPrime.ne_top h_le).symm
  have hUniq_e : ∀ w : AlgebraicGeometry.Spec A', e_U.base w = p_x₀ → w = v'₀ := by
    intro w hw
    apply hUniq_α₃ w
    have h_id : Ideal.comap ((algebraMap A'_2 A'_3).comp α₂) w.asIdeal = p_x₀.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hw
    exact le_of_eq h_id.symm
  have hUniq_q : ∀ w : AlgebraicGeometry.Spec A',
      q_m.base w ∈ PrimeSpectrum.zeroLocus (I_nod : Set P_m) → w = v'₀ := by
    intro w hw
    have h_le_comap : I_nod ≤ Ideal.comap β₃_cat.hom w.asIdeal := hw
    have h_map_le : Ideal.map β₃_cat.hom I_nod ≤ w.asIdeal :=
      Ideal.map_le_iff_le_comap.mpr h_le_comap
    have hpre : (AlgebraicGeometry.Spec.preimage q_m).hom = β₃_cat.hom := by
      rw [AlgebraicGeometry.Spec.preimage_map]
    rw [← hpre, hMap_q] at h_map_le
    exact PrimeSpectrum.ext (hMax_v'₀.eq_of_le w.isPrime.ne_top h_map_le).symm
  have hRes_A' : ∀ b : ↑A', ∃ c : Ω,
      b - (AlgebraicGeometry.Spec.preimage e_U).hom (φ_R (PowerSeries.C c)) ∈ v'₀.asIdeal := by
    intro b
    rw [AlgebraicGeometry.Spec.preimage_map]
    exact hRes_A'3 b
  exact ⟨hNonSm, hx₀_cl, hxbar₀_cl, hX_x₀, hMax_Inod, hRes_Pm,
    U, hAffU, p_x₀, A', v'₀, e_U, q_m,
    hp_x₀, hMax_px₀, hMax_v'₀, hDom_A, hNoeth_A, hX_mem, hX_ne, hFlat_A, hFinType_A,
    hEt_eU, hEt_qm, hComm_eq, hev'₀, hqv'₀, hMap_e, hMap_q, hUniq_e, hUniq_q,
    hRes_A, hRes_A'⟩

theorem weil_powerSeries_affine_maximal_ideal_blowup (Ω : Type u) [Field Ω]
    (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
    (φ_R : PowerSeries Ω →+* A)
    (hFlat_A : φ_R.Flat)
    (hFinType_A : φ_R.FiniteType)
    (m_A : Ideal A) [m_A.IsMaximal]
    (hX_mem : φ_R PowerSeries.X ∈ m_A)
    (hX_ne : φ_R PowerSeries.X ≠ 0) :
    ∃ (U_tilde : AlgebraicGeometry.Scheme.{u})
      (π_U : U_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)),
      IsAffinePowerSeriesPointBlowup Ω φ_R m_A π_U :=
by
  
  have hPart1 :
      ∃ (d : ℕ)
        (a : Fin (d + 1) → A)
        (K_A : Type u) (_ : Field K_A)
        (ι_K : A →+* K_A)
        (C_chart : Fin (d + 1) → Type u) (_ : ∀ ℓ : Fin (d + 1), CommRing (C_chart ℓ))
        (p_chart : ∀ ℓ : Fin (d + 1), A →+* C_chart ℓ)
        (ι_chart : ∀ ℓ : Fin (d + 1), C_chart ℓ →+* K_A)
        (r_chart : ∀ ℓ : Fin (d + 1), Fin (d + 1) → C_chart ℓ),
        a 0 = φ_R PowerSeries.X ∧
        (∀ ℓ : Fin (d + 1), a ℓ ≠ 0) ∧
        Ideal.span (Set.range a) = m_A ∧
        Function.Injective ι_K ∧
        (∀ ℓ : Fin (d + 1), IsDomain (C_chart ℓ)) ∧
        (∀ ℓ : Fin (d + 1), Function.Injective (p_chart ℓ)) ∧
        (∀ ℓ : Fin (d + 1), Function.Injective (ι_chart ℓ)) ∧
        (∀ ℓ : Fin (d + 1), (ι_chart ℓ).comp (p_chart ℓ) = ι_K) ∧
        (∀ ℓ : Fin (d + 1), ((p_chart ℓ).comp φ_R).Flat) ∧
        (∀ ℓ : Fin (d + 1), ((p_chart ℓ).comp φ_R).FinitePresentation) ∧
        (∀ ℓ : Fin (d + 1), r_chart ℓ ℓ = 1) ∧
        (∀ (ℓ j : Fin (d + 1)),
          let _ : Field K_A := ‹Field K_A›
          ι_chart ℓ (r_chart ℓ j) = ι_K (a j) * (ι_K (a ℓ))⁻¹) ∧
        (∀ (ℓ j : Fin (d + 1)),
          let _ : CommRing (C_chart ℓ) := ‹∀ ℓ, CommRing (C_chart ℓ)› ℓ
          p_chart ℓ (a ℓ) * r_chart ℓ j = p_chart ℓ (a j)) ∧
        (∀ ℓ : Fin (d + 1),
          let _ : CommRing (C_chart ℓ) := ‹∀ ℓ, CommRing (C_chart ℓ)› ℓ
          Subring.closure (Set.range (p_chart ℓ) ∪ Set.range (r_chart ℓ)) = ⊤) ∧
        (∀ ℓ : Fin (d + 1),
          let _ : CommRing (C_chart ℓ) := ‹∀ ℓ, CommRing (C_chart ℓ)› ℓ
          p_chart ℓ (a ℓ) ∈ nonZeroDivisors (C_chart ℓ)) ∧
        (∀ ℓ : Fin (d + 1),
          let _ : CommRing (C_chart ℓ) := ‹∀ ℓ, CommRing (C_chart ℓ)› ℓ
          Ideal.map (p_chart ℓ) m_A = Ideal.span {p_chart ℓ (a ℓ)}) ∧
        (∀ (ℓ : Fin (d + 1)) (C_loc : Type u) [CommRing C_loc],
          let _ : CommRing (C_chart ℓ) := ‹∀ ℓ, CommRing (C_chart ℓ)› ℓ
          ∀ [Algebra (C_chart ℓ) C_loc],
            IsLocalization.Away (p_chart ℓ (a ℓ)) C_loc →
            @IsLocalization.Away A _ (a ℓ) C_loc _
              ((algebraMap (C_chart ℓ) C_loc).comp (p_chart ℓ)).toAlgebra) ∧
        (∀ (B : Type u) [CommRing B] (θ : A →+* B) (t_B : B),
          t_B ∈ nonZeroDivisors B →
          Ideal.map θ m_A = Ideal.span {t_B} →
          ∃ (b : Fin (d + 1) → B),
            Ideal.span (Set.range b) = ⊤ ∧
            ∀ (ℓ : Fin (d + 1)) (B_ℓ : Type u) [CommRing B_ℓ] [Algebra B B_ℓ],
              let _ : CommRing (C_chart ℓ) := ‹∀ ℓ, CommRing (C_chart ℓ)› ℓ
              IsLocalization.Away (b ℓ) B_ℓ →
              ∃ (lam_ℓ : C_chart ℓ →+* B_ℓ),
                lam_ℓ.comp (p_chart ℓ) = (algebraMap B B_ℓ).comp θ) := by
    classical
    obtain ⟨S₀, hS₀⟩ := IsNoetherian.noetherian m_A
    let S₁ : Finset A := insert (φ_R PowerSeries.X) (S₀.filter (fun x => x ≠ 0))
    have hX_S₁ : φ_R PowerSeries.X ∈ S₁ := Finset.mem_insert_self _ _
    have hPos_S₁ : 0 < S₁.card := Finset.card_pos.mpr ⟨_, hX_S₁⟩
    let d : ℕ := S₁.card - 1
    have hd_card : Fintype.card ↥S₁ = d + 1 := by
      rw [Fintype.card_coe]
      omega
    let e₀ : Fin (d + 1) ≃ ↥S₁ := (Fintype.equivFinOfCardEq hd_card).symm
    let k₀ : Fin (d + 1) := e₀.symm ⟨φ_R PowerSeries.X, hX_S₁⟩
    let e₁ : Fin (d + 1) ≃ ↥S₁ := (Equiv.swap 0 k₀).trans e₀
    let a : Fin (d + 1) → A := fun ℓ => (e₁ ℓ).1
    have ha0 : a 0 = φ_R PowerSeries.X := by
      change (e₀ (Equiv.swap 0 k₀ 0)).1 = φ_R PowerSeries.X
      rw [Equiv.swap_apply_left, Equiv.apply_symm_apply]
    have ha_ne : ∀ ℓ : Fin (d + 1), a ℓ ≠ 0 := by
      intro ℓ
      have hmem : a ℓ ∈ S₁ := (e₁ ℓ).2
      rcases Finset.mem_insert.mp hmem with h_eq | h_filt
      · rw [h_eq]; exact hX_ne
      · exact (Finset.mem_filter.mp h_filt).2
    have hRange_a : Set.range a = (S₁ : Set A) := by
      ext x
      constructor
      · rintro ⟨ℓ, rfl⟩
        exact (e₁ ℓ).2
      · intro hx
        exact ⟨e₁.symm ⟨x, hx⟩, by simp [a]⟩
    have ha_span : Ideal.span (Set.range a) = m_A := by
      rw [hRange_a]
      apply le_antisymm
      · rw [Ideal.span_le]
        intro x hx
        rcases Finset.mem_insert.mp hx with rfl | h_filt
        · exact hX_mem
        · rw [← hS₀]
          exact Ideal.subset_span (Finset.mem_filter.mp h_filt).1
      · rw [← hS₀, Ideal.span_le]
        intro x hx
        by_cases hx0 : x = 0
        · subst hx0; exact Submodule.zero_mem _
        · exact Ideal.subset_span (Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨hx, hx0⟩))
    let K_A : Type u := FractionRing A
    let ι_K : A →+* K_A := algebraMap A K_A
    have hinj_K : Function.Injective ι_K := IsFractionRing.injective A K_A
    have haK_ne : ∀ ℓ : Fin (d + 1), ι_K (a ℓ) ≠ 0 :=
      fun ℓ h => ha_ne ℓ (hinj_K (h.trans (map_zero _).symm))
    let ev : ∀ ℓ : Fin (d + 1), MvPolynomial (Fin (d + 1)) A →+* K_A :=
      fun ℓ => MvPolynomial.eval₂Hom ι_K (fun j => ι_K (a j) * (ι_K (a ℓ))⁻¹)
    let C_chart : Fin (d + 1) → Type u := fun ℓ => ↥(ev ℓ).range
    let instCommC : ∀ ℓ : Fin (d + 1), CommRing (C_chart ℓ) := fun ℓ => inferInstance
    let ι_chart : ∀ ℓ : Fin (d + 1), C_chart ℓ →+* K_A := fun ℓ => (ev ℓ).range.subtype
    let p_chart : ∀ ℓ : Fin (d + 1), A →+* C_chart ℓ :=
      fun ℓ => (ev ℓ).rangeRestrict.comp MvPolynomial.C
    let r_chart : ∀ ℓ : Fin (d + 1), Fin (d + 1) → C_chart ℓ :=
      fun ℓ j => (ev ℓ).rangeRestrict (MvPolynomial.X j)
    have hDom : ∀ ℓ : Fin (d + 1), IsDomain (C_chart ℓ) := fun ℓ => inferInstance
    have hInj_ι : ∀ ℓ : Fin (d + 1), Function.Injective (ι_chart ℓ) :=
      fun ℓ => Subtype.coe_injective
    have hComp_ιp : ∀ ℓ : Fin (d + 1), (ι_chart ℓ).comp (p_chart ℓ) = ι_K := by
      intro ℓ
      ext x
      change ev ℓ (MvPolynomial.C x) = ι_K x
      simp [ev]
    have hInj_p : ∀ ℓ : Fin (d + 1), Function.Injective (p_chart ℓ) := by
      intro ℓ x y hxy
      apply hinj_K
      rw [← hComp_ιp ℓ]
      simp [RingHom.comp_apply, hxy]
    have hr_diag : ∀ ℓ : Fin (d + 1), r_chart ℓ ℓ = 1 := by
      intro ℓ
      apply hInj_ι ℓ
      change ev ℓ (MvPolynomial.X ℓ) = 1
      simp [ev, mul_inv_cancel₀ (haK_ne ℓ)]
    have hr_val : ∀ (ℓ j : Fin (d + 1)),
        ι_chart ℓ (r_chart ℓ j) = ι_K (a j) * (ι_K (a ℓ))⁻¹ := by
      intro ℓ j
      change ev ℓ (MvPolynomial.X j) = _
      simp [ev]
    have hMul_ar : ∀ (ℓ j : Fin (d + 1)), p_chart ℓ (a ℓ) * r_chart ℓ j = p_chart ℓ (a j) := by
      intro ℓ j
      apply hInj_ι ℓ
      rw [map_mul, hr_val]
      have hp_val : ∀ x, ι_chart ℓ (p_chart ℓ x) = ι_K x := fun x =>
        congrFun (congrArg DFunLike.coe (hComp_ιp ℓ)) x
      rw [hp_val, hp_val]
      calc ι_K (a ℓ) * (ι_K (a j) * (ι_K (a ℓ))⁻¹)
          = ι_K (a j) * (ι_K (a ℓ) * (ι_K (a ℓ))⁻¹) := by ring
        _ = ι_K (a j) * 1 := by rw [mul_inv_cancel₀ (haK_ne ℓ)]
        _ = ι_K (a j) := mul_one _
    have hClosure : ∀ ℓ : Fin (d + 1),
        Subring.closure (Set.range (p_chart ℓ) ∪ Set.range (r_chart ℓ)) = ⊤ := by
      intro ℓ
      have hF_mem : ∀ F : MvPolynomial (Fin (d + 1)) A,
          (ev ℓ).rangeRestrict F ∈
            Subring.closure (Set.range (p_chart ℓ) ∪ Set.range (r_chart ℓ)) := by
        intro F
        induction F using MvPolynomial.induction_on with
        | C x =>
          exact Subring.subset_closure (Or.inl ⟨x, rfl⟩)
        | add F₁ F₂ ih₁ ih₂ =>
          rw [map_add]
          exact Subring.add_mem _ ih₁ ih₂
        | mul_X F₁ j ih₁ =>
          rw [map_mul]
          exact Subring.mul_mem _ ih₁ (Subring.subset_closure (Or.inr ⟨j, rfl⟩))
      rw [eq_top_iff]
      intro y _
      obtain ⟨F, rfl⟩ := RingHom.rangeRestrict_surjective (ev ℓ) y
      exact hF_mem F
    have ha_nzd : ∀ ℓ : Fin (d + 1), p_chart ℓ (a ℓ) ∈ nonZeroDivisors (C_chart ℓ) := by
      intro ℓ
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro h0
      exact ha_ne ℓ (hInj_p ℓ (h0.trans (map_zero _).symm))
    have hMap_mA : ∀ ℓ : Fin (d + 1),
        Ideal.map (p_chart ℓ) m_A = Ideal.span {p_chart ℓ (a ℓ)} := by
      intro ℓ
      rw [← ha_span, Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        exact Ideal.mem_span_singleton.mpr ⟨r_chart ℓ j, (hMul_ar ℓ j).symm⟩
      · rw [Ideal.span_singleton_le_iff_mem]
        exact Ideal.subset_span ⟨a ℓ, ⟨ℓ, rfl⟩, rfl⟩
    have hinj_φR : Function.Injective φ_R := by
      rw [injective_iff_map_eq_zero]
      intro f hf0
      by_contra hf_ne
      have hex : ∃ n : ℕ, PowerSeries.coeff n f ≠ 0 := by
        by_contra hall
        push Not at hall
        apply hf_ne
        ext n
        simpa using hall n
      let n₀ : ℕ := Nat.find hex
      have hn₀_ne : PowerSeries.coeff n₀ f ≠ 0 := Nat.find_spec hex
      have hn₀_min : ∀ m < n₀, PowerSeries.coeff m f = 0 := fun m hm => by
        by_contra hne
        exact Nat.find_min hex hm hne
      obtain ⟨g, hg⟩ := (PowerSeries.X_pow_dvd_iff).mpr hn₀_min
      have hg0 : PowerSeries.constantCoeff g ≠ 0 := by
        have h_coeff : PowerSeries.coeff n₀ (PowerSeries.X ^ n₀ * g) = PowerSeries.coeff 0 g := by
          simpa using PowerSeries.coeff_X_pow_mul g n₀ 0
        rw [hg, h_coeff] at hn₀_ne
        simpa [PowerSeries.coeff_zero_eq_constantCoeff] using hn₀_ne
      have hg_unit : IsUnit g :=
        PowerSeries.isUnit_iff_constantCoeff.mpr (IsUnit.mk0 _ hg0)
      have h_map : φ_R f = (φ_R PowerSeries.X) ^ n₀ * φ_R g := by
        rw [hg, map_mul, map_pow]
      rw [hf0] at h_map
      rcases mul_eq_zero.mp h_map.symm with hX_pow | hg_zero
      · exact pow_ne_zero n₀ hX_ne hX_pow
      · exact (hg_unit.map φ_R).ne_zero hg_zero
    have hFlat_chart : ∀ ℓ : Fin (d + 1), ((p_chart ℓ).comp φ_R).Flat := by
      intro ℓ
      let ψ_R : PowerSeries Ω →+* C_chart ℓ := (p_chart ℓ).comp φ_R
      have hinj_ψR : Function.Injective ψ_R := (hInj_p ℓ).comp hinj_φR
      let _ : Algebra (PowerSeries Ω) (C_chart ℓ) := ψ_R.toAlgebra
      have : Module.IsTorsionFree (PowerSeries Ω) (C_chart ℓ) := by
        apply Module.IsTorsionFree.of_smul_eq_zero
        intro r c hrc
        change ψ_R r * c = 0 at hrc
        rcases mul_eq_zero.mp hrc with hr | hc
        · left; exact hinj_ψR (hr.trans (map_zero _).symm)
        · right; exact hc
      change Module.Flat (PowerSeries Ω) (C_chart ℓ)
      infer_instance
    have hFP_chart : ∀ ℓ : Fin (d + 1), ((p_chart ℓ).comp φ_R).FinitePresentation := by
      intro ℓ
      have hp_FT : (p_chart ℓ).FiniteType := by
        let _ : Algebra A (C_chart ℓ) := (p_chart ℓ).toAlgebra
        let f_alg : MvPolynomial (Fin (d + 1)) A →ₐ[A] C_chart ℓ :=
          { toRingHom := (ev ℓ).rangeRestrict
            commutes' := fun _ => rfl }
        change Algebra.FiniteType A (C_chart ℓ)
        exact Algebra.FiniteType.of_surjective f_alg (RingHom.rangeRestrict_surjective (ev ℓ))
      have hcomp_FT : ((p_chart ℓ).comp φ_R).FiniteType :=
        RingHom.FiniteType.comp hp_FT hFinType_A
      exact RingHom.FinitePresentation.of_finiteType.mp hcomp_FT
    have hClear : ∀ (ℓ : Fin (d + 1)) (F : MvPolynomial (Fin (d + 1)) A),
        ∃ (N : ℕ) (r : A),
          ι_K (a ℓ) ^ N * ev ℓ F = ι_K r ∧
          ∀ (S : Type u) [CommRing S] (φ : A →+* S) (t : S) (b : Fin (d + 1) → S) (u_inv : S),
            (∀ j : Fin (d + 1), φ (a j) = t * b j) →
            b ℓ * u_inv = 1 →
            (t * b ℓ) ^ N * MvPolynomial.eval₂Hom φ (fun j => b j * u_inv) F = φ r := by
      intro ℓ F
      induction F using MvPolynomial.induction_on with
      | C r₀ =>
        refine ⟨0, r₀, ?_, ?_⟩
        · simp [ev]
        · intro S _ φ t b u_inv _ _
          simp
      | add F₁ F₂ ih₁ ih₂ =>
        obtain ⟨N₁, r₁, hK₁, hS₁⟩ := ih₁
        obtain ⟨N₂, r₂, hK₂, hS₂⟩ := ih₂
        refine ⟨N₁ + N₂, a ℓ ^ N₂ * r₁ + a ℓ ^ N₁ * r₂, ?_, ?_⟩
        · calc ι_K (a ℓ) ^ (N₁ + N₂) * ev ℓ (F₁ + F₂)
              = ι_K (a ℓ) ^ N₂ * (ι_K (a ℓ) ^ N₁ * ev ℓ F₁) +
                ι_K (a ℓ) ^ N₁ * (ι_K (a ℓ) ^ N₂ * ev ℓ F₂) := by
                  rw [map_add, pow_add]; ring
            _ = ι_K (a ℓ) ^ N₂ * ι_K r₁ + ι_K (a ℓ) ^ N₁ * ι_K r₂ := by rw [hK₁, hK₂]
            _ = ι_K (a ℓ ^ N₂ * r₁ + a ℓ ^ N₁ * r₂) := by simp [map_add, map_mul, map_pow]
        · intro S _ φ t b u_inv hφb hbu
          let Φ := MvPolynomial.eval₂Hom φ (fun j => b j * u_inv)
          calc (t * b ℓ) ^ (N₁ + N₂) * Φ (F₁ + F₂)
              = (t * b ℓ) ^ N₂ * ((t * b ℓ) ^ N₁ * Φ F₁) +
                (t * b ℓ) ^ N₁ * ((t * b ℓ) ^ N₂ * Φ F₂) := by
                  rw [map_add, pow_add]; ring
            _ = (φ (a ℓ)) ^ N₂ * φ r₁ + (φ (a ℓ)) ^ N₁ * φ r₂ := by
                  rw [hS₁ S φ t b u_inv hφb hbu, hS₂ S φ t b u_inv hφb hbu, hφb ℓ]
            _ = φ (a ℓ ^ N₂ * r₁ + a ℓ ^ N₁ * r₂) := by simp [map_add, map_mul, map_pow]
      | mul_X F₁ j ih₁ =>
        obtain ⟨N₁, r₁, hK₁, hS₁⟩ := ih₁
        refine ⟨N₁ + 1, r₁ * a j, ?_, ?_⟩
        · calc ι_K (a ℓ) ^ (N₁ + 1) * ev ℓ (F₁ * MvPolynomial.X j)
              = (ι_K (a ℓ) ^ N₁ * ev ℓ F₁) *
                (ι_K (a ℓ) * (ι_K (a j) * (ι_K (a ℓ))⁻¹)) := by
                  rw [pow_succ, map_mul]; simp [ev]; ring
            _ = ι_K r₁ * (ι_K (a j) * (ι_K (a ℓ) * (ι_K (a ℓ))⁻¹)) := by rw [hK₁]; ring
            _ = ι_K (r₁ * a j) := by
                  rw [mul_inv_cancel₀ (haK_ne ℓ), mul_one, map_mul]
        · intro S _ φ t b u_inv hφb hbu
          let Φ := MvPolynomial.eval₂Hom φ (fun j => b j * u_inv)
          calc (t * b ℓ) ^ (N₁ + 1) * Φ (F₁ * MvPolynomial.X j)
              = ((t * b ℓ) ^ N₁ * Φ F₁) * ((t * b j) * (b ℓ * u_inv)) := by
                  rw [pow_succ, map_mul]; simp [Φ]; ring
            _ = φ r₁ * (φ (a j) * 1) := by
                  rw [hS₁ S φ t b u_inv hφb hbu, ← hφb j, hbu]
            _ = φ (r₁ * a j) := by rw [mul_one, map_mul]
    have hLocAway : ∀ (ℓ : Fin (d + 1)) (C_loc : Type u) [CommRing C_loc] [Algebra (C_chart ℓ) C_loc],
        IsLocalization.Away (p_chart ℓ (a ℓ)) C_loc →
        @IsLocalization.Away A _ (a ℓ) C_loc _
          ((algebraMap (C_chart ℓ) C_loc).comp (p_chart ℓ)).toAlgebra := by
      intro ℓ C_loc _ _ hLocC
      let φ_loc : A →+* C_loc := (algebraMap (C_chart ℓ) C_loc).comp (p_chart ℓ)
      let _ : Algebra A C_loc := φ_loc.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        change IsUnit (algebraMap (C_chart ℓ) C_loc (p_chart ℓ (a ℓ ^ k)))
        rw [map_pow, map_pow]
        exact (IsLocalization.Away.algebraMap_isUnit (p_chart ℓ (a ℓ))).pow k
      · intro z
        obtain ⟨⟨c, _, k, rfl⟩, hzc⟩ :=
          IsLocalization.surj (Submonoid.powers (p_chart ℓ (a ℓ))) z
        obtain ⟨F, rfl⟩ := RingHom.rangeRestrict_surjective (ev ℓ) c
        obtain ⟨N, r, hKr, _⟩ := hClear ℓ F
        have hCr : p_chart ℓ (a ℓ) ^ N * (ev ℓ).rangeRestrict F = p_chart ℓ r := by
          apply hInj_ι ℓ
          have hp_val : ∀ x, ι_chart ℓ (p_chart ℓ x) = ι_K x := fun x =>
            congrFun (congrArg DFunLike.coe (hComp_ιp ℓ)) x
          rw [map_mul, map_pow, hp_val, hp_val]
          exact hKr
        refine ⟨⟨r, ⟨a ℓ ^ (k + N), k + N, rfl⟩⟩, ?_⟩
        change z * algebraMap (C_chart ℓ) C_loc (p_chart ℓ (a ℓ ^ (k + N))) =
          algebraMap (C_chart ℓ) C_loc (p_chart ℓ r)
        rw [map_pow, pow_add, map_mul, ← mul_assoc, hzc, ← map_mul,
          mul_comm ((ev ℓ).rangeRestrict F), hCr]
      · intro x₁ x₂ hx
        have h_pow_nzd : Submonoid.powers (p_chart ℓ (a ℓ)) ≤ nonZeroDivisors (C_chart ℓ) :=
          Submonoid.powers_le.mpr (ha_nzd ℓ)
        have hinj_loc : Function.Injective (algebraMap (C_chart ℓ) C_loc) :=
          IsLocalization.injective C_loc h_pow_nzd
        have hx_eq : x₁ = x₂ := hInj_p ℓ (hinj_loc hx)
        exact ⟨1, by simp [hx_eq]⟩
    have hLiftAlg : ∀ (B : Type u) [CommRing B] (θ : A →+* B) (t_B : B),
        t_B ∈ nonZeroDivisors B →
        Ideal.map θ m_A = Ideal.span {t_B} →
        ∃ (b : Fin (d + 1) → B),
          Ideal.span (Set.range b) = ⊤ ∧
          ∀ (ℓ : Fin (d + 1)) (B_ℓ : Type u) [CommRing B_ℓ] [Algebra B B_ℓ],
            IsLocalization.Away (b ℓ) B_ℓ →
            ∃ (lam_ℓ : C_chart ℓ →+* B_ℓ),
              lam_ℓ.comp (p_chart ℓ) = (algebraMap B B_ℓ).comp θ := by
      intro B _ θ t_B ht_nzd hMap_θ
      have hθa_mem : ∀ j : Fin (d + 1), ∃ bj : B, θ (a j) = t_B * bj := by
        intro j
        have h_in : θ (a j) ∈ Ideal.span ({t_B} : Set B) := by
          rw [← hMap_θ]
          apply Ideal.mem_map_of_mem θ
          rw [← ha_span]
          exact Ideal.subset_span ⟨j, rfl⟩
        exact Ideal.mem_span_singleton.mp h_in
      choose b hb_eq using hθa_mem
      have hb_span : Ideal.span (Set.range b) = ⊤ := by
        rw [Ideal.eq_top_iff_one]
        have ht_in : t_B ∈ Ideal.span (Set.range (fun j => θ (a j))) := by
          have h_eq_span : Ideal.span (Set.range (fun j => θ (a j))) = Ideal.span {t_B} := by
            rw [← hMap_θ, ← ha_span, Ideal.map_span, ← Set.range_comp]
            rfl
          rw [h_eq_span]
          exact Ideal.mem_span_singleton_self t_B
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp ht_in
        have h_cancel : (∑ j : Fin (d + 1), c j * b j - 1) * t_B = 0 := by
          calc (∑ j : Fin (d + 1), c j * b j - 1) * t_B
              = (∑ j : Fin (d + 1), c j * (t_B * b j)) - t_B := by
                  rw [sub_mul, one_mul, Finset.sum_mul]
                  congr 1
                  apply Finset.sum_congr rfl
                  intro j _
                  ring
            _ = (∑ j : Fin (d + 1), c j • θ (a j)) - t_B := by
                  simp only [smul_eq_mul, hb_eq]
            _ = 0 := by rw [hc, sub_self]
        have h_one : (∑ j : Fin (d + 1), c j * b j) = 1 :=
          sub_eq_zero.mp ((mem_nonZeroDivisors_iff.mp ht_nzd).2 _ h_cancel)
        rw [← h_one]
        exact (Submodule.mem_span_range_iff_exists_fun B).mpr ⟨c, by simp [smul_eq_mul]⟩
      refine ⟨b, hb_span, ?_⟩
      intro ℓ B_ℓ _ _ hLocB
      let α_ℓ : B →+* B_ℓ := algebraMap B B_ℓ
      let φ_ℓ : A →+* B_ℓ := α_ℓ.comp θ
      let t_bar : B_ℓ := α_ℓ t_B
      let b_bar : Fin (d + 1) → B_ℓ := fun j => α_ℓ (b j)
      let u_inv : B_ℓ := IsLocalization.Away.invSelf (S := B_ℓ) (b ℓ)
      have hbu_inv : b_bar ℓ * u_inv = 1 := IsLocalization.Away.mul_invSelf (S := B_ℓ) (b ℓ)
      have hφ_tb : ∀ j : Fin (d + 1), φ_ℓ (a j) = t_bar * b_bar j := by
        intro j
        change α_ℓ (θ (a j)) = α_ℓ t_B * α_ℓ (b j)
        rw [hb_eq j, map_mul]
      have htb_nzd : t_bar * b_bar ℓ ∈ nonZeroDivisors B_ℓ := by
        rw [mem_nonZeroDivisors_iff_right]
        intro z hz
        have hzt : z * t_bar = 0 := by
          calc z * t_bar = z * t_bar * (b_bar ℓ * u_inv) := by rw [hbu_inv, mul_one]
            _ = (z * (t_bar * b_bar ℓ)) * u_inv := by ring
            _ = 0 := by rw [hz, zero_mul]
        obtain ⟨⟨x, _, k, rfl⟩, hzx⟩ := IsLocalization.surj (Submonoid.powers (b ℓ)) z
        have h_xt0 : α_ℓ (x * t_B) = 0 := by
          calc α_ℓ (x * t_B) = α_ℓ x * t_bar := map_mul α_ℓ x t_B
            _ = (z * α_ℓ (b ℓ ^ k)) * t_bar := by rw [← hzx]
            _ = (z * t_bar) * α_ℓ (b ℓ ^ k) := by ring
            _ = 0 := by rw [hzt, zero_mul]
        rw [← map_zero α_ℓ] at h_xt0
        obtain ⟨⟨_, s, rfl⟩, hs_eq⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers (b ℓ)) B_ℓ).mp h_xt0
        have h_bx0 : b ℓ ^ s * x = 0 := by
          apply (mem_nonZeroDivisors_iff.mp ht_nzd).2
          calc (b ℓ ^ s * x) * t_B = b ℓ ^ s * (x * t_B) := by ring
            _ = b ℓ ^ s * 0 := hs_eq
            _ = 0 := mul_zero _
        have hz_pow : z * b_bar ℓ ^ (k + s) = 0 := by
          calc z * b_bar ℓ ^ (k + s)
              = (z * α_ℓ (b ℓ ^ k)) * α_ℓ (b ℓ ^ s) := by rw [pow_add, map_pow, map_pow]; ring
            _ = α_ℓ (b ℓ ^ s * x) := by rw [hzx, ← map_mul, mul_comm]
            _ = 0 := by rw [h_bx0, map_zero]
        have h_pow_inv : b_bar ℓ ^ (k + s) * u_inv ^ (k + s) = 1 := by
          rw [← mul_pow, hbu_inv, one_pow]
        calc z = z * (b_bar ℓ ^ (k + s) * u_inv ^ (k + s)) := by rw [h_pow_inv, mul_one]
          _ = (z * b_bar ℓ ^ (k + s)) * u_inv ^ (k + s) := by ring
          _ = 0 := by rw [hz_pow, zero_mul]
      let Φ_B : MvPolynomial (Fin (d + 1)) A →+* B_ℓ :=
        MvPolynomial.eval₂Hom φ_ℓ (fun j => b_bar j * u_inv)
      have hKer_le : ∀ F ∈ RingHom.ker (ev ℓ).rangeRestrict, Φ_B F = 0 := by
        intro F hF
        have hevF : ev ℓ F = 0 := by
          change ι_chart ℓ ((ev ℓ).rangeRestrict F) = 0
          rw [RingHom.mem_ker.mp hF, map_zero]
        obtain ⟨N, r, hKr, hSr⟩ := hClear ℓ F
        rw [hevF, mul_zero] at hKr
        have hr0 : r = 0 := hinj_K (hKr.symm.trans (map_zero _).symm)
        have h_mul0 : (t_bar * b_bar ℓ) ^ N * Φ_B F = 0 := by
          have h1 := hSr B_ℓ φ_ℓ t_bar b_bar u_inv hφ_tb hbu_inv
          rw [hr0, map_zero] at h1
          exact h1
        have hpow_nzd : (t_bar * b_bar ℓ) ^ N ∈ nonZeroDivisors B_ℓ :=
          Submonoid.pow_mem _ htb_nzd N
        exact (mem_nonZeroDivisors_iff.mp hpow_nzd).1 _ h_mul0
      let e_quot := RingHom.quotientKerEquivOfSurjective (RingHom.rangeRestrict_surjective (ev ℓ))
      let lam_ℓ : C_chart ℓ →+* B_ℓ :=
        (Ideal.Quotient.lift (RingHom.ker (ev ℓ).rangeRestrict) Φ_B hKer_le).comp
          e_quot.symm.toRingHom
      refine ⟨lam_ℓ, ?_⟩
      ext x
      have h_symm : e_quot.symm (p_chart ℓ x) =
          Ideal.Quotient.mk (RingHom.ker (ev ℓ).rangeRestrict) (MvPolynomial.C x) := by
        apply e_quot.injective
        rw [e_quot.apply_symm_apply]
        rfl
      change Ideal.Quotient.lift _ Φ_B hKer_le (e_quot.symm (p_chart ℓ x)) = φ_ℓ x
      rw [h_symm, Ideal.Quotient.lift_mk]
      simp [Φ_B]
    exact ⟨d, a, K_A, inferInstance, ι_K, C_chart, instCommC, p_chart, ι_chart, r_chart,
