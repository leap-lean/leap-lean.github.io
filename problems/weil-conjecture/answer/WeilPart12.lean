        have hcomap_ne_top : Ideal.comap ρ_E J ≠ ⊤ := by
          intro htop
          apply hJ_ne_top
          rw [Ideal.eq_top_iff_one] at htop ⊢
          simpa using htop
        have hcomap_eq : Ideal.comap ρ_E J = q_E :=
