        change ((P.presheaf.map eP.hom ≫
          P.presheaf.map (TopologicalSpace.Opens.leSupr WP i).op).hom) s₁ = _
        rw [← CategoryTheory.Functor.map_comp, h_eq]; rfl
      have h2 : (P.presheaf.map (TopologicalSpace.Opens.leSupr WP i).op).hom
          ((P.presheaf.map eP.hom).hom s₂) = ρ_P s₂ i := by
        change ((P.presheaf.map eP.hom ≫
          P.presheaf.map (TopologicalSpace.Opens.leSupr WP i).op).hom) s₂ = _
        rw [← CategoryTheory.Functor.map_comp, h_eq]; rfl
      exact (h1.trans (congrFun hs i)).trans h2.symm
    have hExact_P : Function.Exact ρ_P δ_P := by
      let WP : Fin M → P.Opens := fun i => (TopologicalSpace.Opens.map fst.base).obj (W i)
      intro sf
      constructor
      · intro hδ
        have hCompat : TopCat.Presheaf.IsCompatible P.presheaf WP sf := by
