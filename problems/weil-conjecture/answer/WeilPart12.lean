          hU₀.fromSpec :=
        AlgebraicGeometry.IsAffineOpen.map_fromSpec hV hU₀ i_V.op
      have hMapW : AlgebraicGeometry.Spec.map (E_sch.presheaf.map i_a.op) ≫ (hW a).fromSpec =
          hU₀.fromSpec :=
        AlgebraicGeometry.IsAffineOpen.map_fromSpec (hW a) hU₀ i_a.op
      have hPreV : (AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ pE)).hom =
