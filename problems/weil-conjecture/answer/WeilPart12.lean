        ι_Y.isOpenEmbedding.injective hp_img.symm
      rw [← hp_eq] at hp_r
      apply (PrimeSpectrum.mem_basicOpen r _).mp hp_r
      change algebraMap V_t L_t (ρ_mor.hom r) ∈ (⊥ : Ideal L_t)
      rw [hr_ker, map_zero]
