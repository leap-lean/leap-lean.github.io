  have hLaur_12 : Spec.map (CommRingCat.ofHom f_12) ≫ ι₁ =
      Spec.map (CommRingCat.ofHom f_21) ≫ ι₂ := by
    apply ext_of_isDominant_of_isSeparated (Limits.terminal.from M_m)
      (Limits.terminal.hom_ext _ _) (Spec.map (CommRingCat.ofHom α_12))
    have hL : Spec.map (CommRingCat.ofHom α_12) ≫ Spec.map (CommRingCat.ofHom f_12) ≫ ι₁ = γ_M := by
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hα12_f12]
      exact hGen_fam 1
    have hR : Spec.map (CommRingCat.ofHom α_12) ≫ Spec.map (CommRingCat.ofHom f_21) ≫ ι₂ = γ_M := by
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hα12_f21]
