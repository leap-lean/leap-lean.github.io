        refine ⟨(P.presheaf.map eP.inv).hom s₀, ?_⟩
        ext i
        have h_eq : eP.inv ≫ (CategoryTheory.homOfLE (le_top : WP i ≤ ⊤)).op =
            (TopologicalSpace.Opens.leSupr WP i).op := Subsingleton.elim _ _
        change ((P.presheaf.map eP.inv ≫
          P.presheaf.map (CategoryTheory.homOfLE (le_top : WP i ≤ ⊤)).op).hom) s₀ = sf i
        rw [← CategoryTheory.Functor.map_comp, h_eq]
        exact hs₀ i
      · rintro ⟨s, rfl⟩
        ext ⟨i, j⟩
        change (P.presheaf.map (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map fst.base).monotone (inf_le_left : W i ⊓ W j ≤ W i))).op).hom
            ((P.presheaf.map (CategoryTheory.homOfLE
              ((TopologicalSpace.Opens.map fst.base).monotone (le_top : W i ≤ ⊤))).op).hom s) -
          (P.presheaf.map (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map fst.base).monotone (inf_le_right : W i ⊓ W j ≤ W j))).op).hom
            ((P.presheaf.map (CategoryTheory.homOfLE
              ((TopologicalSpace.Opens.map fst.base).monotone (le_top : W j ≤ ⊤))).op).hom s) = 0
        rw [sub_eq_zero]
        change ((P.presheaf.map (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map fst.base).monotone (le_top : W i ≤ ⊤))).op ≫
            P.presheaf.map (CategoryTheory.homOfLE
              ((TopologicalSpace.Opens.map fst.base).monotone (inf_le_left : W i ⊓ W j ≤ W i))).op).hom) s =
          ((P.presheaf.map (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map fst.base).monotone (le_top : W j ≤ ⊤))).op ≫
            P.presheaf.map (CategoryTheory.homOfLE
              ((TopologicalSpace.Opens.map fst.base).monotone (inf_le_right : W i ⊓ W j ≤ W j))).op).hom) s
        rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
        have h_eq :
            (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map fst.base).monotone (le_top : W i ≤ ⊤))).op ≫
              (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map fst.base).monotone (inf_le_left : W i ⊓ W j ≤ W i))).op =
            (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map fst.base).monotone (le_top : W j ≤ ⊤))).op ≫
              (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map fst.base).monotone (inf_le_right : W i ⊓ W j ≤ W j))).op :=
          Subsingleton.elim _ _
        rw [h_eq]
    obtain ⟨E₁, hE₁⟩ := hPiTensorEquiv (Fin M) W hAffW
    obtain ⟨E₂, hE₂⟩ := hPiTensorEquiv (Fin M × Fin M) (fun p => W p.1 ⊓ W p.2) hAffW₂
    have hSq₁ : E₁.toLinearMap.comp (LinearMap.lTensor ↑B ρ_Y) = ρ_P.comp (μ_lin ⊤) := by
      apply TensorProduct.ext'
      intro b s
      ext i
      change E₁ (b ⊗ₜ[↑S] ρ_Y s) i = resP_lin (le_top : W i ≤ ⊤) (μ_lin ⊤ (b ⊗ₜ[↑S] s))
      rw [hE₁ b (ρ_Y s) i]
      exact (hμ_nat (le_top : W i ≤ ⊤) (b ⊗ₜ[↑S] s)).symm
    have hSq₂ : E₂.toLinearMap.comp (LinearMap.lTensor ↑B δ_Y) = δ_P.comp E₁.toLinearMap := by
      apply TensorProduct.ext'
      intro b sf
      ext p
      change E₂ (b ⊗ₜ[↑S] δ_Y sf) p =
        resP_lin inf_le_left (E₁ (b ⊗ₜ[↑S] sf) p.1) -
