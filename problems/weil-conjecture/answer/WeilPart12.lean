        have hEq_J : J = 𝔪_B := by
          rw [← hMapUnder, hEq_comap]
        exact hlt.ne hEq_J.symm
      exact ⟨hPrimeB, hComapB, hMaxB⟩
    obtain ⟨hPrimeB, hComapB, hMaxB⟩ := h𝔪B_prime_max
    have _ : 𝔪_B.IsPrime := hPrimeB
    have _ : 𝔪_B.IsMaximal := hMaxB
    have hPIR_transfer : IsPrincipalIdealRing (Localization.AtPrime 𝔪_B) →
        IsPrincipalIdealRing (Localization.AtPrime 𝔪) := by
      intro hPIR_B
      let _ : Algebra S B := ρ_S.toAlgebra
      have _ : IsLocalization.Away f B := hLocS
      have hAtPrime : IsLocalization (Ideal.comap ρ_S 𝔪_B).primeCompl (Localization.AtPrime 𝔪_B) :=
        IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
          (Submonoid.powers f) (Localization.AtPrime 𝔪_B) 𝔪_B
      have hCompl : (Ideal.comap ρ_S 𝔪_B).primeCompl = 𝔪.primeCompl := by
        ext x
        change x ∉ Ideal.comap ρ_S 𝔪_B ↔ x ∉ 𝔪
        rw [hComapB]
      rw [hCompl] at hAtPrime
      have _ : IsLocalization 𝔪.primeCompl (Localization.AtPrime 𝔪_B) := hAtPrime
      let eAtPrime : Localization.AtPrime 𝔪_B ≃ₐ[S] Localization.AtPrime 𝔪 :=
        IsLocalization.algEquiv 𝔪.primeCompl (Localization.AtPrime 𝔪_B) (Localization.AtPrime 𝔪)
      exact IsPrincipalIdealRing.of_surjective eAtPrime.toRingHom eAtPrime.surjective
    have _ : Nontrivial B := by
      refine ⟨⟨0, 1, fun h01 => hMaxB.ne_top ?_⟩⟩
      rw [Ideal.eq_top_iff_one, ← h01]
      exact 𝔪_B.zero_mem

    
    let _ : Algebra (Polynomial Ω) B := ψ_P.toAlgebra
    have _ : IsLocalization.Away g B := hLocP
    have hg_unit : IsUnit (ψ_P g) :=
      IsLocalization.map_units B (⟨g, Submonoid.mem_powers g⟩ : Submonoid.powers g)
    have hg_ne : g ≠ 0 := by
      intro hg0
      rw [hg0, map_zero] at hg_unit
      exact not_isUnit_zero hg_unit
    have hg_nzd : Submonoid.powers g ≤ nonZeroDivisors (Polynomial Ω) := by
      rintro _ ⟨k, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hg_ne)
    have hψ_inj : Function.Injective ψ_P :=
      IsLocalization.injective B hg_nzd
    let 𝔭 : Ideal (Polynomial Ω) := Ideal.comap ψ_P 𝔪_B
    have h𝔭_prime : 𝔭.IsPrime := Ideal.comap_isPrime ψ_P 𝔪_B
    have hMap_𝔭 : Ideal.map ψ_P 𝔭 = 𝔪_B :=
      IsLocalization.map_under (Submonoid.powers g) B 𝔪_B
    have hg_not_𝔭 : g ∉ 𝔭 := by
      intro hg_mem
      exact hMaxB.ne_top (Ideal.eq_top_of_isUnit_mem 𝔪_B hg_mem hg_unit)
    have h𝔭_ne_bot : 𝔭 ≠ ⊥ := by
      intro h𝔭_bot
      have h𝔪B_bot : 𝔪_B = ⊥ := by
        rw [← hMap_𝔭, h𝔭_bot, Ideal.map_bot]
      have _ : Infinite Ω := IsAlgClosed.instInfinite
      obtain ⟨c₁, hc₁_not_mem⟩ := Infinite.exists_notMem_finset g.roots.toFinset
      have hgc₁_ne : (Polynomial.evalRingHom c₁) g ≠ 0 := by
        intro hroot
        exact hc₁_not_mem (Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hg_ne).mpr hroot))
      let ev₁ : B →+* Ω :=
        IsLocalization.Away.lift g (IsUnit.mk0 _ hgc₁_ne)
      let z₁ : B := ψ_P (Polynomial.X - Polynomial.C c₁)
      have hz₁_ne : z₁ ≠ 0 := by
        intro hz0
        exact Polynomial.X_sub_C_ne_zero c₁ (hψ_inj (hz0.trans (map_zero ψ_P).symm))
      have hz₁_ker : z₁ ∈ RingHom.ker ev₁ := by
        change ev₁ (algebraMap (Polynomial Ω) B (Polynomial.X - Polynomial.C c₁)) = 0
        rw [IsLocalization.Away.lift_eq]
        simp
      have hker₁_ne_top : RingHom.ker ev₁ ≠ ⊤ := (RingHom.ker_isPrime ev₁).ne_top
      have hle₁ : 𝔪_B ≤ RingHom.ker ev₁ := by
        rw [h𝔪B_bot]
        exact bot_le
      have hEq₁ : RingHom.ker ev₁ = 𝔪_B := (hMaxB.eq_of_le hker₁_ne_top hle₁).symm
      rw [hEq₁, h𝔪B_bot, Ideal.mem_bot] at hz₁_ker
