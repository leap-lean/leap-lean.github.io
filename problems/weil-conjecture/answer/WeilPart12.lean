      have hnat := RingHom.congr_fun
        (congrArg CommRingCat.Hom.hom (fst.naturality (incY U₀).op)) (u_Y r)
      change (fst.app U₀).hom (βY U₀ r) =
        (P.presheaf.map ((TopologicalSpace.Opens.map fst.base).map (incY U₀)).op).hom
