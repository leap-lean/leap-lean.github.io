        letI : Algebra Ω ↑(Y'.presheaf.obj (Opposite.op V.1)) := (φ_app.comp φ_inv).toAlgebra
        have _ : Algebra.FiniteType Ω ↑(Y'.presheaf.obj (Opposite.op V.1)) := hFT_comp
        exact Algebra.FiniteType.isNoetherianRing Ω ↑(Y'.presheaf.obj (Opposite.op V.1))
