        have hhom2 : CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) ≫
            CommRingCat.ofHom p₂ =
            CommRingCat.ofHom ((Ideal.Quotient.mk J_m2).comp MvPolynomial.C) := by
          rw [← CommRingCat.ofHom_comp, hcomp2]
        have hspec2 : Spec.map (CommRingCat.ofHom p₂) ≫ g_Pm =
            Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J_m2).comp MvPolynomial.C)) := by
          change Spec.map (CommRingCat.ofHom p₂) ≫
              Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C)) = _
          rw [← Spec.map_comp, hhom2]
        rw [hspec2]
        have _ : Flat (Spec.map (CommRingCat.ofHom
            ((Ideal.Quotient.mk J_m2).comp MvPolynomial.C))) :=
          (HasRingHomProperty.Spec_iff (P := @Flat)).mpr (hNodal_k (m - 2)).2.1
        have _ : LocallyOfFinitePresentation (Spec.map (CommRingCat.ofHom
            ((Ideal.Quotient.mk J_m2).comp MvPolynomial.C))) :=
          (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mpr
            (hNodal_k (m - 2)).2.2
        exact ⟨inferInstance, inferInstance⟩
      intro r
