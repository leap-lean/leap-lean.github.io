                congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).inv ≫ ·)
                  (congrArg ((AlgebraicGeometry.Spec.map ιR_hom).app ⊤ ≫ ·)
                    (CategoryTheory.Category.id_comp g_hom))
          _ = ιR_hom := by
                rw [AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
                  ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
                  CategoryTheory.Category.id_comp]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom h_full) c
    have h_left_inv : ∀ z : T₀, ψ_hom.hom (μ_lin z) = z := by
      intro z
      refine TensorProduct.inductionOn z ?_ ?_
      · intro b c
        change ψ_hom.hom (γ₀ b * (fst.app U₀).hom c) = b ⊗ₜ[↑S] c
        rw [map_mul, h_on_B, h_on_C]
        change (b ⊗ₜ[↑S] (1 : AY₀)) * ((1 : ↑B) ⊗ₜ[↑S] c) = b ⊗ₜ[↑S] c
