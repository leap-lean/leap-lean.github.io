            AlgebraicGeometry.Spec (CommRingCat.of R))
          (d : B),
        d ∈ nonZeroDivisors B →
        Ideal.map (AlgebraicGeometry.Spec.preimage ψ).hom I_center = Ideal.span {d} →
        (∃ ψ_lift : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ M, ψ_lift ≫ p_M = ψ) ∧
        (∀ ψ₁ ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ M,
          ψ₁ ≫ p_M = ψ → ψ₂ ≫ p_M = ψ → ψ₁ = ψ₂)) := by
    clear! Ω m L Laur
    intro R _ I_center g hI C p v d_C M _ p_M ι hOpen hCov hComm hPre hv_eq hd_C hLoc hLiftAlg
    have _ : ∀ r : Fin 3, IsOpenImmersion (ι r) := hOpen
    let U_compl : (Spec (CommRingCat.of R)).Opens :=
      ⟨(PrimeSpectrum.zeroLocus (I_center : Set R))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (I_center : Set R)).isOpen_compl⟩
    have hIso_basic : ∀ r : Fin 3,
        IsIso (p_M ∣_ (PrimeSpectrum.basicOpen (g r) : (Spec (CommRingCat.of R)).Opens)) := by
      intro r
      let U_r : (Spec (CommRingCat.of R)).Opens := PrimeSpectrum.basicOpen (g r)
      let V_r : M.Opens := (TopologicalSpace.Opens.map p_M.base).obj U_r
      let R_loc := Localization.Away (g r)
      let C_loc := Localization.Away (p r (g r))
      let j_R : Spec (CommRingCat.of R_loc) ⟶ Spec (CommRingCat.of R) :=
        Spec.map (CommRingCat.ofHom (algebraMap R R_loc))
      let j_C : Spec (CommRingCat.of C_loc) ⟶ Spec (C r) :=
        Spec.map (CommRingCat.ofHom (algebraMap ↑(C r) C_loc))
      have _ : IsOpenImmersion j_R :=
        Scheme.isOpenImmersion_SpecMap_localizationAway (R := CommRingCat.of R) (g r)
      have _ : IsOpenImmersion j_C :=
        Scheme.isOpenImmersion_SpecMap_localizationAway (R := C r) (p r (g r))
      have hRange_R : Set.range j_R.base = Set.range U_r.ι.base := by
        rw [Scheme.Opens.range_ι]
        exact PrimeSpectrum.localization_away_comap_range R_loc (g r)
      have hRange_C : Set.range j_C.base = (PrimeSpectrum.basicOpen (p r (g r))).1 :=
        PrimeSpectrum.localization_away_comap_range C_loc (p r (g r))
      have hRange_V : Set.range (j_C ≫ ι r).base = Set.range V_r.ι.base := by
        rw [Scheme.Opens.range_ι]
        ext y
        constructor
        · rintro ⟨z, rfl⟩
          have hz : j_C.base z ∈ (PrimeSpectrum.basicOpen (p r (g r))).1 := by
            rw [← hRange_C]; exact ⟨z, rfl⟩
          change p_M.base ((ι r).base (j_C.base z)) ∈ (PrimeSpectrum.basicOpen (g r)).1
          have h1 : p_M.base ((ι r).base (j_C.base z)) =
              (ι r ≫ p_M).base (j_C.base z) := rfl
          rw [h1, hComm r]
          exact hz
        · intro hy
          change p_M.base y ∈ (PrimeSpectrum.basicOpen (g r)).1 at hy
          have hy_cov : y ∈ ⋃ s : Fin 3, Set.range (ι s).base := by rw [hCov]; trivial
          rcases Set.mem_iUnion.mp hy_cov with ⟨s, qs, rfl⟩
          have hqs_gr : p s (g r) ∉ qs.asIdeal := by
            have h1 : p_M.base ((ι s).base qs) = (ι s ≫ p_M).base qs := rfl
            rw [h1, hComm s] at hy
            exact hy
          have hqs_v : v s r ∉ qs.asIdeal := by
            intro hv_in
            apply hqs_gr
            rw [← hv_eq s r]
            exact Ideal.mul_mem_right _ _ hv_in
          have hqs_bo : qs ∈ (PrimeSpectrum.basicOpen (v s r)).1 := hqs_v
          rw [← hPre s r] at hqs_bo
          rcases hqs_bo with ⟨qr, hqr_eq⟩
          have hqr_gr : qr ∈ (PrimeSpectrum.basicOpen (p r (g r))).1 := by
            rw [← hqr_eq] at hy
            have h1 : p_M.base ((ι r).base qr) = (ι r ≫ p_M).base qr := rfl
            rw [h1, hComm r] at hy
            exact hy
          rw [← hRange_C] at hqr_gr
          rcases hqr_gr with ⟨z, rfl⟩
          exact ⟨z, hqr_eq⟩
      let iso_U : Spec (CommRingCat.of R_loc) ≅ U_r.toScheme :=
        IsOpenImmersion.isoOfRangeEq j_R U_r.ι hRange_R
      let iso_V : Spec (CommRingCat.of C_loc) ≅ V_r.toScheme :=
        IsOpenImmersion.isoOfRangeEq (j_C ≫ ι r) V_r.ι hRange_V
      let algRC : Algebra R C_loc := ((algebraMap ↑(C r) C_loc).comp (p r)).toAlgebra
      have _ : @IsLocalization.Away R _ (g r) C_loc _ algRC :=
        hLoc r C_loc inferInstance
      let e_alg : R_loc ≃ₐ[R] C_loc :=
        IsLocalization.algEquiv (Submonoid.powers (g r)) R_loc C_loc
      let e_spec : Spec (CommRingCat.of C_loc) ≅ Spec (CommRingCat.of R_loc) :=
        { hom := Spec.map (CommRingCat.ofHom e_alg.toRingHom)
          inv := Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)
          hom_inv_id := by
            rw [← Spec.map_comp]
            have : CommRingCat.ofHom e_alg.symm.toRingHom ≫ CommRingCat.ofHom e_alg.toRingHom =
                𝟙 (CommRingCat.of C_loc) := by
              ext x; exact e_alg.apply_symm_apply x
            rw [this, Spec.map_id]
          inv_hom_id := by
            rw [← Spec.map_comp]
            have : CommRingCat.ofHom e_alg.toRingHom ≫ CommRingCat.ofHom e_alg.symm.toRingHom =
                𝟙 (CommRingCat.of R_loc) := by
              ext x; exact e_alg.symm_apply_apply x
            rw [this, Spec.map_id] }
      have he_j : e_spec.hom ≫ j_R = j_C ≫ Spec.map (CommRingCat.ofHom (p r)) := by
        dsimp [e_spec, j_R, j_C]
        rw [← Spec.map_comp, ← Spec.map_comp]
        congr 1
        ext x
        exact e_alg.commutes x
      let iso_tot : V_r.toScheme ≅ U_r.toScheme := iso_V.symm ≪≫ e_spec ≪≫ iso_U
      have h_fac : p_M ∣_ U_r = iso_tot.hom := by
        apply (cancel_mono U_r.ι).mp
        rw [morphismRestrict_ι]
        dsimp [iso_tot]
        calc V_r.ι ≫ p_M
            = (iso_V.inv ≫ iso_V.hom ≫ V_r.ι) ≫ p_M := by simp
          _ = iso_V.inv ≫ (j_C ≫ ι r) ≫ p_M := by
              rw [IsOpenImmersion.isoOfRangeEq_hom_fac, Category.assoc]
          _ = iso_V.inv ≫ j_C ≫ Spec.map (CommRingCat.ofHom (p r)) := by
              rw [Category.assoc, hComm r]
          _ = iso_V.inv ≫ e_spec.hom ≫ j_R := by rw [← he_j]
          _ = (iso_V.inv ≫ e_spec.hom ≫ iso_U.hom) ≫ U_r.ι := by
              have hU_fac : iso_U.hom ≫ U_r.ι = j_R :=
                IsOpenImmersion.isoOfRangeEq_hom_fac j_R U_r.ι hRange_R
              rw [Category.assoc, Category.assoc, hU_fac]
      rw [h_fac]
      infer_instance
    have hIsoCompl : IsIso (p_M ∣_ U_compl) := by
      let U_sub : Fin 3 → U_compl.toScheme.Opens :=
        fun r => (TopologicalSpace.Opens.map U_compl.ι.base).obj (PrimeSpectrum.basicOpen (g r))
      have hU_sub_top : (⨆ r : Fin 3, U_sub r) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        rw [TopologicalSpace.Opens.mem_iSup]
        by_contra hnone
        push Not at hnone
        apply x.2
        change (I_center : Set R) ⊆ (U_compl.ι.base x).asIdeal
        rw [hI, SetLike.coe_subset_coe, Ideal.span_le]
        rintro _ ⟨r, rfl⟩
        have hnr : x ∉ U_sub r := hnone r
        change (U_compl.ι.base x) ∉ PrimeSpectrum.basicOpen (g r) at hnr
        exact Classical.not_not.mp hnr
      have hU_img : ∀ r : Fin 3,
          (U_compl.ι.opensFunctor).obj (U_sub r) =
            (PrimeSpectrum.basicOpen (g r) : (Spec (CommRingCat.of R)).Opens) := by
        intro r
        ext y
        constructor
        · rintro ⟨x, hx, rfl⟩
          exact hx
        · intro hy
          have hy_compl : y ∈ U_compl := by
            intro hz
            change (I_center : Set R) ⊆ y.asIdeal at hz
            have hgr_mem : g r ∈ I_center := by
              rw [hI]; exact Ideal.subset_span ⟨r, rfl⟩
            exact hy (hz hgr_mem)
          exact ⟨⟨y, hy_compl⟩, hy, rfl⟩
      exact (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := MorphismProperty.isomorphisms Scheme) U_sub hU_sub_top).mpr fun r => by
        let e_arr := morphismRestrictRestrict p_M U_compl (U_sub r)
        rw [(MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff e_arr]
        change IsIso (p_M ∣_ (U_compl.ι.opensFunctor).obj (U_sub r))
        rw [hU_img r]
        exact hIso_basic r
    let W_cov : Fin 3 → M.Opens := fun r => (ι r).opensRange
    let hAff : ∀ r : Fin 3, IsAffineOpen (W_cov r) := fun r => isAffineOpen_opensRange (ι r)
    have hW_univ : (⋃ r : Fin 3, (W_cov r : Set M)) = Set.univ := hCov
    let e_sch : ∀ r : Fin 3, Spec (M.presheaf.obj (Opposite.op (W_cov r))) ≅ Spec (C r) :=
      fun r => IsOpenImmersion.isoOfRangeEq (hAff r).fromSpec (ι r) ((hAff r).range_fromSpec)
    let α_equiv : ∀ r : Fin 3, ↑(C r) ≃+* ↑(M.presheaf.obj (Opposite.op (W_cov r))) :=
      fun r =>
        { toFun := (Spec.preimage (e_sch r).hom).hom
          invFun := (Spec.preimage (e_sch r).inv).hom
          left_inv := fun x => by
            change ((Spec.preimage (e_sch r).hom ≫ Spec.preimage (e_sch r).inv).hom) x = x
            rw [← Spec.preimage_comp, Iso.inv_hom_id, Spec.preimage_id]
            rfl
          right_inv := fun x => by
            change ((Spec.preimage (e_sch r).inv ≫ Spec.preimage (e_sch r).hom).hom) x = x
            rw [← Spec.preimage_comp, Iso.hom_inv_id, Spec.preimage_id]
            rfl
          map_mul' := map_mul _
          map_add' := map_add _ }
    let d_gen : ∀ r : Fin 3, ↑(M.presheaf.obj (Opposite.op (W_cov r))) :=
      fun r => α_equiv r (d_C r)
    have hd_gen_spec : ∀ r : Fin 3,
        d_gen r ∈ nonZeroDivisors ↑(M.presheaf.obj (Opposite.op (W_cov r))) ∧
        Ideal.map (Spec.preimage ((hAff r).fromSpec ≫ p_M)).hom I_center =
          Ideal.span {d_gen r} := by
      intro r
      have hfac_r : (hAff r).fromSpec ≫ p_M =
          (e_sch r).hom ≫ Spec.map (CommRingCat.ofHom (p r)) := by
        rw [← IsOpenImmersion.isoOfRangeEq_hom_fac (hAff r).fromSpec (ι r) ((hAff r).range_fromSpec),
          Category.assoc, hComm r]
      have hpre_r : (Spec.preimage ((hAff r).fromSpec ≫ p_M)).hom =
          (α_equiv r).toRingHom.comp (p r) := by
        rw [hfac_r, Spec.preimage_comp, Spec.preimage_map]
        rfl
      refine ⟨?_, ?_⟩
      · rw [mem_nonZeroDivisors_iff_right]
        intro y hy
        have hy' : (α_equiv r).symm y * d_C r = 0 := by
          apply (α_equiv r).injective
          rw [map_mul, map_zero, RingEquiv.apply_symm_apply]
          exact hy
        have h0 : (α_equiv r).symm y = 0 := mem_nonZeroDivisors_iff_right.mp (hd_C r).1 _ hy'
        exact (α_equiv r).symm.injective (h0.trans (map_zero _).symm)
      · rw [hpre_r, ← Ideal.map_map, (hd_C r).2, Ideal.map_span, Set.image_singleton]
        rfl
    have hUnique : ∀ (B' : Type u) [CommRing B']
        (ψ' : Spec (CommRingCat.of B') ⟶ Spec (CommRingCat.of R))
        (d' : B'),
        d' ∈ nonZeroDivisors B' →
        Ideal.map (Spec.preimage ψ').hom I_center = Ideal.span {d'} →
        ∀ ψ₁ ψ₂ : Spec (CommRingCat.of B') ⟶ M,
          ψ₁ ≫ p_M = ψ' → ψ₂ ≫ p_M = ψ' → ψ₁ = ψ₂ := by
      intro B' _ ψ' d' hd' hMap' ψ₁ ψ₂ hψ₁ hψ₂
      let Bd := Localization.Away d'
      let j_d : Spec (CommRingCat.of Bd) ⟶ Spec (CommRingCat.of B') :=
        Spec.map (CommRingCat.ofHom (algebraMap B' Bd))
      have hRange_compl : Set.range (j_d ≫ ψ').base ⊆ Set.range U_compl.ι.base := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩ hzero
        change (I_center : Set R) ⊆ ((j_d ≫ ψ').base q).asIdeal at hzero
        have hψ'_eq : Spec.map (Spec.preimage ψ') = ψ' := Spec.map_preimage ψ'
        rw [← hψ'_eq] at hzero
        have hcomap : (I_center : Set R) ⊆
            (Spec.preimage ψ').hom ⁻¹' (algebraMap B' Bd ⁻¹' q.asIdeal) := hzero
        have hmap_le : Ideal.map (Spec.preimage ψ').hom I_center ≤
            Ideal.comap (algebraMap B' Bd) q.asIdeal := Ideal.map_le_iff_le_comap.mpr hcomap
        rw [hMap', Ideal.span_singleton_le_iff_mem] at hmap_le
        have hunit : IsUnit (algebraMap B' Bd d') := IsLocalization.Away.algebraMap_isUnit d'
        exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hmap_le hunit)
      let V_compl : M.Opens := (TopologicalSpace.Opens.map p_M.base).obj U_compl
      have hRange_V1 : Set.range (j_d ≫ ψ₁).base ⊆ Set.range V_compl.ι.base := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        have hmem : (j_d ≫ ψ').base q ∈ Set.range U_compl.ι.base := hRange_compl ⟨q, rfl⟩
        rw [Scheme.Opens.range_ι] at hmem
        rw [← hψ₁] at hmem
        exact hmem
      have hRange_V2 : Set.range (j_d ≫ ψ₂).base ⊆ Set.range V_compl.ι.base := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        have hmem : (j_d ≫ ψ').base q ∈ Set.range U_compl.ι.base := hRange_compl ⟨q, rfl⟩
        rw [Scheme.Opens.range_ι] at hmem
        rw [← hψ₂] at hmem
        exact hmem
      let l₁ : Spec (CommRingCat.of Bd) ⟶ V_compl.toScheme :=
        IsOpenImmersion.lift V_compl.ι (j_d ≫ ψ₁) hRange_V1
      let l₂ : Spec (CommRingCat.of Bd) ⟶ V_compl.toScheme :=
        IsOpenImmersion.lift V_compl.ι (j_d ≫ ψ₂) hRange_V2
      have _ : IsIso (p_M ∣_ U_compl) := hIsoCompl
      have hl_eq : l₁ = l₂ := by
        apply (cancel_mono (p_M ∣_ U_compl)).mp
        apply (cancel_mono U_compl.ι).mp
        rw [Category.assoc, Category.assoc, morphismRestrict_ι]
        rw [← Category.assoc l₁, IsOpenImmersion.lift_fac]
        rw [← Category.assoc l₂, IsOpenImmersion.lift_fac]
        rw [Category.assoc, hψ₁, Category.assoc, hψ₂]
      have hjd_eq : j_d ≫ ψ₁ = j_d ≫ ψ₂ := by
        calc j_d ≫ ψ₁
            = l₁ ≫ V_compl.ι := (IsOpenImmersion.lift_fac V_compl.ι (j_d ≫ ψ₁) hRange_V1).symm
          _ = l₂ ≫ V_compl.ι := by rw [hl_eq]
          _ = j_d ≫ ψ₂ := IsOpenImmersion.lift_fac V_compl.ι (j_d ≫ ψ₂) hRange_V2
      let e_eq := Limits.equalizer.ι ψ₁ ψ₂
      let l_eq := Limits.equalizer.lift j_d hjd_eq
      have hl_fac : l_eq ≫ e_eq = j_d := Limits.equalizer.lift_ι j_d hjd_eq
      have _ : IsClosedImmersion e_eq := inferInstance
      obtain ⟨hAff_eq, hSurj_eq⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine e_eq
      have _ : IsAffine (Limits.equalizer ψ₁ ψ₂) := hAff_eq
      have hpow_le : Submonoid.powers d' ≤ nonZeroDivisors B' :=
        Submonoid.powers_le.mpr hd'
      have hinj_alg : Function.Injective (algebraMap B' Bd) :=
        IsLocalization.injective Bd hpow_le
      have hinj_jd : Function.Injective j_d.appTop.hom := by
        have hΓ' : (Scheme.ΓSpecIso (CommRingCat.of B')).inv ≫ j_d.appTop =
            CommRingCat.ofHom (algebraMap B' Bd) ≫ (Scheme.ΓSpecIso (CommRingCat.of Bd)).inv := by
          rw [Iso.inv_comp_eq, ← Category.assoc]
          exact (Iso.eq_comp_inv _).mpr
            (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap B' Bd)))
        intro x y hxy
        let iB := (Scheme.ΓSpecIso (CommRingCat.of B')).inv
        let iBd := (Scheme.ΓSpecIso (CommRingCat.of Bd)).inv
        have hbijB : Function.Bijective iB.hom := ConcreteCategory.bijective_of_isIso iB
        obtain ⟨x₀, rfl⟩ := hbijB.2 x
        obtain ⟨y₀, rfl⟩ := hbijB.2 y
        have h1 : (iB ≫ j_d.appTop).hom x₀ = (iB ≫ j_d.appTop).hom y₀ := by
          simp [CommRingCat.hom_comp, hxy]
        rw [hΓ'] at h1
        have hbijBd : Function.Bijective iBd.hom := ConcreteCategory.bijective_of_isIso iBd
        have h2 : algebraMap B' Bd x₀ = algebraMap B' Bd y₀ := hbijBd.1 h1
        rw [hinj_alg h2]
      have hinj_eq : Function.Injective e_eq.appTop.hom := by
        have hcomp_top : j_d.appTop = e_eq.appTop ≫ l_eq.appTop := by
          rw [← hl_fac, Scheme.Hom.comp_appTop]
        rw [hcomp_top] at hinj_jd
        exact Function.Injective.of_comp (f := l_eq.appTop.hom) hinj_jd
      have _ : IsIso e_eq.appTop :=
        (ConcreteCategory.isIso_iff_bijective e_eq.appTop).mpr ⟨hinj_eq, hSurj_eq⟩
      have _ : IsIso (Spec.map e_eq.appTop) :=
        { out := ⟨Spec.map (inv e_eq.appTop),
            by rw [← Spec.map_comp, IsIso.inv_hom_id, Spec.map_id],
            by rw [← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id]⟩ }
      have he_iso_eq : e_eq = (Limits.equalizer ψ₁ ψ₂).toSpecΓ ≫
          Spec.map e_eq.appTop ≫ inv (Spec (CommRingCat.of B')).toSpecΓ := by
        rw [← Category.assoc, ← Scheme.toSpecΓ_naturality e_eq, Category.assoc,
