      · exact ⟨fun h => False.elim (hp (h_le_lhs h)), fun h => False.elim (hp (h_le_rhs h))⟩
    have hMul_open : ∀ ℓ ℓ' : Fin (d + 1),
        Proj.basicOpen 𝒜 (X_var ℓ * X_var ℓ') = D ℓ ⊓ D ℓ' :=
      fun ℓ ℓ' => Proj.basicOpen_mul 𝒜 (X_var ℓ) (X_var ℓ')
    have hAwayRes_L : ∀ (ℓ ℓ' : Fin (d + 1))
        (z : HomogeneousLocalization.Away 𝒜 (X_var ℓ)),
        (P_A.presheaf.map (homOfLE (inf_le_left : D ℓ ⊓ D ℓ' ≤ D ℓ)).op).hom
