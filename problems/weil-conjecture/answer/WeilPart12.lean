      intro ℓ ℓ' z
      have h_am := Proj.awayMap_awayToSection 𝒜 (hX1 ℓ)
        (mul_comm (X_var ℓ) (X_var ℓ'))
      have h_am_app :
          (P_A.presheaf.map (homOfLE ((hMul_open ℓ ℓ').trans_le inf_le_right)).op).hom
            ((Proj.awayToSection 𝒜 (X_var ℓ')).hom z) =
          (Proj.awayToSection 𝒜 (X_var ℓ * X_var ℓ')).hom
            (HomogeneousLocalization.awayMap 𝒜 (hX1 ℓ) (mul_comm _ _) z) :=
