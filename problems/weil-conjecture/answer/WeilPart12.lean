        simp only [Fin.val_zero, pow_zero, mul_one, Nat.sub_zero, Fin.val_succ,
          Nat.succ_sub_succ_eq_sub] at hsum_eq
        let S : L' := ∑ i : Fin (d + 1), c i.succ * u ^ (i : ℕ) * v ^ (d - (i : ℕ))
        have hS_factor : (∑ x : Fin (d + 1), c x.succ * u ^ ((x : ℕ) + 1) * v ^ (d - (x : ℕ))) =
            u * S := by
          dsimp only [S]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [pow_succ']
          ring
        rw [hS_factor] at hsum_eq
        have h_v_mem : v ^ (d + 1) * (c 0 - r * v) ∈ Ideal.span ({u} : Set L') := by
          refine Ideal.mem_span_singleton.mpr ⟨w - S, ?_⟩
          have h1 : v ^ (d + 1) * (c 0 - r * v) =
              (c 0 * v ^ (d + 1) + u * S) - r * v ^ (d + 2) - u * S := by
            rw [pow_succ' v (d + 1)]
            ring
          rw [h1, hsum_eq]
          ring
        have hc0_sub : c 0 - r * v ∈ Ideal.span ({u} : Set L') := hv_pow_reg (d + 1) _ h_v_mem
        obtain ⟨s, hs_eq⟩ := Ideal.mem_span_singleton.mp hc0_sub
        have hc0_eq : c 0 = u * s + r * v := eq_add_of_sub_eq hs_eq
        have hc0_mem : c 0 ∈ 𝔪' := by
          rw [hc0_eq]
          exact 𝔪'.add_mem (𝔪'.mul_mem_right s hu_mem) (𝔪'.mul_mem_left r hv_mem)
        have huS_eq : u * S = u * (w - s * v ^ (d + 1)) := by
          have h2 : c 0 * v ^ (d + 1) + u * S = u * (s * v ^ (d + 1) + S) + r * v ^ (d + 2) := by
            rw [hc0_eq, pow_succ' v (d + 1)]
            ring
          have h3 : u * (s * v ^ (d + 1) + S) = u * w := add_right_cancel (h2.symm.trans hsum_eq)
          have h5 : s * v ^ (d + 1) + S = w := hu_inj h3
          have h6 : S = w - s * v ^ (d + 1) := eq_sub_of_add_eq' h5
          rw [h6]
        have hS_eq : S = w - s * v ^ (d + 1) := hu_inj huS_eq
        have hS_mem : S ∈ 𝔪' ^ (d + 1) := by
          rw [hS_eq]
          exact (𝔪' ^ (d + 1)).sub_mem hw
            ((𝔪' ^ (d + 1)).mul_mem_left s (Ideal.pow_mem_pow hv_mem (d + 1)))
        have hc_succ := ih (fun i => c i.succ) hS_mem
        intro j
        exact Fin.cases hc0_mem hc_succ j
    have hQuasiToDomainAndReg : ∀ (L : Type u) [CommRing L] [IsLocalRing L] [IsNoetherianRing L]
        (w₁ w₂ : L),
        IsLocalRing.maximalIdeal L = Ideal.span ({w₁, w₂} : Set L) →
        (∀ (d : ℕ) (c : Fin (d + 1) → L),
          (∑ j : Fin (d + 1), c j * w₁ ^ (j : ℕ) * w₂ ^ (d - (j : ℕ))) ∈
            (IsLocalRing.maximalIdeal L) ^ (d + 1) →
          ∀ j : Fin (d + 1), c j ∈ IsLocalRing.maximalIdeal L) →
        IsDomain L ∧ w₁ ≠ 0 ∧
          (∀ y : L, w₂ * y ∈ Ideal.span ({w₁} : Set L) → y ∈ Ideal.span ({w₁} : Set L)) := by
      intro L _ _ _ w₁ w₂ hSpanL hQR
      let 𝔪_L : Ideal L := IsLocalRing.maximalIdeal L
      have h𝔪_max : 𝔪_L.IsMaximal := IsLocalRing.maximalIdeal.isMaximal L
      have hw₁_in : w₁ ∈ 𝔪_L := by
        change w₁ ∈ IsLocalRing.maximalIdeal L
        rw [hSpanL]; exact Ideal.subset_span (Set.mem_insert w₁ {w₂})
      have hw₂_in : w₂ ∈ 𝔪_L := by
        change w₂ ∈ IsLocalRing.maximalIdeal L
        rw [hSpanL]; exact Ideal.subset_span (Set.mem_insert_of_mem w₁ (Set.mem_singleton w₂))
      have hMon_mem : ∀ (a b : ℕ), w₁ ^ a * w₂ ^ b ∈ 𝔪_L ^ (a + b) := by
        intro a b
        rw [pow_add]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hw₁_in a) (Ideal.pow_mem_pow hw₂_in b)
      have hExpand : ∀ (d : ℕ) (x : L), x ∈ 𝔪_L ^ d →
          ∃ a : Fin (d + 1) → L,
            x = ∑ j : Fin (d + 1), a j * w₁ ^ (j : ℕ) * w₂ ^ (d - (j : ℕ)) := by
        intro d
        induction d with
        | zero =>
          intro x _
          exact ⟨fun _ => x, by simp⟩
        | succ d ih =>
          intro x hx
          rw [pow_succ' 𝔪_L d] at hx
          refine Submodule.mul_induction_on hx ?_ ?_
          · intro m hm z hz
            have hm' : m ∈ Ideal.span ({w₁, w₂} : Set L) := hSpanL ▸ hm
            obtain ⟨r₁, r₂, rfl⟩ := hSpanPair w₁ w₂ m hm'
            obtain ⟨a, rfl⟩ := ih z hz
            let a₁ : Fin (d + 2) → L := Fin.cases 0 (fun i => r₁ * a i)
            let a₂ : Fin (d + 2) → L := Fin.snoc (fun i => r₂ * a i) 0
            refine ⟨fun j => a₁ j + a₂ j, ?_⟩
            have hsum1 : (∑ j : Fin (d + 2), a₁ j * w₁ ^ (j : ℕ) * w₂ ^ (d + 1 - (j : ℕ))) =
                r₁ * w₁ * ∑ i : Fin (d + 1), a i * w₁ ^ (i : ℕ) * w₂ ^ (d - (i : ℕ)) := by
              rw [Fin.sum_univ_succ]
              simp only [a₁, Fin.cases_zero, zero_mul, zero_add, Fin.cases_succ, Fin.val_succ,
                Nat.succ_sub_succ_eq_sub, Finset.mul_sum]
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [pow_succ']
              ring
            have hsum2 : (∑ j : Fin (d + 2), a₂ j * w₁ ^ (j : ℕ) * w₂ ^ (d + 1 - (j : ℕ))) =
                r₂ * w₂ * ∑ i : Fin (d + 1), a i * w₁ ^ (i : ℕ) * w₂ ^ (d - (i : ℕ)) := by
              rw [Fin.sum_univ_castSucc]
              simp only [a₂, Fin.snoc_last, zero_mul, add_zero, Fin.snoc_castSucc,
                Fin.val_castSucc, Finset.mul_sum]
              refine Finset.sum_congr rfl fun i _ => ?_
              have hsub : d + 1 - (i : ℕ) = (d - (i : ℕ)) + 1 := by omega
              rw [hsub, pow_succ']
              ring
            have hdistrib : (∑ j : Fin (d + 2), (a₁ j + a₂ j) * w₁ ^ (j : ℕ) * w₂ ^ (d + 1 - (j : ℕ))) =
                (∑ j : Fin (d + 2), a₁ j * w₁ ^ (j : ℕ) * w₂ ^ (d + 1 - (j : ℕ))) +
                (∑ j : Fin (d + 2), a₂ j * w₁ ^ (j : ℕ) * w₂ ^ (d + 1 - (j : ℕ))) := by
              rw [← Finset.sum_add_distrib]
              exact Finset.sum_congr rfl fun j _ => by ring
            rw [hdistrib, hsum1, hsum2]
            ring
          · rintro x₁ x₂ ⟨a₁, rfl⟩ ⟨a₂, rfl⟩
            refine ⟨fun j => a₁ j + a₂ j, ?_⟩
            rw [← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun j _ => by ring
      have hDomL : IsDomain L := by
        have hNZD : NoZeroDivisors L := by
          refine ⟨fun {x y} hxy => ?_⟩
          by_contra h_both
          push Not at h_both
          rcases h_both with ⟨hx_ne, hy_ne⟩
          have hiInf : (⨅ n : ℕ, 𝔪_L ^ n) = ⊥ :=
            Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔪_L h𝔪_max.ne_top
          have hOrd : ∀ z : L, z ≠ 0 → ∃ d : ℕ, z ∈ 𝔪_L ^ d ∧ z ∉ 𝔪_L ^ (d + 1) := by
            intro z hz
            have hex : ∃ n : ℕ, z ∉ 𝔪_L ^ n := by
              by_contra hall
              push Not at hall
              have hz_bot : z ∈ (⊥ : Ideal L) := by
                rw [← hiInf, Ideal.mem_iInf]
                exact hall
              exact hz (Ideal.mem_bot.mp hz_bot)
            classical
            let n₀ := Nat.find hex
            have hn₀_spec : z ∉ 𝔪_L ^ n₀ := Nat.find_spec hex
            have hn₀_pos : 0 < n₀ := by
              by_contra h0
              have hn0 : n₀ = 0 := by omega
              rw [hn0, pow_zero, Ideal.one_eq_top] at hn₀_spec
              exact hn₀_spec Submodule.mem_top
            refine ⟨n₀ - 1, ?_, ?_⟩
            · by_contra hnot
              exact Nat.find_min hex (by omega : n₀ - 1 < n₀) hnot
            · have heq : n₀ - 1 + 1 = n₀ := by omega
              rwa [heq]
          obtain ⟨d₁, hxd₁, hxd₁_not⟩ := hOrd x hx_ne
          obtain ⟨d₂, hyd₂, hyd₂_not⟩ := hOrd y hy_ne
          obtain ⟨a, hx_sum⟩ := hExpand d₁ x hxd₁
          obtain ⟨b, hy_sum⟩ := hExpand d₂ y hyd₂
          have hex_a : ∃ j : ℕ, ∃ hj : j < d₁ + 1, a ⟨j, hj⟩ ∉ 𝔪_L := by
            by_contra hall
            push Not at hall
            apply hxd₁_not
            rw [hx_sum]
            refine (𝔪_L ^ (d₁ + 1)).sum_mem fun j _ => ?_
            have haj : a j ∈ 𝔪_L := hall (j : ℕ) j.isLt
            have hmon : w₁ ^ (j : ℕ) * w₂ ^ (d₁ - (j : ℕ)) ∈ 𝔪_L ^ d₁ := by
              have h_add : (j : ℕ) + (d₁ - (j : ℕ)) = d₁ := by omega
              simpa [h_add] using hMon_mem (j : ℕ) (d₁ - (j : ℕ))
            have hmul : a j * (w₁ ^ (j : ℕ) * w₂ ^ (d₁ - (j : ℕ))) ∈ 𝔪_L * 𝔪_L ^ d₁ :=
              Ideal.mul_mem_mul haj hmon
            rw [← pow_succ' 𝔪_L d₁] at hmul
            simpa [mul_assoc] using hmul
          have hex_b : ∃ k : ℕ, ∃ hk : k < d₂ + 1, b ⟨k, hk⟩ ∉ 𝔪_L := by
            by_contra hall
            push Not at hall
            apply hyd₂_not
            rw [hy_sum]
            refine (𝔪_L ^ (d₂ + 1)).sum_mem fun k _ => ?_
            have hbk : b k ∈ 𝔪_L := hall (k : ℕ) k.isLt
            have hmon : w₁ ^ (k : ℕ) * w₂ ^ (d₂ - (k : ℕ)) ∈ 𝔪_L ^ d₂ := by
              have h_add : (k : ℕ) + (d₂ - (k : ℕ)) = d₂ := by omega
              simpa [h_add] using hMon_mem (k : ℕ) (d₂ - (k : ℕ))
            have hmul : b k * (w₁ ^ (k : ℕ) * w₂ ^ (d₂ - (k : ℕ))) ∈ 𝔪_L * 𝔪_L ^ d₂ :=
              Ideal.mul_mem_mul hbk hmon
            rw [← pow_succ' 𝔪_L d₂] at hmul
            simpa [mul_assoc] using hmul
          classical
          let j_nat := Nat.find hex_a
          obtain ⟨hj₀_lt, haj₀_not⟩ := Nat.find_spec hex_a
          let j₀ : Fin (d₁ + 1) := ⟨j_nat, hj₀_lt⟩
          have hj₀_min : ∀ j : Fin (d₁ + 1), (j : ℕ) < (j₀ : ℕ) → a j ∈ 𝔪_L := by
            intro j hj_lt
            by_contra hnot
            exact Nat.find_min hex_a hj_lt ⟨j.isLt, hnot⟩
          let k_nat := Nat.find hex_b
          obtain ⟨hk₀_lt, hbk₀_not⟩ := Nat.find_spec hex_b
          let k₀ : Fin (d₂ + 1) := ⟨k_nat, hk₀_lt⟩
          have hk₀_min : ∀ k : Fin (d₂ + 1), (k : ℕ) < (k₀ : ℕ) → b k ∈ 𝔪_L := by
            intro k hk_lt
            by_contra hnot
            exact Nat.find_min hex_b hk_lt ⟨k.isLt, hnot⟩
          let c : Fin (d₁ + d₂ + 1) → L := fun m =>
            ∑ p : Fin (d₁ + 1) × Fin (d₂ + 1),
              if (p.1 : ℕ) + (p.2 : ℕ) = (m : ℕ) then a p.1 * b p.2 else 0
          have hprod_sum : (∑ m : Fin (d₁ + d₂ + 1),
              c m * w₁ ^ (m : ℕ) * w₂ ^ (d₁ + d₂ - (m : ℕ))) = x * y := by
            have hlhs : (∑ m : Fin (d₁ + d₂ + 1),
                c m * w₁ ^ (m : ℕ) * w₂ ^ (d₁ + d₂ - (m : ℕ))) =
                ∑ p : Fin (d₁ + 1) × Fin (d₂ + 1),
                  (a p.1 * w₁ ^ (p.1 : ℕ) * w₂ ^ (d₁ - (p.1 : ℕ))) *
                  (b p.2 * w₁ ^ (p.2 : ℕ) * w₂ ^ (d₂ - (p.2 : ℕ))) := by
              simp only [c, Finset.sum_mul]
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun p _ => ?_
              let m_p : Fin (d₁ + d₂ + 1) := ⟨(p.1 : ℕ) + (p.2 : ℕ), by omega⟩
              rw [Finset.sum_eq_single m_p]
              · have hm_eq : (p.1 : ℕ) + (p.2 : ℕ) = (m_p : ℕ) := rfl
                have hsub_eq : d₁ + d₂ - (m_p : ℕ) = (d₁ - (p.1 : ℕ)) + (d₂ - (p.2 : ℕ)) := by
                  change d₁ + d₂ - ((p.1 : ℕ) + (p.2 : ℕ)) = _
                  omega
                simp only [hm_eq, ↓reduceIte]
                change a p.1 * b p.2 * w₁ ^ ((p.1 : ℕ) + (p.2 : ℕ)) * w₂ ^ (d₁ + d₂ - (m_p : ℕ)) = _
                rw [hsub_eq, pow_add, pow_add]
                ring
              · intro m _ hm_ne
                have hne_val : (p.1 : ℕ) + (p.2 : ℕ) ≠ (m : ℕ) := fun h =>
                  hm_ne (Fin.ext h.symm)
                simp [hne_val]
              · intro h_abs
                exact False.elim (h_abs (Finset.mem_univ m_p))
            rw [hlhs, hx_sum, hy_sum, Finset.sum_mul]
            rw [Fintype.sum_prod_type]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Finset.mul_sum]
          have hc_mem : ∀ m : Fin (d₁ + d₂ + 1), c m ∈ 𝔪_L := by
            apply hQR (d₁ + d₂) c
            rw [hprod_sum, hxy]
            exact (𝔪_L ^ (d₁ + d₂ + 1)).zero_mem
          let m₀ : Fin (d₁ + d₂ + 1) := ⟨(j₀ : ℕ) + (k₀ : ℕ), by omega⟩
          have hcm₀_mem : c m₀ ∈ 𝔪_L := hc_mem m₀
          let p_idx : Fin (d₁ + 1) × Fin (d₂ + 1) := (j₀, k₀)
          have hsplit : c m₀ = a j₀ * b k₀ +
              ∑ p ∈ Finset.univ.erase p_idx,
                if (p.1 : ℕ) + (p.2 : ℕ) = (m₀ : ℕ) then a p.1 * b p.2 else 0 := by
            dsimp only [c]
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ p_idx)]
            simp [p_idx, m₀]
          have hrest_mem : (∑ p ∈ Finset.univ.erase p_idx,
              if (p.1 : ℕ) + (p.2 : ℕ) = (m₀ : ℕ) then a p.1 * b p.2 else 0) ∈ 𝔪_L := by
            refine 𝔪_L.sum_mem fun p hp => ?_
            have hp_ne : p ≠ p_idx := (Finset.mem_erase.mp hp).1
            split_ifs with hsum_eq
            · have hlt : (p.1 : ℕ) < (j₀ : ℕ) ∨ (p.2 : ℕ) < (k₀ : ℕ) := by
                by_contra hge
                push Not at hge
                have hj_eq : (p.1 : ℕ) = (j₀ : ℕ) := by
                  change (p.1 : ℕ) + (p.2 : ℕ) = (j₀ : ℕ) + (k₀ : ℕ) at hsum_eq
                  omega
                have hk_eq : (p.2 : ℕ) = (k₀ : ℕ) := by
                  change (p.1 : ℕ) + (p.2 : ℕ) = (j₀ : ℕ) + (k₀ : ℕ) at hsum_eq
                  omega
                exact hp_ne (Prod.ext (Fin.ext hj_eq) (Fin.ext hk_eq))
              rcases hlt with hj_lt | hk_lt
              · exact 𝔪_L.mul_mem_right (b p.2) (hj₀_min p.1 hj_lt)
              · exact 𝔪_L.mul_mem_left (a p.1) (hk₀_min p.2 hk_lt)
            · exact 𝔪_L.zero_mem
          have hab_mem : a j₀ * b k₀ ∈ 𝔪_L := by
            have hsub := 𝔪_L.sub_mem hcm₀_mem hrest_mem
            rwa [hsplit, add_sub_cancel_right] at hsub
          rcases h𝔪_max.isPrime.mem_or_mem hab_mem with ha_in | hb_in
          · exact haj₀_not ha_in
          · exact hbk₀_not hb_in
        exact NoZeroDivisors.to_isDomain L
      have hw₁_ne : w₁ ≠ 0 := by
        intro hw₁_0
        let c₁ : Fin 2 → L := fun j => if j = 0 then 0 else 1
        have hsum_0 : (∑ j : Fin 2, c₁ j * w₁ ^ (j : ℕ) * w₂ ^ (1 - (j : ℕ))) ∈ 𝔪_L ^ 2 := by
          rw [Fin.sum_univ_two]
          simp [c₁, hw₁_0]
        have h1_in : c₁ 1 ∈ 𝔪_L := hQR 1 c₁ hsum_0 1
        have h1_eq : c₁ 1 = 1 := rfl
        rw [h1_eq] at h1_in
        exact h𝔪_max.ne_top ((Ideal.eq_top_iff_one 𝔪_L).mpr h1_in)
      have hw₂_reg : ∀ y : L, w₂ * y ∈ Ideal.span ({w₁} : Set L) → y ∈ Ideal.span ({w₁} : Set L) := by
        intro y hy
        obtain ⟨x, hx_eq⟩ := Ideal.mem_span_singleton.mp hy
        have hModPow : ∀ r : ℕ, ∃ q_el : L, ∃ z ∈ 𝔪_L ^ r, y = w₁ * q_el + z := by
          intro r
          induction r with
          | zero =>
            exact ⟨0, y, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top, by ring⟩
          | succ r ih =>
            obtain ⟨q₀_el, z₀, hz₀, hy_q₀z₀⟩ := ih
            obtain ⟨a, hz₀_sum⟩ := hExpand r z₀ hz₀
            let q_sum : L := ∑ i : Fin r, a i.succ * w₁ ^ (i : ℕ) * w₂ ^ (r - (i : ℕ) - 1)
            let c₀ : L := a 0
            have hz₀_decomp : z₀ = c₀ * w₂ ^ r + w₁ * q_sum := by
              rw [hz₀_sum, Fin.sum_univ_succ]
              simp only [c₀, Fin.val_zero, pow_zero, mul_one, Nat.sub_zero, Fin.val_succ]
              congr 1
              dsimp only [q_sum]
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun i _ => ?_
              have hsub : r - ((i : ℕ) + 1) = r - (i : ℕ) - 1 := rfl
              rw [pow_succ', hsub]
              ring
            let q' : L := q₀_el + q_sum
            let x' : L := x - w₂ * q'
            have hx'_rel : w₁ * x' = c₀ * w₂ ^ (r + 1) := by
              calc w₁ * (x - w₂ * (q₀_el + q_sum))
                  = w₁ * x - w₂ * (w₁ * q₀_el + w₁ * q_sum) := by ring
                _ = w₂ * y - w₂ * (w₁ * q₀_el + w₁ * q_sum) := by rw [← hx_eq]
                _ = w₂ * (w₁ * q₀_el + (c₀ * w₂ ^ r + w₁ * q_sum)) - w₂ * (w₁ * q₀_el + w₁ * q_sum) := by
                      rw [hy_q₀z₀, hz₀_decomp]
                _ = c₀ * w₂ ^ (r + 1) := by rw [pow_succ' w₂ r]; ring
            have hx'_pow : ∀ k : ℕ, k ≤ r → x' ∈ 𝔪_L ^ k := by
              intro k
              induction k with
              | zero =>
                intro _
                rw [pow_zero, Ideal.one_eq_top]
                exact Submodule.mem_top
              | succ k ih_k =>
                intro hk_le
                have hx'_k : x' ∈ 𝔪_L ^ k := ih_k (by omega)
                obtain ⟨b, hx'_sum⟩ := hExpand k x' hx'_k
                let d_vec : Fin (k + 2) → L := Fin.cases 0 b
                have hd_sum : (∑ j : Fin (k + 2), d_vec j * w₁ ^ (j : ℕ) * w₂ ^ (k + 1 - (j : ℕ))) =
                    w₁ * x' := by
                  rw [Fin.sum_univ_succ]
                  simp only [d_vec, Fin.cases_zero, zero_mul, zero_add, Fin.cases_succ,
                    Fin.val_succ, Nat.succ_sub_succ_eq_sub, hx'_sum, Finset.mul_sum]
                  refine Finset.sum_congr rfl fun i _ => ?_
                  rw [pow_succ']
                  ring
                have hd_mem : (∑ j : Fin (k + 2), d_vec j * w₁ ^ (j : ℕ) * w₂ ^ (k + 1 - (j : ℕ))) ∈
                    𝔪_L ^ (k + 2) := by
                  rw [hd_sum, hx'_rel]
                  have hpow_mem : c₀ * w₂ ^ (r + 1) ∈ 𝔪_L ^ (r + 1) :=
                    (𝔪_L ^ (r + 1)).mul_mem_left c₀ (Ideal.pow_mem_pow hw₂_in (r + 1))
                  exact Ideal.pow_le_pow_right (by omega : k + 2 ≤ r + 1) hpow_mem
                have hd_in := hQR (k + 1) d_vec hd_mem
                rw [hx'_sum]
                refine (𝔪_L ^ (k + 1)).sum_mem fun i _ => ?_
                have hbi : b i ∈ 𝔪_L := hd_in i.succ
                have hmon : w₁ ^ (i : ℕ) * w₂ ^ (k - (i : ℕ)) ∈ 𝔪_L ^ k := by
                  have h_add : (i : ℕ) + (k - (i : ℕ)) = k := by omega
                  simpa [h_add] using hMon_mem (i : ℕ) (k - (i : ℕ))
                have hmul : b i * (w₁ ^ (i : ℕ) * w₂ ^ (k - (i : ℕ))) ∈ 𝔪_L * 𝔪_L ^ k :=
                  Ideal.mul_mem_mul hbi hmon
                rw [← pow_succ' 𝔪_L k] at hmul
                simpa [mul_assoc] using hmul
            have hx'_r : x' ∈ 𝔪_L ^ r := hx'_pow r le_rfl
