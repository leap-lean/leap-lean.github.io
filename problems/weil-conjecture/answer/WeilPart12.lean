            congr 1
            change ((P.presheaf.map (incP U₀).op ≫
              P.presheaf.map (CategoryTheory.homOfLE h').op).hom) (v_B (φ r)) = _
            rw [← Functor.map_comp, ← op_comp]
            have h_sub : CategoryTheory.homOfLE h' ≫ incP U₀ = incP U₁ := Subsingleton.elim _ _
            rw [h_sub]; rfl }
