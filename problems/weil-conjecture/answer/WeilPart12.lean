      have h_map : P_A.presheaf.map (homOfLE ((hMul_open ℓ ℓ').trans_le inf_le_left)).op ≫
          P_A.presheaf.map (eqToHom (hMul_open ℓ ℓ').symm).op =
          P_A.presheaf.map (homOfLE inf_le_left).op := by
        rw [← P_A.presheaf.map_comp]
        congr 1
      exact (congrFun (congrArg (fun f => f.hom) h_map) _).symm
    have hAwayRes_R : ∀ (ℓ ℓ' : Fin (d + 1))
        (z : HomogeneousLocalization.Away 𝒜 (X_var ℓ')),
        (P_A.presheaf.map (homOfLE (inf_le_right : D ℓ ⊓ D ℓ' ≤ D ℓ')).op).hom
