            have hXi : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ k))
                (MvPolynomial.X i) ∈ p.asIdeal := by
              fin_cases i
              · exact h0
              · exact h1
            exact p.asIdeal.mul_mem_left _ hXi
        have h_sum := p.asIdeal.add_mem (hDiff F) hC_mem
        rwa [sub_add_cancel] at h_sum
      have h_eq : RingHom.ker ev_k = p.asIdeal :=
        hMax_ev.eq_of_le p.isPrime.ne_top h_le
      exact PrimeSpectrum.ext h_eq.symm
  
  obtain ⟨_, hOpen0, hOpen1, hOpen2, hCov, _, _, _, _, _, _,
      Laur, _, φ_Laur, ξ, ξ_inv, p₀, p₁, p₂, f_02, f_12, f_20, f_21,
      _, _, hp0_map, hp1_map, hp2_map, hp_C, _, _, _, _, hp2_X0, hp2_X1, _⟩ := hData
  have hι0_base : ι₀ ≫ (p_m ≫ g_Pm) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp MvPolynomial.C)) := by
    rw [← CategoryTheory.Category.assoc, hp0_map]
    have hp0_C : p₀.comp ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) =
        (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp MvPolynomial.C :=
      RingHom.ext fun c => (hp_C c).1
    have h_map := congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) hp0_C
    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp] at h_map
    exact h_map
  have hι1_base : ι₁ ≫ (p_m ≫ g_Pm) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp MvPolynomial.C)) := by
    rw [← CategoryTheory.Category.assoc, hp1_map]
    have hp1_C : p₁.comp ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) =
        (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp MvPolynomial.C :=
      RingHom.ext fun c => (hp_C c).2.1
    have h_map := congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) hp1_C
    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp] at h_map
    exact h_map
  have hι2_base : ι₂ ≫ (p_m ≫ g_Pm) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))).comp MvPolynomial.C)) := by
    rw [← CategoryTheory.Category.assoc, hp2_map]
    have hp2_C : p₂.comp ((Ideal.Quotient.mk J_m).comp MvPolynomial.C) =
        (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))).comp MvPolynomial.C :=
      RingHom.ext fun c => (hp_C c).2.2
    have h_map := congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) hp2_C
    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp] at h_map
    exact h_map
  
  have hOuterChart : ∀ (ι : AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot RStar (X_ps ^ 1))) ⟶ M_m)
      (_ : AlgebraicGeometry.IsOpenImmersion ι),
      ι ≫ (p_m ≫ g_Pm) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1))).comp MvPolynomial.C)) →
      ∀ y ∈ Set.range ι.base,
        (∃ V : M_m.Opens, y ∈ V ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_m ≫ g_Pm)) ∨
        HasPowerSeriesNodalRoofAt Ω (p_m ≫ g_Pm) y 1 := by
    intro ι hOpen hBase y ⟨p, hp_y⟩
    rw [← hp_y]
    obtain ⟨v0, _, _, _, hRoof, hUniq⟩ := hPosK 1 le_rfl ι hOpen hBase
    by_cases h0 : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0) ∈ p.asIdeal
    · by_cases h1 : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 1) ∈ p.asIdeal
      · rw [hUniq p h0 h1]
        exact Or.inr hRoof
      · exact Or.inl (hSmoothCoord 1 ι hOpen hBase p (Or.inr h1))
    · exact Or.inl (hSmoothCoord 1 ι hOpen hBase p (Or.inl h0))
  
  by_cases hm3 : m ≤ 3
  · left
    refine ⟨hm3, fun y => ?_⟩
    have hy_univ : y ∈ (Set.range ι₀.base ∪ Set.range ι₁.base ∪ Set.range ι₂.base) := by
      rw [hCov]; exact Set.mem_univ y
    rcases hy_univ with (hy0 | hy1) | ⟨p, hp_y⟩
    · exact hOuterChart ι₀ hOpen0 hι0_base y hy0
    · exact hOuterChart ι₁ hOpen1 hι1_base y hy1
    · rw [← hp_y]
      have hm23 : m = 2 ∨ m = 3 := by omega
      rcases hm23 with rfl | rfl
      · exact Or.inl (hSmoothCoord (2 - 2) ι₂ hOpen2 hι2_base p
          (Or.inl (hZeroK (2 - 2) rfl p)))
      · obtain ⟨v0, _, _, _, hRoof, hUniq⟩ := hPosK (3 - 2) (by omega) ι₂ hOpen2 hι2_base
        by_cases h0 : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (3 - 2)))
            (MvPolynomial.X 0) ∈ p.asIdeal
        · by_cases h1 : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (3 - 2)))
              (MvPolynomial.X 1) ∈ p.asIdeal
          · rw [hUniq p h0 h1]
            exact Or.inr hRoof
          · exact Or.inl (hSmoothCoord (3 - 2) ι₂ hOpen2 hι2_base p (Or.inr h1))
        · exact Or.inl (hSmoothCoord (3 - 2) ι₂ hOpen2 hι2_base p (Or.inl h0))
  · right
    have hm4 : 4 ≤ m := by omega
    have h1k : 1 ≤ m - 2 := by omega
    obtain ⟨v0, ev_m2, hv0_ker, hev_mk, hRoof_sing, hUniq⟩ :=
      hPosK (m - 2) h1k ι₂ hOpen2 hι2_base
    refine ⟨hm4, ι₂.base v0, ?_, hRoof_sing, ?_⟩
    · let q_sing : PrimeSpectrum P_m := p_m.base (ι₂.base v0)
      let v0' : PrimeSpectrum (weilNodalQuot (PowerSeries Ω) (PowerSeries.X ^ (m - 2))) := v0
      change q_sing ∈ PrimeSpectrum.zeroLocus (I_nod : Set P_m)
      rw [PrimeSpectrum.mem_zeroLocus]
      change I_nod ≤ q_sing.asIdeal
      have hp_asIdeal : q_sing.asIdeal = Ideal.comap p₂ (RingHom.ker ev_m2) := by
        have hpt : q_sing = PrimeSpectrum.comap p₂ v0' := by
          change p_m.base (ι₂.base v0) =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₂)).base v0
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply ι₂ p_m v0, hp2_map]
        exact (congrArg PrimeSpectrum.asIdeal hpt).trans (congrArg (Ideal.comap p₂) hv0_ker)
      rw [hp_asIdeal, Ideal.span_le]
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
      rcases hz with rfl | rfl | rfl
      · rw [hp2_X0, hev_mk]
        simp [ev_tilde]
      · rw [hp2_X1, hev_mk]
        simp [ev_tilde]
      · rw [(hp_C X_ps).2.2, hev_mk]
        simp [ev_tilde, X_ps, PowerSeries.constantCoeff_X]
    · intro y hy_ne
      have hy_univ : y ∈ (Set.range ι₀.base ∪ Set.range ι₁.base ∪ Set.range ι₂.base) := by
        rw [hCov]; exact Set.mem_univ y
      rcases hy_univ with (hy0 | hy1) | ⟨p, hp_y⟩
      · exact hOuterChart ι₀ hOpen0 hι0_base y hy0
      · exact hOuterChart ι₁ hOpen1 hι1_base y hy1
      · rw [← hp_y]
        by_cases h0 : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
            (MvPolynomial.X 0) ∈ p.asIdeal
        · by_cases h1 : Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
              (MvPolynomial.X 1) ∈ p.asIdeal
          · exfalso
            apply hy_ne
            rw [← hp_y, hUniq p h0 h1]
          · exact Or.inl (hSmoothCoord (m - 2) ι₂ hOpen2 hι2_base p (Or.inr h1))
        · exact Or.inl (hSmoothCoord (m - 2) ι₂ hOpen2 hι2_base p (Or.inl h0))

theorem weil_powerSeries_blowup_special_fiber_chain_and_connected (Ω : Type u) [Field Ω]
    [IsAlgClosed Ω] (m : ℕ) (hm : 2 ≤ m)
    (hAff_Ω : ∀ a : Fin 2, AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen Ω 1 a))
    (c_Ω : ∀ a : Fin 2,
      Ω →+* ↑((weilProjectiveSpaceOver Ω 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen Ω 1 a))))
    (t_Ω : ∀ a : Fin 2, Fin 2 →
      ↑((weilProjectiveSpaceOver Ω 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen Ω 1 a))))
    (hProjΩ : IsCommRingProjCoordSystem Ω 1 hAff_Ω c_Ω t_Ω)
    (M_m : AlgebraicGeometry.Scheme.{u})
    (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))))
    (ι₀ ι₁ : AlgebraicGeometry.Spec (CommRingCat.of
      (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1))) ⟶ M_m)
    (ι₂ : AlgebraicGeometry.Spec (CommRingCat.of
      (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)))) ⟶ M_m)
    (hData : IsPowerSeriesThreeChartBlowupData Ω m p_m ι₀ ι₁ ι₂)
    (hIsoCompl :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      let P_m := MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m
      let I_nod : Ideal P_m := Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
      CategoryTheory.IsIso
        (p_m ∣_ ⟨(PrimeSpectrum.zeroLocus (I_nod : Set P_m))ᶜ,
          (PrimeSpectrum.isClosed_zeroLocus (I_nod : Set P_m)).isOpen_compl⟩)) :
    let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
        Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
    let P_m := MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m
    let I_nod : Ideal P_m := Ideal.span
      {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
       Ideal.Quotient.mk J_m (MvPolynomial.X 1),
       Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
    let g_Pm : AlgebraicGeometry.Spec (CommRingCat.of P_m) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C))
    let s_Ω := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (PowerSeries.constantCoeff : PowerSeries Ω →+* Ω))
    AlgebraicGeometry.Surjective p_m ∧
    (∀ q₀ : AlgebraicGeometry.Spec (CommRingCat.of P_m),
      _root_.IsConnected (p_m.base ⁻¹' {q₀})) ∧
    (let Y_m := CategoryTheory.Limits.pullback (p_m ≫ g_Pm) s_Ω
     let fst_m := CategoryTheory.Limits.pullback.fst (p_m ≫ g_Pm) s_Ω
     let snd_m := CategoryTheory.Limits.pullback.snd (p_m ≫ g_Pm) s_Ω
     ∃ (k_exc : ℕ) (E_exc : Fin k_exc → AlgebraicGeometry.Scheme.{u})
       (ι_exc : ∀ a : Fin k_exc, E_exc a ⟶ Y_m)
       (iso_exc : ∀ a : Fin k_exc, E_exc a ≅ (weilProjectiveSpaceOver Ω 1).left)
       (L_br : Fin 2 → Set ↥Y_m),
       1 ≤ k_exc ∧
       (∀ a : Fin k_exc, AlgebraicGeometry.IsClosedImmersion (ι_exc a) ∧
         AlgebraicGeometry.IsIntegral (E_exc a) ∧
         Set.range (ι_exc a).base ∈ irreducibleComponents ↥Y_m ∧
         ι_exc a ≫ snd_m = (iso_exc a).hom ≫ (weilProjectiveSpaceOver Ω 1).hom) ∧
       (∀ b : Fin 2, L_br b ∈ irreducibleComponents ↥Y_m ∧
         (L_br b ∩ {q : ↥Y_m | p_m.base (fst_m.base q) ∉
