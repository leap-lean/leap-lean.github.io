          = η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
              (η₁ g₁ * g₁_inv) := by ring
        _ = η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) := by
            rw [hg₁_mul, mul_one]
    obtain ⟨ψ₁, hψ₁_C, hψ₁_X0, hψ₁_X1⟩ :=
      nodal_lift_pkg (X_ps ^ 1)
        (η₁.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp MvPolynomial.C))
        (η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) * g₁_inv)
        (η₁ g₁) hψ₁_rel
    have hLoc₁_std :
        @IsLocalization.Away (weilNodalQuot RStar (X_ps ^ m)) _ g₁
          (Localization.Away (p₁ g₁)) _
          ((algebraMap (weilNodalQuot RStar (X_ps ^ 1)) (Localization.Away (p₁ g₁))).comp
            p₁).toAlgebra := by
      apply comp_away_isLocalization p₁ g₁ ψ₁
      · apply nodalHom_ext
        · intro c
          rw [RingHom.comp_apply, hp₁_C c, RingHom.comp_apply, hψ₁_C c]
          rfl
        · rw [RingHom.comp_apply, hp₁_X0, map_mul, map_mul, hψ₁_C, hψ₁_X0]
          simp only [RingHom.comp_apply]
          calc η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ (m - 1)))) *
                (η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
                  g₁_inv)
              = η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                  (MvPolynomial.C (X_ps ^ m))) * g₁_inv := by
                rw [← mul_assoc, ← map_mul, ← map_mul, ← map_mul, ← hXps_m1]
            _ = η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0) *
                  g₁) * g₁_inv := by
                rw [← nodal_rel (X_ps ^ m)]
            _ = η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) *
                  (η₁ g₁ * g₁_inv) := by
                rw [map_mul]; ring
            _ = η₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) := by
                rw [hg₁_mul, mul_one]
        · rw [RingHom.comp_apply, hp₁_X1, hψ₁_X1]
      · intro α hα_eq hα_inv
        apply nodalHom_ext
        · intro r
          rw [RingHom.comp_apply, hψ₁_C r, RingHom.comp_apply, RingHom.comp_apply,
            hα_eq, hp₁_C r, RingHom.comp_apply]
        · rw [RingHom.comp_apply, hψ₁_X0, map_mul, hα_eq, hα_inv]
          have hp₁_x :
              p₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) =
              Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0) * p₁ g₁ := by
            rw [hp₁_C X_ps, RingHom.comp_apply, hp₁_X1, nodal_rel (X_ps ^ 1), pow_one]
          rw [hp₁_x, map_mul]
          calc (algebraMap (weilNodalQuot RStar (X_ps ^ 1)) (Localization.Away (p₁ g₁))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0)) *
                algebraMap (weilNodalQuot RStar (X_ps ^ 1)) (Localization.Away (p₁ g₁)) (p₁ g₁)) *
                IsLocalization.Away.invSelf (S := Localization.Away (p₁ g₁)) (p₁ g₁)
              = algebraMap (weilNodalQuot RStar (X_ps ^ 1)) (Localization.Away (p₁ g₁))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0)) *
                (algebraMap (weilNodalQuot RStar (X_ps ^ 1)) (Localization.Away (p₁ g₁)) (p₁ g₁) *
                  IsLocalization.Away.invSelf (S := Localization.Away (p₁ g₁)) (p₁ g₁)) := by ring
            _ = algebraMap (weilNodalQuot RStar (X_ps ^ 1)) (Localization.Away (p₁ g₁))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ 1)) (MvPolynomial.X 0)) := by
                rw [IsLocalization.Away.mul_invSelf (p₁ g₁), mul_one]
        · rw [RingHom.comp_apply, hψ₁_X1, hα_eq g₁, hp₁_X1]
    exact comp_away_transfer p₁ g₁ hLoc₁_std

  have hAway₂ :
      ∀ (C_loc : Type u) [CommRing C_loc] [Algebra (weilNodalQuot RStar (X_ps ^ (m - 2))) C_loc],
        IsLocalization.Away
          (p₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps))) C_loc →
        @IsLocalization.Away (weilNodalQuot RStar (X_ps ^ m)) _
          (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) C_loc _
          ((algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) C_loc).comp p₂).toAlgebra := by
    let g₂ : weilNodalQuot RStar (X_ps ^ m) :=
      Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)
    let L₂ : Type u := Localization.Away g₂
    let η₂ : weilNodalQuot RStar (X_ps ^ m) →+* L₂ :=
      algebraMap (weilNodalQuot RStar (X_ps ^ m)) L₂
    let g₂_inv : L₂ := IsLocalization.Away.invSelf (S := L₂) g₂
    have hg₂_mul : η₂ g₂ * g₂_inv = 1 := IsLocalization.Away.mul_invSelf g₂
    have hψ₂_rel :
        (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) * g₂_inv) *
          (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) * g₂_inv) =
          (η₂.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp
            MvPolynomial.C)) (X_ps ^ (m - 2)) := by
      simp only [RingHom.comp_apply]
      calc (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) * g₂_inv) *
            (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) * g₂_inv)
          = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0) *
              Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) *
              g₂_inv ^ 2 := by
            rw [map_mul]; ring
        _ = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
              (MvPolynomial.C (X_ps ^ m))) * g₂_inv ^ 2 := by
            rw [nodal_rel (X_ps ^ m)]
        _ = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
              (MvPolynomial.C (X_ps ^ (m - 2)))) *
              ((η₂ g₂) ^ 2 * g₂_inv ^ 2) := by
            have hC_m2 :
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                  (MvPolynomial.C (X_ps ^ m)) =
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                  (MvPolynomial.C (X_ps ^ (m - 2))) * g₂ ^ 2 := by
              have h1 :
                  Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                    (MvPolynomial.C (X_ps ^ m)) =
                  Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                    (MvPolynomial.C (X_ps ^ (m - 2) * X_ps ^ 2)) :=
                congrArg
                  (fun r => Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C r))
                  hXps_m2
              rw [h1, pow_two, map_mul, map_mul, map_mul, map_mul]
              ring
            rw [hC_m2, map_mul, map_pow η₂ g₂ 2, mul_assoc]
        _ = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
              (MvPolynomial.C (X_ps ^ (m - 2)))) := by
            rw [← mul_pow, hg₂_mul, one_pow, mul_one]
    obtain ⟨ψ₂, hψ₂_C, hψ₂_X0, hψ₂_X1⟩ :=
      nodal_lift_pkg (X_ps ^ (m - 2))
        (η₂.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp MvPolynomial.C))
        (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) * g₂_inv)
        (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) * g₂_inv)
        hψ₂_rel
    have hLoc₂_std :
        @IsLocalization.Away (weilNodalQuot RStar (X_ps ^ m)) _ g₂
          (Localization.Away (p₂ g₂)) _
          ((algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) (Localization.Away (p₂ g₂))).comp
            p₂).toAlgebra := by
      apply comp_away_isLocalization p₂ g₂ ψ₂
      · apply nodalHom_ext
        · intro c
          rw [RingHom.comp_apply, hp₂_C c, RingHom.comp_apply, hψ₂_C c]
          rfl
        · rw [RingHom.comp_apply, hp₂_X0, map_mul, map_mul, hψ₂_C X_ps, hψ₂_X0]
          simp only [RingHom.comp_apply]
          calc η₂ g₂ *
                (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) *
                  g₂_inv)
              = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) *
                  (η₂ g₂ * g₂_inv) := by ring
            _ = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) := by
                rw [hg₂_mul, mul_one]
        · rw [RingHom.comp_apply, hp₂_X1, map_mul, map_mul, hψ₂_C X_ps, hψ₂_X1]
          simp only [RingHom.comp_apply]
          calc η₂ g₂ *
                (η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) *
                  g₂_inv)
              = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) *
                  (η₂ g₂ * g₂_inv) := by ring
            _ = η₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) := by
                rw [hg₂_mul, mul_one]
      · intro α hα_eq hα_inv
        apply nodalHom_ext
        · intro r
          rw [RingHom.comp_apply, hψ₂_C r, RingHom.comp_apply, RingHom.comp_apply,
            hα_eq, hp₂_C r, RingHom.comp_apply]
        · rw [RingHom.comp_apply, hψ₂_X0, map_mul, hα_eq, hα_inv]
          have hp₂_x0 :
              p₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) =
              p₂ g₂ *
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.X 0) := by
            rw [hp₂_X0, map_mul, hp₂_C X_ps, RingHom.comp_apply]
          rw [hp₂_x0, map_mul]
          calc (algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2)))
                  (Localization.Away (p₂ g₂)) (p₂ g₂) *
                algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) (Localization.Away (p₂ g₂))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
                    (MvPolynomial.X 0))) *
                IsLocalization.Away.invSelf (S := Localization.Away (p₂ g₂)) (p₂ g₂)
              = algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) (Localization.Away (p₂ g₂))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
                    (MvPolynomial.X 0)) *
                (algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2)))
                    (Localization.Away (p₂ g₂)) (p₂ g₂) *
                  IsLocalization.Away.invSelf (S := Localization.Away (p₂ g₂)) (p₂ g₂)) := by ring
            _ = algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) (Localization.Away (p₂ g₂))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
                    (MvPolynomial.X 0)) := by
                rw [IsLocalization.Away.mul_invSelf (p₂ g₂), mul_one]
        · rw [RingHom.comp_apply, hψ₂_X1, map_mul, hα_eq, hα_inv]
          have hp₂_x1 :
              p₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) =
              p₂ g₂ *
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2))) (MvPolynomial.X 1) := by
            rw [hp₂_X1, map_mul, hp₂_C X_ps, RingHom.comp_apply]
          rw [hp₂_x1, map_mul]
          calc (algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2)))
                  (Localization.Away (p₂ g₂)) (p₂ g₂) *
                algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) (Localization.Away (p₂ g₂))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
                    (MvPolynomial.X 1))) *
                IsLocalization.Away.invSelf (S := Localization.Away (p₂ g₂)) (p₂ g₂)
              = algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) (Localization.Away (p₂ g₂))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
                    (MvPolynomial.X 1)) *
                (algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2)))
                    (Localization.Away (p₂ g₂)) (p₂ g₂) *
                  IsLocalization.Away.invSelf (S := Localization.Away (p₂ g₂)) (p₂ g₂)) := by ring
            _ = algebraMap (weilNodalQuot RStar (X_ps ^ (m - 2))) (Localization.Away (p₂ g₂))
                  (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ (m - 2)))
                    (MvPolynomial.X 1)) := by
                rw [IsLocalization.Away.mul_invSelf (p₂ g₂), mul_one]
    exact comp_away_transfer p₂ g₂ hLoc₂_std

  
  have hInter :
      ∀ z : L, (∃ c₀, ι₀ c₀ = z) → (∃ c₁, ι₁ c₁ = z) →
        ∃ a : weilNodalQuot RStar (X_ps ^ m), ι_base a = z := by
    intro z ⟨c₀, hc₀⟩ ⟨c₁, hc₁⟩
    obtain ⟨N₀, α₀, α, β, hc₀_nf⟩ := nodal_normal_form c₀
    obtain ⟨N₁, γ₀, γ, δ, hc₁_nf⟩ := nodal_normal_form c₁
    let N := max N₀ N₁
    let α' : ℕ → RStar := fun i => if i < N₀ then α i else 0
    let β' : ℕ → RStar := fun j => if j < N₀ then β j else 0
    let γ' : ℕ → RStar := fun i => if i < N₁ then γ i else 0
    let δ' : ℕ → RStar := fun j => if j < N₁ then δ j else 0
    have hc₀_pad : c₀ = nfEval (X_ps ^ 1) N α₀ α' β' := by
      rw [hc₀_nf, ← nodal_nf_pad (X_ps ^ 1) (le_max_left N₀ N₁) α₀ α β]
    have hc₁_pad : c₁ = nfEval (X_ps ^ 1) N γ₀ γ' δ' := by
      rw [hc₁_nf, ← nodal_nf_pad (X_ps ^ 1) (le_max_right N₀ N₁) γ₀ γ δ]
    have heq_L :
        laurSeries N (η_K α₀) (fun i => η_K (α' i) * (1 : K_X) ^ (i + 1))
          (fun j => η_K (β' j) * (X_K ^ 1) ^ (j + 1)) =
        laurSeries N (η_K γ₀) (fun i => η_K (γ' i) * (X_K_inv ^ (m - 1)) ^ (i + 1))
          (fun j => η_K (δ' j) * (X_K ^ m) ^ (j + 1)) := by
      rw [← hι₀_nf, ← hι₁_nf, ← hc₀_pad, ← hc₁_pad, hc₀, hc₁]
    obtain ⟨hsh0, _, _, hneg0⟩ := laurent_poly_shift_coeff N (η_K α₀)
      (fun i => η_K (α' i) * (1 : K_X) ^ (i + 1))
      (fun j => η_K (β' j) * (X_K ^ 1) ^ (j + 1))
    obtain ⟨hsh1, _, _, hneg1⟩ := laurent_poly_shift_coeff N (η_K γ₀)
      (fun i => η_K (γ' i) * (X_K_inv ^ (m - 1)) ^ (i + 1))
      (fun j => η_K (δ' j) * (X_K ^ m) ^ (j + 1))
    have hpoly_eq :
        shiftPoly N (η_K α₀) (fun i => η_K (α' i) * (1 : K_X) ^ (i + 1))
          (fun j => η_K (β' j) * (X_K ^ 1) ^ (j + 1)) =
        shiftPoly N (η_K γ₀) (fun i => η_K (γ' i) * (X_K_inv ^ (m - 1)) ^ (i + 1))
          (fun j => η_K (δ' j) * (X_K ^ m) ^ (j + 1)) := by
      apply hηL_inj
      rw [← hsh0, ← hsh1, heq_L]
    have hneg_eq : ∀ j < N,
        η_K (δ' j) * (X_K ^ m) ^ (j + 1) = η_K (β' j) * (X_K ^ 1) ^ (j + 1) := by
      intro j hj
      rw [← hneg1 j hj, ← hneg0 j hj, hpoly_eq]
    refine ⟨nfEval (X_ps ^ m) N α₀ α' δ', ?_⟩
    rw [← hc₀, hc₀_pad, hι_base_nf, hι₀_nf]
    dsimp only [laurSeries]
    congr 1
    apply Finset.sum_congr rfl
    intro j hj
    rw [hneg_eq j (Finset.mem_range.mp hj)]

  
  have hUniv_01OF :
      ∀ (B : Type u) [CommRing B] (θ : weilNodalQuot RStar (X_ps ^ m) →+* B) (d : B),
        d ∈ nonZeroDivisors B →
        Ideal.map θ I_nod = Ideal.span {d} →
        ∃ (b₀ b₁ b₂ : B),
          Ideal.span {b₀, b₁, b₂} = ⊤ ∧
          (∀ (B₀ : Type u) [CommRing B₀] [Algebra B B₀],
            IsLocalization.Away b₀ B₀ →
            ∃ lam₀ : weilNodalQuot RStar (X_ps ^ 1) →+* B₀,
              lam₀.comp p₀ = (algebraMap B B₀).comp θ) ∧
          (∀ (B₁ : Type u) [CommRing B₁] [Algebra B B₁],
            IsLocalization.Away b₁ B₁ →
            ∃ lam₁ : weilNodalQuot RStar (X_ps ^ 1) →+* B₁,
              lam₁.comp p₁ = (algebraMap B B₁).comp θ) ∧
          (∀ (B₂ : Type u) [CommRing B₂] [Algebra B B₂],
            IsLocalization.Away b₂ B₂ →
            ∃ lam₂ : weilNodalQuot RStar (X_ps ^ (m - 2)) →+* B₂,
              lam₂.comp p₂ = (algebraMap B B₂).comp θ) := by
    intro B _ θ d hd_nzd hmap_d
    have hmem₀ :
        θ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) ∈
          Ideal.span {d} := by
      rw [← hmap_d]
      exact Ideal.mem_map_of_mem θ (Ideal.subset_span (by simp))
    have hmem₁ :
        θ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) ∈
          Ideal.span {d} := by
      rw [← hmap_d]
      exact Ideal.mem_map_of_mem θ (Ideal.subset_span (by simp))
    have hmem₂ :
        θ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) ∈
          Ideal.span {d} := by
      rw [← hmap_d]
      exact Ideal.mem_map_of_mem θ (Ideal.subset_span (by simp))
    obtain ⟨b₀, hb₀⟩ := Ideal.mem_span_singleton.mp hmem₀
    obtain ⟨b₁, hb₁⟩ := Ideal.mem_span_singleton.mp hmem₁
    obtain ⟨b₂, hb₂⟩ := Ideal.mem_span_singleton.mp hmem₂
    let J_B : Ideal B := Ideal.span {b₀, b₁, b₂}
    have hspan_top : J_B = ⊤ := by
      let M_d : Ideal B :=
        { carrier := {x : B | ∃ q ∈ J_B, x = d * q}
          add_mem' := by
            rintro _ _ ⟨q₁, hq₁, rfl⟩ ⟨q₂, hq₂, rfl⟩
            exact ⟨q₁ + q₂, J_B.add_mem hq₁ hq₂, (mul_add d q₁ q₂).symm⟩
          zero_mem' := ⟨0, J_B.zero_mem, (mul_zero d).symm⟩
          smul_mem' := by
            rintro r _ ⟨q, hq, rfl⟩
            refine ⟨r * q, J_B.mul_mem_left r hq, ?_⟩
            change r * (d * q) = d * (r * q)
            ring }
      have hle : Ideal.span {d} ≤ M_d := by
        rw [← hmap_d, Ideal.map_span, Ideal.span_le]
        rintro y ⟨x, hx, rfl⟩
        rcases hx with rfl | rfl | rfl
        · exact ⟨b₀, Ideal.subset_span (by simp), hb₀⟩
        · exact ⟨b₁, Ideal.subset_span (by simp), hb₁⟩
        · exact ⟨b₂, Ideal.subset_span (by simp), hb₂⟩
      obtain ⟨q, hq_mem, hd_eq⟩ := hle (Ideal.mem_span_singleton_self d)
      have hq_sub : d * (q - 1) = 0 := by
        rw [mul_sub, mul_one, ← hd_eq, sub_self]
      have hq_one : q = 1 :=
        sub_eq_zero.mp ((mul_left_mem_nonZeroDivisors_eq_zero_iff hd_nzd).mp hq_sub)
      rw [hq_one] at hq_mem
      exact (Ideal.eq_top_iff_one J_B).mpr hq_mem
    have cancel_db : ∀ (b : B) (B' : Type u) [CommRing B'] [Algebra B B'],
        IsLocalization.Away b B' →
        ∀ x y : B', algebraMap B B' (d * b) * x = algebraMap B B' (d * b) * y → x = y := by
      intro b B' _ _ hLocB' x y hxy
      have hd'_nzd : algebraMap B B' d ∈ nonZeroDivisors B' :=
        IsLocalization.map_nonZeroDivisors_le (Submonoid.powers b) B'
          (Submonoid.mem_map_of_mem (algebraMap B B') hd_nzd)
      have hsub : algebraMap B B' d * (algebraMap B B' b * (x - y)) = 0 := by
        have h1 : algebraMap B B' (d * b) * (x - y) = 0 := by
          rw [mul_sub, sub_eq_zero]
          exact hxy
        rw [map_mul, mul_assoc] at h1
        exact h1
      have hb_zero : algebraMap B B' b * (x - y) = 0 :=
        (mul_left_mem_nonZeroDivisors_eq_zero_iff hd'_nzd).mp hsub
      let b_inv : B' := IsLocalization.Away.invSelf (S := B') b
      have hb_mul : algebraMap B B' b * b_inv = 1 := IsLocalization.Away.mul_invSelf b
      have hxy0 : x - y = 0 := by
        calc x - y
            = (b_inv * algebraMap B B' b) * (x - y) := by
              rw [mul_comm b_inv, hb_mul, one_mul]
          _ = b_inv * (algebraMap B B' b * (x - y)) := by ring
          _ = 0 := by rw [hb_zero, mul_zero]
      exact sub_eq_zero.mp hxy0
    refine ⟨b₀, b₁, b₂, hspan_top, ?_, ?_, ?_⟩
    · intro B₀ _ _ hLoc₀
      let η₀ := algebraMap B B₀
      let θ₀ := η₀.comp θ
      let b₀_inv : B₀ := IsLocalization.Away.invSelf (S := B₀) b₀
      have hb₀_mul : η₀ b₀ * b₀_inv = 1 := IsLocalization.Away.mul_invSelf b₀
      let q₂₀ : B₀ := η₀ b₂ * b₀_inv
      have hrel₀ :
          θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) * q₂₀ =
            (θ₀.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp
              MvPolynomial.C)) (X_ps ^ 1) := by
        simp only [θ₀, RingHom.comp_apply, pow_one, hb₀, hb₂, q₂₀, map_mul]
        calc (η₀ d * η₀ b₀) * (η₀ b₂ * b₀_inv)
            = (η₀ d * η₀ b₂) * (η₀ b₀ * b₀_inv) := by ring
          _ = η₀ d * η₀ b₂ := by rw [hb₀_mul, mul_one]
      obtain ⟨lam₀, hlam₀_C, hlam₀_X0, hlam₀_X1⟩ :=
        nodal_lift_pkg (X_ps ^ 1)
          (θ₀.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp MvPolynomial.C))
          (θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)))
          q₂₀ hrel₀
      refine ⟨lam₀, ?_⟩
      apply nodalHom_ext
      · intro c
        rw [RingHom.comp_apply, hp₀_C c, RingHom.comp_apply, hlam₀_C c]
        rfl
      · rw [RingHom.comp_apply, hp₀_X0, hlam₀_X0]
      · rw [RingHom.comp_apply, hp₀_X1, map_mul, map_mul, hlam₀_C, hlam₀_X1]
        simp only [RingHom.comp_apply]
        apply cancel_db b₀ B₀ hLoc₀
        have hx0_eq :
            η₀ (d * b₀) =
              θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) := by
          simp only [θ₀, RingHom.comp_apply, hb₀]
        rw [hx0_eq]
        have hr :
            θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) * q₂₀ =
              θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) := by
          have h := hrel₀
          simp only [RingHom.comp_apply, pow_one] at h
          exact h
        calc θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) *
              (θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ (m - 1)))) * q₂₀)
            = θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ (m - 1)))) *
                (θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) *
                  q₂₀) := by ring
          _ = θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ (m - 1)))) *
                θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                  (MvPolynomial.C X_ps)) := by rw [hr]
          _ = θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ m))) := by
              rw [← map_mul, ← map_mul, ← map_mul, ← hXps_m1]
          _ = θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0) *
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) := by
              rw [nodal_rel (X_ps ^ m)]
          _ = θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) *
                θ₀ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) := by
              rw [map_mul]
    · intro B₁ _ _ hLoc₁
      let η₁ := algebraMap B B₁
      let θ₁ := η₁.comp θ
      let b₁_inv : B₁ := IsLocalization.Away.invSelf (S := B₁) b₁
      have hb₁_mul : η₁ b₁ * b₁_inv = 1 := IsLocalization.Away.mul_invSelf b₁
      let q₂₁ : B₁ := η₁ b₂ * b₁_inv
      have hrel₁ :
          q₂₁ * θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) =
            (θ₁.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp
              MvPolynomial.C)) (X_ps ^ 1) := by
        simp only [θ₁, RingHom.comp_apply, pow_one, hb₁, hb₂, q₂₁, map_mul]
        calc (η₁ b₂ * b₁_inv) * (η₁ d * η₁ b₁)
            = (η₁ d * η₁ b₂) * (η₁ b₁ * b₁_inv) := by ring
          _ = η₁ d * η₁ b₂ := by rw [hb₁_mul, mul_one]
      obtain ⟨lam₁, hlam₁_C, hlam₁_X0, hlam₁_X1⟩ :=
        nodal_lift_pkg (X_ps ^ 1)
          (θ₁.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp MvPolynomial.C))
          q₂₁ (θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)))
          hrel₁
      refine ⟨lam₁, ?_⟩
      apply nodalHom_ext
      · intro c
        rw [RingHom.comp_apply, hp₁_C c, RingHom.comp_apply, hlam₁_C c]
        rfl
      · rw [RingHom.comp_apply, hp₁_X0, map_mul, map_mul, hlam₁_C, hlam₁_X0]
        simp only [RingHom.comp_apply]
        apply cancel_db b₁ B₁ hLoc₁
        have hx1_eq :
            η₁ (d * b₁) =
              θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) := by
          simp only [θ₁, RingHom.comp_apply, hb₁]
        rw [hx1_eq]
        have hr :
            q₂₁ * θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) =
              θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) := by
          have h := hrel₁
          simp only [RingHom.comp_apply, pow_one] at h
          exact h
        calc θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) *
              (θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ (m - 1)))) * q₂₁)
            = θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ (m - 1)))) *
                (q₂₁ * θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                  (MvPolynomial.X 1))) := by ring
          _ = θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ (m - 1)))) *
                θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                  (MvPolynomial.C X_ps)) := by rw [hr]
          _ = θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ m))) := by
              rw [← map_mul, ← map_mul, ← map_mul, ← hXps_m1]
          _ = θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0) *
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) := by
              rw [nodal_rel (X_ps ^ m)]
          _ = θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) *
                θ₁ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) := by
              rw [map_mul, mul_comm]
      · rw [RingHom.comp_apply, hp₁_X1, hlam₁_X1]
    · intro B₂ _ _ hLoc₂
      let η₂ := algebraMap B B₂
      let θ₂ := η₂.comp θ
      let b₂_inv : B₂ := IsLocalization.Away.invSelf (S := B₂) b₂
      have hb₂_mul : η₂ b₂ * b₂_inv = 1 := IsLocalization.Away.mul_invSelf b₂
      let u₃ : B₂ := η₂ b₀ * b₂_inv
      let v₃ : B₂ := η₂ b₁ * b₂_inv
      have hx2_eq :
          η₂ (d * b₂) =
            θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) := by
        simp only [θ₂, RingHom.comp_apply, hb₂]
      have hu₃_mul :
          θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) * u₃ =
            θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0)) := by
        rw [← hx2_eq]
        simp only [θ₂, RingHom.comp_apply, hb₀, u₃, map_mul]
        calc (η₂ d * η₂ b₂) * (η₂ b₀ * b₂_inv)
            = (η₂ d * η₂ b₀) * (η₂ b₂ * b₂_inv) := by ring
          _ = η₂ d * η₂ b₀ := by rw [hb₂_mul, mul_one]
      have hv₃_mul :
          θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) * v₃ =
            θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) := by
        rw [← hx2_eq]
        simp only [θ₂, RingHom.comp_apply, hb₁, v₃, map_mul]
        calc (η₂ d * η₂ b₂) * (η₂ b₁ * b₂_inv)
            = (η₂ d * η₂ b₁) * (η₂ b₂ * b₂_inv) := by ring
          _ = η₂ d * η₂ b₁ := by rw [hb₂_mul, mul_one]
      have hrel₂ :
          u₃ * v₃ =
            (θ₂.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp
              MvPolynomial.C)) (X_ps ^ (m - 2)) := by
        simp only [RingHom.comp_apply]
        apply cancel_db b₂ B₂ hLoc₂
        apply cancel_db b₂ B₂ hLoc₂
        rw [hx2_eq]
        calc θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
              (θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
                (u₃ * v₃))
            = (θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
                  u₃) *
                (θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
                  v₃) := by ring
          _ = θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 0) *
                Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.X 1)) := by
              rw [hu₃_mul, hv₃_mul, ← map_mul]
          _ = θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                (MvPolynomial.C (X_ps ^ m))) := by
              rw [nodal_rel (X_ps ^ m)]
          _ = θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
                (θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m)) (MvPolynomial.C X_ps)) *
                  θ₂ (Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                    (MvPolynomial.C (X_ps ^ (m - 2))))) := by
              have hC_m2_mul :
                  Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                    (MvPolynomial.C (X_ps ^ m)) =
                  Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                    (MvPolynomial.C (X_ps * (X_ps * X_ps ^ (m - 2)))) :=
                congrArg
                  (fun r => Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))
                    (MvPolynomial.C r))
                  hXps_m2_mul
              rw [hC_m2_mul]
              simp only [map_mul]
      obtain ⟨lam₂, hlam₂_C, hlam₂_X0, hlam₂_X1⟩ :=
        nodal_lift_pkg (X_ps ^ (m - 2))
          (θ₂.comp ((Ideal.Quotient.mk (weilNodalIdeal RStar (X_ps ^ m))).comp MvPolynomial.C))
          u₃ v₃ hrel₂
      refine ⟨lam₂, ?_⟩
      apply nodalHom_ext
      · intro c
        rw [RingHom.comp_apply, hp₂_C c, RingHom.comp_apply, hlam₂_C c]
        rfl
      · rw [RingHom.comp_apply, hp₂_X0, map_mul, map_mul, hlam₂_C X_ps, hlam₂_X0]
        exact hu₃_mul
      · rw [RingHom.comp_apply, hp₂_X1, map_mul, map_mul, hlam₂_C X_ps, hlam₂_X1]
        exact hv₃_mul

  
  have hLaur_univ : ∀ (A : Type u) [CommRing A] (ρ : RStar →+* A) (u u_inv : A),
      u * u_inv = 1 →
      ∃ ψ : Laur →+* A, ψ.comp φ_Laur = ρ ∧ ψ ξ = u ∧ ψ ξ_inv = u_inv := by
    intro A _ ρ u u_inv hu
    let ev : Polynomial RStar →+* A := Polynomial.eval₂RingHom ρ u
    have hev_unit : ev Polynomial.X * u_inv = 1 := by
      have hevX : ev Polynomial.X = u := Polynomial.eval₂_X ρ u
      rw [hevX]
      exact hu
    obtain ⟨ψ, hψ_eq, hψ_inv⟩ :=
      away_lift_pkg ev (Polynomial.X : Polynomial RStar) u_inv hev_unit
    refine ⟨ψ, ?_, ?_, hψ_inv⟩
    · ext c
      change ψ (η_Laur (Polynomial.C c)) = ρ c
      rw [hψ_eq (Polynomial.C c)]
      exact Polynomial.eval₂_C ρ u
    · change ψ (η_Laur Polynomial.X) = u
      rw [hψ_eq Polynomial.X]
      exact Polynomial.eval₂_X ρ u

  have hf02_rel : (φ_Laur X_ps * ξ_inv) * ξ = φ_Laur (X_ps ^ 1) := by
    rw [pow_one, mul_assoc, hξ_inv_mul, mul_one]
  obtain ⟨f_02, hf02_C, hf02_X0, hf02_X1⟩ :=
    nodal_lift_pkg (X_ps ^ 1) φ_Laur (φ_Laur X_ps * ξ_inv) ξ hf02_rel

  have hf20_rel : ξ_inv * (φ_Laur (X_ps ^ (m - 2)) * ξ) = φ_Laur (X_ps ^ (m - 2)) := by
    calc ξ_inv * (φ_Laur (X_ps ^ (m - 2)) * ξ)
        = φ_Laur (X_ps ^ (m - 2)) * (ξ_inv * ξ) := by ring
      _ = φ_Laur (X_ps ^ (m - 2)) := by rw [hξ_inv_mul, mul_one]
  obtain ⟨f_20, hf20_C, hf20_X0, hf20_X1⟩ :=
    nodal_lift_pkg (X_ps ^ (m - 2)) φ_Laur ξ_inv (φ_Laur (X_ps ^ (m - 2)) * ξ) hf20_rel

  have hf12_rel : ξ * (φ_Laur X_ps * ξ_inv) = φ_Laur (X_ps ^ 1) := by
    calc ξ * (φ_Laur X_ps * ξ_inv)
        = φ_Laur X_ps * (ξ * ξ_inv) := by ring
      _ = φ_Laur (X_ps ^ 1) := by rw [hξ_mul, mul_one, pow_one]
  obtain ⟨f_12, hf12_C, hf12_X0, hf12_X1⟩ :=
    nodal_lift_pkg (X_ps ^ 1) φ_Laur ξ (φ_Laur X_ps * ξ_inv) hf12_rel

  have hf21_rel : (φ_Laur (X_ps ^ (m - 2)) * ξ) * ξ_inv = φ_Laur (X_ps ^ (m - 2)) := by
    rw [mul_assoc, hξ_mul, mul_one]
  obtain ⟨f_21, hf21_C, hf21_X0, hf21_X1⟩ :=
    nodal_lift_pkg (X_ps ^ (m - 2)) φ_Laur (φ_Laur (X_ps ^ (m - 2)) * ξ) ξ_inv hf21_rel

  have hLaur_pos_inj : ∀ (u u_inv : K_X) (ψ_u : Laur →+* L),
      u * u_inv = 1 →
      ψ_u.comp φ_Laur = C_L.comp η_K →
      ψ_u ξ = C_L u * T →
      Function.Injective ψ_u := by
    intro u u_inv ψ_u hu hψ_C hψ_ξ
    have hψ_φ : ∀ c : RStar, ψ_u (φ_Laur c) = C_L (η_K c) :=
      fun c => RingHom.congr_fun hψ_C c
    rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
    intro z hz
    obtain ⟨⟨P, s⟩, hzs⟩ :=
      IsLocalization.surj (Submonoid.powers (Polynomial.X : Polynomial RStar)) z
    dsimp only at hzs
    let ev_u : Polynomial RStar →+* Polynomial K_X :=
      Polynomial.eval₂RingHom (Polynomial.C.comp η_K) (Polynomial.C u * Polynomial.X)
    let ev_u_inv : Polynomial K_X →+* Polynomial K_X :=
      Polynomial.eval₂RingHom Polynomial.C (Polynomial.C u_inv * Polynomial.X)
    have hcomp_ev : ψ_u.comp η_Laur = η_L.comp ev_u := by
      apply Polynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply]
        change ψ_u (φ_Laur c) = η_L (ev_u (Polynomial.C c))
        have hevC : ev_u (Polynomial.C c) = Polynomial.C (η_K c) :=
          Polynomial.eval₂_C _ _
        rw [hψ_φ c, hevC]
        rfl
      · rw [RingHom.comp_apply, RingHom.comp_apply]
        change ψ_u ξ = η_L (ev_u Polynomial.X)
        have hevX : ev_u Polynomial.X = Polynomial.C u * Polynomial.X :=
          Polynomial.eval₂_X _ _
        rw [hevX, map_mul, hψ_ξ]
        rfl
    have hev_P : ev_u P = 0 := by
      apply hηL_inj
      change (η_L.comp ev_u) P = η_L 0
      rw [← hcomp_ev, RingHom.comp_apply, ← hzs, map_mul, hz, zero_mul, map_zero]
    have hinv_ev : ev_u_inv.comp ev_u = Polynomial.mapRingHom η_K := by
      apply Polynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
        have h1 : ev_u (Polynomial.C c) = Polynomial.C (η_K c) := Polynomial.eval₂_C _ _
        rw [h1]
        exact Polynomial.eval₂_C _ _
      · rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
        have h1 : ev_u Polynomial.X = Polynomial.C u * Polynomial.X := Polynomial.eval₂_X _ _
        have h2 : ev_u_inv (Polynomial.C u) = Polynomial.C u := Polynomial.eval₂_C _ _
        have h3 : ev_u_inv Polynomial.X = Polynomial.C u_inv * Polynomial.X :=
          Polynomial.eval₂_X _ _
        rw [h1, map_mul, h2, h3, ← mul_assoc, ← Polynomial.C_mul, hu, Polynomial.C_1, one_mul]
    have hmap_P : Polynomial.map η_K P = 0 := by
      change (Polynomial.mapRingHom η_K) P = 0
      rw [← hinv_ev, RingHom.comp_apply, hev_P, map_zero]
    have hP0 : P = 0 := by
      rw [Polynomial.ext_iff]
      intro n
      rw [Polynomial.coeff_zero]
      apply hηK_inj
      have hc : (Polynomial.map η_K P).coeff n = 0 := by
        rw [hmap_P, Polynomial.coeff_zero]
      rw [Polynomial.coeff_map] at hc
      rw [hc, map_zero]
    rw [hP0, map_zero] at hzs
    obtain ⟨s_inv, hs_inv⟩ := (IsLocalization.map_units Laur s).exists_right_inv
    calc z = z * (η_Laur s.1 * s_inv) := by rw [hs_inv, mul_one]
      _ = (z * η_Laur s.1) * s_inv := by ring
      _ = 0 := by rw [hzs, zero_mul]

  have hα12_unit :
      (C_L (X_K_inv ^ (m - 1)) * T) * (C_L (X_K ^ (m - 1)) * T_inv) = 1 := by
    calc (C_L (X_K_inv ^ (m - 1)) * T) * (C_L (X_K ^ (m - 1)) * T_inv)
        = C_L (X_K_inv ^ (m - 1) * X_K ^ (m - 1)) * (T * T_inv) := by rw [map_mul]; ring
      _ = 1 := by rw [hXm1_inv, hT_mul, map_one, mul_one]
  obtain ⟨α_12, hα12_C, hα12_ξ, hα12_ξ_inv⟩ :=
    hLaur_univ L (C_L.comp η_K) (C_L (X_K_inv ^ (m - 1)) * T)
      (C_L (X_K ^ (m - 1)) * T_inv) hα12_unit
  have hα12_φ : ∀ c : RStar, α_12 (φ_Laur c) = C_L (η_K c) :=
    fun c => RingHom.congr_fun hα12_C c
  have hα12_inj : Function.Injective α_12 :=
    hLaur_pos_inj (X_K_inv ^ (m - 1)) (X_K ^ (m - 1)) α_12 hXm1_inv hα12_C hα12_ξ

  have hα02_unit : (C_L X_K * T_inv) * (C_L X_K_inv * T) = 1 := by
    calc (C_L X_K * T_inv) * (C_L X_K_inv * T)
        = C_L (X_K * X_K_inv) * (T_inv * T) := by rw [map_mul]; ring
      _ = 1 := by rw [hXK_mul, hT_inv_mul, map_one, mul_one]
  obtain ⟨α_02, hα02_C, hα02_ξ, hα02_ξ_inv⟩ :=
    hLaur_univ L (C_L.comp η_K) (C_L X_K * T_inv) (C_L X_K_inv * T) hα02_unit
  have hα02_φ : ∀ c : RStar, α_02 (φ_Laur c) = C_L (η_K c) :=
    fun c => RingHom.congr_fun hα02_C c

  have hα02_inj : Function.Injective α_02 := by
    have hτ_unit :
        (Polynomial.eval₂RingHom C_L T_inv) (Polynomial.X : Polynomial K_X) * T = 1 := by
      have hevX : (Polynomial.eval₂RingHom C_L T_inv) (Polynomial.X : Polynomial K_X) = T_inv :=
        Polynomial.eval₂_X _ _
      rw [hevX]
      exact hT_inv_mul
    obtain ⟨τ_L, hτ_eq, hτ_inv⟩ :=
      away_lift_pkg (Polynomial.eval₂RingHom C_L T_inv) (Polynomial.X : Polynomial K_X) T hτ_unit
    have hτ_CL : ∀ k : K_X, τ_L (C_L k) = C_L k := by
      intro k
      change τ_L (η_L (Polynomial.C k)) = C_L k
      rw [hτ_eq (Polynomial.C k)]
      exact Polynomial.eval₂_C _ _
    have hτ_Tinv : τ_L T_inv = T := hτ_inv
    have hcomp_C : (τ_L.comp α_02).comp φ_Laur = C_L.comp η_K := by
      ext c
      simp only [RingHom.comp_apply]
      rw [hα02_φ c, hτ_CL (η_K c)]
    have hcomp_ξ : (τ_L.comp α_02) ξ = C_L X_K * T := by
      rw [RingHom.comp_apply, hα02_ξ, map_mul, hτ_CL X_K, hτ_Tinv]
    exact Function.Injective.of_comp (hLaur_pos_inj X_K X_K_inv (τ_L.comp α_02) hXK_mul
      hcomp_C hcomp_ξ)

  have hα02_f02 : α_02.comp f_02 = ι₀ := by
    apply nodalHom_ext
    · intro c
      rw [RingHom.comp_apply, hf02_C c, hα02_φ c, hι₀_C c]
    · rw [RingHom.comp_apply, hf02_X0, map_mul, hα02_φ X_ps, hα02_ξ_inv, hι₀_X0]
      calc C_L X_K * (C_L X_K_inv * T)
          = C_L (X_K * X_K_inv) * T := by rw [← mul_assoc, ← map_mul]
        _ = C_L 1 * T := by rw [hXK_mul]
    · rw [RingHom.comp_apply, hf02_X1, hα02_ξ, hι₀_X1, pow_one]

  have hα02_f20 : α_02.comp f_20 = ι₂ := by
    apply nodalHom_ext
    · intro c
      rw [RingHom.comp_apply, hf20_C c, hα02_φ c, hι₂_C c]
    · rw [RingHom.comp_apply, hf20_X0, hα02_ξ_inv, hι₂_X0]
    · rw [RingHom.comp_apply, hf20_X1, map_mul, hα02_φ (X_ps ^ (m - 2)), map_pow,
        hα02_ξ, hι₂_X1]
      calc C_L (X_K ^ (m - 2)) * (C_L X_K * T_inv)
          = C_L (X_K ^ (m - 2) * X_K) * T_inv := by rw [← mul_assoc, ← map_mul]
        _ = C_L (X_K ^ (m - 1)) * T_inv := by rw [← hXK_m21]

  have hα12_f12 : α_12.comp f_12 = ι₁ := by
    apply nodalHom_ext
    · intro c
      rw [RingHom.comp_apply, hf12_C c, hα12_φ c, hι₁_C c]
    · rw [RingHom.comp_apply, hf12_X0, hα12_ξ, hι₁_X0]
    · rw [RingHom.comp_apply, hf12_X1, map_mul, hα12_φ X_ps, hα12_ξ_inv, hι₁_X1]
      calc C_L X_K * (C_L (X_K ^ (m - 1)) * T_inv)
          = C_L (X_K * X_K ^ (m - 1)) * T_inv := by rw [← mul_assoc, ← map_mul]
        _ = C_L (X_K ^ m) * T_inv := by rw [hXK_1_m1]

  have hα12_f21 : α_12.comp f_21 = ι₂ := by
    apply nodalHom_ext
    · intro c
      rw [RingHom.comp_apply, hf21_C c, hα12_φ c, hι₂_C c]
    · rw [RingHom.comp_apply, hf21_X0, map_mul, hα12_φ (X_ps ^ (m - 2)), map_pow,
        hα12_ξ, hι₂_X0]
      have hx : X_K ^ (m - 2) * X_K_inv ^ (m - 1) = X_K_inv := by
        calc X_K ^ (m - 2) * X_K_inv ^ (m - 1)
            = (X_K ^ (m - 2) * X_K_inv ^ (m - 2)) * X_K_inv := by
              rw [hXKi_m21]
              ring
          _ = (X_K * X_K_inv) ^ (m - 2) * X_K_inv := by rw [← mul_pow]
          _ = X_K_inv := by rw [hXK_mul, one_pow, one_mul]
      calc C_L (X_K ^ (m - 2)) * (C_L (X_K_inv ^ (m - 1)) * T)
          = C_L (X_K ^ (m - 2) * X_K_inv ^ (m - 1)) * T := by rw [← mul_assoc, ← map_mul]
        _ = C_L X_K_inv * T := by rw [hx]
    · rw [RingHom.comp_apply, hf21_X1, hα12_ξ_inv, hι₂_X1]

  exact ⟨L, Laur, inferInstance, inferInstance, p₀, p₁, p₂, ι_base, ι₀, ι₁, ι₂,
    φ_Laur, ξ, ξ_inv, f_02, f_12, f_20, f_21,
    hm, inferInstance, inferInstance, hConj4,
    hι_base_inj, hι₀_inj, hι₁_inj, hι₂_inj, hLoc_base,
    hcomp₀, hcomp₁, hcomp₂,
    fun c => ⟨hp₀_C c, hp₁_C c, hp₂_C c⟩,
    hp₀_X0, hp₀_X1, hp₁_X0, hp₁_X1, hp₂_X0, hp₂_X1,
    hnzd₀, hmap_p₀, hnzd₁, hmap_p₁, hnzd₂, hmap_p₂,
    hAway₀, hAway₁, hAway₂,
    hInter, hUniv_01OF,
    hξ_mul, hLaur_univ,
    ⟨α_02, α_12, hα02_inj, hα12_inj, hα02_f02, hα02_f20, hα12_f12, hα12_f21⟩,
    fun c => ⟨hf02_C c, hf20_C c, hf12_C c, hf21_C c⟩,
    hf02_X0, hf02_X1, hf20_X0, hf20_X1, hf12_X0, hf12_X1, hf21_X0, hf21_X1⟩

theorem weil_powerSeries_blowup_scheme_pushforward_and_universal (Ω : Type u) [Field Ω]
    (m : ℕ) (hm : 2 ≤ m)
    (hAff_Pm : ∀ a : Fin 3, AlgebraicGeometry.IsAffineOpen
      (weilProjBasicOpen
        (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m)) 2 a))
    (c_Pm : ∀ a : Fin 3,
      weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+*
        ↑((weilProjectiveSpaceOver
            (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m)) 2).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen
            (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m)) 2 a))))
    (t_Pm : ∀ a : Fin 3, Fin 3 →
      ↑((weilProjectiveSpaceOver
          (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m)) 2).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen
          (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m)) 2 a))))
    (hProj : IsCommRingProjCoordSystem
      (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m)) 2
      hAff_Pm c_Pm t_Pm)
    (L Laur : Type u) [CommRing L] [CommRing Laur]
    (p₀ p₁ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+*
      weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1))
    (p₂ : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+*
      weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)))
    (ι_base : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ m) →+* L)
    (ι₀_L ι₁_L : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1) →+* L)
    (ι₂_L : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)) →+* L)
    (φ_Laur : PowerSeries Ω →+* Laur) (ξ ξ_inv : Laur)
    (f_02 f_12 : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1) →+* Laur)
    (f_20 f_21 : weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)) →+* Laur)
    (hAlg : IsPowerSeriesNodalBlowupRingPkg Ω m L Laur p₀ p₁ p₂ ι_base ι₀_L ι₁_L ι₂_L
      φ_Laur ξ ξ_inv f_02 f_12 f_20 f_21) :
    let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
        MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
        Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
    let P_m := MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m
    let I_nod : Ideal P_m := Ideal.span
      {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
       Ideal.Quotient.mk J_m (MvPolynomial.X 1),
       Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
    let g_Pm : AlgebraicGeometry.Spec (CommRingCat.of P_m) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C))
    ∃ (M_m : AlgebraicGeometry.Scheme.{u})
      (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of P_m))
      (ι₀ ι₁ : AlgebraicGeometry.Spec (CommRingCat.of
        (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ 1))) ⟶ M_m)
      (ι₂ : AlgebraicGeometry.Spec (CommRingCat.of
        (weilNodalQuot (PowerSeries Ω) ((PowerSeries.X : PowerSeries Ω) ^ (m - 2)))) ⟶ M_m),
      IsPowerSeriesThreeChartBlowupData Ω m p_m ι₀ ι₁ ι₂ ∧
      AlgebraicGeometry.IsIntegral M_m ∧
      AlgebraicGeometry.Flat (p_m ≫ g_Pm) ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (p_m ≫ g_Pm) ∧
      AlgebraicGeometry.IsProper p_m ∧
      CategoryTheory.IsIso
        (p_m ∣_ ⟨(PrimeSpectrum.zeroLocus (I_nod : Set P_m))ᶜ,
          (PrimeSpectrum.isClosed_zeroLocus (I_nod : Set P_m)).isOpen_compl⟩) ∧
      (∀ U : (AlgebraicGeometry.Spec (CommRingCat.of P_m)).Opens,
        CategoryTheory.IsIso (p_m.app U)) ∧
      (∃ (W_cov : Fin 3 → M_m.Opens)
          (hAff : ∀ r : Fin 3, AlgebraicGeometry.IsAffineOpen (W_cov r))
          (d_gen : ∀ r : Fin 3, ↑(M_m.presheaf.obj (Opposite.op (W_cov r)))),
        (⋃ r : Fin 3, (W_cov r : Set M_m)) = Set.univ ∧
        ∀ r : Fin 3,
          d_gen r ∈ nonZeroDivisors ↑(M_m.presheaf.obj (Opposite.op (W_cov r))) ∧
          Ideal.map (AlgebraicGeometry.Spec.preimage ((hAff r).fromSpec ≫ p_m)).hom I_nod =
            Ideal.span {d_gen r}) ∧
      (∀ (B : Type u) [CommRing B]
          (ψ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of P_m))
          (d : B),
        d ∈ nonZeroDivisors B →
        Ideal.map (AlgebraicGeometry.Spec.preimage ψ).hom I_nod = Ideal.span {d} →
        (∃ ψ_lift : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ M_m, ψ_lift ≫ p_m = ψ) ∧
        (∀ ψ₁ ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ M_m,
          ψ₁ ≫ p_m = ψ → ψ₂ ≫ p_m = ψ → ψ₁ = ψ₂)) :=
by
  
  have h_s1 : ∀ (R : Type u) [CommRing R]
      (P_proj : AlgebraicGeometry.Scheme.{u})
      (π_proj : P_proj ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (_ : AlgebraicGeometry.IsProper π_proj)
      (D : Fin 3 → P_proj.Opens)
      (_ : (⨆ a : Fin 3, D a) = ⊤)
      (hAff_D : ∀ a : Fin 3, AlgebraicGeometry.IsAffineOpen (D a))
      (c_D : ∀ a : Fin 3, R →+* ↑(P_proj.presheaf.obj (Opposite.op (D a))))
      (t_D : ∀ a : Fin 3, Fin 3 → ↑(P_proj.presheaf.obj (Opposite.op (D a))))
      (_ : ∀ a : Fin 3, AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_D a)) =
        (hAff_D a).fromSpec ≫ π_proj)
      (_ : ∀ a : Fin 3, Subring.closure (Set.range (c_D a) ∪ Set.range (t_D a)) = ⊤)
      (_ : ∀ (a : Fin 3) (A : Type u) [CommRing A] (ρ : R →+* A) (w : Fin 3 → A),
        w a = 1 →
        ∃ ψ : ↑(P_proj.presheaf.obj (Opposite.op (D a))) →+* A,
          ψ.comp (c_D a) = ρ ∧ ∀ b : Fin 3, ψ (t_D a b) = w b)
      (_ : ∀ a a' : Fin 3, P_proj.basicOpen (t_D a a') = D a ⊓ D a')
      (_ : ∀ (a a' : Fin 3) (r : R),
        (P_proj.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a' ≤ D a')).op).hom
          (c_D a' r) =
        (P_proj.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a' ≤ D a)).op).hom
          (c_D a r))
      (_ : ∀ (a a' b : Fin 3),
        (P_proj.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a' ≤ D a')).op).hom
          (t_D a' b) *
        (P_proj.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a' ≤ D a)).op).hom
          (t_D a a') =
        (P_proj.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a' ≤ D a)).op).hom
          (t_D a b))
      (L : Type u) [CommRing L] [IsDomain L]
      (ι_base : R →+* L)
      (g : Fin 3 → R)
      (_ : ∀ a : Fin 3, IsUnit (ι_base (g a)))
      (C : Fin 3 → CommRingCat.{u})
      (p : ∀ r : Fin 3, R →+* ↑(C r))
      (ι_L : ∀ r : Fin 3, ↑(C r) →+* L)
      (_ : ∀ r : Fin 3, Function.Injective (ι_L r))
      (_ : ∀ r : Fin 3, (ι_L r).comp (p r) = ι_base)
      (v : ∀ r : Fin 3, Fin 3 → ↑(C r))
      (_ : ∀ r : Fin 3, v r r = 1)
      (_ : ∀ r b : Fin 3, v r b * p r (g r) = p r (g b))
      (_ : ∀ r : Fin 3, Subring.closure (Set.range (p r) ∪ Set.range (v r)) = ⊤),
      ∃ (M : AlgebraicGeometry.Scheme.{u})
        (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (γ_M : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ M)
        (ι : ∀ r : Fin 3, AlgebraicGeometry.Spec (C r) ⟶ M),
        AlgebraicGeometry.IsProper p_M ∧
        M.IsSeparated ∧
        AlgebraicGeometry.IsIntegral M ∧
        AlgebraicGeometry.IsDominant γ_M ∧
        (∀ r : Fin 3, AlgebraicGeometry.IsOpenImmersion (ι r)) ∧
        ((⋃ r : Fin 3, Set.range (ι r).base) = Set.univ) ∧
        (∀ r : Fin 3, ι r ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p r))) ∧
        (∀ r : Fin 3, AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_L r)) ≫ ι r = γ_M) ∧
        (∀ r r' : Fin 3, (ι r).base ⁻¹' Set.range (ι r').base =
          (PrimeSpectrum.basicOpen (v r r')).1) := by
    clear! Ω m L Laur
    intro R _ P_proj π_proj hProp_proj D hCov_D hAff_D c_D t_D
      hBase_D hClosure_D hEval_D hInter_D hRes_c hRes_t
      L _ _ ι_base g hg_unit C p ι_L hInj_L hComp_L v hv_diag hv_rel hv_gen
    have : IsProper π_proj := hProp_proj
    have hSep_P : P_proj.IsSeparated := by
      have h1 : IsSeparated (π_proj ≫ Limits.terminal.from (Spec (CommRingCat.of R))) :=
        inferInstance
      rw [Limits.terminal.comp_from] at h1
      exact ⟨h1⟩
    choose π hπ_c hπ_t using fun r : Fin 3 => hEval_D r ↑(C r) (p r) (v r) (hv_diag r)
    have hπ_surj : ∀ r : Fin 3, Function.Surjective (π r) := by
      intro r x
      have htop : (⊤ : Subring ↑(C r)) ≤ (π r).range := by
        rw [← hv_gen r, Subring.closure_le]
        rintro y (⟨z, rfl⟩ | ⟨b, rfl⟩)
        · refine ⟨c_D r z, ?_⟩
          change ((π r).comp (c_D r)) z = p r z
          rw [hπ_c r]
        · exact ⟨t_D r b, hπ_t r b⟩
      exact htop (Subring.mem_top x)
    let ψ_L : ∀ r : Fin 3, ↑(P_proj.presheaf.obj (Opposite.op (D r))) →+* L :=
      fun r => (ι_L r).comp (π r)
    let ψ_hom : ∀ r : Fin 3, P_proj.presheaf.obj (Opposite.op (D r)) ⟶ CommRingCat.of L :=
      fun r => CommRingCat.ofHom (ψ_L r)
    have hker_ψ : ∀ r : Fin 3, RingHom.ker (ψ_L r) = RingHom.ker (π r) := by
      intro r
      ext x
      simp only [RingHom.mem_ker, ψ_L, RingHom.comp_apply]
      exact ⟨fun h => hInj_L r (h.trans (map_zero (ι_L r)).symm), fun h => by rw [h, map_zero]⟩
    let u : Fin 3 → Lˣ := fun a => (hg_unit a).unit
    have hu_val : ∀ a : Fin 3, ((u a : Lˣ) : L) = ι_base (g a) :=
      fun a => IsUnit.unit_spec (hg_unit a)
    have hψ_c : ∀ (r : Fin 3) (x : R), ψ_L r (c_D r x) = ι_base x := by
      intro r x
      change (ι_L r) (((π r).comp (c_D r)) x) = ι_base x
      rw [hπ_c r]
      exact DFunLike.congr_fun (hComp_L r) x
    have hψ_t : ∀ r b : Fin 3, ψ_L r (t_D r b) = ((u b * (u r)⁻¹ : Lˣ) : L) := by
      intro r b
      have hmul : ψ_L r (t_D r b) * (u r : L) = (u b : L) := by
        simp only [ψ_L, RingHom.comp_apply, hπ_t, hu_val]
        have h1 := congrArg (ι_L r) (hv_rel r b)
        rw [map_mul] at h1
        have hcr : ι_L r (p r (g r)) = ι_base (g r) := DFunLike.congr_fun (hComp_L r) (g r)
        have hcb : ι_L r (p r (g b)) = ι_base (g b) := DFunLike.congr_fun (hComp_L r) (g b)
        rw [hcr, hcb] at h1
        exact h1
      calc ψ_L r (t_D r b)
          = ψ_L r (t_D r b) * ((u r : L) * ↑(u r)⁻¹) := by simp
        _ = (ψ_L r (t_D r b) * (u r : L)) * ↑(u r)⁻¹ := by ring
        _ = ((u b * (u r)⁻¹ : Lˣ) : L) := by rw [hmul, Units.val_mul]
    have hψ_t_unit : ∀ r r' : Fin 3, IsUnit (ψ_L r (t_D r r')) := by
      intro r r'
      rw [hψ_t r r']
      exact Units.isUnit _
    let γ : Fin 3 → (Spec (CommRingCat.of L) ⟶ P_proj) :=
      fun r => Spec.map (ψ_hom r) ≫ (hAff_D r).fromSpec
    have hγ_eq : ∀ r r' : Fin 3, γ r = γ r' := by
      intro r r'
      have hAff_inter : IsAffineOpen (D r ⊓ D r') :=
        hInter_D r r' ▸ (hAff_D r).basicOpen (t_D r r')
      let i_L : D r ⊓ D r' ⟶ D r := homOfLE inf_le_left
      let i_R : D r ⊓ D r' ⟶ D r' := homOfLE inf_le_right
