      congr 2
      apply HomogeneousLocalization.val_injective
        (Submonoid.powers (X_var ℓ * X_var ℓ'))
      rw [HomogeneousLocalization.val_awayMap, HomogeneousLocalization.val_awayMap,
        hc_away_val ℓ' r, hc_away_val ℓ r]
      change IsLocalization.Away.lift (X_var ℓ') _ (algebraMap M_poly _ (MvPolynomial.C r)) =
        IsLocalization.Away.lift (X_var ℓ) _ (algebraMap M_poly _ (MvPolynomial.C r))
      rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
    have hCocyc_t : ∀ (ℓ ℓ' b : Fin (d + 1)),
        (P_A.presheaf.map (homOfLE inf_le_right).op).hom (t_A ℓ' b) *
        (P_A.presheaf.map (homOfLE inf_le_left).op).hom (t_A ℓ ℓ') =
        (P_A.presheaf.map (homOfLE inf_le_left).op).hom (t_A ℓ b) := by
      intro ℓ ℓ' b
      change (P_A.presheaf.map (homOfLE inf_le_right).op).hom
          ((Proj.awayToSection 𝒜 (X_var ℓ')).hom (t_away ℓ' b)) *
        (P_A.presheaf.map (homOfLE inf_le_left).op).hom
          ((Proj.awayToSection 𝒜 (X_var ℓ)).hom (t_away ℓ ℓ')) =
