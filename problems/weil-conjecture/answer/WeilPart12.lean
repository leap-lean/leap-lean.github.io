      have _ : IsIso e_eq := by
        rw [he_iso_eq]
        infer_instance
      exact (cancel_epi e_eq).mp (Limits.equalizer.condition ψ₁ ψ₂)
    refine ⟨hIsoCompl, ⟨W_cov, hAff, d_gen, hW_univ, hd_gen_spec⟩, ?_⟩
    intro B _ ψ d hd hMap
    refine ⟨?_, hUnique B ψ d hd hMap⟩
    let θ : R →+* B := (Spec.preimage ψ).hom
    have hψ_θ : Spec.map (CommRingCat.ofHom θ) = ψ := Spec.map_preimage ψ
    obtain ⟨b, hb_top, hb_lift⟩ := hLiftAlg B θ d hd hMap
    let O : Fin 3 → (Spec (CommRingCat.of B)).Opens := fun r => PrimeSpectrum.basicOpen (b r)
    have hO_cov : TopologicalSpace.IsOpenCover O := by
      apply TopologicalSpace.IsOpenCover.mk
      rw [eq_top_iff]
      intro q _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_contra hnone
      push Not at hnone
      apply q.isPrime.ne_top
      rw [← top_le_iff, ← hb_top, Ideal.span_le]
      rintro _ ⟨r, rfl⟩
      exact Classical.not_not.mp (hnone r)
    choose lam hlam using fun r : Fin 3 =>
      hb_lift r (Localization.Away (b r)) inferInstance
    let j_Br : ∀ r : Fin 3,
        Spec (CommRingCat.of (Localization.Away (b r))) ⟶ Spec (CommRingCat.of B) :=
      fun r => Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away (b r))))
    have _ : ∀ r : Fin 3, IsOpenImmersion (j_Br r) :=
      fun r => Scheme.isOpenImmersion_SpecMap_localizationAway (R := CommRingCat.of B) (b r)
    have hRange_Br : ∀ r : Fin 3, Set.range (j_Br r).base = Set.range (O r).ι.base := by
      intro r
      rw [Scheme.Opens.range_ι]
      exact PrimeSpectrum.localization_away_comap_range (Localization.Away (b r)) (b r)
    let iso_Or : ∀ r : Fin 3, (O r).toScheme ≅ Spec (CommRingCat.of (Localization.Away (b r))) :=
      fun r => IsOpenImmersion.isoOfRangeEq (O r).ι (j_Br r) (hRange_Br r).symm
    let ψ_loc : ∀ r : Fin 3, (O r).toScheme ⟶ M :=
      fun r => (iso_Or r).hom ≫ Spec.map (CommRingCat.ofHom (lam r)) ≫ ι r
    have hψ_loc_comm : ∀ r : Fin 3, ψ_loc r ≫ p_M = (O r).ι ≫ ψ := by
      intro r
      calc ψ_loc r ≫ p_M
          = (iso_Or r).hom ≫ (Spec.map (CommRingCat.ofHom (lam r)) ≫ (ι r ≫ p_M)) := by
              dsimp [ψ_loc]; simp only [Category.assoc]
        _ = (iso_Or r).hom ≫ Spec.map (CommRingCat.ofHom ((lam r).comp (p r))) := by
              rw [hComm r, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = ((iso_Or r).hom ≫ j_Br r) ≫ Spec.map (CommRingCat.ofHom θ) := by
              rw [hlam r, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
        _ = (O r).ι ≫ ψ := by
              rw [IsOpenImmersion.isoOfRangeEq_hom_fac (O r).ι (j_Br r) (hRange_Br r).symm, hψ_θ]
    have hGlue_fin : ∀ r s : Fin 3,
        Limits.pullback.fst (O r).ι (O s).ι ≫ ψ_loc r =
          Limits.pullback.snd (O r).ι (O s).ι ≫ ψ_loc s := by
      intro r s
      let B_rs := Localization.Away (b r * b s)
      let j_Brs : Spec (CommRingCat.of B_rs) ⟶ Spec (CommRingCat.of B) :=
        Spec.map (CommRingCat.ofHom (algebraMap B B_rs))
