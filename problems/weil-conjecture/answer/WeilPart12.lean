                (AlgebraicGeometry.Spec R_U₀).presheaf.map e_self) ≫
                (AlgebraicGeometry.Spec.map ιR_hom).app (hU₀.fromSpec ⁻¹ᵁ U₀) :=
                congrArg (· ≫ _) hU₀.fromSpec_app_self
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso R_U₀).inv ≫
                ((AlgebraicGeometry.Spec R_U₀).presheaf.map e_self ≫
