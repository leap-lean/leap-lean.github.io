        have h_resR : P_A.presheaf.map (homOfLE (inf_le_right : U_inter ≤ D ℓ')).op ≫
            CommRingCat.ofHom φ₂ = CommRingCat.ofHom (ψ ℓ') := by
          ext x; exact congrFun (congrArg DFunLike.coe hφ₂_comp) x
        rw [h_resR]
      rw [← hγL, ← hγR, hφ_eq]
    have _ : IsProper p_P := hProp_P
    have hSepOfProper : ∀ {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of A)) [IsProper f],
