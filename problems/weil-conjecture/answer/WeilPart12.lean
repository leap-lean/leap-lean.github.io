      have hu_L : IsUnit (α_mul (X_var ℓ)) :=
        isUnit_of_dvd_unit (map_dvd α_mul ⟨X_var ℓ', rfl⟩) hu_mul
      have hu_R : IsUnit (α_mul (X_var ℓ')) :=
        isUnit_of_dvd_unit (map_dvd α_mul ⟨X_var ℓ, mul_comm _ _⟩) hu_mul
      let f_L : Localization.Away (X_var ℓ) →+* R_mul :=
        Localization.awayLift α_mul (X_var ℓ) hu_L
      let f_R : Localization.Away (X_var ℓ') →+* R_mul :=
        Localization.awayLift α_mul (X_var ℓ') hu_R
      change f_R (t_away ℓ' b).val * f_L (t_away ℓ ℓ').val = f_L (t_away ℓ b).val
      apply hu_mul.mul_left_inj.mp
      have h_step_L : ∀ (c : Fin (d + 1)),
          f_L (t_away ℓ c).val * α_mul (X_var ℓ) = α_mul (X_var c) := by
        intro c
        change (IsLocalization.Away.lift (X_var ℓ) hu_L (t_away ℓ c).val) *
