          have hij := congrFun hδ (i, j)
          exact sub_eq_zero.mp hij
        obtain ⟨s₀, hs₀, _⟩ := P.sheaf.existsUnique_gluing WP sf hCompat
        let eP : Opposite.op (⊤ : P.Opens) ≅ Opposite.op (⨆ i : Fin M, WP i) :=
