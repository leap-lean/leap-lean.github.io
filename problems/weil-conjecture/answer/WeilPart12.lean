          rw [hZa_univ]
          trivial
        have hZc_ne : (Set.univ ∩ Zᶜ).Nonempty := by
          obtain ⟨y, hy⟩ := Set.nonempty_compl.mpr hZ_ne
          exact ⟨y, trivial, hy⟩
        obtain ⟨w, _, hwZc, hwWa⟩ :=
          hPreirredUniv Zᶜ (W a : Set ↥E_sch) hZ_cl.isOpen_compl (W a).isOpen
