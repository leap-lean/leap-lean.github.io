    · intro t
      let I_cond : Ideal R₀ :=
        { carrier := {b : R₀ | ∃ a : R₀, u₀ b * t = u₀ a}
          add_mem' := fun {b₁ b₂} ⟨a₁, ha₁⟩ ⟨a₂, ha₂⟩ =>
            ⟨a₁ + a₂, by rw [map_add, add_mul, ha₁, ha₂, ← map_add]⟩
          zero_mem' := ⟨0, by rw [map_zero, zero_mul]⟩
          smul_mem' := fun c {b} ⟨a, ha⟩ =>
            ⟨c * a, by calc u₀ (c * b) * t = u₀ c * (u₀ b * t) := by rw [map_mul]; ring
