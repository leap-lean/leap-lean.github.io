    let ψ_sec : ∀ ℓ : Fin (d + 1), ↑(P_A.presheaf.obj (Opposite.op (D ℓ))) →+* K_A :=
      fun ℓ => ((ev_loc ℓ).comp (valHom (X_var ℓ))).comp
        (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv.hom
    have hψ_sec_c : ∀ (ℓ : Fin (d + 1)) (r : A), ψ_sec ℓ (c_A ℓ r) = ι_K r := by
      intro ℓ r
      have h_inv_hom : (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv.hom
          (c_A ℓ r) = c_away ℓ r := by
        change ((Proj.awayToSection 𝒜 (X_var ℓ)) ≫
          (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv).hom (c_away ℓ r) = _
        rw [← Proj.basicOpenIsoAway_hom 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one, Iso.hom_inv_id]
        rfl
      change ev_loc ℓ ((Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv.hom
        (c_A ℓ r)).val = ι_K r
      rw [h_inv_hom, hc_away_val ℓ r, IsLocalization.Away.lift_eq, hev_C r]
    have hψ_sec_t : ∀ (ℓ b : Fin (d + 1)),
        ψ_sec ℓ (t_A ℓ b) = ι_K (a b) * (ι_K (a ℓ))⁻¹ := by
      intro ℓ b
      have h_inv_hom : (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv.hom
          (t_A ℓ b) = t_away ℓ b := by
        change ((Proj.awayToSection 𝒜 (X_var ℓ)) ≫
          (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv).hom (t_away ℓ b) = _
        rw [← Proj.basicOpenIsoAway_hom 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one, Iso.hom_inv_id]
        rfl
      change ev_loc ℓ ((Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv.hom
        (t_A ℓ b)).val = _
      rw [h_inv_hom]
      apply mul_right_cancel₀ (haK_ne ℓ)
      have h_rhs : (ι_K (a b) * (ι_K (a ℓ))⁻¹) * ι_K (a ℓ) = ι_K (a b) := by
        rw [mul_assoc, inv_mul_cancel₀ (haK_ne ℓ), mul_one]
