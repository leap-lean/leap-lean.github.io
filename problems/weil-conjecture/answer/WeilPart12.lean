          · have h_cond : p_ik.base z = (Limits.pullback.snd (𝒰.f i) (𝒰.f k) ≫ (U_B k).ι).base z := by
              change (Limits.pullback.fst (𝒰.f i) (𝒰.f k) ≫ 𝒰.f i).base z =
                (Limits.pullback.snd (𝒰.f i) (𝒰.f k) ≫ 𝒰.f k).base z
              rw [Limits.pullback.condition]
            rw [h_cond]
            have hz_k : (Limits.pullback.snd (𝒰.f i) (𝒰.f k) ≫ (U_B k).ι).base z ∈
                Set.range (U_B k).ι.base :=
              ⟨(Limits.pullback.snd (𝒰.f i) (𝒰.f k)).base z, rfl⟩
            rwa [Scheme.Opens.range_ι] at hz_k
      let iso_pik := IsOpenImmersion.isoOfRangeEq j_ik p_ik hRange_pik
      have hw_eq_iso : w_ik = iso_pik.hom := by
        rw [← cancel_mono p_ik, hw_pik, IsOpenImmersion.isoOfRangeEq_hom_fac]
      have _ : IsIso w_ik := by rw [hw_eq_iso]; infer_instance
      rw [← cancel_epi w_ik]
      let t_ik : B_ik := algebraMap B B_ik t_B
      have ht_ik_nzd : t_ik ∈ nonZeroDivisors B_ik := by
        rw [mem_nonZeroDivisors_iff_right]
        intro z hz
        obtain ⟨⟨x, _, m, rfl⟩, hzx⟩ := IsLocalization.surj (Submonoid.powers s_ik) z
        have h_xt0 : algebraMap B B_ik (x * t_B) = 0 := by
          calc algebraMap B B_ik (x * t_B)
              = algebraMap B B_ik x * t_ik := map_mul _ _ _
            _ = (z * algebraMap B B_ik (s_ik ^ m)) * t_ik := by rw [← hzx]
            _ = (z * t_ik) * algebraMap B B_ik (s_ik ^ m) := by ring
            _ = 0 := by rw [hz, zero_mul]
        rw [← map_zero (algebraMap B B_ik)] at h_xt0
        obtain ⟨⟨_, s, rfl⟩, hs_eq⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers s_ik) B_ik).mp h_xt0
        have h_sx0 : s_ik ^ s * x = 0 := by
          apply (mem_nonZeroDivisors_iff.mp ht_nzd).2
          calc (s_ik ^ s * x) * t_B = s_ik ^ s * (x * t_B) := by ring
            _ = s_ik ^ s * 0 := hs_eq
            _ = 0 := mul_zero _
        have hz_pow : z * (algebraMap B B_ik s_ik) ^ (m + s) = 0 := by
          calc z * (algebraMap B B_ik s_ik) ^ (m + s)
              = (z * algebraMap B B_ik (s_ik ^ m)) * algebraMap B B_ik (s_ik ^ s) := by
                  rw [pow_add, map_pow, map_pow]; ring
            _ = algebraMap B B_ik (s_ik ^ s * x) := by rw [hzx, ← map_mul, mul_comm]
            _ = 0 := by rw [h_sx0, map_zero]
        let u_ik := IsLocalization.Away.invSelf (S := B_ik) s_ik
        have hu_ik : (algebraMap B B_ik s_ik) ^ (m + s) * u_ik ^ (m + s) = 1 := by
          rw [← mul_pow, IsLocalization.Away.mul_invSelf (S := B_ik) s_ik, one_pow]
        calc z = z * ((algebraMap B B_ik s_ik) ^ (m + s) * u_ik ^ (m + s)) := by
              rw [hu_ik, mul_one]
          _ = (z * (algebraMap B B_ik s_ik) ^ (m + s)) * u_ik ^ (m + s) := by ring
          _ = 0 := by rw [hz_pow, zero_mul]
      have hMap_ik : Ideal.map (Spec.preimage (j_ik ≫ ψ)).hom m_A = Ideal.span {t_ik} := by
        have h_pre_eq : (Spec.preimage (j_ik ≫ ψ)).hom = (algebraMap B B_ik).comp θ := by
          have h1 : j_ik ≫ ψ = Spec.map (CommRingCat.ofHom ((algebraMap B B_ik).comp θ)) := by
            rw [CommRingCat.ofHom_comp, Spec.map_comp, hθ_map]
          have h2 := congrArg Spec.preimage h1
          rw [Spec.preimage_map] at h2
          exact congrArg ConcreteCategory.hom h2
        rw [h_pre_eq, ← Ideal.map_map, hMap_B, Ideal.map_span, Set.image_singleton]
      apply hUnique B_ik (j_ik ≫ ψ) t_ik ht_ik_nzd hMap_ik
      · calc (w_ik ≫ Limits.pullback.fst (𝒰.f i) (𝒰.f k) ≫ f_loc i) ≫ π_U
            = w_ik ≫ Limits.pullback.fst (𝒰.f i) (𝒰.f k) ≫ (f_loc i ≫ π_U) := by
                simp [Category.assoc]
          _ = (w_ik ≫ p_ik) ≫ ψ := by
                rw [hf_loc_π i]; simp [p_ik, 𝒰, Category.assoc]
          _ = j_ik ≫ ψ := by rw [hw_pik]
      · calc (w_ik ≫ Limits.pullback.snd (𝒰.f i) (𝒰.f k) ≫ f_loc k) ≫ π_U
            = w_ik ≫ Limits.pullback.snd (𝒰.f i) (𝒰.f k) ≫ (f_loc k ≫ π_U) := by
                simp [Category.assoc]
          _ = w_ik ≫ (Limits.pullback.snd (𝒰.f i) (𝒰.f k) ≫ 𝒰.f k) ≫ ψ := by
                rw [hf_loc_π k]; simp [Category.assoc]
          _ = (w_ik ≫ p_ik) ≫ ψ := by
                rw [← Limits.pullback.condition]; simp [p_ik, 𝒰, Category.assoc]
          _ = j_ik ≫ ψ := by rw [hw_pik]
    let ψ_lift : X_B ⟶ U_tilde := Scheme.Cover.glueMorphisms 𝒰 f_loc hCocycle
    refine ⟨ψ_lift, ?_⟩
    apply Scheme.Cover.hom_ext 𝒰
    intro i
    rw [← Category.assoc, Scheme.Cover.ι_glueMorphisms, hf_loc_π i]
  obtain ⟨hSurj_π, hIsoCompl, hUniv8⟩ := hPart3
  exact ⟨U_tilde, π_U, hInt_U, hFlat_fR, hLFP_fR, hProp_π, hSurj_π, hIsoCompl, hConj7, hUniv8⟩

theorem weil_closed_point_affine_modification_two_open_gluing (C' U_tilde S : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ S)
    (hInt' : AlgebraicGeometry.IsIntegral C')
    (hFlat' : AlgebraicGeometry.Flat g')
    (hLFP' : AlgebraicGeometry.LocallyOfFinitePresentation g')
    (x₀ : C') (hx₀_cl : IsClosed ({x₀} : Set C'))
    (U : C'.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
    (p_x₀ : PrimeSpectrum ↑(C'.presheaf.obj (Opposite.op U)))
    [p_x₀.asIdeal.IsMaximal]
    (hp_x₀ : hAffU.fromSpec.base p_x₀ = x₀)
    (hDom_A : IsDomain ↑(C'.presheaf.obj (Opposite.op U)))
    (hNeBot : p_x₀.asIdeal ≠ ⊥)
    (π_U : U_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))))
    (hInt_U : AlgebraicGeometry.IsIntegral U_tilde)
    (hProp_U : AlgebraicGeometry.IsProper π_U)
    (hSurj_U : AlgebraicGeometry.Surjective π_U)
    (hFlat_U : AlgebraicGeometry.Flat (π_U ≫ hAffU.fromSpec ≫ g'))
    (hLFP_U : AlgebraicGeometry.LocallyOfFinitePresentation (π_U ≫ hAffU.fromSpec ≫ g'))
    (hIso_U : CategoryTheory.IsIso
      (π_U ∣_ ⟨(PrimeSpectrum.zeroLocus
          (p_x₀.asIdeal : Set ↑(C'.presheaf.obj (Opposite.op U))))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl⟩)) :
    let U_compl : C'.Opens := ⟨({x₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩
    ∃ (C'' : AlgebraicGeometry.Scheme.{u})
      (π : C'' ⟶ C')
      (ι_tilde : U_tilde ⟶ C'')
      (ι_compl : U_compl.toScheme ⟶ C''),
      AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
      AlgebraicGeometry.IsOpenImmersion ι_compl ∧
      (∀ z : C'', z ∈ Set.range ι_tilde.base ∨ z ∈ Set.range ι_compl.base) ∧
      ι_tilde ≫ π = π_U ≫ hAffU.fromSpec ∧
      ι_compl ≫ π = U_compl.ι ∧
      π.base ⁻¹' (U : Set C') = Set.range ι_tilde.base ∧
      π.base ⁻¹' (U_compl : Set C') = Set.range ι_compl.base ∧
      CategoryTheory.IsIso (π ∣_ U_compl) ∧
      CategoryTheory.IsPullback ι_tilde π_U π hAffU.fromSpec ∧
      AlgebraicGeometry.IsIntegral C'' ∧
      AlgebraicGeometry.IsProper π ∧
      AlgebraicGeometry.Surjective π ∧
      AlgebraicGeometry.Flat (π ≫ g') ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (π ≫ g') ∧
      ((∀ V : (AlgebraicGeometry.Spec
            (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U)))).Opens,
          CategoryTheory.IsIso (π_U.app V)) →
        ∀ W : C'.Opens, CategoryTheory.IsIso (π.app W)) :=
by
  intro U_compl
  let A_ring : CommRingCat.{u} := CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))
  let X_A : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec A_ring
  let U_spec_compl : X_A.Opens :=
    ⟨(PrimeSpectrum.zeroLocus
        (p_x₀.asIdeal : Set ↑(C'.presheaf.obj (Opposite.op U))))ᶜ,
      (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl⟩
  have : CategoryTheory.IsIso (π_U ∣_ U_spec_compl) := hIso_U
  
  have hSpecComplIff : ∀ q : PrimeSpectrum ↑(C'.presheaf.obj (Opposite.op U)),
      (q : X_A) ∈ (U_spec_compl : Set X_A) ↔
        hAffU.fromSpec.base q ∈ (U_compl : Set C') := by
    intro q
    change q ∉ PrimeSpectrum.zeroLocus (p_x₀.asIdeal : Set _) ↔ hAffU.fromSpec.base q ≠ x₀
    constructor
    · intro hq_not heq
      have hqp : q = p_x₀ := hAffU.fromSpec.isOpenEmbedding.injective (heq.trans hp_x₀.symm)
      apply hq_not
      rw [PrimeSpectrum.mem_zeroLocus, hqp]
    · intro hne hq_mem
      rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe] at hq_mem
      have hIdEq : p_x₀.asIdeal = q.asIdeal :=
        Ideal.IsMaximal.eq_of_le ‹_› q.isPrime.ne_top hq_mem
      have hqp : p_x₀ = q := PrimeSpectrum.ext hIdEq
      exact hne (by rw [← hqp, hp_x₀])
  let U_tilde₀ : U_tilde.Opens := (TopologicalSpace.Opens.map π_U.base).obj U_spec_compl
  let V_01 : AlgebraicGeometry.Scheme.{u} := U_tilde₀.toScheme
  let f₀ : V_01 ⟶ U_tilde := U_tilde₀.ι
  have hRange_ov : Set.range (U_spec_compl.ι ≫ hAffU.fromSpec).base ⊆ Set.range U_compl.ι.base := by
    rintro _ ⟨q', rfl⟩
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    have hq'_mem : U_spec_compl.ι.base q' ∈ (U_spec_compl : Set X_A) := by
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
      exact ⟨q', rfl⟩
    exact (hSpecComplIff (U_spec_compl.ι.base q')).mp hq'_mem
  let j_ov : U_spec_compl.toScheme ⟶ U_compl.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_compl.ι (U_spec_compl.ι ≫ hAffU.fromSpec) hRange_ov
  have hj_ov_fac : j_ov ≫ U_compl.ι = U_spec_compl.ι ≫ hAffU.fromSpec :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_compl.ι (U_spec_compl.ι ≫ hAffU.fromSpec) hRange_ov
  have hj_ov_open : AlgebraicGeometry.IsOpenImmersion j_ov := by
    have : AlgebraicGeometry.IsOpenImmersion (j_ov ≫ U_compl.ι) := by
      rw [hj_ov_fac]
      infer_instance
    exact AlgebraicGeometry.IsOpenImmersion.of_comp j_ov U_compl.ι
  let f₁ : V_01 ⟶ U_compl.toScheme := (π_U ∣_ U_spec_compl) ≫ j_ov
  have hf₀_open : AlgebraicGeometry.IsOpenImmersion f₀ := inferInstance
  have hf₁_open : AlgebraicGeometry.IsOpenImmersion f₁ := inferInstance
  have hf_comm : f₀ ≫ (π_U ≫ hAffU.fromSpec) = f₁ ≫ U_compl.ι := by
    calc f₀ ≫ (π_U ≫ hAffU.fromSpec)
        = (U_tilde₀.ι ≫ π_U) ≫ hAffU.fromSpec := (Category.assoc _ _ _).symm
      _ = ((π_U ∣_ U_spec_compl) ≫ U_spec_compl.ι) ≫ hAffU.fromSpec := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
      _ = (π_U ∣_ U_spec_compl) ≫ (U_spec_compl.ι ≫ hAffU.fromSpec) := Category.assoc _ _ _
      _ = (π_U ∣_ U_spec_compl) ≫ (j_ov ≫ U_compl.ι) := by rw [← hj_ov_fac]
      _ = f₁ ≫ U_compl.ι := (Category.assoc _ _ _).symm
  have hRange_f₀ : Set.range f₀.base = (π_U ≫ hAffU.fromSpec).base ⁻¹' (U_compl : Set C') := by
    change Set.range U_tilde₀.ι.base = _
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    ext u
    exact hSpecComplIff (π_U.base u)
  have hRange_f₁ : Set.range f₁.base = U_compl.ι.base ⁻¹' (U : Set C') := by
    ext w
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨v, rfl⟩
      have h_eq : U_compl.ι.base (f₁.base v) =
          hAffU.fromSpec.base (π_U.base (f₀.base v)) := by
        change (f₁ ≫ U_compl.ι).base v = (f₀ ≫ (π_U ≫ hAffU.fromSpec)).base v
        rw [hf_comm]
      rw [h_eq, ← hAffU.range_fromSpec]
      exact ⟨π_U.base (f₀.base v), rfl⟩
    · intro hw_U
      rw [← hAffU.range_fromSpec] at hw_U
      obtain ⟨q, hq_eq⟩ := hw_U
      have hq_compl : hAffU.fromSpec.base q ∈ (U_compl : Set C') := by
        rw [hq_eq, ← AlgebraicGeometry.Scheme.Opens.range_ι]
        exact ⟨w, rfl⟩
      have hq_spec : (q : X_A) ∈ (U_spec_compl : Set X_A) := (hSpecComplIff q).mpr hq_compl
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hq_spec
      obtain ⟨q_sub, hq_sub⟩ := hq_spec
      let ψ_inv := CategoryTheory.inv (π_U ∣_ U_spec_compl)
      refine ⟨ψ_inv.base q_sub, ?_⟩
      apply U_compl.ι.isOpenEmbedding.injective
      have hψ : (π_U ∣_ U_spec_compl).base (ψ_inv.base q_sub) = q_sub := by
        change (ψ_inv ≫ (π_U ∣_ U_spec_compl)).base q_sub = q_sub
        rw [CategoryTheory.IsIso.inv_hom_id]
        rfl
      calc U_compl.ι.base (f₁.base (ψ_inv.base q_sub))
          = (j_ov ≫ U_compl.ι).base ((π_U ∣_ U_spec_compl).base (ψ_inv.base q_sub)) := rfl
        _ = (j_ov ≫ U_compl.ι).base q_sub := by rw [hψ]
        _ = (U_spec_compl.ι ≫ hAffU.fromSpec).base q_sub := by rw [hj_ov_fac]
        _ = hAffU.fromSpec.base q := by
              change hAffU.fromSpec.base (U_spec_compl.ι.base q_sub) = _
              rw [hq_sub]
        _ = U_compl.ι.base w := hq_eq
  
  let J := ULift.{u} Bool
  let i₀ : J := ⟨false⟩
  let i₁ : J := ⟨true⟩
  have hGluePkg : ∃ (C'' : AlgebraicGeometry.Scheme.{u})
      (π : C'' ⟶ C')
      (ι_tilde : U_tilde ⟶ C'')
      (ι_compl : U_compl.toScheme ⟶ C''),
      AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
      AlgebraicGeometry.IsOpenImmersion ι_compl ∧
      (∀ z : C'', z ∈ Set.range ι_tilde.base ∨ z ∈ Set.range ι_compl.base) ∧
      f₀ ≫ ι_tilde = f₁ ≫ ι_compl ∧
      ι_tilde ≫ π = π_U ≫ hAffU.fromSpec ∧
      ι_compl ≫ π = U_compl.ι := by
    let U_obj : J → AlgebraicGeometry.Scheme.{u} := fun i =>
      match i.down with
      | false => U_tilde
      | true => U_compl.toScheme
    let f_off : ∀ (i j : J), i ≠ j → (V_01 ⟶ U_obj i) := fun i j hij =>
      match i, j with
      | ⟨false⟩, ⟨true⟩ => f₀
      | ⟨true⟩, ⟨false⟩ => f₁
      | ⟨false⟩, ⟨false⟩ => False.elim (hij rfl)
      | ⟨true⟩, ⟨true⟩ => False.elim (hij rfl)
    have hf_off_open : ∀ (i j : J) (hij : i ≠ j), AlgebraicGeometry.IsOpenImmersion (f_off i j hij) := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩ hij
      · exact False.elim (hij rfl)
      · exact hf₀_open
      · exact hf₁_open
      · exact False.elim (hij rfl)
    have hNoTriple : ∀ (i j k : J), i ≠ j → i ≠ k → j ≠ k → False := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;>
        first | exact hij rfl | exact hik rfl | exact hjk rfl
    let D' : CategoryTheory.GlueData' AlgebraicGeometry.Scheme.{u} :=
      { J := J
        U := U_obj
        V := fun _ _ _ => V_01
        f := f_off
        f_mono := fun i j hij => by
          have := hf_off_open i j hij
          infer_instance
        f_hasPullback := fun i j _ hij _ => by
          have := hf_off_open i j hij
          infer_instance
        t := fun _ _ _ => 𝟙 V_01
        t' := fun i j k hij hik hjk => False.elim (hNoTriple i j k hij hik hjk)
        t_fac := fun i j k hij hik hjk => False.elim (hNoTriple i j k hij hik hjk)
        t_inv := fun _ _ _ => Category.id_comp _
        cocycle := fun i j k hij hik hjk => False.elim (hNoTriple i j k hij hik hjk) }
    let D₀ : CategoryTheory.GlueData AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.GlueData.ofGlueData' D'
    have hf_D₀_open : ∀ i j : D₀.J, AlgebraicGeometry.IsOpenImmersion (D₀.f i j) := by
      intro i j
      dsimp [D₀, CategoryTheory.GlueData.ofGlueData', CategoryTheory.GlueData'.f']
      split_ifs with hij
      · infer_instance
      · have : AlgebraicGeometry.IsOpenImmersion (D'.f i j hij) := hf_off_open i j hij
        infer_instance
    let D_C : AlgebraicGeometry.Scheme.GlueData :=
      { toGlueData := D₀
        f_open := hf_D₀_open }
    have : CategoryTheory.Limits.HasMulticoequalizer D_C.diagram :=
      AlgebraicGeometry.Scheme.GlueData.instHasMulticoequalizerDiagram D_C
    have h_dif : ∀ {c : Prop} {α : Type u} (hnc : ¬c) (t_br : c → α) (e_br : ¬c → α),
        @dite α c (Classical.propDecidable c) t_br e_br = e_br hnc := by
      intro c α hnc t_br e_br
      cases Classical.propDecidable c with
      | isTrue hc => exact False.elim (hnc hc)
      | isFalse _ => rfl
    let k_π : ∀ b : J, U_obj b ⟶ C' := fun b =>
      match b with
      | ⟨false⟩ => π_U ≫ hAffU.fromSpec
      | ⟨true⟩ => U_compl.ι
    have h01 : i₀ ≠ i₁ := by decide
    have h10 : i₁ ≠ i₀ := by decide
    have hk_π : ∀ a : (CategoryTheory.Limits.MultispanShape.prod D_C.J).L,
        D_C.diagram.fst a ≫ k_π ((CategoryTheory.Limits.MultispanShape.prod D_C.J).fst a) =
          D_C.diagram.snd a ≫ k_π ((CategoryTheory.Limits.MultispanShape.prod D_C.J).snd a) := by
      rintro ⟨i, j⟩
      by_cases hij : i = j
      · subst hij
        change D_C.f i i ≫ k_π i = (D_C.t i i ≫ D_C.f i i) ≫ k_π i
        rw [D_C.t_id, Category.id_comp]
      · rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
        · exact False.elim (hij rfl)
        · change D_C.f i₀ i₁ ≫ k_π i₀ = (D_C.t i₀ i₁ ≫ D_C.f i₁ i₀) ≫ k_π i₁
          dsimp [D_C, D₀, CategoryTheory.GlueData.ofGlueData', CategoryTheory.GlueData'.f', D']
          rw [h_dif h01, h_dif h01, h_dif h10]
          dsimp [i₀, i₁, f_off, k_π]
          simp only [Category.id_comp, Category.assoc, eqToHom_trans_assoc, eqToHom_refl]
          rw [hf_comm]
        · change D_C.f i₁ i₀ ≫ k_π i₁ = (D_C.t i₁ i₀ ≫ D_C.f i₀ i₁) ≫ k_π i₀
          dsimp [D_C, D₀, CategoryTheory.GlueData.ofGlueData', CategoryTheory.GlueData'.f', D']
          rw [h_dif h10, h_dif h10, h_dif h01]
          dsimp [i₀, i₁, f_off, k_π]
          simp only [Category.id_comp, Category.assoc, eqToHom_trans_assoc, eqToHom_refl]
          rw [← hf_comm]
        · exact False.elim (hij rfl)
    let X_glued : AlgebraicGeometry.Scheme.{u} := D_C.glued
    let π : X_glued ⟶ C' :=
      CategoryTheory.Limits.Multicoequalizer.desc D_C.diagram C' k_π hk_π
    let ι_tilde : U_tilde ⟶ X_glued := D_C.ι i₀
    let ι_compl : U_compl.toScheme ⟶ X_glued := D_C.ι i₁
    have hGlue : f₀ ≫ ι_tilde = f₁ ≫ ι_compl := by
      have hgc : D_C.t i₀ i₁ ≫ D_C.f i₁ i₀ ≫ ι_compl = D_C.f i₀ i₁ ≫ ι_tilde :=
        D_C.glue_condition i₀ i₁
      dsimp [D_C, D₀, CategoryTheory.GlueData.ofGlueData', CategoryTheory.GlueData'.f', D'] at hgc
      rw [h_dif h01, h_dif h10, h_dif h01] at hgc
      dsimp [i₀, i₁, f_off] at hgc
      simp only [Category.id_comp, Category.assoc, eqToHom_trans_assoc, eqToHom_refl] at hgc
      exact ((cancel_epi _).mp hgc).symm
    have hCover'' : ∀ z : D_C.glued,
        z ∈ Set.range ι_tilde.base ∨ z ∈ Set.range ι_compl.base := by
      intro z
      let idx : J := D_C.openCover.idx z
      have hcov : ∃ y : ↥(D_C.openCover.X idx), (D_C.openCover.f idx).base y = z :=
        D_C.openCover.covers z
