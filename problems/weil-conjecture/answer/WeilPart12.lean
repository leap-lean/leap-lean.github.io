    have hj1_emb := Topology.isOpenEmbedding_iff_continuous_injective_isOpenMap.mp j₁.isOpenEmbedding
    have hj2_emb := Topology.isOpenEmbedding_iff_continuous_injective_isOpenMap.mp j₂.isOpenEmbedding
    have hj0_inj : Function.Injective j₀.base := hj0_emb.2.1
    have hj1_inj : Function.Injective j₁.base := hj1_emb.2.1
    have hj2_inj : Function.Injective j₂.base := hj2_emb.2.1
    have hSpecAsIdeal : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B)
        (p : PrimeSpectrum B),
        (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base p) : PrimeSpectrum A).asIdeal =
          Ideal.comap φ p.asIdeal := by
      intro A B _ _ φ p
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    let S_x1 : Set (PrimeSpectrum (weilNodalQuot Ω 0)) :=
      {p : PrimeSpectrum (weilNodalQuot Ω 0) |
        Ideal.Quotient.mk (weilNodalIdeal Ω 0) (MvPolynomial.X 1) ∈ p.asIdeal}
    let S_x0 : Set (PrimeSpectrum (weilNodalQuot Ω 0)) :=
      {p : PrimeSpectrum (weilNodalQuot Ω 0) |
        Ideal.Quotient.mk (weilNodalIdeal Ω 0) (MvPolynomial.X 0) ∈ p.asIdeal}
    let L_br : Fin 2 → Set ↥Y := ![j₀.base '' S_x1, j₁.base '' S_x0]
    have hIrrPoly : IrreducibleSpace (PrimeSpectrum (Polynomial Ω)) :=
      PrimeSpectrum.irreducibleSpace
    have hUnivPoly : IsIrreducible (Set.univ : Set (PrimeSpectrum (Polynomial Ω))) :=
      ⟨⟨hIrrPoly.toNonempty.some, trivial⟩, hIrrPoly.isPreirreducible_univ⟩
    have hCont_ax0 : Continuous (PrimeSpectrum.comap σ_ax0) :=
      PrimeSpectrum.continuous_comap σ_ax0
    have hCont_ax1 : Continuous (PrimeSpectrum.comap σ_ax1) :=
      PrimeSpectrum.continuous_comap σ_ax1
    have hRange_ax0 : Set.range (PrimeSpectrum.comap σ_ax0) = S_x1 := by
      rw [range_comap_of_surjective _ σ_ax0 hSurj_ax0, hKer_ax0]
      ext p
      change (Ideal.span ({x₁} : Set Q₀) : Set Q₀) ⊆ p.asIdeal ↔ x₁ ∈ p.asIdeal
      rw [SetLike.coe_subset_coe, Ideal.span_singleton_le_iff_mem]
    have hRange_ax1 : Set.range (PrimeSpectrum.comap σ_ax1) = S_x0 := by
      rw [range_comap_of_surjective _ σ_ax1 hSurj_ax1, hKer_ax1]
      ext p
      change (Ideal.span ({x₀} : Set Q₀) : Set Q₀) ⊆ p.asIdeal ↔ x₀ ∈ p.asIdeal
      rw [SetLike.coe_subset_coe, Ideal.span_singleton_le_iff_mem]
    have hIrr_L0 : IsIrreducible (L_br 0) := by
      change IsIrreducible (j₀.base '' S_x1)
      rw [← hRange_ax0, ← Set.image_univ]
      exact (hUnivPoly.image _ hCont_ax0.continuousOn).image _ j₀.continuous.continuousOn
    have hIrr_L1 : IsIrreducible (L_br 1) := by
      change IsIrreducible (j₁.base '' S_x0)
      rw [← hRange_ax1, ← Set.image_univ]
      exact (hUnivPoly.image _ hCont_ax1.continuousOn).image _ j₁.continuous.continuousOn
    have hL0_not_j1 : ∀ y ∈ L_br 0, y ∉ Set.range j₁.base := by
      rintro _ ⟨p, hp1, rfl⟩ hy1
      have hpre : p ∈ j₀.base ⁻¹' Set.range j₁.base := hy1
      rw [h01] at hpre
      have hnot : Ideal.Quotient.mk (weilNodalIdeal Ω 0)
          (MvPolynomial.C ((0 : Ω) ^ (m - 2)) *
            (MvPolynomial.X 1 : MvPolynomial (Fin 2) Ω) ^ 2) ∉ p.asIdeal := hpre
      apply hnot
      rw [map_mul, pow_two, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hp1)
    have hL0_not_j2 : ∀ y ∈ L_br 0, y ∉ Set.range j₂.base := by
      rintro _ ⟨p, hp1, rfl⟩ hy2
      have hpre : p ∈ j₀.base ⁻¹' Set.range j₂.base := hy2
      rw [h02] at hpre
      exact hpre hp1
    have hL1_not_j0 : ∀ y ∈ L_br 1, y ∉ Set.range j₀.base := by
      rintro _ ⟨p, hp0, rfl⟩ hy0
      have hpre : p ∈ j₁.base ⁻¹' Set.range j₀.base := hy0
      rw [h10] at hpre
      have hnot : Ideal.Quotient.mk (weilNodalIdeal Ω 0)
          (MvPolynomial.C ((0 : Ω) ^ (m - 2)) *
            (MvPolynomial.X 0 : MvPolynomial (Fin 2) Ω) ^ 2) ∉ p.asIdeal := hpre
      apply hnot
      rw [map_mul, pow_two, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hp0)
    have hL1_not_j2 : ∀ y ∈ L_br 1, y ∉ Set.range j₂.base := by
      rintro _ ⟨p, hp0, rfl⟩ hy2
      have hpre : p ∈ j₁.base ⁻¹' Set.range j₂.base := hy2
      rw [h12] at hpre
      exact hpre hp0
    have hDisjL : Disjoint (L_br 0) (L_br 1) := by
      rw [Set.disjoint_left]
      rintro _ hy0 ⟨p, _, rfl⟩
      exact hL0_not_j1 (j₁.base p) hy0 ⟨p, rfl⟩
    have hCl_L0 : IsClosed (L_br 0) := by
      rw [← isOpen_compl_iff]
      have hCompl0 : (L_br 0)ᶜ =
          (j₀.base '' (PrimeSpectrum.basicOpen x₁).1) ∪
            Set.range j₁.base ∪ Set.range j₂.base := by
        ext y
        constructor
        · intro hy
          have hyU : y ∈ Set.range j₀.base ∪ Set.range j₁.base ∪ Set.range j₂.base := by
            rw [hCov]; trivial
          rcases hyU with (⟨p, rfl⟩ | hy1) | hy2
          · left; left
            refine ⟨p, ?_, rfl⟩
            intro hp1
            exact hy ⟨p, hp1, rfl⟩
          · left; right; exact hy1
          · right; exact hy2
        · rintro ((⟨p, hp, rfl⟩ | hy1) | hy2) hyL0
          · rcases hyL0 with ⟨q, hq1, hqp⟩
            have hpq : q = p := hj0_inj hqp
            rw [hpq] at hq1
            exact hp hq1
          · exact hL0_not_j1 y hyL0 hy1
          · exact hL0_not_j2 y hyL0 hy2
      rw [hCompl0]
      exact ((hj0_emb.2.2 _ (PrimeSpectrum.basicOpen x₁).2).union
        j₁.isOpenEmbedding.isOpen_range).union j₂.isOpenEmbedding.isOpen_range
    have hCl_L1 : IsClosed (L_br 1) := by
      rw [← isOpen_compl_iff]
      have hCompl1 : (L_br 1)ᶜ =
          (j₁.base '' (PrimeSpectrum.basicOpen x₀).1) ∪
            Set.range j₀.base ∪ Set.range j₂.base := by
        ext y
        constructor
        · intro hy
          have hyU : y ∈ Set.range j₀.base ∪ Set.range j₁.base ∪ Set.range j₂.base := by
            rw [hCov]; trivial
          rcases hyU with (hy0 | ⟨p, rfl⟩) | hy2
          · left; right; exact hy0
          · left; left
            refine ⟨p, ?_, rfl⟩
            intro hp0
            exact hy ⟨p, hp0, rfl⟩
          · right; exact hy2
        · rintro ((⟨p, hp, rfl⟩ | hy0) | hy2) hyL1
          · rcases hyL1 with ⟨q, hq0, hqp⟩
            have hpq : q = p := hj1_inj hqp
            rw [hpq] at hq0
            exact hp hq0
          · exact hL1_not_j0 y hyL1 hy0
          · exact hL1_not_j2 y hyL1 hy2
      rw [hCompl1]
      exact ((hj1_emb.2.2 _ (PrimeSpectrum.basicOpen x₀).2).union
        j₀.isOpenEmbedding.isOpen_range).union j₂.isOpenEmbedding.isOpen_range
    let q_left : ↥Y := j₀.base p_orig
    let q_right : ↥Y := j₁.base p_orig
    have hq_left_L0 : q_left ∈ L_br 0 := ⟨p_orig, hp_orig_x1, rfl⟩
    have hq_right_L1 : q_right ∈ L_br 1 := ⟨p_orig, hp_orig_x0, rfl⟩
    have hq_lr_ne : q_left ≠ q_right := fun h =>
      Set.disjoint_left.mp hDisjL hq_left_L0 (h ▸ hq_right_L1)
    have hNonZ_L0 : (L_br 0 ∩ {q : ↥Y | q ∉ Z_center}).Nonempty :=
      ⟨j₀.base p_10, ⟨p_10, hp10_x1, rfl⟩, fun hZ => hp10_x0 ((hZ0 p_10).mp hZ)⟩
    have hNonZ_L1 : (L_br 1 ∩ {q : ↥Y | q ∉ Z_center}).Nonempty :=
      ⟨j₁.base p_01, ⟨p_01, hp01_x0, rfl⟩, fun hZ => hp01_x1 ((hZ1 p_01).mp hZ)⟩
    have hUniq_L0 : ∃! q : ↥Y, q ∈ L_br 0 ∧ q ∈ Z_center := by
      refine ⟨q_left, ⟨hq_left_L0, (hZ0 p_orig).mpr hp_orig_x0⟩, ?_⟩
      rintro q ⟨⟨p, hp1, rfl⟩, hqZ⟩
      have hp0 : x₀ ∈ p.asIdeal := (hZ0 p).mp hqZ
      rw [hp_orig_unique p hp0 hp1]
    have hUniq_L1 : ∃! q : ↥Y, q ∈ L_br 1 ∧ q ∈ Z_center := by
      refine ⟨q_right, ⟨hq_right_L1, (hZ1 p_orig).mpr hp_orig_x1⟩, ?_⟩
      rintro q ⟨⟨p, hp0, rfl⟩, hqZ⟩
      have hp1 : x₁ ∈ p.asIdeal := (hZ1 p).mp hqZ
      rw [hp_orig_unique p hp0 hp1]
    have hUniq_L : ∀ b : Fin 2, ∃! q : ↥Y, q ∈ L_br b ∧ q ∈ Z_center := by
      intro b; fin_cases b
      · exact hUniq_L0
      · exact hUniq_L1
    have hFinComp : ∀ {N : ℕ} (C : Fin N → Set ↥Y),
        (⋃ i : Fin N, C i) = Set.univ →
        (∀ i : Fin N, IsClosed (C i) ∧ IsIrreducible (C i)) →
        (∀ i : Fin N, ∃ w ∈ C i, ∀ j : Fin N, j ≠ i → w ∉ C j) →
        irreducibleComponents ↥Y = Set.range C := by
      intro N C hUC hCI hWit
      classical
      have hSubEq : ∀ i j : Fin N, C i ⊆ C j → i = j := by
        intro i j hij
        by_contra hne
        obtain ⟨w, hwi, hwnot⟩ := hWit i
        exact hwnot j (Ne.symm hne) (hij hwi)
      have hContain : ∀ S : Set ↥Y, IsIrreducible S → ∃ j : Fin N, S ⊆ C j := by
        intro S hS
        let ℱ : Finset (Set ↥Y) := Finset.univ.image C
        have hℱ_cl : ∀ z ∈ ℱ, IsClosed z := by
          intro z hz
          rcases Finset.mem_image.mp hz with ⟨i, _, rfl⟩
          exact (hCI i).1
        have hS_sub : S ⊆ ⋃₀ (↑ℱ : Set (Set ↥Y)) := by
          intro y _
          have hy : y ∈ ⋃ i : Fin N, C i := by rw [hUC]; trivial
          rcases Set.mem_iUnion.mp hy with ⟨i, hyi⟩
          exact Set.mem_sUnion.mpr ⟨C i, Finset.mem_coe.mpr (Finset.mem_image_of_mem C (Finset.mem_univ i)), hyi⟩
        obtain ⟨z, hz, hSz⟩ := (isIrreducible_iff_sUnion_isClosed.mp hS) ℱ hℱ_cl hS_sub
        rcases Finset.mem_image.mp hz with ⟨j, _, rfl⟩
        exact ⟨j, hSz⟩
      rw [irreducibleComponents_eq_maximals_closed]
      ext E
      simp only [Set.mem_range]
      constructor
      · rintro ⟨hEI, hMax⟩
        obtain ⟨j, hEj⟩ := hContain E hEI.2
        have hjE : C j ≤ E := hMax (hCI j) hEj
        exact ⟨j, (Set.Subset.antisymm hEj hjE).symm⟩
      · rintro ⟨i, rfl⟩
        refine ⟨hCI i, ?_⟩
        intro T hTI hiT
        obtain ⟨j, hTj⟩ := hContain T hTI.2
        have hij : i = j := hSubEq i j (hiT.trans hTj)
        rw [hij]
        exact hTj
    refine ⟨L_br, ?_⟩
    rcases hE_charts with ⟨hm2, hk1, hE_m2⟩ | ⟨hm3, a₀, a₁, ha_ne, ha_cov,
        hE0_j0, hE0_j1, hE0_j2, hE1_j0, hE1_j1, hE1_j2⟩
    · have h1k : 1 ≤ k_exc := by omega
      let i₀ : Fin k_exc := ⟨0, by omega⟩
      have hi₀_all : ∀ a : Fin k_exc, a = i₀ := fun a => Fin.ext (by omega)
      let E₀ := E_set i₀
      have hRange2_sub_0 : Set.range j₂.base ⊆ Set.range j₀.base := by
        rintro _ ⟨q, rfl⟩
        change q ∈ j₂.base ⁻¹' Set.range j₀.base
        rw [h20]
        intro hmem
        let u₃ := Ideal.Quotient.mk (weilNodalIdeal Ω ((0 : Ω) ^ (m - 2))) (MvPolynomial.X 0)
        let v₃ := Ideal.Quotient.mk (weilNodalIdeal Ω ((0 : Ω) ^ (m - 2))) (MvPolynomial.X 1)
        have huv : u₃ * v₃ = 1 := by
          have hc1 : ((0 : Ω) ^ (m - 2)) = 1 := by rw [hm2]; simp
          change Ideal.Quotient.mk _ (MvPolynomial.X 0) *
              Ideal.Quotient.mk _ (MvPolynomial.X 1) =
            Ideal.Quotient.mk _ (MvPolynomial.C 1)
          rw [← hc1, ← map_mul, ← sub_eq_zero, ← map_sub]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        have h1_mem : (1 : weilNodalQuot Ω ((0 : Ω) ^ (m - 2))) ∈ q.asIdeal := by
          rw [← huv]
          exact Ideal.mul_mem_right _ _ hmem
        exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one)
      have hCov01 : Set.range j₀.base ∪ Set.range j₁.base = Set.univ := by
        ext y
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        have hy : y ∈ Set.range j₀.base ∪ Set.range j₁.base ∪ Set.range j₂.base := by
          rw [hCov]; trivial
        rcases hy with hy01 | hy2
        · exact hy01
        · exact Or.inl (hRange2_sub_0 hy2)
      have hZ_eq_E0 : Z_center = E₀ := by
        ext y
        have hy : y ∈ Set.range j₀.base ∪ Set.range j₁.base := by rw [hCov01]; trivial
        rcases hy with ⟨p, rfl⟩ | ⟨p, rfl⟩
        · rw [hZ0 p]
          constructor
          · intro hp0
            have hmem : j₀.base p ∈ E₀ ∩ Set.range j₀.base := by
              rw [(hE_m2 i₀).1]
              exact ⟨p, hp0, rfl⟩
            exact hmem.1
          · intro hyE
            have hmem : j₀.base p ∈ E₀ ∩ Set.range j₀.base := ⟨hyE, ⟨p, rfl⟩⟩
            rw [(hE_m2 i₀).1] at hmem
            rcases hmem with ⟨q, hq0, hqp⟩
            rwa [← hj0_inj hqp]
        · rw [hZ1 p]
          constructor
          · intro hp1
            have hmem : j₁.base p ∈ E₀ ∩ Set.range j₁.base := by
              rw [(hE_m2 i₀).2]
              exact ⟨p, hp1, rfl⟩
            exact hmem.1
          · intro hyE
            have hmem : j₁.base p ∈ E₀ ∩ Set.range j₁.base := ⟨hyE, ⟨p, rfl⟩⟩
            rw [(hE_m2 i₀).2] at hmem
            rcases hmem with ⟨q, hq1, hqp⟩
            rwa [← hj1_inj hqp]
      have hZ_union : Z_center = ⋃ a : Fin k_exc, E_set a := by
        rw [hZ_eq_E0]
        ext y
        simp only [Set.mem_iUnion]
        refine ⟨fun hy => ⟨i₀, hy⟩, fun ⟨a, ha⟩ => ?_⟩
        rw [hi₀_all a] at ha
        exact ha
      have hConnZ : _root_.IsConnected Z_center := by
        rw [hZ_eq_E0]
        exact (hE_cl_irr i₀).2.isConnected
      let C3 : Fin 3 → Set ↥Y := ![E₀, L_br 0, L_br 1]
      have hUC3 : (⋃ k : Fin 3, C3 k) = Set.univ := by
        ext y
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        rw [Set.mem_iUnion]
        have hy : y ∈ Set.range j₀.base ∪ Set.range j₁.base := by rw [hCov01]; trivial
        rcases hy with ⟨p, rfl⟩ | ⟨p, rfl⟩
        · rcases hDichot p with hp0 | hp1
          · refine ⟨0, ?_⟩
            change j₀.base p ∈ E₀
            rw [← hZ_eq_E0]; exact (hZ0 p).mpr hp0
          · exact ⟨1, ⟨p, hp1, rfl⟩⟩
        · rcases hDichot p with hp0 | hp1
          · exact ⟨2, ⟨p, hp0, rfl⟩⟩
          · refine ⟨0, ?_⟩
            change j₁.base p ∈ E₀
            rw [← hZ_eq_E0]; exact (hZ1 p).mpr hp1
      have hCI3 : ∀ k : Fin 3, IsClosed (C3 k) ∧ IsIrreducible (C3 k) := by
        intro k; fin_cases k
        · exact hE_cl_irr i₀
        · exact ⟨hCl_L0, hIrr_L0⟩
        · exact ⟨hCl_L1, hIrr_L1⟩
      have hWit3 : ∀ k : Fin 3, ∃ w ∈ C3 k, ∀ l : Fin 3, l ≠ k → w ∉ C3 l := by
        intro k; fin_cases k
        · refine ⟨j₀.base p_01, ?_, ?_⟩
          · change j₀.base p_01 ∈ E₀
            rw [← hZ_eq_E0, hZ0]
            exact hp01_x0
          · intro l hl; fin_cases l
            · exact absurd rfl hl
            · rintro ⟨q, hq1, hqp⟩
              exact hp01_x1 (hj0_inj hqp ▸ hq1)
            · intro hmem1
              exact hL1_not_j0 _ hmem1 ⟨p_01, rfl⟩
        · refine ⟨j₀.base p_10, ⟨p_10, hp10_x1, rfl⟩, ?_⟩
          intro l hl; fin_cases l
          · change j₀.base p_10 ∉ E₀
            rw [← hZ_eq_E0, hZ0]
            exact hp10_x0
          · exact absurd rfl hl
          · exact Set.disjoint_left.mp hDisjL ⟨p_10, hp10_x1, rfl⟩
        · refine ⟨j₁.base p_01, ⟨p_01, hp01_x0, rfl⟩, ?_⟩
          intro l hl; fin_cases l
          · change j₁.base p_01 ∉ E₀
            rw [← hZ_eq_E0, hZ1]
            exact hp01_x1
          · exact Set.disjoint_right.mp hDisjL ⟨p_01, hp01_x0, rfl⟩
          · exact absurd rfl hl
      have hCompEq3 : irreducibleComponents ↥Y = Set.range C3 := hFinComp C3 hUC3 hCI3 hWit3
      have hCompTarget : irreducibleComponents ↥Y =
          (⋃ a : Fin k_exc, {E_set a}) ∪ {L_br 0, L_br 1} := by
        rw [hCompEq3]
        ext S
        simp only [Set.mem_range, Set.mem_union, Set.mem_iUnion, Set.mem_singleton_iff,
          Set.mem_insert_iff]
        constructor
        · rintro ⟨k, rfl⟩
          fin_cases k
          · exact Or.inl ⟨i₀, rfl⟩
          · exact Or.inr (Or.inl rfl)
          · exact Or.inr (Or.inr rfl)
        · rintro (⟨a, rfl⟩ | rfl | rfl)
          · rw [hi₀_all a]; exact ⟨0, rfl⟩
          · exact ⟨1, rfl⟩
          · exact ⟨2, rfl⟩
      have hE_mem : ∀ a : Fin k_exc, E_set a ∈ irreducibleComponents ↥Y := by
        intro a; rw [hCompTarget]; exact Or.inl (Set.mem_iUnion.mpr ⟨a, rfl⟩)
      have hL_mem : ∀ b : Fin 2, L_br b ∈ irreducibleComponents ↥Y ∧
          (L_br b ∩ {q : ↥Y | q ∉ Z_center}).Nonempty := by
        intro b; fin_cases b
        · exact ⟨by rw [hCompTarget]; exact Or.inr (Or.inl rfl), hNonZ_L0⟩
        · exact ⟨by rw [hCompTarget]; exact Or.inr (Or.inr rfl), hNonZ_L1⟩
      have hL0_ne_E0 : L_br 0 ≠ E₀ := by
        intro heq
        obtain ⟨w, hwL0, hwNotZ⟩ := hNonZ_L0
        rw [heq, ← hZ_eq_E0] at hwL0
        exact hwNotZ hwL0
      have hL1_ne_E0 : L_br 1 ≠ E₀ := by
        intro heq
        obtain ⟨w, hwL1, hwNotZ⟩ := hNonZ_L1
        rw [heq, ← hZ_eq_E0] at hwL1
        exact hwNotZ hwL1
      refine ⟨h1k, hConnZ, hE_mem, hL_mem, hDisjL, hZ_union, hCompTarget, hUniq_L, ?_⟩
      intro a
      rw [hi₀_all a]
      refine ⟨q_left, q_right, hq_lr_ne,
        by change q_left ∈ E₀; rw [← hZ_eq_E0]; exact (hZ0 p_orig).mpr hp_orig_x0,
        by change q_right ∈ E₀; rw [← hZ_eq_E0]; exact (hZ1 p_orig).mpr hp_orig_x1,
        ⟨L_br 0, (hL_mem 0).1, hL0_ne_E0, hq_left_L0⟩,
        ⟨L_br 1, (hL_mem 1).1, hL1_ne_E0, hq_right_L1⟩, ?_⟩
      intro q hqE ⟨E', hE'_mem, hE'_ne, hqE'⟩
      rw [hCompTarget] at hE'_mem
      rcases hE'_mem with hU | hL01
      · rcases Set.mem_iUnion.mp hU with ⟨a', ha'⟩
        rw [Set.mem_singleton_iff, hi₀_all a'] at ha'
        exact absurd ha' hE'_ne
      · rcases hL01 with rfl | rfl
        · left
