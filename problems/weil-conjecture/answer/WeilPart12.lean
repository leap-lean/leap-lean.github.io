        (by
          rw [CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
            CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd]
          exact h_comm_R)
      have h_comm_L' : iso_spec_comm.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιR) := h_comm_L
      have h_comm_R' : iso_spec_comm.hom ≫
          AlgebraicGeometry.Spec.map
