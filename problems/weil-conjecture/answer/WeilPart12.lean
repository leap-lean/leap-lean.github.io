    obtain ⟨ha1, hb0⟩ := hOrd₁ q_exc rfl hq_exc_not hNoSq'
    obtain ⟨c₁₂, hc₁₂⟩ := hresA m₁₂
    obtain ⟨c₂₂, hc₂₂⟩ := hresA m₂₂
    have hC_unit_not_mem : ∀ c : Ω, c ≠ 0 → φ_e (φ₀ (PowerSeries.C c)) ∉ v₀.asIdeal := by
      intro c hc_ne hmem
