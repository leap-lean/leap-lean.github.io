          change j_ℓ.base q ∈ P_A.basicOpen (t_A ℓ ℓ') ↔ _
          rw [hj_eq]; rfl
        have h_fs := (hAff_A ℓ).fromSpec_preimage_basicOpen (t_A ℓ ℓ')
        have h_mem2 : ((hAff_A ℓ).fromSpec).base
            ((Spec.map (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv).base q) ∈
            P_A.basicOpen (t_A ℓ ℓ') ↔
            (Spec.map (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv).base q ∈
            PrimeSpectrum.basicOpen (t_A ℓ ℓ') :=
          SetLike.ext_iff.mp h_fs _
        have h_inv_t : (Proj.basicOpenIsoAway 𝒜 (X_var ℓ) (hX1 ℓ) zero_lt_one).inv.hom
