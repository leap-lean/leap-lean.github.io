    apply PrimeSpectrum.ext
    rw [AlgebraicGeometry.Spec.map_apply, AlgebraicGeometry.Spec.map_apply]
    change Ideal.comap α₁.hom (Ideal.comap (algebraMap A'_1 (Localization.Away h')) v_final.asIdeal) =
      p_aff.asIdeal
    rw [h_under_vfin, hcomap_α₁]
  have hFib_singleton : e_U.base ⁻¹' {p₀} = {v_final} := by
    ext q_fin
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hq_eq
      have h_im : (e_U ≫ AlgebraicGeometry.Spec.map j_f).base q_fin = p_aff := by
        change (AlgebraicGeometry.Spec.map j_f).base (e_U.base q_fin) = p_aff
        rw [hq_eq, hp₀_map]
      rw [heU_comm] at h_im
      let q₁ : PrimeSpectrum A'_1 := (AlgebraicGeometry.Spec.map j_h').base q_fin
      have hq₁_over : Ideal.comap α₁.hom q₁.asIdeal = p_aff.asIdeal := by
        have h1 := congrArg PrimeSpectrum.asIdeal h_im
        change ((AlgebraicGeometry.Spec.map α₁).base q₁).asIdeal = p_aff.asIdeal at h1
        rwa [AlgebraicGeometry.Spec.map_apply] at h1
      have hh'_not_q₁ : h' ∉ q₁.asIdeal := by
        have hq₁_range : q₁ ∈ Set.range (PrimeSpectrum.comap (algebraMap A'_1 (Localization.Away h'))) :=
          ⟨q_fin, rfl⟩
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away h') h'] at hq₁_range
        exact hq₁_range
      have hsfib_not_q₁ : s_fib ∉ q₁.asIdeal := by
        intro hsf_in
        apply hh'_not_q₁
        rw [hh'_fib]
        exact q₁.asIdeal.mul_mem_left _ hsf_in
      have hq₁_eq_v₁ : q₁.asIdeal = v₁.asIdeal :=
        hs_fib_uniq q₁.asIdeal q₁.isPrime (le_of_eq hq₁_over.symm) hsfib_not_q₁
      have hcomap_eq : PrimeSpectrum.comap (algebraMap A'_1 (Localization.Away h')) q_fin =
          PrimeSpectrum.comap (algebraMap A'_1 (Localization.Away h')) v_final := by
        apply PrimeSpectrum.ext
        change q₁.asIdeal = Ideal.comap (algebraMap A'_1 (Localization.Away h')) v_final.asIdeal
        rw [hq₁_eq_v₁, h_under_vfin]
      exact PrimeSpectrum.localization_comap_injective (Localization.Away h')
        (Submonoid.powers h') hcomap_eq
    · rintro rfl
      exact heU_vfin
  let u : A'_final := algebraMap A'_1 (Localization.Away h') u₁
  let v : A'_final := algebraMap A'_1 (Localization.Away h') v'_1
  have hvfin_span : v_final.asIdeal = Ideal.span ({u, v} : Set A'_final) := by
    change Ideal.map (algebraMap A'_1 (Localization.Away h')) v₁.asIdeal =
      Ideal.span ({u, v} : Set A'_final)
    refine le_antisymm ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      change algebraMap A'_1 (Localization.Away h') x ∈ Ideal.span ({u, v} : Set A'_final)
      have hsx := hs_gen_ann x hx
      have hmap_sx : algebraMap A'_1 (Localization.Away h') (s_gen * x) ∈
          Ideal.map (algebraMap A'_1 (Localization.Away h')) (Ideal.span ({u₁, v'_1} : Set A'_1)) :=
        Ideal.mem_map_of_mem _ hsx
      rw [Ideal.map_span, Set.image_pair] at hmap_sx
      change algebraMap A'_1 (Localization.Away h') (s_gen * x) ∈
        Ideal.span ({u, v} : Set A'_final) at hmap_sx
      let inv_sgen : A'_final :=
        algebraMap A'_1 (Localization.Away h') q_gen * inv_h'
      have hsgen_inv : inv_sgen * algebraMap A'_1 (Localization.Away h') s_gen = 1 := by
        calc (algebraMap A'_1 (Localization.Away h') q_gen * inv_h') *
              algebraMap A'_1 (Localization.Away h') s_gen
            = (algebraMap A'_1 (Localization.Away h') q_gen *
                algebraMap A'_1 (Localization.Away h') s_gen) * inv_h' := by ring
          _ = algebraMap A'_1 (Localization.Away h') h' * inv_h' := by rw [← map_mul, ← hh'_gen]
          _ = 1 := hh'_inv
      have hmul_inv := (Ideal.span ({u, v} : Set A'_final)).mul_mem_left inv_sgen hmap_sx
      have hcancel : inv_sgen * algebraMap A'_1 (Localization.Away h') (s_gen * x) =
          algebraMap A'_1 (Localization.Away h') x := by
        rw [map_mul, ← mul_assoc, hsgen_inv, one_mul]
      rwa [hcancel] at hmul_inv
    · rw [Ideal.span_le]
      intro w hw
      rcases Set.mem_insert_iff.mp hw with rfl | hw'
      · exact Ideal.mem_map_of_mem _ hu₁_mem
      · rcases Set.mem_singleton_iff.mp hw' with rfl
        exact Ideal.mem_map_of_mem _ hv'₁_mem
  obtain ⟨hu_inj_fin, hv_reg_fin⟩ :=
    hFlatReg P₁ A'_1 (Localization.Away h') (Submonoid.powers h') β₁.hom x₀ x₁
      hβ₁_et hx₀_inj hx₁_reg
  have hu_ne : u ≠ 0 := by
    intro hu0
    have h10 : u * (1 : A'_final) = u * (0 : A'_final) := by rw [hu0, zero_mul, zero_mul]
    exact one_ne_zero (hu_inj_fin h10)
  have hPre_Afin : ∀ s : PowerSeries Ω,
      (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g)).hom s =
        algebraMap A'_1 (Localization.Away h') (α₁.hom (φ_aff s)) := by
    intro s
    have hsch : e_U ≫ ι_U ≫ g =
        AlgebraicGeometry.Spec.map j_h' ≫ AlgebraicGeometry.Spec.map α₁ ≫ (ι_aff ≫ g) := by
      change e_U ≫ (AlgebraicGeometry.Spec.map j_f ≫ ι_aff) ≫ g = _
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, heU_comm]
      simp [CategoryTheory.Category.assoc]
    have hpre : AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g) =
        AlgebraicGeometry.Spec.preimage (ι_aff ≫ g) ≫ α₁ ≫ j_h' := by
      rw [hsch, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
        AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map,
        CategoryTheory.Category.assoc]
    exact congrArg (fun φ : CommRingCat.of (PowerSeries Ω) ⟶ A'_final => φ.hom s) hpre
  have hRes_Afin : ∀ r' : A'_final, ∃ c : Ω,
      r' - (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g)).hom (PowerSeries.C c) ∈
        v_final.asIdeal := by
    intro r'
    obtain ⟨⟨a, ⟨_, ⟨k, rfl⟩⟩⟩, hr_eq⟩ := IsLocalization.surj (Submonoid.powers h') r'
    obtain ⟨c_a, hc_a⟩ := hRes_A₁ a
    obtain ⟨c_hk, hc_hk⟩ := hRes_A₁ (h' ^ k)
    have hchk_ne : c_hk ≠ 0 := by
      intro hc0
      rw [hc0, map_zero, map_zero, sub_zero] at hc_hk
      exact hh'_not (v₁.isPrime.mem_of_pow_mem k hc_hk)
    let c : Ω := c_a * c_hk⁻¹
    refine ⟨c, ?_⟩
    have hc_mul : c * c_hk = c_a := inv_mul_cancel_right₀ hchk_ne c_a
    have hdiff_A₁ : a - h' ^ k * α₁.hom (φ_aff (PowerSeries.C c)) ∈ v₁.asIdeal := by
      have hmul_c : α₁.hom (φ_aff (PowerSeries.C c)) * α₁.hom (φ_aff (PowerSeries.C c_hk)) =
          α₁.hom (φ_aff (PowerSeries.C c_a)) := by
        rw [← map_mul, ← map_mul, ← map_mul, hc_mul]
      have h_id : a - h' ^ k * α₁.hom (φ_aff (PowerSeries.C c)) =
          (a - α₁.hom (φ_aff (PowerSeries.C c_a))) -
          α₁.hom (φ_aff (PowerSeries.C c)) * (h' ^ k - α₁.hom (φ_aff (PowerSeries.C c_hk))) := by
        rw [← hmul_c]; ring
      rw [h_id]
      exact v₁.asIdeal.sub_mem hc_a (v₁.asIdeal.mul_mem_left _ hc_hk)
    have hmap_diff : algebraMap A'_1 (Localization.Away h')
        (a - h' ^ k * α₁.hom (φ_aff (PowerSeries.C c))) ∈ v_final.asIdeal :=
      Ideal.mem_map_of_mem _ hdiff_A₁
    have hinv_pow : (algebraMap A'_1 (Localization.Away h') h') ^ k * inv_h' ^ k = 1 := by
      rw [← mul_pow, hh'_inv, one_pow]
    have hmul_v := v_final.asIdeal.mul_mem_right (inv_h' ^ k) hmap_diff
    have hr_sub : algebraMap A'_1 (Localization.Away h')
        (a - h' ^ k * α₁.hom (φ_aff (PowerSeries.C c))) * inv_h' ^ k =
        r' - (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g)).hom (PowerSeries.C c) := by
      rw [hPre_Afin, map_sub, map_mul, map_pow]
      have hr_hk : algebraMap A'_1 (Localization.Away h') a =
          r' * (algebraMap A'_1 (Localization.Away h') h') ^ k := by simpa [map_pow] using hr_eq.symm
      rw [hr_hk, sub_mul, mul_assoc r', hinv_pow, mul_one]
      have h_rhs : (algebraMap A'_1 (Localization.Away h') h') ^ k *
          algebraMap A'_1 (Localization.Away h') (α₁.hom (φ_aff (PowerSeries.C c))) * inv_h' ^ k =
          algebraMap A'_1 (Localization.Away h') (α₁.hom (φ_aff (PowerSeries.C c))) *
          ((algebraMap A'_1 (Localization.Away h') h') ^ k * inv_h' ^ k) := by ring
      rw [h_rhs, hinv_pow, mul_one]
    rwa [hr_sub] at hmul_v
  have hX_prod : (AlgebraicGeometry.Spec.preimage (e_U ≫ ι_U ≫ g)).hom PowerSeries.X =
      (1 : A'_final) * u ^ 1 * v ^ 1 := by
    rw [hPre_Afin, hcomm_ring, hrel_P₁, map_mul, map_mul, pow_one, pow_one, one_mul]
  exact ⟨R₀, p₀, ι_U, z₁, z₂, A'_final, v_final, e_U, u, v, 1,
    inferInstance, hp₀_base, hDom_R₀, hp₀_span, hz₁_ne, hz₂_reg_R₀, hRes_R₀,
    hEt_eU, hDom_Afinal, hFib_singleton, hvfin_span, hu_ne, hv_reg_fin, hRes_Afin,
    isUnit_one, le_rfl, hX_prod⟩

theorem weil_nc2d_affineOpen_isIntegrallyClosed (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (n : ℕ)
    (W : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (τ_W : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)) ⟶ W))
    (hW : IsNC2DPointedSurface Ω n g_W τ_W)
    (U : W.Opens)
    (hAff : AlgebraicGeometry.IsAffineOpen U)
    (hNE : Nonempty ↥U) :
    IsIntegrallyClosed ↑(W.presheaf.obj (Opposite.op U)) :=
by
  have h_s1 : ∀ (F_base B : Type u) [Field F_base] [CommRing B]
      (ψ : MvPolynomial (Fin 1) F_base →+* B) (_ : ψ.Etale)
      (p : Ideal B) [p.IsPrime] (_ : IsDomain (Localization.AtPrime p)),
      IsIntegrallyClosed (Localization.AtPrime p) := by
    intro F_base B _ _ ψ hEt p _ hDom
    let M₁ := MvPolynomial (Fin 1) F_base
    let L_B := Localization.AtPrime p
    letI : Algebra M₁ B := ψ.toAlgebra
    haveI : Algebra.Etale M₁ B := RingHom.etale_algebraMap.mp hEt
    let e_poly : M₁ ≃ₐ[F_base] Polynomial F_base :=
      (MvPolynomial.finSuccEquiv F_base 0).trans
        (Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv F_base (Fin 0)))
    haveI : IsPrincipalIdealRing M₁ :=
      IsPrincipalIdealRing.of_surjective e_poly.symm.toRingHom e_poly.symm.surjective
    haveI : IsNoetherianRing M₁ := inferInstance
    haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing M₁ B
    haveI : IsNoetherianRing L_B := IsLocalization.isNoetherianRing p.primeCompl L_B ‹_›
    let q : Ideal M₁ := Ideal.comap ψ p
    haveI : q.IsPrime := Ideal.IsPrime.comap ψ
    obtain ⟨ϖ₀, hq_span⟩ := Submodule.IsPrincipal.principal q
    have hq_eq : q = Ideal.span {ϖ₀} := by simpa only [Ideal.submodule_span_eq] using hq_span
    let u_B : L_B := algebraMap B L_B (ψ ϖ₀)
    have hϖ_p : ψ ϖ₀ ∈ p := by
      change ϖ₀ ∈ q
      rw [hq_eq]
      exact Ideal.subset_span rfl
    have hu_max : u_B ∈ IsLocalRing.maximalIdeal L_B :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff L_B p (ψ ϖ₀)).mpr hϖ_p
    let I_u : Ideal L_B := Ideal.span ({u_B} : Set L_B)
    let Q_L := L_B ⧸ I_u
    have hIu_le : I_u ≤ IsLocalRing.maximalIdeal L_B :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu_max)
    have hIu_ne_top : I_u ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal L_B).ne_top (top_unique (h ▸ hIu_le))
    have : Nontrivial Q_L := Submodule.Quotient.nontrivial_iff.mpr hIu_ne_top
    have : IsLocalRing Q_L :=
      IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun y => by
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
        rcases IsLocalRing.isUnit_or_isUnit_one_sub_self z with hz | hz
        · exact Or.inl (hz.map (Ideal.Quotient.mk I_u))
        · exact Or.inr (by simpa only [map_sub, map_one] using hz.map (Ideal.Quotient.mk I_u))
    let κ := FractionRing (M₁ ⧸ q)
    have hEt_T : Algebra.Etale κ (TensorProduct M₁ κ B) := Algebra.Etale.baseChange M₁ B κ
    obtain ⟨I, instFinI, E, instFieldE, instAlgκE, e_prod, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ (TensorProduct M₁ κ B)).mp hEt_T
    letI : Finite I := instFinI
    letI : ∀ i : I, Field (E i) := instFieldE
    letI : ∀ i : I, Algebra κ (E i) := instAlgκE
    have hvN : ∀ t : TensorProduct M₁ κ B, ∃ w : TensorProduct M₁ κ B, t * t * w = t := by
      intro t
      refine ⟨e_prod.symm (fun i => (e_prod t i)⁻¹), ?_⟩
      apply e_prod.injective
      ext i
      simp only [map_mul, AlgEquiv.apply_symm_apply, Pi.mul_apply]
      by_cases hi : e_prod t i = 0
      · simp [hi]
      · rw [mul_assoc, mul_inv_cancel₀ hi, mul_one]
    let π_Q : L_B →+* Q_L := Ideal.Quotient.mk I_u
    let g_B : B →+* Q_L := π_Q.comp (algebraMap B L_B)
    have hker_q : ∀ m ∈ q, (g_B.comp ψ) m = 0 := by
      intro m hm
      rw [hq_eq, Ideal.mem_span_singleton] at hm
      obtain ⟨c, rfl⟩ := hm
      simp only [RingHom.comp_apply, map_mul, g_B, π_Q]
      have hu_zero : Ideal.Quotient.mk I_u u_B = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      change Ideal.Quotient.mk I_u u_B * _ = 0
      rw [hu_zero, zero_mul]
    let g_Mbar : M₁ ⧸ q →+* Q_L := Ideal.Quotient.lift q (g_B.comp ψ) hker_q
    have hg_units : ∀ s : nonZeroDivisors (M₁ ⧸ q), IsUnit (g_Mbar s) := by
      intro s
      have hs_ne : (s : M₁ ⧸ q) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      obtain ⟨m, hm_eq⟩ := Ideal.Quotient.mk_surjective (s : M₁ ⧸ q)
      have hm_not_q : m ∉ q := by
        intro hm_q
        apply hs_ne
        rw [← hm_eq, Ideal.Quotient.eq_zero_iff_mem]
        exact hm_q
      have hψm_not_p : ψ m ∉ p := hm_not_q
      have hunit_L : IsUnit (algebraMap B L_B (ψ m)) :=
        IsLocalization.map_units L_B (⟨ψ m, hψm_not_p⟩ : p.primeCompl)
      have h_eq : g_Mbar s = π_Q (algebraMap B L_B (ψ m)) := by
        rw [← hm_eq]
        rfl
      rw [h_eq]
      exact hunit_L.map π_Q
    let g_κ : κ →+* Q_L := IsLocalization.lift (M := nonZeroDivisors (M₁ ⧸ q)) hg_units
    let g_κ_alg : κ →ₐ[M₁] Q_L :=
      { toRingHom := g_κ
        commutes' := fun m => by
          change g_κ (algebraMap (M₁ ⧸ q) κ (Ideal.Quotient.mk q m)) = algebraMap M₁ Q_L m
          rw [IsLocalization.lift_eq]
          rfl }
    let g_B_alg : B →ₐ[M₁] Q_L :=
      { toRingHom := g_B
        commutes' := fun _ => rfl }
    let g_QL : TensorProduct M₁ κ B →ₐ[M₁] Q_L :=
      Algebra.TensorProduct.lift g_κ_alg g_B_alg (fun _ _ => Commute.all _ _)
    have hQ_field : IsField Q_L :=
      { exists_pair_ne := exists_pair_ne Q_L
        mul_comm := mul_comm
        mul_inv_cancel := fun {y} hy => by
          obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
          obtain ⟨⟨b, s⟩, hzs⟩ := IsLocalization.surj p.primeCompl z
          have hv_unit : IsUnit (π_Q (algebraMap B L_B s)) :=
            (IsLocalization.map_units L_B s).map π_Q
          obtain ⟨v_inv, hv_inv⟩ := hv_unit.exists_right_inv
          let v_s : Q_L := π_Q (algebraMap B L_B s)
          have hy_vs : π_Q z * v_s = g_QL (TensorProduct.tmul M₁ (1 : κ) b) := by
            have h1 : π_Q (z * algebraMap B L_B s) = π_Q (algebraMap B L_B b) :=
              congrArg π_Q hzs
            rw [map_mul] at h1
            dsimp [g_QL]
            simpa [v_s, g_B_alg, g_B] using h1
          obtain ⟨w, hw⟩ := hvN (TensorProduct.tmul M₁ (1 : κ) b)
          have h_eq1 : (π_Q z * v_s) * (π_Q z * v_s) * g_QL w = π_Q z * v_s := by
            have hmap := congrArg g_QL hw
            simpa only [map_mul, hy_vs] using hmap
          have h_eq2 : π_Q z * π_Q z * (v_s * g_QL w) = π_Q z := by
            calc π_Q z * π_Q z * (v_s * g_QL w)
                = ((π_Q z * v_s) * (π_Q z * v_s) * g_QL w) * v_inv := by
                    have : v_s * v_inv = 1 := hv_inv
                    linear_combination -(π_Q z * π_Q z * v_s * g_QL w) * this
              _ = (π_Q z * v_s) * v_inv := by rw [h_eq1]
              _ = π_Q z * (v_s * v_inv) := by ring
              _ = π_Q z := by rw [hv_inv, mul_one]
          let e : Q_L := π_Q z * (v_s * g_QL w)
          have hye : π_Q z * e = π_Q z := by
            dsimp [e]
            rw [← mul_assoc]
            exact h_eq2
          have hee : e * e = e := by
            calc e * e
                = (π_Q z * e) * (v_s * g_QL w) := by dsimp [e]; ring
              _ = e := by rw [hye]
          have he_idem : e * (1 - e) = 0 := by
            rw [mul_sub, mul_one, hee, sub_self]
          rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with he_unit | h1e_unit
          · have hy_unit : IsUnit (π_Q z) := isUnit_of_mul_isUnit_left he_unit
            exact isUnit_iff_exists_inv.mp hy_unit
          · exfalso
            obtain ⟨u', hu'⟩ := h1e_unit.exists_right_inv
            have he0 : e = 0 := by
              calc e = e * ((1 - e) * u') := by rw [hu', mul_one]
                _ = (e * (1 - e)) * u' := by ring
                _ = 0 := by rw [he_idem, zero_mul]
            apply hy
            rw [← hye, he0, mul_zero] }
    have hIu_max : I_u.IsMaximal :=
      Ideal.Quotient.maximal_ideal_iff_isField_quotient I_u |>.mpr hQ_field
    have hmax_eq : IsLocalRing.maximalIdeal L_B = I_u :=
      (IsLocalRing.eq_maximalIdeal hIu_max).symm
    have hPrinc : (IsLocalRing.maximalIdeal L_B).IsPrincipal := by
      rw [hmax_eq]
      exact ⟨⟨u_B, by simp [I_u, Ideal.submodule_span_eq]⟩⟩
    by_cases hF : IsField L_B
    · letI : Field L_B := hF.toField
      exact inferInstance
    · have : IsDomain L_B := hDom
      have : IsDiscreteValuationRing L_B :=
        ((IsDiscreteValuationRing.TFAE L_B hF).out 1 5).mpr hPrinc
      exact inferInstance
  have h_s2 : ∀ (L : Type u) [CommRing L] [IsDomain L] [IsLocalRing L]
      (σ : Ω →+* L) (u₁ u₂ : L),
      IsLocalRing.maximalIdeal L = Ideal.span ({u₁, u₂} : Set L) →
      u₁ ≠ 0 →
      (∀ y : L, u₂ * y ∈ Ideal.span ({u₁} : Set L) → y ∈ Ideal.span ({u₁} : Set L)) →
      (∀ x : L, ∃ c : Ω, x - σ c ∈ IsLocalRing.maximalIdeal L) →
      ∃ (Ψ : PowerSeries (PowerSeries Ω) ≃+* AdicCompletion (IsLocalRing.maximalIdeal L) L),
        ∀ F : PowerSeries (PowerSeries Ω),
          AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal L) (Ψ F) =
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal L)
              (σ (PowerSeries.constantCoeff (PowerSeries.constantCoeff F))) := by
    intro L _ _ _ σ u₁ u₂ hMax hu₁ hReg hRes
    let m_L : Ideal L := IsLocalRing.maximalIdeal L
    let P₂ := PowerSeries (PowerSeries Ω)
    have hu₁_mem : u₁ ∈ m_L := by
      change u₁ ∈ IsLocalRing.maximalIdeal L
      rw [hMax]
      exact Ideal.subset_span (Set.mem_insert u₁ {u₂})
    have hu₂_mem : u₂ ∈ m_L := by
      change u₂ ∈ IsLocalRing.maximalIdeal L
      rw [hMax]
      exact Ideal.subset_span (Set.mem_insert_of_mem u₁ rfl)
    have hu_pow_mem : ∀ a b : ℕ, u₁ ^ a * u₂ ^ b ∈ m_L ^ (a + b) := by
      intro a b
      rw [pow_add]
      exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hu₁_mem a) (Ideal.pow_mem_pow hu₂_mem b)
    let H_deg : P₂ → ℕ → L := fun F d =>
      ∑ p ∈ Finset.HasAntidiagonal.antidiagonal d,
        σ (PowerSeries.coeff p.1 (PowerSeries.coeff p.2 F)) * u₁ ^ p.1 * u₂ ^ p.2
    let S_trunc : P₂ → ℕ → L := fun F N => ∑ d ∈ Finset.range N, H_deg F d
    have hH_mem : ∀ (F : P₂) (d : ℕ), H_deg F d ∈ m_L ^ d := by
      intro F d
      apply Ideal.sum_mem
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      rw [← hp, mul_assoc]
      exact (m_L ^ (p.1 + p.2)).mul_mem_left _ (hu_pow_mem p.1 p.2)
    have hH_zero : ∀ d : ℕ, H_deg 0 d = 0 := fun d => by simp [H_deg]
    have hH_add : ∀ (F G : P₂) (d : ℕ), H_deg (F + G) d = H_deg F d + H_deg G d := fun F G d => by
      simp [H_deg, add_mul, Finset.sum_add_distrib]
    have hH_one_zero : H_deg 1 0 = 1 := by simp [H_deg]
    have hH_one_pos : ∀ d : ℕ, d ≠ 0 → H_deg 1 d = 0 := by
      intro d hd
      apply Finset.sum_eq_zero
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      by_cases hp2 : p.2 = 0
      · have hp1 : p.1 ≠ 0 := by omega
        simp [hp2, PowerSeries.coeff_one, hp1]
      · simp [PowerSeries.coeff_one, hp2]
    have hH_mul : ∀ (F G : P₂) (d : ℕ),
        H_deg (F * G) d = ∑ q ∈ Finset.HasAntidiagonal.antidiagonal d, H_deg F q.1 * H_deg G q.2 := by
      intro F G d
      have hL : H_deg (F * G) d =
          ∑ x ∈ (Finset.HasAntidiagonal.antidiagonal d).sigma
              (fun p => Finset.HasAntidiagonal.antidiagonal p.2 ×ˢ Finset.HasAntidiagonal.antidiagonal p.1),
            σ (PowerSeries.coeff x.2.2.1 (PowerSeries.coeff x.2.1.1 F)) *
              σ (PowerSeries.coeff x.2.2.2 (PowerSeries.coeff x.2.1.2 G)) *
              u₁ ^ x.1.1 * u₂ ^ x.1.2 := by
        rw [Finset.sum_sigma]
        dsimp only [H_deg]
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [Finset.sum_product, PowerSeries.coeff_mul, map_sum]
        simp only [PowerSeries.coeff_mul, map_sum, map_mul, Finset.sum_mul]
      have hR : (∑ q ∈ Finset.HasAntidiagonal.antidiagonal d, H_deg F q.1 * H_deg G q.2) =
          ∑ y ∈ (Finset.HasAntidiagonal.antidiagonal d).sigma
              (fun q => Finset.HasAntidiagonal.antidiagonal q.1 ×ˢ Finset.HasAntidiagonal.antidiagonal q.2),
            (σ (PowerSeries.coeff y.2.1.1 (PowerSeries.coeff y.2.1.2 F)) *
                u₁ ^ y.2.1.1 * u₂ ^ y.2.1.2) *
              (σ (PowerSeries.coeff y.2.2.1 (PowerSeries.coeff y.2.2.2 G)) *
                u₁ ^ y.2.2.1 * u₂ ^ y.2.2.2) := by
        rw [Finset.sum_sigma]
        dsimp only [H_deg]
        refine Finset.sum_congr rfl fun q _ => ?_
        rw [Finset.sum_mul_sum, Finset.sum_product]
      rw [hL, hR]
      refine Finset.sum_bij'
        (fun x _ => ⟨(x.2.2.1 + x.2.1.1, x.2.2.2 + x.2.1.2),
          ((x.2.2.1, x.2.1.1), (x.2.2.2, x.2.1.2))⟩)
        (fun y _ => ⟨(y.2.1.1 + y.2.2.1, y.2.1.2 + y.2.2.2),
          ((y.2.1.2, y.2.2.2), (y.2.1.1, y.2.2.1))⟩)
        ?_ ?_ ?_ ?_ ?_
      · rintro ⟨⟨p1, p2⟩, ⟨⟨r1, r2⟩, ⟨s1, s2⟩⟩⟩ hx
        rw [Finset.mem_sigma, Finset.mem_product] at hx
        rcases hx with ⟨hp, hr, hs⟩
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp hr hs
        dsimp at hp hr hs
        rw [Finset.mem_sigma, Finset.mem_product]
        refine ⟨by rw [Finset.HasAntidiagonal.mem_antidiagonal]; dsimp; omega,
          by rw [Finset.HasAntidiagonal.mem_antidiagonal],
          by rw [Finset.HasAntidiagonal.mem_antidiagonal]⟩
      · rintro ⟨⟨q1, q2⟩, ⟨⟨u1', u2'⟩, ⟨v1', v2'⟩⟩⟩ hy
        rw [Finset.mem_sigma, Finset.mem_product] at hy
        rcases hy with ⟨hq, hu, hv⟩
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hq hu hv
        dsimp at hq hu hv
        rw [Finset.mem_sigma, Finset.mem_product]
        refine ⟨by rw [Finset.HasAntidiagonal.mem_antidiagonal]; dsimp; omega,
          by rw [Finset.HasAntidiagonal.mem_antidiagonal],
          by rw [Finset.HasAntidiagonal.mem_antidiagonal]⟩
      · rintro ⟨⟨p1, p2⟩, ⟨⟨r1, r2⟩, ⟨s1, s2⟩⟩⟩ hx
        rw [Finset.mem_sigma, Finset.mem_product] at hx
        rcases hx with ⟨hp, hr, hs⟩
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp hr hs
        dsimp at hp hr hs
        refine Sigma.ext ?_ (heq_of_eq rfl)
        ext <;> dsimp <;> omega
      · rintro ⟨⟨q1, q2⟩, ⟨⟨u1', u2'⟩, ⟨v1', v2'⟩⟩⟩ hy
        rw [Finset.mem_sigma, Finset.mem_product] at hy
        rcases hy with ⟨hq, hu, hv⟩
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hq hu hv
        dsimp at hq hu hv
        refine Sigma.ext ?_ (heq_of_eq rfl)
        ext <;> dsimp <;> omega
      · rintro ⟨⟨p1, p2⟩, ⟨⟨r1, r2⟩, ⟨s1, s2⟩⟩⟩ hx
        rw [Finset.mem_sigma, Finset.mem_product] at hx
        rcases hx with ⟨hp, hr, hs⟩
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp hr hs
        dsimp at hp hr hs ⊢
        rw [← hs, ← hr, pow_add, pow_add]
        ring
    let Ψ_N : ∀ N : ℕ, P₂ →+* L ⧸ m_L ^ N := fun N =>
      { toFun := fun F => Ideal.Quotient.mk (m_L ^ N) (S_trunc F N)
        map_zero' := by simp [S_trunc, hH_zero]
        map_add' := fun F G => by
          simp only [S_trunc, hH_add, Finset.sum_add_distrib, map_add]
        map_one' := by
          rcases Nat.eq_zero_or_pos N with rfl | hN_pos
          · apply Ideal.Quotient.eq.mpr
            rw [pow_zero, Ideal.one_eq_top]
            exact Submodule.mem_top
          · obtain ⟨N', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hN_pos)
            have hS1 : S_trunc 1 (N' + 1) = 1 := by
              dsimp [S_trunc]
              rw [Finset.sum_range_succ', hH_one_zero]
              have hrest : (∑ k ∈ Finset.range N', H_deg 1 (k + 1)) = 0 :=
                Finset.sum_eq_zero fun k _ => hH_one_pos (k + 1) (Nat.succ_ne_zero k)
              rw [hrest, zero_add]
            rw [hS1, map_one]
        map_mul' := fun F G => by
          rw [← map_mul]
          apply Ideal.Quotient.eq.mpr
          have hprod : S_trunc F N * S_trunc G N =
              ∑ q ∈ Finset.range N ×ˢ Finset.range N, H_deg F q.1 * H_deg G q.2 := by
            dsimp [S_trunc]
            rw [Finset.sum_mul_sum, Finset.sum_product]
          have hsplit := (Finset.sum_filter_add_sum_filter_not
            (Finset.range N ×ˢ Finset.range N) (fun q : ℕ × ℕ => q.1 + q.2 < N)
            (fun q => H_deg F q.1 * H_deg G q.2)).symm
          have hlow : (∑ q ∈ (Finset.range N ×ˢ Finset.range N).filter (fun q => q.1 + q.2 < N),
              H_deg F q.1 * H_deg G q.2) = S_trunc (F * G) N := by
            have hfg : S_trunc (F * G) N =
                ∑ y ∈ (Finset.range N).sigma Finset.HasAntidiagonal.antidiagonal,
                  H_deg F y.2.1 * H_deg G y.2.2 := by
              simp only [S_trunc, hH_mul, Finset.sum_sigma]
            rw [hfg]
            refine Finset.sum_bij'
              (fun q _ => ⟨q.1 + q.2, q⟩)
              (fun y _ => y.2)
              ?_ ?_ ?_ ?_ ?_
            · rintro ⟨q1, q2⟩ hq
              rw [Finset.mem_filter, Finset.mem_product] at hq
              rw [Finset.mem_sigma, Finset.mem_range, Finset.HasAntidiagonal.mem_antidiagonal]
              exact ⟨hq.2, rfl⟩
            · rintro ⟨d, ⟨q1, q2⟩⟩ hy
              rw [Finset.mem_sigma, Finset.mem_range, Finset.HasAntidiagonal.mem_antidiagonal] at hy
              rw [Finset.mem_filter, Finset.mem_product, Finset.mem_range, Finset.mem_range]
              dsimp at hy ⊢
              omega
            · rintro ⟨q1, q2⟩ _
              rfl
            · rintro ⟨d, ⟨q1, q2⟩⟩ hy
              rw [Finset.mem_sigma, Finset.mem_range, Finset.HasAntidiagonal.mem_antidiagonal] at hy
              dsimp at hy
              exact Sigma.ext (by dsimp; omega) (heq_of_eq rfl)
            · rintro ⟨q1, q2⟩ _
              rfl
          have hdiff : S_trunc (F * G) N - S_trunc F N * S_trunc G N =
              -(∑ q ∈ (Finset.range N ×ˢ Finset.range N).filter (fun q => ¬(q.1 + q.2 < N)),
                  H_deg F q.1 * H_deg G q.2) := by
            rw [hprod, hsplit, hlow]
            ring
          rw [hdiff]
          apply (m_L ^ N).neg_mem
          apply Ideal.sum_mem
          intro q hq
          simp only [Finset.mem_filter] at hq
          have hge : N ≤ q.1 + q.2 := Nat.le_of_not_lt hq.2
          have hmem_q : H_deg F q.1 * H_deg G q.2 ∈ m_L ^ (q.1 + q.2) := by
            rw [pow_add]
            exact Ideal.mul_mem_mul (hH_mem F q.1) (hH_mem G q.2)
          exact Ideal.pow_le_pow_right hge hmem_q }
    have hCompat : ∀ {M N : ℕ} (hle : M ≤ N),
        (Ideal.Quotient.factorPow m_L hle).comp (Ψ_N N) = Ψ_N M := by
      intro M N hle
      ext F
      simp only [RingHom.comp_apply, Ψ_N, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
      change Ideal.Quotient.factor (Ideal.pow_le_pow_right hle)
          (Ideal.Quotient.mk (m_L ^ N) (S_trunc F N)) =
        Ideal.Quotient.mk (m_L ^ M) (S_trunc F M)
      rw [Ideal.Quotient.factor_mk]
      apply Ideal.Quotient.eq.mpr
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hle
      have hsum : S_trunc F (M + k) - S_trunc F M =
          ∑ i ∈ Finset.range k, H_deg F (M + i) := by
        dsimp [S_trunc]
        rw [Finset.sum_range_add]
        ring
      rw [hsum]
      apply Ideal.sum_mem
      intro i _
      exact Ideal.pow_le_pow_right (Nat.le_add_right M i) (hH_mem F (M + i))
    let Ψ_hom : P₂ →+* AdicCompletion m_L L := AdicCompletion.liftRingHom m_L Ψ_N hCompat
    have hEval_N : ∀ (N : ℕ) (F : P₂), AdicCompletion.evalₐ m_L N (Ψ_hom F) = Ψ_N N F :=
      fun N F => AdicCompletion.evalₐ_liftRingHom m_L Ψ_N hCompat N F
    have hEval1 : ∀ F : P₂,
        AdicCompletion.evalOneₐ m_L (Ψ_hom F) =
          Ideal.Quotient.mk m_L (σ (PowerSeries.constantCoeff (PowerSeries.constantCoeff F))) := by
      intro F
      have h1 := hEval_N 1 F
      have hS1 : S_trunc F 1 = σ (PowerSeries.constantCoeff (PowerSeries.constantCoeff F)) := by
        simp [S_trunc, H_deg]
      change (Ideal.Quotient.factor (le_of_eq (pow_one m_L)))
          (AdicCompletion.evalₐ m_L 1 (Ψ_hom F)) = _
      rw [h1]
      simp only [Ψ_N, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, hS1,
        Ideal.Quotient.factor_mk]
    have hSpanPow : ∀ (d : ℕ) (z : L), z ∈ m_L ^ d →
        ∃ r : ℕ → L, z = ∑ k ∈ Finset.range (d + 1), r k * u₁ ^ k * u₂ ^ (d - k) := by
      intro d
      induction d with
      | zero =>
        intro z _
        refine ⟨fun _ => z, ?_⟩
        simp
      | succ d ih =>
        let M_sub : Ideal L :=
          { carrier := {x : L | ∃ r : ℕ → L,
              x = ∑ k ∈ Finset.range (d + 2), r k * u₁ ^ k * u₂ ^ (d + 1 - k)}
            zero_mem' := ⟨fun _ => 0, by simp⟩
            add_mem' := by
              rintro x y ⟨rx, rfl⟩ ⟨ry, rfl⟩
              refine ⟨fun k => rx k + ry k, ?_⟩
              simp [add_mul, Finset.sum_add_distrib]
            smul_mem' := by
              rintro c x ⟨rx, rfl⟩
              refine ⟨fun k => c * rx k, ?_⟩
              simp only [smul_eq_mul, Finset.mul_sum]
              refine Finset.sum_congr rfl fun k _ => by ring }
        have hle_M : m_L ^ (d + 1) ≤ M_sub := by
          rw [pow_succ, Submodule.mul_le]
          intro w hw m hm
          obtain ⟨rw, rfl⟩ := ih w hw
          have hm_span : m ∈ Ideal.span ({u₁, u₂} : Set L) := by
            rwa [← hMax]
          rw [Ideal.mem_span_pair] at hm_span
          obtain ⟨a, b, rfl⟩ := hm_span
          have h_u1 : (∑ k ∈ Finset.range (d + 1), rw k * u₁ ^ k * u₂ ^ (d - k)) * (a * u₁) ∈
              M_sub := by
            refine ⟨fun k => if k = 0 then 0 else a * rw (k - 1), ?_⟩
            conv_rhs => rw [Finset.sum_range_succ']
            simp only [↓reduceIte, zero_mul, Nat.add_sub_cancel, add_zero, Nat.succ_ne_zero]
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun k hk => ?_
            rw [Finset.mem_range] at hk
            have hsub : d + 1 - (k + 1) = d - k := by omega
            rw [hsub, pow_succ]
            ring
          have h_u2 : (∑ k ∈ Finset.range (d + 1), rw k * u₁ ^ k * u₂ ^ (d - k)) * (b * u₂) ∈
              M_sub := by
            refine ⟨fun k => if k ≤ d then b * rw k else 0, ?_⟩
            conv_rhs => rw [Finset.sum_range_succ]
            have hnot : ¬ (d + 1 ≤ d) := by omega
            simp only [hnot, ↓reduceIte, zero_mul, add_zero]
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun k hk => ?_
            rw [Finset.mem_range] at hk
            have hle_k : k ≤ d := by omega
            have hsub : d + 1 - k = (d - k) + 1 := by omega
            simp only [hle_k, ↓reduceIte, hsub, pow_succ]
            ring
          have h_distrib : (∑ k ∈ Finset.range (d + 1), rw k * u₁ ^ k * u₂ ^ (d - k)) *
              (a * u₁ + b * u₂) =
            (∑ k ∈ Finset.range (d + 1), rw k * u₁ ^ k * u₂ ^ (d - k)) * (a * u₁) +
            (∑ k ∈ Finset.range (d + 1), rw k * u₁ ^ k * u₂ ^ (d - k)) * (b * u₂) :=
            mul_add _ _ _
          rw [h_distrib]
          exact M_sub.add_mem h_u1 h_u2
        intro z hz
        exact hle_M hz
    have hRegPow : ∀ (m : ℕ) (y : L),
        u₂ ^ m * y ∈ Ideal.span ({u₁} : Set L) → y ∈ Ideal.span ({u₁} : Set L) := by
      intro m
      induction m with
      | zero =>
        intro y hy
        simpa using hy
      | succ m ih =>
        intro y hy
        apply hReg
        apply ih
        have heq : u₂ ^ m * (u₂ * y) = u₂ ^ (m + 1) * y := by rw [pow_succ]; ring
        rwa [heq]
    have hQuasiReg : ∀ (d : ℕ) (a : ℕ → Ω),
        (∑ k ∈ Finset.range (d + 1), σ (a k) * u₁ ^ k * u₂ ^ (d - k)) ∈ m_L ^ (d + 1) →
        ∀ k ≤ d, a k = 0 := by
      intro d
      induction d with
      | zero =>
        intro a ha k hk
        have hk0 : k = 0 := by omega
        subst hk0
        have ha' : σ (a 0) ∈ m_L := by simpa using ha
        by_contra hne
        have hunit : IsUnit (σ (a 0)) := (IsUnit.mk0 (a 0) hne).map σ
        exact (IsLocalRing.notMem_maximalIdeal.mpr hunit) ha'
      | succ d ih =>
        intro a ha
        obtain ⟨r_decomp, hr_decomp⟩ := hSpanPow (d + 2) _ ha
        let r₀ : L := r_decomp 0
        let w : L := ∑ j ∈ Finset.range (d + 2),
          r_decomp (j + 1) * u₁ ^ j * u₂ ^ (d + 1 - j)
        have hw_mem : w ∈ m_L ^ (d + 1) := by
          apply Ideal.sum_mem
          intro j hj
          rw [Finset.mem_range] at hj
          have hle_j : d + 1 ≤ j + (d + 1 - j) := by omega
          rw [mul_assoc]
          exact (m_L ^ (d + 1)).mul_mem_left _
            (Ideal.pow_le_pow_right hle_j (hu_pow_mem j (d + 1 - j)))
        have h_rhs : (∑ k ∈ Finset.range (d + 3), r_decomp k * u₁ ^ k * u₂ ^ (d + 2 - k)) =
            r₀ * u₂ ^ (d + 2) + u₁ * w := by
          rw [Finset.sum_range_succ', add_comm]
          simp only [pow_zero, mul_one, Nat.sub_zero]
          congr 1
          dsimp [w]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          have hsub : d + 2 - (j + 1) = d + 1 - j := by omega
          rw [hsub, pow_succ]
          ring
        let T : L := ∑ j ∈ Finset.range (d + 1), σ (a (j + 1)) * u₁ ^ j * u₂ ^ (d - j)
        have h_lhs : (∑ k ∈ Finset.range (d + 2), σ (a k) * u₁ ^ k * u₂ ^ (d + 1 - k)) =
            σ (a 0) * u₂ ^ (d + 1) + u₁ * T := by
          rw [Finset.sum_range_succ', add_comm]
          simp only [pow_zero, mul_one, Nat.sub_zero]
          congr 1
          dsimp [T]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          have hsub : d + 1 - (j + 1) = d - j := by omega
          rw [hsub, pow_succ]
          ring
        have h_eq : σ (a 0) * u₂ ^ (d + 1) + u₁ * T = r₀ * u₂ ^ (d + 2) + u₁ * w := by
          rw [← h_lhs, ← h_rhs]
          exact hr_decomp
        have h_div1 : u₂ ^ (d + 1) * (σ (a 0) - r₀ * u₂) ∈ Ideal.span ({u₁} : Set L) := by
          rw [Ideal.mem_span_singleton]
          refine ⟨w - T, ?_⟩
          have h1 : u₂ ^ (d + 1) * (σ (a 0) - r₀ * u₂) =
              (σ (a 0) * u₂ ^ (d + 1) + u₁ * T) - (r₀ * u₂ ^ (d + 2) + u₁ * w) +
                u₁ * (w - T) := by
            rw [pow_succ _ (d + 1)]
            ring
          rw [h1, h_eq, sub_self, zero_add]
        have ha0_mod : σ (a 0) - r₀ * u₂ ∈ Ideal.span ({u₁} : Set L) :=
          hRegPow (d + 1) _ h_div1
        have ha0_mem : σ (a 0) ∈ m_L := by
          have h1 : σ (a 0) - r₀ * u₂ ∈ m_L :=
            (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hu₁_mem)) ha0_mod
          have h2 : r₀ * u₂ ∈ m_L := m_L.mul_mem_left r₀ hu₂_mem
          have h3 : σ (a 0) = (σ (a 0) - r₀ * u₂) + r₀ * u₂ := by ring
          rw [h3]
          exact m_L.add_mem h1 h2
        have ha0_zero : a 0 = 0 := by
          by_contra hne
          have hunit : IsUnit (σ (a 0)) := (IsUnit.mk0 (a 0) hne).map σ
          exact (IsLocalRing.notMem_maximalIdeal.mpr hunit) ha0_mem
        have h_div2 : u₂ ^ (d + 2) * r₀ ∈ Ideal.span ({u₁} : Set L) := by
          rw [Ideal.mem_span_singleton]
          refine ⟨T - w, ?_⟩
          have hσ0 : σ (a 0) = 0 := by rw [ha0_zero, map_zero]
          rw [hσ0, zero_mul, zero_add] at h_eq
          linear_combination -h_eq
        have hr0_mem : r₀ ∈ Ideal.span ({u₁} : Set L) := hRegPow (d + 2) r₀ h_div2
        rw [Ideal.mem_span_singleton] at hr0_mem
        obtain ⟨s, hs⟩ := hr0_mem
        have hT_eq : T = s * u₂ ^ (d + 2) + w := by
          apply mul_left_cancel₀ hu₁
          have hσ0 : σ (a 0) = 0 := by rw [ha0_zero, map_zero]
          rw [hσ0, zero_mul, zero_add, hs] at h_eq
          linear_combination h_eq
        have hT_mem : T ∈ m_L ^ (d + 1) := by
          rw [hT_eq]
          apply (m_L ^ (d + 1)).add_mem _ hw_mem
          have hu2_pow : u₂ ^ (d + 2) ∈ m_L ^ (d + 1) :=
            Ideal.pow_le_pow_right (by omega) (Ideal.pow_mem_pow hu₂_mem (d + 2))
          exact (m_L ^ (d + 1)).mul_mem_left s hu2_pow
        have h_ih := ih (fun j => a (j + 1)) hT_mem
        intro k hk
        rcases Nat.eq_zero_or_pos k with rfl | hk_pos
        · exact ha0_zero
        · obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hk_pos)
          exact h_ih j (by omega)
    have hZeroCoeff : ∀ (N : ℕ) (D : P₂), Ψ_N N D = 0 →
        ∀ i j : ℕ, i + j < N → PowerSeries.coeff i (PowerSeries.coeff j D) = 0 := by
      intro N D hDN
      by_contra hNot
      push Not at hNot
      obtain ⟨i₀, j₀, hij₀, hne₀⟩ := hNot
      have hex : ∃ d : ℕ, d < N ∧ ∃ k ≤ d,
          PowerSeries.coeff k (PowerSeries.coeff (d - k) D) ≠ 0 :=
        ⟨i₀ + j₀, hij₀, i₀, Nat.le_add_right i₀ j₀, by simpa using hne₀⟩
      classical
      let d := Nat.find hex
      obtain ⟨hd_lt, k₀, hk₀_le, hk₀_ne⟩ := Nat.find_spec hex
      have hmin : ∀ d' < d, ¬(d' < N ∧ ∃ k ≤ d',
          PowerSeries.coeff k (PowerSeries.coeff (d' - k) D) ≠ 0) :=
        fun d' hd' => Nat.find_min hex hd'
      have hΨ_d1 : Ψ_N (d + 1) D = 0 := by
        have hle : d + 1 ≤ N := hd_lt
        rw [← hCompat hle, RingHom.comp_apply, hDN, map_zero]
      have hS_mem : S_trunc D (d + 1) ∈ m_L ^ (d + 1) :=
        Ideal.Quotient.eq_zero_iff_mem.mp hΨ_d1
      have hlow_zero : ∀ d' < d, H_deg D d' = 0 := by
        intro d' hd'
        apply Finset.sum_eq_zero
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have hc0 : PowerSeries.coeff p.1 (PowerSeries.coeff p.2 D) = 0 := by
          by_contra hc_ne
          apply hmin d' hd'
          refine ⟨by omega, p.1, by omega, ?_⟩
          have hp2 : d' - p.1 = p.2 := by omega
          rwa [hp2]
        simp [hc0]
      have hS_eq : S_trunc D (d + 1) =
          ∑ k ∈ Finset.range (d + 1),
            σ (PowerSeries.coeff k (PowerSeries.coeff (d - k) D)) * u₁ ^ k * u₂ ^ (d - k) := by
        dsimp [S_trunc]
        rw [Finset.sum_range_succ]
        have h0 : (∑ x ∈ Finset.range d, H_deg D x) = 0 :=
          Finset.sum_eq_zero fun x hx => hlow_zero x (Finset.mem_range.mp hx)
        rw [h0, zero_add]
        dsimp [H_deg]
        exact Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk _ d
      rw [hS_eq] at hS_mem
      exact hk₀_ne (hQuasiReg d _ hS_mem k₀ hk₀_le)
    have hInj : Function.Injective Ψ_hom := by
      rw [RingHom.injective_iff_ker_eq_bot]
      ext D
      simp only [RingHom.mem_ker, Ideal.mem_bot]
      constructor
      · intro hD
        ext j i
        simp only [map_zero]
        have hN : Ψ_N (i + j + 1) D = 0 := by
          rw [← hEval_N (i + j + 1) D, hD, map_zero]
        exact hZeroCoeff (i + j + 1) D hN i j (by omega)
      · rintro rfl
        exact map_zero Ψ_hom
    have hSurj_N : ∀ (N : ℕ) (y : L ⧸ m_L ^ N), ∃ F : P₂, Ψ_N N F = y := by
      intro N
      induction N with
      | zero =>
        intro y
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
        refine ⟨0, ?_⟩
        change Ideal.Quotient.mk (m_L ^ 0) (S_trunc 0 0) = Ideal.Quotient.mk (m_L ^ 0) z
        apply Ideal.Quotient.eq.mpr
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ N ih =>
        intro y
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨F_N, hFN⟩ := ih (Ideal.Quotient.mk (m_L ^ N) z)
        have hz_mem : S_trunc F_N N - z ∈ m_L ^ N := Ideal.Quotient.eq.mp hFN
        have hdiff_mem : z - S_trunc F_N N ∈ m_L ^ N := by
          have hneg := (m_L ^ N).neg_mem hz_mem
          simpa using hneg
        obtain ⟨r, hr⟩ := hSpanPow N (z - S_trunc F_N N) hdiff_mem
        choose c hc using fun k : ℕ => hRes (r k)
        let F_next : P₂ := PowerSeries.mk fun j => PowerSeries.mk fun i =>
          if i + j < N then PowerSeries.coeff i (PowerSeries.coeff j F_N)
          else if i + j = N then c i
          else 0
        have hc_next : ∀ i j : ℕ, PowerSeries.coeff i (PowerSeries.coeff j F_next) =
            if i + j < N then PowerSeries.coeff i (PowerSeries.coeff j F_N)
            else if i + j = N then c i
            else 0 := fun i j => by simp [F_next]
        refine ⟨F_next, ?_⟩
        apply Ideal.Quotient.eq.mpr
        have hS_next : S_trunc F_next (N + 1) =
            S_trunc F_N N + ∑ k ∈ Finset.range (N + 1), σ (c k) * u₁ ^ k * u₂ ^ (N - k) := by
          dsimp [S_trunc]
          rw [Finset.sum_range_succ]
          congr 1
          · refine Finset.sum_congr rfl fun d hd => ?_
            rw [Finset.mem_range] at hd
            dsimp [H_deg]
            refine Finset.sum_congr rfl fun p hp => ?_
            rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
            have hlt : p.1 + p.2 < N := by omega
            simp [hc_next, hlt]
          · dsimp [H_deg]
            rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
            refine Finset.sum_congr rfl fun k hk => ?_
            rw [Finset.mem_range] at hk
            have heq_N : k + (N - k) = N := by omega
            simp [hc_next, heq_N]
        have hrem : S_trunc F_next (N + 1) - z =
            -(∑ k ∈ Finset.range (N + 1), (r k - σ (c k)) * u₁ ^ k * u₂ ^ (N - k)) := by
          have h1 : S_trunc F_N N + (∑ k ∈ Finset.range (N + 1), σ (c k) * u₁ ^ k * u₂ ^ (N - k)) - z =
              (∑ k ∈ Finset.range (N + 1), σ (c k) * u₁ ^ k * u₂ ^ (N - k)) - (z - S_trunc F_N N) := by
            ring
          rw [hS_next, h1, hr, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl fun k _ => by ring
        rw [hrem]
        apply (m_L ^ (N + 1)).neg_mem
        apply Ideal.sum_mem
        intro k hk
        rw [Finset.mem_range] at hk
        have h_u : u₁ ^ k * u₂ ^ (N - k) ∈ m_L ^ N := by
          have hsum : k + (N - k) = N := by omega
          simpa only [hsum] using hu_pow_mem k (N - k)
        have h_mul : (r k - σ (c k)) * (u₁ ^ k * u₂ ^ (N - k)) ∈ m_L ^ (N + 1) := by
          rw [pow_succ']
          exact Ideal.mul_mem_mul (hc k) h_u
        simpa only [mul_assoc] using h_mul
    have hSurj : Function.Surjective Ψ_hom := by
      intro x_hat
      choose F_seq hF_seq using fun M : ℕ => hSurj_N M (AdicCompletion.evalₐ m_L M x_hat)
      let F : P₂ := PowerSeries.mk fun j => PowerSeries.mk fun i =>
        PowerSeries.coeff i (PowerSeries.coeff j (F_seq (i + j + 1)))
      refine ⟨F, ?_⟩
      apply AdicCompletion.ext_evalₐ
      intro N
      rw [hEval_N N F, ← hF_seq N]
      have hS_eq : S_trunc F N = S_trunc (F_seq N) N := by
        dsimp [S_trunc]
        refine Finset.sum_congr rfl fun d hd => ?_
        rw [Finset.mem_range] at hd
        dsimp [H_deg]
        refine Finset.sum_congr rfl fun p hp => ?_
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have hle : p.1 + p.2 + 1 ≤ N := by omega
        have hΨ_eq : Ψ_N (p.1 + p.2 + 1) (F_seq N - F_seq (p.1 + p.2 + 1)) = 0 := by
          rw [map_sub, sub_eq_zero]
          calc Ψ_N (p.1 + p.2 + 1) (F_seq N)
              = Ideal.Quotient.factorPow m_L hle (Ψ_N N (F_seq N)) := by
                  rw [← hCompat hle, RingHom.comp_apply]
            _ = Ideal.Quotient.factorPow m_L hle (AdicCompletion.evalₐ m_L N x_hat) := by
                  rw [hF_seq N]
            _ = AdicCompletion.evalₐ m_L (p.1 + p.2 + 1) x_hat := by
                  have hsmul_le : ∀ K : ℕ, m_L ^ K • (⊤ : Submodule L L) ≤ m_L ^ K := by
                    intro K
                    rw [Submodule.smul_le]
                    intro r hr y _
                    exact (m_L ^ K).mul_mem_right y hr
                  obtain ⟨zN, hzN⟩ := Submodule.Quotient.mk_surjective _
                    (AdicCompletion.eval m_L L N x_hat)
                  obtain ⟨zM, hzM⟩ := Submodule.Quotient.mk_surjective _
                    (AdicCompletion.eval m_L L (p.1 + p.2 + 1) x_hat)
                  have hevN : AdicCompletion.evalₐ m_L N x_hat =
                      Ideal.Quotient.mk (m_L ^ N) zN := by
                    rw [← AdicCompletion.factor_eval_eq_evalₐ m_L x_hat (hsmul_le N), ← hzN]
                    rfl
                  have hevM : AdicCompletion.evalₐ m_L (p.1 + p.2 + 1) x_hat =
                      Ideal.Quotient.mk (m_L ^ (p.1 + p.2 + 1)) zM := by
                    rw [← AdicCompletion.factor_eval_eq_evalₐ m_L x_hat (hsmul_le _), ← hzM]
                    rfl
                  have hprop := x_hat.prop hle
                  change Submodule.factor _ (AdicCompletion.eval m_L L N x_hat) =
                    AdicCompletion.eval m_L L (p.1 + p.2 + 1) x_hat at hprop
                  rw [← hzN, ← hzM] at hprop
                  change Submodule.Quotient.mk zN = Submodule.Quotient.mk zM at hprop
                  have hdiff_smul : zN - zM ∈ m_L ^ (p.1 + p.2 + 1) • (⊤ : Submodule L L) :=
                    (Submodule.Quotient.eq _).mp hprop
                  rw [hevN, hevM]
                  change Ideal.Quotient.factor (Ideal.pow_le_pow_right hle)
                    (Ideal.Quotient.mk (m_L ^ N) zN) = _
                  rw [Ideal.Quotient.factor_mk]
                  exact Ideal.Quotient.eq.mpr (hsmul_le _ hdiff_smul)
            _ = Ψ_N (p.1 + p.2 + 1) (F_seq (p.1 + p.2 + 1)) := (hF_seq _).symm
        have hc_diff := hZeroCoeff (p.1 + p.2 + 1) _ hΨ_eq p.1 p.2 (by omega)
        simp only [map_sub, sub_eq_zero] at hc_diff
        have hc_F : PowerSeries.coeff p.1 (PowerSeries.coeff p.2 F) =
            PowerSeries.coeff p.1 (PowerSeries.coeff p.2 (F_seq (p.1 + p.2 + 1))) := by
          simp [F]
        rw [hc_F, hc_diff]
      simp only [Ψ_N, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, hS_eq]
    exact ⟨RingEquiv.ofBijective Ψ_hom ⟨hInj, hSurj⟩, hEval1⟩
  have h_s3 : ∀ (L : Type u) [CommRing L] [IsDomain L] [IsNoetherianRing L] [IsLocalRing L]
      (σ : Ω →+* L)
      (Ψ : PowerSeries (PowerSeries Ω) ≃+* AdicCompletion (IsLocalRing.maximalIdeal L) L),
      (∀ F : PowerSeries (PowerSeries Ω),
        AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal L) (Ψ F) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal L)
            (σ (PowerSeries.constantCoeff (PowerSeries.constantCoeff F)))) →
      IsIntegrallyClosed L := by
    intro L _ _ _ _ σ Ψ hEval1
    let m_L := IsLocalRing.maximalIdeal L
    let P₂ := PowerSeries (PowerSeries Ω)
    let L_hat := AdicCompletion m_L L
    have : IsIntegrallyClosed P₂ := inferInstance
    have : IsDomain L_hat := @MulEquiv.isDomain _ P₂ _ _ _ Ψ.symm.toMulEquiv
    have : IsIntegrallyClosed L_hat := IsIntegrallyClosed.of_equiv Ψ
    have : IsLocalRing P₂ :=
      IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun F => by
        let c : Ω := PowerSeries.constantCoeff (PowerSeries.constantCoeff F)
        by_cases hc : c = 0
        · right
          rw [PowerSeries.isUnit_iff_constantCoeff, PowerSeries.isUnit_iff_constantCoeff]
          simp only [map_sub, map_one]
          change IsUnit (1 - c)
          rw [hc, sub_zero]
          exact isUnit_one
        · left
          rw [PowerSeries.isUnit_iff_constantCoeff, PowerSeries.isUnit_iff_constantCoeff]
          exact IsUnit.mk0 c hc
    have : IsLocalRing L_hat := RingEquiv.isLocalRing Ψ
    let ι : L →+* L_hat := algebraMap L L_hat
    have : IsLocalHom ι := ⟨fun {x} hx => by
      let F_x : P₂ := Ψ.symm (ι x)
      have hFx_unit : IsUnit F_x := hx.map Ψ.symm.toRingHom
      let c : Ω := PowerSeries.constantCoeff (PowerSeries.constantCoeff F_x)
      have hc_unit : IsUnit c := by
        rwa [PowerSeries.isUnit_iff_constantCoeff, PowerSeries.isUnit_iff_constantCoeff] at hFx_unit
      have hσc_not_mem : σ c ∉ m_L :=
        IsLocalRing.notMem_maximalIdeal.mpr (hc_unit.map σ)
      have hΨFx : Ψ F_x = ι x := Ψ.apply_symm_apply (ι x)
      have heval : Ideal.Quotient.mk m_L (σ c) = Ideal.Quotient.mk m_L x := by
        calc Ideal.Quotient.mk m_L (σ c)
            = AdicCompletion.evalOneₐ m_L (Ψ F_x) := (hEval1 F_x).symm
          _ = AdicCompletion.evalOneₐ m_L (algebraMap L L_hat x) := by rw [hΨFx]
          _ = algebraMap L (L ⧸ m_L) x := (AdicCompletion.evalOneₐ m_L).commutes x
          _ = Ideal.Quotient.mk m_L x := rfl
      have hdiff : σ c - x ∈ m_L := Ideal.Quotient.eq.mp heval
      have hx_not_mem : x ∉ m_L := by
        intro hx_mem
        apply hσc_not_mem
        have h_eq : σ c = (σ c - x) + x := by ring
        rw [h_eq]
        exact m_L.add_mem hdiff hx_mem
      exact IsLocalRing.notMem_maximalIdeal.mp hx_not_mem⟩
    have : Module.Flat L L_hat := AdicCompletion.flat_of_isNoetherian m_L
    have : Module.FaithfullyFlat L L_hat := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hι_inj : Function.Injective ι := by
      rw [RingHom.injective_iff_ker_eq_bot]
      ext x
      simp only [RingHom.mem_ker, Ideal.mem_bot]
      constructor
      · intro hx
        have hmem : x ∈ Ideal.comap ι (Ideal.map ι (⊥ : Ideal L)) := by
          simp [hx]
        rw [Ideal.comap_map_eq_self_of_faithfullyFlat (⊥ : Ideal L)] at hmem
        exact Ideal.mem_bot.mp hmem
      · rintro rfl
        exact map_zero ι
    rw [isIntegrallyClosed_iff (FractionRing L)]
    intro ξ hξ
    obtain ⟨c, d, hd_nzd, hξ_eq⟩ := IsFractionRing.div_surjective (A := L) ξ
    have hd_ne : (d : L) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hd_nzd
    have h_map_units : ∀ s : nonZeroDivisors L,
        IsUnit (((algebraMap L_hat (FractionRing L_hat)).comp ι) s) := by
      intro s
      have hs_ne : (s : L) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hιs_ne : ι s ≠ 0 := fun h => hs_ne (hι_inj (h.trans (map_zero ι).symm))
      have hfrac_ne : algebraMap L_hat (FractionRing L_hat) (ι s) ≠ 0 :=
        fun h => hιs_ne (IsFractionRing.injective L_hat (FractionRing L_hat)
          (h.trans (map_zero _).symm))
      exact IsUnit.mk0 _ hfrac_ne
    let j : FractionRing L →+* FractionRing L_hat :=
      IsLocalization.lift (M := nonZeroDivisors L) h_map_units
    have hj_eq : ∀ a : L, j (algebraMap L (FractionRing L) a) =
        algebraMap L_hat (FractionRing L_hat) (ι a) := fun a =>
      IsLocalization.lift_eq (M := nonZeroDivisors L) h_map_units a
    obtain ⟨P_poly, hP_monic, hP_eval⟩ := hξ
    have hjξ_int : IsIntegral L_hat (j ξ) := by
      refine ⟨P_poly.map ι, hP_monic.map ι, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomm : (algebraMap L_hat (FractionRing L_hat)).comp ι =
          j.comp (algebraMap L (FractionRing L)) := by
        ext a
        exact (hj_eq a).symm
      rw [hcomm, ← Polynomial.hom_eval₂, hP_eval, map_zero]
    obtain ⟨y_hat, hy_hat⟩ := (isIntegrallyClosed_iff (FractionRing L_hat)).mp inferInstance hjξ_int
    have hd_frac_ne : algebraMap L (FractionRing L) d ≠ 0 :=
      fun h => hd_ne (IsFractionRing.injective L (FractionRing L) (h.trans (map_zero _).symm))
    have hdξ : algebraMap L (FractionRing L) d * ξ = algebraMap L (FractionRing L) c := by
      rw [← hξ_eq, mul_div_cancel₀ _ hd_frac_ne]
    have hιc_eq : ι c = ι d * y_hat := by
      apply IsFractionRing.injective L_hat (FractionRing L_hat)
      calc algebraMap L_hat (FractionRing L_hat) (ι c)
          = j (algebraMap L (FractionRing L) c) := (hj_eq c).symm
        _ = j (algebraMap L (FractionRing L) d * ξ) := by rw [hdξ]
        _ = j (algebraMap L (FractionRing L) d) * j ξ := map_mul j _ _
        _ = algebraMap L_hat (FractionRing L_hat) (ι d) *
              algebraMap L_hat (FractionRing L_hat) y_hat := by rw [hj_eq d, hy_hat]
        _ = algebraMap L_hat (FractionRing L_hat) (ι d * y_hat) := (map_mul _ _ _).symm
    have hc_mem_map : ι c ∈ Ideal.map ι (Ideal.span ({d} : Set L)) := by
      rw [hιc_eq, Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton]
      exact ⟨y_hat, rfl⟩
    have hc_mem : c ∈ Ideal.span ({d} : Set L) := by
      have h1 : c ∈ Ideal.comap ι (Ideal.map ι (Ideal.span ({d} : Set L))) := hc_mem_map
      rwa [Ideal.comap_map_eq_self_of_faithfullyFlat (Ideal.span ({d} : Set L))] at h1
    rw [Ideal.mem_span_singleton] at hc_mem
    obtain ⟨y, rfl⟩ := hc_mem
    refine ⟨y, ?_⟩
    apply mul_left_cancel₀ hd_frac_ne
    rw [hdξ, map_mul]
  have h_s4 : ∀ (P : Ideal ↑(W.presheaf.obj (Opposite.op U))) [P.IsMaximal],
