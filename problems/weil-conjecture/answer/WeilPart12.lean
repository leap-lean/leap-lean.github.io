      rw [hι_π_eq ℓ, hψ_sec_t ℓ b, hr_val ℓ b]
    have hInter_P : ∀ ℓ ℓ' : Fin (d + 1), P_A.basicOpen (t_A ℓ ℓ') = D ℓ ⊓ D ℓ' := by
      intro ℓ ℓ'
