          apply (TensorProduct.rid R₀ (Localization.AtPrime 𝔪)).injective
          simp [q_loc]
        obtain ⟨⟨a, s⟩, hq_mk⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl q_loc
        rw [hz_eq, ← hq_mk, LinearMap.lTensor_tmul] at hz
        let S_𝔪 : Submonoid A₀ := Algebra.algebraMapSubmonoid A₀ 𝔪.primeCompl
        let L_A := Localization S_𝔪
        let u_sub : 𝔪.primeCompl → S_𝔪 := fun y =>
          ⟨u₀ y.1, Algebra.mem_algebraMapSubmonoid_of_mem y⟩
        have hUnits_S𝔪 : ∀ y : 𝔪.primeCompl,
            IsUnit (((algebraMap A₀ L_A).comp u₀) y.1) := by
          intro y
          exact IsLocalization.map_units (M := S_𝔪) L_A (u_sub y)
        let α_LA : Localization.AtPrime 𝔪 →ₐ[R₀] L_A :=
          { IsLocalization.lift hUnits_S𝔪 with
            commutes' := fun r => IsLocalization.lift_eq hUnits_S𝔪 r }
        let β_LA : A₀ →ₐ[R₀] L_A :=
          { algebraMap A₀ L_A with commutes' := fun _ => rfl }
        let ev_LA : TensorProduct R₀ (Localization.AtPrime 𝔪) A₀ →ₐ[R₀] L_A :=
          Algebra.TensorProduct.lift α_LA β_LA (fun _ _ => mul_comm _ _)
        have h_ev := congrArg ev_LA hz
        change α_LA (IsLocalization.mk' (Localization.AtPrime 𝔪) a s) * β_LA (u₀ 1) =
          α_LA 1 * β_LA t at h_ev
        rw [map_one, map_one, map_one, mul_one, one_mul] at h_ev
        have h_α_mk : α_LA (IsLocalization.mk' (Localization.AtPrime 𝔪) a s) =
            IsLocalization.mk' L_A (u₀ a) (u_sub s) := by
          dsimp only [α_LA]
          change IsLocalization.lift hUnits_S𝔪 (IsLocalization.mk' _ a s) = _
          rw [IsLocalization.lift_mk'_spec]
          exact (IsLocalization.mk'_spec' L_A (u₀ a) (u_sub s)).symm
        rw [h_α_mk] at h_ev
        have h_cross : algebraMap A₀ L_A (u₀ a) = algebraMap A₀ L_A (u₀ s.1 * t) := by
          calc algebraMap A₀ L_A (u₀ a)
              = IsLocalization.mk' L_A (u₀ a) (u_sub s) *
                  algebraMap A₀ L_A (u₀ s.1) :=
                    (IsLocalization.mk'_spec L_A (u₀ a) (u_sub s)).symm
            _ = β_LA t * algebraMap A₀ L_A (u₀ s.1) := by rw [h_ev]
            _ = algebraMap A₀ L_A (u₀ s.1 * t) := by
                  change algebraMap A₀ L_A t * algebraMap A₀ L_A (u₀ s.1) = _
                  rw [← map_mul, mul_comm]
        rw [IsLocalization.eq_iff_exists S_𝔪] at h_cross
        obtain ⟨⟨_, b', hb'_not_𝔪, rfl⟩, h_eq_A₀⟩ := h_cross
        have hb's_mem : b' * s.1 ∈ I_cond := by
          refine ⟨b' * a, ?_⟩
          calc u₀ (b' * s.1) * t
              = u₀ b' * (u₀ s.1 * t) := by rw [map_mul, mul_assoc]
            _ = u₀ b' * u₀ a := h_eq_A₀.symm
            _ = u₀ (b' * a) := (map_mul u₀ b' a).symm
        exact (Submonoid.mul_mem 𝔪.primeCompl hb'_not_𝔪 s.2) (hI_le hb's_mem)
      have h1 : (1 : R₀) ∈ I_cond := by rw [hI_top]; trivial
      obtain ⟨a, ha⟩ := h1
      refine ⟨a, ?_⟩
      change u₀ a = t
      rw [← ha, map_one, one_mul]
  let R₀ : Type u := ↑R₁
  let A₀ : Type u := ↑(X₁.presheaf.obj (Opposite.op ⊤))
  let u₁ : R₀ →+* A₀ := ((AlgebraicGeometry.Scheme.ΓSpecIso R₁).inv ≫ π₁.appTop).hom
  letI : Algebra R₀ A₀ := u₁.toAlgebra
  let u₁_lin : R₀ →ₗ[R₀] A₀ := Algebra.linearMap R₀ A₀
  have hIso_snd₂ : CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd π₂ e₂).app ⊤) := by
    let u₂ : ↑R₂ →+* ↑(X₂.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv ≫ π₂.appTop).hom
    letI : Algebra ↑R₂ ↑A' := (AlgebraicGeometry.Spec.preimage e₂).hom.toAlgebra
    letI : Algebra ↑R₂ ↑(X₂.presheaf.obj (Opposite.op ⊤)) := u₂.toAlgebra
    apply (hFlatBC R₂ A' X₂ π₂ hProp₂ N₂ V₂ hAff₂ hCov₂ e₂ hFlat₂).mp
    have : CategoryTheory.IsIso (π₂.appTop) := hIso₂_top
    have hBij_u₂ : Function.Bijective u₂ :=
      CategoryTheory.ConcreteCategory.bijective_of_isIso
        ((AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv ≫ π₂.appTop)
    let e_u₂ : ↑R₂ ≃ₗ[↑R₂] ↑(X₂.presheaf.obj (Opposite.op ⊤)) :=
      LinearEquiv.ofBijective (Algebra.linearMap ↑R₂ _) hBij_u₂
    exact (LinearEquiv.lTensor ↑A' e_u₂).bijective
  have hIso_snd₁ : CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd π₁ e₁).app ⊤) := by
    have htop := congrArg AlgebraicGeometry.Scheme.Hom.appTop hΦ_snd.symm
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop] at htop
    have hIso_s₂ : CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd π₂ e₂).appTop) :=
      hIso_snd₂
    have hIso_Φ : CategoryTheory.IsIso Φ.hom.appTop :=
      ⟨Φ.inv.appTop,
        by rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Φ.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop],
        by rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Φ.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]⟩
    change CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd π₁ e₁).appTop)
    rw [htop]
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_s₂ hIso_Φ
  let α₁ : R₀ →+* ↑A' := (AlgebraicGeometry.Spec.preimage e₁).hom
  letI instAlgA' : Algebra R₀ ↑A' := α₁.toAlgebra
  have hBij_A' : Function.Bijective (LinearMap.lTensor ↑A' u₁_lin) :=
    (hFlatBC R₁ A' X₁ π₁ hProp₁ N₁ V₁ hAff₁ hCov₁ e₁ hFlat₁).mpr hIso_snd₁
  have hFlatBC_alg : ∀ (B₀ : Type u) [CommRing B₀] [Algebra R₀ B₀] [Module.Flat R₀ B₀],
      Function.Bijective (LinearMap.lTensor B₀ u₁_lin) ↔
        CategoryTheory.IsIso
          ((CategoryTheory.Limits.pullback.snd π₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)))).app ⊤) := by
    intro B₀ _ instAlgB₀ _
    let loc : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ AlgebraicGeometry.Spec R₁ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀))
    have hRingFlat : RingHom.Flat (algebraMap R₀ B₀) := by
      have h_mod : (algebraMap R₀ B₀).toModule = (inferInstance : Module R₀ B₀) :=
        Module.ext' _ _ fun r x => (Algebra.smul_def r x).symm
      change @Module.Flat R₀ B₀ _ _ (algebraMap R₀ B₀).toModule
      rw [h_mod]
      infer_instance
    have hFlat_loc : AlgebraicGeometry.Flat loc :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr hRingFlat
    have hBC := hFlatBC R₁ (CommRingCat.of B₀) X₁ π₁ hProp₁ N₁ V₁ hAff₁ hCov₁ loc hFlat_loc
    have hAlg : (AlgebraicGeometry.Spec.preimage loc).hom.toAlgebra = instAlgB₀ := by
      apply Algebra.algebra_ext
      intro r
      change (AlgebraicGeometry.Spec.preimage loc).hom r = algebraMap R₀ B₀ r
      dsimp only [loc]
      rw [AlgebraicGeometry.Spec.preimage_map]
      rfl
    rwa [hAlg] at hBC
  have hAway_iff : ∀ f : R₀,
      Function.Bijective (LinearMap.lTensor (Localization.Away f) u₁_lin) ↔
        CategoryTheory.IsIso (π₁.app (PrimeSpectrum.basicOpen f)) := by
    intro f
    let B_f := CommRingCat.of (Localization.Away f)
    let loc_f : AlgebraicGeometry.Spec B_f ⟶ AlgebraicGeometry.Spec R₁ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (Localization.Away f)))
    rw [hFlatBC_alg (Localization.Away f)]
    let U_f : (AlgebraicGeometry.Spec R₁).Opens := PrimeSpectrum.basicOpen f
    have : AlgebraicGeometry.IsOpenImmersion loc_f :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization f
    have hRange_loc : Set.range loc_f.base = Set.range U_f.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact PrimeSpectrum.localization_away_comap_range (Localization.Away f) f
    let fst_f := CategoryTheory.Limits.pullback.fst π₁ loc_f
    let snd_f := CategoryTheory.Limits.pullback.snd π₁ loc_f
    have : AlgebraicGeometry.IsOpenImmersion fst_f := inferInstance
    have hRange_fstf : Set.range fst_f.base = ((π₁ ⁻¹ᵁ U_f : X₁.Opens) : Set X₁) := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_fst, hRange_loc,
        AlgebraicGeometry.Scheme.Opens.range_ι]
      rfl
    have hIso_fstf_app : CategoryTheory.IsIso (fst_f.app (π₁ ⁻¹ᵁ U_f)) :=
      hOpenAppIso fst_f (π₁ ⁻¹ᵁ U_f) (le_of_eq hRange_fstf.symm)
    have hIso_locf_app : CategoryTheory.IsIso (loc_f.app U_f) := by
      apply hOpenAppIso loc_f U_f
      rw [hRange_loc, AlgebraicGeometry.Scheme.Opens.range_ι]
    have hloc_top : loc_f ⁻¹ᵁ U_f = ⊤ := by
      apply le_antisymm le_top
      intro w _
      have hw : loc_f.base w ∈ Set.range loc_f.base := ⟨w, rfl⟩
      rw [hRange_loc, AlgebraicGeometry.Scheme.Opens.range_ι] at hw
      exact hw
    have hcond_Uf := AlgebraicGeometry.Scheme.Hom.congr_app
      (CategoryTheory.Limits.pullback.condition (f := π₁) (g := loc_f)) U_f
    have hcond_Uf_symm := AlgebraicGeometry.Scheme.Hom.congr_app
      (CategoryTheory.Limits.pullback.condition (f := π₁) (g := loc_f)).symm U_f
    have hIso_snd_loc_iff :
        CategoryTheory.IsIso (snd_f.app ⊤) ↔ CategoryTheory.IsIso (snd_f.app (loc_f ⁻¹ᵁ U_f)) := by
      rw [hloc_top]
    rw [hIso_snd_loc_iff]
    constructor
    · intro hIso_s
      have hIso_sl : CategoryTheory.IsIso ((snd_f ≫ loc_f).app U_f) := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_app]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _
          (loc_f.app U_f) (snd_f.app (loc_f ⁻¹ᵁ U_f)) hIso_locf_app hIso_s
      rw [hcond_Uf_symm] at hIso_sl
      have hIso_fp : CategoryTheory.IsIso ((fst_f ≫ π₁).app U_f) :=
        @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ _ _ inferInstance hIso_sl
      have hIso_comp : CategoryTheory.IsIso (π₁.app U_f ≫ fst_f.app (π₁ ⁻¹ᵁ U_f)) := by
        rwa [← AlgebraicGeometry.Scheme.Hom.comp_app]
      exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ _ _ hIso_fstf_app hIso_comp
    · intro hIso_p
      have hIso_fp : CategoryTheory.IsIso ((fst_f ≫ π₁).app U_f) := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_app]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _
          (π₁.app U_f) (fst_f.app (π₁ ⁻¹ᵁ U_f)) hIso_p hIso_fstf_app
      rw [hcond_Uf] at hIso_fp
      have hIso_sl : CategoryTheory.IsIso ((snd_f ≫ loc_f).app U_f) :=
        @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ _ _ inferInstance hIso_fp
      have hIso_comp : CategoryTheory.IsIso (loc_f.app U_f ≫ snd_f.app (loc_f ⁻¹ᵁ U_f)) := by
        rwa [← AlgebraicGeometry.Scheme.Hom.comp_app]
      exact @CategoryTheory.IsIso.of_isIso_comp_left _ _ _ _ _ _ _ hIso_locf_app hIso_comp
  have hBij_mem_m₁ : ∀ f ∈ m₁,
      Function.Bijective (LinearMap.lTensor (Localization.Away f) u₁_lin) := by
    intro f hf
    rw [hAway_iff f]
    let U_f : (AlgebraicGeometry.Spec R₁).Opens := PrimeSpectrum.basicOpen f
    let U_compl_m₁ : (AlgebraicGeometry.Spec R₁).Opens :=
      ⟨(PrimeSpectrum.zeroLocus (m₁ : Set R₀))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (m₁ : Set R₀)).isOpen_compl⟩
    have : CategoryTheory.IsIso (π₁ ∣_ U_compl_m₁) := hIso₁_compl
    have h_le : U_f ≤ U_compl_m₁ := by
      intro q hq h_zl
      have hf_not_q : f ∉ q.asIdeal := hq
      exact hf_not_q (h_zl hf)
    have h_congr := AlgebraicGeometry.Scheme.Hom.congr_app
      (AlgebraicGeometry.morphismRestrict_ι π₁ U_compl_m₁) U_f
    have hIso_Uι : CategoryTheory.IsIso (U_compl_m₁.ι.app U_f) := by
      apply hOpenAppIso U_compl_m₁.ι
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact h_le
    have hIso_sub : CategoryTheory.IsIso
        ((π₁ ⁻¹ᵁ U_compl_m₁).ι.app (π₁ ⁻¹ᵁ U_f)) := by
      apply hOpenAppIso (π₁ ⁻¹ᵁ U_compl_m₁).ι
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      intro z hz
      exact h_le hz
    have hIso_lhs : CategoryTheory.IsIso
        (((π₁ ∣_ U_compl_m₁) ≫ U_compl_m₁.ι).app U_f) := by
      have : AlgebraicGeometry.IsOpenImmersion ((π₁ ∣_ U_compl_m₁) ≫ U_compl_m₁.ι) :=
        inferInstance
      apply hOpenAppIso ((π₁ ∣_ U_compl_m₁) ≫ U_compl_m₁.ι) U_f
      intro q hq
      refine ⟨(CategoryTheory.inv (π₁ ∣_ U_compl_m₁)).base ⟨q, h_le hq⟩, ?_⟩
      have h_id := CategoryTheory.IsIso.inv_hom_id (π₁ ∣_ U_compl_m₁)
      change ((CategoryTheory.inv (π₁ ∣_ U_compl_m₁) ≫ (π₁ ∣_ U_compl_m₁)) ≫ U_compl_m₁.ι).base
        ⟨q, h_le hq⟩ = q
      rw [h_id, CategoryTheory.Category.id_comp]
      rfl
    rw [h_congr] at hIso_lhs
    have hIso_rhs : CategoryTheory.IsIso
        (((π₁ ⁻¹ᵁ U_compl_m₁).ι ≫ π₁).app U_f) :=
      @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ _ _ inferInstance hIso_lhs
    have hIso_comp : CategoryTheory.IsIso
        (π₁.app U_f ≫ (π₁ ⁻¹ᵁ U_compl_m₁).ι.app (π₁ ⁻¹ᵁ U_f)) := by
      rwa [← AlgebraicGeometry.Scheme.Hom.comp_app]
    exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ _ _ hIso_sub hIso_comp
  have he₁_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁) = e₁ := by
    change AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage e₁).hom) = e₁
    rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
  have hFlat_α₁ : RingHom.Flat α₁ := by
    have : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁)) := by
      rwa [he₁_spec]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp this
  have : Module.Flat R₀ ↑A' := hFlat_α₁
  have : v'₀.asIdeal.IsPrime := v'₀.isPrime
  have hComap_v'₀ : Ideal.comap (algebraMap R₀ ↑A') v'₀.asIdeal = m₁ := by
    have hv : (e₁.base v'₀).asIdeal = Ideal.comap α₁ v'₀.asIdeal := by
      rw [← he₁_spec]; rfl
    exact hv.symm.trans hev'₀
  have hBij_u₁ : Function.Bijective u₁_lin :=
    hAlgDescent R₀ A₀ ↑A' m₁ v'₀.asIdeal hComap_v'₀ hBij_A' hBij_mem_m₁
  let D_open : R₀ → (AlgebraicGeometry.Spec R₁).Opens := PrimeSpectrum.basicOpen
  have hIso_basic : ∀ f : R₀, CategoryTheory.IsIso (π₁.app (D_open f)) := by
    intro f
    change CategoryTheory.IsIso (π₁.app (PrimeSpectrum.basicOpen f))
    rw [← hAway_iff f]
    let e_u₁ : R₀ ≃ₗ[R₀] A₀ := LinearEquiv.ofBijective u₁_lin hBij_u₁
    exact (LinearEquiv.lTensor (Localization.Away f) e_u₁).bijective
  intro V
  let S_V := {f : R₀ // D_open f ≤ V}
  let U_V : S_V → (AlgebraicGeometry.Spec R₁).Opens := fun f => D_open f.1
  have hSup_V : (⨆ f : S_V, U_V f) = V := by
    apply le_antisymm
    · exact iSup_le fun f => f.2
    · intro q hq
      rw [TopologicalSpace.Opens.mem_iSup]
      obtain ⟨B_set, ⟨f, rfl⟩, hq_in, hB_sub⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hq V.2
      exact ⟨⟨f, hB_sub⟩, hq_in⟩
  apply hSheafGlue π₁ U_V V hSup_V
  · intro f
    exact hIso_basic f.1
  · intro f g
    have h_mul : U_V f ⊓ U_V g = D_open (f.1 * g.1) :=
      (PrimeSpectrum.basicOpen_mul f.1 g.1).symm
    rw [h_mul]
    exact hIso_basic (f.1 * g.1)

theorem weil_powerSeries_blowup_etale_baseChange_and_gluing (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C' U_tilde M_m : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of (PowerSeries Ω)))
    (hInt' : AlgebraicGeometry.IsIntegral C')
    (hFlat' : AlgebraicGeometry.Flat g')
    (hProp' : AlgebraicGeometry.IsProper g')
    (hLFP' : AlgebraicGeometry.LocallyOfFinitePresentation g')
    (x₀ : C') (hx₀_cl : IsClosed ({x₀} : Set C'))
    (U : C'.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
    (p_x₀ : PrimeSpectrum ↑(C'.presheaf.obj (Opposite.op U)))
    [p_x₀.asIdeal.IsMaximal]
    (hp_x₀ : hAffU.fromSpec.base p_x₀ = x₀)
    (hDom_A : IsDomain ↑(C'.presheaf.obj (Opposite.op U)))
    (hX_mem : (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom PowerSeries.X ∈
      p_x₀.asIdeal)
    (hX_ne : (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom PowerSeries.X ≠ 0)
    (hRes_A : ∀ a : ↑(C'.presheaf.obj (Opposite.op U)), ∃ c : Ω,
      a - (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom (PowerSeries.C c) ∈
        p_x₀.asIdeal)
    (π_U : U_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))))
    (hBlU : IsAffinePowerSeriesPointBlowup Ω
      (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom p_x₀.asIdeal π_U)
    (m : ℕ)
    (hMax_Inod :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      (Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}).IsMaximal)
    (hRes_Pm :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      let I_nod := Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}
      ∀ f : MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ J_m, ∃ c : Ω,
        f - Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.C c)) ∈ I_nod)
    (p_m : M_m ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))))
    (hLoc : IsLocalPowerSeriesNodeBlowupModel Ω m p_m)
    (A' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec A')
    [v'₀.asIdeal.IsMaximal]
    (e_U : AlgebraicGeometry.Spec A' ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↑(C'.presheaf.obj (Opposite.op U))))
    (q_m : AlgebraicGeometry.Spec A' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) (PowerSeries Ω) ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω))))))
    (hEt_e : AlgebraicGeometry.Etale e_U)
    (hEt_q : AlgebraicGeometry.Etale q_m)
    (hComm_eq :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      e_U ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom) =
        q_m ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk J_m).comp MvPolynomial.C)))
    (hev'₀ : e_U.base v'₀ = p_x₀)
    (hqv'₀ :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      (q_m.base v'₀).asIdeal = Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))})
    (hMap_e : Ideal.map (AlgebraicGeometry.Spec.preimage e_U).hom p_x₀.asIdeal = v'₀.asIdeal)
    (hMap_q :
      let J_m : Ideal (MvPolynomial (Fin 2) (PowerSeries Ω)) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C ((PowerSeries.X : PowerSeries Ω) ^ m)} :
          Set (MvPolynomial (Fin 2) (PowerSeries Ω)))
      Ideal.map (AlgebraicGeometry.Spec.preimage q_m).hom (Ideal.span
        {Ideal.Quotient.mk J_m (MvPolynomial.X 0),
         Ideal.Quotient.mk J_m (MvPolynomial.X 1),
         Ideal.Quotient.mk J_m (MvPolynomial.C (PowerSeries.X : PowerSeries Ω))}) = v'₀.asIdeal)
    (hRes_A' : ∀ b : ↑A', ∃ c : Ω,
      b - (AlgebraicGeometry.Spec.preimage e_U).hom
        ((AlgebraicGeometry.Spec.preimage (hAffU.fromSpec ≫ g')).hom (PowerSeries.C c)) ∈
        v'₀.asIdeal) :
    let U_compl : C'.Opens := ⟨({x₀} : Set C')ᶜ, hx₀_cl.isOpen_compl⟩
    ∃ (C'' : AlgebraicGeometry.Scheme.{u})
      (π : C'' ⟶ C')
      (ι_tilde : U_tilde ⟶ C'')
      (ι_compl : U_compl.toScheme ⟶ C'')
      (Φ_A' : CategoryTheory.Limits.pullback π_U e_U ≅
        CategoryTheory.Limits.pullback p_m q_m),
      AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
      AlgebraicGeometry.IsOpenImmersion ι_compl ∧
      (∀ z : C'', z ∈ Set.range ι_tilde.base ∨ z ∈ Set.range ι_compl.base) ∧
      ι_tilde ≫ π = π_U ≫ hAffU.fromSpec ∧
      ι_compl ≫ π = U_compl.ι ∧
