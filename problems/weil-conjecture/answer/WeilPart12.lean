  have hMapComapLoc : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
      (M : Submonoid R) [IsLocalization M S] (J : Ideal S),
      Ideal.map (algebraMap R S) (Ideal.comap (algebraMap R S) J) = J := by
    intro R S _ _ _ M _ J
    apply le_antisymm Ideal.map_comap_le
    intro z hz
    obtain ⟨⟨x, s⟩, hzs⟩ := IsLocalization.surj M z
    have hx_mem : x ∈ Ideal.comap (algebraMap R S) J := by
      change algebraMap R S x ∈ J
      rw [← hzs]
      exact Ideal.mul_mem_right _ J hz
    obtain ⟨u, hu⟩ := (IsLocalization.map_units S s).exists_right_inv
    have hz_eq : z = algebraMap R S x * u := by
      calc z = z * (algebraMap R S s * u) := by rw [hu, mul_one]
        _ = (z * algebraMap R S s) * u := by ring
        _ = algebraMap R S x * u := by rw [hzs]
    rw [hz_eq]
    exact Ideal.mul_mem_right u _ (Ideal.mem_map_of_mem (algebraMap R S) hx_mem)
  have hPrinCrux : ∀ {A R_E B₀ : Type u} [CommRing A] [CommRing R_E] [CommRing B₀]
      (m_A : Ideal A) [m_A.IsMaximal]
      (θ₀ : A →+* R_E) (_ : Function.Surjective θ₀)
      (q_E : Ideal R_E) [q_E.IsPrime]
      (_ : Ideal.comap θ₀ q_E = m_A)
      (f_EU : R_E) (_ : f_EU ∉ q_E)
      (ρ_E : R_E →+* B₀) (_ : @IsLocalization.Away R_E _ f_EU B₀ _ ρ_E.toAlgebra)
      (g_P : Polynomial Ω) (ψ_P : Polynomial Ω →+* B₀)
      (_ : @IsLocalization.Away (Polynomial Ω) _ g_P B₀ _ ψ_P.toAlgebra),
      ∃ t_B : B₀, t_B ∈ nonZeroDivisors B₀ ∧
        Ideal.map (ρ_E.comp θ₀) m_A = Ideal.span {t_B} := by
    intro A R_E B₀ _ _ _ m_A _ θ₀ hθ₀_surj q_E _ hq_comap f_EU hf_not_mem ρ_E hLocE g_P ψ_P hLocP
    have hMap_θ₀ : Ideal.map θ₀ m_A = q_E := by
      rw [← hq_comap]
      exact Ideal.map_comap_of_surjective θ₀ hθ₀_surj q_E
    have hq_max : q_E.IsMaximal := by
      refine ⟨‹q_E.IsPrime›.ne_top, ?_⟩
      intro J hJ_gt
      by_contra hJ_ne_top
      have hm_le : m_A ≤ Ideal.comap θ₀ J := by
        rw [← hq_comap]
        exact Ideal.comap_mono (le_of_lt hJ_gt)
      have hcomap_ne_top : Ideal.comap θ₀ J ≠ ⊤ := by
        intro htop
        apply hJ_ne_top
        rw [Ideal.eq_top_iff_one] at htop ⊢
        simpa using htop
      have hcomap_eq : Ideal.comap θ₀ J = m_A :=
        ‹m_A.IsMaximal›.eq_of_le hcomap_ne_top hm_le |>.symm
      obtain ⟨y, hyJ, hy_not_q⟩ := SetLike.exists_of_lt hJ_gt
      obtain ⟨a, rfl⟩ := hθ₀_surj y
      have ha_m : a ∈ m_A := by
        rw [← hcomap_eq]
        exact hyJ
      rw [← hq_comap] at ha_m
      exact hy_not_q ha_m
