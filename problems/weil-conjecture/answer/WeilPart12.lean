      apply h𝔭_ne_bot
      have h𝔪B_bot : 𝔪_B = ⊥ := by
        dsimp [𝔪_B]
        rw [h𝔪_bot, Ideal.map_bot]
      ext q
      simp only [𝔭, Ideal.mem_comap, h𝔪B_bot, Ideal.mem_bot]
      exact ⟨fun hq => hψ_inj (hq.trans (map_zero ψ_P).symm), fun hq => hq ▸ map_zero ψ_P⟩

    
    have h𝔭_max : 𝔭.IsMaximal := h𝔭_prime.isMaximal h𝔭_ne_bot
    obtain ⟨h, hh_span⟩ := Submodule.IsPrincipal.principal 𝔭
    have h𝔭_span : 𝔭 = Ideal.span {h} := by
      simpa [Ideal.submodule_span_eq] using hh_span
    have hh_ne : h ≠ 0 := by
      intro hh0
      apply h𝔭_ne_bot
      rw [h𝔭_span, hh0, Ideal.span_singleton_eq_bot]
    have hh_deg : h.degree ≠ 0 := by
      intro hdeg0
      have hC := Polynomial.eq_C_of_degree_eq_zero hdeg0
      have hc0_ne : h.coeff 0 ≠ 0 := by
        intro hc0
        rw [hC, hc0, map_zero] at hh_ne
        exact hh_ne rfl
      have hUnit : IsUnit h := by
        rw [hC]
        exact Polynomial.isUnit_C.mpr (IsUnit.mk0 _ hc0_ne)
      exact h𝔭_prime.ne_top (h𝔭_span.trans (Ideal.span_singleton_eq_top.mpr hUnit))
    obtain ⟨c₀, hc₀_root⟩ := IsAlgClosed.exists_root h hh_deg
    have h𝔭_eq_ker : 𝔭 = RingHom.ker (Polynomial.evalRingHom c₀) := by
      apply h𝔭_max.eq_of_le (RingHom.ker_isPrime (Polynomial.evalRingHom c₀)).ne_top
      rw [h𝔭_span, Ideal.span_le]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact hc₀_root
    have hgc₀_ne : (Polynomial.evalRingHom c₀) g ≠ 0 := by
      intro hroot
      apply hg_not_𝔭
      rw [h𝔭_eq_ker, RingHom.mem_ker]
      exact hroot
    let ev₀ : B →+* Ω := IsLocalization.Away.lift g (IsUnit.mk0 _ hgc₀_ne)
    have h𝔪B_eq_ker : 𝔪_B = RingHom.ker ev₀ := by
      apply hMaxB.eq_of_le (RingHom.ker_isPrime ev₀).ne_top
      rw [← hMap_𝔭, Ideal.map_le_iff_le_comap]
      intro q hq
      rw [Ideal.mem_comap, RingHom.mem_ker]
      change ev₀ (algebraMap (Polynomial Ω) B q) = 0
      rw [IsLocalization.Away.lift_eq]
      rw [h𝔭_eq_ker, RingHom.mem_ker] at hq
      exact hq
    have hRes : ∀ s : S, ∃ c : Ω, s - α_Ω c ∈ 𝔪 := by
      intro s
      refine ⟨ev₀ (ρ_S s), ?_⟩
      rw [← hComapB, Ideal.mem_comap, h𝔪B_eq_ker, RingHom.mem_ker, map_sub, map_sub]
      have hαc : ρ_S (α_Ω (ev₀ (ρ_S s))) = ψ_P (Polynomial.C (ev₀ (ρ_S s))) :=
        (RingHom.congr_fun hCompat (ev₀ (ρ_S s))).symm
      rw [hαc]
      change ev₀ (ρ_S s) - ev₀ (algebraMap (Polynomial Ω) B (Polynomial.C (ev₀ (ρ_S s)))) = 0
      rw [IsLocalization.Away.lift_eq]
      simp

    
    have hPIR_B : IsPrincipalIdealRing (Localization.AtPrime 𝔪_B) := by
      have _ : IsLocalization.AtPrime (Localization.AtPrime 𝔪_B) 𝔭 :=
        IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
          (Submonoid.powers g) (Localization.AtPrime 𝔪_B) 𝔪_B
      refine ⟨fun J => ?_⟩
      obtain ⟨r, hr⟩ := Submodule.IsPrincipal.principal (Ideal.under (Polynomial Ω) J)
      have hUnder : Ideal.under (Polynomial Ω) J = Ideal.span {r} := by
        simpa [Ideal.submodule_span_eq] using hr
      have hMapJ : Ideal.map (algebraMap (Polynomial Ω) (Localization.AtPrime 𝔪_B))
          (Ideal.under (Polynomial Ω) J) = J :=
        IsLocalization.map_under 𝔭.primeCompl (Localization.AtPrime 𝔪_B) J
      rw [hUnder, Ideal.map_span, Set.image_singleton] at hMapJ
      exact ⟨algebraMap (Polynomial Ω) (Localization.AtPrime 𝔪_B) r, by
        simpa [Ideal.submodule_span_eq] using hMapJ.symm⟩
    exact ⟨h𝔪_ne_bot, hRes, hPIR_transfer hPIR_B⟩

theorem weil_algClosed_smooth_or_nodal_birational_finite_local_algebra (Ω R₀ S_E : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing R₀] [CommRing S_E] [IsDomain S_E]
    (α_R : Ω →+* R₀)
    (φ₀ : R₀ →+* S_E)
    (hFin : φ₀.Finite)
    (r₀ : R₀)
    (hr₀_ne : φ₀ r₀ ≠ 0)
    (hBirat : ∀ s : S_E, ∃ (k : ℕ) (a : R₀), φ₀ (r₀ ^ k) * s = φ₀ a)
    (p_y : Ideal R₀) [p_y.IsMaximal]
    (hS_pir : ∀ (𝔪 : Ideal S_E) [𝔪.IsMaximal],
      Ideal.comap φ₀ 𝔪 = p_y →
      𝔪 ≠ ⊥ ∧ (∀ s : S_E, ∃ c : Ω, s - φ₀ (α_R c) ∈ 𝔪) ∧
        IsPrincipalIdealRing (Localization.AtPrime 𝔪)) :
    ((∃ g_sm : MvPolynomial (Fin 1) Ω →+* R₀, g_sm.comp MvPolynomial.C = α_R ∧ g_sm.Etale) →
      (∀ (𝔪₁ 𝔪₂ : Ideal S_E),
        𝔪₁.IsPrime → 𝔪₂.IsPrime →
        Ideal.comap φ₀ 𝔪₁ = p_y → Ideal.comap φ₀ 𝔪₂ = p_y → 𝔪₁ = 𝔪₂) ∧
      ((∃ 𝔪 : Ideal S_E, 𝔪.IsPrime ∧ Ideal.comap φ₀ 𝔪 = p_y) →
        ∀ s : S_E, ∃ (a c : R₀), c ∉ p_y ∧ φ₀ c * s = φ₀ a)) ∧
    (∀ (D_Ω : Type u) [CommRing D_Ω]
        (ψ₁ : R₀ →+* D_Ω)
        (ψ₂ : (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* D_Ω)
        (w₀ : Ideal D_Ω) [w₀.IsPrime],
      ψ₁.Etale →
      ψ₂.Etale →
      Ideal.comap ψ₁ w₀ = p_y →
      (∀ i : Fin 2,
        ψ₂ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
          (MvPolynomial.X i)) ∈ w₀) →
      ψ₁.comp α_R =
        ψ₂.comp ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})).comp
          MvPolynomial.C) →
      ((∃ (𝔪₁ 𝔪₂ : Ideal S_E),
          𝔪₁.IsPrime ∧ 𝔪₂.IsPrime ∧ 𝔪₁ ≠ 𝔪₂ ∧
          Ideal.comap φ₀ 𝔪₁ = p_y ∧ Ideal.comap φ₀ 𝔪₂ = p_y) →
        ∀ (Q : Ideal D_Ω), Q ∈ minimalPrimes D_Ω → Q ≤ w₀ →
          Ideal.comap ψ₁ Q = RingHom.ker φ₀) ∧
      ((∀ (𝔪₁ 𝔪₂ : Ideal S_E),
          𝔪₁.IsPrime → 𝔪₂.IsPrime →
          Ideal.comap φ₀ 𝔪₁ = p_y → Ideal.comap φ₀ 𝔪₂ = p_y → 𝔪₁ = 𝔪₂) →
        (∃ 𝔪 : Ideal S_E, 𝔪.IsPrime ∧ Ideal.comap φ₀ 𝔪 = p_y) →
        ∀ s : S_E, ∃ (a c : R₀), c ∉ p_y ∧ φ₀ c * s = φ₀ a)) :=
by
  have birational_integral_bijective : ∀ (A B : Type u) [CommRing A] [IsDomain A]
      [IsIntegrallyClosed A] [CommRing B] [IsDomain B]
      (f : A →+* B), Function.Injective f → f.IsIntegral →
      (∀ b : B, ∃ d a : A, d ≠ 0 ∧ f d * b = f a) →
      Function.Bijective f := by
    intro A B _ _ _ _ _ f hf_inj hf_int hf_birat
    refine ⟨hf_inj, fun b => ?_⟩
    obtain ⟨d, a, hd_ne, hdb⟩ := hf_birat b
    have hinj_KA : Function.Injective (algebraMap A (FractionRing A)) :=
      IsFractionRing.injective A (FractionRing A)
    have hinj_KB : Function.Injective (algebraMap B (FractionRing B)) :=
      IsFractionRing.injective B (FractionRing B)
    let g : A →+* FractionRing B := (algebraMap B (FractionRing B)).comp f
    have hg_inj : Function.Injective g := hinj_KB.comp hf_inj
    have hg_units : ∀ y : nonZeroDivisors A, IsUnit (g y) := by
      intro y
      have hy_ne : (y : A) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hgy_ne : g y ≠ 0 := fun h => hy_ne (hg_inj (h.trans (map_zero g).symm))
      exact IsUnit.mk0 _ hgy_ne
    let ι_K : FractionRing A →+* FractionRing B :=
      IsLocalization.lift (M := nonZeroDivisors A) hg_units
    have hι_eq : ∀ x : A, ι_K (algebraMap A (FractionRing A) x) = g x :=
      IsLocalization.lift_eq hg_units
    have hd_KA_ne : algebraMap A (FractionRing A) d ≠ 0 :=
      fun h => hd_ne (hinj_KA (h.trans (map_zero _).symm))
    let w : FractionRing A := algebraMap A (FractionRing A) a / algebraMap A (FractionRing A) d
    have hw_mul : algebraMap A (FractionRing A) d * w = algebraMap A (FractionRing A) a :=
      mul_div_cancel₀ _ hd_KA_ne
    have hgd_ne : g d ≠ 0 := fun h => hd_ne (hg_inj (h.trans (map_zero g).symm))
    have hι_w : ι_K w = algebraMap B (FractionRing B) b := by
      apply mul_left_cancel₀ hgd_ne
      calc g d * ι_K w
          = ι_K (algebraMap A (FractionRing A) d) * ι_K w := by rw [hι_eq]
        _ = ι_K (algebraMap A (FractionRing A) d * w) := by rw [← map_mul]
        _ = ι_K (algebraMap A (FractionRing A) a) := by rw [hw_mul]
        _ = algebraMap B (FractionRing B) (f a) := hι_eq a
        _ = algebraMap B (FractionRing B) (f d * b) := by rw [hdb]
        _ = g d * algebraMap B (FractionRing B) b := by rw [map_mul]; rfl
    obtain ⟨P, hP_monic, hP_eval⟩ := hf_int b
    have hw_int : IsIntegral A w := by
      refine ⟨P, hP_monic, ?_⟩
      apply ι_K.injective
      rw [map_zero, Polynomial.hom_eval₂, hι_w]
      have hcomp : ι_K.comp (algebraMap A (FractionRing A)) = g :=
        RingHom.ext hι_eq
      rw [hcomp]
      change Polynomial.eval₂ ((algebraMap B (FractionRing B)).comp f)
        (algebraMap B (FractionRing B) b) P = 0
      rw [← Polynomial.hom_eval₂, hP_eval, map_zero]
    obtain ⟨r, hr⟩ := (IsIntegrallyClosed.isIntegral_iff (R := A) (K := FractionRing A)).mp hw_int
    refine ⟨r, hinj_KB ?_⟩
    calc algebraMap B (FractionRing B) (f r)
        = ι_K (algebraMap A (FractionRing A) r) := (hι_eq r).symm
      _ = ι_K w := by rw [hr]
      _ = algebraMap B (FractionRing B) b := hι_w
  have ringHom_etale_comp : ∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
      {f : R →+* S} {g : S →+* T}, f.Etale → g.Etale → (g.comp f).Etale := by
    intro R S T _ _ _ f g hf hg
    let _ : Algebra R S := f.toAlgebra
    let _ : Algebra S T := g.toAlgebra
    let _ : Algebra R T := (g.comp f).toAlgebra
    have : IsScalarTower R S T := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale R S := RingHom.etale_algebraMap.mp hf
    have : Algebra.Etale S T := RingHom.etale_algebraMap.mp hg
    have : Algebra.Etale R T := Algebra.Etale.comp R S T
    exact RingHom.etale_algebraMap.mpr ‹_›
  have ringHom_ext_tensor : ∀ {R A B C : Type u} [CommSemiring R] [CommSemiring A]
      [CommSemiring B] [CommSemiring C] [Algebra R A] [Algebra R B]
      {f g : TensorProduct R A B →+* C},
      (∀ a : A, f (a ⊗ₜ[R] 1) = g (a ⊗ₜ[R] 1)) →
      (∀ b : B, f (1 ⊗ₜ[R] b) = g (1 ⊗ₜ[R] b)) →
      f = g := by
    intro R A B C _ _ _ _ _ _ f g hA hB
    apply RingHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul a b =>
      have hmul : (a ⊗ₜ[R] b : TensorProduct R A B) = (a ⊗ₜ[R] 1) * (1 ⊗ₜ[R] b) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hmul, map_mul, map_mul, hA a, hB b]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hEtDvr : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B]
      (η : A →+* B), η.Etale →
      ∀ (𝔭 : Ideal A) [𝔭.IsPrime], 𝔭 ≠ ⊥ →
        IsPrincipalIdealRing (Localization.AtPrime 𝔭) →
        ∀ (Q : Ideal B) [Q.IsPrime], Ideal.comap η Q = 𝔭 →
          ∃ (_ : IsDomain (Localization.AtPrime Q)),
            IsDiscreteValuationRing (Localization.AtPrime Q) := by
    intro A B _ _ _ η hEt 𝔭 _ h𝔭_ne hA_pir Q _ hQ_over
    let _ : Algebra A B := η.toAlgebra
    have hAlgEt : Algebra.Etale A B := RingHom.etale_algebraMap.mp hEt
    let A_𝔭 := Localization.AtPrime 𝔭
    let B_Q := Localization.AtPrime Q
    let _ : IsPrincipalIdealRing A_𝔭 := hA_pir
    let ψ_loc : A_𝔭 →+* B_Q := Localization.localRingHom 𝔭 Q η hQ_over.symm
    let _ : Algebra A_𝔭 B_Q := ψ_loc.toAlgebra
    have : IsScalarTower A A_𝔭 B_Q :=
      IsScalarTower.of_algebraMap_eq fun a => by
        change algebraMap A B_Q a = ψ_loc (algebraMap A A_𝔭 a)
        rw [Localization.localRingHom_to_map]
        rfl
    have : IsLocalHom (algebraMap A_𝔭 B_Q) :=
      Localization.isLocalHom_localRingHom 𝔭 Q η hQ_over.symm
    have : Algebra.EssFiniteType A B := Algebra.EssFiniteType.of_finiteType A B
    have : Algebra.EssFiniteType A B_Q := Algebra.EssFiniteType.comp A B B_Q
    have : Algebra.EssFiniteType A_𝔭 B_Q := Algebra.EssFiniteType.of_comp A A_𝔭 B_Q
    have : IsNoetherianRing B_Q := Algebra.EssFiniteType.isNoetherianRing A_𝔭 B_Q
    have : Algebra.FormallyUnramified A B_Q := Algebra.FormallyUnramified.comp A B B_Q
    have : Algebra.FormallyUnramified A_𝔭 B_Q :=
      Algebra.FormallyUnramified.localization_base 𝔭.primeCompl
    obtain ⟨ϖ, hϖ_eq⟩ := Submodule.IsPrincipal.principal (IsLocalRing.maximalIdeal A_𝔭)
    have hϖ_ideal : IsLocalRing.maximalIdeal A_𝔭 = Ideal.span {ϖ} := by
      rwa [Ideal.submodule_span_eq] at hϖ_eq
    obtain ⟨⟨ϖ₀, s₀⟩, hϖ_surj⟩ := IsLocalization.surj 𝔭.primeCompl ϖ
    have hs₀_unit : IsUnit (algebraMap A A_𝔭 s₀.1) := IsLocalization.map_units A_𝔭 s₀
    have hMax_A : IsLocalRing.maximalIdeal A_𝔭 = Ideal.span {algebraMap A A_𝔭 ϖ₀} := by
      rw [hϖ_ideal]
      apply le_antisymm
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        obtain ⟨v₀, hv₀⟩ := hs₀_unit.exists_right_inv
        refine ⟨v₀, ?_⟩
        calc ϖ = ϖ * (algebraMap A A_𝔭 s₀.1 * v₀) := by rw [hv₀, mul_one]
          _ = (ϖ * algebraMap A A_𝔭 s₀.1) * v₀ := by ring
          _ = algebraMap A A_𝔭 ϖ₀ * v₀ := by rw [hϖ_surj]
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        exact ⟨algebraMap A A_𝔭 s₀.1, hϖ_surj.symm⟩
    have hϖ₀_ne : ϖ₀ ≠ 0 := by
      intro hzero
      obtain ⟨a₀, ha₀_mem, ha₀_ne⟩ := (Submodule.ne_bot_iff 𝔭).mp h𝔭_ne
      have hinj_A : Function.Injective (algebraMap A A_𝔭) :=
        IsLocalization.injective A_𝔭 (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
      have ha₀_max : algebraMap A A_𝔭 a₀ ∈ IsLocalRing.maximalIdeal A_𝔭 :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff A_𝔭 𝔭 a₀).mpr ha₀_mem
      rw [hMax_A, hzero, map_zero, Ideal.span_singleton_eq_bot.mpr rfl, Ideal.mem_bot] at ha₀_max
      exact ha₀_ne (hinj_A (ha₀_max.trans (map_zero _).symm))
    let t : B_Q := algebraMap A B_Q ϖ₀
    have hMax_B : IsLocalRing.maximalIdeal B_Q = Ideal.span {t} := by
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := A_𝔭) (S := B_Q), hMax_A,
        Ideal.map_span, Set.image_singleton, ← IsScalarTower.algebraMap_apply A A_𝔭 B_Q]
    have : Module.Flat B B_Q := IsLocalization.flat B_Q Q.primeCompl
    have : Module.Flat A B_Q := Module.Flat.trans A B B_Q
    have : Module.IsTorsionFree A B_Q := Module.Flat.isTorsionFree
    have ht_reg : ∀ z : B_Q, t * z = 0 → z = 0 := by
      intro z hz
      have hsmul : ϖ₀ • z = 0 := by rwa [Algebra.smul_def]
      exact (Module.isTorsionFree_iff_smul_eq_zero.mp ‹_› ϖ₀ z hsmul).resolve_left hϖ₀_ne
    have ht_pow_reg : ∀ (m : ℕ) (z : B_Q), t ^ m * z = 0 → z = 0 := by
      intro m
      induction m with
      | zero => intro z hz; simpa using hz
      | succ m ih =>
        intro z hz
        apply ih
        apply ht_reg
        calc t * (t ^ m * z) = t ^ (m + 1) * z := by ring
          _ = 0 := hz
    have ht_ne : t ≠ 0 := by
      intro h0
      have h1 : (1 : B_Q) = 0 := ht_reg 1 (by rw [h0, zero_mul])
      exact one_ne_zero h1
    have hKrull : (⨅ i : ℕ, (IsLocalRing.maximalIdeal B_Q) ^ i) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal B_Q)
        (IsLocalRing.maximalIdeal.isMaximal B_Q).ne_top
    have hFactor : ∀ x : B_Q, x ≠ 0 → ∃ (k : ℕ) (u : B_Q), IsUnit u ∧ x = t ^ k * u := by
      intro x hx_ne
      have hex : ∃ i : ℕ, x ∉ (IsLocalRing.maximalIdeal B_Q) ^ i := by
        by_contra hAll
        push Not at hAll
        have hx_bot : x ∈ (⨅ i : ℕ, (IsLocalRing.maximalIdeal B_Q) ^ i) :=
          Ideal.mem_iInf.mpr hAll
        rw [hKrull, Ideal.mem_bot] at hx_bot
        exact hx_ne hx_bot
      classical
      let m := Nat.find hex
      have hm_spec : x ∉ (IsLocalRing.maximalIdeal B_Q) ^ m := Nat.find_spec hex
      have hm_ne : m ≠ 0 := by
        intro hm0
        apply hm_spec
        rw [hm0, pow_zero, Ideal.one_eq_top]
        trivial
      obtain ⟨k, hm_eq⟩ := Nat.exists_eq_succ_of_ne_zero hm_ne
      have hx_in : x ∈ (IsLocalRing.maximalIdeal B_Q) ^ k := by
        by_contra hnot
        have hlt : k < m := hm_eq ▸ Nat.lt_succ_self k
        exact Nat.find_min hex hlt hnot
      rw [hMax_B, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hx_in
      obtain ⟨u, rfl⟩ := hx_in
      refine ⟨k, u, ?_, rfl⟩
      by_contra hu_not_unit
      have hu_max : u ∈ IsLocalRing.maximalIdeal B_Q := by
        by_contra hu_not_max
        exact hu_not_unit (IsLocalRing.notMem_maximalIdeal.mp hu_not_max)
      rw [hMax_B, Ideal.mem_span_singleton] at hu_max
      obtain ⟨v, rfl⟩ := hu_max
      apply hm_spec
      rw [hm_eq, Nat.succ_eq_add_one, hMax_B, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      exact ⟨v, by ring⟩
    have hNoZeroDiv : NoZeroDivisors B_Q := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra hboth
      push Not at hboth
      obtain ⟨hx_ne, hy_ne⟩ := hboth
      obtain ⟨k, u, hu, rfl⟩ := hFactor x hx_ne
      obtain ⟨l, v, hv, rfl⟩ := hFactor y hy_ne
      have hmul : t ^ (k + l) * (u * v) = 0 := by
        calc t ^ (k + l) * (u * v) = (t ^ k * u) * (t ^ l * v) := by ring
          _ = 0 := hxy
      exact (hu.mul hv).ne_zero (ht_pow_reg (k + l) (u * v) hmul)
    have hDom : IsDomain B_Q := NoZeroDivisors.to_isDomain B_Q
    let _ : IsDomain B_Q := hDom
    have hNotField : ¬ IsField B_Q := by
      intro hF
      obtain ⟨v, hv⟩ := hF.mul_inv_cancel ht_ne
      have ht_unit : IsUnit t := isUnit_iff_exists_inv.mpr ⟨v, hv⟩
      have ht_max : t ∈ IsLocalRing.maximalIdeal B_Q := by
        rw [hMax_B]
        exact Ideal.subset_span rfl
      exact (IsLocalRing.notMem_maximalIdeal.mpr ht_unit) ht_max
    have hMax_princ : Submodule.IsPrincipal (IsLocalRing.maximalIdeal B_Q) := by
      refine ⟨⟨t, ?_⟩⟩
      rw [Ideal.submodule_span_eq, hMax_B]
    exact ⟨hDom, ((IsDiscreteValuationRing.TFAE B_Q hNotField).out 1 5).mpr hMax_princ⟩
  refine ⟨?_, ?_⟩
  · 
    rintro ⟨g_sm, hg_comp, hg_et⟩
    have hLocSurj : (∃ 𝔪 : Ideal S_E, 𝔪.IsPrime ∧ Ideal.comap φ₀ 𝔪 = p_y) →
        ∀ s : S_E, ∃ (a c : R₀), c ∉ p_y ∧ φ₀ c * s = φ₀ a := by
      rintro ⟨𝔪₀, h𝔪₀_prime, h𝔪₀_over⟩
      let _ : Algebra R₀ S_E := φ₀.toAlgebra
      have hModFin : Module.Finite R₀ S_E := RingHom.finite_algebraMap.mp hFin
