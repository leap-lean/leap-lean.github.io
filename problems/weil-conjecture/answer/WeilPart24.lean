                  η₁ ((f_bar₁ s₀ * f_bar₁ s) ^ e) *
                  (η₀₁ (G_bar₀₁ r₀ s₀) * ι₁_s₀ z₁.1) := by rw [← hRel_br]
            _ = η₀₁ (ρ_bar₀ (G_bar₀₀ r₀ r) * G_bar₀₁ r s) *
                  η₀₁ (G_bar₀₁ r₀ s₀) *
                  (η₁ ((f_bar₁ s₀ * f_bar₁ s) ^ e) * ι₁_s₀ z₁.1) := by ring
            _ = η₀₁ (ρ_bar₀ (G_bar₀₀ r₀ r) * G_bar₀₁ r s) *
                  η₀₁ (G_bar₀₁ r₀ s₀) *
                  (η₁ (G_bar₁₁ s₀ s) * ι₁_s (v₁ s).1) := by rw [← hRel₁]
            _ = (η₀ (G_bar₀₀ r₀ r) * η₀₁ (G_bar₀₁ r₀ s₀) * η₁ (G_bar₁₁ s₀ s)) *
                  (η₀₁ (G_bar₀₁ r s) * ι₁_s (v₁ s).1) := by
                dsimp [η₀]; simp only [map_mul]; ring
        · have hSub := hSubHom hNt_s ψ_R
          exact @Subsingleton.elim _ hSub _ _
      · have hSub := hSubHom hNt_r ψ_L
        exact @Subsingleton.elim _ hSub _ _
    · apply hNoCoboundary
      refine ⟨v₀, fun _ => 1, hv₀_cob, ?_, ?_⟩
      · intro s s' ψ_L _ _ _
        have hSub := hSubHom (fun h => hEx₁ ⟨s, h⟩) ψ_L
        exact @Subsingleton.elim _ hSub _ _
      · intro r s _ ψ_R _ _
        have hSub := hSubHom (fun h => hEx₁ ⟨s, h⟩) ψ_R
        exact @Subsingleton.elim _ hSub _ _

  have hNoRoot₁ : ∀ s₀ : Fin m₁, Nontrivial (Localization.Away (f_bar₁ s₀)) →
      ∀ b : FractionRing (Localization.Away (f_bar₁ s₀)),
        b ^ ℓ ≠ algebraMap (Localization.Away (f_bar₁ s₀))
          (FractionRing (Localization.Away (f_bar₁ s₀)))
          (algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (U_bar₁ s₀)) := by
    intro s₀ hNt_s₀ b hb
    have hNt_R₁ : Nontrivial R_bar₁ := hNtBase (f_bar₁ s₀) hNt_s₀
    obtain ⟨hDom₁, hIC₁⟩ := hNorm₁ hNt_R₁
    have _ : IsDomain R_bar₁ := hDom₁
    have _ : IsIntegrallyClosed R_bar₁ := hIC₁
    obtain ⟨hfs₀_ne, hDom_Ss₀, hIC_Ss₀, -⟩ := hAwayDomIC (f_bar₁ s₀) hNt_s₀
    have _ : IsDomain (Localization.Away (f_bar₁ s₀)) := hDom_Ss₀
    have _ : IsIntegrallyClosed (Localization.Away (f_bar₁ s₀)) := hIC_Ss₀
    have hUV_s₀ : IsUnit (algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (U_bar₁ s₀) *
        algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (V_bar₁ s₀)) := by
      rw [← map_mul, hUV₁ s₀, map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit (f_bar₁ s₀)).pow d_u
    obtain ⟨z₁, -, hz₁_pow⟩ :=
      hDescentUnit (Localization.Away (f_bar₁ s₀))
        (algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (U_bar₁ s₀))
        (algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (V_bar₁ s₀)) hUV_s₀ b hb
    by_cases hEx₀ : ∃ r₀ : Fin m₀, Nontrivial (Localization.Away (f_bar₀ r₀))
    · obtain ⟨r₀, hNt_r₀⟩ := hEx₀
      have hNt_R₀ : Nontrivial R_bar₀ := hNtBase (f_bar₀ r₀) hNt_r₀
      obtain ⟨hDom₀, hIC₀⟩ := hNorm₀ hNt_R₀
      have _ : IsDomain R_bar₀ := hDom₀
      have _ : IsIntegrallyClosed R_bar₀ := hIC₀
      have hDom₀₁ : IsDomain R_bar₀₁ := hOverlapDom hNt_R₀ hNt_R₁
      have _ : IsDomain R_bar₀₁ := hDom₀₁
      obtain ⟨hf₀_ne, hDom_Sr₀, -, hinj_Sr₀⟩ := hAwayDomIC (f_bar₀ r₀) hNt_r₀
      have _ : IsDomain (Localization.Away (f_bar₀ r₀)) := hDom_Sr₀
      have ht₀_ne : t_bar₀ ≠ 0 := by
        intro h0
        have h01 : (0 : R_bar₀₁) = 1 := by
          calc (0 : R_bar₀₁) = 0 * ρ_bar₁ t_bar₁ := (zero_mul _).symm
            _ = ρ_bar₀ t_bar₀ * ρ_bar₁ t_bar₁ := by rw [h0, map_zero]
            _ = 1 := ht_bar₀₁
        exact zero_ne_one h01
      have ht₁_ne : t_bar₁ ≠ 0 := by
        intro h0
        have h01 : (0 : R_bar₀₁) = 1 := by
          calc (0 : R_bar₀₁) = ρ_bar₀ t_bar₀ * 0 := (mul_zero _).symm
            _ = ρ_bar₀ t_bar₀ * ρ_bar₁ t_bar₁ := by rw [h0, map_zero]
            _ = 1 := ht_bar₀₁
        exact zero_ne_one h01
      have hρ₀_inj : Function.Injective ρ_bar₀ := by
        let alg₀ : Algebra R_bar₀ R_bar₀₁ := ρ_bar₀.toAlgebra
        have _ : IsLocalization.Away t_bar₀ R_bar₀₁ := hLoc_bar₀
        have hle : Submonoid.powers t_bar₀ ≤ nonZeroDivisors R_bar₀ := by
          rintro _ ⟨n, rfl⟩; exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n ht₀_ne)
        exact IsLocalization.injective R_bar₀₁ hle
      have hρ₁_inj : Function.Injective ρ_bar₁ := by
        let alg₁ : Algebra R_bar₁ R_bar₀₁ := ρ_bar₁.toAlgebra
        have _ : IsLocalization.Away t_bar₁ R_bar₀₁ := hLoc_bar₁
        have hle : Submonoid.powers t_bar₁ ≤ nonZeroDivisors R_bar₁ := by
          rintro _ ⟨n, rfl⟩; exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n ht₁_ne)
        exact IsLocalization.injective R_bar₀₁ hle
      let d₀ : R_bar₀₁ := ρ_bar₀ (f_bar₀ r₀) * ρ_bar₁ (f_bar₁ s₀)
      have ha₀_ne : ρ_bar₀ (f_bar₀ r₀) ≠ 0 :=
        fun h0 => hf₀_ne (hρ₀_inj (h0.trans (map_zero ρ_bar₀).symm))
      have hb₀_ne : ρ_bar₁ (f_bar₁ s₀) ≠ 0 :=
        fun h0 => hfs₀_ne (hρ₁_inj (h0.trans (map_zero ρ_bar₁).symm))
      have hd₀_ne : d₀ ≠ 0 := mul_ne_zero ha₀_ne hb₀_ne
      have hd₀_unit : IsUnit (algebraMap R_bar₀₁ (Localization.Away d₀) d₀) :=
        IsLocalization.Away.algebraMap_isUnit d₀
      have hmul_ab : IsUnit (algebraMap R_bar₀₁ (Localization.Away d₀) (ρ_bar₀ (f_bar₀ r₀)) *
          algebraMap R_bar₀₁ (Localization.Away d₀) (ρ_bar₁ (f_bar₁ s₀))) := by
        rw [← map_mul]; exact hd₀_unit
      obtain ⟨ha₀_unit, hb₀_unit⟩ := hUnitOfMul hmul_ab
      obtain ⟨ψ_Lc01, hψ_Lc01⟩ :=
        hAwayLiftHom (S := Localization.Away (f_bar₀ r₀)) (f_bar₀ r₀)
          ((algebraMap R_bar₀₁ (Localization.Away d₀)).comp ρ_bar₀) ha₀_unit
      obtain ⟨ψ_Rc01, hψ_Rc01⟩ :=
        hAwayLiftHom (S := Localization.Away (f_bar₁ s₀)) (f_bar₁ s₀)
          ((algebraMap R_bar₀₁ (Localization.Away d₀)).comp ρ_bar₁) hb₀_unit
      have hde₀_unit : IsUnit (algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e)) := by
        rw [map_pow]; exact hd₀_unit.pow e
      rcases hde₀_unit with ⟨u_de₀, hu_de₀_val⟩
      let w₀ : Localization.Away d₀ :=
        algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) * ↑u_de₀⁻¹ * ψ_Rc01 z₁.1
      have hw₀_pow : w₀ ^ ℓ =
          ψ_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀)) := by
        let uD : Units (Localization.Away d₀) := u_de₀ ^ ℓ
        have huD : (uD : Localization.Away d₀) =
            algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ := by
          dsimp [uD]; rw [hu_de₀_val]
        have hmul_eq : algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ * w₀ ^ ℓ =
            algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ *
              ψ_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀)) := by
          have hdw₀ : algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) * w₀ =
              algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) * ψ_Rc01 z₁.1 := by
            dsimp only [w₀]
            calc
              algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) *
                  (algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) * ↑u_de₀⁻¹ *
                    ψ_Rc01 z₁.1)
                = (algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) *
                    ((u_de₀ : Localization.Away d₀) * ↑u_de₀⁻¹)) * ψ_Rc01 z₁.1 := by
                    rw [hu_de₀_val]; ring
              _ = algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) * ψ_Rc01 z₁.1 := by
                  rw [Units.mul_inv, mul_one]
          calc
            algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ * w₀ ^ ℓ
              = (algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) * w₀) ^ ℓ :=
                (mul_pow _ _ _).symm
            _ = (algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) * ψ_Rc01 z₁.1) ^ ℓ := by
                rw [hdw₀]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) ^ ℓ *
                  ψ_Rc01 (z₁.1 ^ ℓ) := by rw [mul_pow, ← map_pow ψ_Rc01]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) ((G_bar₀₁ r₀ s₀) ^ ℓ) *
                  ψ_Rc01 (algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (U_bar₁ s₀)) := by
                rw [← map_pow, hz₁_pow]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀)
                  ((G_bar₀₁ r₀ s₀) ^ ℓ * ρ_bar₁ (U_bar₁ s₀)) := by
                rw [hcomp_app hψ_Rc01 (U_bar₁ s₀), RingHom.comp_apply, ← map_mul]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ (ℓ * e) * ρ_bar₀ (U_bar₀ r₀)) := by
                dsimp [d₀]; rw [hGU₀₁ r₀ s₀]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) ((d₀ ^ e) ^ ℓ) *
                  algebraMap R_bar₀₁ (Localization.Away d₀) (ρ_bar₀ (U_bar₀ r₀)) := by
                have hexp : d₀ ^ (ℓ * e) = (d₀ ^ e) ^ ℓ := by ring
                rw [map_mul, hexp]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ *
                  ψ_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀)) := by
                rw [map_pow,
                  ← RingHom.comp_apply (algebraMap R_bar₀₁ (Localization.Away d₀)) ρ_bar₀,
                  ← hcomp_app hψ_Lc01 (U_bar₀ r₀)]
        calc
          w₀ ^ ℓ = ↑uD⁻¹ * (↑uD * w₀ ^ ℓ) := by rw [← mul_assoc, Units.inv_mul, one_mul]
          _ = ↑uD⁻¹ * (algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ * w₀ ^ ℓ) := by
              rw [huD]
          _ = ↑uD⁻¹ * (algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ *
                ψ_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀))) := by
              rw [hmul_eq]
          _ = ↑uD⁻¹ * (↑uD *
                ψ_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀))) := by
              rw [huD]
          _ = ψ_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀)) := by
              rw [← mul_assoc, Units.inv_mul, one_mul]
      let θ₀ : R_bar₀ →+* FractionRing (Localization.Away (f_bar₀ r₀)) :=
        (algebraMap (Localization.Away (f_bar₀ r₀))
            (FractionRing (Localization.Away (f_bar₀ r₀)))).comp
          (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)))
      have hθ₀_inj : Function.Injective θ₀ :=
        (hFracInj (Localization.Away (f_bar₀ r₀))).comp hinj_Sr₀
      obtain ⟨θ₀₁, hθ₀₁_c, hθ₀₁_inj⟩ :=
        @hAwayLiftInj R_bar₀ R_bar₀₁ (FractionRing (Localization.Away (f_bar₀ r₀)))
          _ _ ρ_bar₀.toAlgebra (fldOfDom (Localization.Away (f_bar₀ r₀)))
          t_bar₀ hLoc_bar₀ θ₀ hθ₀_inj ht₀_ne
      obtain ⟨ι_K₀, hι_K₀_c, -⟩ :=
        hAwayLiftInj (S := Localization.Away d₀) d₀ θ₀₁ hθ₀₁_inj hd₀_ne
      have hι_Lc01 : ι_K₀.comp ψ_Lc01 =
          algebraMap (Localization.Away (f_bar₀ r₀))
            (FractionRing (Localization.Away (f_bar₀ r₀))) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (f_bar₀ r₀))
        calc
          (ι_K₀.comp ψ_Lc01).comp (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)))
            = ι_K₀.comp ((algebraMap R_bar₀₁ (Localization.Away d₀)).comp ρ_bar₀) := by
                rw [RingHom.comp_assoc, hψ_Lc01]
          _ = (ι_K₀.comp (algebraMap R_bar₀₁ (Localization.Away d₀))).comp ρ_bar₀ :=
              (RingHom.comp_assoc _ _ _).symm
          _ = θ₀₁.comp ρ_bar₀ := by rw [hι_K₀_c]
          _ = θ₀ := hθ₀₁_c
      have hb₀_pow : (ι_K₀ w₀) ^ ℓ =
          algebraMap (Localization.Away (f_bar₀ r₀))
            (FractionRing (Localization.Away (f_bar₀ r₀)))
            (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀)) := by
        rw [← map_pow, hw₀_pow,
          hcomp_app hι_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀))]
      exact hNoRoot₀ r₀ hNt_r₀ (ι_K₀ w₀) hb₀_pow
    · obtain ⟨v₁, -, hv₁_cob⟩ :=
        hSingleProp R_bar₁ m₁ f_bar₁ U_bar₁ V_bar₁ G_bar₁₁ G'_bar₁₁
          hUV₁ hGG'₁₁ hGU₁₁ hCoc₁₁₁ s₀ hNt_s₀ z₁ hz₁_pow
      apply hNoCoboundary
      refine ⟨fun _ => 1, v₁, ?_, hv₁_cob, ?_⟩
      · intro r r' ψ_L _ _ _
        have hSub := hSubHom (fun h => hEx₀ ⟨r, h⟩) ψ_L
        exact @Subsingleton.elim _ hSub _ _
      · intro r s ψ_L _ _ _
        have hSub := hSubHom (fun h => hEx₀ ⟨r, h⟩) ψ_L
        exact @Subsingleton.elim _ hSub _ _

  
  let V_cov : Sum (Fin m₀) (Fin m₁) → Set ↥C₀.left := fun idx =>
    match idx with
    | Sum.inl r => j₀_k.base '' (PrimeSpectrum.basicOpen (f_bar₀ r) : Set (PrimeSpectrum R_bar₀))
    | Sum.inr s => j₁_k.base '' (PrimeSpectrum.basicOpen (f_bar₁ s) : Set (PrimeSpectrum R_bar₁))
  have hV_open : ∀ idx, IsOpen (V_cov idx) := by
    rintro (r | s)
    · exact ((AlgebraicGeometry.IsOpenImmersion.iff_isIso_stalkMap).mp inferInstance).1.isOpenMap _
        (PrimeSpectrum.basicOpen (f_bar₀ r)).isOpen
    · exact ((AlgebraicGeometry.IsOpenImmersion.iff_isIso_stalkMap).mp inferInstance).1.isOpenMap _
        (PrimeSpectrum.basicOpen (f_bar₁ s)).isOpen
  have hV_cov : (⋃ idx, V_cov idx) = Set.univ := by
    ext y
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hy_univ : y ∈ Set.range j₀_k.base ∪ Set.range j₁_k.base := by
      rw [hCov_k]; trivial
    rcases hy_univ with ⟨p₀, rfl⟩ | ⟨p₁, rfl⟩
    · by_contra hnot
      have hall : ∀ r : Fin m₀, f_bar₀ r ∈ p₀.asIdeal := by
        intro r
        by_contra hfr
        apply hnot
        exact Set.mem_iUnion.mpr ⟨Sum.inl r, p₀, hfr, rfl⟩
      have h1_mem : (1 : R_bar₀) ∈ p₀.asIdeal := by
        rw [← hPart₀]
        exact Ideal.sum_mem p₀.asIdeal fun r _ => Ideal.mul_mem_left p₀.asIdeal _ (hall r)
      exact p₀.isPrime.ne_top ((Ideal.eq_top_iff_one p₀.asIdeal).mpr h1_mem)
    · by_contra hnot
      have hall : ∀ s : Fin m₁, f_bar₁ s ∈ p₁.asIdeal := by
        intro s
        by_contra hfs
        apply hnot
        exact Set.mem_iUnion.mpr ⟨Sum.inr s, p₁, hfs, rfl⟩
      have h1_mem : (1 : R_bar₁) ∈ p₁.asIdeal := by
        rw [← hPart₁]
        exact Ideal.sum_mem p₁.asIdeal fun s _ => Ideal.mul_mem_left p₁.asIdeal _ (hall s)
      exact p₁.isPrime.ne_top ((Ideal.eq_top_iff_one p₁.asIdeal).mpr h1_mem)
  have hPre_irred : ∀ idx, (V_cov idx).Nonempty → IsIrreducible (ν₀.base ⁻¹' V_cov idx) := by
    rintro (r | s) ⟨y, p, hp, rfl⟩
    · let S_r := Localization.Away (f_bar₀ r)
      let loc_r : AlgebraicGeometry.Spec (CommRingCat.of S_r) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_bar₀) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_bar₀ S_r))
      have hloc_range : Set.range loc_r.base =
          (PrimeSpectrum.basicOpen (f_bar₀ r) : Set (PrimeSpectrum R_bar₀)) :=
        PrimeSpectrum.localization_away_comap_range S_r (f_bar₀ r)
      have hp_range : p ∈ Set.range loc_r.base := by
        rw [hloc_range]
        exact hp
      obtain ⟨q_r, -⟩ := hp_range
      have hNe_Sr : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of S_r)) := ⟨q_r⟩
      have hOpen_locr : AlgebraicGeometry.IsOpenImmersion loc_r :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization (f_bar₀ r)
      have hOpen_cr : AlgebraicGeometry.IsOpenImmersion (loc_r ≫ j₀_k) :=
        @AlgebraicGeometry.IsOpenImmersion.comp _ _ _ loc_r j₀_k hOpen_locr inferInstance
      have hInt_Sr : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of S_r)) :=
        @hOpenInt (AlgebraicGeometry.Spec (CommRingCat.of S_r)) (loc_r ≫ j₀_k) hOpen_cr hNe_Sr
      have hDom_Sr : IsDomain S_r :=
        (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of S_r)).mp hInt_Sr
      let A_r := AdjoinRoot
        ((Polynomial.X : Polynomial S_r) ^ ℓ -
          Polynomial.C (algebraMap R_bar₀ S_r (U_bar₀ r)))
      have hDom_Ar : IsDomain A_r :=
        @h_s3 S_r _ hDom_Sr (algebraMap R_bar₀ S_r (U_bar₀ r))
          (hNoRoot₀ r (@IsDomain.toNontrivial S_r _ hDom_Sr))
      have hIrr_Ar : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of A_r)) :=
        @hIrrOfDom A_r _ hDom_Ar
      dsimp only [V_cov]
      rw [← hRange_tilde₀ r, ← Set.image_univ]
      exact (@IrreducibleSpace.isIrreducible_univ
        ↥(AlgebraicGeometry.Spec (CommRingCat.of A_r)) _ hIrr_Ar).image
        (ι_tilde₀ r).base (ι_tilde₀ r).continuous.continuousOn
    · let S_s := Localization.Away (f_bar₁ s)
      let loc_s : AlgebraicGeometry.Spec (CommRingCat.of S_s) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_bar₁) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_bar₁ S_s))
      have hloc_range : Set.range loc_s.base =
          (PrimeSpectrum.basicOpen (f_bar₁ s) : Set (PrimeSpectrum R_bar₁)) :=
        PrimeSpectrum.localization_away_comap_range S_s (f_bar₁ s)
      have hp_range : p ∈ Set.range loc_s.base := by
        rw [hloc_range]
        exact hp
      obtain ⟨q_s, -⟩ := hp_range
      have hNe_Ss : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of S_s)) := ⟨q_s⟩
      have hOpen_locs : AlgebraicGeometry.IsOpenImmersion loc_s :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization (f_bar₁ s)
      have hOpen_cs : AlgebraicGeometry.IsOpenImmersion (loc_s ≫ j₁_k) :=
        @AlgebraicGeometry.IsOpenImmersion.comp _ _ _ loc_s j₁_k hOpen_locs inferInstance
      have hInt_Ss : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of S_s)) :=
        @hOpenInt (AlgebraicGeometry.Spec (CommRingCat.of S_s)) (loc_s ≫ j₁_k) hOpen_cs hNe_Ss
      have hDom_Ss : IsDomain S_s :=
        (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of S_s)).mp hInt_Ss
      let A_s := AdjoinRoot
        ((Polynomial.X : Polynomial S_s) ^ ℓ -
          Polynomial.C (algebraMap R_bar₁ S_s (U_bar₁ s)))
      have hDom_As : IsDomain A_s :=
        @h_s3 S_s _ hDom_Ss (algebraMap R_bar₁ S_s (U_bar₁ s))
          (hNoRoot₁ s (@IsDomain.toNontrivial S_s _ hDom_Ss))
      have hIrr_As : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of A_s)) :=
        @hIrrOfDom A_s _ hDom_As
      dsimp only [V_cov]
      rw [← hRange_tilde₁ s, ← Set.image_univ]
      exact (@IrreducibleSpace.isIrreducible_univ
        ↥(AlgebraicGeometry.Spec (CommRingCat.of A_s)) _ hIrr_As).image
        (ι_tilde₁ s).base (ι_tilde₁ s).continuous.continuousOn
  exact @h_s4 ↥F₀ ↥C₀.left _ _ hIrr_C₀ ν₀.base ν₀.continuous
    (AlgebraicGeometry.Surjective.surj (f := ν₀))
    (Sum (Fin m₀) (Fin m₁)) V_cov hV_open hV_cov hPre_irred

theorem weil_twoChart_colimit_spread_and_cyclic_etale_cover (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (R₁ : Type u) [CommRing R₁] [IsDomain R₁] [Algebra k R₁] [Algebra.FiniteType k R₁]
    (σ₁ : R₁ →ₐ[k] k)
    (u_R₁ : MvPolynomial (Fin δ) k →ₐ[k] R₁)
    (hu_R₁ : RingHom.Etale u_R₁.toRingHom)
    (Y_R₁ : AlgebraicGeometry.Scheme.{u})
    (f_YR₁ : Quiver.Hom Y_R₁ (AlgebraicGeometry.Spec (CommRingCat.of R₁)))
    [AlgebraicGeometry.IsProper f_YR₁]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_YR₁]
    (π_R₁ : Quiver.Hom Y_R₁
      (CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₁)))
        (weilProjectiveSpaceOver k 1).hom))
    [AlgebraicGeometry.IsFinite π_R₁]
    (hπ_R₁ : CategoryTheory.CategoryStruct.comp π_R₁
      (CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₁)))
        (weilProjectiveSpaceOver k 1).hom) = f_YR₁)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC₀ : AlgebraicGeometry.IsIntegral C₀.left)
    (hProjC₀ : IsProjectiveOverField k C₀)
    (ι_C₀_R₁ : Quiver.Hom C₀.left Y_R₁)
    (hPb_C₀_R₁ : CategoryTheory.IsPullback ι_C₀_R₁ C₀.hom f_YR₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.toRingHom)))
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D_sh : CategoryTheory.Functor ℐ CommRingCat.{u})
    (α_sh : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₁)) D_sh)
    (A : Type u) [CommRing A] [Algebra k A]
    (f_A : R₁ →ₐ[k] A) (τ_A : A →ₐ[k] k)
    (c_sh : CategoryTheory.Limits.Cocone D_sh)
    (hc_sh : CategoryTheory.Limits.IsColimit c_sh)
    (e_pt : CategoryTheory.Iso c_sh.pt (CommRingCat.of A))
    (τ_lvl : ∀ i : ℐ, ↑(D_sh.obj i) →+* k)
    (hEt_sh : ∀ i : ℐ, RingHom.Etale (CommRingCat.Hom.hom (α_sh.app i)))
    (hColim_fA : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α_sh.app i)
      (CategoryTheory.CategoryStruct.comp (c_sh.ι.app i) e_pt.hom) =
      CommRingCat.ofHom f_A.toRingHom)
    (hColim_τ : ∀ (i : ℐ) (x : ↑(D_sh.obj i)),
      τ_A (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c_sh.ι.app i) e_pt.hom) x) =
        τ_lvl i x)
    (hτA_fA : τ_A.comp f_A = σ₁)
    (hStrictA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A)
    (Y_A : AlgebraicGeometry.Scheme.{u})
    (p_YA_R₁ : Quiver.Hom Y_A Y_R₁)
    (f_YA : Quiver.Hom Y_A (AlgebraicGeometry.Spec (CommRingCat.of A)))
    (hPb_YA : CategoryTheory.IsPullback p_YA_R₁ f_YA f_YR₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_A.toRingHom)))
    (i_C₀ : Quiver.Hom C₀.left Y_A)
    (hi_C₀_R₁ : CategoryTheory.CategoryStruct.comp i_C₀ p_YA_R₁ = ι_C₀_R₁)
    (hPb_iC₀ : CategoryTheory.IsPullback i_C₀ C₀.hom f_YA
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)))
    (N : ℕ) (hN : 1 ≤ N)
    (U : Fin N → Y_A.Opens)
    (u : ∀ a : Fin N, Units ↑(Y_A.presheaf.obj (Opposite.op (U a))))
    (g : ∀ a b : Fin N, Units ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b))))
    (hCov : (⨆ a : Fin N, U a) = ⊤)
    (hAffU : ∀ a : Fin N, AlgebraicGeometry.IsAffineOpen (U a))
    (hDiag : ∀ a : Fin N, (g a a : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U a)))) = 1)
    (hCocyc : ∀ a b c : Fin N,
      (Y_A.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => ⟨hx.1.1, hx.1.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U a ⊓ U b)).op).hom
        (g a b : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))) *
      (Y_A.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => ⟨hx.1.2, hx.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U b ⊓ U c)).op).hom
        (g b c : ↑(Y_A.presheaf.obj (Opposite.op (U b ⊓ U c)))) =
      (Y_A.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => ⟨hx.1.1, hx.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U a ⊓ U c)).op).hom
        (g a c : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U c)))))
    (hPow : ∀ a b : Fin N,
      ((g a b : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))) ^ ℓ) *
      (Y_A.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => hx.2 : U a ⊓ U b ≤ U b)).op).hom
        (u b : ↑(Y_A.presheaf.obj (Opposite.op (U b)))) =
      (Y_A.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => hx.1 : U a ⊓ U b ≤ U a)).op).hom
        (u a : ↑(Y_A.presheaf.obj (Opposite.op (U a)))))
    (hNoRoot : ¬ ∃ w₀ : ∀ a : Fin N,
        Units ↑(C₀.left.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map i_C₀.base).obj (U a)))),
      ∀ a b : Fin N,
        (C₀.left.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => hx.1 :
            (TopologicalSpace.Opens.map i_C₀.base).obj (U a ⊓ U b) ≤
            (TopologicalSpace.Opens.map i_C₀.base).obj (U a))).op).hom
          (w₀ a).1 =
        (i_C₀.app (U a ⊓ U b)).hom
          (g a b : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))) *
        (C₀.left.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => hx.2 :
            (TopologicalSpace.Opens.map i_C₀.base).obj (U a ⊓ U b) ≤
            (TopologicalSpace.Opens.map i_C₀.base).obj (U b))).op).hom
          (w₀ b).1) :
    ∃ (B₀ : Type u) (_ : CommRing B₀) (_ : IsDomain B₀) (_ : Algebra k B₀)
      (_ : Algebra R₁ B₀) (_ : IsScalarTower k R₁ B₀)
      (τ_B₀ : B₀ →ₐ[k] k)
      (ψ_BA : B₀ →ₐ[k] A)
      (Y_raw : AlgebraicGeometry.Scheme.{u})
      (ν_R₁ : Quiver.Hom Y_raw
        (CategoryTheory.Limits.pullback f_YR₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀))))),
      RingHom.Etale (algebraMap R₁ B₀) ∧
      τ_B₀.comp (IsScalarTower.toAlgHom k R₁ B₀) = σ₁ ∧
      ψ_BA.comp (IsScalarTower.toAlgHom k R₁ B₀) = f_A ∧
      τ_A.comp ψ_BA = τ_B₀ ∧
      AlgebraicGeometry.IsFinite ν_R₁ ∧
      AlgebraicGeometry.Etale ν_R₁ ∧
      AlgebraicGeometry.Surjective ν_R₁ ∧
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback
        (CategoryTheory.CategoryStruct.comp ν_R₁
          (CategoryTheory.Limits.pullback.snd f_YR₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀)))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₀.toRingHom))) ∧
      (∀ (C_test : AlgebraicGeometry.Scheme.{u})
          (ι_test : Quiver.Hom C_test Y_raw)
          (h_test : Quiver.Hom C_test Y_A),
        CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp ι_test ν_R₁)
            (CategoryTheory.Limits.pullback.fst f_YR₁
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀)))) =
          CategoryTheory.CategoryStruct.comp h_test p_YA_R₁ →
        CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp ι_test ν_R₁)
            (CategoryTheory.Limits.pullback.snd f_YR₁
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀)))) =
          CategoryTheory.CategoryStruct.comp h_test
            (CategoryTheory.CategoryStruct.comp f_YA
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BA.toRingHom))) →
        ∃ w : ∀ a : Fin N,
            Units ↑(C_test.presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map h_test.base).obj (U a)))),
          ∀ a b : Fin N,
            (C_test.presheaf.map (CategoryTheory.homOfLE
              (fun _ hx => hx.1 :
                (TopologicalSpace.Opens.map h_test.base).obj (U a ⊓ U b) ≤
                (TopologicalSpace.Opens.map h_test.base).obj (U a))).op).hom
              (w a).1 =
            (h_test.app (U a ⊓ U b)).hom
              (g a b : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))) *
            (C_test.presheaf.map (CategoryTheory.homOfLE
              (fun _ hx => hx.2 :
                (TopologicalSpace.Opens.map h_test.base).obj (U a ⊓ U b) ≤
                (TopologicalSpace.Opens.map h_test.base).obj (U b))).op).hom
              (w b).1) :=
by
  classical
  let algR₁A : Algebra R₁ A := f_A.toRingHom.toAlgebra
  letI : Algebra R₁ A := algR₁A
  have hTower_kR₁A : IsScalarTower k R₁ A :=
    IsScalarTower.of_algebraMap_eq' f_A.comp_algebraMap.symm
  letI : IsScalarTower k R₁ A := hTower_kR₁A
  have hf_A_alg : algebraMap R₁ A = f_A.toRingHom := rfl

  
  obtain ⟨M₀, M₁, M₀₁, hCRM₀, hAlgM₀, hCRM₁, hAlgM₁, hCRM₀₁, hAlgM₀₁,
    t₀, t₁, ρ₀, ρ₁, chart₀, chart₁, m₀, m₁, d_u, e, T_ann,
    f₀, q₀, U₀, V₀, G₀₀, G'₀₀, f₁, q₁, U₁, V₁, G₁₁, G'₁₁, G₀₁, G'₀₁,
    hLoc₀, hLoc₁, ht₀₁, hm₀, hm₁, hAtlas, hAtlasNat, hEqsA, hGlueScheme, hGlueLoc⟩ :=
    weil_twoChart_baseChange_atlas_and_zariski_refinement k ℓ R₁ Y_R₁ f_YR₁ π_R₁ hπ_R₁
      A Y_A p_YA_R₁ f_YA hPb_YA N hN U u g hCov hAffU hDiag hCocyc hPow
  letI : CommRing M₀ := hCRM₀
  letI : Algebra R₁ M₀ := hAlgM₀
  letI : CommRing M₁ := hCRM₁
  letI : Algebra R₁ M₁ := hAlgM₁
  letI : CommRing M₀₁ := hCRM₀₁
  letI : Algebra R₁ M₀₁ := hAlgM₀₁

  
  have hUnitA : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a := hStrictA.2.2.1
  have hAwayDom : ∀ (B : Type u) [CommRing B] [Algebra R₁ B] [Algebra.Etale R₁ B]
      (τ_B : B →+* k),
      τ_B.comp (algebraMap R₁ B) = σ₁.toRingHom →
      ∃ h₀ : B, τ_B h₀ ≠ 0 ∧ IsDomain (Localization.Away h₀) := by
    intro B _ _ _ τ_B hτ_B
    let algPR₁ : Algebra (MvPolynomial (Fin δ) k) R₁ := u_R₁.toRingHom.toAlgebra
    let algPB : Algebra (MvPolynomial (Fin δ) k) B :=
      ((algebraMap R₁ B).comp u_R₁.toRingHom).toAlgebra
    letI : Algebra (MvPolynomial (Fin δ) k) R₁ := algPR₁
    letI : Algebra (MvPolynomial (Fin δ) k) B := algPB
    haveI : IsScalarTower (MvPolynomial (Fin δ) k) R₁ B :=
      IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale (MvPolynomial (Fin δ) k) R₁ :=
      RingHom.etale_algebraMap.mp hu_R₁
    haveI : Algebra.Etale (MvPolynomial (Fin δ) k) B :=
      Algebra.Etale.comp (MvPolynomial (Fin δ) k) R₁ B
    haveI : Algebra.FiniteType (MvPolynomial (Fin δ) k) B := inferInstance
    haveI : IsNoetherianRing B :=
      Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin δ) k) B
    have hτ_surj : Function.Surjective τ_B := by
      intro c
      refine ⟨algebraMap R₁ B (algebraMap k R₁ c), ?_⟩
      change (τ_B.comp (algebraMap R₁ B)) (algebraMap k R₁ c) = c
      rw [hτ_B]
      exact σ₁.commutes c
    let m₀_B : Ideal B := RingHom.ker τ_B
    have hm₀_eq : m₀_B = Ideal.comap τ_B (⊥ : Ideal k) := rfl
    haveI : m₀_B.IsMaximal := by
      rw [hm₀_eq]
      haveI : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      exact Ideal.comap_isMaximal_of_surjective τ_B hτ_surj
    obtain ⟨h₀, hh₀, hDom⟩ :=
      weil_noetherian_locally_domain_exists_away_isDomain B m₀_B
        (fun p _ =>
          (weil_algClosed_etale_mvPolynomial_local_domain_integrallyClosed k δ B p).1)
    exact ⟨h₀, fun h0 => hh₀ h0, hDom⟩

  obtain ⟨B₀, hCR_B₀, hDom_B₀, hAlgk_B₀, hAlgR₁_B₀, hTower_B₀,
    τ_B₀, ψ_BA, ψ_R₁,
    f₀_B, q₀_B, U₀_B, V₀_B, G₀₀_B, G'₀₀_B, f₁_B, q₁_B, U₁_B, V₁_B, G₁₁_B, G'₁₁_B, G₀₁_B, G'₀₁_B,
    hEt_B₀, hτB₀_σ₁, hψBA_fA, hτA_ψBA, hψR₁_eq, hEqsB,
    hf₀_map, hG₀₀_map, hf₁_map, hG₁₁_map, hG₀₁_map⟩ :=
    weil_twoChart_filtered_colimit_spread_to_domain k ℓ R₁ σ₁ ℐ D_sh α_sh
      A f_A τ_A hf_A_alg c_sh hc_sh e_pt τ_lvl hEt_sh hColim_fA hColim_τ hτA_fA
      hUnitA hAwayDom M₀ M₁ M₀₁ ρ₀ ρ₁ m₀ m₁ d_u e T_ann
      f₀ q₀ U₀ V₀ G₀₀ G'₀₀ f₁ q₁ U₁ V₁ G₁₁ G'₁₁ G₀₁ G'₀₁ hEqsA
  letI : CommRing B₀ := hCR_B₀
  letI : IsDomain B₀ := hDom_B₀
  letI : Algebra k B₀ := hAlgk_B₀
  letI : Algebra R₁ B₀ := hAlgR₁_B₀
  letI : IsScalarTower k R₁ B₀ := hTower_B₀

  
  let map_R₁B₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀))
  let Y_B₀ := CategoryTheory.Limits.pullback f_YR₁ map_R₁B₀
  let p_YB₀_R₁ := CategoryTheory.Limits.pullback.fst f_YR₁ map_R₁B₀
  let f_B₀ := CategoryTheory.Limits.pullback.snd f_YR₁ map_R₁B₀
  have hPb_YB₀ : CategoryTheory.IsPullback p_YB₀_R₁ f_B₀ f_YR₁ map_R₁B₀ :=
    CategoryTheory.IsPullback.of_hasPullback f_YR₁ map_R₁B₀
  let j₀_B := chart₀ B₀ Y_B₀ p_YB₀_R₁ f_B₀ hPb_YB₀
  let j₁_B := chart₁ B₀ Y_B₀ p_YB₀_R₁ f_B₀ hPb_YB₀
  obtain ⟨hOpen_j₀B, hOpen_j₁B, hCov_B, hPb_B⟩ := hAtlas B₀ Y_B₀ p_YB₀_R₁ f_B₀ hPb_YB₀
  haveI : AlgebraicGeometry.IsOpenImmersion j₀_B := hOpen_j₀B
  haveI : AlgebraicGeometry.IsOpenImmersion j₁_B := hOpen_j₁B

  obtain ⟨Y_raw, ν_R₁, hFin_ν, hEt_ν, hSurj_ν, hSpecFib, hPullCob⟩ :=
    weil_twoChart_cyclic_cover_gluing_and_baseChange_coboundary k ℓ hℓ R₁ B₀
      M₀ M₁ M₀₁ t₀ t₁ ρ₀ ρ₁ hLoc₀ hLoc₁ ht₀₁
      Y_B₀ f_B₀ j₀_B j₁_B hCov_B hPb_B
      m₀ m₁ d_u e T_ann hm₀ hm₁
      f₀_B q₀_B U₀_B V₀_B G₀₀_B G'₀₀_B f₁_B q₁_B U₁_B V₁_B G₁₁_B G'₁₁_B G₀₁_B G'₀₁_B hEqsB

  refine ⟨B₀, hCR_B₀, hDom_B₀, hAlgk_B₀, hAlgR₁_B₀, hTower_B₀,
    τ_B₀, ψ_BA, Y_raw, ν_R₁,
    hEt_B₀, hτB₀_σ₁, hψBA_fA, hτA_ψBA, hFin_ν, hEt_ν, hSurj_ν, ?_, ?_⟩

  
  · let algR₁k : Algebra R₁ k := σ₁.toRingHom.toAlgebra
    letI : Algebra R₁ k := algR₁k
    let τ_R₁ : B₀ →ₐ[R₁] k :=
      { toRingHom := τ_B₀.toRingHom
        commutes' := fun r => AlgHom.congr_fun hτB₀_σ₁ r }
    let τ_A_R₁ : A →ₐ[R₁] k :=
      { toRingHom := τ_A.toRingHom
        commutes' := fun r => AlgHom.congr_fun hτA_fA r }
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_C₀_R₁ inferInstance

    have hLocTensor : ∀ {M M' : Type u} [CommRing M] [Algebra R₁ M] [CommRing M'] [Algebra R₁ M']
        (t : M) (ρ : M →ₐ[R₁] M'),
        @IsLocalization.Away M _ t M' _ ρ.toRingHom.toAlgebra →
        @IsLocalization.Away (TensorProduct R₁ k M) _ (TensorProduct.tmul R₁ (1 : k) t)
          (TensorProduct R₁ k M') _
          (Algebra.TensorProduct.map (AlgHom.id R₁ k) ρ).toRingHom.toAlgebra := by
      intro M M' _ _ _ _ t ρ hLoc
      let algMM' : Algebra M M' := ρ.toRingHom.toAlgebra
      letI : Algebra M M' := algMM'
      haveI : IsLocalization.Away t M' := hLoc
      let SM := TensorProduct R₁ k M
      let SM' := TensorProduct R₁ k M'
      let t_SM : SM := TensorProduct.tmul R₁ (1 : k) t
      let L := Localization.Away t_SM
      let φ_SM : SM →ₐ[R₁] SM' := Algebra.TensorProduct.map (AlgHom.id R₁ k) ρ
      let algSMSM' : Algebra SM SM' := φ_SM.toRingHom.toAlgebra
      letI : Algebra SM SM' := algSMSM'
      have ht_unit_SM' : IsUnit (φ_SM t_SM) := by
        have hu : IsUnit (ρ t) := IsLocalization.Away.algebraMap_isUnit (S := M') t
        exact hu.map
          (Algebra.TensorProduct.includeRight (R := R₁) (A := k) (B := M')).toRingHom.toMonoidHom
      let fwd_ring : L →+* SM' :=
        IsLocalization.Away.lift (S := L) t_SM (g := φ_SM.toRingHom) ht_unit_SM'
      let m_to_L : M →+* L :=
        (algebraMap SM L).comp
          (Algebra.TensorProduct.includeRight (R := R₁) (A := k) (B := M)).toRingHom
      have ht_unit_L : IsUnit (m_to_L t) := IsLocalization.Away.algebraMap_isUnit (S := L) t_SM
      let m'_to_L_ring : M' →+* L :=
        IsLocalization.Away.lift (S := M') t (g := m_to_L) ht_unit_L
      let algR₁L : Algebra R₁ L := ((algebraMap SM L).comp (algebraMap R₁ SM)).toAlgebra
      letI : Algebra R₁ L := algR₁L
      let s_to_L : k →ₐ[R₁] L :=
        { toRingHom := (algebraMap SM L).comp
            (Algebra.TensorProduct.includeLeftRingHom (R := R₁) (A := k) (B := M))
          commutes' := fun r => by
            change algebraMap SM L (TensorProduct.tmul R₁ (algebraMap R₁ k r) (1 : M)) =
              algebraMap SM L (algebraMap R₁ SM r)
            congr 1 }
      let m'_to_L : M' →ₐ[R₁] L :=
        { toRingHom := m'_to_L_ring
          commutes' := fun r => by
            rw [← ρ.commutes r]
            have h1 : m'_to_L_ring (algebraMap M M' (algebraMap R₁ M r)) =
                m_to_L (algebraMap R₁ M r) :=
              IsLocalization.Away.lift_eq (S := M') t ht_unit_L (algebraMap R₁ M r)
            refine h1.trans ?_
            exact congrArg (algebraMap SM L)
              ((Algebra.TensorProduct.includeRight (R := R₁) (A := k) (B := M)).commutes r) }
      let bwd_alg : SM' →ₐ[R₁] L := Algebra.TensorProduct.productMap s_to_L m'_to_L
      have h_comp1 : bwd_alg.toRingHom.comp fwd_ring = RingHom.id L := by
        apply IsLocalization.ringHom_ext (Submonoid.powers t_SM)
        apply RingHom.ext
        intro z
        change bwd_alg (fwd_ring (algebraMap SM L z)) = algebraMap SM L z
        rw [IsLocalization.Away.lift_eq (S := L) t_SM ht_unit_SM' z]
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul s m =>
          change bwd_alg (TensorProduct.tmul R₁ s (ρ m)) =
            algebraMap SM L (TensorProduct.tmul R₁ s m)
          rw [Algebra.TensorProduct.productMap_apply_tmul]
          change s_to_L s * m'_to_L_ring (algebraMap M M' m) =
            algebraMap SM L (TensorProduct.tmul R₁ s m)
          rw [IsLocalization.Away.lift_eq (S := M') t ht_unit_L m]
          change algebraMap SM L (TensorProduct.tmul R₁ s 1) *
              algebraMap SM L (TensorProduct.tmul R₁ 1 m) =
            algebraMap SM L (TensorProduct.tmul R₁ s m)
          rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add x y ihx ihy => rw [map_add, map_add, map_add, ihx, ihy]
      have h_comp2 : fwd_ring.comp bwd_alg.toRingHom = RingHom.id SM' := by
        have h_m' : fwd_ring.comp m'_to_L_ring =
            (Algebra.TensorProduct.includeRight (R := R₁) (A := k) (B := M')).toRingHom := by
          apply IsLocalization.ringHom_ext (Submonoid.powers t)
          apply RingHom.ext
          intro m
          change fwd_ring (m'_to_L_ring (algebraMap M M' m)) =
            TensorProduct.tmul R₁ (1 : k) (ρ m)
          rw [IsLocalization.Away.lift_eq (S := M') t ht_unit_L m]
          change fwd_ring (algebraMap SM L (TensorProduct.tmul R₁ 1 m)) =
            TensorProduct.tmul R₁ (1 : k) (ρ m)
          rw [IsLocalization.Away.lift_eq (S := L) t_SM ht_unit_SM']
          rfl
        apply RingHom.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul s m' =>
          change fwd_ring (bwd_alg (TensorProduct.tmul R₁ s m')) = TensorProduct.tmul R₁ s m'
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_mul]
          have hs : fwd_ring (s_to_L s) = TensorProduct.tmul R₁ s (1 : M') := by
            change fwd_ring (algebraMap SM L (TensorProduct.tmul R₁ s 1)) =
              TensorProduct.tmul R₁ s 1
            rw [IsLocalization.Away.lift_eq (S := L) t_SM ht_unit_SM']
            change Algebra.TensorProduct.map (AlgHom.id R₁ k) ρ (TensorProduct.tmul R₁ s 1) =
              TensorProduct.tmul R₁ s 1
            simp
          have hm' : fwd_ring (m'_to_L m') = TensorProduct.tmul R₁ (1 : k) m' :=
            RingHom.congr_fun h_m' m'
          rw [hs, hm', Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
      let e_ring : L ≃+* SM' :=
        { fwd_ring with
          invFun := bwd_alg.toRingHom
          left_inv := fun x => RingHom.congr_fun h_comp1 x
          right_inv := fun y => RingHom.congr_fun h_comp2 y }
      let e_alg : L ≃ₐ[SM] SM' :=
        AlgEquiv.ofRingEquiv (f := e_ring)
          (fun z => IsLocalization.Away.lift_eq (S := L) t_SM ht_unit_SM' z)
      exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers t_SM) e_alg

    let R_bar₀ := TensorProduct R₁ k M₀
    let R_bar₁ := TensorProduct R₁ k M₁
    let R_bar₀₁ := TensorProduct R₁ k M₀₁
    let t_bar₀ : R_bar₀ := TensorProduct.tmul R₁ (1 : k) t₀
    let t_bar₁ : R_bar₁ := TensorProduct.tmul R₁ (1 : k) t₁
    let ρ_bar₀ : R_bar₀ →+* R_bar₀₁ := (Algebra.TensorProduct.map (AlgHom.id R₁ k) ρ₀).toRingHom
    let ρ_bar₁ : R_bar₁ →+* R_bar₀₁ := (Algebra.TensorProduct.map (AlgHom.id R₁ k) ρ₁).toRingHom
    have hLoc_bar₀ : @IsLocalization.Away R_bar₀ _ t_bar₀ R_bar₀₁ _ ρ_bar₀.toAlgebra :=
      hLocTensor t₀ ρ₀ hLoc₀
    have hLoc_bar₁ : @IsLocalization.Away R_bar₁ _ t_bar₁ R_bar₀₁ _ ρ_bar₁.toAlgebra :=
      hLocTensor t₁ ρ₁ hLoc₁
    have ht_bar₀₁ : ρ_bar₀ t_bar₀ * ρ_bar₁ t_bar₁ = 1 := by
      change TensorProduct.tmul R₁ (1 : k) (ρ₀ t₀) * TensorProduct.tmul R₁ (1 : k) (ρ₁ t₁) = 1
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ht₀₁]
      rfl

    have hmap_τB₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R₁.toRingHom) ≫ map_R₁B₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ k)) := by
      dsimp [map_R₁B₀]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, τ_R₁.comp_algebraMap]
    have hcomm_C₀_B₀ : ι_C₀_R₁ ≫ f_YR₁ =
        (C₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R₁.toRingHom)) ≫ map_R₁B₀ := by
      rw [CategoryTheory.Category.assoc, hmap_τB₀]
      exact hPb_C₀_R₁.w
    let i_C₀_B₀ : C₀.left ⟶ Y_B₀ :=
      CategoryTheory.Limits.pullback.lift ι_C₀_R₁
        (C₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R₁.toRingHom)) hcomm_C₀_B₀
    have hi_C₀_B₀_fst : i_C₀_B₀ ≫ p_YB₀_R₁ = ι_C₀_R₁ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hi_C₀_B₀_snd : i_C₀_B₀ ≫ f_B₀ =
        C₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R₁.toRingHom) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_C₀_B₀ : CategoryTheory.IsPullback i_C₀_B₀ C₀.hom f_B₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R₁.toRingHom)) :=
      CategoryTheory.IsPullback.of_right
        (by rw [hi_C₀_B₀_fst, hmap_τB₀]; exact hPb_C₀_R₁)
        hi_C₀_B₀_snd
        hPb_YB₀

    let j₀_k := chart₀ k C₀.left ι_C₀_R₁ C₀.hom hPb_C₀_R₁
    let j₁_k := chart₁ k C₀.left ι_C₀_R₁ C₀.hom hPb_C₀_R₁
    obtain ⟨hOpen_j₀k, hOpen_j₁k, hCov_k, hPb_k⟩ := hAtlas k C₀.left ι_C₀_R₁ C₀.hom hPb_C₀_R₁
    haveI : AlgebraicGeometry.IsOpenImmersion j₀_k := hOpen_j₀k
    haveI : AlgebraicGeometry.IsOpenImmersion j₁_k := hOpen_j₁k
    obtain ⟨hPb_j₀k, hPb_j₁k⟩ :=
      hAtlasNat B₀ k τ_R₁ Y_B₀ p_YB₀_R₁ f_B₀ hPb_YB₀ C₀.left ι_C₀_R₁ C₀.hom hPb_C₀_R₁
        i_C₀_B₀ hi_C₀_B₀_fst hi_C₀_B₀_snd

    obtain ⟨ν₀, ι_tilde₀, ι_tilde₁, hSurj_ν₀, hOpen_tilde₀, hOpen_tilde₁,
      hRange_tilde₀, hRange_tilde₁⟩ :=
      hSpecFib k τ_R₁ C₀.left i_C₀_B₀ C₀.hom hPb_C₀_B₀ j₀_k j₁_k hPb_j₀k hPb_j₁k
    haveI : AlgebraicGeometry.Surjective ν₀ := hSurj_ν₀

    let τ₀ : TensorProduct R₁ B₀ M₀ →+* R_bar₀ :=
      (Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M₀)).toRingHom
    let τ₁ : TensorProduct R₁ B₀ M₁ →+* R_bar₁ :=
      (Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M₁)).toRingHom
    let τ₀₁ : TensorProduct R₁ B₀ M₀₁ →+* R_bar₀₁ :=
      (Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M₀₁)).toRingHom
    have hτ₀₁_ι₀ : ∀ x : TensorProduct R₁ B₀ M₀,
        τ₀₁ ((Algebra.TensorProduct.map (AlgHom.id R₁ B₀) ρ₀).toRingHom x) = ρ_bar₀ (τ₀ x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul b m => rfl
      | add x y ihx ihy => rw [map_add, map_add, map_add, map_add, ihx, ihy]
    have hτ₀₁_ι₁ : ∀ y : TensorProduct R₁ B₀ M₁,
        τ₀₁ ((Algebra.TensorProduct.map (AlgHom.id R₁ B₀) ρ₁).toRingHom y) = ρ_bar₁ (τ₁ y) := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul b m => rfl
      | add x y ihx ihy => rw [map_add, map_add, map_add, map_add, ihx, ihy]

    let f_bar₀ : Fin m₀ → R_bar₀ := fun r => Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M₀) (f₀_B r)
    let q_bar₀ : Fin m₀ → R_bar₀ := fun r => τ₀ (q₀_B r)
    let U_bar₀ : Fin m₀ → R_bar₀ := fun r => Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M₀) (U₀_B r)
    let V_bar₀ : Fin m₀ → R_bar₀ := fun r => τ₀ (V₀_B r)
    let G_bar₀₀ : Fin m₀ → Fin m₀ → R_bar₀ := fun r r' => τ₀ (G₀₀_B r r')
    let G'_bar₀₀ : Fin m₀ → Fin m₀ → R_bar₀ := fun r r' => τ₀ (G'₀₀_B r r')
    let f_bar₁ : Fin m₁ → R_bar₁ := fun s => Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M₁) (f₁_B s)
    let q_bar₁ : Fin m₁ → R_bar₁ := fun s => τ₁ (q₁_B s)
    let U_bar₁ : Fin m₁ → R_bar₁ := fun s => Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M₁) (U₁_B s)
    let V_bar₁ : Fin m₁ → R_bar₁ := fun s => τ₁ (V₁_B s)
    let G_bar₁₁ : Fin m₁ → Fin m₁ → R_bar₁ := fun s s' => τ₁ (G₁₁_B s s')
    let G'_bar₁₁ : Fin m₁ → Fin m₁ → R_bar₁ := fun s s' => τ₁ (G'₁₁_B s s')
    let G_bar₀₁ : Fin m₀ → Fin m₁ → R_bar₀₁ := fun r s => τ₀₁ (G₀₁_B r s)
    let G'_bar₀₁ : Fin m₀ → Fin m₁ → R_bar₀₁ := fun r s => τ₀₁ (G'₀₁_B r s)

    obtain ⟨hEq1_B, hEq2_B, hEq3_B, hEq4_B, hEq5_B, hEq6_B, hEq7_B, hEq8_B,
      hEq9_B, hEq10_B, hEq11_B, hEq12_B, hEq13_B, hEq14_B, hEq15_B, hEq16_B⟩ := hEqsB

    have hEqs_k :
        (∑ r : Fin m₀, q_bar₀ r * f_bar₀ r) = 1 ∧
        (∑ s : Fin m₁, q_bar₁ s * f_bar₁ s) = 1 ∧
        (∀ r : Fin m₀, U_bar₀ r * V_bar₀ r = (f_bar₀ r) ^ d_u) ∧
        (∀ s : Fin m₁, U_bar₁ s * V_bar₁ s = (f_bar₁ s) ^ d_u) ∧
        (∀ r : Fin m₀, G_bar₀₀ r r = (f_bar₀ r * f_bar₀ r) ^ e) ∧
        (∀ s : Fin m₁, G_bar₁₁ s s = (f_bar₁ s * f_bar₁ s) ^ e) ∧
        (∀ r r' : Fin m₀, G_bar₀₀ r r' * G'_bar₀₀ r r' = (f_bar₀ r * f_bar₀ r') ^ (2 * e)) ∧
        (∀ s s' : Fin m₁, G_bar₁₁ s s' * G'_bar₁₁ s s' = (f_bar₁ s * f_bar₁ s') ^ (2 * e)) ∧
        (∀ (r : Fin m₀) (s : Fin m₁),
          G_bar₀₁ r s * G'_bar₀₁ r s = (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)) ^ (2 * e)) ∧
        (∀ r r' : Fin m₀,
          (G_bar₀₀ r r') ^ ℓ * U_bar₀ r' = (f_bar₀ r * f_bar₀ r') ^ (ℓ * e) * U_bar₀ r) ∧
        (∀ s s' : Fin m₁,
          (G_bar₁₁ s s') ^ ℓ * U_bar₁ s' = (f_bar₁ s * f_bar₁ s') ^ (ℓ * e) * U_bar₁ s) ∧
        (∀ (r : Fin m₀) (s : Fin m₁),
          (G_bar₀₁ r s) ^ ℓ * ρ_bar₁ (U_bar₁ s) =
            (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)) ^ (ℓ * e) * ρ_bar₀ (U_bar₀ r)) ∧
        (∀ r₁ r₂ r₃ : Fin m₀,
          (f_bar₀ r₁ * f_bar₀ r₂ * f_bar₀ r₃) ^ T_ann *
            (G_bar₀₀ r₁ r₂ * G_bar₀₀ r₂ r₃ - (f_bar₀ r₂) ^ (2 * e) * G_bar₀₀ r₁ r₃) = 0) ∧
        (∀ s₁ s₂ s₃ : Fin m₁,
          (f_bar₁ s₁ * f_bar₁ s₂ * f_bar₁ s₃) ^ T_ann *
            (G_bar₁₁ s₁ s₂ * G_bar₁₁ s₂ s₃ - (f_bar₁ s₂) ^ (2 * e) * G_bar₁₁ s₁ s₃) = 0) ∧
        (∀ (r₁ r₂ : Fin m₀) (s₃ : Fin m₁),
          (ρ_bar₀ (f_bar₀ r₁) * ρ_bar₀ (f_bar₀ r₂) * ρ_bar₁ (f_bar₁ s₃)) ^ T_ann *
            (ρ_bar₀ (G_bar₀₀ r₁ r₂) * G_bar₀₁ r₂ s₃ -
              (ρ_bar₀ (f_bar₀ r₂)) ^ (2 * e) * G_bar₀₁ r₁ s₃) = 0) ∧
        (∀ (r₁ : Fin m₀) (s₂ s₃ : Fin m₁),
          (ρ_bar₀ (f_bar₀ r₁) * ρ_bar₁ (f_bar₁ s₂) * ρ_bar₁ (f_bar₁ s₃)) ^ T_ann *
            (G_bar₀₁ r₁ s₂ * ρ_bar₁ (G_bar₁₁ s₂ s₃) -
              (ρ_bar₁ (f_bar₁ s₂)) ^ (2 * e) * G_bar₀₁ r₁ s₃) = 0) := by
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · have h := congrArg τ₀ hEq1_B
        simp only [map_sum, map_mul, map_one] at h
        exact h
      · have h := congrArg τ₁ hEq2_B
        simp only [map_sum, map_mul, map_one] at h
        exact h
      · intro r
        have h := congrArg τ₀ (hEq3_B r)
        simp only [map_mul, map_pow] at h
        exact h
      · intro s
        have h := congrArg τ₁ (hEq4_B s)
        simp only [map_mul, map_pow] at h
        exact h
      · intro r
        have h := congrArg τ₀ (hEq5_B r)
        simp only [map_mul, map_pow] at h
        exact h
      · intro s
        have h := congrArg τ₁ (hEq6_B s)
        simp only [map_mul, map_pow] at h
        exact h
      · intro r r'
        have h := congrArg τ₀ (hEq7_B r r')
        simp only [map_mul, map_pow] at h
        exact h
      · intro s s'
        have h := congrArg τ₁ (hEq8_B s s')
        simp only [map_mul, map_pow] at h
        exact h
      · intro r s
        have h := congrArg τ₀₁ (hEq9_B r s)
        simp only [map_mul, map_pow, hτ₀₁_ι₀, hτ₀₁_ι₁] at h
        exact h
      · intro r r'
        have h := congrArg τ₀ (hEq10_B r r')
        simp only [map_mul, map_pow] at h
        exact h
      · intro s s'
        have h := congrArg τ₁ (hEq11_B s s')
        simp only [map_mul, map_pow] at h
        exact h
      · intro r s
        have h := congrArg τ₀₁ (hEq12_B r s)
        simp only [map_mul, map_pow, hτ₀₁_ι₀, hτ₀₁_ι₁] at h
        exact h
      · intro r₁ r₂ r₃
        have h := congrArg τ₀ (hEq13_B r₁ r₂ r₃)
        simp only [map_mul, map_pow, map_sub, map_zero] at h
        exact h
      · intro s₁ s₂ s₃
        have h := congrArg τ₁ (hEq14_B s₁ s₂ s₃)
        simp only [map_mul, map_pow, map_sub, map_zero] at h
        exact h
      · intro r₁ r₂ s₃
        have h := congrArg τ₀₁ (hEq15_B r₁ r₂ s₃)
        simp only [map_mul, map_pow, map_sub, map_zero, hτ₀₁_ι₀, hτ₀₁_ι₁] at h
        exact h
      · intro r₁ s₂ s₃
        have h := congrArg τ₀₁ (hEq16_B r₁ s₂ s₃)
        simp only [map_mul, map_pow, map_sub, map_zero, hτ₀₁_ι₀, hτ₀₁_ι₁] at h
        exact h

    have hMapComp : ∀ {M : Type u} [CommRing M] [Algebra R₁ M]
        (x : TensorProduct R₁ B₀ M),
        Algebra.TensorProduct.map τ_A_R₁ (AlgHom.id R₁ M)
          (Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M) x) =
        Algebra.TensorProduct.map τ_R₁ (AlgHom.id R₁ M) x := by
      intro M _ _ x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul b m =>
        change TensorProduct.tmul R₁ (τ_A_R₁ (ψ_R₁ b)) m = TensorProduct.tmul R₁ (τ_R₁ b) m
        have hb : τ_A_R₁ (ψ_R₁ b) = τ_R₁ b := by
          change τ_A (ψ_R₁.toRingHom b) = τ_B₀ b
          rw [hψR₁_eq]
          exact AlgHom.congr_fun hτA_ψBA b
        rw [hb]
      | add x y ihx ihy => simp only [map_add, ihx, ihy]

    have hNoCoboundary : ¬ ∃ (v₀ : ∀ r : Fin m₀, Units (Localization.Away (f_bar₀ r)))
        (v₁ : ∀ s : Fin m₁, Units (Localization.Away (f_bar₁ s))),
      (∀ (r r' : Fin m₀)
         (ψ_L : Localization.Away (f_bar₀ r) →+* Localization.Away (f_bar₀ r * f_bar₀ r'))
         (ψ_R : Localization.Away (f_bar₀ r') →+* Localization.Away (f_bar₀ r * f_bar₀ r')),
         ψ_L.comp (algebraMap R_bar₀ (Localization.Away (f_bar₀ r))) =
           algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r')) →
         ψ_R.comp (algebraMap R_bar₀ (Localization.Away (f_bar₀ r'))) =
           algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r')) →
         algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r'))
           ((f_bar₀ r * f_bar₀ r') ^ e) * ψ_L (v₀ r).1 =
         algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r')) (G_bar₀₀ r r') *
           ψ_R (v₀ r').1) ∧
      (∀ (s s' : Fin m₁)
         (ψ_L : Localization.Away (f_bar₁ s) →+* Localization.Away (f_bar₁ s * f_bar₁ s'))
         (ψ_R : Localization.Away (f_bar₁ s') →+* Localization.Away (f_bar₁ s * f_bar₁ s')),
         ψ_L.comp (algebraMap R_bar₁ (Localization.Away (f_bar₁ s))) =
           algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s')) →
         ψ_R.comp (algebraMap R_bar₁ (Localization.Away (f_bar₁ s'))) =
           algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s')) →
         algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s'))
           ((f_bar₁ s * f_bar₁ s') ^ e) * ψ_L (v₁ s).1 =
         algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s')) (G_bar₁₁ s s') *
           ψ_R (v₁ s').1) ∧
      (∀ (r : Fin m₀) (s : Fin m₁)
         (ψ_L : Localization.Away (f_bar₀ r) →+*
           Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)))
         (ψ_R : Localization.Away (f_bar₁ s) →+*
           Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s))),
         ψ_L.comp (algebraMap R_bar₀ (Localization.Away (f_bar₀ r))) =
