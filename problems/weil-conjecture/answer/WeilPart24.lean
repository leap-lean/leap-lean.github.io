            (congrArg AlgebraicGeometry.Spec.map hu_alg)

  have hhV_B₀_k : h_V_B₀ ≫ p_V₀ = p_V_next := by
    rw [← hg_B₀_k]
    exact (CategoryTheory.Category.assoc h_V_B₀ g_B₀ p_V_cur).symm.trans
      (CategoryTheory.Category.assoc h_V_sch (Fgt_V.obj P_cur.V).hom E.V_bar.hom)

  obtain ⟨s_next, hs_next_sec, hs_next_range⟩ :=
    hSecOfClosed V_next_sch p_V_next v_next hv_next_cl
  have hs_next_B₀ : s_next ≫ h_V_B₀ = s_B₀_pt := by
    refine hSecEq V₀ p_V₀ (s_next ≫ h_V_B₀) s_B₀_pt ?_ hs_B₀_sec ?_
    · rw [CategoryTheory.Category.assoc, hhV_B₀_k]
      exact hs_next_sec
    · rw [hRangeSingletonComp s_next h_V_B₀ v_next hs_next_range, hhV_B₀_v, hs_B₀_range]

  have hPb_snext : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst f_next s_next ≫ q_raw)
      (CategoryTheory.Limits.pullback.snd f_next s_next)
      f_raw s_B₀_pt := by
    rw [← hs_next_B₀]
    exact (CategoryTheory.IsPullback.of_hasPullback f_next s_next).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback f_raw h_V_B₀)
  have hConn_fib₀ : ConnectedSpace ↥(CategoryTheory.Limits.pullback f_next s_next) :=
    hConnOfIso hPb_snext.isoPullback (hConnOfIrred hIrred_raw₀)
