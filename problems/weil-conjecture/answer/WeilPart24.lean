      (W_next_open : Set ↥Y_next) = (⋃ a : Fin m_next, Set.range (τ_next a).base)ᶜ := by
    rwa [hW_open_eq] at hW_compl_raw
  have hAff_Wopen_next : AlgebraicGeometry.IsAffineOpen W_next_open := by
    rwa [hW_open_eq] at hAff_Wopen_raw
  have : AlgebraicGeometry.IsAffine W_next_open.toScheme := hAff_Wopen_next

  let τ₀ : V_next_sch ⟶ Y_next := τ_next ⟨0, hm_next_pos⟩
  have hτ₀_sec : τ₀ ≫ f_next = 𝟙 V_next_sch := hτ_next_sec ⟨0, hm_next_pos⟩

  
  let p_V_cur : V_cur ⟶ S_k := (Fgt_V.obj P_cur.V).hom ≫ E.V_bar.hom
  let p_V_next : V_next_sch ⟶ S_k := (Fgt_V.obj V_next).hom ≫ E.V_bar.hom
