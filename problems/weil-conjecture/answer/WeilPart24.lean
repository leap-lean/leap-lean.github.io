  have hrt_pow : ∀ (T : Type u) [CommRing T] (v : T),
      (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C v)) ^ ℓ =
        algebraMap T (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C v)) v := by
    intro T _ v
    have h0 := AdjoinRoot.eval₂_root (Polynomial.X ^ ℓ - Polynomial.C v)
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h0
    exact h0
  let φ₂ : S₀ →ₐ[R₀] B₀₀ :=
    (IsScalarTower.toAlgHom R₀ T₀₀ B₀₀).comp
      (Algebra.TensorProduct.includeRight : S₀ →ₐ[R₀] T₀₀)
  let φ₁ : S₀ →ₐ[R₀] B₀₀ :=
    (IsScalarTower.toAlgHom R₀ T₀₀ B₀₀).comp
      (Algebra.TensorProduct.includeLeft : S₀ →ₐ[R₀] T₀₀)
  have h_ι₂_cond : Polynomial.eval₂ φ₂.toRingHom (AdjoinRoot.root p₀₀) p₀ = 0 := by
    dsimp [p₀, φ₂]
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero]
    exact hrt_pow T₀₀ ((1 : S₀) ⊗ₜ[R₀] (v₀ : S₀))
  let x₁_B₀₀ : B₀₀ := algebraMap T₀₀ B₀₀ (↑g₀₀⁻¹ : T₀₀) * AdjoinRoot.root p₀₀
  have h_ι₁_cond : Polynomial.eval₂ φ₁.toRingHom x₁_B₀₀ p₀ = 0 := by
    dsimp [p₀, φ₁, x₁_B₀₀]
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero,
      mul_pow, ← map_pow, hrt_pow T₀₀ ((1 : S₀) ⊗ₜ[R₀] (v₀ : S₀)), ← map_mul, hg₀₀_inv_pow]
    rfl
  let ι₂ : B₀ →ₐ[R₀] B₀₀ := AdjoinRoot.liftAlgHom p₀ φ₂ (AdjoinRoot.root p₀₀) h_ι₂_cond
  let ι₁ : B₀ →ₐ[R₀] B₀₀ := AdjoinRoot.liftAlgHom p₀ φ₁ x₁_B₀₀ h_ι₁_cond
  let A₀_sub : Subalgebra R₀ B₀ := AlgHom.equalizer ι₂ ι₁
  let A₀ : Type u := ↥A₀_sub
  obtain ⟨eB₀, heB₀⟩ := h_basis S₀ (v₀ : S₀)
  obtain ⟨eB₀₀, heB₀₀⟩ := h_basis T₀₀ ((1 : S₀) ⊗ₜ[R₀] (v₀ : S₀))
  have h_mem_A₀ : ∀ x : Fin ℓ → S₀,
      eB₀ x ∈ A₀_sub ↔
        ∀ j : Fin ℓ, ((1 : S₀) ⊗ₜ[R₀] (x j) : T₀₀) =
          (↑((g₀₀⁻¹) ^ (j : ℕ)) : T₀₀) * ((x j) ⊗ₜ[R₀] (1 : S₀)) := by
    intro x
    change ι₂ (eB₀ x) = ι₁ (eB₀ x) ↔ _
    have h₂ : ι₂ (eB₀ x) = eB₀₀ (fun j => (1 : S₀) ⊗ₜ[R₀] (x j)) := by
      rw [heB₀ x, heB₀₀, map_sum]
      refine Finset.sum_congr rfl ?_
      intro j _
      rw [map_mul, map_pow]
      have h_of : ι₂ (algebraMap S₀ B₀ (x j)) = algebraMap T₀₀ B₀₀ ((1 : S₀) ⊗ₜ[R₀] (x j)) :=
        AdjoinRoot.liftAlgHom_of p₀ φ₂ (AdjoinRoot.root p₀₀) h_ι₂_cond (x j)
      have h_rt : ι₂ (AdjoinRoot.root p₀) = AdjoinRoot.root p₀₀ :=
        AdjoinRoot.liftAlgHom_root p₀ φ₂ (AdjoinRoot.root p₀₀) h_ι₂_cond
      rw [h_of, h_rt]
    have h₁ : ι₁ (eB₀ x) = eB₀₀ (fun j =>
        (↑((g₀₀⁻¹) ^ (j : ℕ)) : T₀₀) * ((x j) ⊗ₜ[R₀] (1 : S₀))) := by
      rw [heB₀ x, heB₀₀, map_sum]
      refine Finset.sum_congr rfl ?_
      intro j _
      rw [map_mul, map_pow]
      have h_of : ι₁ (algebraMap S₀ B₀ (x j)) = algebraMap T₀₀ B₀₀ ((x j) ⊗ₜ[R₀] (1 : S₀)) :=
        AdjoinRoot.liftAlgHom_of p₀ φ₁ x₁_B₀₀ h_ι₁_cond (x j)
      have h_rt : ι₁ (AdjoinRoot.root p₀) = x₁_B₀₀ :=
        AdjoinRoot.liftAlgHom_root p₀ φ₁ x₁_B₀₀ h_ι₁_cond
      rw [h_of, h_rt]
      dsimp [x₁_B₀₀]
      rw [mul_pow, ← mul_assoc, ← map_pow, ← map_mul, mul_comm ((x j) ⊗ₜ[R₀] (1 : S₀))]
      rfl
    rw [h₂, h₁]
    exact ⟨fun h j => congrFun (eB₀₀.injective h) j,
      fun h => congrArg eB₀₀ (funext h)⟩
  have h_L_exists : ∃ (L : Fin ℓ → Type u)
      (instAdd : ∀ j, AddCommGroup (L j))
      (instMod : ∀ j, Module R₀ (L j)),
      letI : ∀ j, AddCommGroup (L j) := instAdd
      letI : ∀ j, Module R₀ (L j) := instMod
      ∃ (instInv : ∀ j, Module.Invertible R₀ (L j))
        (eL : ∀ j, TensorProduct R₀ S₀ (L j) ≃ₗ[S₀] S₀)
        (σ : ∀ j, L j →ₗ[R₀] S₀),
        (∀ (j : Fin ℓ) (s : S₀) (z : L j), eL j (s ⊗ₜ[R₀] z) = s * σ j z) ∧
        (∀ (j : Fin ℓ) (z : L j),
          ((1 : S₀) ⊗ₜ[R₀] (σ j z) : T₀₀) =
            (↑((g₀₀⁻¹) ^ (j : ℕ)) : T₀₀) * ((σ j z) ⊗ₜ[R₀] (1 : S₀))) ∧
        (∀ j : Fin ℓ, Function.Injective (σ j)) ∧
        (∀ (j : Fin ℓ) (t : S₀),
          ((1 : S₀) ⊗ₜ[R₀] t : T₀₀) =
            (↑((g₀₀⁻¹) ^ (j : ℕ)) : T₀₀) * (t ⊗ₜ[R₀] (1 : S₀)) →
          ∃ z : L j, σ j z = t) := by
    have h_each : ∀ j : Fin ℓ,
        ∃ (Lj : Type u) (_ : AddCommGroup Lj) (_ : Module R₀ Lj) (_ : Module.Invertible R₀ Lj)
          (ej : TensorProduct R₀ S₀ Lj ≃ₗ[S₀] S₀),
          (∀ z : Lj, ((1 : S₀) ⊗ₜ[R₀] (ej ((1 : S₀) ⊗ₜ[R₀] z)) : T₀₀) =
            (↑((g₀₀⁻¹) ^ (j : ℕ)) : T₀₀) * ((ej ((1 : S₀) ⊗ₜ[R₀] z)) ⊗ₜ[R₀] (1 : S₀))) ∧
          Function.Injective (fun z : Lj => ej ((1 : S₀) ⊗ₜ[R₀] z)) ∧
          (∀ t : S₀, ((1 : S₀) ⊗ₜ[R₀] t : T₀₀) =
            (↑((g₀₀⁻¹) ^ (j : ℕ)) : T₀₀) * (t ⊗ₜ[R₀] (1 : S₀)) →
            ∃ z : Lj, ej ((1 : S₀) ⊗ₜ[R₀] z) = t) :=
      fun j => hH90_split.1 R₀ S₀ ((g₀₀⁻¹) ^ (j : ℕ)) (hC1_inv_pow (j : ℕ))
    let L := fun j => Classical.choose (h_each j)
    let s1 := fun j => Classical.choose_spec (h_each j)
    let instAdd : ∀ j, AddCommGroup (L j) := fun j => Classical.choose (s1 j)
    let s2 := fun j => Classical.choose_spec (s1 j)
    let instMod : ∀ j, Module R₀ (L j) := fun j => Classical.choose (s2 j)
    let s3 := fun j => Classical.choose_spec (s2 j)
    let instInv : ∀ j, Module.Invertible R₀ (L j) := fun j => Classical.choose (s3 j)
    let s4 := fun j => Classical.choose_spec (s3 j)
    let eL : ∀ j, TensorProduct R₀ S₀ (L j) ≃ₗ[S₀] S₀ := fun j => Classical.choose (s4 j)
    have hs4 := fun j => Classical.choose_spec (s4 j)
    let σ : ∀ j, L j →ₗ[R₀] S₀ := fun j =>
      (eL j).toLinearMap.restrictScalars R₀ ∘ₗ
        (TensorProduct.mk R₀ S₀ (L j) (1 : S₀))
    refine ⟨L, instAdd, instMod, instInv, eL, σ, ?_, ?_, ?_, ?_⟩
    · intro j s z
      have h_smul : (s ⊗ₜ[R₀] z : TensorProduct R₀ S₀ (L j)) = s • ((1 : S₀) ⊗ₜ[R₀] z) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h_smul, map_smul, smul_eq_mul]
      rfl
    · intro j z
      exact (hs4 j).1 z
    · intro j
      exact (hs4 j).2.1
    · intro j t ht
      exact (hs4 j).2.2 t ht
  obtain ⟨L, instAddL, instModL, instInvL, eL, σ, heL_tmul, hσ_coc, hσ_inj, hσ_surj⟩ := h_L_exists
  let ξ_map : (∀ j : Fin ℓ, L j) →ₗ[R₀] A₀ :=
    { toFun := fun z => ⟨eB₀ (fun j => σ j (z j)), (h_mem_A₀ _).mpr (fun j => hσ_coc j (z j))⟩
      map_add' := fun z₁ z₂ => Subtype.ext (by
        change eB₀ (fun j => σ j ((z₁ + z₂) j)) =
          eB₀ (fun j => σ j (z₁ j)) + eB₀ (fun j => σ j (z₂ j))
        have hfun : (fun j => σ j ((z₁ + z₂) j)) =
            (fun j => σ j (z₁ j)) + (fun j => σ j (z₂ j)) := by
          ext j; exact map_add (σ j) (z₁ j) (z₂ j)
        rw [hfun, map_add])
      map_smul' := fun r z => Subtype.ext (by
        change eB₀ (fun j => σ j ((r • z) j)) = r • eB₀ (fun j => σ j (z j))
        have hfun : (fun j => σ j ((r • z) j)) = r • (fun j => σ j (z j)) := by
          ext j; simp [Algebra.smul_def]
        rw [hfun]
        have hr_eq : (r • (fun j => σ j (z j)) : Fin ℓ → S₀) =
            (algebraMap R₀ S₀ r) • (fun j => σ j (z j)) := by
          ext j; exact Algebra.smul_def r (σ j (z j))
        rw [hr_eq, map_smul, IsScalarTower.algebraMap_smul]) }
  have hξ_bij : Function.Bijective ξ_map := by
    refine ⟨?_, ?_⟩
    · intro z₁ z₂ hz
      have heq := eB₀.injective (congrArg Subtype.val hz)
      ext j
      exact hσ_inj j (congrFun heq j)
    · intro a
      let x : Fin ℓ → S₀ := eB₀.symm a.1
      have hx_eq : eB₀ x = a.1 := eB₀.apply_symm_apply a.1
      have hx_mem : ∀ j : Fin ℓ, ((1 : S₀) ⊗ₜ[R₀] (x j) : T₀₀) =
          (↑((g₀₀⁻¹) ^ (j : ℕ)) : T₀₀) * ((x j) ⊗ₜ[R₀] (1 : S₀)) :=
        (h_mem_A₀ x).mp (hx_eq.symm ▸ a.2)
      let z : ∀ j : Fin ℓ, L j := fun j => Classical.choose (hσ_surj j (x j) (hx_mem j))
      have hz : ∀ j : Fin ℓ, σ j (z j) = x j :=
        fun j => Classical.choose_spec (hσ_surj j (x j) (hx_mem j))
      refine ⟨z, Subtype.ext ?_⟩
      change eB₀ (fun j => σ j (z j)) = a.1
      rw [funext hz, hx_eq]
  let Ξ₀ : (∀ j : Fin ℓ, L j) ≃ₗ[R₀] A₀ := LinearEquiv.ofBijective ξ_map hξ_bij
  have hFinA₀ : Module.Finite R₀ A₀ := Module.Finite.equiv Ξ₀
  let e_S₀_A₀ : TensorProduct R₀ S₀ A₀ ≃ₗ[S₀] (Fin ℓ → S₀) :=
    (LinearEquiv.baseChange R₀ S₀ A₀ (∀ j : Fin ℓ, L j) Ξ₀.symm).trans
      ((TensorProduct.piRight R₀ S₀ S₀ L).trans (LinearEquiv.piCongrRight eL))
  have : Module.Flat S₀ (TensorProduct R₀ S₀ A₀) :=
    Module.Flat.of_linearEquiv e_S₀_A₀
  have hFlatA₀ : Module.Flat R₀ A₀ :=
    Module.Flat.of_flat_tensorProduct R₀ A₀ S₀
  have hFFA₀ : Module.FaithfullyFlat R₀ A₀ := by
    let j₀ : Fin ℓ := ⟨0, hPrime.pos⟩
    have hc₀_inv : ∀ a : A₀,
        ((1 : S₀) ⊗ₜ[R₀] (eB₀.symm a.1 j₀) : T₀₀) = (eB₀.symm a.1 j₀) ⊗ₜ[R₀] (1 : S₀) := by
      intro a
      have hx : eB₀ (eB₀.symm a.1) ∈ A₀_sub := (eB₀.apply_symm_apply a.1).symm ▸ a.2
      have hj₀ := (h_mem_A₀ (eB₀.symm a.1)).mp hx j₀
      change ((1 : S₀) ⊗ₜ[R₀] (eB₀.symm a.1 j₀) : T₀₀) =
        (↑((g₀₀⁻¹) ^ (0 : ℕ)) : T₀₀) * ((eB₀.symm a.1 j₀) ⊗ₜ[R₀] (1 : S₀)) at hj₀
      simpa using hj₀
    have h_proj₀_ex : ∃ proj₀ : A₀ →ₗ[R₀] R₀, proj₀ (1 : A₀) = (1 : R₀) := by
      let c₀ : A₀ →ₗ[R₀] S₀ :=
        ((LinearMap.proj j₀ : (Fin ℓ → S₀) →ₗ[S₀] S₀).restrictScalars R₀).comp
          ((eB₀.symm.toLinearMap.restrictScalars R₀).comp A₀_sub.val.toLinearMap)
      let p_fun : A₀ → R₀ := fun a => Classical.choose ((h_amitsur R₀ S₀).2.1 (c₀ a) (hc₀_inv a))
      have hp_spec : ∀ a : A₀, algebraMap R₀ S₀ (p_fun a) = c₀ a :=
        fun a => Classical.choose_spec ((h_amitsur R₀ S₀).2.1 (c₀ a) (hc₀_inv a))
      have h_inj₀ : Function.Injective (algebraMap R₀ S₀) := (h_amitsur R₀ S₀).1
      let proj₀ : A₀ →ₗ[R₀] R₀ :=
        { toFun := p_fun
          map_add' := fun a₁ a₂ => h_inj₀ (by rw [hp_spec, map_add, map_add, hp_spec, hp_spec])
          map_smul' := fun r a => h_inj₀ (by
            rw [RingHom.id_apply, smul_eq_mul, map_mul, hp_spec, hp_spec,
              LinearMap.map_smul, Algebra.smul_def]) }
      have heB₀_one : eB₀ (Pi.single j₀ (1 : S₀)) = (1 : B₀) := by
        rw [heB₀, Finset.sum_eq_single j₀]
        · simp [j₀]
        · intro j _ hj
          simp [Pi.single_eq_of_ne hj]
        · intro hj₀_abs
          exact False.elim (hj₀_abs (Finset.mem_univ j₀))
      have hc₀_one : c₀ (1 : A₀) = (1 : S₀) := by
        change eB₀.symm (1 : B₀) j₀ = (1 : S₀)
        rw [← heB₀_one, eB₀.symm_apply_apply, Pi.single_eq_same]
      refine ⟨proj₀, h_inj₀ ?_⟩
      change algebraMap R₀ S₀ (p_fun (1 : A₀)) = algebraMap R₀ S₀ (1 : R₀)
      rw [hp_spec, hc₀_one, map_one]
    obtain ⟨proj₀, hproj₀_one⟩ := h_proj₀_ex
    rw [Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top]
    refine ⟨hFlatA₀, ?_⟩
    intro I hI
    rw [Ideal.eq_top_iff_one, ← hproj₀_one]
    have h1_mem : (1 : A₀) ∈ I • (⊤ : Submodule R₀ A₀) := by
      rw [hI]; exact Submodule.mem_top
    refine Submodule.smul_induction_on h1_mem ?_ ?_
    · intro r hr a _
      rw [proj₀.map_smul, smul_eq_mul]
      exact Ideal.mul_mem_right _ I hr
    · intro x y hx hy
      rw [map_add]
      exact I.add_mem hx hy
  
  let j₁ : Fin ℓ := ⟨1, hPrime.one_lt⟩
  have h_dual_ex : ∃ (n_d : ℕ) (y_d : Fin n_d → S₀) (x_d : Fin n_d → L j₁),
      (∀ k : Fin n_d, ((1 : S₀) ⊗ₜ[R₀] (y_d k) : T₀₀) =
        (g₀₀ : T₀₀) * ((y_d k) ⊗ₜ[R₀] (1 : S₀))) ∧
      Finset.univ.sum (fun k : Fin n_d => y_d k * σ j₁ (x_d k)) = (1 : S₀) := by
    obtain ⟨L_pos, instAddP, instModP, instInvP, e_pos, he_pos_coc, -, -⟩ :=
      hH90_split.1 R₀ S₀ g₀₀ hC1
    let σ_pos : L_pos →ₗ[R₀] S₀ :=
      e_pos.toLinearMap.restrictScalars R₀ ∘ₗ (TensorProduct.mk R₀ S₀ L_pos (1 : S₀))
    have he_pos_tmul : ∀ (s : S₀) (w : L_pos), e_pos (s ⊗ₜ[R₀] w) = s * σ_pos w := by
      intro s w
      have h_smul : (s ⊗ₜ[R₀] w : TensorProduct R₀ S₀ L_pos) = s • ((1 : S₀) ⊗ₜ[R₀] w) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [h_smul, map_smul, smul_eq_mul]; rfl
    have h_prod_inv : ∀ (w : L_pos) (x : L j₁),
        ((1 : S₀) ⊗ₜ[R₀] (σ_pos w * σ j₁ x) : T₀₀) = (σ_pos w * σ j₁ x) ⊗ₜ[R₀] (1 : S₀) := by
      intro w x
      have hw : ((1 : S₀) ⊗ₜ[R₀] (σ_pos w) : T₀₀) =
          (g₀₀ : T₀₀) * ((σ_pos w) ⊗ₜ[R₀] (1 : S₀)) := he_pos_coc w
      have hx : ((1 : S₀) ⊗ₜ[R₀] (σ j₁ x) : T₀₀) =
          (↑g₀₀⁻¹ : T₀₀) * ((σ j₁ x) ⊗ₜ[R₀] (1 : S₀)) := by
        simpa [j₁] using hσ_coc j₁ x
      calc
        ((1 : S₀) ⊗ₜ[R₀] (σ_pos w * σ j₁ x) : T₀₀)
            = ((1 : S₀) ⊗ₜ[R₀] (σ_pos w)) * ((1 : S₀) ⊗ₜ[R₀] (σ j₁ x)) := by
              simp [Algebra.TensorProduct.tmul_mul_tmul]
        _ = ((g₀₀ : T₀₀) * ((σ_pos w) ⊗ₜ[R₀] (1 : S₀))) *
              ((↑g₀₀⁻¹ : T₀₀) * ((σ j₁ x) ⊗ₜ[R₀] (1 : S₀))) := by
              rw [hw, hx]
        _ = ((g₀₀ : T₀₀) * (↑g₀₀⁻¹ : T₀₀)) *
              (((σ_pos w) ⊗ₜ[R₀] (1 : S₀)) * ((σ j₁ x) ⊗ₜ[R₀] (1 : S₀))) := by ring
        _ = (σ_pos w * σ j₁ x) ⊗ₜ[R₀] (1 : S₀) := by
              simp [Units.mul_inv, Algebra.TensorProduct.tmul_mul_tmul]
    have h_inj₀ : Function.Injective (algebraMap R₀ S₀) := (h_amitsur R₀ S₀).1
    let b_fun : L_pos → L j₁ → R₀ := fun w x =>
      Classical.choose ((h_amitsur R₀ S₀).2.1 (σ_pos w * σ j₁ x) (h_prod_inv w x))
    have hb_spec : ∀ (w : L_pos) (x : L j₁),
        algebraMap R₀ S₀ (b_fun w x) = σ_pos w * σ j₁ x := fun w x =>
      Classical.choose_spec ((h_amitsur R₀ S₀).2.1 (σ_pos w * σ j₁ x) (h_prod_inv w x))
    let B_dual : L_pos →ₗ[R₀] L j₁ →ₗ[R₀] R₀ :=
      LinearMap.mk₂ R₀ b_fun
        (fun w₁ w₂ x => h_inj₀ (by simp [hb_spec, map_add, add_mul]))
        (fun r w x => h_inj₀ (by simp [hb_spec, Algebra.smul_def, mul_assoc]))
        (fun w x₁ x₂ => h_inj₀ (by simp [hb_spec, map_add, mul_add]))
        (fun r w x => h_inj₀ (by simp [hb_spec, Algebra.smul_def, mul_left_comm]))
    let μ_dual : TensorProduct R₀ L_pos (L j₁) →ₗ[R₀] R₀ := TensorProduct.lift B_dual
    have h_range_top : LinearMap.range μ_dual = (⊤ : Ideal R₀) := by
      by_contra hI_ne
      obtain ⟨𝔪, h𝔪_max, hI_le⟩ := Ideal.exists_le_maximal (LinearMap.range μ_dual) hI_ne
      have h𝔪_top : 𝔪 • (⊤ : Submodule R₀ S₀) = ⊤ := by
        rw [eq_top_iff]
        intro t _
        obtain ⟨F₁, hF₁⟩ := TensorProduct.exists_finset (e_pos.symm (1 : S₀))
        obtain ⟨F₂, hF₂⟩ := TensorProduct.exists_finset ((eL j₁).symm (1 : S₀))
        have he₁ : (1 : S₀) = F₁.sum (fun p => p.1 * σ_pos p.2) := by
          calc
