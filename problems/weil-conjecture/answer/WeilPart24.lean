      hA13, hA14, hA15, hA16⟩
    obtain ⟨q0, w0, hw0⟩ := hEqFam (fun _ : Unit => ∑ r : Fin m₀, q₀_1 r * f₀_1 r)
      (fun _ : Unit => 1) (fun _ => by
        simp only [map_sum, map_mul, map_one, hq₀_1, hf₀_1]
        exact hA1)
    obtain ⟨q1, w1, hw1⟩ := hEqFam (fun _ : Unit => ∑ s : Fin m₁, q₁_1 s * f₁_1 s)
      (fun _ : Unit => 1) (fun _ => by
        simp only [map_sum, map_mul, map_one, hq₁_1, hf₁_1]
        exact hA2)
    obtain ⟨q2, w2, hw2⟩ := hEqFam (fun r : Fin m₀ => U₀_1 r * V₀_1 r)
      (fun r : Fin m₀ => (f₀_1 r) ^ d_u) (fun r => by
        simp only [map_mul, map_pow, hU₀_1, hV₀_1, hf₀_1]
        exact hA3 r)
    obtain ⟨q3, w3, hw3⟩ := hEqFam (fun s : Fin m₁ => U₁_1 s * V₁_1 s)
      (fun s : Fin m₁ => (f₁_1 s) ^ d_u) (fun s => by
        simp only [map_mul, map_pow, hU₁_1, hV₁_1, hf₁_1]
        exact hA4 s)
    obtain ⟨q4, w4, hw4⟩ := hEqFam (fun r : Fin m₀ => G₀₀_1 r r)
      (fun r : Fin m₀ => (f₀_1 r * f₀_1 r) ^ e) (fun r => by
        simp only [map_mul, map_pow, hG₀₀_1, hf₀_1]
        exact hA5 r)
    obtain ⟨q5, w5, hw5⟩ := hEqFam (fun s : Fin m₁ => G₁₁_1 s s)
      (fun s : Fin m₁ => (f₁_1 s * f₁_1 s) ^ e) (fun s => by
        simp only [map_mul, map_pow, hG₁₁_1, hf₁_1]
        exact hA6 s)
    obtain ⟨q6, w6, hw6⟩ := hEqFam (fun p : Fin m₀ × Fin m₀ => G₀₀_1 p.1 p.2 * G'₀₀_1 p.1 p.2)
      (fun p : Fin m₀ × Fin m₀ => (f₀_1 p.1 * f₀_1 p.2) ^ (2 * e)) (fun p => by
        simp only [map_mul, map_pow, hG₀₀_1, hG'₀₀_1, hf₀_1]
        exact hA7 p.1 p.2)
    obtain ⟨q7, w7, hw7⟩ := hEqFam (fun p : Fin m₁ × Fin m₁ => G₁₁_1 p.1 p.2 * G'₁₁_1 p.1 p.2)
      (fun p : Fin m₁ × Fin m₁ => (f₁_1 p.1 * f₁_1 p.2) ^ (2 * e)) (fun p => by
        simp only [map_mul, map_pow, hG₁₁_1, hG'₁₁_1, hf₁_1]
        exact hA8 p.1 p.2)
    obtain ⟨q8, w8, hw8⟩ := hEqFam (fun p : Fin m₀ × Fin m₁ => G₀₁_1 p.1 p.2 * G'₀₁_1 p.1 p.2)
      (fun p : Fin m₀ × Fin m₁ => (ι1₀ (f₀_1 p.1) * ι1₁ (f₁_1 p.2)) ^ (2 * e)) (fun p => by
        simp only [ι1₀, ι1₁, map_mul, map_pow, hG₀₁_1, hG'₀₁_1,
          hCrossComm (ι_colim i₁) ρ₀, hCrossComm (ι_colim i₁) ρ₁, hf₀_1, hf₁_1]
        exact hA9 p.1 p.2)
    obtain ⟨q9, w9, hw9⟩ := hEqFam
      (fun p : Fin m₀ × Fin m₀ => (G₀₀_1 p.1 p.2) ^ ℓ * U₀_1 p.2)
      (fun p : Fin m₀ × Fin m₀ => (f₀_1 p.1 * f₀_1 p.2) ^ (ℓ * e) * U₀_1 p.1) (fun p => by
        simp only [map_mul, map_pow, hG₀₀_1, hU₀_1, hf₀_1]
        exact hA10 p.1 p.2)
    obtain ⟨q10, w10, hw10⟩ := hEqFam
      (fun p : Fin m₁ × Fin m₁ => (G₁₁_1 p.1 p.2) ^ ℓ * U₁_1 p.2)
      (fun p : Fin m₁ × Fin m₁ => (f₁_1 p.1 * f₁_1 p.2) ^ (ℓ * e) * U₁_1 p.1) (fun p => by
        simp only [map_mul, map_pow, hG₁₁_1, hU₁_1, hf₁_1]
        exact hA11 p.1 p.2)
    obtain ⟨q11, w11, hw11⟩ := hEqFam
      (fun p : Fin m₀ × Fin m₁ => (G₀₁_1 p.1 p.2) ^ ℓ * ι1₁ (U₁_1 p.2))
      (fun p : Fin m₀ × Fin m₁ => (ι1₀ (f₀_1 p.1) * ι1₁ (f₁_1 p.2)) ^ (ℓ * e) * ι1₀ (U₀_1 p.1))
      (fun p => by
        simp only [ι1₀, ι1₁, map_mul, map_pow, hG₀₁_1,
          hCrossComm (ι_colim i₁) ρ₀, hCrossComm (ι_colim i₁) ρ₁, hU₁_1, hf₀_1, hf₁_1, hU₀_1]
        exact hA12 p.1 p.2)
    obtain ⟨q12, w12, hw12⟩ := hEqFam
      (fun t : Fin m₀ × Fin m₀ × Fin m₀ =>
        (f₀_1 t.1 * f₀_1 t.2.1 * f₀_1 t.2.2) ^ T_ann *
          (G₀₀_1 t.1 t.2.1 * G₀₀_1 t.2.1 t.2.2 - (f₀_1 t.2.1) ^ (2 * e) * G₀₀_1 t.1 t.2.2))
      (fun _ => 0) (fun t => by
        simp only [map_mul, map_pow, map_sub, map_zero, hf₀_1, hG₀₀_1]
        exact hA13 t.1 t.2.1 t.2.2)
    obtain ⟨q13, w13, hw13⟩ := hEqFam
      (fun t : Fin m₁ × Fin m₁ × Fin m₁ =>
        (f₁_1 t.1 * f₁_1 t.2.1 * f₁_1 t.2.2) ^ T_ann *
          (G₁₁_1 t.1 t.2.1 * G₁₁_1 t.2.1 t.2.2 - (f₁_1 t.2.1) ^ (2 * e) * G₁₁_1 t.1 t.2.2))
      (fun _ => 0) (fun t => by
        simp only [map_mul, map_pow, map_sub, map_zero, hf₁_1, hG₁₁_1]
        exact hA14 t.1 t.2.1 t.2.2)
    obtain ⟨q14, w14, hw14⟩ := hEqFam
      (fun t : Fin m₀ × Fin m₀ × Fin m₁ =>
        (ι1₀ (f₀_1 t.1) * ι1₀ (f₀_1 t.2.1) * ι1₁ (f₁_1 t.2.2)) ^ T_ann *
          (ι1₀ (G₀₀_1 t.1 t.2.1) * G₀₁_1 t.2.1 t.2.2 -
            (ι1₀ (f₀_1 t.2.1)) ^ (2 * e) * G₀₁_1 t.1 t.2.2))
      (fun _ => 0) (fun t => by
        simp only [ι1₀, ι1₁, map_mul, map_pow, map_sub, map_zero,
          hCrossComm (ι_colim i₁) ρ₀, hCrossComm (ι_colim i₁) ρ₁, hf₀_1, hf₁_1, hG₀₀_1, hG₀₁_1]
        exact hA15 t.1 t.2.1 t.2.2)
    obtain ⟨q15, w15, hw15⟩ := hEqFam
      (fun t : Fin m₀ × Fin m₁ × Fin m₁ =>
        (ι1₀ (f₀_1 t.1) * ι1₁ (f₁_1 t.2.1) * ι1₁ (f₁_1 t.2.2)) ^ T_ann *
          (G₀₁_1 t.1 t.2.1 * ι1₁ (G₁₁_1 t.2.1 t.2.2) -
            (ι1₁ (f₁_1 t.2.1)) ^ (2 * e) * G₀₁_1 t.1 t.2.2))
      (fun _ => 0) (fun t => by
        simp only [ι1₀, ι1₁, map_mul, map_pow, map_sub, map_zero,
          hCrossComm (ι_colim i₁) ρ₀, hCrossComm (ι_colim i₁) ρ₁, hf₀_1, hf₁_1, hG₁₁_1, hG₀₁_1]
        exact hA16 t.1 t.2.1 t.2.2)

    let tgt16 : (Bool × Bool) × (Bool × Bool) → ℐ
      | ((false, false), (false, false)) => q0
      | ((false, false), (false, true))  => q1
      | ((false, false), (true,  false)) => q2
      | ((false, false), (true,  true))  => q3
      | ((false, true),  (false, false)) => q4
      | ((false, true),  (false, true))  => q5
      | ((false, true),  (true,  false)) => q6
      | ((false, true),  (true,  true))  => q7
      | ((true,  false), (false, false)) => q8
      | ((true,  false), (false, true))  => q9
      | ((true,  false), (true,  false)) => q10
      | ((true,  false), (true,  true))  => q11
      | ((true,  true),  (false, false)) => q12
      | ((true,  true),  (false, true))  => q13
      | ((true,  true),  (true,  false)) => q14
      | ((true,  true),  (true,  true))  => q15
    let arr16 : ∀ c : (Bool × Bool) × (Bool × Bool), i₁ ⟶ tgt16 c
      | ((false, false), (false, false)) => w0
      | ((false, false), (false, true))  => w1
      | ((false, false), (true,  false)) => w2
      | ((false, false), (true,  true))  => w3
      | ((false, true),  (false, false)) => w4
      | ((false, true),  (false, true))  => w5
      | ((false, true),  (true,  false)) => w6
      | ((false, true),  (true,  true))  => w7
      | ((true,  false), (false, false)) => w8
      | ((true,  false), (false, true))  => w9
      | ((true,  false), (true,  false)) => w10
      | ((true,  false), (true,  true))  => w11
      | ((true,  true),  (false, false)) => w12
      | ((true,  true),  (false, true))  => w13
      | ((true,  true),  (true,  false)) => w14
      | ((true,  true),  (true,  true))  => w15
    obtain ⟨i_star, w_star, hw_star⟩ := hStarCoeq ((Bool × Bool) × (Bool × Bool)) i₁ tgt16 arr16
    have hAdv : ∀ {M : Type u} [CommRing M] [Algebra R₁ M]
        (c : (Bool × Bool) × (Bool × Bool))
        {x y : TensorProduct R₁ ↑(D_sh.obj i₁) M},
        Algebra.TensorProduct.map (φ_tr (arr16 c)) (AlgHom.id R₁ M) x =
          Algebra.TensorProduct.map (φ_tr (arr16 c)) (AlgHom.id R₁ M) y →
        Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M) x =
          Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M) y := by
      intro M _ _ c x y hxy
      obtain ⟨v, hv⟩ := hw_star c
      exact hPushEq (arr16 c) v hv hxy
    exact ⟨i_star, w_star,
      hAdv ((false, false), (false, false)) (hw0 ()),
      hAdv ((false, false), (false, true))  (hw1 ()),
      fun r => hAdv ((false, false), (true,  false)) (hw2 r),
      fun s => hAdv ((false, false), (true,  true))  (hw3 s),
      fun r => hAdv ((false, true),  (false, false)) (hw4 r),
      fun s => hAdv ((false, true),  (false, true))  (hw5 s),
      fun r r' => hAdv ((false, true),  (true,  false)) (hw6 (r, r')),
      fun s s' => hAdv ((false, true),  (true,  true))  (hw7 (s, s')),
      fun r s => hAdv ((true,  false), (false, false)) (hw8 (r, s)),
      fun r r' => hAdv ((true,  false), (false, true))  (hw9 (r, r')),
      fun s s' => hAdv ((true,  false), (true,  false)) (hw10 (s, s')),
      fun r s => hAdv ((true,  false), (true,  true))  (hw11 (r, s)),
      fun r₁ r₂ r₃ => hAdv ((true,  true),  (false, false)) (hw12 (r₁, r₂, r₃)),
      fun s₁ s₂ s₃ => hAdv ((true,  true),  (false, true))  (hw13 (s₁, s₂, s₃)),
      fun r₁ r₂ s₃ => hAdv ((true,  true),  (true,  false)) (hw14 (r₁, r₂, s₃)),
      fun r₁ s₂ s₃ => hAdv ((true,  true),  (true,  true))  (hw15 (r₁, s₂, s₃))⟩

  
  obtain ⟨B₀, instCR, instDom, alg_kB₀, instAlgR₁, instTower,
      τ_B₀, ψ_BA, ψ_R₁, loc_R₁,
      hEt_B₀, hτ_comp_R₁, hψ_comp_R₁, hτA_ψ, hψ_hom, hψ_loc⟩ :
      ∃ (B₀ : Type u) (_ : CommRing B₀) (_ : IsDomain B₀)
        (_ : Algebra k B₀) (_ : Algebra R₁ B₀) (_ : IsScalarTower k R₁ B₀)
        (τ_B₀ : B₀ →ₐ[k] k)
        (ψ_BA : B₀ →ₐ[k] A)
        (ψ_R₁ : B₀ →ₐ[R₁] A)
        (loc_R₁ : ↑(D_sh.obj i_star) →ₐ[R₁] B₀),
        RingHom.Etale (algebraMap R₁ B₀) ∧
        τ_B₀.comp (IsScalarTower.toAlgHom k R₁ B₀) = σ₁ ∧
        ψ_BA.comp (IsScalarTower.toAlgHom k R₁ B₀) = f_A ∧
        τ_A.comp ψ_BA = τ_B₀ ∧
        ψ_R₁.toRingHom = ψ_BA.toRingHom ∧
        ψ_R₁.comp loc_R₁ = ι_colim i_star := by
    let B : Type u := ↑(D_sh.obj i_star)
    let ι_B : B →ₐ[R₁] A := ι_colim i_star
    let τ_B : B →+* k := τ_lvl i_star
    have hEt_B : RingHom.Etale (algebraMap R₁ B) := hEt_sh i_star
    have hτ_ι : ∀ x : B, τ_A (ι_B x) = τ_B x := fun x => by
      change τ_A ((ι_colim i_star).toRingHom x) = τ_lvl i_star x
      rw [hι_hom i_star]
      exact hColim_τ i_star x
    have : Algebra.Etale R₁ B := RingHom.etale_algebraMap.mp hEt_B
    have hτB_σ₁ : τ_B.comp (algebraMap R₁ B) = σ₁.toRingHom := by
      ext r
      calc
        τ_B (algebraMap R₁ B r) = τ_A (ι_B (algebraMap R₁ B r)) := (hτ_ι _).symm
        _ = τ_A (algebraMap R₁ A r) := by rw [ι_B.commutes]
        _ = τ_A (f_A r) := by rw [hf_A]; rfl
        _ = σ₁ r := AlgHom.congr_fun hτA_fA r
    obtain ⟨h₀, hh₀, hDom⟩ := hAwayDom B τ_B hτB_σ₁
    let B₀ : Type u := Localization.Away h₀
    have : IsDomain B₀ := hDom
    let alg_kB₀ : Algebra k B₀ := ((algebraMap R₁ B₀).comp (algebraMap k R₁)).toAlgebra
    let _ : Algebra k B₀ := alg_kB₀
    have : IsScalarTower k R₁ B₀ := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale B B₀ := Algebra.Etale.of_isLocalizationAway h₀
    have : Algebra.Etale R₁ B₀ := Algebra.Etale.comp R₁ B B₀
    have hEt_B₀ : RingHom.Etale (algebraMap R₁ B₀) := RingHom.etale_algebraMap.mpr inferInstance
    let loc_R₁ : B →ₐ[R₁] B₀ := IsScalarTower.toAlgHom R₁ B B₀
    have hu_k : IsUnit (τ_B h₀) := Ne.isUnit hh₀
    let τ_B₀_ring : B₀ →+* k := IsLocalization.Away.lift (S := B₀) h₀ hu_k
    have hτ_B₀_R₁ : ∀ r : R₁, τ_B₀_ring (algebraMap R₁ B₀ r) = σ₁ r := by
      intro r
      rw [IsScalarTower.algebraMap_apply R₁ B B₀ r, IsLocalization.Away.lift_eq (S := B₀) h₀ hu_k]
      exact RingHom.congr_fun hτB_σ₁ r
    let τ_B₀ : B₀ →ₐ[k] k :=
      { toRingHom := τ_B₀_ring
        commutes' := fun c => by
          change τ_B₀_ring (algebraMap R₁ B₀ (algebraMap k R₁ c)) = algebraMap k k c
          rw [hτ_B₀_R₁, σ₁.commutes] }
    have hτ_comp_R₁ : τ_B₀.comp (IsScalarTower.toAlgHom k R₁ B₀) = σ₁ := by
      ext r
      exact hτ_B₀_R₁ r
    have hτA_h₀ : τ_A (ι_B h₀) ≠ 0 := by
      rw [hτ_ι h₀]
      exact hh₀
    have hu_A : IsUnit (ι_B.toRingHom h₀) := by
      change IsUnit (ι_B h₀)
      exact Classical.not_not.mp (mt (hUnitA (ι_B h₀)).mpr hτA_h₀)
    let ψ_ring : B₀ →+* A := IsLocalization.Away.lift (S := B₀) h₀ hu_A
    have hψ_B : ∀ b : B, ψ_ring (algebraMap B B₀ b) = ι_B b :=
      fun b => IsLocalization.Away.lift_eq (S := B₀) h₀ hu_A b
    have hψ_R₁_comm : ∀ r : R₁, ψ_ring (algebraMap R₁ B₀ r) = algebraMap R₁ A r := by
      intro r
      rw [IsScalarTower.algebraMap_apply R₁ B B₀ r, hψ_B, ι_B.commutes]
    let ψ_R₁ : B₀ →ₐ[R₁] A :=
      { toRingHom := ψ_ring
        commutes' := hψ_R₁_comm }
    let ψ_BA : B₀ →ₐ[k] A :=
      { toRingHom := ψ_ring
        commutes' := fun c => by
          change ψ_ring (algebraMap R₁ B₀ (algebraMap k R₁ c)) = algebraMap k A c
          rw [hψ_R₁_comm, ← IsScalarTower.algebraMap_apply k R₁ A c] }
    have hψ_comp_R₁ : ψ_BA.comp (IsScalarTower.toAlgHom k R₁ B₀) = f_A := by
      ext r
      change ψ_ring (algebraMap R₁ B₀ r) = f_A r
      rw [hψ_R₁_comm, hf_A]
      rfl
    have hψ_loc : ψ_R₁.comp loc_R₁ = ι_B := by
      ext b
      exact hψ_B b
    have hτA_ψ : τ_A.comp ψ_BA = τ_B₀ := by
      apply AlgHom.coe_ringHom_injective
      apply @IsLocalization.ringHom_ext B _ (Submonoid.powers h₀) B₀ _ _ _ k _
      ext b
      simp only [AlgHom.comp_toRingHom, RingHom.comp_apply]
      change τ_A (ψ_ring (algebraMap B B₀ b)) = τ_B₀_ring (algebraMap B B₀ b)
      rw [hψ_B, hτ_ι, IsLocalization.Away.lift_eq (S := B₀) h₀ hu_k]
    exact ⟨B₀, inferInstance, inferInstance, alg_kB₀, inferInstance, inferInstance,
      τ_B₀, ψ_BA, ψ_R₁, loc_R₁, hEt_B₀, hτ_comp_R₁, hψ_comp_R₁, hτA_ψ, rfl, hψ_loc⟩

  
  obtain ⟨θ, hψ_θ, hθ_loc⟩ :
      ∃ (θ : ↑(D_sh.obj i₁) →ₐ[R₁] B₀),
        ψ_R₁.comp θ = ι_colim i₁ ∧
        θ = loc_R₁.comp (φ_tr w_star) := by
    refine ⟨loc_R₁.comp (φ_tr w_star), ?_, rfl⟩
    rw [← AlgHom.comp_assoc, hψ_loc]
    exact hι_φ w_star

  have hApplyθ : ∀ {M : Type u} [CommRing M] [Algebra R₁ M]
      {x y : TensorProduct R₁ ↑(D_sh.obj i₁) M},
      Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M) x =
        Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M) y →
      Algebra.TensorProduct.map θ (AlgHom.id R₁ M) x =
        Algebra.TensorProduct.map θ (AlgHom.id R₁ M) y := by
    intro M _ _ x y hxy
    have hcomp : Algebra.TensorProduct.map θ (AlgHom.id R₁ M) =
        (Algebra.TensorProduct.map loc_R₁ (AlgHom.id R₁ M)).comp
          (Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M)) := by
      rw [hθ_loc, ← Algebra.TensorProduct.map_comp, AlgHom.comp_id]
    rw [hcomp]
    exact congrArg (Algebra.TensorProduct.map loc_R₁ (AlgHom.id R₁ M)) hxy

  have hProjB₀ : ∀ {M : Type u} [CommRing M] [Algebra R₁ M]
      (y : TensorProduct R₁ ↑(D_sh.obj i₁) M) {x : TensorProduct R₁ A M},
      Algebra.TensorProduct.map (ι_colim i₁) (AlgHom.id R₁ M) y = x →
      Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M)
        (Algebra.TensorProduct.map θ (AlgHom.id R₁ M) y) = x := by
    intro M _ _ y x hy
    have hcomp : (Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M)).comp
        (Algebra.TensorProduct.map θ (AlgHom.id R₁ M)) =
        Algebra.TensorProduct.map (ι_colim i₁) (AlgHom.id R₁ M) := by
      rw [← Algebra.TensorProduct.map_comp, hψ_θ, AlgHom.comp_id]
    exact (AlgHom.congr_fun hcomp y).trans hy

  let f₀_B : Fin m₀ → TensorProduct R₁ B₀ M₀ :=
    fun r => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀) (f₀_1 r)
  let q₀_B : Fin m₀ → TensorProduct R₁ B₀ M₀ :=
    fun r => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀) (q₀_1 r)
  let U₀_B : Fin m₀ → TensorProduct R₁ B₀ M₀ :=
    fun r => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀) (U₀_1 r)
  let V₀_B : Fin m₀ → TensorProduct R₁ B₀ M₀ :=
    fun r => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀) (V₀_1 r)
  let G₀₀_B : Fin m₀ → Fin m₀ → TensorProduct R₁ B₀ M₀ :=
    fun r r' => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀) (G₀₀_1 r r')
  let G'₀₀_B : Fin m₀ → Fin m₀ → TensorProduct R₁ B₀ M₀ :=
    fun r r' => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀) (G'₀₀_1 r r')
  let f₁_B : Fin m₁ → TensorProduct R₁ B₀ M₁ :=
    fun s => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₁) (f₁_1 s)
  let q₁_B : Fin m₁ → TensorProduct R₁ B₀ M₁ :=
    fun s => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₁) (q₁_1 s)
  let U₁_B : Fin m₁ → TensorProduct R₁ B₀ M₁ :=
    fun s => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₁) (U₁_1 s)
  let V₁_B : Fin m₁ → TensorProduct R₁ B₀ M₁ :=
