      · refine iSup_le fun b => ?_
        cases b <;> [exact le_sup_right; exact le_sup_left]
      · exact sup_le (le_iSup U_cov_pair true) (le_iSup U_cov_pair false)
    have hres0 : (ν ∣_ U_0) = j₀ := by
      rw [← cancel_mono U_0.ι, AlgebraicGeometry.morphismRestrict_ι, hj₀_comm]
    have hres1 : (ν ∣_ U_1) = j₁ := by
      rw [← cancel_mono U_1.ι, AlgebraicGeometry.morphismRestrict_ι, hj₁_comm]
    rw [@AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (@AlgebraicGeometry.IsFinite) instZ _ _ ν _ U_cov_pair hSup_pair]
    intro b
    cases b
    · change AlgebraicGeometry.IsFinite (ν ∣_ U_1)
      rwa [hres1]
    · change AlgebraicGeometry.IsFinite (ν ∣_ U_0)
      rwa [hres0]
  have : AlgebraicGeometry.IsFinite ν := hFin_ν
  have : AlgebraicGeometry.IsProper ν := inferInstance
  have hProp_fmid0 : AlgebraicGeometry.IsProper f_mid0 := by
    dsimp [f_mid0]
    infer_instance
  have : AlgebraicGeometry.IsProper f_mid0 := hProp_fmid0
  have : AlgebraicGeometry.IsSeparated f_mid0 := inferInstance

  
  
  
  have hLocChartPullback :
      ∀ (a : Fin m) (Q_a : Type u) [CommRing Q_a] [Algebra (R_a a) Q_a],
        (letI : Algebra R₁ (R_a a) := (ρ_a a).toAlgebra
         Q_a ≃ₐ[R_a a] TensorProduct R₁ (R_a a) A₁) →
        ∃ ι_Qa : AlgebraicGeometry.Spec (CommRingCat.of Q_a) ⟶ Y_mid0,
          AlgebraicGeometry.IsOpenImmersion ι_Qa ∧
          CategoryTheory.IsPullback ι_Qa
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (R_a a) Q_a)) ≫
              (hAff_Ua a).isoSpec.inv)
            ν (U_a a).ι := by
    intro a Q_a _ _ e_Qa
    letI : Algebra R₁ (R_a a) := (ρ_a a).toAlgebra
    let j_Ua_1 : (U_a a).toScheme ⟶ U_1.toScheme := Y_sh.homOfLE (hUa_le_U1 a)
    have : AlgebraicGeometry.IsOpenImmersion j_Ua_1 := inferInstance
    have hj_Ua_1_ι : j_Ua_1 ≫ U_1.ι = (U_a a).ι := Y_sh.homOfLE_ι (hUa_le_U1 a)
    have hSpec_res :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ (R_a a))) ≫
          hAff_1.isoSpec.inv = (hAff_Ua a).isoSpec.inv ≫ j_Ua_1 := by
      rw [← cancel_mono U_1.ι, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hj_Ua_1_ι]
      exact hSpec_res_Ua a
    let f_R₁Ra := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ (R_a a)))
    let f_R₁A₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ A₁))
    let iso_Qa_cat : CommRingCat.of Q_a ≅ CommRingCat.of (TensorProduct R₁ (R_a a) A₁) :=
      { hom := CommRingCat.ofHom e_Qa.toRingEquiv.toRingHom
        inv := CommRingCat.ofHom e_Qa.symm.toRingEquiv.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext e_Qa.symm_apply_apply)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext e_Qa.apply_symm_apply) }
    let iso_Spec_Qa : AlgebraicGeometry.Spec (CommRingCat.of Q_a) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ (R_a a) A₁)) :=
      { hom := AlgebraicGeometry.Spec.map iso_Qa_cat.inv
        inv := AlgebraicGeometry.Spec.map iso_Qa_cat.hom
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, iso_Qa_cat.hom_inv_id,
            AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, iso_Qa_cat.inv_hom_id,
            AlgebraicGeometry.Spec.map_id] }
    let iso_top_left :
        CategoryTheory.Limits.pullback f_R₁Ra f_R₁A₁ ≅
          AlgebraicGeometry.Spec (CommRingCat.of Q_a) :=
      AlgebraicGeometry.pullbackSpecIso R₁ (R_a a) A₁ ≪≫ iso_Spec_Qa.symm
    let g_Qa : AlgebraicGeometry.Spec (CommRingCat.of Q_a) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A₁) :=
      iso_top_left.inv ≫ CategoryTheory.Limits.pullback.snd f_R₁Ra f_R₁A₁
    have hiso_fst :
        CategoryTheory.Limits.pullback.fst f_R₁Ra f_R₁A₁ ≫ (hAff_Ua a).isoSpec.inv =
        iso_top_left.hom ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (R_a a) Q_a)) ≫
            (hAff_Ua a).isoSpec.inv) := by
      rw [← CategoryTheory.Category.assoc iso_top_left.hom]
      congr 1
      dsimp [iso_top_left, iso_Spec_Qa]
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hcomm_alg :
          CommRingCat.ofHom (algebraMap (R_a a) Q_a) ≫ iso_Qa_cat.hom =
            CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom :=
        CommRingCat.hom_ext (RingHom.ext e_Qa.commutes)
      rw [hcomm_alg]
      exact (AlgebraicGeometry.pullbackSpecIso_hom_fst R₁ (R_a a) A₁).symm
    have hPb_Qa_U1 : CategoryTheory.IsPullback g_Qa
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (R_a a) Q_a)) ≫
          (hAff_Ua a).isoSpec.inv)
        π₁ j_Ua_1 := by
      refine CategoryTheory.IsPullback.of_iso
        (CategoryTheory.IsPullback.of_hasPullback f_R₁Ra f_R₁A₁).flip
        iso_top_left (CategoryTheory.Iso.refl _) (hAff_Ua a).isoSpec.symm hAff_1.isoSpec.symm
        ?_ hiso_fst ?_ ?_
      · dsimp [g_Qa]
        rw [CategoryTheory.Iso.hom_inv_id_assoc, CategoryTheory.Category.comp_id]
      · dsimp [π₁]
        rw [CategoryTheory.Category.id_comp]
      · exact hSpec_res
    have : AlgebraicGeometry.IsOpenImmersion g_Qa :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_Qa_U1.flip inferInstance
    let ι_Qa := g_Qa ≫ ι₁
    have hOpen_ιQa : AlgebraicGeometry.IsOpenImmersion ι_Qa := inferInstance
    have hPb_Qa : CategoryTheory.IsPullback ι_Qa
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (R_a a) Q_a)) ≫
          (hAff_Ua a).isoSpec.inv)
        ν (U_a a).ι := by
      rw [← hj_Ua_1_ι]
      exact CategoryTheory.IsPullback.paste_horiz hPb_Qa_U1 hPb₁
    exact ⟨ι_Qa, hOpen_ιQa, hPb_Qa⟩

  
  let B₁_ram := { a : Fin m // 1 ≤ c a }
  have hRamEx : ∀ a : B₁_ram,
      ∃ (u_ram : Units (R_a a.1))
        (ι_a : AlgebraicGeometry.Spec (CommRingCat.of
          (Polynomial (R_a a.1) ⧸
            Ideal.span {Polynomial.X ^ ℓ -
              Polynomial.C ((u_ram : R_a a.1) * t_loc a.1)})) ⟶ Y_mid0),
        AlgebraicGeometry.IsOpenImmersion ι_a ∧
        CategoryTheory.IsPullback ι_a
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp Polynomial.C)) ≫
            (hAff_Ua a.1).isoSpec.inv)
          ν (U_a a.1).ι := by
    intro a
    letI : Algebra R₁ (R_a a.1) := (ρ_a a.1).toAlgebra
    obtain ⟨u_ram, ⟨e_Sa⟩⟩ := hRamLocA₁ a.1 a.2 (R_a a.1) (hUnit_other a.1)
    obtain ⟨ι_a, hOpen_a, hPb_a⟩ :=
      hLocChartPullback a.1
        (Polynomial (R_a a.1) ⧸
          Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((u_ram : R_a a.1) * t_loc a.1)})
        e_Sa
    exact ⟨u_ram, ι_a, hOpen_a, hPb_a⟩

  let u_ram_of : ∀ a : B₁_ram, Units (R_a a.1) :=
    fun a => Classical.choose (hRamEx a)
  let ι_ram_of : ∀ a : B₁_ram,
      AlgebraicGeometry.Spec (CommRingCat.of
        (Polynomial (R_a a.1) ⧸
          Ideal.span {Polynomial.X ^ ℓ -
            Polynomial.C ((u_ram_of a : R_a a.1) * t_loc a.1)})) ⟶ Y_mid0 :=
    fun a => Classical.choose (Classical.choose_spec (hRamEx a))
  have hOpen_ram_of : ∀ a : B₁_ram, AlgebraicGeometry.IsOpenImmersion (ι_ram_of a) :=
    fun a => (Classical.choose_spec (Classical.choose_spec (hRamEx a))).1
  have hPb_ram_of : ∀ a : B₁_ram,
      CategoryTheory.IsPullback (ι_ram_of a)
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp Polynomial.C)) ≫
          (hAff_Ua a.1).isoSpec.inv)
        ν (U_a a.1).ι :=
    fun a => (Classical.choose_spec (Classical.choose_spec (hRamEx a))).2

  
  have hCrux_ram : ∀ a : B₁_ram,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (ι_ram_of a ≫ f_mid0) ∧
      ∃ τ_a : V_sh ⟶ Y_mid0,
        τ_a ≫ ν = τ_sh a.1 ∧
        AlgebraicGeometry.IsClosedImmersion τ_a ∧
        ν.base ⁻¹' Set.range (τ_sh a.1).base = Set.range τ_a.base := by
    intro a
    letI : Algebra B (R_a a.1) := (f_Ra_cat a.1).hom.toAlgebra
    have : IsDomain (R_a a.1) := hDom_Ra a.1
    let f_loc_a : AlgebraicGeometry.Spec (CommRingCat.of (R_a a.1)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (R_a a.1)))
    have hf_loc_eq : f_loc_a = ((hAff_Ua a.1).fromSpec ≫ f_sh) ≫ V_sh.isoSpec.hom :=
      hf_Ra_Spec a.1
    have hSm_floc : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_loc_a := by
      have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          ((hAff_Ua a.1).fromSpec ≫ f_sh) := inferInstance
      rw [Nat.zero_add] at h01
      have := h01
      have h10 : AlgebraicGeometry.SmoothOfRelativeDimension (1 + 0)
          (((hAff_Ua a.1).fromSpec ≫ f_sh) ≫ V_sh.isoSpec.hom) := inferInstance
      rwa [Nat.add_zero, ← hf_loc_eq] at h10
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_loc_a := hSm_floc
    let π_sec_a : R_a a.1 →ₐ[B] B :=
      { ((τ_sh a.1).appLE (U_a a.1) ⊤ (h_le_Ua a.1)).hom with
        commutes' := fun b =>
          DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hf_τ_id a.1)) b }
    obtain ⟨hSm_comp, τ_tilde, hτ_tilde_p, _, hτ_tilde_rng⟩ :=
      weil_bezout_kummer_section_smooth_and_reduced_lift ℓ hℓ_pos B (R_a a.1)
        hℓ_unit_B π_sec_a (t_loc a.1) (ht_loc_ne a.1) (hker_Ua a.1) (u_ram_of a)
    let p_Sa := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk
        (Ideal.span {Polynomial.X ^ ℓ -
          Polynomial.C ((u_ram_of a : R_a a.1) * t_loc a.1)})).comp Polynomial.C))
    have hι_fmid : ι_ram_of a ≫ f_mid0 = (p_Sa ≫ f_loc_a) ≫ V_sh.isoSpec.inv := by
      dsimp [f_mid0]
      rw [← CategoryTheory.Category.assoc, (hPb_ram_of a).w]
      calc
        ((p_Sa ≫ (hAff_Ua a.1).isoSpec.inv) ≫ (U_a a.1).ι) ≫ f_sh
          = p_Sa ≫ ((hAff_Ua a.1).fromSpec ≫ f_sh) := by
              simp only [CategoryTheory.Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
        _ = p_Sa ≫ (((hAff_Ua a.1).fromSpec ≫ f_sh) ≫ V_sh.isoSpec.hom) ≫ V_sh.isoSpec.inv := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                CategoryTheory.Category.comp_id]
        _ = (p_Sa ≫ f_loc_a) ≫ V_sh.isoSpec.inv := by
              rw [← hf_loc_eq, CategoryTheory.Category.assoc]
    have hSm_ι : AlgebraicGeometry.SmoothOfRelativeDimension 1 (ι_ram_of a ≫ f_mid0) := by
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (p_Sa ≫ f_loc_a) := hSm_comp
      have h10 : AlgebraicGeometry.SmoothOfRelativeDimension (1 + 0)
          ((p_Sa ≫ f_loc_a) ≫ V_sh.isoSpec.inv) := inferInstance
      rwa [Nat.add_zero, ← hι_fmid] at h10
    let τ_a : V_sh ⟶ Y_mid0 := V_sh.isoSpec.hom ≫ τ_tilde ≫ ι_ram_of a
    have hτ_a_ν : τ_a ≫ ν = τ_sh a.1 := by
      calc
        (V_sh.isoSpec.hom ≫ τ_tilde ≫ ι_ram_of a) ≫ ν
          = V_sh.isoSpec.hom ≫ τ_tilde ≫ (ι_ram_of a ≫ ν) := by
              simp only [CategoryTheory.Category.assoc]
        _ = V_sh.isoSpec.hom ≫ τ_tilde ≫
              ((p_Sa ≫ (hAff_Ua a.1).isoSpec.inv) ≫ (U_a a.1).ι) := by
              rw [(hPb_ram_of a).w]
        _ = V_sh.isoSpec.hom ≫ (τ_tilde ≫ p_Sa) ≫
              ((hAff_Ua a.1).isoSpec.inv ≫ (U_a a.1).ι) := by
              simp only [CategoryTheory.Category.assoc]
        _ = V_sh.isoSpec.hom ≫
              (AlgebraicGeometry.Spec.map ((τ_sh a.1).appLE (U_a a.1) ⊤ (h_le_Ua a.1)) ≫
                (hAff_Ua a.1).fromSpec) := by
              rw [hτ_tilde_p, AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
              rfl
        _ = V_sh.isoSpec.hom ≫ V_sh.isoSpec.inv ≫ τ_sh a.1 := by rw [hτ_Ra_Spec a.1]
        _ = τ_sh a.1 := V_sh.isoSpec.hom_inv_id_assoc _
    have hτ_a_sec : τ_a ≫ f_mid0 = 𝟙 V_sh := by
      dsimp [f_mid0]
      rw [← CategoryTheory.Category.assoc, hτ_a_ν, hτ_sec a.1]
    have hτ_a_cl : AlgebraicGeometry.IsClosedImmersion τ_a :=
      hClosedImmOfSepSection τ_a f_mid0 hτ_a_sec
    have hτ_a_pre : ν.base ⁻¹' Set.range (τ_sh a.1).base = Set.range τ_a.base := by
      ext y
      simp only [Set.mem_preimage]
      constructor
      · intro hy
        obtain ⟨v₀, hv₀⟩ := hy
        have hy_Ua : ν.base y ∈ (U_a a.1 : Set ↥Y_sh) := by
          rw [← hv₀]
          exact h_le_Ua a.1 (show v₀ ∈ (⊤ : V_sh.Opens) from trivial)
        have hy_rng_ι : y ∈ Set.range (ι_ram_of a).base := by
          rw [hRangeOfIsPullback (hPb_ram_of a), (U_a a.1).range_ι]
          exact hy_Ua
        obtain ⟨z, rfl⟩ := hy_rng_ι
        have hz_p : p_Sa.base z ∈
            Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_sec_a.toRingHom)).base := by
          refine ⟨V_sh.isoSpec.hom.base v₀, ?_⟩
          apply ((hAff_Ua a.1).fromSpec).isOpenEmbedding.injective
          calc
            (hAff_Ua a.1).fromSpec.base
                ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_sec_a.toRingHom)).base
                  (V_sh.isoSpec.hom.base v₀))
              = (V_sh.isoSpec.hom ≫
                  (AlgebraicGeometry.Spec.map ((τ_sh a.1).appLE (U_a a.1) ⊤ (h_le_Ua a.1)) ≫
                    (hAff_Ua a.1).fromSpec)).base v₀ := rfl
            _ = (τ_sh a.1).base v₀ := by
                  rw [hτ_Ra_Spec a.1, V_sh.isoSpec.hom_inv_id_assoc]
            _ = (ι_ram_of a ≫ ν).base z := hv₀
            _ = ((p_Sa ≫ (hAff_Ua a.1).isoSpec.inv) ≫ (U_a a.1).ι).base z := by
                  rw [(hPb_ram_of a).w]
            _ = (hAff_Ua a.1).fromSpec.base (p_Sa.base z) := by
                  simp only [CategoryTheory.Category.assoc,
                    AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
                  rfl
        have hz_tilde : z ∈ Set.range τ_tilde.base := by
          rwa [← hτ_tilde_rng]
        obtain ⟨p_b, rfl⟩ := hz_tilde
        refine ⟨V_sh.isoSpec.inv.base p_b, ?_⟩
        change (ι_ram_of a).base (τ_tilde.base ((V_sh.isoSpec.inv ≫ V_sh.isoSpec.hom).base p_b)) = _
        rw [V_sh.isoSpec.inv_hom_id]
        rfl
      · rintro ⟨v₀, rfl⟩
        exact ⟨v₀, by change (τ_sh a.1).base v₀ = (τ_a ≫ ν).base v₀; rw [hτ_a_ν]⟩
    exact ⟨hSm_ι, τ_a, hτ_a_ν, hτ_a_cl, hτ_a_pre⟩

  let τ_ram : B₁_ram → (V_sh ⟶ Y_mid0) := fun a => Classical.choose (hCrux_ram a).2
  have hτ_ram_spec : ∀ a : B₁_ram,
      τ_ram a ≫ ν = τ_sh a.1 ∧
      AlgebraicGeometry.IsClosedImmersion (τ_ram a) ∧
      ν.base ⁻¹' Set.range (τ_sh a.1).base = Set.range (τ_ram a).base :=
    fun a => Classical.choose_spec (hCrux_ram a).2

  
  let B₀_et := { a : Fin m // c a = 0 }
  let Z_et : B₀_et → AlgebraicGeometry.Scheme.{u} :=
    fun b => CategoryTheory.Limits.pullback (τ_sh b.1) ν
  let ι_Z : ∀ b : B₀_et, Z_et b ⟶ Y_mid0 :=
    fun b => CategoryTheory.Limits.pullback.snd (τ_sh b.1) ν

  have hEtBdryCharts : ∀ b : B₀_et,
      (∃ (W_b : AlgebraicGeometry.Scheme.{u}) (ι_Wb : W_b ⟶ Y_mid0),
        AlgebraicGeometry.IsOpenImmersion ι_Wb ∧
        Set.range ι_Wb.base = ν.base ⁻¹' (U_a b.1 : Set ↥Y_sh) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (ι_Wb ≫ f_mid0)) ∧
      AlgebraicGeometry.IsClosedImmersion (ι_Z b) ∧
      ν.base ⁻¹' Set.range (τ_sh b.1).base = Set.range (ι_Z b).base ∧
      AlgebraicGeometry.IsFinite (ι_Z b ≫ f_mid0) ∧
      AlgebraicGeometry.Etale (ι_Z b ≫ f_mid0) ∧
      AlgebraicGeometry.Surjective (ι_Z b ≫ f_mid0) := by
    intro b
    letI : Algebra R₁ (R_a b.1) := (ρ_a b.1).toAlgebra
    obtain ⟨u_loc, ⟨e_Qb⟩⟩ := hEtLocA₁ b.1 b.2 (R_a b.1) (hUnit_other b.1)
    let Q_b := Polynomial (R_a b.1) ⧸
      Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u_loc : R_a b.1)}
    obtain ⟨ι_Qb, hOpen_Qb, hPb_Qb⟩ := hLocChartPullback b.1 Q_b e_Qb
    have : AlgebraicGeometry.IsOpenImmersion ι_Qb := hOpen_Qb
    have huℓ_Rb : IsUnit (ℓ : R_a b.1) := by
      rw [← map_natCast (f_Ra_cat b.1).hom]
      exact hℓ_unit_B.map (f_Ra_cat b.1).hom
    have : Algebra.Etale (R_a b.1) Q_b := hKummerEtale (R_a b.1) huℓ_Rb u_loc
    let p_Qb : AlgebraicGeometry.Spec (CommRingCat.of Q_b) ⟶ (U_a b.1).toScheme :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (R_a b.1) Q_b)) ≫
        (hAff_Ua b.1).isoSpec.inv
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (R_a b.1) Q_b))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    have : AlgebraicGeometry.Etale p_Qb := inferInstance
    have hι_Qb_fmid : ι_Qb ≫ f_mid0 = (p_Qb ≫ (U_a b.1).ι) ≫ f_sh := by
      dsimp [f_mid0]
      rw [← CategoryTheory.Category.assoc, hPb_Qb.w, CategoryTheory.Category.assoc]
    have hSm_Qb : AlgebraicGeometry.SmoothOfRelativeDimension 1 (ι_Qb ≫ f_mid0) := by
      have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          ((p_Qb ≫ (U_a b.1).ι) ≫ f_sh) := inferInstance
      rwa [Nat.zero_add, ← hι_Qb_fmid] at h01
    have hrng_Qb : Set.range ι_Qb.base = ν.base ⁻¹' (U_a b.1 : Set ↥Y_sh) := by
      rw [hRangeOfIsPullback hPb_Qb, (U_a b.1).range_ι]
    have := hτ_cl b.1
    have hCl_ιZ : AlgebraicGeometry.IsClosedImmersion (ι_Z b) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (τ_sh b.1) ν) inferInstance
    have hrng_ιZ : ν.base ⁻¹' Set.range (τ_sh b.1).base = Set.range (ι_Z b).base :=
      (AlgebraicGeometry.Scheme.Pullback.range_snd (τ_sh b.1) ν).symm
    have hιZ_fmid_eq : ι_Z b ≫ f_mid0 = CategoryTheory.Limits.pullback.fst (τ_sh b.1) ν := by
      dsimp [ι_Z, f_mid0]
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, hτ_sec b.1, CategoryTheory.Category.comp_id]
    have hFin_ιZ : AlgebraicGeometry.IsFinite (ι_Z b ≫ f_mid0) := by
      rw [hιZ_fmid_eq]
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (τ_sh b.1) ν).flip inferInstance
    have hSurj_ιZ : AlgebraicGeometry.Surjective (ι_Z b ≫ f_mid0) := by
      rw [hιZ_fmid_eq]
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (τ_sh b.1) ν).flip inferInstance
    have hrng_τb : Set.range (τ_sh b.1).base ⊆ Set.range (U_a b.1).ι.base := by
      rw [(U_a b.1).range_ι]
      rintro _ ⟨v, rfl⟩
      exact h_le_Ua b.1 (show v ∈ (⊤ : V_sh.Opens) from trivial)
    let τ_loc_b : V_sh ⟶ (U_a b.1).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (U_a b.1).ι (τ_sh b.1) hrng_τb
    have hτ_loc_fac : τ_loc_b ≫ (U_a b.1).ι = τ_sh b.1 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (U_a b.1).ι (τ_sh b.1) hrng_τb
    have hrng_ιZ_Qb : Set.range (ι_Z b).base ⊆ Set.range ι_Qb.base := by
      rw [← hrng_ιZ, hrng_Qb]
      intro y hy
      rw [← hτ_loc_fac] at hy
      obtain ⟨v, hv⟩ := hy
      change ν.base y ∈ (U_a b.1 : Set ↥Y_sh)
      rw [← hv]
      exact (τ_loc_b.base v).2
    let lift_Z_Qb : Z_et b ⟶ AlgebraicGeometry.Spec (CommRingCat.of Q_b) :=
      AlgebraicGeometry.IsOpenImmersion.lift ι_Qb (ι_Z b) hrng_ιZ_Qb
    have hlift_Z_fac : lift_Z_Qb ≫ ι_Qb = ι_Z b :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_Qb (ι_Z b) hrng_ιZ_Qb
    have hcomm_Z_Qb :
        CategoryTheory.Limits.pullback.fst (τ_sh b.1) ν ≫ τ_loc_b = lift_Z_Qb ≫ p_Qb := by
      rw [← cancel_mono (U_a b.1).ι, CategoryTheory.Category.assoc, hτ_loc_fac,
        CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, ← hPb_Qb.w,
        ← CategoryTheory.Category.assoc, hlift_Z_fac]
    have hPb_Z_Qb : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (τ_sh b.1) ν) lift_Z_Qb τ_loc_b p_Qb := by
      refine CategoryTheory.IsPullback.of_bot ?_ hcomm_Z_Qb hPb_Qb.flip
      rw [hτ_loc_fac, hlift_Z_fac]
      exact CategoryTheory.IsPullback.of_hasPullback (τ_sh b.1) ν
    have hEt_ιZ : AlgebraicGeometry.Etale (ι_Z b ≫ f_mid0) := by
      rw [hιZ_fmid_eq]
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_Z_Qb.flip inferInstance
    exact ⟨⟨_, ι_Qb, hOpen_Qb, hrng_Qb, hSm_Qb⟩,
      hCl_ιZ, hrng_ιZ, hFin_ιZ, hEt_ιZ, hSurj_ιZ⟩

  
  have hSmAtOfOpenImm :
      ∀ {W_s : AlgebraicGeometry.Scheme.{u}} (ι_W : W_s ⟶ Y_mid0)
        [AlgebraicGeometry.IsOpenImmersion ι_W]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 (ι_W ≫ f_mid0)]
        (w : ↥W_s),
        ∃ (U : V_sh.Opens) (_ : AlgebraicGeometry.IsAffineOpen U)
          (V : Y_mid0.Opens) (_ : AlgebraicGeometry.IsAffineOpen V) (_ : ι_W.base w ∈ V)
          (e : V ≤ (TopologicalSpace.Opens.map f_mid0.base).obj U),
          RingHom.IsStandardSmoothOfRelativeDimension 1
            ((AlgebraicGeometry.Scheme.Hom.appLE f_mid0 U V e).hom) := by
    intro W_s ι_W _ hSm_W w
    obtain ⟨U, hAff_U, V₀, hAff_V₀, hw_V₀, e₀, hStd₀⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (ι_W ≫ f_mid0)).mp hSm_W w
    haveI : AlgebraicGeometry.IsAffine V₀.toScheme := hAff_V₀
    let j_V : V₀.toScheme ⟶ Y_mid0 := V₀.ι ≫ ι_W
    have : AlgebraicGeometry.IsOpenImmersion j_V := inferInstance
    let V : Y_mid0.Opens := j_V.opensRange
    let iso_V : V₀.toScheme ≅ V.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq j_V V.ι V.range_ι.symm
    have hAff_V : AlgebraicGeometry.IsAffineOpen V :=
      AlgebraicGeometry.IsAffine.of_isIso iso_V.inv
    have hx_V : ι_W.base w ∈ V := ⟨⟨w, hw_V₀⟩, rfl⟩
    have e : V ≤ (TopologicalSpace.Opens.map f_mid0.base).obj U := by
      rintro _ ⟨z, rfl⟩
      exact e₀ z.2
    let iso_Spec_V :
        AlgebraicGeometry.Spec (W_s.presheaf.obj (Opposite.op V₀)) ≅
          AlgebraicGeometry.Spec (Y_mid0.presheaf.obj (Opposite.op V)) :=
      hAff_V₀.isoSpec.symm ≪≫ iso_V ≪≫ hAff_V.isoSpec
    let φ_V_iso :
        Y_mid0.presheaf.obj (Opposite.op V) ⟶ W_s.presheaf.obj (Opposite.op V₀) :=
      AlgebraicGeometry.Spec.preimage iso_Spec_V.hom
    let φ_V_inv :
        W_s.presheaf.obj (Opposite.op V₀) ⟶ Y_mid0.presheaf.obj (Opposite.op V) :=
      AlgebraicGeometry.Spec.preimage iso_Spec_V.inv
    have hφ1 : φ_V_iso ≫ φ_V_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, iso_Spec_V.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have hφ2 : φ_V_inv ≫ φ_V_iso = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, iso_Spec_V.hom_inv_id,
        AlgebraicGeometry.Spec.map_id]
    let e_ring_V : ↑(W_s.presheaf.obj (Opposite.op V₀)) ≃+*
        ↑(Y_mid0.presheaf.obj (Opposite.op V)) :=
      { toFun := φ_V_inv.hom
        invFun := φ_V_iso.hom
        left_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hφ2) x
        right_inv := fun x => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hφ1) x
        map_mul' := map_mul φ_V_inv.hom
        map_add' := map_add φ_V_inv.hom }
    have hSpec_eq :
        f_mid0.appLE U V e = (ι_W ≫ f_mid0).appLE U V₀ e₀ ≫ φ_V_inv := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [← cancel_mono hAff_U.fromSpec, AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_mid0 hAff_U hAff_V e,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (ι_W ≫ f_mid0) hAff_U hAff_V₀ e₀]
      dsimp [iso_Spec_V]
      have hiso_j : iso_V.inv ≫ j_V = V.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac j_V V.ι V.range_ι.symm
      have hfrom0 : hAff_V₀.isoSpec.hom ≫ hAff_V₀.fromSpec = V₀.ι := by
        rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAff_V₀,
          CategoryTheory.Iso.hom_inv_id_assoc]
      calc
        hAff_V.fromSpec ≫ f_mid0
          = (hAff_V.isoSpec.inv ≫ V.ι) ≫ f_mid0 := by
              rw [AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
        _ = (hAff_V.isoSpec.inv ≫ (iso_V.inv ≫ j_V)) ≫ f_mid0 := by
              rw [hiso_j]
        _ = hAff_V.isoSpec.inv ≫ iso_V.inv ≫ (V₀.ι ≫ (ι_W ≫ f_mid0)) := by
              dsimp [j_V]
              simp only [CategoryTheory.Category.assoc]
        _ = (hAff_V.isoSpec.inv ≫ iso_V.inv ≫ hAff_V₀.isoSpec.hom) ≫
              (hAff_V₀.fromSpec ≫ (ι_W ≫ f_mid0)) := by
              rw [← hfrom0]
              simp only [CategoryTheory.Category.assoc]
    have hhom_eq :
        (f_mid0.appLE U V e).hom =
          e_ring_V.toRingHom.comp (((ι_W ≫ f_mid0).appLE U V₀ e₀).hom) := by
      ext x
      exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hSpec_eq) x
    refine ⟨U, hAff_U, V, hAff_V, hx_V, e, ?_⟩
    rw [hhom_eq]
    exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).left
      ((ι_W ≫ f_mid0).appLE U V₀ e₀).hom e_ring_V hStd₀

  have hSm_W0 : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_mid0.ι ≫ f_mid0) := by
    have heq0 : W_mid0.ι ≫ f_mid0 = (j₀ ≫ U_0.ι) ≫ f_sh := by
      dsimp [f_mid0]
      rw [← CategoryTheory.Category.assoc, ← hj₀_comm, CategoryTheory.Category.assoc]
    have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) ((j₀ ≫ U_0.ι) ≫ f_sh) :=
      inferInstance
    rwa [Nat.zero_add, ← heq0] at h01

  have hSm_fmid0 : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_mid0 := by
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro y
    have hy_cov : ν.base y ∈ (U_0 ⊔ (⨆ a : Fin m, U_a a) : Y_sh.Opens) := by
      rw [hCov_Ua]; trivial
    rcases hy_cov with hy0 | hya
    · have := hSm_W0
      exact hSmAtOfOpenImm W_mid0.ι ⟨y, hy0⟩
    · change ν.base y ∈ ((⨆ a : Fin m, U_a a : Y_sh.Opens) : Set ↥Y_sh) at hya
      rw [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hya
      obtain ⟨a, hya_mem⟩ := hya
      rcases Nat.eq_zero_or_pos (c a) with hc0 | hc1
      · obtain ⟨⟨W_b, ι_Wb, hOpen_Wb, hrng_Wb, hSm_Wb⟩, -⟩ := hEtBdryCharts ⟨a, hc0⟩
        have := hOpen_Wb
        have := hSm_Wb
        have hy_Wb : y ∈ Set.range ι_Wb.base := by
          rw [hrng_Wb]; exact hya_mem
        obtain ⟨w, rfl⟩ := hy_Wb
        exact hSmAtOfOpenImm ι_Wb w
      · let a_ram : B₁_ram := ⟨a, hc1⟩
        have := hOpen_ram_of a_ram
        have := (hCrux_ram a_ram).1
        have hy_ram : y ∈ Set.range (ι_ram_of a_ram).base := by
          rw [hRangeOfIsPullback (hPb_ram_of a_ram), (U_a a).range_ι]
          exact hya_mem
        obtain ⟨w, rfl⟩ := hy_ram
        exact hSmAtOfOpenImm (ι_ram_of a_ram) w
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_mid0 := hSm_fmid0

  
  
  
  obtain ⟨a₀, ha₀⟩ := hc_pos
  let a_pos : B₁_ram := ⟨a₀, ha₀⟩

  have hIrred_fmid0 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V_sh),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_mid0 s) := by
    intro Ω _ _ s
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let pt_Ω : ↥S_Ω := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω)
    let F_sh := CategoryTheory.Limits.pullback f_sh s
    let F_mid := CategoryTheory.Limits.pullback f_mid0 s
    let q_sh : F_sh ⟶ S_Ω := CategoryTheory.Limits.pullback.snd f_sh s
    let q_mid : F_mid ⟶ S_Ω := CategoryTheory.Limits.pullback.snd f_mid0 s
    have hSm_qsh : AlgebraicGeometry.SmoothOfRelativeDimension 1 q_sh :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_sh s) inferInstance
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 q_mid :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_mid0 s) inferInstance
    have : IrreducibleSpace ↥F_sh := hIrred_sh Ω s
    have hInt_Fsh : AlgebraicGeometry.IsIntegral F_sh :=
      (hSmoothCurveOverFieldInt Ω F_sh q_sh (IrreducibleSpace.connectedSpace ↥F_sh)).2
    have : AlgebraicGeometry.IsIntegral F_sh := hInt_Fsh
    let C_Fsh : CategoryTheory.Over S_Ω := CategoryTheory.Over.mk q_sh
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_Fsh.hom := hSm_qsh
    have hDim_Fsh : topologicalKrullDim ↥F_sh = (1 : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field Ω 1 C_Fsh hInt_Fsh
    let ν_s : F_mid ⟶ F_sh :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f_mid0 s ≫ ν) q_mid
        (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    have hPb_νs : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_mid0 s) ν_s
        ν (CategoryTheory.Limits.pullback.fst f_sh s) :=
      CategoryTheory.IsPullback.of_bot
        (by
          rw [CategoryTheory.Limits.pullback.lift_snd]
          exact CategoryTheory.IsPullback.of_hasPullback f_mid0 s)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback f_sh s)
    have : AlgebraicGeometry.IsFinite ν_s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_νs inferInstance
    have hτ_pos_sec : τ_ram a_pos ≫ f_mid0 = 𝟙 V_sh := by
      dsimp [f_mid0]
      rw [← CategoryTheory.Category.assoc, (hτ_ram_spec a_pos).1, hτ_sec a₀]
    let σ_sh : S_Ω ⟶ F_sh :=
      CategoryTheory.Limits.pullback.lift (s ≫ τ_sh a₀) (𝟙 S_Ω)
        (by rw [CategoryTheory.Category.assoc, hτ_sec a₀,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    let σ_mid : S_Ω ⟶ F_mid :=
      CategoryTheory.Limits.pullback.lift (s ≫ τ_ram a_pos) (𝟙 S_Ω)
        (by rw [CategoryTheory.Category.assoc, hτ_pos_sec,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hσ_comm : σ_mid ≫ ν_s = σ_sh := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          (hτ_ram_spec a_pos).1]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    let z₀ : ↥F_sh := σ_sh.base pt_Ω
    let z_tilde₀ : ↥F_mid := σ_mid.base pt_Ω
    have hSing : ν_s.base ⁻¹' ({z₀} : Set ↥F_sh) = ({z_tilde₀} : Set ↥F_mid) := by
      have hpre_sh : (CategoryTheory.Limits.pullback.fst f_sh s).base ⁻¹'
          Set.range (τ_sh a₀).base = {z₀} :=
        hSecPreimageSingleton Ω f_sh (τ_sh a₀) s pt_Ω (hτ_sec a₀)
      have hpre_mid : (CategoryTheory.Limits.pullback.fst f_mid0 s).base ⁻¹'
          Set.range (τ_ram a_pos).base = {z_tilde₀} :=
        hSecPreimageSingleton Ω f_mid0 (τ_ram a_pos) s pt_Ω hτ_pos_sec
      ext w
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hw
        have hw_sh : ν_s.base w ∈ ({z₀} : Set ↥F_sh) := hw
        rw [← hpre_sh, Set.mem_preimage] at hw_sh
        have hw_ν : ν.base ((CategoryTheory.Limits.pullback.fst f_mid0 s).base w) ∈
            Set.range (τ_sh a₀).base := by
          have heq_fst :
              (CategoryTheory.Limits.pullback.fst f_mid0 s ≫ ν).base w =
                (ν_s ≫ CategoryTheory.Limits.pullback.fst f_sh s).base w :=
            congrArg (fun h : F_mid ⟶ Y_sh => h.base w)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
          exact heq_fst.symm ▸ hw_sh
        have hw_ram : (CategoryTheory.Limits.pullback.fst f_mid0 s).base w ∈
            Set.range (τ_ram a_pos).base := by
          rw [← (hτ_ram_spec a_pos).2.2]
          exact hw_ν
        have hw_mid : w ∈ (CategoryTheory.Limits.pullback.fst f_mid0 s).base ⁻¹'
            Set.range (τ_ram a_pos).base := hw_ram
        rwa [hpre_mid, Set.mem_singleton_iff] at hw_mid
      · rintro rfl
        change (σ_mid ≫ ν_s).base pt_Ω = z₀
        rw [hσ_comm]
    have hConn_mid : ConnectedSpace ↥F_mid :=
      weil_ramified_cover_geom_fibers_connected_and_total_irreducible.1
        Ω F_mid F_sh q_mid ν_s hDim_Fsh z₀ z_tilde₀ hSing
    exact (hSmoothCurveOverFieldInt Ω F_mid q_mid hConn_mid).1

  have : IrreducibleSpace ↥Y_mid0 :=
    weil_ramified_cover_geom_fibers_connected_and_total_irreducible.2
      Y_mid0 V_sh f_mid0 hIrred_fmid0

  
  have : IsReduced A₀ := hEtaleOverDomainReduced R₀ A₀
  have hRed_tens0 : IsReduced (letI : Algebra R₀ R₀₁ := algR₀R₀₁; TensorProduct R₀ R₀₁ A₀) := by
    letI : Algebra R₀ R₀₁ := algR₀R₀₁
    have : Algebra.Etale R₀₁ (TensorProduct R₀ R₀₁ A₀) :=
      Algebra.Etale.baseChange R₀ A₀ R₀₁
    exact hEtaleOverDomainReduced R₀₁ (TensorProduct R₀ R₀₁ A₀)
  have hRed_A₁ : IsReduced A₁ := by
    let s_all : ↑(Y_sh.presheaf.obj (Opposite.op U_1)) := Finset.univ.prod t_sh
    let R_bo : Type u := ↑(Y_sh.presheaf.obj (Opposite.op (Y_sh.basicOpen s_all)))
    let ρ_bo : R₁ →+* R_bo :=
      (Y_sh.presheaf.map (CategoryTheory.homOfLE (Y_sh.basicOpen_le s_all)).op).hom
    have hDom_U1 : IsDomain R₁ :=
      AlgebraicGeometry.IsIntegral.component_integral U_1
    have instNZD : NoZeroDivisors R₁ :=
      @IsRightCancelMulZero.to_noZeroDivisors R₁ _
        hDom_U1.toIsCancelMulZero.toIsRightCancelMulZero
    have hpow_s_ne : ∀ n : ℕ, (s_all : R₁) ^ n ≠ 0 := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero]
        intro h10
        obtain ⟨a, b, hab⟩ := hDom_U1.toNontrivial.exists_pair_ne
        exact hab (by
          calc
            a = a * 1 := (mul_one a).symm
            _ = a * 0 := by rw [h10]
            _ = 0 := mul_zero a
            _ = b * 0 := (mul_zero b).symm
            _ = b * 1 := by rw [← h10]
            _ = b := mul_one b)
      | succ n ih =>
        rw [pow_succ]
        intro h0
        rcases instNZD.eq_zero_or_eq_zero_of_mul_eq_zero h0 with h1 | h2
        · exact ih h1
        · exact hProd_t_ne h2
    have hSub_nzd : Submonoid.powers s_all ≤ nonZeroDivisors R₁ := by
      rintro _ ⟨n, rfl⟩
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      exact (instNZD.eq_zero_or_eq_zero_of_mul_eq_zero hx).resolve_right (hpow_s_ne n)
    have hinj_ρ_bo : Function.Injective ρ_bo := by
      letI : Algebra R₁ R_bo := ρ_bo.toAlgebra
      have : IsLocalization.Away s_all R_bo := hAff_1.isLocalization_basicOpen s_all
      exact IsLocalization.injective R_bo hSub_nzd
    have hinj_ρ₁ : Function.Injective ρ₁ := by
      have hle_bo_01 : Y_sh.basicOpen s_all ≤ U_0 ⊓ U_1 := le_of_eq hU01_eq.symm
      let res_bo : R₀₁ →+* R_bo :=
        (Y_sh.presheaf.map (CategoryTheory.homOfLE hle_bo_01).op).hom
      have hcomp_bo : ∀ r : R₁, res_bo (ρ₁ r) = ρ_bo r := by
        intro r
        have hmap_eq : Y_sh.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_0 ⊓ U_1 ≤ U_1)).op ≫
            Y_sh.presheaf.map (CategoryTheory.homOfLE hle_bo_01).op =
            Y_sh.presheaf.map (CategoryTheory.homOfLE (Y_sh.basicOpen_le s_all)).op := by
          rw [← Y_sh.presheaf.map_comp]
          rfl
        exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hmap_eq) r
      intro r₁ r₂ hr
      apply hinj_ρ_bo
      rw [← hcomp_bo r₁, ← hcomp_bo r₂, hr]
    letI : Algebra R₁ R₀₁ := algR₁R₀₁
    letI : Algebra R₀ R₀₁ := algR₀R₀₁
    have : IsReduced (TensorProduct R₀ R₀₁ A₀) := hRed_tens0
    have hinj_rT : Function.Injective
        (LinearMap.rTensor A₁ (Algebra.linearMap R₁ R₀₁)) :=
      Module.Flat.rTensor_preserves_injective_linearMap (Algebra.linearMap R₁ R₀₁) hinj_ρ₁
    have hinj_incR : Function.Injective
        (Algebra.TensorProduct.includeRight (R := R₁) (A := R₀₁) (B := A₁)) := by
      intro x₁ x₂ hx
      have htmul : (LinearMap.rTensor A₁ (Algebra.linearMap R₁ R₀₁)) ((1 : R₁) ⊗ₜ[R₁] x₁) =
          (LinearMap.rTensor A₁ (Algebra.linearMap R₁ R₀₁)) ((1 : R₁) ⊗ₜ[R₁] x₂) := by
        change (algebraMap R₁ R₀₁ 1) ⊗ₜ[R₁] x₁ = (algebraMap R₁ R₀₁ 1) ⊗ₜ[R₁] x₂
        rw [map_one]
        exact hx
      simpa using congrArg (TensorProduct.lid R₁ A₁) (hinj_rT htmul)
    let emb_A₁ : A₁ →+* TensorProduct R₀ R₀₁ A₀ :=
      Ψ₀₁.toRingEquiv.toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := R₁) (A := R₀₁) (B := A₁)).toRingHom
    exact isReduced_of_injective emb_A₁ (Ψ₀₁.injective.comp hinj_incR)
  have : IsReduced A₁ := hRed_A₁

  have hStalkRed_Ymid0 : ∀ y : ↥Y_mid0, IsReduced ↑(Y_mid0.presheaf.stalk y) := by
    intro y
    have hy_top : ν.base y ∈ (U_0 ⊔ U_1 : Y_sh.Opens) := by rw [hU_cov]; trivial
    rcases hy_top with hy0 | hy1
    · have hy_rng : y ∈ Set.range ι₀.base := by
        rw [hRangeOfIsPullback hPb₀, U_0.range_ι]; exact hy0
      obtain ⟨x₀, rfl⟩ := hy_rng
      have : IsReduced ↑((AlgebraicGeometry.Spec (CommRingCat.of A₀)).presheaf.stalk x₀) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced
          (AlgebraicGeometry.Spec (CommRingCat.of A₀)) x₀
      let sm₀ := AlgebraicGeometry.Scheme.Hom.stalkMap ι₀ x₀
      have : CategoryTheory.IsIso sm₀ := inferInstance
      let e_sm₀ := (CategoryTheory.asIso sm₀).commRingCatIsoToRingEquiv
      exact isReduced_of_injective e_sm₀.toRingHom e_sm₀.injective
    · have hy_rng : y ∈ Set.range ι₁.base := by
        rw [hRangeOfIsPullback hPb₁, U_1.range_ι]; exact hy1
      obtain ⟨x₁, rfl⟩ := hy_rng
      have : IsReduced ↑((AlgebraicGeometry.Spec (CommRingCat.of A₁)).presheaf.stalk x₁) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced
          (AlgebraicGeometry.Spec (CommRingCat.of A₁)) x₁
      let sm₁ := AlgebraicGeometry.Scheme.Hom.stalkMap ι₁ x₁
      have : CategoryTheory.IsIso sm₁ := inferInstance
      let e_sm₁ := (CategoryTheory.asIso sm₁).commRingCatIsoToRingEquiv
      exact isReduced_of_injective e_sm₁.toRingHom e_sm₁.injective

  have : AlgebraicGeometry.IsReduced Y_mid0 :=
    @AlgebraicGeometry.isReduced_of_isReduced_stalk Y_mid0 hStalkRed_Ymid0
  have hInt_Ymid0 : AlgebraicGeometry.IsIntegral Y_mid0 :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y_mid0

  
  
  
  refine ⟨Y_mid0, ν, τ_ram, Z_et, ι_Z,
    ⟨hFin_ν, hSurj_ν, hInt_Ymid0, hProp_fmid0, hSm_fmid0, hIrred_fmid0, hAff_Wmid0,
      j₀, hj₀_comm, hFin_j₀, hEt_j₀, hSurj_j₀⟩,
    ⟨hτ_ram_spec, fun b => (hEtBdryCharts b).2⟩, ?_⟩
  intro s_sh C₀ C'₀ ι_C₀ ι_C'₀ ν₀ hs_rng hs_sec hPb₀_s hPb'₀_s hComm_s a ha P_a hPa x' _ hν₀_x'
  let a_ram : B₁_ram := ⟨a, ha⟩
  exact weil_bezout_special_fiber_stalk_ramification_pow k ℓ hℓ_pos
    V_sh Y_sh Y_mid0 p_Vsh v_sh f_sh ν (τ_sh a) (hτ_sec a)
    (U_a a) (hAff_Ua a) (h_le_Ua a) (t_loc a) (hker_Ua a)
    (u_ram_of a_ram) (ι_ram_of a_ram) (hPb_ram_of a_ram)
    s_sh C₀ C'₀ ι_C₀ ι_C'₀ ν₀ hs_rng hs_sec hPb₀_s hPb'₀_s hComm_s P_a hPa x' hν₀_x'

theorem weil_rel_curve_cover_ramified_step_residue_kill (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
    (s₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).left)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_C₀ : Quiver.Hom C₀.left P_cur.Y)
    (hIntC : AlgebraicGeometry.IsIntegral C₀.left)
    (hProjC : IsProjectiveOverField k C₀)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom]
    (P_pts : Fin P_cur.m_pts → { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) })
    (c : Fin P_cur.m_pts → ℕ)
    (hs₀_range : Set.range s₀.base = {P_cur.v})
    (hs₀_sec : CategoryTheory.CategoryStruct.comp s₀
      (CategoryTheory.CategoryStruct.comp
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).hom
        E.V_bar.hom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hPb_C₀ : CategoryTheory.IsPullback ι_C₀ C₀.hom P_cur.f_bar s₀)
    (hP_bdry : ∀ a : Fin P_cur.m_pts, ι_C₀.base (P_pts a).1 = (P_cur.τ_bdry a).base P_cur.v)
    (hc_lt : ∀ a : Fin P_cur.m_pts, c a < ℓ)
    (hc_pos : ∃ a₀ : Fin P_cur.m_pts, 1 ≤ c a₀)
    (hDiv_ell : ∃ d₀ : weilCurveClGroup C₀.left,
      ℓ • d₀ = QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C₀.left)
        (Finset.univ.sum fun a : Fin P_cur.m_pts => Finsupp.single (P_pts a) (c a : ℤ))) :
    ∃ (P_mid : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
      (h_V : Quiver.Hom P_mid.V P_cur.V)
      (h_Y : Quiver.Hom P_mid.Y P_cur.Y)
      (h_W : Quiver.Hom P_mid.W P_cur.W)
      (hComm_mid : CategoryTheory.CategoryStruct.comp h_Y P_cur.f_bar =
        CategoryTheory.CategoryStruct.comp P_mid.f_bar
          (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left)),
      (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left.base P_mid.v =
          P_cur.v ∧
        CategoryTheory.CategoryStruct.comp h_W P_cur.u_W = P_mid.u_W ∧
        (TopologicalSpace.Opens.map h_Y.base).obj P_cur.W_open = P_mid.W_open ∧
        CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map h_W).left)
            (CategoryTheory.CategoryStruct.comp P_cur.e_W.hom P_cur.W_open.ι) =
          CategoryTheory.CategoryStruct.comp P_mid.e_W.hom
            (CategoryTheory.CategoryStruct.comp P_mid.W_open.ι h_Y) ∧
        AlgebraicGeometry.IsFinite
          (CategoryTheory.Limits.pullback.lift h_Y P_mid.f_bar hComm_mid) ∧
        AlgebraicGeometry.Surjective
          (CategoryTheory.Limits.pullback.lift h_Y P_mid.f_bar hComm_mid)) ∧
      (∀ (s'₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
            ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_mid.V).left)
          (C'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_C'₀ : Quiver.Hom C'₀.left P_mid.Y)
          (ν₀ : Quiver.Hom C'₀.left C₀.left),
        Set.range s'₀.base = {P_mid.v} →
        CategoryTheory.CategoryStruct.comp s'₀
            (CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_mid.V).hom
              E.V_bar.hom) =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        CategoryTheory.IsPullback ι_C'₀ C'₀.hom P_mid.f_bar s'₀ →
        CategoryTheory.CategoryStruct.comp ι_C'₀ h_Y =
          CategoryTheory.CategoryStruct.comp ν₀ ι_C₀ →
        ∀ (a : Fin P_cur.m_pts), 1 ≤ c a →
          ∀ (x' : ↥C'₀.left),
            IsClosed ({x'} : Set ↥C'₀.left) →
            ν₀.base x' = (P_pts a).1 →
            Ideal.map (AlgebraicGeometry.Scheme.Hom.stalkMap ν₀ x').hom
              (IsLocalRing.maximalIdeal ↑(C₀.left.presheaf.stalk (ν₀.base x'))) =
              (IsLocalRing.maximalIdeal ↑(C'₀.left.presheaf.stalk x')) ^ ℓ) :=
by
  classical
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  haveI : AlgebraicGeometry.IsProper E.V_bar.hom := E.hProp_Vbar
  haveI : AlgebraicGeometry.IsProper E.Y_bar.hom := E.hProp_Ybar

  have hs₀_pt : s₀.base pt_k = P_cur.v := by
    have hmem : s₀.base pt_k ∈ Set.range s₀.base := ⟨pt_k, rfl⟩
    rwa [hs₀_range, Set.mem_singleton_iff] at hmem

  
  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S U₁ U₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom) := by
      rw [hvw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom U₂.prop hEt_comp

  have hClosedImmOfSepSection :
      ∀ {A B : AlgebraicGeometry.Scheme.{u}} (s : A ⟶ B) (p : B ⟶ A)
        [AlgebraicGeometry.IsSeparated p],
        s ≫ p = 𝟙 A →
        AlgebraicGeometry.IsClosedImmersion s := by
    intro A B s p _ hsec
    have : AlgebraicGeometry.IsClosedImmersion (s ≫ p) := by
      rw [hsec]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp s p

  have hSep_of_proper :
      ∀ {A B : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) [AlgebraicGeometry.IsProper f],
        AlgebraicGeometry.IsSeparated f := by
    intro A B f _
    infer_instance

  have hLFT_of_etale :
      ∀ {A B : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) [AlgebraicGeometry.Etale f],
        AlgebraicGeometry.LocallyOfFiniteType f := by
    intro A B f _
    have hfp : AlgebraicGeometry.LocallyOfFinitePresentation f := inferInstance
    rw [AlgebraicGeometry.HasRingHomProperty.iff_appLE
      (P := @AlgebraicGeometry.LocallyOfFiniteType)]
    intro U V e
    exact RingHom.FiniteType.of_finitePresentation
      (AlgebraicGeometry.HasRingHomProperty.appLE
        (@AlgebraicGeometry.LocallyOfFinitePresentation) f hfp U V e)

  have hAffHom_of_closed :
      ∀ {A B : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) [AlgebraicGeometry.IsClosedImmersion f],
        AlgebraicGeometry.IsAffineHom f := by
    intro A B f _
    infer_instance

  have hAffHom_of_finite :
      ∀ {A B : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) [AlgebraicGeometry.IsFinite f],
        AlgebraicGeometry.IsAffineHom f := by
    intro A B f _
    haveI : AlgebraicGeometry.IsIntegralHom f := inferInstance
    exact AlgebraicGeometry.IsIntegralHom.toIsAffineHom

  have hAffHom_comp :
      ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C),
        AlgebraicGeometry.IsAffineHom f →
        AlgebraicGeometry.IsAffineHom g →
        AlgebraicGeometry.IsAffineHom (f ≫ g) :=
    fun _ _ hf hg => ⟨fun _ hU => (hU.preimage _).preimage _⟩

  have hLFT_of_isProper :
      ∀ {A B : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) [AlgebraicGeometry.IsProper f],
        AlgebraicGeometry.LocallyOfFiniteType f := by
    intro A B f _
    infer_instance

  have hLFT_of_isIso :
      ∀ {A B : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) [CategoryTheory.IsIso f],
        AlgebraicGeometry.LocallyOfFiniteType f := by
    intro A B f _
    haveI : AlgebraicGeometry.Etale f := inferInstance
    exact hLFT_of_etale f

  have hLFT_comp :
      ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C),
        AlgebraicGeometry.LocallyOfFiniteType f →
        AlgebraicGeometry.LocallyOfFiniteType g →
        AlgebraicGeometry.LocallyOfFiniteType (f ≫ g) :=
    fun f g hf hg =>
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.LocallyOfFiniteType) f g hf hg

  have hEt_comp :
      ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
        [AlgebraicGeometry.Etale f] [AlgebraicGeometry.Etale g],
        AlgebraicGeometry.Etale (f ≫ g) := by
    intro A B C f g _ _
    infer_instance

  have hSurj_comp :
      ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C),
        AlgebraicGeometry.Surjective f →
        AlgebraicGeometry.Surjective g →
        AlgebraicGeometry.Surjective (f ≫ g) :=
    fun f g hf hg =>
      ⟨fun z =>
        let ⟨y, hy⟩ := hg.surj z
        let ⟨x, hx⟩ := hf.surj y
        ⟨x, by change g.base (f.base x) = z; rw [hx, hy]⟩⟩

  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W] (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      exact hLFT_comp e_W.inv p_W (hLFT_of_isIso e_W.inv) ‹_›
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_B : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_B (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_k := by
      dsimp [s]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_k : PrimeSpectrum k).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_hom_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k) = x
    rw [hs_pt_spec]
    change (e_W.hom ≫ e_W.inv).base x = x
    rw [e_W.hom_inv_id]
    rfl

  have hClosedOfSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) (s : S_k ⟶ W),
        s ≫ p_W = 𝟙 S_k →
        IsClosed ({s.base pt_k} : Set ↥W) := by
    intro W _ p_W s hs
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    let ψ : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s ≫ e_W.hom)
    have hφψ : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_W.hom, e_W.hom_inv_id,
        CategoryTheory.Category.id_comp, hs, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ.hom := fun c =>
      ⟨φ_k.hom c, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφψ⟩
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := (AlgebraicGeometry.Spec.map ψ).base pt_k
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_max : q_spec.asIdeal.IsMaximal := by
      change (Ideal.comap ψ.hom (pt_k : PrimeSpectrum k).asIdeal).IsMaximal
      rw [hpt_bot]
      haveI : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      exact Ideal.comap_isMaximal_of_surjective ψ.hom hψ_surj
    have hq_cl : IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mpr hq_max
    have hpre : ({s.base pt_k} : Set ↥W) =
        e_W.hom.base ⁻¹' ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) := by
      have hq_eq : q_pt = e_W.hom.base (s.base pt_k) := by
        dsimp [q_pt, ψ]
        rw [AlgebraicGeometry.Spec.map_preimage]
        rfl
      rw [hq_eq]
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; rfl
      · intro hz
        have hz' := congrArg e_W.inv.base hz
        change (e_W.hom ≫ e_W.inv).base z = (e_W.hom ≫ e_W.inv).base (s.base pt_k) at hz'
        rwa [e_W.hom_inv_id] at hz'
    rw [hpre]
    exact hq_cl.preimage e_W.hom.continuous

  have hClosedImmOfSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) (s : S_k ⟶ W),
        s ≫ p_W = 𝟙 S_k →
        AlgebraicGeometry.IsClosedImmersion s := by
    intro W _ p_W s hs
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    let ψ : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s ≫ e_W.hom)
    have hφψ : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_W.hom, e_W.hom_inv_id,
        CategoryTheory.Category.id_comp, hs, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ.hom := fun c =>
      ⟨φ_k.hom c, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφψ⟩
    have hCl_ψ : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map ψ) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective ψ hψ_surj
    have hs_eq : s = AlgebraicGeometry.Spec.map ψ ≫ e_W.inv := by
      dsimp [ψ]
      rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        e_W.hom_inv_id, CategoryTheory.Category.comp_id]
    rw [hs_eq]
    exact (CategoryTheory.MorphismProperty.cancel_right_of_respectsIso
      (@AlgebraicGeometry.IsClosedImmersion) (AlgebraicGeometry.Spec.map ψ) e_W.inv).mpr hCl_ψ

  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine V]
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = 𝟙 S_k →
        s₂ ≫ p_V = 𝟙 S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V _ p_V s₁ s₂ hs₁ hs₂ hpt
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hpt
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp

  have hIrredTransfer :
      ∀ {Y_new Y_old V_new V_old S : AlgebraicGeometry.Scheme.{u}}
        (j_Y : Y_new ⟶ Y_old) (f_new : Y_new ⟶ V_new)
        (f_old : Y_old ⟶ V_old) (j_V : V_new ⟶ V_old),
        CategoryTheory.IsPullback j_Y f_new f_old j_V →
        ∀ (s : S ⟶ V_new),
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_old (s ≫ j_V)) →
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_new s) := by
    intro Y_new Y_old V_new V_old S j_Y f_new f_old j_V hPb s hIrred
    have hPb_paste : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_new s ≫ j_Y)
        (CategoryTheory.Limits.pullback.snd f_new s) f_old (s ≫ j_V) :=
      CategoryTheory.IsPullback.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f_new s) hPb
    let e := hPb_paste.isoPullback
    have hsurj : Function.Surjective e.inv.base := fun x =>
      ⟨e.hom.base x, by change (e.hom ≫ e.inv).base x = x; rw [e.hom_inv_id]; rfl⟩
    have huniv : IsIrreducible (Set.univ : Set ↥(CategoryTheory.Limits.pullback f_new s)) := by
      rw [← Set.image_univ_of_surjective hsurj]
      exact hIrred.isIrreducible_univ.image e.inv.base e.inv.continuous.continuousOn
    exact { isPreirreducible_univ := huniv.isPreirreducible
            toNonempty := ⟨e.inv.base (Classical.choice hIrred.toNonempty)⟩ }

  have hEtaleBaseChangeIntegral :
      ∀ {V_b Y_b Y_t : AlgebraicGeometry.Scheme.{u}}
        [AlgebraicGeometry.IsAffine V_b]
        [AlgebraicGeometry.IsIntegral V_b]
        [AlgebraicGeometry.IsIntegral Y_b]
        (f_t : Y_t ⟶ V_b) [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_t]
        (q_t : Y_t ⟶ Y_b) [AlgebraicGeometry.Etale q_t],
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V_b),
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_t s)) →
        AlgebraicGeometry.IsIntegral Y_t := by
    intro V_b Y_b Y_t _ _ _ f_t _ q_t _ hIrred_t
    haveI : AlgebraicGeometry.Smooth f_t :=
      AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 f_t
    haveI : AlgebraicGeometry.Flat f_t := inferInstance
    haveI : AlgebraicGeometry.LocallyOfFinitePresentation f_t := inferInstance
    haveI : AlgebraicGeometry.UniversallyOpen f_t := inferInstance
    have hOpen_f : IsOpenMap ⇑f_t.base := f_t.isOpenMap
    haveI : IrreducibleSpace ↥V_b := AlgebraicGeometry.irreducibleSpace_of_isIntegral V_b
    let e_Vb := V_b.isoSpec
    let R_Vb := V_b.presheaf.obj (Opposite.op ⊤)
    have hGeomPtAt : ∀ v : ↥V_b,
        ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω)
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V_b)
          (pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
          s.base pt_Ω = v := by
      intro v
      let p_v : PrimeSpectrum ↑R_Vb := e_Vb.hom.base v
      haveI : p_v.asIdeal.IsPrime := p_v.isPrime
      let Q_v := ↑R_Vb ⧸ p_v.asIdeal
      let K_v := FractionRing Q_v
      let Ω_v := AlgebraicClosure K_v
      let φ_v : ↑R_Vb →+* Ω_v :=
        (algebraMap K_v Ω_v).comp ((algebraMap Q_v K_v).comp (Ideal.Quotient.mk p_v.asIdeal))
      let s_v : AlgebraicGeometry.Spec (CommRingCat.of Ω_v) ⟶ V_b :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_v) ≫ e_Vb.inv
      let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_v)) :=
        (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω_v)
      refine ⟨Ω_v, inferInstance, inferInstance, s_v, pt_Ω, ?_⟩
      have hspec_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_v)).base pt_Ω = p_v := by
        apply PrimeSpectrum.ext
        change Ideal.comap φ_v (⊥ : Ideal Ω_v) = p_v.asIdeal
        ext r
        simp only [Ideal.mem_comap, Ideal.mem_bot, φ_v, RingHom.coe_comp, Function.comp_apply]
        have hinj₁ : Function.Injective (algebraMap K_v Ω_v) := RingHom.injective _
        have hinj₂ : Function.Injective (algebraMap Q_v K_v) := IsFractionRing.injective Q_v K_v
        rw [← map_zero (algebraMap K_v Ω_v), hinj₁.eq_iff, ← map_zero (algebraMap Q_v K_v),
          hinj₂.eq_iff, Ideal.Quotient.eq_zero_iff_mem]
      change e_Vb.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_v)).base pt_Ω) = v
      rw [hspec_eq]
      change (e_Vb.hom ≫ e_Vb.inv).base v = v
      rw [e_Vb.hom_inv_id]
      rfl
    have hNe_Yt : Nonempty ↥Y_t := by
      obtain ⟨v₀⟩ := (inferInstance : Nonempty ↥V_b)
      obtain ⟨Ω₀, hF₀, hAlg₀, s₀_v, _, _⟩ := hGeomPtAt v₀
      letI := hF₀; letI := hAlg₀
      have hI₀ := hIrred_t Ω₀ s₀_v
      exact ⟨(CategoryTheory.Limits.pullback.fst f_t s₀_v).base (Classical.choice hI₀.toNonempty)⟩
    haveI : IrreducibleSpace ↥Y_t := by
      refine { isPreirreducible_univ := ?_, toNonempty := hNe_Yt }
      intro U₁ U₂ hU₁ hU₂ hne₁ hne₂
      obtain ⟨y₁, _, hy₁⟩ := hne₁
      obtain ⟨y₂, _, hy₂⟩ := hne₂
      obtain ⟨v, _, ⟨y₁', hy₁', hv₁⟩, ⟨y₂', hy₂', hv₂⟩⟩ :=
        (inferInstance : IrreducibleSpace ↥V_b).isIrreducible_univ.isPreirreducible
          (f_t.base '' U₁) (f_t.base '' U₂) (hOpen_f U₁ hU₁) (hOpen_f U₂ hU₂)
          ⟨f_t.base y₁, trivial, ⟨y₁, hy₁, rfl⟩⟩ ⟨f_t.base y₂, trivial, ⟨y₂, hy₂, rfl⟩⟩
      obtain ⟨Ω_v, hFv, hAlgv, s_v, pt_Ω, hs_pt⟩ := hGeomPtAt v
      letI := hFv; letI := hAlgv
      have hIv := hIrred_t Ω_v s_v
      let fst_v := CategoryTheory.Limits.pullback.fst f_t s_v
      obtain ⟨z₁, hz₁, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁' pt_Ω (hv₁.trans hs_pt.symm)
      obtain ⟨z₂, hz₂, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₂' pt_Ω (hv₂.trans hs_pt.symm)
      obtain ⟨z, _, hzU₁, hzU₂⟩ :=
        hIv.isIrreducible_univ.isPreirreducible
          (fst_v.base ⁻¹' U₁) (fst_v.base ⁻¹' U₂)
          (hU₁.preimage fst_v.continuous) (hU₂.preimage fst_v.continuous)
          ⟨z₁, trivial, by rw [Set.mem_preimage, hz₁]; exact hy₁'⟩
          ⟨z₂, trivial, by rw [Set.mem_preimage, hz₂]; exact hy₂'⟩
      exact ⟨fst_v.base z, trivial, hzU₁, hzU₂⟩
    haveI : ∀ y : ↥Y_t, IsReduced ↑(Y_t.presheaf.stalk y) := by
      intro y
      obtain ⟨U_b, hAff_Ub, hy_Ub, _⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y_b.isBasis_affineOpens)
          (show q_t.base y ∈ (⊤ : Y_b.Opens) from trivial)
      obtain ⟨W_t, hAff_Wt, hy_Wt, hW_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y_t.isBasis_affineOpens)
          (show y ∈ (TopologicalSpace.Opens.map q_t.base).obj U_b from hy_Ub)
      haveI : Nonempty U_b := ⟨⟨q_t.base y, hy_Ub⟩⟩
      let R_b : Type u := ↑(Y_b.presheaf.obj (Opposite.op U_b))
      let R_t : Type u := ↑(Y_t.presheaf.obj (Opposite.op W_t))
      haveI : IsDomain R_b := inferInstance
      have hEt_hom : (q_t.appLE U_b W_t hW_le).hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) q_t inferInstance
          ⟨U_b, hAff_Ub⟩ ⟨W_t, hAff_Wt⟩ hW_le
      letI : Algebra R_b R_t := (q_t.appLE U_b W_t hW_le).hom.toAlgebra
      haveI : Algebra.Etale R_b R_t := RingHom.etale_algebraMap.mp hEt_hom
      let K_b := FractionRing R_b
      let T_K := TensorProduct R_b K_b R_t
      haveI : Algebra.Etale K_b T_K := Algebra.Etale.baseChange R_b R_t K_b
      have hRed_TK : IsReduced T_K := Algebra.FormallyUnramified.isReduced_of_field K_b T_K
      let ι_lin : R_b →ₗ[R_b] K_b := Algebra.linearMap R_b K_b
      have hinj_rT : Function.Injective (LinearMap.rTensor R_t ι_lin) :=
        Module.Flat.rTensor_preserves_injective_linearMap ι_lin
          (IsFractionRing.injective R_b K_b)
      have hRed_Rt : IsReduced R_t := by
        refine ⟨fun r ⟨n, hn⟩ => ?_⟩
        have hTK_zero : Algebra.TensorProduct.includeRight (R := R_b) (A := K_b)
            (B := R_t) r = 0 :=
          hRed_TK.eq_zero _ ⟨n, by rw [← map_pow, hn, map_zero]⟩
        have htmul0 : (LinearMap.rTensor R_t ι_lin) ((1 : R_b) ⊗ₜ[R_b] r) =
            (LinearMap.rTensor R_t ι_lin) 0 := by
          rw [map_zero]
          change (algebraMap R_b K_b 1) ⊗ₜ[R_b] r = 0
          rw [map_one]
          exact hTK_zero
        have h1r0 : (1 : R_b) ⊗ₜ[R_b] r = 0 := hinj_rT htmul0
        simpa using congrArg (TensorProduct.lid R_b R_t) h1r0
      let y_W : ↥W_t := ⟨y, hy_Wt⟩
      let Stk := ↑(Y_t.presheaf.stalk ↑y_W)
      letI : Algebra R_t Stk := TopCat.Presheaf.algebra_section_stalk Y_t.presheaf y_W
      haveI := hAff_Wt.isLocalization_stalk y_W
      let M_y := (hAff_Wt.primeIdealOf y_W).asIdeal.primeCompl
      change IsReduced Stk
      refine ⟨fun s ⟨n, hn⟩ => ?_⟩
      obtain ⟨⟨r, m_s⟩, hsec⟩ := IsLocalization.surj M_y s
      have hrn : algebraMap R_t Stk (r ^ n) = 0 := by
        rw [map_pow, ← hsec, mul_pow, hn, zero_mul]
      obtain ⟨m', hm'⟩ := (IsLocalization.map_eq_zero_iff M_y Stk (r ^ n)).mp hrn
      have hpow0 : ((m' : R_t) * r) ^ (n + 1) = 0 := by
        calc
          ((m' : R_t) * r) ^ (n + 1)
            = (m' : R_t) ^ n * r * ((m' : R_t) * r ^ n) := by ring
          _ = (m' : R_t) ^ n * r * 0 := by rw [hm']
          _ = 0 := mul_zero _
      have hmr0 : (m' : R_t) * r = 0 := hRed_Rt.eq_zero _ ⟨n + 1, hpow0⟩
      have hs_mul : (s * algebraMap R_t Stk m_s) * algebraMap R_t Stk m' = 0 := by
        rw [hsec, ← map_mul, mul_comm r (m' : R_t), hmr0, map_zero]
      let u1 := (IsLocalization.map_units Stk m_s).unit
      let u2 := (IsLocalization.map_units Stk m').unit
      have hu1_val : (u1 : Stk) = algebraMap R_t Stk m_s := IsUnit.unit_spec _
      have hu2_val : (u2 : Stk) = algebraMap R_t Stk m' := IsUnit.unit_spec _
      calc
        s = ((s * (u1 : Stk)) * (u2 : Stk)) * (↑u2⁻¹ * ↑u1⁻¹) := by
          rw [mul_assoc (s * (u1 : Stk)), ← mul_assoc (u2 : Stk), Units.mul_inv, one_mul,
            mul_assoc, Units.mul_inv, mul_one]
        _ = 0 * (↑u2⁻¹ * ↑u1⁻¹) := by rw [hu1_val, hu2_val, hs_mul]
        _ = 0 := zero_mul _
    haveI : AlgebraicGeometry.IsReduced Y_t :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk Y_t
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y_t

  have hEtaleClosedFiberPt :
      ∀ {V_base W_et : AlgebraicGeometry.Scheme.{u}}
        [AlgebraicGeometry.IsAffine V_base] [AlgebraicGeometry.IsAffine W_et]
        (p_base : V_base ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_base]
        (v_pt : ↥V_base) (hv_cl : IsClosed ({v_pt} : Set ↥V_base))
        (w_et : W_et ⟶ V_base) [AlgebraicGeometry.Etale w_et]
        (x_et : ↥W_et),
        w_et.base x_et = v_pt →
        IsClosed ({x_et} : Set ↥W_et) := by
    intro V_base W_et _ _ p_base _ v_pt hv_cl w_et _ x_et hx_map
    obtain ⟨s_base, hs_base_sec, hs_base_pt⟩ := hClosedPtSection p_base v_pt hv_cl
    haveI : AlgebraicGeometry.IsClosedImmersion s_base :=
      hClosedImmOfSection p_base s_base hs_base_sec
    let P_fib := CategoryTheory.Limits.pullback w_et s_base
    let fst_fib : P_fib ⟶ W_et := CategoryTheory.Limits.pullback.fst w_et s_base
    let snd_fib : P_fib ⟶ S_k := CategoryTheory.Limits.pullback.snd w_et s_base
    haveI : AlgebraicGeometry.IsAffine P_fib := inferInstance
    haveI : AlgebraicGeometry.IsClosedImmersion fst_fib :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback w_et s_base).flip inferInstance
    haveI : AlgebraicGeometry.Etale snd_fib :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback w_et s_base) inferInstance
    obtain ⟨z_fib, hz_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        x_et pt_k (hx_map.trans hs_base_pt.symm)
    have hz_cl : IsClosed ({z_fib} : Set ↥P_fib) := by
      let eP := P_fib.isoSpec
      let R_cat := P_fib.presheaf.obj (Opposite.op ⊤)
      let φ_k : CommRingCat.of k ⟶ R_cat :=
        AlgebraicGeometry.Spec.preimage (eP.inv ≫ snd_fib)
      have hmap : AlgebraicGeometry.Spec.map φ_k = eP.inv ≫ snd_fib :=
        AlgebraicGeometry.Spec.map_preimage _
      haveI : AlgebraicGeometry.Etale eP.inv := inferInstance
      have hEt_hom : φ_k.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hmap.symm ▸ hEt_comp eP.inv snd_fib)
      letI : Algebra k ↑R_cat := φ_k.hom.toAlgebra
      haveI : Algebra.Etale k ↑R_cat := RingHom.etale_algebraMap.mp hEt_hom
      obtain ⟨I_idx, _, Fi, hFieldFi, _, e_prod, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod k ↑R_cat).mp inferInstance
      letI := hFieldFi
      let q : PrimeSpectrum ↑R_cat := eP.hom.base z_fib
      have hq_max : q.asIdeal.IsMaximal := by
        rw [Ideal.isMaximal_iff]
        refine ⟨q.isPrime.one_notMem, fun J x hqJ hx_not_q hxJ => ?_⟩
        let fx := e_prod x
        let fy : ∀ i : I_idx, Fi i := fun i => if fx i = 0 then 0 else (fx i)⁻¹
        let fe : ∀ i : I_idx, Fi i := fun i => if fx i = 0 then 1 else 0
        have hmul_zero : x * e_prod.symm fe = 0 := by
          apply e_prod.injective
          rw [map_mul, e_prod.apply_symm_apply, map_zero]
          funext i
          change fx i * fe i = 0
          dsimp [fe]
          split_ifs with h0
          · rw [h0, zero_mul]
          · rw [mul_zero]
        have hsum_one : x * e_prod.symm fy + e_prod.symm fe = 1 := by
          apply e_prod.injective
          rw [map_add, map_mul, e_prod.apply_symm_apply, e_prod.apply_symm_apply, map_one]
          funext i
          change fx i * fy i + fe i = 1
          dsimp [fy, fe]
          split_ifs with h0
          · rw [h0, zero_mul, zero_add]
          · rw [mul_inv_cancel₀ h0, add_zero]
