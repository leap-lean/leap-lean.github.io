    rw [hι_sec_nat Φ]
    congr 1
    apply congrArg Additive.ofMul
    change (((Units.map ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).appTop).hom.toMonoidHom).comp
        (Units.map e_A.inv.hom.toMonoidHom)) u) =
      (((Units.map e_B.inv.hom.toMonoidHom).comp (Units.map f.toMonoidHom)) u)
