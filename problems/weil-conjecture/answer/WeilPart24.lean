      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hsq_comm
          (fun s => CommRingCat.ofHom
            (Ideal.Quotient.lift (Ideal.span ({z₀} : Set R)) s.inr.hom (hs_ker s)))
