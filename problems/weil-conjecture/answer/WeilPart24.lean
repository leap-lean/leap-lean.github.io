            rw [mul_assoc, ← mul_pow, Units.mul_inv, one_pow, mul_one]
          _ = ρ_a a (t_sh a * q) * (↑(u_s⁻¹) : R_a a) ^ n := by
            rw [hu_s_val, hsec']
          _ = t_loc a * (ρ_a a q * (↑(u_s⁻¹) : R_a a) ^ n) := by
            rw [map_mul, mul_assoc]
