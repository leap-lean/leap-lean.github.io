        (algebraMap D.R₀₁ B₀₀₁).comp (algebraMap D.R₀ D.R₀₁) := by
      ext r₀
      exact (congrArg q₀₀₁_₁₂ (RingHom.congr_fun hmap₀₀_alg r₀)).trans
        (q₀₀₁_₁₂.commutes (algebraMap D.R₀ D.R₀₁ r₀))
    have hψ₀ : ψ₀.comp (algebraMap D.R₀ T₀) =
        (algebraMap D.R₀₁ B₀₀₁).comp (algebraMap D.R₀ D.R₀₁) := by
      rw [RingHom.comp_assoc, hι₀₀_L_alg, hφ₁₂_alg]
    have hψ₁ : ψ₁.comp (algebraMap D.R₀ T₀) =
        (algebraMap D.R₀₁ B₀₀₁).comp (algebraMap D.R₀ D.R₀₁) := by
      rw [RingHom.comp_assoc, hι₀₀_R_alg, hφ₁₂_alg]
    have hψ₂ : ψ₂.comp (algebraMap D.R₁ T₁) =
        (algebraMap D.R₀₁ B₀₀₁).comp (algebraMap D.R₁ D.R₀₁) := by
      ext r₁
      change (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := A₀₀_ov) (B := T₁_ov))
        ((Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁))
          (algebraMap D.R₁ T₁ r₁)) = algebraMap D.R₀₁ B₀₀₁ (algebraMap D.R₁ D.R₀₁ r₁)
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply D.R₁ D.R₀₁ T₁_ov, AlgHom.commutes]
    have h₀₁ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ inl_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ inl_c) ≫ g_cov :=
      (hinl_spec_ov ψ₀ hψ₀).trans (hinl_spec_ov ψ₁ hψ₁).symm
    have h₀₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ inl_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫ inr_c) ≫ g_cov :=
      (hinl_spec_ov ψ₀ hψ₀).trans (hinr_spec_ov ψ₂ hψ₂).symm
    have htri := triple_cocycle_eq
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ inl_c)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ inl_c)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫ inr_c) h₀₁ h₀₂
    have hl₀₁ := eval_lift_rings inl_c inl_c ι₀₀_L ι₀₀_R hcomm₀₀ ψ₀ ψ₁ h₀₁ φ₁₂ rfl rfl
    have hl₀₂ := eval_lift_rings inl_c inr_c ι₀₁_L ι₀₁_R hcomm₀₁ ψ₀ ψ₂ h₀₂ q₀₀₁_₁₃.toRingHom
      (by
        ext t
        change (Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeLeft (R := D.R₀₁)))
          (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _))
            (((1 : D.R₀₁) ⊗ₜ[D.R₀] t) ⊗ₜ[D.R₀₁] 1) = q₀₀₁_₁₂ (map₀₀ (t ⊗ₜ[D.R₀] 1))
        rw [hmap₀₀_tmul, Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl)
      (by
        ext t
        change (Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeLeft (R := D.R₀₁)))
          (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _))
            (1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) = 1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl)
    have hl₁₂ := eval_lift_rings inl_c inr_c ι₀₁_L ι₀₁_R hcomm₀₁ ψ₁ ψ₂ (h₀₁.symm.trans h₀₂) q₀₀₁_₂₃.toRingHom
      (by
        ext t
        change (Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeRight (R := D.R₀₁)))
          (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _))
            (((1 : D.R₀₁) ⊗ₜ[D.R₀] t) ⊗ₜ[D.R₀₁] 1) = q₀₀₁_₁₂ (map₀₀ (1 ⊗ₜ[D.R₀] t))
        rw [hmap₀₀_tmul, Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl)
      (by
        ext t
        change (Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeRight (R := D.R₀₁)))
          (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _))
            (1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) = 1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl)
    rw [hl₀₂, hl₀₁, hl₁₂] at htri
    exact congrArg Units.val htri

  
  let B₀₁₁ := TensorProduct D.R₀₁ A₀₁ T₁_ov
  have hConj5 : q₀₁₁_₁₃ (q_T.g₀₁ : A₀₁) =
      q₀₁₁_₁₂ (q_T.g₀₁ : A₀₁) * q₀₁₁_₂₃ (map₁₁ (q_T.g₁₁ : A₁₁)) := by
    let φ₂₃ : A₁₁ →+* B₀₁₁ := q₀₁₁_₂₃.toRingHom.comp map₁₁
    let ψ₀ : T₀ →+* B₀₁₁ := q₀₁₁_₁₂.toRingHom.comp ι₀₁_L
    let ψ₁ : T₁ →+* B₀₁₁ := q₀₁₁_₁₂.toRingHom.comp ι₀₁_R
    let ψ₂ : T₁ →+* B₀₁₁ :=
      (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := A₀₁) (B := T₁_ov)).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom
    have hψ₀ : ψ₀.comp (algebraMap D.R₀ T₀) =
        (algebraMap D.R₀₁ B₀₁₁).comp (algebraMap D.R₀ D.R₀₁) := by
      ext r₀
      exact (congrArg q₀₁₁_₁₂ (RingHom.congr_fun hι₀₁_L_alg r₀)).trans
        (q₀₁₁_₁₂.commutes (algebraMap D.R₀ D.R₀₁ r₀))
    have hψ₁ : ψ₁.comp (algebraMap D.R₁ T₁) =
        (algebraMap D.R₀₁ B₀₁₁).comp (algebraMap D.R₁ D.R₀₁) := by
      ext r₁
      exact (congrArg q₀₁₁_₁₂ (RingHom.congr_fun hι₀₁_R_alg r₁)).trans
        (q₀₁₁_₁₂.commutes (algebraMap D.R₁ D.R₀₁ r₁))
    have hψ₂ : ψ₂.comp (algebraMap D.R₁ T₁) =
        (algebraMap D.R₀₁ B₀₁₁).comp (algebraMap D.R₁ D.R₀₁) := by
      ext r₁
      change (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := A₀₁) (B := T₁_ov))
        ((Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁))
          (algebraMap D.R₁ T₁ r₁)) = algebraMap D.R₀₁ B₀₁₁ (algebraMap D.R₁ D.R₀₁ r₁)
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply D.R₁ D.R₀₁ T₁_ov, AlgHom.commutes]
    have h₀₁ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ inl_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ inr_c) ≫ g_cov :=
      (hinl_spec_ov ψ₀ hψ₀).trans (hinr_spec_ov ψ₁ hψ₁).symm
    have h₀₂ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ inl_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫ inr_c) ≫ g_cov :=
      (hinl_spec_ov ψ₀ hψ₀).trans (hinr_spec_ov ψ₂ hψ₂).symm
    have htri := triple_cocycle_eq
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ inl_c)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ inr_c)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫ inr_c) h₀₁ h₀₂
    have hl₀₁ := eval_lift_rings inl_c inr_c ι₀₁_L ι₀₁_R hcomm₀₁ ψ₀ ψ₁ h₀₁ q₀₁₁_₁₂.toRingHom rfl rfl
    have hl₀₂ := eval_lift_rings inl_c inr_c ι₀₁_L ι₀₁_R hcomm₀₁ ψ₀ ψ₂ h₀₂ q₀₁₁_₁₃.toRingHom
      (by
        ext t
        change q₀₁₁_₁₃ (((1 : D.R₀₁) ⊗ₜ[D.R₀] t) ⊗ₜ[D.R₀₁] (1 : T₁_ov)) =
          (((1 : D.R₀₁) ⊗ₜ[D.R₀] t) ⊗ₜ[D.R₀₁] (1 : T₁_ov)) ⊗ₜ[D.R₀₁] (1 : T₁_ov)
        dsimp only [q₀₁₁_₁₃]
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl)
      (by
        ext t
        change q₀₁₁_₁₃ ((1 : T₀_ov) ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) =
          (1 : A₀₁) ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)
        dsimp only [q₀₁₁_₁₃]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl)
    have hl₁₂ := eval_lift_rings inr_c inr_c ι₁₁_L ι₁₁_R hcomm₁₁ ψ₁ ψ₂ (h₀₁.symm.trans h₀₂) φ₂₃
      (by
        ext t
        change q₀₁₁_₂₃ (map₁₁ (t ⊗ₜ[D.R₁] 1)) =
          (1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) ⊗ₜ[D.R₀₁] 1
        rw [hmap₁₁_tmul]
        change (Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeRight (R := D.R₀₁)))
          (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _))
            (((1 : D.R₀₁) ⊗ₜ[D.R₁] t) ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] 1)) =
              (1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) ⊗ₜ[D.R₀₁] 1
        rw [Algebra.TensorProduct.lift_tmul]
        change ((1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) ⊗ₜ[D.R₀₁] 1) * (1 : B₀₁₁) = _
        exact mul_one _)
      (by
        ext t
        change q₀₁₁_₂₃ (map₁₁ (1 ⊗ₜ[D.R₁] t)) =
          1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)
        rw [hmap₁₁_tmul]
        change (Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := D.R₀₁)).comp (Algebra.TensorProduct.includeRight (R := D.R₀₁)))
          (Algebra.TensorProduct.includeRight (R := D.R₀₁)) (fun _ _ => Commute.all _ _))
            (((1 : D.R₀₁) ⊗ₜ[D.R₁] 1) ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) =
              1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)
        rw [Algebra.TensorProduct.lift_tmul]
        change (1 : B₀₁₁) * (1 ⊗ₜ[D.R₀₁] ((1 : D.R₀₁) ⊗ₜ[D.R₁] t)) = _
        exact one_mul _)
    rw [hl₀₂, hl₀₁, hl₁₂] at htri
    exact congrArg Units.val htri

  exact ⟨hConj1, hConj2, hConj3, hConj4, hConj5⟩

theorem weil_twoChart_bundle_zariski_cocycle_and_cech_bridge (Z : AlgebraicGeometry.Scheme.{u})
    {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (j₀ : AlgebraicGeometry.Spec (CommRingCat.of D.R₀) ⟶ Z)
    [AlgebraicGeometry.IsOpenImmersion j₀]
    (j₁ : AlgebraicGeometry.Spec (CommRingCat.of D.R₁) ⟶ Z)
    [AlgebraicGeometry.IsOpenImmersion j₁]
    (hCov : Set.range j₀.base ∪ Set.range j₁.base = Set.univ)
    (hPb : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ D.R₀₁)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D.R₀₁)))
      j₀ j₁)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁]
    [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    [Algebra.Etale D.R₀ T₀] [Algebra.Etale D.R₁ T₁]
    (hSurj₀ : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀))))
    (hSurj₁ : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁))))
    (hEt_T : AlgebraicGeometry.Etale
      (CategoryTheory.Limits.coprod.desc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁))) :
    let g_cov := CategoryTheory.Limits.coprod.desc
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁)
    let W_T : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g_cov hEt_T
    let w_T : W_T ⟶ weilEtaleIdTerminal.{u} Z := (weilEtaleIdTerminalIsTerminal.{u} Z).from W_T
    ∀ (hw_T : AlgebraicGeometry.Surjective w_T.left)
      (c_T : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z) w_T 1).ker)
      (q_T : WeilTwoChartUnitQuad D T₀ T₁),
      WeilMatchesTwoChartQuad Z D T₀ T₁ W_T rfl w_T c_T.1 q_T →
      ∀ (E : WeilTwoChartLineBundle D)
        (e₀_T : TensorProduct D.R₀ T₀ E.L₀ ≃ₗ[T₀] T₀)
        (e₁_T : TensorProduct D.R₁ T₁ E.L₁ ≃ₗ[T₁] T₁),
        WeilIsTwoChartBundleCocycle D E T₀ T₁ e₀_T e₁_T q_T →
        (∀ (R L : Type u) [CommRing R] [AddCommGroup L] [Module R L] [Module.Invertible R L],
          ∃ (n : ℕ) (f : Fin n → R)
            (_ : ∀ a : Fin n,
              TensorProduct R (Localization.Away (f a)) L ≃ₗ[Localization.Away (f a)]
                Localization.Away (f a)),
            Finset.univ.sum f = 1) →
        ∀ (cechCl : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
            (w : W ⟶ weilEtaleIdTerminal.{u} S),
            AlgebraicGeometry.Surjective w.left →
            ↥(weilEtaleCechDiff (weilEtaleGmPresheaf S) w 1).ker →+ (weilEtaleGmSheaf S).H 1),
          (∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
              (w : W ⟶ weilEtaleIdTerminal.{u} S) (hw : AlgebraicGeometry.Surjective w.left)
              (c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf S) w 1).ker),
            cechCl S W w hw c = 0 ↔
              ∃ b : ↑((weilEtaleGmPresheaf S).obj (Opposite.op (weilEtaleCechObj w 0))),
                weilEtaleCechDiff (weilEtaleGmPresheaf S) w 0 b = c.1) →
          (∀ (S : AlgebraicGeometry.Scheme.{u})
              (W W' : S.Etale)
              (w : W ⟶ weilEtaleIdTerminal.{u} S) (hw : AlgebraicGeometry.Surjective w.left)
              (w' : W' ⟶ weilEtaleIdTerminal.{u} S) (hw' : AlgebraicGeometry.Surjective w'.left)
              (f_W : W'.left ⟶ W.left) (_ : f_W ≫ W.hom = W'.hom)
              (f_W₂ : (weilEtaleCechObj w' 1).left ⟶ (weilEtaleCechObj w 1).left),
            f_W₂ ≫ (weilEtaleCechProj w 1 0).left = (weilEtaleCechProj w' 1 0).left ≫ f_W →
            f_W₂ ≫ (weilEtaleCechProj w 1 1).left = (weilEtaleCechProj w' 1 1).left ≫ f_W →
            ∀ c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf S) w 1).ker,
              let c' : ↑((weilEtaleGmPresheaf S).obj (Opposite.op (weilEtaleCechObj w' 1))) :=
                (MonoidHom.toAdditive (Units.map f_W₂.appTop.hom.toMonoidHom)) c.1
              ∃ hc' : c' ∈ (weilEtaleCechDiff (weilEtaleGmPresheaf S) w' 1).ker,
                cechCl S W' w' hw' ⟨c', hc'⟩ = cechCl S W w hw c) →
          (∀ {Z₀ S : AlgebraicGeometry.Scheme.{u}} (h : Z₀ ⟶ S)
              (p_Gm : (weilEtaleGmSheaf S).H 1 →+ (weilEtaleGmSheaf Z₀).H 1)
              (_ : WeilIsGmEtalePullback h 1 p_Gm)
              (W : S.Etale) (w : W ⟶ weilEtaleIdTerminal.{u} S)
              (hw : AlgebraicGeometry.Surjective w.left)
              (W₀ : Z₀.Etale) (w₀ : W₀ ⟶ weilEtaleIdTerminal.{u} Z₀)
              (hw₀ : AlgebraicGeometry.Surjective w₀.left)
              (f_W : W₀.left ⟶ W.left) (_ : f_W ≫ W.hom = W₀.hom ≫ h)
              (f_W₂ : (weilEtaleCechObj w₀ 1).left ⟶ (weilEtaleCechObj w 1).left),
            f_W₂ ≫ (weilEtaleCechProj w 1 0).left = (weilEtaleCechProj w₀ 1 0).left ≫ f_W →
            f_W₂ ≫ (weilEtaleCechProj w 1 1).left = (weilEtaleCechProj w₀ 1 1).left ≫ f_W →
            ∀ c : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf S) w 1).ker,
              let c₀ : ↑((weilEtaleGmPresheaf Z₀).obj (Opposite.op (weilEtaleCechObj w₀ 1))) :=
                (MonoidHom.toAdditive (Units.map f_W₂.appTop.hom.toMonoidHom)) c.1
              ∃ hc₀ : c₀ ∈ (weilEtaleCechDiff (weilEtaleGmPresheaf Z₀) w₀ 1).ker,
                p_Gm (cechCl S W w hw c) = cechCl Z₀ W₀ w₀ hw₀ ⟨c₀, hc₀⟩) →
          ∀ (m : ℕ) (ξ : (weilEtaleGmSheaf Z).H 1),
            cechCl Z W_T w_T hw_T c_T = ξ →
            m • ξ = 0 →
            ∃ (N : ℕ) (_ : 1 ≤ N)
              (U : Fin N → Z.Opens)
              (u : ∀ a : Fin N, Units ↑(Z.presheaf.obj (Opposite.op (U a))))
              (g : ∀ a b : Fin N, Units ↑(Z.presheaf.obj (Opposite.op (U a ⊓ U b)))),
              (⨆ a : Fin N, U a) = ⊤ ∧
              (∀ a : Fin N, AlgebraicGeometry.IsAffineOpen (U a)) ∧
              (∀ a : Fin N, (g a a : ↑(Z.presheaf.obj (Opposite.op (U a ⊓ U a)))) = 1) ∧
              (∀ a b c : Fin N,
                (Z.presheaf.map (CategoryTheory.homOfLE
                  (fun _ hx => ⟨hx.1.1, hx.1.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U a ⊓ U b)).op).hom
                  (g a b : ↑(Z.presheaf.obj (Opposite.op (U a ⊓ U b)))) *
                (Z.presheaf.map (CategoryTheory.homOfLE
                  (fun _ hx => ⟨hx.1.2, hx.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U b ⊓ U c)).op).hom
                  (g b c : ↑(Z.presheaf.obj (Opposite.op (U b ⊓ U c)))) =
                (Z.presheaf.map (CategoryTheory.homOfLE
                  (fun _ hx => ⟨hx.1.1, hx.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U a ⊓ U c)).op).hom
                  (g a c : ↑(Z.presheaf.obj (Opposite.op (U a ⊓ U c))))) ∧
              (∀ a b : Fin N,
                ((g a b : ↑(Z.presheaf.obj (Opposite.op (U a ⊓ U b)))) ^ m) *
                (Z.presheaf.map (CategoryTheory.homOfLE
                  (fun _ hx => hx.2 : U a ⊓ U b ≤ U b)).op).hom
                  (u b : ↑(Z.presheaf.obj (Opposite.op (U b)))) =
                (Z.presheaf.map (CategoryTheory.homOfLE
                  (fun _ hx => hx.1 : U a ⊓ U b ≤ U a)).op).hom
                  (u a : ↑(Z.presheaf.obj (Opposite.op (U a))))) ∧
              (∀ (Z₀ : AlgebraicGeometry.Scheme.{u})
                 (h : Quiver.Hom Z₀ Z)
                 (p_Gm : (weilEtaleGmSheaf Z).H 1 →+ (weilEtaleGmSheaf Z₀).H 1),
                WeilIsGmEtalePullback h 1 p_Gm →
                (∃ w : ∀ a : Fin N,
                    Units ↑(Z₀.presheaf.obj
                      (Opposite.op ((TopologicalSpace.Opens.map h.base).obj (U a)))),
                  ∀ a b : Fin N,
                    (Z₀.presheaf.map (CategoryTheory.homOfLE
                      (fun _ hx => hx.1 :
                        (TopologicalSpace.Opens.map h.base).obj (U a ⊓ U b) ≤
                        (TopologicalSpace.Opens.map h.base).obj (U a))).op).hom
                      (w a).1 =
                    (h.app (U a ⊓ U b)).hom
                      (g a b : ↑(Z.presheaf.obj (Opposite.op (U a ⊓ U b)))) *
                    (Z₀.presheaf.map (CategoryTheory.homOfLE
                      (fun _ hx => hx.2 :
                        (TopologicalSpace.Opens.map h.base).obj (U a ⊓ U b) ≤
                        (TopologicalSpace.Opens.map h.base).obj (U b))).op).hom
                      (w b).1) →
                p_Gm ξ = 0) :=
by
  
  
  
  have cechObj_one_isPullback :
      ∀ (S_sch : AlgebraicGeometry.Scheme.{u}) (W : S_sch.Etale)
        (w : W ⟶ weilEtaleIdTerminal.{u} S_sch),
        CategoryTheory.IsPullback
          (weilEtaleCechProj w 1 0).left
          (weilEtaleCechProj w 1 1).left
          W.hom W.hom := by
    intro S_sch W w
    have hproj0 : weilEtaleCechProj w 1 0 = CategoryTheory.Limits.pullback.fst w w := by
      change (weilEtaleCechProjSub w (0 + 1) ((0 : Fin 1).castSucc)).1 = _
      simp only [weilEtaleCechProjSub, Fin.lastCases_castSucc]
      exact CategoryTheory.Category.comp_id _
    have hproj1 : weilEtaleCechProj w 1 1 = CategoryTheory.Limits.pullback.snd w w := by
      change (weilEtaleCechProjSub w (0 + 1) (Fin.last 1)).1 = _
      simp only [weilEtaleCechProjSub, Fin.lastCases_last]
      rfl
    have hPb_et : CategoryTheory.IsPullback (weilEtaleCechProj w 1 0) (weilEtaleCechProj w 1 1) w w := by
      rw [hproj0, hproj1]
      exact CategoryTheory.IsPullback.of_hasPullback w w
    have hPb_sch : CategoryTheory.IsPullback
        (weilEtaleCechProj w 1 0).left (weilEtaleCechProj w 1 1).left
        (w.left : W.left ⟶ S_sch) (w.left : W.left ⟶ S_sch) :=
      CategoryTheory.Functor.map_isPullback
        ((AlgebraicGeometry.Scheme.Etale.forget S_sch).comp (CategoryTheory.Over.forget S_sch)) hPb_et
    have hw_left : (w.left : W.left ⟶ S_sch) = W.hom :=
      (CategoryTheory.Category.comp_id (w.left : W.left ⟶ S_sch)).symm.trans
        (CategoryTheory.Over.w ((AlgebraicGeometry.Scheme.Etale.forget S_sch).map w))
    have h_subst : ∀ (f : W.left ⟶ S_sch), f = W.hom →
        CategoryTheory.IsPullback (weilEtaleCechProj w 1 0).left (weilEtaleCechProj w 1 1).left f f →
        CategoryTheory.IsPullback (weilEtaleCechProj w 1 0).left (weilEtaleCechProj w 1 1).left W.hom W.hom := by
      rintro _ rfl h
      exact h
    exact h_subst (w.left : W.left ⟶ S_sch) hw_left hPb_sch

  have cech_lift_proj :
      ∀ {S_sch : AlgebraicGeometry.Scheme.{u}} {W U_et Y : S_sch.Etale}
        (w : W ⟶ U_et) (h_Y : Y ⟶ U_et) (p : ℕ)
        (g_arr : Fin (p + 1) → (Y ⟶ W)) (hg : ∀ i, g_arr i ≫ w = h_Y) (i : Fin (p + 1)),
        (weilEtaleCechLiftSub w h_Y p g_arr hg).1 ≫ weilEtaleCechProj w p i = g_arr i := by
    intro S_sch W U_et Y w h_Y p
    induction p with
    | zero =>
      intro g_arr hg i
      have hi : i = 0 := Fin.eq_zero i
      subst hi
      exact CategoryTheory.Category.comp_id (g_arr 0)
    | succ p ih =>
      intro g_arr hg i
      refine Fin.lastCases ?_ ?_ i
      · change CategoryTheory.Limits.pullback.lift _ (g_arr (Fin.last (p + 1))) _ ≫
          (weilEtaleCechProjSub w (p + 1) (Fin.last (p + 1))).1 = g_arr (Fin.last (p + 1))
        simp only [weilEtaleCechProjSub, Fin.lastCases_last,
          CategoryTheory.Limits.pullback.lift_snd]
      · intro j
        change CategoryTheory.Limits.pullback.lift _ (g_arr (Fin.last (p + 1))) _ ≫
          (weilEtaleCechProjSub w (p + 1) j.castSucc).1 = g_arr j.castSucc
        simp only [weilEtaleCechProjSub, Fin.lastCases_castSucc]
        exact (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
          (ih (fun k => g_arr k.castSucc) (fun k => hg k.castSucc) j)

  have cech_hom_ext :
      ∀ {S_sch : AlgebraicGeometry.Scheme.{u}} {W U_et Y : S_sch.Etale}
        (w : W ⟶ U_et) (p : ℕ) (l₁ l₂ : Y ⟶ weilEtaleCechObj w p),
        (∀ i : Fin (p + 1), l₁ ≫ weilEtaleCechProj w p i = l₂ ≫ weilEtaleCechProj w p i) →
        l₁ = l₂ := by
    intro S_sch W U_et Y w p
    induction p with
    | zero =>
      intro l₁ l₂ h
      exact (CategoryTheory.Category.comp_id l₁).symm.trans
        ((h 0).trans (CategoryTheory.Category.comp_id l₂))
    | succ p ih =>
      intro l₁ l₂ h
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact ih
          (l₁ ≫ CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w p) w)
          (l₂ ≫ CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w p) w)
          (fun j => by
            have hj := h j.castSucc
            change l₁ ≫ (weilEtaleCechProjSub w (p + 1) j.castSucc).1 =
              l₂ ≫ (weilEtaleCechProjSub w (p + 1) j.castSucc).1 at hj
            simp only [weilEtaleCechProjSub, Fin.lastCases_castSucc] at hj
            exact (CategoryTheory.Category.assoc _ _ _).trans
              (hj.trans (CategoryTheory.Category.assoc _ _ _).symm))
      · have hl := h (Fin.last (p + 1))
        change l₁ ≫ (weilEtaleCechProjSub w (p + 1) (Fin.last (p + 1))).1 =
          l₂ ≫ (weilEtaleCechProjSub w (p + 1) (Fin.last (p + 1))).1 at hl
        simp only [weilEtaleCechProjSub, Fin.lastCases_last] at hl
        exact hl

  have cech_face_proj :
      ∀ {S_sch : AlgebraicGeometry.Scheme.{u}} {W U_et : S_sch.Etale}
        (w : W ⟶ U_et) (p : ℕ) (j : Fin (p + 2)) (i : Fin (p + 1)),
        weilEtaleCechFace w p j ≫ weilEtaleCechProj w p i =
          weilEtaleCechProj w (p + 1) (j.succAbove i) :=
    fun w p j i => cech_lift_proj w (weilEtaleCechHom w (p + 1)) p _ _ i

  have gm_nsmul_toMul :
      ∀ {S_sch : AlgebraicGeometry.Scheme.{u}} (V_et : S_sch.Etale) (n : ℕ)
        (x : ↑((weilEtaleGmPresheaf S_sch).obj (Opposite.op V_et))),
        (Additive.toMul (n • x) : Units ↑(V_et.left.presheaf.obj (Opposite.op ⊤))) =
          (Additive.toMul x : Units ↑(V_et.left.presheaf.obj (Opposite.op ⊤))) ^ n := by
    intro S_sch V_et n x
    let toU : ↑((weilEtaleGmPresheaf S_sch).obj (Opposite.op V_et)) →
        Units ↑(V_et.left.presheaf.obj (Opposite.op ⊤)) := fun y => Additive.toMul y
    change toU (n • x) = (toU x) ^ n
    induction n with
    | zero => rfl
    | succ n ih =>
      exact (congrArg toU (succ_nsmul x n)).trans
        ((congrArg (· * toU x) ih).trans (pow_succ (toU x) n).symm)

  have gm_diff0_toMul :
      ∀ {S_sch : AlgebraicGeometry.Scheme.{u}} {W_e : S_sch.Etale}
        (w_e : W_e ⟶ weilEtaleIdTerminal.{u} S_sch)
        (b : ↑((weilEtaleGmPresheaf S_sch).obj (Opposite.op (weilEtaleCechObj w_e 0)))),
        (Additive.toMul (weilEtaleCechDiff (weilEtaleGmPresheaf S_sch) w_e 0 b) :
            Units ↑(((weilEtaleCechObj w_e 1).left).presheaf.obj (Opposite.op ⊤))) =
          Units.map (weilEtaleCechFace w_e 0 0).left.appTop.hom.toMonoidHom (Additive.toMul b) *
          (Units.map (weilEtaleCechFace w_e 0 1).left.appTop.hom.toMonoidHom (Additive.toMul b))⁻¹ := by
    intro S_sch W_e w_e b
    have hd : weilEtaleCechDiff (weilEtaleGmPresheaf S_sch) w_e 0 b =
        ((weilEtaleGmPresheaf S_sch).map (weilEtaleCechFace w_e 0 0).op).hom b +
          -((weilEtaleGmPresheaf S_sch).map (weilEtaleCechFace w_e 0 1).op).hom b := by
      dsimp only [weilEtaleCechDiff]
      rw [Fin.sum_univ_two, AddMonoidHom.add_apply, AddMonoidHom.zsmul_apply,
        AddMonoidHom.zsmul_apply]
      simp only [Fin.val_zero, pow_zero, one_zsmul, Fin.val_one, pow_one, neg_one_zsmul]
    rw [hd]
    rfl

  have gm_diff1_toMul :
      ∀ {S_sch : AlgebraicGeometry.Scheme.{u}} {W_e : S_sch.Etale}
        (w_e : W_e ⟶ weilEtaleIdTerminal.{u} S_sch)
        (c₁ : ↑((weilEtaleGmPresheaf S_sch).obj (Opposite.op (weilEtaleCechObj w_e 1)))),
        (Additive.toMul (weilEtaleCechDiff (weilEtaleGmPresheaf S_sch) w_e 1 c₁) :
            Units ↑(((weilEtaleCechObj w_e 2).left).presheaf.obj (Opposite.op ⊤))) =
          (Units.map (weilEtaleCechFace w_e 1 0).left.appTop.hom.toMonoidHom (Additive.toMul c₁) *
            (Units.map (weilEtaleCechFace w_e 1 1).left.appTop.hom.toMonoidHom (Additive.toMul c₁))⁻¹) *
            Units.map (weilEtaleCechFace w_e 1 2).left.appTop.hom.toMonoidHom (Additive.toMul c₁) := by
    intro S_sch W_e w_e c₁
    have h2_sign : (-1 : ℤ) ^ ((2 : Fin 3) : ℕ) = 1 := by decide
    have hd : weilEtaleCechDiff (weilEtaleGmPresheaf S_sch) w_e 1 c₁ =
        (((weilEtaleGmPresheaf S_sch).map (weilEtaleCechFace w_e 1 0).op).hom c₁ +
          -((weilEtaleGmPresheaf S_sch).map (weilEtaleCechFace w_e 1 1).op).hom c₁) +
          ((weilEtaleGmPresheaf S_sch).map (weilEtaleCechFace w_e 1 2).op).hom c₁ := by
      dsimp only [weilEtaleCechDiff]
      rw [Fin.sum_univ_three, AddMonoidHom.add_apply, AddMonoidHom.add_apply,
        AddMonoidHom.zsmul_apply, AddMonoidHom.zsmul_apply, AddMonoidHom.zsmul_apply]
      simp only [Fin.val_zero, pow_zero, one_zsmul, Fin.val_one, pow_one,
        neg_one_zsmul, h2_sign]
    rw [hd]
    rfl

  have homOfLE_topIso :
      ∀ (S_sch : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : S_sch.Opens} (e : V₁ ≤ V₂),
        (S_sch.homOfLE e).appTop ≫ V₁.topIso.hom =
          V₂.topIso.hom ≫ S_sch.presheaf.map (CategoryTheory.homOfLE e).op := by
    intro S_sch V₁ V₂ e
    have h1 : V₂.topIso.inv ≫ (S_sch.homOfLE e).appTop ≫ V₁.topIso.hom =
        S_sch.presheaf.map (CategoryTheory.homOfLE e).op := by
      rw [AlgebraicGeometry.Scheme.Opens.topIso_inv, AlgebraicGeometry.Scheme.Opens.topIso_hom,
        AlgebraicGeometry.Scheme.homOfLE_appTop]
      erw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
      congr 1
    rw [← h1, ← CategoryTheory.Category.assoc, V₂.topIso.hom_inv_id,
      CategoryTheory.Category.id_comp]

  have units_map_comp_appTop :
      ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} {R_cat : CommRingCat.{u}}
        (f₁ : X₁ ⟶ X₂) (f₂ : X₂ ⟶ X₃) (τ : X₁.presheaf.obj (Opposite.op ⊤) ⟶ R_cat)
        (u_x : Units ↑(X₃.presheaf.obj (Opposite.op ⊤))),
        Units.map (f₁.appTop ≫ τ).hom.toMonoidHom
          (Units.map f₂.appTop.hom.toMonoidHom u_x) =
        Units.map ((f₁ ≫ f₂).appTop ≫ τ).hom.toMonoidHom u_x := by
    intro X₁ X₂ X₃ R_cat f₁ f₂ τ u_x
    ext
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
    rfl

  have units_homOfLE_topIso :
      ∀ {S_sch : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : S_sch.Opens} (e : V₁ ≤ V₂)
        (u_v : Units ↑(V₂.toScheme.presheaf.obj (Opposite.op ⊤))),
        Units.map ((S_sch.homOfLE e).appTop ≫ V₁.topIso.hom).hom.toMonoidHom u_v =
          Units.map (S_sch.presheaf.map (CategoryTheory.homOfLE e).op).hom.toMonoidHom
            (Units.map V₂.topIso.hom.hom.toMonoidHom u_v) := by
    intro S_sch V₁ V₂ e u_v
    ext
    change ((S_sch.homOfLE e).appTop ≫ V₁.topIso.hom).hom u_v.1 =
      (V₂.topIso.hom ≫ S_sch.presheaf.map (CategoryTheory.homOfLE e).op).hom u_v.1
    rw [homOfLE_topIso S_sch e]

  have ι_appLE_eq_topIso_inv :
      ∀ {X : AlgebraicGeometry.Scheme.{u}} (W : X.Opens)
        (e : (⊤ : W.toScheme.Opens) ≤ (TopologicalSpace.Opens.map W.ι.base).obj W),
        W.ι.appLE W ⊤ e = W.topIso.inv := by
    intro X W e
    rw [AlgebraicGeometry.Scheme.Opens.ι_appLE W W ⊤ e,
      AlgebraicGeometry.Scheme.Opens.topIso_inv]
    congr 1

  have resLE_topIso :
      ∀ {Z₀ S_sch : AlgebraicGeometry.Scheme.{u}} (h : Z₀ ⟶ S_sch) (V : S_sch.Opens),
        let V₀ : Z₀.Opens := (TopologicalSpace.Opens.map h.base).obj V
        V.topIso.inv ≫ (h.resLE V V₀ le_rfl).appTop ≫ V₀.topIso.hom = h.app V := by
    intro Z₀ S_sch h V V₀
    let g₀ : V₀.toScheme ⟶ V.toScheme := h.resLE V V₀ le_rfl
    have hcomm : g₀ ≫ V.ι = V₀.ι ≫ h := h.resLE_comp_ι le_rfl
    have he : (⊤ : V₀.toScheme.Opens) ≤ (TopologicalSpace.Opens.map (V₀.ι ≫ h).base).obj V :=
      fun x _ => x.2
    have he' : (⊤ : V₀.toScheme.Opens) ≤
        (TopologicalSpace.Opens.map (g₀ ≫ V.ι).base).obj V := by
      rw [hcomm]; exact he
    have happ : (g₀ ≫ V.ι).appLE V ⊤ he' = (V₀.ι ≫ h).appLE V ⊤ he := by
      congr 1
    have hR : (V₀.ι ≫ h).appLE V ⊤ he = h.app V ≫ V₀.topIso.inv :=
      (AlgebraicGeometry.Scheme.Hom.comp_appLE V₀.ι h V ⊤ he).trans
        (congrArg (h.app V ≫ ·) (ι_appLE_eq_topIso_inv V₀ he))
    have hL : (g₀ ≫ V.ι).appLE V ⊤ he' = V.topIso.inv ≫ g₀.appTop := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_appLE g₀ V.ι V ⊤ he']
      have h_sub : (TopologicalSpace.Opens.map V.ι.base).obj V = ⊤ := by
        ext x; exact iff_of_true x.2 trivial
      have h_app_top : ∀ (U_t : V.toScheme.Opens) (hU_t : U_t = ⊤)
          (he_t : (⊤ : V₀.toScheme.Opens) ≤
            (TopologicalSpace.Opens.map g₀.base).obj U_t),
          V.ι.appLE V U_t (by rw [hU_t]; intro x _; exact x.2) ≫
            g₀.appLE U_t ⊤ he_t =
            V.topIso.inv ≫ g₀.appTop := by
        rintro _ rfl _
        exact congrArg₂ CategoryTheory.CategoryStruct.comp
          (ι_appLE_eq_topIso_inv V (fun x _ => x.2))
          (AlgebraicGeometry.Scheme.Hom.appLE_eq_app g₀ (U := ⊤))
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact h_app_top _ h_sub he'
    have hmid : V.topIso.inv ≫ g₀.appTop = h.app V ≫ V₀.topIso.inv :=
      hL.symm.trans (happ.trans hR)
    change V.topIso.inv ≫ g₀.appTop ≫ V₀.topIso.hom = h.app V
    rw [← CategoryTheory.Category.assoc, hmid, CategoryTheory.Category.assoc,
      V₀.topIso.inv_hom_id, CategoryTheory.Category.comp_id]

  have locally_eq_opens :
      ∀ (P : AlgebraicGeometry.Scheme.{u}) {J : Type u} (O : J → P.Opens),
        (∀ z : ↥P, ∃ j : J, z ∈ O j) →
        ∀ (x y : ↑(P.presheaf.obj (Opposite.op ⊤))),
          (∀ j : J, (O j).ι.appTop.hom x = (O j).ι.appTop.hom y) →
          x = y := by
    intro P J O hCovP x y hloc
    have hTop : (⊤ : P.Opens) ≤ ⨆ j : J, O j := by
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact hCovP z
    refine TopCat.Sheaf.eq_of_locally_eq' P.sheaf O ⊤
      (fun j => CategoryTheory.homOfLE (le_top : O j ≤ ⊤)) hTop x y (fun j => ?_)
    have hι : (O j).ι.appTop ≫ (O j).topIso.hom =
        P.presheaf.map (CategoryTheory.homOfLE (le_top : O j ≤ ⊤)).op := by
      rw [AlgebraicGeometry.Scheme.Opens.ι_appTop, AlgebraicGeometry.Scheme.Opens.topIso_hom]
      erw [← CategoryTheory.Functor.map_comp]
      congr 1
    change (P.presheaf.map (CategoryTheory.homOfLE (le_top : O j ≤ ⊤)).op).hom x =
      (P.presheaf.map (CategoryTheory.homOfLE (le_top : O j ≤ ⊤)).op).hom y
    rw [← hι]
    exact congrArg (O j).topIso.hom.hom (hloc j)

  have coprod_units :
      ∀ {I : Type u} (X : I → AlgebraicGeometry.Scheme.{u})
        (u_i : ∀ i : I, Units ↑((X i).presheaf.obj (Opposite.op ⊤))),
        let W := ∐ X
        ∃ u_tot : Units ↑(W.presheaf.obj (Opposite.op ⊤)),
          ∀ i : I,
            Units.map (CategoryTheory.Limits.Sigma.ι X i).appTop.hom.toMonoidHom u_tot = u_i i := by
    intro I X u_i W
    let hc_op := CategoryTheory.Limits.isColimitOfPreserves
      AlgebraicGeometry.Scheme.Γ.rightOp (CategoryTheory.Limits.coproductIsCoproduct X)
    let P_ring := CommRingCat.of (∀ i : I, ↑((X i).presheaf.obj (Opposite.op ⊤)))
    let c_prod : CategoryTheory.Limits.Cocone
        (CategoryTheory.Discrete.functor X ⋙ AlgebraicGeometry.Scheme.Γ.rightOp) :=
      { pt := Opposite.op P_ring
        ι := CategoryTheory.Discrete.natTrans fun ⟨i⟩ =>
          (CommRingCat.ofHom (Pi.evalRingHom
            (fun j => ↑((X j).presheaf.obj (Opposite.op ⊤))) i)).op }
    let ψ : P_ring ⟶ W.presheaf.obj (Opposite.op ⊤) := (hc_op.desc c_prod).unop
    have hψ : ∀ i : I, ψ ≫ (CategoryTheory.Limits.Sigma.ι X i).appTop =
        CommRingCat.ofHom (Pi.evalRingHom
          (fun j => ↑((X j).presheaf.obj (Opposite.op ⊤))) i) :=
      fun i => congrArg Quiver.Hom.unop (hc_op.fac c_prod ⟨i⟩)
    let u_pi : Units (∀ i : I, ↑((X i).presheaf.obj (Opposite.op ⊤))) :=
      MulEquiv.piUnits.symm u_i
    refine ⟨Units.map ψ.hom.toMonoidHom u_pi, fun i => ?_⟩
    ext
    change (ψ ≫ (CategoryTheory.Limits.Sigma.ι X i).appTop).hom u_pi.1 = (u_i i).1
    rw [hψ i]
    rfl

  
  have pull_diff1_cocycle :
      ∀ {P₃ P₂ : AlgebraicGeometry.Scheme.{u}}
        (d₀ d₁ d₂ : P₃ ⟶ P₂)
        (u_c : Units ↑(P₂.presheaf.obj (Opposite.op ⊤))),
        (Units.map d₀.appTop.hom.toMonoidHom u_c *
          (Units.map d₁.appTop.hom.toMonoidHom u_c)⁻¹) *
          Units.map d₂.appTop.hom.toMonoidHom u_c = 1 →
        ∀ {U_ab U_bd U_ad U_abd : Z.Opens}
          (e_ab : U_abd ≤ U_ab) (e_bd : U_abd ≤ U_bd) (e_ad : U_abd ≤ U_ad)
          (σ_ab : U_ab.toScheme ⟶ P₂)
          (σ_bd : U_bd.toScheme ⟶ P₂)
          (σ_ad : U_ad.toScheme ⟶ P₂)
          (σ₃ : U_abd.toScheme ⟶ P₃),
          σ₃ ≫ d₀ = Z.homOfLE e_bd ≫ σ_bd →
          σ₃ ≫ d₁ = Z.homOfLE e_ad ≫ σ_ad →
          σ₃ ≫ d₂ = Z.homOfLE e_ab ≫ σ_ab →
          let g_ab := Units.map U_ab.topIso.hom.hom.toMonoidHom
            ((Units.map σ_ab.appTop.hom.toMonoidHom u_c)⁻¹)
          let g_bd := Units.map U_bd.topIso.hom.hom.toMonoidHom
            ((Units.map σ_bd.appTop.hom.toMonoidHom u_c)⁻¹)
          let g_ad := Units.map U_ad.topIso.hom.hom.toMonoidHom
            ((Units.map σ_ad.appTop.hom.toMonoidHom u_c)⁻¹)
          Units.map (Z.presheaf.map (CategoryTheory.homOfLE e_ab).op).hom.toMonoidHom g_ab *
            Units.map (Z.presheaf.map (CategoryTheory.homOfLE e_bd).op).hom.toMonoidHom g_bd =
            Units.map (Z.presheaf.map (CategoryTheory.homOfLE e_ad).op).hom.toMonoidHom g_ad := by
    intro P₃ P₂ d₀ d₁ d₂ u_c hc2 U_ab U_bd U_ad U_abd e_ab e_bd e_ad
      σ_ab σ_bd σ_ad σ₃ hf0 hf1 hf2 g_ab g_bd g_ad
    have hg_res : ∀ {V_src : Z.Opens} (e : U_abd ≤ V_src) (σ_v : V_src.toScheme ⟶ P₂),
        Units.map ((Z.homOfLE e ≫ σ_v).appTop ≫ U_abd.topIso.hom).hom.toMonoidHom u_c =
          (Units.map (Z.presheaf.map (CategoryTheory.homOfLE e).op).hom.toMonoidHom
            (Units.map V_src.topIso.hom.hom.toMonoidHom
              ((Units.map σ_v.appTop.hom.toMonoidHom u_c)⁻¹)))⁻¹ := by
      intro V_src e σ_v
      rw [← units_homOfLE_topIso e, map_inv, inv_inv, units_map_comp_appTop]
    let G_ab := Units.map (Z.presheaf.map (CategoryTheory.homOfLE e_ab).op).hom.toMonoidHom g_ab
    let G_bd := Units.map (Z.presheaf.map (CategoryTheory.homOfLE e_bd).op).hom.toMonoidHom g_bd
    let G_ad := Units.map (Z.presheaf.map (CategoryTheory.homOfLE e_ad).op).hom.toMonoidHom g_ad
    have h_pull3 := congrArg
      (Units.map (σ₃.appTop ≫ U_abd.topIso.hom).hom.toMonoidHom) hc2
    rw [map_mul, map_mul, map_inv, map_one,
      units_map_comp_appTop, units_map_comp_appTop, units_map_comp_appTop,
      hf0, hf1, hf2, hg_res e_bd σ_bd, hg_res e_ad σ_ad, hg_res e_ab σ_ab] at h_pull3
    change G_ab * G_bd = G_ad
    have h_pull3' : (G_bd⁻¹ * G_ad) * G_ab⁻¹ = 1 := by
      simpa only [G_ab, G_bd, G_ad, inv_inv] using h_pull3
    apply Units.ext
    have h_val : (G_bd⁻¹.val * G_ad.val) * G_ab⁻¹.val = 1 := by
      simpa only [Units.val_mul, Units.val_one] using congrArg Units.val h_pull3'
    have h1 : G_ab.val * G_ab⁻¹.val = 1 := Units.mul_inv G_ab
    have h2 : G_bd.val * G_bd⁻¹.val = 1 := Units.mul_inv G_bd
    calc
      G_ab.val * G_bd.val
        = G_ab.val * G_bd.val * ((G_bd⁻¹.val * G_ad.val) * G_ab⁻¹.val) := by rw [h_val, mul_one]
      _ = (G_ab.val * G_ab⁻¹.val) * (G_bd.val * G_bd⁻¹.val) * G_ad.val := by ring
      _ = 1 * 1 * G_ad.val := by rw [h1, h2]
      _ = G_ad.val := by ring

  have pull_diff0_pow :
      ∀ {P₂ W_sch : AlgebraicGeometry.Scheme.{u}}
        (d₀ d₁ : P₂ ⟶ W_sch)
        (u_b₀ : Units ↑(W_sch.presheaf.obj (Opposite.op ⊤)))
        (u_c : Units ↑(P₂.presheaf.obj (Opposite.op ⊤)))
        (m : ℕ),
        Units.map d₀.appTop.hom.toMonoidHom u_b₀ *
          (Units.map d₁.appTop.hom.toMonoidHom u_b₀)⁻¹ = u_c ^ m →
        ∀ {U_a U_b : Z.Opens}
          (s_a : U_a.toScheme ⟶ W_sch) (s_b : U_b.toScheme ⟶ W_sch)
          (σ_ab : (U_a ⊓ U_b).toScheme ⟶ P₂),
          σ_ab ≫ d₀ = Z.homOfLE (inf_le_right : U_a ⊓ U_b ≤ U_b) ≫ s_b →
          σ_ab ≫ d₁ = Z.homOfLE (inf_le_left : U_a ⊓ U_b ≤ U_a) ≫ s_a →
          let u_a := Units.map (s_a.appTop ≫ U_a.topIso.hom).hom.toMonoidHom u_b₀
          let u_b := Units.map (s_b.appTop ≫ U_b.topIso.hom).hom.toMonoidHom u_b₀
          let g_ab := Units.map (U_a ⊓ U_b).topIso.hom.hom.toMonoidHom
            ((Units.map σ_ab.appTop.hom.toMonoidHom u_c)⁻¹)
          ((g_ab : ↑(Z.presheaf.obj (Opposite.op (U_a ⊓ U_b)))) ^ m) *
            (Z.presheaf.map (CategoryTheory.homOfLE
              (fun _ hx => hx.2 : U_a ⊓ U_b ≤ U_b)).op).hom (u_b : _) =
            (Z.presheaf.map (CategoryTheory.homOfLE
              (fun _ hx => hx.1 : U_a ⊓ U_b ≤ U_a)).op).hom (u_a : _) := by
    intro P₂ W_sch d₀ d₁ u_b₀ u_c m hb₀ U_a U_b s_a s_b σ_ab hf0 hf1 u_a u_b g_ab
    have h_pull2 := congrArg
      (Units.map (σ_ab.appTop ≫ (U_a ⊓ U_b).topIso.hom).hom.toMonoidHom) hb₀
    rw [map_mul, map_inv, map_pow,
      units_map_comp_appTop, units_map_comp_appTop, hf0, hf1] at h_pull2
    let U_b_ab := Units.map (Z.presheaf.map (CategoryTheory.homOfLE
      (fun _ hx => hx.2 : U_a ⊓ U_b ≤ U_b)).op).hom.toMonoidHom u_b
    let U_a_ab := Units.map (Z.presheaf.map (CategoryTheory.homOfLE
      (fun _ hx => hx.1 : U_a ⊓ U_b ≤ U_a)).op).hom.toMonoidHom u_a
    have hub : Units.map ((Z.homOfLE (inf_le_right : U_a ⊓ U_b ≤ U_b) ≫ s_b).appTop ≫
        (U_a ⊓ U_b).topIso.hom).hom.toMonoidHom u_b₀ = U_b_ab := by
      rw [← units_map_comp_appTop, units_homOfLE_topIso]
      rfl
    have hua : Units.map ((Z.homOfLE (inf_le_left : U_a ⊓ U_b ≤ U_a) ≫ s_a).appTop ≫
        (U_a ⊓ U_b).topIso.hom).hom.toMonoidHom u_b₀ = U_a_ab := by
      rw [← units_map_comp_appTop, units_homOfLE_topIso]
      rfl
    have hgab : Units.map (σ_ab.appTop ≫ (U_a ⊓ U_b).topIso.hom).hom.toMonoidHom u_c =
        g_ab⁻¹ := by
      dsimp only [g_ab]
      rw [map_inv, inv_inv]
      rfl
    rw [hub, hua, hgab] at h_pull2
    have h_val : U_b_ab.val * U_a_ab⁻¹.val = (g_ab⁻¹.val) ^ m := by
      simpa only [Units.val_mul, Units.val_pow_eq_pow_val] using congrArg Units.val h_pull2
    have h1 : U_a_ab.val * U_a_ab⁻¹.val = 1 := Units.mul_inv U_a_ab
    have h2 : g_ab.val * g_ab⁻¹.val = 1 := Units.mul_inv g_ab
    change (g_ab.val ^ m) * U_b_ab.val = U_a_ab.val
    calc
      (g_ab.val ^ m) * U_b_ab.val
        = (g_ab.val ^ m) * U_b_ab.val * (U_a_ab.val * U_a_ab⁻¹.val) := by rw [h1, mul_one]
      _ = (g_ab.val ^ m) * (U_b_ab.val * U_a_ab⁻¹.val) * U_a_ab.val := by ring
      _ = (g_ab.val ^ m) * ((g_ab⁻¹.val) ^ m) * U_a_ab.val := by rw [h_val]
      _ = (g_ab.val * g_ab⁻¹.val) ^ m * U_a_ab.val := by rw [← mul_pow]
      _ = 1 ^ m * U_a_ab.val := by rw [h2]
      _ = U_a_ab.val := by rw [one_pow, one_mul]

  have sigma_desc_postcomp :
      ∀ {I : Type u} {X : I → AlgebraicGeometry.Scheme.{u}}
        {A_sch B_sch : AlgebraicGeometry.Scheme.{u}}
        (α : ∀ i : I, X i ⟶ A_sch) (β : A_sch ⟶ B_sch) (γ : ∀ i : I, X i ⟶ B_sch),
        (∀ i : I, α i ≫ β = γ i) →
        CategoryTheory.Limits.Sigma.desc α ≫ β = CategoryTheory.Limits.Sigma.desc γ := by
    intro I X A_sch B_sch α β γ hα
    apply CategoryTheory.Limits.Sigma.hom_ext
    intro i
    rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Limits.Sigma.ι_comp_desc,
      hα i]

  have pullback_coboundary_eq :
      ∀ {W_sch P₂ Z₀ P₂_0 : AlgebraicGeometry.Scheme.{u}}
        {N : ℕ} (U : Fin N → Z.Opens)
        (g_hom : W_sch ⟶ Z)
        (π₀ π₁ : P₂ ⟶ W_sch)
        (hPb_W : CategoryTheory.IsPullback π₀ π₁ g_hom g_hom)
        (s : ∀ a : Fin N, (U a).toScheme ⟶ W_sch)
        (hs : ∀ a : Fin N, s a ≫ g_hom = (U a).ι)
        (u_c : Units ↑(P₂.presheaf.obj (Opposite.op ⊤)))
        (g : ∀ a b : Fin N, Units ↑(Z.presheaf.obj (Opposite.op (U a ⊓ U b))))
        (hg_eval : ∀ (a b : Fin N) (σ : (U a ⊓ U b).toScheme ⟶ P₂),
          σ ≫ π₀ = Z.homOfLE (inf_le_left : U a ⊓ U b ≤ U a) ≫ s a →
          σ ≫ π₁ = Z.homOfLE (inf_le_right : U a ⊓ U b ≤ U b) ≫ s b →
          Units.map ((U a ⊓ U b).topIso.inv).hom.toMonoidHom (g a b) =
            (Units.map σ.appTop.hom.toMonoidHom u_c)⁻¹)
        (h : Z₀ ⟶ Z)
        (w_u : ∀ a : Fin N,
          Units ↑(Z₀.presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map h.base).obj (U a)))))
        (hw_u : ∀ a b : Fin N,
          (Z₀.presheaf.map (CategoryTheory.homOfLE
            (fun _ hx => hx.1 :
              (TopologicalSpace.Opens.map h.base).obj (U a ⊓ U b) ≤
              (TopologicalSpace.Opens.map h.base).obj (U a))).op).hom (w_u a).1 =
          (h.app (U a ⊓ U b)).hom (g a b).1 *
          (Z₀.presheaf.map (CategoryTheory.homOfLE
            (fun _ hx => hx.2 :
              (TopologicalSpace.Opens.map h.base).obj (U a ⊓ U b) ≤
              (TopologicalSpace.Opens.map h.base).obj (U b))).op).hom (w_u b).1),
        let I := ULift.{u} (Fin N)
        let U₀ : Fin N → Z₀.Opens := fun a => (TopologicalSpace.Opens.map h.base).obj (U a)
        let X₀ : I → AlgebraicGeometry.Scheme.{u} := fun i => (U₀ i.down).toScheme
        let g_W₀ : ∐ X₀ ⟶ Z₀ := CategoryTheory.Limits.Sigma.desc (fun i : I => (U₀ i.down).ι)
        let f_W : ∐ X₀ ⟶ W_sch := CategoryTheory.Limits.Sigma.desc
          (fun i : I => h.resLE (U i.down) (U₀ i.down) le_rfl ≫ s i.down)
        ∀ (π₀_0 π₁_0 : P₂_0 ⟶ ∐ X₀)
          (_ : CategoryTheory.IsPullback π₀_0 π₁_0 g_W₀ g_W₀)
          (f_W₂ : P₂_0 ⟶ P₂),
          f_W₂ ≫ π₀ = π₀_0 ≫ f_W →
          f_W₂ ≫ π₁ = π₁_0 ≫ f_W →
          ∀ (u_bw : Units ↑((∐ X₀).presheaf.obj (Opposite.op ⊤))),
            (∀ i : I,
              Units.map (CategoryTheory.Limits.Sigma.ι X₀ i).appTop.hom.toMonoidHom u_bw =
                Units.map (U₀ i.down).topIso.inv.hom.toMonoidHom (w_u i.down)) →
            Units.map π₁_0.appTop.hom.toMonoidHom u_bw *
              (Units.map π₀_0.appTop.hom.toMonoidHom u_bw)⁻¹ =
              Units.map f_W₂.appTop.hom.toMonoidHom u_c := by
    intro W_sch P₂ Z₀ P₂_0 N U g_hom π₀ π₁ hPb_W s hs u_c g hg_eval h w_u hw_u
      I U₀ X₀ g_W₀ f_W π₀_0 π₁_0 hPb_W₀ f_W₂ hπ₀_fW₂ hπ₁_fW₂ u_bw hu_bw
    apply Units.ext
    let O : I × I → P₂_0.Opens := fun p =>
      (TopologicalSpace.Opens.map π₀_0.base).obj (CategoryTheory.Limits.Sigma.ι X₀ p.1).opensRange ⊓
      (TopologicalSpace.Opens.map π₁_0.base).obj (CategoryTheory.Limits.Sigma.ι X₀ p.2).opensRange
    have hCov_O : ∀ z : ↥P₂_0, ∃ p : I × I, z ∈ O p := by
      intro z
      let cov := AlgebraicGeometry.sigmaOpenCover X₀
      exact ⟨(cov.idx (π₀_0.base z), cov.idx (π₁_0.base z)),
        ⟨cov.covers (π₀_0.base z), cov.covers (π₁_0.base z)⟩⟩
    let u_lhs : Units ↑(P₂_0.presheaf.obj (Opposite.op ⊤)) :=
      Units.map π₁_0.appTop.hom.toMonoidHom u_bw *
        (Units.map π₀_0.appTop.hom.toMonoidHom u_bw)⁻¹
    let u_rhs : Units ↑(P₂_0.presheaf.obj (Opposite.op ⊤)) :=
      Units.map f_W₂.appTop.hom.toMonoidHom u_c
    refine locally_eq_opens P₂_0 O hCov_O u_lhs.1 u_rhs.1 ?_
    rintro ⟨i, j⟩
    let a := i.down
    let b := j.down
    have h_comm_ij :
        (Z₀.homOfLE (inf_le_left : U₀ a ⊓ U₀ b ≤ U₀ a) ≫
          CategoryTheory.Limits.Sigma.ι X₀ i) ≫ g_W₀ =
        (Z₀.homOfLE (inf_le_right : U₀ a ⊓ U₀ b ≤ U₀ b) ≫
          CategoryTheory.Limits.Sigma.ι X₀ j) ≫ g_W₀ := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Limits.Sigma.ι_comp_desc,
        Z₀.homOfLE_ι, Z₀.homOfLE_ι]
    let ι_p : (U₀ a ⊓ U₀ b).toScheme ⟶ P₂_0 :=
      hPb_W₀.lift (Z₀.homOfLE inf_le_left ≫ CategoryTheory.Limits.Sigma.ι X₀ i)
        (Z₀.homOfLE inf_le_right ≫ CategoryTheory.Limits.Sigma.ι X₀ j) h_comm_ij
    have hι_p0 : ι_p ≫ π₀_0 = Z₀.homOfLE inf_le_left ≫ CategoryTheory.Limits.Sigma.ι X₀ i :=
      hPb_W₀.lift_fst _ _ _
    have hι_p1 : ι_p ≫ π₁_0 = Z₀.homOfLE inf_le_right ≫ CategoryTheory.Limits.Sigma.ι X₀ j :=
      hPb_W₀.lift_snd _ _ _
    have hO_0 : Set.range ((O (i, j)).ι ≫ π₀_0).base ⊆
        Set.range (CategoryTheory.Limits.Sigma.ι X₀ i).base := by
      rintro _ ⟨z, rfl⟩; exact z.2.1
    have hO_1 : Set.range ((O (i, j)).ι ≫ π₁_0).base ⊆
        Set.range (CategoryTheory.Limits.Sigma.ι X₀ j).base := by
      rintro _ ⟨z, rfl⟩; exact z.2.2
    let u_i : (O (i, j)).toScheme ⟶ X₀ i :=
      AlgebraicGeometry.IsOpenImmersion.lift
        (CategoryTheory.Limits.Sigma.ι X₀ i) ((O (i, j)).ι ≫ π₀_0) hO_0
    let u_j : (O (i, j)).toScheme ⟶ X₀ j :=
      AlgebraicGeometry.IsOpenImmersion.lift
        (CategoryTheory.Limits.Sigma.ι X₀ j) ((O (i, j)).ι ≫ π₁_0) hO_1
    have hu_i : u_i ≫ CategoryTheory.Limits.Sigma.ι X₀ i = (O (i, j)).ι ≫ π₀_0 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    have hu_j : u_j ≫ CategoryTheory.Limits.Sigma.ι X₀ j = (O (i, j)).ι ≫ π₁_0 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    have hu_eq : u_i ≫ (U₀ a).ι = u_j ≫ (U₀ b).ι := by
      calc
        u_i ≫ (U₀ a).ι = u_i ≫ CategoryTheory.Limits.Sigma.ι X₀ i ≫ g_W₀ := by
          rw [CategoryTheory.Limits.Sigma.ι_comp_desc]
        _ = (u_i ≫ CategoryTheory.Limits.Sigma.ι X₀ i) ≫ g_W₀ :=
          (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((O (i, j)).ι ≫ π₀_0) ≫ g_W₀ := by rw [hu_i]
        _ = (O (i, j)).ι ≫ (π₀_0 ≫ g_W₀) := CategoryTheory.Category.assoc _ _ _
        _ = (O (i, j)).ι ≫ (π₁_0 ≫ g_W₀) := by rw [hPb_W₀.w]
        _ = ((O (i, j)).ι ≫ π₁_0) ≫ g_W₀ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (u_j ≫ CategoryTheory.Limits.Sigma.ι X₀ j) ≫ g_W₀ := by rw [← hu_j]
        _ = u_j ≫ CategoryTheory.Limits.Sigma.ι X₀ j ≫ g_W₀ :=
          CategoryTheory.Category.assoc _ _ _
        _ = u_j ≫ (U₀ b).ι := by rw [CategoryTheory.Limits.Sigma.ι_comp_desc]
    have h_range_ab : Set.range (u_i ≫ (U₀ a).ι).base ⊆ Set.range (U₀ a ⊓ U₀ b).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hza : (u_i ≫ (U₀ a).ι).base z ∈ U₀ a := by
        have : (u_i ≫ (U₀ a).ι).base z ∈ Set.range (U₀ a).ι.base := ⟨u_i.base z, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
      have hzb : (u_j ≫ (U₀ b).ι).base z ∈ U₀ b := by
        have : (u_j ≫ (U₀ b).ι).base z ∈ Set.range (U₀ b).ι.base := ⟨u_j.base z, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
      rw [hu_eq] at hza ⊢
      exact ⟨hza, hzb⟩
    let q_p : (O (i, j)).toScheme ⟶ (U₀ a ⊓ U₀ b).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (U₀ a ⊓ U₀ b).ι (u_i ≫ (U₀ a).ι) h_range_ab
    have hq_i : q_p ≫ Z₀.homOfLE inf_le_left = u_i :=
      (cancel_mono (U₀ a).ι).mp (by
        rw [CategoryTheory.Category.assoc, Z₀.homOfLE_ι,
          AlgebraicGeometry.IsOpenImmersion.lift_fac])
    have hq_j : q_p ≫ Z₀.homOfLE inf_le_right = u_j :=
      (cancel_mono (U₀ b).ι).mp (by
        rw [CategoryTheory.Category.assoc, Z₀.homOfLE_ι,
          AlgebraicGeometry.IsOpenImmersion.lift_fac, hu_eq])
    have hO_fac : (O (i, j)).ι = q_p ≫ ι_p := by
      apply hPb_W₀.hom_ext
      · rw [CategoryTheory.Category.assoc, hι_p0, ← CategoryTheory.Category.assoc, hq_i, hu_i]
      · rw [CategoryTheory.Category.assoc, hι_p1, ← CategoryTheory.Category.assoc, hq_j, hu_j]
    suffices h_ab :
        Units.map (ι_p.appTop ≫ (U₀ a ⊓ U₀ b).topIso.hom).hom.toMonoidHom u_lhs =
          Units.map (ι_p.appTop ≫ (U₀ a ⊓ U₀ b).topIso.hom).hom.toMonoidHom u_rhs by
      have h_top_val := congrArg
        (fun x => (U₀ a ⊓ U₀ b).topIso.inv.hom (Units.val x)) h_ab
      have h_ιp : ι_p.appTop.hom u_lhs.1 = ι_p.appTop.hom u_rhs.1 := by
        change ((ι_p.appTop ≫ (U₀ a ⊓ U₀ b).topIso.hom) ≫ (U₀ a ⊓ U₀ b).topIso.inv).hom u_lhs.1 =
          ((ι_p.appTop ≫ (U₀ a ⊓ U₀ b).topIso.hom) ≫ (U₀ a ⊓ U₀ b).topIso.inv).hom u_rhs.1 at h_top_val
        rwa [CategoryTheory.Category.assoc, (U₀ a ⊓ U₀ b).topIso.hom_inv_id,
          CategoryTheory.Category.comp_id] at h_top_val
      rw [hO_fac, AlgebraicGeometry.Scheme.Hom.comp_appTop]
      exact congrArg q_p.appTop.hom h_ιp
    let W_a : Units ↑(Z₀.presheaf.obj (Opposite.op (U₀ a ⊓ U₀ b))) :=
      Units.map (Z₀.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => hx.1 : U₀ a ⊓ U₀ b ≤ U₀ a)).op).hom.toMonoidHom (w_u a)
    let W_b : Units ↑(Z₀.presheaf.obj (Opposite.op (U₀ a ⊓ U₀ b))) :=
      Units.map (Z₀.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => hx.2 : U₀ a ⊓ U₀ b ≤ U₀ b)).op).hom.toMonoidHom (w_u b)
    let H_g : Units ↑(Z₀.presheaf.obj (Opposite.op (U₀ a ⊓ U₀ b))) :=
      Units.map (h.app (U a ⊓ U b)).hom.toMonoidHom (g a b)
    have hLHS_ab :
        Units.map (ι_p.appTop ≫ (U₀ a ⊓ U₀ b).topIso.hom).hom.toMonoidHom u_lhs =
          W_b * W_a⁻¹ := by
      dsimp only [u_lhs]
      rw [map_mul, map_inv,
        units_map_comp_appTop, units_map_comp_appTop, hι_p1, hι_p0,
        ← units_map_comp_appTop (Z₀.homOfLE inf_le_right),
        ← units_map_comp_appTop (Z₀.homOfLE inf_le_left),
        hu_bw j, hu_bw i, units_homOfLE_topIso, units_homOfLE_topIso]
      have hwa : Units.map (U₀ a).topIso.hom.hom.toMonoidHom
          (Units.map (U₀ a).topIso.inv.hom.toMonoidHom (w_u a)) = w_u a := by
        ext; change ((U₀ a).topIso.inv ≫ (U₀ a).topIso.hom).hom (w_u a).1 = (w_u a).1
        rw [(U₀ a).topIso.inv_hom_id]; rfl
      have hwb : Units.map (U₀ b).topIso.hom.hom.toMonoidHom
          (Units.map (U₀ b).topIso.inv.hom.toMonoidHom (w_u b)) = w_u b := by
        ext; change ((U₀ b).topIso.inv ≫ (U₀ b).topIso.hom).hom (w_u b).1 = (w_u b).1
        rw [(U₀ b).topIso.inv_hom_id]; rfl
      rw [hwa, hwb]
    have h_σ_comm :
        (Z.homOfLE (inf_le_left : U a ⊓ U b ≤ U a) ≫ s a) ≫ g_hom =
        (Z.homOfLE (inf_le_right : U a ⊓ U b ≤ U b) ≫ s b) ≫ g_hom := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hs a, hs b, Z.homOfLE_ι, Z.homOfLE_ι]
    let σ_ab : (U a ⊓ U b).toScheme ⟶ P₂ :=
      hPb_W.lift (Z.homOfLE inf_le_left ≫ s a) (Z.homOfLE inf_le_right ≫ s b) h_σ_comm
    have h_res_ab :
        h.resLE (U a ⊓ U b) (U₀ a ⊓ U₀ b) le_rfl ≫ (U a ⊓ U b).ι =
          (U₀ a ⊓ U₀ b).ι ≫ h :=
      h.resLE_comp_ι le_rfl
    have h_sq_ab : ι_p ≫ f_W₂ =
        h.resLE (U a ⊓ U b) (U₀ a ⊓ U₀ b) le_rfl ≫ σ_ab := by
      apply hPb_W.hom_ext
      · rw [CategoryTheory.Category.assoc, hπ₀_fW₂, ← CategoryTheory.Category.assoc, hι_p0,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.Sigma.ι_comp_desc,
          CategoryTheory.Category.assoc, hPb_W.lift_fst,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
        congr 1
        exact (cancel_mono (U a).ι).mp
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (Z₀.homOfLE inf_le_left ≫ ·) (h.resLE_comp_ι le_rfl)).trans
              ((Z₀.homOfLE_ι_assoc inf_le_left h).trans
                (h_res_ab.symm.trans
                  ((congrArg (h.resLE (U a ⊓ U b) (U₀ a ⊓ U₀ b) le_rfl ≫ ·)
                    (Z.homOfLE_ι inf_le_left).symm).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)))))
      · rw [CategoryTheory.Category.assoc, hπ₁_fW₂, ← CategoryTheory.Category.assoc, hι_p1,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.Sigma.ι_comp_desc,
          CategoryTheory.Category.assoc, hPb_W.lift_snd,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
        congr 1
        exact (cancel_mono (U b).ι).mp
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (Z₀.homOfLE inf_le_right ≫ ·) (h.resLE_comp_ι le_rfl)).trans
              ((Z₀.homOfLE_ι_assoc inf_le_right h).trans
                (h_res_ab.symm.trans
                  ((congrArg (h.resLE (U a ⊓ U b) (U₀ a ⊓ U₀ b) le_rfl ≫ ·)
                    (Z.homOfLE_ι inf_le_right).symm).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)))))
    have hRHS_ab :
        Units.map (ι_p.appTop ≫ (U₀ a ⊓ U₀ b).topIso.hom).hom.toMonoidHom u_rhs = H_g⁻¹ := by
      dsimp only [u_rhs]
      rw [units_map_comp_appTop, h_sq_ab,
        ← units_map_comp_appTop (h.resLE (U a ⊓ U b) (U₀ a ⊓ U₀ b) le_rfl) σ_ab]
      have hg_ab := hg_eval a b σ_ab (hPb_W.lift_fst _ _ _) (hPb_W.lift_snd _ _ _)
      have h_c_ab : Units.map σ_ab.appTop.hom.toMonoidHom u_c =
          (Units.map (U a ⊓ U b).topIso.inv.hom.toMonoidHom (g a b))⁻¹ := by
        rw [hg_ab, inv_inv]
      rw [h_c_ab, map_inv]
      congr 1
      ext
      exact congrArg (fun φ => CommRingCat.Hom.hom φ (g a b).1)
        (resLE_topIso h (U a ⊓ U b))
    rw [hLHS_ab, hRHS_ab]
    apply Units.ext
    change W_b.val * W_a⁻¹.val = H_g⁻¹.val
    have hw_ab : W_a.val = H_g.val * W_b.val := hw_u a b
    have h1 : W_a.val * W_a⁻¹.val = 1 := Units.mul_inv W_a
    have h2 : H_g⁻¹.val * H_g.val = 1 := Units.inv_mul H_g
    calc
      W_b.val * W_a⁻¹.val
        = (H_g⁻¹.val * H_g.val) * (W_b.val * W_a⁻¹.val) := by rw [h2, one_mul]
      _ = H_g⁻¹.val * ((H_g.val * W_b.val) * W_a⁻¹.val) := by ring
      _ = H_g⁻¹.val * (W_a.val * W_a⁻¹.val) := by rw [← hw_ab]
      _ = H_g⁻¹.val := by rw [h1, mul_one]

  
  
  
  have h_s4_pad_zariski :
      ∀ (R L : Type u) [CommRing R] [AddCommGroup L] [Module R L] [Module.Invertible R L],
        (∀ (R' L' : Type u) [CommRing R'] [AddCommGroup L'] [Module R' L'] [Module.Invertible R' L'],
          ∃ (n : ℕ) (f : Fin n → R')
            (_ : ∀ a : Fin n,
              TensorProduct R' (Localization.Away (f a)) L' ≃ₗ[Localization.Away (f a)]
                Localization.Away (f a)),
            Finset.univ.sum f = 1) →
        ∃ (n : ℕ) (_ : 1 ≤ n) (f : Fin n → R),
          Finset.univ.sum f = 1 ∧
          AlgebraicGeometry.Surjective
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R (∀ a : Fin n, Localization.Away (f a))))) ∧
          Nonempty (TensorProduct R (∀ a : Fin n, Localization.Away (f a)) L
            ≃ₗ[∀ a : Fin n, Localization.Away (f a)]
            (∀ a : Fin n, Localization.Away (f a))) := by
    intro R L _ _ _ _ hZar
    classical
    obtain ⟨n₀, f₀, eLoc₀, hSum₀⟩ := hZar R L
    have hPad : ∃ (n : ℕ) (_ : 1 ≤ n) (f : Fin n → R)
        (_ : ∀ a : Fin n,
          TensorProduct R (Localization.Away (f a)) L ≃ₗ[Localization.Away (f a)]
            Localization.Away (f a)),
        Finset.univ.sum f = 1 := by
      rcases Nat.eq_zero_or_pos n₀ with rfl | hn₀_pos
      · have h01 : (0 : R) = 1 := by simpa using hSum₀
        have sub_mod : ∀ (M : Type u) [AddCommGroup M] [Module R M], Subsingleton M := by
          intro M _ _
          refine ⟨fun x y => ?_⟩
          calc
            x = (1 : R) • x := (one_smul R x).symm
            _ = (0 : R) • x := by rw [← h01]
            _ = 0 := zero_smul R x
            _ = (0 : R) • y := (zero_smul R y).symm
            _ = (1 : R) • y := by rw [← h01]
            _ = y := one_smul R y
        refine ⟨1, le_rfl, fun _ => 1, fun a => ?_, by simp⟩
        haveI : Subsingleton (Localization.Away ((fun _ : Fin 1 => (1 : R)) a)) := sub_mod _
        haveI : Subsingleton
            (TensorProduct R (Localization.Away ((fun _ : Fin 1 => (1 : R)) a)) L) := sub_mod _
        exact LinearEquiv.ofSubsingleton _ _
      · exact ⟨n₀, hn₀_pos, f₀, eLoc₀, hSum₀⟩
    obtain ⟨n, hn, f, eLoc, hSum⟩ := hPad
    let A : Fin n → Type u := fun a => Localization.Away (f a)
    have hSurj : AlgebraicGeometry.Surjective
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (∀ a : Fin n, A a)))) := by
      rw [AlgebraicGeometry.surjective_iff]
      intro p
      have hex : ∃ a : Fin n, f a ∉ p.asIdeal := by
        by_contra hall
        have hall' : ∀ a : Fin n, f a ∈ p.asIdeal := fun a =>
          Decidable.byContradiction fun hna => hall ⟨a, hna⟩
        have h1 : (1 : R) ∈ p.asIdeal := by
          rw [← hSum]
          exact Ideal.sum_mem p.asIdeal fun a _ => hall' a
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1)
      obtain ⟨a, ha⟩ := hex
      let p' : PrimeSpectrum R := p
      have hp_mem : p' ∈ (PrimeSpectrum.basicOpen (f a) : Set (PrimeSpectrum R)) := by
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        exact ha
      rw [← PrimeSpectrum.localization_away_comap_range (A a) (f a)] at hp_mem
      obtain ⟨qa, hqa⟩ := hp_mem
      let πa : (∀ b : Fin n, A b) →+* A a := Pi.evalRingHom A a
      let Q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (∀ b : Fin n, A b))) :=
        PrimeSpectrum.comap πa qa
      refine ⟨Q, ?_⟩
      rw [AlgebraicGeometry.Spec.map_apply]
      change PrimeSpectrum.comap (algebraMap R (∀ b : Fin n, A b)) (PrimeSpectrum.comap πa qa) = p'
      rw [← PrimeSpectrum.comap_comp_apply]
      have hcomp : πa.comp (algebraMap R (∀ b : Fin n, A b)) = algebraMap R (A a) := by
        ext r; rfl
      rw [hcomp, hqa]
    let B_lin : (∀ a : Fin n, A a) →ₗ[∀ a : Fin n, A a] (L →ₗ[R] (∀ a : Fin n, A a)) :=
      { toFun := fun t =>
          { toFun := fun x a => t a * eLoc a ((1 : A a) ⊗ₜ[R] x)
            map_add' := fun x y => by
              funext a
              change t a * eLoc a ((1 : A a) ⊗ₜ[R] (x + y)) =
                t a * eLoc a ((1 : A a) ⊗ₜ[R] x) + t a * eLoc a ((1 : A a) ⊗ₜ[R] y)
              rw [TensorProduct.tmul_add, map_add, mul_add]
            map_smul' := fun r x => by
              funext a
              simp only [RingHom.id_apply, Pi.smul_apply, Algebra.smul_def]
              have hr : (1 : A a) ⊗ₜ[R] (r • x) =
                  (algebraMap R (A a) r) • ((1 : A a) ⊗ₜ[R] x) := by
                rw [TensorProduct.tmul_smul, ← algebraMap_smul (A a) r ((1 : A a) ⊗ₜ[R] x)]
              rw [hr, (eLoc a).map_smul, smul_eq_mul]
              exact mul_left_comm _ _ _ }
        map_add' := fun t₁ t₂ => by
          ext x a
          exact add_mul (t₁ a) (t₂ a) _
        map_smul' := fun t₀ t => by
          ext x a
          change (t₀ a * t a) * eLoc a ((1 : A a) ⊗ₜ[R] x) =
            t₀ a * (t a * eLoc a ((1 : A a) ⊗ₜ[R] x))
          exact mul_assoc _ _ _ }
    let Φ : TensorProduct R (∀ a : Fin n, A a) L →ₗ[∀ a : Fin n, A a] (∀ a : Fin n, A a) :=
      TensorProduct.AlgebraTensorModule.lift B_lin
    let ι : ∀ a : Fin n, A a →ₗ[R] (∀ b : Fin n, A b) := fun a => LinearMap.single R A a
    let ωa : Fin n → TensorProduct R (∀ a : Fin n, A a) L :=
      fun a => LinearMap.rTensor L (ι a) ((eLoc a).symm 1)
    let ω : TensorProduct R (∀ a : Fin n, A a) L := Finset.univ.sum ωa
    let Ψ : (∀ a : Fin n, A a) →ₗ[∀ a : Fin n, A a] TensorProduct R (∀ a : Fin n, A a) L :=
      { toFun := fun t => t • ω
        map_add' := fun t₁ t₂ => add_smul t₁ t₂ ω
        map_smul' := fun t₀ t => by simp only [RingHom.id_apply, smul_eq_mul, mul_smul] }
    have hΦ_rTensor : ∀ (a : Fin n) (z : TensorProduct R (A a) L),
        Φ (LinearMap.rTensor L (ι a) z) = Pi.single a (eLoc a z) := by
      intro a z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul u x =>
        funext b
        change (Pi.single a u b) * eLoc b ((1 : A b) ⊗ₜ[R] x) =
          Pi.single a (eLoc a (u ⊗ₜ[R] x)) b
        by_cases hba : b = a
        · subst hba
          rw [Pi.single_eq_same, Pi.single_eq_same]
          have hu : u ⊗ₜ[R] x = u • ((1 : A b) ⊗ₜ[R] x) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [hu, (eLoc b).map_smul, smul_eq_mul]
        · rw [Pi.single_eq_of_ne hba, Pi.single_eq_of_ne hba, zero_mul]
      | add z₁ z₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂, (eLoc a).map_add, ← Pi.single_add]
    have hΦω : Φ ω = 1 := by
      change Φ (Finset.univ.sum ωa) = 1
      rw [map_sum]
      funext b
      rw [Finset.sum_apply, Pi.one_apply]
      have hterm : ∀ a : Fin n, Φ (ωa a) b = Pi.single a (1 : A a) b := by
        intro a
        dsimp [ωa]
        rw [hΦ_rTensor, (eLoc a).apply_symm_apply]
      rw [Finset.sum_congr rfl fun a _ => hterm a, Finset.sum_eq_single b]
      · exact Pi.single_eq_same b 1
      · intro a _ hab; exact Pi.single_eq_of_ne (Ne.symm hab) 1
      · intro hb; exact absurd (Finset.mem_univ b) hb
    have hrTensor_smul : ∀ (s : ∀ a : Fin n, A a) (a : Fin n) (z : TensorProduct R (A a) L),
        LinearMap.rTensor L (ι a) ((s a) • z) = s • LinearMap.rTensor L (ι a) z := by
      intro s a z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul u y =>
        rw [TensorProduct.smul_tmul', LinearMap.rTensor_tmul, LinearMap.rTensor_tmul,
          TensorProduct.smul_tmul']
        congr 1
        funext b
        change Pi.single a (s a * u) b = s b * Pi.single a u b
        by_cases hba : b = a
        · subst hba; rw [Pi.single_eq_same, Pi.single_eq_same]
        · rw [Pi.single_eq_of_ne hba, Pi.single_eq_of_ne hba, mul_zero]
      | add z₁ z₂ ih₁ ih₂ =>
        rw [smul_add, map_add, ih₁, ih₂, map_add, smul_add]
    let eT : TensorProduct R (∀ a : Fin n, A a) L ≃ₗ[∀ a : Fin n, A a] (∀ a : Fin n, A a) :=
      LinearEquiv.ofLinearMap Φ Ψ
        (LinearMap.ext fun t => by
          change Φ (t • ω) = t
          rw [Φ.map_smul, hΦω, smul_eq_mul, mul_one])
        (LinearMap.ext fun w => by
          change Ψ (Φ w) = w
          have h1 : ∀ x : L,
              Ψ (Φ ((1 : ∀ a : Fin n, A a) ⊗ₜ[R] x)) =
                (1 : ∀ a : Fin n, A a) ⊗ₜ[R] x := by
            intro x
            let s : ∀ a : Fin n, A a := Φ ((1 : ∀ a : Fin n, A a) ⊗ₜ[R] x)
            change s • Finset.univ.sum ωa = (1 : ∀ a : Fin n, A a) ⊗ₜ[R] x
            rw [Finset.smul_sum]
            have hterm : ∀ a : Fin n, s • ωa a = (ι a 1) ⊗ₜ[R] x := by
              intro a
              dsimp [ωa]
              rw [← hrTensor_smul s a ((eLoc a).symm 1)]
              have hsa : s a = eLoc a ((1 : A a) ⊗ₜ[R] x) := by
                change (1 : ∀ b : Fin n, A b) a * eLoc a ((1 : A a) ⊗ₜ[R] x) = _
                rw [Pi.one_apply, one_mul]
              have hsymm : (s a) • (eLoc a).symm 1 = (1 : A a) ⊗ₜ[R] x := by
                rw [← (eLoc a).symm.map_smul, smul_eq_mul, mul_one, hsa,
                  LinearEquiv.symm_apply_apply]
              rw [hsymm, LinearMap.rTensor_tmul]
            rw [Finset.sum_congr rfl fun a _ => hterm a, ← TensorProduct.sum_tmul]
            congr 1
            funext b
            rw [Finset.sum_apply, Pi.one_apply, Finset.sum_eq_single b]
            · exact Pi.single_eq_same b 1
            · intro a _ hab; exact Pi.single_eq_of_ne (Ne.symm hab) 1
            · intro hb; exact absurd (Finset.mem_univ b) hb
          induction w using TensorProduct.induction_on with
          | zero => simp
          | tmul t x =>
            have ht : t ⊗ₜ[R] x = t • ((1 : ∀ a : Fin n, A a) ⊗ₜ[R] x) := by
              rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            rw [ht, Φ.map_smul, Ψ.map_smul]
            exact congrArg (t • ·) (h1 x)
          | add w₁ w₂ ih₁ ih₂ =>
            rw [map_add, map_add, ih₁, ih₂])
    exact ⟨n, hn, f, hSum, hSurj, ⟨eT⟩⟩

  
  
  
  have h_s5_loc_charts :
      ∀ (n₀ n₁ : ℕ) (hn₀ : 1 ≤ n₀)
        (f₀ : Fin n₀ → D.R₀) (hsum₀ : Finset.univ.sum f₀ = 1)
        (f₁ : Fin n₁ → D.R₁) (hsum₁ : Finset.univ.sum f₁ = 1),
        let S₀ := ∀ a₀ : Fin n₀, Localization.Away (f₀ a₀)
        let S₁ := ∀ a₁ : Fin n₁, Localization.Away (f₁ a₁)
        let W_left := CategoryTheory.Limits.coprod
          (AlgebraicGeometry.Spec (CommRingCat.of S₀))
          (AlgebraicGeometry.Spec (CommRingCat.of S₁))
        let g_S : W_left ⟶ Z := CategoryTheory.Limits.coprod.desc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ S₀)) ≫ j₀)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ S₁)) ≫ j₁)
        ∃ (N : ℕ) (_ : 1 ≤ N)
          (U : Fin N → Z.Opens)
          (s : ∀ a : Fin N, (U a).toScheme ⟶ W_left),
          (⨆ a : Fin N, U a) = ⊤ ∧
          (∀ a : Fin N, AlgebraicGeometry.IsAffineOpen (U a)) ∧
          (∀ a : Fin N, s a ≫ g_S = (U a).ι) := by
    intro n₀ n₁ hn₀ f₀ hsum₀ f₁ hsum₁ S₀ S₁ W_left g_S
    classical
    let N := n₀ + n₁
    have hN : 1 ≤ N := by omega
    let ChartEntry := Σ (V : Z.Opens),
      { s_V : V.toScheme ⟶ W_left // AlgebraicGeometry.IsAffineOpen V ∧ s_V ≫ g_S = V.ι }
    let ι₀ : ∀ a₀ : Fin n₀,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (f₀ a₀))) ⟶ Z :=
      fun a₀ =>
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap D.R₀ (Localization.Away (f₀ a₀)))) ≫ j₀
    let ι₁ : ∀ a₁ : Fin n₁,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (f₁ a₁))) ⟶ Z :=
      fun a₁ =>
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap D.R₁ (Localization.Away (f₁ a₁)))) ≫ j₁
    let pkg₀ : Fin n₀ → ChartEntry := fun a₀ =>
      let s_raw :=
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Pi.evalRingHom (fun b => Localization.Away (f₀ b)) a₀)) ≫
          CategoryTheory.Limits.coprod.inl
      have hs_raw : s_raw ≫ g_S = ι₀ a₀ := by
        dsimp only [s_raw, g_S, ι₀]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.coprod.inl_desc,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        rfl
      ⟨(ι₀ a₀).opensRange,
        ⟨(ι₀ a₀).isoOpensRange.inv ≫ s_raw,
          ⟨AlgebraicGeometry.isAffineOpen_opensRange (ι₀ a₀),
            (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg ((ι₀ a₀).isoOpensRange.inv ≫ ·) hs_raw).trans
                ((CategoryTheory.Iso.inv_comp_eq _).mpr
                  (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι (ι₀ a₀)).symm))⟩⟩⟩
    let pkg₁ : Fin n₁ → ChartEntry := fun a₁ =>
      let s_raw :=
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Pi.evalRingHom (fun b => Localization.Away (f₁ b)) a₁)) ≫
          CategoryTheory.Limits.coprod.inr
      have hs_raw : s_raw ≫ g_S = ι₁ a₁ := by
        dsimp only [s_raw, g_S, ι₁]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.coprod.inr_desc,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        rfl
      ⟨(ι₁ a₁).opensRange,
        ⟨(ι₁ a₁).isoOpensRange.inv ≫ s_raw,
          ⟨AlgebraicGeometry.isAffineOpen_opensRange (ι₁ a₁),
            (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg ((ι₁ a₁).isoOpensRange.inv ≫ ·) hs_raw).trans
                ((CategoryTheory.Iso.inv_comp_eq _).mpr
                  (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι (ι₁ a₁)).symm))⟩⟩⟩
    let pkg : Fin N → ChartEntry := @Fin.addCases n₀ n₁ (fun _ => ChartEntry) pkg₀ pkg₁
    let U : Fin N → Z.Opens := fun a => (pkg a).1
    let s : ∀ a : Fin N, (U a).toScheme ⟶ W_left := fun a => (pkg a).2.1
    refine ⟨N, hN, U, s, ?_, fun a => (pkg a).2.2.1, fun a => (pkg a).2.2.2⟩
    apply top_unique
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    have hz_univ : z ∈ Set.range j₀.base ∪ Set.range j₁.base := hCov.symm ▸ Set.mem_univ z
    rcases hz_univ with ⟨p₀, hp₀⟩ | ⟨p₁, hp₁⟩
    · have hex₀ : ∃ a₀ : Fin n₀, f₀ a₀ ∉ p₀.asIdeal := by
        by_contra hall
        have hall' : ∀ a₀ : Fin n₀, f₀ a₀ ∈ p₀.asIdeal := fun a₀ =>
          Decidable.byContradiction fun hna => hall ⟨a₀, hna⟩
        have h1 : (1 : D.R₀) ∈ p₀.asIdeal := by
          rw [← hsum₀]
          exact Ideal.sum_mem p₀.asIdeal fun a₀ _ => hall' a₀
        exact p₀.isPrime.ne_top ((Ideal.eq_top_iff_one p₀.asIdeal).mpr h1)
      obtain ⟨a₀, ha₀⟩ := hex₀
      let p₀' : PrimeSpectrum D.R₀ := p₀
      have hp₀_mem : p₀' ∈ (PrimeSpectrum.basicOpen (f₀ a₀) : Set (PrimeSpectrum D.R₀)) := by
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        exact ha₀
      rw [← PrimeSpectrum.localization_away_comap_range
        (Localization.Away (f₀ a₀)) (f₀ a₀)] at hp₀_mem
      obtain ⟨q₀, hq₀⟩ := hp₀_mem
      refine ⟨Fin.castAdd n₁ a₀, ?_⟩
