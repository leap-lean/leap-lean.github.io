  let G'₁₁_B : Fin m₁ → Fin m₁ → TensorProduct R₁ B₀ M₁ :=
    fun s s' => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₁) (G'₁₁_1 s s')
  let G₀₁_B : Fin m₀ → Fin m₁ → TensorProduct R₁ B₀ M₀₁ :=
    fun r s => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀₁) (G₀₁_1 r s)
  let G'₀₁_B : Fin m₀ → Fin m₁ → TensorProduct R₁ B₀ M₀₁ :=
    fun r s => Algebra.TensorProduct.map θ (AlgHom.id R₁ M₀₁) (G'₀₁_1 r s)

  refine ⟨B₀, instCR, instDom, alg_kB₀, instAlgR₁, instTower,
    τ_B₀, ψ_BA, ψ_R₁, f₀_B, q₀_B, U₀_B, V₀_B, G₀₀_B, G'₀₀_B,
    f₁_B, q₁_B, U₁_B, V₁_B, G₁₁_B, G'₁₁_B, G₀₁_B, G'₀₁_B,
    hEt_B₀, hτ_comp_R₁, hψ_comp_R₁, hτA_ψ, hψ_hom, ?_,
    fun r => hProjB₀ (f₀_1 r) (hf₀_1 r),
    fun r r' => hProjB₀ (G₀₀_1 r r') (hG₀₀_1 r r'),
    fun s => hProjB₀ (f₁_1 s) (hf₁_1 s),
    fun s s' => hProjB₀ (G₁₁_1 s s') (hG₁₁_1 s s'),
    fun r s => hProjB₀ (G₀₁_1 r s) (hG₀₁_1 r s)⟩

  dsimp only
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
