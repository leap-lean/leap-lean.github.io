  let g_T : ∀ U : C.left.Etale, U ⟶ T_C :=
    fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom)
  have hInj_et : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      Function.Injective (U.hom.stalkMap y.1).hom :=
    fun U y => (hUnram (g_T U) y).1
  let ord_Uy : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      Additive (Units (FractionRing ↑(U.left.presheaf.stalk y.1))) →+ ℤ :=
    fun U y =>
      letI : IsDomain ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose
      letI : IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose_spec
      (hOrd_ex ↑(U.left.presheaf.stalk y.1) (FractionRing ↑(U.left.presheaf.stalk y.1))).choose
  have hord_Uy_spec : ∀ (U : C.left.Etale)
      (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }),
      letI : IsDomain ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose
      let R_y := ↑(U.left.presheaf.stalk y.1)
      let F_y := FractionRing R_y
      (∀ u : Units F_y,
        ∃ (a b : R_y) (na nb : ℕ),
          a ≠ 0 ∧ b ≠ 0 ∧
          algebraMap R_y F_y a = (u : F_y) * algebraMap R_y F_y b ∧
          Ideal.span ({a} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ na ∧
          Ideal.span ({b} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ nb ∧
          ord_Uy U y (Additive.ofMul u) = (na : ℤ) - (nb : ℤ)) ∧
      (∀ (u : Units F_y) (a b : R_y) (na nb : ℕ),
        a ≠ 0 → b ≠ 0 →
        algebraMap R_y F_y a = (u : F_y) * algebraMap R_y F_y b →
        Ideal.span ({a} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ na →
        Ideal.span ({b} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ nb →
        ord_Uy U y (Additive.ofMul u) = (na : ℤ) - (nb : ℤ)) ∧
      (∀ (u : Units F_y) (c d : R_y),
        c ≠ 0 → d ≠ 0 →
        (u : F_y) * algebraMap R_y F_y d = algebraMap R_y F_y c →
        (ord_Uy U y (Additive.ofMul u) ≠ 0 →
          c ∈ IsLocalRing.maximalIdeal R_y ∨ d ∈ IsLocalRing.maximalIdeal R_y) ∧
        (c ∉ IsLocalRing.maximalIdeal R_y →
          d ∉ IsLocalRing.maximalIdeal R_y →
