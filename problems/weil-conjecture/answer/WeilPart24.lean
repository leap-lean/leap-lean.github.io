  let u_V_next : V_next_sch ⟶ (weilAffineSpaceOver k δ).left := h_V_B₀ ≫ u_spec_B₀
  have : AlgebraicGeometry.Etale u_V_next := by dsimp [u_V_next]; infer_instance
  have hInt_Ynext : AlgebraicGeometry.IsIntegral Y_next :=
    (hSmConnInt_k δ 1 V_next_sch Y_next u_V_next f_next hConn_Ynext).2
  have : AlgebraicGeometry.IsIntegral Y_next := hInt_Ynext

  
  have hConn_et : ∀ (U : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine U] [ConnectedSpace ↥U]
      (g_U : Quiver.Hom U V_next_sch) [AlgebraicGeometry.Etale g_U],
      ConnectedSpace ↥(CategoryTheory.Limits.pullback f_next g_U) := by
    intro U _ _ g_U _
    let u_U : U ⟶ (weilAffineSpaceOver k δ).left := g_U ≫ u_V_next
    have : AlgebraicGeometry.Etale u_U := by dsimp [u_U]; infer_instance
    have : AlgebraicGeometry.IsIntegral U :=
      (hSmConnInt_k δ 0 U U u_U (𝟙 U) ‹ConnectedSpace ↥U›).2
    obtain ⟨F_gen, hField_F, s_F, hIrred_gen⟩ :=
      weil_smooth_integral_rel_curve_section_generic_geom_irred
        V_next_sch Y_next f_next τ₀ hτ₀_sec U g_U
    let _ : Field F_gen := hField_F
    let snd_U := CategoryTheory.Limits.pullback.snd f_next g_U
    have : AlgebraicGeometry.IsProper snd_U := inferInstance
    have hSm_sndU : AlgebraicGeometry.SmoothOfRelativeDimension 1 snd_U :=
      (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_next g_U) hSm_fnext
    have : AlgebraicGeometry.Smooth snd_U :=
      AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 snd_U
    exact hConnOfFib snd_U F_gen s_F (hConnOfIrred hIrred_gen)

  have hIrred_fib : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V_next_sch),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_next s) := by
    intro Ω _ _ s
    have hConn_s : ConnectedSpace ↥(CategoryTheory.Limits.pullback f_next s) :=
      weil_etale_proper_r0_pbc_geom_fibers_connected
        k ℓ hPBC (@hc_all) (@hr_all) hSite hCardConn hSpecR0
        V_next_sch Y_next p_V_next f_next τ₀ hτ₀_sec hConn_et Ω s
    let C_Ω : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_next s)
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_Ω.hom :=
      (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_next s) hSm_fnext
    have : AlgebraicGeometry.IsProper C_Ω.hom := by
      change AlgebraicGeometry.IsProper (CategoryTheory.Limits.pullback.snd f_next s)
      infer_instance
    have : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f_next s) :=
