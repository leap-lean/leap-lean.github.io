              rw [e_ov.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = e_ov.inv ≫ (e_ov.hom ≫ W₁₂.topIso.inv ≫ hAff_ov.isoSpec.inv.appTop) := by
              rw [CategoryTheory.Category.assoc]
        _ = e_ov.inv := by
              rw [hcomp, CategoryTheory.Category.comp_id]
    have hmon : (hAff_ov.isoSpec.inv.appTop).hom.toMonoidHom.comp W₁₂.topIso.inv.hom.toMonoidHom =
