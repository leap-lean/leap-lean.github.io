      rintro ⟨v₀, v₁, hv₀₀, hv₁₁, hv₀₁⟩
      exact hNoRoot (hGlueLoc k τ_A_R₁ C₀.left ι_C₀_R₁ C₀.hom hPb_C₀_R₁
        i_C₀ hi_C₀_R₁ hPb_iC₀.w
        f_bar₀ G_bar₀₀ f_bar₁ G_bar₁₁ G_bar₀₁
        (fun r => by rw [← hf₀_map r]; exact hMapComp (f₀_B r))
        (fun r r' => by rw [← hG₀₀_map r r']; exact hMapComp (G₀₀_B r r'))
