        ((Units.map e_A.hom.hom.toMonoidHom).comp (Units.map e_A.inv.hom.toMonoidHom))
          (Additive.toMul y) :=
      congrArg (Units.map e_A.hom.hom.toMonoidHom) h2
    have hcomp_id : e_A.hom.hom.toMonoidHom.comp e_A.inv.hom.toMonoidHom = MonoidHom.id A := by
      ext a
      exact congrArg (fun φ : CommRingCat.of A ⟶ CommRingCat.of A => φ.hom a) e_A.inv_hom_id
    rw [← Units.map_comp, hcomp_id, Units.map_id] at h3
    exact Additive.toMul.injective h3

  have hκ_ker : ∀ (A : Type u) [CommRing A]
      (h_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y')
      (hEt_A : AlgebraicGeometry.Etale h_A)
      (x : ↥(I.obj.obj (Opposite.op (mkEt A h_A hEt_A)))),
      (π_inj.hom.app (Opposite.op (mkEt A h_A hEt_A))).hom x = 0 →
      ∃ u : Units A, κ A h_A hEt_A (Additive.ofMul u) = x := by
    intro A _ h_A hEt_A x hx
    obtain ⟨u_top, hu_top⟩ := (hSecKer (mkEt A h_A hEt_A) x).mp hx
    let u_top' : Additive (Units ↑((AlgebraicGeometry.Spec (CommRingCat.of A)).presheaf.obj
      (Opposite.op ⊤))) := u_top
    let e_A := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)
    let u : Units A := Units.map e_A.hom.hom.toMonoidHom (Additive.toMul u_top')
    refine ⟨u, ?_⟩
    have hcomp_id : e_A.inv.hom.toMonoidHom.comp e_A.hom.hom.toMonoidHom = MonoidHom.id _ := by
      ext a
      exact congrArg (fun φ => φ.hom a) e_A.hom_inv_id
    have hu_eq : toGmSpec A (Additive.ofMul u) = u_top' := by
      change Additive.ofMul
        (((Units.map e_A.inv.hom.toMonoidHom).comp (Units.map e_A.hom.hom.toMonoidHom))
          (Additive.toMul u_top')) = u_top'
      rw [← Units.map_comp, hcomp_id, Units.map_id]
      rfl
    change ι_sec (mkEt A h_A hEt_A) (toGmSpec A (Additive.ofMul u)) = x
    rw [hu_eq]
    exact hu_top

  have hκ_map : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (f : A →+* B)
      (h_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y') (hEt_A : AlgebraicGeometry.Etale h_A)
      (h_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Y') (hEt_B : AlgebraicGeometry.Etale h_B)
