              have hu_ev : ev_D (MvPolynomial.X (Sum.inr u_idx)) =
                  Ideal.Quotient.mk I_D (Polynomial.C (π_C (MvPolynomial.X u_idx))) := by
                dsimp [ev_D, ι_C, I_D]
                rw [MvPolynomial.aeval_X]
                rfl
              rw [hu_ev]
              change ev_Q (Polynomial.C (π_C (MvPolynomial.X u_idx))) = _
              rw [hev_Q_C, hlam_C_π]
              change Ideal.Quotient.mk I_mv ((MvPolynomial.rename Sum.inr) (MvPolynomial.X u_idx)) = _
              rw [MvPolynomial.rename_X]
        apply RingHom.ext
        intro x
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact RingHom.congr_fun hmv_eq P
      exact fun x => RingHom.congr_fun hcomp_id x
    have h_right_D : Function.RightInverse g_D_ring f_D_ring := by
      have hcomp_id : f_D_ring.comp g_D_ring = RingHom.id D := by
        have hp_eq : (f_D_ring.comp g_D_ring).comp (Ideal.Quotient.mk I_D) =
            Ideal.Quotient.mk I_D := by
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            obtain ⟨P, rfl⟩ := hπ_C_surj c
            change f_D_ring (ev_Q (Polynomial.C (π_C P))) = ι_C (π_C P)
            rw [hev_Q_C, hlam_C_π]
            change ev_D ((MvPolynomial.rename Sum.inr) P) = ι_C (π_C P)
            exact hev_D_inr P
          · change f_D_ring (ev_Q Polynomial.X) = w
            rw [hev_Q_X]
            change ev_D (MvPolynomial.X (Sum.inl ())) = w
            simp [ev_D]
        apply RingHom.ext
        intro x
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact RingHom.congr_fun hp_eq P
      exact fun x => RingHom.congr_fun hcomp_id x
    let e_D_ring : Q_mv ≃+* D :=
      { f_D_ring with
        invFun := g_D_ring
        left_inv := h_left_D
        right_inv := h_right_D }
    let e_D : Q_mv ≃ₐ[B₀] D :=
      AlgEquiv.ofRingEquiv (f := e_D_ring) (fun b => by
        change ev_D (MvPolynomial.C b) = algebraMap B₀ D b
        rw [← MvPolynomial.algebraMap_eq]
        exact ev_D.commutes b)
    let m_D : (Unit ⊕ σ) → (Unit ⊕ (Unit ⊕ ι₀)) := Sum.inr ∘ Sum.map id P₀.map
    have hm_D_inj : Function.Injective m_D :=
      Sum.inr_injective.comp (Sum.map_injective.mpr ⟨Function.injective_id, P₀.map_inj⟩)
    let P_D_naive := Algebra.PreSubmersivePresentation.naive (R := B₀) (v := v_rel) m_D hm_D_inj
    let P_D : Algebra.PreSubmersivePresentation B₀ D (Unit ⊕ (Unit ⊕ ι₀)) (Unit ⊕ σ) :=
      P_D_naive.ofAlgEquiv e_D
    have hdim_PD : P_D.dimension = 1 := by
      rw [show P_D.dimension = P_D_naive.dimension from
        Algebra.Presentation.dimension_ofAlgEquiv P_D_naive.toPresentation e_D]
      dsimp [Algebra.Presentation.dimension]
      rw [Nat.card_sum, Nat.card_sum, Nat.card_sum, Nat.card_unique, hcard_eq]
      omega
    have hz_mem_qD : ι_C z ∈ q_D := by
      have hw_pow_mem : w ^ ℓ ∈ q_D := Ideal.pow_mem_of_mem q_D hw_mem ℓ hℓ_pos
      have hprod_mem : ι_C (ν : C_tilde) * ι_C z ∈ q_D := by
        have heq_w : w ^ ℓ = ι_C (ν : C_tilde) * ι_C z := hw_pow_D.trans (map_mul ι_C _ _)
        exact heq_w ▸ hw_pow_mem
      have hmul_inv : ι_C ((ν⁻¹ : Units C_tilde) : C_tilde) * (ι_C (ν : C_tilde) * ι_C z) ∈ q_D :=
        Ideal.mul_mem_left _ _ hprod_mem
      have hcancel_ν : ι_C ((ν⁻¹ : Units C_tilde) : C_tilde) * (ι_C (ν : C_tilde) * ι_C z) =
          ι_C z := by
        rw [← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
      exact hcancel_ν ▸ hmul_inv
    have hK_nontriv : Nontrivial (D ⧸ q_D) := Ideal.Quotient.nontrivial_iff.mpr hq_prime.ne_top
    let mk_q : D →+* (D ⧸ q_D) := Ideal.Quotient.mk q_D
    let ρ_D : P_D.Ring →+* D := algebraMap P_D.Ring D
    have hρ_D_eq : ρ_D = ev_D.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro b
        change algebraMap P_D.Ring D (MvPolynomial.C b) = ev_D (MvPolynomial.C b)
        rw [Algebra.Generators.algebraMap_apply, MvPolynomial.aeval_C,
          ← MvPolynomial.algebraMap_eq, ev_D.commutes]
      · intro u_idx
        change algebraMap P_D.Ring D (MvPolynomial.X u_idx) = ev_D (MvPolynomial.X u_idx)
        rw [Algebra.Generators.algebraMap_apply, MvPolynomial.aeval_X]
        change f_D_ring (Ideal.Quotient.mk I_mv (MvPolynomial.X u_idx)) = ev_D (MvPolynomial.X u_idx)
        exact Ideal.Quotient.lift_mk I_mv ev_D.toRingHom hker_ev_D
    let ρ_q : P_D.Ring →+* (D ⧸ q_D) := mk_q.comp ρ_D
    have hρ_q_Z : ρ_q (MvPolynomial.X (Sum.inr (Sum.inl ()))) = 0 := by
      change mk_q (ρ_D (MvPolynomial.X (Sum.inr (Sum.inl ())))) = 0
      rw [hρ_D_eq]
      have hz_ev : ev_D (MvPolynomial.X (Sum.inr (Sum.inl ()))) = ι_C z := by
        simp [ev_D, hπ_C_inl]
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hz_ev]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hz_mem_qD
    have hρ_q_ν : ρ_q (MvPolynomial.rename Sum.inr ν_tilde) = mk_q (ι_C (ν : C_tilde)) := by
      change mk_q (ρ_D (MvPolynomial.rename Sum.inr ν_tilde)) = _
      rw [hρ_D_eq, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hev_D_inr, hν_tilde]
    have hpderiv_W_pow : ∀ (u₁ : Unit ⊕ ι₀) (n : ℕ),
        (MvPolynomial.pderiv (Sum.inr u₁ : Unit ⊕ (Unit ⊕ ι₀)))
          ((MvPolynomial.X (Sum.inl ()) : MvPolynomial (Unit ⊕ (Unit ⊕ ι₀)) B₀) ^ n) = 0 := by
      intro u₁ n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ, Derivation.leibniz, ih, MvPolynomial.pderiv_X,
          Pi.single_eq_of_ne (by simp), smul_zero, smul_zero, add_zero]
    let A_blk : Matrix Unit Unit (D ⧸ q_D) := Matrix.of fun _ _ => -mk_q (ι_C (ν : C_tilde))
    let B_blk : Matrix Unit σ (D ⧸ q_D) :=
      Matrix.of fun _ j => ρ_q (P_D.jacobiMatrix (Sum.inl ()) (Sum.inr j))
    let M_et : Matrix σ σ (D ⧸ q_D) :=
      Matrix.of fun i j => mk_q (ι_C (algebraMap P₀.Ring C_tilde (P₀.jacobiMatrix i j)))
    have hmat_blocks : RingHom.mapMatrix ρ_q P_D.jacobiMatrix =
        Matrix.fromBlocks A_blk B_blk 0 M_et := by
      ext (⟨⟩ | i) (⟨⟩ | j)
      · simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.fromBlocks_apply₁₁, A_blk,
          Matrix.of_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        change ρ_q ((MvPolynomial.pderiv (Sum.inr (Sum.inl ()))) (v_rel (Sum.inl ()))) =
          -mk_q (ι_C (ν : C_tilde))
        dsimp [v_rel]
        rw [map_sub, hpderiv_W_pow (Sum.inl ()) ℓ, zero_sub, map_neg, Derivation.leibniz,
          MvPolynomial.pderiv_X, Pi.single_eq_same]
        simp only [smul_eq_mul, mul_one, map_add, map_mul, hρ_q_Z, hρ_q_ν]
        ring
      · simp [B_blk]
      · simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.fromBlocks_apply₂₁,
          Matrix.zero_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        change ρ_q ((MvPolynomial.pderiv (Sum.inr (Sum.inr (P₀.map i)))) (v_rel (Sum.inl ()))) = 0
        dsimp [v_rel]
        rw [map_sub, hpderiv_W_pow (Sum.inr (P₀.map i)) ℓ, zero_sub, Derivation.leibniz,
          MvPolynomial.pderiv_X, Pi.single_eq_of_ne (by simp)]
        simp only [smul_eq_mul, mul_zero, zero_add]
        let P_der : MvPolynomial (Unit ⊕ (Unit ⊕ ι₀)) B₀ :=
          (MvPolynomial.pderiv (Sum.inr (Sum.inr (P₀.map i)) : Unit ⊕ (Unit ⊕ ι₀)))
            ((MvPolynomial.rename (Sum.inr : (Unit ⊕ ι₀) → (Unit ⊕ (Unit ⊕ ι₀)))) ν_tilde)
        change Ideal.Quotient.mk q_D (ρ_D (-(MvPolynomial.X (Sum.inr (Sum.inl ())) * P_der))) = 0
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        have hz_ρ : ρ_D (MvPolynomial.X (Sum.inr (Sum.inl ()))) = ι_C z := by
          rw [hρ_D_eq]
          simp [ev_D, hπ_C_inl]
        have h_val_d : ρ_D (-(MvPolynomial.X (Sum.inr (Sum.inl ())) * P_der)) =
            -(ι_C z * ρ_D P_der) :=
          (map_neg ρ_D _).trans
            (congrArg Neg.neg ((map_mul ρ_D _ _).trans (congrArg (· * ρ_D P_der) hz_ρ)))
        exact h_val_d.symm ▸ q_D.neg_mem (Ideal.mul_mem_right (ρ_D P_der) q_D hz_mem_qD)
      · simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.fromBlocks_apply₂₂, M_et,
          Matrix.of_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        change ρ_q ((MvPolynomial.pderiv (Sum.inr (Sum.inr (P₀.map i))))
          (MvPolynomial.rename Sum.inr (F j))) =
          mk_q (ι_C (algebraMap P₀.Ring C_tilde ((MvPolynomial.pderiv (P₀.map i)) (P₀.relation j))))
        rw [MvPolynomial.pderiv_rename Sum.inr_injective]
        change mk_q (ρ_D (MvPolynomial.rename Sum.inr
          ((MvPolynomial.pderiv (Sum.inr (P₀.map i))) (F j)))) = _
        rw [hρ_D_eq, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hev_D_inr]
        have h_entry : π_C ((MvPolynomial.pderiv (Sum.inr (P₀.map i))) (F j)) =
            algebraMap P₀.Ring C_tilde ((MvPolynomial.pderiv (P₀.map i)) (P₀.relation j)) := by
          dsimp [F]
          rw [hpderiv_eZ_symm (P₀.map i) (P₀.relation j)]
          change aeval_P₀ (e_Z (e_Z.symm ((MvPolynomial.pderiv (P₀.map i)) (P₀.relation j)))) = _
          rw [e_Z.apply_symm_apply, Algebra.Generators.algebraMap_apply]
        exact congrArg (fun x => mk_q (ι_C x)) h_entry
    have hdet_Met : M_et.det = mk_q (ι_C P₀.jacobian) := by
      let φ_C_Kq : P₀.Ring →+* (D ⧸ q_D) := mk_q.comp (ι_C.comp (algebraMap P₀.Ring C_tilde))
      have hMet_eq : M_et = RingHom.mapMatrix φ_C_Kq P₀.jacobiMatrix := by
        ext i j
        rfl
      have hP₀_jac : P₀.jacobian = algebraMap P₀.Ring C_tilde P₀.jacobiMatrix.det := by
        have h1 := Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det
          P₀.toPreSubmersivePresentation
        convert h1
      rw [hMet_eq, ← RingHom.map_det]
      dsimp [φ_C_Kq]
      rw [hP₀_jac]
    have hmk_jac_PD : mk_q P_D.jacobian =
        mk_q ((-ι_C (ν : C_tilde)) * ι_C P₀.jacobian) := by
      have hPD_jac : P_D.jacobian = ρ_D P_D.jacobiMatrix.det := by
        have h1 := Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det P_D
        convert h1
      have hmul_neg : (-mk_q (ι_C (ν : C_tilde))) * mk_q (ι_C P₀.jacobian) =
          mk_q ((-ι_C (ν : C_tilde)) * ι_C P₀.jacobian) :=
        ((map_mul mk_q (-ι_C (ν : C_tilde)) (ι_C P₀.jacobian)).trans
          (congrArg (· * mk_q (ι_C P₀.jacobian)) (map_neg mk_q (ι_C (ν : C_tilde))))).symm
      have hmap_det : ρ_q P_D.jacobiMatrix.det = (RingHom.mapMatrix ρ_q P_D.jacobiMatrix).det := by
        symm
        rw [← RingHom.map_det]
      calc
        mk_q P_D.jacobian
          = ρ_q P_D.jacobiMatrix.det := by rw [hPD_jac]; rfl
        _ = (RingHom.mapMatrix ρ_q P_D.jacobiMatrix).det := hmap_det
        _ = (Matrix.fromBlocks A_blk B_blk 0 M_et).det := by rw [hmat_blocks]
        _ = A_blk.det * M_et.det := Matrix.det_fromBlocks_zero₂₁ A_blk B_blk M_et
        _ = (-mk_q (ι_C (ν : C_tilde))) * mk_q (ι_C P₀.jacobian) := by
            rw [Matrix.det_unique, hdet_Met]
            rfl
        _ = mk_q ((-ι_C (ν : C_tilde)) * ι_C P₀.jacobian) := hmul_neg
    let g_D : D := P_D.jacobian
    have hg_D_not_qD : g_D ∉ q_D := by
      intro hg_mem
      have h0 : mk_q g_D = (0 : D ⧸ q_D) := Ideal.Quotient.eq_zero_iff_mem.mpr hg_mem
      have hunit_D : IsUnit ((-ι_C (ν : C_tilde)) * ι_C P₀.jacobian) :=
        ((ν.isUnit.map ι_C).neg).mul (P₀.jacobian_isUnit.map ι_C)
      have hunit_K : IsUnit (mk_q g_D) := by
        change IsUnit (mk_q P_D.jacobian)
        rw [hmk_jac_PD]
        exact hunit_D.map mk_q
      exact @IsUnit.ne_zero (D ⧸ q_D) _ hK_nontriv (mk_q g_D) hunit_K h0
    let D_loc := Localization.Away g_D
    let Q_loc : Algebra.PreSubmersivePresentation D D_loc Unit Unit :=
      Algebra.PreSubmersivePresentation.localizationAway D_loc g_D
    let P_tot := Q_loc.comp P_D
    have hjac_tot : IsUnit P_tot.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      have hu_gD : IsUnit (algebraMap D D_loc g_D) :=
        IsLocalization.Away.algebraMap_isUnit g_D
      exact hu_gD.mul hu_gD
    have hdim_tot : P_tot.dimension = 1 := by
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension,
        show Q_loc.dimension = 0 from Algebra.Presentation.localizationAway_dimension_zero g_D,
        hdim_PD, zero_add]
    let S_tot : Algebra.SubmersivePresentation B₀ D_loc _ _ := ⟨P_tot, hjac_tot⟩
    exact ⟨g_D, hg_D_not_qD, S_tot.isStandardSmoothOfRelativeDimension hdim_tot⟩
  
  have draft_away_step : ∀ (A A₁ : Type u) [CommRing A] [CommRing A₁] [Algebra A A₁]
      (s₁ : A) [IsLocalization.Away s₁ A₁]
      (r₀ : A₁) (k : ℕ) (r₂ : A),
      r₀ * algebraMap A A₁ (s₁ ^ k) = algebraMap A A₁ r₂ →
      IsLocalization.Away (s₁ * r₂) (Localization.Away r₀) := by
    intro A A₁ _ _ _ s₁ _ r₀ k r₂ hr
    let A₂ := Localization.Away r₀
    have hu_pow : IsUnit (algebraMap A A₁ (s₁ ^ k)) := by
      rw [map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit s₁).pow k
    let u₁ : Units A₁ := hu_pow.unit
    have hr_u : r₀ * (u₁ : A₁) = algebraMap A A₁ r₂ := hr
    have h_loc_r₂ : IsLocalization.Away (algebraMap A A₁ r₂) A₂ :=
      { map_units := by
          rintro ⟨_, n, rfl⟩
          dsimp only
          rw [map_pow, ← hr_u, map_mul]
          exact ((IsLocalization.Away.algebraMap_isUnit r₀).mul (u₁.isUnit.map _)).pow n
        surj := by
          intro z
          obtain ⟨⟨c, _, n, rfl⟩, hc⟩ := IsLocalization.surj (Submonoid.powers r₀) z
          refine ⟨⟨c * (u₁ : A₁) ^ n, ⟨(algebraMap A A₁ r₂) ^ n, n, rfl⟩⟩, ?_⟩
          change z * algebraMap A₁ A₂ ((algebraMap A A₁ r₂) ^ n) =
            algebraMap A₁ A₂ (c * (u₁ : A₁) ^ n)
          have h_pow_eq : (algebraMap A A₁ r₂) ^ n = r₀ ^ n * (u₁ : A₁) ^ n := by
            rw [← hr_u, mul_pow]
          rw [h_pow_eq, map_mul, ← mul_assoc, hc, map_mul]
        exists_of_eq := by
          intro x y hxy
          obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
            IsLocalization.exists_of_eq (M := Submonoid.powers r₀) hxy
          refine ⟨⟨(algebraMap A A₁ r₂) ^ n, n, rfl⟩, ?_⟩
          change (algebraMap A A₁ r₂) ^ n * x = (algebraMap A A₁ r₂) ^ n * y
          have h_pow_eq : (algebraMap A A₁ r₂) ^ n = (u₁ : A₁) ^ n * r₀ ^ n := by
            rw [← hr_u, mul_comm r₀, mul_pow]
          have hn' : r₀ ^ n * x = r₀ ^ n * y := hn
          rw [h_pow_eq, mul_assoc, hn', ← mul_assoc] }
    haveI : IsLocalization.Away (algebraMap A A₁ r₂) A₂ := h_loc_r₂
    exact IsLocalization.Away.mul' A₁ A₂ s₁ r₂
  
  have draft_case2_finish : ∀ (B₁ B_x R₁ C'_x C_tilde : Type u)
      [CommRing B₁] [CommRing B_x] [CommRing R₁] [CommRing C'_x] [CommRing C_tilde]
      [Algebra B₁ B_x] [Algebra.Etale B₁ B_x]
      [Algebra B₁ R₁] [Algebra R₁ C'_x] [Algebra B_x C'_x]
      [Algebra R₁ C_tilde] [Algebra C'_x C_tilde] [Algebra B_x C_tilde]
      [IsScalarTower R₁ C'_x C_tilde] [IsScalarTower B_x C'_x C_tilde],
      (∀ b : B₁,
        algebraMap B_x C'_x (algebraMap B₁ B_x b) = algebraMap R₁ C'_x (algebraMap B₁ R₁ b)) →
      ∀ (u₁ : Units R₁) (t₁ s_x : R₁) [IsLocalization.Away s_x C_tilde]
      (q : Ideal (Polynomial R₁ ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((u₁ : R₁) * t₁)}))
      [q.IsPrime],
      ((Ideal.Quotient.mk
        (Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((u₁ : R₁) * t₁)})).comp Polynomial.C)
        s_x ∉ q →
      Ideal.Quotient.mk
        (Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((u₁ : R₁) * t₁)}) Polynomial.X ∈ q →
      ∀ (ψ_loc : Polynomial B_x →ₐ[B_x] C_tilde), RingHom.Etale ψ_loc.toRingHom →
      ∀ (ω_x : Units C_tilde),
      algebraMap C'_x C_tilde (algebraMap R₁ C'_x t₁) =
        (ω_x : C_tilde) * ψ_loc Polynomial.X →
      let S₁ := Polynomial R₁ ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((u₁ : R₁) * t₁)}
      let ι_R₁ : R₁ →+* S₁ := (Ideal.Quotient.mk _).comp Polynomial.C
      ∃ g_q : S₁, g_q ∉ q ∧
        RingHom.IsStandardSmoothOfRelativeDimension 1
          ((algebraMap S₁ (Localization.Away g_q)).comp (ι_R₁.comp (algebraMap B₁ R₁))) := by
    intro B₁ B_x R₁ C'_x C_tilde _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hB_C' u₁ t₁ s_x _
      q _ hs_x_not_q hw ψ_loc hEt_loc ω_x ht'_eq S₁ ι_R₁
    have hB_Ct : ∀ b : B₁,
        algebraMap B_x C_tilde (algebraMap B₁ B_x b) = algebraMap R₁ C_tilde (algebraMap B₁ R₁ b) := by
      intro b
      rw [IsScalarTower.algebraMap_apply B_x C'_x C_tilde, hB_C' b,
        ← IsScalarTower.algebraMap_apply R₁ C'_x C_tilde]
    have ht_Ct : algebraMap R₁ C_tilde t₁ = (ω_x : C_tilde) * ψ_loc Polynomial.X := by
      rw [IsScalarTower.algebraMap_apply R₁ C'_x C_tilde t₁]
      exact ht'_eq
    have hq_prime : q.IsPrime := inferInstance
    let ν_x : Units C_tilde := Units.map (algebraMap R₁ C_tilde).toMonoidHom u₁ * ω_x
    let z_x : C_tilde := ψ_loc Polynomial.X
    have h_ut_eq : (ν_x : C_tilde) * z_x = algebraMap R₁ C_tilde ((u₁ : R₁) * t₁) := by
      change (algebraMap R₁ C_tilde (u₁ : R₁) * (ω_x : C_tilde)) * z_x =
        algebraMap R₁ C_tilde ((u₁ : R₁) * t₁)
      rw [mul_assoc, ← ht_Ct, ← map_mul]
    let D_x := Polynomial C_tilde ⧸
      Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((ν_x : C_tilde) * z_x)}
    let ι_Cx : C_tilde →+* D_x := (Ideal.Quotient.mk _).comp Polynomial.C
    obtain ⟨φ_sx, hφ_sx_comp, hφ_sx_X, h_loc_sx_Dx⟩ :=
      draft_s2a R₁ C_tilde ((u₁ : R₁) * t₁) s_x ((ν_x : C_tilde) * z_x) h_ut_eq
    letI _alg_S_Dx : Algebra S₁ D_x := φ_sx.toAlgebra
