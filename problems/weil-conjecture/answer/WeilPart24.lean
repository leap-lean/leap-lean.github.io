import WeilPart23
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_smooth_curve_dominant_stalk_ramification_and_open_pts (k : Type u) [Field k] [IsAlgClosed k] :
    ((∀ C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)),
        IsProjectiveOverField k C → CompactSpace ↥C.left ∧ C.left.IsSeparated) ∧
      (∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
         [AlgebraicGeometry.IsIntegral C.left],
        IsProjectiveOverField k C →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
          (m : ℕ)
          (P_pts : Fin m → { x : ↥C.left // IsClosed ({x} : Set ↥C.left) })
          (U : C.left.Opens),
          (U : Set ↥C.left) = (⋃ a : Fin m, {(P_pts a).1})ᶜ →
          @genericPoint ↥C.left _ _ (AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left) ∈ U ∧
            Nonempty ↥U.toScheme)) ∧
    (∀ (C₁ C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
       [AlgebraicGeometry.IsIntegral C₁.left] [C₁.left.IsSeparated]
       [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₁.hom]
       [AlgebraicGeometry.IsIntegral C₂.left] [C₂.left.IsSeparated]
       [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₂.hom]
       (h : C₁.left ⟶ C₂.left),
      letI : IrreducibleSpace ↥C₁.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₁.left
      letI : IrreducibleSpace ↥C₂.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₂.left
      h ≫ C₂.hom = C₁.hom →
      (AlgebraicGeometry.IsOpenImmersion h ∨ AlgebraicGeometry.Surjective h) →
      ∃ h_gen : h.base (genericPoint ↥C₁.left) = genericPoint ↥C₂.left,
        let φ_h : ↑C₂.left.functionField →+* ↑C₁.left.functionField :=
          ((C₂.left.presheaf.stalkCongr (Inseparable.of_eq h_gen.symm)).hom ≫
            h.stalkMap (genericPoint ↥C₁.left)).hom
        (AlgebraicGeometry.IsOpenImmersion h → Function.Bijective φ_h) ∧
        ∀ x₁ : { x : ↥C₁.left // IsClosed ({x} : Set ↥C₁.left) },
          IsClosed ({h.base x₁.1} : Set ↥C₂.left) ∧
          ∃ e : ℕ, 1 ≤ e ∧
            Ideal.map (h.stalkMap x₁.1).hom
              (IsLocalRing.maximalIdeal ↑(C₂.left.presheaf.stalk (h.base x₁.1))) =
              (IsLocalRing.maximalIdeal ↑(C₁.left.presheaf.stalk x₁.1)) ^ e ∧
            (AlgebraicGeometry.IsOpenImmersion h → e = 1) ∧
            (∀ n : ℕ,
              Ideal.map (h.stalkMap x₁.1).hom
                (IsLocalRing.maximalIdeal ↑(C₂.left.presheaf.stalk (h.base x₁.1))) =
                (IsLocalRing.maximalIdeal ↑(C₁.left.presheaf.stalk x₁.1)) ^ n →
              e = n) ∧
            (∀ (f₂ : Units ↑C₂.left.functionField)
               (a₂ b₂ : ↑(C₂.left.presheaf.stalk (h.base x₁.1))) (na₂ nb₂ : ℕ),
              a₂ ≠ 0 → b₂ ≠ 0 →
              algebraMap ↑(C₂.left.presheaf.stalk (h.base x₁.1)) ↑C₂.left.functionField a₂ =
                (f₂ : ↑C₂.left.functionField) *
                  algebraMap ↑(C₂.left.presheaf.stalk (h.base x₁.1)) ↑C₂.left.functionField b₂ →
              Ideal.span ({a₂} : Set ↑(C₂.left.presheaf.stalk (h.base x₁.1))) =
                (IsLocalRing.maximalIdeal ↑(C₂.left.presheaf.stalk (h.base x₁.1))) ^ na₂ →
              Ideal.span ({b₂} : Set ↑(C₂.left.presheaf.stalk (h.base x₁.1))) =
                (IsLocalRing.maximalIdeal ↑(C₂.left.presheaf.stalk (h.base x₁.1))) ^ nb₂ →
              ∃ (a₁ b₁ : ↑(C₁.left.presheaf.stalk x₁.1)),
                a₁ ≠ 0 ∧ b₁ ≠ 0 ∧
                algebraMap ↑(C₁.left.presheaf.stalk x₁.1) ↑C₁.left.functionField a₁ =
                  ((Units.map φ_h.toMonoidHom f₂ : Units ↑C₁.left.functionField) :
                    ↑C₁.left.functionField) *
                    algebraMap ↑(C₁.left.presheaf.stalk x₁.1) ↑C₁.left.functionField b₁ ∧
                Ideal.span ({a₁} : Set ↑(C₁.left.presheaf.stalk x₁.1)) =
                  (IsLocalRing.maximalIdeal ↑(C₁.left.presheaf.stalk x₁.1)) ^ (e * na₂) ∧
                Ideal.span ({b₁} : Set ↑(C₁.left.presheaf.stalk x₁.1)) =
                  (IsLocalRing.maximalIdeal ↑(C₁.left.presheaf.stalk x₁.1)) ^ (e * nb₂))) :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hBot_prime : (⊥ : Ideal k).IsPrime := by
    refine ⟨bot_ne_top, fun {a b} hab => ?_⟩
    rw [Ideal.mem_bot] at hab ⊢
    rw [Ideal.mem_bot]
    exact mul_eq_zero.mp hab
  let pt_k : ↥S_k := ⟨⊥, hBot_prime⟩
  have hPrime_bot_k : ∀ (I : Ideal k), I.IsPrime → I = ⊥ := by
    intro I hI
    by_contra hne
    obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    have h1 : (1 : k) ∈ I := mul_inv_cancel₀ ha0 ▸ I.mul_mem_right a⁻¹ ha
    exact hI.ne_top ((Ideal.eq_top_iff_one I).mpr h1)
  have hSub_Sk : ∀ z : ↥S_k, z = pt_k := fun z =>
    PrimeSpectrum.ext (hPrime_bot_k z.asIdeal z.isPrime)

  
  have hNoethPrincipalToDVR : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
      [IsNoetherianRing R] (t : R),
      t ≠ 0 →
      IsLocalRing.maximalIdeal R = Ideal.span ({t} : Set R) →
      IsDiscreteValuationRing R ∧ StrictAnti (fun n : ℕ => IsLocalRing.maximalIdeal R ^ n) := by
    intro R _ _ _ _ t ht_ne hm_eq
    let mR := IsLocalRing.maximalIdeal R
    have hm_ne_top : mR ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have ht_mem : t ∈ mR := by
      change t ∈ IsLocalRing.maximalIdeal R
      rw [hm_eq]
      exact Ideal.subset_span (Set.mem_singleton t)
    have ht_not_unit : ¬ IsUnit t := fun hu =>
      (IsLocalRing.notMem_maximalIdeal.mpr hu) ht_mem
    have hm_pow : ∀ n : ℕ, mR ^ n = Ideal.span ({t ^ n} : Set R) := by
      intro n
      dsimp [mR]
      rw [hm_eq, Ideal.span_singleton_pow]
    have hKrull : (⨅ n : ℕ, mR ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing mR hm_ne_top
    have hStrict : StrictAnti (fun n : ℕ => mR ^ n) := by
      refine strictAnti_nat_of_succ_lt (fun n => ?_)
      have hle : mR ^ (n + 1) ≤ mR ^ n := Ideal.pow_le_pow_right (Nat.le_succ n)
      refine lt_of_le_of_ne hle (fun heq => ?_)
      have htn_mem : t ^ n ∈ mR ^ (n + 1) := by
        rw [heq, hm_pow n]
        exact Ideal.subset_span (Set.mem_singleton (t ^ n))
      rw [hm_pow (n + 1), Ideal.mem_span_singleton] at htn_mem
      obtain ⟨r, hr⟩ := htn_mem
      have htn_ne : t ^ n ≠ 0 := pow_ne_zero n ht_ne
      have hcancel : (1 : R) = t * r := by
        apply mul_left_cancel₀ htn_ne
        calc
          t ^ n * 1 = t ^ n := mul_one _
          _ = t ^ (n + 1) * r := hr
          _ = t ^ n * (t * r) := by ring
      exact ht_not_unit ⟨⟨t, r, hcancel.symm, mul_comm r t ▸ hcancel.symm⟩, rfl⟩
    have hPIR : IsPrincipalIdealRing R := by
      rw [isPrincipalIdealRing_iff]
      intro I
      by_cases hI : I = ⊥
      · subst hI
        exact ⟨⟨0, (Ideal.span_singleton_eq_bot.mpr rfl).symm⟩⟩
      · obtain ⟨z₀, hz₀_I, hz₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
        have hz₀_not_inf : z₀ ∉ (⨅ k : ℕ, mR ^ k) := by
          rw [hKrull, Ideal.mem_bot]
          exact hz₀_ne
        have hex_k₀ : ∃ k₀ : ℕ, z₀ ∉ mR ^ k₀ := by
          by_contra hall
          apply hz₀_not_inf
          rw [Ideal.mem_iInf]
          intro k₀
          by_contra hnk
          exact hall ⟨k₀, hnk⟩
        obtain ⟨k₀, hk₀⟩ := hex_k₀
        have hk₀_pos : ∃ n : ℕ, ∃ z ∈ I, z ∉ mR ^ (n + 1) := by
          cases k₀ with
          | zero =>
            exfalso
            rw [pow_zero, Ideal.one_eq_top] at hk₀
            exact hk₀ Submodule.mem_top
          | succ n =>
            exact ⟨n, z₀, hz₀_I, hk₀⟩
        let n₀ : ℕ := Nat.find hk₀_pos
        have hn₀_spec : ∃ z ∈ I, z ∉ mR ^ (n₀ + 1) := Nat.find_spec hk₀_pos
        have hn₀_min : ∀ j : ℕ, j < n₀ → ∀ z ∈ I, z ∈ mR ^ (j + 1) := by
          intro j hj z hz
          have hnot := Nat.find_min hk₀_pos hj
          by_contra hnz
          exact hnot ⟨z, hz, hnz⟩
        have hI_le : I ≤ Ideal.span ({t ^ n₀} : Set R) := by
          rw [← hm_pow n₀]
          intro z hz
          by_cases hn0 : n₀ = 0
          · rw [hn0, pow_zero, Ideal.one_eq_top]
            exact Submodule.mem_top
          · have hlt : n₀ - 1 < n₀ := Nat.sub_one_lt hn0
            have hsucc : n₀ - 1 + 1 = n₀ :=
              Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hn0)
            rw [← hsucc]
            exact hn₀_min (n₀ - 1) hlt z hz
        obtain ⟨z₁, hz₁_I, hz₁_not⟩ := hn₀_spec
        have hz₁_sp : z₁ ∈ Ideal.span ({t ^ n₀} : Set R) := hI_le hz₁_I
        rw [Ideal.mem_span_singleton] at hz₁_sp
        obtain ⟨u, hu_eq⟩ := hz₁_sp
        have hu_not_m : u ∉ mR := by
          intro hu_m
          change u ∈ IsLocalRing.maximalIdeal R at hu_m
          rw [hm_eq, Ideal.mem_span_singleton] at hu_m
          obtain ⟨v, hv⟩ := hu_m
          apply hz₁_not
          rw [hm_pow (n₀ + 1), Ideal.mem_span_singleton]
          exact ⟨v, by rw [hu_eq, hv]; ring⟩
        have hu_unit : IsUnit u := IsLocalRing.notMem_maximalIdeal.mp hu_not_m
        obtain ⟨u₀, rfl⟩ := hu_unit
        have htn₀_I : t ^ n₀ ∈ I := by
          have hmul : z₁ * ↑u₀⁻¹ = t ^ n₀ := by
            rw [hu_eq, mul_assoc, Units.mul_inv, mul_one]
          exact hmul ▸ I.mul_mem_right (↑u₀⁻¹) hz₁_I
        have hsp_le : Ideal.span ({t ^ n₀} : Set R) ≤ I :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr htn₀_I)
        exact ⟨⟨t ^ n₀, le_antisymm hI_le hsp_le⟩⟩
    have hm_ne_bot : mR ≠ ⊥ := by
      intro hbot
      exact ht_ne (Ideal.mem_bot.mp (hbot ▸ ht_mem))
    exact ⟨@IsDiscreteValuationRing.mk R _ _ hPIR _ hm_ne_bot, hStrict⟩

  
  
  
  have hSmoothCurveClosedPt : ∀ (C : CategoryTheory.Over S_k)
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
      (x : ↥C.left),
      IsClosed ({x} : Set ↥C.left) →
      (∃ s₁ : S_k ⟶ C.left, s₁ ≫ C.hom = 𝟙 S_k ∧ s₁.base pt_k = x) ∧
      (∀ [AlgebraicGeometry.IsIntegral C.left],
        IsDiscreteValuationRing ↑(C.left.presheaf.stalk x) ∧
        StrictAnti (fun n : ℕ => IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x) ^ n)) := by
    intro C _ x hx
    obtain ⟨U_k, hAff_Uk, V, hAff_V, hxV, he, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C.hom).mp inferInstance x
    have hUk_top : U_k = ⊤ := by
      ext z
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      have hz_eq : z = C.hom.base x := (hSub_Sk z).trans (hSub_Sk (C.hom.base x)).symm
      rw [hz_eq]
      exact he hxV
    subst hUk_top
    have : CategoryTheory.IsIso hAff_Uk.fromSpec := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      infer_instance
    let A_k := S_k.presheaf.obj (Opposite.op (⊤ : S_k.Opens))
    let φ_k : CommRingCat.of k ⟶ A_k := AlgebraicGeometry.Spec.preimage hAff_Uk.fromSpec
    let ψ_k : A_k ⟶ CommRingCat.of k :=
      AlgebraicGeometry.Spec.preimage (CategoryTheory.inv hAff_Uk.fromSpec)
    have hφψ_k : φ_k ≫ ψ_k = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have hψφ_k : ψ_k ≫ φ_k = 𝟙 A_k := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.hom_inv_id,
        AlgebraicGeometry.Spec.map_id]
    let e_k : k ≃+* ↑A_k :=
      { φ_k.hom with
        invFun := ψ_k.hom
        left_inv := fun c => congrArg (fun u : CommRingCat.of k ⟶ CommRingCat.of k => u.hom c) hφψ_k
        right_inv := fun a => congrArg (fun u : A_k ⟶ A_k => u.hom a) hψφ_k }
    let A_obj := C.left.presheaf.obj (Opposite.op V)
    let A := ↑A_obj
    let f_V : CommRingCat.of k ⟶ A_obj := φ_k ≫ C.hom.appLE ⊤ V he
    have hSpec_fV : AlgebraicGeometry.Spec.map f_V = hAff_V.fromSpec ≫ C.hom := by
      dsimp [f_V]
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec C.hom hAff_Uk hAff_V he
    obtain ⟨ψ₀, hψ₀_C, hψ₀_et⟩ := hStd.exists_etale_mvPolynomial
    let to_mv : Polynomial k →+* MvPolynomial (Fin 1) ↑A_k :=
      Polynomial.eval₂RingHom (MvPolynomial.C.comp e_k.toRingHom) (MvPolynomial.X 0)
    let from_mv : MvPolynomial (Fin 1) ↑A_k →+* Polynomial k :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp e_k.symm.toRingHom) (fun _ => Polynomial.X)
    have h_from_to : from_mv.comp to_mv = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext
      · intro c
        simp [to_mv, from_mv]
      · simp [to_mv, from_mv]
    have h_to_from : to_mv.comp from_mv = RingHom.id (MvPolynomial (Fin 1) ↑A_k) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [to_mv, from_mv]
      · intro i
        have hi0 : i = 0 := Subsingleton.elim i 0
        subst hi0
        simp [to_mv, from_mv]
    let e_poly : Polynomial k ≃+* MvPolynomial (Fin 1) ↑A_k :=
      { to_mv with
        invFun := from_mv
        left_inv := fun p => RingHom.congr_fun h_from_to p
        right_inv := fun q => RingHom.congr_fun h_to_from q }
    let ψ : Polynomial k →+* A := ψ₀.comp e_poly.toRingHom
    have hψ_et : ψ.Etale := RingHom.Etale.respectsIso.right ψ₀ e_poly hψ₀_et
    have hψ_C : ∀ c : k, ψ (Polynomial.C c) = f_V.hom c := by
      intro c
      change ψ₀ (to_mv (Polynomial.C c)) = (C.hom.appLE ⊤ V he).hom (φ_k.hom c)
      have htmv : to_mv (Polynomial.C c) = MvPolynomial.C (φ_k.hom c) := by
        simp [to_mv, e_k]
      rw [htmv]
      exact RingHom.congr_fun hψ₀_C (φ_k.hom c)
    let _ : Algebra k A := f_V.hom.toAlgebra
    let _ : Algebra (Polynomial k) A := ψ.toAlgebra
    have hTower_eq : ∀ c : k,
        algebraMap k A c = algebraMap (Polynomial k) A (algebraMap k (Polynomial k) c) :=
      fun c => (hψ_C c).symm
    have : IsScalarTower k (Polynomial k) A := IsScalarTower.of_algebraMap_eq hTower_eq
    have : Algebra.Etale (Polynomial k) A := RingHom.etale_algebraMap.mp hψ_et
    have : Algebra.FiniteType k A :=
      Algebra.FiniteType.trans
        (inferInstance : Algebra.FiniteType k (Polynomial k))
        (inferInstance : Algebra.FiniteType (Polynomial k) A)
    let p_V : ↥(AlgebraicGeometry.Spec A_obj) := hAff_V.primeIdealOf ⟨x, hxV⟩
    let m_x : Ideal A := p_V.asIdeal
    have hV_inj : Function.Injective hAff_V.fromSpec.base :=
      hAff_V.isOpenImmersion_fromSpec.base_open.injective
    have hpV_from : hAff_V.fromSpec.base p_V = x := hAff_V.fromSpec_primeIdealOf ⟨x, hxV⟩
    have hm_max : m_x.IsMaximal := by
      have hpre : ({p_V} : Set ↥(AlgebraicGeometry.Spec A_obj)) =
          hAff_V.fromSpec.base ⁻¹' ({x} : Set ↥C.left) := by
        ext q
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        exact ⟨fun hq => by rw [hq, hpV_from], fun hq => hV_inj (hq.trans hpV_from.symm)⟩
      have hCl_pV : IsClosed ({p_V} : Set ↥(AlgebraicGeometry.Spec A_obj)) := by
        rw [hpre]
        exact hx.preimage hAff_V.fromSpec.continuous
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal (p_V : PrimeSpectrum A)).mp hCl_pV
    have : m_x.IsMaximal := hm_max
    obtain ⟨n_mv, q_mv, hq_surj⟩ :=
      Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (inferInstance : Algebra.FiniteType k A)
    let M_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_mv.toRingHom m_x
    have : M_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_mv.toRingHom hq_surj
    obtain ⟨a_pt, hM_eq⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := M_mv)).mp inferInstance
    let ev : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hev_zero_iff : ∀ P : MvPolynomial (Fin n_mv) k, ev P = 0 ↔ P ∈ M_mv := by
      intro P
      rw [hM_eq, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    have h_wd : ∀ (P : MvPolynomial (Fin n_mv) k) (a : A),
        q_mv P = a → ev (Classical.choose (hq_surj a)) = ev P := by
      intro P a hPa
      have hdiff_mem : Classical.choose (hq_surj a) - P ∈ M_mv := by
        change q_mv (Classical.choose (hq_surj a) - P) ∈ m_x
        rw [map_sub, Classical.choose_spec (hq_surj a), hPa, sub_self]
        exact m_x.zero_mem
      have hsub0 : ev (Classical.choose (hq_surj a) - P) = 0 :=
        (hev_zero_iff _).mpr hdiff_mem
      rw [map_sub, sub_eq_zero] at hsub0
      exact hsub0
    let σ : A →+* k :=
      { toFun := fun a => ev (Classical.choose (hq_surj a))
        map_one' := (h_wd 1 1 (map_one q_mv)).trans (map_one ev)
        map_mul' := fun a b => by
          let Pa := Classical.choose (hq_surj a)
          let Pb := Classical.choose (hq_surj b)
          have hmul : q_mv (Pa * Pb) = a * b := by
            rw [map_mul, Classical.choose_spec (hq_surj a), Classical.choose_spec (hq_surj b)]
          exact (h_wd (Pa * Pb) (a * b) hmul).trans (map_mul ev Pa Pb)
        map_zero' := (h_wd 0 0 (map_zero q_mv)).trans (map_zero ev)
        map_add' := fun a b => by
          let Pa := Classical.choose (hq_surj a)
          let Pb := Classical.choose (hq_surj b)
          have hadd : q_mv (Pa + Pb) = a + b := by
            rw [map_add, Classical.choose_spec (hq_surj a), Classical.choose_spec (hq_surj b)]
          exact (h_wd (Pa + Pb) (a + b) hadd).trans (map_add ev Pa Pb) }
    have hσ_C : ∀ c : k, σ (f_V.hom c) = c := by
      intro c
      exact (h_wd (MvPolynomial.C c) (f_V.hom c) (q_mv.commutes c)).trans
        (MvPolynomial.aeval_C a_pt c)
    have hker_σ : RingHom.ker σ = m_x := by
      ext a
      rw [RingHom.mem_ker]
      change ev (Classical.choose (hq_surj a)) = 0 ↔ a ∈ m_x
      rw [hev_zero_iff]
      change q_mv (Classical.choose (hq_surj a)) ∈ m_x ↔ a ∈ m_x
      rw [Classical.choose_spec (hq_surj a)]
    let s₁ : S_k ⟶ C.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫ hAff_V.fromSpec
    have hs₁_hom : s₁ ≫ C.hom = 𝟙 S_k := by
      dsimp [s₁]
      rw [CategoryTheory.Category.assoc, ← hSpec_fV, ← AlgebraicGeometry.Spec.map_comp]
      have hfσ : f_V ≫ CommRingCat.ofHom σ = 𝟙 (CommRingCat.of k) := by
        ext c
        exact hσ_C c
      rw [hfσ]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of k)
    have hs₁_pt : s₁.base pt_k = x := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫ hAff_V.fromSpec).base pt_k = x
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
