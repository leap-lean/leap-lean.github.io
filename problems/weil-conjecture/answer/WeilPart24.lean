        valDiv U ((div_mor.hom.app (Opposite.op U)).hom ((η_K'.app (Opposite.op U)).hom s)) y =
          (na : ℤ) - (nb : ℤ) := by
    intro U s y O hy
    dsimp only
    intro a₀ b₀ na nb h_rat ha_ne hb_ne ha_span hb_span
    have hcomp_div : iso_K_pre.hom ≫ div_mor.hom = div_pre :=
      iso_K_pre.hom_inv_id_assoc div_pre
    have happ := congrArg (fun φ => (φ.app (Opposite.op U)).hom s) hcomp_div
    have hval_eq : valDiv U ((div_mor.hom.app (Opposite.op U)).hom
        ((((CategoryTheory.sheafificationAdjunction X_ov.left.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app (weilEtaleKPresheaf X_ov.left)).app
          (Opposite.op U)).hom s)) y = div_val U s y :=
      (congrArg (fun d => valDiv U d y) happ).trans (congrFun (hdiv_pre_spec U s) y)
    exact hval_eq.trans (hDivOrd U s y O hy a₀ b₀ na nb h_rat ha_ne hb_ne ha_span hb_span)
  refine ⟨hComp_X, hSep_X, hKSheaf, hSubGm2, hSubK1,
    Div_sh, ι_gm, div_mor, h0_div, valDiv, hSE, hι_gm_spec,
    fun U => ⟨hValInj U, hValRangeLoc U, hValRangeComp U⟩,
    fun g d y₁ => hValNat g d y₁,
    hDVR_et, hChart, hOrd_spec, ?_⟩
  intro hEx_div ι_1 s_inf hOpen_1 hι_1_ov hs_inf_ov hs_inf_disj hs_inf_cov
  let T_id := weilEtaleIdTerminal.{u} X_ov.left
  exact weil_etale_p1_canonical_divisor_degree_reduction k X_ov hStrict
    (fun x => hDVR_et T_id ⟨x.1, x.2⟩)
    Div_sh ι_gm div_mor h0_div valDiv
    (hValInj T_id) (hValRangeComp T_id hComp_X) (hOrd_spec T_id)
    hEx_div ι_1 s_inf hOpen_1 hι_1_ov hs_inf_ov hs_inf_disj hs_inf_cov

theorem weil_smooth_proj_curve_two_open_divisor_gm_divisibility (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ)
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    (hProjC : IsProjectiveOverField k C)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (m : ℕ) (hm : 1 ≤ m)
    (P_pts : Fin m → { x : ↥C.left // IsClosed ({x} : Set ↥C.left) })
    (hP_disj : _root_.Pairwise fun a b : Fin m => P_pts a ≠ P_pts b)
    (W_out W_in : C.left.Opens)
    (hAff_out : AlgebraicGeometry.IsAffineOpen W_out)
    (hW_cov : W_out ⊔ W_in = ⊤)
    (hW_in_compl : (W_in : Set ↥C.left) = (⋃ a : Fin m, ({(P_pts a).1} : Set ↥C.left))ᶜ)
    (t_pts : Fin m → ↑(C.left.presheaf.obj (Opposite.op W_out)))
    (ht_basic : ∀ a : Fin m,
      (C.left.basicOpen (t_pts a) : Set ↥C.left) = (W_out : Set ↥C.left) \ {(P_pts a).1})
    (ht_max : ∀ a : Fin m,
      ∃ hP_mem : (P_pts a).1 ∈ W_out,
        Ideal.span {(C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom (t_pts a)} =
          IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk (P_pts a).1))
    (c : Fin m → ℕ)
    (u_C : Units ↑(C.left.presheaf.obj (Opposite.op (W_out ⊓ W_in))))
    (hu_C : (C.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_out ⊓ W_in ≤ W_out)).op).hom
      (Finset.univ.prod fun a : Fin m => (t_pts a) ^ (c a)) =
      (u_C : ↑(C.left.presheaf.obj (Opposite.op (W_out ⊓ W_in)))))
    (hDiv_n : ∃ d₀ : weilCurveClGroup C.left,
      n • d₀ = QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C.left)
        (Finset.univ.sum fun a : Fin m => Finsupp.single (P_pts a) (c a : ℤ))) :
    let W₁₂ : C.left.Opens := W_out ⊓ W_in
    let V_W₁ : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W_out.ι
      (inferInstance : AlgebraicGeometry.Etale W_out.ι)
    let V_W₂ : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W_in.ι
      (inferInstance : AlgebraicGeometry.Etale W_in.ι)
    let V_W₁₂ : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
      (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
    let j₁₂_₁ : V_W₁₂ ⟶ V_W₁ :=
      CategoryTheory.MorphismProperty.Over.homMk
        (C.left.homOfLE inf_le_left) (C.left.homOfLE_ι inf_le_left)
    let shAdj_C := CategoryTheory.sheafificationAdjunction
      C.left.smallEtaleTopology AddCommGrpCat.{u}
    let Fℤ_C := (CategoryTheory.constantSheaf
      C.left.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let u₁_Fℤ := fun (V : C.left.Etale) =>
      (((shAdj_C.unit.app
        ((CategoryTheory.Functor.const (Opposite C.left.Etale)).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app
        (Opposite.op V)).hom (ULift.up (1 : ℤ)))
    let u_C_sh : ↥((weilEtaleGmSheaf C.left).obj.obj (Opposite.op V_W₁₂)) :=
      (((shAdj_C.unit.app (weilEtaleGmPresheaf C.left)).app (Opposite.op V_W₁₂)).hom
        (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u_C)))
    ∃ (K_sh Q_sh : CategoryTheory.Sheaf C.left.smallEtaleTopology AddCommGrpCat.{u})
      (ι_0 : weilEtaleGmSheaf C.left ⟶ K_sh)
      (π_0 : K_sh ⟶ Q_sh)
      (h0_0 : ι_0 ≫ π_0 = 0)
      (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact)
      (s_lift : ↥(K_sh.obj.obj (Opposite.op V_W₁)))
      (f_q : Fℤ_C ⟶ Q_sh)
      (η_C : (weilEtaleGmSheaf C.left).H 1),
      (K_sh.obj.map j₁₂_₁.op).hom s_lift =
        (ι_0.hom.app (Opposite.op V_W₁₂)).hom u_C_sh ∧
      (f_q.hom.app (Opposite.op V_W₁)).hom (u₁_Fℤ V_W₁) =
        (π_0.hom.app (Opposite.op V_W₁)).hom s_lift ∧
      (f_q.hom.app (Opposite.op V_W₂)).hom (u₁_Fℤ V_W₂) = 0 ∧
      n • η_C = (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1) :=
by
  classical
  intro W₁₂ V_W₁ V_W₂ V_W₁₂ j₁₂_₁ shAdj_C Fℤ_C u₁_Fℤ u_C_sh
  let _ := hAff_out
  let _ := hW_cov

  
  have hPropC : AlgebraicGeometry.IsProper C.hom := by
    rcases hProjC with ⟨N, ι_proj, hCl⟩
    let R := MvPolynomial (Fin (N + 1)) k
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have _ : Algebra.FiniteType ↥(𝒜 0) R := by
      refine ⟨Finset.univ.image (MvPolynomial.X : Fin (N + 1) → R), ?_⟩
      rw [eq_top_iff]
      intro p _
      induction p using MvPolynomial.induction_on with
      | C c0 =>
        have hc_eq : MvPolynomial.C c0 = algebraMap ↥(𝒜 0) R (algebraMap k ↥(𝒜 0) c0) := rfl
        rw [hc_eq]
        exact Subalgebra.algebraMap_mem _ _
      | add p₁ p₂ hp₁ hp₂ =>
        exact Subalgebra.add_mem _ (hp₁ trivial) (hp₂ trivial)
      | mul_X q j hq =>
        refine Subalgebra.mul_mem _ (hq trivial) (Algebra.subset_adjoin ?_)
        simp
    have _ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      inferInstance
    have _ : AlgebraicGeometry.IsClosedImmersion ι_proj.left := hCl
    have hbij_0 : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      constructor
      · intro c₁ c₂ hc
        apply (algebraMap k R).injective
        exact congrArg Subtype.val hc
      · rintro ⟨f, hf⟩
        have hf1 : f ∈ (1 : Submodule k R) := by
          rwa [← MvPolynomial.homogeneousSubmodule_zero (Fin (N + 1)) (R := k)]
        obtain ⟨c0, hc0⟩ := Submodule.mem_one.mp hf1
        exact ⟨c0, Subtype.ext hc0⟩
    let e0 : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hbij_0
    have he0_hom : CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) = e0.toCommRingCatIso.hom := rfl
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) := by
      rw [he0_hom]
      infer_instance
    have _ : AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      inferInstance
    have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    rw [← CategoryTheory.Over.w ι_proj]
    infer_instance
  let _ : AlgebraicGeometry.IsProper C.hom := hPropC

  
  obtain ⟨hCompC, _, _, _, _, Div_sh, ι_gm, div_mor, h0_div, valDiv,
    hSE_div, hι_gm_unit, hValProp, hValNat, hDVR_et, _, hValOrd, _⟩ :=
    (weil_etale_curve_canonical_divisor_surj_and_p1_degree k).2 C

  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  let T_C : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (CategoryTheory.CategoryStruct.id C.left)
    (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id C.left))
  have hStrict_C : ∀ x : Pt,
      StrictAnti (fun k_exp : ℕ => IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) ^ k_exp) := by
    intro x
    obtain ⟨hDom, hDVR⟩ := hDVR_et T_C ⟨x.1, x.2⟩
    let _ : IsDomain ↑(C.left.presheaf.stalk x.1) := hDom
    let _ : IsDiscreteValuationRing ↑(C.left.presheaf.stalk x.1) := hDVR
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible ↑(C.left.presheaf.stalk x.1)
    refine strictAnti_nat_of_succ_lt fun k_exp => ?_
    have hle : IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) ^ (k_exp + 1) ≤
        IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) ^ k_exp :=
      Ideal.pow_le_pow_right (Nat.le_succ k_exp)
    refine lt_of_le_of_ne hle fun heq => ?_
    have hmem : ϖ ^ k_exp ∈ IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk x.1) ^ (k_exp + 1) := by
      rw [heq, hϖ.maximalIdeal_eq, Ideal.span_singleton_pow]
      exact Ideal.subset_span rfl
    rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨r, hr⟩
    have h1 : ϖ ^ k_exp * 1 = ϖ ^ k_exp * (ϖ * r) := by
      rw [mul_one]
      calc ϖ ^ k_exp = ϖ ^ (k_exp + 1) * r := hr
        _ = ϖ ^ k_exp * (ϖ * r) := by ring
    have hunit : IsUnit ϖ := isUnit_iff_exists_inv.mpr
      ⟨r, (mul_left_cancel₀ (pow_ne_zero k_exp hϖ.ne_zero) h1).symm⟩
    exact hϖ.not_isUnit hunit

  
  let g₀ : ↑(C.left.presheaf.obj (Opposite.op W_out)) :=
    Finset.univ.prod fun a : Fin m => (t_pts a) ^ (c a)
  have hMultipoint_g₀ : ∀ a : Fin m,
      ∃ hP_mem : (P_pts a).1 ∈ W_out,
        Ideal.span {(C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom g₀} =
          IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk (P_pts a).1) ^ (c a) ∧
        (C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom g₀ ≠ 0 := by
    intro a
    obtain ⟨hP_mem, hSpan_a⟩ := ht_max a
    let R_a := ↑(C.left.presheaf.stalk (P_pts a).1)
    let m_a := IsLocalRing.maximalIdeal R_a
    let φ_a : ↑(C.left.presheaf.obj (Opposite.op W_out)) →+* R_a :=
      (C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom
    have hu_erase : ∀ b ∈ Finset.univ.erase a, IsUnit ((φ_a (t_pts b)) ^ (c b)) := by
      intro b hb
      have hba : b ≠ a := Finset.ne_of_mem_erase hb
      have hne_pt : (P_pts a).1 ≠ (P_pts b).1 :=
        fun heq => hP_disj (Ne.symm hba) (Subtype.ext heq)
      have hmem_basic : (P_pts a).1 ∈ C.left.basicOpen (t_pts b) := by
        change (P_pts a).1 ∈ (C.left.basicOpen (t_pts b) : Set ↥C.left)
        rw [ht_basic b]
        exact ⟨hP_mem, hne_pt⟩
      have hu_b : IsUnit (φ_a (t_pts b)) :=
        (AlgebraicGeometry.Scheme.mem_basicOpen C.left (t_pts b) (P_pts a).1 hP_mem).mp hmem_basic
      exact hu_b.pow (c b)
    let u_rest : R_a := ∏ b ∈ Finset.univ.erase a, (φ_a (t_pts b)) ^ (c b)
    have hu_rest : IsUnit u_rest :=
      Finset.prod_induction _ IsUnit (fun _ _ hx hy => hx.mul hy) isUnit_one hu_erase
    have hφ_g₀ : φ_a g₀ = (φ_a (t_pts a)) ^ (c a) * u_rest := by
      dsimp [g₀, u_rest]
      rw [map_prod]
      simp_rw [map_pow]
      exact (Finset.mul_prod_erase Finset.univ (fun b => (φ_a (t_pts b)) ^ (c b))
        (Finset.mem_univ a)).symm
    have hSpan_g₀ : Ideal.span ({φ_a g₀} : Set R_a) = m_a ^ (c a) := by
      rw [hφ_g₀, Ideal.span_singleton_mul_right_unit hu_rest,
        ← Ideal.span_singleton_pow, hSpan_a]
    have hne_g₀ : φ_a g₀ ≠ 0 := by
      intro h0
      have hbot : m_a ^ (c a) = ⊥ := by
        rw [← hSpan_g₀, h0, Ideal.span_singleton_zero]
      have hlt : m_a ^ (c a + 1) < m_a ^ (c a) := hStrict_C (P_pts a) (Nat.lt_succ_self (c a))
      rw [hbot] at hlt
      exact not_lt_bot hlt
    exact ⟨hP_mem, hSpan_g₀, hne_g₀⟩

  
  let _ : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  let η := genericPoint ↥C.left
  let η_X := C.left.fromSpecStalk η
  let η_gm := shAdj_C.unit.app (weilEtaleGmPresheaf C.left)
  let η_K := shAdj_C.unit.app (weilEtaleKPresheaf C.left)

  let m_pb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (f₁ : Y₁ ⟶ C.left) (f₂ : Y₂ ⟶ C.left)
      (g_hom : Y₁ ⟶ Y₂), g_hom ≫ f₂ = f₁ →
      (CategoryTheory.Limits.pullback f₁ η_X ⟶ CategoryTheory.Limits.pullback f₂ η_X) :=
    fun f₁ f₂ g_hom hg_w =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f₁ η_X ≫ g_hom)
        (CategoryTheory.Limits.pullback.snd f₁ η_X)
        (by rw [CategoryTheory.Category.assoc, hg_w]; exact CategoryTheory.Limits.pullback.condition)
  have hm_pb_eq : ∀ {U₁ U₂ : C.left.Etale} (g : U₁ ⟶ U₂),
      ((CategoryTheory.Over.pullback η_X).map
        ((AlgebraicGeometry.Scheme.Etale.forget C.left).map g)).left =
      m_pb U₁.hom U₂.hom g.left (CategoryTheory.MorphismProperty.Over.w g) :=
    fun {U₁ _} _ =>
      CategoryTheory.Over.pullback_map_left η_X
        ((AlgebraicGeometry.Scheme.Etale.forget C.left).obj U₁)
  have hK_map : ∀ {U₁ U₂ : C.left.Etale} (g : U₁ ⟶ U₂)
      (s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U₂))),
      (Additive.toMul (((weilEtaleKPresheaf C.left).map g.op).hom s) :
        Units ↑((CategoryTheory.Limits.pullback U₁.hom η_X).presheaf.obj (Opposite.op ⊤))) =
      Units.map (m_pb U₁.hom U₂.hom g.left
        (CategoryTheory.MorphismProperty.Over.w g)).appTop.hom.toMonoidHom
        (Additive.toMul s) :=
    fun g s => congrArg
      (fun θ : CategoryTheory.Limits.pullback _ η_X ⟶ CategoryTheory.Limits.pullback _ η_X =>
        Units.map θ.appTop.hom.toMonoidHom (Additive.toMul s))
      (hm_pb_eq g)

  have hOpenGenIso : ∀ (O : C.left.Opens) (x₀ : ↥C.left) (hx₀ : x₀ ∈ O)
      (f_O : O.toScheme ⟶ C.left) (_ : f_O = O.ι),
      ∃ (hη_O : η ∈ O)
        (inv_O : AlgebraicGeometry.Spec (C.left.presheaf.stalk η) ⟶
          CategoryTheory.Limits.pullback f_O η_X),
        inv_O ≫ CategoryTheory.Limits.pullback.snd f_O η_X = 𝟙 _ ∧
        CategoryTheory.Limits.pullback.snd f_O η_X ≫ inv_O = 𝟙 _ ∧
        (∀ s : ↑(C.left.presheaf.obj (Opposite.op O)),
          (inv_O.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (C.left.presheaf.stalk η)).hom).hom
            (((CategoryTheory.Limits.pullback.fst f_O η_X).appTop).hom (O.topIso.inv.hom s)) =
          (C.left.presheaf.germ O η hη_O).hom s ∧
          (C.left.presheaf.germ O η hη_O).hom s =
            algebraMap ↑(C.left.presheaf.stalk x₀) ↑C.left.functionField
              ((C.left.presheaf.germ O x₀ hx₀).hom s)) := by
    intro O x₀ hx₀ f_O hf_O
    have hη_O : η ∈ O := (genericPoint_specializes x₀).mem_open O.isOpen hx₀
    let η_O : ↥O.toScheme := ⟨η, hη_O⟩
    let g_O : AlgebraicGeometry.Spec (C.left.presheaf.stalk η) ⟶ O.toScheme :=
      AlgebraicGeometry.Spec.map (O.stalkIso ⟨η, hη_O⟩).hom ≫ O.toScheme.fromSpecStalk η_O
    have hg_O : g_O ≫ f_O = η_X := by
      rw [hf_O]
      have h_stk : AlgebraicGeometry.Spec.map (O.ι.stalkMap η_O) ≫ C.left.fromSpecStalk (O.ι.base η_O) =
          O.toScheme.fromSpecStalk η_O ≫ O.ι :=
        AlgebraicGeometry.Scheme.SpecMap_stalkMap_fromSpecStalk O.ι
      have h_inv : O.ι.stalkMap η_O = (O.stalkIso ⟨η, hη_O⟩).inv :=
        (AlgebraicGeometry.Scheme.Opens.stalkIso_inv O ⟨η, hη_O⟩).symm
      have h_spec_id : AlgebraicGeometry.Spec.map (O.stalkIso ⟨η, hη_O⟩).hom ≫
          AlgebraicGeometry.Spec.map (O.stalkIso ⟨η, hη_O⟩).inv = 𝟙 _ :=
        (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          ((congrArg AlgebraicGeometry.Spec.map (O.stalkIso ⟨η, hη_O⟩).inv_hom_id).trans
            (AlgebraicGeometry.Spec.map_id _))
      refine (CategoryTheory.Category.assoc _ _ _).trans ?_
      rw [← h_stk, h_inv]
      exact (CategoryTheory.Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ C.left.fromSpecStalk (O.ι.base η_O)) h_spec_id).trans
          (CategoryTheory.Category.id_comp _))
    have _ : CategoryTheory.Mono f_O := by rw [hf_O]; infer_instance
    let inv_O : AlgebraicGeometry.Spec (C.left.presheaf.stalk η) ⟶
        CategoryTheory.Limits.pullback f_O η_X :=
      CategoryTheory.Limits.pullback.lift g_O (𝟙 _)
        (hg_O.trans (CategoryTheory.Category.id_comp η_X).symm)
    have h1 : inv_O ≫ CategoryTheory.Limits.pullback.snd f_O η_X = 𝟙 _ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have h2 : CategoryTheory.Limits.pullback.snd f_O η_X ≫ inv_O = 𝟙 _ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.id_comp, ← CategoryTheory.cancel_mono f_O,
          CategoryTheory.Category.assoc, hg_O,
          CategoryTheory.Limits.pullback.condition]
      · rw [CategoryTheory.Category.assoc, h1, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
    have h_stalk_top : (O.toScheme.fromSpecStalk η_O).appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (O.toScheme.presheaf.stalk η_O)).hom =
        O.toScheme.presheaf.germ ⊤ η_O trivial := by
      have h_id_map : ∀ (h_le : (⊤ : (AlgebraicGeometry.Spec (O.toScheme.presheaf.stalk η_O)).Opens) ≤ ⊤),
          (AlgebraicGeometry.Spec (O.toScheme.presheaf.stalk η_O)).presheaf.map
            (CategoryTheory.homOfLE h_le).op =
          CategoryTheory.CategoryStruct.id _ := by
        intro h_le
        have h_hom : CategoryTheory.homOfLE h_le =
            CategoryTheory.CategoryStruct.id (⊤ : (AlgebraicGeometry.Spec (O.toScheme.presheaf.stalk η_O)).Opens) :=
          Subsingleton.elim _ _
        rw [h_hom, CategoryTheory.op_id, CategoryTheory.Functor.map_id]
      refine (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (O.toScheme.presheaf.stalk η_O)).hom)
