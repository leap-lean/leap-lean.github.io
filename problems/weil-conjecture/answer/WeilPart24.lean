          = CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C ≫
              hV₀.isoSpec.hom ≫ (f_D ≫ hW₀.fromSpec) := by
            simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C ≫
              (hV₀.isoSpec.hom ≫ hV₀.isoSpec.inv) ≫ (V₀.ι ≫ f) := by
            rw [← hf_eq, CategoryTheory.Category.assoc]
        _ = CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C ≫ (V₀.ι ≫ f) := by
            rw [hV₀.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp]
        _ = CategoryTheory.Limits.pullback.snd (V₀.ι ≫ f) η_C ≫ η_C :=
            CategoryTheory.Limits.pullback.condition
        _ = (CategoryTheory.Limits.pullback.snd (V₀.ι ≫ f) η_C ≫ f_K) ≫ hW₀.fromSpec := by
            rw [CategoryTheory.Category.assoc, ← hη_eq]
    let u₂ : Z_η ⟶ P_aff :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C ≫ hV₀.isoSpec.hom)
        (CategoryTheory.Limits.pullback.snd (V₀.ι ≫ f) η_C)
        hu₂_comm
    let iso_aff : P_aff ≅ Z_η :=
      { hom := u₁
        inv := u₂
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · refine (CategoryTheory.Category.assoc u₁ u₂ _).trans ?_
            refine (congrArg (u₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans ?_
            refine (CategoryTheory.Category.assoc u₁ _ _).symm.trans ?_
            refine (congrArg (· ≫ hV₀.isoSpec.hom)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans ?_
            refine (CategoryTheory.Category.assoc _ _ _).trans ?_
            refine (congrArg (CategoryTheory.Limits.pullback.fst f_D f_K ≫ ·)
              hV₀.isoSpec.inv_hom_id).trans ?_
            exact (CategoryTheory.Category.comp_id _).trans
              (CategoryTheory.Category.id_comp _).symm
          · refine (CategoryTheory.Category.assoc u₁ u₂ _).trans ?_
            refine (congrArg (u₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans ?_
            refine (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans ?_
            exact (CategoryTheory.Category.id_comp _).symm
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · refine (CategoryTheory.Category.assoc u₂ u₁ _).trans ?_
            refine (congrArg (u₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans ?_
            refine (CategoryTheory.Category.assoc u₂ _ _).symm.trans ?_
            refine (congrArg (· ≫ hV₀.isoSpec.inv)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans ?_
            rw [CategoryTheory.Category.assoc, hV₀.isoSpec.hom_inv_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          · refine (CategoryTheory.Category.assoc u₂ u₁ _).trans ?_
            refine (congrArg (u₂ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans ?_
            refine (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans ?_
            exact (CategoryTheory.Category.id_comp _).symm }
    let T := TensorProduct A₀ D K
    let Ψ : AlgebraicGeometry.Spec (CommRingCat.of T) ≅ Z_η :=
      (AlgebraicGeometry.pullbackSpecIso A₀ D K).symm ≪≫ iso_aff
    have hΨ_fst : Ψ.hom ≫ CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
          hV₀.isoSpec.inv := by
      dsimp [Ψ, iso_aff]
      refine (CategoryTheory.Category.assoc _ u₁ _).trans ?_
      refine (congrArg ((AlgebraicGeometry.pullbackSpecIso A₀ D K).inv ≫ ·)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans ?_
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst]
    let iso_ring : Z_η.presheaf.obj (Opposite.op ⊤) ≅ CommRingCat.of T :=
      { hom := Ψ.hom.appTop
        inv := Ψ.inv.appTop
        hom_inv_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Ψ.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Ψ.hom_inv_id,
