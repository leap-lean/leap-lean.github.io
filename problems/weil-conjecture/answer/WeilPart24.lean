                    ((algebraMap A₀ (Localization.Away (f₀ r))).comp ψ₀))) := by
                rw [hSpecComp, hSpecComp]
          _ = hL ≫ (e₀ r).inv ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  ((φ_tilde₀ r).comp ((π₀ r).comp p₀))) := by
                rw [← hφ₀_alg r]
          _ = hL ≫ (e₀ r).inv ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde₀ r)) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π₀ r)) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀))) := by
                rw [← hSpecComp, ← hSpecComp]
          _ = ξ₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) := by
                simp only [ξ₀, g_r, Category.assoc]
          _ = (m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) := by
                rw [hm_tilde₀]
          _ = m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₀.comp p₀)) := by
                rw [Category.assoc, hSpecComp]
          _ = m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p₀₁.comp ιB₀)) := by
                rw [hp₀_comm]
          _ = (m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀₁)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιB₀) := by
                rw [← hSpecComp, ← Category.assoc]
      · calc
          (m₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιB₁)
              = m₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀₁.comp ιB₁)) := by
                rw [Category.assoc, hSpecComp]
          _ = m₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ιA₁.comp ψ₁)) := by
                rw [hψ₁]
          _ = (m₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιA₁)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) := by
                rw [← hSpecComp, ← Category.assoc]
          _ = g₁_A ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) := by
                rw [hm₀₁_₁]
          _ = hR ≫ (e₁ s).inv ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away (f₁ s)) _)) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ (Localization.Away (f₁ s)))) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁))) := by
                simp only [g₁_A, m₁_P, Category.assoc]
          _ = hR ≫ (e₁ s).inv ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  ((algebraMap (Localization.Away (f₁ s)) _).comp
                    ((algebraMap A₁ (Localization.Away (f₁ s))).comp ψ₁))) := by
                rw [hSpecComp, hSpecComp]
          _ = hR ≫ (e₁ s).inv ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  ((φ_tilde₁ s).comp ((π₁ s).comp p₁))) := by
                rw [← hφ₁_alg s]
          _ = hR ≫ (e₁ s).inv ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde₁ s)) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π₁ s)) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁))) := by
                rw [← hSpecComp, ← hSpecComp]
          _ = ξ₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) := by
                simp only [ξ₁, g_s, Category.assoc]
          _ = (m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) := by
                rw [hm_tilde₁]
          _ = m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.comp p₁)) := by
                rw [Category.assoc, hSpecComp]
          _ = m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p₀₁.comp ιB₁)) := by
                rw [hp₁_comm]
          _ = (m_tilde₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀₁)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιB₁) := by
                rw [← hSpecComp, ← Category.assoc]
    refine ⟨m₀₁, hm₀₁_₀, hm₀₁_₁, ?_⟩
    let α_r := secOpen W _ g_r
    let α_s := secOpen W _ g_s
    let χ₀₁ := secOpen W R_tilde₀₁ m_tilde₀₁
    have hα_r : α_r.comp (π₀ r) = χ₀₁.comp φ₀ := by
      rw [← secOpen_comp_Spec W g_r (π₀ r), ← secOpen_comp_Spec W m_tilde₀₁ φ₀]
      exact congrArg (secOpen W R_tilde₀) hm_tilde₀.symm
    have hα_s : α_s.comp (π₁ s) = χ₀₁.comp φ₁ := by
      rw [← secOpen_comp_Spec W g_s (π₁ s), ← secOpen_comp_Spec W m_tilde₀₁ φ₁]
      exact congrArg (secOpen W R_tilde₁) hm_tilde₁.symm
    have hRel := hRoot01 r s ↑(P_raw.presheaf.obj (Opposite.op W)) α_r α_s χ₀₁ hα_r hα_s
    have hχ_p₀₁ : χ₀₁.comp p₀₁ = (secOpen W A₀₁ m₀₁).comp ψ₀₁ := by
      rw [← secOpen_comp_Spec W m_tilde₀₁ p₀₁, ← secOpen_comp_Spec W m₀₁ ψ₀₁]
      exact congrArg (secOpen W R₀₁_B) hm_compat.symm
    have hc1 : χ₀₁ (p₀₁ ((ιB₀ (f₀_B r) * ιB₁ (f₁_B s)) ^ e)) =
        secOpen W A₀₁ m₀₁ ((ιA₀ (f₀ r) * ιA₁ (f₁ s)) ^ e) := by
      have hc := RingHom.congr_fun hχ_p₀₁ ((ιB₀ (f₀_B r) * ιB₁ (f₁_B s)) ^ e)
      have h0 : ψ₀₁ (ιB₀ (f₀_B r)) = ιA₀ (f₀ r) := by
        calc
          ψ₀₁ (ιB₀ (f₀_B r)) = (ψ₀₁.comp ιB₀) (f₀_B r) := rfl
          _ = (ιA₀.comp ψ₀) (f₀_B r) := by rw [hψ₀]
          _ = ιA₀ (f₀ r) := by dsimp only [RingHom.comp_apply]; rw [hf₀ r]
      have h1 : ψ₀₁ (ιB₁ (f₁_B s)) = ιA₁ (f₁ s) := by
        calc
          ψ₀₁ (ιB₁ (f₁_B s)) = (ψ₀₁.comp ιB₁) (f₁_B s) := rfl
          _ = (ιA₁.comp ψ₁) (f₁_B s) := by rw [hψ₁]
          _ = ιA₁ (f₁ s) := by dsimp only [RingHom.comp_apply]; rw [hf₁ s]
      have hψ : ψ₀₁ ((ιB₀ (f₀_B r) * ιB₁ (f₁_B s)) ^ e) = (ιA₀ (f₀ r) * ιA₁ (f₁ s)) ^ e := by
        rw [map_pow, map_mul, h0, h1]
      dsimp only [RingHom.comp_apply] at hc
      rw [hc, hψ]
    have hc2 : χ₀₁ (p₀₁ (G₀₁_B r s)) = secOpen W A₀₁ m₀₁ (G₀₁ r s) := by
      have hc := RingHom.congr_fun hχ_p₀₁ (G₀₁_B r s)
      dsimp only [RingHom.comp_apply] at hc
      rw [hc, hG₀₁ r s]
    have hroot_r : α_r (AdjoinRoot.root _) =
        (P_raw.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O₀ r ⊓ O₁ s ≤ O₀ r)).op).hom
          (z₀ r).1 := by
      have hg : g_r = (hL ≫ (e₀ r).inv) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde₀ r)) := by
        simp only [g_r, Category.assoc]
      change secOpen W _ g_r (AdjoinRoot.root _) = _
      rw [hg, secOpen_comp_Spec, RingHom.comp_apply, hφ_root₀ r,
        secOpen_homOfLE (inf_le_left : O₀ r ⊓ O₁ s ≤ O₀ r), RingHom.comp_apply, ← hz₀ r]
    have hroot_s : α_s (AdjoinRoot.root _) =
        (P_raw.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O₀ r ⊓ O₁ s ≤ O₁ s)).op).hom
          (z₁ s).1 := by
      have hg : g_s = (hR ≫ (e₁ s).inv) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde₁ s)) := by
        simp only [g_s, Category.assoc]
      change secOpen W _ g_s (AdjoinRoot.root _) = _
      rw [hg, secOpen_comp_Spec, RingHom.comp_apply, hφ_root₁ s,
        secOpen_homOfLE (inf_le_right : O₀ r ⊓ O₁ s ≤ O₁ s), RingHom.comp_apply, ← hz₁ s]
    rw [hc1, hc2, hroot_r, hroot_s] at hRel
    exact hRel

theorem weil_twoChart_cyclic_cover_gluing_and_baseChange_coboundary (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (R₁ : Type u) [CommRing R₁] [Algebra k R₁]
    (B₀ : Type u) [CommRing B₀] [Algebra k B₀] [Algebra R₁ B₀] [IsScalarTower k R₁ B₀]
    (M₀ M₁ M₀₁ : Type u)
    [CommRing M₀] [Algebra R₁ M₀]
    [CommRing M₁] [Algebra R₁ M₁]
    [CommRing M₀₁] [Algebra R₁ M₀₁]
    (t₀ : M₀) (t₁ : M₁)
    (ρ₀ : M₀ →ₐ[R₁] M₀₁) (ρ₁ : M₁ →ₐ[R₁] M₀₁)
    (hLoc₀ : @IsLocalization.Away M₀ _ t₀ M₀₁ _ ρ₀.toRingHom.toAlgebra)
    (hLoc₁ : @IsLocalization.Away M₁ _ t₁ M₀₁ _ ρ₁.toRingHom.toAlgebra)
    (ht₀₁ : ρ₀ t₀ * ρ₁ t₁ = 1)
    (Y_B₀ : AlgebraicGeometry.Scheme.{u})
    (f_B₀ : Quiver.Hom Y_B₀ (AlgebraicGeometry.Spec (CommRingCat.of B₀)))
    (j₀_B : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ B₀ M₀))) Y_B₀)
    (j₁_B : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ B₀ M₁))) Y_B₀)
    [AlgebraicGeometry.IsOpenImmersion j₀_B]
    [AlgebraicGeometry.IsOpenImmersion j₁_B]
    (hCov_B : Set.range j₀_B.base ∪ Set.range j₁_B.base = Set.univ)
    (hPb_B : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.map (AlgHom.id R₁ B₀) ρ₀).toRingHom))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.map (AlgHom.id R₁ B₀) ρ₁).toRingHom))
      j₀_B j₁_B)
    (m₀ m₁ d_u e T_ann : ℕ) (hm₀ : 1 ≤ m₀) (hm₁ : 1 ≤ m₁)
    (f₀_B q₀_B U₀_B V₀_B : Fin m₀ → TensorProduct R₁ B₀ M₀)
    (G₀₀_B G'₀₀_B : Fin m₀ → Fin m₀ → TensorProduct R₁ B₀ M₀)
    (f₁_B q₁_B U₁_B V₁_B : Fin m₁ → TensorProduct R₁ B₀ M₁)
    (G₁₁_B G'₁₁_B : Fin m₁ → Fin m₁ → TensorProduct R₁ B₀ M₁)
    (G₀₁_B G'₀₁_B : Fin m₀ → Fin m₁ → TensorProduct R₁ B₀ M₀₁)
    (hEqsB :
      let ιB₀ := (Algebra.TensorProduct.map (AlgHom.id R₁ B₀) ρ₀).toRingHom
      let ιB₁ := (Algebra.TensorProduct.map (AlgHom.id R₁ B₀) ρ₁).toRingHom
      (∑ r : Fin m₀, q₀_B r * f₀_B r) = 1 ∧
      (∑ s : Fin m₁, q₁_B s * f₁_B s) = 1 ∧
      (∀ r : Fin m₀, U₀_B r * V₀_B r = (f₀_B r) ^ d_u) ∧
      (∀ s : Fin m₁, U₁_B s * V₁_B s = (f₁_B s) ^ d_u) ∧
      (∀ r : Fin m₀, G₀₀_B r r = (f₀_B r * f₀_B r) ^ e) ∧
      (∀ s : Fin m₁, G₁₁_B s s = (f₁_B s * f₁_B s) ^ e) ∧
      (∀ r r' : Fin m₀, G₀₀_B r r' * G'₀₀_B r r' = (f₀_B r * f₀_B r') ^ (2 * e)) ∧
      (∀ s s' : Fin m₁, G₁₁_B s s' * G'₁₁_B s s' = (f₁_B s * f₁_B s') ^ (2 * e)) ∧
      (∀ (r : Fin m₀) (s : Fin m₁),
        G₀₁_B r s * G'₀₁_B r s = (ιB₀ (f₀_B r) * ιB₁ (f₁_B s)) ^ (2 * e)) ∧
      (∀ r r' : Fin m₀, (G₀₀_B r r') ^ ℓ * U₀_B r' = (f₀_B r * f₀_B r') ^ (ℓ * e) * U₀_B r) ∧
      (∀ s s' : Fin m₁, (G₁₁_B s s') ^ ℓ * U₁_B s' = (f₁_B s * f₁_B s') ^ (ℓ * e) * U₁_B s) ∧
      (∀ (r : Fin m₀) (s : Fin m₁),
        (G₀₁_B r s) ^ ℓ * ιB₁ (U₁_B s) =
          (ιB₀ (f₀_B r) * ιB₁ (f₁_B s)) ^ (ℓ * e) * ιB₀ (U₀_B r)) ∧
      (∀ r₁ r₂ r₃ : Fin m₀,
        (f₀_B r₁ * f₀_B r₂ * f₀_B r₃) ^ T_ann *
          (G₀₀_B r₁ r₂ * G₀₀_B r₂ r₃ - (f₀_B r₂) ^ (2 * e) * G₀₀_B r₁ r₃) = 0) ∧
      (∀ s₁ s₂ s₃ : Fin m₁,
        (f₁_B s₁ * f₁_B s₂ * f₁_B s₃) ^ T_ann *
          (G₁₁_B s₁ s₂ * G₁₁_B s₂ s₃ - (f₁_B s₂) ^ (2 * e) * G₁₁_B s₁ s₃) = 0) ∧
      (∀ (r₁ r₂ : Fin m₀) (s₃ : Fin m₁),
        (ιB₀ (f₀_B r₁) * ιB₀ (f₀_B r₂) * ιB₁ (f₁_B s₃)) ^ T_ann *
          (ιB₀ (G₀₀_B r₁ r₂) * G₀₁_B r₂ s₃ -
            (ιB₀ (f₀_B r₂)) ^ (2 * e) * G₀₁_B r₁ s₃) = 0) ∧
      (∀ (r₁ : Fin m₀) (s₂ s₃ : Fin m₁),
        (ιB₀ (f₀_B r₁) * ιB₁ (f₁_B s₂) * ιB₁ (f₁_B s₃)) ^ T_ann *
          (G₀₁_B r₁ s₂ * ιB₁ (G₁₁_B s₂ s₃) -
            (ιB₁ (f₁_B s₂)) ^ (2 * e) * G₀₁_B r₁ s₃) = 0)) :
    ∃ (Y_raw : AlgebraicGeometry.Scheme.{u})
      (ν_B₀ : Quiver.Hom Y_raw Y_B₀),
      AlgebraicGeometry.IsFinite ν_B₀ ∧
      AlgebraicGeometry.Etale ν_B₀ ∧
      AlgebraicGeometry.Surjective ν_B₀ ∧
      (∀ (S' : Type u) [CommRing S'] [Algebra R₁ S']
         (τ' : B₀ →ₐ[R₁] S')
         (C' : AlgebraicGeometry.Scheme.{u})
         (i_C' : Quiver.Hom C' Y_B₀)
         (f_C' : Quiver.Hom C' (AlgebraicGeometry.Spec (CommRingCat.of S'))),
         CategoryTheory.IsPullback i_C' f_C' f_B₀
           (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ'.toRingHom)) →
         ∀ (j₀_C' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ S' M₀))) C')
           (j₁_C' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ S' M₁))) C')
           [AlgebraicGeometry.IsOpenImmersion j₀_C']
           [AlgebraicGeometry.IsOpenImmersion j₁_C'],
           CategoryTheory.IsPullback j₀_C'
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
               (Algebra.TensorProduct.map τ' (AlgHom.id R₁ M₀)).toRingHom))
             i_C' j₀_B →
           CategoryTheory.IsPullback j₁_C'
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
               (Algebra.TensorProduct.map τ' (AlgHom.id R₁ M₁)).toRingHom))
             i_C' j₁_B →
           let F₀ := CategoryTheory.Limits.pullback
             (CategoryTheory.CategoryStruct.comp ν_B₀ f_B₀)
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ'.toRingHom))
           let f_bar₀ : Fin m₀ → TensorProduct R₁ S' M₀ :=
             fun r => Algebra.TensorProduct.map τ' (AlgHom.id R₁ M₀) (f₀_B r)
           let U_bar₀ : Fin m₀ → TensorProduct R₁ S' M₀ :=
             fun r => Algebra.TensorProduct.map τ' (AlgHom.id R₁ M₀) (U₀_B r)
           let f_bar₁ : Fin m₁ → TensorProduct R₁ S' M₁ :=
             fun s => Algebra.TensorProduct.map τ' (AlgHom.id R₁ M₁) (f₁_B s)
           let U_bar₁ : Fin m₁ → TensorProduct R₁ S' M₁ :=
             fun s => Algebra.TensorProduct.map τ' (AlgHom.id R₁ M₁) (U₁_B s)
           ∃ (ν₀ : Quiver.Hom F₀ C')
             (ι_tilde₀ : ∀ r : Fin m₀, Quiver.Hom
               (AlgebraicGeometry.Spec (CommRingCat.of
                 (AdjoinRoot
                   ((Polynomial.X : Polynomial (Localization.Away (f_bar₀ r))) ^ ℓ -
                     Polynomial.C
                       (algebraMap (TensorProduct R₁ S' M₀) (Localization.Away (f_bar₀ r))
                         (U_bar₀ r)))))) F₀)
             (ι_tilde₁ : ∀ s : Fin m₁, Quiver.Hom
               (AlgebraicGeometry.Spec (CommRingCat.of
                 (AdjoinRoot
                   ((Polynomial.X : Polynomial (Localization.Away (f_bar₁ s))) ^ ℓ -
                     Polynomial.C
                       (algebraMap (TensorProduct R₁ S' M₁) (Localization.Away (f_bar₁ s))
                         (U_bar₁ s)))))) F₀),
             AlgebraicGeometry.Surjective ν₀ ∧
             (∀ r : Fin m₀, AlgebraicGeometry.IsOpenImmersion (ι_tilde₀ r)) ∧
             (∀ s : Fin m₁, AlgebraicGeometry.IsOpenImmersion (ι_tilde₁ s)) ∧
             (∀ r : Fin m₀,
               Set.range (ι_tilde₀ r).base =
                 ν₀.base ⁻¹'
                   (j₀_C'.base '' (PrimeSpectrum.basicOpen (f_bar₀ r) :
                     Set (PrimeSpectrum (TensorProduct R₁ S' M₀))))) ∧
             (∀ s : Fin m₁,
               Set.range (ι_tilde₁ s).base =
                 ν₀.base ⁻¹'
                   (j₁_C'.base '' (PrimeSpectrum.basicOpen (f_bar₁ s) :
                     Set (PrimeSpectrum (TensorProduct R₁ S' M₁)))))) ∧
      (∀ (A : Type u) [CommRing A] [Algebra R₁ A]
         (ψ : B₀ →ₐ[R₁] A)
         (Y_A : AlgebraicGeometry.Scheme.{u})
         (p_YA_B₀ : Quiver.Hom Y_A Y_B₀)
         (f_YA : Quiver.Hom Y_A (AlgebraicGeometry.Spec (CommRingCat.of A))),
         CategoryTheory.IsPullback p_YA_B₀ f_YA f_B₀
           (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)) →
         ∀ (j₀_A : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ A M₀))) Y_A)
           (j₁_A : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ A M₁))) Y_A)
           [AlgebraicGeometry.IsOpenImmersion j₀_A]
           [AlgebraicGeometry.IsOpenImmersion j₁_A],
           Set.range j₀_A.base ∪ Set.range j₁_A.base = Set.univ →
           CategoryTheory.IsPullback
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
               (Algebra.TensorProduct.map (AlgHom.id R₁ A) ρ₀).toRingHom))
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
               (Algebra.TensorProduct.map (AlgHom.id R₁ A) ρ₁).toRingHom))
             j₀_A j₁_A →
           CategoryTheory.IsPullback j₀_A
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
               (Algebra.TensorProduct.map ψ (AlgHom.id R₁ M₀)).toRingHom))
             p_YA_B₀ j₀_B →
           CategoryTheory.IsPullback j₁_A
             (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
               (Algebra.TensorProduct.map ψ (AlgHom.id R₁ M₁)).toRingHom))
             p_YA_B₀ j₁_B →
           let A₀ := TensorProduct R₁ A M₀
           let A₁ := TensorProduct R₁ A M₁
           let A₀₁ := TensorProduct R₁ A M₀₁
           let ιA₀ := (Algebra.TensorProduct.map (AlgHom.id R₁ A) ρ₀).toRingHom
           let ιA₁ := (Algebra.TensorProduct.map (AlgHom.id R₁ A) ρ₁).toRingHom
           ∀ (f₀ : Fin m₀ → A₀) (G₀₀ : Fin m₀ → Fin m₀ → A₀)
             (f₁ : Fin m₁ → A₁) (G₁₁ : Fin m₁ → Fin m₁ → A₁)
             (G₀₁ : Fin m₀ → Fin m₁ → A₀₁),
             (∀ r : Fin m₀, Algebra.TensorProduct.map ψ (AlgHom.id R₁ M₀) (f₀_B r) = f₀ r) →
             (∀ r r' : Fin m₀, Algebra.TensorProduct.map ψ (AlgHom.id R₁ M₀) (G₀₀_B r r') = G₀₀ r r') →
             (∀ s : Fin m₁, Algebra.TensorProduct.map ψ (AlgHom.id R₁ M₁) (f₁_B s) = f₁ s) →
