      (CategoryTheory.CategoryStruct.comp E.e_W₁.hom E.W₁_open.ι) =
      CategoryTheory.CategoryStruct.comp e_W_next.hom
        (CategoryTheory.CategoryStruct.comp W_next_open.ι π_Y₁_next) := by
    calc
      (Fgt_Y.map u_W_next).left ≫ (E.e_W₁.hom ≫ E.W₁_open.ι)
        = (Fgt_Y.map h_W).left ≫ ((Fgt_Y.map P_cur.u_W).left ≫ (E.e_W₁.hom ≫ E.W₁_open.ι)) := by
          change ((Fgt_Y.map h_W).left ≫ (Fgt_Y.map P_cur.u_W).left) ≫
            (E.e_W₁.hom ≫ E.W₁_open.ι) = _
          rw [CategoryTheory.Category.assoc]
      _ = (Fgt_Y.map h_W).left ≫ (P_cur.e_W.hom ≫ (P_cur.W_open.ι ≫ P_cur.π_Y₁)) := by
          rw [P_cur.hu_W_comp]
      _ = ((Fgt_Y.map h_W).left ≫ (P_cur.e_W.hom ≫ P_cur.W_open.ι)) ≫ P_cur.π_Y₁ := by
          simp only [CategoryTheory.Category.assoc]
      _ = (e_W_next.hom ≫ (W_next_open.ι ≫ h_Y)) ≫ P_cur.π_Y₁ := by
          rw [hhW_comp]
      _ = e_W_next.hom ≫ (W_next_open.ι ≫ π_Y₁_next) := by
          dsimp [π_Y₁_next]; simp only [CategoryTheory.Category.assoc]

  let f_W_cur : (Fgt_Y.obj P_cur.W).left ⟶ V_cur :=
    CategoryTheory.CategoryStruct.comp P_cur.e_W.hom
      (CategoryTheory.CategoryStruct.comp P_cur.W_open.ι P_cur.f_bar)
  let f_W_next : (Fgt_Y.obj W_next).left ⟶ V_next_sch :=
    CategoryTheory.CategoryStruct.comp e_W_next.hom
      (CategoryTheory.CategoryStruct.comp W_next_open.ι f_next)

  have hComm_W_step : CategoryTheory.CategoryStruct.comp ((Fgt_Y.map h_W).left) f_W_cur =
      CategoryTheory.CategoryStruct.comp f_W_next h_V_sch := by
    change ((h_Y ∣_ P_cur.W_open) ≫ P_cur.e_W.inv) ≫
        (P_cur.e_W.hom ≫ (P_cur.W_open.ι ≫ P_cur.f_bar)) =
      (𝟙 W_next_open.toScheme ≫ (W_next_open.ι ≫ f_next)) ≫ h_V_sch
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc P_cur.e_W.inv, P_cur.e_W.inv_hom_id,
      CategoryTheory.Category.id_comp]
    exact hComm_W_open

  let e_pb_W : CategoryTheory.Limits.pullback (P_cur.W_open.ι ≫ P_cur.f_bar) h_V_sch ≅
      CategoryTheory.Limits.pullback f_W_cur h_V_sch :=
    { hom := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (P_cur.W_open.ι ≫ P_cur.f_bar) h_V_sch ≫ P_cur.e_W.inv)
        (CategoryTheory.Limits.pullback.snd (P_cur.W_open.ι ≫ P_cur.f_bar) h_V_sch)
        (by
          dsimp [f_W_cur]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc P_cur.e_W.inv,
            P_cur.e_W.inv_hom_id, CategoryTheory.Category.id_comp]
          exact CategoryTheory.Limits.pullback.condition)
      inv := CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f_W_cur h_V_sch ≫ P_cur.e_W.hom)
        (CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch)
        (by
          rw [CategoryTheory.Category.assoc]
          exact CategoryTheory.Limits.pullback.condition)
      hom_inv_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Category.assoc,
            P_cur.e_W.inv_hom_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Category.assoc,
            P_cur.e_W.hom_inv_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp] }

  obtain ⟨m_epb, hm_epb_fst, hm_epb_snd, hIso_epb⟩ :
      ∃ m : CategoryTheory.Limits.pullback (P_cur.W_open.ι ≫ P_cur.f_bar) h_V_sch ⟶
          CategoryTheory.Limits.pullback f_W_cur h_V_sch,
        m ≫ CategoryTheory.Limits.pullback.fst f_W_cur h_V_sch =
          CategoryTheory.Limits.pullback.fst (P_cur.W_open.ι ≫ P_cur.f_bar) h_V_sch ≫ P_cur.e_W.inv ∧
        m ≫ CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch =
          CategoryTheory.Limits.pullback.snd (P_cur.W_open.ι ≫ P_cur.f_bar) h_V_sch ∧
        CategoryTheory.IsIso m :=
    ⟨e_pb_W.hom,
      CategoryTheory.Limits.pullback.lift_fst _ _ _,
      CategoryTheory.Limits.pullback.lift_snd _ _ _,
      ⟨⟨e_pb_W.inv, e_pb_W.hom_inv_id, e_pb_W.inv_hom_id⟩⟩⟩
  have : CategoryTheory.IsIso m_epb := hIso_epb

  let φ_Wopen_step : W_next_open.toScheme ⟶
      CategoryTheory.Limits.pullback (P_cur.W_open.ι ≫ P_cur.f_bar) h_V_sch :=
    CategoryTheory.Limits.pullback.lift (h_Y ∣_ P_cur.W_open)
      (CategoryTheory.CategoryStruct.comp W_next_open.ι f_next) hComm_W_open
  let φ_W_step : (Fgt_Y.obj W_next).left ⟶ CategoryTheory.Limits.pullback f_W_cur h_V_sch :=
    CategoryTheory.Limits.pullback.lift ((Fgt_Y.map h_W).left) f_W_next hComm_W_step
  have hφ_W_fac : φ_W_step = e_W_next.hom ≫ (φ_Wopen_step ≫ m_epb) := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hm_epb_fst,
        ← CategoryTheory.Category.assoc φ_Wopen_step, CategoryTheory.Limits.pullback.lift_fst]
      exact (CategoryTheory.Category.id_comp h_W_sch).symm
    · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hm_epb_snd,
        CategoryTheory.Limits.pullback.lift_snd]
  have : AlgebraicGeometry.IsFinite φ_Wopen_step := hFin_Wopen_step
  have : AlgebraicGeometry.Etale φ_Wopen_step := hEt_Wopen_step
  have : AlgebraicGeometry.Surjective φ_Wopen_step := hSurj_Wopen_step
  have : AlgebraicGeometry.IsFinite e_W_next.hom :=
    AlgebraicGeometry.IsFinite.instOfIsIsoScheme e_W_next.hom
  have : AlgebraicGeometry.Etale e_W_next.hom :=
    AlgebraicGeometry.Etale.instOfIsOpenImmersion e_W_next.hom
  have : AlgebraicGeometry.Surjective e_W_next.hom :=
    AlgebraicGeometry.instSurjectiveOfIsIsoScheme e_W_next.hom
  have : AlgebraicGeometry.IsFinite m_epb :=
    AlgebraicGeometry.IsFinite.instOfIsIsoScheme m_epb
  have : AlgebraicGeometry.Etale m_epb :=
    AlgebraicGeometry.Etale.instOfIsOpenImmersion m_epb
  have : AlgebraicGeometry.Surjective m_epb :=
    AlgebraicGeometry.instSurjectiveOfIsIsoScheme m_epb
  have : AlgebraicGeometry.IsFinite (φ_Wopen_step ≫ m_epb) := inferInstance
  have : AlgebraicGeometry.Etale (φ_Wopen_step ≫ m_epb) := inferInstance
  have : AlgebraicGeometry.Surjective (φ_Wopen_step ≫ m_epb) := inferInstance
  have hFin_W_step : AlgebraicGeometry.IsFinite φ_W_step := by
    rw [hφ_W_fac]
    exact show AlgebraicGeometry.IsFinite (e_W_next.hom ≫ (φ_Wopen_step ≫ m_epb)) from
      inferInstance
  have hEt_W_step : AlgebraicGeometry.Etale φ_W_step := by
    rw [hφ_W_fac]
    exact show AlgebraicGeometry.Etale (e_W_next.hom ≫ (φ_Wopen_step ≫ m_epb)) from
      inferInstance
  have hSurj_W_step : AlgebraicGeometry.Surjective φ_W_step := by
    rw [hφ_W_fac]
    exact show AlgebraicGeometry.Surjective (e_W_next.hom ≫ (φ_Wopen_step ≫ m_epb)) from
      inferInstance

  have hComm_W_next : CategoryTheory.CategoryStruct.comp
      ((Fgt_Y.map u_W_next).left)
      (CategoryTheory.CategoryStruct.comp E.e_W₁.hom
        (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁)) =
      CategoryTheory.CategoryStruct.comp f_W_next (Fgt_V.map g_V_next).left := by
    change ((Fgt_Y.map h_W).left ≫ (Fgt_Y.map P_cur.u_W).left) ≫
        (E.e_W₁.hom ≫ (E.W₁_open.ι ≫ E.f_bar₁)) =
      f_W_next ≫ (h_V_sch ≫ (Fgt_V.map P_cur.g_V).left)
    rw [CategoryTheory.Category.assoc, P_cur.hComm_W, ← CategoryTheory.Category.assoc,
      hComm_W_step, CategoryTheory.Category.assoc]

  have hFin_W_rel_next : AlgebraicGeometry.IsFinite
      (CategoryTheory.Limits.pullback.lift ((Fgt_Y.map u_W_next).left) f_W_next hComm_W_next) :=
    (hRelComp f_W_next f_W_cur (E.e_W₁.hom ≫ (E.W₁_open.ι ≫ E.f_bar₁))
      (Fgt_Y.map h_W).left (Fgt_Y.map P_cur.u_W).left
      h_V_sch (Fgt_V.map P_cur.g_V).left hComm_W_step P_cur.hComm_W hComm_W_next).1
      hFin_W_step P_cur.hFin_W_rel
  have hEt_W_rel_next : AlgebraicGeometry.Etale
      (CategoryTheory.Limits.pullback.lift ((Fgt_Y.map u_W_next).left) f_W_next hComm_W_next) :=
    (hRelComp f_W_next f_W_cur (E.e_W₁.hom ≫ (E.W₁_open.ι ≫ E.f_bar₁))
      (Fgt_Y.map h_W).left (Fgt_Y.map P_cur.u_W).left
      h_V_sch (Fgt_V.map P_cur.g_V).left hComm_W_step P_cur.hComm_W hComm_W_next).2.1
      hEt_W_step P_cur.hEt_W_rel
  have hSurj_W_rel_next : AlgebraicGeometry.Surjective
      (CategoryTheory.Limits.pullback.lift ((Fgt_Y.map u_W_next).left) f_W_next hComm_W_next) :=
    (hRelComp f_W_next f_W_cur (E.e_W₁.hom ≫ (E.W₁_open.ι ≫ E.f_bar₁))
      (Fgt_Y.map h_W).left (Fgt_Y.map P_cur.u_W).left
      h_V_sch (Fgt_V.map P_cur.g_V).left hComm_W_step P_cur.hComm_W hComm_W_next).2.2
      hSurj_W_step P_cur.hSurj_W_rel

  
  let p_W_cur : (Fgt_Y.obj P_cur.W).left ⟶ S_k := (Fgt_Y.obj P_cur.W).hom ≫ E.Y_bar.hom
  let p_W_next : (Fgt_Y.obj W_next).left ⟶ S_k := (Fgt_Y.obj W_next).hom ≫ E.Y_bar.hom
  have : AlgebraicGeometry.LocallyOfFiniteType p_W_cur := by dsimp [p_W_cur]; infer_instance
  have : AlgebraicGeometry.LocallyOfFiniteType p_W_next := by dsimp [p_W_next]; infer_instance

  have hf_W_cur_k : f_W_cur ≫ p_V_cur = p_W_cur := by
    have hgV_w : (Fgt_V.map P_cur.g_V).left ≫ (Fgt_V.obj E.V₁).hom = (Fgt_V.obj P_cur.V).hom :=
      CategoryTheory.MorphismProperty.Over.w P_cur.g_V
    have hπ_w : E.π_bar.left ≫ E.V_bar.hom = E.Y_bar.hom := CategoryTheory.Over.w E.π_bar
    calc
      (P_cur.e_W.hom ≫ (P_cur.W_open.ι ≫ P_cur.f_bar)) ≫ ((Fgt_V.obj P_cur.V).hom ≫ E.V_bar.hom)
        = P_cur.e_W.hom ≫ P_cur.W_open.ι ≫
            ((P_cur.f_bar ≫ (Fgt_V.map P_cur.g_V).left) ≫ (Fgt_V.obj E.V₁).hom) ≫ E.V_bar.hom := by
            rw [← hgV_w]; simp only [CategoryTheory.Category.assoc]
      _ = P_cur.e_W.hom ≫ P_cur.W_open.ι ≫
            ((P_cur.π_Y₁ ≫ E.f_bar₁) ≫ (Fgt_V.obj E.V₁).hom) ≫ E.V_bar.hom := by
            rw [← P_cur.hComm_Y₁]
      _ = P_cur.e_W.hom ≫ P_cur.W_open.ι ≫ P_cur.π_Y₁ ≫
            (E.f_bar₁ ≫ (Fgt_V.obj E.V₁).hom) ≫ E.V_bar.hom := by
            simp only [CategoryTheory.Category.assoc]
      _ = P_cur.e_W.hom ≫ P_cur.W_open.ι ≫ P_cur.π_Y₁ ≫
            (E.g_Y₁ ≫ E.π_bar.left) ≫ E.V_bar.hom := by
            rw [← E.hComm_Y₁]
      _ = (P_cur.e_W.hom ≫ (P_cur.W_open.ι ≫ (P_cur.π_Y₁ ≫ E.g_Y₁))) ≫
            (E.π_bar.left ≫ E.V_bar.hom) := by
            simp only [CategoryTheory.Category.assoc]
      _ = (Fgt_Y.obj P_cur.W).hom ≫ E.Y_bar.hom := by
            rw [P_cur.he_W_hom, hπ_w]

  have hhV_cur_k : h_V_sch ≫ p_V_cur = p_V_next :=
    (CategoryTheory.Category.assoc h_V_sch (Fgt_V.obj P_cur.V).hom E.V_bar.hom).symm

  obtain ⟨s_x_cur, hs_x_cur_sec, hs_x_cur_range⟩ :=
    hSecOfClosed (Fgt_Y.obj P_cur.W).left p_W_cur P_cur.x P_cur.hx_cl
  have hs_W_eq : s_x_cur ≫ f_W_cur = s_next ≫ h_V_sch := by
    refine hSecEq V_cur p_V_cur (s_x_cur ≫ f_W_cur) (s_next ≫ h_V_sch) ?_ ?_ ?_
    · rw [CategoryTheory.Category.assoc, hf_W_cur_k]; exact hs_x_cur_sec
    · rw [CategoryTheory.Category.assoc, hhV_cur_k]; exact hs_next_sec
    · rw [hRangeSingletonComp s_x_cur f_W_cur P_cur.x hs_x_cur_range,
        hRangeSingletonComp s_next h_V_sch v_next hs_next_range, hhV_v]
      congr 1
      exact P_cur.hx_fib

  let P_pb_W := CategoryTheory.Limits.pullback f_W_cur h_V_sch
  have : AlgebraicGeometry.IsAffine P_pb_W := inferInstance
  let p_pb_W : P_pb_W ⟶ S_k := CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch ≫ p_V_next
  have : AlgebraicGeometry.LocallyOfFiniteType p_pb_W := by dsimp [p_pb_W]; infer_instance
  let s_pb_W : S_k ⟶ P_pb_W := CategoryTheory.Limits.pullback.lift s_x_cur s_next hs_W_eq
  have hs_pb_W_sec : s_pb_W ≫ p_pb_W = 𝟙 S_k := by
    dsimp [s_pb_W, p_pb_W]
    rw [CategoryTheory.Limits.pullback.lift_snd_assoc]
    exact hs_next_sec
  obtain ⟨z_pb, hs_pb_W_range, hz_pb_cl⟩ := hClosedOfSec P_pb_W p_pb_W s_pb_W hs_pb_W_sec
  have hz_pb_fst : (CategoryTheory.Limits.pullback.fst f_W_cur h_V_sch).base z_pb = P_cur.x := by
    have hr := hRangeSingletonComp s_pb_W
      (CategoryTheory.Limits.pullback.fst f_W_cur h_V_sch) z_pb hs_pb_W_range
    rw [CategoryTheory.Limits.pullback.lift_fst, hs_x_cur_range] at hr
    exact Set.singleton_eq_singleton_iff.mp hr.symm
  have hz_pb_snd : (CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch).base z_pb = v_next := by
    have hr := hRangeSingletonComp s_pb_W
      (CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch) z_pb hs_pb_W_range
    rw [CategoryTheory.Limits.pullback.lift_snd, hs_next_range] at hr
    exact Set.singleton_eq_singleton_iff.mp hr.symm

  have : AlgebraicGeometry.Etale φ_W_step := hEt_W_step
  have : AlgebraicGeometry.Surjective φ_W_step := hSurj_W_step
  have hz_pb_mem : z_pb ∈ Set.range φ_W_step.base := φ_W_step.surjective z_pb
  obtain ⟨O_x, x_O, hAff_Ox, hx_O_cl, hx_O_map⟩ :=
    hEtLiftClosed (Fgt_Y.obj W_next).left P_pb_W p_pb_W φ_W_step z_pb hz_pb_cl hz_pb_mem
  have : AlgebraicGeometry.IsAffine O_x.toScheme := hAff_Ox
  let p_Ox : O_x.toScheme ⟶ S_k := O_x.ι ≫ p_W_next
  have : AlgebraicGeometry.LocallyOfFiniteType p_Ox := by dsimp [p_Ox]; infer_instance
  obtain ⟨s_xO, hs_xO_sec, hs_xO_range⟩ :=
    hSecOfClosed O_x.toScheme p_Ox x_O hx_O_cl
  let s_x_next : S_k ⟶ (Fgt_Y.obj W_next).left := s_xO ≫ O_x.ι
  have hs_x_next_sec : s_x_next ≫ p_W_next = 𝟙 S_k := by
    dsimp [s_x_next]
    rw [CategoryTheory.Category.assoc]
    exact hs_xO_sec
  obtain ⟨x_next', hs_x_next_range', hx_next'_cl⟩ :=
    hClosedOfSec (Fgt_Y.obj W_next).left p_W_next s_x_next hs_x_next_sec
  let x_next : ↥(Fgt_Y.obj W_next).left := O_x.ι.base x_O
  have hx_next_eq : x_next = x_next' := by
    have hr := hRangeSingletonComp s_xO O_x.ι x_O hs_xO_range
    change Set.range s_x_next.base = {x_next} at hr
    rw [hs_x_next_range'] at hr
    exact Set.singleton_eq_singleton_iff.mp hr.symm
  have hx_next_cl : IsClosed ({x_next} : Set ↥(Fgt_Y.obj W_next).left) := by
    rwa [hx_next_eq]
  have hx_next_hW : (Fgt_Y.map h_W).left.base x_next = P_cur.x := by
    calc
      (Fgt_Y.map h_W).left.base x_next
        = (φ_W_step ≫ CategoryTheory.Limits.pullback.fst f_W_cur h_V_sch).base x_next := by
          rw [CategoryTheory.Limits.pullback.lift_fst]
      _ = (CategoryTheory.Limits.pullback.fst f_W_cur h_V_sch).base (φ_W_step.base x_next) := rfl
      _ = (CategoryTheory.Limits.pullback.fst f_W_cur h_V_sch).base z_pb := by
          rw [hx_O_map]
      _ = P_cur.x := hz_pb_fst
  have hx_next_map : (Fgt_Y.map u_W_next).left.base x_next = E.x₁ := by
    change (Fgt_Y.map P_cur.u_W).left.base ((Fgt_Y.map h_W).left.base x_next) = E.x₁
    rw [hx_next_hW, P_cur.hx_map]
  have hx_next_fib : f_next.base (W_next_open.ι.base (e_W_next.hom.base x_next)) = v_next := by
    calc
      f_next.base (W_next_open.ι.base (e_W_next.hom.base x_next))
        = (φ_W_step ≫ CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch).base x_next := by
          rw [CategoryTheory.Limits.pullback.lift_snd]; rfl
      _ = (CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch).base (φ_W_step.base x_next) := rfl
      _ = (CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch).base z_pb := by
          rw [hx_O_map]
      _ = v_next := hz_pb_snd

  
  let P_next : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E :=
    { V := V_next
      g_V := g_V_next
      v := v_next
      Y := Y_next
      f_bar := f_next
      π_Y₁ := π_Y₁_next
      m_pts := m_next
      τ_bdry := τ_next
      W_open := W_next_open
      W := W_next
      e_W := e_W_next
      u_W := u_W_next
      x := x_next
      hAff_V := hAff_Vnext
      hInt_V := hInt_Vnext
      hv_cl := hv_next_cl
      hv_map := hgV_next_v
      hInt_Y := hInt_Ynext
      hProp_f := hProp_fnext
      hSm_f := hSm_fnext
      hComm_Y₁ := hComm_Y₁_next
      hFin_rel := hFin_rel_next
      hSurj_rel := hSurj_rel_next
      hIrred_fib := hIrred_fib
      hm_pts_pos := hm_next_pos
      hτ_sec := hτ_next_sec
      hτ_cl := hτ_next_cl
      hτ_disj := hτ_next_disj
      hW_compl := hW_compl_next
      hAff_Wopen := hAff_Wopen_next
      he_W_hom := he_W_hom_next
      hu_W_comp := hu_W_comp_next
      hComm_W := hComm_W_next
      hFin_W_rel := hFin_W_rel_next
      hEt_W_rel := hEt_W_rel_next
      hSurj_W_rel := hSurj_W_rel_next
      hx_cl := hx_next_cl
      hx_map := hx_next_map
      hx_fib := hx_next_fib }

  exact ⟨P_next, h_V, h_Y, h_W, q_raw, h_V_B₀,
    ⟨hhV_v, hComm_Y, rfl, rfl, hhW_comp⟩,
    rfl, hhV_B₀_g, CategoryTheory.Limits.pullback.condition, hhV_B₀_pt⟩

theorem weil_rel_curve_cover_unramified_step_annihilation (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
    (s₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).left)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_C₀ : Quiver.Hom C₀.left P_cur.Y)
    (γ_bar : weilEtaleTorsionH C₀.left ℓ 1)
    (hs₀_range : Set.range s₀.base = {P_cur.v})
    (hs₀_sec : CategoryTheory.CategoryStruct.comp s₀
      (CategoryTheory.CategoryStruct.comp
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).hom
        E.V_bar.hom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hPb_C₀ : CategoryTheory.IsPullback ι_C₀ C₀.hom P_cur.f_bar s₀)
    (hIntC : AlgebraicGeometry.IsIntegral C₀.left)
    (hProjC : IsProjectiveOverField k C₀) :
    ∃ (P_next : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
      (h_V : Quiver.Hom P_next.V P_cur.V)
      (h_Y : Quiver.Hom P_next.Y P_cur.Y)
      (h_W : Quiver.Hom P_next.W P_cur.W),
      (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left.base P_next.v =
          P_cur.v ∧
        CategoryTheory.CategoryStruct.comp h_Y P_cur.f_bar =
          CategoryTheory.CategoryStruct.comp P_next.f_bar
            (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left) ∧
        CategoryTheory.CategoryStruct.comp h_W P_cur.u_W = P_next.u_W ∧
        (TopologicalSpace.Opens.map h_Y.base).obj P_cur.W_open = P_next.W_open ∧
        CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map h_W).left)
            (CategoryTheory.CategoryStruct.comp P_cur.e_W.hom P_cur.W_open.ι) =
          CategoryTheory.CategoryStruct.comp P_next.e_W.hom
            (CategoryTheory.CategoryStruct.comp P_next.W_open.ι h_Y)) ∧
      (∀ (s'₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
            ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_next.V).left)
          (C'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_C'₀ : Quiver.Hom C'₀.left P_next.Y)
          (ν₀ : Quiver.Hom C'₀.left C₀.left),
        Set.range s'₀.base = {P_next.v} →
        CategoryTheory.CategoryStruct.comp s'₀
            (CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_next.V).hom
              E.V_bar.hom) =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        CategoryTheory.IsPullback ι_C'₀ C'₀.hom P_next.f_bar s'₀ →
        CategoryTheory.CategoryStruct.comp ι_C'₀ h_Y =
          CategoryTheory.CategoryStruct.comp ν₀ ι_C₀ →
        ∃ p_ν : weilEtaleTorsionH C₀.left ℓ 1 →+ weilEtaleTorsionH C'₀.left ℓ 1,
          WeilIsTorsionEtalePullback ν₀ ℓ 1 p_ν ∧
          p_ν γ_bar = 0) :=
by
  classical
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance

  obtain ⟨hPullEx, hPullId, _, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}

  
  by_cases hγ : γ_bar = 0
  · refine ⟨P_cur, 𝟙 P_cur.V, 𝟙 P_cur.Y, 𝟙 P_cur.W, ?_, ?_⟩
    · have hmap_id_V : (Fgt_V.map (𝟙 P_cur.V)).left = 𝟙 (Fgt_V.obj P_cur.V).left := by simp
      have hmap_id_W : (Fgt_Y.map (𝟙 P_cur.W)).left = 𝟙 (Fgt_Y.obj P_cur.W).left := by simp
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · rw [hmap_id_V]; rfl
      · change 𝟙 P_cur.Y ≫ P_cur.f_bar = P_cur.f_bar ≫ (Fgt_V.map (𝟙 P_cur.V)).left
        rw [hmap_id_V, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      · exact CategoryTheory.Category.id_comp P_cur.u_W
      · ext z; rfl
      · change (Fgt_Y.map (𝟙 P_cur.W)).left ≫ (P_cur.e_W.hom ≫ P_cur.W_open.ι) =
          P_cur.e_W.hom ≫ (P_cur.W_open.ι ≫ 𝟙 P_cur.Y)
        rw [hmap_id_W, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    · intro s'₀ C'₀ ι_C'₀ ν₀ _ _ _ _
      obtain ⟨p_ν, hp_ν⟩ := hPullEx ν₀ ℓ 1
      refine ⟨p_ν, hp_ν, ?_⟩
      rw [hγ, map_zero]

  
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_C₀ P_cur.hSm_f

  
  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine V]
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = 𝟙 S_k →
        s₂ ≫ p_V = 𝟙 S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V _ p_V s₁ s₂ hs₁ hs₂ hpt
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hpt
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
