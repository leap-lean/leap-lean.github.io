  have hAlgEt_T₀₀_left : Algebra.Etale S'₀ T₀₀ := Algebra.Etale.baseChange R'₀ S'₀ S'₀
  have hAlgEt_T₀₀ : Algebra.Etale R'₀ T₀₀ := Algebra.Etale.comp R'₀ S'₀ T₀₀
  have hAlgEt_T₀₀₀_left : Algebra.Etale T₀₀ T₀₀₀ := Algebra.Etale.baseChange R'₀ S'₀ T₀₀
  have hAlgEt_T₀₀₀ : Algebra.Etale R'₀ T₀₀₀ := Algebra.Etale.comp R'₀ T₀₀ T₀₀₀

  have hAlgEt_T₁₁_left : Algebra.Etale S'₁ T₁₁ := Algebra.Etale.baseChange R'₁ S'₁ S'₁
  have hAlgEt_T₁₁ : Algebra.Etale R'₁ T₁₁ := Algebra.Etale.comp R'₁ S'₁ T₁₁
  have hAlgEt_T₁₁₁_left : Algebra.Etale T₁₁ T₁₁₁ := Algebra.Etale.baseChange R'₁ S'₁ T₁₁
  have hAlgEt_T₁₁₁ : Algebra.Etale R'₁ T₁₁₁ := Algebra.Etale.comp R'₁ T₁₁ T₁₁₁

  have hAlgEt_S₀ov : Algebra.Etale R'₀₁ S'₀_ov := Algebra.Etale.baseChange R'₀ S'₀ R'₀₁
  have hAlgEt_S₁ov : Algebra.Etale R'₀₁ S'₁_ov := Algebra.Etale.baseChange R'₁ S'₁ R'₀₁
  have hAlgEt_T₀₀ov_left : Algebra.Etale S'₀_ov T₀₀_ov := Algebra.Etale.baseChange R'₀₁ S'₀_ov S'₀_ov
  have hAlgEt_T₀₀ov : Algebra.Etale R'₀₁ T₀₀_ov := Algebra.Etale.comp R'₀₁ S'₀_ov T₀₀_ov
  have hAlgEt_T₀₁_left : Algebra.Etale S'₀_ov T₀₁ := Algebra.Etale.baseChange R'₀₁ S'₁_ov S'₀_ov
  have hAlgEt_T₀₁ : Algebra.Etale R'₀₁ T₀₁ := Algebra.Etale.comp R'₀₁ S'₀_ov T₀₁
  have hAlgEt_T₀₀₁_left : Algebra.Etale T₀₀_ov T₀₀₁ := Algebra.Etale.baseChange R'₀₁ S'₁_ov T₀₀_ov
  have hAlgEt_T₀₀₁ : Algebra.Etale R'₀₁ T₀₀₁ := Algebra.Etale.comp R'₀₁ T₀₀_ov T₀₀₁
  have hAlgEt_T₀₁₁_left : Algebra.Etale T₀₁ T₀₁₁ := Algebra.Etale.baseChange R'₀₁ S'₁_ov T₀₁
  have hAlgEt_T₀₁₁ : Algebra.Etale R'₀₁ T₀₁₁ := Algebra.Etale.comp R'₀₁ T₀₁ T₀₁₁

  let h₀_str : ∀ (A : Type u) [CommRing A] [Algebra R'₀ A],
      AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y' :=
    fun A _ _ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₀ A)) ≫ hAff_in.fromSpec
  have h₀_et : ∀ (A : Type u) [CommRing A] [Algebra R'₀ A] [hE : Algebra.Etale R'₀ A],
      AlgebraicGeometry.Etale (h₀_str A) := by
    intro A _ _ hE
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₀ A))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hE)
    dsimp [h₀_str]
    infer_instance
  have h₀_fac : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra R'₀ A] [Algebra R'₀ B]
      (f : A →ₐ[R'₀] B),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f.toRingHom) ≫ h₀_str A = h₀_str B := by
    intro A B _ _ _ _ f
    dsimp [h₀_str]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    ext r
    exact f.commutes r

  let h₁_str : ∀ (A : Type u) [CommRing A] [Algebra R'₁ A],
      AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y' :=
    fun A _ _ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₁ A)) ≫ hAff_out.fromSpec
  have h₁_et : ∀ (A : Type u) [CommRing A] [Algebra R'₁ A] [hE : Algebra.Etale R'₁ A],
      AlgebraicGeometry.Etale (h₁_str A) := by
    intro A _ _ hE
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₁ A))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hE)
    dsimp [h₁_str]
    infer_instance
  have h₁_fac : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra R'₁ A] [Algebra R'₁ B]
      (f : A →ₐ[R'₁] B),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f.toRingHom) ≫ h₁_str A = h₁_str B := by
    intro A B _ _ _ _ f
    dsimp [h₁_str]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    ext r
    exact f.commutes r

  let h₀₁_str : ∀ (A : Type u) [CommRing A] [Algebra R'₀₁ A],
      AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y' :=
    fun A _ _ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₀₁ A)) ≫ hAff_ov.fromSpec
  have h₀₁_et : ∀ (A : Type u) [CommRing A] [Algebra R'₀₁ A] [hE : Algebra.Etale R'₀₁ A],
      AlgebraicGeometry.Etale (h₀₁_str A) := by
    intro A _ _ hE
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₀₁ A))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hE)
    dsimp [h₀₁_str]
    infer_instance
  have h₀₁_fac : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra R'₀₁ A] [Algebra R'₀₁ B]
      (f : A →ₐ[R'₀₁] B),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f.toRingHom) ≫ h₀₁_str A = h₀₁_str B := by
    intro A B _ _ _ _ f
    dsimp [h₀₁_str]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 2
    ext r
    exact f.commutes r

  have hρ₀_fromSpec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'₀) ≫ hAff_in.fromSpec =
      hAff_ov.fromSpec :=
    AlgebraicGeometry.IsAffineOpen.map_fromSpec hAff_in hAff_ov (CategoryTheory.homOfLE inf_le_right).op
  have hρ₁_fromSpec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ'₁) ≫ hAff_out.fromSpec =
      hAff_ov.fromSpec :=
    AlgebraicGeometry.IsAffineOpen.map_fromSpec hAff_out hAff_ov (CategoryTheory.homOfLE inf_le_left).op

  have h₀_to_₀₁_fac : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra R'₀ A] [Algebra R'₀₁ B]
      (f : A →+* B),
      (∀ r : R'₀, f (algebraMap R'₀ A r) = algebraMap R'₀₁ B (ρ'₀ r)) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) ≫ h₀_str A = h₀₁_str B := by
    intro A B _ _ _ _ f hf
    dsimp [h₀_str, h₀₁_str]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hhom : CommRingCat.ofHom (algebraMap R'₀ A) ≫ CommRingCat.ofHom f =
        CommRingCat.ofHom ρ'₀ ≫ CommRingCat.ofHom (algebraMap R'₀₁ B) := by
      ext r
      exact hf r
    rw [hhom, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hρ₀_fromSpec]

  have h₁_to_₀₁_fac : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra R'₁ A] [Algebra R'₀₁ B]
      (f : A →+* B),
      (∀ r : R'₁, f (algebraMap R'₁ A r) = algebraMap R'₀₁ B (ρ'₁ r)) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) ≫ h₁_str A = h₀₁_str B := by
    intro A B _ _ _ _ f hf
    dsimp [h₁_str, h₀₁_str]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hhom : CommRingCat.ofHom (algebraMap R'₁ A) ≫ CommRingCat.ofHom f =
        CommRingCat.ofHom ρ'₁ ≫ CommRingCat.ofHom (algebraMap R'₀₁ B) := by
      ext r
      exact hf r
    rw [hhom, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hρ₁_fromSpec]

  have hSub_W₁ : ∀ {Z : Y'.Etale} (a b : Z ⟶ V_W₁), a = b := by
    intro Z a b
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact (cancel_mono U'_out.ι).mp
      ((CategoryTheory.MorphismProperty.Over.w a).trans
        (CategoryTheory.MorphismProperty.Over.w b).symm)
  have hSub_W₂ : ∀ {Z : Y'.Etale} (a b : Z ⟶ V_W₂), a = b := by
    intro Z a b
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact (cancel_mono U'_in.ι).mp
      ((CategoryTheory.MorphismProperty.Over.w a).trans
        (CategoryTheory.MorphismProperty.Over.w b).symm)

  have hUnitEq : ∀ (A : Type u) [CommRing A]
      (h_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y') (hEt_A : AlgebraicGeometry.Etale h_A)
      (u₁ u₂ : Units A),
      κ A h_A hEt_A (Additive.ofMul u₁) = κ A h_A hEt_A (Additive.ofMul u₂) →
      (u₁ : A) = (u₂ : A) := by
    intro A _ h_A hEt_A u₁ u₂ hEq
    exact congrArg Units.val (Additive.ofMul.injective (hκ_inj A h_A hEt_A hEq))

  have hπ_nat : ∀ {W₁ W₂ : Y'.Etale} (g : W₁ ⟶ W₂) (x : ↥(I.obj.obj (Opposite.op W₂))),
      (π_inj.hom.app (Opposite.op W₁)).hom (pushI g x) =
        (Q.obj.map g.op).hom ((π_inj.hom.app (Opposite.op W₂)).hom x) := by
    intro W₁ W₂ g x
    exact congrArg (fun φ => φ.hom x) (π_inj.hom.naturality g.op)

  have hExtractDiffUnit :
      ∀ {A₁ A₂ P : Type u} [CommRing A₁] [CommRing A₂] [CommRing P]
        {h₁ : AlgebraicGeometry.Spec (CommRingCat.of A₁) ⟶ Y'} (hEt₁ : AlgebraicGeometry.Etale h₁)
        {h₂ : AlgebraicGeometry.Spec (CommRingCat.of A₂) ⟶ Y'} (hEt₂ : AlgebraicGeometry.Etale h₂)
        {hP : AlgebraicGeometry.Spec (CommRingCat.of P) ⟶ Y'} (hEtP : AlgebraicGeometry.Etale hP)
        (s₁ : ↥(I.obj.obj (Opposite.op (mkEt A₁ h₁ hEt₁))))
        (hs₁ : (π_inj.hom.app (Opposite.op (mkEt A₁ h₁ hEt₁))).hom s₁ = q_η (mkEt A₁ h₁ hEt₁))
        (s₂ : ↥(I.obj.obj (Opposite.op (mkEt A₂ h₂ hEt₂))))
        (hs₂ : (π_inj.hom.app (Opposite.op (mkEt A₂ h₂ hEt₂))).hom s₂ = q_η (mkEt A₂ h₂ hEt₂))
        (f₁ : A₁ →+* P) (hf₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁) ≫ h₁ = hP)
        (f₂ : A₂ →+* P) (hf₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂) ≫ h₂ = hP),
        ∃ g : Units P,
          κ P hP hEtP (Additive.ofMul g) =
            pushI (homEt (hEt_A := hEt₂) (hEt_B := hEtP) f₂ hf₂) s₂ -
              pushI (homEt (hEt_A := hEt₁) (hEt_B := hEtP) f₁ hf₁) s₁ := by
    intro A₁ A₂ P _ _ _ h₁ hEt₁ h₂ hEt₂ hP hEtP s₁ hs₁ s₂ hs₂ f₁ hf₁ f₂ hf₂
    let m₁ := homEt (hEt_A := hEt₁) (hEt_B := hEtP) f₁ hf₁
    let m₂ := homEt (hEt_A := hEt₂) (hEt_B := hEtP) f₂ hf₂
    have hker : (π_inj.hom.app (Opposite.op (mkEt P hP hEtP))).hom (pushI m₂ s₂ - pushI m₁ s₁) = 0 := by
      rw [map_sub, hπ_nat m₂, hπ_nat m₁, hs₂, hs₁, hq_nat m₂, hq_nat m₁, sub_self]
    exact hκ_ker P hP hEtP (pushI m₂ s₂ - pushI m₁ s₁) hker

  have hTriangleCocycle :
      ∀ {A₁ A₂ A₃ P₁₂ P₂₃ P₁₃ T_tri : Type u}
        [CommRing A₁] [CommRing A₂] [CommRing A₃]
        [CommRing P₁₂] [CommRing P₂₃] [CommRing P₁₃] [CommRing T_tri]
        {h₁ : AlgebraicGeometry.Spec (CommRingCat.of A₁) ⟶ Y'} (hEt₁ : AlgebraicGeometry.Etale h₁)
        {h₂ : AlgebraicGeometry.Spec (CommRingCat.of A₂) ⟶ Y'} (hEt₂ : AlgebraicGeometry.Etale h₂)
        {h₃ : AlgebraicGeometry.Spec (CommRingCat.of A₃) ⟶ Y'} (hEt₃ : AlgebraicGeometry.Etale h₃)
        {h₁₂ : AlgebraicGeometry.Spec (CommRingCat.of P₁₂) ⟶ Y'} (hEt₁₂ : AlgebraicGeometry.Etale h₁₂)
        {h₂₃ : AlgebraicGeometry.Spec (CommRingCat.of P₂₃) ⟶ Y'} (hEt₂₃ : AlgebraicGeometry.Etale h₂₃)
        {h₁₃ : AlgebraicGeometry.Spec (CommRingCat.of P₁₃) ⟶ Y'} (hEt₁₃ : AlgebraicGeometry.Etale h₁₃)
        {hT : AlgebraicGeometry.Spec (CommRingCat.of T_tri) ⟶ Y'} (hEtT : AlgebraicGeometry.Etale hT)
        (s₁ : ↥(I.obj.obj (Opposite.op (mkEt A₁ h₁ hEt₁))))
        (s₂ : ↥(I.obj.obj (Opposite.op (mkEt A₂ h₂ hEt₂))))
        (s₃ : ↥(I.obj.obj (Opposite.op (mkEt A₃ h₃ hEt₃))))
        (l₁₂ : A₁ →+* P₁₂) (hl₁₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom l₁₂) ≫ h₁ = h₁₂)
        (r₁₂ : A₂ →+* P₁₂) (hr₁₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₁₂) ≫ h₂ = h₁₂)
        (l₂₃ : A₂ →+* P₂₃) (hl₂₃ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom l₂₃) ≫ h₂ = h₂₃)
        (r₂₃ : A₃ →+* P₂₃) (hr₂₃ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₂₃) ≫ h₃ = h₂₃)
        (l₁₃ : A₁ →+* P₁₃) (hl₁₃ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom l₁₃) ≫ h₁ = h₁₃)
        (r₁₃ : A₃ →+* P₁₃) (hr₁₃ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₁₃) ≫ h₃ = h₁₃)
        (g₁₂ : Units P₁₂)
        (hg₁₂ : κ P₁₂ h₁₂ hEt₁₂ (Additive.ofMul g₁₂) =
          pushI (homEt (hEt_A := hEt₂) (hEt_B := hEt₁₂) r₁₂ hr₁₂) s₂ -
            pushI (homEt (hEt_A := hEt₁) (hEt_B := hEt₁₂) l₁₂ hl₁₂) s₁)
        (g₂₃ : Units P₂₃)
        (hg₂₃ : κ P₂₃ h₂₃ hEt₂₃ (Additive.ofMul g₂₃) =
          pushI (homEt (hEt_A := hEt₃) (hEt_B := hEt₂₃) r₂₃ hr₂₃) s₃ -
            pushI (homEt (hEt_A := hEt₂) (hEt_B := hEt₂₃) l₂₃ hl₂₃) s₂)
        (g₁₃ : Units P₁₃)
        (hg₁₃ : κ P₁₃ h₁₃ hEt₁₃ (Additive.ofMul g₁₃) =
          pushI (homEt (hEt_A := hEt₃) (hEt_B := hEt₁₃) r₁₃ hr₁₃) s₃ -
            pushI (homEt (hEt_A := hEt₁) (hEt_B := hEt₁₃) l₁₃ hl₁₃) s₁)
        (q₁₂ : P₁₂ →+* T_tri) (hq₁₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom q₁₂) ≫ h₁₂ = hT)
        (q₂₃ : P₂₃ →+* T_tri) (hq₂₃ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom q₂₃) ≫ h₂₃ = hT)
        (q₁₃ : P₁₃ →+* T_tri) (hq₁₃ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom q₁₃) ≫ h₁₃ = hT),
        q₁₃.comp l₁₃ = q₁₂.comp l₁₂ →
        q₁₂.comp r₁₂ = q₂₃.comp l₂₃ →
        q₁₃.comp r₁₃ = q₂₃.comp r₂₃ →
        q₁₃ (g₁₃ : P₁₃) = q₁₂ (g₁₂ : P₁₂) * q₂₃ (g₂₃ : P₂₃) := by
    intro A₁ A₂ A₃ P₁₂ P₂₃ P₁₃ T_tri _ _ _ _ _ _ _
      h₁ hEt₁ h₂ hEt₂ h₃ hEt₃ h₁₂ hEt₁₂ h₂₃ hEt₂₃ h₁₃ hEt₁₃ hT hEtT
      s₁ s₂ s₃ l₁₂ hl₁₂ r₁₂ hr₁₂ l₂₃ hl₂₃ r₂₃ hr₂₃ l₁₃ hl₁₃ r₁₃ hr₁₃
      g₁₂ hg₁₂ g₂₃ hg₂₃ g₁₃ hg₁₃ q₁₂ hq₁₂ q₂₃ hq₂₃ q₁₃ hq₁₃ hc₁ hc₂ hc₃
    change ((Units.map q₁₃.toMonoidHom g₁₃ : Units T_tri) : T_tri) =
      ((Units.map q₁₂.toMonoidHom g₁₂ * Units.map q₂₃.toMonoidHom g₂₃ : Units T_tri) : T_tri)
    refine hUnitEq T_tri hT hEtT _ _ ?_
    rw [ofMul_mul, map_add,
      ← hκ_map q₁₃ h₁₃ hEt₁₃ hT hEtT hq₁₃,
      ← hκ_map q₁₂ h₁₂ hEt₁₂ hT hEtT hq₁₂,
      ← hκ_map q₂₃ h₂₃ hEt₂₃ hT hEtT hq₂₃,
      hg₁₃, hg₁₂, hg₂₃, map_sub, map_sub, map_sub]
    have hcomp_fac : ∀ {X Y : Type u} [CommRing X] [CommRing Y]
        {hX : AlgebraicGeometry.Spec (CommRingCat.of X) ⟶ Y'}
        {hY : AlgebraicGeometry.Spec (CommRingCat.of Y) ⟶ Y'}
        (f : X →+* Y) (g : Y →+* T_tri),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) ≫ hX = hY →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom g) ≫ hY = hT →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (g.comp f)) ≫ hX = hT := by
      intro X Y _ _ hX hY f g hf hg
      have hof : CommRingCat.ofHom (g.comp f) = CommRingCat.ofHom f ≫ CommRingCat.ofHom g := rfl
      rw [hof, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hf, hg]
    have hf₁ := hcomp_fac l₁₂ q₁₂ hl₁₂ hq₁₂
    have hf₂ := hcomp_fac r₁₂ q₁₂ hr₁₂ hq₁₂
    have hf₃ := hcomp_fac r₂₃ q₂₃ hr₂₃ hq₂₃
    rw [← hpushI_homEt_comp r₁₃ q₁₃ hr₁₃ hq₁₃ (hc₃.symm ▸ hf₃),
      ← hpushI_homEt_comp l₁₃ q₁₃ hl₁₃ hq₁₃ (hc₁.symm ▸ hf₁),
      ← hpushI_homEt_comp r₁₂ q₁₂ hr₁₂ hq₁₂ hf₂,
      ← hpushI_homEt_comp l₁₂ q₁₂ hl₁₂ hq₁₂ hf₁,
      ← hpushI_homEt_comp r₂₃ q₂₃ hr₂₃ hq₂₃ hf₃,
      ← hpushI_homEt_comp l₂₃ q₂₃ hl₂₃ hq₂₃ (hc₂ ▸ hf₂)]
    have hm₁ : homEt (hEt_A := hEt₁) (hEt_B := hEtT) (q₁₃.comp l₁₃) (hc₁.symm ▸ hf₁) =
        homEt (hEt_A := hEt₁) (hEt_B := hEtT) (q₁₂.comp l₁₂) hf₁ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q₁₃.comp l₁₃)) = _
      rw [hc₁]; rfl
    have hm₂ : homEt (hEt_A := hEt₂) (hEt_B := hEtT) (q₂₃.comp l₂₃) (hc₂ ▸ hf₂) =
        homEt (hEt_A := hEt₂) (hEt_B := hEtT) (q₁₂.comp r₁₂) hf₂ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q₂₃.comp l₂₃)) = _
      rw [← hc₂]; rfl
    have hm₃ : homEt (hEt_A := hEt₃) (hEt_B := hEtT) (q₁₃.comp r₁₃) (hc₃.symm ▸ hf₃) =
        homEt (hEt_A := hEt₃) (hEt_B := hEtT) (q₂₃.comp r₂₃) hf₃ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q₁₃.comp r₁₃)) = _
      rw [hc₃]; rfl
    rw [hm₁, hm₂, hm₃]
    abel

  have hChartCoboundary :
      ∀ {S_r T_r : Type u} [CommRing S_r] [CommRing T_r]
        {V_W : Y'.Etale} (hSub : ∀ {Z : Y'.Etale} (a b : Z ⟶ V_W), a = b)
        {hS : AlgebraicGeometry.Spec (CommRingCat.of S_r) ⟶ Y'} (hEtS : AlgebraicGeometry.Etale hS)
        {hT : AlgebraicGeometry.Spec (CommRingCat.of T_r) ⟶ Y'} (hEtT : AlgebraicGeometry.Etale hT)
        (α : mkEt S_r hS hEtS ⟶ V_W)
        (s_t : ↥(I.obj.obj (Opposite.op V_W)))
        (σ_s : ↥(I.obj.obj (Opposite.op (mkEt S_r hS hEtS))))
        (v_u : Units S_r)
        (hv_u : κ S_r hS hEtS (Additive.ofMul v_u) = ℓ • σ_s - pushI α s_t)
        (inl_f : S_r →+* T_r) (hinl : AlgebraicGeometry.Spec.map (CommRingCat.ofHom inl_f) ≫ hS = hT)
        (inr_f : S_r →+* T_r) (hinr : AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr_f) ≫ hS = hT)
        (g_u : Units T_r)
        (hg_u : κ T_r hT hEtT (Additive.ofMul g_u) =
          pushI (homEt (hEt_A := hEtS) (hEt_B := hEtT) inr_f hinr) σ_s -
            pushI (homEt (hEt_A := hEtS) (hEt_B := hEtT) inl_f hinl) σ_s),
        (g_u : T_r) ^ ℓ * inl_f (v_u : S_r) = inr_f (v_u : S_r) := by
    intro S_r T_r _ _ V_W hSub hS hEtS hT hEtT α s_t σ_s v_u hv_u inl_f hinl inr_f hinr g_u hg_u
    change ((g_u ^ ℓ * Units.map inl_f.toMonoidHom v_u : Units T_r) : T_r) =
      ((Units.map inr_f.toMonoidHom v_u : Units T_r) : T_r)
    refine hUnitEq T_r hT hEtT _ _ ?_
    let ml := homEt (hEt_A := hEtS) (hEt_B := hEtT) inl_f hinl
    let mr := homEt (hEt_A := hEtS) (hEt_B := hEtT) inr_f hinr
    rw [ofMul_mul, ofMul_pow, map_add, map_nsmul,
      ← hκ_map inl_f hS hEtS hT hEtT hinl,
      ← hκ_map inr_f hS hEtS hT hEtT hinr,
      hg_u, hv_u, map_sub, map_sub, map_nsmul, map_nsmul,
      ← hpushI_comp ml α, ← hpushI_comp mr α,
      hSub (ml ≫ α) (mr ≫ α)]
    dsimp only [ml, mr]
    rw [smul_sub]
    abel

  let E_0 : Y'.Etale := mkEt S'₀ (h₀_str S'₀) hEt_0
  let E_1 : Y'.Etale := mkEt S'₁ (h₁_str S'₁) hEt_1

  let α₀ : E_0 ⟶ V_W₂ :=
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₀ S'₀)) ≫ hAff_in.isoSpec.inv)
      ((CategoryTheory.Category.assoc _ hAff_in.isoSpec.inv U'_in.ι).trans
        (congrArg _ hAff_in.isoSpec_inv_ι))
  let α₁ : E_1 ⟶ V_W₁ :=
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R'₁ S'₁)) ≫ hAff_out.isoSpec.inv)
      ((CategoryTheory.Category.assoc _ hAff_out.isoSpec.inv U'_out.ι).trans
        (congrArg _ hAff_out.isoSpec_inv_ι))

  have hv₀_ker : (π_inj.hom.app (Opposite.op E_0)).hom (ℓ • σ₀ - pushI α₀ s_tilde₀) = 0 := by
    rw [map_sub, map_nsmul, hσ₀, hπ_nat α₀, hs₀_π, map_nsmul, hq_nat α₀, sub_self]
  obtain ⟨v₀, hv₀⟩ := hκ_ker S'₀ (h₀_str S'₀) hEt_0 (ℓ • σ₀ - pushI α₀ s_tilde₀) hv₀_ker

  have hv₁_ker : (π_inj.hom.app (Opposite.op E_1)).hom (ℓ • σ₁ - pushI α₁ s_tilde₁) = 0 := by
    rw [map_sub, map_nsmul, hσ₁, hπ_nat α₁, hs₁_π, map_nsmul, hq_nat α₁, sub_self]
  obtain ⟨v₁, hv₁⟩ := hκ_ker S'₁ (h₁_str S'₁) hEt_1 (ℓ • σ₁ - pushI α₁ s_tilde₁) hv₁_ker

  have hOverlapCoboundary :
      ∀ {T₀₁_r : Type u} [CommRing T₀₁_r]
        {hT : AlgebraicGeometry.Spec (CommRingCat.of T₀₁_r) ⟶ Y'} (hEtT : AlgebraicGeometry.Etale hT)
        (in₀_f : S'₀ →+* T₀₁_r) (hin₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom in₀_f) ≫ h₀_str S'₀ = hT)
        (in₁_f : S'₁ →+* T₀₁_r) (hin₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom in₁_f) ≫ h₁_str S'₁ = hT)
        (alg_f : R'₀₁ →+* T₀₁_r) (halg : AlgebraicGeometry.Spec.map (CommRingCat.ofHom alg_f) ≫ h_R₀₁ = hT)
        (g_ov : Units T₀₁_r)
        (hg_ov : κ T₀₁_r hT hEtT (Additive.ofMul g_ov) =
          pushI (homEt (hEt_A := hEt_1) (hEt_B := hEtT) in₁_f hin₁) σ₁ -
            pushI (homEt (hEt_A := hEt_0) (hEt_B := hEtT) in₀_f hin₀) σ₀),
        (g_ov : T₀₁_r) ^ ℓ * in₀_f (v₀ : S'₀) = alg_f (u'_div : R'₀₁) * in₁_f (v₁ : S'₁) := by
    intro T₀₁_r _ hT hEtT in₀_f hin₀ in₁_f hin₁ alg_f halg g_ov hg_ov
    change ((g_ov ^ ℓ * Units.map in₀_f.toMonoidHom v₀ : Units T₀₁_r) : T₀₁_r) =
      ((Units.map alg_f.toMonoidHom u'_div * Units.map in₁_f.toMonoidHom v₁ : Units T₀₁_r) : T₀₁_r)
    refine hUnitEq T₀₁_r hT hEtT _ _ ?_
    let m₀ := homEt (hEt_A := hEt_0) (hEt_B := hEtT) in₀_f hin₀
    let m₁ := homEt (hEt_A := hEt_1) (hEt_B := hEtT) in₁_f hin₁
    let malg := homEt (hEt_A := hEt_R₀₁) (hEt_B := hEtT) alg_f halg
    rw [ofMul_mul, ofMul_pow, ofMul_mul, map_add, map_add, map_nsmul,
      ← hκ_map in₀_f (h₀_str S'₀) hEt_0 hT hEtT hin₀,
      ← hκ_map in₁_f (h₁_str S'₁) hEt_1 hT hEtT hin₁,
      ← hκ_map alg_f h_R₀₁ hEt_R₀₁ hT hEtT halg,
      hg_ov, hv₀, hv₁, ← hκ_udiv, ← hov_diff]
    change ℓ • (pushI m₁ σ₁ - pushI m₀ σ₀) + pushI m₀ (ℓ • σ₀ - pushI α₀ s_tilde₀) =
      pushI malg (pushI β₁₂ (pushI j₁₂_₁ s_tilde₁ - pushI j₁₂_₂ s_tilde₀)) +
        pushI m₁ (ℓ • σ₁ - pushI α₁ s_tilde₁)
    rw [map_sub, map_sub, map_sub, map_sub, map_nsmul, map_nsmul,
      ← hpushI_comp m₀ α₀, ← hpushI_comp m₁ α₁,
      ← hpushI_comp β₁₂ j₁₂_₁, ← hpushI_comp β₁₂ j₁₂_₂,
      ← hpushI_comp malg (β₁₂ ≫ j₁₂_₁), ← hpushI_comp malg (β₁₂ ≫ j₁₂_₂),
      hSub_W₂ (m₀ ≫ α₀) (malg ≫ β₁₂ ≫ j₁₂_₂),
      hSub_W₁ (m₁ ≫ α₁) (malg ≫ β₁₂ ≫ j₁₂_₁)]
    dsimp only [m₀, m₁]
    rw [smul_sub]
    abel

  let inl₀ : S'₀ →ₐ[R'₀] T₀₀ := Algebra.TensorProduct.includeLeft
  let inr₀ : S'₀ →ₐ[R'₀] T₀₀ := Algebra.TensorProduct.includeRight
  obtain ⟨g₀₀, hg₀₀⟩ := hExtractDiffUnit hEt_0 hEt_0 (h₀_et T₀₀) σ₀ hσ₀ σ₀ hσ₀
    inl₀.toRingHom (h₀_fac inl₀) inr₀.toRingHom (h₀_fac inr₀)

  let inl₁ : S'₁ →ₐ[R'₁] T₁₁ := Algebra.TensorProduct.includeLeft
  let inr₁ : S'₁ →ₐ[R'₁] T₁₁ := Algebra.TensorProduct.includeRight
  obtain ⟨g₁₁, hg₁₁⟩ := hExtractDiffUnit hEt_1 hEt_1 (h₁_et T₁₁) σ₁ hσ₁ σ₁ hσ₁
    inl₁.toRingHom (h₁_fac inl₁) inr₁.toRingHom (h₁_fac inr₁)

  let in₀ : S'₀ →+* T₀₁ :=
    ((Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀₁)
      (A := S'₀_ov) (B := S'₁_ov)).toRingHom).comp
      ((Algebra.TensorProduct.includeRight (R := R'₀) (A := R'₀₁) (B := S'₀)).toRingHom)
  let in₁ : S'₁ →+* T₀₁ :=
    ((Algebra.TensorProduct.includeRight (R := R'₀₁)
      (A := S'₀_ov) (B := S'₁_ov)).toRingHom).comp
      ((Algebra.TensorProduct.includeRight (R := R'₁) (A := R'₀₁) (B := S'₁)).toRingHom)
  have hbc₀_alg : ∀ r : R'₀,
      (1 : R'₀₁) ⊗ₜ[R'₀] algebraMap R'₀ S'₀ r = algebraMap R'₀₁ S'₀_ov (ρ'₀ r) := by
    intro r
    calc
      (1 : R'₀₁) ⊗ₜ[R'₀] algebraMap R'₀ S'₀ r
        = (1 : R'₀₁) ⊗ₜ[R'₀] (r • (1 : S'₀)) := by rw [Algebra.smul_def, mul_one]
      _ = (r • (1 : R'₀₁)) ⊗ₜ[R'₀] (1 : S'₀) := TensorProduct.tmul_smul r (1 : R'₀₁) (1 : S'₀)
      _ = (ρ'₀ r) ⊗ₜ[R'₀] (1 : S'₀) := by change (ρ'₀ r * 1) ⊗ₜ[R'₀] 1 = _; rw [mul_one]
      _ = algebraMap R'₀₁ S'₀_ov (ρ'₀ r) := rfl
  have hbc₁_alg : ∀ r : R'₁,
      (1 : R'₀₁) ⊗ₜ[R'₁] algebraMap R'₁ S'₁ r = algebraMap R'₀₁ S'₁_ov (ρ'₁ r) := by
    intro r
    calc
      (1 : R'₀₁) ⊗ₜ[R'₁] algebraMap R'₁ S'₁ r
        = (1 : R'₀₁) ⊗ₜ[R'₁] (r • (1 : S'₁)) := by rw [Algebra.smul_def, mul_one]
      _ = (r • (1 : R'₀₁)) ⊗ₜ[R'₁] (1 : S'₁) := TensorProduct.tmul_smul r (1 : R'₀₁) (1 : S'₁)
      _ = (ρ'₁ r) ⊗ₜ[R'₁] (1 : S'₁) := by change (ρ'₁ r * 1) ⊗ₜ[R'₁] 1 = _; rw [mul_one]
      _ = algebraMap R'₀₁ S'₁_ov (ρ'₁ r) := rfl
  have hin₀_alg : ∀ r : R'₀, in₀ (algebraMap R'₀ S'₀ r) = algebraMap R'₀₁ T₀₁ (ρ'₀ r) := by
    intro r
    change ((1 : R'₀₁) ⊗ₜ[R'₀] algebraMap R'₀ S'₀ r) ⊗ₜ[R'₀₁] (1 : S'₁_ov) =
      (algebraMap R'₀₁ S'₀_ov (ρ'₀ r)) ⊗ₜ[R'₀₁] (1 : S'₁_ov)
    rw [hbc₀_alg r]
  have hin₁_alg : ∀ r : R'₁, in₁ (algebraMap R'₁ S'₁ r) = algebraMap R'₀₁ T₀₁ (ρ'₁ r) := by
    intro r
    change (1 : S'₀_ov) ⊗ₜ[R'₀₁] ((1 : R'₀₁) ⊗ₜ[R'₁] algebraMap R'₁ S'₁ r) =
      (algebraMap R'₀₁ S'₀_ov (ρ'₁ r)) ⊗ₜ[R'₀₁] (1 : S'₁_ov)
    rw [hbc₁_alg r]
    calc
      (1 : S'₀_ov) ⊗ₜ[R'₀₁] algebraMap R'₀₁ S'₁_ov (ρ'₁ r)
        = (1 : S'₀_ov) ⊗ₜ[R'₀₁] (ρ'₁ r • (1 : S'₁_ov)) := by rw [Algebra.smul_def, mul_one]
      _ = (ρ'₁ r • (1 : S'₀_ov)) ⊗ₜ[R'₀₁] (1 : S'₁_ov) :=
            TensorProduct.tmul_smul (ρ'₁ r) (1 : S'₀_ov) (1 : S'₁_ov)
      _ = (algebraMap R'₀₁ S'₀_ov (ρ'₁ r)) ⊗ₜ[R'₀₁] (1 : S'₁_ov) := by
            rw [Algebra.smul_def, mul_one]

  obtain ⟨g₀₁, hg₀₁⟩ := hExtractDiffUnit hEt_0 hEt_1 (h₀₁_et T₀₁) σ₀ hσ₀ σ₁ hσ₁
    in₀ (h₀_to_₀₁_fac in₀ hin₀_alg) in₁ (h₁_to_₀₁_fac in₁ hin₁_alg)

  refine ⟨v₀, v₁, g₀₀, g₁₁, g₀₁, ?_⟩

  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  
  · let p₀_₁₂ : T₀₀ →ₐ[R'₀] T₀₀₀ := Algebra.TensorProduct.includeLeft
    let p₀_₁₃ : T₀₀ →ₐ[R'₀] T₀₀₀ :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
        Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
    let p₀_₂₃ : T₀₀ →ₐ[R'₀] T₀₀₀ :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
        Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
    refine hTriangleCocycle hEt_0 hEt_0 hEt_0 (h₀_et T₀₀) (h₀_et T₀₀) (h₀_et T₀₀) (h₀_et T₀₀₀)
      σ₀ σ₀ σ₀
      inl₀.toRingHom (h₀_fac inl₀) inr₀.toRingHom (h₀_fac inr₀)
      inl₀.toRingHom (h₀_fac inl₀) inr₀.toRingHom (h₀_fac inr₀)
      inl₀.toRingHom (h₀_fac inl₀) inr₀.toRingHom (h₀_fac inr₀)
      g₀₀ hg₀₀ g₀₀ hg₀₀ g₀₀ hg₀₀
      p₀_₁₂.toRingHom (h₀_fac p₀_₁₂) p₀_₂₃.toRingHom (h₀_fac p₀_₂₃) p₀_₁₃.toRingHom (h₀_fac p₀_₁₃)
      ?_ ?_ ?_
    · ext s
      change p₀_₁₃ (s ⊗ₜ[R'₀] (1 : S'₀)) = (s ⊗ₜ[R'₀] (1 : S'₀)) ⊗ₜ[R'₀] (1 : S'₀)
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    · ext s
      change ((1 : S'₀) ⊗ₜ[R'₀] s) ⊗ₜ[R'₀] (1 : S'₀) = p₀_₂₃ (s ⊗ₜ[R'₀] (1 : S'₀))
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    · ext s
      change p₀_₁₃ ((1 : S'₀) ⊗ₜ[R'₀] s) = p₀_₂₃ ((1 : S'₀) ⊗ₜ[R'₀] s)
      rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
        map_one, map_one]

  
  · let p₁_₁₂ : T₁₁ →ₐ[R'₁] T₁₁₁ := Algebra.TensorProduct.includeLeft
    let p₁_₁₃ : T₁₁ →ₐ[R'₁] T₁₁₁ :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
        Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
    let p₁_₂₃ : T₁₁ →ₐ[R'₁] T₁₁₁ :=
      Algebra.TensorProduct.lift
        (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
        Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
    refine hTriangleCocycle hEt_1 hEt_1 hEt_1 (h₁_et T₁₁) (h₁_et T₁₁) (h₁_et T₁₁) (h₁_et T₁₁₁)
      σ₁ σ₁ σ₁
      inl₁.toRingHom (h₁_fac inl₁) inr₁.toRingHom (h₁_fac inr₁)
      inl₁.toRingHom (h₁_fac inl₁) inr₁.toRingHom (h₁_fac inr₁)
      inl₁.toRingHom (h₁_fac inl₁) inr₁.toRingHom (h₁_fac inr₁)
      g₁₁ hg₁₁ g₁₁ hg₁₁ g₁₁ hg₁₁
      p₁_₁₂.toRingHom (h₁_fac p₁_₁₂) p₁_₂₃.toRingHom (h₁_fac p₁_₂₃) p₁_₁₃.toRingHom (h₁_fac p₁_₁₃)
      ?_ ?_ ?_
    · ext s
      change p₁_₁₃ (s ⊗ₜ[R'₁] (1 : S'₁)) = (s ⊗ₜ[R'₁] (1 : S'₁)) ⊗ₜ[R'₁] (1 : S'₁)
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    · ext s
      change ((1 : S'₁) ⊗ₜ[R'₁] s) ⊗ₜ[R'₁] (1 : S'₁) = p₁_₂₃ (s ⊗ₜ[R'₁] (1 : S'₁))
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    · ext s
      change p₁_₁₃ ((1 : S'₁) ⊗ₜ[R'₁] s) = p₁_₂₃ ((1 : S'₁) ⊗ₜ[R'₁] s)
      rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
        map_one, map_one]

  
  · exact hChartCoboundary hSub_W₂ hEt_0 (h₀_et T₀₀) α₀ s_tilde₀ σ₀ v₀ hv₀
      inl₀.toRingHom (h₀_fac inl₀) inr₀.toRingHom (h₀_fac inr₀) g₀₀ hg₀₀

  
  · exact hChartCoboundary hSub_W₁ hEt_1 (h₁_et T₁₁) α₁ s_tilde₁ σ₁ v₁ hv₁
      inl₁.toRingHom (h₁_fac inl₁) inr₁.toRingHom (h₁_fac inr₁) g₁₁ hg₁₁

  
  · exact hOverlapCoboundary (h₀₁_et T₀₁)
      in₀ (h₀_to_₀₁_fac in₀ hin₀_alg)
      in₁ (h₁_to_₀₁_fac in₁ hin₁_alg)
      (algebraMap R'₀₁ T₀₁) rfl
      g₀₁ hg₀₁

  
  · let map₀₀ : T₀₀ →ₐ[R'₀] T₀₀_ov :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀)
          (A := S'₀_ov) (B := S'₀_ov)).comp Algebra.TensorProduct.includeRight)
        (((Algebra.TensorProduct.includeRight (R := R'₀₁) (A := S'₀_ov) (B := S'₀_ov)).restrictScalars
          R'₀).comp Algebra.TensorProduct.includeRight)
        (fun _ _ => Commute.all _ _)
    let map₁₁ : T₁₁ →ₐ[R'₁] T₁₁_ov :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₁)
          (A := S'₁_ov) (B := S'₁_ov)).comp Algebra.TensorProduct.includeRight)
        (((Algebra.TensorProduct.includeRight (R := R'₀₁) (A := S'₁_ov) (B := S'₁_ov)).restrictScalars
          R'₁).comp Algebra.TensorProduct.includeRight)
        (fun _ _ => Commute.all _ _)
    let q₀₀₁_₁₂ : T₀₀_ov →ₐ[R'₀₁] T₀₀₁ := Algebra.TensorProduct.includeLeft
    let q₀₀₁_₁₃ : T₀₁ →ₐ[R'₀₁] T₀₀₁ :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀₁)
          (A := T₀₀_ov) (B := S'₁_ov)).comp
          (Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀₁) (A := S'₀_ov) (B := S'₀_ov)))
        (Algebra.TensorProduct.includeRight (R := R'₀₁) (A := T₀₀_ov) (B := S'₁_ov))
        (fun _ _ => @Commute.all T₀₀₁ _ _ _)
    let q₀₀₁_₂₃ : T₀₁ →ₐ[R'₀₁] T₀₀₁ :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀₁)
          (A := T₀₀_ov) (B := S'₁_ov)).comp
          (Algebra.TensorProduct.includeRight (R := R'₀₁) (A := S'₀_ov) (B := S'₀_ov)))
        (Algebra.TensorProduct.includeRight (R := R'₀₁) (A := T₀₀_ov) (B := S'₁_ov))
        (fun _ _ => @Commute.all T₀₀₁ _ _ _)
    let q₀₁₁_₁₂ : T₀₁ →ₐ[R'₀₁] T₀₁₁ := Algebra.TensorProduct.includeLeft
    let q₀₁₁_₁₃ : T₀₁ →ₐ[R'₀₁] T₀₁₁ :=
      Algebra.TensorProduct.lift
        ((Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀₁)
