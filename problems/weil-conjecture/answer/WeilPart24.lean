        IsUnit (g x) →
        ∃ ψ : Localization.Away x →+* T,
          ψ.comp (algebraMap R (Localization.Away x)) = g := by
      intro R T _ _ x g hgx
      have hpow : ∀ y : Submonoid.powers x, IsUnit (g y.1) := by
        rintro ⟨_, n, rfl⟩
        change IsUnit (g (x ^ n))
        rw [map_pow]
        exact hgx.pow n
      refine ⟨IsLocalization.lift (M := Submonoid.powers x) (S := Localization.Away x) (g := g) hpow, ?_⟩
      apply RingHom.ext
      intro a
      exact IsLocalization.lift_eq (M := Submonoid.powers x) (S := Localization.Away x) (g := g) hpow a
    let mkUnitLeft : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (σ : R →+* R') (x y : R),
        IsUnit (σ (x * y)) → Units R' :=
      fun {_ _ _ _} σ x y h =>
        Units.mkOfMulEqOne (σ x) (σ y * ((h.unit)⁻¹).1)
          (by
            rw [← mul_assoc, ← map_mul]
            change (h.unit).1 * ((h.unit)⁻¹).1 = 1
            exact Units.mul_inv h.unit)
    let mkUnitRight : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (σ : R →+* R') (x y : R),
        IsUnit (σ (x * y)) → Units R' :=
      fun {_ _ _ _} σ x y h =>
        Units.mkOfMulEqOne (σ y) (σ x * ((h.unit)⁻¹).1)
          (by
            rw [← mul_assoc, ← map_mul, mul_comm y x]
            change (h.unit).1 * ((h.unit)⁻¹).1 = 1
            exact Units.mul_inv h.unit)
    have away_ann_of_eq : ∀ {R : Type u} [CommRing R] (P a b : R),
        algebraMap R (Localization.Away P) a = algebraMap R (Localization.Away P) b →
        ∃ t : ℕ, ∀ T : ℕ, t ≤ T → P ^ T * (a - b) = 0 ∧ P ^ T * a = P ^ T * b := by
      intro R _ P a b heq
      have h0 : algebraMap R (Localization.Away P) (a - b) = 0 := by rw [map_sub, heq, sub_self]
      obtain ⟨⟨_, t, rfl⟩, ht⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers P) (Localization.Away P) (a - b)).mp h0
      change P ^ t * (a - b) = 0 at ht
      refine ⟨t, fun T hT => ?_⟩
      have hsub : P ^ T * (a - b) = 0 := by
        have hexp : T = (T - t) + t := (Nat.sub_add_cancel hT).symm
        rw [hexp, pow_add, mul_assoc, ht, mul_zero]
      exact ⟨hsub, sub_eq_zero.mp (by rw [← mul_sub]; exact hsub)⟩
