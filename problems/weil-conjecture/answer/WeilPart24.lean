  have hx_mid_cl : IsClosed ({x_mid} : Set ↥(Fgt_Y.obj W_mid_et).left) := by
    have hLFT_fWcur : AlgebraicGeometry.LocallyOfFiniteType f_W_cur :=
      hLFT_comp P_cur.e_W.hom (P_cur.W_open.ι ≫ P_cur.f_bar) (hLFT_of_isIso P_cur.e_W.hom)
        (hLFT_comp P_cur.W_open.ι P_cur.f_bar (hLFT_of_etale P_cur.W_open.ι)
          (hLFT_of_isProper P_cur.f_bar))
    have hLFT_snd : AlgebraicGeometry.LocallyOfFiniteType
        (CategoryTheory.Limits.pullback.snd f_W_cur h_V_sch) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_W_cur h_V_sch) hLFT_fWcur
    haveI : AlgebraicGeometry.LocallyOfFiniteType p_zpb := hLFT_comp _ p_V'' hLFT_snd ‹_›
    exact hEtaleClosedFiberPt p_zpb z_pb hz_pb_cl ψ_W_mid x_mid hx_mid_ψ

  let P_mid : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E :=
    { V := V_mid_et
      g_V := g_V_mid
      v := v''₀
      Y := Y_mid
      f_bar := f_mid
      π_Y₁ := π_Y₁_mid
      m_pts := m_pts_mid
      τ_bdry := τ_bdry_mid
      W_open := W_open_mid
      W := W_mid_et
      e_W := e_W_mid
      u_W := u_W_mid
      x := x_mid
      hAff_V := hAff_V''
      hInt_V := hInt_V''
      hv_cl := hv''₀_cl
      hv_map := hv''₀_E
      hInt_Y := hInt_Ymid
      hProp_f := hProp_fmid
      hSm_f := hSm_fmid
      hComm_Y₁ := hComm_Y₁_mid
      hFin_rel := hFin_Surj_rel_mid.1
      hSurj_rel := hFin_Surj_rel_mid.2
      hIrred_fib := hIrred_mid
      hm_pts_pos := hm_pts_mid_pos
      hτ_sec := hτ_mid_sec
      hτ_cl := hτ_mid_cl
      hτ_disj := hτ_mid_disj
      hW_compl := hW_compl_mid
      hAff_Wopen := hAff_Wopen_mid
      he_W_hom := CategoryTheory.Category.id_comp _
      hu_W_comp := hu_W_mid_comp
      hComm_W := hComm_W_mid
      hFin_W_rel := hProps_W_E.1
      hEt_W_rel := hProps_W_E.2.1
      hSurj_W_rel := hProps_W_E.2.2
      hx_cl := hx_mid_cl
      hx_map := hx_mid_map
      hx_fib := hx_mid_fib }

  refine ⟨P_mid, h_V, h_Y, h_W, hComm_mid,
    ⟨hv''₀_cur, rfl, rfl, hh_W_comp, hFin_mid_cur, hSurj_mid_cur⟩, ?_⟩
  
  intro s'₀ C'₀ ι_C'₀ ν₀ hs'₀_range hs'₀_sec hPb_C'₀ hComm_ν₀ a hc_a x' hx'_cl hν₀_x'
  let s'₀_V'' : S_k ⟶ V'' := s'₀
  let ι_C'₀_Y : C'₀.left ⟶ Y_mid := ι_C'₀
  have hs'₀_sec' : s'₀_V'' ≫ (h_V_sch ≫ (Fgt_V.obj P_cur.V).hom) ≫ E.V_bar.hom = 𝟙 S_k :=
    hs'₀_sec
  have hPb_C'₀_Y : CategoryTheory.IsPullback ι_C'₀_Y C'₀.hom f_mid s'₀_V'' := hPb_C'₀
  have hComm_ν₀_Y : ι_C'₀_Y ≫ h_Y = ν₀ ≫ ι_C₀ := hComm_ν₀
  have hs'₀_pt : s'₀_V''.base pt_k = v''₀ := by
    have hmem : s'₀.base pt_k ∈ Set.range s'₀.base := ⟨pt_k, rfl⟩
    rwa [hs'₀_range, Set.mem_singleton_iff] at hmem
  let s_sh : S_k ⟶ V_sh := s'₀_V'' ≫ h_V''
  have hs_sh_pt : s_sh.base pt_k = v_sh := by
    change h_V''.base (s'₀_V''.base pt_k) = v_sh
    rw [hs'₀_pt, hv''₀_map]
  have hs_sh_range : Set.range s_sh.base = {v_sh} := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨z, hz⟩ => by rw [← hz, hSub_k.elim z pt_k, hs_sh_pt],
           fun hy => ⟨pt_k, hy ▸ hs_sh_pt⟩⟩
  have hs_sh_sec : s_sh ≫ p_Vsh = 𝟙 S_k := by
    simpa only [s_sh, p_Vsh, h_V_sch, p_V₀, CategoryTheory.Category.assoc] using hs'₀_sec'
  have hs_sh_s₀ : s_sh ≫ h_Vsh_0 = s₀ :=
    hSectionEq p_V₀ (s_sh ≫ h_Vsh_0) s₀
      (by rw [CategoryTheory.Category.assoc]; exact hs_sh_sec)
      hs₀_sec
      (by
        change h_Vsh_0.base (s_sh.base pt_k) = s₀.base pt_k
        rw [hs_sh_pt, hs₀_pt]
        change j_V₁.base (h_V'.base (j_Vsh.base v_sh)) = P_cur.v
        rw [hv_sh_map, hv'₀_map, hv₁_map])

  let ι_C₀_sh : C₀.left ⟶ Y_sh :=
    hPb_Ysh_0.lift ι_C₀ (C₀.hom ≫ s_sh)
      (by rw [CategoryTheory.Category.assoc, hs_sh_s₀]; exact hPb_C₀.w)
  have hι_C₀_sh_fst : ι_C₀_sh ≫ h_Ysh_0 = ι_C₀ := hPb_Ysh_0.lift_fst _ _ _
  have hι_C₀_sh_snd : ι_C₀_sh ≫ f_sh = C₀.hom ≫ s_sh := hPb_Ysh_0.lift_snd _ _ _
  have hPb_C₀_sh : CategoryTheory.IsPullback ι_C₀_sh C₀.hom f_sh s_sh :=
    CategoryTheory.IsPullback.of_right
      (by rw [hι_C₀_sh_fst, hs_sh_s₀]; exact hPb_C₀)
      hι_C₀_sh_snd
      hPb_Ysh_0

  let ι_C'₀_mid0 : C'₀.left ⟶ Y_mid0 := ι_C'₀_Y ≫ q_mid
  have hPb_C'₀_mid0 : CategoryTheory.IsPullback ι_C'₀_mid0 C'₀.hom f_mid0 s_sh :=
    CategoryTheory.IsPullback.paste_horiz hPb_C'₀_Y hPb_Ymid

  have hν₀_hom : ν₀ ≫ C₀.hom = C'₀.hom := by
    have hC'_hom_Sk : (C'₀.hom : C'₀.left ⟶ S_k) = C'₀.hom := rfl
    calc
      ν₀ ≫ C₀.hom
        = ν₀ ≫ C₀.hom ≫ (s₀ ≫ p_V₀) := by rw [hs₀_sec, CategoryTheory.Category.comp_id]
      _ = ν₀ ≫ (C₀.hom ≫ s₀) ≫ p_V₀ := by simp only [CategoryTheory.Category.assoc]
      _ = (ν₀ ≫ ι_C₀) ≫ f₀ ≫ p_V₀ := by
            rw [← hPb_C₀.w]; simp only [f₀, CategoryTheory.Category.assoc]
      _ = ι_C'₀_Y ≫ (h_Y ≫ f₀) ≫ p_V₀ := by
            rw [← hComm_ν₀_Y]; simp only [CategoryTheory.Category.assoc]
      _ = (ι_C'₀_Y ≫ f_mid) ≫ h_V_sch ≫ p_V₀ := by
            dsimp only [f₀]; rw [hComm_mid]; simp only [CategoryTheory.Category.assoc]; rfl
      _ = C'₀.hom ≫ (s'₀_V'' ≫ h_V_sch ≫ p_V₀) := by
            rw [hPb_C'₀_Y.w]; simp only [CategoryTheory.Category.assoc]
      _ = C'₀.hom := by
            have h1 : s'₀_V'' ≫ h_V_sch ≫ p_V₀ = 𝟙 S_k := by
              simpa only [h_V_sch, p_V₀, CategoryTheory.Category.assoc] using hs'₀_sec'
            rw [h1, CategoryTheory.Category.comp_id]

  have hComm_mid0 : ι_C'₀_mid0 ≫ ν = ν₀ ≫ ι_C₀_sh := by
    apply hPb_Ysh_0.hom_ext
    · calc
        (ι_C'₀_mid0 ≫ ν) ≫ h_Ysh_0
          = ι_C'₀_Y ≫ h_Y := by
              dsimp only [ι_C'₀_mid0, h_Y]; simp only [CategoryTheory.Category.assoc]
        _ = ν₀ ≫ ι_C₀ := hComm_ν₀_Y
        _ = ν₀ ≫ (ι_C₀_sh ≫ h_Ysh_0) := by rw [hι_C₀_sh_fst]
        _ = (ν₀ ≫ ι_C₀_sh) ≫ h_Ysh_0 := (CategoryTheory.Category.assoc _ _ _).symm
    · calc
        (ι_C'₀_mid0 ≫ ν) ≫ f_sh
          = ι_C'₀_Y ≫ (q_mid ≫ f_mid0) := by
              dsimp only [ι_C'₀_mid0, f_mid0]; simp only [CategoryTheory.Category.assoc]
        _ = (ι_C'₀_Y ≫ f_mid) ≫ h_V'' := by
              rw [hPb_Ymid.w]; simp only [CategoryTheory.Category.assoc]
        _ = C'₀.hom ≫ s_sh := by
              rw [hPb_C'₀_Y.w]; dsimp only [s_sh]; simp only [CategoryTheory.Category.assoc]
        _ = (ν₀ ≫ C₀.hom) ≫ s_sh := by rw [hν₀_hom]
        _ = (ν₀ ≫ ι_C₀_sh) ≫ f_sh := by
              rw [CategoryTheory.Category.assoc, ← hι_C₀_sh_snd, CategoryTheory.Category.assoc]

  have hP_a_sh : ι_C₀_sh.base (P_pts a).1 = (τ_sh a).base v_sh := by
    let σ₀_a : S_k ⟶ C₀.left :=
      hPb_C₀.lift (s₀ ≫ P_cur.τ_bdry a) (𝟙 S_k)
        (by rw [CategoryTheory.Category.assoc, P_cur.hτ_sec a,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    haveI : AlgebraicGeometry.IsClosedImmersion s₀ := hClosedImmOfSection p_V₀ s₀ hs₀_sec
    haveI : AlgebraicGeometry.IsClosedImmersion ι_C₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_C₀.flip inferInstance
    have hσ₀_pt : σ₀_a.base pt_k = (P_pts a).1 := by
      apply ι_C₀.isClosedEmbedding.injective
      change (σ₀_a ≫ ι_C₀).base pt_k = ι_C₀.base (P_pts a).1
      rw [hPb_C₀.lift_fst, hP_bdry a]
      change (P_cur.τ_bdry a).base (s₀.base pt_k) = (P_cur.τ_bdry a).base P_cur.v
      rw [hs₀_pt]
    have hσ₀_comm : σ₀_a ≫ ι_C₀_sh = s_sh ≫ τ_sh a := by
      apply hPb_Ysh_0.hom_ext
      · rw [CategoryTheory.Category.assoc, hι_C₀_sh_fst, hPb_C₀.lift_fst, ← hs_sh_s₀]
        calc
          (s_sh ≫ h_Vsh_0) ≫ P_cur.τ_bdry a
            = s_sh ≫ h_Vsh_1 ≫ (j_V₁ ≫ P_cur.τ_bdry a) := by
                simp only [h_Vsh_0, CategoryTheory.Category.assoc]
          _ = s_sh ≫ (h_Vsh_1 ≫ τ₁ a) ≫ j_Y₁ := by
                rw [← (hτ₁_props a).2.2]; simp only [CategoryTheory.Category.assoc]
          _ = s_sh ≫ (τ_sh a ≫ h_Ysh_1) ≫ j_Y₁ := by rw [hτ_sh_fst a]
          _ = (s_sh ≫ τ_sh a) ≫ h_Ysh_0 := by
                simp only [h_Ysh_0, CategoryTheory.Category.assoc]
      · rw [CategoryTheory.Category.assoc, hι_C₀_sh_snd, ← CategoryTheory.Category.assoc σ₀_a,
          hPb_C₀.lift_snd, CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          hτ_sh_sec a, CategoryTheory.Category.comp_id]
    rw [← hσ₀_pt]
    change (σ₀_a ≫ ι_C₀_sh).base pt_k = (τ_sh a).base v_sh
    rw [hσ₀_comm]
    change (τ_sh a).base (s_sh.base pt_k) = (τ_sh a).base v_sh
    rw [hs_sh_pt]

  exact hStalk_ram s_sh C₀ C'₀ ι_C₀_sh ι_C'₀_mid0 ν₀ hs_sh_range hs_sh_sec
    hPb_C₀_sh hPb_C'₀_mid0 hComm_mid0 a hc_a (P_pts a).1 hP_a_sh x' hx'_cl hν₀_x'

theorem weil_rel_curve_cover_interior_section_chart_pullback (k : Type u) [Field k] [IsAlgClosed k]
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (P_N : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E) :
    ∃ (P : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
      (h_V : Quiver.Hom P.V P_N.V)
      (h_W : Quiver.Hom P.W P_N.W)
      (τ_int : Quiver.Hom ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left
        P.W_open.toScheme)
      (U₁ U₂ : P.Y.Opens)
      (g_sec : ↑(P.Y.presheaf.obj (Opposite.op U₁)))
      (u₁₂ : Units ↑(P.Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))),
      (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left.base P.v = P_N.v ∧
        CategoryTheory.CategoryStruct.comp h_W P_N.u_W = P.u_W ∧
        CategoryTheory.IsPullback
          (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map h_W).left)
          (CategoryTheory.CategoryStruct.comp P.e_W.hom
            (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
          (CategoryTheory.CategoryStruct.comp P_N.e_W.hom
            (CategoryTheory.CategoryStruct.comp P_N.W_open.ι P_N.f_bar))
          (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left)) ∧
      (CategoryTheory.CategoryStruct.comp τ_int
          (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar) =
        CategoryTheory.CategoryStruct.id
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left ∧
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι) ∧
        τ_int.base P.v = P.e_W.hom.base P.x) ∧
      (U₁ ≤ P.W_open ∧
        (U₂ : Set ↥P.Y) =
          (Set.range (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι).base)ᶜ ∧
        U₁ ⊔ U₂ = ⊤ ∧
        (P.Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
          (u₁₂ : ↑(P.Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) ∧
        ∀ (s_v : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
            ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left)
          (pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)))
          (C_v : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_Cv : Quiver.Hom C_v.left P.Y)
          (P_pt : ↥C_v.left)
          (hP_mem : P_pt ∈ (TopologicalSpace.Opens.map ι_Cv.base).obj U₁),
          CategoryTheory.CategoryStruct.comp s_v
              (CategoryTheory.CategoryStruct.comp
                ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).hom
                E.V_bar.hom) =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
          CategoryTheory.IsPullback ι_Cv C_v.hom P.f_bar s_v →
          ι_Cv.base P_pt =
            (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι).base (s_v.base pt_k) →
          Ideal.span {(C_v.left.presheaf.germ
              ((TopologicalSpace.Opens.map ι_Cv.base).obj U₁) P_pt hP_mem).hom
            ((ι_Cv.app U₁).hom g_sec)} =
            IsLocalRing.maximalIdeal ↑(C_v.left.presheaf.stalk P_pt)) :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k₀ : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot_all : ∀ pt : ↥S_k, (pt : PrimeSpectrum k).asIdeal = ⊥ := fun pt =>
    (Ideal.eq_bot_or_top (pt : PrimeSpectrum k).asIdeal).resolve_right
      (pt : PrimeSpectrum k).isPrime.ne_top
  have hpt_bot : (pt_k₀ : PrimeSpectrum k).asIdeal = ⊥ := rfl
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left

  
  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S U₁ U₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom) := by
      rw [hvw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom U₂.prop hEt_comp

  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W] (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k₀ = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_W : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_W (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_W]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_W = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_W (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_W (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_W) ≫ e_W.inv
