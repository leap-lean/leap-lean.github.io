          Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M₁)
            ((f₁_1 s * f₁_1 s') ^ (ℓ * e) * U₁_1 s)) ∧
        (∀ (r : Fin m₀) (s : Fin m₁),
          Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M₀₁)
            ((G₀₁_1 r s) ^ ℓ * ι1₁ (U₁_1 s)) =
