    intro ℓ _ A₀ A₁ A₀₁ _ _ _ ιA₀ ιA₁ Y_A j₀ j₁ _ _ hComm_j N hN U u g hCov hDiag hCocyc hPow
    classical
    have hℓ_two : 2 ≤ ℓ := Nat.Prime.two_le Fact.out
    have hRefine : ∀ (R : Type u) [CommRing R]
        (j : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y_A),
        ∃ (m : ℕ) (f q : Fin m → R) (α : Fin m → Fin N),
          1 ≤ m ∧
          (∑ r : Fin m, q r * f r) = 1 ∧
          (∀ (r : Fin m) (p : ↥(AlgebraicGeometry.Spec (CommRingCat.of R))),
            f r ∉ (p : PrimeSpectrum R).asIdeal → j.base p ∈ U (α r)) := by
      intro R _ j
      have hex_pt : ∀ p : PrimeSpectrum R,
          ∃ (a : Fin N) (f : R),
            p ∈ PrimeSpectrum.basicOpen f ∧
            ∀ q : PrimeSpectrum R, q ∈ PrimeSpectrum.basicOpen f →
              j.base (q : ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) ∈ U a := by
        intro p
        have hp_top : j.base (p : ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) ∈ (⊤ : Y_A.Opens) :=
          trivial
        rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hp_top
        rcases hp_top with ⟨a, ha⟩
        have hOpen_Va : IsOpen {q : PrimeSpectrum R |
            j.base (q : ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) ∈ U a} :=
          ((TopologicalSpace.Opens.map j.base).obj (U a)).isOpen
        have hp_nhds := IsOpen.mem_nhds hOpen_Va ha
        rcases (PrimeSpectrum.isBasis_basic_opens (R := R)).mem_nhds_iff.mp hp_nhds with
          ⟨B, ⟨_, ⟨f, rfl⟩, rfl⟩, hpB, hBV⟩
        exact ⟨a, f, hpB, fun q hq => hBV hq⟩
      choose a_pt f_pt hf_mem hf_sub using hex_pt
      obtain ⟨s, hs_cov⟩ := isCompact_univ.elim_finite_subcover
        (fun p : PrimeSpectrum R => (PrimeSpectrum.basicOpen (f_pt p) : Set (PrimeSpectrum R)))
        (fun p => (PrimeSpectrum.basicOpen (f_pt p)).isOpen)
        (fun p _ => Set.mem_iUnion.mpr ⟨p, hf_mem p⟩)
      by_cases hs : s.Nonempty
      · let m := Fintype.card ↥s
        have hm : 1 ≤ m := by
          dsimp [m]
          rw [Fintype.card_coe]
          exact Finset.card_pos.mpr hs
        let e_fin : Fin m ≃ ↥s := (Fintype.equivFin ↥s).symm
        let f : Fin m → R := fun r => f_pt (e_fin r).1
        let α : Fin m → Fin N := fun r => a_pt (e_fin r).1
        have hsup : (⨆ r : Fin m, PrimeSpectrum.basicOpen (f r)) = ⊤ := by
          rw [eq_top_iff]
          intro p _
          rcases Set.mem_iUnion₂.mp (hs_cov (Set.mem_univ p)) with ⟨x, hxs, hpx⟩
          refine TopologicalSpace.Opens.mem_iSup.mpr ⟨e_fin.symm ⟨x, hxs⟩, ?_⟩
          dsimp [f]
          rw [Equiv.apply_symm_apply]
          exact hpx
        have hspan : Ideal.span (Set.range f) = ⊤ :=
          PrimeSpectrum.iSup_basicOpen_eq_top_iff.mp hsup
        have h1 : (1 : R) ∈ Ideal.span (Set.range f) := by rw [hspan]; trivial
        obtain ⟨q, hq⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp h1
        simp only [smul_eq_mul] at hq
        exact ⟨m, f, q, α, hm, hq, fun r p hp => hf_sub (e_fin r).1 (p : PrimeSpectrum R) hp⟩
      · have hs_empty : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
        have hEmpty : IsEmpty (PrimeSpectrum R) :=
          ⟨fun p => by
            have hp := hs_cov (Set.mem_univ p)
            simp [hs_empty] at hp⟩
        have hSub : Subsingleton R := by
          refine ⟨fun x y => ?_⟩
          have h01 : (0 : R) = 1 := by
            by_contra h01
            have hbot : (⊥ : Ideal R) ≠ ⊤ := fun h => h01 ((Ideal.eq_top_iff_one ⊥).mp h).symm
            obtain ⟨𝔪, h𝔪_max, _⟩ := Ideal.exists_le_maximal ⊥ hbot
            let _ : 𝔪.IsPrime := h𝔪_max.isPrime
            exact hEmpty.false ⟨𝔪, inferInstance⟩
          calc
            x = x * 1 := (mul_one x).symm
            _ = x * 0 := by rw [← h01]
            _ = 0 := mul_zero x
            _ = y * 0 := (mul_zero y).symm
            _ = y * 1 := by rw [← h01]
            _ = y := mul_one y
        exact ⟨1, fun _ => 0, fun _ => 0, fun _ => ⟨0, by omega⟩,
          le_rfl, hSub.elim _ _, fun _ p => hEmpty.elim (p : PrimeSpectrum R)⟩
    obtain ⟨m₀, f₀, q₀, α₀, hm₀, hEq1, hSub_spec₀⟩ := hRefine A₀ j₀
    obtain ⟨m₁, f₁, q₁, α₁, hm₁, hEq2, hSub_spec₁⟩ := hRefine A₁ j₁
    let pullSec : ∀ (R : Type u) [CommRing R]
        (μ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y_A)
        (V : Y_A.Opens),
