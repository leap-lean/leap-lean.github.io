    rw [hpre]
    exact hq_cl.preimage e_W.hom.continuous

  let V_N : AlgebraicGeometry.Scheme.{u} := (Fgt_V.obj P_N.V).left
  let Z_N : AlgebraicGeometry.Scheme.{u} := (Fgt_Y.obj P_N.W).left
