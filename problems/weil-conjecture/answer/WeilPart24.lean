          (q.isPrime.mem_or_mem (hmul_zero ▸ q.asIdeal.zero_mem)).resolve_left hx_not_q
        rw [← hsum_one]
        exact J.add_mem (J.mul_mem_right _ hxJ) (hqJ he_mem_q)
