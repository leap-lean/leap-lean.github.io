        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_φ
      haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map iso_P.hom) :=
        ⟨⟨AlgebraicGeometry.Spec.map iso_P.inv,
          by rw [← AlgebraicGeometry.Spec.map_comp, iso_P.inv_hom_id, AlgebraicGeometry.Spec.map_id],
          by rw [← AlgebraicGeometry.Spec.map_comp, iso_P.hom_inv_id, AlgebraicGeometry.Spec.map_id]⟩⟩
      have hEt_comp : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom) ≫
            AlgebraicGeometry.Spec.map iso_P.hom) :=
        inferInstance
      rw [← AlgebraicGeometry.Spec.map_comp] at hEt_comp
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_comp

    let alg_PB : Algebra P B := φ₀.toRingHom.toAlgebra
    letI : Algebra P B := alg_PB
    haveI : IsScalarTower k P B := IsScalarTower.of_algebraMap_eq fun c => (φ₀.commutes c).symm
    haveI : Algebra.Etale P B := RingHom.etale_algebraMap.mp hEt_φ₀
    have hNoeth_B : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing P B
    haveI : IsNoetherianRing B := hNoeth_B

    have hσ_X : ∀ i : Fin d, σ (algebraMap P B (MvPolynomial.X i)) = 0 := by
      intro i
      change σ (φ (shift_sub (MvPolynomial.X i))) = 0
      dsimp [shift_sub]
      rw [MvPolynomial.aeval_X, map_sub, map_sub, ← MvPolynomial.algebraMap_eq,
        φ.commutes, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply]
      exact sub_self (a_pt i)

    let n_id : Ideal P := Ideal.span (Set.range (MvPolynomial.X : Fin d → P))
    have h_hom_mul :
        ∀ {p q : P} {s₁ s₂ : ℕ},
          (∀ j < s₁, MvPolynomial.homogeneousComponent j p = 0) →
          (∀ j < s₂, MvPolynomial.homogeneousComponent j q = 0) →
          ∀ j < s₁ + s₂, MvPolynomial.homogeneousComponent j (p * q) = 0 := by
      intro p q s₁ s₂ hp hq j hj
      conv_lhs =>
        rw [← MvPolynomial.sum_homogeneousComponent p,
            ← MvPolynomial.sum_homogeneousComponent q,
            Finset.sum_mul]
      rw [map_sum]
      refine Finset.sum_eq_zero fun m_deg _ => ?_
      rw [Finset.mul_sum, map_sum]
      refine Finset.sum_eq_zero fun l_deg _ => ?_
      by_cases hm_lt : m_deg < s₁
      · rw [hp m_deg hm_lt, zero_mul, map_zero]
      · by_cases hl_lt : l_deg < s₂
        · rw [hq l_deg hl_lt, mul_zero, map_zero]
        · have h_ml_hom : MvPolynomial.IsHomogeneous
              (MvPolynomial.homogeneousComponent m_deg p * MvPolynomial.homogeneousComponent l_deg q)
              (m_deg + l_deg) :=
            (MvPolynomial.homogeneousComponent_isHomogeneous m_deg p).mul
              (MvPolynomial.homogeneousComponent_isHomogeneous l_deg q)
          have h_mem_sub :
              MvPolynomial.homogeneousComponent m_deg p * MvPolynomial.homogeneousComponent l_deg q ∈
                MvPolynomial.homogeneousSubmodule (Fin d) k (m_deg + l_deg) := h_ml_hom
          rw [MvPolynomial.homogeneousComponent_of_mem h_mem_sub, if_neg (by omega)]

    let I_ge : ℕ → Ideal P := fun s =>
      { carrier := { p : P | ∀ j < s, MvPolynomial.homogeneousComponent j p = 0 }
        add_mem' := fun {p q} hp hq j hj => by
          change MvPolynomial.homogeneousComponent j (p + q) = 0
          rw [map_add, hp j hj, hq j hj, add_zero]
        zero_mem' := fun j _ => map_zero _
        smul_mem' := fun q {p} hp j hj =>
          h_hom_mul (s₁ := 0) (s₂ := s) (fun _ h0 => absurd h0 (Nat.not_lt_zero _)) hp j
            (by simpa using hj) }

    have hn_1 : n_id ≤ I_ge 1 := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩ j hj
      have hj0 : j = 0 := by omega
      subst hj0
      have hX_hom : MvPolynomial.IsHomogeneous (MvPolynomial.X i : P) 1 :=
        MvPolynomial.isHomogeneous_X k i
      have hX_mem : (MvPolynomial.X i : P) ∈ MvPolynomial.homogeneousSubmodule (Fin d) k 1 := hX_hom
      change MvPolynomial.homogeneousComponent 0 (MvPolynomial.X i : P) = 0
      rw [MvPolynomial.homogeneousComponent_of_mem hX_mem, if_neg (by omega)]

    have hn_le_Ige : ∀ s : ℕ, n_id ^ s ≤ I_ge s := by
      intro s
      induction s with
      | zero =>
        intro p _ j hj
        exact absurd hj (Nat.not_lt_zero _)
      | succ s ih =>
        rw [pow_succ, Submodule.mul_le]
        intro p hp q hq j hj
        exact h_hom_mul (ih hp) (hn_1 hq) j hj

    have h_hom_mem_pow : ∀ (m_deg : ℕ) (h : P),
        MvPolynomial.IsHomogeneous h m_deg → h ∈ n_id ^ m_deg := by
      intro m_deg h hh
      rw [MvPolynomial.as_sum h]
      refine Submodule.sum_mem (n_id ^ m_deg) fun v hv => ?_
      have hcoeff_ne : h.coeff v ≠ 0 := MvPolynomial.mem_support_iff.mp hv
      have hdeg_eq : (∑ i ∈ v.support, v i) = m_deg := by
        have hw := hh hcoeff_ne
        simpa [Finsupp.weight_apply, Finsupp.sum] using hw
      rw [MvPolynomial.monomial_eq]
      refine Ideal.mul_mem_left _ _ ?_
      rw [← hdeg_eq]
      change (∏ i ∈ v.support, (MvPolynomial.X i : P) ^ (v i)) ∈ n_id ^ (∑ i ∈ v.support, v i)
      have hprod_pow : ∀ S : Finset (Fin d),
          (∏ i ∈ S, (MvPolynomial.X i : P) ^ (v i)) ∈ n_id ^ (∑ i ∈ S, v i) := by
        intro S
        induction S using Finset.induction_on with
        | empty => simp
        | @insert i S hi_not ih =>
          rw [Finset.prod_insert hi_not, Finset.sum_insert hi_not, pow_add]
          have hXi_mem : (MvPolynomial.X i : P) ∈ Set.range (MvPolynomial.X : Fin d → P) := ⟨i, rfl⟩
          exact Ideal.mul_mem_mul
            (Ideal.pow_mem_pow (Ideal.subset_span hXi_mem) (v i)) ih
      exact hprod_pow v.support

    have hIge_le_n : ∀ s : ℕ, I_ge s ≤ n_id ^ s := by
      intro s p hp
      rw [← MvPolynomial.sum_homogeneousComponent p]
      refine Submodule.sum_mem (n_id ^ s) fun m_deg _ => ?_
      by_cases hm_lt : m_deg < s
      · rw [hp m_deg hm_lt]
        exact Submodule.zero_mem _
      · exact Ideal.pow_le_pow_right (by omega)
          (h_hom_mem_pow m_deg _ (MvPolynomial.homogeneousComponent_isHomogeneous m_deg p))

    let fac_step : ∀ r : ℕ, (P ⧸ n_id ^ (r + 2)) →ₐ[P] (P ⧸ n_id ^ (r + 1)) := fun r =>
      Ideal.Quotient.liftₐ (n_id ^ (r + 2)) (Ideal.Quotient.mkₐ P (n_id ^ (r + 1))) (by
        intro p hp
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_le_pow_right (by omega) hp))

    let Ψ_zero_k : B →ₐ[k] (P ⧸ n_id ^ 1) :=
      ((Ideal.Quotient.mkₐ k (n_id ^ 1)).comp (Algebra.ofId k P)).comp σ
    let Ψ_zero : B →ₐ[P] (P ⧸ n_id ^ 1) :=
      { toRingHom := Ψ_zero_k.toRingHom
        commutes' := by
          have h_eq : Ψ_zero_k.comp φ₀ = Ideal.Quotient.mkₐ k (n_id ^ 1) := by
            apply MvPolynomial.algHom_ext
            intro i
            change Ideal.Quotient.mk (n_id ^ 1) (MvPolynomial.C (σ (algebraMap P B (MvPolynomial.X i)))) =
              Ideal.Quotient.mk (n_id ^ 1) (MvPolynomial.X i)
            rw [hσ_X i, map_zero, map_zero]
            symm
            rw [pow_one, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.subset_span ⟨i, rfl⟩
          intro p
          exact AlgHom.congr_fun h_eq p }

    have h_lift_step : ∀ (r : ℕ) (ψ_r : B →ₐ[P] P ⧸ n_id ^ (r + 1)),
        ∃ ψ_succ : B →ₐ[P] P ⧸ n_id ^ (r + 2), (fac_step r).comp ψ_succ = ψ_r := by
      intro r ψ_r
      let Q_succ := P ⧸ n_id ^ (r + 2)
      let Q_curr := P ⧸ n_id ^ (r + 1)
      let K_r : Ideal Q_succ := RingHom.ker (fac_step r).toRingHom
      have hK_le : K_r ≤ Ideal.map (Ideal.Quotient.mk (n_id ^ (r + 2))) (n_id ^ (r + 1)) := by
        intro x hx
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hp_mem : p ∈ n_id ^ (r + 1) :=
          Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hx)
        exact Ideal.mem_map_of_mem _ hp_mem
      have hK_sq : K_r ^ 2 = ⊥ := by
        rw [eq_bot_iff]
        refine le_trans (Ideal.pow_right_mono hK_le 2) ?_
        rw [← Ideal.map_pow, ← pow_mul]
        rw [Ideal.map_le_iff_le_comap]
        intro p hp
        rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.pow_le_pow_right (by omega) hp
      let fwd_K : (Q_succ ⧸ K_r) →ₐ[P] Q_curr :=
        Ideal.Quotient.liftₐ K_r (fac_step r) (fun x hx => hx)
      have hfac_surj : Function.Surjective (fac_step r) := by
        intro y
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨Ideal.Quotient.mk (n_id ^ (r + 2)) p, rfl⟩
      have hfwd_bij : Function.Bijective fwd_K := by
        refine ⟨?_, ?_⟩
        · intro x y hxy
          obtain ⟨x₀, rfl⟩ := Ideal.Quotient.mk_surjective x
          obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective y
          have hsub : fac_step r (x₀ - y₀) = 0 := by
            rw [map_sub, sub_eq_zero]
            exact hxy
          exact Ideal.Quotient.eq.mpr hsub
        · intro y
          obtain ⟨x₀, rfl⟩ := hfac_surj y
          exact ⟨Ideal.Quotient.mk K_r x₀, rfl⟩
      let e_K : (Q_succ ⧸ K_r) ≃ₐ[P] Q_curr := AlgEquiv.ofBijective fwd_K hfwd_bij
      obtain ⟨ψ_succ, hψ_succ⟩ :=
        (Algebra.FormallyEtale.comp_bijective P B K_r hK_sq).2 (e_K.symm.toAlgHom.comp ψ_r)
      refine ⟨ψ_succ, ?_⟩
      ext b
      have h1 := AlgHom.congr_fun hψ_succ b
      have h2 : fwd_K (Ideal.Quotient.mk K_r (ψ_succ b)) = ψ_r b := by
        have h3 := congrArg e_K h1
        simpa [e_K] using h3
      exact h2

    let Ψ_seq : ∀ r : ℕ, B →ₐ[P] P ⧸ n_id ^ (r + 1) :=
      Nat.rec Ψ_zero (fun r ψ_r => Classical.choose (h_lift_step r ψ_r))
    have hΨ_step : ∀ r : ℕ, (fac_step r).comp (Ψ_seq (r + 1)) = Ψ_seq r :=
      fun r => Classical.choose_spec (h_lift_step r (Ψ_seq r))

    let fac_to_zero : ∀ r : ℕ, (P ⧸ n_id ^ (r + 1)) →ₐ[P] (P ⧸ n_id ^ 1) := fun r =>
      Ideal.Quotient.liftₐ (n_id ^ (r + 1)) (Ideal.Quotient.mkₐ P (n_id ^ 1)) (by
        intro p hp
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_le_pow_right (by omega) hp))
    have hΨ_to_zero : ∀ r : ℕ, (fac_to_zero r).comp (Ψ_seq r) = Ψ_zero := by
      intro r
      induction r with
      | zero =>
        ext b
        obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (Ψ_seq 0 b)
        change fac_to_zero 0 (Ψ_seq 0 b) = Ψ_seq 0 b
        rw [← hp]
        rfl
      | succ r ih =>
        have hfac_comp : (fac_to_zero r).comp (fac_step r) = fac_to_zero (r + 1) := by
          ext x
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
          rfl
        rw [← hfac_comp, AlgHom.comp_assoc, hΨ_step r, ih]

    have hΨ_pow_iff : ∀ (r : ℕ) (b : B) (p : P),
        Ψ_seq r b = Ideal.Quotient.mk (n_id ^ (r + 1)) p →
        ∀ s ≤ r + 1, b ∈ m ^ s ↔ p ∈ n_id ^ s := by
      intro r b p hbp
      let N := r + 1
      have hm_le_comap : m ≤ Ideal.comap (Ψ_seq r).toRingHom
          (Ideal.map (Ideal.Quotient.mk (n_id ^ N)) n_id) := by
        intro x hx
        have hx' : σ x = 0 := hx
        change Ψ_seq r x ∈ Ideal.map (Ideal.Quotient.mk (n_id ^ N)) n_id
        obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (Ψ_seq r x)
        rw [← hq]
        have h0 : fac_to_zero r (Ideal.Quotient.mk (n_id ^ N) q) = 0 := by
          rw [hq]
          change ((fac_to_zero r).comp (Ψ_seq r)) x = 0
          rw [hΨ_to_zero r]
          change Ideal.Quotient.mk (n_id ^ 1) (MvPolynomial.C (σ x)) = 0
          rw [hx', map_zero, map_zero]
        have hq_mem : q ∈ n_id ^ 1 := Ideal.Quotient.eq_zero_iff_mem.mp h0
        rw [pow_one] at hq_mem
        exact Ideal.mem_map_of_mem _ hq_mem
      have hm_pow_le : ∀ s : ℕ, m ^ s ≤ Ideal.comap (Ψ_seq r).toRingHom
          (Ideal.map (Ideal.Quotient.mk (n_id ^ N)) (n_id ^ s)) := by
        intro s
        induction s with
        | zero =>
          intro x _
          change Ψ_seq r x ∈ Ideal.map (Ideal.Quotient.mk (n_id ^ N)) (n_id ^ 0)
          obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (Ψ_seq r x)
          rw [← hq]
          refine Ideal.mem_map_of_mem _ ?_
          rw [pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        | succ s ih =>
          rw [pow_succ m s, pow_succ n_id s, Ideal.map_mul, Submodule.mul_le]
          intro x hx y hy
          rw [Ideal.mem_comap, map_mul]
          exact Ideal.mul_mem_mul (ih hx) (hm_le_comap hy)
      have hn_map_m : Ideal.map (algebraMap P B) n_id ≤ m := by
        rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        exact hσ_X i
      have hn_pow_map_m : ∀ s : ℕ, Ideal.map (algebraMap P B) (n_id ^ s) ≤ m ^ s := by
        intro s
        rw [Ideal.map_pow]
        exact Ideal.pow_right_mono hn_map_m s
      let Φ_N : (P ⧸ n_id ^ N) →ₐ[P] (B ⧸ m ^ N) :=
        Ideal.Quotient.liftₐ (n_id ^ N) (Ideal.Quotient.mkₐ P (m ^ N) |>.comp (Algebra.ofId P B)) (by
          intro q hq
          change Ideal.Quotient.mk (m ^ N) (algebraMap P B q) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem]
          exact hn_pow_map_m N (Ideal.mem_map_of_mem _ hq))
      let g₁ : B →ₐ[P] (B ⧸ m ^ N) := Φ_N.comp (Ψ_seq r)
      let g₂ : B →ₐ[P] (B ⧸ m ^ N) := Ideal.Quotient.mkₐ P (m ^ N)
      let J_N : Ideal (B ⧸ m ^ N) := Ideal.map (Ideal.Quotient.mk (m ^ N)) m
      have hNil_JN : IsNilpotent J_N := by
        refine ⟨N, ?_⟩
        rw [← Ideal.map_pow, Ideal.zero_eq_bot, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
      have hg_eq : g₁ = g₂ := by
        refine Algebra.FormallyUnramified.ext J_N hNil_JN fun x => ?_
        obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (Ψ_seq r x)
        have hq_sub : q - MvPolynomial.C (σ x) ∈ n_id := by
          have h1 : Ideal.Quotient.mk (n_id ^ 1) q =
              Ideal.Quotient.mk (n_id ^ 1) (MvPolynomial.C (σ x)) := by
            change fac_to_zero r (Ideal.Quotient.mk (n_id ^ N) q) = Ψ_zero x
            rw [hq, ← hΨ_to_zero r]
            rfl
          have h2 := Ideal.Quotient.eq.mp h1
          rwa [pow_one] at h2
        have halg_sub : algebraMap P B q - algebraMap k B (σ x) ∈ m := by
          have h_eq_c : algebraMap k B (σ x) = algebraMap P B (MvPolynomial.C (σ x)) :=
            IsScalarTower.algebraMap_apply k P B (σ x)
          rw [h_eq_c, ← map_sub]
          exact hn_map_m (Ideal.mem_map_of_mem _ hq_sub)
        have hx_sub : x - algebraMap k B (σ x) ∈ m := by
          change σ (x - algebraMap k B (σ x)) = 0
          rw [map_sub, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
        have hdiff_m : algebraMap P B q - x ∈ m := by
          have h_id : algebraMap P B q - x =
              (algebraMap P B q - algebraMap k B (σ x)) - (x - algebraMap k B (σ x)) := by ring
          rw [h_id]
          exact m.sub_mem halg_sub hx_sub
        have hg1_x : g₁ x = Ideal.Quotient.mk (m ^ N) (algebraMap P B q) := by
          change Φ_N (Ψ_seq r x) = _
          rw [← hq]
          rfl
        rw [hg1_x]
        exact Ideal.Quotient.eq.mpr (Ideal.mem_map_of_mem _ hdiff_m)
      intro s hs
      constructor
      · intro hb_s
        have hmem_map : Ideal.Quotient.mk (n_id ^ N) p ∈
            Ideal.map (Ideal.Quotient.mk (n_id ^ N)) (n_id ^ s) := by
          rw [← hbp]
          exact hm_pow_le s hb_s
        rcases (Ideal.mem_image_of_mem_map_of_surjective (Ideal.Quotient.mk (n_id ^ N))
          Ideal.Quotient.mk_surjective hmem_map) with ⟨q, hq_s, hqp⟩
        have hsub_N : p - q ∈ n_id ^ N := Ideal.Quotient.eq.mp hqp.symm
        have hp_eq : p = (p - q) + q := by ring
        rw [hp_eq]
        exact (n_id ^ s).add_mem (Ideal.pow_le_pow_right hs hsub_N) hq_s
      · intro hp_s
        have hmk_eq : Ideal.Quotient.mk (m ^ N) (algebraMap P B p) = Ideal.Quotient.mk (m ^ N) b := by
          have h1 : g₁ b = g₂ b := AlgHom.congr_fun hg_eq b
          have hg1_b : g₁ b = Ideal.Quotient.mk (m ^ N) (algebraMap P B p) := by
            change Φ_N (Ψ_seq r b) = _
            rw [hbp]
            rfl
          exact hg1_b.symm.trans h1
        have hsub_mN : b - algebraMap P B p ∈ m ^ N := Ideal.Quotient.eq.mp hmk_eq.symm
        have hb_eq : b = (b - algebraMap P B p) + algebraMap P B p := by ring
        rw [hb_eq]
        exact (m ^ s).add_mem (Ideal.pow_le_pow_right hs hsub_mN)
          (hn_pow_map_m s (Ideal.mem_map_of_mem _ hp_s))

    refine ⟨?_, hNoeth_B⟩
    let L := Localization.AtPrime m
    haveI : IsNoetherianRing L := IsLocalization.isNoetherianRing m.primeCompl L hNoeth_B
    let M_L : Ideal L := IsLocalRing.maximalIdeal L
    have hKrull : ⨅ i : ℕ, M_L ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing M_L (Ideal.IsMaximal.ne_top inferInstance)
    have h_not_all_pow : ∀ c : B, algebraMap B L c ≠ 0 → ∃ n : ℕ, c ∉ m ^ n := by
      intro c hc_ne
      by_contra h_all
      push_neg at h_all
      have hc_bot : algebraMap B L c ∈ (⨅ i : ℕ, M_L ^ i) := by
        rw [Ideal.mem_iInf]
        intro i
        have hm_map_ML : Ideal.map (algebraMap B L) m ≤ M_L := by
          rw [Ideal.map_le_iff_le_comap]
          intro x hx
          rw [Ideal.mem_comap]
          exact (IsLocalization.AtPrime.to_map_mem_maximal_iff L m x).mpr hx
        have hpow_le : Ideal.map (algebraMap B L) (m ^ i) ≤ M_L ^ i := by
          rw [Ideal.map_pow]
          exact Ideal.pow_right_mono hm_map_ML i
        exact hpow_le (Ideal.mem_map_of_mem _ (h_all i))
      rw [hKrull, Ideal.mem_bot] at hc_bot
      exact hc_ne hc_bot

    have hNoZeroDiv : NoZeroDivisors L := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra h_neither
      push_neg at h_neither
      rcases h_neither with ⟨hx_ne, hy_ne⟩
      obtain ⟨⟨a, u⟩, hx_sec⟩ := IsLocalization.surj m.primeCompl x
      obtain ⟨⟨b, v⟩, hy_sec⟩ := IsLocalization.surj m.primeCompl y
      have ha_ne : algebraMap B L a ≠ 0 := by
        intro h0
        rw [← hx_sec] at h0
        exact hx_ne ((IsLocalization.map_units L u).mul_left_eq_zero.mp h0)
      have hb_ne : algebraMap B L b ≠ 0 := by
        intro h0
        rw [← hy_sec] at h0
        exact hy_ne ((IsLocalization.map_units L v).mul_left_eq_zero.mp h0)
      have hab_zero : algebraMap B L (a * b) = 0 := by
        rw [map_mul, ← hx_sec, ← hy_sec]
        calc
          (x * algebraMap B L u) * (y * algebraMap B L v)
            = (x * y) * (algebraMap B L u * algebraMap B L v) := by ring
          _ = 0 := by rw [hxy, zero_mul]
      have hex_a := h_not_all_pow a ha_ne
      have hex_b := h_not_all_pow b hb_ne
      let n_a := Nat.find hex_a
      let n_b := Nat.find hex_b
      have hna_spec : a ∉ m ^ n_a := Nat.find_spec hex_a
      have hnb_spec : b ∉ m ^ n_b := Nat.find_spec hex_b
      have hna_pos : 0 < n_a := by
        by_contra h0
        have hna0 : n_a = 0 := by omega
        rw [hna0, pow_zero, Ideal.one_eq_top] at hna_spec
        exact hna_spec Submodule.mem_top
      have hnb_pos : 0 < n_b := by
        by_contra h0
        have hnb0 : n_b = 0 := by omega
        rw [hnb0, pow_zero, Ideal.one_eq_top] at hnb_spec
        exact hnb_spec Submodule.mem_top
      let d_a := n_a - 1
      let d_b := n_b - 1
      have hda_eq : d_a + 1 = n_a := by omega
      have hdb_eq : d_b + 1 = n_b := by omega
      have ha_in : a ∈ m ^ d_a := by
        by_contra hnot
        exact Nat.find_min hex_a (by omega : d_a < n_a) hnot
      have hb_in : b ∈ m ^ d_b := by
        by_contra hnot
        exact Nat.find_min hex_b (by omega : d_b < n_b) hnot
      have ha_out : a ∉ m ^ (d_a + 1) := hda_eq ▸ hna_spec
      have hb_out : b ∉ m ^ (d_b + 1) := hdb_eq ▸ hnb_spec

      let r := d_a + d_b
      let N := r + 1
      obtain ⟨p_a, hpa⟩ := Ideal.Quotient.mk_surjective (Ψ_seq r a)
      obtain ⟨p_b, hpb⟩ := Ideal.Quotient.mk_surjective (Ψ_seq r b)
      have hpa_in : p_a ∈ I_ge d_a :=
        hn_le_Ige d_a ((hΨ_pow_iff r a p_a hpa.symm d_a (by omega)).mp ha_in)
      have hpb_in : p_b ∈ I_ge d_b :=
        hn_le_Ige d_b ((hΨ_pow_iff r b p_b hpb.symm d_b (by omega)).mp hb_in)
      have hpa_out : p_a ∉ I_ge (d_a + 1) := fun hmem =>
        ha_out ((hΨ_pow_iff r a p_a hpa.symm (d_a + 1) (by omega)).mpr (hIge_le_n (d_a + 1) hmem))
      have hpb_out : p_b ∉ I_ge (d_b + 1) := fun hmem =>
        hb_out ((hΨ_pow_iff r b p_b hpb.symm (d_b + 1) (by omega)).mpr (hIge_le_n (d_b + 1) hmem))

      let H_a := MvPolynomial.homogeneousComponent d_a p_a
      let H_b := MvPolynomial.homogeneousComponent d_b p_b
      have hHa_ne : H_a ≠ 0 := by
        intro h0
        apply hpa_out
        intro j hj
        by_cases hjeq : j = d_a
        · subst hjeq; exact h0
        · exact hpa_in j (by omega)
      have hHb_ne : H_b ≠ 0 := by
        intro h0
        apply hpb_out
        intro j hj
        by_cases hjeq : j = d_b
        · subst hjeq; exact h0
        · exact hpb_in j (by omega)
      have hpa_rem : p_a - H_a ∈ I_ge (d_a + 1) := by
        intro j hj
        change MvPolynomial.homogeneousComponent j (p_a - H_a) = 0
        rw [map_sub]
        have hHa_mem : H_a ∈ MvPolynomial.homogeneousSubmodule (Fin d) k d_a :=
          MvPolynomial.homogeneousComponent_isHomogeneous d_a p_a
        rw [MvPolynomial.homogeneousComponent_of_mem hHa_mem]
        by_cases hjeq : j = d_a
        · subst hjeq; simp [H_a]
        · rw [if_neg hjeq, sub_zero]
          exact hpa_in j (by omega)
      have hpb_rem : p_b - H_b ∈ I_ge (d_b + 1) := by
        intro j hj
        change MvPolynomial.homogeneousComponent j (p_b - H_b) = 0
        rw [map_sub]
        have hHb_mem : H_b ∈ MvPolynomial.homogeneousSubmodule (Fin d) k d_b :=
          MvPolynomial.homogeneousComponent_isHomogeneous d_b p_b
        rw [MvPolynomial.homogeneousComponent_of_mem hHb_mem]
        by_cases hjeq : j = d_b
        · subst hjeq; simp [H_b]
        · rw [if_neg hjeq, sub_zero]
          exact hpb_in j (by omega)

      have hprod_comp : MvPolynomial.homogeneousComponent r (p_a * p_b) = H_a * H_b := by
        have hdecomp : p_a * p_b = H_a * H_b + (p_a - H_a) * p_b + H_a * (p_b - H_b) := by ring
        have hHa_in : H_a ∈ I_ge d_a := by
          intro j hj
          have hHa_mem : H_a ∈ MvPolynomial.homogeneousSubmodule (Fin d) k d_a :=
            MvPolynomial.homogeneousComponent_isHomogeneous d_a p_a
          change MvPolynomial.homogeneousComponent j H_a = 0
          rw [MvPolynomial.homogeneousComponent_of_mem hHa_mem, if_neg (by omega)]
        have hrem1 : MvPolynomial.homogeneousComponent r ((p_a - H_a) * p_b) = 0 :=
          h_hom_mul hpa_rem hpb_in r (by omega)
        have hrem2 : MvPolynomial.homogeneousComponent r (H_a * (p_b - H_b)) = 0 :=
          h_hom_mul hHa_in hpb_rem r (by omega)
        have hHH_mem : H_a * H_b ∈ MvPolynomial.homogeneousSubmodule (Fin d) k r :=
          (MvPolynomial.homogeneousComponent_isHomogeneous d_a p_a).mul
            (MvPolynomial.homogeneousComponent_isHomogeneous d_b p_b)
        rw [hdecomp, map_add, map_add, hrem1, hrem2, add_zero, add_zero,
          MvPolynomial.homogeneousComponent_of_mem hHH_mem, if_pos rfl]

      have hpab_not_Ige : p_a * p_b ∉ I_ge N := by
        intro hmem
        have h0 : MvPolynomial.homogeneousComponent r (p_a * p_b) = 0 := hmem r (by omega)
        rw [hprod_comp] at h0
        exact mul_ne_zero hHa_ne hHb_ne h0
      have hpab_not_n : p_a * p_b ∉ n_id ^ N := fun hmem => hpab_not_Ige (hn_le_Ige N hmem)
      have hΨ_ab : Ψ_seq r (a * b) = Ideal.Quotient.mk (n_id ^ N) (p_a * p_b) := by
        rw [map_mul, ← hpa, ← hpb, map_mul]
      have hab_not_m : a * b ∉ m ^ N := fun hmem =>
        hpab_not_n ((hΨ_pow_iff r (a * b) (p_a * p_b) hΨ_ab N le_rfl).mp hmem)

      obtain ⟨w, hw_ann⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl L (a * b)).mp hab_zero
      have hσw_ne : σ (w : B) ≠ 0 := fun h0 => w.2 h0
      let z : B := 1 - algebraMap k B (σ (w : B))⁻¹ * (w : B)
      have hz_m : z ∈ m := by
        change σ (1 - algebraMap k B (σ (w : B))⁻¹ * (w : B)) = 0
        rw [map_sub, map_one, map_mul, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply,
          inv_mul_cancel₀ hσw_ne, sub_self]
      have hz_fix : z * (a * b) = a * b := by
        dsimp [z]
        calc
          (1 - algebraMap k B (σ (w : B))⁻¹ * (w : B)) * (a * b)
            = a * b - algebraMap k B (σ (w : B))⁻¹ * ((w : B) * (a * b)) := by ring
          _ = a * b := by rw [hw_ann, mul_zero, sub_zero]
      have hz_pow_fix : ∀ k_pow : ℕ, z ^ k_pow * (a * b) = a * b := by
        intro k_pow
        induction k_pow with
        | zero => simp
        | succ k_pow ih =>
          rw [pow_succ, mul_assoc, hz_fix, ih]
      have hab_in_m : a * b ∈ m ^ N := by
        rw [← hz_pow_fix N]
        exact Ideal.mul_mem_right (a * b) (m ^ N) (Ideal.pow_mem_pow hz_m N)
      exact hab_not_m hab_in_m
    change IsDomain L
    exact
      { mul_left_cancel_of_ne_zero := fun {a} ha {b c} hab => by
          have hab' : a * b = a * c := hab
          have h0 : a * (b - c) = 0 := by rw [mul_sub, hab', sub_self]
          exact sub_eq_zero.mp ((hNoZeroDiv.eq_zero_or_eq_zero_of_mul_eq_zero h0).resolve_left ha)
        mul_right_cancel_of_ne_zero := fun {b} hb {a c} hab => by
          have hab' : a * b = c * b := hab
          have h0 : (a - c) * b = 0 := by rw [sub_mul, hab', sub_self]
          exact sub_eq_zero.mp ((hNoZeroDiv.eq_zero_or_eq_zero_of_mul_eq_zero h0).resolve_right hb)
        exists_pair_ne := (inferInstance : Nontrivial L).exists_pair_ne }

  have hDom_and_Noeth : IsDomain (Localization.AtPrime m₀) ∧ IsNoetherianRing B₀ := by
    have huAδ_k : u_A_δ ≫ (weilAffineSpaceOver k δ).hom = p_A_k := by
      have hw_gV : (Fgt_V.map P_N.g_V).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj E.V₁).hom =
          (Fgt_V.obj P_N.V).hom :=
        CategoryTheory.MorphismProperty.Over.w P_N.g_V
      dsimp [u_A_δ, p_A_k]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, E.hComp_uV₁,
        ← CategoryTheory.Category.assoc (Fgt_V.map P_N.g_V).left, hw_gV]
    have hφδ_comm_cat :
        CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin δ) k) ≫ φ_δ_cat = φ_kA := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hmap_φδ, hmap_kA]
      exact huAδ_k
    let φ_δ_alg : MvPolynomial (Fin δ) k →ₐ[k] A :=
      { toRingHom := φ_δ_cat.hom
        commutes' := fun c =>
          congrArg (fun g : CommRingCat.of k ⟶ A_cat => g.hom c) hφδ_comm_cat }
    haveI : IsScalarTower k A B₀ := IsScalarTower.of_algebraMap_eq fun c => by
      change algebraMap k B₀ c = q₀ (algebraMap A R (algebraMap k A c))
      rw [← IsScalarTower.algebraMap_apply k A R c]
      rfl
    let φ_B₀_alg : MvPolynomial (Fin δ) k →ₐ[k] B₀ :=
      (IsScalarTower.toAlgHom k A B₀).comp φ_δ_alg
    let alg_Pδ_A : Algebra (MvPolynomial (Fin δ) k) A := φ_δ_cat.hom.toAlgebra
    letI : Algebra (MvPolynomial (Fin δ) k) A := alg_Pδ_A
    haveI : Algebra.Etale (MvPolynomial (Fin δ) k) A := RingHom.etale_algebraMap.mp hEt_φδ
    let alg_Pδ_B₀ : Algebra (MvPolynomial (Fin δ) k) B₀ := φ_B₀_alg.toRingHom.toAlgebra
    letI : Algebra (MvPolynomial (Fin δ) k) B₀ := alg_Pδ_B₀
    haveI : IsScalarTower (MvPolynomial (Fin δ) k) A B₀ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale (MvPolynomial (Fin δ) k) B₀ :=
      Algebra.Etale.comp (MvPolynomial (Fin δ) k) A B₀
    have hEt_φB₀ : RingHom.Etale φ_B₀_alg.toRingHom :=
      RingHom.etale_algebraMap.mpr inferInstance
    exact hEt_mvPoly_local_domain δ B₀ φ_B₀_alg hEt_φB₀ σ_B₀

  haveI : IsDomain (Localization.AtPrime m₀) := hDom_and_Noeth.1
  haveI : IsNoetherianRing B₀ := hDom_and_Noeth.2
  let L₀ := Localization.AtPrime m₀
  let I_ker : Ideal B₀ := RingHom.ker (algebraMap B₀ L₀)
  obtain ⟨S_gen, hS_span⟩ := (isNoetherianRing_iff_ideal_fg B₀).mp inferInstance I_ker
  have hex_ann : ∀ g : ↥S_gen, ∃ u : ↥m₀.primeCompl, (u : B₀) * g.1 = 0 := by
    intro g
    have hg_ker : g.1 ∈ I_ker := by
      rw [← hS_span]
      exact Ideal.subset_span g.2
    exact (IsLocalization.map_eq_zero_iff m₀.primeCompl L₀ g.1).mp hg_ker
  let u_fn : ↥S_gen → ↥m₀.primeCompl := fun g => Classical.choose (hex_ann g)
  have hu_fn : ∀ g : ↥S_gen, (u_fn g : B₀) * g.1 = 0 :=
    fun g => Classical.choose_spec (hex_ann g)
  let s_sub : ↥m₀.primeCompl := ∏ g ∈ S_gen.attach, u_fn g
  let s_dom : B₀ := (s_sub : B₀)
  have hs_ann_ker : ∀ b ∈ I_ker, s_dom * b = 0 := by
    let J_ann : Ideal B₀ :=
      { carrier := {b : B₀ | s_dom * b = 0}
        add_mem' := fun {a b} ha hb => by dsimp at ha hb ⊢; rw [mul_add, ha, hb, add_zero]
        zero_mem' := mul_zero s_dom
        smul_mem' := fun c {b} hb => by
          change s_dom * b = 0 at hb
          change s_dom * (c * b) = 0
          rw [← mul_assoc, mul_comm s_dom c, mul_assoc, hb, mul_zero] }
    have hle_J : I_ker ≤ J_ann := by
      rw [← hS_span, Ideal.span_le]
      intro g hg
      change s_dom * g = 0
      obtain ⟨w, hw⟩ := Finset.dvd_prod_of_mem u_fn (Finset.mem_attach S_gen ⟨g, hg⟩)
      have hs_eq : s_dom = (u_fn ⟨g, hg⟩ : B₀) * (w : B₀) := congrArg Subtype.val hw
      rw [hs_eq, mul_comm (u_fn ⟨g, hg⟩ : B₀) (w : B₀), mul_assoc, hu_fn ⟨g, hg⟩, mul_zero]
    intro b hb
    exact hle_J hb

  let B_sec : Type u := Localization.Away s_dom
  have hDom_Bsec : IsDomain B_sec := by
    have hu_L₀ : IsUnit (algebraMap B₀ L₀ s_dom) := IsLocalization.map_units L₀ s_sub
    let ι_L : B_sec →+* L₀ := IsLocalization.Away.lift s_dom hu_L₀
    have hι_inj : Function.Injective ι_L := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨b, s_pow⟩, hsec⟩ := IsLocalization.surj (Submonoid.powers s_dom) x
      have hb_L₀ : algebraMap B₀ L₀ b = 0 := by
        have h1 : ι_L (x * algebraMap B₀ B_sec s_pow.1) = 0 := by
          rw [map_mul, hx, zero_mul]
        rw [hsec, IsLocalization.Away.lift_eq s_dom hu_L₀ b] at h1
        exact h1
      have hsb0 : s_dom * b = 0 := hs_ann_ker b hb_L₀
      have hmul0 : (x * algebraMap B₀ B_sec s_pow.1) * algebraMap B₀ B_sec s_dom = 0 := by
        rw [hsec, ← map_mul, mul_comm b s_dom, hsb0, map_zero]
      have hu1 : IsUnit (algebraMap B₀ B_sec s_pow.1) :=
        IsLocalization.map_units B_sec s_pow
      have hu2 : IsUnit (algebraMap B₀ B_sec s_dom) :=
        IsLocalization.Away.algebraMap_isUnit s_dom
      exact hu1.mul_left_eq_zero.mp (hu2.mul_left_eq_zero.mp hmul0)
    exact Function.Injective.isDomain ι_L hι_inj
  haveI : IsDomain B_sec := hDom_Bsec
  haveI : IsScalarTower k A B_sec := IsScalarTower.of_algebraMap_eq fun c => by
    rw [IsScalarTower.algebraMap_apply k B₀ B_sec c,
      IsScalarTower.algebraMap_apply k A B₀ c,
      ← IsScalarTower.algebraMap_apply A B₀ B_sec (algebraMap k A c)]
  haveI : Algebra.Etale B₀ B_sec := Algebra.Etale.of_isLocalizationAway s_dom
  haveI : Algebra.Etale A B_sec := Algebra.Etale.comp A B₀ B_sec

  let θ_R : R →ₐ[A] B_sec := (IsScalarTower.toAlgHom A B₀ B_sec).comp q₀
  have hθ_z₀ : θ_R z₀ = 0 := by
    dsimp [θ_R]
    have hq_z₀ : q₀ z₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [hq_z₀, map_zero]
  have hσ_sdom_ne : σ_B₀ s_dom ≠ 0 := by
    intro h0
    exact s_sub.2 (RingHom.mem_ker.mpr h0)
  let σ_B_ring : B_sec →+* k :=
    IsLocalization.Away.lift s_dom (g := σ_B₀.toRingHom) (Ne.isUnit hσ_sdom_ne)
  let σ_B : B_sec →ₐ[k] k :=
    { toRingHom := σ_B_ring
      commutes' := fun c => by
        change σ_B_ring (algebraMap k B_sec c) = c
        rw [IsScalarTower.algebraMap_apply k B₀ B_sec c,
          IsLocalization.Away.lift_eq s_dom (Ne.isUnit hσ_sdom_ne)]
        exact σ_B₀.commutes c }
  have hσ_θ : ∀ r : R, σ_B (θ_R r) = σ_R r := by
    intro r
    change σ_B_ring (algebraMap B₀ B_sec (q₀ r)) = σ_R r
    rw [IsLocalization.Away.lift_eq s_dom (Ne.isUnit hσ_sdom_ne)]
    exact Ideal.Quotient.lift_mk (Ideal.span ({z₀} : Set R)) σ_R.toRingHom hker_z₀

  
  have hEt_tensor_quot :
      ∀ (R₀ S₀ T₀ : Type u) [CommRing R₀] [CommRing S₀] [CommRing T₀]
        [Algebra R₀ S₀] [Algebra R₀ T₀] (z : T₀),
        Algebra.Etale R₀ (T₀ ⧸ Ideal.span ({z} : Set T₀)) →
        Algebra.Etale S₀
          ((TensorProduct R₀ S₀ T₀) ⧸
            Ideal.span ({(1 : S₀) ⊗ₜ[R₀] z} : Set (TensorProduct R₀ S₀ T₀))) := by
    intro R₀ S₀ T₀ _ _ _ _ _ z hEt_Q₀
    let Q₀ := T₀ ⧸ Ideal.span ({z} : Set T₀)
    haveI : Algebra.Etale R₀ Q₀ := hEt_Q₀
    haveI : Algebra.Etale S₀ (TensorProduct R₀ S₀ Q₀) := Algebra.Etale.baseChange R₀ Q₀ S₀
    let q_T₀ : T₀ →ₐ[R₀] Q₀ := Ideal.Quotient.mkₐ R₀ (Ideal.span ({z} : Set T₀))
    let Q_S := (TensorProduct R₀ S₀ T₀) ⧸
      Ideal.span ({(1 : S₀) ⊗ₜ[R₀] z} : Set (TensorProduct R₀ S₀ T₀))
    let q_ST : TensorProduct R₀ S₀ T₀ →ₐ[S₀] Q_S :=
      Ideal.Quotient.mkₐ S₀ (Ideal.span ({(1 : S₀) ⊗ₜ[R₀] z} : Set (TensorProduct R₀ S₀ T₀)))
    let T₀_to_QS : T₀ →ₐ[R₀] Q_S :=
      { toRingHom := q_ST.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom
        commutes' := fun r₀ => by
          change q_ST ((1 : S₀) ⊗ₜ[R₀] algebraMap R₀ T₀ r₀) = algebraMap R₀ Q_S r₀
          have htm : (1 : S₀) ⊗ₜ[R₀] algebraMap R₀ T₀ r₀ =
              (algebraMap R₀ S₀ r₀) ⊗ₜ[R₀] (1 : T₀) := by
            calc
              (1 : S₀) ⊗ₜ[R₀] algebraMap R₀ T₀ r₀
                = (1 : S₀) ⊗ₜ[R₀] (r₀ • (1 : T₀)) := by rw [Algebra.smul_def, mul_one]
              _ = (r₀ • (1 : S₀)) ⊗ₜ[R₀] (1 : T₀) :=
                  (TensorProduct.smul_tmul r₀ (1 : S₀) (1 : T₀)).symm
              _ = (algebraMap R₀ S₀ r₀) ⊗ₜ[R₀] (1 : T₀) := by rw [Algebra.smul_def, mul_one]
          rw [htm]
          exact q_ST.commutes (algebraMap R₀ S₀ r₀) }
    have hker_T₀ : Ideal.span ({z} : Set T₀) ≤ RingHom.ker T₀_to_QS.toRingHom :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (RingHom.mem_ker.mpr
        (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl))))
    let Q₀_to_QS : Q₀ →ₐ[R₀] Q_S :=
      Ideal.Quotient.liftₐ (Ideal.span ({z} : Set T₀)) T₀_to_QS hker_T₀
    let fwd_R₀ : TensorProduct R₀ S₀ Q₀ →ₐ[R₀] Q_S :=
      Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R₀ S₀ Q_S) Q₀_to_QS
    let fwd : TensorProduct R₀ S₀ Q₀ →ₐ[S₀] Q_S :=
      { toRingHom := fwd_R₀.toRingHom
        commutes' := fun s₀ => by
          change fwd_R₀ (s₀ ⊗ₜ[R₀] 1) = algebraMap S₀ Q_S s₀
          simp [fwd_R₀] }
    let map_ST : TensorProduct R₀ S₀ T₀ →ₐ[S₀] TensorProduct R₀ S₀ Q₀ :=
      Algebra.TensorProduct.map (AlgHom.id S₀ S₀) q_T₀
    have hker_ST : Ideal.span ({(1 : S₀) ⊗ₜ[R₀] z} : Set (TensorProduct R₀ S₀ T₀)) ≤
        RingHom.ker map_ST.toRingHom :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (RingHom.mem_ker.mpr (by
        change (1 : S₀) ⊗ₜ[R₀] q_T₀ z = 0
        have hqz : q_T₀ z = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [hqz, TensorProduct.tmul_zero])))
    let bwd : Q_S →ₐ[S₀] TensorProduct R₀ S₀ Q₀ :=
      Ideal.Quotient.liftₐ _ map_ST hker_ST
    have h_fb : bwd.comp fwd = AlgHom.id S₀ _ := by
      apply AlgHom.restrictScalars_injective R₀
      apply Algebra.TensorProduct.ext
      · ext s₀
        change bwd (fwd (algebraMap S₀ (TensorProduct R₀ S₀ Q₀) s₀)) =
          algebraMap S₀ (TensorProduct R₀ S₀ Q₀) s₀
        rw [fwd.commutes, bwd.commutes]
      · ext q_el
        obtain ⟨t₀, rfl⟩ := Ideal.Quotient.mk_surjective q_el
        change bwd (fwd (1 ⊗ₜ[R₀] q_T₀ t₀)) = 1 ⊗ₜ[R₀] q_T₀ t₀
        have hf1 : fwd (1 ⊗ₜ[R₀] q_T₀ t₀) = q_ST (1 ⊗ₜ[R₀] t₀) := by
          change fwd_R₀ (1 ⊗ₜ[R₀] q_T₀ t₀) = q_ST (1 ⊗ₜ[R₀] t₀)
          dsimp [fwd_R₀]
          rw [map_one, one_mul]
          exact Ideal.Quotient.lift_mk (Ideal.span ({z} : Set T₀)) T₀_to_QS.toRingHom hker_T₀
        rw [hf1]
        exact Ideal.Quotient.lift_mk _ map_ST.toRingHom hker_ST
    have h_bf : fwd.comp bwd = AlgHom.id S₀ _ := by
      ext w
      obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective w
      change fwd (map_ST u) = q_ST u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | tmul s₀ t₀ =>
        change fwd_R₀ (s₀ ⊗ₜ[R₀] q_T₀ t₀) = q_ST (s₀ ⊗ₜ[R₀] t₀)
        simp only [fwd_R₀, Algebra.TensorProduct.productMap_apply_tmul,
          IsScalarTower.toAlgHom_apply]
        have hq0 : Q₀_to_QS (q_T₀ t₀) = q_ST (1 ⊗ₜ[R₀] t₀) :=
          Ideal.Quotient.lift_mk _ T₀_to_QS.toRingHom hker_T₀
        rw [hq0, ← q_ST.commutes s₀, ← map_mul]
        congr 1
        change (s₀ ⊗ₜ[R₀] (1 : T₀)) * ((1 : S₀) ⊗ₜ[R₀] t₀) = s₀ ⊗ₜ[R₀] t₀
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y ihx ihy => rw [map_add, map_add, map_add, ihx, ihy]
    exact Algebra.Etale.of_equiv (AlgEquiv.ofAlgHom fwd bwd h_bf h_fb)

  let R_box : Type u := TensorProduct A B_sec R
  let g₀ : R_box := (1 : B_sec) ⊗ₜ[A] z₀
  let Q_ring : Type u := R_box ⧸ Ideal.span ({g₀} : Set R_box)
  have hEt_quot : Algebra.Etale B_sec Q_ring := hEt_tensor_quot A B_sec R z₀ hEt_AB₀
  haveI : Algebra.Etale B_sec Q_ring := hEt_quot

  
  let V_sec_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B_sec)
  have hInt_Vsec : AlgebraicGeometry.IsIntegral V_sec_sch := inferInstance
  haveI : AlgebraicGeometry.IsIntegral V_sec_sch := hInt_Vsec
  let q_sec : V_sec_sch ⟶ AlgebraicGeometry.Spec A_cat :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B_sec))
  have hEt_qsec : AlgebraicGeometry.Etale q_sec :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  haveI : AlgebraicGeometry.Etale q_sec := hEt_qsec
  let h_sec_sch : V_sec_sch ⟶ V_N := q_sec ≫ hAff_Vaff.fromSpec
  haveI : AlgebraicGeometry.Etale h_sec_sch := inferInstance

  let P_V : E.V_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (h_sec_sch ≫ (Fgt_V.obj P_N.V).hom) inferInstance
  let h_V : P_V ⟶ P_N.V := CategoryTheory.MorphismProperty.Over.homMk h_sec_sch rfl trivial
  let g_V_P : P_V ⟶ E.V₁ := h_V ≫ P_N.g_V
  haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj P_V).left := by
    change AlgebraicGeometry.IsAffine V_sec_sch
    infer_instance

  have hPV_k_eq : (Fgt_V.obj P_V).hom ≫ E.V_bar.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec)) := by
    change q_sec ≫ p_A_k = _
    rw [← hmap_kA, ← AlgebraicGeometry.Spec.map_comp]
    rfl
  let s_vsec : S_k ⟶ V_sec_sch :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B.toRingHom)
  let v_sec : ↥V_sec_sch := s_vsec.base pt_k₀
  have hs_vsec_sec : s_vsec ≫ ((Fgt_V.obj P_V).hom ≫ E.V_bar.hom) = 𝟙 S_k := by
    have h_lhs : s_vsec ≫ ((Fgt_V.obj P_V).hom ≫ E.V_bar.hom) =
        s_vsec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec)) :=
      congrArg (s_vsec ≫ ·) hPV_k_eq
    rw [h_lhs, ← AlgebraicGeometry.Spec.map_comp]
    have hcomp_id : CommRingCat.ofHom (algebraMap k B_sec) ≫
        CommRingCat.ofHom σ_B.toRingHom = 𝟙 (CommRingCat.of k) :=
      CommRingCat.hom_ext (RingHom.ext σ_B.commutes)
    rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
  have hv_cl_P : IsClosed ({v_sec} : Set ↥V_sec_sch) :=
    hClosedOfSection ((Fgt_V.obj P_V).hom ≫ E.V_bar.hom) s_vsec hs_vsec_sec

  let τ_tilde₀ : V_sec_sch ⟶ P_N.W_open.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_R.toRingHom) ≫ hAff_Uaff.fromSpec
  have hτ₀_sm : τ_tilde₀ ≫ h_sm = h_sec_sch := by
    dsimp [τ_tilde₀, h_sec_sch]
    rw [CategoryTheory.Category.assoc, ← hf₀_fromSpec, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp]
    congr 2
  have hs_vsec_τ₀ : s_vsec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_R.toRingHom) = s_U := by
    rw [← hmap_σR, ← AlgebraicGeometry.Spec.map_comp]
    exact congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext (RingHom.ext hσ_θ))
  have hτ₀_vsec : τ_tilde₀.base v_sec = y_N := by
    change ((s_vsec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_R.toRingHom)) ≫
      hAff_Uaff.fromSpec).base pt_k₀ = y_N
    rw [hs_vsec_τ₀]
    change hAff_Uaff.fromSpec.base (s_U.base pt_k₀) = y_N
    rw [hs_U_pt, hu_pt₀]
  have hh_sec_vsec : h_sec_sch.base v_sec = P_N.v := by
    rw [← hτ₀_sm]
    change h_sm.base (τ_tilde₀.base v_sec) = P_N.v
    rw [hτ₀_vsec]
    exact P_N.hx_fib
  have hv_map_P : (Fgt_V.map g_V_P).left.base v_sec = E.v₁ := by
    change (Fgt_V.map P_N.g_V).left.base (h_sec_sch.base v_sec) = E.v₁
    rw [hh_sec_vsec]
    exact P_N.hv_map

  let Y_P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback P_N.f_bar h_sec_sch
  let p_Y : Y_P ⟶ P_N.Y := CategoryTheory.Limits.pullback.fst P_N.f_bar h_sec_sch
  let f_P : Y_P ⟶ V_sec_sch := CategoryTheory.Limits.pullback.snd P_N.f_bar h_sec_sch
  have hPb_YP : CategoryTheory.IsPullback p_Y f_P P_N.f_bar h_sec_sch :=
    CategoryTheory.IsPullback.of_hasPullback P_N.f_bar h_sec_sch
  have hProp_fP : AlgebraicGeometry.IsProper f_P :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_YP P_N.hProp_f
  have hSm_fP : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_P :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_YP P_N.hSm_f
  haveI : AlgebraicGeometry.IsProper f_P := hProp_fP
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_P := hSm_fP

  let π_Y₁_P : Y_P ⟶ E.Y₁ := p_Y ≫ P_N.π_Y₁
  have hComm_Y₁_P : CategoryTheory.CategoryStruct.comp π_Y₁_P E.f_bar₁ =
      CategoryTheory.CategoryStruct.comp f_P (Fgt_V.map g_V_P).left := by
    change (p_Y ≫ P_N.π_Y₁) ≫ E.f_bar₁ = f_P ≫ (h_sec_sch ≫ (Fgt_V.map P_N.g_V).left)
    rw [CategoryTheory.Category.assoc, P_N.hComm_Y₁, ← CategoryTheory.Category.assoc,
      hPb_YP.w, CategoryTheory.Category.assoc]

  
  have hRelPullbackSq :
      ∀ {X₀ B₀_base Y₁ : AlgebraicGeometry.Scheme.{u}}
        (f_X₀ : X₀ ⟶ B₀_base) (g_N : V_N ⟶ B₀_base)
        (π_N : Y₁ ⟶ X₀) (f_N : Y₁ ⟶ V_N)
        (hComm_N : π_N ≫ f_X₀ = f_N ≫ g_N)
        (Y₂ : AlgebraicGeometry.Scheme.{u})
        (p_12 : Y₂ ⟶ Y₁) (f_2 : Y₂ ⟶ V_sec_sch)
        (hPb_12 : CategoryTheory.IsPullback p_12 f_2 f_N h_sec_sch)
        (hComm_2 : (p_12 ≫ π_N) ≫ f_X₀ = f_2 ≫ (h_sec_sch ≫ g_N)),
        ∃ q_rel : CategoryTheory.Limits.pullback f_X₀ (h_sec_sch ≫ g_N) ⟶
            CategoryTheory.Limits.pullback f_X₀ g_N,
          CategoryTheory.IsPullback p_12
            (CategoryTheory.Limits.pullback.lift (p_12 ≫ π_N) f_2 hComm_2)
            (CategoryTheory.Limits.pullback.lift π_N f_N hComm_N) q_rel := by
    intro X₀ B₀_base Y₁ f_X₀ g_N π_N f_N hComm_N Y₂ p_12 f_2 hPb_12 hComm_2
    let PB_N := CategoryTheory.Limits.pullback f_X₀ g_N
    let PB_2 := CategoryTheory.Limits.pullback f_X₀ (h_sec_sch ≫ g_N)
    let q_rel : PB_2 ⟶ PB_N :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f_X₀ (h_sec_sch ≫ g_N))
        (CategoryTheory.Limits.pullback.snd f_X₀ (h_sec_sch ≫ g_N) ≫ h_sec_sch)
        ((CategoryTheory.Limits.pullback.condition
            (f := f_X₀) (g := h_sec_sch ≫ g_N)).trans
          (CategoryTheory.Category.assoc _ _ _).symm)
    have hPb_q : CategoryTheory.IsPullback q_rel
        (CategoryTheory.Limits.pullback.snd f_X₀ (h_sec_sch ≫ g_N))
        (CategoryTheory.Limits.pullback.snd f_X₀ g_N) h_sec_sch :=
      CategoryTheory.IsPullback.of_right
        (by
          rw [CategoryTheory.Limits.pullback.lift_fst]
          exact CategoryTheory.IsPullback.of_hasPullback f_X₀ (h_sec_sch ≫ g_N))
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback f_X₀ g_N)
    let φ_2 := CategoryTheory.Limits.pullback.lift (p_12 ≫ π_N) f_2 hComm_2
    let φ_N := CategoryTheory.Limits.pullback.lift π_N f_N hComm_N
    have hcomm_top : p_12 ≫ φ_N = φ_2 ≫ q_rel := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [φ_N, φ_2, q_rel]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst]
      · dsimp only [φ_N, φ_2, q_rel]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hPb_12.w]
    refine ⟨q_rel, CategoryTheory.IsPullback.of_bot ?_ hcomm_top hPb_q⟩
    rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    exact hPb_12

  obtain ⟨q_rel_Y, hPb_rel_Y⟩ :=
    hRelPullbackSq E.f_bar₁ (Fgt_V.map P_N.g_V).left
      P_N.π_Y₁ P_N.f_bar P_N.hComm_Y₁ Y_P p_Y f_P hPb_YP hComm_Y₁_P
  haveI : AlgebraicGeometry.IsFinite
      (CategoryTheory.Limits.pullback.lift P_N.π_Y₁ P_N.f_bar P_N.hComm_Y₁) := P_N.hFin_rel
  haveI : AlgebraicGeometry.Surjective
      (CategoryTheory.Limits.pullback.lift P_N.π_Y₁ P_N.f_bar P_N.hComm_Y₁) := P_N.hSurj_rel
  have hFin_rel_P : AlgebraicGeometry.IsFinite
      (CategoryTheory.Limits.pullback.lift π_Y₁_P f_P hComm_Y₁_P) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_rel_Y P_N.hFin_rel
  have hSurj_rel_P : AlgebraicGeometry.Surjective
      (CategoryTheory.Limits.pullback.lift π_Y₁_P f_P hComm_Y₁_P) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_rel_Y P_N.hSurj_rel

  have hIrred_fib_P : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V_sec_sch),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_P s) := by
    intro Ω _ _ s
    have hPb_paste : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_P s ≫ p_Y)
        (CategoryTheory.Limits.pullback.snd f_P s)
        P_N.f_bar (s ≫ h_sec_sch) :=
      CategoryTheory.IsPullback.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f_P s) hPb_YP
    let e_fib : CategoryTheory.Limits.pullback f_P s ≅
        CategoryTheory.Limits.pullback P_N.f_bar (s ≫ h_sec_sch) :=
      hPb_paste.isoPullback
    have hIrred_N : IrreducibleSpace
        ↥(CategoryTheory.Limits.pullback P_N.f_bar (s ≫ h_sec_sch)) :=
      P_N.hIrred_fib Ω (s ≫ h_sec_sch)
    have huniv_im : (Set.univ : Set ↥(CategoryTheory.Limits.pullback f_P s)) =
        e_fib.inv.base '' Set.univ := by
      ext z
      simp only [Set.mem_univ, Set.mem_image, true_iff, true_and]
      refine ⟨e_fib.hom.base z, ?_⟩
      change (e_fib.hom ≫ e_fib.inv).base z = z
      rw [e_fib.hom_inv_id]
      rfl
    have hisIrred : IsIrreducible (Set.univ : Set ↥(CategoryTheory.Limits.pullback f_P s)) := by
      rw [huniv_im]
      exact hIrred_N.isIrreducible_univ.image e_fib.inv.base e_fib.inv.continuous.continuousOn
    obtain ⟨w₀⟩ := hIrred_N.toNonempty
    have hPre : PreirreducibleSpace ↥(CategoryTheory.Limits.pullback f_P s) :=
      ⟨hisIrred.isPreirreducible⟩
    exact @IrreducibleSpace.mk ↥(CategoryTheory.Limits.pullback f_P s) _ hPre
      ⟨e_fib.inv.base w₀⟩

  have hRelSmoothIsIntegral :
      ∀ (Y_s V_s : AlgebraicGeometry.Scheme.{u}) (f_s : Y_s ⟶ V_s)
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_s],
        AlgebraicGeometry.IsIntegral V_s →
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V_s),
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_s s)) →
        AlgebraicGeometry.IsIntegral Y_s := by
    intro Y_s V_s f_s hSm_fs hInt_Vs hIrred_fs
    haveI : AlgebraicGeometry.IsIntegral V_s := hInt_Vs
    have hOpen_fs : IsOpenMap f_s.base := by
      intro O hO
      rw [isOpen_iff_forall_mem_open]
      rintro _ ⟨y, hy_O, rfl⟩
      obtain ⟨U_V, hAff_UV, U_Y, hAff_UY, hy_UY, he_UV, hStd_y⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f_s).mp hSm_fs y
      obtain ⟨ψ_y, hψ_y_comp, hψ_y_et⟩ := hStd_y.exists_etale_mvPolynomial
      let A_V_cat := V_s.presheaf.obj (Opposite.op U_V)
      let R_Y_cat := Y_s.presheaf.obj (Opposite.op U_Y)
      let g_et_y : AlgebraicGeometry.Spec R_Y_cat ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) ↑A_V_cat)) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_y)
      have hEt_gy : AlgebraicGeometry.Etale g_et_y :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          hψ_y_et
      haveI : AlgebraicGeometry.Etale g_et_y := hEt_gy
      let p_poly_y : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) ↑A_V_cat)) ⟶
          AlgebraicGeometry.Spec A_V_cat :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
      have hFlat_py : AlgebraicGeometry.Flat p_poly_y :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
          (RingHom.flat_algebraMap_iff.mpr inferInstance)
      have hLFP_py : AlgebraicGeometry.LocallyOfFinitePresentation p_poly_y :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr
          (RingHom.finitePresentation_algebraMap.mpr inferInstance)
      haveI : AlgebraicGeometry.Flat p_poly_y := hFlat_py
      haveI : AlgebraicGeometry.LocallyOfFinitePresentation p_poly_y := hLFP_py
      haveI : AlgebraicGeometry.UniversallyOpen p_poly_y :=
        AlgebraicGeometry.UniversallyOpen.of_flat p_poly_y
      have hfac_y : (g_et_y ≫ p_poly_y) ≫ hAff_UV.fromSpec = hAff_UY.fromSpec ≫ f_s := by
        have h1 : g_et_y ≫ p_poly_y =
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.appLE f_s U_V U_Y he_UV) := by
          dsimp [g_et_y, p_poly_y]
          rw [← AlgebraicGeometry.Spec.map_comp]
          congr 1
          exact CommRingCat.hom_ext hψ_y_comp
        rw [h1]
        exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_s hAff_UV hAff_UY he_UV
      have hy_rng : y ∈ Set.range hAff_UY.fromSpec.base := by
        rw [hAff_UY.range_fromSpec]; exact hy_UY
      obtain ⟨u_y, hu_y⟩ := hy_rng
      let O_spec : Set ↥(AlgebraicGeometry.Spec R_Y_cat) := hAff_UY.fromSpec.base ⁻¹' O
      have hO_spec : IsOpen O_spec := hO.preimage hAff_UY.fromSpec.continuous
      let W_v : Set ↥V_s :=
        hAff_UV.fromSpec.base '' (p_poly_y.base '' (g_et_y.base '' O_spec))
      have hOpen_Wv : IsOpen W_v :=
        hAff_UV.fromSpec.isOpenEmbedding.isOpenMap _
          (p_poly_y.isOpenMap _ (g_et_y.isOpenMap _ hO_spec))
      refine ⟨W_v, ?_, hOpen_Wv, ?_⟩
      · rintro _ ⟨v₁, ⟨v₂, ⟨z, hz_O, rfl⟩, rfl⟩, rfl⟩
        refine ⟨hAff_UY.fromSpec.base z, hz_O, ?_⟩
        change (hAff_UY.fromSpec ≫ f_s).base z = ((g_et_y ≫ p_poly_y) ≫ hAff_UV.fromSpec).base z
        rw [hfac_y]
      · refine ⟨p_poly_y.base (g_et_y.base u_y), ⟨g_et_y.base u_y, ⟨u_y, ?_, rfl⟩, rfl⟩, ?_⟩
        · change hAff_UY.fromSpec.base u_y ∈ O
          rwa [hu_y]
        · change ((g_et_y ≫ p_poly_y) ≫ hAff_UV.fromSpec).base u_y = f_s.base y
          rw [hfac_y]
          change f_s.base (hAff_UY.fromSpec.base u_y) = f_s.base y
          rw [hu_y]
    have hIrred_Vs : IrreducibleSpace ↥V_s :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral V_s
    haveI : IrreducibleSpace ↥V_s := hIrred_Vs
    haveI : IrreducibleSpace ↥Y_s := by
      obtain ⟨v_init⟩ := hIrred_Vs.toNonempty
      let κ_init := V_s.residueField v_init
      let Ω_init : Type u := AlgebraicClosure ↑κ_init
      let s_init : AlgebraicGeometry.Spec (CommRingCat.of Ω_init) ⟶ V_s :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑κ_init) Ω_init)) ≫
          V_s.fromSpecResidueField v_init
      have hFib_init : IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_s s_init) :=
        hIrred_fs Ω_init s_init
      obtain ⟨z₀⟩ := hFib_init.toNonempty
      have hPre_Ys : PreirreducibleSpace ↥Y_s := by
        refine ⟨fun O₁ O₂ hO₁ hO₂ ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩ => ?_⟩
        obtain ⟨v₀, _, ⟨y₁', hy₁', hv₁⟩, ⟨y₂', hy₂', hv₂⟩⟩ :=
          hIrred_Vs.isIrreducible_univ.isPreirreducible
            (f_s.base '' O₁) (f_s.base '' O₂) (hOpen_fs O₁ hO₁) (hOpen_fs O₂ hO₂)
            ⟨f_s.base y₁, trivial, ⟨y₁, hy₁, rfl⟩⟩
            ⟨f_s.base y₂, trivial, ⟨y₂, hy₂, rfl⟩⟩
        let κ_v := V_s.residueField v₀
        let Ω_v : Type u := AlgebraicClosure ↑κ_v
        let s_v : AlgebraicGeometry.Spec (CommRingCat.of Ω_v) ⟶ V_s :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑κ_v) Ω_v)) ≫
            V_s.fromSpecResidueField v₀
        let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_v)) :=
          (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω_v)
        have hsv_pt : s_v.base pt_Ω = v₀ :=
          V_s.fromSpecResidueField_apply v₀ _
        obtain ⟨q₁, hq₁_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁' pt_Ω
            (hv₁.trans hsv_pt.symm)
        obtain ⟨q₂, hq₂_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₂' pt_Ω
            (hv₂.trans hsv_pt.symm)
        let fst_v := CategoryTheory.Limits.pullback.fst f_s s_v
        have hFib_v : IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_s s_v) :=
          hIrred_fs Ω_v s_v
        obtain ⟨q₀, _, hq₀_1, hq₀_2⟩ :=
          hFib_v.isIrreducible_univ.isPreirreducible
            (fst_v.base ⁻¹' O₁) (fst_v.base ⁻¹' O₂)
            (hO₁.preimage fst_v.continuous) (hO₂.preimage fst_v.continuous)
            ⟨q₁, trivial, by change fst_v.base q₁ ∈ O₁; rwa [hq₁_fst]⟩
            ⟨q₂, trivial, by change fst_v.base q₂ ∈ O₂; rwa [hq₂_fst]⟩
        exact ⟨fst_v.base q₀, trivial, hq₀_1, hq₀_2⟩
      exact @IrreducibleSpace.mk ↥Y_s _ hPre_Ys
        ⟨(CategoryTheory.Limits.pullback.fst f_s s_init).base z₀⟩
    haveI : ∀ y : ↥Y_s, IsReduced ↑(Y_s.presheaf.stalk y) := by
      intro y
      obtain ⟨U_V, hAff_UV, U_Y, hAff_UY, hy_UY, he_UV, hStd_y⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f_s).mp hSm_fs y
      obtain ⟨ψ_y, _, hψ_y_et⟩ := hStd_y.exists_etale_mvPolynomial
      let A_V : Type u := ↑(V_s.presheaf.obj (Opposite.op U_V))
      let R_Y : Type u := ↑(Y_s.presheaf.obj (Opposite.op U_Y))
      haveI : IsDomain A_V :=
        @AlgebraicGeometry.IsIntegral.component_integral V_s _ U_V
