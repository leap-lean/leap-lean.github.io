      ι_kum_Y₁ p_kum_Y₁ hp_Y₁ h0_Y₁ hSE_Y₁ φ_Y' hφ_Y' hφ_Y'_zero hW_cov

  exact ⟨V', h_V', v'₀, hAff_UW, hInt_UW, hEt_hV', hv'₀_cl, hv'₀_map, ξ_Y', hDiv_Y',
    hChar Y' W₁ W₂ hW_cov u_Y'_zar⟩

theorem weil_two_open_gm_injective_divisible_mv_lift (Y' : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ)
    (U'_in U'_out : Y'.Opens)
    (hU'_cov : U'_out ⊔ U'_in = ⊤)
    (hGmSheaf : CategoryTheory.Presheaf.IsSheaf Y'.smallEtaleTopology (weilEtaleGmPresheaf Y'))
    (u'_div : Units ↑(Y'.presheaf.obj (Opposite.op (U'_out ⊓ U'_in))))
    (ξ_Y' : (weilEtaleGmSheaf Y').H 1)
    (hDiv_ξ : ∃ η_Y' : (weilEtaleGmSheaf Y').H 1, ℓ • η_Y' = ξ_Y')
    (hChar_ξ :
      ∀ (K_sh Q_sh : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})
        (ι_0 : weilEtaleGmSheaf Y' ⟶ K_sh)
        (π_0 : K_sh ⟶ Q_sh)
        (h0_0 : ι_0 ≫ π_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact),
        let W₁₂ : Y'.Opens := U'_out ⊓ U'_in
        let V_W₁ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_out.ι
          (inferInstance : AlgebraicGeometry.Etale U'_out.ι)
        let V_W₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_in.ι
          (inferInstance : AlgebraicGeometry.Etale U'_in.ι)
        let V_W₁₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
          (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
        let j₁₂_₁ : V_W₁₂ ⟶ V_W₁ :=
          CategoryTheory.MorphismProperty.Over.homMk
            (Y'.homOfLE inf_le_left) (Y'.homOfLE_ι inf_le_left)
        let shAdj_Y' := CategoryTheory.sheafificationAdjunction
          Y'.smallEtaleTopology AddCommGrpCat.{u}
        let Fℤ_Y' := (CategoryTheory.constantSheaf
          Y'.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let u₁_Fℤ := fun (V : Y'.Etale) =>
          (((shAdj_Y'.unit.app
            ((CategoryTheory.Functor.const (Opposite Y'.Etale)).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (Opposite.op V)).hom (ULift.up (1 : ℤ)))
        let u_Y'_sh : ↥((weilEtaleGmSheaf Y').obj.obj (Opposite.op V_W₁₂)) :=
          (((shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')).app (Opposite.op V_W₁₂)).hom
            (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u'_div)))
        ∀ (s_lift : ↥(K_sh.obj.obj (Opposite.op V_W₁)))
          (f_q : Fℤ_Y' ⟶ Q_sh),
          (K_sh.obj.map j₁₂_₁.op).hom s_lift =
            (ι_0.hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh →
          (f_q.hom.app (Opposite.op V_W₁)).hom (u₁_Fℤ V_W₁) =
            (π_0.hom.app (Opposite.op V_W₁)).hom s_lift →
          (f_q.hom.app (Opposite.op V_W₂)).hom (u₁_Fℤ V_W₂) = 0 →
          ξ_Y' = (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1)) :
    let J := Y'.smallEtaleTopology
    let W₁₂ : Y'.Opens := U'_out ⊓ U'_in
    let V_W₁ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_out.ι
      (inferInstance : AlgebraicGeometry.Etale U'_out.ι)
    let V_W₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_in.ι
      (inferInstance : AlgebraicGeometry.Etale U'_in.ι)
    let V_W₁₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
      (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
    let j₁₂_₁ : V_W₁₂ ⟶ V_W₁ :=
      CategoryTheory.MorphismProperty.Over.homMk
        (Y'.homOfLE inf_le_left) (Y'.homOfLE_ι inf_le_left)
    let j₁₂_₂ : V_W₁₂ ⟶ V_W₂ :=
      CategoryTheory.MorphismProperty.Over.homMk
        (Y'.homOfLE inf_le_right) (Y'.homOfLE_ι inf_le_right)
    let shAdj_Y' := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let u_Y'_sh : ↥((weilEtaleGmSheaf Y').obj.obj (Opposite.op V_W₁₂)) :=
      (((shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')).app (Opposite.op V_W₁₂)).hom
        (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u'_div)))
    ∃ (I Q : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      (ι_inj : weilEtaleGmSheaf Y' ⟶ I)
      (π_inj : I ⟶ Q)
      (_ : CategoryTheory.Epi π_inj)
      (s_tilde₀ : ↥(I.obj.obj (Opposite.op V_W₂)))
      (s_tilde₁ : ↥(I.obj.obj (Opposite.op V_W₁)))
      (q_η : ∀ W : Y'.Etale, ↥(Q.obj.obj (Opposite.op W))),
      (∀ W : Y'.Etale,
        Function.Injective
          (((shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')).app (Opposite.op W) ≫
            ι_inj.hom.app (Opposite.op W)).hom)) ∧
      (∀ (W : Y'.Etale) (x : ↥(I.obj.obj (Opposite.op W))),
        (π_inj.hom.app (Opposite.op W)).hom x = 0 ↔
        ∃ u : ↥((weilEtaleGmPresheaf Y').obj (Opposite.op W)),
          (((shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')).app (Opposite.op W) ≫
            ι_inj.hom.app (Opposite.op W)).hom) u = x) ∧
      (∀ {W₁ W₂ : Y'.Etale} (g : W₁ ⟶ W₂), (Q.obj.map g.op).hom (q_η W₂) = q_η W₁) ∧
      (π_inj.hom.app (Opposite.op V_W₂)).hom s_tilde₀ = ℓ • q_η V_W₂ ∧
      (π_inj.hom.app (Opposite.op V_W₁)).hom s_tilde₁ = ℓ • q_η V_W₁ ∧
      (I.obj.map j₁₂_₁.op).hom s_tilde₁ - (I.obj.map j₁₂_₂.op).hom s_tilde₀ =
        (ι_inj.hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh :=
by
  classical
  intro J W₁₂ V_W₁ V_W₂ V_W₁₂ j₁₂_₁ j₁₂_₂ shAdj_Y' u_Y'_sh
  let G : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleGmSheaf Y'
  let I : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Injective.under G
  let ι_inj : G ⟶ I := CategoryTheory.Injective.ι G
  let Q : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel ι_inj
  let π_inj : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι_inj
  have h0_inj : ι_inj ≫ π_inj = 0 := CategoryTheory.Limits.cokernel.condition ι_inj
  have hSE_inj : (CategoryTheory.ShortComplex.mk ι_inj π_inj h0_inj).ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι_inj)
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let zHom : ∀ {M : AddCommGrpCat.{u}}, ↥M → (Aℤ ⟶ M) := fun {M} m =>
    AddCommGrpCat.ofHom
      { toFun := fun n => n.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }
  have hzHom_one : ∀ {M : AddCommGrpCat.{u}} (m : ↥M), (zHom m).hom (ULift.up 1) = m :=
    fun m => one_zsmul m
  have hzHom_comp : ∀ {M N : AddCommGrpCat.{u}} (m : ↥M) (φ : M ⟶ N),
      zHom m ≫ φ = zHom (φ.hom m) := by
    intro M N m φ
    ext ⟨n⟩
    exact map_zsmul φ.hom n m
  have hzHom_zero : ∀ {M : AddCommGrpCat.{u}}, zHom (0 : ↥M) = 0 := by
    intro M
    ext ⟨n⟩
    exact zsmul_zero n
  let u_sh := shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')
  have hu_sh_eq : u_sh = CategoryTheory.toSheafify J (weilEtaleGmPresheaf Y') :=
    CategoryTheory.sheafificationAdjunction_unit_app J (weilEtaleGmPresheaf Y')
  have : CategoryTheory.IsIso (CategoryTheory.toSheafify J (weilEtaleGmPresheaf Y')) :=
    CategoryTheory.isIso_toSheafify J hGmSheaf
  have : CategoryTheory.IsIso u_sh := hu_sh_eq.symm ▸ inferInstance
  have : (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).IsRightAdjoint :=
    shAdj_Y'.isRightAdjoint

  have hSecInj : ∀ W : Y'.Etale,
      Function.Injective ((u_sh.app (Opposite.op W) ≫ ι_inj.hom.app (Opposite.op W)).hom) := by
    intro W
    let EV : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite Y'.Etale) AddCommGrpCat.{u}).obj (Opposite.op W)
    have hMono_EV : CategoryTheory.Mono (ι_inj.hom.app (Opposite.op W)) := EV.map_mono ι_inj
    have hInj_ι : Function.Injective (ι_inj.hom.app (Opposite.op W)).hom :=
      (AddCommGrpCat.mono_iff_injective (ι_inj.hom.app (Opposite.op W))).mp hMono_EV
    have hInj_u : Function.Injective (u_sh.app (Opposite.op W)).hom :=
      (AddCommGrpCat.mono_iff_injective (u_sh.app (Opposite.op W))).mp inferInstance
    exact hInj_ι.comp hInj_u

  have hSecKer : ∀ (W : Y'.Etale) (x : ↥(I.obj.obj (Opposite.op W))),
      (π_inj.hom.app (Opposite.op W)).hom x = 0 ↔
      ∃ u : ↥((weilEtaleGmPresheaf Y').obj (Opposite.op W)),
        ((u_sh.app (Opposite.op W) ≫ ι_inj.hom.app (Opposite.op W)).hom) u = x := by
    intro W x
    constructor
    · intro hx
      let EV : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
          (CategoryTheory.evaluation (Opposite Y'.Etale) AddCommGrpCat.{u}).obj (Opposite.op W)
      have hLimW : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι (EV.map ι_inj)
            (by change (ι_inj ≫ π_inj).hom.app (Opposite.op W) = 0; rw [h0_inj]; rfl :
              EV.map ι_inj ≫ EV.map π_inj = 0)) :=
        CategoryTheory.Limits.isLimitForkMapOfIsLimit EV _ hSE_inj.fIsKernel
      have hzx : zHom x ≫ EV.map π_inj = zHom x ≫ 0 := by
        rw [CategoryTheory.Limits.comp_zero, hzHom_comp]
        change zHom ((π_inj.hom.app (Opposite.op W)).hom x) = 0
        rw [hx, hzHom_zero]
      let lift_x : Aℤ ⟶ G.obj.obj (Opposite.op W) :=
        CategoryTheory.Limits.Fork.IsLimit.lift hLimW (zHom x) hzx
      have hlift_x : lift_x ≫ EV.map ι_inj = zHom x :=
        CategoryTheory.Limits.Fork.IsLimit.lift_ι hLimW
      let y : ↥(G.obj.obj (Opposite.op W)) := lift_x.hom (ULift.up 1)
      refine ⟨(CategoryTheory.inv (u_sh.app (Opposite.op W))).hom y, ?_⟩
      have hy : (ι_inj.hom.app (Opposite.op W)).hom y = x := by
        have h1 := congrArg (fun φ : Aℤ ⟶ I.obj.obj (Opposite.op W) => φ.hom (ULift.up 1)) hlift_x
        change (ι_inj.hom.app (Opposite.op W)).hom y = (zHom x).hom (ULift.up 1) at h1
        rwa [hzHom_one] at h1
      calc
        ((u_sh.app (Opposite.op W) ≫ ι_inj.hom.app (Opposite.op W)).hom)
            ((CategoryTheory.inv (u_sh.app (Opposite.op W))).hom y)
          = (ι_inj.hom.app (Opposite.op W)).hom
              (((CategoryTheory.inv (u_sh.app (Opposite.op W)) ≫ u_sh.app (Opposite.op W)).hom) y) := rfl
        _ = (ι_inj.hom.app (Opposite.op W)).hom y := by
              rw [CategoryTheory.IsIso.inv_hom_id]; rfl
        _ = x := hy
    · rintro ⟨u, rfl⟩
      change ((u_sh.app (Opposite.op W) ≫ (ι_inj ≫ π_inj).hom.app (Opposite.op W)).hom) u = 0
      rw [h0_inj]
      rfl

  have hj₁₂_₁_mono : CategoryTheory.Mono j₁₂_₁ := by
    refine ⟨fun {Z} g₁ g₂ h => ?_⟩
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    have hleft : g₁.left ≫ Y'.homOfLE inf_le_left = g₂.left ≫ Y'.homOfLE inf_le_left :=
      congrArg (fun k : Z ⟶ V_W₁ => k.left) h
    exact (cancel_mono (Y'.homOfLE inf_le_left)).mp hleft

  let μ_pre' : CategoryTheory.Presheaf.freeYoneda V_W₁₂ Aℤ ⟶
      CategoryTheory.Presheaf.freeYoneda V_W₁ Aℤ :=
    CategoryTheory.Presheaf.freeYonedaHomEquiv.symm
      (CategoryTheory.Limits.Sigma.ι (fun _ : V_W₁₂ ⟶ V_W₁ => Aℤ) j₁₂_₁)

  have hMono_μ_app : ∀ Z : Opposite Y'.Etale, CategoryTheory.Mono (μ_pre'.app Z) := by
    intro Z
    let ret_Z : (CategoryTheory.Presheaf.freeYoneda V_W₁ Aℤ).obj Z ⟶
        (CategoryTheory.Presheaf.freeYoneda V_W₁₂ Aℤ).obj Z :=
      CategoryTheory.Limits.Sigma.desc fun (g : Z.unop ⟶ V_W₁) =>
        if hg : ∃ h : Z.unop ⟶ V_W₁₂, h ≫ j₁₂_₁ = g then
          CategoryTheory.Limits.Sigma.ι (fun _ : Z.unop ⟶ V_W₁₂ => Aℤ) (Classical.choose hg)
        else 0
    have hsplit : CategoryTheory.SplitMono (μ_pre'.app Z) :=
      { retraction := ret_Z
        id := by
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro h
          change (CategoryTheory.Limits.Sigma.ι (fun _ : Z.unop ⟶ V_W₁₂ => Aℤ) h ≫
              μ_pre'.app Z) ≫ ret_Z =
            CategoryTheory.Limits.Sigma.ι (fun _ : Z.unop ⟶ V_W₁₂ => Aℤ) h ≫ 𝟙 _
          have h_app : CategoryTheory.Limits.Sigma.ι (fun _ : Z.unop ⟶ V_W₁₂ => Aℤ) h ≫
              μ_pre'.app Z =
              CategoryTheory.Limits.Sigma.ι (fun _ : Z.unop ⟶ V_W₁ => Aℤ) (h ≫ j₁₂_₁) := by
            dsimp [μ_pre', CategoryTheory.Presheaf.freeYonedaHomEquiv]
            erw [CategoryTheory.Limits.Sigma.ι_comp_desc]
            rw [CategoryTheory.Presheaf.freeYoneda_map]
            erw [CategoryTheory.Limits.Sigma.ι_comp_map', CategoryTheory.Category.id_comp]
            rfl
          rw [h_app]
          dsimp [ret_Z]
          erw [CategoryTheory.Limits.Sigma.ι_comp_desc]
          rw [CategoryTheory.Category.comp_id]
          have hex : ∃ h' : Z.unop ⟶ V_W₁₂, h' ≫ j₁₂_₁ = h ≫ j₁₂_₁ := ⟨h, rfl⟩
          erw [dif_pos hex]
          congr 1
          exact hj₁₂_₁_mono.right_cancellation _ _ (Classical.choose_spec hex) }
    exact hsplit.mono

  have : CategoryTheory.Mono μ_pre' := CategoryTheory.NatTrans.mono_of_mono_app μ_pre'
  let μ : CategoryTheory.Sheaf.freeYoneda J V_W₁₂ Aℤ ⟶ CategoryTheory.Sheaf.freeYoneda J V_W₁ Aℤ :=
    (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map μ_pre'
  have : CategoryTheory.Mono μ :=
    (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map_mono μ_pre'

  let target_12 : Aℤ ⟶ I.obj.obj (Opposite.op V_W₁₂) :=
    zHom ((ι_inj.hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh)
  obtain ⟨α_lift, hα_lift⟩ :=
    CategoryTheory.Injective.factors (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm target_12) μ
  let s_lift : ↥(I.obj.obj (Opposite.op V_W₁)) :=
    (CategoryTheory.Sheaf.freeYonedaHomEquiv α_lift).hom (ULift.up 1)

  have hs_lift_res :
      (I.obj.map j₁₂_₁.op).hom s_lift = (ι_inj.hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh := by
    let β_pre : CategoryTheory.Presheaf.freeYoneda V_W₁ Aℤ ⟶ I.obj :=
      (shAdj_Y'.homEquiv (CategoryTheory.Presheaf.freeYoneda V_W₁ Aℤ) I) α_lift
    have hEquiv_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv (μ ≫ α_lift) = target_12 := by
      rw [hα_lift, Equiv.apply_symm_apply]
    have hμ_β : (shAdj_Y'.homEquiv (CategoryTheory.Presheaf.freeYoneda V_W₁₂ Aℤ) I) (μ ≫ α_lift) =
        μ_pre' ≫ β_pre :=
      shAdj_Y'.homEquiv_naturality_left μ_pre' α_lift
    have hβ_eta : β_pre = CategoryTheory.Presheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.Presheaf.freeYonedaHomEquiv β_pre) :=
      (Equiv.symm_apply_apply _ _).symm
    have hfree_eq : CategoryTheory.Presheaf.freeYonedaHomEquiv (μ_pre' ≫ β_pre) =
        CategoryTheory.Presheaf.freeYonedaHomEquiv β_pre ≫ I.obj.map j₁₂_₁.op := by
      rw [CategoryTheory.Presheaf.freeYonedaHomEquiv_comp]
      have hμ_app : CategoryTheory.Presheaf.freeYonedaHomEquiv μ_pre' =
          CategoryTheory.Limits.Sigma.ι (fun _ : V_W₁₂ ⟶ V_W₁ => Aℤ) j₁₂_₁ :=
        Equiv.apply_symm_apply _ _
      rw [hμ_app]
      conv_lhs => rw [hβ_eta]
      dsimp [CategoryTheory.Presheaf.freeYonedaHomEquiv]
      erw [CategoryTheory.Limits.Sigma.ι_comp_desc]
    have htarget_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv α_lift ≫ I.obj.map j₁₂_₁.op =
        target_12 := by
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv α_lift ≫ I.obj.map j₁₂_₁.op
          = CategoryTheory.Presheaf.freeYonedaHomEquiv (μ_pre' ≫ β_pre) := hfree_eq.symm
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (μ ≫ α_lift) := by
              change _ = CategoryTheory.Presheaf.freeYonedaHomEquiv
                ((shAdj_Y'.homEquiv _ I) (μ ≫ α_lift))
              rw [hμ_β]
        _ = target_12 := hEquiv_eq
    have h1 := congrArg (fun φ : Aℤ ⟶ I.obj.obj (Opposite.op V_W₁₂) => φ.hom (ULift.up 1)) htarget_eq
    simpa [s_lift, target_12, hzHom_one] using h1

  let T : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Y')
    (inferInstance : AlgebraicGeometry.Etale (𝟙 Y'))
  let toT : ∀ V : Y'.Etale, V ⟶ T := fun V =>
    CategoryTheory.MorphismProperty.Over.homMk V.hom (CategoryTheory.Category.comp_id V.hom)
  have htoT_uniq : ∀ {V : Y'.Etale} (g : V ⟶ T), g = toT V := by
    intro V g
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    have hw : g.left ≫ 𝟙 Y' = V.hom := CategoryTheory.MorphismProperty.Over.w g
    exact (CategoryTheory.Category.comp_id g.left).symm.trans hw

  let covX : Bool → Y'.Etale := fun b => cond b V_W₁ V_W₂
  let covF : ∀ b : Bool, covX b ⟶ T := fun b => toT (covX b)
  have hcov_mem : CategoryTheory.Sieve.ofArrows covX covF ∈ J T := by
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    change CategoryTheory.Sieve.ofArrows covX covF ∈
      AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y' T
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) Y' le_rfl]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) T _).mpr ?_
    intro y
    have hy_top : (y : ↥Y') ∈ (⊤ : Y'.Opens) := trivial
    rw [← hU'_cov] at hy_top
    rcases hy_top with hy_out | hy_in
    · exact ⟨covX true, covF true, ⟨y, hy_out⟩, CategoryTheory.Sieve.ofArrows_mk covX covF true,
        (inferInstance : AlgebraicGeometry.Etale U'_out.ι), rfl⟩
    · exact ⟨covX false, covF false, ⟨y, hy_in⟩, CategoryTheory.Sieve.ofArrows_mk covX covF false,
        (inferInstance : AlgebraicGeometry.Etale U'_in.ι), rfl⟩

  let famQ : ∀ b : Bool, Aℤ ⟶ Q.obj.obj (Opposite.op (covX b)) := fun b =>
    match b with
    | true => zHom ((π_inj.hom.app (Opposite.op V_W₁)).hom s_lift)
    | false => 0

  have hOver_true_false :
      ∀ {Z : Y'.Etale} (a : Z ⟶ V_W₁) (b : Z ⟶ V_W₂),
        zHom ((π_inj.hom.app (Opposite.op V_W₁)).hom s_lift) ≫ Q.obj.map a.op = 0 := by
    intro Z a b
    have hsch : a.left ≫ U'_out.ι = b.left ≫ U'_in.ι :=
      (CategoryTheory.MorphismProperty.Over.w a).trans
        (CategoryTheory.MorphismProperty.Over.w b).symm
    have hrange : Set.range ⇑(a.left ≫ U'_out.ι).base ⊆ Set.range ⇑W₁₂.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      have hout : (a.left ≫ U'_out.ι).base z ∈ (U'_out : Set ↥Y') :=
        AlgebraicGeometry.Scheme.Opens.range_ι (U := U'_out) ▸ ⟨a.left.base z, rfl⟩
      have hin : (a.left ≫ U'_out.ι).base z ∈ (U'_in : Set ↥Y') := by
        have hz_eq : (a.left ≫ U'_out.ι).base z = (b.left ≫ U'_in.ι).base z :=
          congrArg (fun f => f.base z) hsch
        rw [hz_eq]
        exact AlgebraicGeometry.Scheme.Opens.range_ι (U := U'_in) ▸ ⟨b.left.base z, rfl⟩
      exact ⟨hout, hin⟩
    let h_sch : Z.left ⟶ W₁₂.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W₁₂.ι (a.left ≫ U'_out.ι) hrange
    have hh_fac : h_sch ≫ W₁₂.ι = a.left ≫ U'_out.ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W₁₂.ι (a.left ≫ U'_out.ι) hrange
    have hh_hom : h_sch ≫ W₁₂.ι = Z.hom := by
      rw [hh_fac]
      exact CategoryTheory.MorphismProperty.Over.w a
    have hEt_h : AlgebraicGeometry.Etale h_sch :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        h_sch W₁₂.ι (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
        (hh_hom.symm ▸ Z.prop)
    let h_et : Z ⟶ V_W₁₂ := CategoryTheory.MorphismProperty.Over.homMk h_sch hh_hom
    have h_comp : h_et ≫ j₁₂_₁ = a := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply (cancel_mono U'_out.ι).mp
      change (h_sch ≫ Y'.homOfLE inf_le_left) ≫ U'_out.ι = a.left ≫ U'_out.ι
      rw [CategoryTheory.Category.assoc, Y'.homOfLE_ι inf_le_left]
      exact hh_fac
    rw [hzHom_comp]
    have hval0 : (Q.obj.map a.op).hom ((π_inj.hom.app (Opposite.op V_W₁)).hom s_lift) = 0 := by
      rw [← h_comp, CategoryTheory.op_comp, Q.obj.map_comp]
      change (Q.obj.map h_et.op).hom
        (((π_inj.hom.app (Opposite.op V_W₁) ≫ Q.obj.map j₁₂_₁.op).hom) s_lift) = 0
      rw [← π_inj.hom.naturality j₁₂_₁.op]
      change (Q.obj.map h_et.op).hom
        ((π_inj.hom.app (Opposite.op V_W₁₂)).hom ((I.obj.map j₁₂_₁.op).hom s_lift)) = 0
      rw [hs_lift_res]
      change (Q.obj.map h_et.op).hom
        (((ι_inj ≫ π_inj).hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh) = 0
      rw [h0_inj]
      exact map_zero _
    rw [hval0, hzHom_zero]

  have hfamQ_compat :
      ∀ ⦃W : Y'.Etale⦄ ⦃b₁ b₂ : Bool⦄ (a : W ⟶ covX b₁) (b : W ⟶ covX b₂),
        a ≫ covF b₁ = b ≫ covF b₂ →
        famQ b₁ ≫ Q.obj.map a.op = famQ b₂ ≫ Q.obj.map b.op := by
    intro W b₁ b₂ a b _
    cases b₁ <;> cases b₂
    · simp [famQ]
    · simp only [famQ, CategoryTheory.Limits.zero_comp]
      exact (hOver_true_false b a).symm
    · simp only [famQ, CategoryTheory.Limits.zero_comp]
      exact hOver_true_false a b
    · dsimp [covX, famQ] at a b ⊢
      have hab_eq : a = b := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (cancel_mono U'_out.ι).mp
          ((CategoryTheory.MorphismProperty.Over.w a).trans
            (CategoryTheory.MorphismProperty.Over.w b).symm)
      rw [hab_eq]

  let ψ_top : Aℤ ⟶ Q.obj.obj (Opposite.op T) :=
    Q.property.amalgamateOfArrows covF hcov_mem famQ hfamQ_compat
  have hψ_true : ψ_top ≫ Q.obj.map (toT V_W₁).op =
      zHom ((π_inj.hom.app (Opposite.op V_W₁)).hom s_lift) :=
    Q.property.amalgamateOfArrows_map covF hcov_mem famQ hfamQ_compat true
  have hψ_false : ψ_top ≫ Q.obj.map (toT V_W₂).op = 0 :=
    Q.property.amalgamateOfArrows_map covF hcov_mem famQ hfamQ_compat false

  let Pℤ := (CategoryTheory.Functor.const (Opposite Y'.Etale)).obj Aℤ
  let Fℤ_Y' := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
  let u₁_Fℤ : ∀ V : Y'.Etale, ↥(Fℤ_Y'.obj.obj (Opposite.op V)) := fun V =>
    (((shAdj_Y'.unit.app Pℤ).app (Opposite.op V)).hom (ULift.up (1 : ℤ)))
  let g_pre : Pℤ ⟶ Q.obj :=
    { app := fun V => ψ_top ≫ Q.obj.map (toT V.unop).op
      naturality := by
        intro V₁ V₂ f
        change 𝟙 Aℤ ≫ ψ_top ≫ Q.obj.map (toT V₂.unop).op =
          (ψ_top ≫ Q.obj.map (toT V₁.unop).op) ≫ Q.obj.map f
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, ← Q.obj.map_comp]
        have hop_eq : (toT V₁.unop).op ≫ f = (f.unop ≫ toT V₁.unop).op := rfl
        rw [hop_eq, htoT_uniq (f.unop ≫ toT V₁.unop)] }
  let f_q : Fℤ_Y' ⟶ Q := (shAdj_Y'.homEquiv Pℤ Q).symm g_pre
  have hf_q_unit : (shAdj_Y'.unit.app Pℤ) ≫ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map f_q = g_pre := by
    have h := shAdj_Y'.homEquiv_unit Pℤ Q f_q
    have h2 : shAdj_Y'.homEquiv Pℤ Q f_q = g_pre := Equiv.apply_symm_apply _ _
    exact h.symm.trans h2
  have hf_q_eval : ∀ V : Y'.Etale,
      (f_q.hom.app (Opposite.op V)).hom (u₁_Fℤ V) = (g_pre.app (Opposite.op V)).hom (ULift.up 1) := by
    intro V
    exact congrArg (fun η : Pℤ ⟶ Q.obj => (η.app (Opposite.op V)).hom (ULift.up 1)) hf_q_unit
  have hf_q_W₁ : (f_q.hom.app (Opposite.op V_W₁)).hom (u₁_Fℤ V_W₁) =
      (π_inj.hom.app (Opposite.op V_W₁)).hom s_lift := by
    rw [hf_q_eval V_W₁]
    change (ψ_top ≫ Q.obj.map (toT V_W₁).op).hom (ULift.up 1) = _
    rw [hψ_true, hzHom_one]
  have hf_q_W₂ : (f_q.hom.app (Opposite.op V_W₂)).hom (u₁_Fℤ V_W₂) = 0 := by
    rw [hf_q_eval V_W₂]
    change (ψ_top ≫ Q.obj.map (toT V_W₂).op).hom (ULift.up 1) = 0
    rw [hψ_false]
    rfl

  have hξ_eq : ξ_Y' = (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_inj.extClass (Nat.zero_add 1) :=
    hChar_ξ I Q ι_inj π_inj h0_inj hSE_inj s_lift f_q hs_lift_res hf_q_W₁ hf_q_W₂

  obtain ⟨η_Y', hη_div⟩ := hDiv_ξ
  have : Subsingleton (CategoryTheory.Abelian.Ext Fℤ_Y' I 1) :=
    CategoryTheory.Abelian.Ext.subsingleton_of_injective Fℤ_Y' I 0
  have hη_push : η_Y'.comp (CategoryTheory.Abelian.Ext.mk₀ ι_inj) (Nat.add_zero 1) = 0 :=
    Subsingleton.elim _ _
  obtain ⟨e_η, he_η⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Y' hSE_inj η_Y' hη_push (Nat.zero_add 1)
  let f_η : Fℤ_Y' ⟶ Q := CategoryTheory.Abelian.Ext.addEquiv₀ e_η
  have he_η_mk : CategoryTheory.Abelian.Ext.mk₀ f_η = e_η := by
    change CategoryTheory.Abelian.Ext.homEquiv₀.symm (CategoryTheory.Abelian.Ext.homEquiv₀ e_η) = e_η
    exact Equiv.symm_apply_apply _ _

  let δ_hom : (Fℤ_Y' ⟶ Q) →+ CategoryTheory.Abelian.Ext Fℤ_Y' G 1 :=
    (hSE_inj.extClass.postcomp Fℤ_Y' (Nat.zero_add 1)).comp
      CategoryTheory.Abelian.Ext.addEquiv₀.symm.toAddMonoidHom
  have hδ_apply : ∀ φ : Fℤ_Y' ⟶ Q,
      δ_hom φ = (CategoryTheory.Abelian.Ext.mk₀ φ).comp hSE_inj.extClass (Nat.zero_add 1) :=
    fun _ => rfl
  have hΔ_zero : (CategoryTheory.Abelian.Ext.mk₀ (ℓ • f_η - f_q)).comp hSE_inj.extClass (Nat.zero_add 1) = 0 := by
    rw [← hδ_apply, map_sub, map_nsmul, hδ_apply, hδ_apply, he_η_mk, he_η, ← hξ_eq, hη_div, sub_self]

  obtain ⟨e_corr, he_corr⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_Y' hSE_inj
      (CategoryTheory.Abelian.Ext.mk₀ (ℓ • f_η - f_q)) (Nat.zero_add 1) hΔ_zero
  let f_corr : Fℤ_Y' ⟶ I := CategoryTheory.Abelian.Ext.addEquiv₀ e_corr
  have he_corr_mk : CategoryTheory.Abelian.Ext.mk₀ f_corr = e_corr :=
    Equiv.symm_apply_apply CategoryTheory.Abelian.Ext.homEquiv₀ e_corr
  have hf_corr_π : f_corr ≫ π_inj = ℓ • f_η - f_q := by
    apply CategoryTheory.Abelian.Ext.homEquiv₀.symm.injective
    rw [CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
      CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, he_corr_mk]
    exact he_corr

  have hu₁_nat : ∀ {W₁ W₂ : Y'.Etale} (g : W₁ ⟶ W₂),
      (Fℤ_Y'.obj.map g.op).hom (u₁_Fℤ W₂) = u₁_Fℤ W₁ := by
    intro W₁ W₂ g
    have hnat := (shAdj_Y'.unit.app Pℤ).naturality g.op
    have h1 := congrArg (fun φ : Aℤ ⟶ Fℤ_Y'.obj.obj (Opposite.op W₁) => φ.hom (ULift.up 1)) hnat
    exact h1.symm

  let q_η : ∀ W : Y'.Etale, ↥(Q.obj.obj (Opposite.op W)) := fun W =>
    (f_η.hom.app (Opposite.op W)).hom (u₁_Fℤ W)
  let c_sec : ∀ W : Y'.Etale, ↥(I.obj.obj (Opposite.op W)) := fun W =>
    (f_corr.hom.app (Opposite.op W)).hom (u₁_Fℤ W)
  let s_tilde₀ : ↥(I.obj.obj (Opposite.op V_W₂)) := c_sec V_W₂
  let s_tilde₁ : ↥(I.obj.obj (Opposite.op V_W₁)) := s_lift + c_sec V_W₁

  have hq_nat : ∀ {W₁ W₂ : Y'.Etale} (g : W₁ ⟶ W₂), (Q.obj.map g.op).hom (q_η W₂) = q_η W₁ := by
    intro W₁ W₂ g
    have hnat := congrArg (fun φ => φ.hom (u₁_Fℤ W₂)) (f_η.hom.naturality g.op)
    change (f_η.hom.app (Opposite.op W₁)).hom ((Fℤ_Y'.obj.map g.op).hom (u₁_Fℤ W₂)) =
      (Q.obj.map g.op).hom (q_η W₂) at hnat
    rw [hu₁_nat g] at hnat
    exact hnat.symm

  have hc_nat : ∀ {W₁ W₂ : Y'.Etale} (g : W₁ ⟶ W₂), (I.obj.map g.op).hom (c_sec W₂) = c_sec W₁ := by
    intro W₁ W₂ g
    have hnat := congrArg (fun φ => φ.hom (u₁_Fℤ W₂)) (f_corr.hom.naturality g.op)
    change (f_corr.hom.app (Opposite.op W₁)).hom ((Fℤ_Y'.obj.map g.op).hom (u₁_Fℤ W₂)) =
      (I.obj.map g.op).hom (c_sec W₂) at hnat
    rw [hu₁_nat g] at hnat
    exact hnat.symm

  have hc_π : ∀ W : Y'.Etale,
      (π_inj.hom.app (Opposite.op W)).hom (c_sec W) =
        ℓ • q_η W - (f_q.hom.app (Opposite.op W)).hom (u₁_Fℤ W) := by
    intro W
    let evW : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite Y'.Etale) AddCommGrpCat.{u}).obj (Opposite.op W)
    have hmap : evW.map (f_corr ≫ π_inj) = ℓ • evW.map f_η - evW.map f_q := by
      rw [hf_corr_π, CategoryTheory.Functor.map_sub, CategoryTheory.Functor.map_nsmul]
    have hW := congrArg (fun φ : Fℤ_Y'.obj.obj (Opposite.op W) ⟶ Q.obj.obj (Opposite.op W) =>
      φ.hom (u₁_Fℤ W)) hmap
    exact hW

  refine ⟨I, Q, ι_inj, π_inj, inferInstance, s_tilde₀, s_tilde₁, q_η,
    hSecInj, hSecKer, @hq_nat, ?_, ?_, ?_⟩
  · change (π_inj.hom.app (Opposite.op V_W₂)).hom (c_sec V_W₂) = ℓ • q_η V_W₂
    rw [hc_π V_W₂, hf_q_W₂, sub_zero]
  · change (π_inj.hom.app (Opposite.op V_W₁)).hom (s_lift + c_sec V_W₁) = ℓ • q_η V_W₁
    rw [map_add, hc_π V_W₁, hf_q_W₁, add_sub_cancel]
  · dsimp [s_tilde₁, s_tilde₀]
    rw [map_add, hc_nat j₁₂_₁, hc_nat j₁₂_₂, add_sub_cancel_right, hs_lift_res]

theorem weil_etale_sheaf_epi_affine_product_cover_lift (Y' : AlgebraicGeometry.Scheme.{u})
    (I Q : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})
    (π_sh : I ⟶ Q) [CategoryTheory.Epi π_sh]
    (U : Y'.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
    (q_Spec : ↥(Q.obj.obj (Opposite.op
      (CategoryTheory.MorphismProperty.Over.mk ⊤ hAff.fromSpec
        (inferInstance : AlgebraicGeometry.Etale hAff.fromSpec) : Y'.Etale)))) :
    let R := ↑(Y'.presheaf.obj (Opposite.op U))
    let V_Spec : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ hAff.fromSpec
      (inferInstance : AlgebraicGeometry.Etale hAff.fromSpec)
    ∃ (S : Type u) (instComm : CommRing S) (instAlg : @Algebra R S _ instComm.toSemiring),
      letI : CommRing S := instComm
      letI : Algebra R S := instAlg
      Algebra.Etale R S ∧
      Module.FaithfullyFlat R S ∧
      let φ_S : Y'.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of S :=
        CommRingCat.ofHom (algebraMap R S)
      ∃ (hEt_S : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_S ≫ hAff.fromSpec)),
        let E_S : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (AlgebraicGeometry.Spec.map φ_S ≫ hAff.fromSpec) hEt_S
        let mor_S : E_S ⟶ V_Spec :=
          CategoryTheory.MorphismProperty.Over.homMk (AlgebraicGeometry.Spec.map φ_S) rfl
        ∃ (σ : ↥(I.obj.obj (Opposite.op E_S))),
          (π_sh.hom.app (Opposite.op E_S)).hom σ = (Q.obj.map mor_S.op).hom q_Spec :=
by
  classical
  intro R V_Spec
  let J := Y'.smallEtaleTopology
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let zHom : ∀ {M : AddCommGrpCat.{u}}, ↥M → (Aℤ ⟶ M) := fun {M} m =>
    AddCommGrpCat.ofHom
      { toFun := fun n => n.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }
  have hzHom_one : ∀ {M : AddCommGrpCat.{u}} (m : ↥M), (zHom m).hom (ULift.up 1) = m :=
    fun m => one_zsmul m
  have hzHom_comp : ∀ {M N : AddCommGrpCat.{u}} (m : ↥M) (φ : M ⟶ N),
      zHom m ≫ φ = zHom (φ.hom m) := by
    intro M N m φ
    ext ⟨n⟩
    exact map_zsmul φ.hom n m

  have hmem_J_iff : ∀ (X_et : Y'.Etale) (R_sieve : CategoryTheory.Sieve X_et),
      R_sieve ∈ J X_et ↔
        ∀ x : ↥X_et.left, ∃ (Y_et : Y'.Etale) (f_et : Y_et ⟶ X_et) (y : ↥Y_et.left),
          R_sieve.arrows f_et ∧ AlgebraicGeometry.Etale f_et.left ∧ f_et.left.base y = x := by
    intro X_et R_sieve
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    change R_sieve ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y' X_et ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) Y' le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) X_et R_sieve

  have hEmpty_sub : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (Z : Y'.Etale),
      IsEmpty ↥Z.left → Subsingleton ↥(F.obj.obj (Opposite.op Z)) := by
    intro F Z hEmp
    refine ⟨fun a b => ?_⟩
    let empX : Empty → Y'.Etale := Empty.elim
    let empF : ∀ i : Empty, empX i ⟶ Z := fun i => i.elim
    have hcov_emp : CategoryTheory.Sieve.ofArrows empX empF ∈ J Z :=
      (hmem_J_iff Z _).mpr (fun z => IsEmpty.elim hEmp z)
    have hEq_hom : zHom a = zHom b :=
      F.property.hom_ext_ofArrows empF hcov_emp (fun i => i.elim)
    have h1 := congrArg (fun φ : Aℤ ⟶ F.obj.obj (Opposite.op Z) => φ.hom (ULift.up 1)) hEq_hom
    simpa [hzHom_one] using h1

  have hLocSurj_sh : CategoryTheory.Sheaf.IsLocallySurjective π_sh :=
    (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π_sh).mpr inferInstance
  have : CategoryTheory.Presheaf.IsLocallySurjective J π_sh.hom := hLocSurj_sh
  have himg := (hmem_J_iff V_Spec _).mp (CategoryTheory.Presheaf.imageSieve_mem J π_sh.hom q_Spec)

  have hPtChart : ∀ p : PrimeSpectrum R,
      ∃ (B : Type u) (instC : CommRing B) (instA : @Algebra R B _ instC.toSemiring),
        letI : CommRing B := instC
        letI : Algebra R B := instA
        Algebra.Etale R B ∧
        (∃ q : PrimeSpectrum B, PrimeSpectrum.comap (algebraMap R B) q = p) ∧
        let φ_B : Y'.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of B :=
          CommRingCat.ofHom (algebraMap R B)
        ∃ (hEt_B : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_B ≫ hAff.fromSpec)),
          let E_B : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
            (AlgebraicGeometry.Spec.map φ_B ≫ hAff.fromSpec) hEt_B
          let mor_B : E_B ⟶ V_Spec :=
            CategoryTheory.MorphismProperty.Over.homMk (AlgebraicGeometry.Spec.map φ_B) rfl
          ∃ (s_B : ↥(I.obj.obj (Opposite.op E_B))),
            (π_sh.hom.app (Opposite.op E_B)).hom s_B = (Q.obj.map mor_B.op).hom q_Spec := by
    intro p
    obtain ⟨Y_p, f_p, y_p, ⟨s_p, hs_p⟩, hEt_fp, hy_p⟩ := himg p
    haveI : AlgebraicGeometry.Etale f_p.left := hEt_fp
    obtain ⟨W_p, hAff_Wp0, hy_Wp, -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y_p.left.isBasis_affineOpens)
        (show y_p ∈ (⊤ : Y_p.left.Opens) from trivial)
    have hAff_Wp : AlgebraicGeometry.IsAffineOpen W_p := hAff_Wp0
    let B_cat := Y_p.left.presheaf.obj (Opposite.op W_p)
    let B_p : Type u := ↑B_cat
    let g_p : AlgebraicGeometry.Spec B_cat ⟶
        AlgebraicGeometry.Spec (Y'.presheaf.obj (Opposite.op U)) :=
      hAff_Wp.fromSpec ≫ f_p.left
    have hEt_gp : AlgebraicGeometry.Etale g_p :=
      (inferInstance : AlgebraicGeometry.Etale (hAff_Wp.fromSpec ≫ f_p.left))
    let ψ_p : Y'.presheaf.obj (Opposite.op U) ⟶ B_cat :=
      AlgebraicGeometry.Spec.preimage g_p
    have hψ_map : AlgebraicGeometry.Spec.map ψ_p = g_p :=
      AlgebraicGeometry.Spec.map_preimage g_p
    have hEt_ψ : ψ_p.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hψ_map.symm ▸ hEt_gp)
    let instAlg_p : Algebra R B_p := ψ_p.hom.toAlgebra
    letI : Algebra R B_p := instAlg_p
    have hAlgEt_p : Algebra.Etale R B_p := RingHom.etale_algebraMap.mp hEt_ψ
    have hy_range : y_p ∈ Set.range ⇑hAff_Wp.fromSpec.base := by
      rw [hAff_Wp.range_fromSpec]
      exact hy_Wp
    obtain ⟨z_p, hz_p⟩ := hy_range
    have hcomap_z : PrimeSpectrum.comap (algebraMap R B_p) z_p = p := by
      change (AlgebraicGeometry.Spec.map ψ_p).base z_p = p
      rw [hψ_map]
      change f_p.left.base (hAff_Wp.fromSpec.base z_p) = p
      rw [hz_p]
      exact hy_p
    have hEt_B : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_p)) ≫ hAff.fromSpec) := by
      have : AlgebraicGeometry.Etale g_p := hEt_gp
      change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map ψ_p ≫ hAff.fromSpec)
      rw [hψ_map]
      infer_instance
    let E_Bp : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_p)) ≫ hAff.fromSpec) hEt_B
    have hw_comm : hAff_Wp.fromSpec ≫ Y_p.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_p)) ≫ hAff.fromSpec := by
      have h1 : (hAff_Wp.fromSpec ≫ f_p.left) ≫ hAff.fromSpec = hAff_Wp.fromSpec ≫ Y_p.hom :=
        (CategoryTheory.Category.assoc hAff_Wp.fromSpec f_p.left hAff.fromSpec).trans
          (congrArg (hAff_Wp.fromSpec ≫ ·) (CategoryTheory.MorphismProperty.Over.w f_p))
      have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_p)) ≫ hAff.fromSpec =
          (hAff_Wp.fromSpec ≫ f_p.left) ≫ hAff.fromSpec :=
        congrArg (· ≫ hAff.fromSpec) hψ_map
      exact h1.symm.trans h2.symm
    let w_p : E_Bp ⟶ Y_p := CategoryTheory.MorphismProperty.Over.homMk hAff_Wp.fromSpec hw_comm
    let s'_p : ↥(I.obj.obj (Opposite.op E_Bp)) := (I.obj.map w_p.op).hom s_p
    refine ⟨B_p, inferInstance, instAlg_p, hAlgEt_p, ⟨z_p, hcomap_z⟩, hEt_B, s'_p, ?_⟩
    have hnat := congrArg (fun φ => φ.hom s_p) (π_sh.hom.naturality w_p.op)
    change (I.obj.map w_p.op ≫ π_sh.hom.app (Opposite.op E_Bp)).hom s_p =
      (π_sh.hom.app (Opposite.op Y_p) ≫ Q.obj.map w_p.op).hom s_p at hnat
    dsimp [s'_p]
    refine hnat.trans ?_
    change (Q.obj.map w_p.op).hom ((π_sh.hom.app (Opposite.op Y_p)).hom s_p) = _
    rw [hs_p]
    change ((Q.obj.map f_p.op ≫ Q.obj.map w_p.op).hom) q_Spec = _
    rw [← Q.obj.map_comp, ← op_comp]
    have hwf : w_p ≫ f_p = CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_p))) rfl := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hψ_map.symm
    rw [hwf]

  let B_pt : PrimeSpectrum R → Type u := fun p => Classical.choose (hPtChart p)
  let instC_pt : ∀ p, CommRing (B_pt p) := fun p =>
    Classical.choose (Classical.choose_spec (hPtChart p))
  let instA_pt : ∀ p, @Algebra R (B_pt p) _ (instC_pt p).toSemiring := fun p =>
    Classical.choose (Classical.choose_spec (Classical.choose_spec (hPtChart p)))
  letI : ∀ p, CommRing (B_pt p) := instC_pt
  letI : ∀ p, Algebra R (B_pt p) := instA_pt
  have hSpec_pt := fun p =>
    Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hPtChart p)))

  let O_pt : PrimeSpectrum R → Set (PrimeSpectrum R) := fun p =>
    Set.range (PrimeSpectrum.comap (algebraMap R (B_pt p)))
  have hO_nhds : ∀ p : PrimeSpectrum R, O_pt p ∈ nhds p := by
    intro p
    obtain ⟨hEt_p, ⟨q_p, hq_p⟩, hEt_map_p, _⟩ := hSpec_pt p
    let φ_p : Y'.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of (B_pt p) :=
      CommRingCat.ofHom (algebraMap R (B_pt p))
    have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_p) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hEt_p)
    have hOpen : IsOpen (O_pt p) := by
      change IsOpen (Set.range ⇑(AlgebraicGeometry.Spec.map φ_p).base)
      exact (AlgebraicGeometry.Spec.map φ_p).isOpenMap.isOpen_range
    exact hOpen.mem_nhds ⟨q_p, hq_p⟩

  obtain ⟨F_pts, hF_cov⟩ := CompactSpace.elim_nhds_subcover O_pt hO_nhds
  let n : ℕ := Fintype.card ↥F_pts
  let e_fin : Fin n ≃ ↥F_pts := (Fintype.equivFin ↥F_pts).symm
  let B : Fin n → Type u := fun i => B_pt (e_fin i).1
  letI : ∀ i : Fin n, CommRing (B i) := fun i => instC_pt (e_fin i).1
  letI : ∀ i : Fin n, Algebra R (B i) := fun i => instA_pt (e_fin i).1
  have hEt_B : ∀ i : Fin n, Algebra.Etale R (B i) := fun i => (hSpec_pt (e_fin i).1).1

  let S : Type u := ∀ i : Fin n, B i
  have hEt_RS : Algebra.Etale R S :=
    { formallyEtale := inferInstance, finitePresentation := inferInstance }
  have : Algebra.Etale R S := hEt_RS
  have : Module.Flat R S := inferInstance
  have hFF_RS : Module.FaithfullyFlat R S := by
    apply Module.FaithfullyFlat.of_comap_surjective
    intro p
    have hp_mem : p ∈ ⋃ x ∈ F_pts, O_pt x := by
      rw [hF_cov]
      trivial
    rw [Set.mem_iUnion₂] at hp_mem
    obtain ⟨x, hx_mem, q_x, hq_x⟩ := hp_mem
    obtain ⟨i, hi⟩ := e_fin.surjective ⟨x, hx_mem⟩
    have hx_eq : x = (e_fin i).1 := (congrArg Subtype.val hi).symm
    clear hi hx_mem
    subst hx_eq
    refine ⟨PrimeSpectrum.comap (Pi.evalRingHom B i) q_x, ?_⟩
    rw [← PrimeSpectrum.comap_comp_apply]
    have hcomp_eq : (Pi.evalRingHom B i).comp (algebraMap R S) = algebraMap R (B i) := rfl
    rw [hcomp_eq]
    exact hq_x

  let φ_S : Y'.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of S :=
    CommRingCat.ofHom (algebraMap R S)
  haveI hEt_SpecS : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_S) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr hEt_RS)
  have hEt_S : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_S ≫ hAff.fromSpec) :=
    inferInstance
  let E_S : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (AlgebraicGeometry.Spec.map φ_S ≫ hAff.fromSpec) hEt_S

  let E_Bi : ∀ i : Fin n, Y'.Etale := fun i =>
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (B i))) ≫ hAff.fromSpec)
      (Classical.choose (hSpec_pt (e_fin i).1).2.2)
  let σ_i : ∀ i : Fin n, ↥(I.obj.obj (Opposite.op (E_Bi i))) := fun i =>
    Classical.choose (Classical.choose_spec (hSpec_pt (e_fin i).1).2.2)
  let mor_Bi : ∀ i : Fin n, E_Bi i ⟶ V_Spec := fun i =>
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (B i)))) rfl
  have hσ_i : ∀ i : Fin n,
      (π_sh.hom.app (Opposite.op (E_Bi i))).hom (σ_i i) =
        (Q.obj.map (mor_Bi i).op).hom q_Spec :=
    fun i => Classical.choose_spec (Classical.choose_spec (hSpec_pt (e_fin i).1).2.2)

  let ev_hom : ∀ i : Fin n, CommRingCat.of S ⟶ CommRingCat.of (B i) := fun i =>
    CommRingCat.ofHom (Pi.evalRingHom B i)
  have hev_surj : ∀ i : Fin n, Function.Surjective (Pi.evalRingHom B i) := by
    intro i b
    exact ⟨Pi.single i b, Pi.single_eq_same i b⟩
  have hev_comp : ∀ i : Fin n,
      AlgebraicGeometry.Spec.map (ev_hom i) ≫ AlgebraicGeometry.Spec.map φ_S =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (B i))) := by
    intro i
    rw [← AlgebraicGeometry.Spec.map_comp]
    rfl
  have hEt_evi : ∀ i : Fin n, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (ev_hom i)) := by
    intro i
    have hEt_Bi : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (B i)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr (hEt_B i))
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      (AlgebraicGeometry.Spec.map (ev_hom i)) (AlgebraicGeometry.Spec.map φ_S)
      hEt_SpecS ((hev_comp i).symm ▸ hEt_Bi)
  let ι_i : ∀ i : Fin n, E_Bi i ⟶ E_S := fun i =>
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (ev_hom i))
      ((CategoryTheory.Category.assoc
        (AlgebraicGeometry.Spec.map (ev_hom i))
        (AlgebraicGeometry.Spec.map φ_S) hAff.fromSpec).symm.trans
        (congrArg (· ≫ hAff.fromSpec) (hev_comp i)))
  have hMono_ιi : ∀ i : Fin n, CategoryTheory.Mono (ι_i i) := by
    intro i
    have : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map (ev_hom i)) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (ev_hom i) (hev_surj i)
    refine ⟨fun {Z} g₁ g₂ h => ?_⟩
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    have hleft : g₁.left ≫ AlgebraicGeometry.Spec.map (ev_hom i) =
        g₂.left ≫ AlgebraicGeometry.Spec.map (ev_hom i) :=
      congrArg (fun k : Z ⟶ E_S => k.left) h
    exact (cancel_mono (AlgebraicGeometry.Spec.map (ev_hom i))).mp hleft

  have hcov_S : CategoryTheory.Sieve.ofArrows E_Bi ι_i ∈ J E_S := by
    refine (hmem_J_iff E_S _).mpr ?_
    intro p_S
    let p_S' : PrimeSpectrum S := p_S
    haveI hp_prime : p_S'.asIdeal.IsPrime := p_S'.isPrime
    have hsum_one : (∑ i : Fin n, Pi.single i (1 : B i) : S) = 1 := by
      ext j
      change (∑ i : Fin n, Pi.single i (1 : B i)) j = (1 : B j)
      rw [Finset.sum_apply, Finset.sum_eq_single j
        (fun i _ hij => Pi.single_eq_of_ne (Ne.symm hij) (1 : B i))
        (fun h => False.elim (h (Finset.mem_univ j))), Pi.single_eq_same]
    have hex_i : ∃ i : Fin n, Pi.single i (1 : B i) ∉ p_S'.asIdeal := by
      by_contra hall
      push_neg at hall
      apply hp_prime.one_notMem
      rw [← hsum_one]
      exact Ideal.sum_mem p_S'.asIdeal (fun i _ => hall i)
    obtain ⟨i, hi_notMem⟩ := hex_i
    have hker_le : RingHom.ker (Pi.evalRingHom B i) ≤ p_S'.asIdeal := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      have hmul0 : x * Pi.single i (1 : B i) = 0 := by
        ext j
        change x j * (Pi.single i (1 : B i)) j = 0
        by_cases hj : j = i
        · subst hj
          rw [Pi.single_eq_same, mul_one]
          exact hx
        · rw [Pi.single_eq_of_ne hj, mul_zero]
      have hmem0 : x * Pi.single i (1 : B i) ∈ p_S'.asIdeal := by
        rw [hmul0]
        exact p_S'.asIdeal.zero_mem
      exact (hp_prime.mem_or_mem hmem0).resolve_right hi_notMem
    have hq_prime : (Ideal.map (Pi.evalRingHom B i) p_S'.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective (hev_surj i) hker_le
    let q_Bi : PrimeSpectrum (B i) := ⟨Ideal.map (Pi.evalRingHom B i) p_S'.asIdeal, hq_prime⟩
    refine ⟨E_Bi i, ι_i i, q_Bi, CategoryTheory.Sieve.ofArrows_mk E_Bi ι_i i, hEt_evi i, ?_⟩
    change PrimeSpectrum.comap (Pi.evalRingHom B i) q_Bi = p_S'
    ext1
    change Ideal.comap (Pi.evalRingHom B i) (Ideal.map (Pi.evalRingHom B i) p_S'.asIdeal) =
      p_S'.asIdeal
    rw [Ideal.comap_map_of_surjective' (Pi.evalRingHom B i) (hev_surj i), sup_eq_left]
    exact hker_le

  let famI : ∀ i : Fin n, Aℤ ⟶ I.obj.obj (Opposite.op (E_Bi i)) := fun i => zHom (σ_i i)
  have hfamI_compat :
      ∀ ⦃W : Y'.Etale⦄ ⦃i j : Fin n⦄ (a : W ⟶ E_Bi i) (b : W ⟶ E_Bi j),
        a ≫ ι_i i = b ≫ ι_i j →
        famI i ≫ I.obj.map a.op = famI j ≫ I.obj.map b.op := by
    intro W i j a b hab
    by_cases hij : i = j
    · subst hij
      have hab_eq : a = b := (hMono_ιi i).right_cancellation a b hab
      rw [hab_eq]
    · have hEmp : IsEmpty ↥W.left := by
        refine ⟨fun w => ?_⟩
        have hpt : (a ≫ ι_i i).left.base w = (b ≫ ι_i j).left.base w := by rw [hab]
        change PrimeSpectrum.comap (Pi.evalRingHom B i) (a.left.base w) =
          PrimeSpectrum.comap (Pi.evalRingHom B j) (b.left.base w) at hpt
        have hmem_j : Pi.single i (1 : B i) ∈
            (PrimeSpectrum.comap (Pi.evalRingHom B j) (b.left.base w)).asIdeal := by
          change Pi.evalRingHom B j (Pi.single i (1 : B i)) ∈ (b.left.base w).asIdeal
          simp [Pi.single_eq_of_ne (Ne.symm hij)]
        rw [← hpt] at hmem_j
        change Pi.evalRingHom B i (Pi.single i (1 : B i)) ∈ (a.left.base w).asIdeal at hmem_j
        rw [Pi.evalRingHom_apply, Pi.single_eq_same] at hmem_j
        exact (a.left.base w).isPrime.one_notMem hmem_j
      haveI : Subsingleton ↥(I.obj.obj (Opposite.op W)) := hEmpty_sub I W hEmp
      rw [hzHom_comp, hzHom_comp]
      congr 1
      exact Subsingleton.elim _ _

  let ψ_S : Aℤ ⟶ I.obj.obj (Opposite.op E_S) :=
    I.property.amalgamateOfArrows ι_i hcov_S famI hfamI_compat
  let σ : ↥(I.obj.obj (Opposite.op E_S)) := ψ_S.hom (ULift.up 1)
  have hσ_res : ∀ i : Fin n, (I.obj.map (ι_i i).op).hom σ = σ_i i := by
    intro i
    have hi := I.property.amalgamateOfArrows_map ι_i hcov_S famI hfamI_compat i
    have h1 := congrArg (fun φ : Aℤ ⟶ I.obj.obj (Opposite.op (E_Bi i)) => φ.hom (ULift.up 1)) hi
    change (I.obj.map (ι_i i).op).hom σ = (zHom (σ_i i)).hom (ULift.up 1) at h1
    rwa [hzHom_one] at h1

  refine ⟨S, inferInstance, inferInstance, hEt_RS, hFF_RS, hEt_S, σ, ?_⟩
  let g_S : E_S ⟶ V_Spec :=
    CategoryTheory.MorphismProperty.Over.homMk (AlgebraicGeometry.Spec.map φ_S) rfl
  have hEq_Q :
      zHom ((π_sh.hom.app (Opposite.op E_S)).hom σ) =
        zHom ((Q.obj.map g_S.op).hom q_Spec) := by
    apply Q.property.hom_ext_ofArrows ι_i hcov_S
    intro i
    rw [hzHom_comp, hzHom_comp]
    congr 1
    have hnat := congrArg (fun φ => φ.hom σ) (π_sh.hom.naturality (ι_i i).op)
    change (I.obj.map (ι_i i).op ≫ π_sh.hom.app (Opposite.op (E_Bi i))).hom σ =
      (π_sh.hom.app (Opposite.op E_S) ≫ Q.obj.map (ι_i i).op).hom σ at hnat
    refine hnat.symm.trans ?_
    change (π_sh.hom.app (Opposite.op (E_Bi i))).hom ((I.obj.map (ι_i i).op).hom σ) =
      ((Q.obj.map g_S.op ≫ Q.obj.map (ι_i i).op).hom) q_Spec
    rw [hσ_res i, hσ_i i, ← Q.obj.map_comp, ← op_comp]
    have hcomp_i : ι_i i ≫ g_S = mor_Bi i := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hev_comp i
    rw [hcomp_i]
  have h1 := congrArg (fun φ : Aℤ ⟶ Q.obj.obj (Opposite.op E_S) => φ.hom (ULift.up 1)) hEq_Q
  simpa [hzHom_one] using h1

theorem weil_two_open_affine_etale_cocycle_from_sheaf_lifts (Y' : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ)
    (U'_in U'_out : Y'.Opens)
    (hAff_in : AlgebraicGeometry.IsAffineOpen U'_in)
    (hAff_out : AlgebraicGeometry.IsAffineOpen U'_out)
    (hAff_ov : AlgebraicGeometry.IsAffineOpen (U'_out ⊓ U'_in))
    (u'_div : Units ↑(Y'.presheaf.obj (Opposite.op (U'_out ⊓ U'_in))))
    (I Q : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})
    (ι_inj : weilEtaleGmSheaf Y' ⟶ I)
    (π_inj : I ⟶ Q)
    (s_tilde₀ : ↥(I.obj.obj (Opposite.op
      (CategoryTheory.MorphismProperty.Over.mk ⊤ U'_in.ι
        (inferInstance : AlgebraicGeometry.Etale U'_in.ι) : Y'.Etale))))
    (s_tilde₁ : ↥(I.obj.obj (Opposite.op
      (CategoryTheory.MorphismProperty.Over.mk ⊤ U'_out.ι
        (inferInstance : AlgebraicGeometry.Etale U'_out.ι) : Y'.Etale))))
    (q_η : ∀ W : Y'.Etale, ↥(Q.obj.obj (Opposite.op W)))
    (hSecInj : ∀ W : Y'.Etale,
      Function.Injective
        ((((CategoryTheory.sheafificationAdjunction Y'.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          (weilEtaleGmPresheaf Y')).app (Opposite.op W) ≫
          ι_inj.hom.app (Opposite.op W)).hom))
    (hSecKer : ∀ (W : Y'.Etale) (x : ↥(I.obj.obj (Opposite.op W))),
      (π_inj.hom.app (Opposite.op W)).hom x = 0 ↔
      ∃ u : ↥((weilEtaleGmPresheaf Y').obj (Opposite.op W)),
        ((((CategoryTheory.sheafificationAdjunction Y'.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          (weilEtaleGmPresheaf Y')).app (Opposite.op W) ≫
          ι_inj.hom.app (Opposite.op W)).hom) u = x)
    (hq_nat : ∀ {W₁ W₂ : Y'.Etale} (g : W₁ ⟶ W₂), (Q.obj.map g.op).hom (q_η W₂) = q_η W₁)
    (hs₀_π :
      let V_W₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_in.ι
        (inferInstance : AlgebraicGeometry.Etale U'_in.ι)
      (π_inj.hom.app (Opposite.op V_W₂)).hom s_tilde₀ = ℓ • q_η V_W₂)
    (hs₁_π :
      let V_W₁ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_out.ι
        (inferInstance : AlgebraicGeometry.Etale U'_out.ι)
      (π_inj.hom.app (Opposite.op V_W₁)).hom s_tilde₁ = ℓ • q_η V_W₁)
    (hov_diff :
      let W₁₂ : Y'.Opens := U'_out ⊓ U'_in
      let V_W₁ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_out.ι
        (inferInstance : AlgebraicGeometry.Etale U'_out.ι)
      let V_W₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_in.ι
        (inferInstance : AlgebraicGeometry.Etale U'_in.ι)
      let V_W₁₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
        (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
      let j₁₂_₁ : V_W₁₂ ⟶ V_W₁ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (Y'.homOfLE inf_le_left) (Y'.homOfLE_ι inf_le_left)
      let j₁₂_₂ : V_W₁₂ ⟶ V_W₂ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (Y'.homOfLE inf_le_right) (Y'.homOfLE_ι inf_le_right)
      let shAdj_Y' := CategoryTheory.sheafificationAdjunction Y'.smallEtaleTopology AddCommGrpCat.{u}
      let u_Y'_sh : ↥((weilEtaleGmSheaf Y').obj.obj (Opposite.op V_W₁₂)) :=
        (((shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')).app (Opposite.op V_W₁₂)).hom
          (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u'_div)))
      (I.obj.map j₁₂_₁.op).hom s_tilde₁ - (I.obj.map j₁₂_₂.op).hom s_tilde₀ =
        (ι_inj.hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh)
    (S'₀ S'₁ : Type u)
    [instComm₀ : CommRing S'₀] [instComm₁ : CommRing S'₁]
    [instAlg₀ : Algebra ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀]
    [instAlg₁ : Algebra ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁]
    [Algebra.Etale ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀]
    [Algebra.Etale ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁]
    (hEt_0 : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀)) ≫
        hAff_in.fromSpec))
    (hEt_1 : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁)) ≫
        hAff_out.fromSpec))
    (σ₀ : ↥(I.obj.obj (Opposite.op
      (CategoryTheory.MorphismProperty.Over.mk ⊤
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀)) ≫
          hAff_in.fromSpec) hEt_0 : Y'.Etale))))
    (σ₁ : ↥(I.obj.obj (Opposite.op
      (CategoryTheory.MorphismProperty.Over.mk ⊤
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁)) ≫
          hAff_out.fromSpec) hEt_1 : Y'.Etale))))
    (hσ₀ :
      let E_0 : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀)) ≫
          hAff_in.fromSpec) hEt_0
      (π_inj.hom.app (Opposite.op E_0)).hom σ₀ = q_η E_0)
    (hσ₁ :
      let E_1 : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (AlgebraicGeometry.Spec.map
