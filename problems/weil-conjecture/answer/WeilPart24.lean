    have hy_not_W : y ∉ (W₀_open : Set ↥Y₀) := fun h => hy_bad (Or.inl h)
    have hy_not_s₁ : y ∉ (Y₀.basicOpen s₁ : Set ↥Y₀) := fun h => hy_bad (Or.inr h)
    rw [hW₀_compl, Set.mem_compl_iff, not_not] at hy_not_W
    rcases Set.mem_iUnion.mp hy_not_W with ⟨b, v, rfl⟩
    have hv_eq : v = v₀ := by
      have hsec_v : f₀.base ((τ₀ b).base v) = v :=
        congrArg (fun g : V₀ ⟶ V₀ => g.base v) (hτ₀_sec b)
      exact hsec_v.symm.trans hy_f₀
    subst hv_eq
    exact hy_not_s₁ (hs₁_pts b)

  have hClosed_img : IsClosed (f₀.base '' Z_bad) :=
    f₀.isClosedMap Z_bad hClosed_Zbad
  let O_good : V₀.Opens := V₀₀ ⊓ ⟨(f₀.base '' Z_bad)ᶜ, hClosed_img.isOpen_compl⟩
  have hv₀_Ogood : v₀ ∈ O_good := ⟨hv₀_h₀, hv₀_not_bad⟩
  rcases hAff_V₀₀.exists_basicOpen_le ⟨v₀, hv₀_Ogood⟩ hv₀_h₀ with
    ⟨h₁, hh₁_le_Ogood, hv₀_h₁⟩

  let V_sub : V₀.Opens := V₀.basicOpen h₁
  have hAff_Vsub : AlgebraicGeometry.IsAffineOpen V_sub := hAff_V₀₀.basicOpen h₁
  let V₁ : AlgebraicGeometry.Scheme.{u} := V_sub.toScheme
  let j_V₁ : V₁ ⟶ V₀ := V_sub.ι
  let v₁ : ↥V₁ := ⟨v₀, hv₀_h₁⟩
  let Y_sub : Y₀.Opens := (TopologicalSpace.Opens.map f₀.base).obj V_sub
  let Y₁ : AlgebraicGeometry.Scheme.{u} := Y_sub.toScheme
  let j_Y₁ : Y₁ ⟶ Y₀ := Y_sub.ι
  let f₁ : Y₁ ⟶ V₁ := f₀ ∣_ V_sub

  have hPb : CategoryTheory.IsPullback j_Y₁ f₁ f₀ j_V₁ :=
    (AlgebraicGeometry.isPullback_morphismRestrict f₀ V_sub).flip

  let τ₁ : Fin m → (V₁ ⟶ Y₁) := fun a =>
    hPb.lift (j_V₁ ≫ τ₀ a) (𝟙 V₁) (by
      rw [CategoryTheory.Category.assoc, hτ₀_sec a,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])

  have hτ₁_comm : ∀ a : Fin m, τ₁ a ≫ j_Y₁ = j_V₁ ≫ τ₀ a :=
    fun a => hPb.lift_fst _ _ _
  have hτ₁_sec : ∀ a : Fin m, τ₁ a ≫ f₁ = 𝟙 V₁ :=
    fun a => hPb.lift_snd _ _ _
  have hτ₁_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ₁ a) := by
    intro a
    haveI : AlgebraicGeometry.IsSeparated f₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb (inferInstance : AlgebraicGeometry.IsSeparated f₀)
    haveI : AlgebraicGeometry.IsClosedImmersion (τ₁ a ≫ f₁) := by
      rw [hτ₁_sec a]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp (τ₁ a) f₁

  haveI : Nonempty ↥V₁ := ⟨v₁⟩
  have hInt_V₁ : AlgebraicGeometry.IsIntegral V₁ :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion j_V₁
  haveI : Nonempty ↥Y₁ := ⟨(τ₁ ⟨0, hm⟩).base v₁⟩
  have hInt_Y₁ : AlgebraicGeometry.IsIntegral Y₁ :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion j_Y₁

  have hv₁_cl : IsClosed ({v₁} : Set ↥V₁) := by
    have h_pre : j_V₁.base ⁻¹' ({v₀} : Set ↥V₀) = {v₁} := by
      ext w
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩
    rw [← h_pre]
    exact hv₀_cl.preimage j_V₁.continuous

  have h_range_τ₁ : ∀ a : Fin m,
      Set.range (τ₁ a).base = j_Y₁.base ⁻¹' Set.range (τ₀ a).base := by
    intro a
    ext y
    constructor
    · rintro ⟨v, rfl⟩
      change ((τ₁ a) ≫ j_Y₁).base v ∈ Set.range (τ₀ a).base
      rw [hτ₁_comm a]
      exact ⟨j_V₁.base v, rfl⟩
    · rintro ⟨v, hv⟩
      have hv_eq : v = j_V₁.base (f₁.base y) := by
        have h1 : f₀.base (j_Y₁.base y) = j_V₁.base (f₁.base y) :=
          congrArg (fun g => g.base y) hPb.w
        have h2 : f₀.base ((τ₀ a).base v) = v :=
          congrArg (fun g => g.base v) (hτ₀_sec a)
        rw [hv] at h2
        exact h2.symm.trans h1
      refine ⟨f₁.base y, ?_⟩
      apply j_Y₁.isOpenEmbedding.injective
      change ((τ₁ a) ≫ j_Y₁).base (f₁.base y) = j_Y₁.base y
      rw [hτ₁_comm a]
      change (τ₀ a).base (j_V₁.base (f₁.base y)) = j_Y₁.base y
      rw [← hv_eq, hv]

  have hτ₁_disj : _root_.Pairwise fun a b : Fin m =>
      Disjoint (Set.range (τ₁ a).base) (Set.range (τ₁ b).base) := by
    intro a b hab
    rw [h_range_τ₁ a, h_range_τ₁ b]
    exact (hτ₀_disj hab).preimage j_Y₁.base

  let U_in : Y₁.Opens := (TopologicalSpace.Opens.map j_Y₁.base).obj W₀_open
  have hU_in_compl : (U_in : Set ↥Y₁) = (⋃ a : Fin m, Set.range (τ₁ a).base)ᶜ := by
    change j_Y₁.base ⁻¹' (W₀_open : Set ↥Y₀) = _
    rw [hW₀_compl, Set.preimage_compl, Set.preimage_iUnion]
    simp_rw [h_range_τ₁]

  
  rcases hAff_V0_top.basicOpen_basicOpen_is_basicOpen h₀ h₁ with ⟨h_top, hh_top_eq⟩
  have hY_sub_eq : Y_sub = Y₀.basicOpen (f₀.appTop.hom h_top) := by
    dsimp only [Y_sub, V_sub]
    rw [← hh_top_eq, f₀.preimage_basicOpen h_top]
    rfl
  let r_in_W₀ : ↑(Y₀.presheaf.obj (Opposite.op W₀_open)) :=
    (Y₀.presheaf.map (CategoryTheory.homOfLE (le_top : W₀_open ≤ ⊤)).op).hom
      (f₀.appTop.hom h_top)
  let W_in_Y₀ : Y₀.Opens := Y₀.basicOpen r_in_W₀
  have hAff_Win : AlgebraicGeometry.IsAffineOpen W_in_Y₀ := hAff_W₀.basicOpen r_in_W₀
  have hWin_eq : W_in_Y₀ = W₀_open ⊓ Y_sub := by
    have h_res : W_in_Y₀ = W₀_open ⊓ Y₀.basicOpen (f₀.appTop.hom h_top) :=
      Y₀.toRingedSpace.basicOpen_res
        (CategoryTheory.homOfLE (le_top : W₀_open ≤ ⊤)).op (f₀.appTop.hom h_top)
    rw [h_res, ← hY_sub_eq]
  have hRange_Uin : Set.range (U_in.ι ≫ j_Y₁).base = Set.range W_in_Y₀.ι.base := by
    ext y
    constructor
    · rintro ⟨⟨⟨y', hy'_Ysub⟩, hy'_W⟩, rfl⟩
      have hy'_Win : y' ∈ W_in_Y₀ := by
        rw [hWin_eq]
        exact ⟨hy'_W, hy'_Ysub⟩
      exact ⟨⟨y', hy'_Win⟩, rfl⟩
    · rintro ⟨⟨y', hy'_Win⟩, rfl⟩
      rw [hWin_eq] at hy'_Win
      exact ⟨⟨⟨y', hy'_Win.2⟩, hy'_Win.1⟩, rfl⟩
  let e_in : U_in.toScheme ≅ W_in_Y₀.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (U_in.ι ≫ j_Y₁) W_in_Y₀.ι hRange_Uin
  have hAff_Uin : AlgebraicGeometry.IsAffineOpen U_in :=
    @AlgebraicGeometry.IsAffine.of_isIso _ _ e_in.hom inferInstance hAff_Win

  
  let U_out : Y₁.Opens := (TopologicalSpace.Opens.map j_Y₁.base).obj (Y₀.basicOpen s₁)
  let W_out_Y₀ : Y₀.Opens := Y₀.basicOpen (s₁ * ι₀ h₁)
  have hAff_Wout : AlgebraicGeometry.IsAffineOpen W_out_Y₀ := hAff_Umid.basicOpen (s₁ * ι₀ h₁)
  have hWout_eq : W_out_Y₀ = Y₀.basicOpen s₁ ⊓ Y_sub := by
    have h_mul : W_out_Y₀ = Y₀.basicOpen s₁ ⊓ Y₀.basicOpen (ι₀ h₁) :=
      Y₀.toRingedSpace.basicOpen_mul s₁ (ι₀ h₁)
    have h_res : Y₀.basicOpen (ι₀ h₁) = U_mid ⊓ Y₀.basicOpen ((f₀.app V₀₀).hom h₁) :=
      Y₀.toRingedSpace.basicOpen_res
        (CategoryTheory.homOfLE hUmid_f₀).op ((f₀.app V₀₀).hom h₁)
    rw [h_mul, h_res, ← f₀.preimage_basicOpen h₁]
    ext y
    change (y ∈ Y₀.basicOpen s₁ ∧ y ∈ U_mid ∧ y ∈ Y_sub) ↔ (y ∈ Y₀.basicOpen s₁ ∧ y ∈ Y_sub)
    exact ⟨fun h => ⟨h.1, h.2.2⟩, fun h => ⟨h.1, Y₀.basicOpen_le s₁ h.1, h.2⟩⟩
  have hRange_Uout : Set.range (U_out.ι ≫ j_Y₁).base = Set.range W_out_Y₀.ι.base := by
    ext y
    constructor
    · rintro ⟨⟨⟨y', hy'_Ysub⟩, hy'_s₁⟩, rfl⟩
      have hy'_Wout : y' ∈ W_out_Y₀ := by
        rw [hWout_eq]
        exact ⟨hy'_s₁, hy'_Ysub⟩
      exact ⟨⟨y', hy'_Wout⟩, rfl⟩
    · rintro ⟨⟨y', hy'_Wout⟩, rfl⟩
      rw [hWout_eq] at hy'_Wout
      exact ⟨⟨⟨y', hy'_Wout.2⟩, hy'_Wout.1⟩, rfl⟩
  let e_out : U_out.toScheme ≅ W_out_Y₀.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (U_out.ι ≫ j_Y₁) W_out_Y₀.ι hRange_Uout
  have hAff_Uout : AlgebraicGeometry.IsAffineOpen U_out :=
    @AlgebraicGeometry.IsAffine.of_isIso _ _ e_out.hom inferInstance hAff_Wout

  have hCover_top : U_in ⊔ U_out = ⊤ := by
    rw [eq_top_iff]
    intro y _
    by_contra h_not
    have hy_not_in : j_Y₁.base y ∉ (W₀_open : Set ↥Y₀) :=
      fun h => h_not (Or.inl h)
    have hy_not_out : j_Y₁.base y ∉ (Y₀.basicOpen s₁ : Set ↥Y₀) :=
      fun h => h_not (Or.inr h)
    have hy_bad : j_Y₁.base y ∈ Z_bad := by
      rintro (h1 | h2)
      · exact hy_not_in h1
      · exact hy_not_out h2
    have hfy_good : f₀.base (j_Y₁.base y) ∈ O_good := hh₁_le_Ogood y.2
    exact hfy_good.2 ⟨j_Y₁.base y, hy_bad, rfl⟩

  
  have h_out_le : U_out ≤ (TopologicalSpace.Opens.map j_Y₁.base).obj W_out_Y₀ := by
    intro y hy
    change j_Y₁.base y ∈ W_out_Y₀
    rw [hWout_eq]
    exact ⟨hy, y.2⟩
  have h_top_le : (⊤ : V₁.Opens) ≤ (TopologicalSpace.Opens.map j_V₁.base).obj V_sub :=
    fun v _ => v.2

  let α_Y : Y₀.presheaf.obj (Opposite.op W_out_Y₀) ⟶ Y₁.presheaf.obj (Opposite.op U_out) :=
    j_Y₁.appLE W_out_Y₀ U_out h_out_le
  let α_V : V₀.presheaf.obj (Opposite.op V_sub) ⟶ V₁.presheaf.obj (Opposite.op ⊤) :=
    j_V₁.appLE V_sub ⊤ h_top_le

  have hIso_αY : CategoryTheory.IsIso α_Y := by
    let r_out : U_out.toScheme ⟶ W_out_Y₀.toScheme := j_Y₁.resLE W_out_Y₀ U_out h_out_le
    have hr_eq : r_out = e_out.hom := by
      rw [← CategoryTheory.cancel_mono W_out_Y₀.ι]
      simp [r_out, e_out]
    haveI : CategoryTheory.IsIso r_out := by
      rw [hr_eq]; infer_instance
    haveI : CategoryTheory.IsIso r_out.appTop := by
      change CategoryTheory.IsIso (AlgebraicGeometry.Scheme.Γ.map r_out.op)
      infer_instance
    let e_arr := AlgebraicGeometry.arrowResLEAppIso j_Y₁ W_out_Y₀ U_out h_out_le
    have hw : CategoryTheory.CategoryStruct.comp e_arr.hom.left α_Y =
        CategoryTheory.CategoryStruct.comp r_out.appTop e_arr.hom.right := e_arr.hom.w
    haveI : CategoryTheory.IsIso e_arr.hom.left :=
      CategoryTheory.Functor.map_isIso CategoryTheory.Arrow.leftFunc e_arr.hom
    haveI : CategoryTheory.IsIso e_arr.hom.right :=
      CategoryTheory.Functor.map_isIso CategoryTheory.Arrow.rightFunc e_arr.hom
    have h_eq : α_Y = CategoryTheory.CategoryStruct.comp (CategoryTheory.inv e_arr.hom.left)
        (CategoryTheory.CategoryStruct.comp r_out.appTop e_arr.hom.right) := by
      rw [← hw, ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.id_comp]
    rw [h_eq]
    infer_instance

  have hIso_αV : CategoryTheory.IsIso α_V := by
    let r_top : (⊤ : V₁.Opens).toScheme ⟶ V_sub.toScheme := j_V₁.resLE V_sub ⊤ h_top_le
    have hRange_top : Set.range ((⊤ : V₁.Opens).ι ≫ j_V₁).base = Set.range V_sub.ι.base := by
      ext v
      exact ⟨fun ⟨⟨w, _⟩, hw⟩ => ⟨w, hw⟩, fun ⟨w, hw⟩ => ⟨⟨w, trivial⟩, hw⟩⟩
    let e_top := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
      ((⊤ : V₁.Opens).ι ≫ j_V₁) V_sub.ι hRange_top
    have hr_eq : r_top = e_top.hom := by
      rw [← CategoryTheory.cancel_mono V_sub.ι]
      simp [r_top, e_top]
    haveI : CategoryTheory.IsIso r_top := by
      rw [hr_eq]; infer_instance
    haveI : CategoryTheory.IsIso r_top.appTop := by
      change CategoryTheory.IsIso (AlgebraicGeometry.Scheme.Γ.map r_top.op)
      infer_instance
    let e_arr := AlgebraicGeometry.arrowResLEAppIso j_V₁ V_sub ⊤ h_top_le
    have hw : CategoryTheory.CategoryStruct.comp e_arr.hom.left α_V =
        CategoryTheory.CategoryStruct.comp r_top.appTop e_arr.hom.right := e_arr.hom.w
    haveI : CategoryTheory.IsIso e_arr.hom.left :=
      CategoryTheory.Functor.map_isIso CategoryTheory.Arrow.leftFunc e_arr.hom
    haveI : CategoryTheory.IsIso e_arr.hom.right :=
      CategoryTheory.Functor.map_isIso CategoryTheory.Arrow.rightFunc e_arr.hom
    have h_eq : α_V = CategoryTheory.CategoryStruct.comp (CategoryTheory.inv e_arr.hom.left)
        (CategoryTheory.CategoryStruct.comp r_top.appTop e_arr.hom.right) := by
      rw [← hw, ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.id_comp]
    rw [h_eq]
    infer_instance

  have h_le_all : ∀ a : Fin m,
      (⊤ : V₁.Opens) ≤ (TopologicalSpace.Opens.map (τ₁ a).base).obj U_out := by
    intro a v _
    have hy_top : (τ₁ a).base v ∈ (U_in ⊔ U_out : Y₁.Opens) := by
      rw [hCover_top]; trivial
    rcases hy_top with hy_in | hy_out
    · exfalso
      have hy_compl : (τ₁ a).base v ∈ (U_in : Set ↥Y₁) := hy_in
      rw [hU_in_compl] at hy_compl
      exact hy_compl (Set.mem_iUnion.mpr ⟨a, v, rfl⟩)
    · exact hy_out

  have h_le_raw : ∀ a : Fin m,
      V_sub ≤ (TopologicalSpace.Opens.map (τ₀ a).base).obj W_out_Y₀ := by
    intro a v hv
    have hv_out : (τ₁ a).base ⟨v, hv⟩ ∈ U_out :=
      h_le_all a (by trivial : (⟨v, hv⟩ : ↥V₁) ∈ (⊤ : V₁.Opens))
    have hj_eq : j_Y₁.base ((τ₁ a).base ⟨v, hv⟩) = (τ₀ a).base v :=
      congrArg (fun g => g.base ⟨v, hv⟩) (hτ₁_comm a)
    change (τ₀ a).base v ∈ W_out_Y₀
    rw [← hj_eq]
    exact h_out_le hv_out

  let res_out : R'_1 →+* ↑(Y₀.presheaf.obj (Opposite.op W_out_Y₀)) :=
    algebraMap R'_1 ↑(Y₀.presheaf.obj (Opposite.op W_out_Y₀))
  let t_bdry : Fin m → ↑(Y₁.presheaf.obj (Opposite.op U_out)) :=
    fun a => α_Y.hom (res_out (t_tilde a))

  refine ⟨V₁, j_V₁, v₁, Y₁, j_Y₁, f₁, τ₁, U_in, U_out, t_bdry,
    inferInstance, hAff_Vsub, hInt_V₁, hv₁_cl, rfl, hPb, hInt_Y₁,
    fun a => ⟨hτ₁_sec a, hτ₁_cl a, hτ₁_comm a⟩,
    hτ₁_disj, rfl, hU_in_compl, hAff_Uin, hAff_Uout, hCover_top, ?_⟩

  intro a
  have hKer_φ₁a : RingHom.ker (((τ₁ a).appLE U_out ⊤ (h_le_all a)).hom) =
      Ideal.span {t_bdry a} := by
    let A₁ := ↑(V₀.presheaf.obj (Opposite.op V_sub))
    let R_out := ↑(Y₀.presheaf.obj (Opposite.op W_out_Y₀))
    haveI : IsLocalization.Away h₁ A₁ := hAff_V₀₀.isLocalization_basicOpen h₁
    haveI : IsLocalization.Away (s₁ * ι₀ h₁) R_out :=
      hAff_Umid.isLocalization_basicOpen (s₁ * ι₀ h₁)
    let ψ_raw : Fin m → (R_out →+* A₁) :=
      fun b => ((τ₀ b).appLE W_out_Y₀ V_sub (h_le_raw b)).hom
    have hψ_comm : ∀ b : Fin m, (ψ_raw b).comp (algebraMap R'_1 R_out) =
        (algebraMap A₀₀ A₁).comp (φ₀ b) := by
      intro b
      have h_cat : CategoryTheory.CategoryStruct.comp
          (Y₀.presheaf.map (CategoryTheory.homOfLE (Y₀.basicOpen_le (s₁ * ι₀ h₁))).op)
          ((τ₀ b).appLE W_out_Y₀ V_sub (h_le_raw b)) =
          CategoryTheory.CategoryStruct.comp
            ((τ₀ b).appLE U_mid V₀₀ (hτ₀_Umid b))
            (V₀.presheaf.map (CategoryTheory.homOfLE (V₀.basicOpen_le h₁)).op) := by
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      exact congrArg CommRingCat.Hom.hom h_cat
    have hKer_raw : RingHom.ker (ψ_raw a) = Ideal.span {res_out (t_tilde a)} :=
      hKer_loc h₁ A₁ R_out ψ_raw hψ_comm a
    have hα_comm : CategoryTheory.CategoryStruct.comp α_Y ((τ₁ a).appLE U_out ⊤ (h_le_all a)) =
        CategoryTheory.CategoryStruct.comp ((τ₀ a).appLE W_out_Y₀ V_sub (h_le_raw a)) α_V := by
      have h1 : CategoryTheory.CategoryStruct.comp α_Y ((τ₁ a).appLE U_out ⊤ (h_le_all a)) =
          (τ₁ a ≫ j_Y₁).appLE W_out_Y₀ ⊤
            (fun v hv => h_out_le (h_le_all a hv)) := by
        calc
          CategoryTheory.CategoryStruct.comp α_Y ((τ₁ a).appLE U_out ⊤ (h_le_all a))
            = CategoryTheory.CategoryStruct.comp (j_Y₁.app W_out_Y₀)
                (CategoryTheory.CategoryStruct.comp
                  (Y₁.presheaf.map (CategoryTheory.homOfLE h_out_le).op)
                  ((τ₁ a).appLE U_out ⊤ (h_le_all a))) := by
                dsimp only [α_Y]
                rw [AlgebraicGeometry.Scheme.Hom.appLE, CategoryTheory.Category.assoc]
          _ = CategoryTheory.CategoryStruct.comp (j_Y₁.app W_out_Y₀)
                ((τ₁ a).appLE (j_Y₁ ⁻¹ᵁ W_out_Y₀) ⊤ (fun v hv => h_out_le (h_le_all a hv))) := by
                rw [AlgebraicGeometry.Scheme.Hom.map_appLE]
          _ = (τ₁ a ≫ j_Y₁).appLE W_out_Y₀ ⊤ (fun v hv => h_out_le (h_le_all a hv)) :=
                (AlgebraicGeometry.Scheme.Hom.comp_appLE (τ₁ a) j_Y₁ W_out_Y₀ ⊤ _).symm
      have h2 : CategoryTheory.CategoryStruct.comp
          ((τ₀ a).appLE W_out_Y₀ V_sub (h_le_raw a)) α_V =
          (j_V₁ ≫ τ₀ a).appLE W_out_Y₀ ⊤
            (fun v hv => h_le_raw a (h_top_le hv)) := by
        calc
          CategoryTheory.CategoryStruct.comp ((τ₀ a).appLE W_out_Y₀ V_sub (h_le_raw a)) α_V
            = CategoryTheory.CategoryStruct.comp ((τ₀ a).app W_out_Y₀)
                (CategoryTheory.CategoryStruct.comp
                  (V₀.presheaf.map (CategoryTheory.homOfLE (h_le_raw a)).op)
                  (j_V₁.appLE V_sub ⊤ h_top_le)) := by
                change CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp ((τ₀ a).app W_out_Y₀)
                    (V₀.presheaf.map (CategoryTheory.homOfLE (h_le_raw a)).op)) α_V = _
                rw [CategoryTheory.Category.assoc]
          _ = CategoryTheory.CategoryStruct.comp ((τ₀ a).app W_out_Y₀)
                (j_V₁.appLE (τ₀ a ⁻¹ᵁ W_out_Y₀) ⊤ (fun v hv => h_le_raw a (h_top_le hv))) := by
                rw [AlgebraicGeometry.Scheme.Hom.map_appLE]
          _ = (j_V₁ ≫ τ₀ a).appLE W_out_Y₀ ⊤ (fun v hv => h_le_raw a (h_top_le hv)) :=
                (AlgebraicGeometry.Scheme.Hom.comp_appLE j_V₁ (τ₀ a) W_out_Y₀ ⊤ _).symm
      rw [h1, h2]
      congr 1
      exact hτ₁_comm a
    let eY_ring := CategoryTheory.asIso α_Y
    let eV_ring := CategoryTheory.asIso α_V
    have hSurj_αY : Function.Surjective α_Y.hom := fun y =>
      ⟨eY_ring.inv.hom y,
        RingHom.congr_fun (congrArg CommRingCat.Hom.hom eY_ring.inv_hom_id) y⟩
    have hInj_αV : Function.Injective α_V.hom := fun x₁ x₂ hx => by
      have h1 := congrArg eV_ring.inv.hom hx
      have hi1 : eV_ring.inv.hom (α_V.hom x₁) = x₁ :=
        RingHom.congr_fun (congrArg CommRingCat.Hom.hom eV_ring.hom_inv_id) x₁
      have hi2 : eV_ring.inv.hom (α_V.hom x₂) = x₂ :=
        RingHom.congr_fun (congrArg CommRingCat.Hom.hom eV_ring.hom_inv_id) x₂
      exact hi1.symm.trans (h1.trans hi2)
    have h_hom_eq : (((τ₁ a).appLE U_out ⊤ (h_le_all a)).hom).comp α_Y.hom =
        α_V.hom.comp (ψ_raw a) :=
      congrArg CommRingCat.Hom.hom hα_comm
    ext y
    rcases hSurj_αY y with ⟨x, rfl⟩
    have h_app_x : ((τ₁ a).appLE U_out ⊤ (h_le_all a)).hom (α_Y.hom x) =
        α_V.hom (ψ_raw a x) := RingHom.congr_fun h_hom_eq x
    constructor
    · intro hy_ker
      rw [RingHom.mem_ker, h_app_x] at hy_ker
      have hx_ker : x ∈ RingHom.ker (ψ_raw a) :=
        hInj_αV (hy_ker.trans (map_zero α_V.hom).symm)
      rw [hKer_raw, Ideal.mem_span_singleton] at hx_ker
      rcases hx_ker with ⟨q, rfl⟩
      rw [Ideal.mem_span_singleton]
      exact ⟨α_Y.hom q, map_mul α_Y.hom _ _⟩
    · intro hy_span
      rw [Ideal.mem_span_singleton] at hy_span
      rcases hy_span with ⟨q', hq'⟩
      rcases hSurj_αY q' with ⟨q, rfl⟩
      have h_app_mul :
          ((τ₁ a).appLE U_out ⊤ (h_le_all a)).hom (α_Y.hom (res_out (t_tilde a) * q)) =
            α_V.hom (ψ_raw a (res_out (t_tilde a) * q)) :=
        RingHom.congr_fun h_hom_eq (res_out (t_tilde a) * q)
      rw [RingHom.mem_ker, hq', ← map_mul α_Y.hom, h_app_mul, map_mul]
      have ht0 : ψ_raw a (res_out (t_tilde a)) = 0 := by
        have ht_in : res_out (t_tilde a) ∈ RingHom.ker (ψ_raw a) := by
          rw [hKer_raw]
          exact Ideal.subset_span rfl
        exact ht_in
      rw [ht0, zero_mul, map_zero]
  refine ⟨h_le_all a, hKer_φ₁a, ?_⟩
  letI : AlgebraicGeometry.IsAffine V₁ := hAff_Vsub
  have hAff_V1_top : AlgebraicGeometry.IsAffineOpen (⊤ : V₁.Opens) :=
    AlgebraicGeometry.isAffineOpen_top V₁
  let φ₁_a := ((τ₁ a).appLE U_out ⊤ (h_le_all a)).hom
  have hUout_le_f1top : U_out ≤ f₁ ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have hSurj_φ₁a : Function.Surjective φ₁_a := by
    have h_cat : CategoryTheory.CategoryStruct.comp
        (f₁.appLE ⊤ U_out hUout_le_f1top) ((τ₁ a).appLE U_out ⊤ (h_le_all a)) =
        CategoryTheory.CategoryStruct.id (V₁.presheaf.obj (Opposite.op ⊤)) := by
      calc
        CategoryTheory.CategoryStruct.comp
            (f₁.appLE ⊤ U_out hUout_le_f1top) ((τ₁ a).appLE U_out ⊤ (h_le_all a))
          = CategoryTheory.CategoryStruct.comp (f₁.app ⊤)
              (CategoryTheory.CategoryStruct.comp
                (Y₁.presheaf.map (CategoryTheory.homOfLE hUout_le_f1top).op)
                ((τ₁ a).appLE U_out ⊤ (h_le_all a))) := by
              change CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (f₁.app ⊤)
                  (Y₁.presheaf.map (CategoryTheory.homOfLE hUout_le_f1top).op))
                ((τ₁ a).appLE U_out ⊤ (h_le_all a)) = _
              rw [CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp (f₁.app ⊤)
              ((τ₁ a).appLE (f₁ ⁻¹ᵁ ⊤) ⊤ (fun _ _ => trivial)) := by
              rw [AlgebraicGeometry.Scheme.Hom.map_appLE]
        _ = ((τ₁ a) ≫ f₁).appLE ⊤ ⊤ (fun _ _ => trivial) :=
              (AlgebraicGeometry.Scheme.Hom.comp_appLE (τ₁ a) f₁ ⊤ ⊤ _).symm
        _ = AlgebraicGeometry.Scheme.Hom.appLE (𝟙 V₁) ⊤ ⊤ (fun _ h => h) := by
              congr 1
              exact hτ₁_sec a
        _ = CategoryTheory.CategoryStruct.id _ := by
              dsimp only [AlgebraicGeometry.Scheme.Hom.appLE]
              simp
    intro z
    exact ⟨(f₁.appLE ⊤ U_out hUout_le_f1top).hom z,
      RingHom.congr_fun (congrArg CommRingCat.Hom.hom h_cat) z⟩
  have hSurj_fromV1 : Function.Surjective hAff_V1_top.fromSpec.base := by
    intro v
    have hv_mem : v ∈ Set.range hAff_V1_top.fromSpec.base := by
      rw [hAff_V1_top.range_fromSpec]
      trivial
    exact hv_mem
  have h_spec_comm := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
    (τ₁ a) hAff_Uout hAff_V1_top (h_le_all a)
  let S_bo : Set (PrimeSpectrum ↑(Y₁.presheaf.obj (Opposite.op U_out))) :=
    ↑(PrimeSpectrum.basicOpen (t_bdry a))
  have h_set_spec : Set.range (PrimeSpectrum.comap φ₁_a) = S_boᶜ := by
    dsimp only [S_bo]
    rw [range_comap_of_surjective _ φ₁_a hSurj_φ₁a, hKer_φ₁a,
      PrimeSpectrum.zeroLocus_span, PrimeSpectrum.basicOpen_eq_zeroLocus_compl, compl_compl]
  have h_range_eq : Set.range (τ₁ a).base =
      hAff_Uout.fromSpec.base '' (S_boᶜ :
        Set ↥(AlgebraicGeometry.Spec (Y₁.presheaf.obj (Opposite.op U_out)))) := by
    calc
      Set.range (τ₁ a).base
        = Set.range ((τ₁ a).base ∘ hAff_V1_top.fromSpec.base) :=
            (hSurj_fromV1.range_comp (τ₁ a).base).symm
      _ = Set.range (hAff_Uout.fromSpec.base ∘ PrimeSpectrum.comap φ₁_a) := by
            congr 1
            ext q
            exact (congrArg (fun g => g.base q) h_spec_comm).symm
      _ = hAff_Uout.fromSpec.base '' (Set.range (PrimeSpectrum.comap φ₁_a) :
            Set ↥(AlgebraicGeometry.Spec (Y₁.presheaf.obj (Opposite.op U_out)))) :=
            Set.range_comp _ _
      _ = hAff_Uout.fromSpec.base '' (S_boᶜ :
            Set ↥(AlgebraicGeometry.Spec (Y₁.presheaf.obj (Opposite.op U_out)))) :=
            congrArg (fun S : Set ↥(AlgebraicGeometry.Spec (Y₁.presheaf.obj (Opposite.op U_out))) =>
              hAff_Uout.fromSpec.base '' S) h_set_spec
  have h_img_bo : hAff_Uout.fromSpec.base '' (S_bo :
      Set ↥(AlgebraicGeometry.Spec (Y₁.presheaf.obj (Opposite.op U_out)))) =
      (Y₁.basicOpen (t_bdry a) : Set ↥Y₁) := by
    have h_op := congrArg (fun O : Y₁.Opens => (O : Set ↥Y₁))
      (hAff_Uout.fromSpec_image_basicOpen (t_bdry a))
    exact h_op
  rw [← h_img_bo, ← hAff_Uout.range_fromSpec, h_range_eq]
  ext y
  constructor
  · rintro ⟨q, hq, rfl⟩
    refine ⟨⟨q, rfl⟩, ?_⟩
    rintro ⟨q', hq'_compl, hq'_eq⟩
    have hqq' := hAff_Uout.fromSpec.isOpenEmbedding.injective hq'_eq
    subst hqq'
    exact hq'_compl hq
  · rintro ⟨⟨q, rfl⟩, hy_not⟩
    refine ⟨q, ?_, rfl⟩
    by_contra hq_not
    exact hy_not ⟨q, hq_not, rfl⟩

theorem weil_etale_two_open_mayer_vietoris_universal_and_kummer_iff (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z)) :
    ∃ ξ_sys : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (O₁ O₂ : Z.Opens),
        O₁ ⊔ O₂ = ⊤ →
        Units ↑(Z.presheaf.obj (Opposite.op (O₁ ⊓ O₂))) →
        (weilEtaleGmSheaf Z).H 1,
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) (O₁ O₂ : Z.Opens) (hcov : O₁ ⊔ O₂ = ⊤)
         (u₁₂ : Units ↑(Z.presheaf.obj (Opposite.op (O₁ ⊓ O₂))))
         (K_sh Q_sh : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
         (ι_0 : weilEtaleGmSheaf Z ⟶ K_sh)
         (π_0 : K_sh ⟶ Q_sh)
         (h0_0 : ι_0 ≫ π_0 = 0)
         (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact),
        let O₁₂ : Z.Opens := O₁ ⊓ O₂
        let V_O₁ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₁.ι
          (inferInstance : AlgebraicGeometry.Etale O₁.ι)
        let V_O₂ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₂.ι
          (inferInstance : AlgebraicGeometry.Etale O₂.ι)
        let V_O₁₂ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₁₂.ι
          (inferInstance : AlgebraicGeometry.Etale O₁₂.ι)
        let j₁₂_₁ : V_O₁₂ ⟶ V_O₁ :=
          CategoryTheory.MorphismProperty.Over.homMk
            (Z.homOfLE inf_le_left) (Z.homOfLE_ι inf_le_left)
        let shAdj_Z := CategoryTheory.sheafificationAdjunction
          Z.smallEtaleTopology AddCommGrpCat.{u}
        let Fℤ_Z := (CategoryTheory.constantSheaf
          Z.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let u₁_Fℤ := fun (V : Z.Etale) =>
          (((shAdj_Z.unit.app
            ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (Opposite.op V)).hom (ULift.up (1 : ℤ)))
        let u_Z_sh : ↥((weilEtaleGmSheaf Z).obj.obj (Opposite.op V_O₁₂)) :=
          (((shAdj_Z.unit.app (weilEtaleGmPresheaf Z)).app (Opposite.op V_O₁₂)).hom
            (Additive.ofMul (Units.map O₁₂.topIso.inv.hom.toMonoidHom u₁₂)))
        ∀ (s_lift : ↥(K_sh.obj.obj (Opposite.op V_O₁)))
          (f_q : Fℤ_Z ⟶ Q_sh),
          (K_sh.obj.map j₁₂_₁.op).hom s_lift =
            (ι_0.hom.app (Opposite.op V_O₁₂)).hom u_Z_sh →
          (f_q.hom.app (Opposite.op V_O₁)).hom (u₁_Fℤ V_O₁) =
            (π_0.hom.app (Opposite.op V_O₁)).hom s_lift →
          (f_q.hom.app (Opposite.op V_O₂)).hom (u₁_Fℤ V_O₂) = 0 →
          ξ_sys Z O₁ O₂ hcov u₁₂ =
            (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1)) ∧
      (∀ (X Y : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom X Y)
         (O₁ O₂ : Y.Opens) (hcov : O₁ ⊔ O₂ = ⊤)
         (u₁₂ : Units ↑(Y.presheaf.obj (Opposite.op (O₁ ⊓ O₂))))
         (n : ℕ)
         (ι_kum : weilEtaleTorsionSheaf Y n ⟶ weilEtaleGmSheaf Y)
         (p_kum : weilEtaleGmSheaf Y ⟶ weilEtaleGmSheaf Y),
        p_kum = n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y) →
        ∀ (h0 : ι_kum ≫ p_kum = 0)
          (hSE : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact)
          (φ : weilEtaleTorsionH Y n 2 →+ weilEtaleTorsionH X n 2),
          WeilIsTorsionEtalePullback h n 2 φ →
          φ ((ξ_sys Y O₁ O₂ hcov u₁₂).comp hSE.extClass (rfl : 1 + 1 = 2)) = 0 →
          let W₁ : X.Opens := (TopologicalSpace.Opens.map h.base).obj O₁
          let W₂ : X.Opens := (TopologicalSpace.Opens.map h.base).obj O₂
          ∀ (hcov_X : W₁ ⊔ W₂ = ⊤),
            let u_X_zar : Units ↑(X.presheaf.obj (Opposite.op (W₁ ⊓ W₂))) :=
              Units.map ((X.presheaf.map
                (CategoryTheory.eqToHom
                  (rfl : W₁ ⊓ W₂ = (TopologicalSpace.Opens.map h.base).obj (O₁ ⊓ O₂))).op).hom.comp
                (h.app (O₁ ⊓ O₂)).hom).toMonoidHom u₁₂
            ∃ η_X : (weilEtaleGmSheaf X).H 1,
              n • η_X = ξ_sys X W₁ W₂ hcov_X u_X_zar) ∧
      (∀ (X Y : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom X Y)
         (O₁ O₂ : Y.Opens) (hcov : O₁ ⊔ O₂ = ⊤)
         (u₁₂ : Units ↑(Y.presheaf.obj (Opposite.op (O₁ ⊓ O₂))))
         (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
         (ι_kum_Y : weilEtaleTorsionSheaf Y ℓ ⟶ weilEtaleGmSheaf Y)
         (p_kum_Y : weilEtaleGmSheaf Y ⟶ weilEtaleGmSheaf Y)
         (_hp_kum_Y : p_kum_Y = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y))
         (h0_Y : ι_kum_Y ≫ p_kum_Y = 0)
         (hSE_Y : (CategoryTheory.ShortComplex.mk ι_kum_Y p_kum_Y h0_Y).ShortExact)
         (ι_kum_X : weilEtaleTorsionSheaf X ℓ ⟶ weilEtaleGmSheaf X)
         (p_kum_X : weilEtaleGmSheaf X ⟶ weilEtaleGmSheaf X)
         (_hp_kum_X : p_kum_X = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X))
         (h0_X : ι_kum_X ≫ p_kum_X = 0)
         (_hSE_X : (CategoryTheory.ShortComplex.mk ι_kum_X p_kum_X h0_X).ShortExact)
         (φ : weilEtaleTorsionH Y ℓ 2 →+ weilEtaleTorsionH X ℓ 2),
        WeilIsTorsionEtalePullback h ℓ 2 φ →
        Nat.card (weilEtaleTorsionH X ℓ 0) = ℓ →
        let T_Y := weilEtaleIdTerminal.{u} Y
        let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u}
          (weilEtaleIdTerminalIsTerminal.{u} Y)
        let shAdj_Y := CategoryTheory.sheafificationAdjunction
          Y.smallEtaleTopology AddCommGrpCat.{u}
        let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
        let W₁ : X.Opens := (TopologicalSpace.Opens.map h.base).obj O₁
        let W₂ : X.Opens := (TopologicalSpace.Opens.map h.base).obj O₂
        ∀ (hcov_X : W₁ ⊔ W₂ = ⊤),
          let u_X_zar : Units ↑(X.presheaf.obj (Opposite.op (W₁ ⊓ W₂))) :=
            Units.map ((X.presheaf.map
              (CategoryTheory.eqToHom
                (rfl : W₁ ⊓ W₂ = (TopologicalSpace.Opens.map h.base).obj (O₁ ⊓ O₂))).op).hom.comp
              (h.app (O₁ ⊓ O₂)).hom).toMonoidHom u₁₂
          (∃ u_Y : Units ↑(Y.presheaf.obj (Opposite.op ⊤)),
            ((shAdj_Y.unit.app (weilEtaleGmPresheaf Y)).app (Opposite.op T_Y)).hom
              (Additive.ofMul u_Y) =
              (ι_kum_Y.hom.app (Opposite.op T_Y)).hom
                ((adj_Y.unit.app AM).hom (ULift.up (1 : ZMod ℓ))) ∧
            Units.map h.appTop.hom.toMonoidHom u_Y ≠ 1) →
          (∃ η_X : (weilEtaleGmSheaf X).H 1,
            ℓ • η_X = ξ_sys X W₁ W₂ hcov_X u_X_zar) →
          φ ((ξ_sys Y O₁ O₂ hcov u₁₂).comp hSE_Y.extClass (rfl : 1 + 1 = 2)) = 0) :=
by
  have step1_mv : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (O₁ O₂ : Z.Opens) (_ : O₁ ⊔ O₂ = ⊤),
      let J := Z.smallEtaleTopology
      let O₁₂ : Z.Opens := O₁ ⊓ O₂
      let V₁ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₁.ι
        (inferInstance : AlgebraicGeometry.Etale O₁.ι)
      let V₂ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₂.ι
        (inferInstance : AlgebraicGeometry.Etale O₂.ι)
      let V₁₂ : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ O₁₂.ι
        (inferInstance : AlgebraicGeometry.Etale O₁₂.ι)
      let j₁₂_₁ : V₁₂ ⟶ V₁ :=
        CategoryTheory.MorphismProperty.Over.homMk (Z.homOfLE inf_le_left) (Z.homOfLE_ι inf_le_left)
      let j₁₂_₂ : V₁₂ ⟶ V₂ :=
        CategoryTheory.MorphismProperty.Over.homMk (Z.homOfLE inf_le_right) (Z.homOfLE_ι inf_le_right)
      let L : Z.Etale → CategoryTheory.Sheaf J AddCommGrpCat.{u} := fun V =>
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
      let L_map : ∀ {V' V : Z.Etale}, (V' ⟶ V) → (L V' ⟶ L V) := fun g =>
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map g) AddCommGrpCat.free)
      let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
      let Fℤ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
        (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))
      let u₁_Fℤ : ∀ (V : Z.Etale), ↥(Fℤ.obj.obj (Opposite.op V)) := fun V =>
        (((shAdj.unit.app ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))).app (Opposite.op V)).hom (ULift.up (1 : ℤ)))
      let evalEquiv : ∀ (V : Z.Etale) (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
          (L V ⟶ F) ≃ ↥(F.obj.obj (Opposite.op V)) := fun V F =>
        ((shAdj.homEquiv ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free) F).trans
          (((CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale) AddCommGrpCat.adj).homEquiv
            (CategoryTheory.yoneda.obj V) F.obj).trans CategoryTheory.yonedaEquiv))
      let ι_MV : L V₁₂ ⟶ CategoryTheory.Limits.biprod (L V₁) (L V₂) :=
        CategoryTheory.Limits.biprod.lift (L_map j₁₂_₁) (- L_map j₁₂_₂)
      let π_MV : CategoryTheory.Limits.biprod (L V₁) (L V₂) ⟶ Fℤ :=
        CategoryTheory.Limits.biprod.desc ((evalEquiv V₁ Fℤ).symm (u₁_Fℤ V₁))
          ((evalEquiv V₂ Fℤ).symm (u₁_Fℤ V₂))
      ∃ (h0_MV : ι_MV ≫ π_MV = 0)
        (hMV : (CategoryTheory.ShortComplex.mk ι_MV π_MV h0_MV).ShortExact),
        ∀ (G K_sh Q_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u})
          (ι_0 : G ⟶ K_sh) (π_0 : K_sh ⟶ Q_sh) (h0_0 : ι_0 ≫ π_0 = 0)
          (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact)
          (u : ↥(G.obj.obj (Opposite.op V₁₂)))
          (s₁ : ↥(K_sh.obj.obj (Opposite.op V₁)))
          (f_q : Fℤ ⟶ Q_sh),
          (K_sh.obj.map j₁₂_₁.op).hom s₁ = (ι_0.hom.app (Opposite.op V₁₂)).hom u →
          (f_q.hom.app (Opposite.op V₁)).hom (u₁_Fℤ V₁) = (π_0.hom.app (Opposite.op V₁)).hom s₁ →
          (f_q.hom.app (Opposite.op V₂)).hom (u₁_Fℤ V₂) = 0 →
          hMV.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ ((evalEquiv V₁₂ G).symm u))
            (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1) := by
    clear hGm
    intro Z O₁ O₂ hcov J O₁₂ V₁ V₂ V₁₂ j₁₂_₁ j₁₂_₂ L L_map shAdj Fℤ u₁_Fℤ evalEquiv ι_MV π_MV
    letI : CategoryTheory.Abelian (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    letI : CategoryTheory.HasExt (CategoryTheory.Sheaf J AddCommGrpCat.{u}) := inferInstance
    have eval_post : ∀ (V : Z.Etale) {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (ψ : L V ⟶ F) (α : F ⟶ G),
        evalEquiv V G (ψ ≫ α) = (α.hom.app (Opposite.op V)).hom (evalEquiv V F ψ) := by
      intro V F G ψ α
      dsimp only [evalEquiv, Equiv.trans_apply]
      rw [shAdj.homEquiv_naturality_right ψ α,
        (CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale)
          AddCommGrpCat.adj).homEquiv_naturality_right _ _,
        CategoryTheory.yonedaEquiv_comp]
      rfl
    have eval_zero : ∀ (V : Z.Etale) (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        evalEquiv V F 0 = 0 := by
      intro V F
      rw [show (0 : L V ⟶ F) = 𝟙 (L V) ≫ 0 by simp, eval_post]
      rfl
