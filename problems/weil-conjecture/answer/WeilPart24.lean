        show χ₀₁ (φ₀' (p₀' (f₀' r))) = α_r (π₀' r (p₀' (f₀' r))) from
          (RingHom.congr_fun hα_r (p₀' (f₀' r))).symm,
        show (π₀' r) (p₀' (f₀' r)) =
          algebraMap (Localization.Away (f₀' r)) _ (algebraMap R₀' _ (f₀' r)) from
          RingHom.congr_fun (hπ₀_p₀ r) (f₀' r)]
      exact ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (f₀' r)) (f₀' r)).map
        (algebraMap _ _).toMonoidHom).map α_r.toMonoidHom
    obtain ⟨χ_sr, hχ_sr⟩ := away_lift_of (F_s s r) (algebraMap (B_s s) (B_sr s r))
      (away_std_toAlgebra (F_s s r)) χ_s hχs_fr
    have hχsr_α : χ_sr.comp (α_sr s r) = α_r :=
      away_hom_ext_of (p₀' (f₀' r)) (π₀' r) (hLoc_π₀ r) (by
        rw [RingHom.comp_assoc, hα_sr s r, ← RingHom.comp_assoc, hχ_sr, ← RingHom.comp_assoc,
          hχ_s, hα_r])
    have hrel_W := congrArg χ_sr (hw_s_rel s r).symm
    have hχsr_Bs : ∀ z : B_s s, χ_sr (algebraMap (B_s s) (B_sr s r) z) = χ_s z :=
      fun z => RingHom.congr_fun hχ_sr z
    have hχs_θ : ∀ z : R₀₁', χ_s (θ_s s z) = χ₀₁ (p₀₁_0 z) :=
      fun z => RingHom.congr_fun hχ_s (p₀₁_0 z)
    simp only [map_mul, hχsr_Bs, hχs_θ] at hrel_W
    rwa [show χ_sr (α_sr s r (AdjoinRoot.root _)) = α_r (AdjoinRoot.root _) from
      RingHom.congr_fun hχsr_α (AdjoinRoot.root _),
      ← hβ_root s,
      show χ_s (β_s s (AdjoinRoot.root _)) = α_s (AdjoinRoot.root _) from
        RingHom.congr_fun hχs_β (AdjoinRoot.root _)] at hrel_W

  
  
  
  have hs3_uniq : ∀ {R₀' R₁' R₀₁' R_tilde₀ R_tilde₁ L₀ L₁ : Type u}
      [CommRing R₀'] [CommRing R₁'] [CommRing R₀₁']
      [CommRing R_tilde₀] [CommRing R_tilde₁] [CommRing L₀] [CommRing L₁]
      (t₀' : R₀') (ι₀' : R₀' →+* R₀₁') (ι₁' : R₁' →+* R₀₁')
      (m₀' m₁' e' : ℕ)
      (f₀' q₀' U₀' : Fin m₀' → R₀') (f₁' q₁' U₁' : Fin m₁' → R₁')
      (G₀₁' G'₀₁' : Fin m₀' → Fin m₁' → R₀₁')
      (_hPoU₀' : (∑ r : Fin m₀', q₀' r * f₀' r) = 1)
      (_hPoU₁' : (∑ s : Fin m₁', q₁' s * f₁' s) = 1)
      (_hInv₀₁' : ∀ (r : Fin m₀') (s : Fin m₁'),
        G₀₁' r s * G'₀₁' r s = (ι₀' (f₀' r) * ι₁' (f₁' s)) ^ (2 * e'))
      (p₀' : R₀' →+* R_tilde₀) (p₁' : R₁' →+* R_tilde₁)
      (φ₀' : R_tilde₀ →+* L₀) (η₁' : R_tilde₁ →+* L₁)
      (p₀₁_0 : R₀₁' →+* L₀) (p₀₁_1 : R₀₁' →+* L₁)
      (_hLoc_φ₀ : @IsLocalization.Away R_tilde₀ _ (p₀' t₀') L₀ _ φ₀'.toAlgebra)
      (_hp₀ : φ₀'.comp p₀' = p₀₁_0.comp ι₀')
      (_hp₁ : η₁'.comp p₁' = p₀₁_1.comp ι₁')
      (π₀' : ∀ r : Fin m₀', R_tilde₀ →+* AdjoinRoot
        ((Polynomial.X : Polynomial (Localization.Away (f₀' r))) ^ ℓ -
          Polynomial.C (algebraMap R₀' (Localization.Away (f₀' r)) (U₀' r))))
      (_hπ₀_p₀ : ∀ r : Fin m₀', (π₀' r).comp p₀' =
        (algebraMap (Localization.Away (f₀' r)) _).comp (algebraMap R₀' (Localization.Away (f₀' r))))
      (_hLoc_π₀ : ∀ r : Fin m₀', @IsLocalization.Away R_tilde₀ _ (p₀' (f₀' r)) _ _ (π₀' r).toAlgebra)
      (π₁' : ∀ s : Fin m₁', R_tilde₁ →+* AdjoinRoot
        ((Polynomial.X : Polynomial (Localization.Away (f₁' s))) ^ ℓ -
          Polynomial.C (algebraMap R₁' (Localization.Away (f₁' s)) (U₁' s))))
      (_hLoc_π₁ : ∀ s : Fin m₁', @IsLocalization.Away R_tilde₁ _ (p₁' (f₁' s)) _ _ (π₁' s).toAlgebra)
      (Φ : L₁ →+* L₀) (Ψ : L₀ →+* L₁),
      Φ.comp p₀₁_1 = p₀₁_0 →
      Ψ.comp p₀₁_0 = p₀₁_1 →
      (∀ (r : Fin m₀') (s : Fin m₁') (W : Type u) [CommRing W]
        (α_r : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₀' r))) ^ ℓ -
          Polynomial.C (algebraMap R₀' (Localization.Away (f₀' r)) (U₀' r))) →+* W)
        (α_s : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₁' s))) ^ ℓ -
          Polynomial.C (algebraMap R₁' (Localization.Away (f₁' s)) (U₁' s))) →+* W)
        (χ₀₁ : L₀ →+* W),
        α_r.comp (π₀' r) = χ₀₁.comp φ₀' → α_s.comp (π₁' s) = χ₀₁.comp (Φ.comp η₁') →
        χ₀₁ (p₀₁_0 ((ι₀' (f₀' r) * ι₁' (f₁' s)) ^ e')) * α_r (AdjoinRoot.root _) =
          χ₀₁ (p₀₁_0 (G₀₁' r s)) * α_s (AdjoinRoot.root _)) →
      (∀ (s : Fin m₁') (r : Fin m₀') (W : Type u) [CommRing W]
        (α_s : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₁' s))) ^ ℓ -
          Polynomial.C (algebraMap R₁' (Localization.Away (f₁' s)) (U₁' s))) →+* W)
        (α_r : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₀' r))) ^ ℓ -
          Polynomial.C (algebraMap R₀' (Localization.Away (f₀' r)) (U₀' r))) →+* W)
        (χ₁₀ : L₁ →+* W),
        α_s.comp (π₁' s) = χ₁₀.comp η₁' → α_r.comp (π₀' r) = χ₁₀.comp (Ψ.comp φ₀') →
        χ₁₀ (p₀₁_1 ((ι₁' (f₁' s) * ι₀' (f₀' r)) ^ e')) * α_s (AdjoinRoot.root _) =
          χ₁₀ (p₀₁_1 (G'₀₁' r s)) * α_r (AdjoinRoot.root _)) →
      Φ.comp Ψ = RingHom.id L₀ := by
    clear hCocyc₀₁₁ hCocyc₀₀₁ hCocyc₁ hCocyc₀ hPow₀₁ hPow₁ hPow₀ hInv₀₁ hInv₁ hInv₀
      hDiag₁ hDiag₀ hPoU₁ hPoU₀ hLoc₁ hLoc₀ hs1 hs2
    intro R₀' R₁' R₀₁' R_tilde₀ R_tilde₁ L₀ L₁ _ _ _ _ _ _ _
      t₀' ι₀' ι₁' m₀' m₁' e' f₀' q₀' U₀' f₁' q₁' U₁' G₀₁' G'₀₁'
      hPoU₀' hPoU₁' hInv₀₁' p₀' p₁' φ₀' η₁' p₀₁_0 p₀₁_1 hLoc_φ₀ hp₀ hp₁
      π₀' hπ₀_p₀ hLoc_π₀ π₁' hLoc_π₁ Φ Ψ hΦ_base hΨ_base hRoot01 hRoot10
    apply away_hom_ext_of (p₀' t₀') φ₀' hLoc_φ₀
    rw [RingHom.id_comp]
    ext x
    let F₀_L₀ : Fin m₀' → L₀ := fun r => p₀₁_0 (ι₀' (f₀' r))
    let Q₀_L₀ : Fin m₀' → L₀ := fun r => p₀₁_0 (ι₀' (q₀' r))
    have hPoU₀_L₀ : (∑ r : Fin m₀', Q₀_L₀ r * F₀_L₀ r) = 1 := by
      have h := congrArg (p₀₁_0.comp ι₀') hPoU₀'
      simpa only [F₀_L₀, Q₀_L₀, RingHom.comp_apply, map_sum, map_mul, map_one] using h
    apply pou_eq_of_away_eq F₀_L₀ Q₀_L₀ hPoU₀_L₀
    intro r
    let W_r := Localization.Away (F₀_L₀ r)
    let F₁_Wr : Fin m₁' → W_r := fun s => algebraMap L₀ W_r (p₀₁_0 (ι₁' (f₁' s)))
    let Q₁_Wr : Fin m₁' → W_r := fun s => algebraMap L₀ W_r (p₀₁_0 (ι₁' (q₁' s)))
    have hPoU₁_Wr : (∑ s : Fin m₁', Q₁_Wr s * F₁_Wr s) = 1 := by
      have h := congrArg ((algebraMap L₀ W_r).comp (p₀₁_0.comp ι₁')) hPoU₁'
      simpa only [F₁_Wr, Q₁_Wr, RingHom.comp_apply, map_sum, map_mul, map_one] using h
    apply pou_eq_of_away_eq F₁_Wr Q₁_Wr hPoU₁_Wr
    intro s
    let W_rs := Localization.Away (F₁_Wr s)
    let κ : L₀ →+* W_rs := (algebraMap W_r W_rs).comp (algebraMap L₀ W_r)
    have hu_fr : IsUnit (κ (p₀₁_0 (ι₀' (f₀' r)))) :=
      (IsLocalization.Away.algebraMap_isUnit (S := W_r) (F₀_L₀ r)).map
        (algebraMap W_r W_rs).toMonoidHom
    have hu_fs : IsUnit (κ (p₀₁_0 (ι₁' (f₁' s)))) :=
      IsLocalization.Away.algebraMap_isUnit (S := W_rs) (F₁_Wr s)
    have hp₀_eq : ∀ a : R₀', φ₀' (p₀' a) = p₀₁_0 (ι₀' a) := fun a => RingHom.congr_fun hp₀ a
    have hp₁_eq : ∀ b : R₁', η₁' (p₁' b) = p₀₁_1 (ι₁' b) := fun b => RingHom.congr_fun hp₁ b
    have hΦ_eq : ∀ z : R₀₁', Φ (p₀₁_1 z) = p₀₁_0 z := fun z => RingHom.congr_fun hΦ_base z
    have hΦΨ_p₀₁ : ∀ z : R₀₁', Φ (Ψ (p₀₁_0 z)) = p₀₁_0 z := fun z => by
      change (Φ.comp (Ψ.comp p₀₁_0)) z = p₀₁_0 z
      rw [hΨ_base, hΦ_base]
    obtain ⟨α_r1, hα_r1⟩ := away_lift_of (p₀' (f₀' r)) (π₀' r) (hLoc_π₀ r) (κ.comp φ₀') (by
      change IsUnit (κ (φ₀' (p₀' (f₀' r))))
      rw [hp₀_eq]; exact hu_fr)
    obtain ⟨α_s, hα_s⟩ := away_lift_of (p₁' (f₁' s)) (π₁' s) (hLoc_π₁ s)
      (κ.comp (Φ.comp η₁')) (by
      change IsUnit (κ (Φ (η₁' (p₁' (f₁' s)))))
      rw [hp₁_eq, hΦ_eq]; exact hu_fs)
    obtain ⟨α_r2, hα_r2⟩ := away_lift_of (p₀' (f₀' r)) (π₀' r) (hLoc_π₀ r)
      (κ.comp ((Φ.comp Ψ).comp φ₀')) (by
      change IsUnit (κ (Φ (Ψ (φ₀' (p₀' (f₀' r))))))
      rw [hp₀_eq, hΦΨ_p₀₁]; exact hu_fr)
    have hα_eq : α_r2 = α_r1 := by
      apply adjoinRoot_ext_pkg
      · apply away_hom_ext_of (f₀' r) (algebraMap R₀' (Localization.Away (f₀' r)))
          (away_std_toAlgebra (f₀' r))
        ext a
        have h1 := RingHom.congr_fun (hπ₀_p₀ r) a
        change α_r2 (((algebraMap (Localization.Away (f₀' r)) _).comp
            (algebraMap R₀' (Localization.Away (f₀' r)))) a) =
          α_r1 (((algebraMap (Localization.Away (f₀' r)) _).comp
            (algebraMap R₀' (Localization.Away (f₀' r)))) a)
        rw [← h1]
        change (α_r2.comp (π₀' r)) (p₀' a) = (α_r1.comp (π₀' r)) (p₀' a)
        rw [hα_r2, hα_r1]
        change κ (Φ (Ψ (φ₀' (p₀' a)))) = κ (φ₀' (p₀' a))
        rw [hp₀_eq, hΦΨ_p₀₁]
      · have h01 := hRoot01 r s W_rs α_r1 α_s κ hα_r1 hα_s
        have h10 := hRoot10 s r W_rs α_s α_r2 (κ.comp Φ)
          (by rwa [RingHom.comp_assoc])
          (by ext y; exact RingHom.congr_fun hα_r2 y)
        simp only [RingHom.comp_apply, hΦ_eq,
          mul_comm (ι₁' (f₁' s)) (ι₀' (f₀' r))] at h10
        let u_w : W_rs := κ (p₀₁_0 ((ι₀' (f₀' r) * ι₁' (f₁' s)) ^ e'))
        have hu_w2 : IsUnit (u_w * u_w) := by
          dsimp [u_w]
          rw [map_pow, map_pow, map_mul, map_mul]
          exact ((hu_fr.mul hu_fs).pow e').mul ((hu_fr.mul hu_fs).pow e')
        apply cancel_unit_left hu_w2
        calc (u_w * u_w) * α_r2 (AdjoinRoot.root _)
            = κ (p₀₁_0 ((ι₀' (f₀' r) * ι₁' (f₁' s)) ^ (2 * e'))) * α_r2 (AdjoinRoot.root _) := by
              dsimp [u_w]; rw [two_mul, pow_add, map_mul, map_mul]
          _ = κ (p₀₁_0 (G₀₁' r s)) * (κ (p₀₁_0 (G'₀₁' r s)) * α_r2 (AdjoinRoot.root _)) := by
              rw [← hInv₀₁' r s, map_mul, map_mul, mul_assoc]
          _ = u_w * (κ (p₀₁_0 (G₀₁' r s)) * α_s (AdjoinRoot.root _)) := by
              rw [← h10]; ring
          _ = (u_w * u_w) * α_r1 (AdjoinRoot.root _) := by
              rw [← h01]; ring
    change (κ.comp ((Φ.comp Ψ).comp φ₀')) x = (κ.comp φ₀') x
    rw [← hα_r2, ← hα_r1, hα_eq]

  have hs3_loc : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (t : A) (η : A →+* B),
      @IsLocalization.Away A _ t B _ η.toAlgebra →
      ∀ (Φ : B →+* C) (Ψ : C →+* B),
      Φ.comp Ψ = RingHom.id C → Ψ.comp Φ = RingHom.id B →
      @IsLocalization.Away A _ t C _ (Φ.comp η).toAlgebra := by
    intro A B C _ _ _ t η hLoc Φ Ψ hΦΨ hΨΦ
    letI : Algebra A B := η.toAlgebra
    letI : Algebra A C := (Φ.comp η).toAlgebra
    haveI : IsLocalization.Away t B := hLoc
    let e_ring : B ≃+* C :=
      { Φ with
        invFun := Ψ
        left_inv := fun x => RingHom.congr_fun hΨΦ x
        right_inv := fun y => RingHom.congr_fun hΦΨ y }
    let e_alg : B ≃ₐ[A] C := AlgEquiv.ofRingEquiv (f := e_ring) (fun _ => rfl)
    exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers t) e_alg

  
  
  
  obtain ⟨R_tilde₀, hCR₀, p₀, π₀, hπ₀_p₀, hLoc_π₀, hRoot00⟩ :=
    hs1 R₀ m₀ e T_ann f₀ U₀ G₀₀ G'₀₀ hDiag₀ hInv₀ hPow₀ hCocyc₀
  obtain ⟨R_tilde₁, hCR₁, p₁, π₁, hπ₁_p₁, hLoc_π₁, hRoot11⟩ :=
    hs1 R₁_ch m₁ e T_ann f₁ U₁ G₁₁ G'₁₁ hDiag₁ hInv₁ hPow₁ hCocyc₁
  letI : CommRing R_tilde₀ := hCR₀
  letI : CommRing R_tilde₁ := hCR₁
  let R_tilde₀₁ : Type u := Localization.Away (p₀ t₀)
  let hCR₀₁ : CommRing R_tilde₀₁ := inferInstance
  letI : CommRing R_tilde₀₁ := hCR₀₁
  let φ₀ : R_tilde₀ →+* R_tilde₀₁ := algebraMap R_tilde₀ R_tilde₀₁
  have hLoc_φ₀ : @IsLocalization.Away R_tilde₀ _ (p₀ t₀) R_tilde₀₁ _ φ₀.toAlgebra :=
    away_std_toAlgebra (p₀ t₀)
  let L₁ : Type u := Localization.Away (p₁ t₁)
  let η₁ : R_tilde₁ →+* L₁ := algebraMap R_tilde₁ L₁
  have hLoc_η₁ : @IsLocalization.Away R_tilde₁ _ (p₁ t₁) L₁ _ η₁.toAlgebra :=
    away_std_toAlgebra (p₁ t₁)
  obtain ⟨p₀₁, hp₀₁_eq⟩ := away_lift_of t₀ ι₀ hLoc₀ (φ₀.comp p₀)
    (IsLocalization.Away.algebraMap_isUnit (S := R_tilde₀₁) (p₀ t₀))
  have hφ₀_p₀ : φ₀.comp p₀ = p₀₁.comp ι₀ := hp₀₁_eq.symm
  obtain ⟨p₀₁_1, hp₀₁_1_eq⟩ := away_lift_of t₁ ι₁ hLoc₁ (η₁.comp p₁)
    (IsLocalization.Away.algebraMap_isUnit (S := L₁) (p₁ t₁))
  have hp₁ : η₁.comp p₁ = p₀₁_1.comp ι₁ := hp₀₁_1_eq.symm

  
  have hPow₀₁_ann0 : ∀ (r : Fin m₀) (s : Fin m₁),
      (ι₀ (f₀ r) * ι₁ (f₁ s)) ^ 0 *
        ((G₀₁ r s) ^ ℓ * ι₁ (U₁ s) - (ι₀ (f₀ r) * ι₁ (f₁ s)) ^ (ℓ * e) * ι₀ (U₀ r)) = 0 :=
    fun r s => by rw [pow_zero, one_mul, sub_eq_zero.mpr (hPow₀₁ r s)]
  obtain ⟨Φ, hΦ_base, hRoot01⟩ := hs2 t₁ ι₀ ι₁ hLoc₁ m₀ m₁ e T_ann 0
    f₀ q₀ U₀ G₀₀ f₁ q₁ U₁ G₁₁ G'₁₁ G₀₁ G'₀₁
    hPoU₀ hPoU₁ hInv₁ hInv₀₁ hPow₀₁_ann0 hCocyc₀₀₁ hCocyc₀₁₁
    p₀ p₁ φ₀ η₁ p₀₁ p₀₁_1 hLoc_η₁ hφ₀_p₀ hp₁
    π₀ hπ₀_p₀ hLoc_π₀ hRoot00 π₁ hπ₁_p₁ hLoc_π₁ hRoot11

  
  let G₁₀ : Fin m₁ → Fin m₀ → R₀₁ := fun s r => G'₀₁ r s
  let G'₁₀ : Fin m₁ → Fin m₀ → R₀₁ := fun s r => G₀₁ r s
  have hInv₁₀ : ∀ (s : Fin m₁) (r : Fin m₀),
      G₁₀ s r * G'₁₀ s r = (ι₁ (f₁ s) * ι₀ (f₀ r)) ^ (2 * e) :=
    fun s r => by dsimp [G₁₀, G'₁₀]; rw [mul_comm, mul_comm (ι₁ (f₁ s)), hInv₀₁ r s]
  have hPow₁₀_ann : ∀ (s : Fin m₁) (r : Fin m₀),
      (ι₁ (f₁ s) * ι₀ (f₀ r)) ^ (ℓ * e) *
        ((G₁₀ s r) ^ ℓ * ι₀ (U₀ r) - (ι₁ (f₁ s) * ι₀ (f₀ r)) ^ (ℓ * e) * ι₁ (U₁ s)) = 0 := by
    intro s r
    dsimp [G₁₀]
    rw [mul_comm (ι₁ (f₁ s)) (ι₀ (f₀ r))]
    calc (ι₀ (f₀ r) * ι₁ (f₁ s)) ^ (ℓ * e) *
          ((G'₀₁ r s) ^ ℓ * ι₀ (U₀ r) - (ι₀ (f₀ r) * ι₁ (f₁ s)) ^ (ℓ * e) * ι₁ (U₁ s))
        = (G'₀₁ r s) ^ ℓ * ((ι₀ (f₀ r) * ι₁ (f₁ s)) ^ (ℓ * e) * ι₀ (U₀ r)) -
            ((ι₀ (f₀ r) * ι₁ (f₁ s)) ^ (2 * e)) ^ ℓ * ι₁ (U₁ s) := by
          rw [← pow_mul, show 2 * e * ℓ = ℓ * e + ℓ * e by ring, pow_add]; ring
      _ = (G'₀₁ r s) ^ ℓ * ((G₀₁ r s) ^ ℓ * ι₁ (U₁ s)) -
            (G₀₁ r s * G'₀₁ r s) ^ ℓ * ι₁ (U₁ s) := by rw [← hPow₀₁ r s, ← hInv₀₁ r s]
      _ = 0 := by rw [mul_pow]; ring
  have hCocyc₁₁₀ : ∀ (s₁ s₂ : Fin m₁) (r₃ : Fin m₀),
      (ι₁ (f₁ s₁) * ι₁ (f₁ s₂) * ι₀ (f₀ r₃)) ^ (T_ann + 2 * e) *
        (ι₁ (G₁₁ s₁ s₂) * G₁₀ s₂ r₃ - (ι₁ (f₁ s₂)) ^ (2 * e) * G₁₀ s₁ r₃) = 0 := by
    intro s₁ s₂ r₃
    dsimp [G₁₀]
    calc (ι₁ (f₁ s₁) * ι₁ (f₁ s₂) * ι₀ (f₀ r₃)) ^ (T_ann + 2 * e) *
          (ι₁ (G₁₁ s₁ s₂) * G'₀₁ r₃ s₂ - (ι₁ (f₁ s₂)) ^ (2 * e) * G'₀₁ r₃ s₁)
        = (ι₁ (f₁ s₂)) ^ (2 * e) * (ι₀ (f₀ r₃) * ι₁ (f₁ s₁) * ι₁ (f₁ s₂)) ^ T_ann *
          ((ι₀ (f₀ r₃) * ι₁ (f₁ s₁)) ^ (2 * e) * ι₁ (G₁₁ s₁ s₂) * G'₀₁ r₃ s₂ -
            (ι₁ (f₁ s₁)) ^ (2 * e) * (ι₀ (f₀ r₃) * ι₁ (f₁ s₂)) ^ (2 * e) * G'₀₁ r₃ s₁) := by
          rw [pow_add, show ι₁ (f₁ s₁) * ι₁ (f₁ s₂) * ι₀ (f₀ r₃) =
            ι₀ (f₀ r₃) * ι₁ (f₁ s₁) * ι₁ (f₁ s₂) by ring]
          simp only [mul_pow]; ring
      _ = (ι₁ (f₁ s₂)) ^ (2 * e) * G'₀₁ r₃ s₁ * G'₀₁ r₃ s₂ *
          ((ι₀ (f₀ r₃) * ι₁ (f₁ s₁) * ι₁ (f₁ s₂)) ^ T_ann *
            (G₀₁ r₃ s₁ * ι₁ (G₁₁ s₁ s₂) - (ι₁ (f₁ s₁)) ^ (2 * e) * G₀₁ r₃ s₂)) := by
          rw [← hInv₀₁ r₃ s₁, ← hInv₀₁ r₃ s₂]; ring
      _ = 0 := by rw [hCocyc₀₁₁ r₃ s₁ s₂, mul_zero]
  have hCocyc₁₀₀ : ∀ (s₁ : Fin m₁) (r₂ r₃ : Fin m₀),
      (ι₁ (f₁ s₁) * ι₀ (f₀ r₂) * ι₀ (f₀ r₃)) ^ (T_ann + 2 * e) *
        (G₁₀ s₁ r₂ * ι₀ (G₀₀ r₂ r₃) - (ι₀ (f₀ r₂)) ^ (2 * e) * G₁₀ s₁ r₃) = 0 := by
    intro s₁ r₂ r₃
    dsimp [G₁₀]
    calc (ι₁ (f₁ s₁) * ι₀ (f₀ r₂) * ι₀ (f₀ r₃)) ^ (T_ann + 2 * e) *
          (G'₀₁ r₂ s₁ * ι₀ (G₀₀ r₂ r₃) - (ι₀ (f₀ r₂)) ^ (2 * e) * G'₀₁ r₃ s₁)
        = (ι₀ (f₀ r₂)) ^ (2 * e) * (ι₀ (f₀ r₂) * ι₀ (f₀ r₃) * ι₁ (f₁ s₁)) ^ T_ann *
          ((ι₀ (f₀ r₃) * ι₁ (f₁ s₁)) ^ (2 * e) * G'₀₁ r₂ s₁ * ι₀ (G₀₀ r₂ r₃) -
            (ι₀ (f₀ r₃)) ^ (2 * e) * (ι₀ (f₀ r₂) * ι₁ (f₁ s₁)) ^ (2 * e) * G'₀₁ r₃ s₁) := by
          rw [pow_add, show ι₁ (f₁ s₁) * ι₀ (f₀ r₂) * ι₀ (f₀ r₃) =
            ι₀ (f₀ r₂) * ι₀ (f₀ r₃) * ι₁ (f₁ s₁) by ring]
          simp only [mul_pow]; ring
      _ = (ι₀ (f₀ r₂)) ^ (2 * e) * G'₀₁ r₂ s₁ * G'₀₁ r₃ s₁ *
          ((ι₀ (f₀ r₂) * ι₀ (f₀ r₃) * ι₁ (f₁ s₁)) ^ T_ann *
            (ι₀ (G₀₀ r₂ r₃) * G₀₁ r₃ s₁ - (ι₀ (f₀ r₃)) ^ (2 * e) * G₀₁ r₂ s₁)) := by
          rw [← hInv₀₁ r₂ s₁, ← hInv₀₁ r₃ s₁]; ring
      _ = 0 := by rw [hCocyc₀₀₁ r₂ r₃ s₁, mul_zero]

  
  obtain ⟨Ψ, hΨ_base, hRoot10⟩ := hs2 t₀ ι₁ ι₀ hLoc₀ m₁ m₀ e (T_ann + 2 * e) (ℓ * e)
    f₁ q₁ U₁ G₁₁ f₀ q₀ U₀ G₀₀ G'₀₀ G₁₀ G'₁₀
    hPoU₁ hPoU₀ hInv₀ hInv₁₀ hPow₁₀_ann hCocyc₁₁₀ hCocyc₁₀₀
    p₁ p₀ η₁ φ₀ p₀₁_1 p₀₁ hLoc_φ₀ hp₁ hφ₀_p₀
    π₁ hπ₁_p₁ hLoc_π₁ hRoot11 π₀ hπ₀_p₀ hLoc_π₀ hRoot00

  
  have hΦΨ : Φ.comp Ψ = RingHom.id R_tilde₀₁ :=
    hs3_uniq t₀ ι₀ ι₁ m₀ m₁ e f₀ q₀ U₀ f₁ q₁ U₁ G₀₁ G'₀₁
      hPoU₀ hPoU₁ hInv₀₁ p₀ p₁ φ₀ η₁ p₀₁ p₀₁_1 hLoc_φ₀ hφ₀_p₀ hp₁
      π₀ hπ₀_p₀ hLoc_π₀ π₁ hLoc_π₁ Φ Ψ hΦ_base hΨ_base hRoot01 hRoot10
  have hΨΦ : Ψ.comp Φ = RingHom.id L₁ :=
    hs3_uniq t₁ ι₁ ι₀ m₁ m₀ e f₁ q₁ U₁ f₀ q₀ U₀ G₁₀ G'₁₀
      hPoU₁ hPoU₀ hInv₁₀ p₁ p₀ η₁ φ₀ p₀₁_1 p₀₁ hLoc_η₁ hp₁ hφ₀_p₀
      π₁ hπ₁_p₁ hLoc_π₁ π₀ hLoc_π₀ Ψ Φ hΨ_base hΦ_base hRoot10
      (fun r s W _ α_r α_s χ₀₁ hα_r hα_s => hRoot01 r s W α_r α_s χ₀₁ hα_r hα_s)
  let φ₁ : R_tilde₁ →+* R_tilde₀₁ := Φ.comp η₁
  have hφ₁_p₁ : φ₁.comp p₁ = p₀₁.comp ι₁ := by
    dsimp [φ₁]; rw [RingHom.comp_assoc, hp₁, ← RingHom.comp_assoc, hΦ_base]
  have hLoc_φ₁ : @IsLocalization.Away R_tilde₁ _ (p₁ t₁) R_tilde₀₁ _ φ₁.toAlgebra :=
    hs3_loc (p₁ t₁) η₁ hLoc_η₁ Φ Ψ hΦΨ hΨΦ
  exact ⟨R_tilde₀, R_tilde₁, R_tilde₀₁, hCR₀, hCR₁, hCR₀₁,
    p₀, p₁, p₀₁, φ₀, φ₁, π₀, π₁,
    hφ₀_p₀, hφ₁_p₁, hπ₀_p₀, hπ₁_p₁,
    hLoc_φ₀, hLoc_φ₁, hLoc_π₀, hLoc_π₁,
    hRoot00, hRoot11, hRoot01⟩

theorem weil_twoChart_affine_open_scheme_gluing : (∀ (R R_tilde : Type u) [CommRing R] [CommRing R_tilde]
       (p : R →+* R_tilde) (m : ℕ) (f q : Fin m → R)
       (T : Fin m → Type u) [∀ r, CommRing (T r)]
       (π : ∀ r : Fin m, R_tilde →+* T r)
       (α : ∀ r : Fin m, Localization.Away (f r) →+* T r),
       (∑ r : Fin m, q r * f r) = 1 →
       (∀ r : Fin m, (π r).comp p = (α r).comp (algebraMap R (Localization.Away (f r)))) →
       (∀ r : Fin m, @IsLocalization.Away R_tilde _ (p (f r)) (T r) _ (π r).toAlgebra) →
       (∀ r : Fin m, (α r).Finite ∧ (α r).Etale ∧ Function.Surjective (PrimeSpectrum.comap (α r))) →
       AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p)) ∧
       AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p)) ∧
       AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p))) ∧
    (∀ (R₀ R₁_ch R₀₁ : Type u) [CommRing R₀] [CommRing R₁_ch] [CommRing R₀₁]
       (t₀ : R₀) (t₁ : R₁_ch) (ι₀ : R₀ →+* R₀₁) (ι₁ : R₁_ch →+* R₀₁),
       @IsLocalization.Away R₀ _ t₀ R₀₁ _ ι₀.toAlgebra →
       @IsLocalization.Away R₁_ch _ t₁ R₀₁ _ ι₁.toAlgebra →
       ∀ (Y : AlgebraicGeometry.Scheme.{u})
         (j₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ Y)
         (j₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁_ch) ⟶ Y)
         [AlgebraicGeometry.IsOpenImmersion j₀] [AlgebraicGeometry.IsOpenImmersion j₁],
         Set.range j₀.base ∪ Set.range j₁.base = Set.univ →
         CategoryTheory.IsPullback
           (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))
           (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)) j₀ j₁ →
         ∀ (R_tilde₀ R_tilde₁ R_tilde₀₁ : Type u)
           [CommRing R_tilde₀] [CommRing R_tilde₁] [CommRing R_tilde₀₁]
           (p₀ : R₀ →+* R_tilde₀) (p₁ : R₁_ch →+* R_tilde₁) (p₀₁ : R₀₁ →+* R_tilde₀₁)
           (φ₀ : R_tilde₀ →+* R_tilde₀₁) (φ₁ : R_tilde₁ →+* R_tilde₀₁),
           φ₀.comp p₀ = p₀₁.comp ι₀ →
           φ₁.comp p₁ = p₀₁.comp ι₁ →
           @IsLocalization.Away R_tilde₀ _ (p₀ t₀) R_tilde₀₁ _ φ₀.toAlgebra →
           @IsLocalization.Away R_tilde₁ _ (p₁ t₁) R_tilde₀₁ _ φ₁.toAlgebra →
           ∃ (Y_raw : AlgebraicGeometry.Scheme.{u})
             (ν : Y_raw ⟶ Y)
             (i_tilde₀ : AlgebraicGeometry.Spec (CommRingCat.of R_tilde₀) ⟶ Y_raw)
             (i_tilde₁ : AlgebraicGeometry.Spec (CommRingCat.of R_tilde₁) ⟶ Y_raw),
             AlgebraicGeometry.IsOpenImmersion i_tilde₀ ∧
             AlgebraicGeometry.IsOpenImmersion i_tilde₁ ∧
             AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ i_tilde₀ =
               AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ i_tilde₁ ∧
             CategoryTheory.IsPullback
               (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀))
               (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁))
               i_tilde₀ i_tilde₁ ∧
             CategoryTheory.IsPullback i_tilde₀
               (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)) ν j₀ ∧
             CategoryTheory.IsPullback i_tilde₁
               (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)) ν j₁ ∧
             (AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)) →
              AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)) →
              AlgebraicGeometry.IsFinite ν) ∧
             (AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)) →
              AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)) →
              AlgebraicGeometry.Etale ν) ∧
             (AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)) →
              AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)) →
              AlgebraicGeometry.Surjective ν)) :=
by
  have res_eq_comp_iso_of_isPullback_openImmersion :
      ∀ {U V X Y : AlgebraicGeometry.Scheme.{u}}
        (g : U ⟶ V) (iU : U ⟶ X) (iV : V ⟶ Y) (f : X ⟶ Y)
        [AlgebraicGeometry.IsOpenImmersion iV],
        CategoryTheory.IsPullback g iU iV f →
        let W : Y.Opens := iV.opensRange
        let W' : X.Opens := (TopologicalSpace.Opens.map f.base).obj W
        ∃ (eU : U ≅ W'.toScheme) (eV : V ≅ W.toScheme),
          f ∣_ W = eU.inv ≫ g ≫ eV.hom := by
    intro U V X Y g iU iV f _ hPb
    let W : Y.Opens := iV.opensRange
    let W' : X.Opens := (TopologicalSpace.Opens.map f.base).obj W
    let eV : V ≅ W.toScheme := iV.isoOpensRange
    have hPb_eV : CategoryTheory.IsPullback iV eV.hom (CategoryTheory.CategoryStruct.id Y) W.ι :=
      CategoryTheory.IsPullback.of_vert_isIso ⟨by
        rw [Category.comp_id]
        exact (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι iV).symm⟩
    have hPb' : CategoryTheory.IsPullback (g ≫ eV.hom) iU W.ι f := by
      simpa [Category.comp_id] using (hPb.flip.paste_vert hPb_eV).flip
    have hPb_res : CategoryTheory.IsPullback (f ∣_ W) W'.ι W.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f W
    let eU : U ≅ W'.toScheme := CategoryTheory.IsPullback.isoIsPullback _ _ hPb' hPb_res
    have heU_fst : eU.hom ≫ (f ∣_ W) = g ≫ eV.hom :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb' hPb_res
    exact ⟨eU, eV, (Iso.eq_inv_comp eU).mpr heU_fst⟩
  haveI : AlgebraicGeometry.IsZariskiLocalAtTarget (@AlgebraicGeometry.IsFinite.{u}) :=
    @AlgebraicGeometry.HasAffineProperty.instIsZariskiLocalAtTarget
      (@AlgebraicGeometry.IsFinite.{u}) _
      AlgebraicGeometry.IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop
  haveI : AlgebraicGeometry.IsZariskiLocalAtTarget (@AlgebraicGeometry.Etale.{u}) :=
    @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtTarget
      (@AlgebraicGeometry.Etale.{u}) _ inferInstance
  refine ⟨?_, ?_⟩
  · intro R R_tilde _ _ p m f q T _ π α hPoU hcomm hLocT hPropα
    let sp_p := AlgebraicGeometry.Spec.map (CommRingCat.ofHom p)
    let iV : ∀ r : Fin m, AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (f r))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (f r))))
    haveI : ∀ r : Fin m, AlgebraicGeometry.IsOpenImmersion (iV r) :=
      fun r => AlgebraicGeometry.IsOpenImmersion.of_isLocalization (f r)
    have hPb_r : ∀ r : Fin m,
        ∃ (iU : AlgebraicGeometry.Spec (CommRingCat.of (T r)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of R_tilde)),
          AlgebraicGeometry.IsOpenImmersion iU ∧
          CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α r)))
            iU (iV r) sp_p := by
      intro r
      let alg_r : Algebra R_tilde (T r) := (π r).toAlgebra
      letI : Algebra R_tilde (T r) := alg_r
      haveI : IsLocalization.Away (p (f r)) (T r) := hLocT r
      let iU := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π r))
      have hOpenU : AlgebraicGeometry.IsOpenImmersion iU :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization (p (f r))
      haveI : AlgebraicGeometry.IsOpenImmersion iU := hOpenU
      have hsq : iU ≫ sp_p = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α r)) ≫ iV r := by
        dsimp only [iU, sp_p, iV]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomm r]
      have hrange : (TopologicalSpace.Opens.map sp_p.base).obj (iV r).opensRange = iU.opensRange := by
        ext x
        let x' : PrimeSpectrum R_tilde := x
        change PrimeSpectrum.comap p x' ∈
            Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away (f r)))) ↔
          x' ∈ Set.range (PrimeSpectrum.comap (algebraMap R_tilde (T r)))
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (f r)) (f r),
          PrimeSpectrum.localization_away_comap_range (T r) (p (f r))]
        rfl
      exact ⟨iU, hOpenU, AlgebraicGeometry.IsOpenImmersion.isPullback _ iU (iV r) sp_p hsq hrange⟩
    have hTop : (⨆ r : Fin m, (iV r).opensRange) = ⊤ := by
      have hspan : Ideal.span (Set.range f) = ⊤ := by
        rw [Ideal.eq_top_iff_one, ← hPoU]
        exact Ideal.sum_mem _ fun r _ => Ideal.mul_mem_left _ (q r) (Ideal.subset_span ⟨r, rfl⟩)
      have hbo : (⨆ r : Fin m, PrimeSpectrum.basicOpen (f r)) = ⊤ :=
        PrimeSpectrum.iSup_basicOpen_eq_top_iff.mpr hspan
      ext x
      simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top,
        Set.mem_iUnion, Set.mem_univ, iff_true]
      let x' : PrimeSpectrum R := x
      have hx' : x' ∈ (⨆ r : Fin m, PrimeSpectrum.basicOpen (f r)) := by
        rw [hbo]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hx'
      obtain ⟨r, hr⟩ := hx'
      refine ⟨r, ?_⟩
      change x' ∈ Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away (f r))))
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (f r)) (f r)]
      exact hr
    refine ⟨?_, ?_, ?_⟩
    · refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
        (P := @AlgebraicGeometry.IsFinite.{u}) (fun r => (iV r).opensRange) hTop ?_
      intro r
      obtain ⟨iU, _, hPb⟩ := hPb_r r
      haveI : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α r))) :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom (α r))).mpr (hPropα r).1
      obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ iU (iV r) sp_p hPb
      change AlgebraicGeometry.IsFinite (sp_p ∣_ (iV r).opensRange)
      rw [hres]; infer_instance
    · refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
        (P := @AlgebraicGeometry.Etale.{u}) (fun r => (iV r).opensRange) hTop ?_
      intro r
      obtain ⟨iU, _, hPb⟩ := hPb_r r
      haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α r))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale.{u})).mpr (hPropα r).2.1
      obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ iU (iV r) sp_p hPb
      change AlgebraicGeometry.Etale (sp_p ∣_ (iV r).opensRange)
      rw [hres]; infer_instance
    · refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
        (P := @AlgebraicGeometry.Surjective.{u}) (fun r => (iV r).opensRange) hTop ?_
      intro r
      obtain ⟨iU, _, hPb⟩ := hPb_r r
      haveI : AlgebraicGeometry.Surjective (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α r))) := by
        rw [AlgebraicGeometry.surjective_iff]
        exact (hPropα r).2.2
      obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ iU (iV r) sp_p hPb
      change AlgebraicGeometry.Surjective (sp_p ∣_ (iV r).opensRange)
      rw [hres]; infer_instance
  · intro R₀ R₁_ch R₀₁ _ _ _ t₀ t₁ ι₀ ι₁ hLoc₀ hLoc₁ Y j₀ j₁ _ _ hCov hPb
      R_tilde₀ R_tilde₁ R_tilde₀₁ _ _ _ p₀ p₁ p₀₁ φ₀ φ₁ hp₀ hp₁ hLoc_t₀ hLoc_t₁
    let alg₀ : Algebra R₀ R₀₁ := ι₀.toAlgebra
    let alg₁ : Algebra R₁_ch R₀₁ := ι₁.toAlgebra
    let alg_t₀ : Algebra R_tilde₀ R_tilde₀₁ := φ₀.toAlgebra
    let alg_t₁ : Algebra R_tilde₁ R_tilde₀₁ := φ₁.toAlgebra
    letI : Algebra R₀ R₀₁ := alg₀
    letI : Algebra R₁_ch R₀₁ := alg₁
    letI : Algebra R_tilde₀ R_tilde₀₁ := alg_t₀
    letI : Algebra R_tilde₁ R_tilde₀₁ := alg_t₁
    haveI : IsLocalization.Away t₀ R₀₁ := hLoc₀
    haveI : IsLocalization.Away t₁ R₀₁ := hLoc₁
    haveI : IsLocalization.Away (p₀ t₀) R_tilde₀₁ := hLoc_t₀
    haveI : IsLocalization.Away (p₁ t₁) R_tilde₀₁ := hLoc_t₁
    let U₀ := AlgebraicGeometry.Spec (CommRingCat.of R_tilde₀)
    let U₁ := AlgebraicGeometry.Spec (CommRingCat.of R_tilde₁)
    let V₀₁ := AlgebraicGeometry.Spec (CommRingCat.of R_tilde₀₁)
    let f₀₁ : V₀₁ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)
    let f₁₀ : V₀₁ ⟶ U₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)
    haveI : AlgebraicGeometry.IsOpenImmersion f₀₁ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (p₀ t₀)
    haveI : AlgebraicGeometry.IsOpenImmersion f₁₀ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (p₁ t₁)
    let J := ULift.{u} Bool
    let U_J : J → AlgebraicGeometry.Scheme.{u} := fun
      | ⟨false⟩ => U₀
      | ⟨true⟩ => U₁
    let V_J : J × J → AlgebraicGeometry.Scheme.{u} := fun
      | (⟨false⟩, ⟨false⟩) => U₀
      | (⟨true⟩, ⟨true⟩) => U₁
      | (⟨false⟩, ⟨true⟩) => V₀₁
      | (⟨true⟩, ⟨false⟩) => V₀₁
    let f_J : ∀ (i j : J), V_J (i, j) ⟶ U_J i := fun
      | ⟨false⟩, ⟨false⟩ => 𝟙 U₀
      | ⟨true⟩, ⟨true⟩ => 𝟙 U₁
      | ⟨false⟩, ⟨true⟩ => f₀₁
      | ⟨true⟩, ⟨false⟩ => f₁₀
    have hf_open : ∀ (i j : J), AlgebraicGeometry.IsOpenImmersion (f_J i j) := by
      rintro ⟨false | true⟩ ⟨false | true⟩ <;> dsimp [f_J] <;> infer_instance
    have hf_mono : ∀ (i j : J), CategoryTheory.Mono (f_J i j) := by
      intro i j; haveI := hf_open i j; infer_instance
    have hf_pb : ∀ (i j k : J), CategoryTheory.Limits.HasPullback (f_J i j) (f_J i k) := by
      intro i j k; haveI := hf_open i k; infer_instance
    have hf_id : ∀ (i : J), CategoryTheory.IsIso (f_J i i) := by
      rintro ⟨false | true⟩ <;> dsimp [f_J] <;> infer_instance
    let t_J : ∀ (i j : J), V_J (i, j) ⟶ V_J (j, i) := fun
      | ⟨false⟩, ⟨false⟩ => 𝟙 U₀
      | ⟨true⟩, ⟨true⟩ => 𝟙 U₁
      | ⟨false⟩, ⟨true⟩ => 𝟙 V₀₁
      | ⟨true⟩, ⟨false⟩ => 𝟙 V₀₁
    have ht_id : ∀ (i : J), t_J i i = 𝟙 (V_J (i, i)) := by
      rintro ⟨false | true⟩ <;> rfl
    let t'_J : ∀ (i j k : J),
        CategoryTheory.Limits.pullback (f_J i j) (f_J i k) ⟶
          CategoryTheory.Limits.pullback (f_J j k) (f_J j i) := fun
      | ⟨false⟩, ⟨false⟩, ⟨false⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.fst _ _)
          (CategoryTheory.Limits.pullback.fst _ _) rfl
      | ⟨false⟩, ⟨false⟩, ⟨true⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.snd _ _)
          (CategoryTheory.Limits.pullback.fst _ _) (CategoryTheory.Limits.pullback.condition.symm)
      | ⟨false⟩, ⟨true⟩, ⟨false⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.fst _ _)
          (CategoryTheory.Limits.pullback.fst _ _) rfl
      | ⟨false⟩, ⟨true⟩, ⟨true⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.fst _ _ ≫ f₁₀)
          (CategoryTheory.Limits.pullback.fst _ _) (Category.comp_id _)
      | ⟨true⟩, ⟨false⟩, ⟨false⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.fst _ _ ≫ f₀₁)
          (CategoryTheory.Limits.pullback.fst _ _) (Category.comp_id _)
      | ⟨true⟩, ⟨false⟩, ⟨true⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.fst _ _)
          (CategoryTheory.Limits.pullback.fst _ _) rfl
      | ⟨true⟩, ⟨true⟩, ⟨false⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.snd _ _)
          (CategoryTheory.Limits.pullback.fst _ _) (CategoryTheory.Limits.pullback.condition.symm)
      | ⟨true⟩, ⟨true⟩, ⟨true⟩ =>
        CategoryTheory.Limits.pullback.lift (CategoryTheory.Limits.pullback.fst _ _)
          (CategoryTheory.Limits.pullback.fst _ _) rfl
    have ht_fac : ∀ (i j k : J),
        t'_J i j k ≫ CategoryTheory.Limits.pullback.snd (f_J j k) (f_J j i) =
          CategoryTheory.Limits.pullback.fst (f_J i j) (f_J i k) ≫ t_J i j := by
      rintro ⟨false | true⟩ ⟨false | true⟩ ⟨false | true⟩ <;>
        (dsimp only [t'_J, t_J]; rw [CategoryTheory.Limits.pullback.lift_snd, Category.comp_id])
    have hcocyc : ∀ (i j k : J),
        t'_J i j k ≫ t'_J j k i ≫ t'_J k i j =
          𝟙 (CategoryTheory.Limits.pullback (f_J i j) (f_J i k)) := by
      intro i j k
      haveI := hf_mono i j
      haveI := hf_mono i k
      have hcond := CategoryTheory.Limits.pullback.condition (f := f_J i j) (g := f_J i k)
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [← cancel_mono (f_J i j)]
        rcases i with ⟨false | true⟩ <;> rcases j with ⟨false | true⟩ <;> rcases k with ⟨false | true⟩ <;>
        · dsimp only [U_J, V_J, t'_J, f_J] at hcond ⊢
          simp only [Category.assoc, Category.id_comp, Category.comp_id,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Limits.pullback.lift_snd_assoc] at hcond ⊢
          try (first | exact hcond | exact hcond.symm)
      · rw [← cancel_mono (f_J i k)]
        rcases i with ⟨false | true⟩ <;> rcases j with ⟨false | true⟩ <;> rcases k with ⟨false | true⟩ <;>
        · dsimp only [U_J, V_J, t'_J, f_J] at hcond ⊢
          simp only [Category.assoc, Category.id_comp, Category.comp_id,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_fst_assoc, CategoryTheory.Limits.pullback.lift_snd_assoc] at hcond ⊢
          try (first | exact hcond | exact hcond.symm)
    let GD₀ : CategoryTheory.GlueData AlgebraicGeometry.Scheme.{u} :=
      { J := J
        U := U_J
        V := V_J
        f := f_J
        f_mono := hf_mono
        f_hasPullback := hf_pb
        f_id := hf_id
        t := t_J
        t_id := ht_id
        t' := t'_J
        t_fac := ht_fac
        cocycle := hcocyc }
    let GD : AlgebraicGeometry.Scheme.GlueData := AlgebraicGeometry.Scheme.GlueData.mk GD₀ hf_open
    haveI : CategoryTheory.Limits.HasMulticoequalizer GD.toGlueData.diagram :=
      AlgebraicGeometry.Scheme.GlueData.instHasMulticoequalizerDiagram GD
    let Y_raw : AlgebraicGeometry.Scheme.{u} := GD.glued
    let i_tilde₀ : U₀ ⟶ Y_raw := GD.ι ⟨false⟩
    let i_tilde₁ : U₁ ⟶ Y_raw := GD.ι ⟨true⟩
    have hOpen_i₀ : AlgebraicGeometry.IsOpenImmersion i_tilde₀ := GD.ι_isOpenImmersion ⟨false⟩
    have hOpen_i₁ : AlgebraicGeometry.IsOpenImmersion i_tilde₁ := GD.ι_isOpenImmersion ⟨true⟩
    haveI : AlgebraicGeometry.IsOpenImmersion i_tilde₀ := hOpen_i₀
    haveI : AlgebraicGeometry.IsOpenImmersion i_tilde₁ := hOpen_i₁
    haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization t₀
    haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization t₁
    have hPb_cone : CategoryTheory.IsPullback f₀₁ (𝟙 V₀₁ ≫ f₁₀) i_tilde₀ i_tilde₁ :=
      CategoryTheory.IsPullback.of_isLimit (GD.vPullbackConeIsLimit ⟨false⟩ ⟨true⟩)
    have hPb_raw : CategoryTheory.IsPullback f₀₁ f₁₀ i_tilde₀ i_tilde₁ := by
      rw [Category.id_comp] at hPb_cone
      exact hPb_cone
    have hcomm_raw : f₀₁ ≫ i_tilde₀ = f₁₀ ≫ i_tilde₁ := hPb_raw.w
    let k_Y : ∀ (b : J), U_J b ⟶ Y := fun
      | ⟨false⟩ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) ≫ j₀
      | ⟨true⟩ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) ≫ j₁
    have h_ov : f₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) ≫ j₀ =
        f₁₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) ≫ j₁ := by
      have h0 : f₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀) := by
        dsimp only [f₀₁]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hp₀]
      have h1 : f₁₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁) := by
        dsimp only [f₁₀]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hp₁]
      calc f₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) ≫ j₀
          = (f₀₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)) ≫ j₀ :=
            (Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀₁) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀) ≫ j₀) := by
            rw [h0, Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀₁) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)) ≫ j₁ := by
            rw [hPb.w, Category.assoc]
        _ = f₁₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) ≫ j₁ := by
            rw [← h1, Category.assoc]
    have hk_Y : ∀ (a : (CategoryTheory.Limits.MultispanShape.prod J).L),
        GD.toGlueData.diagram.fst a ≫ k_Y a.1 =
        GD.toGlueData.diagram.snd a ≫ k_Y a.2 := by
      intro a
      change f_J a.1 a.2 ≫ k_Y a.1 = (t_J a.1 a.2 ≫ f_J a.2 a.1) ≫ k_Y a.2
      rcases a with ⟨⟨false | true⟩, ⟨false | true⟩⟩
      · dsimp only [U_J, V_J, f_J, t_J, k_Y]; simp only [Category.id_comp]
      · dsimp only [U_J, V_J, f_J, t_J, k_Y]; rw [Category.id_comp]; exact h_ov
      · dsimp only [U_J, V_J, f_J, t_J, k_Y]; rw [Category.id_comp]; exact h_ov.symm
      · dsimp only [U_J, V_J, f_J, t_J, k_Y]; simp only [Category.id_comp]
    let ν : Y_raw ⟶ Y := CategoryTheory.Limits.Multicoequalizer.desc GD.toGlueData.diagram Y k_Y hk_Y
    have hν₀ : i_tilde₀ ≫ ν = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) ≫ j₀ :=
      CategoryTheory.Limits.Multicoequalizer.π_desc GD.toGlueData.diagram Y k_Y hk_Y ⟨false⟩
    have hν₁ : i_tilde₁ ≫ ν = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) ≫ j₁ :=
      CategoryTheory.Limits.Multicoequalizer.π_desc GD.toGlueData.diagram Y k_Y hk_Y ⟨true⟩
    have hCov_raw : ∀ y : Y_raw, y ∈ Set.range i_tilde₀.base ∨ y ∈ Set.range i_tilde₁.base := by
      intro y
      have hy : y ∈ (⨆ i : GD.openCover.I₀, (GD.openCover.f i).opensRange) := by
        rw [GD.openCover.iSup_opensRange]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hy
      rcases hy with ⟨⟨false | true⟩, hz⟩
      · left; exact hz
      · right; exact hz
    have hrange₀ : (TopologicalSpace.Opens.map ν.base).obj j₀.opensRange = i_tilde₀.opensRange := by
      ext y
      change ν.base y ∈ Set.range j₀.base ↔ y ∈ Set.range i_tilde₀.base
      constructor
      · intro hy
        rcases hCov_raw y with h0 | ⟨x₁, rfl⟩
        · exact h0
        · obtain ⟨x₀, hx₀⟩ := hy
          have h_eq : j₀.base x₀ = j₁.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)).base x₁) := by
            rw [← Scheme.Hom.comp_apply, ← hν₁, Scheme.Hom.comp_apply, hx₀]
          have hx₁_mem : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)).base x₁ ∈
              Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)).base := by
            have hmem : j₁.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)).base x₁) ∈
                Set.range j₀.base := ⟨x₀, h_eq⟩
            have hpb_set := congrArg (fun W : (AlgebraicGeometry.Spec (CommRingCat.of R₁_ch)).Opens =>
                (W : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₁_ch))))
              (AlgebraicGeometry.IsOpenImmersion.image_preimage_eq_preimage_image_of_isPullback
                hPb ⊤)
            have htop : ((AlgebraicGeometry.Scheme.Hom.opensFunctor
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁))).obj
                ((TopologicalSpace.Opens.map
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)).base).obj ⊤) :
                Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₁_ch))) =
                Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)).base := by
              ext z; simp [AlgebraicGeometry.Scheme.Hom.opensFunctor]
            have hbot : ((TopologicalSpace.Opens.map j₁.base).obj
                ((AlgebraicGeometry.Scheme.Hom.opensFunctor j₀).obj ⊤) :
                Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₁_ch))) =
                j₁.base ⁻¹' Set.range j₀.base := by
              ext z; simp [AlgebraicGeometry.Scheme.Hom.opensFunctor]
            rw [← htop, hpb_set, hbot]
            exact hmem
          let x₁' : PrimeSpectrum R_tilde₁ := x₁
          have hx₁_bo : PrimeSpectrum.comap p₁ x₁' ∈
              Set.range (PrimeSpectrum.comap (algebraMap R₁_ch R₀₁)) := hx₁_mem
          rw [PrimeSpectrum.localization_away_comap_range R₀₁ t₁] at hx₁_bo
          have hx₁_range : x₁' ∈ Set.range (PrimeSpectrum.comap (algebraMap R_tilde₁ R_tilde₀₁)) := by
            rw [PrimeSpectrum.localization_away_comap_range R_tilde₀₁ (p₁ t₁)]
            exact hx₁_bo
          obtain ⟨z₀₁, hz₀₁⟩ := hx₁_range
          let z₀₁' : V₀₁ := z₀₁
          have hz₀₁' : f₁₀.base z₀₁' = x₁ := hz₀₁
          rw [← hz₀₁']
          refine ⟨f₀₁.base z₀₁', ?_⟩
          rw [← Scheme.Hom.comp_apply, hcomm_raw, Scheme.Hom.comp_apply]
      · rintro ⟨x₀, rfl⟩
        refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)).base x₀, ?_⟩
        rw [← Scheme.Hom.comp_apply, ← hν₀, Scheme.Hom.comp_apply]
    have hrange₁ : (TopologicalSpace.Opens.map ν.base).obj j₁.opensRange = i_tilde₁.opensRange := by
      ext y
      change ν.base y ∈ Set.range j₁.base ↔ y ∈ Set.range i_tilde₁.base
      constructor
      · intro hy
        rcases hCov_raw y with ⟨x₀, rfl⟩ | h1
        · obtain ⟨x₁, hx₁⟩ := hy
          have h_eq : j₁.base x₁ = j₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)).base x₀) := by
            rw [← Scheme.Hom.comp_apply, ← hν₀, Scheme.Hom.comp_apply, hx₁]
          have hx₀_mem : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)).base x₀ ∈
              Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)).base := by
            have hmem : j₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)).base x₀) ∈
                Set.range j₁.base := ⟨x₁, h_eq⟩
            have hpb_set := congrArg (fun W : (AlgebraicGeometry.Spec (CommRingCat.of R₀)).Opens =>
                (W : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀))))
              (AlgebraicGeometry.IsOpenImmersion.image_preimage_eq_preimage_image_of_isPullback
                hPb.flip ⊤)
            have htop : ((AlgebraicGeometry.Scheme.Hom.opensFunctor
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))).obj
                ((TopologicalSpace.Opens.map
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁)).base).obj ⊤) :
                Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀))) =
                Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)).base := by
              ext z; simp [AlgebraicGeometry.Scheme.Hom.opensFunctor]
            have hbot : ((TopologicalSpace.Opens.map j₀.base).obj
                ((AlgebraicGeometry.Scheme.Hom.opensFunctor j₁).obj ⊤) :
                Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀))) =
                j₀.base ⁻¹' Set.range j₁.base := by
              ext z; simp [AlgebraicGeometry.Scheme.Hom.opensFunctor]
            rw [← htop, hpb_set, hbot]
            exact hmem
          let x₀' : PrimeSpectrum R_tilde₀ := x₀
          have hx₀_bo : PrimeSpectrum.comap p₀ x₀' ∈
              Set.range (PrimeSpectrum.comap (algebraMap R₀ R₀₁)) := hx₀_mem
          rw [PrimeSpectrum.localization_away_comap_range R₀₁ t₀] at hx₀_bo
          have hx₀_range : x₀' ∈ Set.range (PrimeSpectrum.comap (algebraMap R_tilde₀ R_tilde₀₁)) := by
            rw [PrimeSpectrum.localization_away_comap_range R_tilde₀₁ (p₀ t₀)]
            exact hx₀_bo
          obtain ⟨z₀₁, hz₀₁⟩ := hx₀_range
          let z₀₁' : V₀₁ := z₀₁
          have hz₀₁' : f₀₁.base z₀₁' = x₀ := hz₀₁
          rw [← hz₀₁']
          refine ⟨f₁₀.base z₀₁', ?_⟩
          rw [← Scheme.Hom.comp_apply, ← hcomm_raw, Scheme.Hom.comp_apply]
        · exact h1
      · rintro ⟨x₁, rfl⟩
        refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)).base x₁, ?_⟩
        rw [← Scheme.Hom.comp_apply, ← hν₁, Scheme.Hom.comp_apply]
    have hPb₀ : CategoryTheory.IsPullback i_tilde₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)) ν j₀ :=
      (AlgebraicGeometry.IsOpenImmersion.isPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀)) i_tilde₀ j₀ ν hν₀ hrange₀).flip
    have hPb₁ : CategoryTheory.IsPullback i_tilde₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)) ν j₁ :=
      (AlgebraicGeometry.IsOpenImmersion.isPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)) i_tilde₁ j₁ ν hν₁ hrange₁).flip
    let covY : Bool → Y.Opens := fun b => Bool.rec j₀.opensRange j₁.opensRange b
    have hTopY : iSup covY = ⊤ := by
      ext y
      simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top, Set.mem_iUnion,
        Set.mem_univ, iff_true]
      have hy : y ∈ Set.range j₀.base ∪ Set.range j₁.base := hCov.symm ▸ Set.mem_univ y
      rcases hy with h0 | h1
      · exact ⟨false, h0⟩
      · exact ⟨true, h1⟩
    refine ⟨Y_raw, ν, i_tilde₀, i_tilde₁, hOpen_i₀, hOpen_i₁, hcomm_raw, hPb_raw, hPb₀, hPb₁,
      ?_, ?_, ?_⟩
    · intro h0 h1
      haveI := h0; haveI := h1
      refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
        (P := @AlgebraicGeometry.IsFinite.{u}) covY hTopY ?_
      rintro (false | true)
      · obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ i_tilde₀ j₀ ν hPb₀.flip
        change AlgebraicGeometry.IsFinite (ν ∣_ j₀.opensRange)
        rw [hres]; infer_instance
      · obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ i_tilde₁ j₁ ν hPb₁.flip
        change AlgebraicGeometry.IsFinite (ν ∣_ j₁.opensRange)
        rw [hres]; infer_instance
    · intro h0 h1
      haveI := h0; haveI := h1
      refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
        (P := @AlgebraicGeometry.Etale.{u}) covY hTopY ?_
      rintro (false | true)
      · obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ i_tilde₀ j₀ ν hPb₀.flip
        change AlgebraicGeometry.Etale (ν ∣_ j₀.opensRange)
        rw [hres]; infer_instance
      · obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ i_tilde₁ j₁ ν hPb₁.flip
        change AlgebraicGeometry.Etale (ν ∣_ j₁.opensRange)
        rw [hres]; infer_instance
    · intro h0 h1
      haveI := h0; haveI := h1
      refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
        (P := @AlgebraicGeometry.Surjective.{u}) covY hTopY ?_
      rintro (false | true)
      · obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ i_tilde₀ j₀ ν hPb₀.flip
        change AlgebraicGeometry.Surjective (ν ∣_ j₀.opensRange)
        rw [hres]; infer_instance
      · obtain ⟨eU, eV, hres⟩ := res_eq_comp_iso_of_isPullback_openImmersion _ i_tilde₁ j₁ ν hPb₁.flip
        change AlgebraicGeometry.Surjective (ν ∣_ j₁.opensRange)
        rw [hres]; infer_instance

theorem weil_twoChart_baseChange_adjoinRoot_open_charts (ℓ : ℕ)
    (R_B R_tilde : Type u) [CommRing R_B] [CommRing R_tilde]
    (p_B : R_B →+* R_tilde)
    (Y_B₀ Y_raw : AlgebraicGeometry.Scheme.{u})
    (ν_B₀ : Y_raw ⟶ Y_B₀)
    (j_B : AlgebraicGeometry.Spec (CommRingCat.of R_B) ⟶ Y_B₀)
    (i_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_tilde) ⟶ Y_raw)
    [AlgebraicGeometry.IsOpenImmersion j_B]
    [AlgebraicGeometry.IsOpenImmersion i_tilde]
    (hPb_chart : CategoryTheory.IsPullback i_tilde
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_B)) ν_B₀ j_B)
    (m : ℕ) (f_B U_B : Fin m → R_B)
    (π_B : ∀ r : Fin m, R_tilde →+* AdjoinRoot
      ((Polynomial.X : Polynomial (Localization.Away (f_B r))) ^ ℓ -
