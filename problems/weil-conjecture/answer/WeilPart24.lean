      let u1 := (IsLocalization.map_units Stk m).unit
      let u2 := (IsLocalization.map_units Stk m').unit
      have hu1_val : (u1 : Stk) = algebraMap ↑(C_sch.presheaf.obj (Opposite.op V)) Stk m :=
        IsUnit.unit_spec _
      have hu2_val : (u2 : Stk) = algebraMap ↑(C_sch.presheaf.obj (Opposite.op V)) Stk m' :=
        IsUnit.unit_spec _
      calc
        s = ((s * (u1 : Stk)) * (u2 : Stk)) * (↑u2⁻¹ * ↑u1⁻¹) := by
          rw [mul_assoc (s * (u1 : Stk)), ← mul_assoc (u2 : Stk), Units.mul_inv, one_mul,
            mul_assoc, Units.mul_inv, mul_one]
        _ = 0 * (↑u2⁻¹ * ↑u1⁻¹) := by
          rw [hu1_val, hu2_val, hs_mul]
        _ = 0 := zero_mul _
