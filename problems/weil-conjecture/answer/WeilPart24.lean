      set a₀ := (hex_rep u).choose
      set b₀ := (hex_rep u).choose_spec.choose
      have ha₀ : a₀ ≠ 0 := (hex_rep u).choose_spec.choose_spec.1
      have hb₀ : b₀ ≠ 0 := (hex_rep u).choose_spec.choose_spec.2.1
      have hab₀ : algebraMap R F a₀ = (u : F) * algebraMap R F b₀ :=
        (hex_rep u).choose_spec.choose_spec.2.2
      have hcross : a * b₀ = a₀ * b := by
        apply hInj_RF
        rw [map_mul, map_mul, hab, hab₀]
        ring
      have h_add : ordR a ha + ordR b₀ hb₀ = ordR a₀ ha₀ + ordR b hb := by
        apply hPow_inj
        dsimp only
        rw [pow_add, pow_add, ← hordR_spec a ha, ← hordR_spec b₀ hb₀,
          ← hordR_spec a₀ ha₀, ← hordR_spec b hb,
          Ideal.span_singleton_mul_span_singleton,
          Ideal.span_singleton_mul_span_singleton, hcross]
      change (ordR a₀ ha₀ : ℤ) - (ordR b₀ hb₀ : ℤ) = (ordR a ha : ℤ) - (ordR b hb : ℤ)
      omega
    have hord_fun_span : ∀ (u : Units F) (a b : R) (na nb : ℕ),
        a ≠ 0 → b ≠ 0 →
        algebraMap R F a = (u : F) * algebraMap R F b →
        Ideal.span ({a} : Set R) = m ^ na →
        Ideal.span ({b} : Set R) = m ^ nb →
        ord_fun u = (na : ℤ) - (nb : ℤ) := by
      intro u a b na nb ha hb hab hspa hspb
      rw [hord_fun_ratio u a b ha hb hab, hordR_eq a ha na hspa, hordR_eq b hb nb hspb]
    have h_span_one : Ideal.span ({(1 : R)} : Set R) = m ^ 0 := by
      rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top]
      exact isUnit_one
    have hord_one : ord_fun 1 = 0 := by
      have h := hord_fun_span 1 1 1 0 0 one_ne_zero one_ne_zero
        (by simp) h_span_one h_span_one
      omega
    have hord_mul : ∀ u₁ u₂ : Units F, ord_fun (u₁ * u₂) = ord_fun u₁ + ord_fun u₂ := by
      intro u₁ u₂
      obtain ⟨a₁, b₁, ha₁, hb₁, hab₁⟩ := hex_rep u₁
      obtain ⟨a₂, b₂, ha₂, hb₂, hab₂⟩ := hex_rep u₂
      have h1 := hord_fun_ratio u₁ a₁ b₁ ha₁ hb₁ hab₁
      have h2 := hord_fun_ratio u₂ a₂ b₂ ha₂ hb₂ hab₂
      have h12 := hord_fun_ratio (u₁ * u₂) (a₁ * a₂) (b₁ * b₂)
        (mul_ne_zero ha₁ ha₂) (mul_ne_zero hb₁ hb₂)
        (by
          rw [map_mul, map_mul, hab₁, hab₂, Units.val_mul]
          ring)
      rw [h12, hordR_mul a₁ a₂ ha₁ ha₂, hordR_mul b₁ b₂ hb₁ hb₂, h1, h2]
      push_cast
      ring
    let ord : Additive (Units F) →+ ℤ :=
      { toFun := fun v => ord_fun (Additive.toMul v)
        map_zero' := hord_one
        map_add' := fun v₁ v₂ => hord_mul (Additive.toMul v₁) (Additive.toMul v₂) }
    refine ⟨ord, ?_, ?_, ?_, ?_⟩
    · intro u
      obtain ⟨a, b, ha, hb, hab⟩ := hex_rep u
      refine ⟨a, b, ordR a ha, ordR b hb, ha, hb, hab, hordR_spec a ha, hordR_spec b hb, ?_⟩
      exact hord_fun_ratio u a b ha hb hab
    · intro u a b na nb ha hb hab hspa hspb
      exact hord_fun_span u a b na nb ha hb hab hspa hspb
    · intro u c d hc hd hcd
      have h_not_mem : c ∉ m → d ∉ m → ord (Additive.ofMul u) = 0 := by
        intro hcm hdm
        have huc : IsUnit c := IsLocalRing.notMem_maximalIdeal.mp hcm
        have hud : IsUnit d := IsLocalRing.notMem_maximalIdeal.mp hdm
        have hspc : Ideal.span ({c} : Set R) = m ^ 0 := by
          rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top]
          exact huc
        have hspd : Ideal.span ({d} : Set R) = m ^ 0 := by
          rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top]
          exact hud
        have h0 := hord_fun_span u c d 0 0 hc hd hcd.symm hspc hspd
        simpa [ord] using h0
      refine ⟨?_, h_not_mem, ?_⟩
      · intro hne
        by_contra h_neither
        exact hne (h_not_mem (not_or.mp h_neither).1 (not_or.mp h_neither).2)
      · intro hspc hd1
        subst hd1
        have hspc1 : Ideal.span ({c} : Set R) = m ^ 1 := by rw [pow_one]; exact hspc
        have h1 := hord_fun_span u c 1 1 0 hc one_ne_zero hcd.symm hspc1 h_span_one
        simpa [ord] using h1
    · intro u
      constructor
      · intro h0
        obtain ⟨a, b, ha, hb, hab⟩ := hex_rep u
        have h_diff : (ordR a ha : ℤ) - (ordR b hb : ℤ) = 0 :=
          (hord_fun_ratio u a b ha hb hab).symm.trans h0
        have hn_eq : ordR a ha = ordR b hb := by omega
        set n := ordR b hb
        have hspa : Ideal.span ({a} : Set R) = Ideal.span ({ϖ ^ n} : Set R) := by
          rw [hordR_spec a ha, hn_eq, hm_pow n]
        have hspb : Ideal.span ({b} : Set R) = Ideal.span ({ϖ ^ n} : Set R) := by
          rw [hordR_spec b hb, hm_pow n]
        obtain ⟨va, hva⟩ := (Ideal.span_singleton_eq_span_singleton.mp hspa).symm
        obtain ⟨vb, hvb⟩ := (Ideal.span_singleton_eq_span_singleton.mp hspb).symm
        let v : Units R := va * vb⁻¹
        refine ⟨v, Units.ext ?_⟩
        have hb_F : algebraMap R F b ≠ 0 := fun h0F => hb (hInj_RF (h0F.trans (map_zero _).symm))
        apply mul_right_cancel₀ hb_F
        have hvb_mul : (v : R) * (vb : R) = (va : R) := by
          change (va : R) * (vb⁻¹ : Units R).val * (vb : R) = (va : R)
          rw [mul_assoc, Units.inv_mul, mul_one]
        change algebraMap R F (v : R) * algebraMap R F b = (u : F) * algebraMap R F b
        calc
          algebraMap R F (v : R) * algebraMap R F b
            = algebraMap R F ((v : R) * (ϖ ^ n * (vb : R))) := by
              rw [← hvb, ← map_mul]
          _ = algebraMap R F (ϖ ^ n * ((v : R) * (vb : R))) := by
              congr 1
              ring
          _ = algebraMap R F a := by rw [hvb_mul, hva]
          _ = (u : F) * algebraMap R F b := hab
      · rintro ⟨v, rfl⟩
        have hv_ne : (v : R) ≠ 0 := v.ne_zero
        have hspv : Ideal.span ({(v : R)} : Set R) = m ^ 0 := by
          rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top]
          exact v.isUnit
        have h0 := hord_fun_span (Units.map (algebraMap R F).toMonoidHom v) (v : R) 1 0 0
          hv_ne one_ne_zero (by simp) hspv h_span_one
        simpa [ord] using h0

  
  have hDenomReg : ∀ (D E : Type u) [CommRing D] [IsDomain D] [CommRing E] (α : D →+* E),
      Function.Injective α →
      (∀ z : E, ∃ c d : D, d ≠ 0 ∧ z * α d = α c) →
      ∀ u : Units E,
        (∀ m : Ideal D, m.IsMaximal → m ≠ ⊥ →
          (∃ a₁ b₁ : D, b₁ ∉ m ∧ (u : E) * α b₁ = α a₁) ∧
          (∃ a₂ b₂ : D, b₂ ∉ m ∧ ((u⁻¹ : Units E) : E) * α b₂ = α a₂)) →
        u ∈ Set.range (Units.map α.toMonoidHom) := by
    intro D E _ _ _ α hα hSurj u hu_loc
    have h_elem : ∀ z : E,
        (∀ m : Ideal D, m.IsMaximal → m ≠ ⊥ → ∃ a b : D, b ∉ m ∧ z * α b = α a) →
        ∃ r : D, α r = z := by
      intro z hz
      let I : Ideal D :=
        { carrier := { b : D | ∃ a : D, z * α b = α a }
          zero_mem' := ⟨0, by rw [map_zero, mul_zero]⟩
          add_mem' := by
            rintro b₁ b₂ ⟨a₁, ha₁⟩ ⟨a₂, ha₂⟩
            exact ⟨a₁ + a₂, by rw [map_add, mul_add, ha₁, ha₂, map_add]⟩
          smul_mem' := by
            rintro c b ⟨a, ha⟩
            refine ⟨c * a, ?_⟩
            simp only [smul_eq_mul, map_mul]
            calc
              z * (α c * α b) = α c * (z * α b) := by ring
              _ = α c * α a := by rw [ha] }
      have hI_top : I = ⊤ := by
        by_contra h_ne
        obtain ⟨m, hm_max, hIm⟩ := Ideal.exists_le_maximal I h_ne
        by_cases hm_bot : m = ⊥
        · obtain ⟨c, d, hd_ne, hcd⟩ := hSurj z
          have hd_I : d ∈ I := ⟨c, hcd⟩
          have hd_bot : d ∈ (⊥ : Ideal D) := hm_bot ▸ hIm hd_I
          exact hd_ne (Ideal.mem_bot.mp hd_bot)
        · obtain ⟨a, b, hb_not, hab⟩ := hz m hm_max hm_bot
          exact hb_not (hIm ⟨a, hab⟩)
      have h1_mem : (1 : D) ∈ I := by
        rw [hI_top]
        exact Submodule.mem_top
      rcases h1_mem with ⟨r, hr⟩
      rw [map_one, mul_one] at hr
      exact ⟨r, hr.symm⟩
    obtain ⟨r₁, hr₁⟩ := h_elem (u : E) (fun m hm hne => (hu_loc m hm hne).1)
    obtain ⟨r₂, hr₂⟩ := h_elem ((u⁻¹ : Units E) : E) (fun m hm hne => (hu_loc m hm hne).2)
    have hr₁₂ : r₁ * r₂ = 1 := by
      apply hα
      rw [map_mul, map_one, hr₁, hr₂, Units.mul_inv]
    have hr₂₁ : r₂ * r₁ = 1 := by rw [mul_comm, hr₁₂]
    exact ⟨⟨r₁, r₂, hr₁₂, hr₂₁⟩, Units.ext hr₁⟩

  
  have _ : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  let η_C := C.left.fromSpecStalk (genericPoint ↥C.left)
  let m_pb : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (f₁ : Y₁ ⟶ C.left) (f₂ : Y₂ ⟶ C.left) (g_hom : Y₁ ⟶ Y₂),
      g_hom ≫ f₂ = f₁ →
