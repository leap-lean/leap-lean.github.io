theorem weil_algClosed_nullstellensatz_section_and_spec_constant_sheaf (k : Type u) [Field k] [IsAlgClosed k] :
    let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
    (∀ (Z : AlgebraicGeometry.Scheme.{u}) (g : Quiver.Hom Z S₀),
      AlgebraicGeometry.LocallyOfFiniteType g →
      Nonempty ↥Z →
      ∃ s : Quiver.Hom S₀ Z,
        CategoryTheory.CategoryStruct.comp s g = CategoryTheory.CategoryStruct.id S₀) ∧
    (∀ (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y S₀) (m₀ q : ℕ),
      Nonempty (CategoryTheory.Iso
        (weilEtaleHigherDirectImage f q (weilEtaleTorsionSheaf Y m₀))
        ((CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (weilEtaleTorsionH Y m₀ q))))) :=
by
  classical
  let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k)
  refine ⟨?_, ?_⟩
  · 
    intro Z g hg hZ
    obtain ⟨z₀⟩ := hZ
    obtain ⟨V₀, hV, hz₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Z) (x := z₀) (U := ⊤) trivial
    let R_V : CommRingCat.{u} := Z.presheaf.obj (Opposite.op V₀)
    let B : Type u := ↑R_V
    let p₀ : PrimeSpectrum B := hV.primeIdealOf ⟨z₀, hz₀⟩
    have h10 : (1 : B) ≠ 0 := fun h1 =>
      (Ideal.ne_top_iff_one p₀.asIdeal).mp p₀.isPrime.ne_top (h1.symm ▸ p₀.asIdeal.zero_mem)
    have : Nontrivial B := ⟨⟨1, 0, h10⟩⟩
    let u_V : Quiver.Hom (AlgebraicGeometry.Spec R_V) S₀ :=
      CategoryTheory.CategoryStruct.comp hV.fromSpec g
    have hu_lft : AlgebraicGeometry.LocallyOfFiniteType u_V := by
      dsimp [u_V]
      infer_instance
    let φ₀ : Quiver.Hom (CommRingCat.of k) R_V := AlgebraicGeometry.Spec.preimage u_V
    have hφ₀_map : AlgebraicGeometry.Spec.map φ₀ =
        CategoryTheory.CategoryStruct.comp hV.fromSpec g :=
      AlgebraicGeometry.Spec.map_preimage u_V
    have hφ₀_ft : RingHom.FiniteType (CommRingCat.Hom.hom φ₀) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType) (φ := φ₀)).mp (hφ₀_map.symm ▸ hu_lft)
    let _ : Algebra k B := (CommRingCat.Hom.hom φ₀).toAlgebra
    have : Algebra.FiniteType k B := RingHom.finiteType_algebraMap.mp hφ₀_ft
    obtain ⟨n, ψ, hψ_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := B)).mp inferInstance
    obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal B
    have : (Ideal.comap ψ.toRingHom 𝔪).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective ψ.toRingHom hψ_surj
    obtain ⟨x, hx_eq⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton
        (K := k) (σ := Fin n) (I := Ideal.comap ψ.toRingHom 𝔪)).mp inferInstance
    let E : MvPolynomial (Fin n) k →ₐ[k] k := MvPolynomial.aeval x
    have hker : ∀ p : MvPolynomial (Fin n) k, ψ p = 0 → E p = 0 := by
      intro p hp0
      have hp_mem : p ∈ MvPolynomial.vanishingIdeal k {x} :=
        hx_eq ▸ (show ψ p ∈ 𝔪 from hp0.symm ▸ 𝔪.zero_mem)
      exact (MvPolynomial.mem_vanishingIdeal_singleton_iff x p).mp hp_mem
    let r : B → MvPolynomial (Fin n) k := Function.surjInv hψ_surj
    have hr : ∀ b : B, ψ (r b) = b := Function.surjInv_eq hψ_surj
    let evFun : B → k := fun b => E (r b)
    have hev_ψ : ∀ p : MvPolynomial (Fin n) k, evFun (ψ p) = E p := by
      intro p
      have h0 : E (p - r (ψ p)) = 0 := hker (p - r (ψ p)) (by rw [map_sub, hr, sub_self])
      exact (sub_eq_zero.mp (by rwa [map_sub] at h0)).symm
    let ev_B : B →+* k :=
      { toFun := evFun
        map_one' := by rw [← map_one ψ, hev_ψ, map_one E]
        map_mul' := fun b₁ b₂ => by
          obtain ⟨p₁, rfl⟩ := hψ_surj b₁
          obtain ⟨p₂, rfl⟩ := hψ_surj b₂
          rw [← map_mul, hev_ψ, map_mul, hev_ψ, hev_ψ]
        map_zero' := by rw [← map_zero ψ, hev_ψ, map_zero E]
        map_add' := fun b₁ b₂ => by
          obtain ⟨p₁, rfl⟩ := hψ_surj b₁
          obtain ⟨p₂, rfl⟩ := hψ_surj b₂
          rw [← map_add, hev_ψ, map_add, hev_ψ, hev_ψ] }
    have h_id_ring : CategoryTheory.CategoryStruct.comp φ₀ (CommRingCat.ofHom ev_B) =
        CategoryTheory.CategoryStruct.id (CommRingCat.of k) := by
      ext c
      change evFun (algebraMap k B c) = c
      rw [← ψ.commutes c, hev_ψ, E.commutes c, Algebra.algebraMap_self, RingHom.id_apply]
    refine ⟨CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_B)) hV.fromSpec, ?_⟩
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_B) ≫ hV.fromSpec) ≫ g = 𝟙 S₀
    rw [CategoryTheory.Category.assoc, ← hφ₀_map, ← AlgebraicGeometry.Spec.map_comp,
      h_id_ring, AlgebraicGeometry.Spec.map_id]
  · 
    
    have hExtPrecompIso : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞]
        [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
        {X₁ X₂ : 𝒞} (e : CategoryTheory.Iso X₁ X₂) (F : 𝒞) (q : ℕ),
        Nonempty (CategoryTheory.Iso
          (AddCommGrpCat.of (CategoryTheory.Abelian.Ext.{u} X₂ F q))
          (AddCommGrpCat.of (CategoryTheory.Abelian.Ext.{u} X₁ F q))) := by
      intro 𝒞 _ _ _ X₁ X₂ e F q
      refine ⟨{
        hom := AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ e.hom).precomp F (Nat.zero_add q))
        inv := AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ e.inv).precomp F (Nat.zero_add q))
        hom_inv_id := by
          ext x
          change (CategoryTheory.Abelian.Ext.mk₀ e.inv).comp
            ((CategoryTheory.Abelian.Ext.mk₀ e.hom).comp x (Nat.zero_add q)) (Nat.zero_add q) = x
          rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
              (CategoryTheory.Abelian.Ext.mk₀ e.inv) (CategoryTheory.Abelian.Ext.mk₀ e.hom)
              x (Nat.zero_add q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
            CategoryTheory.Abelian.Ext.mk₀_id_comp]
        inv_hom_id := by
          ext x
          change (CategoryTheory.Abelian.Ext.mk₀ e.hom).comp
            ((CategoryTheory.Abelian.Ext.mk₀ e.inv).comp x (Nat.zero_add q)) (Nat.zero_add q) = x
          rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
              (CategoryTheory.Abelian.Ext.mk₀ e.hom) (CategoryTheory.Abelian.Ext.mk₀ e.inv)
              x (Nat.zero_add q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
            CategoryTheory.Abelian.Ext.mk₀_id_comp] }⟩
    
    have hConstPresheafAbstract : ∀ {𝒞_site : Type (u + 1)} [CategoryTheory.Category.{u} 𝒞_site]
        (J : CategoryTheory.GrothendieckTopology 𝒞_site)
        [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
        [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
        (T : 𝒞_site) (hT : CategoryTheory.Limits.IsTerminal T),
        (∀ E : 𝒞_site,
          (Nonempty (Quiver.Hom T E) ∨ (⊥ : CategoryTheory.Sieve E) ∈ J E) ∧
          ({ arrows := fun W g => ∃ s : Quiver.Hom T E,
               g = CategoryTheory.CategoryStruct.comp (hT.from W) s
             downward_closed := fun {W W' g} hg u => by
               rcases hg with ⟨s, hs⟩
               refine ⟨s, ?_⟩
               rw [hs, ← CategoryTheory.Category.assoc]
               exact congrArg (fun t => CategoryTheory.CategoryStruct.comp t s)
                 (hT.hom_ext _ _) } : CategoryTheory.Sieve E) ∈ J E) →
        ∀ (P : CategoryTheory.Functor (Opposite 𝒞_site) AddCommGrpCat.{u}),
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P)
          ((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj (P.obj (Opposite.op T)))) := by
      intro 𝒞_site _ J _ _ T hT hSite P
      let A₀ : AddCommGrpCat.{u} := P.obj (Opposite.op T)
      let P_const : CategoryTheory.Functor (Opposite 𝒞_site) AddCommGrpCat.{u} :=
        (CategoryTheory.Functor.const (Opposite 𝒞_site)).obj A₀
      let ε_P : Quiver.Hom P_const P :=
        { app := fun E => P.map (hT.from E.unop).op
          naturality := fun E₁ E₂ φ => by
            dsimp [P_const]
            rw [CategoryTheory.Category.id_comp, ← P.map_comp]
            have hφ : (hT.from E₁.unop).op ≫ φ = (hT.from E₂.unop).op := by
              rw [← Quiver.Hom.op_unop φ, ← op_comp]
              exact congrArg Quiver.Hom.op (hT.hom_ext _ _)
            rw [hφ] }
      have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective J ε_P := by
        refine CategoryTheory.Presheaf.IsLocallyInjective.mk fun {X} m₁ m₂ hm => ?_
        let E : 𝒞_site := X.unop
        rcases (hSite E).1 with ⟨⟨s⟩⟩ | hbot
        · have hsec : CategoryTheory.CategoryStruct.comp s (hT.from E) =
              CategoryTheory.CategoryStruct.id T := hT.hom_ext _ _
          have hm_eq : m₁ = m₂ := by
            have hmap := congrArg (CategoryTheory.ConcreteCategory.hom (P.map s.op)) hm
            change (CategoryTheory.ConcreteCategory.hom
                (CategoryTheory.CategoryStruct.comp
                  (P.map (hT.from E).op) (P.map s.op))) m₁ =
              (CategoryTheory.ConcreteCategory.hom
                (CategoryTheory.CategoryStruct.comp
                  (P.map (hT.from E).op) (P.map s.op))) m₂ at hmap
            rw [← P.map_comp, ← op_comp, hsec, op_id, P.map_id] at hmap
            exact hmap
          subst hm_eq
          exact J.superset_covering (fun W g _ => rfl) (J.top_mem E)
        · exact J.superset_covering bot_le hbot
      have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective J ε_P := by
        refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {E} z => ?_
        refine J.superset_covering ?_ (hSite E).2
        intro W g ⟨s, hs⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        refine ⟨(CategoryTheory.ConcreteCategory.hom (P.map s.op)) z, ?_⟩
        change (CategoryTheory.ConcreteCategory.hom
            (CategoryTheory.CategoryStruct.comp
              (P.map s.op) (P.map (hT.from W).op))) z =
          (CategoryTheory.ConcreteCategory.hom (P.map g.op)) z
        rw [← P.map_comp, ← op_comp, hs]
      have hW : J.W ε_P :=
        (J.W_iff_isLocallyBijective ε_P).mpr ⟨hLocInj, hLocSurj⟩
      have : CategoryTheory.IsIso ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map ε_P) :=
        (J.W_iff ε_P).mp hW
      exact ⟨(CategoryTheory.asIso
        ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map ε_P)).symm⟩
    
    have hThetaPre : ∀ {𝒞_site : Type (u + 1)} [CategoryTheory.Category.{u} 𝒞_site]
        (T : 𝒞_site), CategoryTheory.Limits.IsTerminal T →
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.Functor.const (Opposite 𝒞_site)).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
          ((CategoryTheory.yoneda.obj T).comp AddCommGrpCat.free)) := by
      intro 𝒞_site _ T hT
      let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
      let X₀ : Type u := PUnit.{u + 1}
      let iso_yoneda : CategoryTheory.Iso
          (CategoryTheory.yoneda.obj T)
          ((CategoryTheory.Functor.const (Opposite 𝒞_site)).obj X₀) :=
        CategoryTheory.NatIso.ofComponents
          (fun W =>
            { hom := TypeCat.ofHom (fun _ => PUnit.unit)
              inv := TypeCat.ofHom (fun _ => hT.from W.unop)
              hom_inv_id := by
                ext g
                exact hT.hom_ext _ _
              inv_hom_id := by
                ext u
                cases u
                rfl })
          (fun _ => by
            ext g
            rfl)
      let α₀ : Quiver.Hom (AddCommGrpCat.free.obj X₀) Aℤ :=
        (AddCommGrpCat.adj.homEquiv X₀ Aℤ).symm (TypeCat.ofHom (fun _ => ULift.up (1 : ℤ)))
      let η₀ : Quiver.Hom X₀ ((CategoryTheory.forget AddCommGrpCat.{u}).obj
          (AddCommGrpCat.free.obj X₀)) :=
        AddCommGrpCat.adj.unit.app X₀
      have hα₀_unit : (AddCommGrpCat.Hom.hom α₀)
          ((CategoryTheory.ConcreteCategory.hom η₀) PUnit.unit) = ULift.up (1 : ℤ) := by
        have h1 : CategoryTheory.CategoryStruct.comp η₀
            ((CategoryTheory.forget AddCommGrpCat.{u}).map α₀) =
            TypeCat.ofHom (fun _ => ULift.up (1 : ℤ)) := by
          rw [← AddCommGrpCat.adj.homEquiv_unit]
          exact Equiv.apply_symm_apply (AddCommGrpCat.adj.homEquiv X₀ Aℤ) _
        exact CategoryTheory.ConcreteCategory.congr_hom h1 PUnit.unit
      let β₀ : Quiver.Hom Aℤ (AddCommGrpCat.free.obj X₀) :=
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • ((CategoryTheory.ConcreteCategory.hom η₀) PUnit.unit)
            map_zero' := zero_zsmul _
            map_add' := fun a b => add_zsmul _ a.down b.down }
      let e_free : CategoryTheory.Iso Aℤ (AddCommGrpCat.free.obj X₀) :=
        { hom := β₀
          inv := α₀
          hom_inv_id := by
            apply AddCommGrpCat.ext
            intro z
            change (AddCommGrpCat.Hom.hom α₀)
              (z.down • ((CategoryTheory.ConcreteCategory.hom η₀) PUnit.unit)) = z
            rw [map_zsmul, hα₀_unit]
            exact ULift.ext _ _ (zsmul_one z.down)
          inv_hom_id := by
            apply (AddCommGrpCat.adj.homEquiv X₀ (AddCommGrpCat.free.obj X₀)).injective
            rw [AddCommGrpCat.adj.homEquiv_unit, AddCommGrpCat.adj.homEquiv_unit]
            ext u
            cases u
            change (AddCommGrpCat.Hom.hom β₀)
              ((AddCommGrpCat.Hom.hom α₀)
                ((CategoryTheory.ConcreteCategory.hom η₀) PUnit.unit)) =
              (CategoryTheory.ConcreteCategory.hom η₀) PUnit.unit
            rw [hα₀_unit]
            exact one_zsmul _ }
      let iso_const_free : CategoryTheory.Iso
          ((CategoryTheory.Functor.const (Opposite 𝒞_site)).obj Aℤ)
          (((CategoryTheory.Functor.const (Opposite 𝒞_site)).obj X₀).comp AddCommGrpCat.free) :=
        CategoryTheory.NatIso.ofComponents
          (fun _ => e_free)
          (fun _ => by
            dsimp
            rw [AddCommGrpCat.free.map_id, CategoryTheory.Category.id_comp,
              CategoryTheory.Category.comp_id])
      exact ⟨iso_const_free.trans
        (CategoryTheory.Functor.isoWhiskerRight iso_yoneda AddCommGrpCat.free).symm⟩
    
    let idEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}), S.Etale := fun S =>
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.id S)
        (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
    have hIdTerm : ∀ (S : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.Limits.IsTerminal (idEtale S) := by
      intro S
      refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
          (CategoryTheory.Category.comp_id W.hom) trivial) ?_
      intro W m
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
      change m.left = W.hom
      rw [← CategoryTheory.Category.comp_id m.left]
      exact m.w
    
    let T₀ : S₀.Etale := idEtale S₀
    have hT₀ : CategoryTheory.Limits.IsTerminal T₀ := hIdTerm S₀
    let pt₀ : ↥S₀ := (default : PrimeSpectrum k)
    have hpt₀_mem : ∀ c : k, c ∈ pt₀.asIdeal ↔ c = 0 := by
      intro c
      refine ⟨fun hc => ?_, fun hc => hc.symm ▸ pt₀.asIdeal.zero_mem⟩
      by_contra hne
      exact (Ideal.ne_top_iff_one pt₀.asIdeal).mp pt₀.isPrime.ne_top
        (mul_inv_cancel₀ hne ▸ pt₀.asIdeal.mul_mem_right c⁻¹ hc)
    have hPtSec : ∀ (E : S₀.Etale) (x : ↥E.left),
        ∃ s : Quiver.Hom T₀ E, AlgebraicGeometry.Etale s.left ∧ s.left pt₀ = x := by
      intro E x
      obtain ⟨V₀, hV, hx, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := E.left) (x := x) (U := ⊤) trivial
      let R_V : CommRingCat.{u} := E.left.presheaf.obj (Opposite.op V₀)
      let A : Type u := ↑R_V
      have : AlgebraicGeometry.Etale E.hom := E.prop
      let w_V : Quiver.Hom (AlgebraicGeometry.Spec R_V) S₀ :=
        CategoryTheory.CategoryStruct.comp hV.fromSpec E.hom
      have hw_et : AlgebraicGeometry.Etale w_V := by
        dsimp [w_V]
        infer_instance
      let ψ₀ : Quiver.Hom (CommRingCat.of k) R_V := AlgebraicGeometry.Spec.preimage w_V
      have hψ₀_map : AlgebraicGeometry.Spec.map ψ₀ =
          CategoryTheory.CategoryStruct.comp hV.fromSpec E.hom :=
        AlgebraicGeometry.Spec.map_preimage w_V
      have hψ₀_et : RingHom.Etale (CommRingCat.Hom.hom ψ₀) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.Etale) (φ := ψ₀)).mp (hψ₀_map.symm ▸ hw_et)
      let _ : Algebra k A := (CommRingCat.Hom.hom ψ₀).toAlgebra
      have : Algebra.Etale k A := RingHom.etale_algebraMap.mp hψ₀_et
      rcases (Algebra.Etale.iff_exists_algEquiv_prod k A).mp inferInstance with
        ⟨I, hFinI, Ai, hFieldAi, hAlgAi, eA, hSepAi⟩
      have : Finite I := hFinI
      let _ : Fintype I := Fintype.ofFinite I
      let _ : ∀ i, Field (Ai i) := hFieldAi
      let _ : ∀ i, Algebra k (Ai i) := hAlgAi
      let p₀ : PrimeSpectrum A := hV.primeIdealOf ⟨x, hx⟩
      let 𝔮 : Ideal (∀ i : I, Ai i) := Ideal.comap eA.symm.toRingHom p₀.asIdeal
      have h𝔮 : 𝔮.IsPrime := Ideal.IsPrime.comap eA.symm.toRingHom
      have hex_i₀ : ∃ i₀ : I, (Pi.single i₀ (1 : Ai i₀) : ∀ i : I, Ai i) ∉ 𝔮 := by
        by_contra hall
        simp only [not_exists, not_not] at hall
        have hsum_one : (∑ i : I, (Pi.single i (1 : Ai i) : ∀ j : I, Ai j)) = 1 := by
          funext j
          rw [Finset.sum_apply]
          simp
        have h1_mem : (1 : ∀ i : I, Ai i) ∈ 𝔮 := hsum_one ▸ Ideal.sum_mem 𝔮 (fun i _ => hall i)
        exact (Ideal.ne_top_iff_one 𝔮).mp h𝔮.ne_top h1_mem
      obtain ⟨i₀, hi₀⟩ := hex_i₀
      have h𝔮_iff : ∀ z : (∀ i : I, Ai i), z ∈ 𝔮 ↔ z i₀ = 0 := by
        intro z
        constructor
        · intro hz
          by_contra hne
          let u : ∀ i : I, Ai i := Pi.single i₀ (z i₀)⁻¹
          have huz : u * z = Pi.single i₀ (1 : Ai i₀) := by
            funext j
            by_cases hj : j = i₀
            · subst hj
              simp [u, inv_mul_cancel₀ hne]
            · simp [u, Pi.single_eq_of_ne hj]
          exact hi₀ (huz ▸ 𝔮.mul_mem_left u hz)
        · intro hz0
          have hw_prod : (Pi.single i₀ (1 : Ai i₀) : ∀ i : I, Ai i) *
              (z - Pi.single i₀ (z i₀)) = 0 := by
            funext j
            by_cases hj : j = i₀
            · subst hj
              simp
            · simp [Pi.single_eq_of_ne hj]
          have hw_mem : z - Pi.single i₀ (z i₀) ∈ 𝔮 :=
            (h𝔮.mem_or_mem (hw_prod ▸ 𝔮.zero_mem)).resolve_left hi₀
          simpa [hz0] using hw_mem
      have : IsSepClosed k := IsSepClosed.of_isAlgClosed k
      have : Algebra.IsSeparable k (Ai i₀) := (hSepAi i₀).2
      have hSurj_i₀ : Function.Surjective (algebraMap k (Ai i₀)) :=
        IsSepClosed.algebraMap_surjective k (Ai i₀)
      have hInj_i₀ : Function.Injective (algebraMap k (Ai i₀)) :=
        RingHom.injective (algebraMap k (Ai i₀))
      let α_i₀ : k ≃ₐ[k] Ai i₀ :=
        AlgEquiv.ofBijective (Algebra.ofId k (Ai i₀)) ⟨hInj_i₀, hSurj_i₀⟩
      let ε_x : A →ₐ[k] k :=
        α_i₀.symm.toAlgHom.comp ((Pi.evalAlgHom k Ai i₀).comp eA.toAlgHom)
      have hε_ker : ∀ a : A, ε_x a = 0 ↔ a ∈ p₀.asIdeal := by
        intro a
        change α_i₀.symm (eA a i₀) = 0 ↔ a ∈ p₀.asIdeal
        have h1 : α_i₀.symm (eA a i₀) = 0 ↔ eA a i₀ = 0 :=
          ⟨fun h => by simpa using congrArg α_i₀ h, fun h => by simp [h]⟩
        rw [h1, ← h𝔮_iff (eA a)]
        change eA.symm (eA a) ∈ p₀.asIdeal ↔ a ∈ p₀.asIdeal
        rw [eA.symm_apply_apply]
      let s_aff : Quiver.Hom S₀ (AlgebraicGeometry.Spec R_V) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_x.toRingHom)
      let s_x : Quiver.Hom S₀ E.left :=
        CategoryTheory.CategoryStruct.comp s_aff hV.fromSpec
      have h_id_ring : CategoryTheory.CategoryStruct.comp ψ₀ (CommRingCat.ofHom ε_x.toRingHom) =
          CategoryTheory.CategoryStruct.id (CommRingCat.of k) := by
        ext c
        exact (ε_x.commutes c).trans (RingHom.id_apply c)
      have hs_sec : CategoryTheory.CategoryStruct.comp s_x E.hom =
          CategoryTheory.CategoryStruct.id S₀ := by
        change (s_aff ≫ hV.fromSpec) ≫ E.hom = 𝟙 S₀
        rw [CategoryTheory.Category.assoc, ← hψ₀_map, ← AlgebraicGeometry.Spec.map_comp,
          h_id_ring, AlgebraicGeometry.Spec.map_id]
      have hs_et : AlgebraicGeometry.Etale s_x := by
        have hcomp_et : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp s_x E.hom) :=
          hs_sec.symm ▸ (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S₀))
        exact CategoryTheory.MorphismProperty.of_postcomp
          (@AlgebraicGeometry.Etale) s_x E.hom E.prop hcomp_et
      have hs_aff_pt : s_aff pt₀ = p₀ :=
        (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom ε_x.toRingHom) pt₀).trans
          (PrimeSpectrum.ext (Ideal.ext fun a => (hpt₀_mem (ε_x a)).trans (hε_ker a)))
      have hs_pt : s_x pt₀ = x := by
        change (s_aff ≫ hV.fromSpec) pt₀ = x
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hs_aff_pt]
        exact hV.fromSpec_primeIdealOf ⟨x, hx⟩
      refine ⟨CategoryTheory.MorphismProperty.Over.homMk s_x hs_sec trivial, hs_et, hs_pt⟩
    
    let J₀ := S₀.smallEtaleTopology
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have heq_J₀ : J₀ = (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S₀ (le_refl P_et)
    have hSite₀ : ∀ E : S₀.Etale,
        (Nonempty (Quiver.Hom T₀ E) ∨ (⊥ : CategoryTheory.Sieve E) ∈ J₀ E) ∧
        ({ arrows := fun W g => ∃ s : Quiver.Hom T₀ E,
             g = CategoryTheory.CategoryStruct.comp (hT₀.from W) s
           downward_closed := fun {W W' g} hg u => by
             rcases hg with ⟨s, hs⟩
             refine ⟨s, ?_⟩
             rw [hs, ← CategoryTheory.Category.assoc]
             exact congrArg (fun t => CategoryTheory.CategoryStruct.comp t s)
               (hT₀.hom_ext _ _) } : CategoryTheory.Sieve E) ∈ J₀ E := by
      intro E
      refine ⟨?_, ?_⟩
      · by_cases hne : Nonempty ↥E.left
        · obtain ⟨x⟩ := hne
          obtain ⟨s, -, -⟩ := hPtSec E x
          exact Or.inl ⟨s⟩
        · have hEmp : IsEmpty ↥E.left := not_nonempty_iff.mp hne
          have hmem : (⊥ : CategoryTheory.Sieve E) ∈
              (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck E :=
            (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
              (P := P_et) (Q := P_et) E (⊥ : CategoryTheory.Sieve E)).mpr (fun x => hEmp.elim x)
          exact Or.inr (heq_J₀.symm ▸ hmem)
      · let R_E : CategoryTheory.Sieve E :=
          { arrows := fun W g => ∃ s : Quiver.Hom T₀ E,
              g = CategoryTheory.CategoryStruct.comp (hT₀.from W) s
            downward_closed := fun {W W' g} hg u => by
              rcases hg with ⟨s, hs⟩
              refine ⟨s, ?_⟩
              rw [hs, ← CategoryTheory.Category.assoc]
              exact congrArg (fun t => CategoryTheory.CategoryStruct.comp t s)
                (hT₀.hom_ext _ _) }
        have hmem : R_E ∈
            (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck E :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) E R_E).mpr fun x => by
              obtain ⟨s, hs_et, hs_pt⟩ := hPtSec E x
              refine ⟨T₀, s, pt₀, ⟨s, ?_⟩, hs_et, hs_pt⟩
              have hid : hT₀.from T₀ = CategoryTheory.CategoryStruct.id T₀ := hT₀.hom_ext _ _
              exact (CategoryTheory.Category.id_comp s).symm.trans
                (congrArg (fun t => CategoryTheory.CategoryStruct.comp t s) hid.symm)
        exact heq_J₀.symm ▸ hmem
    
    intro Y f m₀ q
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S₀.Etale Y.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let F_Y := weilEtaleTorsionSheaf Y m₀
    let P_Y : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf F_Y q
    let P : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op P_Y
    obtain ⟨iso₁⟩ := hConstPresheafAbstract J₀ T₀ hT₀ hSite₀ P
    let T_Y : Y.Etale := idEtale Y
    have hT_Y : CategoryTheory.Limits.IsTerminal T_Y := hIdTerm Y
    let inv_snd : Quiver.Hom Y (CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id S₀) f) :=
      CategoryTheory.Limits.pullback.lift f (CategoryTheory.CategoryStruct.id Y)
        ((CategoryTheory.Category.comp_id f).trans
          (CategoryTheory.Category.id_comp f).symm)
    let iso_term : CategoryTheory.Iso (B.obj T₀) T_Y :=
      { hom := CategoryTheory.MorphismProperty.Over.homMk (B.obj T₀).hom
          (CategoryTheory.Category.comp_id _) trivial
        inv := CategoryTheory.MorphismProperty.Over.homMk inv_snd
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        hom_inv_id := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          change CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S₀) f ≫ inv_snd =
            CategoryTheory.CategoryStruct.id _
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := hT_Y.hom_ext _ _ }
    have hT_B : CategoryTheory.Limits.IsTerminal (B.obj T₀) :=
      CategoryTheory.Limits.IsTerminal.ofIso hT_Y iso_term.symm
    obtain ⟨θ_pre⟩ := hThetaPre (B.obj T₀) hT_B
    let ζ_B : CategoryTheory.Iso
        ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))
        ((CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj (B.obj T₀)).comp AddCommGrpCat.free)) :=
      (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).mapIso θ_pre
    obtain ⟨iso₂⟩ := hExtPrecompIso ζ_B F_Y q
    exact ⟨iso₁.trans ((CategoryTheory.constantSheaf J₀ AddCommGrpCat.{u}).mapIso iso₂)⟩

theorem weil_disjoint_sections_pullback_bdry_and_rel_open_pullback (Y₀ V_cur V₀ Y_raw : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V_cur] [AlgebraicGeometry.IsAffine V₀]
    (f₀ : Quiver.Hom Y₀ V_cur)
    (m : ℕ) (hm : 1 ≤ m)
    (τ : Fin m → Quiver.Hom V_cur Y₀)
    (W₀_open : Y₀.Opens)
    (g : Quiver.Hom V₀ V_cur) [AlgebraicGeometry.Etale g]
    (ν : Quiver.Hom Y_raw (CategoryTheory.Limits.pullback f₀ g))
    [AlgebraicGeometry.IsFinite ν]
    [AlgebraicGeometry.Etale ν]
    [AlgebraicGeometry.Surjective ν]
    (hτ_sec : ∀ a : Fin m,
      CategoryTheory.CategoryStruct.comp (τ a) f₀ = CategoryTheory.CategoryStruct.id V_cur)
    (hτ_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ a))
    (hτ_disj : _root_.Pairwise fun a b : Fin m =>
      Disjoint (Set.range (τ a).base) (Set.range (τ b).base))
    (hW₀_compl : (W₀_open : Set ↥Y₀) = (⋃ a : Fin m, Set.range (τ a).base)ᶜ)
    (hAff_W₀ : AlgebraicGeometry.IsAffineOpen W₀_open) :
    let q_cur_raw := CategoryTheory.CategoryStruct.comp ν
      (CategoryTheory.Limits.pullback.fst f₀ g)
    let f_raw := CategoryTheory.CategoryStruct.comp ν
      (CategoryTheory.Limits.pullback.snd f₀ g)
    let U_raw_open : Y_raw.Opens :=
      (TopologicalSpace.Opens.map q_cur_raw.base).obj W₀_open
    (∃ (Z_tot : AlgebraicGeometry.Scheme.{u}) (ι_tot : Quiver.Hom Z_tot Y_raw),
      AlgebraicGeometry.IsClosedImmersion ι_tot ∧
      (U_raw_open : Set ↥Y_raw) = (Set.range ι_tot.base)ᶜ ∧
      AlgebraicGeometry.IsAffineOpen U_raw_open ∧
      AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp ι_tot f_raw) ∧
      AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp ι_tot f_raw) ∧
      AlgebraicGeometry.Surjective (CategoryTheory.CategoryStruct.comp ι_tot f_raw)) ∧
    (∀ (V_next : AlgebraicGeometry.Scheme.{u})
        (h_V_B₀ : Quiver.Hom V_next V₀) [AlgebraicGeometry.Etale h_V_B₀],
      let q_raw := CategoryTheory.Limits.pullback.fst f_raw h_V_B₀
      let f_next := CategoryTheory.Limits.pullback.snd f_raw h_V_B₀
      let h_Y := CategoryTheory.CategoryStruct.comp q_raw q_cur_raw
      let h_V_sch := CategoryTheory.CategoryStruct.comp h_V_B₀ g
      let W_next_open : (CategoryTheory.Limits.pullback f_raw h_V_B₀).Opens :=
        (TopologicalSpace.Opens.map h_Y.base).obj W₀_open
      AlgebraicGeometry.Etale h_Y ∧
      AlgebraicGeometry.Etale (h_Y ∣_ W₀_open) ∧
      (∀ (hComm_Y : CategoryTheory.CategoryStruct.comp h_Y f₀ =
            CategoryTheory.CategoryStruct.comp f_next h_V_sch),
        AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.lift h_Y f_next hComm_Y) ∧
        AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.lift h_Y f_next hComm_Y) ∧
        AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.lift h_Y f_next hComm_Y)) ∧
      (∀ (hComm_W : CategoryTheory.CategoryStruct.comp (h_Y ∣_ W₀_open)
            (CategoryTheory.CategoryStruct.comp W₀_open.ι f₀) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp W_next_open.ι f_next) h_V_sch),
        AlgebraicGeometry.IsFinite
          (CategoryTheory.Limits.pullback.lift (h_Y ∣_ W₀_open)
            (CategoryTheory.CategoryStruct.comp W_next_open.ι f_next) hComm_W) ∧
        AlgebraicGeometry.Etale
          (CategoryTheory.Limits.pullback.lift (h_Y ∣_ W₀_open)
            (CategoryTheory.CategoryStruct.comp W_next_open.ι f_next) hComm_W) ∧
        AlgebraicGeometry.Surjective
          (CategoryTheory.Limits.pullback.lift (h_Y ∣_ W₀_open)
            (CategoryTheory.CategoryStruct.comp W_next_open.ι f_next) hComm_W))) :=
by
  classical
  
  have hPbRange : ∀ {P X Y Z : AlgebraicGeometry.Scheme.{u}}
      {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ Z} {g_pb : Y ⟶ Z},
      CategoryTheory.IsPullback fst snd f g_pb →
      Set.range fst.base = f.base ⁻¹' Set.range g_pb.base := by
    intro P X Y Z fst snd f g_pb hPb
    ext x
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨p, rfl⟩
      refine ⟨snd.base p, ?_⟩
      exact congrArg (fun φ : P ⟶ Z => φ.base p) hPb.w.symm
    · rintro ⟨y, hy⟩
      obtain ⟨p, hp₁, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb x y hy.symm
      exact ⟨p, hp₁⟩

  
  have hCombine : ∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u})
      (ι₁ : Z₁ ⟶ Y₀) (ι₂ : Z₂ ⟶ Y₀),
      AlgebraicGeometry.IsClosedImmersion ι₁ →
      AlgebraicGeometry.IsClosedImmersion ι₂ →
      Disjoint (Set.range ι₁.base) (Set.range ι₂.base) →
      AlgebraicGeometry.IsFinite (ι₁ ≫ f₀) →
      AlgebraicGeometry.Etale (ι₁ ≫ f₀) →
      AlgebraicGeometry.Surjective (ι₁ ≫ f₀) →
      AlgebraicGeometry.IsFinite (ι₂ ≫ f₀) →
      AlgebraicGeometry.Etale (ι₂ ≫ f₀) →
      ∃ (Z₁₂ : AlgebraicGeometry.Scheme.{u}) (ι₁₂ : Z₁₂ ⟶ Y₀),
        AlgebraicGeometry.IsClosedImmersion ι₁₂ ∧
        Set.range ι₁₂.base = Set.range ι₁.base ∪ Set.range ι₂.base ∧
        AlgebraicGeometry.IsFinite (ι₁₂ ≫ f₀) ∧
        AlgebraicGeometry.Etale (ι₁₂ ≫ f₀) ∧
        AlgebraicGeometry.Surjective (ι₁₂ ≫ f₀) := by
    intro Z₁ Z₂ ι₁ ι₂ hCl₁ hCl₂ hDisj hFin₁ hEt₁ hSurj₁ hFin₂ hEt₂
    letI : AlgebraicGeometry.IsClosedImmersion ι₁ := hCl₁
    letI : AlgebraicGeometry.IsClosedImmersion ι₂ := hCl₂
    letI : AlgebraicGeometry.IsFinite (ι₁ ≫ f₀) := hFin₁
    letI : AlgebraicGeometry.Etale (ι₁ ≫ f₀) := hEt₁
    letI : AlgebraicGeometry.Surjective (ι₁ ≫ f₀) := hSurj₁
    letI : AlgebraicGeometry.IsFinite (ι₂ ≫ f₀) := hFin₂
    letI : AlgebraicGeometry.Etale (ι₂ ≫ f₀) := hEt₂
    let Z₁₂ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.coprod Z₁ Z₂
    let j₁ : Z₁ ⟶ Z₁₂ := CategoryTheory.Limits.coprod.inl
    let j₂ : Z₂ ⟶ Z₁₂ := CategoryTheory.Limits.coprod.inr
    let ι₁₂ : Z₁₂ ⟶ Y₀ := CategoryTheory.Limits.coprod.desc ι₁ ι₂
    have hj₁_ι : j₁ ≫ ι₁₂ = ι₁ := CategoryTheory.Limits.coprod.inl_desc ι₁ ι₂
    have hj₂_ι : j₂ ≫ ι₁₂ = ι₂ := CategoryTheory.Limits.coprod.inr_desc ι₁ ι₂
    have hCov_12 : Set.range j₁.base ∪ Set.range j₂.base = Set.univ := by
      simpa only [Set.sup_eq_union, Set.top_eq_univ] using
        (AlgebraicGeometry.isCompl_range_inl_inr Z₁ Z₂).sup_eq_top
    have hRange_12 : Set.range ι₁₂.base = Set.range ι₁.base ∪ Set.range ι₂.base := by
      ext y
      simp only [Set.mem_range, Set.mem_union]
      constructor
      · rintro ⟨z, rfl⟩
        have hz_univ : z ∈ Set.range j₁.base ∪ Set.range j₂.base := by
          rw [hCov_12]; trivial
        rcases hz_univ with ⟨z₁, rfl⟩ | ⟨z₂, rfl⟩
        · left
          exact ⟨z₁, congrArg (fun φ : Z₁ ⟶ Y₀ => φ.base z₁) hj₁_ι.symm⟩
        · right
          exact ⟨z₂, congrArg (fun φ : Z₂ ⟶ Y₀ => φ.base z₂) hj₂_ι.symm⟩
      · rintro (⟨z₁, rfl⟩ | ⟨z₂, rfl⟩)
        · exact ⟨j₁.base z₁, congrArg (fun φ : Z₁ ⟶ Y₀ => φ.base z₁) hj₁_ι⟩
        · exact ⟨j₂.base z₂, congrArg (fun φ : Z₂ ⟶ Y₀ => φ.base z₂) hj₂_ι⟩
    have hHalf : ∀ {A B : AlgebraicGeometry.Scheme.{u}}
        (jA : A ⟶ Z₁₂) (jB : B ⟶ Z₁₂) [AlgebraicGeometry.IsOpenImmersion jA]
        (ιA : A ⟶ Y₀) (ιB : B ⟶ Y₀)
        [AlgebraicGeometry.IsClosedImmersion ιA] [AlgebraicGeometry.IsClosedImmersion ιB],
        jA ≫ ι₁₂ = ιA →
        jB ≫ ι₁₂ = ιB →
        Set.range jA.base ∪ Set.range jB.base = Set.univ →
        Disjoint (Set.range ιA.base) (Set.range ιB.base) →
        AlgebraicGeometry.IsClosedImmersion
          (ι₁₂ ∣_ (⟨(Set.range ιB.base)ᶜ, ιB.isClosedEmbedding.isClosed_range.isOpen_compl⟩ : Y₀.Opens)) := by
      intro A B jA jB _ ιA ιB _ _ hjA hjB hCov hDisjAB
      let O_B : Y₀.Opens := ⟨(Set.range ιB.base)ᶜ, ιB.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      have ha_mem : ∀ a : ↥A, a ∈ (ιA ⁻¹ᵁ O_B) := by
        intro a
        change ιA.base a ∈ (Set.range ιB.base)ᶜ
        exact Set.disjoint_left.mp hDisjAB ⟨a, rfl⟩
      have hRange_eq : Set.range ((ιA ⁻¹ᵁ O_B).ι ≫ jA).base = Set.range (ι₁₂ ⁻¹ᵁ O_B).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        ext z
        simp only [Set.mem_range]
        constructor
        · rintro ⟨u, rfl⟩
          let a : ↥A := (ιA ⁻¹ᵁ O_B).ι.base u
          change ι₁₂.base (jA.base a) ∈ (Set.range ιB.base)ᶜ
          have h_eq : ι₁₂.base (jA.base a) = ιA.base a :=
            congrArg (fun φ : A ⟶ Y₀ => φ.base a) hjA
          rw [h_eq]
          exact ha_mem a
        · intro hz
          have hz_not : ι₁₂.base z ∉ Set.range ιB.base := hz
          have hz_cov : z ∈ Set.range jA.base ∪ Set.range jB.base := by
            rw [hCov]; trivial
          rcases hz_cov with ⟨a, rfl⟩ | ⟨b, rfl⟩
          · exact ⟨⟨a, ha_mem a⟩, rfl⟩
          · exfalso
            apply hz_not
            exact ⟨b, congrArg (fun φ : B ⟶ Y₀ => φ.base b) hjB.symm⟩
      let e_dom := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
        ((ιA ⁻¹ᵁ O_B).ι ≫ jA) (ι₁₂ ⁻¹ᵁ O_B).ι hRange_eq
      have he_fac : e_dom.hom ≫ (ι₁₂ ∣_ O_B) = ιA ∣_ O_B := by
        apply (cancel_mono O_B.ι).mp
        calc
          (e_dom.hom ≫ (ι₁₂ ∣_ O_B)) ≫ O_B.ι
            = e_dom.hom ≫ ((ι₁₂ ∣_ O_B) ≫ O_B.ι) := CategoryTheory.Category.assoc _ _ _
          _ = e_dom.hom ≫ ((ι₁₂ ⁻¹ᵁ O_B).ι ≫ ι₁₂) := by
              rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = (e_dom.hom ≫ (ι₁₂ ⁻¹ᵁ O_B).ι) ≫ ι₁₂ :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = ((ιA ⁻¹ᵁ O_B).ι ≫ jA) ≫ ι₁₂ := by
              rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
          _ = (ιA ⁻¹ᵁ O_B).ι ≫ (jA ≫ ι₁₂) := CategoryTheory.Category.assoc _ _ _
          _ = (ιA ⁻¹ᵁ O_B).ι ≫ ιA := by rw [hjA]
          _ = (ιA ∣_ O_B) ≫ O_B.ι := (AlgebraicGeometry.morphismRestrict_ι ιA O_B).symm
      have h_res_eq : ι₁₂ ∣_ O_B = e_dom.inv ≫ (ιA ∣_ O_B) := by
        rw [← he_fac, ← CategoryTheory.Category.assoc, e_dom.inv_hom_id,
          CategoryTheory.Category.id_comp]
      rw [h_res_eq]
      haveI : AlgebraicGeometry.IsClosedImmersion e_dom.inv :=
        AlgebraicGeometry.IsClosedImmersion.instOfIsIsoScheme e_dom.inv
      infer_instance
    have hCl_12 : AlgebraicGeometry.IsClosedImmersion ι₁₂ := by
      let O₁ : Y₀.Opens := ⟨(Set.range ι₂.base)ᶜ, ι₂.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      let O₂ : Y₀.Opens := ⟨(Set.range ι₁.base)ᶜ, ι₁.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      let U_cov : Bool → Y₀.Opens := fun b => cond b O₁ O₂
      have hTop : iSup U_cov = ⊤ := by
        rw [eq_top_iff, SetLike.le_def]
        intro y _
        by_cases hy : y ∈ Set.range ι₂.base
        · apply SetLike.le_def.mp (le_iSup U_cov false)
          change y ∈ (Set.range ι₁.base)ᶜ
          exact Set.disjoint_right.mp hDisj hy
        · apply SetLike.le_def.mp (le_iSup U_cov true)
          change y ∈ (Set.range ι₂.base)ᶜ
          exact hy
      refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top U_cov hTop ?_
      intro b
      cases b
      · exact hHalf j₂ j₁ ι₂ ι₁ hj₂_ι hj₁_ι (Set.union_comm _ _ ▸ hCov_12) hDisj.symm
      · exact hHalf j₁ j₂ ι₁ ι₂ hj₁_ι hj₂_ι hCov_12 hDisj
    have hDesc_f₀ : ι₁₂ ≫ f₀ = CategoryTheory.Limits.coprod.desc (ι₁ ≫ f₀) (ι₂ ≫ f₀) := by
      apply CategoryTheory.Limits.coprod.hom_ext
      · rw [← CategoryTheory.Category.assoc, hj₁_ι, CategoryTheory.Limits.coprod.inl_desc]
      · rw [← CategoryTheory.Category.assoc, hj₂_ι, CategoryTheory.Limits.coprod.inr_desc]
    have hFin_12 : AlgebraicGeometry.IsFinite (ι₁₂ ≫ f₀) := by
      rw [hDesc_f₀]
      exact AlgebraicGeometry.IsFinite.instDescScheme (ι₁ ≫ f₀) (ι₂ ≫ f₀)
    have hEt_12 : AlgebraicGeometry.Etale (ι₁₂ ≫ f₀) := by
      letI : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Etale.{u}) :=
        @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
          (@AlgebraicGeometry.Etale.{u}) (@RingHom.Etale.{u, u}) inferInstance
      rw [AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_openCover
        (P := @AlgebraicGeometry.Etale.{u}) (AlgebraicGeometry.coprodOpenCover.{u, 0} Z₁ Z₂)]
      rintro ⟨i⟩
      cases i
      · change AlgebraicGeometry.Etale (j₁ ≫ (ι₁₂ ≫ f₀))
        rw [← CategoryTheory.Category.assoc, hj₁_ι]
        exact hEt₁
      · change AlgebraicGeometry.Etale (j₂ ≫ (ι₁₂ ≫ f₀))
        rw [← CategoryTheory.Category.assoc, hj₂_ι]
        exact hEt₂
    have hSurj_12 : AlgebraicGeometry.Surjective (ι₁₂ ≫ f₀) := by
      have hj₁_f₀ : AlgebraicGeometry.Surjective (j₁ ≫ (ι₁₂ ≫ f₀)) := by
        rw [← CategoryTheory.Category.assoc, hj₁_ι]
        exact hSurj₁
      exact @AlgebraicGeometry.Surjective.of_comp _ _ _ j₁ (ι₁₂ ≫ f₀) hj₁_f₀
    exact ⟨Z₁₂, ι₁₂, hCl_12, hRange_12, hFin_12, hEt_12, hSurj_12⟩

  
  have hSecProps : ∀ a : Fin m,
      AlgebraicGeometry.IsFinite (τ a ≫ f₀) ∧
      AlgebraicGeometry.Etale (τ a ≫ f₀) ∧
      AlgebraicGeometry.Surjective (τ a ≫ f₀) := by
    intro a
    have h_id : τ a ≫ f₀ = 𝟙 V_cur := hτ_sec a
    rw [h_id]
    exact ⟨AlgebraicGeometry.IsFinite.instOfIsIsoScheme (𝟙 V_cur),
      AlgebraicGeometry.Etale.instOfIsOpenImmersion (𝟙 V_cur),
      AlgebraicGeometry.instSurjectiveOfIsIsoScheme (𝟙 V_cur)⟩

  have hInd : ∀ n : ℕ, n + 1 ≤ m →
      ∃ (Z_n : AlgebraicGeometry.Scheme.{u}) (ι_n : Z_n ⟶ Y₀),
        AlgebraicGeometry.IsClosedImmersion ι_n ∧
        Set.range ι_n.base = ⋃ (a : Fin m) (_ : a.val ≤ n), Set.range (τ a).base ∧
        AlgebraicGeometry.IsFinite (ι_n ≫ f₀) ∧
        AlgebraicGeometry.Etale (ι_n ≫ f₀) ∧
        AlgebraicGeometry.Surjective (ι_n ≫ f₀) := by
    intro n
    induction n with
    | zero =>
      intro h0
      let a₀ : Fin m := ⟨0, h0⟩
      obtain ⟨hFin₀, hEt₀, hSurj₀⟩ := hSecProps a₀
      refine ⟨V_cur, τ a₀, hτ_cl a₀, ?_, hFin₀, hEt₀, hSurj₀⟩
      ext y
      simp only [Set.mem_iUnion]
      constructor
      · intro hy
        exact ⟨a₀, le_rfl, hy⟩
      · rintro ⟨a, ha_le, hy⟩
        have ha_eq : a = a₀ := Fin.ext (Nat.eq_zero_of_le_zero ha_le)
        rwa [ha_eq] at hy
    | succ n ih =>
      intro hn1
      obtain ⟨Z_n, ι_n, hCl_n, hRange_n, hFin_n, hEt_n, hSurj_n⟩ :=
        ih (Nat.le_of_succ_le hn1)
      let a_next : Fin m := ⟨n + 1, hn1⟩
      obtain ⟨hFin_next, hEt_next, _⟩ := hSecProps a_next
      have hDisj_next : Disjoint (Set.range ι_n.base) (Set.range (τ a_next).base) := by
        rw [hRange_n, Set.disjoint_left]
        intro y hy
        simp only [Set.mem_iUnion] at hy
        rcases hy with ⟨a, ha_le, hya⟩
        have ha_ne : a ≠ a_next := by
          intro h_eq
          have h_val : a.val = n + 1 := congrArg Fin.val h_eq
          omega
        exact Set.disjoint_left.mp (hτ_disj ha_ne) hya
      obtain ⟨Z_s, ι_s, hCl_s, hRange_s, hFin_s, hEt_s, hSurj_s⟩ :=
        hCombine Z_n V_cur ι_n (τ a_next) hCl_n (hτ_cl a_next) hDisj_next
          hFin_n hEt_n hSurj_n hFin_next hEt_next
      refine ⟨Z_s, ι_s, hCl_s, ?_, hFin_s, hEt_s, hSurj_s⟩
      rw [hRange_s, hRange_n]
      ext y
      simp only [Set.mem_union, Set.mem_iUnion]
      constructor
      · rintro (⟨a, ha_le, hy⟩ | hy)
        · exact ⟨a, Nat.le_succ_of_le ha_le, hy⟩
        · exact ⟨a_next, le_rfl, hy⟩
      · rintro ⟨a, ha_le, hy⟩
        rcases Nat.of_le_succ ha_le with ha_lt | ha_eq
        · exact Or.inl ⟨a, ha_lt, hy⟩
        · have ha_fin : a = a_next := Fin.ext ha_eq
          rw [ha_fin] at hy
          exact Or.inr hy

  obtain ⟨Z₀, ι₀, hCl₀, hRange₀_sub, hFin₀, hEt₀, hSurj₀⟩ :=
    hInd (m - 1) (Nat.le_of_eq (Nat.sub_add_cancel hm))
  have hRange₀ : Set.range ι₀.base = ⋃ a : Fin m, Set.range (τ a).base := by
    rw [hRange₀_sub]
    ext y
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨a, _, hy⟩
      exact ⟨a, hy⟩
    · rintro ⟨a, hy⟩
      exact ⟨a, Nat.le_sub_one_of_lt a.isLt, hy⟩

  
  let P₀ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f₀ g
  let fst₀ : P₀ ⟶ Y₀ := CategoryTheory.Limits.pullback.fst f₀ g
  let snd₀ : P₀ ⟶ V₀ := CategoryTheory.Limits.pullback.snd f₀ g
  let q_cur_raw : Y_raw ⟶ Y₀ := CategoryTheory.CategoryStruct.comp ν fst₀
  let f_raw : Y_raw ⟶ V₀ := CategoryTheory.CategoryStruct.comp ν snd₀
  let U_raw_open : Y_raw.Opens := (TopologicalSpace.Opens.map q_cur_raw.base).obj W₀_open

  letI : AlgebraicGeometry.IsClosedImmersion ι₀ := hCl₀
  letI : AlgebraicGeometry.IsFinite (ι₀ ≫ f₀) := hFin₀
  letI : AlgebraicGeometry.Etale (ι₀ ≫ f₀) := hEt₀
  letI : AlgebraicGeometry.Surjective (ι₀ ≫ f₀) := hSurj₀

  let Z_tot : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback ι₀ q_cur_raw
  let p_tot : Z_tot ⟶ Z₀ := CategoryTheory.Limits.pullback.fst ι₀ q_cur_raw
  let ι_tot : Z_tot ⟶ Y_raw := CategoryTheory.Limits.pullback.snd ι₀ q_cur_raw

  have hCl_tot : AlgebraicGeometry.IsClosedImmersion ι_tot :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback ι₀ q_cur_raw) hCl₀

  have hRange_tot : Set.range ι_tot.base = q_cur_raw.base ⁻¹' Set.range ι₀.base :=
    hPbRange (CategoryTheory.IsPullback.of_hasPullback ι₀ q_cur_raw).flip

  have hU_raw_compl : (U_raw_open : Set ↥Y_raw) = (Set.range ι_tot.base)ᶜ := by
    change q_cur_raw.base ⁻¹' (W₀_open : Set ↥Y₀) = (Set.range ι_tot.base)ᶜ
    rw [hW₀_compl, ← hRange₀, Set.preimage_compl, hRange_tot]

  have hg_aff : AlgebraicGeometry.IsAffineHom g :=
    AlgebraicGeometry.isAffineHom_of_isAffine g
  have hfst₀_aff : AlgebraicGeometry.IsAffineHom fst₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback f₀ g).flip hg_aff
  letI : AlgebraicGeometry.IsAffineHom fst₀ := hfst₀_aff
  have hq_cur_aff : AlgebraicGeometry.IsAffineHom q_cur_raw := by
    dsimp [q_cur_raw]
    infer_instance
