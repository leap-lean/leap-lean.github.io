        (e_W_P.hom ≫ (W_open_P.ι ≫ f_P)) hComm_W_P) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_rel_W P_N.hSurj_W_rel

  let τ_int : V_sec_sch ⟶ W_open_P.toScheme :=
    hPb_12.lift τ_tilde₀ (𝟙 V_sec_sch) (by rw [CategoryTheory.Category.id_comp, hτ₀_sm])
  have hτ_int_j : τ_int ≫ j_Wopen = τ_tilde₀ := hPb_12.lift_fst _ _ _
  have hτ_int_sec : τ_int ≫ (W_open_P.ι ≫ f_P) = 𝟙 V_sec_sch := hPb_12.lift_snd _ _ _
  let τ_bar : V_sec_sch ⟶ Y_P := τ_int ≫ W_open_P.ι
  have hτ_bar_sec : τ_bar ≫ f_P = 𝟙 V_sec_sch := by
    dsimp [τ_bar]
    rw [CategoryTheory.Category.assoc]
    exact hτ_int_sec
  have hCl_τbar : AlgebraicGeometry.IsClosedImmersion τ_bar := by
    haveI : AlgebraicGeometry.IsClosedImmersion (τ_bar ≫ f_P) := by
      rw [hτ_bar_sec]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp τ_bar f_P

  let s_xP : S_k ⟶ W_sch := s_vsec ≫ τ_int ≫ e_W_P.inv
  let x_P : ↥W_sch := s_xP.base pt_k₀
  have hτ_int_pt : τ_int.base v_sec = e_W_P.hom.base x_P := by
    change τ_int.base v_sec = (e_W_P.inv ≫ e_W_P.hom).base (τ_int.base v_sec)
    rw [e_W_P.inv_hom_id]
    rfl
  have hx_fib_P : f_P.base (W_open_P.ι.base (e_W_P.hom.base x_P)) = v_sec := by
    rw [← hτ_int_pt]
    change (τ_int ≫ (W_open_P.ι ≫ f_P)).base v_sec = v_sec
    rw [hτ_int_sec]
    rfl
  have hpW_xP : p_W.base x_P = P_N.x := by
    have he_inv_pW : e_W_P.inv ≫ p_W = j_Wopen ≫ P_N.e_W.inv := by
      rw [← he_WP_fst, ← CategoryTheory.Category.assoc, e_W_P.inv_hom_id,
        CategoryTheory.Category.id_comp]
    change (τ_int ≫ (e_W_P.inv ≫ p_W)).base v_sec = P_N.x
    rw [he_inv_pW, ← CategoryTheory.Category.assoc, hτ_int_j]
    change P_N.e_W.inv.base (τ_tilde₀.base v_sec) = P_N.x
    rw [hτ₀_vsec]
    change (P_N.e_W.hom ≫ P_N.e_W.inv).base P_N.x = P_N.x
    rw [P_N.e_W.hom_inv_id]
    rfl
  have hx_map_P : (Fgt_Y.map u_W_P).left.base x_P = E.x₁ := by
    change (Fgt_Y.map P_N.u_W).left.base (p_W.base x_P) = E.x₁
    rw [hpW_xP]
    exact P_N.hx_map
  have hx_cl_P : IsClosed ({x_P} : Set ↥W_sch) := by
    let p_Wsch_k : W_sch ⟶ S_k :=
      e_W_P.hom ≫ (W_open_P.ι ≫ f_P) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec))
    refine hClosedOfSection p_Wsch_k s_xP ?_
    calc
      (s_vsec ≫ τ_int ≫ e_W_P.inv) ≫
          (e_W_P.hom ≫ (W_open_P.ι ≫ f_P) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec)))
        = s_vsec ≫ τ_int ≫ (e_W_P.inv ≫ e_W_P.hom) ≫
            (W_open_P.ι ≫ f_P) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec)) := by
          simp only [CategoryTheory.Category.assoc]
      _ = s_vsec ≫ (τ_int ≫ (W_open_P.ι ≫ f_P)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec)) := by
          rw [e_W_P.inv_hom_id, CategoryTheory.Category.id_comp,
            ← CategoryTheory.Category.assoc τ_int (W_open_P.ι ≫ f_P)]
      _ = s_vsec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec)) := by
          rw [hτ_int_sec, CategoryTheory.Category.id_comp]
      _ = 𝟙 S_k := by
          rw [← hPV_k_eq]
          exact hs_vsec_sec

  let P_pkg : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E :=
    { V := P_V
      g_V := g_V_P
      v := v_sec
      Y := Y_P
      f_bar := f_P
      π_Y₁ := π_Y₁_P
      m_pts := m_pts_P
      τ_bdry := τ_bdry_P
      W_open := W_open_P
      W := W_P
      e_W := e_W_P
      u_W := u_W_P
      x := x_P
      hAff_V := inferInstance
      hInt_V := hInt_Vsec
      hv_cl := hv_cl_P
      hv_map := hv_map_P
      hInt_Y := hInt_YP
      hProp_f := hProp_fP
      hSm_f := hSm_fP
      hComm_Y₁ := hComm_Y₁_P
      hFin_rel := hFin_rel_P
      hSurj_rel := hSurj_rel_P
      hIrred_fib := hIrred_fib_P
      hm_pts_pos := P_N.hm_pts_pos
      hτ_sec := hτ_sec_P
      hτ_cl := hτ_cl_P
      hτ_disj := hτ_disj_P
      hW_compl := hW_compl_P
      hAff_Wopen := hAff_Wopen_P
      he_W_hom := he_W_hom_P
      hu_W_comp := hu_W_comp_P
      hComm_W := hComm_W_P
      hFin_W_rel := hFin_W_rel_P
      hEt_W_rel := hEt_W_rel_P
      hSurj_W_rel := hSurj_W_rel_P
      hx_cl := hx_cl_P
      hx_map := hx_map_P
      hx_fib := hx_fib_P }

  
  let Spec_box : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R_box)
  let p_box_B : Spec_box ⟶ V_sec_sch :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := B_sec) (B := R)))
  let p_box_R : Spec_box ⟶ AlgebraicGeometry.Spec R_cat :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := A) (A := B_sec) (B := R)).toRingHom)
  have hPb_box0 : CategoryTheory.IsPullback p_box_B p_box_R q_sec f₀ := by
    let iso_pb := AlgebraicGeometry.pullbackSpecIso A B_sec R
    have h1 : iso_pb.inv ≫ CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B_sec)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R))) = p_box_B :=
      AlgebraicGeometry.pullbackSpecIso_inv_fst A B_sec R
    have h2 : iso_pb.inv ≫ CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B_sec)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R))) = p_box_R :=
      AlgebraicGeometry.pullbackSpecIso_inv_snd A B_sec R
    change CategoryTheory.IsPullback p_box_B p_box_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B_sec)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)))
    rw [← h1, ← h2]
    exact CategoryTheory.IsPullback.of_iso_pullback
      (CategoryTheory.CommSq.mk
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (iso_pb.inv ≫ ·) CategoryTheory.Limits.pullback.condition).trans
            (CategoryTheory.Category.assoc _ _ _).symm)))
      iso_pb.symm rfl rfl

  have hPb_Uaff : CategoryTheory.IsPullback
      (𝟙 (AlgebraicGeometry.Spec R_cat)) f₀
      (hAff_Uaff.fromSpec ≫ h_sm) hAff_Vaff.fromSpec :=
    CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk
        (by rw [CategoryTheory.Category.id_comp]; exact hf₀_fromSpec.symm)
        (fun s => s.fst)
        (fun s => CategoryTheory.Category.comp_id s.fst)
        (fun s => (cancel_mono hAff_Vaff.fromSpec).mp
          ((CategoryTheory.Category.assoc s.fst f₀ hAff_Vaff.fromSpec).trans
            ((congrArg (s.fst ≫ ·) hf₀_fromSpec).trans s.condition)))
        (fun s m hm _ => by simpa using hm))

  let j_U : AlgebraicGeometry.Spec R_cat ⟶ P_N.Y := hAff_Uaff.fromSpec ≫ P_N.W_open.ι
  haveI : AlgebraicGeometry.IsOpenImmersion j_U := inferInstance
  have hPb_box_V : CategoryTheory.IsPullback p_box_R p_box_B (j_U ≫ P_N.f_bar) h_sec_sch := by
    have hp := CategoryTheory.IsPullback.paste_horiz hPb_box0.flip hPb_Uaff
    rw [CategoryTheory.Category.comp_id] at hp
    have hw_jU : hAff_Uaff.fromSpec ≫ h_sm = j_U ≫ P_N.f_bar :=
      (CategoryTheory.Category.assoc hAff_Uaff.fromSpec P_N.W_open.ι P_N.f_bar).symm
    rwa [hw_jU] at hp

  let ι_box : Spec_box ⟶ Y_P :=
    CategoryTheory.Limits.pullback.lift (p_box_R ≫ j_U) p_box_B
      (by rw [CategoryTheory.Category.assoc]; exact hPb_box_V.w)
  have hι_box_pY : ι_box ≫ p_Y = p_box_R ≫ j_U := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hι_box_fP : ι_box ≫ f_P = p_box_B := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_ιbox_flip : CategoryTheory.IsPullback ι_box p_box_R p_Y j_U :=
    CategoryTheory.IsPullback.of_right
      (by rw [hι_box_fP]; exact hPb_box_V.flip)
      hι_box_pY hPb_YP.flip
  have hOpen_ιbox : AlgebraicGeometry.IsOpenImmersion ι_box :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_ιbox_flip.flip inferInstance
  haveI : AlgebraicGeometry.IsOpenImmersion ι_box := hOpen_ιbox

  have hbox_le : ι_box.opensRange ≤ W_open_P := by
    rintro _ ⟨z, rfl⟩
    change p_Y.base (ι_box.base z) ∈ P_N.W_open
    change (ι_box ≫ p_Y).base z ∈ P_N.W_open
    rw [hι_box_pY]
    exact (hAff_Uaff.fromSpec.base (p_box_R.base z)).2

  let μ_sec_A : R_box →ₐ[A] B_sec :=
    Algebra.TensorProduct.productMap (AlgHom.id A B_sec) θ_R
  let μ_sec : R_box →ₐ[B_sec] B_sec :=
    { toRingHom := μ_sec_A.toRingHom
      commutes' := fun b => by
        change (Algebra.TensorProduct.productMap (AlgHom.id A B_sec) θ_R) (b ⊗ₜ[A] 1) = b
        rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, map_one, mul_one] }
  have hμ_g₀ : μ_sec g₀ = 0 := by
    change (Algebra.TensorProduct.productMap (AlgHom.id A B_sec) θ_R) ((1 : B_sec) ⊗ₜ[A] z₀) = 0
    rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, one_mul, hθ_z₀]
  let σ_box : V_sec_sch ⟶ Spec_box :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_sec.toRingHom)
  have hσ_box_R : σ_box ≫ p_box_R =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_R.toRingHom) := by
    let incR_hom : CommRingCat.of R ⟶ CommRingCat.of R_box :=
      CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := A) (A := B_sec) (B := R)).toRingHom
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_sec.toRingHom) ≫
      AlgebraicGeometry.Spec.map incR_hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_R.toRingHom)
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1
    ext r
    change (Algebra.TensorProduct.productMap (AlgHom.id A B_sec) θ_R) (1 ⊗ₜ[A] r) = θ_R r
    rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, one_mul]
  have hσ_box_B : σ_box ≫ p_box_B = 𝟙 V_sec_sch := by
    dsimp [σ_box, p_box_B]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id (CommRingCat.of B_sec)]
    congr 1
    ext b
    exact μ_sec.commutes b
  have hσ_box_ι : σ_box ≫ ι_box = τ_bar := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc
        (σ_box ≫ ι_box) ≫ p_Y
          = σ_box ≫ p_box_R ≫ j_U := by rw [CategoryTheory.Category.assoc, hι_box_pY]
        _ = (σ_box ≫ p_box_R) ≫ hAff_Uaff.fromSpec ≫ P_N.W_open.ι := by
            simp only [j_U, CategoryTheory.Category.assoc]
        _ = τ_tilde₀ ≫ P_N.W_open.ι := by
            rw [hσ_box_R]; dsimp [τ_tilde₀]; rw [CategoryTheory.Category.assoc]
        _ = (τ_int ≫ j_Wopen) ≫ P_N.W_open.ι := by rw [hτ_int_j]
        _ = τ_int ≫ (W_open_P.ι ≫ p_Y) := by
            rw [CategoryTheory.Category.assoc, hj_Wopen_fac]
        _ = τ_bar ≫ p_Y := (CategoryTheory.Category.assoc _ _ _).symm
    · rw [CategoryTheory.Category.assoc, hι_box_fP, hσ_box_B, hτ_bar_sec]

  let Spec_Q : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Q_ring)
  let q_box_hom : CommRingCat.of R_box ⟶ CommRingCat.of Q_ring :=
    CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({g₀} : Set R_box)))
  let i_Q : Spec_Q ⟶ Spec_box := AlgebraicGeometry.Spec.map q_box_hom
  have hCl_iQ : AlgebraicGeometry.IsClosedImmersion i_Q :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective q_box_hom Ideal.Quotient.mk_surjective
  haveI : AlgebraicGeometry.IsClosedImmersion i_Q := hCl_iQ
  let p_Q : Spec_Q ⟶ V_sec_sch :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_sec Q_ring))
  have hEt_pQ : AlgebraicGeometry.Etale p_Q :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  haveI : AlgebraicGeometry.Etale p_Q := hEt_pQ

  have hker_g₀ : Ideal.span ({g₀} : Set R_box) ≤ RingHom.ker μ_sec.toRingHom :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (RingHom.mem_ker.mpr hμ_g₀))
  let μ_bar_sec : Q_ring →ₐ[B_sec] B_sec :=
    Ideal.Quotient.liftₐ (Ideal.span ({g₀} : Set R_box)) μ_sec hker_g₀
  let σ_Q : V_sec_sch ⟶ Spec_Q :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_bar_sec.toRingHom)
  have hσQ_iQ : σ_Q ≫ i_Q = σ_box := by
    dsimp [σ_Q, i_Q, σ_box, q_box_hom]
    rw [← AlgebraicGeometry.Spec.map_comp]
    rfl
  have hσQ_pQ : σ_Q ≫ p_Q = 𝟙 V_sec_sch := by
    dsimp [σ_Q, p_Q]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id (CommRingCat.of B_sec)]
    congr 1
    ext b
    exact μ_bar_sec.commutes b
  have hCl_σQ : AlgebraicGeometry.IsClosedImmersion σ_Q := by
    haveI : AlgebraicGeometry.IsClosedImmersion (σ_Q ≫ p_Q) := by
      rw [hσQ_pQ]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp σ_Q p_Q
  haveI : AlgebraicGeometry.IsClosedImmersion σ_Q := hCl_σQ
  have hEt_σQ : AlgebraicGeometry.Etale σ_Q :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) σ_Q p_Q hEt_pQ
      (by rw [hσQ_pQ]; infer_instance)
  haveI : AlgebraicGeometry.Etale σ_Q := hEt_σQ
  have hOpen_σQ : AlgebraicGeometry.IsOpenImmersion σ_Q :=
    AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono σ_Q
  haveI : AlgebraicGeometry.IsOpenImmersion σ_Q := hOpen_σQ

  let Z_other : Set ↥Spec_box := i_Q.base '' (Set.range σ_Q.base)ᶜ
  have hClosed_Zother : IsClosed Z_other :=
    i_Q.isClosedEmbedding.isClosedMap _ σ_Q.isOpenEmbedding.isOpen_range.isClosed_compl
  have hZ_other_iff : ∀ z : ↥Spec_box,
      z ∈ Z_other ↔ z ∈ Set.range i_Q.base ∧ z ∉ Set.range σ_box.base := by
    intro z
    constructor
    · rintro ⟨w, hw_not, rfl⟩
      refine ⟨⟨w, rfl⟩, ?_⟩
      rintro ⟨v, hv⟩
      rw [← hσQ_iQ] at hv
      have hw_eq : σ_Q.base v = w := i_Q.isClosedEmbedding.injective hv
      exact hw_not ⟨v, hw_eq⟩
    · rintro ⟨⟨w, rfl⟩, hz_not⟩
      refine ⟨w, ?_, rfl⟩
      rintro ⟨v, rfl⟩
      apply hz_not
      refine ⟨v, ?_⟩
      rw [← hσQ_iQ]
      rfl

  let U_box1 : Spec_box.Opens := ⟨Z_otherᶜ, hClosed_Zother.isOpen_compl⟩
  let U₁ : Y_P.Opens := ι_box.opensFunctor.obj U_box1
  let U₂ : Y_P.Opens := ⟨(Set.range τ_bar.base)ᶜ, hCl_τbar.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hU₁_le : U₁ ≤ W_open_P := by
    have h1 : U₁ ≤ ι_box.opensFunctor.obj ⊤ := ι_box.opensFunctor.monotone le_top
    refine le_trans h1 (le_trans ?_ hbox_le)
    rintro _ ⟨z, _, rfl⟩
    exact ⟨z, rfl⟩
  have hU₁₂_cov : U₁ ⊔ U₂ = ⊤ := by
    ext y
    simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top, Set.mem_union,
      Set.mem_univ, iff_true]
    by_cases hy : y ∈ Set.range τ_bar.base
    · left
      obtain ⟨v, rfl⟩ := hy
      rw [← hσ_box_ι]
      refine ⟨σ_box.base v, ?_, rfl⟩
      change σ_box.base v ∉ Z_other
      rw [hZ_other_iff]
      exact fun h => h.2 ⟨v, rfl⟩
    · right
      exact hy

  let g_top : ↑(Spec_box.presheaf.obj (Opposite.op ⊤)) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_box)).inv.hom g₀
  let g_box1 : ↑(Spec_box.presheaf.obj (Opposite.op U_box1)) :=
    (Spec_box.presheaf.map (CategoryTheory.homOfLE (le_top : U_box1 ≤ ⊤)).op).hom g_top
  let g_sec : ↑(Y_P.presheaf.obj (Opposite.op U₁)) :=
    (ι_box.appIso U_box1).inv.hom g_box1

  have hU1_pre : (TopologicalSpace.Opens.map ι_box.base).obj U₁ = U_box1 := by
    ext w
    change ι_box.base w ∈ U₁ ↔ w ∈ U_box1
    constructor
    · rintro ⟨w', hw', hww'⟩
      rwa [← ι_box.isOpenEmbedding.injective hww']
    · intro hw
      exact ⟨w, hw, rfl⟩
  have happ_gsec : (ι_box.app U₁).hom g_sec =
      (Spec_box.presheaf.map (CategoryTheory.eqToHom hU1_pre).op).hom g_box1 :=
    AlgebraicGeometry.Scheme.Hom.appIso_inv_app_apply ι_box U_box1 g_box1

  have hle_basic : U₁ ⊓ U₂ ≤ Y_P.basicOpen g_sec := by
    intro y ⟨hy₁, hy₂⟩
    obtain ⟨z, hz_U1, rfl⟩ := hy₁
    change z ∈ (TopologicalSpace.Opens.map ι_box.base).obj (Y_P.basicOpen g_sec)
    rw [ι_box.preimage_basicOpen g_sec, happ_gsec, Spec_box.basicOpen_res, Spec_box.basicOpen_res]
    refine ⟨⟨z, hz_U1, rfl⟩, hz_U1, ?_⟩
    have hbasic_top : Spec_box.basicOpen g_top = PrimeSpectrum.basicOpen g₀ :=
      @AlgebraicGeometry.basicOpen_eq_of_affine (CommRingCat.of R_box) g₀
    let z' : PrimeSpectrum R_box := z
    have hz_ps : z' ∈ PrimeSpectrum.basicOpen g₀ := by
      rw [PrimeSpectrum.mem_basicOpen]
      intro hg₀_mem
      have hz_in_iQ : z ∈ Set.range i_Q.base := by
        let q_mk : R_box →+* Q_ring := Ideal.Quotient.mk (Ideal.span ({g₀} : Set R_box))
        let π_z : R_box →+* (R_box ⧸ z'.asIdeal) := Ideal.Quotient.mk z'.asIdeal
        have hker_le : Ideal.span ({g₀} : Set R_box) ≤ RingHom.ker π_z :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr
            (RingHom.mem_ker.mpr (Ideal.Quotient.eq_zero_iff_mem.mpr hg₀_mem)))
        let ψ_z : Q_ring →+* (R_box ⧸ z'.asIdeal) :=
          Ideal.Quotient.lift (Ideal.span ({g₀} : Set R_box)) π_z hker_le
        let P_Q : Ideal Q_ring := RingHom.ker ψ_z
        have hPQ_pr : P_Q.IsPrime := by
          refine ⟨?_, ?_⟩
          · intro htop
            have h1 : (1 : Q_ring) ∈ P_Q := htop.symm ▸ Submodule.mem_top
            have hψ1 : ψ_z 1 = 0 := RingHom.mem_ker.mp h1
            have h1_mem : (1 : R_box) ∈ z'.asIdeal := Ideal.Quotient.eq_zero_iff_mem.mp hψ1
            exact z'.isPrime.ne_top ((Ideal.eq_top_iff_one z'.asIdeal).mpr h1_mem)
          · intro a b hab
            obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
            obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective b
            have hxy : π_z (x * y) = 0 := by
              rw [← map_mul q_mk x y] at hab
              exact RingHom.mem_ker.mp hab
            rcases z'.isPrime.mem_or_mem (Ideal.Quotient.eq_zero_iff_mem.mp hxy) with hx | hy
            · left; exact RingHom.mem_ker.mpr (Ideal.Quotient.eq_zero_iff_mem.mpr hx)
            · right; exact RingHom.mem_ker.mpr (Ideal.Quotient.eq_zero_iff_mem.mpr hy)
        refine ⟨(⟨P_Q, hPQ_pr⟩ : PrimeSpectrum Q_ring), ?_⟩
        apply PrimeSpectrum.ext
        ext r
        change ψ_z (q_mk r) = 0 ↔ r ∈ z'.asIdeal
        exact Ideal.Quotient.eq_zero_iff_mem
      have hz_not_σ : z ∉ Set.range σ_box.base := by
        rintro ⟨v, rfl⟩
        apply hy₂
        refine ⟨v, ?_⟩
        rw [← hσ_box_ι]
        rfl
      exact hz_U1 ((hZ_other_iff z).mpr ⟨hz_in_iQ, hz_not_σ⟩)
    exact Eq.mpr
      (congrArg (fun s : Set ↥Spec_box => z ∈ s)
        (congrArg TopologicalSpace.Opens.carrier hbasic_top))
      hz_ps

  have hu₁₂_isUnit : IsUnit
      ((Y_P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec) := by
    have hhom_eq : (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op =
        (CategoryTheory.homOfLE (Y_P.basicOpen_le g_sec)).op ≫
          (CategoryTheory.homOfLE hle_basic).op := rfl
    rw [hhom_eq, CategoryTheory.Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
    exact (Y_P.toRingedSpace.isUnit_res_basicOpen g_sec).map _
  let u₁₂ : Units ↑(Y_P.presheaf.obj (Opposite.op (U₁ ⊓ U₂))) := hu₁₂_isUnit.unit

  
  have hEt_stalk_loc :
      ∀ (R_v L_v : Type u) [CommRing R_v] [CommRing L_v] [IsLocalRing L_v]
        [Algebra k R_v] [Algebra R_v L_v]
        (g_v : R_v) (μ_v : R_v →ₐ[k] k) (m_v : Ideal R_v) [m_v.IsPrime]
        [IsLocalization.AtPrime L_v m_v],
        μ_v g_v = 0 →
        Algebra.Etale k (R_v ⧸ Ideal.span ({g_v} : Set R_v)) →
        m_v = RingHom.ker μ_v.toRingHom →
        Ideal.span ({algebraMap R_v L_v g_v} : Set L_v) = IsLocalRing.maximalIdeal L_v := by
    intro R_v L_v _ _ _ _ _ g_v μ_v m_v _ _ hg_v hEt_Ev hm_v
    let E_v := R_v ⧸ Ideal.span ({g_v} : Set R_v)
    haveI : Algebra.Etale k E_v := hEt_Ev
    let q_v : R_v →ₐ[k] E_v := Ideal.Quotient.mkₐ k (Ideal.span ({g_v} : Set R_v))
    have hker_gv : Ideal.span ({g_v} : Set R_v) ≤ RingHom.ker μ_v.toRingHom :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (RingHom.mem_ker.mpr hg_v))
    let μ_bar_v : E_v →ₐ[k] k := Ideal.Quotient.liftₐ (Ideal.span ({g_v} : Set R_v)) μ_v hker_gv
    obtain ⟨I_idx, hFin_I, Ai, hField_Ai, hAlg_Ai, e_Ai, hMod_Ai⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k E_v).mp hEt_Ev
    letI : Fintype I_idx := Fintype.ofFinite I_idx
    letI : DecidableEq I_idx := Classical.decEq I_idx
    letI : ∀ i : I_idx, Field (Ai i) := hField_Ai
    letI : ∀ i : I_idx, Algebra k (Ai i) := hAlg_Ai
    have hBij_Ai : ∀ i : I_idx, Function.Bijective (algebraMap k (Ai i)) := by
      intro i
      haveI : Module.Finite k (Ai i) := (hMod_Ai i).1
      haveI : Algebra.IsIntegral k (Ai i) := Algebra.IsIntegral.of_finite k (Ai i)
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_i : ∀ i : I_idx, Ai i ≃ₐ[k] k :=
      fun i => (AlgEquiv.ofBijective (Algebra.ofId k (Ai i)) (hBij_Ai i)).symm
    let e_pi : (∀ i : I_idx, Ai i) ≃ₐ[k] (I_idx → k) :=
      { toFun := fun f i => e_i i (f i)
        invFun := fun g i => (e_i i).symm (g i)
        left_inv := fun f => funext fun i => (e_i i).symm_apply_apply (f i)
        right_inv := fun g => funext fun i => (e_i i).apply_symm_apply (g i)
        map_mul' := fun f₁ f₂ => funext fun i => map_mul (e_i i) (f₁ i) (f₂ i)
        map_add' := fun f₁ f₂ => funext fun i => map_add (e_i i) (f₁ i) (f₂ i)
        commutes' := fun c => funext fun i => (e_i i).commutes c }
    let e_prod : E_v ≃ₐ[k] (I_idx → k) := e_Ai.trans e_pi
    let ε_prod : (I_idx → k) →ₐ[k] k := μ_bar_v.comp e_prod.symm.toAlgHom
    let δ_fn : I_idx → (I_idx → k) := fun i => Pi.single i 1
    have hsum_δ : (∑ i : I_idx, δ_fn i) = 1 := by
      ext j
      simp [δ_fn]
    have hex_i₀ : ∃ i₀ : I_idx, ε_prod (δ_fn i₀) ≠ 0 := by
      by_contra h_all
      push_neg at h_all
      have h1 : ε_prod (∑ i : I_idx, δ_fn i) = 0 := by
        rw [map_sum, Finset.sum_eq_zero fun i _ => h_all i]
      rw [hsum_δ, map_one] at h1
      exact one_ne_zero h1
    obtain ⟨i₀, hi₀_ne⟩ := hex_i₀
    have h_idem_kill : ∀ f : I_idx → k, ε_prod f = 0 → δ_fn i₀ * f = 0 := by
      intro f hf0
      have hprod0 : δ_fn i₀ * (f - algebraMap k (I_idx → k) (f i₀)) = 0 := by
        ext j
        by_cases hj : j = i₀
        · subst hj; simp [δ_fn]
        · simp [δ_fn, Pi.single_eq_of_ne hj]
      have hev0 : ε_prod (δ_fn i₀ * (f - algebraMap k (I_idx → k) (f i₀))) = 0 := by
        rw [hprod0, map_zero]
      rw [map_mul, map_sub, hf0, ε_prod.commutes, zero_sub, mul_neg, neg_eq_zero] at hev0
      have hfi₀ : f i₀ = 0 := (mul_eq_zero.mp hev0).resolve_left hi₀_ne
      ext j
      by_cases hj : j = i₀
      · subst hj; simp [hfi₀]
      · simp [δ_fn, Pi.single_eq_of_ne hj]
    obtain ⟨u, hu_qv⟩ := Ideal.Quotient.mk_surjective (e_prod.symm (δ_fn i₀))
    have hqv_u : q_v u = e_prod.symm (δ_fn i₀) := hu_qv
    have hμ_u : μ_v u = ε_prod (δ_fn i₀) := by
      change μ_v u = μ_bar_v (e_prod.symm (δ_fn i₀))
      rw [← hqv_u]
      exact (Ideal.Quotient.lift_mk (Ideal.span ({g_v} : Set R_v)) μ_v.toRingHom hker_gv).symm
    have hu_compl : u ∈ m_v.primeCompl := by
      change u ∉ m_v
      rw [hm_v]
      change μ_v u ≠ 0
      rw [hμ_u]
      exact hi₀_ne
    have hu_mul_mem : ∀ m ∈ m_v, ∃ r : R_v, g_v * r = u * m := by
      intro m hm
      have hμ_m : μ_v m = 0 := by rwa [hm_v, RingHom.mem_ker] at hm
      have hε_m : ε_prod (e_prod (q_v m)) = 0 := by
        change μ_bar_v (e_prod.symm (e_prod (q_v m))) = 0
        rw [e_prod.symm_apply_apply]
        exact (Ideal.Quotient.lift_mk _ μ_v.toRingHom hker_gv).trans hμ_m
      have hqv_um : q_v (u * m) = 0 := by
        apply e_prod.injective
        rw [map_zero, map_mul, map_mul, hqv_u, e_prod.apply_symm_apply]
        exact h_idem_kill (e_prod (q_v m)) hε_m
      have hmem_span : u * m ∈ Ideal.span ({g_v} : Set R_v) :=
        Ideal.Quotient.eq_zero_iff_mem.mp hqv_um
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hmem_span
      exact ⟨r, hr.symm⟩
    apply le_antisymm
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
        IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hunit
      have hcompl := (IsLocalization.AtPrime.isUnit_to_map_iff L_v m_v g_v).mp hunit
      exact hcompl (by rw [hm_v, SetLike.mem_coe, RingHom.mem_ker]; exact hg_v)
    · intro x hx
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      obtain ⟨⟨m, w⟩, hsec⟩ := IsLocalization.surj m_v.primeCompl x
      have hm_mem : m ∈ m_v := by
        by_contra hm_not
        have hu_m : IsUnit (algebraMap R_v L_v m) :=
          IsLocalization.map_units L_v (⟨m, hm_not⟩ : ↥m_v.primeCompl)
        have hu_xw : IsUnit (x * algebraMap R_v L_v (w : R_v)) := by
          rw [hsec]; exact hu_m
        exact hx (isUnit_of_mul_isUnit_left hu_xw)
      obtain ⟨r, hr⟩ := hu_mul_mem m hm_mem
      let uw : ↥m_v.primeCompl := ⟨u, hu_compl⟩ * w
      let u_uw := (IsLocalization.map_units L_v uw).unit
      have hu_uw_val : (u_uw : L_v) = algebraMap R_v L_v (u * (w : R_v)) := IsUnit.unit_spec _
      rw [Ideal.mem_span_singleton]
      refine ⟨algebraMap R_v L_v r * ↑u_uw⁻¹, ?_⟩
      apply (IsLocalization.map_units L_v uw).mul_left_injective
      dsimp only
      calc
        x * algebraMap R_v L_v ↑uw
          = (x * algebraMap R_v L_v (w : R_v)) * algebraMap R_v L_v u := by
            have huw_val : (uw : R_v) = u * (w : R_v) := rfl
            rw [huw_val, map_mul]; ring
        _ = algebraMap R_v L_v (u * m) := by
            rw [hsec, ← map_mul, mul_comm]
        _ = algebraMap R_v L_v (g_v * r) * 1 := by
            rw [← hr, mul_one]
        _ = algebraMap R_v L_v (g_v * r) * (↑u_uw⁻¹ * (u_uw : L_v)) := by
            rw [Units.inv_mul]
        _ = (algebraMap R_v L_v g_v * (algebraMap R_v L_v r * ↑u_uw⁻¹)) *
              algebraMap R_v L_v ↑uw := by
            have huw_val : (uw : R_v) = u * (w : R_v) := rfl
            rw [hu_uw_val, ← huw_val, map_mul]; ring

  have hEt_stalk_loc_equiv :
      ∀ (R₀ Γ₀ L₀ : Type u) [CommRing R₀] [CommRing Γ₀] [CommRing L₀] [IsLocalRing L₀]
        [Algebra k R₀] [Algebra Γ₀ L₀]
        (e : R₀ ≃+* Γ₀) (g : R₀) (μ : R₀ →ₐ[k] k) (P_Γ : Ideal Γ₀) [P_Γ.IsPrime]
        [IsLocalization.AtPrime L₀ P_Γ],
        μ g = 0 →
        Algebra.Etale k (R₀ ⧸ Ideal.span ({g} : Set R₀)) →
        Ideal.comap e.toRingHom P_Γ = RingHom.ker μ.toRingHom →
        Ideal.span ({algebraMap Γ₀ L₀ (e g)} : Set L₀) = IsLocalRing.maximalIdeal L₀ := by
    intro R₀ Γ₀ L₀ _ _ _ _ _ _ e g μ P_Γ _ _ hg hEt hP
    letI : Algebra k Γ₀ := (e.toRingHom.comp (algebraMap k R₀)).toAlgebra
    let e_alg : R₀ ≃ₐ[k] Γ₀ := { e with commutes' := fun _ => rfl }
    let g_Γ : Γ₀ := e_alg g
    let μ_Γ : Γ₀ →ₐ[k] k := μ.comp e_alg.symm.toAlgHom
    have hμ_gΓ : μ_Γ g_Γ = 0 := by
      dsimp [μ_Γ, g_Γ]
      rw [e_alg.symm_apply_apply]
      exact hg
    have hEt_Γ : Algebra.Etale k (Γ₀ ⧸ Ideal.span ({g_Γ} : Set Γ₀)) := by
      let q_Γ : Γ₀ →ₐ[k] Γ₀ ⧸ Ideal.span ({g_Γ} : Set Γ₀) :=
        Ideal.Quotient.mkₐ k (Ideal.span ({g_Γ} : Set Γ₀))
      let q_R : R₀ →ₐ[k] R₀ ⧸ Ideal.span ({g} : Set R₀) :=
        Ideal.Quotient.mkₐ k (Ideal.span ({g} : Set R₀))
      let fwd_q : (R₀ ⧸ Ideal.span ({g} : Set R₀)) →ₐ[k]
          (Γ₀ ⧸ Ideal.span ({g_Γ} : Set Γ₀)) :=
        Ideal.Quotient.liftₐ (Ideal.span ({g} : Set R₀)) (q_Γ.comp e_alg.toAlgHom) (by
          intro a ha
          rw [Ideal.mem_span_singleton] at ha
          obtain ⟨r, rfl⟩ := ha
          rw [map_mul]
          have hg0 : (q_Γ.comp e_alg.toAlgHom) g = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [hg0, zero_mul])
      let bwd_q : (Γ₀ ⧸ Ideal.span ({g_Γ} : Set Γ₀)) →ₐ[k]
          (R₀ ⧸ Ideal.span ({g} : Set R₀)) :=
        Ideal.Quotient.liftₐ (Ideal.span ({g_Γ} : Set Γ₀)) (q_R.comp e_alg.symm.toAlgHom) (by
          intro a ha
          rw [Ideal.mem_span_singleton] at ha
          obtain ⟨r, rfl⟩ := ha
          rw [map_mul]
          have hg0 : (q_R.comp e_alg.symm.toAlgHom) g_Γ = 0 := by
            change q_R (e_alg.symm (e_alg g)) = 0
            rw [e_alg.symm_apply_apply]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [hg0, zero_mul])
      refine Algebra.Etale.of_equiv (AlgEquiv.ofAlgHom fwd_q bwd_q ?_ ?_)
      · ext w; obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective w
        change q_Γ (e_alg (e_alg.symm x)) = q_Γ x
        rw [e_alg.apply_symm_apply]
      · ext w; obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective w
        change q_R (e_alg.symm (e_alg x)) = q_R x
        rw [e_alg.symm_apply_apply]
    have hm_Γ : P_Γ = RingHom.ker μ_Γ.toRingHom := by
      ext γ
      rw [← e.apply_symm_apply γ]
      change e.symm γ ∈ Ideal.comap e.toRingHom P_Γ ↔ μ (e.symm (e (e.symm γ))) = 0
      rw [hP, RingHom.mem_ker, e.symm_apply_apply]
      rfl
    exact hEt_stalk_loc Γ₀ L₀ g_Γ μ_Γ P_Γ hμ_gΓ hEt_Γ hm_Γ

  have hSpecStalkSpan :
      ∀ (R₀ : Type u) [CommRing R₀] [Algebra k R₀]
        (g : R₀) (μ : R₀ →ₐ[k] k) (pt : ↥S_k),
        μ g = 0 →
        Algebra.Etale k (R₀ ⧸ Ideal.span ({g} : Set R₀)) →
        let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R₀)
        let Q₀ : ↥X₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ.toRingHom)).base pt
        let g_X₀ : ↑(X₀.presheaf.obj (Opposite.op (⊤ : X₀.Opens))) :=
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv.hom g
        Ideal.span ({(X₀.presheaf.germ ⊤ Q₀ trivial).hom g_X₀} : Set ↑(X₀.presheaf.stalk Q₀)) =
          IsLocalRing.maximalIdeal ↑(X₀.presheaf.stalk Q₀) := by
    intro R₀ _ _ g μ pt hg hEt X₀ Q₀ g_X₀
    let hAff₀ : AlgebraicGeometry.IsAffineOpen (⊤ : X₀.Opens) :=
      AlgebraicGeometry.isAffineOpen_top X₀
    let q₀_top : ↥(⊤ : X₀.Opens) := ⟨Q₀, trivial⟩
    let Γ₀_cat := X₀.presheaf.obj (Opposite.op (⊤ : X₀.Opens))
    let Γ₀ : Type u := ↑Γ₀_cat
    let Stk₀ : Type u := ↑(X₀.presheaf.stalk ↑q₀_top)
    letI : Algebra Γ₀ Stk₀ := TopCat.Presheaf.algebra_section_stalk X₀.presheaf q₀_top
    haveI : IsLocalization.AtPrime Stk₀ (hAff₀.primeIdealOf q₀_top).asIdeal :=
      hAff₀.isLocalization_stalk q₀_top
    let iso₀ : Γ₀_cat ≅ CommRingCat.of R₀ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)
    let e₀ : R₀ ≃+* Γ₀ := iso₀.symm.commRingCatIsoToRingEquiv
    have hP₀ : Ideal.comap e₀.toRingHom (hAff₀.primeIdealOf q₀_top).asIdeal =
        RingHom.ker μ.toRingHom := by
      have hfrom_eq : hAff₀.fromSpec = AlgebraicGeometry.Spec.map iso₀.inv := by
        rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
        apply (cancel_mono X₀.isoSpec.hom).mp
        rw [CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Scheme.isoSpec_Spec_hom,
          ← AlgebraicGeometry.Spec.map_comp, iso₀.hom_inv_id,
          AlgebraicGeometry.Spec.map_id]
      have hpt_eq : (AlgebraicGeometry.Spec.map iso₀.inv).base (hAff₀.primeIdealOf q₀_top) = Q₀ := by
        rw [← hfrom_eq]
        exact hAff₀.fromSpec_primeIdealOf q₀_top
      have hcomap_Q : Ideal.comap iso₀.inv.hom (hAff₀.primeIdealOf q₀_top).asIdeal =
          (Q₀ : PrimeSpectrum R₀).asIdeal :=
        congrArg PrimeSpectrum.asIdeal hpt_eq
      have hQ_ker : (Q₀ : PrimeSpectrum R₀).asIdeal = RingHom.ker μ.toRingHom := by
        change Ideal.comap μ.toRingHom (pt : PrimeSpectrum k).asIdeal = RingHom.ker μ.toRingHom
        rw [hpt_bot_all pt]
        ext r
        change μ r ∈ (⊥ : Ideal k) ↔ μ r = 0
        exact Ideal.mem_bot
      exact hcomap_Q.trans hQ_ker
    have hSpan₀ := hEt_stalk_loc_equiv R₀ Γ₀ Stk₀ e₀ g μ (hAff₀.primeIdealOf q₀_top).asIdeal
      hg hEt hP₀
    have halg_germ : algebraMap Γ₀ Stk₀ (e₀ g) = (X₀.presheaf.germ ⊤ Q₀ trivial).hom g_X₀ :=
      congrArg (fun φ : Γ₀ →+* Stk₀ => φ g_X₀)
        (TopCat.Presheaf.stalk_open_algebraMap X₀.presheaf q₀_top)
    rwa [halg_germ] at hSpan₀

  have hFinal :
      ∀ (B_s R_b : Type u) [CommRing B_s] [CommRing R_b] [Algebra k B_s] [Algebra B_s R_b]
        (g_b : R_b) (hEt_qb : Algebra.Etale B_s (R_b ⧸ Ideal.span ({g_b} : Set R_b)))
        (μ_s : R_b →ₐ[B_s] B_s) (hμ_gb : μ_s g_b = 0)
        (Y_s : AlgebraicGeometry.Scheme.{u})
        (f_s : Y_s ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_s))
        (ι_b : AlgebraicGeometry.Spec (CommRingCat.of R_b) ⟶ Y_s)
        [AlgebraicGeometry.IsOpenImmersion ι_b]
        (hι_fs : ι_b ≫ f_s = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s R_b)))
        (τ_b : AlgebraicGeometry.Spec (CommRingCat.of B_s) ⟶ Y_s)
        (hσ_ι : AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_s.toRingHom) ≫ ι_b = τ_b)
        (U_b1 : (AlgebraicGeometry.Spec (CommRingCat.of R_b)).Opens),
        let Spec_b := AlgebraicGeometry.Spec (CommRingCat.of R_b)
        let U_1 : Y_s.Opens := ι_b.opensFunctor.obj U_b1
        let g_top_b : ↑(Spec_b.presheaf.obj (Opposite.op ⊤)) :=
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_b)).inv.hom g_b
        let g_b1 : ↑(Spec_b.presheaf.obj (Opposite.op U_b1)) :=
          (Spec_b.presheaf.map (CategoryTheory.homOfLE (le_top : U_b1 ≤ ⊤)).op).hom g_top_b
        let g_s : ↑(Y_s.presheaf.obj (Opposite.op U_1)) :=
          (ι_b.appIso U_b1).inv.hom g_b1
        ∀ (s_v' : S_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_s)) (pt_k : ↥S_k)
          (C_v : CategoryTheory.Over S_k)
          (ι_Cv : C_v.left ⟶ Y_s) (P_pt : ↥C_v.left)
          (hP_mem : P_pt ∈ (TopologicalSpace.Opens.map ι_Cv.base).obj U_1)
          (hs_v_k : s_v' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_s)) = 𝟙 S_k)
          (hPb_Cv : CategoryTheory.IsPullback ι_Cv C_v.hom f_s s_v')
          (hP_eq : ι_Cv.base P_pt = τ_b.base (s_v'.base pt_k)),
          Ideal.span ({(C_v.left.presheaf.germ
            ((TopologicalSpace.Opens.map ι_Cv.base).obj U_1) P_pt hP_mem).hom
              ((ι_Cv.app U_1).hom g_s)} : Set ↑(C_v.left.presheaf.stalk P_pt)) =
            IsLocalRing.maximalIdeal ↑(C_v.left.presheaf.stalk P_pt) := by
    intro B_s R_b _ _ _ _ g_b hEt_qb μ_s hμ_gb Y_s f_s ι_b _ hι_fs τ_b hσ_ι U_b1
      Spec_b U_1 g_top_b g_b1 g_s s_v' pt_k C_v ι_Cv P_pt hP_mem hs_v_k hPb_Cv hP_eq
    let p_b_B : Spec_b ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_s) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s R_b))
    let σ_b : AlgebraicGeometry.Spec (CommRingCat.of B_s) ⟶ Spec_b :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_s.toRingHom)
    have hU1_pre_b : (TopologicalSpace.Opens.map ι_b.base).obj U_1 = U_b1 := by
      ext w
      change ι_b.base w ∈ U_1 ↔ w ∈ U_b1
      constructor
      · rintro ⟨w', hw', hww'⟩
        rwa [← ι_b.isOpenEmbedding.injective hww']
      · intro hw
        exact ⟨w, hw, rfl⟩
    have happ_gs : (ι_b.app U_1).hom g_s =
        (Spec_b.presheaf.map (CategoryTheory.eqToHom hU1_pre_b).op).hom g_b1 :=
      AlgebraicGeometry.Scheme.Hom.appIso_inv_app_apply ι_b U_b1 g_b1

    let ε_v_cat : CommRingCat.of B_s ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage s_v'
    have hmap_εv : AlgebraicGeometry.Spec.map ε_v_cat = s_v' :=
      AlgebraicGeometry.Spec.map_preimage s_v'
    have hεv_comm_cat : CommRingCat.ofHom (algebraMap k B_s) ≫ ε_v_cat = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, hmap_εv, hs_v_k, AlgebraicGeometry.Spec.map_id]
    have hεv_surj : Function.Surjective ε_v_cat.hom := fun c =>
      ⟨algebraMap k B_s c,
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hεv_comm_cat⟩
    have hCl_sv : AlgebraicGeometry.IsClosedImmersion s_v' := by
      rw [← hmap_εv]
      exact AlgebraicGeometry.IsClosedImmersion.spec_of_surjective ε_v_cat hεv_surj
    haveI : AlgebraicGeometry.IsClosedImmersion s_v' := hCl_sv
    have hCl_ιCv : AlgebraicGeometry.IsClosedImmersion ι_Cv :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Cv.flip hCl_sv
    haveI : AlgebraicGeometry.IsClosedImmersion ι_Cv := hCl_ιCv
    let ε_v : B_s →ₐ[k] k :=
      { toRingHom := ε_v_cat.hom
        commutes' := fun c =>
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hεv_comm_cat }

    let alg_Bk : Algebra B_s k := ε_v.toRingHom.toAlgebra
    letI : Algebra B_s k := alg_Bk
    let R_v : Type u := TensorProduct B_s k R_b
    let Spec_Rv : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R_v)
    let p_v_k : Spec_Rv ⟶ S_k :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B_s) (A := k) (B := R_b)))
    let p_v_box : Spec_Rv ⟶ Spec_b :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B_s) (A := k) (B := R_b)).toRingHom)
    have hPb_Rv0 : CategoryTheory.IsPullback p_v_k p_v_box s_v' p_b_B := by
      let iso_rv := AlgebraicGeometry.pullbackSpecIso B_s k R_b
      have h1 : iso_rv.inv ≫ CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s k)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s R_b))) = p_v_k :=
        AlgebraicGeometry.pullbackSpecIso_inv_fst B_s k R_b
      have h2 : iso_rv.inv ≫ CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s k)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s R_b))) = p_v_box :=
        AlgebraicGeometry.pullbackSpecIso_inv_snd B_s k R_b
      have hsv_alg : s_v' = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap B_s k)) := hmap_εv.symm
      rw [hsv_alg]
      change CategoryTheory.IsPullback p_v_k p_v_box
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s k)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_s R_b)))
      rw [← h1, ← h2]
      exact CategoryTheory.IsPullback.of_iso_pullback
        (CategoryTheory.CommSq.mk
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (iso_rv.inv ≫ ·) CategoryTheory.Limits.pullback.condition).trans
              (CategoryTheory.Category.assoc _ _ _).symm)))
        iso_rv.symm rfl rfl

    let j_Cv : Spec_Rv ⟶ C_v.left :=
      hPb_Cv.lift (p_v_box ≫ ι_b) p_v_k
        (by rw [CategoryTheory.Category.assoc, hι_fs]; exact hPb_Rv0.flip.w)
    have hj_Cv_ι : j_Cv ≫ ι_Cv = p_v_box ≫ ι_b := hPb_Cv.lift_fst _ _ _
    have hPb_jCv_flip : CategoryTheory.IsPullback j_Cv p_v_box ι_Cv ι_b :=
      CategoryTheory.IsPullback.of_right
        (by rw [hPb_Cv.lift_snd, hι_fs]; exact hPb_Rv0)
        hj_Cv_ι hPb_Cv.flip
    have hOpen_jCv : AlgebraicGeometry.IsOpenImmersion j_Cv :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_jCv_flip.flip inferInstance
    haveI : AlgebraicGeometry.IsOpenImmersion j_Cv := hOpen_jCv

    let g_v : R_v := (1 : k) ⊗ₜ[B_s] g_b
    have hEt_Rv_quot : Algebra.Etale k (R_v ⧸ Ideal.span ({g_v} : Set R_v)) :=
      hEt_tensor_quot B_s k R_b g_b hEt_qb

    let ε_μ_B : R_b →ₐ[B_s] k :=
      { toRingHom := ε_v.toRingHom.comp μ_s.toRingHom
        commutes' := fun b => by
          change ε_v (μ_s (algebraMap B_s R_b b)) = algebraMap B_s k b
          rw [μ_s.commutes]
          rfl }
    let μ_v_alg : R_v →ₐ[B_s] k :=
      Algebra.TensorProduct.productMap (AlgHom.id B_s k) ε_μ_B
    let μ_v : R_v →ₐ[k] k :=
      { toRingHom := μ_v_alg.toRingHom
        commutes' := fun c => by
          change (Algebra.TensorProduct.productMap (AlgHom.id B_s k) ε_μ_B) (c ⊗ₜ[B_s] 1) = c
          rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply]
          change c * ε_v (μ_s 1) = c
          rw [map_one, map_one, mul_one] }
    have hμ_gv : μ_v g_v = 0 := by
      change (Algebra.TensorProduct.productMap (AlgHom.id B_s k) ε_μ_B) ((1 : k) ⊗ₜ[B_s] g_b) = 0
      rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, one_mul]
      change ε_v (μ_s g_b) = 0
      rw [hμ_gb, map_zero]

    let σ_Cv : S_k ⟶ Spec_Rv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_v.toRingHom)
    let Q_pt : ↥Spec_Rv := σ_Cv.base pt_k
    have hσ_Cv_box : σ_Cv ≫ p_v_box = s_v' ≫ σ_b := by
      dsimp [σ_Cv, p_v_box, σ_b]
      rw [← hmap_εv, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      change (Algebra.TensorProduct.productMap (AlgHom.id B_s k) ε_μ_B) ((1 : k) ⊗ₜ[B_s] r) =
        ε_v (μ_s r)
      rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, one_mul]
      rfl
    have hj_Qpt : j_Cv.base Q_pt = P_pt := by
      apply ι_Cv.isClosedEmbedding.injective
      change (σ_Cv ≫ (j_Cv ≫ ι_Cv)).base pt_k = ι_Cv.base P_pt
      rw [hj_Cv_ι, ← CategoryTheory.Category.assoc, hσ_Cv_box, CategoryTheory.Category.assoc,
        hσ_ι]
      exact hP_eq.symm
    subst hj_Qpt

    let Stk_Rv : Type u := ↑(Spec_Rv.presheaf.stalk Q_pt)
    let g_Γ : ↑(Spec_Rv.presheaf.obj (Opposite.op (⊤ : Spec_Rv.Opens))) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_v)).inv.hom g_v
    have hSpan_Rv : Ideal.span ({(Spec_Rv.presheaf.germ ⊤ Q_pt trivial).hom g_Γ} : Set Stk_Rv) =
        IsLocalRing.maximalIdeal Stk_Rv :=
      hSpecStalkSpan R_v g_v μ_v pt_k hμ_gv hEt_Rv_quot

    haveI : CategoryTheory.IsIso (j_Cv.stalkMap Q_pt) :=
      AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap j_Cv Q_pt
    let e_jCv : ↑(C_v.left.presheaf.stalk (j_Cv.base Q_pt)) ≃+* Stk_Rv :=
      (CategoryTheory.asIso (j_Cv.stalkMap Q_pt)).commRingCatIsoToRingEquiv
    let germ_Cv : ↑(C_v.left.presheaf.stalk (j_Cv.base Q_pt)) :=
      (C_v.left.presheaf.germ ((TopologicalSpace.Opens.map ι_Cv.base).obj U_1)
        (j_Cv.base Q_pt) hP_mem).hom ((ι_Cv.app U_1).hom g_s)

    have he_germ : e_jCv germ_Cv = (Spec_Rv.presheaf.germ ⊤ Q_pt trivial).hom g_Γ := by
      change (j_Cv.stalkMap Q_pt).hom germ_Cv = _
      have hy_mem_box : (p_v_box ≫ ι_b).base Q_pt ∈ U_1 := by
        have hy_mem : (j_Cv ≫ ι_Cv).base Q_pt ∈ U_1 := hP_mem
        rwa [hj_Cv_ι] at hy_mem
      have hz_Q_mem : p_v_box.base Q_pt ∈ U_b1 := by
        obtain ⟨z', hz', hzz'⟩ := hy_mem_box
        have hz_eq : z' = p_v_box.base Q_pt := ι_b.isOpenEmbedding.injective hzz'
        exact hz_eq ▸ hz'
      have hstep1 : (j_Cv.stalkMap Q_pt).hom germ_Cv =
          (Spec_Rv.presheaf.germ ((TopologicalSpace.Opens.map (j_Cv ≫ ι_Cv).base).obj U_1)
            Q_pt hP_mem).hom (((j_Cv ≫ ι_Cv).app U_1).hom g_s) := by
        dsimp [germ_Cv]
        rw [AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply j_Cv
          ((TopologicalSpace.Opens.map ι_Cv.base).obj U_1) Q_pt hP_mem ((ι_Cv.app U_1).hom g_s)]
        congr 1
      have hstep2 : (Spec_Rv.presheaf.germ ((TopologicalSpace.Opens.map (j_Cv ≫ ι_Cv).base).obj U_1)
            Q_pt hP_mem).hom (((j_Cv ≫ ι_Cv).app U_1).hom g_s) =
          (Spec_Rv.presheaf.germ ((TopologicalSpace.Opens.map (p_v_box ≫ ι_b).base).obj U_1)
            Q_pt hy_mem_box).hom (((p_v_box ≫ ι_b).app U_1).hom g_s) := by
        rw [AlgebraicGeometry.Scheme.Hom.congr_app hj_Cv_ι U_1, CommRingCat.hom_comp,
          RingHom.comp_apply]
        exact TopCat.Presheaf.germ_res_apply Spec_Rv.presheaf _ Q_pt hP_mem _
      have hstep3 : (Spec_Rv.presheaf.germ ((TopologicalSpace.Opens.map (p_v_box ≫ ι_b).base).obj U_1)
            Q_pt hy_mem_box).hom (((p_v_box ≫ ι_b).app U_1).hom g_s) =
          (p_v_box.stalkMap Q_pt).hom
            ((Spec_b.presheaf.germ ⊤ (p_v_box.base Q_pt) trivial).hom g_top_b) := by
        have hcomp_app : ((p_v_box ≫ ι_b).app U_1).hom g_s =
            (p_v_box.app ((TopologicalSpace.Opens.map ι_b.base).obj U_1)).hom
              ((ι_b.app U_1).hom g_s) := by
          rw [AlgebraicGeometry.Scheme.Hom.comp_app p_v_box ι_b U_1]
          rfl
        rw [hcomp_app]
        have hg_stalk :
            (Spec_Rv.presheaf.germ ((TopologicalSpace.Opens.map p_v_box.base).obj
                ((TopologicalSpace.Opens.map ι_b.base).obj U_1))
              Q_pt hy_mem_box).hom
              ((p_v_box.app ((TopologicalSpace.Opens.map ι_b.base).obj U_1)).hom
                ((ι_b.app U_1).hom g_s)) =
            (p_v_box.stalkMap Q_pt).hom
              ((Spec_b.presheaf.germ ((TopologicalSpace.Opens.map ι_b.base).obj U_1)
                (p_v_box.base Q_pt) hy_mem_box).hom ((ι_b.app U_1).hom g_s)) :=
          (AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply p_v_box
            ((TopologicalSpace.Opens.map ι_b.base).obj U_1) Q_pt hy_mem_box
            ((ι_b.app U_1).hom g_s)).symm
        refine hg_stalk.trans ?_
        congr 1
        rw [happ_gs, TopCat.Presheaf.germ_res_apply Spec_b.presheaf _ (p_v_box.base Q_pt)
          hy_mem_box g_b1]
        exact TopCat.Presheaf.germ_res_apply Spec_b.presheaf
          (CategoryTheory.homOfLE (le_top : U_b1 ≤ ⊤)) (p_v_box.base Q_pt) hz_Q_mem g_top_b
      have hstep4 : (p_v_box.stalkMap Q_pt).hom
            ((Spec_b.presheaf.germ ⊤ (p_v_box.base Q_pt) trivial).hom g_top_b) =
          (Spec_Rv.presheaf.germ ⊤ Q_pt trivial).hom g_Γ := by
        rw [AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply p_v_box ⊤ Q_pt trivial g_top_b]
        congr 1
        have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B_s) (A := k) (B := R_b)).toRingHom)
        exact (congrArg (fun φ => φ.hom g_b) hnat).symm
      exact hstep1.trans (hstep2.trans (hstep3.trans hstep4))

    ext s
    have hs_max : s ∈ IsLocalRing.maximalIdeal ↑(C_v.left.presheaf.stalk (j_Cv.base Q_pt)) ↔
        e_jCv s ∈ IsLocalRing.maximalIdeal Stk_Rv := by
      simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      refine not_congr ⟨fun hu => hu.map e_jCv.toRingHom.toMonoidHom, fun hu => ?_⟩
      simpa using hu.map e_jCv.symm.toRingHom.toMonoidHom
    rw [hs_max, ← hSpan_Rv, ← he_germ, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
    constructor
    · rintro ⟨t, rfl⟩
      exact ⟨e_jCv t, map_mul e_jCv germ_Cv t⟩
    · rintro ⟨t', ht'⟩
      refine ⟨e_jCv.symm t', e_jCv.injective ?_⟩
      rw [map_mul, e_jCv.apply_symm_apply, ht']

  refine ⟨P_pkg, h_V, h_W, τ_int, U₁, U₂, g_sec, u₁₂,
    ⟨hh_sec_vsec, rfl, hPb_WP_conj⟩,
    ⟨hτ_int_sec, hCl_τbar, hτ_int_pt⟩,
    ⟨hU₁_le, rfl, hU₁₂_cov, hu₁₂_isUnit.unit_spec.symm, ?_⟩⟩

  intro s_v pt_k C_v ι_Cv P_pt hP_mem hs_v_sec hPb_Cv hP_eq
  let s_v' : S_k ⟶ V_sec_sch := s_v
  have hs_v_k : s_v' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sec)) = 𝟙 S_k :=
    (congrArg (s_v ≫ ·) hPV_k_eq).symm.trans hs_v_sec
  have hι_box_fP_alg : ι_box ≫ f_P =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_sec R_box)) := hι_box_fP
  exact hFinal B_sec R_box g₀ hEt_quot μ_sec hμ_g₀ Y_P f_P ι_box hι_box_fP_alg
    τ_bar hσ_box_ι U_box1 s_v' pt_k C_v ι_Cv P_pt hP_mem hs_v_k hPb_Cv hP_eq

