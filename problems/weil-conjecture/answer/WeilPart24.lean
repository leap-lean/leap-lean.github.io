        (∀ s s' : Fin m₁, G₁₁_B s s' * G'₁₁_B s s' = (f₁_B s * f₁_B s') ^ (2 * e)) ∧
        (∀ (r : Fin m₀) (s : Fin m₁),
          G₀₁_B r s * G'₀₁_B r s = (ιB₀ (f₀_B r) * ιB₁ (f₁_B s)) ^ (2 * e)) ∧
        (∀ r r' : Fin m₀, (G₀₀_B r r') ^ ℓ * U₀_B r' = (f₀_B r * f₀_B r') ^ (ℓ * e) * U₀_B r) ∧
        (∀ s s' : Fin m₁, (G₁₁_B s s') ^ ℓ * U₁_B s' = (f₁_B s * f₁_B s') ^ (ℓ * e) * U₁_B s) ∧
        (∀ (r : Fin m₀) (s : Fin m₁),
          (G₀₁_B r s) ^ ℓ * ιB₁ (U₁_B s) =
            (ιB₀ (f₀_B r) * ιB₁ (f₁_B s)) ^ (ℓ * e) * ιB₀ (U₀_B r)) ∧
        (∀ r₁ r₂ r₃ : Fin m₀,
          (f₀_B r₁ * f₀_B r₂ * f₀_B r₃) ^ T_ann *
            (G₀₀_B r₁ r₂ * G₀₀_B r₂ r₃ - (f₀_B r₂) ^ (2 * e) * G₀₀_B r₁ r₃) = 0) ∧
        (∀ s₁ s₂ s₃ : Fin m₁,
          (f₁_B s₁ * f₁_B s₂ * f₁_B s₃) ^ T_ann *
            (G₁₁_B s₁ s₂ * G₁₁_B s₂ s₃ - (f₁_B s₂) ^ (2 * e) * G₁₁_B s₁ s₃) = 0) ∧
        (∀ (r₁ r₂ : Fin m₀) (s₃ : Fin m₁),
          (ιB₀ (f₀_B r₁) * ιB₀ (f₀_B r₂) * ιB₁ (f₁_B s₃)) ^ T_ann *
            (ιB₀ (G₀₀_B r₁ r₂) * G₀₁_B r₂ s₃ -
              (ιB₀ (f₀_B r₂)) ^ (2 * e) * G₀₁_B r₁ s₃) = 0) ∧
        (∀ (r₁ : Fin m₀) (s₂ s₃ : Fin m₁),
          (ιB₀ (f₀_B r₁) * ιB₁ (f₁_B s₂) * ιB₁ (f₁_B s₃)) ^ T_ann *
            (G₀₁_B r₁ s₂ * ιB₁ (G₁₁_B s₂ s₃) -
              (ιB₁ (f₁_B s₂)) ^ (2 * e) * G₀₁_B r₁ s₃) = 0))) ∧
      (∀ r : Fin m₀, Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M₀) (f₀_B r) = f₀ r) ∧
      (∀ r r' : Fin m₀, Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M₀) (G₀₀_B r r') = G₀₀ r r') ∧
      (∀ s : Fin m₁, Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M₁) (f₁_B s) = f₁ s) ∧
      (∀ s s' : Fin m₁, Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M₁) (G₁₁_B s s') = G₁₁ s s') ∧
      (∀ (r : Fin m₀) (s : Fin m₁),
        Algebra.TensorProduct.map ψ_R₁ (AlgHom.id R₁ M₀₁) (G₀₁_B r s) = G₀₁ r s) :=
by
  classical
  
  have hFinBound : ∀ (α : Type) [Fintype α] (obj : α → ℐ),
      ∃ (k_idx : ℐ), Nonempty (∀ a : α, obj a ⟶ k_idx) := by
    intro α _ obj
    let O : Finset ℐ := Finset.univ.image obj
    let H : Finset ((X : ℐ) ×' (Y : ℐ) ×' (_ : X ∈ O) ×' (_ : Y ∈ O) ×' (X ⟶ Y)) := ∅
    refine ⟨CategoryTheory.IsFiltered.sup O H, ⟨fun a => ?_⟩⟩
    exact CategoryTheory.IsFiltered.toSup O H (Finset.mem_image_of_mem obj (Finset.mem_univ a))
  have hStarCoeq : ∀ (β : Type) [Fintype β] (i₀ : ℐ) (tgt : β → ℐ) (arr : ∀ b : β, i₀ ⟶ tgt b),
      ∃ (k_idx : ℐ) (w : i₀ ⟶ k_idx),
        ∀ b : β, ∃ (v : tgt b ⟶ k_idx), CategoryTheory.CategoryStruct.comp (arr b) v = w := by
    intro β _ i₀ tgt arr
    let O : Finset ℐ := insert i₀ (Finset.univ.image tgt)
    have hi₀ : i₀ ∈ O := Finset.mem_insert_self i₀ _
    have htgt : ∀ b : β, tgt b ∈ O := fun b =>
      Finset.mem_insert_of_mem (Finset.mem_image_of_mem tgt (Finset.mem_univ b))
    let mkEdge : β → ((X : ℐ) ×' (Y : ℐ) ×' (_ : X ∈ O) ×' (_ : Y ∈ O) ×' (X ⟶ Y)) :=
      fun b => ⟨i₀, tgt b, hi₀, htgt b, arr b⟩
    let H := Finset.univ.image mkEdge
    refine ⟨CategoryTheory.IsFiltered.sup O H, CategoryTheory.IsFiltered.toSup O H hi₀, fun b => ?_⟩
    refine ⟨CategoryTheory.IsFiltered.toSup O H (htgt b), ?_⟩
    have hmem : mkEdge b ∈ H := Finset.mem_image_of_mem mkEdge (Finset.mem_univ b)
    apply CategoryTheory.IsFiltered.toSup_commutes
    exact hmem

  
  let alg_lvl : ∀ i : ℐ, Algebra R₁ ↑(D_sh.obj i) := fun i =>
    (CommRingCat.Hom.hom (α_sh.app i)).toAlgebra
  let _ : ∀ i : ℐ, Algebra R₁ ↑(D_sh.obj i) := alg_lvl
  have hAlg_lvl : ∀ i : ℐ, algebraMap R₁ ↑(D_sh.obj i) = CommRingCat.Hom.hom (α_sh.app i) :=
    fun _ => rfl
  have hColim_alg : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α_sh.app i)
      (CategoryTheory.CategoryStruct.comp (c_sh.ι.app i) e_pt.hom) =
      CommRingCat.ofHom (algebraMap R₁ A) := by
    intro i
    rw [hf_A]
    exact hColim_fA i

  obtain ⟨φ_tr, ι_colim, hι_hom, hφ_id, hφ_comp, hι_φ, hTensorColim⟩ :
      ∃ (φ_tr : ∀ {i j : ℐ}, (i ⟶ j) → (↑(D_sh.obj i) →ₐ[R₁] ↑(D_sh.obj j)))
        (ι_colim : ∀ i : ℐ, ↑(D_sh.obj i) →ₐ[R₁] A),
        (∀ (i : ℐ), (ι_colim i).toRingHom =
          CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c_sh.ι.app i) e_pt.hom)) ∧
        (∀ (i : ℐ), φ_tr (CategoryTheory.CategoryStruct.id i) = AlgHom.id R₁ ↑(D_sh.obj i)) ∧
        (∀ {i j k_idx : ℐ} (u : i ⟶ j) (v : j ⟶ k_idx),
          φ_tr (CategoryTheory.CategoryStruct.comp u v) = (φ_tr v).comp (φ_tr u)) ∧
        (∀ {i j : ℐ} (u : i ⟶ j), (ι_colim j).comp (φ_tr u) = ι_colim i) ∧
        (∀ (M : Type u) [CommRing M] [Algebra R₁ M],
          (∀ x : TensorProduct R₁ A M,
            ∃ (i : ℐ) (y : TensorProduct R₁ ↑(D_sh.obj i) M),
              Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) y = x) ∧
          (∀ (i : ℐ) (x y : TensorProduct R₁ ↑(D_sh.obj i) M),
            Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) x =
              Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) y →
            ∃ (j : ℐ) (u : i ⟶ j),
              Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M) x =
                Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M) y)) := by
    let φ_tr : ∀ {i j : ℐ}, (i ⟶ j) → (↑(D_sh.obj i) →ₐ[R₁] ↑(D_sh.obj j)) := fun {i j} u =>
      { toRingHom := CommRingCat.Hom.hom (D_sh.map u)
        commutes' := fun r => by
          have hnat := α_sh.naturality u
          dsimp at hnat
          rw [CategoryTheory.Category.id_comp] at hnat
          have h_ev := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hnat) r
          simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h_ev
          rw [hAlg_lvl i, hAlg_lvl j]
          exact h_ev.symm }
    let ι_colim : ∀ i : ℐ, ↑(D_sh.obj i) →ₐ[R₁] A := fun i =>
      { toRingHom := CommRingCat.Hom.hom (c_sh.ι.app i ≫ e_pt.hom)
        commutes' := fun r => by
          have h_ev := RingHom.congr_fun (congrArg CommRingCat.Hom.hom (hColim_alg i)) r
          simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h_ev
          rw [hAlg_lvl i]
          exact h_ev }
    have hφ_id : ∀ (i : ℐ), φ_tr (𝟙 i) = AlgHom.id R₁ ↑(D_sh.obj i) := by
      intro i
      ext x
      change CommRingCat.Hom.hom (D_sh.map (𝟙 i)) x = x
      rw [D_sh.map_id]
      rfl
    have hφ_comp : ∀ {i j k_idx : ℐ} (u : i ⟶ j) (v : j ⟶ k_idx),
        φ_tr (u ≫ v) = (φ_tr v).comp (φ_tr u) := by
      intro i j k_idx u v
      ext x
      change CommRingCat.Hom.hom (D_sh.map (u ≫ v)) x =
        CommRingCat.Hom.hom (D_sh.map v) (CommRingCat.Hom.hom (D_sh.map u) x)
      rw [D_sh.map_comp]
      rfl
    have hι_φ : ∀ {i j : ℐ} (u : i ⟶ j), (ι_colim j).comp (φ_tr u) = ι_colim i := by
      intro i j u
      ext x
      have hw : D_sh.map u ≫ (c_sh.ι.app j ≫ e_pt.hom) = c_sh.ι.app i ≫ e_pt.hom := by
        rw [← Category.assoc, c_sh.w u]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hw) x
    refine ⟨φ_tr, ι_colim, fun _ => rfl, hφ_id, hφ_comp, hι_φ, ?_⟩
    intro M _ _
    let D_M : CategoryTheory.Functor ℐ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of (TensorProduct R₁ ↑(D_sh.obj i) M)
        map := fun u => CommRingCat.ofHom
          (Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M)).toRingHom
        map_id := fun i => by
          apply CommRingCat.hom_ext
          rw [CommRingCat.hom_ofHom, hφ_id i, Algebra.TensorProduct.map_id]
          rfl
        map_comp := fun u v => by
          apply CommRingCat.hom_ext
          rw [CommRingCat.hom_ofHom, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
            CommRingCat.hom_ofHom]
          have hmap : Algebra.TensorProduct.map (φ_tr (u ≫ v)) (AlgHom.id R₁ M) =
              (Algebra.TensorProduct.map (φ_tr v) (AlgHom.id R₁ M)).comp
                (Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M)) := by
            rw [← Algebra.TensorProduct.map_comp, ← hφ_comp u v, AlgHom.comp_id]
          exact congrArg AlgHom.toRingHom hmap }
    let c_M : CategoryTheory.Limits.Cocone D_M :=
      { pt := CommRingCat.of (TensorProduct R₁ A M)
        ι :=
          { app := fun i => CommRingCat.ofHom
              (Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M)).toRingHom
            naturality := fun i j u => by
              dsimp [D_M]
              apply CommRingCat.hom_ext
              rw [Category.comp_id, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
                CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
              have hmap : (Algebra.TensorProduct.map (ι_colim j) (AlgHom.id R₁ M)).comp
                  (Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M)) =
                  Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) := by
                rw [← Algebra.TensorProduct.map_comp, hι_φ u, AlgHom.comp_id]
              exact congrArg AlgHom.toRingHom hmap } }
    let inl_A : CommRingCat.of A ⟶ CommRingCat.of (TensorProduct R₁ A M) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let inr_A : CommRingCat.of M ⟶ CommRingCat.of (TensorProduct R₁ A M) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    let inl_lvl : ∀ i : ℐ, D_sh.obj i ⟶ D_M.obj i := fun i =>
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let inr_lvl : ∀ i : ℐ, CommRingCat.of M ⟶ D_M.obj i := fun i =>
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    have hinl_map : ∀ {i j : ℐ} (u : i ⟶ j),
        inl_lvl i ≫ D_M.map u = D_sh.map u ≫ inl_lvl j := by
      intro i j u
      apply CommRingCat.hom_ext
      ext b
      change Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M) (b ⊗ₜ[R₁] 1) =
        (φ_tr u b) ⊗ₜ[R₁] 1
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.coe_id, id_eq]
    have hinr_map : ∀ {i j : ℐ} (u : i ⟶ j),
        inr_lvl i ≫ D_M.map u = inr_lvl j := by
      intro i j u
      apply CommRingCat.hom_ext
      ext m
      change Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M) (1 ⊗ₜ[R₁] m) = 1 ⊗ₜ[R₁] m
      simp only [Algebra.TensorProduct.map_tmul, map_one, AlgHom.coe_id, id_eq]
    have hinl_ι : ∀ i : ℐ,
        inl_lvl i ≫ c_M.ι.app i = c_sh.ι.app i ≫ e_pt.hom ≫ inl_A := by
      intro i
      apply CommRingCat.hom_ext
      ext b
      change Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) (b ⊗ₜ[R₁] 1) =
        (ι_colim i b) ⊗ₜ[R₁] 1
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.coe_id, id_eq]
    have hinr_ι : ∀ i : ℐ, inr_lvl i ≫ c_M.ι.app i = inr_A := by
      intro i
      apply CommRingCat.hom_ext
      ext m
      change Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) (1 ⊗ₜ[R₁] m) = 1 ⊗ₜ[R₁] m
      simp only [Algebra.TensorProduct.map_tmul, map_one, AlgHom.coe_id, id_eq]
    have P_A : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap R₁ A)) (CommRingCat.ofHom (algebraMap R₁ M))
        inl_A inr_A :=
      CommRingCat.isPushout_tensorProduct R₁ A M
    have P_lvl : ∀ i : ℐ, CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap R₁ ↑(D_sh.obj i))) (CommRingCat.ofHom (algebraMap R₁ M))
        (inl_lvl i) (inr_lvl i) :=
      fun i => CommRingCat.isPushout_tensorProduct R₁ ↑(D_sh.obj i) M
    have i₀ : ℐ := Classical.choice CategoryTheory.IsFiltered.nonempty
    let mkCoconeA : CategoryTheory.Limits.Cocone D_M → CategoryTheory.Limits.Cocone D_sh :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun i => inl_lvl i ≫ s.ι.app i
              naturality := fun i j u => by
                dsimp
                rw [Category.comp_id, ← Category.assoc, ← hinl_map u, Category.assoc, s.w u] } }
    have hg_M_indep : ∀ (s : CategoryTheory.Limits.Cocone D_M) (i : ℐ),
        inr_lvl i ≫ s.ι.app i = inr_lvl i₀ ≫ s.ι.app i₀ := by
      intro s i
      let m := CategoryTheory.IsFiltered.max i₀ i
      let uL : i₀ ⟶ m := CategoryTheory.IsFiltered.leftToMax i₀ i
      let uR : i ⟶ m := CategoryTheory.IsFiltered.rightToMax i₀ i
      calc
        inr_lvl i ≫ s.ι.app i = inr_lvl i ≫ (D_M.map uR ≫ s.ι.app m) := by rw [s.w uR]
        _ = (inr_lvl i ≫ D_M.map uR) ≫ s.ι.app m := (Category.assoc _ _ _).symm
        _ = inr_lvl m ≫ s.ι.app m := by rw [hinr_map uR]
        _ = (inr_lvl i₀ ≫ D_M.map uL) ≫ s.ι.app m := by rw [hinr_map uL]
        _ = inr_lvl i₀ ≫ (D_M.map uL ≫ s.ι.app m) := Category.assoc _ _ _
        _ = inr_lvl i₀ ≫ s.ι.app i₀ := by rw [s.w uL]
    have hw_comm : ∀ (s : CategoryTheory.Limits.Cocone D_M),
        CommRingCat.ofHom (algebraMap R₁ A) ≫ (e_pt.inv ≫ hc_sh.desc (mkCoconeA s)) =
        CommRingCat.ofHom (algebraMap R₁ M) ≫ (inr_lvl i₀ ≫ s.ι.app i₀) := by
      intro s
      have hα_eq : α_sh.app i₀ = CommRingCat.ofHom (algebraMap R₁ ↑(D_sh.obj i₀)) := by
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_ofHom, hAlg_lvl i₀]
      calc
        CommRingCat.ofHom (algebraMap R₁ A) ≫ (e_pt.inv ≫ hc_sh.desc (mkCoconeA s))
          = (α_sh.app i₀ ≫ (c_sh.ι.app i₀ ≫ e_pt.hom)) ≫ (e_pt.inv ≫ hc_sh.desc (mkCoconeA s)) := by
              rw [hColim_alg i₀]
        _ = α_sh.app i₀ ≫ c_sh.ι.app i₀ ≫ e_pt.hom ≫ e_pt.inv ≫ hc_sh.desc (mkCoconeA s) := by
              simp only [Category.assoc]
        _ = α_sh.app i₀ ≫ c_sh.ι.app i₀ ≫ hc_sh.desc (mkCoconeA s) := by
              rw [e_pt.hom_inv_id_assoc]
        _ = α_sh.app i₀ ≫ (mkCoconeA s).ι.app i₀ := by
              rw [hc_sh.fac (mkCoconeA s) i₀]
        _ = (CommRingCat.ofHom (algebraMap R₁ ↑(D_sh.obj i₀)) ≫ inl_lvl i₀) ≫ s.ι.app i₀ := by
              dsimp [mkCoconeA]
              rw [hα_eq, Category.assoc]
        _ = (CommRingCat.ofHom (algebraMap R₁ M) ≫ inr_lvl i₀) ≫ s.ι.app i₀ := by
              rw [(P_lvl i₀).toCommSq.w]
        _ = CommRingCat.ofHom (algebraMap R₁ M) ≫ (inr_lvl i₀ ≫ s.ι.app i₀) :=
              Category.assoc _ _ _
    let desc_M : ∀ (s : CategoryTheory.Limits.Cocone D_M), c_M.pt ⟶ s.pt :=
      fun s => P_A.desc (e_pt.inv ≫ hc_sh.desc (mkCoconeA s))
        (inr_lvl i₀ ≫ s.ι.app i₀) (hw_comm s)
    have hinl_desc : ∀ (s : CategoryTheory.Limits.Cocone D_M),
        inl_A ≫ desc_M s = e_pt.inv ≫ hc_sh.desc (mkCoconeA s) :=
      fun s => P_A.inl_desc _ _ _
    have hinr_desc : ∀ (s : CategoryTheory.Limits.Cocone D_M),
        inr_A ≫ desc_M s = inr_lvl i₀ ≫ s.ι.app i₀ :=
      fun s => P_A.inr_desc _ _ _
    let hc_M : CategoryTheory.Limits.IsColimit c_M :=
      { desc := desc_M
        fac := fun s i => by
          apply (P_lvl i).hom_ext
          · calc
              inl_lvl i ≫ (c_M.ι.app i ≫ desc_M s)
                = (inl_lvl i ≫ c_M.ι.app i) ≫ desc_M s := (Category.assoc _ _ _).symm
              _ = (c_sh.ι.app i ≫ e_pt.hom ≫ inl_A) ≫ desc_M s := by rw [hinl_ι i]
              _ = c_sh.ι.app i ≫ e_pt.hom ≫ (inl_A ≫ desc_M s) := by
                  simp only [Category.assoc]
              _ = c_sh.ι.app i ≫ e_pt.hom ≫ (e_pt.inv ≫ hc_sh.desc (mkCoconeA s)) := by
                  rw [hinl_desc s]
              _ = c_sh.ι.app i ≫ hc_sh.desc (mkCoconeA s) := by
                  rw [e_pt.hom_inv_id_assoc]
              _ = inl_lvl i ≫ s.ι.app i := hc_sh.fac (mkCoconeA s) i
          · calc
              inr_lvl i ≫ (c_M.ι.app i ≫ desc_M s)
                = (inr_lvl i ≫ c_M.ι.app i) ≫ desc_M s := (Category.assoc _ _ _).symm
              _ = inr_A ≫ desc_M s := by rw [hinr_ι i]
              _ = inr_lvl i₀ ≫ s.ι.app i₀ := hinr_desc s
              _ = inr_lvl i ≫ s.ι.app i := (hg_M_indep s i).symm
        uniq := fun s m' hm' => by
          apply P_A.hom_ext
          · rw [hinl_desc s]
            have h_uniq_sh : e_pt.hom ≫ (inl_A ≫ m') = hc_sh.desc (mkCoconeA s) := by
              apply hc_sh.uniq (mkCoconeA s)
              intro i
              calc
                c_sh.ι.app i ≫ (e_pt.hom ≫ (inl_A ≫ m'))
                  = (c_sh.ι.app i ≫ e_pt.hom ≫ inl_A) ≫ m' := by simp only [Category.assoc]
                _ = (inl_lvl i ≫ c_M.ι.app i) ≫ m' := by rw [hinl_ι i]
                _ = inl_lvl i ≫ (c_M.ι.app i ≫ m') := Category.assoc _ _ _
                _ = inl_lvl i ≫ s.ι.app i := by rw [hm' i]
            calc
              inl_A ≫ m' = (e_pt.inv ≫ e_pt.hom) ≫ (inl_A ≫ m') := by
                rw [e_pt.inv_hom_id, Category.id_comp]
              _ = e_pt.inv ≫ (e_pt.hom ≫ (inl_A ≫ m')) := Category.assoc _ _ _
              _ = e_pt.inv ≫ hc_sh.desc (mkCoconeA s) := by rw [h_uniq_sh]
          · rw [hinr_desc s]
            calc
              inr_A ≫ m' = (inr_lvl i₀ ≫ c_M.ι.app i₀) ≫ m' := by rw [hinr_ι i₀]
              _ = inr_lvl i₀ ≫ (c_M.ι.app i₀ ≫ m') := Category.assoc _ _ _
              _ = inr_lvl i₀ ≫ s.ι.app i₀ := by rw [hm' i₀] }
    let F_forget := CategoryTheory.forget CommRingCat.{u}
    let hc_M_type : CategoryTheory.Limits.IsColimit (F_forget.mapCocone c_M) :=
      CategoryTheory.Limits.isColimitOfPreserves F_forget hc_M
    refine ⟨?_, ?_⟩
    · intro x
      obtain ⟨i, y, hy⟩ := CategoryTheory.Limits.Concrete.isColimit_exists_rep D_M hc_M x
