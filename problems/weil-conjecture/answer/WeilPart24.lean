                (algebraMap R (Localization.Away P) P) ^ (max k₁ k₂ - k₁) *
                (algebraMap R (Localization.Away P) P) ^ (K - max k₁ k₂)) := by ring
          _ = w.1 * (algebraMap R (Localization.Away P) P) ^ K := by
            rw [← pow_add, ← pow_add, h1]
      · rw [map_mul, map_mul, map_pow, map_pow, ← hb₂]
        have h2 : k₂ + (max k₁ k₂ - k₂) + (K - max k₁ k₂) = K := by omega
        calc
          ((w⁻¹).1 * (algebraMap R (Localization.Away P) P) ^ k₂ *
              (algebraMap R (Localization.Away P) P) ^ (max k₁ k₂ - k₂)) *
              (algebraMap R (Localization.Away P) P) ^ (K - max k₁ k₂)
            = (w⁻¹).1 * ((algebraMap R (Localization.Away P) P) ^ k₂ *
                (algebraMap R (Localization.Away P) P) ^ (max k₁ k₂ - k₂) *
                (algebraMap R (Localization.Away P) P) ^ (K - max k₁ k₂)) := by ring
          _ = (w⁻¹).1 * (algebraMap R (Localization.Away P) P) ^ K := by
            rw [← pow_add, ← pow_add, h2]
