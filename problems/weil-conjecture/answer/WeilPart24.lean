        ∃ (k : ℕ) (a b : R),
          ∀ K : ℕ, k ≤ K →
            algebraMap R (Localization.Away P) (a * P ^ (K - k)) =
              w.1 * (algebraMap R (Localization.Away P) P) ^ K ∧
            algebraMap R (Localization.Away P) (b * P ^ (K - k)) =
              (w⁻¹).1 * (algebraMap R (Localization.Away P) P) ^ K := by
      intro R _ P w
      obtain ⟨k₁, a₁, ha₁⟩ := IsLocalization.Away.surj P w.1
      obtain ⟨k₂, b₂, hb₂⟩ := IsLocalization.Away.surj P (w⁻¹).1
      refine ⟨max k₁ k₂, a₁ * P ^ (max k₁ k₂ - k₁), b₂ * P ^ (max k₁ k₂ - k₂), fun K hK => ?_⟩
