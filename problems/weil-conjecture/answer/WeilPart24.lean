  let R'₀ := ↑(Y'.presheaf.obj (Opposite.op U'_in))
  let R'₁ := ↑(Y'.presheaf.obj (Opposite.op U'_out))
  let R'₀₁ := ↑(Y'.presheaf.obj (Opposite.op (U'_out ⊓ U'_in)))
  letI : CommRing R'₀ := inferInstance
