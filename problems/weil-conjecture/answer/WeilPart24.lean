          rw [← map_add]
          congr 1
          rw [map_add]
          ring
        map_smul' := fun b x => by
          simp only [RingHom.id_apply, Algebra.smul_def]
          have hσb : σ (algebraMap B₀ A'_x b) = algebraMap B₀ A'_x b := by
            change algebraMap B₀ A'_x (q_x (algebraMap B₀ A'_x b)) = _
            rw [q_x.commutes]
            rfl
          change mk_J2 (algebraMap B₀ A'_x b * x - σ (algebraMap B₀ A'_x b * x)) =
            algebraMap B₀ M b * mk_J2 (x - σ x)
          have halgM : algebraMap B₀ M b = mk_J2 (algebraMap B₀ A'_x b) := rfl
          rw [map_mul, hσb, ← mul_sub, map_mul, halgM] }
    let D_x : Derivation B₀ A'_x M :=
      { D_lin with
        map_one_eq_zero' := by
          change mk_J2 (1 - σ 1) = 0
          rw [map_one, sub_self, map_zero]
        leibniz' := fun x y => by
          change mk_J2 (x * y - σ (x * y)) =
