theorem weil_kummer_adjoinRoot_finite_etale_surjective_and_pushout (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (R : Type u) [CommRing R],
      IsUnit (ℓ : R) →
      ∀ (u v : R), u * v = 1 →
      let P : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C u
      let T : Type u := AdjoinRoot P
      (algebraMap R T).Finite ∧
      (algebraMap R T).Etale ∧
      Function.Surjective (PrimeSpectrum.comap (algebraMap R T)) ∧
      IsUnit (AdjoinRoot.root P)) ∧
    (∀ (R S : Type u) [CommRing R] [CommRing S]
       (φ : R →+* S) (f_R U_R : R) (f_S U_S : S),
       φ f_R = f_S → φ U_R = U_S →
       let R_f := Localization.Away f_R
       let S_f := Localization.Away f_S
       let T_R := AdjoinRoot ((Polynomial.X : Polynomial R_f) ^ ℓ -
         Polynomial.C (algebraMap R R_f U_R))
       let T_S := AdjoinRoot ((Polynomial.X : Polynomial S_f) ^ ℓ -
         Polynomial.C (algebraMap S S_f U_S))
       ∃ (φ_loc : R_f →+* S_f) (φ_tilde : T_R →+* T_S),
         φ_loc.comp (algebraMap R R_f) = (algebraMap S S_f).comp φ ∧
         φ_tilde.comp (algebraMap R_f T_R) = (algebraMap S_f T_S).comp φ_loc ∧
         φ_tilde (AdjoinRoot.root _) = AdjoinRoot.root _ ∧
         CategoryTheory.IsPushout
           (CommRingCat.ofHom (algebraMap R R_f))
           (CommRingCat.ofHom φ)
           (CommRingCat.ofHom φ_loc)
           (CommRingCat.ofHom (algebraMap S S_f)) ∧
         CategoryTheory.IsPushout
           (CommRingCat.ofHom (algebraMap R_f T_R))
           (CommRingCat.ofHom φ_loc)
           (CommRingCat.ofHom φ_tilde)
           (CommRingCat.ofHom (algebraMap S_f T_S))) :=
by
  have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hℓ_ne : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  refine ⟨?_, ?_⟩
  · intro R _ hℓ u v huv
    dsimp only
    let P : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C u
    let T : Type u := AdjoinRoot P
    have hMonic : P.Monic := Polynomial.monic_X_pow_sub_C u hℓ_ne
    let hAdj := AdjoinRoot.isAdjoinRootMonic P hMonic
    have : Module.Finite R T := Module.Finite.of_basis hAdj.basis
    have hFin : (algebraMap R T).Finite := RingHom.finite_algebraMap.mpr inferInstance
    let Z : T := AdjoinRoot.root P
    have hZ_eval : Polynomial.aeval Z P = 0 := by
      rw [Polynomial.aeval_def]
      exact AdjoinRoot.eval₂_root P
    have hZ_pow : Z ^ ℓ = algebraMap R T u := by
      have h0 : Z ^ ℓ - algebraMap R T u = 0 := by
        simpa [P, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C] using hZ_eval
      exact sub_eq_zero.mp h0
    have hZ_mul : Z * (Z ^ (ℓ - 1) * algebraMap R T v) = 1 := by
      calc Z * (Z ^ (ℓ - 1) * algebraMap R T v)
          = Z ^ (1 + (ℓ - 1)) * algebraMap R T v := by rw [pow_add, pow_one, mul_assoc]
        _ = Z ^ ℓ * algebraMap R T v := by rw [Nat.add_sub_of_le hℓ_pos]
        _ = algebraMap R T (u * v) := by rw [hZ_pow, ← map_mul]
        _ = 1 := by rw [huv, map_one]
    have hZ_unit : IsUnit Z := ⟨Units.mkOfMulEqOne Z _ hZ_mul, rfl⟩
    have hSurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R T)) := by
      by_cases hSub : Subsingleton R
      · intro p
        exact False.elim (p.isPrime.ne_top (@Subsingleton.elim (Ideal R)
          (by have : Subsingleton R := hSub; infer_instance) _ _))
      · have : Nontrivial R := not_subsingleton_iff_nontrivial.mp hSub
        have hdeg : P.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
        let i0 : Fin P.natDegree := ⟨0, hdeg.symm ▸ hℓ_pos⟩
        have hb0 : hAdj.basis i0 = 1 := by
          rw [IsAdjoinRootMonic.basis_apply]
          simp [i0]
        have hinj : Function.Injective (algebraMap R T) := by
          have hrepr : ∀ r : R, (hAdj.basis.repr (algebraMap R T r)) i0 = r := by
            intro r
            have hr : algebraMap R T r = r • hAdj.basis i0 := by
              rw [hb0, Algebra.smul_def, mul_one]
            rw [hr, map_smul, hAdj.basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
              Finsupp.single_eq_same]
          intro r₁ r₂ heq
          rw [← hrepr r₁, ← hrepr r₂, heq]
        have : Algebra.IsIntegral R T := Algebra.IsIntegral.of_finite R T
        have hInt : (algebraMap R T).IsIntegral := fun x => Algebra.IsIntegral.isIntegral x
        exact RingHom.IsIntegral.comap_surjective hInt hinj
    have hEt : (algebraMap R T).Etale := by
      obtain ⟨uℓ, huℓ⟩ := hℓ
      let ℓ_inv : R := ↑uℓ⁻¹
      have hℓ_inv : (ℓ : R) * ℓ_inv = 1 := by
        rw [← huℓ]
        exact uℓ.mul_inv
      have hderiv : Polynomial.derivative P = Polynomial.C (ℓ : R) * Polynomial.X ^ (ℓ - 1) := by
        dsimp only [P]
        rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      let p₁ : Polynomial R := Polynomial.C (ℓ_inv * v) * Polynomial.X
      let p₂ : Polynomial R := -Polynomial.C v
      have hXpow : (Polynomial.X : Polynomial R) ^ (ℓ - 1) * Polynomial.X = Polynomial.X ^ ℓ := by
        rw [← pow_succ, Nat.sub_add_cancel hℓ_pos]
      have hBezout : Polynomial.derivative P * p₁ + P * p₂ = (1 : Polynomial R) ^ 1 := by
        calc Polynomial.derivative P * p₁ + P * p₂
            = (Polynomial.C (ℓ : R) * Polynomial.C (ℓ_inv * v)) *
                ((Polynomial.X : Polynomial R) ^ (ℓ - 1) * Polynomial.X) +
              (Polynomial.X ^ ℓ - Polynomial.C u) * (-Polynomial.C v) := by
              rw [hderiv]; ring
          _ = Polynomial.C ((ℓ : R) * (ℓ_inv * v)) * Polynomial.X ^ ℓ -
              Polynomial.C v * Polynomial.X ^ ℓ + Polynomial.C u * Polynomial.C v := by
              rw [hXpow, ← Polynomial.C_mul]; ring
          _ = (1 : Polynomial R) ^ 1 := by
              rw [← mul_assoc (ℓ : R), hℓ_inv, one_mul, ← Polynomial.C_mul, huv, map_one]; ring
      let SP : StandardEtalePair R := StandardEtalePair.mk P hMonic 1 ⟨p₁, p₂, 1, hBezout⟩
      have hHasMap : SP.HasMap Z := ⟨hZ_eval, by simp [SP]⟩
      let fwd : SP.Ring →ₐ[R] T := SP.lift Z hHasMap
      have hX_eval : Polynomial.aeval SP.X P = 0 := SP.hasMap_X.1
      let bwd : T →ₐ[R] SP.Ring := AdjoinRoot.liftAlgHom P (Algebra.ofId R SP.Ring) SP.X
        (by simpa [Polynomial.aeval_def] using hX_eval)
      have h_fb : fwd.comp bwd = AlgHom.id R T := by
        apply AdjoinRoot.algHom_ext
        change fwd (bwd Z) = Z
        have hbZ : bwd Z = SP.X := AdjoinRoot.liftAlgHom_root P _ _ _
        rw [hbZ]
        exact SP.lift_X Z hHasMap
      have h_bf : bwd.comp fwd = AlgHom.id R SP.Ring := by
        apply SP.hom_ext
        change bwd (fwd SP.X) = SP.X
        rw [SP.lift_X Z hHasMap]
        exact AdjoinRoot.liftAlgHom_root P _ _ _
      have hBij : Function.Bijective fwd :=
        ⟨Function.LeftInverse.injective (fun x => AlgHom.congr_fun h_bf x),
         Function.RightInverse.surjective (fun y => AlgHom.congr_fun h_fb y)⟩
      have : Algebra.IsStandardEtale R T :=
        Algebra.IsStandardEtale.mk ⟨StandardEtalePresentation.mk SP Z hHasMap hBij⟩
      have : Algebra.Etale R T := inferInstance
      exact RingHom.etale_algebraMap.mpr inferInstance
    exact ⟨hFin, hEt, hSurj, hZ_unit⟩
  · intro R S _ _ φ f_R U_R f_S U_S hf hU
    dsimp only
    let R_f := Localization.Away f_R
    let S_f := Localization.Away f_S
    let P_R : Polynomial R_f := (Polynomial.X : Polynomial R_f) ^ ℓ -
      Polynomial.C (algebraMap R R_f U_R)
    let P_S : Polynomial S_f := (Polynomial.X : Polynomial S_f) ^ ℓ -
      Polynomial.C (algebraMap S S_f U_S)
    let T_R := AdjoinRoot P_R
    let T_S := AdjoinRoot P_S
    have hu_S : IsUnit (((algebraMap S S_f).comp φ) f_R) := by
      change IsUnit (algebraMap S S_f (φ f_R))
      rw [hf]
      exact IsLocalization.Away.algebraMap_isUnit (S := S_f) f_S
    let φ_loc : R_f →+* S_f :=
      IsLocalization.Away.lift (S := R_f) f_R (g := (algebraMap S S_f).comp φ) hu_S
    have hφ_loc : φ_loc.comp (algebraMap R R_f) = (algebraMap S S_f).comp φ := by
      ext r
      exact IsLocalization.Away.lift_eq (S := R_f) f_R hu_S r
    have hZ_S_eval : Polynomial.eval₂ ((algebraMap S_f T_S).comp φ_loc) (AdjoinRoot.root P_S) P_R = 0 := by
      have hU_eq : φ_loc (algebraMap R R_f U_R) = algebraMap S S_f U_S := by
        rw [← hU]
        exact RingHom.congr_fun hφ_loc U_R
      have hroot_S := AdjoinRoot.eval₂_root P_S
      simpa [P_R, P_S, T_S, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, hU_eq, AdjoinRoot.algebraMap_eq] using hroot_S
    let φ_tilde : T_R →+* T_S :=
      AdjoinRoot.lift ((algebraMap S_f T_S).comp φ_loc) (AdjoinRoot.root P_S) hZ_S_eval
    have hφ_tilde_comp : φ_tilde.comp (algebraMap R_f T_R) = (algebraMap S_f T_S).comp φ_loc := by
      ext x
      change φ_tilde (AdjoinRoot.of P_R x) = _
      exact AdjoinRoot.lift_of hZ_S_eval
    have hφ_tilde_root : φ_tilde (AdjoinRoot.root P_R) = AdjoinRoot.root P_S :=
      AdjoinRoot.lift_root hZ_S_eval
    have hPush1 : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap R R_f))
        (CommRingCat.ofHom φ)
        (CommRingCat.ofHom φ_loc)
        (CommRingCat.ofHom (algebraMap S S_f)) := by
      have heq1 : CommRingCat.ofHom (algebraMap R R_f) ≫ CommRingCat.ofHom φ_loc =
          CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap S S_f) := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hφ_loc]
      have hu_pt : ∀ s : CategoryTheory.Limits.PushoutCocone
          (CommRingCat.ofHom (algebraMap R R_f)) (CommRingCat.ofHom φ),
          IsUnit (s.inr.hom f_S) := by
        intro s
        have hs : (s.inl.hom).comp (algebraMap R R_f) = (s.inr.hom).comp φ :=
          congrArg CommRingCat.Hom.hom s.condition
        rw [← hf, ← RingHom.comp_apply, ← hs, RingHom.comp_apply]
        exact (IsLocalization.Away.algebraMap_isUnit (S := R_f) f_R).map s.inl.hom.toMonoidHom
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk heq1
          (fun s => CommRingCat.ofHom
            (IsLocalization.Away.lift (S := S_f) f_S (g := s.inr.hom) (hu_pt s))) ?_ ?_ ?_)
      · intro s
        ext x
        revert x
        rw [← RingHom.ext_iff]
        apply IsLocalization.ringHom_ext (Submonoid.powers f_R)
        ext r
        simp only [RingHom.comp_apply, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
        have hr : φ_loc (algebraMap R R_f r) = algebraMap S S_f (φ r) :=
          RingHom.congr_fun hφ_loc r
        rw [hr, IsLocalization.Away.lift_eq (S := S_f)]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition).symm r
      · intro s
        ext x
        exact IsLocalization.Away.lift_eq (S := S_f) f_S (hu_pt s) x
      · intro s m hm1 hm2
        ext x
        revert x
        rw [← RingHom.ext_iff]
        apply IsLocalization.ringHom_ext (Submonoid.powers f_S)
        ext b
        simp only [RingHom.comp_apply, CommRingCat.hom_ofHom, IsLocalization.Away.lift_eq (S := S_f)]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm2) b
    have hPush2 : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap R_f T_R))
        (CommRingCat.ofHom φ_loc)
        (CommRingCat.ofHom φ_tilde)
        (CommRingCat.ofHom (algebraMap S_f T_S)) := by
      have heq2 : CommRingCat.ofHom (algebraMap R_f T_R) ≫ CommRingCat.ofHom φ_tilde =
          CommRingCat.ofHom φ_loc ≫ CommRingCat.ofHom (algebraMap S_f T_S) := by
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hφ_tilde_comp]
      have hw_pt : ∀ s : CategoryTheory.Limits.PushoutCocone
          (CommRingCat.ofHom (algebraMap R_f T_R)) (CommRingCat.ofHom φ_loc),
          Polynomial.eval₂ s.inr.hom (s.inl.hom (AdjoinRoot.root P_R)) P_S = 0 := by
        intro s
        have hs : (s.inl.hom).comp (algebraMap R_f T_R) = (s.inr.hom).comp φ_loc :=
          congrArg CommRingCat.Hom.hom s.condition
        have hU_eq : φ_loc (algebraMap R R_f U_R) = algebraMap S S_f U_S := by
          rw [← hU]
          exact RingHom.congr_fun hφ_loc U_R
        have hroot_R := congrArg s.inl.hom (AdjoinRoot.eval₂_root P_R)
        have h1 : s.inl.hom (AdjoinRoot.root P_R) ^ ℓ -
            s.inl.hom (algebraMap R_f T_R (algebraMap R R_f U_R)) = 0 := by
          simpa [P_R, T_R, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
            Polynomial.eval₂_C, AdjoinRoot.algebraMap_eq] using hroot_R
        have h2 : s.inl.hom (algebraMap R_f T_R (algebraMap R R_f U_R)) =
            s.inr.hom (algebraMap S S_f U_S) := by
          rw [← hU_eq]
          exact RingHom.congr_fun hs (algebraMap R R_f U_R)
        simpa [P_S, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
          Polynomial.eval₂_C, h2] using h1
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk heq2
          (fun s => CommRingCat.ofHom
            (AdjoinRoot.lift s.inr.hom (s.inl.hom (AdjoinRoot.root P_R)) (hw_pt s))) ?_ ?_ ?_)
      · intro s
        ext a
        · simp only [RingHom.comp_apply, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
            ← AdjoinRoot.algebraMap_eq]
          have ha : φ_tilde (algebraMap R_f T_R a) = algebraMap S_f T_S (φ_loc a) :=
            RingHom.congr_fun hφ_tilde_comp a
          rw [ha]
          change (AdjoinRoot.lift _ _ _) (AdjoinRoot.of P_S (φ_loc a)) = _
          rw [AdjoinRoot.lift_of]
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition).symm a
        · simp only [RingHom.comp_apply, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
          rw [hφ_tilde_root]
          exact AdjoinRoot.lift_root (hw_pt s)
      · intro s
        ext x
        change (AdjoinRoot.lift s.inr.hom (s.inl.hom (AdjoinRoot.root P_R)) (hw_pt s))
          (AdjoinRoot.of P_S x) = _
        exact AdjoinRoot.lift_of (hw_pt s)
      · intro s m hm1 hm2
        ext b
        · simp only [RingHom.comp_apply, CommRingCat.hom_ofHom, AdjoinRoot.lift_of]
          rw [← AdjoinRoot.algebraMap_eq]
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm2) b
        · simp only [CommRingCat.hom_ofHom, AdjoinRoot.lift_root]
          rw [← hφ_tilde_root]
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm1) (AdjoinRoot.root P_R)
    exact ⟨φ_loc, φ_tilde, hφ_loc, hφ_tilde_comp, hφ_tilde_root, hPush1, hPush2⟩

theorem weil_twoChart_equalizer_cyclic_rings_and_away_localization (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R₀ R₁_ch R₀₁ : Type u) [CommRing R₀] [CommRing R₁_ch] [CommRing R₀₁]
    (t₀ : R₀) (t₁ : R₁_ch) (ι₀ : R₀ →+* R₀₁) (ι₁ : R₁_ch →+* R₀₁)
    (hLoc₀ : @IsLocalization.Away R₀ _ t₀ R₀₁ _ ι₀.toAlgebra)
    (hLoc₁ : @IsLocalization.Away R₁_ch _ t₁ R₀₁ _ ι₁.toAlgebra)
    (m₀ m₁ e T_ann : ℕ)
    (f₀ q₀ U₀ : Fin m₀ → R₀) (G₀₀ G'₀₀ : Fin m₀ → Fin m₀ → R₀)
    (f₁ q₁ U₁ : Fin m₁ → R₁_ch) (G₁₁ G'₁₁ : Fin m₁ → Fin m₁ → R₁_ch)
    (G₀₁ G'₀₁ : Fin m₀ → Fin m₁ → R₀₁)
    (hPoU₀ : (∑ r : Fin m₀, q₀ r * f₀ r) = 1)
    (hPoU₁ : (∑ s : Fin m₁, q₁ s * f₁ s) = 1)
    (hDiag₀ : ∀ r : Fin m₀, G₀₀ r r = (f₀ r * f₀ r) ^ e)
    (hDiag₁ : ∀ s : Fin m₁, G₁₁ s s = (f₁ s * f₁ s) ^ e)
    (hInv₀ : ∀ r r' : Fin m₀, G₀₀ r r' * G'₀₀ r r' = (f₀ r * f₀ r') ^ (2 * e))
    (hInv₁ : ∀ s s' : Fin m₁, G₁₁ s s' * G'₁₁ s s' = (f₁ s * f₁ s') ^ (2 * e))
    (hInv₀₁ : ∀ (r : Fin m₀) (s : Fin m₁),
      G₀₁ r s * G'₀₁ r s = (ι₀ (f₀ r) * ι₁ (f₁ s)) ^ (2 * e))
    (hPow₀ : ∀ r r' : Fin m₀, (G₀₀ r r') ^ ℓ * U₀ r' = (f₀ r * f₀ r') ^ (ℓ * e) * U₀ r)
    (hPow₁ : ∀ s s' : Fin m₁, (G₁₁ s s') ^ ℓ * U₁ s' = (f₁ s * f₁ s') ^ (ℓ * e) * U₁ s)
    (hPow₀₁ : ∀ (r : Fin m₀) (s : Fin m₁),
      (G₀₁ r s) ^ ℓ * ι₁ (U₁ s) = (ι₀ (f₀ r) * ι₁ (f₁ s)) ^ (ℓ * e) * ι₀ (U₀ r))
    (hCocyc₀ : ∀ r₁ r₂ r₃ : Fin m₀,
      (f₀ r₁ * f₀ r₂ * f₀ r₃) ^ T_ann *
        (G₀₀ r₁ r₂ * G₀₀ r₂ r₃ - (f₀ r₂) ^ (2 * e) * G₀₀ r₁ r₃) = 0)
    (hCocyc₁ : ∀ s₁ s₂ s₃ : Fin m₁,
      (f₁ s₁ * f₁ s₂ * f₁ s₃) ^ T_ann *
        (G₁₁ s₁ s₂ * G₁₁ s₂ s₃ - (f₁ s₂) ^ (2 * e) * G₁₁ s₁ s₃) = 0)
    (hCocyc₀₀₁ : ∀ (r₁ r₂ : Fin m₀) (s₃ : Fin m₁),
      (ι₀ (f₀ r₁) * ι₀ (f₀ r₂) * ι₁ (f₁ s₃)) ^ T_ann *
        (ι₀ (G₀₀ r₁ r₂) * G₀₁ r₂ s₃ - (ι₀ (f₀ r₂)) ^ (2 * e) * G₀₁ r₁ s₃) = 0)
    (hCocyc₀₁₁ : ∀ (r₁ : Fin m₀) (s₂ s₃ : Fin m₁),
      (ι₀ (f₀ r₁) * ι₁ (f₁ s₂) * ι₁ (f₁ s₃)) ^ T_ann *
        (G₀₁ r₁ s₂ * ι₁ (G₁₁ s₂ s₃) - (ι₁ (f₁ s₂)) ^ (2 * e) * G₀₁ r₁ s₃) = 0) :
    ∃ (R_tilde₀ R_tilde₁ R_tilde₀₁ : Type u)
      (hCR₀ : CommRing R_tilde₀) (hCR₁ : CommRing R_tilde₁) (hCR₀₁ : CommRing R_tilde₀₁),
      letI : CommRing R_tilde₀ := hCR₀
      letI : CommRing R_tilde₁ := hCR₁
      letI : CommRing R_tilde₀₁ := hCR₀₁
      ∃ (p₀ : R₀ →+* R_tilde₀) (p₁ : R₁_ch →+* R_tilde₁) (p₀₁ : R₀₁ →+* R_tilde₀₁)
        (φ₀ : R_tilde₀ →+* R_tilde₀₁) (φ₁ : R_tilde₁ →+* R_tilde₀₁)
        (π₀ : ∀ r : Fin m₀, R_tilde₀ →+* AdjoinRoot
          ((Polynomial.X : Polynomial (Localization.Away (f₀ r))) ^ ℓ -
            Polynomial.C (algebraMap R₀ (Localization.Away (f₀ r)) (U₀ r))))
        (π₁ : ∀ s : Fin m₁, R_tilde₁ →+* AdjoinRoot
          ((Polynomial.X : Polynomial (Localization.Away (f₁ s))) ^ ℓ -
            Polynomial.C (algebraMap R₁_ch (Localization.Away (f₁ s)) (U₁ s)))),
        φ₀.comp p₀ = p₀₁.comp ι₀ ∧
        φ₁.comp p₁ = p₀₁.comp ι₁ ∧
        (∀ r : Fin m₀, (π₀ r).comp p₀ =
          (algebraMap (Localization.Away (f₀ r)) _).comp (algebraMap R₀ (Localization.Away (f₀ r)))) ∧
        (∀ s : Fin m₁, (π₁ s).comp p₁ =
          (algebraMap (Localization.Away (f₁ s)) _).comp (algebraMap R₁_ch (Localization.Away (f₁ s)))) ∧
        @IsLocalization.Away R_tilde₀ _ (p₀ t₀) R_tilde₀₁ _ φ₀.toAlgebra ∧
        @IsLocalization.Away R_tilde₁ _ (p₁ t₁) R_tilde₀₁ _ φ₁.toAlgebra ∧
        (∀ r : Fin m₀, @IsLocalization.Away R_tilde₀ _ (p₀ (f₀ r)) _ _ (π₀ r).toAlgebra) ∧
        (∀ s : Fin m₁, @IsLocalization.Away R_tilde₁ _ (p₁ (f₁ s)) _ _ (π₁ s).toAlgebra) ∧
        (∀ (r r' : Fin m₀) (W : Type u) [CommRing W]
          (α_r : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₀ r))) ^ ℓ -
            Polynomial.C (algebraMap R₀ (Localization.Away (f₀ r)) (U₀ r))) →+* W)
          (α_r' : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₀ r'))) ^ ℓ -
            Polynomial.C (algebraMap R₀ (Localization.Away (f₀ r')) (U₀ r'))) →+* W)
          (χ : R_tilde₀ →+* W),
          α_r.comp (π₀ r) = χ → α_r'.comp (π₀ r') = χ →
          χ (p₀ ((f₀ r * f₀ r') ^ e)) * α_r (AdjoinRoot.root _) =
            χ (p₀ (G₀₀ r r')) * α_r' (AdjoinRoot.root _)) ∧
        (∀ (s s' : Fin m₁) (W : Type u) [CommRing W]
          (α_s : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₁ s))) ^ ℓ -
            Polynomial.C (algebraMap R₁_ch (Localization.Away (f₁ s)) (U₁ s))) →+* W)
          (α_s' : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₁ s'))) ^ ℓ -
            Polynomial.C (algebraMap R₁_ch (Localization.Away (f₁ s')) (U₁ s'))) →+* W)
          (χ : R_tilde₁ →+* W),
          α_s.comp (π₁ s) = χ → α_s'.comp (π₁ s') = χ →
          χ (p₁ ((f₁ s * f₁ s') ^ e)) * α_s (AdjoinRoot.root _) =
            χ (p₁ (G₁₁ s s')) * α_s' (AdjoinRoot.root _)) ∧
        (∀ (r : Fin m₀) (s : Fin m₁) (W : Type u) [CommRing W]
          (α_r : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₀ r))) ^ ℓ -
            Polynomial.C (algebraMap R₀ (Localization.Away (f₀ r)) (U₀ r))) →+* W)
          (α_s : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f₁ s))) ^ ℓ -
            Polynomial.C (algebraMap R₁_ch (Localization.Away (f₁ s)) (U₁ s))) →+* W)
          (χ₀₁ : R_tilde₀₁ →+* W),
          α_r.comp (π₀ r) = χ₀₁.comp φ₀ → α_s.comp (π₁ s) = χ₀₁.comp φ₁ →
          χ₀₁ (p₀₁ ((ι₀ (f₀ r) * ι₁ (f₁ s)) ^ e)) * α_r (AdjoinRoot.root _) =
            χ₀₁ (p₀₁ (G₀₁ r s)) * α_s (AdjoinRoot.root _)) :=
by
  
  
  
  have cancel_unit_left : ∀ {Q : Type u} [CommRing Q] {u x y : Q},
      IsUnit u → u * x = u * y → x = y := by
    intro Q _ u x y ⟨u₀, hu₀⟩ h
    exact u₀.mul_right_inj.mp (hu₀ ▸ h)

  have isUnit_of_mul_eq_pow_unit : ∀ {Q : Type u} [CommRing Q] {g g' u : Q} {n : ℕ},
      IsUnit u → g * g' = u ^ n → IsUnit g := by
    intro Q _ g g' u n hu hgg'
    exact isUnit_of_mul_isUnit_left (hgg'.symm ▸ hu.pow n)

  have ann_pow_sub : ∀ {Q : Type u} [CommRing Q] (c A B : Q),
      c * (A - B) = 0 → ∀ n : ℕ, c * (A ^ n - B ^ n) = 0 := by
    intro Q _ c A B hc n
    induction n with
    | zero => simp
    | succ n ih =>
      have hEq : c * (A ^ (n + 1) - B ^ (n + 1)) =
          A ^ n * (c * (A - B)) + B * (c * (A ^ n - B ^ n)) := by ring
      rw [hEq, hc, ih, mul_zero, mul_zero, add_zero]

  have mk_isLocalization_away : ∀ {A S : Type u} [CommRing A] [CommRing S] (f : A) (φ : A →+* S),
      IsUnit (φ f) →
      (∀ z : S, ∃ (n : ℕ) (a : A), φ (f ^ n) * z = φ a) →
      (∀ x : A, φ x = 0 → ∃ n : ℕ, f ^ n * x = 0) →
      @IsLocalization.Away A _ f S _ φ.toAlgebra := by
    intro A S _ _ f φ h_unit h_surj h_eq
    letI : Algebra A S := φ.toAlgebra
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · rintro ⟨_, n, rfl⟩
      change IsUnit (φ (f ^ n))
      rw [map_pow]
      exact h_unit.pow n
    · intro z
      obtain ⟨n, a, hna⟩ := h_surj z
      refine ⟨⟨a, ⟨f ^ n, n, rfl⟩⟩, ?_⟩
      change z * φ (f ^ n) = φ a
      rw [mul_comm, hna]
    · intro x y hxy
      have hsub : φ (x - y) = 0 := by
        rw [map_sub]
        exact sub_eq_zero.mpr hxy
      obtain ⟨n, hn⟩ := h_eq (x - y) hsub
      refine ⟨⟨f ^ n, n, rfl⟩, ?_⟩
      change f ^ n * x = f ^ n * y
      exact sub_eq_zero.mp (by rw [← mul_sub]; exact hn)

  have away_isUnit_of : ∀ {A S : Type u} [CommRing A] [CommRing S] (f : A) (φ : A →+* S),
      @IsLocalization.Away A _ f S _ φ.toAlgebra → IsUnit (φ f) := by
    intro A S _ _ f φ hLoc
    letI : Algebra A S := φ.toAlgebra
    haveI : IsLocalization.Away f S := hLoc
    exact IsLocalization.Away.algebraMap_isUnit (S := S) f

  have away_surj_of : ∀ {A S : Type u} [CommRing A] [CommRing S] (f : A) (φ : A →+* S),
      @IsLocalization.Away A _ f S _ φ.toAlgebra →
      ∀ z : S, ∃ (n : ℕ) (a : A), φ (f ^ n) * z = φ a := by
    intro A S _ _ f φ hLoc z
    letI : Algebra A S := φ.toAlgebra
    haveI : IsLocalization.Away f S := hLoc
    obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, hna⟩ := IsLocalization.surj (Submonoid.powers f) z
    refine ⟨n, a, ?_⟩
    change z * φ (f ^ n) = φ a at hna
    rw [mul_comm, hna]

  have away_eq_zero_of : ∀ {A S : Type u} [CommRing A] [CommRing S] (f : A) (φ : A →+* S),
      @IsLocalization.Away A _ f S _ φ.toAlgebra →
      ∀ {x : A}, φ x = 0 → ∃ n : ℕ, f ^ n * x = 0 := by
    intro A S _ _ f φ hLoc x hx
    letI : Algebra A S := φ.toAlgebra
    haveI : IsLocalization.Away f S := hLoc
    have hx' : @algebraMap A S _ _ φ.toAlgebra x = @algebraMap A S _ _ φ.toAlgebra 0 := by
      change φ x = φ 0
      rw [hx, map_zero]
    obtain ⟨⟨_, n, rfl⟩, hn⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers f) hx'
    exact ⟨n, by simpa using hn⟩

  have away_lift_of : ∀ {A S W : Type u} [CommRing A] [CommRing S] [CommRing W]
      (f : A) (φ : A →+* S),
      @IsLocalization.Away A _ f S _ φ.toAlgebra →
      ∀ (g : A →+* W), IsUnit (g f) → ∃ α : S →+* W, α.comp φ = g := by
    intro A S W _ _ _ f φ hLoc g hg
    letI : Algebra A S := φ.toAlgebra
    haveI : IsLocalization.Away f S := hLoc
    refine ⟨IsLocalization.Away.lift f (g := g) hg, ?_⟩
    ext a
    exact IsLocalization.Away.lift_eq f hg a

  have away_hom_ext_of : ∀ {A S W : Type u} [CommRing A] [CommRing S] [CommRing W]
      (f : A) (φ : A →+* S),
      @IsLocalization.Away A _ f S _ φ.toAlgebra →
      ∀ {α₁ α₂ : S →+* W}, α₁.comp φ = α₂.comp φ → α₁ = α₂ := by
    intro A S W _ _ _ f φ hLoc α₁ α₂ h
    letI : Algebra A S := φ.toAlgebra
    haveI : IsLocalization.Away f S := hLoc
    exact IsLocalization.ringHom_ext (Submonoid.powers f) h

  have away_std_toAlgebra : ∀ {A : Type u} [CommRing A] (x : A),
      @IsLocalization.Away A _ x (Localization.Away x) _
        (algebraMap A (Localization.Away x)).toAlgebra := by
    intro A _ x
    refine mk_isLocalization_away x (algebraMap A (Localization.Away x))
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away x) x) ?_ ?_
    · intro z
      obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, hna⟩ :=
        IsLocalization.surj (S := Localization.Away x) (Submonoid.powers x) z
      exact ⟨n, a, by rw [mul_comm]; exact hna⟩
    · intro a ha
      have ha' : algebraMap A (Localization.Away x) a = algebraMap A (Localization.Away x) 0 := by
        simpa using ha
      obtain ⟨⟨_, n, rfl⟩, hn⟩ :=
        IsLocalization.exists_of_eq (S := Localization.Away x) (M := Submonoid.powers x) ha'
      exact ⟨n, by simpa using hn⟩

  have away_surj_fin : ∀ {ι : Type} [Fintype ι] {A S : ι → Type u}
      [∀ i, CommRing (A i)] [∀ i, CommRing (S i)]
      (f : ∀ i, A i) (φ : ∀ i, A i →+* S i),
      (∀ i, @IsLocalization.Away (A i) _ (f i) (S i) _ (φ i).toAlgebra) →
      ∀ z : ∀ i, S i, ∃ (K : ℕ) (a : ∀ i, A i), ∀ i : ι, φ i ((f i) ^ K) * z i = φ i (a i) := by
    intro ι _ A S _ _ f φ hLoc z
    classical
    choose n a₀ hna using fun i => away_surj_of (f i) (φ i) (hLoc i) (z i)
    let K : ℕ := Finset.univ.sup n
    refine ⟨K, fun i => (f i) ^ (K - n i) * a₀ i, fun i => ?_⟩
    have hle : n i ≤ K := Finset.le_sup (Finset.mem_univ i)
    calc φ i ((f i) ^ K) * z i
        = φ i ((f i) ^ (K - n i)) * (φ i ((f i) ^ (n i)) * z i) := by
          rw [← mul_assoc, ← map_mul, ← pow_add, Nat.sub_add_cancel hle]
      _ = φ i ((f i) ^ (K - n i) * a₀ i) := by rw [hna i, map_mul]

  have uniform_pow_kill : ∀ {ι : Type} [Fintype ι] {M : ι → Type u} [∀ i, CommRing (M i)]
      (f x : ∀ i, M i),
      (∀ i : ι, ∃ n : ℕ, (f i) ^ n * x i = 0) →
      ∃ K : ℕ, ∀ i : ι, (f i) ^ K * x i = 0 := by
    intro ι _ M _ f x h
    classical
    choose n hn using h
    let K : ℕ := Finset.univ.sup n
    refine ⟨K, fun i => ?_⟩
    have hle : n i ≤ K := Finset.le_sup (Finset.mem_univ i)
    calc (f i) ^ K * x i
        = (f i) ^ (K - n i) * ((f i) ^ (n i) * x i) := by
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
      _ = 0 := by rw [hn i, mul_zero]

  have away_mul_lifts : ∀ {Q : Type u} [CommRing Q] (a b : Q),
      ∃ (ψ_L : Localization.Away a →+* Localization.Away (a * b))
        (ψ_R : Localization.Away b →+* Localization.Away (a * b)),
        ψ_L.comp (algebraMap Q (Localization.Away a)) = algebraMap Q (Localization.Away (a * b)) ∧
        ψ_R.comp (algebraMap Q (Localization.Away b)) = algebraMap Q (Localization.Away (a * b)) ∧
        @IsLocalization.Away (Localization.Away b) _ (algebraMap Q _ a)
          (Localization.Away (a * b)) _ ψ_R.toAlgebra ∧
        @IsLocalization.Away (Localization.Away a) _ (algebraMap Q _ b)
          (Localization.Away (a * b)) _ ψ_L.toAlgebra := by
    intro Q _ a b
    let Q_a := Localization.Away a
    let Q_b := Localization.Away b
    let Q_ab := Localization.Away (a * b)
    have hu_ab : IsUnit (algebraMap Q Q_ab a * algebraMap Q Q_ab b) := by
      rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit (S := Q_ab) (a * b)
    have ha_ab : IsUnit (algebraMap Q Q_ab a) := isUnit_of_mul_isUnit_left hu_ab
    have hb_ab : IsUnit (algebraMap Q Q_ab b) := isUnit_of_mul_isUnit_right hu_ab
    obtain ⟨ψ_L, hψ_L⟩ := away_lift_of a (algebraMap Q Q_a) (away_std_toAlgebra a)
      (algebraMap Q Q_ab) ha_ab
    obtain ⟨ψ_R, hψ_R⟩ := away_lift_of b (algebraMap Q Q_b) (away_std_toAlgebra b)
      (algebraMap Q Q_ab) hb_ab
    have hψ_R_eq : ∀ r : Q, ψ_R (algebraMap Q Q_b r) = algebraMap Q Q_ab r :=
      fun r => RingHom.congr_fun hψ_R r
    have hψ_L_eq : ∀ r : Q, ψ_L (algebraMap Q Q_a r) = algebraMap Q Q_ab r :=
      fun r => RingHom.congr_fun hψ_L r
    have hLoc_R : ∀ {x y : Q} (ψ : Localization.Away y →+* Localization.Away (x * y)),
        (∀ r : Q, ψ (algebraMap Q _ r) = algebraMap Q _ r) →
        @IsLocalization.Away (Localization.Away y) _ (algebraMap Q _ x)
          (Localization.Away (x * y)) _ ψ.toAlgebra := by
      intro x y ψ hψ_eq
      have hxy : IsUnit (algebraMap Q (Localization.Away (x * y)) x *
          algebraMap Q (Localization.Away (x * y)) y) := by
        rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (x * y)) _
      refine mk_isLocalization_away (algebraMap Q _ x) ψ
        (by rw [hψ_eq]; exact isUnit_of_mul_isUnit_left hxy) ?_ ?_
      · intro z
        obtain ⟨n, r, hnr⟩ := away_surj_of (x * y) (algebraMap Q (Localization.Away (x * y)))
          (away_std_toAlgebra (x * y)) z
        obtain ⟨uy, huy⟩ := (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away y) y).pow n
        refine ⟨n, algebraMap Q _ r * ↑uy⁻¹, ?_⟩
        have huy_inv : ψ (algebraMap Q _ (y ^ n)) * ψ (↑uy⁻¹) = 1 := by
          rw [← map_mul, map_pow, ← huy, Units.mul_inv, map_one]
        calc ψ ((algebraMap Q _ x) ^ n) * z
            = ψ ((algebraMap Q _ x) ^ n) * z * (ψ (algebraMap Q _ (y ^ n)) * ψ (↑uy⁻¹)) := by
              rw [huy_inv, mul_one]
          _ = (algebraMap Q _ ((x * y) ^ n) * z) * ψ (↑uy⁻¹) := by
              rw [← map_pow, hψ_eq, hψ_eq, mul_pow, map_mul, map_pow, map_pow]; ring
          _ = ψ (algebraMap Q _ r * ↑uy⁻¹) := by
              rw [hnr, ← hψ_eq r, map_mul]
      · intro w hw
        obtain ⟨k, r, hkr⟩ := away_surj_of y (algebraMap Q (Localization.Away y))
          (away_std_toAlgebra y) w
        have hr_xy : algebraMap Q (Localization.Away (x * y)) r = 0 := by
          rw [← hψ_eq r, ← hkr, map_mul, hw, mul_zero]
        obtain ⟨n, hnr⟩ := away_eq_zero_of (x * y) (algebraMap Q (Localization.Away (x * y)))
          (away_std_toAlgebra (x * y)) hr_xy
        refine ⟨n, ?_⟩
        apply cancel_unit_left ((IsLocalization.Away.algebraMap_isUnit
          (S := Localization.Away y) y).pow (n + k))
        calc (algebraMap Q (Localization.Away y) y) ^ (n + k) * ((algebraMap Q _ x) ^ n * w)
            = (algebraMap Q _ x) ^ n * (algebraMap Q _ y) ^ n * (algebraMap Q _ (y ^ k) * w) := by
              rw [pow_add, map_pow]; ring
          _ = algebraMap Q _ ((x * y) ^ n * r) := by
              rw [hkr, mul_pow, map_mul, map_mul, map_pow, map_pow]
          _ = (algebraMap Q (Localization.Away y) y) ^ (n + k) * 0 := by
              rw [hnr, map_zero, mul_zero]
    have hLoc_ψR := hLoc_R ψ_R hψ_R_eq
    have hLoc_ψL : @IsLocalization.Away Q_a _ (algebraMap Q Q_a b) Q_ab _ ψ_L.toAlgebra := by
      let Q_ba := Localization.Away (b * a)
      have hba_ab : IsUnit (algebraMap Q Q_ab (b * a)) := by
        rw [map_mul]; exact hb_ab.mul ha_ab
      have hab_ba : IsUnit (algebraMap Q Q_ba (a * b)) := by
        have hu := IsLocalization.Away.algebraMap_isUnit (S := Q_ba) (b * a)
        rw [map_mul] at hu ⊢
        exact (isUnit_of_mul_isUnit_right hu).mul (isUnit_of_mul_isUnit_left hu)
      obtain ⟨fwd, hfwd⟩ := away_lift_of (b * a) (algebraMap Q Q_ba) (away_std_toAlgebra (b * a))
        (algebraMap Q Q_ab) hba_ab
      obtain ⟨bwd, hbwd⟩ := away_lift_of (a * b) (algebraMap Q Q_ab) (away_std_toAlgebra (a * b))
        (algebraMap Q Q_ba) hab_ba
      obtain ⟨ψ_R_ba, hψ_R_ba⟩ := away_lift_of a (algebraMap Q Q_a) (away_std_toAlgebra a)
        (algebraMap Q Q_ba) (by
          have hu := IsLocalization.Away.algebraMap_isUnit (S := Q_ba) (b * a)
          rw [map_mul] at hu; exact isUnit_of_mul_isUnit_right hu)
      have hLoc_ba := hLoc_R ψ_R_ba (fun r => RingHom.congr_fun hψ_R_ba r)
      have h1 : bwd.comp fwd = RingHom.id Q_ba :=
        away_hom_ext_of (b * a) (algebraMap Q Q_ba) (away_std_toAlgebra (b * a)) (by
          rw [RingHom.comp_assoc, hfwd, hbwd, RingHom.id_comp])
      have h2 : fwd.comp bwd = RingHom.id Q_ab :=
        away_hom_ext_of (a * b) (algebraMap Q Q_ab) (away_std_toAlgebra (a * b)) (by
          rw [RingHom.comp_assoc, hbwd, hfwd, RingHom.id_comp])
      have hcomm_L : fwd.comp ψ_R_ba = ψ_L :=
        away_hom_ext_of a (algebraMap Q Q_a) (away_std_toAlgebra a) (by
          rw [RingHom.comp_assoc, hψ_R_ba, hfwd, hψ_L])
      letI : Algebra Q_a Q_ba := ψ_R_ba.toAlgebra
      letI : Algebra Q_a Q_ab := ψ_L.toAlgebra
      haveI : IsLocalization.Away (algebraMap Q Q_a b) Q_ba := hLoc_ba
      let e_ring : Q_ba ≃+* Q_ab :=
        { fwd with
          invFun := bwd
          left_inv := fun x => RingHom.congr_fun h1 x
          right_inv := fun y => RingHom.congr_fun h2 y }
      let e_alg : Q_ba ≃ₐ[Q_a] Q_ab :=
        AlgEquiv.ofRingEquiv (f := e_ring) (fun z => RingHom.congr_fun hcomm_L z)
      exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers (algebraMap Q Q_a b)) e_alg
    exact ⟨ψ_L, ψ_R, hψ_L, hψ_R, hLoc_ψR, hLoc_ψL⟩

  have pou_powers_eq_one : ∀ {R' : Type u} [CommRing R'] {m : ℕ} (f q : Fin m → R'),
      (∑ i : Fin m, q i * f i) = 1 → ∀ M : ℕ, ∃ Q : Fin m → R', (∑ i : Fin m, Q i * (f i) ^ M) = 1 := by
    intro R' _ m f q hPoU M
    have hspan : Ideal.span (Set.range f) = ⊤ := by
      rw [Ideal.eq_top_iff_one, ← hPoU]
      exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ (q i) (Ideal.subset_span ⟨i, rfl⟩)
    have hpow : Ideal.span ((fun x => x ^ M) '' Set.range f) = ⊤ :=
      Ideal.span_pow_eq_top (Set.range f) hspan M
    have hrange : ((fun x => x ^ M) '' Set.range f) = Set.range (fun i : Fin m => (f i) ^ M) := by
      ext y; simp
    rw [hrange] at hpow
    have h1 : (1 : R') ∈ Submodule.span R' (Set.range fun i : Fin m => (f i) ^ M) := by
      change (1 : R') ∈ Ideal.span (Set.range fun i : Fin m => (f i) ^ M)
      rw [hpow]; trivial
    obtain ⟨Q, hQ⟩ := (Submodule.mem_span_range_iff_exists_fun R').mp h1
    exact ⟨Q, by simpa [smul_eq_mul] using hQ⟩

  have pou_eq_of_away_eq : ∀ {R' : Type u} [CommRing R'] {m : ℕ} (f q : Fin m → R'),
      (∑ i : Fin m, q i * f i) = 1 →
      ∀ {x y : R'},
      (∀ i : Fin m, algebraMap R' (Localization.Away (f i)) x =
        algebraMap R' (Localization.Away (f i)) y) → x = y := by
    intro R' _ m f q hPoU x y hxy
    have h0 : ∀ i : Fin m, ∃ n : ℕ, (f i) ^ n * (x - y) = 0 := fun i =>
      away_eq_zero_of (f i) (algebraMap R' (Localization.Away (f i))) (away_std_toAlgebra (f i))
        (by rw [map_sub, hxy i, sub_self])
    obtain ⟨K, hK⟩ := uniform_pow_kill (M := fun _ => R') f (fun _ => x - y) h0
    obtain ⟨Q, hQ⟩ := pou_powers_eq_one f q hPoU K
    have hdiff : x - y = 0 := by
      calc x - y = (∑ i : Fin m, Q i * (f i) ^ K) * (x - y) := by rw [hQ, one_mul]
        _ = ∑ i : Fin m, Q i * ((f i) ^ K * (x - y)) := by
            rw [Finset.sum_mul]; refine Finset.sum_congr rfl fun i _ => by ring
        _ = 0 := by simp [hK]
    exact sub_eq_zero.mp hdiff

  have pou_exists_of_away_compat : ∀ {R' : Type u} [CommRing R'] {m : ℕ} (f q : Fin m → R'),
      (∑ i : Fin m, q i * f i) = 1 →
      ∀ (d : ∀ i : Fin m, Localization.Away (f i)),
      (∀ (i i' : Fin m)
         (ψ_L : Localization.Away (f i) →+* Localization.Away (f i * f i'))
         (ψ_R : Localization.Away (f i') →+* Localization.Away (f i * f i')),
         ψ_L.comp (algebraMap R' _) = algebraMap R' _ →
         ψ_R.comp (algebraMap R' _) = algebraMap R' _ →
         ψ_L (d i) = ψ_R (d i')) →
      ∃ a : R', ∀ i : Fin m, algebraMap R' (Localization.Away (f i)) a = d i := by
    intro R' _ m f q hPoU d hcompat
    obtain ⟨K₁, a₁, ha₁⟩ := away_surj_fin f (fun i => algebraMap R' (Localization.Away (f i)))
      (fun i => away_std_toAlgebra (f i)) d
    have hover : ∀ p : Fin m × Fin m,
        ∃ n : ℕ, (f p.1 * f p.2) ^ n *
          ((f p.2) ^ K₁ * a₁ p.1 - (f p.1) ^ K₁ * a₁ p.2) = 0 := by
      rintro ⟨i, i'⟩
      obtain ⟨ψ_L, ψ_R, hψ_L, hψ_R, -, -⟩ := away_mul_lifts (f i) (f i')
      apply away_eq_zero_of (f i * f i') (algebraMap R' (Localization.Away (f i * f i')))
        (away_std_toAlgebra (f i * f i'))
      let β := algebraMap R' (Localization.Away (f i * f i'))
      have hL_eq : β ((f i') ^ K₁ * a₁ i) = β ((f i * f i') ^ K₁) * ψ_L (d i) := by
        have h1 := congrArg ψ_L (ha₁ i)
        have h2 : ψ_L (algebraMap R' _ (a₁ i)) = β (a₁ i) := RingHom.congr_fun hψ_L (a₁ i)
        have h3 : ψ_L (algebraMap R' _ ((f i) ^ K₁)) = β ((f i) ^ K₁) :=
          RingHom.congr_fun hψ_L ((f i) ^ K₁)
        rw [map_mul, h2, h3] at h1
        rw [map_mul, ← h1, mul_pow, map_mul, ← mul_assoc, mul_comm (β ((f i') ^ K₁))]
      have hR_eq : β ((f i) ^ K₁ * a₁ i') = β ((f i * f i') ^ K₁) * ψ_R (d i') := by
        have h1 := congrArg ψ_R (ha₁ i')
        have h2 : ψ_R (algebraMap R' _ (a₁ i')) = β (a₁ i') := RingHom.congr_fun hψ_R (a₁ i')
        have h3 : ψ_R (algebraMap R' _ ((f i') ^ K₁)) = β ((f i') ^ K₁) :=
          RingHom.congr_fun hψ_R ((f i') ^ K₁)
        rw [map_mul, h2, h3] at h1
        rw [map_mul, ← h1, mul_pow, map_mul, mul_assoc]
      rw [map_sub, hL_eq, hR_eq, hcompat i i' ψ_L ψ_R hψ_L hψ_R, sub_self]
    obtain ⟨K₂, hK₂⟩ := uniform_pow_kill (M := fun _ : Fin m × Fin m => R')
      (fun p : Fin m × Fin m => f p.1 * f p.2)
      (fun p : Fin m × Fin m => (f p.2) ^ K₁ * a₁ p.1 - (f p.1) ^ K₁ * a₁ p.2) hover
    let M : ℕ := K₁ + K₂
    let b : Fin m → R' := fun i => (f i) ^ K₂ * a₁ i
    have hb_eq : ∀ i i' : Fin m, (f i') ^ M * b i = (f i) ^ M * b i' := by
      intro i i'
      apply sub_eq_zero.mp
      calc (f i') ^ (K₁ + K₂) * ((f i) ^ K₂ * a₁ i) - (f i) ^ (K₁ + K₂) * ((f i') ^ K₂ * a₁ i')
          = (f i * f i') ^ K₂ * ((f i') ^ K₁ * a₁ i - (f i) ^ K₁ * a₁ i') := by
            rw [pow_add, pow_add, mul_pow]; ring
        _ = 0 := hK₂ (i, i')
    obtain ⟨Q, hQ⟩ := pou_powers_eq_one f q hPoU M
    let a : R' := ∑ j : Fin m, Q j * b j
    refine ⟨a, fun i => ?_⟩
    have hfa : (f i) ^ M * a = b i := by
      calc (f i) ^ M * a
          = ∑ j : Fin m, Q j * ((f i) ^ M * b j) := by
            dsimp [a]; rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun j _ => by ring
        _ = ∑ j : Fin m, Q j * ((f j) ^ M * b i) := by
            refine Finset.sum_congr rfl fun j _ => by rw [hb_eq j i]
        _ = (∑ j : Fin m, Q j * (f j) ^ M) * b i := by
            rw [Finset.sum_mul]; refine Finset.sum_congr rfl fun j _ => by ring
        _ = b i := by rw [hQ, one_mul]
    apply cancel_unit_left ((IsLocalization.Away.algebraMap_isUnit
      (S := Localization.Away (f i)) (f i)).pow M)
    rw [← map_pow, ← map_mul, hfa]
    dsimp [b, M]
    rw [map_mul, ← ha₁ i, pow_add, map_mul, map_pow]
    ring

  have pou_ringHom_glue : ∀ {A R' : Type u} [CommRing A] [CommRing R'] {m : ℕ} (f q : Fin m → R'),
      (∑ i : Fin m, q i * f i) = 1 →
      ∀ (δ : ∀ i : Fin m, A →+* Localization.Away (f i)),
      (∀ (i i' : Fin m)
         (ψ_L : Localization.Away (f i) →+* Localization.Away (f i * f i'))
         (ψ_R : Localization.Away (f i') →+* Localization.Away (f i * f i')),
         ψ_L.comp (algebraMap R' _) = algebraMap R' _ →
         ψ_R.comp (algebraMap R' _) = algebraMap R' _ →
         ψ_L.comp (δ i) = ψ_R.comp (δ i')) →
      ∃ Φ : A →+* R', ∀ i : Fin m, (algebraMap R' (Localization.Away (f i))).comp Φ = δ i := by
    intro A R' _ _ m f q hPoU δ hcompat
    have hex : ∀ x : A, ∃ y : R', ∀ i : Fin m, algebraMap R' (Localization.Away (f i)) y = δ i x :=
      fun x => pou_exists_of_away_compat f q hPoU (fun i => δ i x)
        (fun i i' ψ_L ψ_R hL hR => RingHom.congr_fun (hcompat i i' ψ_L ψ_R hL hR) x)
    classical
    choose fn hfn using hex
    refine ⟨{ toFun := fn
              map_one' := pou_eq_of_away_eq f q hPoU fun i => by rw [hfn, map_one, map_one]
              map_mul' := fun x y => pou_eq_of_away_eq f q hPoU fun i => by
                rw [hfn, map_mul, map_mul, hfn, hfn]
              map_zero' := pou_eq_of_away_eq f q hPoU fun i => by rw [hfn, map_zero, map_zero]
              map_add' := fun x y => pou_eq_of_away_eq f q hPoU fun i => by
                rw [hfn, map_add, map_add, hfn, hfn] },
      fun i => RingHom.ext fun x => hfn x i⟩

  have adjoinRoot_root_pow : ∀ {Q : Type u} [CommRing Q] (a : Q),
      (AdjoinRoot.root ((Polynomial.X : Polynomial Q) ^ ℓ - Polynomial.C a)) ^ ℓ =
        algebraMap Q _ a := by
    intro Q _ a
    let P := (Polynomial.X : Polynomial Q) ^ ℓ - Polynomial.C a
    have hr := AdjoinRoot.eval₂_root P
    rw [← AdjoinRoot.algebraMap_eq P] at hr
    exact sub_eq_zero.mp (by
      simpa [P, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C] using hr)

  have adjoinRoot_lift_pkg : ∀ {Q W : Type u} [CommRing Q] [CommRing W]
      (a : Q) (γ : Q →+* W) (w : W),
      w ^ ℓ = γ a →
      ∃ β : AdjoinRoot ((Polynomial.X : Polynomial Q) ^ ℓ - Polynomial.C a) →+* W,
        β.comp (algebraMap Q _) = γ ∧ β (AdjoinRoot.root _) = w := by
    intro Q W _ _ a γ w hw
    have heval : Polynomial.eval₂ γ w ((Polynomial.X : Polynomial Q) ^ ℓ - Polynomial.C a) = 0 := by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
        hw, sub_self]
    refine ⟨AdjoinRoot.lift γ w heval, ?_, AdjoinRoot.lift_root heval⟩
    ext x
    rw [RingHom.comp_apply, AdjoinRoot.algebraMap_eq]
    exact AdjoinRoot.lift_of heval

  have adjoinRoot_ext_pkg : ∀ {Q W : Type u} [CommRing Q] [CommRing W]
      (a : Q) {β₁ β₂ : AdjoinRoot ((Polynomial.X : Polynomial Q) ^ ℓ - Polynomial.C a) →+* W},
      β₁.comp (algebraMap Q _) = β₂.comp (algebraMap Q _) →
      β₁ (AdjoinRoot.root _) = β₂ (AdjoinRoot.root _) →
      β₁ = β₂ := by
    intro Q W _ _ a β₁ β₂ h1 h2
    apply AdjoinRoot.ringHom_ext
    · rw [← AdjoinRoot.algebraMap_eq]; exact h1
    · exact h2

  
  
  
  have hs1 : ∀ (R : Type u) [CommRing R] (m e_c T_c : ℕ)
      (f U : Fin m → R) (G G' : Fin m → Fin m → R),
      (∀ r : Fin m, G r r = (f r * f r) ^ e_c) →
      (∀ r r' : Fin m, G r r' * G' r r' = (f r * f r') ^ (2 * e_c)) →
      (∀ r r' : Fin m, (G r r') ^ ℓ * U r' = (f r * f r') ^ (ℓ * e_c) * U r) →
      (∀ r₁ r₂ r₃ : Fin m,
        (f r₁ * f r₂ * f r₃) ^ T_c * (G r₁ r₂ * G r₂ r₃ - (f r₂) ^ (2 * e_c) * G r₁ r₃) = 0) →
      ∃ (R_tilde : Type u) (hCR : CommRing R_tilde),
        letI : CommRing R_tilde := hCR
        ∃ (p : R →+* R_tilde)
          (π : ∀ r : Fin m, R_tilde →+* AdjoinRoot
            ((Polynomial.X : Polynomial (Localization.Away (f r))) ^ ℓ -
              Polynomial.C (algebraMap R (Localization.Away (f r)) (U r)))),
          (∀ r : Fin m, (π r).comp p =
            (algebraMap (Localization.Away (f r)) _).comp (algebraMap R (Localization.Away (f r)))) ∧
          (∀ r : Fin m, @IsLocalization.Away R_tilde _ (p (f r)) _ _ (π r).toAlgebra) ∧
          (∀ (r r' : Fin m) (W : Type u) [CommRing W]
            (α_r : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f r))) ^ ℓ -
              Polynomial.C (algebraMap R (Localization.Away (f r)) (U r))) →+* W)
            (α_r' : AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f r'))) ^ ℓ -
              Polynomial.C (algebraMap R (Localization.Away (f r')) (U r'))) →+* W)
            (χ : R_tilde →+* W),
            α_r.comp (π r) = χ → α_r'.comp (π r') = χ →
            χ (p ((f r * f r') ^ e_c)) * α_r (AdjoinRoot.root _) =
              χ (p (G r r')) * α_r' (AdjoinRoot.root _)) := by
    clear hCocyc₀₁₁ hCocyc₀₀₁ hCocyc₁ hCocyc₀ hPow₀₁ hPow₁ hPow₀ hInv₀₁ hInv₁ hInv₀
      hDiag₁ hDiag₀ hPoU₁ hPoU₀ hLoc₁ hLoc₀
    intro R _ m e_c T_c f U G G' hDiag hInv hPow hCocyc
    have adjoinRoot_coord_repr : ∀ (Q : Type u) [CommRing Q] (a : Q),
        let P : Polynomial Q := (Polynomial.X : Polynomial Q) ^ ℓ - Polynomial.C a
        (∀ x : AdjoinRoot P, ∃ c : Fin ℓ → Q, x = ∑ j : Fin ℓ, c j • (AdjoinRoot.root P) ^ (j : ℕ)) ∧
        (∀ c₁ c₂ : Fin ℓ → Q,
          (∑ j : Fin ℓ, c₁ j • (AdjoinRoot.root P) ^ (j : ℕ)) =
            (∑ j : Fin ℓ, c₂ j • (AdjoinRoot.root P) ^ (j : ℕ)) ↔
          ∀ j : Fin ℓ, c₁ j = c₂ j) := by
      intro Q _ a
      dsimp only
      let P : Polynomial Q := (Polynomial.X : Polynomial Q) ^ ℓ - Polynomial.C a
      have hℓ_ne : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
      have hBasis : ∃ b : Module.Basis (Fin ℓ) Q (AdjoinRoot P),
          ∀ j : Fin ℓ, b j = (AdjoinRoot.root P) ^ (j : ℕ) := by
        by_cases hSub : Subsingleton Q
        · letI : Subsingleton Q := hSub
          haveI : Subsingleton (AdjoinRoot P) :=
            ⟨fun x y => by rw [← one_smul Q x, ← one_smul Q y, Subsingleton.elim (1 : Q) 0,
              zero_smul, zero_smul]⟩
          haveI : Subsingleton (Fin ℓ →₀ Q) :=
            ⟨fun x y => Finsupp.ext fun _ => Subsingleton.elim _ _⟩
          let e0 : AdjoinRoot P ≃ₗ[Q] (Fin ℓ →₀ Q) :=
            { toFun := 0
              map_add' := fun _ _ => Subsingleton.elim _ _
              map_smul' := fun _ _ => Subsingleton.elim _ _
              invFun := 0
              left_inv := fun _ => Subsingleton.elim _ _
              right_inv := fun _ => Subsingleton.elim _ _ }
          exact ⟨Module.Basis.ofRepr e0, fun _ => Subsingleton.elim _ _⟩
        · haveI : Nontrivial Q := not_subsingleton_iff_nontrivial.mp hSub
          have hMonic : P.Monic := Polynomial.monic_X_pow_sub_C a hℓ_ne
          have hdeg : P.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
          let hAdj := AdjoinRoot.isAdjoinRootMonic P hMonic
          let b := hAdj.basis.reindex (finCongr hdeg)
          refine ⟨b, fun j => ?_⟩
          rw [Module.Basis.reindex_apply, finCongr_symm, IsAdjoinRootMonic.basis_apply]
          rfl
      obtain ⟨b, hb⟩ := hBasis
      refine ⟨fun x => ⟨fun j => (b.repr x) j, by simpa [hb] using (b.sum_repr x).symm⟩, ?_⟩
      intro c₁ c₂
      constructor
      · intro heq j
        have hrepr : ∀ c : Fin ℓ → Q,
            (b.repr (∑ i : Fin ℓ, c i • (AdjoinRoot.root P) ^ (i : ℕ))) j = c j := by
          intro c
          have hs : (∑ i : Fin ℓ, c i • (AdjoinRoot.root P) ^ (i : ℕ)) = ∑ i : Fin ℓ, c i • b i :=
            Finset.sum_congr rfl fun i _ => by rw [hb i]
          rw [hs, map_sum, Finsupp.finsetSum_apply]
          have hsum_ite : (∑ i : Fin ℓ, (b.repr (c i • b i)) j) =
              ∑ i : Fin ℓ, (if i = j then c i else 0) :=
            Finset.sum_congr rfl fun i _ => by
              rw [map_smul, b.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.single_apply]
          rw [hsum_ite]
          simp
        rw [← hrepr c₁, ← hrepr c₂, heq]
      · intro h
        exact Finset.sum_congr rfl fun j _ => by rw [h j]
    have adjoinRoot_map_sum : ∀ {Q₁ Q₂ : Type u} [CommRing Q₁] [CommRing Q₂]
        (a₁ : Q₁) (a₂ : Q₂) (ψ : Q₁ →+* Q₂) (w : Q₂)
        (Φ : AdjoinRoot ((Polynomial.X : Polynomial Q₁) ^ ℓ - Polynomial.C a₁) →+*
          AdjoinRoot ((Polynomial.X : Polynomial Q₂) ^ ℓ - Polynomial.C a₂)),
        Φ.comp (algebraMap Q₁ _) = (algebraMap Q₂ _).comp ψ →
        Φ (AdjoinRoot.root _) = algebraMap Q₂ _ w * AdjoinRoot.root _ →
        ∀ c : Fin ℓ → Q₁,
        Φ (∑ j : Fin ℓ, c j • (AdjoinRoot.root _) ^ (j : ℕ)) =
          ∑ j : Fin ℓ, (ψ (c j) * w ^ (j : ℕ)) • (AdjoinRoot.root _) ^ (j : ℕ) := by
      intro Q₁ Q₂ _ _ a₁ a₂ ψ w Φ hΦ_alg hΦ_root c
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Algebra.smul_def, map_mul, map_pow, hΦ_root, mul_pow, ← map_pow,
        show Φ (algebraMap Q₁ _ (c j)) = algebraMap Q₂ _ (ψ (c j)) from RingHom.congr_fun hΦ_alg (c j),
        ← mul_assoc, ← map_mul, ← Algebra.smul_def]
    classical
    choose ψ_L ψ_R hψ_L hψ_R hLoc_ψR _ using fun r r' : Fin m => away_mul_lifts (f r) (f r')
    let T_r : Fin m → Type u := fun r =>
      AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f r))) ^ ℓ -
        Polynomial.C (algebraMap R (Localization.Away (f r)) (U r)))
    let T_rr' : Fin m → Fin m → Type u := fun r r' =>
      AdjoinRoot ((Polynomial.X : Polynomial (Localization.Away (f r * f r'))) ^ ℓ -
        Polynomial.C (algebraMap R (Localization.Away (f r * f r')) (U r)))
    have hPairMaps : ∀ r r' : Fin m,
        ∃ (g_hat g'_hat : Localization.Away (f r * f r'))
          (lam : T_r r →+* T_rr' r r')
          (mu : T_r r' →+* T_rr' r r'),
          g_hat * g'_hat = 1 ∧
          (algebraMap R (Localization.Away (f r * f r')) (f r * f r')) ^ e_c * g_hat =
            algebraMap R _ (G r r') ∧
          algebraMap R (Localization.Away (f r * f r')) (G r r') * g'_hat =
            algebraMap R _ ((f r * f r') ^ e_c) ∧
          lam.comp (algebraMap (Localization.Away (f r)) (T_r r)) =
            (algebraMap _ (T_rr' r r')).comp (ψ_L r r') ∧
          lam (AdjoinRoot.root _) = AdjoinRoot.root _ ∧
          mu.comp (algebraMap (Localization.Away (f r')) (T_r r')) =
            (algebraMap _ (T_rr' r r')).comp (ψ_R r r') ∧
          mu (AdjoinRoot.root _) = algebraMap _ (T_rr' r r') g'_hat * AdjoinRoot.root _ := by
      intro r r'
      let R_ab := Localization.Away (f r * f r')
      let hu := (IsLocalization.Away.algebraMap_isUnit (S := R_ab) (f r * f r')).pow e_c
      let g_hat : R_ab := algebraMap R R_ab (G r r') * ↑hu.unit⁻¹
      let g'_hat : R_ab := algebraMap R R_ab (G' r r') * ↑hu.unit⁻¹
