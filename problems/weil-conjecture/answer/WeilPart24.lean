      (h_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y')
      (hEt_A : AlgebraicGeometry.Etale h_A),
      Function.Injective (κ A h_A hEt_A) := by
    intro A _ h_A hEt_A x y hxy
    have h1 : toGmSpec A x = toGmSpec A y := hSecInj (mkEt A h_A hEt_A) hxy
    let e_A := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)
    have h2 : Units.map e_A.inv.hom.toMonoidHom (Additive.toMul x) =
        Units.map e_A.inv.hom.toMonoidHom (Additive.toMul y) :=
