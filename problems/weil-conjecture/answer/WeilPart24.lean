    let M₀ : Submonoid D := Algebra.algebraMapSubmonoid D (nonZeroDivisors A₀)
    have hLoc_T : IsLocalization M₀ T :=
      IsLocalization.tensor K (nonZeroDivisors A₀)
    have hM₀_le : M₀ ≤ nonZeroDivisors D := by
      rintro x ⟨a, ha_mem, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      exact nonZeroDivisors.ne_zero ha_mem (hInjφ (h0.trans (map_zero φ).symm))
    have hDomT : IsDomain T :=
      IsLocalization.isDomain_of_le_nonZeroDivisors T hM₀_le
    have _ : IsDomain T := hDomT
    have hInj_DT : Function.Injective (algebraMap D T) :=
      IsLocalization.injective T hM₀_le
    have hUnit_T : ∀ d : D, d ≠ 0 → IsUnit (algebraMap D T d) := by
      intro d hd
      by_contra h_not
      have h_ne_top : Ideal.span ({algebraMap D T d} : Set T) ≠ ⊤ :=
        mt Ideal.span_singleton_eq_top.mp h_not
      obtain ⟨M, hM_max, hM_le⟩ := Ideal.exists_le_maximal _ h_ne_top
      have _ : M.IsPrime := hM_max.isPrime
      let q : Ideal D := Ideal.comap (algebraMap D T) M
      have hq_prime : q.IsPrime := Ideal.comap_isPrime (algebraMap D T) M
      have hq_comap : Ideal.comap φ q = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro a ha
        by_contra ha_ne
        have hκ_ne : algebraMap A₀ K a ≠ 0 :=
          fun h0 => ha_ne ((IsFractionRing.injective A₀ K) (h0.trans (map_zero _).symm))
        have hκ_unit : IsUnit (algebraMap A₀ K a) := isUnit_iff_ne_zero.mpr hκ_ne
        have hT_eq : algebraMap D T (φ a) =
            Algebra.TensorProduct.includeRight (algebraMap A₀ K a) :=
          Algebra.TensorProduct.tmul_one_eq_one_tmul a
        have hT_unit : IsUnit (algebraMap D T (φ a)) := by
          rw [hT_eq]
          exact hκ_unit.map Algebra.TensorProduct.includeRight.toRingHom
        have h_in_M : algebraMap D T (φ a) ∈ M := ha
