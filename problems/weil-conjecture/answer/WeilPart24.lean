      apply PrimeSpectrum.ext
      ext r
      change α_inf r ∈ bot_K.asIdeal ↔ r ∈ (⊥ : PrimeSpectrum R_inf).asIdeal
      rw [hbot_K_mem, map_eq_zero_iff α_inf hα_inj]
      change r = 0 ↔ r ∈ (⊥ : Ideal R_inf)
      exact Ideal.mem_bot.symm
    have hgen_mem : genericPoint ↥(AlgebraicGeometry.Spec R_inf_cat) ∈ Set.range eq_ι.base := by
      rw [← hbot_eq, ← hl_eq]
      exact ⟨l_eq.base bot_K, rfl⟩
    have hSurj_eq : AlgebraicGeometry.Surjective eq_ι :=
      ⟨fun z => (genericPoint_specializes z).mem_closed hCl_eq hgen_mem⟩
    have hIso_eq : CategoryTheory.IsIso eq_ι :=
      @AlgebraicGeometry.isIso_of_isClosedImmersion_of_surjective _ _ eq_ι hCl_imm hSurj_eq _
    haveI : CategoryTheory.IsIso eq_ι := hIso_eq
    have hg_eq : g₁ = g₂ := CategoryTheory.Limits.eq_of_epi_equalizer
    have hpt := congrArg
      (fun m : AlgebraicGeometry.Spec R_inf_cat ⟶ X => m.base (IsLocalRing.closedPoint R_inf)) hg_eq
    have hg₂_pt : g₂.base (IsLocalRing.closedPoint R_inf) = P_inf :=
      AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint
    rw [hg₂_pt] at hpt
    exact hP_notMem (hpt ▸ ⟨(AlgebraicGeometry.Spec.map h_ev_cat).base
      (IsLocalRing.closedPoint R_inf), rfl⟩)

  
  obtain ⟨⟨a_inf, b_inf⟩, hX_ab⟩ :=
    @IsLocalization.surj R_inf _ (nonZeroDivisors R_inf) ↑X.functionField _ _ hFrac_inf
      (ψ Polynomial.X)
  have hb_inf_ne : b_inf.1 ≠ 0 := nonZeroDivisors.ne_zero b_inf.2
  have hψX_ne : ψ Polynomial.X ≠ 0 := by
    intro h0
    exact Polynomial.X_ne_zero (hψ_inj (h0.trans (map_zero ψ).symm))
  have ha_inf_ne : a_inf ≠ 0 := by
    intro ha0
    rw [ha0, map_zero] at hX_ab
    exact mul_ne_zero hψX_ne (fun hb0 => hb_inf_ne (hα_inj (hb0.trans (map_zero α_inf).symm))) hX_ab
  obtain ⟨ϖ, hϖ_irr⟩ := IsDiscreteValuationRing.exists_irreducible R_inf
  have hm_span : m_inf = Ideal.span ({ϖ} : Set R_inf) := hϖ_irr.maximalIdeal_eq
  obtain ⟨na_inf, hna_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha_inf_ne hϖ_irr
  obtain ⟨nb_inf, hnb_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb_inf_ne hϖ_irr
  have ha_inf_span : Ideal.span ({a_inf} : Set R_inf) = m_inf ^ na_inf := by
    rw [Ideal.span_singleton_eq_span_singleton.mpr hna_assoc, hm_span, Ideal.span_singleton_pow]
  have hb_inf_span : Ideal.span ({b_inf.1} : Set R_inf) = m_inf ^ nb_inf := by
    rw [Ideal.span_singleton_eq_span_singleton.mpr hnb_assoc, hm_span, Ideal.span_singleton_pow]
  have hlt_ab : na_inf < nb_inf := by
    by_contra hle
    have hnb_le : nb_inf ≤ na_inf := Nat.le_of_not_lt hle
    have hsub : Ideal.span ({a_inf} : Set R_inf) ≤ Ideal.span ({b_inf.1} : Set R_inf) := by
      rw [ha_inf_span, hb_inf_span]
      exact hStrict_inf.antitone hnb_le
    have ha_mem : a_inf ∈ Ideal.span ({b_inf.1} : Set R_inf) :=
      hsub (Ideal.subset_span (Set.mem_singleton a_inf))
    rw [Ideal.mem_span_singleton] at ha_mem
    obtain ⟨r₀, hr₀⟩ := ha_mem
    have hα_b_ne : α_inf b_inf.1 ≠ 0 :=
      fun h0 => hb_inf_ne (hα_inj (h0.trans (map_zero α_inf).symm))
    have hr₀_eq : α_inf r₀ = ψ Polynomial.X := by
      apply mul_left_cancel₀ hα_b_ne
      rw [← map_mul, ← hr₀, ← hX_ab, mul_comm]
    exact hX_not_mem r₀ hr₀_eq
  let e_exp : ℕ := nb_inf - na_inf
  have he_pos : 1 ≤ e_exp := Nat.sub_pos_of_lt hlt_ab
  have hb_in_a : b_inf.1 ∈ Ideal.span ({a_inf} : Set R_inf) := by
    have h1 : b_inf.1 ∈ m_inf ^ nb_inf :=
      hb_inf_span ▸ Ideal.subset_span (Set.mem_singleton b_inf.1)
    have h2 : m_inf ^ nb_inf ≤ Ideal.span ({a_inf} : Set R_inf) := by
      rw [← Nat.add_sub_of_le (Nat.le_of_lt hlt_ab), pow_add, ← ha_inf_span]
      exact Ideal.mul_le_left
    exact h2 h1
  rw [Ideal.mem_span_singleton] at hb_in_a
  obtain ⟨S_inf, hS_fac⟩ := hb_in_a
  have hS_ne : S_inf ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hS_fac
    exact hb_inf_ne hS_fac
  have hS_inv : α_inf S_inf * ψ Polynomial.X = 1 := by
    have hα_b_ne : α_inf b_inf.1 ≠ 0 :=
      fun h0 => hb_inf_ne (hα_inj (h0.trans (map_zero α_inf).symm))
    apply mul_right_cancel₀ hα_b_ne
    rw [one_mul, mul_assoc, hX_ab, ← map_mul, mul_comm S_inf a_inf, ← hS_fac]
  obtain ⟨e', he'_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible hS_ne hϖ_irr
  have hS_span' : Ideal.span ({S_inf} : Set R_inf) = m_inf ^ e' := by
    rw [Ideal.span_singleton_eq_span_singleton.mpr he'_assoc, hm_span, Ideal.span_singleton_pow]
  have he'_eq : e' = e_exp := by
    have h1 : m_inf ^ nb_inf = m_inf ^ (na_inf + e') := by
      rw [← hb_inf_span, hS_fac, ← Ideal.span_singleton_mul_span_singleton,
        ha_inf_span, hS_span', ← pow_add]
    have h2 : nb_inf = na_inf + e' := hStrict_inf.injective h1
    omega
  have hS_span_e : Ideal.span ({S_inf} : Set R_inf) = m_inf ^ e_exp := he'_eq ▸ hS_span'
  have hS_mem : S_inf ∈ m_inf := by
    have h1 : m_inf ^ e_exp ≤ m_inf ^ 1 := hStrict_inf.antitone he_pos
    rw [pow_one, ← hS_span_e] at h1
    exact h1 (Ideal.subset_span (Set.mem_singleton S_inf))

  
  obtain ⟨P_u, Q_u, hQu_ne, hϖ_PQ⟩ := hψ_surj (α_inf ϖ)
  have hPu_ne : P_u ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hϖ_PQ
    have hαϖ_ne : α_inf ϖ ≠ 0 :=
      fun h => hϖ_irr.ne_zero (hα_inj (h.trans (map_zero α_inf).symm))
    have hψQ_ne : ψ Q_u ≠ 0 :=
      fun h => hQu_ne (hψ_inj (h.trans (map_zero ψ).symm))
    exact mul_ne_zero hαϖ_ne hψQ_ne hϖ_PQ
  let u_rev : Polynomial k → R_inf := fun F =>
    ∑ i ∈ Finset.range (F.natDegree + 1), φ_k (F.coeff i) * S_inf ^ (F.natDegree - i)
  have hu_rev_unit : ∀ F : Polynomial k, F ≠ 0 → IsUnit (u_rev F) := by
    intro F hF
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hmem
    have hsplit : u_rev F =
        (∑ i ∈ Finset.range F.natDegree, φ_k (F.coeff i) * S_inf ^ (F.natDegree - i)) +
          φ_k F.leadingCoeff := by
      dsimp [u_rev]
      rw [Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one, Polynomial.coeff_natDegree]
    have hsum_mem : (∑ i ∈ Finset.range F.natDegree,
        φ_k (F.coeff i) * S_inf ^ (F.natDegree - i)) ∈ m_inf := by
      apply Submodule.sum_mem
      intro i hi
      have hi_lt : i < F.natDegree := Finset.mem_range.mp hi
      have hsub_pos : F.natDegree - i = (F.natDegree - i - 1) + 1 := by omega
      rw [hsub_pos, pow_succ]
      exact m_inf.mul_mem_left _ (m_inf.mul_mem_left _ hS_mem)
    have hlead_mem : φ_k F.leadingCoeff ∈ m_inf := by
      have hdiff : φ_k F.leadingCoeff = u_rev F -
          (∑ i ∈ Finset.range F.natDegree, φ_k (F.coeff i) * S_inf ^ (F.natDegree - i)) := by
        rw [hsplit, add_sub_cancel_left]
      rw [hdiff]
      exact m_inf.sub_mem hmem hsum_mem
    have hlead_unit : IsUnit (φ_k F.leadingCoeff) :=
      RingHom.isUnit_map φ_k (Ne.isUnit (Polynomial.leadingCoeff_ne_zero.mpr hF))
    exact IsLocalRing.notMem_maximalIdeal.mpr hlead_unit hlead_mem
  have hu_rev_eval : ∀ F : Polynomial k,
      ψ F * (α_inf S_inf) ^ F.natDegree = α_inf (u_rev F) := by
    intro F
    have hF_sum : ψ F = ψ (∑ i ∈ Finset.range (F.natDegree + 1),
        Polynomial.C (F.coeff i) * Polynomial.X ^ i) :=
      congrArg ψ (Polynomial.as_sum_range_C_mul_X_pow F)
    dsimp only [u_rev]
    rw [hF_sum, map_sum, Finset.sum_mul, map_sum]
    apply Finset.sum_congr rfl
    intro i hi
    have hi_le : i ≤ F.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    simp only [map_mul, map_pow]
    rw [← hφ_k_comp (F.coeff i), mul_assoc]
    congr 1
    have hpow_split : (α_inf S_inf) ^ F.natDegree =
        (α_inf S_inf) ^ i * (α_inf S_inf) ^ (F.natDegree - i) := by
      rw [← pow_add, Nat.add_sub_of_le hi_le]
    rw [hpow_split, ← mul_assoc, ← mul_pow,
      mul_comm (ψ Polynomial.X) (α_inf S_inf), hS_inv, one_pow, one_mul]
  have hR_eq : ϖ * u_rev Q_u * S_inf ^ P_u.natDegree = u_rev P_u * S_inf ^ Q_u.natDegree := by
    apply hα_inj
    simp only [map_mul, map_pow]
    rw [← hu_rev_eval Q_u, ← hu_rev_eval P_u, ← mul_assoc (α_inf ϖ), hϖ_PQ]
    ring
  have he_one : e_exp = 1 := by
    have hm1 : Ideal.span ({ϖ} : Set R_inf) = m_inf ^ 1 := by
      rw [pow_one, hm_span]
    have hspan_L : Ideal.span ({ϖ * u_rev Q_u * S_inf ^ P_u.natDegree} : Set R_inf) =
        m_inf ^ (1 + e_exp * P_u.natDegree) := by
      rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton,
        hm1, Ideal.span_singleton_eq_top.mpr (hu_rev_unit Q_u hQu_ne), Ideal.mul_top,
        ← Ideal.span_singleton_pow, hS_span_e, ← pow_mul, ← pow_add]
    have hspan_R : Ideal.span ({u_rev P_u * S_inf ^ Q_u.natDegree} : Set R_inf) =
        m_inf ^ (e_exp * Q_u.natDegree) := by
      rw [← Ideal.span_singleton_mul_span_singleton,
        Ideal.span_singleton_eq_top.mpr (hu_rev_unit P_u hPu_ne), Ideal.top_mul,
        ← Ideal.span_singleton_pow, hS_span_e, ← pow_mul]
    rw [hR_eq, hspan_R] at hspan_L
    have hexp_eq : 1 + e_exp * P_u.natDegree = e_exp * Q_u.natDegree :=
      hStrict_inf.injective hspan_L.symm
    have hd_le : P_u.natDegree ≤ Q_u.natDegree := by
      by_contra hgt
      have hle : e_exp * Q_u.natDegree ≤ e_exp * P_u.natDegree :=
        Nat.mul_le_mul_left e_exp (Nat.le_of_lt (Nat.lt_of_not_ge hgt))
      omega
    have hdvd : e_exp ∣ 1 := ⟨Q_u.natDegree - P_u.natDegree, by
      rw [Nat.mul_sub_left_distrib]
      omega⟩
    exact Nat.eq_one_of_dvd_one hdvd
  have hS_span_1 : Ideal.span ({S_inf} : Set R_inf) = m_inf ^ 1 := he_one ▸ hS_span_e

  
  have hSpan : ∀ Q : Pt, Q ≠ Q_inf →
      ∃ t_Q : ↥((weilEtaleKSheaf X).obj.obj (Opposite.op T_id)),
        ∀ y : Pt_T,
          valDiv T_id ((div_mor.hom.app (Opposite.op T_id)).hom t_Q) y =
            (Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) ⟨y.1, y.2⟩ := by
    intro Q hQ_ne
    have hQ_mem : Q.1 ∈ Set.range ι_1.base := by
      by_contra hnot
      have hQ_eq_P : Q.1 = P_inf := by
        have hmem_c : Q.1 ∈ (Set.range ι_1.base)ᶜ := hnot
        rwa [hCompl_eq, Set.mem_singleton_iff] at hmem_c
      exact hQ_ne (Subtype.ext hQ_eq_P)
    obtain ⟨c, hfc_ne, hAff_stalk⟩ := hAff_gen Q hQ_mem
    let f_c : Units ↑X.functionField := Units.mk0 (ψ (Polynomial.X - Polynomial.C c)) hfc_ne
    obtain ⟨s_Q, hs_Q⟩ := hBridge f_c
    refine ⟨(η_K.app (Opposite.op T_id)).hom s_Q, ?_⟩
    rintro ⟨y_val, hy_cl⟩
    let yx : ↥X := y_val
    let y_X : Pt := ⟨yx, hy_cl⟩
    by_cases hy_inf : yx = P_inf
    · let u_inf : R_inf := 1 - φ_k c * S_inf
      have hu_inf_unit : IsUnit u_inf := by
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hu_mem
        have h1_mem : (1 : R_inf) ∈ m_inf := by
          have h1_eq : (1 : R_inf) = u_inf + φ_k c * S_inf := by
            dsimp [u_inf]; ring
          rw [h1_eq]
          exact m_inf.add_mem hu_mem (m_inf.mul_mem_left _ hS_mem)
        exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one h1_mem
      have hu_inf_ne : u_inf ≠ 0 := hu_inf_unit.ne_zero
      have hu_inf_span : Ideal.span ({u_inf} : Set R_inf) = m_inf ^ 0 := by
        rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top.mpr hu_inf_unit]
      have hrat_inf : α_inf S_inf * (f_c : ↑X.functionField) = α_inf u_inf := by
        change α_inf S_inf * ψ (Polynomial.X - Polynomial.C c) = α_inf (1 - φ_k c * S_inf)
        rw [map_sub, mul_sub, hS_inv, ← hφ_k_comp c, map_sub, map_one, map_mul, mul_comm (α_inf S_inf)]
      have hev := hs_Q ⟨y_val, hy_cl⟩ P_inf hy_inf.symm u_inf S_inf 0 1
        hrat_inf hu_inf_ne hS_ne hu_inf_span hS_span_1
      rw [hev]
      have hyX_eq : (⟨y_val, hy_cl⟩ : Pt) = Q_inf := Subtype.ext hy_inf
      rw [hyX_eq, Finsupp.sub_apply, Finsupp.single_eq_same,
        Finsupp.single_eq_of_ne (Ne.symm hQ_ne)]
      norm_num
    · have hy_mem : y_X.1 ∈ Set.range ι_1.base := by
        by_contra hnot
        have hmem_c : yx ∈ (Set.range ι_1.base)ᶜ := hnot
        rw [hCompl_eq, Set.mem_singleton_iff] at hmem_c
        exact hy_inf hmem_c
      obtain ⟨a_y, ha_y_ne, ha_y_K, ha_y_span⟩ := hAff_stalk y_X hy_mem
      obtain ⟨hDom_y, _⟩ := hDVR_X y_X
      letI : IsDomain ↑(X.presheaf.stalk y_X.1) := hDom_y
      have h1_ne : (1 : ↑(X.presheaf.stalk y_X.1)) ≠ 0 := one_ne_zero
      have h1_span : Ideal.span ({(1 : ↑(X.presheaf.stalk y_X.1))} : Set _) =
          (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk y_X.1)) ^ 0 := by
        rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one]
      have hrat_y : algebraMap ↑(X.presheaf.stalk y_X.1) ↑X.functionField 1 *
          (f_c : ↑X.functionField) =
          algebraMap ↑(X.presheaf.stalk y_X.1) ↑X.functionField a_y := by
        rw [map_one, one_mul, ha_y_K]
        rfl
      have hev := hs_Q ⟨y_val, hy_cl⟩ y_X.1 rfl a_y 1 (if y_X = Q then 1 else 0) 0
        hrat_y ha_y_ne h1_ne ha_y_span h1_span
      rw [hev]
      have hy_ne_Qinf : y_X ≠ Q_inf := fun h => hy_inf (congrArg Subtype.val h)
      change (((if y_X = Q then 1 else 0 : ℕ) : ℤ) - (0 : ℤ)) =
        (Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) y_X
      rw [Finsupp.sub_apply, Finsupp.single_eq_of_ne hy_ne_Qinf, sub_zero, sub_zero]
      by_cases hyQ : y_X = Q
      · subst hyQ
        rw [Finsupp.single_eq_same]
        simp
      · simp [hyQ, Finsupp.single_eq_of_ne hyQ]

  
  let J := X.smallEtaleTopology
  let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_id
  let ev_hom : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
      (Fℤ ⟶ F) →+ ↥(F.obj.obj (Opposite.op T_id)) := fun F =>
    { toFun := fun φ => ((adj_c.homEquiv Aℤ F φ).hom) (ULift.up (1 : ℤ))
      map_zero' := by
        rw [adj_c.homEquiv_unit]
        change (adj_c.unit.app Aℤ ≫ (0 : Fℤ ⟶ F).hom.app (Opposite.op T_id)).hom
          (ULift.up (1 : ℤ)) = 0
        rfl
      map_add' := fun φ₁ φ₂ => by
        rw [adj_c.homEquiv_unit, adj_c.homEquiv_unit, adj_c.homEquiv_unit]
        change ((φ₁ + φ₂).hom.app (Opposite.op T_id)).hom
            ((adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ))) =
          (φ₁.hom.app (Opposite.op T_id)).hom ((adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ))) +
          (φ₂.hom.app (Opposite.op T_id)).hom ((adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)))
        rfl }
  let mk_hom : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
      ↥(F.obj.obj (Opposite.op T_id)) → (Fℤ ⟶ F) := fun F s =>
    (adj_c.homEquiv Aℤ F).symm (AddCommGrpCat.ofHom
      { toFun := fun z => z.down • s
        map_zero' := zero_zsmul s
        map_add' := fun z₁ z₂ => add_zsmul s z₁.down z₂.down })
  have hev_mk : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      (s : ↥(F.obj.obj (Opposite.op T_id))),
      ev_hom F (mk_hom F s) = s := by
    intro F s
    dsimp [ev_hom, mk_hom]
    rw [(adj_c.homEquiv Aℤ F).apply_symm_apply]
    exact one_zsmul s
  have hev_inj : ∀ F : CategoryTheory.Sheaf J AddCommGrpCat.{u},
      Function.Injective (ev_hom F) := by
    intro F φ₁ φ₂ hφ
    apply (adj_c.homEquiv Aℤ F).injective
    apply AddCommGrpCat.ext
    intro z
    have hz : z = z.down • ULift.up (1 : ℤ) := by
      ext
      change z.down = z.down * 1
      ring
    rw [hz, map_zsmul, map_zsmul]
    exact congrArg (z.down • ·) hφ
  have hev_comp : ∀ {F₁ F₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (f : Fℤ ⟶ F₁) (g : F₁ ⟶ F₂),
      ev_hom F₂ (f ≫ g) = (g.hom.app (Opposite.op T_id)).hom (ev_hom F₁ f) := by
    intro F₁ F₂ f g
    dsimp [ev_hom]
    rw [adj_c.homEquiv_unit, adj_c.homEquiv_unit, Functor.map_comp, ← CategoryTheory.Category.assoc]
    rfl

  
  let D_inf_fn : Pt_T → ℤ := fun y => Finsupp.single Q_inf (1 : ℤ) ⟨y.1, y.2⟩
  have hD_inf_fin : { y : Pt_T | D_inf_fn y ≠ 0 }.Finite := by
    apply Set.Finite.subset (Set.finite_singleton (⟨P_inf, hCl_inf⟩ : Pt_T))
    intro y hy
    change Finsupp.single Q_inf (1 : ℤ) ⟨y.1, y.2⟩ ≠ 0 at hy
    rw [Set.mem_singleton_iff]
    by_cases h : (⟨y.1, y.2⟩ : Pt) = Q_inf
    · exact Subtype.ext (congrArg Subtype.val h)
    · exfalso
      exact hy (Finsupp.single_eq_of_ne h)
  have hD_inf_range : D_inf_fn ∈ Set.range (valDiv T_id) := by
    rw [hValRange_Tid]
    exact hD_inf_fin
  obtain ⟨s_inf_div, hs_inf_div⟩ := hD_inf_range
  let d_inf : CategoryTheory.Abelian.Ext Fℤ Div_sh 0 :=
    CategoryTheory.Abelian.Ext.addEquiv₀.symm (mk_hom Div_sh s_inf_div)
  refine ⟨d_inf, ?_⟩
  intro d₀ E hd₀_eval

  let ψ_eval : CategoryTheory.Abelian.Ext Fℤ Div_sh 0 →+ (Pt_T → ℤ) :=
    (valDiv T_id).comp ((ev_hom Div_sh).comp CategoryTheory.Abelian.Ext.addEquiv₀.toAddMonoidHom)
  have hψ_eval_inj : Function.Injective ψ_eval :=
    hValInj_Tid.comp ((hev_inj Div_sh).comp CategoryTheory.Abelian.Ext.addEquiv₀.injective)
  have hψ_d_inf : ∀ y : Pt_T, ψ_eval d_inf y = Finsupp.single Q_inf (1 : ℤ) ⟨y.1, y.2⟩ := by
    intro y
    change valDiv T_id (ev_hom Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀
      (CategoryTheory.Abelian.Ext.addEquiv₀.symm (mk_hom Div_sh s_inf_div)))) y = D_inf_fn y
    rw [CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply, hev_mk, hs_inf_div]

  let rel_Q : ∀ Q : Pt, Q ≠ Q_inf → CategoryTheory.Abelian.Ext Fℤ Div_sh 0 := fun Q hQ =>
    CategoryTheory.Abelian.Ext.addEquiv₀.symm
      (mk_hom (weilEtaleKSheaf X) (Classical.choose (hSpan Q hQ)) ≫ div_mor)
  have hψ_rel_Q : ∀ (Q : Pt) (hQ : Q ≠ Q_inf) (y : Pt_T),
      ψ_eval (rel_Q Q hQ) y =
        (Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) ⟨y.1, y.2⟩ := by
    intro Q hQ y
    change valDiv T_id (ev_hom Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀
      (CategoryTheory.Abelian.Ext.addEquiv₀.symm
        (mk_hom (weilEtaleKSheaf X) (Classical.choose (hSpan Q hQ)) ≫ div_mor)))) y = _
    rw [CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply, hev_comp, hev_mk]
    exact Classical.choose_spec (hSpan Q hQ) y
  have hδ_rel_Q : ∀ (Q : Pt) (hQ : Q ≠ Q_inf),
      (rel_Q Q hQ).comp hEx_div.extClass (Nat.zero_add 1) = 0 := by
    intro Q hQ
    dsimp [rel_Q]
    rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
      hEx_div.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]

  let d_rhs : CategoryTheory.Abelian.Ext Fℤ Div_sh 0 :=
    (∑ q ∈ (E.support.erase Q_inf).attach,
      (E q.1) • rel_Q q.1 (Finset.ne_of_mem_erase q.2)) +
      (E.sum fun _ m => m) • d_inf
  have hd₀_eq : d₀ = d_rhs := by
    apply hψ_eval_inj
    funext y
    have hL : ψ_eval d₀ y = E ⟨y.1, y.2⟩ := hd₀_eval y
    rw [hL]
    dsimp [d_rhs]
    rw [map_add, map_sum, map_zsmul, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, hψ_d_inf]
    have hsum_eq1 : (∑ q ∈ (E.support.erase Q_inf).attach,
        ψ_eval ((E q.1) • rel_Q q.1 (Finset.ne_of_mem_erase q.2)) y) =
        ∑ q ∈ (E.support.erase Q_inf).attach,
          E q.1 * ((Finsupp.single q.1 (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) ⟨y.1, y.2⟩) := by
      apply Finset.sum_congr rfl
      intro q _
      rw [map_zsmul, Pi.smul_apply, hψ_rel_Q q.1 (Finset.ne_of_mem_erase q.2) y,
        zsmul_eq_mul, Int.cast_id]
    have hsum_eq2 : (∑ q ∈ (E.support.erase Q_inf).attach,
        E q.1 * ((Finsupp.single q.1 (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) ⟨y.1, y.2⟩)) =
        ∑ Q ∈ E.support.erase Q_inf,
          E Q * ((Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) ⟨y.1, y.2⟩) :=
      Finset.sum_attach (E.support.erase Q_inf)
        (fun Q => E Q * ((Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) ⟨y.1, y.2⟩))
    rw [hsum_eq1, hsum_eq2, zsmul_eq_mul, Int.cast_id]
    let y_X : Pt := ⟨y.1, y.2⟩
    change E y_X = (∑ Q ∈ E.support.erase Q_inf,
        E Q * ((Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) y_X)) +
      (E.sum fun _ m => m) * Finsupp.single Q_inf (1 : ℤ) y_X
    have hEsum : (E.sum fun _ m => m) = ∑ Q ∈ E.support, E Q := rfl
    rw [hEsum]
    by_cases hy : y_X = Q_inf
    · rw [hy, Finsupp.single_eq_same, mul_one]
      have h1 : (∑ Q ∈ E.support.erase Q_inf,
          E Q * ((Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) Q_inf)) =
          - ∑ Q ∈ E.support.erase Q_inf, E Q := by
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro Q hQ
        have hQ_ne : Q ≠ Q_inf := Finset.ne_of_mem_erase hQ
        rw [Finsupp.sub_apply, Finsupp.single_eq_same, Finsupp.single_eq_of_ne (Ne.symm hQ_ne)]
        ring
      rw [h1]
      by_cases hmem : Q_inf ∈ E.support
      · linarith [Finset.add_sum_erase E.support (fun Q => E Q) hmem]
      · have hE0 : E Q_inf = 0 := Finsupp.notMem_support_iff.mp hmem
        rw [Finset.erase_eq_of_notMem hmem, hE0]
        ring
    · rw [Finsupp.single_eq_of_ne hy, mul_zero, add_zero]
      have h2 : (∑ Q ∈ E.support.erase Q_inf,
          E Q * ((Finsupp.single Q (1 : ℤ) - Finsupp.single Q_inf (1 : ℤ)) y_X)) =
          ∑ Q ∈ E.support.erase Q_inf, if Q = y_X then E y_X else 0 := by
        apply Finset.sum_congr rfl
        intro Q _
        rw [Finsupp.sub_apply, Finsupp.single_eq_of_ne hy, sub_zero, Finsupp.single_apply]
        split_ifs with hQy
        · subst hQy; ring
        · ring
      rw [h2, Finset.sum_ite_eq']
      by_cases hmem : y_X ∈ E.support
      · simp [Finset.mem_erase, hy, hmem]
      · have hE0 : E y_X = 0 := Finsupp.notMem_support_iff.mp hmem
        simp [Finset.mem_erase, hmem, hE0]

  
  let δ : CategoryTheory.Abelian.Ext Fℤ Div_sh 0 →+
      CategoryTheory.Abelian.Ext Fℤ (weilEtaleGmSheaf X) 1 :=
    (hEx_div.extClass).postcomp Fℤ (Nat.zero_add 1)
  change δ d₀ = (E.sum fun _ m => m) • δ d_inf
  rw [hd₀_eq]
  dsimp [d_rhs]
  rw [map_add, map_sum, map_zsmul]
  have hsum0 : (∑ q ∈ (E.support.erase Q_inf).attach,
      δ ((E q.1) • rel_Q q.1 (Finset.ne_of_mem_erase q.2))) = 0 := by
    apply Finset.sum_eq_zero
    intro q _
    rw [map_zsmul]
    change (E q.1) • ((rel_Q q.1 (Finset.ne_of_mem_erase q.2)).comp
      hEx_div.extClass (Nat.zero_add 1)) = 0
    rw [hδ_rel_Q q.1 (Finset.ne_of_mem_erase q.2), zsmul_zero]
  rw [hsum0, zero_add]

theorem weil_etale_curve_canonical_divisor_surj_and_p1_degree (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X)) ∧
    (∀ (X_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
       [AlgebraicGeometry.IsProper X_ov.hom]
       [AlgebraicGeometry.IsIntegral X_ov.left]
       [AlgebraicGeometry.SmoothOfRelativeDimension 1 X_ov.hom],
      CompactSpace ↥X_ov.left ∧
      X_ov.left.IsSeparated ∧
      CategoryTheory.Presheaf.IsSheaf X_ov.left.smallEtaleTopology (weilEtaleKPresheaf X_ov.left) ∧
      Subsingleton ((weilEtaleGmSheaf X_ov.left).H 2) ∧
      Subsingleton ((weilEtaleKSheaf X_ov.left).H 1) ∧
      ∃ (Div_sh : CategoryTheory.Sheaf X_ov.left.smallEtaleTopology AddCommGrpCat.{u})
        (ι_gm : weilEtaleGmSheaf X_ov.left ⟶ weilEtaleKSheaf X_ov.left)
        (div_mor : weilEtaleKSheaf X_ov.left ⟶ Div_sh)
        (h0_div : CategoryTheory.CategoryStruct.comp ι_gm div_mor = 0)
        (valDiv : ∀ U : X_ov.left.Etale,
          ↥(Div_sh.obj.obj (Opposite.op U)) →+
            ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) } → ℤ)),
        (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact ∧
        (∀ (U : X_ov.left.Etale) (v : ↥((weilEtaleGmPresheaf X_ov.left).obj (Opposite.op U))),
          letI : IrreducibleSpace ↥X_ov.left :=
            AlgebraicGeometry.irreducibleSpace_of_isIntegral X_ov.left
          let η_X := X_ov.left.fromSpecStalk (genericPoint ↥X_ov.left)
          let η_gm := (CategoryTheory.sheafificationAdjunction X_ov.left.smallEtaleTopology
            AddCommGrpCat.{u}).unit.app (weilEtaleGmPresheaf X_ov.left)
          let η_K := (CategoryTheory.sheafificationAdjunction X_ov.left.smallEtaleTopology
            AddCommGrpCat.{u}).unit.app (weilEtaleKPresheaf X_ov.left)
          (ι_gm.hom.app (Opposite.op U)).hom ((η_gm.app (Opposite.op U)).hom v) =
            (η_K.app (Opposite.op U)).hom
              (Additive.ofMul (Units.map
                ((CategoryTheory.Limits.pullback.fst U.hom η_X).appTop).hom.toMonoidHom
                (Additive.toMul v)))) ∧
        (∀ U : X_ov.left.Etale,
          Function.Injective (valDiv U) ∧
          Set.range (valDiv U) =
            { D | ∀ u : ↥U.left, ∃ V : U.left.Opens, u ∈ V ∧
              { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) } |
                y.1 ∈ V ∧ D y ≠ 0 }.Finite } ∧
          (CompactSpace ↥U.left → Set.range (valDiv U) = { D | { y | D y ≠ 0 }.Finite })) ∧
        (∀ {U₁ U₂ : X_ov.left.Etale} (g : U₁ ⟶ U₂)
            (d : ↥(Div_sh.obj.obj (Opposite.op U₂)))
            (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥X_ov.left) }),
          valDiv U₁ ((Div_sh.obj.map g.op).hom d) y₁ =
            valDiv U₂ d ⟨g.left.base y₁.1, by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                CategoryTheory.MorphismProperty.Over.w g]
              exact y₁.2⟩) ∧
        (∀ (U : X_ov.left.Etale)
            (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) }),
          ∃ hDom : IsDomain ↑(U.left.presheaf.stalk y.1),
            @IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) _ hDom) ∧
        (∀ (U : X_ov.left.Etale) (u₀ : ↥U.left),
          ∃ (W₀ : X_ov.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W₀)
            (V₀ : U.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V₀) (_ : u₀ ∈ V₀)
            (e : V₀ ≤ (TopologicalSpace.Opens.map U.hom.base).obj W₀),
            IsDomain ↑(U.left.presheaf.obj (Opposite.op V₀)) ∧
            Function.Injective (U.hom.appLE W₀ V₀ e).hom ∧
            (∀ q : Ideal ↑(U.left.presheaf.obj (Opposite.op V₀)),
              q.IsPrime → Ideal.comap (U.hom.appLE W₀ V₀ e).hom q = ⊥ → q = ⊥) ∧
            (∀ m : Ideal ↑(U.left.presheaf.obj (Opposite.op V₀)),
              m.IsMaximal → m ≠ ⊥ →
              ∃ (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) }) (hy : y.1 ∈ V₀),
                Ideal.comap (U.left.presheaf.germ V₀ y.1 hy).hom
                  (IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1)) = m) ∧
            (∀ y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) },
              IsOpen ((V₀ : Set ↥U.left) \ {y.1})) ∧
            (∀ d : ↑(U.left.presheaf.obj (Opposite.op V₀)),
              d ≠ 0 →
              { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) } |
                ∃ hy : y.1 ∈ V₀,
                  (U.left.presheaf.germ V₀ y.1 hy).hom d ∈
                    IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1) }.Finite)) ∧
        (∀ (U : X_ov.left.Etale)
            (s : ↥((weilEtaleKPresheaf X_ov.left).obj (Opposite.op U)))
            (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) })
            (O : U.left.Opens) (hy : y.1 ∈ O),
          letI : IrreducibleSpace ↥X_ov.left :=
            AlgebraicGeometry.irreducibleSpace_of_isIntegral X_ov.left
          let η_X := X_ov.left.fromSpecStalk (genericPoint ↥X_ov.left)
          let η_K := (CategoryTheory.sheafificationAdjunction X_ov.left.smallEtaleTopology
            AddCommGrpCat.{u}).unit.app (weilEtaleKPresheaf X_ov.left)
          let O_et : X_ov.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.comp O.ι U.hom)
            (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
          let j_O : O_et ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
          ∀ (a₀ b₀ : ↑(O_et.left.presheaf.obj (Opposite.op ⊤))) (na nb : ℕ),
            ((CategoryTheory.Limits.pullback.fst O_et.hom η_X).appTop).hom b₀ *
                (Additive.toMul (((weilEtaleKPresheaf X_ov.left).map j_O.op).hom s) :
                  Units ↑((CategoryTheory.Limits.pullback O_et.hom η_X).presheaf.obj
                    (Opposite.op ⊤))).val =
              ((CategoryTheory.Limits.pullback.fst O_et.hom η_X).appTop).hom a₀ →
            let a_stk : ↑(U.left.presheaf.stalk y.1) :=
              (U.left.presheaf.germ O y.1 hy).hom (O.topIso.hom.hom a₀)
            let b_stk : ↑(U.left.presheaf.stalk y.1) :=
              (U.left.presheaf.germ O y.1 hy).hom (O.topIso.hom.hom b₀)
            a_stk ≠ 0 →
            b_stk ≠ 0 →
            Ideal.span ({a_stk} : Set ↑(U.left.presheaf.stalk y.1)) =
              (IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1)) ^ na →
            Ideal.span ({b_stk} : Set ↑(U.left.presheaf.stalk y.1)) =
              (IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1)) ^ nb →
            valDiv U ((div_mor.hom.app (Opposite.op U)).hom ((η_K.app (Opposite.op U)).hom s)) y =
              (na : ℤ) - (nb : ℤ)) ∧
        (∀ (hEx_div : (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact)
            (ι_1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) X_ov.left)
            (s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) X_ov.left),
          AlgebraicGeometry.IsOpenImmersion ι_1 →
          CategoryTheory.CategoryStruct.comp ι_1 X_ov.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) →
          CategoryTheory.CategoryStruct.comp s_inf X_ov.hom =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
          Disjoint (Set.range ι_1.base) (Set.range s_inf.base) →
          Set.range ι_1.base ∪ Set.range s_inf.base = Set.univ →
          let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
          let Fℤ := (CategoryTheory.constantSheaf X_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          let T_id := weilEtaleIdTerminal.{u} X_ov.left
          let hT_id := weilEtaleIdTerminalIsTerminal.{u} X_ov.left
          ∃ d_inf : CategoryTheory.Abelian.Ext Fℤ Div_sh 0,
            ∀ (d₀ : CategoryTheory.Abelian.Ext Fℤ Div_sh 0)
              (E : { x : ↥X_ov.left // IsClosed ({x} : Set ↥X_ov.left) } →₀ ℤ),
              (∀ y : { y : ↥T_id.left // IsClosed ({T_id.hom.base y} : Set ↥X_ov.left) },
                valDiv T_id
                  (((CategoryTheory.constantSheafAdj X_ov.left.smallEtaleTopology
                    AddCommGrpCat.{u} hT_id).homEquiv
                    Aℤ Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀ d₀)).hom
                    (ULift.up (1 : ℤ))) y = E ⟨y.1, y.2⟩) →
              d₀.comp hEx_div.extClass (Nat.zero_add 1) =
                (E.sum fun _ m => m) • (d_inf.comp hEx_div.extClass (Nat.zero_add 1)))) :=
by
  classical
  have hGmSheaf : ∀ X : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilEtaleGmPresheaf X) :=
    weil_etale_gm_isSheaf_and_proj_H0_divisible.{u}.1
  refine ⟨hGmSheaf, ?_⟩
  intro X_ov _ _ _
  have hComp_X : CompactSpace ↥X_ov.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X_ov.hom
  have hSep_X : X_ov.left.IsSeparated := by
    refine AlgebraicGeometry.Scheme.IsSeparated.mk ?_
    have hcomp : X_ov.hom ≫ CategoryTheory.Limits.terminal.from
        (AlgebraicGeometry.Spec (CommRingCat.of k)) =
        CategoryTheory.Limits.terminal.from X_ov.left :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    rw [← hcomp]
    have : AlgebraicGeometry.IsSeparated
        (CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k))) :=
      AlgebraicGeometry.Scheme.IsSeparated.isSeparated_terminal_from
    infer_instance
  have : AlgebraicGeometry.LocallyOfFiniteType X_ov.hom := inferInstance
  have hDim : topologicalKrullDim X_ov.left = (1 : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k 1 X_ov inferInstance
  have hKSheaf : CategoryTheory.Presheaf.IsSheaf X_ov.left.smallEtaleTopology
      (weilEtaleKPresheaf X_ov.left) :=
    (weil_etale_curve_weil_divisor_short_exact k X_ov hGmSheaf).1
  obtain ⟨Div_sh, valDiv, hValInj, hValRangeLoc, hValRangeComp, hValNat⟩ :=
    weil_etale_separated_locFinite_closedFiber_sheaf k X_ov
  obtain ⟨hStrict, hDVR_et, hUnram, hChart⟩ :=
    weil_smooth_curve_etale_stalk_dvr_and_domain_chart k X_ov hDim
  obtain ⟨ι_pre, div_val, hι_pre_eq, hDivNat, hDivLoc, hDivEx, hDivSurj, hDivOrd⟩ :=
    weil_etale_curve_canonical_generic_divisor_presheaf_exact k X_ov hDVR_et hUnram hChart
  have hmem_div : ∀ (U : X_ov.left.Etale)
      (s : ↥((weilEtaleKPresheaf X_ov.left).obj (Opposite.op U))),
      div_val U s ∈ Set.range (valDiv U) := by
    intro U s
    rw [hValRangeLoc U]
    exact hDivLoc U s
  let div_pre_fun : ∀ (U : X_ov.left.Etale),
      ↥((weilEtaleKPresheaf X_ov.left).obj (Opposite.op U)) →
        ↥(Div_sh.obj.obj (Opposite.op U)) :=
    fun U s => (hmem_div U s).choose
  have hdiv_pre_spec : ∀ (U : X_ov.left.Etale)
      (s : ↥((weilEtaleKPresheaf X_ov.left).obj (Opposite.op U))),
      valDiv U (div_pre_fun U s) = div_val U s :=
    fun U s => (hmem_div U s).choose_spec
  let div_pre_hom : ∀ (U : X_ov.left.Etale),
      ↥((weilEtaleKPresheaf X_ov.left).obj (Opposite.op U)) →+
        ↥(Div_sh.obj.obj (Opposite.op U)) :=
    fun U =>
      { toFun := div_pre_fun U
        map_zero' := hValInj U (by rw [hdiv_pre_spec, map_zero, map_zero])
        map_add' := fun s₁ s₂ =>
          hValInj U (by rw [hdiv_pre_spec, map_add, map_add, hdiv_pre_spec, hdiv_pre_spec]) }
  let div_pre : weilEtaleKPresheaf X_ov.left ⟶ Div_sh.obj :=
    { app := fun U => AddCommGrpCat.ofHom (div_pre_hom (Opposite.unop U))
      naturality := fun U₂ U₁ f => by
        apply AddCommGrpCat.ext
        intro s
        apply hValInj (Opposite.unop U₁)
        ext y₁
        change valDiv (Opposite.unop U₁)
            (div_pre_fun (Opposite.unop U₁)
              (((weilEtaleKPresheaf X_ov.left).map (Opposite.unop f).op).hom s)) y₁ =
          valDiv (Opposite.unop U₁)
            ((Div_sh.obj.map (Opposite.unop f).op).hom
              (div_pre_fun (Opposite.unop U₂) s)) y₁
        rw [hdiv_pre_spec, hDivNat (Opposite.unop f) s y₁,
          hValNat (Opposite.unop f) (div_pre_fun (Opposite.unop U₂) s) y₁, hdiv_pre_spec] }
  let J := X_ov.left.smallEtaleTopology
  let G_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    ⟨weilEtaleGmPresheaf X_ov.left, hGmSheaf X_ov.left⟩
  let K_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    ⟨weilEtaleKPresheaf X_ov.left, hKSheaf⟩
  let ι_sh : G_sh ⟶ K_sh := { hom := ι_pre }
  let div_sh : K_sh ⟶ Div_sh := { hom := div_pre }
  have h0_sh : ι_sh ≫ div_sh = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    ext U : 2
    apply AddCommGrpCat.ext
    intro u
    apply hValInj (Opposite.unop U)
    change valDiv (Opposite.unop U)
        (div_pre_fun (Opposite.unop U) ((ι_pre.app (Opposite.op (Opposite.unop U))).hom u)) =
      valDiv (Opposite.unop U) 0
    rw [hdiv_pre_spec, (hDivEx (Opposite.unop U)).2.1 u, map_zero]
  have : CategoryTheory.Mono ι_sh := by
    refine ⟨fun {W'} α₁ α₂ hα => ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    ext U : 2
    apply AddCommGrpCat.ext
    intro w
    apply (hDivEx (Opposite.unop U)).1
    exact congrArg (fun φ : W' ⟶ K_sh => (φ.hom.app U).hom w) hα
  have hmem_lift : ∀ {W' : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (k_mor : W' ⟶ K_sh), k_mor ≫ div_sh = 0 →
      ∀ (U : X_ov.left.Etale) (w : ↥(W'.obj.obj (Opposite.op U))),
        (k_mor.hom.app (Opposite.op U)).hom w ∈
          Set.range (ι_pre.app (Opposite.op U)).hom := by
    intro W' k_mor hk U w
    apply (hDivEx U).2.2
