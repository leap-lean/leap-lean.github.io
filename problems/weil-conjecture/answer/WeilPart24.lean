  have hg_B₀_k : g_B₀ ≫ p_V_cur = p_V₀ := by
    have hgV_cur_w : (Fgt_V.map P_cur.g_V).left ≫ (Fgt_V.obj E.V₁).hom =
        (Fgt_V.obj P_cur.V).hom :=
      CategoryTheory.MorphismProperty.Over.w P_cur.g_V
    calc
      g_B₀ ≫ ((Fgt_V.obj P_cur.V).hom ≫ E.V_bar.hom)
        = g_B₀ ≫ ((Fgt_V.map P_cur.g_V).left ≫ (Fgt_V.obj E.V₁).hom) ≫ E.V_bar.hom := by
          rw [hgV_cur_w]
      _ = g_B₀ ≫ (Fgt_V.map P_cur.g_V).left ≫ ((Fgt_V.obj E.V₁).hom ≫ E.V_bar.hom) := by
          simp only [CategoryTheory.Category.assoc]
      _ = (g_B₀ ≫ ((Fgt_V.map P_cur.g_V).left ≫ E.u_V₁)) ≫ (weilAffineSpaceOver k δ).hom := by
          rw [← E.hComp_uV₁]; simp only [CategoryTheory.Category.assoc]
      _ = u_spec_B₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
