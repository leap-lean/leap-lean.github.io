    let α₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₀_R) ≫ inl_c
    let α₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₀_L) ≫ inr_c
    have h₀₁ : α₀ ≫ g_cov = α₁ ≫ g_cov := hcomm₁₀.symm
    have htri := triple_cocycle_eq α₀ α₁ α₀ h₀₁ rfl
    have hl₀₂ : evalUnit (hPb_P₂.lift α₀ α₀ rfl) u_c = 1 := by
      have heq : hPb_P₂.lift α₀ α₀ rfl =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₀_R) ≫ l_diag₀ := by
        apply hPb_P₂.hom_ext
        · rw [hPb_P₂.lift_fst, CategoryTheory.Category.assoc, hPb_P₂.lift_fst]
        · rw [hPb_P₂.lift_snd, CategoryTheory.Category.assoc, hPb_P₂.lift_snd]
      rw [heq, eval_spec_map, h_diag₀, map_one]
    have hl₁₂ : hPb_P₂.lift α₁ α₀ (h₀₁.symm.trans rfl) = κ₁₀ := rfl
    let comm_hom : A₀₁ →+* A₁₀ :=
      (Algebra.TensorProduct.comm D.R₀₁ T₀_ov T₁_ov).toAlgHom.toRingHom
    have hl₀₁ : evalUnit (hPb_P₂.lift α₀ α₁ h₀₁) u_c =
        Units.map comm_hom.toMonoidHom q_T.g₀₁ :=
      eval_lift_rings inl_c inr_c ι₀₁_L ι₀₁_R hcomm₀₁ ι₁₀_R ι₁₀_L h₀₁ comm_hom
        (by ext t₀; rfl) (by ext t₁; rfl)
    rw [hl₀₂, hl₀₁, hl₁₂] at htri
