      have hr0 : r ∈ RingHom.ker (((τ_sh a).appLE U_1 ⊤ (h_le_U1 a)).hom) := by
        rw [RingHom.mem_ker, ← hφ_comp r, ← hsec', map_mul, hx, zero_mul]
