        refine ⟨fun r ⟨n, hn⟩ => ?_⟩
        have hTK_zero : Algebra.TensorProduct.includeRight (R := P_V_poly) (A := K_poly)
            (B := R_Y) r = 0 :=
          hRed_TK.eq_zero _ ⟨n, by rw [← map_pow, hn, map_zero]⟩
        have htmul0 : (LinearMap.rTensor R_Y ι_lin) ((1 : P_V_poly) ⊗ₜ[P_V_poly] r) =
            (LinearMap.rTensor R_Y ι_lin) 0 := by
          rw [map_zero]
          change (algebraMap P_V_poly K_poly 1) ⊗ₜ[P_V_poly] r = 0
          rw [map_one]
          exact hTK_zero
        have h1r0 : (1 : P_V_poly) ⊗ₜ[P_V_poly] r = 0 := hinj_rT htmul0
        simpa using congrArg (TensorProduct.lid P_V_poly R_Y) h1r0
