        (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hc_M_type x y).mp hxy
      exact ⟨j, u, hu⟩

  
  have hPushColim : ∀ {M : Type u} [CommRing M] [Algebra R₁ M] {i j : ℐ} (u : i ⟶ j)
      (y : TensorProduct R₁ ↑(D_sh.obj i) M) {x : TensorProduct R₁ A M},
      Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) y = x →
      Algebra.TensorProduct.map (ι_colim j) (AlgHom.id R₁ M)
        (Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M) y) = x := by
    intro M _ _ i j u y x hy
    have hcomp : (Algebra.TensorProduct.map (ι_colim j) (AlgHom.id R₁ M)).comp
        (Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M)) =
        Algebra.TensorProduct.map (ι_colim i) (AlgHom.id R₁ M) := by
      rw [← Algebra.TensorProduct.map_comp, hι_φ u, AlgHom.comp_id]
    exact (AlgHom.congr_fun hcomp y).trans hy

  have hLiftFam : ∀ {M : Type u} [CommRing M] [Algebra R₁ M] {α : Type} [Fintype α]
      (arr : α → TensorProduct R₁ A M),
      ∃ (k_idx : ℐ) (y : α → TensorProduct R₁ ↑(D_sh.obj k_idx) M),
