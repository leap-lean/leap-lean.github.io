        have ht_mem : t' ∈ RingHom.ker π_x.toRingHom := by
          rw [hker_x]
          exact Ideal.mem_span_singleton_self t'
        exact ht_mem
    have hJx_sq : J_x ^ 2 = Ideal.span {a₀ ^ 2} := by
      rw [hJx_span, Ideal.span_singleton_pow]
    let M := A'_x ⧸ (J_x ^ 2)
    let mk_J2 : A'_x →+* M := Ideal.Quotient.mk (J_x ^ 2)
    let σ : A'_x →+* A'_x := (algebraMap B₀ A'_x).comp q_x.toRingHom
    have h_sub_Jx : ∀ a : A'_x, a - σ a ∈ J_x := by
      intro a
      change q_x (a - algebraMap B₀ A'_x (q_x a)) = 0
      rw [map_sub, q_x.commutes]
      exact sub_self (q_x a)
    let D_lin : A'_x →ₗ[B₀] M :=
      { toFun := fun a => mk_J2 (a - σ a)
