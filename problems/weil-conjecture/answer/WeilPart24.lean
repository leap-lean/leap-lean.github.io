    exact AlgebraicGeometry.irreducibleSpace_of_isIntegral
      (CategoryTheory.Limits.pullback f_next s)

  
  obtain ⟨_, hEt_hY_W, hRel_Y_fn, hRel_W_fn⟩ := hRelPull_all V_next_sch h_V_B₀
  have : AlgebraicGeometry.Etale (h_Y ∣_ P_cur.W_open) := hEt_hY_W

  have hComm_Y : CategoryTheory.CategoryStruct.comp h_Y P_cur.f_bar =
      CategoryTheory.CategoryStruct.comp f_next h_V_sch := by
    change (q_raw ≫ (ν ≫ CategoryTheory.Limits.pullback.fst P_cur.f_bar g_B₀)) ≫ P_cur.f_bar =
      f_next ≫ (h_V_B₀ ≫ g_B₀)
    rw [CategoryTheory.Category.assoc q_raw, CategoryTheory.Category.assoc ν,
      CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc ν,
      ← CategoryTheory.Category.assoc q_raw]
    change (q_raw ≫ f_raw) ≫ g_B₀ = f_next ≫ (h_V_B₀ ≫ g_B₀)
    rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]

  have hComm_W_open : CategoryTheory.CategoryStruct.comp (h_Y ∣_ P_cur.W_open)
      (CategoryTheory.CategoryStruct.comp P_cur.W_open.ι P_cur.f_bar) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp W_next_open.ι f_next) h_V_sch := by
    rw [← CategoryTheory.Category.assoc (h_Y ∣_ P_cur.W_open),
      AlgebraicGeometry.morphismRestrict_ι h_Y P_cur.W_open,
      CategoryTheory.Category.assoc W_next_open.ι, hComm_Y,
      CategoryTheory.Category.assoc]

  obtain ⟨hFin_rel_step, _, hSurj_rel_step⟩ := hRel_Y_fn hComm_Y
  obtain ⟨hFin_Wopen_step, hEt_Wopen_step, hSurj_Wopen_step⟩ := hRel_W_fn hComm_W_open

  have hComm_Y₁_next : CategoryTheory.CategoryStruct.comp π_Y₁_next E.f_bar₁ =
      CategoryTheory.CategoryStruct.comp f_next (Fgt_V.map g_V_next).left := by
    change (h_Y ≫ P_cur.π_Y₁) ≫ E.f_bar₁ = f_next ≫ (h_V_sch ≫ (Fgt_V.map P_cur.g_V).left)
    rw [CategoryTheory.Category.assoc, P_cur.hComm_Y₁, ← CategoryTheory.Category.assoc,
      hComm_Y, CategoryTheory.Category.assoc]

  have hFin_rel_next : AlgebraicGeometry.IsFinite
      (CategoryTheory.Limits.pullback.lift π_Y₁_next f_next hComm_Y₁_next) :=
    (hRelComp f_next P_cur.f_bar E.f_bar₁ h_Y P_cur.π_Y₁
