    choose idx rep hrep using fun a => (hTensorColim M).1 (arr a)
    obtain ⟨k_idx, ⟨u⟩⟩ := hFinBound α idx
    exact ⟨k_idx, fun a => Algebra.TensorProduct.map (φ_tr (u a)) (AlgHom.id R₁ M) (rep a),
      fun a => hPushColim (u a) (rep a) (hrep a)⟩

