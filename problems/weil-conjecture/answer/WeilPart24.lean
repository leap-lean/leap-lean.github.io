          Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M₀) ((G₀₀_1 r r') ^ ℓ * U₀_1 r') =
          Algebra.TensorProduct.map (φ_tr w_star) (AlgHom.id R₁ M₀)
