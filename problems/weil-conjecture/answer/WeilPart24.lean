            exact hf.symm
          have hsnd : s₂.base (C₂.hom.base z) = w := by
            have hs := congrArg (CategoryTheory.Limits.pullback.snd C₂.hom C₂.hom).base hw
            change (Δ ≫ CategoryTheory.Limits.pullback.snd C₂.hom C₂.hom).base w =
              (u ≫ CategoryTheory.Limits.pullback.snd C₂.hom C₂.hom).base z at hs
            dsimp only [Δ, u] at hs
            rw [CategoryTheory.Limits.pullback.diagonal_snd,
              CategoryTheory.Limits.pullback.lift_snd,
              AlgebraicGeometry.Scheme.Hom.comp_apply] at hs
            exact hs.symm
          rw [hfst, ← hsnd, hSub_Sk (C₂.hom.base z), hs₂_pt]
      rw [hset_eq]
      exact (Δ.isClosedEmbedding.isClosed_range).preimage u.continuous

    refine ⟨hx₂_cl, ?_⟩

    
    obtain ⟨hDVR₁, hStrict₁⟩ := hDVR₁_pkg
    obtain ⟨hDVR₂, _⟩ := (hSmoothCurveClosedPt C₂ (h.base x₁.1) hx₂_cl).2
    let R₁ := ↑(C₁.left.presheaf.stalk x₁.1)
    let R₂ := ↑(C₂.left.presheaf.stalk (h.base x₁.1))
    let K₁ := ↑C₁.left.functionField
    let K₂ := ↑C₂.left.functionField
    have : IsDiscreteValuationRing R₁ := hDVR₁
    have : IsDiscreteValuationRing R₂ := hDVR₂
    let m₁ := IsLocalRing.maximalIdeal R₁
    let m₂ := IsLocalRing.maximalIdeal R₂
    let ψ_x : R₂ →+* R₁ := (h.stalkMap x₁.1).hom
    have : IsLocalHom ψ_x := inferInstance
    have hInj_alg₂ : Function.Injective (algebraMap R₂ K₂) :=
      IsFractionRing.injective R₂ K₂
    have hInj_φ : Function.Injective φ_h := φ_h.injective
    have hInj_ψ : Function.Injective ψ_x := by
      intro r₁ r₂ hr
      apply hInj_alg₂
      apply hInj_φ
      rw [← hStalkComm x₁.1 r₁, ← hStalkComm x₁.1 r₂, hr]
    obtain ⟨ϖ₂, hϖ₂⟩ := IsDiscreteValuationRing.exists_irreducible R₂
    obtain ⟨ϖ₁, hϖ₁⟩ := IsDiscreteValuationRing.exists_irreducible R₁
    have hm₂_span : m₂ = Ideal.span ({ϖ₂} : Set R₂) :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ₂).mp hϖ₂
    have hm₁_span : m₁ = Ideal.span ({ϖ₁} : Set R₁) :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ₁).mp hϖ₁
    have hψϖ₂_ne : ψ_x ϖ₂ ≠ 0 :=
      (map_ne_zero_iff ψ_x hInj_ψ).mpr hϖ₂.ne_zero
    obtain ⟨e, he_assoc⟩ :=
      IsDiscreteValuationRing.associated_pow_irreducible hψϖ₂_ne hϖ₁
    have he_map : Ideal.map ψ_x m₂ = m₁ ^ e := by
      rw [hm₂_span, Ideal.map_span, Set.image_singleton,
        Ideal.span_singleton_eq_span_singleton.mpr he_assoc,
        ← Ideal.span_singleton_pow, ← hm₁_span]
    have he_pos : 1 ≤ e := by
      by_contra hlt
      have he0 : e = 0 := by omega
      have hspan_top : Ideal.span ({ψ_x ϖ₂} : Set R₁) = ⊤ := by
        rw [← Set.image_singleton, ← Ideal.map_span, ← hm₂_span]
        change Ideal.map ψ_x m₂ = ⊤
        rw [he_map, he0, pow_zero, Ideal.one_eq_top]
      have hu_ψϖ₂ : IsUnit (ψ_x ϖ₂) := Ideal.span_singleton_eq_top.mp hspan_top
      have hu_ϖ₂ : IsUnit ϖ₂ := IsLocalHom.map_nonunit ϖ₂ hu_ψϖ₂
      exact hϖ₂.not_isUnit hu_ϖ₂
    have he_uniq : ∀ n : ℕ, Ideal.map ψ_x m₂ = m₁ ^ n → e = n := by
      intro n hn
      exact hStrict₁.injective (he_map.symm.trans hn)
    have he_open : AlgebraicGeometry.IsOpenImmersion h → e = 1 := by
      intro hOpen
      have hBij_ψ : Function.Bijective ψ_x := (hOpenBij hOpen).2 x₁.1
      have hmap_eq_m₁ : Ideal.map ψ_x m₂ = m₁ := by
        apply le_antisymm
        · rw [Ideal.map_le_iff_le_comap]
          intro r hr
          rw [Ideal.mem_comap]
          by_contra hnot
          have hu_ψ : IsUnit (ψ_x r) := IsLocalRing.notMem_maximalIdeal.mp hnot
          have hu_r : IsUnit r := IsLocalHom.map_nonunit r hu_ψ
          exact (IsLocalRing.notMem_maximalIdeal.mpr hu_r) hr
        · intro y hy
          obtain ⟨r, rfl⟩ := hBij_ψ.2 y
          have hr_m₂ : r ∈ m₂ := by
            by_contra hnot
            have hu_r : IsUnit r := IsLocalRing.notMem_maximalIdeal.mp hnot
            exact (IsLocalRing.notMem_maximalIdeal.mpr (hu_r.map ψ_x)) hy
          exact Ideal.mem_map_of_mem ψ_x hr_m₂
      exact he_uniq 1 (hmap_eq_m₁.trans (pow_one m₁).symm)
    refine ⟨e, he_pos, he_map, he_open, he_uniq, ?_⟩
    intro f₂ a₂ b₂ na₂ nb₂ ha₂_ne hb₂_ne hab₂_eq ha₂_sp hb₂_sp
    refine ⟨ψ_x a₂, ψ_x b₂, (map_ne_zero_iff ψ_x hInj_ψ).mpr ha₂_ne,
      (map_ne_zero_iff ψ_x hInj_ψ).mpr hb₂_ne, ?_, ?_, ?_⟩
    · calc
        algebraMap R₁ K₁ (ψ_x a₂)
          = φ_h (algebraMap R₂ K₂ a₂) := hStalkComm x₁.1 a₂
        _ = φ_h ((f₂ : K₂) * algebraMap R₂ K₂ b₂) := by rw [hab₂_eq]
        _ = φ_h (f₂ : K₂) * φ_h (algebraMap R₂ K₂ b₂) := map_mul φ_h _ _
        _ = ((Units.map φ_h.toMonoidHom f₂ : Units K₁) : K₁) * algebraMap R₁ K₁ (ψ_x b₂) := by
          rw [← hStalkComm x₁.1 b₂]
          rfl
    · calc
        Ideal.span ({ψ_x a₂} : Set R₁)
          = Ideal.map ψ_x (Ideal.span ({a₂} : Set R₂)) := by
            rw [Ideal.map_span, Set.image_singleton]
        _ = Ideal.map ψ_x (m₂ ^ na₂) := by rw [ha₂_sp]
        _ = (Ideal.map ψ_x m₂) ^ na₂ := Ideal.map_pow ψ_x m₂ na₂
        _ = (m₁ ^ e) ^ na₂ := by rw [he_map]
        _ = m₁ ^ (e * na₂) := (pow_mul m₁ e na₂).symm
    · calc
        Ideal.span ({ψ_x b₂} : Set R₁)
          = Ideal.map ψ_x (Ideal.span ({b₂} : Set R₂)) := by
            rw [Ideal.map_span, Set.image_singleton]
        _ = Ideal.map ψ_x (m₂ ^ nb₂) := by rw [hb₂_sp]
        _ = (Ideal.map ψ_x m₂) ^ nb₂ := Ideal.map_pow ψ_x m₂ nb₂
        _ = (m₁ ^ e) ^ nb₂ := by rw [he_map]
        _ = m₁ ^ (e * nb₂) := (pow_mul m₁ e nb₂).symm

theorem weil_punctured_curve_mod_prime_h1_finite_and_residue_dichotomy (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC : AlgebraicGeometry.IsIntegral C₀.left)
    (hProjC : IsProjectiveOverField k C₀)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom]
    (m : ℕ) (hm : 1 ≤ m)
    (P_pts : Fin m → { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) })
    (hP_disj : _root_.Pairwise fun a b : Fin m => P_pts a ≠ P_pts b)
    (U₀ : C₀.left.Opens)
    (hAffU : AlgebraicGeometry.IsAffineOpen U₀)
    (hU_compl : (U₀ : Set ↥C₀.left) = (⋃ a : Fin m, {(P_pts a).1})ᶜ) :
    Finite (weilEtaleTorsionH U₀.toScheme ℓ 1) ∧
    ∀ γ : weilEtaleTorsionH U₀.toScheme ℓ 1,
      (∃ (γ_bar : weilEtaleTorsionH C₀.left ℓ 1)
          (p_open : weilEtaleTorsionH C₀.left ℓ 1 →+ weilEtaleTorsionH U₀.toScheme ℓ 1),
        WeilIsTorsionEtalePullback U₀.ι ℓ 1 p_open ∧
        p_open γ_bar = γ) ∨
      (∃ (c : Fin m → ℕ),
        (∀ a : Fin m, c a < ℓ) ∧
        (∃ a₀ : Fin m, 1 ≤ c a₀) ∧
        (∃ d₀ : weilCurveClGroup C₀.left,
          ℓ • d₀ = QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C₀.left)
            (Finset.univ.sum fun a : Fin m => Finsupp.single (P_pts a) (c a : ℤ))) ∧
        ∀ (C'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
          AlgebraicGeometry.IsIntegral C'₀.left →
          IsProjectiveOverField k C'₀ →
          ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C'₀.hom]
            (ν₀ : Quiver.Hom C'₀.left C₀.left)
            (U'₀ : C'₀.left.Opens)
            (ν_U : Quiver.Hom U'₀.toScheme U₀.toScheme),
            CategoryTheory.CategoryStruct.comp ν₀ C₀.hom = C'₀.hom →
            AlgebraicGeometry.IsFinite ν₀ →
            AlgebraicGeometry.Surjective ν₀ →
            U'₀ = (TopologicalSpace.Opens.map ν₀.base).obj U₀ →
            AlgebraicGeometry.IsAffineOpen U'₀ →
            CategoryTheory.CategoryStruct.comp ν_U U₀.ι =
              CategoryTheory.CategoryStruct.comp U'₀.ι ν₀ →
            (∀ (a : Fin m), 1 ≤ c a →
              ∀ (x' : ↥C'₀.left),
                IsClosed ({x'} : Set ↥C'₀.left) →
                ν₀.base x' = (P_pts a).1 →
                Ideal.map (AlgebraicGeometry.Scheme.Hom.stalkMap ν₀ x').hom
                  (IsLocalRing.maximalIdeal ↑(C₀.left.presheaf.stalk (ν₀.base x'))) =
                  (IsLocalRing.maximalIdeal ↑(C'₀.left.presheaf.stalk x')) ^ ℓ) →
            ∀ (p_ν : weilEtaleTorsionH U₀.toScheme ℓ 1 →+ weilEtaleTorsionH U'₀.toScheme ℓ 1),
              WeilIsTorsionEtalePullback ν_U ℓ 1 p_ν →
              ∃ (γ'_bar : weilEtaleTorsionH C'₀.left ℓ 1)
                (p'_open : weilEtaleTorsionH C'₀.left ℓ 1 →+ weilEtaleTorsionH U'₀.toScheme ℓ 1),
                WeilIsTorsionEtalePullback U'₀.ι ℓ 1 p'_open ∧
                p'_open γ'_bar = p_ν γ) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : (0 : ℤ) < (ℓ : ℤ) := Int.natCast_pos.mpr hPrime.pos
  have hℓ_ne0 : (ℓ : ℤ) ≠ 0 := ne_of_gt hℓ_pos
  haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  haveI : NeZero (ℓ : k) := ⟨hℓ⟩
  haveI : AlgebraicGeometry.IsIntegral C₀.left := hIntC
  have h_int_dvd : ∀ z d : ℤ, d ∣ z + (-z) % d := fun z d =>
    ⟨-((-z) / d), by rw [Int.emod_def]; ring⟩
  have h_neg_add_cancel : ∀ {G : Type u} [AddCommGroup G] (a b : G), -(a + b) + b = -a :=
    fun a b => by abel

  
  have hdeg_cyc : (Polynomial.cyclotomic ℓ k).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic]
    have htot : Nat.totient ℓ = ℓ - 1 := Nat.totient_prime hPrime
    have h2 : 2 ≤ ℓ := hPrime.two_le
    have hpos : 0 < Nat.totient ℓ := by omega
    exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hpos)
  obtain ⟨z₁, hz₁_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ k) hdeg_cyc
  have hz₁_prim : IsPrimitiveRoot z₁ ℓ :=
    (Polynomial.isRoot_cyclotomic_iff (R := k) (n := ℓ)).mp hz₁_root
  have hz₁_pow : z₁ ^ ℓ = 1 := hz₁_prim.pow_eq_one
  have hz₁_ne : z₁ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hPrime.ne_zero] at hz₁_pow
    exact zero_ne_one hz₁_pow
  let ζ : Units k := Units.mk0 z₁ hz₁_ne
  have hζ : IsPrimitiveRoot ((ζ : Units k) : k) ℓ := by
    simpa [ζ] using hz₁_prim

  have hOpenSmooth :
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
        (U : C.left.Opens),
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (U.ι ≫ C.hom) := by
    intro C _ U
    have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (U.ι ≫ C.hom) := inferInstance
    rwa [Nat.zero_add] at h01

  
  have hStalkGenComp :
      ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
        [AlgebraicGeometry.IsIntegral X₁]
        [AlgebraicGeometry.IsIntegral X₂]
        [AlgebraicGeometry.IsIntegral X₃]
        (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (h : X₁ ⟶ X₃) (hfg : f ≫ g = h),
        letI : IrreducibleSpace ↥X₁ := AlgebraicGeometry.irreducibleSpace_of_isIntegral X₁
        letI : IrreducibleSpace ↥X₂ := AlgebraicGeometry.irreducibleSpace_of_isIntegral X₂
        letI : IrreducibleSpace ↥X₃ := AlgebraicGeometry.irreducibleSpace_of_isIntegral X₃
        ∀ (hf : f.base (genericPoint ↥X₁) = genericPoint ↥X₂)
          (hg : g.base (genericPoint ↥X₂) = genericPoint ↥X₃)
          (hh : h.base (genericPoint ↥X₁) = genericPoint ↥X₃),
          ((X₃.presheaf.stalkCongr (Inseparable.of_eq hh.symm)).hom ≫
              h.stalkMap (genericPoint ↥X₁)) =
            ((X₃.presheaf.stalkCongr (Inseparable.of_eq hg.symm)).hom ≫
                g.stalkMap (genericPoint ↥X₂)) ≫
              ((X₂.presheaf.stalkCongr (Inseparable.of_eq hf.symm)).hom ≫
                f.stalkMap (genericPoint ↥X₁)) := by
    intro X₁ X₂ X₃ _ _ _ f g h hfg hf hg hh
    letI : IrreducibleSpace ↥X₁ := AlgebraicGeometry.irreducibleSpace_of_isIntegral X₁
    letI : IrreducibleSpace ↥X₂ := AlgebraicGeometry.irreducibleSpace_of_isIntegral X₂
    letI : IrreducibleSpace ↥X₃ := AlgebraicGeometry.irreducibleSpace_of_isIntegral X₃
    have h_congr :
        ∀ {a b c : ↥X₃} (h_ab : Inseparable a b) (h_bc : Inseparable b c),
          (X₃.presheaf.stalkCongr h_ab).hom ≫ (X₃.presheaf.stalkCongr h_bc).hom =
            (X₃.presheaf.stalkCongr (h_ab.trans h_bc)).hom := by
      intro a b c h_ab h_bc
      rw [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkCongr_hom,
        TopCat.Presheaf.stalkCongr_hom]
      exact TopCat.Presheaf.stalkSpecializes_comp X₃.presheaf
        h_bc.symm.specializes h_ab.symm.specializes
    have hL :
        (X₃.presheaf.stalkCongr (Inseparable.of_eq hh.symm)).hom ≫ h.stalkMap (genericPoint ↥X₁) =
        (X₃.presheaf.stalkCongr (Inseparable.of_eq
          ((congrArg g.base hf).trans hg).symm)).hom ≫
          (g.stalkMap (f.base (genericPoint ↥X₁)) ≫ f.stalkMap (genericPoint ↥X₁)) :=
      (congrArg ((X₃.presheaf.stalkCongr (Inseparable.of_eq hh.symm)).hom ≫ ·)
        ((AlgebraicGeometry.Scheme.Hom.stalkMap_congr_hom h (f ≫ g) hfg.symm
            (genericPoint ↥X₁)).trans
          (congrArg (_ ≫ ·)
            (AlgebraicGeometry.Scheme.Hom.stalkMap_comp f g (genericPoint ↥X₁))))).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) (h_congr _ _)))
    have hR :
        ((X₃.presheaf.stalkCongr (Inseparable.of_eq hg.symm)).hom ≫ g.stalkMap (genericPoint ↥X₂)) ≫
          ((X₂.presheaf.stalkCongr (Inseparable.of_eq hf.symm)).hom ≫
            f.stalkMap (genericPoint ↥X₁)) =
        (X₃.presheaf.stalkCongr (Inseparable.of_eq
          ((congrArg g.base hf).trans hg).symm)).hom ≫
          (g.stalkMap (f.base (genericPoint ↥X₁)) ≫ f.stalkMap (genericPoint ↥X₁)) := by
      have hmid := AlgebraicGeometry.Scheme.Hom.stalkMap_congr_point g (genericPoint ↥X₂)
        (f.base (genericPoint ↥X₁)) hf.symm
      exact (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (_ ≫ ·)
          ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) hmid))).trans
          ((congrArg (_ ≫ ·) (CategoryTheory.Category.assoc _ _ _)).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) (h_congr _ _)))))
    exact hL.trans hR.symm

  
  obtain ⟨hPullEx, _, _, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z) :=
    weil_etale_gm_isSheaf_and_proj_H0_divisible.{u}.1
  obtain ⟨delta_sys, hDelta_single, hDelta_nat⟩ :=
    weil_abelian_kummer_divisor_pullback_h1_bridge.{u} ℓ
  obtain ⟨hPin_ex, hPin_sq⟩ :=
    weil_etale_pinned_kummer_and_generic_gm_pullback_squares.{u} k ℓ hℓ ζ hζ hGm
  obtain ⟨⟨hProjCompSep, hOpenGenNe⟩, hDomRam⟩ :=
    weil_smooth_curve_dominant_stalk_ramification_and_open_pts.{u} k

  
  let pinKum (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] :=
    Classical.choose (hPin_ex C)
  let pinH0Kum (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] :=
    Classical.choose (Classical.choose_spec (hPin_ex C))
  let pinGm (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] :=
    Classical.choose (Classical.choose_spec (Classical.choose_spec (hPin_ex C)))
  let pinKHom (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] :=
    Classical.choose
      (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hPin_ex C))))
  have hPinSpec (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] :=
    Classical.choose_spec
      (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hPin_ex C))))

  have hDivPkg (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left]
      [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :=
    weil_smooth_qc_sep_curve_canonical_divisor_short_exact k hGm C
      (pinGm C) (pinKHom C) (hPinSpec C).2.2.1 (hPinSpec C).2.2.2.2

  let curveDivSh (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :=
    Classical.choose (hDivPkg C).2
  let curveDivMor (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :=
    Classical.choose (Classical.choose_spec (hDivPkg C).2)
  let curveDivH0 (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :=
    Classical.choose (Classical.choose_spec (Classical.choose_spec (hDivPkg C).2))
  let curveDivEquiv (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :=
    Classical.choose
      (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hDivPkg C).2)))
  have hCurveDivSpec (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :=
    Classical.choose_spec
      (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hDivPkg C).2)))

  let divFn (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :
      Additive (Units ↑C.left.functionField) →+
        ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ) :=
    (curveDivEquiv C).toAddMonoidHom.comp
      (((CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C)).postcomp
        ((CategoryTheory.constantSheaf C.left.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)))
        (Nat.add_zero 0)).comp (pinKHom C))

  let eratSub (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :
      AddSubgroup (Additive (Units ↑C.left.functionField)) :=
    { carrier := { x | ∀ pt : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
        (ℓ : ℤ) ∣ divFn C x pt }
      add_mem' := fun {a b} ha hb pt => by
        rw [map_add, Finsupp.add_apply]
        exact dvd_add (ha pt) (hb pt)
      zero_mem' := fun pt => by
        rw [map_zero, Finsupp.zero_apply]
        exact dvd_zero _
      neg_mem' := fun {a} ha pt => by
        rw [map_neg, Finsupp.neg_apply]
        exact (ha pt).neg_right }

  have hEratBridge :
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
        {x : Additive (Units ↑C.left.functionField)},
        x ∈ eratSub C →
        ∃ δ : (curveDivSh C).H 0,
          (pinKHom C x).comp (CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C))
            (Nat.add_zero 0) = ℓ • δ := by
    intro C _ _ _ _ x hx
    let D_quot := (divFn C x).mapRange (fun w => w / (ℓ : ℤ)) (Int.zero_ediv (ℓ : ℤ))
    have hD_mul : ℓ • D_quot = divFn C x := by
      ext pt
      dsimp only [D_quot]
      rw [Finsupp.smul_apply, Finsupp.mapRange_apply, nsmul_eq_mul]
      exact Int.mul_ediv_cancel' (hx pt)
    refine ⟨(curveDivEquiv C).symm D_quot, (curveDivEquiv C).injective ?_⟩
    rw [map_nsmul, AddEquiv.apply_symm_apply, hD_mul]
    rfl

  let kumMap (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom] :
      ↥(eratSub C) →+ weilEtaleTorsionH C.left ℓ 1 :=
    haveI : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (curveDivSh C)) :=
      (hCurveDivSpec C).2.1 ℓ hPrime.pos
    haveI : Subsingleton ((weilEtaleKSheaf C.left).H 1) := (hDivPkg C).1
    AddMonoidHom.mk'
      (fun x => delta_sys C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
        (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
        (hCurveDivSpec C).1 (pinKHom C x.1) (hEratBridge C x.2))
      (fun x y => by
        have hadd_κ : pinKHom C (x.1 + y.1) = pinKHom C x.1 + pinKHom C y.1 := map_add _ _ _
        have hcongr :
            ∀ {κ₁ κ₂ : (weilEtaleKSheaf C.left).H 0} (heq : κ₁ = κ₂)
              (h₁ : ∃ δ : (curveDivSh C).H 0,
                κ₁.comp (CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C)) (Nat.add_zero 0) = ℓ • δ)
              (h₂ : ∃ δ : (curveDivSh C).H 0,
                κ₂.comp (CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C)) (Nat.add_zero 0) = ℓ • δ),
              delta_sys C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
                (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
                (hCurveDivSpec C).1 κ₁ h₁ =
              delta_sys C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
                (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
                (hCurveDivSpec C).1 κ₂ h₂ := by
          rintro _ _ rfl _ _; rfl
        have hsum_ex :
            ∃ δ : (curveDivSh C).H 0,
              (pinKHom C x.1 + pinKHom C y.1).comp
                (CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C)) (Nat.add_zero 0) = ℓ • δ := by
          rw [← hadd_κ]
          exact hEratBridge C (x + y).2
        exact (hcongr hadd_κ (hEratBridge C (x + y).2) hsum_ex).trans
          ((hDelta_single C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
            (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
            (hCurveDivSpec C).1).1
            (pinKHom C x.1) (pinKHom C y.1)
            (hEratBridge C x.2) (hEratBridge C y.2) hsum_ex))

  have hKumSurj :
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
        Function.Surjective (kumMap C) := by
    intro C _ _ _ _ γ
    haveI : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (curveDivSh C)) :=
      (hCurveDivSpec C).2.1 ℓ hPrime.pos
    haveI : Subsingleton ((weilEtaleKSheaf C.left).H 1) := (hDivPkg C).1
    obtain ⟨κ, hκ, hγ⟩ :=
      (hDelta_single C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
        (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
        (hCurveDivSpec C).1).2.1 γ
    let eK := AddEquiv.ofBijective (pinKHom C) (hPinSpec C).2.2.2.1
    let x₁ := eK.symm κ
    have hx₁_eq : pinKHom C x₁ = κ := eK.apply_symm_apply κ
    have hx₁_mem : x₁ ∈ eratSub C := by
      intro pt
      obtain ⟨δ, hδ⟩ := hκ
      have hd : divFn C x₁ = ℓ • curveDivEquiv C δ := by
        change curveDivEquiv C
          ((pinKHom C x₁).comp (CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C))
            (Nat.add_zero 0)) = _
        rw [hx₁_eq, hδ, map_nsmul]
      rw [hd, Finsupp.smul_apply, nsmul_eq_mul]
      exact dvd_mul_right (ℓ : ℤ) _
    have hcongr :
        ∀ {κ₁ κ₂ : (weilEtaleKSheaf C.left).H 0} (heq : κ₁ = κ₂)
          (h₁ : ∃ δ : (curveDivSh C).H 0,
            κ₁.comp (CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C)) (Nat.add_zero 0) = ℓ • δ)
          (h₂ : ∃ δ : (curveDivSh C).H 0,
            κ₂.comp (CategoryTheory.Abelian.Ext.mk₀ (curveDivMor C)) (Nat.add_zero 0) = ℓ • δ),
          delta_sys C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
            (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
            (hCurveDivSpec C).1 κ₁ h₁ =
          delta_sys C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
            (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
            (hCurveDivSpec C).1 κ₂ h₂ := by
      rintro _ _ rfl _ _; rfl
    exact ⟨⟨x₁, hx₁_mem⟩, (hcongr hx₁_eq (hEratBridge C hx₁_mem) hκ).trans hγ⟩

  have hKumKer :
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
        (x : ↥(eratSub C)),
        kumMap C x = 0 ↔ ∃ g : Additive (Units ↑C.left.functionField), ℓ • g = x.1 := by
    intro C _ _ _ _ x
    haveI : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (curveDivSh C)) :=
      (hCurveDivSpec C).2.1 ℓ hPrime.pos
    haveI : Subsingleton ((weilEtaleKSheaf C.left).H 1) := (hDivPkg C).1
    change delta_sys C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
      (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
      (hCurveDivSpec C).1 (pinKHom C x.1) (hEratBridge C x.2) = 0 ↔
      ∃ g : Additive (Units ↑C.left.functionField), ℓ • g = x.1
    rw [(hDelta_single C.left (weilEtaleGmSheaf C.left) (weilEtaleKSheaf C.left) (curveDivSh C)
      (pinKum C) (pinH0Kum C) (hPinSpec C).1 (pinGm C) (curveDivMor C) (curveDivH0 C)
      (hCurveDivSpec C).1).2.2 (pinKHom C x.1) (hEratBridge C x.2)]
    let eK := AddEquiv.ofBijective (pinKHom C) (hPinSpec C).2.2.2.1
    constructor
    · rintro ⟨g_K, hg_K⟩
      exact ⟨eK.symm g_K, eK.injective
        ((map_nsmul eK ℓ (eK.symm g_K)).trans
          ((congrArg (ℓ • ·) (eK.apply_symm_apply g_K)).trans hg_K))⟩
    · rintro ⟨g, hg⟩
      exact ⟨pinKHom C g, by rw [← map_nsmul, hg]⟩

  have hKumNat :
      ∀ (C₁ C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C₁.left] [CompactSpace ↥C₁.left] [C₁.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₁.hom]
        [AlgebraicGeometry.IsIntegral C₂.left] [CompactSpace ↥C₂.left] [C₂.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₂.hom]
        (h : C₁.left ⟶ C₂.left) (hh_over : h ≫ C₂.hom = C₁.hom),
        letI : IrreducibleSpace ↥C₁.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₁.left
        letI : IrreducibleSpace ↥C₂.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₂.left
        ∀ (h_gen : h.base (genericPoint ↥C₁.left) = genericPoint ↥C₂.left)
          (p_h : weilEtaleTorsionH C₂.left ℓ 1 →+ weilEtaleTorsionH C₁.left ℓ 1),
          WeilIsTorsionEtalePullback h ℓ 1 p_h →
          let φ_h : ↑C₂.left.functionField →+* ↑C₁.left.functionField :=
            ((C₂.left.presheaf.stalkCongr (Inseparable.of_eq h_gen.symm)).hom ≫
              h.stalkMap (genericPoint ↥C₁.left)).hom
          ∀ (f₂ : Units ↑C₂.left.functionField)
            (hf₂ : Additive.ofMul f₂ ∈ eratSub C₂)
            (hf₁ : Additive.ofMul (Units.map φ_h.toMonoidHom f₂) ∈ eratSub C₁),
            p_h (kumMap C₂ ⟨Additive.ofMul f₂, hf₂⟩) =
              kumMap C₁ ⟨Additive.ofMul (Units.map φ_h.toMonoidHom f₂), hf₁⟩ := by
    intro C₁ C₂ _ _ _ _ _ _ _ _ h hh_over h_gen p_h hp_h φ_h f₂ hf₂ hf₁
    haveI : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (curveDivSh C₁)) :=
      (hCurveDivSpec C₁).2.1 ℓ hPrime.pos
    haveI : Subsingleton ((weilEtaleKSheaf C₁.left).H 1) := (hDivPkg C₁).1
    haveI : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (curveDivSh C₂)) :=
      (hCurveDivSpec C₂).2.1 ℓ hPrime.pos
    haveI : Subsingleton ((weilEtaleKSheaf C₂.left).H 1) := (hDivPkg C₂).1
    apply hDelta_nat C₁.left C₂.left
      (weilEtaleGmSheaf C₁.left) (weilEtaleKSheaf C₁.left) (curveDivSh C₁)
      (pinKum C₁) (pinH0Kum C₁) (hPinSpec C₁).1 (pinGm C₁) (curveDivMor C₁) (curveDivH0 C₁)
      (hCurveDivSpec C₁).1
      (weilEtaleGmSheaf C₂.left) (weilEtaleKSheaf C₂.left) (curveDivSh C₂)
      (pinKum C₂) (pinH0Kum C₂) (hPinSpec C₂).1 (pinGm C₂) (curveDivMor C₂) (curveDivH0 C₂)
      (hCurveDivSpec C₂).1
      h p_h hp_h
      (pinKHom C₂ (Additive.ofMul f₂)) (hEratBridge C₂ hf₂)
      (pinKHom C₁ (Additive.ofMul (Units.map φ_h.toMonoidHom f₂))) (hEratBridge C₁ hf₁)
    dsimp only
    intro hCont hAdj hAdd hLim hColim T₁ hT₁ T₂ hT₂ ιℤ hιπ hπι
    obtain ⟨β_G, β_K, hβ_kum, hβ_gm, hβ_k⟩ :=
      hPin_sq C₁ C₂ (pinKum C₁) (pinGm C₁) (pinKHom C₁) (pinKum C₂) (pinGm C₂) (pinKHom C₂) h
        (hPinSpec C₁).2.1 (hPinSpec C₁).2.2.1 (hPinSpec C₁).2.2.2.2
        (hPinSpec C₂).2.1 (hPinSpec C₂).2.2.1 (hPinSpec C₂).2.2.2.2
        hh_over h_gen hCont hAdj hAdd hLim hColim T₁ hT₁ T₂ hT₂ ιℤ hιπ hπι
    exact ⟨β_G, β_K, hβ_kum, hβ_gm, (hβ_k f₂).symm⟩

  have hDivScale :
      ∀ (C₁ C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C₁.left] [CompactSpace ↥C₁.left] [C₁.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₁.hom]
        [AlgebraicGeometry.IsIntegral C₂.left] [CompactSpace ↥C₂.left] [C₂.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₂.hom]
        (h : C₁.left ⟶ C₂.left) (hh_over : h ≫ C₂.hom = C₁.hom)
        (hh_dom : AlgebraicGeometry.IsOpenImmersion h ∨ AlgebraicGeometry.Surjective h),
        letI : IrreducibleSpace ↥C₁.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₁.left
        letI : IrreducibleSpace ↥C₂.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₂.left
        ∃ h_gen : h.base (genericPoint ↥C₁.left) = genericPoint ↥C₂.left,
          let φ_h : ↑C₂.left.functionField →+* ↑C₁.left.functionField :=
            ((C₂.left.presheaf.stalkCongr (Inseparable.of_eq h_gen.symm)).hom ≫
              h.stalkMap (genericPoint ↥C₁.left)).hom
          (AlgebraicGeometry.IsOpenImmersion h → Function.Bijective φ_h) ∧
          ∀ x₁ : { x : ↥C₁.left // IsClosed ({x} : Set ↥C₁.left) },
            ∃ (hx₂ : IsClosed ({h.base x₁.1} : Set ↥C₂.left)) (e : ℕ),
              1 ≤ e ∧
              (AlgebraicGeometry.IsOpenImmersion h → e = 1) ∧
              (∀ n : ℕ,
                Ideal.map (h.stalkMap x₁.1).hom
                  (IsLocalRing.maximalIdeal ↑(C₂.left.presheaf.stalk (h.base x₁.1))) =
                  (IsLocalRing.maximalIdeal ↑(C₁.left.presheaf.stalk x₁.1)) ^ n →
                e = n) ∧
              ∀ f₂ : Units ↑C₂.left.functionField,
                divFn C₁ (Additive.ofMul (Units.map φ_h.toMonoidHom f₂)) x₁ =
                  (e : ℤ) * divFn C₂ (Additive.ofMul f₂) ⟨h.base x₁.1, hx₂⟩ := by
    intro C₁ C₂ _ _ _ _ _ _ _ _ h hh_over hh_dom
    obtain ⟨h_gen, hOpenBij, hPtRam⟩ := hDomRam C₁ C₂ h hh_over hh_dom
    refine ⟨h_gen, hOpenBij, fun x₁ => ?_⟩
    obtain ⟨hx₂, e, he_pos, _, he_open, he_uniq, he_scale⟩ := hPtRam x₁
    refine ⟨hx₂, e, he_pos, he_open, he_uniq, fun f₂ => ?_⟩
    let x₂ : { x : ↥C₂.left // IsClosed ({x} : Set ↥C₂.left) } := ⟨h.base x₁.1, hx₂⟩
    obtain ⟨a₂, b₂, na₂, nb₂, ha₂_ne, hb₂_ne, hab₂_eq, ha₂_sp, hb₂_sp, hd₂_eq⟩ :=
      ((hCurveDivSpec C₂).2.2 f₂).2 x₂ |>.1
    obtain ⟨a₁, b₁, ha₁_ne, hb₁_ne, hab₁_eq, ha₁_sp, hb₁_sp⟩ :=
      he_scale f₂ a₂ b₂ na₂ nb₂ ha₂_ne hb₂_ne hab₂_eq ha₂_sp hb₂_sp
    let φ_h : ↑C₂.left.functionField →+* ↑C₁.left.functionField :=
      ((C₂.left.presheaf.stalkCongr (Inseparable.of_eq h_gen.symm)).hom ≫
        h.stalkMap (genericPoint ↥C₁.left)).hom
    have hd₁_eq :=
      ((hCurveDivSpec C₁).2.2 (Units.map φ_h.toMonoidHom f₂)).2 x₁ |>.2
        a₁ b₁ (e * na₂) (e * nb₂) ha₁_ne hb₁_ne hab₁_eq ha₁_sp hb₁_sp
    change divFn C₁ (Additive.ofMul (Units.map φ_h.toMonoidHom f₂)) x₁ =
      (e : ℤ) * divFn C₂ (Additive.ofMul f₂) x₂
    change divFn C₂ (Additive.ofMul f₂) x₂ = (na₂ : ℤ) - (nb₂ : ℤ) at hd₂_eq
    change divFn C₁ (Additive.ofMul (Units.map φ_h.toMonoidHom f₂)) x₁ =
      ((e * na₂ : ℕ) : ℤ) - ((e * nb₂ : ℕ) : ℤ) at hd₁_eq
    rw [hd₁_eq, hd₂_eq]
    push_cast
    ring

  have hDivPrinc :
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C.left] [CompactSpace ↥C.left] [C.left.IsSeparated]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
        (f : Units ↑C.left.functionField),
        divFn C (Additive.ofMul f) ∈ weilCurvePrincipalSubgroup C.left :=
    fun C _ _ _ _ f => ((hCurveDivSpec C).2.2 f).1

  
  clear_value kumMap
  clear hEratBridge
  clear_value divFn
  clear hCurveDivSpec curveDivEquiv curveDivH0 curveDivMor curveDivSh hDivPkg
    hPinSpec pinKHom pinGm pinH0Kum pinKum hDomRam hPin_sq hPin_ex
    hDelta_nat hDelta_single delta_sys hGm
    hζ ζ hz₁_ne hz₁_pow hz₁_prim hz₁_root z₁ hdeg_cyc

  
  obtain ⟨hCompC₀, hSepC₀⟩ := hProjCompSep C₀ hProjC
  haveI : CompactSpace ↥C₀.left := hCompC₀
  haveI : C₀.left.IsSeparated := hSepC₀
  obtain ⟨_, hNeU₀⟩ := hOpenGenNe C₀ hProjC m P_pts U₀ hU_compl
  haveI : Nonempty ↥U₀.toScheme := hNeU₀
  haveI : AlgebraicGeometry.IsAffine U₀.toScheme := hAffU
  haveI : AlgebraicGeometry.IsIntegral U₀.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U₀.ι
  let C_U₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (U₀.ι ≫ C₀.hom)
  haveI : AlgebraicGeometry.IsIntegral C_U₀.left :=
    (inferInstance : AlgebraicGeometry.IsIntegral U₀.toScheme)
  haveI : CompactSpace ↥C_U₀.left :=
    (inferInstance : CompactSpace ↥U₀.toScheme)
  haveI : C_U₀.left.IsSeparated :=
    (inferInstance : U₀.toScheme.IsSeparated)
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_U₀.hom := hOpenSmooth C₀ U₀

  
  have hOpen_U₀ι : AlgebraicGeometry.IsOpenImmersion (U₀.ι : C_U₀.left ⟶ C₀.left) :=
    (inferInstance : AlgebraicGeometry.IsOpenImmersion U₀.ι)
  obtain ⟨hGen_U₀ι, hBij_U₀ι, hScale_U₀ι⟩ :=
    hDivScale C_U₀ C₀ U₀.ι rfl (Or.inl hOpen_U₀ι)
  letI : IrreducibleSpace ↥C₀.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₀.left
  letI : IrreducibleSpace ↥C_U₀.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C_U₀.left
  let φ_open : ↑C₀.left.functionField →+* ↑C_U₀.left.functionField :=
    ((C₀.left.presheaf.stalkCongr (Inseparable.of_eq hGen_U₀ι.symm)).hom ≫
      (U₀.ι : C_U₀.left ⟶ C₀.left).stalkMap (genericPoint ↥C_U₀.left)).hom
  let e_ff : ↑C₀.left.functionField ≃+* ↑C_U₀.left.functionField :=
    RingEquiv.ofBijective φ_open (hBij_U₀ι hOpen_U₀ι)
  let e_ff_add : Additive (Units ↑C_U₀.left.functionField) ≃+
      Additive (Units ↑C₀.left.functionField) :=
    MulEquiv.toAdditive (Units.mapEquiv e_ff.symm.toMulEquiv)

  have hMapOpenSymm :
      ∀ u : Units ↑C_U₀.left.functionField,
        Units.map φ_open.toMonoidHom (Units.map e_ff.symm.toRingHom.toMonoidHom u) = u := by
    intro u
    ext
    exact e_ff.apply_symm_apply u.val

  have hDivOpenEq :
      ∀ (f₀ : Units ↑C₀.left.functionField)
        (pt : { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) })
        (hpt : pt.1 ∈ U₀),
        let pt_U : { x : ↥C_U₀.left // IsClosed ({x} : Set ↥C_U₀.left) } :=
          ⟨⟨pt.1, hpt⟩, by
            have hpre : ({(⟨pt.1, hpt⟩ : ↥U₀.toScheme)} : Set ↥U₀.toScheme) =
                U₀.ι.base ⁻¹' ({pt.1} : Set ↥C₀.left) := by
              ext z
              simp only [Set.mem_singleton_iff, Set.mem_preimage]
              exact ⟨fun hz => by rw [hz]; rfl,
                fun hz => U₀.ι.isOpenEmbedding.injective hz⟩
            change IsClosed ({(⟨pt.1, hpt⟩ : ↥U₀.toScheme)} : Set ↥U₀.toScheme)
            rw [hpre]
            exact pt.2.preimage U₀.ι.continuous⟩
        divFn C_U₀ (Additive.ofMul (Units.map φ_open.toMonoidHom f₀)) pt_U =
          divFn C₀ (Additive.ofMul f₀) pt := by
    intro f₀ pt hpt pt_U
    obtain ⟨hx₂, e, _, he_open, _, hsc⟩ := hScale_U₀ι pt_U
    have he1 : e = 1 := he_open hOpen_U₀ι
    have hpt_eq : (⟨U₀.ι.base pt_U.1, hx₂⟩ : { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) }) =
        pt := Subtype.ext rfl
    rw [hsc f₀, he1, Nat.cast_one, one_mul, hpt_eq]

  
  obtain ⟨p_open, hp_open⟩ := hPullEx U₀.ι ℓ 1
  let ρ_raw : Additive (Units ↑C_U₀.left.functionField) →+ (Fin m → ZMod ℓ) :=
    AddMonoidHom.mk'
      (fun u a => ((- divFn C₀ (e_ff_add u) (P_pts a) : ℤ) : ZMod ℓ))
      (fun u₁ u₂ => by
        ext a
        simp only [Pi.add_apply, map_add, Finsupp.add_apply, neg_add, Int.cast_add])
  let ρ₀ : ↥(eratSub C_U₀) →+ (Fin m → ZMod ℓ) := ρ_raw.comp (eratSub C_U₀).subtype
  have hker_le : (kumMap C_U₀).ker ≤ ρ₀.ker := by
    intro x hx
    rw [AddMonoidHom.mem_ker] at hx ⊢
    obtain ⟨g, hg⟩ := (hKumKer C_U₀ x).mp hx
    change ρ_raw x.1 = 0
    rw [← hg, map_nsmul]
    ext a
    simp only [Pi.smul_apply, Pi.zero_apply, nsmul_eq_mul, Nat.cast_id, CharP.cast_eq_zero,
       zero_mul]
  let e_quot_U₀ :=
    QuotientAddGroup.quotientKerEquivOfSurjective (kumMap C_U₀) (hKumSurj C_U₀)
  let res_bdry : weilEtaleTorsionH U₀.toScheme ℓ 1 →+ (Fin m → ZMod ℓ) :=
    (QuotientAddGroup.lift (kumMap C_U₀).ker ρ₀ hker_le).comp e_quot_U₀.symm.toAddMonoidHom
  have hres_kum : ∀ x : ↥(eratSub C_U₀), res_bdry (kumMap C_U₀ x) = ρ_raw x.1 := by
    intro x
    change QuotientAddGroup.lift (kumMap C_U₀).ker ρ₀ hker_le
      (e_quot_U₀.symm (kumMap C_U₀ x)) = ρ_raw x.1
    have hsymm : e_quot_U₀.symm (kumMap C_U₀ x) = QuotientAddGroup.mk' (kumMap C_U₀).ker x := by
      apply e_quot_U₀.injective
      rw [e_quot_U₀.apply_symm_apply]
      rfl
    rw [hsymm]
    rfl
  clear_value res_bdry
  clear e_quot_U₀ hker_le ρ₀

  have hker_sub_range :
      ∀ γ : weilEtaleTorsionH U₀.toScheme ℓ 1,
        res_bdry γ = 0 → ∃ γ_bar : weilEtaleTorsionH C₀.left ℓ 1, p_open γ_bar = γ := by
    intro γ hγ0
    obtain ⟨x, rfl⟩ := hKumSurj C_U₀ γ
    rw [hres_kum x] at hγ0
    let f_U : Units ↑C_U₀.left.functionField := Additive.toMul x.1
    let f₀ : Units ↑C₀.left.functionField := Units.map e_ff.symm.toRingHom.toMonoidHom f_U
    have hf₀_open : Units.map φ_open.toMonoidHom f₀ = f_U := hMapOpenSymm f_U
    have hf₀_add : e_ff_add x.1 = Additive.ofMul f₀ := rfl
    have hf₀_mem : Additive.ofMul f₀ ∈ eratSub C₀ := by
      intro pt
      by_cases hpt_bdry : ∃ a : Fin m, pt = P_pts a
      · obtain ⟨a, rfl⟩ := hpt_bdry
        have ha0 : (((- divFn C₀ (Additive.ofMul f₀) (P_pts a) : ℤ) : ZMod ℓ)) = 0 := by
          have hpi : ((- divFn C₀ (e_ff_add x.1) (P_pts a) : ℤ) : ZMod ℓ) = 0 := congrFun hγ0 a
          rwa [hf₀_add] at hpi
        have hdvd_neg : (ℓ : ℤ) ∣ - divFn C₀ (Additive.ofMul f₀) (P_pts a) :=
          (ZMod.intCast_zmod_eq_zero_iff_dvd _ ℓ).mp ha0
        exact dvd_neg.mp hdvd_neg
      · have hpt_U₀ : pt.1 ∈ U₀ := by
          change pt.1 ∈ (U₀ : Set ↥C₀.left)
          rw [hU_compl, Set.mem_compl_iff, Set.mem_iUnion]
          rintro ⟨a, h_eq⟩
          rw [Set.mem_singleton_iff] at h_eq
          exact hpt_bdry ⟨a, Subtype.ext h_eq⟩
        have hval_eq := hDivOpenEq f₀ pt hpt_U₀
        rw [hf₀_open] at hval_eq
        rw [← hval_eq]
        exact x.2 _
    have hfU_mem : Additive.ofMul (Units.map φ_open.toMonoidHom f₀) ∈ eratSub C_U₀ := by
      rw [hf₀_open]
      exact x.2
    refine ⟨kumMap C₀ ⟨Additive.ofMul f₀, hf₀_mem⟩, ?_⟩
    rw [hKumNat C_U₀ C₀ U₀.ι rfl hGen_U₀ι p_open hp_open f₀ hf₀_mem hfU_mem]
    congr 1
    exact Subtype.ext (congrArg Additive.ofMul hf₀_open)

  refine ⟨?_, ?_⟩
  · 
    have hFin_C₀ : Finite (weilEtaleTorsionH C₀.left ℓ 1) := (hCurveCoh C₀ hIntC hProjC).1 1
    have hFin_range_open : (Set.range p_open).Finite := Set.finite_range p_open
    have hSub_ker : (res_bdry.ker : Set (weilEtaleTorsionH U₀.toScheme ℓ 1)) ⊆ Set.range p_open :=
      fun γ hγ => hker_sub_range γ hγ
    have hFin_ker : Finite ↥res_bdry.ker := (hFin_range_open.subset hSub_ker).to_subtype
    have hFin_img : Finite ↥res_bdry.range := inferInstance
    have hFin_quot : Finite (weilEtaleTorsionH U₀.toScheme ℓ 1 ⧸ res_bdry.ker) :=
      Finite.of_equiv ↥res_bdry.range
        (QuotientAddGroup.quotientKerEquivRange res_bdry).symm.toEquiv
    exact @Finite.of_addSubgroup_quotient _ _ res_bdry.ker hFin_ker hFin_quot

  · 
    intro γ
    obtain ⟨x, rfl⟩ := hKumSurj C_U₀ γ
    let f_U : Units ↑C_U₀.left.functionField := Additive.toMul x.1
    let f₀ : Units ↑C₀.left.functionField := Units.map e_ff.symm.toRingHom.toMonoidHom f_U
    have hf₀_open : Units.map φ_open.toMonoidHom f₀ = f_U := hMapOpenSymm f_U
    have hf₀_add : e_ff_add x.1 = Additive.ofMul f₀ := rfl
    let c : Fin m → ℕ :=
      fun a => ((- divFn C₀ (Additive.ofMul f₀) (P_pts a)) % (ℓ : ℤ)).toNat
    have hc_int : ∀ a : Fin m,
        (c a : ℤ) = (- divFn C₀ (Additive.ofMul f₀) (P_pts a)) % (ℓ : ℤ) :=
      fun a => Int.toNat_of_nonneg (Int.emod_nonneg _ hℓ_ne0)
    have hc_lt : ∀ a : Fin m, c a < ℓ := by
      intro a
      have hlt : (c a : ℤ) < (ℓ : ℤ) := by
        rw [hc_int a]
        exact Int.emod_lt_of_pos _ hℓ_pos
      exact Int.ofNat_lt.mp hlt

    by_cases hc_all_zero : ∀ a : Fin m, c a = 0
    · 
      have hres0 : res_bdry (kumMap C_U₀ x) = 0 := by
        rw [hres_kum x]
        ext a
        have hmod0 : (- divFn C₀ (Additive.ofMul f₀) (P_pts a)) % (ℓ : ℤ) = 0 := by
          rw [← hc_int a, hc_all_zero a, Nat.cast_zero]
        have hdvd : (ℓ : ℤ) ∣ - divFn C₀ (Additive.ofMul f₀) (P_pts a) :=
          Int.dvd_of_emod_eq_zero hmod0
        change (((- divFn C₀ (e_ff_add x.1) (P_pts a) : ℤ) : ZMod ℓ)) = 0
        rw [hf₀_add]
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ ℓ).mpr hdvd
      obtain ⟨γ_bar, hγ_bar⟩ := hker_sub_range (kumMap C_U₀ x) hres0
      exact Or.inl ⟨γ_bar, p_open, hp_open, hγ_bar⟩

    · 
      push_neg at hc_all_zero
      obtain ⟨a₀, ha₀_ne⟩ := hc_all_zero
      have ha₀_pos : 1 ≤ c a₀ := Nat.one_le_iff_ne_zero.mpr ha₀_ne
      refine Or.inr ⟨c, hc_lt, ⟨a₀, ha₀_pos⟩, ?_, ?_⟩
      · 
        let C_bdry : ({ x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) } →₀ ℤ) :=
          Finset.univ.sum fun a : Fin m => Finsupp.single (P_pts a) (c a : ℤ)
        have hE_div : ∀ pt : { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) },
            (ℓ : ℤ) ∣ (divFn C₀ (Additive.ofMul f₀) + C_bdry) pt := by
          intro pt
          rw [Finsupp.add_apply]
          by_cases hpt_bdry : ∃ a₁ : Fin m, pt = P_pts a₁
          · obtain ⟨a₁, rfl⟩ := hpt_bdry
            have hC_eval : C_bdry (P_pts a₁) = (c a₁ : ℤ) := by
              dsimp only [C_bdry]
              rw [Finsupp.finsetSum_apply, Finset.sum_eq_single a₁]
              · exact Finsupp.single_eq_same
              · intro a _ ha_ne
                exact Finsupp.single_eq_of_ne (hP_disj ha_ne.symm)
              · intro h_abs
                exact False.elim (h_abs (Finset.mem_univ a₁))
            rw [hC_eval, hc_int a₁]
            exact h_int_dvd (divFn C₀ (Additive.ofMul f₀) (P_pts a₁)) (ℓ : ℤ)
          · have hC_zero : C_bdry pt = 0 := by
              dsimp only [C_bdry]
              rw [Finsupp.finsetSum_apply]
              apply Finset.sum_eq_zero
              intro a _
              exact Finsupp.single_eq_of_ne (fun h_eq => hpt_bdry ⟨a, h_eq⟩)
            rw [hC_zero, add_zero]
            have hpt_U₀ : pt.1 ∈ U₀ := by
              change pt.1 ∈ (U₀ : Set ↥C₀.left)
              rw [hU_compl, Set.mem_compl_iff, Set.mem_iUnion]
              rintro ⟨a, h_eq⟩
              rw [Set.mem_singleton_iff] at h_eq
              exact hpt_bdry ⟨a, Subtype.ext h_eq⟩
            have hval_eq := hDivOpenEq f₀ pt hpt_U₀
            rw [hf₀_open] at hval_eq
            rw [← hval_eq]
            exact x.2 _
        let D₁ := (divFn C₀ (Additive.ofMul f₀) + C_bdry).mapRange
          (fun w => w / (ℓ : ℤ)) (Int.zero_ediv (ℓ : ℤ))
        have hD₁_mul : ℓ • D₁ = divFn C₀ (Additive.ofMul f₀) + C_bdry := by
          ext pt
          dsimp only [D₁]
          rw [Finsupp.smul_apply, Finsupp.mapRange_apply, nsmul_eq_mul]
          exact Int.mul_ediv_cancel' (hE_div pt)
        have hPrinc_f₀ : divFn C₀ (Additive.ofMul f₀) ∈ weilCurvePrincipalSubgroup C₀.left :=
          hDivPrinc C₀ f₀
        refine ⟨QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C₀.left) D₁, ?_⟩
        rw [← map_nsmul, QuotientAddGroup.mk'_apply, QuotientAddGroup.mk'_apply,
          QuotientAddGroup.eq]
        have hsub : -(ℓ • D₁) + C_bdry = - divFn C₀ (Additive.ofMul f₀) := by
          rw [hD₁_mul]
          exact h_neg_add_cancel (divFn C₀ (Additive.ofMul f₀)) C_bdry
        rw [hsub]
        exact (weilCurvePrincipalSubgroup C₀.left).neg_mem hPrinc_f₀

      · 
        intro C'₀ hIntC' hProjC' _ ν₀ U'₀ ν_U hν₀_hom hFin_ν₀ hSurj_ν₀ hU'₀_eq hAffU'
          hνU_comm hRam_stalk p_ν hp_ν
        haveI : AlgebraicGeometry.IsIntegral C'₀.left := hIntC'
        obtain ⟨hCompC'₀, hSepC'₀⟩ := hProjCompSep C'₀ hProjC'
        haveI : CompactSpace ↥C'₀.left := hCompC'₀
        haveI : C'₀.left.IsSeparated := hSepC'₀

        
        have hNeU'₀ : Nonempty ↥U'₀.toScheme := by
          obtain ⟨u₀⟩ := hNeU₀
          obtain ⟨y', hy'⟩ := hSurj_ν₀.1 u₀.1
          have hy'_mem : y' ∈ U'₀ := by
            rw [hU'₀_eq]
            change ν₀.base y' ∈ U₀
            rw [hy']
            exact u₀.2
          exact ⟨⟨y', hy'_mem⟩⟩
        haveI : Nonempty ↥U'₀.toScheme := hNeU'₀
        haveI : AlgebraicGeometry.IsAffine U'₀.toScheme := hAffU'
        haveI : AlgebraicGeometry.IsIntegral U'₀.toScheme :=
          AlgebraicGeometry.isIntegral_of_isOpenImmersion U'₀.ι
        let C_U'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (U'₀.ι ≫ C'₀.hom)
        haveI : AlgebraicGeometry.IsIntegral C_U'₀.left :=
          (inferInstance : AlgebraicGeometry.IsIntegral U'₀.toScheme)
        haveI : CompactSpace ↥C_U'₀.left :=
          (inferInstance : CompactSpace ↥U'₀.toScheme)
        haveI : C_U'₀.left.IsSeparated :=
          (inferInstance : U'₀.toScheme.IsSeparated)
        haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_U'₀.hom := hOpenSmooth C'₀ U'₀

        
        have hνU_over : (ν_U : C_U'₀.left ⟶ C_U₀.left) ≫ C_U₀.hom = C_U'₀.hom := by
          change ν_U ≫ (U₀.ι ≫ C₀.hom) = U'₀.ι ≫ C'₀.hom
          rw [← CategoryTheory.Category.assoc, hνU_comm, CategoryTheory.Category.assoc, hν₀_hom]
        have hSurj_νU : AlgebraicGeometry.Surjective (ν_U : C_U'₀.left ⟶ C_U₀.left) := by
          refine ⟨fun u => ?_⟩
          obtain ⟨z', hz'⟩ := hSurj_ν₀.1 u.1
          have hz'_mem : z' ∈ U'₀ := by
            rw [hU'₀_eq]
            change ν₀.base z' ∈ U₀
            rw [hz']
            exact u.2
          refine ⟨⟨z', hz'_mem⟩, U₀.ι.isOpenEmbedding.injective ?_⟩
          change (ν_U ≫ U₀.ι).base ⟨z', hz'_mem⟩ = u.1
          rw [hνU_comm]
          exact hz'

        
        have hOpen_U'₀ι : AlgebraicGeometry.IsOpenImmersion (U'₀.ι : C_U'₀.left ⟶ C'₀.left) :=
          (inferInstance : AlgebraicGeometry.IsOpenImmersion U'₀.ι)
        obtain ⟨hGen_U'₀ι, _, hScale_U'₀ι⟩ :=
          hDivScale C_U'₀ C'₀ U'₀.ι rfl (Or.inl hOpen_U'₀ι)
        obtain ⟨hGen_ν₀, _, hScale_ν₀⟩ :=
          hDivScale C'₀ C₀ ν₀ hν₀_hom (Or.inr hSurj_ν₀)
        obtain ⟨hGen_νU, _, _⟩ :=
          hDivScale C_U'₀ C_U₀ ν_U hνU_over (Or.inr hSurj_νU)

        letI : IrreducibleSpace ↥C'₀.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C'₀.left
        letI : IrreducibleSpace ↥C_U'₀.left :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral C_U'₀.left
        let φ_open' : ↑C'₀.left.functionField →+* ↑C_U'₀.left.functionField :=
          ((C'₀.left.presheaf.stalkCongr (Inseparable.of_eq hGen_U'₀ι.symm)).hom ≫
            (U'₀.ι : C_U'₀.left ⟶ C'₀.left).stalkMap (genericPoint ↥C_U'₀.left)).hom
        let φ_ν₀ : ↑C₀.left.functionField →+* ↑C'₀.left.functionField :=
          ((C₀.left.presheaf.stalkCongr (Inseparable.of_eq hGen_ν₀.symm)).hom ≫
            ν₀.stalkMap (genericPoint ↥C'₀.left)).hom
        let φ_νU : ↑C_U₀.left.functionField →+* ↑C_U'₀.left.functionField :=
          ((C_U₀.left.presheaf.stalkCongr (Inseparable.of_eq hGen_νU.symm)).hom ≫
            (ν_U : C_U'₀.left ⟶ C_U₀.left).stalkMap (genericPoint ↥C_U'₀.left)).hom

        
        let diag_mor : C_U'₀.left ⟶ C₀.left := ν_U ≫ U₀.ι
        have hGen_diag : diag_mor.base (genericPoint ↥C_U'₀.left) = genericPoint ↥C₀.left := by
          change U₀.ι.base (ν_U.base (genericPoint ↥C_U'₀.left)) = genericPoint ↥C₀.left
          rw [hGen_νU, hGen_U₀ι]
        have hComp1 := @hStalkGenComp C_U'₀.left C_U₀.left C₀.left _ _ _
          ν_U U₀.ι diag_mor rfl hGen_νU hGen_U₀ι hGen_diag
        have hComp2 := @hStalkGenComp C_U'₀.left C'₀.left C₀.left _ _ _
          U'₀.ι ν₀ diag_mor hνU_comm.symm hGen_U'₀ι hGen_ν₀ hGen_diag
        have hφ_sq : φ_νU.comp φ_open = φ_open'.comp φ_ν₀ := by
          have hcat := hComp1.symm.trans hComp2
          exact congrArg CommRingCat.Hom.hom hcat

        let f'₀ : Units ↑C'₀.left.functionField := Units.map φ_ν₀.toMonoidHom f₀
        let f'_U : Units ↑C_U'₀.left.functionField := Units.map φ_νU.toMonoidHom f_U
        have hf'_eq : Units.map φ_open'.toMonoidHom f'₀ = f'_U := by
          dsimp only [f'₀, f'_U]
          rw [← hf₀_open]
          ext
          change φ_open' (φ_ν₀ f₀.val) = φ_νU (φ_open f₀.val)
          exact RingHom.congr_fun hφ_sq.symm f₀.val

        have hf'₀_mem : Additive.ofMul f'₀ ∈ eratSub C'₀ := by
          intro x'
          obtain ⟨hx₀_cl, e, _, _, he_uniq, hsc_ν₀⟩ := hScale_ν₀ x'
          change (ℓ : ℤ) ∣ divFn C'₀ (Additive.ofMul (Units.map φ_ν₀.toMonoidHom f₀)) x'
          rw [hsc_ν₀ f₀]
          let x₀_pt : { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) } := ⟨ν₀.base x'.1, hx₀_cl⟩
          by_cases hx'_U'₀ : x'.1 ∈ U'₀
          · have hx₀_U₀ : x₀_pt.1 ∈ U₀ := by
              rw [hU'₀_eq] at hx'_U'₀
              exact hx'_U'₀
            have hval_eq := hDivOpenEq f₀ x₀_pt hx₀_U₀
            rw [hf₀_open] at hval_eq
            change (ℓ : ℤ) ∣ (e : ℤ) * divFn C₀ (Additive.ofMul f₀) x₀_pt
            rw [← hval_eq]
            exact dvd_mul_of_dvd_right (x.2 _) (e : ℤ)
          · have hx₀_not_U₀ : x₀_pt.1 ∉ (U₀ : Set ↥C₀.left) := by
              intro h_in
              apply hx'_U'₀
              rw [hU'₀_eq]
              exact h_in
            rw [hU_compl, Set.mem_compl_iff] at hx₀_not_U₀
            push_neg at hx₀_not_U₀
            rw [Set.mem_iUnion] at hx₀_not_U₀
            obtain ⟨a, hx₀_a⟩ := hx₀_not_U₀
            rw [Set.mem_singleton_iff] at hx₀_a
            have hx₀_eq : x₀_pt = P_pts a := Subtype.ext hx₀_a
            by_cases hc0 : c a = 0
            · have hmod0 : (- divFn C₀ (Additive.ofMul f₀) (P_pts a)) % (ℓ : ℤ) = 0 := by
                rw [← hc_int a, hc0, Nat.cast_zero]
              have hdvd_a : (ℓ : ℤ) ∣ divFn C₀ (Additive.ofMul f₀) (P_pts a) :=
                dvd_neg.mp (Int.dvd_of_emod_eq_zero hmod0)
              change (ℓ : ℤ) ∣ (e : ℤ) * divFn C₀ (Additive.ofMul f₀) x₀_pt
              rw [hx₀_eq]
              exact dvd_mul_of_dvd_right hdvd_a (e : ℤ)
            · have hca_pos : 1 ≤ c a := Nat.one_le_iff_ne_zero.mpr hc0
              have h_ideal := hRam_stalk a hca_pos x'.1 x'.2 hx₀_a
              have he_ell : e = ℓ := he_uniq ℓ h_ideal
              rw [he_ell]
              exact dvd_mul_right (ℓ : ℤ) _

        have hf'_open_mem :
            Additive.ofMul (Units.map φ_open'.toMonoidHom f'₀) ∈ eratSub C_U'₀ := by
          intro pt'
          obtain ⟨hx'₂, e', _, he'_open, _, hsc_U'⟩ := hScale_U'₀ι pt'
          rw [hsc_U' f'₀, he'_open hOpen_U'₀ι, Nat.cast_one, one_mul]
          exact hf'₀_mem ⟨U'₀.ι.base pt'.1, hx'₂⟩

        have hf'_U_mem :
            Additive.ofMul (Units.map φ_νU.toMonoidHom f_U) ∈ eratSub C_U'₀ := by
          change Additive.ofMul f'_U ∈ eratSub C_U'₀
          rw [← hf'_eq]
          exact hf'_open_mem

        obtain ⟨p'_open, hp'_open⟩ := hPullEx U'₀.ι ℓ 1
        refine ⟨kumMap C'₀ ⟨Additive.ofMul f'₀, hf'₀_mem⟩, p'_open, hp'_open, ?_⟩
        have h_lhs :=
          hKumNat C_U'₀ C'₀ U'₀.ι rfl hGen_U'₀ι p'_open hp'_open f'₀ hf'₀_mem hf'_open_mem
        have h_rhs :=
          hKumNat C_U'₀ C_U₀ ν_U hνU_over hGen_νU p_ν hp_ν f_U x.2 hf'_U_mem
        have hx_sub : (⟨Additive.ofMul f_U, x.2⟩ : ↥(eratSub C_U₀)) = x :=
          Subtype.ext rfl
        rw [hx_sub] at h_rhs
        rw [h_lhs, h_rhs]
        congr 1
        exact Subtype.ext (congrArg Additive.ofMul hf'_eq)

theorem weil_rel_curve_finite_projLine_projection (k : Type u) [Field k] [IsAlgClosed k]
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
    (s₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).left)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_C₀ : Quiver.Hom C₀.left P_cur.Y)
    (hs₀_range : Set.range s₀.base = {P_cur.v})
    (hs₀_sec : CategoryTheory.CategoryStruct.comp s₀
      (CategoryTheory.CategoryStruct.comp
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).hom
        E.V_bar.hom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hPb_C₀ : CategoryTheory.IsPullback ι_C₀ C₀.hom P_cur.f_bar s₀)
    (hIntC : AlgebraicGeometry.IsIntegral C₀.left)
    (hProjC : IsProjectiveOverField k C₀) :
    ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : IsDomain R₁) (_ : Algebra k R₁)
      (_ : Algebra.FiniteType k R₁)
      (σ₁ : R₁ →ₐ[k] k)
      (u_R₁ : MvPolynomial (Fin δ) k →ₐ[k] R₁)
      (j_V₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R₁))
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).left)
      (Y_R₁ : AlgebraicGeometry.Scheme.{u})
      (j_YR₁ : Quiver.Hom Y_R₁ P_cur.Y)
      (f_YR₁ : Quiver.Hom Y_R₁ (AlgebraicGeometry.Spec (CommRingCat.of R₁)))
      (ι_C₀_R₁ : Quiver.Hom C₀.left Y_R₁)
      (π_R₁ : Quiver.Hom Y_R₁
        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₁)))
          (weilProjectiveSpaceOver k 1).hom)),
      RingHom.Etale u_R₁.toRingHom ∧
      AlgebraicGeometry.IsOpenImmersion j_V₁ ∧
      AlgebraicGeometry.IsOpenImmersion j_YR₁ ∧
      AlgebraicGeometry.IsFinite π_R₁ ∧
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.toRingHom)) j_V₁ = s₀ ∧
      CategoryTheory.CategoryStruct.comp j_V₁
        (CategoryTheory.CategoryStruct.comp
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map P_cur.g_V).left
          E.u_V₁) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom u_R₁.toRingHom) ∧
      CategoryTheory.IsPullback j_YR₁ f_YR₁ P_cur.f_bar j_V₁ ∧
      CategoryTheory.CategoryStruct.comp ι_C₀_R₁ j_YR₁ = ι_C₀ ∧
      CategoryTheory.IsPullback ι_C₀_R₁ C₀.hom f_YR₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.toRingHom)) ∧
      CategoryTheory.CategoryStruct.comp π_R₁
        (CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₁)))
          (weilProjectiveSpaceOver k 1).hom) = f_YR₁ :=
by
  classical
  
  
  
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let V_cur : AlgebraicGeometry.Scheme.{u} := (Fgt_V.obj P_cur.V).left
  let v_hom : V_cur ⟶ E.V_bar.left := (Fgt_V.obj P_cur.V).hom
  let g_V_sch : V_cur ⟶ (Fgt_V.obj E.V₁).left := (Fgt_V.map P_cur.g_V).left
  let p_Vcur : V_cur ⟶ S_k := v_hom ≫ E.V_bar.hom
  let u_Vcur : V_cur ⟶ (weilAffineSpaceOver k δ).left := g_V_sch ≫ E.u_V₁

  haveI : AlgebraicGeometry.IsAffine V_cur := P_cur.hAff_V
  haveI : AlgebraicGeometry.IsIntegral V_cur := P_cur.hInt_V
  haveI : AlgebraicGeometry.Etale v_hom := P_cur.V.prop
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj E.V₁).hom := E.V₁.prop
  haveI : AlgebraicGeometry.Etale E.u_V₁ := E.hEt_uV₁
  haveI : AlgebraicGeometry.IsProper E.V_bar.hom := E.hProp_Vbar
  haveI : AlgebraicGeometry.IsProper P_cur.f_bar := P_cur.hProp_f
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 P_cur.f_bar := P_cur.hSm_f
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_C₀ P_cur.hSm_f

  have hgV_w : g_V_sch ≫ (Fgt_V.obj E.V₁).hom = v_hom :=
    CategoryTheory.MorphismProperty.Over.w P_cur.g_V
  haveI : AlgebraicGeometry.Etale g_V_sch :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      g_V_sch (Fgt_V.obj E.V₁).hom E.V₁.prop (by rw [hgV_w]; exact P_cur.V.prop)
  haveI : AlgebraicGeometry.Etale u_Vcur := by
    dsimp [u_Vcur]
    infer_instance
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_Vcur := by
    dsimp [p_Vcur]
    infer_instance
  have hu_Vcur : u_Vcur ≫ (weilAffineSpaceOver k δ).hom = p_Vcur := by
    dsimp [u_Vcur, p_Vcur]
    rw [CategoryTheory.Category.assoc, E.hComp_uV₁, ← CategoryTheory.Category.assoc, hgV_w]
  have hs₀_pt : s₀.base pt_k = P_cur.v := by
    have hm : s₀.base pt_k ∈ Set.range s₀.base := ⟨pt_k, rfl⟩
    rwa [hs₀_range, Set.mem_singleton_iff] at hm

  obtain ⟨N, ι_Ybar, hCl_Ybar⟩ := E.hProj_Ybar
  let P_N := weilProjectiveSpaceOver k N
  haveI : AlgebraicGeometry.IsClosedImmersion ι_Ybar.left := hCl_Ybar

  let φ₁ : P_cur.Y ⟶ CategoryTheory.Limits.pullback E.f_bar₁ g_V_sch :=
    CategoryTheory.Limits.pullback.lift P_cur.π_Y₁ P_cur.f_bar P_cur.hComm_Y₁
  haveI : AlgebraicGeometry.IsFinite φ₁ := P_cur.hFin_rel
  have hφ₁_snd : φ₁ ≫ CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V_sch = P_cur.f_bar :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  let j_Y₁ : E.Y₁ ⟶ CategoryTheory.Limits.pullback E.π_bar.left (Fgt_V.obj E.V₁).hom :=
    CategoryTheory.Limits.pullback.lift E.g_Y₁ E.f_bar₁ E.hComm_Y₁
  haveI : AlgebraicGeometry.IsClosedImmersion j_Y₁ := E.hClosed_Y₁
  let q₂ : CategoryTheory.Limits.pullback E.π_bar.left v_hom ⟶
      CategoryTheory.Limits.pullback E.π_bar.left (Fgt_V.obj E.V₁).hom :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst E.π_bar.left v_hom)
      (CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom ≫ g_V_sch)
      (by rw [CategoryTheory.Category.assoc, hgV_w]; exact CategoryTheory.Limits.pullback.condition)
  have hq₂_fst : q₂ ≫ CategoryTheory.Limits.pullback.fst E.π_bar.left (Fgt_V.obj E.V₁).hom =
      CategoryTheory.Limits.pullback.fst E.π_bar.left v_hom :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq₂_snd : q₂ ≫ CategoryTheory.Limits.pullback.snd E.π_bar.left (Fgt_V.obj E.V₁).hom =
      CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom ≫ g_V_sch :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_q₂ : CategoryTheory.IsPullback q₂
      (CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom)
      (CategoryTheory.Limits.pullback.snd E.π_bar.left (Fgt_V.obj E.V₁).hom) g_V_sch :=
    CategoryTheory.IsPullback.of_right
      (by rw [hq₂_fst, hgV_w]; exact CategoryTheory.IsPullback.of_hasPullback E.π_bar.left v_hom)
      hq₂_snd
      (CategoryTheory.IsPullback.of_hasPullback E.π_bar.left (Fgt_V.obj E.V₁).hom)
  have hcomm_φ₂ :
      (CategoryTheory.Limits.pullback.fst E.f_bar₁ g_V_sch ≫ j_Y₁) ≫
        CategoryTheory.Limits.pullback.snd E.π_bar.left (Fgt_V.obj E.V₁).hom =
      CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V_sch ≫ g_V_sch := by
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
    exact CategoryTheory.Limits.pullback.condition
  let φ₂ : CategoryTheory.Limits.pullback E.f_bar₁ g_V_sch ⟶
      CategoryTheory.Limits.pullback E.π_bar.left v_hom :=
    hPb_q₂.lift (CategoryTheory.Limits.pullback.fst E.f_bar₁ g_V_sch ≫ j_Y₁)
      (CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V_sch) hcomm_φ₂
  have hφ₂_q₂ : φ₂ ≫ q₂ = CategoryTheory.Limits.pullback.fst E.f_bar₁ g_V_sch ≫ j_Y₁ :=
    hPb_q₂.lift_fst _ _ _
  have hφ₂_snd : φ₂ ≫ CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom =
      CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V_sch :=
    hPb_q₂.lift_snd _ _ _
  have hPb_φ₂ : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst E.f_bar₁ g_V_sch) φ₂ j_Y₁ q₂ :=
    CategoryTheory.IsPullback.of_bot
      (by
        rw [hφ₂_snd, CategoryTheory.Limits.pullback.lift_snd]
        exact CategoryTheory.IsPullback.of_hasPullback E.f_bar₁ g_V_sch)
      hφ₂_q₂.symm hPb_q₂
  haveI : AlgebraicGeometry.IsFinite φ₂ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_φ₂ inferInstance

  have hπbar_w : E.π_bar.left ≫ E.V_bar.hom = E.Y_bar.hom := CategoryTheory.Over.w E.π_bar
  let φ₃ : CategoryTheory.Limits.pullback E.π_bar.left v_hom ⟶
      CategoryTheory.Limits.pullback p_Vcur E.Y_bar.hom :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom)
      (CategoryTheory.Limits.pullback.fst E.π_bar.left v_hom)
      ((CategoryTheory.Category.assoc
          (CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom) v_hom E.V_bar.hom).symm.trans
        ((congrArg (· ≫ E.V_bar.hom) CategoryTheory.Limits.pullback.condition.symm).trans
          ((CategoryTheory.Category.assoc _ E.π_bar.left E.V_bar.hom).trans
            (congrArg (CategoryTheory.Limits.pullback.fst E.π_bar.left v_hom ≫ ·) hπbar_w))))
  have hφ₃_fst : φ₃ ≫ CategoryTheory.Limits.pullback.fst p_Vcur E.Y_bar.hom =
      CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hφ₃_snd : φ₃ ≫ CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom =
      CategoryTheory.Limits.pullback.fst E.π_bar.left v_hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  haveI : AlgebraicGeometry.IsFinite φ₃ := by
    let Δ : E.V_bar.left ⟶ CategoryTheory.Limits.pullback E.V_bar.hom E.V_bar.hom :=
      CategoryTheory.Limits.pullback.diagonal E.V_bar.hom
    have hΔ_fst : Δ ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom = 𝟙 _ :=
      CategoryTheory.Limits.pullback.diagonal_fst E.V_bar.hom
    have hΔ_snd : Δ ≫ CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom = 𝟙 _ :=
      CategoryTheory.Limits.pullback.diagonal_snd E.V_bar.hom
    let m₃ : CategoryTheory.Limits.pullback p_Vcur E.Y_bar.hom ⟶
        CategoryTheory.Limits.pullback E.V_bar.hom E.V_bar.hom :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p_Vcur E.Y_bar.hom ≫ v_hom)
        (CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom ≫ E.π_bar.left)
        (by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hπbar_w]
          exact CategoryTheory.Limits.pullback.condition)
    have hm₃_fst : m₃ ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom =
        CategoryTheory.Limits.pullback.fst p_Vcur E.Y_bar.hom ≫ v_hom :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm₃_snd : m₃ ≫ CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom =
        CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom ≫ E.π_bar.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hcomm₃ :
        (CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom ≫ v_hom) ≫ Δ = φ₃ ≫ m₃ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hΔ_fst, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hm₃_fst, ← CategoryTheory.Category.assoc, hφ₃_fst]
      · rw [CategoryTheory.Category.assoc, hΔ_snd, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hm₃_snd, ← CategoryTheory.Category.assoc, hφ₃_snd,
          CategoryTheory.Limits.pullback.condition]
    have hPb₃ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd E.π_bar.left v_hom ≫ v_hom) φ₃ Δ m₃ :=
      CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm₃
          (fun s => CategoryTheory.Limits.pullback.lift
            (s.snd ≫ CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom)
            (s.snd ≫ CategoryTheory.Limits.pullback.fst p_Vcur E.Y_bar.hom)
            (by
              have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom)
                s.condition
              have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom)
                s.condition
              rw [CategoryTheory.Category.assoc, hΔ_fst, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.assoc, hm₃_fst, ← CategoryTheory.Category.assoc] at h1
              rw [CategoryTheory.Category.assoc, hΔ_snd, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.assoc, hm₃_snd, ← CategoryTheory.Category.assoc] at h2
              exact h2.symm.trans h1))
          (fun s => by
            have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom)
              s.condition
            rw [CategoryTheory.Category.assoc, hΔ_fst, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.assoc, hm₃_fst, ← CategoryTheory.Category.assoc] at h1
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
            exact h1.symm)
          (fun s => by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, hφ₃_fst, CategoryTheory.Limits.pullback.lift_snd]
            · rw [CategoryTheory.Category.assoc, hφ₃_snd, CategoryTheory.Limits.pullback.lift_fst])
          (fun s w _ hw2 => by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Limits.pullback.lift_fst]
              have hf := congrArg (· ≫ CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom) hw2
              rwa [CategoryTheory.Category.assoc, hφ₃_snd] at hf
            · rw [CategoryTheory.Limits.pullback.lift_snd]
              have hs := congrArg (· ≫ CategoryTheory.Limits.pullback.fst p_Vcur E.Y_bar.hom) hw2
              rwa [CategoryTheory.Category.assoc, hφ₃_fst] at hs))
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₃ inferInstance

  let φ₄ : CategoryTheory.Limits.pullback p_Vcur E.Y_bar.hom ⟶
      CategoryTheory.Limits.pullback p_Vcur P_N.hom :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst p_Vcur E.Y_bar.hom)
      (CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom ≫ ι_Ybar.left)
      (by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ι_Ybar]
        exact CategoryTheory.Limits.pullback.condition)
  have hφ₄_fst : φ₄ ≫ CategoryTheory.Limits.pullback.fst p_Vcur P_N.hom =
      CategoryTheory.Limits.pullback.fst p_Vcur E.Y_bar.hom :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hφ₄_snd : φ₄ ≫ CategoryTheory.Limits.pullback.snd p_Vcur P_N.hom =
      CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom ≫ ι_Ybar.left :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_φ₄ : CategoryTheory.IsPullback φ₄
      (CategoryTheory.Limits.pullback.snd p_Vcur E.Y_bar.hom)
      (CategoryTheory.Limits.pullback.snd p_Vcur P_N.hom) ι_Ybar.left :=
    CategoryTheory.IsPullback.of_right
      (by
        rw [hφ₄_fst, CategoryTheory.Over.w ι_Ybar]
        exact CategoryTheory.IsPullback.of_hasPullback p_Vcur E.Y_bar.hom)
      hφ₄_snd
      (CategoryTheory.IsPullback.of_hasPullback p_Vcur P_N.hom)
  haveI : AlgebraicGeometry.IsFinite φ₄ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_φ₄.flip inferInstance

  haveI : AlgebraicGeometry.IsFinite (φ₃ ≫ φ₄) := inferInstance
  haveI : AlgebraicGeometry.IsFinite (φ₂ ≫ φ₃ ≫ φ₄) := inferInstance
  let Φ_N : P_cur.Y ⟶ CategoryTheory.Limits.pullback p_Vcur P_N.hom := φ₁ ≫ φ₂ ≫ φ₃ ≫ φ₄
  haveI : AlgebraicGeometry.IsFinite Φ_N := by
    change AlgebraicGeometry.IsFinite (φ₁ ≫ φ₂ ≫ φ₃ ≫ φ₄)
    infer_instance
  have hΦN_fst : Φ_N ≫ CategoryTheory.Limits.pullback.fst p_Vcur P_N.hom = P_cur.f_bar := by
    change (φ₁ ≫ φ₂ ≫ φ₃ ≫ φ₄) ≫ _ = _
    simp only [CategoryTheory.Category.assoc, hφ₄_fst, hφ₃_fst, hφ₂_snd, hφ₁_snd]

  
  
  
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
  let 𝒜_1 := MvPolynomial.homogeneousSubmodule (Fin 2) k
  letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  letI : GradedAlgebra 𝒜_1 := MvPolynomial.gradedAlgebra
  let ϕ₀ : C₀.left ⟶ P_N.left :=
    ι_C₀ ≫ Φ_N ≫ CategoryTheory.Limits.pullback.snd p_Vcur P_N.hom

  haveI : AlgebraicGeometry.IsIntegral C₀.left := hIntC
  haveI : IrreducibleSpace ↥C₀.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C₀.left
  haveI : Nonempty ↥C₀.left := IrreducibleSpace.toNonempty

  have hNoeth_C₀ : TopologicalSpace.NoetherianSpace ↥C₀.left := by
    obtain ⟨M_emb, ι_emb, hCl_emb⟩ := hProjC
    haveI : AlgebraicGeometry.IsClosedImmersion ι_emb.left := hCl_emb
    have hNoeth_PM : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k M_emb).left := by
      let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M_emb + 1)) k
      letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
      let f_ind : ProjectiveSpectrum 𝒜_M → PrimeSpectrum (MvPolynomial (Fin (M_emb + 1)) k) :=
        fun x => ⟨x.asHomogeneousIdeal.toIdeal, x.isPrime⟩
      have hPre : ∀ s : Set (MvPolynomial (Fin (M_emb + 1)) k),
          ProjectiveSpectrum.zeroLocus 𝒜_M s = f_ind ⁻¹' PrimeSpectrum.zeroLocus s := by
        intro s
        ext x
        rfl
      have hf : Topology.IsInducing f_ind := by
        refine ⟨TopologicalSpace.ext_isClosed fun Z => ?_⟩
        rw [ProjectiveSpectrum.isClosed_iff_zeroLocus, isClosed_induced_iff]
        constructor
        · rintro ⟨s, hs⟩
          exact ⟨PrimeSpectrum.zeroLocus s, PrimeSpectrum.isClosed_zeroLocus s,
            by rw [← hPre s]; exact hs.symm⟩
        · rintro ⟨K, hK, rfl⟩
          obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal K).mp hK
          exact ⟨(I : Set (MvPolynomial (Fin (M_emb + 1)) k)), by rw [hI, hPre]⟩
      change TopologicalSpace.NoetherianSpace (ProjectiveSpectrum 𝒜_M)
      rw [TopologicalSpace.noetherianSpace_iff_isCompact]
      intro s
      exact hf.isCompact_iff.mpr (TopologicalSpace.NoetherianSpace.isCompact (f_ind '' s))
    rw [TopologicalSpace.noetherianSpace_iff_isCompact]
    intro s
    exact ι_emb.left.isClosedEmbedding.isInducing.isCompact_iff.mpr
      (@TopologicalSpace.NoetherianSpace.isCompact _ _ hNoeth_PM (ι_emb.left.base '' s))

  have hDim_C₀ : topologicalKrullDim C₀.left ≤ (1 : WithBot ℕ∞) := by
    have h_trdeg : ∀ (S : Type u) [CommRing S] [IsDomain S] [Algebra k S]
        [Algebra (MvPolynomial (Fin 1) k) S] [IsScalarTower k (MvPolynomial (Fin 1) k) S]
        [Algebra.Etale (MvPolynomial (Fin 1) k) S],
        Algebra.FiniteType k S ∧ Algebra.trdeg k S = (1 : Cardinal.{u}) := by
      intro S _ _ _ _ _ _
      let R₀ : Type u := MvPolynomial (Fin 1) k
      have hFT : Algebra.FiniteType k S :=
        Algebra.FiniteType.trans (S := R₀) inferInstance inferInstance
      refine ⟨hFT, ?_⟩
      have : Algebra.Smooth R₀ S := inferInstance
      have : Module.Flat R₀ S := inferInstance
      have : Module.IsTorsionFree R₀ S := Module.Flat.isTorsionFree
      have : FaithfulSMul R₀ S := inferInstance
      have hInjR₀S : Function.Injective (algebraMap R₀ S) :=
        (faithfulSMul_iff_algebraMap_injective R₀ S).mp inferInstance
      let K₀ : Type u := FractionRing R₀
      let M : Submonoid S := Algebra.algebraMapSubmonoid S (nonZeroDivisors R₀)
      let B' : Type u := TensorProduct R₀ S K₀
      have : IsLocalization M B' := IsLocalization.tensor K₀ (nonZeroDivisors R₀)
      have hM : M ≤ nonZeroDivisors S := by
        rintro m ⟨r, hr, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (fun h0 =>
          nonZeroDivisors.ne_zero hr (hInjR₀S (h0.trans (map_zero (algebraMap R₀ S)).symm)))
      have : IsDomain B' := IsLocalization.isDomain_of_le_nonZeroDivisors B' hM
      have hInjSB' : Function.Injective (algebraMap S B') := IsLocalization.injective B' hM
      have : FaithfulSMul S B' := (faithfulSMul_iff_algebraMap_injective S B').mpr hInjSB'
      have : FaithfulSMul k S :=
        (faithfulSMul_iff_algebraMap_injective k S).mpr (RingHom.injective (algebraMap k S))
      have : IsScalarTower k S B' := inferInstance
      have : Algebra.IsAlgebraic S B' := IsLocalization.isAlgebraic B' M
      have h_trdeg_SB' : Algebra.trdeg k S = Algebra.trdeg k B' := by
        have hadd := trdeg_add_eq k S (A := B')
        rw [trdeg_eq_zero (R := S) (A := B'), add_zero] at hadd
        exact hadd
      let B : Type u := TensorProduct R₀ K₀ S
      let e_comm : B ≃ₐ[R₀] B' := Algebra.TensorProduct.comm R₀ K₀ S
      have : IsDomain B := MulEquiv.isDomain B' e_comm.toMulEquiv
      let e_k : B ≃ₐ[k] B' := e_comm.restrictScalars k
      have h_trdeg_BB' : Algebra.trdeg k B = Algebra.trdeg k B' := AlgEquiv.trdeg_eq e_k
      have : Algebra.Etale K₀ B := Algebra.Etale.baseChange R₀ S K₀
      obtain ⟨I_idx, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₀ B).mp inferInstance
      have : Algebra.IsAlgebraic K₀ B := by
        let _ : Finite I_idx := hFinI
        let _ : ∀ i : I_idx, Field (Ai i) := hFieldAi
        let _ : ∀ i : I_idx, Algebra K₀ (Ai i) := hAlgAi
        have : ∀ i : I_idx, Module.Finite K₀ (Ai i) := fun i => (hFinSep i).1
        have : Module.Finite K₀ ((i : I_idx) → Ai i) := Module.Finite.pi
        have : Module.Finite K₀ B := Module.Finite.equiv e_prod.symm.toLinearEquiv
        have : Algebra.IsIntegral K₀ B := Algebra.IsIntegral.of_finite K₀ B
        exact Algebra.IsIntegral.isAlgebraic
      have : FaithfulSMul K₀ B :=
        (faithfulSMul_iff_algebraMap_injective K₀ B).mpr (RingHom.injective (algebraMap K₀ B))
      have : FaithfulSMul k K₀ :=
        (faithfulSMul_iff_algebraMap_injective k K₀).mpr (RingHom.injective (algebraMap k K₀))
      have : IsScalarTower k K₀ B := inferInstance
      have h_trdeg_K₀B : Algebra.trdeg k K₀ = Algebra.trdeg k B := by
        have hadd := trdeg_add_eq k K₀ (A := B)
        rw [trdeg_eq_zero (R := K₀) (A := B), add_zero] at hadd
        exact hadd
      have : FaithfulSMul k R₀ :=
        (faithfulSMul_iff_algebraMap_injective k R₀).mpr (RingHom.injective (algebraMap k R₀))
      have : FaithfulSMul R₀ K₀ :=
        (faithfulSMul_iff_algebraMap_injective R₀ K₀).mpr (IsFractionRing.injective R₀ K₀)
      have : Algebra.IsAlgebraic R₀ K₀ := IsLocalization.isAlgebraic K₀ (nonZeroDivisors R₀)
      have h_trdeg_R₀K₀ : Algebra.trdeg k R₀ = Algebra.trdeg k K₀ := by
        have hadd := trdeg_add_eq k R₀ (A := K₀)
        rw [trdeg_eq_zero (R := R₀) (A := K₀), add_zero] at hadd
        exact hadd
      have h_trdeg_R₀ : Algebra.trdeg k R₀ = (1 : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype (Fin 1), Fintype.card_fin,
          Cardinal.lift_natCast]
        simp
      exact h_trdeg_SB'.trans (h_trdeg_BB'.symm.trans (h_trdeg_K₀B.symm.trans
        (h_trdeg_R₀K₀.symm.trans h_trdeg_R₀)))
    have hcov : ∀ x : ↥C₀.left, ∃ V : C₀.left.Opens,
        x ∈ V ∧ topologicalKrullDim ↥V ≤ (1 : WithBot ℕ∞) := by
      intro x
      obtain ⟨U, _, V, hV, hxV, he_sub, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C₀.hom).mp inferInstance x
      have hU_top : U = ⊤ := by
        ext p
        exact ⟨fun _ => trivial, fun _ => Subsingleton.elim (C₀.hom.base x) p ▸ he_sub hxV⟩
      let e_U : k ≃+* ↑(S_k.presheaf.obj (Opposite.op U)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm.trans
          (S_k.presheaf.mapIso
            (CategoryTheory.eqToIso (congrArg Opposite.op hU_top.symm)))).commRingCatIsoToRingEquiv
      obtain ⟨g_U, _, hg_U⟩ := RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd
      let S : Type u := ↑(C₀.left.presheaf.obj (Opposite.op V))
      let e_poly := MvPolynomial.mapEquiv (Fin 1) e_U
      let g : MvPolynomial (Fin 1) k →+* S := g_U.comp e_poly.toRingHom
      have hg : g.Etale := RingHom.Etale.respectsIso.right g_U e_poly hg_U
      have hneV : Nonempty ↥(V : AlgebraicGeometry.Scheme) := ⟨⟨x, hxV⟩⟩
      haveI : IsDomain S := @AlgebraicGeometry.IsIntegral.component_integral C₀.left hIntC V hneV
      let _ : Algebra (MvPolynomial (Fin 1) k) S := g.toAlgebra
      let _ : Algebra k S := (g.comp (algebraMap k (MvPolynomial (Fin 1) k))).toAlgebra
      haveI : IsScalarTower k (MvPolynomial (Fin 1) k) S := IsScalarTower.of_algebraMap_eq' rfl
      haveI : Algebra.Etale (MvPolynomial (Fin 1) k) S := RingHom.etale_algebraMap.mp hg
      obtain ⟨hFT_S, hTrdeg_S⟩ := h_trdeg S
      haveI : Algebra.FiniteType k S := hFT_S
      obtain ⟨s_dim, g_nn, hInj_nn, hInt_nn⟩ := exists_integral_inj_algHom_of_fg k S
      let A_nn : Type u := MvPolynomial (Fin s_dim) k
      let _ : Algebra A_nn S := g_nn.toRingHom.toAlgebra
      haveI : IsScalarTower k A_nn S := IsScalarTower.of_algebraMap_eq' g_nn.comp_algebraMap.symm
      haveI : FaithfulSMul A_nn S := (faithfulSMul_iff_algebraMap_injective A_nn S).mpr hInj_nn
      haveI : FaithfulSMul k A_nn :=
        (faithfulSMul_iff_algebraMap_injective k A_nn).mpr (RingHom.injective (algebraMap k A_nn))
      haveI : Algebra.IsIntegral A_nn S := ⟨hInt_nn⟩
      haveI : Algebra.IsAlgebraic A_nn S := Algebra.IsIntegral.isAlgebraic
      have h_trdeg_AS : Algebra.trdeg k A_nn = Algebra.trdeg k S := by
        have hadd := trdeg_add_eq k A_nn (A := S)
        rw [trdeg_eq_zero (R := A_nn) (A := S), add_zero] at hadd
        exact hadd
      have h_trdeg_A : Algebra.trdeg k A_nn = (s_dim : Cardinal.{u}) := by
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype (Fin s_dim), Fintype.card_fin,
          Cardinal.lift_natCast]
      have hsd : s_dim = 1 :=
        Nat.cast_inj.mp (h_trdeg_A.symm.trans (h_trdeg_AS.trans (hTrdeg_S.trans (Nat.cast_one.symm))))
      have hDimA : ringKrullDim A_nn = (1 : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
          zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin, hsd]
        rfl
      have hStrict_nn : StrictMono (PrimeSpectrum.comap (algebraMap A_nn S)) := by
        intro Q₁ Q₂ hQ
        have hlt_ideal : Q₁.asIdeal < Q₂.asIdeal := hQ
        obtain ⟨elem, hxQ₂, hxQ₁⟩ := SetLike.exists_of_lt hlt_ideal
        exact @Ideal.under_lt_under_of_integral_mem_sdiff A_nn _ S _ Q₁.asIdeal Q₂.asIdeal _
          Q₁.isPrime (le_of_lt hlt_ideal) elem ⟨hxQ₂, hxQ₁⟩ (Algebra.IsIntegral.isIntegral elem)
      have hDimS : ringKrullDim S ≤ (1 : WithBot ℕ∞) :=
        (Order.krullDim_le_of_strictMono _ hStrict_nn).trans_eq hDimA
      refine ⟨V, hxV, ?_⟩
      have hHomeo :=
        (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso hV.isoSpec)).isHomeomorph
      exact (hHomeo.topologicalKrullDim_eq.trans
        (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim S)).trans_le hDimS
    obtain ⟨t₀⟩ := (inferInstance : Nonempty ↥C₀.left)
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥C₀.left) :=
      ⟨⟨closure {t₀}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥C₀.left) ≤ ((1 : ℕ∞) : WithBot ℕ∞)
    rw [Order.krullDim_eq_iSup_length]
    refine WithBot.coe_le_coe.mpr (iSup_le fun l => ?_)
    obtain ⟨x, hxF₀⟩ := (l 0).isIrreducible.nonempty
    obtain ⟨V, hxV, hDimV⟩ := hcov x
    let G' : Fin (l.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V :=
      fun i =>
        { carrier := Subtype.val ⁻¹' ((l i : TopologicalSpace.IrreducibleCloseds ↥C₀.left) : Set ↥C₀.left)
          isIrreducible' := ⟨⟨⟨x, hxV⟩, l.strictMono.monotone (Fin.zero_le i) hxF₀⟩,
            (l i).isIrreducible.isPreirreducible.preimage V.isOpen.isOpenEmbedding_subtypeVal⟩
          isClosed' := (l i).isClosed.preimage continuous_subtype_val }
    have hStrictG : StrictMono G' := by
      intro i j hij
      have hle : G' i ≤ G' j := fun y hy => l.strictMono.monotone (le_of_lt hij) hy
      refine lt_of_le_not_ge hle (fun hge => ?_)
      have hsub : ((l j : TopologicalSpace.IrreducibleCloseds ↥C₀.left) : Set ↥C₀.left) ⊆
          ((l i : TopologicalSpace.IrreducibleCloseds ↥C₀.left) : Set ↥C₀.left) ∪ (V : Set ↥C₀.left)ᶜ := by
        intro y hy
        by_cases hyV : y ∈ V
        · exact Or.inl (@hge ⟨y, hyV⟩ hy)
        · exact Or.inr hyV
      rcases isPreirreducible_iff_isClosed_union_isClosed.mp
          (l j).isIrreducible.isPreirreducible
          ((l i : TopologicalSpace.IrreducibleCloseds ↥C₀.left) : Set ↥C₀.left) (V : Set ↥C₀.left)ᶜ
          (l i).isClosed V.isOpen.isClosed_compl hsub with
        h1 | h2
      · exact not_le_of_gt (l.strictMono hij) h1
      · exact h2 (l.strictMono.monotone (Fin.zero_le j) hxF₀) hxV
    let l_V : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) :=
      { length := l.length
        toFun := G'
        step := fun _ => hStrictG Fin.castSucc_lt_succ }
    exact WithBot.coe_le_coe.mp ((Order.LTSeries.length_le_krullDim l_V).trans hDimV)

  have hExistsX : ∀ y : P_N.left,
      ∃ α : Fin (N + 1),
        (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) ∉
          (y : ProjectiveSpectrum 𝒜_N).asHomogeneousIdeal.toIdeal := by
    intro y
    let y' : ProjectiveSpectrum 𝒜_N := y
    by_contra! hAll
    apply y'.not_irrelevant_le
    change (HomogeneousIdeal.irrelevant 𝒜_N).toIdeal ≤ y'.asHomogeneousIdeal.toIdeal
    rw [HomogeneousIdeal.irrelevant_eq_span]
    refine Ideal.span_le.mpr ?_
    intro g hg
    simp only [Set.mem_iUnion] at hg
    obtain ⟨n, hn, hg_mem⟩ := hg
    have hSpan : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
        y'.asHomogeneousIdeal.toIdeal := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨α, _, rfl⟩
      exact hAll α
    apply hSpan
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hg_hom : g.IsHomogeneous n := (MvPolynomial.mem_homogeneousSubmodule n g).mp hg_mem
    have hm_deg := hg_hom (MvPolynomial.mem_support_iff.mp hm)
    by_contra! hm0
    have hm_eq : m = 0 := Finsupp.ext fun a => hm0 a (Set.mem_univ a)
    rw [hm_eq] at hm_deg
    simp at hm_deg
    omega

  have hAvoidPt : ∀ y : P_N.left,
      ∃ P_lin : MvPolynomial (Fin (N + 1)) k,
        P_lin ≠ 0 ∧
        ∀ c : Fin (N + 1) → k,
          MvPolynomial.eval c P_lin ≠ 0 →
          y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N
            (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i) := by
    intro y
    obtain ⟨α, hXα⟩ := hExistsX y
    let I := (y : ProjectiveSpectrum 𝒜_N).asHomogeneousIdeal.toIdeal
    let V_I : Submodule k (Fin (N + 1) → k) :=
      { carrier := {c | (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i) ∈ I}
        zero_mem' := by simp [I.zero_mem]
        add_mem' := fun {a b} ha hb => by
          change (∑ i : Fin (N + 1), MvPolynomial.C ((a + b) i) * MvPolynomial.X i) ∈ I
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          exact I.add_mem ha hb
        smul_mem' := fun r {a} ha => by
          change (∑ i : Fin (N + 1), MvPolynomial.C ((r • a) i) * MvPolynomial.X i) ∈ I
          simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, ← Finset.mul_sum]
          exact I.mul_mem_left _ ha }
    have hVI_lt : V_I < ⊤ := by
      rw [lt_top_iff_ne_top]
      intro hTop
      have hMem : (Pi.single α (1 : k) : Fin (N + 1) → k) ∈ V_I := by
        rw [hTop]
        trivial
      have hMem' : (∑ i : Fin (N + 1),
          MvPolynomial.C ((Pi.single α (1 : k) : Fin (N + 1) → k) i) * MvPolynomial.X i) ∈ I :=
        hMem
      have hSum : (∑ i : Fin (N + 1),
          MvPolynomial.C ((Pi.single α (1 : k) : Fin (N + 1) → k) i) * MvPolynomial.X i) =
          (MvPolynomial.X α : MvPolynomial (Fin (N + 1)) k) := by
        rw [Finset.sum_eq_single α]
        · simp
        · intro b _ hb
          simp [Pi.single_eq_of_ne hb]
        · intro hAbs
          exact absurd (Finset.mem_univ α) hAbs
      rw [hSum] at hMem'
      exact hXα hMem'
    obtain ⟨ℓ_fn, hℓ_ne, hℓ_ker⟩ := Submodule.exists_dual_map_eq_bot_of_lt_top hVI_lt inferInstance
    let P_lin : MvPolynomial (Fin (N + 1)) k :=
      ∑ i : Fin (N + 1), MvPolynomial.C (ℓ_fn (Pi.single i 1)) * MvPolynomial.X i
    have hEval : ∀ c : Fin (N + 1) → k, MvPolynomial.eval c P_lin = ℓ_fn c := by
      intro c
      have hc_sum : c = ∑ i : Fin (N + 1), c i • Pi.single i (1 : k) := by
        ext j
        simp [Finset.sum_apply, Pi.single_apply]
      conv_rhs => rw [hc_sum]
      simp only [P_lin, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, map_smul,
        smul_eq_mul, mul_comm]
    have hP_ne : P_lin ≠ 0 := by
      intro hP0
      apply hℓ_ne
      exact LinearMap.ext fun c => by rw [← hEval c, hP0, map_zero, LinearMap.zero_apply]
    refine ⟨P_lin, hP_ne, fun c hc_ne => ?_⟩
    refine (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_N
      (∑ i : Fin (N + 1), MvPolynomial.C (c i) * MvPolynomial.X i)
      (y : ↥(AlgebraicGeometry.Proj 𝒜_N))).mpr (fun hInI => ?_)
    apply hc_ne
    rw [hEval c]
    have hMapMem : ℓ_fn c ∈ Submodule.map ℓ_fn V_I := Submodule.mem_map_of_mem hInI
    rwa [hℓ_ker, Submodule.mem_bot] at hMapMem

  obtain ⟨x₀_C⟩ := (inferInstance : Nonempty ↥C₀.left)
  obtain ⟨i₀, hx₀_not_ideal⟩ := hExistsX (ϕ₀.base x₀_C)
  let L₀ : MvPolynomial (Fin (N + 1)) k := MvPolynomial.X i₀
  have hL₀ : L₀ ∈ 𝒜_N 1 := MvPolynomial.isHomogeneous_X k i₀
  have hx₀_in_L₀ : ϕ₀.base x₀_C ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N L₀ :=
    (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_N L₀ (ϕ₀.base x₀_C : ↥(AlgebraicGeometry.Proj 𝒜_N))).mpr
      hx₀_not_ideal

  let U_C₀_0 : C₀.left.Opens :=
    (TopologicalSpace.Opens.map ϕ₀.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_N L₀)
  let S₁ : Set ↥C₀.left := (U_C₀_0 : Set ↥C₀.left)ᶜ
  have hCl_S₁ : IsClosed S₁ := U_C₀_0.isOpen.isClosed_compl
  have hx₀_not_S₁ : x₀_C ∉ S₁ := fun h => h hx₀_in_L₀

  obtain ⟨S_set, hFin_S, hClS, hIrrS, hEqS⟩ :=
    @TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible _ _ hNoeth_C₀ S₁ hCl_S₁
  let S_fin : Finset (Set ↥C₀.left) := hFin_S.toFinset
  let w_wit : ↥S_fin → ↥C₀.left :=
    fun W => (hIrrS W.1 (hFin_S.mem_toFinset.mp W.2)).nonempty.some
  have hw_mem : ∀ W : ↥S_fin, w_wit W ∈ W.1 :=
    fun W => (hIrrS W.1 (hFin_S.mem_toFinset.mp W.2)).nonempty.some_mem
  choose P_pt hP_pt_ne hP_pt_avoid using hAvoidPt
  let Δ_poly : MvPolynomial (Fin (N + 1)) k :=
    ∏ W ∈ S_fin.attach, P_pt (ϕ₀.base (w_wit W))
  have hΔ_ne : Δ_poly ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun W _ => hP_pt_ne (ϕ₀.base (w_wit W)))
  haveI : Infinite k := IsAlgClosed.instInfinite
  have hc₁_ex : ∃ c₁ : Fin (N + 1) → k, MvPolynomial.eval c₁ Δ_poly ≠ 0 := by
    by_contra! hAll0
    apply hΔ_ne
    rw [MvPolynomial.funext_iff]
    intro c₁
    simp [hAll0 c₁]
  obtain ⟨c₁, hc₁⟩ := hc₁_ex
  let L₁ : MvPolynomial (Fin (N + 1)) k :=
    ∑ i : Fin (N + 1), MvPolynomial.C (c₁ i) * MvPolynomial.X i
  have hL₁ : L₁ ∈ 𝒜_N 1 := by
    refine Submodule.sum_mem (𝒜_N 1) (fun i _ => ?_)
    change (MvPolynomial.C (c₁ i) * MvPolynomial.X i).IsHomogeneous 1
    simpa using (MvPolynomial.isHomogeneous_C (Fin (N + 1)) (c₁ i)).mul
      (MvPolynomial.isHomogeneous_X k i)

  have hCov_C₀ : ∀ z : ↥C₀.left,
      ϕ₀.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N L₀ ∨
      ϕ₀.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N L₁ := by
    intro z
    by_contra! hz_both
    rcases hz_both with ⟨hz₀, hz₁⟩
    have hz_S₁ : z ∈ S₁ := hz₀
    rw [hEqS, Set.mem_sUnion] at hz_S₁
    obtain ⟨W, hW_mem, hzW⟩ := hz_S₁
    have hW_fin : W ∈ S_fin := hFin_S.mem_toFinset.mpr hW_mem
    have hW_sub_S₁ : W ⊆ S₁ := by
      intro u hu
      rw [hEqS]
      exact Set.mem_sUnion_of_mem hu hW_mem
    have hc₁_W : MvPolynomial.eval c₁ (P_pt (ϕ₀.base (w_wit ⟨W, hW_fin⟩))) ≠ 0 := by
      rw [map_prod, Finset.prod_ne_zero_iff] at hc₁
      exact hc₁ ⟨W, hW_fin⟩ (Finset.mem_attach _ ⟨W, hW_fin⟩)
    have hw_in_L₁ : ϕ₀.base (w_wit ⟨W, hW_fin⟩) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N L₁ :=
      hP_pt_avoid (ϕ₀.base (w_wit ⟨W, hW_fin⟩)) c₁ hc₁_W
    let U_C₀_1 : C₀.left.Opens :=
      (TopologicalSpace.Opens.map ϕ₀.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_N L₁)
    let S₂ : Set ↥C₀.left := (U_C₀_1 : Set ↥C₀.left)ᶜ
    have hCl_S₂ : IsClosed S₂ := U_C₀_1.isOpen.isClosed_compl
    have hz_cl_W : closure ({z} : Set ↥C₀.left) ⊆ W :=
      closure_minimal (Set.singleton_subset_iff.mpr hzW) (hClS W hW_mem)
    have hz_cl_S₂ : closure ({z} : Set ↥C₀.left) ⊆ S₂ :=
      closure_minimal (Set.singleton_subset_iff.mpr hz₁) hCl_S₂
    let IC₀ : TopologicalSpace.IrreducibleCloseds ↥C₀.left :=
      ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
    let IC₁ : TopologicalSpace.IrreducibleCloseds ↥C₀.left :=
      ⟨W, hIrrS W hW_mem, hClS W hW_mem⟩
    let IC₂ : TopologicalSpace.IrreducibleCloseds ↥C₀.left :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥C₀.left, isClosed_univ⟩
    have h01 : IC₀ < IC₁ :=
      lt_of_le_not_ge hz_cl_W (fun hge =>
        hz_cl_S₂ (hge (hw_mem ⟨W, hW_fin⟩)) hw_in_L₁)
    have h12 : IC₁ < IC₂ :=
      lt_of_le_not_ge (Set.subset_univ W) (fun hge =>
        hx₀_not_S₁ (hW_sub_S₁ (hge trivial)))
    let ser : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C₀.left) :=
      { length := 2
        toFun := Fin.cases IC₀ (Fin.cases IC₁ (fun _ => IC₂))
        step := fun i => by
          fin_cases i
          · exact h01
          · exact h12 }
    have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim C₀.left :=
      Order.LTSeries.length_le_krullDim ser
    exact absurd (Nat.cast_le.mp (WithBot.coe_le_coe.mp (h2.trans hDim_C₀))) (by omega)

  
  
  
  let P_1 := weilProjectiveSpaceOver k 1
  let U_L : P_N.left.Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜_N L₀ ⊔ AlgebraicGeometry.Proj.basicOpen 𝒜_N L₁
  let L_vec : Fin 2 → MvPolynomial (Fin (N + 1)) k := Fin.cases L₀ (fun _ => L₁)
  have hL_hom : ∀ b : Fin 2, L_vec b ∈ 𝒜_N 1 := Fin.cases hL₀ (fun _ => hL₁)

  let Φ₀_ring : MvPolynomial (Fin 2) k →+* MvPolynomial (Fin (N + 1)) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C L_vec
  have hdeg_L : ∀ (i : ℕ) (p : MvPolynomial (Fin 2) k),
      p ∈ 𝒜_1 i → Φ₀_ring p ∈ 𝒜_N i := by
    intro i p hp
    have hp' : p.IsHomogeneous i := hp
    have hev : (MvPolynomial.eval₂ MvPolynomial.C L_vec p).IsHomogeneous (1 * i) :=
      hp'.eval₂ MvPolynomial.C L_vec (fun r => MvPolynomial.isHomogeneous_C _ r) hL_hom
    rwa [Nat.one_mul] at hev
  let Φ_gr : 𝒜_1 →+*ᵍ 𝒜_N := { toRingHom := Φ₀_ring, map_mem := @hdeg_L }

  let D_N : Fin 2 → P_N.left.Opens := fun b => AlgebraicGeometry.Proj.basicOpen 𝒜_N (L_vec b)
  let D_1 : Fin 2 → P_1.left.Opens :=
    fun b => AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X b)
  let V_cov : Fin 2 → U_L.toScheme.Opens :=
    fun b => (TopologicalSpace.Opens.map U_L.ι.base).obj (D_N b)

  have hCovV : ∀ x : ↥U_L.toScheme, ∃ b : Fin 2, x ∈ V_cov b := by
    intro x
    rcases x.2 with hx0 | hx1
    · exact ⟨0, hx0⟩
    · exact ⟨1, hx1⟩
  have hCovV_top : (⨆ b : Fin 2, V_cov b) = ⊤ := by
    ext x
    exact ⟨fun _ => trivial, fun _ => TopologicalSpace.Opens.mem_iSup.mpr (hCovV x)⟩

  have hTb : ∀ b : Fin 2, (MvPolynomial.X b : MvPolynomial (Fin 2) k) ∈ 𝒜_1 1 :=
    fun b => MvPolynomial.isHomogeneous_X k b
  have hsub_L : ∀ b : Fin 2,
      Submonoid.powers (MvPolynomial.X b : MvPolynomial (Fin 2) k) ≤
        Submonoid.comap Φ₀_ring (Submonoid.powers (L_vec b)) := by
    intro b
    apply Submonoid.powers_le.mpr
    change Φ₀_ring (MvPolynomial.X b) ∈ Submonoid.powers (L_vec b)
    simp [Φ₀_ring, Submonoid.mem_powers]

  let π_tilde : ∀ b : Fin 2, (D_N b : AlgebraicGeometry.Scheme.{u}) ⟶ P_1.left :=
    fun b =>
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec b) (hL_hom b) zero_lt_one).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L b))) ≫
      AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one

  let π_loc : ∀ b : Fin 2, (V_cov b : AlgebraicGeometry.Scheme.{u}) ⟶ P_1.left :=
    fun b => (U_L.ι ∣_ D_N b) ≫ π_tilde b

  have hOverlap_V : ∀ a a' : Fin 2,
      U_L.toScheme.homOfLE (inf_le_left : V_cov a ⊓ V_cov a' ≤ V_cov a) ≫ π_loc a =
      U_L.toScheme.homOfLE (inf_le_right : V_cov a ⊓ V_cov a' ≤ V_cov a') ≫ π_loc a' := by
    intro a a'
    let L_aa' : MvPolynomial (Fin (N + 1)) k := L_vec a * L_vec a'
    let T_aa' : MvPolynomial (Fin 2) k := MvPolynomial.X a * MvPolynomial.X a'
    have hT_aa' : T_aa' ∈ 𝒜_1 2 := by
      simpa using SetLike.mul_mem_graded (hTb a) (hTb a')
    have hsub_aa' : Submonoid.powers T_aa' ≤ Submonoid.comap Φ₀_ring (Submonoid.powers L_aa') := by
      apply Submonoid.powers_le.mpr
      change Φ₀_ring (MvPolynomial.X a * MvPolynomial.X a') ∈ Submonoid.powers (L_vec a * L_vec a')
      simp [Φ₀_ring, Submonoid.mem_powers]
    let D_aa' : P_N.left.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_N L_aa'
    have hD_eq : D_aa' = D_N a ⊓ D_N a' :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜_N (L_vec a) (L_vec a')
    have hle_D_L : D_aa' ≤ D_N a := hD_eq.le.trans inf_le_left
    have hle_D_R : D_aa' ≤ D_N a' := hD_eq.le.trans inf_le_right
    have hFactor : ∀ (b c : Fin 2) (hx : L_aa' = L_vec b * L_vec c)
        (hy : T_aa' = MvPolynomial.X b * MvPolynomial.X c) (hle : D_aa' ≤ D_N b),
        P_N.left.homOfLE hle ≫ π_tilde b =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N L_aa' ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map Φ_gr hsub_aa')) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_1 T_aa' hT_aa' zero_lt_two := by
      intro b c hx hy hle
      have h_iso_hom :
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec b) (hL_hom b) zero_lt_one).hom =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (L_vec b) :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_N (L_vec b) (hL_hom b) zero_lt_one
      have h_toSpec :
          P_N.left.homOfLE hle ≫ AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (L_vec b) =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N L_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_N (hL_hom c) hx)) :=
        (AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_N (hL_hom c) hx).symm
      have h_ring :
          (HomogeneousLocalization.awayMap 𝒜_N (hL_hom c) hx).comp
            (HomogeneousLocalization.map Φ_gr (hsub_L b)) =
          (HomogeneousLocalization.map Φ_gr hsub_aa').comp
            (HomogeneousLocalization.awayMap 𝒜_1 (hTb c) hy) := by
        ext z
        obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_1 (hTb b) z
        have h1 : HomogeneousLocalization.map Φ_gr (hsub_L b)
            (HomogeneousLocalization.Away.mk 𝒜_1 (hTb b) n p hp) =
          HomogeneousLocalization.Away.mk 𝒜_N (hL_hom b) n (Φ₀_ring p) (hdeg_L (n • 1) p hp) := by
          apply HomogeneousLocalization.val_injective _
          rw [HomogeneousLocalization.Away.val_mk]
          erw [HomogeneousLocalization.map_mk]
          simp [Φ_gr, Φ₀_ring, HomogeneousLocalization.Away.mk]
        simp only [RingHom.comp_apply, h1, HomogeneousLocalization.awayMap_mk]
        rw [HomogeneousLocalization.Away.val_mk]
        erw [HomogeneousLocalization.map_mk]
        simp [Φ_gr, Φ₀_ring, HomogeneousLocalization.Away.mk, hx, hy, mul_pow]
      have h_awayι :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.awayMap 𝒜_1 (hTb c) hy)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one =
          AlgebraicGeometry.Proj.awayι 𝒜_1 T_aa' hT_aa' zero_lt_two :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_1 (hTb b) zero_lt_one (hTb c) hy
      let tail_b :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L b))) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one
      have hs1 : P_N.left.homOfLE hle ≫ π_tilde b =
          (P_N.left.homOfLE hle ≫ AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (L_vec b)) ≫ tail_b := by
        dsimp only [π_tilde, tail_b]
        rw [← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ tail_b) (congrArg (P_N.left.homOfLE hle ≫ ·) h_iso_hom)
      have hs2 :
          (P_N.left.homOfLE hle ≫ AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (L_vec b)) ≫ tail_b =
          (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N L_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_N (hL_hom c) hx))) ≫ tail_b :=
        congrArg (· ≫ tail_b) h_toSpec
      have hs3 :
          (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N L_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_N (hL_hom c) hx))) ≫ tail_b =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N L_aa' ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.map Φ_gr hsub_aa')) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_1 T_aa' hT_aa' zero_lt_two := by
        dsimp only [tail_b]
        rw [CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_ring,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, h_awayι]
      exact (hs1.trans hs2).trans hs3
    have hTildeEq :
        P_N.left.homOfLE hle_D_L ≫ π_tilde a = P_N.left.homOfLE hle_D_R ≫ π_tilde a' :=
      (hFactor a a' rfl rfl hle_D_L).trans
        (hFactor a' a (mul_comm (L_vec a) (L_vec a'))
          (mul_comm (MvPolynomial.X a) (MvPolynomial.X a')) hle_D_R).symm
    have hV_le : V_cov a ⊓ V_cov a' ≤ (TopologicalSpace.Opens.map U_L.ι.base).obj D_aa' := by
      intro x hx
      change U_L.ι.base x ∈ D_aa'
      rw [hD_eq]
      exact hx
    let u_aa' : ((V_cov a ⊓ V_cov a' : U_L.toScheme.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶
        (D_aa' : AlgebraicGeometry.Scheme.{u}) :=
      U_L.toScheme.homOfLE hV_le ≫ (U_L.ι ∣_ D_aa')
    have hPull : ∀ (b : Fin 2) (hle_V : V_cov a ⊓ V_cov a' ≤ V_cov b) (hle_D : D_aa' ≤ D_N b),
        U_L.toScheme.homOfLE hle_V ≫ (U_L.ι ∣_ D_N b) =
        u_aa' ≫ P_N.left.homOfLE hle_D := by
      intro b hle_V hle_D
      rw [← CategoryTheory.cancel_mono (D_N b).ι]
      dsimp only [u_aa']
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι_assoc,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    dsimp only [π_loc]
    rw [← CategoryTheory.Category.assoc, hPull a inf_le_left hle_D_L,
      CategoryTheory.Category.assoc, hTildeEq,
      ← CategoryTheory.Category.assoc, ← hPull a' inf_le_right hle_D_R,
      CategoryTheory.Category.assoc]

  let 𝒰 : U_L.toScheme.OpenCover :=
    U_L.toScheme.openCoverOfIsOpenCover V_cov (TopologicalSpace.IsOpenCover.mk hCovV_top)
  have hGlueCond : ∀ (a a' : 𝒰.I₀),
      CategoryTheory.Limits.pullback.fst (𝒰.f a) (𝒰.f a') ≫ π_loc a =
      CategoryTheory.Limits.pullback.snd (𝒰.f a) (𝒰.f a') ≫ π_loc a' := by
    intro (a : Fin 2) (a' : Fin 2)
    let fst_uv := CategoryTheory.Limits.pullback.fst (V_cov a).ι (V_cov a').ι
    let snd_uv := CategoryTheory.Limits.pullback.snd (V_cov a).ι (V_cov a').ι
    have hcond : fst_uv ≫ (V_cov a).ι = snd_uv ≫ (V_cov a').ι :=
      CategoryTheory.Limits.pullback.condition
    have hrange : Set.range (fst_uv ≫ (V_cov a).ι).base ⊆ Set.range (V_cov a ⊓ V_cov a').ι.base := by
      rw [(V_cov a ⊓ V_cov a').range_ι]
      rintro _ ⟨z, rfl⟩
      refine ⟨?_, ?_⟩
      · have h1 : (V_cov a).ι.base (fst_uv.base z) = (fst_uv.base z).1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply (V_cov a) (fst_uv.base z)
        change (V_cov a).ι.base (fst_uv.base z) ∈ V_cov a
        rw [h1]
        exact (fst_uv.base z).2
      · rw [hcond]
        have h2 : (V_cov a').ι.base (snd_uv.base z) = (snd_uv.base z).1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply (V_cov a') (snd_uv.base z)
        change (V_cov a').ι.base (snd_uv.base z) ∈ V_cov a'
        rw [h2]
        exact (snd_uv.base z).2
    let p_inf : CategoryTheory.Limits.pullback (V_cov a).ι (V_cov a').ι ⟶
        ((V_cov a ⊓ V_cov a' : U_L.toScheme.Opens) : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift (V_cov a ⊓ V_cov a').ι (fst_uv ≫ (V_cov a).ι) hrange
    have hp_fac : p_inf ≫ (V_cov a ⊓ V_cov a').ι = fst_uv ≫ (V_cov a).ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (V_cov a ⊓ V_cov a').ι (fst_uv ≫ (V_cov a).ι) hrange
    have hp_fst : fst_uv =
        p_inf ≫ U_L.toScheme.homOfLE (inf_le_left : V_cov a ⊓ V_cov a' ≤ V_cov a) := by
      rw [← CategoryTheory.cancel_mono (V_cov a).ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac]
    have hp_snd : snd_uv =
        p_inf ≫ U_L.toScheme.homOfLE (inf_le_right : V_cov a ⊓ V_cov a' ≤ V_cov a') := by
      rw [← CategoryTheory.cancel_mono (V_cov a').ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac, hcond]
    change fst_uv ≫ π_loc a = snd_uv ≫ π_loc a'
    rw [hp_fst, hp_snd, CategoryTheory.Category.assoc, hOverlap_V a a',
      CategoryTheory.Category.assoc]

  let p_L : U_L.toScheme ⟶ P_1.left := 𝒰.glueMorphisms π_loc hGlueCond
  have hChart_V : ∀ b : Fin 2, (V_cov b).ι ≫ p_L = π_loc b :=
    fun b => 𝒰.ι_glueMorphisms π_loc hGlueCond b

  have hp_L_hom : p_L ≫ P_1.hom = U_L.ι ≫ P_N.hom := by
    apply 𝒰.hom_ext
    intro (b : Fin 2)
    change (V_cov b).ι ≫ p_L ≫ P_1.hom = (V_cov b).ι ≫ U_L.ι ≫ P_N.hom
    rw [← CategoryTheory.Category.assoc, hChart_V b]
    let z_1 := HomogeneousLocalization.fromZeroRingHom 𝒜_1 (Submonoid.powers (MvPolynomial.X b))
    let z_N := HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (L_vec b))
    have hZeroRing :
        ((HomogeneousLocalization.map Φ_gr (hsub_L b)).comp z_1).comp (algebraMap k ↥(𝒜_1 0)) =
        z_N.comp (algebraMap k ↥(𝒜_N 0)) := by
      ext r
      simp only [RingHom.comp_apply, z_1, z_N]
      erw [HomogeneousLocalization.map_mk]
      have hr : (algebraMap k ↥(𝒜_1 0) r : MvPolynomial (Fin 2) k) = MvPolynomial.C r := rfl
      have hr' : (algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k) = MvPolynomial.C r := rfl
      change Localization.mk (Φ₀_ring ((algebraMap k ↥(𝒜_1 0) r : MvPolynomial (Fin 2) k)))
          ⟨Φ₀_ring 1, _⟩ =
        Localization.mk ((algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k)) ⟨1, _⟩
      have hnum : Φ₀_ring ((algebraMap k ↥(𝒜_1 0) r : MvPolynomial (Fin 2) k)) =
          ((algebraMap k ↥(𝒜_N 0) r : MvPolynomial (Fin (N + 1)) k)) := by
        rw [hr, hr']
        simp [Φ₀_ring]
      have hden : (⟨Φ₀_ring 1, (hsub_L b) (Submonoid.one_mem _)⟩ : Submonoid.powers (L_vec b)) =
          ⟨1, Submonoid.one_mem _⟩ := Subtype.ext (map_one Φ₀_ring)
      rw [hnum, hden]
    have hTilde_hom : π_tilde b ≫ P_1.hom = (D_N b).ι ≫ P_N.hom := by
      have hDN_ι : (D_N b).ι =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec b) (hL_hom b) zero_lt_one).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_N (L_vec b) (hL_hom b) zero_lt_one := by
        dsimp only [D_N]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (L_vec b) (hL_hom b) zero_lt_one,
          CategoryTheory.Iso.hom_inv_id_assoc]
        rfl
      have h_away_1 :
          AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one ≫ P_1.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_1.comp (algebraMap k ↥(𝒜_1 0)))) := by
        change AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜_1 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0))) = _
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_away_N :
          AlgebraicGeometry.Proj.awayι 𝒜_N (L_vec b) (hL_hom b) zero_lt_one ≫ P_N.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
        change AlgebraicGeometry.Proj.awayι 𝒜_N (L_vec b) (hL_hom b) zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) = _
        rw [← CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (L_vec b) (hL_hom b) zero_lt_one,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_mid :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L b))) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one) ≫ P_1.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
        have hm1 := CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L b))))
          (AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one) P_1.hom
        have hm2 := congrArg
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L b))) ≫ ·)
          h_away_1
        have hm3 :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L b))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_1.comp (algebraMap k ↥(𝒜_1 0)))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← RingHom.comp_assoc, hZeroRing]
        exact (hm1.trans hm2).trans hm3
      have ht1 : π_tilde b ≫ P_1.hom =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec b) (hL_hom b) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec b) (hL_hom b) zero_lt_one).hom ≫ ·) h_mid)
      have ht2 : (D_N b).ι ≫ P_N.hom =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec b) (hL_hom b) zero_lt_one).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) :=
        (congrArg (· ≫ P_N.hom) hDN_ι).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            (congrArg ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec b) (hL_hom b) zero_lt_one).hom ≫ ·) h_away_N))
      exact ht1.trans ht2.symm
    dsimp only [π_loc]
    rw [CategoryTheory.Category.assoc, hTilde_hom, ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]

  have hPre_pL : ∀ c : Fin 2,
      (TopologicalSpace.Opens.map p_L.base).obj (D_1 c) = V_cov c := by
    intro c
    ext x
    obtain ⟨a, hxa⟩ := hCovV x
    let u_pt : ↥(V_cov a : AlgebraicGeometry.Scheme.{u}) := ⟨x, hxa⟩
    have hu_val : (V_cov a).ι.base u_pt = x := AlgebraicGeometry.Scheme.Opens.ι_apply (V_cov a) u_pt
    have hElem : HomogeneousLocalization.map Φ_gr (hsub_L a)
        (HomogeneousLocalization.Away.isLocalizationElem (hTb a) (hTb c)) =
      HomogeneousLocalization.Away.isLocalizationElem (hL_hom a) (hL_hom c) := by
      apply HomogeneousLocalization.val_injective _
      erw [HomogeneousLocalization.map_mk]
      simp [Φ_gr, Φ₀_ring, HomogeneousLocalization.Away.isLocalizationElem,
        HomogeneousLocalization.Away.mk]
    have hTilde_pre :
        (TopologicalSpace.Opens.map (π_tilde a).base).obj (D_1 c) =
        (TopologicalSpace.Opens.map (D_N a).ι.base).obj (D_N c) := by
      have hDN_ι :
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).hom ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (L_vec a) (hL_hom a) zero_lt_one = (D_N a).ι := by
        dsimp only [D_N]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (L_vec a) (hL_hom a) zero_lt_one,
          CategoryTheory.Iso.hom_inv_id_assoc]
        rfl
      have h1 := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_1 (hTb a) zero_lt_one
        (hTb c) zero_lt_one
      have h2 : (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L a)))).base).obj
          (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hTb a) (hTb c))) =
        PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hL_hom a) (hL_hom c)) := by
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen]
        exact congrArg PrimeSpectrum.basicOpen hElem
      have h3 := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N (hL_hom a) zero_lt_one
        (hL_hom c) zero_lt_one
      have hp1 : (TopologicalSpace.Opens.map (π_tilde a).base).obj (D_1 c) =
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).hom.base).obj
            ((TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (L_vec c))) := by
        change (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).hom.base).obj
          ((TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.map Φ_gr (hsub_L a)))).base).obj
            ((TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_1 (MvPolynomial.X a) (hTb a) zero_lt_one).base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_1 (MvPolynomial.X c)))) = _
        rw [h1, h2, ← h3]
      have hp2 :
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).hom.base).obj
            ((TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (L_vec c))) =
          (TopologicalSpace.Opens.map (D_N a).ι.base).obj (D_N c) := by
        change (TopologicalSpace.Opens.map
          ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).hom ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (L_vec a) (hL_hom a) zero_lt_one).base).obj (D_N c) = _
        rw [hDN_ι]
        rfl
      exact hp1.trans hp2
    have hLoc_pre :
        (TopologicalSpace.Opens.map (π_loc a).base).obj (D_1 c) =
        (TopologicalSpace.Opens.map (V_cov a).ι.base).obj (V_cov c) := by
      have hmr : (U_L.ι ∣_ D_N a) ≫ (D_N a).ι = (V_cov a).ι ≫ U_L.ι :=
        AlgebraicGeometry.morphismRestrict_ι U_L.ι (D_N a)
      change (TopologicalSpace.Opens.map (U_L.ι ∣_ D_N a).base).obj
        ((TopologicalSpace.Opens.map (π_tilde a).base).obj (D_1 c)) = _
      rw [hTilde_pre]
      change (TopologicalSpace.Opens.map ((U_L.ι ∣_ D_N a) ≫ (D_N a).ι).base).obj (D_N c) = _
      rw [hmr]
      rfl
    have h_iff := SetLike.ext_iff.mp hLoc_pre u_pt
    change p_L.base x ∈ D_1 c ↔ x ∈ V_cov c
    rw [← hu_val]
    change ((V_cov a).ι ≫ p_L).base u_pt ∈ D_1 c ↔ (V_cov a).ι.base u_pt ∈ V_cov c
    rw [hChart_V a]
    exact h_iff

  
  
  
  let U_good : P_cur.Y.Opens :=
    (TopologicalSpace.Opens.map
      (Φ_N ≫ CategoryTheory.Limits.pullback.snd p_Vcur P_N.hom).base).obj U_L
  have hC₀_good : ∀ c : ↥C₀.left, ι_C₀.base c ∈ U_good := by
    intro c
    change ϕ₀.base c ∈ U_L
    exact hCov_C₀ c

  let Z_bad : Set ↥P_cur.Y := (U_good : Set ↥P_cur.Y)ᶜ
  have hCl_Zbad : IsClosed Z_bad := U_good.isOpen.isClosed_compl
  let F_bad : Set ↥V_cur := P_cur.f_bar.base '' Z_bad
  have hCl_Fbad : IsClosed F_bad := P_cur.f_bar.isClosedMap Z_bad hCl_Zbad

  have hv_not_Fbad : P_cur.v ∉ F_bad := by
    rintro ⟨y, hy_bad, hy_fib⟩
    have hy_eq : P_cur.f_bar.base y = s₀.base pt_k := hy_fib.trans hs₀_pt.symm
    obtain ⟨z_pb, hz_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := P_cur.f_bar) (g := s₀) y pt_k hy_eq
    let c_pt : ↥C₀.left := hPb_C₀.isoPullback.inv.base z_pb
    have hc_eq : ι_C₀.base c_pt = y := by
      change (hPb_C₀.isoPullback.inv ≫ ι_C₀).base z_pb = y
      rw [hPb_C₀.isoPullback_inv_fst]
      exact hz_fst
    exact hy_bad (hc_eq ▸ hC₀_good c_pt)

  let e_V := V_cur.isoSpec
  let A_cat : CommRingCat.{u} := V_cur.presheaf.obj (Opposite.op ⊤)
  let A₀ : Type u := ↑A_cat
  have hNe_top : Nonempty ↥(⊤ : V_cur.Opens) := ⟨⟨P_cur.v, trivial⟩⟩
  haveI : IsDomain A₀ := @AlgebraicGeometry.IsIntegral.component_integral V_cur P_cur.hInt_V ⊤ hNe_top

  let q₀ : PrimeSpectrum A₀ := e_V.hom.base P_cur.v
  let F_spec : Set (PrimeSpectrum A₀) := e_V.inv.base ⁻¹' F_bad
  have hCl_Fspec : IsClosed F_spec := hCl_Fbad.preimage e_V.inv.continuous
  have hq₀_not_Fspec : q₀ ∉ F_spec := by
    change e_V.inv.base (e_V.hom.base P_cur.v) ∉ F_bad
    have hid : e_V.inv.base (e_V.hom.base P_cur.v) = P_cur.v := by
      change (e_V.hom ≫ e_V.inv).base P_cur.v = P_cur.v
      rw [e_V.hom_inv_id]
      rfl
    rwa [hid]
  obtain ⟨S₀_set, hFspec_eq⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus F_spec).mp hCl_Fspec
  have hNotSub_S₀ : ¬ (S₀_set ⊆ q₀.asIdeal) := by
    intro hsub
    apply hq₀_not_Fspec
    rw [hFspec_eq]
    exact hsub
  obtain ⟨h₁, hh₁_S₀, hh₁_not_q₀⟩ := Set.not_subset.mp hNotSub_S₀
  have hh₁_ne : h₁ ≠ 0 := fun h0 => hh₁_not_q₀ (h0 ▸ q₀.asIdeal.zero_mem)

  let φ_k : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_Vcur)
  have hmap_φk : AlgebraicGeometry.Spec.map φ_k = e_V.inv ≫ p_Vcur :=
    AlgebraicGeometry.Spec.map_preimage (e_V.inv ≫ p_Vcur)
  have hFT_φk : RingHom.FiniteType φ_k.hom := by
    rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType),
      hmap_φk]
    infer_instance
  letI : Algebra k A₀ := φ_k.hom.toAlgebra
  haveI : Algebra.FiniteType k A₀ := hFT_φk

  let e_V_inv : AlgebraicGeometry.Spec A_cat ⟶ V_cur := e_V.inv
  let u_Vcur_spec : V_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) k)) :=
    u_Vcur
  let φ_mv : CommRingCat.of (MvPolynomial (Fin δ) k) ⟶ A_cat :=
    AlgebraicGeometry.Spec.preimage (e_V_inv ≫ u_Vcur_spec)
  have hmap_φmv : AlgebraicGeometry.Spec.map φ_mv = e_V_inv ≫ u_Vcur_spec :=
    AlgebraicGeometry.Spec.map_preimage (e_V_inv ≫ u_Vcur_spec)
  have hφmv_C : CommRingCat.ofHom MvPolynomial.C ≫ φ_mv = φ_k := by
    apply AlgebraicGeometry.Spec.map_injective
    have hm1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C ≫ φ_mv) =
        (e_V_inv ≫ u_Vcur_spec) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin δ) k)) := by
      rw [AlgebraicGeometry.Spec.map_comp, hmap_φmv]
    have hm2 : (e_V_inv ≫ u_Vcur_spec) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin δ) k)) =
        e_V.inv ≫ p_Vcur := by
      change (e_V.inv ≫ u_Vcur) ≫ (weilAffineSpaceOver k δ).hom = e_V.inv ≫ p_Vcur
      rw [CategoryTheory.Category.assoc, hu_Vcur]
    exact hm1.trans (hm2.trans hmap_φk.symm)
  let u_A₀ : MvPolynomial (Fin δ) k →ₐ[k] A₀ :=
    { φ_mv.hom with
      commutes' := fun c => congrArg (fun g : CommRingCat.of k ⟶ A_cat => g.hom c) hφmv_C }

  let σ₀_cat : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₀ ≫ e_V.hom)
  have hmap_σ₀ : AlgebraicGeometry.Spec.map σ₀_cat = s₀ ≫ e_V.hom :=
    AlgebraicGeometry.Spec.map_preimage (s₀ ≫ e_V.hom)
  have hφ_σ_id : φ_k ≫ σ₀_cat = 𝟙 (CommRingCat.of k) := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, hmap_σ₀, hmap_φk, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id, CategoryTheory.Category.id_comp,
      hs₀_sec, AlgebraicGeometry.Spec.map_id]
  have hcomap_pt : (AlgebraicGeometry.Spec.map σ₀_cat).base pt_k = q₀ := by
    rw [hmap_σ₀]
    change e_V.hom.base (s₀.base pt_k) = q₀
    rw [hs₀_pt]
  have hσ₀_h₁_ne : σ₀_cat.hom h₁ ≠ 0 := by
    intro h0
    apply hh₁_not_q₀
    rw [← hcomap_pt]
    change h₁ ∈ Ideal.comap σ₀_cat.hom pt_k.asIdeal
    rw [Ideal.mem_comap]
    exact h0
  have hh₁_unit : IsUnit (σ₀_cat.hom h₁) := Ne.isUnit hσ₀_h₁_ne

  let R₁ : Type u := Localization.Away h₁
  have hSub_nzd : Submonoid.powers h₁ ≤ nonZeroDivisors A₀ :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hh₁_ne)
  haveI : IsDomain R₁ := IsLocalization.isDomain_of_le_nonZeroDivisors R₁ hSub_nzd
  haveI : Algebra.FinitePresentation A₀ R₁ := IsLocalization.Away.finitePresentation h₁
  haveI : Algebra.FiniteType k R₁ := Algebra.FiniteType.trans ‹_› inferInstance

  let σ₁_ring : R₁ →+* k := IsLocalization.Away.lift h₁ hh₁_unit
  have hσ₁_comm : ∀ c : k, σ₁_ring (algebraMap k R₁ c) = algebraMap k k c := by
    intro c
    change IsLocalization.Away.lift h₁ hh₁_unit (algebraMap k R₁ c) = c
    rw [IsScalarTower.algebraMap_apply k A₀ R₁, IsLocalization.Away.lift_eq]
    exact congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφ_σ_id
  let σ₁ : R₁ →ₐ[k] k := { σ₁_ring with commutes' := hσ₁_comm }
  let u_R₁ : MvPolynomial (Fin δ) k →ₐ[k] R₁ := (IsScalarTower.toAlgHom k A₀ R₁).comp u_A₀

  let map_loc : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ AlgebraicGeometry.Spec A_cat :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ R₁))
  haveI : AlgebraicGeometry.IsOpenImmersion map_loc :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization h₁
  let j_V₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ V_cur := map_loc ≫ e_V.inv
  haveI : AlgebraicGeometry.IsOpenImmersion j_V₁ := by
    dsimp [j_V₁]
    infer_instance

  have hj_V₁_k : j_V₁ ≫ p_Vcur =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₁)) := by
    dsimp [j_V₁, map_loc]
    rw [CategoryTheory.Category.assoc, ← hmap_φk, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
  have hσ₁_s₀ :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.toRingHom) ≫ j_V₁ = s₀ := by
    dsimp [j_V₁, map_loc]
    have hcomp_σ :
        CommRingCat.ofHom (algebraMap A₀ R₁) ≫ CommRingCat.ofHom σ₁.toRingHom = σ₀_cat := by
      ext a
      exact IsLocalization.Away.lift_eq h₁ hh₁_unit a
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    exact (congrArg (fun g => AlgebraicGeometry.Spec.map g ≫ e_V.inv) hcomp_σ).trans
      (by rw [hmap_σ₀, CategoryTheory.Category.assoc, e_V.hom_inv_id, CategoryTheory.Category.comp_id])
  have hj_V₁_u : j_V₁ ≫ (g_V_sch ≫ E.u_V₁) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom u_R₁.toRingHom) := by
    have hm1 : map_loc ≫ (e_V_inv ≫ u_Vcur_spec) =
        AlgebraicGeometry.Spec.map (φ_mv ≫ CommRingCat.ofHom (algebraMap A₀ R₁)) := by
      dsimp only [map_loc]
      rw [← hmap_φmv, ← AlgebraicGeometry.Spec.map_comp]
    exact (CategoryTheory.Category.assoc map_loc e_V.inv u_Vcur).trans hm1
  have hu_R₁_et : RingHom.Etale u_R₁.toRingHom := by
    have hEt_spec_u : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom u_R₁.toRingHom)) := by
      rw [← hj_V₁_u]
      change AlgebraicGeometry.Etale (j_V₁ ≫ u_Vcur)
      infer_instance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      hEt_spec_u

  let Y_R₁ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback P_cur.f_bar j_V₁
  let j_YR₁ : Y_R₁ ⟶ P_cur.Y := CategoryTheory.Limits.pullback.fst P_cur.f_bar j_V₁
  let f_YR₁ : Y_R₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
    CategoryTheory.Limits.pullback.snd P_cur.f_bar j_V₁
  have hPb_YR₁ : CategoryTheory.IsPullback j_YR₁ f_YR₁ P_cur.f_bar j_V₁ :=
    CategoryTheory.IsPullback.of_hasPullback P_cur.f_bar j_V₁
  haveI : AlgebraicGeometry.IsOpenImmersion j_YR₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_YR₁.flip inferInstance
  haveI : AlgebraicGeometry.IsProper f_YR₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_YR₁ P_cur.hProp_f

  let ι_C₀_R₁ : C₀.left ⟶ Y_R₁ :=
    CategoryTheory.Limits.pullback.lift ι_C₀
      (C₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.toRingHom))
      (by rw [CategoryTheory.Category.assoc, hσ₁_s₀]; exact hPb_C₀.w)
  have hι_C₀_j : ι_C₀_R₁ ≫ j_YR₁ = ι_C₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hι_C₀_f : ι_C₀_R₁ ≫ f_YR₁ =
      C₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.toRingHom) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_C₀_R₁ : CategoryTheory.IsPullback ι_C₀_R₁ C₀.hom f_YR₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.toRingHom)) :=
    CategoryTheory.IsPullback.of_right
      (by rw [hι_C₀_j, hσ₁_s₀]; exact hPb_C₀)
      hι_C₀_f hPb_YR₁

  have hGood_YR₁ : ∀ y : ↥Y_R₁, j_YR₁.base y ∈ U_good := by
    intro y
    by_contra hy_not
    let q_pt : PrimeSpectrum R₁ := f_YR₁.base y
    let p_pt : PrimeSpectrum A₀ := map_loc.base q_pt
    have hp_not_Fspec : p_pt ∉ F_spec := by
      rw [hFspec_eq]
      intro hsub
      have hh₁_p : h₁ ∈ p_pt.asIdeal := hsub hh₁_S₀
      have hh₁_q : algebraMap A₀ R₁ h₁ ∈ q_pt.asIdeal := hh₁_p
      exact q_pt.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem q_pt.asIdeal hh₁_q
          (IsLocalization.Away.algebraMap_isUnit h₁))
    apply hp_not_Fspec
    change e_V.inv.base (map_loc.base (f_YR₁.base y)) ∈ F_bad
    have hfib_eq : e_V.inv.base (map_loc.base (f_YR₁.base y)) = P_cur.f_bar.base (j_YR₁.base y) := by
      change (f_YR₁ ≫ j_V₁).base y = (j_YR₁ ≫ P_cur.f_bar).base y
      rw [hPb_YR₁.w]
    rw [hfib_eq]
    exact ⟨j_YR₁.base y, hy_not, rfl⟩

  
  
  
  let s_R₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ S_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₁))

  let q_PN : CategoryTheory.Limits.pullback s_R₁ P_N.hom ⟶
      CategoryTheory.Limits.pullback p_Vcur P_N.hom :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst s_R₁ P_N.hom ≫ j_V₁)
      (CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom)
      (by rw [CategoryTheory.Category.assoc, hj_V₁_k]; exact CategoryTheory.Limits.pullback.condition)
  have hq_PN_fst : q_PN ≫ CategoryTheory.Limits.pullback.fst p_Vcur P_N.hom =
      CategoryTheory.Limits.pullback.fst s_R₁ P_N.hom ≫ j_V₁ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_PN_snd : q_PN ≫ CategoryTheory.Limits.pullback.snd p_Vcur P_N.hom =
      CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_qPN : CategoryTheory.IsPullback q_PN
      (CategoryTheory.Limits.pullback.fst s_R₁ P_N.hom)
      (CategoryTheory.Limits.pullback.fst p_Vcur P_N.hom) j_V₁ :=
    CategoryTheory.IsPullback.of_right
      (by
        rw [hq_PN_snd, hj_V₁_k]
        exact (CategoryTheory.IsPullback.of_hasPullback s_R₁ P_N.hom).flip)
      hq_PN_fst
      (CategoryTheory.IsPullback.of_hasPullback p_Vcur P_N.hom).flip

  let Φ_R₁ : Y_R₁ ⟶ CategoryTheory.Limits.pullback s_R₁ P_N.hom :=
    hPb_qPN.lift (j_YR₁ ≫ Φ_N) f_YR₁
      (by rw [CategoryTheory.Category.assoc, hΦN_fst]; exact hPb_YR₁.w)
  have hΦ_R₁_q : Φ_R₁ ≫ q_PN = j_YR₁ ≫ Φ_N := hPb_qPN.lift_fst _ _ _
  have hΦ_R₁_fst : Φ_R₁ ≫ CategoryTheory.Limits.pullback.fst s_R₁ P_N.hom = f_YR₁ :=
    hPb_qPN.lift_snd _ _ _
  have hΦ_R₁_snd : Φ_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom =
      j_YR₁ ≫ Φ_N ≫ CategoryTheory.Limits.pullback.snd p_Vcur P_N.hom := by
    rw [← hq_PN_snd, ← CategoryTheory.Category.assoc, hΦ_R₁_q, CategoryTheory.Category.assoc]
  have hPb_ΦR₁ : CategoryTheory.IsPullback j_YR₁ Φ_R₁ Φ_N q_PN :=
    CategoryTheory.IsPullback.of_bot
      (by rw [hΦ_R₁_fst, hΦN_fst]; exact hPb_YR₁)
      hΦ_R₁_q.symm hPb_qPN
  haveI : AlgebraicGeometry.IsFinite Φ_R₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ΦR₁ inferInstance

  have hRange_UL :
      Set.range (Φ_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom).base ⊆
        Set.range U_L.ι.base := by
    rw [U_L.range_ι]
    rintro _ ⟨y, rfl⟩
    rw [hΦ_R₁_snd]
    exact hGood_YR₁ y
  let q_UL : Y_R₁ ⟶ U_L.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_L.ι
      (Φ_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom) hRange_UL
  have hq_UL_fac : q_UL ≫ U_L.ι = Φ_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_L.ι _ hRange_UL

  have hcomm_πR₁ : f_YR₁ ≫ s_R₁ = (q_UL ≫ p_L) ≫ P_1.hom := by
    calc
      f_YR₁ ≫ s_R₁
        = (Φ_R₁ ≫ CategoryTheory.Limits.pullback.fst s_R₁ P_N.hom) ≫ s_R₁ := by rw [hΦ_R₁_fst]
      _ = Φ_R₁ ≫ (CategoryTheory.Limits.pullback.fst s_R₁ P_N.hom ≫ s_R₁) :=
          CategoryTheory.Category.assoc _ _ _
      _ = Φ_R₁ ≫ (CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom ≫ P_N.hom) := by
          rw [CategoryTheory.Limits.pullback.condition]
      _ = (Φ_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom) ≫ P_N.hom :=
          (CategoryTheory.Category.assoc _ _ _).symm
      _ = (q_UL ≫ U_L.ι) ≫ P_N.hom := by rw [hq_UL_fac]
      _ = q_UL ≫ (U_L.ι ≫ P_N.hom) := CategoryTheory.Category.assoc _ _ _
      _ = q_UL ≫ (p_L ≫ P_1.hom) := by rw [hp_L_hom]
      _ = (q_UL ≫ p_L) ≫ P_1.hom := (CategoryTheory.Category.assoc _ _ _).symm

  let π_R₁ : Y_R₁ ⟶ CategoryTheory.Limits.pullback s_R₁ P_1.hom :=
    CategoryTheory.Limits.pullback.lift f_YR₁ (q_UL ≫ p_L) hcomm_πR₁
  have hπ_R₁_fst : π_R₁ ≫ CategoryTheory.Limits.pullback.fst s_R₁ P_1.hom = f_YR₁ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ_R₁_snd : π_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_1.hom = q_UL ≫ p_L :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hSep_P1 : AlgebraicGeometry.IsSeparated P_1.hom := by
    have : IsScalarTower k ↥(𝒜_1 0) (MvPolynomial (Fin 2) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin 2) k) p⟩
    have : Algebra.FiniteType ↥(𝒜_1 0) (MvPolynomial (Fin 2) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜_1 0) (MvPolynomial (Fin 2) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜_1 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin 2) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_1 0)))) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ hSurj0
    dsimp only [P_1, weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
    infer_instance
  have hSep_fst1 : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.pullback.fst s_R₁ P_1.hom) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback s_R₁ P_1.hom).flip hSep_P1
  have hProp_comp_π : AlgebraicGeometry.IsProper
      (π_R₁ ≫ CategoryTheory.Limits.pullback.fst s_R₁ P_1.hom) := by
    rw [hπ_R₁_fst]
    infer_instance
  have hProp_πR₁ : AlgebraicGeometry.IsProper π_R₁ :=
    @AlgebraicGeometry.IsProper.of_comp _ _ _ π_R₁
      (CategoryTheory.Limits.pullback.fst s_R₁ P_1.hom) hProp_comp_π hSep_fst1

  haveI : AlgebraicGeometry.IsAffineHom (CategoryTheory.Limits.pullback.snd s_R₁ P_1.hom) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback s_R₁ P_1.hom) inferInstance
  haveI : AlgebraicGeometry.IsAffineHom (CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback s_R₁ P_N.hom) inferInstance

  have hCov_P1 : ∀ y : P_1.left, ∃ b : Fin 2, y ∈ D_1 b := by
    intro y
    by_contra! hAll
    apply (y : ProjectiveSpectrum 𝒜_1).not_irrelevant_le
    rw [HomogeneousIdeal.irrelevant_le]
    intro d hd p hp
    have hp_hom : p.IsHomogeneous d := hp
    rw [MvPolynomial.as_sum p]
    apply (y : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal.toIdeal.sum_mem
    intro s hs
    have hs_deg : (∑ b : Fin 2, s b) = d := by
      simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using
        hp_hom (MvPolynomial.mem_support_iff.mp hs)
    have ⟨b₀, hb₀⟩ : ∃ b₀ : Fin 2, 1 ≤ s b₀ := by
      by_contra! hZero
      have hsum0 : (∑ b : Fin 2, s b) = 0 :=
        Finset.sum_eq_zero (fun b _ => Nat.lt_one_iff.mp (hZero b))
      omega
    have hXb₀ : (MvPolynomial.X b₀ : MvPolynomial (Fin 2) k) ∈
        (y : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal.toIdeal := by
      have hnot := hAll b₀
      have hm := @AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜_1 _
        (MvPolynomial.X b₀) (y : ↥(AlgebraicGeometry.Proj 𝒜_1))
      exact not_not.mp (mt hm.mpr hnot)
    rw [MvPolynomial.monomial_eq, Finsupp.prod_of_support_subset _ (Finset.subset_univ _)
      _ (fun _ _ => pow_zero _)]
    apply (y : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal.toIdeal.mul_mem_left
    obtain ⟨r_exp, hr_exp⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s b₀ ≠ 0)
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ b₀), hr_exp, pow_succ']
    exact (y : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal.toIdeal.mul_mem_right _
      ((y : ProjectiveSpectrum 𝒜_1).asHomogeneousIdeal.toIdeal.mul_mem_right _ hXb₀)

  have hAff_πR₁ : AlgebraicGeometry.IsAffineHom π_R₁ := by
    apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
    intro z
    obtain ⟨b, hyb⟩ := hCov_P1 ((CategoryTheory.Limits.pullback.snd s_R₁ P_1.hom).base z)
    let W_b := (TopologicalSpace.Opens.map
      (CategoryTheory.Limits.pullback.snd s_R₁ P_1.hom).base).obj (D_1 b)
    let E_b := (TopologicalSpace.Opens.map
      (CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom).base).obj (D_N b)
    have hAff_D1 : AlgebraicGeometry.IsAffineOpen (D_1 b) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_1 (MvPolynomial.X b) (hTb b) zero_lt_one
    have hAff_DN : AlgebraicGeometry.IsAffineOpen (D_N b) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (L_vec b) (hL_hom b) zero_lt_one
    have hAff_Wb : AlgebraicGeometry.IsAffineOpen W_b :=
      hAff_D1.preimage (CategoryTheory.Limits.pullback.snd s_R₁ P_1.hom)
    have hAff_Eb : AlgebraicGeometry.IsAffineOpen E_b :=
      hAff_DN.preimage (CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom)
    have hPre_eq :
        (TopologicalSpace.Opens.map π_R₁.base).obj W_b =
        (TopologicalSpace.Opens.map Φ_R₁.base).obj E_b := by
      ext w
      change (π_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_1.hom).base w ∈ D_1 b ↔
        (Φ_R₁ ≫ CategoryTheory.Limits.pullback.snd s_R₁ P_N.hom).base w ∈ D_N b
      rw [hπ_R₁_snd, ← hq_UL_fac]
      change q_UL.base w ∈ (TopologicalSpace.Opens.map p_L.base).obj (D_1 b) ↔
        q_UL.base w ∈ V_cov b
      rw [hPre_pL b]
    refine ⟨W_b, hyb, hAff_Wb, ?_⟩
    rw [hPre_eq]
    exact hAff_Eb.preimage Φ_R₁

  have hFin_πR₁ : AlgebraicGeometry.IsFinite π_R₁ :=
    AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_πR₁, hAff_πR₁⟩

  exact ⟨R₁, inferInstance, inferInstance, inferInstance, inferInstance,
    σ₁, u_R₁, j_V₁, Y_R₁, j_YR₁, f_YR₁, ι_C₀_R₁, π_R₁,
    hu_R₁_et, inferInstance, inferInstance, hFin_πR₁,
    hσ₁_s₀, hj_V₁_u, hPb_YR₁, hι_C₀_j, hPb_C₀_R₁, hπ_R₁_fst⟩

theorem weil_torsion_pullback_surj_and_closedImmersion_twoChart_cover : (∀ {Y₀ Y : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₀ Y) (m q : ℕ),
      WeilEtaleCohomologyPullbackSurjective h (weilEtaleTorsionSheaf Y m) q →
      ∀ (p_h : weilEtaleTorsionH Y m q →+ weilEtaleTorsionH Y₀ m q),
        WeilIsTorsionEtalePullback h m q p_h →
        Function.Surjective p_h) ∧
    (∀ {Y C : AlgebraicGeometry.Scheme.{u}} (i_YC : Quiver.Hom Y C)
        [AlgebraicGeometry.IsClosedImmersion i_YC]
        (R₀ R₁ R₀₁ : Type u) [CommRing R₀] [CommRing R₁] [CommRing R₀₁]
        [Algebra R₀ R₀₁] [Algebra R₁ R₀₁]
        (j₀_C : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ C)
        [AlgebraicGeometry.IsOpenImmersion j₀_C]
        (j₁_C : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ C)
        [AlgebraicGeometry.IsOpenImmersion j₁_C],
      Set.range j₀_C.base ∪ Set.range j₁_C.base = Set.univ →
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₀₁)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ R₀₁)))
        j₀_C j₁_C →
      ∃ (V₀ V₁ : Y.Opens)
        (hV₀ : AlgebraicGeometry.IsAffineOpen V₀)
        (hV₁ : AlgebraicGeometry.IsAffineOpen V₁)
        (_ : AlgebraicGeometry.IsAffineOpen (V₀ ⊓ V₁)),
        V₀ ⊔ V₁ = ⊤ ∧
        Set.range hV₀.fromSpec.base ∪ Set.range hV₁.fromSpec.base = Set.univ ∧
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op))
          (AlgebraicGeometry.Spec.map
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op))
          hV₀.fromSpec hV₁.fromSpec) :=
by
  constructor
  · intro Y₀ Y h m q hSurj p_h hp_h
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor Y.Etale Y₀.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let J₁ := Y₀.smallEtaleTopology
    let J₂ := Y.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    rcases hp_h with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπℤ, hπιℤ, hp_eq⟩
    rcases hSurj with ⟨_, _, _, _, _, hcℤ, hSurjFn⟩
    have : B.IsContinuous J₂ J₁ := hCont
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    have : P_push.IsRightAdjoint := hAdj
    let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    have : P_pull.Additive := hAdd
    have : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
    have : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    let wℤ : C₂.obj Aℤ ⟶ P_push.obj (C₁.obj Aℤ) :=
      (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
        (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op)
    let πℤ : P_pull.obj (C₂.obj Aℤ) ⟶ C₁.obj Aℤ :=
      (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm wℤ
    let πM : P_pull.obj (C₂.obj AM) ⟶ C₁.obj AM :=
      (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
        ((adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
          (adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op))
    let Pℤ_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
    let Pℤ_Y₀ := (CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj Aℤ
    let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let η₀ := CategoryTheory.Functor.whiskerLeft B.op (shAdj₁.unit.app Pℤ_Y₀)
    let uℤ : C₂.obj Aℤ ⟶ P_push.obj (C₁.obj Aℤ) :=
      (shAdj₂.homEquiv Pℤ_Y (P_push.obj (C₁.obj Aℤ))).symm η₀
    let cℤ : P_pull.obj (C₂.obj Aℤ) ⟶ C₁.obj Aℤ :=
      (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm uℤ
    have hUnit₁ : adj₁.unit.app Aℤ = (shAdj₁.unit.app Pℤ_Y₀).app (Opposite.op T₁) := by
      dsimp [adj₁, shAdj₁, Pℤ_Y₀, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp]
      exact CategoryTheory.Category.id_comp _
    have hUnit₂ : adj₂.unit.app Aℤ = (shAdj₂.unit.app Pℤ_Y).app (Opposite.op T₂) := by
      dsimp [adj₂, shAdj₂, Pℤ_Y, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp]
      exact CategoryTheory.Category.id_comp _
    have hwℤ_T₂ :
        (shAdj₂.unit.app Pℤ_Y).app (Opposite.op T₂) ≫ wℤ.hom.app (Opposite.op T₂) =
          (shAdj₁.unit.app Pℤ_Y₀).app (Opposite.op T₁) ≫ (C₁.obj Aℤ).obj.map τ.op := by
      rw [← hUnit₂, ← hUnit₁]
      exact (adj₂.homEquiv_unit Aℤ (P_push.obj (C₁.obj Aℤ)) wℤ).symm.trans
        (Equiv.apply_symm_apply (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ)))
          (adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ.op))
    have h_sh : shAdj₂.homEquiv Pℤ_Y (P_push.obj (C₁.obj Aℤ)) wℤ = η₀ := by
      refine (shAdj₂.homEquiv_unit Pℤ_Y (P_push.obj (C₁.obj Aℤ)) wℤ).trans ?_
      refine CategoryTheory.NatTrans.ext (funext fun V => ?_)
      let v : V.unop ⟶ T₂ := hT₂.from V.unop
      have hnat₂ : (shAdj₂.unit.app Pℤ_Y).app V =
          (shAdj₂.unit.app Pℤ_Y).app (Opposite.op T₂) ≫ (C₂.obj Aℤ).obj.map v.op := by
        have hn := (shAdj₂.unit.app Pℤ_Y).naturality v.op
        dsimp [Pℤ_Y] at hn
        rw [CategoryTheory.Category.id_comp] at hn
        exact hn
      have hnat₁ : (shAdj₁.unit.app Pℤ_Y₀).app (Opposite.op (B.obj V.unop)) =
          (shAdj₁.unit.app Pℤ_Y₀).app (Opposite.op T₁) ≫
            (C₁.obj Aℤ).obj.map (B.map v ≫ τ).op := by
        have hn := (shAdj₁.unit.app Pℤ_Y₀).naturality (B.map v ≫ τ).op
        dsimp [Pℤ_Y₀] at hn
        rw [CategoryTheory.Category.id_comp] at hn
        exact hn
      have hwℤ_nat : (C₂.obj Aℤ).obj.map v.op ≫ wℤ.hom.app V =
          wℤ.hom.app (Opposite.op T₂) ≫ (C₁.obj Aℤ).obj.map (B.map v).op :=
        wℤ.hom.naturality v.op
      have hmap_comp : (C₁.obj Aℤ).obj.map τ.op ≫ (C₁.obj Aℤ).obj.map (B.map v).op =
          (C₁.obj Aℤ).obj.map (B.map v ≫ τ).op :=
        ((C₁.obj Aℤ).obj.map_comp τ.op (B.map v).op).symm
      exact (congrArg (· ≫ wℤ.hom.app V) hnat₂).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg _ hwℤ_nat).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ (C₁.obj Aℤ).obj.map (B.map v).op) hwℤ_T₂).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg _ hmap_comp).trans hnat₁.symm))))))
    have huw : uℤ = wℤ := by
      dsimp only [uℤ]
      rw [← h_sh]
      exact (shAdj₂.homEquiv Pℤ_Y (P_push.obj (C₁.obj Aℤ))).symm_apply_apply wℤ
    have hcπ : cℤ = πℤ := congrArg (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm huw
    have hinv_cℤ : @CategoryTheory.inv _ _ _ _ cℤ hcℤ = ιℤ := by
      have hcι : cℤ ≫ ιℤ = 𝟙 _ := hcπ ▸ hπιℤ
      calc
        @CategoryTheory.inv _ _ _ _ cℤ hcℤ
          = @CategoryTheory.inv _ _ _ _ cℤ hcℤ ≫ 𝟙 _ := (CategoryTheory.Category.comp_id _).symm
        _ = @CategoryTheory.inv _ _ _ _ cℤ hcℤ ≫ (cℤ ≫ ιℤ) := by rw [hcι]
        _ = (@CategoryTheory.inv _ _ _ _ cℤ hcℤ ≫ cℤ) ≫ ιℤ :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = 𝟙 _ ≫ ιℤ := by rw [@CategoryTheory.IsIso.inv_hom_id _ _ _ _ cℤ hcℤ]
        _ = ιℤ := CategoryTheory.Category.id_comp _
    have hBT₂ : CategoryTheory.Limits.IsTerminal (B.obj T₂) := by
      have : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
        (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
      have hB_forget : B ⋙ AlgebraicGeometry.Scheme.Etale.forget Y₀ =
          AlgebraicGeometry.Scheme.Etale.forget Y ⋙ CategoryTheory.Over.pullback h := rfl
      have hF_lim : CategoryTheory.Limits.PreservesFiniteLimits
          (AlgebraicGeometry.Scheme.Etale.forget Y ⋙ CategoryTheory.Over.pullback h) := inferInstance
      have : CategoryTheory.Limits.PreservesFiniteLimits
          (B ⋙ AlgebraicGeometry.Scheme.Etale.forget Y₀) := hB_forget ▸ hF_lim
      have : CategoryTheory.Limits.PreservesFiniteLimits B :=
        CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B
          (AlgebraicGeometry.Scheme.Etale.forget Y₀)
      exact CategoryTheory.Limits.IsTerminal.isTerminalObj B T₂ hT₂
    let τ_iso : B.obj T₂ ≅ T₁ :=
      { hom := τ
        inv := hBT₂.from T₁
        hom_inv_id := hBT₂.hom_ext _ _
        inv_hom_id := hT₁.hom_ext _ _ }
    let Γ₁ := (CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁)
    let Γ₂ := P_push ⋙ (CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj (Opposite.op T₂)
    let θ_τ : Γ₁ ≅ Γ₂ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          { hom := ℱ.obj.map τ_iso.hom.op
            inv := ℱ.obj.map τ_iso.inv.op
            hom_inv_id := by
              change ℱ.obj.map τ_iso.hom.op ≫ ℱ.obj.map τ_iso.inv.op =
                𝟙 (ℱ.obj.obj (Opposite.op T₁))
              rw [← ℱ.obj.map_comp, ← op_comp, τ_iso.inv_hom_id, op_id, ℱ.obj.map_id]
            inv_hom_id := by
              change ℱ.obj.map τ_iso.inv.op ≫ ℱ.obj.map τ_iso.hom.op =
                𝟙 (ℱ.obj.obj (Opposite.op (B.obj T₂)))
              rw [← ℱ.obj.map_comp, ← op_comp, τ_iso.hom_inv_id, op_id, ℱ.obj.map_id] })
        (fun {ℱ 𝒢} f => (f.hom.naturality τ_iso.hom.op).symm)
    let adj_comp := adj₂.comp adj_pull
    let adj₁' := adj₁.ofNatIsoRight θ_τ
    let α_iso : (C₂ ⋙ P_pull) ≅ C₁ := CategoryTheory.Adjunction.leftAdjointUniq adj_comp adj₁'
    have hα_πM : α_iso.hom.app AM = πM := by
      apply (adj_comp.homEquiv AM (C₁.obj AM)).injective
      have h1 : adj_comp.homEquiv AM (C₁.obj AM) (α_iso.hom.app AM) = adj₁'.unit.app AM :=
        CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app adj_comp adj₁' AM
      have h2 : adj₁'.unit.app AM = adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op := rfl
      have h3 : adj_comp.homEquiv AM (C₁.obj AM) πM =
          adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op :=
        (congrArg (fun k => k AM (C₁.obj AM) πM)
          (CategoryTheory.Adjunction.comp_homEquiv adj₂ adj_pull)).trans
          ((congrArg (adj₂.homEquiv AM (P_push.obj (C₁.obj AM)))
            ((adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).apply_symm_apply _)).trans
            ((adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).apply_symm_apply _))
      exact (h1.trans h2).trans h3.symm
    let ιM : C₁.obj AM ⟶ P_pull.obj (C₂.obj AM) := α_iso.inv.app AM
    have hιπM : ιM ≫ πM = 𝟙 (C₁.obj AM) := by
      rw [← hα_πM]
      exact α_iso.inv_hom_id_app AM
    intro z
    obtain ⟨x, hx⟩ := hSurjFn (z.comp (CategoryTheory.Abelian.Ext.mk₀ ιM) (Nat.add_zero q))
    refine ⟨x, ?_⟩
    rw [hp_eq x]
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) q) x) (Nat.zero_add q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero q)) = z
    have hx' : (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) q) x) (Nat.zero_add q) =
        z.comp (CategoryTheory.Abelian.Ext.mk₀ ιM) (Nat.add_zero q) := by
      rw [← hinv_cℤ]
      exact hx
    rw [hx', CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hιπM,
      CategoryTheory.Abelian.Ext.comp_mk₀_id]
  · intro Y C i_YC _ R₀ R₁ R₀₁ _ _ _ _ _ j₀_C _ j₁_C _ hCov_C hPb_C
    let U₀_C : C.Opens := j₀_C.opensRange
    let U₁_C : C.Opens := j₁_C.opensRange
    have hU₀_C : AlgebraicGeometry.IsAffineOpen U₀_C :=
      AlgebraicGeometry.isAffineOpen_opensRange j₀_C
    have hU₁_C : AlgebraicGeometry.IsAffineOpen U₁_C :=
      AlgebraicGeometry.isAffineOpen_opensRange j₁_C
    let f₀₁ : AlgebraicGeometry.Spec (CommRingCat.of R₀₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₀₁))
    let g₀₁ : AlgebraicGeometry.Spec (CommRingCat.of R₀₁) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₁) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ R₀₁))
    have : AlgebraicGeometry.IsOpenImmersion f₀₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb_C.flip inferInstance
    let j₀₁_C : AlgebraicGeometry.Spec (CommRingCat.of R₀₁) ⟶ C := f₀₁ ≫ j₀_C
    have hU₀₁_range_aff : AlgebraicGeometry.IsAffineOpen j₀₁_C.opensRange :=
      AlgebraicGeometry.isAffineOpen_opensRange j₀₁_C
    have hU₀₁_eq : j₀₁_C.opensRange = U₀_C ⊓ U₁_C := by
      apply SetLike.ext'
      change (j₀₁_C.opensRange : Set ↥C) = (U₀_C : Set ↥C) ∩ (U₁_C : Set ↥C)
      rw [AlgebraicGeometry.Scheme.Hom.coe_opensRange,
        AlgebraicGeometry.Scheme.Hom.coe_opensRange,
        AlgebraicGeometry.Scheme.Hom.coe_opensRange]
      ext c
      simp only [Set.mem_range, Set.mem_inter_iff]
      constructor
      · rintro ⟨z, rfl⟩
        refine ⟨⟨f₀₁ z, rfl⟩, ⟨g₀₁ z, ?_⟩⟩
        change (g₀₁ ≫ j₁_C) z = (f₀₁ ≫ j₀_C) z
        rw [hPb_C.w]
      · rintro ⟨⟨x₀, rfl⟩, ⟨x₁, hx₁⟩⟩
        obtain ⟨w, hw_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x₀ x₁ hx₁.symm
        let z : ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀₁)) := hPb_C.isoPullback.inv w
        refine ⟨z, ?_⟩
        have hf₀₁_z : f₀₁ z = x₀ := by
          have heq : hPb_C.isoPullback.inv ≫ f₀₁ =
              CategoryTheory.Limits.pullback.fst j₀_C j₁_C :=
            (congrArg (hPb_C.isoPullback.inv ≫ ·) hPb_C.isoPullback_hom_fst.symm).trans
              (CategoryTheory.Iso.inv_hom_id_assoc hPb_C.isoPullback _)
          change (hPb_C.isoPullback.inv ≫ f₀₁) w = x₀
          rw [heq]
          exact hw_fst
        change j₀_C (f₀₁ z) = j₀_C x₀
        rw [hf₀₁_z]
    have hU₀₁_C : AlgebraicGeometry.IsAffineOpen (U₀_C ⊓ U₁_C) := hU₀₁_eq ▸ hU₀₁_range_aff
    let V₀ : Y.Opens := (TopologicalSpace.Opens.map i_YC.base).obj U₀_C
    let V₁ : Y.Opens := (TopologicalSpace.Opens.map i_YC.base).obj U₁_C
    have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hU₀_C.preimage i_YC
    have hV₁ : AlgebraicGeometry.IsAffineOpen V₁ := hU₁_C.preimage i_YC
    have hV₀₁ : AlgebraicGeometry.IsAffineOpen (V₀ ⊓ V₁) := hU₀₁_C.preimage i_YC
    have hSup : V₀ ⊔ V₁ = ⊤ := by
      ext y
      change i_YC.base y ∈ (U₀_C : Set ↥C) ∨ i_YC.base y ∈ (U₁_C : Set ↥C) ↔ True
      rw [AlgebraicGeometry.Scheme.Hom.coe_opensRange,
        AlgebraicGeometry.Scheme.Hom.coe_opensRange, ← Set.mem_union, hCov_C]
      exact iff_of_true trivial trivial
    have hRange : Set.range hV₀.fromSpec.base ∪ Set.range hV₁.fromSpec.base = Set.univ := by
      rw [hV₀.range_fromSpec, hV₁.range_fromSpec]
      change ((V₀ ⊔ V₁ : Y.Opens) : Set ↥Y) = Set.univ
      rw [hSup]
      rfl
    let fst := AlgebraicGeometry.Spec.map
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op)
    let snd := AlgebraicGeometry.Spec.map
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op)
    have h_left : fst ≫ hV₀.fromSpec = hV₀₁.fromSpec :=
      hV₀.map_fromSpec hV₀₁ (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op
    have h_right : snd ≫ hV₁.fromSpec = hV₀₁.fromSpec :=
      hV₁.map_fromSpec hV₀₁ (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op
    have h_comm : fst ≫ hV₀.fromSpec = snd ≫ hV₁.fromSpec := h_left.trans h_right.symm
    have hrange_cone :
        ∀ s : CategoryTheory.Limits.PullbackCone hV₀.fromSpec hV₁.fromSpec,
          Set.range ⇑(s.fst ≫ hV₀.fromSpec) ⊆ Set.range ⇑hV₀₁.fromSpec := by
      rintro s _ ⟨t, rfl⟩
      rw [hV₀₁.range_fromSpec]
      have hm₀ : (s.fst ≫ hV₀.fromSpec) t ∈ (V₀ : Set ↥Y) := by
        rw [← hV₀.range_fromSpec]
        exact ⟨s.fst t, rfl⟩
      have hm₁ : (s.fst ≫ hV₀.fromSpec) t ∈ (V₁ : Set ↥Y) := by
        rw [s.condition, ← hV₁.range_fromSpec]
        exact ⟨s.snd t, rfl⟩
      exact ⟨hm₀, hm₁⟩
    have hPb_Y : CategoryTheory.IsPullback fst snd hV₀.fromSpec hV₁.fromSpec :=
      CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk h_comm
          (fun s => AlgebraicGeometry.IsOpenImmersion.lift hV₀₁.fromSpec
            (s.fst ≫ hV₀.fromSpec) (hrange_cone s))
          (fun s => (cancel_mono hV₀.fromSpec).mp
            ((CategoryTheory.Category.assoc _ fst hV₀.fromSpec).trans
              ((congrArg (_ ≫ ·) h_left).trans
                (AlgebraicGeometry.IsOpenImmersion.lift_fac hV₀₁.fromSpec
                  (s.fst ≫ hV₀.fromSpec) (hrange_cone s)))))
          (fun s => (cancel_mono hV₁.fromSpec).mp
            ((CategoryTheory.Category.assoc _ snd hV₁.fromSpec).trans
              ((congrArg (_ ≫ ·) h_right).trans
                ((AlgebraicGeometry.IsOpenImmersion.lift_fac hV₀₁.fromSpec
                  (s.fst ≫ hV₀.fromSpec) (hrange_cone s)).trans s.condition))))
          (fun s m hm₁ _ => (cancel_mono hV₀₁.fromSpec).mp
            ((congrArg (m ≫ ·) h_left.symm).trans
              ((CategoryTheory.Category.assoc m fst hV₀.fromSpec).symm.trans
                ((congrArg (· ≫ hV₀.fromSpec) hm₁).trans
                  (AlgebraicGeometry.IsOpenImmersion.lift_fac hV₀₁.fromSpec
                    (s.fst ≫ hV₀.fromSpec) (hrange_cone s)).symm)))))
    exact ⟨V₀, V₁, hV₀, hV₁, hV₀₁, hSup, hRange, hPb_Y⟩

theorem weil_twoChart_etale_cech_cocycle_to_algCocycle (Z : AlgebraicGeometry.Scheme.{u})
    {B : Type u} [CommRing B] (D : WeilTwoChartRingDatum B)
    (j₀ : AlgebraicGeometry.Spec (CommRingCat.of D.R₀) ⟶ Z)
    [AlgebraicGeometry.IsOpenImmersion j₀]
    (j₁ : AlgebraicGeometry.Spec (CommRingCat.of D.R₁) ⟶ Z)
    [AlgebraicGeometry.IsOpenImmersion j₁]
    (hCov : Set.range j₀.base ∪ Set.range j₁.base = Set.univ)
    (hPb : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ D.R₀₁)))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D.R₀₁)))
      j₀ j₁)
    (T₀ T₁ : Type u) [CommRing T₀] [CommRing T₁]
    [Algebra D.R₀ T₀] [Algebra D.R₁ T₁]
    [Algebra.Etale D.R₀ T₀] [Algebra.Etale D.R₁ T₁]
    (hSurj₀ : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀))))
    (hSurj₁ : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁))))
    (hEt : AlgebraicGeometry.Etale
      (CategoryTheory.Limits.coprod.desc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁)))
    (c_T : ↥(weilEtaleCechDiff (weilEtaleGmPresheaf Z)
      ((weilEtaleIdTerminalIsTerminal.{u} Z).from
        (CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.coprod.desc
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁))
          hEt)) 1).ker) :
    let g_cov := CategoryTheory.Limits.coprod.desc
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁)
    let W : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g_cov hEt
    let w : W ⟶ weilEtaleIdTerminal.{u} Z := (weilEtaleIdTerminalIsTerminal.{u} Z).from W
    Module.FaithfullyFlat D.R₀ T₀ ∧
    Module.FaithfullyFlat D.R₁ T₁ ∧
    ∃ q_T : WeilTwoChartUnitQuad D T₀ T₁,
      WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c_T.1 q_T ∧
      WeilIsTwoChartAlgCocycle D q_T :=
by
  intro g_cov W w
  
  have hFF₀ : Module.FaithfullyFlat D.R₀ T₀ := by
    apply Module.FaithfullyFlat.of_comap_surjective
    intro p
    obtain ⟨q, hq⟩ := hSurj₀.surj p
    exact ⟨q, (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap D.R₀ T₀)) q).symm.trans hq⟩
  have hFF₁ : Module.FaithfullyFlat D.R₁ T₁ := by
    apply Module.FaithfullyFlat.of_comap_surjective
    intro p
    obtain ⟨q, hq⟩ := hSurj₁.surj p
    exact ⟨q, (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap D.R₁ T₁)) q).symm.trans hq⟩

  
  let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of T₀)
  let X₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of T₁)
  let W_sch : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.coprod X₀ X₁
  let inl_c : X₀ ⟶ W_sch := CategoryTheory.Limits.coprod.inl
  let inr_c : X₁ ⟶ W_sch := CategoryTheory.Limits.coprod.inr
  have hinl_g : inl_c ≫ g_cov =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ T₀)) ≫ j₀ :=
    CategoryTheory.Limits.coprod.inl_desc _ _
  have hinr_g : inr_c ≫ g_cov =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ T₁)) ≫ j₁ :=
    CategoryTheory.Limits.coprod.inr_desc _ _

  let F : CategoryTheory.Functor Z.Etale AlgebraicGeometry.Scheme.{u} :=
    (AlgebraicGeometry.Scheme.Etale.forget Z).comp (CategoryTheory.Over.forget Z)
  have hw_left : F.map w = g_cov :=
    (CategoryTheory.Category.comp_id w.left).symm.trans (CategoryTheory.MorphismProperty.Over.w w)

  have hproj₁_0 : weilEtaleCechProj w 1 0 = CategoryTheory.Limits.pullback.fst w w :=
    CategoryTheory.Category.comp_id (CategoryTheory.Limits.pullback.fst w w)
  have hproj₁_1 : weilEtaleCechProj w 1 1 = CategoryTheory.Limits.pullback.snd w w := rfl

  let P₂ : AlgebraicGeometry.Scheme.{u} := (weilEtaleCechObj w 1).left
  let π₀ : P₂ ⟶ W_sch := (weilEtaleCechProj w 1 0).left
  let π₁ : P₂ ⟶ W_sch := (weilEtaleCechProj w 1 1).left
  have hfst₁_left : F.map (CategoryTheory.Limits.pullback.fst w w) = π₀ :=
    congrArg F.map hproj₁_0.symm
  have hsnd₁_left : F.map (CategoryTheory.Limits.pullback.snd w w) = π₁ := rfl

  have hPb_P₂ : CategoryTheory.IsPullback π₀ π₁ g_cov g_cov := by
    have h := F.map_isPullback (CategoryTheory.IsPullback.of_hasPullback w w)
    rwa [hfst₁_left, hsnd₁_left, hw_left] at h

  let P₃ : AlgebraicGeometry.Scheme.{u} := (weilEtaleCechObj w 2).left
  let fst₂_et : weilEtaleCechObj w 2 ⟶ weilEtaleCechObj w 1 :=
    CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w 1) w
  let snd₂_et : weilEtaleCechObj w 2 ⟶ W :=
    CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w 1) w
  let p₁₂ : P₃ ⟶ P₂ := F.map fst₂_et
  let p₃ : P₃ ⟶ W_sch := F.map snd₂_et
  have hcechHom₁_left : F.map (weilEtaleCechHom w 1) = π₀ ≫ g_cov :=
    (F.map_comp (CategoryTheory.Limits.pullback.fst w w) w).trans
      (congrArg₂ CategoryTheory.CategoryStruct.comp hfst₁_left hw_left)

  have hPb_P₃ : CategoryTheory.IsPullback p₁₂ p₃ (π₀ ≫ g_cov) g_cov := by
    have h := F.map_isPullback (CategoryTheory.IsPullback.of_hasPullback (weilEtaleCechHom w 1) w)
    rwa [hcechHom₁_left, hw_left] at h

  have hproj₂_0 : weilEtaleCechProj w 2 0 = fst₂_et ≫ weilEtaleCechProj w 1 0 := rfl
  have hproj₂_1 : weilEtaleCechProj w 2 1 = fst₂_et ≫ weilEtaleCechProj w 1 1 := rfl
  have hproj₂_2 : weilEtaleCechProj w 2 2 = snd₂_et := rfl

  have hface_0 : ∀ j : Fin 3,
      weilEtaleCechFace w 1 j ≫ weilEtaleCechProj w 1 0 = weilEtaleCechProj w 2 (j.succAbove 0) := by
    intro j
    rw [hproj₁_0]
    dsimp only [weilEtaleCechFace, weilEtaleCechLiftSub]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hface_1 : ∀ j : Fin 3,
      weilEtaleCechFace w 1 j ≫ weilEtaleCechProj w 1 1 = weilEtaleCechProj w 2 (j.succAbove 1) := by
    intro j
    rw [hproj₁_1]
    dsimp only [weilEtaleCechFace, weilEtaleCechLiftSub]
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _

  let δ₀ : P₃ ⟶ P₂ := F.map (weilEtaleCechFace w 1 0)
  let δ₁ : P₃ ⟶ P₂ := F.map (weilEtaleCechFace w 1 1)
  let δ₂ : P₃ ⟶ P₂ := F.map (weilEtaleCechFace w 1 2)

  have hδ₀_0 : δ₀ ≫ π₀ = p₁₂ ≫ π₁ :=
    (F.map_comp _ _).symm.trans
      ((congrArg F.map (hface_0 0)).trans (F.map_comp fst₂_et (weilEtaleCechProj w 1 1)))
  have hδ₀_1 : δ₀ ≫ π₁ = p₃ :=
    (F.map_comp _ _).symm.trans (congrArg F.map (hface_1 0))
  have hδ₁_0 : δ₁ ≫ π₀ = p₁₂ ≫ π₀ :=
    (F.map_comp _ _).symm.trans
      ((congrArg F.map (hface_0 1)).trans (F.map_comp fst₂_et (weilEtaleCechProj w 1 0)))
  have hδ₁_1 : δ₁ ≫ π₁ = p₃ :=
    (F.map_comp _ _).symm.trans (congrArg F.map (hface_1 1))
  have hδ₂_0 : δ₂ ≫ π₀ = p₁₂ ≫ π₀ :=
    (F.map_comp _ _).symm.trans
      ((congrArg F.map (hface_0 2)).trans (F.map_comp fst₂_et (weilEtaleCechProj w 1 0)))
  have hδ₂_1 : δ₂ ≫ π₁ = p₁₂ ≫ π₁ :=
    (F.map_comp _ _).symm.trans
      ((congrArg F.map (hface_1 2)).trans (F.map_comp fst₂_et (weilEtaleCechProj w 1 1)))

  
  let evalUnit : ∀ {R_t : Type u} [CommRing R_t] {Q : AlgebraicGeometry.Scheme.{u}},
      (AlgebraicGeometry.Spec (CommRingCat.of R_t) ⟶ Q) →
      Units ↑(Q.presheaf.obj (Opposite.op ⊤)) →* Units R_t :=
    fun {R_t} _ {Q} l =>
      Units.map (l.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_t)).hom).hom.toMonoidHom

  have eval_comp : ∀ {R_t : Type u} [CommRing R_t] {P Q : AlgebraicGeometry.Scheme.{u}}
      (μ : AlgebraicGeometry.Spec (CommRingCat.of R_t) ⟶ P) (δ : P ⟶ Q)
      (u : Units ↑(Q.presheaf.obj (Opposite.op ⊤))),
      evalUnit μ (Units.map δ.appTop.hom.toMonoidHom u) = evalUnit (μ ≫ δ) u := by
    intro R_t _ P Q μ δ u
    apply Units.ext
    change (μ.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_t)).hom).hom
        (δ.appTop.hom u.val) =
      ((μ ≫ δ).appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_t)).hom).hom u.val
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop]
    rfl

  have eval_spec_map : ∀ {A C : Type u} [CommRing A] [CommRing C]
      {Q : AlgebraicGeometry.Scheme.{u}}
      (κ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Q) (φ : A →+* C)
      (u : Units ↑(Q.presheaf.obj (Opposite.op ⊤))),
      evalUnit (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ κ) u =
        Units.map φ.toMonoidHom (evalUnit κ u) := by
    intro A C _ _ Q κ φ u
    apply Units.ext
    change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ κ).appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).hom).hom u.val =
      φ ((κ.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom).hom u.val)
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
    rfl

  let u_c : Units ↑(P₂.presheaf.obj (Opposite.op ⊤)) := Additive.toMul c_T.1
  have hu_c_mul :
      Units.map δ₁.appTop.hom.toMonoidHom u_c =
        Units.map δ₂.appTop.hom.toMonoidHom u_c * Units.map δ₀.appTop.hom.toMonoidHom u_c := by
    have hc_ker : weilEtaleCechDiff (weilEtaleGmPresheaf Z) w 1 c_T.1 = 0 := c_T.2
    dsimp only [weilEtaleCechDiff] at hc_ker
    rw [AddMonoidHom.coe_finsetSum, Finset.sum_apply, Fin.sum_univ_three] at hc_ker
    simp only [Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one, sq, mul_neg,
      mul_one, neg_neg, one_zsmul, neg_one_zsmul, AddMonoidHom.neg_apply] at hc_ker
    let G₃ := Additive (Units ↑(P₃.presheaf.obj (Opposite.op ⊤)))
    let s₀ : G₃ := ((weilEtaleGmPresheaf Z).map (weilEtaleCechFace w 1 0).op).hom c_T.1
    let s₁ : G₃ := ((weilEtaleGmPresheaf Z).map (weilEtaleCechFace w 1 1).op).hom c_T.1
    let s₂ : G₃ := ((weilEtaleGmPresheaf Z).map (weilEtaleCechFace w 1 2).op).hom c_T.1
    have hc_eq : (s₀ + -s₁ + s₂ : G₃) = 0 := hc_ker
    have hs_eq : s₁ = s₂ + s₀ := by
      calc
        s₁ = (s₀ + -s₁ + s₂) + s₁ := by rw [hc_eq, zero_add]
        _ = s₂ + s₀ := by abel
    exact (congrArg Additive.toMul hs_eq).trans (toMul_add s₂ s₀)

  have triple_cocycle_eq : ∀ {R_t : Type u} [CommRing R_t]
      (α₀ α₁ α₂ : AlgebraicGeometry.Spec (CommRingCat.of R_t) ⟶ W_sch)
      (h₀₁ : α₀ ≫ g_cov = α₁ ≫ g_cov) (h₀₂ : α₀ ≫ g_cov = α₂ ≫ g_cov),
      evalUnit (hPb_P₂.lift α₀ α₂ h₀₂) u_c =
        evalUnit (hPb_P₂.lift α₀ α₁ h₀₁) u_c *
          evalUnit (hPb_P₂.lift α₁ α₂ (h₀₁.symm.trans h₀₂)) u_c := by
    intro R_t _ α₀ α₁ α₂ h₀₁ h₀₂
    let l₀₁ := hPb_P₂.lift α₀ α₁ h₀₁
    let l₀₂ := hPb_P₂.lift α₀ α₂ h₀₂
    let l₁₂ := hPb_P₂.lift α₁ α₂ (h₀₁.symm.trans h₀₂)
    have hM : l₀₁ ≫ (π₀ ≫ g_cov) = α₂ ≫ g_cov := by
      rw [← CategoryTheory.Category.assoc, hPb_P₂.lift_fst]
      exact h₀₂
    let M := hPb_P₃.lift l₀₁ α₂ hM
    have hM_δ₂ : M ≫ δ₂ = l₀₁ := by
      apply hPb_P₂.hom_ext
      · rw [CategoryTheory.Category.assoc, hδ₂_0, ← CategoryTheory.Category.assoc, hPb_P₃.lift_fst]
      · rw [CategoryTheory.Category.assoc, hδ₂_1, ← CategoryTheory.Category.assoc, hPb_P₃.lift_fst]
    have hM_δ₁ : M ≫ δ₁ = l₀₂ := by
      apply hPb_P₂.hom_ext
      · rw [CategoryTheory.Category.assoc, hδ₁_0, ← CategoryTheory.Category.assoc,
          hPb_P₃.lift_fst, hPb_P₂.lift_fst, hPb_P₂.lift_fst]
      · rw [CategoryTheory.Category.assoc, hδ₁_1, hPb_P₃.lift_snd, hPb_P₂.lift_snd]
    have hM_δ₀ : M ≫ δ₀ = l₁₂ := by
      apply hPb_P₂.hom_ext
      · rw [CategoryTheory.Category.assoc, hδ₀_0, ← CategoryTheory.Category.assoc,
          hPb_P₃.lift_fst, hPb_P₂.lift_snd, hPb_P₂.lift_fst]
      · rw [CategoryTheory.Category.assoc, hδ₀_1, hPb_P₃.lift_snd, hPb_P₂.lift_snd]
    have step := congrArg (evalUnit M) hu_c_mul
    rw [map_mul, eval_comp, eval_comp, eval_comp, hM_δ₁, hM_δ₂, hM_δ₀] at step
    exact step

  have eval_lift_rings : ∀ {A C L R : Type u} [CommRing A] [CommRing C] [CommRing L] [CommRing R]
      (in_L : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ W_sch)
      (in_R : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ W_sch)
      (ι_L : L →+* A) (ι_R : R →+* A)
      (hκ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫ in_L) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ in_R) ≫ g_cov)
      (ψ_L : L →+* C) (ψ_R : R →+* C)
      (hψ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_L) ≫ in_L) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_R) ≫ in_R) ≫ g_cov)
      (φ : A →+* C),
      φ.comp ι_L = ψ_L →
      φ.comp ι_R = ψ_R →
      evalUnit (hPb_P₂.lift
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_L) ≫ in_L)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_R) ≫ in_R) hψ) u_c =
        Units.map φ.toMonoidHom (evalUnit (hPb_P₂.lift
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫ in_L)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ in_R) hκ) u_c) := by
    intro A C L R _ _ _ _ in_L in_R ι_L ι_R hκ ψ_L ψ_R hψ φ hL hR
    have h_eq : hPb_P₂.lift
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_L) ≫ in_L)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_R) ≫ in_R) hψ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        hPb_P₂.lift
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L) ≫ in_L)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫ in_R) hκ := by
      apply hPb_P₂.hom_ext
      · rw [hPb_P₂.lift_fst, CategoryTheory.Category.assoc, hPb_P₂.lift_fst,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hL]
      · rw [hPb_P₂.lift_snd, CategoryTheory.Category.assoc, hPb_P₂.lift_snd,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hR]
    rw [h_eq, eval_spec_map]

  
  let T₀_ov := weilTwoChartOv₀ D T₀
  let T₁_ov := weilTwoChartOv₁ D T₁
  let A₀₀ := TensorProduct D.R₀ T₀ T₀
  let A₁₁ := TensorProduct D.R₁ T₁ T₁
  let A₀₀_ov := TensorProduct D.R₀₁ T₀_ov T₀_ov
  let A₀₁ := TensorProduct D.R₀₁ T₀_ov T₁_ov
  let A₁₀ := TensorProduct D.R₀₁ T₁_ov T₀_ov
  let A₁₁_ov := TensorProduct D.R₀₁ T₁_ov T₁_ov

  let ι₀₀_L : T₀ →+* A₀₀ :=
    Algebra.TensorProduct.includeLeftRingHom (R := D.R₀) (A := T₀) (B := T₀)
  let ι₀₀_R : T₀ →+* A₀₀ :=
    (Algebra.TensorProduct.includeRight (R := D.R₀) (A := T₀) (B := T₀)).toRingHom
  let ι₀₁_L : T₀ →+* A₀₁ :=
    (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).comp
      (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀)).toRingHom
  let ι₀₁_R : T₁ →+* A₀₁ :=
    (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov)).toRingHom.comp
      (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom
  let ι₁₀_L : T₁ →+* A₁₀ :=
    (Algebra.TensorProduct.includeLeftRingHom (R := D.R₀₁) (A := T₁_ov) (B := T₀_ov)).comp
      (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom
  let ι₁₀_R : T₀ →+* A₁₀ :=
    (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₁_ov) (B := T₀_ov)).toRingHom.comp
      (Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀)).toRingHom
  let ι₁₁_L : T₁ →+* A₁₁ :=
    Algebra.TensorProduct.includeLeftRingHom (R := D.R₁) (A := T₁) (B := T₁)
  let ι₁₁_R : T₁ →+* A₁₁ :=
    (Algebra.TensorProduct.includeRight (R := D.R₁) (A := T₁) (B := T₁)).toRingHom

  have hinl_spec : ∀ {S : Type u} [CommRing S] [Algebra D.R₀ S] (ψ : T₀ →+* S),
      ψ.comp (algebraMap D.R₀ T₀) = algebraMap D.R₀ S →
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ inl_c) ≫ g_cov =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀ S)) ≫ j₀ := by
    intro S _ _ ψ hψ
    rw [CategoryTheory.Category.assoc, hinl_g, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ]

  have hinr_spec : ∀ {S : Type u} [CommRing S] [Algebra D.R₁ S] (ψ : T₁ →+* S),
      ψ.comp (algebraMap D.R₁ T₁) = algebraMap D.R₁ S →
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ inr_c) ≫ g_cov =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ S)) ≫ j₁ := by
    intro S _ _ ψ hψ
    rw [CategoryTheory.Category.assoc, hinr_g, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ]

  have hinl_spec_ov : ∀ {S : Type u} [CommRing S] [Algebra D.R₀₁ S] (ψ : T₀ →+* S),
      ψ.comp (algebraMap D.R₀ T₀) = (algebraMap D.R₀₁ S).comp (algebraMap D.R₀ D.R₀₁) →
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ inl_c) ≫ g_cov =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀₁ S)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D.R₀₁)) ≫ j₁ := by
    intro S _ _ ψ hψ
    rw [CategoryTheory.Category.assoc, hinl_g, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ,
      CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc, hPb.w]

  have hinr_spec_ov : ∀ {S : Type u} [CommRing S] [Algebra D.R₀₁ S] (ψ : T₁ →+* S),
      ψ.comp (algebraMap D.R₁ T₁) = (algebraMap D.R₀₁ S).comp (algebraMap D.R₁ D.R₀₁) →
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ inr_c) ≫ g_cov =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₀₁ S)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D.R₁ D.R₀₁)) ≫ j₁ := by
    intro S _ _ ψ hψ
    rw [CategoryTheory.Category.assoc, hinr_g, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ,
      CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc]

  have hι₀₀_L_alg : ι₀₀_L.comp (algebraMap D.R₀ T₀) = algebraMap D.R₀ A₀₀ :=
    (Algebra.TensorProduct.includeLeft (R := D.R₀) (S := D.R₀) (A := T₀) (B := T₀)).comp_algebraMap
  have hι₀₀_R_alg : ι₀₀_R.comp (algebraMap D.R₀ T₀) = algebraMap D.R₀ A₀₀ :=
    (Algebra.TensorProduct.includeRight (R := D.R₀) (A := T₀) (B := T₀)).comp_algebraMap
  have hι₁₁_L_alg : ι₁₁_L.comp (algebraMap D.R₁ T₁) = algebraMap D.R₁ A₁₁ :=
    (Algebra.TensorProduct.includeLeft (R := D.R₁) (S := D.R₁) (A := T₁) (B := T₁)).comp_algebraMap
  have hι₁₁_R_alg : ι₁₁_R.comp (algebraMap D.R₁ T₁) = algebraMap D.R₁ A₁₁ :=
    (Algebra.TensorProduct.includeRight (R := D.R₁) (A := T₁) (B := T₁)).comp_algebraMap

  have hι₀₁_L_alg : ι₀₁_L.comp (algebraMap D.R₀ T₀) =
      (algebraMap D.R₀₁ A₀₁).comp (algebraMap D.R₀ D.R₀₁) := by
    ext r₀
    change (Algebra.TensorProduct.includeLeft (R := D.R₀₁) (S := D.R₀₁) (A := T₀_ov) (B := T₁_ov))
      ((Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀))
        (algebraMap D.R₀ T₀ r₀)) = algebraMap D.R₀₁ A₀₁ (algebraMap D.R₀ D.R₀₁ r₀)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply D.R₀ D.R₀₁ T₀_ov, AlgHom.commutes]

  have hι₀₁_R_alg : ι₀₁_R.comp (algebraMap D.R₁ T₁) =
      (algebraMap D.R₀₁ A₀₁).comp (algebraMap D.R₁ D.R₀₁) := by
    ext r₁
    change (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₀_ov) (B := T₁_ov))
      ((Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁))
        (algebraMap D.R₁ T₁ r₁)) = algebraMap D.R₀₁ A₀₁ (algebraMap D.R₁ D.R₀₁ r₁)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply D.R₁ D.R₀₁ T₁_ov, AlgHom.commutes]

  have hι₁₀_L_alg : ι₁₀_L.comp (algebraMap D.R₁ T₁) =
      (algebraMap D.R₀₁ A₁₀).comp (algebraMap D.R₁ D.R₀₁) := by
    ext r₁
    change (Algebra.TensorProduct.includeLeft (R := D.R₀₁) (S := D.R₀₁) (A := T₁_ov) (B := T₀_ov))
      ((Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁))
        (algebraMap D.R₁ T₁ r₁)) = algebraMap D.R₀₁ A₁₀ (algebraMap D.R₁ D.R₀₁ r₁)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply D.R₁ D.R₀₁ T₁_ov, AlgHom.commutes]

  have hι₁₀_R_alg : ι₁₀_R.comp (algebraMap D.R₀ T₀) =
      (algebraMap D.R₀₁ A₁₀).comp (algebraMap D.R₀ D.R₀₁) := by
    ext r₀
    change (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := T₁_ov) (B := T₀_ov))
      ((Algebra.TensorProduct.includeRight (R := D.R₀) (A := D.R₀₁) (B := T₀))
        (algebraMap D.R₀ T₀ r₀)) = algebraMap D.R₀₁ A₁₀ (algebraMap D.R₀ D.R₀₁ r₀)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply D.R₀ D.R₀₁ T₀_ov, AlgHom.commutes]

  have hcomm₀₀ :
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₀_L) ≫ inl_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₀_R) ≫ inl_c) ≫ g_cov :=
    (hinl_spec ι₀₀_L hι₀₀_L_alg).trans (hinl_spec ι₀₀_R hι₀₀_R_alg).symm
  have hcomm₀₁ :
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₁_L) ≫ inl_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₁_R) ≫ inr_c) ≫ g_cov :=
    (hinl_spec_ov ι₀₁_L hι₀₁_L_alg).trans (hinr_spec_ov ι₀₁_R hι₀₁_R_alg).symm
  have hcomm₁₀ :
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₀_L) ≫ inr_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₀_R) ≫ inl_c) ≫ g_cov :=
    (hinr_spec_ov ι₁₀_L hι₁₀_L_alg).trans (hinl_spec_ov ι₁₀_R hι₁₀_R_alg).symm
  have hcomm₁₁ :
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₁_L) ≫ inr_c) ≫ g_cov =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₁_R) ≫ inr_c) ≫ g_cov :=
    (hinr_spec ι₁₁_L hι₁₁_L_alg).trans (hinr_spec ι₁₁_R hι₁₁_R_alg).symm

  let κ₀₀ := hPb_P₂.lift
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₀_L) ≫ inl_c)
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₀_R) ≫ inl_c) hcomm₀₀
  let κ₀₁ := hPb_P₂.lift
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₁_L) ≫ inl_c)
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀₁_R) ≫ inr_c) hcomm₀₁
  let κ₁₀ := hPb_P₂.lift
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₀_L) ≫ inr_c)
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₀_R) ≫ inl_c) hcomm₁₀
  let κ₁₁ := hPb_P₂.lift
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₁_L) ≫ inr_c)
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁₁_R) ≫ inr_c) hcomm₁₁

  let q_T : WeilTwoChartUnitQuad D T₀ T₁ :=
    { g₀₀ := evalUnit κ₀₀ u_c
      g₀₁ := evalUnit κ₀₁ u_c
      g₁₀ := evalUnit κ₁₀ u_c
      g₁₁ := evalUnit κ₁₁ u_c }

  have hMatch_T : WeilMatchesTwoChartQuad Z D T₀ T₁ W rfl w c_T.1 q_T := by
    have hinl_id : inl_c ≫ CategoryTheory.eqToHom (rfl : W.left = W_sch).symm = inl_c :=
      CategoryTheory.Category.comp_id inl_c
    have hinr_id : inr_c ≫ CategoryTheory.eqToHom (rfl : W.left = W_sch).symm = inr_c :=
      CategoryTheory.Category.comp_id inr_c
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro m₀₀ hm₀ hm₁
      have hm_eq : m₀₀ = κ₀₀ :=
        hPb_P₂.hom_ext
          (hm₀.trans ((congrArg (_ ≫ ·) hinl_id).trans (hPb_P₂.lift_fst _ _ _).symm))
          (hm₁.trans ((congrArg (_ ≫ ·) hinl_id).trans (hPb_P₂.lift_snd _ _ _).symm))
      exact congrArg (fun m => evalUnit m u_c) hm_eq
    · intro m₀₁ hm₀ hm₁
      have hm_eq : m₀₁ = κ₀₁ :=
        hPb_P₂.hom_ext
          (hm₀.trans ((congrArg (_ ≫ ·) hinl_id).trans (hPb_P₂.lift_fst _ _ _).symm))
          (hm₁.trans ((congrArg (_ ≫ ·) hinr_id).trans (hPb_P₂.lift_snd _ _ _).symm))
      exact congrArg (fun m => evalUnit m u_c) hm_eq
    · intro m₁₀ hm₀ hm₁
      have hm_eq : m₁₀ = κ₁₀ :=
        hPb_P₂.hom_ext
          (hm₀.trans ((congrArg (_ ≫ ·) hinr_id).trans (hPb_P₂.lift_fst _ _ _).symm))
          (hm₁.trans ((congrArg (_ ≫ ·) hinl_id).trans (hPb_P₂.lift_snd _ _ _).symm))
      exact congrArg (fun m => evalUnit m u_c) hm_eq
    · intro m₁₁ hm₀ hm₁
      have hm_eq : m₁₁ = κ₁₁ :=
        hPb_P₂.hom_ext
          (hm₀.trans ((congrArg (_ ≫ ·) hinr_id).trans (hPb_P₂.lift_fst _ _ _).symm))
          (hm₁.trans ((congrArg (_ ≫ ·) hinr_id).trans (hPb_P₂.lift_snd _ _ _).symm))
      exact congrArg (fun m => evalUnit m u_c) hm_eq

  refine ⟨hFF₀, hFF₁, q_T, hMatch_T,
