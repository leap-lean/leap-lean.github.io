        ↑(Y_A.presheaf.obj (Opposite.op V)) →+* R :=
      fun R _ μ V hV =>
        (μ.appLE V ⊤ hV ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).hom).hom
    have pullSec_res : ∀ {R : Type u} [CommRing R]
        (μ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y_A)
        {V V' : Y_A.Opens} (hle : V' ≤ V)
        (hV' : ⊤ ≤ (TopologicalSpace.Opens.map μ.base).obj V')
        (x : ↑(Y_A.presheaf.obj (Opposite.op V))),
        pullSec R μ V' hV' ((Y_A.presheaf.map (CategoryTheory.homOfLE hle).op).hom x) =
          pullSec R μ V (fun q hq => hle (hV' hq)) x := by
      intro R _ μ V V' hle hV' x
      change (Y_A.presheaf.map (CategoryTheory.homOfLE hle).op ≫
        (μ.appLE V' ⊤ hV' ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).hom)).hom x = _
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.map_appLE]
    have pullSec_comp : ∀ {R R' : Type u} [CommRing R] [CommRing R']
        (σ : R →+* R')
        (μ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y_A)
        (μ' : AlgebraicGeometry.Spec (CommRingCat.of R') ⟶ Y_A)
        (hμ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫ μ = μ')
        (V : Y_A.Opens)
        (hV : ⊤ ≤ (TopologicalSpace.Opens.map μ.base).obj V)
        (hV' : ⊤ ≤ (TopologicalSpace.Opens.map μ'.base).obj V)
        (x : ↑(Y_A.presheaf.obj (Opposite.op V))),
        σ (pullSec R μ V hV x) = pullSec R' μ' V hV' x := by
      intro R R' _ _ σ μ μ' hμ V hV hV' x
