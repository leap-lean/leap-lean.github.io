theorem weil_smooth_curve_cyclic_cover_irreducible_of_no_coboundary (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC₀ : AlgebraicGeometry.IsIntegral C₀.left)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom]
    (hEtNorm : ∀ (B : Type u) [CommRing B] [Algebra (MvPolynomial (Fin 1) k) B]
      [Algebra.Etale (MvPolynomial (Fin 1) k) B] (p : Ideal B) [p.IsMaximal],
      IsDomain (Localization.AtPrime p) ∧ IsIntegrallyClosed (Localization.AtPrime p))
    (R_bar₀ R_bar₁ R_bar₀₁ : Type u)
    [CommRing R_bar₀] [CommRing R_bar₁] [CommRing R_bar₀₁]
    (t_bar₀ : R_bar₀) (t_bar₁ : R_bar₁)
    (ρ_bar₀ : R_bar₀ →+* R_bar₀₁) (ρ_bar₁ : R_bar₁ →+* R_bar₀₁)
    (hLoc_bar₀ : @IsLocalization.Away R_bar₀ _ t_bar₀ R_bar₀₁ _ ρ_bar₀.toAlgebra)
    (hLoc_bar₁ : @IsLocalization.Away R_bar₁ _ t_bar₁ R_bar₀₁ _ ρ_bar₁.toAlgebra)
    (ht_bar₀₁ : ρ_bar₀ t_bar₀ * ρ_bar₁ t_bar₁ = 1)
    (j₀_k : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R_bar₀)) C₀.left)
    (j₁_k : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R_bar₁)) C₀.left)
    [AlgebraicGeometry.IsOpenImmersion j₀_k]
    [AlgebraicGeometry.IsOpenImmersion j₁_k]
    (hCov_k : Set.range j₀_k.base ∪ Set.range j₁_k.base = Set.univ)
    (hPb_k : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar₀))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar₁))
      j₀_k j₁_k)
    (m₀ m₁ d_u e T_ann : ℕ) (hm₀ : 1 ≤ m₀) (hm₁ : 1 ≤ m₁)
    (f_bar₀ q_bar₀ U_bar₀ V_bar₀ : Fin m₀ → R_bar₀)
    (G_bar₀₀ G'_bar₀₀ : Fin m₀ → Fin m₀ → R_bar₀)
    (f_bar₁ q_bar₁ U_bar₁ V_bar₁ : Fin m₁ → R_bar₁)
    (G_bar₁₁ G'_bar₁₁ : Fin m₁ → Fin m₁ → R_bar₁)
    (G_bar₀₁ G'_bar₀₁ : Fin m₀ → Fin m₁ → R_bar₀₁)
    (hEqs_k :
      (∑ r : Fin m₀, q_bar₀ r * f_bar₀ r) = 1 ∧
      (∑ s : Fin m₁, q_bar₁ s * f_bar₁ s) = 1 ∧
      (∀ r : Fin m₀, U_bar₀ r * V_bar₀ r = (f_bar₀ r) ^ d_u) ∧
      (∀ s : Fin m₁, U_bar₁ s * V_bar₁ s = (f_bar₁ s) ^ d_u) ∧
      (∀ r : Fin m₀, G_bar₀₀ r r = (f_bar₀ r * f_bar₀ r) ^ e) ∧
      (∀ s : Fin m₁, G_bar₁₁ s s = (f_bar₁ s * f_bar₁ s) ^ e) ∧
      (∀ r r' : Fin m₀, G_bar₀₀ r r' * G'_bar₀₀ r r' = (f_bar₀ r * f_bar₀ r') ^ (2 * e)) ∧
      (∀ s s' : Fin m₁, G_bar₁₁ s s' * G'_bar₁₁ s s' = (f_bar₁ s * f_bar₁ s') ^ (2 * e)) ∧
      (∀ (r : Fin m₀) (s : Fin m₁),
        G_bar₀₁ r s * G'_bar₀₁ r s = (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)) ^ (2 * e)) ∧
      (∀ r r' : Fin m₀,
        (G_bar₀₀ r r') ^ ℓ * U_bar₀ r' = (f_bar₀ r * f_bar₀ r') ^ (ℓ * e) * U_bar₀ r) ∧
      (∀ s s' : Fin m₁,
        (G_bar₁₁ s s') ^ ℓ * U_bar₁ s' = (f_bar₁ s * f_bar₁ s') ^ (ℓ * e) * U_bar₁ s) ∧
      (∀ (r : Fin m₀) (s : Fin m₁),
        (G_bar₀₁ r s) ^ ℓ * ρ_bar₁ (U_bar₁ s) =
          (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)) ^ (ℓ * e) * ρ_bar₀ (U_bar₀ r)) ∧
      (∀ r₁ r₂ r₃ : Fin m₀,
        (f_bar₀ r₁ * f_bar₀ r₂ * f_bar₀ r₃) ^ T_ann *
          (G_bar₀₀ r₁ r₂ * G_bar₀₀ r₂ r₃ - (f_bar₀ r₂) ^ (2 * e) * G_bar₀₀ r₁ r₃) = 0) ∧
      (∀ s₁ s₂ s₃ : Fin m₁,
        (f_bar₁ s₁ * f_bar₁ s₂ * f_bar₁ s₃) ^ T_ann *
          (G_bar₁₁ s₁ s₂ * G_bar₁₁ s₂ s₃ - (f_bar₁ s₂) ^ (2 * e) * G_bar₁₁ s₁ s₃) = 0) ∧
      (∀ (r₁ r₂ : Fin m₀) (s₃ : Fin m₁),
        (ρ_bar₀ (f_bar₀ r₁) * ρ_bar₀ (f_bar₀ r₂) * ρ_bar₁ (f_bar₁ s₃)) ^ T_ann *
          (ρ_bar₀ (G_bar₀₀ r₁ r₂) * G_bar₀₁ r₂ s₃ -
            (ρ_bar₀ (f_bar₀ r₂)) ^ (2 * e) * G_bar₀₁ r₁ s₃) = 0) ∧
      (∀ (r₁ : Fin m₀) (s₂ s₃ : Fin m₁),
        (ρ_bar₀ (f_bar₀ r₁) * ρ_bar₁ (f_bar₁ s₂) * ρ_bar₁ (f_bar₁ s₃)) ^ T_ann *
          (G_bar₀₁ r₁ s₂ * ρ_bar₁ (G_bar₁₁ s₂ s₃) -
            (ρ_bar₁ (f_bar₁ s₂)) ^ (2 * e) * G_bar₀₁ r₁ s₃) = 0))
    (hNoCoboundary : ¬ ∃ (v₀ : ∀ r : Fin m₀, Units (Localization.Away (f_bar₀ r)))
        (v₁ : ∀ s : Fin m₁, Units (Localization.Away (f_bar₁ s))),
      (∀ (r r' : Fin m₀)
         (ψ_L : Localization.Away (f_bar₀ r) →+* Localization.Away (f_bar₀ r * f_bar₀ r'))
         (ψ_R : Localization.Away (f_bar₀ r') →+* Localization.Away (f_bar₀ r * f_bar₀ r')),
         ψ_L.comp (algebraMap R_bar₀ (Localization.Away (f_bar₀ r))) =
           algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r')) →
         ψ_R.comp (algebraMap R_bar₀ (Localization.Away (f_bar₀ r'))) =
           algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r')) →
         algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r'))
           ((f_bar₀ r * f_bar₀ r') ^ e) * ψ_L (v₀ r).1 =
         algebraMap R_bar₀ (Localization.Away (f_bar₀ r * f_bar₀ r')) (G_bar₀₀ r r') *
           ψ_R (v₀ r').1) ∧
      (∀ (s s' : Fin m₁)
         (ψ_L : Localization.Away (f_bar₁ s) →+* Localization.Away (f_bar₁ s * f_bar₁ s'))
         (ψ_R : Localization.Away (f_bar₁ s') →+* Localization.Away (f_bar₁ s * f_bar₁ s')),
         ψ_L.comp (algebraMap R_bar₁ (Localization.Away (f_bar₁ s))) =
           algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s')) →
         ψ_R.comp (algebraMap R_bar₁ (Localization.Away (f_bar₁ s'))) =
           algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s')) →
         algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s'))
           ((f_bar₁ s * f_bar₁ s') ^ e) * ψ_L (v₁ s).1 =
         algebraMap R_bar₁ (Localization.Away (f_bar₁ s * f_bar₁ s')) (G_bar₁₁ s s') *
           ψ_R (v₁ s').1) ∧
      (∀ (r : Fin m₀) (s : Fin m₁)
         (ψ_L : Localization.Away (f_bar₀ r) →+*
           Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)))
         (ψ_R : Localization.Away (f_bar₁ s) →+*
           Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s))),
         ψ_L.comp (algebraMap R_bar₀ (Localization.Away (f_bar₀ r))) =
           (algebraMap R_bar₀₁ (Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)))).comp
             ρ_bar₀ →
         ψ_R.comp (algebraMap R_bar₁ (Localization.Away (f_bar₁ s))) =
           (algebraMap R_bar₀₁ (Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)))).comp
             ρ_bar₁ →
         algebraMap R_bar₀₁ (Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)))
           ((ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)) ^ e) * ψ_L (v₀ r).1 =
         algebraMap R_bar₀₁ (Localization.Away (ρ_bar₀ (f_bar₀ r) * ρ_bar₁ (f_bar₁ s)))
           (G_bar₀₁ r s) * ψ_R (v₁ s).1))
    (F₀ : AlgebraicGeometry.Scheme.{u})
    (ν₀ : Quiver.Hom F₀ C₀.left)
    [AlgebraicGeometry.Surjective ν₀]
    (ι_tilde₀ : ∀ r : Fin m₀, Quiver.Hom
      (AlgebraicGeometry.Spec (CommRingCat.of
        (AdjoinRoot
          ((Polynomial.X : Polynomial (Localization.Away (f_bar₀ r))) ^ ℓ -
            Polynomial.C
              (algebraMap R_bar₀ (Localization.Away (f_bar₀ r)) (U_bar₀ r)))))) F₀)
    (ι_tilde₁ : ∀ s : Fin m₁, Quiver.Hom
      (AlgebraicGeometry.Spec (CommRingCat.of
        (AdjoinRoot
          ((Polynomial.X : Polynomial (Localization.Away (f_bar₁ s))) ^ ℓ -
            Polynomial.C
              (algebraMap R_bar₁ (Localization.Away (f_bar₁ s)) (U_bar₁ s)))))) F₀)
    (hOpen_tilde₀ : ∀ r : Fin m₀, AlgebraicGeometry.IsOpenImmersion (ι_tilde₀ r))
    (hOpen_tilde₁ : ∀ s : Fin m₁, AlgebraicGeometry.IsOpenImmersion (ι_tilde₁ s))
    (hRange_tilde₀ : ∀ r : Fin m₀,
      Set.range (ι_tilde₀ r).base =
        ν₀.base ⁻¹' (j₀_k.base '' (PrimeSpectrum.basicOpen (f_bar₀ r) : Set (PrimeSpectrum R_bar₀))))
    (hRange_tilde₁ : ∀ s : Fin m₁,
      Set.range (ι_tilde₁ s).base =
        ν₀.base ⁻¹' (j₁_k.base '' (PrimeSpectrum.basicOpen (f_bar₁ s) : Set (PrimeSpectrum R_bar₁)))) :
    IrreducibleSpace ↥F₀ :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  have hℓ_pos : 1 ≤ ℓ := hPrime.one_le
  obtain ⟨hPart₀, hPart₁, hUV₀, hUV₁, -, -, hGG'₀₀, hGG'₁₁, hGG'₀₁, hGU₀₀, hGU₁₁, hGU₀₁,
    hCoc₀₀₀, hCoc₁₁₁, hCoc₀₀₁, hCoc₀₁₁⟩ := hEqs_k

  let fldOfDom : ∀ (D : Type u) [CommRing D] [IsDomain D], Field (FractionRing D) :=
    fun D _ _ => inferInstance
  have hFieldCancel : ∀ {F : Type u} [Field F] {m a b : F},
      m ≠ 0 → m * a = m * b → a = b := by
    intro F _ m a b hm heq
    calc a = m⁻¹ * (m * a) := by rw [← mul_assoc, inv_mul_cancel₀ hm, one_mul]
      _ = m⁻¹ * (m * b) := by rw [heq]
      _ = b := by rw [← mul_assoc, inv_mul_cancel₀ hm, one_mul]
  have hFieldMulNe : ∀ {F : Type u} [Field F] {a b : F}, a ≠ 0 → b ≠ 0 → a * b ≠ 0 :=
    fun {_} _ {_ _} ha hb => mul_ne_zero ha hb
  have hFracInj : ∀ (D : Type u) [CommRing D] [IsDomain D],
      Function.Injective (algebraMap D (FractionRing D)) :=
    fun D _ _ => IsFractionRing.injective D (FractionRing D)
  have hIrrOfInt : ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X],
      IrreducibleSpace ↥X := fun X _ => inferInstance
  have hIrrOfDom : ∀ (D : Type u) [CommRing D] [IsDomain D],
      IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of D)) :=
    fun D _ _ => inferInstance
  have hStalkEquiv : ∀ (D : Type u) [CommRing D] (x : PrimeSpectrum D),
      Localization.AtPrime x.asIdeal ≃+*
        ↑((AlgebraicGeometry.Spec (CommRingCat.of D)).presheaf.stalk x) :=
    fun D _ x => (AlgebraicGeometry.StructureSheaf.stalkIso D x).toRingEquiv
  have hIrr_C₀ : IrreducibleSpace ↥C₀.left := @hIrrOfInt C₀.left hIntC₀
  have hOpenInt : ∀ (X : AlgebraicGeometry.Scheme.{u})
      (f : X ⟶ C₀.left) [AlgebraicGeometry.IsOpenImmersion f] [Nonempty ↥X],
      AlgebraicGeometry.IsIntegral X :=
    fun X f _ _ => @AlgebraicGeometry.isIntegral_of_isOpenImmersion X C₀.left f _ hIntC₀ _

  
  have h_s1 : ∀ (R : Type u) [CommRing R] [Nontrivial R]
      (j : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R)) C₀.left)
      [AlgebraicGeometry.IsOpenImmersion j],
      IsDomain R ∧ IsIntegrallyClosed R := by
    intro R _ _ j _
    obtain ⟨m₀_R, hm₀_R⟩ := Ideal.exists_maximal R
    have hNeSpec : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) :=
      ⟨⟨m₀_R, hm₀_R.isPrime⟩⟩
    have hIntSpec : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of R)) :=
      @hOpenInt (AlgebraicGeometry.Spec (CommRingCat.of R)) j _ hNeSpec
    have hDomR : IsDomain R :=
      (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of R)).mp hIntSpec
    refine ⟨hDomR, @IsIntegrallyClosed.of_localization_maximal R _ hDomR fun m _ hm_max => ?_⟩
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    have hSub_k : Subsingleton ↥S_k := by
      refine ⟨fun a b => PrimeSpectrum.ext ?_⟩
      ext c
      constructor <;> intro hc
      · by_contra hc_b
        have hc_ne : c ≠ 0 := fun h0 => hc_b (h0 ▸ b.asIdeal.zero_mem)
        exact a.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem a.asIdeal hc (IsUnit.mk0 c hc_ne))
      · by_contra hc_a
        have hc_ne : c ≠ 0 := fun h0 => hc_a (h0 ▸ a.asIdeal.zero_mem)
        exact b.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem b.asIdeal hc (IsUnit.mk0 c hc_ne))
    let p_m : PrimeSpectrum R := ⟨m, hm_max.isPrime⟩
    let x : ↥C₀.left := j.base p_m
    obtain ⟨U_k, hAff_Uk, V, hAff_V, hx_V, he, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 C₀.hom).mp inferInstance x
    have hUk_top : U_k = ⊤ := by
      ext y
      exact iff_of_true (by rw [hSub_k.elim y (C₀.hom.base x)]; exact he hx_V) trivial
    subst hUk_top
    obtain ⟨ψ, _, hψ_et⟩ := hStd.exists_etale_mvPolynomial
    let A_k := S_k.presheaf.obj (Opposite.op ⊤)
    let R_V := C₀.left.presheaf.obj (Opposite.op V)
    have hfrom_eq : hAff_Uk.fromSpec = S_k.isoSpec.inv :=
      AlgebraicGeometry.IsAffineOpen.fromSpec_top
    have hIso_from : CategoryTheory.IsIso hAff_Uk.fromSpec := by
      rw [hfrom_eq]
      infer_instance
    let φ_k : CommRingCat.of k ⟶ A_k := AlgebraicGeometry.Spec.preimage hAff_Uk.fromSpec
    let φ_k_inv : A_k ⟶ CommRingCat.of k :=
      AlgebraicGeometry.Spec.preimage (@CategoryTheory.inv _ _ _ _ hAff_Uk.fromSpec hIso_from)
    have hφ1 : φ_k ≫ φ_k_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage,
        @CategoryTheory.IsIso.inv_hom_id _ _ _ _ hAff_Uk.fromSpec hIso_from,
        AlgebraicGeometry.Spec.map_id]
    have hφ2 : φ_k_inv ≫ φ_k = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage,
        @CategoryTheory.IsIso.hom_inv_id _ _ _ _ hAff_Uk.fromSpec hIso_from,
        AlgebraicGeometry.Spec.map_id]
    let e_mv : CommRingCat.of (MvPolynomial (Fin 1) k) ⟶
        CommRingCat.of (MvPolynomial (Fin 1) ↑A_k) :=
      CommRingCat.ofHom (MvPolynomial.map φ_k.hom)
    let e_mv_inv : CommRingCat.of (MvPolynomial (Fin 1) ↑A_k) ⟶
        CommRingCat.of (MvPolynomial (Fin 1) k) :=
      CommRingCat.ofHom (MvPolynomial.map φ_k_inv.hom)
    have he_mv1 : e_mv ≫ e_mv_inv = 𝟙 _ := by
      ext1
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [e_mv, e_mv_inv, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
          Function.comp_apply, MvPolynomial.map_C, CommRingCat.hom_id, RingHom.id_apply]
        exact congrArg MvPolynomial.C
          (congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφ1)
      · intro i
        simp [e_mv, e_mv_inv]
    have he_mv2 : e_mv_inv ≫ e_mv = 𝟙 _ := by
      ext1
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [e_mv, e_mv_inv, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
          Function.comp_apply, MvPolynomial.map_C, CommRingCat.hom_id, RingHom.id_apply]
        exact congrArg MvPolynomial.C (congrArg (fun g : A_k ⟶ A_k => g.hom c) hφ2)
      · intro i
        simp [e_mv, e_mv_inv]
    let R_poly := MvPolynomial (Fin 1) k
    have hIso_emv : CategoryTheory.IsIso e_mv := ⟨⟨e_mv_inv, he_mv1, he_mv2⟩⟩
    let u_mid : AlgebraicGeometry.Spec R_V ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) ↑A_k)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
    have hEt_umid : AlgebraicGeometry.Etale u_mid :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_et
    let u₀ : AlgebraicGeometry.Spec R_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_poly) :=
      u_mid ≫ AlgebraicGeometry.Spec.map e_mv
    have hEt_u₀ : AlgebraicGeometry.Etale u₀ := by
      have _ := hIso_emv
      have _ := hEt_umid
      infer_instance
    let φ_poly : CommRingCat.of R_poly ⟶ R_V := AlgebraicGeometry.Spec.preimage u₀
    have hmap_φpoly : AlgebraicGeometry.Spec.map φ_poly = u₀ :=
      AlgebraicGeometry.Spec.map_preimage u₀
    have hEt_hom : RingHom.Etale φ_poly.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hmap_φpoly.symm ▸ hEt_u₀)
    let alg_RV : Algebra R_poly ↑R_V := φ_poly.hom.toAlgebra
    let _ := alg_RV
    have hEt_RV : Algebra.Etale R_poly ↑R_V := RingHom.etale_algebraMap.mp hEt_hom
    let y_V : PrimeSpectrum ↑R_V := hAff_V.primeIdealOf ⟨x, hx_V⟩
    have hy_V_eq : hAff_V.fromSpec.base y_V = x := hAff_V.fromSpec_primeIdealOf ⟨x, hx_V⟩
    let W_pre : TopologicalSpace.Opens (PrimeSpectrum ↑R_V) :=
      (TopologicalSpace.Opens.map hAff_V.fromSpec.base).obj j.opensRange
    have hy_W : y_V ∈ W_pre := by
      change hAff_V.fromSpec.base y_V ∈ Set.range j.base
      rw [hy_V_eq]
      exact ⟨p_m, rfl⟩
    obtain ⟨_, ⟨h, rfl⟩, hy_h, hh_le⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens hy_W
    let B : Type u := Localization.Away h
    have hEt_RV_B : Algebra.Etale (↑R_V) B := Algebra.Etale.of_isLocalizationAway h
    have hEt_PB : Algebra.Etale R_poly B :=
      @Algebra.Etale.comp R_poly (↑R_V) B _ _ _ _ _ _ _ hEt_RV hEt_RV_B
    let loc_V : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ AlgebraicGeometry.Spec R_V :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑R_V) B))
    have hOpen_locV : AlgebraicGeometry.IsOpenImmersion loc_V :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h
    let g_C : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ C₀.left := loc_V ≫ hAff_V.fromSpec
    have hOpen_gC : AlgebraicGeometry.IsOpenImmersion g_C :=
      @AlgebraicGeometry.IsOpenImmersion.comp _ _ _ loc_V hAff_V.fromSpec hOpen_locV inferInstance
    have hloc_range : Set.range loc_V.base = (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum ↑R_V)) :=
      PrimeSpectrum.localization_away_comap_range B h
    have hSub_g : Set.range g_C.base ⊆ Set.range j.base := by
      rintro _ ⟨q, rfl⟩
      have hq_mem : loc_V.base q ∈ PrimeSpectrum.basicOpen h := by
        change loc_V.base q ∈ (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum ↑R_V))
        rw [← hloc_range]
        exact ⟨q, rfl⟩
      exact hh_le hq_mem
    let ι_BR : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.IsOpenImmersion.lift j g_C hSub_g
    have hι_fac : ι_BR ≫ j = g_C := AlgebraicGeometry.IsOpenImmersion.lift_fac j g_C hSub_g
    have hOpen_ιBR : AlgebraicGeometry.IsOpenImmersion ι_BR :=
      @AlgebraicGeometry.IsOpenImmersion.of_comp _ _ _ ι_BR j _ (hι_fac.symm ▸ hOpen_gC)
    have hy_range : y_V ∈ Set.range loc_V.base := by
      rw [hloc_range]
      exact hy_h
    obtain ⟨q_B, hq_B⟩ := hy_range
    have hj_inj : Function.Injective j.base :=
      ((AlgebraicGeometry.IsOpenImmersion.iff_isIso_stalkMap).mp inferInstance).1.injective
    have hι_inj : Function.Injective ι_BR.base :=
      ((@AlgebraicGeometry.IsOpenImmersion.iff_isIso_stalkMap _ _ ι_BR).mp hOpen_ιBR).1.injective
    have hq_pt : ι_BR.base q_B = p_m := by
      apply hj_inj
      change (ι_BR ≫ j).base q_B = j.base p_m
      rw [hι_fac]
      change hAff_V.fromSpec.base (loc_V.base q_B) = x
      rw [hq_B, hy_V_eq]
    have hpm_closed : IsClosed ({p_m} : Set (PrimeSpectrum R)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_m).mpr hm_max
    have hq_pre : ({q_B} : Set (PrimeSpectrum B)) = ι_BR.base ⁻¹' ({p_m} : Set (PrimeSpectrum R)) := by
      ext q'
      constructor
      · intro hq'; rw [Set.mem_singleton_iff.mp hq']; exact hq_pt
      · intro hq'; exact Set.mem_singleton_iff.mpr (hι_inj (Set.mem_singleton_iff.mp hq' |>.trans hq_pt.symm))
    have hq_closed : IsClosed ({q_B} : Set (PrimeSpectrum B)) := by
      rw [hq_pre]
      exact hpm_closed.preimage ι_BR.continuous
    have hq_max : q_B.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_B).mp hq_closed
    have hIC_qB : IsIntegrallyClosed (Localization.AtPrime q_B.asIdeal) :=
      (@hEtNorm B _ _ hEt_PB q_B.asIdeal hq_max).2
    have hIso_stalk : CategoryTheory.IsIso (ι_BR.stalkMap q_B) :=
      @AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap _ _ ι_BR hOpen_ιBR q_B
    let iso_mid : ((AlgebraicGeometry.Spec (CommRingCat.of B)).presheaf.stalk q_B) ≅
        ((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.stalk p_m) :=
      (@CategoryTheory.asIso _ _ _ _ (ι_BR.stalkMap q_B) hIso_stalk).symm ≪≫
        CategoryTheory.eqToIso
          (congrArg (AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.stalk hq_pt)
    let e_tot : Localization.AtPrime q_B.asIdeal ≃+* Localization.AtPrime m :=
      (hStalkEquiv B q_B).trans
        (iso_mid.commRingCatIsoToRingEquiv.trans (hStalkEquiv R p_m).symm)
    exact @IsIntegrallyClosed.of_equiv _ _ _ _ e_tot hIC_qB

  
  have hUnitOfMul : ∀ {A : Type u} [CommRing A] {x y : A},
      IsUnit (x * y) → IsUnit x ∧ IsUnit y := by
    intro A _ x y ⟨u, hu⟩
    have hxy1 : x * y * ↑u⁻¹ = 1 := by rw [← hu, Units.mul_inv]
    refine ⟨⟨⟨x, y * ↑u⁻¹, ?_, ?_⟩, rfl⟩, ⟨⟨y, x * ↑u⁻¹, ?_, ?_⟩, rfl⟩⟩
    · rw [← mul_assoc, hxy1]
    · calc (y * ↑u⁻¹) * x = x * y * ↑u⁻¹ := by ring
        _ = 1 := hxy1
    · calc y * (x * ↑u⁻¹) = x * y * ↑u⁻¹ := by ring
        _ = 1 := hxy1
    · calc (x * ↑u⁻¹) * y = x * y * ↑u⁻¹ := by ring
        _ = 1 := hxy1

  have hAwayLiftHom : ∀ {R S P : Type u} [CommRing R] [CommRing S] [Algebra R S] [CommRing P]
      (x : R) [IsLocalization.Away x S] (g : R →+* P),
      IsUnit (g x) → ∃ ψ : S →+* P, ψ.comp (algebraMap R S) = g := by
    intro R S P _ _ _ _ x _ g hgx
    exact ⟨IsLocalization.Away.lift x hgx,
      RingHom.ext fun a => IsLocalization.Away.lift_eq x hgx a⟩

  have hcomp_app : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      {f : B →+* C} {g : A →+* B} {h : A →+* C},
      f.comp g = h → ∀ x : A, f (g x) = h x :=
    fun h x => RingHom.congr_fun h x

  have hSubHom : ∀ {A B : Type u} [CommRing A] [CommRing B],
      ¬ Nontrivial A → (A →+* B) → Subsingleton B := by
    intro A B _ _ hNotNt ψ
    have hSubA : Subsingleton A := not_nontrivial_iff_subsingleton.mp hNotNt
    refine subsingleton_of_zero_eq_one ?_
    rw [← map_zero ψ, ← map_one ψ, @Subsingleton.elim A hSubA 0 1]

  have hNtBase : ∀ {R : Type u} [CommRing R] (f : R),
      Nontrivial (Localization.Away f) → Nontrivial R := by
    intro R _ f hNt
    by_contra hNot
    have hSub : Subsingleton (Localization.Away f) :=
      hSubHom hNot (algebraMap R (Localization.Away f))
    exact @false_of_nontrivial_of_subsingleton (Localization.Away f) hNt hSub

  have hAwayDomIC : ∀ {R : Type u} [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (f : R),
      Nontrivial (Localization.Away f) →
      f ≠ 0 ∧ IsDomain (Localization.Away f) ∧ IsIntegrallyClosed (Localization.Away f) ∧
        Function.Injective (algebraMap R (Localization.Away f)) := by
    intro R _ _ _ f hNt
    have hf_ne : f ≠ 0 := by
      intro hf0
      rcases IsLocalization.Away.algebraMap_isUnit (S := Localization.Away f) f with ⟨u, hu⟩
      have hfz : algebraMap R (Localization.Away f) f = 0 := by rw [hf0, map_zero]
      have h01 : (0 : Localization.Away f) = 1 := by
        calc (0 : Localization.Away f) = 0 * ↑u⁻¹ := (zero_mul _).symm
          _ = algebraMap R (Localization.Away f) f * ↑u⁻¹ := by rw [hfz]
          _ = ↑u * ↑u⁻¹ := by rw [← hu]
          _ = 1 := Units.mul_inv u
      exact @false_of_nontrivial_of_subsingleton (Localization.Away f) hNt
        (subsingleton_of_zero_eq_one h01)
    have hle : Submonoid.powers f ≤ nonZeroDivisors R := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hf_ne)
    exact ⟨hf_ne,
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away f) hle,
      isIntegrallyClosed_of_isLocalization (Localization.Away f) (Submonoid.powers f) hle,
      IsLocalization.injective (Localization.Away f) hle⟩

  have hAwayLiftInj : ∀ {R S F : Type u} [CommRing R] [CommRing S] [Algebra R S] [Field F]
      (d : R) [IsLocalization.Away d S] (η : R →+* F),
      Function.Injective η → d ≠ 0 →
      ∃ ι : S →+* F, ι.comp (algebraMap R S) = η ∧ Function.Injective ι := by
    intro R S F _ _ _ _ d _ η hη hd
    have hd_unit : IsUnit (η d) :=
      IsUnit.mk0 (η d) (fun h0 => hd (hη (h0.trans (map_zero η).symm)))
    obtain ⟨ι, hcomp⟩ := hAwayLiftHom (S := S) d η hd_unit
    have hinj : Function.Injective ι := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨r, m⟩, hrm⟩ := IsLocalization.surj (Submonoid.powers d) x
      have hηr : η r = 0 := by
        calc
          η r = ι (algebraMap R S r) := (hcomp_app hcomp r).symm
          _ = ι (x * algebraMap R S m.1) := by rw [hrm]
          _ = ι x * ι (algebraMap R S m.1) := map_mul _ _ _
          _ = 0 := by rw [hx, zero_mul]
      have hr0 : r = 0 := hη (hηr.trans (map_zero η).symm)
      rw [hr0, map_zero] at hrm
      rcases IsLocalization.map_units S m with ⟨um, hum⟩
      calc
        x = (x * ↑um) * ↑um⁻¹ := by rw [mul_assoc, Units.mul_inv, mul_one]
        _ = (x * algebraMap R S m.1) * ↑um⁻¹ := by rw [hum]
        _ = 0 * ↑um⁻¹ := by rw [hrm]
        _ = 0 := zero_mul _
    exact ⟨ι, hcomp, hinj⟩

  have hDescentUnit : ∀ (S : Type u) [CommRing S] [IsDomain S] [IsIntegrallyClosed S]
      (u v : S), IsUnit (u * v) →
      ∀ (b : FractionRing S), b ^ ℓ = algebraMap S (FractionRing S) u →
      ∃ z : Units S, algebraMap S (FractionRing S) z.1 = b ∧ z.1 ^ ℓ = u := by
    intro S _ _ _ u v huv b hb
    let P : Polynomial S := (Polynomial.X : Polynomial S) ^ ℓ - Polynomial.C u
    have hMon : P.Monic := Polynomial.monic_X_pow_sub_C u hℓ_ne
    have heval : Polynomial.eval₂ (algebraMap S (FractionRing S)) b P = 0 := by
      dsimp [P]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hb, sub_self]
    have hInt_b : IsIntegral S b := ⟨P, hMon, heval⟩
    obtain ⟨a, ha⟩ := (isIntegrallyClosed_iff (FractionRing S)).mp inferInstance hInt_b
    have ha_pow : a ^ ℓ = u := by
      apply IsFractionRing.injective S (FractionRing S)
      rw [map_pow, ha, hb]
    rcases (hUnitOfMul huv).1 with ⟨u_un, rfl⟩
    have ha_mul1 : a * (a ^ (ℓ - 1) * ↑u_un⁻¹) = 1 := by
      calc
        a * (a ^ (ℓ - 1) * ↑u_un⁻¹) = (a ^ 1 * a ^ (ℓ - 1)) * ↑u_un⁻¹ := by ring
        _ = a ^ (1 + (ℓ - 1)) * ↑u_un⁻¹ := by rw [← pow_add]
        _ = a ^ ℓ * ↑u_un⁻¹ := by rw [Nat.add_sub_of_le hℓ_pos]
        _ = ↑u_un * ↑u_un⁻¹ := by rw [ha_pow]
        _ = 1 := Units.mul_inv u_un
    have ha_unit : IsUnit a :=
      (hUnitOfMul (by rw [ha_mul1]; exact isUnit_one)).1
    rcases ha_unit with ⟨z, rfl⟩
    exact ⟨z, ha, ha_pow⟩

  have hSingleProp : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
      (m : ℕ) (f U V : Fin m → R) (G G' : Fin m → Fin m → R),
      (∀ r : Fin m, U r * V r = (f r) ^ d_u) →
      (∀ r r' : Fin m, G r r' * G' r r' = (f r * f r') ^ (2 * e)) →
      (∀ r r' : Fin m, (G r r') ^ ℓ * U r' = (f r * f r') ^ (ℓ * e) * U r) →
      (∀ r₁ r₂ r₃ : Fin m,
        (f r₁ * f r₂ * f r₃) ^ T_ann * (G r₁ r₂ * G r₂ r₃ - (f r₂) ^ (2 * e) * G r₁ r₃) = 0) →
      ∀ (r₀ : Fin m), Nontrivial (Localization.Away (f r₀)) →
      ∀ (z₀ : Units (Localization.Away (f r₀))),
      z₀.1 ^ ℓ = algebraMap R (Localization.Away (f r₀)) (U r₀) →
      ∃ v : ∀ r : Fin m, Units (Localization.Away (f r)),
        (∀ (r : Fin m), Nontrivial (Localization.Away (f r)) →
          ∀ (ψ_L : Localization.Away (f r₀) →+* Localization.Away (f r₀ * f r))
            (ψ_R : Localization.Away (f r) →+* Localization.Away (f r₀ * f r)),
            ψ_L.comp (algebraMap R (Localization.Away (f r₀))) =
              algebraMap R (Localization.Away (f r₀ * f r)) →
            ψ_R.comp (algebraMap R (Localization.Away (f r))) =
              algebraMap R (Localization.Away (f r₀ * f r)) →
            algebraMap R (Localization.Away (f r₀ * f r)) ((f r₀ * f r) ^ e) * ψ_L z₀.1 =
              algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) * ψ_R (v r).1) ∧
        (∀ (r₁ r₂ : Fin m)
           (ψ_L : Localization.Away (f r₁) →+* Localization.Away (f r₁ * f r₂))
           (ψ_R : Localization.Away (f r₂) →+* Localization.Away (f r₁ * f r₂)),
           ψ_L.comp (algebraMap R (Localization.Away (f r₁))) =
             algebraMap R (Localization.Away (f r₁ * f r₂)) →
           ψ_R.comp (algebraMap R (Localization.Away (f r₂))) =
             algebraMap R (Localization.Away (f r₁ * f r₂)) →
           algebraMap R (Localization.Away (f r₁ * f r₂)) ((f r₁ * f r₂) ^ e) * ψ_L (v r₁).1 =
             algebraMap R (Localization.Away (f r₁ * f r₂)) (G r₁ r₂) * ψ_R (v r₂).1) := by
    intro R _ _ _ m f U V G G' hUV hGG' hGU hCoc r₀ hNt₀ z₀ hz₀
    obtain ⟨hf₀_ne, -, -, -⟩ := hAwayDomIC (f r₀) hNt₀
    have hex_all : ∀ r : Fin m, ∃ z_r : Units (Localization.Away (f r)),
        Nontrivial (Localization.Away (f r)) →
          ∀ (ψ_L : Localization.Away (f r₀) →+* Localization.Away (f r₀ * f r))
            (ψ_R : Localization.Away (f r) →+* Localization.Away (f r₀ * f r)),
            ψ_L.comp (algebraMap R (Localization.Away (f r₀))) =
              algebraMap R (Localization.Away (f r₀ * f r)) →
            ψ_R.comp (algebraMap R (Localization.Away (f r))) =
              algebraMap R (Localization.Away (f r₀ * f r)) →
            algebraMap R (Localization.Away (f r₀ * f r)) ((f r₀ * f r) ^ e) * ψ_L z₀.1 =
              algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) * ψ_R z_r.1 := by
      intro r
      by_cases hNt_r : Nontrivial (Localization.Away (f r))
      · obtain ⟨hfr_ne, hDom_Sr, hIC_Sr, hinj_Sr⟩ := hAwayDomIC (f r) hNt_r
        have hd_unit : IsUnit (algebraMap R (Localization.Away (f r₀ * f r)) (f r₀ * f r)) :=
          IsLocalization.Away.algebraMap_isUnit (f r₀ * f r)
        have hmul_u : IsUnit (algebraMap R (Localization.Away (f r₀ * f r)) (f r₀) *
            algebraMap R (Localization.Away (f r₀ * f r)) (f r)) := by
          rwa [← map_mul]
        obtain ⟨hf0_unit, hfr_unit⟩ := hUnitOfMul hmul_u
        obtain ⟨ψ_Lc, hψ_Lc_comp⟩ :=
          hAwayLiftHom (S := Localization.Away (f r₀)) (f r₀)
            (algebraMap R (Localization.Away (f r₀ * f r))) hf0_unit
        obtain ⟨ψ_Rc, hψ_Rc_comp⟩ :=
          hAwayLiftHom (S := Localization.Away (f r)) (f r)
            (algebraMap R (Localization.Away (f r₀ * f r))) hfr_unit
        have hde_unit : IsUnit (algebraMap R (Localization.Away (f r₀ * f r))
            ((f r₀ * f r) ^ e)) := by
          rw [map_pow]; exact hd_unit.pow e
        rcases hde_unit with ⟨u_de, hu_de_val⟩
        let w_r : Localization.Away (f r₀ * f r) :=
          algebraMap R (Localization.Away (f r₀ * f r)) (G' r₀ r) * ↑u_de⁻¹ * ψ_Lc z₀.1
        have hGw : algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) * w_r =
            algebraMap R (Localization.Away (f r₀ * f r)) ((f r₀ * f r) ^ e) * ψ_Lc z₀.1 := by
          dsimp only [w_r]
          have hGG'_loc : algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) *
              algebraMap R (Localization.Away (f r₀ * f r)) (G' r₀ r) =
              (u_de : Localization.Away (f r₀ * f r)) * (u_de : Localization.Away (f r₀ * f r)) := by
            rw [hu_de_val, ← map_mul, ← map_mul, hGG' r₀ r]
            congr 1; ring
          calc
            algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) *
                (algebraMap R (Localization.Away (f r₀ * f r)) (G' r₀ r) * ↑u_de⁻¹ * ψ_Lc z₀.1)
              = ((algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) *
                  algebraMap R (Localization.Away (f r₀ * f r)) (G' r₀ r)) * ↑u_de⁻¹) *
                  ψ_Lc z₀.1 := by ring
            _ = (((u_de : Localization.Away (f r₀ * f r)) *
                  (u_de : Localization.Away (f r₀ * f r))) * ↑u_de⁻¹) * ψ_Lc z₀.1 := by
                rw [hGG'_loc]
            _ = (u_de : Localization.Away (f r₀ * f r)) * ψ_Lc z₀.1 := by
                rw [mul_assoc (u_de : Localization.Away (f r₀ * f r)), Units.mul_inv, mul_one]
            _ = algebraMap R (Localization.Away (f r₀ * f r)) ((f r₀ * f r) ^ e) * ψ_Lc z₀.1 := by
                rw [hu_de_val]
        have hG_unit : IsUnit (algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r)) := by
          refine (hUnitOfMul (y := algebraMap R (Localization.Away (f r₀ * f r)) (G' r₀ r)) ?_).1
          rw [← map_mul, hGG' r₀ r, map_pow]
          exact hd_unit.pow (2 * e)
        have hw_pow : w_r ^ ℓ = ψ_Rc (algebraMap R (Localization.Away (f r)) (U r)) := by
          rcases hG_unit.pow ℓ with ⟨uG, huG⟩
          have hmul_eq : algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) ^ ℓ * w_r ^ ℓ =
              algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) ^ ℓ *
                ψ_Rc (algebraMap R (Localization.Away (f r)) (U r)) := by
            calc
              algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) ^ ℓ * w_r ^ ℓ
                = (algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) * w_r) ^ ℓ :=
                  (mul_pow _ _ _).symm
              _ = (algebraMap R (Localization.Away (f r₀ * f r)) ((f r₀ * f r) ^ e) *
                    ψ_Lc z₀.1) ^ ℓ := by rw [hGw]
              _ = algebraMap R (Localization.Away (f r₀ * f r)) ((f r₀ * f r) ^ e) ^ ℓ *
                    ψ_Lc (z₀.1 ^ ℓ) := by rw [mul_pow, ← map_pow ψ_Lc]
              _ = algebraMap R (Localization.Away (f r₀ * f r)) (((f r₀ * f r) ^ e) ^ ℓ) *
                    ψ_Lc (algebraMap R (Localization.Away (f r₀)) (U r₀)) := by
                  rw [← map_pow, hz₀]
              _ = algebraMap R (Localization.Away (f r₀ * f r)) ((f r₀ * f r) ^ (ℓ * e)) *
                    algebraMap R (Localization.Away (f r₀ * f r)) (U r₀) := by
                  have hexp : ((f r₀ * f r) ^ e) ^ ℓ = (f r₀ * f r) ^ (ℓ * e) := by ring
                  rw [hexp, hcomp_app hψ_Lc_comp (U r₀)]
              _ = algebraMap R (Localization.Away (f r₀ * f r))
                    ((f r₀ * f r) ^ (ℓ * e) * U r₀) := (map_mul _ _ _).symm
              _ = algebraMap R (Localization.Away (f r₀ * f r)) ((G r₀ r) ^ ℓ * U r) := by
                  rw [← hGU r₀ r]
              _ = algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) ^ ℓ *
                    algebraMap R (Localization.Away (f r₀ * f r)) (U r) := by rw [map_mul, map_pow]
              _ = algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) ^ ℓ *
                    ψ_Rc (algebraMap R (Localization.Away (f r)) (U r)) := by
                  rw [← hcomp_app hψ_Rc_comp (U r)]
          calc
            w_r ^ ℓ = ↑uG⁻¹ * (↑uG * w_r ^ ℓ) := by rw [← mul_assoc, Units.inv_mul, one_mul]
            _ = ↑uG⁻¹ * (algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) ^ ℓ * w_r ^ ℓ) := by
                rw [huG]
            _ = ↑uG⁻¹ * (algebraMap R (Localization.Away (f r₀ * f r)) (G r₀ r) ^ ℓ *
                  ψ_Rc (algebraMap R (Localization.Away (f r)) (U r))) := by rw [hmul_eq]
            _ = ↑uG⁻¹ * (↑uG * ψ_Rc (algebraMap R (Localization.Away (f r)) (U r))) := by rw [huG]
            _ = ψ_Rc (algebraMap R (Localization.Away (f r)) (U r)) := by
                rw [← mul_assoc, Units.inv_mul, one_mul]
        have _ : IsDomain (Localization.Away (f r)) := hDom_Sr
        have _ : IsIntegrallyClosed (Localization.Away (f r)) := hIC_Sr
        let θ_r : R →+* FractionRing (Localization.Away (f r)) :=
          (algebraMap (Localization.Away (f r)) (FractionRing (Localization.Away (f r)))).comp
            (algebraMap R (Localization.Away (f r)))
        have hθ_r_inj : Function.Injective θ_r :=
          (hFracInj (Localization.Away (f r))).comp hinj_Sr
        obtain ⟨ι_Kr, hι_Kr_comp, hι_Kr_inj⟩ :=
          @hAwayLiftInj R (Localization.Away (f r₀ * f r))
            (FractionRing (Localization.Away (f r))) _ _ _
            (fldOfDom (Localization.Away (f r)))
            (f r₀ * f r) _ θ_r hθ_r_inj (mul_ne_zero hf₀_ne hfr_ne)
        have hι_Rc : ι_Kr.comp ψ_Rc =
            algebraMap (Localization.Away (f r)) (FractionRing (Localization.Away (f r))) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers (f r))
          rw [RingHom.comp_assoc, hψ_Rc_comp, hι_Kr_comp]
        have hb_pow : (ι_Kr w_r) ^ ℓ =
            algebraMap (Localization.Away (f r)) (FractionRing (Localization.Away (f r)))
              (algebraMap R (Localization.Away (f r)) (U r)) := by
          rw [← map_pow, hw_pow, hcomp_app hι_Rc (algebraMap R (Localization.Away (f r)) (U r))]
        have hUV_unit : IsUnit (algebraMap R (Localization.Away (f r)) (U r) *
            algebraMap R (Localization.Away (f r)) (V r)) := by
          rw [← map_mul, hUV r, map_pow]
          exact (IsLocalization.Away.algebraMap_isUnit (f r)).pow d_u
        obtain ⟨z_r, hz_r_K, -⟩ :=
          hDescentUnit (Localization.Away (f r))
            (algebraMap R (Localization.Away (f r)) (U r))
            (algebraMap R (Localization.Away (f r)) (V r)) hUV_unit (ι_Kr w_r) hb_pow
        have hRc_zr : ψ_Rc z_r.1 = w_r := by
          apply hι_Kr_inj
          calc
            ι_Kr (ψ_Rc z_r.1) =
                algebraMap (Localization.Away (f r))
                  (FractionRing (Localization.Away (f r))) z_r.1 :=
              hcomp_app hι_Rc z_r.1
            _ = ι_Kr w_r := hz_r_K
        refine ⟨z_r, fun _ ψ_L ψ_R hψ_L hψ_R => ?_⟩
        have hL_eq : ψ_L = ψ_Lc :=
          IsLocalization.ringHom_ext (Submonoid.powers (f r₀)) (hψ_L.trans hψ_Lc_comp.symm)
        have hR_eq : ψ_R = ψ_Rc :=
          IsLocalization.ringHom_ext (Submonoid.powers (f r)) (hψ_R.trans hψ_Rc_comp.symm)
        rw [hL_eq, hR_eq, hRc_zr, hGw]
      · exact ⟨1, fun h => False.elim (hNt_r h)⟩
    obtain ⟨v, hv_rel⟩ := Classical.axiomOfChoice hex_all
    refine ⟨v, hv_rel, fun r₁ r₂ ψ_L ψ_R hψ_L hψ_R => ?_⟩
    by_cases hNt₁ : Nontrivial (Localization.Away (f r₁))
    · by_cases hNt₂ : Nontrivial (Localization.Away (f r₂))
      · obtain ⟨hfr₁_ne, -, -, -⟩ := hAwayDomIC (f r₁) hNt₁
        obtain ⟨hfr₂_ne, -, -, -⟩ := hAwayDomIC (f r₂) hNt₂
        have hη_inj : Function.Injective (algebraMap R (FractionRing R)) := hFracInj R
        let η : R →+* FractionRing R := algebraMap R (FractionRing R)
        obtain ⟨ι₀, hι₀_c, -⟩ :=
          hAwayLiftInj (S := Localization.Away (f r₀)) (f r₀) η hη_inj hf₀_ne
        obtain ⟨ι₁, hι₁_c, -⟩ :=
          hAwayLiftInj (S := Localization.Away (f r₁)) (f r₁) η hη_inj hfr₁_ne
        obtain ⟨ι₂, hι₂_c, -⟩ :=
          hAwayLiftInj (S := Localization.Away (f r₂)) (f r₂) η hη_inj hfr₂_ne
        obtain ⟨ι₀₁, hι₀₁_c, -⟩ :=
          hAwayLiftInj (S := Localization.Away (f r₀ * f r₁)) (f r₀ * f r₁) η hη_inj
            (mul_ne_zero hf₀_ne hfr₁_ne)
        obtain ⟨ι₀₂, hι₀₂_c, -⟩ :=
          hAwayLiftInj (S := Localization.Away (f r₀ * f r₂)) (f r₀ * f r₂) η hη_inj
            (mul_ne_zero hf₀_ne hfr₂_ne)
        obtain ⟨ι₁₂, hι₁₂_c, hι₁₂_inj⟩ :=
          hAwayLiftInj (S := Localization.Away (f r₁ * f r₂)) (f r₁ * f r₂) η hη_inj
            (mul_ne_zero hfr₁_ne hfr₂_ne)
        have hrelK : ∀ (r : Fin m), Nontrivial (Localization.Away (f r)) →
            ∀ (ι_r : Localization.Away (f r) →+* FractionRing R)
              (ι_0r : Localization.Away (f r₀ * f r) →+* FractionRing R),
              ι_r.comp (algebraMap R (Localization.Away (f r))) = η →
              ι_0r.comp (algebraMap R (Localization.Away (f r₀ * f r))) = η →
              η (G r₀ r) * ι_r (v r).1 = η ((f r₀ * f r) ^ e) * ι₀ z₀.1 := by
          intro r hNt_r ι_r ι_0r hι_r hι_0r
          have hd0r : IsUnit (algebraMap R (Localization.Away (f r₀ * f r)) (f r₀) *
              algebraMap R (Localization.Away (f r₀ * f r)) (f r)) := by
            rw [← map_mul]
            exact IsLocalization.Away.algebraMap_isUnit (f r₀ * f r)
          obtain ⟨hu_L, hu_R⟩ := hUnitOfMul hd0r
          obtain ⟨ψ_Lc, hLc⟩ :=
            hAwayLiftHom (S := Localization.Away (f r₀)) (f r₀)
              (algebraMap R (Localization.Away (f r₀ * f r))) hu_L
          obtain ⟨ψ_Rc, hRc⟩ :=
            hAwayLiftHom (S := Localization.Away (f r)) (f r)
              (algebraMap R (Localization.Away (f r₀ * f r))) hu_R
          have heq := congrArg ι_0r (hv_rel r hNt_r ψ_Lc ψ_Rc hLc hRc)
          simp only [map_mul] at heq
          have hcL : ι_0r.comp ψ_Lc = ι₀ :=
            IsLocalization.ringHom_ext (Submonoid.powers (f r₀))
              (by rw [RingHom.comp_assoc, hLc, hι_0r, hι₀_c])
          have hcR : ι_0r.comp ψ_Rc = ι_r :=
            IsLocalization.ringHom_ext (Submonoid.powers (f r))
              (by rw [RingHom.comp_assoc, hRc, hι_0r, hι_r])
          rw [hcomp_app hι_0r ((f r₀ * f r) ^ e),
            hcomp_app hι_0r (G r₀ r),
            hcomp_app hcL z₀.1, hcomp_app hcR (v r).1] at heq
          exact heq.symm
        have hK₁ := hrelK r₁ hNt₁ ι₁ ι₀₁ hι₁_c hι₀₁_c
        have hK₂ := hrelK r₂ hNt₂ ι₂ ι₀₂ hι₂_c hι₀₂_c
        have hCoc_R : G r₀ r₁ * G r₁ r₂ = (f r₁) ^ (2 * e) * G r₀ r₂ := by
          have hpow_ne : (f r₀ * f r₁ * f r₂) ^ T_ann ≠ 0 :=
            pow_ne_zero T_ann (mul_ne_zero (mul_ne_zero hf₀_ne hfr₁_ne) hfr₂_ne)
          exact sub_eq_zero.mp ((mul_eq_zero.mp (hCoc r₀ r₁ r₂)).resolve_left hpow_ne)
        have hG₀₁_ne : η (G r₀ r₁) ≠ 0 := by
          intro h0
          have hR0 : G r₀ r₁ = 0 := hη_inj (h0.trans (map_zero η).symm)
          have hprod0 : (f r₀ * f r₁) ^ (2 * e) = 0 := by
            rw [← hGG' r₀ r₁, hR0, zero_mul]
          exact pow_ne_zero (2 * e) (mul_ne_zero hf₀_ne hfr₁_ne) hprod0
        have hG₀₂_ne : η (G r₀ r₂) ≠ 0 := by
          intro h0
          have hR0 : G r₀ r₂ = 0 := hη_inj (h0.trans (map_zero η).symm)
          have hprod0 : (f r₀ * f r₂) ^ (2 * e) = 0 := by
            rw [← hGG' r₀ r₂, hR0, zero_mul]
          exact pow_ne_zero (2 * e) (mul_ne_zero hf₀_ne hfr₂_ne) hprod0
        apply hι₁₂_inj
        simp only [map_mul]
        have hcL : ι₁₂.comp ψ_L = ι₁ :=
          IsLocalization.ringHom_ext (Submonoid.powers (f r₁))
            (by rw [RingHom.comp_assoc, hψ_L, hι₁₂_c, hι₁_c])
        have hcR : ι₁₂.comp ψ_R = ι₂ :=
          IsLocalization.ringHom_ext (Submonoid.powers (f r₂))
            (by rw [RingHom.comp_assoc, hψ_R, hι₁₂_c, hι₂_c])
        rw [hcomp_app hι₁₂_c ((f r₁ * f r₂) ^ e), hcomp_app hι₁₂_c (G r₁ r₂),
          hcomp_app hcL (v r₁).1, hcomp_app hcR (v r₂).1]
        apply @hFieldCancel (FractionRing R) (fldOfDom R) _ _ _
          (@hFieldMulNe (FractionRing R) (fldOfDom R) _ _ hG₀₁_ne hG₀₂_ne)
        have hscalar : G r₀ r₂ * ((f r₁ * f r₂) ^ e * (f r₀ * f r₁) ^ e) =
            ((f r₁) ^ (2 * e) * G r₀ r₂) * (f r₀ * f r₂) ^ e := by
          ring
        calc
          (η (G r₀ r₁) * η (G r₀ r₂)) * (η ((f r₁ * f r₂) ^ e) * ι₁ (v r₁).1)
            = η (G r₀ r₂) * η ((f r₁ * f r₂) ^ e) * (η (G r₀ r₁) * ι₁ (v r₁).1) := by ring
          _ = η (G r₀ r₂) * η ((f r₁ * f r₂) ^ e) * (η ((f r₀ * f r₁) ^ e) * ι₀ z₀.1) := by
              rw [hK₁]
          _ = η (G r₀ r₂ * ((f r₁ * f r₂) ^ e * (f r₀ * f r₁) ^ e)) * ι₀ z₀.1 := by
              simp only [map_mul]; ring
          _ = η (((f r₁) ^ (2 * e) * G r₀ r₂) * (f r₀ * f r₂) ^ e) * ι₀ z₀.1 := by rw [hscalar]
          _ = η (G r₀ r₁ * G r₁ r₂) * (η ((f r₀ * f r₂) ^ e) * ι₀ z₀.1) := by
              rw [← hCoc_R]; simp only [map_mul]; ring
          _ = η (G r₀ r₁ * G r₁ r₂) * (η (G r₀ r₂) * ι₂ (v r₂).1) := by rw [← hK₂]
          _ = (η (G r₀ r₁) * η (G r₀ r₂)) * (η (G r₁ r₂) * ι₂ (v r₂).1) := by
              simp only [map_mul]; ring
      · have hSub := hSubHom hNt₂ ψ_R
        exact @Subsingleton.elim _ hSub _ _
    · have hSub := hSubHom hNt₁ ψ_L
      exact @Subsingleton.elim _ hSub _ _

  
  have h_s3 : ∀ (S : Type u) [CommRing S] [IsDomain S] (u : S),
      (∀ b : FractionRing S, b ^ ℓ ≠ algebraMap S (FractionRing S) u) →
      IsDomain (AdjoinRoot ((Polynomial.X : Polynomial S) ^ ℓ - Polynomial.C u)) := by
    intro S _ _ u hNoRoot
    let K := FractionRing S
    let ι : S →+* K := algebraMap S K
    have hι_inj : Function.Injective ι := IsFractionRing.injective S K
    let P_S : Polynomial S := (Polynomial.X : Polynomial S) ^ ℓ - Polynomial.C u
    let P_K : Polynomial K := (Polynomial.X : Polynomial K) ^ ℓ - Polynomial.C (ι u)
    have hIrr_PK : Irreducible P_K := X_pow_sub_C_irreducible_of_prime hPrime hNoRoot
    let fact_PK : Fact (Irreducible P_K) := ⟨hIrr_PK⟩
    let L := AdjoinRoot P_K
    have hDom_L : IsDomain L :=
      @Field.isDomain L (@AdjoinRoot.instField K _ P_K fact_PK)
    have heval : Polynomial.eval₂ ((AdjoinRoot.of P_K).comp ι) (AdjoinRoot.root P_K) P_S = 0 := by
      dsimp [P_S]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, RingHom.comp_apply]
      have h0 : Polynomial.eval₂ (AdjoinRoot.of P_K) (AdjoinRoot.root P_K) P_K = 0 :=
        AdjoinRoot.eval₂_root P_K
      dsimp [P_K] at h0
      rwa [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at h0
    let Φ : AdjoinRoot P_S →+* L :=
      AdjoinRoot.lift ((AdjoinRoot.of P_K).comp ι) (AdjoinRoot.root P_K) heval
    have hMon_S : P_S.Monic := Polynomial.monic_X_pow_sub_C u hℓ_ne
    have hMon_K : P_K.Monic := Polynomial.monic_X_pow_sub_C (ι u) hℓ_ne
    have hDeg_S : P_S.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    have hDeg_K : P_K.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    let pb_S := AdjoinRoot.powerBasis' hMon_S
    let pb_K := AdjoinRoot.powerBasis' hMon_K
    have hdim_eq : pb_S.dim = pb_K.dim := by
      rw [AdjoinRoot.powerBasis'_dim, AdjoinRoot.powerBasis'_dim, hDeg_S, hDeg_K]
    let e_idx : Fin pb_S.dim ≃ Fin pb_K.dim := finCongr hdim_eq
    have hΦ_inj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx0
      have hx_sum : x = ∑ i : Fin pb_S.dim,
          AdjoinRoot.of P_S (pb_S.basis.repr x i) * (AdjoinRoot.root P_S) ^ (i : ℕ) := by
        conv_lhs => rw [← pb_S.basis.sum_repr x]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def, pb_S.basis_eq_pow i, AdjoinRoot.powerBasis'_gen]
        rfl
      have hΦ_sum : Φ x = ∑ j : Fin pb_K.dim,
          (ι (pb_S.basis.repr x (e_idx.symm j))) • pb_K.basis j := by
        conv_lhs => rw [hx_sum]
        rw [map_sum, ← e_idx.symm.sum_comp]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_pow, AdjoinRoot.lift_of, AdjoinRoot.lift_root, RingHom.comp_apply,
          Algebra.smul_def, pb_K.basis_eq_pow j, AdjoinRoot.powerBasis'_gen]
        have hval : ((e_idx.symm j : Fin pb_S.dim) : ℕ) = (j : ℕ) := rfl
        rw [hval]
        rfl
      rw [hΦ_sum] at hx0
      have hlin := Fintype.linearIndependent_iff.mp pb_K.basis.linearIndependent
        (fun j => ι (pb_S.basis.repr x (e_idx.symm j))) hx0
      apply pb_S.basis.repr.injective
      ext i
      rw [map_zero, Finsupp.coe_zero, Pi.zero_apply]
      apply hι_inj
      rw [map_zero]
      simpa using hlin (e_idx i)
    exact @Function.Injective.isDomain L (AdjoinRoot P_S) _ hDom_L _ _ _ _ Φ hΦ_inj

  
  have h_s4 : ∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y] [IrreducibleSpace Y]
      (π : X → Y), Continuous π → Function.Surjective π →
      ∀ (ι : Type) (V : ι → Set Y),
        (∀ i : ι, IsOpen (V i)) →
        (⋃ i : ι, V i) = Set.univ →
        (∀ i : ι, (V i).Nonempty → IsIrreducible (π ⁻¹' V i)) →
        IrreducibleSpace X := by
    intro X Y _ _ _ π hπ_cont hπ_surj ι V hV_open hV_cov hPre_irred
    obtain ⟨y₀⟩ := (inferInstance : Nonempty Y)
    obtain ⟨x₀, -⟩ := hπ_surj y₀
    have hPreX : PreirreducibleSpace X := by
      refine ⟨fun O₁ O₂ hO₁ hO₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩ => ?_⟩
      have hx₁_mem : π x₁ ∈ ⋃ i : ι, V i := by rw [hV_cov]; trivial
      have hx₂_mem : π x₂ ∈ ⋃ i : ι, V i := by rw [hV_cov]; trivial
      obtain ⟨i₁, hy₁⟩ := Set.mem_iUnion.mp hx₁_mem
      obtain ⟨i₂, hy₂⟩ := Set.mem_iUnion.mp hx₂_mem
      obtain ⟨y₁₂, hy₁₂_1, hy₁₂_2⟩ :=
        nonempty_preirreducible_inter (hV_open i₁) (hV_open i₂) ⟨π x₁, hy₁⟩ ⟨π x₂, hy₂⟩
      obtain ⟨x₁₂, rfl⟩ := hπ_surj y₁₂
      have hW₂_open : IsOpen (π ⁻¹' V i₂) := (hV_open i₂).preimage hπ_cont
      obtain ⟨z, -, hz_O₁, hz_W₂⟩ :=
        (hPre_irred i₁ ⟨π x₁, hy₁⟩).isPreirreducible O₁ (π ⁻¹' V i₂) hO₁ hW₂_open
          ⟨x₁, hy₁, hx₁⟩ ⟨x₁₂, hy₁₂_1, hy₁₂_2⟩
      obtain ⟨w, -, hw_O₁, hw_O₂⟩ :=
        (hPre_irred i₂ ⟨π x₂, hy₂⟩).isPreirreducible O₁ O₂ hO₁ hO₂
          ⟨z, hz_W₂, hz_O₁⟩ ⟨x₂, hy₂, hx₂⟩
      exact ⟨w, trivial, hw_O₁, hw_O₂⟩
    exact { toPreirreducibleSpace := hPreX, toNonempty := ⟨x₀⟩ }

  
  have hNorm₀ : Nontrivial R_bar₀ → IsDomain R_bar₀ ∧ IsIntegrallyClosed R_bar₀ :=
    fun hNt₀ => @h_s1 R_bar₀ _ hNt₀ j₀_k _
  have hNorm₁ : Nontrivial R_bar₁ → IsDomain R_bar₁ ∧ IsIntegrallyClosed R_bar₁ :=
    fun hNt₁ => @h_s1 R_bar₁ _ hNt₁ j₁_k _
  have hOverlapDom : Nontrivial R_bar₀ → Nontrivial R_bar₁ → IsDomain R_bar₀₁ := by
    intro hNt₀ hNt₁
    obtain ⟨m₀_id, hm₀_max⟩ := @Ideal.exists_maximal R_bar₀ _ hNt₀
    obtain ⟨m₁_id, hm₁_max⟩ := @Ideal.exists_maximal R_bar₁ _ hNt₁
    let p₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of R_bar₀)) := ⟨m₀_id, hm₀_max.isPrime⟩
    let p₁ : ↥(AlgebraicGeometry.Spec (CommRingCat.of R_bar₁)) := ⟨m₁_id, hm₁_max.isPrime⟩
    obtain ⟨x, hx₀, hx₁⟩ :=
      @nonempty_preirreducible_inter ↥C₀.left _ _ _ hIrr_C₀.toPreirreducibleSpace
        j₀_k.opensRange.isOpen j₁_k.opensRange.isOpen
        ⟨j₀_k.base p₀, ⟨p₀, rfl⟩⟩ ⟨j₁_k.base p₁, ⟨p₁, rfl⟩⟩
    let W₀₁ : C₀.left.Opens := j₀_k.opensRange ⊓ j₁_k.opensRange
    have hSub₀ : Set.range W₀₁.ι.base ⊆ Set.range j₀_k.base := by
      rintro _ ⟨y, rfl⟩; exact y.2.1
    have hSub₁ : Set.range W₀₁.ι.base ⊆ Set.range j₁_k.base := by
      rintro _ ⟨y, rfl⟩; exact y.2.2
    let g₀ := AlgebraicGeometry.IsOpenImmersion.lift j₀_k W₀₁.ι hSub₀
    let g₁ := AlgebraicGeometry.IsOpenImmersion.lift j₁_k W₀₁.ι hSub₁
    have hg_comm : g₀ ≫ j₀_k = g₁ ≫ j₁_k := by
      rw [AlgebraicGeometry.IsOpenImmersion.lift_fac, AlgebraicGeometry.IsOpenImmersion.lift_fac]
    let m₀₁ := hPb_k.lift g₀ g₁ hg_comm
    have hNe₀₁ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of R_bar₀₁)) :=
      ⟨m₀₁.base ⟨x, hx₀, hx₁⟩⟩
    let alg₀ : Algebra R_bar₀ R_bar₀₁ := ρ_bar₀.toAlgebra
    have hOpen_ρ₀ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar₀)) :=
      @AlgebraicGeometry.IsOpenImmersion.of_isLocalization R_bar₀ R_bar₀₁ _ _ alg₀ t_bar₀ hLoc_bar₀
    have hOpen_comp : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar₀) ≫ j₀_k) :=
      @AlgebraicGeometry.IsOpenImmersion.comp _ _ _
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar₀)) j₀_k hOpen_ρ₀ inferInstance
    have hInt₀₁ : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of R_bar₀₁)) :=
      @hOpenInt (AlgebraicGeometry.Spec (CommRingCat.of R_bar₀₁))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_bar₀) ≫ j₀_k) hOpen_comp hNe₀₁
    exact (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of R_bar₀₁)).mp hInt₀₁

  
  have hNoRoot₀ : ∀ r₀ : Fin m₀, Nontrivial (Localization.Away (f_bar₀ r₀)) →
      ∀ b : FractionRing (Localization.Away (f_bar₀ r₀)),
        b ^ ℓ ≠ algebraMap (Localization.Away (f_bar₀ r₀))
          (FractionRing (Localization.Away (f_bar₀ r₀)))
          (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀)) := by
    intro r₀ hNt_r₀ b hb
    have hNt_R₀ : Nontrivial R_bar₀ := hNtBase (f_bar₀ r₀) hNt_r₀
    obtain ⟨hDom₀, hIC₀⟩ := hNorm₀ hNt_R₀
    have _ : IsDomain R_bar₀ := hDom₀
    have _ : IsIntegrallyClosed R_bar₀ := hIC₀
    obtain ⟨hf₀_ne, hDom_Sr₀, hIC_Sr₀, hinj_Sr₀⟩ := hAwayDomIC (f_bar₀ r₀) hNt_r₀
    have _ : IsDomain (Localization.Away (f_bar₀ r₀)) := hDom_Sr₀
    have _ : IsIntegrallyClosed (Localization.Away (f_bar₀ r₀)) := hIC_Sr₀
    have hUV_r₀ : IsUnit (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀) *
        algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (V_bar₀ r₀)) := by
      rw [← map_mul, hUV₀ r₀, map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit (f_bar₀ r₀)).pow d_u
    obtain ⟨z₀, -, hz₀_pow⟩ :=
      hDescentUnit (Localization.Away (f_bar₀ r₀))
        (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀))
        (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (V_bar₀ r₀)) hUV_r₀ b hb
    obtain ⟨v₀, hv₀_rel, hv₀_cob⟩ :=
      hSingleProp R_bar₀ m₀ f_bar₀ U_bar₀ V_bar₀ G_bar₀₀ G'_bar₀₀
        hUV₀ hGG'₀₀ hGU₀₀ hCoc₀₀₀ r₀ hNt_r₀ z₀ hz₀_pow
    by_cases hEx₁ : ∃ s₀ : Fin m₁, Nontrivial (Localization.Away (f_bar₁ s₀))
    · obtain ⟨s₀, hNt_s₀⟩ := hEx₁
      have hNt_R₁ : Nontrivial R_bar₁ := hNtBase (f_bar₁ s₀) hNt_s₀
      obtain ⟨hDom₁, hIC₁⟩ := hNorm₁ hNt_R₁
      have _ : IsDomain R_bar₁ := hDom₁
      have _ : IsIntegrallyClosed R_bar₁ := hIC₁
      have hDom₀₁ : IsDomain R_bar₀₁ := hOverlapDom hNt_R₀ hNt_R₁
      have _ : IsDomain R_bar₀₁ := hDom₀₁
      obtain ⟨hfs₀_ne, hDom_Ss₀, hIC_Ss₀, hinj_Ss₀⟩ := hAwayDomIC (f_bar₁ s₀) hNt_s₀
      have _ : IsDomain (Localization.Away (f_bar₁ s₀)) := hDom_Ss₀
      have _ : IsIntegrallyClosed (Localization.Away (f_bar₁ s₀)) := hIC_Ss₀
      have ht₀_ne : t_bar₀ ≠ 0 := by
        intro h0
        have h01 : (0 : R_bar₀₁) = 1 := by
          calc (0 : R_bar₀₁) = 0 * ρ_bar₁ t_bar₁ := (zero_mul _).symm
            _ = ρ_bar₀ t_bar₀ * ρ_bar₁ t_bar₁ := by rw [h0, map_zero]
            _ = 1 := ht_bar₀₁
        exact zero_ne_one h01
      have ht₁_ne : t_bar₁ ≠ 0 := by
        intro h0
        have h01 : (0 : R_bar₀₁) = 1 := by
          calc (0 : R_bar₀₁) = ρ_bar₀ t_bar₀ * 0 := (mul_zero _).symm
            _ = ρ_bar₀ t_bar₀ * ρ_bar₁ t_bar₁ := by rw [h0, map_zero]
            _ = 1 := ht_bar₀₁
        exact zero_ne_one h01
      have hρ₀_inj : Function.Injective ρ_bar₀ := by
        let alg₀ : Algebra R_bar₀ R_bar₀₁ := ρ_bar₀.toAlgebra
        have _ : IsLocalization.Away t_bar₀ R_bar₀₁ := hLoc_bar₀
        have hle : Submonoid.powers t_bar₀ ≤ nonZeroDivisors R_bar₀ := by
          rintro _ ⟨n, rfl⟩; exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n ht₀_ne)
        exact IsLocalization.injective R_bar₀₁ hle
      have hρ₁_inj : Function.Injective ρ_bar₁ := by
        let alg₁ : Algebra R_bar₁ R_bar₀₁ := ρ_bar₁.toAlgebra
        have _ : IsLocalization.Away t_bar₁ R_bar₀₁ := hLoc_bar₁
        have hle : Submonoid.powers t_bar₁ ≤ nonZeroDivisors R_bar₁ := by
          rintro _ ⟨n, rfl⟩; exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n ht₁_ne)
        exact IsLocalization.injective R_bar₀₁ hle
      let d₀ : R_bar₀₁ := ρ_bar₀ (f_bar₀ r₀) * ρ_bar₁ (f_bar₁ s₀)
      have ha₀_ne : ρ_bar₀ (f_bar₀ r₀) ≠ 0 :=
        fun h0 => hf₀_ne (hρ₀_inj (h0.trans (map_zero ρ_bar₀).symm))
      have hb₀_ne : ρ_bar₁ (f_bar₁ s₀) ≠ 0 :=
        fun h0 => hfs₀_ne (hρ₁_inj (h0.trans (map_zero ρ_bar₁).symm))
      have hd₀_ne : d₀ ≠ 0 := mul_ne_zero ha₀_ne hb₀_ne
      have hd₀_unit : IsUnit (algebraMap R_bar₀₁ (Localization.Away d₀) d₀) :=
        IsLocalization.Away.algebraMap_isUnit d₀
      have hmul_ab : IsUnit (algebraMap R_bar₀₁ (Localization.Away d₀) (ρ_bar₀ (f_bar₀ r₀)) *
          algebraMap R_bar₀₁ (Localization.Away d₀) (ρ_bar₁ (f_bar₁ s₀))) := by
        rw [← map_mul]; exact hd₀_unit
      obtain ⟨ha₀_unit, hb₀_unit⟩ := hUnitOfMul hmul_ab
      obtain ⟨ψ_Lc01, hψ_Lc01⟩ :=
        hAwayLiftHom (S := Localization.Away (f_bar₀ r₀)) (f_bar₀ r₀)
          ((algebraMap R_bar₀₁ (Localization.Away d₀)).comp ρ_bar₀) ha₀_unit
      obtain ⟨ψ_Rc01, hψ_Rc01⟩ :=
        hAwayLiftHom (S := Localization.Away (f_bar₁ s₀)) (f_bar₁ s₀)
          ((algebraMap R_bar₀₁ (Localization.Away d₀)).comp ρ_bar₁) hb₀_unit
      have hde₀_unit : IsUnit (algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e)) := by
        rw [map_pow]; exact hd₀_unit.pow e
      rcases hde₀_unit with ⟨u_de₀, hu_de₀_val⟩
      let w₁ : Localization.Away d₀ :=
        algebraMap R_bar₀₁ (Localization.Away d₀) (G'_bar₀₁ r₀ s₀) * ↑u_de₀⁻¹ * ψ_Lc01 z₀.1
      have hGw₁ : algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) * w₁ =
          algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) * ψ_Lc01 z₀.1 := by
        dsimp only [w₁]
        have hGG'_loc : algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) *
            algebraMap R_bar₀₁ (Localization.Away d₀) (G'_bar₀₁ r₀ s₀) =
            (u_de₀ : Localization.Away d₀) * (u_de₀ : Localization.Away d₀) := by
          rw [hu_de₀_val, ← map_mul, ← map_mul, hGG'₀₁ r₀ s₀]
          congr 1; dsimp [d₀]; ring
        calc
          algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) *
              (algebraMap R_bar₀₁ (Localization.Away d₀) (G'_bar₀₁ r₀ s₀) * ↑u_de₀⁻¹ *
                ψ_Lc01 z₀.1)
            = ((algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) *
                algebraMap R_bar₀₁ (Localization.Away d₀) (G'_bar₀₁ r₀ s₀)) * ↑u_de₀⁻¹) *
                ψ_Lc01 z₀.1 := by ring
          _ = (((u_de₀ : Localization.Away d₀) * (u_de₀ : Localization.Away d₀)) * ↑u_de₀⁻¹) *
                ψ_Lc01 z₀.1 := by rw [hGG'_loc]
          _ = (u_de₀ : Localization.Away d₀) * ψ_Lc01 z₀.1 := by
              rw [mul_assoc (u_de₀ : Localization.Away d₀), Units.mul_inv, mul_one]
          _ = algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) * ψ_Lc01 z₀.1 := by
              rw [hu_de₀_val]
      have hG₀₁_unit : IsUnit (algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀)) := by
        refine (hUnitOfMul
          (y := algebraMap R_bar₀₁ (Localization.Away d₀) (G'_bar₀₁ r₀ s₀)) ?_).1
        rw [← map_mul, hGG'₀₁ r₀ s₀, map_pow]
        exact hd₀_unit.pow (2 * e)
      have hw₁_pow : w₁ ^ ℓ =
          ψ_Rc01 (algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (U_bar₁ s₀)) := by
        rcases hG₀₁_unit.pow ℓ with ⟨uG, huG⟩
        have hmul_eq : algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) ^ ℓ * w₁ ^ ℓ =
            algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) ^ ℓ *
              ψ_Rc01 (algebraMap R_bar₁ (Localization.Away (f_bar₁ s₀)) (U_bar₁ s₀)) := by
          calc
            algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) ^ ℓ * w₁ ^ ℓ
              = (algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) * w₁) ^ ℓ :=
                (mul_pow _ _ _).symm
            _ = (algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) * ψ_Lc01 z₀.1) ^ ℓ := by
                rw [hGw₁]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ e) ^ ℓ * ψ_Lc01 (z₀.1 ^ ℓ) := by
                rw [mul_pow, ← map_pow ψ_Lc01]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) ((d₀ ^ e) ^ ℓ) *
                  ψ_Lc01 (algebraMap R_bar₀ (Localization.Away (f_bar₀ r₀)) (U_bar₀ r₀)) := by
                rw [← map_pow, hz₀_pow]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ (ℓ * e)) *
                  algebraMap R_bar₀₁ (Localization.Away d₀) (ρ_bar₀ (U_bar₀ r₀)) := by
                have hexp : (d₀ ^ e) ^ ℓ = d₀ ^ (ℓ * e) := by ring
                rw [hexp, hcomp_app hψ_Lc01 (U_bar₀ r₀), RingHom.comp_apply]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) (d₀ ^ (ℓ * e) * ρ_bar₀ (U_bar₀ r₀)) :=
                (map_mul _ _ _).symm
            _ = algebraMap R_bar₀₁ (Localization.Away d₀)
                  ((G_bar₀₁ r₀ s₀) ^ ℓ * ρ_bar₁ (U_bar₁ s₀)) := by
                dsimp [d₀]; rw [← hGU₀₁ r₀ s₀]
            _ = algebraMap R_bar₀₁ (Localization.Away d₀) (G_bar₀₁ r₀ s₀) ^ ℓ *
