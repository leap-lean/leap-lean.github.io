    have hφ_spa : Ideal.span ({φ_O a_stk} : Set R_O) = IsLocalRing.maximalIdeal R_O ^ na := by
      calc
        Ideal.span ({φ_O a_stk} : Set R_O)
          = Ideal.map φ_O (Ideal.span ({a_stk} : Set R_U)) := by
            rw [Ideal.map_span, Set.image_singleton]
        _ = Ideal.map φ_O (IsLocalRing.maximalIdeal R_U ^ na) := by rw [ha_span]
        _ = IsLocalRing.maximalIdeal R_O ^ na := hMapPow_O na
    have hφ_spb : Ideal.span ({φ_O b_stk} : Set R_O) = IsLocalRing.maximalIdeal R_O ^ nb := by
      calc
        Ideal.span ({φ_O b_stk} : Set R_O)
          = Ideal.map φ_O (Ideal.span ({b_stk} : Set R_U)) := by
            rw [Ideal.map_span, Set.image_singleton]
        _ = Ideal.map φ_O (IsLocalRing.maximalIdeal R_U ^ nb) := by rw [hb_span]
        _ = IsLocalRing.maximalIdeal R_O ^ nb := hMapPow_O nb
    let E_O : Type u :=
      ↑((CategoryTheory.Limits.pullback O_et.hom η_C).presheaf.obj (Opposite.op ⊤))
    let ev_O : E_O →+* FractionRing R_O :=
      evRing O_et.left O_et.hom y_O.1 (hDVR_et O_et y_O).choose (hInj_et O_et y_O)
    let u_sO : Units E_O := Additive.toMul (((weilEtaleKPresheaf C.left).map j_O.op).hom s)
    let u_ev := Units.map ev_O.toMonoidHom u_sO
    have hev_eq : algebraMap R_O (FractionRing R_O) (φ_O a_stk) =
        (u_ev : FractionRing R_O) * algebraMap R_O (FractionRing R_O) (φ_O b_stk) := by
      let lhs_b : E_O := ((CategoryTheory.Limits.pullback.fst O_et.hom η_C).appTop).hom b₀
      let rhs_a : E_O := ((CategoryTheory.Limits.pullback.fst O_et.hom η_C).appTop).hom a₀
      have h_rat' : lhs_b * u_sO.val = rhs_a := h_rat
      have ha_ev : ev_O rhs_a = algebraMap R_O (FractionRing R_O) (φ_O a_stk) :=
        (hev_fst O_et.left O_et.hom y_O.1 (hDVR_et O_et y_O).choose (hInj_et O_et y_O) a₀).trans
          (congrArg (algebraMap R_O (FractionRing R_O)) (h_germ_open U O y.1 hy a₀).symm)
      have hb_ev : ev_O lhs_b = algebraMap R_O (FractionRing R_O) (φ_O b_stk) :=
        (hev_fst O_et.left O_et.hom y_O.1 (hDVR_et O_et y_O).choose (hInj_et O_et y_O) b₀).trans
          (congrArg (algebraMap R_O (FractionRing R_O)) (h_germ_open U O y.1 hy b₀).symm)
      have h_ap : ev_O rhs_a = ev_O lhs_b * (u_ev : FractionRing R_O) :=
        (congrArg ev_O h_rat'.symm).trans (ev_O.map_mul lhs_b u_sO.val)
      exact (ha_ev.symm.trans (h_ap.trans (congrArg (· * (u_ev : FractionRing R_O)) hb_ev))).trans
        (mul_comm _ _)
    exact (hord_Uy_spec O_et y_O).2.1 u_ev (φ_O a_stk) (φ_O b_stk) na nb
      hφa_ne hφb_ne hev_eq hφ_spa hφ_spb

theorem weil_etale_p1_canonical_divisor_degree_reduction (k : Type u) [Field k] [IsAlgClosed k]
    (X_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [CompactSpace ↥X_ov.left] [X_ov.left.IsSeparated] [AlgebraicGeometry.IsIntegral X_ov.left]
    (hStrict : ∀ x : { x : ↥X_ov.left // IsClosed ({x} : Set ↥X_ov.left) },
      StrictAnti (fun n : ℕ => IsLocalRing.maximalIdeal ↑(X_ov.left.presheaf.stalk x.1) ^ n))
    (hDVR_X : ∀ x : { x : ↥X_ov.left // IsClosed ({x} : Set ↥X_ov.left) },
      ∃ hDom : IsDomain ↑(X_ov.left.presheaf.stalk x.1),
        @IsDiscreteValuationRing ↑(X_ov.left.presheaf.stalk x.1) _ hDom)
    (Div_sh : CategoryTheory.Sheaf X_ov.left.smallEtaleTopology AddCommGrpCat.{u})
    (ι_gm : weilEtaleGmSheaf X_ov.left ⟶ weilEtaleKSheaf X_ov.left)
    (div_mor : weilEtaleKSheaf X_ov.left ⟶ Div_sh)
    (h0_div : CategoryTheory.CategoryStruct.comp ι_gm div_mor = 0)
    (valDiv : ∀ U : X_ov.left.Etale,
      ↥(Div_sh.obj.obj (Opposite.op U)) →+
        ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) } → ℤ))
    (hValInj_Tid : Function.Injective (valDiv (weilEtaleIdTerminal.{u} X_ov.left)))
    (hValRange_Tid : Set.range (valDiv (weilEtaleIdTerminal.{u} X_ov.left)) =
      { D | { y | D y ≠ 0 }.Finite })
    (hOrd_Tid :
      let U := weilEtaleIdTerminal.{u} X_ov.left
      ∀ (s : ↥((weilEtaleKPresheaf X_ov.left).obj (Opposite.op U)))
        (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥X_ov.left) })
        (O : U.left.Opens) (hy : y.1 ∈ O),
        letI : IrreducibleSpace ↥X_ov.left :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral X_ov.left
        let η_X := X_ov.left.fromSpecStalk (genericPoint ↥X_ov.left)
        let η_K := (CategoryTheory.sheafificationAdjunction X_ov.left.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app (weilEtaleKPresheaf X_ov.left)
        let O_et : X_ov.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp O.ι U.hom)
          (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
        let j_O : O_et ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
        ∀ (a₀ b₀ : ↑(O_et.left.presheaf.obj (Opposite.op ⊤))) (na nb : ℕ),
          ((CategoryTheory.Limits.pullback.fst O_et.hom η_X).appTop).hom b₀ *
              (Additive.toMul (((weilEtaleKPresheaf X_ov.left).map j_O.op).hom s) :
                Units ↑((CategoryTheory.Limits.pullback O_et.hom η_X).presheaf.obj
                  (Opposite.op ⊤))).val =
            ((CategoryTheory.Limits.pullback.fst O_et.hom η_X).appTop).hom a₀ →
          let a_stk : ↑(U.left.presheaf.stalk y.1) :=
            (U.left.presheaf.germ O y.1 hy).hom (O.topIso.hom.hom a₀)
          let b_stk : ↑(U.left.presheaf.stalk y.1) :=
            (U.left.presheaf.germ O y.1 hy).hom (O.topIso.hom.hom b₀)
          a_stk ≠ 0 →
          b_stk ≠ 0 →
          Ideal.span ({a_stk} : Set ↑(U.left.presheaf.stalk y.1)) =
            (IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1)) ^ na →
          Ideal.span ({b_stk} : Set ↑(U.left.presheaf.stalk y.1)) =
            (IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1)) ^ nb →
          valDiv U ((div_mor.hom.app (Opposite.op U)).hom ((η_K.app (Opposite.op U)).hom s)) y =
            (na : ℤ) - (nb : ℤ))
    (hEx_div : (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact)
    (ι_1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) X_ov.left)
    (s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) X_ov.left)
    (hOpen_1 : AlgebraicGeometry.IsOpenImmersion ι_1)
    (hι_1_ov : CategoryTheory.CategoryStruct.comp ι_1 X_ov.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (hs_inf_ov : CategoryTheory.CategoryStruct.comp s_inf X_ov.hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_inf_disj : Disjoint (Set.range ι_1.base) (Set.range s_inf.base))
    (hs_inf_cov : Set.range ι_1.base ∪ Set.range s_inf.base = Set.univ) :
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf X_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let T_id := weilEtaleIdTerminal.{u} X_ov.left
    let hT_id := weilEtaleIdTerminalIsTerminal.{u} X_ov.left
    ∃ d_inf : CategoryTheory.Abelian.Ext Fℤ Div_sh 0,
      ∀ (d₀ : CategoryTheory.Abelian.Ext Fℤ Div_sh 0)
        (E : { x : ↥X_ov.left // IsClosed ({x} : Set ↥X_ov.left) } →₀ ℤ),
        (∀ y : { y : ↥T_id.left // IsClosed ({T_id.hom.base y} : Set ↥X_ov.left) },
          valDiv T_id
            (((CategoryTheory.constantSheafAdj X_ov.left.smallEtaleTopology
              AddCommGrpCat.{u} hT_id).homEquiv
              Aℤ Div_sh (CategoryTheory.Abelian.Ext.addEquiv₀ d₀)).hom
              (ULift.up (1 : ℤ))) y = E ⟨y.1, y.2⟩) →
        d₀.comp hEx_div.extClass (Nat.zero_add 1) =
          (E.sum fun _ m => m) • (d_inf.comp hEx_div.extClass (Nat.zero_add 1)) :=
by
  classical
  intro Aℤ Fℤ T_id hT_id
  let X : AlgebraicGeometry.Scheme.{u} := X_ov.left
  let Pt := { x : ↥X // IsClosed ({x} : Set ↥X) }
  let Pt_T := { y : ↥T_id.left // IsClosed ({T_id.hom.base y} : Set ↥X) }
  letI : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
  let η_pt : ↥X := genericPoint ↥X
  let K_cat : CommRingCat.{u} := X.presheaf.stalk η_pt
  let η_X : AlgebraicGeometry.Spec K_cat ⟶ X := X.fromSpecStalk η_pt
  let η_K := (CategoryTheory.sheafificationAdjunction X.smallEtaleTopology
    AddCommGrpCat.{u}).unit.app (weilEtaleKPresheaf X)

  
  let pt₀ : PrimeSpectrum k := ⊥
  have hField_ideal : ∀ (q : PrimeSpectrum k) (x : k), x ∈ q.asIdeal ↔ x = 0 := by
    intro q x
    constructor
    · intro hx
      by_contra hx0
      exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hx (Ne.isUnit hx0))
    · rintro rfl
      exact q.asIdeal.zero_mem
  have hSpec_uniq : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)), p = pt₀ := by
    intro p
    exact PrimeSpectrum.ext (Ideal.ext fun x => (hField_ideal p x).trans (hField_ideal pt₀ x).symm)
  let P_inf : ↥X := s_inf.base pt₀
  have hs_range : Set.range s_inf.base = ({P_inf} : Set ↥X) := by
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨p, rfl⟩
      exact congrArg s_inf.base (hSpec_uniq p)
    · rintro rfl
      exact ⟨pt₀, rfl⟩
  have hP_notMem : P_inf ∉ Set.range ι_1.base := by
    intro hmem
    exact Set.disjoint_left.mp hs_inf_disj hmem (by rw [hs_range]; exact Set.mem_singleton P_inf)
  have hCompl_eq : (Set.range ι_1.base)ᶜ = ({P_inf} : Set ↥X) := by
    ext z
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
    constructor
    · intro hz
      have hcov : z ∈ Set.range ι_1.base ∪ Set.range s_inf.base :=
        hs_inf_cov.symm ▸ Set.mem_univ z
      rcases hcov with h1 | h2
      · exact False.elim (hz h1)
      · rwa [hs_range, Set.mem_singleton_iff] at h2
    · rintro rfl
      exact hP_notMem
  have hCl_inf : IsClosed ({P_inf} : Set ↥X) :=
    hCompl_eq ▸ (AlgebraicGeometry.IsOpenImmersion.isOpen_range ι_1).isClosed_compl
  let Q_inf : Pt := ⟨P_inf, hCl_inf⟩

  
  have hBridge : ∀ f : Units ↑X.functionField,
      ∃ s : ↥((weilEtaleKPresheaf X).obj (Opposite.op T_id)),
        ∀ (y : Pt_T) (yx : ↥X) (_hyx : yx = y.1)
          (a_stk b_stk : ↑(X.presheaf.stalk yx)) (na nb : ℕ),
          algebraMap ↑(X.presheaf.stalk yx) ↑X.functionField b_stk * (f : ↑X.functionField) =
            algebraMap ↑(X.presheaf.stalk yx) ↑X.functionField a_stk →
          a_stk ≠ 0 →
          b_stk ≠ 0 →
          Ideal.span ({a_stk} : Set ↑(X.presheaf.stalk yx)) =
            (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk yx)) ^ na →
          Ideal.span ({b_stk} : Set ↑(X.presheaf.stalk yx)) =
            (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk yx)) ^ nb →
          valDiv T_id ((div_mor.hom.app (Opposite.op T_id)).hom
            ((η_K.app (Opposite.op T_id)).hom s)) y = (na : ℤ) - (nb : ℤ) := by
    intro f
    let snd_T := CategoryTheory.Limits.pullback.snd T_id.hom η_X
    let σ_T : K_cat ⟶ (CategoryTheory.Limits.pullback T_id.hom η_X).presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).inv ≫ snd_T.appTop
    let s : ↥((weilEtaleKPresheaf X).obj (Opposite.op T_id)) :=
      Additive.ofMul (Units.map σ_T.hom.toMonoidHom f)
    refine ⟨s, ?_⟩
    intro y yx hyx a_stk b_stk na nb h_rat ha_ne hb_ne ha_span hb_span
    obtain ⟨U_a, hya, a_Ua, ha_germ⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf a_stk
    obtain ⟨U_b, hyb, b_Ub, hb_germ⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf b_stk
    let O_X : X.Opens := U_a ⊓ U_b
    let O : T_id.left.Opens := O_X
    have hy : yx ∈ O_X := ⟨hya, hyb⟩
    have hy_T : y.1 ∈ O := hyx ▸ hy
    let a_O : ↑(X.presheaf.obj (Opposite.op O_X)) :=
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O_X ≤ U_a)).op).hom a_Ua
    let b_O : ↑(X.presheaf.obj (Opposite.op O_X)) :=
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O_X ≤ U_b)).op).hom b_Ub
    have ha_O_germ : (X.presheaf.germ O_X yx hy).hom a_O = a_stk := by
      have h1 := congrArg (fun φ => φ.hom a_Ua)
        (TopCat.Presheaf.germ_res X.presheaf (CategoryTheory.homOfLE (inf_le_left : O_X ≤ U_a)) yx hy)
      exact h1.trans ha_germ
    have hb_O_germ : (X.presheaf.germ O_X yx hy).hom b_O = b_stk := by
      have h1 := congrArg (fun φ => φ.hom b_Ub)
        (TopCat.Presheaf.germ_res X.presheaf (CategoryTheory.homOfLE (inf_le_right : O_X ≤ U_b)) yx hy)
      exact h1.trans hb_germ
    let O_et : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp O.ι T_id.hom)
      (by have : AlgebraicGeometry.Etale T_id.hom := T_id.prop; infer_instance)
    let j_O : O_et ⟶ T_id := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
    let a₀ : ↑(O_et.left.presheaf.obj (Opposite.op ⊤)) := O.topIso.inv.hom a_O
    let b₀ : ↑(O_et.left.presheaf.obj (Opposite.op ⊤)) := O.topIso.inv.hom b_O
    have hη_O : η_pt ∈ O_X := (genericPoint_specializes yx).mem_open O_X.isOpen hy
    let η_O : AlgebraicGeometry.Spec K_cat ⟶ O_X.toScheme := O_X.fromSpecStalkOfMem η_pt hη_O
    have hη_O_ι : η_O ≫ O_X.ι = η_X := AlgebraicGeometry.Scheme.Opens.fromSpecStalkOfMem_ι O_X η_pt hη_O
    let g_et : O_X.toScheme ⟶ X := O_et.hom
    have hg_et_eq : g_et = O_X.ι := CategoryTheory.Category.comp_id O_X.ι
    have hMono_O : CategoryTheory.Mono g_et := by
      rw [hg_et_eq]
      infer_instance
    have hcomm_O : η_O ≫ g_et = 𝟙 (AlgebraicGeometry.Spec K_cat) ≫ η_X := by
      rw [hg_et_eq, CategoryTheory.Category.id_comp, hη_O_ι]
    let l_O : AlgebraicGeometry.Spec K_cat ⟶ CategoryTheory.Limits.pullback O_et.hom η_X :=
      CategoryTheory.Limits.pullback.lift η_O (𝟙 (AlgebraicGeometry.Spec K_cat)) hcomm_O
    let fst_O : CategoryTheory.Limits.pullback O_et.hom η_X ⟶ O_X.toScheme :=
      CategoryTheory.Limits.pullback.fst O_et.hom η_X
    let snd_O : CategoryTheory.Limits.pullback O_et.hom η_X ⟶ AlgebraicGeometry.Spec K_cat :=
      CategoryTheory.Limits.pullback.snd O_et.hom η_X
    have hl_fst : l_O ≫ fst_O = η_O := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hl_snd : l_O ≫ snd_O = 𝟙 (AlgebraicGeometry.Spec K_cat) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hsnd_l : snd_O ≫ l_O = 𝟙 (CategoryTheory.Limits.pullback O_et.hom η_X) := by
      haveI : CategoryTheory.Mono g_et := hMono_O
      apply CategoryTheory.Limits.pullback.hom_ext
      · change snd_O ≫ (l_O ≫ fst_O) = 𝟙 _ ≫ fst_O
        rw [hl_fst, CategoryTheory.Category.id_comp]
        apply (CategoryTheory.cancel_mono g_et).mp
        rw [CategoryTheory.Category.assoc, hg_et_eq, hη_O_ι]
        exact (CategoryTheory.Limits.pullback.condition (f := O_et.hom) (g := η_X)).symm
      · change snd_O ≫ (l_O ≫ snd_O) = 𝟙 _ ≫ snd_O
        rw [hl_snd, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    let τ_O : (CategoryTheory.Limits.pullback O_et.hom η_X).presheaf.obj (Opposite.op ⊤) ⟶ K_cat :=
      l_O.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom
    let σ_O : K_cat ⟶ (CategoryTheory.Limits.pullback O_et.hom η_X).presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).inv ≫ snd_O.appTop
    have hτ_σ : τ_O ≫ σ_O = 𝟙 _ := by
      dsimp [τ_O, σ_O]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom,
        (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom_inv_id, CategoryTheory.Category.id_comp,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hsnd_l, AlgebraicGeometry.Scheme.Hom.id_appTop]
    have hτ_inj : Function.Injective τ_O.hom := by
      intro u₁ u₂ hu
      have h2 := congrArg σ_O.hom hu
      have h3 : ∀ u, σ_O.hom (τ_O.hom u) = u := fun u =>
        congrArg (fun φ => φ.hom u) hτ_σ
      rwa [h3, h3] at h2
    have hτ_s : τ_O.hom ((Additive.toMul (((weilEtaleKPresheaf X).map j_O.op).hom s) :
        Units ↑((CategoryTheory.Limits.pullback O_et.hom η_X).presheaf.obj (Opposite.op ⊤))).val) =
        (f : ↑X.functionField) := by
      let k_ov := (AlgebraicGeometry.Scheme.Etale.forget X).map j_O
      let m_O : CategoryTheory.Limits.pullback O_et.hom η_X ⟶
          CategoryTheory.Limits.pullback T_id.hom η_X :=
        ((CategoryTheory.Over.pullback η_X).map k_ov).left
      have hm_snd : m_O ≫ snd_T = snd_O := by
        have hm_eq := CategoryTheory.Over.pullback_map_left η_X
          ((AlgebraicGeometry.Scheme.Etale.forget X).obj O_et) (k := k_ov)
        exact (congrArg (· ≫ snd_T) hm_eq).trans (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      have hl_m_snd : l_O ≫ m_O ≫ snd_T = 𝟙 (AlgebraicGeometry.Spec K_cat) :=
        (congrArg (l_O ≫ ·) hm_snd).trans hl_snd
      have hcomp_id : σ_T ≫ m_O.appTop ≫ τ_O = 𝟙 K_cat := by
        dsimp [σ_T, τ_O]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc m_O.appTop,
          ← AlgebraicGeometry.Scheme.Hom.comp_appTop l_O m_O,
          ← CategoryTheory.Category.assoc snd_T.appTop,
          ← AlgebraicGeometry.Scheme.Hom.comp_appTop (l_O ≫ m_O) snd_T,
          CategoryTheory.Category.assoc l_O m_O snd_T, hl_m_snd,
          AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
          (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).inv_hom_id]
      change τ_O.hom (m_O.appTop.hom (σ_T.hom f.val)) = f.val
      exact congrArg (fun φ => φ.hom f.val) hcomp_id
    have hτ_fst : ∀ c_O : ↑(X.presheaf.obj (Opposite.op O_X)),
        τ_O.hom (fst_O.appTop.hom (O_X.topIso.inv.hom c_O)) =
          algebraMap ↑(X.presheaf.stalk yx) ↑X.functionField
            ((X.presheaf.germ O_X yx hy).hom c_O) := by
      intro c_O
      have h_top_O : (⊤ : (AlgebraicGeometry.Spec K_cat).Opens) ≤
          (TopologicalSpace.Opens.map η_X.base).obj O_X := by
        intro p _
        have hmem_range : η_X.base p ∈ Set.range η_X.base := ⟨p, rfl⟩
        rw [AlgebraicGeometry.Scheme.range_fromSpecStalk] at hmem_range
        exact hmem_range.mem_open O_X.isOpen hη_O
      have h_O_le : (⊤ : O_X.toScheme.Opens) ≤ (TopologicalSpace.Opens.map O_X.ι.base).obj O_X :=
        fun z _ => z.2
      have hfst_l_top : fst_O.appTop ≫ l_O.appTop = η_O.appTop :=
        (AlgebraicGeometry.Scheme.Hom.comp_appTop l_O fst_O).symm.trans
