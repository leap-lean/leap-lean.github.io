    refine ⟨hP_mem, ?_⟩
    let _ : IsDomain ↑(C.left.presheaf.stalk (P_pts a).1) :=
      (hDVR_et T_C ⟨(P_pts a).1, (P_pts a).2⟩).choose
    have hs_lift_g₁ : s_lift =
        ((weilEtaleKSheaf C.left).obj.map g₁.op).hom
          ((η_K.app (Opposite.op T_C)).hom s_TC_g₀) :=
      ConcreteCategory.congr_hom (η_K.naturality g₁.op) s_TC_g₀
    have hdiv_g₁ : (div_mor.hom.app (Opposite.op V_W₁)).hom s_lift =
        (Div_sh.obj.map g₁.op).hom
          ((div_mor.hom.app (Opposite.op T_C)).hom
            ((η_K.app (Opposite.op T_C)).hom s_TC_g₀)) := by
      rw [hs_lift_g₁]
      exact congrArg (fun φ => φ.hom ((η_K.app (Opposite.op T_C)).hom s_TC_g₀))
        (div_mor.hom.naturality g₁.op)
    rw [hdiv_g₁, hValNat g₁]
    obtain ⟨hη_out', _, _, _, heval_a⟩ :=
      hOpenGenIso W_out (P_pts a).1 hP_mem V_W₁.hom rfl
    have hbf_a : algebraMap ↑(C.left.presheaf.stalk (P_pts a).1) ↑C.left.functionField
        ((C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom 1) * (f_g₀ : ↑C.left.functionField) =
        algebraMap ↑(C.left.presheaf.stalk (P_pts a).1) ↑C.left.functionField
          ((C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom g₀) := by
      rw [map_one, map_one, one_mul]
      exact (heval_a g₀).2
    have h1_span : Ideal.span
        ({(C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom 1} :
          Set ↑(C.left.presheaf.stalk (P_pts a).1)) =
        IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk (P_pts a).1) ^ 0 := by
      rw [map_one, pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one]
    have h1_ne : (C.left.presheaf.germ W_out (P_pts a).1 hP_mem).hom 1 ≠ 0 := by
      rw [map_one]
      exact one_ne_zero
    have hord_a := hTC_val_ord f_g₀ W_out (P_pts a) hP_mem g₀ 1 (c a) 0
      hne_g₀ h1_ne hbf_a hSpan_g₀ h1_span
    refine (congrArg
      (valDiv T_C
        ((div_mor.hom.app (Opposite.op T_C)).hom
          ((η_K.app (Opposite.op T_C)).hom s_TC_g₀)))
      (Subtype.ext rfl)).trans (hord_a.trans (sub_zero _))

  
  have hLiftFinsupp : ∀ E : Pt →₀ ℤ,
      ∃ q : ↥(Div_sh.obj.obj (Opposite.op T_C)),
        ∀ y : { y : ↥T_C.left // IsClosed ({T_C.hom.base y} : Set ↥C.left) },
          valDiv T_C q y = E ⟨y.1, y.2⟩ := by
    intro E
    let D_fn : { y : ↥T_C.left // IsClosed ({T_C.hom.base y} : Set ↥C.left) } → ℤ :=
      fun y => E ⟨y.1, y.2⟩
    have hFin : { y | D_fn y ≠ 0 }.Finite := by
      let toPt : { y : ↥T_C.left // IsClosed ({T_C.hom.base y} : Set ↥C.left) } → Pt :=
        fun y => ⟨y.1, y.2⟩
      have hInj : Function.Injective toPt :=
        fun y₁ y₂ h => Subtype.ext (congrArg Subtype.val h)
      have hsub : { y | D_fn y ≠ 0 } ⊆ toPt ⁻¹' (E.support : Set Pt) := by
        intro y hy
        simpa [toPt, D_fn] using hy
      exact (E.support.finite_toSet.preimage hInj.injOn).subset hsub
    have hmem : D_fn ∈ Set.range (valDiv T_C) := by
      rw [(hValProp T_C).2.2 hCompC]
      exact hFin
    rcases hmem with ⟨q, hq⟩
    exact ⟨q, fun y => congrFun hq y⟩

  let D_target : Pt →₀ ℤ :=
    Finset.univ.sum fun a : Fin m => Finsupp.single (P_pts a) (c a : ℤ)
  obtain ⟨q_glob, hq_glob⟩ := hLiftFinsupp D_target

  have hD_target_at : ∀ a : Fin m, D_target (P_pts a) = (c a : ℤ) := by
    intro a
    dsimp [D_target]
    rw [Finsupp.finset_sum_apply, Finset.sum_eq_single a]
    · exact Finsupp.single_eq_same
    · intro b _ hba
      exact Finsupp.single_eq_of_ne (hP_disj (Ne.symm hba))
    · intro ha_not
      exact absurd (Finset.mem_univ a) ha_not

  have hD_target_of_not : ∀ x : Pt, (∀ a : Fin m, x ≠ P_pts a) → D_target x = 0 := by
    intro x hx_ne
    dsimp [D_target]
    rw [Finsupp.finset_sum_apply]
    apply Finset.sum_eq_zero
    intro a _
    exact Finsupp.single_eq_of_ne (hx_ne a)

  have hq_g₂ : (Div_sh.obj.map g₂.op).hom q_glob = 0 := by
    apply (hValProp V_W₂).1
    funext y₂
    rw [map_zero, Pi.zero_apply, hValNat g₂, hq_glob]
    apply hD_target_of_not
    intro a heq
    have hmem_in : (P_pts a).1 ∈ (W_in : Set ↥C.left) := by
      have hval : y₂.1.1 = (P_pts a).1 := congrArg Subtype.val heq
      rw [← hval]
      exact y₂.1.2
    rw [hW_in_compl] at hmem_in
    exact hmem_in (Set.mem_iUnion.mpr ⟨a, rfl⟩)

  have hq_g₁ : (Div_sh.obj.map g₁.op).hom q_glob =
      (div_mor.hom.app (Opposite.op V_W₁)).hom s_lift := by
    apply (hValProp V_W₁).1
    funext y₁
    refine ((hValNat g₁ q_glob y₁).trans (hq_glob _)).trans ?_
    let x₁ : Pt := ⟨y₁.1.1, y₁.2⟩
    have hx₁_lhs : D_target ⟨(⟨g₁.left.base y₁.1, by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.MorphismProperty.Over.w g₁]
        exact y₁.2⟩ :
        { y : ↥T_C.left // IsClosed ({T_C.hom.base y} : Set ↥C.left) }).1,
        (⟨g₁.left.base y₁.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
            CategoryTheory.MorphismProperty.Over.w g₁]
          exact y₁.2⟩ :
          { y : ↥T_C.left // IsClosed ({T_C.hom.base y} : Set ↥C.left) }).2⟩ =
        D_target x₁ :=
      congrArg D_target (Subtype.ext rfl)
    refine hx₁_lhs.trans ?_
    by_cases hex : ∃ a : Fin m, x₁ = P_pts a
    · rcases hex with ⟨a, hxa⟩
      obtain ⟨hP_mem_a, hval_a⟩ := hs_lift_val a
      have hy₁_val : y₁.1.1 = (P_pts a).1 := congrArg (Subtype.val : Pt → ↥C.left) hxa
      have hy₁_eq : y₁ = ⟨⟨(P_pts a).1, hP_mem_a⟩, (P_pts a).2⟩ := by
        apply Subtype.ext
        change (y₁.1 : ↥W_out) = ⟨(P_pts a).1, hP_mem_a⟩
        exact Subtype.ext hy₁_val
      exact (congrArg D_target hxa).trans
        ((hD_target_at a).trans
          (hval_a.symm.trans
            (congrArg (valDiv V_W₁ ((div_mor.hom.app (Opposite.op V_W₁)).hom s_lift))
              hy₁_eq.symm)))
    · push_neg at hex
      refine (hD_target_of_not x₁ hex).trans ?_
      have hy_in : y₁.1.1 ∈ W_in := by
        change y₁.1.1 ∈ (W_in : Set ↥C.left)
        rw [hW_in_compl]
        intro hmem
        rcases Set.mem_iUnion.mp hmem with ⟨a, ha⟩
        exact hex a (Subtype.ext ha)
      let y₁₂ : { y : ↥V_W₁₂.left // IsClosed ({V_W₁₂.hom.base y} : Set ↥C.left) } :=
        ⟨⟨y₁.1.1, ⟨y₁.1.2, hy_in⟩⟩, y₁.2⟩
      have hy₁₂_base : V_W₁.hom.base (j₁₂_₁.left.base y₁₂.1) = V_W₁₂.hom.base y₁₂.1 := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
          CategoryTheory.MorphismProperty.Over.w j₁₂_₁]
      have hy₁₂_map : (⟨j₁₂_₁.left.base y₁₂.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
            CategoryTheory.MorphismProperty.Over.w j₁₂_₁]
          exact y₁₂.2⟩ :
          { y : ↥V_W₁.left // IsClosed ({V_W₁.hom.base y} : Set ↥C.left) }) = y₁ := by
        apply Subtype.ext
        change (j₁₂_₁.left.base y₁₂.1 : ↥W_out) = (y₁.1 : ↥W_out)
        exact Subtype.ext hy₁₂_base
      have hdiv_j₁₂ : (Div_sh.obj.map j₁₂_₁.op).hom
          ((div_mor.hom.app (Opposite.op V_W₁)).hom s_lift) = 0 := by
        have hnat : (Div_sh.obj.map j₁₂_₁.op).hom
            ((div_mor.hom.app (Opposite.op V_W₁)).hom s_lift) =
            (div_mor.hom.app (Opposite.op V_W₁₂)).hom
              (((weilEtaleKSheaf C.left).obj.map j₁₂_₁.op).hom s_lift) :=
          congrArg (fun φ => φ.hom s_lift) (div_mor.hom.naturality j₁₂_₁.op).symm
        rw [hnat, hs_lift_ov]
        have h0_app : (ι_gm ≫ div_mor).hom.app (Opposite.op V_W₁₂) = 0 := by
          rw [h0_div]; rfl
        exact ConcreteCategory.congr_hom h0_app u_C_sh
      have hval_zero : valDiv V_W₁₂
          ((Div_sh.obj.map j₁₂_₁.op).hom
            ((div_mor.hom.app (Opposite.op V_W₁)).hom s_lift)) y₁₂ = 0 := by
        rw [hdiv_j₁₂, map_zero, Pi.zero_apply]
      exact (hval_zero.symm.trans
        ((hValNat j₁₂_₁ ((div_mor.hom.app (Opposite.op V_W₁)).hom s_lift) y₁₂).trans
          (congrArg (valDiv V_W₁ ((div_mor.hom.app (Opposite.op V_W₁)).hom s_lift))
            hy₁₂_map)))

  obtain ⟨d₀, hd₀⟩ := hDiv_n
  obtain ⟨D₀, rfl⟩ := QuotientAddGroup.mk'_surjective (weilCurvePrincipalSubgroup C.left) d₀
  rw [← map_nsmul] at hd₀
  have h_mem_prin : -(n • D₀) + D_target ∈ weilCurvePrincipalSubgroup C.left :=
    QuotientAddGroup.eq.mp hd₀

  let ev_div_K : ↥((weilEtaleKSheaf C.left).obj.obj (Opposite.op T_C)) →+ (Pt → ℤ) :=
    AddMonoidHom.mk'
      (fun s x => valDiv T_C ((div_mor.hom.app (Opposite.op T_C)).hom s) ⟨x.1, x.2⟩)
      (fun s₁ s₂ => by ext x; simp)
  let coe_Finsupp : (Pt →₀ ℤ) →+ (Pt → ℤ) := Finsupp.coeFnAddHom

  have hPrin_le : weilCurvePrincipalSubgroup C.left ≤
      ev_div_K.range.comap coe_Finsupp := by
    rw [weilCurvePrincipalSubgroup, AddSubgroup.closure_le]
    rintro D ⟨f, hf⟩
    refine ⟨(η_K.app (Opposite.op T_C)).hom (s_of_K f), ?_⟩
    funext x
    obtain ⟨a, b, na, nb, ha_ne, hb_ne, hab_K, hspan_a, hspan_b, hDx⟩ := hf x
    obtain ⟨U_a, hx_a, s_a, hs_a⟩ := TopCat.Presheaf.exists_germ_eq C.left.presheaf a
    obtain ⟨U_b, hx_b, s_b, hs_b⟩ := TopCat.Presheaf.exists_germ_eq C.left.presheaf b
    let O : C.left.Opens := U_a ⊓ U_b
    have hx_O : x.1 ∈ O := ⟨hx_a, hx_b⟩
    let s_a' : ↑(C.left.presheaf.obj (Opposite.op O)) :=
      (C.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O ≤ U_a)).op).hom s_a
    let s_b' : ↑(C.left.presheaf.obj (Opposite.op O)) :=
      (C.left.presheaf.map (CategoryTheory.homOfLE (inf_le_right : O ≤ U_b)).op).hom s_b
    have ha'_eq : (C.left.presheaf.germ O x.1 hx_O).hom s_a' = a :=
      (ConcreteCategory.congr_hom
        (TopCat.Presheaf.germ_res C.left.presheaf
          (CategoryTheory.homOfLE (inf_le_left : O ≤ U_a)) x.1 hx_O) s_a).trans hs_a
    have hb'_eq : (C.left.presheaf.germ O x.1 hx_O).hom s_b' = b :=
      (ConcreteCategory.congr_hom
        (TopCat.Presheaf.germ_res C.left.presheaf
          (CategoryTheory.homOfLE (inf_le_right : O ≤ U_b)) x.1 hx_O) s_b).trans hs_b
    have hbf_eq : algebraMap ↑(C.left.presheaf.stalk x.1) ↑C.left.functionField
        ((C.left.presheaf.germ O x.1 hx_O).hom s_b') * (f : ↑C.left.functionField) =
        algebraMap ↑(C.left.presheaf.stalk x.1) ↑C.left.functionField
          ((C.left.presheaf.germ O x.1 hx_O).hom s_a') := by
      rw [ha'_eq, hb'_eq, mul_comm, ← hab_K]
    have hord_x := hTC_val_ord f O x hx_O s_a' s_b' na nb
      (by rw [ha'_eq]; exact ha_ne)
      (by rw [hb'_eq]; exact hb_ne)
      hbf_eq
      (by rw [ha'_eq]; exact hspan_a)
      (by rw [hb'_eq]; exact hspan_b)
    exact hord_x.trans hDx.symm

  obtain ⟨s_prin, hs_prin⟩ := hPrin_le h_mem_prin
  obtain ⟨q₀, hq₀⟩ := hLiftFinsupp D₀

  have hq_decomp : q_glob = n • q₀ + (div_mor.hom.app (Opposite.op T_C)).hom s_prin := by
    apply (hValProp T_C).1
    funext y
    have hprin_y : valDiv T_C ((div_mor.hom.app (Opposite.op T_C)).hom s_prin) y =
        (-(n • D₀) + D_target) ⟨y.1, y.2⟩ :=
      congrFun hs_prin ⟨y.1, y.2⟩
    rw [hq_glob y, map_add, map_nsmul, Pi.add_apply, Pi.smul_apply, hq₀ y, hprin_y,
      Finsupp.add_apply, Finsupp.neg_apply, Finsupp.smul_apply]
    abel

  
  let J_C := C.left.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ := (CategoryTheory.Functor.const (Opposite C.left.Etale)).obj Aℤ
  have hT_C : CategoryTheory.Limits.IsTerminal T_C :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom))
      (fun U m_hom => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.MorphismProperty.Over.w m_hom).trans
          (CategoryTheory.Category.comp_id U.hom).symm))
  let adj_C := CategoryTheory.constantSheafAdj J_C AddCommGrpCat.{u} hT_C
  have hadj_u : adj_C.unit.app Aℤ = (shAdj_C.unit.app Pℤ).app (Opposite.op T_C) :=
    CategoryTheory.Category.id_comp _
  let hom_of_sec : ∀ {ℱ : CategoryTheory.Sheaf J_C AddCommGrpCat.{u}},
      ↥(ℱ.obj.obj (Opposite.op T_C)) → (Fℤ_C ⟶ ℱ) := fun {ℱ} x =>
    (adj_C.homEquiv Aℤ ℱ).symm
      (AddCommGrpCat.ofHom
        { toFun := fun z => z.down • x
          map_zero' := zero_zsmul x
          map_add' := fun a b => add_zsmul x a.down b.down })
  have h_eval_TC : ∀ {ℱ : CategoryTheory.Sheaf J_C AddCommGrpCat.{u}}
      (x : ↥(ℱ.obj.obj (Opposite.op T_C))) (z : ℤ),
      ((adj_C.unit.app Aℤ) ≫ (hom_of_sec x).hom.app (Opposite.op T_C)).hom (ULift.up z) =
        z • x := by
    intro ℱ x z
    have h1 := (adj_C.homEquiv Aℤ ℱ).apply_symm_apply
      (AddCommGrpCat.ofHom
        { toFun := fun w : ULift.{u} ℤ => w.down • x
          map_zero' := zero_zsmul x
          map_add' := fun a b => add_zsmul x a.down b.down })
    rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
    exact ConcreteCategory.congr_hom h1 (ULift.up z)

  let f_q : Fℤ_C ⟶ Div_sh := hom_of_sec q_glob
  let f_q₀ : Fℤ_C ⟶ Div_sh := hom_of_sec q₀
  let f_prin : Fℤ_C ⟶ weilEtaleKSheaf C.left := hom_of_sec s_prin

  have hfq_app : ∀ (V : C.left.Etale) (g : V ⟶ T_C),
      (f_q.hom.app (Opposite.op V)).hom (u₁_Fℤ V) =
        (Div_sh.obj.map g.op).hom q_glob := by
    intro V g
    have hu_map : (Fℤ_C.obj.map g.op).hom (u₁_Fℤ T_C) = u₁_Fℤ V :=
      (ConcreteCategory.congr_hom ((shAdj_C.unit.app Pℤ).naturality g.op)
        (ULift.up (1 : ℤ))).symm
    have hnat := ConcreteCategory.congr_hom (f_q.hom.naturality g.op) (u₁_Fℤ T_C)
    change (f_q.hom.app (Opposite.op V)).hom ((Fℤ_C.obj.map g.op).hom (u₁_Fℤ T_C)) =
      (Div_sh.obj.map g.op).hom ((f_q.hom.app (Opposite.op T_C)).hom (u₁_Fℤ T_C)) at hnat
    have h_one : (f_q.hom.app (Opposite.op T_C)).hom (u₁_Fℤ T_C) = q_glob := by
      have h := h_eval_TC q_glob 1
      rw [hadj_u, one_zsmul] at h
      exact h
    rw [← hu_map, hnat, h_one]

  have hfq_decomp : f_q = n • f_q₀ + f_prin ≫ div_mor := by
    apply (adj_C.homEquiv Aℤ Div_sh).injective
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    have hnsmul_app : ∀ (k_exp : ℕ) (z : ULift.{u} ℤ),
        (((k_exp • f_q₀).hom.app (Opposite.op T_C)).hom
          ((adj_C.unit.app Aℤ).hom z)) =
        k_exp • ((f_q₀.hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom z)) := by
      intro k_exp z
      induction k_exp with
      | zero => simp
      | succ k_exp ih =>
        rw [succ_nsmul, succ_nsmul]
        change ((k_exp • f_q₀).hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom z) +
          (f_q₀.hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom z) = _
        rw [ih]
    ext ⟨z⟩
    have hL := h_eval_TC q_glob z
    change (f_q.hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom (ULift.up z)) =
      (((n • f_q₀ + f_prin ≫ div_mor).hom.app (Opposite.op T_C)).hom
        ((adj_C.unit.app Aℤ).hom (ULift.up z)))
    have hR_add : (((n • f_q₀ + f_prin ≫ div_mor).hom.app (Opposite.op T_C)).hom
        ((adj_C.unit.app Aℤ).hom (ULift.up z))) =
      (((n • f_q₀).hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom (ULift.up z))) +
      (div_mor.hom.app (Opposite.op T_C)).hom
        ((f_prin.hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom (ULift.up z))) := rfl
    rw [hR_add, hnsmul_app n (ULift.up z)]
    have h0 := h_eval_TC q₀ z
    have hp := h_eval_TC s_prin z
    change (f_q₀.hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom (ULift.up z)) =
      z • q₀ at h0
    change (f_prin.hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom (ULift.up z)) =
      z • s_prin at hp
    change (f_q.hom.app (Opposite.op T_C)).hom ((adj_C.unit.app Aℤ).hom (ULift.up z)) =
      z • q_glob at hL
    rw [hL, h0, hp, hq_decomp, smul_add, map_zsmul, smul_comm n z q₀]

  let δ₀ : Div_sh.H 0 →+ (weilEtaleGmSheaf C.left).H 1 :=
    hSE_div.extClass.postcomp Fℤ_C (Nat.zero_add 1)
  have hmk_eq : ∀ g : Fℤ_C ⟶ Div_sh,
      CategoryTheory.Abelian.Ext.mk₀ g = CategoryTheory.Abelian.Ext.addEquiv₀.symm g := by
    intro g
    have h := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
      (CategoryTheory.Abelian.Ext.addEquiv₀.symm g)
    rwa [CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply] at h
  have hmk_fq : CategoryTheory.Abelian.Ext.mk₀ f_q =
      n • CategoryTheory.Abelian.Ext.mk₀ f_q₀ +
        CategoryTheory.Abelian.Ext.mk₀ (f_prin ≫ div_mor) := by
    rw [hfq_decomp, hmk_eq, map_add, map_nsmul, ← hmk_eq, ← hmk_eq]
  have hprin_zero : δ₀ (CategoryTheory.Abelian.Ext.mk₀ (f_prin ≫ div_mor)) = 0 := by
    change (CategoryTheory.Abelian.Ext.mk₀ (f_prin ≫ div_mor)).comp
      hSE_div.extClass (Nat.zero_add 1) = 0
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f_prin div_mor,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ f_prin)
        (CategoryTheory.Abelian.Ext.mk₀ div_mor)
        hSE_div.extClass (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1)]
    have hcomp0 : (CategoryTheory.Abelian.Ext.mk₀ div_mor).comp
        hSE_div.extClass (Nat.zero_add 1) = 0 :=
      hSE_div.comp_extClass
    rw [hcomp0, CategoryTheory.Abelian.Ext.comp_zero]
  let η_C : (weilEtaleGmSheaf C.left).H 1 := δ₀ (CategoryTheory.Abelian.Ext.mk₀ f_q₀)
  have hη_div : n • η_C =
      (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_div.extClass (Nat.zero_add 1) := by
    change n • δ₀ (CategoryTheory.Abelian.Ext.mk₀ f_q₀) = δ₀ (CategoryTheory.Abelian.Ext.mk₀ f_q)
    rw [hmk_fq, map_add, map_nsmul, hprin_zero, add_zero]

  exact ⟨weilEtaleKSheaf C.left, Div_sh, ι_gm, div_mor, h0_div, hSE_div,
    s_lift, f_q, η_C, hs_lift_ov,
    (hfq_app V_W₁ g₁).trans hq_g₁,
    (hfq_app V_W₂ g₂).trans hq_g₂,
    hη_div⟩

theorem weil_etale_pbc_prime_order_stalk_vanishing_neighborhood (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (q : ℕ)
    (V₁ Y₁ C₀_sch : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V₁]
    (p_V₁ : Quiver.Hom V₁ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (s₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V₁)
    (hs₁_sec : CategoryTheory.CategoryStruct.comp s₁ p_V₁ =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₁ : Quiver.Hom Y₁ V₁)
    (q_C₀ : Quiver.Hom C₀_sch (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_C₀ : Quiver.Hom C₀_sch Y₁)
    (hPb_C₀ : CategoryTheory.IsPullback ι_C₀ q_C₀ f₁ s₁)
    (hNullSec : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (g : Quiver.Hom Z (AlgebraicGeometry.Spec (CommRingCat.of k))),
      AlgebraicGeometry.LocallyOfFiniteType g →
      Nonempty ↥Z →
      ∃ s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Z,
        CategoryTheory.CategoryStruct.comp s g =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hSpecConst : Nonempty (CategoryTheory.Iso
      (weilEtaleHigherDirectImage q_C₀ q (weilEtaleTorsionSheaf C₀_sch ℓ))
      ((CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (weilEtaleTorsionH C₀_sch ℓ q)))))
    (hCard_C₀ : Nat.card (weilEtaleTorsionH C₀_sch ℓ q) = ℓ)
    (hPBC_q : WeilIsEtaleSheafPullback s₁
      (weilEtaleHigherDirectImage f₁ q (weilEtaleTorsionSheaf Y₁ ℓ))
      (weilEtaleHigherDirectImage q_C₀ q (weilEtaleTorsionSheaf C₀_sch ℓ)))
    (α_test α_target : weilEtaleTorsionH Y₁ ℓ q)
    (φ_C₀ : weilEtaleTorsionH Y₁ ℓ q →+ weilEtaleTorsionH C₀_sch ℓ q)
    (hφ_C₀ : WeilIsTorsionEtalePullback ι_C₀ ℓ q φ_C₀)
    (hTest_ne : φ_C₀ α_test ≠ 0)
    (hTarget_zero : φ_C₀ α_target = 0) :
    ∃ (U_et : AlgebraicGeometry.Scheme.{u})
      (g_et : Quiver.Hom U_et V₁)
      (s_et : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U_et),
      AlgebraicGeometry.Etale g_et ∧
      CategoryTheory.CategoryStruct.comp s_et g_et = s₁ ∧
      let Y_et := CategoryTheory.Limits.pullback f₁ g_et
      let p_Yet := CategoryTheory.Limits.pullback.fst f₁ g_et
      ∀ (φ_et : weilEtaleTorsionH Y₁ ℓ q →+ weilEtaleTorsionH Y_et ℓ q),
        WeilIsTorsionEtalePullback p_Yet ℓ q φ_et →
        φ_et α_target = 0 :=
by
  classical
  have _ := p_V₁
  have _ := hs₁_sec

  have hop_comp : ∀ {C : Type _} [CategoryTheory.Category C] {X Y Z : C}
      (f : X ⟶ Y) (g : Y ⟶ Z),
      (f ≫ g).op = g.op ≫ f.op := fun _ _ => rfl
  have hSheafHomExt : ∀ {C : Type _} [CategoryTheory.Category C]
      {J : CategoryTheory.GrothendieckTopology C} {A : Type _} [CategoryTheory.Category A]
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J A} {f g : ℱ₁ ⟶ ℱ₂},
      f.hom = g.hom → f = g :=
    fun {_ _ _ _ _ ℱ₁ ℱ₂ _ _} h =>
      congrArg (fun k : ℱ₁.obj ⟶ ℱ₂.obj => ({ hom := k } : ℱ₁ ⟶ ℱ₂)) h

  
  have hStalkIso :
      ∀ {𝒞₁ 𝒞₂ : Type (u + 1)} [CategoryTheory.Category.{u} 𝒞₁] [CategoryTheory.Category.{u} 𝒞₂]
        (J₁ : CategoryTheory.GrothendieckTopology 𝒞₁)
        (J₂ : CategoryTheory.GrothendieckTopology 𝒞₂)
        [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
        [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
        (B : CategoryTheory.Functor 𝒞₂ 𝒞₁)
        [B.IsContinuous J₂ J₁]
        [(B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint]
        (T₁ : 𝒞₁)
        (hc₁ : CategoryTheory.IsCofiltered (CategoryTheory.coyoneda.obj (Opposite.op T₁)).Elements)
        (hs₁ : CategoryTheory.InitiallySmall.{u, u, u + 1}
          (CategoryTheory.coyoneda.obj (Opposite.op T₁)).Elements)
        (hm₁ : ∀ {W : 𝒞₁}, ∀ R ∈ J₁ W,
          ∀ (x : (CategoryTheory.coyoneda.obj (Opposite.op T₁)).obj W),
            ∃ (W' : 𝒞₁) (f : W' ⟶ W), ∃ (_ : R.arrows f),
              ∃ y, (CategoryTheory.coyoneda.obj (Opposite.op T₁)).map f y = x)
        (hc₂ : CategoryTheory.IsCofiltered
          (B.comp (CategoryTheory.coyoneda.obj (Opposite.op T₁))).Elements)
        (hs₂ : CategoryTheory.InitiallySmall.{u, u, u + 1}
          (B.comp (CategoryTheory.coyoneda.obj (Opposite.op T₁))).Elements)
        (hm₂ : ∀ {U : 𝒞₂}, ∀ R ∈ J₂ U,
          ∀ (x : (B.comp (CategoryTheory.coyoneda.obj (Opposite.op T₁))).obj U),
            ∃ (U' : 𝒞₂) (f : U' ⟶ U), ∃ (_ : R.arrows f),
              ∃ y, (B.comp (CategoryTheory.coyoneda.obj (Opposite.op T₁))).map f y = x)
        (P₂ : CategoryTheory.Functor 𝒞₂ᵒᵖ AddCommGrpCat.{u})
        (𝒢₁ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
        (M : AddCommGrpCat.{u}),
        let Φ₂ : CategoryTheory.GrothendieckTopology.Point.{u, u, u + 1} J₂ :=
          @CategoryTheory.GrothendieckTopology.Point.mk _ _ J₂
            (B.comp (CategoryTheory.coyoneda.obj (Opposite.op T₁))) hc₂ hs₂ @hm₂
        Nonempty (CategoryTheory.Iso
          ((B.sheafPullback AddCommGrpCat.{u} J₂ J₁).obj
            ((CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}).obj P₂))
          𝒢₁) →
        Nonempty (CategoryTheory.Iso 𝒢₁
          ((CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj M)) →
        Nonempty (CategoryTheory.Iso (Φ₂.presheafFiber.obj P₂) M) := by
    intro 𝒞₁ 𝒞₂ _ _ J₁ J₂ _ _ B _ _ T₁ hc₁ hs₁ hm₁ hc₂ hs₂ hm₂ P₂ 𝒢₁ M Φ₂ ⟨e_PBC⟩ ⟨e_spec⟩
    let A := AddCommGrpCat.{u}
    let F₁ := CategoryTheory.coyoneda.obj (Opposite.op T₁)
    let Φ₁ : CategoryTheory.GrothendieckTopology.Point.{u, u, u + 1} J₁ :=
      @CategoryTheory.GrothendieckTopology.Point.mk _ _ J₁ F₁ hc₁ hs₁ @hm₁
    let sky₁ : CategoryTheory.Functor A (CategoryTheory.Sheaf J₁ A) :=
      Φ₁.skyscraperSheafFunctor
    let sky₂ : CategoryTheory.Functor A (CategoryTheory.Sheaf J₂ A) :=
      Φ₂.skyscraperSheafFunctor
    let push_B := B.sheafPushforwardContinuous A J₂ J₁
    let pull_B := B.sheafPullback A J₂ J₁
    let θ_sky : sky₁.comp push_B ≅ sky₂ :=
      CategoryTheory.NatIso.ofComponents
        (fun N =>
          { hom := { hom := 𝟙 ((sky₂.obj N).obj) }
            inv := { hom := 𝟙 ((sky₂.obj N).obj) }
            hom_inv_id := hSheafHomExt (CategoryTheory.Category.id_comp _)
            inv_hom_id := hSheafHomExt (CategoryTheory.Category.id_comp _) })
        (fun {N₁ N₂} g => hSheafHomExt
          ((CategoryTheory.Category.comp_id ((push_B.map (sky₁.map g)).hom)).trans
            (CategoryTheory.Category.id_comp ((sky₂.map g).hom)).symm))
    let adj_B := B.sheafAdjunctionContinuous A J₂ J₁
    let adj₁ := Φ₁.skyscraperSheafAdjunction (A := A)
    let adj₂ := Φ₂.skyscraperSheafAdjunction (A := A)
    let adj_comp := (adj_B.comp adj₁).ofNatIsoRight θ_sky
    let α_stalk : pull_B.comp Φ₁.sheafFiber ≅ Φ₂.sheafFiber :=
      CategoryTheory.Adjunction.leftAdjointUniq adj_comp adj₂
    let constM : CategoryTheory.Functor 𝒞₁ᵒᵖ A := (CategoryTheory.Functor.const 𝒞₁ᵒᵖ).obj M
    let c_triv : ∀ (W : 𝒞₁), Φ₁.fiber.obj W → (constM.obj (Opposite.op W) ⟶ M) :=
      fun _ _ => 𝟙 M
    have hc_triv : ∀ ⦃W₁ W₂ : 𝒞₁⦄ (g : W₁ ⟶ W₂) (x : Φ₁.fiber.obj W₁),
        constM.map g.op ≫ c_triv W₁ x = c_triv W₂ (Φ₁.fiber.map g x) :=
      fun _ _ _ _ => CategoryTheory.Category.id_comp (𝟙 M)
    let fwd : Φ₁.presheafFiber.obj constM ⟶ M := Φ₁.presheafFiberDesc c_triv hc_triv
    let bwd : M ⟶ Φ₁.presheafFiber.obj constM := Φ₁.toPresheafFiber T₁ (𝟙 T₁) constM
    let e_const_pt : Φ₁.presheafFiber.obj constM ≅ M :=
      { hom := fwd
        inv := bwd
        hom_inv_id := Φ₁.presheafFiber_hom_ext fun W x =>
          (CategoryTheory.Category.assoc (Φ₁.toPresheafFiber W x constM) fwd bwd).symm.trans
            ((congrArg (· ≫ bwd)
              (Φ₁.toPresheafFiber_presheafFiberDesc c_triv hc_triv W x)).trans
              ((Φ₁.toPresheafFiber_w x (𝟙 T₁) constM).trans
                ((congrArg (fun y => Φ₁.toPresheafFiber W y constM)
                  (CategoryTheory.Category.id_comp x)).trans
                  (CategoryTheory.Category.comp_id _).symm)))
        inv_hom_id := Φ₁.toPresheafFiber_presheafFiberDesc c_triv hc_triv T₁ (𝟙 T₁) }
    let shP₂ := (CategoryTheory.presheafToSheaf J₂ A).obj P₂
    let iso1 : Φ₂.presheafFiber.obj P₂ ≅ Φ₂.sheafFiber.obj shP₂ :=
      ((Φ₂.presheafToSheafCompSheafFiberIso A).app P₂).symm
    let iso2 : Φ₂.sheafFiber.obj shP₂ ≅ Φ₁.sheafFiber.obj (pull_B.obj shP₂) :=
      (α_stalk.app shP₂).symm
    let iso3 : Φ₁.sheafFiber.obj (pull_B.obj shP₂) ≅ Φ₁.sheafFiber.obj 𝒢₁ :=
      Φ₁.sheafFiber.mapIso e_PBC
    let iso4 : Φ₁.sheafFiber.obj 𝒢₁ ≅ Φ₁.sheafFiber.obj ((CategoryTheory.constantSheaf J₁ A).obj M) :=
      Φ₁.sheafFiber.mapIso e_spec
    let iso5 : Φ₁.sheafFiber.obj ((CategoryTheory.constantSheaf J₁ A).obj M) ≅
        Φ₁.presheafFiber.obj constM :=
      (Φ₁.presheafToSheafCompSheafFiberIso A).app constM
    exact ⟨iso1.trans (iso2.trans (iso3.trans (iso4.trans (iso5.trans e_const_pt))))⟩

  
  have hPrimeVan :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u} 𝒞]
        (J : CategoryTheory.GrothendieckTopology 𝒞)
        (Φ : CategoryTheory.GrothendieckTopology.Point.{u, u, u + 1} J)
        (T₀ : 𝒞) (x₀ : Φ.fiber.obj T₀)
        (P : CategoryTheory.Functor 𝒞ᵒᵖ AddCommGrpCat.{u})
        (H₀ : Type u) [AddCommGroup H₀],
        Nat.card H₀ = ℓ →
        Nonempty (CategoryTheory.Iso (Φ.presheafFiber.obj P) (AddCommGrpCat.of H₀)) →
        ∀ (ev : ∀ (U : 𝒞), Φ.fiber.obj U → (↥(P.obj (Opposite.op U)) →+ H₀)),
          (∀ {U V : 𝒞} (f : U ⟶ V) (x : Φ.fiber.obj U) (z : ↥(P.obj (Opposite.op V))),
            ev U x ((P.map f.op).hom z) = ev V (Φ.fiber.map f x) z) →
          ∀ (z_test z_target : ↥(P.obj (Opposite.op T₀))),
            ev T₀ x₀ z_test ≠ 0 →
            ev T₀ x₀ z_target = 0 →
            ∃ (U : 𝒞) (f : U ⟶ T₀) (x_U : Φ.fiber.obj U),
              Φ.fiber.map f x_U = x₀ ∧ (P.map f.op).hom z_target = 0 := by
    intro 𝒞 _ J Φ T₀ x₀ P H₀ _ hCard ⟨e_iso⟩ ev hev z_test z_target hTest hTarget
    let φ_cat : ∀ (U : 𝒞), Φ.fiber.obj U → (P.obj (Opposite.op U) ⟶ AddCommGrpCat.of H₀) :=
      fun U x => AddCommGrpCat.ofHom (ev U x)
    have hφ_cat : ∀ ⦃U V : 𝒞⦄ (f : U ⟶ V) (x : Φ.fiber.obj U),
        P.map f.op ≫ φ_cat U x = φ_cat V (Φ.fiber.map f x) := by
      intro U V f x
      apply AddCommGrpCat.hom_ext
      ext z
      exact hev f x z
    let ev_colim_cat : Φ.presheafFiber.obj P ⟶ AddCommGrpCat.of H₀ :=
      Φ.presheafFiberDesc φ_cat hφ_cat
    let ev_stalk : ↥(Φ.presheafFiber.obj P) →+ H₀ := ev_colim_cat.hom
    have hev_stalk_apply : ∀ (U : 𝒞) (x : Φ.fiber.obj U) (z : ↥(P.obj (Opposite.op U))),
        ev_stalk ((Φ.toPresheafFiber U x P).hom z) = ev U x z := by
      intro U x z
      have h := Φ.toPresheafFiber_presheafFiberDesc φ_cat hφ_cat U x
      exact congrArg (fun g : P.obj (Opposite.op U) ⟶ AddCommGrpCat.of H₀ => g.hom z) h
    let e_equiv : ↥(Φ.presheafFiber.obj P) ≃+ H₀ := e_iso.addCommGroupIsoToAddEquiv
    have hPrime : Nat.Prime ℓ := Fact.out
    have : Finite H₀ := Nat.finite_of_card_ne_zero (hCard ▸ hPrime.ne_zero)
    have : Finite ↥(Φ.presheafFiber.obj P) := Finite.of_equiv H₀ e_equiv.symm.toEquiv
    have hdvd : Nat.card ↥ev_stalk.range ∣ ℓ :=
      hCard ▸ AddSubgroup.card_addSubgroup_dvd_card ev_stalk.range
    rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | hℓ_eq
    · exfalso
      obtain ⟨w₀, hw₀⟩ := Nat.card_eq_one_iff_exists.mp h1
      let a_test : ↥ev_stalk.range :=
        ⟨ev_stalk ((Φ.toPresheafFiber T₀ x₀ P).hom z_test), ⟨_, rfl⟩⟩
      let a_zero : ↥ev_stalk.range := ⟨0, ev_stalk.range.zero_mem⟩
      have heq_sub : a_test = a_zero := (hw₀ a_test).trans (hw₀ a_zero).symm
      have heq_val : ev_stalk ((Φ.toPresheafFiber T₀ x₀ P).hom z_test) = 0 :=
        congrArg Subtype.val heq_sub
      rw [hev_stalk_apply] at heq_val
      exact hTest heq_val
    · let _ : Fintype H₀ := Fintype.ofFinite H₀
      let _ : Fintype ↥ev_stalk.range := Fintype.ofFinite ↥ev_stalk.range
      have hCardEq : Fintype.card ↥ev_stalk.range = Fintype.card H₀ := by
        rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hℓ_eq, hCard]
      have hBijSub : Function.Bijective (Subtype.val : ↥ev_stalk.range → H₀) :=
        (Fintype.bijective_iff_injective_and_card _).mpr ⟨Subtype.val_injective, hCardEq⟩
      have hSurj : Function.Surjective ev_stalk := by
        intro y
        obtain ⟨⟨_, ⟨w, rfl⟩⟩, rfl⟩ := hBijSub.2 y
        exact ⟨w, rfl⟩
      have hInj : Function.Injective ev_stalk :=
        (Finite.injective_iff_surjective_of_equiv e_equiv.toEquiv).mpr hSurj
      have hStalkZero :
          CategoryTheory.ConcreteCategory.hom (Φ.toPresheafFiber T₀ x₀ P) z_target =
            CategoryTheory.ConcreteCategory.hom (Φ.toPresheafFiber T₀ x₀ P) 0 := by
        apply hInj
        change ev_stalk ((Φ.toPresheafFiber T₀ x₀ P).hom z_target) =
          ev_stalk ((Φ.toPresheafFiber T₀ x₀ P).hom 0)
        rw [hev_stalk_apply, hTarget, map_zero, map_zero]
      obtain ⟨U, f, x_U, hx_U, hf_eq⟩ :=
        (Φ.toPresheafFiber_eq_iff' T₀ x₀ z_target 0).mp hStalkZero
      refine ⟨U, f, x_U, hx_U, ?_⟩
      change CategoryTheory.ConcreteCategory.hom (P.map f.op) z_target = 0
      rw [hf_eq]
      exact map_zero (P.map f.op).hom

  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let idEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}), S.Etale := fun S =>
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  have hIdTerm : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (idEtale S) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom) trivial) ?_
    intro W m
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  let T_k : S_k.Etale := idEtale S_k
  have hT_k : CategoryTheory.Limits.IsTerminal T_k := hIdTerm S_k
  let B_s₁ : CategoryTheory.Functor V₁.Etale S_k.Etale := weilEtaleSitePullback s₁
  let F_k : CategoryTheory.Functor S_k.Etale (Type u) :=
    CategoryTheory.coyoneda.obj (Opposite.op T_k)
  let F_s₁ : CategoryTheory.Functor V₁.Etale (Type u) := B_s₁.comp F_k

  
  let pt₀_k : F_k.Elements := CategoryTheory.Functor.elementsMk F_k T_k (𝟙 T_k)
  have hInit_k : CategoryTheory.Limits.IsInitial pt₀_k :=
    CategoryTheory.Limits.IsInitial.ofUniqueHom
      (fun z => ⟨z.2, CategoryTheory.Category.id_comp z.2⟩)
      (fun z m => CategoryTheory.Functor.Elements.hom_ext (by
        have hm : F_k.map m.1 pt₀_k.2 = z.2 := m.2
        change 𝟙 T_k ≫ m.1 = z.2 at hm
        exact (CategoryTheory.Category.id_comp m.1).symm.trans hm))
  have hc₁ : CategoryTheory.IsCofiltered F_k.Elements :=
    CategoryTheory.IsCofiltered.of_isInitial F_k.Elements hInit_k
  have hs₁_sm : CategoryTheory.InitiallySmall.{u, u, u + 1} F_k.Elements := by
    have : CategoryTheory.IsCofiltered F_k.Elements := hc₁
    let s₀ : Set F_k.Elements := Set.range (fun _ : ULift.{u} Unit => pt₀_k)
    exact CategoryTheory.initiallySmall_of_small_weakly_initial_set s₀
      (fun i => ⟨pt₀_k, ⟨ULift.up (), rfl⟩, ⟨hInit_k.to i⟩⟩)
  have hm₁ : ∀ {W : S_k.Etale}, ∀ R ∈ S_k.smallEtaleTopology W,
      ∀ (x : (CategoryTheory.coyoneda.obj (Opposite.op T_k)).obj W),
        ∃ (W' : S_k.Etale) (f : W' ⟶ W),
          ∃ (_ : R.arrows f), ∃ y, (CategoryTheory.coyoneda.obj (Opposite.op T_k)).map f y = x := by
    intro W R hR x
    have hR_tk : R.pullback x ∈ S_k.smallEtaleTopology T_k :=
      S_k.smallEtaleTopology.pullback_stable x hR
    have heq_Jk : S_k.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_k (le_refl P_et)
    have hR_pre : R.pullback x ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck T_k :=
      heq_Jk ▸ hR_tk
    obtain ⟨W₀, u₀, w₀, hu₀_arr, _, _⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) T_k (R.pullback x)).mp hR_pre pt_k
    have : AlgebraicGeometry.Etale W₀.hom := W₀.prop
    obtain ⟨σ₀, hσ₀⟩ := hNullSec W₀.left W₀.hom inferInstance ⟨w₀⟩
    let y₀ : T_k ⟶ W₀ := CategoryTheory.MorphismProperty.Over.homMk σ₀ hσ₀ trivial
    have hyu : y₀ ≫ u₀ = 𝟙 T_k := hT_k.hom_ext _ _
    have heq_yux :
        CategoryTheory.CategoryStruct.comp y₀ (CategoryTheory.CategoryStruct.comp u₀ x) = x :=
      (CategoryTheory.Category.assoc y₀ u₀ x).symm.trans
        ((congrArg (fun t : T_k ⟶ T_k => CategoryTheory.CategoryStruct.comp t x) hyu).trans
          (CategoryTheory.Category.id_comp x))
    have hx_arr : R.arrows x := heq_yux ▸ R.downward_closed hu₀_arr y₀
    exact ⟨T_k, x, hx_arr, 𝟙 T_k, CategoryTheory.Category.id_comp x⟩

  
  let secOf : ∀ (U : V₁.Etale), F_s₁.obj U → (S_k ⟶ U.left) :=
    fun U x => x.left ≫ CategoryTheory.Limits.pullback.fst U.hom s₁
  have hsecOf : ∀ (U : V₁.Etale) (x : F_s₁.obj U), secOf U x ≫ U.hom = s₁ :=
    fun U x =>
      (CategoryTheory.Category.assoc x.left
        (CategoryTheory.Limits.pullback.fst U.hom s₁) U.hom).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp x.left)
          (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := s₁))).trans
          ((CategoryTheory.Category.assoc x.left
            (CategoryTheory.Limits.pullback.snd U.hom s₁) s₁).symm.trans
            ((congrArg (fun t : S_k ⟶ S_k => CategoryTheory.CategoryStruct.comp t s₁)
              (CategoryTheory.MorphismProperty.Over.w x)).trans
              (CategoryTheory.Category.id_comp s₁))))
  let ptOf : ∀ (U : V₁.Etale) (σ : S_k ⟶ U.left), σ ≫ U.hom = s₁ → F_s₁.obj U :=
    fun U σ hσ =>
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.lift σ (𝟙 S_k)
          (hσ.trans (CategoryTheory.Category.id_comp s₁).symm))
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
  have hsec_pt : ∀ (U : V₁.Etale) (σ : S_k ⟶ U.left) (hσ : σ ≫ U.hom = s₁),
      secOf U (ptOf U σ hσ) = σ :=
    fun U σ hσ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hsec_inj : ∀ {U : V₁.Etale} {x₁ x₂ : F_s₁.obj U},
      secOf U x₁ = secOf U x₂ → x₁ = x₂ := by
    intro U x₁ x₂ h
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact h
    · exact (CategoryTheory.MorphismProperty.Over.w x₁).trans
        (CategoryTheory.MorphismProperty.Over.w x₂).symm
  have hB_s₁_fst : ∀ {U' U : V₁.Etale} (m : U' ⟶ U),
      (B_s₁.map m).left ≫ CategoryTheory.Limits.pullback.fst U.hom s₁ =
        CategoryTheory.Limits.pullback.fst U'.hom s₁ ≫ m.left :=
    fun m => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hmap_sec : ∀ {U' U : V₁.Etale} (m : U' ⟶ U) (y : F_s₁.obj U'),
      secOf U (F_s₁.map m y) = secOf U' y ≫ m.left :=
    fun m y =>
      (CategoryTheory.Category.assoc y.left (B_s₁.map m).left
        (CategoryTheory.Limits.pullback.fst _ s₁)).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp y.left) (hB_s₁_fst m)).trans
          (CategoryTheory.Category.assoc y.left
            (CategoryTheory.Limits.pullback.fst _ s₁) m.left).symm)

  
  have hc₂ : CategoryTheory.IsCofiltered F_s₁.Elements := by
    have hNonempty : Nonempty F_s₁.Elements :=
      ⟨CategoryTheory.Functor.elementsMk F_s₁ (idEtale V₁)
        (ptOf (idEtale V₁) s₁ (CategoryTheory.Category.comp_id s₁))⟩
    refine @CategoryTheory.IsCofiltered.mk F_s₁.Elements _
      (@CategoryTheory.IsCofilteredOrEmpty.mk F_s₁.Elements _ ?_ ?_) hNonempty
    · intro z₁ z₂
      let U₁ := z₁.1
      let U₂ := z₂.1
      let σ₁ := secOf U₁ z₁.2
      let σ₂ := secOf U₂ z₂.2
      have : AlgebraicGeometry.Etale U₁.hom := U₁.prop
      have : AlgebraicGeometry.Etale U₂.hom := U₂.prop
      let P₁₂ := CategoryTheory.Limits.pullback U₁.hom U₂.hom
      let p₁ : P₁₂ ⟶ U₁.left := CategoryTheory.Limits.pullback.fst U₁.hom U₂.hom
      let p₂ : P₁₂ ⟶ U₂.left := CategoryTheory.Limits.pullback.snd U₁.hom U₂.hom
      have : AlgebraicGeometry.Etale p₁ := inferInstance
      have : AlgebraicGeometry.Etale (p₁ ≫ U₁.hom) :=
        P_et.comp_mem p₁ U₁.hom inferInstance inferInstance
      let U₁₂ : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ U₁.hom) inferInstance
      let m₁ : U₁₂ ⟶ U₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
      let m₂ : U₁₂ ⟶ U₂ :=
        CategoryTheory.MorphismProperty.Over.homMk p₂
          CategoryTheory.Limits.pullback.condition.symm trivial
      let σ₁₂ : S_k ⟶ P₁₂ :=
        CategoryTheory.Limits.pullback.lift σ₁ σ₂
          ((hsecOf U₁ z₁.2).trans (hsecOf U₂ z₂.2).symm)
      have hσ₁₂ : σ₁₂ ≫ U₁₂.hom = s₁ :=
        (CategoryTheory.Category.assoc σ₁₂ p₁ U₁.hom).symm.trans
          ((congrArg (· ≫ U₁.hom) (CategoryTheory.Limits.pullback.lift_fst σ₁ σ₂ _)).trans
            (hsecOf U₁ z₁.2))
      let z₁₂ : F_s₁.Elements :=
        CategoryTheory.Functor.elementsMk F_s₁ U₁₂ (ptOf U₁₂ σ₁₂ hσ₁₂)
      let f₁_el : z₁₂ ⟶ z₁ :=
        ⟨m₁, hsec_inj ((hmap_sec m₁ z₁₂.2).trans
          ((congrArg (· ≫ p₁) (hsec_pt U₁₂ σ₁₂ hσ₁₂)).trans
            (CategoryTheory.Limits.pullback.lift_fst σ₁ σ₂ _)))⟩
      let f₂_el : z₁₂ ⟶ z₂ :=
        ⟨m₂, hsec_inj ((hmap_sec m₂ z₁₂.2).trans
          ((congrArg (· ≫ p₂) (hsec_pt U₁₂ σ₁₂ hσ₁₂)).trans
            (CategoryTheory.Limits.pullback.lift_snd σ₁ σ₂ _)))⟩
      exact ⟨z₁₂, f₁_el, f₂_el, trivial⟩
    · intro z₁ z₂ f g
      let U₁ := z₁.1
      let U₂ := z₂.1
      let σ₁ := secOf U₁ z₁.2
      let σ₂ := secOf U₂ z₂.2
      have hf_sec : σ₁ ≫ f.1.left = σ₂ :=
        (hmap_sec f.1 z₁.2).symm.trans (congrArg (secOf U₂) f.2)
      have hg_sec : σ₁ ≫ g.1.left = σ₂ :=
        (hmap_sec g.1 z₁.2).symm.trans (congrArg (secOf U₂) g.2)
      have : AlgebraicGeometry.Etale U₁.hom := U₁.prop
      have : AlgebraicGeometry.Etale U₂.hom := U₂.prop
      let P₂₂ := CategoryTheory.Limits.pullback U₂.hom U₂.hom
      let fst₂₂ := CategoryTheory.Limits.pullback.fst U₂.hom U₂.hom
      let snd₂₂ := CategoryTheory.Limits.pullback.snd U₂.hom U₂.hom
      have : AlgebraicGeometry.Etale fst₂₂ := inferInstance
      let Δ₂ : U₂.left ⟶ P₂₂ :=
        CategoryTheory.Limits.pullback.lift (𝟙 U₂.left) (𝟙 U₂.left) rfl
      have hΔ_fst : Δ₂ ≫ fst₂₂ = 𝟙 U₂.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hΔ_snd : Δ₂ ≫ snd₂₂ = 𝟙 U₂.left :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have : AlgebraicGeometry.Etale Δ₂ :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) Δ₂ fst₂₂
          (inferInstance : AlgebraicGeometry.Etale fst₂₂)
          (hΔ_fst.symm ▸ (inferInstance : AlgebraicGeometry.Etale (𝟙 U₂.left)))
      let pair_fg : U₁.left ⟶ P₂₂ :=
        CategoryTheory.Limits.pullback.lift f.1.left g.1.left
          ((CategoryTheory.MorphismProperty.Over.w f.1).trans
            (CategoryTheory.MorphismProperty.Over.w g.1).symm)
      let E := CategoryTheory.Limits.pullback pair_fg Δ₂
      let p_E : E ⟶ U₁.left := CategoryTheory.Limits.pullback.fst pair_fg Δ₂
      let q_E : E ⟶ U₂.left := CategoryTheory.Limits.pullback.snd pair_fg Δ₂
      have : AlgebraicGeometry.Etale p_E := inferInstance
      have : AlgebraicGeometry.Etale (p_E ≫ U₁.hom) :=
        P_et.comp_mem p_E U₁.hom inferInstance inferInstance
      let U_E : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p_E ≫ U₁.hom) inferInstance
      let m_E : U_E ⟶ U₁ := CategoryTheory.MorphismProperty.Over.homMk p_E rfl trivial
      have hσ_pair : σ₁ ≫ pair_fg = σ₂ ≫ Δ₂ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc σ₁ pair_fg fst₂₂).trans
            ((congrArg (σ₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (hf_sec.trans
                ((CategoryTheory.Category.comp_id σ₂).symm.trans
                  ((congrArg (σ₂ ≫ ·) hΔ_fst.symm).trans
                    (CategoryTheory.Category.assoc σ₂ Δ₂ fst₂₂).symm))))
        · exact (CategoryTheory.Category.assoc σ₁ pair_fg snd₂₂).trans
            ((congrArg (σ₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              (hg_sec.trans
                ((CategoryTheory.Category.comp_id σ₂).symm.trans
                  ((congrArg (σ₂ ≫ ·) hΔ_snd.symm).trans
                    (CategoryTheory.Category.assoc σ₂ Δ₂ snd₂₂).symm))))
      let σ_E : S_k ⟶ E := CategoryTheory.Limits.pullback.lift σ₁ σ₂ hσ_pair
      have hσ_E : σ_E ≫ U_E.hom = s₁ :=
        (CategoryTheory.Category.assoc σ_E p_E U₁.hom).symm.trans
          ((congrArg (· ≫ U₁.hom) (CategoryTheory.Limits.pullback.lift_fst σ₁ σ₂ hσ_pair)).trans
            (hsecOf U₁ z₁.2))
      let z_E : F_s₁.Elements :=
        CategoryTheory.Functor.elementsMk F_s₁ U_E (ptOf U_E σ_E hσ_E)
      let h_E : z_E ⟶ z₁ :=
        ⟨m_E, hsec_inj ((hmap_sec m_E z_E.2).trans
          ((congrArg (· ≫ p_E) (hsec_pt U_E σ_E hσ_E)).trans
            (CategoryTheory.Limits.pullback.lift_fst σ₁ σ₂ hσ_pair)))⟩
      refine ⟨z_E, h_E, CategoryTheory.Functor.Elements.hom_ext ?_⟩
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
      have heq_f : p_E ≫ f.1.left = q_E :=
        (congrArg (p_E ≫ ·) (CategoryTheory.Limits.pullback.lift_fst f.1.left g.1.left _).symm).trans
          ((CategoryTheory.Category.assoc p_E pair_fg fst₂₂).symm.trans
            ((congrArg (· ≫ fst₂₂) (CategoryTheory.Limits.pullback.condition (f := pair_fg) (g := Δ₂))).trans
              ((CategoryTheory.Category.assoc q_E Δ₂ fst₂₂).trans
                ((congrArg (q_E ≫ ·) hΔ_fst).trans (CategoryTheory.Category.comp_id q_E)))))
      have heq_g : p_E ≫ g.1.left = q_E :=
        (congrArg (p_E ≫ ·) (CategoryTheory.Limits.pullback.lift_snd f.1.left g.1.left _).symm).trans
          ((CategoryTheory.Category.assoc p_E pair_fg snd₂₂).symm.trans
            ((congrArg (· ≫ snd₂₂) (CategoryTheory.Limits.pullback.condition (f := pair_fg) (g := Δ₂))).trans
              ((CategoryTheory.Category.assoc q_E Δ₂ snd₂₂).trans
                ((congrArg (q_E ≫ ·) hΔ_snd).trans (CategoryTheory.Category.comp_id q_E)))))
      exact heq_f.trans heq_g.symm

  have hs₂_sm : CategoryTheory.InitiallySmall.{u, u, u + 1} F_s₁.Elements := by
    let R_V₁ : CommRingCat.{u} := V₁.presheaf.obj (Opposite.op ⊤)
    let A₁ : Type u := ↑R_V₁
    let e_V₁ : V₁ ≅ AlgebraicGeometry.Spec R_V₁ := V₁.isoSpec
    have : AlgebraicGeometry.Etale e_V₁.hom := inferInstance
    have : AlgebraicGeometry.Etale e_V₁.inv := inferInstance
    let Idx : Type u :=
      { p : Σ (r : ℕ) (I : Ideal (MvPolynomial (Fin r) A₁)),
          ((MvPolynomial (Fin r) A₁ ⧸ I) →+* k) //
        RingHom.Etale ((Ideal.Quotient.mk p.2.1).comp
          (MvPolynomial.C : A₁ →+* MvPolynomial (Fin p.1) A₁)) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom p.2.2) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk p.2.1).comp
            (MvPolynomial.C : A₁ →+* MvPolynomial (Fin p.1) A₁))) ≫
          e_V₁.inv = s₁ }
    let modelObj : Idx → F_s₁.Elements := fun p =>
      let Q_p : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin p.1.1) A₁ ⧸ p.1.2.1)
      let φ_p : R_V₁ ⟶ Q_p :=
        CommRingCat.ofHom ((Ideal.Quotient.mk p.1.2.1).comp MvPolynomial.C)
      let hEt_φ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_p) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mpr p.2.1
      let g_p : AlgebraicGeometry.Spec Q_p ⟶ V₁ := AlgebraicGeometry.Spec.map φ_p ≫ e_V₁.inv
      let hEt_gp : AlgebraicGeometry.Etale g_p :=
        P_et.comp_mem _ _ hEt_φ inferInstance
      let U_p : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g_p hEt_gp
      let σ_p : S_k ⟶ AlgebraicGeometry.Spec Q_p :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom p.1.2.2)
      CategoryTheory.Functor.elementsMk F_s₁ U_p (ptOf U_p σ_p p.2.2)
    let s_mod : Set F_s₁.Elements := Set.range modelObj
    have : CategoryTheory.IsCofiltered F_s₁.Elements := hc₂
    exact CategoryTheory.initiallySmall_of_small_weakly_initial_set s_mod fun i => by
      let U := i.1
      let x := i.2
      let σ := secOf U x
      have hσ : σ ≫ U.hom = s₁ := hsecOf U x
      have : AlgebraicGeometry.Etale U.hom := U.prop
      obtain ⟨W, hW, hpt_W, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (X := U.left) (x := σ.base pt_k) (U := ⊤) trivial
      have hRange_σ : Set.range σ.base ⊆ Set.range hW.fromSpec.base := by
        rw [hW.range_fromSpec]
        rintro _ ⟨z, rfl⟩
        rw [Subsingleton.elim z pt_k]
        exact hpt_W
      let R_W : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op W)
      let B : Type u := ↑R_W
      let σ_W : S_k ⟶ AlgebraicGeometry.Spec R_W :=
        AlgebraicGeometry.IsOpenImmersion.lift hW.fromSpec σ hRange_σ
      have hσ_W_fac : σ_W ≫ hW.fromSpec = σ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hW.fromSpec σ hRange_σ
      have : AlgebraicGeometry.Etale hW.fromSpec := inferInstance
      let u_hom : AlgebraicGeometry.Spec R_W ⟶ V₁ := hW.fromSpec ≫ U.hom
      have hu_hom_et : AlgebraicGeometry.Etale u_hom :=
        P_et.comp_mem hW.fromSpec U.hom inferInstance inferInstance
      let u_W : AlgebraicGeometry.Spec R_W ⟶ AlgebraicGeometry.Spec R_V₁ :=
        u_hom ≫ e_V₁.hom
      have hu_W_et : AlgebraicGeometry.Etale u_W :=
        P_et.comp_mem u_hom e_V₁.hom hu_hom_et inferInstance
      let ψ_cat : R_V₁ ⟶ R_W := AlgebraicGeometry.Spec.preimage u_W
      have hψ_map : AlgebraicGeometry.Spec.map ψ_cat = u_W :=
        AlgebraicGeometry.Spec.map_preimage u_W
      have hψ_et_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map ψ_cat) :=
        hψ_map.symm ▸ hu_W_et
      have hψ_et : RingHom.Etale ψ_cat.hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mp hψ_et_sch
      let _ : Algebra A₁ B := ψ_cat.hom.toAlgebra
      have : Algebra.Etale A₁ B := RingHom.etale_algebraMap.mp hψ_et
      have : Algebra.FiniteType A₁ B := inferInstance
      obtain ⟨r, q_alg, hq_surj⟩ :=
        (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := A₁) (S := B)).mp inferInstance
      let I : Ideal (MvPolynomial (Fin r) A₁) := RingHom.ker q_alg.toRingHom
      let e_ring : (MvPolynomial (Fin r) A₁ ⧸ I) ≃+* B :=
        RingHom.quotientKerEquivOfSurjective hq_surj
      let Q_r : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin r) A₁ ⧸ I)
      let iso_Q : Q_r ≅ R_W :=
        { hom := CommRingCat.ofHom e_ring.toRingHom
          inv := CommRingCat.ofHom e_ring.symm.toRingHom
          hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun z => e_ring.symm_apply_apply z)
          inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun z => e_ring.apply_symm_apply z) }
      let iso_SpecQ : AlgebraicGeometry.Spec Q_r ≅ AlgebraicGeometry.Spec R_W :=
        { hom := AlgebraicGeometry.Spec.map iso_Q.inv
          inv := AlgebraicGeometry.Spec.map iso_Q.hom
          hom_inv_id := (AlgebraicGeometry.Spec.map_comp iso_Q.hom iso_Q.inv).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map iso_Q.hom_inv_id).trans
              (AlgebraicGeometry.Spec.map_id Q_r))
          inv_hom_id := (AlgebraicGeometry.Spec.map_comp iso_Q.inv iso_Q.hom).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map iso_Q.inv_hom_id).trans
              (AlgebraicGeometry.Spec.map_id R_W)) }
      have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map iso_Q.inv) :=
        ⟨⟨AlgebraicGeometry.Spec.map iso_Q.hom, iso_SpecQ.hom_inv_id, iso_SpecQ.inv_hom_id⟩⟩
      have : AlgebraicGeometry.Etale iso_SpecQ.hom := inferInstance
      let φ_r_hom : A₁ →+* (MvPolynomial (Fin r) A₁ ⧸ I) :=
        (Ideal.Quotient.mk I).comp MvPolynomial.C
      let φ_r : R_V₁ ⟶ Q_r := CommRingCat.ofHom φ_r_hom
      have hφ_iso : φ_r ≫ iso_Q.hom = ψ_cat :=
        CommRingCat.hom_ext (RingHom.ext fun a =>
          (RingHom.kerLift_mk q_alg.toRingHom (MvPolynomial.C a)).trans (q_alg.commutes a))
      have hφ_inv : ψ_cat ≫ iso_Q.inv = φ_r :=
        (congrArg (· ≫ iso_Q.inv) hφ_iso.symm).trans
          ((CategoryTheory.Category.assoc φ_r iso_Q.hom iso_Q.inv).trans
            ((congrArg (φ_r ≫ ·) iso_Q.hom_inv_id).trans (CategoryTheory.Category.comp_id φ_r)))
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_r =
          iso_SpecQ.hom ≫ AlgebraicGeometry.Spec.map ψ_cat :=
        (congrArg AlgebraicGeometry.Spec.map hφ_inv.symm).trans
          (AlgebraicGeometry.Spec.map_comp ψ_cat iso_Q.inv)
      have hEt_Spec_φ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_r) :=
        hSpec_φ.symm ▸ P_et.comp_mem iso_SpecQ.hom (AlgebraicGeometry.Spec.map ψ_cat)
          inferInstance hψ_et_sch
      have hEt_φ_hom : RingHom.Etale φ_r_hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et) (φ := φ_r)).mp hEt_Spec_φ
      let ε_cat : R_W ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage σ_W
      have hε_map : AlgebraicGeometry.Spec.map ε_cat = σ_W :=
        AlgebraicGeometry.Spec.map_preimage σ_W
      let ε_r : (MvPolynomial (Fin r) A₁ ⧸ I) →+* k := (iso_Q.hom ≫ ε_cat).hom
      let σ_p₀ : S_k ⟶ AlgebraicGeometry.Spec Q_r :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_r)
      have hε_Spec : σ_p₀ = σ_W ≫ iso_SpecQ.inv :=
        (AlgebraicGeometry.Spec.map_comp iso_Q.hom ε_cat).trans
          (congrArg (· ≫ iso_SpecQ.inv) hε_map)
      let m_left : AlgebraicGeometry.Spec Q_r ⟶ U.left :=
        iso_SpecQ.hom ≫ hW.fromSpec
      have hgp_eq : AlgebraicGeometry.Spec.map φ_r ≫ e_V₁.inv = iso_SpecQ.hom ≫ u_hom := by
        have h1 : AlgebraicGeometry.Spec.map φ_r = iso_SpecQ.hom ≫ (u_hom ≫ e_V₁.hom) :=
          hSpec_φ.trans (congrArg (iso_SpecQ.hom ≫ ·) hψ_map)
        exact (congrArg (· ≫ e_V₁.inv) h1).trans
          ((CategoryTheory.Category.assoc iso_SpecQ.hom (u_hom ≫ e_V₁.hom) e_V₁.inv).trans
            (congrArg (iso_SpecQ.hom ≫ ·)
              ((CategoryTheory.Category.assoc u_hom e_V₁.hom e_V₁.inv).trans
                ((congrArg (u_hom ≫ ·) e_V₁.hom_inv_id).trans
                  (CategoryTheory.Category.comp_id u_hom)))))
      have hgp_m : AlgebraicGeometry.Spec.map φ_r ≫ e_V₁.inv = m_left ≫ U.hom :=
        hgp_eq.trans (CategoryTheory.Category.assoc iso_SpecQ.hom hW.fromSpec U.hom).symm
      have hm_sec : σ_p₀ ≫ m_left = σ :=
        (congrArg (· ≫ m_left) hε_Spec).trans
          ((CategoryTheory.Category.assoc σ_W iso_SpecQ.inv m_left).trans
            ((congrArg (σ_W ≫ ·)
              ((CategoryTheory.Category.assoc iso_SpecQ.inv iso_SpecQ.hom hW.fromSpec).symm.trans
                ((congrArg (· ≫ hW.fromSpec) iso_SpecQ.inv_hom_id).trans
                  (CategoryTheory.Category.id_comp hW.fromSpec)))).trans
              hσ_W_fac))
      have hsec_p : σ_p₀ ≫ AlgebraicGeometry.Spec.map φ_r ≫ e_V₁.inv = s₁ :=
        (congrArg (σ_p₀ ≫ ·) hgp_m).trans
          ((CategoryTheory.Category.assoc σ_p₀ m_left U.hom).symm.trans
            ((congrArg (· ≫ U.hom) hm_sec).trans hσ))
      let p : Idx := ⟨⟨r, I, ε_r⟩, hEt_φ_hom, hsec_p⟩
      have hm_w : m_left ≫ U.hom = (modelObj p).1.hom := hgp_m.symm
      let m_mor : (modelObj p).1 ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk m_left hm_w trivial
      exact ⟨modelObj p, ⟨p, rfl⟩, ⟨⟨m_mor, hsec_inj
        ((hmap_sec m_mor (modelObj p).2).trans
          ((congrArg (· ≫ m_left) (hsec_pt (modelObj p).1 σ_p₀ hsec_p)).trans hm_sec))⟩⟩⟩

  have hm₂ : ∀ {U : V₁.Etale}, ∀ R ∈ V₁.smallEtaleTopology U,
      ∀ (x : F_s₁.obj U), ∃ (U' : V₁.Etale) (f : U' ⟶ U),
        ∃ (_ : R.arrows f), ∃ y : F_s₁.obj U', F_s₁.map f y = x := by
    intro U R hR x
    let σ := secOf U x
    have hσ : σ ≫ U.hom = s₁ := hsecOf U x
    have heq_JV : V₁.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) V₁ (le_refl P_et)
    have hR_pre : R ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U :=
      heq_JV ▸ hR
    obtain ⟨U₀, f₀, z₀, hf₀_arr, hf₀_et, hz₀⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U R).mp hR_pre (σ.base pt_k)
    have : AlgebraicGeometry.Etale f₀.left := hf₀_et
    let Z := CategoryTheory.Limits.pullback f₀.left σ
    let g_Z : Z ⟶ S_k := CategoryTheory.Limits.pullback.snd f₀.left σ
    have : AlgebraicGeometry.Etale g_Z := inferInstance
    obtain ⟨w_Z, _, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₀ pt_k hz₀
    obtain ⟨s_Z, hs_Z⟩ := hNullSec Z g_Z inferInstance ⟨w_Z⟩
    let σ₀ : S_k ⟶ U₀.left := s_Z ≫ CategoryTheory.Limits.pullback.fst f₀.left σ
    have hσ₀_f : σ₀ ≫ f₀.left = σ :=
      (CategoryTheory.Category.assoc s_Z
        (CategoryTheory.Limits.pullback.fst f₀.left σ) f₀.left).trans
        ((congrArg (s_Z ≫ ·) (CategoryTheory.Limits.pullback.condition (f := f₀.left) (g := σ))).trans
          ((CategoryTheory.Category.assoc s_Z g_Z σ).symm.trans
            ((congrArg (· ≫ σ) hs_Z).trans (CategoryTheory.Category.id_comp σ))))
    have hσ₀ : σ₀ ≫ U₀.hom = s₁ :=
      (congrArg (σ₀ ≫ ·) (CategoryTheory.MorphismProperty.Over.w f₀).symm).trans
        ((CategoryTheory.Category.assoc σ₀ f₀.left U.hom).symm.trans
          ((congrArg (· ≫ U.hom) hσ₀_f).trans hσ))
    let y₀ : F_s₁.obj U₀ := ptOf U₀ σ₀ hσ₀
    exact ⟨U₀, f₀, hf₀_arr, y₀, hsec_inj
      ((hmap_sec f₀ y₀).trans ((congrArg (· ≫ f₀.left) (hsec_pt U₀ σ₀ hσ₀)).trans hσ₀_f))⟩

  
  rcases hPBC_q with ⟨hCont_s₁, hAdj_s₁, hIso_PBC⟩
  have : B_s₁.IsContinuous V₁.smallEtaleTopology S_k.smallEtaleTopology := hCont_s₁
  have : (B_s₁.sheafPushforwardContinuous AddCommGrpCat.{u}
    V₁.smallEtaleTopology S_k.smallEtaleTopology).IsRightAdjoint := hAdj_s₁
  let B_f₁ : CategoryTheory.Functor V₁.Etale Y₁.Etale := weilEtaleSitePullback f₁
  let G := weilEtaleTorsionSheaf Y₁ ℓ
  let P_q : CategoryTheory.Functor (V₁.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    B_f₁.op.comp (G.cohomologyPresheaf q)
  let Φ_s₁ : CategoryTheory.GrothendieckTopology.Point.{u, u, u + 1} V₁.smallEtaleTopology :=
    @CategoryTheory.GrothendieckTopology.Point.mk _ _ V₁.smallEtaleTopology
      F_s₁ hc₂ hs₂_sm @hm₂
  have hIso_stalk : Nonempty (CategoryTheory.Iso
      (Φ_s₁.presheafFiber.obj P_q)
      (AddCommGrpCat.of (weilEtaleTorsionH C₀_sch ℓ q))) :=
    hStalkIso S_k.smallEtaleTopology V₁.smallEtaleTopology B_s₁ T_k
      hc₁ hs₁_sm (fun R hR x => hm₁ R hR x) hc₂ hs₂_sm (fun R hR x => hm₂ R hR x) P_q
      (weilEtaleHigherDirectImage q_C₀ q (weilEtaleTorsionSheaf C₀_sch ℓ))
      (AddCommGrpCat.of (weilEtaleTorsionH C₀_sch ℓ q)) hIso_PBC hSpecConst

  obtain ⟨Θ, hΘ_nat⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1 Y₁ ℓ q
  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality
  let ι_U : ∀ (U : V₁.Etale) (x_U : Φ_s₁.fiber.obj U), C₀_sch ⟶ (B_f₁.obj U).left :=
    fun U x_U =>
      CategoryTheory.Limits.pullback.lift (q_C₀ ≫ secOf U x_U) ι_C₀
        ((CategoryTheory.Category.assoc q_C₀ (secOf U x_U) U.hom).trans
          ((congrArg (q_C₀ ≫ ·) (hsecOf U x_U)).trans hPb_C₀.w.symm))
  let p_U : ∀ (U : V₁.Etale) (x_U : Φ_s₁.fiber.obj U),
      weilEtaleTorsionH (B_f₁.obj U).left ℓ q →+ weilEtaleTorsionH C₀_sch ℓ q :=
    fun U x_U => Classical.choose (hPullEx (ι_U U x_U) ℓ q)
  have hp_U : ∀ (U : V₁.Etale) (x_U : Φ_s₁.fiber.obj U),
      WeilIsTorsionEtalePullback (ι_U U x_U) ℓ q (p_U U x_U) :=
    fun U x_U => Classical.choose_spec (hPullEx (ι_U U x_U) ℓ q)
  let ev : ∀ (U : V₁.Etale), Φ_s₁.fiber.obj U →
      (↥(P_q.obj (Opposite.op U)) →+ weilEtaleTorsionH C₀_sch ℓ q) :=
    fun U x_U => (p_U U x_U).comp (Θ (B_f₁.obj U)).toAddMonoidHom

  have hev_nat : ∀ {U' U : V₁.Etale} (g : U' ⟶ U) (x' : Φ_s₁.fiber.obj U')
      (z : ↥(P_q.obj (Opposite.op U))),
      ev U' x' ((P_q.map g.op).hom z) = ev U (Φ_s₁.fiber.map g x') z := by
    intro U' U g x' z
    let x := Φ_s₁.fiber.map g x'
    have hbg_fst : (B_f₁.map g).left ≫ CategoryTheory.Limits.pullback.fst U.hom f₁ =
        CategoryTheory.Limits.pullback.fst U'.hom f₁ ≫ g.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hbg_snd : (B_f₁.map g).left ≫ CategoryTheory.Limits.pullback.snd U.hom f₁ =
        CategoryTheory.Limits.pullback.snd U'.hom f₁ :=
      CategoryTheory.MorphismProperty.Over.w (B_f₁.map g)
    have hι_fac : ι_U U' x' ≫ (B_f₁.map g).left = ι_U U x := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc (ι_U U' x') (B_f₁.map g).left _).trans
          ((congrArg (ι_U U' x' ≫ ·) hbg_fst).trans
            ((CategoryTheory.Category.assoc (ι_U U' x') _ g.left).symm.trans
              ((congrArg (· ≫ g.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.assoc q_C₀ (secOf U' x') g.left).trans
                  ((congrArg (q_C₀ ≫ ·) (hmap_sec g x').symm).trans
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)))))
      · exact (CategoryTheory.Category.assoc (ι_U U' x') (B_f₁.map g).left _).trans
          ((congrArg (ι_U U' x' ≫ ·) hbg_snd).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm))
    obtain ⟨p_g, hp_g⟩ := hPullEx ((B_f₁.map g).left) ℓ q
    have hcomp_p : p_U U x = (p_U U' x').comp p_g :=
      hPullComp (ι_U U' x') (B_f₁.map g).left ℓ q (p_U U' x') p_g (p_U U x)
        (hp_U U' x') hp_g (hι_fac.symm ▸ hp_U U x)
    exact (congrArg (p_U U' x') (hΘ_nat (B_f₁.map g) p_g hp_g z)).trans
      (congrFun (congrArg DFunLike.coe hcomp_p.symm) (Θ (B_f₁.obj U) z))

  let T_V₁ : V₁.Etale := idEtale V₁
  let x₀ : Φ_s₁.fiber.obj T_V₁ := ptOf T_V₁ s₁ (CategoryTheory.Category.comp_id s₁)
  let T_Y₁ : Y₁.Etale := idEtale Y₁
  let u₀ : B_f₁.obj T_V₁ ⟶ T_Y₁ := (hIdTerm Y₁).from (B_f₁.obj T_V₁)
  let z₀ : weilEtaleTorsionH Y₁ ℓ q → ↥(P_q.obj (Opposite.op T_V₁)) :=
    fun α => ((G.cohomologyPresheaf q).map u₀.op).hom ((Θ T_Y₁).symm α)
  have hev_z₀ : ∀ α : weilEtaleTorsionH Y₁ ℓ q, ev T_V₁ x₀ (z₀ α) = φ_C₀ α := by
    intro α
    obtain ⟨p_u₀, hp_u₀⟩ := hPullEx u₀.left ℓ q
    have hu₀_left : u₀.left = CategoryTheory.Limits.pullback.snd T_V₁.hom f₁ :=
      (CategoryTheory.Category.comp_id u₀.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w u₀)
    have hι₀ : ι_U T_V₁ x₀ ≫ u₀.left = ι_C₀ :=
      (congrArg (ι_U T_V₁ x₀ ≫ ·) hu₀_left).trans
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have hcomp₀ : φ_C₀ = (p_U T_V₁ x₀).comp p_u₀ :=
      hPullComp (ι_U T_V₁ x₀) u₀.left ℓ q (p_U T_V₁ x₀) p_u₀ φ_C₀
        (hp_U T_V₁ x₀) hp_u₀ (hι₀.symm ▸ hφ_C₀)
    exact (congrArg (p_U T_V₁ x₀)
      ((hΘ_nat u₀ p_u₀ hp_u₀ ((Θ T_Y₁).symm α)).trans
        (congrArg p_u₀ ((Θ T_Y₁).apply_symm_apply α)))).trans
      (congrFun (congrArg DFunLike.coe hcomp₀.symm) α)

  have hTest_z₀ : ev T_V₁ x₀ (z₀ α_test) ≠ 0 :=
    fun h0 => hTest_ne ((hev_z₀ α_test).symm.trans h0)
  have hTarget_z₀ : ev T_V₁ x₀ (z₀ α_target) = 0 :=
    (hev_z₀ α_target).trans hTarget_zero

  obtain ⟨U, f, x_U, _, hf_zero⟩ :=
    hPrimeVan V₁.smallEtaleTopology Φ_s₁ T_V₁ x₀ P_q (weilEtaleTorsionH C₀_sch ℓ q)
      hCard_C₀ hIso_stalk ev hev_nat (z₀ α_test) (z₀ α_target) hTest_z₀ hTarget_z₀

  let U_et : AlgebraicGeometry.Scheme.{u} := U.left
  let g_et : U_et ⟶ V₁ := U.hom
  let s_et : S_k ⟶ U_et := secOf U x_U
  refine ⟨U_et, g_et, s_et, U.prop, hsecOf U x_U, ?_⟩
  intro Y_et p_Yet φ_et hφ_et
  let w_U : B_f₁.obj U ⟶ T_Y₁ := B_f₁.map f ≫ u₀
  have hw_U_left : w_U.left = CategoryTheory.Limits.pullback.snd g_et f₁ :=
    (CategoryTheory.Category.comp_id w_U.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w w_U)
  have hw_zero : ((G.cohomologyPresheaf q).map w_U.op).hom ((Θ T_Y₁).symm α_target) = 0 := by
    have hcomp_map : (G.cohomologyPresheaf q).map w_U.op =
        (G.cohomologyPresheaf q).map u₀.op ≫
          (G.cohomologyPresheaf q).map (B_f₁.map f).op :=
      (congrArg (G.cohomologyPresheaf q).map (hop_comp (B_f₁.map f) u₀)).trans
        ((G.cohomologyPresheaf q).map_comp u₀.op (B_f₁.map f).op)
    exact (congrArg (fun φ => φ.hom ((Θ T_Y₁).symm α_target)) hcomp_map).trans hf_zero
  obtain ⟨p_W, hp_W⟩ := hPullEx w_U.left ℓ q
  have hp_W_zero : p_W α_target = 0 :=
    (congrArg p_W ((Θ T_Y₁).apply_symm_apply α_target).symm).trans
      ((hΘ_nat w_U p_W hp_W ((Θ T_Y₁).symm α_target)).symm.trans
        ((congrArg (Θ (B_f₁.obj U)) hw_zero).trans (map_zero (Θ (B_f₁.obj U)))))
  let sym : Y_et ⟶ (B_f₁.obj U).left :=
    (CategoryTheory.Limits.pullbackSymmetry g_et f₁).inv
  have hsym_eq : sym ≫ w_U.left = p_Yet :=
    (congrArg (sym ≫ ·) hw_U_left).trans
      (CategoryTheory.Limits.pullbackSymmetry_inv_comp_snd g_et f₁)
  obtain ⟨p_sym, hp_sym⟩ := hPullEx sym ℓ q
  have hφ_et_eq : φ_et = p_sym.comp p_W :=
    hPullComp sym w_U.left ℓ q p_sym p_W φ_et hp_sym hp_W (hsym_eq.symm ▸ hφ_et)
  exact (congrFun (congrArg DFunLike.coe hφ_et_eq) α_target).trans
    ((congrArg p_sym hp_W_zero).trans (map_zero p_sym))

theorem weil_rel_curve_two_open_pbc_gm_divisibility (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (δ : ℕ)
    (V₁ Y₁ : AlgebraicGeometry.Scheme.{u})
    (p_V₁ : Quiver.Hom V₁ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (u_V₁ : Quiver.Hom V₁ (weilAffineSpaceOver k δ).left)
    [AlgebraicGeometry.IsAffine V₁] [AlgebraicGeometry.IsIntegral V₁]
    [AlgebraicGeometry.LocallyOfFiniteType p_V₁] [AlgebraicGeometry.Etale u_V₁]
    (v₁ : ↥V₁) (hv₁_cl : IsClosed ({v₁} : Set ↥V₁))
    (s₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V₁)
    (hs₁_range : Set.range s₁.base = {v₁})
    (hs₁_sec : CategoryTheory.CategoryStruct.comp s₁ p_V₁ =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₁ : Quiver.Hom Y₁ V₁)
    [AlgebraicGeometry.IsProper f₁] [AlgebraicGeometry.SmoothOfRelativeDimension 1 f₁]
    (hIntY₁ : AlgebraicGeometry.IsIntegral Y₁)
    (m : ℕ) (hm : 1 ≤ m)
    (τ₁ : Fin m → Quiver.Hom V₁ Y₁)
    (hτ₁_sec : ∀ a : Fin m, CategoryTheory.CategoryStruct.comp (τ₁ a) f₁ =
      CategoryTheory.CategoryStruct.id V₁)
    (hτ₁_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ₁ a))
    (hτ₁_disj : _root_.Pairwise fun a b : Fin m =>
      Disjoint (Set.range (τ₁ a).base) (Set.range (τ₁ b).base))
    (U_in U_out : Y₁.Opens)
    (hAff_in : AlgebraicGeometry.IsAffineOpen U_in)
    (hAff_out : AlgebraicGeometry.IsAffineOpen U_out)
    (hU_cov : U_out ⊔ U_in = ⊤)
    (hU_in_compl : (U_in : Set ↥Y₁) = (⋃ a : Fin m, Set.range (τ₁ a).base)ᶜ)
    (t_bdry : Fin m → ↑(Y₁.presheaf.obj (Opposite.op U_out)))
    (ht_bdry : ∀ a : Fin m,
      ∃ h_le : (⊤ : V₁.Opens) ≤ (TopologicalSpace.Opens.map (τ₁ a).base).obj U_out,
        RingHom.ker (((τ₁ a).appLE U_out ⊤ h_le).hom) = Ideal.span {t_bdry a} ∧
        (Y₁.basicOpen (t_bdry a) : Set ↥Y₁) =
          (U_out : Set ↥Y₁) \ Set.range (τ₁ a).base)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_C₀ : Quiver.Hom C₀.left Y₁)
    (hPb_C₀ : CategoryTheory.IsPullback ι_C₀ C₀.hom f₁ s₁)
    (hIntC : AlgebraicGeometry.IsIntegral C₀.left)
    (hProjC : IsProjectiveOverField k C₀)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom]
    (P_pts : Fin m → { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) })
    (hP_bdry : ∀ a : Fin m, ι_C₀.base (P_pts a).1 = (τ₁ a).base v₁)
    (c : Fin m → ℕ)
    (u_div₁ : Units ↑(Y₁.presheaf.obj (Opposite.op (U_out ⊓ U_in))))
    (hu_div₁ : (Y₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_out ⊓ U_in ≤ U_out)).op).hom
      (Finset.univ.prod fun a : Fin m => (t_bdry a) ^ (c a)) =
      (u_div₁ : ↑(Y₁.presheaf.obj (Opposite.op (U_out ⊓ U_in)))))
    (hDiv_ell : ∃ d₀ : weilCurveClGroup C₀.left,
      ℓ • d₀ = QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C₀.left)
        (Finset.univ.sum fun a : Fin m => Finsupp.single (P_pts a) (c a : ℤ))) :
    ∃ (V' : AlgebraicGeometry.Scheme.{u})
      (h_V' : Quiver.Hom V' V₁)
      (v'₀ : ↥V'),
      AlgebraicGeometry.IsAffine V' ∧
      AlgebraicGeometry.IsIntegral V' ∧
      AlgebraicGeometry.Etale h_V' ∧
      IsClosed ({v'₀} : Set ↥V') ∧
      h_V'.base v'₀ = v₁ ∧
      let Y' := CategoryTheory.Limits.pullback f₁ h_V'
      let p_Y' := CategoryTheory.Limits.pullback.fst f₁ h_V'
      let W₁ : Y'.Opens := (TopologicalSpace.Opens.map p_Y'.base).obj U_out
      let W₂ : Y'.Opens := (TopologicalSpace.Opens.map p_Y'.base).obj U_in
      let W₁₂ : Y'.Opens := W₁ ⊓ W₂
      let u_Y'_zar : Units ↑(Y'.presheaf.obj (Opposite.op W₁₂)) :=
        Units.map ((Y'.presheaf.map
          (CategoryTheory.eqToHom
            (rfl : W₁₂ = (TopologicalSpace.Opens.map p_Y'.base).obj (U_out ⊓ U_in))).op).hom.comp
          (p_Y'.app (U_out ⊓ U_in)).hom).toMonoidHom u_div₁
      ∃ ξ_Y' : (weilEtaleGmSheaf Y').H 1,
        (∃ η_Y' : (weilEtaleGmSheaf Y').H 1, ℓ • η_Y' = ξ_Y') ∧
        ∀ (K_sh Q_sh : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})
          (ι_0 : weilEtaleGmSheaf Y' ⟶ K_sh)
          (π_0 : K_sh ⟶ Q_sh)
          (h0_0 : ι_0 ≫ π_0 = 0)
          (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact),
          let V_W₁ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁.ι
            (inferInstance : AlgebraicGeometry.Etale W₁.ι)
          let V_W₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₂.ι
            (inferInstance : AlgebraicGeometry.Etale W₂.ι)
          let V_W₁₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
            (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
          let j₁₂_₁ : V_W₁₂ ⟶ V_W₁ :=
            CategoryTheory.MorphismProperty.Over.homMk
              (Y'.homOfLE inf_le_left) (Y'.homOfLE_ι inf_le_left)
          let shAdj_Y' := CategoryTheory.sheafificationAdjunction
            Y'.smallEtaleTopology AddCommGrpCat.{u}
          let Fℤ_Y' := (CategoryTheory.constantSheaf
            Y'.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))
          let u₁_Fℤ := fun (V : Y'.Etale) =>
            (((shAdj_Y'.unit.app
              ((CategoryTheory.Functor.const (Opposite Y'.Etale)).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))).app
              (Opposite.op V)).hom (ULift.up (1 : ℤ)))
          let u_Y'_sh : ↥((weilEtaleGmSheaf Y').obj.obj (Opposite.op V_W₁₂)) :=
            (((shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')).app (Opposite.op V_W₁₂)).hom
              (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u_Y'_zar)))
          ∀ (s_lift : ↥(K_sh.obj.obj (Opposite.op V_W₁)))
            (f_q : Fℤ_Y' ⟶ Q_sh),
            (K_sh.obj.map j₁₂_₁.op).hom s_lift =
              (ι_0.hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh →
            (f_q.hom.app (Opposite.op V_W₁)).hom (u₁_Fℤ V_W₁) =
              (π_0.hom.app (Opposite.op V_W₁)).hom s_lift →
            (f_q.hom.app (Opposite.op V_W₂)).hom (u₁_Fℤ V_W₂) = 0 →
            ξ_Y' = (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1) :=
by
  classical
  have _ := hAff_in
  haveI : AlgebraicGeometry.IsIntegral Y₁ := hIntY₁
  haveI : AlgebraicGeometry.IsIntegral C₀.left := hIntC
  have hPrime : Nat.Prime ℓ := Fact.out

  
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hs₁_pt : s₁.base pt_k = v₁ := by
    have hmem : s₁.base pt_k ∈ Set.range s₁.base := ⟨pt_k, rfl⟩
    rwa [hs₁_range, Set.mem_singleton_iff] at hmem
  have hCl_s₁ : AlgebraicGeometry.IsClosedImmersion s₁ := by
    let e_V := V₁.isoSpec
    let A_cat := V₁.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V₁)
    let ψ_s : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    have hφψ : φ_k ≫ ψ_s = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁_sec, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ_s.hom := fun x =>
      ⟨φ_k.hom x, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom x) hφψ⟩
    have hCl_ψ : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map ψ_s) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective ψ_s hψ_surj
    have hs_eq : s₁ = AlgebraicGeometry.Spec.map ψ_s ≫ e_V.inv := by
      dsimp only [ψ_s]
      rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        e_V.hom_inv_id, CategoryTheory.Category.comp_id]
    rw [hs_eq]
    exact (CategoryTheory.MorphismProperty.cancel_right_of_respectsIso
      (@AlgebraicGeometry.IsClosedImmersion) (AlgebraicGeometry.Spec.map ψ_s) e_V.inv).mpr hCl_ψ
  haveI : AlgebraicGeometry.IsClosedImmersion s₁ := hCl_s₁
  haveI : AlgebraicGeometry.IsClosedImmersion ι_C₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_C₀.flip inferInstance
  have hι_inj : Function.Injective ι_C₀.base := ι_C₀.isClosedEmbedding.injective
  have hι_C₀_fk : ι_C₀ ≫ (f₁ ≫ p_V₁) = C₀.hom := by
    rw [← CategoryTheory.Category.assoc, hPb_C₀.w, CategoryTheory.Category.assoc,
      hs₁_sec, CategoryTheory.Category.comp_id]

  have hPre_τ : ∀ a : Fin m,
      ι_C₀.base ⁻¹' Set.range (τ₁ a).base = ({(P_pts a).1} : Set ↥C₀.left) := by
    intro a
    ext x
    simp only [Set.mem_preimage, Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨v, hv⟩
      have hv_eq : v = v₁ := by
        calc
          v = (τ₁ a ≫ f₁).base v := by rw [hτ₁_sec a]; rfl
          _ = f₁.base ((τ₁ a).base v) := rfl
          _ = f₁.base (ι_C₀.base x) := by rw [hv]
          _ = (ι_C₀ ≫ f₁).base x := rfl
          _ = (C₀.hom ≫ s₁).base x := by rw [hPb_C₀.w]
          _ = s₁.base (C₀.hom.base x) := rfl
          _ = s₁.base pt_k := congrArg s₁.base (hSub_k.elim (C₀.hom.base x) pt_k)
          _ = v₁ := hs₁_pt
      apply hι_inj
      rw [← hv, hv_eq, hP_bdry a]
    · rintro rfl
      exact ⟨v₁, (hP_bdry a).symm⟩

  have hP_disj : _root_.Pairwise fun a b : Fin m => P_pts a ≠ P_pts b := by
    intro a b hne heq
    have hpt : (τ₁ a).base v₁ = (τ₁ b).base v₁ := by
      rw [← hP_bdry a, ← hP_bdry b, heq]
    exact Set.disjoint_left.mp (hτ₁_disj hne) ⟨v₁, rfl⟩ ⟨v₁, hpt.symm⟩

  
  let W₀_out : C₀.left.Opens := (TopologicalSpace.Opens.map ι_C₀.base).obj U_out
  let W₀_in : C₀.left.Opens := (TopologicalSpace.Opens.map ι_C₀.base).obj U_in
  have hAff_W0out : AlgebraicGeometry.IsAffineOpen W₀_out := hAff_out.preimage ι_C₀
  have hW0_cov : W₀_out ⊔ W₀_in = ⊤ := by
    rw [TopologicalSpace.Opens.ext_iff]
    ext x
    simp only [TopologicalSpace.Opens.coe_sup, Set.mem_union, TopologicalSpace.Opens.coe_top,
      Set.mem_univ, iff_true]
    have hx : ι_C₀.base x ∈ (U_out ⊔ U_in : Y₁.Opens) := by rw [hU_cov]; trivial
    exact hx
  have hW0_in_compl :
      (W₀_in : Set ↥C₀.left) = (⋃ a : Fin m, ({(P_pts a).1} : Set ↥C₀.left))ᶜ := by
    change ι_C₀.base ⁻¹' (U_in : Set ↥Y₁) = _
    rw [hU_in_compl, Set.preimage_compl, Set.preimage_iUnion]
    simp_rw [hPre_τ]

  let t₀ : Fin m → ↑(C₀.left.presheaf.obj (Opposite.op W₀_out)) :=
    fun a => (ι_C₀.app U_out).hom (t_bdry a)
  have ht0_basic : ∀ a : Fin m,
      (C₀.left.basicOpen (t₀ a) : Set ↥C₀.left) =
        (W₀_out : Set ↥C₀.left) \ {(P_pts a).1} := by
    intro a
    dsimp only [t₀]
    rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι_C₀ (t_bdry a)]
    change ι_C₀.base ⁻¹' (Y₁.basicOpen (t_bdry a) : Set ↥Y₁) = _
    rw [(ht_bdry a).choose_spec.2, Set.preimage_diff, hPre_τ a]
    rfl

  
  have hSpecPreimageAppLE :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ Y) (W : X.Opens) (U : Y.Opens)
        (hW : AlgebraicGeometry.IsAffineOpen W) (hU : AlgebraicGeometry.IsAffineOpen U)
        (h_le : W ≤ (TopologicalSpace.Opens.map f.base).obj U)
        (g : W.toScheme ⟶ U.toScheme),
        g ≫ U.ι = W.ι ≫ f →
        AlgebraicGeometry.Spec.preimage (hW.isoSpec.inv ≫ g ≫ hU.isoSpec.hom) =
          f.appLE U W h_le := by
    intro X Y f W U hW hU h_le g hg
    let θ := AlgebraicGeometry.Spec.preimage (hW.isoSpec.inv ≫ g ≫ hU.isoSpec.hom)
    have hmap : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map θ = g ≫ U.toSpecΓ := by
      dsimp only [θ]
      rw [AlgebraicGeometry.Spec.map_preimage, ← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hW,
        ← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hU, hW.isoSpec.hom_inv_id_assoc]
    have happ_top :
        (AlgebraicGeometry.Spec.map θ).appTop ≫ W.toSpecΓ.appTop =
          U.toSpecΓ.appTop ≫ g.appTop := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hmap,
        AlgebraicGeometry.Scheme.Hom.comp_appTop]
    rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop W,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop U,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map θ).appTop,
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality θ,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc] at happ_top
    have hθ_inv : θ ≫ W.topIso.inv = U.topIso.inv ≫ g.appTop :=
      (CategoryTheory.Iso.cancel_iso_hom_left
        (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op U))) _ _).mp happ_top
    have hθ_eq : θ = U.topIso.inv ≫ g.appTop ≫ W.topIso.hom := by
      rw [← CategoryTheory.Category.assoc U.topIso.inv, ← hθ_inv,
        CategoryTheory.Category.assoc, W.topIso.inv_hom_id, CategoryTheory.Category.comp_id]
    have hg_le₁ : (⊤ : W.toScheme.Opens) ≤ (TopologicalSpace.Opens.map (g ≫ U.ι).base).obj U :=
      fun x _ => (g.base x).2
    have hg_le₂ : (⊤ : W.toScheme.Opens) ≤ (TopologicalSpace.Opens.map (W.ι ≫ f).base).obj U :=
      fun x _ => h_le x.2
    have hg_appLE : (g ≫ U.ι).appLE U ⊤ hg_le₁ = (W.ι ≫ f).appLE U ⊤ hg_le₂ := by
      congr 1
    have hu_top : (⊤ : U.toScheme.Opens) ≤ U.ι ⁻¹ᵁ U := fun x _ =>
      Eq.mp (congrArg (fun V : Y.Opens => U.ι.base x ∈ V) U.opensRange_ι) ⟨x, rfl⟩
    have hw_top : (⊤ : W.toScheme.Opens) ≤ W.ι ⁻¹ᵁ W := fun x _ =>
      Eq.mp (congrArg (fun V : X.Opens => W.ι.base x ∈ V) W.opensRange_ι) ⟨x, rfl⟩
    have hu_refl : U.ι ⁻¹ᵁ U ≤ U.ι ⁻¹ᵁ U := fun _ hx => hx
    have hU_pre_eq_top : U.ι ⁻¹ᵁ U = (⊤ : U.toScheme.Opens) := le_antisymm le_top hu_top
    have htop_eq_U_pre : (⊤ : U.toScheme.Opens) = U.ι ⁻¹ᵁ U := hU_pre_eq_top.symm
    have hg_le_U : (⊤ : W.toScheme.Opens) ≤ g ⁻¹ᵁ (U.ι ⁻¹ᵁ U) :=
      fun x _ => hu_top (show g.base x ∈ (⊤ : U.toScheme.Opens) from trivial)
    have hL : (g ≫ U.ι).appLE U ⊤ hg_le₁ = U.topIso.inv ≫ g.appTop := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE g U.ι U (U.ι ⁻¹ᵁ U) ⊤ hu_refl hg_le_U]
      have hU_ι : U.ι.appLE U (U.ι ⁻¹ᵁ U) hu_refl =
          U.ι.appLE U ⊤ hu_top ≫
            U.toScheme.presheaf.map (CategoryTheory.eqToHom hU_pre_eq_top).op := by
        have happ_r : ∀ {V₁ V₂ : U.toScheme.Opens} (heq : V₁ = V₂)
            (e₁ : V₁ ≤ U.ι ⁻¹ᵁ U) (e₂ : V₂ ≤ U.ι ⁻¹ᵁ U),
            U.ι.appLE U V₁ e₁ =
              U.ι.appLE U V₂ e₂ ≫ U.toScheme.presheaf.map (CategoryTheory.eqToHom heq).op := by
          intro V₁ V₂ heq e₁ e₂
          subst heq
          cases Subsingleton.elim e₁ e₂
          exact ((congrArg (U.ι.appLE U V₁ e₁ ≫ ·)
            (U.toScheme.presheaf.map_id (Opposite.op V₁))).trans
            (CategoryTheory.Category.comp_id (U.ι.appLE U V₁ e₁))).symm
        exact happ_r hU_pre_eq_top hu_refl hu_top
      have hg_top : g.appLE (U.ι ⁻¹ᵁ U) ⊤ hg_le_U =
          U.toScheme.presheaf.map (CategoryTheory.eqToHom htop_eq_U_pre).op ≫ g.appTop := by
        have hg_top_le : (⊤ : W.toScheme.Opens) ≤ g ⁻¹ᵁ ⊤ := fun _ _ => trivial
        have h2 : g.appLE ⊤ ⊤ hg_top_le = g.appTop :=
          AlgebraicGeometry.Scheme.Hom.appLE_eq_app g
        have hmap_l : ∀ {U₁ U₂ : U.toScheme.Opens} (heq : U₂ = U₁)
            (e₁ : (⊤ : W.toScheme.Opens) ≤ g ⁻¹ᵁ U₁) (e₂ : (⊤ : W.toScheme.Opens) ≤ g ⁻¹ᵁ U₂),
            U.toScheme.presheaf.map (CategoryTheory.eqToHom heq).op ≫ g.appLE U₂ ⊤ e₂ =
              g.appLE U₁ ⊤ e₁ := by
          intro U₁ U₂ heq e₁ e₂
          subst heq
          exact (congrArg (· ≫ g.appLE U₂ ⊤ e₂)
            (U.toScheme.presheaf.map_id (Opposite.op U₂))).trans
            (CategoryTheory.Category.id_comp (g.appLE U₂ ⊤ e₂))
        exact (hmap_l htop_eq_U_pre hg_le_U hg_top_le).symm.trans
          (congrArg (U.toScheme.presheaf.map (CategoryTheory.eqToHom htop_eq_U_pre).op ≫ ·) h2)
      rw [hU_ι, hg_top, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (U.toScheme.presheaf.map _),
        ← U.toScheme.presheaf.map_comp, ← op_comp, CategoryTheory.eqToHom_trans,
        CategoryTheory.eqToHom_refl, op_id, CategoryTheory.Functor.map_id,
        CategoryTheory.Category.id_comp]
      congr 1
      rw [AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.topIso_inv]
      exact congrArg Y.presheaf.map (Subsingleton.elim _ _)
    have hR : (W.ι ≫ f).appLE U ⊤ hg_le₂ = f.appLE U W h_le ≫ W.topIso.inv := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W.ι f U W ⊤ h_le hw_top]
      congr 1
      rw [AlgebraicGeometry.Scheme.Opens.ι_appLE, AlgebraicGeometry.Scheme.Opens.topIso_inv]
      exact congrArg X.presheaf.map (Subsingleton.elim _ _)
    rw [hL, hR] at hg_appLE
    refine hθ_eq.trans ?_
    rw [← CategoryTheory.Category.assoc U.topIso.inv, hg_appLE,
      CategoryTheory.Category.assoc, W.topIso.inv_hom_id, CategoryTheory.Category.comp_id]

  have ht0_max : ∀ a : Fin m,
      ∃ hP_mem : (P_pts a).1 ∈ W₀_out,
        Ideal.span {(C₀.left.presheaf.germ W₀_out (P_pts a).1 hP_mem).hom (t₀ a)} =
          IsLocalRing.maximalIdeal ↑(C₀.left.presheaf.stalk (P_pts a).1) := by
    intro a
    obtain ⟨h_le_a, hker_a, _⟩ := ht_bdry a
    have hP_mem : (P_pts a).1 ∈ W₀_out := by
      change ι_C₀.base (P_pts a).1 ∈ U_out
      rw [hP_bdry a]
      exact h_le_a (show v₁ ∈ (⊤ : V₁.Opens) from trivial)
    refine ⟨hP_mem, ?_⟩
    let σ₀_a : S_k ⟶ C₀.left :=
      hPb_C₀.lift (s₁ ≫ τ₁ a) (𝟙 S_k)
        (by rw [CategoryTheory.Category.assoc, hτ₁_sec a,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hσ₀_ι : σ₀_a ≫ ι_C₀ = s₁ ≫ τ₁ a := hPb_C₀.lift_fst _ _ _
    have hσ₀_hom : σ₀_a ≫ C₀.hom = 𝟙 S_k := hPb_C₀.lift_snd _ _ _
    have hσ₀_pt : σ₀_a.base pt_k = (P_pts a).1 := by
      apply hι_inj
      change (σ₀_a ≫ ι_C₀).base pt_k = ι_C₀.base (P_pts a).1
      rw [hσ₀_ι, hP_bdry a]
      change (τ₁ a).base (s₁.base pt_k) = (τ₁ a).base v₁
      rw [hs₁_pt]
    have hrng_W0 : Set.range (W₀_out.ι ≫ ι_C₀).base ⊆ Set.range U_out.ι.base := by
      rintro _ ⟨y, rfl⟩
      exact ⟨⟨ι_C₀.base y.1, y.2⟩, rfl⟩
    let ι_out : W₀_out.toScheme ⟶ U_out.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_out.ι (W₀_out.ι ≫ ι_C₀) hrng_W0
    have hι_out_fac : ι_out ≫ U_out.ι = W₀_out.ι ≫ ι_C₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_out.ι (W₀_out.ι ≫ ι_C₀) hrng_W0
    have hPb_W0 : CategoryTheory.IsPullback ι_out W₀_out.ι U_out.ι ι_C₀ := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback ι_out W₀_out.ι U_out.ι ι_C₀
        hι_out_fac.symm
      rw [U_out.opensRange_ι, W₀_out.opensRange_ι]
    have hPb_out : CategoryTheory.IsPullback ι_out (W₀_out.ι ≫ C₀.hom)
        (U_out.ι ≫ f₁) s₁ :=
      hPb_W0.paste_vert hPb_C₀
    have hrng_τ : Set.range (τ₁ a).base ⊆ Set.range U_out.ι.base := by
      rintro _ ⟨v, rfl⟩
      exact ⟨⟨(τ₁ a).base v, h_le_a trivial⟩, rfl⟩
    let τ_out : V₁ ⟶ U_out.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_out.ι (τ₁ a) hrng_τ
    have hτ_out_fac : τ_out ≫ U_out.ι = τ₁ a :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_out.ι (τ₁ a) hrng_τ
    have hrng_σ : Set.range σ₀_a.base ⊆ Set.range W₀_out.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [hSub_k.elim z pt_k, hσ₀_pt]
      exact ⟨⟨(P_pts a).1, hP_mem⟩, rfl⟩
    let σ_out : S_k ⟶ W₀_out.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W₀_out.ι σ₀_a hrng_σ
    have hσ_out_fac : σ_out ≫ W₀_out.ι = σ₀_a :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W₀_out.ι σ₀_a hrng_σ
    have hσ_ι_comm : σ_out ≫ ι_out = s₁ ≫ τ_out := by
      rw [← CategoryTheory.cancel_mono U_out.ι]
      rw [CategoryTheory.Category.assoc, hι_out_fac, ← CategoryTheory.Category.assoc σ_out,
        hσ_out_fac, hσ₀_ι, CategoryTheory.Category.assoc, hτ_out_fac]
    have hσ_f₀ : σ_out ≫ (W₀_out.ι ≫ C₀.hom) = 𝟙 S_k := by
      rw [← CategoryTheory.Category.assoc, hσ_out_fac, hσ₀_hom]
    have hτ_f₁ : τ_out ≫ (U_out.ι ≫ f₁) = 𝟙 V₁ := by
      rw [← CategoryTheory.Category.assoc, hτ_out_fac, hτ₁_sec a]
    have hId_s₁ : CategoryTheory.IsPullback s₁ (𝟙 S_k) (𝟙 V₁) s₁ :=
      CategoryTheory.IsPullback.of_vert_isIso
        ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
    have hPb_sec : CategoryTheory.IsPullback σ_out s₁ ι_out τ_out :=
      (CategoryTheory.IsPullback.of_bot
        (by rwa [hσ_f₀, hτ_f₁]) hσ_ι_comm.symm hPb_out).flip

    
    let hAff_topV₁ : AlgebraicGeometry.IsAffineOpen (⊤ : V₁.Opens) :=
      AlgebraicGeometry.isAffineOpen_top V₁
    let B₀_cat := C₀.left.presheaf.obj (Opposite.op W₀_out)
    let B₁_cat := Y₁.presheaf.obj (Opposite.op U_out)
    let A₁_cat := V₁.presheaf.obj (Opposite.op (⊤ : V₁.Opens))
    let e_W0 := hAff_W0out.isoSpec
    let e_U1 := hAff_out.isoSpec
    let e_V1 : V₁ ≅ AlgebraicGeometry.Spec A₁_cat :=
      V₁.topIso.symm ≪≫ hAff_topV₁.isoSpec
    have he_V1_top : hAff_topV₁.isoSpec.inv ≫ (⊤ : V₁.Opens).ι = e_V1.inv := by
      dsimp only [e_V1, CategoryTheory.Iso.trans_inv, CategoryTheory.Iso.symm_inv]
      have htop_hom : (⊤ : V₁.Opens).ι = V₁.topIso.hom :=
        (CategoryTheory.Iso.inv_comp_eq V₁.topIso).mp
          (AlgebraicGeometry.Scheme.toIso_inv_ι V₁)
      rw [htop_hom]
    let θ_σ : B₀_cat ⟶ CommRingCat.of k :=
      AlgebraicGeometry.Spec.preimage (σ_out ≫ e_W0.hom)
    let θ_s : A₁_cat ⟶ CommRingCat.of k :=
      AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V1.hom)
    let θ_τ : B₁_cat ⟶ A₁_cat :=
      AlgebraicGeometry.Spec.preimage (e_V1.inv ≫ τ_out ≫ e_U1.hom)
    let θ_ι : B₁_cat ⟶ B₀_cat :=
      AlgebraicGeometry.Spec.preimage (e_W0.inv ≫ ι_out ≫ e_U1.hom)
    let c₀_hom : CommRingCat.of k ⟶ B₀_cat :=
      AlgebraicGeometry.Spec.preimage (e_W0.inv ≫ W₀_out.ι ≫ C₀.hom)
    let c₁_hom : A₁_cat ⟶ B₁_cat :=
      AlgebraicGeometry.Spec.preimage (e_U1.inv ≫ U_out.ι ≫ f₁ ≫ e_V1.hom)

    have hθ_ι_eq : θ_ι = ι_C₀.app U_out := by
      have h1 := hSpecPreimageAppLE ι_C₀ W₀_out U_out hAff_W0out hAff_out
        (fun _ hx => hx) ι_out hι_out_fac
      exact h1.trans (AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι_C₀)
    have hθ_τ_eq : θ_τ = (τ₁ a).appLE U_out ⊤ h_le_a := by
      let τ_top : (⊤ : V₁.Opens).toScheme ⟶ U_out.toScheme := (⊤ : V₁.Opens).ι ≫ τ_out
