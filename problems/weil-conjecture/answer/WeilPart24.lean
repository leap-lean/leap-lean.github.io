        ((τ_sh a).appLE (U_a a) ⊤ (h_le_Ua a)).hom (ρ_a a r) =
          ((τ_sh a).appLE U_1 ⊤ (h_le_U1 a)).hom r :=
      fun r => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hcomp_τ) r
    ext x
    rw [RingHom.mem_ker]
    constructor
    · intro hx
      obtain ⟨⟨r, s_m⟩, hsec⟩ := IsLocalization.surj (Submonoid.powers (s_prod a)) x
      obtain ⟨n, hn⟩ := s_m.2
      have hsec' : x * (ρ_a a (s_prod a)) ^ n = ρ_a a r := by
        have hsec0 : x * ρ_a a (s_m : R₁) = ρ_a a r := hsec
