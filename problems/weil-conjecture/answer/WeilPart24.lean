      let w_next : V_next ⟶ V_cur := U_W.ι ≫ w_raw
      haveI : AlgebraicGeometry.Etale w_next := hEt_comp U_W.ι w_raw
      let h_next : V_next ⟶ V_sh := w_next ≫ h_cur
      haveI : AlgebraicGeometry.Etale h_next := hEt_comp w_next h_cur
      let v_next : ↥V_next := ⟨x₀_raw, hx_UW⟩
      have hv_next_cl : IsClosed ({v_next} : Set ↥V_next) := by
        have hpre : ({v_next} : Set ↥V_next) = U_W.ι.base ⁻¹' ({x₀_raw} : Set ↥W_raw) := by
          ext y
          simp only [Set.mem_singleton_iff, Set.mem_preimage]
          exact ⟨fun h => h ▸ rfl, fun h => U_W.ι.isOpenEmbedding.injective h⟩
        rw [hpre]
        exact hx₀_raw_cl.preimage U_W.ι.continuous
      have hv_next_map : h_next.base v_next = v_sh := by
        change h_cur.base (v_raw.base x_raw) = v_sh
        rw [hx_raw_map, hv_cur_map]

      
      have hPullbackSheetSplit :
          ∀ {Z_s V₁_s V₂_s : AlgebraicGeometry.Scheme.{u}}
            (g_s : Z_s ⟶ V_sh) (h₁ : V₁_s ⟶ V_sh) (w : V₂_s ⟶ V₁_s)
            (δ_s : ℕ)
            (σ₁ : Fin δ_s → (V₁_s ⟶ CategoryTheory.Limits.pullback g_s h₁)),
            (∀ j : Fin δ_s,
              σ₁ j ≫ CategoryTheory.Limits.pullback.snd g_s h₁ = 𝟙 V₁_s) →
            (∀ j : Fin δ_s, AlgebraicGeometry.IsOpenImmersion (σ₁ j)) →
            (∀ i j : Fin δ_s, i ≠ j →
              Disjoint (Set.range (σ₁ i).base) (Set.range (σ₁ j).base)) →
            (⋃ j : Fin δ_s, Set.range (σ₁ j).base) = Set.univ →
            ∃ σ₂ : Fin δ_s → (V₂_s ⟶ CategoryTheory.Limits.pullback g_s (w ≫ h₁)),
              (∀ j : Fin δ_s,
                σ₂ j ≫ CategoryTheory.Limits.pullback.snd g_s (w ≫ h₁) = 𝟙 V₂_s) ∧
              (∀ j : Fin δ_s, AlgebraicGeometry.IsOpenImmersion (σ₂ j)) ∧
              (∀ i j : Fin δ_s, i ≠ j →
                Disjoint (Set.range (σ₂ i).base) (Set.range (σ₂ j).base)) ∧
              (⋃ j : Fin δ_s, Set.range (σ₂ j).base) = Set.univ := by
        intro Z_s V₁_s V₂_s g_s h₁ w δ_s σ₁ hsec₁ hopen₁ hdisj₁ huniv₁
        let P₁ := CategoryTheory.Limits.pullback g_s h₁
        let P₂ := CategoryTheory.Limits.pullback g_s (w ≫ h₁)
        let q_w : P₂ ⟶ P₁ :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst g_s (w ≫ h₁))
            (CategoryTheory.Limits.pullback.snd g_s (w ≫ h₁) ≫ w)
            (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
        have hPb_qw : CategoryTheory.IsPullback q_w
            (CategoryTheory.Limits.pullback.snd g_s (w ≫ h₁))
            (CategoryTheory.Limits.pullback.snd g_s h₁) w :=
          CategoryTheory.IsPullback.of_right
            (by
              rw [CategoryTheory.Limits.pullback.lift_fst]
              exact CategoryTheory.IsPullback.of_hasPullback g_s (w ≫ h₁))
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            (CategoryTheory.IsPullback.of_hasPullback g_s h₁)
        let σ₂ : Fin δ_s → (V₂_s ⟶ P₂) := fun j =>
          CategoryTheory.Limits.pullback.lift
            (w ≫ σ₁ j ≫ CategoryTheory.Limits.pullback.fst g_s h₁) (𝟙 V₂_s)
            (by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc (σ₁ j),
                hsec₁ j, CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp])
        have hsec₂ : ∀ j : Fin δ_s,
            σ₂ j ≫ CategoryTheory.Limits.pullback.snd g_s (w ≫ h₁) = 𝟙 V₂_s :=
          fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hcomm₂ : ∀ j : Fin δ_s, σ₂ j ≫ q_w = w ≫ σ₁ j := by
          intro j
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc (σ₂ j), hsec₂ j, CategoryTheory.Category.id_comp,
              CategoryTheory.Category.assoc, hsec₁ j, CategoryTheory.Category.comp_id]
        have hPb_σ : ∀ j : Fin δ_s, CategoryTheory.IsPullback (σ₂ j) w q_w (σ₁ j) :=
          fun j => hSectionPullback hPb_qw (σ₁ j) (σ₂ j) (hsec₁ j) (hsec₂ j) (hcomm₂ j)
        have hopen₂ : ∀ j : Fin δ_s, AlgebraicGeometry.IsOpenImmersion (σ₂ j) := fun j => by
          haveI := hopen₁ j
          exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (hPb_σ j).flip inferInstance
        have hrng₂ : ∀ j : Fin δ_s, Set.range (σ₂ j).base = q_w.base ⁻¹' Set.range (σ₁ j).base :=
          fun j => hRangeOfIsPullback (hPb_σ j)
        refine ⟨σ₂, hsec₂, hopen₂, ?_, ?_⟩
        · intro i j hij
          rw [hrng₂ i, hrng₂ j]
          exact (hdisj₁ i j hij).preimage q_w.base
        · simp_rw [hrng₂, ← Set.preimage_iUnion, huniv₁, Set.preimage_univ]

      
      have hPb_b_vraw : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst f_b_cur v_raw ≫
            CategoryTheory.Limits.pullback.fst g_b h_cur)
          (CategoryTheory.Limits.pullback.snd f_b_cur v_raw)
          g_b (v_raw ≫ h_cur) :=
        CategoryTheory.IsPullback.paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback f_b_cur v_raw)
          (CategoryTheory.IsPullback.of_hasPullback g_b h_cur)
      let e_b_raw := hPb_b_vraw.isoPullback
      let σ_b_vraw : Fin δ_b → (V_raw ⟶ CategoryTheory.Limits.pullback g_b (v_raw ≫ h_cur)) :=
        fun j => σ_raw j ≫ e_b_raw.hom
      have hσ_b_vraw_sec : ∀ j : Fin δ_b,
          σ_b_vraw j ≫ CategoryTheory.Limits.pullback.snd g_b (v_raw ≫ h_cur) = 𝟙 V_raw := by
        intro j
        dsimp [σ_b_vraw]
        rw [CategoryTheory.Category.assoc, CategoryTheory.IsPullback.isoPullback_hom_snd]
        exact hσ_raw_sec j
      have hσ_b_vraw_open : ∀ j : Fin δ_b, AlgebraicGeometry.IsOpenImmersion (σ_b_vraw j) :=
        fun j => CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
          (σ_raw j) e_b_raw.hom (hσ_raw_open j) inferInstance
      have hσ_b_vraw_disj : ∀ i j : Fin δ_b, i ≠ j →
          Disjoint (Set.range (σ_b_vraw i).base) (Set.range (σ_b_vraw j).base) := by
        intro i j hij
        rw [Set.disjoint_left]
        rintro _ ⟨u, rfl⟩ ⟨w, hw⟩
        have heq : (σ_raw i).base u = (σ_raw j).base w := by
          have h1 := congrArg e_b_raw.inv.base hw.symm
          change ((σ_raw i ≫ e_b_raw.hom) ≫ e_b_raw.inv).base u =
            ((σ_raw j ≫ e_b_raw.hom) ≫ e_b_raw.inv).base w at h1
          simpa using h1
        exact Set.disjoint_left.mp (hσ_raw_disj i j hij) ⟨u, rfl⟩ ⟨w, heq.symm⟩
      have hσ_b_vraw_univ : (⋃ j : Fin δ_b, Set.range (σ_b_vraw j).base) = Set.univ := by
        ext z
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        have hmem : e_b_raw.inv.base z ∈ (⋃ j : Fin δ_b, Set.range (σ_raw j).base) := by
          rw [hσ_raw_univ]; trivial
        obtain ⟨j, u, hu⟩ := Set.mem_iUnion.mp hmem
        refine ⟨j, u, ?_⟩
        change e_b_raw.hom.base ((σ_raw j).base u) = z
        rw [hu]
        change (e_b_raw.inv ≫ e_b_raw.hom).base z = z
        rw [e_b_raw.inv_hom_id]; rfl

      obtain ⟨σ_b_next, hσ_b_sec', hσ_b_open', hσ_b_disj', hσ_b_univ'⟩ :=
        hPullbackSheetSplit g_b (v_raw ≫ h_cur) (U_W.ι ≫ U_raw.ι) δ_b σ_b_vraw
          hσ_b_vraw_sec hσ_b_vraw_open hσ_b_vraw_disj hσ_b_vraw_univ

      refine ⟨V_next, h_next, v_next, inferInstance, inferInstance, inferInstance,
        hv_next_cl, hv_next_map, ?_⟩
      intro b' hb'
      rcases List.mem_cons.mp hb' with rfl | hb'_in
      · have heq_h : (U_W.ι ≫ U_raw.ι) ≫ (v_raw ≫ h_cur) = h_next := by
          dsimp [h_next, w_next, w_raw]
          simp only [CategoryTheory.Category.assoc]
        exact heq_h ▸ ⟨δ_b, σ_b_next, hδ_b_pos, hσ_b_sec', hσ_b_open', hσ_b_disj', hσ_b_univ'⟩
      · obtain ⟨δ', σ', hδ'_pos, hσ'_sec, hσ'_open, hσ'_disj, hσ'_univ⟩ := hL'_sp b' hb'_in
        obtain ⟨σ'_next, h1, h2, h3, h4⟩ :=
          hPullbackSheetSplit (ι_Z b' ≫ f_mid0) h_cur w_next δ' σ'
            hσ'_sec hσ'_open hσ'_disj hσ'_univ
        exact ⟨δ', σ'_next, hδ'_pos, h1, h2, h3, h4⟩

  let L_et : List B₀_et := (@Finset.univ B₀_et _).toList
  obtain ⟨V'', h_V'', v''₀, hAff_V'', hInt_V'', hEt_hV'', hv''₀_cl, hv''₀_map, hSplit_all⟩ :=
    hSplitInd L_et
  haveI : AlgebraicGeometry.IsAffine V'' := hAff_V''
  haveI : AlgebraicGeometry.IsIntegral V'' := hInt_V''
  haveI : AlgebraicGeometry.Etale h_V'' := hEt_hV''
  have hSplit_et : ∀ b : B₀_et,
      ∃ (δ_b : ℕ)
        (σ_b : Fin δ_b → (V'' ⟶ CategoryTheory.Limits.pullback (ι_Z b ≫ f_mid0) h_V'')),
        1 ≤ δ_b ∧
        (∀ j : Fin δ_b,
          σ_b j ≫ CategoryTheory.Limits.pullback.snd (ι_Z b ≫ f_mid0) h_V'' = 𝟙 V'') ∧
        (∀ j : Fin δ_b, AlgebraicGeometry.IsOpenImmersion (σ_b j)) ∧
        (∀ i j : Fin δ_b, i ≠ j →
          Disjoint (Set.range (σ_b i).base) (Set.range (σ_b j).base)) ∧
        (⋃ j : Fin δ_b, Set.range (σ_b j).base) = Set.univ :=
    fun b => hSplit_all b (Finset.mem_toList.mpr (Finset.mem_univ b))

  let δ_b : B₀_et → ℕ := fun b => Classical.choose (hSplit_et b)
  let σ_b : ∀ b : B₀_et, Fin (δ_b b) →
      (V'' ⟶ CategoryTheory.Limits.pullback (ι_Z b ≫ f_mid0) h_V'') :=
    fun b => Classical.choose (Classical.choose_spec (hSplit_et b))
  have hσ_b_spec : ∀ b : B₀_et,
      1 ≤ δ_b b ∧
      (∀ j : Fin (δ_b b),
        σ_b b j ≫ CategoryTheory.Limits.pullback.snd (ι_Z b ≫ f_mid0) h_V'' = 𝟙 V'') ∧
      (∀ j : Fin (δ_b b), AlgebraicGeometry.IsOpenImmersion (σ_b b j)) ∧
      (∀ i j : Fin (δ_b b), i ≠ j →
        Disjoint (Set.range (σ_b b i).base) (Set.range (σ_b b j).base)) ∧
      (⋃ j : Fin (δ_b b), Set.range (σ_b b j).base) = Set.univ :=
    fun b => Classical.choose_spec (Classical.choose_spec (hSplit_et b))

  
  let h_V_sch : V'' ⟶ V₀ := h_V'' ≫ h_Vsh_0
  haveI : AlgebraicGeometry.Etale h_V_sch := hEt_comp h_V'' h_Vsh_0
  let V_mid_et : E.V_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (h_V_sch ≫ (Fgt_V.obj P_cur.V).hom)
      (hEt_comp h_V_sch (Fgt_V.obj P_cur.V).hom)
  let h_V : V_mid_et ⟶ P_cur.V :=
    CategoryTheory.MorphismProperty.Over.homMk h_V_sch rfl trivial
  let g_V_mid : V_mid_et ⟶ E.V₁ := h_V ≫ P_cur.g_V
  have hv''₀_cur : (Fgt_V.map h_V).left.base v''₀ = P_cur.v := by
    change h_V_sch.base v''₀ = P_cur.v
    change j_V₁.base (h_V'.base (j_Vsh.base (h_V''.base v''₀))) = P_cur.v
    rw [hv''₀_map, hv_sh_map, hv'₀_map, hv₁_map]
  have hv''₀_E : (Fgt_V.map g_V_mid).left.base v''₀ = E.v₁ := by
    change (Fgt_V.map P_cur.g_V).left.base ((Fgt_V.map h_V).left.base v''₀) = E.v₁
    rw [hv''₀_cur, P_cur.hv_map]

  let Y_mid := CategoryTheory.Limits.pullback f_mid0 h_V''
  let q_mid : Y_mid ⟶ Y_mid0 := CategoryTheory.Limits.pullback.fst f_mid0 h_V''
  let f_mid : Y_mid ⟶ V'' := CategoryTheory.Limits.pullback.snd f_mid0 h_V''
  have hPb_Ymid : CategoryTheory.IsPullback q_mid f_mid f_mid0 h_V'' :=
    CategoryTheory.IsPullback.of_hasPullback f_mid0 h_V''
  have hProp_fmid : AlgebraicGeometry.IsProper f_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Ymid inferInstance
  have hSm_fmid : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Ymid inferInstance
  haveI : AlgebraicGeometry.IsProper f_mid := hProp_fmid
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_mid := hSm_fmid
  haveI : AlgebraicGeometry.Etale q_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Ymid.flip inferInstance
  haveI : AlgebraicGeometry.IsAffineHom h_V'' := AlgebraicGeometry.isAffineHom_of_isAffine h_V''
  haveI : AlgebraicGeometry.IsAffineHom q_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Ymid.flip inferInstance
  haveI : AlgebraicGeometry.IsSeparated f_mid := hSep_of_proper f_mid
  have hIrred_mid : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V''),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_mid s) :=
    fun Ω _ _ s => hIrredTransfer q_mid f_mid f_mid0 h_V'' hPb_Ymid s
      (hIrred_fmid0 Ω (s ≫ h_V''))
  have hInt_Ymid : AlgebraicGeometry.IsIntegral Y_mid :=
    hEtaleBaseChangeIntegral f_mid q_mid hIrred_mid
  haveI : AlgebraicGeometry.IsIntegral Y_mid := hInt_Ymid

  let h_Y : Y_mid ⟶ Y₀ := q_mid ≫ ν ≫ h_Ysh_0
  let π_Y₁_mid : Y_mid ⟶ E.Y₁ := h_Y ≫ P_cur.π_Y₁
  have hComm_mid :
      CategoryTheory.CategoryStruct.comp h_Y P_cur.f_bar =
        CategoryTheory.CategoryStruct.comp f_mid ((Fgt_V.map h_V).left) := by
    change (q_mid ≫ ν ≫ h_Ysh_0) ≫ f₀ = f_mid ≫ (h_V'' ≫ h_Vsh_0)
    calc
      (q_mid ≫ ν ≫ h_Ysh_0) ≫ f₀
        = q_mid ≫ ν ≫ (h_Ysh_0 ≫ f₀) := by simp only [CategoryTheory.Category.assoc]
      _ = q_mid ≫ (ν ≫ f_sh) ≫ h_Vsh_0 := by
            rw [hPb_Ysh_0.w]; simp only [CategoryTheory.Category.assoc]
      _ = (q_mid ≫ f_mid0) ≫ h_Vsh_0 := by
            dsimp only [f_mid0]; simp only [CategoryTheory.Category.assoc]
      _ = f_mid ≫ (h_V'' ≫ h_Vsh_0) := by
            rw [hPb_Ymid.w]; simp only [CategoryTheory.Category.assoc]
  have hComm_Y₁_mid :
      CategoryTheory.CategoryStruct.comp π_Y₁_mid E.f_bar₁ =
        CategoryTheory.CategoryStruct.comp f_mid ((Fgt_V.map g_V_mid).left) := by
    change (h_Y ≫ P_cur.π_Y₁) ≫ E.f_bar₁ =
      f_mid ≫ (h_V_sch ≫ ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map P_cur.g_V).left)
    rw [CategoryTheory.Category.assoc, P_cur.hComm_Y₁, ← CategoryTheory.Category.assoc h_Y,
      hComm_mid]
    exact CategoryTheory.Category.assoc f_mid h_V_sch _

  
  have hComm_mid_sch : h_Y ≫ P_cur.f_bar = f_mid ≫ h_V_sch := hComm_mid
  let P_Y₀_V'' := CategoryTheory.Limits.pullback P_cur.f_bar h_V_sch
  let q_sh_V'' : P_Y₀_V'' ⟶ Y_sh :=
    hPb_Ysh_0.lift
      (CategoryTheory.Limits.pullback.fst P_cur.f_bar h_V_sch)
      (CategoryTheory.Limits.pullback.snd P_cur.f_bar h_V_sch ≫ h_V'')
      (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
  have hPb_qshV'' : CategoryTheory.IsPullback q_sh_V''
      (CategoryTheory.Limits.pullback.snd P_cur.f_bar h_V_sch)
      f_sh h_V'' :=
    CategoryTheory.IsPullback.of_right
      (by
        rw [hPb_Ysh_0.lift_fst]
        exact CategoryTheory.IsPullback.of_hasPullback P_cur.f_bar h_V_sch)
      (hPb_Ysh_0.lift_snd _ _ _)
      hPb_Ysh_0
  let φ_mid_cur : Y_mid ⟶ P_Y₀_V'' :=
    CategoryTheory.Limits.pullback.lift h_Y f_mid hComm_mid_sch
  have hcomm_φ_ν : q_mid ≫ ν = φ_mid_cur ≫ q_sh_V'' := by
    apply hPb_Ysh_0.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hPb_Ysh_0.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hPb_Ysh_0.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd_assoc]
      exact hPb_Ymid.w
  have hPb_φ_mid : CategoryTheory.IsPullback q_mid φ_mid_cur ν q_sh_V'' :=
    CategoryTheory.IsPullback.of_bot
      (by rw [CategoryTheory.Limits.pullback.lift_snd]; exact hPb_Ymid)
      hcomm_φ_ν
      hPb_qshV''
  have hFin_mid_cur : AlgebraicGeometry.IsFinite φ_mid_cur :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_φ_mid inferInstance
  have hSurj_mid_cur : AlgebraicGeometry.Surjective φ_mid_cur :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_φ_mid inferInstance
  haveI : AlgebraicGeometry.IsFinite φ_mid_cur := hFin_mid_cur
  haveI : AlgebraicGeometry.Surjective φ_mid_cur := hSurj_mid_cur

  have hFin_Surj_rel_mid :
      AlgebraicGeometry.IsFinite
        (CategoryTheory.Limits.pullback.lift π_Y₁_mid f_mid hComm_Y₁_mid) ∧
      AlgebraicGeometry.Surjective
        (CategoryTheory.Limits.pullback.lift π_Y₁_mid f_mid hComm_Y₁_mid) := by
    let g_V₀_E : V₀ ⟶ ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj E.V₁).left :=
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map P_cur.g_V).left
    let g_V''_E : V'' ⟶ ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj E.V₁).left :=
      h_V_sch ≫ g_V₀_E
    let P_E_V₀ := CategoryTheory.Limits.pullback E.f_bar₁ g_V₀_E
    let P_E_V'' := CategoryTheory.Limits.pullback E.f_bar₁ g_V''_E
    let φ_cur_E : Y₀ ⟶ P_E_V₀ :=
      CategoryTheory.Limits.pullback.lift P_cur.π_Y₁ P_cur.f_bar P_cur.hComm_Y₁
    haveI : AlgebraicGeometry.IsFinite φ_cur_E := P_cur.hFin_rel
    haveI : AlgebraicGeometry.Surjective φ_cur_E := P_cur.hSurj_rel
    let q_E_V'' : P_E_V'' ⟶ P_E_V₀ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst E.f_bar₁ g_V''_E)
        (CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V''_E ≫ h_V_sch)
        (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
    have hPb_qEV'' : CategoryTheory.IsPullback q_E_V''
        (CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V''_E)
        (CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V₀_E)
        h_V_sch :=
      CategoryTheory.IsPullback.of_right
        (by
          rw [CategoryTheory.Limits.pullback.lift_fst]
          exact CategoryTheory.IsPullback.of_hasPullback E.f_bar₁ g_V''_E)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback E.f_bar₁ g_V₀_E)
    let ψ_cur_V'' : P_Y₀_V'' ⟶ P_E_V'' :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst P_cur.f_bar h_V_sch ≫ P_cur.π_Y₁)
        (CategoryTheory.Limits.pullback.snd P_cur.f_bar h_V_sch)
        (by
          rw [CategoryTheory.Category.assoc, P_cur.hComm_Y₁, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition]
          exact CategoryTheory.Category.assoc _ _ _)
    have hcomm_ψ :
        CategoryTheory.Limits.pullback.fst P_cur.f_bar h_V_sch ≫ φ_cur_E = ψ_cur_V'' ≫ q_E_V'' := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd_assoc]
        exact CategoryTheory.Limits.pullback.condition
    have hPb_ψ_cur : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst P_cur.f_bar h_V_sch) ψ_cur_V'' φ_cur_E q_E_V'' :=
      CategoryTheory.IsPullback.of_bot
        (by
          rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
          exact CategoryTheory.IsPullback.of_hasPullback P_cur.f_bar h_V_sch)
        hcomm_ψ
        hPb_qEV''
    have hFin_ψ : AlgebraicGeometry.IsFinite ψ_cur_V'' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ψ_cur inferInstance
    have hSurj_ψ : AlgebraicGeometry.Surjective ψ_cur_V'' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ψ_cur inferInstance
    have hComm_Y₁_sch : π_Y₁_mid ≫ E.f_bar₁ = f_mid ≫ g_V''_E := hComm_Y₁_mid
    let φ_mid_E : Y_mid ⟶ P_E_V'' :=
      CategoryTheory.Limits.pullback.lift π_Y₁_mid f_mid hComm_Y₁_sch
    have hlift_eq : φ_mid_E = φ_mid_cur ≫ ψ_cur_V'' := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst_assoc]
      · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    have hFin_E : AlgebraicGeometry.IsFinite φ_mid_E :=
      hlift_eq ▸ CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsFinite)
        φ_mid_cur ψ_cur_V'' hFin_mid_cur hFin_ψ
    have hSurj_E : AlgebraicGeometry.Surjective φ_mid_E :=
      hlift_eq ▸ hSurj_comp φ_mid_cur ψ_cur_V'' hSurj_mid_cur hSurj_ψ
    exact ⟨hFin_E, hSurj_E⟩

  
  let B₁_ram := { a : Fin P_cur.m_pts // 1 ≤ c a }
  let Idx_mid := B₁_ram ⊕ (Σ b : B₀_et, Fin (δ_b b))
  let m_pts_mid : ℕ := Fintype.card Idx_mid
  let e_idx : Fin m_pts_mid ≃ Idx_mid := (Fintype.equivFin Idx_mid).symm
  have hm_pts_mid_pos : 1 ≤ m_pts_mid := by
    obtain ⟨a₀, ha₀⟩ := hc_pos
    haveI : Nonempty Idx_mid := ⟨Sum.inl ⟨a₀, ha₀⟩⟩
    exact Fintype.card_pos

  let τ_mid_ram : B₁_ram → (V'' ⟶ Y_mid) := fun a =>
    CategoryTheory.Limits.pullback.lift (h_V'' ≫ τ_ram a) (𝟙 V'')
      (by
        have hsec_a : τ_ram a ≫ f_mid0 = 𝟙 V_sh := by
          dsimp [f_mid0]
          rw [← CategoryTheory.Category.assoc, (hτ_ram_props a).1, hτ_sh_sec a.1]
        rw [CategoryTheory.Category.assoc, hsec_a, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp])
  have hτ_mid_ram_sec : ∀ a : B₁_ram, τ_mid_ram a ≫ f_mid = 𝟙 V'' :=
    fun a => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hτ_mid_ram_fst : ∀ a : B₁_ram, τ_mid_ram a ≫ q_mid = h_V'' ≫ τ_ram a :=
    fun a => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hτ_mid_ram_rng : ∀ a : B₁_ram,
      Set.range (τ_mid_ram a).base = (q_mid ≫ ν).base ⁻¹' Set.range (τ_sh a.1).base := by
    intro a
    have hsec_a : τ_ram a ≫ f_mid0 = 𝟙 V_sh := by
      dsimp [f_mid0]
      rw [← CategoryTheory.Category.assoc, (hτ_ram_props a).1, hτ_sh_sec a.1]
    have hr1 := hRangeOfIsPullback
      (hSectionPullback hPb_Ymid (τ_ram a) (τ_mid_ram a) hsec_a
        (hτ_mid_ram_sec a) (hτ_mid_ram_fst a))
    rw [hr1, ← (hτ_ram_props a).2.2]
    rfl

  let ι_Z_mid : ∀ b : B₀_et,
      CategoryTheory.Limits.pullback (ι_Z b ≫ f_mid0) h_V'' ⟶ Y_mid := fun b =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (ι_Z b ≫ f_mid0) h_V'' ≫ ι_Z b)
      (CategoryTheory.Limits.pullback.snd (ι_Z b ≫ f_mid0) h_V'')
      (by
        rw [CategoryTheory.Category.assoc]
        exact CategoryTheory.Limits.pullback.condition)
  have hPb_ιZ_mid : ∀ b : B₀_et, CategoryTheory.IsPullback
      (ι_Z_mid b) (CategoryTheory.Limits.pullback.fst (ι_Z b ≫ f_mid0) h_V'')
      q_mid (ι_Z b) := fun b =>
    (CategoryTheory.IsPullback.of_bot
      (by
        rw [CategoryTheory.Limits.pullback.lift_snd]
        exact CategoryTheory.IsPullback.of_hasPullback (ι_Z b ≫ f_mid0) h_V'')
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      hPb_Ymid).flip
  have hι_Z_mid_rng : ∀ b : B₀_et,
      Set.range (ι_Z_mid b).base = (q_mid ≫ ν).base ⁻¹' Set.range (τ_sh b.1).base := by
    intro b
    rw [hRangeOfIsPullback (hPb_ιZ_mid b), ← (hι_Z_props b).2.1]
    rfl

  let τ_mid_et : ∀ (b : B₀_et), Fin (δ_b b) → (V'' ⟶ Y_mid) :=
    fun b j => σ_b b j ≫ ι_Z_mid b
  have hτ_mid_et_sec : ∀ (b : B₀_et) (j : Fin (δ_b b)), τ_mid_et b j ≫ f_mid = 𝟙 V'' := by
    intro b j
    dsimp [τ_mid_et, ι_Z_mid, f_mid]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
    exact (hσ_b_spec b).2.1 j
  have hτ_mid_et_inj : ∀ b : B₀_et, Function.Injective (ι_Z_mid b).base := by
    intro b
    haveI : AlgebraicGeometry.IsClosedImmersion (ι_Z b) := (hι_Z_props b).1
    haveI : AlgebraicGeometry.IsClosedImmersion (ι_Z_mid b) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hPb_ιZ_mid b).flip inferInstance
    exact (ι_Z_mid b).isClosedEmbedding.injective

  let τ_raw_idx : Idx_mid → (V'' ⟶ Y_mid) := fun idx =>
    match idx with
    | Sum.inl a => τ_mid_ram a
    | Sum.inr ⟨b, j⟩ => τ_mid_et b j
  let τ_bdry_mid : Fin m_pts_mid → (V'' ⟶ Y_mid) := fun i => τ_raw_idx (e_idx i)
  have hτ_mid_sec : ∀ i : Fin m_pts_mid, τ_bdry_mid i ≫ f_mid = 𝟙 V'' := by
    intro i
    dsimp only [τ_bdry_mid]
    rcases e_idx i with a | ⟨b, j⟩
    · exact hτ_mid_ram_sec a
    · exact hτ_mid_et_sec b j
  have hτ_mid_cl : ∀ i : Fin m_pts_mid, AlgebraicGeometry.IsClosedImmersion (τ_bdry_mid i) :=
    fun i => hClosedImmOfSepSection (τ_bdry_mid i) f_mid (hτ_mid_sec i)
  have hτ_mid_disj : _root_.Pairwise fun i₁ i₂ : Fin m_pts_mid =>
      Disjoint (Set.range (τ_bdry_mid i₁).base) (Set.range (τ_bdry_mid i₂).base) := by
    intro i₁ i₂ hne
    have hne_idx : e_idx i₁ ≠ e_idx i₂ := fun h => hne (e_idx.injective h)
    dsimp [τ_bdry_mid]
    rcases he₁ : e_idx i₁ with a₁ | ⟨b₁, j₁⟩ <;> rcases he₂ : e_idx i₂ with a₂ | ⟨b₂, j₂⟩
    · rw [he₁, he₂] at hne_idx
      have ha_ne : a₁.1 ≠ a₂.1 := fun h => hne_idx (congrArg Sum.inl (Subtype.ext h))
      dsimp [τ_raw_idx]
      rw [hτ_mid_ram_rng a₁, hτ_mid_ram_rng a₂]
      exact (hτ_sh_disj ha_ne).preimage (q_mid ≫ ν).base
    · have hab_ne : a₁.1 ≠ b₂.1 := by
        intro h
        have h1 := a₁.2
        have h0 := b₂.2
        rw [h, h0] at h1
        omega
      dsimp [τ_raw_idx]
      have hsub : Set.range (τ_mid_et b₂ j₂).base ⊆ Set.range (ι_Z_mid b₂).base := by
        rintro _ ⟨v, rfl⟩
        exact ⟨(σ_b b₂ j₂).base v, rfl⟩
      refine Set.disjoint_of_subset_right hsub ?_
      rw [hτ_mid_ram_rng a₁, hι_Z_mid_rng b₂]
      exact (hτ_sh_disj hab_ne).preimage (q_mid ≫ ν).base
    · have hab_ne : b₁.1 ≠ a₂.1 := by
        intro h
        have h0 := b₁.2
        have h1 := a₂.2
        rw [← h, h0] at h1
        omega
      dsimp [τ_raw_idx]
      have hsub : Set.range (τ_mid_et b₁ j₁).base ⊆ Set.range (ι_Z_mid b₁).base := by
        rintro _ ⟨v, rfl⟩
        exact ⟨(σ_b b₁ j₁).base v, rfl⟩
      refine Set.disjoint_of_subset_left hsub ?_
      rw [hι_Z_mid_rng b₁, hτ_mid_ram_rng a₂]
      exact (hτ_sh_disj hab_ne).preimage (q_mid ≫ ν).base
    · rw [he₁, he₂] at hne_idx
      dsimp [τ_raw_idx]
      by_cases hb_eq : b₁ = b₂
      · subst hb_eq
        have hj_ne : j₁ ≠ j₂ := fun h => hne_idx (by subst h; rfl)
        rw [Set.disjoint_left]
        rintro _ ⟨u, rfl⟩ ⟨w, hw⟩
        have hσ_eq := hτ_mid_et_inj b₁ hw.symm
        exact Set.disjoint_left.mp ((hσ_b_spec b₁).2.2.2.1 j₁ j₂ hj_ne) ⟨u, rfl⟩ ⟨w, hσ_eq.symm⟩
      · have hb_val_ne : b₁.1 ≠ b₂.1 := fun h => hb_eq (Subtype.ext h)
        have hsub₁ : Set.range (τ_mid_et b₁ j₁).base ⊆ Set.range (ι_Z_mid b₁).base := by
          rintro _ ⟨u, rfl⟩
          exact ⟨(σ_b b₁ j₁).base u, rfl⟩
        have hsub₂ : Set.range (τ_mid_et b₂ j₂).base ⊆ Set.range (ι_Z_mid b₂).base := by
          rintro _ ⟨w, rfl⟩
          exact ⟨(σ_b b₂ j₂).base w, rfl⟩
        refine Set.disjoint_of_subset hsub₁ hsub₂ ?_
        rw [hι_Z_mid_rng b₁, hι_Z_mid_rng b₂]
        exact (hτ_sh_disj hb_val_ne).preimage (q_mid ≫ ν).base

  let W_open_mid : Y_mid.Opens := (TopologicalSpace.Opens.map h_Y.base).obj P_cur.W_open
  have hW_open_eq_qmid : W_open_mid = (TopologicalSpace.Opens.map q_mid.base).obj W_mid0 := by
    ext y
    change h_Y.base y ∈ P_cur.W_open ↔ ν.base (q_mid.base y) ∈ U_0
    have hU₀_Wcur : U_0 = (TopologicalSpace.Opens.map h_Ysh_0.base).obj P_cur.W_open := by
      rw [hU₀_eq]
      change (TopologicalSpace.Opens.map (j_Ysh ≫ p_Y').base).obj U_in = _
      rw [hU_in_eq]
      rfl
    rw [hU₀_Wcur]
    rfl
  have hAff_Wopen_mid : AlgebraicGeometry.IsAffineOpen W_open_mid := by
    rw [hW_open_eq_qmid]
    exact hAff_Wmid0.preimage q_mid
  have hW_compl_mid :
      (W_open_mid : Set ↥Y_mid) = (⋃ i : Fin m_pts_mid, Set.range (τ_bdry_mid i).base)ᶜ := by
    have hunion_eq :
        (⋃ i : Fin m_pts_mid, Set.range (τ_bdry_mid i).base) =
          ⋃ a : Fin P_cur.m_pts, (q_mid ≫ ν).base ⁻¹' Set.range (τ_sh a).base := by
      ext y
      simp only [Set.mem_iUnion]
      constructor
      · rintro ⟨i, hy⟩
        dsimp [τ_bdry_mid] at hy
        rcases he : e_idx i with a | ⟨b, j⟩
        · rw [he] at hy
          dsimp [τ_raw_idx] at hy
          rw [hτ_mid_ram_rng a] at hy
          exact ⟨a.1, hy⟩
        · rw [he] at hy
          obtain ⟨v, rfl⟩ := hy
          refine ⟨b.1, ?_⟩
          rw [← hι_Z_mid_rng b]
          exact ⟨(σ_b b j).base v, rfl⟩
      · rintro ⟨a, hy⟩
        rcases Nat.eq_zero_or_pos (c a) with hc0 | hc1
        · let b : B₀_et := ⟨a, hc0⟩
          have hy_Z : y ∈ Set.range (ι_Z_mid b).base := by rwa [hι_Z_mid_rng b]
          obtain ⟨z, rfl⟩ := hy_Z
          have hz_u : z ∈ ⋃ j : Fin (δ_b b), Set.range (σ_b b j).base := by
            rw [(hσ_b_spec b).2.2.2.2]; trivial
          obtain ⟨j, v, rfl⟩ := Set.mem_iUnion.mp hz_u
          refine ⟨e_idx.symm (Sum.inr ⟨b, j⟩), ?_⟩
          dsimp [τ_bdry_mid]
          rw [e_idx.apply_symm_apply]
          exact ⟨v, rfl⟩
        · let a' : B₁_ram := ⟨a, hc1⟩
          refine ⟨e_idx.symm (Sum.inl a'), ?_⟩
          dsimp [τ_bdry_mid]
          rw [e_idx.apply_symm_apply]
          dsimp [τ_raw_idx]
          rwa [hτ_mid_ram_rng a']
    rw [hunion_eq, ← Set.preimage_iUnion, ← Set.preimage_compl, ← hU_0_compl, hW_open_eq_qmid]
    rfl

  
  have hrng_Wqmid : Set.range (W_open_mid.ι ≫ q_mid).base ⊆ Set.range W_mid0.ι.base := by
    rintro _ ⟨y, rfl⟩
    have hy : y.1 ∈ (TopologicalSpace.Opens.map q_mid.base).obj W_mid0 :=
      hW_open_eq_qmid ▸ y.2
    exact ⟨⟨q_mid.base y.1, hy⟩, rfl⟩
  let j_qmid : W_open_mid.toScheme ⟶ W_mid0.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift W_mid0.ι (W_open_mid.ι ≫ q_mid) hrng_Wqmid
  have hj_qmid_fac : j_qmid ≫ W_mid0.ι = W_open_mid.ι ≫ q_mid :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac W_mid0.ι (W_open_mid.ι ≫ q_mid) hrng_Wqmid
  have hPb_jqmid : CategoryTheory.IsPullback j_qmid W_open_mid.ι W_mid0.ι q_mid := by
    apply AlgebraicGeometry.IsOpenImmersion.isPullback j_qmid W_open_mid.ι W_mid0.ι q_mid
      hj_qmid_fac.symm
    rw [W_mid0.opensRange_ι, W_open_mid.opensRange_ι]
    exact hW_open_eq_qmid.symm
  haveI : AlgebraicGeometry.Etale j_qmid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_jqmid.flip inferInstance

  have hU₀_Wcur : U_0 = (TopologicalSpace.Opens.map h_Ysh_0.base).obj P_cur.W_open := by
    rw [hU₀_eq]
    change (TopologicalSpace.Opens.map (j_Ysh ≫ p_Y').base).obj U_in = _
    rw [hU_in_eq]
    rfl
  have hrng_U0_Wcur : Set.range (U_0.ι ≫ h_Ysh_0).base ⊆ Set.range P_cur.W_open.ι.base := by
    rintro _ ⟨y, rfl⟩
    have hy : y.1 ∈ (TopologicalSpace.Opens.map h_Ysh_0.base).obj P_cur.W_open :=
      hU₀_Wcur ▸ y.2
    exact ⟨⟨h_Ysh_0.base y.1, hy⟩, rfl⟩
  let j_U0_Wcur : U_0.toScheme ⟶ P_cur.W_open.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift P_cur.W_open.ι (U_0.ι ≫ h_Ysh_0) hrng_U0_Wcur
  have hj_U0_Wcur_fac : j_U0_Wcur ≫ P_cur.W_open.ι = U_0.ι ≫ h_Ysh_0 :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac P_cur.W_open.ι (U_0.ι ≫ h_Ysh_0) hrng_U0_Wcur
  have hPb_jU0_Wcur : CategoryTheory.IsPullback j_U0_Wcur U_0.ι P_cur.W_open.ι h_Ysh_0 := by
    apply AlgebraicGeometry.IsOpenImmersion.isPullback j_U0_Wcur U_0.ι P_cur.W_open.ι h_Ysh_0
      hj_U0_Wcur_fac.symm
    rw [P_cur.W_open.opensRange_ι, U_0.opensRange_ι]
    exact hU₀_Wcur.symm
  haveI : AlgebraicGeometry.Etale j_U0_Wcur :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_jU0_Wcur.flip inferInstance

  let j_W_mid : W_open_mid.toScheme ⟶ P_cur.W_open.toScheme := j_qmid ≫ j₀ ≫ j_U0_Wcur
  haveI : AlgebraicGeometry.Etale (j₀ ≫ j_U0_Wcur) := hEt_comp j₀ j_U0_Wcur
  haveI : AlgebraicGeometry.Etale j_W_mid := hEt_comp j_qmid (j₀ ≫ j_U0_Wcur)
  have hj_W_mid_fac : j_W_mid ≫ P_cur.W_open.ι = W_open_mid.ι ≫ h_Y := by
    calc
      (j_qmid ≫ j₀ ≫ j_U0_Wcur) ≫ P_cur.W_open.ι
        = j_qmid ≫ j₀ ≫ (j_U0_Wcur ≫ P_cur.W_open.ι) := by
            simp only [CategoryTheory.Category.assoc]
      _ = j_qmid ≫ (j₀ ≫ U_0.ι) ≫ h_Ysh_0 := by
            rw [hj_U0_Wcur_fac]; simp only [CategoryTheory.Category.assoc]
      _ = (j_qmid ≫ W_mid0.ι) ≫ ν ≫ h_Ysh_0 := by
            rw [hj₀_comm]; simp only [CategoryTheory.Category.assoc]; rfl
      _ = W_open_mid.ι ≫ h_Y := by
            rw [hj_qmid_fac]; dsimp only [h_Y]; simp only [CategoryTheory.Category.assoc]

  let h_W_sch : W_open_mid.toScheme ⟶ (Fgt_Y.obj P_cur.W).left := j_W_mid ≫ P_cur.e_W.inv
  haveI : AlgebraicGeometry.Etale P_cur.e_W.inv := inferInstance
  haveI : AlgebraicGeometry.Etale h_W_sch := hEt_comp j_W_mid P_cur.e_W.inv
  haveI : AlgebraicGeometry.Etale (Fgt_Y.obj P_cur.W).hom := P_cur.W.prop
  have hh_W_Ybar : h_W_sch ≫ (Fgt_Y.obj P_cur.W).hom =
      W_open_mid.ι ≫ π_Y₁_mid ≫ E.g_Y₁ := by
    calc
      (j_W_mid ≫ P_cur.e_W.inv) ≫ (Fgt_Y.obj P_cur.W).hom
        = j_W_mid ≫ P_cur.e_W.inv ≫
            (P_cur.e_W.hom ≫ P_cur.W_open.ι ≫ P_cur.π_Y₁ ≫ E.g_Y₁) := by
            dsimp only [Fgt_Y]; rw [← P_cur.he_W_hom]; simp only [CategoryTheory.Category.assoc]
      _ = (j_W_mid ≫ P_cur.W_open.ι) ≫ P_cur.π_Y₁ ≫ E.g_Y₁ := by
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
      _ = W_open_mid.ι ≫ π_Y₁_mid ≫ E.g_Y₁ := by
            rw [hj_W_mid_fac]; dsimp only [π_Y₁_mid]; simp only [CategoryTheory.Category.assoc]
  have hEt_W_mid_hom : AlgebraicGeometry.Etale (W_open_mid.ι ≫ π_Y₁_mid ≫ E.g_Y₁) :=
    hh_W_Ybar ▸ hEt_comp h_W_sch (Fgt_Y.obj P_cur.W).hom
  let W_mid_et : E.Y_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (W_open_mid.ι ≫ π_Y₁_mid ≫ E.g_Y₁) hEt_W_mid_hom
  let e_W_mid : CategoryTheory.Iso (Fgt_Y.obj W_mid_et).left W_open_mid.toScheme :=
    CategoryTheory.Iso.refl W_open_mid.toScheme
  let h_W : W_mid_et ⟶ P_cur.W :=
    CategoryTheory.MorphismProperty.Over.homMk h_W_sch hh_W_Ybar trivial
  let u_W_mid : W_mid_et ⟶ E.W₁ := h_W ≫ P_cur.u_W

  have hh_W_comp :
      CategoryTheory.CategoryStruct.comp ((Fgt_Y.map h_W).left)
        (CategoryTheory.CategoryStruct.comp P_cur.e_W.hom P_cur.W_open.ι) =
      CategoryTheory.CategoryStruct.comp e_W_mid.hom
        (CategoryTheory.CategoryStruct.comp W_open_mid.ι h_Y) := by
    change (j_W_mid ≫ P_cur.e_W.inv) ≫ (P_cur.e_W.hom ≫ P_cur.W_open.ι) =
      𝟙 _ ≫ (W_open_mid.ι ≫ h_Y)
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
      CategoryTheory.Iso.inv_hom_id_assoc]
    exact hj_W_mid_fac

  have hu_W_mid_comp :
      CategoryTheory.CategoryStruct.comp ((Fgt_Y.map u_W_mid).left)
        (CategoryTheory.CategoryStruct.comp E.e_W₁.hom E.W₁_open.ι) =
      CategoryTheory.CategoryStruct.comp e_W_mid.hom
        (CategoryTheory.CategoryStruct.comp W_open_mid.ι π_Y₁_mid) := by
    change (h_W_sch ≫ ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map P_cur.u_W).left) ≫
        (E.e_W₁.hom ≫ E.W₁_open.ι) =
      𝟙 _ ≫ (W_open_mid.ι ≫ h_Y ≫ P_cur.π_Y₁)
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, P_cur.hu_W_comp]
    dsimp only [h_W_sch]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc,
      ← CategoryTheory.Category.assoc j_W_mid, hj_W_mid_fac, CategoryTheory.Category.assoc]

