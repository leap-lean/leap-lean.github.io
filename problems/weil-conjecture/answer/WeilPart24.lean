theorem weil_smooth_integral_rel_curve_section_generic_geom_irred (V Y : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V] [AlgebraicGeometry.IsIntegral V]
    [AlgebraicGeometry.IsIntegral Y]
    (f : Quiver.Hom Y V) [AlgebraicGeometry.SmoothOfRelativeDimension 1 f]
    (τ₀ : Quiver.Hom V Y)
    (hτ₀ : CategoryTheory.CategoryStruct.comp τ₀ f = CategoryTheory.CategoryStruct.id V)
    (U : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine U] [AlgebraicGeometry.IsIntegral U]
    (g_U : Quiver.Hom U V) [AlgebraicGeometry.Etale g_U] :
    ∃ (F : Type u) (_ : Field F)
      (s_F : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of F)) U),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.snd f g_U) s_F) :=
by
  
  have part_s1_centered : ∀ (K A₀ : Type u) [Field K] [CommRing A₀] [IsDomain A₀]
      [IsNoetherianRing A₀] [Algebra K A₀] [Algebra (Polynomial K) A₀]
      [IsScalarTower K (Polynomial K) A₀] [Algebra.FormallyEtale (Polynomial K) A₀]
      (σ : A₀ →ₐ[K] K),
      σ (algebraMap (Polynomial K) A₀ Polynomial.X) = 0 →
      ∃ Φ : A₀ →ₐ[K] PowerSeries K, Function.Injective Φ := by
    intro K A₀ _ _ _ _ _ _ _ _ σ hσX
    have hSqBij : ∀ {B : Type u} [CommRing B] [Algebra (Polynomial K) B]
        (J_small J_big : Ideal B) (hle : J_small ≤ J_big),
        J_big ^ 2 ≤ J_small →
        Function.Bijective
          (fun g : A₀ →ₐ[Polynomial K] (B ⧸ J_small) =>
            (Ideal.Quotient.liftₐ J_small (Ideal.Quotient.mkₐ (Polynomial K) J_big)
              (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr (hle hb))).comp g) := by
      intro B _ _ J_small J_big hle hsq
      let π : (B ⧸ J_small) →ₐ[Polynomial K] (B ⧸ J_big) :=
        Ideal.Quotient.liftₐ J_small (Ideal.Quotient.mkₐ (Polynomial K) J_big)
          (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr (hle hb))
      change Function.Bijective (fun g : A₀ →ₐ[Polynomial K] (B ⧸ J_small) => π.comp g)
      let K_π : Ideal (B ⧸ J_small) := RingHom.ker π.toRingHom
      have hK_le : K_π ≤ Ideal.map (Ideal.Quotient.mk J_small) J_big := by
        intro q hq
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
        change Ideal.Quotient.mk J_big b = 0 at hq
        exact Ideal.mem_map_of_mem _ (Ideal.Quotient.eq_zero_iff_mem.mp hq)
      have hK_sq : K_π ^ 2 = ⊥ := by
        apply le_bot_iff.mp
        calc
          K_π ^ 2 ≤ (Ideal.map (Ideal.Quotient.mk J_small) J_big) ^ 2 :=
            pow_le_pow_left' hK_le 2
          _ = Ideal.map (Ideal.Quotient.mk J_small) (J_big ^ 2) :=
            (Ideal.map_pow (Ideal.Quotient.mk J_small) J_big 2).symm
          _ ≤ ⊥ := by
            rw [Ideal.map_le_iff_le_comap]
            change J_big ^ 2 ≤ RingHom.ker (Ideal.Quotient.mk J_small)
            rwa [Ideal.mk_ker]
      have hπ_surj : Function.Surjective π.toRingHom := by
        intro q
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
        exact ⟨Ideal.Quotient.mk J_small b, rfl⟩
      let e_ring : ((B ⧸ J_small) ⧸ K_π) ≃+* (B ⧸ J_big) :=
        RingHom.quotientKerEquivOfSurjective hπ_surj
      let e_alg : ((B ⧸ J_small) ⧸ K_π) ≃ₐ[Polynomial K] (B ⧸ J_big) :=
        AlgEquiv.ofRingEquiv (f := e_ring) (fun p => π.commutes p)
      have hπ_eq : π = e_alg.toAlgHom.comp (Ideal.Quotient.mkₐ (Polynomial K) K_π) := by
        ext q
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
        rfl
      have hcomp_eq : (fun g : A₀ →ₐ[Polynomial K] (B ⧸ J_small) => π.comp g) =
          (fun h : A₀ →ₐ[Polynomial K] ((B ⧸ J_small) ⧸ K_π) => e_alg.toAlgHom.comp h) ∘
            (Ideal.Quotient.mkₐ (Polynomial K) K_π).comp := by
        funext g
        dsimp only [Function.comp_apply]
        rw [← AlgHom.comp_assoc, ← hπ_eq]
      rw [hcomp_eq]
      refine Function.Bijective.comp ?_
        (Algebra.FormallyEtale.comp_bijective (Polynomial K) A₀ K_π hK_sq)
      refine ⟨?_, ?_⟩
      · intro h₁ h₂ hh
        ext a
        exact e_alg.injective (AlgHom.congr_fun hh a)
      · intro h
        refine ⟨e_alg.symm.toAlgHom.comp h, ?_⟩
        ext a
        exact e_alg.apply_symm_apply (h a)
    let I : ℕ → Ideal (Polynomial K) :=
      fun m => Ideal.span {(Polynomial.X : Polynomial K) ^ (m + 1)}
    have hI_le : ∀ m : ℕ, I (m + 1) ≤ I m := by
      intro m
      dsimp [I]
      rw [Ideal.span_singleton_le_span_singleton]
      exact pow_dvd_pow Polynomial.X (Nat.le_succ (m + 1))
    have hI_sq : ∀ m : ℕ, (I m) ^ 2 ≤ I (m + 1) := by
      intro m
      dsimp [I]
      rw [sq, Ideal.span_singleton_mul_span_singleton, ← pow_add,
        Ideal.span_singleton_le_span_singleton]
      exact pow_dvd_pow Polynomial.X (by omega)
    obtain ⟨π_I, hπ_I_mk, hBij_I⟩ :
        ∃ π_I : ∀ m : ℕ, (Polynomial K ⧸ I (m + 1)) →ₐ[Polynomial K] (Polynomial K ⧸ I m),
          (∀ (m : ℕ) (p : Polynomial K),
            π_I m (Ideal.Quotient.mk (I (m + 1)) p) = Ideal.Quotient.mk (I m) p) ∧
          (∀ m : ℕ, Function.Bijective
            (fun g : A₀ →ₐ[Polynomial K] (Polynomial K ⧸ I (m + 1)) => (π_I m).comp g)) := by
      refine ⟨fun m => Ideal.Quotient.liftₐ (I (m + 1))
        (Ideal.Quotient.mkₐ (Polynomial K) (I m))
        (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr (hI_le m hb)), ?_, ?_⟩
      · intro m p; rfl
      · intro m; exact hSqBij (I (m + 1)) (I m) (hI_le m) (hI_sq m)
    obtain ⟨ϕ, hϕ0_apply, hϕ_step⟩ :
        ∃ ϕ : ∀ m : ℕ, A₀ →ₐ[Polynomial K] (Polynomial K ⧸ I m),
          (∀ a : A₀, ϕ 0 a = algebraMap K (Polynomial K ⧸ I 0) (σ a)) ∧
          (∀ m : ℕ, (π_I m).comp (ϕ (m + 1)) = ϕ m) := by
      let ψ_alg : Polynomial K →ₐ[K] A₀ := IsScalarTower.toAlgHom K (Polynomial K) A₀
      have hϕ₀_comm : ∀ p : Polynomial K,
          algebraMap K (Polynomial K ⧸ I 0) (σ (ψ_alg p)) = Ideal.Quotient.mk (I 0) p := by
        intro p
        have hlhs_alg : ((Algebra.ofId K (Polynomial K ⧸ I 0)).comp (σ.comp ψ_alg)) =
            Ideal.Quotient.mkₐ K (I 0) := by
          apply Polynomial.algHom_ext
          change algebraMap K (Polynomial K ⧸ I 0) (σ (algebraMap (Polynomial K) A₀ Polynomial.X)) =
            Ideal.Quotient.mk (I 0) Polynomial.X
          rw [hσX, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
          dsimp [I]
          rw [pow_one]
          exact Ideal.mem_span_singleton_self Polynomial.X
        exact AlgHom.congr_fun hlhs_alg p
      let ϕ₀ : A₀ →ₐ[Polynomial K] (Polynomial K ⧸ I 0) :=
        { toRingHom := (algebraMap K (Polynomial K ⧸ I 0)).comp σ.toRingHom
          commutes' := hϕ₀_comm }
      let ϕ_rec : ∀ m : ℕ, A₀ →ₐ[Polynomial K] (Polynomial K ⧸ I m) :=
        Nat.rec ϕ₀ (fun m prev => Classical.choose ((hBij_I m).2 prev))
      exact ⟨ϕ_rec, fun _ => rfl, fun m => Classical.choose_spec ((hBij_I m).2 (ϕ_rec m))⟩
    obtain ⟨coeffMod, hcoeff_mk⟩ :
        ∃ coeffMod : ∀ m k : ℕ, k ≤ m → (Polynomial K ⧸ I m) → K,
          ∀ (m k : ℕ) (hk : k ≤ m) (p : Polynomial K),
            coeffMod m k hk (Ideal.Quotient.mk (I m) p) = p.coeff k := by
      refine ⟨fun m k hk q => Quotient.liftOn' q (fun p : Polynomial K => p.coeff k) ?_,
        fun _ _ _ _ => rfl⟩
      intro p₁ p₂ hp
      have hmk : Ideal.Quotient.mk (I m) p₁ = Ideal.Quotient.mk (I m) p₂ :=
        Quotient.sound' hp
      have hmem : p₁ - p₂ ∈ I m := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hmk, sub_self]
      dsimp [I] at hmem
      rw [Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff] at hmem
      have hk0 := hmem k (by omega)
      rwa [Polynomial.coeff_sub, sub_eq_zero] at hk0
    have hcoeff_π : ∀ (m k : ℕ) (hk : k ≤ m) (q : Polynomial K ⧸ I (m + 1)),
        coeffMod m k hk (π_I m q) = coeffMod (m + 1) k (Nat.le_succ_of_le hk) q := by
      intro m k hk q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      rw [hπ_I_mk, hcoeff_mk, hcoeff_mk]
    have hcoeff_compat : ∀ (k d : ℕ) (a : A₀),
        coeffMod (k + d) k (Nat.le_add_right k d) (ϕ (k + d) a) =
          coeffMod k k le_rfl (ϕ k a) := by
      intro k d a
      induction d with
      | zero => rfl
      | succ d ih =>
        have hstep : π_I (k + d) (ϕ (k + d + 1) a) = ϕ (k + d) a :=
          AlgHom.congr_fun (hϕ_step (k + d)) a
        rw [← ih, ← hstep]
        exact (hcoeff_π (k + d) k (Nat.le_add_right k d) (ϕ (k + d + 1) a)).symm
    have hcoeff_le : ∀ (m k : ℕ) (hk : k ≤ m) (a : A₀),
        coeffMod m k hk (ϕ m a) = coeffMod k k le_rfl (ϕ k a) := by
      intro m k hk a
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
      exact hcoeff_compat k d a
    obtain ⟨Φ, hΦ_coeff⟩ :
        ∃ Φ : A₀ →ₐ[K] PowerSeries K,
          ∀ (n : ℕ) (a : A₀), PowerSeries.coeff n (Φ a) = coeffMod n n le_rfl (ϕ n a) := by
      let Φ_fun : A₀ → PowerSeries K :=
        fun a => PowerSeries.mk (fun n => coeffMod n n le_rfl (ϕ n a))
      have hΦ_zero : Φ_fun 0 = 0 := by
        ext n
        rw [PowerSeries.coeff_mk, map_zero, map_zero]
        exact hcoeff_mk n n le_rfl 0
      have hΦ_add : ∀ a b : A₀, Φ_fun (a + b) = Φ_fun a + Φ_fun b := by
        intro a b
        ext n
        rw [map_add (PowerSeries.coeff n), PowerSeries.coeff_mk, PowerSeries.coeff_mk,
          PowerSeries.coeff_mk, map_add]
        obtain ⟨pa, hpa⟩ := Ideal.Quotient.mk_surjective (ϕ n a)
        obtain ⟨pb, hpb⟩ := Ideal.Quotient.mk_surjective (ϕ n b)
        rw [← hpa, ← hpb, ← map_add, hcoeff_mk n n le_rfl, hcoeff_mk n n le_rfl,
          hcoeff_mk n n le_rfl, Polynomial.coeff_add]
      have hΦ_comm : ∀ r : K, Φ_fun (algebraMap K A₀ r) = algebraMap K (PowerSeries K) r := by
        intro r
        ext n
        rw [PowerSeries.coeff_mk, PowerSeries.algebraMap_eq, PowerSeries.coeff_C]
        have halg : algebraMap K A₀ r = algebraMap (Polynomial K) A₀ (Polynomial.C r) := by
          rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
        rw [halg, (ϕ n).commutes]
        change coeffMod n n le_rfl (Ideal.Quotient.mk (I n) (Polynomial.C r)) = _
        rw [hcoeff_mk n n le_rfl (Polynomial.C r), Polynomial.coeff_C]
      have hΦ_one : Φ_fun 1 = 1 := by
        rw [← map_one (algebraMap K A₀), hΦ_comm 1, map_one]
      have hΦ_mul : ∀ a b : A₀, Φ_fun (a * b) = Φ_fun a * Φ_fun b := by
        intro a b
        ext n
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul, map_mul]
        obtain ⟨pa, hpa⟩ := Ideal.Quotient.mk_surjective (ϕ n a)
        obtain ⟨pb, hpb⟩ := Ideal.Quotient.mk_surjective (ϕ n b)
        have hpab : ϕ n a * ϕ n b = Ideal.Quotient.mk (I n) (pa * pb) := by
          rw [← hpa, ← hpb, ← map_mul]
        rw [hpab, hcoeff_mk n n le_rfl (pa * pb), Polynomial.coeff_mul]
        refine Finset.sum_congr rfl ?_
        intro pq hpq
        have hpq_eq : pq.1 + pq.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hpq
        have hp_le : pq.1 ≤ n := by omega
        have hq_le : pq.2 ≤ n := by omega
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk,
          ← hcoeff_le n pq.1 hp_le a, ← hcoeff_le n pq.2 hq_le b,
          ← hpa, ← hpb, hcoeff_mk n pq.1 hp_le pa, hcoeff_mk n pq.2 hq_le pb]
      exact ⟨{ toFun := Φ_fun
               map_one' := hΦ_one
               map_mul' := hΦ_mul
               map_zero' := hΦ_zero
               map_add' := hΦ_add
               commutes' := hΦ_comm }, fun n a => by
        change PowerSeries.coeff n (Φ_fun a) = _
        exact PowerSeries.coeff_mk n _⟩
    refine ⟨Φ, ?_⟩
    let 𝔪 : Ideal A₀ := RingHom.ker σ.toRingHom
    have h𝔪_ne : 𝔪 ≠ ⊤ := by
      rw [Ideal.ne_top_iff_one]
      change σ 1 ≠ 0
      rw [map_one]
      exact one_ne_zero
    have hI_map : ∀ (m : ℕ) (p : Polynomial K),
        p ∈ I m → algebraMap (Polynomial K) A₀ p ∈ 𝔪 ^ (m + 1) := by
      intro m p hp
      dsimp [I] at hp
      rw [Ideal.mem_span_singleton] at hp
      obtain ⟨q, rfl⟩ := hp
      rw [map_mul, map_pow]
      exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hσX (m + 1))
    obtain ⟨α_m, hα_m_mk⟩ :
        ∃ α_m : ∀ m : ℕ, (Polynomial K ⧸ I m) →ₐ[Polynomial K] (A₀ ⧸ 𝔪 ^ (m + 1)),
          ∀ (m : ℕ) (p : Polynomial K),
            α_m m (Ideal.Quotient.mk (I m) p) =
              Ideal.Quotient.mk (𝔪 ^ (m + 1)) (algebraMap (Polynomial K) A₀ p) := by
      refine ⟨fun m => Ideal.Quotient.liftₐ (I m)
        ((Ideal.Quotient.mkₐ (Polynomial K) (𝔪 ^ (m + 1))).comp (Algebra.ofId (Polynomial K) A₀))
        (fun p hp => Ideal.Quotient.eq_zero_iff_mem.mpr (hI_map m p hp)),
        fun _ _ => rfl⟩
    let q_m : ∀ m : ℕ, A₀ →ₐ[Polynomial K] (A₀ ⧸ 𝔪 ^ (m + 1)) :=
      fun m => Ideal.Quotient.mkₐ (Polynomial K) (𝔪 ^ (m + 1))
    have hα_ϕ : ∀ m : ℕ, (α_m m).comp (ϕ m) = q_m m := by
      intro m
      induction m with
      | zero =>
        ext a
        change α_m 0 (ϕ 0 a) = Ideal.Quotient.mk (𝔪 ^ 1) a
        rw [hϕ0_apply a]
        have h1 : algebraMap K (Polynomial K ⧸ I 0) (σ a) =
            Ideal.Quotient.mk (I 0) (Polynomial.C (σ a)) := rfl
        rw [h1, hα_m_mk 0, ← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
          pow_one, eq_comm, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        change σ (a - algebraMap K A₀ (σ a)) = 0
        rw [map_sub, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      | succ m ih =>
        have h𝔪_le : 𝔪 ^ (m + 2) ≤ 𝔪 ^ (m + 1) :=
          Ideal.pow_le_pow_right (Nat.le_succ (m + 1))
        have h𝔪_sq : (𝔪 ^ (m + 1)) ^ 2 ≤ 𝔪 ^ (m + 2) := by
          rw [← pow_mul]
          exact Ideal.pow_le_pow_right (by omega)
        let ρ_m : (A₀ ⧸ 𝔪 ^ (m + 2)) →ₐ[Polynomial K] (A₀ ⧸ 𝔪 ^ (m + 1)) :=
          Ideal.Quotient.liftₐ (𝔪 ^ (m + 2)) (Ideal.Quotient.mkₐ (Polynomial K) (𝔪 ^ (m + 1)))
            (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr (h𝔪_le hb))
        have hBij_𝔪 : Function.Bijective
            (fun g : A₀ →ₐ[Polynomial K] (A₀ ⧸ 𝔪 ^ (m + 2)) => ρ_m.comp g) :=
          hSqBij (𝔪 ^ (m + 2)) (𝔪 ^ (m + 1)) h𝔪_le h𝔪_sq
        apply hBij_𝔪.1
        dsimp only
        have hρ_α : ρ_m.comp (α_m (m + 1)) = (α_m m).comp (π_I m) := by
          ext q
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
          change ρ_m (α_m (m + 1) (Ideal.Quotient.mk (I (m + 1)) p)) =
            α_m m (π_I m (Ideal.Quotient.mk (I (m + 1)) p))
          rw [hα_m_mk, hπ_I_mk, hα_m_mk]
          rfl
        have hρ_q : ρ_m.comp (q_m (m + 1)) = q_m m := by
          ext a; rfl
        rw [← AlgHom.comp_assoc, hρ_α, AlgHom.comp_assoc, hϕ_step m, ih, hρ_q]
    intro a₁ a₂ ha
    have hx : Φ (a₁ - a₂) = 0 := by rw [map_sub, ha, sub_self]
    set x := a₁ - a₂
    have hx_pow : ∀ i : ℕ, x ∈ 𝔪 ^ i := by
      intro i
      cases i with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      | succ m =>
        have hϕx_zero : ϕ m x = 0 := by
          obtain ⟨px, hpx⟩ := Ideal.Quotient.mk_surjective (ϕ m x)
          rw [← hpx, Ideal.Quotient.eq_zero_iff_mem]
          dsimp [I]
          rw [Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff]
          intro d hd
          have hd_le : d ≤ m := by omega
          have hc1 : px.coeff d = coeffMod m d hd_le (ϕ m x) := by
            rw [← hpx, hcoeff_mk m d hd_le px]
          rw [hc1, hcoeff_le m d hd_le x, ← hΦ_coeff d x, hx, map_zero]
        have hqx : q_m m x = 0 := by
          rw [← hα_ϕ m]
          change α_m m (ϕ m x) = 0
          rw [hϕx_zero, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mp hqx
    have hx_iInf : x ∈ ⨅ i : ℕ, 𝔪 ^ i := Ideal.mem_iInf.mpr hx_pow
    rw [Ideal.iInf_pow_eq_bot_of_isDomain 𝔪 h𝔪_ne, Submodule.mem_bot] at hx_iInf
    exact sub_eq_zero.mp hx_iInf

  
  have part_s1 : ∀ (K A₀ : Type u) [Field K] [CommRing A₀] [IsDomain A₀] [Algebra K A₀]
      (σ : A₀ →ₐ[K] K) (ψ₁ : Polynomial K →ₐ[K] A₀),
      RingHom.Etale ψ₁.toRingHom →
      ∃ Φ : A₀ →ₐ[K] PowerSeries K, Function.Injective Φ := by
    intro K A₀ _ _ _ _ σ ψ₁ hψ₁
    let c : K := σ (ψ₁ Polynomial.X)
    let α_hom : Polynomial K →ₐ[K] Polynomial K :=
      Polynomial.aeval (Polynomial.X - Polynomial.C c)
    let α_inv : Polynomial K →ₐ[K] Polynomial K :=
      Polynomial.aeval (Polynomial.X + Polynomial.C c)
    have hα_left : α_inv.comp α_hom = AlgHom.id K (Polynomial K) := by
      apply Polynomial.algHom_ext
      change α_inv (α_hom Polynomial.X) = Polynomial.X
      dsimp [α_hom, α_inv]
      rw [Polynomial.aeval_X, map_sub, Polynomial.aeval_X, Polynomial.aeval_C,
        ← Polynomial.algebraMap_eq]
      exact add_sub_cancel_right Polynomial.X (algebraMap K (Polynomial K) c)
    have hα_right : α_hom.comp α_inv = AlgHom.id K (Polynomial K) := by
      apply Polynomial.algHom_ext
      change α_hom (α_inv Polynomial.X) = Polynomial.X
      dsimp [α_hom, α_inv]
      rw [Polynomial.aeval_X, map_add, Polynomial.aeval_X, Polynomial.aeval_C,
        ← Polynomial.algebraMap_eq]
      exact sub_add_cancel Polynomial.X (algebraMap K (Polynomial K) c)
    have hα_bij : Function.Bijective α_hom.toRingHom := by
      refine ⟨?_, ?_⟩
      · intro p₁ p₂ hp
        have h := congrArg α_inv hp
        simpa [← AlgHom.comp_apply, hα_left] using h
      · intro p
        refine ⟨α_inv p, ?_⟩
        change (α_hom.comp α_inv) p = p
        rw [hα_right]; rfl
    obtain ⟨hAlgPA₀, hTowerKPA₀, hFormEt, hNoethA₀, hσX⟩ :
        ∃ (hAlg : Algebra (Polynomial K) A₀),
          @IsScalarTower K (Polynomial K) A₀ _ (@Algebra.toSMul _ _ _ _ hAlg) _ ∧
          @Algebra.FormallyEtale (Polynomial K) A₀ _ _ hAlg ∧
          IsNoetherianRing A₀ ∧
          σ (@algebraMap (Polynomial K) A₀ _ _ hAlg Polynomial.X) = 0 := by
      let ψ : Polynomial K →ₐ[K] A₀ := ψ₁.comp α_hom
      have hψ_et : RingHom.Etale ψ.toRingHom :=
        RingHom.Etale.stableUnderComposition α_hom.toRingHom ψ₁.toRingHom
          (RingHom.Etale.of_bijective hα_bij) hψ₁
      have hσX_ψ : σ (ψ Polynomial.X) = 0 := by
        change σ (ψ₁ (α_hom Polynomial.X)) = 0
        dsimp [α_hom, c]
        rw [Polynomial.aeval_X, map_sub, ← Polynomial.algebraMap_eq, ψ₁.commutes,
          map_sub, σ.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      let _ : Algebra (Polynomial K) A₀ := ψ.toRingHom.toAlgebra
      have hTow : IsScalarTower K (Polynomial K) A₀ :=
        IsScalarTower.of_algebraMap_eq fun r => (ψ.commutes r).symm
      have _ : IsScalarTower K (Polynomial K) A₀ := hTow
      have _ : Algebra.Etale (Polynomial K) A₀ := hψ_et
      have hFE : Algebra.FormallyEtale (Polynomial K) A₀ := inferInstance
      have _ : Algebra.FinitePresentation (Polynomial K) A₀ := inferInstance
      have hFT_PA₀ : Algebra.FiniteType (Polynomial K) A₀ := inferInstance
      have _ : Algebra.FiniteType K A₀ :=
        Algebra.FiniteType.trans (R := K) (S := Polynomial K) (A := A₀) inferInstance hFT_PA₀
      exact ⟨ψ.toRingHom.toAlgebra, hTow, hFE, Algebra.FiniteType.isNoetherianRing K A₀, hσX_ψ⟩
    exact @part_s1_centered K A₀ _ _ _ hNoethA₀ _ hAlgPA₀ hTowerKPA₀ hFormEt σ hσX

  
  have part_s2_1 : ∀ (K F A₀ L₀ : Type u) [Field K] [Field F] [Algebra K F]
      [CommRing A₀] [IsDomain A₀] [Algebra K A₀]
      [CommRing L₀] [Algebra K L₀] [Algebra A₀ L₀] [IsScalarTower K A₀ L₀]
      [IsFractionRing A₀ L₀]
      (Φ : A₀ →ₐ[K] PowerSeries K),
      Function.Injective Φ →
      IsDomain (TensorProduct K L₀ F) := by
    intro K F A₀ L₀ _ _ _ _ _ _ _ _ _ _ _ Φ hΦ
    classical
    obtain ⟨Θ_F, hΘ_tmul, hΘ_inj⟩ :
        ∃ Θ_F : TensorProduct K (PowerSeries K) F →ₐ[K] PowerSeries F,
          (∀ (g : PowerSeries K) (y : F),
            Θ_F (g ⊗ₜ[K] y) = PowerSeries.map (algebraMap K F) g * PowerSeries.C y) ∧
          Function.Injective Θ_F := by
      let ι_PS : PowerSeries K →ₐ[K] PowerSeries F :=
        { toRingHom := PowerSeries.map (algebraMap K F)
          commutes' := fun r => by
            change (PowerSeries.map (algebraMap K F)) ((algebraMap K (PowerSeries K)) r) =
              (algebraMap K (PowerSeries F)) r
            rw [PowerSeries.algebraMap_eq, PowerSeries.map_C, PowerSeries.algebraMap_apply] }
      let ι_F : F →ₐ[K] PowerSeries F :=
        { toRingHom := PowerSeries.C
          commutes' := fun r => (PowerSeries.algebraMap_apply (R := K) (A := F)).symm }
      let Θ : TensorProduct K (PowerSeries K) F →ₐ[K] PowerSeries F :=
        Algebra.TensorProduct.lift ι_PS ι_F (fun _ _ => Commute.all _ _)
      let b := Module.Free.chooseBasis K F
      let π_coord : Module.Free.ChooseBasisIndex K F →
          TensorProduct K (PowerSeries K) F →ₗ[K] PowerSeries K :=
        fun i => TensorProduct.lift
          { toFun := fun g =>
              { toFun := fun y => (b.repr y i) • g
                map_add' := fun y₁ y₂ => by rw [map_add, Finsupp.add_apply, add_smul]
                map_smul' := fun r y => by
                  rw [map_smul, Finsupp.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply] }
            map_add' := fun g₁ g₂ =>
              LinearMap.ext fun y => smul_add (b.repr y i) g₁ g₂
            map_smul' := fun r g =>
              LinearMap.ext fun y => smul_comm (b.repr y i) r g }
      have hcoeff_π : ∀ (i : Module.Free.ChooseBasisIndex K F) (n : ℕ)
          (z : TensorProduct K (PowerSeries K) F),
          PowerSeries.coeff n (π_coord i z) = b.repr (PowerSeries.coeff n (Θ z)) i := by
        intro i n
        let lhs_lin : TensorProduct K (PowerSeries K) F →ₗ[K] K :=
          (PowerSeries.coeff n).comp (π_coord i)
        let rhs_lin : TensorProduct K (PowerSeries K) F →ₗ[K] K :=
          { toFun := fun z => b.repr (PowerSeries.coeff n (Θ z)) i
            map_add' := fun z₁ z₂ => by
              simp only [map_add, Finsupp.add_apply]
            map_smul' := fun r z => by
              rw [map_smul Θ, Algebra.smul_def, PowerSeries.algebraMap_apply,
                PowerSeries.coeff_C_mul, ← Algebra.smul_def, b.repr.map_smul,
                Finsupp.smul_apply, RingHom.id_apply] }
        have hlin_eq : lhs_lin = rhs_lin := by
          apply TensorProduct.ext'
          intro g y
          change PowerSeries.coeff n ((b.repr y i) • g) =
            b.repr (PowerSeries.coeff n (PowerSeries.map (algebraMap K F) g * PowerSeries.C y)) i
          rw [PowerSeries.coeff_mul_C, PowerSeries.coeff_map, ← Algebra.smul_def,
            map_smul (PowerSeries.coeff n), b.repr.map_smul, Finsupp.smul_apply,
            smul_eq_mul, smul_eq_mul, mul_comm]
        exact fun z => LinearMap.congr_fun hlin_eq z
      refine ⟨Θ, fun _ _ => rfl, ?_⟩
      intro z₁ z₂ hz_eq
      have hz : Θ (z₁ - z₂) = 0 := by rw [map_sub, hz_eq, sub_self]
      set z := z₁ - z₂
      have hπz : ∀ i, π_coord i z = 0 := by
        intro i
        ext n
        rw [hcoeff_π i n z, hz, map_zero, map_zero, Finsupp.zero_apply, map_zero]
      obtain ⟨S₀, hS₀⟩ := TensorProduct.exists_finset z
      let J : Finset (Module.Free.ChooseBasisIndex K F) :=
        S₀.biUnion (fun p => (b.repr p.2).support)
      have hz_sum : z = ∑ i ∈ J, (π_coord i z) ⊗ₜ[K] b i := by
        have hπ_sum : ∀ i, π_coord i z = ∑ p ∈ S₀, (b.repr p.2 i) • p.1 := by
          intro i
          rw [hS₀, map_sum]
          rfl
        calc
          z = ∑ p ∈ S₀, p.1 ⊗ₜ[K] p.2 := hS₀
          _ = ∑ p ∈ S₀, p.1 ⊗ₜ[K] (∑ i ∈ J, (b.repr p.2 i) • b i) := by
            refine Finset.sum_congr rfl ?_
            intro p hp
            congr 1
            conv_lhs => rw [← b.linearCombination_repr p.2, Finsupp.linearCombination_apply]
            exact Finsupp.sum_of_support_subset (b.repr p.2)
              (Finset.subset_biUnion_of_mem (fun q => (b.repr q.2).support) hp)
              (fun i c => c • b i) (fun i _ => zero_smul K (b i))
          _ = ∑ p ∈ S₀, ∑ i ∈ J, ((b.repr p.2 i) • p.1) ⊗ₜ[K] b i := by
            refine Finset.sum_congr rfl ?_
            intro p _
            rw [TensorProduct.tmul_sum]
            refine Finset.sum_congr rfl ?_
            intro i _
            exact (TensorProduct.smul_tmul (b.repr p.2 i) p.1 (b i)).symm
          _ = ∑ i ∈ J, ∑ p ∈ S₀, ((b.repr p.2 i) • p.1) ⊗ₜ[K] b i := Finset.sum_comm
          _ = ∑ i ∈ J, (π_coord i z) ⊗ₜ[K] b i := by
            refine Finset.sum_congr rfl ?_
            intro i _
            rw [hπ_sum i, TensorProduct.sum_tmul]
      have hz0 : z = 0 := by
        rw [hz_sum]
        exact Finset.sum_eq_zero (fun i _ => by rw [hπz i, TensorProduct.zero_tmul])
      exact sub_eq_zero.mp hz0
    let map_Φ : TensorProduct K A₀ F →ₐ[K] TensorProduct K (PowerSeries K) F :=
      Algebra.TensorProduct.map Φ (AlgHom.id K F)
    have hmap_Φ_eq : map_Φ.toLinearMap = LinearMap.rTensor F Φ.toLinearMap := by
      apply TensorProduct.ext'
      intro a y; rfl
    have hmap_Φ_inj : Function.Injective map_Φ := by
      change Function.Injective map_Φ.toLinearMap
      rw [hmap_Φ_eq]
      exact Module.Flat.rTensor_preserves_injective_linearMap Φ.toLinearMap hΦ
    let Ψ_PS : TensorProduct K A₀ F →ₐ[K] PowerSeries F := Θ_F.comp map_Φ
    have hΨ_PS_inj : Function.Injective Ψ_PS := hΘ_inj.comp hmap_Φ_inj
    have hDomR : IsDomain (TensorProduct K A₀ F) :=
      Function.Injective.isDomain Ψ_PS.toRingHom hΨ_PS_inj
    have hincl_inj : Function.Injective
        (Algebra.TensorProduct.includeLeftRingHom : A₀ →+* TensorProduct K A₀ F) := by
      intro a₁ a₂ ha
      have hps := congrArg Ψ_PS ha
      apply hΦ
      ext n
      have hn := congrArg (PowerSeries.coeff n) hps
      change PowerSeries.coeff n (Θ_F (Φ a₁ ⊗ₜ[K] (1 : F))) =
        PowerSeries.coeff n (Θ_F (Φ a₂ ⊗ₜ[K] (1 : F))) at hn
      rw [hΘ_tmul, hΘ_tmul, map_one, mul_one, mul_one,
        PowerSeries.coeff_map, PowerSeries.coeff_map] at hn
      exact RingHom.injective (algebraMap K F) hn
    obtain ⟨M, hFieldM, hAlgRM, hFracRM⟩ :
        ∃ (M : Type u) (hFM : Field M) (hARM : Algebra (TensorProduct K A₀ F) M),
          @IsFractionRing (TensorProduct K A₀ F) _ M hFM.toCommSemiring hARM := by
      have _ : IsDomain (TensorProduct K A₀ F) := hDomR
      exact ⟨FractionRing (TensorProduct K A₀ F), inferInstance, inferInstance, inferInstance⟩
    let _ : Field M := hFieldM
    let _ : Algebra (TensorProduct K A₀ F) M := hAlgRM
    have _ : IsFractionRing (TensorProduct K A₀ F) M := hFracRM
    let _ : Algebra K M := RingHom.toAlgebra
      ((algebraMap (TensorProduct K A₀ F) M).comp (algebraMap K (TensorProduct K A₀ F)))
    have _ : IsScalarTower K (TensorProduct K A₀ F) M := IsScalarTower.of_algebraMap_eq' rfl
    let j : A₀ →+* M :=
      (algebraMap (TensorProduct K A₀ F) M).comp Algebra.TensorProduct.includeLeftRingHom
    have hj_inj : Function.Injective j :=
      (IsFractionRing.injective (TensorProduct K A₀ F) M).comp hincl_inj
    have hj_units : ∀ y : nonZeroDivisors A₀, IsUnit (j y.1) := by
      intro y
      have hy0 : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hjy0 : j y.1 ≠ 0 := fun h0 => hy0 (hj_inj (h0.trans (map_zero j).symm))
      exact IsUnit.mk0 (j y.1) hjy0
    let j_lift : L₀ →+* M := IsLocalization.lift (M := nonZeroDivisors A₀) hj_units
    let j_alg : L₀ →ₐ[K] M :=
      { toRingHom := j_lift
        commutes' := fun r => by
          rw [IsScalarTower.algebraMap_apply K A₀ L₀ r]
          change j_lift (algebraMap A₀ L₀ (algebraMap K A₀ r)) = algebraMap K M r
          rw [IsLocalization.lift_eq (M := nonZeroDivisors A₀) hj_units (algebraMap K A₀ r)]
          rfl }
    let r_alg : F →ₐ[K] M :=
      (IsScalarTower.toAlgHom K (TensorProduct K A₀ F) M).comp Algebra.TensorProduct.includeRight
    let Ψ : TensorProduct K L₀ F →ₐ[K] M :=
      Algebra.TensorProduct.lift j_alg r_alg (fun _ _ => Commute.all _ _)
    let μ : TensorProduct K A₀ F →ₐ[K] TensorProduct K L₀ F :=
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom K A₀ L₀) (AlgHom.id K F)
    have hΨ_μ : ∀ w : TensorProduct K A₀ F,
        Ψ (μ w) = algebraMap (TensorProduct K A₀ F) M w := by
      have hlin_eq : (Ψ.comp μ).toLinearMap =
          (IsScalarTower.toAlgHom K (TensorProduct K A₀ F) M).toLinearMap := by
        apply TensorProduct.ext'
        intro a y
        change j_lift (algebraMap A₀ L₀ a) * algebraMap (TensorProduct K A₀ F) M ((1 : A₀) ⊗ₜ[K] y) =
          algebraMap (TensorProduct K A₀ F) M (a ⊗ₜ[K] y)
        rw [IsLocalization.lift_eq (M := nonZeroDivisors A₀) hj_units a]
        change algebraMap (TensorProduct K A₀ F) M (a ⊗ₜ[K] (1 : F)) *
            algebraMap (TensorProduct K A₀ F) M ((1 : A₀) ⊗ₜ[K] y) = _
        rw [← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      exact fun w => LinearMap.congr_fun hlin_eq w
    have hclear : ∀ z : TensorProduct K L₀ F,
        ∃ (s : nonZeroDivisors A₀) (w : TensorProduct K A₀ F),
          ((algebraMap A₀ L₀ s.1) ⊗ₜ[K] (1 : F)) * z = μ w := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨1, 0, by simp⟩
      | tmul l y =>
        obtain ⟨⟨a, s⟩, hl⟩ := IsLocalization.surj (nonZeroDivisors A₀) l
        refine ⟨s, a ⊗ₜ[K] y, ?_⟩
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_comm _ l, hl, one_mul]
        rfl
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨s₁, w₁, hw₁⟩ := ih₁
        obtain ⟨s₂, w₂, hw₂⟩ := ih₂
        refine ⟨s₁ * s₂, (s₂.1 ⊗ₜ[K] (1 : F)) * w₁ + (s₁.1 ⊗ₜ[K] (1 : F)) * w₂, ?_⟩
        rw [mul_add, map_add, map_mul, map_mul]
        have hs12 : ((algebraMap A₀ L₀ (s₁ * s₂).1) ⊗ₜ[K] (1 : F)) =
            ((algebraMap A₀ L₀ s₂.1) ⊗ₜ[K] (1 : F)) *
              ((algebraMap A₀ L₀ s₁.1) ⊗ₜ[K] (1 : F)) := by
          rw [Submonoid.coe_mul, map_mul, mul_comm (algebraMap A₀ L₀ s₁.1),
            Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        have hs21 : ((algebraMap A₀ L₀ (s₁ * s₂).1) ⊗ₜ[K] (1 : F)) =
            ((algebraMap A₀ L₀ s₁.1) ⊗ₜ[K] (1 : F)) *
              ((algebraMap A₀ L₀ s₂.1) ⊗ₜ[K] (1 : F)) := by
          rw [Submonoid.coe_mul, map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        congr 1
        · rw [hs12, mul_assoc, hw₁]; rfl
        · rw [hs21, mul_assoc, hw₂]; rfl
    have hΨ_inj : Function.Injective Ψ := by
      intro z₁ z₂ hz_eq
      have hz : Ψ (z₁ - z₂) = 0 := by rw [map_sub, hz_eq, sub_self]
      set z := z₁ - z₂
      obtain ⟨s, w, hw⟩ := hclear z
      have hmw : algebraMap (TensorProduct K A₀ F) M w = 0 := by
        rw [← hΨ_μ w, ← hw, map_mul, hz, mul_zero]
      have hw0 : w = 0 :=
        (IsFractionRing.injective (TensorProduct K A₀ F) M) (hmw.trans (map_zero _).symm)
      rw [hw0, map_zero] at hw
      obtain ⟨u, hu⟩ := IsLocalization.map_units L₀ s
      have hz0 : z = 0 := by
        calc
          z = (1 : TensorProduct K L₀ F) * z := (one_mul z).symm
          _ = (((↑u⁻¹ * ↑u : L₀)) ⊗ₜ[K] (1 : F)) * z := by
            rw [Units.inv_mul]; rfl
          _ = (((↑u⁻¹ : L₀) ⊗ₜ[K] (1 : F)) * ((↑u : L₀) ⊗ₜ[K] (1 : F))) * z := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
          _ = ((↑u⁻¹ : L₀) ⊗ₜ[K] (1 : F)) *
                (((algebraMap A₀ L₀ s.1) ⊗ₜ[K] (1 : F)) * z) := by
            rw [mul_assoc, hu]
          _ = 0 := by rw [hw, mul_zero]
      exact sub_eq_zero.mp hz0
    exact Function.Injective.isDomain Ψ.toRingHom hΨ_inj

  
  have part_s2_2 : ∀ (B K S : Type u) [CommRing B] [IsDomain B]
      [Field K] [Algebra B K] [IsFractionRing B K]
      [CommRing S] [IsDomain S] [Algebra B S],
      Function.Injective (algebraMap B S) →
      IsDomain (TensorProduct B S K) := by
    intro B K S _ _ _ _ _ _ _ _ hInj
    obtain ⟨M_S, hFieldMS, hAlgSMS, hFracSMS⟩ :
        ∃ (M_S : Type u) (hFMS : Field M_S) (hASMS : Algebra S M_S),
          @IsFractionRing S _ M_S hFMS.toCommSemiring hASMS :=
      ⟨FractionRing S, inferInstance, inferInstance, inferInstance⟩
    let _ : Field M_S := hFieldMS
    let _ : Algebra S M_S := hAlgSMS
    have _ : IsFractionRing S M_S := hFracSMS
    let _ : Algebra B M_S := RingHom.toAlgebra ((algebraMap S M_S).comp (algebraMap B S))
    have _ : IsScalarTower B S M_S := IsScalarTower.of_algebraMap_eq' rfl
    let j_B : B →+* M_S := (algebraMap S M_S).comp (algebraMap B S)
    have hj_inj : Function.Injective j_B := (IsFractionRing.injective S M_S).comp hInj
    have hj_units : ∀ y : nonZeroDivisors B, IsUnit (j_B y.1) := by
      intro y
      have hy0 : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hjy0 : j_B y.1 ≠ 0 := fun h0 => hy0 (hj_inj (h0.trans (map_zero j_B).symm))
      exact IsUnit.mk0 (j_B y.1) hjy0
    let j_lift : K →+* M_S := IsLocalization.lift (M := nonZeroDivisors B) hj_units
    let j_alg : K →ₐ[B] M_S :=
      { toRingHom := j_lift
        commutes' := fun b =>
          IsLocalization.lift_eq (M := nonZeroDivisors B) hj_units b }
    let Ω : TensorProduct B S K →ₐ[B] M_S :=
      Algebra.TensorProduct.lift (IsScalarTower.toAlgHom B S M_S) j_alg
        (fun _ _ => Commute.all _ _)
    have hclear : ∀ z : TensorProduct B S K,
        ∃ (b : nonZeroDivisors B) (x : S),
          ((1 : S) ⊗ₜ[B] (algebraMap B K b.1)) * z = x ⊗ₜ[B] (1 : K) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨1, 0, by simp⟩
      | tmul s k =>
        obtain ⟨⟨a, b⟩, hk⟩ := IsLocalization.surj (nonZeroDivisors B) k
        refine ⟨b, a • s, ?_⟩
        dsimp only at hk
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm _ k, hk,
          Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨b₁, x₁, hx₁⟩ := ih₁
        obtain ⟨b₂, x₂, hx₂⟩ := ih₂
        refine ⟨b₁ * b₂, b₂.1 • x₁ + b₁.1 • x₂, ?_⟩
        rw [mul_add, TensorProduct.add_tmul]
        have hb12 : ((1 : S) ⊗ₜ[B] algebraMap B K (b₁ * b₂).1) =
            ((1 : S) ⊗ₜ[B] algebraMap B K b₂.1) * ((1 : S) ⊗ₜ[B] algebraMap B K b₁.1) := by
          rw [Submonoid.coe_mul, map_mul, mul_comm (algebraMap B K b₁.1),
            Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        have hb21 : ((1 : S) ⊗ₜ[B] algebraMap B K (b₁ * b₂).1) =
            ((1 : S) ⊗ₜ[B] algebraMap B K b₁.1) * ((1 : S) ⊗ₜ[B] algebraMap B K b₂.1) := by
          rw [Submonoid.coe_mul, map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        congr 1
        · rw [hb12, mul_assoc, hx₁, Algebra.TensorProduct.tmul_mul_tmul,
            one_mul, mul_one, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
        · rw [hb21, mul_assoc, hx₂, Algebra.TensorProduct.tmul_mul_tmul,
            one_mul, mul_one, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
    have hΩ_inj : Function.Injective Ω := by
      intro z₁ z₂ hz_eq
      have hz : Ω (z₁ - z₂) = 0 := by rw [map_sub, hz_eq, sub_self]
      set z := z₁ - z₂
      obtain ⟨b, x, hx⟩ := hclear z
      have hmx : algebraMap S M_S x = 0 := by
        have hΩx : Ω (x ⊗ₜ[B] (1 : K)) = algebraMap S M_S x := by
          change algebraMap S M_S x * j_alg 1 = algebraMap S M_S x
          rw [map_one, mul_one]
        rw [← hΩx, ← hx, map_mul, hz, mul_zero]
      have hx0 : x = 0 := (IsFractionRing.injective S M_S) (hmx.trans (map_zero _).symm)
      rw [hx0, TensorProduct.zero_tmul] at hx
      obtain ⟨u, hu⟩ := IsLocalization.map_units K b
      have hz0 : z = 0 := by
        calc
          z = (1 : TensorProduct B S K) * z := (one_mul z).symm
          _ = ((1 : S) ⊗ₜ[B] (↑u⁻¹ * ↑u : K)) * z := by
            rw [Units.inv_mul]; rfl
          _ = (((1 : S) ⊗ₜ[B] (↑u⁻¹ : K)) * ((1 : S) ⊗ₜ[B] (↑u : K))) * z := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
          _ = ((1 : S) ⊗ₜ[B] (↑u⁻¹ : K)) * (((1 : S) ⊗ₜ[B] algebraMap B K b.1) * z) := by
            rw [mul_assoc, hu]
          _ = 0 := by rw [hx, mul_zero]
      exact sub_eq_zero.mp hz0
    exact Function.Injective.isDomain Ω.toRingHom hΩ_inj

  
  have fromSpec_comp_spec_eq : ∀ {R₀ : CommRingCat.{u}} {Z : AlgebraicGeometry.Scheme.{u}}
      (h : Quiver.Hom Z (AlgebraicGeometry.Spec R₀))
      {W : Z.Opens} (hW : AlgebraicGeometry.IsAffineOpen W),
      hW.fromSpec ≫ h =
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv ≫ h.appTop ≫
            Z.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op) := by
    intro R₀ Z h W hW
    have h_id_R₀ : (AlgebraicGeometry.Spec R₀).toSpecΓ ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv =
        𝟙 (AlgebraicGeometry.Spec R₀) := by
      calc
        (AlgebraicGeometry.Spec R₀).toSpecΓ ≫
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv
          = (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).hom ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv) ≫
              (AlgebraicGeometry.Spec R₀).toSpecΓ ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv := by
            rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Iso.inv_hom_id,
              AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
        _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).hom ≫
              (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv ≫
                (AlgebraicGeometry.Spec R₀).toSpecΓ) ≫
              AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv := by
            simp only [CategoryTheory.Category.assoc]
        _ = 𝟙 (AlgebraicGeometry.Spec R₀) := by
            rw [AlgebraicGeometry.SpecMap_ΓSpecIso_inv_toSpecΓ,
              CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    calc
      hW.fromSpec ≫ h
        = hW.fromSpec ≫ (h ≫ (AlgebraicGeometry.Spec R₀).toSpecΓ) ≫
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv := by
          rw [CategoryTheory.Category.assoc h, h_id_R₀, CategoryTheory.Category.comp_id]
      _ = (hW.fromSpec ≫ Z.toSpecΓ) ≫ AlgebraicGeometry.Spec.map h.appTop ≫
            AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv := by
          rw [AlgebraicGeometry.Scheme.toSpecΓ_naturality h,
            CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            ← CategoryTheory.Category.assoc hW.fromSpec]
      _ = AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso R₀).inv ≫ h.appTop ≫
              Z.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op) := by
          rw [hW.fromSpec_toSpecΓ, ← AlgebraicGeometry.Spec.map_comp,
            ← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]

  
  have part_s3 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E]
      (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
      (h : Quiver.Hom Z (AlgebraicGeometry.Spec (CommRingCat.of R))),
      (∀ (W : Z.Opens),
        AlgebraicGeometry.IsAffineOpen W →
        Nonempty ↥W.toScheme →
        ∀ [Algebra R ↑(Z.presheaf.obj (Opposite.op W))],
          algebraMap R ↑(Z.presheaf.obj (Opposite.op W)) =
            CommRingCat.Hom.hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ h.appTop ≫
                Z.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op) →
          IsDomain (TensorProduct R ↑(Z.presheaf.obj (Opposite.op W)) E)) →
      AlgebraicGeometry.IsIntegral
        (CategoryTheory.Limits.pullback h
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R E)))) := by
    intro R E _ _ _ Z _ h hDom
    let g := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R E))
    let X := CategoryTheory.Limits.pullback h g
    let q := CategoryTheory.Limits.pullback.fst h g
    let r_X := CategoryTheory.Limits.pullback.snd h g
    have hChartInt_aux : ∀ (W : Z.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
        (hNe : Nonempty ↥W.toScheme)
        [Algebra R ↑(Z.presheaf.obj (Opposite.op W))],
        algebraMap R ↑(Z.presheaf.obj (Opposite.op W)) =
          CommRingCat.Hom.hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ h.appTop ≫
              Z.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op) →
        AlgebraicGeometry.IsIntegral (q ⁻¹ᵁ W).toScheme := by
      intro W hW hNe _ halg
      have _ : IsDomain (TensorProduct R ↑(Z.presheaf.obj (Opposite.op W)) E) :=
        hDom W hW hNe halg
      have _ : AlgebraicGeometry.IsIntegral
          (AlgebraicGeometry.Spec
            (CommRingCat.of (TensorProduct R ↑(Z.presheaf.obj (Opposite.op W)) E))) :=
        AlgebraicGeometry.instIsIntegralSpecOfIsDomainCarrier
      have halg_cat : CommRingCat.ofHom (algebraMap R ↑(Z.presheaf.obj (Opposite.op W))) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ h.appTop ≫
            Z.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op := by
        apply CommRingCat.hom_ext
        exact halg
      have hfrom_eq : hW.fromSpec ≫ h =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R ↑(Z.presheaf.obj (Opposite.op W)))) := by
        rw [halg_cat]
        exact fromSpec_comp_spec_eq h hW
      have hPb1 : CategoryTheory.IsPullback (q ∣_ W) ((q ⁻¹ᵁ W).ι ≫ r_X) (W.ι ≫ h) g :=
        (AlgebraicGeometry.isPullback_morphismRestrict q W).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback h g)
      have hPb_iso : CategoryTheory.IsPullback hW.isoSpec.hom (W.ι ≫ h)
          (hW.fromSpec ≫ h) (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R))) := by
        refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
        rw [CategoryTheory.Category.comp_id, ← hW.isoSpec_inv_ι]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
      have hPb2 : CategoryTheory.IsPullback ((q ∣_ W) ≫ hW.isoSpec.hom) ((q ⁻¹ᵁ W).ι ≫ r_X)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R ↑(Z.presheaf.obj (Opposite.op W))))) g := by
        have hp := hPb1.paste_horiz hPb_iso
        rwa [CategoryTheory.Category.comp_id, hfrom_eq] at hp
      let e_W : (q ⁻¹ᵁ W).toScheme ≅
          AlgebraicGeometry.Spec
            (CommRingCat.of (TensorProduct R ↑(Z.presheaf.obj (Opposite.op W)) E)) :=
        hPb2.isoPullback ≪≫
          AlgebraicGeometry.pullbackSpecIso R ↑(Z.presheaf.obj (Opposite.op W)) E
      have hNe_rhs : Nonempty
          ↥(AlgebraicGeometry.Spec
            (CommRingCat.of (TensorProduct R ↑(Z.presheaf.obj (Opposite.op W)) E))) :=
        (AlgebraicGeometry.irreducibleSpace_of_isIntegral _).toNonempty
      have _ : Nonempty ↥(q ⁻¹ᵁ W).toScheme :=
        ⟨e_W.inv.base (Classical.choice hNe_rhs)⟩
      exact AlgebraicGeometry.isIntegral_of_isOpenImmersion e_W.hom
    have hChartInt : ∀ (W : Z.Opens),
        AlgebraicGeometry.IsAffineOpen W →
        Nonempty ↥W.toScheme →
        AlgebraicGeometry.IsIntegral (q ⁻¹ᵁ W).toScheme := by
      intro W hW hNe
      let φ_W_hom := CommRingCat.Hom.hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ h.appTop ≫
          Z.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op)
      exact @hChartInt_aux W hW hNe φ_W_hom.toAlgebra rfl
    have hIrredZ : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
    have hNe_X : Nonempty ↥X := by
      let z₀ : ↥Z := Classical.choice hIrredZ.toNonempty
      obtain ⟨W₀, hW₀, hz₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₀) (U := ⊤) trivial
      have hInt₀ := hChartInt W₀ hW₀ ⟨⟨z₀, hz₀⟩⟩
      have hNe_qW₀ : Nonempty ↥(q ⁻¹ᵁ W₀).toScheme :=
        (@AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hInt₀).toNonempty
      exact ⟨(q ⁻¹ᵁ W₀).ι.base (Classical.choice hNe_qW₀)⟩
    have hPre_X : PreirreducibleSpace ↥X := by
      refine ⟨?_⟩
      intro O₁ O₂ hO₁ hO₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩
      obtain ⟨W₁, hW₁, hx₁_W₁, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q.base x₁) (U := ⊤) trivial
      obtain ⟨W₂, hW₂, hx₂_W₂, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q.base x₂) (U := ⊤) trivial
      obtain ⟨z₁₂, _, hz₁₂_1, hz₁₂_2⟩ :=
        hIrredZ.isIrreducible_univ.isPreirreducible (W₁ : Set ↥Z) (W₂ : Set ↥Z)
          W₁.isOpen W₂.isOpen
          ⟨q.base x₁, trivial, hx₁_W₁⟩ ⟨q.base x₂, trivial, hx₂_W₂⟩
      have hz₁₂_inf : z₁₂ ∈ (W₁ ⊓ W₂ : Z.Opens) := ⟨hz₁₂_1, hz₁₂_2⟩
      obtain ⟨W₃, hW₃, hz₁₂_W₃, hW₃_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hz₁₂_inf
      let U₁ : Set ↥X := ((q ⁻¹ᵁ W₁ : X.Opens) : Set ↥X)
      let U₂ : Set ↥X := ((q ⁻¹ᵁ W₂ : X.Opens) : Set ↥X)
      let U₃ : Set ↥X := ((q ⁻¹ᵁ W₃ : X.Opens) : Set ↥X)
      have hInt₁ := hChartInt W₁ hW₁ ⟨⟨q.base x₁, hx₁_W₁⟩⟩
      have hInt₂ := hChartInt W₂ hW₂ ⟨⟨q.base x₂, hx₂_W₂⟩⟩
      have hInt₃ := hChartInt W₃ hW₃ ⟨⟨z₁₂, hz₁₂_W₃⟩⟩
      have hIrred_U₁ : IsIrreducible U₁ :=
        isIrreducible_iff_irreducibleSpace.mpr
          (@AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hInt₁)
      have hIrred_U₂ : IsIrreducible U₂ :=
        isIrreducible_iff_irreducibleSpace.mpr
          (@AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hInt₂)
      have hNe_U₃ : Nonempty ↥(q ⁻¹ᵁ W₃).toScheme :=
        (@AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hInt₃).toNonempty
      obtain ⟨u₃, hu₃⟩ : U₃.Nonempty := by
        let pt₃ := Classical.choice hNe_U₃
        exact ⟨pt₃.1, pt₃.2⟩
      have hU₃_sub₁ : U₃ ⊆ U₁ := fun x hx => (hW₃_sub hx).1
      have hU₃_sub₂ : U₃ ⊆ U₂ := fun x hx => (hW₃_sub hx).2
      obtain ⟨y₁, _, hy₁_O₁, hy₁_U₃⟩ :=
        hIrred_U₁.isPreirreducible O₁ U₃ hO₁ (q ⁻¹ᵁ W₃).isOpen
          ⟨x₁, hx₁_W₁, hx₁⟩ ⟨u₃, hU₃_sub₁ hu₃, hu₃⟩
      obtain ⟨y₂, _, ⟨hy₂_O₁, _⟩, hy₂_O₂⟩ :=
        hIrred_U₂.isPreirreducible (O₁ ∩ U₃) O₂ (hO₁.inter (q ⁻¹ᵁ W₃).isOpen) hO₂
          ⟨y₁, hU₃_sub₂ hy₁_U₃, hy₁_O₁, hy₁_U₃⟩ ⟨x₂, hx₂_W₂, hx₂⟩
      exact ⟨y₂, trivial, hy₂_O₁, hy₂_O₂⟩
    have _ : IrreducibleSpace ↥X := { toPreirreducibleSpace := hPre_X, toNonempty := hNe_X }
    have hStalkRed : ∀ x : ↥X, IsReduced ↑(X.presheaf.stalk x) := by
      intro x
      obtain ⟨W_x, hW_x, hx_W, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q.base x) (U := ⊤) trivial
      have hInt_Wx : AlgebraicGeometry.IsIntegral (q ⁻¹ᵁ W_x).toScheme :=
        hChartInt W_x hW_x ⟨⟨q.base x, hx_W⟩⟩
      have hRed_Wx : AlgebraicGeometry.IsReduced (q ⁻¹ᵁ W_x).toScheme :=
        ((AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced _).mp hInt_Wx).2
      have _ : IsReduced ↑((q ⁻¹ᵁ W_x).toScheme.presheaf.stalk ⟨x, hx_W⟩) :=
        @AlgebraicGeometry.isReduced_stalk_of_isReduced (q ⁻¹ᵁ W_x).toScheme hRed_Wx ⟨x, hx_W⟩
      let e_st := (q ⁻¹ᵁ W_x).stalkIso ⟨x, hx_W⟩
      refine ⟨fun r hr => ?_⟩
      obtain ⟨n, hn⟩ := hr
      have hr_inv : e_st.inv.hom r = 0 :=
        IsNilpotent.eq_zero ⟨n, by rw [← map_pow, hn, map_zero]⟩
      have hr_hom := congrArg e_st.hom.hom hr_inv
      change (e_st.inv ≫ e_st.hom).hom r = e_st.hom.hom 0 at hr_hom
      rwa [e_st.inv_hom_id, map_zero] at hr_hom
    have _ : AlgebraicGeometry.IsReduced X :=
      @AlgebraicGeometry.isReduced_of_isReduced_stalk X hStalkRed
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X

  
  have hbot_prime : ∀ (D : Type u) [CommRing D] [IsDomain D], (⊥ : Ideal D).IsPrime :=
    fun _ _ _ => ⟨bot_ne_top, fun hxy => eq_zero_or_eq_zero_of_mul_eq_zero hxy⟩
  have hNe_Vtop : Nonempty ↥(⊤ : V.Opens).toScheme :=
    ⟨⟨Classical.choice (AlgebraicGeometry.irreducibleSpace_of_isIntegral V).toNonempty, trivial⟩⟩
  have hNe_Utop : Nonempty ↥(⊤ : U.Opens).toScheme :=
    ⟨⟨Classical.choice (AlgebraicGeometry.irreducibleSpace_of_isIntegral U).toNonempty, trivial⟩⟩
  obtain ⟨B, hRingB, hDomB, ⟨e_V⟩⟩ :
      ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B),
        Nonempty (V ≅ AlgebraicGeometry.Spec (CommRingCat.of B)) :=
    ⟨↑(V.presheaf.obj (Opposite.op ⊤)), inferInstance,
      @AlgebraicGeometry.IsIntegral.component_integral V _ ⊤ hNe_Vtop, ⟨V.isoSpec⟩⟩
  let _ : CommRing B := hRingB
  let _ : IsDomain B := hDomB
  obtain ⟨K, hFieldK, hAlgBK, hFracBK⟩ :
      ∃ (K : Type u) (hFK : Field K) (hABK : Algebra B K),
        @IsFractionRing B _ K hFK.toCommSemiring hABK :=
    ⟨FractionRing B, inferInstance, inferInstance, inferInstance⟩
  let _ : Field K := hFieldK
  let _ : Algebra B K := hAlgBK
  have _ : IsFractionRing B K := hFracBK
  obtain ⟨A_U, hRingAU, hDomAU, ⟨e_U⟩⟩ :
      ∃ (A_U : Type u) (_ : CommRing A_U) (_ : IsDomain A_U),
        Nonempty (U ≅ AlgebraicGeometry.Spec (CommRingCat.of A_U)) :=
    ⟨↑(U.presheaf.obj (Opposite.op ⊤)), inferInstance,
      @AlgebraicGeometry.IsIntegral.component_integral U _ ⊤ hNe_Utop, ⟨U.isoSpec⟩⟩
  let _ : CommRing A_U := hRingAU
  let _ : IsDomain A_U := hDomAU
  obtain ⟨F, hFieldF, hAlgAUF, hFracAUF⟩ :
      ∃ (F : Type u) (hFF : Field F) (hAAUF : Algebra A_U F),
        @IsFractionRing A_U _ F hFF.toCommSemiring hAAUF :=
    ⟨FractionRing A_U, inferInstance, inferInstance, inferInstance⟩
  let _ : Field F := hFieldF
  let _ : Algebra A_U F := hAlgAUF
  have _ : IsFractionRing A_U F := hFracAUF

  
  let f_B : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) := f ≫ e_V.hom
  let τ_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Y := e_V.inv ≫ τ₀
  have hτ_B : τ_B ≫ f_B = 𝟙 _ := by
    dsimp [τ_B, f_B]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc τ₀, hτ₀,
      CategoryTheory.Category.id_comp, e_V.inv_hom_id]
  let g_BK := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B K))
  let C_K := CategoryTheory.Limits.pullback f_B g_BK
  let q_K := CategoryTheory.Limits.pullback.fst f_B g_BK
  let p_K := CategoryTheory.Limits.pullback.snd f_B g_BK
  have hDom_Y : ∀ (W : Y.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥W.toScheme →
      ∀ [Algebra B ↑(Y.presheaf.obj (Opposite.op W))],
        algebraMap B ↑(Y.presheaf.obj (Opposite.op W)) =
          CommRingCat.Hom.hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ f_B.appTop ≫
              Y.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op) →
        IsDomain (TensorProduct B ↑(Y.presheaf.obj (Opposite.op W)) K) := by
    intro W hW hNe _ halg
    have _ : IsDomain ↑(Y.presheaf.obj (Opposite.op W)) :=
      @AlgebraicGeometry.IsIntegral.component_integral Y _ W hNe
    apply part_s2_2
    rw [halg]
    have hfB_inj : Function.Injective f_B.appTop.hom := by
      intro x₁ x₂ hx
      have hsec : f_B.appTop ≫ τ_B.appTop = 𝟙 _ := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hτ_B]; rfl
      have h2 := congrArg τ_B.appTop.hom hx
      change (f_B.appTop ≫ τ_B.appTop).hom x₁ = (f_B.appTop ≫ τ_B.appTop).hom x₂ at h2
      rwa [hsec] at h2
    have _ : Nonempty ↥W := hNe
    have hres_inj : Function.Injective
        (Y.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op).hom :=
      AlgebraicGeometry.map_injective_of_isIntegral Y (CategoryTheory.homOfLE (le_top : W ≤ ⊤))
    have hΓ_inj : Function.Injective
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv).hom := by
      intro x₁ x₂ hx
      have h2 := congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).hom).hom hx
      change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).hom).hom x₁ =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).hom).hom x₂ at h2
      rwa [CategoryTheory.Iso.inv_hom_id] at h2
    intro b₁ b₂ hb
    exact hΓ_inj (hfB_inj (hres_inj hb))
  have hInt_CK : AlgebraicGeometry.IsIntegral C_K := part_s3 B K Y f_B hDom_Y
  have _ : AlgebraicGeometry.IsIntegral C_K := hInt_CK
  have hPb_CK_V : CategoryTheory.IsPullback q_K p_K f (g_BK ≫ e_V.inv) := by
    have hcomm_iso : 𝟙 Y ≫ f = f_B ≫ e_V.inv := by
      dsimp [f_B]
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
        e_V.hom_inv_id, CategoryTheory.Category.comp_id]
    have hPb_iso : CategoryTheory.IsPullback (𝟙 Y) f_B f e_V.inv :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨hcomm_iso⟩
    have hp := (CategoryTheory.IsPullback.of_hasPullback f_B g_BK).paste_horiz hPb_iso
    rwa [CategoryTheory.Category.comp_id] at hp
  have hSm_pK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K :=
    (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
      hPb_CK_V ‹_›
  let s_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K :=
    CategoryTheory.Limits.pullback.lift (g_BK ≫ τ_B) (𝟙 _) (by
      rw [CategoryTheory.Category.assoc, hτ_B, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp])
  have hs_K_sec : s_K ≫ p_K = 𝟙 _ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  
  have hSub_SpecK : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := by
    refine ⟨fun p₁ p₂ => ?_⟩
    have hp_bot : ∀ p : PrimeSpectrum K, p.asIdeal = ⊥ := by
      intro p
      by_contra hne
      obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (IsUnit.mk0 x hx0))
    exact PrimeSpectrum.ext ((hp_bot p₁).trans (hp_bot p₂).symm)
  let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := ⟨⊥, hbot_prime K⟩
  let x₀ : ↥C_K := s_K.base pt_K
  obtain ⟨U_base, _, V₀, hV₀, hx₀, e₀, hStd_raw⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 p_K).mp hSm_pK x₀
  have hU_base_top : U_base = ⊤ := by
    ext y
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    rw [hSub_SpecK.elim y (p_K.base x₀)]
    exact e₀ hx₀
  subst hU_base_top
  let φ_V₀_cat : CommRingCat.of K ⟶ C_K.presheaf.obj (Opposite.op V₀) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
      p_K.appTop ≫ C_K.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op
  have happLE_eq : p_K.appLE ⊤ V₀ e₀ =
      p_K.appTop ≫ C_K.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op := by
    have he : CategoryTheory.homOfLE e₀ = CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤) :=
      Subsingleton.elim _ _
    change p_K.app ⊤ ≫ C_K.presheaf.map (CategoryTheory.homOfLE e₀).op = _
    rw [he]; rfl
  have hStd : RingHom.IsStandardSmoothOfRelativeDimension 1 φ_V₀_cat.hom := by
    have hcomp_cat : φ_V₀_cat =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ p_K.appLE ⊤ V₀ e₀ := by
      rw [happLE_eq]
    rw [hcomp_cat]
    exact ((@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).cancel_left_isIso
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv (p_K.appLE ⊤ V₀ e₀)).mpr hStd_raw
  have hNe_V₀_sch : Nonempty ↥V₀.toScheme := ⟨⟨x₀, hx₀⟩⟩
  have hNe_V₀ : Nonempty ↥V₀ := ⟨⟨x₀, hx₀⟩⟩
  have _ : Nonempty ↥V₀.toScheme := hNe_V₀_sch
  have _ : Nonempty ↥V₀ := hNe_V₀
  have _ : IsDomain ↑(C_K.presheaf.obj (Opposite.op V₀)) :=
    @AlgebraicGeometry.IsIntegral.component_integral C_K hInt_CK V₀ hNe_V₀_sch
  obtain ⟨hAlgKA₀, hAlgKA₀_eq, Φ, hΦ⟩ :
      ∃ (hAlg : Algebra K ↑(C_K.presheaf.obj (Opposite.op V₀))),
        @algebraMap K ↑(C_K.presheaf.obj (Opposite.op V₀)) _ _ hAlg = φ_V₀_cat.hom ∧
        ∃ Φ : @AlgHom K ↑(C_K.presheaf.obj (Opposite.op V₀)) (PowerSeries K) _ _ _ hAlg _,
          Function.Injective Φ := by
    let _ : Algebra K ↑(C_K.presheaf.obj (Opposite.op V₀)) := φ_V₀_cat.hom.toAlgebra
    obtain ⟨g_mv, hg_mv_comp, hg_mv_et⟩ :=
      RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStd
    let ψ_mv : MvPolynomial (Fin 1) K →ₐ[K] ↑(C_K.presheaf.obj (Opposite.op V₀)) :=
      { toRingHom := g_mv
        commutes' := fun r => RingHom.congr_fun hg_mv_comp r }
    let e_poly := (MvPolynomial.uniqueAlgEquiv K (Fin 1)).symm
    let ψ₁ : Polynomial K →ₐ[K] ↑(C_K.presheaf.obj (Opposite.op V₀)) :=
      ψ_mv.comp e_poly.toAlgHom
    have hψ₁_et : RingHom.Etale ψ₁.toRingHom :=
      RingHom.Etale.stableUnderComposition e_poly.toAlgHom.toRingHom g_mv
        (RingHom.Etale.of_bijective e_poly.bijective) hg_mv_et
    have hs_K_range : Set.range s_K.base ⊆ Set.range hV₀.fromSpec.base := by
      rintro _ ⟨y, rfl⟩
      rw [hSub_SpecK.elim y pt_K]
      change x₀ ∈ (hV₀.fromSpec.opensRange : Set ↥C_K)
      rw [hV₀.opensRange_fromSpec]
      exact hx₀
    let s_lift := AlgebraicGeometry.IsOpenImmersion.lift hV₀.fromSpec s_K hs_K_range
    have hs_lift_comp : s_lift ≫ hV₀.fromSpec = s_K :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hV₀.fromSpec s_K hs_K_range
    let σ_cat : C_K.presheaf.obj (Opposite.op V₀) ⟶ CommRingCat.of K :=
      AlgebraicGeometry.Spec.preimage s_lift
    have hσ_sec_cat : φ_V₀_cat ≫ σ_cat = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        ← fromSpec_comp_spec_eq p_K hV₀, ← CategoryTheory.Category.assoc,
        hs_lift_comp, hs_K_sec, AlgebraicGeometry.Spec.map_id]
    let σ : ↑(C_K.presheaf.obj (Opposite.op V₀)) →ₐ[K] K :=
      { toRingHom := σ_cat.hom
        commutes' := fun r => by
          change (φ_V₀_cat ≫ σ_cat).hom r = r
          rw [hσ_sec_cat]; rfl }
    exact ⟨φ_V₀_cat.hom.toAlgebra, rfl,
      part_s1 K ↑(C_K.presheaf.obj (Opposite.op V₀)) σ ψ₁ hψ₁_et⟩
  let _ : Algebra K ↑(C_K.presheaf.obj (Opposite.op V₀)) := hAlgKA₀

  
  let s_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_U F)) ≫ e_U.inv
  let g_spec : AlgebraicGeometry.Spec (CommRingCat.of A_U) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B) :=
    e_U.inv ≫ g_U ≫ e_V.hom
  have _ : AlgebraicGeometry.Etale e_U.inv :=
    AlgebraicGeometry.Etale.instOfIsOpenImmersion e_U.inv
  have _ : AlgebraicGeometry.Etale e_V.hom :=
    AlgebraicGeometry.Etale.instOfIsOpenImmersion e_V.hom
  have _ : AlgebraicGeometry.Etale g_spec := by
    dsimp [g_spec]; infer_instance
  have _ : AlgebraicGeometry.UniversallyOpen g_spec :=
    AlgebraicGeometry.UniversallyOpen.of_flat g_spec
  let φ_BU_cat := AlgebraicGeometry.Spec.preimage g_spec
  have hg_spec_eq : AlgebraicGeometry.Spec.map φ_BU_cat = g_spec :=
    AlgebraicGeometry.Spec.map_preimage g_spec
  have hφ_BU_inj : Function.Injective φ_BU_cat.hom := by
    have hOpen_range : IsOpen (Set.range g_spec.base) := by
      rw [← Set.image_univ]
      exact g_spec.isOpenMap Set.univ isOpen_univ
    have hNe_SpecU : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of A_U)) :=
      ⟨⟨⊥, hbot_prime A_U⟩⟩
    let bot_B : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) := ⟨⊥, hbot_prime B⟩
    have hBot_mem : bot_B ∈ Set.range g_spec.base := by
      by_contra hnot
      obtain ⟨s_set, hs_set⟩ := (PrimeSpectrum.isOpen_iff (Set.range g_spec.base)).mp hOpen_range
      have hbot_zl : bot_B ∈ PrimeSpectrum.zeroLocus s_set :=
        (Set.ext_iff.mp hs_set bot_B).mp hnot
      have hsub_bot : s_set ⊆ (bot_B.asIdeal : Set B) :=
        (PrimeSpectrum.mem_zeroLocus bot_B s_set).mp hbot_zl
      let u₀ := Classical.choice hNe_SpecU
      have hu₀_zl : g_spec.base u₀ ∈ PrimeSpectrum.zeroLocus s_set := by
        refine (PrimeSpectrum.mem_zeroLocus (g_spec.base u₀) s_set).mpr ?_
        intro r hr
        have hr0 : r ∈ (⊥ : Ideal B) := hsub_bot hr
        rw [Submodule.mem_bot] at hr0
        rw [hr0]
        exact (g_spec.base u₀).asIdeal.zero_mem
      have hu₀_in : g_spec.base u₀ ∈ (Set.range g_spec.base)ᶜ :=
        (Set.ext_iff.mp hs_set (g_spec.base u₀)).mpr hu₀_zl
      exact hu₀_in ⟨u₀, rfl⟩
    obtain ⟨q_U, hq_U⟩ := hBot_mem
    rw [← hg_spec_eq] at hq_U
    have hcomap_bot : Ideal.comap φ_BU_cat.hom q_U.asIdeal = ⊥ :=
      congrArg PrimeSpectrum.asIdeal hq_U
    intro b₁ b₂ hb_eq
    have hb : φ_BU_cat.hom (b₁ - b₂) = 0 := by rw [map_sub, hb_eq, sub_self]
    have hmem : b₁ - b₂ ∈ Ideal.comap φ_BU_cat.hom q_U.asIdeal := by
      change φ_BU_cat.hom (b₁ - b₂) ∈ q_U.asIdeal
      rw [hb]
      exact q_U.asIdeal.zero_mem
    rw [hcomap_bot, Submodule.mem_bot] at hmem
    exact sub_eq_zero.mp hmem
  obtain ⟨hAlgKF, hKF_BK⟩ :
      ∃ (hAlg : Algebra K F),
        CommRingCat.ofHom (algebraMap B K) ≫
          CommRingCat.ofHom (@algebraMap K F _ _ hAlg) =
        φ_BU_cat ≫ CommRingCat.ofHom (algebraMap A_U F) := by
    let j_BF : B →+* F := (algebraMap A_U F).comp φ_BU_cat.hom
    have hj_BF_inj : Function.Injective j_BF :=
      (IsFractionRing.injective A_U F).comp hφ_BU_inj
    have hj_BF_units : ∀ y : nonZeroDivisors B, IsUnit (j_BF y.1) := by
      intro y
      have hy0 : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hjy0 : j_BF y.1 ≠ 0 := fun h0 => hy0 (hj_BF_inj (h0.trans (map_zero j_BF).symm))
      exact IsUnit.mk0 (j_BF y.1) hjy0
    let ι_KF : K →+* F := IsLocalization.lift (M := nonZeroDivisors B) hj_BF_units
    refine ⟨ι_KF.toAlgebra, ?_⟩
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro b
    exact IsLocalization.lift_eq (M := nonZeroDivisors B) hj_BF_units b
  let _ : Algebra K F := hAlgKF

  have hIrred_CK : IrreducibleSpace ↥C_K :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K
  have _ : IrreducibleSpace ↥C_K := hIrred_CK
  have _ : Nonempty ↥(⊤ : C_K.Opens).toScheme :=
    ⟨⟨Classical.choice hIrred_CK.toNonempty, trivial⟩⟩
  have hgen_mem : ∀ (W : C_K.Opens) [Nonempty ↥W], _root_.genericPoint ↥C_K ∈ W := by
    intro W hNeW
    obtain ⟨w, hw⟩ := hNeW
    exact ((_root_.genericPoint_spec ↥C_K).mem_open_set_iff W.isOpen).mpr ⟨w, trivial, hw⟩
  let φ_L₀_cat : CommRingCat.of K ⟶ C_K.functionField :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
      p_K.appTop ≫ C_K.germToFunctionField ⊤
  obtain ⟨hAlgKL₀, hAlgKL₀_eq, hTower_V₀⟩ :
      ∃ (hAlg : Algebra K ↑C_K.functionField),
        @algebraMap K ↑C_K.functionField _ _ hAlg = φ_L₀_cat.hom ∧
        @IsScalarTower K ↑(C_K.presheaf.obj (Opposite.op V₀)) ↑C_K.functionField
          (@Algebra.toSMul _ _ _ _ hAlgKA₀) _ (@Algebra.toSMul _ _ _ _ hAlg) := by
    let _ : Algebra K ↑C_K.functionField := φ_L₀_cat.hom.toAlgebra
    refine ⟨φ_L₀_cat.hom.toAlgebra, rfl, IsScalarTower.of_algebraMap_eq fun r => ?_⟩
    have hres : C_K.presheaf.map (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤)).op ≫
        C_K.germToFunctionField V₀ = C_K.germToFunctionField ⊤ :=
      TopCat.Presheaf.germ_res C_K.presheaf (CategoryTheory.homOfLE (le_top : V₀ ≤ ⊤))
        (_root_.genericPoint ↥C_K) (hgen_mem V₀)
    have heq_cat : φ_L₀_cat = φ_V₀_cat ≫ C_K.germToFunctionField V₀ := by
      dsimp only [φ_L₀_cat, φ_V₀_cat]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hres]
    change φ_L₀_cat.hom r = (C_K.germToFunctionField V₀).hom (algebraMap K _ r)
    rw [hAlgKA₀_eq]
    change φ_L₀_cat.hom r = (φ_V₀_cat ≫ C_K.germToFunctionField V₀).hom r
    rw [heq_cat]
  let _ : Algebra K ↑C_K.functionField := hAlgKL₀
  have _ : IsScalarTower K ↑(C_K.presheaf.obj (Opposite.op V₀)) ↑C_K.functionField := hTower_V₀
  have _ : IsFractionRing ↑(C_K.presheaf.obj (Opposite.op V₀)) ↑C_K.functionField :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C_K V₀ hV₀
  have _ : IsDomain (TensorProduct K ↑C_K.functionField F) :=
    part_s2_1 K F ↑(C_K.presheaf.obj (Opposite.op V₀)) ↑C_K.functionField Φ hΦ

  have hDom_CK : ∀ (W : C_K.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥W.toScheme →
      ∀ [Algebra K ↑(C_K.presheaf.obj (Opposite.op W))],
        algebraMap K ↑(C_K.presheaf.obj (Opposite.op W)) =
          CommRingCat.Hom.hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
              p_K.appTop ≫ C_K.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op) →
        IsDomain (TensorProduct K ↑(C_K.presheaf.obj (Opposite.op W)) F) := by
    intro W _ hNe _ halg
    have _ : Nonempty ↥W := hNe
    have _ : Nonempty ↥W.toScheme := hNe
    have hres : C_K.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op ≫
        C_K.germToFunctionField W = C_K.germToFunctionField ⊤ :=
      TopCat.Presheaf.germ_res C_K.presheaf (CategoryTheory.homOfLE (le_top : W ≤ ⊤))
        (_root_.genericPoint ↥C_K) (hgen_mem W)
    let ι_WL₀ : ↑(C_K.presheaf.obj (Opposite.op W)) →ₐ[K] ↑C_K.functionField :=
      { toRingHom := (C_K.germToFunctionField W).hom
        commutes' := fun r => by
          rw [halg, hAlgKL₀_eq]
          change ((AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫ p_K.appTop ≫
            (C_K.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op ≫
              C_K.germToFunctionField W)).hom r = φ_L₀_cat.hom r
          rw [hres] }
    have hι_WL₀_inj : Function.Injective ι_WL₀ :=
      AlgebraicGeometry.Scheme.germToFunctionField_injective C_K W
    let map_W := Algebra.TensorProduct.map ι_WL₀ (AlgHom.id K F)
    have hmap_W_eq : map_W.toLinearMap = LinearMap.rTensor F ι_WL₀.toLinearMap := by
      apply TensorProduct.ext'
      intro s y; rfl
    have hmap_W_inj : Function.Injective map_W := by
      change Function.Injective map_W.toLinearMap
      rw [hmap_W_eq]
      exact Module.Flat.rTensor_preserves_injective_linearMap ι_WL₀.toLinearMap hι_WL₀_inj
    exact Function.Injective.isDomain map_W.toRingHom hmap_W_inj

  let g_KF := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F))
  let C_F := CategoryTheory.Limits.pullback p_K g_KF
  have hInt_CF : AlgebraicGeometry.IsIntegral C_F := part_s3 K F C_K p_K hDom_CK
  have hIrred_CF : IrreducibleSpace ↥C_F :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_F hInt_CF

  
  have hBase_eq : g_KF ≫ (g_BK ≫ e_V.inv) = s_F ≫ g_U := by
    dsimp [g_KF, g_BK, s_F]
    rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
      ← AlgebraicGeometry.Spec.map_comp, hKF_BK, AlgebraicGeometry.Spec.map_comp,
      hg_spec_eq]
    dsimp [g_spec]
    simp only [CategoryTheory.Category.assoc, e_V.hom_inv_id, CategoryTheory.Category.comp_id]
  have hPb_CF_tot : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst p_K g_KF ≫ q_K)
      (CategoryTheory.Limits.pullback.snd p_K g_KF)
      f (s_F ≫ g_U) := by
    rw [← hBase_eq]
    exact (CategoryTheory.IsPullback.of_hasPullback p_K g_KF).paste_horiz hPb_CK_V
  have hPb_target_tot : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd f g_U) s_F ≫
        CategoryTheory.Limits.pullback.fst f g_U)
      (CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd f g_U) s_F)
      f (s_F ≫ g_U) :=
    (CategoryTheory.IsPullback.of_hasPullback
      (CategoryTheory.Limits.pullback.snd f g_U) s_F).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback f g_U)
  let e_final : C_F ≅
      CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd f g_U) s_F :=
    hPb_CF_tot.isoPullback ≪≫ hPb_target_tot.isoPullback.symm
  refine ⟨F, inferInstance, s_F, ?_⟩
  have hUniv_eq : (Set.univ : Set ↥(CategoryTheory.Limits.pullback
      (CategoryTheory.Limits.pullback.snd f g_U) s_F)) =
      e_final.hom.base '' (Set.univ : Set ↥C_F) := by
    ext z
    refine ⟨fun _ => ⟨e_final.inv.base z, trivial, ?_⟩, fun _ => trivial⟩
    change (e_final.inv ≫ e_final.hom).base z = z
    rw [e_final.inv_hom_id]
    rfl
  have hIrred_univ : IsIrreducible (Set.univ : Set ↥(CategoryTheory.Limits.pullback
      (CategoryTheory.Limits.pullback.snd f g_U) s_F)) := by
    rw [hUniv_eq]
    exact hIrred_CF.isIrreducible_univ.image e_final.hom.base e_final.hom.continuous.continuousOn
  exact { toPreirreducibleSpace := ⟨hIrred_univ.isPreirreducible⟩
          toNonempty := ⟨e_final.hom.base (Classical.choice hIrred_CF.toNonempty)⟩ }

theorem weil_etale_proper_r0_pbc_geom_fibers_connected (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (hCardConn : ∀ X : AlgebraicGeometry.Scheme.{u},
      ConnectedSpace ↥X ↔ Nat.card (weilEtaleTorsionH X ℓ 0) = ℓ)
    (hSpecR0 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y_Ω : AlgebraicGeometry.Scheme.{u})
        (f' : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
      Nonempty (CategoryTheory.Iso
        (weilEtaleHigherDirectImage f' 0 (weilEtaleTorsionSheaf Y_Ω ℓ))
        ((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (weilEtaleTorsionH Y_Ω ℓ 0)))))
    (V Y : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V] [AlgebraicGeometry.IsReduced V]
    (p_V : Quiver.Hom V (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType p_V]
    (f : Quiver.Hom Y V) [AlgebraicGeometry.IsProper f]
    (τ₀ : Quiver.Hom V Y)
    (hτ₀ : CategoryTheory.CategoryStruct.comp τ₀ f = CategoryTheory.CategoryStruct.id V)
    (hConn_et : ∀ (U : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine U] [ConnectedSpace ↥U]
        (g_U : Quiver.Hom U V) [AlgebraicGeometry.Etale g_U],
      ConnectedSpace ↥(CategoryTheory.Limits.pullback f g_U))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V) :
    ConnectedSpace ↥(CategoryTheory.Limits.pullback f s) :=
by
  classical
  have _ : IsAlgClosed k ∧ Fact (Nat.Prime ℓ) ∧
      WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all) ∧
      AlgebraicGeometry.IsAffine V ∧ AlgebraicGeometry.IsReduced V :=
    ⟨‹IsAlgClosed k›, ‹Fact (Nat.Prime ℓ)›, hSite,
      ‹AlgebraicGeometry.IsAffine V›, ‹AlgebraicGeometry.IsReduced V›⟩

  have hClopenConn :
      ∀ {α : Type u} [TopologicalSpace α] [TopologicalSpace.NoetherianSpace α] (x₀ : α),
        IsClopen (connectedComponent x₀) := by
    intro α _ _ x₀
    refine ⟨isClosed_connectedComponent, ?_⟩
    rw [← isClosed_compl_iff]
    let S_disj : Set (Set α) :=
      {E ∈ irreducibleComponents α | Disjoint E (connectedComponent x₀)}
    have hFin : S_disj.Finite :=
      (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := α)).sep _
    have hCompl : (connectedComponent x₀)ᶜ = ⋃ E ∈ S_disj, E := by
      ext y
      simp only [Set.mem_compl_iff, Set.mem_iUnion, S_disj, Set.mem_sep_iff]
      constructor
      · intro hy
        refine ⟨irreducibleComponent y,
          ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩,
          mem_irreducibleComponent⟩
        rw [Set.disjoint_left]
        intro w hw_irr hw_cc
        apply hy
        have hw_y : w ∈ connectedComponent y :=
          irreducibleComponent_subset_connectedComponent hw_irr
        have hy_y : y ∈ connectedComponent y := mem_connectedComponent
        have h1 := connectedComponent_eq hw_y
        have h2 := connectedComponent_eq hw_cc
        grind
      · rintro ⟨E, ⟨_, hDisj⟩, hyE⟩
        exact Set.disjoint_left.mp hDisj hyE
    rw [hCompl]
    exact hFin.isClosed_biUnion fun E hE => isClosed_of_mem_irreducibleComponents E hE.1

  have hIso_pull : CategoryTheory.IsIso (weilAltLocConstPullbackNat f ℓ) := by
    have hApp : ∀ U_op : V.Etaleᵒᵖ,
        CategoryTheory.IsIso ((weilAltLocConstPullbackNat f ℓ).app U_op) := by
      intro U_op
      let U : V.Etale := Opposite.unop U_op
      change CategoryTheory.IsIso ((weilAltLocConstPullbackNat f ℓ).app (Opposite.op U))
      rw [CategoryTheory.ConcreteCategory.isIso_iff_bijective]
      let FgtV := AlgebraicGeometry.Scheme.Etale.forget V
      let U_sch : AlgebraicGeometry.Scheme.{u} := (FgtV.obj U).left
      let g_U : U_sch ⟶ V := (FgtV.obj U).hom
      have : AlgebraicGeometry.Etale g_U := U.prop
      let W_U : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g_U f
      change Function.Bijective
        (fun g : LocallyConstant ↥U_sch (ULift.{u} (ZMod ℓ)) =>
          (((weilAltLocConstPullbackNat f ℓ).app (Opposite.op U)).hom g :
            LocallyConstant ↥W_U (ULift.{u} (ZMod ℓ))))
      let pr₁ : W_U ⟶ U_sch := CategoryTheory.Limits.pullback.fst g_U f
      let pr₂ : W_U ⟶ Y := CategoryTheory.Limits.pullback.snd g_U f
      have hσ_comm : CategoryTheory.CategoryStruct.id U_sch ≫ g_U = (g_U ≫ τ₀) ≫ f := by
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hτ₀,
          CategoryTheory.Category.comp_id]
      let σ_U : U_sch ⟶ W_U :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.id U_sch) (g_U ≫ τ₀) hσ_comm
      have hσ_pr₁ : σ_U ≫ pr₁ = CategoryTheory.CategoryStruct.id U_sch :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hσ_pt : ∀ u : ↥U_sch, pr₁.base (σ_U.base u) = u := fun u => by
        change (σ_U ≫ pr₁).base u = u
        rw [hσ_pr₁]
        rfl
      constructor
      · intro α₁ α₂ hEq
        apply LocallyConstant.ext
        intro u
        have hev : α₁ (pr₁.base (σ_U.base u)) = α₂ (pr₁.base (σ_U.base u)) :=
          LocallyConstant.congr_fun hEq (σ_U.base u)
        rwa [hσ_pt u] at hev
      · intro (β : LocallyConstant ↥W_U (ULift.{u} (ZMod ℓ)))
        let α : LocallyConstant ↥U_sch (ULift.{u} (ZMod ℓ)) :=
          { toFun := fun u => β (σ_U.base u)
            isLocallyConstant := fun t =>
              σ_U.continuous.isOpen_preimage _ (β.isLocallyConstant t) }
        refine ⟨α, LocallyConstant.ext fun z => ?_⟩
        let u : ↥U_sch := pr₁.base z
        change β (σ_U.base u) = β z
        obtain ⟨W, hW, hu_W, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := u) (U := (⊤ : U_sch.Opens)) trivial
        let R_cat := U_sch.presheaf.obj (Opposite.op W)
        let S_W := AlgebraicGeometry.Spec R_cat
        have hu_rng : u ∈ Set.range hW.fromSpec.base := by
          rw [hW.range_fromSpec]
          exact hu_W
        obtain ⟨x₀, hx₀⟩ := hu_rng
        let f_k : S_W ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := hW.fromSpec ≫ g_U ≫ p_V
        have : AlgebraicGeometry.LocallyOfFiniteType f_k := by
          dsimp [f_k]
          infer_instance
        let φ_k : CommRingCat.of k ⟶ R_cat := AlgebraicGeometry.Spec.preimage f_k
        have hmap_φk : AlgebraicGeometry.Spec.map φ_k = f_k :=
          AlgebraicGeometry.Spec.map_preimage f_k
        have hFT_hom : RingHom.FiniteType φ_k.hom := by
          rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φk]
          infer_instance
        let _ : Algebra k ↑R_cat := φ_k.hom.toAlgebra
        have : Algebra.FiniteType k ↑R_cat := hFT_hom
        have : IsNoetherianRing ↑R_cat := Algebra.FiniteType.isNoetherianRing k ↑R_cat
        have hClop : IsClopen (connectedComponent (x₀ : PrimeSpectrum ↑R_cat)) := hClopenConn x₀
        obtain ⟨e_idem, _, he_eq⟩ := PrimeSpectrum.isClopen_iff.mp hClop
        let D_e : S_W.Opens := PrimeSpectrum.basicOpen e_idem
        have : AlgebraicGeometry.IsAffine D_e.toScheme :=
          AlgebraicGeometry.IsAffineOpen.Spec_basicOpen e_idem
        have hDe_set : (D_e : Set ↥S_W) = connectedComponent x₀ := he_eq.symm
        have : ConnectedSpace ↥D_e.toScheme :=
          isConnected_iff_connectedSpace.mp (hDe_set ▸ isConnected_connectedComponent)
        let j_e : D_e.toScheme ⟶ U_sch := D_e.ι ≫ hW.fromSpec
        have : AlgebraicGeometry.Etale (j_e ≫ g_U) := by
          dsimp [j_e]
          infer_instance
        have : ConnectedSpace ↥(CategoryTheory.Limits.pullback f (j_e ≫ g_U)) :=
          hConn_et D_e.toScheme (j_e ≫ g_U)
        have hx₀_De : x₀ ∈ D_e := by
          change x₀ ∈ (D_e : Set ↥S_W)
          rw [hDe_set]
          exact mem_connectedComponent
        have hu_je : u ∈ Set.range j_e.base :=
          ⟨⟨x₀, hx₀_De⟩, by
            change hW.fromSpec.base (D_e.ι.base ⟨x₀, hx₀_De⟩) = u
            rw [AlgebraicGeometry.Scheme.Opens.ι_apply]
            exact hx₀⟩
        let P_e := CategoryTheory.Limits.pullback f (j_e ≫ g_U)
        let fst_e : P_e ⟶ Y := CategoryTheory.Limits.pullback.fst f (j_e ≫ g_U)
        let snd_e : P_e ⟶ D_e.toScheme := CategoryTheory.Limits.pullback.snd f (j_e ≫ g_U)
        let q_e : P_e ⟶ W_U :=
          CategoryTheory.Limits.pullback.lift (snd_e ≫ j_e) fst_e
            (by rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition])
        have hPb_qe : CategoryTheory.IsPullback q_e snd_e pr₁ j_e :=
          CategoryTheory.IsPullback.of_right
            (by
              change CategoryTheory.IsPullback (q_e ≫ pr₂) snd_e f (j_e ≫ g_U)
              rw [CategoryTheory.Limits.pullback.lift_snd]
              exact CategoryTheory.IsPullback.of_hasPullback f (j_e ≫ g_U))
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.IsPullback.of_hasPullback g_U f).flip
        let e_pb := hPb_qe.isoPullback
        have hRange_qe : Set.range q_e.base = pr₁.base ⁻¹' Set.range j_e.base := by
          rw [← AlgebraicGeometry.Scheme.Pullback.range_fst pr₁ j_e, ← hPb_qe.isoPullback_hom_fst]
          ext w
          simp only [Set.mem_range]
          constructor
          · rintro ⟨p, rfl⟩
            exact ⟨e_pb.hom.base p, rfl⟩
          · rintro ⟨p, rfl⟩
            refine ⟨e_pb.inv.base p, ?_⟩
            change ((e_pb.inv ≫ e_pb.hom) ≫ CategoryTheory.Limits.pullback.fst pr₁ j_e).base p = _
            rw [e_pb.inv_hom_id, CategoryTheory.Category.id_comp]
        have hPre : _root_.IsPreconnected (pr₁.base ⁻¹' Set.range j_e.base) := by
          rw [← hRange_qe]
          exact isPreconnected_range q_e.continuous
        have hmem₁ : σ_U.base u ∈ pr₁.base ⁻¹' Set.range j_e.base := by
          change pr₁.base (σ_U.base u) ∈ Set.range j_e.base
          rw [hσ_pt u]
          exact hu_je
        have hmem₂ : z ∈ pr₁.base ⁻¹' Set.range j_e.base := hu_je
        exact β.apply_eq_of_isPreconnected hPre hmem₁ hmem₂
    exact CategoryTheory.NatIso.isIso_of_isIso_app (weilAltLocConstPullbackNat f ℓ)

  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S V₁ V₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₁).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₂).hom) := by
      rw [hvw]
      exact V₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj V₂).hom V₂.prop hEt_comp

  have hSheafForget :
      ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (P : CategoryTheory.Functor (Z.Etale)ᵒᵖ AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology P ↔
          CategoryTheory.Presieve.IsSheaf Z.smallEtaleTopology
            (P ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
    intro Z P
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    constructor
    · intro hP
      let e_coy : P ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ) ≅
          P ⋙ CategoryTheory.forget AddCommGrpCat.{u} :=
        CategoryTheory.NatIso.ofComponents
          (fun X =>
            { hom := TypeCat.ofHom (fun φ => φ.hom (ULift.up 1))
              inv := TypeCat.ofHom (fun a => AddCommGrpCat.ofHom
                { toFun := fun n => n.down • a
                  map_zero' := zero_zsmul a
                  map_add' := fun m n => add_zsmul a m.down n.down })
              hom_inv_id := by
                ext φ
                apply AddCommGrpCat.ext
                rintro ⟨n⟩
                change n • φ.hom (ULift.up 1) = φ.hom (ULift.up n)
                rw [← map_zsmul]
                congr 1
                ext
                change n * 1 = n
                exact mul_one n
              inv_hom_id := by
                ext a
                exact one_zsmul a })
          (fun _ => rfl)
      exact CategoryTheory.Presieve.isSheaf_iso Z.smallEtaleTopology e_coy (hP Aℤ)
    · intro hP_set E X S hS x hx
      let P_set := P ⋙ CategoryTheory.forget AddCommGrpCat.{u}
      let x_a : ↑E → CategoryTheory.Presieve.FamilyOfElements P_set S.arrows :=
        fun a Y f hf => (x f hf).hom a
      have hx_a : ∀ a : ↑E, (x_a a).Compatible := by
        intro a Y₁ Y₂ W g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        have h := hx g₁ g₂ h₁ h₂ hcomm
        exact congrArg (fun φ : E ⟶ P.obj (Opposite.op W) => φ.hom a) h
      have hEx : ∀ a : ↑E, ∃! t : ↑(P.obj (Opposite.op X)),
          ∀ ⦃Y : Z.Etale⦄ (f : Y ⟶ X) (hf : S.arrows f),
            (P.map f.op).hom t = (x f hf).hom a :=
        fun a => hP_set S hS (x_a a) (hx_a a)
      let t_fn : ↑E → ↑(P.obj (Opposite.op X)) := fun a => Classical.choose (hEx a)
      have ht_amalg : ∀ (a : ↑E) ⦃Y : Z.Etale⦄ (f : Y ⟶ X) (hf : S.arrows f),
          (P.map f.op).hom (t_fn a) = (x f hf).hom a :=
        fun a => (Classical.choose_spec (hEx a)).1
      have ht_uniq : ∀ (a : ↑E) (z : ↑(P.obj (Opposite.op X))),
          (∀ ⦃Y : Z.Etale⦄ (f : Y ⟶ X) (hf : S.arrows f),
            (P.map f.op).hom z = (x f hf).hom a) → z = t_fn a :=
        fun a => (Classical.choose_spec (hEx a)).2
      have ht_zero : t_fn 0 = 0 :=
        (ht_uniq 0 0 (fun Y f hf => by simp)).symm
      have ht_add : ∀ a b : ↑E, t_fn (a + b) = t_fn a + t_fn b :=
        fun a b => (ht_uniq (a + b) (t_fn a + t_fn b) (fun Y f hf => by
          rw [map_add, ht_amalg a f hf, ht_amalg b f hf, map_add])).symm
      let φ : E ⟶ P.obj (Opposite.op X) :=
        AddCommGrpCat.ofHom
          { toFun := t_fn
            map_zero' := ht_zero
            map_add' := ht_add }
      refine ⟨φ, ?_, ?_⟩
      · intro Y f hf
        apply AddCommGrpCat.ext
        intro a
        exact ht_amalg a f hf
      · intro ψ hψ
        apply AddCommGrpCat.ext
        intro a
        exact ht_uniq a (ψ.hom a) (fun Y f hf =>
          congrArg (fun ξ : E ⟶ P.obj (Opposite.op Y) => ξ.hom a) (hψ f hf))

  have hArrowsMem :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) {U : Z.Etale} {I : Type u}
        {W_fam : I → Z.Etale} (u_fam : ∀ i : I, W_fam i ⟶ U),
        (∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).left,
          ∃ (i : I) (y : ↥((AlgebraicGeometry.Scheme.Etale.forget Z).obj (W_fam i)).left),
            ((AlgebraicGeometry.Scheme.Etale.forget Z).map (u_fam i)).left.base y = x) →
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows W_fam u_fam) ∈
          Z.smallEtaleTopology U := by
    intro Z U I W_fam u_fam hSurj
    have hEq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Z (le_refl P_et)
    have hMemPre :
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows W_fam u_fam) ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U _).mpr fun x =>
        let ⟨i, y, hy⟩ := hSurj x
        ⟨W_fam i, u_fam i, y,
          CategoryTheory.Sieve.le_generate _ _ _ (CategoryTheory.Presieve.ofArrows.mk i),
          hEt_of_etale_hom (u_fam i), hy⟩
    exact Eq.mpr
      (congrFun (congrArg (fun J : CategoryTheory.GrothendieckTopology Z.Etale => J U) hEq) _)
      hMemPre

  let L_pre : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (M : AddCommGrpCat.{u}),
      CategoryTheory.Functor (Z.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    fun Z M =>
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
      { obj := fun U =>
          AddCommGrpCat.of (LocallyConstant ↥(Fgt.obj (Opposite.unop U)).left ↑M)
        map := fun {_ _} v =>
          AddCommGrpCat.ofHom
            { toFun := fun g =>
                { toFun := fun x => g ((Fgt.map v.unop).left x)
                  isLocallyConstant := fun t =>
                    (Fgt.map v.unop).left.continuous.isOpen_preimage _ (g.isLocallyConstant t) }
              map_zero' := LocallyConstant.ext (fun _ => rfl)
              map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
        map_id := fun _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
        map_comp := fun _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }

  have hSh_L :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (M : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (L_pre Z M) := by
    intro Z M
    rw [hSheafForget Z (L_pre Z M)]
    intro U S hS s hs
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
    have hEq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Z (le_refl P_et)
    have hS' : S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U :=
      Eq.mp
        (congrFun (congrArg (fun J : CategoryTheory.GrothendieckTopology Z.Etale => J U) hEq) S)
        hS
    have hCov := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U S).mp hS'
    let Y_x : ↥(Fgt.obj U).left → Z.Etale := fun x => Classical.choose (hCov x)
    let f_x : ∀ x : ↥(Fgt.obj U).left, Y_x x ⟶ U :=
      fun x => Classical.choose (Classical.choose_spec (hCov x))
    let y_x : ∀ x : ↥(Fgt.obj U).left, ↥(Fgt.obj (Y_x x)).left :=
      fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (hCov x)))
    have hf_mem : ∀ x, S.arrows (f_x x) :=
      fun x => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov x)))).1
    have hf_et : ∀ x, AlgebraicGeometry.Etale (Fgt.map (f_x x)).left :=
      fun x => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov x)))).2.1
    have hf_pt : ∀ x, (Fgt.map (f_x x)).left.base (y_x x) = x :=
      fun x => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov x)))).2.2
    let s_lc : ∀ ⦃W_et : Z.Etale⦄ (v : W_et ⟶ U), S.arrows v →
        LocallyConstant ↥(Fgt.obj W_et).left ↑M :=
      fun _ v hv => s v hv
    let g₀ : ↥(Fgt.obj U).left → ↑M := fun x => s_lc (f_x x) (hf_mem x) (y_x x)
    have hAgree : ∀ ⦃W_et : Z.Etale⦄ (v : W_et ⟶ U) (hv : S.arrows v)
        (w : ↥(Fgt.obj W_et).left),
        g₀ ((Fgt.map v).left.base w) = s_lc v hv w := by
      intro W_et v hv w
      let x := (Fgt.map v).left.base w
      have : AlgebraicGeometry.Etale (Fgt.map v).left := hEt_of_etale_hom v
      have : AlgebraicGeometry.Etale (Fgt.map (f_x x)).left := hf_et x
      have : AlgebraicGeometry.Etale (Fgt.obj W_et).hom := W_et.prop
      obtain ⟨z_pb, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          w (y_x x) (hf_pt x).symm
      let P_ov := CategoryTheory.Limits.pullback (Fgt.map v).left (Fgt.map (f_x x)).left
      let fst_ov : P_ov ⟶ (Fgt.obj W_et).left :=
        CategoryTheory.Limits.pullback.fst (Fgt.map v).left (Fgt.map (f_x x)).left
      let snd_ov : P_ov ⟶ (Fgt.obj (Y_x x)).left :=
        CategoryTheory.Limits.pullback.snd (Fgt.map v).left (Fgt.map (f_x x)).left
      let Z_ov : Z.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_ov ≫ (Fgt.obj W_et).hom) inferInstance
      let p₁ : Z_ov ⟶ W_et :=
        CategoryTheory.MorphismProperty.Over.homMk fst_ov rfl trivial
      let p₂ : Z_ov ⟶ Y_x x :=
        CategoryTheory.MorphismProperty.Over.homMk snd_ov
          ((congrArg (snd_ov ≫ ·) (CategoryTheory.MorphismProperty.Over.w (f_x x)).symm).trans
            ((CategoryTheory.Category.assoc snd_ov (Fgt.map (f_x x)).left (Fgt.obj U).hom).symm.trans
              ((congrArg (· ≫ (Fgt.obj U).hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc fst_ov (Fgt.map v).left (Fgt.obj U).hom).trans
                  (congrArg (fst_ov ≫ ·) (CategoryTheory.MorphismProperty.Over.w v))))))
          trivial
      have hp_comm : p₁ ≫ v = p₂ ≫ f_x x :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
      have hcomp := hs p₁ p₂ hv (hf_mem x) hp_comm
      have hev : (s_lc v hv) (fst_ov.base z_pb) = (s_lc (f_x x) (hf_mem x)) (snd_ov.base z_pb) :=
        LocallyConstant.congr_fun hcomp z_pb
      rw [hz₁, hz₂] at hev
      exact hev.symm
    have hg₀_lc : IsLocallyConstant g₀ := by
      intro t
      have hSet : g₀ ⁻¹' t =
          ⋃ x : ↥(Fgt.obj U).left,
            (Fgt.map (f_x x)).left.base '' ((s_lc (f_x x) (hf_mem x)) ⁻¹' t) := by
        ext z
        simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
        constructor
        · intro hz
          exact ⟨z, y_x z, hz, hf_pt z⟩
        · rintro ⟨x, y, hy_t, rfl⟩
          rw [hAgree (f_x x) (hf_mem x) y]
          exact hy_t
      rw [hSet]
      refine isOpen_iUnion fun x => ?_
      have : AlgebraicGeometry.Etale (Fgt.map (f_x x)).left := hf_et x
      exact ((Fgt.map (f_x x)).left).isOpenMap _ ((s_lc (f_x x) (hf_mem x)).isLocallyConstant t)
    let g : LocallyConstant ↥(Fgt.obj U).left ↑M := ⟨g₀, hg₀_lc⟩
    refine ⟨g, ?_, ?_⟩
    · intro W_et v hv
      apply LocallyConstant.ext
      intro w
      exact hAgree v hv w
    · intro (g' : LocallyConstant ↥(Fgt.obj U).left ↑M) hg'
      apply LocallyConstant.ext
      intro x
      have h_ev := LocallyConstant.congr_fun (hg' (f_x x) (hf_mem x)) (y_x x)
      change g' ((Fgt.map (f_x x)).left.base (y_x x)) = g₀ x at h_ev
      rwa [hf_pt x] at h_ev

  have hConstIsoL :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (M : AddCommGrpCat.{u}),
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj M)
          ⟨L_pre Z M, hSh_L Z M⟩) := by
    intro Z M
    let J := Z.smallEtaleTopology
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
    let C_pre := (CategoryTheory.Functor.const (Z.Etale)ᵒᵖ).obj M
    let F_M : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj M
    let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨L_pre Z M, hSh_L Z M⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let η : C_pre ⟶ F_M.obj := adj_sh.unit.app C_pre
    have hη_nat : ∀ {V₁ V₂ : Z.Etale} (w : V₁ ⟶ V₂) (m : ↑M),
        (F_M.obj.map w.op).hom ((η.app (Opposite.op V₂)).hom m) =
          (η.app (Opposite.op V₁)).hom m := by
      intro V₁ V₂ w m
      exact congrArg (fun φ : M ⟶ F_M.obj.obj (Opposite.op V₁) => φ.hom m)
        (η.naturality w.op).symm
    have hF_comp : ∀ {V₁ V₂ V₃ : Z.Etale} (a : V₁ ⟶ V₂) (b : V₂ ⟶ V₃)
        (s : ↑(F_M.obj.obj (Opposite.op V₃))),
        (F_M.obj.map (a ≫ b).op).hom s =
          (F_M.obj.map a.op).hom ((F_M.obj.map b.op).hom s) :=
      fun a b s => congrArg (fun φ => φ.hom s) (F_M.obj.map_comp b.op a.op)
    let κ : C_pre ⟶ L_pre Z M :=
      { app := fun U_op => AddCommGrpCat.ofHom
          { toFun := fun m => LocallyConstant.const _ m
            map_zero' := LocallyConstant.ext (fun _ => rfl)
            map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
        naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }
    let Φ : F_M ⟶ L_sh := (adj_sh.homEquiv C_pre L_sh).symm κ
    have hη_Φ : η ≫ Φ.hom = κ := by
      have h1 : adj_sh.homEquiv C_pre L_sh Φ = κ := Equiv.apply_symm_apply _ _
      rwa [adj_sh.homEquiv_unit] at h1
    let F_set := F_M.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hF_set : CategoryTheory.Presieve.IsSheaf J F_set :=
      (hSheafForget Z F_M.obj).mp F_M.property
    have hShForArrows : ∀ {U : Z.Etale} {I : Type u} {W_fam : I → Z.Etale}
        (u_fam : ∀ i : I, W_fam i ⟶ U),
        (∀ x : ↥(Fgt.obj U).left, ∃ (i : I) (y : ↥(Fgt.obj (W_fam i)).left),
          (Fgt.map (u_fam i)).left.base y = x) →
        CategoryTheory.Presieve.IsSheafFor F_set (CategoryTheory.Presieve.ofArrows W_fam u_fam) :=
      fun u_fam hSurj => hF_set.isSheafFor _ (hArrowsMem Z u_fam hSurj)
    have hSepArrows : ∀ {U : Z.Etale} {I : Type u} {W_fam : I → Z.Etale}
        (u_fam : ∀ i : I, W_fam i ⟶ U),
        (∀ x : ↥(Fgt.obj U).left, ∃ (i : I) (y : ↥(Fgt.obj (W_fam i)).left),
          (Fgt.map (u_fam i)).left.base y = x) →
        ∀ a b : ↑(F_M.obj.obj (Opposite.op U)),
          (∀ i : I, (F_M.obj.map (u_fam i).op).hom a = (F_M.obj.map (u_fam i).op).hom b) →
          a = b := by
      intro U I W_fam u_fam hSurj a b hEq
      have hFor := (CategoryTheory.Presieve.isSheafFor_arrows_iff F_set u_fam).mp
        (hShForArrows u_fam hSurj)
      let x_fam : ∀ i : I, F_set.obj (Opposite.op (W_fam i)) :=
        fun i => (F_M.obj.map (u_fam i).op).hom a
      have hComp : CategoryTheory.Presieve.Arrows.Compatible F_set u_fam x_fam := by
        intro i j Y_et g₁ g₂ hg
        change (F_M.obj.map g₁.op).hom ((F_M.obj.map (u_fam i).op).hom a) =
          (F_M.obj.map g₂.op).hom ((F_M.obj.map (u_fam j).op).hom a)
        exact (hF_comp g₁ (u_fam i) a).symm.trans
          ((congrArg (fun m => (F_M.obj.map m.op).hom a) hg).trans (hF_comp g₂ (u_fam j) a))
      obtain ⟨t, _, ht_uniq⟩ := hFor x_fam hComp
      exact (ht_uniq a (fun _ => rfl)).trans (ht_uniq b (fun i => (hEq i).symm)).symm
    have hEmptySub : ∀ (Y_et : Z.Etale), IsEmpty ↥(Fgt.obj Y_et).left →
        Subsingleton ↑(F_M.obj.obj (Opposite.op Y_et)) := by
      intro Y_et hEmp
      refine ⟨fun a b => ?_⟩
      exact hSepArrows (I := ULift.{u} Empty)
        (W_fam := fun i : ULift.{u} Empty => i.down.elim)
        (fun i : ULift.{u} Empty => i.down.elim)
        (fun x => (hEmp.false x).elim) a b (fun i => i.down.elim)
    let O_x : ∀ {U : Z.Etale} (g : LocallyConstant ↥(Fgt.obj U).left ↑M)
        (x : ↥(Fgt.obj U).left), (Fgt.obj U).left.Opens :=
      fun g x => ⟨g ⁻¹' {g x}, g.isLocallyConstant {g x}⟩
    let W_x : ∀ {U : Z.Etale} (g : LocallyConstant ↥(Fgt.obj U).left ↑M)
        (x : ↥(Fgt.obj U).left), Z.Etale :=
      fun {U} g x =>
        letI : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_x g x).ι ≫ (Fgt.obj U).hom) inferInstance
    let u_x : ∀ {U : Z.Etale} (g : LocallyConstant ↥(Fgt.obj U).left ↑M)
        (x : ↥(Fgt.obj U).left), W_x g x ⟶ U :=
      fun g x => CategoryTheory.MorphismProperty.Over.homMk (O_x g x).ι rfl trivial
    have hu_x_surj : ∀ {U : Z.Etale} (g : LocallyConstant ↥(Fgt.obj U).left ↑M)
        (x : ↥(Fgt.obj U).left),
        ∃ (i : ↥(Fgt.obj U).left) (y : ↥(Fgt.obj (W_x g i)).left),
          (Fgt.map (u_x g i)).left.base y = x :=
      fun g x => ⟨x, ⟨x, rfl⟩, AlgebraicGeometry.Scheme.Opens.ι_apply (O_x g x) ⟨x, rfl⟩⟩
    have hΨ_ex : ∀ (U : Z.Etale) (g : LocallyConstant ↥(Fgt.obj U).left ↑M),
        ∃! t : ↑(F_M.obj.obj (Opposite.op U)),
          ∀ x : ↥(Fgt.obj U).left,
            (F_M.obj.map (u_x g x).op).hom t =
              (η.app (Opposite.op (W_x g x))).hom (g x) := by
      intro U g
      apply (CategoryTheory.Presieve.isSheafFor_arrows_iff F_set (u_x g)).mp
        (hShForArrows (u_x g) (hu_x_surj g))
      intro x y Y_et p₁ p₂ hp
      by_cases hEmp : IsEmpty ↥(Fgt.obj Y_et).left
      · exact @Subsingleton.elim _ (hEmptySub Y_et hEmp) _ _
      · rw [not_isEmpty_iff] at hEmp
        obtain ⟨z⟩ := hEmp
        have hp_pt : ((Fgt.map p₁).left ≫ (O_x g x).ι).base z =
            ((Fgt.map p₂).left ≫ (O_x g y).ι).base z :=
          congrArg (fun m : Y_et ⟶ U => (Fgt.map m).left.base z) hp
        have hx_val : g (((Fgt.map p₁).left ≫ (O_x g x).ι).base z) = g x :=
          ((Fgt.map p₁).left.base z).2
        have hy_val : g (((Fgt.map p₂).left ≫ (O_x g y).ι).base z) = g y :=
          ((Fgt.map p₂).left.base z).2
        have hg_eq : g x = g y := hx_val.symm.trans (congrArg g hp_pt |>.trans hy_val)
        change (F_M.obj.map p₁.op).hom ((η.app (Opposite.op (W_x g x))).hom (g x)) =
          (F_M.obj.map p₂.op).hom ((η.app (Opposite.op (W_x g y))).hom (g y))
        rw [hη_nat p₁ (g x), hη_nat p₂ (g y), hg_eq]
    let ψ_fn : ∀ (U : Z.Etale),
        LocallyConstant ↥(Fgt.obj U).left ↑M → ↑(F_M.obj.obj (Opposite.op U)) :=
      fun U g => Classical.choose (hΨ_ex U g)
    have hψ_spec : ∀ (U : Z.Etale) (g : LocallyConstant ↥(Fgt.obj U).left ↑M)
        (x : ↥(Fgt.obj U).left),
        (F_M.obj.map (u_x g x).op).hom (ψ_fn U g) =
          (η.app (Opposite.op (W_x g x))).hom (g x) :=
      fun U g => (Classical.choose_spec (hΨ_ex U g)).1
    have hψ_uniq : ∀ (U : Z.Etale) (g : LocallyConstant ↥(Fgt.obj U).left ↑M)
        (t : ↑(F_M.obj.obj (Opposite.op U))),
        (∀ x : ↥(Fgt.obj U).left,
          (F_M.obj.map (u_x g x).op).hom t =
            (η.app (Opposite.op (W_x g x))).hom (g x)) →
        t = ψ_fn U g :=
      fun U g => (Classical.choose_spec (hΨ_ex U g)).2
    have hψ_zero : ∀ U : Z.Etale, ψ_fn U 0 = 0 :=
      fun U => (hψ_uniq U 0 0 (fun x => by simp)).symm
    have hψ_add : ∀ (U : Z.Etale) (g₁ g₂ : LocallyConstant ↥(Fgt.obj U).left ↑M),
        ψ_fn U (g₁ + g₂) = ψ_fn U g₁ + ψ_fn U g₂ := by
      intro U g₁ g₂
      have : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
      let O_12 : ↥(Fgt.obj U).left → (Fgt.obj U).left.Opens :=
        fun x => O_x g₁ x ⊓ O_x g₂ x
      let W_12 : ↥(Fgt.obj U).left → Z.Etale :=
        fun x => CategoryTheory.MorphismProperty.Over.mk ⊤
          ((O_12 x).ι ≫ (Fgt.obj U).hom) inferInstance
      let u_12 : ∀ x, W_12 x ⟶ U :=
        fun x => CategoryTheory.MorphismProperty.Over.homMk (O_12 x).ι rfl trivial
      apply hSepArrows u_12 (fun x =>
        ⟨x, ⟨x, rfl, rfl⟩, AlgebraicGeometry.Scheme.Opens.ι_apply (O_12 x) ⟨x, rfl, rfl⟩⟩)
      intro x
      have hle₁ : O_12 x ≤ O_x g₁ x := inf_le_left
      have hle₂ : O_12 x ≤ O_x g₂ x := inf_le_right
      have hle₁₂ : O_12 x ≤ O_x (g₁ + g₂) x := by
        intro y hy
        change g₁ y + g₂ y = g₁ x + g₂ x
        rw [hy.1, hy.2]
      let i₁ : W_12 x ⟶ W_x g₁ x :=
        CategoryTheory.MorphismProperty.Over.homMk
          ((Fgt.obj U).left.homOfLE hle₁)
          ((CategoryTheory.Category.assoc ((Fgt.obj U).left.homOfLE hle₁)
            (O_x g₁ x).ι (Fgt.obj U).hom).symm.trans
            (congrArg (· ≫ (Fgt.obj U).hom) (AlgebraicGeometry.Scheme.homOfLE_ι _ hle₁)))
          trivial
      let i₂ : W_12 x ⟶ W_x g₂ x :=
        CategoryTheory.MorphismProperty.Over.homMk
          ((Fgt.obj U).left.homOfLE hle₂)
          ((CategoryTheory.Category.assoc ((Fgt.obj U).left.homOfLE hle₂)
            (O_x g₂ x).ι (Fgt.obj U).hom).symm.trans
            (congrArg (· ≫ (Fgt.obj U).hom) (AlgebraicGeometry.Scheme.homOfLE_ι _ hle₂)))
          trivial
      let i₁₂ : W_12 x ⟶ W_x (g₁ + g₂) x :=
        CategoryTheory.MorphismProperty.Over.homMk
          ((Fgt.obj U).left.homOfLE hle₁₂)
          ((CategoryTheory.Category.assoc ((Fgt.obj U).left.homOfLE hle₁₂)
            (O_x (g₁ + g₂) x).ι (Fgt.obj U).hom).symm.trans
            (congrArg (· ≫ (Fgt.obj U).hom) (AlgebraicGeometry.Scheme.homOfLE_ι _ hle₁₂)))
          trivial
      have hc₁ : i₁ ≫ u_x g₁ x = u_12 x :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (AlgebraicGeometry.Scheme.homOfLE_ι _ hle₁) (Subsingleton.elim _ _)
      have hc₂ : i₂ ≫ u_x g₂ x = u_12 x :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (AlgebraicGeometry.Scheme.homOfLE_ι _ hle₂) (Subsingleton.elim _ _)
      have hc₁₂ : i₁₂ ≫ u_x (g₁ + g₂) x = u_12 x :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (AlgebraicGeometry.Scheme.homOfLE_ι _ hle₁₂) (Subsingleton.elim _ _)
      have hL : (F_M.obj.map (u_12 x).op).hom (ψ_fn U (g₁ + g₂)) =
          (η.app (Opposite.op (W_12 x))).hom (g₁ x + g₂ x) := by
        rw [← hc₁₂, hF_comp, hψ_spec U (g₁ + g₂) x, hη_nat i₁₂ ((g₁ + g₂) x)]
        rfl
      have hR₁ : (F_M.obj.map (u_12 x).op).hom (ψ_fn U g₁) =
          (η.app (Opposite.op (W_12 x))).hom (g₁ x) := by
        rw [← hc₁, hF_comp, hψ_spec U g₁ x, hη_nat i₁ (g₁ x)]
      have hR₂ : (F_M.obj.map (u_12 x).op).hom (ψ_fn U g₂) =
          (η.app (Opposite.op (W_12 x))).hom (g₂ x) := by
        rw [← hc₂, hF_comp, hψ_spec U g₂ x, hη_nat i₂ (g₂ x)]
      rw [map_add, hL, hR₁, hR₂, map_add]
    let Ψ : L_sh ⟶ F_M :=
      { hom :=
          { app := fun U_op => AddCommGrpCat.ofHom
              { toFun := ψ_fn (Opposite.unop U_op)
                map_zero' := hψ_zero (Opposite.unop U_op)
                map_add' := hψ_add (Opposite.unop U_op) }
            naturality := fun {U₁_op U₂_op} v_op => by
              let U₁ := Opposite.unop U₁_op
              let U₂ := Opposite.unop U₂_op
              let v : U₂ ⟶ U₁ := v_op.unop
              ext g
              change ψ_fn U₂ (((L_pre Z M).map v.op).hom g) =
                (F_M.obj.map v.op).hom (ψ_fn U₁ g)
              symm
              apply hψ_uniq U₂ (((L_pre Z M).map v.op).hom g)
              intro x₂
              let g' := ((L_pre Z M).map v.op).hom g
              let x₁ := (Fgt.map v).left.base x₂
              let v_res : (O_x g' x₂).toScheme ⟶ (O_x g x₁).toScheme :=
                (Fgt.map v).left ∣_ O_x g x₁
              have hv_res_ι : v_res ≫ (O_x g x₁).ι = (O_x g' x₂).ι ≫ (Fgt.map v).left :=
                AlgebraicGeometry.morphismRestrict_ι (Fgt.map v).left (O_x g x₁)
              let v_et : W_x g' x₂ ⟶ W_x g x₁ :=
                CategoryTheory.MorphismProperty.Over.homMk v_res
                  ((CategoryTheory.Category.assoc v_res (O_x g x₁).ι (Fgt.obj U₁).hom).symm.trans
                    ((congrArg (· ≫ (Fgt.obj U₁).hom) hv_res_ι).trans
                      ((CategoryTheory.Category.assoc (O_x g' x₂).ι (Fgt.map v).left
                        (Fgt.obj U₁).hom).trans
                        (congrArg ((O_x g' x₂).ι ≫ ·)
                          (CategoryTheory.MorphismProperty.Over.w v)))))
                  trivial
              have hv_comm : u_x g' x₂ ≫ v = v_et ≫ u_x g x₁ :=
                CategoryTheory.MorphismProperty.Comma.Hom.ext hv_res_ι.symm (Subsingleton.elim _ _)
              calc
                (F_M.obj.map (u_x g' x₂).op).hom ((F_M.obj.map v.op).hom (ψ_fn U₁ g))
                  = (F_M.obj.map (u_x g' x₂ ≫ v).op).hom (ψ_fn U₁ g) :=
                      (hF_comp (u_x g' x₂) v (ψ_fn U₁ g)).symm
                _ = (F_M.obj.map (v_et ≫ u_x g x₁).op).hom (ψ_fn U₁ g) := by rw [hv_comm]
                _ = (F_M.obj.map v_et.op).hom ((F_M.obj.map (u_x g x₁).op).hom (ψ_fn U₁ g)) :=
                      hF_comp v_et (u_x g x₁) (ψ_fn U₁ g)
                _ = (F_M.obj.map v_et.op).hom ((η.app (Opposite.op (W_x g x₁))).hom (g x₁)) := by
                      rw [hψ_spec U₁ g x₁]
                _ = (η.app (Opposite.op (W_x g' x₂))).hom (g x₁) := hη_nat v_et (g x₁)
                _ = (η.app (Opposite.op (W_x g' x₂))).hom (g' x₂) := rfl } }
    have hκ_Ψ : κ ≫ Ψ.hom = η := by
      ext U_op m
      let U := Opposite.unop U_op
      change ψ_fn U (LocallyConstant.const _ m) = (η.app (Opposite.op U)).hom m
      symm
      exact hψ_uniq U (LocallyConstant.const _ m) ((η.app (Opposite.op U)).hom m)
        (fun x => hη_nat (u_x (LocallyConstant.const _ m) x) m)
    have hΦΨ : Φ ≫ Ψ = CategoryTheory.CategoryStruct.id F_M :=
      (adj_sh.homEquiv C_pre F_M).injective (by
        have hL : adj_sh.homEquiv C_pre F_M (Φ ≫ Ψ) = η ≫ (Φ.hom ≫ Ψ.hom) :=
          adj_sh.homEquiv_unit C_pre F_M (Φ ≫ Ψ)
        have hR : adj_sh.homEquiv C_pre F_M (CategoryTheory.CategoryStruct.id F_M) =
            η ≫ 𝟙 F_M.obj :=
          adj_sh.homEquiv_unit C_pre F_M (CategoryTheory.CategoryStruct.id F_M)
        exact hL.trans ((CategoryTheory.Category.assoc η Φ.hom Ψ.hom).symm.trans
          ((congrArg (· ≫ Ψ.hom) hη_Φ).trans (hκ_Ψ.trans
            ((CategoryTheory.Category.comp_id η).symm.trans hR.symm)))))
    have hΨΦ : Ψ ≫ Φ = CategoryTheory.CategoryStruct.id L_sh := by
      ext U_op g x
      let U := Opposite.unop U_op
      have h_nat := Φ.hom.naturality (u_x g x).op
      have hev : (((L_pre Z M).map (u_x g x).op).hom ((Φ.hom.app (Opposite.op U)).hom (ψ_fn U g)))
          ⟨x, rfl⟩ = (LocallyConstant.const ↥(Fgt.obj (W_x g x)).left (g x)) ⟨x, rfl⟩ := by
        have h1 : ((L_pre Z M).map (u_x g x).op).hom ((Φ.hom.app (Opposite.op U)).hom (ψ_fn U g)) =
            (Φ.hom.app (Opposite.op (W_x g x))).hom
              ((F_M.obj.map (u_x g x).op).hom (ψ_fn U g)) :=
          congrArg (fun α : F_M.obj.obj (Opposite.op U) ⟶ (L_pre Z M).obj (Opposite.op (W_x g x)) =>
            α.hom (ψ_fn U g)) h_nat.symm
        rw [h1, hψ_spec U g x]
        have h2 : (Φ.hom.app (Opposite.op (W_x g x))).hom
            ((η.app (Opposite.op (W_x g x))).hom (g x)) =
            (κ.app (Opposite.op (W_x g x))).hom (g x) :=
          congrArg (fun α : C_pre ⟶ L_pre Z M => (α.app (Opposite.op (W_x g x))).hom (g x)) hη_Φ
        rw [h2]
        rfl
      exact hev
    exact ⟨{ hom := Φ, inv := Ψ, hom_inv_id := hΦΨ, inv_hom_id := hΨΦ }⟩

  have hSpecExtract :
      ∀ (M₁ M₂ : AddCommGrpCat.{u}),
        let J_Ω := (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.constantSheaf J_Ω AddCommGrpCat.{u}).obj M₁)
          ((CategoryTheory.constantSheaf J_Ω AddCommGrpCat.{u}).obj M₂)) →
        Nonempty (↑M₁ ≃+ ↑M₂) := by
    intro M₁ M₂ J_Ω ⟨e_sh⟩
    let Z_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := weilEtaleIdTerminal.{u} Z_Ω
    obtain ⟨eL₁⟩ := hConstIsoL Z_Ω M₁
    obtain ⟨eL₂⟩ := hConstIsoL Z_Ω M₂
    let iso_T := ((CategoryTheory.sheafToPresheaf J_Ω AddCommGrpCat.{u}).mapIso
      (eL₁.symm ≪≫ e_sh ≪≫ eL₂)).app (Opposite.op T_Ω)
    let e_loc : LocallyConstant ↥T_Ω.left ↑M₁ ≃+ LocallyConstant ↥T_Ω.left ↑M₂ :=
      { toFun := iso_T.hom.hom
        invFun := iso_T.inv.hom
        left_inv := fun g =>
          congrArg (fun φ : (L_pre Z_Ω M₁).obj (Opposite.op T_Ω) ⟶ _ => φ.hom g) iso_T.hom_inv_id
        right_inv := fun g =>
          congrArg (fun φ : (L_pre Z_Ω M₂).obj (Opposite.op T_Ω) ⟶ _ => φ.hom g) iso_T.inv_hom_id
        map_add' := map_add iso_T.hom.hom }
    have : Unique ↥T_Ω.left := by
      change Unique (PrimeSpectrum Ω)
      infer_instance
    let ev₁ : LocallyConstant ↥T_Ω.left ↑M₁ ≃+ ↑M₁ :=
      { toFun := fun g => g default
        invFun := fun m => LocallyConstant.const ↥T_Ω.left m
        left_inv := fun g => LocallyConstant.ext fun pt => congrArg g (Subsingleton.elim default pt)
        right_inv := fun _ => rfl
        map_add' := fun _ _ => rfl }
    let ev₂ : LocallyConstant ↥T_Ω.left ↑M₂ ≃+ ↑M₂ :=
      { toFun := fun g => g default
        invFun := fun m => LocallyConstant.const ↥T_Ω.left m
        left_inv := fun g => LocallyConstant.ext fun pt => congrArg g (Subsingleton.elim default pt)
        right_inv := fun _ => rfl
        map_add' := fun _ _ => rfl }
    exact ⟨ev₁.symm.trans (e_loc.trans ev₂)⟩

  have hCohomPresheafZeroIso :
      ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty (CategoryTheory.Iso
          (CategoryTheory.Sheaf.cohomologyPresheaf F 0) F.obj) := by
    intro Z F
    let J := Z.smallEtaleTopology
    let ev_W : ∀ (W : Z.Etale)
        (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        (weilPolyP1CohomologyRepSheaf Z W ⟶ G) ≃ ↑(G.obj.obj (Opposite.op W)) :=
      fun W G => weilPolyP1CohomologyRepHomEquiv Z W G
    have hev_eq : ∀ (W : Z.Etale) (G : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (β : weilPolyP1CohomologyRepSheaf Z W ⟶ G),
        ev_W W G β =
          (β.hom.app (Opposite.op W)).hom
            (ev_W W (weilPolyP1CohomologyRepSheaf Z W)
              (CategoryTheory.CategoryStruct.id (weilPolyP1CohomologyRepSheaf Z W))) := by
      intro W G β
      let R_W := weilPolyP1CohomologyRepSheaf Z W
      dsimp [ev_W, weilPolyP1CohomologyRepHomEquiv]
      have h1 : ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ G) β =
          ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ R_W) (𝟙 R_W) ≫
            (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map β := by
        rw [← CategoryTheory.Adjunction.homEquiv_naturality_right, CategoryTheory.Category.id_comp]
      have h2 : (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
          (CategoryTheory.yoneda.obj W) G.obj)
          (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ R_W) (𝟙 R_W) ≫
            (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map β)) =
          (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
            (CategoryTheory.yoneda.obj W) R_W.obj)
            (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ R_W) (𝟙 R_W))) ≫
            (((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) AddCommGrpCat.{u} (Type u)).obj
              (CategoryTheory.forget AddCommGrpCat.{u})).map
              ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map β)) :=
        CategoryTheory.Adjunction.homEquiv_naturality_right _ _ _
      exact (congrArg (fun x => CategoryTheory.yonedaEquiv
        (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
          (CategoryTheory.yoneda.obj W) G.obj) x)) h1).trans
        (congrArg CategoryTheory.yonedaEquiv h2)
    let θ_equiv : ∀ W : Z.Etale,
        CategoryTheory.Abelian.Ext (weilPolyP1CohomologyRepSheaf Z W) F 0 ≃+
          ↑(F.obj.obj (Opposite.op W)) := fun W =>
      CategoryTheory.Abelian.Ext.addEquiv₀.trans
        { toEquiv := ev_W W F
          map_add' := fun β₁ β₂ => by
            change ev_W W F (β₁ + β₂) = ev_W W F β₁ + ev_W W F β₂
            rw [hev_eq W F (β₁ + β₂), hev_eq W F β₁, hev_eq W F β₂]
            have happ : (β₁ + β₂).hom.app (Opposite.op W) =
                β₁.hom.app (Opposite.op W) + β₂.hom.app (Opposite.op W) := by
              change (((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map (β₁ + β₂)).app
                (Opposite.op W)) = _
              rw [CategoryTheory.Functor.map_add, CategoryTheory.NatTrans.app_add]
              rfl
            rw [happ, AddCommGrpCat.hom_add_apply] }
    refine ⟨CategoryTheory.NatIso.ofComponents
      (fun W_op => AddEquiv.toAddCommGrpIso (θ_equiv (Opposite.unop W_op))) ?_⟩
    intro W₁_op W₂_op u_op
    let W₁ := Opposite.unop W₁_op
    let W₂ := Opposite.unop W₂_op
    let u : W₂ ⟶ W₁ := u_op.unop
    ext α
    let α' : CategoryTheory.Abelian.Ext (weilPolyP1CohomologyRepSheaf Z W₁) F 0 := α
    change ev_W W₂ F (CategoryTheory.Abelian.Ext.addEquiv₀
        (((CategoryTheory.Sheaf.cohomologyPresheaf F 0).map u.op).hom α')) =
      (F.obj.map u.op).hom (ev_W W₁ F (CategoryTheory.Abelian.Ext.addEquiv₀ α'))
    let ρ_u : weilPolyP1CohomologyRepSheaf Z W₂ ⟶ weilPolyP1CohomologyRepSheaf Z W₁ :=
      (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free)
    have hmap_eq : ((CategoryTheory.Sheaf.cohomologyPresheaf F 0).map u.op).hom α' =
        (CategoryTheory.Abelian.Ext.mk₀ ρ_u).comp α' (Nat.zero_add 0) := by
      change (((CategoryTheory.Abelian.extFunctor 0).map (Opposite.op ρ_u)).app F).hom α' = _
      rw [CategoryTheory.Abelian.extFunctor_map_app]
      rfl
    have hExt₀ : CategoryTheory.Abelian.Ext.addEquiv₀
        ((CategoryTheory.Abelian.Ext.mk₀ ρ_u).comp α' (Nat.zero_add 0)) =
        ρ_u ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α' := by
      calc
        CategoryTheory.Abelian.Ext.addEquiv₀
            ((CategoryTheory.Abelian.Ext.mk₀ ρ_u).comp α' (Nat.zero_add 0))
          = CategoryTheory.Abelian.Ext.addEquiv₀
              ((CategoryTheory.Abelian.Ext.mk₀ ρ_u).comp
                (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.addEquiv₀ α'))
                (Nat.zero_add 0)) := by
              rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
        _ = CategoryTheory.Abelian.Ext.addEquiv₀
              (CategoryTheory.Abelian.Ext.mk₀ (ρ_u ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α')) := by
              rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        _ = CategoryTheory.Abelian.Ext.addEquiv₀
              (CategoryTheory.Abelian.Ext.addEquiv₀.symm
                (ρ_u ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α')) := by
              rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        _ = ρ_u ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α' :=
              AddEquiv.apply_symm_apply _ _
    rw [hmap_eq, hExt₀]
    dsimp only [ev_W, weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_left
      (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u})]
    exact (congrArg CategoryTheory.yonedaEquiv
      (CategoryTheory.Adjunction.homEquiv_naturality_left
        (AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale))
        (CategoryTheory.yoneda.map u) _)).trans
      (CategoryTheory.yonedaEquiv_naturality _ u).symm

  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  have e_R0 : Nonempty (CategoryTheory.Iso
      (weilEtaleTorsionSheaf V ℓ)
      (weilEtaleHigherDirectImage f 0 (weilEtaleTorsionSheaf Y ℓ))) := by
    obtain ⟨e_V⟩ := hConstIsoL V AM
    obtain ⟨e_Y⟩ := hConstIsoL Y AM
    obtain ⟨θ_Y⟩ := hCohomPresheafZeroIso Y (weilEtaleTorsionSheaf Y ℓ)
    let e_pre_Y : CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf Y ℓ) 0 ≅
        weilAltLocConstPresheaf Y ℓ :=
      θ_Y ≪≫ (CategoryTheory.sheafToPresheaf Y.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_Y
    let e_pre_V : weilAltLocConstPresheaf V ℓ ≅
        (weilEtaleSitePullback f).op ⋙
          CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf Y ℓ) 0 :=
      CategoryTheory.asIso (weilAltLocConstPullbackNat f ℓ) ≪≫
        ((CategoryTheory.Functor.whiskeringLeft _ _ _).obj
          (weilEtaleSitePullback f).op).mapIso e_pre_Y.symm
    exact ⟨e_V ≪≫ CategoryTheory.sheafificationIso ⟨L_pre V AM, hSh_L V AM⟩ ≪≫
      (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).mapIso e_pre_V⟩

  have hNsmul : ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Y ℓ) = 0 := by
    let J_Y := Y.smallEtaleTopology
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let C_Y := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
    have : C_Y.IsLeftAdjoint :=
      ⟨_, ⟨CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y⟩⟩
    have : CategoryTheory.Limits.PreservesBinaryBiproducts C_Y :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts C_Y
    have : C_Y.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts C_Y
    have hAM : (ℓ • CategoryTheory.CategoryStruct.id AM : AM ⟶ AM) = 0 := by
      ext ⟨x⟩
      change ULift.up (ℓ • x) = ULift.up 0
      simp
    calc
      ℓ • CategoryTheory.CategoryStruct.id (C_Y.obj AM)
        = ℓ • C_Y.map (CategoryTheory.CategoryStruct.id AM) := by rw [C_Y.map_id]
      _ = C_Y.map (ℓ • CategoryTheory.CategoryStruct.id AM) := C_Y.map_nsmul.symm
      _ = C_Y.map 0 := by rw [hAM]
      _ = 0 := C_Y.map_zero AM AM

  have hConstPull :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂)
        (A : AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback h
          ((CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}).obj A)
          ((CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}).obj A) := by
    intro X₁ X₂ h A
    let _ := @hc_all X₁ X₂ h
    let _ := @hr_all X₁ X₂ h
    let B_h := weilEtaleSitePullback h
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let T₁ := weilEtaleIdTerminal.{u} X₁
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} X₁
    let T₂ := weilEtaleIdTerminal.{u} X₂
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} X₂
    let id_X₂ : X₂ ⟶ X₂ := CategoryTheory.CategoryStruct.id X₂
    let snd_T : CategoryTheory.Limits.pullback id_X₂ h ⟶ X₁ :=
      CategoryTheory.Limits.pullback.snd id_X₂ h
    let inv_snd : X₁ ⟶ CategoryTheory.Limits.pullback id_X₂ h :=
      CategoryTheory.Limits.pullback.lift h (CategoryTheory.CategoryStruct.id X₁)
        (by dsimp [id_X₂]; rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hsnd_inv : snd_T ≫ inv_snd =
        CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.pullback id_X₂ h) := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.id_comp]
        exact (CategoryTheory.Limits.pullback.condition (f := id_X₂) (g := h)).symm.trans
          (CategoryTheory.Category.comp_id _)
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    have hinv_snd : inv_snd ≫ snd_T = CategoryTheory.CategoryStruct.id X₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let iso_BT : B_h.obj T₂ ≅ T₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk
        { hom := snd_T, inv := inv_snd, hom_inv_id := hsnd_inv, inv_hom_id := hinv_snd }
        (CategoryTheory.Category.comp_id _)
    let hT_B : CategoryTheory.Limits.IsTerminal (B_h.obj T₂) :=
      CategoryTheory.Limits.IsTerminal.ofIso hT₁ iso_BT.symm
    let adj_comp := (CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂).comp adj_h
    let adj_B := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT_B
    let e_right :
        (pf_h ⋙ (CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj (Opposite.op T₂)) ≅
          (CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op (B_h.obj T₂)) :=
      { hom :=
          { app := fun G => CategoryTheory.CategoryStruct.id (G.obj.obj (Opposite.op (B_h.obj T₂)))
            naturality := fun _ _ φ =>
              (CategoryTheory.Category.comp_id (φ.hom.app (Opposite.op (B_h.obj T₂)))).trans
                (CategoryTheory.Category.id_comp (φ.hom.app (Opposite.op (B_h.obj T₂)))).symm }
        inv :=
          { app := fun G => CategoryTheory.CategoryStruct.id (G.obj.obj (Opposite.op (B_h.obj T₂)))
            naturality := fun _ _ φ =>
              (CategoryTheory.Category.comp_id (φ.hom.app (Opposite.op (B_h.obj T₂)))).trans
                (CategoryTheory.Category.id_comp (φ.hom.app (Opposite.op (B_h.obj T₂)))).symm }
        hom_inv_id := by ext G x; rfl
        inv_hom_id := by ext G x; rfl }
    let e_left := CategoryTheory.Adjunction.leftAdjointUniq
      (CategoryTheory.Adjunction.ofNatIsoRight adj_comp e_right) adj_B
    exact ⟨@hc_all X₁ X₂ h, @hr_all X₁ X₂ h, ⟨e_left.app A⟩⟩

  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let Y_Ω := CategoryTheory.Limits.pullback f s
  let g'_hom : Y_Ω ⟶ Y := CategoryTheory.Limits.pullback.fst f s
  let f'_hom : Y_Ω ⟶ S_Ω := CategoryTheory.Limits.pullback.snd f s
  let S_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk p_V
  have : AlgebraicGeometry.LocallyOfFiniteType S_ov.hom := ‹AlgebraicGeometry.LocallyOfFiniteType p_V›
  let X_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (f ≫ p_V)
  let S'_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (s ≫ p_V)
  let X'_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (f'_hom ≫ s ≫ p_V)
  let f_ov : X_ov ⟶ S_ov := CategoryTheory.Over.homMk f rfl
  let g_ov : S'_ov ⟶ S_ov := CategoryTheory.Over.homMk s rfl
  let f'_ov : X'_ov ⟶ S'_ov := CategoryTheory.Over.homMk f'_hom rfl
  let g'_ov : X'_ov ⟶ X_ov :=
    CategoryTheory.Over.homMk g'_hom
      (by
        change g'_hom ≫ (f ≫ p_V) = f'_hom ≫ (s ≫ p_V)
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc])
  have hPBC_0 : WeilIsEtaleSheafPullback s
      (weilEtaleHigherDirectImage f 0 (weilEtaleTorsionSheaf Y ℓ))
      (weilEtaleHigherDirectImage f'_hom 0 (weilEtaleTorsionSheaf Y_Ω ℓ)) :=
    hPBC X_ov S_ov S'_ov X'_ov f_ov g_ov f'_ov g'_ov
      ‹AlgebraicGeometry.IsProper f›
      (CategoryTheory.IsPullback.of_hasPullback f s)
      (weilEtaleTorsionSheaf Y ℓ) (weilEtaleTorsionSheaf Y_Ω ℓ)
      hNsmul (hConstPull g'_hom AM) 0
  let MH := AddCommGrpCat.of (weilEtaleTorsionH Y_Ω ℓ 0)
  obtain ⟨e_R0_iso⟩ := e_R0
  obtain ⟨e_spec⟩ := hSpecR0 Ω Y_Ω f'_hom
  obtain ⟨hc₁, hr₁, ⟨e_pbc⟩⟩ := hPBC_0
  obtain ⟨hc₂, hr₂, ⟨e_const_s⟩⟩ := hConstPull s AM
  have hc_eq : hc₁ = hc₂ := Subsingleton.elim _ _
  subst hc_eq
  have hr_eq : hr₁ = hr₂ := Subsingleton.elim _ _
  subst hr_eq
  let _ := hc₁
  let _ := hr₁
  let pb_s := (weilEtaleSitePullback s).sheafPullback
    AddCommGrpCat.{u} V.smallEtaleTopology S_Ω.smallEtaleTopology
  let e_const_Ω :
      ((CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}).obj AM) ≅
        ((CategoryTheory.constantSheaf S_Ω.smallEtaleTopology AddCommGrpCat.{u}).obj MH) :=
    e_const_s.symm ≪≫ pb_s.mapIso e_R0_iso ≪≫ e_pbc ≪≫ e_spec
  obtain ⟨e_grp⟩ := hSpecExtract AM MH ⟨e_const_Ω⟩
  have hCard : Nat.card (weilEtaleTorsionH Y_Ω ℓ 0) = ℓ := by
    calc
      Nat.card (weilEtaleTorsionH Y_Ω ℓ 0)
        = Nat.card (ULift.{u} (ZMod ℓ)) := (Nat.card_congr e_grp.toEquiv).symm
      _ = Nat.card (ZMod ℓ) := Nat.card_congr Equiv.ulift
      _ = ℓ := Nat.card_zmod ℓ
  exact (hCardConn Y_Ω).mpr hCard

theorem weil_etale_rel_curve_cover_geom_irred_and_pkg_assembly (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
    (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [Algebra k B₀] [Algebra.FiniteType k B₀]
    (τ_B₀ : B₀ →ₐ[k] k)
    (u_B₀ : MvPolynomial (Fin δ) k →ₐ[k] B₀)
    (hu_B₀ : RingHom.Etale u_B₀.toRingHom)
    (g_B₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₀))
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_cur.V).left)
    (hg_B₀_et : AlgebraicGeometry.Etale g_B₀)
    (hg_B₀_pt : ∀ pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
      g_B₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₀.toRingHom)).base pt_k) =
        P_cur.v)
    (hg_B₀_u : CategoryTheory.CategoryStruct.comp g_B₀
      (CategoryTheory.CategoryStruct.comp
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map P_cur.g_V).left
        E.u_V₁) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom u_B₀.toRingHom))
    (Y_raw : AlgebraicGeometry.Scheme.{u})
    (ν : Quiver.Hom Y_raw (CategoryTheory.Limits.pullback P_cur.f_bar g_B₀))
    [AlgebraicGeometry.IsFinite ν]
    [AlgebraicGeometry.Etale ν]
    [AlgebraicGeometry.Surjective ν]
    (hIrred_raw₀ : IrreducibleSpace ↥(CategoryTheory.Limits.pullback
      (CategoryTheory.CategoryStruct.comp ν
        (CategoryTheory.Limits.pullback.snd P_cur.f_bar g_B₀))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₀.toRingHom)))) :
    ∃ (P_next : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
      (h_V : Quiver.Hom P_next.V P_cur.V)
      (h_Y : Quiver.Hom P_next.Y P_cur.Y)
      (h_W : Quiver.Hom P_next.W P_cur.W)
      (q_raw : Quiver.Hom P_next.Y Y_raw)
      (h_V_B₀ : Quiver.Hom
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P_next.V).left
        (AlgebraicGeometry.Spec (CommRingCat.of B₀))),
      (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left.base P_next.v =
          P_cur.v ∧
        CategoryTheory.CategoryStruct.comp h_Y P_cur.f_bar =
          CategoryTheory.CategoryStruct.comp P_next.f_bar
            (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left) ∧
        CategoryTheory.CategoryStruct.comp h_W P_cur.u_W = P_next.u_W ∧
        (TopologicalSpace.Opens.map h_Y.base).obj P_cur.W_open = P_next.W_open ∧
        CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map h_W).left)
            (CategoryTheory.CategoryStruct.comp P_cur.e_W.hom P_cur.W_open.ι) =
          CategoryTheory.CategoryStruct.comp P_next.e_W.hom
            (CategoryTheory.CategoryStruct.comp P_next.W_open.ι h_Y)) ∧
      CategoryTheory.CategoryStruct.comp q_raw
        (CategoryTheory.CategoryStruct.comp ν
          (CategoryTheory.Limits.pullback.fst P_cur.f_bar g_B₀)) = h_Y ∧
      CategoryTheory.CategoryStruct.comp h_V_B₀ g_B₀ =
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left ∧
      CategoryTheory.CategoryStruct.comp q_raw
        (CategoryTheory.CategoryStruct.comp ν
          (CategoryTheory.Limits.pullback.snd P_cur.f_bar g_B₀)) =
        CategoryTheory.CategoryStruct.comp P_next.f_bar h_V_B₀ ∧
      (∀ pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)),
        h_V_B₀.base P_next.v =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₀.toRingHom)).base pt_k) :=
by
  classical
  have _ : (ℓ : k) ≠ 0 ∧ WeilSmoothProjCurveModPrimeCohHolds k ℓ := ⟨hℓ, hCurveCoh⟩
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let V_cur : AlgebraicGeometry.Scheme.{u} := (Fgt_V.obj P_cur.V).left
  let V₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B₀)
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hNe_k : Nonempty ↥S_k :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := k)).mpr inferInstance
  let pt_k : ↥S_k := Classical.choice hNe_k

  have : AlgebraicGeometry.IsProper E.Y_bar.hom := E.hProp_Ybar
  have : AlgebraicGeometry.IsProper E.V_bar.hom := E.hProp_Vbar
  have : AlgebraicGeometry.IsAffine V_cur := P_cur.hAff_V
  have : AlgebraicGeometry.Etale (Fgt_V.obj P_cur.V).hom := P_cur.V.prop
  have : AlgebraicGeometry.Etale (Fgt_Y.obj P_cur.W).hom := P_cur.W.prop
  have : AlgebraicGeometry.IsAffine P_cur.W_open.toScheme := P_cur.hAff_Wopen
  have : AlgebraicGeometry.IsAffine (Fgt_Y.obj P_cur.W).left :=
    AlgebraicGeometry.IsAffine.of_isIso P_cur.e_W.hom
  have : AlgebraicGeometry.Etale g_B₀ := hg_B₀_et
  have : AlgebraicGeometry.IsProper P_cur.f_bar := P_cur.hProp_f
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 P_cur.f_bar := P_cur.hSm_f
  have hIrred_V₀ : IrreducibleSpace ↥V₀ := by
    change IrreducibleSpace (PrimeSpectrum B₀)
    infer_instance
  have : IrreducibleSpace ↥V₀ := hIrred_V₀
  have hConnOfIrred : ∀ {α : Type u} [TopologicalSpace α],
      IrreducibleSpace α → ConnectedSpace α :=
    fun h => @ConnectedSpace.mk _ _
      ⟨fun u v hu hv _ h₁ h₂ => h.isIrreducible_univ.isPreirreducible u v hu hv h₁ h₂⟩
      h.toNonempty
  have : ConnectedSpace ↥V₀ := hConnOfIrred hIrred_V₀

  obtain ⟨hShrink_k, hSmConnInt_k⟩ :=
    weil_algClosed_smooth_etale_local_domain_and_connected_integral k
  obtain ⟨hSecOfClosed, hClosedOfSec, hSecEq, hEtLiftClosed⟩ :=
    weil_algClosed_affine_closed_point_section_and_pullback_lift k
  obtain ⟨hCardConn, hCurveIntOfConn, _⟩ :=
    weil_smooth_proj_curve_fiber_integral_and_projective k ℓ
  have hSpecR0 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Y_Ω : AlgebraicGeometry.Scheme.{u})
      (f' : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
      Nonempty (CategoryTheory.Iso
        (weilEtaleHigherDirectImage f' 0 (weilEtaleTorsionSheaf Y_Ω ℓ))
        ((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (weilEtaleTorsionH Y_Ω ℓ 0)))) :=
    fun Ω _ _ Y_Ω f' =>
      (weil_algClosed_nullstellensatz_section_and_spec_constant_sheaf Ω).2 Y_Ω f' ℓ 0
  obtain ⟨hc_all, hr_all, hSite⟩ :=
    weil_etale_site_pullback_rightAdjoint_and_exact_package.{u}

  
  have hConnOfIso :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (e : X ≅ Y),
        ConnectedSpace ↥Y → ConnectedSpace ↥X := by
    intro X Y e hY
    have hUniv : (Set.univ : Set ↥X) = e.inv.base '' (Set.univ : Set ↥Y) := by
      ext x
      refine ⟨fun _ => ⟨e.hom.base x, trivial, ?_⟩, fun _ => trivial⟩
      change (e.hom ≫ e.inv).base x = x
      rw [e.hom_inv_id]
      rfl
    have hPre : _root_.IsPreconnected (Set.univ : Set ↥X) := by
      rw [hUniv]
      exact (@isPreconnected_univ ↥Y _ hY.toPreconnectedSpace).image
        e.inv.base e.inv.continuous.continuousOn
    exact @ConnectedSpace.mk ↥X _ ⟨hPre⟩ ⟨e.inv.base (Classical.choice hY.toNonempty)⟩

  have hClosedPreOpen :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (j : X ⟶ Y) [AlgebraicGeometry.IsOpenImmersion j]
        (x : ↥X), IsClosed ({j.base x} : Set ↥Y) → IsClosed ({x} : Set ↥X) := by
    intro X Y j _ x hx
    have hpre : ({x} : Set ↥X) = j.base ⁻¹' ({j.base x} : Set ↥Y) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      exact ⟨fun h => congrArg j.base h, fun h => j.isOpenEmbedding.injective h⟩
    rw [hpre]
    exact hx.preimage j.continuous

  have hRangeSingletonComp :
      ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (b : ↥B),
        Set.range f.base = {b} → Set.range (f ≫ g).base = {g.base b} := by
    intro A B C f g b hf
    have hb_mem : b ∈ Set.range f.base := by rw [hf]; exact Set.mem_singleton b
    obtain ⟨a₀, ha₀⟩ := hb_mem
    ext c
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨a, rfl⟩
      have hfa : f.base a = b := by
        have hm : f.base a ∈ ({b} : Set ↥B) := by rw [← hf]; exact ⟨a, rfl⟩
        exact Set.mem_singleton_iff.mp hm
      change g.base (f.base a) = g.base b
      rw [hfa]
    · rintro rfl
      refine ⟨a₀, ?_⟩
      change g.base (f.base a₀) = g.base b
      rw [ha₀]

  have hConnOfFib :
      ∀ {Y S : AlgebraicGeometry.Scheme.{u}} [ConnectedSpace ↥S]
        (f : Y ⟶ S) [AlgebraicGeometry.IsProper f]
        [AlgebraicGeometry.Flat f] [AlgebraicGeometry.LocallyOfFinitePresentation f]
        (F : Type u) [Field F]
        (s : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ S),
        ConnectedSpace ↥(CategoryTheory.Limits.pullback f s) →
        ConnectedSpace ↥Y := by
    intro Y S _ f _ _ _ F _ s hConn_fib
    have hNe : Nonempty ↥Y :=
      ⟨(CategoryTheory.Limits.pullback.fst f s).base (Classical.choice hConn_fib.toNonempty)⟩
    have : AlgebraicGeometry.UniversallyOpen f := AlgebraicGeometry.UniversallyOpen.of_flat f
    have hOpen : IsOpenMap f.base := f.isOpenMap
    have hClosed : IsClosedMap f.base := f.isClosedMap
    have hPre : PreconnectedSpace ↥Y := by
      rw [preconnectedSpace_iff_clopen]
      intro C hC
      by_contra h
      push Not at h
      obtain ⟨hC_ne, hC_univ⟩ := h
      obtain ⟨y₁, hy₁⟩ := hC_ne
      obtain ⟨y₂, hy₂⟩ := Set.nonempty_compl.mpr hC_univ
      have hImC : f.base '' C = Set.univ :=
        IsClopen.eq_univ ⟨hClosed C hC.isClosed, hOpen C hC.isOpen⟩ ⟨f.base y₁, y₁, hy₁, rfl⟩
      have hImCc : f.base '' Cᶜ = Set.univ :=
        IsClopen.eq_univ ⟨hClosed Cᶜ hC.compl.isClosed, hOpen Cᶜ hC.compl.isOpen⟩
          ⟨f.base y₂, y₂, hy₂, rfl⟩
      have hNe_F : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) :=
        (PrimeSpectrum.nonempty_iff_nontrivial (R := F)).mpr inferInstance
      let pt_F : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := Classical.choice hNe_F
      have hs₁ : s.base pt_F ∈ f.base '' C := by rw [hImC]; trivial
      have hs₂ : s.base pt_F ∈ f.base '' Cᶜ := by rw [hImCc]; trivial
      obtain ⟨u₀, hu₀, hfu₀⟩ := hs₁
      obtain ⟨v₀, hv₀, hfv₀⟩ := hs₂
      obtain ⟨z₁, hz₁_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u₀ pt_F hfu₀
      obtain ⟨z₂, hz₂_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v₀ pt_F hfv₀
      let fst := CategoryTheory.Limits.pullback.fst f s
      have hPre_C : fst.base ⁻¹' C = Set.univ :=
        IsClopen.eq_univ (hC.preimage fst.continuous)
          ⟨z₁, by rw [Set.mem_preimage, hz₁_fst]; exact hu₀⟩
      have hz₂_in : z₂ ∈ fst.base ⁻¹' C := by rw [hPre_C]; trivial
      rw [Set.mem_preimage, hz₂_fst] at hz₂_in
      exact hv₀ hz₂_in
    exact @ConnectedSpace.mk ↥Y _ hPre hNe

  have hRelComp :
      ∀ {Y₂ Y₁ Y₀ V₂ V₁ V₀ : AlgebraicGeometry.Scheme.{u}}
        (f₂ : Y₂ ⟶ V₂) (f₁ : Y₁ ⟶ V₁) (f₀ : Y₀ ⟶ V₀)
        (h₂₁ : Y₂ ⟶ Y₁) (h₁₀ : Y₁ ⟶ Y₀)
        (g₂₁ : V₂ ⟶ V₁) (g₁₀ : V₁ ⟶ V₀)
        (hC₂₁ : h₂₁ ≫ f₁ = f₂ ≫ g₂₁)
        (hC₁₀ : h₁₀ ≫ f₀ = f₁ ≫ g₁₀)
        (hC₂₀ : (h₂₁ ≫ h₁₀) ≫ f₀ = f₂ ≫ (g₂₁ ≫ g₁₀)),
        let φ₂₁ := CategoryTheory.Limits.pullback.lift h₂₁ f₂ hC₂₁
        let φ₁₀ := CategoryTheory.Limits.pullback.lift h₁₀ f₁ hC₁₀
        let φ₂₀ := CategoryTheory.Limits.pullback.lift (h₂₁ ≫ h₁₀) f₂ hC₂₀
        (AlgebraicGeometry.IsFinite φ₂₁ → AlgebraicGeometry.IsFinite φ₁₀ →
          AlgebraicGeometry.IsFinite φ₂₀) ∧
        (AlgebraicGeometry.Etale φ₂₁ → AlgebraicGeometry.Etale φ₁₀ →
          AlgebraicGeometry.Etale φ₂₀) ∧
        (AlgebraicGeometry.Surjective φ₂₁ → AlgebraicGeometry.Surjective φ₁₀ →
          AlgebraicGeometry.Surjective φ₂₀) := by
    intro Y₂ Y₁ Y₀ V₂ V₁ V₀ f₂ f₁ f₀ h₂₁ h₁₀ g₂₁ g₁₀ hC₂₁ hC₁₀ hC₂₀
    dsimp only
    let φ₂₁ := CategoryTheory.Limits.pullback.lift h₂₁ f₂ hC₂₁
    let φ₁₀ := CategoryTheory.Limits.pullback.lift h₁₀ f₁ hC₁₀
    let φ₂₀ := CategoryTheory.Limits.pullback.lift (h₂₁ ≫ h₁₀) f₂ hC₂₀
    let q_base : CategoryTheory.Limits.pullback f₀ (g₂₁ ≫ g₁₀) ⟶
        CategoryTheory.Limits.pullback f₀ g₁₀ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f₀ (g₂₁ ≫ g₁₀))
        (CategoryTheory.Limits.pullback.snd f₀ (g₂₁ ≫ g₁₀) ≫ g₂₁)
        (by rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc])
    have hq_fst : q_base ≫ CategoryTheory.Limits.pullback.fst f₀ g₁₀ =
        CategoryTheory.Limits.pullback.fst f₀ (g₂₁ ≫ g₁₀) :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hq_snd : q_base ≫ CategoryTheory.Limits.pullback.snd f₀ g₁₀ =
        CategoryTheory.Limits.pullback.snd f₀ (g₂₁ ≫ g₁₀) ≫ g₂₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_q : CategoryTheory.IsPullback q_base
        (CategoryTheory.Limits.pullback.snd f₀ (g₂₁ ≫ g₁₀))
        (CategoryTheory.Limits.pullback.snd f₀ g₁₀) g₂₁ :=
      CategoryTheory.IsPullback.of_right
        (by
          rw [hq_fst]
          exact CategoryTheory.IsPullback.of_hasPullback f₀ (g₂₁ ≫ g₁₀))
        hq_snd
        (CategoryTheory.IsPullback.of_hasPullback f₀ g₁₀)
    let ψ_mid : CategoryTheory.Limits.pullback f₁ g₂₁ ⟶
        CategoryTheory.Limits.pullback f₀ (g₂₁ ≫ g₁₀) :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f₁ g₂₁ ≫ h₁₀)
        (CategoryTheory.Limits.pullback.snd f₁ g₂₁)
        (by
          rw [CategoryTheory.Category.assoc, hC₁₀, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc])
    have hψ_fst : ψ_mid ≫ CategoryTheory.Limits.pullback.fst f₀ (g₂₁ ≫ g₁₀) =
        CategoryTheory.Limits.pullback.fst f₁ g₂₁ ≫ h₁₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hψ_snd : ψ_mid ≫ CategoryTheory.Limits.pullback.snd f₀ (g₂₁ ≫ g₁₀) =
        CategoryTheory.Limits.pullback.snd f₁ g₂₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hφ₁₀_fst : φ₁₀ ≫ CategoryTheory.Limits.pullback.fst f₀ g₁₀ = h₁₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hφ₁₀_snd : φ₁₀ ≫ CategoryTheory.Limits.pullback.snd f₀ g₁₀ = f₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hcomm_mid : CategoryTheory.Limits.pullback.fst f₁ g₂₁ ≫ φ₁₀ = ψ_mid ≫ q_base := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hφ₁₀_fst, CategoryTheory.Category.assoc,
          hq_fst, hψ_fst]
      · rw [CategoryTheory.Category.assoc, hφ₁₀_snd,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          hq_snd, ← CategoryTheory.Category.assoc, hψ_snd]
    have hPb_mid : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f₁ g₂₁) ψ_mid φ₁₀ q_base :=
      CategoryTheory.IsPullback.of_bot
        (by
          rw [hψ_snd, hφ₁₀_snd]
          exact CategoryTheory.IsPullback.of_hasPullback f₁ g₂₁)
        hcomm_mid
        hPb_q
    have hfac : φ₂₀ = φ₂₁ ≫ ψ_mid := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          hψ_fst, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          hψ_snd, CategoryTheory.Limits.pullback.lift_snd]
    refine ⟨fun hF₂₁ hF₁₀ => ?_, fun hE₂₁ hE₁₀ => ?_, fun hS₂₁ hS₁₀ => ?_⟩
    · have : AlgebraicGeometry.IsFinite φ₂₁ := hF₂₁
      have : AlgebraicGeometry.IsFinite ψ_mid :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_mid hF₁₀
      change AlgebraicGeometry.IsFinite φ₂₀
      rw [hfac]; infer_instance
    · have : AlgebraicGeometry.Etale φ₂₁ := hE₂₁
      have : AlgebraicGeometry.Etale ψ_mid :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_mid hE₁₀
      change AlgebraicGeometry.Etale φ₂₀
      rw [hfac]; infer_instance
    · have : AlgebraicGeometry.Surjective φ₂₁ := hS₂₁
      have : AlgebraicGeometry.Surjective ψ_mid :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_mid hS₁₀
      change AlgebraicGeometry.Surjective φ₂₀
      rw [hfac]; infer_instance

  
  let p_V₀ : V₀ ⟶ S_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₀))
