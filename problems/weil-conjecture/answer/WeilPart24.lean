             (Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀₁) (A := S'₀_ov) (B := S'₁_ov)))
           (Algebra.TensorProduct.includeRight (R := R'₀₁)
             (A := TensorProduct R'₀₁ S'₀_ov S'₁_ov) (B := S'₁_ov))
           (fun _ _ =>
             @Commute.all (TensorProduct R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₁_ov) S'₁_ov) _ _ _)
       let q₀₁₁_₂₃ : TensorProduct R'₀₁ S'₁_ov S'₁_ov →ₐ[R'₀₁]
           TensorProduct R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₁_ov) S'₁_ov :=
         Algebra.TensorProduct.lift
           ((Algebra.TensorProduct.includeLeft (R := R'₀₁) (S := R'₀₁)
             (A := TensorProduct R'₀₁ S'₀_ov S'₁_ov) (B := S'₁_ov)).comp
             (Algebra.TensorProduct.includeRight (R := R'₀₁) (A := S'₀_ov) (B := S'₁_ov)))
           (Algebra.TensorProduct.includeRight (R := R'₀₁)
             (A := TensorProduct R'₀₁ S'₀_ov S'₁_ov) (B := S'₁_ov))
           (fun _ _ =>
             @Commute.all (TensorProduct R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₁_ov) S'₁_ov) _ _ _)
       p₀_₁₃ (g₀₀ : TensorProduct R'₀ S'₀ S'₀) =
         p₀_₁₂ (g₀₀ : TensorProduct R'₀ S'₀ S'₀) * p₀_₂₃ (g₀₀ : TensorProduct R'₀ S'₀ S'₀) ∧
       p₁_₁₃ (g₁₁ : TensorProduct R'₁ S'₁ S'₁) =
         p₁_₁₂ (g₁₁ : TensorProduct R'₁ S'₁ S'₁) * p₁_₂₃ (g₁₁ : TensorProduct R'₁ S'₁ S'₁) ∧
       (g₀₀ : TensorProduct R'₀ S'₀ S'₀) ^ ℓ * ((v₀ : S'₀) ⊗ₜ[R'₀] (1 : S'₀)) =
         (1 : S'₀) ⊗ₜ[R'₀] (v₀ : S'₀) ∧
       (g₁₁ : TensorProduct R'₁ S'₁ S'₁) ^ ℓ * ((v₁ : S'₁) ⊗ₜ[R'₁] (1 : S'₁)) =
         (1 : S'₁) ⊗ₜ[R'₁] (v₁ : S'₁) ∧
       (g₀₁ : TensorProduct R'₀₁ S'₀_ov S'₁_ov) ^ ℓ *
           (((1 : R'₀₁) ⊗ₜ[R'₀] (v₀ : S'₀)) ⊗ₜ[R'₀₁] (1 : S'₁_ov)) =
         algebraMap R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₁_ov) (u'_div : R'₀₁) *
           ((1 : S'₀_ov) ⊗ₜ[R'₀₁] ((1 : R'₀₁) ⊗ₜ[R'₁] (v₁ : S'₁))) ∧
       q₀₀₁_₁₃ (g₀₁ : TensorProduct R'₀₁ S'₀_ov S'₁_ov) =
         q₀₀₁_₁₂ (map₀₀ (g₀₀ : TensorProduct R'₀ S'₀ S'₀)) *
           q₀₀₁_₂₃ (g₀₁ : TensorProduct R'₀₁ S'₀_ov S'₁_ov) ∧
       q₀₁₁_₁₃ (g₀₁ : TensorProduct R'₀₁ S'₀_ov S'₁_ov) =
         q₀₁₁_₁₂ (g₀₁ : TensorProduct R'₀₁ S'₀_ov S'₁_ov) *
           q₀₁₁_₂₃ (map₁₁ (g₁₁ : TensorProduct R'₁ S'₁ S'₁))) :=
by
  obtain ⟨I, Q, ι_inj, π_inj, hEpi_π, s_tilde₀, s_tilde₁, q_η,
    hSecInj, hSecKer, hq_nat, hs₀_π, hs₁_π, hov_diff⟩ :=
    weil_two_open_gm_injective_divisible_mv_lift Y' ℓ U'_in U'_out hU'_cov
      hGmSheaf u'_div ξ_Y' hDiv_ξ hChar_ξ
  have : CategoryTheory.Epi π_inj := hEpi_π

  let V_Spec₀ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ hAff_in.fromSpec
    (inferInstance : AlgebraicGeometry.Etale hAff_in.fromSpec)
  obtain ⟨S'₀, instComm₀, instAlg₀, hEtAlg₀, hFF₀, hEt_0, σ₀, hσ₀_raw⟩ :=
    weil_etale_sheaf_epi_affine_product_cover_lift Y' I Q π_inj U'_in hAff_in (q_η V_Spec₀)

  let V_Spec₁ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ hAff_out.fromSpec
    (inferInstance : AlgebraicGeometry.Etale hAff_out.fromSpec)
  obtain ⟨S'₁, instComm₁, instAlg₁, hEtAlg₁, hFF₁, hEt_1, σ₁, hσ₁_raw⟩ :=
    weil_etale_sheaf_epi_affine_product_cover_lift Y' I Q π_inj U'_out hAff_out (q_η V_Spec₁)

  letI : CommRing S'₀ := instComm₀
  letI : CommRing S'₁ := instComm₁
  letI : Algebra ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀ := instAlg₀
  letI : Algebra ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁ := instAlg₁
  have : Algebra.Etale ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀ := hEtAlg₀
  have : Algebra.Etale ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁ := hEtAlg₁

  let φ₀ : Y'.presheaf.obj (Opposite.op U'_in) ⟶ CommRingCat.of S'₀ :=
    CommRingCat.ofHom (algebraMap ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀)
  let E_0 : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (AlgebraicGeometry.Spec.map φ₀ ≫ hAff_in.fromSpec) hEt_0
  let mor₀ : E_0 ⟶ V_Spec₀ :=
    CategoryTheory.MorphismProperty.Over.homMk (AlgebraicGeometry.Spec.map φ₀) rfl
  have hσ₀ : (π_inj.hom.app (Opposite.op E_0)).hom σ₀ = q_η E_0 :=
    hσ₀_raw.trans (hq_nat mor₀)

  let φ₁ : Y'.presheaf.obj (Opposite.op U'_out) ⟶ CommRingCat.of S'₁ :=
    CommRingCat.ofHom (algebraMap ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁)
  let E_1 : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
    (AlgebraicGeometry.Spec.map φ₁ ≫ hAff_out.fromSpec) hEt_1
  let mor₁ : E_1 ⟶ V_Spec₁ :=
    CategoryTheory.MorphismProperty.Over.homMk (AlgebraicGeometry.Spec.map φ₁) rfl
  have hσ₁ : (π_inj.hom.app (Opposite.op E_1)).hom σ₁ = q_η E_1 :=
    hσ₁_raw.trans (hq_nat mor₁)

  obtain ⟨v₀, v₁, g₀₀, g₁₁, g₀₁, hCocycles⟩ :=
    weil_two_open_affine_etale_cocycle_from_sheaf_lifts Y' ℓ U'_in U'_out
      hAff_in hAff_out hAff_ov u'_div I Q ι_inj π_inj s_tilde₀ s_tilde₁ q_η
      hSecInj hSecKer (@hq_nat) hs₀_π hs₁_π hov_diff
      S'₀ S'₁ hEt_0 hEt_1 σ₀ σ₁ hσ₀ hσ₁

  exact ⟨S'₀, S'₁, instComm₀, instComm₁, instAlg₀, instAlg₁,
    v₀, v₁, g₀₀, g₁₁, g₀₁, hEtAlg₀, hFF₀, hEtAlg₁, hFF₁, hCocycles⟩

theorem weil_proper_boundary_semilocal_cocycle_base_shrink (V' Y' : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V'] [AlgebraicGeometry.IsIntegral V']
    (v'₀ : ↥V') (hv'₀_cl : IsClosed ({v'₀} : Set ↥V'))
    (f' : Quiver.Hom Y' V') [AlgebraicGeometry.IsProper f']
    (m : ℕ) (hm : 1 ≤ m)
    (τ' : Fin m → Quiver.Hom V' Y')
    (hτ'_sec : ∀ a : Fin m, CategoryTheory.CategoryStruct.comp (τ' a) f' =
      CategoryTheory.CategoryStruct.id V')
    (hτ'_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ' a))
    (U'_in U'_out : Y'.Opens)
    (hAff_in : AlgebraicGeometry.IsAffineOpen U'_in)
    (hAff_out : AlgebraicGeometry.IsAffineOpen U'_out)
    (hU'_cov : U'_out ⊔ U'_in = ⊤)
    (hU'_in_compl : (U'_in : Set ↥Y') = (⋃ a : Fin m, Set.range (τ' a).base)ᶜ)
    (S'₁ : Type u) [CommRing S'₁]
    [Algebra ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁]
    [Module.FaithfullyFlat ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁]
    (g₁₁ : Units (TensorProduct ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁ S'₁))
    (hg₁₁_cocycle :
      let R'₁ := ↑(Y'.presheaf.obj (Opposite.op U'_out))
      letI : CommRing R'₁ := inferInstance
      letI : Algebra R'₁ S'₁ := inferInstance
      let p₁₂ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁]
          TensorProduct R'₁ (TensorProduct R'₁ S'₁ S'₁) S'₁ :=
        Algebra.TensorProduct.includeLeft
      let p₁₃ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁]
          TensorProduct R'₁ (TensorProduct R'₁ S'₁ S'₁) S'₁ :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      let p₂₃ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁]
          TensorProduct R'₁ (TensorProduct R'₁ S'₁ S'₁) S'₁ :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      p₁₃ (g₁₁ : TensorProduct R'₁ S'₁ S'₁) =
        p₁₂ (g₁₁ : TensorProduct R'₁ S'₁ S'₁) * p₂₃ (g₁₁ : TensorProduct R'₁ S'₁ S'₁))
    (hH90 :
      ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] [Module.FaithfullyFlat R T]
        (g : Units (TensorProduct R T T)),
      let p₁₂ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
        Algebra.TensorProduct.includeLeft
      let p₁₃ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      let p₂₃ : TensorProduct R T T →ₐ[R] TensorProduct R (TensorProduct R T T) T :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      p₁₃ (g : TensorProduct R T T) =
        p₁₂ (g : TensorProduct R T T) * p₂₃ (g : TensorProduct R T T) →
      ∃ (L : Type u) (_ : AddCommGroup L) (_ : Module R L) (_ : Module.Invertible R L)
        (e : TensorProduct R T L ≃ₗ[T] T),
        (∀ x : L,
          ((1 : T) ⊗ₜ[R] (e ((1 : T) ⊗ₜ[R] x)) : TensorProduct R T T) =
            (g : TensorProduct R T T) * ((e ((1 : T) ⊗ₜ[R] x)) ⊗ₜ[R] (1 : T))) ∧
        Function.Injective (fun x : L => e ((1 : T) ⊗ₜ[R] x)) ∧
        (∀ t : T,
          ((1 : T) ⊗ₜ[R] t : TensorProduct R T T) =
            (g : TensorProduct R T T) * (t ⊗ₜ[R] (1 : T)) →
          ∃ x : L, e ((1 : T) ⊗ₜ[R] x) = t)) :
    ∃ (V_sh : AlgebraicGeometry.Scheme.{u})
      (j_Vsh : Quiver.Hom V_sh V')
      (v_sh : ↥V_sh)
      (Y_sh : AlgebraicGeometry.Scheme.{u})
      (j_Ysh : Quiver.Hom Y_sh Y')
      (f_sh : Quiver.Hom Y_sh V_sh)
      (U_0 U_1 : Y_sh.Opens),
      AlgebraicGeometry.IsOpenImmersion j_Vsh ∧
      AlgebraicGeometry.IsAffine V_sh ∧
      AlgebraicGeometry.IsIntegral V_sh ∧
      IsClosed ({v_sh} : Set ↥V_sh) ∧
      j_Vsh.base v_sh = v'₀ ∧
      CategoryTheory.IsPullback j_Ysh f_sh f' j_Vsh ∧
      ∃ (hU₀_eq : U_0 = (TopologicalSpace.Opens.map j_Ysh.base).obj U'_in)
        (hU₁_le : U_1 ≤ (TopologicalSpace.Opens.map j_Ysh.base).obj U'_out),
        AlgebraicGeometry.IsAffineOpen U_0 ∧
        AlgebraicGeometry.IsAffineOpen U_1 ∧
        U_0 ⊔ U_1 = ⊤ ∧
        let R'₁ := ↑(Y'.presheaf.obj (Opposite.op U'_out))
        let R₁ := ↑(Y_sh.presheaf.obj (Opposite.op U_1))
        letI : CommRing R'₁ := inferInstance
        letI : CommRing R₁ := inferInstance
        letI : Algebra R'₁ S'₁ := inferInstance
        letI : Algebra R'₁ R₁ := (j_Ysh.appLE U'_out U_1 hU₁_le).hom.toAlgebra
        let S₁ := TensorProduct R'₁ R₁ S'₁
        letI : CommRing S₁ := inferInstance
        letI : Algebra R'₁ S₁ := inferInstance
        letI : Algebra R₁ S₁ := inferInstance
        let bc₁₁ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁] TensorProduct R₁ S₁ S₁ :=
          Algebra.TensorProduct.lift
            ((Algebra.TensorProduct.includeLeft (R := R₁) (S := R'₁)
              (A := S₁) (B := S₁)).comp Algebra.TensorProduct.includeRight)
            (((Algebra.TensorProduct.includeRight (R := R₁) (A := S₁) (B := S₁)).restrictScalars
              R'₁).comp Algebra.TensorProduct.includeRight)
            (fun _ _ => Commute.all _ _)
        ∃ e₁ : Units S₁,
          bc₁₁ (g₁₁ : TensorProduct R'₁ S'₁ S'₁) * ((1 : S₁) ⊗ₜ[R₁] (e₁ : S₁)) =
            (e₁ : S₁) ⊗ₜ[R₁] (1 : S₁) :=
by
  classical
  
  let R'₁ := ↑(Y'.presheaf.obj (Opposite.op U'_out))
  letI : CommRing R'₁ := inferInstance
  letI : Algebra R'₁ S'₁ := inferInstance
  letI : CommRing (TensorProduct R'₁ S'₁ S'₁) := inferInstance
  let T₃ := TensorProduct R'₁ (TensorProduct R'₁ S'₁ S'₁) S'₁
  letI : CommRing T₃ := inferInstance
  let p₁₂ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁] T₃ := Algebra.TensorProduct.includeLeft
  let p₁₃ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁] T₃ :=
    Algebra.TensorProduct.lift
      (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
      Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
  let p₂₃ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁] T₃ :=
    Algebra.TensorProduct.lift
      (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
      Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
  have hg_inv_cocycle :
      p₁₃ ((g₁₁⁻¹ : Units (TensorProduct R'₁ S'₁ S'₁)) : TensorProduct R'₁ S'₁ S'₁) =
        p₁₂ ((g₁₁⁻¹ : Units (TensorProduct R'₁ S'₁ S'₁)) : TensorProduct R'₁ S'₁ S'₁) *
          p₂₃ ((g₁₁⁻¹ : Units (TensorProduct R'₁ S'₁ S'₁)) : TensorProduct R'₁ S'₁ S'₁) := by
    let u₁₂ : Units T₃ := Units.map p₁₂.toRingHom.toMonoidHom g₁₁
    let u₁₃ : Units T₃ := Units.map p₁₃.toRingHom.toMonoidHom g₁₁
    let u₂₃ : Units T₃ := Units.map p₂₃.toRingHom.toMonoidHom g₁₁
    have hu : u₁₃ = u₁₂ * u₂₃ := Units.ext hg₁₁_cocycle
    have hu_inv : u₁₃⁻¹ = u₁₂⁻¹ * u₂₃⁻¹ := by
      rw [hu, mul_inv_rev, mul_comm]
    have h12 : Units.map p₁₂.toRingHom.toMonoidHom g₁₁⁻¹ = u₁₂⁻¹ := map_inv _ g₁₁
    have h13 : Units.map p₁₃.toRingHom.toMonoidHom g₁₁⁻¹ = u₁₃⁻¹ := map_inv _ g₁₁
    have h23 : Units.map p₂₃.toRingHom.toMonoidHom g₁₁⁻¹ = u₂₃⁻¹ := map_inv _ g₁₁
    have hval : (Units.map p₁₃.toRingHom.toMonoidHom g₁₁⁻¹).val =
        (Units.map p₁₂.toRingHom.toMonoidHom g₁₁⁻¹ *
          Units.map p₂₃.toRingHom.toMonoidHom g₁₁⁻¹).val := by
      rw [h13, h12, h23, hu_inv]
    exact hval
  obtain ⟨L, instAddL, instModL, hInvL, e, hg_inv, -, -⟩ :=
    hH90 R'₁ S'₁ g₁₁⁻¹ hg_inv_cocycle
  letI : AddCommGroup L := instAddL
  letI : Module R'₁ L := instModL
  letI : Module.Invertible R'₁ L := hInvL

  
  have hy'_out : ∀ a : Fin m, (τ' a).base v'₀ ∈ U'_out := by
    intro a
    have hcov_mem : (τ' a).base v'₀ ∈ ((U'_out ⊔ U'_in : Y'.Opens) : Set ↥Y') := by
      rw [hU'_cov]
      trivial
    rcases hcov_mem with hout | hin
    · exact hout
    · exfalso
      rw [hU'_in_compl] at hin
      exact hin (Set.mem_iUnion.mpr ⟨a, v'₀, rfl⟩)
  have hy'_cl : ∀ a : Fin m, IsClosed ({(τ' a).base v'₀} : Set ↥Y') := by
    intro a
    have hcl_im := (τ' a).isClosedEmbedding.isClosedMap ({v'₀} : Set ↥V') hv'₀_cl
    rwa [Set.image_singleton] at hcl_im
  let x_bdry : Fin m → ↥U'_out := fun a => ⟨(τ' a).base v'₀, hy'_out a⟩
  let p_bdry : Fin m → PrimeSpectrum R'₁ := fun a => hAff_out.primeIdealOf (x_bdry a)
  let q_bdry : Fin m → Ideal R'₁ := fun a => (p_bdry a).asIdeal
  have hq_max : ∀ a : Fin m, (q_bdry a).IsMaximal :=
    fun a => hAff_out.primeIdealOf_isMaximal_of_isClosed (x_bdry a) (hy'_cl a)

  
  obtain ⟨τ₀, hτ₀⟩ := (Module.Invertible.bijective (R := R'₁) (M := L)).2 (1 : R'₁)
  have hloc_avoid : ∀ (I : Ideal R'₁), I.IsMaximal →
      ∃ (φ_I : Module.Dual R'₁ L) (v_I : L), φ_I v_I ∉ I := by
    intro I hI
    by_contra h_all
    push_neg at h_all
    have hmem : ∀ z : TensorProduct R'₁ (Module.Dual R'₁ L) L, contractLeft R'₁ L z ∈ I := by
      intro z
      refine @TensorProduct.induction_on R'₁ _ (Module.Dual R'₁ L) L _ _ _ _
        (fun w => contractLeft R'₁ L w ∈ I) z ?_ ?_ ?_
      · rw [map_zero]
        exact I.zero_mem
      · intro φ_I v_I
        rw [contractLeft_apply]
        exact h_all φ_I v_I
      · intro z₁ z₂ hz₁ hz₂
        rw [map_add]
        exact I.add_mem hz₁ hz₂
    have h1_mem : (1 : R'₁) ∈ I := by
      rw [← hτ₀]
      exact hmem τ₀
    apply hI.ne_top
    rw [Ideal.eq_top_iff_one]
    exact h1_mem

  let M : Finset (Ideal R'₁) := Finset.univ.image q_bdry
  have hM_max : ∀ I ∈ M, I.IsMaximal := by
    intro I hI
    rcases Finset.mem_image.mp hI with ⟨a, -, rfl⟩
    exact hq_max a
  let loc_pair : Ideal R'₁ → Module.Dual R'₁ L × L := fun I =>
    if hI : I ∈ M then
      (Classical.choose (hloc_avoid I (hM_max I hI)),
       Classical.choose (Classical.choose_spec (hloc_avoid I (hM_max I hI))))
    else (0, 0)
  let φ_loc : Ideal R'₁ → Module.Dual R'₁ L := fun I => (loc_pair I).1
  let v_loc : Ideal R'₁ → L := fun I => (loc_pair I).2
  have h_nmem : ∀ I (hI : I ∈ M), φ_loc I (v_loc I) ∉ I := by
    intro I hI
    dsimp [φ_loc, v_loc, loc_pair]
    rw [dif_pos hI]
    exact Classical.choose_spec (Classical.choose_spec (hloc_avoid I (hM_max I hI)))
  have h_crt_ex : ∀ I ∈ M, ∃ c : R'₁, (1 - c ∈ I) ∧ (∀ I₀ ∈ M, I ≠ I₀ → c ∈ I₀) := by
    intro I hI
    have hcop_each : ∀ J ∈ M.erase I, IsCoprime I J := by
      intro J hJ
      have hJ_er := Finset.mem_erase.mp hJ
      have hIJ_ne : I ≠ J := Ne.symm hJ_er.1
      haveI : I.IsMaximal := hM_max I hI
      haveI : J.IsMaximal := hM_max J hJ_er.2
      exact Ideal.isCoprime_of_isMaximal hIJ_ne
    have hcop_prod : IsCoprime I (∏ J ∈ M.erase I, J) :=
      IsCoprime.prod_right hcop_each
    rcases Ideal.isCoprime_iff_exists.mp hcop_prod with ⟨a_I, ha_I, c_I, hc_I, hac⟩
    refine ⟨c_I, ?_, ?_⟩
    · have ha_eq : 1 - c_I = a_I := by
        rw [← hac, add_sub_cancel_right]
      rw [ha_eq]
      exact ha_I
    · intro I₀ hI₀ hI_ne
      have hI₀_er : I₀ ∈ M.erase I := Finset.mem_erase.mpr ⟨Ne.symm hI_ne, hI₀⟩
      have hle₁ : (∏ J ∈ M.erase I, J) ≤ (M.erase I).inf id := Ideal.prod_le_inf
      have hle₂ : (M.erase I).inf id ≤ I₀ := Finset.inf_le hI₀_er
      exact hle₂ (hle₁ hc_I)

  let c_wt : Ideal R'₁ → R'₁ := fun I =>
    if hI : I ∈ M then Classical.choose (h_crt_ex I hI) else 0
  have hc_one_sub : ∀ I (hI : I ∈ M), 1 - c_wt I ∈ I := by
    intro I hI
    dsimp [c_wt]
    rw [dif_pos hI]
    exact (Classical.choose_spec (h_crt_ex I hI)).1
  have hc_other : ∀ I (hI : I ∈ M) I₀ (hI₀ : I₀ ∈ M), I ≠ I₀ → c_wt I ∈ I₀ := by
    intro I hI I₀ hI₀ hne
    dsimp [c_wt]
    rw [dif_pos hI]
    exact (Classical.choose_spec (h_crt_ex I hI)).2 I₀ hI₀ hne

  let φ_star : Module.Dual R'₁ L := ∑ I ∈ M, c_wt I • φ_loc I
  let y_star : L := ∑ I ∈ M, c_wt I • v_loc I
  let s₂ : R'₁ := φ_star y_star
  have hs₂_avoid : ∀ a : Fin m, s₂ ∉ q_bdry a := by
    intro a hs₂_in
    let I₀ : Ideal R'₁ := q_bdry a
    have hI₀ : I₀ ∈ M := Finset.mem_image_of_mem q_bdry (Finset.mem_univ a)
    let y_rem : L := ∑ J ∈ M.erase I₀, c_wt J • v_loc J
    have hy_split : y_star = c_wt I₀ • v_loc I₀ + y_rem :=
      (Finset.add_sum_erase M (fun J => c_wt J • v_loc J) hI₀).symm
    have hψ_rem : ∀ ψ : Module.Dual R'₁ L, ψ y_rem ∈ I₀ := by
      intro ψ
      dsimp [y_rem]
      rw [map_sum]
      refine I₀.sum_mem fun J hJ => ?_
      rw [map_smul, smul_eq_mul]
      have hJ_er := Finset.mem_erase.mp hJ
      exact I₀.mul_mem_right _ (hc_other J hJ_er.2 I₀ hI₀ hJ_er.1)
    have hφ_split : φ_star y_star =
        c_wt I₀ * φ_loc I₀ y_star + ∑ J ∈ M.erase I₀, c_wt J * φ_loc J y_star := by
      dsimp [φ_star]
      rw [← Finset.add_sum_erase M (fun J => c_wt J • φ_loc J) hI₀]
      simp only [LinearMap.add_apply, LinearMap.smul_apply, LinearMap.sum_apply, smul_eq_mul]
    have hsum_rem_in : (∑ J ∈ M.erase I₀, c_wt J * φ_loc J y_star) ∈ I₀ := by
      refine I₀.sum_mem fun J hJ => ?_
      have hJ_er := Finset.mem_erase.mp hJ
      exact I₀.mul_mem_right _ (hc_other J hJ_er.2 I₀ hI₀ hJ_er.1)
    have hfirst_eq : c_wt I₀ * φ_loc I₀ y_star =
        c_wt I₀ * (c_wt I₀ * φ_loc I₀ (v_loc I₀)) + c_wt I₀ * φ_loc I₀ y_rem := by
      rw [hy_split, map_add, map_smul, smul_eq_mul, mul_add]
    have hrem1_in : c_wt I₀ * φ_loc I₀ y_rem ∈ I₀ :=
      I₀.mul_mem_left _ (hψ_rem (φ_loc I₀))
    have hdiff_in : s₂ - c_wt I₀ * (c_wt I₀ * φ_loc I₀ (v_loc I₀)) ∈ I₀ := by
      have heq : s₂ - c_wt I₀ * (c_wt I₀ * φ_loc I₀ (v_loc I₀)) =
          c_wt I₀ * φ_loc I₀ y_rem + ∑ J ∈ M.erase I₀, c_wt J * φ_loc J y_star := by
        dsimp [s₂]
        rw [hφ_split, hfirst_eq]
        ring
      rw [heq]
      exact I₀.add_mem hrem1_in hsum_rem_in
    have h1_sub_sq : (1 - c_wt I₀ * c_wt I₀) * φ_loc I₀ (v_loc I₀) ∈ I₀ := by
      have hfac : (1 - c_wt I₀ * c_wt I₀) * φ_loc I₀ (v_loc I₀) =
          (1 - c_wt I₀) * ((1 + c_wt I₀) * φ_loc I₀ (v_loc I₀)) := by ring
      rw [hfac]
      exact I₀.mul_mem_right _ (hc_one_sub I₀ hI₀)
    have hloc_in : φ_loc I₀ (v_loc I₀) ∈ I₀ := by
      have hid : φ_loc I₀ (v_loc I₀) =
          (s₂ - (s₂ - c_wt I₀ * (c_wt I₀ * φ_loc I₀ (v_loc I₀)))) +
            (1 - c_wt I₀ * c_wt I₀) * φ_loc I₀ (v_loc I₀) := by ring
      rw [hid]
      exact I₀.add_mem (I₀.sub_mem hs₂_in hdiff_in) h1_sub_sq
    exact h_nmem I₀ hI₀ hloc_in

  have hs₂_mem : ∀ a : Fin m, (τ' a).base v'₀ ∈ Y'.basicOpen s₂ := by
    intro a
    have hp_mem : p_bdry a ∈ PrimeSpectrum.basicOpen s₂ := by
      rw [PrimeSpectrum.mem_basicOpen]
      exact hs₂_avoid a
    have hpre := (hAff_out.fromSpec_preimage_basicOpen s₂).symm
    have hmap_mem : p_bdry a ∈ (TopologicalSpace.Opens.map hAff_out.fromSpec.base).obj
        (Y'.basicOpen s₂) := by
      rwa [hpre] at hp_mem
    have hbase_mem : hAff_out.fromSpec.base (p_bdry a) ∈ Y'.basicOpen s₂ := hmap_mem
    have hpt_eq : hAff_out.fromSpec.base (p_bdry a) = (τ' a).base v'₀ := by
      simpa [p_bdry, x_bdry] using hAff_out.fromSpec_primeIdealOf (x_bdry a)
    rwa [hpt_eq] at hbase_mem

  
  let W_good : V'.Opens :=
    ⟨⋂ a : Fin m, (τ' a).base ⁻¹' (Y'.basicOpen s₂ : Set ↥Y'),
      isOpen_iInter_of_finite fun a => (Y'.basicOpen s₂).isOpen.preimage (τ' a).continuous⟩
  have hv'₀_good : v'₀ ∈ W_good := Set.mem_iInter.mpr hs₂_mem
  obtain ⟨h₂, hh₂_le, hv'₀_mem⟩ :=
    (AlgebraicGeometry.isAffineOpen_top V').exists_basicOpen_le (⟨v'₀, hv'₀_good⟩ : ↥W_good)
      (trivial : v'₀ ∈ (⊤ : V'.Opens))
  let V_open : V'.Opens := V'.basicOpen h₂
  let V_sh : AlgebraicGeometry.Scheme.{u} := V_open.toScheme
  let j_Vsh : Quiver.Hom V_sh V' := V_open.ι
  let v_sh : ↥V_sh := ⟨v'₀, hv'₀_mem⟩
  have hOpen_Vsh : AlgebraicGeometry.IsOpenImmersion j_Vsh := inferInstance
  have hAff_Vsh : AlgebraicGeometry.IsAffine V_sh := inferInstance
  haveI : Nonempty ↥V_sh := ⟨v_sh⟩
  have hInt_Vsh : AlgebraicGeometry.IsIntegral V_sh :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion j_Vsh
  have hv_sh_pt : j_Vsh.base v_sh = v'₀ := rfl
  have hv_sh_cl : IsClosed ({v_sh} : Set ↥V_sh) := by
    have hpre_singleton : j_Vsh.base ⁻¹' ({v'₀} : Set ↥V') = ({v_sh} : Set ↥V_sh) := by
      ext z
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hz
        exact Subtype.ext hz
      · intro hz
        rw [hz]
        exact hv_sh_pt
    rw [← hpre_singleton]
    exact hv'₀_cl.preimage j_Vsh.continuous

  let Y_open : Y'.Opens := (TopologicalSpace.Opens.map f'.base).obj V_open
  let Y_sh : AlgebraicGeometry.Scheme.{u} := Y_open.toScheme
  let j_Ysh : Quiver.Hom Y_sh Y' := Y_open.ι
  let f_sh : Quiver.Hom Y_sh V_sh := f' ∣_ V_open
  have hPb_unflip : CategoryTheory.IsPullback f_sh j_Ysh j_Vsh f' :=
    AlgebraicGeometry.isPullback_morphismRestrict f' V_open
  have hPb_sh : CategoryTheory.IsPullback j_Ysh f_sh f' j_Vsh := hPb_unflip.flip
  haveI : AlgebraicGeometry.IsAffineHom j_Vsh :=
    AlgebraicGeometry.isAffineHom_of_isAffine j_Vsh
  haveI : AlgebraicGeometry.IsAffineHom j_Ysh :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_unflip (inferInstance : AlgebraicGeometry.IsAffineHom j_Vsh)
  let U_0 : Y_sh.Opens := (TopologicalSpace.Opens.map j_Ysh.base).obj U'_in
  let U_1 : Y_sh.Opens := (TopologicalSpace.Opens.map j_Ysh.base).obj (Y'.basicOpen s₂)
  have hU₀_eq : U_0 = (TopologicalSpace.Opens.map j_Ysh.base).obj U'_in := rfl
  have h_bo : Y'.basicOpen s₂ ≤ U'_out := Y'.toRingedSpace.basicOpen_le s₂
  have hU₁_le : U_1 ≤ (TopologicalSpace.Opens.map j_Ysh.base).obj U'_out :=
    (TopologicalSpace.Opens.map j_Ysh.base).monotone h_bo
  have hAff_U0 : AlgebraicGeometry.IsAffineOpen U_0 := hAff_in.preimage j_Ysh
  have hAff_U1 : AlgebraicGeometry.IsAffineOpen U_1 := (hAff_out.basicOpen s₂).preimage j_Ysh
  have hU01_cov : U_0 ⊔ U_1 = ⊤ := by
    rw [eq_top_iff]
    intro y _
    change y ∈ U_0 ∨ y ∈ U_1
    by_cases hy_in : j_Ysh.base y ∈ U'_in
    · exact Or.inl hy_in
    · refine Or.inr ?_
      have hy_not_in : j_Ysh.base y ∉ (U'_in : Set ↥Y') := hy_in
      rw [hU'_in_compl, Set.notMem_compl_iff] at hy_not_in
      rcases Set.mem_iUnion.mp hy_not_in with ⟨a, v, hv_eq⟩
      have hy_open : j_Ysh.base y ∈ Y_open := y.2
      have hfy_open : f'.base (j_Ysh.base y) ∈ V_open := hy_open
      have hfv_eq : f'.base ((τ' a).base v) = v := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply (τ' a) f' v, hτ'_sec a]
        rfl
      rw [← hv_eq, hfv_eq] at hfy_open
      have hv_good : v ∈ W_good := hh₂_le hfy_open
      have hτv_bo : (τ' a).base v ∈ Y'.basicOpen s₂ := Set.mem_iInter.mp hv_good a
      change j_Ysh.base y ∈ Y'.basicOpen s₂
      rwa [← hv_eq]
  have hu_s₂ : IsUnit ((j_Ysh.appLE U'_out U_1 hU₁_le).hom s₂) := by
    have hmap_eq := j_Ysh.map_appLE
      (le_rfl : U_1 ≤ (TopologicalSpace.Opens.map j_Ysh.base).obj (Y'.basicOpen s₂))
      (CategoryTheory.homOfLE h_bo).op
    rw [← hmap_eq, CommRingCat.hom_comp, RingHom.comp_apply]
    have hu_bo : IsUnit ((Y'.presheaf.map (CategoryTheory.homOfLE h_bo).op).hom s₂) :=
      Y'.toRingedSpace.isUnit_res_basicOpen s₂
    exact hu_bo.map (j_Ysh.appLE (Y'.basicOpen s₂) U_1 le_rfl).hom

  
  let R₁ := ↑(Y_sh.presheaf.obj (Opposite.op U_1))
  letI : CommRing R₁ := inferInstance
  letI : Algebra R'₁ R₁ := (j_Ysh.appLE U'_out U_1 hU₁_le).hom.toAlgebra
  let S₁ := TensorProduct R'₁ R₁ S'₁
  letI : CommRing S₁ := inferInstance
  letI : Algebra R'₁ S₁ := inferInstance
  letI : Algebra R₁ S₁ := inferInstance
  let bc₁₁ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁] TensorProduct R₁ S₁ S₁ :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := R₁) (S := R'₁)
        (A := S₁) (B := S₁)).comp Algebra.TensorProduct.includeRight)
      (((Algebra.TensorProduct.includeRight (R := R₁) (A := S₁) (B := S₁)).restrictScalars
        R'₁).comp Algebra.TensorProduct.includeRight)
      (fun _ _ => Commute.all _ _)
  let t_minus : S'₁ := e ((1 : S'₁) ⊗ₜ[R'₁] y_star)
  have h_coc : (g₁₁ : TensorProduct R'₁ S'₁ S'₁) * ((1 : S'₁) ⊗ₜ[R'₁] t_minus) =
      t_minus ⊗ₜ[R'₁] (1 : S'₁) := by
    have hinv_y := hg_inv y_star
    change ((1 : S'₁) ⊗ₜ[R'₁] t_minus : TensorProduct R'₁ S'₁ S'₁) =
      ((g₁₁⁻¹ : Units _) : TensorProduct R'₁ S'₁ S'₁) * (t_minus ⊗ₜ[R'₁] (1 : S'₁)) at hinv_y
    rw [hinv_y, ← mul_assoc]
    have hgg : (g₁₁ : TensorProduct R'₁ S'₁ S'₁) *
        ((g₁₁⁻¹ : Units (TensorProduct R'₁ S'₁ S'₁)) : TensorProduct R'₁ S'₁ S'₁) = 1 :=
      Units.mul_inv g₁₁
    rw [hgg, one_mul]
  let l_φ : L →ₗ[R'₁] S'₁ := (Algebra.linearMap R'₁ S'₁).comp φ_star
  let Φ_T : TensorProduct R'₁ S'₁ L →ₗ[S'₁] S'₁ := LinearMap.liftBaseChange S'₁ l_φ
  let Ψ : S'₁ →ₗ[S'₁] S'₁ := Φ_T.comp e.symm.toLinearMap
  let w_plus : S'₁ := Ψ (1 : S'₁)
  have h_pair : t_minus * w_plus = algebraMap R'₁ S'₁ s₂ := by
    have h1 : Ψ t_minus = t_minus * w_plus := by
      have hsm : t_minus = t_minus • (1 : S'₁) := by simp
      conv_lhs => rw [hsm]
      rw [map_smul, smul_eq_mul]
    have h2 : Ψ t_minus = algebraMap R'₁ S'₁ s₂ := by
      dsimp [Ψ, Φ_T, l_φ, t_minus, s₂]
      rw [e.symm_apply_apply, LinearMap.liftBaseChange_tmul, one_smul]
      rfl
    exact h1.symm.trans h2
  let ι_S'₁ : S'₁ →ₐ[R'₁] S₁ := Algebra.TensorProduct.includeRight
  have h_alg_eq : ι_S'₁ (algebraMap R'₁ S'₁ s₂) =
      algebraMap R₁ S₁ ((j_Ysh.appLE U'_out U_1 hU₁_le).hom s₂) := by
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R'₁ R₁ S₁]
    rfl
  have hu_S₁ : IsUnit (ι_S'₁ (algebraMap R'₁ S'₁ s₂)) := by
    rw [h_alg_eq]
    exact hu_s₂.map (algebraMap R₁ S₁)
  let u_S₁ : Units S₁ := hu_S₁.unit
  have h_mul_one : ι_S'₁ t_minus * (ι_S'₁ w_plus * ↑(u_S₁⁻¹)) = 1 := by
    rw [← mul_assoc, ← map_mul, h_pair]
    have hu_val : ι_S'₁ (algebraMap R'₁ S'₁ s₂) = (u_S₁ : S₁) := (IsUnit.unit_spec hu_S₁).symm
    rw [hu_val]
    exact Units.mul_inv u_S₁
  let e₁ : Units S₁ := Units.mkOfMulEqOne (ι_S'₁ t_minus) (ι_S'₁ w_plus * ↑(u_S₁⁻¹)) h_mul_one
  have he₁_val : (e₁ : S₁) = ι_S'₁ t_minus := rfl
  have hbc_r : bc₁₁ ((1 : S'₁) ⊗ₜ[R'₁] t_minus) = (1 : S₁) ⊗ₜ[R₁] (e₁ : S₁) := by
    simp [bc₁₁, he₁_val, ι_S'₁]
  have hbc_l : bc₁₁ (t_minus ⊗ₜ[R'₁] (1 : S'₁)) = (e₁ : S₁) ⊗ₜ[R₁] (1 : S₁) := by
    simp [bc₁₁, he₁_val, ι_S'₁]
  have he₁_triv : bc₁₁ (g₁₁ : TensorProduct R'₁ S'₁ S'₁) * ((1 : S₁) ⊗ₜ[R₁] (e₁ : S₁)) =
      (e₁ : S₁) ⊗ₜ[R₁] (1 : S₁) := by
    rw [← hbc_r, ← hbc_l, ← map_mul]
    exact congrArg bc₁₁ h_coc

  exact ⟨V_sh, j_Vsh, v_sh, Y_sh, j_Ysh, f_sh, U_0, U_1,
    hOpen_Vsh, hAff_Vsh, hInt_Vsh, hv_sh_cl, hv_sh_pt, hPb_sh,
    hU₀_eq, hU₁_le, hAff_U0, hAff_U1, hU01_cov, e₁, he₁_triv⟩

theorem weil_kummer_cocycle_algebra_descent_and_overlap_iso (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R₀ R₁ R₀₁ : Type u) [CommRing R₀] [CommRing R₁] [CommRing R₀₁]
    (ρ₀ : R₀ →+* R₀₁) (ρ₁ : R₁ →+* R₀₁)
    (u_ov : R₀₁)
    (hℓ_unit : IsUnit ((ℓ : ℕ) : R₀))
    (hu_ov : IsUnit u_ov)
    (S₀ : Type u) [CommRing S₀] [Algebra R₀ S₀] [Algebra.Etale R₀ S₀] [Module.FaithfullyFlat R₀ S₀]
    (S₁ : Type u) [CommRing S₁] [Algebra R₁ S₁] [Module.FaithfullyFlat R₁ S₁]
    (v₀ : Units S₀) (v₁ : Units S₁)
    (g₀₀ : Units (TensorProduct R₀ S₀ S₀))
    (g₁₁ : Units (TensorProduct R₁ S₁ S₁))
    (g₀₁ :
      letI : Algebra R₀ R₀₁ := ρ₀.toAlgebra
      letI : Algebra R₁ R₀₁ := ρ₁.toAlgebra
      Units (TensorProduct R₀₁ (TensorProduct R₀ R₀₁ S₀) (TensorProduct R₁ R₀₁ S₁)))
    (e₁ : Units S₁)
    (hcocycle :
      letI : Algebra R₀ R₀₁ := ρ₀.toAlgebra
      letI : Algebra R₁ R₀₁ := ρ₁.toAlgebra
      let S₀_ov := TensorProduct R₀ R₀₁ S₀
      let S₁_ov := TensorProduct R₁ R₀₁ S₁
      letI : CommRing S₀_ov := inferInstance
      letI : CommRing S₁_ov := inferInstance
      letI : Algebra R₀ S₀_ov := inferInstance
      letI : Algebra R₁ S₁_ov := inferInstance
      letI : Algebra R₀₁ S₀_ov := inferInstance
      letI : Algebra R₀₁ S₁_ov := inferInstance
      let p₀_₁₂ : TensorProduct R₀ S₀ S₀ →ₐ[R₀]
          TensorProduct R₀ (TensorProduct R₀ S₀ S₀) S₀ :=
        Algebra.TensorProduct.includeLeft
      let p₀_₁₃ : TensorProduct R₀ S₀ S₀ →ₐ[R₀]
          TensorProduct R₀ (TensorProduct R₀ S₀ S₀) S₀ :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeLeft)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      let p₀_₂₃ : TensorProduct R₀ S₀ S₀ →ₐ[R₀]
          TensorProduct R₀ (TensorProduct R₀ S₀ S₀) S₀ :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft.comp Algebra.TensorProduct.includeRight)
          Algebra.TensorProduct.includeRight (fun _ _ => Commute.all _ _)
      let map₀₀ : TensorProduct R₀ S₀ S₀ →ₐ[R₀] TensorProduct R₀₁ S₀_ov S₀_ov :=
        Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀)
            (A := S₀_ov) (B := S₀_ov)).comp Algebra.TensorProduct.includeRight)
          (((Algebra.TensorProduct.includeRight (R := R₀₁) (A := S₀_ov) (B := S₀_ov)).restrictScalars
            R₀).comp Algebra.TensorProduct.includeRight)
          (fun _ _ => Commute.all _ _)
      let map₁₁ : TensorProduct R₁ S₁ S₁ →ₐ[R₁] TensorProduct R₀₁ S₁_ov S₁_ov :=
        Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₁)
            (A := S₁_ov) (B := S₁_ov)).comp Algebra.TensorProduct.includeRight)
          (((Algebra.TensorProduct.includeRight (R := R₀₁) (A := S₁_ov) (B := S₁_ov)).restrictScalars
            R₁).comp Algebra.TensorProduct.includeRight)
          (fun _ _ => Commute.all _ _)
      letI : CommRing (TensorProduct R₀₁ S₀_ov S₀_ov) := inferInstance
      let q₀₀₁_₁₂ : TensorProduct R₀₁ S₀_ov S₀_ov →ₐ[R₀₁]
          TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov :=
        Algebra.TensorProduct.includeLeft
      let q₀₀₁_₁₃ : TensorProduct R₀₁ S₀_ov S₁_ov →ₐ[R₀₁]
          TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov :=
        Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁)
            (A := TensorProduct R₀₁ S₀_ov S₀_ov) (B := S₁_ov)).comp
            (Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁) (A := S₀_ov) (B := S₀_ov)))
          (Algebra.TensorProduct.includeRight (R := R₀₁)
            (A := TensorProduct R₀₁ S₀_ov S₀_ov) (B := S₁_ov))
          (fun _ _ =>
            @Commute.all (TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov) _ _ _)
      let q₀₀₁_₂₃ : TensorProduct R₀₁ S₀_ov S₁_ov →ₐ[R₀₁]
          TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov :=
        Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁)
            (A := TensorProduct R₀₁ S₀_ov S₀_ov) (B := S₁_ov)).comp
            (Algebra.TensorProduct.includeRight (R := R₀₁) (A := S₀_ov) (B := S₀_ov)))
          (Algebra.TensorProduct.includeRight (R := R₀₁)
            (A := TensorProduct R₀₁ S₀_ov S₀_ov) (B := S₁_ov))
          (fun _ _ =>
            @Commute.all (TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov) _ _ _)
      letI : CommRing (TensorProduct R₀₁ S₀_ov S₁_ov) := inferInstance
      let q₀₁₁_₁₂ : TensorProduct R₀₁ S₀_ov S₁_ov →ₐ[R₀₁]
          TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₁_ov) S₁_ov :=
        Algebra.TensorProduct.includeLeft
      let q₀₁₁_₁₃ : TensorProduct R₀₁ S₀_ov S₁_ov →ₐ[R₀₁]
          TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₁_ov) S₁_ov :=
        Algebra.TensorProduct.lift
          ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁)
