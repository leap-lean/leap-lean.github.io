              t' * algebraMap R C'_x q_r := by
            calc
              algebraMap B C'_x (h_x ^ k) * (x * algebraMap R C'_x (s'_x ^ n))
                = algebraMap R C'_x (algebraMap B R (h_x ^ k)) * algebraMap R C'_x r := by
                    rw [hxr, IsScalarTower.algebraMap_apply B R C'_x]
              _ = algebraMap R C'_x (algebraMap B R (h_x ^ k) * r) := (map_mul _ _ _).symm
              _ = algebraMap R C'_x (t * q_r) := by rw [hq_r]
              _ = t' * algebraMap R C'_x q_r := map_mul _ _ _
          have hu_den : IsUnit (algebraMap B C'_x (h_x ^ k) * algebraMap R C'_x (s'_x ^ n)) := by
            rw [map_pow, map_pow]
            have hu_s'_C' : IsUnit (algebraMap R C'_x s'_x) :=
              IsLocalization.Away.algebraMap_isUnit (S := C'_x) s'_x
            exact (hu_hx_C'.pow k).mul (hu_s'_C'.pow n)
          let u_den : Units C'_x := hu_den.unit
          refine Ideal.mem_span_singleton.mpr
            ⟨algebraMap R C'_x q_r * ((u_den⁻¹ : Units C'_x) : C'_x), ?_⟩
          calc
            x = x * ((u_den : C'_x) * ((u_den⁻¹ : Units C'_x) : C'_x)) := by
                rw [Units.mul_inv, mul_one]
            _ = (algebraMap B C'_x (h_x ^ k) * (x * algebraMap R C'_x (s'_x ^ n))) *
                  ((u_den⁻¹ : Units C'_x) : C'_x) := by
                change x * ((algebraMap B C'_x (h_x ^ k) * algebraMap R C'_x (s'_x ^ n)) *
                  ((u_den⁻¹ : Units C'_x) : C'_x)) = _
                ring
            _ = t' * (algebraMap R C'_x q_r * ((u_den⁻¹ : Units C'_x) : C'_x)) := by
                rw [h_eq_C', mul_assoc]
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          change π_x_ring (algebraMap R C'_x t) = 0
          rw [hπ_x_R, ht_ker, map_zero]
      have hdisj_s' : Disjoint (Submonoid.powers s'_x : Set R) (p_R : Set R) := by
        rw [Set.disjoint_left]
        rintro _ ⟨n, rfl⟩ hn
        cases n with
        | zero =>
          dsimp only at hn
          rw [pow_zero] at hn
          exact hp_R_prime.ne_top (p_R.eq_top_iff_one.mpr hn)
        | succ m => exact hs'_x_not_pR (hp_R_prime.mem_of_pow_mem (m + 1) hn)
      let p'_R : Ideal C'_x := Ideal.map (algebraMap R C'_x) p_R
      haveI hp'_R_prime : p'_R.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s'_x) C'_x p_R hp_R_prime
          hdisj_s'
      have ht'_mem : t' ∈ p'_R := Ideal.mem_map_of_mem _ ht_pR
      obtain ⟨r₀, ψ_loc, ω_x, hr₀_not_p', hEt_loc, ht'_eq⟩ :=
        draft_s3 B_x C'_x π_x t' ht'_ne hker_x p'_R ht'_mem ψ₀ hEt₀
      let C_tilde := Localization.Away r₀
      obtain ⟨⟨r_ω, _, k_ω, rfl⟩, hr_ω_eq⟩ := IsLocalization.surj (Submonoid.powers s'_x) r₀
      have hr_ω_not_pR : r_ω ∉ p_R := by
        intro hr_in
        have hmap_in : algebraMap R C'_x r_ω ∈ p'_R := Ideal.mem_map_of_mem _ hr_in
        rw [← hr_ω_eq] at hmap_in
        have hu_pow_C' : IsUnit (algebraMap R C'_x (s'_x ^ k_ω)) := by
          rw [map_pow]
          exact (IsLocalization.Away.algebraMap_isUnit (S := C'_x) s'_x).pow k_ω
        let u_p : Units C'_x := hu_pow_C'.unit
        have hr₀_in : r₀ ∈ p'_R := by
          have heq : r₀ = (r₀ * (u_p : C'_x)) * ((u_p⁻¹ : Units C'_x) : C'_x) := by
            rw [mul_assoc, Units.mul_inv, mul_one]
          rw [heq]
          exact Ideal.mul_mem_right _ _ hmap_in
        exact hr₀_not_p' hr₀_in
      let s_x : R := s'_x * r_ω
      have hs_x_not_pR : s_x ∉ p_R :=
        fun hmem => (hp_R_prime.mem_or_mem hmem).elim hs'_x_not_pR hr_ω_not_pR
      haveI h_loc_sx_Ctilde : IsLocalization.Away s_x C_tilde :=
        draft_away_step R C'_x s'_x r₀ k_ω r_ω hr_ω_eq
      have hB_C' : ∀ b : B,
          algebraMap B_x C'_x (algebraMap B B_x b) = algebraMap R C'_x (algebraMap B R b) := by
        intro b
        rw [← IsScalarTower.algebraMap_apply B B_x C'_x b,
          IsScalarTower.algebraMap_apply B R C'_x b]
      haveI : q.IsPrime := hq_prime
      exact draft_case2_finish B B_x R C'_x C_tilde hB_C' u t s_x q hs_x_not_pR hw
        ψ_loc hEt_loc ω_x ht'_eq
    · 
      have ht_not_pR : t ∉ p_R := by
        intro ht_in
        have h_ut_q : ι_R (u : R) * ι_R t ∈ q := Ideal.mul_mem_left _ _ ht_in
        have hw_pow_in : w ^ ℓ ∈ q := (hw_pow_S.trans (map_mul ι_R _ _)).symm ▸ h_ut_q
        exact hw (hq_prime.mem_of_pow_mem ℓ hw_pow_in)
      let r₁ : R := s₀ * t
      have hr₁_not_pR : r₁ ∉ p_R :=
        fun hmem => (hp_R_prime.mem_or_mem hmem).elim hs₀_not_pR ht_not_pR
      let g_q : S := ι_R r₁
      have hg_q_not_q : g_q ∉ q := hr₁_not_pR
      let R'₁ := Localization.Away r₁
      have hSm1_B_R'₁ : Algebra.IsStandardSmoothOfRelativeDimension 1 B R'₁ := by
        let R''₁ := Localization.Away (algebraMap R R₀ t)
        haveI : IsLocalization.Away r₁ R''₁ :=
          IsLocalization.Away.mul' R₀ R''₁ s₀ t
        haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 B R₀ :=
          (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hSm_R₀
        haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 R₀ R''₁ :=
          Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
        have hSm_R''₁ : Algebra.IsStandardSmoothOfRelativeDimension 1 B R''₁ := by
          have h01 := Algebra.IsStandardSmoothOfRelativeDimension.trans 1 0 B R₀ R''₁
          simpa using h01
        let e_R₁ : R''₁ ≃ₐ[R] R'₁ :=
          IsLocalization.algEquiv (Submonoid.powers r₁) R''₁ R'₁
        have hhom_R₁ : e_R₁.toRingEquiv.toRingHom.comp (algebraMap B R''₁) =
            algebraMap B R'₁ := by
          ext b
          change e_R₁ (algebraMap B R''₁ b) = algebraMap B R'₁ b
          rw [IsScalarTower.algebraMap_apply B R R''₁ b,
            IsScalarTower.algebraMap_apply B R R'₁ b]
          exact e_R₁.commutes (algebraMap B R b)
        apply (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp
        rw [← hhom_R₁]
        exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).left
          (algebraMap B R''₁) e_R₁.toRingEquiv
          ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hSm_R''₁)
      have hℓ_u_R'₁ : IsUnit (ℓ : R'₁) := by
        rw [← map_natCast (algebraMap B R'₁)]
        exact hℓ_unit.map (algebraMap B R'₁)
      have hu_ut_R'₁ : IsUnit (algebraMap R R'₁ ((u : R) * t)) := by
        have hu_r₁ : IsUnit (algebraMap R R'₁ s₀ * algebraMap R R'₁ t) := by
          rw [← map_mul]
          exact IsLocalization.Away.algebraMap_isUnit r₁
        have hu_t : IsUnit (algebraMap R R'₁ t) := isUnit_of_mul_isUnit_right hu_r₁
        rw [map_mul]
        exact (u.isUnit.map (algebraMap R R'₁)).mul hu_t
      let u₀_R'₁ : Units R'₁ := hu_ut_R'₁.unit
      have hu₀_eq : (u₀_R'₁ : R'₁) = algebraMap R R'₁ ((u : R) * t) := rfl
      let S'₁ := Polynomial R'₁ ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u₀_R'₁ : R'₁)}
      let ι_R'₁ : R'₁ →+* S'₁ := (Ideal.Quotient.mk _).comp Polynomial.C
      obtain ⟨φ_r₁, hφ_r₁_comp, -, h_loc_gq_S'₁⟩ :=
        draft_s2a R R'₁ ((u : R) * t) r₁ (u₀_R'₁ : R'₁) hu₀_eq
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 B R'₁ := hSm1_B_R'₁
      obtain ⟨φ_B_S'₁, hφ_B_S'₁_app, hSm1_B_S'₁⟩ :=
        draft_s2b_comp B R'₁ hℓ_u_R'₁ u₀_R'₁
      letI _alg_S_S'₁ : Algebra S S'₁ := φ_r₁.toAlgebra
      haveI _loc_gq_S'₁ : IsLocalization.Away g_q S'₁ := h_loc_gq_S'₁
      let e_r₁ : S'₁ ≃ₐ[S] Localization.Away g_q :=
        IsLocalization.algEquiv (Submonoid.powers g_q) S'₁ (Localization.Away g_q)
      have hhom_eq_r₁ : e_r₁.toRingEquiv.toRingHom.comp φ_B_S'₁ =
          (algebraMap S (Localization.Away g_q)).comp φ_BS := by
        ext b
        change e_r₁ (φ_B_S'₁ b) =
          algebraMap S (Localization.Away g_q) (ι_R (algebraMap B R b))
        rw [hφ_B_S'₁_app b]
        change e_r₁ (ι_R'₁ (algebraMap B R'₁ b)) = _
        have hBR'₁ : algebraMap B R'₁ b = algebraMap R R'₁ (algebraMap B R b) :=
          IsScalarTower.algebraMap_apply B R R'₁ b
        have hι_eq : ι_R'₁ (algebraMap R R'₁ (algebraMap B R b)) =
            φ_r₁ (ι_R (algebraMap B R b)) := by
          change (ι_R'₁.comp (algebraMap R R'₁)) (algebraMap B R b) =
            (φ_r₁.comp ι_R) (algebraMap B R b)
          rw [hφ_r₁_comp]
        rw [hBR'₁, hι_eq]
        exact e_r₁.commutes (ι_R (algebraMap B R b))
      refine ⟨g_q, hg_q_not_q, ?_⟩
      dsimp [G]
      rw [← hhom_eq_r₁]
      exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).left
        φ_B_S'₁ e_r₁.toRingEquiv hSm1_B_S'₁
  have h1_mem : (1 : S) ∈ Ideal.span G := by
    rw [hG_top]
    trivial
  obtain ⟨c_lin, hc_supp, hc_sum⟩ := Submodule.mem_span_set.mp h1_mem
  refine ⟨c_lin.support, ?_, fun g hg => hc_supp hg⟩
  rw [Ideal.eq_top_iff_one, ← hc_sum]
  exact Submodule.sum_mem _ fun g hg =>
    Submodule.smul_mem _ (c_lin g) (Ideal.subset_span hg)

theorem weil_ramified_cover_geom_fibers_connected_and_total_irreducible : (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (F_mid F_sh : AlgebraicGeometry.Scheme.{u})
        (q_mid : Quiver.Hom F_mid (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 q_mid]
        (ν_s : Quiver.Hom F_mid F_sh)
        [AlgebraicGeometry.IsFinite ν_s]
        [AlgebraicGeometry.IsIntegral F_sh]
        (hDim : topologicalKrullDim ↥F_sh = (1 : WithBot ℕ∞))
        (z₀ : ↥F_sh) (z_tilde₀ : ↥F_mid),
      ν_s.base ⁻¹' ({z₀} : Set ↥F_sh) = ({z_tilde₀} : Set ↥F_mid) →
      ConnectedSpace ↥F_mid) ∧
    (∀ (Y_tilde V : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsIntegral V]
        (f_tilde : Quiver.Hom Y_tilde V)
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_tilde],
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V),
        IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_tilde s)) →
      IrreducibleSpace ↥Y_tilde) :=
by
  have hbot_prime : ∀ (R : Type u) [CommRing R] [IsDomain R], (⊥ : Ideal R).IsPrime := by
    intro R _ _
    rw [Ideal.isPrime_iff]
    refine ⟨?_, fun {x y} hxy => ?_⟩
    · intro hbt
      have h1 : (1 : R) ∈ (⊥ : Ideal R) := hbt.symm ▸ Submodule.mem_top
      rw [Ideal.mem_bot] at h1
      exact one_ne_zero h1
    · simp only [Ideal.mem_bot] at hxy ⊢
      exact mul_eq_zero.mp hxy
  constructor
  · intro Ω _ _ F_mid F_sh q_mid _ ν_s _ _ hDim z₀ z_tilde₀ hSing
    have hJacobsonMv : ∀ (k : ℕ) (A : Type u) [CommRing A] [IsJacobsonRing A]
        (M : Ideal (MvPolynomial (Fin k) A)), M.IsMaximal →
        (Ideal.comap (algebraMap A (MvPolynomial (Fin k) A)) M).IsMaximal := by
      intro k
      induction k with
      | zero =>
        intro A _ _ M hM
        have _ : M.IsMaximal := hM
        let e₀ : MvPolynomial (Fin 0) A ≃ₐ[A] A := MvPolynomial.isEmptyAlgEquiv A (Fin 0)
        have hsurj : Function.Surjective (algebraMap A (MvPolynomial (Fin 0) A)) := by
          intro p
          refine ⟨e₀ p, ?_⟩
          exact e₀.injective (e₀.commutes (e₀ p))
        exact Ideal.comap_isMaximal_of_surjective (algebraMap A (MvPolynomial (Fin 0) A)) hsurj
      | succ k ih =>
        intro A _ _ M hM
        have _ : M.IsMaximal := hM
        let e : MvPolynomial (Fin (k + 1)) A ≃ₐ[A] Polynomial (MvPolynomial (Fin k) A) :=
          MvPolynomial.finSuccEquiv A k
        let P : Ideal (Polynomial (MvPolynomial (Fin k) A)) :=
          Ideal.comap e.symm.toRingHom M
        have hP : P.IsMaximal :=
          Ideal.comap_isMaximal_of_surjective e.symm.toRingHom e.symm.surjective
        have _ : P.IsMaximal := hP
        let Q : Ideal (MvPolynomial (Fin k) A) := Ideal.comap Polynomial.C P
        have hQ : Q.IsMaximal := Polynomial.isMaximal_comap_C_of_isJacobsonRing P
        have hQ' : (Ideal.comap (algebraMap A (MvPolynomial (Fin k) A)) Q).IsMaximal :=
          ih A Q hQ
        have heq : Ideal.comap (algebraMap A (MvPolynomial (Fin k) A)) Q =
            Ideal.comap (algebraMap A (MvPolynomial (Fin (k + 1)) A)) M := by
          ext a
          simp only [Q, P, Ideal.mem_comap]
          have hcomm : e.symm (Polynomial.C (algebraMap A (MvPolynomial (Fin k) A) a)) =
              algebraMap A (MvPolynomial (Fin (k + 1)) A) a := by
            rw [← Polynomial.algebraMap_eq,
              ← IsScalarTower.algebraMap_apply A (MvPolynomial (Fin k) A)
                (Polynomial (MvPolynomial (Fin k) A)),
              e.symm.commutes]
          change e.symm (Polynomial.C (algebraMap A (MvPolynomial (Fin k) A) a)) ∈ M ↔
            algebraMap A (MvPolynomial (Fin (k + 1)) A) a ∈ M
          rw [hcomm]
        rwa [← heq]
    have hPrimeLt : ∀ (C : Type u) [CommRing C] [Nontrivial C]
        (g : MvPolynomial (Fin 1) Ω →+* C), g.Etale →
        ∃ (𝔮 𝔪 : Ideal C), 𝔮.IsPrime ∧ 𝔪.IsPrime ∧ 𝔮 < 𝔪 := by
      intro C _ _ g hg
      let R₀ := MvPolynomial (Fin 1) Ω
      let _ : Algebra R₀ C := g.toAlgebra
      have _ : Algebra.Etale R₀ C := RingHom.etale_algebraMap.mp hg
      obtain ⟨𝔪, h𝔪_max⟩ := Ideal.exists_maximal C
      have _ : 𝔪.IsMaximal := h𝔪_max
      have h𝔪_prime : 𝔪.IsPrime := h𝔪_max.isPrime
      have _ : 𝔪.IsPrime := h𝔪_prime
      let 𝔪₀ : Ideal R₀ := Ideal.comap (algebraMap R₀ C) 𝔪
      have _ : 𝔪₀.IsPrime := Ideal.IsPrime.comap (algebraMap R₀ C)
      obtain ⟨k, π, hπ_surj⟩ :=
        (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R₀) (S := C)).mp inferInstance
      let M_k : Ideal (MvPolynomial (Fin k) R₀) := Ideal.comap π.toRingHom 𝔪
      have hMk_max : M_k.IsMaximal := Ideal.comap_isMaximal_of_surjective π.toRingHom hπ_surj
      have h𝔪₀_max' : (Ideal.comap (algebraMap R₀ (MvPolynomial (Fin k) R₀)) M_k).IsMaximal :=
        hJacobsonMv k R₀ M_k hMk_max
      have h𝔪₀_eq : Ideal.comap (algebraMap R₀ (MvPolynomial (Fin k) R₀)) M_k = 𝔪₀ := by
        ext r
        simp only [M_k, 𝔪₀, Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          π.commutes]
      have h𝔪₀_max : 𝔪₀.IsMaximal := h𝔪₀_eq ▸ h𝔪₀_max'
      have h𝔪₀_ne_bot : 𝔪₀ ≠ ⊥ := by
        intro hbot
        have hbot_max : (⊥ : Ideal R₀).IsMaximal := hbot ▸ h𝔪₀_max
        let ev₀ : R₀ →+* Ω := MvPolynomial.eval (fun _ : Fin 1 => (0 : Ω))
        let I : Ideal R₀ := RingHom.ker ev₀
        have hI_ne_top : I ≠ ⊤ := by
          intro htop
          have h1 : (1 : R₀) ∈ I := htop.symm ▸ Submodule.mem_top
          rw [RingHom.mem_ker, map_one] at h1
          exact one_ne_zero h1
        have hI_eq_bot : I = ⊥ := (hbot_max.eq_of_le hI_ne_top bot_le).symm
        have hX_mem : MvPolynomial.X (0 : Fin 1) ∈ I :=
          MvPolynomial.eval_X (0 : Fin 1)
        rw [hI_eq_bot, Ideal.mem_bot] at hX_mem
        exact MvPolynomial.X_ne_zero (0 : Fin 1) hX_mem
      have h_lt₀ : (⊥ : Ideal R₀) < 𝔪₀ := bot_lt_iff_ne_bot.mpr h𝔪₀_ne_bot
      have _ : (⊥ : Ideal R₀).IsPrime := hbot_prime R₀
      have _ : Algebra.HasGoingDown R₀ C := Algebra.HasGoingDown.of_flat
      have _ : 𝔪.LiesOver 𝔪₀ := ⟨rfl⟩
      obtain ⟨𝔮, h𝔮_lt, h𝔮_prime, _⟩ := Ideal.exists_ideal_lt_liesOver_of_lt 𝔪 h_lt₀
      exact ⟨𝔮, 𝔪, h𝔮_prime, h𝔪_prime, h𝔮_lt⟩
    have hChartShrink : ∀ (O : Set ↥F_mid), IsOpen O → O.Nonempty →
        ∃ (W : F_mid.Opens) (_ : AlgebraicGeometry.IsAffineOpen W)
          (g : MvPolynomial (Fin 1) Ω →+* ↑(F_mid.presheaf.obj (Opposite.op W))),
          (W : Set ↥F_mid) ⊆ O ∧ Nonempty ↥W ∧ g.Etale := by
      intro O hO_open ⟨y, hyO⟩
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      obtain ⟨U_Ω, _, V₀, hAff_V₀, hy_V₀, e₀, hStd₀⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 q_mid).mp inferInstance y
      obtain ⟨f, hW_le_O, hy_W⟩ :=
        hAff_V₀.exists_basicOpen_le (V := ⟨O, hO_open⟩) ⟨y, hyO⟩ hy_V₀
      let W : F_mid.Opens := F_mid.basicOpen f
      have hAff_W : AlgebraicGeometry.IsAffineOpen W := hAff_V₀.basicOpen f
      have hW_le_V₀ : W ≤ V₀ := F_mid.basicOpen_le f
      have e_W : W ≤ (TopologicalSpace.Opens.map q_mid.base).obj U_Ω := hW_le_V₀.trans e₀
      let ρ_mor := F_mid.presheaf.map (CategoryTheory.homOfLE hW_le_V₀).op
      have happ_eq : q_mid.appLE U_Ω W e_W = q_mid.appLE U_Ω V₀ e₀ ≫ ρ_mor :=
        (AlgebraicGeometry.Scheme.Hom.appLE_map q_mid e₀ (CategoryTheory.homOfLE hW_le_V₀).op).symm
      have hhom_eq : (q_mid.appLE U_Ω W e_W).hom =
          ρ_mor.hom.comp (q_mid.appLE U_Ω V₀ e₀).hom := by
        rw [happ_eq, CommRingCat.hom_comp]
      have hStd_W : RingHom.IsStandardSmoothOfRelativeDimension 1 (q_mid.appLE U_Ω W e_W).hom := by
        let _ : Algebra ↑(F_mid.presheaf.obj (Opposite.op V₀))
            ↑(F_mid.presheaf.obj (Opposite.op W)) := ρ_mor.hom.toAlgebra
        have _ : IsLocalization.Away f ↑(F_mid.presheaf.obj (Opposite.op W)) :=
          hAff_V₀.isLocalization_basicOpen f
        have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0 ρ_mor.hom :=
          RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway f
        rw [hhom_eq]
        simpa using RingHom.IsStandardSmoothOfRelativeDimension.comp h0 hStd₀
      have hqy_UΩ : q_mid.base y ∈ U_Ω := e₀ hy_V₀
      have hbot_Ω : ∀ p : PrimeSpectrum Ω, p.asIdeal = ⊥ := fun p =>
        (Ideal.bot_isMaximal.eq_of_le p.isPrime.ne_top bot_le).symm
      have hUΩ_top : U_Ω = ⊤ := eq_top_iff.mpr fun z _ => by
        have hz : z = q_mid.base y :=
          PrimeSpectrum.ext ((hbot_Ω z).trans (hbot_Ω (q_mid.base y)).symm)
        rwa [hz]
      let iso_Ω : CommRingCat.of Ω ≅ S_Ω.presheaf.obj (Opposite.op U_Ω) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm ≪≫
          S_Ω.presheaf.mapIso (CategoryTheory.eqToIso hUΩ_top).op
      have hStd_ΩW : RingHom.IsStandardSmoothOfRelativeDimension 1
          ((q_mid.appLE U_Ω W e_W).hom.comp iso_Ω.hom.hom) :=
        ((@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).cancel_left_isIso
          iso_Ω.hom (q_mid.appLE U_Ω W e_W)).mpr hStd_W
      obtain ⟨g, _, hg_et⟩ := hStd_ΩW.exists_etale_mvPolynomial
      exact ⟨W, hAff_W, g, hW_le_O, ⟨⟨y, hy_W⟩⟩, hg_et⟩
    have hSpecDense : ∀ (y₀ y₁ : ↥F_mid), y₀ ≠ y₁ →
        y₀ ∈ closure ({y₁} : Set ↥F_mid) →
        closure ({ν_s.base y₁} : Set ↥F_sh) = Set.univ := by
      intro y₀ y₁ hy_ne hy_cl
      obtain ⟨U_sh, hAff_Ush, hy₀_Ush, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (show ν_s.base y₀ ∈ (⊤ : F_sh.Opens) from trivial)
      have himg_cl : ν_s.base y₀ ∈ closure ({ν_s.base y₁} : Set ↥F_sh) := by
        have h := mem_closure_image ν_s.continuous.continuousAt hy_cl
        rwa [Set.image_singleton] at h
      have hy₁_Ush : ν_s.base y₁ ∈ U_sh := by
        obtain ⟨z, hz_U, hz_eq⟩ := (mem_closure_iff.mp himg_cl) (U_sh : Set ↥F_sh)
          U_sh.isOpen hy₀_Ush
        rw [Set.mem_singleton_iff] at hz_eq
        exact hz_eq ▸ hz_U
      let W_mid : F_mid.Opens := (TopologicalSpace.Opens.map ν_s.base).obj U_sh
      have hy₀_Wmid : y₀ ∈ (W_mid : Set ↥F_mid) := hy₀_Ush
      have hy₁_Wmid : y₁ ∈ (W_mid : Set ↥F_mid) := hy₁_Ush
      obtain ⟨hAffHom_ν, hFin_app⟩ := (AlgebraicGeometry.isFinite_iff ν_s).mp inferInstance
      have _ : AlgebraicGeometry.IsAffineHom ν_s := hAffHom_ν
      have hAff_Wmid : AlgebraicGeometry.IsAffineOpen W_mid :=
        AlgebraicGeometry.IsAffineHom.isAffine_preimage U_sh hAff_Ush
      let R_sh : Type u := ↑(F_sh.presheaf.obj (Opposite.op U_sh))
      let A_mid : Type u := ↑(F_mid.presheaf.obj (Opposite.op W_mid))
      let α_mor := ν_s.appLE U_sh W_mid (le_refl W_mid)
      have hα_eq : α_mor = ν_s.app U_sh := AlgebraicGeometry.Scheme.Hom.appLE_eq_app ν_s
      have hα_fin : α_mor.hom.Finite := by
        rw [hα_eq]
        exact hFin_app U_sh hAff_Ush
      have hα_int : α_mor.hom.IsIntegral := hα_fin.to_isIntegral
      have hy₀_rng : y₀ ∈ Set.range ⇑hAff_Wmid.fromSpec := by
        rw [hAff_Wmid.range_fromSpec]
        exact hy₀_Wmid
      have hy₁_rng : y₁ ∈ Set.range ⇑hAff_Wmid.fromSpec := by
        rw [hAff_Wmid.range_fromSpec]
        exact hy₁_Wmid
      obtain ⟨Q₀, hQ₀_eq⟩ := hy₀_rng
      obtain ⟨Q₁, hQ₁_eq⟩ := hy₁_rng
      have hQ_ne : Q₀ ≠ Q₁ := by
        intro heq
        apply hy_ne
        rw [← hQ₀_eq, ← hQ₁_eq, heq]
      have hemb_W : Topology.IsEmbedding ⇑hAff_Wmid.fromSpec :=
        hAff_Wmid.fromSpec.isOpenEmbedding.isEmbedding
      have hQ_cl : Q₀ ∈ closure ({Q₁} : Set ↥(AlgebraicGeometry.Spec (F_mid.presheaf.obj (Opposite.op W_mid)))) := by
        rw [hemb_W.closure_eq_preimage_closure_image]
        change ⇑hAff_Wmid.fromSpec Q₀ ∈ closure (⇑hAff_Wmid.fromSpec '' {Q₁})
        rw [Set.image_singleton, hQ₀_eq, hQ₁_eq]
        exact hy_cl
      let q₀ : PrimeSpectrum A_mid := Q₀
      let q₁ : PrimeSpectrum A_mid := Q₁
      have hq_le : q₁ ≤ q₀ := (PrimeSpectrum.le_iff_mem_closure q₁ q₀).mpr hQ_cl
      have hq_ne_ideal : q₁.asIdeal ≠ q₀.asIdeal := by
        intro heq
        exact hQ_ne (PrimeSpectrum.ext heq.symm)
      have hq_lt : q₁.asIdeal < q₀.asIdeal := lt_of_le_of_ne hq_le hq_ne_ideal
      obtain ⟨a, ha_mem⟩ := Set.nonempty_of_ssubset hq_lt
      let _ : Algebra R_sh A_mid := α_mor.hom.toAlgebra
      have _ : q₁.asIdeal.IsPrime := q₁.isPrime
      have h_under_lt : Ideal.under R_sh q₁.asIdeal < Ideal.under R_sh q₀.asIdeal :=
        Ideal.under_lt_under_of_integral_mem_sdiff hq_le ha_mem (hα_int a)
      let P₁ : PrimeSpectrum R_sh := PrimeSpectrum.comap α_mor.hom q₁
      let P₀ : PrimeSpectrum R_sh := PrimeSpectrum.comap α_mor.hom q₀
      have hP_lt : P₁ < P₀ := lt_of_le_of_ne (le_of_lt h_under_lt)
        (fun heq => (ne_of_lt h_under_lt) (congrArg PrimeSpectrum.asIdeal heq))
      have _ : Nonempty ↥(U_sh : AlgebraicGeometry.Scheme) := ⟨⟨ν_s.base y₀, hy₀_Ush⟩⟩
      have _ : IsDomain R_sh := AlgebraicGeometry.IsIntegral.component_integral U_sh
      let P_bot : PrimeSpectrum R_sh := ⟨⊥, hbot_prime R_sh⟩
      have hbot_le : P_bot ≤ P₁ := bot_le
      let e_U := AlgebraicGeometry.Scheme.homeoOfIso hAff_Ush.isoSpec
      have hdim1 : topologicalKrullDim ↥U_sh.toScheme =
          topologicalKrullDim ↥(AlgebraicGeometry.Spec (F_sh.presheaf.obj (Opposite.op U_sh))) :=
        IsHomeomorph.topologicalKrullDim_eq e_U e_U.isHomeomorph
      have hdim2 : topologicalKrullDim ↥U_sh.toScheme ≤ topologicalKrullDim ↥F_sh :=
        topologicalKrullDim_subspace_le ↥F_sh (U_sh : Set ↥F_sh)
      have hkrull_le : Order.krullDim (PrimeSpectrum R_sh) ≤ (1 : WithBot ℕ∞) := by
        change ringKrullDim R_sh ≤ (1 : WithBot ℕ∞)
        rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim R_sh]
        change topologicalKrullDim ↥(AlgebraicGeometry.Spec (F_sh.presheaf.obj (Opposite.op U_sh))) ≤ _
        rw [← hdim1, ← hDim]
        exact hdim2
      have hP₁_eq_bot : P₁ = P_bot := by
        by_contra hne
        have hbot_lt : P_bot < P₁ := lt_of_le_of_ne hbot_le (Ne.symm hne)
        let s0 : LTSeries (PrimeSpectrum R_sh) := RelSeries.singleton _ P₀
        let s1 : LTSeries (PrimeSpectrum R_sh) := RelSeries.cons s0 P₁ hP_lt
        let s2 : LTSeries (PrimeSpectrum R_sh) := RelSeries.cons s1 P_bot hbot_lt
        have hlen : (2 : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum R_sh) :=
          Order.LTSeries.length_le_krullDim s2
        have hbad : (2 : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) := le_trans hlen hkrull_le
        revert hbad
        decide
      have hSpec_comm :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ν_s hAff_Ush hAff_Wmid (le_refl W_mid)
      have hfrom_P₁ : ⇑hAff_Ush.fromSpec P₁ = ν_s.base y₁ := by
        have h1 := congrArg
          (fun h : AlgebraicGeometry.Spec (F_mid.presheaf.obj (Opposite.op W_mid)) ⟶ F_sh =>
            h.base Q₁) hSpec_comm
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply,
          AlgebraicGeometry.Scheme.Hom.comp_apply] at h1
        have hmap_Q₁ : (AlgebraicGeometry.Spec.map α_mor).base Q₁ = P₁ :=
          PrimeSpectrum.ext rfl
        change ⇑hAff_Ush.fromSpec ((AlgebraicGeometry.Spec.map α_mor).base Q₁) =
          ν_s.base (⇑hAff_Wmid.fromSpec Q₁) at h1
        rw [hmap_Q₁, hQ₁_eq] at h1
        exact h1
      have hcl_P₁ : closure ({P₁} : Set (PrimeSpectrum R_sh)) = Set.univ := by
        rw [hP₁_eq_bot, PrimeSpectrum.closure_singleton]
        exact PrimeSpectrum.zeroLocus_bot
      have hUsh_sub : (U_sh : Set ↥F_sh) ⊆ closure ({ν_s.base y₁} : Set ↥F_sh) := by
        rw [← hAff_Ush.range_fromSpec]
        rintro _ ⟨p, rfl⟩
        let P₁_sp : ↥(AlgebraicGeometry.Spec (F_sh.presheaf.obj (Opposite.op U_sh))) := P₁
        have hp_cl : p ∈ closure ({P₁_sp} :
            Set ↥(AlgebraicGeometry.Spec (F_sh.presheaf.obj (Opposite.op U_sh)))) := by
          change p ∈ closure ({P₁} : Set (PrimeSpectrum R_sh))
          rw [hcl_P₁]
          trivial
        have himg := mem_closure_image hAff_Ush.fromSpec.continuous.continuousAt hp_cl
        refine closure_mono ?_ himg
        rintro _ ⟨q, hq, rfl⟩
        rw [Set.mem_singleton_iff.mp hq, Set.mem_singleton_iff]
        exact hfrom_P₁
      have _ : IrreducibleSpace ↥F_sh := AlgebraicGeometry.irreducibleSpace_of_isIntegral F_sh
      have hUsh_dense : closure (U_sh : Set ↥F_sh) = Set.univ :=
        (U_sh.isOpen.dense ⟨ν_s.base y₀, hy₀_Ush⟩).closure_eq
      apply Set.eq_univ_of_univ_subset
      rw [← hUsh_dense]
      exact closure_minimal hUsh_sub isClosed_closure
    have hClopenHit : ∀ (S : Set ↥F_mid), IsClopen S → S.Nonempty → z₀ ∈ ν_s.base '' S := by
      intro S hS_clopen hS_ne
      obtain ⟨W, hAff_W, g, hW_sub, ⟨w₀⟩, hg_et⟩ := hChartShrink S hS_clopen.isOpen hS_ne
      let C : Type u := ↑(F_mid.presheaf.obj (Opposite.op W))
      have hw₀_rng : (w₀ : ↥F_mid) ∈ Set.range ⇑hAff_W.fromSpec := by
        rw [hAff_W.range_fromSpec]
        exact w₀.2
      obtain ⟨p_w, -⟩ := hw₀_rng
      have _ : Nontrivial C := PrimeSpectrum.nontrivial p_w
      obtain ⟨𝔮, 𝔪, h𝔮_p, h𝔪_p, h_lt⟩ := hPrimeLt C g hg_et
      let p₁ : PrimeSpectrum C := ⟨𝔮, h𝔮_p⟩
      let p₀ : PrimeSpectrum C := ⟨𝔪, h𝔪_p⟩
      have hp_cl : p₀ ∈ closure ({p₁} : Set (PrimeSpectrum C)) :=
        (PrimeSpectrum.le_iff_mem_closure p₁ p₀).mp (le_of_lt h_lt)
      have hp_ne : p₀ ≠ p₁ := by
        intro heq
        exact (ne_of_lt h_lt) (congrArg PrimeSpectrum.asIdeal heq).symm
      let y₀ : ↥F_mid := ⇑hAff_W.fromSpec p₀
      let y₁ : ↥F_mid := ⇑hAff_W.fromSpec p₁
      have hy_ne : y₀ ≠ y₁ := fun heq =>
        hp_ne (hAff_W.fromSpec.isOpenEmbedding.injective heq)
      have hy_cl : y₀ ∈ closure ({y₁} : Set ↥F_mid) := by
        let p₀_sp : ↥(AlgebraicGeometry.Spec (F_mid.presheaf.obj (Opposite.op W))) := p₀
        let p₁_sp : ↥(AlgebraicGeometry.Spec (F_mid.presheaf.obj (Opposite.op W))) := p₁
        have hp_cl_sp : p₀_sp ∈ closure ({p₁_sp} :
            Set ↥(AlgebraicGeometry.Spec (F_mid.presheaf.obj (Opposite.op W)))) := hp_cl
        have himg := mem_closure_image hAff_W.fromSpec.continuous.continuousAt hp_cl_sp
        refine closure_mono ?_ himg
        rintro _ ⟨q, hq, rfl⟩
        rw [Set.mem_singleton_iff.mp hq, Set.mem_singleton_iff]
      have hy₁_S : y₁ ∈ S := by
        apply hW_sub
        rw [← hAff_W.range_fromSpec]
        exact ⟨p₁, rfl⟩
      have hDense : closure ({ν_s.base y₁} : Set ↥F_sh) = Set.univ :=
        hSpecDense y₀ y₁ hy_ne hy_cl
      have hClosed_img : IsClosed (ν_s.base '' S) := ν_s.isClosedMap S hS_clopen.isClosed
      have huniv_sub : (Set.univ : Set ↥F_sh) ⊆ ν_s.base '' S := by
        rw [← hDense]
        exact closure_minimal (Set.singleton_subset_iff.mpr ⟨y₁, hy₁_S, rfl⟩) hClosed_img
      exact huniv_sub trivial
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨z_tilde₀⟩, fun O hO => ?_⟩
    rcases Set.eq_empty_or_nonempty O with rfl | hO_ne
    · exact Or.inl rfl
    · rcases Set.eq_empty_or_nonempty Oᶜ with hOc_emp | hOc_ne
      · refine Or.inr (Set.eq_univ_of_forall fun x => ?_)
        by_contra hx
        have hx_emp : x ∈ (∅ : Set ↥F_mid) := hOc_emp ▸ hx
        exact hx_emp
      · exfalso
        obtain ⟨x₁, hx₁_O, hx₁_eq⟩ := hClopenHit O hO hO_ne
        obtain ⟨x₂, hx₂_Oc, hx₂_eq⟩ := hClopenHit Oᶜ hO.compl hOc_ne
        have hx₁_z : x₁ = z_tilde₀ := by
          have hmem : x₁ ∈ ν_s.base ⁻¹' ({z₀} : Set ↥F_sh) := hx₁_eq
          rwa [hSing, Set.mem_singleton_iff] at hmem
        have hx₂_z : x₂ = z_tilde₀ := by
          have hmem : x₂ ∈ ν_s.base ⁻¹' ({z₀} : Set ↥F_sh) := hx₂_eq
          rwa [hSing, Set.mem_singleton_iff] at hmem
        rw [hx₁_z] at hx₁_O
        rw [hx₂_z] at hx₂_Oc
        exact hx₂_Oc hx₁_O
  · intro Y_tilde V _ f_tilde _ hGeom
    have hFib : ∀ v : ↥V, IsIrreducible (f_tilde.base ⁻¹' ({v} : Set ↥V)) := by
      intro v
      let K_v : Type u := ↑(V.residueField v)
      let Ω_v : Type u := AlgebraicClosure K_v
      let ι_v : AlgebraicGeometry.Spec (CommRingCat.of Ω_v) ⟶ AlgebraicGeometry.Spec (V.residueField v) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K_v Ω_v))
      let s_v : AlgebraicGeometry.Spec (CommRingCat.of Ω_v) ⟶ V :=
        ι_v ≫ V.fromSpecResidueField v
      have hrng_sv : Set.range ⇑s_v = ({v} : Set ↥V) := by
        ext w
        simp only [Set.mem_range, Set.mem_singleton_iff]
        constructor
        · rintro ⟨q, rfl⟩
          have hmem : (V.fromSpecResidueField v).base (ι_v.base q) ∈
              Set.range ⇑(V.fromSpecResidueField v) := ⟨ι_v.base q, rfl⟩
          rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField v, Set.mem_singleton_iff] at hmem
        · intro hw
          rw [hw]
          let q₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_v)) :=
            (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω_v)
          refine ⟨q₀, ?_⟩
          have hmem : (V.fromSpecResidueField v).base (ι_v.base q₀) ∈
              Set.range ⇑(V.fromSpecResidueField v) := ⟨ι_v.base q₀, rfl⟩
          rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField v, Set.mem_singleton_iff] at hmem
      have _ : IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_tilde s_v) := hGeom Ω_v s_v
      let fst_v := CategoryTheory.Limits.pullback.fst f_tilde s_v
      have hIrred_img : IsIrreducible (⇑fst_v '' (Set.univ : Set ↥(CategoryTheory.Limits.pullback f_tilde s_v))) :=
        (IrreducibleSpace.isIrreducible_univ ↥(CategoryTheory.Limits.pullback f_tilde s_v)).image
          (⇑fst_v) fst_v.continuous.continuousOn
      rw [Set.image_univ, AlgebraicGeometry.Scheme.Pullback.range_fst, hrng_sv] at hIrred_img
      exact hIrred_img
    have _ : IrreducibleSpace ↥V := AlgebraicGeometry.irreducibleSpace_of_isIntegral V
    obtain ⟨v₀⟩ := (inferInstance : Nonempty ↥V)
    obtain ⟨y₀, -⟩ := (hFib v₀).nonempty
    have hNe_Y : Nonempty ↥Y_tilde := ⟨y₀⟩
    have _ : AlgebraicGeometry.Smooth f_tilde :=
      AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 f_tilde
    have hOpen : IsOpenMap ⇑f_tilde := f_tilde.isOpenMap
    have hPre : IsPreirreducible (⇑f_tilde ⁻¹' (Set.univ : Set ↥V)) :=
      (PreirreducibleSpace.isPreirreducible_univ (X := ↥V)).preimage_of_isPreirreducible_fiber
        (⇑f_tilde) hOpen (fun v => (hFib v).isPreirreducible)
    rw [Set.preimage_univ] at hPre
    have _ : PreirreducibleSpace ↥Y_tilde := ⟨hPre⟩
    exact IrreducibleSpace.mk hNe_Y

theorem weil_bezout_special_fiber_stalk_ramification_pow (k : Type u) [Field k]
    (ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (V Y Y_tilde : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V]
    (p_V : Quiver.Hom V (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (v : ↥V)
    (f : Quiver.Hom Y V)
    (ν : Quiver.Hom Y_tilde Y)
    (τ : Quiver.Hom V Y)
    (hτ_sec : CategoryTheory.CategoryStruct.comp τ f = CategoryTheory.CategoryStruct.id V)
    (U_a : Y.Opens)
    (hAff_Ua : AlgebraicGeometry.IsAffineOpen U_a)
    (h_le_a : (⊤ : V.Opens) ≤ (TopologicalSpace.Opens.map τ.base).obj U_a)
    (t_a : ↑(Y.presheaf.obj (Opposite.op U_a)))
    (hker_a : RingHom.ker ((τ.appLE U_a ⊤ h_le_a).hom) = Ideal.span {t_a})
    (u_ram : Units ↑(Y.presheaf.obj (Opposite.op U_a)))
    (ι_a : Quiver.Hom
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Polynomial ↑(Y.presheaf.obj (Opposite.op U_a)) ⧸
          Ideal.span {Polynomial.X ^ ℓ -
            Polynomial.C ((u_ram : ↑(Y.presheaf.obj (Opposite.op U_a))) * t_a)})))
      Y_tilde)
    (hPb_a : CategoryTheory.IsPullback ι_a
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp Polynomial.C)))
        hAff_Ua.isoSpec.inv)
      ν U_a.ι)
    (s_sh : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V)
    (C₀ C'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_C₀ : Quiver.Hom C₀.left Y)
    (ι_C'₀ : Quiver.Hom C'₀.left Y_tilde)
    (ν₀ : Quiver.Hom C'₀.left C₀.left)
    (hs_range : Set.range s_sh.base = {v})
    (hs_sec : CategoryTheory.CategoryStruct.comp s_sh p_V =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hPb₀ : CategoryTheory.IsPullback ι_C₀ C₀.hom f s_sh)
    (hPb'₀ : CategoryTheory.IsPullback ι_C'₀ C'₀.hom
      (CategoryTheory.CategoryStruct.comp ν f) s_sh)
    (hComm : CategoryTheory.CategoryStruct.comp ι_C'₀ ν =
      CategoryTheory.CategoryStruct.comp ν₀ ι_C₀)
    (P_a : ↥C₀.left)
    (hPa : ι_C₀.base P_a = τ.base v)
    (x' : ↥C'₀.left)
    (hν₀_x' : ν₀.base x' = P_a) :
    Ideal.map (AlgebraicGeometry.Scheme.Hom.stalkMap ν₀ x').hom
      (IsLocalRing.maximalIdeal ↑(C₀.left.presheaf.stalk (ν₀.base x'))) =
      (IsLocalRing.maximalIdeal ↑(C'₀.left.presheaf.stalk x')) ^ ℓ :=
by
  rcases hν₀_x' with rfl
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hν₀_over : ν₀ ≫ C₀.hom = C'₀.hom := by
    calc ν₀ ≫ C₀.hom
      _ = (ν₀ ≫ C₀.hom) ≫ 𝟙 S_k := (CategoryTheory.Category.comp_id _).symm
      _ = ν₀ ≫ (C₀.hom ≫ s_sh) ≫ p_V := by
        rw [← hs_sec]; simp only [CategoryTheory.Category.assoc]
      _ = (ν₀ ≫ ι_C₀) ≫ f ≫ p_V := by
        rw [← hPb₀.w]; simp only [CategoryTheory.Category.assoc]
      _ = (ι_C'₀ ≫ (ν ≫ f)) ≫ p_V := by
        rw [← hComm]; simp only [CategoryTheory.Category.assoc]
      _ = C'₀.hom ≫ (s_sh ≫ p_V) := by
        rw [hPb'₀.w]; simp only [CategoryTheory.Category.assoc]
      _ = C'₀.hom := by rw [hs_sec, CategoryTheory.Category.comp_id]
  have hPb'₀_rew : CategoryTheory.IsPullback ι_C'₀ (ν₀ ≫ C₀.hom) (ν ≫ f) s_sh :=
    hν₀_over.symm ▸ hPb'₀
  have hPb_top : CategoryTheory.IsPullback ι_C'₀ ν₀ ν ι_C₀ :=
    CategoryTheory.IsPullback.of_bot hPb'₀_rew hComm hPb₀

  have hs_appTop_surj : Function.Surjective s_sh.appTop.hom := by
    intro z
    refine ⟨p_V.appTop.hom z, ?_⟩
    have hcomp : p_V.appTop ≫ s_sh.appTop = 𝟙 _ := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hs_sec]
      rfl
    exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hcomp) z
  have hs_cl : AlgebraicGeometry.IsClosedImmersion s_sh :=
    AlgebraicGeometry.IsClosedImmersion.of_surjective_of_isAffine s_sh hs_appTop_surj
  have hιC₀_cl : AlgebraicGeometry.IsClosedImmersion ι_C₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₀.flip hs_cl
  let O_a : C₀.left.Opens := (TopologicalSpace.Opens.map ι_C₀.base).obj U_a
  have hAff_Oa : AlgebraicGeometry.IsAffineOpen O_a := hAff_Ua.preimage ι_C₀
  have hSurj_Oa : Function.Surjective (ι_C₀.app U_a).hom :=
    ι_C₀.app_surjective U_a hAff_Ua
  have hPa_mem : ν₀.base x' ∈ O_a := by
    change ι_C₀.base (ν₀.base x') ∈ U_a
    rw [hPa]
    exact h_le_a (show v ∈ (⊤ : V.Opens) from trivial)

  have hPrimeIdeal_comap :
      ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (g : X ⟶ Z)
        {W : Z.Opens} {U : X.Opens}
        (hAff_W : AlgebraicGeometry.IsAffineOpen W)
        (hAff_U : AlgebraicGeometry.IsAffineOpen U)
        (hle : U ≤ (TopologicalSpace.Opens.map g.base).obj W)
        (y : ↥X) (hy : y ∈ U),
        Ideal.comap (g.appLE W U hle).hom (hAff_U.primeIdealOf ⟨y, hy⟩).asIdeal =
          (hAff_W.primeIdealOf ⟨g.base y, hle hy⟩).asIdeal := by
    intro X Z g W U hAff_W hAff_U hle y hy
    have hgy : g.base y ∈ W := hle hy
    have hU_eq : (hAff_U.primeIdealOf ⟨y, hy⟩).asIdeal =
        Ideal.comap (X.presheaf.germ U y hy).hom
          (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk y)) := by
      rw [hAff_U.primeIdealOf_eq_map_closedPoint ⟨y, hy⟩]
      rfl
    have hW_eq : (hAff_W.primeIdealOf ⟨g.base y, hgy⟩).asIdeal =
        Ideal.comap (Z.presheaf.germ W (g.base y) hgy).hom
          (IsLocalRing.maximalIdeal ↑(Z.presheaf.stalk (g.base y))) := by
      rw [hAff_W.primeIdealOf_eq_map_closedPoint ⟨g.base y, hgy⟩]
      rfl
    have hloc : Ideal.comap (g.stalkMap y).hom
        (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk y)) =
        IsLocalRing.maximalIdeal ↑(Z.presheaf.stalk (g.base y)) := by
      ext r
      simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        isUnit_map_iff]
    have hgerm_comm : (g.appLE W U hle) ≫ X.presheaf.germ U y hy =
        Z.presheaf.germ W (g.base y) hgy ≫ g.stalkMap y := by
      dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
      rw [CategoryTheory.Category.assoc, X.presheaf.germ_res (CategoryTheory.homOfLE hle) y hy]
      exact (g.germ_stalkMap W y hgy).symm
    rw [hU_eq, hW_eq, ← hloc]
    ext r
    simp only [Ideal.mem_comap]
    have hr := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hgerm_comm) r
    change (X.presheaf.germ U y hy).hom ((g.appLE W U hle).hom r) =
      (g.stalkMap y).hom ((Z.presheaf.germ W (g.base y) hgy).hom r) at hr
    rw [hr]

  let σ₀ : S_k ⟶ C₀.left :=
    hPb₀.lift (s_sh ≫ τ) (𝟙 S_k) (by
      rw [CategoryTheory.Category.assoc, hτ_sec,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hσ₀_ι : σ₀ ≫ ι_C₀ = s_sh ≫ τ := hPb₀.lift_fst _ _ _
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hSub_Sk : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hs_pt : s_sh.base pt_k = v := by
    have hmem : s_sh.base pt_k ∈ Set.range s_sh.base := ⟨pt_k, rfl⟩
    rwa [hs_range, Set.mem_singleton_iff] at hmem
  have hσ₀_pt : σ₀.base pt_k = ν₀.base x' := by
    apply ι_C₀.isClosedEmbedding.injective
    have h1 : (σ₀ ≫ ι_C₀).base pt_k = (s_sh ≫ τ).base pt_k :=
      congrArg (fun m : S_k ⟶ Y => m.base pt_k) hσ₀_ι
    change ι_C₀.base (σ₀.base pt_k) = τ.base (s_sh.base pt_k) at h1
    rw [hs_pt, ← hPa] at h1
    exact h1
  have h_le_σ₀ : (⊤ : S_k.Opens) ≤ (TopologicalSpace.Opens.map σ₀.base).obj O_a := by
    intro y _
    rw [hSub_Sk.elim y pt_k]
    change σ₀.base pt_k ∈ O_a
    rw [hσ₀_pt]
    exact hPa_mem
  have hAff_Sk : AlgebraicGeometry.IsAffineOpen (⊤ : S_k.Opens) :=
    AlgebraicGeometry.isAffineOpen_top S_k
  have hPrime_Sk_bot : (hAff_Sk.primeIdealOf ⟨pt_k, trivial⟩).asIdeal = ⊥ := by
    let p_Sk := hAff_Sk.primeIdealOf ⟨pt_k, trivial⟩
    let e_k := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    rw [Submodule.eq_bot_iff]
    intro r hr
    by_contra hr0
    have hne : e_k.hom.hom r ≠ 0 := by
      intro h0
      apply hr0
      have hinv := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom e_k.hom_inv_id) r
      change e_k.inv.hom (e_k.hom.hom r) = r at hinv
      rw [h0, map_zero] at hinv
      exact hinv.symm
    have hunit_k : IsUnit (e_k.hom.hom r) := IsUnit.mk0 _ hne
    have hunit_r : IsUnit r := by
      have hinv := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom e_k.hom_inv_id) r
      change e_k.inv.hom (e_k.hom.hom r) = r at hinv
      rw [← hinv]
      exact hunit_k.map e_k.inv.hom
    exact p_Sk.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hr hunit_r)

  let ev_P := σ₀.appLE O_a ⊤ h_le_σ₀
  have hPa_prime_ker :
      (hAff_Oa.primeIdealOf ⟨ν₀.base x', hPa_mem⟩).asIdeal = RingHom.ker ev_P.hom := by
    have hcomap := hPrimeIdeal_comap σ₀ hAff_Oa hAff_Sk h_le_σ₀ pt_k trivial
    have hpt_eq : (⟨σ₀.base pt_k, h_le_σ₀ trivial⟩ : ↥O_a) = ⟨ν₀.base x', hPa_mem⟩ :=
      Subtype.ext hσ₀_pt
    rw [hpt_eq, hPrime_Sk_bot] at hcomap
    exact hcomap.symm

  let σ_B := s_sh.appLE ⊤ ⊤ le_top
  let α_a := f.appLE ⊤ U_a le_top
  let π_a := τ.appLE U_a ⊤ h_le_a
  let j_a := ι_C₀.app U_a
  let ι_k := C₀.hom.appLE ⊤ O_a le_top

  have h_appLE_congr :
      ∀ {X Z : AlgebraicGeometry.Scheme.{u}} {g₁ g₂ : X ⟶ Z} (hg : g₁ = g₂)
        (W : Z.Opens) (U : X.Opens)
        (e₁ : U ≤ (TopologicalSpace.Opens.map g₁.base).obj W)
        (e₂ : U ≤ (TopologicalSpace.Opens.map g₂.base).obj W),
        g₁.appLE W U e₁ = g₂.appLE W U e₂ := by
    intro X Z g₁ g₂ hg W U e₁ e₂
    subst hg
    rfl

  have h_ja_ev : j_a ≫ ev_P = π_a ≫ σ_B := by
    have h1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE σ₀ ι_C₀ U_a O_a ⊤ le_rfl h_le_σ₀
    have h2 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE s_sh τ U_a ⊤ ⊤ h_le_a le_top
    change ι_C₀.app U_a ≫ ev_P = π_a ≫ σ_B
    rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, h1, h2]
    exact h_appLE_congr hσ₀_ι U_a ⊤ _ _

  have h_αa_ja : α_a ≫ j_a = σ_B ≫ ι_k := by
    have h1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_C₀ f ⊤ U_a O_a le_top le_rfl
    have h2 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE C₀.hom s_sh ⊤ ⊤ O_a le_top le_top
    change α_a ≫ ι_C₀.app U_a = σ_B ≫ ι_k
    rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, h1, h2]
    exact h_appLE_congr hPb₀.w ⊤ O_a _ _

  have h_αa_πa : α_a ≫ π_a = 𝟙 (V.presheaf.obj (Opposite.op ⊤)) := by
    have h1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE τ f ⊤ U_a ⊤ le_top h_le_a
    have h2 : (𝟙 V : V ⟶ V).appLE ⊤ ⊤ le_top = 𝟙 (V.presheaf.obj (Opposite.op ⊤)) := by
      dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
      rw [CategoryTheory.Category.id_comp]
      exact V.presheaf.map_id _
    rw [h1, h_appLE_congr hτ_sec ⊤ ⊤ _ le_top, h2]

  have hP_span :
      (hAff_Oa.primeIdealOf ⟨ν₀.base x', hPa_mem⟩).asIdeal =
        Ideal.span {j_a.hom t_a} := by
    rw [hPa_prime_ker]
    apply le_antisymm
    · intro y hy
      rw [RingHom.mem_ker] at hy
      obtain ⟨r, rfl⟩ := hSurj_Oa y
      have hπ_diff : r - α_a.hom (π_a.hom r) ∈ RingHom.ker π_a.hom := by
        rw [RingHom.mem_ker, map_sub]
        have hid := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_αa_πa) (π_a.hom r)
        change π_a.hom (α_a.hom (π_a.hom r)) = π_a.hom r at hid
        rw [hid, sub_self]
      rw [hker_a, Ideal.mem_span_singleton] at hπ_diff
      obtain ⟨q, hq⟩ := hπ_diff
      have hr_eq : r = α_a.hom (π_a.hom r) + t_a * q := by
        calc r = α_a.hom (π_a.hom r) + (r - α_a.hom (π_a.hom r)) := (add_sub_cancel _ _).symm
          _ = α_a.hom (π_a.hom r) + t_a * q := by rw [hq]
      have hαj := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_αa_ja) (π_a.hom r)
      change j_a.hom (α_a.hom (π_a.hom r)) = ι_k.hom (σ_B.hom (π_a.hom r)) at hαj
      have hjev := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_ja_ev) r
      change ev_P.hom (j_a.hom r) = σ_B.hom (π_a.hom r) at hjev
      have hσ0 : σ_B.hom (π_a.hom r) = 0 := hjev.symm.trans hy
      rw [Ideal.mem_span_singleton]
      refine ⟨j_a.hom q, ?_⟩
      calc j_a.hom r
        _ = j_a.hom (α_a.hom (π_a.hom r) + t_a * q) := congrArg j_a.hom hr_eq
        _ = j_a.hom (α_a.hom (π_a.hom r)) + j_a.hom t_a * j_a.hom q := by
          rw [map_add, map_mul]
        _ = ι_k.hom (σ_B.hom (π_a.hom r)) + j_a.hom t_a * j_a.hom q := by rw [hαj]
        _ = j_a.hom t_a * j_a.hom q := by rw [hσ0, map_zero, zero_add]
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      have ht_ker : t_a ∈ RingHom.ker π_a.hom := by
        rw [hker_a]
        exact Ideal.subset_span rfl
      rw [RingHom.mem_ker] at ht_ker
      have hjev := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_ja_ev) t_a
      change ev_P.hom (j_a.hom t_a) = σ_B.hom (π_a.hom t_a) at hjev
      rw [hjev, ht_ker, map_zero]

  let R_a : Type u := ↑(Y.presheaf.obj (Opposite.op U_a))
  let S_a : Type u := Polynomial R_a ⧸
    Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((u_ram : R_a) * t_a)}
  let φ_a : R_a →+* S_a := (Ideal.Quotient.mk _).comp Polynomial.C
  let p_a : AlgebraicGeometry.Spec (CommRingCat.of S_a) ⟶ U_a.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a) ≫ hAff_Ua.isoSpec.inv
  let O'_a : C'₀.left.Opens := (TopologicalSpace.Opens.map ν₀.base).obj O_a
  have hx'_mem : x' ∈ O'_a := hPa_mem

  have hPb_outer : CategoryTheory.IsPullback (ν₀ ∣_ O_a) (O'_a.ι ≫ ι_C'₀) (O_a.ι ≫ ι_C₀) ν :=
    (AlgebraicGeometry.isPullback_morphismRestrict ν₀ O_a).paste_vert hPb_top.flip

  have h_res_C₀ : (ι_C₀ ∣_ U_a) ≫ U_a.ι = O_a.ι ≫ ι_C₀ :=
    AlgebraicGeometry.morphismRestrict_ι ι_C₀ U_a
  have h_res_ν₀ : (ν₀ ∣_ O_a) ≫ O_a.ι = O'_a.ι ≫ ν₀ :=
    AlgebraicGeometry.morphismRestrict_ι ν₀ O_a

  let g'_a : O'_a.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of S_a) :=
    hPb_a.lift (O'_a.ι ≫ ι_C'₀) ((ν₀ ∣_ O_a) ≫ (ι_C₀ ∣_ U_a)) (by
      calc (O'_a.ι ≫ ι_C'₀) ≫ ν
        _ = (ν₀ ∣_ O_a) ≫ (O_a.ι ≫ ι_C₀) := hPb_outer.w.symm
        _ = (ν₀ ∣_ O_a) ≫ ((ι_C₀ ∣_ U_a) ≫ U_a.ι) := by rw [h_res_C₀]
        _ = ((ν₀ ∣_ O_a) ≫ (ι_C₀ ∣_ U_a)) ≫ U_a.ι := by
          rw [← CategoryTheory.Category.assoc])
  have hg'_ι : g'_a ≫ ι_a = O'_a.ι ≫ ι_C'₀ := hPb_a.lift_fst _ _ _
  have hg'_p : g'_a ≫ p_a = (ν₀ ∣_ O_a) ≫ (ι_C₀ ∣_ U_a) := hPb_a.lift_snd _ _ _

  have hPb_outer_rew :
      CategoryTheory.IsPullback (ν₀ ∣_ O_a) (g'_a ≫ ι_a) ((ι_C₀ ∣_ U_a) ≫ U_a.ι) ν := by
    rw [hg'_ι, h_res_C₀]
    exact hPb_outer
  have hPb_chart : CategoryTheory.IsPullback (ν₀ ∣_ O_a) g'_a (ι_C₀ ∣_ U_a) p_a :=
    CategoryTheory.IsPullback.of_bot hPb_outer_rew hg'_p.symm hPb_a.flip

  have hιC₀_res_cl : AlgebraicGeometry.IsClosedImmersion (ι_C₀ ∣_ U_a) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (AlgebraicGeometry.isPullback_morphismRestrict ι_C₀ U_a).flip hιC₀_cl
  have hg'_cl : AlgebraicGeometry.IsClosedImmersion g'_a :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_chart hιC₀_res_cl
  have hAff_O'a : AlgebraicGeometry.IsAffineOpen O'_a :=
    (AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine g'_a).1

  let ψ_S_cat : CommRingCat.of S_a ⟶ C'₀.left.presheaf.obj (Opposite.op O'_a) :=
    AlgebraicGeometry.Spec.preimage (hAff_O'a.isoSpec.inv ≫ g'_a)
  let ψ_S : S_a →+* ↑(C'₀.left.presheaf.obj (Opposite.op O'_a)) := ψ_S_cat.hom

  have hSpec_ψ_cl : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map ψ_S_cat) := by
    rw [AlgebraicGeometry.Spec.map_preimage]
    infer_instance
  have hSurj_S : Function.Surjective ψ_S := by
    have hSpec_surj : Function.Surjective (AlgebraicGeometry.Spec.map ψ_S_cat).appTop.hom :=
      (AlgebraicGeometry.IsClosedImmersion.isAffine_surjective_of_isAffine
        (AlgebraicGeometry.Spec.map ψ_S_cat)).2
    have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality ψ_S_cat
    let e_S := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S_a)
    let e_O := AlgebraicGeometry.Scheme.ΓSpecIso (C'₀.left.presheaf.obj (Opposite.op O'_a))
    intro z
    obtain ⟨y₁, hy₁⟩ := e_O.commRingCatIsoToRingEquiv.surjective z
    obtain ⟨y₀, rfl⟩ := hSpec_surj y₁
    refine ⟨e_S.hom.hom y₀, ?_⟩
    have h1 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hnat.symm) y₀
    change ψ_S (e_S.hom.hom y₀) =
      e_O.hom.hom ((AlgebraicGeometry.Spec.map ψ_S_cat).appTop.hom y₀) at h1
    exact h1.trans hy₁

  have hComm_S : ∀ r : R_a, ψ_S (φ_a r) = (ν₀.app O_a).hom (j_a.hom r) := by
    have hSpec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a ≫ ψ_S_cat) =
        AlgebraicGeometry.Spec.map (j_a ≫ ν₀.app O_a) := by
      apply (cancel_mono hAff_Ua.fromSpec).mp
      have hLHS : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a ≫ ψ_S_cat) ≫
          hAff_Ua.fromSpec = hAff_O'a.fromSpec ≫ ν₀ ≫ ι_C₀ := by
        calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a ≫ ψ_S_cat) ≫ hAff_Ua.fromSpec
          _ = AlgebraicGeometry.Spec.map ψ_S_cat ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a) ≫
              hAff_Ua.isoSpec.inv ≫ U_a.ι := by
            rw [AlgebraicGeometry.Spec.map_comp, ← hAff_Ua.isoSpec_inv_ι]
            simp only [CategoryTheory.Category.assoc]
          _ = hAff_O'a.isoSpec.inv ≫ (g'_a ≫ p_a) ≫ U_a.ι := by
            rw [AlgebraicGeometry.Spec.map_preimage]
            simp only [p_a, CategoryTheory.Category.assoc]
          _ = hAff_O'a.isoSpec.inv ≫ (ν₀ ∣_ O_a) ≫ ((ι_C₀ ∣_ U_a) ≫ U_a.ι) := by
            rw [hg'_p]; simp only [CategoryTheory.Category.assoc]
          _ = hAff_O'a.isoSpec.inv ≫ ((ν₀ ∣_ O_a) ≫ O_a.ι) ≫ ι_C₀ := by
            rw [h_res_C₀]; simp only [CategoryTheory.Category.assoc]
          _ = (hAff_O'a.isoSpec.inv ≫ O'_a.ι) ≫ ν₀ ≫ ι_C₀ := by
            rw [h_res_ν₀]; simp only [CategoryTheory.Category.assoc]
          _ = hAff_O'a.fromSpec ≫ ν₀ ≫ ι_C₀ := by rw [hAff_O'a.isoSpec_inv_ι]
      have hRHS : AlgebraicGeometry.Spec.map (j_a ≫ ν₀.app O_a) ≫ hAff_Ua.fromSpec =
          hAff_O'a.fromSpec ≫ ν₀ ≫ ι_C₀ := by
        have h1 : AlgebraicGeometry.Spec.map j_a ≫ hAff_Ua.fromSpec =
            hAff_Oa.fromSpec ≫ ι_C₀ := by
          simpa [j_a, AlgebraicGeometry.Scheme.Hom.app_eq_appLE] using
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι_C₀ hAff_Ua hAff_Oa le_rfl
        have h2 : AlgebraicGeometry.Spec.map (ν₀.app O_a) ≫ hAff_Oa.fromSpec =
            hAff_O'a.fromSpec ≫ ν₀ := by
          simpa [AlgebraicGeometry.Scheme.Hom.app_eq_appLE] using
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ν₀ hAff_Oa hAff_O'a le_rfl
        calc AlgebraicGeometry.Spec.map (j_a ≫ ν₀.app O_a) ≫ hAff_Ua.fromSpec
          _ = AlgebraicGeometry.Spec.map (ν₀.app O_a) ≫
              (AlgebraicGeometry.Spec.map j_a ≫ hAff_Ua.fromSpec) := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Spec.map (ν₀.app O_a) ≫ hAff_Oa.fromSpec) ≫ ι_C₀ := by
            rw [h1, CategoryTheory.Category.assoc]
          _ = hAff_O'a.fromSpec ≫ ν₀ ≫ ι_C₀ := by
            rw [h2, CategoryTheory.Category.assoc]
      exact hLHS.trans hRHS.symm
    have hcat_eq := AlgebraicGeometry.Spec.map_injective hSpec_eq
    intro r
    exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hcat_eq) r

  let Rbar : Type u := ↑(C₀.left.presheaf.obj (Opposite.op O_a))
  let Sbar : Type u := ↑(C'₀.left.presheaf.obj (Opposite.op O'_a))
  let φ_ν₀ : Rbar →+* Sbar := (ν₀.app O_a).hom
  let tbar : Rbar := j_a.hom t_a
  let ubar : Units Rbar := Units.map j_a.hom.toMonoidHom u_ram
  let q_mk : Polynomial R_a →+* S_a := Ideal.Quotient.mk _
  let w : Sbar := ψ_S (q_mk Polynomial.X)

  have hw_pow : w ^ ℓ = φ_ν₀ ((ubar : Rbar) * tbar) := by
    have hS_rel : (q_mk Polynomial.X) ^ ℓ = φ_a ((u_ram : R_a) * t_a) := by
      apply sub_eq_zero.mp
      change q_mk (Polynomial.X ^ ℓ - Polynomial.C ((u_ram : R_a) * t_a)) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    calc w ^ ℓ
      _ = ψ_S ((q_mk Polynomial.X) ^ ℓ) := (map_pow ψ_S _ ℓ).symm
      _ = ψ_S (φ_a ((u_ram : R_a) * t_a)) := by rw [hS_rel]
      _ = φ_ν₀ (j_a.hom ((u_ram : R_a) * t_a)) := hComm_S _
      _ = φ_ν₀ ((ubar : Rbar) * tbar) := by rw [map_mul]; rfl

  have h_decomp : ∀ z : Sbar, ∃ (z₁ : Sbar) (r₀ : Rbar), z = w * z₁ + φ_ν₀ r₀ := by
    intro z
    obtain ⟨s, rfl⟩ := hSurj_S z
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective s
    refine ⟨ψ_S (q_mk p.divX), j_a.hom (p.coeff 0), ?_⟩
    have hp := (Polynomial.X_mul_divX_add p).symm
    calc ψ_S (q_mk p)
      _ = ψ_S (q_mk (Polynomial.X * p.divX + Polynomial.C (p.coeff 0))) :=
        congrArg (fun f => ψ_S (q_mk f)) hp
      _ = w * ψ_S (q_mk p.divX) + ψ_S (φ_a (p.coeff 0)) := by
        rw [map_add q_mk, map_mul q_mk, map_add ψ_S, map_mul ψ_S]
        rfl
      _ = w * ψ_S (q_mk p.divX) + φ_ν₀ (j_a.hom (p.coeff 0)) := by rw [hComm_S]

  let P_pt := hAff_Oa.primeIdealOf ⟨ν₀.base x', hPa_mem⟩
  let Q_pt := hAff_O'a.primeIdealOf ⟨x', hx'_mem⟩
  have hQ_comap : Ideal.comap φ_ν₀ Q_pt.asIdeal = P_pt.asIdeal := by
    simpa [φ_ν₀, AlgebraicGeometry.Scheme.Hom.app_eq_appLE] using
      hPrimeIdeal_comap ν₀ hAff_Oa hAff_O'a le_rfl x' hx'_mem

  have hw_mem_Q : w ∈ Q_pt.asIdeal := by
    have ht_mem_P : tbar ∈ P_pt.asIdeal := by
      rw [hP_span]
      exact Ideal.subset_span rfl
    rw [← hQ_comap, Ideal.mem_comap] at ht_mem_P
    have hw_pow_mem : w ^ ℓ ∈ Q_pt.asIdeal := by
      rw [hw_pow, map_mul]
      exact Ideal.mul_mem_left _ _ ht_mem_P
    exact Q_pt.isPrime.mem_of_pow_mem ℓ hw_pow_mem

  have hQ_span : Q_pt.asIdeal = Ideal.span {w} := by
    apply le_antisymm
    · intro z hz
      obtain ⟨z₁, r₀, rfl⟩ := h_decomp z
      have hφr₀_mem : φ_ν₀ r₀ ∈ Q_pt.asIdeal := by
        have hsub : (w * z₁ + φ_ν₀ r₀) - w * z₁ ∈ Q_pt.asIdeal :=
          Q_pt.asIdeal.sub_mem hz (Ideal.mul_mem_right z₁ _ hw_mem_Q)
        simpa using hsub
      have hr₀_mem : r₀ ∈ P_pt.asIdeal := by
        rw [← hQ_comap]
        exact hφr₀_mem
      rw [hP_span, Ideal.mem_span_singleton] at hr₀_mem
      obtain ⟨q, hq⟩ := hr₀_mem
      let u_S : Units Sbar := Units.map φ_ν₀.toMonoidHom ubar
      have hφt_eq : φ_ν₀ tbar = (↑(u_S⁻¹) : Sbar) * w ^ ℓ := by
        calc φ_ν₀ tbar
          _ = 1 * φ_ν₀ tbar := (one_mul _).symm
          _ = ((↑(u_S⁻¹) : Sbar) * (u_S : Sbar)) * φ_ν₀ tbar := by rw [Units.inv_mul]
          _ = (↑(u_S⁻¹) : Sbar) * (φ_ν₀ (ubar : Rbar) * φ_ν₀ tbar) := by
            simp only [u_S, mul_assoc]; rfl
          _ = (↑(u_S⁻¹) : Sbar) * w ^ ℓ := by rw [← map_mul, ← hw_pow]
      have hℓ_split : w ^ ℓ = w * w ^ (ℓ - 1) := by
        conv_lhs => rw [← Nat.sub_add_cancel hℓ_pos, pow_succ']
      rw [Ideal.mem_span_singleton]
      refine ⟨z₁ + (↑(u_S⁻¹) : Sbar) * w ^ (ℓ - 1) * φ_ν₀ q, ?_⟩
      calc w * z₁ + φ_ν₀ r₀
        _ = w * z₁ + φ_ν₀ tbar * φ_ν₀ q := by rw [hq, map_mul]
        _ = w * z₁ + ((↑(u_S⁻¹) : Sbar) * (w * w ^ (ℓ - 1))) * φ_ν₀ q := by
          rw [hφt_eq, hℓ_split]
        _ = w * (z₁ + (↑(u_S⁻¹) : Sbar) * w ^ (ℓ - 1) * φ_ν₀ q) := by ring
    · exact (Ideal.span_singleton_le_iff_mem _).mpr hw_mem_Q

  letI : Algebra Rbar ↑(C₀.left.presheaf.stalk (ν₀.base x')) :=
    TopCat.Presheaf.algebra_section_stalk C₀.left.presheaf ⟨ν₀.base x', hPa_mem⟩
  letI : Algebra Sbar ↑(C'₀.left.presheaf.stalk x') :=
    TopCat.Presheaf.algebra_section_stalk C'₀.left.presheaf ⟨x', hx'_mem⟩
  haveI : IsLocalization.AtPrime ↑(C₀.left.presheaf.stalk (ν₀.base x')) P_pt.asIdeal :=
    hAff_Oa.isLocalization_stalk ⟨ν₀.base x', hPa_mem⟩
  haveI : IsLocalization.AtPrime ↑(C'₀.left.presheaf.stalk x') Q_pt.asIdeal :=
    hAff_O'a.isLocalization_stalk ⟨x', hx'_mem⟩

  let L_R := ↑(C₀.left.presheaf.stalk (ν₀.base x'))
  let L_S := ↑(C'₀.left.presheaf.stalk x')
  let ψ_stalk : L_R →+* L_S := (AlgebraicGeometry.Scheme.Hom.stalkMap ν₀ x').hom

  have hm_R : IsLocalRing.maximalIdeal L_R = Ideal.span {algebraMap Rbar L_R tbar} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P_pt.asIdeal L_R, hP_span,
      Ideal.map_span, Set.image_singleton]
  have hm_S : IsLocalRing.maximalIdeal L_S = Ideal.span {algebraMap Sbar L_S w} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q_pt.asIdeal L_S, hQ_span,
      Ideal.map_span, Set.image_singleton]

  have hψ_tbar : ψ_stalk (algebraMap Rbar L_R tbar) = algebraMap Sbar L_S (φ_ν₀ tbar) := by
    rw [TopCat.Presheaf.stalk_open_algebraMap C₀.left.presheaf ⟨ν₀.base x', hPa_mem⟩,
      TopCat.Presheaf.stalk_open_algebraMap C'₀.left.presheaf ⟨x', hx'_mem⟩]
    exact ν₀.germ_stalkMap_apply O_a x' hPa_mem tbar

  have hUnit_u : IsUnit (algebraMap Sbar L_S (φ_ν₀ (ubar : Rbar))) :=
    ((Units.map φ_ν₀.toMonoidHom ubar).map (algebraMap Sbar L_S).toMonoidHom).isUnit

  calc Ideal.map ψ_stalk (IsLocalRing.maximalIdeal L_R)
    _ = Ideal.map ψ_stalk (Ideal.span {algebraMap Rbar L_R tbar}) := by rw [hm_R]
    _ = Ideal.span {ψ_stalk (algebraMap Rbar L_R tbar)} := by
      rw [Ideal.map_span, Set.image_singleton]
    _ = Ideal.span {algebraMap Sbar L_S (φ_ν₀ tbar)} := by rw [hψ_tbar]
    _ = Ideal.span {algebraMap Sbar L_S (φ_ν₀ (ubar : Rbar)) *
          algebraMap Sbar L_S (φ_ν₀ tbar)} :=
      (Ideal.span_singleton_mul_left_unit hUnit_u _).symm
    _ = Ideal.span {(algebraMap Sbar L_S w) ^ ℓ} := by
      rw [← map_mul, ← map_mul, ← hw_pow, map_pow]
    _ = (Ideal.span {algebraMap Sbar L_S w}) ^ ℓ :=
      (Ideal.span_singleton_pow _ ℓ).symm
    _ = (IsLocalRing.maximalIdeal L_S) ^ ℓ := by rw [hm_S]

theorem weil_esnault_viehweg_cyclic_gluing_and_bezout_smoothness (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (V_sh Y_sh : AlgebraicGeometry.Scheme.{u})
    (p_Vsh : Quiver.Hom V_sh (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine V_sh] [AlgebraicGeometry.IsIntegral V_sh]
    [AlgebraicGeometry.LocallyOfFiniteType p_Vsh]
    (v_sh : ↥V_sh) (hv_sh_cl : IsClosed ({v_sh} : Set ↥V_sh))
    (f_sh : Quiver.Hom Y_sh V_sh)
    [AlgebraicGeometry.IsProper f_sh] [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_sh]
    (hIntY_sh : AlgebraicGeometry.IsIntegral Y_sh)
    (hIrred_sh : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V_sh),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_sh s))
    (m : ℕ) (hm : 1 ≤ m)
    (τ_sh : Fin m → Quiver.Hom V_sh Y_sh)
    (hτ_sec : ∀ a : Fin m, CategoryTheory.CategoryStruct.comp (τ_sh a) f_sh =
      CategoryTheory.CategoryStruct.id V_sh)
    (hτ_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ_sh a))
    (hτ_disj : _root_.Pairwise fun a b : Fin m =>
      Disjoint (Set.range (τ_sh a).base) (Set.range (τ_sh b).base))
    (U_0 U_1 : Y_sh.Opens)
    (hAff_0 : AlgebraicGeometry.IsAffineOpen U_0)
    (hAff_1 : AlgebraicGeometry.IsAffineOpen U_1)
    (hU_cov : U_0 ⊔ U_1 = ⊤)
    (hU_0_compl : (U_0 : Set ↥Y_sh) = (⋃ a : Fin m, Set.range (τ_sh a).base)ᶜ)
    (t_sh : Fin m → ↑(Y_sh.presheaf.obj (Opposite.op U_1)))
    (ht_sh : ∀ a : Fin m,
      ∃ h_le : (⊤ : V_sh.Opens) ≤ (TopologicalSpace.Opens.map (τ_sh a).base).obj U_1,
        RingHom.ker (((τ_sh a).appLE U_1 ⊤ h_le).hom) = Ideal.span {t_sh a} ∧
        (Y_sh.basicOpen (t_sh a) : Set ↥Y_sh) =
          (U_1 : Set ↥Y_sh) \ Set.range (τ_sh a).base)
    (c : Fin m → ℕ)
    (hc_lt : ∀ a : Fin m, c a < ℓ)
    (hc_pos : ∃ a₀ : Fin m, 1 ≤ c a₀)
    (A₀ : Type u) [CommRing A₀]
    [Algebra ↑(Y_sh.presheaf.obj (Opposite.op U_0)) A₀]
    [Module.Finite ↑(Y_sh.presheaf.obj (Opposite.op U_0)) A₀]
    [Algebra.Etale ↑(Y_sh.presheaf.obj (Opposite.op U_0)) A₀]
    [Module.FaithfullyFlat ↑(Y_sh.presheaf.obj (Opposite.op U_0)) A₀]
    (u₁ : Units ↑(Y_sh.presheaf.obj (Opposite.op U_1)))
    (Φ₀₁ :
      let R₀ := ↑(Y_sh.presheaf.obj (Opposite.op U_0))
      let R₁ := ↑(Y_sh.presheaf.obj (Opposite.op U_1))
      let R₀₁ := ↑(Y_sh.presheaf.obj (Opposite.op (U_0 ⊓ U_1)))
      let ρ₀ : R₀ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
      let ρ₁ : R₁ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
      letI : Algebra R₀ R₀₁ := ρ₀.toAlgebra
      (Polynomial R₀₁ ⧸
        Ideal.span {Polynomial.X ^ ℓ -
          Polynomial.C (ρ₁ ((u₁ : R₁) * Finset.univ.prod fun a : Fin m => (t_sh a) ^ (c a)))}) ≃ₐ[R₀₁]
        TensorProduct R₀ R₀₁ A₀) :
    ∃ (Y_mid0 : AlgebraicGeometry.Scheme.{u})
      (ν : Quiver.Hom Y_mid0 Y_sh)
      (τ_ram : { a : Fin m // 1 ≤ c a } → Quiver.Hom V_sh Y_mid0)
      (Z_et : { a : Fin m // c a = 0 } → AlgebraicGeometry.Scheme.{u})
      (ι_Z : ∀ b : { a : Fin m // c a = 0 }, Quiver.Hom (Z_et b) Y_mid0),
      let f_mid0 := CategoryTheory.CategoryStruct.comp ν f_sh
      let W_mid0 : Y_mid0.Opens := (TopologicalSpace.Opens.map ν.base).obj U_0
      (AlgebraicGeometry.IsFinite ν ∧
        AlgebraicGeometry.Surjective ν ∧
        AlgebraicGeometry.IsIntegral Y_mid0 ∧
        AlgebraicGeometry.IsProper f_mid0 ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 f_mid0 ∧
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V_sh),
          IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_mid0 s)) ∧
        AlgebraicGeometry.IsAffineOpen W_mid0 ∧
        ∃ j₀ : Quiver.Hom W_mid0.toScheme U_0.toScheme,
          CategoryTheory.CategoryStruct.comp j₀ U_0.ι =
            CategoryTheory.CategoryStruct.comp W_mid0.ι ν ∧
          AlgebraicGeometry.IsFinite j₀ ∧
          AlgebraicGeometry.Etale j₀ ∧
          AlgebraicGeometry.Surjective j₀) ∧
      ((∀ a : { a : Fin m // 1 ≤ c a },
          CategoryTheory.CategoryStruct.comp (τ_ram a) ν = τ_sh a.1 ∧
          AlgebraicGeometry.IsClosedImmersion (τ_ram a) ∧
          ν.base ⁻¹' Set.range (τ_sh a.1).base = Set.range (τ_ram a).base) ∧
        (∀ b : { a : Fin m // c a = 0 },
          AlgebraicGeometry.IsClosedImmersion (ι_Z b) ∧
          ν.base ⁻¹' Set.range (τ_sh b.1).base = Set.range (ι_Z b).base ∧
          AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp (ι_Z b) f_mid0) ∧
          AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp (ι_Z b) f_mid0) ∧
          AlgebraicGeometry.Surjective (CategoryTheory.CategoryStruct.comp (ι_Z b) f_mid0))) ∧
      (∀ (s_sh : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V_sh)
          (C₀ C'₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_C₀ : Quiver.Hom C₀.left Y_sh)
          (ι_C'₀ : Quiver.Hom C'₀.left Y_mid0)
          (ν₀ : Quiver.Hom C'₀.left C₀.left),
        Set.range s_sh.base = {v_sh} →
        CategoryTheory.CategoryStruct.comp s_sh p_Vsh =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        CategoryTheory.IsPullback ι_C₀ C₀.hom f_sh s_sh →
        CategoryTheory.IsPullback ι_C'₀ C'₀.hom f_mid0 s_sh →
        CategoryTheory.CategoryStruct.comp ι_C'₀ ν =
          CategoryTheory.CategoryStruct.comp ν₀ ι_C₀ →
        ∀ (a : Fin m), 1 ≤ c a →
          ∀ (P_a : ↥C₀.left),
            ι_C₀.base P_a = (τ_sh a).base v_sh →
            ∀ (x' : ↥C'₀.left),
              IsClosed ({x'} : Set ↥C'₀.left) →
              ν₀.base x' = P_a →
              Ideal.map (AlgebraicGeometry.Scheme.Hom.stalkMap ν₀ x').hom
                (IsLocalRing.maximalIdeal ↑(C₀.left.presheaf.stalk (ν₀.base x'))) =
                (IsLocalRing.maximalIdeal ↑(C'₀.left.presheaf.stalk x')) ^ ℓ) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 1 ≤ ℓ := hPrime.pos
  have : AlgebraicGeometry.IsIntegral Y_sh := hIntY_sh
  have : IrreducibleSpace ↥Y_sh := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_sh
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let R₀ : Type u := ↑(Y_sh.presheaf.obj (Opposite.op U_0))
  let R₁ : Type u := ↑(Y_sh.presheaf.obj (Opposite.op U_1))
  let R₀₁ : Type u := ↑(Y_sh.presheaf.obj (Opposite.op (U_0 ⊓ U_1)))
  let ρ₀ : R₀ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
  let ρ₁ : R₁ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
  let B_cat : CommRingCat.{u} := V_sh.presheaf.obj (Opposite.op ⊤)
  let B : Type u := ↑B_cat

  
  
  
  have hLFT_of_etale :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (g : X₁ ⟶ X₂) [AlgebraicGeometry.Etale g],
        AlgebraicGeometry.LocallyOfFiniteType g := by
    intro X₁ X₂ g _
    have hfp : AlgebraicGeometry.LocallyOfFinitePresentation g := inferInstance
    rw [AlgebraicGeometry.HasRingHomProperty.iff_appLE
      (P := @AlgebraicGeometry.LocallyOfFiniteType)]
    intro U V e
    exact RingHom.FiniteType.of_finitePresentation
      (AlgebraicGeometry.HasRingHomProperty.appLE
        (@AlgebraicGeometry.LocallyOfFinitePresentation) g hfp U V e)

  have hRangeOfIsPullback :
      ∀ {P A₁_s A₂_s C_s : AlgebraicGeometry.Scheme.{u}}
        {g₁ : P ⟶ A₁_s} {g₂ : P ⟶ A₂_s} {f₁ : A₁_s ⟶ C_s} {f₂ : A₂_s ⟶ C_s},
        CategoryTheory.IsPullback g₁ g₂ f₁ f₂ →
        Set.range g₁.base = f₁.base ⁻¹' Set.range f₂.base := by
    intro P A₁_s A₂_s C_s g₁ g₂ f₁ f₂ hPb
    have hg₁ : g₁ = hPb.isoPullback.hom ≫ CategoryTheory.Limits.pullback.fst f₁ f₂ :=
      hPb.isoPullback_hom_fst.symm
    have hsurj : Function.Surjective hPb.isoPullback.hom.base := fun z =>
      ⟨hPb.isoPullback.inv.base z, by
        change (hPb.isoPullback.inv ≫ hPb.isoPullback.hom).base z = z
        rw [hPb.isoPullback.inv_hom_id]; rfl⟩
    rw [hg₁]
    change Set.range ((CategoryTheory.Limits.pullback.fst f₁ f₂).base ∘
      hPb.isoPullback.hom.base) = _
    rw [Set.range_comp, Set.range_eq_univ.mpr hsurj, Set.image_univ]
    exact AlgebraicGeometry.Scheme.Pullback.range_fst f₁ f₂

  have hClosedImmOfSepSection :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (s : X₁ ⟶ X₂) (p : X₂ ⟶ X₁)
        [AlgebraicGeometry.IsSeparated p],
        s ≫ p = 𝟙 X₁ →
        AlgebraicGeometry.IsClosedImmersion s := by
    intro X₁ X₂ s p _ hsec
    have : AlgebraicGeometry.IsClosedImmersion (s ≫ p) := by
      rw [hsec]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp s p

  have hIsoInvSurj :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂),
        Function.Surjective e.inv.base :=
    fun e x =>
      ⟨e.hom.base x, by
        change (e.hom ≫ e.inv).base x = x
        rw [e.hom_inv_id]; rfl⟩

  have hFinOfIsIso :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (g : X₁ ⟶ X₂) [CategoryTheory.IsIso g],
        AlgebraicGeometry.IsFinite g :=
    fun g hg => @AlgebraicGeometry.IsFinite.instOfIsIsoScheme _ _ g hg

  have hEtaleOverDomainReduced :
      ∀ (D E : Type u) [CommRing D] [IsDomain D] [CommRing E] [Algebra D E] [Algebra.Etale D E],
        IsReduced E := by
    intro D E _ _ _ _ _
    let K_D := FractionRing D
    let T_K := TensorProduct D K_D E
    have : Algebra.Etale K_D T_K := Algebra.Etale.baseChange D E K_D
    have hRed_TK : IsReduced T_K := Algebra.FormallyUnramified.isReduced_of_field K_D T_K
    let ι_lin : D →ₗ[D] K_D := Algebra.linearMap D K_D
    have hinj_rT : Function.Injective (LinearMap.rTensor E ι_lin) :=
      Module.Flat.rTensor_preserves_injective_linearMap ι_lin (IsFractionRing.injective D K_D)
    refine ⟨fun x ⟨n, hn⟩ => ?_⟩
    have hTK_zero : (Algebra.TensorProduct.includeRight (R := D) (A := K_D) (B := E)) x = 0 :=
      hRed_TK.eq_zero _ ⟨n, by rw [← map_pow, hn, map_zero]⟩
    have htmul0 : (LinearMap.rTensor E ι_lin) ((1 : D) ⊗ₜ[D] x) =
        (LinearMap.rTensor E ι_lin) 0 := by
      rw [map_zero]
      change (algebraMap D K_D 1) ⊗ₜ[D] x = 0
      rw [map_one]
      exact hTK_zero
    simpa using congrArg (TensorProduct.lid D E) (hinj_rT htmul0)

  have hKummerEtale :
      ∀ (R_b : Type u) [CommRing R_b],
        IsUnit (ℓ : R_b) →
        ∀ u_b : Units R_b,
          Algebra.Etale R_b
            (Polynomial R_b ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u_b : R_b)}) := by
    intro R_b _ huℓ u_b
    let f_poly : Polynomial R_b := Polynomial.X ^ ℓ - Polynomial.C (u_b : R_b)
    have hf_monic : f_poly.Monic := Polynomial.monic_X_pow_sub_C (u_b : R_b) hPrime.ne_zero
    let u_ℓ : Units R_b := huℓ.unit
    have hu_ℓ_val : (u_ℓ : R_b) = (ℓ : R_b) := IsUnit.unit_spec huℓ
    let v_ℓ : R_b := ↑(u_ℓ⁻¹)
    let v_u : R_b := ↑(u_b⁻¹)
    have hℓ_inv : (ℓ : R_b) * v_ℓ = 1 := by
      rw [← hu_ℓ_val]
      exact Units.mul_inv u_ℓ
    have hu_inv : (u_b : R_b) * v_u = 1 := Units.mul_inv u_b
    let p₁ : Polynomial R_b := Polynomial.C (v_ℓ * v_u) * Polynomial.X
    let p₂ : Polynomial R_b := -Polynomial.C v_u
    have hbez : Polynomial.derivative f_poly * p₁ + f_poly * p₂ = (1 : Polynomial R_b) ^ 1 := by
      dsimp [f_poly, p₁, p₂]
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, one_pow]
      have hterm1 :
          (Polynomial.C (ℓ : R_b) * Polynomial.X ^ (ℓ - 1)) *
            (Polynomial.C (v_ℓ * v_u) * Polynomial.X) =
          Polynomial.C v_u * Polynomial.X ^ ℓ := by
        calc
          (Polynomial.C (ℓ : R_b) * Polynomial.X ^ (ℓ - 1)) *
              (Polynomial.C (v_ℓ * v_u) * Polynomial.X)
            = (Polynomial.C (ℓ : R_b) * Polynomial.C (v_ℓ * v_u)) *
                (Polynomial.X ^ (ℓ - 1) * Polynomial.X) := by ring
          _ = Polynomial.C (((ℓ : R_b) * v_ℓ) * v_u) * Polynomial.X ^ (ℓ - 1 + 1) := by
                rw [← Polynomial.C_mul, mul_assoc, ← pow_succ]
          _ = Polynomial.C v_u * Polynomial.X ^ ℓ := by
                rw [hℓ_inv, one_mul, Nat.sub_add_cancel hℓ_pos]
      have hterm2 :
          (Polynomial.X ^ ℓ - Polynomial.C (u_b : R_b)) * (-Polynomial.C v_u) =
            -(Polynomial.C v_u * Polynomial.X ^ ℓ) + 1 := by
        calc
          (Polynomial.X ^ ℓ - Polynomial.C (u_b : R_b)) * (-Polynomial.C v_u)
            = -(Polynomial.C v_u * Polynomial.X ^ ℓ) +
                Polynomial.C (u_b : R_b) * Polynomial.C v_u := by ring
          _ = -(Polynomial.C v_u * Polynomial.X ^ ℓ) + 1 := by
                rw [← Polynomial.C_mul, hu_inv, Polynomial.C_1]
      rw [hterm1, hterm2]
      ring
    let P_st : StandardEtalePair R_b := ⟨f_poly, hf_monic, 1, ⟨p₁, p₂, 1, hbez⟩⟩
    let Q_b := Polynomial R_b ⧸ Ideal.span {f_poly}
    let w_b : Q_b := Ideal.Quotient.mk (Ideal.span {f_poly}) Polynomial.X
    have hw_aeval_hom : (Polynomial.aeval w_b).toRingHom =
        Ideal.Quotient.mk (Ideal.span {f_poly}) := by
      apply Polynomial.ringHom_ext
      · intro r
        exact Polynomial.aeval_C w_b r
      · exact Polynomial.aeval_X w_b
    have hw_aeval : ∀ p : Polynomial R_b,
        Polynomial.aeval w_b p = Ideal.Quotient.mk (Ideal.span {f_poly}) p :=
      fun p => RingHom.congr_fun hw_aeval_hom p
    have hw_map : P_st.HasMap w_b := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval w_b f_poly = 0
        rw [hw_aeval, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton_self f_poly
      · change IsUnit (Polynomial.aeval w_b (1 : Polynomial R_b))
        rw [map_one]
        exact isUnit_one
    let φ_st : P_st.Ring →ₐ[R_b] Q_b := P_st.lift w_b hw_map
    have hx0_map : P_st.HasMap P_st.X := (P_st.homEquiv (AlgHom.id R_b P_st.Ring)).2
    have hx0_root : ∀ p ∈ Ideal.span {f_poly}, Polynomial.aeval P_st.X p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      rw [map_mul, hx0_map.1, zero_mul]
    let ψ_st : Q_b →ₐ[R_b] P_st.Ring :=
      Ideal.Quotient.liftₐ (Ideal.span {f_poly}) (Polynomial.aeval P_st.X) hx0_root
    have hψ_w : ψ_st w_b = P_st.X := by
      change Ideal.Quotient.lift (Ideal.span {f_poly}) (Polynomial.aeval P_st.X).toRingHom
        hx0_root (Ideal.Quotient.mk _ Polynomial.X) = P_st.X
      rw [Ideal.Quotient.lift_mk]
      exact Polynomial.aeval_X P_st.X
    have hhomEquiv_val : ∀ g : P_st.Ring →ₐ[R_b] P_st.Ring,
        (P_st.homEquiv g).1 = g P_st.X := by
      intro g
      have h1 : P_st.lift (P_st.homEquiv g).1 (P_st.homEquiv g).2 = g := by
        rw [← P_st.homEquiv_symm_apply, Equiv.symm_apply_apply]
      rw [← P_st.lift_X (P_st.homEquiv g).1 (P_st.homEquiv g).2, h1]
    have hcomp1 : ψ_st.comp φ_st = AlgHom.id R_b P_st.Ring := by
      apply P_st.homEquiv.injective
      apply Subtype.ext
      rw [hhomEquiv_val, hhomEquiv_val, AlgHom.comp_apply, P_st.lift_X, hψ_w, AlgHom.id_apply]
    have hcomp2 : φ_st.comp ψ_st = AlgHom.id R_b Q_b := by
      have hpoly : (φ_st.comp ψ_st).comp (Polynomial.aeval w_b) = Polynomial.aeval w_b := by
        apply Polynomial.algHom_ext
        change φ_st (ψ_st (Polynomial.aeval w_b Polynomial.X)) = Polynomial.aeval w_b Polynomial.X
        rw [Polynomial.aeval_X, hψ_w, P_st.lift_X]
      ext x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [← hw_aeval p]
      exact AlgHom.congr_fun hpoly p
    let e_st : P_st.Ring ≃ₐ[R_b] Q_b := AlgEquiv.ofAlgHom φ_st ψ_st hcomp2 hcomp1
    exact Algebra.Etale.of_equiv e_st

  have hSmoothCurveOverFieldInt :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (F : AlgebraicGeometry.Scheme.{u})
        (q : F ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 q],
        ConnectedSpace ↥F →
        IrreducibleSpace ↥F ∧ AlgebraicGeometry.IsIntegral F := by
    intro Ω _ _ F q _ hConn
    let e_mv0 : MvPolynomial (Fin 0) Ω ≃+* Ω :=
      (MvPolynomial.isEmptyAlgEquiv Ω (Fin 0)).toRingEquiv
    let iso_mv0 : CommRingCat.of (MvPolynomial (Fin 0) Ω) ≅ CommRingCat.of Ω :=
      { hom := CommRingCat.ofHom e_mv0.toRingHom
        inv := CommRingCat.ofHom e_mv0.symm.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext e_mv0.symm_apply_apply)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext e_mv0.apply_symm_apply) }
    let u_B : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilAffineSpaceOver Ω 0).left :=
      AlgebraicGeometry.Spec.map iso_mv0.hom
    have : CategoryTheory.IsIso u_B :=
      ⟨⟨AlgebraicGeometry.Spec.map iso_mv0.inv,
        by
          change AlgebraicGeometry.Spec.map iso_mv0.hom ≫
            AlgebraicGeometry.Spec.map iso_mv0.inv = 𝟙 _
          rw [← AlgebraicGeometry.Spec.map_comp, iso_mv0.inv_hom_id,
            AlgebraicGeometry.Spec.map_id],
        by
          change AlgebraicGeometry.Spec.map iso_mv0.inv ≫
            AlgebraicGeometry.Spec.map iso_mv0.hom = 𝟙 _
          rw [← AlgebraicGeometry.Spec.map_comp, iso_mv0.hom_inv_id,
            AlgebraicGeometry.Spec.map_id]⟩⟩
    have : AlgebraicGeometry.Etale u_B := inferInstance
    exact (weil_algClosed_smooth_etale_local_domain_and_connected_integral Ω).2 0 1
      (AlgebraicGeometry.Spec (CommRingCat.of Ω)) F u_B q hConn

  have hSecPreimageSingleton :
      ∀ (Ω : Type u) [Field Ω]
        {Y_s : AlgebraicGeometry.Scheme.{u}}
        (g : Y_s ⟶ V_sh) (τ : V_sh ⟶ Y_s)
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V_sh)
        (pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        (hsec : τ ≫ g = 𝟙 V_sh),
        (CategoryTheory.Limits.pullback.fst g s).base ⁻¹' Set.range τ.base =
          {(CategoryTheory.Limits.pullback.lift (s ≫ τ)
              (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
              (by rw [CategoryTheory.Category.assoc, hsec,
                      CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])).base pt_Ω} := by
    intro Ω _ Y_s g τ s pt_Ω hsec
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have hSub_Ω : Subsingleton ↥S_Ω := by
      change Subsingleton (PrimeSpectrum Ω)
      infer_instance
    let fst_g := CategoryTheory.Limits.pullback.fst g s
    let snd_g := CategoryTheory.Limits.pullback.snd g s
    let σ_Ω : S_Ω ⟶ CategoryTheory.Limits.pullback g s :=
      CategoryTheory.Limits.pullback.lift (s ≫ τ) (𝟙 S_Ω)
        (by rw [CategoryTheory.Category.assoc, hsec,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    let P_sec := CategoryTheory.Limits.pullback fst_g τ
    let p₁ : P_sec ⟶ CategoryTheory.Limits.pullback g s :=
      CategoryTheory.Limits.pullback.fst fst_g τ
    let p₂ : P_sec ⟶ V_sh := CategoryTheory.Limits.pullback.snd fst_g τ
    let lift_P : S_Ω ⟶ P_sec :=
      CategoryTheory.Limits.pullback.lift σ_Ω s
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have hp₂_eq : (p₁ ≫ snd_g) ≫ s = p₂ := by
      calc
        (p₁ ≫ snd_g) ≫ s
          = p₁ ≫ (snd_g ≫ s) := CategoryTheory.Category.assoc _ _ _
        _ = p₁ ≫ (fst_g ≫ g) := by rw [← CategoryTheory.Limits.pullback.condition]
        _ = (p₁ ≫ fst_g) ≫ g := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (p₂ ≫ τ) ≫ g := by rw [CategoryTheory.Limits.pullback.condition]
        _ = p₂ ≫ (τ ≫ g) := CategoryTheory.Category.assoc _ _ _
        _ = p₂ := by rw [hsec, CategoryTheory.Category.comp_id]
    have hret_P : (p₁ ≫ snd_g) ≫ lift_P = 𝟙 P_sec := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.id_comp]
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc (p₁ ≫ snd_g), hp₂_eq,
            CategoryTheory.Limits.pullback.condition]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.comp_id]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          hp₂_eq, CategoryTheory.Category.id_comp]
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hz
      have hz_rng : z ∈ Set.range p₁.base := by
        rwa [AlgebraicGeometry.Scheme.Pullback.range_fst]
      obtain ⟨w, rfl⟩ := hz_rng
      have hw_id : w = lift_P.base ((p₁ ≫ snd_g).base w) :=
        (congrArg (fun h : P_sec ⟶ P_sec => h.base w) hret_P).symm
      rw [hw_id, hSub_Ω.elim ((p₁ ≫ snd_g).base w) pt_Ω]
      change (lift_P ≫ p₁).base pt_Ω = σ_Ω.base pt_Ω
      rw [CategoryTheory.Limits.pullback.lift_fst]
    · rintro rfl
      change (σ_Ω ≫ fst_g).base pt_Ω ∈ Set.range τ.base
      rw [CategoryTheory.Limits.pullback.lift_fst]
      exact ⟨s.base pt_Ω, rfl⟩

  
  
  
  let h_le_U1 : ∀ a : Fin m, (⊤ : V_sh.Opens) ≤ (TopologicalSpace.Opens.map (τ_sh a).base).obj U_1 :=
    fun a => Classical.choose (ht_sh a)
  have hker_U1 : ∀ a : Fin m,
      RingHom.ker (((τ_sh a).appLE U_1 ⊤ (h_le_U1 a)).hom) = Ideal.span {t_sh a} :=
    fun a => (Classical.choose_spec (ht_sh a)).1
  have hbasic_U1 : ∀ a : Fin m,
      (Y_sh.basicOpen (t_sh a) : Set ↥Y_sh) = (U_1 : Set ↥Y_sh) \ Set.range (τ_sh a).base :=
    fun a => (Classical.choose_spec (ht_sh a)).2

  have hBasicProd : ∀ (S : Finset (Fin m)),
      (Y_sh.basicOpen (S.prod t_sh) : Set ↥Y_sh) =
        (U_1 : Set ↥Y_sh) \ ⋃ b ∈ S, Set.range (τ_sh b).base := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty, AlgebraicGeometry.Scheme.basicOpen_one]
      ext y
      simp only [Set.mem_sdiff, Set.mem_iUnion, Finset.notMem_empty]
      exact ⟨fun hy => ⟨hy, fun ⟨_, hfalse, _⟩ => False.elim hfalse⟩, fun h => h.1⟩
    | @insert b S hb ih =>
      rw [Finset.prod_insert hb, AlgebraicGeometry.Scheme.basicOpen_mul]
      change ((Y_sh.basicOpen (t_sh b) : Set ↥Y_sh) ∩
        (Y_sh.basicOpen (S.prod t_sh) : Set ↥Y_sh)) = _
      rw [hbasic_U1 b, ih]
      ext y
      simp only [Set.mem_inter_iff, Set.mem_sdiff, Set.mem_iUnion, Finset.mem_insert]
      constructor
      · rintro ⟨⟨hy1, hnb⟩, _, hnS⟩
        refine ⟨hy1, ?_⟩
        rintro ⟨i, rfl | hiS, hyi⟩
        · exact hnb hyi
        · exact hnS ⟨i, hiS, hyi⟩
      · rintro ⟨hy1, hnot⟩
        exact ⟨⟨hy1, fun hyb => hnot ⟨b, Or.inl rfl, hyb⟩⟩,
          hy1, fun ⟨i, hiS, hyi⟩ => hnot ⟨i, Or.inr hiS, hyi⟩⟩

  have hU01_eq : U_0 ⊓ U_1 = Y_sh.basicOpen (Finset.univ.prod t_sh) := by
    ext y
    change y ∈ (U_0 : Set ↥Y_sh) ∧ y ∈ (U_1 : Set ↥Y_sh) ↔
      y ∈ (Y_sh.basicOpen (Finset.univ.prod t_sh) : Set ↥Y_sh)
    rw [hBasicProd Finset.univ, hU_0_compl]
    simp only [Set.mem_sdiff, Set.mem_compl_iff, Set.mem_iUnion, Finset.mem_univ, exists_true_left,
      and_comm]

  have hAff_01 : AlgebraicGeometry.IsAffineOpen (U_0 ⊓ U_1) :=
    hU01_eq ▸ hAff_1.basicOpen (Finset.univ.prod t_sh)

  have hUnit_ov : ∀ a : Fin m, IsUnit (ρ₁ (t_sh a)) := by
    intro a
    have hle_bo : U_0 ⊓ U_1 ≤ Y_sh.basicOpen (t_sh a) := by
      intro y hy
      change y ∈ (Y_sh.basicOpen (t_sh a) : Set ↥Y_sh)
      rw [hbasic_U1 a]
      refine ⟨hy.2, ?_⟩
      have hy0 : y ∈ (U_0 : Set ↥Y_sh) := hy.1
      rw [hU_0_compl] at hy0
      exact fun hmem => hy0 (Set.mem_iUnion.mpr ⟨a, hmem⟩)
    have hres_eq : Y_sh.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_0 ⊓ U_1 ≤ U_1)).op =
        Y_sh.presheaf.map (CategoryTheory.homOfLE (Y_sh.basicOpen_le (t_sh a))).op ≫
          Y_sh.presheaf.map (CategoryTheory.homOfLE hle_bo).op := by
      rw [← Y_sh.presheaf.map_comp]
      rfl
    dsimp [ρ₁]
    rw [hres_eq]
    exact IsUnit.map (Y_sh.presheaf.map (CategoryTheory.homOfLE hle_bo).op).hom
      (Y_sh.toRingedSpace.isUnit_res_basicOpen (t_sh a))

  
  let φ_kB_cat : CommRingCat.of k ⟶ B_cat :=
    AlgebraicGeometry.Spec.preimage (V_sh.isoSpec.inv ≫ p_Vsh)
  have hmap_kB : AlgebraicGeometry.Spec.map φ_kB_cat = V_sh.isoSpec.inv ≫ p_Vsh :=
    AlgebraicGeometry.Spec.map_preimage _
  have hLFT_inv : AlgebraicGeometry.LocallyOfFiniteType V_sh.isoSpec.inv := by
    have : AlgebraicGeometry.Etale V_sh.isoSpec.inv := inferInstance
    exact hLFT_of_etale V_sh.isoSpec.inv
  have hLFT_comp_kB : AlgebraicGeometry.LocallyOfFiniteType (V_sh.isoSpec.inv ≫ p_Vsh) :=
    CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.LocallyOfFiniteType)
      V_sh.isoSpec.inv p_Vsh hLFT_inv inferInstance
  have hFT_kB : RingHom.FiniteType φ_kB_cat.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (hmap_kB.symm ▸ hLFT_comp_kB)
  let alg_kB : Algebra k B := φ_kB_cat.hom.toAlgebra
  have hNoeth_B : IsNoetherianRing B := by
    letI : Algebra k B := alg_kB
    have : Algebra.FiniteType k B := hFT_kB
    exact Algebra.FiniteType.isNoetherianRing k B
  have : IsNoetherianRing B := hNoeth_B
  have hℓ_unit_B : IsUnit (ℓ : B) := by
    simpa only [map_natCast] using (Ne.isUnit hℓ).map φ_kB_cat.hom

  let hAff_Vtop : AlgebraicGeometry.IsAffineOpen (⊤ : V_sh.Opens) :=
    AlgebraicGeometry.isAffineOpen_top V_sh
  have hVtop_fromSpec : hAff_Vtop.fromSpec = V_sh.isoSpec.inv :=
    AlgebraicGeometry.IsAffineOpen.fromSpec_top

  
  let s_prod : Fin m → R₁ := fun a => (Finset.univ.erase a).prod t_sh
  let U_a : Fin m → Y_sh.Opens := fun a => Y_sh.basicOpen (s_prod a)
  have hAff_Ua : ∀ a : Fin m, AlgebraicGeometry.IsAffineOpen (U_a a) :=
    fun a => hAff_1.basicOpen (s_prod a)
  have hUa_le_U1 : ∀ a : Fin m, U_a a ≤ U_1 :=
    fun a => Y_sh.basicOpen_le (s_prod a)
  let R_a : Fin m → Type u := fun a => ↑(Y_sh.presheaf.obj (Opposite.op (U_a a)))
  let ρ_a : ∀ a : Fin m, R₁ →+* R_a a :=
    fun a => (Y_sh.presheaf.map (CategoryTheory.homOfLE (hUa_le_U1 a)).op).hom
  let t_loc : ∀ a : Fin m, R_a a := fun a => ρ_a a (t_sh a)

  have hSpec_res_Ua : ∀ a : Fin m,
      AlgebraicGeometry.Spec.map (Y_sh.presheaf.map (CategoryTheory.homOfLE (hUa_le_U1 a)).op) ≫
        hAff_1.fromSpec = (hAff_Ua a).fromSpec := by
    intro a
    have hle_id : U_a a ≤ (𝟙 Y_sh) ⁻¹ᵁ U_1 := hUa_le_U1 a
    have hid_app : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 Y_sh) U_1 (U_a a) hle_id =
        Y_sh.presheaf.map (CategoryTheory.homOfLE (hUa_le_U1 a)).op := by
      have h1 : AlgebraicGeometry.Scheme.Hom.app (𝟙 Y_sh) U_1 ≫
          Y_sh.presheaf.map (CategoryTheory.homOfLE hle_id).op =
          AlgebraicGeometry.Scheme.Hom.appLE (𝟙 Y_sh) U_1 (U_a a) hle_id := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
      ext x
      rw [← h1]
      change (Y_sh.presheaf.map (CategoryTheory.homOfLE hle_id).op).hom
        ((AlgebraicGeometry.Scheme.Hom.app (𝟙 Y_sh) U_1).hom x) = _
      have hid_x : (AlgebraicGeometry.Scheme.Hom.app (𝟙 Y_sh) U_1).hom x = x :=
        DFunLike.congr_fun (congrArg CommRingCat.Hom.hom
          (AlgebraicGeometry.Scheme.Hom.id_app U_1)) x
      rw [hid_x]
      rfl
    rw [← hid_app, AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
      (𝟙 Y_sh) hAff_1 (hAff_Ua a) hle_id, CategoryTheory.Category.comp_id]

  have h_le_Ua : ∀ a : Fin m,
      (⊤ : V_sh.Opens) ≤ (TopologicalSpace.Opens.map (τ_sh a).base).obj (U_a a) := by
    intro a v _
    change (τ_sh a).base v ∈ (Y_sh.basicOpen (s_prod a) : Set ↥Y_sh)
    rw [hBasicProd (Finset.univ.erase a)]
    refine ⟨h_le_U1 a (show v ∈ (⊤ : V_sh.Opens) from trivial), ?_⟩
    simp only [Set.mem_iUnion, Finset.mem_erase, Finset.mem_univ, and_true, not_exists]
    intro b hb hmem
    exact Set.disjoint_left.mp (hτ_disj (Ne.symm hb)) ⟨v, rfl⟩ hmem

  have hCov_Ua : U_0 ⊔ (⨆ a : Fin m, U_a a) = ⊤ := by
    ext y
    change (y ∈ (U_0 : Set ↥Y_sh) ∨ y ∈ ((⨆ a : Fin m, U_a a : Y_sh.Opens) : Set ↥Y_sh)) ↔ True
    refine iff_of_true ?_ trivial
    by_cases hy0 : y ∈ (U_0 : Set ↥Y_sh)
    · exact Or.inl hy0
    · right
      rw [hU_0_compl, Set.mem_compl_iff, not_not] at hy0
      obtain ⟨a, v, rfl⟩ := Set.mem_iUnion.mp hy0
      rw [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
      exact ⟨a, h_le_Ua a (show v ∈ (⊤ : V_sh.Opens) from trivial)⟩

  have hUnit_other : ∀ (a b : Fin m), b ≠ a → IsUnit (ρ_a a (t_sh b)) := by
    intro a b hne
    have hle_bo : U_a a ≤ Y_sh.basicOpen (t_sh b) := by
      intro y hy
      change y ∈ (Y_sh.basicOpen (s_prod a) : Set ↥Y_sh) at hy
      rw [hBasicProd (Finset.univ.erase a)] at hy
      change y ∈ (Y_sh.basicOpen (t_sh b) : Set ↥Y_sh)
      rw [hbasic_U1 b]
      refine ⟨hy.1, fun hmem => hy.2 ?_⟩
      exact Set.mem_biUnion (Finset.mem_erase.mpr ⟨hne, Finset.mem_univ b⟩) hmem
    have hres_eq : Y_sh.presheaf.map (CategoryTheory.homOfLE (hUa_le_U1 a)).op =
        Y_sh.presheaf.map (CategoryTheory.homOfLE (Y_sh.basicOpen_le (t_sh b))).op ≫
          Y_sh.presheaf.map (CategoryTheory.homOfLE hle_bo).op := by
      rw [← Y_sh.presheaf.map_comp]
      rfl
    dsimp [ρ_a]
    rw [hres_eq]
    exact IsUnit.map (Y_sh.presheaf.map (CategoryTheory.homOfLE hle_bo).op).hom
      (Y_sh.toRingedSpace.isUnit_res_basicOpen (t_sh b))

  let f_Ra_cat : ∀ a : Fin m, B_cat ⟶ Y_sh.presheaf.obj (Opposite.op (U_a a)) :=
    fun a => f_sh.appLE ⊤ (U_a a) le_top
  have hf_Ra_Spec : ∀ a : Fin m,
      AlgebraicGeometry.Spec.map (f_Ra_cat a) =
        ((hAff_Ua a).fromSpec ≫ f_sh) ≫ V_sh.isoSpec.hom := by
    intro a
    have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_sh
      hAff_Vtop (hAff_Ua a) le_top
    rw [hVtop_fromSpec] at h1
    calc
      AlgebraicGeometry.Spec.map (f_Ra_cat a)
        = (AlgebraicGeometry.Spec.map (f_Ra_cat a) ≫ V_sh.isoSpec.inv) ≫ V_sh.isoSpec.hom := by
            simp
      _ = ((hAff_Ua a).fromSpec ≫ f_sh) ≫ V_sh.isoSpec.hom := by rw [h1]

  have hτ_Ra_Spec : ∀ a : Fin m,
      AlgebraicGeometry.Spec.map ((τ_sh a).appLE (U_a a) ⊤ (h_le_Ua a)) ≫
        (hAff_Ua a).fromSpec = V_sh.isoSpec.inv ≫ τ_sh a := by
    intro a
    have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (τ_sh a)
      (hAff_Ua a) hAff_Vtop (h_le_Ua a)
    rwa [hVtop_fromSpec] at h1

  have hker_Ua : ∀ a : Fin m,
      RingHom.ker (((τ_sh a).appLE (U_a a) ⊤ (h_le_Ua a)).hom) = Ideal.span {t_loc a} := by
    intro a
    letI : Algebra R₁ (R_a a) := (ρ_a a).toAlgebra
    have : IsLocalization.Away (s_prod a) (R_a a) :=
      hAff_1.isLocalization_basicOpen (s_prod a)
    have hu_sa : IsUnit (ρ_a a (s_prod a)) :=
      Y_sh.toRingedSpace.isUnit_res_basicOpen (s_prod a)
    have hcomp_τ : Y_sh.presheaf.map (CategoryTheory.homOfLE (hUa_le_U1 a)).op ≫
        (τ_sh a).appLE (U_a a) ⊤ (h_le_Ua a) = (τ_sh a).appLE U_1 ⊤ (h_le_U1 a) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [← cancel_mono hAff_1.fromSpec, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, hSpec_res_Ua a, hτ_Ra_Spec a]
      have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (τ_sh a)
