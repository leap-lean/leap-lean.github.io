theorem weil_esnault_viehweg_subtraction_free_cyclic_algebra (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R₁ : Type u) [CommRing R₁]
    (m : ℕ) (t : Fin m → R₁) (c : Fin m → ℕ)
    (hc_lt : ∀ a : Fin m, c a < ℓ)
    (u₁ : Units R₁) :
    ∃ (A₁ : Type u) (instComm : CommRing A₁) (algA₁ : Algebra R₁ A₁),
      letI : CommRing A₁ := instComm
      letI : Algebra R₁ A₁ := algA₁
      Module.Free R₁ A₁ ∧
      Module.Finite R₁ A₁ ∧
      Module.FaithfullyFlat R₁ A₁ ∧
      (∀ (R₀₁ : Type u) [CommRing R₀₁] [Algebra R₁ R₀₁],
        (∀ a : Fin m, IsUnit (algebraMap R₁ R₀₁ (t a))) →
        Nonempty ((Polynomial R₀₁ ⧸
          Ideal.span {Polynomial.X ^ ℓ -
            Polynomial.C (algebraMap R₁ R₀₁
              ((u₁ : R₁) * Finset.univ.prod fun a : Fin m => (t a) ^ (c a)))}) ≃ₐ[R₀₁]
          TensorProduct R₁ R₀₁ A₁)) ∧
      (∀ (a : Fin m), c a = 0 →
        ∀ (R_loc : Type u) [CommRing R_loc] [Algebra R₁ R_loc],
          (∀ b : Fin m, b ≠ a → IsUnit (algebraMap R₁ R_loc (t b))) →
          ∃ u_loc : Units R_loc,
            Nonempty ((Polynomial R_loc ⧸
              Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u_loc : R_loc)}) ≃ₐ[R_loc]
              TensorProduct R₁ R_loc A₁)) ∧
      (∀ (a : Fin m), 1 ≤ c a →
        ∀ (R_loc : Type u) [CommRing R_loc] [Algebra R₁ R_loc],
          (∀ b : Fin m, b ≠ a → IsUnit (algebraMap R₁ R_loc (t b))) →
          ∃ u_ram : Units R_loc,
            Nonempty ((Polynomial R_loc ⧸
              Ideal.span {Polynomial.X ^ ℓ -
                Polynomial.C ((u_ram : R_loc) * algebraMap R₁ R_loc (t a))}) ≃ₐ[R_loc]
              TensorProduct R₁ R_loc A₁)) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt
  let carry : ℕ → ℕ → ℕ → ℕ := fun d x y => ((x * d) % ℓ + (y * d) % ℓ) / ℓ
  have h_div_add : ∀ d x y : ℕ,
      ((x + y) * d) / ℓ = carry d x y + (x * d) / ℓ + (y * d) / ℓ := by
    intro d x y
    have hx : ℓ * ((x * d) / ℓ) + (x * d) % ℓ = x * d := Nat.div_add_mod (x * d) ℓ
    have hy : ℓ * ((y * d) / ℓ) + (y * d) % ℓ = y * d := Nat.div_add_mod (y * d) ℓ
    have hsum : (x + y) * d =
        ((x * d) % ℓ + (y * d) % ℓ) + ℓ * ((x * d) / ℓ + (y * d) / ℓ) := by
      calc
        (x + y) * d = x * d + y * d := by ring
        _ = (ℓ * ((x * d) / ℓ) + (x * d) % ℓ) + (ℓ * ((y * d) / ℓ) + (y * d) % ℓ) := by
          rw [hx, hy]
        _ = ((x * d) % ℓ + (y * d) % ℓ) + ℓ * ((x * d) / ℓ + (y * d) / ℓ) := by ring
    rw [hsum, Nat.add_mul_div_left _ _ hℓ_pos, ← add_assoc]
  have h_shift : ∀ d q r : ℕ, ((r + ℓ * q) * d) / ℓ = (r * d) / ℓ + q * d := by
    intro d q r
    have hmul : (r + ℓ * q) * d = r * d + ℓ * (q * d) := by ring
    rw [hmul, Nat.add_mul_div_left _ _ hℓ_pos]
  have h_triple : ∀ d j k s : ℕ,
      ((j + k + s) * d) / ℓ =
        carry d j k + carry d ((j + k) % ℓ) s + (j * d) / ℓ + (k * d) / ℓ + (s * d) / ℓ := by
    intro d j k s
    let r₁ := (j + k) % ℓ
    let q₁ := (j + k) / ℓ
    have hjk : j + k = r₁ + ℓ * q₁ :=
      (Nat.div_add_mod (j + k) ℓ).symm.trans (add_comm _ _)
    have h1 : (r₁ * d) / ℓ + q₁ * d = carry d j k + (j * d) / ℓ + (k * d) / ℓ := by
      calc
        (r₁ * d) / ℓ + q₁ * d = ((r₁ + ℓ * q₁) * d) / ℓ := (h_shift d q₁ r₁).symm
        _ = ((j + k) * d) / ℓ := by rw [← hjk]
        _ = carry d j k + (j * d) / ℓ + (k * d) / ℓ := h_div_add d j k
    have hjks : j + k + s = (r₁ + s) + ℓ * q₁ := by omega
    calc
      ((j + k + s) * d) / ℓ = (((r₁ + s) + ℓ * q₁) * d) / ℓ := by rw [hjks]
      _ = ((r₁ + s) * d) / ℓ + q₁ * d := h_shift d q₁ (r₁ + s)
      _ = carry d r₁ s + (r₁ * d) / ℓ + (s * d) / ℓ + q₁ * d := by
        rw [h_div_add d r₁ s]
      _ = carry d r₁ s + ((r₁ * d) / ℓ + q₁ * d) + (s * d) / ℓ := by ring
      _ = carry d r₁ s + (carry d j k + (j * d) / ℓ + (k * d) / ℓ) + (s * d) / ℓ := by rw [h1]
      _ = carry d j k + carry d ((j + k) % ℓ) s + (j * d) / ℓ + (k * d) / ℓ + (s * d) / ℓ := by
        dsimp only [r₁]
        ring
  have h_cocycle : ∀ d j k s : ℕ,
      carry d j k + carry d ((j + k) % ℓ) s =
        carry d k s + carry d j ((k + s) % ℓ) := by
    intro d j k s
    have ht1 := h_triple d j k s
    have ht2 := h_triple d k s j
    have heq_div : ((j + k + s) * d) / ℓ = ((k + s + j) * d) / ℓ := by
      congr 1
      ring
    have hcomm_c : carry d ((k + s) % ℓ) j = carry d j ((k + s) % ℓ) := by
      dsimp [carry]
      rw [add_comm]
    omega
  have h_u_cocycle : ∀ j k s : Fin ℓ,
      (j.1 + k.1) / ℓ + ((j.1 + k.1) % ℓ + s.1) / ℓ =
        (k.1 + s.1) / ℓ + (j.1 + (k.1 + s.1) % ℓ) / ℓ := by
    intro j k s
    have hc1 := h_cocycle 1 j.1 k.1 s.1
    dsimp [carry] at hc1
    simp only [mul_one, Nat.mod_eq_of_lt j.2, Nat.mod_eq_of_lt k.2, Nat.mod_eq_of_lt s.2,
      Nat.mod_eq_of_lt (Nat.mod_lt _ hℓ_pos)] at hc1
    omega

  let A₁ : Type u := ↥(⊤ : Submodule R₁ (Fin ℓ →₀ R₁))
  let β : Module.Basis (Fin ℓ) R₁ A₁ :=
    (Finsupp.basisSingleOne (ι := Fin ℓ) (R := R₁)).map Submodule.topEquiv.symm
  let remIdx : Fin ℓ → Fin ℓ → Fin ℓ := fun j k => ⟨(j.1 + k.1) % ℓ, Nat.mod_lt _ hℓ_pos⟩
  let coeff : Fin ℓ → Fin ℓ → R₁ := fun j k =>
    (u₁ : R₁) ^ ((j.1 + k.1) / ℓ) *
      Finset.univ.prod fun a : Fin m => (t a) ^ (carry (c a) j.1 k.1)
  let mulLin : A₁ →ₗ[R₁] A₁ →ₗ[R₁] A₁ :=
    β.constr R₁ fun j => β.constr R₁ fun k => coeff j k • β (remIdx j k)
  have hmul : ∀ j k : Fin ℓ, mulLin (β j) (β k) = coeff j k • β (remIdx j k) := by
    intro j k
    simp [mulLin]
  have h_one_lin : mulLin (β ⟨0, hℓ_pos⟩) = LinearMap.id := by
    refine β.ext fun k => ?_
    rw [hmul, LinearMap.id_apply]
    have h_c : coeff ⟨0, hℓ_pos⟩ k = 1 := by
      dsimp [coeff, carry]
      have hd1 : (0 + k.1) / ℓ = 0 := by rw [zero_add]; exact Nat.div_eq_of_lt k.2
      have hprod : (Finset.univ.prod fun a : Fin m =>
          (t a) ^ (((0 * c a) % ℓ + (k.1 * c a) % ℓ) / ℓ)) = 1 := by
        refine Finset.prod_eq_one fun a _ => ?_
        have hd2 : ((0 * c a) % ℓ + (k.1 * c a) % ℓ) / ℓ = 0 := by
          simp only [zero_mul, Nat.zero_mod, zero_add]
          exact Nat.div_eq_of_lt (Nat.mod_lt _ hℓ_pos)
        rw [hd2, pow_zero]
      rw [hd1, pow_zero, hprod, mul_one]
    have h_r : remIdx ⟨0, hℓ_pos⟩ k = k := by
      ext
      dsimp [remIdx]
      rw [zero_add, Nat.mod_eq_of_lt k.2]
    rw [h_c, h_r, one_smul]
  have h_one_mul : ∀ x : A₁, mulLin (β ⟨0, hℓ_pos⟩) x = x :=
    fun x => DFunLike.congr_fun h_one_lin x
  have h_comm_lin : mulLin = mulLin.flip := by
    refine β.ext fun j => β.ext fun k => ?_
    change mulLin (β j) (β k) = mulLin (β k) (β j)
    rw [hmul, hmul]
    have hc_eq : coeff j k = coeff k j := by
      dsimp [coeff, carry]
      congr 1
      · rw [add_comm]
      · refine Finset.prod_congr rfl fun a _ => ?_
        rw [add_comm ((j.1 * c a) % ℓ)]
    have hr_eq : remIdx j k = remIdx k j := by
      ext
      dsimp [remIdx]
      rw [add_comm]
    rw [hc_eq, hr_eq]
  have h_comm : ∀ x y : A₁, mulLin x y = mulLin y x :=
    fun x y => DFunLike.congr_fun (DFunLike.congr_fun h_comm_lin x) y
  have h_mul_one : ∀ x : A₁, mulLin x (β ⟨0, hℓ_pos⟩) = x :=
    fun x => (h_comm x _).trans (h_one_mul x)
  have h_assoc_basis : ∀ j k s : Fin ℓ,
      mulLin (mulLin (β j) (β k)) (β s) = mulLin (β j) (mulLin (β k) (β s)) := by
    intro j k s
    rw [hmul, map_smul, LinearMap.smul_apply, hmul, smul_smul,
      hmul, map_smul, hmul, smul_smul]
    have h_idx : remIdx (remIdx j k) s = remIdx j (remIdx k s) := by
      ext
      dsimp [remIdx]
      rw [Nat.mod_add_mod, Nat.add_mod_mod, add_assoc]
    have h_sc : coeff j k * coeff (remIdx j k) s = coeff k s * coeff j (remIdx k s) := by
      dsimp [coeff, remIdx]
      have hlhs :
          ((u₁ : R₁) ^ ((j.1 + k.1) / ℓ) *
              Finset.univ.prod fun a : Fin m => (t a) ^ carry (c a) j.1 k.1) *
            ((u₁ : R₁) ^ (((j.1 + k.1) % ℓ + s.1) / ℓ) *
              Finset.univ.prod fun a : Fin m => (t a) ^ carry (c a) ((j.1 + k.1) % ℓ) s.1) =
          (u₁ : R₁) ^ ((j.1 + k.1) / ℓ + ((j.1 + k.1) % ℓ + s.1) / ℓ) *
            Finset.univ.prod fun a : Fin m =>
              (t a) ^ (carry (c a) j.1 k.1 + carry (c a) ((j.1 + k.1) % ℓ) s.1) := by
        rw [mul_mul_mul_comm, ← pow_add, ← Finset.prod_mul_distrib]
        congr 1
        exact Finset.prod_congr rfl fun a _ => (pow_add _ _ _).symm
      have hrhs :
          ((u₁ : R₁) ^ ((k.1 + s.1) / ℓ) *
              Finset.univ.prod fun a : Fin m => (t a) ^ carry (c a) k.1 s.1) *
            ((u₁ : R₁) ^ ((j.1 + (k.1 + s.1) % ℓ) / ℓ) *
              Finset.univ.prod fun a : Fin m => (t a) ^ carry (c a) j.1 ((k.1 + s.1) % ℓ)) =
          (u₁ : R₁) ^ ((k.1 + s.1) / ℓ + (j.1 + (k.1 + s.1) % ℓ) / ℓ) *
            Finset.univ.prod fun a : Fin m =>
              (t a) ^ (carry (c a) k.1 s.1 + carry (c a) j.1 ((k.1 + s.1) % ℓ)) := by
        rw [mul_mul_mul_comm, ← pow_add, ← Finset.prod_mul_distrib]
        congr 1
        exact Finset.prod_congr rfl fun a _ => (pow_add _ _ _).symm
      rw [hlhs, hrhs, h_u_cocycle j k s]
      congr 1
      exact Finset.prod_congr rfl fun a _ => by rw [h_cocycle (c a) j.1 k.1 s.1]
    rw [h_idx, h_sc]
  have h_assoc_jk_lin : ∀ j k : Fin ℓ,
      mulLin (mulLin (β j) (β k)) = (mulLin (β j)).comp (mulLin (β k)) :=
    fun j k => β.ext fun s => h_assoc_basis j k s
  have h_assoc_j_lin : ∀ (j : Fin ℓ) (z : A₁),
      (mulLin.flip z).comp (mulLin (β j)) = (mulLin (β j)).comp (mulLin.flip z) :=
    fun j z => β.ext fun k => DFunLike.congr_fun (h_assoc_jk_lin j k) z
  have h_assoc_lin : ∀ y z : A₁,
      (mulLin.flip z).comp (mulLin.flip y) = mulLin.flip (mulLin y z) :=
    fun y z => β.ext fun j => DFunLike.congr_fun (h_assoc_j_lin j z) y
  have h_assoc : ∀ x y z : A₁, mulLin (mulLin x y) z = mulLin x (mulLin y z) :=
    fun x y z => DFunLike.congr_fun (h_assoc_lin y z) x

  let instComm : CommRing A₁ :=
    { (inferInstance : AddCommGroup A₁) with
      mul := fun x y => mulLin x y
      one := β ⟨0, hℓ_pos⟩
      left_distrib := fun x y z => map_add (mulLin x) y z
      right_distrib := fun x y z => by
        change mulLin (x + y) z = mulLin x z + mulLin y z
        rw [map_add, LinearMap.add_apply]
      zero_mul := fun x => by
        change mulLin 0 x = 0
        rw [map_zero, LinearMap.zero_apply]
      mul_zero := fun x => map_zero (mulLin x)
      mul_assoc := h_assoc
      one_mul := h_one_mul
      mul_one := h_mul_one
      mul_comm := h_comm }
  let _ : CommRing A₁ := instComm
  let algA₁ : Algebra R₁ A₁ := Algebra.ofModule
    (fun r x y => by
      change mulLin (r • x) y = r • mulLin x y
      rw [map_smul, LinearMap.smul_apply])
    (fun r x y => map_smul (mulLin x) r y)
  let _ : Algebra R₁ A₁ := algA₁

  have hFree : Module.Free R₁ A₁ := Module.Free.of_basis β
  have hFin : Module.Finite R₁ A₁ := Module.Finite.of_basis β
  have hFF : Module.FaithfullyFlat R₁ A₁ := by
    rw [Module.FaithfullyFlat.iff_flat_and_ideal_smul_eq_top]
    refine ⟨Module.Flat.of_free, fun I hI => ?_⟩
    let φ : A₁ →ₗ[R₁] R₁ := β.coord ⟨0, hℓ_pos⟩
    have hφ_mem : ∀ x ∈ I • (⊤ : Submodule R₁ A₁), φ x ∈ I := by
      intro x hx
      refine Submodule.smul_induction_on hx (fun r hr y _ => ?_) (fun u v hu hv => I.add_mem hu hv)
      rw [map_smul, smul_eq_mul]
      exact I.mul_mem_right (φ y) hr
    have h1_mem : (1 : R₁) ∈ I := by
      have htop : β ⟨0, hℓ_pos⟩ ∈ I • (⊤ : Submodule R₁ A₁) := by
        rw [hI]
        exact Submodule.mem_top
      have hcoord : φ (β ⟨0, hℓ_pos⟩) = 1 := by
        simp [φ]
      rw [← hcoord]
      exact hφ_mem _ htop
    exact top_unique fun r _ => by simpa using I.mul_mem_left r h1_mem

  have hKummerIso : ∀ (S : Type u) [CommRing S] [Algebra R₁ S]
      (s₀ : S) (w : TensorProduct R₁ S A₁) (σ : Equiv.Perm (Fin ℓ)) (μ : Fin ℓ → Units S),
      w ^ ℓ = algebraMap S (TensorProduct R₁ S A₁) s₀ →
      (∀ r : Fin ℓ, w ^ (r : ℕ) = (μ r : S) • ((1 : S) ⊗ₜ[R₁] β (σ r))) →
      Nonempty ((Polynomial S ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C s₀}) ≃ₐ[S]
        TensorProduct R₁ S A₁) := by
    intro S _ _ s₀ w σ μ hw_pow hw_basis
    let f₀ : Polynomial S := Polynomial.X ^ ℓ - Polynomial.C s₀
    let I₀ : Ideal (Polynomial S) := Ideal.span {f₀}
    have h_vanish : ∀ p ∈ I₀, Polynomial.aeval w p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      rw [map_mul, show Polynomial.aeval w f₀ = 0 by
        simp [f₀, hw_pow], zero_mul]
    let F_w : (Polynomial S ⧸ I₀) →ₐ[S] TensorProduct R₁ S A₁ :=
      Ideal.Quotient.liftₐ I₀ (Polynomial.aeval w) h_vanish
    let mkQ : Polynomial S →ₐ[S] (Polynomial S ⧸ I₀) := Ideal.Quotient.mkₐ S I₀
    let xBar : Polynomial S ⧸ I₀ := mkQ Polynomial.X
    have hFw_xBar : ∀ n : ℕ, F_w (xBar ^ n) = w ^ n := by
      intro n
      rw [map_pow]
      congr 1
      change Ideal.Quotient.lift I₀ (Polynomial.aeval w).toRingHom h_vanish
        (Ideal.Quotient.mk I₀ Polynomial.X) = w
      rw [Ideal.Quotient.lift_mk]
      exact Polynomial.aeval_X w
    have hxBar_pow : xBar ^ ℓ = algebraMap S (Polynomial S ⧸ I₀) s₀ := by
      have h0 : mkQ f₀ = 0 := by
        change Ideal.Quotient.mk I₀ f₀ = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      have hexp : mkQ f₀ = xBar ^ ℓ - algebraMap S (Polynomial S ⧸ I₀) s₀ := by
        simp [f₀, xBar, Polynomial.C_eq_algebraMap]
      exact sub_eq_zero.mp (hexp.symm.trans h0)
    let b₀ : Module.Basis (Fin ℓ) S (TensorProduct R₁ S A₁) := Algebra.TensorProduct.basis S β
    let b₁ : Module.Basis (Fin ℓ) S (TensorProduct R₁ S A₁) := b₀.reindex σ.symm
    let b_B : Module.Basis (Fin ℓ) S (TensorProduct R₁ S A₁) := b₁.unitsSMul μ
    have hb_B : ∀ r : Fin ℓ, b_B r = w ^ (r : ℕ) := by
      intro r
      dsimp only [b_B]
      rw [Module.Basis.unitsSMul_apply, Units.smul_def]
      dsimp only [b₁, b₀]
      rw [Module.Basis.reindex_apply, Equiv.symm_symm, Algebra.TensorProduct.basis_apply,
        ← hw_basis r]
    let Ψ_to : (Fin ℓ → S) → (Polynomial S ⧸ I₀) :=
      fun g => Finset.univ.sum fun r : Fin ℓ => g r • xBar ^ (r : ℕ)
    have h_comp : ∀ g : Fin ℓ → S, F_w (Ψ_to g) = b_B.equivFun.symm g := by
      intro g
      dsimp [Ψ_to]
      rw [map_sum, Module.Basis.equivFun_symm_apply]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_smul, hFw_xBar, hb_B]
    have hΨ_surj : Function.Surjective Ψ_to := by
      intro y
      obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective y
      have hp' : mkQ p = y := hp
      rw [← hp']
      refine Polynomial.induction_on' p ?_ ?_
      · intro p₁ p₂ ⟨g₁, hg₁⟩ ⟨g₂, hg₂⟩
        refine ⟨g₁ + g₂, ?_⟩
        dsimp [Ψ_to] at hg₁ hg₂ ⊢
        simp only [add_smul, Finset.sum_add_distrib, hg₁, hg₂, map_add]
      · intro n a
        let r₀ : Fin ℓ := ⟨n % ℓ, Nat.mod_lt n hℓ_pos⟩
        refine ⟨Pi.single r₀ (a * s₀ ^ (n / ℓ)), ?_⟩
        dsimp [Ψ_to]
        rw [Fintype.sum_eq_single r₀ (fun r hr => by rw [Pi.single_eq_of_ne hr, zero_smul]),
          Pi.single_eq_same]
        have hmon : mkQ (Polynomial.monomial n a) =
            algebraMap S (Polynomial S ⧸ I₀) a * xBar ^ n := by
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow]
          simp [xBar, Polynomial.C_eq_algebraMap]
        have hpow_n : xBar ^ n =
            algebraMap S (Polynomial S ⧸ I₀) (s₀ ^ (n / ℓ)) * xBar ^ (n % ℓ) := by
          conv_lhs => rw [← Nat.div_add_mod n ℓ]
          rw [pow_add, pow_mul, hxBar_pow, ← map_pow]
        rw [hmon, hpow_n, ← mul_assoc, ← map_mul]
        exact Algebra.smul_def (a * s₀ ^ (n / ℓ)) (xBar ^ (n % ℓ))
    refine ⟨AlgEquiv.ofBijective F_w ⟨?_, ?_⟩⟩
    · intro y₁ y₂ hy
      obtain ⟨g₁, rfl⟩ := hΨ_surj y₁
      obtain ⟨g₂, rfl⟩ := hΨ_surj y₂
      rw [h_comp, h_comp] at hy
      rw [b_B.equivFun.symm.injective hy]
    · intro z
      refine ⟨Ψ_to (b_B.equivFun z), ?_⟩
      rw [h_comp, b_B.equivFun.symm_apply_apply]

  have hTensor_e0 : ∀ (S : Type u) [CommRing S] [Algebra R₁ S],
      ((1 : S) ⊗ₜ[R₁] β ⟨0, hℓ_pos⟩ : TensorProduct R₁ S A₁) = 1 := by
    intro S _ _
    exact Algebra.TensorProduct.one_def.symm

  have hTensor_smul : ∀ (S : Type u) [CommRing S] [Algebra R₁ S] (s : S) (x : A₁),
      s • ((1 : S) ⊗ₜ[R₁] x : TensorProduct R₁ S A₁) =
        algebraMap S (TensorProduct R₁ S A₁) s * ((1 : S) ⊗ₜ[R₁] x) := by
    intro S _ _ s x
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
      mul_one, one_mul, TensorProduct.smul_tmul', smul_eq_mul, mul_one,
      Algebra.algebraMap_self, RingHom.id_apply]

  have hTensor_mul : ∀ (S : Type u) [CommRing S] [Algebra R₁ S] (j k : Fin ℓ),
      ((1 : S) ⊗ₜ[R₁] β j : TensorProduct R₁ S A₁) * ((1 : S) ⊗ₜ[R₁] β k) =
        algebraMap S (TensorProduct R₁ S A₁)
          ((algebraMap R₁ S (u₁ : R₁)) ^ ((j.1 + k.1) / ℓ) *
            Finset.univ.prod fun b : Fin m =>
              (algebraMap R₁ S (t b)) ^ (carry (c b) j.1 k.1)) *
          ((1 : S) ⊗ₜ[R₁] β (remIdx j k)) := by
    intro S _ _ j k
    have h1 : ((1 : S) ⊗ₜ[R₁] β j : TensorProduct R₁ S A₁) * ((1 : S) ⊗ₜ[R₁] β k) =
        (1 : S) ⊗ₜ[R₁] (coeff j k • β (remIdx j k)) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      exact congrArg ((1 : S) ⊗ₜ[R₁] ·) (hmul j k)
    have h2 : ((1 : S) ⊗ₜ[R₁] (coeff j k • β (remIdx j k)) : TensorProduct R₁ S A₁) =
        algebraMap S (TensorProduct R₁ S A₁) (algebraMap R₁ S (coeff j k)) *
          ((1 : S) ⊗ₜ[R₁] β (remIdx j k)) := by
      rw [← TensorProduct.smul_tmul, Algebra.smul_def (coeff j k) (1 : S), mul_one,
        Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
        mul_one, one_mul, Algebra.algebraMap_self, RingHom.id_apply]
    have h3 : algebraMap R₁ S (coeff j k) =
        (algebraMap R₁ S (u₁ : R₁)) ^ ((j.1 + k.1) / ℓ) *
          Finset.univ.prod fun b : Fin m =>
            (algebraMap R₁ S (t b)) ^ (carry (c b) j.1 k.1) := by
      dsimp [coeff]
      simp only [map_mul, map_pow, map_prod]
    rw [h1, h2, h3]

  have he1_pow : ∀ (S : Type u) [CommRing S] [Algebra R₁ S] (r : ℕ), r ≤ ℓ →
      ((1 : S) ⊗ₜ[R₁] β ⟨1, hℓ_gt1⟩ : TensorProduct R₁ S A₁) ^ r =
        algebraMap S (TensorProduct R₁ S A₁)
          ((algebraMap R₁ S (u₁ : R₁)) ^ (r / ℓ) *
            Finset.univ.prod fun b : Fin m =>
              (algebraMap R₁ S (t b)) ^ ((r * c b) / ℓ)) *
          ((1 : S) ⊗ₜ[R₁] β ⟨r % ℓ, Nat.mod_lt _ hℓ_pos⟩) := by
    intro S _ _ r
    induction r with
    | zero =>
      intro _
      have h0 : (⟨0 % ℓ, Nat.mod_lt _ hℓ_pos⟩ : Fin ℓ) = ⟨0, hℓ_pos⟩ := by
        ext
        exact Nat.zero_mod ℓ
      have hprod1 : (Finset.univ.prod fun b : Fin m =>
          (algebraMap R₁ S (t b)) ^ ((0 * c b) / ℓ)) = 1 := by
        refine Finset.prod_eq_one fun b _ => ?_
        rw [zero_mul, Nat.zero_div, pow_zero]
      rw [pow_zero, Nat.zero_div, pow_zero, one_mul, h0, hTensor_e0 S, mul_one, hprod1, map_one]
    | succ r ih =>
      intro hr1
      have hr : r < ℓ := by omega
      have h_ih := ih (Nat.le_of_lt hr)
      have hr_div : r / ℓ = 0 := Nat.div_eq_of_lt hr
      have hr_mod : (⟨r % ℓ, Nat.mod_lt _ hℓ_pos⟩ : Fin ℓ) = ⟨r, hr⟩ := by
        ext
        exact Nat.mod_eq_of_lt hr
      rw [pow_succ, h_ih, hr_div, pow_zero, one_mul, hr_mod, mul_assoc,
        hTensor_mul S ⟨r, hr⟩ ⟨1, hℓ_gt1⟩, ← mul_assoc, ← map_mul]
      congr 1
      congr 1
      rw [mul_left_comm, ← Finset.prod_mul_distrib]
      congr 1
      refine Finset.prod_congr rfl fun b _ => ?_
      rw [← pow_add]
      congr 1
      have hda := h_div_add (c b) r 1
      dsimp [carry] at hda ⊢
      have hc_div : (1 * c b) / ℓ = 0 := by
        rw [one_mul]
        exact Nat.div_eq_of_lt (hc_lt b)
      omega

  refine ⟨A₁, instComm, algA₁, hFree, hFin, hFF, ?_, ?_, ?_⟩
  · intro R₀₁ _ _ hu
    let w : TensorProduct R₁ R₀₁ A₁ := (1 : R₀₁) ⊗ₜ[R₁] β ⟨1, hℓ_gt1⟩
    have hw_pow : w ^ ℓ = algebraMap R₀₁ (TensorProduct R₁ R₀₁ A₁)
        (algebraMap R₁ R₀₁ ((u₁ : R₁) * Finset.univ.prod fun a : Fin m => (t a) ^ (c a))) := by
      have hp := he1_pow R₀₁ ℓ le_rfl
      have h0 : (⟨ℓ % ℓ, Nat.mod_lt _ hℓ_pos⟩ : Fin ℓ) = ⟨0, hℓ_pos⟩ := by
        ext
        exact Nat.mod_self ℓ
      rw [h0, hTensor_e0 R₀₁, mul_one, Nat.div_self hℓ_pos, pow_one] at hp
      refine hp.trans ?_
      congr 1
      simp only [map_mul, map_prod, map_pow]
      congr 1
      refine Finset.prod_congr rfl fun b _ => ?_
      rw [Nat.mul_div_right (c b) hℓ_pos]
    have hU : ∀ r : Fin ℓ, IsUnit
        (Finset.univ.prod fun b : Fin m => (algebraMap R₁ R₀₁ (t b)) ^ ((r.1 * c b) / ℓ)) := by
      intro r
      exact Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one
        fun b _ => (hu b).pow _
    let μ : Fin ℓ → Units R₀₁ := fun r => (hU r).unit
    have hw_basis : ∀ r : Fin ℓ,
        w ^ (r : ℕ) = (μ r : R₀₁) • ((1 : R₀₁) ⊗ₜ[R₁] β (Equiv.refl (Fin ℓ) r)) := by
      intro r
      have hp := he1_pow R₀₁ r.1 (Nat.le_of_lt r.2)
      have hr_mod : (⟨r.1 % ℓ, Nat.mod_lt _ hℓ_pos⟩ : Fin ℓ) = r := by
        ext
        exact Nat.mod_eq_of_lt r.2
      rw [Nat.div_eq_of_lt r.2, pow_zero, one_mul, hr_mod] at hp
      rw [hp, Equiv.refl_apply, hTensor_smul R₀₁ (μ r : R₀₁) (β r)]
      rfl
    exact hKummerIso R₀₁ _ w (Equiv.refl (Fin ℓ)) μ hw_pow hw_basis

  · intro a hca0 R_loc _ _ hu_other
    let w : TensorProduct R₁ R_loc A₁ := (1 : R_loc) ⊗ₜ[R₁] β ⟨1, hℓ_gt1⟩
    let u_S : Units R_loc := Units.map (algebraMap R₁ R_loc).toMonoidHom u₁
    have hU : ∀ n : ℕ, IsUnit
        (Finset.univ.prod fun b : Fin m => (algebraMap R₁ R_loc (t b)) ^ ((n * c b) / ℓ)) := by
      intro n
      rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ a)]
      rw [hca0, mul_zero, Nat.zero_div, pow_zero, one_mul]
      exact Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one
        fun b hb => (hu_other b (Finset.ne_of_mem_erase hb)).pow _
    let u_loc : Units R_loc := u_S * (hU ℓ).unit
    refine ⟨u_loc, ?_⟩
    have hw_pow : w ^ ℓ = algebraMap R_loc (TensorProduct R₁ R_loc A₁) (u_loc : R_loc) := by
      have hp := he1_pow R_loc ℓ le_rfl
      have h0 : (⟨ℓ % ℓ, Nat.mod_lt _ hℓ_pos⟩ : Fin ℓ) = ⟨0, hℓ_pos⟩ := by
        ext
        exact Nat.mod_self ℓ
      rw [h0, hTensor_e0 R_loc, mul_one, Nat.div_self hℓ_pos, pow_one] at hp
      exact hp
    let μ : Fin ℓ → Units R_loc := fun r => (hU r.1).unit
    have hw_basis : ∀ r : Fin ℓ,
        w ^ (r : ℕ) = (μ r : R_loc) • ((1 : R_loc) ⊗ₜ[R₁] β (Equiv.refl (Fin ℓ) r)) := by
      intro r
      have hp := he1_pow R_loc r.1 (Nat.le_of_lt r.2)
      have hr_mod : (⟨r.1 % ℓ, Nat.mod_lt _ hℓ_pos⟩ : Fin ℓ) = r := by
        ext
        exact Nat.mod_eq_of_lt r.2
      rw [Nat.div_eq_of_lt r.2, pow_zero, one_mul, hr_mod] at hp
      rw [hp, Equiv.refl_apply, hTensor_smul R_loc (μ r : R_loc) (β r)]
      rfl
    exact hKummerIso R_loc _ w (Equiv.refl (Fin ℓ)) μ hw_pow hw_basis

  · intro a hca1 R_loc _ _ hu_other
    let _ : Fact (1 < ℓ) := ⟨hℓ_gt1⟩
    let z_c : ZMod ℓ := (c a : ZMod ℓ)
    have hz_c : z_c ≠ 0 := by
      intro h0
      have hdvd : ℓ ∣ c a := (ZMod.natCast_eq_zero_iff (c a) ℓ).mp h0
      have hle : ℓ ≤ c a := Nat.le_of_dvd (by omega) hdvd
      exact absurd (hc_lt a) (by omega)
    let z_α : ZMod ℓ := z_c⁻¹
    have hz_mul : z_α * z_c = 1 := inv_mul_cancel₀ hz_c
    let α_val : ℕ := z_α.val
    have hα_lt : α_val < ℓ := ZMod.val_lt z_α
    have hα_mod : (α_val * c a) % ℓ = 1 := by
      have hv := ZMod.val_mul z_α z_c
      rw [hz_mul, ZMod.val_one] at hv
      have hvc : z_c.val = c a := by
        dsimp [z_c]
        rw [ZMod.val_natCast, Nat.mod_eq_of_lt (hc_lt a)]
      rw [hvc] at hv
      exact hv.symm
    have h_mod_inv : ∀ x : ℕ, (((x * α_val) % ℓ) * c a) % ℓ = x % ℓ := by
      intro x
      calc
        (((x * α_val) % ℓ) * c a) % ℓ = ((x * α_val) * c a) % ℓ := Nat.mod_mul_mod _ _ _
        _ = (x * (α_val * c a)) % ℓ := by rw [mul_assoc]
        _ = (x * ((α_val * c a) % ℓ)) % ℓ := (Nat.mul_mod_mod x _ ℓ).symm
        _ = x % ℓ := by rw [hα_mod, mul_one]
    let σ : Equiv.Perm (Fin ℓ) :=
      { toFun := fun r => ⟨(r.1 * α_val) % ℓ, Nat.mod_lt _ hℓ_pos⟩
        invFun := fun j => ⟨(j.1 * c a) % ℓ, Nat.mod_lt _ hℓ_pos⟩
        left_inv := fun r => by
          ext
          dsimp
          rw [h_mod_inv r.1, Nat.mod_eq_of_lt r.2]
        right_inv := fun j => by
          ext
          dsimp
          calc
            (((j.1 * c a) % ℓ) * α_val) % ℓ = ((j.1 * c a) * α_val) % ℓ := Nat.mod_mul_mod _ _ _
            _ = (j.1 * (α_val * c a)) % ℓ := by rw [mul_assoc, mul_comm (c a) α_val]
            _ = (j.1 * ((α_val * c a) % ℓ)) % ℓ := (Nat.mul_mod_mod j.1 _ ℓ).symm
            _ = j.1 := by rw [hα_mod, mul_one, Nat.mod_eq_of_lt j.2] }
    have h_carry_a : ∀ r : ℕ, r < ℓ → carry (c a) ((r * α_val) % ℓ) α_val = (r + 1) / ℓ := by
      intro r hr
      dsimp [carry]
      rw [h_mod_inv r, Nat.mod_eq_of_lt hr, hα_mod]

    let e : Fin ℓ → TensorProduct R₁ R_loc A₁ := fun j => (1 : R_loc) ⊗ₜ[R₁] β j
    let u_S : Units R_loc := Units.map (algebraMap R₁ R_loc).toMonoidHom u₁
    let w : TensorProduct R₁ R_loc A₁ := e ⟨α_val, hα_lt⟩
    have h_ind : ∀ r : ℕ, r < ℓ →
        ∃ μ_r : Units R_loc, w ^ r = (μ_r : R_loc) • e ⟨(r * α_val) % ℓ, Nat.mod_lt _ hℓ_pos⟩ := by
      intro r
      induction r with
      | zero =>
        intro _
        refine ⟨1, ?_⟩
        have h0 : (⟨(0 * α_val) % ℓ, Nat.mod_lt _ hℓ_pos⟩ : Fin ℓ) = ⟨0, hℓ_pos⟩ := by
          ext
          dsimp
          rw [zero_mul, Nat.zero_mod]
        rw [pow_zero, h0, Units.val_one, one_smul]
        exact (hTensor_e0 R_loc).symm
      | succ r ih =>
        intro hr1
        obtain ⟨μ_r, hμ_r⟩ := ih (by omega)
        let j_r : Fin ℓ := ⟨(r * α_val) % ℓ, Nat.mod_lt _ hℓ_pos⟩
        have hU_r : IsUnit
            (Finset.univ.prod fun b : Fin m =>
              (algebraMap R₁ R_loc (t b)) ^ (carry (c b) j_r.1 α_val)) := by
          refine Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one
            fun b _ => ?_
          by_cases hba : b = a
          · subst hba
            have h0 : carry (c b) j_r.1 α_val = 0 := by
              dsimp [j_r]
              rw [h_carry_a r (by omega)]
              exact Nat.div_eq_of_lt hr1
            rw [h0, pow_zero]
            exact isUnit_one
          · exact (hu_other b hba).pow _
        let μ_next : Units R_loc := μ_r * u_S ^ ((j_r.1 + α_val) / ℓ) * hU_r.unit
        refine ⟨μ_next, ?_⟩
        have h_rem : remIdx j_r ⟨α_val, hα_lt⟩ = ⟨((r + 1) * α_val) % ℓ, Nat.mod_lt _ hℓ_pos⟩ := by
          ext
          dsimp [remIdx, j_r]
          rw [Nat.mod_add_mod, ← Nat.succ_mul]
        calc
          w ^ (r + 1) = w ^ r * w := pow_succ w r
          _ = ((μ_r : R_loc) • e j_r) * e ⟨α_val, hα_lt⟩ := by rw [hμ_r]
          _ = algebraMap R_loc (TensorProduct R₁ R_loc A₁) (μ_r : R_loc) *
                (e j_r * e ⟨α_val, hα_lt⟩) := by
            dsimp only [e]
            rw [hTensor_smul R_loc (μ_r : R_loc) (β j_r), mul_assoc]
          _ = (μ_next : R_loc) • e ⟨((r + 1) * α_val) % ℓ, Nat.mod_lt _ hℓ_pos⟩ := by
            dsimp only [e]
            rw [hTensor_mul R_loc j_r ⟨α_val, hα_lt⟩, h_rem, ← mul_assoc, ← map_mul,
              hTensor_smul R_loc (μ_next : R_loc)]
            congr 2
            dsimp only [μ_next, u_S]
            rw [Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val, IsUnit.unit_spec]
            exact (mul_assoc _ _ _).symm
    let μ : Fin ℓ → Units R_loc := fun r => Classical.choose (h_ind r.1 r.2)
    have hw_basis : ∀ r : Fin ℓ, w ^ (r : ℕ) = (μ r : R_loc) • e (σ r) :=
      fun r => Classical.choose_spec (h_ind r.1 r.2)

    let r_top : Fin ℓ := ⟨ℓ - 1, Nat.sub_lt hℓ_pos zero_lt_one⟩
    let j_top : Fin ℓ := σ r_top
    have hU_other : IsUnit
        (Finset.prod (Finset.univ.erase a) fun b : Fin m =>
          (algebraMap R₁ R_loc (t b)) ^ (carry (c b) j_top.1 α_val)) :=
      Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one
        fun b hb => (hu_other b (Finset.ne_of_mem_erase hb)).pow _
    let u_ram : Units R_loc := μ r_top * u_S ^ ((j_top.1 + α_val) / ℓ) * hU_other.unit
    refine ⟨u_ram, ?_⟩
    have hw_pow : w ^ ℓ =
        algebraMap R_loc (TensorProduct R₁ R_loc A₁)
          ((u_ram : R_loc) * algebraMap R₁ R_loc (t a)) := by
      have hℓ_eq : (ℓ - 1) + 1 = ℓ := Nat.sub_add_cancel hℓ_pos
      have h_rem_top : remIdx j_top ⟨α_val, hα_lt⟩ = ⟨0, hℓ_pos⟩ := by
        ext
        dsimp [remIdx, j_top, σ, r_top]
        rw [Nat.mod_add_mod, ← Nat.succ_mul, Nat.succ_eq_add_one, hℓ_eq, Nat.mul_mod_right]
      have h_prod_top :
          (Finset.univ.prod fun b : Fin m =>
            (algebraMap R₁ R_loc (t b)) ^ (carry (c b) j_top.1 α_val)) =
          algebraMap R₁ R_loc (t a) * (hU_other.unit : R_loc) := by
        rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ a)]
        have hca_top : carry (c a) j_top.1 α_val = 1 := by
          dsimp [j_top, σ, r_top]
          rw [h_carry_a (ℓ - 1) (Nat.sub_lt hℓ_pos zero_lt_one), hℓ_eq, Nat.div_self hℓ_pos]
        rw [hca_top, pow_one, IsUnit.unit_spec]
      calc
        w ^ ℓ = w ^ ((ℓ - 1) + 1) := by rw [hℓ_eq]
        _ = w ^ (r_top : ℕ) * w := pow_succ w (ℓ - 1)
        _ = ((μ r_top : R_loc) • e j_top) * e ⟨α_val, hα_lt⟩ := by rw [hw_basis r_top]
        _ = algebraMap R_loc (TensorProduct R₁ R_loc A₁) (μ r_top : R_loc) *
              (e j_top * e ⟨α_val, hα_lt⟩) := by
          dsimp only [e]
          rw [hTensor_smul R_loc (μ r_top : R_loc) (β j_top), mul_assoc]
        _ = algebraMap R_loc (TensorProduct R₁ R_loc A₁)
              ((u_ram : R_loc) * algebraMap R₁ R_loc (t a)) := by
          dsimp only [e]
          rw [hTensor_mul R_loc j_top ⟨α_val, hα_lt⟩, h_rem_top, hTensor_e0 R_loc, mul_one,
            ← map_mul, h_prod_top]
          congr 1
          dsimp only [u_ram, u_S]
          rw [Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val]
          change (μ r_top : R_loc) *
              ((algebraMap R₁ R_loc (u₁ : R₁)) ^ ((j_top.1 + α_val) / ℓ) *
                (algebraMap R₁ R_loc (t a) * (hU_other.unit : R_loc))) =
            (μ r_top : R_loc) * (algebraMap R₁ R_loc (u₁ : R₁)) ^ ((j_top.1 + α_val) / ℓ) *
              (hU_other.unit : R_loc) * algebraMap R₁ R_loc (t a)
          ring
    exact hKummerIso R_loc _ w σ μ hw_pow hw_basis

theorem weil_two_open_affine_cover_gluing (Y : AlgebraicGeometry.Scheme.{u})
    (U_0 U_1 : Y.Opens)
    (hAff_0 : AlgebraicGeometry.IsAffineOpen U_0)
    (hAff_1 : AlgebraicGeometry.IsAffineOpen U_1)
    (hAff_01 : AlgebraicGeometry.IsAffineOpen (U_0 ⊓ U_1))
    (hU_cov : U_0 ⊔ U_1 = ⊤)
    (A₀ : Type u) [CommRing A₀] [Algebra ↑(Y.presheaf.obj (Opposite.op U_0)) A₀]
    (A₁ : Type u) [CommRing A₁] [Algebra ↑(Y.presheaf.obj (Opposite.op U_1)) A₁]
    (Ψ₀₁ :
      let R₀ := ↑(Y.presheaf.obj (Opposite.op U_0))
      let R₁ := ↑(Y.presheaf.obj (Opposite.op U_1))
      let R₀₁ := ↑(Y.presheaf.obj (Opposite.op (U_0 ⊓ U_1)))
      let ρ₀ : R₀ →+* R₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
      let ρ₁ : R₁ →+* R₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
      letI : Algebra R₀ R₀₁ := ρ₀.toAlgebra
      letI : Algebra R₁ R₀₁ := ρ₁.toAlgebra
      TensorProduct R₁ R₀₁ A₁ ≃ₐ[R₀₁] TensorProduct R₀ R₀₁ A₀) :
    ∃ (Y_tilde : AlgebraicGeometry.Scheme.{u})
      (ν : Quiver.Hom Y_tilde Y)
      (ι₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A₀)) Y_tilde)
      (ι₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A₁)) Y_tilde),
      AlgebraicGeometry.IsOpenImmersion ι₀ ∧
      AlgebraicGeometry.IsOpenImmersion ι₁ ∧
      CategoryTheory.IsPullback ι₀
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↑(Y.presheaf.obj (Opposite.op U_0)) A₀)))
          hAff_0.isoSpec.inv)
        ν U_0.ι ∧
      CategoryTheory.IsPullback ι₁
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↑(Y.presheaf.obj (Opposite.op U_1)) A₁)))
          hAff_1.isoSpec.inv)
        ν U_1.ι :=
by
  let R₀ : Type u := ↑(Y.presheaf.obj (Opposite.op U_0))
  let R₁ : Type u := ↑(Y.presheaf.obj (Opposite.op U_1))
  let R₀₁ : Type u := ↑(Y.presheaf.obj (Opposite.op (U_0 ⊓ U_1)))
  let ρ₀ : R₀ →+* R₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
  let ρ₁ : R₁ →+* R₀₁ := (Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
  let : Algebra R₀ R₀₁ := ρ₀.toAlgebra
  let : Algebra R₁ R₀₁ := ρ₁.toAlgebra
  
  let U_span : CategoryTheory.Limits.WalkingSpan → Y.Opens := fun i =>
    match i with
    | none => U_0 ⊓ U_1
    | some .left => U_0
    | some .right => U_1
  have hSup : iSup U_span = ⊤ := by
    apply le_antisymm le_top
    rw [← hU_cov]
    exact sup_le
      (le_iSup U_span CategoryTheory.Limits.WalkingSpan.left)
      (le_iSup U_span CategoryTheory.Limits.WalkingSpan.right)
  let 𝒰 : Y.OpenCover :=
    Y.openCoverOfIsOpenCover U_span (TopologicalSpace.IsOpenCover.mk hSup)
  let : CategoryTheory.SmallCategory 𝒰.I₀ :=
    (inferInstance : CategoryTheory.SmallCategory CategoryTheory.Limits.WalkingSpan)
  let : Small.{u} 𝒰.I₀ :=
    (inferInstance : Small.{u} CategoryTheory.Limits.WalkingSpan)
  have : Quiver.IsThin 𝒰.I₀ :=
    (inferInstance : Quiver.IsThin CategoryTheory.Limits.WalkingSpan)
  
  have h_le : ∀ {i j : 𝒰.I₀}, (i ⟶ j) → U_span i ≤ U_span j := by
    intro i j hij
    rcases hij with _ | (_ | _)
    · exact le_rfl
    · exact inf_le_left
    · exact inf_le_right
  let trans_span : ∀ {i j : 𝒰.I₀}, (i ⟶ j) → (𝒰.X i ⟶ 𝒰.X j) :=
    fun hij => Y.homOfLE (h_le hij)
  have h_w : ∀ {i j : 𝒰.I₀} (hij : i ⟶ j), trans_span hij ≫ 𝒰.f j = 𝒰.f i :=
    fun hij => Y.homOfLE_ι (h_le hij)
  let : AlgebraicGeometry.Scheme.Cover.LocallyDirected 𝒰 := by
    refine AlgebraicGeometry.Scheme.Cover.LocallyDirected.mk
      (trans := @trans_span)
      (trans_id := ?_)
      (trans_comp := ?_)
      (w := @h_w)
      (property_trans := fun hij => by
        show AlgebraicGeometry.IsOpenImmersion (Y.homOfLE (h_le hij))
        infer_instance)
      (directed := ?_)
    · intro i
      apply (cancel_mono (𝒰.f i)).mp
      rw [CategoryTheory.Category.id_comp]
      exact h_w (𝟙 i)
    · intro i j k hij hjk
      apply (cancel_mono (𝒰.f k)).mp
      rw [CategoryTheory.Category.assoc, h_w hjk, h_w hij, h_w (hij ≫ hjk)]
    · intro i j x
      let fst_ij := CategoryTheory.Limits.pullback.fst (𝒰.f i) (𝒰.f j)
      let snd_ij := CategoryTheory.Limits.pullback.snd (𝒰.f i) (𝒰.f j)
      let x₁ : ↥(U_span i) := fst_ij.base x
      let x₂ : ↥(U_span j) := snd_ij.base x
      have hx_cond : (fst_ij ≫ 𝒰.f i).base x = (snd_ij ≫ 𝒰.f j).base x :=
        congrArg (fun h : AlgebraicGeometry.Scheme.Hom _ _ => h.base x)
          CategoryTheory.Limits.pullback.condition
      have hx_eq : x₁.1 = x₂.1 := hx_cond
      let y₀ : ↥Y := x₁.1
      have hy_i : y₀ ∈ U_span i := x₁.2
      have hy_j : y₀ ∈ U_span j := by
        dsimp only [y₀]
        rw [hx_eq]
        exact x₂.2
      have h_lift_eq : ∀ (k : 𝒰.I₀) (hki : k ⟶ i) (hkj : k ⟶ j)
          (hy : y₀ ∈ U_span k),
          (CategoryTheory.Limits.pullback.lift (trans_span hki) (trans_span hkj)
            ((h_w hki).trans (h_w hkj).symm)).base (⟨y₀, hy⟩ : ↥(𝒰.X k)) = x := by
        intro k hki hkj hy
        apply fst_ij.isOpenEmbedding.injective
        apply (𝒰.f i).isOpenEmbedding.injective
        have h1 : (CategoryTheory.Limits.pullback.lift (trans_span hki) (trans_span hkj)
            ((h_w hki).trans (h_w hkj).symm) ≫ fst_ij) ≫ 𝒰.f i = 𝒰.f k := by
          rw [CategoryTheory.Limits.pullback.lift_fst, h_w hki]
        exact congrArg (fun h : AlgebraicGeometry.Scheme.Hom (𝒰.X k) Y =>
          h.base (⟨y₀, hy⟩ : ↥(𝒰.X k))) h1
      let z0 : 𝒰.I₀ := CategoryTheory.Limits.WalkingSpan.zero
      let zl : 𝒰.I₀ := CategoryTheory.Limits.WalkingSpan.left
      let zr : 𝒰.I₀ := CategoryTheory.Limits.WalkingSpan.right
      let hfst : z0 ⟶ zl := CategoryTheory.Limits.WalkingSpan.Hom.fst
      let hsnd : z0 ⟶ zr := CategoryTheory.Limits.WalkingSpan.Hom.snd
      rcases i with _ | (_ | _) <;> rcases j with _ | (_ | _)
      · exact ⟨z0, 𝟙 z0, 𝟙 z0, ⟨y₀, hy_i⟩, h_lift_eq z0 (𝟙 z0) (𝟙 z0) hy_i⟩
      · exact ⟨z0, 𝟙 z0, hfst, ⟨y₀, hy_i⟩, h_lift_eq z0 (𝟙 z0) hfst hy_i⟩
      · exact ⟨z0, 𝟙 z0, hsnd, ⟨y₀, hy_i⟩, h_lift_eq z0 (𝟙 z0) hsnd hy_i⟩
      · exact ⟨z0, hfst, 𝟙 z0, ⟨y₀, hy_j⟩, h_lift_eq z0 hfst (𝟙 z0) hy_j⟩
      · exact ⟨zl, 𝟙 zl, 𝟙 zl, ⟨y₀, hy_i⟩, h_lift_eq zl (𝟙 zl) (𝟙 zl) hy_i⟩
      · exact ⟨z0, hfst, hsnd, ⟨y₀, ⟨hy_i, hy_j⟩⟩, h_lift_eq z0 hfst hsnd ⟨hy_i, hy_j⟩⟩
      · exact ⟨z0, hsnd, 𝟙 z0, ⟨y₀, hy_j⟩, h_lift_eq z0 hsnd (𝟙 z0) hy_j⟩
      · exact ⟨z0, hsnd, hfst, ⟨y₀, ⟨hy_j, hy_i⟩⟩, h_lift_eq z0 hsnd hfst ⟨hy_j, hy_i⟩⟩
      · exact ⟨zr, 𝟙 zr, 𝟙 zr, ⟨y₀, hy_i⟩, h_lift_eq zr (𝟙 zr) (𝟙 zr) hy_i⟩
  
  have h_res₀ : hAff_01.isoSpec.inv ≫ Y.homOfLE inf_le_left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₀) ≫ hAff_0.isoSpec.inv := by
    apply (cancel_mono U_0.ι).mp
    rw [CategoryTheory.Category.assoc, Y.homOfLE_ι, hAff_01.isoSpec_inv_ι,
      CategoryTheory.Category.assoc, hAff_0.isoSpec_inv_ι]
    exact (hAff_0.map_fromSpec hAff_01 (CategoryTheory.homOfLE inf_le_left).op).symm
  have h_res₁ : hAff_01.isoSpec.inv ≫ Y.homOfLE inf_le_right =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫ hAff_1.isoSpec.inv := by
    apply (cancel_mono U_1.ι).mp
    rw [CategoryTheory.Category.assoc, Y.homOfLE_ι, hAff_01.isoSpec_inv_ι,
      CategoryTheory.Category.assoc, hAff_1.isoSpec_inv_ι]
    exact (hAff_1.map_fromSpec hAff_01 (CategoryTheory.homOfLE inf_le_right).op).symm
  
  let X₀₁ : AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₀ R₀₁ A₀))
  let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A₀)
  let X₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A₁)
  let g₀ : X₀₁ ⟶ X₀ :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := R₀) (A := R₀₁) (B := A₀)).toRingHom)
  let g₁ : X₀₁ ⟶ X₁ :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Ψ₀₁.toAlgHom.toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := R₁) (A := R₀₁) (B := A₁)).toRingHom))
  let F : CategoryTheory.Limits.WalkingSpan ⥤ AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.span g₀ g₁
  let π₀₁ : X₀₁ ⟶ (U_0 ⊓ U_1).toScheme :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := R₀) (A := R₀₁) (B := A₀))) ≫
      hAff_01.isoSpec.inv
  let π₀ : X₀ ⟶ U_0.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ A₀)) ≫ hAff_0.isoSpec.inv
  let π₁ : X₁ ⟶ U_1.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ A₁)) ≫ hAff_1.isoSpec.inv
  have hl : F.map CategoryTheory.Limits.WalkingSpan.Hom.fst ≫ π₀ =
      π₀₁ ≫ (𝒰.functorOfLocallyDirected).map CategoryTheory.Limits.WalkingSpan.Hom.fst := by
    change g₀ ≫ π₀ = π₀₁ ≫ Y.homOfLE inf_le_left
    dsimp only [π₀, π₀₁, g₀]
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Category.assoc _ hAff_01.isoSpec.inv,
      h_res₀, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r₀
    change (1 : R₀₁) ⊗ₜ[R₀] (algebraMap R₀ A₀ r₀) = (ρ₀ r₀) ⊗ₜ[R₀] (1 : A₀)
    rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
    rfl
  have hr : F.map CategoryTheory.Limits.WalkingSpan.Hom.snd ≫ π₁ =
      π₀₁ ≫ (𝒰.functorOfLocallyDirected).map CategoryTheory.Limits.WalkingSpan.Hom.snd := by
    change g₁ ≫ π₁ = π₀₁ ≫ Y.homOfLE inf_le_right
    dsimp only [π₁, π₀₁, g₁]
    rw [← CategoryTheory.Category.assoc, CategoryTheory.Category.assoc _ hAff_01.isoSpec.inv,
      h_res₁, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r₁
    change Ψ₀₁ ((1 : R₀₁) ⊗ₜ[R₁] (algebraMap R₁ A₁ r₁)) = (ρ₁ r₁) ⊗ₜ[R₀] (1 : A₀)
    have h_tmul : (1 : R₀₁) ⊗ₜ[R₁] (algebraMap R₁ A₁ r₁) =
        algebraMap R₀₁ (TensorProduct R₁ R₀₁ A₁) (ρ₁ r₁) := by
      rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      rfl
    rw [h_tmul]
    exact Ψ₀₁.commutes (ρ₁ r₁)
  let α : F ⟶ 𝒰.functorOfLocallyDirected :=
    CategoryTheory.Limits.spanHomMk π₀₁ π₀ π₁ hl hr
  
  have hPb_fst : CategoryTheory.IsPullback g₀ π₀₁ π₀ (Y.homOfLE inf_le_left) := by
    let f_ρ₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₀₁))
    let f_A₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ A₀))
    refine CategoryTheory.IsPullback.of_iso
      (CategoryTheory.IsPullback.of_hasPullback f_ρ₀ f_A₀).flip
      (AlgebraicGeometry.pullbackSpecIso R₀ R₀₁ A₀)
      (CategoryTheory.Iso.refl X₀)
      hAff_01.isoSpec.symm
      hAff_0.isoSpec.symm
      ?_ ?_ ?_ ?_
    · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      exact (AlgebraicGeometry.pullbackSpecIso_hom_snd R₀ R₀₁ A₀).symm
    · dsimp only [π₀₁, CategoryTheory.Iso.symm_hom]
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst R₀ R₀₁ A₀]
    · dsimp only [π₀, CategoryTheory.Iso.refl_hom, CategoryTheory.Iso.symm_hom]
      rw [CategoryTheory.Category.id_comp]
    · dsimp only [CategoryTheory.Iso.symm_hom]
      exact h_res₀.symm
  let iso_Ψ₀₁ : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₁ R₀₁ A₁)) ≅ X₀₁ :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ₀₁.symm.toAlgHom.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ₀₁.toAlgHom.toRingHom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
        congr 1
        apply CommRingCat.hom_ext
        exact RingHom.ext fun x => Ψ₀₁.symm_apply_apply x
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
        congr 1
        apply CommRingCat.hom_ext
        exact RingHom.ext fun x => Ψ₀₁.apply_symm_apply x }
  have hPb_snd : CategoryTheory.IsPullback g₁ π₀₁ π₁ (Y.homOfLE inf_le_right) := by
    let f_ρ₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ R₀₁))
    let f_A₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ A₁))
    refine CategoryTheory.IsPullback.of_iso
      (CategoryTheory.IsPullback.of_hasPullback f_ρ₁ f_A₁).flip
      (AlgebraicGeometry.pullbackSpecIso R₁ R₀₁ A₁ ≪≫ iso_Ψ₀₁)
      (CategoryTheory.Iso.refl X₁)
      hAff_01.isoSpec.symm
      hAff_1.isoSpec.symm
      ?_ ?_ ?_ ?_
    · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
        CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc]
      have h_cancel : iso_Ψ₀₁.hom ≫ g₁ =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := R₁) (A := R₀₁) (B := A₁)).toRingHom) := by
        dsimp only [iso_Ψ₀₁, g₁]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        exact RingHom.ext fun a₁ => Ψ₀₁.symm_apply_apply _
      rw [h_cancel]
      exact (AlgebraicGeometry.pullbackSpecIso_hom_snd R₁ R₀₁ A₁).symm
    · dsimp only [π₀₁, CategoryTheory.Iso.symm_hom]
      rw [CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc iso_Ψ₀₁.hom]
      have h_left : iso_Ψ₀₁.hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := R₀) (A := R₀₁) (B := A₀))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := R₁) (A := R₀₁) (B := A₁))) := by
        dsimp only [iso_Ψ₀₁]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        exact RingHom.ext fun r₀₁ => Ψ₀₁.symm.commutes r₀₁
      rw [h_left, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.pullbackSpecIso_hom_fst R₁ R₀₁ A₁]
    · dsimp only [π₁, CategoryTheory.Iso.refl_hom, CategoryTheory.Iso.symm_hom]
      rw [CategoryTheory.Category.id_comp]
    · dsimp only [CategoryTheory.Iso.symm_hom]
      exact h_res₁.symm
  have hEquifib : CategoryTheory.NatTrans.Equifibered α := by
    intro i j hij
    rcases hij with _ | (_ | _)
    · have h_id : ∀ (u : F.obj i ⟶ F.obj i)
          (v : (𝒰.functorOfLocallyDirected).obj i ⟶ (𝒰.functorOfLocallyDirected).obj i),
          u = 𝟙 _ → v = 𝟙 _ →
          CategoryTheory.IsPullback u (α.app i) (α.app i) v := by
        rintro _ _ rfl rfl
        exact CategoryTheory.IsPullback.of_id_fst
      exact h_id _ _ (F.map_id i) ((𝒰.functorOfLocallyDirected).map_id i)
    · exact hPb_fst
    · exact hPb_snd
  
  let d : AlgebraicGeometry.Scheme.Cover.RelativeGluingData 𝒰 :=
    ⟨F, α, hEquifib⟩
  have hHasColim_gen : ∀ (d' : AlgebraicGeometry.Scheme.Cover.RelativeGluingData 𝒰),
      CategoryTheory.Limits.HasColimit d'.functor := fun _ => inferInstance
  have : CategoryTheory.Limits.HasColimit F := hHasColim_gen d
  let Y_tilde : AlgebraicGeometry.Scheme.{u} := d.glued
  let ν : Y_tilde ⟶ Y := d.toBase
  let ι₀ : X₀ ⟶ Y_tilde :=
    CategoryTheory.Limits.colimit.ι d.functor CategoryTheory.Limits.WalkingSpan.left
  let ι₁ : X₁ ⟶ Y_tilde :=
    CategoryTheory.Limits.colimit.ι d.functor CategoryTheory.Limits.WalkingSpan.right
  have hPb_raw₀ : CategoryTheory.IsPullback π₀ ι₀ U_0.ι ν :=
    d.isPullback_natTrans_ι_toBase CategoryTheory.Limits.WalkingSpan.left
  have hPb_raw₁ : CategoryTheory.IsPullback π₁ ι₁ U_1.ι ν :=
    d.isPullback_natTrans_ι_toBase CategoryTheory.Limits.WalkingSpan.right
  have hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι₀ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_raw₀ inferInstance
  have hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_raw₁ inferInstance
  exact ⟨Y_tilde, ν, ι₀, ι₁, hOpen₀, hOpen₁, hPb_raw₀.flip, hPb_raw₁.flip⟩

theorem weil_bezout_kummer_section_smooth_and_reduced_lift (ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (B R : Type u) [CommRing B] [IsNoetherianRing B] [CommRing R] [IsDomain R] [Algebra B R]
    (hℓ_unit : IsUnit (ℓ : B))
    [AlgebraicGeometry.SmoothOfRelativeDimension 1
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B R)))]
    (π_sec : R →ₐ[B] B)
    (t : R) (ht_ne : t ≠ 0)
    (hker : RingHom.ker π_sec.toRingHom = Ideal.span {t})
    (u : Units R) :
    let S := Polynomial R ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C ((u : R) * t)}
    let ι_R : R →+* S := (Ideal.Quotient.mk _).comp Polynomial.C
    let f := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B R))
    let p_S := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)
    let τ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_sec.toRingHom)
    AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.CategoryStruct.comp p_S f) ∧
    ∃ τ_tilde : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B))
        (AlgebraicGeometry.Spec (CommRingCat.of S)),
      CategoryTheory.CategoryStruct.comp τ_tilde p_S = τ ∧
      AlgebraicGeometry.IsClosedImmersion τ_tilde ∧
      p_S.base ⁻¹' Set.range τ.base = Set.range τ_tilde.base :=
by
  classical
  
  have draft_s2a : ∀ (R₁ R_s : Type u) [CommRing R₁] [CommRing R_s] [Algebra R₁ R_s]
      (a s : R₁) [IsLocalization.Away s R_s]
      (a' : R_s), a' = algebraMap R₁ R_s a →
      let S₁ := Polynomial R₁ ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C a}
      let ι_R₁ : R₁ →+* S₁ := (Ideal.Quotient.mk _).comp Polynomial.C
      let S_s := Polynomial R_s ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C a'}
      let ι_Rs : R_s →+* S_s := (Ideal.Quotient.mk _).comp Polynomial.C
      ∃ φ_s : S₁ →+* S_s,
        φ_s.comp ι_R₁ = ι_Rs.comp (algebraMap R₁ R_s) ∧
        φ_s (Ideal.Quotient.mk _ Polynomial.X) = Ideal.Quotient.mk _ Polynomial.X ∧
        (letI : Algebra S₁ S_s := φ_s.toAlgebra; IsLocalization.Away (ι_R₁ s) S_s) := by
    intro R₁ R_s _ _ _ a s _ a' ha' S₁ ι_R₁ S_s ι_Rs
    let I : Ideal (Polynomial R₁) := Ideal.span {Polynomial.X ^ ℓ - Polynomial.C a}
    let I_s : Ideal (Polynomial R_s) := Ideal.span {Polynomial.X ^ ℓ - Polynomial.C a'}
    let g : R₁ →+* R_s := algebraMap R₁ R_s
    let M : Polynomial R₁ →+* S_s := (Ideal.Quotient.mk I_s).comp (Polynomial.mapRingHom g)
    have hI_M : ∀ p ∈ I, M p = 0 := by
      intro p hp
      rw [Ideal.mem_span_singleton] at hp
      obtain ⟨q, rfl⟩ := hp
      have hgen : M (Polynomial.X ^ ℓ - Polynomial.C a) = 0 := by
        change Ideal.Quotient.mk I_s ((Polynomial.X ^ ℓ - Polynomial.C a).map g) = 0
        simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
        have ha'_eq : g a = a' := ha'.symm
        rw [ha'_eq]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      rw [map_mul, hgen, zero_mul]
    let φ_s : S₁ →+* S_s := Ideal.Quotient.lift I M hI_M
    have hcomp : φ_s.comp ι_R₁ = ι_Rs.comp g := by
      apply RingHom.ext
      intro r
      change Ideal.Quotient.lift I M hI_M (Ideal.Quotient.mk I (Polynomial.C r)) =
        Ideal.Quotient.mk I_s (Polynomial.C (g r))
      rw [Ideal.Quotient.lift_mk]
      simp [M]
    have hX : φ_s (Ideal.Quotient.mk I Polynomial.X) = Ideal.Quotient.mk I_s Polynomial.X := by
      change Ideal.Quotient.lift I M hI_M (Ideal.Quotient.mk I Polynomial.X) = _
      rw [Ideal.Quotient.lift_mk]
      simp [M]
    refine ⟨φ_s, hcomp, hX, ?_⟩
    let _algS : Algebra S₁ S_s := φ_s.toAlgebra
    have h_clear : ∀ P_s : Polynomial R_s,
        ∃ (k : ℕ) (P₀ : Polynomial R₁), P_s * Polynomial.C (g s ^ k) = P₀.map g := by
      intro P_s
      refine Polynomial.induction_on' P_s ?_ ?_
      · intro p₁ p₂ ⟨k₁, Q₁, hQ₁⟩ ⟨k₂, Q₂, hQ₂⟩
        refine ⟨k₁ + k₂, Q₁ * Polynomial.C (s ^ k₂) + Q₂ * Polynomial.C (s ^ k₁), ?_⟩
        have hc1 : Polynomial.C (g s ^ k₂) = (Polynomial.C (s ^ k₂)).map g := by simp
        have hc2 : Polynomial.C (g s ^ k₁) = (Polynomial.C (s ^ k₁)).map g := by simp
        calc
          (p₁ + p₂) * Polynomial.C (g s ^ (k₁ + k₂))
            = (p₁ * Polynomial.C (g s ^ k₁)) * Polynomial.C (g s ^ k₂) +
                (p₂ * Polynomial.C (g s ^ k₂)) * Polynomial.C (g s ^ k₁) := by
                rw [pow_add, Polynomial.C_mul]
                ring
          _ = Q₁.map g * (Polynomial.C (s ^ k₂)).map g +
                Q₂.map g * (Polynomial.C (s ^ k₁)).map g := by
                rw [hQ₁, hQ₂, hc1, hc2]
          _ = (Q₁ * Polynomial.C (s ^ k₂) + Q₂ * Polynomial.C (s ^ k₁)).map g := by
                simp [Polynomial.map_add, Polynomial.map_mul]
      · intro n c
        obtain ⟨⟨r, _, k, rfl⟩, hc⟩ := IsLocalization.surj (Submonoid.powers s) c
        refine ⟨k, Polynomial.monomial n r, ?_⟩
        rw [← Polynomial.monomial_zero_left, Polynomial.monomial_mul_monomial, add_zero,
          Polynomial.map_monomial]
        congr 1
        simpa [map_pow] using hc
    refine
      { map_units := ?_
        surj := ?_
        exists_of_eq := ?_ }
    · rintro ⟨_, n, rfl⟩
      change IsUnit (φ_s ((ι_R₁ s) ^ n))
      rw [map_pow]
      have hs_eq : φ_s (ι_R₁ s) = ι_Rs (g s) := by
        change (φ_s.comp ι_R₁) s = _
        rw [hcomp]
        rfl
      rw [hs_eq]
      exact ((IsLocalization.Away.algebraMap_isUnit s).map ι_Rs).pow n
    · intro z
      obtain ⟨P_s, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨k, P₀, hP₀⟩ := h_clear P_s
      refine ⟨⟨Ideal.Quotient.mk I P₀, ⟨(ι_R₁ s) ^ k, k, rfl⟩⟩, ?_⟩
      change Ideal.Quotient.mk I_s P_s * φ_s ((ι_R₁ s) ^ k) = φ_s (Ideal.Quotient.mk I P₀)
      have hs_k : φ_s ((ι_R₁ s) ^ k) = Ideal.Quotient.mk I_s (Polynomial.C (g s ^ k)) := by
        rw [map_pow]
        have hs1 : φ_s (ι_R₁ s) = Ideal.Quotient.mk I_s (Polynomial.C (g s)) := by
          change (φ_s.comp ι_R₁) s = _
          rw [hcomp]
          rfl
        rw [hs1, ← map_pow, ← Polynomial.C_pow]
      rw [hs_k, ← map_mul, hP₀]
      rfl
    · intro x₁ x₂ hx
      obtain ⟨P₁, rfl⟩ := Ideal.Quotient.mk_surjective x₁
      obtain ⟨P₂, rfl⟩ := Ideal.Quotient.mk_surjective x₂
      let P : Polynomial R₁ := P₁ - P₂
      have hP_zero : Ideal.Quotient.mk I_s (P.map g) = 0 := by
        change φ_s (Ideal.Quotient.mk I P₁ - Ideal.Quotient.mk I P₂) = 0
        rw [map_sub, sub_eq_zero]
        exact hx
      have hP_mem : P.map g ∈ I_s := Ideal.Quotient.eq_zero_iff_mem.mp hP_zero
      rw [Ideal.mem_span_singleton] at hP_mem
      obtain ⟨Q_s, hQ_s⟩ := hP_mem
      obtain ⟨k₁, Q₀, hQ₀⟩ := h_clear Q_s
      let f₀ : Polynomial R₁ := Polynomial.X ^ ℓ - Polynomial.C a
      have hf₀_map : f₀.map g = Polynomial.X ^ ℓ - Polynomial.C a' := by
        simp [f₀, g, ha']
      let D_poly : Polynomial R₁ := P * Polynomial.C (s ^ k₁) - f₀ * Q₀
      have hD_map : D_poly.map g = 0 := by
        have hc_k1 : (Polynomial.C (s ^ k₁)).map g = Polynomial.C (g s ^ k₁) := by simp
        simp only [D_poly, Polynomial.map_sub, Polynomial.map_mul, hQ_s, hf₀_map, hc_k1,
          mul_assoc, hQ₀, sub_self]
      have hD_coeff : ∀ n : ℕ, ∃ k : ℕ, s ^ k * D_poly.coeff n = 0 := by
        intro n
        have hc0 : g (D_poly.coeff n) = 0 := by
          rw [← Polynomial.coeff_map, hD_map, Polynomial.coeff_zero]
        obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers s) R_s (D_poly.coeff n)).mp hc0
        exact ⟨k, hk⟩
      choose k_fn hk_fn using hD_coeff
      let k₂ : ℕ := D_poly.support.sup k_fn
      have hD_kill : Polynomial.C (s ^ k₂) * D_poly = 0 := by
        ext n
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_zero]
        by_cases hn : n ∈ D_poly.support
        · have hle : k_fn n ≤ k₂ := Finset.le_sup hn
          have hexp : k₂ = (k₂ - k_fn n) + k_fn n := (Nat.sub_add_cancel hle).symm
          rw [hexp, pow_add, mul_assoc, hk_fn n, mul_zero]
        · rw [Polynomial.notMem_support_iff.mp hn, mul_zero]
      have hP_dvd : Polynomial.C (s ^ (k₁ + k₂)) * P = f₀ * (Polynomial.C (s ^ k₂) * Q₀) := by
        have hsub0 : Polynomial.C (s ^ k₂) * (P * Polynomial.C (s ^ k₁)) =
            Polynomial.C (s ^ k₂) * (f₀ * Q₀) :=
          sub_eq_zero.mp (by rw [← mul_sub]; exact hD_kill)
        calc
          Polynomial.C (s ^ (k₁ + k₂)) * P
            = Polynomial.C (s ^ k₂) * (P * Polynomial.C (s ^ k₁)) := by
                rw [pow_add, Polynomial.C_mul]; ring
          _ = Polynomial.C (s ^ k₂) * (f₀ * Q₀) := hsub0
          _ = f₀ * (Polynomial.C (s ^ k₂) * Q₀) := by ring
      refine ⟨⟨(ι_R₁ s) ^ (k₁ + k₂), k₁ + k₂, rfl⟩, ?_⟩
      apply sub_eq_zero.mp
      rw [← mul_sub]
      have hmul_eq :
          (⟨(ι_R₁ s) ^ (k₁ + k₂), k₁ + k₂, rfl⟩ : Submonoid.powers (ι_R₁ s)).1 *
            (Ideal.Quotient.mk I P₁ - Ideal.Quotient.mk I P₂) =
          Ideal.Quotient.mk I (Polynomial.C (s ^ (k₁ + k₂)) * P) := by
        change (Ideal.Quotient.mk I (Polynomial.C s)) ^ (k₁ + k₂) *
          (Ideal.Quotient.mk I P₁ - Ideal.Quotient.mk I P₂) = _
        rw [← map_pow, ← Polynomial.C_pow, ← map_sub, ← map_mul]
      rw [hmul_eq, hP_dvd]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_span_singleton.mpr ⟨Polynomial.C (s ^ k₂) * Q₀, rfl⟩)
  
  have draft_s2b : ∀ (R₀ : Type u) [CommRing R₀], IsUnit (ℓ : R₀) → ∀ (u₀ : Units R₀),
      let Q₀ := Polynomial R₀ ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)}
      letI : Algebra R₀ Q₀ := ((Ideal.Quotient.mk _).comp Polynomial.C).toAlgebra
      Algebra.IsStandardSmoothOfRelativeDimension 0 R₀ Q₀ := by
    intro R₀ _ hℓ_u u₀ Q₀
    let _algQ₀ : Algebra R₀ Q₀ := ((Ideal.Quotient.mk _).comp Polynomial.C).toAlgebra
    let e_mv : MvPolynomial Unit R₀ ≃ₐ[R₀] Polynomial R₀ := MvPolynomial.uniqueAlgEquiv R₀ Unit
    let v₀ : Unit → MvPolynomial Unit R₀ :=
      fun _ => MvPolynomial.X () ^ ℓ - MvPolynomial.C (u₀ : R₀)
    let I_mv : Ideal (MvPolynomial Unit R₀) := Ideal.span (Set.range v₀)
    let I_p : Ideal (Polynomial R₀) := Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)}
    have h_map_v₀ : e_mv (v₀ ()) = Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀) := by
      simp [e_mv, v₀]
    let f_fwd_p : MvPolynomial Unit R₀ →+* Q₀ :=
      (Ideal.Quotient.mk I_p).comp e_mv.toRingEquiv.toRingHom
    have hker_fwd : ∀ x ∈ I_mv, f_fwd_p x = 0 := by
      have hle : I_mv ≤ RingHom.ker f_fwd_p := by
        rw [Ideal.span_le]
        rintro _ ⟨⟨⟩, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        change Ideal.Quotient.mk I_p (e_mv (v₀ ())) = 0
        rw [h_map_v₀]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      exact fun x hx => hle hx
    let f_Q₀ : (MvPolynomial Unit R₀ ⧸ I_mv) →+* Q₀ :=
      Ideal.Quotient.lift I_mv f_fwd_p hker_fwd
    let g_bwd_p : Polynomial R₀ →+* (MvPolynomial Unit R₀ ⧸ I_mv) :=
      (Ideal.Quotient.mk I_mv).comp e_mv.symm.toRingEquiv.toRingHom
    have hker_bwd : ∀ x ∈ I_p, g_bwd_p x = 0 := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      obtain ⟨q, rfl⟩ := hx
      have hgen : g_bwd_p (Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)) = 0 := by
        rw [← h_map_v₀]
        change Ideal.Quotient.mk I_mv (e_mv.symm (e_mv (v₀ ()))) = 0
        rw [e_mv.symm_apply_apply]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨(), rfl⟩)
      rw [map_mul, hgen, zero_mul]
    let g_Q₀ : Q₀ →+* (MvPolynomial Unit R₀ ⧸ I_mv) :=
      Ideal.Quotient.lift I_p g_bwd_p hker_bwd
    have h_left : Function.LeftInverse g_Q₀ f_Q₀ := by
      intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      change Ideal.Quotient.lift I_p g_bwd_p hker_bwd
        (Ideal.Quotient.lift I_mv f_fwd_p hker_fwd (Ideal.Quotient.mk I_mv p)) =
        Ideal.Quotient.mk I_mv p
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.lift I_p g_bwd_p hker_bwd (Ideal.Quotient.mk I_p (e_mv p)) = _
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.mk I_mv (e_mv.symm (e_mv p)) = _
      rw [e_mv.symm_apply_apply]
    have h_right : Function.RightInverse g_Q₀ f_Q₀ := by
      intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      change Ideal.Quotient.lift I_mv f_fwd_p hker_fwd
        (Ideal.Quotient.lift I_p g_bwd_p hker_bwd (Ideal.Quotient.mk I_p p)) =
        Ideal.Quotient.mk I_p p
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.lift I_mv f_fwd_p hker_fwd (Ideal.Quotient.mk I_mv (e_mv.symm p)) = _
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.mk I_p (e_mv (e_mv.symm p)) = _
      rw [e_mv.apply_symm_apply]
    let e_Q₀_ring : (MvPolynomial Unit R₀ ⧸ I_mv) ≃+* Q₀ :=
      { f_Q₀ with
        invFun := g_Q₀
        left_inv := h_left
        right_inv := h_right }
    let e_Q₀ : (MvPolynomial Unit R₀ ⧸ I_mv) ≃ₐ[R₀] Q₀ :=
      AlgEquiv.ofRingEquiv (f := e_Q₀_ring) (fun r => by
        change Ideal.Quotient.lift I_mv f_fwd_p hker_fwd (Ideal.Quotient.mk I_mv (MvPolynomial.C r)) =
          Ideal.Quotient.mk I_p (Polynomial.C r)
        rw [Ideal.Quotient.lift_mk]
        change Ideal.Quotient.mk I_p (e_mv (MvPolynomial.C r)) = _
        simp [e_mv])
    let P_naive := Algebra.PreSubmersivePresentation.naive (R := R₀) (v := v₀)
      (id : Unit → Unit) Function.injective_id
    let P₀ : Algebra.PreSubmersivePresentation R₀ Q₀ Unit Unit := P_naive.ofAlgEquiv e_Q₀
    have hdim : P₀.dimension = 0 :=
      (Algebra.Presentation.dimension_ofAlgEquiv P_naive.toPresentation e_Q₀).trans
        (by simp [Algebra.Presentation.dimension])
    have hpderiv_pow : ∀ n : ℕ,
        (MvPolynomial.pderiv ()) ((MvPolynomial.X () : MvPolynomial Unit R₀) ^ n) =
          (n : MvPolynomial Unit R₀) * (MvPolynomial.X ()) ^ (n - 1) := by
      intro n
      induction n with
      | zero => simp
      | succ k ih =>
        cases k with
        | zero => simp
        | succ m =>
          rw [pow_succ, Derivation.leibniz, ih]
          simp only [MvPolynomial.pderiv_X, Pi.single_eq_same, smul_eq_mul, Nat.add_sub_cancel,
            Nat.cast_add, Nat.cast_one]
          have hpow : (MvPolynomial.X () : MvPolynomial Unit R₀) ^ (m + 1) =
              (MvPolynomial.X ()) ^ m * MvPolynomial.X () := pow_succ _ m
          rw [hpow]
          ring
    let w : Q₀ := Ideal.Quotient.mk I_p Polynomial.X
    have hw_val : algebraMap P₀.Ring Q₀ (MvPolynomial.X ()) = w := by
      rw [Algebra.Generators.algebraMap_apply, MvPolynomial.aeval_X]
      change e_Q₀ (Ideal.Quotient.mk I_mv (MvPolynomial.X ())) = w
      change Ideal.Quotient.lift I_mv f_fwd_p hker_fwd (Ideal.Quotient.mk I_mv (MvPolynomial.X ())) = w
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.mk I_p (e_mv (MvPolynomial.X ())) = w
      simp [e_mv, w]
    have hjac : P₀.jacobian = (ℓ : Q₀) * w ^ (ℓ - 1) := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, Matrix.det_unique,
        Algebra.PreSubmersivePresentation.jacobiMatrix_ofAlgEquiv,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      change algebraMap P₀.Ring Q₀ ((MvPolynomial.pderiv ()) (v₀ ())) = _
      dsimp [v₀]
      rw [map_sub, hpderiv_pow ℓ, MvPolynomial.pderiv_C, sub_zero, map_mul, map_natCast,
        map_pow, hw_val]
    have hjac_unit : IsUnit P₀.jacobian := by
      rw [hjac, isUnit_iff_exists_inv]
      let v_ℓ : R₀ := ↑(hℓ_u.unit⁻¹)
      let v_u : R₀ := ↑(u₀⁻¹)
      have hv_ℓ : (ℓ : R₀) * v_ℓ = 1 := by
        change (hℓ_u.unit : R₀) * ↑(hℓ_u.unit⁻¹) = 1
        exact Units.mul_inv hℓ_u.unit
      have hv_u : (u₀ : R₀) * v_u = 1 := Units.mul_inv u₀
      have hw_pow : w ^ ℓ = algebraMap R₀ Q₀ (u₀ : R₀) := by
        apply sub_eq_zero.mp
        change Ideal.Quotient.mk I_p (Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      have hw_split : w ^ (ℓ - 1) * w = w ^ ℓ := by
        rw [← pow_succ, Nat.sub_add_cancel hℓ_pos]
      refine ⟨algebraMap R₀ Q₀ (v_ℓ * v_u) * w, ?_⟩
      calc
        ((ℓ : Q₀) * w ^ (ℓ - 1)) * (algebraMap R₀ Q₀ (v_ℓ * v_u) * w)
          = (algebraMap R₀ Q₀ (ℓ : R₀) * algebraMap R₀ Q₀ v_ℓ) *
              ((w ^ (ℓ - 1) * w) * algebraMap R₀ Q₀ v_u) := by
              rw [map_natCast, map_mul]
              ring
        _ = algebraMap R₀ Q₀ ((ℓ : R₀) * v_ℓ) * algebraMap R₀ Q₀ ((u₀ : R₀) * v_u) := by
              rw [← map_mul, hw_split, hw_pow, ← map_mul]
        _ = 1 := by rw [hv_ℓ, hv_u, map_one, mul_one]
    let S₀ : Algebra.SubmersivePresentation R₀ Q₀ Unit Unit := ⟨P₀, hjac_unit⟩
    exact S₀.isStandardSmoothOfRelativeDimension hdim
  
  have draft_s2b_comp : ∀ (B₁ R₀ : Type u) [CommRing B₁] [CommRing R₀] [Algebra B₁ R₀]
      [Algebra.IsStandardSmoothOfRelativeDimension 1 B₁ R₀],
      IsUnit (ℓ : R₀) → ∀ (u₀ : Units R₀),
      ∃ φ : B₁ →+* Polynomial R₀ ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)},
        (∀ b : B₁, φ b = Ideal.Quotient.mk _ (Polynomial.C (algebraMap B₁ R₀ b))) ∧
        RingHom.IsStandardSmoothOfRelativeDimension 1 φ := by
    intro B₁ R₀ _ _ _ _ hℓ_u u₀
    let Q₀ := Polynomial R₀ ⧸ Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)}
    let ι₀ : R₀ →+* Q₀ := (Ideal.Quotient.mk _).comp Polynomial.C
    let alg_R₀_Q₀ : Algebra R₀ Q₀ := ι₀.toAlgebra
    have hSm0 : @Algebra.IsStandardSmoothOfRelativeDimension 0 R₀ Q₀ _ _ alg_R₀_Q₀ :=
      draft_s2b R₀ hℓ_u u₀
    let φ : B₁ →+* Q₀ := ι₀.comp (algebraMap B₁ R₀)
    let alg_B_Q₀ : Algebra B₁ Q₀ := φ.toAlgebra
    have h_tower : @IsScalarTower B₁ R₀ Q₀ Algebra.toSMul alg_R₀_Q₀.toSMul alg_B_Q₀.toSMul :=
      @IsScalarTower.of_algebraMap_eq' B₁ R₀ Q₀ _ _ _ _ alg_R₀_Q₀ alg_B_Q₀ rfl
    have hSm1 : @Algebra.IsStandardSmoothOfRelativeDimension 1 B₁ Q₀ _ _ alg_B_Q₀ := by
      have h01 := @Algebra.IsStandardSmoothOfRelativeDimension.trans 1 0 B₁ R₀ _ _ _
        Q₀ _ alg_B_Q₀ alg_R₀_Q₀ h_tower inferInstance hSm0
      simpa using h01
    exact ⟨φ, fun _ => rfl,
      (@RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1 B₁ Q₀ _ _ alg_B_Q₀).mpr hSm1⟩
  
  have draft_s3 : ∀ (B₀ C' : Type u) [CommRing B₀] [CommRing C'] [IsDomain C'] [Algebra B₀ C']
      (π_x : C' →ₐ[B₀] B₀) (t' : C'), t' ≠ 0 →
      RingHom.ker π_x.toRingHom = Ideal.span {t'} →
      ∀ (p' : Ideal C') [p'.IsPrime], t' ∈ p' →
      ∀ (ψ₀ : Polynomial B₀ →ₐ[B₀] C'), RingHom.Etale ψ₀.toRingHom →
      ∃ (r₀ : C') (ψ_loc : Polynomial B₀ →ₐ[B₀] Localization.Away r₀)
        (ω_x : Units (Localization.Away r₀)),
        r₀ ∉ p' ∧
        RingHom.Etale ψ_loc.toRingHom ∧
        algebraMap C' (Localization.Away r₀) t' =
          (ω_x : Localization.Away r₀) * ψ_loc Polynomial.X := by
    intro B₀ C' _ _ _ _ π_x t' ht'_ne hker_x p' _ ht'_mem ψ₀ hEt₀
    let b_T : B₀ := π_x (ψ₀ Polynomial.X)
    let shift_fwd : Polynomial B₀ →ₐ[B₀] Polynomial B₀ :=
      Polynomial.aeval (Polynomial.X - Polynomial.C b_T)
    let shift_bwd : Polynomial B₀ →ₐ[B₀] Polynomial B₀ :=
      Polynomial.aeval (Polynomial.X + Polynomial.C b_T)
    have hsh_fb : shift_fwd.comp shift_bwd = AlgHom.id B₀ (Polynomial B₀) := by
      apply Polynomial.algHom_ext
      simp [shift_fwd, shift_bwd]
    have hsh_bf : shift_bwd.comp shift_fwd = AlgHom.id B₀ (Polynomial B₀) := by
      apply Polynomial.algHom_ext
      simp [shift_fwd, shift_bwd]
    let τ_poly : Polynomial B₀ ≃ₐ[B₀] Polynomial B₀ :=
      AlgEquiv.ofAlgHom shift_fwd shift_bwd hsh_fb hsh_bf
    let ψ_x : Polynomial B₀ →ₐ[B₀] C' := ψ₀.comp τ_poly.toAlgHom
    have hEt_ψx : RingHom.Etale ψ_x.toRingHom := by
      change RingHom.Etale (ψ₀.toRingHom.comp τ_poly.toRingEquiv.toRingHom)
      exact RingHom.Etale.respectsIso.right ψ₀.toRingHom τ_poly.toRingEquiv hEt₀
    let z_x : C' := ψ_x Polynomial.X
    have hz_ker : π_x z_x = 0 := by
      have hz_val : z_x = ψ₀ Polynomial.X - algebraMap B₀ C' b_T := by
        change ψ₀ (shift_fwd Polynomial.X) = _
        rw [Polynomial.aeval_X, map_sub, ← Polynomial.algebraMap_eq, ψ₀.commutes]
      rw [hz_val, map_sub, π_x.commutes]
      exact sub_self b_T
    have hz_mem : z_x ∈ Ideal.span {t'} := by
      rw [← hker_x]
      exact hz_ker
    rw [Ideal.mem_span_singleton] at hz_mem
    obtain ⟨ω'_x, hz_eq⟩ := hz_mem
    let I_z : Ideal C' := Ideal.span {z_x}
    let A'_x := C' ⧸ I_z
    let mk_z : C' →ₐ[B₀] A'_x := Ideal.Quotient.mkₐ B₀ I_z
    have hEt_A' : Algebra.Etale B₀ A'_x := by
      let alg_ZC : Algebra (Polynomial B₀) C' := ψ_x.toRingHom.toAlgebra
      have : Algebra.Etale (Polynomial B₀) C' :=
        (RingHom.etale_algebraMap (R := Polynomial B₀) (S := C')).mp hEt_ψx
      let ev_B₀ : Polynomial B₀ →ₐ[B₀] B₀ := Polynomial.aeval (0 : B₀)
      let alg_ZB₀ : Algebra (Polynomial B₀) B₀ := ev_B₀.toRingHom.toAlgebra
      have : Algebra.Etale B₀ (TensorProduct (Polynomial B₀) B₀ C') :=
        Algebra.Etale.baseChange (Polynomial B₀) C' B₀
      let alg_ZA' : Algebra (Polynomial B₀) A'_x :=
        (mk_z.toRingHom.comp ψ_x.toRingHom).toAlgebra
      let iL : B₀ →ₐ[Polynomial B₀] A'_x :=
        { toRingHom := algebraMap B₀ A'_x
          commutes' := fun P => by
            have heq_hom : (algebraMap B₀ A'_x).comp ev_B₀.toRingHom =
                mk_z.toRingHom.comp ψ_x.toRingHom := by
              apply Polynomial.ringHom_ext'
              · ext b
                change algebraMap B₀ A'_x (ev_B₀ (Polynomial.C b)) = mk_z (ψ_x (Polynomial.C b))
                rw [← Polynomial.algebraMap_eq, ev_B₀.commutes b, ψ_x.commutes b, mk_z.commutes b]
                rfl
              · change algebraMap B₀ A'_x (ev_B₀ Polynomial.X) = mk_z (ψ_x Polynomial.X)
                have h0 : mk_z z_x = 0 :=
                  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self z_x)
                simpa [ev_B₀, z_x] using h0.symm
            exact RingHom.congr_fun heq_hom P }
      let iR : C' →ₐ[Polynomial B₀] A'_x :=
        { toRingHom := mk_z.toRingHom
          commutes' := fun _ => rfl }
      let fwd_Z : TensorProduct (Polynomial B₀) B₀ C' →ₐ[Polynomial B₀] A'_x :=
        Algebra.TensorProduct.productMap iL iR
      let incR_hom : C' →+* TensorProduct (Polynomial B₀) B₀ C' :=
        Algebra.TensorProduct.includeRight.toRingHom
      have h_incR_z : ∀ x ∈ I_z, incR_hom x = 0 := by
        intro x hx
        rw [Ideal.mem_span_singleton] at hx
        obtain ⟨c, rfl⟩ := hx
        have hz0 : incR_hom z_x = 0 := by
          change (1 : B₀) ⊗ₜ[Polynomial B₀] (ψ_x Polynomial.X) = 0
          have hsmul : ψ_x Polynomial.X = (Polynomial.X : Polynomial B₀) • (1 : C') := by
            change ψ_x Polynomial.X = ψ_x Polynomial.X * 1
            rw [mul_one]
          rw [hsmul, ← TensorProduct.smul_tmul]
          have hsmul_B : (Polynomial.X : Polynomial B₀) • (1 : B₀) = 0 := by
            change ev_B₀ Polynomial.X * 1 = 0
            simp [ev_B₀]
          rw [hsmul_B, TensorProduct.zero_tmul]
        rw [map_mul, hz0, zero_mul]
      let bwd_ring : A'_x →+* TensorProduct (Polynomial B₀) B₀ C' :=
        Ideal.Quotient.lift I_z incR_hom h_incR_z
      have h_right : Function.RightInverse bwd_ring fwd_Z.toRingHom := by
        intro x
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
        change fwd_Z (Ideal.Quotient.lift I_z incR_hom h_incR_z (Ideal.Quotient.mk I_z c)) = mk_z c
        rw [Ideal.Quotient.lift_mk]
        change fwd_Z ((1 : B₀) ⊗ₜ[Polynomial B₀] c) = mk_z c
        simp [fwd_Z, iL, iR]
      have h_left : Function.LeftInverse bwd_ring fwd_Z.toRingHom := by
        intro t_el
        refine TensorProduct.inductionOn
          (motive := fun z => bwd_ring (fwd_Z.toRingHom z) = z) t_el ?_ ?_
        · intro b c
          change bwd_ring (fwd_Z (b ⊗ₜ[Polynomial B₀] c)) = b ⊗ₜ[Polynomial B₀] c
          have hfwd_bc : fwd_Z (b ⊗ₜ[Polynomial B₀] c) = mk_z (algebraMap B₀ C' b * c) := by
            simp only [fwd_Z, Algebra.TensorProduct.productMap_apply_tmul, iL, iR, AlgHom.coe_mk]
            change algebraMap B₀ A'_x b * mk_z c = mk_z (algebraMap B₀ C' b * c)
            rw [← mk_z.commutes b, map_mul]
          rw [hfwd_bc]
          change Ideal.Quotient.lift I_z incR_hom h_incR_z
            (Ideal.Quotient.mk I_z (algebraMap B₀ C' b * c)) = _
          rw [Ideal.Quotient.lift_mk]
          change (1 : B₀) ⊗ₜ[Polynomial B₀] (algebraMap B₀ C' b * c) = b ⊗ₜ[Polynomial B₀] c
          have hbc : algebraMap B₀ C' b * c = (Polynomial.C b : Polynomial B₀) • c := by
            change algebraMap B₀ C' b * c = ψ_x (Polynomial.C b) * c
            rw [← Polynomial.algebraMap_eq, ψ_x.commutes b]
          rw [hbc, ← TensorProduct.smul_tmul]
          have hb1 : (Polynomial.C b : Polynomial B₀) • (1 : B₀) = b := by
            change ev_B₀ (Polynomial.C b) * 1 = b
            simp [ev_B₀]
          rw [hb1]
        · intro x₁ x₂ h1 h2
          rw [map_add, map_add, h1, h2]
      let e_ring : TensorProduct (Polynomial B₀) B₀ C' ≃+* A'_x :=
        { fwd_Z.toRingHom with
          invFun := bwd_ring
          left_inv := h_left
          right_inv := h_right }
      let e_quot : TensorProduct (Polynomial B₀) B₀ C' ≃ₐ[B₀] A'_x :=
        AlgEquiv.ofRingEquiv (f := e_ring) (fun b => by
          change fwd_Z (algebraMap B₀ (TensorProduct (Polynomial B₀) B₀ C') b) =
            algebraMap B₀ A'_x b
          change fwd_Z (b ⊗ₜ[Polynomial B₀] 1) = algebraMap B₀ A'_x b
          simp [fwd_Z, iL, iR])
      exact Algebra.Etale.of_equiv e_quot
    have : Algebra.Etale B₀ A'_x := hEt_A'
    have : Algebra.FormallyUnramified B₀ A'_x := inferInstance
    have hker_πz : ∀ x ∈ I_z, π_x x = 0 := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      obtain ⟨c, rfl⟩ := hx
      rw [map_mul, hz_ker, zero_mul]
    let q_x : A'_x →ₐ[B₀] B₀ := Ideal.Quotient.liftₐ I_z π_x hker_πz
    let J_x : Ideal A'_x := RingHom.ker q_x.toRingHom
    let a₀ : A'_x := mk_z t'
    have hJx_span : J_x = Ideal.span {a₀} := by
      apply le_antisymm
      · intro x hx
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hc : c ∈ RingHom.ker π_x.toRingHom := hx
        rw [hker_x, Ideal.mem_span_singleton] at hc
        obtain ⟨r, rfl⟩ := hc
        exact Ideal.mem_span_singleton.mpr ⟨mk_z r, map_mul mk_z t' r⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
