  let mkEt : ∀ (A : Type u) [CommRing A]
      (h_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y'),
      AlgebraicGeometry.Etale h_A → Y'.Etale :=
    fun A _ h_A hEt => CategoryTheory.MorphismProperty.Over.mk ⊤ h_A hEt
  let homEt : ∀ {A B : Type u} [CommRing A] [CommRing B]
      {h_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y'} {hEt_A : AlgebraicGeometry.Etale h_A}
      {h_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Y'} {hEt_B : AlgebraicGeometry.Etale h_B}
      (f : A →+* B),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) ≫ h_A = h_B →
      (mkEt B h_B hEt_B ⟶ mkEt A h_A hEt_A) :=
    fun f hfac => CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) hfac
  let pushI : ∀ {W₁ W₂ : Y'.Etale},
      (W₁ ⟶ W₂) → (↥(I.obj.obj (Opposite.op W₂)) →+ ↥(I.obj.obj (Opposite.op W₁))) :=
    fun g => (I.obj.map g.op).hom
  have hpushI_comp : ∀ {W₁ W₂ W₃ : Y'.Etale} (g₁ : W₁ ⟶ W₂) (g₂ : W₂ ⟶ W₃)
      (x : ↥(I.obj.obj (Opposite.op W₃))),
      pushI (g₁ ≫ g₂) x = pushI g₁ (pushI g₂ x) := by
    intro W₁ W₂ W₃ g₁ g₂ x
    change (I.obj.map (g₁ ≫ g₂).op).hom x = (I.obj.map g₁.op).hom ((I.obj.map g₂.op).hom x)
    rw [op_comp, I.obj.map_comp]
    rfl
  have hpushI_homEt_comp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      {h_A : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Y'} {hEt_A : AlgebraicGeometry.Etale h_A}
      {h_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Y'} {hEt_B : AlgebraicGeometry.Etale h_B}
      {h_C : AlgebraicGeometry.Spec (CommRingCat.of C) ⟶ Y'} {hEt_C : AlgebraicGeometry.Etale h_C}
      (f : A →+* B) (g : B →+* C)
      (hf : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) ≫ h_A = h_B)
      (hg : AlgebraicGeometry.Spec.map (CommRingCat.ofHom g) ≫ h_B = h_C)
      (hgf : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (g.comp f)) ≫ h_A = h_C)
      (x : ↥(I.obj.obj (Opposite.op (mkEt A h_A hEt_A)))),
      pushI (homEt (hEt_A := hEt_A) (hEt_B := hEt_C) (g.comp f) hgf) x =
        pushI (homEt (hEt_A := hEt_B) (hEt_B := hEt_C) g hg)
          (pushI (homEt (hEt_A := hEt_A) (hEt_B := hEt_B) f hf) x) := by
    intro A B C _ _ _ h_A hEt_A h_B hEt_B h_C hEt_C f g hf hg hgf x
    have hEq_mor : homEt (hEt_A := hEt_A) (hEt_B := hEt_C) (g.comp f) hgf =
        homEt (hEt_A := hEt_B) (hEt_B := hEt_C) g hg ≫
          homEt (hEt_A := hEt_A) (hEt_B := hEt_B) f hf := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (g.comp f)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom g) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)
      rw [← AlgebraicGeometry.Spec.map_comp]
      rfl
    rw [hEq_mor, hpushI_comp]

  let ι_sec : ∀ W : Y'.Etale,
      ↥((weilEtaleGmPresheaf Y').obj (Opposite.op W)) →+ ↥(I.obj.obj (Opposite.op W)) :=
    fun W => (u_sh.app (Opposite.op W) ≫ ι_inj.hom.app (Opposite.op W)).hom
  have hι_sec_nat : ∀ {W₁ W₂ : Y'.Etale} (g : W₁ ⟶ W₂)
      (w : ↥((weilEtaleGmPresheaf Y').obj (Opposite.op W₂))),
      pushI g (ι_sec W₂ w) = ι_sec W₁ (((weilEtaleGmPresheaf Y').map g.op).hom w) := by
    intro W₁ W₂ g w
    have hnat := (u_sh ≫ ι_inj.hom).naturality g.op
    have h1 := congrArg (fun φ => φ.hom w) hnat
    exact h1.symm

  let toGmSpec : ∀ (A : Type u) [CommRing A],
