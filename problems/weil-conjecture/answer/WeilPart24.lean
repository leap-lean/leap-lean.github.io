  have heq_tilde : cechCl Z W_tilde w_tilde hw_tilde c_T_tilde =
      cechCl Z W_tilde w_tilde hw_tilde c_S_tilde := by
    rw [map_sub] at hsub_cl
    exact sub_eq_zero.mp hsub_cl
  have hξ_S : cechCl Z W_S w_S hw_S c_S = ξ := by
    calc
      cechCl Z W_S w_S hw_S c_S = cechCl Z W_tilde w_tilde hw_tilde c_S_tilde := hcl_L.symm
      _ = cechCl Z W_tilde w_tilde hw_tilde c_T_tilde := heq_tilde.symm
      _ = cechCl Z W_T w_T hw_T c_T := hcl_R
      _ = ξ := hξ_T
  have hmc_S_cl : cechCl Z W_S w_S hw_S (m • c_S) = 0 := by
    rw [map_nsmul, hξ_S, hmξ]
  obtain ⟨b₀_S, hb₀_S⟩ := (hCech1 Z W_S w_S hw_S (m • c_S)).mp hmc_S_cl
  rw [AddSubgroup.coe_nsmul] at hb₀_S

  
  obtain ⟨N, hN, U, s, hCov_U, hAff_U, hs⟩ :=
    h_s5_loc_charts n₀ n₁ hn₀ f₀ hsum₀ f₁ hsum₁
  obtain ⟨u, g, hDiag_g, hCocyc_g, hPow_g, hg_eval⟩ :=
    h_s6_simplicial_eval W_S w_S N U s hs c_S m b₀_S hb₀_S
  refine ⟨N, hN, U, u, g, hCov_U, hAff_U, hDiag_g, hCocyc_g, hPow_g, ?_⟩
  intro Z₀ h p_Gm hp_Gm hw_units
  exact h_s7_crux_pullback_kill W_S w_S hw_S N U hCov_U s hs c_S g hg_eval
    cechCl hCech1 hCech3 ξ hξ_S Z₀ h p_Gm hp_Gm hw_units

theorem weil_kummer_deg_one_pullback_zero_of_gm_zero_on_curve (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (Y : AlgebraicGeometry.Scheme.{u})
    (f_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    (hGmSheafY : CategoryTheory.Presheaf.IsSheaf Y.smallEtaleTopology (weilEtaleGmPresheaf Y))
    (ι_kum_Y : weilEtaleTorsionSheaf Y ℓ ⟶ weilEtaleGmSheaf Y)
    (p_kum_Y : weilEtaleGmSheaf Y ⟶ weilEtaleGmSheaf Y)
    (h0_Y : ι_kum_Y ≫ p_kum_Y = 0)
    (hp_Y_eq : p_kum_Y = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y))
    (hSE_Y : (CategoryTheory.ShortComplex.mk ι_kum_Y p_kum_Y h0_Y).ShortExact)
    (γ_Y : weilEtaleTorsionH Y ℓ 1)
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (hGmSheafC : CategoryTheory.Presheaf.IsSheaf C.left.smallEtaleTopology
      (weilEtaleGmPresheaf C.left))
    (ι_kum_C : weilEtaleTorsionSheaf C.left ℓ ⟶ weilEtaleGmSheaf C.left)
    (p_kum_C : weilEtaleGmSheaf C.left ⟶ weilEtaleGmSheaf C.left)
    (h0_C : ι_kum_C ≫ p_kum_C = 0)
    (hp_C_eq : p_kum_C = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf C.left))
    (hSE_C : (CategoryTheory.ShortComplex.mk ι_kum_C p_kum_C h0_C).ShortExact)
    (hDivC : ∀ x : (weilEtaleGmSheaf C.left).H 0, ∃ y : (weilEtaleGmSheaf C.left).H 0, ℓ • y = x)
    (h : C.left ⟶ Y)
    (hh_k : h ≫ f_Y = C.hom)
    (p_h : weilEtaleTorsionH Y ℓ 1 →+ weilEtaleTorsionH C.left ℓ 1)
    (hp_h : WeilIsTorsionEtalePullback h ℓ 1 p_h) :
    ∃ p_Gm : (weilEtaleGmSheaf Y).H 1 →+ (weilEtaleGmSheaf C.left).H 1,
      WeilIsGmEtalePullback h 1 p_Gm ∧
      (p_Gm ((CategoryTheory.Abelian.Ext.mk₀ ι_kum_Y).postcomp
        ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (Nat.add_zero 1) γ_Y) = 0 →
        p_h γ_Y = 0) :=
by
  classical
  let _ := hProjC
  let _ := hh_k
  have hPrime : Nat.Prime ℓ := Fact.out
  have : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Aℓ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

  
  let idTerm : ∀ S : AlgebraicGeometry.Scheme.{u}, S.Etale := fun S =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  let idTermIsTerminal : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Limits.IsTerminal (idTerm S) := fun S =>
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom))
      (fun U m => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m)))

  have hHomEquivId : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞]
      {𝒟 : Type _} [CategoryTheory.Category 𝒟]
      (L : 𝒞 ⥤ 𝒟) (R : 𝒟 ⥤ 𝒞) (adj : L ⊣ R) (X : 𝒞),
      adj.homEquiv X (L.obj X) (CategoryTheory.CategoryStruct.id (L.obj X)) = adj.unit.app X := by
    intro 𝒞 _ 𝒟 _ L R adj X
    exact (adj.homEquiv_unit X (L.obj X) (CategoryTheory.CategoryStruct.id (L.obj X))).trans
      ((congrArg (adj.unit.app X ≫ ·) (R.map_id (L.obj X))).trans
        (CategoryTheory.Category.comp_id (adj.unit.app X)))

  have hHomEquivIdLarge : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      (L : 𝒞 ⥤ 𝒟) (R : 𝒟 ⥤ 𝒞) (adj : L ⊣ R) (X : 𝒞),
      adj.homEquiv X (L.obj X) (CategoryTheory.CategoryStruct.id (L.obj X)) = adj.unit.app X := by
    intro 𝒞 _ 𝒟 _ L R adj X
    exact (adj.homEquiv_unit X (L.obj X) (CategoryTheory.CategoryStruct.id (L.obj X))).trans
      ((congrArg (adj.unit.app X ≫ ·) (R.map_id (L.obj X))).trans
        (CategoryTheory.Category.comp_id (adj.unit.app X)))

  
  have hIsSheaf_of_type : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (P : CategoryTheory.Functor S.Etaleᵒᵖ AddCommGrpCat.{u}),
      CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology
        (P ⋙ CategoryTheory.forget AddCommGrpCat.{u}) →
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology P := by
    intro S P hType E U R hR φ hφ
    let P_set := P ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hShR : CategoryTheory.Presieve.IsSheafFor P_set (R : CategoryTheory.Presieve U) :=
      hType R hR
    let x_e : ↑E → CategoryTheory.Presieve.FamilyOfElements P_set (R : CategoryTheory.Presieve U) :=
      fun e _ f hf => (φ f hf).hom e
    have hx_e : ∀ e : ↑E, (x_e e).Compatible := by
      intro e Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
      exact congrArg (fun k : E ⟶ P.obj (Opposite.op Z) => k.hom e) (hφ g₁ g₂ h₁ h₂ hcomm)
    let amalg : ↑E → ↑(P.obj (Opposite.op U)) := fun e => hShR.amalgamate (x_e e) (hx_e e)
    have hamalg0 : amalg 0 = 0 := by
      apply hShR.isSeparatedFor.ext
      intro V f hf
      exact (hShR.isAmalgamation (hx_e 0) f hf).trans
        ((map_zero (φ f hf).hom).trans (map_zero (P.map f.op).hom).symm)
    have hamalg_add : ∀ e₁ e₂ : ↑E, amalg (e₁ + e₂) = amalg e₁ + amalg e₂ := by
      intro e₁ e₂
      apply hShR.isSeparatedFor.ext
      intro V f hf
      have he₁ : (φ f hf).hom e₁ = P_set.map f.op (amalg e₁) :=
        (hShR.isAmalgamation (hx_e e₁) f hf).symm
      have he₂ : (φ f hf).hom e₂ = P_set.map f.op (amalg e₂) :=
        (hShR.isAmalgamation (hx_e e₂) f hf).symm
      exact (hShR.isAmalgamation (hx_e (e₁ + e₂)) f hf).trans
        ((map_add (φ f hf).hom e₁ e₂).trans
          ((congrArg₂ (· + ·) he₁ he₂).trans (map_add (P.map f.op).hom _ _).symm))
    let ψ : E ⟶ P.obj (Opposite.op U) :=
      AddCommGrpCat.ofHom { toFun := amalg, map_zero' := hamalg0, map_add' := hamalg_add }
    refine ⟨ψ, ?_, ?_⟩
    · intro V f hf
      apply AddCommGrpCat.ext
      intro e
      exact hShR.isAmalgamation (hx_e e) f hf
    · intro ψ' hψ'
      apply AddCommGrpCat.ext
      intro e
      apply hShR.isSeparatedFor.ext
      intro V f hf
      exact (congrArg (fun k : E ⟶ P.obj (Opposite.op V) => k.hom e) (hψ' f hf)).trans
        (hShR.isAmalgamation (hx_e e) f hf).symm

  have hType_of_isSheaf : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology
        (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
    intro S G U R hR x hx
    let zHom : ∀ {M : AddCommGrpCat.{u}}, ↑M → (Aℤ ⟶ M) := fun m =>
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • m
          map_zero' := zero_zsmul m
          map_add' := fun a b => add_zsmul m a.down b.down }
    have hzHom_eval : ∀ {M : AddCommGrpCat.{u}} (m : ↑M), (zHom m).hom (ULift.up 1) = m :=
      fun m => one_zsmul m
    have hzHom_comp : ∀ {M N : AddCommGrpCat.{u}} (m : ↑M) (g : M ⟶ N),
        zHom m ≫ g = zHom (g.hom m) := by
      intro M N m g
      apply AddCommGrpCat.ext
      rintro ⟨z⟩
      exact map_zsmul g.hom z m
    have hZ : CategoryTheory.Presieve.IsSheafFor
        (G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) (R : CategoryTheory.Presieve U) :=
      G.property Aℤ R hR
    let φ : CategoryTheory.Presieve.FamilyOfElements
        (G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) (R : CategoryTheory.Presieve U) :=
      fun _ f hf => zHom (x f hf)
    have hφ : φ.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
      exact (hzHom_comp (x f₁ h₁) (G.obj.map g₁.op)).trans
        ((congrArg zHom (hx g₁ g₂ h₁ h₂ hcomm)).trans
          (hzHom_comp (x f₂ h₂) (G.obj.map g₂.op)).symm)
    let ψ : Aℤ ⟶ G.obj.obj (Opposite.op U) := hZ.amalgamate φ hφ
    refine ⟨ψ.hom (ULift.up 1), ?_, ?_⟩
    · intro V f hf
      have ham : ψ ≫ G.obj.map f.op = zHom (x f hf) := hZ.isAmalgamation hφ f hf
      exact (congrArg (fun k : Aℤ ⟶ G.obj.obj (Opposite.op V) => k.hom (ULift.up 1)) ham).trans
        (hzHom_eval (x f hf))
    · intro s' hs'
      have hψ' : φ.IsAmalgamation (zHom s') := by
        intro V f hf
        exact (hzHom_comp s' (G.obj.map f.op)).trans (congrArg zHom (hs' f hf))
      have heq : zHom s' = ψ := by
        apply hZ.isSeparatedFor.ext
        intro V f hf
        exact (hψ' f hf).trans (hZ.isAmalgamation hφ f hf).symm
      exact (hzHom_eval s').symm.trans
        (congrArg (fun k : Aℤ ⟶ _ => k.hom (ULift.up 1)) heq)

  
  have hLocConst : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      let Pℓ := (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℓ
      let Fℓ := weilEtaleTorsionSheaf S ℓ
      let T_S := idTerm S
      let hT_S := idTermIsTerminal S
      let shAdj := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
      let one_S : ↥(Fℓ.obj.obj (Opposite.op T_S)) :=
        ((shAdj.unit.app Pℓ).app (Opposite.op T_S)).hom (ULift.up (1 : ZMod ℓ))
      (∀ (U : S.Opens), Nonempty ↥U.toScheme →
        (Fℓ.obj.map (hT_S.from (CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
          (inferInstance : AlgebraicGeometry.Etale U.ι))).op).hom one_S ≠ 0) ∧
      (∀ [ConnectedSpace ↥S] (α : Fℓ ⟶ Fℓ),
        (α.hom.app (Opposite.op T_S)).hom one_S ≠ 0 →
        CategoryTheory.IsIso α) := by
    intro S
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let J := S.smallEtaleTopology
    let Pℓ := (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℓ
    let Fℓ := weilEtaleTorsionSheaf S ℓ
    let T_S := idTerm S
    let hT_S := idTermIsTerminal S
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
    let one_S : ↥(Fℓ.obj.obj (Opposite.op T_S)) :=
      ((shAdj.unit.app Pℓ).app (Opposite.op T_S)).hom (ULift.up (1 : ZMod ℓ))
    let L_pre := weilAltLocConstPresheaf S ℓ

    have hEt_hom : ∀ {V₁ V₂ : S.Etale} (f : V₁ ⟶ V₂), AlgebraicGeometry.Etale f.left := by
      intro V₁ V₂ f
      have hcomp : AlgebraicGeometry.Etale (f.left ≫ V₂.hom) := by
        rw [CategoryTheory.MorphismProperty.Over.w f]
        exact V₁.prop
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        f.left V₂.hom V₂.prop hcomp

    have hMemJ : ∀ {U : S.Etale} (R : CategoryTheory.Sieve U),
        R ∈ J U ↔ ∀ x : ↥U.left, ∃ (V : S.Etale) (f : V ⟶ U) (y : ↥V.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
      intro U R
      have hJ_eq : J = (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) S le_rfl
      rw [hJ_eq]
      exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U R

    have hL_type : CategoryTheory.Presieve.IsSheaf J
        (L_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
      intro U R hR x hx
      let lcOf : ∀ {W : S.Etale},
          (L_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}).obj (Opposite.op W) →
            LocallyConstant ↥W.left (ULift.{u} (ZMod ℓ)) := fun g => g
      have hcov := (hMemJ R).mp hR
      have hoverlap : ∀ {V₁ V₂ : S.Etale} {f₁ : V₁ ⟶ U} {f₂ : V₂ ⟶ U}
          (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂) (y₁ : ↥V₁.left) (y₂ : ↥V₂.left),
          f₁.left y₁ = f₂.left y₂ → lcOf (x f₁ hf₁) y₁ = lcOf (x f₂ hf₂) y₂ := by
        intro V₁ V₂ f₁ f₂ hf₁ hf₂ y₁ y₂ heq
        have : AlgebraicGeometry.Etale f₁.left := hEt_hom f₁
        have : AlgebraicGeometry.Etale V₂.hom := V₂.prop
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ heq
        let Z_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom) inferInstance
        have hp₁_w : CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom =
            CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom := by
          calc
            CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom
              = CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ (f₁.left ≫ U.hom) :=
                  congrArg (CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ ·)
                    (CategoryTheory.MorphismProperty.Over.w f₁).symm
            _ = (CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ f₁.left) ≫ U.hom :=
                  (CategoryTheory.Category.assoc _ _ _).symm
            _ = (CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ f₂.left) ≫ U.hom :=
                  congrArg (· ≫ U.hom) CategoryTheory.Limits.pullback.condition
            _ = CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ (f₂.left ≫ U.hom) :=
                  CategoryTheory.Category.assoc _ _ _
            _ = CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom :=
                  congrArg (CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ ·)
                    (CategoryTheory.MorphismProperty.Over.w f₂)
        let p₁ : Z_et ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst f₁.left f₂.left) hp₁_w
        let p₂ : Z_et ⟶ V₂ := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.snd f₁.left f₂.left) rfl
        have hp_comm : p₁ ≫ f₁ = p₂ ≫ f₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        have hcompat_z := congrArg (fun g => lcOf g z) (hx p₁ p₂ hf₁ hf₂ hp_comm)
        exact (congrArg (lcOf (x f₁ hf₁)) hz₁.symm).trans
          (hcompat_z.trans (congrArg (lcOf (x f₂ hf₂)) hz₂))
      let s_fun : ↥U.left → ULift.{u} (ZMod ℓ) := fun u =>
        lcOf (x (hcov u).choose_spec.choose (hcov u).choose_spec.choose_spec.choose_spec.1)
          (hcov u).choose_spec.choose_spec.choose
      have hs_agree : ∀ {V : S.Etale} (f : V ⟶ U) (hf : R.arrows f) (y : ↥V.left),
          s_fun (f.left y) = lcOf (x f hf) y := by
        intro V f hf y
        exact hoverlap (hcov (f.left y)).choose_spec.choose_spec.choose_spec.1 hf _ y
          (hcov (f.left y)).choose_spec.choose_spec.choose_spec.2.2
      have hs_loc : IsLocallyConstant s_fun := by
        intro t
        rw [isOpen_iff_forall_mem_open]
        intro u hu
        obtain ⟨V, f, y, hf, hEt_f, hy⟩ := hcov u
        have : AlgebraicGeometry.Etale f.left := hEt_f
        have hy_t : y ∈ (lcOf (x f hf)) ⁻¹' t := by
          change lcOf (x f hf) y ∈ t
          rw [← hs_agree f hf y, hy]
          exact hu
        refine ⟨f.left.base '' ((lcOf (x f hf)) ⁻¹' t), ?_,
          f.left.isOpenMap _ ((lcOf (x f hf)).isLocallyConstant t), ⟨y, hy_t, hy⟩⟩
        rintro _ ⟨y', hy', rfl⟩
        change s_fun (f.left y') ∈ t
        rw [hs_agree f hf y']
        exact hy'
      let s : LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ)) := ⟨s_fun, hs_loc⟩
      refine ⟨s, ?_, ?_⟩
      · intro V f hf
        exact LocallyConstant.ext fun y => hs_agree f hf y
      · intro s' hs'
        let s'_lc : LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ)) := s'
        exact LocallyConstant.ext fun u => by
          obtain ⟨V, f, y, hf, _, hy⟩ := hcov u
          calc
            s'_lc u = s'_lc (f.left y) := congrArg s'_lc hy.symm
            _ = lcOf (x f hf) y := congrArg (fun g => lcOf g y) (hs' f hf)
            _ = s_fun (f.left y) := (hs_agree f hf y).symm
            _ = s u := congrArg s_fun hy

    let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨L_pre, hIsSheaf_of_type S L_pre hL_type⟩
    let Φ : Fℓ ⟶ L_sh := (adj_c.homEquiv Aℓ L_sh).symm (weilAltLocConstConstHom S T_S ℓ)

    have hAdjUnit : adj_c.unit.app Aℓ = (shAdj.unit.app Pℓ).app (Opposite.op T_S) :=
      CategoryTheory.Category.id_comp _

    have hΦ_T : adj_c.unit.app Aℓ ≫ Φ.hom.app (Opposite.op T_S) =
        weilAltLocConstConstHom S T_S ℓ :=
      (adj_c.homEquiv_unit Aℓ L_sh Φ).symm.trans
        (Equiv.apply_symm_apply (adj_c.homEquiv Aℓ L_sh) (weilAltLocConstConstHom S T_S ℓ))

    have hΦ_one : (Φ.hom.app (Opposite.op T_S)).hom one_S =
        LocallyConstant.const ↥S (ULift.up (1 : ZMod ℓ)) := by
      have h1 := congrArg (fun k : Aℓ ⟶ L_pre.obj (Opposite.op T_S) =>
        k.hom (ULift.up (1 : ZMod ℓ))) hΦ_T
      dsimp only [one_S]
      rw [← hAdjUnit]
      exact h1

    refine ⟨?_, ?_⟩
    · 
      intro U ⟨q⟩ h0
      let E_U : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
        (inferInstance : AlgebraicGeometry.Etale U.ι)
      let j_U : E_U ⟶ T_S := hT_S.from E_U
      have hnat := congrArg (fun k => k.hom one_S) (Φ.hom.naturality j_U.op)
      have hnat' : (Φ.hom.app (Opposite.op E_U)).hom ((Fℓ.obj.map j_U.op).hom one_S) =
          (L_pre.map j_U.op).hom ((Φ.hom.app (Opposite.op T_S)).hom one_S) := hnat
      have hconst0 : (L_pre.map j_U.op).hom (LocallyConstant.const ↥S (ULift.up.{u} (1 : ZMod ℓ))) = 0 := by
        rw [← hΦ_one, ← hnat', h0, map_zero]
      have hq : (1 : ZMod ℓ) = 0 := congrArg (fun g : LocallyConstant ↥E_U.left (ULift.{u} (ZMod ℓ)) => (g q).down) hconst0
      exact one_ne_zero hq
    · 
      intro hConn α hα_ne
      have hFℓ_type : CategoryTheory.Presieve.IsSheaf J
          (Fℓ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := hType_of_isSheaf S Fℓ
      have hEmptySub : ∀ (W : S.Etale), IsEmpty ↥W.left → Subsingleton ↥(Fℓ.obj.obj (Opposite.op W)) := by
        intro W hEmp
        have hBot : (⊥ : CategoryTheory.Sieve W) ∈ J W := by
          rw [hMemJ]
          intro x
          exact hEmp.elim x
        refine ⟨fun a b => ?_⟩
        apply (hFℓ_type (⊥ : CategoryTheory.Sieve W) hBot).isSeparatedFor.ext
        intro V f hf
        exact False.elim hf
      let R_s : ∀ (U : S.Etale), LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ)) → CategoryTheory.Sieve U :=
        fun U s =>
          { arrows := fun V f => ∃ a : ULift.{u} (ZMod ℓ), ∀ y : ↥V.left, s (f.left y) = a
            downward_closed := by
              rintro V W f ⟨a, ha⟩ g
              exact ⟨a, fun z => ha (g.left z)⟩ }
      have hR_s_mem : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ))),
          R_s U s ∈ J U := by
        intro U s
        rw [hMemJ]
        intro u
        let O_u : U.left.Opens := ⟨s ⁻¹' {s u}, s.isLocallyConstant {s u}⟩
        have : AlgebraicGeometry.Etale U.hom := U.prop
        let V_u : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_u.ι ≫ U.hom) inferInstance
        let f_u : V_u ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O_u.ι rfl
        have hu_mem : u ∈ O_u := rfl
        exact ⟨V_u, f_u, ⟨u, hu_mem⟩, ⟨s u, fun y => y.2⟩, inferInstance, O_u.ι_apply ⟨u, hu_mem⟩⟩
      let u_unit : ULift.{u} (ZMod ℓ) →+ ↥(Fℓ.obj.obj (Opposite.op T_S)) := (adj_c.unit.app Aℓ).hom
      let fam_s : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ))),
          CategoryTheory.Presieve.FamilyOfElements
            (Fℓ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) (R_s U s : CategoryTheory.Presieve U) :=
        fun U s V _ hf => (Fℓ.obj.map (hT_S.from V).op).hom (u_unit hf.choose)
      have hfam_compat : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ))),
          (fam_s U s).Compatible := by
        intro U s Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        by_cases hZ : Nonempty ↥Z.left
        · obtain ⟨z₀⟩ := hZ
          have hcomm_left : g₁.left ≫ f₁.left = g₂.left ≫ f₂.left :=
            congrArg (fun k : Z ⟶ U => k.left) hcomm
          have ha_eq : h₁.choose = h₂.choose :=
            (h₁.choose_spec (g₁.left z₀)).symm.trans
              ((congrArg (fun k : Z.left ⟶ U.left => s (k z₀)) hcomm_left).trans
                (h₂.choose_spec (g₂.left z₀)))
          have hg₁ : g₁ ≫ hT_S.from Y₁ = hT_S.from Z := hT_S.hom_ext _ _
          have hg₂ : g₂ ≫ hT_S.from Y₂ = hT_S.from Z := hT_S.hom_ext _ _
          have hmap1 : Fℓ.obj.map (hT_S.from Y₁).op ≫ Fℓ.obj.map g₁.op =
              Fℓ.obj.map (hT_S.from Z).op :=
            (Fℓ.obj.map_comp _ _).symm.trans (congrArg Fℓ.obj.map (op_comp.symm.trans (congrArg Opposite.op hg₁)))
          have hmap2 : Fℓ.obj.map (hT_S.from Y₂).op ≫ Fℓ.obj.map g₂.op =
              Fℓ.obj.map (hT_S.from Z).op :=
            (Fℓ.obj.map_comp _ _).symm.trans (congrArg Fℓ.obj.map (op_comp.symm.trans (congrArg Opposite.op hg₂)))
          exact (congrArg (fun m => m.hom (u_unit h₁.choose)) hmap1).trans
            ((congrArg (fun c => (Fℓ.obj.map (hT_S.from Z).op).hom (u_unit c)) ha_eq).trans
              (congrArg (fun m => m.hom (u_unit h₂.choose)) hmap2).symm)
        · have : Subsingleton ↥(Fℓ.obj.obj (Opposite.op Z)) := hEmptySub Z (not_nonempty_iff.mp hZ)
          exact Subsingleton.elim _ _
      let ψ_fun : ∀ (U : S.Etale),
          LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ)) → ↥(Fℓ.obj.obj (Opposite.op U)) :=
        fun U s => (hFℓ_type (R_s U s) (hR_s_mem U s)).amalgamate (fam_s U s) (hfam_compat U s)
      have hψ_spec : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ)))
          {V : S.Etale} (f : V ⟶ U) (a : ULift.{u} (ZMod ℓ)),
          (∀ y : ↥V.left, s (f.left y) = a) →
          (Fℓ.obj.map f.op).hom (ψ_fun U s) =
            (Fℓ.obj.map (hT_S.from V).op).hom (u_unit a) := by
        intro U s V f a ha
        have hf : (R_s U s).arrows f := ⟨a, ha⟩
        have ham : (Fℓ.obj.map f.op).hom (ψ_fun U s) =
            (Fℓ.obj.map (hT_S.from V).op).hom (u_unit hf.choose) :=
          (hFℓ_type (R_s U s) (hR_s_mem U s)).isAmalgamation (hfam_compat U s) f hf
        by_cases hV : Nonempty ↥V.left
        · obtain ⟨y₀⟩ := hV
          have heq : hf.choose = a := (hf.choose_spec y₀).symm.trans (ha y₀)
          exact ham.trans (congrArg (fun c => (Fℓ.obj.map (hT_S.from V).op).hom (u_unit c)) heq)
        · have : Subsingleton ↥(Fℓ.obj.obj (Opposite.op V)) := hEmptySub V (not_nonempty_iff.mp hV)
          exact Subsingleton.elim _ _
      have hψ_zero : ∀ U : S.Etale, ψ_fun U 0 = 0 := by
        intro U
        apply (hFℓ_type (R_s U 0) (hR_s_mem U 0)).isSeparatedFor.ext
        intro V f _
        exact (hψ_spec U 0 f 0 (fun _ => rfl)).trans
          ((congrArg (Fℓ.obj.map (hT_S.from V).op).hom u_unit.map_zero).trans
            (((Fℓ.obj.map (hT_S.from V).op).hom.map_zero).trans
              ((Fℓ.obj.map f.op).hom.map_zero).symm))
      have hψ_add : ∀ (U : S.Etale) (s₁ s₂ : LocallyConstant ↥U.left (ULift.{u} (ZMod ℓ))),
          ψ_fun U (s₁ + s₂) = ψ_fun U s₁ + ψ_fun U s₂ := by
        intro U s₁ s₂
        have hR12 : R_s U s₁ ⊓ R_s U s₂ ∈ J U :=
          J.intersection_covering (hR_s_mem U s₁) (hR_s_mem U s₂)
        apply (hFℓ_type (R_s U s₁ ⊓ R_s U s₂) hR12).isSeparatedFor.ext
        intro V f ⟨⟨a₁, ha₁⟩, ⟨a₂, ha₂⟩⟩
        have ha12 : ∀ y : ↥V.left, (s₁ + s₂) (f.left y) = a₁ + a₂ :=
          fun y => (LocallyConstant.add_apply s₁ s₂ (f.left y)).trans
            (congrArg₂ (· + ·) (ha₁ y) (ha₂ y))
        exact (hψ_spec U (s₁ + s₂) f (a₁ + a₂) ha12).trans
          ((congrArg (Fℓ.obj.map (hT_S.from V).op).hom (u_unit.map_add a₁ a₂)).trans
            (((Fℓ.obj.map (hT_S.from V).op).hom.map_add (u_unit a₁) (u_unit a₂)).trans
              ((congrArg₂ (· + ·) (hψ_spec U s₁ f a₁ ha₁).symm (hψ_spec U s₂ f a₂ ha₂).symm).trans
                ((Fℓ.obj.map f.op).hom.map_add (ψ_fun U s₁) (ψ_fun U s₂)).symm)))
      let ψ_nat : L_pre ⟶ Fℓ.obj :=
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := ψ_fun U.unop
              map_zero' := hψ_zero U.unop
              map_add' := hψ_add U.unop }
          naturality := by
            intro U₁ U₂ g
            apply AddCommGrpCat.ext
            intro s
            let s₁ : LocallyConstant ↥U₁.unop.left (ULift.{u} (ZMod ℓ)) := s
            let s₂ : LocallyConstant ↥U₂.unop.left (ULift.{u} (ZMod ℓ)) := (L_pre.map g).hom s
            let u : U₂.unop ⟶ U₁.unop := g.unop
            have hPull : CategoryTheory.Sieve.pullback u (R_s U₁.unop s₁) ∈ J U₂.unop :=
              J.pullback_stable u (hR_s_mem U₁.unop s₁)
            apply (hFℓ_type (CategoryTheory.Sieve.pullback u (R_s U₁.unop s₁)) hPull).isSeparatedFor.ext
            intro V f ⟨a, ha⟩
            have h1 : (Fℓ.obj.map f.op).hom (ψ_fun U₂.unop s₂) =
                (Fℓ.obj.map (hT_S.from V).op).hom (u_unit a) :=
              hψ_spec U₂.unop s₂ f a ha
            have h2 : (Fℓ.obj.map (f ≫ u).op).hom (ψ_fun U₁.unop s₁) =
                (Fℓ.obj.map (hT_S.from V).op).hom (u_unit a) :=
              hψ_spec U₁.unop s₁ (f ≫ u) a ha
            have h3 : Fℓ.obj.map (f ≫ u).op = Fℓ.obj.map u.op ≫ Fℓ.obj.map f.op :=
              (congrArg Fℓ.obj.map op_comp).trans (Fℓ.obj.map_comp u.op f.op)
            exact h1.trans (h2.symm.trans (congrArg (fun m => m.hom (ψ_fun U₁.unop s₁)) h3)) }
      let Ψ : L_sh ⟶ Fℓ := { hom := ψ_nat }
      have hΦΨ : Φ ≫ Ψ = CategoryTheory.CategoryStruct.id Fℓ := by
        apply (adj_c.homEquiv Aℓ Fℓ).injective
        refine (adj_c.homEquiv_unit Aℓ Fℓ (Φ ≫ Ψ)).trans
          (Eq.trans ?_ (hHomEquivId _ _ adj_c Aℓ).symm)
        have hcomp_app : ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_S)).map (Φ ≫ Ψ) =
            Φ.hom.app (Opposite.op T_S) ≫ ψ_nat.app (Opposite.op T_S) := rfl
        rw [hcomp_app, ← CategoryTheory.Category.assoc, hΦ_T]
        apply AddCommGrpCat.ext
        intro a
        have hid_from : hT_S.from T_S = CategoryTheory.CategoryStruct.id T_S := hT_S.hom_ext _ _
        have h1 := hψ_spec T_S (LocallyConstant.const ↥S a)
          (CategoryTheory.CategoryStruct.id T_S) a (fun _ => rfl)
        rw [op_id, Fℓ.obj.map_id, hid_from, op_id, Fℓ.obj.map_id] at h1
        exact h1

      
      let s_α : LocallyConstant ↥S (ULift.{u} (ZMod ℓ)) :=
        (Φ.hom.app (Opposite.op T_S)).hom ((α.hom.app (Opposite.op T_S)).hom one_S)
      let x₀ : ↥S := Classical.choice ConnectedSpace.toNonempty
      let r : ZMod ℓ := (s_α x₀).down
      have hs_α_eq : s_α = (Φ.hom.app (Opposite.op T_S)).hom (r.val • one_S) := by
        rw [map_nsmul, hΦ_one]
        ext x
        have hconst := s_α.apply_eq_of_isPreconnected isPreconnected_univ (Set.mem_univ x)
          (Set.mem_univ x₀)
        calc
          (s_α x).down = r := congrArg ULift.down hconst
          _ = ((r.val : ℕ) : ZMod ℓ) := (ZMod.natCast_zmod_val r).symm
          _ = ((r.val • LocallyConstant.const ↥S (ULift.up.{u} (1 : ZMod ℓ))) x).down := by
              change _ = r.val • (1 : ZMod ℓ)
              rw [nsmul_one]
      have hα_one : (α.hom.app (Opposite.op T_S)).hom one_S = r.val • one_S := by
        have h1 := congrArg (ψ_nat.app (Opposite.op T_S)).hom hs_α_eq
        have hret : ∀ w : ↥(Fℓ.obj.obj (Opposite.op T_S)),
            (ψ_nat.app (Opposite.op T_S)).hom ((Φ.hom.app (Opposite.op T_S)).hom w) = w :=
          fun w => congrArg (fun k : Fℓ ⟶ Fℓ => (k.hom.app (Opposite.op T_S)).hom w) hΦΨ
        exact (hret _).symm.trans (h1.trans (hret _))

      let ev_T : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
          (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj (Opposite.op T_S)
      have hev_nsmul : ∀ (n : ℕ) (w : ↥(Fℓ.obj.obj (Opposite.op T_S))),
          ((n • CategoryTheory.CategoryStruct.id Fℓ).hom.app (Opposite.op T_S)).hom w = n • w := by
        intro n w
        have hm : (n • CategoryTheory.CategoryStruct.id Fℓ).hom.app (Opposite.op T_S) =
            n • CategoryTheory.CategoryStruct.id (Fℓ.obj.obj (Opposite.op T_S)) := by
          change ev_T.map (n • CategoryTheory.CategoryStruct.id Fℓ) =
            n • CategoryTheory.CategoryStruct.id (ev_T.obj Fℓ)
          rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
        rw [hm]
        rfl

      have hu_unit_one : u_unit (ULift.up (1 : ZMod ℓ)) = one_S :=
        congrArg (fun m => m.hom (ULift.up (1 : ZMod ℓ))) hAdjUnit

      have hα_eq : α = r.val • CategoryTheory.CategoryStruct.id Fℓ := by
        apply (adj_c.homEquiv Aℓ Fℓ).injective
        refine (adj_c.homEquiv_unit Aℓ Fℓ α).trans
          (Eq.trans ?_ (adj_c.homEquiv_unit Aℓ Fℓ (r.val • CategoryTheory.CategoryStruct.id Fℓ)).symm)
        apply AddCommGrpCat.ext
        rintro ⟨u⟩
        let x_u : ULift.{u} (ZMod ℓ) := ULift.up u
        have hu_eq : x_u = u.val • ULift.up (1 : ZMod ℓ) := by
          apply ULift.ext
          change u = u.val • (1 : ZMod ℓ)
          rw [nsmul_one, ZMod.natCast_zmod_val]
        let f_lhs : ↥(Fℓ.obj.obj (Opposite.op T_S)) →+ ↥(Fℓ.obj.obj (Opposite.op T_S)) :=
          (α.hom.app (Opposite.op T_S)).hom
        let f_rhs : ↥(Fℓ.obj.obj (Opposite.op T_S)) →+ ↥(Fℓ.obj.obj (Opposite.op T_S)) :=
          ((r.val • CategoryTheory.CategoryStruct.id Fℓ).hom.app (Opposite.op T_S)).hom
        change f_lhs (u_unit x_u) = f_rhs (u_unit x_u)
        calc
          f_lhs (u_unit x_u) = f_lhs (u.val • one_S) := by
            rw [hu_eq, u_unit.map_nsmul, hu_unit_one]
          _ = u.val • (r.val • one_S) := by rw [f_lhs.map_nsmul, hα_one]
          _ = u.val • f_rhs one_S := by rw [hev_nsmul r.val one_S]
          _ = f_rhs (u_unit x_u) := by
            rw [← f_rhs.map_nsmul, ← hu_unit_one, ← u_unit.map_nsmul, ← hu_eq]

      have hℓ_id_zero : ℓ • CategoryTheory.CategoryStruct.id Fℓ = 0 := by
        apply (adj_c.homEquiv Aℓ Fℓ).injective
        refine (adj_c.homEquiv_unit Aℓ Fℓ (ℓ • CategoryTheory.CategoryStruct.id Fℓ)).trans
          (Eq.trans ?_ (adj_c.homEquiv_unit Aℓ Fℓ 0).symm)
        apply AddCommGrpCat.ext
        rintro ⟨u⟩
        let x_u : ULift.{u} (ZMod ℓ) := ULift.up u
        have hℓu : ℓ • x_u = 0 := by
          apply ULift.ext
          change ℓ • u = 0
          simp
        have hz_app : (0 : Fℓ ⟶ Fℓ).hom.app (Opposite.op T_S) = 0 := ev_T.map_zero Fℓ Fℓ
        change ((ℓ • CategoryTheory.CategoryStruct.id Fℓ).hom.app (Opposite.op T_S)).hom (u_unit x_u) =
          ((0 : Fℓ ⟶ Fℓ).hom.app (Opposite.op T_S)).hom (u_unit x_u)
        calc
          ((ℓ • CategoryTheory.CategoryStruct.id Fℓ).hom.app (Opposite.op T_S)).hom (u_unit x_u)
            = ℓ • u_unit x_u := hev_nsmul ℓ (u_unit x_u)
          _ = u_unit (ℓ • x_u) := (map_nsmul u_unit ℓ x_u).symm
          _ = 0 := by rw [hℓu, u_unit.map_zero]
          _ = ((0 : Fℓ ⟶ Fℓ).hom.app (Opposite.op T_S)).hom (u_unit x_u) := by rw [hz_app]; rfl

      have hr_ne : r ≠ 0 := by
        intro hr0
        apply hα_ne
        rw [hα_one, hr0, ZMod.val_zero, zero_smul]
      let α_inv : Fℓ ⟶ Fℓ := (r⁻¹).val • CategoryTheory.CategoryStruct.id Fℓ
      have hmul_mod : (r.val * (r⁻¹).val) % ℓ = 1 := by
        have hcast : ((r.val * (r⁻¹).val : ℕ) : ZMod ℓ) = 1 := by
          rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
          exact mul_inv_cancel₀ hr_ne
        have hval := congrArg ZMod.val hcast
        rwa [ZMod.val_natCast, ZMod.val_one] at hval
      have hmul_eq : r.val * (r⁻¹).val = ℓ * ((r.val * (r⁻¹).val) / ℓ) + 1 := by
        have hdiv := Nat.div_add_mod (r.val * (r⁻¹).val) ℓ
        omega
      have hmul_id : (r.val * (r⁻¹).val) • CategoryTheory.CategoryStruct.id Fℓ =
          CategoryTheory.CategoryStruct.id Fℓ := by
        rw [hmul_eq, add_nsmul, mul_nsmul, hℓ_id_zero, smul_zero, zero_add, one_nsmul]
      refine ⟨⟨α_inv, ?_, ?_⟩⟩
      · rw [hα_eq]
        dsimp only [α_inv]
        rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
          CategoryTheory.Category.id_comp, ← mul_nsmul, mul_comm (r⁻¹).val r.val]
        exact hmul_id
      · rw [hα_eq]
        dsimp only [α_inv]
        rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
          CategoryTheory.Category.id_comp, ← mul_nsmul]
        exact hmul_id

  
  obtain ⟨hc, hr, ha, hl, hcol, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hp_h_eq⟩ := hp_h
  have : (weilEtaleSitePullback h).IsContinuous
      Y.smallEtaleTopology C.left.smallEtaleTopology := hc
  let B_h := weilEtaleSitePullback h
  let J_Y := Y.smallEtaleTopology
  let J_C := C.left.smallEtaleTopology
  let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_C
  have : pf_h.IsRightAdjoint := hr
  let pb_h := B_h.sheafPullback AddCommGrpCat.{u} J_Y J_C
  let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y J_C
  have : pb_h.Additive := ha
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_h := hl
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_h := hcol
  let shAdj_Y := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
  let shAdj_C := CategoryTheory.sheafificationAdjunction J_C AddCommGrpCat.{u}

  let constMate : ∀ (M : AddCommGrpCat.{u}),
      pb_h.obj ((CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj M) ⟶
        (CategoryTheory.constantSheaf J_C AddCommGrpCat.{u}).obj M := fun M =>
    let PM_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj M
    let PM_C := (CategoryTheory.Functor.const (Opposite C.left.Etale)).obj M
    let FM_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj M
    let FM_C := (CategoryTheory.constantSheaf J_C AddCommGrpCat.{u}).obj M
    let η₀ := CategoryTheory.Functor.whiskerLeft B_h.op (shAdj_C.unit.app PM_C)
    let uM := (shAdj_Y.homEquiv PM_Y (pf_h.obj FM_C)).symm η₀
    (adj_h.homEquiv FM_Y FM_C).symm uM

  have hConstMate_eq : ∀ {T₀ : C.left.Etale} (hT₀ : CategoryTheory.Limits.IsTerminal T₀)
      {T : Y.Etale} (hT : CategoryTheory.Limits.IsTerminal T) (M : AddCommGrpCat.{u}),
      constMate M = weilEtaleConstPullbackHom h hT₀ hT M := by
    intro T₀ hT₀ T hT M
    let PM_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj M
