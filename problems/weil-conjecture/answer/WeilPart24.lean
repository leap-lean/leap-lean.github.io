        pr₂.base ⁻¹' (j_Z.base '' (PrimeSpectrum.basicOpen (f_Z r) : Set (PrimeSpectrum Z_ring))) := by
      have hOpens :=
        AlgebraicGeometry.IsOpenImmersion.image_preimage_eq_preimage_image_of_isPullback
