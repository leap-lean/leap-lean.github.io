  have h_germ_open : ∀ (U : C.left.Etale) (O : U.left.Opens) (y : ↥U.left) (hy : y ∈ O)
      (r₀ : ↑(O.toScheme.presheaf.obj (Opposite.op ⊤))),
      (O.ι.stalkMap ⟨y, hy⟩).hom ((U.left.presheaf.germ O y hy).hom (O.topIso.hom.hom r₀)) =
        (O.toScheme.presheaf.germ ⊤ ⟨y, hy⟩ trivial).hom r₀ := by
    intro U O y hy r₀
    have h1 : O.topIso.hom ≫ U.left.presheaf.germ O y hy =
        O.toScheme.presheaf.germ ⊤ ⟨y, hy⟩ trivial ≫ (O.stalkIso ⟨y, hy⟩).hom := by
      have ha : O.topIso.hom ≫ U.left.presheaf.germ O y hy =
          U.left.presheaf.germ ((O.ι.opensFunctor).obj ⊤) y ⟨⟨y, hy⟩, trivial, rfl⟩ := by
        rw [AlgebraicGeometry.Scheme.Opens.topIso_hom]
        exact TopCat.Presheaf.germ_res U.left.presheaf (CategoryTheory.eqToHom _) y hy
      exact ha.trans
        (@AlgebraicGeometry.Scheme.Opens.germ_stalkIso_hom U.left O ⊤ ⟨y, hy⟩ trivial).symm
    have h2 : O.topIso.hom ≫ U.left.presheaf.germ O y hy ≫ O.ι.stalkMap ⟨y, hy⟩ =
        O.toScheme.presheaf.germ ⊤ ⟨y, hy⟩ trivial := by
      rw [← AlgebraicGeometry.Scheme.Opens.stalkIso_inv O ⟨y, hy⟩,
        ← CategoryTheory.Category.assoc, h1, CategoryTheory.Category.assoc,
        Iso.hom_inv_id, CategoryTheory.Category.comp_id]
    exact congrArg (fun θ => θ.hom r₀) h2

  have h_germ_open_inv : ∀ (U : C.left.Etale) (O : U.left.Opens) (y : ↥U.left) (hy : y ∈ O)
      (r : ↑(U.left.presheaf.obj (Opposite.op O))),
      (O.ι.stalkMap ⟨y, hy⟩).hom ((U.left.presheaf.germ O y hy).hom r) =
        (O.toScheme.presheaf.germ ⊤ ⟨y, hy⟩ trivial).hom (O.topIso.inv.hom r) := by
    intro U O y hy r
    have h := h_germ_open U O y hy (O.topIso.inv.hom r)
    have h_iso : O.topIso.hom.hom (O.topIso.inv.hom r) = r :=
      congrArg (fun θ => θ.hom r) O.topIso.inv_hom_id
    rwa [h_iso] at h

