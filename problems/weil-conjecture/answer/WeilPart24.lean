      have hd_q : d ∈ q := hM_le (Ideal.mem_span_singleton_self _)
      rw [hq_bot] at hd_q
      exact hd (Ideal.mem_bot.mp hd_q)
    have hSurj_T : ∀ t : T, ∃ c d : D, d ≠ 0 ∧ t * algebraMap D T d = algebraMap D T c := by
      intro t
      obtain ⟨⟨c, ⟨d, hd_M₀⟩⟩, ht⟩ := IsLocalization.surj M₀ t
      exact ⟨c, d, nonZeroDivisors.ne_zero (hM₀_le hd_M₀), ht⟩
    have hField_T : IsField T :=
      { exists_pair_ne := hDomT.toNontrivial.exists_pair_ne
        mul_comm := mul_comm
        mul_inv_cancel := fun {t} ht => by
          obtain ⟨c, d, hd_ne, htd⟩ := hSurj_T t
