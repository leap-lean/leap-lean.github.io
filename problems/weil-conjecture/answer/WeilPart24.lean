    intro R₀ R₁ R₀₁ S₀ S₁ instCR₀ instCR₁ instCR₀₁ instCS₀ instCS₁ instA₀ instA₁ f₀ f₁
    dsimp only []
    intro w₀₀ w₁₁ w₀₁ h6 h7
