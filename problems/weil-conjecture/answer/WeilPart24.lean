    have hInj_α : Function.Injective α := by
      intro d₁ d₂ hd_eq
      apply hInj_DT
      change Algebra.TensorProduct.includeLeftRingHom d₁ =
        Algebra.TensorProduct.includeLeftRingHom d₂
      rw [← he_α d₁, ← he_α d₂, hd_eq]
    have hUnit_α : ∀ d : D, d ≠ 0 → IsUnit (α d) := by
      intro d hd
      have hu : IsUnit (e_ring (α d)) := by
        rw [he_α d]
        exact hUnit_T d hd
      have h_symm : IsUnit (e_ring.symm (e_ring (α d))) := hu.map e_ring.symm.toRingHom
      rwa [e_ring.symm_apply_apply] at h_symm
    have hSurj_α : ∀ z : E, ∃ c d : D, d ≠ 0 ∧ z * α d = α c := by
      intro z
      obtain ⟨c, d, hd_ne, htd⟩ := hSurj_T (e_ring z)
      refine ⟨c, d, hd_ne, e_ring.injective ?_⟩
      rw [map_mul, he_α d, he_α c]
      exact htd
    exact ⟨hDomE, hFieldE, hInj_α, hUnit_α, hSurj_α⟩

  have hChart_shrink : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (f : Y ⟶ C.left)
      (W₀ : C.left.Opens) (hW₀ : AlgebraicGeometry.IsAffineOpen W₀)
      (V₀ : Y.Opens) (hV₀ : AlgebraicGeometry.IsAffineOpen V₀)
      (e : V₀ ≤ (TopologicalSpace.Opens.map f.base).obj W₀),
      let D := ↑(Y.presheaf.obj (Opposite.op V₀))
      IsDomain D →
      Function.Injective (f.appLE W₀ V₀ e).hom →
      (∀ q : Ideal D, q.IsPrime → Ideal.comap (f.appLE W₀ V₀ e).hom q = ⊥ → q = ⊥) →
      ∀ (y : ↥Y) (W : Y.Opens), y ∈ V₀ → y ∈ W →
        ∃ V' : Y.Opens, y ∈ V' ∧ V' ≤ W ∧
          Function.Injective
            (V'.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst (V'.ι ≫ f) η_C).appTop).hom := by
    intro Y f W₀ hW₀ V₀ hV₀ e D hDomD hInjφ hGenPrime y W hyV₀ hyW
    have _ : IsDomain D := hDomD
    obtain ⟨g, hle_inf, hyV'⟩ :=
      hV₀.exists_basicOpen_le (V := V₀ ⊓ W) ⟨y, ⟨hyV₀, hyW⟩⟩ hyV₀
    let V' : Y.Opens := Y.basicOpen g
    have hyV'_mem : y ∈ V' := hyV'
    have hV'_V₀ : V' ≤ V₀ := Y.basicOpen_le g
    have hV'_W : V' ≤ W := le_trans hle_inf inf_le_right
    have hV'_aff : AlgebraicGeometry.IsAffineOpen V' := hV₀.basicOpen g
    have e' : V' ≤ (TopologicalSpace.Opens.map f.base).obj W₀ := le_trans hV'_V₀ e
    let D' : Type u := ↑(Y.presheaf.obj (Opposite.op V'))
    let ρ : D →+* D' := (Y.presheaf.map (CategoryTheory.homOfLE hV'_V₀).op).hom
    letI : Algebra D D' := ρ.toAlgebra
    have hLoc_D' : IsLocalization.Away g D' := hV₀.isLocalization_basicOpen g
    have hg_ne : g ≠ 0 := by
      intro hg0
      have hbot : V' = ⊥ := by
        dsimp [V']
        rw [hg0, AlgebraicGeometry.Scheme.basicOpen_zero]
      have hy_bot : y ∈ (⊥ : Y.Opens) := hbot ▸ hyV'_mem
      exact hy_bot
    have h_pow : Submonoid.powers g ≤ nonZeroDivisors D :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg_ne)
    have hDomD' : IsDomain D' :=
      IsLocalization.isDomain_of_le_nonZeroDivisors D' h_pow
    have hInjρ : Function.Injective ρ :=
      IsLocalization.injective D' h_pow
    have happ_eq : (f.appLE W₀ V' e').hom = ρ.comp (f.appLE W₀ V₀ e).hom := by
      rw [← CommRingCat.hom_comp, AlgebraicGeometry.Scheme.Hom.appLE_map]
    have hInjφ' : Function.Injective (f.appLE W₀ V' e').hom := by
      rw [happ_eq]
      exact hInjρ.comp hInjφ
    have hGenPrime' : ∀ Q : Ideal D', Q.IsPrime →
        Ideal.comap (f.appLE W₀ V' e').hom Q = ⊥ → Q = ⊥ := by
      intro Q hQ hQ_comap
      let q : Ideal D := Ideal.comap ρ Q
      have hq_prime : q.IsPrime := Ideal.comap_isPrime ρ Q
      have hq_comap : Ideal.comap (f.appLE W₀ V₀ e).hom q = ⊥ := by
        rw [happ_eq, ← Ideal.comap_comap] at hQ_comap
        exact hQ_comap
      have hq_bot : q = ⊥ := hGenPrime q hq_prime hq_comap
      rw [Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨⟨c, s⟩, hxs⟩ := IsLocalization.surj (Submonoid.powers g) x
      have hc_q : c ∈ q := by
        change algebraMap D D' c ∈ Q
        have hxs' : x * algebraMap D D' s.1 = algebraMap D D' c := hxs
        rw [← hxs']
        exact Q.mul_mem_right _ hx
      rw [hq_bot] at hc_q
      have hc0 : c = 0 := Ideal.mem_bot.mp hc_q
      have hxs' : x * algebraMap D D' s.1 = algebraMap D D' c := hxs
      rw [hc0, map_zero] at hxs'
      obtain ⟨us, hus⟩ := IsLocalization.map_units D' s
      have hx0 : x * (us : D') * ↑us⁻¹ = 0 * ↑us⁻¹ := by
        rw [hus, hxs']
      simpa using hx0
    exact ⟨V', hyV'_mem, hV'_W,
      (hChart_core Y f W₀ hW₀ V' hV'_aff e' hDomD' hInjφ' hGenPrime').2.2.1⟩

  
  have hOpenCover_glue : ∀ (Y S : AlgebraicGeometry.Scheme.{u})
      (f : Y ⟶ C.left) (g : S ⟶ C.left) {ι : Type u} (V : ι → Y.Opens),
      (∀ y : ↥Y, ∃ i : ι, y ∈ V i) →
      (∀ (y : ↥Y) (W : Y.Opens), y ∈ W →
        ∃ V' : Y.Opens, y ∈ V' ∧ V' ≤ W ∧
          Function.Injective
            (V'.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst (V'.ι ≫ f) g).appTop).hom) →
      Function.Injective (Units.map (CategoryTheory.Limits.pullback.fst f g).appTop.hom.toMonoidHom) ∧
      ∀ s : Units ↑((CategoryTheory.Limits.pullback f g).presheaf.obj (Opposite.op ⊤)),
        (∀ i : ι, ∃ u_i : Units ↑(Y.presheaf.obj (Opposite.op (V i))),
          Units.map ((V i).topIso.inv ≫
            (CategoryTheory.Limits.pullback.fst ((V i).ι ≫ f) g).appTop).hom.toMonoidHom u_i =
          Units.map (CategoryTheory.Limits.pullback.map ((V i).ι ≫ f) g f g (V i).ι
            (CategoryTheory.CategoryStruct.id S) (CategoryTheory.CategoryStruct.id C.left)
            (by rw [CategoryTheory.Category.comp_id])
            (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])).appTop.hom.toMonoidHom s) →
        s ∈ Set.range (Units.map (CategoryTheory.Limits.pullback.fst f g).appTop.hom.toMonoidHom) := by
    intro Y S f g ι V hcov hBasis
    let j_open : ∀ W : Y.Opens,
        CategoryTheory.Limits.pullback (W.ι ≫ f) g ⟶ CategoryTheory.Limits.pullback f g :=
      fun W =>
        CategoryTheory.Limits.pullback.map (W.ι ≫ f) g f g W.ι
          (CategoryTheory.CategoryStruct.id S) (CategoryTheory.CategoryStruct.id C.left)
          (by rw [CategoryTheory.Category.comp_id])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    let α_open : ∀ W : Y.Opens,
        ↑(Y.presheaf.obj (Opposite.op W)) →+*
          ↑((CategoryTheory.Limits.pullback (W.ι ≫ f) g).presheaf.obj (Opposite.op ⊤)) :=
      fun W => (W.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst (W.ι ≫ f) g).appTop).hom
    let k_le : ∀ {V' W : Y.Opens} (hle : V' ≤ W),
        CategoryTheory.Limits.pullback (V'.ι ≫ f) g ⟶
          CategoryTheory.Limits.pullback (W.ι ≫ f) g :=
      fun {V' W} hle =>
        CategoryTheory.Limits.pullback.map (V'.ι ≫ f) g (W.ι ≫ f) g (Y.homOfLE hle)
          (CategoryTheory.CategoryStruct.id S) (CategoryTheory.CategoryStruct.id C.left)
          (by rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.homOfLE_ι])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hk_α : ∀ {V' W : Y.Opens} (hle : V' ≤ W) (r : ↑(Y.presheaf.obj (Opposite.op W))),
        (k_le hle).appTop.hom (α_open W r) =
          α_open V' ((Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom r) := by
      intro V' W hle r
      have h_fst : k_le hle ≫ CategoryTheory.Limits.pullback.fst (W.ι ≫ f) g =
          CategoryTheory.Limits.pullback.fst (V'.ι ≫ f) g ≫ Y.homOfLE hle :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_top : W.topIso.inv ≫ (Y.homOfLE hle).appTop =
          Y.presheaf.map (CategoryTheory.homOfLE hle).op ≫ V'.topIso.inv := by
        have hL := ((congrArg (· ≫ (Y.homOfLE hle).appTop)
          (AlgebraicGeometry.Scheme.Opens.topIso_inv W)).trans
          (congrArg (Y.presheaf.map _ ≫ ·)
            (AlgebraicGeometry.Scheme.homOfLE_appTop hle))).trans
          (Y.presheaf.map_comp _ _).symm
        have hR := (congrArg (Y.presheaf.map (CategoryTheory.homOfLE hle).op ≫ ·)
          (AlgebraicGeometry.Scheme.Opens.topIso_inv V')).trans
          (Y.presheaf.map_comp _ _).symm
        exact hL.trans ((congrArg Y.presheaf.map (Subsingleton.elim _ _)).trans hR.symm)
      have h_mor : (W.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst (W.ι ≫ f) g).appTop) ≫
          (k_le hle).appTop =
          Y.presheaf.map (CategoryTheory.homOfLE hle).op ≫
            (V'.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst (V'.ι ≫ f) g).appTop) := by
        rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop, h_fst,
          AlgebraicGeometry.Scheme.Hom.comp_appTop, ← CategoryTheory.Category.assoc, h_top,
          CategoryTheory.Category.assoc]
      exact congrArg (fun θ => θ.hom r) h_mor
    have hk_j : ∀ {V' W : Y.Opens} (hle : V' ≤ W),
        k_le hle ≫ j_open W = j_open V' := by
      intro V' W hle
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [k_le, j_open]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι]
      · refine (CategoryTheory.Category.assoc _ _ _).trans ?_
        refine (congrArg (k_le hle ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans ?_
        refine (congrArg (k_le hle ≫ ·) (CategoryTheory.Category.comp_id _)).trans ?_
        refine (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans ?_
        exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    have hInj_α : ∀ W : Y.Opens, Function.Injective (α_open W) := by
      intro W r₁ r₂ hr
      apply TopCat.Presheaf.IsSheaf.section_ext Y.sheaf.2
      intro y hy
      obtain ⟨V', hy', hVW, hInj_V'⟩ := hBasis y W hy
      refine ⟨V', hVW, hy', hInj_V' ?_⟩
      change α_open V' ((Y.presheaf.map (CategoryTheory.homOfLE hVW).op).hom r₁) =
        α_open V' ((Y.presheaf.map (CategoryTheory.homOfLE hVW).op).hom r₂)
      rw [← hk_α hVW r₁, ← hk_α hVW r₂, hr]
    have h_top_ι_app : (⊤ : Y.Opens).ι.appTop = (⊤ : Y.Opens).topIso.inv := by
      change Y.presheaf.map (CategoryTheory.homOfLE _).op = _
      rw [AlgebraicGeometry.Scheme.Opens.topIso_inv]
      rfl
    have h_top_fst : (CategoryTheory.Limits.pullback.fst f g).appTop ≫ (j_open ⊤).appTop =
        (⊤ : Y.Opens).topIso.inv ≫
          (CategoryTheory.Limits.pullback.fst ((⊤ : Y.Opens).ι ≫ f) g).appTop := by
      have h1 : j_open ⊤ ≫ CategoryTheory.Limits.pullback.fst f g =
          CategoryTheory.Limits.pullback.fst ((⊤ : Y.Opens).ι ≫ f) g ≫ (⊤ : Y.Opens).ι :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, h1,
        AlgebraicGeometry.Scheme.Hom.comp_appTop, h_top_ι_app]
    refine ⟨?_, ?_⟩
    · intro u₁ u₂ hu
      apply Units.ext
      have hval : ((CategoryTheory.Limits.pullback.fst f g).appTop).hom u₁.val =
          ((CategoryTheory.Limits.pullback.fst f g).appTop).hom u₂.val :=
        congrArg Units.val hu
      apply hInj_α ⊤
      change ((⊤ : Y.Opens).topIso.inv ≫
          (CategoryTheory.Limits.pullback.fst ((⊤ : Y.Opens).ι ≫ f) g).appTop).hom u₁.val =
        ((⊤ : Y.Opens).topIso.inv ≫
          (CategoryTheory.Limits.pullback.fst ((⊤ : Y.Opens).ι ≫ f) g).appTop).hom u₂.val
      rw [← h_top_fst, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply, hval]
    · intro s hs
      choose u hu using hs
      have hu_val : ∀ i : ι, α_open (V i) (u i).val = (j_open (V i)).appTop.hom s.val := by
        intro i
        have h := congrArg Units.val (hu i)
        simpa [α_open, j_open] using h
      have hu_inv : ∀ i : ι,
          α_open (V i) ((u i)⁻¹ : Units _).val = (j_open (V i)).appTop.hom (s⁻¹ : Units _).val := by
        intro i
        have h := congrArg Units.val (congrArg Inv.inv (hu i))
        simpa [α_open, j_open] using h
      have hCompat_pos : TopCat.Presheaf.IsCompatible Y.presheaf V (fun i => (u i).val) := by
        intro i₁ i₂
        let W := V i₁ ⊓ V i₂
        apply hInj_α W
        change α_open W ((Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u i₁).val) =
          α_open W ((Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u i₂).val)
        rw [← hk_α inf_le_left, ← hk_α inf_le_right, hu_val i₁, hu_val i₂]
        have h1 : (j_open (V i₁)).appTop ≫ (k_le (inf_le_left : W ≤ V i₁)).appTop =
            (j_open W).appTop := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hk_j]
        have h2 : (j_open (V i₂)).appTop ≫ (k_le (inf_le_right : W ≤ V i₂)).appTop =
            (j_open W).appTop := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hk_j]
        exact congrArg (fun θ => θ.hom s.val) (h1.trans h2.symm)
      have hCompat_inv :
          TopCat.Presheaf.IsCompatible Y.presheaf V (fun i => ((u i)⁻¹ : Units _).val) := by
        intro i₁ i₂
        let W := V i₁ ⊓ V i₂
        apply hInj_α W
        change α_open W
            ((Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom ((u i₁)⁻¹ : Units _).val) =
          α_open W
            ((Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom ((u i₂)⁻¹ : Units _).val)
        rw [← hk_α inf_le_left, ← hk_α inf_le_right, hu_inv i₁, hu_inv i₂]
        have h1 : (j_open (V i₁)).appTop ≫ (k_le (inf_le_left : W ≤ V i₁)).appTop =
            (j_open W).appTop := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hk_j]
        have h2 : (j_open (V i₂)).appTop ≫ (k_le (inf_le_right : W ≤ V i₂)).appTop =
            (j_open W).appTop := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hk_j]
        exact congrArg (fun θ => θ.hom (s⁻¹ : Units _).val) (h1.trans h2.symm)
      have hTopCover : TopologicalSpace.IsOpenCover V :=
        eq_top_iff.mpr fun y _ => TopologicalSpace.Opens.mem_iSup.mpr (hcov y)
      have h_top_le_sup : (⊤ : Y.Opens) ≤ iSup V := le_of_eq hTopCover.symm
      obtain ⟨a_sup, ha_gl, _⟩ := Y.sheaf.existsUnique_gluing V (fun i => (u i).val) hCompat_pos
      obtain ⟨b_sup, hb_gl, _⟩ :=
        Y.sheaf.existsUnique_gluing V (fun i => ((u i)⁻¹ : Units _).val) hCompat_inv
      let a_top : ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
        (Y.presheaf.map (CategoryTheory.homOfLE h_top_le_sup).op).hom a_sup
      let b_top : ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
        (Y.presheaf.map (CategoryTheory.homOfLE h_top_le_sup).op).hom b_sup
      have ha_top_res : ∀ i : ι,
          (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom a_top = (u i).val := by
        intro i
        have h_comp : Y.presheaf.map (CategoryTheory.homOfLE h_top_le_sup).op ≫
            Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op =
            Y.presheaf.map (CategoryTheory.homOfLE (le_iSup V i)).op := by
          rw [← Y.presheaf.map_comp]
          rfl
        exact (congrArg (fun θ => θ.hom a_sup) h_comp).trans (ha_gl i)
      have hb_top_res : ∀ i : ι,
          (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom b_top =
            ((u i)⁻¹ : Units _).val := by
        intro i
        have h_comp : Y.presheaf.map (CategoryTheory.homOfLE h_top_le_sup).op ≫
            Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op =
            Y.presheaf.map (CategoryTheory.homOfLE (le_iSup V i)).op := by
          rw [← Y.presheaf.map_comp]
          rfl
        exact (congrArg (fun θ => θ.hom b_sup) h_comp).trans (hb_gl i)
      have hab_top : a_top * b_top = 1 := by
        apply TopCat.Presheaf.IsSheaf.section_ext Y.sheaf.2
        intro y _
        obtain ⟨i, hyi⟩ := hcov y
        refine ⟨V i, le_top, hyi, ?_⟩
        change (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom (a_top * b_top) =
          (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom 1
        rw [map_mul, map_one, ha_top_res i, hb_top_res i, Units.mul_inv]
      have hba_top : b_top * a_top = 1 := by rw [mul_comm, hab_top]
      let u_top : Units ↑(Y.presheaf.obj (Opposite.op ⊤)) := ⟨a_top, b_top, hab_top, hba_top⟩
      refine ⟨u_top, Units.ext ?_⟩
      let 𝒰_Y := Y.openCoverOfIsOpenCover V hTopCover
      let 𝒰_P := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰_Y f g
      apply AlgebraicGeometry.Scheme.OpenCover.ext_elem (U := ⊤)
        (((CategoryTheory.Limits.pullback.fst f g).appTop).hom a_top) s.val 𝒰_P
      intro i
      let i₀ : ι := i
      have h𝒰_f : 𝒰_P.f i = j_open (V i₀) :=
        (AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft_f 𝒰_Y f g i).trans
          (CategoryTheory.Limits.pullback.hom_ext
            ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm))
      have h_res_top : (V i₀).ι.appTop ≫
          (CategoryTheory.Limits.pullback.fst ((V i₀).ι ≫ f) g).appTop =
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i₀ ≤ ⊤)).op ≫
            (V i₀).topIso.inv ≫
            (CategoryTheory.Limits.pullback.fst ((V i₀).ι ≫ f) g).appTop := by
        have h_ι : (V i₀).ι.appTop =
            Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i₀ ≤ ⊤)).op ≫ (V i₀).topIso.inv := by
          refine ((congrArg (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i₀ ≤ ⊤)).op ≫ ·)
            (AlgebraicGeometry.Scheme.Opens.topIso_inv (V i₀))).trans ?_).symm
          exact (Y.presheaf.map_comp _ _).symm.trans
            (congrArg Y.presheaf.map (Subsingleton.elim _ _))
        rw [h_ι, CategoryTheory.Category.assoc]
      have h_j_fst : (CategoryTheory.Limits.pullback.fst f g).appTop ≫ (j_open (V i₀)).appTop =
          (V i₀).ι.appTop ≫ (CategoryTheory.Limits.pullback.fst ((V i₀).ι ≫ f) g).appTop := by
        have h1 : j_open (V i₀) ≫ CategoryTheory.Limits.pullback.fst f g =
            CategoryTheory.Limits.pullback.fst ((V i₀).ι ≫ f) g ≫ (V i₀).ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, h1,
          AlgebraicGeometry.Scheme.Hom.comp_appTop]
      have h_lhs : (j_open (V i₀)).appTop.hom
          (((CategoryTheory.Limits.pullback.fst f g).appTop).hom a_top) =
          α_open (V i₀)
            ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i₀ ≤ ⊤)).op).hom a_top) :=
        congrArg (fun θ => θ.hom a_top) (h_j_fst.trans h_res_top)
      change ((𝒰_P.f i).appTop).hom
          (((CategoryTheory.Limits.pullback.fst f g).appTop).hom a_top) =
        ((𝒰_P.f i).appTop).hom s.val
      exact (congrArg (fun θ : 𝒰_P.X i ⟶ CategoryTheory.Limits.pullback f g =>
