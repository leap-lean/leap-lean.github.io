              e_B.hom ≫ e_B.inv := by
                rw [e_B.hom_inv_id, CategoryTheory.Category.comp_id]
        _ = e_A.inv ≫ (e_A.hom ≫ CommRingCat.ofHom f) ≫ e_B.inv := by
                rw [← CategoryTheory.Category.assoc ((AlgebraicGeometry.Spec.map _).appTop), hnat]
        _ = (e_A.inv ≫ e_A.hom) ≫ CommRingCat.ofHom f ≫ e_B.inv := by
                simp only [CategoryTheory.Category.assoc]
        _ = CommRingCat.ofHom f ≫ e_B.inv := by
                rw [e_A.inv_hom_id, CategoryTheory.Category.id_comp]
    have hmon : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).appTop).hom.toMonoidHom.comp
        e_A.inv.hom.toMonoidHom =
        e_B.inv.hom.toMonoidHom.comp f.toMonoidHom := by
      ext a
      exact congrArg (fun φ : CommRingCat.of A ⟶ _ => φ.hom a) hnat_inv
    rw [hmon]

  let h_R₀₁ : AlgebraicGeometry.Spec (CommRingCat.of R'₀₁) ⟶ Y' := hAff_ov.fromSpec
