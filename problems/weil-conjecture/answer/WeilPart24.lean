  have hCrossComm : ∀ {S S' M : Type u} [CommRing S] [Algebra R₁ S] [CommRing S'] [Algebra R₁ S']
      [CommRing M] [Algebra R₁ M] (ξ : S →ₐ[R₁] S') (ρ : M →ₐ[R₁] M₀₁)
      (z : TensorProduct R₁ S M),
      Algebra.TensorProduct.map ξ (AlgHom.id R₁ M₀₁)
        ((Algebra.TensorProduct.map (AlgHom.id R₁ S) ρ).toRingHom z) =
      (Algebra.TensorProduct.map (AlgHom.id R₁ S') ρ).toRingHom
        (Algebra.TensorProduct.map ξ (AlgHom.id R₁ M) z) := by
    intro S S' M _ _ _ _ _ _ ξ ρ z
    have hcomp : (Algebra.TensorProduct.map ξ (AlgHom.id R₁ M₀₁)).comp
        (Algebra.TensorProduct.map (AlgHom.id R₁ S) ρ) =
        (Algebra.TensorProduct.map (AlgHom.id R₁ S') ρ).comp
          (Algebra.TensorProduct.map ξ (AlgHom.id R₁ M)) := by
      rw [← Algebra.TensorProduct.map_comp, ← Algebra.TensorProduct.map_comp,
        AlgHom.comp_id, AlgHom.id_comp, AlgHom.comp_id, AlgHom.id_comp]
    exact AlgHom.congr_fun hcomp z

  have hPushEq : ∀ {M : Type u} [CommRing M] [Algebra R₁ M] {i j k_idx : ℐ}
      (u : i ⟶ j) (v : j ⟶ k_idx) {w : i ⟶ k_idx} (hw : u ≫ v = w)
      {x y : TensorProduct R₁ ↑(D_sh.obj i) M},
      Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M) x =
        Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M) y →
      Algebra.TensorProduct.map (φ_tr w) (AlgHom.id R₁ M) x =
        Algebra.TensorProduct.map (φ_tr w) (AlgHom.id R₁ M) y := by
    intro M _ _ i j k_idx u v w hw x y hxy
    have hcomp : Algebra.TensorProduct.map (φ_tr (u ≫ v)) (AlgHom.id R₁ M) =
        (Algebra.TensorProduct.map (φ_tr v) (AlgHom.id R₁ M)).comp
          (Algebra.TensorProduct.map (φ_tr u) (AlgHom.id R₁ M)) := by
      rw [← Algebra.TensorProduct.map_comp, ← hφ_comp u v, AlgHom.comp_id]
    rw [← hw, hcomp]
    exact congrArg (Algebra.TensorProduct.map (φ_tr v) (AlgHom.id R₁ M)) hxy

  have hEqFam : ∀ {M : Type u} [CommRing M] [Algebra R₁ M] {β : Type} [Fintype β]
      (lhs rhs : β → TensorProduct R₁ ↑(D_sh.obj i₁) M),
      (∀ b : β, Algebra.TensorProduct.map (ι_colim i₁) (AlgHom.id R₁ M) (lhs b) =
        Algebra.TensorProduct.map (ι_colim i₁) (AlgHom.id R₁ M) (rhs b)) →
      ∃ (q : ℐ) (w : i₁ ⟶ q),
        ∀ b : β, Algebra.TensorProduct.map (φ_tr w) (AlgHom.id R₁ M) (lhs b) =
          Algebra.TensorProduct.map (φ_tr w) (AlgHom.id R₁ M) (rhs b) := by
    intro M _ _ β _ lhs rhs heq
    choose tgt arr harr using fun b => (hTensorColim M).2 i₁ (lhs b) (rhs b) (heq b)
    obtain ⟨q, w, hw⟩ := hStarCoeq β i₁ tgt arr
    refine ⟨q, w, fun b => ?_⟩
    obtain ⟨v, hv⟩ := hw b
    exact hPushEq (arr b) v hv (harr b)

