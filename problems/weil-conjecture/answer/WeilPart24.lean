          ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hΨ_fst,
          AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality, hV₀.isoSpec_inv_appTop,
          ← CategoryTheory.Category.assoc V₀.topIso.inv,
          ← CategoryTheory.Category.assoc V₀.topIso.inv,
