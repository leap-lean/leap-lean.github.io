  have : CategoryTheory.Mono ι_kum_C := hSE_C.mono_f
  obtain ⟨α, hα_lift⟩ := hSE_C.exact.lift' ι_tilde_C hι_tilde_pC
  have hc_ℓ_comm : c_ℓ ≫ (α ≫ ι_kum_C) = pb_h.map ι_kum_Y ≫ c_Gm := by
    change c_ℓ ≫ (α ≫ (CategoryTheory.ShortComplex.mk ι_kum_C p_kum_C h0_C).f) = j_0
    rw [hα_lift]
    exact (CategoryTheory.Category.assoc c_ℓ inv_c_ℓ j_0).symm.trans
      ((congrArg (· ≫ j_0) (@CategoryTheory.IsIso.hom_inv_id _ _ _ _ c_ℓ hc_ℓ_iso)).trans
        (CategoryTheory.Category.id_comp j_0))
  have hComm : πM ≫ (α ≫ ι_kum_C) = pb_h.map ι_kum_Y ≫ c_Gm := by
    rw [← hc_ℓ_eq]
    exact hc_ℓ_comm

  
  have : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  have : ConnectedSpace ↥C.left := IrreducibleSpace.connectedSpace ↥C.left
  let c₀ : ↥C.left := Classical.choice IrreducibleSpace.toNonempty
  let Pℓ_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℓ
  let Pℓ_C := (CategoryTheory.Functor.const (Opposite C.left.Etale)).obj Aℓ
  let one_Y : ↥(Fℓ_Y.obj.obj (Opposite.op T_Y)) :=
    ((shAdj_Y.unit.app Pℓ_Y).app (Opposite.op T_Y)).hom (ULift.up (1 : ZMod ℓ))
  let one_C : ↥(Fℓ_C.obj.obj (Opposite.op T_C)) :=
    ((shAdj_C.unit.app Pℓ_C).app (Opposite.op T_C)).hom (ULift.up (1 : ZMod ℓ))

  have hα_ne : (α.hom.app (Opposite.op T_C)).hom one_C ≠ 0 := by
    intro hα0
    let G_sh_Y : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := ⟨weilEtaleGmPresheaf Y, hGmSheafY⟩
    let η_GY := shAdj_Y.unit.app (weilEtaleGmPresheaf Y)
    let r_GY : Gm_Y ⟶ G_sh_Y := (shAdj_Y.homEquiv (weilEtaleGmPresheaf Y) G_sh_Y).symm
      (CategoryTheory.CategoryStruct.id (weilEtaleGmPresheaf Y))
    let s_GY : G_sh_Y ⟶ Gm_Y := { hom := η_GY }
    have hs_r_GY : η_GY ≫ r_GY.hom = CategoryTheory.CategoryStruct.id (weilEtaleGmPresheaf Y) :=
      (shAdj_Y.homEquiv_unit (weilEtaleGmPresheaf Y) G_sh_Y r_GY).symm.trans
        (Equiv.apply_symm_apply (shAdj_Y.homEquiv (weilEtaleGmPresheaf Y) G_sh_Y) _)
    have hr_s_GY : r_GY ≫ s_GY = CategoryTheory.CategoryStruct.id Gm_Y := by
      let comp_GY : (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj (weilEtaleGmPresheaf Y) ⟶ Gm_Y :=
        r_GY ≫ s_GY
      apply (shAdj_Y.homEquiv (weilEtaleGmPresheaf Y) Gm_Y).injective
      refine (shAdj_Y.homEquiv_unit (weilEtaleGmPresheaf Y) Gm_Y comp_GY).trans
        (Eq.trans ?_ (hHomEquivIdLarge _ _ shAdj_Y (weilEtaleGmPresheaf Y)).symm)
      exact (CategoryTheory.Category.assoc η_GY r_GY.hom η_GY).symm.trans
        ((congrArg (· ≫ η_GY) hs_r_GY).trans (CategoryTheory.Category.id_comp η_GY))

    let G_sh_C : CategoryTheory.Sheaf J_C AddCommGrpCat.{u} := ⟨weilEtaleGmPresheaf C.left, hGmSheafC⟩
    let r_GC : Gm_C ⟶ G_sh_C := (shAdj_C.homEquiv (weilEtaleGmPresheaf C.left) G_sh_C).symm
      (CategoryTheory.CategoryStruct.id (weilEtaleGmPresheaf C.left))
    have hs_r_GC : shAdj_C.unit.app (weilEtaleGmPresheaf C.left) ≫ r_GC.hom =
        CategoryTheory.CategoryStruct.id (weilEtaleGmPresheaf C.left) :=
      (shAdj_C.homEquiv_unit (weilEtaleGmPresheaf C.left) G_sh_C r_GC).symm.trans
        (Equiv.apply_symm_apply (shAdj_C.homEquiv (weilEtaleGmPresheaf C.left) G_sh_C) _)

    let u_Y_add : Additive (Units ↑(Y.presheaf.obj (Opposite.op ⊤))) :=
      (r_GY.hom.app (Opposite.op T_Y)).hom ((ι_kum_Y.hom.app (Opposite.op T_Y)).hom one_Y)
    let u_Y : Units ↑(Y.presheaf.obj (Opposite.op ⊤)) := Additive.toMul u_Y_add

    have hu_Y_pow : u_Y ^ ℓ = 1 := by
      have h0 : ℓ • u_Y_add = 0 := by
        let r_hom : ↥(Gm_Y.obj.obj (Opposite.op T_Y)) →+
            Additive (Units ↑(Y.presheaf.obj (Opposite.op ⊤))) :=
          (r_GY.hom.app (Opposite.op T_Y)).hom
        change ℓ • r_hom ((ι_kum_Y.hom.app (Opposite.op T_Y)).hom one_Y) = 0
        rw [← r_hom.map_nsmul]
        let ev_GY : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
          CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u} ⋙
            (CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj (Opposite.op T_Y)
        have hnsmul_GY : ℓ • (ι_kum_Y.hom.app (Opposite.op T_Y)).hom one_Y =
            ((ι_kum_Y ≫ p_kum_Y).hom.app (Opposite.op T_Y)).hom one_Y := by
          rw [hp_Y_eq]
          have hm : (ℓ • CategoryTheory.CategoryStruct.id Gm_Y).hom.app (Opposite.op T_Y) =
              ℓ • CategoryTheory.CategoryStruct.id (Gm_Y.obj.obj (Opposite.op T_Y)) := by
            change ev_GY.map (ℓ • CategoryTheory.CategoryStruct.id Gm_Y) =
              ℓ • CategoryTheory.CategoryStruct.id (ev_GY.obj Gm_Y)
            rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
          change ℓ • (ι_kum_Y.hom.app (Opposite.op T_Y)).hom one_Y =
            ((ℓ • CategoryTheory.CategoryStruct.id Gm_Y).hom.app (Opposite.op T_Y)).hom
              ((ι_kum_Y.hom.app (Opposite.op T_Y)).hom one_Y)
          rw [hm]
          rfl
        have hz_GY : (0 : Fℓ_Y ⟶ Gm_Y).hom.app (Opposite.op T_Y) = 0 := ev_GY.map_zero Fℓ_Y Gm_Y
        rw [hnsmul_GY, h0_Y, hz_GY]
        exact r_hom.map_zero
      calc
        u_Y ^ ℓ = Additive.toMul (ℓ • u_Y_add) := (toMul_nsmul ℓ u_Y_add).symm
        _ = Additive.toMul 0 := congrArg Additive.toMul h0
        _ = 1 := toMul_zero

    
    let ηℓ_0 := CategoryTheory.Functor.whiskerLeft B_h.op (shAdj_C.unit.app Pℓ_C)
    let u_ℓ := (shAdj_Y.homEquiv Pℓ_Y (pf_h.obj Fℓ_C)).symm ηℓ_0
    have hadj_comm : u_ℓ ≫ pf_h.map (α ≫ ι_kum_C) = ι_kum_Y ≫ u_Gm := by
      have h1 := congrArg (adj_h.homEquiv Fℓ_Y Gm_C) hc_ℓ_comm
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.Adjunction.homEquiv_naturality_left] at h1
      have hc1 : adj_h.homEquiv Fℓ_Y Fℓ_C c_ℓ = u_ℓ := Equiv.apply_symm_apply _ u_ℓ
      have hc2 : adj_h.homEquiv Gm_Y Gm_C c_Gm = u_Gm := Equiv.apply_symm_apply _ u_Gm
      rwa [hc1, hc2] at h1
    have hu_ℓ_unit : shAdj_Y.unit.app Pℓ_Y ≫ u_ℓ.hom = ηℓ_0 :=
      (shAdj_Y.homEquiv_unit Pℓ_Y (pf_h.obj Fℓ_C) u_ℓ).symm.trans
        (Equiv.apply_symm_apply (shAdj_Y.homEquiv Pℓ_Y (pf_h.obj Fℓ_C)) ηℓ_0)
    have hu_Gm_unit : η_GY ≫ u_Gm.hom = θ_Gm ≫ η_Gm :=
      (shAdj_Y.homEquiv_unit (weilEtaleGmPresheaf Y) (pf_h.obj Gm_C) u_Gm).symm.trans
        (Equiv.apply_symm_apply (shAdj_Y.homEquiv (weilEtaleGmPresheaf Y) (pf_h.obj Gm_C)) (θ_Gm ≫ η_Gm))
    have hι_Y_fac : ι_kum_Y.hom = ι_kum_Y.hom ≫ r_GY.hom ≫ η_GY := by
      have h1 : ι_kum_Y = ι_kum_Y ≫ (r_GY ≫ s_GY) := by
        rw [hr_s_GY, CategoryTheory.Category.comp_id]
      exact congrArg (fun k : Fℓ_Y ⟶ Gm_Y => k.hom) h1
    have hpre_comm : ηℓ_0 ≫ (pf_h.map (α ≫ ι_kum_C)).hom =
        shAdj_Y.unit.app Pℓ_Y ≫ ι_kum_Y.hom ≫ r_GY.hom ≫ θ_Gm ≫ η_Gm := by
      have h1 : (shAdj_Y.unit.app Pℓ_Y ≫ u_ℓ.hom) ≫ (pf_h.map (α ≫ ι_kum_C)).hom =
          shAdj_Y.unit.app Pℓ_Y ≫ ι_kum_Y.hom ≫ u_Gm.hom :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (shAdj_Y.unit.app Pℓ_Y ≫ ·)
            (congrArg (fun m : Fℓ_Y ⟶ pf_h.obj Gm_C => m.hom) hadj_comm))
      have h2 : ι_kum_Y.hom ≫ u_Gm.hom = ι_kum_Y.hom ≫ r_GY.hom ≫ θ_Gm ≫ η_Gm :=
        (congrArg (· ≫ u_Gm.hom) hι_Y_fac).trans
          ((CategoryTheory.Category.assoc ι_kum_Y.hom (r_GY.hom ≫ η_GY) u_Gm.hom).trans
            (congrArg (ι_kum_Y.hom ≫ ·)
              ((CategoryTheory.Category.assoc r_GY.hom η_GY u_Gm.hom).trans
                (congrArg (r_GY.hom ≫ ·) hu_Gm_unit))))
      exact (congrArg (· ≫ (pf_h.map (α ≫ ι_kum_C)).hom) hu_ℓ_unit.symm).trans
        (h1.trans (congrArg (shAdj_Y.unit.app Pℓ_Y ≫ ·) h2))
    have hev_BT := congrArg (fun ν : Pℓ_Y ⟶ (pf_h.obj Gm_C).obj =>
      (r_GC.hom.app (Opposite.op (B_h.obj T_Y))).hom
        ((ν.app (Opposite.op T_Y)).hom (ULift.up (1 : ZMod ℓ)))) hpre_comm
    have hη_r_BT : ∀ z : ↥((weilEtaleGmPresheaf C.left).obj (Opposite.op (B_h.obj T_Y))),
        (r_GC.hom.app (Opposite.op (B_h.obj T_Y))).hom
          (((shAdj_C.unit.app (weilEtaleGmPresheaf C.left)).app (Opposite.op (B_h.obj T_Y))).hom z) = z :=
      fun z => congrArg (fun ν => (ν.app (Opposite.op (B_h.obj T_Y))).hom z) hs_r_GC
    change (r_GC.hom.app (Opposite.op (B_h.obj T_Y))).hom
        (((α ≫ ι_kum_C).hom.app (Opposite.op (B_h.obj T_Y))).hom
          (((shAdj_C.unit.app Pℓ_C).app (Opposite.op (B_h.obj T_Y))).hom (ULift.up (1 : ZMod ℓ)))) =
      (r_GC.hom.app (Opposite.op (B_h.obj T_Y))).hom
        (((shAdj_C.unit.app (weilEtaleGmPresheaf C.left)).app (Opposite.op (B_h.obj T_Y))).hom
          ((θ_Gm.app (Opposite.op T_Y)).hom u_Y_add)) at hev_BT
    rw [hη_r_BT] at hev_BT

    
    have hpull_σ := congrArg ((weilEtaleGmPresheaf C.left).map σ_T.op).hom hev_BT
    have hLHS_σ : ((weilEtaleGmPresheaf C.left).map σ_T.op).hom
        ((r_GC.hom.app (Opposite.op (B_h.obj T_Y))).hom
          (((α ≫ ι_kum_C).hom.app (Opposite.op (B_h.obj T_Y))).hom
            (((shAdj_C.unit.app Pℓ_C).app (Opposite.op (B_h.obj T_Y))).hom (ULift.up (1 : ZMod ℓ))))) = 0 := by
      have hnat_comp := ((shAdj_C.unit.app Pℓ_C) ≫ (α ≫ ι_kum_C).hom ≫ r_GC.hom).naturality σ_T.op
      have heval : ((weilEtaleGmPresheaf C.left).map σ_T.op).hom
          ((r_GC.hom.app (Opposite.op (B_h.obj T_Y))).hom
            (((α ≫ ι_kum_C).hom.app (Opposite.op (B_h.obj T_Y))).hom
              (((shAdj_C.unit.app Pℓ_C).app (Opposite.op (B_h.obj T_Y))).hom (ULift.up (1 : ZMod ℓ))))) =
          (r_GC.hom.app (Opposite.op T_C)).hom
            ((ι_kum_C.hom.app (Opposite.op T_C)).hom ((α.hom.app (Opposite.op T_C)).hom one_C)) :=
        congrArg (fun k : Aℓ ⟶ (weilEtaleGmPresheaf C.left).obj (Opposite.op T_C) =>
          k.hom (ULift.up (1 : ZMod ℓ))) hnat_comp.symm
      rw [heval, hα0, map_zero, map_zero]
    rw [hLHS_σ] at hpull_σ
    have hh_triv : Units.map h.appTop.hom.toMonoidHom u_Y = 1 := by
      have hmul := congrArg Additive.toMul hpull_σ.symm
      apply Units.ext
      have hval : (σ_left.appTop).hom (((CategoryTheory.Limits.pullback.fst id_Y h).appTop).hom u_Y.val) = 1 :=
        congrArg Units.val hmul
      have hσ_fst : σ_left ≫ CategoryTheory.Limits.pullback.fst id_Y h = h :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have happ_h : (CategoryTheory.Limits.pullback.fst id_Y h).appTop ≫ σ_left.appTop = h.appTop :=
        (AlgebraicGeometry.Scheme.Hom.comp_appTop σ_left
          (CategoryTheory.Limits.pullback.fst id_Y h)).symm.trans
          (congrArg AlgebraicGeometry.Scheme.Hom.appTop hσ_fst)
      exact (congrArg (fun φ => φ.hom u_Y.val) happ_h).symm.trans hval

    
    let σ_Y : ↑(Y.presheaf.obj (Opposite.op ⊤)) := u_Y.val
    have hσ_pow : σ_Y ^ ℓ = 1 := congrArg Units.val hu_Y_pow
    have hh_val : h.appTop.hom σ_Y = 1 := congrArg Units.val hh_triv
    have hh_σ : h.appTop.hom (σ_Y - 1) = 0 := by
      rw [map_sub, map_one, hh_val, sub_self]
    let y₀ : ↥Y := h c₀
    let R_y₀ := ↑(Y.presheaf.stalk y₀)
    let m_y₀ := IsLocalRing.maximalIdeal R_y₀
    let germ_y₀ := (Y.presheaf.germ ⊤ y₀ trivial).hom
    let g_y₀ : R_y₀ := germ_y₀ σ_Y
    have hg1_mem : g_y₀ - 1 ∈ m_y₀ := by
      by_contra hnot
      have hunit : IsUnit (germ_y₀ (σ_Y - 1)) := by
        rw [map_sub, map_one]
        exact IsLocalRing.notMem_maximalIdeal.mp hnot
      have hmap_u : IsUnit ((AlgebraicGeometry.Scheme.Hom.stalkMap h c₀).hom (germ_y₀ (σ_Y - 1))) :=
        hunit.map (AlgebraicGeometry.Scheme.Hom.stalkMap h c₀).hom
      rw [AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply h ⊤ c₀ trivial (σ_Y - 1)] at hmap_u
      have happ_top : (h.app ⊤).hom (σ_Y - 1) = 0 := hh_σ
      rw [happ_top, map_zero] at hmap_u
      exact not_isUnit_zero hmap_u
    have hgi_mem : ∀ i : ℕ, g_y₀ ^ i - 1 ∈ m_y₀ := by
      intro i
      induction i with
      | zero =>
        rw [pow_zero, sub_self]
        exact m_y₀.zero_mem
      | succ i ih =>
        have hdecomp : g_y₀ ^ (i + 1) - 1 = g_y₀ * (g_y₀ ^ i - 1) + (g_y₀ - 1) := by ring
        rw [hdecomp]
        exact m_y₀.add_mem (m_y₀.mul_mem_left g_y₀ ih) hg1_mem
    let s_Y : ↑(Y.presheaf.obj (Opposite.op ⊤)) := ∑ i ∈ Finset.range ℓ, σ_Y ^ i
    have hs_mul : s_Y * (σ_Y - 1) = 0 := by
      dsimp only [s_Y]
      rw [geom_sum_mul, hσ_pow, sub_self]
    have hs_diff : germ_y₀ s_Y - (ℓ : R_y₀) ∈ m_y₀ := by
      have heq : germ_y₀ s_Y - (ℓ : R_y₀) = ∑ i ∈ Finset.range ℓ, (g_y₀ ^ i - 1) := by
        dsimp only [s_Y, g_y₀]
        rw [map_sum, Finset.sum_sub_distrib]
        simp [map_pow]
      rw [heq]
      exact Ideal.sum_mem m_y₀ (fun i _ => hgi_mem i)
    let ρ_k : k →+* R_y₀ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        f_Y.appTop ≫ Y.presheaf.germ ⊤ y₀ trivial).hom
    have hℓ_unit : IsUnit (ℓ : R_y₀) := by
      have hmul1 : (ℓ : R_y₀) * ρ_k (ℓ : k)⁻¹ = 1 := by
        rw [← map_natCast ρ_k ℓ, ← map_mul, mul_inv_cancel₀ hℓ, map_one]
      exact ⟨⟨(ℓ : R_y₀), ρ_k (ℓ : k)⁻¹, hmul1, mul_comm (ρ_k (ℓ : k)⁻¹) (ℓ : R_y₀) ▸ hmul1⟩, rfl⟩
    have hs_unit : IsUnit (germ_y₀ s_Y) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hs_in
      have hℓ_in : (ℓ : R_y₀) ∈ m_y₀ := by
        have hsub : (ℓ : R_y₀) = germ_y₀ s_Y - (germ_y₀ s_Y - (ℓ : R_y₀)) := by ring
        rw [hsub]
        exact m_y₀.sub_mem hs_in hs_diff
      exact (IsLocalRing.notMem_maximalIdeal.mpr hℓ_unit) hℓ_in

    let U_Y : Y.Opens := Y.basicOpen s_Y
    have hy₀_mem : y₀ ∈ U_Y := (Y.mem_basicOpen s_Y y₀ trivial).mpr hs_unit
    have hUY_ne : Nonempty ↥U_Y.toScheme := ⟨⟨y₀, hy₀_mem⟩⟩
    have hUY_triv : Units.map U_Y.ι.appTop.hom.toMonoidHom u_Y = 1 := by
      apply Units.ext
      change U_Y.ι.appTop.hom σ_Y = 1
      apply TopCat.Presheaf.section_ext U_Y.toScheme.sheaf ⊤ (U_Y.ι.appTop.hom σ_Y) 1
      intro q hq
      have hy_in : U_Y.ι q ∈ U_Y :=
        Eq.mp (congrArg (· ∈ U_Y) (U_Y.ι_apply q).symm) q.2
      have hunit_q : IsUnit ((Y.presheaf.germ ⊤ (U_Y.ι q) trivial).hom s_Y) :=
        (Y.mem_basicOpen s_Y (U_Y.ι q) trivial).mp hy_in
      have hmul_q : ((Y.presheaf.germ ⊤ (U_Y.ι q) trivial).hom s_Y) *
          ((Y.presheaf.germ ⊤ (U_Y.ι q) trivial).hom (σ_Y - 1)) = 0 := by
        rw [← map_mul, hs_mul, map_zero]
      have hdiff_q : (Y.presheaf.germ ⊤ (U_Y.ι q) trivial).hom (σ_Y - 1) = 0 :=
        hunit_q.mul_right_eq_zero.mp hmul_q
      have hgerm_eq : (Y.presheaf.germ ⊤ (U_Y.ι q) trivial).hom σ_Y = 1 := by
        rw [map_sub, map_one] at hdiff_q
        exact sub_eq_zero.mp hdiff_q
      have hstalk := AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply U_Y.ι ⊤ q trivial σ_Y
      have h_lhs : (U_Y.toScheme.presheaf.germ ⊤ q hq).hom (U_Y.ι.appTop.hom σ_Y) =
          (AlgebraicGeometry.Scheme.Hom.stalkMap U_Y.ι q).hom
            ((Y.presheaf.germ ⊤ (U_Y.ι q) trivial).hom σ_Y) := hstalk.symm
      exact h_lhs.trans
        ((congrArg (AlgebraicGeometry.Scheme.Hom.stalkMap U_Y.ι q).hom hgerm_eq).trans
          ((map_one (AlgebraicGeometry.Scheme.Hom.stalkMap U_Y.ι q).hom).trans
            (map_one (U_Y.toScheme.presheaf.germ ⊤ q hq).hom).symm))

    
    let E_UY : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U_Y.ι
      (inferInstance : AlgebraicGeometry.Etale U_Y.ι)
    let j_UY : E_UY ⟶ T_Y := hT_Y.from E_UY
    let one_UY : ↥(Fℓ_Y.obj.obj (Opposite.op E_UY)) := (Fℓ_Y.obj.map j_UY.op).hom one_Y
    have hι_one_UY : (ι_kum_Y.hom.app (Opposite.op E_UY)).hom one_UY = 0 := by
      have hret_UY : ∀ w : ↥(Gm_Y.obj.obj (Opposite.op E_UY)),
          (s_GY.hom.app (Opposite.op E_UY)).hom ((r_GY.hom.app (Opposite.op E_UY)).hom w) = w :=
        fun w => congrArg (fun k : Gm_Y ⟶ Gm_Y => (k.hom.app (Opposite.op E_UY)).hom w) hr_s_GY
      rw [← hret_UY ((ι_kum_Y.hom.app (Opposite.op E_UY)).hom one_UY)]
      have hnat := congrArg (fun k => k.hom one_Y) ((ι_kum_Y.hom ≫ r_GY.hom).naturality j_UY.op)
      change (r_GY.hom.app (Opposite.op E_UY)).hom ((ι_kum_Y.hom.app (Opposite.op E_UY)).hom one_UY) =
        ((weilEtaleGmPresheaf Y).map j_UY.op).hom u_Y_add at hnat
      have hj_triv : ((weilEtaleGmPresheaf Y).map j_UY.op).hom u_Y_add = 0 :=
        congrArg Additive.ofMul hUY_triv
      rw [hnat, hj_triv, map_zero]

    have : CategoryTheory.Mono ι_kum_Y := hSE_Y.mono_f
    let L_EUY := CategoryTheory.Sheaf.freeYoneda J_Y E_UY Aℤ
    have hEquiv_comp : ∀ {F G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
        (β : L_EUY ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (β ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv β ≫ g.hom.app (Opposite.op E_UY) := by
      intro F G β g
      let β' : (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda E_UY Aℤ) ⟶ F := β
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv ((shAdj_Y.homEquiv _ G) (β' ≫ g))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              ((shAdj_Y.homEquiv _ F) β' ≫
                (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}).map g) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv β ≫ g.hom.app (Opposite.op E_UY) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _
    let z_one : Aℤ ⟶ Fℓ_Y.obj.obj (Opposite.op E_UY) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • one_UY
          map_zero' := zero_zsmul one_UY
          map_add' := fun a b => add_zsmul one_UY a.down b.down }
    let β_one : L_EUY ⟶ Fℓ_Y := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm z_one
    have hβ_comp : β_one ≫ ι_kum_Y = 0 ≫ ι_kum_Y := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquiv_comp, hEquiv_comp, Equiv.apply_symm_apply]
      apply AddCommGrpCat.ext
      rintro ⟨z⟩
      change (ι_kum_Y.hom.app (Opposite.op E_UY)).hom (z • one_UY) =
        (ι_kum_Y.hom.app (Opposite.op E_UY)).hom
          ((CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L_EUY ⟶ Fℓ_Y)).hom (ULift.up z))
      have hz0 : CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L_EUY ⟶ Fℓ_Y) = 0 := by
        have h0_eq := hEquiv_comp (CategoryTheory.CategoryStruct.id L_EUY) (0 : L_EUY ⟶ Fℓ_Y)
        have hm0 : (0 : L_EUY ⟶ Fℓ_Y).hom.app (Opposite.op E_UY) = 0 :=
          (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u} ⋙
            (CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj
              (Opposite.op E_UY)).map_zero L_EUY Fℓ_Y
        rw [CategoryTheory.Category.id_comp, hm0, CategoryTheory.Limits.comp_zero] at h0_eq
        exact h0_eq
      rw [hz0, map_zsmul, hι_one_UY, smul_zero]
      exact (map_zero (ι_kum_Y.hom.app (Opposite.op E_UY)).hom).symm
    have hβ_zero : β_one = 0 := (cancel_mono ι_kum_Y).mp hβ_comp
    have hz_zero : z_one = 0 := by
      calc
        z_one = CategoryTheory.Sheaf.freeYonedaHomEquiv β_one := (Equiv.apply_symm_apply _ _).symm
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv 0 := by rw [hβ_zero]
        _ = 0 := by
          have h0_eq := hEquiv_comp (CategoryTheory.CategoryStruct.id L_EUY) (0 : L_EUY ⟶ Fℓ_Y)
          have hm0 : (0 : L_EUY ⟶ Fℓ_Y).hom.app (Opposite.op E_UY) = 0 :=
            (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u} ⋙
              (CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj
                (Opposite.op E_UY)).map_zero L_EUY Fℓ_Y
          rw [CategoryTheory.Category.id_comp, hm0, CategoryTheory.Limits.comp_zero] at h0_eq
          exact h0_eq
    have hone_UY_zero : one_UY = 0 := by
      have h1 := congrArg (fun k : Aℤ ⟶ _ => k.hom (ULift.up 1)) hz_zero
      simpa [z_one] using h1
    exact (hLocConst Y).1 U_Y hUY_ne hone_UY_zero

  have : CategoryTheory.IsIso α := (hLocConst C.left).2 α hα_ne

  
  have hExt_nsmul : ∀ (n : ℕ) (v : Gm_C.H 0),
      v.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id Gm_C))
        (Nat.add_zero 0) = n • v := by
    intro n v
    induction n with
    | zero =>
      rw [zero_smul, zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]

  let w_0 : Fℓ_C.H 1 :=
    ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
      ((pb_h.mapExtAddHom Fℤ_Y Fℓ_Y 1) γ_Y) (Nat.zero_add 1)).comp
      (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 1)

  have hw_comp_ι : (w_0.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero 1)).comp
      (CategoryTheory.Abelian.Ext.mk₀ ι_kum_C) (Nat.add_zero 1) = 0 := by
    have h1 : (((CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).comp
        ((pb_h.mapExtAddHom Fℤ_Y Gm_Y 1)
          (γ_Y.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum_Y) (Nat.add_zero 1)))
        (Nat.zero_add 1)).comp (CategoryTheory.Abelian.Ext.mk₀ c_Gm) (Nat.add_zero 1)) = 0 := hGm0
    rw [hinv_cℤ, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Functor.mapExtAddHom_apply] at h1
    rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        ((pb_h.mapExtAddHom Fℤ_Y Fℓ_Y 1) γ_Y)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_h.map ι_kum_Y))
        (Nat.zero_add 1) (Nat.add_zero 1) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc _
        (CategoryTheory.Abelian.Ext.mk₀ (pb_h.map ι_kum_Y))
        (CategoryTheory.Abelian.Ext.mk₀ c_Gm)
        (Nat.add_zero 1) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hComm,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ πM (α ≫ ι_kum_C),
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ α ι_kum_C,
      ← CategoryTheory.Abelian.Ext.comp_assoc _
        (CategoryTheory.Abelian.Ext.mk₀ πM)
        ((CategoryTheory.Abelian.Ext.mk₀ α).comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum_C)
          (Nat.add_zero 0))
        (Nat.add_zero 1) (Nat.add_zero 0) (by omega),
      ← CategoryTheory.Abelian.Ext.comp_assoc w_0
        (CategoryTheory.Abelian.Ext.mk₀ α)
        (CategoryTheory.Abelian.Ext.mk₀ ι_kum_C)
        (Nat.add_zero 1) (Nat.add_zero 0) (by omega)] at h1
    exact h1

  obtain ⟨u, hu⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hSE_C
    (w_0.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero 1)) hw_comp_ι (Nat.zero_add 1)
  let u' : Gm_C.H 0 := u
  obtain ⟨v, hv⟩ := hDivC u'
  have hu_eq : u' = v.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum_C) (Nat.add_zero 0) :=
    hv.symm.trans ((hExt_nsmul ℓ v).symm.trans
      (congrArg (fun φ => v.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) hp_C_eq.symm))
  have hw_α_zero : w_0.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero 1) = 0 := by
    have hu' : u'.comp hSE_C.extClass (Nat.zero_add 1) =
        w_0.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero 1) := hu
    rw [← hu', hu_eq, CategoryTheory.Abelian.Ext.comp_assoc v
      (CategoryTheory.Abelian.Ext.mk₀ p_kum_C) hSE_C.extClass
      (Nat.add_zero 0) (Nat.zero_add 1) (by omega)]
    have hp_ext : (CategoryTheory.Abelian.Ext.mk₀ p_kum_C).comp hSE_C.extClass (Nat.zero_add 1) = 0 :=
      hSE_C.comp_extClass
    rw [hp_ext, CategoryTheory.Abelian.Ext.comp_zero]

  have hw_0_zero : w_0 = 0 := by
    have hpost := congrArg
      (fun z : Fℓ_C.H 1 => z.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv α))
        (Nat.add_zero 1)) hw_α_zero
    dsimp only at hpost
    rw [CategoryTheory.Abelian.Ext.zero_comp,
      CategoryTheory.Abelian.Ext.comp_assoc w_0
        (CategoryTheory.Abelian.Ext.mk₀ α)
        (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv α))
        (Nat.add_zero 1) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.IsIso.hom_inv_id,
      CategoryTheory.Abelian.Ext.comp_mk₀_id] at hpost
    exact hpost

  rw [hp_h_eq γ_Y]
  exact hw_0_zero

theorem weil_projLine_cover_kummer_lift_to_zariski_torsion_cocycle (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (A : Type u) [CommRing A] [Algebra k A]
    (τ_A : A →ₐ[k] k)
    (Y_A : AlgebraicGeometry.Scheme.{u})
    (π_A : Quiver.Hom Y_A
      (CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom))
    [AlgebraicGeometry.IsFinite π_A]
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (i_C₀ : Quiver.Hom C₀.left Y_A)
    (γ_bar : weilEtaleTorsionH C₀.left ℓ 1)
    (hPb_C₀_A : CategoryTheory.IsPullback C₀.hom i_C₀
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
      (CategoryTheory.CategoryStruct.comp π_A
        (CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
          (weilProjectiveSpaceOver k 1).hom)))
    (hSurj_YA : WeilEtaleCohomologyPullbackSurjective
      (CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom))
        (CategoryTheory.CategoryStruct.comp π_A
          (CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
            (weilProjectiveSpaceOver k 1).hom)))
      (weilEtaleTorsionSheaf Y_A ℓ) 1) :
    ∃ (N : ℕ) (_ : 1 ≤ N)
      (U : Fin N → Y_A.Opens)
      (u : ∀ a : Fin N, Units ↑(Y_A.presheaf.obj (Opposite.op (U a))))
      (g : ∀ a b : Fin N, Units ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))),
      (⨆ a : Fin N, U a) = ⊤ ∧
      (∀ a : Fin N, AlgebraicGeometry.IsAffineOpen (U a)) ∧
      (∀ a : Fin N, (g a a : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U a)))) = 1) ∧
      (∀ a b c : Fin N,
        (Y_A.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.1.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U a ⊓ U b)).op).hom
          (g a b : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))) *
        (Y_A.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.2, hx.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U b ⊓ U c)).op).hom
          (g b c : ↑(Y_A.presheaf.obj (Opposite.op (U b ⊓ U c)))) =
        (Y_A.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.2⟩ : (U a ⊓ U b) ⊓ U c ≤ U a ⊓ U c)).op).hom
          (g a c : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U c))))) ∧
      (∀ a b : Fin N,
        ((g a b : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))) ^ ℓ) *
        (Y_A.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => hx.2 : U a ⊓ U b ≤ U b)).op).hom
          (u b : ↑(Y_A.presheaf.obj (Opposite.op (U b)))) =
        (Y_A.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => hx.1 : U a ⊓ U b ≤ U a)).op).hom
          (u a : ↑(Y_A.presheaf.obj (Opposite.op (U a))))) ∧
      (∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral C.left →
        IsProjectiveOverField k C →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
          (ν : Quiver.Hom C.left C₀.left),
          CategoryTheory.CategoryStruct.comp ν C₀.hom = C.hom →
          (∃ w : ∀ a : Fin N,
              Units ↑(C.left.presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map
                  (CategoryTheory.CategoryStruct.comp ν i_C₀).base).obj (U a)))),
            ∀ a b : Fin N,
              (C.left.presheaf.map (CategoryTheory.homOfLE
                (fun _ hx => hx.1 :
                  (TopologicalSpace.Opens.map
                    (CategoryTheory.CategoryStruct.comp ν i_C₀).base).obj (U a ⊓ U b) ≤
                  (TopologicalSpace.Opens.map
                    (CategoryTheory.CategoryStruct.comp ν i_C₀).base).obj (U a))).op).hom
                (w a).1 =
              ((CategoryTheory.CategoryStruct.comp ν i_C₀).app (U a ⊓ U b)).hom
                (g a b : ↑(Y_A.presheaf.obj (Opposite.op (U a ⊓ U b)))) *
              (C.left.presheaf.map (CategoryTheory.homOfLE
                (fun _ hx => hx.2 :
                  (TopologicalSpace.Opens.map
                    (CategoryTheory.CategoryStruct.comp ν i_C₀).base).obj (U a ⊓ U b) ≤
                  (TopologicalSpace.Opens.map
                    (CategoryTheory.CategoryStruct.comp ν i_C₀).base).obj (U b))).op).hom
                (w b).1) →
          ∃ p_ν : weilEtaleTorsionH C₀.left ℓ 1 →+ weilEtaleTorsionH C.left ℓ 1,
            WeilIsTorsionEtalePullback ν ℓ 1 p_ν ∧
            p_ν γ_bar = 0) :=
by
  classical
  
  let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
  let P1 := weilProjectiveSpaceOver k 1
  let p_A := CategoryTheory.Limits.pullback.fst s_A P1.hom
  let f_YA := π_A ≫ p_A
  let f_YA_k : Y_A ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := f_YA ≫ s_A
  let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
  let i_YA := CategoryTheory.Limits.pullback.snd ι_A f_YA

  have hι_s : ι_A ≫ s_A = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    dsimp [ι_A, s_A]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, τ_A.comp_algebraMap]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of k)

  have hi_C₀_k : i_C₀ ≫ f_YA_k = C₀.hom := by
    dsimp [f_YA_k]
    rw [← CategoryTheory.Category.assoc, ← hPb_C₀_A.w, CategoryTheory.Category.assoc,
      hι_s, CategoryTheory.Category.comp_id]

  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨hSurjBridge, hClosedTwoChart⟩ :=
    weil_torsion_pullback_surj_and_closedImmersion_twoChart_cover.{u}

  let e₀ := hPb_C₀_A.isoPullback
  have he₀_snd : e₀.hom ≫ i_YA = i_C₀ := hPb_C₀_A.isoPullback_hom_snd

  obtain ⟨p_iYA, hp_iYA⟩ := hPullEx i_YA ℓ 1
  obtain ⟨p_iC₀, hp_iC₀⟩ := hPullEx i_C₀ ℓ 1
  obtain ⟨p_eHom, hp_eHom⟩ := hPullEx e₀.hom ℓ 1
  obtain ⟨p_eInv, hp_eInv⟩ := hPullEx e₀.inv ℓ 1
  obtain ⟨p_idC₀, hp_idC₀⟩ := hPullEx (CategoryTheory.CategoryStruct.id C₀.left) ℓ 1

  have hSurj_p : Function.Surjective p_iYA :=
    hSurjBridge i_YA ℓ 1 hSurj_YA p_iYA hp_iYA
  obtain ⟨γ_A, hγ_A_raw⟩ := hSurj_p (p_eInv γ_bar)

  have hp_iC₀_eq : p_iC₀ = p_eHom.comp p_iYA :=
    hPullComp e₀.hom i_YA ℓ 1 p_eHom p_iYA p_iC₀ hp_eHom hp_iYA (he₀_snd.symm ▸ hp_iC₀)
  have hp_id_eq1 : p_idC₀ = p_eHom.comp p_eInv :=
    hPullComp e₀.hom e₀.inv ℓ 1 p_eHom p_eInv p_idC₀ hp_eHom hp_eInv (e₀.hom_inv_id.symm ▸ hp_idC₀)
  have hp_id_eq2 : p_idC₀ = AddMonoidHom.id _ :=
    hPullId ℓ 1 p_idC₀ hp_idC₀

  have hγ_A_lift : p_iC₀ γ_A = γ_bar := by
    rw [hp_iC₀_eq, AddMonoidHom.comp_apply, hγ_A_raw, ← AddMonoidHom.comp_apply,
      ← hp_id_eq1, hp_id_eq2, AddMonoidHom.id_apply]

  
  obtain ⟨C_emb, q_C, i_YC, D_C, D₀_C, red_C, _, hCl_iYC, _, _, hBridge⟩ :=
    weil_pbc_projLine_monic_twoChart_curve_embedding k A τ_A Y_A π_A
  obtain ⟨j₀_C, j₁_C, _, _, hj₀_open, hj₁_open, hCov_C, _, _, hPb_C, _⟩ := hBridge
  have : AlgebraicGeometry.IsClosedImmersion i_YC := hCl_iYC
  have : AlgebraicGeometry.IsOpenImmersion j₀_C := hj₀_open
  have : AlgebraicGeometry.IsOpenImmersion j₁_C := hj₁_open

  obtain ⟨V₀, V₁, hV₀, hV₁, _, _, hCov_Spec, hPb_Spec⟩ :=
    hClosedTwoChart i_YC D_C.R₀ D_C.R₁ D_C.R₀₁ j₀_C j₁_C hCov_C hPb_C

  let D_Y : WeilTwoChartRingDatum (ULift.{u} ℤ) :=
    { r := 0
      w := Fin.elim0
      R₀ := ↑(Y_A.presheaf.obj (Opposite.op V₀))
      R₁ := ↑(Y_A.presheaf.obj (Opposite.op V₁))
      R₀₁ := ↑(Y_A.presheaf.obj (Opposite.op (V₀ ⊓ V₁)))
      algPoly₀ := ((Int.castRingHom ↑(Y_A.presheaf.obj (Opposite.op V₀))).comp
        ((Polynomial.evalRingHom 0).comp
          (Polynomial.mapRingHom ULift.ringEquiv.toRingHom))).toAlgebra
      algPoly₁ := ((Int.castRingHom ↑(Y_A.presheaf.obj (Opposite.op V₁))).comp
        ((Polynomial.evalRingHom 0).comp
          (Polynomial.mapRingHom ULift.ringEquiv.toRingHom))).toAlgebra
      alg₀ := (Y_A.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom.toAlgebra
      alg₁ := (Y_A.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom.toAlgebra
      b₀ := Fin.elim0
      b₁ := Fin.elim0 }

  
  obtain ⟨hGmSheafY, ι_kum_Y, p_kum_Y, h0_Y, hp_Y_eq, hSE_Y⟩ :=
    weil_etale_kummer_mod_prime_short_exact k (CategoryTheory.Over.mk f_YA_k) ℓ hℓ

  let Fℤ_Y := (CategoryTheory.constantSheaf Y_A.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let ξ_A : (weilEtaleGmSheaf Y_A).H 1 :=
    (CategoryTheory.Abelian.Ext.mk₀ ι_kum_Y).postcomp Fℤ_Y (Nat.add_zero 1) γ_A

  have h_nsmul_ξ : ∀ n : ℕ,
      ξ_A.comp (CategoryTheory.Abelian.Ext.mk₀
        (n • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y_A))) (Nat.add_zero 1) =
        n • ξ_A := by
    intro n
    induction n with
    | zero =>
      rw [zero_smul, zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]

  have hp_Y_eq' : p_kum_Y = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y_A) :=
    hp_Y_eq

  have hℓ_ξ : ℓ • ξ_A = 0 := by
    rw [← h_nsmul_ξ ℓ, ← hp_Y_eq']
    change (γ_A.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum_Y) (Nat.add_zero 1)).comp
      (CategoryTheory.Abelian.Ext.mk₀ p_kum_Y) (Nat.add_zero 1) = 0
    rw [CategoryTheory.Abelian.Ext.comp_assoc γ_A _ _ (Nat.add_zero 1) (Nat.add_zero 0)
      (Nat.add_zero 1), CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h0_Y,
      CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  
  obtain ⟨cechCl, hCech1, hCech2, hCech3, hCech4⟩ :=
    weil_etale_cech_gm_H1_functorial_exact_and_twoChart_effacement.{u}
  obtain ⟨T₀, T₁, hCR₀, hCR₁, hAlg₀, hAlg₁, hEt₀, hEt₁, hSurj₀, hSurj₁, hEt_T, hw_T,
    c_T, hc_T_eq⟩ :=
    hCech4 Y_A D_Y.R₀ D_Y.R₁ hV₀.fromSpec hV₁.fromSpec hCov_Spec ξ_A
  letI : CommRing T₀ := hCR₀
  letI : CommRing T₁ := hCR₁
  letI : Algebra D_Y.R₀ T₀ := hAlg₀
  letI : Algebra D_Y.R₁ T₁ := hAlg₁
  have : Algebra.Etale D_Y.R₀ T₀ := hEt₀
  have : Algebra.Etale D_Y.R₁ T₁ := hEt₁

  obtain ⟨hFF₀, hFF₁, q_T, hMatch_T, hAlgCocyc_T⟩ :=
    weil_twoChart_etale_cech_cocycle_to_algCocycle Y_A D_Y hV₀.fromSpec hV₁.fromSpec
