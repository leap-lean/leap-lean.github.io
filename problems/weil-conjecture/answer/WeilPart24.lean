            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).hom := by
        rw [CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom σ),
          ← CategoryTheory.Category.assoc]
        congr 1
      exact congrArg (fun f => f.hom x) hmor
