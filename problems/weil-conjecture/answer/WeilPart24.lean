        (CategoryTheory.CategoryStruct.comp W_next_open.ι h_Y) := by
    change ((h_Y ∣_ P_cur.W_open) ≫ P_cur.e_W.inv) ≫ (P_cur.e_W.hom ≫ P_cur.W_open.ι) =
      𝟙 W_next_open.toScheme ≫ (W_next_open.ι ≫ h_Y)
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc P_cur.e_W.inv, P_cur.e_W.inv_hom_id,
