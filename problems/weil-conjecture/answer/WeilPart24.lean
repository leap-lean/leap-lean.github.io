    fun U y =>
      letI : IsDomain ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose
      letI : IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) := (hDVR_et U y).choose_spec
      (hOrd_ex ↑(U.left.presheaf.stalk y.1)
        (FractionRing ↑(U.left.presheaf.stalk y.1))).choose_spec
  let div_val : ∀ U : C.left.Etale,
      ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)) →+
        ({ y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } → ℤ) :=
    fun U => AddMonoidHom.pi fun y =>
