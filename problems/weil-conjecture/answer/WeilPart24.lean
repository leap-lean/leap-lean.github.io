    congr 1
    apply congrArg Additive.ofMul
    change (((Units.map (hAff_ov.isoSpec.inv.appTop).hom.toMonoidHom).comp
        (Units.map W₁₂.topIso.inv.hom.toMonoidHom)) u'_div) =
      Units.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R'₀₁)).inv.hom.toMonoidHom u'_div
    rw [← Units.map_comp]
    let e_ov := AlgebraicGeometry.Scheme.ΓSpecIso (Y'.presheaf.obj (Opposite.op W₁₂))
    have h_app : W₁₂.topIso.inv ≫ hAff_ov.isoSpec.inv.appTop = e_ov.inv := by
      have hhom := hAff_ov.isoSpec_hom_appTop
      have hcomp : hAff_ov.isoSpec.hom.appTop ≫ hAff_ov.isoSpec.inv.appTop = 𝟙 _ := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hAff_ov.isoSpec.inv_hom_id,
          AlgebraicGeometry.Scheme.Hom.id_appTop]
      rw [hhom, CategoryTheory.Category.assoc] at hcomp
      calc
        W₁₂.topIso.inv ≫ hAff_ov.isoSpec.inv.appTop
