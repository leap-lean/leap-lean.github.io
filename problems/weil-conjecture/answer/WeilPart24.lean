          refine ⟨algebraMap D T d * ↑uc⁻¹, ?_⟩
          rw [← mul_assoc, htd, ← huc, Units.mul_inv] }
    have hDomE : IsDomain E := e_ring.toMulEquiv.isDomain T
    have hFieldE : IsField E :=
      { exists_pair_ne := hDomE.toNontrivial.exists_pair_ne
        mul_comm := mul_comm
        mul_inv_cancel := fun {z} hz => by
          have hze : e_ring z ≠ 0 := fun h0 => hz (e_ring.injective (h0.trans e_ring.map_zero.symm))
          obtain ⟨w, hw⟩ := hField_T.mul_inv_cancel hze
          refine ⟨e_ring.symm w, e_ring.injective ?_⟩
