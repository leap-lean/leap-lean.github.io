        AlgebraicGeometry.Spec (CommRingCat.of L_Br) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_loc r))
    let sp_φtilde : AlgebraicGeometry.Spec (CommRingCat.of T_Zr) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of T_Br) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_tilde r))
    let sp_φring : AlgebraicGeometry.Spec (CommRingCat.of Z_ring) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_B) :=
