      rw [hs'₀_pt]
      exact hhV_B₀_pt pt_k

  have hLeg2 : (ι_test ≫ ν_R₁) ≫ CategoryTheory.Limits.pullback.snd f_YR₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀))) =
      h_test ≫ (f_YA ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BA.toRingHom)) := by
    have hmap_τA_ψ : map_τA ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BA.toRingHom) =
        map_τB₀ := by
      dsimp [map_τA, map_τB₀]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      exact congrArg
        (fun g : B₀ →ₐ[k] k => AlgebraicGeometry.Spec.map (CommRingCat.ofHom g.toRingHom)) hτA_ψ
    calc
      (ι_test ≫ ν_R₁) ≫ CategoryTheory.Limits.pullback.snd f_YR₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀)))
        = ι_C'₀ ≫ q_raw ≫ (ν_R₁ ≫ CategoryTheory.Limits.pullback.snd f_YR₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ B₀)))) := by
          dsimp [ι_test]; simp only [CategoryTheory.Category.assoc]
      _ = ι_C'₀ ≫ (q_raw ≫ ν ≫ CategoryTheory.Limits.pullback.snd P_cur.f_bar g_B₀) := by
          rw [← hν_snd_eq, CategoryTheory.Category.assoc]
      _ = (ι_C'₀ ≫ P_next.f_bar) ≫ h_V_B₀ := by
          rw [hq_raw_snd, CategoryTheory.Category.assoc]
      _ = C'₀.hom ≫ (s'₀ ≫ h_V_B₀) := by
          rw [hPb_C'₀.w, CategoryTheory.Category.assoc]
      _ = (ν₀ ≫ C₀.hom) ≫ map_τB₀ := by
          rw [hs'₀_B₀, hν₀_hom]
      _ = ν₀ ≫ (C₀.hom ≫ map_τA) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BA.toRingHom) := by
          rw [← hmap_τA_ψ]; simp only [CategoryTheory.Category.assoc]
      _ = ν₀ ≫ (i_C₀ ≫ f_YA) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BA.toRingHom) := by
          rw [hi_C₀_f]
      _ = h_test ≫ (f_YA ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_BA.toRingHom)) := by
          dsimp [h_test]; simp only [CategoryTheory.Category.assoc]

  obtain ⟨w_C'₀, hw_C'₀⟩ := hTriv_raw C'₀.left ι_test h_test hLeg1 hLeg2
  exact hKillCurve C'₀ hIntC'₀ hProjC'₀ ν₀ hν₀_hom ⟨w_C'₀, hw_C'₀⟩

theorem weil_rel_curve_two_open_principal_boundary_chart (k : Type u) [Field k] [IsAlgClosed k]
    (V₀ Y₀ : AlgebraicGeometry.Scheme.{u})
    (p_V₀ : Quiver.Hom V₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine V₀] [AlgebraicGeometry.IsIntegral V₀]
    [AlgebraicGeometry.LocallyOfFiniteType p_V₀]
    (v₀ : ↥V₀) (hv₀_cl : IsClosed ({v₀} : Set ↥V₀))
    (f₀ : Quiver.Hom Y₀ V₀)
    [AlgebraicGeometry.IsProper f₀] [AlgebraicGeometry.SmoothOfRelativeDimension 1 f₀]
    (hIntY₀ : AlgebraicGeometry.IsIntegral Y₀)
    (m : ℕ) (hm : 1 ≤ m)
    (τ₀ : Fin m → Quiver.Hom V₀ Y₀)
    (hτ₀_sec : ∀ a : Fin m, CategoryTheory.CategoryStruct.comp (τ₀ a) f₀ =
      CategoryTheory.CategoryStruct.id V₀)
    (hτ₀_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ₀ a))
    (hτ₀_disj : _root_.Pairwise fun a b : Fin m =>
      Disjoint (Set.range (τ₀ a).base) (Set.range (τ₀ b).base))
    (W₀_open : Y₀.Opens)
    (hAff_W₀ : AlgebraicGeometry.IsAffineOpen W₀_open)
    (hW₀_compl : (W₀_open : Set ↥Y₀) = (⋃ a : Fin m, Set.range (τ₀ a).base)ᶜ)
    (N : ℕ)
    (q_proj : Quiver.Hom Y₀ (weilProjectiveSpaceOver k N).left)
    (hq_proj_k : CategoryTheory.CategoryStruct.comp q_proj (weilProjectiveSpaceOver k N).hom =
      CategoryTheory.CategoryStruct.comp f₀ p_V₀)
    [AlgebraicGeometry.IsAffineHom q_proj] :
    ∃ (V₁ : AlgebraicGeometry.Scheme.{u})
      (j_V₁ : Quiver.Hom V₁ V₀)
      (v₁ : ↥V₁)
      (Y₁ : AlgebraicGeometry.Scheme.{u})
      (j_Y₁ : Quiver.Hom Y₁ Y₀)
      (f₁ : Quiver.Hom Y₁ V₁)
      (τ₁ : Fin m → Quiver.Hom V₁ Y₁)
      (U_in U_out : Y₁.Opens)
      (t_bdry : Fin m → ↑(Y₁.presheaf.obj (Opposite.op U_out))),
      AlgebraicGeometry.IsOpenImmersion j_V₁ ∧
      AlgebraicGeometry.IsAffine V₁ ∧
      AlgebraicGeometry.IsIntegral V₁ ∧
      IsClosed ({v₁} : Set ↥V₁) ∧
      j_V₁.base v₁ = v₀ ∧
      CategoryTheory.IsPullback j_Y₁ f₁ f₀ j_V₁ ∧
      AlgebraicGeometry.IsIntegral Y₁ ∧
      (∀ a : Fin m,
        CategoryTheory.CategoryStruct.comp (τ₁ a) f₁ = CategoryTheory.CategoryStruct.id V₁ ∧
        AlgebraicGeometry.IsClosedImmersion (τ₁ a) ∧
        CategoryTheory.CategoryStruct.comp (τ₁ a) j_Y₁ =
          CategoryTheory.CategoryStruct.comp j_V₁ (τ₀ a)) ∧
      (_root_.Pairwise fun a b : Fin m =>
        Disjoint (Set.range (τ₁ a).base) (Set.range (τ₁ b).base)) ∧
      U_in = (TopologicalSpace.Opens.map j_Y₁.base).obj W₀_open ∧
      (U_in : Set ↥Y₁) = (⋃ a : Fin m, Set.range (τ₁ a).base)ᶜ ∧
      AlgebraicGeometry.IsAffineOpen U_in ∧
      AlgebraicGeometry.IsAffineOpen U_out ∧
      U_in ⊔ U_out = ⊤ ∧
      (∀ a : Fin m,
        ∃ h_le : (⊤ : V₁.Opens) ≤ (TopologicalSpace.Opens.map (τ₁ a).base).obj U_out,
          RingHom.ker (((τ₁ a).appLE U_out ⊤ h_le).hom) = Ideal.span {t_bdry a} ∧
          (Y₁.basicOpen (t_bdry a) : Set ↥Y₁) =
            (U_out : Set ↥Y₁) \ Set.range (τ₁ a).base) :=
by
  classical
  
  
  
  have h_s1 : ∃ U_proj : (weilProjectiveSpaceOver k N).left.Opens,
      AlgebraicGeometry.IsAffineOpen U_proj ∧
        ∀ a : Fin m, q_proj.base ((τ₀ a).base v₀) ∈ U_proj := by
    haveI : Infinite k := IsAlgClosed.instInfinite
    let 𝒜 : ℕ → Submodule k (MvPolynomial (Fin (N + 1)) k) :=
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let z : Fin m → ↥(AlgebraicGeometry.Proj 𝒜) :=
      fun a => q_proj.base ((τ₀ a).base v₀)
    have h_exists_var : ∀ a : Fin m, ∃ i : Fin (N + 1),
        MvPolynomial.X i ∉ (z a).asHomogeneousIdeal := by
      intro a
      by_contra! h_all
      apply (z a).not_irrelevant_le
      intro p hp
      have hp0 : (GradedRing.proj 𝒜 0) p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      rw [GradedRing.proj_apply 𝒜 0 p] at hp0
      change p ∈ (z a).asHomogeneousIdeal.toIdeal
      rw [← DirectSum.sum_support_decompose 𝒜 p]
      apply Submodule.sum_mem ((z a).asHomogeneousIdeal.toIdeal)
      intro n _
      by_cases hn0 : n = 0
      · subst hn0
        rw [hp0]
        exact zero_mem _
      · let q : MvPolynomial (Fin (N + 1)) k := ↑((DirectSum.decompose 𝒜 p) n)
        have hq_hom : q.IsHomogeneous n :=
          (MvPolynomial.mem_homogeneousSubmodule n q).mp ((DirectSum.decompose 𝒜 p n).2)
        change q ∈ (z a).asHomogeneousIdeal.toIdeal
        rw [MvPolynomial.as_sum q]
        apply Submodule.sum_mem ((z a).asHomogeneousIdeal.toIdeal)
        intro d hd
        have hd_coeff : q.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hd_exists : ∃ j : Fin (N + 1), d j ≠ 0 := by
          by_contra! hd0
          have hd_zero : d = 0 := by
            ext j
            exact hd0 j
          subst hd_zero
          have h0n := hq_hom hd_coeff
          simp at h0n
          exact hn0 h0n.symm
        rcases hd_exists with ⟨j, hj⟩
        have h_add : d - Finsupp.single j 1 + Finsupp.single j 1 = d := by
          ext i
          simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
          by_cases hij : j = i
          · subst hij; simp; omega
          · simp [hij]
        have h_mon : MvPolynomial.monomial d (q.coeff d) =
            MvPolynomial.monomial (d - Finsupp.single j 1) (q.coeff d) * MvPolynomial.X j := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, h_add, mul_one]
        rw [h_mon]
        exact Ideal.mul_mem_left ((z a).asHomogeneousIdeal.toIdeal) _ (h_all j)
    let L : k → MvPolynomial (Fin (N + 1)) k :=
      fun t => ∑ j : Fin (N + 1), MvPolynomial.C (t ^ (j : ℕ)) * MvPolynomial.X j
    have hL_mem : ∀ t : k, L t ∈ 𝒜 1 := by
      intro t
      apply Submodule.sum_mem (𝒜 1)
      intro j _
      exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_C_mul_X (t ^ (j : ℕ)) j)
    let B : Fin m → Set k := fun a => {t : k | L t ∈ (z a).asHomogeneousIdeal.toIdeal}
    have hB_fin : ∀ a : Fin m, (B a).Finite := by
      intro a
      rcases h_exists_var a with ⟨i_a, hi_a⟩
      by_contra h_inf
      have h_inf' : (B a).Infinite := h_inf
      let η : ℕ ↪ B a := h_inf'.natEmbedding
      let v : Fin (N + 1) → k := fun r => (η r).1
      have hv_inj : Function.Injective v := by
        intro r₁ r₂ hv
        exact Fin.ext (η.injective (Subtype.ext hv))
      let V : Matrix (Fin (N + 1)) (Fin (N + 1)) k := Matrix.vandermonde v
      have hdet : V.det ≠ 0 := (Matrix.det_vandermonde_ne_zero_iff).mpr hv_inj
      have hUnitV : IsUnit V := (Matrix.isUnit_iff_isUnit_det V).mpr (Ne.isUnit hdet)
      rcases hUnitV with ⟨U_V, hUV⟩
      let W : Matrix (Fin (N + 1)) (Fin (N + 1)) k := ↑U_V⁻¹
      have hWV : W * V = 1 := by
        rw [← hUV]
        exact Units.inv_mul U_V
      have h_lin : ∑ r : Fin (N + 1), MvPolynomial.C (W i_a r) * L (v r) = MvPolynomial.X i_a := by
        calc
          ∑ r : Fin (N + 1), MvPolynomial.C (W i_a r) * L (v r)
            = ∑ r : Fin (N + 1), ∑ j : Fin (N + 1),
                MvPolynomial.C (W i_a r * v r ^ (j : ℕ)) * MvPolynomial.X j := by
              refine Finset.sum_congr rfl fun r _ => ?_
              dsimp only [L]
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← mul_assoc, ← MvPolynomial.C_mul]
          _ = ∑ j : Fin (N + 1),
                (∑ r : Fin (N + 1), MvPolynomial.C (W i_a r * v r ^ (j : ℕ))) * MvPolynomial.X j := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => (Finset.sum_mul _ _ _).symm
          _ = ∑ j : Fin (N + 1), MvPolynomial.C ((W * V) i_a j) * MvPolynomial.X j := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← map_sum]
              simp only [V, Matrix.mul_apply, Matrix.vandermonde]
              rfl
          _ = ∑ j : Fin (N + 1), MvPolynomial.C ((1 : Matrix _ _ k) i_a j) * MvPolynomial.X j := by
              rw [hWV]
          _ = MvPolynomial.X i_a := by
              have h_ite : ∀ j : Fin (N + 1),
                  MvPolynomial.C ((1 : Matrix (Fin (N + 1)) (Fin (N + 1)) k) i_a j) * MvPolynomial.X j =
                    if i_a = j then MvPolynomial.X j else 0 := by
                intro j
                rw [Matrix.one_apply]
                split_ifs <;> simp
              simp_rw [h_ite]
              simp
      apply hi_a
      change MvPolynomial.X i_a ∈ (z a).asHomogeneousIdeal.toIdeal
      rw [← h_lin]
      apply Submodule.sum_mem ((z a).asHomogeneousIdeal.toIdeal)
      intro r _
      exact Ideal.mul_mem_left ((z a).asHomogeneousIdeal.toIdeal) _ (η r).2
    have hBall_fin : (⋃ a : Fin m, B a).Finite := Set.finite_iUnion hB_fin
    rcases hBall_fin.exists_notMem with ⟨t_star, ht_star⟩
    refine ⟨AlgebraicGeometry.Proj.basicOpen 𝒜 (L t_star),
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (L t_star) (hL_mem t_star) Nat.zero_lt_one,
      fun a => ?_⟩
    exact (ProjectiveSpectrum.mem_basicOpen 𝒜 (L t_star) (z a)).mpr
      (fun hmem => ht_star (Set.mem_iUnion.mpr ⟨a, hmem⟩))

  
  
  
  have h_s2 : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsNoetherianRing R]
      (ι : A →+* R) (φ : R →+* A),
      φ.comp ι = RingHom.id A →
      ∀ (m_pt : Ideal R) [m_pt.IsPrime],
        RingHom.ker φ ≤ m_pt →
        ∀ (d₀ : R),
          d₀ ∉ m_pt →
          RingHom.IsStandardSmoothOfRelativeDimension 1
            ((algebraMap R (Localization.Away d₀)).comp ι) →
          ∃ g d : R,
            g ∈ RingHom.ker φ ∧ d ∉ m_pt ∧ ∀ x ∈ RingHom.ker φ, d * x ∈ Ideal.span {g} := by
    intro A R _ _ _ ι φ h_sec m_pt hm_prime h_ker_le d₀ hd₀ hSm
    let R₁ := Localization.Away d₀
    let ρ₁ : R →+* R₁ := algebraMap R R₁
    rcases hSm.exists_etale_mvPolynomial with ⟨ψ₀, hψ₀_C, hψ₀_et⟩
    let h₀_a : A := φ d₀
    let w₀ : R := ι h₀_a
    have hw₀ : w₀ ∉ m_pt := by
      have h_diff : w₀ - d₀ ∈ RingHom.ker φ := by
        rw [RingHom.mem_ker, map_sub]
        have h1 := RingHom.congr_fun h_sec h₀_a
        change (φ.comp ι) h₀_a - h₀_a = 0
        rw [h1, RingHom.id_apply, sub_self]
      intro hw_mem
      have hd_mem : d₀ ∈ m_pt := by
        have := m_pt.sub_mem hw_mem (h_ker_le h_diff)
        simpa using this
      exact hd₀ hd_mem
    let A' := Localization.Away h₀_a
    let R₂ := Localization.Away (ρ₁ w₀)
    let ρ₁₂ : R₁ →+* R₂ := algebraMap R₁ R₂
    let ρ₂ : R →+* R₂ := ρ₁₂.comp ρ₁
    have hu_φd₀ : IsUnit (((algebraMap A A').comp φ) d₀) :=
      IsLocalization.Away.algebraMap_isUnit h₀_a
    let φ₁ : R₁ →+* A' := IsLocalization.Away.lift d₀ hu_φd₀
    have hφ₁_eq : ∀ r : R, φ₁ (ρ₁ r) = algebraMap A A' (φ r) :=
      IsLocalization.Away.lift_eq d₀ hu_φd₀
    have hu_φ₁w₀ : IsUnit (φ₁ (ρ₁ w₀)) := by
      rw [hφ₁_eq w₀]
      have h1 := RingHom.congr_fun h_sec h₀_a
      change IsUnit (algebraMap A A' ((φ.comp ι) h₀_a))
      rw [h1, RingHom.id_apply]
      exact IsLocalization.Away.algebraMap_isUnit h₀_a
    let q_raw : R₂ →+* A' := IsLocalization.Away.lift (ρ₁ w₀) hu_φ₁w₀
    have hq_raw_R₁ : ∀ y : R₁, q_raw (ρ₁₂ y) = φ₁ y :=
      IsLocalization.Away.lift_eq (ρ₁ w₀) hu_φ₁w₀
    have hq_raw_R : ∀ r : R, q_raw (ρ₂ r) = algebraMap A A' (φ r) :=
      fun r => (hq_raw_R₁ (ρ₁ r)).trans (hφ₁_eq r)
    have hu_ιh₀ : IsUnit ((ρ₂.comp ι) h₀_a) :=
      IsLocalization.Away.algebraMap_isUnit (ρ₁ w₀)
    let ι₂ : A' →+* R₂ := IsLocalization.Away.lift h₀_a hu_ιh₀
    have hι₂_eq : ∀ a : A, ι₂ (algebraMap A A' a) = ρ₂ (ι a) :=
      IsLocalization.Away.lift_eq h₀_a hu_ιh₀
    have hq_ι₂ : q_raw.comp ι₂ = RingHom.id A' := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h₀_a)
      ext a
      simp only [RingHom.comp_apply, RingHom.id_apply, hι₂_eq, hq_raw_R]
      have h1 := RingHom.congr_fun h_sec a
      simpa using congrArg (algebraMap A A') h1
    let P := MvPolynomial (Fin 1) A
    let ψ₂ : P →+* R₂ := ρ₁₂.comp ψ₀
    let z : R₂ := ψ₂ (MvPolynomial.X 0) - ι₂ (q_raw (ψ₂ (MvPolynomial.X 0)))
    have hz_ker : z ∈ RingHom.ker q_raw := by
      rw [RingHom.mem_ker, map_sub]
      have h1 := RingHom.congr_fun hq_ι₂ (q_raw (ψ₂ (MvPolynomial.X 0)))
      exact sub_eq_zero.mpr (by simpa using h1.symm)
    have h_nak : ∃ r₂ : R₂, r₂ ∈ RingHom.ker q_raw ∧
        ∀ y ∈ RingHom.ker q_raw, (1 - r₂) * y ∈ Ideal.span {z} := by
      letI algPR₁ : Algebra P R₁ := ψ₀.toAlgebra
      haveI : Algebra.Etale P R₁ := RingHom.etale_algebraMap.mp hψ₀_et
      haveI : Algebra.FormallyUnramified P R₁ := inferInstance
      haveI : Algebra.FormallyUnramified R₁ R₂ :=
        Algebra.FormallyUnramified.of_isLocalization (Submonoid.powers (ρ₁ w₀))
      haveI : Algebra.FormallyUnramified P R₂ :=
        Algebra.FormallyUnramified.comp P R₁ R₂
      let I_z : Ideal R₂ := Ideal.span {z}
      let B := R₂ ⧸ I_z
      let π_B : R₂ →+* B := Ideal.Quotient.mk I_z
      have hFU_B : Algebra.FormallyUnramified P B :=
        Algebra.FormallyUnramified.of_surjective (Ideal.Quotient.mkₐ P I_z)
          Ideal.Quotient.mk_surjective
      let q_B : B →+* A' :=
        Ideal.Quotient.lift I_z q_raw (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hz_ker))
      let J : Ideal B := RingHom.ker q_B
      let σ_ring : B →+* B := π_B.comp (ι₂.comp q_B)
      have hσ_comm : σ_ring.comp (algebraMap P B) = algebraMap P B := by
        have halg_B : algebraMap P B = π_B.comp ψ₂ :=
          RingHom.ext fun p => by
            change π_B (algebraMap P R₂ p) = π_B (ψ₂ p)
            rw [IsScalarTower.algebraMap_apply P R₁ R₂ p]
            rfl
        rw [halg_B]
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, σ_ring]
          have hC : ψ₂ (MvPolynomial.C a) = ρ₂ (ι a) := by
            change ρ₁₂ ((ψ₀.comp MvPolynomial.C) a) = ρ₁₂ (ρ₁ (ι a))
            rw [hψ₀_C]; rfl
          rw [hC]
          change π_B (ι₂ (q_raw (ρ₂ (ι a)))) = π_B (ρ₂ (ι a))
          rw [hq_raw_R]
          have h1 := RingHom.congr_fun h_sec a
          change π_B (ι₂ (algebraMap A A' ((φ.comp ι) a))) = π_B (ρ₂ (ι a))
          rw [h1, RingHom.id_apply, hι₂_eq]
        · intro i
          have hi : i = 0 := Subsingleton.elim i 0
          subst hi
          simp only [RingHom.comp_apply, σ_ring]
          change π_B (ι₂ (q_raw (ψ₂ (MvPolynomial.X 0)))) = π_B (ψ₂ (MvPolynomial.X 0))
          have hz0 : π_B z = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          dsimp only [z] at hz0
          rw [map_sub] at hz0
          exact (sub_eq_zero.mp hz0).symm
      let σ_alg : B →ₐ[P] B :=
        { σ_ring with commutes' := fun p => RingHom.congr_fun hσ_comm p }
      let I_J2 : Ideal B := J * J
      let g₁ : B →ₐ[P] (B ⧸ I_J2) := Ideal.Quotient.mkₐ P I_J2
      let g₂ : B →ₐ[P] (B ⧸ I_J2) := g₁.comp σ_alg
      have hJ2_le : I_J2 ≤ RingHom.ker q_B :=
        Submodule.mul_le.mpr (fun u hu v _ => Ideal.mul_mem_right v J hu)
      let f_bar : (B ⧸ I_J2) →+* A' :=
        Ideal.Quotient.lift I_J2 q_B hJ2_le
      have hNil : IsNilpotent (RingHom.ker f_bar) := by
        refine ⟨2, ?_⟩
        change ((1 : Ideal (B ⧸ I_J2)) * RingHom.ker f_bar) * RingHom.ker f_bar = 0
        rw [Ideal.zero_eq_bot, eq_bot_iff]
        intro y hy
        refine Submodule.mul_induction_on hy ?_ ?_
        · intro u hu x' hx'
          have hu_ker : u ∈ RingHom.ker f_bar :=
            Submodule.mul_induction_on hu
              (fun c _ x hx => Ideal.mul_mem_left (RingHom.ker f_bar) c hx)
              (fun _ _ h1 h2 => add_mem h1 h2)
          rcases Ideal.Quotient.mk_surjective u with ⟨b, rfl⟩
          rcases Ideal.Quotient.mk_surjective x' with ⟨b', rfl⟩
          have hb : b ∈ J := hu_ker
          have hb' : b' ∈ J := hx'
          have hbb' : b * b' ∈ I_J2 := Ideal.mul_mem_mul hb hb'
          change Ideal.Quotient.mk I_J2 b * Ideal.Quotient.mk I_J2 b' ∈ (⊥ : Ideal (B ⧸ I_J2))
          rw [← RingHom.map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hbb']
          exact zero_mem _
        · intro u v hu hv
          exact add_mem hu hv
      have hg_comp : ∀ b : B, f_bar (g₁ b) = f_bar (g₂ b) := by
        intro b
        change q_B b = q_B (π_B (ι₂ (q_B b)))
        change q_B b = (q_raw.comp ι₂) (q_B b)
        rw [hq_ι₂, RingHom.id_apply]
      let instCR_R₂ : CommRing R₂ :=
        (inferInstance : CommRing (Localization.Away (ρ₁ w₀)))
      let instCR_B : CommRing B :=
        @Ideal.Quotient.commRing R₂ instCR_R₂ I_z
      let instCR_Q : CommRing (B ⧸ I_J2) :=
        @Ideal.Quotient.commRing B instCR_B I_J2
      have hg_eq : g₁ = g₂ :=
        @Algebra.FormallyUnramified.ext'
          P (inferInstance : CommRing (MvPolynomial (Fin 1) A))
          B instCR_B (Ideal.Quotient.algebra P)
          (B ⧸ I_J2) instCR_Q (Ideal.Quotient.algebra P)
          hFU_B
          A' (inferInstance : Ring (Localization.Away h₀_a))
          f_bar hNil g₁ g₂ hg_comp
      have hJ_idem : (J : Submodule B B) ≤ J • (J : Submodule B B) := by
        intro b hb
        have hb0 : q_B b = 0 := hb
        have hb_eq : g₁ b = g₂ b := congrArg (fun h => h b) hg_eq
        have hg₂0 : g₂ b = 0 := by
          change Ideal.Quotient.mk I_J2 (π_B (ι₂ (q_B b))) = 0
          rw [hb0, map_zero, map_zero, map_zero]
        rw [hg₂0] at hb_eq
        have hb_J2 : b ∈ J * J := Ideal.Quotient.eq_zero_iff_mem.mp hb_eq
        refine Submodule.mul_induction_on hb_J2 ?_ ?_
        · intro u hu v hv
          exact Submodule.smul_mem_smul hu hv
        · intro u v hu hv
          exact add_mem hu hv
      haveI : IsNoetherianRing R₁ :=
        IsLocalization.isNoetherianRing (Submonoid.powers d₀) R₁ inferInstance
      haveI : IsNoetherianRing R₂ :=
        IsLocalization.isNoetherianRing (Submonoid.powers (ρ₁ w₀)) R₂ inferInstance
      haveI : IsNoetherianRing B := Ideal.Quotient.isNoetherianRing I_z
      rcases Submodule.exists_mem_and_smul_eq_self_of_fg_of_le_smul J J
          (IsNoetherian.noetherian J) hJ_idem with ⟨r_bar, hr_bar_J, hr_bar_smul⟩
      rcases Ideal.Quotient.mk_surjective r_bar with ⟨r₂, rfl⟩
      refine ⟨r₂, hr_bar_J, fun y hy => ?_⟩
      have hy_J : π_B y ∈ J := hy
      have h_eq : (π_B r₂) * (π_B y) = π_B y := hr_bar_smul (π_B y) hy_J
      have h_zero : π_B ((1 - r₂) * y) = 0 := by
        rw [map_mul, map_sub, map_one, sub_mul, one_mul, h_eq, sub_self]
      exact Ideal.Quotient.eq_zero_iff_mem.mp h_zero
    rcases h_nak with ⟨r₂, hr₂_ker, hr₂_mul⟩
    have h_clear : ∀ u : R₂, ∃ (a₁ a₂ : ℕ) (r : R),
        ρ₂ (d₀ ^ a₁ * w₀ ^ a₂) * u = ρ₂ r := by
      intro u
      rcases IsLocalization.Away.surj (ρ₁ w₀) u with ⟨a₂, u₁, hu₁⟩
      rcases IsLocalization.Away.surj d₀ u₁ with ⟨a₁, r, hr⟩
      refine ⟨a₁, a₂, r, ?_⟩
      have hr' : ρ₁₂ u₁ * ρ₂ d₀ ^ a₁ = ρ₂ r := by
        simpa [ρ₂, map_mul, map_pow] using congrArg ρ₁₂ hr
      calc
        ρ₂ (d₀ ^ a₁ * w₀ ^ a₂) * u
          = (u * (ρ₁₂ (ρ₁ w₀)) ^ a₂) * ρ₂ d₀ ^ a₁ := by
            simp only [ρ₂, RingHom.comp_apply, map_mul, map_pow]
            ring
        _ = ρ₁₂ u₁ * ρ₂ d₀ ^ a₁ := by rw [hu₁]
        _ = ρ₂ r := hr'
    have h_zero : ∀ r : R, ρ₂ r = 0 → ∃ (b₁ b₂ : ℕ), d₀ ^ b₁ * w₀ ^ b₂ * r = 0 := by
      intro r hr0
      have h1 : ρ₁₂ (ρ₁ r) = 0 := hr0
      rcases (IsLocalization.map_eq_zero_iff (Submonoid.powers (ρ₁ w₀)) R₂ (ρ₁ r)).mp h1 with
        ⟨⟨m₂, hm₂⟩, hm₂_eq⟩
      rcases hm₂ with ⟨b₂, rfl⟩
      have h2 : ρ₁ (w₀ ^ b₂ * r) = 0 := by
        simpa [map_mul, map_pow] using hm₂_eq
      rcases (IsLocalization.map_eq_zero_iff (Submonoid.powers d₀) R₁ (w₀ ^ b₂ * r)).mp h2 with
        ⟨⟨m₁, hm₁⟩, hm₁_eq⟩
      rcases hm₁ with ⟨b₁, rfl⟩
      refine ⟨b₁, b₂, ?_⟩
      calc
        d₀ ^ b₁ * w₀ ^ b₂ * r = d₀ ^ b₁ * (w₀ ^ b₂ * r) := by ring
        _ = 0 := hm₁_eq
    rcases h_clear z with ⟨k₁, k₂, g_raw, hg_raw⟩
    have hφ_graw0 : algebraMap A A' (φ g_raw) = 0 := by
      rw [← hq_raw_R g_raw, ← hg_raw, map_mul, hz_ker, mul_zero]
    rcases (IsLocalization.map_eq_zero_iff (Submonoid.powers h₀_a) A' (φ g_raw)).mp hφ_graw0 with
      ⟨⟨m₃, hm₃⟩, hm₃_eq⟩
    rcases hm₃ with ⟨k₃, rfl⟩
    let g : R := w₀ ^ k₃ * g_raw
    have hg_ker : g ∈ RingHom.ker φ := by
      rw [RingHom.mem_ker]
      dsimp only [g, w₀]
      rw [map_mul, map_pow]
      have h1 := RingHom.congr_fun h_sec h₀_a
      change ((φ.comp ι) h₀_a) ^ k₃ * φ g_raw = 0
      rw [h1, RingHom.id_apply]
      exact hm₃_eq
    have hz_in_g : z ∈ Ideal.span {ρ₂ g} := by
      have hu_d₀ : IsUnit (ρ₂ d₀) :=
        (IsLocalization.Away.algebraMap_isUnit d₀).map ρ₁₂
      have hu_w₀ : IsUnit (ρ₂ w₀) :=
        IsLocalization.Away.algebraMap_isUnit (ρ₁ w₀)
      have hu_den : IsUnit (ρ₂ (d₀ ^ k₁ * w₀ ^ (k₂ + k₃))) := by
        rw [map_mul, map_pow, map_pow]
        exact (hu_d₀.pow k₁).mul (hu_w₀.pow (k₂ + k₃))
      rcases hu_den with ⟨U_den, hU_den⟩
      have h_eq : (U_den : R₂) * z = ρ₂ g := by
        rw [hU_den]
        dsimp only [g]
        calc
          ρ₂ (d₀ ^ k₁ * w₀ ^ (k₂ + k₃)) * z
            = ρ₂ (w₀ ^ k₃) * (ρ₂ (d₀ ^ k₁ * w₀ ^ k₂) * z) := by
              simp only [map_mul, map_pow, pow_add]; ring
          _ = ρ₂ (w₀ ^ k₃) * ρ₂ g_raw := by rw [hg_raw]
          _ = ρ₂ (w₀ ^ k₃ * g_raw) := (map_mul ρ₂ _ _).symm
      rw [Ideal.mem_span_singleton]
      refine ⟨↑U_den⁻¹, ?_⟩
      calc
        z = ↑U_den⁻¹ * ((U_den : R₂) * z) := by rw [Units.inv_mul_cancel_left]
        _ = ↑U_den⁻¹ * ρ₂ g := by rw [h_eq]
        _ = ρ₂ g * ↑U_den⁻¹ := mul_comm _ _
    rcases h_clear r₂ with ⟨l₁, l₂, r_num, hr_num⟩
    have hφ_rnum0 : algebraMap A A' (φ r_num) = 0 := by
      rw [← hq_raw_R r_num, ← hr_num, map_mul, hr₂_ker, mul_zero]
    rcases (IsLocalization.map_eq_zero_iff (Submonoid.powers h₀_a) A' (φ r_num)).mp hφ_rnum0 with
      ⟨⟨m₄, hm₄⟩, hm₄_eq⟩
    rcases hm₄ with ⟨l₃, rfl⟩
    have hr_num_mem : r_num ∈ m_pt := by
      have hw_rnum_ker : w₀ ^ l₃ * r_num ∈ RingHom.ker φ := by
        rw [RingHom.mem_ker]
        dsimp only [w₀]
        rw [map_mul, map_pow]
        have h1 := RingHom.congr_fun h_sec h₀_a
        change ((φ.comp ι) h₀_a) ^ l₃ * φ r_num = 0
        rw [h1, RingHom.id_apply]
        exact hm₄_eq
      rcases hm_prime.mem_or_mem (h_ker_le hw_rnum_ker) with hw_pow | hr_m
      · exfalso
        exact hw₀ (hm_prime.mem_of_pow_mem l₃ hw_pow)
      · exact hr_m
    let u₀ : R := d₀ ^ l₁ * w₀ ^ l₂ - r_num
    have hu₀ : u₀ ∉ m_pt := by
      have h_prod_not : d₀ ^ l₁ * w₀ ^ l₂ ∉ m_pt :=
        hm_prime.mul_notMem
          (fun h => hd₀ (hm_prime.mem_of_pow_mem l₁ h))
          (fun h => hw₀ (hm_prime.mem_of_pow_mem l₂ h))
      intro hu₀_mem
      apply h_prod_not
      have := m_pt.add_mem hu₀_mem hr_num_mem
      simpa [u₀] using this
    have h_ptwise : ∀ x : R, x ∈ RingHom.ker φ →
        ∃ p : ℕ × ℕ, (d₀ ^ p.1 * w₀ ^ p.2 * u₀) * x ∈ Ideal.span {g} := by
      intro x hx
      have hx_qraw : ρ₂ x ∈ RingHom.ker q_raw := by
        rw [RingHom.mem_ker, hq_raw_R, hx, map_zero]
      have hx_span : (1 - r₂) * ρ₂ x ∈ Ideal.span {ρ₂ g} :=
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hz_in_g)) (hr₂_mul (ρ₂ x) hx_qraw)
      rcases Ideal.mem_span_singleton.mp hx_span with ⟨q₂, hq₂⟩
      have hu₀_eq : ρ₂ (u₀ * x) = ρ₂ g * (ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) * q₂) := by
        dsimp only [u₀]
        calc
          ρ₂ ((d₀ ^ l₁ * w₀ ^ l₂ - r_num) * x)
            = (ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) - ρ₂ r_num) * ρ₂ x := by
              rw [map_mul, map_sub]
          _ = ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) * ((1 - r₂) * ρ₂ x) := by
              rw [← hr_num]; ring
          _ = ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) * (ρ₂ g * q₂) := by rw [hq₂]
          _ = ρ₂ g * (ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) * q₂) := by ring
      rcases h_clear (ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) * q₂) with ⟨c₁, c₂, q_num, hq_num⟩
      have h_diff0 : ρ₂ (d₀ ^ c₁ * w₀ ^ c₂ * u₀ * x - g * q_num) = 0 := by
        rw [map_sub, sub_eq_zero]
        calc
          ρ₂ (d₀ ^ c₁ * w₀ ^ c₂ * u₀ * x)
            = ρ₂ (d₀ ^ c₁ * w₀ ^ c₂) * ρ₂ (u₀ * x) := by
              rw [mul_assoc (d₀ ^ c₁ * w₀ ^ c₂) u₀ x, map_mul]
          _ = ρ₂ (d₀ ^ c₁ * w₀ ^ c₂) * (ρ₂ g * (ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) * q₂)) := by
              rw [hu₀_eq]
          _ = ρ₂ g * (ρ₂ (d₀ ^ c₁ * w₀ ^ c₂) * (ρ₂ (d₀ ^ l₁ * w₀ ^ l₂) * q₂)) := by ring
          _ = ρ₂ g * ρ₂ q_num := by rw [hq_num]
          _ = ρ₂ (g * q_num) := (map_mul ρ₂ g q_num).symm
      rcases h_zero _ h_diff0 with ⟨b₁, b₂, hb_eq⟩
      refine ⟨(b₁ + c₁, b₂ + c₂), ?_⟩
      rw [Ideal.mem_span_singleton]
      refine ⟨d₀ ^ b₁ * w₀ ^ b₂ * q_num, ?_⟩
      have h_sub : d₀ ^ b₁ * w₀ ^ b₂ * (d₀ ^ c₁ * w₀ ^ c₂ * u₀ * x) =
          d₀ ^ b₁ * w₀ ^ b₂ * (g * q_num) := by
        exact sub_eq_zero.mp (by rw [← mul_sub]; exact hb_eq)
      calc
        (d₀ ^ (b₁ + c₁) * w₀ ^ (b₂ + c₂) * u₀) * x
          = d₀ ^ b₁ * w₀ ^ b₂ * (d₀ ^ c₁ * w₀ ^ c₂ * u₀ * x) := by
            simp only [pow_add]; ring
        _ = d₀ ^ b₁ * w₀ ^ b₂ * (g * q_num) := h_sub
        _ = g * (d₀ ^ b₁ * w₀ ^ b₂ * q_num) := by ring
    rcases Submodule.fg_def.mp (IsNoetherian.noetherian (RingHom.ker φ)) with
      ⟨S_set, hS_fin, hS_span⟩
    let S_gen : Finset R := hS_fin.toFinset
    have hS_sub : ∀ x ∈ S_gen, x ∈ RingHom.ker φ := by
      intro x hx
      rw [← hS_span]
      exact Ideal.subset_span (hS_fin.mem_toFinset.mp hx)
    have h_ex_pair : ∀ x : R, ∃ p : ℕ × ℕ,
        x ∈ RingHom.ker φ → (d₀ ^ p.1 * w₀ ^ p.2 * u₀) * x ∈ Ideal.span {g} := by
      intro x
      by_cases hx : x ∈ RingHom.ker φ
      · rcases h_ptwise x hx with ⟨p, hp⟩
        exact ⟨p, fun _ => hp⟩
      · exact ⟨(0, 0), fun h => False.elim (hx h)⟩
    choose e_pair he_pair using h_ex_pair
    let E₁ : ℕ := S_gen.sup (fun x => (e_pair x).1)
    let E₂ : ℕ := S_gen.sup (fun x => (e_pair x).2)
    let d : R := d₀ ^ E₁ * w₀ ^ E₂ * u₀
    have hd_notMem : d ∉ m_pt :=
      hm_prime.mul_notMem
        (hm_prime.mul_notMem
          (fun h => hd₀ (hm_prime.mem_of_pow_mem E₁ h))
          (fun h => hw₀ (hm_prime.mem_of_pow_mem E₂ h)))
        hu₀
    let M_col : Ideal R :=
      { carrier := {x : R | d * x ∈ Ideal.span {g}}
        zero_mem' := by simp
        add_mem' := fun {x y} hx hy => by
          change d * (x + y) ∈ Ideal.span {g}
          rw [mul_add]
          exact add_mem hx hy
        smul_mem' := fun c {x} hx => by
          change d * (c • x) ∈ Ideal.span {g}
          rw [smul_eq_mul, ← mul_assoc, mul_comm d c, mul_assoc]
          exact Ideal.mul_mem_left (Ideal.span {g}) c hx }
    have h_ker_M : RingHom.ker φ ≤ M_col := by
      rw [← hS_span, Ideal.span_le]
      intro x hx_set
      have hx_gen : x ∈ S_gen := hS_fin.mem_toFinset.mpr hx_set
      have hx_ker : x ∈ RingHom.ker φ := hS_sub x hx_gen
      have he_spec : (d₀ ^ (e_pair x).1 * w₀ ^ (e_pair x).2 * u₀) * x ∈ Ideal.span {g} :=
        he_pair x hx_ker
      have hle₁ : (e_pair x).1 ≤ E₁ := Finset.le_sup (f := fun y => (e_pair y).1) hx_gen
      have hle₂ : (e_pair x).2 ≤ E₂ := Finset.le_sup (f := fun y => (e_pair y).2) hx_gen
      change d * x ∈ Ideal.span {g}
      have h_fac : d * x =
          (d₀ ^ (E₁ - (e_pair x).1) * w₀ ^ (E₂ - (e_pair x).2)) *
            ((d₀ ^ (e_pair x).1 * w₀ ^ (e_pair x).2 * u₀) * x) := by
        dsimp only [d]
        have hp₁ : E₁ = (E₁ - (e_pair x).1) + (e_pair x).1 := (Nat.sub_add_cancel hle₁).symm
        have hp₂ : E₂ = (E₂ - (e_pair x).2) + (e_pair x).2 := (Nat.sub_add_cancel hle₂).symm
        conv_lhs => rw [hp₁, hp₂, pow_add, pow_add]
        ring
      rw [h_fac]
      exact Ideal.mul_mem_left (Ideal.span {g}) _ he_spec
    exact ⟨g, d, hg_ker, hd_notMem, fun x hx => h_ker_M hx⟩

  
  
  
  have h_s3 : ∀ (A R : Type u) [CommRing A] [CommRing R]
      (ι : A →+* R)
      (φ : Fin m → (R →+* A))
      (m_max : Fin m → Ideal R),
      (∀ a : Fin m, (φ a).comp ι = RingHom.id A) →
      (∀ a : Fin m, (m_max a).IsMaximal) →
      (∀ a : Fin m, RingHom.ker (φ a) ≤ m_max a) →
      (∀ a b : Fin m, a ≠ b → ¬(RingHom.ker (φ a) ≤ m_max b)) →
      (∀ a : Fin m, ∃ g d : R,
        g ∈ RingHom.ker (φ a) ∧ d ∉ m_max a ∧ ∀ x ∈ RingHom.ker (φ a), d * x ∈ Ideal.span {g}) →
      ∃ (s₁ : R) (t_tilde : Fin m → R),
        (∀ b : Fin m, s₁ ∉ m_max b) ∧
        (∀ a : Fin m, t_tilde a ∈ RingHom.ker (φ a)) ∧
        (∀ a : Fin m, ∀ x ∈ RingHom.ker (φ a), s₁ * x ∈ Ideal.span {t_tilde a}) ∧
        (∀ (h₁ : A) (A₁ R_out : Type u) [CommRing A₁] [CommRing R_out]
          [Algebra A A₁] [IsLocalization.Away h₁ A₁]
          [Algebra R R_out] [IsLocalization.Away (s₁ * ι h₁) R_out]
          (ψ : Fin m → (R_out →+* A₁)),
          (∀ a : Fin m, (ψ a).comp (algebraMap R R_out) = (algebraMap A A₁).comp (φ a)) →
          ∀ a : Fin m, RingHom.ker (ψ a) = Ideal.span {algebraMap R R_out (t_tilde a)}) := by
    intro A R _ _ ι φ m_max h_sec h_max h_le h_nle h_loc
    choose g d hg_mem hd_not hd_mul using h_loc
    have h_crt : ∀ a : Fin m, ∃ (t_a : R) (d_a' : R),
        t_a ∈ RingHom.ker (φ a) ∧
        (∀ b : Fin m, b ≠ a → t_a ∉ m_max b) ∧
        d_a' ∉ m_max a ∧
        (∀ x ∈ RingHom.ker (φ a), d_a' * x ∈ Ideal.span {t_a}) := by
      intro a
      let P_ne : Ideal R := ∏ b ∈ Finset.univ.erase a, m_max b
      have h_coprime : (RingHom.ker (φ a) * m_max a) ⊔ P_ne = ⊤ := by
        by_contra h_neq
        rcases Ideal.exists_le_maximal _ h_neq with ⟨q, hq_max, hq_le⟩
        have hq_prime : q.IsPrime := hq_max.isPrime
        have hP_le : P_ne ≤ q := le_sup_right.trans hq_le
        rcases (hq_prime.prod_le).mp hP_le with ⟨b, hb_erase, hmb_le_q⟩
        have hba : b ≠ a := (Finset.mem_erase.mp hb_erase).1
        have hab : a ≠ b := hba.symm
        have hmb_eq : m_max b = q := (h_max b).eq_of_le hq_max.ne_top hmb_le_q
        subst hmb_eq
        have hIm_le : RingHom.ker (φ a) * m_max a ≤ m_max b := le_sup_left.trans hq_le
        rcases ((h_max b).isPrime.mul_le).mp hIm_le with hIa_le | hma_le
        · exact h_nle a b hab hIa_le
        · exact h_nle a b hab ((h_le a).trans hma_le)
      have h_one : (1 - g a : R) ∈ (RingHom.ker (φ a) * m_max a) ⊔ P_ne := by
        rw [h_coprime]; trivial
      rcases Submodule.mem_sup.mp h_one with ⟨h_a, hh_a, r_a, hr_a, h_sum⟩
      let t_a : R := g a + h_a
      have ht_eq : t_a + r_a = 1 := by
        dsimp only [t_a]
        calc
          (g a + h_a) + r_a = g a + (h_a + r_a) := by ring
          _ = g a + (1 - g a) := by rw [h_sum]
          _ = 1 := by ring
      have ht_mem : t_a ∈ RingHom.ker (φ a) :=
        add_mem (hg_mem a)
          (Submodule.mul_le.mpr (fun u hu v _ => Ideal.mul_mem_right v _ hu) hh_a)
      have ht_not : ∀ b : Fin m, b ≠ a → t_a ∉ m_max b := by
        intro b hba ht_in
        have hb_erase : b ∈ Finset.univ.erase a :=
          Finset.mem_erase.mpr ⟨hba, Finset.mem_univ b⟩
        have hP_le_mb : P_ne ≤ m_max b := by
          dsimp only [P_ne]
          rw [← Finset.mul_prod_erase (Finset.univ.erase a) m_max hb_erase]
          exact Submodule.mul_le.mpr (fun u hu v _ => Ideal.mul_mem_right v _ hu)
        have hr_in : r_a ∈ m_max b := hP_le_mb hr_a
        have h1_in : (1 : R) ∈ m_max b := by
          rw [← ht_eq]
          exact add_mem ht_in hr_in
        exact (h_max b).ne_top ((Ideal.eq_top_iff_one _).mpr h1_in)
      have h_ind : ∃ μ_a ∈ m_max a, d a * h_a = g a * μ_a := by
        refine Submodule.mul_induction_on hh_a ?_ ?_
        · intro x hx m' hm'
          rcases Ideal.mem_span_singleton.mp (hd_mul a x hx) with ⟨c, hc⟩
          refine ⟨c * m', Ideal.mul_mem_left (m_max a) c hm', ?_⟩
          calc
            d a * (x * m') = (d a * x) * m' := by ring
            _ = (g a * c) * m' := by rw [hc]
            _ = g a * (c * m') := by ring
        · intro u v ⟨μ₁, hμ₁, heq₁⟩ ⟨μ₂, hμ₂, heq₂⟩
          refine ⟨μ₁ + μ₂, add_mem hμ₁ hμ₂, ?_⟩
          rw [mul_add, heq₁, heq₂, mul_add]
      rcases h_ind with ⟨μ_a, hμ_a, hdh_eq⟩
      let d_tilde : R := d a + μ_a
      have hd_tilde_not : d_tilde ∉ m_max a := by
        intro h_in
        apply hd_not a
        have := (m_max a).sub_mem h_in hμ_a
        simpa [d_tilde] using this
      let d_a' : R := d a * d_tilde
      have hd_a'_not : d_a' ∉ m_max a :=
        (h_max a).isPrime.mul_notMem (hd_not a) hd_tilde_not
      have h_dt_eq : d a * t_a = d_tilde * g a := by
        dsimp only [t_a, d_tilde]
        rw [mul_add, hdh_eq]
        ring
      refine ⟨t_a, d_a', ht_mem, ht_not, hd_a'_not, fun x hx => ?_⟩
      rcases Ideal.mem_span_singleton.mp (hd_mul a x hx) with ⟨c, hc⟩
      rw [Ideal.mem_span_singleton]
      refine ⟨d a * c, ?_⟩
      dsimp only [d_a']
      calc
        (d a * d_tilde) * x = d_tilde * (d a * x) := by ring
        _ = d_tilde * (g a * c) := by rw [hc]
        _ = (d_tilde * g a) * c := by ring
        _ = (d a * t_a) * c := by rw [← h_dt_eq]
        _ = t_a * (d a * c) := by ring
    choose t_tilde d_prime ht_mem ht_not hd'_not hd'_mul using h_crt
    let K : Fin m → Ideal R := fun a =>
      { carrier := {s : R | ∀ x ∈ RingHom.ker (φ a), s * x ∈ Ideal.span {t_tilde a}}
        zero_mem' := by simp
        add_mem' := fun {u v} hu hv x hx => by
          rw [add_mul]
          exact add_mem (hu x hx) (hv x hx)
        smul_mem' := fun c {u} hu x hx => by
          rw [smul_eq_mul, mul_assoc]
          exact Ideal.mul_mem_left (Ideal.span {t_tilde a}) c (hu x hx) }
    have hK_nle : ∀ a b : Fin m, ¬(K a ≤ m_max b) := by
      intro a b hle_K
      by_cases hab : b = a
      · subst hab
        exact hd'_not b (hle_K (hd'_mul b))
      · have ht_K : t_tilde a ∈ K a := by
          intro x _
          exact Ideal.mem_span_singleton.mpr ⟨x, rfl⟩
        exact ht_not a b hab (hle_K ht_K)
    let K_all : Ideal R := ∏ a ∈ (Finset.univ : Finset (Fin m)), K a
    have hKall_nle : ∀ b : Fin m, ¬(K_all ≤ m_max b) := by
      intro b hle_all
      rcases ((h_max b).isPrime.prod_le).mp hle_all with ⟨a, _, hKa_le⟩
      exact hK_nle a b hKa_le
    let a₀ : Fin m := ⟨0, hm⟩
    have h_not_sub : ¬((K_all : Set R) ⊆ ⋃ b ∈ (↑(Finset.univ : Finset (Fin m)) : Set (Fin m)),
        (m_max b : Set R)) := by
      rw [Ideal.subset_union_prime a₀ a₀ (fun i _ _ _ => (h_max i).isPrime)]
      rintro ⟨b, _, hle_b⟩
      exact hKall_nle b hle_b
    rcases Set.not_subset.mp h_not_sub with ⟨s₁, hs₁_Kall, hs₁_not_union⟩
    have hs₁_not : ∀ b : Fin m, s₁ ∉ m_max b := by
      intro b hs₁_in
      apply hs₁_not_union
      exact Set.mem_biUnion (Finset.mem_coe.mpr (Finset.mem_univ b)) hs₁_in
    have hs₁_mul : ∀ a : Fin m, ∀ x ∈ RingHom.ker (φ a), s₁ * x ∈ Ideal.span {t_tilde a} := by
      intro a
      have hKall_le_Ka : K_all ≤ K a := by
        dsimp only [K_all]
        rw [← Finset.mul_prod_erase Finset.univ K (Finset.mem_univ a)]
        exact Submodule.mul_le.mpr (fun u hu v _ => Ideal.mul_mem_right v _ hu)
      exact hKall_le_Ka hs₁_Kall
    refine ⟨s₁, t_tilde, hs₁_not, ht_mem, hs₁_mul, ?_⟩
    intro h₁ A₁ R_out _ _ _ _ _ _ ψ hψ a
    apply le_antisymm
    · intro z hz
      let w : R := s₁ * ι h₁
      rcases IsLocalization.Away.surj w z with ⟨n, r, hr⟩
      have hψ_r0 : algebraMap A A₁ (φ a r) = 0 := by
        have h1 := RingHom.congr_fun (hψ a) r
        simp only [RingHom.comp_apply] at h1
        rw [← h1, ← hr, map_mul, ( hz : ψ a z = 0 ), zero_mul]
      rcases (IsLocalization.map_eq_zero_iff (Submonoid.powers h₁) A₁ (φ a r)).mp hψ_r0 with
        ⟨⟨m_h, hm_h⟩, hm_h_eq⟩
      rcases hm_h with ⟨k_exp, rfl⟩
      have h_hr_ker : (ι h₁) ^ k_exp * r ∈ RingHom.ker (φ a) := by
        change φ a ((ι h₁) ^ k_exp * r) = 0
        rw [map_mul, map_pow]
        have hsec1 := RingHom.congr_fun (h_sec a) h₁
        change ((φ a).comp ι h₁) ^ k_exp * φ a r = 0
        rw [hsec1, RingHom.id_apply]
        exact hm_h_eq
      rcases Ideal.mem_span_singleton.mp (hs₁_mul a _ h_hr_ker) with ⟨q_elt, hq_elt⟩
      have hu_w : IsUnit (algebraMap R R_out w) := IsLocalization.Away.algebraMap_isUnit w
      have hu_prod : IsUnit (algebraMap R R_out s₁ * algebraMap R R_out (ι h₁)) := by
        simpa [w, map_mul] using hu_w
      have hu_s : IsUnit (algebraMap R R_out s₁) := isUnit_of_mul_isUnit_left hu_prod
      have hu_h : IsUnit (algebraMap R R_out (ι h₁)) := isUnit_of_mul_isUnit_right hu_prod
      have hu_all : IsUnit (algebraMap R R_out s₁ *
          (algebraMap R R_out (ι h₁)) ^ k_exp * (algebraMap R R_out w) ^ n) :=
        (hu_s.mul (hu_h.pow k_exp)).mul (hu_w.pow n)
      rcases hu_all with ⟨U_all, hU_all⟩
      have hUz : (U_all : R_out) * z =
          algebraMap R R_out (t_tilde a) * algebraMap R R_out q_elt := by
        rw [hU_all]
        calc
          algebraMap R R_out s₁ * (algebraMap R R_out (ι h₁)) ^ k_exp *
              (algebraMap R R_out w) ^ n * z
            = algebraMap R R_out s₁ * (algebraMap R R_out (ι h₁)) ^ k_exp *
                (z * (algebraMap R R_out w) ^ n) := by ring
          _ = algebraMap R R_out s₁ * (algebraMap R R_out (ι h₁)) ^ k_exp *
                algebraMap R R_out r := by rw [hr]
          _ = algebraMap R R_out (s₁ * ((ι h₁) ^ k_exp * r)) := by
                simp only [map_mul, map_pow]; ring
          _ = algebraMap R R_out (t_tilde a * q_elt) := by rw [hq_elt]
          _ = algebraMap R R_out (t_tilde a) * algebraMap R R_out q_elt := map_mul _ _ _
      rw [Ideal.mem_span_singleton]
      refine ⟨↑U_all⁻¹ * algebraMap R R_out q_elt, ?_⟩
      calc
        z = ↑U_all⁻¹ * ((U_all : R_out) * z) := by rw [Units.inv_mul_cancel_left]
        _ = ↑U_all⁻¹ * (algebraMap R R_out (t_tilde a) * algebraMap R R_out q_elt) := by rw [hUz]
        _ = algebraMap R R_out (t_tilde a) * (↑U_all⁻¹ * algebraMap R R_out q_elt) := by ring
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      change ψ a (algebraMap R R_out (t_tilde a)) = 0
      have h1 := RingHom.congr_fun (hψ a) (t_tilde a)
      simp only [RingHom.comp_apply] at h1
      rw [h1, (ht_mem a : φ a (t_tilde a) = 0), map_zero]

  
  
  
  rcases h_s1 with ⟨U_proj, hAff_Uproj, hz_Uproj⟩
  let U'_1 : Y₀.Opens := (TopologicalSpace.Opens.map q_proj.base).obj U_proj
  have hAff_U'1 : AlgebraicGeometry.IsAffineOpen U'_1 := hAff_Uproj.preimage q_proj
  let O_init : V₀.Opens :=
    (Finset.univ : Finset (Fin m)).inf fun a => (TopologicalSpace.Opens.map (τ₀ a).base).obj U'_1
  have hv₀_Oinit : v₀ ∈ O_init := by
    have h_ind : ∀ (S : Finset (Fin m)),
        v₀ ∈ S.inf (fun a => (TopologicalSpace.Opens.map (τ₀ a).base).obj U'_1) := by
      intro S
      refine Finset.induction_on S ?_ ?_
      · simp
      · intro a s _ ih
        rw [Finset.inf_insert]
        exact ⟨hz_Uproj a, ih⟩
    exact h_ind Finset.univ
  have hAff_V0_top : AlgebraicGeometry.IsAffineOpen (⊤ : V₀.Opens) :=
    AlgebraicGeometry.isAffineOpen_top V₀
  rcases hAff_V0_top.exists_basicOpen_le ⟨v₀, hv₀_Oinit⟩ trivial with
    ⟨h₀, hh₀_le_Oinit, hv₀_h₀⟩
  let V₀₀ : V₀.Opens := V₀.basicOpen h₀
  have hAff_V₀₀ : AlgebraicGeometry.IsAffineOpen V₀₀ := hAff_V0_top.basicOpen h₀
  have hU'1_le_top : U'_1 ≤ (TopologicalSpace.Opens.map f₀.base).obj ⊤ := fun _ _ => trivial
  let f₀_h₀ : ↑(Y₀.presheaf.obj (Opposite.op U'_1)) := (f₀.appLE ⊤ U'_1 hU'1_le_top).hom h₀
  let U_mid : Y₀.Opens := Y₀.basicOpen f₀_h₀
  have hAff_Umid : AlgebraicGeometry.IsAffineOpen U_mid := hAff_U'1.basicOpen f₀_h₀
  have hUmid_eq : U_mid = U'_1 ⊓ (TopologicalSpace.Opens.map f₀.base).obj V₀₀ := by
    have h_res : U_mid = U'_1 ⊓ Y₀.basicOpen ((f₀.app ⊤).hom h₀) :=
      Y₀.toRingedSpace.basicOpen_res (CategoryTheory.homOfLE hU'1_le_top).op ((f₀.app ⊤).hom h₀)
    rw [h_res, ← f₀.preimage_basicOpen h₀]
  have hUmid_f₀ : U_mid ≤ (TopologicalSpace.Opens.map f₀.base).obj V₀₀ := by
    rw [hUmid_eq]
    exact inf_le_right
  have hτ₀_Umid : ∀ a : Fin m, V₀₀ ≤ (TopologicalSpace.Opens.map (τ₀ a).base).obj U_mid := by
    intro a v hv
    change (τ₀ a).base v ∈ U_mid
    rw [hUmid_eq]
    refine ⟨?_, ?_⟩
    · have hle_a : V₀₀ ≤ (TopologicalSpace.Opens.map (τ₀ a).base).obj U'_1 :=
        hh₀_le_Oinit.trans (Finset.inf_le (Finset.mem_univ a))
      exact hle_a hv
    · change f₀.base ((τ₀ a).base v) ∈ V₀₀
      have hsec_v : f₀.base ((τ₀ a).base v) = v :=
        congrArg (fun g : V₀ ⟶ V₀ => g.base v) (hτ₀_sec a)
      rw [hsec_v]
      exact hv

  let A₀₀ := ↑(V₀.presheaf.obj (Opposite.op V₀₀))
  let R'_1 := ↑(Y₀.presheaf.obj (Opposite.op U_mid))
  let ι₀ : A₀₀ →+* R'_1 := (f₀.appLE V₀₀ U_mid hUmid_f₀).hom
  let φ₀ : Fin m → (R'_1 →+* A₀₀) :=
    fun a => ((τ₀ a).appLE U_mid V₀₀ (hτ₀_Umid a)).hom

  have hφ₀_sec : ∀ a : Fin m, (φ₀ a).comp ι₀ = RingHom.id A₀₀ := by
    intro a
    have h_cat : CategoryTheory.CategoryStruct.comp
        (f₀.appLE V₀₀ U_mid hUmid_f₀) ((τ₀ a).appLE U_mid V₀₀ (hτ₀_Umid a)) =
        CategoryTheory.CategoryStruct.id (V₀.presheaf.obj (Opposite.op V₀₀)) := by
      calc
        CategoryTheory.CategoryStruct.comp
            (f₀.appLE V₀₀ U_mid hUmid_f₀) ((τ₀ a).appLE U_mid V₀₀ (hτ₀_Umid a))
          = CategoryTheory.CategoryStruct.comp (f₀.app V₀₀)
              (CategoryTheory.CategoryStruct.comp
                (Y₀.presheaf.map (CategoryTheory.homOfLE hUmid_f₀).op)
                ((τ₀ a).appLE U_mid V₀₀ (hτ₀_Umid a))) := by
              rw [AlgebraicGeometry.Scheme.Hom.appLE, CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp (f₀.app V₀₀)
              ((τ₀ a).appLE (f₀ ⁻¹ᵁ V₀₀) V₀₀ (fun v hv => hUmid_f₀ (hτ₀_Umid a hv))) := by
              rw [AlgebraicGeometry.Scheme.Hom.map_appLE]
        _ = ((τ₀ a) ≫ f₀).appLE V₀₀ V₀₀ (fun v hv => hUmid_f₀ (hτ₀_Umid a hv)) :=
              (AlgebraicGeometry.Scheme.Hom.comp_appLE (τ₀ a) f₀ V₀₀ V₀₀ _).symm
        _ = AlgebraicGeometry.Scheme.Hom.appLE (𝟙 V₀) V₀₀ V₀₀ (fun _ h => h) := by
              congr 1
              exact hτ₀_sec a
        _ = CategoryTheory.CategoryStruct.id _ := by
              have h_app_id :
                  (AlgebraicGeometry.Scheme.Hom.app (𝟙 V₀) V₀₀ :
                    V₀.presheaf.obj (Opposite.op V₀₀) ⟶ V₀.presheaf.obj (Opposite.op V₀₀)) =
                    CategoryTheory.CategoryStruct.id _ := by
                simp
                rfl
              have h_hom_id :
                  (CategoryTheory.homOfLE (le_rfl : V₀₀ ≤ V₀₀)).op = 𝟙 (Opposite.op V₀₀) :=
                Subsingleton.elim _ _
              have h_map_id :
                  V₀.presheaf.map (CategoryTheory.homOfLE (le_rfl : V₀₀ ≤ V₀₀)).op =
                    CategoryTheory.CategoryStruct.id (V₀.presheaf.obj (Opposite.op V₀₀)) := by
                rw [h_hom_id, CategoryTheory.Functor.map_id]
              exact (congrArg₂
                (@CategoryTheory.CategoryStruct.comp CommRingCat _
                  (V₀.presheaf.obj (Opposite.op V₀₀))
                  (V₀.presheaf.obj (Opposite.op V₀₀))
                  (V₀.presheaf.obj (Opposite.op V₀₀)))
                h_app_id h_map_id).trans (CategoryTheory.Category.id_comp _)
    simpa [CommRingCat.hom_comp, CommRingCat.hom_id] using congrArg CommRingCat.Hom.hom h_cat

  haveI hNoeth_R'1 : IsNoetherianRing R'_1 := by
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    haveI : AlgebraicGeometry.LocallyOfFiniteType (f₀ ≫ p_V₀) := inferInstance
    have hFT_mor : RingHom.FiniteType (((f₀ ≫ p_V₀).appLE ⊤ U_mid le_top).hom) :=
      AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.LocallyOfFiniteType)
        (f₀ ≫ p_V₀) inferInstance ⟨⊤, AlgebraicGeometry.isAffineOpen_top S_k⟩
        ⟨U_mid, hAff_Umid⟩ le_top
    let e_k := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    have hSurj_ek : Function.Surjective e_k.inv.hom := fun y =>
      ⟨e_k.hom.hom y, by
        simpa [CommRingCat.hom_comp, CommRingCat.hom_id] using
          RingHom.congr_fun (congrArg CommRingCat.Hom.hom e_k.inv_hom_id) y⟩
    have hFT_ek : RingHom.FiniteType e_k.inv.hom :=
      RingHom.FiniteType.of_surjective e_k.inv.hom hSurj_ek
    let k_to_R'1 : k →+* R'_1 := (((f₀ ≫ p_V₀).appLE ⊤ U_mid le_top).hom).comp e_k.inv.hom
    have hFT_k : k_to_R'1.FiniteType := hFT_mor.comp hFT_ek
    letI alg_k : Algebra k R'_1 := k_to_R'1.toAlgebra
    haveI : Algebra.FiniteType k R'_1 := hFT_k
    exact Algebra.FiniteType.isNoetherianRing k R'_1

  have hy_in_range : ∀ a : Fin m, (τ₀ a).base v₀ ∈ Set.range hAff_Umid.fromSpec.base := by
