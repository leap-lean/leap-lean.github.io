    have he_α : ∀ d : D, e_ring (α d) = Algebra.TensorProduct.includeLeftRingHom d := by
      have h_mor : V₀.topIso.inv ≫
          AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C) ≫
