    have h_sub_add : shift_sub.comp shift_add = AlgHom.id k P := by
      apply MvPolynomial.algHom_ext
      intro i
      change shift_sub (shift_add (MvPolynomial.X i)) = MvPolynomial.X i
      dsimp [shift_add, shift_sub]
      rw [MvPolynomial.aeval_X, map_add, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
      change (MvPolynomial.X i - MvPolynomial.C (a_pt i)) + MvPolynomial.C (a_pt i) = MvPolynomial.X i
      ring
    have h_add_sub : shift_add.comp shift_sub = AlgHom.id k P := by
      apply MvPolynomial.algHom_ext
      intro i
      change shift_add (shift_sub (MvPolynomial.X i)) = MvPolynomial.X i
      dsimp [shift_add, shift_sub]
      rw [MvPolynomial.aeval_X, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
      change (MvPolynomial.X i + MvPolynomial.C (a_pt i)) - MvPolynomial.C (a_pt i) = MvPolynomial.X i
      ring

    let φ₀ : P →ₐ[k] B := φ.comp shift_sub
    have hEt_φ₀ : RingHom.Etale φ₀.toRingHom := by
      let iso_P : CommRingCat.of P ≅ CommRingCat.of P :=
        { hom := CommRingCat.ofHom shift_sub.toRingHom
          inv := CommRingCat.ofHom shift_add.toRingHom
          hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun p => AlgHom.congr_fun h_add_sub p)
          inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun p => AlgHom.congr_fun h_sub_add p) }
