        q₀₀₁_₂₃ ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] (e₁ : S₁))) := by
      dsimp [q₀₀₁_₁₃, q₀₀₁_₂₃]
    have h_γ_fwd : ((γ₀ : S₀_ov) ⊗ₜ[R₀₁] (1 : S₀_ov) : TensorProduct R₀₁ S₀_ov S₀_ov) =
        map₀₀ (g₀₀ : T₀₀) * ((1 : S₀_ov) ⊗ₜ[R₀₁] (γ₀ : S₀_ov)) := by
      apply hq12_inj
      calc
        q₀₀₁_₁₂ ((γ₀ : S₀_ov) ⊗ₜ[R₀₁] (1 : S₀_ov))
            = q₀₀₁_₁₃ ((γ₀ : S₀_ov) ⊗ₜ[R₀₁] (1 : S₁_ov)) := hq_γ_13.symm
        _ = q₀₀₁_₁₃ ((g₀₁ : T_ov) * ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] (e₁ : S₁)))) := by
              rw [hγ₀_tmul]
        _ = q₀₀₁_₁₃ (g₀₁ : T_ov) *
              q₀₀₁_₁₃ ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] (e₁ : S₁))) := map_mul _ _ _
        _ = (q₀₀₁_₁₂ (map₀₀ (g₀₀ : T₀₀)) * q₀₀₁_₂₃ (g₀₁ : T_ov)) *
              q₀₀₁_₂₃ ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] (e₁ : S₁))) := by
              rw [hC5, hq_e1]
        _ = q₀₀₁_₁₂ (map₀₀ (g₀₀ : T₀₀)) *
              (q₀₀₁_₂₃ (g₀₁ : T_ov) *
                q₀₀₁_₂₃ ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] (e₁ : S₁)))) :=
              mul_assoc _ _ _
        _ = q₀₀₁_₁₂ (map₀₀ (g₀₀ : T₀₀)) *
              q₀₀₁_₂₃ ((γ₀ : S₀_ov) ⊗ₜ[R₀₁] (1 : S₁_ov)) := by
              rw [← map_mul, ← hγ₀_tmul]
        _ = q₀₀₁_₁₂ (map₀₀ (g₀₀ : T₀₀) * ((1 : S₀_ov) ⊗ₜ[R₀₁] (γ₀ : S₀_ov))) := by
              rw [hq_γ_23, ← map_mul]
    calc
      ((1 : S₀_ov) ⊗ₜ[R₀₁] (γ₀ : S₀_ov) : TensorProduct R₀₁ S₀_ov S₀_ov)
          = (map₀₀ (↑g₀₀⁻¹ : T₀₀) * map₀₀ (g₀₀ : T₀₀)) *
              ((1 : S₀_ov) ⊗ₜ[R₀₁] (γ₀ : S₀_ov)) := by
            rw [← map_mul, Units.inv_mul, map_one, one_mul]
      _ = map₀₀ (↑g₀₀⁻¹ : T₀₀) *
            (map₀₀ (g₀₀ : T₀₀) * ((1 : S₀_ov) ⊗ₜ[R₀₁] (γ₀ : S₀_ov))) :=
            mul_assoc _ _ _
      _ = map₀₀ (↑g₀₀⁻¹ : T₀₀) * ((γ₀ : S₀_ov) ⊗ₜ[R₀₁] (1 : S₀_ov)) := by
            rw [← h_γ_fwd]
  have hγ₀_pow : (γ₀ : S₀_ov) ^ ℓ * ((1 : R₀₁) ⊗ₜ[R₀] (v₀ : S₀)) =
      algebraMap R₀₁ S₀_ov (ρ₁ (u₁ : R₁) * u_ov) := by
    have h_inj_ov : Function.Injective (algebraMap S₀_ov T_ov) := (h_amitsur S₀_ov T_ov).1
    apply h_inj_ov
    change (((γ₀ : S₀_ov) ^ ℓ * ((1 : R₀₁) ⊗ₜ[R₀] (v₀ : S₀))) ⊗ₜ[R₀₁] (1 : S₁_ov) : T_ov) =
      (algebraMap R₀₁ S₀_ov (ρ₁ (u₁ : R₁) * u_ov)) ⊗ₜ[R₀₁] (1 : S₁_ov)
    have hγ₀_pow_tmul : ((γ₀ : S₀_ov) ^ ℓ) ⊗ₜ[R₀₁] (1 : S₁_ov) =
        (g₀₁ : T_ov) ^ ℓ * ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] ((e₁ : S₁) ^ ℓ))) := by
      have h1 := congrArg (· ^ ℓ) hγ₀_tmul
      have hl : (((γ₀ : S₀_ov) ⊗ₜ[R₀₁] (1 : S₁_ov) : T_ov) ^ ℓ) =
          ((γ₀ : S₀_ov) ^ ℓ) ⊗ₜ[R₀₁] (1 : S₁_ov) :=
        ((Algebra.TensorProduct.includeLeft : S₀_ov →ₐ[R₀₁] T_ov).map_pow (γ₀ : S₀_ov) ℓ).symm
      have hr : (((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] (e₁ : S₁)) : T_ov) ^ ℓ) =
          (1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] ((e₁ : S₁) ^ ℓ)) := by
        have hr1 := ((Algebra.TensorProduct.includeRight : S₁_ov →ₐ[R₀₁] T_ov).map_pow
          ((1 : R₀₁) ⊗ₜ[R₁] (e₁ : S₁)) ℓ).symm
        have hr2 := ((Algebra.TensorProduct.includeRight : S₁ →ₐ[R₁] S₁_ov).map_pow
          (e₁ : S₁) ℓ).symm
        exact hr1.trans (congrArg ((1 : S₀_ov) ⊗ₜ[R₀₁] ·) hr2)
      rw [hl, mul_pow, hr] at h1
      exact h1
    have hu₁_val : algebraMap R₁ S₁ (u₁ : R₁) = (e₁ : S₁) ^ ℓ * (v₁ : S₁) := hu₁
    have he1_v1_ov :
        ((1 : R₀₁) ⊗ₜ[R₁] (v₁ : S₁) : S₁_ov) * ((1 : R₀₁) ⊗ₜ[R₁] ((e₁ : S₁) ^ ℓ)) =
          algebraMap R₀₁ S₁_ov (ρ₁ (u₁ : R₁)) := by
      calc
        ((1 : R₀₁) ⊗ₜ[R₁] (v₁ : S₁) : S₁_ov) * ((1 : R₀₁) ⊗ₜ[R₁] ((e₁ : S₁) ^ ℓ))
            = (1 : R₀₁) ⊗ₜ[R₁] ((e₁ : S₁) ^ ℓ * (v₁ : S₁)) := by
              simp [Algebra.TensorProduct.tmul_mul_tmul, mul_comm]
        _ = (1 : R₀₁) ⊗ₜ[R₁] (algebraMap R₁ S₁ (u₁ : R₁)) := by rw [← hu₁_val]
        _ = ((u₁ : R₁) • (1 : R₀₁)) ⊗ₜ[R₁] (1 : S₁) := by
              rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
        _ = (ρ₁ (u₁ : R₁)) ⊗ₜ[R₁] (1 : S₁) := by
              change (ρ₁ (u₁ : R₁) * 1) ⊗ₜ[R₁] (1 : S₁) = _
              rw [mul_one]
        _ = algebraMap R₀₁ S₁_ov (ρ₁ (u₁ : R₁)) := rfl
    calc
      (((γ₀ : S₀_ov) ^ ℓ * ((1 : R₀₁) ⊗ₜ[R₀] (v₀ : S₀))) ⊗ₜ[R₀₁] (1 : S₁_ov) : T_ov)
          = (((γ₀ : S₀_ov) ^ ℓ) ⊗ₜ[R₀₁] (1 : S₁_ov)) *
              (((1 : R₀₁) ⊗ₜ[R₀] (v₀ : S₀)) ⊗ₜ[R₀₁] (1 : S₁_ov)) := by
            simp [Algebra.TensorProduct.tmul_mul_tmul]
      _ = ((g₀₁ : T_ov) ^ ℓ * (((1 : R₀₁) ⊗ₜ[R₀] (v₀ : S₀)) ⊗ₜ[R₀₁] (1 : S₁_ov))) *
            ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] ((e₁ : S₁) ^ ℓ))) := by
            rw [hγ₀_pow_tmul]; ring
      _ = algebraMap R₀₁ T_ov u_ov *
            (((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] (v₁ : S₁))) *
              ((1 : S₀_ov) ⊗ₜ[R₀₁] ((1 : R₀₁) ⊗ₜ[R₁] ((e₁ : S₁) ^ ℓ)))) := by
            rw [hC4, mul_assoc]
      _ = algebraMap R₀₁ T_ov u_ov *
            ((1 : S₀_ov) ⊗ₜ[R₀₁] (algebraMap R₀₁ S₁_ov (ρ₁ (u₁ : R₁)))) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, he1_v1_ov]
      _ = algebraMap R₀₁ T_ov u_ov * algebraMap R₀₁ T_ov (ρ₁ (u₁ : R₁)) := by
            have h_alg_eq : ((1 : S₀_ov) ⊗ₜ[R₀₁] (algebraMap R₀₁ S₁_ov (ρ₁ (u₁ : R₁))) : T_ov) =
                algebraMap R₀₁ T_ov (ρ₁ (u₁ : R₁)) := by
              rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul,
                Algebra.algebraMap_eq_smul_one (ρ₁ (u₁ : R₁))]
              rfl
            rw [h_alg_eq]
      _ = algebraMap R₀₁ T_ov (ρ₁ (u₁ : R₁) * u_ov) := by
            rw [← map_mul, mul_comm]
      _ = (algebraMap R₀₁ S₀_ov (ρ₁ (u₁ : R₁) * u_ov)) ⊗ₜ[R₀₁] (1 : S₁_ov) := rfl
  
  have hIso := @hUnivIso R₀₁ _ ρ₀.toAlgebra γ₀ (ρ₁ (u₁ : R₁) * u_ov) hγ₀_coc hγ₀_pow
  exact ⟨A₀, inferInstance, inferInstance, u₁, hFinA₀, hEtA₀, hFFA₀, hIso⟩

theorem weil_two_open_gm_divisible_kummer_etale_descent (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (V' Y' : AlgebraicGeometry.Scheme.{u})
    (p_V' : Quiver.Hom V' (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine V'] [AlgebraicGeometry.IsIntegral V']
    [AlgebraicGeometry.LocallyOfFiniteType p_V']
    (v'₀ : ↥V') (hv'₀_cl : IsClosed ({v'₀} : Set ↥V'))
    (f' : Quiver.Hom Y' V')
    [AlgebraicGeometry.IsProper f']
    (hIntY' : AlgebraicGeometry.IsIntegral Y')
    (m : ℕ) (hm : 1 ≤ m)
    (τ' : Fin m → Quiver.Hom V' Y')
    (hτ'_sec : ∀ a : Fin m, CategoryTheory.CategoryStruct.comp (τ' a) f' =
      CategoryTheory.CategoryStruct.id V')
    (hτ'_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ' a))
    (U'_in U'_out : Y'.Opens)
    (hAff_in : AlgebraicGeometry.IsAffineOpen U'_in)
    (hAff_out : AlgebraicGeometry.IsAffineOpen U'_out)
    (hU'_cov : U'_out ⊔ U'_in = ⊤)
    (hU'_in_compl : (U'_in : Set ↥Y') = (⋃ a : Fin m, Set.range (τ' a).base)ᶜ)
    (u'_div : Units ↑(Y'.presheaf.obj (Opposite.op (U'_out ⊓ U'_in))))
    (ξ_Y' : (weilEtaleGmSheaf Y').H 1)
    (hDiv_ξ : ∃ η_Y' : (weilEtaleGmSheaf Y').H 1, ℓ • η_Y' = ξ_Y')
    (hChar_ξ :
      ∀ (K_sh Q_sh : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})
        (ι_0 : weilEtaleGmSheaf Y' ⟶ K_sh)
        (π_0 : K_sh ⟶ Q_sh)
        (h0_0 : ι_0 ≫ π_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact),
        let W₁₂ : Y'.Opens := U'_out ⊓ U'_in
        let V_W₁ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_out.ι
          (inferInstance : AlgebraicGeometry.Etale U'_out.ι)
        let V_W₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U'_in.ι
          (inferInstance : AlgebraicGeometry.Etale U'_in.ι)
        let V_W₁₂ : Y'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
          (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
        let j₁₂_₁ : V_W₁₂ ⟶ V_W₁ :=
          CategoryTheory.MorphismProperty.Over.homMk
            (Y'.homOfLE inf_le_left) (Y'.homOfLE_ι inf_le_left)
        let shAdj_Y' := CategoryTheory.sheafificationAdjunction
          Y'.smallEtaleTopology AddCommGrpCat.{u}
        let Fℤ_Y' := (CategoryTheory.constantSheaf
          Y'.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let u₁_Fℤ := fun (V : Y'.Etale) =>
          (((shAdj_Y'.unit.app
            ((CategoryTheory.Functor.const (Opposite Y'.Etale)).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (Opposite.op V)).hom (ULift.up (1 : ℤ)))
        let u_Y'_sh : ↥((weilEtaleGmSheaf Y').obj.obj (Opposite.op V_W₁₂)) :=
          (((shAdj_Y'.unit.app (weilEtaleGmPresheaf Y')).app (Opposite.op V_W₁₂)).hom
            (Additive.ofMul (Units.map W₁₂.topIso.inv.hom.toMonoidHom u'_div)))
        ∀ (s_lift : ↥(K_sh.obj.obj (Opposite.op V_W₁)))
          (f_q : Fℤ_Y' ⟶ Q_sh),
          (K_sh.obj.map j₁₂_₁.op).hom s_lift =
            (ι_0.hom.app (Opposite.op V_W₁₂)).hom u_Y'_sh →
          (f_q.hom.app (Opposite.op V_W₁)).hom (u₁_Fℤ V_W₁) =
            (π_0.hom.app (Opposite.op V_W₁)).hom s_lift →
          (f_q.hom.app (Opposite.op V_W₂)).hom (u₁_Fℤ V_W₂) = 0 →
          ξ_Y' = (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1)) :
    ∃ (V_sh : AlgebraicGeometry.Scheme.{u})
      (j_Vsh : Quiver.Hom V_sh V')
      (v_sh : ↥V_sh)
      (Y_sh : AlgebraicGeometry.Scheme.{u})
      (j_Ysh : Quiver.Hom Y_sh Y')
      (f_sh : Quiver.Hom Y_sh V_sh)
      (U_0 U_1 : Y_sh.Opens)
      (A₀ : Type u)
      (instCommA₀ : CommRing A₀)
      (algA₀ : @Algebra ↑(Y_sh.presheaf.obj (Opposite.op U_0)) A₀ _ instCommA₀.toSemiring)
      (u₁ : Units ↑(Y_sh.presheaf.obj (Opposite.op U_1))),
      let R₀ := ↑(Y_sh.presheaf.obj (Opposite.op U_0))
      let R₁ := ↑(Y_sh.presheaf.obj (Opposite.op U_1))
      let R₀₁ := ↑(Y_sh.presheaf.obj (Opposite.op (U_0 ⊓ U_1)))
      letI : CommRing A₀ := instCommA₀
      letI : Algebra R₀ A₀ := algA₀
      AlgebraicGeometry.IsOpenImmersion j_Vsh ∧
      AlgebraicGeometry.IsAffine V_sh ∧
      AlgebraicGeometry.IsIntegral V_sh ∧
      IsClosed ({v_sh} : Set ↥V_sh) ∧
      j_Vsh.base v_sh = v'₀ ∧
      CategoryTheory.IsPullback j_Ysh f_sh f' j_Vsh ∧
      ∃ (hU₀_eq : U_0 = (TopologicalSpace.Opens.map j_Ysh.base).obj U'_in)
        (hU₁_le : U_1 ≤ (TopologicalSpace.Opens.map j_Ysh.base).obj U'_out),
        AlgebraicGeometry.IsAffineOpen U_0 ∧
        AlgebraicGeometry.IsAffineOpen U_1 ∧
        U_0 ⊔ U_1 = ⊤ ∧
        Module.Finite R₀ A₀ ∧
        Algebra.Etale R₀ A₀ ∧
        Module.FaithfullyFlat R₀ A₀ ∧
        let ρ₀ : R₀ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
        let ρ₁ : R₁ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
        letI : Algebra R₀ R₀₁ := ρ₀.toAlgebra
        let h_ov_le : U_0 ⊓ U_1 ≤ (TopologicalSpace.Opens.map j_Ysh.base).obj (U'_out ⊓ U'_in) :=
          le_inf (inf_le_right.trans hU₁_le) (inf_le_left.trans (le_of_eq hU₀_eq))
        let u_ov : R₀₁ := (j_Ysh.appLE (U'_out ⊓ U'_in) (U_0 ⊓ U_1) h_ov_le).hom
          (u'_div : ↑(Y'.presheaf.obj (Opposite.op (U'_out ⊓ U'_in))))
        Nonempty ((Polynomial R₀₁ ⧸
          Ideal.span {Polynomial.X ^ ℓ - Polynomial.C (ρ₁ (u₁ : R₁) * u_ov)}) ≃ₐ[R₀₁]
          TensorProduct R₀ R₀₁ A₀) :=
by
  
  have hAff_ov : AlgebraicGeometry.IsAffineOpen (U'_out ⊓ U'_in) := by
    have : AlgebraicGeometry.IsAffine U'_out.toScheme := hAff_out
    have : AlgebraicGeometry.IsAffineHom (CategoryTheory.CategoryStruct.comp U'_out.ι f') :=
      AlgebraicGeometry.isAffineHom_of_isAffine (CategoryTheory.CategoryStruct.comp U'_out.ι f')
    have : AlgebraicGeometry.IsAffineHom U'_out.ι :=
      AlgebraicGeometry.IsAffineHom.of_comp U'_out.ι f'
    have hAff_pre : AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map U'_out.ι.base).obj U'_in) :=
      hAff_in.preimage U'_out.ι
    have hAff_img : AlgebraicGeometry.IsAffineOpen
        ((AlgebraicGeometry.Scheme.Hom.opensFunctor U'_out.ι).obj
          ((TopologicalSpace.Opens.map U'_out.ι.base).obj U'_in)) :=
      hAff_pre.image_of_isOpenImmersion U'_out.ι
    have hEq :
        (AlgebraicGeometry.Scheme.Hom.opensFunctor U'_out.ι).obj
          ((TopologicalSpace.Opens.map U'_out.ι.base).obj U'_in) = U'_out ⊓ U'_in := by
      ext y
      change (∃ z : ↥U'_out, z.1 ∈ U'_in ∧ U'_out.ι.base z = y) ↔ y ∈ U'_out ∧ y ∈ U'_in
      constructor
      · rintro ⟨z, hz, rfl⟩
        exact ⟨z.2, hz⟩
      · rintro ⟨hy_out, hy_in⟩
        exact ⟨⟨y, hy_out⟩, hy_in, rfl⟩
    rwa [hEq] at hAff_img

  
  have hGmSheaf : CategoryTheory.Presheaf.IsSheaf Y'.smallEtaleTopology (weilEtaleGmPresheaf Y') :=
    weil_etale_gm_isSheaf_and_proj_H0_divisible.{u}.1 Y'
  obtain ⟨S'₀, S'₁, instCommS'₀, instCommS'₁, algS'₀, algS'₁,
      v'₀_u, v'₁_u, g'₀₀, g'₁₁, g'₀₁,
      hEtS'₀, hFFS'₀, _hEtS'₁, hFFS'₁,
      hp'₀, hp'₁, hgv'₀, hgv'₁, hgv'₀₁, hq'₀₀₁, hq'₀₁₁⟩ :=
    weil_two_open_injective_sheaf_kummer_alg_cocycle Y' ℓ U'_in U'_out
      hAff_in hAff_out hAff_ov hU'_cov hGmSheaf u'_div ξ_Y' hDiv_ξ hChar_ξ
  letI : CommRing S'₀ := instCommS'₀
  letI : CommRing S'₁ := instCommS'₁
  letI : Algebra ↑(Y'.presheaf.obj (Opposite.op U'_in)) S'₀ := algS'₀
  letI : Algebra ↑(Y'.presheaf.obj (Opposite.op U'_out)) S'₁ := algS'₁
  let R'₀ : Type u := ↑(Y'.presheaf.obj (Opposite.op U'_in))
  let R'₁ : Type u := ↑(Y'.presheaf.obj (Opposite.op U'_out))
  let R'₀₁ : Type u := ↑(Y'.presheaf.obj (Opposite.op (U'_out ⊓ U'_in)))
  letI : CommRing R'₀ := inferInstance
  letI : CommRing R'₁ := inferInstance
  letI : CommRing R'₀₁ := inferInstance
  letI : Algebra R'₀ S'₀ := algS'₀
  letI : Algebra R'₁ S'₁ := algS'₁
  let ρ'₀ : R'₀ →+* R'₀₁ := (Y'.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
  let ρ'₁ : R'₁ →+* R'₀₁ := (Y'.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
  letI : Algebra R'₀ R'₀₁ := ρ'₀.toAlgebra
  letI : Algebra R'₁ R'₀₁ := ρ'₁.toAlgebra

  
  obtain ⟨V_sh, j_Vsh, v_sh, Y_sh, j_Ysh, f_sh, U_0, U_1,
      hOpen_Vsh, hAff_Vsh, hInt_Vsh, hv_sh_cl, hv_sh_pt, hPb_sh,
      hU₀_eq, hU₁_le, hAff_U0, hAff_U1, hU01_cov, e₁, he₁_triv⟩ :=
    weil_proper_boundary_semilocal_cocycle_base_shrink V' Y' v'₀ hv'₀_cl f' m hm τ'
      hτ'_sec hτ'_cl U'_in U'_out hAff_in hAff_out hU'_cov hU'_in_compl
      S'₁ g'₁₁ hp'₁ weil_faithfullyFlat_hilbert90_and_invertible_zariski_split.{u}.1

  
  let R₀ : Type u := ↑(Y_sh.presheaf.obj (Opposite.op U_0))
  let R₁ : Type u := ↑(Y_sh.presheaf.obj (Opposite.op U_1))
  let R₀₁ : Type u := ↑(Y_sh.presheaf.obj (Opposite.op (U_0 ⊓ U_1)))
  letI : CommRing R₀ := inferInstance
  letI : CommRing R₁ := inferInstance
  letI : CommRing R₀₁ := inferInstance
  let ρ₀ : R₀ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
  let ρ₁ : R₁ →+* R₀₁ := (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
  let h_ov_le : U_0 ⊓ U_1 ≤ (TopologicalSpace.Opens.map j_Ysh.base).obj (U'_out ⊓ U'_in) :=
    le_inf (inf_le_right.trans hU₁_le) (inf_le_left.trans (le_of_eq hU₀_eq))
  let ψ₀ : R'₀ →+* R₀ := (j_Ysh.appLE U'_in U_0 (le_of_eq hU₀_eq)).hom
  let ψ₁ : R'₁ →+* R₁ := (j_Ysh.appLE U'_out U_1 hU₁_le).hom
  let ψ₀₁ : R'₀₁ →+* R₀₁ := (j_Ysh.appLE (U'_out ⊓ U'_in) (U_0 ⊓ U_1) h_ov_le).hom
  let u_ov : R₀₁ := ψ₀₁ (u'_div : R'₀₁)

  have hcomm₀ : ∀ x : R'₀, ρ₀ (ψ₀ x) = ψ₀₁ (ρ'₀ x) := by
    intro x
    have hmor :
        CategoryTheory.CategoryStruct.comp
          (j_Ysh.appLE U'_in U_0 (le_of_eq hU₀_eq))
          (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_left).op) =
        CategoryTheory.CategoryStruct.comp
          (Y'.presheaf.map (CategoryTheory.homOfLE inf_le_right).op)
          (j_Ysh.appLE (U'_out ⊓ U'_in) (U_0 ⊓ U_1) h_ov_le) :=
      (j_Ysh.appLE_map (le_of_eq hU₀_eq) (CategoryTheory.homOfLE inf_le_left).op).trans
        (j_Ysh.map_appLE h_ov_le (CategoryTheory.homOfLE inf_le_right).op).symm
    exact congrArg (fun φ => φ.hom x) hmor

  have hcomm₁ : ∀ x : R'₁, ρ₁ (ψ₁ x) = ψ₀₁ (ρ'₁ x) := by
    intro x
    have hmor :
        CategoryTheory.CategoryStruct.comp
          (j_Ysh.appLE U'_out U_1 hU₁_le)
          (Y_sh.presheaf.map (CategoryTheory.homOfLE inf_le_right).op) =
        CategoryTheory.CategoryStruct.comp
          (Y'.presheaf.map (CategoryTheory.homOfLE inf_le_left).op)
          (j_Ysh.appLE (U'_out ⊓ U'_in) (U_0 ⊓ U_1) h_ov_le) :=
      (j_Ysh.appLE_map hU₁_le (CategoryTheory.homOfLE inf_le_right).op).trans
        (j_Ysh.map_appLE h_ov_le (CategoryTheory.homOfLE inf_le_left).op).symm
    exact congrArg (fun φ => φ.hom x) hmor

  have hℓ_unit : IsUnit ((ℓ : ℕ) : R₀) := by
    let g_k : Quiver.Hom U_0.toScheme (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.CategoryStruct.comp U_0.ι
        (CategoryTheory.CategoryStruct.comp j_Ysh
          (CategoryTheory.CategoryStruct.comp f' p_V'))
    let φ_k : k →+* R₀ :=
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (CategoryTheory.CategoryStruct.comp g_k.appTop U_0.topIso.hom)).hom
    simpa only [map_natCast] using (Ne.isUnit hℓ).map φ_k

  have hu_ov : IsUnit u_ov := u'_div.isUnit.map ψ₀₁

  letI : Algebra R'₀ R₀ := ψ₀.toAlgebra
  letI : Algebra R'₁ R₁ := ψ₁.toAlgebra
  letI : Algebra R₀ R₀₁ := ρ₀.toAlgebra
  letI : Algebra R₁ R₀₁ := ρ₁.toAlgebra
  let S'₀_ov := TensorProduct R'₀ R'₀₁ S'₀
  let S'₁_ov := TensorProduct R'₁ R'₀₁ S'₁
  letI : CommRing S'₀_ov := inferInstance
  letI : CommRing S'₁_ov := inferInstance
  letI : Algebra R'₀ S'₀_ov := inferInstance
  letI : Algebra R'₁ S'₁_ov := inferInstance
  letI : Algebra R'₀₁ S'₀_ov := inferInstance
  letI : Algebra R'₀₁ S'₁_ov := inferInstance
  let S₀ := TensorProduct R'₀ R₀ S'₀
  let S₁ := TensorProduct R'₁ R₁ S'₁
  letI : CommRing S₀ := inferInstance
  letI : CommRing S₁ := inferInstance
  letI : Algebra R'₀ S₀ := inferInstance
  letI : Algebra R'₁ S₁ := inferInstance
  letI : Algebra R₀ S₀ := inferInstance
  letI : Algebra R₁ S₁ := inferInstance
  haveI : Algebra.Etale R₀ S₀ := @Algebra.Etale.baseChange R'₀ S'₀ R₀ _ _ _ _ _ hEtS'₀
  haveI : Module.FaithfullyFlat R₀ S₀ :=
    @Module.FaithfullyFlat.instTensorProduct R'₀ S'₀ _ _ _ R₀ _ _ hFFS'₀
  haveI : Module.FaithfullyFlat R₁ S₁ :=
    @Module.FaithfullyFlat.instTensorProduct R'₁ S'₁ _ _ _ R₁ _ _ hFFS'₁
  let S₀_ov : Type u := TensorProduct R₀ R₀₁ S₀
  let S₁_ov : Type u := TensorProduct R₁ R₀₁ S₁
  letI : CommRing S₀_ov := inferInstance
  letI : CommRing S₁_ov := inferInstance
  letI : Algebra R₀ S₀_ov := inferInstance
  letI : Algebra R₁ S₁_ov := inferInstance
  letI : Algebra R₀₁ S₀_ov := inferInstance
  letI : Algebra R₀₁ S₁_ov := inferInstance
  letI : CommRing (TensorProduct R'₀ S'₀ S'₀) := inferInstance
  letI : CommRing (TensorProduct R'₁ S'₁ S'₁) := inferInstance
  letI : CommRing (TensorProduct R₀ S₀ S₀) := inferInstance
  letI : CommRing (TensorProduct R₁ S₁ S₁) := inferInstance
  letI : CommRing (TensorProduct R'₀₁ S'₀_ov S'₁_ov) := inferInstance
  letI : CommRing (TensorProduct R₀₁ S₀_ov S₁_ov) := inferInstance
  letI : CommRing (TensorProduct R'₀₁ S'₀_ov S'₀_ov) := inferInstance
  letI : CommRing (TensorProduct R₀₁ S₀_ov S₀_ov) := inferInstance
  letI : CommRing (TensorProduct R'₀₁ S'₁_ov S'₁_ov) := inferInstance
  letI : CommRing (TensorProduct R₀₁ S₁_ov S₁_ov) := inferInstance
  letI : CommRing (TensorProduct R'₀ (TensorProduct R'₀ S'₀ S'₀) S'₀) := inferInstance
  letI : CommRing (TensorProduct R₀ (TensorProduct R₀ S₀ S₀) S₀) := inferInstance
  letI : CommRing (TensorProduct R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₀_ov) S'₁_ov) := inferInstance
  letI : CommRing (TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov) := inferInstance
  letI : CommRing (TensorProduct R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₁_ov) S'₁_ov) := inferInstance
  letI : CommRing (TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₁_ov) S₁_ov) := inferInstance

  have hRingHomTensorExt :
      ∀ (R A B C : Type u) [CommRing R] [CommRing A] [CommRing B] [CommRing C]
        [Algebra R A] [Algebra R B]
        (φ₁ φ₂ : TensorProduct R A B →+* C),
        (∀ a : A, φ₁ (a ⊗ₜ[R] (1 : B)) = φ₂ (a ⊗ₜ[R] (1 : B))) →
        (∀ b : B, φ₁ ((1 : A) ⊗ₜ[R] b) = φ₂ ((1 : A) ⊗ₜ[R] b)) →
        φ₁ = φ₂ := by
    intro R A B C _ _ _ _ _ _ φ₁ φ₂ ha hb
    apply RingHom.ext
    intro x
    refine @TensorProduct.induction_on R _ A B _ _ _ _ (fun z => φ₁ z = φ₂ z) x ?_ ?_ ?_
    · simp
    · intro a b
      have hmul : (a ⊗ₜ[R] b : TensorProduct R A B) = (a ⊗ₜ[R] 1) * (1 ⊗ₜ[R] b) := by simp
      rw [hmul, map_mul, map_mul, ha a, hb b]
    · intro y z hy hz
      simp [hy, hz]

  let hLiftRingHom :
      ∀ (R A B C : Type u) [CommRing R] [CommRing A] [CommRing B] [CommRing C]
        [Algebra R A] [Algebra R B]
        (f : A →+* C) (g : B →+* C),
        (∀ r : R, f (algebraMap R A r) = g (algebraMap R B r)) →
        (TensorProduct R A B →+* C) :=
    fun R A B C _ _ _ _ _ _ f g hfg =>
      letI : Algebra R C := (f.comp (algebraMap R A)).toAlgebra
      (Algebra.TensorProduct.lift
        (AlgHom.mk f (fun (r : R) => rfl))
        (AlgHom.mk g (fun (r : R) => (hfg r).symm))
        (fun _ _ => @Commute.all C _ _ _)).toRingHom

  have hLiftRingHom_tmul :
      ∀ (R A B C : Type u) [CommRing R] [CommRing A] [CommRing B] [CommRing C]
        [Algebra R A] [Algebra R B]
        (f : A →+* C) (g : B →+* C)
        (hfg : ∀ r : R, f (algebraMap R A r) = g (algebraMap R B r))
        (a : A) (b : B),
        hLiftRingHom R A B C f g hfg (a ⊗ₜ[R] b) = f a * g b := by
    intro R A B C _ _ _ _ _ _ f g hfg a b
    rfl

  let bc₀₀ : TensorProduct R'₀ S'₀ S'₀ →ₐ[R'₀] TensorProduct R₀ S₀ S₀ :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := R₀) (S := R'₀)
        (A := S₀) (B := S₀)).comp Algebra.TensorProduct.includeRight)
      (((Algebra.TensorProduct.includeRight (R := R₀) (A := S₀) (B := S₀)).restrictScalars
        R'₀).comp Algebra.TensorProduct.includeRight)
      (fun _ _ => Commute.all _ _)

  let bc₁₁ : TensorProduct R'₁ S'₁ S'₁ →ₐ[R'₁] TensorProduct R₁ S₁ S₁ :=
    Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft (R := R₁) (S := R'₁)
        (A := S₁) (B := S₁)).comp Algebra.TensorProduct.includeRight)
      (((Algebra.TensorProduct.includeRight (R := R₁) (A := S₁) (B := S₁)).restrictScalars
        R'₁).comp Algebra.TensorProduct.includeRight)
      (fun _ _ => Commute.all _ _)

  let bc₀_ov : S'₀_ov →+* S₀_ov :=
    hLiftRingHom R'₀ R'₀₁ S'₀ S₀_ov
      ((Algebra.TensorProduct.includeLeft (R := R₀) (S := R₀) (A := R₀₁) (B := S₀)).toRingHom.comp ψ₀₁)
      ((Algebra.TensorProduct.includeRight (R := R₀) (A := R₀₁) (B := S₀)).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := R'₀) (A := R₀) (B := S'₀)).toRingHom)
      (fun r'₀ => by
        change (ψ₀₁ (ρ'₀ r'₀)) ⊗ₜ[R₀] (1 : S₀) =
          (1 : R₀₁) ⊗ₜ[R₀] ((1 : R₀) ⊗ₜ[R'₀] algebraMap R'₀ S'₀ r'₀)
        rw [← hcomm₀ r'₀]
        have h1 : ((1 : R₀) ⊗ₜ[R'₀] algebraMap R'₀ S'₀ r'₀ : S₀) =
            (ψ₀ r'₀) ⊗ₜ[R'₀] (1 : S'₀) := by
          rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
          simp [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
        have h2 : ((ψ₀ r'₀) ⊗ₜ[R'₀] (1 : S'₀) : S₀) = (ψ₀ r'₀) • (1 : S₀) := by
          simp [Algebra.smul_def]
          rfl
        rw [h1, h2, ← TensorProduct.smul_tmul]
        simp [Algebra.smul_def, RingHom.algebraMap_toAlgebra])

  let bc₁_ov : S'₁_ov →+* S₁_ov :=
    hLiftRingHom R'₁ R'₀₁ S'₁ S₁_ov
      ((Algebra.TensorProduct.includeLeft (R := R₁) (S := R₁) (A := R₀₁) (B := S₁)).toRingHom.comp ψ₀₁)
      ((Algebra.TensorProduct.includeRight (R := R₁) (A := R₀₁) (B := S₁)).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := R'₁) (A := R₁) (B := S'₁)).toRingHom)
      (fun r'₁ => by
        change (ψ₀₁ (ρ'₁ r'₁)) ⊗ₜ[R₁] (1 : S₁) =
          (1 : R₀₁) ⊗ₜ[R₁] ((1 : R₁) ⊗ₜ[R'₁] algebraMap R'₁ S'₁ r'₁)
        rw [← hcomm₁ r'₁]
        have h1 : ((1 : R₁) ⊗ₜ[R'₁] algebraMap R'₁ S'₁ r'₁ : S₁) =
            (ψ₁ r'₁) ⊗ₜ[R'₁] (1 : S'₁) := by
          rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
          simp [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
        have h2 : ((ψ₁ r'₁) ⊗ₜ[R'₁] (1 : S'₁) : S₁) = (ψ₁ r'₁) • (1 : S₁) := by
          simp [Algebra.smul_def]
          rfl
        rw [h1, h2, ← TensorProduct.smul_tmul]
        simp [Algebra.smul_def, RingHom.algebraMap_toAlgebra])

  have hbc₀_ov_inr : ∀ s : S'₀, bc₀_ov ((1 : R'₀₁) ⊗ₜ[R'₀] s) =
      (1 : R₀₁) ⊗ₜ[R₀] ((1 : R₀) ⊗ₜ[R'₀] s) := by
    intro s
    change ((ψ₀₁ 1) ⊗ₜ[R₀] (1 : S₀)) * ((1 : R₀₁) ⊗ₜ[R₀] ((1 : R₀) ⊗ₜ[R'₀] s)) = _
    rw [map_one, ← Algebra.TensorProduct.one_def, one_mul]

  have hbc₁_ov_inr : ∀ t : S'₁, bc₁_ov ((1 : R'₀₁) ⊗ₜ[R'₁] t) =
      (1 : R₀₁) ⊗ₜ[R₁] ((1 : R₁) ⊗ₜ[R'₁] t) := by
    intro t
    change ((ψ₀₁ 1) ⊗ₜ[R₁] (1 : S₁)) * ((1 : R₀₁) ⊗ₜ[R₁] ((1 : R₁) ⊗ₜ[R'₁] t)) = _
    rw [map_one, ← Algebra.TensorProduct.one_def, one_mul]

  let bc₀₁ : TensorProduct R'₀₁ S'₀_ov S'₁_ov →+* TensorProduct R₀₁ S₀_ov S₁_ov :=
    hLiftRingHom R'₀₁ S'₀_ov S'₁_ov (TensorProduct R₀₁ S₀_ov S₁_ov)
      ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁)
        (A := S₀_ov) (B := S₁_ov)).toRingHom.comp bc₀_ov)
      ((Algebra.TensorProduct.includeRight (R := R₀₁) (A := S₀_ov) (B := S₁_ov)).toRingHom.comp bc₁_ov)
      (fun r'₀₁ => by
        change (bc₀_ov (r'₀₁ ⊗ₜ[R'₀] 1)) ⊗ₜ[R₀₁] (1 : S₁_ov) =
          (1 : S₀_ov) ⊗ₜ[R₀₁] (bc₁_ov (r'₀₁ ⊗ₜ[R'₁] 1))
        simp only [bc₀_ov, bc₁_ov, hLiftRingHom_tmul, RingHom.comp_apply, map_one, mul_one]
        change (algebraMap R₀₁ S₀_ov (ψ₀₁ r'₀₁)) ⊗ₜ[R₀₁] (1 : S₁_ov) =
          (1 : S₀_ov) ⊗ₜ[R₀₁] (algebraMap R₀₁ S₁_ov (ψ₀₁ r'₀₁))
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one])

  let bc₀₀₀ : TensorProduct R'₀ (TensorProduct R'₀ S'₀ S'₀) S'₀ →+*
      TensorProduct R₀ (TensorProduct R₀ S₀ S₀) S₀ :=
    letI : CommRing (TensorProduct R'₀ S'₀ S'₀) := inferInstance
    letI : CommRing (TensorProduct R₀ S₀ S₀) := inferInstance
    hLiftRingHom R'₀ (TensorProduct R'₀ S'₀ S'₀) S'₀ (TensorProduct R₀ (TensorProduct R₀ S₀ S₀) S₀)
      ((Algebra.TensorProduct.includeLeft (R := R₀) (S := R₀)
        (A := TensorProduct R₀ S₀ S₀) (B := S₀)).toRingHom.comp bc₀₀.toRingHom)
      ((Algebra.TensorProduct.includeRight (R := R₀)
        (A := TensorProduct R₀ S₀ S₀) (B := S₀)).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := R'₀) (A := R₀) (B := S'₀)).toRingHom)
      (fun r'₀ => by
        have h1 : algebraMap R'₀ S₀ r'₀ = (ψ₀ r'₀) ⊗ₜ[R'₀] (1 : S'₀) := rfl
        have h2 : ((1 : R₀) ⊗ₜ[R'₀] algebraMap R'₀ S'₀ r'₀ : S₀) =
            (ψ₀ r'₀) • (1 : S₀) := by
          rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
          simp [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
          rfl
        change (bc₀₀ (algebraMap R'₀ _ r'₀)) ⊗ₜ[R₀] (1 : S₀) =
          (1 : TensorProduct R₀ S₀ S₀) ⊗ₜ[R₀] ((1 : R₀) ⊗ₜ[R'₀] algebraMap R'₀ S'₀ r'₀)
        rw [bc₀₀.commutes, h2, ← TensorProduct.smul_tmul]
        simp [Algebra.smul_def, h1]
        rfl)

  let bc₀₀_ov : TensorProduct R'₀₁ S'₀_ov S'₀_ov →+* TensorProduct R₀₁ S₀_ov S₀_ov :=
    hLiftRingHom R'₀₁ S'₀_ov S'₀_ov (TensorProduct R₀₁ S₀_ov S₀_ov)
      ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁)
        (A := S₀_ov) (B := S₀_ov)).toRingHom.comp bc₀_ov)
      ((Algebra.TensorProduct.includeRight (R := R₀₁) (A := S₀_ov) (B := S₀_ov)).toRingHom.comp bc₀_ov)
      (fun r'₀₁ => by
        change (bc₀_ov (r'₀₁ ⊗ₜ[R'₀] 1)) ⊗ₜ[R₀₁] (1 : S₀_ov) =
          (1 : S₀_ov) ⊗ₜ[R₀₁] (bc₀_ov (r'₀₁ ⊗ₜ[R'₀] 1))
        simp only [bc₀_ov, hLiftRingHom_tmul, RingHom.comp_apply, map_one, mul_one]
        change (algebraMap R₀₁ S₀_ov (ψ₀₁ r'₀₁)) ⊗ₜ[R₀₁] (1 : S₀_ov) =
          (1 : S₀_ov) ⊗ₜ[R₀₁] (algebraMap R₀₁ S₀_ov (ψ₀₁ r'₀₁))
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one])

  let bc₀₀₁ : TensorProduct R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₀_ov) S'₁_ov →+*
      TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov :=
    letI : CommRing (TensorProduct R'₀₁ S'₀_ov S'₀_ov) := inferInstance
    letI : CommRing (TensorProduct R₀₁ S₀_ov S₀_ov) := inferInstance
    hLiftRingHom R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₀_ov) S'₁_ov
      (TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) S₁_ov)
      ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁)
        (A := TensorProduct R₀₁ S₀_ov S₀_ov) (B := S₁_ov)).toRingHom.comp bc₀₀_ov)
      ((Algebra.TensorProduct.includeRight (R := R₀₁)
        (A := TensorProduct R₀₁ S₀_ov S₀_ov) (B := S₁_ov)).toRingHom.comp bc₁_ov)
      (fun r'₀₁ => by
        change (bc₀₀_ov ((r'₀₁ ⊗ₜ[R'₀] 1) ⊗ₜ[R'₀₁] 1)) ⊗ₜ[R₀₁] (1 : S₁_ov) =
          (1 : TensorProduct R₀₁ S₀_ov S₀_ov) ⊗ₜ[R₀₁] (bc₁_ov (r'₀₁ ⊗ₜ[R'₁] 1))
        simp only [bc₀₀_ov, bc₀_ov, bc₁_ov, hLiftRingHom_tmul, RingHom.comp_apply, map_one, mul_one]
        change (algebraMap R₀₁ (TensorProduct R₀₁ S₀_ov S₀_ov) (ψ₀₁ r'₀₁)) ⊗ₜ[R₀₁] (1 : S₁_ov) =
          (1 : TensorProduct R₀₁ S₀_ov S₀_ov) ⊗ₜ[R₀₁] (algebraMap R₀₁ S₁_ov (ψ₀₁ r'₀₁))
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one])

  let bc₀₁₁ : TensorProduct R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₁_ov) S'₁_ov →+*
      TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₁_ov) S₁_ov :=
    letI : CommRing (TensorProduct R'₀₁ S'₀_ov S'₁_ov) := inferInstance
    letI : CommRing (TensorProduct R₀₁ S₀_ov S₁_ov) := inferInstance
    hLiftRingHom R'₀₁ (TensorProduct R'₀₁ S'₀_ov S'₁_ov) S'₁_ov
      (TensorProduct R₀₁ (TensorProduct R₀₁ S₀_ov S₁_ov) S₁_ov)
      ((Algebra.TensorProduct.includeLeft (R := R₀₁) (S := R₀₁)
        (A := TensorProduct R₀₁ S₀_ov S₁_ov) (B := S₁_ov)).toRingHom.comp bc₀₁)
      ((Algebra.TensorProduct.includeRight (R := R₀₁)
        (A := TensorProduct R₀₁ S₀_ov S₁_ov) (B := S₁_ov)).toRingHom.comp bc₁_ov)
