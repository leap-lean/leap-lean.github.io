      exact congrArg (fun θ => θ.hom z) h_app
  rcases hEv_pkg with ⟨evRing, hev_fst, hev_nat⟩

  
  have hChart_core : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (f : Y ⟶ C.left)
      (W₀ : C.left.Opens) (hW₀ : AlgebraicGeometry.IsAffineOpen W₀)
      (V₀ : Y.Opens) (hV₀ : AlgebraicGeometry.IsAffineOpen V₀)
      (e : V₀ ≤ (TopologicalSpace.Opens.map f.base).obj W₀),
      let D := ↑(Y.presheaf.obj (Opposite.op V₀))
      let Z_η := CategoryTheory.Limits.pullback (V₀.ι ≫ f) η_C
      let E := ↑(Z_η.presheaf.obj (Opposite.op ⊤))
      let α : D →+* E :=
        (V₀.topIso.inv ≫ (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C).appTop).hom
      IsDomain D →
      Function.Injective (f.appLE W₀ V₀ e).hom →
      (∀ q : Ideal D, q.IsPrime → Ideal.comap (f.appLE W₀ V₀ e).hom q = ⊥ → q = ⊥) →
      IsDomain E ∧ IsField E ∧ Function.Injective α ∧
        (∀ d : D, d ≠ 0 → IsUnit (α d)) ∧
        (∀ z : E, ∃ c d : D, d ≠ 0 ∧ z * α d = α c) := by
    intro Y f W₀ hW₀ V₀ hV₀ e D Z_η E α hDomD hInjφ hGenPrime
    have _ : IsDomain D := hDomD
    obtain ⟨p₀⟩ : Nonempty (PrimeSpectrum D) := inferInstance
    let y₀ : ↥V₀.toScheme := hV₀.isoSpec.inv.base p₀
    let x₀ : ↥C.left := f.base y₀.1
    have hx₀ : x₀ ∈ W₀ := e y₀.2
    have hNeW₀_sch : Nonempty ↥W₀.toScheme := ⟨⟨x₀, hx₀⟩⟩
    have hη_mem : genericPoint ↥C.left ∈ W₀ :=
      (genericPoint_specializes x₀).mem_open W₀.isOpen hx₀
    let A₀ : Type u := ↑(C.left.presheaf.obj (Opposite.op W₀))
    let K : Type u := ↑C.left.functionField
    have hDomA₀ : IsDomain A₀ :=
      @AlgebraicGeometry.IsIntegral.component_integral C.left inferInstance W₀ hNeW₀_sch
    have _ : IsDomain A₀ := hDomA₀
    have hFracA₀ : IsFractionRing A₀ K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C.left W₀ hW₀
    let φ : A₀ →+* D := (f.appLE W₀ V₀ e).hom
    letI : Algebra A₀ D := φ.toAlgebra
    let f_D := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ D))
    let f_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ K))
    have hη_eq : η_C = f_K ≫ hW₀.fromSpec := by
      dsimp [η_C, f_K]
      rw [← hW₀.fromSpecStalk_eq_fromSpecStalk hη_mem]
      rfl
    have hf_eq : hV₀.isoSpec.inv ≫ (V₀.ι ≫ f) = f_D ≫ hW₀.fromSpec := by
      rw [← CategoryTheory.Category.assoc, hV₀.isoSpec_inv_ι]
      exact (hW₀.SpecMap_appLE_fromSpec f hV₀ e).symm
    have _ : CategoryTheory.Mono hW₀.fromSpec :=
      AlgebraicGeometry.IsOpenImmersion.mono hW₀.fromSpec
    let P_aff := CategoryTheory.Limits.pullback f_D f_K
    let u₁ : P_aff ⟶ Z_η :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f_D f_K ≫ hV₀.isoSpec.inv)
        (CategoryTheory.Limits.pullback.snd f_D f_K)
        (by
          calc
            (CategoryTheory.Limits.pullback.fst f_D f_K ≫ hV₀.isoSpec.inv) ≫ (V₀.ι ≫ f)
              = CategoryTheory.Limits.pullback.fst f_D f_K ≫ (f_D ≫ hW₀.fromSpec) := by
                rw [CategoryTheory.Category.assoc, hf_eq]
            _ = (CategoryTheory.Limits.pullback.fst f_D f_K ≫ f_D) ≫ hW₀.fromSpec :=
                (CategoryTheory.Category.assoc _ _ _).symm
            _ = (CategoryTheory.Limits.pullback.snd f_D f_K ≫ f_K) ≫ hW₀.fromSpec := by
                rw [CategoryTheory.Limits.pullback.condition]
            _ = CategoryTheory.Limits.pullback.snd f_D f_K ≫ η_C := by
                rw [CategoryTheory.Category.assoc, ← hη_eq])
    have hu₂_comm :
        (CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C ≫ hV₀.isoSpec.hom) ≫ f_D =
        CategoryTheory.Limits.pullback.snd (V₀.ι ≫ f) η_C ≫ f_K := by
      apply (cancel_mono hW₀.fromSpec).mp
      calc
        ((CategoryTheory.Limits.pullback.fst (V₀.ι ≫ f) η_C ≫ hV₀.isoSpec.hom) ≫ f_D) ≫
