  let B₀₀₁ := TensorProduct D.R₀₁ A₀₀_ov T₁_ov
  have hConj4 : q₀₀₁_₁₃ (q_T.g₀₁ : A₀₁) =
      q₀₀₁_₁₂ (map₀₀ (q_T.g₀₀ : A₀₀)) * q₀₀₁_₂₃ (q_T.g₀₁ : A₀₁) := by
    let φ₁₂ : A₀₀ →+* B₀₀₁ := q₀₀₁_₁₂.toRingHom.comp map₀₀
    let ψ₀ : T₀ →+* B₀₀₁ := φ₁₂.comp ι₀₀_L
    let ψ₁ : T₀ →+* B₀₀₁ := φ₁₂.comp ι₀₀_R
    let ψ₂ : T₁ →+* B₀₀₁ :=
      (Algebra.TensorProduct.includeRight (R := D.R₀₁) (A := A₀₀_ov) (B := T₁_ov)).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := D.R₁) (A := D.R₀₁) (B := T₁)).toRingHom
