  haveI : m₀.IsMaximal := hm₀_max
  haveI : m₀.IsPrime := hm₀_max.isPrime

  have hEt_mvPoly_local_domain :
      ∀ (d : ℕ) (B : Type u) [CommRing B] [Algebra k B]
        (φ : MvPolynomial (Fin d) k →ₐ[k] B)
        (_ : RingHom.Etale φ.toRingHom)
        (σ : B →ₐ[k] k)
        [(RingHom.ker σ.toRingHom).IsMaximal],
        IsDomain (Localization.AtPrime (RingHom.ker σ.toRingHom)) ∧ IsNoetherianRing B := by
    intro d B _ _ φ hEt_φ σ _
    let m : Ideal B := RingHom.ker σ.toRingHom
    let P := MvPolynomial (Fin d) k
    let a_pt : Fin d → k := fun i => σ (φ (MvPolynomial.X i))
    let shift_sub : P →ₐ[k] P :=
      MvPolynomial.aeval (fun i : Fin d => MvPolynomial.X i - MvPolynomial.C (a_pt i))
    let shift_add : P →ₐ[k] P :=
