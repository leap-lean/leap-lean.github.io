    (p_Z : Z ⟶ Y_B₀) (pr₁ : P ⟶ Y_raw) (pr₂ : P ⟶ Z)
    (hPb_P : CategoryTheory.IsPullback pr₁ pr₂ ν_B₀ p_Z)
