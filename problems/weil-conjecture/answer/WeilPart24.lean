          change (eP.hom ≫ eP.inv).base y = (eP.hom ≫ eP.inv).base z_fib at hy'
          rwa [eP.hom_inv_id] at hy'
      rw [hpre]
      exact hq_cl.preimage eP.hom.continuous
    have him := fst_fib.isClosedEmbedding.isClosedMap {z_fib} hz_cl
    rwa [Set.image_singleton, hz_fst] at him

  
  let V₀ : AlgebraicGeometry.Scheme.{u} := (Fgt_V.obj P_cur.V).left
