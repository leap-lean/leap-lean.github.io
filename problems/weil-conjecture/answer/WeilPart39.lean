      have h_sq2 : f₂ ≫ α₃ = α₂ ≫ g₂ := by
        dsimp only [f₂, g₂, α₂, α₃]
        rw [← adj_j.homEquiv_naturality_left_symm, hNatConn SC hSE m hβ_Q hβ_ind,
