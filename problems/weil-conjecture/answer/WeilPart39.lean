    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomm : CommRingCat.ofHom (algebraMap R₀ (B_V r)) ≫
        CommRingCat.ofHom (ι_BV r).toRingHom =
        CommRingCat.ofHom (algebraMap R₀ (B_V (r + 1))) :=
      CommRingCat.hom_ext (RingHom.ext fun x => (ι_BV r).commutes x)
    rw [hcomm]
  let m_ι_can : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
