          CategoryTheory.Adjunction.homEquiv_naturality_left adj_free (CategoryTheory.yoneda.map g) η₂
        change CategoryTheory.yonedaEquiv (adj_free.homEquiv (CategoryTheory.yoneda.obj W₁) R₂.obj (u_g ≫ η₂)) =
          (R₂.obj.map (Opposite.op g)).hom
            (CategoryTheory.yonedaEquiv (adj_free.homEquiv (CategoryTheory.yoneda.obj W₂) R₂.obj η₂))
        rw [h_free]
        let t₂ := adj_free.homEquiv (CategoryTheory.yoneda.obj W₂) R₂.obj η₂
        have h_nat := congrArg (fun φ => φ (CategoryTheory.CategoryStruct.id W₂))
          (t₂.naturality (Opposite.op g)).symm
        exact (congrArg (t₂.app (Opposite.op W₁))
          ((CategoryTheory.Category.id_comp g).trans (CategoryTheory.Category.comp_id g).symm)).trans
          h_nat.symm
      have hUnit_ψ := congrArg (fun φ : R₁ ⟶ _ =>
          (φ.hom.app (Opposite.op W₁)).hom
            (weilPolyP1CohomologyRepHomEquiv X₀ W₁ R₁ (𝟙 R₁)))
        (adj_w₁.unit.naturality ψ_g).symm
      have hUnit_ψ' : (((pb_w₁.map ψ_g).hom.app (Opposite.op (B_w₁.obj W₁))).hom
          (((adj_w₁.unit.app R₁).hom.app (Opposite.op W₁)).hom
            (weilPolyP1CohomologyRepHomEquiv X₀ W₁ R₁ (𝟙 R₁)))) =
        ((adj_w₁.unit.app R₂).hom.app (Opposite.op W₁)).hom
          ((ψ_g.hom.app (Opposite.op W₁)).hom
            (weilPolyP1CohomologyRepHomEquiv X₀ W₁ R₁ (𝟙 R₁))) := hUnit_ψ
      change ((pb_w₁.obj R₂).obj.map (Opposite.op (Δ_of W₁))).hom
          (((pb_w₁.map ψ_g).hom.app (Opposite.op (B_w₁.obj W₁))).hom _) = _
      rw [hUnit_ψ', hψ_eval]
      have hNat_g := congrArg
        (fun φ : R₂.obj.obj (Opposite.op W₂) ⟶
            (pb_w₁.obj R₂).obj.obj (Opposite.op (B_w₁.obj W₁)) =>
          ((pb_w₁.obj R₂).obj.map (Opposite.op (Δ_of W₁))).hom
            (φ.hom (weilPolyP1CohomologyRepHomEquiv X₀ W₂ R₂ (𝟙 R₂))))
        ((adj_w₁.unit.app R₂).hom.naturality (Opposite.op g))
      refine hNat_g.trans ?_
      exact congrArg (fun φ => φ.hom
          (((adj_w₁.unit.app R₂).hom.app (Opposite.op W₂)).hom
            (weilPolyP1CohomologyRepHomEquiv X₀ W₂ R₂ (𝟙 R₂))))
        ((pb_w₁.obj R₂).obj.map_comp (Opposite.op (B_w₁.map g))
          (Opposite.op (Δ_of W₁))).symm
    change ((CategoryTheory.Abelian.Ext.mk₀
        (weilPolyP1CohomologyRepPullHom w₁ W₁ T_W₁ (Δ_of W₁))).comp
        ((pb_w₁.mapExtAddHom R₁ F_X₀ q) c') (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ π_w₁) (Nat.add_zero q) =
      ((CategoryTheory.Abelian.Ext.mk₀
        (weilPolyP1CohomologyRepPullHom w₁ W₂ T_W₁ l_g)).comp
        ((pb_w₁.mapExtAddHom R₂ F_X₀ q) c) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ π_w₁) (Nat.add_zero q)
    rw [hMap_c', CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hRep_g]

  exact ⟨Θ_pin, fun g p_g hp_g c => hPinNat g p_g hp_g c,
    fun W S_fib h_fib d_fib l =>
      ⟨hTermBij S_fib (weilEtaleIdTerminal.{u} S_fib) (weilEtaleIdTerminalIsTerminal.{u} S_fib)
          (weilEtaleTorsionSheaf S_fib m₀),
        fun p_ι hp_ι c => hFibUniv W S_fib h_fib d_fib l p_ι hp_ι c⟩⟩

theorem weil_mid_dev_raw_cup_sheafify_bilinear_pairing (C : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} C]
    (J : CategoryTheory.GrothendieckTopology C)
    [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    (P₁ P₂ P₃ : CategoryTheory.Functor (Opposite C) AddCommGrpCat.{u})
    (μ_pre : ∀ W : C,
      ↑(P₁.obj (Opposite.op W)) →+ ↑(P₂.obj (Opposite.op W)) →+ ↑(P₃.obj (Opposite.op W)))
    (h_nat : ∀ {W₁ W₂ : C} (u : Quiver.Hom W₁ W₂)
        (c₁ : ↑(P₁.obj (Opposite.op W₂))) (c₂ : ↑(P₂.obj (Opposite.op W₂))),
      (P₃.map (Opposite.op u)).hom (μ_pre W₂ c₁ c₂) =
        μ_pre W₁ ((P₁.map (Opposite.op u)).hom c₁) ((P₂.map (Opposite.op u)).hom c₂)) :
    let sh := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let ℱ₁ := sh.obj P₁
    let ℱ₂ := sh.obj P₂
    let ℱ₃ := sh.obj P₃
    let η₁ : ∀ W : C, ↑(P₁.obj (Opposite.op W)) →+ ↑(ℱ₁.obj.obj (Opposite.op W)) :=
      fun W => ((adj_sh.unit.app P₁).app (Opposite.op W)).hom
    let η₂ : ∀ W : C, ↑(P₂.obj (Opposite.op W)) →+ ↑(ℱ₂.obj.obj (Opposite.op W)) :=
      fun W => ((adj_sh.unit.app P₂).app (Opposite.op W)).hom
    let η₃ : ∀ W : C, ↑(P₃.obj (Opposite.op W)) →+ ↑(ℱ₃.obj.obj (Opposite.op W)) :=
      fun W => ((adj_sh.unit.app P₃).app (Opposite.op W)).hom
    ∃ μ_sh : ∀ W : C,
        ↑(ℱ₁.obj.obj (Opposite.op W)) →+
          ↑(ℱ₂.obj.obj (Opposite.op W)) →+
          ↑(ℱ₃.obj.obj (Opposite.op W)),
      (∀ {W₁ W₂ : C} (u : Quiver.Hom W₁ W₂)
          (s₁ : ↑(ℱ₁.obj.obj (Opposite.op W₂))) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W₂))),
        (ℱ₃.obj.map (Opposite.op u)).hom (μ_sh W₂ s₁ s₂) =
          μ_sh W₁ ((ℱ₁.obj.map (Opposite.op u)).hom s₁)
            ((ℱ₂.obj.map (Opposite.op u)).hom s₂)) ∧
      (∀ (W : C) (c₁ : ↑(P₁.obj (Opposite.op W))) (c₂ : ↑(P₂.obj (Opposite.op W))),
        μ_sh W (η₁ W c₁) (η₂ W c₂) = η₃ W (μ_pre W c₁ c₂)) :=
by
  intro sh adj_sh ℱ₁ ℱ₂ ℱ₃ η₁ η₂ η₃
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let zHom : ∀ {M : AddCommGrpCat.{u}}, ↑M → (Aℤ ⟶ M) := fun {M} m =>
    AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m
        map_zero' := zero_zsmul m
        map_add' := fun x y => add_zsmul m x.down y.down }
  have hzHom_eval : ∀ {M : AddCommGrpCat.{u}} (m : ↑M), (zHom m).hom (ULift.up 1) = m :=
    fun m => one_zsmul m
  have hzHom_comp : ∀ {M N : AddCommGrpCat.{u}} (m : ↑M) (ψ : M ⟶ N),
      zHom m ≫ ψ = zHom (ψ.hom m) := by
    intro M N m ψ
    apply AddCommGrpCat.ext
    intro z
    exact map_zsmul ψ.hom z.down m
  have hSh₃ : CategoryTheory.Presieve.IsSheaf J
      (ℱ₃.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) := ℱ₃.property Aℤ
  have hSep₃ : ∀ {W : C} (S : CategoryTheory.Sieve W), S ∈ J W →
      ∀ (x y : ↑(ℱ₃.obj.obj (Opposite.op W))),
        (∀ {Y : C} (f : Y ⟶ W), S.arrows f →
          (ℱ₃.obj.map (Opposite.op f)).hom x = (ℱ₃.obj.map (Opposite.op f)).hom y) →
        x = y := by
    intro W S hS x y hEq
    have hHomEq : zHom x = zHom y := by
      apply (hSh₃ S hS).isSeparatedFor.ext
      intro Y f hf
      change zHom x ≫ ℱ₃.obj.map (Opposite.op f) = zHom y ≫ ℱ₃.obj.map (Opposite.op f)
      rw [hzHom_comp, hzHom_comp, hEq f hf]
    exact (hzHom_eval x).symm.trans
      ((congrArg (fun φ => φ.hom (ULift.up 1)) hHomEq).trans (hzHom_eval y))
  have hGlue₃ : ∀ {W : C} (S : CategoryTheory.Sieve W), S ∈ J W →
      ∀ (fam : ∀ {Y : C} (f : Y ⟶ W), S.arrows f → ↑(ℱ₃.obj.obj (Opposite.op Y))),
        (∀ {Y Z : C} (g : Z ⟶ Y) (f : Y ⟶ W) (hf : S.arrows f),
          (ℱ₃.obj.map (Opposite.op g)).hom (fam f hf) = fam (g ≫ f) (S.downward_closed hf g)) →
        ∃ s : ↑(ℱ₃.obj.obj (Opposite.op W)),
          ∀ {Y : C} (f : Y ⟶ W) (hf : S.arrows f),
            (ℱ₃.obj.map (Opposite.op f)).hom s = fam f hf := by
    intro W S hS fam hCompat
    let xFam : CategoryTheory.Presieve.FamilyOfElements
        (ℱ₃.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) S.arrows :=
      fun Y f hf => zHom (fam f hf)
    have hxSieve : xFam.SieveCompatible := by
      intro Y Z f g hf
      change zHom (fam (g ≫ f) (S.downward_closed hf g)) = zHom (fam f hf) ≫ ℱ₃.obj.map (Opposite.op g)
      rw [hzHom_comp, hCompat g f hf]
    have hxCompat : xFam.Compatible :=
      (CategoryTheory.Presieve.compatible_iff_sieveCompatible xFam).mpr hxSieve
    let sHom := (hSh₃ S hS).amalgamate xFam hxCompat
    refine ⟨sHom.hom (ULift.up 1), ?_⟩
    intro Y f hf
    have hVal : sHom ≫ ℱ₃.obj.map (Opposite.op f) = zHom (fam f hf) :=
      (hSh₃ S hS).valid_glue hxCompat f hf
    exact (congrArg (fun φ => φ.hom (ULift.up 1)) hVal).trans (hzHom_eval (fam f hf))
  let unit₁ := adj_sh.unit.app P₁
  let unit₂ := adj_sh.unit.app P₂
  let unit₃ := adj_sh.unit.app P₃
  obtain ⟨_, _⟩ := (J.W_iff_isLocallyBijective unit₁).mp (J.W_adj_unit_app adj_sh P₁)
  obtain ⟨_, _⟩ := (J.W_iff_isLocallyBijective unit₂).mp (J.W_adj_unit_app adj_sh P₂)
  have hUnitNat₁ : ∀ {Y Z : C} (g : Z ⟶ Y) (c : ↑(P₁.obj (Opposite.op Y))),
      (ℱ₁.obj.map (Opposite.op g)).hom (η₁ Y c) = η₁ Z ((P₁.map (Opposite.op g)).hom c) :=
    fun g c => congrArg (fun φ => φ.hom c) (unit₁.naturality (Opposite.op g)).symm
  have hUnitNat₂ : ∀ {Y Z : C} (g : Z ⟶ Y) (c : ↑(P₂.obj (Opposite.op Y))),
      (ℱ₂.obj.map (Opposite.op g)).hom (η₂ Y c) = η₂ Z ((P₂.map (Opposite.op g)).hom c) :=
    fun g c => congrArg (fun φ => φ.hom c) (unit₂.naturality (Opposite.op g)).symm
  have hUnitNat₃ : ∀ {Y Z : C} (g : Z ⟶ Y) (c : ↑(P₃.obj (Opposite.op Y))),
      (ℱ₃.obj.map (Opposite.op g)).hom (η₃ Y c) = η₃ Z ((P₃.map (Opposite.op g)).hom c) :=
    fun g c => congrArg (fun φ => φ.hom c) (unit₃.naturality (Opposite.op g)).symm
  have hLiftIndep : ∀ {Y : C} (c₁ c₁' : ↑(P₁.obj (Opposite.op Y)))
      (c₂ c₂' : ↑(P₂.obj (Opposite.op Y))),
      η₁ Y c₁ = η₁ Y c₁' → η₂ Y c₂ = η₂ Y c₂' →
      η₃ Y (μ_pre Y c₁ c₂) = η₃ Y (μ_pre Y c₁' c₂') := by
    intro Y c₁ c₁' c₂ c₂' h₁ h₂
    let S₁ := CategoryTheory.Presheaf.equalizerSieve (F := P₁) c₁ c₁'
    let S₂ := CategoryTheory.Presheaf.equalizerSieve (F := P₂) c₂ c₂'
    have hS₁ : S₁ ∈ J Y :=
      CategoryTheory.Presheaf.IsLocallyInjective.equalizerSieve_mem (φ := unit₁) c₁ c₁' h₁
    have hS₂ : S₂ ∈ J Y :=
      CategoryTheory.Presheaf.IsLocallyInjective.equalizerSieve_mem (φ := unit₂) c₂ c₂' h₂
    refine hSep₃ (S₁ ⊓ S₂) (J.intersection_covering hS₁ hS₂) _ _ ?_
    intro Z g ⟨hg₁, hg₂⟩
    rw [hUnitNat₃, hUnitNat₃, h_nat, h_nat]
    have eq₁ : (P₁.map (Opposite.op g)).hom c₁ = (P₁.map (Opposite.op g)).hom c₁' := hg₁
    have eq₂ : (P₂.map (Opposite.op g)).hom c₂ = (P₂.map (Opposite.op g)).hom c₂' := hg₂
    rw [eq₁, eq₂]
  have hExistsVal : ∀ (W : C) (s₁ : ↑(ℱ₁.obj.obj (Opposite.op W)))
      (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))),
      ∃ s₃ : ↑(ℱ₃.obj.obj (Opposite.op W)),
        ∀ {Y : C} (f : Y ⟶ W) (c₁ : ↑(P₁.obj (Opposite.op Y))) (c₂ : ↑(P₂.obj (Opposite.op Y))),
          η₁ Y c₁ = (ℱ₁.obj.map (Opposite.op f)).hom s₁ →
          η₂ Y c₂ = (ℱ₂.obj.map (Opposite.op f)).hom s₂ →
          (ℱ₃.obj.map (Opposite.op f)).hom s₃ = η₃ Y (μ_pre Y c₁ c₂) := by
    intro W s₁ s₂
    let R₁ := CategoryTheory.Presheaf.imageSieve unit₁ s₁
    let R₂ := CategoryTheory.Presheaf.imageSieve unit₂ s₂
    let R := R₁ ⊓ R₂
    have hR : R ∈ J W :=
      J.intersection_covering
        (CategoryTheory.Presheaf.imageSieve_mem J unit₁ s₁)
        (CategoryTheory.Presheaf.imageSieve_mem J unit₂ s₂)
    let fam : ∀ {Y : C} (f : Y ⟶ W), R.arrows f → ↑(ℱ₃.obj.obj (Opposite.op Y)) :=
      fun {Y} f hf => η₃ Y (μ_pre Y (Classical.choose hf.1) (Classical.choose hf.2))
    have hCompat : ∀ {Y Z : C} (g : Z ⟶ Y) (f : Y ⟶ W) (hf : R.arrows f),
        (ℱ₃.obj.map (Opposite.op g)).hom (fam f hf) = fam (g ≫ f) (R.downward_closed hf g) := by
      intro Y Z g f hf
      dsimp only [fam]
      rw [hUnitNat₃, h_nat]
      have hc₁ : η₁ Y (Classical.choose hf.1) = (ℱ₁.obj.map (Opposite.op f)).hom s₁ :=
        Classical.choose_spec hf.1
      have hc₂ : η₂ Y (Classical.choose hf.2) = (ℱ₂.obj.map (Opposite.op f)).hom s₂ :=
        Classical.choose_spec hf.2
      have hfg := R.downward_closed hf g
      have hc₁' : η₁ Z (Classical.choose hfg.1) = (ℱ₁.obj.map (Opposite.op (g ≫ f))).hom s₁ :=
        Classical.choose_spec hfg.1
      have hc₂' : η₂ Z (Classical.choose hfg.2) = (ℱ₂.obj.map (Opposite.op (g ≫ f))).hom s₂ :=
        Classical.choose_spec hfg.2
      apply hLiftIndep
      · rw [← hUnitNat₁, hc₁, hc₁']
        exact (congrArg (fun φ => φ.hom s₁)
          (ℱ₁.obj.map_comp (Opposite.op f) (Opposite.op g))).symm
      · rw [← hUnitNat₂, hc₂, hc₂']
        exact (congrArg (fun φ => φ.hom s₂)
          (ℱ₂.obj.map_comp (Opposite.op f) (Opposite.op g))).symm
    obtain ⟨s₃, hs₃⟩ := hGlue₃ R hR fam hCompat
    refine ⟨s₃, ?_⟩
    intro Y f c₁ c₂ hc₁ hc₂
    have hfR : R.arrows f := ⟨⟨c₁, hc₁⟩, ⟨c₂, hc₂⟩⟩
    exact (hs₃ f hfR).trans
      (hLiftIndep _ _ _ _
        ((Classical.choose_spec hfR.1).trans hc₁.symm)
        ((Classical.choose_spec hfR.2).trans hc₂.symm))
  let mVal : ∀ (W : C), ↑(ℱ₁.obj.obj (Opposite.op W)) → ↑(ℱ₂.obj.obj (Opposite.op W)) →
      ↑(ℱ₃.obj.obj (Opposite.op W)) :=
    fun W s₁ s₂ => Classical.choose (hExistsVal W s₁ s₂)
  have hmSpec : ∀ (W : C) (s₁ : ↑(ℱ₁.obj.obj (Opposite.op W))) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W)))
      {Y : C} (f : Y ⟶ W) (c₁ : ↑(P₁.obj (Opposite.op Y))) (c₂ : ↑(P₂.obj (Opposite.op Y))),
      η₁ Y c₁ = (ℱ₁.obj.map (Opposite.op f)).hom s₁ →
      η₂ Y c₂ = (ℱ₂.obj.map (Opposite.op f)).hom s₂ →
      (ℱ₃.obj.map (Opposite.op f)).hom (mVal W s₁ s₂) = η₃ Y (μ_pre Y c₁ c₂) :=
    fun W s₁ s₂ {Y} f c₁ c₂ hc₁ hc₂ => Classical.choose_spec (hExistsVal W s₁ s₂) f c₁ c₂ hc₁ hc₂
  have hmUnit : ∀ (W : C) (c₁ : ↑(P₁.obj (Opposite.op W))) (c₂ : ↑(P₂.obj (Opposite.op W))),
      mVal W (η₁ W c₁) (η₂ W c₂) = η₃ W (μ_pre W c₁ c₂) := by
    intro W c₁ c₂
    have h₁ : η₁ W c₁ = (ℱ₁.obj.map (Opposite.op (𝟙 W))).hom (η₁ W c₁) :=
      (congrArg (fun φ => φ.hom (η₁ W c₁)) (ℱ₁.obj.map_id (Opposite.op W))).symm
    have h₂ : η₂ W c₂ = (ℱ₂.obj.map (Opposite.op (𝟙 W))).hom (η₂ W c₂) :=
      (congrArg (fun φ => φ.hom (η₂ W c₂)) (ℱ₂.obj.map_id (Opposite.op W))).symm
    have h₃ : (ℱ₃.obj.map (Opposite.op (𝟙 W))).hom (mVal W (η₁ W c₁) (η₂ W c₂)) =
        mVal W (η₁ W c₁) (η₂ W c₂) :=
      congrArg
        (fun φ : ℱ₃.obj.obj (Opposite.op W) ⟶ ℱ₃.obj.obj (Opposite.op W) =>
          φ.hom (mVal W (η₁ W c₁) (η₂ W c₂)))
        (ℱ₃.obj.map_id (Opposite.op W))
    exact h₃.symm.trans (hmSpec W (η₁ W c₁) (η₂ W c₂) (𝟙 W) c₁ c₂ h₁ h₂)
  have hmZero₂ : ∀ (W : C) (s₁ : ↑(ℱ₁.obj.obj (Opposite.op W))), mVal W s₁ 0 = 0 := by
    intro W s₁
    refine hSep₃ (CategoryTheory.Presheaf.imageSieve unit₁ s₁)
      (CategoryTheory.Presheaf.imageSieve_mem J unit₁ s₁) _ _ ?_
    intro Y f ⟨c₁, hc₁⟩
    rw [map_zero, hmSpec W s₁ 0 f c₁ 0 hc₁ ((map_zero _).trans (map_zero _).symm),
      map_zero, map_zero]
  have hmAdd₂ : ∀ (W : C) (s₁ : ↑(ℱ₁.obj.obj (Opposite.op W)))
      (s₂ s₂' : ↑(ℱ₂.obj.obj (Opposite.op W))),
      mVal W s₁ (s₂ + s₂') = mVal W s₁ s₂ + mVal W s₁ s₂' := by
    intro W s₁ s₂ s₂'
    have hR : (CategoryTheory.Presheaf.imageSieve unit₁ s₁ ⊓
        CategoryTheory.Presheaf.imageSieve unit₂ s₂) ⊓
        CategoryTheory.Presheaf.imageSieve unit₂ s₂' ∈ J W :=
      J.intersection_covering
        (J.intersection_covering
          (CategoryTheory.Presheaf.imageSieve_mem J unit₁ s₁)
          (CategoryTheory.Presheaf.imageSieve_mem J unit₂ s₂))
        (CategoryTheory.Presheaf.imageSieve_mem J unit₂ s₂')
    refine hSep₃ _ hR _ _ ?_
    intro Y f ⟨⟨⟨c₁, hc₁⟩, ⟨c₂, hc₂⟩⟩, ⟨c₂', hc₂'⟩⟩
    have hc₂_add : η₂ Y (c₂ + c₂') = (ℱ₂.obj.map (Opposite.op f)).hom (s₂ + s₂') := by
      rw [map_add, map_add]
      exact congrArg₂ (· + ·) hc₂ hc₂'
    rw [map_add, hmSpec W s₁ (s₂ + s₂') f c₁ (c₂ + c₂') hc₁ hc₂_add,
      hmSpec W s₁ s₂ f c₁ c₂ hc₁ hc₂, hmSpec W s₁ s₂' f c₁ c₂' hc₁ hc₂',
      map_add, map_add]
  have hmZero₁ : ∀ (W : C) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))), mVal W 0 s₂ = 0 := by
    intro W s₂
    refine hSep₃ (CategoryTheory.Presheaf.imageSieve unit₂ s₂)
      (CategoryTheory.Presheaf.imageSieve_mem J unit₂ s₂) _ _ ?_
    intro Y f ⟨c₂, hc₂⟩
    rw [map_zero, hmSpec W 0 s₂ f 0 c₂ ((map_zero _).trans (map_zero _).symm) hc₂,
      AddMonoidHom.map_zero, AddMonoidHom.zero_apply, map_zero]
  have hmAdd₁ : ∀ (W : C) (s₁ s₁' : ↑(ℱ₁.obj.obj (Opposite.op W)))
      (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))),
      mVal W (s₁ + s₁') s₂ = mVal W s₁ s₂ + mVal W s₁' s₂ := by
    intro W s₁ s₁' s₂
    have hR : (CategoryTheory.Presheaf.imageSieve unit₁ s₁ ⊓
        CategoryTheory.Presheaf.imageSieve unit₁ s₁') ⊓
        CategoryTheory.Presheaf.imageSieve unit₂ s₂ ∈ J W :=
      J.intersection_covering
        (J.intersection_covering
          (CategoryTheory.Presheaf.imageSieve_mem J unit₁ s₁)
          (CategoryTheory.Presheaf.imageSieve_mem J unit₁ s₁'))
        (CategoryTheory.Presheaf.imageSieve_mem J unit₂ s₂)
    refine hSep₃ _ hR _ _ ?_
    intro Y f ⟨⟨⟨c₁, hc₁⟩, ⟨c₁', hc₁'⟩⟩, ⟨c₂, hc₂⟩⟩
    have hc₁_add : η₁ Y (c₁ + c₁') = (ℱ₁.obj.map (Opposite.op f)).hom (s₁ + s₁') := by
      rw [map_add, map_add]
      exact congrArg₂ (· + ·) hc₁ hc₁'
    rw [map_add, hmSpec W (s₁ + s₁') s₂ f (c₁ + c₁') c₂ hc₁_add hc₂,
      hmSpec W s₁ s₂ f c₁ c₂ hc₁ hc₂, hmSpec W s₁' s₂ f c₁' c₂ hc₁' hc₂,
      AddMonoidHom.map_add, AddMonoidHom.add_apply, map_add]
  have hmNat : ∀ {W₁ W₂ : C} (u : W₁ ⟶ W₂)
      (s₁ : ↑(ℱ₁.obj.obj (Opposite.op W₂))) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W₂))),
      (ℱ₃.obj.map (Opposite.op u)).hom (mVal W₂ s₁ s₂) =
        mVal W₁ ((ℱ₁.obj.map (Opposite.op u)).hom s₁) ((ℱ₂.obj.map (Opposite.op u)).hom s₂) := by
    intro W₁ W₂ u s₁ s₂
    let s₁' := (ℱ₁.obj.map (Opposite.op u)).hom s₁
    let s₂' := (ℱ₂.obj.map (Opposite.op u)).hom s₂
    have hR : CategoryTheory.Presheaf.imageSieve unit₁ s₁' ⊓
        CategoryTheory.Presheaf.imageSieve unit₂ s₂' ∈ J W₁ :=
      J.intersection_covering
        (CategoryTheory.Presheaf.imageSieve_mem J unit₁ s₁')
        (CategoryTheory.Presheaf.imageSieve_mem J unit₂ s₂')
    refine hSep₃ _ hR _ _ ?_
    intro Y f ⟨⟨c₁, hc₁⟩, ⟨c₂, hc₂⟩⟩
    have hc₁_fu : η₁ Y c₁ = (ℱ₁.obj.map (Opposite.op (f ≫ u))).hom s₁ :=
      (hc₁ : η₁ Y c₁ = (ℱ₁.obj.map (Opposite.op f)).hom s₁').trans
        (congrArg (fun φ => φ.hom s₁)
          (ℱ₁.obj.map_comp (Opposite.op u) (Opposite.op f))).symm
    have hc₂_fu : η₂ Y c₂ = (ℱ₂.obj.map (Opposite.op (f ≫ u))).hom s₂ :=
      (hc₂ : η₂ Y c₂ = (ℱ₂.obj.map (Opposite.op f)).hom s₂').trans
        (congrArg (fun φ => φ.hom s₂)
          (ℱ₂.obj.map_comp (Opposite.op u) (Opposite.op f))).symm
    have hLHS : (ℱ₃.obj.map (Opposite.op f)).hom ((ℱ₃.obj.map (Opposite.op u)).hom (mVal W₂ s₁ s₂)) =
        (ℱ₃.obj.map (Opposite.op (f ≫ u))).hom (mVal W₂ s₁ s₂) :=
      (congrArg (fun φ => φ.hom (mVal W₂ s₁ s₂))
        (ℱ₃.obj.map_comp (Opposite.op u) (Opposite.op f))).symm
    rw [hLHS, hmSpec W₂ s₁ s₂ (f ≫ u) c₁ c₂ hc₁_fu hc₂_fu,
      hmSpec W₁ s₁' s₂' f c₁ c₂ hc₁ hc₂]
  exact ⟨fun W =>
    { toFun := fun s₁ =>
        { toFun := fun s₂ => mVal W s₁ s₂
          map_zero' := hmZero₂ W s₁
          map_add' := fun s₂ s₂' => hmAdd₂ W s₁ s₂ s₂' }
      map_zero' := AddMonoidHom.ext fun s₂ => hmZero₁ W s₂
      map_add' := fun s₁ s₁' => AddMonoidHom.ext fun s₂ => hmAdd₁ W s₁ s₁' s₂ },
    fun u s₁ s₂ => hmNat u s₁ s₂, fun W c₁ c₂ => hmUnit W c₁ c₂⟩

theorem weil_mid_dev_raw_sheaf_cup_pairing_comm (F : Type u) [Field F]
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (ℓ m r : ℕ) :
    let g₀ := f₀.left ∣_ U₀
    let X₀ := (f₀.left ⁻¹ᵁ U₀).toScheme
    let F_X₀ := weilEtaleTorsionSheaf X₀ (ℓ ^ (r + 1))
    let ℛ_mid := weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r
    let ℛ_top := weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * (2 * m + 1)) r
    let P_pre : ℕ → CategoryTheory.Functor (Opposite U₀.toScheme.Etale) AddCommGrpCat.{u} :=
      fun q => CategoryTheory.Functor.comp (weilEtaleSitePullback g₀).op
        (CategoryTheory.Sheaf.cohomologyPresheaf F_X₀ q)
    let η_unit : ∀ (q : ℕ) (Y : U₀.toScheme.Etale),
        ↑((P_pre q).obj (Opposite.op Y)) →+
          ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.obj (Opposite.op Y)) :=
      fun q Y =>
        (((CategoryTheory.sheafificationAdjunction U₀.toScheme.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app (P_pre q)).app (Opposite.op Y)).hom
    let hT_X₀ := weilEtaleIdTerminalIsTerminal.{u} X₀
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
    ∃ μ_ℛ : ∀ W : U₀.toScheme.Etale,
        ↑(ℛ_mid.obj.obj (Opposite.op W)) →+
          ↑(ℛ_mid.obj.obj (Opposite.op W)) →+
          ↑(ℛ_top.obj.obj (Opposite.op W)),
      (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂)
          (s₁ s₂ : ↑(ℛ_mid.obj.obj (Opposite.op W₂))),
        (ℛ_top.obj.map (Opposite.op u)).hom (μ_ℛ W₂ s₁ s₂) =
          μ_ℛ W₁ ((ℛ_mid.obj.map (Opposite.op u)).hom s₁)
            ((ℛ_mid.obj.map (Opposite.op u)).hom s₂)) ∧
      (∀ (Y : U₀.toScheme.Etale)
          (S_fib : AlgebraicGeometry.Scheme.{u})
          (h_fib : Quiver.Hom S_fib X₀)
          (d_fib : WeilEtaleSitePullbackData S_fib X₀ h_fib)
          (l_Y : Quiver.Hom (weilEtaleIdTerminal.{u} S_fib)
            ((weilEtaleSitePullback h_fib).obj ((weilEtaleSitePullback g₀).obj Y)))
          (θ_mid : weilEtaleModuleH S_fib (ℓ ^ (r + 1)) (2 * m + 1) →+
            weilEtaleTorsionH S_fib (ℓ ^ (r + 1)) (2 * m + 1))
          (θ_top : weilEtaleModuleH S_fib (ℓ ^ (r + 1)) (2 * (2 * m + 1)) →+
            weilEtaleTorsionH S_fib (ℓ ^ (r + 1)) (2 * (2 * m + 1))),
        WeilIsModuleToTorsionComparison S_fib (ℓ ^ (r + 1)) (2 * m + 1) θ_mid →
        WeilIsModuleToTorsionComparison S_fib (ℓ ^ (r + 1)) (2 * (2 * m + 1)) θ_top →
        letI := d_fib.hCont
        letI := d_fib.hAdj
        letI := d_fib.hAdd_pb
        letI := d_fib.hLim_pb
        letI := d_fib.hColim_pb
        let pb_fib := (weilEtaleSitePullback h_fib).sheafPullback AddCommGrpCat.{u}
          X₀.smallEtaleTopology S_fib.smallEtaleTopology
        let W_Y := (weilEtaleSitePullback g₀).obj Y
        let T_fib := weilEtaleIdTerminal.{u} S_fib
        let hT_fib := weilEtaleIdTerminalIsTerminal.{u} S_fib
        ∀ (c₁ c₂ : ↑((P_pre (2 * m + 1)).obj (Opposite.op Y)))
          (a b : weilEtaleModuleH S_fib (ℓ ^ (r + 1)) (2 * m + 1)),
          (CategoryTheory.Abelian.Ext.mk₀
              (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
            (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero (2 * m + 1))
            (((CategoryTheory.Abelian.Ext.mk₀
                (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
              (pb_fib.obj F_X₀) (Nat.zero_add (2 * m + 1)))
              ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀ (2 * m + 1))
                c₁)) =
            weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
              (weilEtaleTorsionSheaf S_fib (ℓ ^ (r + 1))) (2 * m + 1) (θ_mid a) →
          (CategoryTheory.Abelian.Ext.mk₀
              (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
            (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero (2 * m + 1))
            (((CategoryTheory.Abelian.Ext.mk₀
                (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
              (pb_fib.obj F_X₀) (Nat.zero_add (2 * m + 1)))
              ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀ (2 * m + 1))
                c₂)) =
            weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
              (weilEtaleTorsionSheaf S_fib (ℓ ^ (r + 1))) (2 * m + 1) (θ_mid b) →
          ∃ c_top : ↑((P_pre (2 * (2 * m + 1))).obj (Opposite.op Y)),
            μ_ℛ Y (η_unit (2 * m + 1) Y c₁) (η_unit (2 * m + 1) Y c₂) =
              η_unit (2 * (2 * m + 1)) Y c_top ∧
            (CategoryTheory.Abelian.Ext.mk₀
                (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
              (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero (2 * (2 * m + 1)))
              (((CategoryTheory.Abelian.Ext.mk₀
                  (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
                (pb_fib.obj F_X₀) (Nat.zero_add (2 * (2 * m + 1))))
                ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀
                  (2 * (2 * m + 1))) c_top)) =
              weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
                (weilEtaleTorsionSheaf S_fib (ℓ ^ (r + 1))) (2 * (2 * m + 1))
                (θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm))) :=
by
  have hMain :
      ∀ (X₀ S₀ : AlgebraicGeometry.Scheme.{u}) (g₀ : Quiver.Hom X₀ S₀) (m₀ m : ℕ),
        let F_X₀ := weilEtaleTorsionSheaf X₀ m₀
        let ℛ_mid := weilEtaleHigherDirectImage g₀ (2 * m + 1) F_X₀
        let ℛ_top := weilEtaleHigherDirectImage g₀ (2 * (2 * m + 1)) F_X₀
        let P_pre : ℕ → CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
          fun q => CategoryTheory.Functor.comp (weilEtaleSitePullback g₀).op
            (CategoryTheory.Sheaf.cohomologyPresheaf F_X₀ q)
        let η_unit : ∀ (q : ℕ) (Y : S₀.Etale),
            ↑((P_pre q).obj (Opposite.op Y)) →+
              ↑((weilEtaleHigherDirectImage g₀ q F_X₀).obj.obj (Opposite.op Y)) :=
          fun q Y =>
            (((CategoryTheory.sheafificationAdjunction S₀.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app (P_pre q)).app (Opposite.op Y)).hom
        let hT_X₀ := weilEtaleIdTerminalIsTerminal.{u} X₀
        let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
        ∃ μ_ℛ : ∀ W : S₀.Etale,
            ↑(ℛ_mid.obj.obj (Opposite.op W)) →+
              ↑(ℛ_mid.obj.obj (Opposite.op W)) →+
              ↑(ℛ_top.obj.obj (Opposite.op W)),
          (∀ {W₁ W₂ : S₀.Etale} (u : Quiver.Hom W₁ W₂)
              (s₁ s₂ : ↑(ℛ_mid.obj.obj (Opposite.op W₂))),
            (ℛ_top.obj.map (Opposite.op u)).hom (μ_ℛ W₂ s₁ s₂) =
              μ_ℛ W₁ ((ℛ_mid.obj.map (Opposite.op u)).hom s₁)
                ((ℛ_mid.obj.map (Opposite.op u)).hom s₂)) ∧
          (∀ (Y : S₀.Etale)
              (S_fib : AlgebraicGeometry.Scheme.{u})
              (h_fib : Quiver.Hom S_fib X₀)
              (d_fib : WeilEtaleSitePullbackData S_fib X₀ h_fib)
              (l_Y : Quiver.Hom (weilEtaleIdTerminal.{u} S_fib)
                ((weilEtaleSitePullback h_fib).obj ((weilEtaleSitePullback g₀).obj Y)))
              (θ_mid : weilEtaleModuleH S_fib m₀ (2 * m + 1) →+
                weilEtaleTorsionH S_fib m₀ (2 * m + 1))
              (θ_top : weilEtaleModuleH S_fib m₀ (2 * (2 * m + 1)) →+
                weilEtaleTorsionH S_fib m₀ (2 * (2 * m + 1))),
            WeilIsModuleToTorsionComparison S_fib m₀ (2 * m + 1) θ_mid →
            WeilIsModuleToTorsionComparison S_fib m₀ (2 * (2 * m + 1)) θ_top →
            letI := d_fib.hCont
            letI := d_fib.hAdj
            letI := d_fib.hAdd_pb
            letI := d_fib.hLim_pb
            letI := d_fib.hColim_pb
            let pb_fib := (weilEtaleSitePullback h_fib).sheafPullback AddCommGrpCat.{u}
              X₀.smallEtaleTopology S_fib.smallEtaleTopology
            let W_Y := (weilEtaleSitePullback g₀).obj Y
            let T_fib := weilEtaleIdTerminal.{u} S_fib
            let hT_fib := weilEtaleIdTerminalIsTerminal.{u} S_fib
            ∀ (c₁ c₂ : ↑((P_pre (2 * m + 1)).obj (Opposite.op Y)))
              (a b : weilEtaleModuleH S_fib m₀ (2 * m + 1)),
              (CategoryTheory.Abelian.Ext.mk₀
                  (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
                (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero (2 * m + 1))
                (((CategoryTheory.Abelian.Ext.mk₀
                    (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
                  (pb_fib.obj F_X₀) (Nat.zero_add (2 * m + 1)))
                  ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀ (2 * m + 1))
                    c₁)) =
                weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
                  (weilEtaleTorsionSheaf S_fib m₀) (2 * m + 1) (θ_mid a) →
              (CategoryTheory.Abelian.Ext.mk₀
                  (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
                (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero (2 * m + 1))
                (((CategoryTheory.Abelian.Ext.mk₀
                    (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
                  (pb_fib.obj F_X₀) (Nat.zero_add (2 * m + 1)))
                  ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀ (2 * m + 1))
                    c₂)) =
                weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
                  (weilEtaleTorsionSheaf S_fib m₀) (2 * m + 1) (θ_mid b) →
              ∃ c_top : ↑((P_pre (2 * (2 * m + 1))).obj (Opposite.op Y)),
                μ_ℛ Y (η_unit (2 * m + 1) Y c₁) (η_unit (2 * m + 1) Y c₂) =
                  η_unit (2 * (2 * m + 1)) Y c_top ∧
                (CategoryTheory.Abelian.Ext.mk₀
                    (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
                  (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero (2 * (2 * m + 1)))
                  (((CategoryTheory.Abelian.Ext.mk₀
                      (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
                    (pb_fib.obj F_X₀) (Nat.zero_add (2 * (2 * m + 1))))
                    ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀
                      (2 * (2 * m + 1))) c_top)) =
                  weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
                    (weilEtaleTorsionSheaf S_fib m₀) (2 * (2 * m + 1))
                    (θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm))) := by
    clear F Z_tilde f₀ U₀ ℓ m r ‹Field F›
    intro X₀ S₀ g₀ m₀ m F_X₀ ℛ_mid ℛ_top P_pre η_unit hT_X₀ AM
    let d_mid := 2 * m + 1
    let d_top := 2 * (2 * m + 1)
    have h_deg : d_mid + d_mid = d_top := (Nat.two_mul (2 * m + 1)).symm
    obtain ⟨cup_tors, hCupComp, hCupPull⟩ :=
      weil_mid_dev_raw_cup_torsion_pullback_comm m₀ d_mid d_mid d_top h_deg
    obtain ⟨Θ_mid, hΘ_mid_nat, hΘ_mid_fib⟩ :=
      weil_mid_dev_raw_cup_presheaf_slice_pullback_iso X₀ m₀ d_mid
    obtain ⟨Θ_top, hΘ_top_nat, hΘ_top_fib⟩ :=
      weil_mid_dev_raw_cup_presheaf_slice_pullback_iso X₀ m₀ d_top
    let B_g₀ := weilEtaleSitePullback g₀
    let μ_pre : ∀ Y : S₀.Etale,
        ↑((P_pre d_mid).obj (Opposite.op Y)) →+
          ↑((P_pre d_mid).obj (Opposite.op Y)) →+
            ↑((P_pre d_top).obj (Opposite.op Y)) :=
      fun Y =>
        let W_Y := B_g₀.obj Y
        let W_sch := ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj W_Y).left
        AddMonoidHom.mk'
          (fun c₁ =>
            AddMonoidHom.mk'
              (fun c₂ =>
                (Θ_top W_Y).symm (cup_tors W_sch (Θ_mid W_Y c₁) (Θ_mid W_Y c₂)))
              (fun c₂ c₂' => by rw [map_add, map_add, map_add]))
          (fun c₁ c₁' => AddMonoidHom.ext fun c₂ => by
            change (Θ_top W_Y).symm (cup_tors W_sch (Θ_mid W_Y (c₁ + c₁')) (Θ_mid W_Y c₂)) =
              (Θ_top W_Y).symm (cup_tors W_sch (Θ_mid W_Y c₁) (Θ_mid W_Y c₂)) +
              (Θ_top W_Y).symm (cup_tors W_sch (Θ_mid W_Y c₁') (Θ_mid W_Y c₂))
            rw [map_add, AddMonoidHom.map_add, AddMonoidHom.add_apply, map_add])
    have h_pre_nat : ∀ {Y₁ Y₂ : S₀.Etale} (u : Quiver.Hom Y₁ Y₂)
        (c₁ : ↑((P_pre d_mid).obj (Opposite.op Y₂)))
        (c₂ : ↑((P_pre d_mid).obj (Opposite.op Y₂))),
        ((P_pre d_top).map (Opposite.op u)).hom (μ_pre Y₂ c₁ c₂) =
          μ_pre Y₁ (((P_pre d_mid).map (Opposite.op u)).hom c₁)
            (((P_pre d_mid).map (Opposite.op u)).hom c₂) := by
      intro Y₁ Y₂ u c₁ c₂
      let g_u : Quiver.Hom (B_g₀.obj Y₁) (B_g₀.obj Y₂) := B_g₀.map u
      let h_u := ((AlgebraicGeometry.Scheme.Etale.forget X₀).map g_u).left
      obtain ⟨p_mid, hp_mid⟩ := weil_etale_torsion_pullback_functoriality.1 h_u m₀ d_mid
      obtain ⟨p_top, hp_top⟩ := weil_etale_torsion_pullback_functoriality.1 h_u m₀ d_top
      apply (Θ_top (B_g₀.obj Y₁)).injective
      refine (hΘ_top_nat g_u p_top hp_top (μ_pre Y₂ c₁ c₂)).trans ?_
      have h_symm₁ : Θ_top (B_g₀.obj Y₂) (μ_pre Y₂ c₁ c₂) =
          cup_tors ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj (B_g₀.obj Y₂)).left
            (Θ_mid (B_g₀.obj Y₂) c₁) (Θ_mid (B_g₀.obj Y₂) c₂) :=
        AddEquiv.apply_symm_apply (Θ_top (B_g₀.obj Y₂)) _
      have h_symm₂ : Θ_top (B_g₀.obj Y₁)
          (μ_pre Y₁ (((P_pre d_mid).map (Opposite.op u)).hom c₁)
            (((P_pre d_mid).map (Opposite.op u)).hom c₂)) =
          cup_tors ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj (B_g₀.obj Y₁)).left
            (Θ_mid (B_g₀.obj Y₁) (((P_pre d_mid).map (Opposite.op u)).hom c₁))
            (Θ_mid (B_g₀.obj Y₁) (((P_pre d_mid).map (Opposite.op u)).hom c₂)) :=
        AddEquiv.apply_symm_apply (Θ_top (B_g₀.obj Y₁)) _
      refine Eq.trans ?_ h_symm₂.symm
      refine (congrArg p_top h_symm₁).trans ?_
      refine (hCupPull h_u p_mid p_mid p_top hp_mid hp_mid hp_top _ _).trans ?_
      exact congrArg₂ (fun x y => cup_tors _ x y)
        (hΘ_mid_nat g_u p_mid hp_mid c₁).symm
        (hΘ_mid_nat g_u p_mid hp_mid c₂).symm
    obtain ⟨μ_ℛ, hμ_nat, hμ_unit⟩ :=
      weil_mid_dev_raw_cup_sheafify_bilinear_pairing S₀.Etale S₀.smallEtaleTopology
        (P_pre d_mid) (P_pre d_mid) (P_pre d_top) μ_pre h_pre_nat
    refine ⟨μ_ℛ, hμ_nat, ?_⟩
    intro Y S_fib h_fib d_fib l_Y θ_mid θ_top hθ_mid hθ_top pb_fib W_Y T_fib hT_fib c₁ c₂ a b hc₁ hc₂
    let W_sch := ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj W_Y).left
    let w_hom := ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj W_Y).hom
    let ι_Y : Quiver.Hom S_fib W_sch :=
      CategoryTheory.CategoryStruct.comp
        ((AlgebraicGeometry.Scheme.Etale.forget S_fib).map l_Y).left
        (CategoryTheory.Limits.pullback.fst w_hom h_fib)
    obtain ⟨p_ι_mid, hp_ι_mid⟩ := weil_etale_torsion_pullback_functoriality.1 ι_Y m₀ d_mid
    obtain ⟨p_ι_top, hp_ι_top⟩ := weil_etale_torsion_pullback_functoriality.1 ι_Y m₀ d_top
    obtain ⟨hBij_mid, hFib_mid⟩ := hΘ_mid_fib W_Y S_fib h_fib d_fib l_Y
    obtain ⟨_, hFib_top⟩ := hΘ_top_fib W_Y S_fib h_fib d_fib l_Y
    have ha_eq : p_ι_mid (Θ_mid W_Y c₁) = θ_mid a :=
      hBij_mid.1 ((hFib_mid p_ι_mid hp_ι_mid c₁).symm.trans hc₁)
    have hb_eq : p_ι_mid (Θ_mid W_Y c₂) = θ_mid b :=
      hBij_mid.1 ((hFib_mid p_ι_mid hp_ι_mid c₂).symm.trans hc₂)
    let c_top := μ_pre Y c₁ c₂
    refine ⟨c_top, hμ_unit Y c₁ c₂, ?_⟩
    refine (hFib_top p_ι_top hp_ι_top c_top).trans ?_
    apply congrArg (weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
      (weilEtaleTorsionSheaf S_fib m₀) d_top)
    have h_symm_top : Θ_top W_Y c_top = cup_tors W_sch (Θ_mid W_Y c₁) (Θ_mid W_Y c₂) :=
      AddEquiv.apply_symm_apply (Θ_top W_Y) _
    refine (congrArg p_ι_top h_symm_top).trans ?_
    refine (hCupPull ι_Y p_ι_mid p_ι_mid p_ι_top hp_ι_mid hp_ι_mid hp_ι_top _ _).trans ?_
    rw [ha_eq, hb_eq]
    exact hCupComp S_fib θ_mid θ_mid θ_top hθ_mid hθ_mid hθ_top a b
  exact hMain (f₀.left ⁻¹ᵁ U₀).toScheme U₀.toScheme (f₀.left ∣_ U₀) (ℓ ^ (r + 1)) m

theorem weil_mid_dev_closed_open_smooth_raw_monodromy_and_cup (F : Type u) [Finite F] [Field F] (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (hFibIrred : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver F 1).left),
      IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left s))
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_u₀.hom]
    [AlgebraicGeometry.IsProper Z_u₀.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_u₀.hom]
    (hProj_Zu₀ : IsProjectiveOverField F Z_u₀)
    (ι_Zu₀ : Z_u₀.left ⟶ Z_tilde.left)
    (hPb_Zu₀ : CategoryTheory.IsPullback ι_Zu₀ Z_u₀.hom f₀.left u₀)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (hSm_U₀ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀))
    (a₀ : F) (ha₀ : a₀ ∉ S_aff)
    (hu₀_eq : u₀ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀)) ≫ j_aff)
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU_eq : e_U.hom ≫ U₀.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F)
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))) ≫
        j_aff)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) :
    Nonempty (WeilMidDevClosedRawTorsionTower.{u} F m Z_tilde f₀ Z_u₀ j_aff S_aff U₀ a₀ e_U ℓ) :=
by
  classical
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out
  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  let R₀ := Localization.Away Δ_aff

  
  have hΔ_mon : Δ_aff.Monic :=
    Polynomial.monic_prod_of_monic _ _ fun s _ => Polynomial.monic_X_sub_C s
  have hΔ_ne : Δ_aff ≠ 0 := hΔ_mon.ne_zero
  have hPowers_le : Submonoid.powers Δ_aff ≤ nonZeroDivisors (Polynomial F) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hΔ_ne)
  have hDom_R₀ : IsDomain R₀ := IsLocalization.isDomain_of_le_nonZeroDivisors _ hPowers_le
  letI : IsDomain R₀ := hDom_R₀
  have hDed_R₀ : IsDedekindDomain R₀ :=
    IsLocalization.isDedekindDomain (Polynomial F) hPowers_le R₀
  letI : IsDedekindDomain R₀ := hDed_R₀
  have hPF_RF_inj : Function.Injective (algebraMap (Polynomial F) (RatFunc F)) :=
    IsFractionRing.injective (Polynomial F) (RatFunc F)
  have hΔ_RF_unit : IsUnit (algebraMap (Polynomial F) (RatFunc F) Δ_aff) :=
    IsUnit.mk0 _ fun h0 => hΔ_ne (hPF_RF_inj (h0.trans (map_zero _).symm))
  let φ_R₀_RF : R₀ →+* RatFunc F := IsLocalization.Away.lift Δ_aff hΔ_RF_unit
  letI : Algebra R₀ (RatFunc F) := φ_R₀_RF.toAlgebra
  have hφ_comp : ∀ p : Polynomial F,
      algebraMap R₀ (RatFunc F) (algebraMap (Polynomial F) R₀ p) =
        algebraMap (Polynomial F) (RatFunc F) p :=
    fun p => IsLocalization.Away.lift_eq Δ_aff hΔ_RF_unit p
  letI : IsScalarTower (Polynomial F) R₀ (RatFunc F) :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext hφ_comp).symm
  have hφ_inj : Function.Injective (algebraMap R₀ (RatFunc F)) := by
    rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    rw [RingHom.mem_ker] at hx
    obtain ⟨⟨p, s⟩, hps⟩ := IsLocalization.surj (Submonoid.powers Δ_aff) x
    have hp0 : algebraMap (Polynomial F) (RatFunc F) p = 0 := by
      rw [← hφ_comp p, ← hps, map_mul, hx, zero_mul]
    have hp : p = 0 := hPF_RF_inj (hp0.trans (map_zero _).symm)
    rw [hp, map_zero] at hps
    exact (IsLocalization.map_units R₀ s).mul_left_eq_zero.mp hps
  have hFrac_R₀_RF : IsFractionRing R₀ (RatFunc F) := by
    refine
      { map_units := fun y => ?_
        surj := fun z => ?_
        exists_of_eq := fun {x y} hxy => ⟨1, by simp [hφ_inj hxy]⟩ }
    · have hy_ne : (y : R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      exact IsUnit.mk0 _ fun h0 => hy_ne (hφ_inj (h0.trans (map_zero _).symm))
    · obtain ⟨⟨p, q⟩, hpq⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial F)) z
      have hq_ne : (q : Polynomial F) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp q.2
      have hqR_ne : algebraMap (Polynomial F) R₀ q.1 ≠ 0 := by
        intro h0
        have : algebraMap (Polynomial F) (RatFunc F) q.1 = 0 := by
          rw [← hφ_comp q.1, h0, map_zero]
        exact hq_ne (hPF_RF_inj (this.trans (map_zero _).symm))
      refine ⟨(algebraMap (Polynomial F) R₀ p,
        ⟨algebraMap (Polynomial F) R₀ q.1, mem_nonZeroDivisors_of_ne_zero hqR_ne⟩), ?_⟩
      dsimp only
      rw [hφ_comp, hφ_comp]
      exact hpq
  letI : IsFractionRing R₀ (RatFunc F) := hFrac_R₀_RF

  obtain ⟨hMod1, _, hMod3⟩ := weil_etale_module_ext_comparison.{u}
  obtain ⟨hGalIdemp, _, _⟩ := weil_etale_galois_domain_idempotents_and_aut_lift.{u}

  
  let prevIdx : ℕ → ℕ
    | 0 => 0
    | r + 1 => r
  let sheafFam : ℕ → Fin 4 → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u} :=
    fun r =>
      ![weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r,
        weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * (2 * m + 1)) r,
        weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) (prevIdx r),
        weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * (2 * m + 1)) (prevIdx r)]
  have hLC_fam : ∀ (r : ℕ) (i : Fin 4) (x : ↥U₀.toScheme),
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U₀.toScheme) (A₀ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale w ∧
        x ∈ Set.range w.base ∧
        Finite ↥A₀ ∧
        WeilIsEtaleSheafPullback w (sheafFam r i)
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) := by
    intro r i x
    fin_cases i <;>
      exact weil_mid_dev_raw_open_smooth_prime_power_locConst F (2 * m + 1) Z_tilde hProj_Ztilde
        f₀ j_aff hj_open hj_hom S_aff U₀ hU₀_eq hSm_U₀ e_U heU_eq ℓ hℓ _ _ x

  let StepValid (r : ℕ)
      (E : IntermediateField (RatFunc F) (AlgebraicClosure (RatFunc F))) : Prop :=
    FiniteDimensional (RatFunc F) ↥E ∧
    IsGalois (RatFunc F) ↥E ∧
    letI : Algebra R₀ ↥E :=
      ((algebraMap (RatFunc F) ↥E).comp (algebraMap R₀ (RatFunc F))).toAlgebra
    let B_E := ↥(integralClosure R₀ ↥E)
    let π_E : AlgebraicGeometry.Spec (CommRingCat.of B_E) ⟶ U₀.toScheme :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_E)) ≫ e_U.hom
    Module.Finite R₀ B_E ∧
    Algebra.Etale R₀ B_E ∧
    ∀ i : Fin 4,
      ∃ A_i : AddCommGrpCat.{u},
        Finite ↥A_i ∧
        WeilIsEtaleSheafPullback π_E (sheafFam r i)
          ((CategoryTheory.constantSheaf
            (AlgebraicGeometry.Spec (CommRingCat.of B_E)).smallEtaleTopology
            AddCommGrpCat.{u}).obj A_i)

  have hBaseStep : ∃ E₀, StepValid 0 E₀ := by
    obtain ⟨E₀, hFD₀, hGal₀, _, hFin₀, hEt₀, hPull₀⟩ :=
      weil_mid_dev_raw_dedekind_galois_global_cover_of_locConst F S_aff a₀ ha₀ U₀.toScheme e_U
        (⊥ : IntermediateField (RatFunc F) (AlgebraicClosure (RatFunc F)))
        (Or.inl rfl) 4 (sheafFam 0) (hLC_fam 0)
    exact ⟨E₀, hFD₀, hGal₀, hFin₀, hEt₀, hPull₀⟩

  have hNextStep : ∀ (r : ℕ)
      (E : IntermediateField (RatFunc F) (AlgebraicClosure (RatFunc F))),
      StepValid r E →
      ∃ E', E ≤ E' ∧ StepValid (r + 1) E' := by
    intro r E ⟨hFD, hGal, _, hEt, _⟩
    letI : FiniteDimensional (RatFunc F) ↥E := hFD
    letI : IsGalois (RatFunc F) ↥E := hGal
    obtain ⟨E', hFD', hGal', hle, hFin', hEt', hPull'⟩ :=
      weil_mid_dev_raw_dedekind_galois_global_cover_of_locConst F S_aff a₀ ha₀ U₀.toScheme e_U
        E (Or.inr hEt) 4 (sheafFam (r + 1)) (hLC_fam (r + 1))
    exact ⟨E', hle, hFD', hGal', hFin', hEt', hPull'⟩

  let towerRec : ∀ r : ℕ, { E // StepValid r E } :=
    Nat.rec
      ⟨Classical.choose hBaseStep, Classical.choose_spec hBaseStep⟩
      (fun r prev =>
        ⟨Classical.choose (hNextStep r prev.1 prev.2),
          (Classical.choose_spec (hNextStep r prev.1 prev.2)).2⟩)
  let L_fld : ℕ → IntermediateField (RatFunc F) (AlgebraicClosure (RatFunc F)) :=
    fun r => (towerRec r).1
  have hL_mono : ∀ r : ℕ, L_fld r ≤ L_fld (r + 1) :=
    fun r => (Classical.choose_spec (hNextStep r (towerRec r).1 (towerRec r).2)).1
  have hL_valid : ∀ r : ℕ, StepValid r (L_fld r) := fun r => (towerRec r).2

  let L_raw : ℕ → Type u := fun r => ↥(L_fld r)
  let hFld : ∀ r, Field (L_raw r) := fun r => inferInstance
  let hARF_L : ∀ r, Algebra (RatFunc F) (L_raw r) := fun r => inferInstance
  have hFD_L : ∀ r, letI := hFld r; letI := hARF_L r; FiniteDimensional (RatFunc F) (L_raw r) :=
    fun r => (hL_valid r).1
  have hGal_L : ∀ r, letI := hFld r; letI := hARF_L r; IsGalois (RatFunc F) (L_raw r) :=
    fun r => (hL_valid r).2.1
  let hARL : ∀ r, Algebra R₀ (L_raw r) :=
    fun r => ((algebraMap (RatFunc F) (L_raw r)).comp (algebraMap R₀ (RatFunc F))).toAlgebra
  let hAP_L : ∀ r, Algebra (Polynomial F) (L_raw r) :=
    fun r =>
      letI := hARL r
      ((algebraMap R₀ (L_raw r)).comp (algebraMap (Polynomial F) R₀)).toAlgebra
  let hAF_L : ∀ r, Algebra F (L_raw r) :=
    fun r =>
      letI := hAP_L r
      ((algebraMap (Polynomial F) (L_raw r)).comp (algebraMap F (Polynomial F))).toAlgebra
  have hST_R₀_RF_L : ∀ r,
      letI := hFld r; letI := hARF_L r; letI := hARL r
      IsScalarTower R₀ (RatFunc F) (L_raw r) :=
    fun r => by
      letI := hFld r; letI := hARF_L r; letI := hARL r
      exact IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST4 : ∀ r,
      letI := hFld r; letI := hAP_L r; letI := hARF_L r
      IsScalarTower (Polynomial F) (RatFunc F) (L_raw r) :=
    fun r => by
      letI := hFld r; letI := hARL r; letI := hAP_L r; letI := hARF_L r
      refine IsScalarTower.of_algebraMap_eq fun p => ?_
      change algebraMap (RatFunc F) (L_raw r)
          (algebraMap R₀ (RatFunc F) (algebraMap (Polynomial F) R₀ p)) =
        algebraMap (RatFunc F) (L_raw r) (algebraMap (Polynomial F) (RatFunc F) p)
      rw [hφ_comp p]
  have hST3 : ∀ r,
      letI := hFld r; letI := hAF_L r; letI := hARF_L r
      IsScalarTower F (RatFunc F) (L_raw r) :=
    fun r => by
      letI := hFld r; letI := hARL r; letI := hAP_L r; letI := hAF_L r; letI := hARF_L r
      letI := hST4 r
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      change algebraMap (Polynomial F) (L_raw r) (algebraMap F (Polynomial F) c) =
        algebraMap (RatFunc F) (L_raw r) (algebraMap F (RatFunc F) c)
      rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (L_raw r),
        ← IsScalarTower.algebraMap_apply F (Polynomial F) (RatFunc F)]

  let B_raw : ℕ → Type u := fun r =>
    letI := hARL r
    ↥(integralClosure R₀ (L_raw r))
  let hCR : ∀ r, CommRing (B_raw r) := fun r =>
    letI := hARL r
    inferInstance
  let hDom : ∀ r, IsDomain (B_raw r) := fun r =>
    letI := hARL r
    inferInstance
  let hAR_B : ∀ r, Algebra R₀ (B_raw r) := fun r =>
    letI := hARL r
    inferInstance
  let hABL : ∀ r, Algebra (B_raw r) (L_raw r) := fun r =>
    letI := hARL r
    inferInstance
  let hAP_B : ∀ r, Algebra (Polynomial F) (B_raw r) := fun r =>
    letI := hCR r; letI := hAR_B r
    ((algebraMap R₀ (B_raw r)).comp (algebraMap (Polynomial F) R₀)).toAlgebra
  let hAF_B : ∀ r, Algebra F (B_raw r) := fun r =>
    letI := hCR r; letI := hAP_B r
    ((algebraMap (Polynomial F) (B_raw r)).comp (algebraMap F (Polynomial F))).toAlgebra
  have hST1 : ∀ r,
      letI := hCR r; letI := hAF_B r; letI := hAP_B r
      IsScalarTower F (Polynomial F) (B_raw r) :=
    fun r => by
      letI := hCR r; letI := hAF_B r; letI := hAP_B r
      exact IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST2 : ∀ r,
      letI := hCR r; letI := hAP_B r; letI := hAR_B r
      IsScalarTower (Polynomial F) R₀ (B_raw r) :=
    fun r => by
      letI := hCR r; letI := hAP_B r; letI := hAR_B r
      exact IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST6 : ∀ r,
      letI := hCR r; letI := hFld r; letI := hAR_B r; letI := hABL r; letI := hARL r
      IsScalarTower R₀ (B_raw r) (L_raw r) :=
    fun r => by
      letI := hARL r
      exact IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST5 : ∀ r,
      letI := hCR r; letI := hFld r; letI := hAP_B r; letI := hABL r; letI := hAP_L r
      IsScalarTower (Polynomial F) (B_raw r) (L_raw r) :=
    fun r => by
      letI := hARL r; letI := hAP_B r; letI := hAP_L r
      exact IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hFin_B : ∀ r, letI := hCR r; letI := hAR_B r; Module.Finite R₀ (B_raw r) :=
    fun r => (hL_valid r).2.2.1
  have hEt_B : ∀ r, letI := hCR r; letI := hAR_B r; Algebra.Etale R₀ (B_raw r) :=
    fun r => (hL_valid r).2.2.2.1
  have hIntCl : ∀ r,
      letI := hCR r; letI := hFld r; letI := hABL r; letI := hARL r
      IsIntegralClosure (B_raw r) R₀ (L_raw r) :=
    fun r => by
      letI := hARL r
      exact integralClosure.isIntegralClosure R₀ (L_raw r)
  have hFrac : ∀ r,
      letI := hCR r; letI := hFld r; letI := hABL r
      IsFractionRing (B_raw r) (L_raw r) :=
    fun r => by
      letI := hARL r
      letI := hST_R₀_RF_L r
      letI := hFD_L r
      exact integralClosure.isFractionRing_of_finite_extension (RatFunc F) (L_raw r)
  have hπ_et_raw : ∀ r : ℕ,
      letI := hCR r; letI := hAR_B r
      AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_raw r))) ≫ e_U.hom) := by
    intro r
    letI := hCR r; letI := hAR_B r; letI := hEt_B r
    have hSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_raw r)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    exact inferInstance

  have hMapInt : ∀ {R_b A_b B_b : Type u} [CommRing R_b] [CommRing A_b] [CommRing B_b]
      [Algebra R_b A_b] [Algebra R_b B_b] (f : A_b →ₐ[R_b] B_b) {x : A_b},
      IsIntegral R_b x → IsIntegral R_b (f x) := by
    intro R_b A_b B_b _ _ _ _ _ f x ⟨P, hP_mon, hP_eval⟩
    refine ⟨P, hP_mon, ?_⟩
    have h1 : Polynomial.eval₂ (algebraMap R_b B_b) (f x) P =
        f.toRingHom (Polynomial.eval₂ (algebraMap R_b A_b) x P) := by
      rw [Polynomial.hom_eval₂]
      congr 1
      exact RingHom.ext fun r_0 => (f.commutes r_0).symm
    change Polynomial.eval₂ (algebraMap R_b B_b) (f x) P = 0
    rw [h1, hP_eval, map_zero]

  let ι_L_hom : ∀ r : ℕ, L_raw r →ₐ[RatFunc F] L_raw (r + 1) :=
    fun r => IntermediateField.inclusion (hL_mono r)
  let ι_Braw : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      B_raw r →ₐ[R₀] B_raw (r + 1) := fun r =>
    letI := hARL r; letI := hARL (r + 1)
    let f_R₀ : L_raw r →ₐ[R₀] L_raw (r + 1) :=
      { (ι_L_hom r).toRingHom with
        commutes' := fun x => by
          change (ι_L_hom r) (algebraMap (RatFunc F) (L_raw r) (algebraMap R₀ (RatFunc F) x)) =
            algebraMap (RatFunc F) (L_raw (r + 1)) (algebraMap R₀ (RatFunc F) x)
          exact (ι_L_hom r).commutes _ }
    { toFun := fun b => ⟨f_R₀ b.1, hMapInt f_R₀ b.2⟩
      map_one' := Subtype.ext f_R₀.map_one
      map_mul' := fun x y => Subtype.ext (f_R₀.map_mul x.1 y.1)
      map_zero' := Subtype.ext f_R₀.map_zero
      map_add' := fun x y => Subtype.ext (f_R₀.map_add x.1 y.1)
      commutes' := fun x => Subtype.ext (f_R₀.commutes x) }
  have hι_inj_raw : ∀ r : ℕ, Function.Injective (ι_Braw r) := by
    intro r a b hab
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : B_raw (r + 1) => (z.1 : AlgebraicClosure (RatFunc F))) hab

  have hι_res_raw : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      ∀ τ : B_raw (r + 1) ≃ₐ[R₀] B_raw (r + 1),
        ∃ σ : B_raw r ≃ₐ[R₀] B_raw r,
          ∀ b : B_raw r, τ (ι_Braw r b) = ι_Braw r (σ b) := by
    intro r τ
    letI := hARL r; letI := hARL (r + 1)
    letI := hST_R₀_RF_L r; letI := hST_R₀_RF_L (r + 1)
    letI := hFD_L r; letI := hFD_L (r + 1)
    letI := hGal_L r; letI := hGal_L (r + 1)
    letI := hFrac r; letI := hFrac (r + 1)
    let B₂ := B_raw (r + 1)
    let L₂ := L_raw (r + 1)
    have hB₂_inj : Function.Injective (algebraMap B₂ L₂) := IsFractionRing.injective B₂ L₂
    have hLiftEnd : ∀ e : B₂ ≃ₐ[R₀] B₂,
        ∃ f_L : L₂ →+* L₂, ∀ b : B₂, f_L (algebraMap B₂ L₂ b) = algebraMap B₂ L₂ (e b) := by
      intro e
      let g_e : B₂ →+* L₂ := (algebraMap B₂ L₂).comp e.toRingHom
      have hg_units : ∀ y : nonZeroDivisors B₂, IsUnit (g_e y) := by
        intro y
        have hy_ne : (y : B₂) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        have hey_ne : e y ≠ 0 := fun h0 => hy_ne (e.injective (h0.trans e.map_zero.symm))
        exact IsUnit.mk0 _ fun h0 => hey_ne (hB₂_inj (h0.trans (map_zero _).symm))
      exact ⟨IsLocalization.lift hg_units, fun b => IsLocalization.lift_eq hg_units b⟩
    obtain ⟨f_fwd, hf_fwd⟩ := hLiftEnd τ
    obtain ⟨f_inv, hf_inv⟩ := hLiftEnd τ.symm
    have h_inv_fwd : f_inv.comp f_fwd = RingHom.id L₂ := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors B₂)
      ext b
      simp [hf_fwd, hf_inv]
    have h_fwd_inv : f_fwd.comp f_inv = RingHom.id L₂ := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors B₂)
      ext b
      simp [hf_fwd, hf_inv]
    have hf_R₀ : ∀ x : R₀, f_fwd (algebraMap R₀ L₂ x) = algebraMap R₀ L₂ x := by
      intro x
      change f_fwd (algebraMap B₂ L₂ (algebraMap R₀ B₂ x)) =
        algebraMap B₂ L₂ (algebraMap R₀ B₂ x)
      rw [hf_fwd, τ.commutes]
    have hf_RF : ∀ z : RatFunc F, f_fwd (algebraMap (RatFunc F) L₂ z) =
        algebraMap (RatFunc F) L₂ z := by
      intro z
      obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj (nonZeroDivisors R₀) z
      have hs_ne : algebraMap R₀ (RatFunc F) s.1 ≠ 0 := by
        intro h0
        exact mem_nonZeroDivisors_iff_ne_zero.mp s.2 (hφ_inj (h0.trans (map_zero _).symm))
      have hsL_ne : algebraMap (RatFunc F) L₂ (algebraMap R₀ (RatFunc F) s.1) ≠ 0 := by
        intro h0
        exact hs_ne ((RingHom.injective (algebraMap (RatFunc F) L₂)) (h0.trans (map_zero _).symm))
      apply mul_right_cancel₀ hsL_ne
      have h1 : f_fwd (algebraMap (RatFunc F) L₂ z) *
          algebraMap (RatFunc F) L₂ (algebraMap R₀ (RatFunc F) s.1) =
          f_fwd (algebraMap (RatFunc F) L₂ (z * algebraMap R₀ (RatFunc F) s.1)) := by
        rw [map_mul, map_mul, ← IsScalarTower.algebraMap_apply R₀ (RatFunc F) L₂, hf_R₀]
      rw [h1, has, ← IsScalarTower.algebraMap_apply R₀ (RatFunc F) L₂, hf_R₀,
        IsScalarTower.algebraMap_apply R₀ (RatFunc F) L₂, ← map_mul, has]
    let τ_L : L₂ ≃ₐ[RatFunc F] L₂ :=
      { f_fwd with
        invFun := f_inv
        left_inv := fun x => RingHom.congr_fun h_inv_fwd x
        right_inv := fun x => RingHom.congr_fun h_fwd_inv x
        commutes' := hf_RF }
    letI : Algebra (L_raw r) L₂ := (ι_L_hom r).toRingHom.toAlgebra
    letI : IsScalarTower (RatFunc F) (L_raw r) L₂ :=
      IsScalarTower.of_algebraMap_eq' (ι_L_hom r).comp_algebraMap.symm
    let σ_L : L_raw r ≃ₐ[RatFunc F] L_raw r := τ_L.restrictNormal (L_raw r)
    have hσL_comm : ∀ x : L_raw r, ι_L_hom r (σ_L x) = τ_L (ι_L_hom r x) :=
      fun x => AlgEquiv.restrictNormal_commutes τ_L (L_raw r) x
    let σ_L_R₀ : L_raw r ≃ₐ[R₀] L_raw r :=
      { σ_L.toRingEquiv with
        commutes' := fun x => by
          change σ_L (algebraMap (RatFunc F) (L_raw r) (algebraMap R₀ (RatFunc F) x)) =
            algebraMap (RatFunc F) (L_raw r) (algebraMap R₀ (RatFunc F) x)
          exact σ_L.commutes _ }
    let σ : B_raw r ≃ₐ[R₀] B_raw r :=
      { toFun := fun b => ⟨σ_L_R₀ b.1, hMapInt σ_L_R₀.toAlgHom b.2⟩
        invFun := fun b => ⟨σ_L_R₀.symm b.1, hMapInt σ_L_R₀.symm.toAlgHom b.2⟩
        left_inv := fun b => Subtype.ext (σ_L_R₀.symm_apply_apply b.1)
        right_inv := fun b => Subtype.ext (σ_L_R₀.apply_symm_apply b.1)
        map_mul' := fun x y => Subtype.ext (σ_L_R₀.map_mul x.1 y.1)
        map_add' := fun x y => Subtype.ext (σ_L_R₀.map_add x.1 y.1)
        commutes' := fun x => Subtype.ext (σ_L_R₀.commutes x) }
    refine ⟨σ, fun b => ?_⟩
    apply Subtype.ext
    have h_lhs : (τ (ι_Braw r b)).1 = τ_L ((ι_Braw r b).1) := (hf_fwd (ι_Braw r b)).symm
    change (τ (ι_Braw r b)).1 = ι_L_hom r (σ_L b.1)
    rw [h_lhs, hσL_comm b.1]
    rfl

  
  have hL_le : ∀ (a b : ℕ), a ≤ b → L_fld a ≤ L_fld b :=
    fun a b hab => monotone_nat_of_le_succ hL_mono hab
  let inclTower : ∀ (a b : ℕ), a ≤ b →
      (letI := hCR a; letI := hCR b; letI := hAR_B a; letI := hAR_B b
       B_raw a →ₐ[R₀] B_raw b) := fun a b hab =>
    letI := hARL a; letI := hARL b
    let f_L : L_raw a →ₐ[RatFunc F] L_raw b := IntermediateField.inclusion (hL_le a b hab)
    let f_R₀ : L_raw a →ₐ[R₀] L_raw b :=
      { f_L.toRingHom with
        commutes' := fun x => by
          change f_L (algebraMap (RatFunc F) (L_raw a) (algebraMap R₀ (RatFunc F) x)) =
            algebraMap (RatFunc F) (L_raw b) (algebraMap R₀ (RatFunc F) x)
          exact f_L.commutes _ }
    { toFun := fun x => ⟨f_R₀ x.1, hMapInt f_R₀ x.2⟩
      map_one' := Subtype.ext f_R₀.map_one
      map_mul' := fun x y => Subtype.ext (f_R₀.map_mul x.1 y.1)
      map_zero' := Subtype.ext f_R₀.map_zero
      map_add' := fun x y => Subtype.ext (f_R₀.map_add x.1 y.1)
      commutes' := fun x => Subtype.ext (f_R₀.commutes x) }

  have hincl_refl : ∀ a : ℕ,
      letI := hCR a; letI := hAR_B a
      inclTower a a (le_refl a) = AlgHom.id R₀ (B_raw a) := by
    intro a
    letI := hCR a; letI := hAR_B a
    exact AlgHom.ext fun x =>
      Subtype.ext (Subtype.ext
        (rfl : ((inclTower a a (le_refl a) x).1 : AlgebraicClosure (RatFunc F)) =
          (x.1 : AlgebraicClosure (RatFunc F))))

  have hincl_comp : ∀ (a b c : ℕ) (hab : a ≤ b) (hbc : b ≤ c),
      letI := hCR a; letI := hCR b; letI := hCR c
      letI := hAR_B a; letI := hAR_B b; letI := hAR_B c
      (inclTower b c hbc).comp (inclTower a b hab) = inclTower a c (le_trans hab hbc) := by
    intro a b c hab hbc
    letI := hCR a; letI := hCR b; letI := hCR c
    letI := hAR_B a; letI := hAR_B b; letI := hAR_B c
    exact AlgHom.ext fun x =>
      Subtype.ext (Subtype.ext
        (rfl : ((inclTower b c hbc (inclTower a b hab x)).1 : AlgebraicClosure (RatFunc F)) =
          ((inclTower a c (le_trans hab hbc) x).1 : AlgebraicClosure (RatFunc F))))

  have hincl_succ : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      inclTower r (r + 1) (Nat.le_succ r) = ι_Braw r := by
    intro r
    letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
    exact AlgHom.ext fun x =>
      Subtype.ext (Subtype.ext
        (rfl : ((inclTower r (r + 1) (Nat.le_succ r) x).1 : AlgebraicClosure (RatFunc F)) =
          ((ι_Braw r x).1 : AlgebraicClosure (RatFunc F))))

  
  have hGal_fin_and_inv : ∀ r : ℕ,
      letI := hCR r; letI := hAR_B r
      Finite (B_raw r ≃ₐ[R₀] B_raw r) ∧
      Algebra.IsInvariant R₀ (B_raw r) (B_raw r ≃ₐ[R₀] B_raw r) := by
    intro r
    letI := hARL r; letI := hST_R₀_RF_L r; letI := hFD_L r; letI := hGal_L r; letI := hFrac r
    obtain ⟨_, m_r, equiv_Γ, _, _, _, _, _⟩ :=
      hGalIdemp R₀ (B_raw r) (RatFunc F) (L_raw r)
    have hFin_G : Finite (B_raw r ≃ₐ[R₀] B_raw r) := Finite.of_equiv (Fin m_r) equiv_Γ
    refine ⟨hFin_G, Algebra.IsInvariant.mk fun b hb => ?_⟩
    have hFix_L : ∀ g_L : L_raw r ≃ₐ[RatFunc F] L_raw r, g_L b.1 = b.1 := by
      intro g_L
      let g_R₀ : L_raw r ≃ₐ[R₀] L_raw r :=
        { g_L.toRingEquiv with
          commutes' := fun x => by
            change g_L (algebraMap (RatFunc F) (L_raw r) (algebraMap R₀ (RatFunc F) x)) = _
            exact g_L.commutes _ }
      let g_B : B_raw r ≃ₐ[R₀] B_raw r :=
        { toFun := fun y => ⟨g_R₀ y.1, hMapInt g_R₀.toAlgHom y.2⟩
          invFun := fun y => ⟨g_R₀.symm y.1, hMapInt g_R₀.symm.toAlgHom y.2⟩
          left_inv := fun y => Subtype.ext (g_R₀.symm_apply_apply y.1)
          right_inv := fun y => Subtype.ext (g_R₀.apply_symm_apply y.1)
          map_mul' := fun x y => Subtype.ext (g_R₀.map_mul x.1 y.1)
          map_add' := fun x y => Subtype.ext (g_R₀.map_add x.1 y.1)
          commutes' := fun x => Subtype.ext (g_R₀.commutes x) }
      exact congrArg Subtype.val (hb g_B)
    have hb_bot : b.1 ∈ (⊥ : IntermediateField (RatFunc F) (L_raw r)) := by
      rw [← IsGalois.fixedField_fixingSubgroup (⊥ : IntermediateField (RatFunc F) (L_raw r))]
      intro g
      exact hFix_L g.1
    rw [IntermediateField.mem_bot] at hb_bot
    obtain ⟨q_rf, hq_rf⟩ := hb_bot
    have hq_int : IsIntegral R₀ q_rf := by
      obtain ⟨P, hP_mon, hP_eval⟩ := b.2
      refine ⟨P, hP_mon, ?_⟩
      apply (RingHom.injective (algebraMap (RatFunc F) (L_raw r)))
      rw [map_zero]
      have hmap : algebraMap (RatFunc F) (L_raw r) (Polynomial.eval₂ (algebraMap R₀ (RatFunc F)) q_rf P) =
          Polynomial.eval₂ (algebraMap R₀ (L_raw r)) b.1 P := by
        rw [Polynomial.hom_eval₂, hq_rf]
        rfl
      rwa [hmap]
    obtain ⟨a_R₀, ha_R₀⟩ := IsIntegrallyClosed.isIntegral_iff.mp hq_int
    refine ⟨a_R₀, Subtype.ext ?_⟩
    change algebraMap (RatFunc F) (L_raw r) (algebraMap R₀ (RatFunc F) a_R₀) = b.1
    rw [ha_R₀, hq_rf]

  
  have hPointedSpec : ∀ (d_pt : ℕ) (_hd_pt : 1 ≤ d_pt) (P_pt : Polynomial F),
      P_pt.Monic → Irreducible P_pt → P_pt.natDegree = d_pt →
      (∀ s ∈ S_aff, P_pt.eval s ≠ 0) →
      ∀ (K_pt : Type u) [Finite K_pt] [Field K_pt] [Algebra F K_pt] [FiniteDimensional F K_pt]
        (π_pt : Polynomial F →ₐ[F] K_pt),
        Function.Surjective π_pt →
        RingHom.ker π_pt.toRingHom = Ideal.span {P_pt} →
        Nat.card K_pt = Nat.card F ^ d_pt →
        ∃ (ev_pt : R₀ →ₐ[F] K_pt)
          (χ_pt : ∀ r : ℕ, B_raw r →+* AlgebraicClosure K_pt)
          (Q_pt : ∀ r : ℕ, letI := hCR r; Ideal (B_raw r))
          (σ_pt : ∀ r : ℕ, letI := hCR r; letI := hAR_B r; B_raw r ≃ₐ[R₀] B_raw r),
          (∀ p : Polynomial F, ev_pt (algebraMap (Polynomial F) R₀ p) = π_pt p) ∧
          (∀ r : ℕ,
            letI := hCR r; letI := hCR (r + 1)
            letI := hAP_B r; letI := hAR_B r; letI := hAR_B (r + 1)
            (χ_pt r).comp (algebraMap R₀ (B_raw r)) =
              (algebraMap K_pt (AlgebraicClosure K_pt)).comp ev_pt.toRingHom ∧
            (χ_pt (r + 1)).comp (ι_Braw r).toRingHom = χ_pt r ∧
            Q_pt r = RingHom.ker (χ_pt r) ∧
            (Q_pt r).IsMaximal ∧
            Ideal.comap (algebraMap (Polynomial F) (B_raw r)) (Q_pt r) = Ideal.span {P_pt} ∧
            Ideal.comap (ι_Braw r).toRingHom (Q_pt (r + 1)) = Q_pt r ∧
            (∀ b : B_raw r, σ_pt (r + 1) (ι_Braw r b) = ι_Braw r (σ_pt r b)) ∧
            (∀ b : B_raw r, (σ_pt r).symm b - b ^ (Nat.card F ^ d_pt) ∈ Q_pt r)) := by
    intro d_pt _hd_pt P_pt _hMon_pt _hIrr_pt _hDeg_pt hAvoid_pt K_pt _ _ _ _ π_pt
      hSurj_π hKer_π hCard_Kpt
    have hπ_Δ_ne : π_pt Δ_aff ≠ 0 := by
      intro h0
      have hprod : (∏ s ∈ S_aff, π_pt (Polynomial.X - Polynomial.C s)) = 0 := by
        rw [← map_prod]; exact h0
      obtain ⟨s, hs, hs0⟩ := Finset.prod_eq_zero_iff.mp hprod
      have hmem : Polynomial.X - Polynomial.C s ∈ RingHom.ker π_pt.toRingHom := hs0
      rw [hKer_π, Ideal.mem_span_singleton] at hmem
      obtain ⟨Q, hQ⟩ := hmem
      have hev := congrArg (Polynomial.eval s) hQ
      simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self,
        Polynomial.eval_mul] at hev
      exact hAvoid_pt s hs (by
        rcases mul_eq_zero.mp hev.symm with h1 | h2
        · exact h1
        · exfalso
          
          have hP_ne : P_pt ≠ 0 := _hMon_pt.ne_zero
          have hQ_ne : Q ≠ 0 := by
            intro hQ0; rw [hQ0, mul_zero] at hQ
            exact (Polynomial.monic_X_sub_C s).ne_zero hQ
          have hdeg_eq := congrArg Polynomial.natDegree hQ
          rw [Polynomial.natDegree_X_sub_C, Polynomial.natDegree_mul hP_ne hQ_ne, _hDeg_pt] at hdeg_eq
          have hQ_deg0 : Q.natDegree = 0 := by omega
          rw [Polynomial.eq_C_of_natDegree_eq_zero hQ_deg0, Polynomial.eval_C] at h2
          apply hQ_ne
          rw [Polynomial.eq_C_of_natDegree_eq_zero hQ_deg0, h2, map_zero])
    have hUnit_Δ : IsUnit (π_pt.toRingHom Δ_aff) := IsUnit.mk0 _ hπ_Δ_ne
    let ev_hom : R₀ →+* K_pt := IsLocalization.Away.lift Δ_aff hUnit_Δ
    have hev_comp : ∀ p : Polynomial F, ev_hom (algebraMap (Polynomial F) R₀ p) = π_pt p :=
      fun p => IsLocalization.Away.lift_eq Δ_aff hUnit_Δ p
    let ev_pt : R₀ →ₐ[F] K_pt :=
      { ev_hom with
        commutes' := fun c => by
          change ev_hom (algebraMap (Polynomial F) R₀ (Polynomial.C c)) = algebraMap F K_pt c
          rw [hev_comp]
          exact π_pt.commutes c }
    have hev_surj : Function.Surjective ev_pt := by
      intro y
      obtain ⟨p, rfl⟩ := hSurj_π y
      exact ⟨algebraMap (Polynomial F) R₀ p, hev_comp p⟩
    let Ω_pt := AlgebraicClosure K_pt
    let algR₀_Ω : Algebra R₀ Ω_pt := ((algebraMap K_pt Ω_pt).comp ev_pt.toRingHom).toAlgebra
    letI : Algebra R₀ Ω_pt := algR₀_Ω
    let m_R₀ : Ideal R₀ := RingHom.ker ev_pt.toRingHom
    have hm_max : m_R₀.IsMaximal := by
      have heq_f : IsField (R₀ ⧸ m_R₀) :=
        (RingHom.quotientKerEquivOfSurjective hev_surj).toMulEquiv.isField (Field.toIsField K_pt)
      exact Ideal.Quotient.maximal_of_isField m_R₀ heq_f

    have hHom_fin : ∀ r : ℕ,
        letI := hCR r; letI := hAR_B r
        Finite (B_raw r →ₐ[R₀] Ω_pt) := by
      intro r
      letI := hCR r; letI := hAR_B r; letI := hARL r; letI := hFin_B r
      obtain ⟨S_gen, hS_gen⟩ := Module.Finite.fg_top (R := R₀) (M := B_raw r)
      have hInt_elem : ∀ g : B_raw r,
          ∃ Q_g : Polynomial Ω_pt, Q_g ≠ 0 ∧
            ∀ χ : B_raw r →ₐ[R₀] Ω_pt, χ g ∈ (Q_g.roots).toFinset := by
        intro g
        obtain ⟨P_g, hPg_mon, hPg_eval⟩ := Algebra.IsIntegral.isIntegral (R := R₀) g
        let Q_g : Polynomial Ω_pt := P_g.map (algebraMap R₀ Ω_pt)
        have hQg_ne : Q_g ≠ 0 := (hPg_mon.map (algebraMap R₀ Ω_pt)).ne_zero
        refine ⟨Q_g, hQg_ne, fun χ => ?_⟩
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hQg_ne, Polynomial.IsRoot.def]
        dsimp [Q_g]
        rw [Polynomial.eval_map, ← Polynomial.aeval_def]
        have h1 : Polynomial.eval₂ (algebraMap R₀ Ω_pt) (χ g) P_g =
            χ.toRingHom (Polynomial.eval₂ (algebraMap R₀ (B_raw r)) g P_g) := by
          rw [Polynomial.hom_eval₂]
          congr 1
          exact RingHom.ext (fun x => (χ.commutes x).symm)
        change Polynomial.eval₂ (algebraMap R₀ Ω_pt) (χ g) P_g = 0
        rw [h1, hPg_eval, map_zero]
      choose Q_poly hQ_ne hQ_mem using hInt_elem
      refine Finite.of_injective
        (fun (χ : B_raw r →ₐ[R₀] Ω_pt) (g : ↥S_gen) =>
          (⟨χ g.1, hQ_mem g.1 χ⟩ : ↥((Q_poly g.1).roots.toFinset))) ?_
      intro χ₁ χ₂ h_eq
      have h_eq_S : ∀ x ∈ (S_gen : Set (B_raw r)), χ₁ x = χ₂ x := by
        intro x hx
        have hx' : x ∈ S_gen := hx
        exact congrArg Subtype.val (congrFun h_eq ⟨x, hx'⟩)
      have h_eq_mod : ∀ x : B_raw r, χ₁ x = χ₂ x := by
        intro x
        have hx_top : x ∈ (⊤ : Submodule R₀ (B_raw r)) := trivial
        rw [← hS_gen] at hx_top
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hx_top
        · exact h_eq_S
        · simp
        · intro a b _ _ ha hb; rw [map_add, map_add, ha, hb]
        · intro c a _ ha; rw [AlgHom.map_smul_of_tower, AlgHom.map_smul_of_tower, ha]
      exact AlgHom.ext h_eq_mod

    have hHom_ne : ∀ r : ℕ,
        letI := hCR r; letI := hAR_B r
        Nonempty (B_raw r →ₐ[R₀] Ω_pt) := by
      intro r
      letI := hCR r; letI := hDom r; letI := hFld r; letI := hAR_B r; letI := hABL r
      letI := hARF_L r; letI := hARL r; letI := hST_R₀_RF_L r; letI := hST6 r
      letI := hFD_L r; letI := hGal_L r
      letI := hFin_B r; letI := hEt_B r; letI := hFrac r; letI := hIntCl r
      obtain ⟨hInj_r, _, _, _, _, _, _, _, _⟩ :=
        hGalIdemp R₀ (B_raw r) (RatFunc F) (L_raw r)
      have hker_bot : RingHom.ker (algebraMap R₀ (B_raw r)) ≤ m_R₀ := by
        intro x hx
        rw [RingHom.mem_ker] at hx
        rw [hInj_r (hx.trans (map_zero _).symm)]
        exact m_R₀.zero_mem
      obtain ⟨Q₀, hQ₀_max, hQ₀_under⟩ :=
        Ideal.exists_ideal_over_maximal_of_isIntegral (S := B_raw r) m_R₀ hker_bot
      letI : Q₀.IsMaximal := hQ₀_max
      let κ_Q := B_raw r ⧸ Q₀
      letI : Field κ_Q := Ideal.Quotient.field Q₀
      have hm_le_comap : m_R₀ ≤ Ideal.comap (algebraMap R₀ (B_raw r)) Q₀ := by
        rw [show Ideal.comap (algebraMap R₀ (B_raw r)) Q₀ = Ideal.under R₀ Q₀ from rfl, hQ₀_under]
      let q_R₀_K : R₀ ⧸ m_R₀ ≃+* K_pt := RingHom.quotientKerEquivOfSurjective hev_surj
      let f_R₀_κ : R₀ ⧸ m_R₀ →+* κ_Q :=
        Ideal.Quotient.lift m_R₀ ((Ideal.Quotient.mk Q₀).comp (algebraMap R₀ (B_raw r)))
          (fun x hx => Ideal.Quotient.eq_zero_iff_mem.mpr (hm_le_comap hx))
      let ι_K_κ : K_pt →+* κ_Q := f_R₀_κ.comp q_R₀_K.symm.toRingHom
      letI : Algebra K_pt κ_Q := ι_K_κ.toAlgebra
      have hι_ev : ∀ x : R₀,
          algebraMap K_pt κ_Q (ev_pt x) = Ideal.Quotient.mk Q₀ (algebraMap R₀ (B_raw r) x) := by
        intro x
        change f_R₀_κ (q_R₀_K.symm (ev_pt x)) = _
        have hq : q_R₀_K (Ideal.Quotient.mk m_R₀ x) = ev_pt x := rfl
        rw [← hq, q_R₀_K.symm_apply_apply]
        rfl
      haveI : Algebra.IsIntegral K_pt κ_Q := by
        refine ⟨fun z => ?_⟩
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
        obtain ⟨P, hP_mon, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := R₀) b
        refine ⟨P.map ev_pt.toRingHom, hP_mon.map ev_pt.toRingHom, ?_⟩
        rw [Polynomial.eval₂_map]
        have hcomp_eq : (algebraMap K_pt κ_Q).comp ev_pt.toRingHom =
            (Ideal.Quotient.mk Q₀).comp (algebraMap R₀ (B_raw r)) := RingHom.ext hι_ev
        rw [hcomp_eq, ← Polynomial.hom_eval₂, hP_eval, map_zero]
      haveI : Algebra.IsAlgebraic K_pt κ_Q := inferInstance
      haveI : FaithfulSMul K_pt κ_Q :=
        (faithfulSMul_iff_algebraMap_injective K_pt κ_Q).mpr (RingHom.injective _)
      let emb_κ : κ_Q →ₐ[K_pt] Ω_pt := IsAlgClosed.lift
      refine ⟨{ (emb_κ.toRingHom.comp (Ideal.Quotient.mk Q₀)) with
        commutes' := fun x => by
          change emb_κ (Ideal.Quotient.mk Q₀ (algebraMap R₀ (B_raw r) x)) =
            algebraMap K_pt Ω_pt (ev_pt x)
          rw [← hι_ev x, emb_κ.commutes] }⟩

    let F_sys : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun op_r =>
          letI := hCR (Opposite.unop op_r); letI := hAR_B (Opposite.unop op_r)
          B_raw (Opposite.unop op_r) →ₐ[R₀] Ω_pt
        map := fun {op_b op_a} f =>
          letI := hCR op_a.unop; letI := hCR op_b.unop
          letI := hAR_B op_a.unop; letI := hAR_B op_b.unop
          TypeCat.ofHom fun χ =>
            χ.comp (inclTower op_a.unop op_b.unop (CategoryTheory.leOfHom f.unop))
        map_id := fun op_a => by
          letI := hCR op_a.unop; letI := hAR_B op_a.unop
          ext χ x
          dsimp
          rw [hincl_refl op_a.unop]
          rfl
        map_comp := fun {op_c op_b op_a} f g => by
          letI := hCR op_a.unop; letI := hCR op_b.unop; letI := hCR op_c.unop
          letI := hAR_B op_a.unop; letI := hAR_B op_b.unop; letI := hAR_B op_c.unop
          ext χ x
          dsimp
          congr 1 }
    letI : ∀ j : ℕᵒᵖ, Finite (F_sys.obj j) := fun j => hHom_fin j.unop
    letI : ∀ j : ℕᵒᵖ, Nonempty (F_sys.obj j) := fun j => hHom_ne j.unop
    obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system F_sys
    let χ_alg : ∀ r : ℕ, letI := hCR r; letI := hAR_B r; B_raw r →ₐ[R₀] Ω_pt :=
      fun r => sec (Opposite.op r)
    have hχ_step : ∀ r : ℕ,
        letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
        (χ_alg (r + 1)).comp (ι_Braw r) = χ_alg r := by
      intro r
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      have h1 := hsec (CategoryTheory.homOfLE (Nat.le_succ r)).op
      dsimp [F_sys] at h1
      rwa [hincl_succ r] at h1
    let χ_pt : ∀ r : ℕ, B_raw r →+* Ω_pt := fun r => (χ_alg r).toRingHom
    let Q_pt : ∀ r : ℕ, letI := hCR r; Ideal (B_raw r) := fun r => RingHom.ker (χ_pt r)

    have hQ_props : ∀ r : ℕ,
        letI := hCR r; letI := hAP_B r; letI := hAR_B r
        (Q_pt r).IsPrime ∧
        (Q_pt r).IsMaximal ∧
        Ideal.comap (algebraMap R₀ (B_raw r)) (Q_pt r) = m_R₀ ∧
        Ideal.comap (algebraMap (Polynomial F) (B_raw r)) (Q_pt r) = Ideal.span {P_pt} ∧
        Finite (B_raw r ⧸ Q_pt r) ∧
        Ideal.inertia (B_raw r ≃ₐ[R₀] B_raw r) (Q_pt r) = ⊥ := by
      intro r
      letI := hCR r; letI := hDom r; letI := hFld r; letI := hAR_B r; letI := hABL r
      letI := hARF_L r; letI := hARL r; letI := hAP_B r; letI := hFin_B r; letI := hEt_B r
      letI := hST_R₀_RF_L r; letI := hST6 r
      letI := hFD_L r; letI := hGal_L r; letI := hFrac r; letI := hIntCl r
      have hQp : (Q_pt r).IsPrime := RingHom.ker_isPrime (χ_pt r)
      letI : (Q_pt r).IsPrime := hQp
      have hComap_R₀ : Ideal.comap (algebraMap R₀ (B_raw r)) (Q_pt r) = m_R₀ := by
        ext x
        change χ_alg r (algebraMap R₀ (B_raw r) x) = 0 ↔ ev_pt x = 0
        rw [(χ_alg r).commutes x]
        exact map_eq_zero_iff (algebraMap K_pt Ω_pt) (RingHom.injective _)
      have hInt_map : (algebraMap R₀ (B_raw r)).IsIntegral :=
        fun y => Algebra.IsIntegral.isIntegral (R := R₀) y
      have hQmax : (Q_pt r).IsMaximal :=
        Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R₀ (B_raw r)) hInt_map
          (Q_pt r) (by rwa [hComap_R₀])
      have hComap_PF :
          Ideal.comap (algebraMap (Polynomial F) (B_raw r)) (Q_pt r) = Ideal.span {P_pt} := by
        ext p
        change p ∈ Ideal.comap ((algebraMap R₀ (B_raw r)).comp (algebraMap (Polynomial F) R₀))
          (Q_pt r) ↔ p ∈ Ideal.span {P_pt}
        rw [← Ideal.comap_comap, hComap_R₀]
        change ev_hom (algebraMap (Polynomial F) R₀ p) = 0 ↔ p ∈ Ideal.span {P_pt}
        rw [hev_comp p]
        change π_pt.toRingHom p = 0 ↔ p ∈ Ideal.span {P_pt}
        rw [← RingHom.mem_ker, hKer_π]
      have hFin_quot : Finite (B_raw r ⧸ Q_pt r) := by
        letI : (Q_pt r).IsMaximal := hQmax
        have hm_le : m_R₀ ≤ Ideal.comap (algebraMap R₀ (B_raw r)) (Q_pt r) := hComap_R₀.symm.le
        let q_R₀_K : R₀ ⧸ m_R₀ ≃+* K_pt := RingHom.quotientKerEquivOfSurjective hev_surj
        let f_K_quot : K_pt →+* (B_raw r ⧸ Q_pt r) :=
          (Ideal.Quotient.lift m_R₀ ((Ideal.Quotient.mk (Q_pt r)).comp (algebraMap R₀ (B_raw r)))
            (fun x hx => Ideal.Quotient.eq_zero_iff_mem.mpr (hm_le hx))).comp q_R₀_K.symm.toRingHom
        letI : Algebra K_pt (B_raw r ⧸ Q_pt r) := f_K_quot.toAlgebra
        have hsmul_compat : ∀ (x : R₀) (y : B_raw r),
            Ideal.Quotient.mk (Q_pt r) (x • y) =
              ev_pt x • Ideal.Quotient.mk (Q_pt r) y := by
          intro x y
          rw [Algebra.smul_def, map_mul, Algebra.smul_def]
          congr 1
          change _ = f_K_quot (ev_pt x)
          have hq : q_R₀_K (Ideal.Quotient.mk m_R₀ x) = ev_pt x := rfl
          dsimp [f_K_quot]
          rw [← hq, q_R₀_K.symm_apply_apply]
          rfl
        obtain ⟨S_gen, hS_gen⟩ := Module.Finite.fg_top (R := R₀) (M := B_raw r)
        have hSpan_K : Submodule.span K_pt ((Ideal.Quotient.mk (Q_pt r)) '' (S_gen : Set (B_raw r))) =
            (⊤ : Submodule K_pt (B_raw r ⧸ Q_pt r)) := by
          rw [eq_top_iff]
          intro z _
          obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
          have hb_top : b ∈ (⊤ : Submodule R₀ (B_raw r)) := trivial
          rw [← hS_gen] at hb_top
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hb_top
          · intro x hx
            exact Submodule.subset_span ⟨x, hx, rfl⟩
          · rw [map_zero]; exact Submodule.zero_mem _
          · intro x y _ _ hx hy; rw [map_add]; exact Submodule.add_mem _ hx hy
          · intro c x _ hx
            rw [hsmul_compat c x]
            exact Submodule.smul_mem _ (ev_pt c) hx
        haveI : Module.Finite K_pt (B_raw r ⧸ Q_pt r) :=
          ⟨⟨S_gen.image (Ideal.Quotient.mk (Q_pt r)), by
            simpa [Finset.coe_image] using hSpan_K⟩⟩
        exact Module.finite_of_finite K_pt
      have hInert_bot : Ideal.inertia (B_raw r ≃ₐ[R₀] B_raw r) (Q_pt r) = ⊥ := by
        letI : (Q_pt r).IsMaximal := hQmax
        letI : Field (B_raw r ⧸ Q_pt r) := Ideal.Quotient.field (Q_pt r)
        letI : Algebra (B_raw r) (TensorProduct R₀ (B_raw r) (B_raw r)) :=
          Algebra.TensorProduct.leftAlgebra
        obtain ⟨_, m_r, equiv_Γ, e_id, _, _, _, hEval, _⟩ :=
          hGalIdemp R₀ (B_raw r) (RatFunc F) (L_raw r)
        let μ : (B_raw r ≃ₐ[R₀] B_raw r) → TensorProduct R₀ (B_raw r) (B_raw r) →ₐ[B_raw r] B_raw r :=
          fun σ => Algebra.TensorProduct.lift (AlgHom.id (B_raw r) (B_raw r)) σ.symm.toAlgHom
            (fun _ _ => mul_comm _ _)
        rw [eq_bot_iff]
        intro γ hγ
        have hγ_inv : γ⁻¹ ∈ Ideal.inertia (B_raw r ≃ₐ[R₀] B_raw r) (Q_pt r) :=
          Subgroup.inv_mem _ hγ
        have hq_eq : (Ideal.Quotient.mk (Q_pt r)).comp (μ γ).toRingHom =
            (Ideal.Quotient.mk (Q_pt r)).comp (μ 1).toRingHom := by
          apply RingHom.ext
          intro z
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul x y =>
            have hy_mem : Ideal.Quotient.mk (Q_pt r) (γ⁻¹ • y) = Ideal.Quotient.mk (Q_pt r) y :=
              (Ideal.Quotient.mk_eq_mk_iff_sub_mem (γ⁻¹ • y) y).mpr (hγ_inv y)
            change Ideal.Quotient.mk (Q_pt r) (x * γ.symm y) =
              Ideal.Quotient.mk (Q_pt r) (x * y)
            rw [map_mul, map_mul]
            congr 1
          | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
        by_contra hne
        let i₁ := equiv_Γ.symm 1
        let j := equiv_Γ.symm γ
        have hij : i₁ ≠ j := fun heq => hne (by
          have := congrArg equiv_Γ heq
          simpa [i₁, j] using this.symm)
        have hev := RingHom.congr_fun hq_eq (e_id i₁)
        change Ideal.Quotient.mk (Q_pt r) (μ γ (e_id i₁)) =
          Ideal.Quotient.mk (Q_pt r) (μ 1 (e_id i₁)) at hev
        have hγ_eq : γ = equiv_Γ j := (equiv_Γ.apply_symm_apply γ).symm
        have h1_eq : (1 : B_raw r ≃ₐ[R₀] B_raw r) = equiv_Γ i₁ :=
          (equiv_Γ.apply_symm_apply 1).symm
        rw [hγ_eq, h1_eq, hEval i₁ j, hEval i₁ i₁, if_neg hij, if_pos rfl, map_zero, map_one] at hev
        exact zero_ne_one hev
      exact ⟨hQp, hQmax, hComap_R₀, hComap_PF, hFin_quot, hInert_bot⟩

    let φ_frob : ∀ r : ℕ, letI := hCR r; letI := hAR_B r; B_raw r ≃ₐ[R₀] B_raw r :=
      fun r =>
        letI := hCR r; letI := hAR_B r
        letI : Finite (B_raw r ≃ₐ[R₀] B_raw r) := (hGal_fin_and_inv r).1
        letI : Algebra.IsInvariant R₀ (B_raw r) (B_raw r ≃ₐ[R₀] B_raw r) := (hGal_fin_and_inv r).2
        letI : (Q_pt r).IsPrime := (hQ_props r).1
        letI : Finite (B_raw r ⧸ Q_pt r) := (hQ_props r).2.2.2.2.1
        arithFrobAt R₀ (B_raw r ≃ₐ[R₀] B_raw r) (Q_pt r)
    let σ_pt : ∀ r : ℕ, letI := hCR r; letI := hAR_B r; B_raw r ≃ₐ[R₀] B_raw r :=
      fun r =>
        letI := hCR r; letI := hAR_B r
        (φ_frob r)⁻¹

    have hCard_under : ∀ r : ℕ,
        letI := hCR r; letI := hAR_B r
        Nat.card (R₀ ⧸ Ideal.under R₀ (Q_pt r)) = Nat.card F ^ d_pt := by
      intro r
      letI := hCR r; letI := hAR_B r
      have h_under : Ideal.under R₀ (Q_pt r) = m_R₀ := (hQ_props r).2.2.1
      rw [h_under, ← hCard_Kpt]
      exact Nat.card_congr (RingHom.quotientKerEquivOfSurjective hev_surj).toEquiv

    have hφ_isFrob : ∀ r : ℕ,
        letI := hCR r; letI := hAR_B r
        IsArithFrobAt R₀ (φ_frob r) (Q_pt r) := by
      intro r
      letI := hCR r; letI := hAR_B r
      letI : Finite (B_raw r ≃ₐ[R₀] B_raw r) := (hGal_fin_and_inv r).1
      letI : Algebra.IsInvariant R₀ (B_raw r) (B_raw r ≃ₐ[R₀] B_raw r) := (hGal_fin_and_inv r).2
      letI : (Q_pt r).IsPrime := (hQ_props r).1
      letI : Finite (B_raw r ⧸ Q_pt r) := (hQ_props r).2.2.2.2.1
      exact IsArithFrobAt.arithFrobAt R₀ (B_raw r ≃ₐ[R₀] B_raw r) (Q_pt r)

    have hσ_frob_cong : ∀ (r : ℕ) (b : B_raw r),
        (σ_pt r).symm b - b ^ (Nat.card F ^ d_pt) ∈ Q_pt r := by
      intro r b
      letI := hCR r; letI := hAR_B r
      have h_eq_symm : (σ_pt r).symm = φ_frob r := inv_inv (φ_frob r)
      rw [h_eq_symm, ← hCard_under r]
      exact hφ_isFrob r b

    have hComap_ι : ∀ r : ℕ,
        letI := hCR r; letI := hCR (r + 1)
        Ideal.comap (ι_Braw r).toRingHom (Q_pt (r + 1)) = Q_pt r := by
      intro r
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      ext b
      change χ_alg (r + 1) (ι_Braw r b) = 0 ↔ χ_alg r b = 0
      rw [← AlgHom.comp_apply, hχ_step r]

    have hσ_compat : ∀ (r : ℕ) (b : B_raw r),
        σ_pt (r + 1) (ι_Braw r b) = ι_Braw r (σ_pt r b) := by
      intro r
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      obtain ⟨φ', hφ'_comm⟩ := hι_res_raw r (φ_frob (r + 1))
      have hφ'_frob : IsArithFrobAt R₀ φ' (Q_pt r) := by
        intro b
        change φ' b - b ^ Nat.card (R₀ ⧸ Ideal.under R₀ (Q_pt r)) ∈ Q_pt r
        rw [hCard_under r]
        have h_up : φ_frob (r + 1) (ι_Braw r b) - (ι_Braw r b) ^ (Nat.card F ^ d_pt) ∈
            Q_pt (r + 1) := by
          rw [← hCard_under (r + 1)]
          exact hφ_isFrob (r + 1) (ι_Braw r b)
        have h_map : ι_Braw r (φ' b - b ^ (Nat.card F ^ d_pt)) =
            φ_frob (r + 1) (ι_Braw r b) - (ι_Braw r b) ^ (Nat.card F ^ d_pt) := by
          rw [map_sub, map_pow, hφ'_comm b]
        rw [← hComap_ι r]
        change ι_Braw r (φ' b - b ^ (Nat.card F ^ d_pt)) ∈ Q_pt (r + 1)
        rwa [h_map]
      have h_mem_inert : φ' * (φ_frob r)⁻¹ ∈ Ideal.inertia (B_raw r ≃ₐ[R₀] B_raw r) (Q_pt r) :=
        IsArithFrobAt.mul_inv_mem_inertia hφ'_frob (hφ_isFrob r)
      rw [(hQ_props r).2.2.2.2.2, Subgroup.mem_bot, mul_inv_eq_one] at h_mem_inert
      subst h_mem_inert
      intro b
      apply (φ_frob (r + 1)).injective
      change (φ_frob (r + 1) * σ_pt (r + 1)) (ι_Braw r b) = φ_frob (r + 1) (ι_Braw r (σ_pt r b))
      rw [mul_inv_cancel, AlgEquiv.one_apply, hφ'_comm (σ_pt r b)]
      change ι_Braw r b = ι_Braw r ((φ_frob r * σ_pt r) b)
      dsimp [σ_pt]
      rw [(φ_frob r).apply_symm_apply]

    refine ⟨ev_pt, χ_pt, Q_pt, σ_pt, hev_comp, fun r => ?_⟩
    letI := hCR r; letI := hCR (r + 1); letI := hAP_B r; letI := hAR_B r; letI := hAR_B (r + 1)
    refine ⟨RingHom.ext fun x => (χ_alg r).commutes x,
      congrArg AlgHom.toRingHom (hχ_step r),
      rfl, (hQ_props r).2.1, (hQ_props r).2.2.2.1, hComap_ι r, hσ_compat r, hσ_frob_cong r⟩

  
  have hIrr_Xa₀ : Irreducible (Polynomial.X - Polynomial.C a₀ : Polynomial F) :=
    Polynomial.irreducible_X_sub_C a₀
  have hDeg_Xa₀ : (Polynomial.X - Polynomial.C a₀ : Polynomial F).natDegree = 1 :=
    Polynomial.natDegree_X_sub_C a₀
  have hAvoid_Xa₀ : ∀ s ∈ S_aff, (Polynomial.X - Polynomial.C a₀ : Polynomial F).eval s ≠ 0 := by
    intro s hs h0
    simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at h0
    subst h0
    exact ha₀ hs
  let π_u : Polynomial F →ₐ[F] F := Polynomial.aeval a₀
  have hSurj_πu : Function.Surjective π_u := fun c => ⟨Polynomial.C c, Polynomial.aeval_C a₀ c⟩
  have hKer_πu : RingHom.ker π_u.toRingHom = Ideal.span {Polynomial.X - Polynomial.C a₀} := by
    have h_eq : π_u.toRingHom = Polynomial.evalRingHom a₀ := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [π_u]
      · simp [π_u]
    rw [h_eq]
    exact Polynomial.ker_evalRingHom a₀
  obtain ⟨ev_u, χ_u, Q_u, σ_u, hev_u_comp, hQu_spec⟩ :=
    hPointedSpec 1 (le_refl 1) (Polynomial.X - Polynomial.C a₀) (Polynomial.monic_X_sub_C a₀)
      hIrr_Xa₀ hDeg_Xa₀ hAvoid_Xa₀ F π_u hSurj_πu hKer_πu (pow_one (Nat.card F)).symm

  have hu₀_fac :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_u.toRingHom) ≫ e_U.hom ≫ U₀.ι = u₀ := by
    rw [heU_eq, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomp_ring :
        CommRingCat.ofHom (algebraMap (Polynomial F) R₀) ≫ CommRingCat.ofHom ev_u.toRingHom =
          CommRingCat.ofHom (Polynomial.evalRingHom a₀) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro p
      change ev_u (algebraMap (Polynomial F) R₀ p) = Polynomial.eval a₀ p
      rw [hev_u_comp p]
