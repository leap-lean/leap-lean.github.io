    have hM_δ₀_eq : M_δ₀ =
        e_res_U.hom.app (pf_f.obj ℱ) ≫ M_tilde ≫ pf_f'.map (e_res_V.inv.app ℱ) := by
      have h1 := congrArg (· ≫ pf_f'.map (e_res_V.inv.app ℱ)) hM_conj
