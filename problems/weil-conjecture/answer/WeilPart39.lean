        have hk_cov : CategoryTheory.Sieve.ofArrows _ k₁ ∈ V.smallEtaleTopology Y₁ := by
          rw [hMem]; intro y
          exact ⟨_, k₁ (g₁ y), (⟨y, rfl⟩ : ↥(U₁ (g₁ y)).toScheme),
            CategoryTheory.Sieve.ofArrows_mk _ k₁ (g₁ y), hOpenHomEtale Y₁ (U₁ (g₁ y)), rfl⟩
