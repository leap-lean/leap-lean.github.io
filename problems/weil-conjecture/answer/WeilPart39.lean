    let e_A : C_V ≅ ℒ_A := CategoryTheory.asIso Υ_A
    let θ_V : ∀ Y : V.Etale, LocallyConstant ↥Y.left ↥A_η →+ ↑(C_V.obj.obj (Opposite.op Y)) :=
      fun Y => (e_A.inv.hom.app (Opposite.op Y)).hom
    refine ⟨hT_V, θ_V, ?_, ?_, ?_⟩
    · intro Y
      have : CategoryTheory.IsIso (e_A.inv.hom.app (Opposite.op Y)) :=
        CategoryTheory.Iso.isIso_hom
          (((CategoryTheory.sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u}).mapIso
            e_A.symm).app (Opposite.op Y))
