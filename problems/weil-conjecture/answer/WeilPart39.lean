    let _ := T_raw.hST1 t; let _ := T_raw.hST1 (t + 1)
    let _ := T_raw.hST2 t; let _ := T_raw.hST2 (t + 1)
    let _ : IsScalarTower F R₀ (T_raw.B_raw t) := hST_FRB_of (T_raw.B_raw t)
    let _ : IsScalarTower F R₀ (T_raw.B_raw (t + 1)) := hST_FRB_of (T_raw.B_raw (t + 1))
    intro τ hτ
    obtain ⟨σ, hσ_comm, _⟩ := (T_raw.hι_raw t).2 τ
    refine ⟨σ, fun x hx => ?_, hσ_comm⟩
    apply (T_raw.hι_raw t).1
    rw [← hσ_comm x]
    exact hτ (T_raw.ι_Braw t x) (IsIntegral.map ((T_raw.ι_Braw t).restrictScalars F) hx)
  have hG_lift_raw : ∀ (g : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ), g ∈ G_V →
      ∀ r : ℕ,
        ∃ τ : ∀ t : ℕ, letI := T_raw.hCR t; letI := T_raw.hAR_B t; T_raw.B_raw t ≃ₐ[R₀] T_raw.B_raw t,
          (∀ (t : ℕ) (b : T_raw.B_raw t),
            τ (t + 1) (T_raw.ι_Braw t b) = T_raw.ι_Braw t (τ t b)) ∧
          (∀ t : ℕ, letI := T_raw.hCR t; letI := T_raw.hAF_B t
            ∀ x : T_raw.B_raw t, IsIntegral F x → τ t x = x) ∧
          (ρ_mat_raw r (τ r)).val = (g.val).map (PadicInt.toZModPow (r + 1)) := by
    intro g hg r
    obtain ⟨σ_r, hσr_geom, hσr_mod⟩ := hG_surj r g hg
    obtain ⟨τ_r0, hτr0_geom, hτr0_comm⟩ :
        letI := T_raw.hCR r; letI := T_raw.hAF_B r; letI := T_raw.hAR_B r
        letI := hCR r; letI := hAR_B r
        ∃ τ_r0 : T_raw.B_raw r ≃ₐ[R₀] T_raw.B_raw r,
          (∀ x : T_raw.B_raw r, IsIntegral F x → τ_r0 x = x) ∧
          (∀ b : B_V r, τ_r0 (j_BV r b) = j_BV r (σ_r b)) := by
      let _ := hCR r; let _ := T_raw.hCR r
      let _ := hDom r; let _ := T_raw.hDom r
      let _ := hFld r; let _ := T_raw.hFld r
      let _ := hAF_B r; let _ := T_raw.hAF_B r
      let _ := hAP_B r; let _ := T_raw.hAP_B r
      let _ := hAR_B r; let _ := T_raw.hAR_B r
      let _ := hAF_L r; let _ := T_raw.hAF_L r
      let _ := hAP_L r; let _ := T_raw.hAP_L r
      let _ := hARF_L r; let _ := T_raw.hARF_L r
      let _ := hABL r; let _ := T_raw.hABL r
      let _ := hARL r; let _ := T_raw.hARL r
      let _ := hST1 r; let _ := T_raw.hST1 r
      let _ := hST2 r; let _ := T_raw.hST2 r
      let _ := hST3 r; let _ := T_raw.hST3 r
      let _ := hST4 r; let _ := T_raw.hST4 r
      let _ := hST5 r; let _ := T_raw.hST5 r
      let _ := hST6 r; let _ := T_raw.hST6 r
      let _ := hST_RKL r; let _ := hST_raw_RKL r
      let _ := hFrac r; let _ := T_raw.hFrac r
      let _ := hIntCl r; let _ := T_raw.hIntCl r
      let _ := hFD_L r; let _ := T_raw.hFD_L r
      let _ := hGal_L r; let _ := T_raw.hGal_L r
      exact hConstFieldGeomLift R₀ K (B_V r) (L_V r) (T_raw.B_raw r) (T_raw.L_raw r)
        (j_BV r) (hj_inj r) σ_r hσr_geom
    have hτr0_mod : (ρ_mat_raw r τ_r0).val = (g.val).map (PadicInt.toZModPow (r + 1)) := by
      let _ := hCR r; let _ := T_raw.hCR r; let _ := hAR_B r; let _ := T_raw.hAR_B r
      obtain ⟨σ', hσ'_comm, hσ'_ρ⟩ := hj_desc r τ_r0
      have hσ'_eq : σ' = σ_r := by
        ext b
        apply hj_inj r
        rw [← hσ'_comm b, hτr0_comm b]
      rw [hσ'_eq] at hσ'_ρ
      rw [← congrArg Units.val hσ'_ρ, hσr_mod]
    let Γ'_raw : ℕ → Type u := fun t =>
      letI := T_raw.hCR t; letI := T_raw.hAF_B t; letI := T_raw.hAR_B t
      { τ : T_raw.B_raw t ≃ₐ[R₀] T_raw.B_raw t //
        ∀ x : T_raw.B_raw t, IsIntegral F x → τ x = x }
    let Compat'_raw : ∀ t : ℕ, Γ'_raw (t + 1) → Γ'_raw t → Prop := fun t τ' σ' =>
      letI := T_raw.hCR t; letI := T_raw.hCR (t + 1)
      letI := T_raw.hAR_B t; letI := T_raw.hAR_B (t + 1)
      ∀ b : T_raw.B_raw t, τ'.1 (T_raw.ι_Braw t b) = T_raw.ι_Braw t (σ'.1 b)
    let down'_raw : ∀ t : ℕ, Γ'_raw (t + 1) → Γ'_raw t := fun t τ' =>
      letI := T_raw.hCR t; letI := T_raw.hCR (t + 1)
      letI := T_raw.hAF_B t; letI := T_raw.hAF_B (t + 1)
      letI := T_raw.hAR_B t; letI := T_raw.hAR_B (t + 1)
      ⟨Classical.choose (hGeom_down_raw t τ'.1 τ'.2),
        (Classical.choose_spec (hGeom_down_raw t τ'.1 τ'.2)).1⟩
    let up'_raw : ∀ t : ℕ, Γ'_raw t → Γ'_raw (t + 1) := fun t σ' =>
      letI := T_raw.hCR t; letI := T_raw.hCR (t + 1)
      letI := T_raw.hAF_B t; letI := T_raw.hAF_B (t + 1)
      letI := T_raw.hAR_B t; letI := T_raw.hAR_B (t + 1)
      ⟨Classical.choose (hGeom_up_raw t σ'.1 σ'.2),
        (Classical.choose_spec (hGeom_up_raw t σ'.1 σ'.2)).1⟩
    obtain ⟨s, hs_r, hs_compat⟩ :=
      hSeqEx r Γ'_raw Compat'_raw down'_raw up'_raw
        (fun t τ' => (Classical.choose_spec (hGeom_down_raw t τ'.1 τ'.2)).2)
        (fun t σ' => (Classical.choose_spec (hGeom_up_raw t σ'.1 σ'.2)).2)
        ⟨τ_r0, hτr0_geom⟩
    refine ⟨fun t => (s t).1, hs_compat, fun t => (s t).2, ?_⟩
    have hsr : (s r).1 = τ_r0 := congrArg Subtype.val hs_r
    dsimp only
    rw [hsr, hτr0_mod]
  have hFVu_norm : ∀ g ∈ G_V, F_V_u * g * F_V_u⁻¹ ∈ G_V := by
    intro g hg
    obtain ⟨Q_u_V, hQu_V_spec⟩ := hQ_u
    apply hG_closed
    intro r
    let _ := hCR r; let _ := hAF_B r; let _ := hAP_B r; let _ := hAR_B r
    let _ := hST1 r; let _ := hST2 r
    let _ : IsScalarTower F R₀ (B_V r) := hST_FRB_of (B_V r)
    obtain ⟨σ, hσ_geom, hσ_mod⟩ := hG_surj r g hg
    obtain ⟨_, _, _, σ_u, _, hσu_mod⟩ := hQu_V_spec r
    let σ' : B_V r ≃ₐ[R₀] B_V r := σ_u * σ * σ_u⁻¹
    have hσ'_geom : ∀ x : B_V r, IsIntegral F x → σ' x = x := by
      intro x hx
      have hx' : IsIntegral F (σ_u.symm x) :=
        IsIntegral.map (σ_u.symm.restrictScalars F).toAlgHom hx
      change σ_u (σ (σ_u.symm x)) = x
      rw [hσ_geom (σ_u.symm x) hx', σ_u.apply_symm_apply]
    have hσu_unit : ρ_V r σ_u = proj_mod r F_V_u := Units.ext hσu_mod
    have hσ_unit : ρ_V r σ = proj_mod r g := Units.ext hσ_mod
    have hσ'_unit : ρ_V r σ' = proj_mod r (F_V_u * g * F_V_u⁻¹) := by
      dsimp [σ']
      rw [map_mul, map_mul, map_inv, hσu_unit, hσ_unit, ← map_inv, ← map_mul, ← map_mul]
    exact ⟨σ', hσ'_geom, congrArg Units.val hσ'_unit⟩
  have hFVmat_coset : ∀ (d : ℕ) (P_poly : Polynomial F)
      (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
      ∃ g_P ∈ G_V, (U_V_mat d P_poly hP).val = g_P.val * (F_V_u.val ^ d) := by
    intro d P_poly hP
    let g_P : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ :=
      U_V_mat d P_poly hP * (F_V_u ^ d)⁻¹
    have hCoset : (U_V_mat d P_poly hP).val = g_P.val * (F_V_u.val ^ d) := by
      have hu : g_P * F_V_u ^ d = U_V_mat d P_poly hP :=
        inv_mul_cancel_right (U_V_mat d P_poly hP) (F_V_u ^ d)
      calc (U_V_mat d P_poly hP).val = (g_P * F_V_u ^ d).val := congrArg Units.val hu.symm
        _ = g_P.val * (F_V_u ^ d).val := Units.val_mul _ _
        _ = g_P.val * (F_V_u.val ^ d) := by rw [Units.val_pow_eq_pow_val]
    obtain ⟨Q_u_V, hQu_V_spec⟩ := hQ_u
    obtain ⟨Q_P_V, hQP_V_spec⟩ := hQ_P d P_poly hP
    have hgP_mem : g_P ∈ G_V := by
      apply hG_closed
      intro r
      let _ := hCR r; let _ := hDom r
      let _ := hAF_B r; let _ := hAP_B r; let _ := hAR_B r
      let _ := hST1 r; let _ := hST2 r
      let _ : IsScalarTower F R₀ (B_V r) := hST_FRB_of (B_V r)
      obtain ⟨hQu_max, _, _, σ_u, hσu_cong, hσu_mod⟩ := hQu_V_spec r
      obtain ⟨hQP_max, _, _, σ_P, hσP_cong, hσP_mod⟩ := hQP_V_spec r
      let σ : B_V r ≃ₐ[R₀] B_V r := σ_P * (σ_u ^ d)⁻¹
      have hσ_geom : ∀ x : B_V r, IsIntegral F x → σ x = x :=
        fun x hx => hFrobCosetGeom R₀ (B_V r) (Q_u_V r) (Q_P_V r) hQu_max hQP_max
          (Nat.card F) d σ_u σ_P hσu_cong hσP_cong x hx
      have hσu_unit : ρ_V r σ_u = proj_mod r F_V_u := Units.ext hσu_mod
      have hσP_unit : ρ_V r σ_P = proj_mod r (U_V_mat d P_poly hP) := Units.ext hσP_mod
      have hσ_unit : ρ_V r σ = proj_mod r g_P := by
        dsimp [σ, g_P]
        rw [map_mul, map_inv, map_pow, hσP_unit, hσu_unit, ← map_pow, ← map_inv, ← map_mul]
      exact ⟨σ, hσ_geom, congrArg Units.val hσ_unit⟩
    exact ⟨g_P, hgP_mem, hCoset⟩
  exact ⟨B_V, L_V, hCR, hDom, hFld, hAF_B, hAP_B, hAR_B, hAF_L, hAP_L, hARF_L, hABL, hARL,
    hST1, hST2, hST3, hST4, hST5, hST6, hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L,
    ρ_V, ι_BV, j_BV, G_V,
    hρ_inj, hG_surj, hG_closed, hG_mem, hG_lift_raw,
    hFVu_norm, hFVmat_coset, hι_compat, hj_BV_spec, hQ_u, hQ_P⟩

theorem weil_mid_dev_closed_locallyConstant_sheaf_quasi_iso_descent (F : Type u) [Finite F] [Field F] (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (a₀ : F)
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (ℓ N c_iso : ℕ) [Fact (Nat.Prime ℓ)]
    (T_raw : WeilMidDevClosedRawTorsionTower.{u} F m Z_tilde f₀ Z_u₀ j_aff S_aff U₀ a₀ e_U ℓ)
    (B_V L_V : ℕ → Type u)
    (hCR : ∀ r, CommRing (B_V r))
    (hDom : ∀ r, IsDomain (B_V r))
    (hFld : ∀ r, Field (L_V r))
    (hAP_B : ∀ r, Algebra (Polynomial F) (B_V r))
    (hAR_B : ∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hAP_L : ∀ r, Algebra (Polynomial F) (L_V r))
    (hARF_L : ∀ r, Algebra (RatFunc F) (L_V r))
    (hABL : ∀ r, Algebra (B_V r) (L_V r))
    (hARL : ∀ r, Algebra
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_V r))
    (hST2 : ∀ r, letI := hCR r; letI := hAP_B r; letI := hAR_B r
      IsScalarTower (Polynomial F)
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hST4 : ∀ r, letI := hFld r; letI := hAP_L r; letI := hARF_L r
      IsScalarTower (Polynomial F) (RatFunc F) (L_V r))
    (hST5 : ∀ r, letI := hCR r; letI := hFld r; letI := hAP_B r; letI := hABL r; letI := hAP_L r
      IsScalarTower (Polynomial F) (B_V r) (L_V r))
    (hST6 : ∀ r, letI := hCR r; letI := hFld r; letI := hAR_B r; letI := hABL r; letI := hARL r
      IsScalarTower
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
        (B_V r) (L_V r))
    (hFin_B : ∀ r, letI := hCR r; letI := hAR_B r
      Module.Finite
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hEt_B : ∀ r, letI := hCR r; letI := hAR_B r
      Algebra.Etale
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (B_V r))
    (hFrac : ∀ r, letI := hCR r; letI := hFld r; letI := hABL r
      IsFractionRing (B_V r) (L_V r))
    (hIntCl : ∀ r, letI := hCR r; letI := hFld r; letI := hABL r; letI := hARL r
      IsIntegralClosure (B_V r)
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))) (L_V r))
    (hFD_L : ∀ r, letI := hFld r; letI := hARF_L r
      FiniteDimensional (RatFunc F) (L_V r))
    (hGal_L : ∀ r, letI := hFld r; letI := hARF_L r
      IsGalois (RatFunc F) (L_V r))
    (ρ_V : ∀ r : ℕ, letI := hCR r; letI := hAR_B r
      (B_V r ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V r) →*
        (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
    (ι_BV : ∀ r : ℕ, letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      B_V r →ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] B_V (r + 1))
    (j_BV : ∀ r : ℕ,
      letI := hCR r; letI := T_raw.hCR r; letI := hAR_B r; letI := T_raw.hAR_B r
      B_V r →ₐ[Localization.Away
        (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r)
    (hι_BV : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      Function.Injective (ι_BV r) ∧
      ∀ τ : B_V (r + 1) ≃ₐ[R₀] B_V (r + 1),
        ∃ σ : B_V r ≃ₐ[R₀] B_V r,
          (∀ b : B_V r, τ (ι_BV r b) = ι_BV r (σ b)) ∧
          ((ρ_V (r + 1) τ).val).map
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
            (ρ_V r σ).val)
    (hj_BV : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1)
      letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
      letI := hAR_B r; letI := hAR_B (r + 1)
      letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      Function.Injective (j_BV r) ∧
      (∀ b : B_V r, T_raw.ι_Braw r (j_BV r b) = j_BV (r + 1) (ι_BV r b)) ∧
      ∀ τ_raw : T_raw.B_raw r ≃ₐ[R₀] T_raw.B_raw r,
        ∃ σ : B_V r ≃ₐ[R₀] B_V r,
          ∀ b : B_V r, τ_raw (j_BV r b) = j_BV r (σ b))
    (α_lat : ∀ r : ℕ, (Fin N → ZMod (ℓ ^ (r + 1))) →+
      weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1))
    (β_lat : ∀ r : ℕ,
      weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) →+
        (Fin N → ZMod (ℓ ^ (r + 1))))
    (hβα_lat : ∀ r : ℕ,
      (β_lat r).comp (α_lat r) = (ℓ ^ c_iso) • AddMonoidHom.id _ ∧
      (α_lat r).comp (β_lat r) = (ℓ ^ c_iso) • AddMonoidHom.id _)
    (hαβ_trans :
      (∀ (r : ℕ) (v : Fin N → ZMod (ℓ ^ (r + 2))),
        weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1)
          (α_lat (r + 1) v) =
        α_lat r (fun i =>
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) (v i))) ∧
      (∀ (r : ℕ) (w : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 2)) (2 * m + 1))
        (i : Fin N),
        β_lat r (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1) w) i =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
            (β_lat (r + 1) w i)))
    (hαβ_equivar : ∀ r : ℕ,
      letI := hCR r; letI := T_raw.hCR r; letI := hAR_B r; letI := T_raw.hAR_B r
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      ∀ (τ_raw : T_raw.B_raw r ≃ₐ[R₀] T_raw.B_raw r) (σ : B_V r ≃ₐ[R₀] B_V r),
        (∀ b : B_V r, τ_raw (j_BV r b) = j_BV r (σ b)) →
        (∀ v, α_lat r (((ρ_V r σ).val).mulVec v) = (T_raw.ρ_raw r τ_raw).val (α_lat r v)) ∧
        (∀ w, β_lat r ((T_raw.ρ_raw r τ_raw).val w) = ((ρ_V r σ).val).mulVec (β_lat r w)))
    (𝒱₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
      letI := hCR r; letI := hAR_B r
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B_V r))
      let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_V r)))) e_U.hom
      let W_r := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
      ↑((𝒱₀ r).obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_r (Fin N → ZMod (ℓ ^ (r + 1))))
    (hTriv_base : ∀ r : ℕ,
      letI := hCR r; letI := hAR_B r
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B_V r))
      let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_V r)))) e_U.hom
      let A_r : AddCommGrpCat.{u} :=
        AddCommGrpCat.uliftFunctor.{u, 0}.obj
          (AddCommGrpCat.of (Fin N → ZMod (ℓ ^ (r + 1))))
      WeilIsEtaleSheafPullback π_r (𝒱₀ r)
        ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r) ∧
