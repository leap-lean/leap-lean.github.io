      exact IsFractionRing.injective C'₀ ↥E₀ ((IntermediateField.inclusion hE₀_L₀).injective h1)
    have hι_R₀ : ι_C'₀.toRingHom.comp (algebraMap R₀ C'₀) = algebraMap R₀ C_gal := by
      apply RingHom.ext
      intro r
      change ι_C'₀ (algebraMap R₀ C'₀ r) = algebraMap R' C_gal (algebraMap R₀ R' r)
