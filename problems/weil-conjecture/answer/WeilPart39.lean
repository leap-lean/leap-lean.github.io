    have hπs_ιj₀ : (π_cl.comp ι_Rbar).comp ι_j₀ = ε_E := by
      dsimp only [ι_j₀]
      rw [← RingHom.comp_assoc, (hStage_alg j₀_st).2.2.2.2.2.2.2.2.2, he_ε]

