                let p_μ : ∀ μ : Γ₀, P_sch μ ⟶ Z_sch :=
                  fun μ => CategoryTheory.Limits.pullback.fst diag₁₂ (δ_Z μ)
                have hp_et : ∀ μ : Γ₀, AlgebraicGeometry.Etale (p_μ μ) := fun μ => by
                  have : AlgebraicGeometry.Etale (δ_Z μ) := (hδZ_props μ).2.2.1
                  infer_instance
