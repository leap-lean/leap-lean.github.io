        (fun x₁ x₂ => AddMonoidHom.ext fun y => by
          change e_can S k (CategoryTheory.Abelian.Ext.comp
              ((e_can S i).symm (x₁ + x₂)) ((e_can S j).symm y) h_ijk) =
            e_can S k (CategoryTheory.Abelian.Ext.comp
              ((e_can S i).symm x₁) ((e_can S j).symm y) h_ijk) +
            e_can S k (CategoryTheory.Abelian.Ext.comp
              ((e_can S i).symm x₂) ((e_can S j).symm y) h_ijk)
          rw [map_add, CategoryTheory.Abelian.Ext.add_comp, map_add])
  refine ⟨cup_tors, ?_, ?_⟩
  · intro S θ_i θ_j θ_k hθ_i hθ_j hθ_k a b
    have h_eq_i : θ_i = Θ_can S i := (hModCmp S m₀ i).2 θ_i (Θ_can S i) hθ_i (hΘ_can S i)
