theorem weil_mid_dev_raw_dedekind_galois_global_cover_of_locConst (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F) (a₀ : F) (ha₀ : a₀ ∉ S_aff)
    [Algebra (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
      (RatFunc F)]
    [IsScalarTower (Polynomial F)
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
      (RatFunc F)]
    [IsFractionRing
      (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))
      (RatFunc F)]
    (U : AlgebraicGeometry.Scheme.{u})
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U)
    (L_prev : IntermediateField (RatFunc F) (AlgebraicClosure (RatFunc F)))
    [FiniteDimensional (RatFunc F) ↥L_prev]
    [IsGalois (RatFunc F) ↥L_prev]
    (hPrev :
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      letI : Algebra R₀ ↥L_prev :=
        ((algebraMap (RatFunc F) ↥L_prev).comp (algebraMap R₀ (RatFunc F))).toAlgebra
      L_prev = ⊥ ∨ Algebra.Etale R₀ ↥(integralClosure R₀ ↥L_prev))
    (k : ℕ)
    (ℱ : Fin k → CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
    (hLC : ∀ (i : Fin k) (x : ↥U),
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale w ∧
        x ∈ Set.range w.base ∧
        Finite ↥A₀ ∧
        WeilIsEtaleSheafPullback w (ℱ i)
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∃ (E : IntermediateField (RatFunc F) (AlgebraicClosure (RatFunc F)))
      (_ : FiniteDimensional (RatFunc F) ↥E)
      (_ : IsGalois (RatFunc F) ↥E),
      L_prev ≤ E ∧
      letI : Algebra R₀ ↥E :=
        ((algebraMap (RatFunc F) ↥E).comp (algebraMap R₀ (RatFunc F))).toAlgebra
      let B_E := ↥(integralClosure R₀ ↥E)
      let π_E : AlgebraicGeometry.Spec (CommRingCat.of B_E) ⟶ U :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_E)) ≫ e_U.hom
      Module.Finite R₀ B_E ∧
      Algebra.Etale R₀ B_E ∧
      ∀ i : Fin k,
        ∃ A_i : AddCommGrpCat.{u},
          Finite ↥A_i ∧
          WeilIsEtaleSheafPullback π_E (ℱ i)
            ((CategoryTheory.constantSheaf
              (AlgebraicGeometry.Spec (CommRingCat.of B_E)).smallEtaleTopology
              AddCommGrpCat.{u}).obj A_i) :=
by
  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
  let R₀ := Localization.Away Δ_aff
  let K := RatFunc F
  let U₀ := AlgebraicGeometry.Spec (CommRingCat.of R₀)

  
  have hGalIdemp := weil_etale_galois_domain_idempotents_and_aut_lift
  have hDomR₀ : IsDomain R₀ := (hGalIdemp.2.1 F S_aff).1
  have hΔ_monic : Δ_aff.Monic :=
    Polynomial.monic_prod_of_monic S_aff (fun s => Polynomial.X - Polynomial.C s)
      (fun s _ => Polynomial.monic_X_sub_C s)
  have hΔ_ne : Δ_aff ≠ 0 := hΔ_monic.ne_zero
  have hle_nzd : Submonoid.powers Δ_aff ≤ nonZeroDivisors (Polynomial F) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hΔ_ne)
  have hDedR₀ : IsDedekindDomain R₀ :=
    IsLocalization.isDedekindDomain (Polynomial F) hle_nzd R₀
  have hPIDR₀ : IsPrincipalIdealRing R₀ := by
    refine IsPrincipalIdealRing.mk fun J => ?_
    have hmap : Ideal.map (algebraMap (Polynomial F) R₀) (Ideal.under (Polynomial F) J) = J :=
      IsLocalization.map_under (Submonoid.powers Δ_aff) R₀ J
    let g := Submodule.IsPrincipal.generator (Ideal.under (Polynomial F) J)
    have hg : Ideal.span {g} = Ideal.under (Polynomial F) J :=
      Submodule.IsPrincipal.span_singleton_generator (Ideal.under (Polynomial F) J)
    refine ⟨algebraMap (Polynomial F) R₀ g, ?_⟩
    change J = Ideal.span {algebraMap (Polynomial F) R₀ g}
    rw [← hmap, ← hg, Ideal.map_span, Set.image_singleton]

  have hNotField : ∀ p : Ideal R₀, p.IsMaximal → p ≠ ⊥ := by
    have hev_ne : Polynomial.evalRingHom a₀ Δ_aff ≠ 0 := by
      change Polynomial.eval a₀ (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)) ≠ 0
      rw [Polynomial.eval_prod]
      refine Finset.prod_ne_zero_iff.mpr fun s hs h0 => ?_
      simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at h0
      exact ha₀ (h0 ▸ hs)
    have hUnit : IsUnit (Polynomial.evalRingHom a₀ Δ_aff) := IsUnit.mk0 _ hev_ne
    let ev_R₀ : R₀ →+* F := IsLocalization.Away.lift Δ_aff hUnit
    let t₀ : R₀ := algebraMap (Polynomial F) R₀ (Polynomial.X - Polynomial.C a₀)
    have ht₀_ne : t₀ ≠ 0 := by
      intro h0
      have hrf : algebraMap (Polynomial F) K (Polynomial.X - Polynomial.C a₀) = 0 := by
        rw [IsScalarTower.algebraMap_apply (Polynomial F) R₀ K]
        change algebraMap R₀ K t₀ = 0
        rw [h0, map_zero]
      exact (Polynomial.monic_X_sub_C a₀).ne_zero
        (IsFractionRing.injective (Polynomial F) K (hrf.trans (map_zero _).symm))
    have ht₀_ev : ev_R₀ t₀ = 0 := by
      dsimp [t₀, ev_R₀]
      rw [IsLocalization.Away.lift_eq Δ_aff hUnit]
      change Polynomial.eval a₀ (Polynomial.X - Polynomial.C a₀) = 0
      simp
    have ht₀_not_unit : ¬ IsUnit t₀ := by
      intro hu
      have huF : IsUnit (ev_R₀ t₀) := hu.map ev_R₀
      rw [ht₀_ev] at huF
      exact not_isUnit_zero huF
    intro p hp hbot
    subst hbot
    have hspan_ne_top : Ideal.span ({t₀} : Set R₀) ≠ ⊤ :=
      mt Ideal.span_singleton_eq_top.mp ht₀_not_unit
    obtain ⟨m, hm_max, hm_le⟩ := Ideal.exists_le_maximal (Ideal.span ({t₀} : Set R₀)) hspan_ne_top
    have hm_eq : (⊥ : Ideal R₀) = m := hp.eq_of_le hm_max.ne_top bot_le
    have ht₀_mem : t₀ ∈ (⊥ : Ideal R₀) := hm_eq.symm ▸ hm_le (Ideal.mem_span_singleton_self t₀)
    exact ht₀_ne (Ideal.mem_bot.mp ht₀_mem)

  have hFinRes : ∀ (p : Ideal R₀) [p.IsMaximal], Finite (R₀ ⧸ p) := by
    intro p hp
    let κ := R₀ ⧸ p
    let _ : Field κ := Ideal.Quotient.field p
    let φ_PF : Polynomial F →+* κ :=
      (Ideal.Quotient.mk p).comp (algebraMap (Polynomial F) R₀)
    let _ : Algebra F κ := (φ_PF.comp Polynomial.C).toAlgebra
    have hφ_C : ∀ c : F, φ_PF (Polynomial.C c) = algebraMap F κ c := fun _ => rfl
    have hker_ne : RingHom.ker φ_PF ≠ ⊥ := by
      intro hbot
      have h_units : ∀ y : nonZeroDivisors (Polynomial F), IsUnit (φ_PF y) := by
        intro y
        have hy_ne : (y : Polynomial F) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        refine IsUnit.mk0 _ fun h0 => hy_ne ?_
        have hmem : (y : Polynomial F) ∈ RingHom.ker φ_PF := h0
        rwa [hbot, Ideal.mem_bot] at hmem
      let ψ_K : K →+* κ := IsLocalization.lift (M := nonZeroDivisors (Polynomial F)) h_units
      have hψ_comp : ψ_K.comp (algebraMap R₀ K) = Ideal.Quotient.mk p := by
        apply IsLocalization.ringHom_ext (Submonoid.powers Δ_aff)
        apply RingHom.ext
        intro q
        simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ K]
        exact IsLocalization.lift_eq h_units q
      have hinj_mk : Function.Injective (Ideal.Quotient.mk p) := by
        rw [← hψ_comp]
        exact ψ_K.injective.comp (IsFractionRing.injective R₀ K)
      apply hNotField p hp
      rw [eq_bot_iff]
      intro r hr
      exact hinj_mk ((Ideal.Quotient.eq_zero_iff_mem.mpr hr).trans (map_zero _).symm)
    obtain ⟨P₀, hP₀_mem, hP₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker_ne
    let x₀ : κ := φ_PF Polynomial.X
    have hφ_aeval : ∀ Q : Polynomial F, Polynomial.aeval x₀ Q = φ_PF Q := by
      intro Q
      rw [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
      have h_eq : (Polynomial.evalRingHom x₀).comp (Polynomial.mapRingHom (algebraMap F κ)) = φ_PF := by
        apply Polynomial.ringHom_ext'
        · ext c; simp [hφ_C]
        · simp [x₀]
      exact RingHom.congr_fun h_eq Q
    have hAlg_x₀ : IsAlgebraic F x₀ := ⟨P₀, hP₀_ne, hφ_aeval P₀ ▸ hP₀_mem⟩
    have hInt_x₀ : IsIntegral F x₀ := hAlg_x₀.isIntegral
    let E_sub : IntermediateField F κ := IntermediateField.adjoin F ({x₀} : Set κ)
    have : FiniteDimensional F ↥E_sub := IntermediateField.adjoin.finiteDimensional hInt_x₀
    have : Finite ↥E_sub := Module.finite_of_finite F
    have hφ_in_E : ∀ Q : Polynomial F, φ_PF Q ∈ E_sub := by
      intro Q
      rw [← hφ_aeval Q]
      refine Polynomial.induction_on' Q ?_ ?_
      · intro p₁ p₂ hp₁ hp₂; rw [map_add]; exact E_sub.add_mem hp₁ hp₂
      · intro n c
        rw [Polynomial.aeval_monomial]
        exact E_sub.mul_mem (E_sub.algebraMap_mem c)
          (pow_mem (IntermediateField.mem_adjoin_simple_self F x₀) n)
    have hE_all : ∀ z : κ, z ∈ E_sub := by
      intro z
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨Q, ⟨_, ⟨n, rfl⟩⟩⟩, hrQ⟩ := IsLocalization.surj (Submonoid.powers Δ_aff) r
      have h_mul : Ideal.Quotient.mk p r * φ_PF (Δ_aff ^ n) = φ_PF Q := by
        change Ideal.Quotient.mk p r * Ideal.Quotient.mk p (algebraMap (Polynomial F) R₀ (Δ_aff ^ n)) =
          Ideal.Quotient.mk p (algebraMap (Polynomial F) R₀ Q)
        rw [← map_mul, hrQ]
      have hu_unit : IsUnit (algebraMap (Polynomial F) R₀ (Δ_aff ^ n)) := by
        rw [map_pow]
        exact (IsLocalization.Away.algebraMap_isUnit Δ_aff).pow n
      have hu_ne : φ_PF (Δ_aff ^ n) ≠ 0 :=
        (hu_unit.map (Ideal.Quotient.mk p)).ne_zero
      have h_eq_div : Ideal.Quotient.mk p r = φ_PF Q * (φ_PF (Δ_aff ^ n))⁻¹ := by
        calc Ideal.Quotient.mk p r
            = (Ideal.Quotient.mk p r * φ_PF (Δ_aff ^ n)) * (φ_PF (Δ_aff ^ n))⁻¹ := by
              rw [mul_assoc, mul_inv_cancel₀ hu_ne, mul_one]
          _ = φ_PF Q * (φ_PF (Δ_aff ^ n))⁻¹ := by rw [h_mul]
      rw [h_eq_div]
      exact E_sub.mul_mem (hφ_in_E Q) (E_sub.inv_mem (hφ_in_E (Δ_aff ^ n)))
    exact Finite.of_injective (fun z : κ => (⟨z, hE_all z⟩ : ↥E_sub))
      (fun _ _ h => congrArg Subtype.val h)

  have hTracePkg := weil_commAlg_traceMatrix_det_isUnit_etale_and_dedekind_galois R₀ K
  have hDVRPkg := weil_dedekind_etale_local_domain_and_dvr_inertia_fix R₀
  have hPbPkg := weil_etale_pullback_exact_and_pseudofunctor 0

  
  have hEt_inertia_triv : ∀ (E : Type u) [Field E] [Algebra K E] [Algebra R₀ E]
      [IsScalarTower R₀ K E] [FiniteDimensional K E] [IsGalois K E],
      let B_E := ↥(integralClosure R₀ E)
      Module.Finite R₀ B_E → Algebra.Etale R₀ B_E →
      ∀ (P : Ideal B_E) [P.IsMaximal] (τ : E ≃ₐ[K] E),
        (∀ b : B_E, τ (b : E) - (b : E) ∈ Subtype.val '' (P : Set B_E)) →
        τ = 1 := by
    intro E _ _ _ _ _ _ B_E hFinB hEtB P _ τ hInert
    have : IsFractionRing B_E E := integralClosure.isFractionRing_of_finite_extension K E
    let _ : Algebra B_E (TensorProduct R₀ B_E B_E) := Algebra.TensorProduct.leftAlgebra
    obtain ⟨_, m, equiv_Γ, e_id, _, _, _, hEval, _⟩ := hGalIdemp.1 R₀ B_E K E
    let μ : (B_E ≃ₐ[R₀] B_E) → TensorProduct R₀ B_E B_E →ₐ[B_E] B_E :=
      fun σ => Algebra.TensorProduct.lift (AlgHom.id B_E B_E) σ.symm.toAlgHom
        (fun _ _ => mul_comm _ _)
    let τ_B : B_E ≃ₐ[R₀] B_E := AlgEquiv.mapIntegralClosure (τ.restrictScalars R₀)
    have hτ_B_coe : ∀ b : B_E, (τ_B b : E) = τ (b : E) :=
      fun b => AlgEquiv.coe_mapIntegralClosure (τ.restrictScalars R₀) b
    have hτ_B_mem : ∀ b : B_E, τ_B b - b ∈ P := by
      intro b
      obtain ⟨w, hwP, hw_eq⟩ := hInert b
      have h_sub : (w : E) = ((τ_B b - b : B_E) : E) := by
        rw [hw_eq, AddSubgroupClass.coe_sub, hτ_B_coe]
      rwa [← Subtype.ext h_sub]
    have hτ_symm_mem : ∀ b : B_E, τ_B.symm b - b ∈ P := by
      intro b
      have h1 := hτ_B_mem (τ_B.symm b)
      rw [τ_B.apply_symm_apply] at h1
      have h2 : τ_B.symm b - b = -(b - τ_B.symm b) := by ring
      rw [h2]
      exact P.neg_mem h1
    have hq_eq : (Ideal.Quotient.mk P).comp (μ τ_B).toRingHom =
        (Ideal.Quotient.mk P).comp (μ 1).toRingHom := by
      apply RingHom.ext
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x y =>
        change Ideal.Quotient.mk P (x * τ_B.symm y) = Ideal.Quotient.mk P (x * y)
        rw [map_mul, map_mul]
        congr 1
        exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem (τ_B.symm y) y).mpr (hτ_symm_mem y)
      | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
    have hτ_B_one : τ_B = 1 := by
      by_contra hne
      let _ : Field (B_E ⧸ P) := Ideal.Quotient.field P
      let i₁ := equiv_Γ.symm 1
      let j := equiv_Γ.symm τ_B
      have hij : i₁ ≠ j := fun heq => hne (by
        have := congrArg equiv_Γ heq
        simpa [i₁, j] using this.symm)
      have hev := RingHom.congr_fun hq_eq (e_id i₁)
      change Ideal.Quotient.mk P (μ τ_B (e_id i₁)) =
        Ideal.Quotient.mk P (μ 1 (e_id i₁)) at hev
      have hτ_eq : τ_B = equiv_Γ j := (equiv_Γ.apply_symm_apply τ_B).symm
      have h1_eq : (1 : B_E ≃ₐ[R₀] B_E) = equiv_Γ i₁ := (equiv_Γ.apply_symm_apply 1).symm
      rw [hτ_eq, h1_eq, hEval i₁ j, hEval i₁ i₁, if_neg hij, if_pos rfl,
        map_zero, map_one] at hev
      exact zero_ne_one hev
    have hring : τ.toRingHom = (1 : E ≃ₐ[K] E).toRingHom := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors B_E)
      apply RingHom.ext
      intro b
      change τ (b : E) = (b : E)
      rw [← hτ_B_coe b, hτ_B_one]
      rfl
    ext x
    exact RingHom.congr_fun hring x

  have hPrev_up :
      letI : Algebra R₀ ↥L_prev := ((algebraMap K ↥L_prev).comp (algebraMap R₀ K)).toAlgebra
      Module.Finite R₀ ↥(integralClosure R₀ ↥L_prev) ∧
      Algebra.Etale R₀ ↥(integralClosure R₀ ↥L_prev) := by
    let _ : Algebra R₀ ↥L_prev := ((algebraMap K ↥L_prev).comp (algebraMap R₀ K)).toAlgebra
    have : IsScalarTower R₀ K ↥L_prev := IsScalarTower.of_algebraMap_eq fun _ => rfl
    rcases hPrev with hBot | hEt
    · refine hTracePkg.2 hNotField @hFinRes ↥L_prev (fun p hp P hP hP_comap => ?_)
      let _ : Finite (R₀ ⧸ p) := @hFinRes p hp
      refine weil_dedekind_galois_inertia_trivial_implies_unramified
        R₀ K ↥L_prev ↥L_prev p (hNotField p hp)
        (fun Q _ _ σ _ x => ?_) P hP_comap
      have hx_bot : x.1 ∈ (⊥ : IntermediateField K (AlgebraicClosure K)) := hBot ▸ x.2
      obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hx_bot
      have hx_eq : x = algebraMap K ↥L_prev c := Subtype.ext hc.symm
      change σ x = x
      rw [hx_eq, σ.commutes]
    · exact ⟨IsIntegralClosure.finite R₀ K ↥L_prev ↥(integralClosure R₀ ↥L_prev), hEt⟩

  have hMapInt : ∀ {M₁ M₂ : Type u} [CommRing M₁] [CommRing M₂] [Algebra R₀ M₁] [Algebra R₀ M₂]
      (f : M₁ →+* M₂), f.comp (algebraMap R₀ M₁) = algebraMap R₀ M₂ →
      ∀ x : M₁, IsIntegral R₀ x → IsIntegral R₀ (f x) := by
    intro M₁ M₂ _ _ _ _ f hf x ⟨P, hP_mon, hP_ev⟩
    refine ⟨P, hP_mon, ?_⟩
    rw [← hf, ← Polynomial.hom_eval₂, hP_ev, map_zero]

  have hCompositum : ∀ (E₁ E₂ : IntermediateField K (AlgebraicClosure K))
      [FiniteDimensional K ↥E₁] [IsGalois K ↥E₁]
      [FiniteDimensional K ↥E₂] [IsGalois K ↥E₂],
      (letI : Algebra R₀ ↥E₁ := ((algebraMap K ↥E₁).comp (algebraMap R₀ K)).toAlgebra
       Module.Finite R₀ ↥(integralClosure R₀ ↥E₁) ∧
       Algebra.Etale R₀ ↥(integralClosure R₀ ↥E₁)) →
      (letI : Algebra R₀ ↥E₂ := ((algebraMap K ↥E₂).comp (algebraMap R₀ K)).toAlgebra
       Module.Finite R₀ ↥(integralClosure R₀ ↥E₂) ∧
       Algebra.Etale R₀ ↥(integralClosure R₀ ↥E₂)) →
      let E := E₁ ⊔ E₂
      letI : Algebra R₀ ↥E := ((algebraMap K ↥E).comp (algebraMap R₀ K)).toAlgebra
      Module.Finite R₀ ↥(integralClosure R₀ ↥E) ∧
      Algebra.Etale R₀ ↥(integralClosure R₀ ↥E) := by
    intro E₁ E₂ _ _ _ _ ⟨hFin₁, hEt₁⟩ ⟨hFin₂, hEt₂⟩
    let E := E₁ ⊔ E₂
    have : FiniteDimensional K ↥E := IntermediateField.finiteDimensional_sup E₁ E₂
    have : IsGalois K ↥E := inferInstance
    let _ : Algebra R₀ ↥E := ((algebraMap K ↥E).comp (algebraMap R₀ K)).toAlgebra
    have : IsScalarTower R₀ K ↥E := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hFixSub : ∀ (F_sub : IntermediateField K (AlgebraicClosure K))
        [FiniteDimensional K ↥F_sub] [IsGalois K ↥F_sub] (hle : F_sub ≤ E),
        (letI : Algebra R₀ ↥F_sub := ((algebraMap K ↥F_sub).comp (algebraMap R₀ K)).toAlgebra
         Module.Finite R₀ ↥(integralClosure R₀ ↥F_sub) ∧
         Algebra.Etale R₀ ↥(integralClosure R₀ ↥F_sub)) →
        ∀ (p : Ideal R₀) [p.IsMaximal]
          (Q : Ideal ↥(integralClosure R₀ ↥E)), Q.IsPrime →
          Ideal.comap (algebraMap R₀ ↥(integralClosure R₀ ↥E)) Q = p →
          ∀ (σ : ↥E ≃ₐ[K] ↥E),
            (∀ y : ↥(integralClosure R₀ ↥E),
              σ (y : ↥E) - (y : ↥E) ∈
                Subtype.val '' (Q : Set ↥(integralClosure R₀ ↥E))) →
            ∀ z (hz : z ∈ F_sub), σ ⟨z, hle hz⟩ = ⟨z, hle hz⟩ := by
      intro F_sub _ _ hle ⟨hFinF, hEtF⟩ p hp Q hQ_prime hQ_comap σ hσ z hz
      let _ : Algebra R₀ ↥F_sub := ((algebraMap K ↥F_sub).comp (algebraMap R₀ K)).toAlgebra
      have : IsScalarTower R₀ K ↥F_sub := IsScalarTower.of_algebraMap_eq fun _ => rfl
      let incl : ↥F_sub →ₐ[K] ↥E := IntermediateField.inclusion hle
      let _ : Algebra ↥F_sub ↥E := incl.toRingHom.toAlgebra
      have : IsScalarTower K ↥F_sub ↥E := IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hincl_R₀ : incl.toRingHom.comp (algebraMap R₀ ↥F_sub) = algebraMap R₀ ↥E :=
        RingHom.ext fun r => incl.commutes (algebraMap R₀ K r)
      let B_F := ↥(integralClosure R₀ ↥F_sub)
      let B_E := ↥(integralClosure R₀ ↥E)
      let j_BF : B_F →+* B_E :=
        { toFun := fun b => ⟨incl b.1, hMapInt incl.toRingHom hincl_R₀ b.1 b.2⟩
          map_one' := Subtype.ext (map_one incl)
          map_mul' := fun x y => Subtype.ext (map_mul incl x.1 y.1)
          map_zero' := Subtype.ext (map_zero incl)
          map_add' := fun x y => Subtype.ext (map_add incl x.1 y.1) }
      let P_F : Ideal B_F := Ideal.comap j_BF Q
      have : Q.IsPrime := hQ_prime
      have : P_F.IsPrime := Ideal.comap_isPrime j_BF Q
      have hPF_comap : Ideal.comap (algebraMap R₀ B_F) P_F = p := by
        rw [← hQ_comap, Ideal.comap_comap]
        rfl
      have hInt_BF : (algebraMap R₀ B_F).IsIntegral :=
        fun y => Algebra.IsIntegral.isIntegral (R := R₀) y
      have : P_F.IsMaximal :=
        Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R₀ B_F) hInt_BF P_F
          (by rwa [hPF_comap])
      let σ_F : ↥F_sub ≃ₐ[K] ↥F_sub := AlgEquiv.restrictNormal σ ↥F_sub
      have hσ_F_inert : ∀ b : B_F,
          σ_F (b : ↥F_sub) - (b : ↥F_sub) ∈ Subtype.val '' (P_F : Set B_F) := by
        intro b
        let d_F : B_F := AlgEquiv.mapIntegralClosure (σ_F.restrictScalars R₀) b - b
        have hd_coe : (d_F : ↥F_sub) = σ_F (b : ↥F_sub) - (b : ↥F_sub) := by
          change ↑(AlgEquiv.mapIntegralClosure (σ_F.restrictScalars R₀) b) - (b : ↥F_sub) = _
          rw [AlgEquiv.coe_mapIntegralClosure]
          rfl
        have hrc : incl (σ_F b.1) = σ (incl b.1) := AlgEquiv.restrictNormal_commutes σ ↥F_sub b.1
        have hj_coe : (j_BF d_F : ↥E) = σ (j_BF b : ↥E) - (j_BF b : ↥E) := by
          change incl (d_F : ↥F_sub) = σ (incl b.1) - incl b.1
          rw [hd_coe, map_sub, hrc]
        obtain ⟨w_E, hw_Q, hw_eq⟩ := hσ (j_BF b)
        have hj_eq : j_BF d_F = w_E := Subtype.ext (hj_coe.trans hw_eq.symm)
        have hd_PF : d_F ∈ P_F := by
