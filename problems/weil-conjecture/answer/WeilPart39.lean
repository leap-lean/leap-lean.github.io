          let X_L := algebraMap (Polynomial F) L₂ Polynomial.X
          have h1 : Polynomial.aeval X_L Q =
              ∑ m_deg ∈ Finset.range D,
                (∑ i ∈ s, algebraMap F L₂ ((P_tot i).coeff m_deg) * ((b_F i) : L₂)) *
                  X_L ^ m_deg := by
            simp only [Q, map_sum, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
            refine Finset.sum_congr rfl fun m_deg _ => ?_
            congr 1
            refine Finset.sum_congr rfl fun i _ => ?_
            change (((P_tot i).coeff m_deg • b_F i : k₂) : L₂) = _
            rw [SetLike.val_smul, Algebra.smul_def]
