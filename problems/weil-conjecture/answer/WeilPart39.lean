                    ⟨P_et μ, 𝟙 _, u_μ μ, ⟨μ⟩, Category.id_comp _⟩, hp_et μ, hx_fst⟩
                apply sub_eq_zero.mp
                refine hSheafEqZero 𝒢 S_Z hSZ_mem
                  ((𝒢.obj.map q₁.op).hom (g_c c₁) - (𝒢.obj.map q₂.op).hom (g_c c₂)) ?_
                intro W' m_w ⟨_, v_w, _, hu_gen, hvw⟩
                rcases hu_gen with ⟨μ⟩
                rw [← hvw, op_comp, 𝒢.obj.map_comp]
                suffices hμ_eq : (𝒢.obj.map (u_μ μ).op).hom
                    ((𝒢.obj.map q₁.op).hom (g_c c₁) - (𝒢.obj.map q₂.op).hom (g_c c₂)) = 0 by
                  change (𝒢.obj.map v_w.op).hom ((𝒢.obj.map (u_μ μ).op).hom _) = 0
                  rw [hμ_eq, map_zero]
