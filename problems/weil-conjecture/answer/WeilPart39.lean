    have h_rhs : σ ((AlgEquiv.mapIntegralClosure σ_R').symm b).1 = b.1 := by
      have h1 : σ ((AlgEquiv.mapIntegralClosure σ_R').symm b).1 =
          ((AlgEquiv.mapIntegralClosure σ_R')
            ((AlgEquiv.mapIntegralClosure σ_R').symm b)).1 := rfl
      rw [h1, AlgEquiv.apply_symm_apply]
    exact h_lhs.trans h_rhs.symm

theorem weil_etale_domain_hom_constant_pullback_bijective (R₀ : Type u) [CommRing R₀]
    (𝒢₀ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of R₀)).smallEtaleTopology AddCommGrpCat.{u})
    (D₁ D₂ : Type u) [CommRing D₁] [IsDomain D₁] [Algebra R₀ D₁] [Algebra.Etale R₀ D₁]
    [CommRing D₂] [IsDomain D₂] [Algebra R₀ D₂] [Algebra.Etale R₀ D₂]
    (hπ₁_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ D₁))))
    (hπ₂_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ D₂))))
    (A₁ : AddCommGrpCat.{u})
    (hPull₁ : WeilIsEtaleSheafPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ D₁))) 𝒢₀
      ((CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of D₁)).smallEtaleTopology
        AddCommGrpCat.{u}).obj A₁))
    (j : D₁ →ₐ[R₀] D₂) :
    letI := hπ₁_et
    letI := hπ₂_et
    let U₀ := AlgebraicGeometry.Spec (CommRingCat.of R₀)
    let E₁ : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ D₁)))
    let E₂ : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ D₂)))
    ∀ (q_j : E₂ ⟶ E₁),
      ((AlgebraicGeometry.Scheme.Etale.forget U₀).map q_j).left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j.toRingHom) →
      Function.Bijective ((𝒢₀.obj.map (Opposite.op q_j)).hom) :=
by
  dsimp only
  have := hπ₁_et
  have := hπ₂_et
  let U₀ := AlgebraicGeometry.Spec (CommRingCat.of R₀)
  let V₁ := AlgebraicGeometry.Spec (CommRingCat.of D₁)
  let V₂ := AlgebraicGeometry.Spec (CommRingCat.of D₂)
  let π₁ : V₁ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ D₁))
  let π₂ : V₂ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ D₂))
  let E₁ : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk π₁
  let E₂ : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk π₂
  intro q_j hq_j

  let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  have : P_Et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ x : ↥W.left, ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ P_Et f.left ∧ f.left.base y = x := by
    intro S W R
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
        (le_refl P_Et)
    exact (iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W)
      heq)).trans (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R)
  have h_mor_etale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      P_Et u.left := by
    intro S Y₁ Y₂ u
    have hw : P_Et (u.left ≫ Y₂.hom) := (CategoryTheory.MorphismProperty.Over.w u).symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp P_Et u.left Y₂.hom Y₂.prop hw

  let C_V₁ := (CategoryTheory.constantSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).obj A₁
  let j_π₁ : CategoryTheory.Functor V₁.Etale U₀.Etale :=
    CategoryTheory.MorphismProperty.Over.map ⊤ hπ₁_et

  have hCov : CategoryTheory.CoverPreserving V₁.smallEtaleTopology U₀.smallEtaleTopology j_π₁ := by
    refine CategoryTheory.CoverPreserving.mk ?_
    intro Y R hR
    apply (hMem U₀ (j_π₁.obj Y) (R.functorPushforward j_π₁)).mpr
    intro x
    obtain ⟨Z, g, z, hg, hg_et, hz⟩ := (hMem V₁ Y R).mp hR x
    exact ⟨j_π₁.obj Z, j_π₁.map g, z,
      CategoryTheory.Sieve.image_mem_functorPushforward j_π₁ R hg, hg_et, hz⟩

  have hCompat : CategoryTheory.CompatiblePreserving U₀.smallEtaleTopology j_π₁ := by
    refine CategoryTheory.CompatiblePreserving.mk ?_
    intro ℱ_typ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
    have hX'_comp : (f₁.left ≫ Y₁.hom) ≫ π₁ = X.hom :=
      (CategoryTheory.Category.assoc f₁.left Y₁.hom π₁).trans
        (CategoryTheory.MorphismProperty.Over.w f₁)
    have hX'_et : P_Et (f₁.left ≫ Y₁.hom) :=
      CategoryTheory.MorphismProperty.of_postcomp P_Et (f₁.left ≫ Y₁.hom) π₁ hπ₁_et
        (hX'_comp.symm ▸ X.prop)
    let X' : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) hX'_et
    let f1' : X' ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl trivial
    have hcomm_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun m => m.left) hcomm
    have h_eq₂ : f₂.left ≫ Y₂.hom = X'.hom :=
      (congrArg (f₂.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
        ((CategoryTheory.Category.assoc f₂.left g₂.left Z.hom).symm.trans
          ((congrArg (· ≫ Z.hom) hcomm_left.symm).trans
            ((CategoryTheory.Category.assoc f₁.left g₁.left Z.hom).trans
              (congrArg (f₁.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁)))))
    let f2' : X' ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left h_eq₂ trivial
    have hf'_comm : f1' ≫ g₁ = f2' ≫ g₂ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext hcomm_left
    have hx_eq := hx f1' f2' hg₁ hg₂ hf'_comm
    let e_X : X ⟶ j_π₁.obj X' :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 X.left)
        ((CategoryTheory.Category.id_comp _).trans hX'_comp) trivial
    have he₁ : e_X ≫ j_π₁.map f1' = f₁ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₁.left)
    have he₂ : e_X ≫ j_π₁.map f2' = f₂ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₂.left)
    have h_app := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ_typ.obj.map e_X.op)) hx_eq
    change (CategoryTheory.ConcreteCategory.hom
        (ℱ_typ.obj.map (j_π₁.map f1').op ≫ ℱ_typ.obj.map e_X.op)) (x g₁ hg₁) =
      (CategoryTheory.ConcreteCategory.hom
        (ℱ_typ.obj.map (j_π₁.map f2').op ≫ ℱ_typ.obj.map e_X.op)) (x g₂ hg₂) at h_app
    rw [← ℱ_typ.obj.map_comp, ← ℱ_typ.obj.map_comp, ← op_comp, ← op_comp, he₁, he₂] at h_app
    exact h_app

  have hCont_j : j_π₁.IsContinuous V₁.smallEtaleTopology U₀.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  have : P_Et.HasPullbacksAlong π₁ :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : P_Et.IsStableUnderBaseChangeAlong π₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  obtain ⟨hCont_B, hAdj_B, ⟨e_pull⟩⟩ := hPull₁
  have := hCont_B
  have := hAdj_B
  have := hCont_j
  let B_π₁ : CategoryTheory.Functor U₀.Etale V₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback P_Et ⊤ π₁
  let P_push := B_π₁.sheafPushforwardContinuous AddCommGrpCat.{u}
    U₀.smallEtaleTopology V₁.smallEtaleTopology
  let J_res := j_π₁.sheafPushforwardContinuous AddCommGrpCat.{u}
    V₁.smallEtaleTopology U₀.smallEtaleTopology
  let adj_site := CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_Et ⊤ π₁ hπ₁_et trivial
  let adj_res : J_res ⊣ P_push := by
    apply CategoryTheory.Adjunction.sheafPushforwardContinuous
    exact adj_site
  let adj_pull := B_π₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
    U₀.smallEtaleTopology V₁.smallEtaleTopology
  let ψ_iso : J_res.obj 𝒢₀ ≅ C_V₁ :=
    ((adj_res.leftAdjointUniq adj_pull).app 𝒢₀) ≪≫ e_pull

  let P_A : CategoryTheory.Functor (Opposite V₁.Etale) AddCommGrpCat.{u} :=
    { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A₁)
      map := fun f =>
        AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A₁) f.unop.left.base.hom)
      map_id := fun _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
      map_comp := fun _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }

  have hP_sheaf : CategoryTheory.Presheaf.IsSheaf V₁.smallEtaleTopology P_A := by
    rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
    intro E S hS
    have hcov := (hMem V₁ E S).mp hS
    let ev_hom {X : AddCommGrpCat.{u}} {Y : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ AddCommGrpCat.of (LocallyConstant ↥Y ↥A₁)) (m : ↥X) : LocallyConstant ↥Y ↥A₁ :=
      f.hom m
    let eval_c (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
        (w : S.arrows.category) (m : ↥c.pt) : LocallyConstant ↥w.obj.left.left ↥A₁ :=
      ev_hom (c.π.app (Opposite.op w)) m
    have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
        (w₁ w₂ : S.arrows.category) (m : ↥c.pt)
        (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
        w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
        eval_c c w₁ m y₁ = eval_c c w₂ m y₂ := by
      intro c w₁ w₂ m y₁ y₂ hy_eq
      let u₁ := w₁.obj.hom
      let u₂ := w₂.obj.hom
      let p₁ := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
      let p₂ := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
      have hpb := CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left
      have hp₁_et : P_Et p₁ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip
          (h_mor_etale u₂)
      have hZ_et : P_Et (p₁ ≫ w₁.obj.left.hom) :=
        CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem _ _ hp₁_et
          w₁.obj.left.prop
      let Z_et : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
      let q₁ : Z_et ⟶ w₁.obj.left := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
      have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
        (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
          ((CategoryTheory.Category.assoc p₂ u₂.left E.hom).symm.trans
            ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
              ((CategoryTheory.Category.assoc p₁ u₁.left E.hom).trans
                (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
      let q₂ : Z_et ⟶ w₂.obj.left :=
        CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
      have hq_eq : q₁ ≫ u₁ = q₂ ≫ u₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      let w₁₂ : S.arrows.category :=
        ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
      let mor₁ : w₁₂ ⟶ w₁ :=
        CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
      let mor₂ : w₁₂ ⟶ w₂ :=
        CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_eq.symm)
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb y₁ y₂ hy_eq
      have hw₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
        congrArg (fun f => ev_hom f m z) (c.w mor₁.op)
      have hw₂ : eval_c c w₂ m (p₂.base z) = eval_c c w₁₂ m z :=
        congrArg (fun f => ev_hom f m z) (c.w mor₂.op)
      exact (congrArg (eval_c c w₁ m) hz₁.symm).trans
        (hw₁.trans (hw₂.symm.trans (congrArg (eval_c c w₂ m) hz₂)))
    let g_fn (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
        (m : ↥c.pt) (x : ↥E.left) : ↥A₁ :=
      let u_x := (hcov x).choose_spec.choose
      let y_x := (hcov x).choose_spec.choose_spec.choose
      let hu_x := (hcov x).choose_spec.choose_spec.choose_spec.1
      let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
      eval_c c w_x m y_x
    have hg_eq : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
        (m : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
        g_fn c m (w.obj.hom.left.base y) = eval_c c w m y := by
      intro c m w y
      let x := w.obj.hom.left.base y
      let u_x := (hcov x).choose_spec.choose
      let y_x := (hcov x).choose_spec.choose_spec.choose
      let hspec := (hcov x).choose_spec.choose_spec.choose_spec
      let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hspec.1⟩
      exact h_ov c w_x w m y_x y hspec.2.2
    have hg_lc : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
        (m : ↥c.pt), IsLocallyConstant (g_fn c m) := by
      intro c m
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro a
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      let Y_x := (hcov x).choose
      let u_x := (hcov x).choose_spec.choose
      let y_x := (hcov x).choose_spec.choose_spec.choose
      let hspec := (hcov x).choose_spec.choose_spec.choose_spec
      let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hspec.1⟩
      let s_wx : LocallyConstant ↥Y_x.left ↥A₁ := eval_c c w_x m
      let O_x : Set ↥Y_x.left := s_wx ⁻¹' {a}
      have hO_open : IsOpen O_x := s_wx.isLocallyConstant {a}
      have : AlgebraicGeometry.Etale u_x.left := hspec.2.1
      refine ⟨u_x.left.base '' O_x, ?_, AlgebraicGeometry.Scheme.Hom.isOpenMap u_x.left O_x hO_open, ?_⟩
      · rintro _ ⟨y', hy', rfl⟩
        exact (hg_eq c m w_x y').trans hy'
      · exact ⟨y_x, hx, hspec.2.2⟩
    refine ⟨CategoryTheory.Limits.IsLimit.mk ?_ ?_ ?_⟩
    · intro c
      exact AddCommGrpCat.ofHom
        { toFun := fun m => ⟨g_fn c m, hg_lc c m⟩
          map_zero' := LocallyConstant.ext fun x =>
            let u_x := (hcov x).choose_spec.choose
            let y_x := (hcov x).choose_spec.choose_spec.choose
            let hu_x := (hcov x).choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            congrArg (fun h : LocallyConstant ↥w_x.obj.left.left ↥A₁ => h y_x)
              ((c.π.app (Opposite.op w_x)).hom.map_zero)
          map_add' := fun m₁ m₂ => LocallyConstant.ext fun x =>
            let u_x := (hcov x).choose_spec.choose
            let y_x := (hcov x).choose_spec.choose_spec.choose
            let hu_x := (hcov x).choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            congrArg (fun h : LocallyConstant ↥w_x.obj.left.left ↥A₁ => h y_x)
              ((c.π.app (Opposite.op w_x)).hom.map_add m₁ m₂) }
    · intro c j
      apply AddCommGrpCat.ext
      intro m
      apply LocallyConstant.ext
      intro y
      exact hg_eq c m j.unop y
    · intro c k hk
      apply AddCommGrpCat.ext
      intro m
      apply LocallyConstant.ext
      intro x
      let u_x := (hcov x).choose_spec.choose
      let y_x := (hcov x).choose_spec.choose_spec.choose
      let hspec := (hcov x).choose_spec.choose_spec.choose_spec
      let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hspec.1⟩
      have hk_wx : ev_hom k m (u_x.left.base y_x) = g_fn c m x :=
        congrArg (fun f => ev_hom f m y_x) (hk (Opposite.op w_x))
      exact (congrArg (ev_hom k m) hspec.2.2.symm).trans hk_wx

  let ℒ_A₁ : CategoryTheory.Sheaf V₁.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
  let P_const := (CategoryTheory.Functor.const (Opposite V₁.Etale)).obj A₁
  let θ_A : P_const ⟶ P_A :=
    { app := fun E =>
        AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A₁))
      naturality := fun _ _ _ =>
        AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }

  have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective V₁.smallEtaleTopology θ_A := by
    refine CategoryTheory.Presheaf.IsLocallyInjective.mk fun {E} a₁ a₂ ha => ?_
    apply (hMem V₁ E.unop (CategoryTheory.Presheaf.equalizerSieve (F := P_const) a₁ a₂)).mpr
    intro x
    have ha_eq : a₁ = a₂ := congrArg (fun g : LocallyConstant ↥E.unop.left ↥A₁ => g x) ha
    subst ha_eq
    exact ⟨E.unop, 𝟙 E.unop, x, rfl, CategoryTheory.MorphismProperty.id_mem P_Et _, rfl⟩

  have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective V₁.smallEtaleTopology θ_A := by
    refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {E} g => ?_
    apply (hMem V₁ E (CategoryTheory.Presheaf.imageSieve θ_A g)).mpr
    intro x
    let a := (g : LocallyConstant ↥E.left ↥A₁) x
    let O_a : E.left.Opens := ⟨(g : LocallyConstant ↥E.left ↥A₁) ⁻¹' {a},
      (g : LocallyConstant ↥E.left ↥A₁).isLocallyConstant {a}⟩
    have hYa_et : P_Et (O_a.ι ≫ E.hom) :=
      CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem _ _ inferInstance E.prop
    let Y_a : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hYa_et
    let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
    refine ⟨Y_a, u_a, (⟨x, rfl⟩ : ↥O_a.toScheme), ?_, inferInstance, rfl⟩
    exact ⟨a, LocallyConstant.ext fun y => y.2.symm⟩

  have hW_θ : V₁.smallEtaleTopology.W θ_A :=
    (V₁.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
  have hIso_θ : CategoryTheory.IsIso
      ((CategoryTheory.presheafToSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
    (V₁.smallEtaleTopology.W_iff θ_A).mp hW_θ
  let e_θ : C_V₁ ≅
      (CategoryTheory.presheafToSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).obj P_A :=
    @CategoryTheory.asIso _ _ _ _ _ hIso_θ
  let e_counit :
      (CategoryTheory.presheafToSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).obj P_A ≅ ℒ_A₁ :=
    @CategoryTheory.asIso _ _ _ _
      ((CategoryTheory.sheafificationAdjunction V₁.smallEtaleTopology AddCommGrpCat.{u}).counit.app
        ℒ_A₁)
      (CategoryTheory.isIso_sheafificationAdjunction_counit ℒ_A₁)
  let e_A : C_V₁ ≅ ℒ_A₁ := e_θ ≪≫ e_counit
  let Φ_iso : J_res.obj 𝒢₀ ≅ ℒ_A₁ := ψ_iso ≪≫ e_A

  let f_j : V₂ ⟶ V₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom j.toRingHom)
  have hfj_comp : f_j ≫ π₁ = π₂ :=
    (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
      (congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext (RingHom.ext j.commutes)))
  have hf_j_et : P_Et f_j :=
    CategoryTheory.MorphismProperty.of_postcomp P_Et f_j π₁ hπ₁_et (hfj_comp.symm ▸ hπ₂_et)
  have : AlgebraicGeometry.Etale f_j := hf_j_et
  let T₁ : V₁.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V₁)
  let Y₂ : V₁.Etale := AlgebraicGeometry.Scheme.Etale.mk f_j
  let g_j : Y₂ ⟶ T₁ :=
    CategoryTheory.MorphismProperty.Over.homMk f_j (CategoryTheory.Category.comp_id f_j) trivial

  obtain ⟨y₀⟩ := (inferInstance : Nonempty ↥V₂)
  let x₀ : ↥V₁ := f_j.base y₀
  have hBij_gj : Function.Bijective ((P_A.map (Opposite.op g_j)).hom) := by
    refine ⟨?_, ?_⟩
    · intro g₁ g₂ hg
      have hx₀ : (g₁ : LocallyConstant ↥V₁ ↥A₁) x₀ = (g₂ : LocallyConstant ↥V₁ ↥A₁) x₀ :=
        congrArg (fun h : LocallyConstant ↥V₂ ↥A₁ => h y₀) hg
      exact LocallyConstant.ext fun x =>
        (LocallyConstant.apply_eq_of_preconnectedSpace g₁ x x₀).trans
          (hx₀.trans (LocallyConstant.apply_eq_of_preconnectedSpace g₂ x₀ x))
    · intro h
      refine ⟨LocallyConstant.const ↥V₁ ((h : LocallyConstant ↥V₂ ↥A₁) y₀),
        LocallyConstant.ext fun y => ?_⟩
      exact LocallyConstant.apply_eq_of_preconnectedSpace h y₀ y

  let φ_hom := Φ_iso.hom.hom
  let φ_inv := Φ_iso.inv.hom
  have h_hom_inv : ∀ W, φ_hom.app W ≫ φ_inv.app W = 𝟙 _ :=
    fun W => congrArg (fun u : J_res.obj 𝒢₀ ⟶ J_res.obj 𝒢₀ => u.hom.app W) Φ_iso.hom_inv_id
  have h_inv_hom : ∀ W, φ_inv.app W ≫ φ_hom.app W = 𝟙 _ :=
    fun W => congrArg (fun u : ℒ_A₁ ⟶ ℒ_A₁ => u.hom.app W) Φ_iso.inv_hom_id
  let e_app (W : Opposite V₁.Etale) : (J_res.obj 𝒢₀).obj.obj W ≅ P_A.obj W :=
    { hom := φ_hom.app W
      inv := φ_inv.app W
      hom_inv_id := h_hom_inv W
      inv_hom_id := h_inv_hom W }
  have h_nat_gj : 𝒢₀.obj.map (Opposite.op (j_π₁.map g_j)) =
      (e_app (Opposite.op T₁)).hom ≫ P_A.map (Opposite.op g_j) ≫
        (e_app (Opposite.op Y₂)).inv := by
    have hnat : 𝒢₀.obj.map (Opposite.op (j_π₁.map g_j)) ≫ φ_hom.app (Opposite.op Y₂) =
        φ_hom.app (Opposite.op T₁) ≫ P_A.map (Opposite.op g_j) :=
      φ_hom.naturality (Opposite.op g_j)
    exact (CategoryTheory.Category.comp_id _).symm.trans
      ((congrArg (𝒢₀.obj.map (Opposite.op (j_π₁.map g_j)) ≫ ·)
        (h_hom_inv (Opposite.op Y₂)).symm).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ φ_inv.app (Opposite.op Y₂)) hnat).trans
            (CategoryTheory.Category.assoc _ _ _))))

  have hBij_jgj : Function.Bijective ((𝒢₀.obj.map (Opposite.op (j_π₁.map g_j))).hom) :=
    (congrArg (fun φ => Function.Bijective φ.hom) h_nat_gj).mpr
      ((CategoryTheory.ConcreteCategory.bijective_of_isIso (e_app (Opposite.op Y₂)).inv).comp
        (hBij_gj.comp
          (CategoryTheory.ConcreteCategory.bijective_of_isIso (e_app (Opposite.op T₁)).hom)))

  let e₁ : j_π₁.obj T₁ ≅ E₁ :=
    CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl V₁)
      ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.id_comp π₁).symm)
  let e₂ : j_π₁.obj Y₂ ≅ E₂ :=
    CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl V₂)
      ((CategoryTheory.Category.id_comp _).trans hfj_comp.symm)
  have hqj_eq : q_j = e₂.inv ≫ j_π₁.map g_j ≫ e₁.hom :=
    CategoryTheory.MorphismProperty.Over.Hom.ext
      (hq_j.trans
        ((CategoryTheory.Category.comp_id f_j).symm.trans
          (CategoryTheory.Category.id_comp (f_j ≫ 𝟙 V₁)).symm))
  let iso_e₁ : 𝒢₀.obj.obj (Opposite.op E₁) ≅ 𝒢₀.obj.obj (Opposite.op (j_π₁.obj T₁)) :=
    { hom := 𝒢₀.obj.map (Opposite.op e₁.hom)
      inv := 𝒢₀.obj.map (Opposite.op e₁.inv)
      hom_inv_id := (𝒢₀.obj.map_comp _ _).symm.trans
        ((congrArg (fun m => 𝒢₀.obj.map (Opposite.op m)) e₁.inv_hom_id).trans (𝒢₀.obj.map_id _))
      inv_hom_id := (𝒢₀.obj.map_comp _ _).symm.trans
        ((congrArg (fun m => 𝒢₀.obj.map (Opposite.op m)) e₁.hom_inv_id).trans (𝒢₀.obj.map_id _)) }
  let iso_e₂ : 𝒢₀.obj.obj (Opposite.op (j_π₁.obj Y₂)) ≅ 𝒢₀.obj.obj (Opposite.op E₂) :=
    { hom := 𝒢₀.obj.map (Opposite.op e₂.inv)
      inv := 𝒢₀.obj.map (Opposite.op e₂.hom)
      hom_inv_id := (𝒢₀.obj.map_comp _ _).symm.trans
        ((congrArg (fun m => 𝒢₀.obj.map (Opposite.op m)) e₂.hom_inv_id).trans (𝒢₀.obj.map_id _))
      inv_hom_id := (𝒢₀.obj.map_comp _ _).symm.trans
        ((congrArg (fun m => 𝒢₀.obj.map (Opposite.op m)) e₂.inv_hom_id).trans (𝒢₀.obj.map_id _)) }
  have h_iso_bij : ∀ {M N : AddCommGrpCat.{u}} (e : M ≅ N), Function.Bijective e.hom.hom :=
    fun {M N} e => ⟨fun x y hxy =>
      (congrArg (fun φ : M ⟶ M => φ.hom x) e.hom_inv_id).symm.trans
        ((congrArg e.inv.hom hxy).trans (congrArg (fun φ : M ⟶ M => φ.hom y) e.hom_inv_id)),
      fun y => ⟨e.inv.hom y, congrArg (fun φ : N ⟶ N => φ.hom y) e.inv_hom_id⟩⟩
  have hmap_qj : 𝒢₀.obj.map (Opposite.op q_j) =
      iso_e₁.hom ≫ 𝒢₀.obj.map (Opposite.op (j_π₁.map g_j)) ≫ iso_e₂.hom :=
    (congrArg (fun m => 𝒢₀.obj.map (Opposite.op m)) hqj_eq).trans
      ((𝒢₀.obj.map_comp (Opposite.op (j_π₁.map g_j ≫ e₁.hom)) (Opposite.op e₂.inv)).trans
        ((congrArg (· ≫ iso_e₂.hom)
          (𝒢₀.obj.map_comp (Opposite.op e₁.hom) (Opposite.op (j_π₁.map g_j)))).trans
          (CategoryTheory.Category.assoc _ _ _)))
  exact (congrArg (fun φ => Function.Bijective φ.hom) hmap_qj).mpr
    ((h_iso_bij iso_e₂).comp (hBij_jgj.comp (h_iso_bij iso_e₁)))

theorem weil_etale_torsor_trivial_deck_constant_descent (R₀ : Type u) [CommRing R₀]
    (𝒢₀ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of R₀)).smallEtaleTopology AddCommGrpCat.{u})
    (S₀ S₁ : Type u) [CommRing S₀] [IsDomain S₀] [Algebra R₀ S₀] [Algebra.Etale R₀ S₀]
    [CommRing S₁] [IsDomain S₁] [Algebra R₀ S₁] [Algebra.Etale R₀ S₁]
    [Algebra S₀ S₁] [IsScalarTower R₀ S₀ S₁] [Algebra.Etale S₀ S₁]
    (hπ₀_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S₀))))
    (hπ₁_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S₁))))
    (hq_et : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S₁))))
    (hq_surj : AlgebraicGeometry.Surjective
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S₁))))
    (hSheets :
      let V₀ := AlgebraicGeometry.Spec (CommRingCat.of S₀)
      let V₁ := AlgebraicGeometry.Spec (CommRingCat.of S₁)
      let q : V₁ ⟶ V₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S₁))
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V₁),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ q) q
        ∃ δ : (S₁ ≃ₐ[S₀] S₁) → (Y ⟶ Y_V),
          (∀ τ : S₁ ≃ₐ[S₀] S₁,
            δ τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ q) q = 𝟙 Y ∧
            δ τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ q) q =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ τ)) ∧
          (⋃ τ : S₁ ≃ₐ[S₀] S₁, Set.range (δ τ).base) = Set.univ)
    (A_η : AddCommGrpCat.{u})
    (hPull₁ : WeilIsEtaleSheafPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S₁))) 𝒢₀
      ((CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of S₁)).smallEtaleTopology
        AddCommGrpCat.{u}).obj A_η))
    (hDeckTriv :
      letI := hπ₁_et
      let U₀ := AlgebraicGeometry.Spec (CommRingCat.of R₀)
      let E₁ : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S₁)))
      ∀ (τ : S₁ ≃ₐ[S₀] S₁) (u_τ : E₁ ⟶ E₁),
        ((AlgebraicGeometry.Scheme.Etale.forget U₀).map u_τ).left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
        ∀ s : ↑(𝒢₀.obj.obj (Opposite.op E₁)),
          (𝒢₀.obj.map (Opposite.op u_τ)).hom s = s) :
    WeilIsEtaleSheafPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S₀))) 𝒢₀
      ((CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of S₀)).smallEtaleTopology
        AddCommGrpCat.{u}).obj A_η) :=
by
  let U₀ := AlgebraicGeometry.Spec (CommRingCat.of R₀)
  let V₀ := AlgebraicGeometry.Spec (CommRingCat.of S₀)
  let V₁ := AlgebraicGeometry.Spec (CommRingCat.of S₁)
  let π₀ : V₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S₀))
  let π₁ : V₁ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S₁))
  let q : V₁ ⟶ V₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S₁))
  have hq_π₀ : q ≫ π₀ = π₁ :=
    (AlgebraicGeometry.Spec.map_comp
      (CommRingCat.ofHom (algebraMap R₀ S₀))
      (CommRingCat.ofHom (algebraMap S₀ S₁))).symm.trans
      (congrArg AlgebraicGeometry.Spec.map
        (CommRingCat.hom_ext (IsScalarTower.algebraMap_eq R₀ S₀ S₁).symm))

  
  let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  have : P_Et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ x : ↥W.left, ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ P_Et f.left ∧ f.left.base y = x := by
    intro S W R
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
        (le_refl P_Et)
    exact (iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W)
      heq)).trans (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R)
  have hMorEtale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      P_Et u.left := by
    intro S Y₁ Y₂ u
    have hw : P_Et (u.left ≫ Y₂.hom) := (CategoryTheory.MorphismProperty.Over.w u).symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp P_Et u.left Y₂.hom Y₂.prop hw
  have hTermOf : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)) := by
    intro S
    exact CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W =>
        let w_hom : Quiver.Hom W.left S := W.hom
        CategoryTheory.MorphismProperty.Over.homMk w_hom
          (CategoryTheory.Category.comp_id w_hom) trivial)
      (fun W m =>
        let m_left : Quiver.Hom W.left S := m.left
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          ((CategoryTheory.Category.comp_id m_left).symm.trans
            (CategoryTheory.MorphismProperty.Over.w m))
          (Subsingleton.elim _ _))

  
  have hSliceCont : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} {h : Y₁ ⟶ Y₂}
      (hh : AlgebraicGeometry.Etale h),
      (CategoryTheory.MorphismProperty.Over.map (P := P_Et) ⊤ hh).IsContinuous
        Y₁.smallEtaleTopology Y₂.smallEtaleTopology := by
    intro Y₁ Y₂ h hh
    let j_h : CategoryTheory.Functor Y₁.Etale Y₂.Etale :=
      CategoryTheory.MorphismProperty.Over.map ⊤ hh
    have hCov : CategoryTheory.CoverPreserving Y₁.smallEtaleTopology Y₂.smallEtaleTopology j_h := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro Y R hR
      apply (hMem Y₂ (j_h.obj Y) (R.functorPushforward j_h)).mpr
      intro x
      obtain ⟨Z, g, z, hg, hg_et, hz⟩ := (hMem Y₁ Y R).mp hR x
      exact ⟨j_h.obj Z, j_h.map g, z,
        CategoryTheory.Sieve.image_mem_functorPushforward j_h R hg, hg_et, hz⟩
    have hCompat : CategoryTheory.CompatiblePreserving Y₂.smallEtaleTopology j_h := by
      refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ_typ Z T x hx W₁ W₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      have hX'_comp : (f₁.left ≫ W₁.hom) ≫ h = X.hom :=
        (CategoryTheory.Category.assoc f₁.left W₁.hom h).trans
          (CategoryTheory.MorphismProperty.Over.w f₁)
      have hX'_et : P_Et (f₁.left ≫ W₁.hom) :=
        CategoryTheory.MorphismProperty.of_postcomp P_Et (f₁.left ≫ W₁.hom) h hh
          (hX'_comp.symm ▸ X.prop)
      let X' : Y₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ W₁.hom) hX'_et
      let f1' : X' ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl trivial
      have hcomm_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun m => m.left) hcomm
      have h_eq₂ : f₂.left ≫ W₂.hom = X'.hom :=
        (congrArg (f₂.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
          ((CategoryTheory.Category.assoc f₂.left g₂.left Z.hom).symm.trans
            ((congrArg (· ≫ Z.hom) hcomm_left.symm).trans
              ((CategoryTheory.Category.assoc f₁.left g₁.left Z.hom).trans
                (congrArg (f₁.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁)))))
      let f2' : X' ⟶ W₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left h_eq₂ trivial
      have hf'_comm : f1' ≫ g₁ = f2' ≫ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hcomm_left
      have hx_eq := hx f1' f2' hg₁ hg₂ hf'_comm
      let e_X : X ⟶ j_h.obj X' :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 X.left)
          ((CategoryTheory.Category.id_comp _).trans hX'_comp) trivial
      have he₁ : e_X ≫ j_h.map f1' = f₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₁.left)
      have he₂ : e_X ≫ j_h.map f2' = f₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₂.left)
      have h_app := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ_typ.obj.map e_X.op)) hx_eq
      change (CategoryTheory.ConcreteCategory.hom
          (ℱ_typ.obj.map (j_h.map f1').op ≫ ℱ_typ.obj.map e_X.op)) (x g₁ hg₁) =
        (CategoryTheory.ConcreteCategory.hom
          (ℱ_typ.obj.map (j_h.map f2').op ≫ ℱ_typ.obj.map e_X.op)) (x g₂ hg₂) at h_app
      rw [← ℱ_typ.obj.map_comp, ← ℱ_typ.obj.map_comp, ← op_comp, ← op_comp, he₁, he₂] at h_app
      exact h_app
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  
  have hConstEquiv : ∀ (V : AlgebraicGeometry.Scheme.{u}),
      let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A_η
      let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
      ∃ (hT_V : CategoryTheory.Limits.IsTerminal T_V)
        (θ_V : ∀ Y : V.Etale,
          LocallyConstant ↥Y.left ↥A_η →+ ↑(C_V.obj.obj (Opposite.op Y))),
        (∀ Y : V.Etale, Function.Bijective (θ_V Y)) ∧
        (∀ {Y₁ Y₂ : V.Etale} (f : Y₁ ⟶ Y₂) (g : LocallyConstant ↥Y₂.left ↥A_η),
          (C_V.obj.map (Opposite.op f)).hom (θ_V Y₂ g) =
            θ_V Y₁ (g.comap f.left.base.hom)) ∧
        (∀ a : ↥A_η,
          θ_V T_V (LocallyConstant.const _ a) =
            ((CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u}
              hT_V).unit.app A_η).hom a) := by
    intro V
    let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A_η
    let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
    have hT_V : CategoryTheory.Limits.IsTerminal T_V := hTermOf V
    let P_A : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A_η)
        map := fun f =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A_η) f.unop.left.base.hom)
        map_id := fun _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
        map_comp := fun _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf V.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (hMem V E S).mp hS
      let ev_hom {X : AddCommGrpCat.{u}} {Y : AlgebraicGeometry.Scheme.{u}}
          (f : X ⟶ AddCommGrpCat.of (LocallyConstant ↥Y ↥A_η)) (m : ↥X) : LocallyConstant ↥Y ↥A_η :=
        f.hom m
      let eval_c (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (m : ↥c.pt) : LocallyConstant ↥w.obj.left.left ↥A_η :=
        ev_hom (c.π.app (Opposite.op w)) m
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m y₁ = eval_c c w₂ m y₂ := by
        intro c w₁ w₂ m y₁ y₂ hy_eq
        let u₁ := w₁.obj.hom
        let u₂ := w₂.obj.hom
        let p₁ := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hpb := CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left
        have hp₁_et : P_Et p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip
            (hMorEtale u₂)
        have hZ_et : P_Et (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem _ _ hp₁_et
            w₁.obj.left.prop
        let Z_et : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc p₂ u₂.left E.hom).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc p₁ u₁.left E.hom).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_eq : q₁ ≫ u₁ = q₂ ≫ u₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_eq.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb y₁ y₂ hy_eq
        have hw₁ : eval_c c w₁ m (p₁.base z) = eval_c c w₁₂ m z :=
          congrArg (fun f => ev_hom f m z) (c.w mor₁.op)
        have hw₂ : eval_c c w₂ m (p₂.base z) = eval_c c w₁₂ m z :=
          congrArg (fun f => ev_hom f m z) (c.w mor₂.op)
        exact (congrArg (eval_c c w₁ m) hz₁.symm).trans
          (hw₁.trans (hw₂.symm.trans (congrArg (eval_c c w₂ m) hz₂)))
      let g_fn (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (m : ↥c.pt) (x : ↥E.left) : ↥A_η :=
        let u_x := (hcov x).choose_spec.choose
        let y_x := (hcov x).choose_spec.choose_spec.choose
        let hu_x := (hcov x).choose_spec.choose_spec.choose_spec.1
        let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
        eval_c c w_x m y_x
      have hg_eq : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (m : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
          g_fn c m (w.obj.hom.left.base y) = eval_c c w m y := by
        intro c m w y
        let x := w.obj.hom.left.base y
        let u_x := (hcov x).choose_spec.choose
        let y_x := (hcov x).choose_spec.choose_spec.choose
        let hspec := (hcov x).choose_spec.choose_spec.choose_spec
        let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hspec.1⟩
        exact h_ov c w_x w m y_x y hspec.2.2
      have hg_lc : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (m : ↥c.pt), IsLocallyConstant (g_fn c m) := by
        intro c m
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        let Y_x := (hcov x).choose
        let u_x := (hcov x).choose_spec.choose
        let y_x := (hcov x).choose_spec.choose_spec.choose
        let hspec := (hcov x).choose_spec.choose_spec.choose_spec
        let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hspec.1⟩
