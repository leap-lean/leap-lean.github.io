          ⟨((hTriv_base r).2.2 W).1, ((hTriv_base r).2.2 W).2, hTriv_trans r W⟩⟩⟩
      c_iso := c_iso
      α_U₀ := α_U₀
      β_U₀ := β_U₀
      hα_comm := hα_comm
      hβ_comm := hβ_comm
      hβα_id := hβα_id
      hαβ_id := hαβ_id },
    hG_closed⟩

theorem weil_zero_ext_direct_image_zero_functor_iso (X S : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ S) :
    ∃ (hCont : (weilEtaleSitePullback f).IsContinuous
        S.smallEtaleTopology X.smallEtaleTopology),
      let P_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback f) AddCommGrpCat.{u} _
        S.smallEtaleTopology X.smallEtaleTopology hCont
      ∃ (Θ : ∀ (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Iso (P_f.obj ℱ) (weilEtaleHigherDirectImage f 0 ℱ)),
        ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : ℱ₁ ⟶ ℱ₂),
          P_f.map φ ≫ (Θ ℱ₂).hom =
            (Θ ℱ₁).hom ≫ weilEtaleHigherDirectImageMap f 0 φ :=
by
  let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hP_comp : P.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hMem : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale) (R : CategoryTheory.Sieve W),
      R ∈ Z.smallEtaleTopology W ↔
        ∀ x : ↥W.left,
          ∃ (Y : Z.Etale) (g : Y ⟶ W) (y : ↥Y.left),
            R.arrows g ∧ P g.left ∧ g.left.base y = x := by
    intro Z W R
    have heq : Z.smallGrothendieckTopology P =
        (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Z (le_refl P)
    exact (iff_of_eq (congrArg
      (fun J : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ J W) heq)).trans
      (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology P P Z hP_comp
        inferInstance inferInstance inferInstance inferInstance W R)
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong P f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_f : CategoryTheory.Functor S.Etale X.Etale := weilEtaleSitePullback f
  have hB_eq : B_f = CategoryTheory.MorphismProperty.Over.pullback P ⊤ f := rfl
  let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)
  have hTerm_S : CategoryTheory.Limits.IsTerminal T_S :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
        (CategoryTheory.Category.comp_id E.hom))
      (fun E m => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m)))
  have : CategoryTheory.Limits.HasTerminal S.Etale := hTerm_S.hasTerminal
  have : CategoryTheory.Limits.HasPullbacks S.Etale :=
    CategoryTheory.MorphismProperty.Over.hasPullbacks P S
  have : CategoryTheory.Limits.HasFiniteLimits S.Etale :=
    CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
  have : CategoryTheory.Limits.PreservesFiniteLimits B_f := by
    rw [hB_eq]
    exact CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P f
  have : CategoryTheory.RepresentablyFlat B_f :=
    CategoryTheory.flat_of_preservesFiniteLimits B_f
  have hCompat : CategoryTheory.CompatiblePreserving X.smallEtaleTopology B_f :=
    CategoryTheory.compatiblePreservingOfFlat X.smallEtaleTopology B_f
  have hCov : CategoryTheory.CoverPreserving S.smallEtaleTopology X.smallEtaleTopology B_f := by
    refine ⟨fun {U} {R} hR => (hMem X (B_f.obj U) (R.functorPushforward B_f)).mpr fun z => ?_⟩
    let fstU := CategoryTheory.Limits.pullback.fst U.hom f
    obtain ⟨Y, g, y, hgR, _, hy⟩ := (hMem S U R).mp hR (fstU.base z)
    have hBg_mem : (R.functorPushforward B_f).arrows (B_f.map g) :=
      CategoryTheory.Sieve.image_mem_functorPushforward B_f R hgR
    have hBg_w : (B_f.map g).left ≫ (B_f.obj U).hom = (B_f.obj Y).hom :=
      CategoryTheory.MorphismProperty.Over.w (B_f.map g)
    have hBg_et : P (B_f.map g).left :=
      CategoryTheory.MorphismProperty.of_postcomp P (B_f.map g).left (B_f.obj U).hom
        (B_f.obj U).prop (by rw [hBg_w]; exact (B_f.obj Y).prop)
    let fstY := CategoryTheory.Limits.pullback.fst Y.hom f
    have hOuter : CategoryTheory.IsPullback
        ((B_f.map g).left ≫ (B_f.obj U).hom) fstY f (g.left ≫ U.hom) := by
      rw [hBg_w, CategoryTheory.MorphismProperty.Over.w g]
      exact (CategoryTheory.IsPullback.of_hasPullback Y.hom f).flip
    have hRight : CategoryTheory.IsPullback (B_f.obj U).hom fstU f U.hom :=
      (CategoryTheory.IsPullback.of_hasPullback U.hom f).flip
    have hCommSq : (B_f.map g).left ≫ fstU = fstY ≫ g.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hLeft : CategoryTheory.IsPullback (B_f.map g).left fstY fstU g.left :=
      CategoryTheory.IsPullback.of_right hOuter hCommSq hRight
    obtain ⟨w₀, hw₀_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
    refine ⟨B_f.obj Y, B_f.map g, hLeft.isoPullback.inv.base w₀, hBg_mem, hBg_et, ?_⟩
    have hinv : (hLeft.isoPullback.inv ≫ (B_f.map g).left).base w₀ =
        (CategoryTheory.Limits.pullback.fst fstU g.left).base w₀ :=
      congrArg (fun k => k.base w₀) hLeft.isoPullback_inv_fst
    exact hinv.trans hw₀_fst
  have hCont : (weilEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov
  let J_X := X.smallEtaleTopology
  let S_pre := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let L_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let adj_sh := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
  have : S_pre.Additive := adj_sh.right_adjoint_additive
  let adj_ab := CategoryTheory.Adjunction.whiskerRight (Opposite X.Etale)
    (AddCommGrpCat.adj :
      CategoryTheory.Adjunction AddCommGrpCat.free (CategoryTheory.forget AddCommGrpCat.{u}))
  let P_E : X.Etale → CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
    fun E => (CategoryTheory.yoneda.obj E).comp AddCommGrpCat.free
  let F_E : X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun E => L_X.obj (P_E E)
  let e₁ : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (E : X.Etale),
      CategoryTheory.Abelian.Ext (F_E E) 𝒢 0 ≃ (F_E E ⟶ 𝒢) :=
    fun 𝒢 E => (CategoryTheory.Abelian.Ext.addEquiv₀ (X := F_E E) (Y := 𝒢)).toEquiv
  let e₂ : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (E : X.Etale),
      (F_E E ⟶ 𝒢) ≃ (P_E E ⟶ S_pre.obj 𝒢) :=
    fun 𝒢 E => adj_sh.homEquiv (P_E E) 𝒢
  let e₃ : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (E : X.Etale),
      (P_E E ⟶ S_pre.obj 𝒢) ≃
        (CategoryTheory.yoneda.obj E ⟶
          (S_pre.obj 𝒢).comp (CategoryTheory.forget AddCommGrpCat.{u})) :=
    fun 𝒢 E => adj_ab.homEquiv (CategoryTheory.yoneda.obj E) (S_pre.obj 𝒢)
  let e₄ : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (E : X.Etale),
      (CategoryTheory.yoneda.obj E ⟶
          (S_pre.obj 𝒢).comp (CategoryTheory.forget AddCommGrpCat.{u})) ≃
        ↥((S_pre.obj 𝒢).obj (Opposite.op E)) :=
    fun _ _ => CategoryTheory.yonedaEquiv
  let evHom : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (E : X.Etale),
      (F_E E ⟶ 𝒢) ≃ ↥((S_pre.obj 𝒢).obj (Opposite.op E)) :=
    fun 𝒢 E => (e₂ 𝒢 E).trans ((e₃ 𝒢 E).trans (e₄ 𝒢 E))
  let u₀ : ∀ E : X.Etale, ↥((P_E E).obj (Opposite.op E)) :=
    fun E => (CategoryTheory.ConcreteCategory.hom
      ((adj_ab.unit.app (CategoryTheory.yoneda.obj E)).app (Opposite.op E))) (𝟙 E)
  let gen_E : ∀ E : X.Etale, ↥((S_pre.obj (F_E E)).obj (Opposite.op E)) :=
    fun E => (CategoryTheory.ConcreteCategory.hom
      ((adj_sh.unit.app (P_E E)).app (Opposite.op E))) (u₀ E)
  have hevHom : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (E : X.Etale) (g : F_E E ⟶ 𝒢),
      evHom 𝒢 E g =
        (CategoryTheory.ConcreteCategory.hom ((S_pre.map g).app (Opposite.op E))) (gen_E E) := by
    intro 𝒢 E g
    dsimp [evHom, e₂, e₃, e₄, gen_E, u₀]
    rw [CategoryTheory.yonedaEquiv_apply, adj_ab.homEquiv_unit, adj_sh.homEquiv_unit]
    rfl
  let addEquivObj : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (E : X.Etale),
      CategoryTheory.Abelian.Ext (F_E E) 𝒢 0 ≃+ ↥((S_pre.obj 𝒢).obj (Opposite.op E)) :=
    fun 𝒢 E => AddEquiv.mk' ((e₁ 𝒢 E).trans (evHom 𝒢 E)) (by
      intro α β
      dsimp [e₁]
      rw [map_add, hevHom, hevHom, hevHom, S_pre.map_add]
      rfl)
  let addEquivAt : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (W : Opposite X.Etale),
      ↥(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢).obj W) ≃+
        ↥((S_pre.obj 𝒢).obj W) :=
    fun 𝒢 W => addEquivObj 𝒢 W.unop
  let isoShRev : ∀ (𝒢 : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢 ≅ S_pre.obj 𝒢 :=
    fun 𝒢 => CategoryTheory.NatIso.ofComponents (fun W => (addEquivAt 𝒢 W).toAddCommGrpIso) (by
      intro W₁ W₂ v
      let E₁ := W₁.unop
      let E₂ := W₂.unop
      let u : E₂ ⟶ E₁ := v.unop
      apply AddCommGrpCat.ext
      intro α
      let α' : CategoryTheory.Abelian.Ext (F_E E₁) 𝒢 0 := α
      let g : F_E E₁ ⟶ 𝒢 := CategoryTheory.Abelian.Ext.addEquiv₀ α'
      let φ_u : F_E E₂ ⟶ F_E E₁ :=
        L_X.map (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free)
      have hmap : (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢).map v) α =
          CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ g) := by
        change (CategoryTheory.Abelian.Ext.mk₀ φ_u).comp α' (Nat.zero_add 0) = _
        rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α']
        exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ φ_u g
      change (addEquivAt 𝒢 W₂)
          ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj 𝒢).map v) α) =
        ((S_pre.obj 𝒢).map v) ((addEquivAt 𝒢 W₁) α)
      rw [hmap]
      change (addEquivObj 𝒢 E₂) (CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ g)) =
        ((S_pre.obj 𝒢).map v) ((addEquivObj 𝒢 E₁) α')
      have hlhs : (addEquivObj 𝒢 E₂) (CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ g)) =
          evHom 𝒢 E₂ (φ_u ≫ g) := by
        change evHom 𝒢 E₂ (CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (φ_u ≫ g))) = _
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (φ_u ≫ g),
          AddEquiv.apply_symm_apply]
      have hrhs : (addEquivObj 𝒢 E₁) α' = evHom 𝒢 E₁ g := rfl
      rw [hlhs, hrhs]
      dsimp [evHom, e₂, e₃, e₄, φ_u]
      rw [adj_sh.homEquiv_naturality_left,
        ← CategoryTheory.Functor.whiskeringRight_obj_map,
        adj_ab.homEquiv_naturality_left,
        ← CategoryTheory.yonedaEquiv_naturality]
      rfl)
  let isoRev : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ S_pre :=
    CategoryTheory.NatIso.ofComponents isoShRev (by
      intro 𝒢₁ 𝒢₂ ψ
      ext W α
      let E := W.unop
      let α' : CategoryTheory.Abelian.Ext (F_E E) 𝒢₁ 0 := α
      let g : F_E E ⟶ 𝒢₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α'
      have hmap : (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map ψ).app W) α =
          CategoryTheory.Abelian.Ext.mk₀ (g ≫ ψ) := by
        change α'.comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero 0) = _
        rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α']
        exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ g ψ
      change (addEquivAt 𝒢₂ W)
          ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map ψ).app W) α) =
        ((S_pre.map ψ).app W) ((addEquivAt 𝒢₁ W) α)
      rw [hmap]
      change (addEquivObj 𝒢₂ E) (CategoryTheory.Abelian.Ext.mk₀ (g ≫ ψ)) =
        ((S_pre.map ψ).app (Opposite.op E)) ((addEquivObj 𝒢₁ E) α')
      have hlhs : (addEquivObj 𝒢₂ E) (CategoryTheory.Abelian.Ext.mk₀ (g ≫ ψ)) =
          evHom 𝒢₂ E (g ≫ ψ) := by
        change evHom 𝒢₂ E (CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (g ≫ ψ))) = _
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (g ≫ ψ),
          AddEquiv.apply_symm_apply]
      have hrhs : (addEquivObj 𝒢₁ E) α' = evHom 𝒢₁ E g := rfl
      rw [hlhs, hrhs, hevHom 𝒢₂ E (g ≫ ψ), hevHom 𝒢₁ E g, S_pre.map_comp]
      rfl)
  let e₀ : S_pre ≅ CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 := isoRev.symm
  let J_S := S.smallEtaleTopology
  let P_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    B_f AddCommGrpCat.{u} _ J_S J_X hCont
  let S_S := CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}
  let L_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  let W_f := (CategoryTheory.Functor.whiskeringLeft
    (Opposite S.Etale) (Opposite X.Etale) AddCommGrpCat.{u}).obj B_f.op
  let R0_f := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).comp (W_f.comp L_S)
  have : CategoryTheory.IsIso
      (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).counit :=
    CategoryTheory.sheafification_reflective
  let ε_S := CategoryTheory.asIso
    (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).counit
  let Θ_nat : P_f ≅ R0_f :=
    (CategoryTheory.Functor.rightUnitor P_f).symm ≪≫
      (CategoryTheory.Functor.isoWhiskerLeft P_f ε_S).symm ≪≫
      (CategoryTheory.Functor.associator P_f S_S L_S).symm ≪≫
      CategoryTheory.Functor.isoWhiskerRight
        (CategoryTheory.Functor.sheafPushforwardContinuousCompSheafToPresheafIso
          B_f AddCommGrpCat.{u} J_S J_X) L_S ≪≫
      CategoryTheory.Functor.associator S_pre W_f L_S ≪≫
      CategoryTheory.Functor.isoWhiskerRight e₀ (W_f.comp L_S)
  refine ⟨hCont, fun ℱ => Θ_nat.app ℱ, ?_⟩
  intro ℱ₁ ℱ₂ φ
  exact Θ_nat.hom.naturality φ

theorem weil_transv_etale_sheaf_pullback_exact (X₁ X₂ : AlgebraicGeometry.Scheme.{u})
    (h : Quiver.Hom X₁ X₂) :
    (∃ (hc : (weilEtaleSitePullback h).IsContinuous
          X₂.smallEtaleTopology X₁.smallEtaleTopology),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology hc).IsRightAdjoint) ∧
    (∀ (hc : (weilEtaleSitePullback h).IsContinuous
          X₂.smallEtaleTopology X₁.smallEtaleTopology)
       (hr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          X₂.smallEtaleTopology X₁.smallEtaleTopology hc).IsRightAdjoint),
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology hc hr
      pb.Additive ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb) :=
by
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hStabComp : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let _ : P_et.IsStableUnderComposition := hStabComp

  
  have hMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left,
          ∃ (Y : S.Etale) (f : Y ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Y).left),
            R.arrows f ∧
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget S).map f).left.base y = x := by
    intro S W R
    have heq : S.smallGrothendieckTopology P_et =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
        (le_refl P_et)
    have h1 : R ∈ S.smallEtaleTopology W ↔
        R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck W :=
      iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)
    exact h1.trans
      (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology P_et P_et S
        hStabComp inferInstance inferInstance inferInstance inferInstance W R)

  
  have hContAdj : ∃ (hc : (weilEtaleSitePullback h).IsContinuous
        X₂.smallEtaleTopology X₁.smallEtaleTopology),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology hc).IsRightAdjoint := by
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale := weilEtaleSitePullback h
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget X₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget X₂
    have hTerm₂ : CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (𝟙 X₂)) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun E => CategoryTheory.MorphismProperty.Over.homMk ((Fgt₂.obj E).hom)
          (Category.comp_id ((Fgt₂.obj E).hom)) trivial)
        (fun E m => by
          apply Fgt₂.map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact (Category.comp_id ((Fgt₂.map m).left)).symm.trans ((Fgt₂.map m).w))
    have _ : CategoryTheory.Limits.HasTerminal X₂.Etale := hTerm₂.hasTerminal
    have _ : CategoryTheory.Limits.HasPullbacks X₂.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks P_et X₂
    have _ : CategoryTheory.Limits.HasFiniteLimits X₂.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have _ : CategoryTheory.Limits.PreservesFiniteLimits B :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_et h
    have _ : CategoryTheory.RepresentablyFlat B :=
      CategoryTheory.flat_of_preservesFiniteLimits B
    have hCompat : CategoryTheory.CompatiblePreserving X₁.smallEtaleTopology B :=
      CategoryTheory.compatiblePreservingOfFlat X₁.smallEtaleTopology B
    have hCov : CategoryTheory.CoverPreserving
        X₂.smallEtaleTopology X₁.smallEtaleTopology B := by
      refine ⟨fun {U} {R} hR => ?_⟩
      rw [hMem X₁ (B.obj U) (R.functorPushforward B)]
      intro z
      let h_U : (Fgt₂.obj U).left ⟶ X₂ := (Fgt₂.obj U).hom
      let fstU : CategoryTheory.Limits.pullback h_U h ⟶ (Fgt₂.obj U).left :=
        CategoryTheory.Limits.pullback.fst h_U h
      obtain ⟨Y, f, y, hfR, hEt_f, hy⟩ := (hMem X₂ U R).mp hR (fstU.base z)
      let _ : AlgebraicGeometry.Etale ((Fgt₂.map f).left) := hEt_f
      have hBf_mem : (R.functorPushforward B).arrows (B.map f) :=
        CategoryTheory.Sieve.image_mem_functorPushforward B R hfR
      have _ : AlgebraicGeometry.Etale ((Fgt₁.obj (B.obj Y)).hom) := (B.obj Y).prop
      have _ : AlgebraicGeometry.Etale ((Fgt₁.obj (B.obj U)).hom) := (B.obj U).prop
      have _ : AlgebraicGeometry.Etale
          ((Fgt₁.map (B.map f)).left ≫ (Fgt₁.obj (B.obj U)).hom) := by
        rwa [(Fgt₁.map (B.map f)).w]
      have hBf_et : AlgebraicGeometry.Etale ((Fgt₁.map (B.map f)).left) :=
        AlgebraicGeometry.Etale.of_comp ((Fgt₁.map (B.map f)).left) ((Fgt₁.obj (B.obj U)).hom)
      let h_Y : (Fgt₂.obj Y).left ⟶ X₂ := (Fgt₂.obj Y).hom
      let f_left : (Fgt₂.obj Y).left ⟶ (Fgt₂.obj U).left := (Fgt₂.map f).left
      let bf_left : CategoryTheory.Limits.pullback h_Y h ⟶
          CategoryTheory.Limits.pullback h_U h := (Fgt₁.map (B.map f)).left
      have hRight : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd h_U h) fstU h h_U :=
        (CategoryTheory.IsPullback.of_hasPullback h_U h).flip
      have hOuter : CategoryTheory.IsPullback
          (bf_left ≫ CategoryTheory.Limits.pullback.snd h_U h)
          (CategoryTheory.Limits.pullback.fst h_Y h) h (f_left ≫ h_U) := by
        have hw1 : bf_left ≫ CategoryTheory.Limits.pullback.snd h_U h =
            CategoryTheory.Limits.pullback.snd h_Y h := (Fgt₁.map (B.map f)).w
        have hw2 : f_left ≫ h_U = h_Y := (Fgt₂.map f).w
        rw [hw1, hw2]
        exact (CategoryTheory.IsPullback.of_hasPullback h_Y h).flip
      have hcomm_u : (CategoryTheory.Limits.pullback.fst h_Y h ≫ f_left) ≫ h_U =
          CategoryTheory.Limits.pullback.snd h_Y h ≫ h :=
        (Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.fst h_Y h)) ((Fgt₂.map f).w)).trans
            CategoryTheory.Limits.pullback.condition)
      have hBf_def : bf_left = CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h_Y h ≫ f_left)
          (CategoryTheory.Limits.pullback.snd h_Y h) hcomm_u := rfl
      have hCommSq : bf_left ≫ fstU = CategoryTheory.Limits.pullback.fst h_Y h ≫ f_left := by
        rw [hBf_def, CategoryTheory.Limits.pullback.lift_fst]
      have hLeft : CategoryTheory.IsPullback bf_left
          (CategoryTheory.Limits.pullback.fst h_Y h) fstU f_left :=
        CategoryTheory.IsPullback.of_right hOuter hCommSq hRight
      obtain ⟨w₀, hw₀_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      let y' : ↥((Fgt₁.obj (B.obj Y)).left) := hLeft.isoPullback.inv.base w₀
      refine ⟨B.obj Y, B.map f, y', hBf_mem, hBf_et, ?_⟩
      have hy'_eq : ((Fgt₁.map (B.map f)).left).base y' =
          (CategoryTheory.Limits.pullback.fst fstU f_left).base w₀ := by
        change (hLeft.isoPullback.inv ≫ bf_left).base w₀ = _
        rw [hLeft.isoPullback_inv_fst]
      exact hy'_eq.trans hw₀_fst
    have hc : B.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov
    let _ : B.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology := hc
    let ι₂ : CategoryTheory.Functor X₂.AffineEtale X₂.Etale :=
      AlgebraicGeometry.Scheme.AffineEtale.Spec X₂
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology X₂
    let M₂ : Type u := CategoryTheory.SmallModel.{u} X₂.AffineEtale
    let e_sm : X₂.AffineEtale ≌ M₂ := CategoryTheory.equivSmallModel.{u} X₂.AffineEtale
    let J_M := e_sm.inverse.inducedTopology J_aff
    let _ : ι₂.IsContinuous J_aff X₂.smallEtaleTopology := inferInstance
    let _ : e_sm.inverse.IsContinuous J_M J_aff := inferInstance
    let _ : (ι₂ ⋙ B).IsContinuous J_aff X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp ι₂ B J_aff
        X₂.smallEtaleTopology X₁.smallEtaleTopology
    let K : CategoryTheory.Functor M₂ X₁.Etale := e_sm.inverse ⋙ (ι₂ ⋙ B)
    let _ : K.IsContinuous J_M X₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp e_sm.inverse (ι₂ ⋙ B) J_M
        J_aff X₁.smallEtaleTopology
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let F_ι := ι₂.sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₂.smallEtaleTopology
    let F_sm := e_sm.inverse.sheafPushforwardContinuous AddCommGrpCat.{u} J_M J_aff
    let P_K := K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let _ : F_ι.IsEquivalence := inferInstance
    let _ : F_sm.IsEquivalence := inferInstance
    let E_ι := F_ι.asEquivalence
    let E_sm := F_sm.asEquivalence
    let G₁ := (ι₂ ⋙ B).sheafPushforwardContinuous AddCommGrpCat.{u} J_aff X₁.smallEtaleTopology
    let e₁ : P_push ⋙ E_ι.functor ≅ G₁ :=
      (CategoryTheory.Functor.sheafPushforwardContinuousComp ι₂ B AddCommGrpCat.{u}
        J_aff X₂.smallEtaleTopology X₁.smallEtaleTopology).symm
    let e₂ : G₁ ⋙ E_sm.functor ≅ P_K :=
      (CategoryTheory.Functor.sheafPushforwardContinuousComp e_sm.inverse (ι₂ ⋙ B)
        AddCommGrpCat.{u} J_M J_aff X₁.smallEtaleTopology).symm
    let e₂' : P_K ⋙ E_sm.inverse ≅ G₁ :=
      CategoryTheory.NatIso.ofComponents
        (fun X => (E_sm.inverse.mapIso (e₂.app X).symm).trans (E_sm.unitIso.app (G₁.obj X)).symm)
        (fun {X Y} u => by
          dsimp
          have hnat := e₂.inv.naturality u
          dsimp at hnat
          have hunit := E_sm.unitInv.naturality (G₁.map u)
          dsimp at hunit
          rw [← Category.assoc, ← E_sm.inverse.map_comp, hnat,
            E_sm.inverse.map_comp, Category.assoc, hunit, ← Category.assoc])
    let e₁' : G₁ ⋙ E_ι.inverse ≅ P_push :=
      CategoryTheory.NatIso.ofComponents
        (fun X => (E_ι.inverse.mapIso (e₁.app X).symm).trans (E_ι.unitIso.app (P_push.obj X)).symm)
        (fun {X Y} u => by
          dsimp
          have hnat := e₁.inv.naturality u
          dsimp at hnat
          have hunit := E_ι.unitInv.naturality (P_push.map u)
          dsimp at hunit
          rw [← Category.assoc, ← E_ι.inverse.map_comp, hnat,
            E_ι.inverse.map_comp, Category.assoc, hunit, ← Category.assoc])
    let e_rhs : P_K ⋙ (E_sm.inverse ⋙ E_ι.inverse) ≅ P_push :=
      CategoryTheory.NatIso.ofComponents
        (fun X => (E_ι.inverse.mapIso (e₂'.app X)).trans (e₁'.app X))
        (fun {X Y} u => by
          have hnat₂ := e₂'.hom.naturality u
          dsimp at hnat₂
          have hnat₁ := e₁'.hom.naturality u
          dsimp at hnat₁
          change E_ι.inverse.map (E_sm.inverse.map (P_K.map u)) ≫
              (E_ι.inverse.map (e₂'.hom.app Y) ≫ e₁'.hom.app Y) =
            (E_ι.inverse.map (e₂'.hom.app X) ≫ e₁'.hom.app X) ≫ P_push.map u
          rw [← Category.assoc, ← E_ι.inverse.map_comp, hnat₂,
            E_ι.inverse.map_comp, Category.assoc, hnat₁, ← Category.assoc])
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M X₁.smallEtaleTopology
    let adj_tot := ((E_ι.toAdjunction.comp E_sm.toAdjunction).comp adj_K).ofNatIsoRight e_rhs
    exact ⟨hc, adj_tot.isRightAdjoint⟩

  refine ⟨hContAdj, ?_⟩
  intro hc hr pb
  let _ : CategoryTheory.Abelian
      (CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.Abelian
      (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    (weilEtaleSitePullback h) AddCommGrpCat.{u} _
    X₂.smallEtaleTopology X₁.smallEtaleTopology hc
  let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
    (weilEtaleSitePullback h) AddCommGrpCat.{u} _
    X₂.smallEtaleTopology X₁.smallEtaleTopology hc hr
  let _ : pb.IsLeftAdjoint := adj.isLeftAdjoint
  have hColim : CategoryTheory.Limits.PreservesFiniteColimits pb := inferInstance
  let _ : CategoryTheory.Limits.PreservesFiniteColimits pb := hColim
  let _ := CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts pb
  have hAdd : pb.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts pb
  let _ : pb.Additive := hAdd
