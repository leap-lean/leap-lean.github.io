          AlgebraicGeometry.IsOpenImmersion.lift U₀.ι ((U.ι ≫ iZ) ≫ g) hRange_UZ
        have hg_U : g_U ≫ U₀.ι = (U.ι ≫ iZ) ≫ g :=
