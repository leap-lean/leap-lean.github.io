      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _ hψBk_et_hom hβ₀_et) hloc_g_et

    have hsBk_ψ_C : ((AlgebraicGeometry.Spec.preimage s_Bk).hom.comp ψ_Bk).comp Polynomial.C =
