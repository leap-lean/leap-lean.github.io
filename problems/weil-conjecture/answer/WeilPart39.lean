              (CategoryTheory.Limits.pullback.fst h₁ ι_hV ≫ (Fgt_V.map f_et).left)
              (CategoryTheory.Limits.pullback.snd h₁ ι_hV)
              (by rw [Category.assoc, CategoryTheory.Over.w (Fgt_V.map f_et),
