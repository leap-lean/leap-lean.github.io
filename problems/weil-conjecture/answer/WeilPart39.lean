        (∀ σ : Γ₀, IsOpen (Set.range (δ σ).base)) →
        (∀ σ₁ σ₂ : Γ₀, σ₁ ≠ σ₂ → Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) →
        (⋃ σ : Γ₀, Set.range (δ σ).base) = Set.univ →
