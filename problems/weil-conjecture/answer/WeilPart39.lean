  have hEx_α : ∀ r : ℕ,
      ∃ α_r : Quiver.Hom (𝒱₀ r) (ℛ r),
        ∀ (W : U₀.toScheme.Etale)
          (s : ↑((𝒱₀ r).obj.obj (Opposite.op W)))
          (y_raw : ↥(CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom (π_Braw r))),
