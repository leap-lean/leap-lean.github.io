      let M_prod : nonZeroDivisors R₀ := ∏ c ∈ S_gen, m_fn c
      refine ⟨M_prod.1, mem_nonZeroDivisors_iff_ne_zero.mp M_prod.2, ?_⟩
      intro g₁ _ hg₀_dvd hd_dvd φ_g₁ hφ_g₁
      dsimp only
      let R'' := Localization.Away g₁
      letI : Algebra R'' ↥L_top := ((algebraMap K ↥L_top).comp φ_g₁).toAlgebra
      have hST_R₀_R''_Ltop : IsScalarTower R₀ R'' ↥L_top :=
        IsScalarTower.of_algebraMap_eq fun r => by
          change algebraMap K ↥L_top (algebraMap R₀ K r) =
            algebraMap K ↥L_top (φ_g₁ (algebraMap R₀ R'' r))
          rw [← hφ_g₁, RingHom.comp_apply]
      refine ⟨?_, ?_⟩
      · have hS_mem : ∀ c ∈ S_gen, ψ_C c ∈ integralClosure R'' ↥L_top := by
          intro c hc
          have hm_dvd_M : (m_fn c).1 ∣ M_prod.1 := by
            rw [SubmonoidClass.coe_finsetProd]
            exact Finset.dvd_prod_of_mem (fun x => (m_fn x).1) hc
          obtain ⟨q_c, hq_c⟩ := dvd_trans hm_dvd_M hd_dvd
          let u_inv : R'' := algebraMap R₀ R'' q_c * IsLocalization.Away.invSelf g₁
          have hu_mul : algebraMap R₀ R'' (m_fn c).1 * u_inv = 1 := by
            dsimp [u_inv]
            rw [← mul_assoc, ← map_mul, ← hq_c, IsLocalization.Away.mul_invSelf g₁]
          have hy_int : algebraMap R₀ ↥L_top (m_fn c).1 * ψ_C c ∈ integralClosure R'' ↥L_top := by
            have h0 : _root_.IsIntegral R₀ (algebraMap R₀ ↥L_top (m_fn c).1 * ψ_C c) := by
              rw [← Algebra.smul_def]
              exact hm_fn c
            exact IsIntegral.tower_top h0
          have h_prod_mem : algebraMap R'' ↥L_top u_inv *
              (algebraMap R₀ ↥L_top (m_fn c).1 * ψ_C c) ∈ integralClosure R'' ↥L_top :=
            (integralClosure R'' ↥L_top).mul_mem
              ((integralClosure R'' ↥L_top).algebraMap_mem u_inv) hy_int
          have h_eq : algebraMap R'' ↥L_top u_inv *
              (algebraMap R₀ ↥L_top (m_fn c).1 * ψ_C c) = ψ_C c := by
            rw [IsScalarTower.algebraMap_apply R₀ R'' ↥L_top (m_fn c).1, ← mul_assoc,
              ← map_mul, mul_comm u_inv _, hu_mul, map_one, one_mul]
          rwa [h_eq] at h_prod_mem
        let A_sub : Subalgebra R₀ C :=
          ((integralClosure R'' ↥L_top).restrictScalars R₀).comap ψ_C
        have h_le : (S_gen : Set C) ⊆ (A_sub : Set C) := fun c hc => hS_mem c hc
        have h_top : (⊤ : Subalgebra R₀ C) ≤ A_sub := by
          rw [← hS_gen]
