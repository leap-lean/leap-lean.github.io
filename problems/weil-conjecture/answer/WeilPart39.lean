        (fun _ _ => mul_comm _ _)
    have hφ_tmul : ∀ x y : L,
        φ_RL_KL (TensorProduct.tmul R x y) = TensorProduct.tmul K x y := by
      intro x y
      have h := Algebra.TensorProduct.lift_tmul
        (Algebra.TensorProduct.includeLeft (R := K) (S := L) (A := L) (B := L))
        ((Algebra.TensorProduct.includeRight (R := K) (A := L) (B := L)).restrictScalars R)
        (fun _ _ => mul_comm _ _) x y
      change φ_RL_KL (TensorProduct.tmul R x y) =
        TensorProduct.tmul K x (1 : L) * TensorProduct.tmul K (1 : L) y at h
      rw [h, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hφ_inj : Function.Injective φ_RL_KL := by
      let u₁ : K →+* TensorProduct R L L :=
        (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := L) (B := L)).comp (algebraMap K L)
      let u₂ : K →+* TensorProduct R L L :=
        (Algebra.TensorProduct.includeRight (R := R) (A := L) (B := L)).toRingHom.comp (algebraMap K L)
      have hu_eq : u₁ = u₂ := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R)
        ext r
        dsimp [u₁, u₂]
        rw [← IsScalarTower.algebraMap_apply R K L]
        change TensorProduct.tmul R (algebraMap R L r) 1 = TensorProduct.tmul R 1 (algebraMap R L r)
        rw [Algebra.algebraMap_eq_smul_one r, TensorProduct.smul_tmul]
      let g_K : L →ₐ[K] TensorProduct R L L :=
        { (Algebra.TensorProduct.includeRight (R := R) (A := L) (B := L)).toRingHom with
          commutes' := fun k => by
            change TensorProduct.tmul R (1 : L) (algebraMap K L k) =
              algebraMap K (TensorProduct R L L) k
            rw [IsScalarTower.algebraMap_apply K L (TensorProduct R L L)]
            exact (congrFun (congrArg DFunLike.coe hu_eq) k).symm }
      let ψ_KL_RL : TensorProduct K L L →ₐ[L] TensorProduct R L L :=
        Algebra.TensorProduct.lift
          (Algebra.TensorProduct.includeLeft (R := R) (S := L) (A := L) (B := L))
          g_K (fun _ _ => mul_comm _ _)
      have h_comp : ((ψ_KL_RL.comp φ_RL_KL).restrictScalars R).toLinearMap = LinearMap.id := by
        apply TensorProduct.ext'
        intro x y
        change ψ_KL_RL (φ_RL_KL (TensorProduct.tmul R x y)) = TensorProduct.tmul R x y
        rw [hφ_tmul]
        have h := Algebra.TensorProduct.lift_tmul
          (Algebra.TensorProduct.includeLeft (R := R) (S := L) (A := L) (B := L))
          g_K (fun _ _ => mul_comm _ _) x y
        change ψ_KL_RL (TensorProduct.tmul K x y) =
          TensorProduct.tmul R x (1 : L) * TensorProduct.tmul R (1 : L) y at h
        rw [h, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      have h_left_inv : Function.LeftInverse ψ_KL_RL φ_RL_KL :=
        fun w => congrFun (congrArg DFunLike.coe h_comp) w
      exact h_left_inv.injective
