    · intro B_k _ e_Bk _ s_Bk hs_Bk
      let W_chart := CategoryTheory.Limits.pullback e_Bk j_chart
      let fst := CategoryTheory.Limits.pullback.fst e_Bk j_chart
      let snd := CategoryTheory.Limits.pullback.snd e_Bk j_chart
      have _ : AlgebraicGeometry.IsOpenImmersion fst := inferInstance
      have _ : AlgebraicGeometry.Etale fst := inferInstance
      have _ : AlgebraicGeometry.Etale snd := inferInstance
      let σ₁ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W_chart :=
