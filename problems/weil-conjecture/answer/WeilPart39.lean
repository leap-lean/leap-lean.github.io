    intro r
    refine hQuotDescent r (T_raw.B_raw r) (T_raw.L_raw r) (j_BV r) (hj_BV r).1 (ℛ r)
      (fun W => (LocallyConstant.mapAddMonoidHom (β_lat r)).comp (triv_R r W))
      ?_ ?_
    · intro W₁ W₂ u h₁ h₂ W₁_2 W₂_2 u₂ hu_fst hu_snd s₂ y₁
      exact congrArg (β_lat r) ((hTriv_R_spec r).1 u u₂ hu_fst hu_snd s₂ y₁)
    · intro W h_W W₂ s₂ τ_raw σ hcomp m_τ hm_fst hm_snd y
      have hf_mem : triv_R r W s₂ ∈ Set.range (triv_R r W) := ⟨s₂, rfl⟩
      rw [((hTriv_R_spec r).2 W).2.1] at hf_mem
      have hf_eq := hf_mem τ_raw m_τ hm_fst hm_snd y
      change β_lat r (triv_R r W s₂ (m_τ.base y)) =
        ((ρ_V r σ).val).mulVec (β_lat r (triv_R r W s₂ y))
      rw [hf_eq]
      exact (hαβ_equivar r τ_raw σ hcomp).2 (triv_R r W s₂ y)
  choose β_U₀ hβ_U₀_spec using hEx_β

  
  let p_ι : ∀ r : ℕ,
      AlgebraicGeometry.Spec (CommRingCat.of (B_V (r + 1))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (B_V r)) :=
    fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_BV r).toRingHom)
  have hp_ι_π : ∀ r : ℕ, p_ι r ≫ π_BV r = π_BV (r + 1) := by
    intro r
