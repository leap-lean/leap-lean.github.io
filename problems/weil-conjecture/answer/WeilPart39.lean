    CategoryTheory.Limits.pullback.map X₀.hom f_ext Y₀.hom f_ext g₀
      (CategoryTheory.CategoryStruct.id _) (CategoryTheory.CategoryStruct.id _)
      ((CategoryTheory.Category.comp_id _).trans hg₀_over.symm)
      ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
  have hg_std_fst : g_std ≫ pr_Y = pr_X ≫ g₀ :=
