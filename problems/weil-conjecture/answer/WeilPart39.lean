              apply AddCommGrpCat.ext; intro n
              change (C_V'.obj.map b₁.op).hom (n.down • (η_sh.app (Opposite.op (Z_a a₁))).hom a₁) =
                (C_V'.obj.map b₂.op).hom (n.down • (η_sh.app (Opposite.op (Z_a a₁))).hom a₁)
              rw [map_zsmul, map_zsmul]
              have hn₁ := congrArg (fun u : A ⟶ C_V'.obj.obj (Opposite.op W') => u.hom a₁)
                (η_sh.naturality b₁.op)
              have hn₂ := congrArg (fun u : A ⟶ C_V'.obj.obj (Opposite.op W') => u.hom a₁)
                (η_sh.naturality b₂.op)
              dsimp [P_const] at hn₁ hn₂
              rw [← hn₁, ← hn₂]
            · refine hEmptyHomEq V C_V' W' ⟨fun w => ha ?_⟩ _ _
              have hbw : (b₁.left ≫ (U_a a₁).ι).base w = (b₂.left ≫ (U_a a₂).ι).base w :=
                congrArg (fun m : W' ⟶ Y => m.left.base w) hb
              have hm₁ : g ((b₁.left ≫ (U_a a₁).ι).base w) = a₁ := (b₁.left.base w).2
              have hm₂ : g ((b₂.left ≫ (U_a a₂).ι).base w) = a₂ := (b₂.left.base w).2
              exact hm₁.symm.trans ((congrArg g hbw).trans hm₂)
          let am := C_V'.property.amalgamateOfArrows k_a hk_cov c_a h_ov
          ⟨am.hom (ULift.up 1), fun a => by
            have ham := C_V'.property.amalgamateOfArrows_map k_a hk_cov c_a h_ov a
            have h1 := congrArg (fun u : E_ℤ ⟶ C_V'.obj.obj (Opposite.op (Z_a a)) =>
              u.hom (ULift.up 1)) ham
            have h2 : (am ≫ C_V'.obj.map (k_a a).op).hom (ULift.up 1) =
                (C_V'.obj.map (k_a a).op).hom (am.hom (ULift.up 1)) := rfl
            have h3 : (c_a a).hom (ULift.up 1) =
                (η_sh.app (Opposite.op (Z_a a))).hom a := one_zsmul _
            exact h2.symm.trans (h1.trans h3)⟩
      let ψ_elem : ∀ (Y : V.Etale), LocallyConstant ↥Y.left ↥A → ↑(C_V'.obj.obj (Opposite.op Y)) :=
        fun Y g => (ψ_sub Y g).1
      have hψ_spec : ∀ (Y : V.Etale) (g : LocallyConstant ↥Y.left ↥A) (a : ↥A),
          let U_a : Y.left.Opens := ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
          let k_a : mkOpenObj Y U_a ⟶ Y := mkOpenHom Y U_a
