        ((ξ_π.hom.app ℱ).hom.app (Opposite.op T_V)) hIso_ξ_TV hIso_lhs_comp

    
    
    
    have hIso_unit_V : CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT_V).unit.app A) := by
      have hArrowEtale : ∀ {Y₁ Y₂ : V.Etale} (u : Y₁ ⟶ Y₂),
          AlgebraicGeometry.Etale u.left := by
        intro Y₁ Y₂ u
        have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
        have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := by
          rw [hw]
          exact Y₁.prop
        exact CategoryTheory.MorphismProperty.of_postcomp
          (@AlgebraicGeometry.Etale) u.left Y₂.hom Y₂.prop hcomp
      let P_A : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
        { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
          map := fun f => AddCommGrpCat.ofHom
            (LocallyConstant.comapAddMonoidHom (Z := ↥A) f.unop.left.base.hom)
          map_id := fun _ => by ext g x; rfl
          map_comp := fun _ _ => by ext g x; rfl }
      let P_const : CategoryTheory.Functor (Opposite V.Etale) AddCommGrpCat.{u} :=
        (CategoryTheory.Functor.const (Opposite V.Etale)).obj A
      let θ_A : P_const ⟶ P_A :=
        { app := fun E => AddCommGrpCat.ofHom
            (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
          naturality := fun _ _ _ => by ext a x; rfl }
      have hSheaf : CategoryTheory.Presheaf.IsSheaf J_V P_A := by
        rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
        intro E S hS
        let cov := fun x : ↥E.left => (hMemEtale V E S).mp hS x
        let Y_x := fun x : ↥E.left => Classical.choose (cov x)
        let u_x := fun x : ↥E.left => Classical.choose (Classical.choose_spec (cov x))
        let spec_x := fun x : ↥E.left =>
          Classical.choose_spec (Classical.choose_spec (cov x))
        let y_x := fun x : ↥E.left => Classical.choose (spec_x x)
        let hy_spec := fun x : ↥E.left => Classical.choose_spec (spec_x x)
        let w_x : ↥E.left → S.arrows.category := fun x =>
          ⟨CategoryTheory.Over.mk (u_x x), (hy_spec x).1⟩
        let sec : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
            (w : S.arrows.category), ↥c.pt →+ LocallyConstant ↥w.obj.left.left ↥A :=
          fun c w => (c.π.app (Opposite.op w)).hom
        let raw_fn : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A)),
            ↥c.pt → ↥E.left → ↥A :=
          fun c m x => sec c (w_x x) m (y_x x)
        have hCompat : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
            (w₁ w₂ : S.arrows.category) (m : ↥c.pt)
            (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
            w₁.obj.hom.left y₁ = w₂.obj.hom.left y₂ →
            sec c w₁ m y₁ = sec c w₂ m y₂ := by
          intro c w₁ w₂ m y₁ y₂ hy_eq
          let u₁ := w₁.obj.hom
          let u₂ := w₂.obj.hom
          have : AlgebraicGeometry.Etale u₂.left := hArrowEtale u₂
          let p₁ := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
          let p₂ := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
          have : AlgebraicGeometry.Etale w₁.obj.left.hom := w₁.obj.left.prop
          let Z_et : V.Etale :=
            AlgebraicGeometry.Scheme.Etale.mk (p₁ ≫ w₁.obj.left.hom)
          let q₁ : Z_et ⟶ w₁.obj.left :=
            CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
          have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom := by
            change p₂ ≫ w₂.obj.left.hom = p₁ ≫ w₁.obj.left.hom
            rw [← CategoryTheory.MorphismProperty.Over.w u₂,
                ← CategoryTheory.MorphismProperty.Over.w u₁,
                ← CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.condition]
          let q₂ : Z_et ⟶ w₂.obj.left :=
            CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
          have hq_eq : q₁ ≫ u₁ = q₂ ≫ u₂ := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact CategoryTheory.Limits.pullback.condition
          let w₁₂ : S.arrows.category :=
            ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
          let α₁ : w₁₂ ⟶ w₁ :=
            CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
          let α₂ : w₁₂ ⟶ w₂ :=
            CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_eq.symm)
          obtain ⟨z, hz₁, hz₂⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
          have hw₁ : sec c w₁ m (p₁ z) = sec c w₁₂ m z :=
            congrArg (fun (φ : c.pt ⟶ P_A.obj (Opposite.op w₁₂.obj.left)) =>
              (φ.hom m : LocallyConstant ↥w₁₂.obj.left.left ↥A) z) (c.w α₁.op)
          have hw₂ : sec c w₂ m (p₂ z) = sec c w₁₂ m z :=
            congrArg (fun (φ : c.pt ⟶ P_A.obj (Opposite.op w₁₂.obj.left)) =>
              (φ.hom m : LocallyConstant ↥w₁₂.obj.left.left ↥A) z) (c.w α₂.op)
          rw [hz₁] at hw₁
          rw [hz₂] at hw₂
          exact hw₁.trans hw₂.symm
        have hEval : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
            (w : S.arrows.category) (m : ↥c.pt) (y : ↥w.obj.left.left),
            raw_fn c m (w.obj.hom.left y) = sec c w m y := by
          intro c w m y
          exact hCompat c (w_x (w.obj.hom.left y)) w m _ y (hy_spec (w.obj.hom.left y)).2.2
        have hLocConst : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
            (m : ↥c.pt), IsLocallyConstant (raw_fn c m) := by
          intro c m s
          rw [isOpen_iff_forall_mem_open]
          intro x hx
          let f_x : LocallyConstant ↥(Y_x x).left ↥A := sec c (w_x x) m
          let O : Set ↥(Y_x x).left := f_x ⁻¹' s
          have hO_open : IsOpen O := f_x.isLocallyConstant s
          have hy_mem : y_x x ∈ O := hx
          have : AlgebraicGeometry.Etale (u_x x).left := (hy_spec x).2.1
          refine ⟨⇑(u_x x).left '' O, ?_, (u_x x).left.isOpenMap O hO_open,
            ⟨y_x x, hy_mem, (hy_spec x).2.2⟩⟩
          rintro x' ⟨y', hy'O, rfl⟩
          change raw_fn c m ((w_x x).obj.hom.left y') ∈ s
          rw [hEval c (w_x x) m y']
          exact hy'O
        refine ⟨{
          lift := fun c => AddCommGrpCat.ofHom
            { toFun := fun m => ⟨raw_fn c m, hLocConst c m⟩
              map_zero' := by
                apply LocallyConstant.ext
                intro x
                exact congrArg (fun g : LocallyConstant ↥(w_x x).obj.left.left ↥A => g (y_x x))
                  (sec c (w_x x)).map_zero
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext
                intro x
                exact congrArg (fun g : LocallyConstant ↥(w_x x).obj.left.left ↥A => g (y_x x))
                  ((sec c (w_x x)).map_add m₁ m₂) }
          fac := fun c j => by
            rcases j with ⟨w⟩
            apply AddCommGrpCat.ext
            intro m
            apply LocallyConstant.ext
            intro y
            exact hEval c w m y
          uniq := fun c l hl => by
            apply AddCommGrpCat.ext
            intro m
            apply LocallyConstant.ext
            intro x
            let l_fn : LocallyConstant ↥E.left ↥A := l.hom m
            have hl_app : l_fn ((u_x x).left (y_x x)) = sec c (w_x x) m (y_x x) :=
              congrArg (fun (φ : c.pt ⟶ P_A.obj (Opposite.op (w_x x).obj.left)) =>
                (φ.hom m : LocallyConstant ↥(w_x x).obj.left.left ↥A) (y_x x))
                (hl (Opposite.op (w_x x)))
            exact (congrArg l_fn (hy_spec x).2.2).symm.trans hl_app }⟩
      let ℒ_A : CategoryTheory.Sheaf J_V AddCommGrpCat.{u} := ⟨P_A, hSheaf⟩
      have hLocInj_θ : CategoryTheory.Presheaf.IsLocallyInjective J_V θ_A := by
        refine ⟨fun {E} a₁ a₂ ha => ?_⟩
        by_cases hEmp : IsEmpty ↥E.unop.left
        · exact (hMemEtale V E.unop _).mpr (fun x => hEmp.elim x)
        · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
          have ha_eq : a₁ = a₂ := congrArg (fun g : LocallyConstant ↥E.unop.left ↥A => g x₀) ha
          subst ha_eq
          have htop : CategoryTheory.Presheaf.equalizerSieve (F := P_const) (X := E) a₁ a₁ = ⊤ :=
            (CategoryTheory.Sieve.id_mem_iff_eq_top).mp rfl
          rw [htop]
          exact J_V.top_mem E.unop
      have hLocSurj_θ : CategoryTheory.Presheaf.IsLocallySurjective J_V θ_A := by
        refine ⟨fun {E} f => (hMemEtale V E _).mpr (fun x => ?_)⟩
        let a : ↥A := f x
        let O : E.left.Opens := ⟨f ⁻¹' {a}, f.isLocallyConstant {a}⟩
        have hx_mem : x ∈ (O : Set ↥E.left) := rfl
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι O] at hx_mem
        obtain ⟨y, hy⟩ := hx_mem
        have : AlgebraicGeometry.Etale E.hom := E.prop
        let Y_O : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (O.ι ≫ E.hom)
        let u_O : Y_O ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl trivial
        refine ⟨Y_O, u_O, y, ?_, inferInstance, hy⟩
        rw [CategoryTheory.Presheaf.imageSieve_apply]
        refine ⟨a, ?_⟩
        ext z
        have hz_mem : O.ι z ∈ (O : Set ↥E.left) := by
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι O]
          exact ⟨z, rfl⟩
        exact hz_mem.symm
      have hW_θ : J_V.W θ_A :=
        (J_V.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj_θ, hLocSurj_θ⟩
      let adj_sh_V := CategoryTheory.sheafificationAdjunction J_V AddCommGrpCat.{u}
      let C_V := CategoryTheory.constantSheaf J_V AddCommGrpCat.{u}
      let hIso_mapθ : CategoryTheory.IsIso
          ((CategoryTheory.presheafToSheaf J_V AddCommGrpCat.{u}).map θ_A) :=
        (J_V.W_iff θ_A).mp hW_θ
      let hIso_counit : CategoryTheory.IsIso (adj_sh_V.counit.app ℒ_A) :=
        CategoryTheory.isIso_sheafificationAdjunction_counit ℒ_A
      let Υ_A : C_V.obj A ⟶ ℒ_A := (adj_sh_V.homEquiv P_const ℒ_A).symm θ_A
      have hΥ_eq : Υ_A =
          (CategoryTheory.presheafToSheaf J_V AddCommGrpCat.{u}).map θ_A ≫
            adj_sh_V.counit.app ℒ_A :=
        adj_sh_V.homEquiv_counit P_const ℒ_A θ_A
      have hIso_Υ : CategoryTheory.IsIso Υ_A := by
        rw [hΥ_eq]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_mapθ hIso_counit
      have hθ_fac : adj_sh_V.unit.app P_const ≫ Υ_A.hom = θ_A := by
        have h1 : (adj_sh_V.homEquiv P_const ℒ_A) Υ_A = θ_A :=
          (adj_sh_V.homEquiv P_const ℒ_A).apply_symm_apply θ_A
        rwa [adj_sh_V.homEquiv_unit] at h1
      let T_std_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
      have hθ_std_bij : Function.Bijective (θ_A.app (Opposite.op T_std_V)).hom := by
        refine ⟨?_, ?_⟩
        · intro a₁ a₂ ha
          obtain ⟨v₀⟩ := (inferInstance : Nonempty ↥V)
          exact congrArg (fun g : LocallyConstant ↥V ↥A => g v₀) ha
        · intro g
          have : Nonempty ↥A := ⟨0⟩
          have : PreconnectedSpace ↥(Opposite.unop (Opposite.op T_std_V)).left :=
            (inferInstance : PreconnectedSpace ↥V)
          obtain ⟨a, rfl⟩ := LocallyConstant.exists_eq_const g
          exact ⟨a, rfl⟩
      have hIso_θ_std : CategoryTheory.IsIso (θ_A.app (Opposite.op T_std_V)) :=
        (CategoryTheory.ConcreteCategory.isIso_iff_bijective
          (θ_A.app (Opposite.op T_std_V))).mpr hθ_std_bij
      let ev_std := (CategoryTheory.sheafSections J_V AddCommGrpCat.{u}).obj
        (Opposite.op T_std_V)
      have hIso_Υ_std : CategoryTheory.IsIso (Υ_A.hom.app (Opposite.op T_std_V)) :=
        show CategoryTheory.IsIso (ev_std.map Υ_A) from inferInstance
      have hη_std_comp : (adj_sh_V.unit.app P_const).app (Opposite.op T_std_V) ≫
          Υ_A.hom.app (Opposite.op T_std_V) = θ_A.app (Opposite.op T_std_V) :=
        congrArg (fun φ => φ.app (Opposite.op T_std_V)) hθ_fac
      let hIso_comp_std : CategoryTheory.IsIso
          ((adj_sh_V.unit.app P_const).app (Opposite.op T_std_V) ≫
            Υ_A.hom.app (Opposite.op T_std_V)) := by
        rw [hη_std_comp]
        exact hIso_θ_std
      let hIso_η_std : CategoryTheory.IsIso
          ((adj_sh_V.unit.app P_const).app (Opposite.op T_std_V)) :=
        @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
          ((adj_sh_V.unit.app P_const).app (Opposite.op T_std_V))
          (Υ_A.hom.app (Opposite.op T_std_V)) hIso_Υ_std hIso_comp_std
      let e_V : T_V ≅ T_std_V :=
        CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_V (hTermStd V)
      have hNat_V : (adj_sh_V.unit.app P_const).app (Opposite.op T_V) =
          (adj_sh_V.unit.app P_const).app (Opposite.op T_std_V) ≫
            ((C_V.obj A).obj.map e_V.hom.op) :=
        (CategoryTheory.Category.id_comp _).symm.trans
          ((adj_sh_V.unit.app P_const).naturality e_V.hom.op)
      have hUnit_eq : (CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT_V).unit.app A =
          (adj_sh_V.unit.app P_const).app (Opposite.op T_V) := by
        dsimp only [CategoryTheory.constantSheafAdj]
        rw [CategoryTheory.Adjunction.comp_unit_app]
        have hcp : (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_V).unit.app A =
            𝟙 A := rfl
        erw [hcp, CategoryTheory.Category.id_comp]
        rfl
      let hIso_map_eV : CategoryTheory.IsIso ((C_V.obj A).obj.map e_V.hom.op) := inferInstance
      rw [hUnit_eq, hNat_V]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_η_std hIso_map_eV

    let pf_yV := B_yV.sheafPushforwardContinuous AddCommGrpCat.{u} J_V J_Ω
    let pb_yV := B_yV.sheafPullback AddCommGrpCat.{u} J_V J_Ω
    let adj_yV := B_yV.sheafAdjunctionContinuous AddCommGrpCat.{u} J_V J_Ω
    let pf_yU := B_yU.sheafPushforwardContinuous AddCommGrpCat.{u} J_U J_Ω
    let pb_yU := B_yU.sheafPullback AddCommGrpCat.{u} J_U J_Ω
    let adj_yU := B_yU.sheafAdjunctionContinuous AddCommGrpCat.{u} J_U J_Ω
    let C_V := CategoryTheory.constantSheaf J_V AddCommGrpCat.{u}
    let C_Ω := CategoryTheory.constantSheaf J_Ω AddCommGrpCat.{u}

    let Fgt_Ω := AlgebraicGeometry.Scheme.Etale.forget S_Ω
    let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget V
    let Fgt_U := AlgebraicGeometry.Scheme.Etale.forget U

    have hT_ByV : CategoryTheory.Limits.IsTerminal (B_yV.obj T_V) := by
      refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W => CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift ((Fgt_Ω.obj W).hom ≫ y_V) (Fgt_Ω.obj W).hom
            (CategoryTheory.Category.comp_id ((Fgt_Ω.obj W).hom ≫ y_V)))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial) ?_
      intro W m
      let m_left : (Fgt_Ω.obj W).left ⟶ (Fgt_Ω.obj (B_yV.obj T_V)).left := (Fgt_Ω.map m).left
      have hm_snd : m_left ≫ CategoryTheory.Limits.pullback.snd (Fgt_V.obj T_V).hom y_V =
          (Fgt_Ω.obj W).hom :=
        CategoryTheory.Over.w (Fgt_Ω.map m)
      have hcond_TV :
          CategoryTheory.Limits.pullback.fst (Fgt_V.obj T_V).hom y_V ≫ (Fgt_V.obj T_V).hom =
            CategoryTheory.Limits.pullback.snd (Fgt_V.obj T_V).hom y_V ≫ y_V :=
        CategoryTheory.Limits.pullback.condition
      have hm_fst : m_left ≫ CategoryTheory.Limits.pullback.fst (Fgt_V.obj T_V).hom y_V =
          (Fgt_Ω.obj W).hom ≫ y_V :=
        (CategoryTheory.Category.comp_id
          (m_left ≫ CategoryTheory.Limits.pullback.fst (Fgt_V.obj T_V).hom y_V)).symm.trans
          ((CategoryTheory.Category.assoc m_left _ (Fgt_V.obj T_V).hom).trans
            ((congrArg (m_left ≫ ·) hcond_TV).trans
              ((CategoryTheory.Category.assoc m_left _ y_V).symm.trans
                (congrArg (· ≫ y_V) hm_snd))))
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact hm_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact hm_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm

    have hSpecSheafifyBij : ∀ (T_k : S_Ω.Etale) (hT_k : CategoryTheory.Limits.IsTerminal T_k)
        (P : CategoryTheory.Functor (Opposite S_Ω.Etale) AddCommGrpCat.{u}),
        Function.Bijective
          ((((CategoryTheory.sheafificationAdjunction J_Ω
            AddCommGrpCat.{u}).unit.app P).app (Opposite.op T_k)).hom) := by
      intro T_k hT_k P
      have hSplit : ∀ {W₀ : AlgebraicGeometry.Scheme.{u}} (q : W₀ ⟶ S_Ω),
          AlgebraicGeometry.Etale q → Function.Surjective ⇑q →
          ∃ s : S_Ω ⟶ W₀, s ≫ q = 𝟙 S_Ω := by
        intro W₀ q hqEt hqSurj
        let P_pt := AlgebraicGeometry.Scheme.geometricFiber Ω
        let R_q : CategoryTheory.Sieve S_Ω :=
          CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)
        have h_pre : CategoryTheory.Presieve.singleton q ∈
            (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale)).coverings S_Ω :=
          (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff (@AlgebraicGeometry.Etale) q).mpr
            ⟨hqSurj, hqEt⟩
        have hR_mem : R_q ∈ AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
          CategoryTheory.Precoverage.generate_mem_toGrothendieck h_pre
        obtain ⟨Y, f, hfR, y₀, hy₀⟩ := P_pt.jointly_surjective R_q hR_mem (𝟙 S_Ω)
        rcases hfR with ⟨Z, g, h, hh_sing, rfl⟩
        cases hh_sing
        exact ⟨y₀ ≫ g, hy₀⟩
      let T_std_k : S_Ω.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S_Ω)
      have hTop_std : ∀ R₀ ∈ J_Ω T_std_k, R₀ = ⊤ := by
        intro R₀ hR₀
        let pt_k : ↥S_Ω := default
        obtain ⟨W, u, w₀, huR, huEt, -⟩ := (hMemEtale S_Ω T_std_k R₀).mp hR₀ pt_k
        have huSurj : Function.Surjective ⇑u.left :=
          fun x => ⟨w₀, @Subsingleton.elim ↥S_Ω inferInstance _ x⟩
        obtain ⟨s, hs⟩ := hSplit u.left huEt huSurj
        have hu_hom : u.left = W.hom := by
          have hw : u.left ≫ 𝟙 S_Ω = W.hom := CategoryTheory.MorphismProperty.Over.w u
          exact (CategoryTheory.Category.comp_id u.left).symm.trans hw
        let s_et : T_std_k ⟶ W :=
          CategoryTheory.MorphismProperty.Over.homMk s
            ((congrArg (s ≫ ·) hu_hom.symm).trans hs) trivial
        have hsu : s_et ≫ u = 𝟙 T_std_k :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hs
        have hid : R₀.arrows (𝟙 T_std_k) := by
          rw [← hsu]
          exact R₀.downward_closed huR s_et
        exact (CategoryTheory.Sieve.id_mem_iff_eq_top).mp hid
      let e_k : T_k ≅ T_std_k :=
        CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT_k (hTermStd S_Ω)
      have hTop_Tk : ∀ R ∈ J_Ω T_k, R = ⊤ := by
        intro R hR
        have hpb : R.pullback e_k.inv ∈ J_Ω T_std_k :=
          J_Ω.pullback_stable e_k.inv hR
        have hpb_top : R.pullback e_k.inv = ⊤ := hTop_std _ hpb
        have he_inv : R.arrows e_k.inv := by
          have h1 : (R.pullback e_k.inv).arrows (𝟙 T_std_k) := by rw [hpb_top]; trivial
          simpa using h1
        have hid : R.arrows (𝟙 T_k) := by
          rw [← e_k.hom_inv_id]
