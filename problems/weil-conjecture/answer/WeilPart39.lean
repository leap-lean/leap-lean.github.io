        AlgEquiv.restrictNormal_commutes σ ↥F_sub ⟨z, hz⟩
      rw [hσ_F_one, AlgEquiv.one_apply] at hcomm
      exact hcomm.symm
    refine hTracePkg.2 hNotField @hFinRes ↥E (fun p hp P hP hP_comap => ?_)
    let _ : Finite (R₀ ⧸ p) := @hFinRes p hp
    refine weil_dedekind_galois_inertia_trivial_implies_unramified
      R₀ K ↥E ↥E p (hNotField p hp)
      (fun Q hQ_prime hQ_comap σ hσ x => ?_) P hP_comap
    let S_fix : Subfield (AlgebraicClosure K) :=
      { carrier := { w | ∃ hw : w ∈ E, σ ⟨w, hw⟩ = ⟨w, hw⟩ }
        add_mem' := by
          rintro a b ⟨ha, hσa⟩ ⟨hb, hσb⟩
          refine ⟨E.add_mem ha hb, ?_⟩
          change σ (⟨a, ha⟩ + ⟨b, hb⟩) = ⟨a, ha⟩ + ⟨b, hb⟩
          rw [map_add, hσa, hσb]
        zero_mem' := ⟨E.zero_mem, map_zero σ⟩
        neg_mem' := by
          rintro a ⟨ha, hσa⟩
          refine ⟨E.neg_mem ha, ?_⟩
          change σ (-⟨a, ha⟩) = -⟨a, ha⟩
          rw [map_neg, hσa]
        mul_mem' := by
          rintro a b ⟨ha, hσa⟩ ⟨hb, hσb⟩
          refine ⟨E.mul_mem ha hb, ?_⟩
          change σ (⟨a, ha⟩ * ⟨b, hb⟩) = ⟨a, ha⟩ * ⟨b, hb⟩
          rw [map_mul, hσa, hσb]
        one_mem' := ⟨E.one_mem, map_one σ⟩
        inv_mem' := by
          rintro a ⟨ha, hσa⟩
          refine ⟨E.inv_mem ha, ?_⟩
          change σ (⟨a, ha⟩⁻¹) = (⟨a, ha⟩)⁻¹
          rw [map_inv₀, hσa] }
    let L_fix : IntermediateField K (AlgebraicClosure K) :=
      { S_fix with
        algebraMap_mem' := fun c => ⟨E.algebraMap_mem c, σ.commutes c⟩ }
    have hle₁ : E₁ ≤ E := le_sup_left
    have hle₂ : E₂ ≤ E := le_sup_right
    have hE₁_le : E₁ ≤ L_fix := fun z hz =>
      ⟨hle₁ hz, hFixSub E₁ hle₁ ⟨hFin₁, hEt₁⟩ p Q hQ_prime hQ_comap σ hσ z hz⟩
    have hE₂_le : E₂ ≤ L_fix := fun z hz =>
      ⟨hle₂ hz, hFixSub E₂ hle₂ ⟨hFin₂, hEt₂⟩ p Q hQ_prime hQ_comap σ hσ z hz⟩
    have hE_le : E ≤ L_fix := sup_le hE₁_le hE₂_le
    obtain ⟨hw, hσw⟩ := hE_le x.2
    exact hσw

  
  have hSingleSheaf :
      ∀ (𝒢 : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ x : ↥U,
          ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U) (A₀ : AddCommGrpCat.{u}),
            AlgebraicGeometry.Etale w ∧
            x ∈ Set.range w.base ∧
            Finite ↥A₀ ∧
            WeilIsEtaleSheafPullback w 𝒢
              ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) →
        ∃ (E₀ : IntermediateField K (AlgebraicClosure K))
          (_ : FiniteDimensional K ↥E₀)
          (_ : IsGalois K ↥E₀),
          letI : Algebra R₀ ↥E₀ := ((algebraMap K ↥E₀).comp (algebraMap R₀ K)).toAlgebra
          let B₀ := ↥(integralClosure R₀ ↥E₀)
          let π₀_U : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ U :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)) ≫ e_U.hom
          Module.Finite R₀ B₀ ∧
          Algebra.Etale R₀ B₀ ∧
          ∃ A_η : AddCommGrpCat.{u},
            Finite ↥A_η ∧
            WeilIsEtaleSheafPullback π₀_U 𝒢
              ((CategoryTheory.constantSheaf
                (AlgebraicGeometry.Spec (CommRingCat.of B₀)).smallEtaleTopology
                AddCommGrpCat.{u}).obj A_η) := by
    intro 𝒢 hLC_𝒢
    obtain ⟨𝒢₀, hPb_eU, _, _⟩ := hPbPkg.1 e_U.hom 𝒢
    have hLC_U₀ : ∀ x₀ : ↥U₀,
        ∃ (W : AlgebraicGeometry.Scheme.{u}) (w₀ : W ⟶ U₀) (A₀ : AddCommGrpCat.{u}),
          AlgebraicGeometry.Etale w₀ ∧
          x₀ ∈ Set.range w₀.base ∧
          Finite ↥A₀ ∧
          WeilIsEtaleSheafPullback w₀ 𝒢₀
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) := by
      intro x₀
      obtain ⟨W, w, A₀, hw_et, ⟨z, hz⟩, hFinA, hPull_w⟩ := hLC_𝒢 (e_U.hom.base x₀)
      let _ : AlgebraicGeometry.Etale w := hw_et
      let w₀ : W ⟶ U₀ := w ≫ e_U.inv
      have hw₀_et : AlgebraicGeometry.Etale w₀ := inferInstance
      have hw₀_comp : w₀ ≫ e_U.hom = w := by
        dsimp [w₀]
        rw [CategoryTheory.Category.assoc, e_U.inv_hom_id, CategoryTheory.Category.comp_id]
      have hPull_w₀ : WeilIsEtaleSheafPullback w₀ 𝒢₀
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) :=
        (hPbPkg.2.2.1 w₀ e_U.hom 𝒢 𝒢₀ _).2 hPb_eU (hw₀_comp.symm ▸ hPull_w)
      have hx₀_mem : x₀ ∈ Set.range w₀.base := by
        refine ⟨z, ?_⟩
        change e_U.inv.base (w.base z) = x₀
        rw [hz]
        change (e_U.hom ≫ e_U.inv).base x₀ = x₀
        rw [e_U.hom_inv_id]
        rfl
      exact ⟨W, w₀, A₀, hw₀_et, hx₀_mem, hFinA, hPull_w₀⟩

    let x_gen : ↥U₀ := Classical.arbitrary ↥U₀
    obtain ⟨W_η, w_η, A_η, hw_η_et, ⟨z_η, _⟩, hFin_Aη, hPull_η⟩ := hLC_U₀ x_gen
    have hSpread : ∀ (L : IntermediateField K (AlgebraicClosure K))
        [FiniteDimensional K ↥L] [IsGalois K ↥L],
        ∃ δ_L : R₀, δ_L ≠ 0 ∧
          ∀ (g : R₀), g ≠ 0 → δ_L ∣ g →
            ∀ (φ_g : Localization.Away g →+* K),
              φ_g.comp (algebraMap R₀ (Localization.Away g)) = algebraMap R₀ K →
              letI : Algebra (Localization.Away g) ↥L :=
                ((algebraMap K ↥L).comp φ_g).toAlgebra
              Module.Finite (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L) ∧
              Algebra.Etale (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L) := by
      intro L _ _
      let _ : Algebra R₀ ↥L := ((algebraMap K ↥L).comp (algebraMap R₀ K)).toAlgebra
      have : IsScalarTower R₀ K ↥L := IsScalarTower.of_algebraMap_eq fun _ => rfl
