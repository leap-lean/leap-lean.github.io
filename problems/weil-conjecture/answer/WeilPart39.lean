    let f_jgal : C_gal →+* ↥L_top := ι₀.toRingHom.comp (algebraMap C_gal ↥L₀)
    let j_gal : C_gal →ₐ[R₀] C_top :=
      { toFun := fun b => ⟨f_jgal b, h_mem_gal b⟩
        map_one' := Subtype.ext (map_one f_jgal)
        map_mul' := fun x y => Subtype.ext (map_mul f_jgal x y)
        map_zero' := Subtype.ext (map_zero f_jgal)
        map_add' := fun x y => Subtype.ext (map_add f_jgal x y)
        commutes' := fun r => Subtype.ext (by
          change ι₀ (algebraMap K ↥L₀ (φ_g₀ (algebraMap R₀ R' r))) =
            algebraMap K ↥L_top (φ_g₁ (algebraMap R₀ R'' r))
          have h0 : φ_g₀ (algebraMap R₀ R' r) = algebraMap R₀ K r :=
            RingHom.congr_fun hφ_g₀ r
          have h1 : φ_g₁ (algebraMap R₀ R'' r) = algebraMap R₀ K r :=
            RingHom.congr_fun hφ_g₁ r
