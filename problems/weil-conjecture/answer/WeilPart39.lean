      let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := Classical.arbitrary _
      obtain ⟨U_W, hAff, hσ_mem, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := σ₁.base pt_k) (U := ⊤) trivial
      let R_obj := W_chart.presheaf.obj (Opposite.op U_W)
      have hσ_range : Set.range σ₁.base ⊆ Set.range hAff.fromSpec.base := by
        rw [hAff.range_fromSpec]
        rintro _ ⟨pt, rfl⟩
        rw [hSpecUnique pt pt_k]
        exact hσ_mem
      let σ_E : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↑R_obj) :=
        AlgebraicGeometry.IsOpenImmersion.lift hAff.fromSpec σ₁ hσ_range
      have hσ_fac : σ_E ≫ hAff.fromSpec = σ₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hAff.fromSpec σ₁ hσ_range
      let snd_aff : AlgebraicGeometry.Spec (CommRingCat.of ↑R_obj) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R₀) := hAff.fromSpec ≫ snd
      let fst_aff : AlgebraicGeometry.Spec (CommRingCat.of ↑R_obj) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B_k) := hAff.fromSpec ≫ fst
      have hsnd_et : AlgebraicGeometry.Etale snd_aff := inferInstance
      have hfst_et : AlgebraicGeometry.Etale fst_aff := inferInstance
      let α₀ : R₀ →+* ↑R_obj := (AlgebraicGeometry.Spec.preimage snd_aff).hom
      let β₀ : B_k →+* ↑R_obj := (AlgebraicGeometry.Spec.preimage fst_aff).hom
      let ε₀ : ↑R_obj →+* k := (AlgebraicGeometry.Spec.preimage σ_E).hom
      have hα₀_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) = snd_aff :=
        AlgebraicGeometry.Spec.map_preimage snd_aff
      have hβ₀_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀) = fst_aff :=
        AlgebraicGeometry.Spec.map_preimage fst_aff
      have hε₀_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε₀) = σ_E :=
        AlgebraicGeometry.Spec.map_preimage σ_E
      have hα₀_et : α₀.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hα₀_map.symm ▸ hsnd_et)
      have hβ₀_et : β₀.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hβ₀_map.symm ▸ hfst_et)
      refine ⟨↑R_obj, inferInstance, α₀, β₀, ε₀, hα₀_et, hβ₀_et, ?_, ?_, ?_⟩
      · rw [hβ₀_map, hα₀_map]
        dsimp [fst_aff, snd_aff]
        rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition]
      · suffices h : CommRingCat.ofHom (ε₀.comp α₀) = CommRingCat.ofHom eval₀_loc from
          congrArg CommRingCat.Hom.hom h
        apply AlgebraicGeometry.Spec.map_injective
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hε₀_map, hα₀_map]
        dsimp [snd_aff, s₀]
        rw [← Category.assoc, hσ_fac, CategoryTheory.Limits.pullback.lift_snd]
