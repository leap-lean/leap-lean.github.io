      ((J_U.W_iff_isLocallyBijective η₁).mp (J_U.W_adj_unit_app adj_U (P_pre q₁))).2
    have _ : CategoryTheory.Presheaf.IsLocallySurjective J_U η₂ :=
      ((J_U.W_iff_isLocallyBijective η₂).mp (J_U.W_adj_unit_app adj_U (P_pre q₂))).2
    let R₁ : CategoryTheory.Sieve E_U := CategoryTheory.Presheaf.imageSieve η₁ s₁
    let R₂ : CategoryTheory.Sieve E_U := CategoryTheory.Presheaf.imageSieve η₂ s₂
    have hR₁ : R₁ ∈ J_U E_U := CategoryTheory.Presheaf.imageSieve_mem J_U η₁ s₁
    have hR₂ : R₂ ∈ J_U E_U := CategoryTheory.Presheaf.imageSieve_mem J_U η₂ s₂
    let R_int : CategoryTheory.Sieve E_U := R₁ ⊓ R₂
    have hR : R_int ∈ J_U E_U := J_U.intersection_covering hR₁ hR₂
    have hTop_U : U.smallEtaleTopology = U.smallEtalePretopology.toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        U (le_refl (@AlgebraicGeometry.Etale))
    have hR_pre : R_int ∈ U.smallEtalePretopology.toGrothendieck E_U :=
      Eq.mp (congrArg (fun K : CategoryTheory.GrothendieckTopology U.Etale => R_int ∈ K E_U)
        hTop_U) hR
    let pt_Ω : ↥S_Ω := default
    obtain ⟨Y, u, y'₀, hu_arr, hu_et, hy'₀⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology E_U R_int).mp
