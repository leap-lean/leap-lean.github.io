            ZMod (ℓ ^ (r + 2))) = h_top z i
        rw [ZMod.val_natCast_of_lt hdiv_lt, Nat.mul_div_cancel' (hh_top_dvd z i),
          ZMod.natCast_zmod_val]
    · intro W s₃ x
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom
      have hs₃_mem : triv_! 0 W s₃ ∈ Set.range (triv_! 0 W) := ⟨s₃, rfl⟩
      rw [((h𝒥_spec 0).2 W).2] at hs₃_mem
      obtain ⟨⟨W₀, hW₀_cov, hW₀_van⟩, _⟩ := hs₃_mem
      by_cases hx : x ∈ W₀
      · obtain ⟨U, u, y_U, hu_et, hy_U, hu_W₀⟩ := hW₀_lift W W₀ x hx
        refine ⟨U, u, y_U, 0, hu_et, hy_U, ?_⟩
        rw [map_zero]
        symm
        apply ((h𝒥_spec 0).2 U).1
        ext z i
        let h_U := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj U).hom
        let u_left := ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left
        have hu_w : u_left ≫ h_W = h_U :=
          ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).w
        let u_V : CategoryTheory.Limits.pullback h_U (ι_r 0) ⟶
            CategoryTheory.Limits.pullback h_W (ι_r 0) :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_U (ι_r 0) ≫ u_left)
            (CategoryTheory.Limits.pullback.snd h_U (ι_r 0))
            (by rw [CategoryTheory.Category.assoc, hu_w,
                  CategoryTheory.Limits.pullback.condition])
        rw [(h𝒥_spec 0).1 u u_V
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            s₃ z,
          map_zero, LocallyConstant.zero_apply, Pi.zero_apply]
        have hz_W₀ : (CategoryTheory.Limits.pullback.fst h_W (ι_r 0)).base
            (u_V.base z) ∈ W₀ := by
          have hfst_mor : u_V ≫ CategoryTheory.Limits.pullback.fst h_W (ι_r 0) =
              CategoryTheory.Limits.pullback.fst h_U (ι_r 0) ≫ u_left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hfst : (u_V ≫ CategoryTheory.Limits.pullback.fst h_W (ι_r 0)).base z =
              u_left.base ((CategoryTheory.Limits.pullback.fst h_U (ι_r 0)).base z) :=
            congrArg (fun k => k.base z) hfst_mor
          change (u_V ≫ CategoryTheory.Limits.pullback.fst h_W (ι_r 0)).base z ∈ W₀
          rw [hfst]
          exact hu_W₀ _
        rw [hW₀_van (u_V.base z) hz_W₀, Pi.zero_apply]
      · have hx_top : x ∈ (((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀) := by
          rw [hW₀_cov]
          trivial
        have hx_U₀ : h_W.base x ∈ (U₀ : Set D₀) := by
          rcases hx_top with hx_in | hx_in
          · exact hx_in
          · exact False.elim (hx hx_in)
        obtain ⟨U, u, y_U, g_top, hu_et, hy_U, hg_top⟩ := hU_lift r W x hx_U₀
        let Y := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj U).left
        let h_Y := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj U).hom
        let g_bot : Y ⟶ V_r 0 := g_top ≫ p_ι_to_zero (r + 1)
        have hg_bot : g_bot ≫ ι_r 0 = h_Y := by
          dsimp only [g_bot]
          rw [CategoryTheory.Category.assoc, hp_ι_to_zero_ι (r + 1), hg_top]
        let δ₁_top : Y ⟶ CategoryTheory.Limits.pullback h_Y (ι_r (r + 1)) :=
          CategoryTheory.Limits.pullback.lift (𝟙 Y) g_top
            (by rw [CategoryTheory.Category.id_comp, hg_top])
        let δ₁_bot : Y ⟶ CategoryTheory.Limits.pullback h_Y (ι_r 0) :=
          CategoryTheory.Limits.pullback.lift (𝟙 Y) g_bot
            (by rw [CategoryTheory.Category.id_comp, hg_bot])
        have hδ_top_bot : δ₁_top ≫ m_ι_to_zero (r + 1) U = δ₁_bot := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd]
        let s₃_U := ((𝒥₀ 0).obj.map (Opposite.op u)) s₃
        let h_bot : LocallyConstant ↥Y (Fin N → ZMod (ℓ ^ 1)) :=
          lcPrecomp δ₁_bot (triv_! 0 U s₃_U)
        let h_top : LocallyConstant ↥Y (Fin N → ZMod (ℓ ^ (r + 2))) :=
          lcPostcomp (fun v i => (((v i).val : ℕ) : ZMod (ℓ ^ (r + 2)))) h_bot
        obtain ⟨s₂, hs₂_diag⟩ := (hDiagEval (r + 1) U g_top hg_top).2 h_top
        refine ⟨U, u, y_U, s₂, hu_et, hy_U, ?_⟩
        apply (hDiagEval 0 U g_bot hg_bot).1
        intro z
        ext i
        let _ : NeZero (ℓ ^ 1) := ⟨pow_ne_zero 1 hℓ_pos.ne'⟩
        have hpt_bot : δ₁_bot.base z = (m_ι_to_zero (r + 1) U).base (δ₁_top.base z) :=
          congrArg (fun k => k.base z) hδ_top_bot.symm
        change triv_! 0 U (((ρ_bock r).hom.app (Opposite.op U)) s₂) (δ₁_bot.base z) i = h_bot z i
        rw [hpt_bot, hρ_bock_spec r U s₂ (δ₁_top.base z) i, hs₂_diag z]
        change ZMod.castHom _ (ZMod (ℓ ^ 1))
            ((((h_bot z i).val : ℕ) : ZMod (ℓ ^ (r + 2)))) = h_bot z i
        rw [map_natCast, ZMod.natCast_zmod_val]
  exact ⟨𝒥₀, τ_𝒥, ι_bock, ρ_bock, ι_ext,
    hZExt, hTors_𝒥, hTors_𝒟,
    fun r => ⟨h0_bock r, hSES_bock r⟩,
    hιτ_bock, hτι_bock, rfl, fun _ => rfl,
    hMono_ext, hCompat_ext, hBij_ext⟩

theorem weil_curve_zero_ext_geom_h0_and_mod_prime_finite (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) (hN : 1 ≤ N)
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (𝒥₀ : ℕ → CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
      AddCommGrpCat.{u})
    (τ_𝒥 : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ r))
    (hZExt : WeilCurveZeroExtSystem.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat 𝒥₀ τ_𝒥) :
    let Y₀ := weilProjectiveSpaceOver F 1
    let pr_Y : Quiver.Hom (weilGeomScheme F Y₀) Y₀.left :=
      CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    ∀ (hCont_pr : (weilEtaleSitePullback pr_Y).IsContinuous
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
      (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
        hCont_pr).IsRightAdjoint),
      Subsingleton
        (((@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
            Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
            hCont_pr hAdj_pr).obj (𝒥₀ 0)).H 0) ∧
      (∀ i : ℕ,
        Finite
          (((@CategoryTheory.Functor.sheafPullback _ _ _ _
              (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
              Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
              hCont_pr hAdj_pr).obj (𝒥₀ 0)).H i)) :=
by
  intro Y₀ pr_Y hCont_pr hAdj_pr
  classical
  
  
  
  have h_s2 : AlgebraicGeometry.IsProper (weilBaseChangeOver F (AlgebraicClosure F) Y₀).hom ∧
      PreirreducibleSpace ↥(weilGeomScheme F Y₀) ∧
      (∃ x_inf : ↥(weilGeomScheme F Y₀), pr_Y.base x_inf ∈ Set.range s_inf.base) := by
    let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))
    let f_ext : S_k ⟶ S_F :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
    let p_snd : weilGeomScheme F Y₀ ⟶ S_k := CategoryTheory.Limits.pullback.snd Y₀.hom f_ext
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) :=
      @IsScalarTower.of_algebraMap_eq' F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) _ _ _ _ _ _ rfl
    let _ : AlgebraicGeometry.IsOpenImmersion j_aff := hj_open
    have hSpecBot : ∀ {K : Type u} [Field K] (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K))),
        pt.asIdeal = ⊥ := by
      intro K _ pt
      by_contra hne
      obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (IsUnit.mk0 x hx0))
    have hSpecSub : ∀ (K : Type u) [Field K],
        Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) :=
      fun K _ => ⟨fun p₁ p₂ => PrimeSpectrum.ext ((hSpecBot p₁).trans (hSpecBot p₂).symm)⟩
    have hFT_𝒜 : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F) :=
      Algebra.FiniteType.of_restrictScalars_finiteType F ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) F)
    have hProp_proj : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
    have hBij_deg0 : Function.Bijective (algebraMap F ↥(𝒜 0)) := by
      refine ⟨fun a b hab => MvPolynomial.C_injective _ _ (congrArg Subtype.val hab), ?_⟩
      rintro ⟨p, hp⟩
      rw [MvPolynomial.mem_homogeneousSubmodule] at hp
      refine ⟨p.coeff 0, Subtype.ext ?_⟩
      change MvPolynomial.C (p.coeff 0) = p
      ext d
      by_cases hd : d = 0
      · subst hd
        simp [MvPolynomial.coeff_C]
      · have hC : (MvPolynomial.C (p.coeff 0)).coeff d = 0 := by
          rw [MvPolynomial.coeff_C]
          exact ite_eq_right_iff.mpr fun h0 => absurd h0.symm hd
        rw [hC]
        symm
        by_contra hne
        have hdeg : Finsupp.degree d = 0 :=
          (DFunLike.congr_fun Finsupp.degree_eq_weight_one d).trans (hp hne)
        exact hd ((Finsupp.degree_eq_zero_iff d).mp hdeg)
    let e_deg0 : F ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap F ↥(𝒜 0)) hBij_deg0
    let iso_deg0 : CommRingCat.of F ≅ CommRingCat.of ↥(𝒜 0) :=
      { hom := CommRingCat.ofHom (algebraMap F ↥(𝒜 0))
        inv := CommRingCat.ofHom e_deg0.symm.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext e_deg0.symm_apply_apply)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext e_deg0.apply_symm_apply) }
    have : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap F ↥(𝒜 0))) :=
      ⟨⟨iso_deg0.inv, iso_deg0.hom_inv_id, iso_deg0.inv_hom_id⟩⟩
    have : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥(𝒜 0)))) :=
      inferInstance
    have hProp_Y₀ : AlgebraicGeometry.IsProper Y₀.hom :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsProper)
        (AlgebraicGeometry.Proj.toSpecZero 𝒜)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥(𝒜 0))))
        hProp_proj inferInstance
    have hpb_base : CategoryTheory.IsPullback pr_Y p_snd Y₀.hom f_ext :=
      CategoryTheory.IsPullback.of_hasPullback Y₀.hom f_ext
    have hProp_bc : AlgebraicGeometry.IsProper (weilBaseChangeOver F (AlgebraicClosure F) Y₀).hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_base hProp_Y₀
    let s_bar_inf : S_k ⟶ weilGeomScheme F Y₀ :=
      CategoryTheory.Limits.pullback.lift (f_ext ≫ s_inf) (𝟙 S_k)
        (by rw [Category.assoc, hsinf_sec, Category.comp_id, Category.id_comp])
    have hs_bar_fst : s_bar_inf ≫ pr_Y = f_ext ≫ s_inf :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hs_bar_snd : s_bar_inf ≫ p_snd = 𝟙 S_k :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let pt_k : ↥S_k := ⟨⊥, Ideal.isPrime_bot⟩
    let x_inf : ↥(weilGeomScheme F Y₀) := s_bar_inf.base pt_k
    have hx_inf_mem : pr_Y.base x_inf ∈ Set.range s_inf.base := by
      refine ⟨f_ext.base pt_k, ?_⟩
      calc s_inf.base (f_ext.base pt_k)
          = (f_ext ≫ s_inf).base pt_k := rfl
        _ = (s_bar_inf ≫ pr_Y).base pt_k := by rw [hs_bar_fst]
        _ = pr_Y.base x_inf := rfl
    have hpb_inf : CategoryTheory.IsPullback s_bar_inf f_ext pr_Y s_inf := by
      have hrect : CategoryTheory.IsPullback
          (s_bar_inf ≫ p_snd) f_ext f_ext (s_inf ≫ (Y₀.hom : Y₀.left ⟶ S_F)) := by
        rw [hs_bar_snd, hsinf_sec]
        exact CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.comp_id]⟩
      exact CategoryTheory.IsPullback.of_right hrect hs_bar_fst hpb_base.flip
    have hCompl_eq : ∀ z : ↥(weilGeomScheme F Y₀),
        pr_Y.base z ∉ Set.range j_aff.base → z = x_inf := by
      intro z hz
      have hz_sinf : pr_Y.base z ∈ Set.range s_inf.base := by
        rw [← hsinf_compl]
        exact hz
      rcases hz_sinf with ⟨pt_F, hpt_F⟩
      have hpt_eq : f_ext.base pt_k = pt_F := @Subsingleton.elim _ (hSpecSub F) _ _
      have hfib : pr_Y.base z = s_inf.base (f_ext.base pt_k) := by
        rw [hpt_eq, hpt_F]
      obtain ⟨w, hw_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z (f_ext.base pt_k) hfib
      let iso_inf := hpb_inf.isoPullback
      have hiso_fst : iso_inf.inv ≫ s_bar_inf = CategoryTheory.Limits.pullback.fst pr_Y s_inf := by
        rw [← CategoryTheory.IsPullback.isoPullback_hom_fst hpb_inf, ← Category.assoc,
          iso_inf.inv_hom_id, Category.id_comp]
      have hqk : iso_inf.inv.base w = pt_k :=
        @Subsingleton.elim _ (hSpecSub (AlgebraicClosure F)) _ _
      calc z = (CategoryTheory.Limits.pullback.fst pr_Y s_inf).base w := hw_fst.symm
        _ = (iso_inf.inv ≫ s_bar_inf).base w := by rw [hiso_fst]
        _ = s_bar_inf.base (iso_inf.inv.base w) := rfl
        _ = s_bar_inf.base pt_k := by rw [hqk]
        _ = x_inf := rfl
    let P_aff := CategoryTheory.Limits.pullback pr_Y j_aff
    let j_bar : P_aff ⟶ weilGeomScheme F Y₀ := CategoryTheory.Limits.pullback.fst pr_Y j_aff
    let q_aff : P_aff ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
      CategoryTheory.Limits.pullback.snd pr_Y j_aff
    have hj_hom' : j_aff ≫ Y₀.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (Polynomial F))) :=
      hj_hom
    have hpb_aff : CategoryTheory.IsPullback q_aff (j_bar ≫ p_snd)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (Polynomial F)))) f_ext := by
      rw [← hj_hom']
      exact ((CategoryTheory.IsPullback.of_hasPullback pr_Y j_aff).paste_horiz hpb_base.flip).flip
    let iso_aff_spec : P_aff ≅
        AlgebraicGeometry.Spec (CommRingCat.of
          (TensorProduct F (Polynomial F) (AlgebraicClosure F))) :=
      hpb_aff.isoPullback ≪≫
        AlgebraicGeometry.pullbackSpecIso F (Polynomial F) (AlgebraicClosure F)
    let e_poly : TensorProduct F (Polynomial F) (AlgebraicClosure F) ≃+*
        Polynomial (AlgebraicClosure F) :=
      (Algebra.TensorProduct.comm F (Polynomial F) (AlgebraicClosure F)).toRingEquiv.trans
        ((Algebra.TensorProduct.congr
            (AlgEquiv.refl : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)
            (MvPolynomial.uniqueAlgEquiv F PUnit.{1}).symm).toRingEquiv.trans
          ((MvPolynomial.scalarRTensorAlgEquiv
              (R := F) (N := AlgebraicClosure F) (σ := PUnit.{1})).toRingEquiv.trans
            (MvPolynomial.uniqueAlgEquiv (AlgebraicClosure F) PUnit.{1}).toRingEquiv))
    have : IsDomain (TensorProduct F (Polynomial F) (AlgebraicClosure F)) :=
      e_poly.toMulEquiv.isDomain (Polynomial (AlgebraicClosure F))
    have hIrred_spec : IrreducibleSpace
        ↥(AlgebraicGeometry.Spec (CommRingCat.of
          (TensorProduct F (Polynomial F) (AlgebraicClosure F)))) :=
      PrimeSpectrum.irreducibleSpace
    have hIrred_Paff : IrreducibleSpace ↥P_aff :=
      (AlgebraicGeometry.Scheme.homeoOfIso iso_aff_spec.symm).surjective.irreducibleSpace
        (AlgebraicGeometry.Scheme.homeoOfIso iso_aff_spec.symm).continuous
    let U_aff_bar : Set ↥(weilGeomScheme F Y₀) := pr_Y.base ⁻¹' (Set.range j_aff.base)
    have hRange_jbar : Set.range j_bar.base = U_aff_bar := by
      ext z
      constructor
      · rintro ⟨w, rfl⟩
        change (j_bar ≫ pr_Y).base w ∈ Set.range j_aff.base
        rw [CategoryTheory.Limits.pullback.condition]
        exact ⟨q_aff.base w, rfl⟩
      · rintro ⟨p, hp⟩
        obtain ⟨w, hw, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z p hp.symm
        exact ⟨w, hw⟩
    have hIrred_Ubar : IsIrreducible U_aff_bar := by
      rw [← hRange_jbar, ← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ ↥P_aff).image
        j_bar.base j_bar.continuous.continuousOn
    have h_bot_prime : (⊥ : HomogeneousIdeal 𝒜).toIdeal.IsPrime := by
      change (⊥ : Ideal (MvPolynomial (Fin (1 + 1)) F)).IsPrime
      exact Ideal.isPrime_bot
    have h_not_irr : ¬ HomogeneousIdeal.irrelevant 𝒜 ≤ ⊥ := by
      intro hle
      have hX : MvPolynomial.X (0 : Fin (1 + 1)) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
        have hhom : MvPolynomial.IsHomogeneous
            (MvPolynomial.X (0 : Fin (1 + 1)) : MvPolynomial (Fin (1 + 1)) F) 1 :=
          MvPolynomial.isHomogeneous_X F 0
        rw [DirectSum.decompose_of_mem_ne 𝒜
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr hhom) (by omega)]
      exact MvPolynomial.X_ne_zero 0 (Ideal.mem_bot.mp (hle hX))
    let η₀ : ↥Y₀.left := (⟨⊥, h_bot_prime, h_not_irr⟩ : ProjectiveSpectrum 𝒜)
    have hη₀_mem_open : ∀ (O : Set (ProjectiveSpectrum 𝒜)), IsOpen O → O.Nonempty →
