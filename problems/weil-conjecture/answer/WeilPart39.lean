  let C₀ := (CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A_η
  let C₁ := (CategoryTheory.constantSheaf V₁.smallEtaleTopology AddCommGrpCat.{u}).obj A_η

  let B_π₀ : CategoryTheory.Functor U₀.Etale V₀.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback P_Et ⊤ π₀
  let B_π₁ : CategoryTheory.Functor U₀.Etale V₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback P_Et ⊤ π₁

  have hCont₀ : B_π₀.IsContinuous U₀.smallEtaleTopology V₀.smallEtaleTopology := by
    have : CategoryTheory.Limits.HasTerminal U₀.Etale := (hTermOf U₀).hasTerminal
    have : CategoryTheory.Limits.HasPullbacks U₀.Etale := inferInstance
    have : CategoryTheory.Limits.HasFiniteLimits U₀.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits B_π₀ :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_Et π₀
    have : CategoryTheory.RepresentablyFlat B_π₀ :=
      CategoryTheory.flat_of_preservesFiniteLimits B_π₀
    have hCompat_B₀ : CategoryTheory.CompatiblePreserving V₀.smallEtaleTopology B_π₀ :=
      CategoryTheory.compatiblePreservingOfFlat V₀.smallEtaleTopology B_π₀
    have hCov_B₀ : CategoryTheory.CoverPreserving U₀.smallEtaleTopology V₀.smallEtaleTopology
        B_π₀ := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro U R hR
      apply (hMem V₀ (B_π₀.obj U) (R.functorPushforward B_π₀)).mpr
      intro z
      let u_hom : U.left ⟶ U₀ := U.hom
      let fstU : (B_π₀.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst u_hom π₀
      obtain ⟨Y, f, y, hfR, _, hy⟩ := (hMem U₀ U R).mp hR (fstU.base z)
      let y_hom : Y.left ⟶ U₀ := Y.hom
      let fstY : (B_π₀.obj Y).left ⟶ Y.left := CategoryTheory.Limits.pullback.fst y_hom π₀
      let f_left : Y.left ⟶ U.left := f.left
      let Bf_left : (B_π₀.obj Y).left ⟶ (B_π₀.obj U).left := (B_π₀.map f).left
      have hBf_mem : (R.functorPushforward B_π₀).arrows (B_π₀.map f) :=
        CategoryTheory.Sieve.image_mem_functorPushforward B_π₀ R hfR
      have hBf_et : P_Et Bf_left := hMorEtale (B_π₀.map f)
      have hRight : CategoryTheory.IsPullback (B_π₀.obj U).hom fstU π₀ u_hom :=
        (CategoryTheory.IsPullback.of_hasPullback u_hom π₀).flip
      have hOuter :
          CategoryTheory.IsPullback (Bf_left ≫ (B_π₀.obj U).hom) fstY π₀ (f_left ≫ u_hom) := by
        have hw1 : Bf_left ≫ (B_π₀.obj U).hom = (B_π₀.obj Y).hom :=
          CategoryTheory.MorphismProperty.Over.w (B_π₀.map f)
        have hw2 : f_left ≫ u_hom = y_hom :=
          CategoryTheory.MorphismProperty.Over.w f
        rw [hw1, hw2]
        exact (CategoryTheory.IsPullback.of_hasPullback y_hom π₀).flip
      have hCommSq : Bf_left ≫ fstU = fstY ≫ f_left := by
        change ((CategoryTheory.MorphismProperty.Over.pullback P_Et ⊤ π₀).map f).left ≫ fstU = _
        erw [CategoryTheory.MorphismProperty.Over.pullback_map_left]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hLeft : CategoryTheory.IsPullback Bf_left fstY fstU f_left :=
        CategoryTheory.IsPullback.of_right hOuter hCommSq hRight
      obtain ⟨w₀, hw₀_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B_π₀.obj Y, B_π₀.map f, hLeft.isoPullback.inv.base w₀, hBf_mem, hBf_et, ?_⟩
      exact (congrArg (fun k : _ ⟶ (B_π₀.obj U).left => k.base w₀)
