    obtain ⟨b, s, hb_not, hs_not, hbs_eq⟩ :=
      (h_pillar3 E f_E hfE_et q_E hqE_f).2.2 ψ_E hψE_et hqE_ψ

    obtain ⟨j₀_st, e_E, he_α, he_ε⟩ :=
      hUnivStage E α_E ε_E hαE_et hεE_base (hKer_E ε_E hεE_comp)
