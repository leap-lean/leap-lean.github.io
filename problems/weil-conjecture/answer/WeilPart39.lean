        triv_R r W (α_fun W s) y_raw = α_lat r (triv r W s ((m_j_can r W).base y_raw)) :=
      fun W s => Classical.choose_spec (hPointwise_α W s)
    let α_app : ∀ W_op : (U₀.toScheme.Etale)ᵒᵖ,
        (𝒱₀ r).obj.obj W_op ⟶ (ℛ r).obj.obj W_op :=
      fun W_op =>
        let W := Opposite.unop W_op
        have hInj_R : Function.Injective (triv_R r W) := ((hTriv_R_spec r).2 W).1
        AddCommGrpCat.ofHom
          { toFun := α_fun W
            map_zero' := by
              apply hInj_R
              ext y_raw
              rw [hα_spec W 0 y_raw, map_zero, map_zero, LocallyConstant.zero_apply,
                LocallyConstant.zero_apply, map_zero]
            map_add' := fun a b => by
              apply hInj_R
              ext y_raw
              rw [hα_spec W (a + b) y_raw, map_add, map_add, LocallyConstant.add_apply,
                LocallyConstant.add_apply, map_add, hα_spec W a y_raw, hα_spec W b y_raw] }
    have hα_nat : ∀ ⦃X Y : (U₀.toScheme.Etale)ᵒᵖ⦄ (f : X ⟶ Y),
        (𝒱₀ r).obj.map f ≫ α_app Y = α_app X ≫ (ℛ r).obj.map f := by
      intro X Y f
      let W₂_et := Opposite.unop X
      let W₁_et := Opposite.unop Y
