  have : Algebra.IsAlgebraic F K_pt := Algebra.IsAlgebraic.of_finite F K_pt
  let e_alg : k ≃ₐ[F] Ω_pt := IsAlgClosure.equiv F k Ω_pt
  let g_kΩ : S_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom)
  have hy_D₀_comm : (y_pt ≫ U₀.ι) ≫ D₀.hom = g_kΩ ≫ g_k := by
    let f_ev := CommRingCat.ofHom ((algebraMap K_pt Ω_pt).comp ev_pt.toRingHom)
    let f_loc := CommRingCat.ofHom (algebraMap (Polynomial F) R₀)
    let f_C := CommRingCat.ofHom (Polynomial.C : F →+* Polynomial F)
    have h1 : y_pt ≫ U₀.ι =
        AlgebraicGeometry.Spec.map f_ev ≫ (AlgebraicGeometry.Spec.map f_loc ≫ j_aff) :=
      (CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map f_ev) e_U.hom U₀.ι).trans
        (congrArg (AlgebraicGeometry.Spec.map f_ev ≫ ·) heU_eq)
    have h2 : (y_pt ≫ U₀.ι) ≫ D₀.hom =
        AlgebraicGeometry.Spec.map f_ev ≫
          (AlgebraicGeometry.Spec.map f_loc ≫ AlgebraicGeometry.Spec.map f_C) :=
      (congrArg (· ≫ D₀.hom) h1).trans
        ((CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map f_ev)
            (AlgebraicGeometry.Spec.map f_loc ≫ j_aff) D₀.hom).trans
          (congrArg (AlgebraicGeometry.Spec.map f_ev ≫ ·)
            ((CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map f_loc) j_aff D₀.hom).trans
              (congrArg (AlgebraicGeometry.Spec.map f_loc ≫ ·) hj_hom))))
    have h3 : AlgebraicGeometry.Spec.map f_ev ≫
        (AlgebraicGeometry.Spec.map f_loc ≫ AlgebraicGeometry.Spec.map f_C) =
        AlgebraicGeometry.Spec.map ((f_C ≫ f_loc) ≫ f_ev) :=
      (congrArg (AlgebraicGeometry.Spec.map f_ev ≫ ·)
          (AlgebraicGeometry.Spec.map_comp f_C f_loc).symm).trans
        (AlgebraicGeometry.Spec.map_comp (f_C ≫ f_loc) f_ev).symm
    have h4 : (f_C ≫ f_loc) ≫ f_ev =
        CommRingCat.ofHom (algebraMap F k) ≫ CommRingCat.ofHom e_alg.toRingHom := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change algebraMap K_pt Ω_pt
          (ev_pt (algebraMap (Polynomial F) R₀ (Polynomial.C c))) =
        e_alg (algebraMap F k c)
      have hc_R₀ : algebraMap (Polynomial F) R₀ (Polynomial.C c) = algebraMap F R₀ c :=
        (IsScalarTower.algebraMap_apply F (Polynomial F) R₀ c).symm
      rw [hc_R₀, ev_pt.commutes, ← IsScalarTower.algebraMap_apply F K_pt Ω_pt, e_alg.commutes]
    have h5 : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap F k) ≫ CommRingCat.ofHom e_alg.toRingHom) =
        g_kΩ ≫ g_k :=
      AlgebraicGeometry.Spec.map_comp
        (CommRingCat.ofHom (algebraMap F k)) (CommRingCat.ofHom e_alg.toRingHom)
    exact h2.trans (h3.trans ((congrArg AlgebraicGeometry.Spec.map h4).trans h5))

  let y_bar : S_Ω ⟶ D_bar.left :=
    CategoryTheory.Limits.pullback.lift (y_pt ≫ U₀.ι) g_kΩ hy_D₀_comm
  have hy_bar_fst : y_bar ≫ pr_D = y_pt ≫ U₀.ι :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hy_bar_snd : y_bar ≫ D_bar.hom = g_kΩ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hh_bar_cond : (h_fib ≫ X₀_ι) ≫ Z_tilde.hom = (π_fib ≫ g_kΩ) ≫ g_k := by
    rw [← f₀.w, ← CategoryTheory.Category.assoc, hPb_outer.w, CategoryTheory.Category.assoc,
      hy_D₀_comm, CategoryTheory.Category.assoc]
  let h_fib_bar : S_fib ⟶ Z_bar.left :=
    CategoryTheory.Limits.pullback.lift (h_fib ≫ X₀_ι) (π_fib ≫ g_kΩ) hh_bar_cond
  have hh_fib_bar_fst : h_fib_bar ≫ pr_Z = h_fib ≫ X₀_ι :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hh_fib_bar_snd : h_fib_bar ≫ Z_bar.hom = π_fib ≫ g_kΩ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have h_comm_fib_bar : h_fib_bar ≫ f_bar.left = π_fib ≫ y_bar := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc h_fib_bar f_bar.left pr_D).trans
        ((congrArg (h_fib_bar ≫ ·) hf_bar_fst).trans
          ((CategoryTheory.Category.assoc h_fib_bar pr_Z f₀.left).symm.trans
            ((congrArg (· ≫ f₀.left) hh_fib_bar_fst).trans
              (hPb_outer.w.trans
                ((congrArg (π_fib ≫ ·) hy_bar_fst.symm).trans
                  (CategoryTheory.Category.assoc π_fib y_bar pr_D).symm)))))
    · exact (CategoryTheory.Category.assoc h_fib_bar f_bar.left D_bar.hom).trans
        ((congrArg (h_fib_bar ≫ ·) hf_bar_snd).trans
          (hh_fib_bar_snd.trans
            ((congrArg (π_fib ≫ ·) hy_bar_snd.symm).trans
              (CategoryTheory.Category.assoc π_fib y_bar D_bar.hom).symm)))
  have hPb_outer_bar : CategoryTheory.IsPullback
      (h_fib_bar ≫ pr_Z) π_fib f₀.left (y_bar ≫ pr_D) := by
    rw [hh_fib_bar_fst, hy_bar_fst]
    exact hPb_outer
  have hPb_fib_bar : CategoryTheory.IsPullback h_fib_bar π_fib f_bar.left y_bar :=
    CategoryTheory.IsPullback.of_right hPb_outer_bar h_comm_fib_bar hPb_fbar

  
  have hConstPullIsoAndNat :
      ∀ {X S S' X' : AlgebraicGeometry.Scheme.{u}}
        (f : Quiver.Hom X S) (g : Quiver.Hom S' S) (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
        (h_sq : CategoryTheory.CategoryStruct.comp g' f = CategoryTheory.CategoryStruct.comp f' g)
        (q : ℕ),
        let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous
          AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
        let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous
          AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
        let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
        let C_X' := CategoryTheory.constantSheaf X'.smallEtaleTopology AddCommGrpCat.{u}
        (∀ (A : AddCommGrpCat.{u}) {β},
          WeilIsSingDevAlgBCBCPush f g f' g' h_sq (C_X.obj A) q β →
          CategoryTheory.IsIso ((adj_g.homEquiv _ _).symm β) →
          CategoryTheory.IsIso
            ((adj_g.homEquiv _ _).symm
              (β ≫ pf_g.map (weilEtaleHigherDirectImageMap f' q
                (weilEtaleConstPullbackHom g'
                  (weilEtaleIdTerminalIsTerminal.{u} X')
                  (weilEtaleIdTerminalIsTerminal.{u} X) A))))) ∧
        (∀ {A₁ A₂ : AddCommGrpCat.{u}} (φ : A₁ ⟶ A₂) {γ₁ γ₂},
          WeilIsSingDevAlgBCConstPush f g f' g' h_sq A₁ q γ₁ →
          WeilIsSingDevAlgBCConstPush f g f' g' h_sq A₂ q γ₂ →
          weilEtaleHigherDirectImageMap f q (C_X.map φ) ≫ γ₂ =
            γ₁ ≫ pf_g.map (weilEtaleHigherDirectImageMap f' q (C_X'.map φ))) := by
    intro X S S' X' f g f' g' h_sq q pf_g adj_g C_X C_X'
    refine ⟨?_, ?_⟩
    · intro A β _hβ hIso_β
      let cA := weilEtaleConstPullbackHom g'
        (weilEtaleIdTerminalIsTerminal.{u} X') (weilEtaleIdTerminalIsTerminal.{u} X) A
      have : CategoryTheory.IsIso cA := (hSys g').hConstIso _ _ A
      let e_c := CategoryTheory.asIso cA
      let e_R : weilEtaleHigherDirectImage f' q _ ≅ weilEtaleHigherDirectImage f' q _ :=
        { hom := weilEtaleHigherDirectImageMap f' q e_c.hom
          inv := weilEtaleHigherDirectImageMap f' q e_c.inv
          hom_inv_id := ((hDirFunctorial f' q).2.1 e_c.hom e_c.inv).symm.trans
            ((congrArg (weilEtaleHigherDirectImageMap f' q) e_c.hom_inv_id).trans
              ((hDirFunctorial f' q).1 _))
          inv_hom_id := ((hDirFunctorial f' q).2.1 e_c.inv e_c.hom).symm.trans
            ((congrArg (weilEtaleHigherDirectImageMap f' q) e_c.inv_hom_id).trans
              ((hDirFunctorial f' q).1 _)) }
      have hEq : (adj_g.homEquiv _ _).symm (β ≫ pf_g.map e_R.hom) =
          (adj_g.homEquiv _ _).symm β ≫ e_R.hom := by
        apply (adj_g.homEquiv _ _).injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
          Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      change CategoryTheory.IsIso ((adj_g.homEquiv _ _).symm (β ≫ pf_g.map e_R.hom))
      rw [hEq]
      have : CategoryTheory.IsIso e_R.hom := e_R.isIso_hom
      exact CategoryTheory.IsIso.comp_isIso
    · intro A₁ A₂ φ γ₁ γ₂ hγ₁ hγ₂
      rcases hγ₁ with ⟨β₁, hβ₁, rfl⟩
      rcases hγ₂ with ⟨β₂, hβ₂, rfl⟩
      let pb_g' := (weilEtaleSitePullback g').sheafPullback
        AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
      let c₁ := weilEtaleConstPullbackHom g'
        (weilEtaleIdTerminalIsTerminal.{u} X') (weilEtaleIdTerminalIsTerminal.{u} X) A₁
      let c₂ := weilEtaleConstPullbackHom g'
        (weilEtaleIdTerminalIsTerminal.{u} X') (weilEtaleIdTerminalIsTerminal.{u} X) A₂
      let m_L1 := weilEtaleHigherDirectImageMap f' q (pb_g'.map (C_X.map φ))
      let m_L2 := weilEtaleHigherDirectImageMap f' q c₂
      let m_R1 := weilEtaleHigherDirectImageMap f' q c₁
      let m_R2 := weilEtaleHigherDirectImageMap f' q (C_X'.map φ)
      have h_inner : m_L1 ≫ m_L2 = m_R1 ≫ m_R2 :=
        (((hDirFunctorial f' q).2.1 _ _).symm.trans
          (congrArg (weilEtaleHigherDirectImageMap f' q) ((hConstPkg g').2.2 _ _ φ))).trans
          ((hDirFunctorial f' q).2.1 _ _)
      have h_pf : pf_g.map m_L1 ≫ pf_g.map m_L2 = pf_g.map m_R1 ≫ pf_g.map m_R2 :=
        (pf_g.map_comp m_L1 m_L2).symm.trans
          ((congrArg pf_g.map h_inner).trans (pf_g.map_comp m_R1 m_R2))
      have hβ_nat := (hBCPushCalculus f g f' g' h_sq).2.1 (C_X.map φ) q hβ₁ hβ₂
      calc
        weilEtaleHigherDirectImageMap f q (C_X.map φ) ≫ (β₂ ≫ pf_g.map m_L2)
          = (weilEtaleHigherDirectImageMap f q (C_X.map φ) ≫ β₂) ≫ pf_g.map m_L2 :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = (β₁ ≫ pf_g.map m_L1) ≫ pf_g.map m_L2 := congrArg (· ≫ pf_g.map m_L2) hβ_nat
        _ = β₁ ≫ (pf_g.map m_L1 ≫ pf_g.map m_L2) := CategoryTheory.Category.assoc _ _ _
        _ = β₁ ≫ (pf_g.map m_R1 ≫ pf_g.map m_R2) := congrArg (β₁ ≫ ·) h_pf
        _ = (β₁ ≫ pf_g.map m_R1) ≫ pf_g.map m_R2 :=
              (CategoryTheory.Category.assoc _ _ _).symm

  have hPasteMateFactor :
      ∀ {X S S' X' S'' X'' : AlgebraicGeometry.Scheme.{u}}
        (f : Quiver.Hom X S) (g : Quiver.Hom S' S) (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
        (h : Quiver.Hom S'' S') (f'' : Quiver.Hom X'' S'') (g'' : Quiver.Hom X'' X')
        (g₁₂ : Quiver.Hom S'' S) (g'₁₂ : Quiver.Hom X'' X)
        (h_sq₁ : CategoryTheory.CategoryStruct.comp g' f = CategoryTheory.CategoryStruct.comp f' g)
        (h_sq₂ : CategoryTheory.CategoryStruct.comp g'' f' = CategoryTheory.CategoryStruct.comp f'' h)
        (hg : CategoryTheory.CategoryStruct.comp h g = g₁₂)
        (hg' : CategoryTheory.CategoryStruct.comp g'' g' = g'₁₂)
        (h_sq₁₂ : CategoryTheory.CategoryStruct.comp g'₁₂ f = CategoryTheory.CategoryStruct.comp f'' g₁₂)
        (A : AddCommGrpCat.{u}) (q : ℕ)
        {γ₁ γ₂ γ₁₂},
        WeilIsSingDevAlgBCConstPush f g f' g' h_sq₁ A q γ₁ →
        WeilIsSingDevAlgBCConstPush f' h f'' g'' h_sq₂ A q γ₂ →
        WeilIsSingDevAlgBCConstPush f g₁₂ f'' g'₁₂ h_sq₁₂ A q γ₁₂ →
        let pb_g := (weilEtaleSitePullback g).sheafPullback
          AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
        let pb_h := (weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} S'.smallEtaleTopology S''.smallEtaleTopology
        let pb_g₁₂ := (weilEtaleSitePullback g₁₂).sheafPullback
          AddCommGrpCat.{u} S.smallEtaleTopology S''.smallEtaleTopology
        let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous
          AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
        let adj_h := (weilEtaleSitePullback h).sheafAdjunctionContinuous
