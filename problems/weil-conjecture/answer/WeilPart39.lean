          refine isOpen_iUnion fun w => ?_
          have : AlgebraicGeometry.Etale (f_w w).left := het_w w
          exact ((f_w w).left).isOpenMap _ (((x (f_w w) (hf_w w)).hom m).isLocallyConstant s)
        let t_hom : M ⟶ ℒ_pre.obj (Opposite.op W) :=
          AddCommGrpCat.ofHom
            { toFun := fun m => ⟨g_fun m, hg_lc m⟩
              map_zero' := LocallyConstant.ext fun w => by
                change ((x (f_w w) (hf_w w)).hom 0) (y_w w) = 0
                rw [map_zero]; rfl
              map_add' := fun m₁ m₂ => LocallyConstant.ext fun w => by
                change ((x (f_w w) (hf_w w)).hom (m₁ + m₂)) (y_w w) = _
                rw [map_add]; rfl }
        refine ⟨t_hom, ?_, ?_⟩
        · intro Y f hf
          apply AddCommGrpCat.ext; intro m; apply LocallyConstant.ext; intro y
