import WeilPart38
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_commAlg_etale_domain_galois_closure_spread (R₀ K : Type u)
    [CommRing R₀] [IsDomain R₀] [Field K] [Algebra R₀ K] [IsFractionRing R₀ K]
    (hSpread : ∀ (L : IntermediateField K (AlgebraicClosure K))
      [FiniteDimensional K ↥L] [IsGalois K ↥L],
      ∃ δ_L : R₀, δ_L ≠ 0 ∧
        ∀ (g : R₀), g ≠ 0 → δ_L ∣ g →
          ∀ (φ_g : Localization.Away g →+* K),
            φ_g.comp (algebraMap R₀ (Localization.Away g)) = algebraMap R₀ K →
            letI : Algebra (Localization.Away g) ↥L :=
              ((algebraMap K ↥L).comp φ_g).toAlgebra
            Module.Finite (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L) ∧
            Algebra.Etale (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L))
    (f₁ : R₀) (hf₁_ne : f₁ ≠ 0)
    (C₁ : Type u) [CommRing C₁] [IsDomain C₁] [Algebra (Localization.Away f₁) C₁]
    [Module.Finite (Localization.Away f₁) C₁]
    [Algebra.IsIntegral (Localization.Away f₁) C₁]
    [Algebra.Etale (Localization.Away f₁) C₁]
    (hSurj_C₁ : Function.Surjective (PrimeSpectrum.comap (algebraMap (Localization.Away f₁) C₁))) :
    ∃ (g₀ : R₀) (_ : g₀ ≠ 0)
      (L₀ : IntermediateField K (AlgebraicClosure K))
      (_ : FiniteDimensional K ↥L₀) (_ : IsGalois K ↥L₀)
      (φ_g₀ : Localization.Away g₀ →+* K),
      φ_g₀.comp (algebraMap R₀ (Localization.Away g₀)) = algebraMap R₀ K ∧
      let R' := Localization.Away g₀
      letI : Algebra R' K := φ_g₀.toAlgebra
      letI : Algebra R' ↥L₀ := ((algebraMap K ↥L₀).comp φ_g₀).toAlgebra
      let C_gal := ↥(integralClosure R' ↥L₀)
      letI : Algebra R₀ C_gal := ((algebraMap R' C_gal).comp (algebraMap R₀ R')).toAlgebra
      letI : Algebra R₀ C₁ :=
        RingHom.toAlgebra ((algebraMap (Localization.Away f₁) C₁).comp
          (algebraMap R₀ (Localization.Away f₁)))
      IsDomain R' ∧
      IsFractionRing R' K ∧
      Module.Finite R' C_gal ∧
      Algebra.Etale R' C_gal ∧
      Algebra.Etale R₀ C_gal ∧
      IsFractionRing C_gal ↥L₀ ∧
      Nonempty (C₁ →ₐ[R₀] C_gal) :=
by
  let R₁ := Localization.Away f₁
  have hf₁_nzd : Submonoid.powers f₁ ≤ nonZeroDivisors R₀ :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hf₁_ne)
  have : IsDomain R₁ := IsLocalization.isDomain_localization hf₁_nzd
  have hf₁_K_ne : algebraMap R₀ K f₁ ≠ 0 :=
    fun h => hf₁_ne ((IsFractionRing.injective R₀ K) (h.trans (map_zero _).symm))
  have hUnit_f₁ : IsUnit (algebraMap R₀ K f₁) := IsUnit.mk0 _ hf₁_K_ne
  let φ₁ : R₁ →+* K := IsLocalization.Away.lift f₁ hUnit_f₁
  let _ : Algebra R₁ K := φ₁.toAlgebra
  have : IsScalarTower R₀ R₁ K :=
    IsScalarTower.of_algebraMap_eq (fun r₀ => (IsLocalization.Away.lift_eq f₁ hUnit_f₁ r₀).symm)
  have : IsFractionRing R₁ K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers f₁) R₁ K
  have hInj_R₁_C₁ : Function.Injective (algebraMap R₁ C₁) := by
    have hbot_prime : (⊥ : Ideal R₁).IsPrime :=
      ⟨bot_ne_top, fun {a b} hab => by
        rw [Ideal.mem_bot] at hab ⊢
        exact mul_eq_zero.mp hab⟩
    obtain ⟨P₀, hP₀⟩ := hSurj_C₁ ⟨⊥, hbot_prime⟩
    have hcomap_bot : Ideal.comap (algebraMap R₁ C₁) P₀.asIdeal = ⊥ :=
      congrArg PrimeSpectrum.asIdeal hP₀
    intro x y hxy
    have hsub : algebraMap R₁ C₁ (x - y) ∈ P₀.asIdeal := by
      rw [map_sub, hxy, sub_self]
      exact P₀.asIdeal.zero_mem
    have hmem : x - y ∈ (⊥ : Ideal R₁) := by
      rw [← hcomap_bot]
      exact hsub
    exact sub_eq_zero.mp (Ideal.mem_bot.mp hmem)
  let M₁ := FractionRing C₁
  have hg₁_inj : Function.Injective (algebraMap R₁ M₁) := by
    rw [IsScalarTower.algebraMap_eq R₁ C₁ M₁]
    exact (IsFractionRing.injective C₁ M₁).comp hInj_R₁_C₁
  let ψ_KM : K →+* M₁ := IsFractionRing.lift (K := K) hg₁_inj
  let _ : Algebra K M₁ := ψ_KM.toAlgebra
  have : IsScalarTower R₁ K M₁ := by
    refine ⟨fun r₁ k m => ?_⟩
    have hlift : algebraMap K M₁ (algebraMap R₁ K r₁) = algebraMap R₁ M₁ r₁ :=
      IsFractionRing.lift_algebraMap (K := K) hg₁_inj r₁
    rw [Algebra.smul_def r₁ k, Algebra.smul_def, Algebra.smul_def r₁, Algebra.smul_def k m,
      map_mul, hlift, mul_assoc]
  have : FiniteDimensional K M₁ := by
    obtain ⟨S, hS_fin, hS_span⟩ :=
      Submodule.fg_def.mp (Module.Finite.fg_top : (⊤ : Submodule R₁ C₁).FG)
    let T : Set M₁ := (algebraMap C₁ M₁) '' S
    have hT_fin : T.Finite := hS_fin.image (algebraMap C₁ M₁)
    let V₀ : Submodule K M₁ := Submodule.span K T
    have : FiniteDimensional K ↥V₀ := FiniteDimensional.span_of_finite K hT_fin
    have hC₁_mem : ∀ c : C₁, algebraMap C₁ M₁ c ∈ V₀ := by
      intro c
      have hc : c ∈ Submodule.span R₁ S := by
        rw [hS_span]
        exact Submodule.mem_top
      refine @Submodule.span_induction R₁ C₁ _ _ _ S (fun x _ => algebraMap C₁ M₁ x ∈ V₀)
        ?_ ?_ ?_ ?_ c hc
      · intro x hx
        exact Submodule.subset_span ⟨x, hx, rfl⟩
      · rw [map_zero]
        exact V₀.zero_mem
      · intro x y _ _ ihx ihy
        rw [map_add]
        exact V₀.add_mem ihx ihy
      · intro r₁ x _ ihx
        rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply R₁ C₁ M₁,
          IsScalarTower.algebraMap_apply R₁ K M₁, ← Algebra.smul_def]
        exact V₀.smul_mem (algebraMap R₁ K r₁) ihx
    have hMul_mem : ∀ (c : C₁) {v : M₁}, v ∈ V₀ → algebraMap C₁ M₁ c * v ∈ V₀ := by
      intro c v hv
      refine @Submodule.span_induction K M₁ _ _ _ T (fun u _ => algebraMap C₁ M₁ c * u ∈ V₀)
        ?_ ?_ ?_ ?_ v hv
      · rintro _ ⟨x, _, rfl⟩
        rw [← map_mul]
        exact hC₁_mem (c * x)
      · rw [mul_zero]
        exact V₀.zero_mem
      · intro v₁ v₂ _ _ ih₁ ih₂
        rw [mul_add]
        exact V₀.add_mem ih₁ ih₂
      · intro k u _ ihu
        rw [mul_smul_comm]
        exact V₀.smul_mem k ihu
    have hV₀_top : V₀ = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨⟨n, d⟩, hzd⟩ := IsLocalization.surj (nonZeroDivisors C₁) z
      have hd_ne_C₁ : (d : C₁) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
      have hd_ne : algebraMap C₁ M₁ d ≠ 0 :=
        fun h => hd_ne_C₁ ((IsFractionRing.injective C₁ M₁) (h.trans (map_zero _).symm))
      let L_d : ↥V₀ →ₗ[K] ↥V₀ :=
        { toFun := fun u => ⟨algebraMap C₁ M₁ d * u.1, hMul_mem d u.2⟩
          map_add' := fun u₁ u₂ => Subtype.ext (mul_add _ u₁.1 u₂.1)
          map_smul' := fun k u => Subtype.ext (mul_smul_comm k (algebraMap C₁ M₁ d) u.1) }
      have hLd_inj : Function.Injective L_d := by
        intro u₁ u₂ h_eq
        exact Subtype.ext (mul_left_cancel₀ hd_ne (congrArg Subtype.val h_eq))
      have hLd_surj : Function.Surjective L_d :=
        (LinearMap.injective_iff_surjective (f := L_d)).mp hLd_inj
      obtain ⟨u, hu⟩ := hLd_surj ⟨algebraMap C₁ M₁ n, hC₁_mem n⟩
      have hu_val : algebraMap C₁ M₁ d * u.1 = algebraMap C₁ M₁ n := congrArg Subtype.val hu
      have h_eq_z : u.1 = z := by
        apply mul_right_cancel₀ hd_ne
        rw [mul_comm, hu_val, ← hzd]
      rw [← h_eq_z]
      exact u.2
    exact LinearEquiv.finiteDimensional (LinearEquiv.ofTop V₀ hV₀_top)
  have : Algebra.FormallyUnramified C₁ M₁ :=
    Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors C₁)
  have : Algebra.FormallyUnramified R₁ M₁ :=
    Algebra.FormallyUnramified.comp R₁ C₁ M₁
  have : Algebra.FormallyUnramified K M₁ :=
    Algebra.FormallyUnramified.of_restrictScalars R₁ K M₁
  have : Algebra.IsSeparable K M₁ :=
    Algebra.FormallyUnramified.isSeparable K M₁
  have : Algebra.IsAlgebraic K M₁ := Algebra.IsAlgebraic.of_finite K M₁
  have : Algebra.IsIntegral K M₁ := Algebra.IsIntegral.of_finite K M₁
  let j_M : M₁ →ₐ[K] AlgebraicClosure K := IsAlgClosed.lift
  obtain ⟨θ, hθ_top⟩ := Field.exists_primitive_element K M₁
  let P : Polynomial K := minpoly K θ
  have hθ_int : IsIntegral K θ := Algebra.IsIntegral.isIntegral θ
  have hP_ne : P ≠ 0 := minpoly.ne_zero hθ_int
  have hP_sep : P.Separable := Algebra.IsSeparable.isSeparable K θ
  let L₀ : IntermediateField K (AlgebraicClosure K) :=
    IntermediateField.adjoin K (P.rootSet (AlgebraicClosure K))
  have hP_splits : (Polynomial.map (algebraMap K (AlgebraicClosure K)) P).Splits :=
    IsAlgClosed.splits _
  have : Polynomial.IsSplittingField K ↥L₀ P :=
    IntermediateField.adjoin_rootSet_isSplittingField hP_splits
  have hFD_L₀ : FiniteDimensional K ↥L₀ :=
    Polynomial.IsSplittingField.finiteDimensional ↥L₀ P
  have hGal_L₀ : IsGalois K ↥L₀ :=
    IsGalois.of_separable_splitting_field hP_sep
  have hj_mem : ∀ x : M₁, j_M x ∈ L₀ := by
    have h_aeval : Polynomial.aeval (j_M θ) P = 0 := by
      rw [Polynomial.aeval_algHom_apply j_M θ P, minpoly.aeval K θ, map_zero]
    have hjθ_root : j_M θ ∈ P.rootSet (AlgebraicClosure K) :=
      Polynomial.mem_rootSet.mpr ⟨hP_ne, h_aeval⟩
    have hjθ_L₀ : j_M θ ∈ L₀ :=
      IntermediateField.subset_adjoin K (P.rootSet (AlgebraicClosure K)) hjθ_root
    have hadj_le : IntermediateField.adjoin K ({j_M θ} : Set (AlgebraicClosure K)) ≤ L₀ :=
      (IntermediateField.adjoin_simple_le_iff).mpr hjθ_L₀
    intro x
    have hx_adj : x ∈ IntermediateField.adjoin K ({θ} : Set M₁) := by
      rw [hθ_top]
      exact IntermediateField.mem_top
    have hjx_map : j_M x ∈ IntermediateField.map j_M (IntermediateField.adjoin K ({θ} : Set M₁)) :=
      (IntermediateField.mem_map _).mpr ⟨x, hx_adj, rfl⟩
    rw [IntermediateField.adjoin_map, Set.image_singleton] at hjx_map
    exact hadj_le hjx_map
  let ι_M_L₀ : M₁ →ₐ[K] ↥L₀ := j_M.codRestrict L₀.toSubalgebra hj_mem
  let _ : FiniteDimensional K ↥L₀ := hFD_L₀
  let _ : IsGalois K ↥L₀ := hGal_L₀
  obtain ⟨δ₀, hδ₀_ne, hδ₀_et⟩ := hSpread L₀
  let g₀ : R₀ := f₁ * δ₀
  have hg₀_ne : g₀ ≠ 0 := mul_ne_zero hf₁_ne hδ₀_ne
  let R' := Localization.Away g₀
  have hg₀_K_ne : algebraMap R₀ K g₀ ≠ 0 :=
    fun h => hg₀_ne ((IsFractionRing.injective R₀ K) (h.trans (map_zero _).symm))
  have hUnit_g₀ : IsUnit (algebraMap R₀ K g₀) := IsUnit.mk0 _ hg₀_K_ne
  let φ_g₀ : R' →+* K := IsLocalization.Away.lift g₀ hUnit_g₀
  have hφ_g₀ : φ_g₀.comp (algebraMap R₀ R') = algebraMap R₀ K :=
    RingHom.ext (fun r₀ => IsLocalization.Away.lift_eq g₀ hUnit_g₀ r₀)
  let _ : Algebra R' K := φ_g₀.toAlgebra
  let _ : Algebra R' ↥L₀ := ((algebraMap K ↥L₀).comp φ_g₀).toAlgebra
  let C_gal := ↥(integralClosure R' ↥L₀)
  let _ : Algebra R₀ C_gal := ((algebraMap R' C_gal).comp (algebraMap R₀ R')).toAlgebra
  let _ : Algebra R₀ C₁ :=
    RingHom.toAlgebra ((algebraMap R₁ C₁).comp (algebraMap R₀ R₁))
  have hg₀_nzd : Submonoid.powers g₀ ≤ nonZeroDivisors R₀ :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hg₀_ne)
  have hDom_R' : IsDomain R' := IsLocalization.isDomain_localization hg₀_nzd
  let _ : IsDomain R' := hDom_R'
  have : IsScalarTower R₀ R' K :=
    IsScalarTower.of_algebraMap_eq (fun r₀ => (IsLocalization.Away.lift_eq g₀ hUnit_g₀ r₀).symm)
  have hFrac_R' : IsFractionRing R' K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers g₀) R' K
  let _ : IsFractionRing R' K := hFrac_R'
  obtain ⟨hFin_Cgal, hEt_R'_Cgal⟩ := hδ₀_et g₀ hg₀_ne ⟨f₁, mul_comm f₁ δ₀⟩ φ_g₀ hφ_g₀
  have hEt_R₀_R' : Algebra.Etale R₀ R' := Algebra.Etale.of_isLocalizationAway g₀
  have hEt_R₀_Cgal : Algebra.Etale R₀ C_gal :=
    RingHom.etale_algebraMap.mp
      (RingHom.Etale.stableUnderComposition (algebraMap R₀ R') (algebraMap R' C_gal)
        (RingHom.etale_algebraMap.mpr hEt_R₀_R')
        (RingHom.etale_algebraMap.mpr hEt_R'_Cgal))
  have : IsScalarTower R' K ↥L₀ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hFrac_Cgal : IsFractionRing C_gal ↥L₀ :=
    integralClosure.isFractionRing_of_finite_extension K ↥L₀
  have hUnit_R'_g₀ : IsUnit (algebraMap R₀ R' g₀) :=
    IsLocalization.Away.algebraMap_isUnit g₀
  have hUnit_R'_f₁ : IsUnit (algebraMap R₀ R' f₁) := by
    have hmul : IsUnit (algebraMap R₀ R' f₁ * algebraMap R₀ R' δ₀) := by
      rw [← map_mul]
      exact hUnit_R'_g₀
    exact isUnit_of_mul_isUnit_left hmul
  let ι_R₁_R' : R₁ →+* R' := IsLocalization.Away.lift f₁ hUnit_R'_f₁
  have hφ_comp : φ_g₀.comp ι_R₁_R' = φ₁ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers f₁)
    apply RingHom.ext
    intro r₀
    simp only [RingHom.comp_apply, ι_R₁_R', φ_g₀, φ₁]
    rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
  let ψ₁ : C₁ →+* ↥L₀ := ι_M_L₀.toRingHom.comp (algebraMap C₁ M₁)
  have hψ₁_R₁ : ψ₁.comp (algebraMap R₁ C₁) = (algebraMap R' ↥L₀).comp ι_R₁_R' := by
    apply RingHom.ext
    intro r₁
    change ι_M_L₀ (algebraMap C₁ M₁ (algebraMap R₁ C₁ r₁)) = algebraMap K ↥L₀ (φ_g₀ (ι_R₁_R' r₁))
    have hr₁_M : algebraMap C₁ M₁ (algebraMap R₁ C₁ r₁) = algebraMap K M₁ (φ₁ r₁) := by
      rw [← IsScalarTower.algebraMap_apply R₁ C₁ M₁, IsScalarTower.algebraMap_apply R₁ K M₁]
      rfl
    rw [hr₁_M, ι_M_L₀.commutes, ← RingHom.comp_apply φ_g₀ ι_R₁_R' r₁, hφ_comp]
  have hψ₁_int : ∀ c : C₁, ψ₁ c ∈ integralClosure R' ↥L₀ := by
    intro c
    obtain ⟨Q, hQ_mon, hQ_ev⟩ := Algebra.IsIntegral.isIntegral (R := R₁) c
    refine (mem_integralClosure_iff R' ↥L₀).mpr ⟨Polynomial.map ι_R₁_R' Q, hQ_mon.map ι_R₁_R', ?_⟩
    rw [Polynomial.eval₂_map, ← hψ₁_R₁, ← Polynomial.hom_eval₂, hQ_ev, map_zero]
  let j_C₁ : C₁ →ₐ[R₀] C_gal :=
    { toFun := fun c => ⟨ψ₁ c, hψ₁_int c⟩
      map_one' := Subtype.ext (map_one ψ₁)
      map_mul' := fun x y => Subtype.ext (map_mul ψ₁ x y)
      map_zero' := Subtype.ext (map_zero ψ₁)
      map_add' := fun x y => Subtype.ext (map_add ψ₁ x y)
      commutes' := fun r₀ => Subtype.ext <| by
        change ψ₁ (algebraMap R₁ C₁ (algebraMap R₀ R₁ r₀)) =
          algebraMap R' ↥L₀ (algebraMap R₀ R' r₀)
        have h1 := RingHom.congr_fun hψ₁_R₁ (algebraMap R₀ R₁ r₀)
        simp only [RingHom.comp_apply] at h1
        rw [h1]
        dsimp only [ι_R₁_R']
        rw [IsLocalization.Away.lift_eq] }
  exact ⟨g₀, hg₀_ne, L₀, hFD_L₀, hGal_L₀, φ_g₀, hφ_g₀,
    hDom_R', hFrac_R', hFin_Cgal, hEt_R'_Cgal, hEt_R₀_Cgal, hFrac_Cgal, ⟨j_C₁⟩⟩

theorem weil_commAlg_galois_compositum_and_away_integralClosure (R₀ K : Type u)
    [CommRing R₀] [IsDomain R₀] [Field K] [Algebra R₀ K] [IsFractionRing R₀ K]
    (hSpread : ∀ (L : IntermediateField K (AlgebraicClosure K))
      [FiniteDimensional K ↥L] [IsGalois K ↥L],
      ∃ δ_L : R₀, δ_L ≠ 0 ∧
        ∀ (g : R₀), g ≠ 0 → δ_L ∣ g →
          ∀ (φ_g : Localization.Away g →+* K),
            φ_g.comp (algebraMap R₀ (Localization.Away g)) = algebraMap R₀ K →
            letI : Algebra (Localization.Away g) ↥L :=
              ((algebraMap K ↥L).comp φ_g).toAlgebra
            Module.Finite (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L) ∧
            Algebra.Etale (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L))
    (g₀ : R₀) (hg₀_ne : g₀ ≠ 0)
    (φ_g₀ : Localization.Away g₀ →+* K)
    (hφ_g₀ : φ_g₀.comp (algebraMap R₀ (Localization.Away g₀)) = algebraMap R₀ K)
    (L₀ : IntermediateField K (AlgebraicClosure K))
    [FiniteDimensional K ↥L₀] [IsGalois K ↥L₀] :
    let R' := Localization.Away g₀
    letI : Algebra R' ↥L₀ := ((algebraMap K ↥L₀).comp φ_g₀).toAlgebra
    let C_gal := ↥(integralClosure R' ↥L₀)
    letI : Algebra R₀ C_gal := ((algebraMap R' C_gal).comp (algebraMap R₀ R')).toAlgebra
    (∀ (C : Type u) [CommRing C] [Algebra R₀ C] [Algebra.Etale R₀ C]
        (L₁ : IntermediateField K (AlgebraicClosure K))
        [FiniteDimensional K ↥L₁] [IsGalois K ↥L₁]
        (E₀ : IntermediateField K (AlgebraicClosure K))
        (hE₀_L₀ : E₀ ≤ L₀) (hle : E₀ ≤ L₁),
      letI : Algebra R₀ ↥L₁ := ((algebraMap K ↥L₁).comp (algebraMap R₀ K)).toAlgebra
      ∀ (φ_C : C →ₐ[R₀] ↥L₁) (σ' : ↥L₁ ≃ₐ[K] ↥L₁),
        (∀ c : C, σ' (φ_C c) = φ_C c) →
        ∃ (C_top : Type u) (_ : CommRing C_top) (_ : IsDomain C_top)
          (_ : Algebra R₀ C_top) (_ : Algebra.Etale R₀ C_top)
          (j_C : C →ₐ[R₀] C_top) (j_gal : C_gal →ₐ[R₀] C_top)
          (τ_top : C_top ≃ₐ[R₀] C_top) (σ₀ : ↥L₀ ≃ₐ[K] ↥L₀),
          (∀ c : C, τ_top.symm (j_C c) = j_C c) ∧
          (let σ₀_R' : ↥L₀ ≃ₐ[R'] ↥L₀ :=
             { σ₀.toRingEquiv with commutes' := fun r => σ₀.commutes (φ_g₀ r) }
           ∀ b : C_gal,
             τ_top.symm (j_gal b) = j_gal ((AlgEquiv.mapIntegralClosure σ₀_R').symm b)) ∧
          ((∀ x : ↥E₀,
              σ₀ (IntermediateField.inclusion hE₀_L₀ x) = IntermediateField.inclusion hE₀_L₀ x) →
            ∀ x : ↥E₀,
              σ' (IntermediateField.inclusion hle x) = IntermediateField.inclusion hle x)) ∧
    (∀ (E₀ : IntermediateField K (AlgebraicClosure K))
        [FiniteDimensional K ↥E₀] [IsGalois K ↥E₀] (hE₀_L₀ : E₀ ≤ L₀),
      letI : Algebra R₀ ↥E₀ := ((algebraMap K ↥E₀).comp (algebraMap R₀ K)).toAlgebra
      let B₀ := ↥(integralClosure R₀ ↥E₀)
      Module.Finite R₀ B₀ →
      Algebra.Etale R₀ B₀ →
      let b₀ : B₀ := algebraMap R₀ B₀ g₀
      let C'₀ := Localization.Away b₀
      IsDomain C'₀ ∧
