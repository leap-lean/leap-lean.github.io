    intro r
    have hPointwise_α : ∀ (W : U₀.toScheme.Etale) (s : ↑((𝒱₀ r).obj.obj (Opposite.op W))),
        ∃ t : ↑((ℛ r).obj.obj (Opposite.op W)),
          ∀ y_raw : ↥(CategoryTheory.Limits.pullback
              ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom (π_Braw r)),
            triv_R r W t y_raw = α_lat r (triv r W s ((m_j_can r W).base y_raw)) := by
      intro W s
