          letI := hCR r; letI := hDom r; letI := hAR_B r
          letI := hFin_B r; letI := hEt_B r; letI := hπ_et_raw r
          obtain ⟨u_σ, hu_σ⟩ := mkEtaleDeck r (σ_P r)
          obtain ⟨u_inv, hu_inv⟩ := mkEtaleDeck r (σ_P r)⁻¹
          have hu_comp : CategoryTheory.CategoryStruct.comp u_σ u_inv =
              CategoryTheory.CategoryStruct.id _ := by
            have h_spec :
                CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_P r).symm.toRingHom))
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_P r)⁻¹.symm.toRingHom)) =
                CategoryTheory.CategoryStruct.id
                  (AlgebraicGeometry.Spec (CommRingCat.of (B_raw r))) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
              exact congrArg AlgebraicGeometry.Spec.map
                (CommRingCat.hom_ext (RingHom.ext fun b => (σ_P r).symm_apply_apply b))
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact (CategoryTheory.MorphismProperty.Comma.comp_left u_σ u_inv).trans
              ((congrArg₂ CategoryTheory.CategoryStruct.comp hu_σ hu_inv).trans h_spec)
          let π_r :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_raw r))) ≫ e_U.hom
          let E_r : U₀.toScheme.Etale := AlgebraicGeometry.Scheme.Etale.mk π_r
          let ℛ_r := weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q_deg r
          let s₀ : ↑(ℛ_r.obj.obj (Opposite.op E_r)) := (eval_V r).symm v
          let s : ↑(ℛ_r.obj.obj (Opposite.op E_r)) := (ℛ_r.obj.map (Opposite.op u_inv)).hom s₀
          have hmap_id : ℛ_r.obj.map (Opposite.op u_inv) ≫ ℛ_r.obj.map (Opposite.op u_σ) =
              CategoryTheory.CategoryStruct.id _ :=
            (ℛ_r.obj.map_comp (Opposite.op u_inv) (Opposite.op u_σ)).symm.trans
              ((congrArg (fun f => ℛ_r.obj.map (Opposite.op f)) hu_comp).trans
                (ℛ_r.obj.map_id _))
          have hs_map : (ℛ_r.obj.map (Opposite.op u_σ)).hom s = s₀ :=
            congrArg (fun φ => φ.hom s₀) hmap_id
          have hv_eq : eval_V r ((ℛ_r.obj.map (Opposite.op u_σ)).hom s) = v := by
            rw [hs_map, (eval_V r).apply_symm_apply]
          have h1 := hρ_pin r (σ_P r) u_σ hu_σ s
          rw [hv_eq] at h1
          have hker_P : ∀ b : B_raw r, (σ_P r).symm b - b ^ Nat.card F_P ∈ RingHom.ker (χ_P r) := by
            intro b
            rw [hCard_FP, ← (hQP_spec r).2.2.1]
            exact (hQP_spec r).2.2.2.2.2.2.2 b
          have h2 := heval_P_frob q_deg r (B_raw r) (hπ_et_raw r) (χ_P r) (hQP_spec r).1
            (σ_P r) hker_P u_σ hu_σ f_P hf_P s
          have hψ_eval : ∀ x : ↑(ℛ_r.obj.obj (Opposite.op E_r)),
              ψ_deg r (eval_V r x) = eval_P_eq r x :=
            fun x => by dsimp [ψ_deg]; rw [(eval_V r).symm_apply_apply]
          rw [h1, hψ_eval s, ← hv_eq, hψ_eval ((ℛ_r.obj.map (Opposite.op u_σ)).hom s)]
          exact h2.symm
      obtain ⟨ψ_mid, hψ_mid_trans, hψ_mid_frob⟩ :=
        hBuildPsi 0 2 (2 * m + 1) (fun _ => rfl) (fun _ => rfl)
          eval_V_mid ρ_raw heval_mid_def hρ_mid_pin
      obtain ⟨ψ_top, _, hψ_top_frob⟩ :=
        hBuildPsi 1 3 (2 * (2 * m + 1)) (fun _ => rfl) (fun _ => rfl)
          eval_V_top ρ_top heval_top_def hρ_top_pin
      exact ⟨⟨ψ_mid, hψ_mid_trans, hψ_mid_frob⟩, ⟨ψ_top, hψ_top_frob⟩⟩

  have hQ_P_raw : ∀ (d : ℕ) (P_poly : Polynomial F)
      (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
      ∃ (Q_P : ∀ r : ℕ, letI := hCR r; Ideal (B_raw r))
        (σ_P : ∀ r : ℕ, letI := hCR r; letI := hAR_B r; B_raw r ≃ₐ[R₀] B_raw r),
        (∀ r : ℕ,
          letI := hCR r; letI := hCR (r + 1); letI := hAP_B r; letI := hAR_B r; letI := hAR_B (r + 1)
          (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (B_raw r)) (Q_P r) = Ideal.span {P_poly} ∧
          Ideal.comap (ι_Braw r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          (∀ b : B_raw r, σ_P (r + 1) (ι_Braw r b) = ι_Braw r (σ_P r b)) ∧
          (∀ b : B_raw r, (σ_P r).symm b - b ^ (Nat.card F ^ d) ∈ Q_P r)) ∧
        (1 ≤ d →
          let _ : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
          ∀ (hFin_P : Finite (AdjoinRoot P_poly)),
            let _ : Finite (AdjoinRoot P_poly) := hFin_P
            ∃ ψ_P : ∀ r : ℕ,
                weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) ≃+
                  weilEtaleTorsionH
                    (weilGeomScheme (AdjoinRoot P_poly)
                      (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                    (ℓ ^ (r + 1)) (2 * m + 1),
              (∀ (r : ℕ)
                (v : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 2)) (2 * m + 1)),
                weilEtaleTorsionTransition
                  (weilGeomScheme (AdjoinRoot P_poly)
                    (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                  ℓ (r + 1) (2 * m + 1) (ψ_P (r + 1) v) =
                ψ_P r
                  (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1) v)) ∧
              (∀ (r : ℕ)
                (f_P : weilEtaleTorsionH
                    (weilGeomScheme (AdjoinRoot P_poly)
                      (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                    (ℓ ^ (r + 1)) (2 * m + 1) →+
                  weilEtaleTorsionH
                    (weilGeomScheme (AdjoinRoot P_poly)
                      (weilTransvTriClosedPointFiber F f₀ j_aff P_poly))
                    (ℓ ^ (r + 1)) (2 * m + 1)),
                WeilIsTorsionGeomFrobAction (AdjoinRoot P_poly)
                  (weilTransvTriClosedPointFiber F f₀ j_aff P_poly) (ℓ ^ (r + 1)) (2 * m + 1) f_P →
                ∀ v, ψ_P r ((ρ_raw r (σ_P r)).val v) = f_P (ψ_P r v))) := by
    intro d P_poly hP
    obtain ⟨Q_P, σ_P, h1, h2⟩ := hClosedPtFull d P_poly hP
    exact ⟨Q_P, σ_P, h1, fun hd hFin_P => (h2 hd hFin_P).1⟩

  
  have hTorsionAnn : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m₀ k_deg : ℕ)
      (y : weilEtaleTorsionH S m₀ k_deg), m₀ • y = 0 := by
    intro S m₀ k_deg y
    let J := S.smallEtaleTopology
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
    let A₀ := AddCommGrpCat.of (ZMod m₀)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj A₀
    let FM := C.obj AM
    have hA₀ : m₀ • CategoryTheory.CategoryStruct.id A₀ = 0 := by ext x; simp
    have hAM : m₀ • CategoryTheory.CategoryStruct.id AM = 0 := by
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hA₀,
        CategoryTheory.Functor.map_zero]
    have hFM : m₀ • CategoryTheory.CategoryStruct.id FM = 0 := by
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hAM,
        CategoryTheory.Functor.map_zero]
    let e₀ := CategoryTheory.Abelian.Ext.addEquiv₀ (X := FM) (Y := FM)
    have hid : e₀.symm (CategoryTheory.CategoryStruct.id FM) =
        CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM) := rfl
    have hy : y = (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM)).postcomp
        Fℤ (Nat.add_zero k_deg) y := by simp
    calc m₀ • y
        = m₀ • ((e₀.symm (CategoryTheory.CategoryStruct.id FM)).postcomp Fℤ
            (Nat.add_zero k_deg) y) := by rw [hid, ← hy]
      _ = ((m₀ • e₀.symm (CategoryTheory.CategoryStruct.id FM)).postcomp Fℤ
            (Nat.add_zero k_deg)) y := by simp
      _ = ((e₀.symm (m₀ • CategoryTheory.CategoryStruct.id FM)).postcomp Fℤ
            (Nat.add_zero k_deg)) y := by rw [← map_nsmul]
      _ = (CategoryTheory.Abelian.Ext.postcomp 0 Fℤ (Nat.add_zero k_deg)) y := by
            rw [hFM, map_zero]
      _ = 0 := by simp

  have hCup_geom : ∀ (r : ℕ),
      letI := hCR r; letI := hAF_B r; letI := hAR_B r
      ∀ σ : B_raw r ≃ₐ[R₀] B_raw r,
        (∀ x : B_raw r, IsIntegral F x → σ x = x) →
        ∀ (θ_mid : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) →+
            weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1))
          (θ_top : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1)) →+
            weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1))),
          WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1) θ_mid →
          WeilIsModuleToTorsionComparison (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1))
            (2 * (2 * m + 1)) θ_top →
          ∀ (a b a' b' : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1)),
            (ρ_raw r σ).val (θ_mid a) = θ_mid a' →
            (ρ_raw r σ).val (θ_mid b) = θ_mid b' →
            θ_top (CategoryTheory.Abelian.Ext.comp a' b' (Nat.two_mul (2 * m + 1)).symm) =
              θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm) := by
    intro r σ hσ_geom θ_mid θ_top hθ_mid hθ_top a b a' b' ha hb
    letI := hCR r; letI := hDom r; letI := hFld r
    letI := hAF_B r; letI := hAP_B r; letI := hAR_B r
    letI := hAF_L r; letI := hAP_L r; letI := hARF_L r
    letI := hABL r; letI := hARL r
    letI := hST1 r; letI := hST2 r; letI := hST3 r; letI := hST4 r; letI := hST5 r; letI := hST6 r
    letI := hFin_B r; letI := hEt_B r; letI := hFrac r; letI := hIntCl r
    letI := hFD_L r; letI := hGal_L r; letI := hπ_et_raw r

    
    obtain ⟨μ_ℛ, hμ_nat, hμ_cup⟩ :=
      weil_mid_dev_raw_sheaf_cup_pairing_comm F Z_tilde f₀ U₀ ℓ m r
    let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_raw r))) ≫ e_U.hom
    let E_r : U₀.toScheme.Etale := AlgebraicGeometry.Scheme.Etale.mk π_r
    have hCupEval : ∀ (x_a x_b : weilEtaleModuleH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1))
        (s₁ s₂ : ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r).obj.obj
          (Opposite.op E_r))),
        eval_V_mid r s₁ = θ_mid x_a →
        eval_V_mid r s₂ = θ_mid x_b →
        eval_V_top r (μ_ℛ E_r s₁ s₂) =
          θ_top (CategoryTheory.Abelian.Ext.comp x_a x_b (Nat.two_mul (2 * m + 1)).symm) := by
      intro x_a x_b s₁ s₂ hs₁ hs₂
      obtain ⟨Y, u, h_fib, d_fib, l_Y, c₁, c₂, hc₁, hc₂, hTermInj, hAgree⟩ :=
        heval_u_loc (2 * m + 1) (2 * m + 1) r (B_raw r) (hπ_et_raw r) (χ_u r) (hQu_spec r).1 s₁ s₂
      have hpull₁ := (hAgree (2 * m + 1) s₁ c₁ hc₁).symm
      rw [← heval_mid_def r s₁, hs₁] at hpull₁
      have hpull₂ := (hAgree (2 * m + 1) s₂ c₂ hc₂).symm
      rw [← heval_mid_def r s₂, hs₂] at hpull₂
      obtain ⟨c_top, hμ_ctop, hpull_top⟩ :=
        hμ_cup Y (weilGeomScheme F Z_u₀) h_fib d_fib l_Y θ_mid θ_top hθ_mid hθ_top
          c₁ c₂ x_a x_b hpull₁ hpull₂
      have hu_μ :
          ((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * (2 * m + 1)) r).obj.map
            (Opposite.op u)).hom (μ_ℛ E_r s₁ s₂) =
            (((CategoryTheory.sheafificationAdjunction U₀.toScheme.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app
                ((weilEtaleSitePullback (f₀.left ∣_ U₀)).op ⋙
                  (weilEtaleTorsionSheaf (f₀.left ⁻¹ᵁ U₀).toScheme
                    (ℓ ^ (r + 1))).cohomologyPresheaf (2 * (2 * m + 1)))).app
              (Opposite.op Y)).hom c_top :=
        (hμ_nat u s₁ s₂).trans
          ((congrArg₂ (fun x y => μ_ℛ Y x y) hc₁.symm hc₂.symm).trans hμ_ctop)
      have h_top_eq := hAgree (2 * (2 * m + 1)) (μ_ℛ E_r s₁ s₂) c_top hu_μ.symm
      rw [hpull_top, ← heval_top_def r (μ_ℛ E_r s₁ s₂)] at h_top_eq
      exact hTermInj (2 * (2 * m + 1)) h_top_eq

    
    have hCupEquiv_σ :
        (ρ_top r σ).val
          (θ_top (CategoryTheory.Abelian.Ext.comp a b (Nat.two_mul (2 * m + 1)).symm)) =
        θ_top (CategoryTheory.Abelian.Ext.comp a' b' (Nat.two_mul (2 * m + 1)).symm) := by
      obtain ⟨u_inv, hu_inv⟩ := mkEtaleDeck r σ⁻¹
      let ℛ_mid := weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r
      let ℛ_top := weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * (2 * m + 1)) r
      let s₁ : ↑(ℛ_mid.obj.obj (Opposite.op E_r)) := (eval_V_mid r).symm (θ_mid a)
      let s₂ : ↑(ℛ_mid.obj.obj (Opposite.op E_r)) := (eval_V_mid r).symm (θ_mid b)
      let s₁' : ↑(ℛ_mid.obj.obj (Opposite.op E_r)) := (ℛ_mid.obj.map (Opposite.op u_inv)).hom s₁
      let s₂' : ↑(ℛ_mid.obj.obj (Opposite.op E_r)) := (ℛ_mid.obj.map (Opposite.op u_inv)).hom s₂
      have hs₁' : eval_V_mid r s₁' = θ_mid a' := by
        have hpin := hρ_mid_pin r σ⁻¹ u_inv hu_inv s₁
        have hmul : (ρ_raw r σ).val ((ρ_raw r σ⁻¹).val (eval_V_mid r s₁')) =
            eval_V_mid r s₁' := by
          change ((ρ_raw r σ * ρ_raw r σ⁻¹).val) (eval_V_mid r s₁') = _
          rw [← map_mul, mul_inv_cancel, map_one]
          rfl
        rw [← hmul, hpin, (eval_V_mid r).apply_symm_apply, ha]
      have hs₂' : eval_V_mid r s₂' = θ_mid b' := by
        have hpin := hρ_mid_pin r σ⁻¹ u_inv hu_inv s₂
        have hmul : (ρ_raw r σ).val ((ρ_raw r σ⁻¹).val (eval_V_mid r s₂')) =
            eval_V_mid r s₂' := by
          change ((ρ_raw r σ * ρ_raw r σ⁻¹).val) (eval_V_mid r s₂') = _
          rw [← map_mul, mul_inv_cancel, map_one]
          rfl
        rw [← hmul, hpin, (eval_V_mid r).apply_symm_apply, hb]
      have h_ab := hCupEval a b s₁ s₂ ((eval_V_mid r).apply_symm_apply _)
        ((eval_V_mid r).apply_symm_apply _)
      have h_a'b' := hCupEval a' b' s₁' s₂' hs₁' hs₂'
      have hpin_top := hρ_top_pin r σ⁻¹ u_inv hu_inv (μ_ℛ E_r s₁ s₂)
      have hmul_top : ∀ w, (ρ_top r σ).val ((ρ_top r σ⁻¹).val w) = w := by
        intro w
        change ((ρ_top r σ * ρ_top r σ⁻¹).val) w = w
        rw [← map_mul, mul_inv_cancel, map_one]
        rfl
      rw [← h_ab, ← h_a'b', ← hpin_top, hmul_top]
      exact congrArg (eval_V_top r) (hμ_nat u_inv s₁ s₂)

    
    letI : IsScalarTower F R₀ (B_raw r) := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hσu_const : ∀ x : B_raw r, IsIntegral F x → (σ_u r).symm x = x ^ Nat.card F := by
      intro x hx
      let k_sub := integralClosure F (B_raw r)
      have hField_k : IsField ↥k_sub :=
        (Algebra.IsIntegral.isField_iff_isField (R := F) (S := ↥k_sub)
          (RingHom.injective (algebraMap F ↥k_sub))).mp (Field.toIsField F)
      let σ_F : B_raw r →ₐ[F] B_raw r := (σ_u r).symm.toAlgHom.restrictScalars F
      have hy_int : IsIntegral F ((σ_u r).symm x - x ^ Nat.card F) :=
        k_sub.sub_mem (hMapInt σ_F hx) (k_sub.pow_mem hx (Nat.card F))
      have hy_mem_Q : (σ_u r).symm x - x ^ Nat.card F ∈ Q_u r := by
        simpa [pow_one] using (hQu_spec r).2.2.2.2.2.2.2 x
      by_contra hne
      have hy_ne : (⟨(σ_u r).symm x - x ^ Nat.card F, hy_int⟩ : ↥k_sub) ≠ 0 :=
        fun h0 => hne (sub_eq_zero.mp (congrArg Subtype.val h0))
      obtain ⟨z_inv, hz_inv⟩ := hField_k.mul_inv_cancel hy_ne
      have h1_mem : (1 : B_raw r) ∈ Q_u r := by
        have hval : ((σ_u r).symm x - x ^ Nat.card F) * z_inv.1 = 1 :=
          congrArg Subtype.val hz_inv
        rw [← hval]
        exact (Q_u r).mul_mem_right z_inv.1 hy_mem_Q
      exact (hQu_spec r).2.2.2.1.ne_top ((Ideal.eq_top_iff_one (Q_u r)).mpr h1_mem)

    have hσu_pow_const : ∀ (t : ℕ) (x : B_raw r),
        IsIntegral F x → (((σ_u r) ^ t).symm) x = x ^ (Nat.card F ^ t) := by
      intro t
      induction t with
      | zero =>
        intro x _
        rw [pow_zero, pow_zero, pow_one]
        rfl
      | succ t ih =>
        intro x hx
        have hsymm : ((σ_u r) ^ (t + 1)).symm x = (σ_u r).symm (((σ_u r) ^ t).symm x) := by
          change (((σ_u r) ^ (t + 1))⁻¹) x = ((σ_u r)⁻¹ * ((σ_u r) ^ t)⁻¹) x
          rw [pow_succ, mul_inv_rev]
        rw [hsymm, ih x hx]
        have hx_pow : IsIntegral F (x ^ (Nat.card F ^ t)) :=
          (integralClosure F (B_raw r)).pow_mem hx _
        rw [hσu_const _ hx_pow, ← pow_mul, ← pow_succ]

    obtain ⟨D₀, hCheb⟩ :=
      weil_etale_curve_cover_chebotarev_frob_realization F S_aff (B_raw r) (L_raw r)
        (fun D hD => weil_plane_curve_hensel_bombieri_upper_bound F D hD)
    let d := max D₀ 1
    have hD₀_le : D₀ ≤ d := le_max_left D₀ 1
    have hd_pos : 1 ≤ d := le_max_right D₀ 1
    let σ₀ : B_raw r ≃ₐ[R₀] B_raw r := σ * (σ_u r) ^ d
    have hσ₀_const : ∀ x : B_raw r, IsIntegral F x → σ₀.symm x = x ^ (Nat.card F ^ d) := by
      intro x hx
      have hσ_symm : σ.symm x = x := by
        have h1 := congrArg σ.symm (hσ_geom x hx)
        rw [σ.symm_apply_apply] at h1
        exact h1.symm
      change (((σ_u r) ^ d).symm) (σ.symm x) = x ^ (Nat.card F ^ d)
      rw [hσ_symm]
      exact hσu_pow_const d x hx

    obtain ⟨P_poly, hP, hConj_all⟩ := hCheb d hD₀_le σ₀ hσ₀_const
    obtain ⟨Q_P, σ_P, hQP_all, hQP_fib⟩ := hClosedPtFull d P_poly hP
    obtain ⟨hMax_QP, hComapP_QP, _, _, hCong_QP⟩ := hQP_all r
    have hConj_P : IsConj σ₀ (σ_P r) := hConj_all (Q_P r) (σ_P r) hMax_QP hComapP_QP hCong_QP

    
    letI : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
    let F_P := AdjoinRoot P_poly
    let pb_P : PowerBasis F F_P := AdjoinRoot.powerBasis' hP.1
    letI : FiniteDimensional F F_P := PowerBasis.finite pb_P
    have hFin_P : Finite F_P := Module.finite_of_finite F
    letI : Finite F_P := hFin_P
    have hCard_FP : Nat.card F_P = Nat.card F ^ d := by
      rw [Module.natCard_eq_pow_finrank (K := F) (V := F_P), pb_P.finrank,
        AdjoinRoot.powerBasis'_dim, hP.2.2.1]
    have hchar_FP : CharP F_P (ringChar F) :=
      (RingHom.charP_iff_charP (algebraMap F F_P) (ringChar F)).mp inferInstance
    have hchar_FP_eq : ringChar F_P = ringChar F := @ringChar.eq F_P _ (ringChar F) hchar_FP
    have hℓ_FP : ℓ ≠ ringChar F_P := by rw [hchar_FP_eq]; exact hℓ

    let x_P := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AdjoinRoot.mk P_poly)) ≫ j_aff
    let Z_P := weilTransvTriClosedPointFiber F f₀ j_aff P_poly
    let fst_ZP : Z_P.left ⟶ Z_tilde.left := CategoryTheory.Limits.pullback.fst f₀.left x_P
    have hPb_ZP0 : CategoryTheory.IsPullback fst_ZP Z_P.hom f₀.left x_P :=
      CategoryTheory.IsPullback.of_hasPullback f₀.left x_P
    letI : AlgebraicGeometry.IsProper Z_P.hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZP0 inferInstance

    have hxP_in_U₀ : Set.range x_P.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left) := by
      rintro _ ⟨pt, rfl⟩
      rw [hU₀_eq]
      refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AdjoinRoot.mk P_poly))).base pt,
        ?_, rfl⟩
      intro s hs hmem
      have h0 : AdjoinRoot.mk P_poly (Polynomial.X - Polynomial.C s) = 0 := by
        by_contra hne
        change AdjoinRoot.mk P_poly (Polynomial.X - Polynomial.C s) ∈ pt.asIdeal at hmem
        have h1_mem : (1 : F_P) ∈ pt.asIdeal := by
          rw [← mul_inv_cancel₀ hne]
          exact pt.asIdeal.mul_mem_right _ hmem
        exact pt.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
      rw [AdjoinRoot.mk_eq_zero] at h0
      obtain ⟨Q, hQ⟩ := h0
      have hev := congrArg (Polynomial.eval s) hQ
      simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self,
        Polynomial.eval_mul] at hev
      rcases mul_eq_zero.mp hev.symm with h1 | h2
      · exact hP.2.2.2 s hs h1
      · have hP_ne : P_poly ≠ 0 := hP.1.ne_zero
        have hQ_ne : Q ≠ 0 := by
          intro hQ0; rw [hQ0, mul_zero] at hQ
          exact (Polynomial.monic_X_sub_C s).ne_zero hQ
        have hdeg_eq := congrArg Polynomial.natDegree hQ
        rw [Polynomial.natDegree_X_sub_C, Polynomial.natDegree_mul hP_ne hQ_ne, hP.2.2.1] at hdeg_eq
        have hQ_deg0 : Q.natDegree = 0 := by omega
        rw [Polynomial.eq_C_of_natDegree_eq_zero hQ_deg0, Polynomial.eval_C] at h2
        apply hQ_ne
        rw [Polynomial.eq_C_of_natDegree_eq_zero hQ_deg0, h2, map_zero]

    let s_U : AlgebraicGeometry.Spec (CommRingCat.of F_P) ⟶ U₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U₀.ι x_P
        (by rwa [AlgebraicGeometry.Scheme.Opens.range_ι])
    have hs_U_fac : s_U ≫ U₀.ι = x_P :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₀.ι x_P
        (by rwa [AlgebraicGeometry.Scheme.Opens.range_ι])
    have hPb_rest : CategoryTheory.IsPullback (f₀.left ⁻¹ᵁ U₀).ι (f₀.left ∣_ U₀) f₀.left U₀.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict f₀.left U₀).flip
    let ι_ZP_X₀ : Z_P.left ⟶ (f₀.left ⁻¹ᵁ U₀).toScheme :=
      hPb_rest.lift fst_ZP (Z_P.hom ≫ s_U)
        (by rw [CategoryTheory.Category.assoc, hs_U_fac, hPb_ZP0.w])
    have hPb_ZP_U₀ : CategoryTheory.IsPullback ι_ZP_X₀ Z_P.hom (f₀.left ∣_ U₀) s_U := by
      refine CategoryTheory.IsPullback.of_right ?_ (hPb_rest.lift_snd _ _ _) hPb_rest
      rw [hPb_rest.lift_fst, hs_U_fac]
      exact hPb_ZP0
    letI : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_P.hom :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZP_U₀ hSm_U₀

    have hGeom_ZP : AlgebraicGeometry.GeometricallyIrreducible Z_P.hom := by
      rw [AlgebraicGeometry.geometricallyIrreducible_iff,
        AlgebraicGeometry.geometrically_iff_of_commRing_of_isClosedUnderIsomorphisms]
      intro K hFieldK hAlgK
      letI : Field K := hFieldK
      letI : Algebra F_P K := hAlgK
      let s_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F_P K))
      let Ω_K : Type u := AlgebraicClosure K
      let s_KΩ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K Ω_K))
      haveI : AlgebraicGeometry.Surjective s_KΩ := ⟨Function.surjective_to_subsingleton _⟩
      let P_K := CategoryTheory.Limits.pullback Z_P.hom s_K
      let P' := CategoryTheory.Limits.pullback
        (CategoryTheory.Limits.pullback.snd Z_P.hom s_K) s_KΩ
      let q_proj : P' ⟶ P_K :=
        CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd Z_P.hom s_K) s_KΩ
      have hPb_paste : CategoryTheory.IsPullback
          (q_proj ≫ CategoryTheory.Limits.pullback.fst Z_P.hom s_K ≫ fst_ZP)
          (CategoryTheory.Limits.pullback.snd
            (CategoryTheory.Limits.pullback.snd Z_P.hom s_K) s_KΩ)
          f₀.left (s_KΩ ≫ s_K ≫ x_P) :=
        ((CategoryTheory.IsPullback.of_hasPullback
          (CategoryTheory.Limits.pullback.snd Z_P.hom s_K) s_KΩ).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback Z_P.hom s_K)).paste_horiz hPb_ZP0
      haveI : IrreducibleSpace ↥(CategoryTheory.Limits.pullback f₀.left (s_KΩ ≫ s_K ≫ x_P)) :=
        hFibIrred Ω_K (s_KΩ ≫ s_K ≫ x_P)
      haveI : IrreducibleSpace ↥P' :=
        hPb_paste.isoPullback.hom.homeomorph.irreducibleSpace_iff.mpr inferInstance
      have hSurj_q : Function.Surjective q_proj.base :=
        (inferInstance : AlgebraicGeometry.Surjective q_proj).1
      have hIrr_univ : IsIrreducible (Set.univ : Set ↥P_K) := by
        have himg :=
          (IrreducibleSpace.isIrreducible_univ ↥P').image q_proj.base
            q_proj.base.hom.continuous.continuousOn
        rwa [Set.image_univ, Set.range_eq_univ.mpr hSurj_q] at himg
      exact { toPreirreducibleSpace := ⟨hIrr_univ.2⟩, toNonempty := ⟨Classical.choose hIrr_univ.1⟩ }
    letI : AlgebraicGeometry.GeometricallyIrreducible Z_P.hom := hGeom_ZP

    
    let N_sc : ℕ := Nat.card F ^ ((2 * m + 1) * d)
    obtain ⟨f_u_top, hf_u_top⟩ := (hMod3 F Z_u₀).1 (ℓ ^ (r + 1)) (2 * (2 * m + 1))
    have hFu_smul : ∀ w, (ρ_top r (σ_u r)).val w = (Nat.card F ^ (2 * m + 1)) • w := by
      intro w
      rw [hFrob_u_pin (2 * (2 * m + 1)) eval_V_top ρ_top heval_top_def hρ_top_pin r
        f_u_top hf_u_top w]
      exact weil_etale_top_degree_geom_frob_smul F Z_u₀ (2 * m + 1) ℓ hℓ (r + 1)
        f_u_top hf_u_top w

    have hFu_pow_smul : ∀ (t : ℕ) (w : weilEtaleTorsionH (weilGeomScheme F Z_u₀)
        (ℓ ^ (r + 1)) (2 * (2 * m + 1))),
        (ρ_top r ((σ_u r) ^ t)).val w = (Nat.card F ^ ((2 * m + 1) * t)) • w := by
      intro t
      induction t with
      | zero =>
        intro w
        rw [pow_zero, map_one, Nat.mul_zero, pow_zero, one_smul]
        rfl
      | succ t ih =>
        intro w
        rw [pow_succ' (σ_u r) t, map_mul]
        change (ρ_top r (σ_u r)).val ((ρ_top r ((σ_u r) ^ t)).val w) = _
        rw [ih w, map_nsmul, hFu_smul w, ← mul_nsmul', ← pow_add]
        congr 2

    obtain ⟨_, ⟨ψ_P_top, hψ_P_top_frob⟩⟩ := hQP_fib hd_pos hFin_P
    obtain ⟨f_P_top, hf_P_top⟩ := (hMod3 F_P Z_P).1 (ℓ ^ (r + 1)) (2 * (2 * m + 1))
    have hFP_smul : ∀ w, (ρ_top r (σ_P r)).val w = N_sc • w := by
      intro w
      apply (ψ_P_top r).injective
      rw [hψ_P_top_frob r f_P_top hf_P_top w,
        weil_etale_top_degree_geom_frob_smul F_P Z_P (2 * m + 1) ℓ hℓ_FP (r + 1)
          f_P_top hf_P_top (ψ_P_top r w),
        hCard_FP, ← pow_mul', map_nsmul]

    have hσ₀_smul : ∀ w, (ρ_top r σ₀).val w = N_sc • w := by
      obtain ⟨c_conj, hc_conj⟩ := isConj_iff.mp hConj_P
      intro w
      have h_unit : ρ_top r (σ_P r) = ρ_top r c_conj * ρ_top r σ₀ * (ρ_top r c_conj)⁻¹ := by
        rw [← hc_conj, map_mul, map_mul, map_inv]
      have h_comm : ρ_top r c_conj * ρ_top r σ₀ = ρ_top r (σ_P r) * ρ_top r c_conj := by
        rw [h_unit, mul_assoc, inv_mul_cancel, mul_one]
      have hinj : Function.Injective (ρ_top r c_conj).val := by
        intro x y hxy
        have h1 := congrArg (ρ_top r c_conj⁻¹).val hxy
        change ((ρ_top r c_conj⁻¹ * ρ_top r c_conj).val) x =
          ((ρ_top r c_conj⁻¹ * ρ_top r c_conj).val) y at h1
        rwa [← map_mul, inv_mul_cancel, map_one] at h1
      have h_inv_app : ∀ z, (ρ_top r σ₀).val ((ρ_top r c_conj⁻¹).val z) =
          (ρ_top r c_conj⁻¹).val (N_sc • z) := by
        intro z
        rw [map_nsmul]
        apply hinj
        have ha2 := congrArg (fun g : (AddMonoid.End _)ˣ => g.val ((ρ_top r c_conj⁻¹).val z)) h_comm
        change (ρ_top r c_conj).val ((ρ_top r σ₀).val ((ρ_top r c_conj⁻¹).val z)) =
          (ρ_top r (σ_P r)).val ((ρ_top r c_conj).val ((ρ_top r c_conj⁻¹).val z)) at ha2
        have hcz : (ρ_top r c_conj).val ((ρ_top r c_conj⁻¹).val z) = z := by
          change ((ρ_top r c_conj * ρ_top r c_conj⁻¹).val) z = z
          rw [← map_mul, mul_inv_cancel, map_one]; rfl
        rw [map_nsmul, hcz, ha2, hcz, hFP_smul z]
      have := h_inv_app ((ρ_top r c_conj).val w)
      have hcw : (ρ_top r c_conj⁻¹).val ((ρ_top r c_conj).val w) = w := by
        change ((ρ_top r c_conj⁻¹ * ρ_top r c_conj).val) w = w
        rw [← map_mul, inv_mul_cancel, map_one]; rfl
      rwa [hcw, map_nsmul, hcw] at this

    have hσ_id_top : ∀ w, (ρ_top r σ).val w = w := by
      intro w
      have hmul_eq : N_sc • w = N_sc • ((ρ_top r σ).val w) := by
        calc N_sc • w = (ρ_top r σ₀).val w := (hσ₀_smul w).symm
          _ = (ρ_top r (σ * (σ_u r) ^ d)).val w := rfl
          _ = (ρ_top r σ).val ((ρ_top r ((σ_u r) ^ d)).val w) := by rw [map_mul]; rfl
          _ = (ρ_top r σ).val (N_sc • w) := by rw [hFu_pow_smul d w]
          _ = N_sc • ((ρ_top r σ).val w) := map_nsmul _ _ _
      let δ_w := (ρ_top r σ).val w - w
      have hN_ann : N_sc • δ_w = 0 := by
        dsimp [δ_w]
        rw [nsmul_sub, ← hmul_eq, sub_self]
      have hM_ann : (ℓ ^ (r + 1)) • δ_w = 0 :=
        hTorsionAnn (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * (2 * m + 1)) δ_w
      let p_char := ringChar F
      letI : Fintype F := Fintype.ofFinite F
      obtain ⟨n_F, hp_prime, hcard_F⟩ := FiniteField.card F p_char
      have hcard_nat : Nat.card F = p_char ^ (n_F : ℕ) := by
        rw [Nat.card_eq_fintype_card, hcard_F]
      have hp_coprime : Nat.Coprime p_char ℓ :=
        (Nat.coprime_primes hp_prime hPrime_ℓ).mpr hℓ.symm
      have hCoprime : Nat.Coprime N_sc (ℓ ^ (r + 1)) := by
        dsimp [N_sc]
        rw [hcard_nat, ← pow_mul]
        exact (hp_coprime.pow_left _).pow_right _
      have hgcd_eq : (1 : ℤ) =
          (N_sc : ℤ) * Nat.gcdA N_sc (ℓ ^ (r + 1)) +
          ((ℓ ^ (r + 1) : ℕ) : ℤ) * Nat.gcdB N_sc (ℓ ^ (r + 1)) := by
        have h := Nat.gcd_eq_gcd_ab N_sc (ℓ ^ (r + 1))
        rwa [hCoprime.gcd_eq_one, Nat.cast_one] at h
      have hδ_zero : δ_w = 0 := by
        calc δ_w = (1 : ℤ) • δ_w := (one_zsmul δ_w).symm
          _ = ((N_sc : ℤ) * Nat.gcdA N_sc (ℓ ^ (r + 1)) +
                ((ℓ ^ (r + 1) : ℕ) : ℤ) * Nat.gcdB N_sc (ℓ ^ (r + 1))) • δ_w := by
                rw [← hgcd_eq]
          _ = Nat.gcdA N_sc (ℓ ^ (r + 1)) • ((N_sc : ℤ) • δ_w) +
                Nat.gcdB N_sc (ℓ ^ (r + 1)) • (((ℓ ^ (r + 1) : ℕ) : ℤ) • δ_w) := by
                rw [add_zsmul, mul_comm (N_sc : ℤ), mul_zsmul,
                  mul_comm ((ℓ ^ (r + 1) : ℕ) : ℤ), mul_zsmul]
          _ = 0 := by
                rw [natCast_zsmul, natCast_zsmul, hN_ann, hM_ann, zsmul_zero, zsmul_zero,
                  add_zero]
      exact sub_eq_zero.mp hδ_zero

    rw [← hCupEquiv_σ, hσ_id_top]

  
  exact ⟨
    { B_raw := B_raw
      L_raw := L_raw
      hCR := hCR
      hDom := hDom
      hFld := hFld
      hAF_B := hAF_B
      hAP_B := hAP_B
      hAR_B := hAR_B
      hAF_L := hAF_L
      hAP_L := hAP_L
      hARF_L := hARF_L
      hABL := hABL
      hARL := hARL
      hST1 := hST1
      hST2 := hST2
      hST3 := hST3
      hST4 := hST4
      hST5 := hST5
      hST6 := hST6
      hFin_B := hFin_B
      hEt_B := hEt_B
      hFrac := hFrac
      hIntCl := hIntCl
      hFD_L := hFD_L
      hGal_L := hGal_L
      ι_Braw := ι_Braw
      ρ_raw := ρ_raw
      hι_raw := hι_raw
      hTriv_raw := ⟨triv_R, hTriv_mid_spec⟩
      hQ_u_raw := hQ_u_raw
      hQ_P_raw := hQ_P_raw
      hCup_geom := hCup_geom }⟩

theorem weil_mid_dev_closed_faithful_galois_ring_tower_quotient (F : Type u) [Finite F] [Field F] (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (a₀ : F) (ha₀ : a₀ ∉ S_aff)
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (T_raw : WeilMidDevClosedRawTorsionTower.{u} F m Z_tilde f₀ Z_u₀ j_aff S_aff U₀ a₀ e_U ℓ)
    (F_V_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (U_V_mat : ∀ (d : ℕ) (P_poly : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P_poly → (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (ρ_mat_raw : ∀ r : ℕ,
      letI := T_raw.hCR r; letI := T_raw.hAR_B r
      (T_raw.B_raw r ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r) →*
        (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
    (hρ_mat_compat : ∀ r : ℕ,
      letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
      letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
      ∀ (τ : T_raw.B_raw (r + 1) ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw (r + 1))
        (σ : T_raw.B_raw r ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r),
        (∀ b : T_raw.B_raw r, τ (T_raw.ι_Braw r b) = T_raw.ι_Braw r (σ b)) →
        ((ρ_mat_raw (r + 1) τ).val).map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          (ρ_mat_raw r σ).val)
    (hQu_mat : ∃ (Q_u : ∀ r : ℕ, letI := T_raw.hCR r; Ideal (T_raw.B_raw r))
      (σ_u : ∀ r : ℕ, letI := T_raw.hCR r; letI := T_raw.hAR_B r
        T_raw.B_raw r ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r),
      ∀ r : ℕ,
        letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
        letI := T_raw.hAP_B r; letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
        (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (T_raw.B_raw r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (T_raw.ι_Braw r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        (∀ b : T_raw.B_raw r, (σ_u r).symm b - b ^ Nat.card F ∈ Q_u r) ∧
        (ρ_mat_raw r (σ_u r)).val = (F_V_u.val).map (PadicInt.toZModPow (r + 1)))
    (hQP_mat : ∀ (d : ℕ) (P_poly : Polynomial F)
      (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
      ∃ (Q_P : ∀ r : ℕ, letI := T_raw.hCR r; Ideal (T_raw.B_raw r))
        (σ_P : ∀ r : ℕ, letI := T_raw.hCR r; letI := T_raw.hAR_B r
          T_raw.B_raw r ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r),
        ∀ r : ℕ,
          letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
          letI := T_raw.hAP_B r; letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
          (Q_P r).IsMaximal ∧
          Ideal.comap (algebraMap (Polynomial F) (T_raw.B_raw r)) (Q_P r) =
            Ideal.span {P_poly} ∧
          Ideal.comap (T_raw.ι_Braw r).toRingHom (Q_P (r + 1)) = Q_P r ∧
          (∀ b : T_raw.B_raw r, (σ_P r).symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
          (ρ_mat_raw r (σ_P r)).val =
            ((U_V_mat d P_poly hP).val).map (PadicInt.toZModPow (r + 1))) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∃ (B_V L_V : ℕ → Type u)
      (hCR : ∀ r, CommRing (B_V r))
      (hDom : ∀ r, IsDomain (B_V r))
      (hFld : ∀ r, Field (L_V r))
      (hAF_B : ∀ r, Algebra F (B_V r))
      (hAP_B : ∀ r, Algebra (Polynomial F) (B_V r))
      (hAR_B : ∀ r, Algebra R₀ (B_V r))
      (hAF_L : ∀ r, Algebra F (L_V r))
      (hAP_L : ∀ r, Algebra (Polynomial F) (L_V r))
      (hARF_L : ∀ r, Algebra (RatFunc F) (L_V r))
      (hABL : ∀ r, Algebra (B_V r) (L_V r))
      (hARL : ∀ r, Algebra R₀ (L_V r))
      (_ : ∀ r, letI := hCR r; letI := hAF_B r; letI := hAP_B r
        IsScalarTower F (Polynomial F) (B_V r))
      (_ : ∀ r, letI := hCR r; letI := hAP_B r; letI := hAR_B r
        IsScalarTower (Polynomial F) R₀ (B_V r))
      (_ : ∀ r, letI := hFld r; letI := hAF_L r; letI := hARF_L r
        IsScalarTower F (RatFunc F) (L_V r))
      (_ : ∀ r, letI := hFld r; letI := hAP_L r; letI := hARF_L r
        IsScalarTower (Polynomial F) (RatFunc F) (L_V r))
      (_ : ∀ r, letI := hCR r; letI := hFld r; letI := hAP_B r; letI := hABL r; letI := hAP_L r
        IsScalarTower (Polynomial F) (B_V r) (L_V r))
      (_ : ∀ r, letI := hCR r; letI := hFld r; letI := hAR_B r; letI := hABL r; letI := hARL r
        IsScalarTower R₀ (B_V r) (L_V r))
      (_ : ∀ r, letI := hCR r; letI := hAR_B r; Module.Finite R₀ (B_V r))
