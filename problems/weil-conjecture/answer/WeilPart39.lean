                · have hEmp : IsEmpty ↥(Fgt_Y.obj Z).left := by
                    refine ⟨fun z => hc₁ ?_⟩
                    rw [← hl₁_c z]
                    apply hz₂
                    have h1 : fst_U.base (l₁.base z) = (Fgt_Y.map w).left.base z :=
