            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r) π_r =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ σ)) ∧
          (⋃ σ : B r ≃ₐ[R₀] B r, Set.range (δ σ).base) = Set.univ) :=
    fun r => (hCombined r).2

  have hΦ_ex : ∃ Φ : ∀ (r : ℕ) (Y : (AlgebraicGeometry.Spec (CommRingCat.of (B r))).Etale),
      let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      let j_r := weilEtalePostcomp π_r (hπ_et r)
      ↑((ℛ r).obj.obj (Opposite.op (j_r.obj Y))) ≃+ LocallyConstant ↥Y.left (H r),
      (∀ (r : ℕ),
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
        let j_r := weilEtalePostcomp π_r (hπ_et r)
        ∀ {Y₁ Y₂ : V_r.Etale} (f : Y₁ ⟶ Y₂) (u_f : j_r.obj Y₁ ⟶ j_r.obj Y₂),
          u_f.left = f.left →
          ∀ (s : ↑((ℛ r).obj.obj (Opposite.op (j_r.obj Y₂)))) (y₁ : ↥Y₁.left),
            Φ r Y₁ (((ℛ r).obj.map (Opposite.op u_f)).hom s) y₁ =
              Φ r Y₂ s (f.left.base y₁)) ∧
      (∀ (r : ℕ),
        letI := hπ_et r
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
        let j_r := weilEtalePostcomp π_r (hπ_et r)
        let T_V : V_r.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V_r)
        ∀ (u_id : j_r.obj T_V ⟶ AlgebraicGeometry.Scheme.Etale.mk π_r),
          u_id.left = 𝟙 V_r →
          ∀ (s : ↑((ℛ r).obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk π_r)))) (x : ↥V_r),
            Φ r T_V (((ℛ r).obj.map (Opposite.op u_id)).hom s) x = eval_V r s) :=
    ⟨fun r => (hCombined r).1.choose,
      fun r => (hCombined r).1.choose_spec.1,
      fun r => (hCombined r).1.choose_spec.2⟩
  obtain ⟨Φ, hΦ_nat, hΦ_norm⟩ := hΦ_ex

  
  let V_of : ℕ → AlgebraicGeometry.Scheme.{u} := fun r =>
    AlgebraicGeometry.Spec (CommRingCat.of (B r))
  let π_of : ∀ r : ℕ, V_of r ⟶ U := fun r =>
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
  let j_of : ∀ r : ℕ, CategoryTheory.Functor (V_of r).Etale U.Etale := fun r =>
    weilEtalePostcomp (π_of r) (hπ_et r)
  let E_of : ℕ → U.Etale := fun r =>
    letI := hπ_et r
    AlgebraicGeometry.Scheme.Etale.mk (π_of r)
  let α_of : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) → (V_of r ⟶ V_of r) := fun _ σ =>
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
  have hα_π : ∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r), α_of r σ ≫ π_of r = π_of r := by
    intro r σ
    dsimp [α_of, π_of]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply congrArg AlgebraicGeometry.Spec.map
    exact CommRingCat.hom_ext σ.symm.toAlgHom.comp_algebraMap
  have hα_one : ∀ r : ℕ, α_of r 1 = 𝟙 (V_of r) := by
    intro r
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (1 : B r ≃ₐ[R₀] B r).symm.toRingHom) =
      𝟙 (V_of r)
    have hid : CommRingCat.ofHom (1 : B r ≃ₐ[R₀] B r).symm.toRingHom = 𝟙 (CommRingCat.of (B r)) :=
      CommRingCat.hom_ext rfl
    rw [hid, AlgebraicGeometry.Spec.map_id]
  have hα_mul : ∀ (r : ℕ) (σ₁ σ₂ : B r ≃ₐ[R₀] B r),
      α_of r (σ₁ * σ₂) = α_of r σ₂ ≫ α_of r σ₁ := by
    intro r σ₁ σ₂
    change AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (σ₁ * σ₂ : B r ≃ₐ[R₀] B r).symm.toRingHom) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₂.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₁.symm.toRingHom)
    rw [← AlgebraicGeometry.Spec.map_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    exact CommRingCat.hom_ext rfl
  have hα_et : ∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r), AlgebraicGeometry.Etale (α_of r σ) := by
    intro r σ
    have _ := hπ_et r
    have _ : AlgebraicGeometry.Etale (α_of r σ ≫ π_of r) := (hα_π r σ).symm ▸ hπ_et r
    exact AlgebraicGeometry.Etale.of_comp (α_of r σ) (π_of r)

  
  let u_can : ∀ (r : ℕ), (B r ≃ₐ[R₀] B r) → (E_of r ⟶ E_of r) := fun r σ =>
    CategoryTheory.MorphismProperty.Over.homMk (α_of r σ) (hα_π r σ) trivial
  have hu_one : ∀ r : ℕ, u_can r 1 = 𝟙 (E_of r) :=
    fun r => CategoryTheory.MorphismProperty.Over.Hom.ext (hα_one r)
  have hu_mul : ∀ (r : ℕ) (σ₁ σ₂ : B r ≃ₐ[R₀] B r),
      u_can r (σ₁ * σ₂) = u_can r σ₂ ≫ u_can r σ₁ :=
    fun r σ₁ σ₂ => CategoryTheory.MorphismProperty.Over.Hom.ext (hα_mul r σ₁ σ₂)

  let A_end : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) → AddMonoid.End (H r) := fun r σ =>
    (eval_V r).toAddMonoidHom.comp
      ((((ℛ r).obj.map (Opposite.op (u_can r σ))).hom).comp (eval_V r).symm.toAddMonoidHom)
  have hA_one : ∀ r : ℕ, A_end r 1 = 1 := by
    intro r
    ext v
    have hmap : ((ℛ r).obj.map (Opposite.op (u_can r 1))).hom ((eval_V r).symm v) =
        (eval_V r).symm v :=
      (congrArg (fun m => ((ℛ r).obj.map (Opposite.op m)).hom ((eval_V r).symm v))
        (hu_one r)).trans
        (congrArg (fun u => u.hom ((eval_V r).symm v)) ((ℛ r).obj.map_id (Opposite.op (E_of r))))
    exact (congrArg (eval_V r) hmap).trans ((eval_V r).apply_symm_apply v)
  have hA_mul : ∀ (r : ℕ) (σ₁ σ₂ : B r ≃ₐ[R₀] B r),
      A_end r (σ₁ * σ₂) = A_end r σ₂ * A_end r σ₁ := by
    intro r σ₁ σ₂
    ext v
    let s₁ := ((ℛ r).obj.map (Opposite.op (u_can r σ₁))).hom ((eval_V r).symm v)
    have h1 : ((ℛ r).obj.map (Opposite.op (u_can r (σ₁ * σ₂)))).hom ((eval_V r).symm v) =
        ((ℛ r).obj.map (Opposite.op (u_can r σ₂))).hom s₁ :=
      (congrArg (fun m => ((ℛ r).obj.map (Opposite.op m)).hom ((eval_V r).symm v))
        (hu_mul r σ₁ σ₂)).trans
        (congrArg (fun u => u.hom ((eval_V r).symm v))
          ((ℛ r).obj.map_comp (Opposite.op (u_can r σ₁)) (Opposite.op (u_can r σ₂))))
    have h2 : ((ℛ r).obj.map (Opposite.op (u_can r σ₂))).hom s₁ =
        ((ℛ r).obj.map (Opposite.op (u_can r σ₂))).hom ((eval_V r).symm (eval_V r s₁)) :=
      congrArg (((ℛ r).obj.map (Opposite.op (u_can r σ₂))).hom)
        ((eval_V r).symm_apply_apply s₁).symm
    exact congrArg (eval_V r) (h1.trans h2)

  let ρ : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (AddMonoid.End (H r))ˣ := fun r =>
    { toFun := fun σ =>
        { val := A_end r σ⁻¹
          inv := A_end r σ
          val_inv := by rw [← hA_mul r, mul_inv_cancel, hA_one r]
          inv_val := by rw [← hA_mul r, inv_mul_cancel, hA_one r] }
      map_one' := by
        apply Units.ext
        change A_end r 1⁻¹ = 1
        rw [inv_one, hA_one r]
      map_mul' := fun σ₁ σ₂ => by
        apply Units.ext
        change A_end r (σ₁ * σ₂)⁻¹ = A_end r σ₁⁻¹ * A_end r σ₂⁻¹
        rw [mul_inv_rev, hA_mul r] }

  
  let Y_W : ∀ (r : ℕ) (W : U.Etale), (V_of r).Etale := fun r W =>
    have : AlgebraicGeometry.Etale (((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom) := W.prop
    have : AlgebraicGeometry.Etale (π_of r) := hπ_et r
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.Limits.pullback.snd (((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom) (π_of r))
      inferInstance
  let ε_can : ∀ (r : ℕ) (W : U.Etale), (j_of r).obj (Y_W r W) ⟶ W := fun r W =>
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.fst (((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom) (π_of r))
      (CategoryTheory.Limits.pullback.condition
        (f := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom) (g := π_of r))
      trivial
  let triv : ∀ (r : ℕ) (W : U.Etale),
      let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      let W_r := CategoryTheory.Limits.pullback
        ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom π_r
      ↑((ℛ r).obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_r (H r) := fun r W =>
    (Φ r (Y_W r W)).toAddMonoidHom.comp (((ℛ r).obj.map (Opposite.op (ε_can r W))).hom)

  
  let twistObj : ∀ (r : ℕ), (V_of r).Etale → (B r ≃ₐ[R₀] B r) → (V_of r).Etale := fun r Y σ =>
    have : AlgebraicGeometry.Etale Y.hom := Y.prop
    have : AlgebraicGeometry.Etale (α_of r σ) := hα_et r σ
    CategoryTheory.MorphismProperty.Over.mk ⊤ (Y.hom ≫ α_of r σ) inferInstance
  let ξ_hom : ∀ (r : ℕ) (Y : (V_of r).Etale) (σ : B r ≃ₐ[R₀] B r),
      (j_of r).obj (twistObj r Y σ) ⟶ (j_of r).obj Y := fun r Y σ =>
    CategoryTheory.MorphismProperty.Over.homMk (𝟙 Y.left)
      (by
        change 𝟙 Y.left ≫ Y.hom ≫ π_of r = (Y.hom ≫ α_of r σ) ≫ π_of r
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hα_π r σ]) trivial

  have hmap_comp : ∀ (r : ℕ) {X Y Z : U.Etale} (f : X ⟶ Y) (g : Y ⟶ Z)
      (s : ↑((ℛ r).obj.obj (Opposite.op Z))),
      ((ℛ r).obj.map (Opposite.op (f ≫ g))).hom s =
        ((ℛ r).obj.map (Opposite.op f)).hom (((ℛ r).obj.map (Opposite.op g)).hom s) := by
    intro r X Y Z f g s
    exact congrArg (fun u => u.hom s) ((ℛ r).obj.map_comp (Opposite.op g) (Opposite.op f))
  have hmap_id : ∀ (r : ℕ) (X : U.Etale) (s : ↑((ℛ r).obj.obj (Opposite.op X))),
      ((ℛ r).obj.map (Opposite.op (𝟙 X))).hom s = s :=
    fun r X s => congrArg (fun u => u.hom s) ((ℛ r).obj.map_id (Opposite.op X))

  have hBaseTwist : ∀ (r : ℕ) (Y : (V_of r).Etale) (σ : B r ≃ₐ[R₀] B r)
      (t : ↑((ℛ r).obj.obj (Opposite.op ((j_of r).obj Y)))) (y : ↥Y.left),
      Φ r (twistObj r Y σ) (((ℛ r).obj.map (Opposite.op (ξ_hom r Y σ))).hom t) y =
        (ρ r σ).val (Φ r Y t y) := by
    intro r
    let T_V : (V_of r).Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 (V_of r))
    let u_id_can : (j_of r).obj T_V ⟶ E_of r :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 (V_of r))
        (CategoryTheory.Category.id_comp (π_of r)) trivial
    let u_id_inv : E_of r ⟶ (j_of r).obj T_V :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 (V_of r))
        ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.id_comp (π_of r)).symm)
        trivial
    have hBaseTwist_TV : ∀ (σ : B r ≃ₐ[R₀] B r)
        (t' : ↑((ℛ r).obj.obj (Opposite.op ((j_of r).obj T_V)))) (x : ↥(V_of r)),
        Φ r (twistObj r T_V σ) (((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom t') x =
          (ρ r σ).val (Φ r T_V t' x) := by
      intro σ t' x
      let s₀ : ↑((ℛ r).obj.obj (Opposite.op (E_of r))) :=
        ((ℛ r).obj.map (Opposite.op u_id_inv)).hom t'
      have hs₀_eq : ((ℛ r).obj.map (Opposite.op u_id_can)).hom s₀ = t' := by
        have hc : u_id_can ≫ u_id_inv = 𝟙 _ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
        exact (hmap_comp r u_id_can u_id_inv t').symm.trans
          ((congrArg (fun m => ((ℛ r).obj.map (Opposite.op m)).hom t') hc).trans
            (hmap_id r _ t'))
      let s : ↑((ℛ r).obj.obj (Opposite.op (E_of r))) :=
        ((ℛ r).obj.map (Opposite.op (u_can r σ⁻¹))).hom s₀
      have hs_eq : ((ℛ r).obj.map (Opposite.op (u_can r σ))).hom s = s₀ := by
        have hc : u_can r σ ≫ u_can r σ⁻¹ = 𝟙 _ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext
            ((hα_mul r σ⁻¹ σ).symm.trans
              ((congrArg (α_of r) (inv_mul_cancel σ)).trans (hα_one r)))
        exact (hmap_comp r (u_can r σ) (u_can r σ⁻¹) s₀).symm.trans
          ((congrArg (fun m => ((ℛ r).obj.map (Opposite.op m)).hom s₀) hc).trans
            (hmap_id r _ s₀))
      let α_lift : twistObj r T_V σ ⟶ T_V :=
        CategoryTheory.MorphismProperty.Over.homMk (α_of r σ)
          ((CategoryTheory.Category.comp_id (α_of r σ)).trans
            (CategoryTheory.Category.id_comp (α_of r σ)).symm) trivial
      have hcomm_TV : (j_of r).map α_lift ≫ u_id_can =
          ξ_hom r T_V σ ≫ u_id_can ≫ u_can r σ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.Category.comp_id _).trans
            ((CategoryTheory.Category.id_comp _).symm.trans
              (congrArg (𝟙 _ ≫ ·) (CategoryTheory.Category.id_comp _).symm)))
      have ht'_pull : ((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom t' =
          ((ℛ r).obj.map (Opposite.op ((j_of r).map α_lift))).hom
            (((ℛ r).obj.map (Opposite.op u_id_can)).hom s) := by
        have h1 : ((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom t' =
            ((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom
              (((ℛ r).obj.map (Opposite.op u_id_can)).hom
                (((ℛ r).obj.map (Opposite.op (u_can r σ))).hom s)) :=
          congrArg (((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom)
            (hs₀_eq.symm.trans (congrArg (((ℛ r).obj.map (Opposite.op u_id_can)).hom) hs_eq.symm))
        have h2 : ((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom
              (((ℛ r).obj.map (Opposite.op u_id_can)).hom
                (((ℛ r).obj.map (Opposite.op (u_can r σ))).hom s)) =
            ((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ ≫ u_id_can ≫ u_can r σ))).hom s :=
          (congrArg (((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom)
            (hmap_comp r u_id_can (u_can r σ) s).symm).trans
            (hmap_comp r (ξ_hom r T_V σ) (u_id_can ≫ u_can r σ) s).symm
        have h3 : ((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ ≫ u_id_can ≫ u_can r σ))).hom s =
            ((ℛ r).obj.map (Opposite.op ((j_of r).map α_lift))).hom
              (((ℛ r).obj.map (Opposite.op u_id_can)).hom s) :=
          (congrArg (fun m => ((ℛ r).obj.map (Opposite.op m)).hom s) hcomm_TV.symm).trans
            (hmap_comp r ((j_of r).map α_lift) u_id_can s)
        exact h1.trans (h2.trans h3)
      have hs1 : Φ r (twistObj r T_V σ) (((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom t') x =
          Φ r T_V (((ℛ r).obj.map (Opposite.op u_id_can)).hom s) ((α_of r σ).base x) :=
        (congrArg (fun q => Φ r (twistObj r T_V σ) q x) ht'_pull).trans
          (hΦ_nat r α_lift ((j_of r).map α_lift) rfl _ x)
      have hs2 : Φ r T_V (((ℛ r).obj.map (Opposite.op u_id_can)).hom s) ((α_of r σ).base x) =
          eval_V r s :=
        hΦ_norm r u_id_can rfl s ((α_of r σ).base x)
      have hs3 : eval_V r s = (ρ r σ).val (eval_V r s₀) :=
        congrArg (fun q => eval_V r (((ℛ r).obj.map (Opposite.op (u_can r σ⁻¹))).hom q))
          ((eval_V r).symm_apply_apply s₀).symm
      have hs4 : (ρ r σ).val (eval_V r s₀) = (ρ r σ).val (Φ r T_V t' x) :=
        congrArg (ρ r σ).val
          ((hΦ_norm r u_id_can rfl s₀ x).symm.trans
            (congrArg (fun q => Φ r T_V q x) hs₀_eq))
      exact hs1.trans (hs2.trans (hs3.trans hs4))
    intro Y σ t y
    let c : H r := Φ r Y t y
    let U_y : Y.left.Opens := ⟨(Φ r Y t) ⁻¹' {c}, (Φ r Y t).isLocallyConstant {c}⟩
    let Z : (V_of r).Etale :=
      have : AlgebraicGeometry.Etale Y.hom := Y.prop
      CategoryTheory.MorphismProperty.Over.mk ⊤ (U_y.ι ≫ Y.hom) inferInstance
    let k_Z : Z ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk U_y.ι rfl trivial
    let p_Z : Z ⟶ T_V := CategoryTheory.MorphismProperty.Over.homMk (U_y.ι ≫ Y.hom)
      (CategoryTheory.Category.comp_id _) trivial
    let t_c : ↑((ℛ r).obj.obj (Opposite.op ((j_of r).obj T_V))) :=
      ((ℛ r).obj.map (Opposite.op u_id_can)).hom ((eval_V r).symm c)
    have hZ_sec_eq : ((ℛ r).obj.map (Opposite.op ((j_of r).map k_Z))).hom t =
        ((ℛ r).obj.map (Opposite.op ((j_of r).map p_Z))).hom t_c := by
      apply (Φ r Z).injective
      ext z
      exact (hΦ_nat r k_Z ((j_of r).map k_Z) rfl t z).trans
        (z.2.trans
          (((eval_V r).apply_symm_apply c).symm.trans
            ((hΦ_norm r u_id_can rfl ((eval_V r).symm c) (p_Z.left.base z)).symm.trans
              (hΦ_nat r p_Z ((j_of r).map p_Z) rfl t_c z).symm)))
    let k_Z_σ : twistObj r Z σ ⟶ twistObj r Y σ :=
      CategoryTheory.MorphismProperty.Over.homMk U_y.ι
        (CategoryTheory.Category.assoc U_y.ι Y.hom (α_of r σ)) trivial
    let p_Z_σ : twistObj r Z σ ⟶ twistObj r T_V σ :=
      CategoryTheory.MorphismProperty.Over.homMk (U_y.ι ≫ Y.hom)
        (congrArg ((U_y.ι ≫ Y.hom) ≫ ·) (CategoryTheory.Category.id_comp (α_of r σ))) trivial
    have hk_ξ : (j_of r).map k_Z_σ ≫ ξ_hom r Y σ = ξ_hom r Z σ ≫ (j_of r).map k_Z :=
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id U_y.ι).trans
          (CategoryTheory.Category.id_comp U_y.ι).symm)
    have hp_ξ : (j_of r).map p_Z_σ ≫ ξ_hom r T_V σ = ξ_hom r Z σ ≫ (j_of r).map p_Z :=
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id (U_y.ι ≫ Y.hom)).trans
          (CategoryTheory.Category.id_comp (U_y.ι ≫ Y.hom)).symm)
    let y₀ : ↥U_y.toScheme := ⟨y, rfl⟩
    have hlhs : Φ r (twistObj r Y σ) (((ℛ r).obj.map (Opposite.op (ξ_hom r Y σ))).hom t) y =
        Φ r (twistObj r Z σ)
          (((ℛ r).obj.map (Opposite.op (ξ_hom r Z σ))).hom
            (((ℛ r).obj.map (Opposite.op ((j_of r).map k_Z))).hom t)) y₀ := by
      have hm' : ((ℛ r).obj.map (Opposite.op ((j_of r).map k_Z_σ))).hom
