        have hf_mem : f ∈ Set.range (triv r W) := ⟨s, rfl⟩
        rw [((hTriv_base r).2.2 W).2] at hf_mem
        have hf_eq := hf_mem σ m_σ
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          ((m_j_can r W).base y_raw)
