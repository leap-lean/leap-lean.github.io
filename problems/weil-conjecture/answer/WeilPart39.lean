  have _ : IsDomain R_s := hDom_Rs
  have _ : IsLocalRing R_s := hLoc_Rs
  have _ : HenselianLocalRing R_s := hHens_Rs
  have _ : IsDiscreteValuationRing R_s := hDVR_Rs
