                    (mapU g_hom.unop (pullΛ f_hom.unop wt)).op)).symm
              exact (hmap _ _ hassoc (mapU (g_hom.unop ≫ f_hom.unop) wt)
                (mapU g_hom.unop (pullΛ f_hom.unop wt) ≫ mapU f_hom.unop wt) rfl rfl).trans
                (congrArg (DFinsupp.singleAddHom (famP P W₃.unop) _) hcomp.symm) }
        map := fun {P₁ P₂} φ =>
          { app := fun W =>
              AddCommGrpCat.ofHom
                (DFinsupp.mapRange.addMonoidHom fun wt : Λ W.unop =>
                  (φ.app (Opposite.op (U_of W.unop wt))).hom)
            naturality := fun {W₁ W₂} f_hom => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun wt => AddMonoidHom.ext fun x => ?_
              have hL₁ := hLiftSingle
                (fun w' : Λ W₁.unop =>
                  (DFinsupp.singleAddHom (famP P₁ W₂.unop) (pullΛ f_hom.unop w')).comp
                    (P₁.map (mapU f_hom.unop w').op).hom) wt x
              have hL₂ := hMapRangeSingle
                (fun w'' : Λ W₂.unop => (φ.app (Opposite.op (U_of W₂.unop w''))).hom)
                (pullΛ f_hom.unop wt) ((P₁.map (mapU f_hom.unop wt).op).hom x)
              have hR₁ := hMapRangeSingle
                (fun w' : Λ W₁.unop => (φ.app (Opposite.op (U_of W₁.unop w'))).hom) wt x
              have hR₂ := hLiftSingle
                (fun w' : Λ W₁.unop =>
                  (DFinsupp.singleAddHom (famP P₂ W₂.unop) (pullΛ f_hom.unop w')).comp
                    (P₂.map (mapU f_hom.unop w').op).hom)
                wt ((φ.app (Opposite.op (U_of W₁.unop wt))).hom x)
              have hnat := congrArg (fun m => m.hom x) (φ.naturality (mapU f_hom.unop wt).op)
              exact (congrArg _ hL₁).trans
                (hL₂.trans
                  ((congrArg (DFinsupp.singleAddHom (famP P₂ W₂.unop)
                    (pullΛ f_hom.unop wt)) hnat).trans
                    (hR₂.symm.trans (congrArg _ hR₁.symm)))) }
        map_id := fun P => by
          apply CategoryTheory.NatTrans.ext
          funext W
          apply AddCommGrpCat.hom_ext
          refine DFinsupp.addHom_ext' fun wt => AddMonoidHom.ext fun x => ?_
          exact hMapRangeSingle
            (fun w' => AddCommGrpCat.Hom.hom (𝟙 (P.obj (Opposite.op (U_of W.unop w'))))) wt x
        map_comp := fun {P₁ P₂ P₃} φ ψ => by
          apply CategoryTheory.NatTrans.ext
          funext W
          apply AddCommGrpCat.hom_ext
          refine DFinsupp.addHom_ext' fun wt => AddMonoidHom.ext fun x => ?_
          have hL := hMapRangeSingle
            (fun w' : Λ W.unop => ((φ ≫ ψ).app (Opposite.op (U_of W.unop w'))).hom) wt x
          have hR₁ := hMapRangeSingle
            (fun w' : Λ W.unop => (φ.app (Opposite.op (U_of W.unop w'))).hom) wt x
          have hR₂ := hMapRangeSingle
            (fun w' : Λ W.unop => (ψ.app (Opposite.op (U_of W.unop w'))).hom)
            wt ((φ.app (Opposite.op (U_of W.unop wt))).hom x)
          exact hL.trans (hR₂.symm.trans (congrArg _ hR₁.symm)) }
    let j_star_pre : (Y₂.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Y₁.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      (CategoryTheory.Functor.whiskeringLeft Y₁.Etaleᵒᵖ Y₂.Etaleᵒᵖ AddCommGrpCat.{u}).obj j_v.op
    let wt_id : ∀ (U_et : Y₁.Etale), Λ (j_v.obj U_et) := fun U_et => ⟨U_et.hom, rfl⟩
    let i_U : ∀ (U_et : Y₁.Etale), U_of (j_v.obj U_et) (wt_id U_et) ⟶ U_et := fun U_et =>
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 U_et.left)
        (CategoryTheory.Category.id_comp U_et.hom) trivial
    let c_W : ∀ (W : Y₂.Etale) (wt : Λ W), W ⟶ j_v.obj (U_of W wt) := fun W wt =>
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 W.left)
        ((CategoryTheory.Category.id_comp _).trans wt.2) trivial
    let η_pre : CategoryTheory.Functor.id _ ⟶ j_pre_bang ⋙ j_star_pre :=
      { app := fun P =>
          { app := fun U_et =>
              AddCommGrpCat.ofHom
                ((DFinsupp.singleAddHom (famP P (j_v.obj U_et.unop)) (wt_id U_et.unop)).comp
                  (P.map (i_U U_et.unop).op).hom)
            naturality := fun {U₁ U₂} g => by
              apply AddCommGrpCat.ext
              intro x
              have hR := hLiftSingle
                (fun wt : Λ (j_v.obj U₁.unop) =>
                  (DFinsupp.singleAddHom (famP P (j_v.obj U₂.unop))
                    (pullΛ (j_v.map g.unop) wt)).comp
                    (P.map (mapU (j_v.map g.unop) wt).op).hom)
                (wt_id U₁.unop) ((P.map (i_U U₁.unop).op).hom x)
              have hL_comp : (P.map (i_U U₂.unop).op).hom ((P.map g).hom x) =
                  (P.map (i_U U₂.unop ≫ g.unop).op).hom x :=
                (congrArg (fun k => k.hom x) (P.map_comp g (i_U U₂.unop).op)).symm
              have hR_comp : (P.map (mapU (j_v.map g.unop) (wt_id U₁.unop)).op).hom
                  ((P.map (i_U U₁.unop).op).hom x) =
                  (P.map (mapU (j_v.map g.unop) (wt_id U₁.unop) ≫ i_U U₁.unop).op).hom x :=
                (congrArg (fun k => k.hom x)
                  (P.map_comp (i_U U₁.unop).op
                    (mapU (j_v.map g.unop) (wt_id U₁.unop)).op)).symm
              have hw : pullΛ (j_v.map g.unop) (wt_id U₁.unop) = wt_id U₂.unop :=
                Subtype.ext (CategoryTheory.MorphismProperty.Over.w g.unop)
              have hmap : ∀ (w_a : Λ (j_v.obj U₂.unop)) (h_eq : w_a = wt_id U₂.unop)
                  (m_a : U_of (j_v.obj U₂.unop) w_a ⟶ U₁.unop)
                  (m_b : U_of (j_v.obj U₂.unop) (wt_id U₂.unop) ⟶ U₁.unop),
                  m_a.left = g.unop.left →
                  m_b.left = g.unop.left →
                  DFinsupp.singleAddHom (famP P (j_v.obj U₂.unop))
                      (wt_id U₂.unop) ((P.map m_b.op).hom x) =
                    DFinsupp.singleAddHom (famP P (j_v.obj U₂.unop)) w_a ((P.map m_a.op).hom x) := by
                intro w_a h_eq m_a m_b hma hmb
                subst h_eq
                have hm : m_b = m_a :=
                  CategoryTheory.MorphismProperty.Comma.Hom.ext (hmb.trans hma.symm)
                    (Subsingleton.elim _ _)
                rw [hm]
              exact (congrArg (DFinsupp.singleAddHom (famP P (j_v.obj U₂.unop))
                (wt_id U₂.unop)) hL_comp).trans
                ((hmap _ hw (mapU (j_v.map g.unop) (wt_id U₁.unop) ≫ i_U U₁.unop)
                  (i_U U₂.unop ≫ g.unop)
                  (CategoryTheory.Category.comp_id _) (CategoryTheory.Category.id_comp _)).trans
                  ((congrArg (DFinsupp.singleAddHom (famP P (j_v.obj U₂.unop)) _)
                    hR_comp.symm).trans hR.symm)) }
        naturality := fun {P₁ P₂} φ => by
          apply CategoryTheory.NatTrans.ext
          funext U_et
          apply AddCommGrpCat.ext
          intro x
          have hR := hMapRangeSingle
            (fun wt : Λ (j_v.obj U_et.unop) =>
              (φ.app (Opposite.op (U_of (j_v.obj U_et.unop) wt))).hom)
            (wt_id U_et.unop) ((P₁.map (i_U U_et.unop).op).hom x)
          have hnat := congrArg (fun m => m.hom x) (φ.naturality (i_U U_et.unop).op).symm
          exact (congrArg (DFinsupp.singleAddHom (famP P₂ (j_v.obj U_et.unop))
            (wt_id U_et.unop)) hnat).trans hR.symm }
    let ε_pre : j_star_pre ⋙ j_pre_bang ⟶ CategoryTheory.Functor.id _ :=
      { app := fun Q =>
          { app := fun W =>
              AddCommGrpCat.ofHom
                (DFinsupp.liftAddHom fun wt : Λ W.unop =>
                  (Q.map (c_W W.unop wt).op).hom)
            naturality := fun {W₁ W₂} f_hom => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun wt => AddMonoidHom.ext fun y => ?_
              have hL₁ := hLiftSingle
                (fun w' : Λ W₁.unop =>
                  (DFinsupp.singleAddHom (famP (j_star_pre.obj Q) W₂.unop)
                    (pullΛ f_hom.unop w')).comp
                    (Q.map (j_v.map (mapU f_hom.unop w')).op).hom) wt y
              have hL₂ := hLiftSingle
                (fun w' : Λ W₂.unop => (Q.map (c_W W₂.unop w').op).hom)
                (pullΛ f_hom.unop wt) ((Q.map (j_v.map (mapU f_hom.unop wt)).op).hom y)
              have hR₁ := hLiftSingle
                (fun w' : Λ W₁.unop => (Q.map (c_W W₁.unop w').op).hom) wt y
              have hL_comp : (Q.map (c_W W₂.unop (pullΛ f_hom.unop wt)).op).hom
                  ((Q.map (j_v.map (mapU f_hom.unop wt)).op).hom y) =
                  (Q.map (c_W W₂.unop (pullΛ f_hom.unop wt) ≫
                    j_v.map (mapU f_hom.unop wt)).op).hom y :=
                (congrArg (fun k => k.hom y)
                  (Q.map_comp (j_v.map (mapU f_hom.unop wt)).op
                    (c_W W₂.unop (pullΛ f_hom.unop wt)).op)).symm
              have hR_comp : (Q.map f_hom).hom ((Q.map (c_W W₁.unop wt).op).hom y) =
                  (Q.map (f_hom.unop ≫ c_W W₁.unop wt).op).hom y :=
                (congrArg (fun k => k.hom y) (Q.map_comp (c_W W₁.unop wt).op f_hom)).symm
              have hcomm_c : c_W W₂.unop (pullΛ f_hom.unop wt) ≫ j_v.map (mapU f_hom.unop wt) =
                  f_hom.unop ≫ c_W W₁.unop wt :=
                CategoryTheory.MorphismProperty.Comma.Hom.ext
                  ((CategoryTheory.Category.id_comp _).trans
                    (CategoryTheory.Category.comp_id _).symm)
                  (Subsingleton.elim _ _)
              exact (congrArg _ hL₁).trans
                (hL₂.trans
                  (hL_comp.trans
                    ((congrArg (fun u => (Q.map u.op).hom y) hcomm_c).trans
                      (hR_comp.symm.trans (congrArg (Q.map f_hom).hom hR₁.symm))))) }
        naturality := fun {Q₁ Q₂} ψ => by
          apply CategoryTheory.NatTrans.ext
          funext W
          apply AddCommGrpCat.hom_ext
          refine DFinsupp.addHom_ext' fun wt => AddMonoidHom.ext fun y => ?_
          have hL₁ := hMapRangeSingle
            (fun w' : Λ W.unop => (ψ.app (Opposite.op (j_v.obj (U_of W.unop w')))).hom) wt y
          have hL₂ := hLiftSingle
            (fun w' : Λ W.unop => (Q₂.map (c_W W.unop w').op).hom)
            wt ((ψ.app (Opposite.op (j_v.obj (U_of W.unop wt)))).hom y)
          have hR₁ := hLiftSingle
            (fun w' : Λ W.unop => (Q₁.map (c_W W.unop w').op).hom) wt y
          have hnat := congrArg (fun m => m.hom y) (ψ.naturality (c_W W.unop wt).op).symm
          exact (congrArg _ hL₁).trans (hL₂.trans (hnat.trans (congrArg (ψ.app W).hom hR₁.symm))) }
    let adj_pre : j_pre_bang ⊣ j_star_pre :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit := η_pre
          counit := ε_pre
          left_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext P
            apply CategoryTheory.NatTrans.ext
            funext W
            apply AddCommGrpCat.hom_ext
            refine DFinsupp.addHom_ext' fun wt => AddMonoidHom.ext fun x => ?_
            have h₁ := hMapRangeSingle
              (fun w' : Λ W.unop => ((η_pre.app P).app (Opposite.op (U_of W.unop w'))).hom) wt x
            have h₂ := hLiftSingle
              (fun w' : Λ W.unop => ((j_pre_bang.obj P).map (c_W W.unop w').op).hom)
              wt (((η_pre.app P).app (Opposite.op (U_of W.unop wt))).hom x)
            have h₃ := hLiftSingle
              (fun w'' : Λ (j_v.obj (U_of W.unop wt)) =>
                (DFinsupp.singleAddHom (famP P W.unop) (pullΛ (c_W W.unop wt) w'')).comp
                  (P.map (mapU (c_W W.unop wt) w'').op).hom)
              (wt_id (U_of W.unop wt)) ((P.map (i_U (U_of W.unop wt)).op).hom x)
            have hcomp : (P.map (mapU (c_W W.unop wt) (wt_id (U_of W.unop wt))).op).hom
                ((P.map (i_U (U_of W.unop wt)).op).hom x) =
                (P.map (mapU (c_W W.unop wt) (wt_id (U_of W.unop wt)) ≫
                  i_U (U_of W.unop wt)).op).hom x :=
              (congrArg (fun k => k.hom x)
                (P.map_comp (i_U (U_of W.unop wt)).op
                  (mapU (c_W W.unop wt) (wt_id (U_of W.unop wt))).op)).symm
            have hw : pullΛ (c_W W.unop wt) (wt_id (U_of W.unop wt)) = wt :=
              Subtype.ext (CategoryTheory.Category.id_comp wt.1)
            have hmap : ∀ (w' : Λ W.unop) (h_eq : w' = wt)
                (m : U_of W.unop w' ⟶ U_of W.unop wt),
                m.left = 𝟙 W.unop.left →
                DFinsupp.singleAddHom (famP P W.unop) w' ((P.map m.op).hom x) =
                  DFinsupp.singleAddHom (famP P W.unop) wt x := by
              intro w' h_eq m hm
              subst h_eq
              have hm_id : m = 𝟙 (U_of W.unop w') :=
                CategoryTheory.MorphismProperty.Comma.Hom.ext hm (Subsingleton.elim _ _)
              exact congrArg (DFinsupp.singleAddHom (famP P W.unop) w')
                (congrArg (fun k => k.hom x)
                  ((congrArg (fun u => P.map u.op) hm_id).trans (P.map_id _)))
            exact (congrArg _ h₁).trans
              (h₂.trans
                (h₃.trans
                  ((congrArg (DFinsupp.singleAddHom (famP P W.unop) _) hcomp).trans
                    (hmap _ hw
                      (mapU (c_W W.unop wt) (wt_id (U_of W.unop wt)) ≫ i_U (U_of W.unop wt))
                      (CategoryTheory.Category.id_comp _)))))
          right_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext Q
            apply CategoryTheory.NatTrans.ext
            funext U_et
            apply AddCommGrpCat.ext
            intro y
            have h₁ := hLiftSingle
              (fun wt : Λ (j_v.obj U_et.unop) => (Q.map (c_W (j_v.obj U_et.unop) wt).op).hom)
              (wt_id U_et.unop) ((Q.map (j_v.map (i_U U_et.unop)).op).hom y)
            have hcomp : (Q.map (c_W (j_v.obj U_et.unop) (wt_id U_et.unop)).op).hom
                ((Q.map (j_v.map (i_U U_et.unop)).op).hom y) =
                (Q.map (c_W (j_v.obj U_et.unop) (wt_id U_et.unop) ≫
                  j_v.map (i_U U_et.unop)).op).hom y :=
              (congrArg (fun k => k.hom y)
                (Q.map_comp (j_v.map (i_U U_et.unop)).op
                  (c_W (j_v.obj U_et.unop) (wt_id U_et.unop)).op)).symm
            have hc_id : c_W (j_v.obj U_et.unop) (wt_id U_et.unop) ≫
                j_v.map (i_U U_et.unop) = 𝟙 (j_v.obj U_et.unop) :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
            exact h₁.trans
              (hcomp.trans
                (congrArg (fun k => k.hom y)
                  ((congrArg (fun u => Q.map u.op) hc_id).trans (Q.map_id _)))) }
    have : j_pre_bang.PreservesMonomorphisms := by
      refine CategoryTheory.Functor.PreservesMonomorphisms.mk ?_
      intro P₁ P₂ φ hMono
      have h_inj : ∀ U_et : Y₁.Etale, Function.Injective (φ.app (Opposite.op U_et)).hom :=
        fun U_et =>
          (AddCommGrpCat.mono_iff_injective (φ.app (Opposite.op U_et))).mp
            (inferInstance : CategoryTheory.Mono (φ.app (Opposite.op U_et)))
      have : ∀ W : Y₂.Etaleᵒᵖ, CategoryTheory.Mono ((j_pre_bang.map φ).app W) := fun W => by
        rw [AddCommGrpCat.mono_iff_injective]
        exact (DFinsupp.mapRange_injective
          (fun wt => ⇑(φ.app (Opposite.op (U_of W.unop wt))).hom)
          (fun _ => map_zero _)).mpr
          (fun wt => h_inj (U_of W.unop wt))
      exact CategoryTheory.NatTrans.mono_of_mono_app (j_pre_bang.map φ)
    let j_bang : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf Y₁.smallEtaleTopology AddCommGrpCat.{u} ⋙
        j_pre_bang ⋙
        CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}
    have : j_bang.PreservesMonomorphisms := inferInstance
    let shAdj₂ := CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}
    let adj_bang : j_bang ⊣ res_v :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun F_sh G =>
            (shAdj₂.homEquiv (j_pre_bang.obj F_sh.obj) G).trans
              ((adj_pre.homEquiv F_sh.obj G.obj).trans
                { toFun := fun ψ => ⟨ψ⟩
                  invFun := fun ψ => ψ.hom
                  left_inv := fun _ => rfl
                  right_inv := fun _ => rfl })
          homEquiv_naturality_left_symm := fun {F' F_sh G} f_hom g_hom => by
            change (shAdj₂.homEquiv _ _).symm
                ((adj_pre.homEquiv _ _).symm (f_hom ≫ g_hom).hom) =
              (CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).map
                  (j_pre_bang.map f_hom.hom) ≫
                (shAdj₂.homEquiv _ _).symm ((adj_pre.homEquiv _ _).symm g_hom.hom)
            rw [← shAdj₂.homEquiv_naturality_left_symm]
            exact congrArg (shAdj₂.homEquiv _ _).symm
              (adj_pre.homEquiv_naturality_left_symm f_hom.hom g_hom.hom)
          homEquiv_naturality_right := fun {F_sh G G'} f_hom g_hom =>
            CategoryTheory.Sheaf.hom_ext
              ((congrArg (adj_pre.homEquiv F_sh.obj G'.obj)
                (shAdj₂.homEquiv_naturality_right f_hom g_hom)).trans
                (adj_pre.homEquiv_naturality_right _ g_hom.hom)) }
    have hInj_res : CategoryTheory.Injective (res_v.obj J) :=
      adj_bang.map_injective J hJ_inj
    exact CategoryTheory.Injective.of_iso (e_res.symm.app J) hInj_res

  have hInjZero : ∀ {Y T : AlgebraicGeometry.Scheme.{u}}
      (h : Quiver.Hom Y T)
      (ℐ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective ℐ] (q_deg : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h (q_deg + 1) ℐ) := by
    clear * -
    intro Y T h ℐ _ q_deg
    let P_pre : CategoryTheory.Functor (Opposite T.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback h).op
        (CategoryTheory.Sheaf.cohomologyPresheaf ℐ (q_deg + 1))
    have hPreIdZero : CategoryTheory.CategoryStruct.id P_pre = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext W_op
      apply AddCommGrpCat.ext
      intro x
      have : Subsingleton ↑(P_pre.obj W_op) :=
        CategoryTheory.Abelian.Ext.subsingleton_of_injective _ ℐ q_deg
      exact Subsingleton.elim _ _
    let L_sh := CategoryTheory.presheafToSheaf T.smallEtaleTopology AddCommGrpCat.{u}
    change CategoryTheory.Limits.IsZero (L_sh.obj P_pre)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    rw [← L_sh.map_id, hPreIdZero, L_sh.map_zero]

  have hConnCok : ∀ {Y T : AlgebraicGeometry.Scheme.{u}}
      (h : Quiver.Hom Y T)
      (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q_deg : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h (q_deg + 1) SC.X₂) →
      ∃ (h_zero : CategoryTheory.CategoryStruct.comp
          (weilEtaleHigherDirectImageMap h q_deg SC.g)
          (weilSingDevAlgBCConnHom h SC hSE q_deg) = 0),
        Nonempty (CategoryTheory.Limits.IsColimit
          (CategoryTheory.Limits.CokernelCofork.ofπ
            (weilSingDevAlgBCConnHom h SC hSE q_deg) h_zero)) := by
    clear * - hBCBase
    intro Y T h SC hSE q_deg hZero
    obtain ⟨_, h₂, h₃, _, hEx₂, hEx₃⟩ := (hBCBase.2.2.2 h SC hSE).2 q_deg
    have h_g_zero : (CategoryTheory.ShortComplex.mk
        (weilSingDevAlgBCConnHom h SC hSE q_deg)
        (weilEtaleHigherDirectImageMap h (q_deg + 1) SC.f) h₃).g = 0 :=
      hZero.eq_of_tgt _ 0
    have : CategoryTheory.Epi
        (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap h q_deg SC.g)
          (weilSingDevAlgBCConnHom h SC hSE q_deg) h₂).g :=
      (hEx₃.epi_f_iff).mpr h_g_zero
    exact ⟨h₂, ⟨hEx₂.gIsCokernel⟩⟩

  have hCokerLadder : ∀ {C D : Type _} [CategoryTheory.Category C] [CategoryTheory.Category D]
      [CategoryTheory.Preadditive C] [CategoryTheory.Preadditive D]
      (F_fun : C ⥤ D) [F_fun.Additive] [CategoryTheory.Limits.PreservesFiniteColimits F_fun]
      {X₁ X₂ X₃ : C} (u : X₁ ⟶ X₂) (v : X₂ ⟶ X₃) (huv : u ≫ v = 0)
      (_ : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.CokernelCofork.ofπ v huv))
      {B₁ B₂ B₃ : D} (u_B : B₁ ⟶ B₂) (v_B : B₂ ⟶ B₃) (hB : u_B ≫ v_B = 0)
      (_ : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.CokernelCofork.ofπ v_B hB))
      (m₁ : F_fun.obj X₁ ⟶ B₁) (_ : CategoryTheory.IsIso m₁)
      (m₂ : F_fun.obj X₂ ⟶ B₂) (_ : CategoryTheory.IsIso m₂)
      (m₃ : F_fun.obj X₃ ⟶ B₃),
      F_fun.map u ≫ m₂ = m₁ ≫ u_B →
      F_fun.map v ≫ m₃ = m₂ ≫ v_B →
      CategoryTheory.IsIso m₃ := by
    clear * -
    intro C D _ _ _ _ F_fun _ _ X₁ X₂ X₃ u v huv hcok B₁ B₂ B₃ u_B v_B hB hcok_B
      m₁ hm₁ m₂ hm₂ m₃ hsq₁ hsq₂
    have := hm₁
    have := hm₂
    have huv' : F_fun.map u ≫ F_fun.map v = 0 := by
      rw [← F_fun.map_comp, huv, F_fun.map_zero]
    let hc_map := CategoryTheory.Limits.isColimitCoforkMapOfIsColimit F_fun
      (huv.trans CategoryTheory.Limits.zero_comp.symm) hcok
    let cf_top := CategoryTheory.Limits.CokernelCofork.ofπ (F_fun.map v) huv'
    let hcok_A : CategoryTheory.Limits.IsColimit cf_top :=
      CategoryTheory.Limits.Cofork.IsColimit.mk cf_top
        (fun s => CategoryTheory.Limits.Cofork.IsColimit.desc hc_map s.π
          (s.condition.trans (by
            rw [CategoryTheory.Limits.zero_comp, F_fun.map_zero,
              CategoryTheory.Limits.zero_comp])))
        (fun s => CategoryTheory.Limits.Cofork.IsColimit.π_desc' hc_map s.π _)
        (fun s m hm => CategoryTheory.Limits.Cofork.IsColimit.hom_ext hc_map
          (hm.trans (CategoryTheory.Limits.Cofork.IsColimit.π_desc' hc_map s.π _).symm))
    have huB_inv : u_B ≫ CategoryTheory.inv m₂ = CategoryTheory.inv m₁ ≫ F_fun.map u := by
      refine (CategoryTheory.IsIso.comp_inv_eq m₂).mpr ?_
      rw [CategoryTheory.Category.assoc, hsq₁, ← CategoryTheory.Category.assoc,
        CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
    have huB_zero : u_B ≫ (CategoryTheory.inv m₂ ≫ F_fun.map v) = 0 := by
      rw [← CategoryTheory.Category.assoc, huB_inv, CategoryTheory.Category.assoc,
        huv', CategoryTheory.Limits.comp_zero]
    let m₃_inv : B₃ ⟶ F_fun.obj X₃ :=
      CategoryTheory.Limits.Cofork.IsColimit.desc hcok_B
        (CategoryTheory.inv m₂ ≫ F_fun.map v)
        (huB_zero.trans CategoryTheory.Limits.zero_comp.symm)
    have hvB_inv : v_B ≫ m₃_inv = CategoryTheory.inv m₂ ≫ F_fun.map v :=
      CategoryTheory.Limits.Cofork.IsColimit.π_desc' hcok_B
        (CategoryTheory.inv m₂ ≫ F_fun.map v) _
    refine ⟨⟨m₃_inv, ?_, ?_⟩⟩
    · apply CategoryTheory.Limits.Cofork.IsColimit.hom_ext hcok_A
      change F_fun.map v ≫ (m₃ ≫ m₃_inv) = F_fun.map v ≫ 𝟙 (F_fun.obj X₃)
      rw [← CategoryTheory.Category.assoc, hsq₂, CategoryTheory.Category.assoc, hvB_inv,
        ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    · apply CategoryTheory.Limits.Cofork.IsColimit.hom_ext hcok_B
      change v_B ≫ (m₃_inv ≫ m₃) = v_B ≫ 𝟙 B₃
      rw [← CategoryTheory.Category.assoc, hvB_inv, CategoryTheory.Category.assoc, hsq₂,
        ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]

  have : (weilEtaleSitePullback U.ι).IsContinuous
      S.smallEtaleTopology U.toScheme.smallEtaleTopology := (sys U.ι).hCont
  have : ((weilEtaleSitePullback U.ι).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology U.toScheme.smallEtaleTopology).IsRightAdjoint := (sys U.ι).hAdj
  have : ((weilEtaleSitePullback U.ι).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology U.toScheme.smallEtaleTopology).Additive := (sys U.ι).hAdd_pb
  have : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback U.ι).sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology U.toScheme.smallEtaleTopology) := (sys U.ι).hColim_pb
  have : (weilEtaleSitePullback (f ⁻¹ᵁ U).ι).IsContinuous
      X.smallEtaleTopology (f ⁻¹ᵁ U).toScheme.smallEtaleTopology := (sys (f ⁻¹ᵁ U).ι).hCont
  have : ((weilEtaleSitePullback (f ⁻¹ᵁ U).ι).sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology (f ⁻¹ᵁ U).toScheme.smallEtaleTopology).IsRightAdjoint :=
    (sys (f ⁻¹ᵁ U).ι).hAdj
  have : ((weilEtaleSitePullback (f ⁻¹ᵁ U).ι).sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology (f ⁻¹ᵁ U).toScheme.smallEtaleTopology).Additive :=
    (sys (f ⁻¹ᵁ U).ι).hAdd_pb
  have : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback (f ⁻¹ᵁ U).ι).sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology (f ⁻¹ᵁ U).toScheme.smallEtaleTopology) :=
    (sys (f ⁻¹ᵁ U).ι).hLim_pb
  have : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback (f ⁻¹ᵁ U).ι).sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology (f ⁻¹ᵁ U).toScheme.smallEtaleTopology) :=
    (sys (f ⁻¹ᵁ U).ι).hColim_pb

  let j_U := U.ι
  let j_X := (f ⁻¹ᵁ U).ι
  let f_U := f ∣_ U
  let h_sq := (AlgebraicGeometry.isPullback_morphismRestrict f U).w.symm
  let pb_U := (weilEtaleSitePullback j_U).sheafPullback AddCommGrpCat.{u}
    S.smallEtaleTopology U.toScheme.smallEtaleTopology
  let adj_U := (weilEtaleSitePullback j_U).sheafAdjunctionContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology U.toScheme.smallEtaleTopology
  let pb_jX := (weilEtaleSitePullback j_X).sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology (f ⁻¹ᵁ U).toScheme.smallEtaleTopology

  have hLad : ∀ (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q_deg : ℕ),
      let hSE' : (SC.map pb_jX).ShortExact := hSE.map_of_exact pb_jX
      ∀ {β₁},
        WeilIsSingDevAlgBCBCPush f j_U f_U j_X h_sq SC.X₁ (q_deg + 1) β₁ →
        ∃ β₂ β₃,
          WeilIsSingDevAlgBCBCPush f j_U f_U j_X h_sq SC.X₂ q_deg β₂ ∧
          WeilIsSingDevAlgBCBCPush f j_U f_U j_X h_sq SC.X₃ q_deg β₃ ∧
          (CategoryTheory.CategoryStruct.comp
            (pb_U.map (weilEtaleHigherDirectImageMap f q_deg SC.g))
            ((adj_U.homEquiv _ _).symm β₃) =
           CategoryTheory.CategoryStruct.comp
            ((adj_U.homEquiv _ _).symm β₂)
            (weilEtaleHigherDirectImageMap f_U q_deg ((SC.map pb_jX).g))) ∧
          (CategoryTheory.CategoryStruct.comp
            (pb_U.map (weilSingDevAlgBCConnHom f SC hSE q_deg))
            ((adj_U.homEquiv _ _).symm β₁) =
           CategoryTheory.CategoryStruct.comp
            ((adj_U.homEquiv _ _).symm β₃)
            (weilSingDevAlgBCConnHom f_U (SC.map pb_jX) hSE' q_deg)) := by
    intro SC hSE q_deg hSE' β₁ hβ₁
    let hSqPkg := hBCBase.2.2.1 f j_U f_U j_X h_sq
    obtain ⟨β₂, hβ₂⟩ := (hSqPkg.1 SC.X₂ q_deg).1
    obtain ⟨β₃, hβ₃⟩ := (hSqPkg.1 SC.X₃ q_deg).1
    have hNat_g := hSqPkg.2.1 SC.g q_deg hβ₂ hβ₃
    have hNat_δ := hSqPkg.2.2 SC hSE q_deg hβ₃ hβ₁
    refine ⟨β₂, β₃, hβ₂, hβ₃, ?_, ?_⟩
    · exact (adj_U.homEquiv_naturality_left_symm _ β₃).symm.trans
        ((congrArg (adj_U.homEquiv _ _).symm hNat_g).trans
          (adj_U.homEquiv_naturality_right_symm β₂ _))
    · exact (adj_U.homEquiv_naturality_left_symm _ β₁).symm.trans
        ((congrArg (adj_U.homEquiv _ _).symm hNat_δ).trans
          (adj_U.homEquiv_naturality_right_symm β₃ _))

  have hAllSheaf : ∀ (q_deg : ℕ)
      (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) {β},
      WeilIsSingDevAlgBCBCPush f j_U f_U j_X h_sq ℱ q_deg β →
      CategoryTheory.IsIso ((adj_U.homEquiv _ _).symm β) := by
    intro q_deg
    induction q_deg with
    | zero =>
      intro ℱ β hβ
      exact hDeg0 f U ℱ hβ
    | succ q' ih =>
      intro ℱ β₁ hβ₁
      let ι := CategoryTheory.Injective.ι ℱ
      let π := CategoryTheory.Limits.cokernel.π ι
      let SC := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hSE : SC.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC
            (CategoryTheory.Limits.cokernelIsCokernel ι))
          inferInstance inferInstance
      have : CategoryTheory.Injective SC.X₂ :=
        (inferInstance : CategoryTheory.Injective (CategoryTheory.Injective.under ℱ))
      have : CategoryTheory.Injective ((SC.map pb_jX).X₂) :=
        hSliceInj j_X (inferInstance : AlgebraicGeometry.Etale (f ⁻¹ᵁ U).ι) SC.X₂
      let hSE' : (SC.map pb_jX).ShortExact := hSE.map_of_exact pb_jX
      obtain ⟨h_zero_S, ⟨hcok_S⟩⟩ := hConnCok f SC hSE q' (hInjZero f SC.X₂ q')
      obtain ⟨h_zero_bot, ⟨hcok_bot⟩⟩ :=
        hConnCok f_U (SC.map pb_jX) hSE' q' (hInjZero f_U (SC.map pb_jX).X₂ q')
      obtain ⟨β₂, β₃, hβ₂, hβ₃, hsq₁, hsq₂⟩ := hLad SC hSE q' hβ₁
      exact hCokerLadder pb_U
        (weilEtaleHigherDirectImageMap f q' SC.g)
        (weilSingDevAlgBCConnHom f SC hSE q')
        h_zero_S hcok_S
        (weilEtaleHigherDirectImageMap f_U q' ((SC.map pb_jX).g))
        (weilSingDevAlgBCConnHom f_U (SC.map pb_jX) hSE' q')
        h_zero_bot hcok_bot
        ((adj_U.homEquiv _ _).symm β₂) (ih SC.X₂ hβ₂)
        ((adj_U.homEquiv _ _).symm β₃) (ih SC.X₃ hβ₃)
        ((adj_U.homEquiv _ _).symm β₁)
        hsq₁ hsq₂

  rcases hγ with ⟨β, hβ, rfl⟩
  let F_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj A
  let c_jX := weilEtaleConstPullbackHom j_X
    (weilEtaleIdTerminalIsTerminal.{u} (f ⁻¹ᵁ U).toScheme)
    (weilEtaleIdTerminalIsTerminal.{u} X) A
  have hIso₁ : CategoryTheory.IsIso ((adj_U.homEquiv _ _).symm β) := hAllSheaf q F_X hβ
  have hIso_c : CategoryTheory.IsIso c_jX :=
    (sys j_X).hConstIso
      (weilEtaleIdTerminalIsTerminal.{u} (f ⁻¹ᵁ U).toScheme)
      (weilEtaleIdTerminalIsTerminal.{u} X) A
  let c_inv := @CategoryTheory.inv _ _ _ _ c_jX hIso_c
  have hIso₂ : CategoryTheory.IsIso (weilEtaleHigherDirectImageMap f_U q c_jX) :=
    ⟨⟨weilEtaleHigherDirectImageMap f_U q c_inv,
      ((hBCBase.2.1 f_U q).2.1 c_jX c_inv).symm.trans
        ((congrArg (weilEtaleHigherDirectImageMap f_U q)
          (@CategoryTheory.IsIso.hom_inv_id _ _ _ _ c_jX hIso_c)).trans
          ((hBCBase.2.1 f_U q).1 _)),
      ((hBCBase.2.1 f_U q).2.1 c_inv c_jX).symm.trans
        ((congrArg (weilEtaleHigherDirectImageMap f_U q)
          (@CategoryTheory.IsIso.inv_hom_id _ _ _ _ c_jX hIso_c)).trans
          ((hBCBase.2.1 f_U q).1 _))⟩⟩
  exact Eq.mpr
    (congrArg CategoryTheory.IsIso
      (adj_U.homEquiv_naturality_right_symm β (weilEtaleHigherDirectImageMap f_U q c_jX)))
    (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _
      ((adj_U.homEquiv _ _).symm β)
      (weilEtaleHigherDirectImageMap f_U q c_jX) hIso₁ hIso₂)

theorem weil_qc_algClosure_bc0_sheaf_isIso_of_basis_bijective (S : AlgebraicGeometry.Scheme.{u})
    {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
    (φ : Quiver.Hom 𝒢₁ 𝒢₂)
    (hBasis : ∀ V : S.Etale,
      ∃ (ι : Type u) (U_fam : ι → S.Etale) (u_fam : ∀ i : ι, Quiver.Hom (U_fam i) V),
        CategoryTheory.Sieve.ofArrows U_fam u_fam ∈ S.smallEtaleTopology V ∧
        ∀ i : ι, Function.Bijective ⇑((φ.hom.app (Opposite.op (U_fam i))).hom)) :
    CategoryTheory.IsIso φ :=
by
  let J := S.smallEtaleTopology
  have hNat : ∀ {Y W : S.Etale} (g : Quiver.Hom Y W)
      (x : ↑(𝒢₁.obj.obj (Opposite.op W))),
      ((φ.hom.app (Opposite.op Y)).hom) (((𝒢₁.obj.map (Opposite.op g)).hom) x) =
        ((𝒢₂.obj.map (Opposite.op g)).hom) (((φ.hom.app (Opposite.op W)).hom) x) :=
    fun {_ _} g x => congrArg (fun (m : 𝒢₁.obj.obj _ ⟶ 𝒢₂.obj.obj _) => m.hom x)
      (φ.hom.naturality (Opposite.op g))
  have hMapComp : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      {Y U V : S.Etale} (g : Quiver.Hom Y U) (u : Quiver.Hom U V)
      (z : ↑(𝒢.obj.obj (Opposite.op V))),
      ((𝒢.obj.map (Opposite.op (CategoryTheory.CategoryStruct.comp g u))).hom) z =
        ((𝒢.obj.map (Opposite.op g)).hom) (((𝒢.obj.map (Opposite.op u)).hom) z) :=
    fun 𝒢 {_ _ _} g u z => congrArg (fun (m : 𝒢.obj.obj _ ⟶ 𝒢.obj.obj _) => m.hom z)
      (𝒢.obj.map_comp (Opposite.op u) (Opposite.op g))
  have hSheafArrows : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      {W : S.Etale} {ι : Type u} {U_fam : ι → S.Etale}
      {u_fam : ∀ i : ι, Quiver.Hom (U_fam i) W},
      CategoryTheory.Sieve.ofArrows U_fam u_fam ∈ J W →
      CategoryTheory.Presieve.IsSheafFor
        (((CategoryTheory.sheafForget J).obj 𝒢).obj)
        (CategoryTheory.Presieve.ofArrows U_fam u_fam) :=
    fun 𝒢 {_W _ι U_fam u_fam} hCov =>
      (CategoryTheory.Presieve.isSheafFor_iff_generate
        (CategoryTheory.Presieve.ofArrows U_fam u_fam)).mpr
        (((CategoryTheory.sheafForget J).obj 𝒢).property.isSheafFor
          (CategoryTheory.Sieve.ofArrows U_fam u_fam) hCov)
  have hZeroOfLocZero : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      (W : S.Etale) (ι : Type u) (U_fam : ι → S.Etale)
      (u_fam : ∀ i : ι, Quiver.Hom (U_fam i) W),
      CategoryTheory.Sieve.ofArrows U_fam u_fam ∈ J W →
      ∀ (z : ↑(𝒢.obj.obj (Opposite.op W))),
        (∀ i : ι, ((𝒢.obj.map (Opposite.op (u_fam i))).hom) z = 0) → z = 0 := by
    intro 𝒢 W ι U_fam u_fam hCov z hz
    let P := ((CategoryTheory.sheafForget J).obj 𝒢).obj
    have hSh := hSheafArrows 𝒢 hCov
    let loc_0 : ∀ i : ι, P.obj (Opposite.op (U_fam i)) :=
      fun i => (0 : ↑(𝒢.obj.obj (Opposite.op (U_fam i))))
    have hCompat_0 : CategoryTheory.Presieve.Arrows.Compatible P u_fam loc_0 := by
      intro i j Y g₁ g₂ _hg
      change ((𝒢.obj.map (Opposite.op g₁)).hom) 0 = ((𝒢.obj.map (Opposite.op g₂)).hom) 0
      rw [map_zero, map_zero]
    have hEx := ((CategoryTheory.Presieve.isSheafFor_arrows_iff P u_fam).mp hSh) loc_0 hCompat_0
    exact hEx.unique hz (fun i => map_zero ((𝒢.obj.map (Opposite.op (u_fam i))).hom))
  have hInj : ∀ W : S.Etale,
      Function.Injective ⇑((φ.hom.app (Opposite.op W)).hom) := by
    intro W
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨ι, U_fam, u_fam, hCov, hBij⟩ := hBasis W
    refine hZeroOfLocZero 𝒢₁ W ι U_fam u_fam hCov x (fun i => ?_)
    apply (hBij i).1
    rw [hNat (u_fam i) x, hx, map_zero, map_zero]
  have hSurj : ∀ V : S.Etale,
      Function.Surjective ⇑((φ.hom.app (Opposite.op V)).hom) := by
    intro V y
    obtain ⟨ι, U_fam, u_fam, hCov, hBij⟩ := hBasis V
    let P₁ := ((CategoryTheory.sheafForget J).obj 𝒢₁).obj
    let loc_x : ∀ i : ι, P₁.obj (Opposite.op (U_fam i)) :=
      fun i => Classical.choose ((hBij i).2 (((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y))
    have h_loc_x : ∀ i : ι,
        ((φ.hom.app (Opposite.op (U_fam i))).hom) (loc_x i) =
          ((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y :=
      fun i => Classical.choose_spec ((hBij i).2 (((𝒢₂.obj.map (Opposite.op (u_fam i))).hom) y))
    have hCompat : CategoryTheory.Presieve.Arrows.Compatible P₁ u_fam loc_x := by
      intro i j Y g₁ g₂ hg
      apply hInj Y
      change ((φ.hom.app (Opposite.op Y)).hom) (((𝒢₁.obj.map (Opposite.op g₁)).hom) (loc_x i)) =
        ((φ.hom.app (Opposite.op Y)).hom) (((𝒢₁.obj.map (Opposite.op g₂)).hom) (loc_x j))
      rw [hNat g₁ (loc_x i), h_loc_x i, ← hMapComp 𝒢₂ g₁ (u_fam i) y, hg,
        hMapComp 𝒢₂ g₂ (u_fam j) y, ← h_loc_x j, ← hNat g₂ (loc_x j)]
    obtain ⟨t, ht, -⟩ :=
      ((CategoryTheory.Presieve.isSheafFor_arrows_iff P₁ u_fam).mp (hSheafArrows 𝒢₁ hCov))
        loc_x hCompat
    refine ⟨t, sub_eq_zero.mp ?_⟩
    refine hZeroOfLocZero 𝒢₂ V ι U_fam u_fam hCov
      (((φ.hom.app (Opposite.op V)).hom) t - y) (fun i => ?_)
    have ht_i : ((𝒢₁.obj.map (Opposite.op (u_fam i))).hom) t = loc_x i := ht i
    rw [map_sub, ← hNat (u_fam i) t, ht_i, h_loc_x i, sub_self]
  have : ∀ W_op : Opposite S.Etale, CategoryTheory.IsIso (φ.hom.app W_op) := fun W_op =>
    (CategoryTheory.ConcreteCategory.isIso_iff_bijective
      (φ.hom.app (Opposite.op (Opposite.unop W_op)))).mpr
      ⟨hInj (Opposite.unop W_op), hSurj (Opposite.unop W_op)⟩
  have : CategoryTheory.IsIso ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map φ) :=
    CategoryTheory.NatIso.isIso_of_isIso_app φ.hom
  exact CategoryTheory.isIso_of_reflects_iso φ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u})

theorem weil_qc_algClosure_bc0_iso_of_top_left_scheme_iso (sys : WeilEtaleSitePullbackSys.{u})
    {X₀ Y₀ Y_bar X_std X' : AlgebraicGeometry.Scheme.{u}}
    (g₀ : Quiver.Hom X₀ Y₀)
    (pr_Y : Quiver.Hom Y_bar Y₀)
    (g_std : Quiver.Hom X_std Y_bar)
    (pr_X : Quiver.Hom X_std X₀)
    (g' : Quiver.Hom X' Y_bar)
    (pr_X' : Quiver.Hom X' X₀)
    (hg_std : CategoryTheory.CategoryStruct.comp g_std pr_Y =
      CategoryTheory.CategoryStruct.comp pr_X g₀)
    (hg' : CategoryTheory.CategoryStruct.comp g' pr_Y =
      CategoryTheory.CategoryStruct.comp pr_X' g₀)
    (e_X : CategoryTheory.Iso X' X_std)
    (he_g : CategoryTheory.CategoryStruct.comp e_X.hom g_std = g')
