            (CategoryTheory.Abelian.Ext.mk₀ πM_fib) (Nat.add_zero q) := by
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]

  have hp_z₁ : p_Φ z₁ =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_Φ.mapExtAddHom (C_fib.obj Aℤ) F_fib q) z₁) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_Φ) (Nat.add_zero q) := by
    have h0 := hp_eq z₁
    change p_Φ z₁ =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((pb_Φ.mapExtAddHom (C_fib.obj Aℤ) F_fib q) z₁) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleConstPullbackHom Φ hT₁ hT₂ AM))
        (Nat.add_zero q) at h0
    rw [hπM_align] at h0
    exact h0

  have hMap_z₁ : (pb_Φ.mapExtAddHom (C_fib.obj Aℤ) F_fib q) z₁ =
      (((CategoryTheory.Abelian.Ext.mk₀ (pb_Φ.map (β_fib ≫ ρ₁))).comp
        ((pb_Φ.mapExtAddHom (pb_fib.obj R_W) (pb_fib.obj F_X₀) q) c_fib) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (pb_Φ.map πM_fib)) (Nat.add_zero q)) := by
    rw [hz₁_eq,
      CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb_Φ _ _ (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb_Φ _ _ (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Functor.mapExtAddHom_apply]

  have hMap_cfib :
      (pb_Φ.mapExtAddHom (pb_fib.obj R_W) (pb_fib.obj F_X₀) q) c_fib =
      (CategoryTheory.Abelian.Ext.mk₀ (η_pb.hom.app R_W)).comp
        (c_fib.comp (CategoryTheory.Abelian.Ext.mk₀ (η_pb.inv.app F_X₀)) (Nat.add_zero q))
        (Nat.zero_add q) :=
    hExtCompNatIso pb_fib pb_Φ pb_fib η_pb q R_W F_X₀ c

  have hLeftCollapse :
      r_fib ≫ ιℤ ≫ pb_Φ.map (β_fib ≫ ρ₁) ≫ η_pb.hom.app R_W = ρ₀ := by
    calc
      r_fib ≫ ιℤ ≫ pb_Φ.map (β_fib ≫ ρ₁) ≫ η_pb.hom.app R_W
        = (r_fib ≫ ιℤ ≫ pb_Φ.map β_fib) ≫ pb_Φ.map ρ₁ ≫ η_pb.hom.app R_W := by
            rw [pb_Φ.map_comp]
            simp only [CategoryTheory.Category.assoc]
      _ = ρ₀ := by rw [hLeft_Φ, hRep_l₀]

  have hTerm_eq :
      weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q (p_Φ z₁) =
        weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q z₀ := by
    rw [hz₀]
    change (CategoryTheory.Abelian.Ext.mk₀ r_fib).comp (p_Φ z₁) (Nat.zero_add q) =
      ((CategoryTheory.Abelian.Ext.mk₀ ρ₀).comp c_fib (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_fib) (Nat.add_zero q)
    rw [hp_z₁, hMap_z₁, hMap_cfib,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ r_fib) _ (CategoryTheory.Abelian.Ext.mk₀ πM_Φ)
        (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc r_fib ιℤ,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ (r_fib ≫ ιℤ)) _
        (CategoryTheory.Abelian.Ext.mk₀ (pb_Φ.map πM_fib)) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc (r_fib ≫ ιℤ) (pb_Φ.map (β_fib ≫ ρ₁)),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc
        ((r_fib ≫ ιℤ) ≫ pb_Φ.map (β_fib ≫ ρ₁)) (η_pb.hom.app R_W),
      CategoryTheory.Category.assoc r_fib ιℤ _,
      CategoryTheory.Category.assoc r_fib (ιℤ ≫ _) _,
      CategoryTheory.Category.assoc ιℤ _ _,
      hLeftCollapse,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ρ₀) c_fib
        (CategoryTheory.Abelian.Ext.mk₀ (η_pb.inv.app F_X₀)) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        ((CategoryTheory.Abelian.Ext.mk₀ ρ₀).comp c_fib (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ (η_pb.inv.app F_X₀))
        (CategoryTheory.Abelian.Ext.mk₀ (pb_Φ.map πM_fib)) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (η_pb.inv.app F_X₀) (pb_Φ.map πM_fib),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        ((CategoryTheory.Abelian.Ext.mk₀ ρ₀).comp c_fib (Nat.zero_add q))
        (CategoryTheory.Abelian.Ext.mk₀ (η_pb.inv.app F_X₀ ≫ pb_Φ.map πM_fib))
        (CategoryTheory.Abelian.Ext.mk₀ πM_Φ) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀
        (η_pb.inv.app F_X₀ ≫ pb_Φ.map πM_fib) πM_Φ,
      CategoryTheory.Category.assoc (η_pb.inv.app F_X₀) (pb_Φ.map πM_fib) πM_Φ,
      hConst_M]

  calc
    p_Φ z₁ = (CategoryTheory.Abelian.Ext.mk₀ β_fib).comp
        (weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q (p_Φ z₁)) (Nat.zero_add q) :=
      (hTermCancel (p_Φ z₁)).symm
    _ = (CategoryTheory.Abelian.Ext.mk₀ β_fib).comp
        (weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q z₀) (Nat.zero_add q) := by
      rw [hTerm_eq]
    _ = z₀ := hTermCancel z₀

theorem weil_mid_dev_raw_fiber_specialization_and_frob_pinning (F : Type u) [Finite F] [Field F]
    (d_Z : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z_tilde.hom]
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d_Z Z_tilde.hom]
    (hProj_Ztilde : IsProjectiveOverField F Z_tilde)
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.Flat f₀.left]
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (e_U : CategoryTheory.Iso
      (AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
      U₀.toScheme)
    (heU_eq : e_U.hom ≫ U₀.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F)
        (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))) ≫
        j_aff)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (K_pt : Type u) [Finite K_pt] [Field K_pt] [Algebra F K_pt] [FiniteDimensional F K_pt]
    (ev_pt : Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)) →ₐ[F]
      K_pt)
    (Z_pt : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K_pt)))
    [AlgebraicGeometry.IsProper Z_pt.hom]
    (ι_Zpt : Z_pt.left ⟶ Z_tilde.left)
    (hPb_pt : CategoryTheory.IsPullback ι_Zpt Z_pt.hom f₀.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_pt.toRingHom) ≫ e_U.hom ≫ U₀.ι)) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    let Ω_pt := AlgebraicClosure K_pt
    let S_fib := weilGeomScheme K_pt Z_pt
    let g₀ := f₀.left ∣_ U₀
    let X₀ := (f₀.left ⁻¹ᵁ U₀).toScheme
    ∃ eval_pt : ∀ (q r : ℕ) (B : Type u) [CommRing B] [IsDomain B] [Algebra R₀ B]
        [Module.Finite R₀ B] [Algebra.Etale R₀ B]
        (hπ_B : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom))
        (χ : B →+* Ω_pt),
        χ.comp (algebraMap R₀ B) = (algebraMap K_pt Ω_pt).comp ev_pt.toRingHom →
        letI := hπ_B
        let π_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ U₀.toScheme :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom
        ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.obj
            (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk π_B))) →+
          weilEtaleTorsionH S_fib (ℓ ^ (r + 1)) q,
      (∀ (q r : ℕ) (B : Type u) [CommRing B] [IsDomain B] [Algebra R₀ B]
          [Module.Finite R₀ B] [Algebra.Etale R₀ B]
          (hπ_B : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom))
          (χ : B →+* Ω_pt) (hχ : χ.comp (algebraMap R₀ B) =
            (algebraMap K_pt Ω_pt).comp ev_pt.toRingHom),
        let V_B := AlgebraicGeometry.Spec (CommRingCat.of B)
        let π_B : V_B ⟶ U₀.toScheme :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom
        (∃ A_B : AddCommGrpCat.{u},
          WeilIsEtaleSheafPullback π_B (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r)
            ((CategoryTheory.constantSheaf V_B.smallEtaleTopology AddCommGrpCat.{u}).obj A_B)) →
        Function.Bijective (eval_pt q r B hπ_B χ hχ)) ∧
      (∀ (q r : ℕ) (B₁ B₂ : Type u) [CommRing B₁] [IsDomain B₁] [Algebra R₀ B₁]
          [Module.Finite R₀ B₁] [Algebra.Etale R₀ B₁]
          [CommRing B₂] [IsDomain B₂] [Algebra R₀ B₂]
          [Module.Finite R₀ B₂] [Algebra.Etale R₀ B₂]
          (hπ_B₁ : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom))
          (hπ_B₂ : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom))
          (ι_B : B₁ →ₐ[R₀] B₂)
          (χ₁ : B₁ →+* Ω_pt) (χ₂ : B₂ →+* Ω_pt)
          (hχ₁ : χ₁.comp (algebraMap R₀ B₁) = (algebraMap K_pt Ω_pt).comp ev_pt.toRingHom)
          (hχ₂ : χ₂.comp (algebraMap R₀ B₂) = (algebraMap K_pt Ω_pt).comp ev_pt.toRingHom),
        χ₂.comp ι_B.toRingHom = χ₁ →
        let E_B₁ : U₀.toScheme.Etale :=
          letI := hπ_B₁
          AlgebraicGeometry.Scheme.Etale.mk
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₁)) ≫ e_U.hom)
        let E_B₂ : U₀.toScheme.Etale :=
          letI := hπ_B₂
          AlgebraicGeometry.Scheme.Etale.mk
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₂)) ≫ e_U.hom)
        ∀ (u_ι : Quiver.Hom E_B₂ E_B₁),
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u_ι).left =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B.toRingHom) →
          ∀ s₁ : ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.obj (Opposite.op E_B₁)),
            eval_pt q r B₂ hπ_B₂ χ₂ hχ₂
              (((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.map (Opposite.op u_ι)).hom s₁) =
              eval_pt q r B₁ hπ_B₁ χ₁ hχ₁ s₁) ∧
      (∀ (q r : ℕ) (B : Type u) [CommRing B] [IsDomain B] [Algebra R₀ B]
          [Module.Finite R₀ B] [Algebra.Etale R₀ B]
          (hπ_B : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom))
          (χ : B →+* Ω_pt)
          (hχ : χ.comp (algebraMap R₀ B) = (algebraMap K_pt Ω_pt).comp ev_pt.toRingHom),
        let E_B : U₀.toScheme.Etale :=
          letI := hπ_B
          AlgebraicGeometry.Scheme.Etale.mk
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom)
        ∀ s_up : ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q (r + 1)).obj.obj
            (Opposite.op E_B)),
          eval_pt q r B hπ_B χ hχ
            (((weilMidDevOpenHigherDirectImageMap F f₀ U₀ ℓ q r).hom.app
              (Opposite.op E_B)).hom s_up) =
            weilEtaleTorsionTransition S_fib ℓ (r + 1) q
              (eval_pt q (r + 1) B hπ_B χ hχ s_up)) ∧
      (∀ (q r : ℕ) (B : Type u) [CommRing B] [IsDomain B] [Algebra R₀ B]
          [Module.Finite R₀ B] [Algebra.Etale R₀ B]
          (hπ_B : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom))
          (χ : B →+* Ω_pt)
          (hχ : χ.comp (algebraMap R₀ B) = (algebraMap K_pt Ω_pt).comp ev_pt.toRingHom)
          (σ : B ≃ₐ[R₀] B),
        (∀ b : B, σ.symm b - b ^ Nat.card K_pt ∈ RingHom.ker χ) →
        let E_B : U₀.toScheme.Etale :=
          letI := hπ_B
          AlgebraicGeometry.Scheme.Etale.mk
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom)
        ∀ (u_σ : Quiver.Hom E_B E_B),
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u_σ).left =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) →
          ∀ (f_pt : weilEtaleTorsionH S_fib (ℓ ^ (r + 1)) q →+
              weilEtaleTorsionH S_fib (ℓ ^ (r + 1)) q),
            WeilIsTorsionGeomFrobAction K_pt Z_pt (ℓ ^ (r + 1)) q f_pt →
            ∀ s : ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.obj (Opposite.op E_B)),
              f_pt (eval_pt q r B hπ_B χ hχ
                (((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.map
                  (Opposite.op u_σ)).hom s)) =
                eval_pt q r B hπ_B χ hχ s) ∧
      (∀ (q₁ q₂ r : ℕ) (B : Type u) [CommRing B] [IsDomain B] [Algebra R₀ B]
          [Module.Finite R₀ B] [Algebra.Etale R₀ B]
          (hπ_B : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom))
          (χ : B →+* Ω_pt)
          (hχ : χ.comp (algebraMap R₀ B) = (algebraMap K_pt Ω_pt).comp ev_pt.toRingHom),
        let E_B : U₀.toScheme.Etale :=
          letI := hπ_B
          AlgebraicGeometry.Scheme.Etale.mk
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫ e_U.hom)
        let F_X₀ := weilEtaleTorsionSheaf X₀ (ℓ ^ (r + 1))
        let P_pre : ℕ → CategoryTheory.Functor (Opposite U₀.toScheme.Etale) AddCommGrpCat.{u} :=
          fun q => CategoryTheory.Functor.comp (weilEtaleSitePullback g₀).op
            (CategoryTheory.Sheaf.cohomologyPresheaf F_X₀ q)
        let η_unit : ∀ (q : ℕ) (Y : U₀.toScheme.Etale),
            ↑((P_pre q).obj (Opposite.op Y)) →+
              ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.obj (Opposite.op Y)) :=
          fun q Y =>
            (((CategoryTheory.sheafificationAdjunction U₀.toScheme.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app (P_pre q)).app (Opposite.op Y)).hom
        let T_fib := weilEtaleIdTerminal.{u} S_fib
        let hT_fib := weilEtaleIdTerminalIsTerminal.{u} S_fib
        let hT_X₀ := weilEtaleIdTerminalIsTerminal.{u} X₀
        let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
        ∀ (s₁ : ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q₁ r).obj.obj (Opposite.op E_B)))
          (s₂ : ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q₂ r).obj.obj (Opposite.op E_B))),
          ∃ (Y : U₀.toScheme.Etale) (u : Quiver.Hom Y E_B)
            (h_fib : Quiver.Hom S_fib X₀)
            (d_fib : WeilEtaleSitePullbackData S_fib X₀ h_fib)
            (l_Y : Quiver.Hom T_fib
              ((weilEtaleSitePullback h_fib).obj ((weilEtaleSitePullback g₀).obj Y)))
            (c₁ : ↑((P_pre q₁).obj (Opposite.op Y)))
            (c₂ : ↑((P_pre q₂).obj (Opposite.op Y))),
            η_unit q₁ Y c₁ =
              ((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q₁ r).obj.map (Opposite.op u)).hom s₁ ∧
            η_unit q₂ Y c₂ =
              ((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q₂ r).obj.map (Opposite.op u)).hom s₂ ∧
            (∀ q : ℕ,
              Function.Injective
                (weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
                  (weilEtaleTorsionSheaf S_fib (ℓ ^ (r + 1))) q)) ∧
            (∀ (q : ℕ)
              (s : ↑((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.obj (Opposite.op E_B)))
              (c : ↑((P_pre q).obj (Opposite.op Y))),
              letI := d_fib.hCont
              letI := d_fib.hAdj
              letI := d_fib.hAdd_pb
              letI := d_fib.hLim_pb
              letI := d_fib.hColim_pb
              let pb_fib := (weilEtaleSitePullback h_fib).sheafPullback AddCommGrpCat.{u}
                X₀.smallEtaleTopology S_fib.smallEtaleTopology
              let W_Y := (weilEtaleSitePullback g₀).obj Y
              η_unit q Y c =
                ((weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ q r).obj.map
                  (Opposite.op u)).hom s →
              weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib
                  (weilEtaleTorsionSheaf S_fib (ℓ ^ (r + 1))) q
                  (eval_pt q r B hπ_B χ hχ s) =
                (CategoryTheory.Abelian.Ext.mk₀
                    (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
                  (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero q)
                  (((CategoryTheory.Abelian.Ext.mk₀
                      (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
                    (pb_fib.obj F_X₀) (Nat.zero_add q))
                    ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀ q) c)))) :=
by
  classical
  intro R₀ Ω_pt S_fib g₀ X₀
  let _ := hProj_Ztilde
  let _ := hj_open
  let _ := hU₀_eq

  
  obtain ⟨hSite0, _, _, _, _, _⟩ :=
    weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  obtain ⟨_, hConstPkg, hZeroAnn, _⟩ :=
    weil_outer_bc_const_pullback_and_bockstein_ses.{u}
  have hSys : WeilEtaleSitePullbackSys.{u} := fun {Z₁ Z₂} h => by
    obtain ⟨hc, hr, hLim, hAdd_pb, hAdd_pf⟩ := hSite0 h
    letI := hc
    letI := hr
    let pb_h := (weilEtaleSitePullback h).sheafPullback
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    let adj_h := (weilEtaleSitePullback h).sheafAdjunctionContinuous
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
    have : CategoryTheory.Limits.PreservesColimits pb_h := adj_h.leftAdjoint_preservesColimits
    exact
      { hCont := hc
        hAdj := hr
        hAdd_pb := hAdd_pb
        hAdd_pf := hAdd_pf
        hLim_pb := hLim
        hColim_pb := inferInstance
        hConstIso := fun {_} hT₁ {_} hT₂ A => (hConstPkg h).1 hT₁ hT₂ A }
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
