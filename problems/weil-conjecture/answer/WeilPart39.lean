          ((ℛ r).obj.map (Opposite.op (ξ_hom r Z σ))).hom
            (((ℛ r).obj.map (Opposite.op ((j_of r).map k_Z))).hom t) :=
        (hmap_comp r ((j_of r).map k_Z_σ) (ξ_hom r Y σ) t).symm.trans
          ((congrArg (fun m => ((ℛ r).obj.map (Opposite.op m)).hom t) hk_ξ).trans
            (hmap_comp r (ξ_hom r Z σ) ((j_of r).map k_Z) t))
      exact (hΦ_nat r k_Z_σ ((j_of r).map k_Z_σ) rfl _ y₀).symm.trans
        (congrArg (fun s' => Φ r (twistObj r Z σ) s' y₀) hm')
    have hrhs : Φ r (twistObj r Z σ)
          (((ℛ r).obj.map (Opposite.op (ξ_hom r Z σ))).hom
            (((ℛ r).obj.map (Opposite.op ((j_of r).map p_Z))).hom t_c)) y₀ =
        Φ r (twistObj r T_V σ)
          (((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom t_c) (Y.hom.base y) := by
      have hm' : ((ℛ r).obj.map (Opposite.op (ξ_hom r Z σ))).hom
          (((ℛ r).obj.map (Opposite.op ((j_of r).map p_Z))).hom t_c) =
          ((ℛ r).obj.map (Opposite.op ((j_of r).map p_Z_σ))).hom
            (((ℛ r).obj.map (Opposite.op (ξ_hom r T_V σ))).hom t_c) :=
        (hmap_comp r (ξ_hom r Z σ) ((j_of r).map p_Z) t_c).symm.trans
          ((congrArg (fun m => ((ℛ r).obj.map (Opposite.op m)).hom t_c) hp_ξ.symm).trans
            (hmap_comp r ((j_of r).map p_Z_σ) (ξ_hom r T_V σ) t_c))
      exact (congrArg (fun s' => Φ r (twistObj r Z σ) s' y₀) hm').trans
        (hΦ_nat r p_Z_σ ((j_of r).map p_Z_σ) rfl _ y₀)
    have hmid : Φ r (twistObj r Z σ)
          (((ℛ r).obj.map (Opposite.op (ξ_hom r Z σ))).hom
            (((ℛ r).obj.map (Opposite.op ((j_of r).map k_Z))).hom t)) y₀ =
        Φ r (twistObj r Z σ)
          (((ℛ r).obj.map (Opposite.op (ξ_hom r Z σ))).hom
            (((ℛ r).obj.map (Opposite.op ((j_of r).map p_Z))).hom t_c)) y₀ :=
      congrArg (fun q => Φ r (twistObj r Z σ)
        (((ℛ r).obj.map (Opposite.op (ξ_hom r Z σ))).hom q) y₀) hZ_sec_eq
    have hend : (ρ r σ).val (Φ r T_V t_c (Y.hom.base y)) = (ρ r σ).val c :=
      congrArg (ρ r σ).val
        ((hΦ_norm r u_id_can rfl ((eval_V r).symm c) (Y.hom.base y)).trans
          ((eval_V r).apply_symm_apply c))
    exact hlhs.trans (hmid.trans (hrhs.trans ((hBaseTwist_TV σ t_c (Y.hom.base y)).trans hend)))

  
  let E_ℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  have hℛ_elem_ext : ∀ (r : ℕ) {Z : U.Etale} {I : Type u} {X_cov : I → U.Etale}
      (f_cov : ∀ i : I, X_cov i ⟶ Z),
      CategoryTheory.Sieve.ofArrows X_cov f_cov ∈ U.smallEtaleTopology Z →
      ∀ (s₁ s₂ : ↑((ℛ r).obj.obj (Opposite.op Z))),
        (∀ i : I, ((ℛ r).obj.map (Opposite.op (f_cov i))).hom s₁ =
          ((ℛ r).obj.map (Opposite.op (f_cov i))).hom s₂) →
        s₁ = s₂ := by
    intro r Z I X_cov f_cov hcov s₁ s₂ heq
    let mkZ : ↑((ℛ r).obj.obj (Opposite.op Z)) → (E_ℤ ⟶ (ℛ r).obj.obj (Opposite.op Z)) := fun s =>
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • s
          map_zero' := zero_zsmul s
          map_add' := fun n₁ n₂ => add_zsmul s n₁.down n₂.down }
    have hhom : mkZ s₁ = mkZ s₂ := by
      refine (ℛ r).property.hom_ext_ofArrows f_cov hcov fun i => ?_
      apply AddCommGrpCat.ext; intro n
      change ((ℛ r).obj.map (Opposite.op (f_cov i))).hom (n.down • s₁) =
        ((ℛ r).obj.map (Opposite.op (f_cov i))).hom (n.down • s₂)
      rw [map_zsmul, map_zsmul, heq i]
    simpa [mkZ, one_zsmul] using congrArg (fun u : E_ℤ ⟶ _ => u.hom (ULift.up 1)) hhom

  
