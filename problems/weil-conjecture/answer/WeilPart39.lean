      (hγ_sp r) hγ_galU hγ_diag

    have hpullCongr_rfl :
        CategoryTheory.MorphismProperty.Over.pullbackCongr
          (P := @AlgebraicGeometry.Etale) (Q := ⊤) (rfl : g_diag = g_diag) =
        CategoryTheory.Iso.refl _ := by
      apply CategoryTheory.Iso.ext; apply CategoryTheory.NatTrans.ext; funext W_et
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change (CategoryTheory.Limits.pullback.congrHom rfl rfl).hom = 𝟙 _
      ext <;> simp
    have he_B1_paste :
        CategoryTheory.Iso.trans
          (CategoryTheory.Iso.symm
            (CategoryTheory.MorphismProperty.Over.pullbackComp U_bar.ι pr_D))
          (CategoryTheory.MorphismProperty.Over.pullbackCongr
            (P := @AlgebraicGeometry.Etale) (Q := ⊤) (rfl : g_diag = g_diag)) = e_B1 := by
      rw [hpullCongr_rfl]
      exact CategoryTheory.Iso.trans_refl _
    have hPaste₁' : γ_diag = CategoryTheory.CategoryStruct.comp γ_galD
        (CategoryTheory.CategoryStruct.comp (pf_prD.map (γ_bar r))
          (e_pf1.hom.app (ℛ_Ubar r))) := by
      rw [hPaste₁]
      exact congrArg
        (fun e => CategoryTheory.CategoryStruct.comp γ_galD
          (CategoryTheory.CategoryStruct.comp (pf_prD.map (γ_bar r))
            ((CategoryTheory.Functor.sheafPushforwardContinuousComp' e AddCommGrpCat.{u}
              D₀.left.smallEtaleTopology D_bar.smallEtaleTopology
              U_bar.toScheme.smallEtaleTopology).hom.app (ℛ_Ubar r))))
        he_B1_paste

    
    have hIso_mate_sp : CategoryTheory.IsIso
        ((adj_U₀.homEquiv ℛ_D ℛ_U₀).symm (γ_sp r)) :=
      hAllDegOpen f₀.left U₀ (A_of r) (hγ_sp r)
    have hIso_mate_bar : CategoryTheory.IsIso
        ((adj_Ubar.homEquiv ℛ_Dbar (ℛ_Ubar r)).symm (γ_bar r)) :=
      hAllDegOpen f_bar U_bar (A_of r) (hγ_bar r)
    obtain ⟨hIso_mate_galU, hGammaIntertwine⟩ :=
      hCubeAdjTheorem adj_prD adj_Ubar adj_U₀ adj_prU₀ e_pf1 e_pf2
        γ_galD (γ_bar r) (γ_sp r) γ_galU
        hIso_mate_galD hIso_mate_bar hIso_mate_sp
        (hPaste₁'.symm.trans hPaste₂)

    exact hEtaCokernelIso hPreadd_D₀ hPreadd_Dbar hHasColim_D₀ hHasColim_Dbar
      L_prD (sys pr_D).hAdd_pb (sys pr_D).hColim_pb pf_Ubar
      (γ_sp r) (Θ_U₀ ℛ_U₀) (γ_bar r) (Θ_Ubar (ℛ_Ubar r))
      mate_galD hIso_mate_galD bc₀_U hIso_bc₀_U mate_galU hIso_mate_galU
      hGammaIntertwine

  · 
    intro r
    exact ⟨γ_bar r, Θ_Ubar (ℛ_Ubar r), hγ_bar r, rfl⟩

theorem weil_trait_verdier_centered_chart_and_strict_dvr_colimit (k : Type u) [Field k]
    [IsAlgClosed k]
    (D_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt_D : AlgebraicGeometry.IsIntegral D_bar.left)
    [AlgebraicGeometry.IsProper D_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 D_bar.hom]
    (e_P : D_bar ≅ weilProjectiveSpaceOver k 1)
    (U_bar : D_bar.left.Opens)
    (hU_ne : Nonempty ↥U_bar.toScheme)
    (hCompl_fin : Set.Finite (U_bar : Set D_bar.left)ᶜ)
    (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ D_bar.left)
    (hs_sec : s_bar ≫ D_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_not_U : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)), s_bar.base pt ∉ U_bar)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial k →+* R_bar)
    (t_bar : R_bar)
    (π_cl : R_bar →+* k)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial k)))
    (hRbar_props : p_R Polynomial.X = t_bar ∧
      π_cl.comp p_R = Polynomial.evalRingHom 0 ∧
      φ_R_Ω.comp p_R = algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))) ∧
      Function.Injective φ_R_Ω ∧
      @IsLocalization.Away R_bar _ t_bar (AlgebraicClosure (FractionRing (Polynomial k))) _
        φ_R_Ω.toAlgebra)
    (hLift_Rbar : ∀ {S W₀ : AlgebraicGeometry.Scheme.{u}} (w₀ : W₀ ⟶ S) [AlgebraicGeometry.Etale w₀]
        (g_S : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ S)
        (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀),
      s_tilde ≫ w₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_S →
      ∃ g_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀,
        g_tilde ≫ w₀ = g_S ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_tilde = s_tilde) :
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    ∃ (R_s : Type u) (_ : CommRing R_s) (_ : IsDomain R_s) (_ : IsLocalRing R_s)
      (_ : HenselianLocalRing R_s) (_ : IsDiscreteValuationRing R_s)
      (K_s : Type u) (_ : Field K_s)
      (p_Rs : P →+* R_s)
      (ι_RK : R_s →+* K_s)
      (ι_Rbar : R_s →+* R_bar)
      (ι_KΩ : K_s →+* Ω)
      (t_s : R_s)
      (Δ₀ : P)
      (j_chart : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away Δ₀)) ⟶ D_bar.left)
      (_ : AlgebraicGeometry.IsOpenImmersion j_chart)
      (p_Rs_loc : Localization.Away Δ₀ →+* R_s)
      (p_Ks_loc : Localization.Away (algebraMap P (Localization.Away Δ₀) Polynomial.X) →+* K_s)
      (g_Rs : AlgebraicGeometry.Spec (CommRingCat.of R_s) ⟶ D_bar.left)
      (𝒥 : Type u) (_ : CategoryTheory.SmallCategory 𝒥) (_ : CategoryTheory.IsFiltered 𝒥)
      (B_st B_open : 𝒥 ⥤ CommRingCat.{u})
      (α_st : (CategoryTheory.Functor.const 𝒥).obj (CommRingCat.of (Localization.Away Δ₀)) ⟶ B_st)
      (α_op : (CategoryTheory.Functor.const 𝒥).obj
        (CommRingCat.of (Localization.Away (algebraMap P (Localization.Away Δ₀) Polynomial.X))) ⟶
          B_open)
      (loc_st : B_st ⟶ B_open)
      (ε_st : ∀ j : 𝒥, ↑(B_st.obj j) →+* k)
      (c_st : CategoryTheory.Limits.Cocone B_st) (_ : CategoryTheory.Limits.IsColimit c_st)
      (e_Rs : c_st.pt ≅ CommRingCat.of R_s)
      (c_op : CategoryTheory.Limits.Cocone B_open) (_ : CategoryTheory.Limits.IsColimit c_op)
      (e_Ks : c_op.pt ≅ CommRingCat.of K_s),
      (p_Rs Polynomial.X = t_s ∧
        ι_Rbar.comp p_Rs = p_R ∧
        ι_Rbar t_s = t_bar ∧
        t_s ≠ 0 ∧
        IsLocalRing.maximalIdeal R_s = Ideal.span {t_s} ∧
        RingHom.ker (π_cl.comp ι_Rbar) = IsLocalRing.maximalIdeal R_s ∧
        (π_cl.comp ι_Rbar).comp (p_Rs.comp Polynomial.C) = RingHom.id k ∧
        @IsLocalization.Away R_s _ t_s K_s _ ι_RK.toAlgebra ∧
        φ_R_Ω.comp ι_Rbar = ι_KΩ.comp ι_RK ∧
        p_Rs_loc.comp (algebraMap P (Localization.Away Δ₀)) = p_Rs ∧
        p_Ks_loc.comp (algebraMap (Localization.Away Δ₀)
          (Localization.Away (algebraMap P (Localization.Away Δ₀) Polynomial.X))) =
            ι_RK.comp p_Rs_loc ∧
        g_Rs = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_Rs_loc) ≫ j_chart ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp ι_Rbar)) ≫ g_Rs = s_bar ∧
        Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs).base ⊆
          (U_bar : Set D_bar.left) ∧
        ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away Δ₀))),
          j_chart.base q ∈ U_bar ↔ j_chart.base q ∉ Set.range s_bar.base) ∧
      ((∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂), (B_st.map θ).hom.Etale) ∧
        ∀ j : 𝒥,
          (α_st.app j).hom.Etale ∧
          (loc_st.app j).hom.Etale ∧
          AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (loc_st.app j)) ∧
          CommRingCat.ofHom (algebraMap (Localization.Away Δ₀)
              (Localization.Away (algebraMap P (Localization.Away Δ₀) Polynomial.X))) ≫
            α_op.app j = α_st.app j ≫ loc_st.app j ∧
          (α_st.app j) ≫ (c_st.ι.app j) ≫ e_Rs.hom = CommRingCat.ofHom p_Rs_loc ∧
          (α_op.app j) ≫ (c_op.ι.app j) ≫ e_Ks.hom = CommRingCat.ofHom p_Ks_loc ∧
          (c_st.ι.app j) ≫ e_Rs.hom ≫ CommRingCat.ofHom ι_RK =
            (loc_st.app j) ≫ (c_op.ι.app j) ≫ e_Ks.hom ∧
          (π_cl.comp ι_Rbar).comp ((c_st.ι.app j) ≫ e_Rs.hom).hom = ε_st j ∧
          Set.range (AlgebraicGeometry.Spec.map (loc_st.app j)).base =
            (AlgebraicGeometry.Spec.map (α_st.app j) ≫ j_chart).base ⁻¹'
              (U_bar : Set D_bar.left) ∧
          CategoryTheory.IsIso
            (CategoryTheory.Limits.pullback.snd
              (AlgebraicGeometry.Spec.map (α_st.app j) ≫ j_chart) s_bar)) ∧
      (∀ (W : D_bar.left.Etale)
          (w₀ : ↥((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W).left)
          (pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k))),
        ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W).hom.base w₀ =
          s_bar.base pt_k →
        ∃ (j₀ : 𝒥)
          (u₀ : AlgebraicGeometry.Spec (B_st.obj j₀) ⟶
            ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W).left),
          AlgebraicGeometry.Etale u₀ ∧
          u₀ ≫ ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W).hom =
            AlgebraicGeometry.Spec.map (α_st.app j₀) ≫ j_chart ∧
          u₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ε_st j₀))).base pt_k) = w₀) ∧
      (∀ (B_k : Type u) [CommRing B_k]
          (e_Bk : AlgebraicGeometry.Spec (CommRingCat.of B_k) ⟶ D_bar.left)
          [AlgebraicGeometry.Etale e_Bk]
          (s_Bk : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B_k))
          (ψ_Bk : P →+* B_k),
        s_Bk ≫ e_Bk = s_bar →
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk)) →
        e_Bk ≫ D_bar.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Bk) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        (AlgebraicGeometry.Spec.preimage s_Bk).hom (ψ_Bk Polynomial.X) = 0 →
        ∃ (φ_lift : B_k →+* R_s) (u_unit : R_sˣ),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_lift) ≫ e_Bk = g_Rs ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp ι_Rbar)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_lift) = s_Bk ∧
          φ_lift (ψ_Bk Polynomial.X) = ↑u_unit * t_s) :=
by
  
  have h_pillar1 :
      ∃ (j₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ D_bar.left)
        (_ : AlgebraicGeometry.IsOpenImmersion j₀),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0)) ≫ j₀ = s_bar := by
    classical
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P₁ := weilProjectiveSpaceOver k 1
    let s₁ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P₁.left := s_bar ≫ e_P.hom.left
    have hs₁_sec : s₁ ≫ P₁.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      dsimp [s₁]
      rw [Category.assoc, CategoryTheory.Over.w e_P.hom, hs_sec]
    have hBotPrime : ∀ p : PrimeSpectrum k, p.asIdeal = ⊥ := fun p => by
      refine Ideal.ext fun x => ⟨fun hx => ?_, fun hx => ?_⟩
      · rw [Ideal.mem_bot]
        by_contra hx0
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr
          (mul_inv_cancel₀ hx0 ▸ p.asIdeal.mul_mem_right x⁻¹ hx))
      · rw [Ideal.mem_bot.mp hx]
        exact p.asIdeal.zero_mem
    have hSpecUnique : ∀ p₁ p₂ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)), p₁ = p₂ :=
      fun p₁ p₂ => PrimeSpectrum.ext ((hBotPrime p₁).trans (hBotPrime p₂).symm)
    let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := Classical.arbitrary _
    let x_s : ProjectiveSpectrum 𝒜 := s₁.base pt_k
    have hex_i₀ : ∃ i₀ : Fin 2, MvPolynomial.X i₀ ∉ x_s.asHomogeneousIdeal := by
      by_contra h_all
      push Not at h_all
      apply x_s.not_irrelevant_le
      intro f hf
      rw [HomogeneousIdeal.mem_irrelevant_iff] at hf
      have hsum := DirectSum.sum_support_decompose 𝒜 f
      rw [← hsum]
      refine x_s.asHomogeneousIdeal.toIdeal.sum_mem fun n hn => ?_
      by_cases hn0 : n = 0
      · subst hn0
        have h0 : ((DirectSum.decompose 𝒜 f) 0 : MvPolynomial (Fin 2) k) = 0 := hf
        rw [h0]
        exact x_s.asHomogeneousIdeal.toIdeal.zero_mem
      · let g : MvPolynomial (Fin 2) k := ((DirectSum.decompose 𝒜 f) n : MvPolynomial (Fin 2) k)
        have hg_hom : g.IsHomogeneous n :=
          (MvPolynomial.mem_homogeneousSubmodule n g).mp ((DirectSum.decompose 𝒜 f) n).2
        change g ∈ x_s.asHomogeneousIdeal.toIdeal
        rw [MvPolynomial.as_sum g]
        refine x_s.asHomogeneousIdeal.toIdeal.sum_mem fun d hd => ?_
        have hd_ne : g.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hd0 : d ≠ 0 := by
          intro h0
          subst h0
          apply hn0
          simpa using (hg_hom hd_ne).symm
        have hex_var : ∃ i : Fin 2, d i ≠ 0 := by
          by_contra hzero
          push Not at hzero
          exact hd0 (Finsupp.ext hzero)
        obtain ⟨i, hi_ne⟩ := hex_var
        have hd_ge : 1 ≤ d i := Nat.one_le_iff_ne_zero.mpr hi_ne
        have hd_split : d = (d - Finsupp.single i 1) + Finsupp.single i 1 := by
          ext j
          by_cases hj : j = i
          · subst hj; simp; omega
          · simp [Finsupp.single_eq_of_ne hj]
        have hmon : MvPolynomial.monomial d (g.coeff d) =
            MvPolynomial.monomial (d - Finsupp.single i 1) (g.coeff d) * MvPolynomial.X i := by
          rw [MvPolynomial.X, MvPolynomial.monomial_mul, mul_one, ← hd_split]
        rw [hmon]
        exact x_s.asHomogeneousIdeal.toIdeal.mul_mem_left _ (h_all i)
    obtain ⟨i₀, hXi₀⟩ := hex_i₀
    let i₁ : Fin 2 := if i₀ = 0 then 1 else 0
    have hi₁_ne : i₁ ≠ i₀ := by fin_cases i₀ <;> decide
    have hdeg_i₀ : MvPolynomial.X i₀ ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i₀)
    have hdeg_i₁ : MvPolynomial.X i₁ ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i₁)
    let R_away := HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀)
    let φ₀ : k →+* R_away :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X i₀))).comp
        (algebraMap k ↥(𝒜 0))
    let t_away : R_away := HomogeneousLocalization.mk
      ⟨1, ⟨MvPolynomial.X i₁, hdeg_i₁⟩, ⟨MvPolynomial.X i₀, hdeg_i₀⟩,
        Submonoid.mem_powers (MvPolynomial.X i₀)⟩
    let toAway : Polynomial k →+* R_away := Polynomial.eval₂RingHom φ₀ t_away
    let dehom : MvPolynomial (Fin 2) k →+* Polynomial k :=
      MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i₀ then 1 else Polynomial.X)
    have hdehom_Xi₀ : IsUnit (dehom (MvPolynomial.X i₀)) := by
      simp [dehom]
    let dehom_loc : Localization.Away (MvPolynomial.X i₀ : MvPolynomial (Fin 2) k) →+* Polynomial k :=
      IsLocalization.Away.lift (MvPolynomial.X i₀ : MvPolynomial (Fin 2) k) (g := dehom) hdehom_Xi₀
    let valHom : R_away →+* Localization.Away (MvPolynomial.X i₀) :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let fromAway : R_away →+* Polynomial k := dehom_loc.comp valHom
    have h_left_inv : fromAway.comp toAway = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun c => ?_
        have htoC : toAway (Polynomial.C c) = φ₀ c := by simp [toAway]
        change dehom_loc (valHom (toAway (Polynomial.C c))) = Polynomial.C c
        rw [htoC]
        have hval0 : valHom (φ₀ c) =
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away (MvPolynomial.X i₀))
              (MvPolynomial.C c) := by
          change (HomogeneousLocalization.mk ⟨0, algebraMap k ↥(𝒜 0) c, 1, one_mem _⟩).val = _
          rw [HomogeneousLocalization.val_mk]
          rfl
        rw [hval0, IsLocalization.Away.lift_eq (S := Localization.Away (MvPolynomial.X i₀))
          (MvPolynomial.X i₀) hdehom_Xi₀]
        simp [dehom]
      · have htoX : toAway Polynomial.X = t_away := by simp [toAway]
        change dehom_loc (valHom (toAway Polynomial.X)) = Polynomial.X
        rw [htoX]
        have hvalt : valHom t_away =
            IsLocalization.mk' (Localization.Away (MvPolynomial.X i₀ : MvPolynomial (Fin 2) k))
              (MvPolynomial.X i₁ : MvPolynomial (Fin 2) k)
              ⟨MvPolynomial.X i₀, Submonoid.mem_powers _⟩ := by
          change t_away.val = _
          dsimp [t_away]
          exact congrFun (congrFun (@Localization.mk_eq_mk' (MvPolynomial (Fin 2) k) _
            (Submonoid.powers (MvPolynomial.X i₀))) (MvPolynomial.X i₁))
            ⟨MvPolynomial.X i₀, Submonoid.mem_powers _⟩
        have hspec : valHom t_away *
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away (MvPolynomial.X i₀))
              (MvPolynomial.X i₀) =
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away (MvPolynomial.X i₀))
              (MvPolynomial.X i₁) := by
          rw [hvalt]
          exact IsLocalization.mk'_spec _ (MvPolynomial.X i₁)
            ⟨MvPolynomial.X i₀, Submonoid.mem_powers _⟩
        have hmap := congrArg dehom_loc hspec
        rw [map_mul, IsLocalization.Away.lift_eq (S := Localization.Away (MvPolynomial.X i₀))
          (MvPolynomial.X i₀) hdehom_Xi₀,
          IsLocalization.Away.lift_eq (S := Localization.Away (MvPolynomial.X i₀))
            (MvPolynomial.X i₀) hdehom_Xi₀] at hmap
        have hd0 : dehom (MvPolynomial.X i₀) = 1 := by simp [dehom]
        have hd1 : dehom (MvPolynomial.X i₁) = Polynomial.X := by simp [dehom, hi₁_ne]
        rw [hd0, hd1, mul_one] at hmap
        exact hmap
    have h_right_inv : ∀ z : R_away, toAway (fromAway z) = z := by
      intro z
      apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X i₀))
      refine Quotient.inductionOn' z fun w => ?_
      change valHom (toAway (dehom_loc (HomogeneousLocalization.mk w).val)) =
        (HomogeneousLocalization.mk w).val
      obtain ⟨m, hm⟩ := w.den_mem
      have hden_eq : (w.den : MvPolynomial (Fin 2) k) = MvPolynomial.X i₀ ^ m := hm.symm
      have hdeg_eq : w.deg = m := by
        have h1 : (MvPolynomial.X i₀ ^ m : MvPolynomial (Fin 2) k).IsHomogeneous w.deg := by
          rw [← hden_eq]
          exact (MvPolynomial.mem_homogeneousSubmodule w.deg _).mp w.den.2
        have h2 : (MvPolynomial.X i₀ ^ m : MvPolynomial (Fin 2) k).IsHomogeneous m := by
          simpa using (MvPolynomial.isHomogeneous_X k i₀).pow m
        have hmon_pow : (MvPolynomial.X i₀ ^ m : MvPolynomial (Fin 2) k) =
            MvPolynomial.monomial (Finsupp.single i₀ m) 1 := by
          rw [MvPolynomial.X_pow_eq_monomial]
        have hcoeff_ne : (MvPolynomial.X i₀ ^ m : MvPolynomial (Fin 2) k).coeff
            (Finsupp.single i₀ m) ≠ 0 := by
          rw [hmon_pow, MvPolynomial.coeff_monomial, if_pos rfl]
          exact one_ne_zero
        exact (h1 hcoeff_ne).symm.trans (h2 hcoeff_ne)
      let f : MvPolynomial (Fin 2) k := w.num.1
      have hf_hom : f.IsHomogeneous m := by
        rw [← hdeg_eq]
        exact (MvPolynomial.mem_homogeneousSubmodule w.deg f).mp w.num.2
      have hval_w : (HomogeneousLocalization.mk w).val =
          IsLocalization.mk' (Localization.Away (MvPolynomial.X i₀)) f
            ⟨MvPolynomial.X i₀ ^ m, Submonoid.pow_mem _ (Submonoid.mem_powers _) m⟩ := by
        rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk']
        congr 1
        exact Subtype.ext hden_eq
      have hdehom_w : dehom_loc (HomogeneousLocalization.mk w).val = dehom f := by
        have hspec : (HomogeneousLocalization.mk w).val *
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away (MvPolynomial.X i₀))
              (MvPolynomial.X i₀ ^ m) =
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away (MvPolynomial.X i₀)) f := by
          rw [hval_w]
          exact IsLocalization.mk'_spec _ f
            ⟨MvPolynomial.X i₀ ^ m, Submonoid.pow_mem _ (Submonoid.mem_powers _) m⟩
        have hmap := congrArg dehom_loc hspec
        rw [map_mul, IsLocalization.Away.lift_eq (S := Localization.Away (MvPolynomial.X i₀))
          (MvPolynomial.X i₀) hdehom_Xi₀,
          IsLocalization.Away.lift_eq (S := Localization.Away (MvPolynomial.X i₀))
            (MvPolynomial.X i₀) hdehom_Xi₀] at hmap
        have hdpow : dehom (MvPolynomial.X i₀ ^ m) = 1 := by simp [dehom]
        rw [hdpow, mul_one] at hmap
        exact hmap
      rw [hdehom_w, hval_w]
      let Ψ : MvPolynomial (Fin 2) k →+* Localization.Away (MvPolynomial.X i₀) :=
        (valHom.comp toAway).comp dehom
      change Ψ f = _
      have hΨ_C : ∀ c : k, Ψ (MvPolynomial.C c) =
          algebraMap (MvPolynomial (Fin 2) k) (Localization.Away (MvPolynomial.X i₀))
            (MvPolynomial.C c) := fun c => by
        have hdc : dehom (MvPolynomial.C c) = Polynomial.C c := by simp [dehom]
        have htc : toAway (Polynomial.C c) = φ₀ c := by simp [toAway]
        change valHom (toAway (dehom (MvPolynomial.C c))) = _
        rw [hdc, htc]
        change (HomogeneousLocalization.mk ⟨0, algebraMap k ↥(𝒜 0) c, 1, one_mem _⟩).val = _
        rw [HomogeneousLocalization.val_mk]
        rfl
      have hΨ_i₀ : Ψ (MvPolynomial.X i₀) = 1 := by simp [Ψ, dehom]
      let X₀ : MvPolynomial (Fin 2) k := MvPolynomial.X i₀
      let X₁ : MvPolynomial (Fin 2) k := MvPolynomial.X i₁
      have hΨ_i₁ : Ψ X₁ =
          IsLocalization.mk' (Localization.Away X₀) X₁ ⟨X₀, Submonoid.mem_powers X₀⟩ := by
        have h1 : dehom X₁ = Polynomial.X := by simp [X₁, dehom, hi₁_ne]
        have h2 : toAway Polynomial.X = t_away := by simp [toAway]
        change valHom (toAway (dehom X₁)) = _
        rw [h1, h2]
        change t_away.val = _
        dsimp [t_away]
        exact congrFun (congrFun (@Localization.mk_eq_mk' (MvPolynomial (Fin 2) k) _
          (Submonoid.powers X₀)) X₁) ⟨X₀, Submonoid.mem_powers X₀⟩
      apply IsLocalization.eq_mk'_iff_mul_eq.mpr
      let g_supp := f.support
      have hf_sum : f = ∑ d ∈ g_supp, MvPolynomial.monomial d (f.coeff d) := MvPolynomial.as_sum f
      have h_lhs : Ψ f * algebraMap _ (Localization.Away X₀) (X₀ ^ m) =
          ∑ d ∈ g_supp, Ψ (MvPolynomial.monomial d (f.coeff d)) *
            algebraMap _ (Localization.Away X₀) (X₀ ^ m) := by
        nth_rw 1 [hf_sum]
        rw [map_sum, Finset.sum_mul]
      have h_rhs : algebraMap _ (Localization.Away X₀) f =
          ∑ d ∈ g_supp, algebraMap _ (Localization.Away X₀)
            (MvPolynomial.monomial d (f.coeff d)) := by
        nth_rw 1 [hf_sum]
        rw [map_sum]
      rw [h_lhs, h_rhs]
      refine Finset.sum_congr rfl fun d hd => ?_
      have hd_deg : d i₀ + d i₁ = m := by
        have hw : (Finsupp.weight 1) d = m := hf_hom (MvPolynomial.mem_support_iff.mp hd)
        have htot : d 0 + d 1 = m := by
          rw [← hw, Finsupp.weight_apply]
          exact ((Finsupp.sum_fintype d (fun i c => c • (1 : Fin 2 → ℕ) i)
            (fun _ => zero_smul ℕ _)).trans (by simp [Fin.sum_univ_two])).symm
        fin_cases i₀
        · simpa [i₁] using htot
        · simpa [i₁, add_comm] using htot
      have hmon_fac : MvPolynomial.monomial d (f.coeff d) =
          MvPolynomial.C (f.coeff d) * X₀ ^ (d i₀) * X₁ ^ (d i₁) := by
        dsimp [X₀, X₁]
        have hd_eq : d = 0 + Finsupp.single i₀ (d i₀) + Finsupp.single i₁ (d i₁) := by
          ext j
          fin_cases i₀ <;> fin_cases j <;> simp [i₁]
        nth_rw 1 [hd_eq]
        rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial, MvPolynomial.C_apply,
          MvPolynomial.monomial_mul, MvPolynomial.monomial_mul]
        simp
      rw [hmon_fac, map_mul, map_mul, map_pow, map_pow, hΨ_C, hΨ_i₀, hΨ_i₁, one_pow, mul_one,
        ← hd_deg, pow_add, map_mul, map_mul, map_mul, map_pow, map_pow]
      have hcancel : (IsLocalization.mk' (Localization.Away X₀)
          X₁ ⟨X₀, Submonoid.mem_powers X₀⟩ *
          algebraMap _ _ X₀) = algebraMap _ _ X₁ :=
        IsLocalization.mk'_spec _ X₁ ⟨X₀, Submonoid.mem_powers X₀⟩
      calc
        algebraMap _ (Localization.Away X₀) (MvPolynomial.C (f.coeff d)) *
            IsLocalization.mk' _ X₁ ⟨X₀, Submonoid.mem_powers X₀⟩ ^ d i₁ *
            (algebraMap _ _ X₀ ^ d i₀ * algebraMap _ _ X₀ ^ d i₁)
          = algebraMap _ _ (MvPolynomial.C (f.coeff d)) *
              algebraMap _ _ X₀ ^ d i₀ *
              (IsLocalization.mk' _ X₁ ⟨X₀, Submonoid.mem_powers X₀⟩ *
                algebraMap _ _ X₀) ^ d i₁ := by ring
        _ = algebraMap _ _ (MvPolynomial.C (f.coeff d)) *
              algebraMap _ _ X₀ ^ d i₀ *
              algebraMap _ _ (X₁ ^ d i₁) := by rw [hcancel, map_pow]
    let e_poly : Polynomial k ≃+* R_away :=
      { toAway with
        invFun := fromAway
        left_inv := fun p => RingHom.congr_fun h_left_inv p
        right_inv := h_right_inv }
    let e_cat : CommRingCat.of (Polynomial k) ≅ CommRingCat.of R_away :=
      e_poly.toCommRingCatIso
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map e_cat.inv) :=
      ⟨⟨AlgebraicGeometry.Spec.map e_cat.hom,
        by rw [← AlgebraicGeometry.Spec.map_comp, e_cat.hom_inv_id, AlgebraicGeometry.Spec.map_id],
        by rw [← AlgebraicGeometry.Spec.map_comp, e_cat.inv_hom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
    let ι_away := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X i₀) hdeg_i₀ zero_lt_one
    have _ : AlgebraicGeometry.IsOpenImmersion ι_away := inferInstance
    let ι_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P₁.left :=
      AlgebraicGeometry.Spec.map e_cat.inv ≫ ι_away
    have hOpen_aff : AlgebraicGeometry.IsOpenImmersion ι_aff :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        (AlgebraicGeometry.Spec.map e_cat.inv) ι_away inferInstance inferInstance
    have he_cat_hom : e_cat.hom = CommRingCat.ofHom toAway := rfl
    have hBase_aff : ι_aff ≫ P₁.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      dsimp [ι_aff, ι_away, P₁, weilProjectiveSpaceOver]
      rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜 _ _ _),
        AlgebraicGeometry.Proj.awayι_toSpecZero, ← Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      have h1 : CommRingCat.ofHom (algebraMap k ↥(𝒜 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X i₀))) = CommRingCat.ofHom φ₀ := rfl
      rw [← Category.assoc, h1]
      have h2 : CommRingCat.ofHom Polynomial.C ≫ e_cat.hom = CommRingCat.ofHom φ₀ := by
        rw [he_cat_hom, ← CommRingCat.ofHom_comp]
        congr 1
        ext c
        simp [toAway]
      rw [← h2, Category.assoc, e_cat.hom_inv_id, Category.comp_id]
    have hs₁_range : Set.range s₁.base ⊆ Set.range ι_aff.base := by
      rintro _ ⟨pt, rfl⟩
      rw [hSpecUnique pt pt_k]
      have hx_mem : x_s ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i₀) :=
        (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X i₀) x_s).mpr hXi₀
      rw [← AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X i₀) hdeg_i₀ zero_lt_one] at hx_mem
      obtain ⟨q_away, hq_away⟩ := hx_mem
      refine ⟨(AlgebraicGeometry.Spec.map e_cat.hom).base q_away, ?_⟩
      change (AlgebraicGeometry.Spec.map e_cat.hom ≫ AlgebraicGeometry.Spec.map e_cat.inv ≫
        ι_away).base q_away = x_s
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, e_cat.inv_hom_id,
        AlgebraicGeometry.Spec.map_id, Category.id_comp]
      exact hq_away
    let s_aff := AlgebraicGeometry.IsOpenImmersion.lift ι_aff s₁ hs₁_range
    have hs_aff_fac : s_aff ≫ ι_aff = s₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_aff s₁ hs₁_range
    let ψ_s : Polynomial k →+* k := (AlgebraicGeometry.Spec.preimage s_aff).hom
    have hψ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) = s_aff :=
      AlgebraicGeometry.Spec.map_preimage s_aff
    have hψ_C : ψ_s.comp Polynomial.C = RingHom.id k := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_s.comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id k)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hψ_map, ← hBase_aff,
          ← Category.assoc, hs_aff_fac, hs₁_sec, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective h1)
    let c₀ : k := ψ_s Polynomial.X
    let shift : Polynomial k →+* Polynomial k :=
      Polynomial.eval₂RingHom Polynomial.C (Polynomial.X - Polynomial.C c₀)
    let shift_inv : Polynomial k →+* Polynomial k :=
      Polynomial.eval₂RingHom Polynomial.C (Polynomial.X + Polynomial.C c₀)
    have hshift_id1 : shift.comp shift_inv = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [shift, shift_inv]
      · simp [shift, shift_inv]
    have hshift_id2 : shift_inv.comp shift = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [shift, shift_inv]
      · simp [shift, shift_inv]
    let e_shift : Polynomial k ≃+* Polynomial k :=
      { shift with
        invFun := shift_inv
        left_inv := fun p => RingHom.congr_fun hshift_id2 p
        right_inv := fun p => RingHom.congr_fun hshift_id1 p }
    let e_shift_cat : CommRingCat.of (Polynomial k) ≅ CommRingCat.of (Polynomial k) :=
      e_shift.toCommRingCatIso
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map e_shift_cat.inv) :=
      ⟨⟨AlgebraicGeometry.Spec.map e_shift_cat.hom,
        by rw [← AlgebraicGeometry.Spec.map_comp, e_shift_cat.hom_inv_id,
          AlgebraicGeometry.Spec.map_id],
        by rw [← AlgebraicGeometry.Spec.map_comp, e_shift_cat.inv_hom_id,
          AlgebraicGeometry.Spec.map_id]⟩⟩
    have _ : CategoryTheory.IsIso e_P.inv.left :=
      ⟨⟨e_P.hom.left,
        by rw [← CategoryTheory.Over.comp_left, e_P.inv_hom_id, CategoryTheory.Over.id_left],
        by rw [← CategoryTheory.Over.comp_left, e_P.hom_inv_id, CategoryTheory.Over.id_left]⟩⟩
    have hψ_shift : ψ_s.comp shift = Polynomial.evalRingHom 0 := by
      apply Polynomial.ringHom_ext'
      · ext c
        have hc := RingHom.congr_fun hψ_C c
        simpa [shift] using hc
      · have hc := RingHom.congr_fun hψ_C c₀
        simp only [RingHom.comp_apply, RingHom.id_apply] at hc
        simp [shift, c₀, hc]
    let j₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ D_bar.left :=
      AlgebraicGeometry.Spec.map e_shift_cat.inv ≫ ι_aff ≫ e_P.inv.left
    have hj₀_open : AlgebraicGeometry.IsOpenImmersion j₀ :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion) _ _
        inferInstance (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
          ι_aff e_P.inv.left hOpen_aff inferInstance)
    refine ⟨j₀, hj₀_open, ?_⟩
    dsimp [j₀]
    have he_shift_inv : e_shift_cat.inv = CommRingCat.ofHom shift_inv := rfl
    rw [← hψ_shift, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc,
      ← Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom shift)),
      he_shift_inv, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hshift_id1,
      CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id, Category.id_comp,
      hψ_map, ← Category.assoc, hs_aff_fac]
    dsimp [s₁]
    rw [Category.assoc, ← CategoryTheory.Over.comp_left, e_P.hom_inv_id,
      CategoryTheory.Over.id_left, Category.comp_id]

  obtain ⟨j₀, hj₀_open, hs_j₀⟩ := h_pillar1
  have _ : AlgebraicGeometry.IsOpenImmersion j₀ := hj₀_open
  have _ : AlgebraicGeometry.IsIntegral D_bar.left := hInt_D

  
  have h_pillar2 :
      ∃ (Δ₀ : Polynomial k),
        Polynomial.eval 0 Δ₀ ≠ 0 ∧
        let P := Polynomial k
        let R₀ := Localization.Away Δ₀
        let x₀ := algebraMap P R₀ Polynomial.X
        let j_chart := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R₀)) ≫ j₀
        (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀)),
          j_chart.base q ∈ U_bar ↔ j_chart.base q ∉ Set.range s_bar.base) ∧
        (∀ (B B_op : CommRingCat.{u})
            (α : CommRingCat.of R₀ ⟶ B)
            (loc : B ⟶ B_op)
            (ε : ↑B →+* k),
          @IsLocalization.Away ↑B _ (α.hom x₀) ↑B_op _ loc.hom.toAlgebra →
          ε.comp (α.hom.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 →
          RingHom.ker ε = Ideal.span {α.hom x₀} →
          Set.range (AlgebraicGeometry.Spec.map loc).base =
            (AlgebraicGeometry.Spec.map α ≫ j_chart).base ⁻¹' (U_bar : Set D_bar.left) ∧
          CategoryTheory.IsIso
            (CategoryTheory.Limits.pullback.snd
              (AlgebraicGeometry.Spec.map α ≫ j_chart) s_bar)) := by
    classical
    let D := D_bar.left
    let P := Polynomial k
    have hBotPrime : ∀ p : PrimeSpectrum k, p.asIdeal = ⊥ := fun p => by
      refine Ideal.ext fun x => ⟨fun hx => ?_, fun hx => ?_⟩
      · rw [Ideal.mem_bot]
        by_contra hx0
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr
          (mul_inv_cancel₀ hx0 ▸ p.asIdeal.mul_mem_right x⁻¹ hx))
      · rw [Ideal.mem_bot.mp hx]
        exact p.asIdeal.zero_mem
    have hSpecUnique : ∀ p₁ p₂ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)), p₁ = p₂ :=
      fun p₁ p₂ => PrimeSpectrum.ext ((hBotPrime p₁).trans (hBotPrime p₂).symm)
    let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := Classical.arbitrary _
    have hbot_pr_P : (⊥ : Ideal P).IsPrime :=
      ⟨bot_ne_top, fun {x y} hxy => by simpa only [Ideal.mem_bot] using mul_eq_zero.mp hxy⟩
    let η_P : ↥(AlgebraicGeometry.Spec (CommRingCat.of P)) := ⟨⊥, hbot_pr_P⟩

    have hη_in_U : j₀.base η_P ∈ U_bar := by
      have hIrr : IrreducibleSpace ↥D := AlgebraicGeometry.irreducibleSpace_of_isIntegral D
      obtain ⟨u₀⟩ := hU_ne
      have hu₀_mem : U_bar.ι.base u₀ ∈ (U_bar : Set D) := by
        have h1 : U_bar.ι.base u₀ ∈ (U_bar.ι.opensRange : Set D) := ⟨u₀, rfl⟩
        rwa [U_bar.opensRange_ι] at h1
      obtain ⟨_, ⟨_, ⟨⟨q₁, rfl⟩, hq₁_U⟩⟩⟩ :=
        hIrr.isPreirreducible_univ (Set.range j₀.base) (U_bar : Set D)
          j₀.isOpenEmbedding.isOpen_range U_bar.isOpen
          ⟨j₀.base η_P, trivial, ⟨η_P, rfl⟩⟩ ⟨U_bar.ι.base u₀, trivial, hu₀_mem⟩
      let V_P : Set (PrimeSpectrum P) := j₀.base ⁻¹' (U_bar : Set D)
      have hVP_open : IsOpen V_P := U_bar.isOpen.preimage j₀.base.hom.continuous
      obtain ⟨S, hS⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus V_Pᶜ).mp hVP_open.isClosed_compl
      by_contra hη_not
      let η_P' : PrimeSpectrum P := η_P
      let q₁' : PrimeSpectrum P := q₁
      have hη_mem : η_P' ∈ PrimeSpectrum.zeroLocus S := by
        rw [← hS]
        exact hη_not
      rw [PrimeSpectrum.mem_zeroLocus] at hη_mem
      have hq₁_compl : q₁' ∈ V_Pᶜ := by
        rw [hS, PrimeSpectrum.mem_zeroLocus]
        intro f hf
        have hf0 : f ∈ (⊥ : Ideal P) := hη_mem hf
        rw [Ideal.mem_bot] at hf0
        rw [hf0]
        exact q₁'.asIdeal.zero_mem
      exact hq₁_compl hq₁_U

    let m_pt : k → ↥(AlgebraicGeometry.Spec (CommRingCat.of P)) :=
      fun a => (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))).base pt_k
    have hm_ideal : ∀ a : k, ((m_pt a : PrimeSpectrum P)).asIdeal =
        Ideal.span {Polynomial.X - Polynomial.C a} := by
      intro a
      change Ideal.comap (Polynomial.evalRingHom a) pt_k.asIdeal = _
      rw [hBotPrime pt_k, ← RingHom.ker_eq_comap_bot]
      ext f
      rw [RingHom.mem_ker, Polynomial.coe_evalRingHom, ← Polynomial.IsRoot.def,
        ← Polynomial.dvd_iff_isRoot, Ideal.mem_span_singleton]
    have hm_inj : Function.Injective m_pt := by
      intro a₁ a₂ h
      have hmem : Polynomial.X - Polynomial.C a₁ ∈ ((m_pt a₂ : PrimeSpectrum P)).asIdeal := by
        rw [← h, hm_ideal a₁]
        exact Ideal.subset_span rfl
      rw [hm_ideal a₂, Ideal.mem_span_singleton, Polynomial.dvd_iff_isRoot,
        Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at hmem
      exact (sub_eq_zero.mp hmem).symm
    have hSpecClass : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of P)),
        p = η_P ∨ ∃ b : k, p = m_pt b := by
      intro p
      let p' : PrimeSpectrum P := p
      by_cases hp_bot : p'.asIdeal = ⊥
      · left; exact PrimeSpectrum.ext hp_bot
      · right
        let g : P := Submodule.IsPrincipal.generator p'.asIdeal
        have hp_span : p'.asIdeal = Ideal.span {g} :=
          (Submodule.IsPrincipal.span_singleton_generator p'.asIdeal).symm
        have hg_ne : g ≠ 0 := by
          intro hg0; apply hp_bot; rw [hp_span, hg0, Ideal.span_singleton_eq_bot]
        have hspan_pr : (Ideal.span {g}).IsPrime := hp_span ▸ p'.isPrime
        have hg_irr : Irreducible g := ((Ideal.span_singleton_prime hg_ne).mp hspan_pr).irreducible
        have hg_deg : g.degree = 1 := IsAlgClosed.degree_eq_one_of_irreducible k hg_irr
        have hg_eq := Polynomial.eq_X_add_C_of_degree_eq_one hg_deg
        let c : k := g.leadingCoeff
        have hc : c ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg_ne
        let b : k := -g.coeff 0 * c⁻¹
        refine ⟨b, PrimeSpectrum.ext ?_⟩
        change p'.asIdeal = ((m_pt b : PrimeSpectrum P)).asIdeal
        rw [hp_span, hm_ideal b]
        have hg_fac : g = (Polynomial.X - Polynomial.C b) * Polynomial.C c := by
          rw [hg_eq]
          dsimp [b, c]
          have hcb : -g.coeff 0 * g.leadingCoeff⁻¹ * g.leadingCoeff = -g.coeff 0 := by
            rw [mul_assoc, inv_mul_cancel₀ hc, mul_one]
          rw [sub_mul, ← Polynomial.C_mul, hcb, Polynomial.C_neg, sub_neg_eq_add,
            mul_comm Polynomial.X]
        rw [hg_fac]
        exact Ideal.span_singleton_mul_right_unit ((isUnit_iff_ne_zero.mpr hc).map Polynomial.C) _

    have hj₀_inj : Function.Injective j₀.base := j₀.isOpenEmbedding.injective
    have hS_fin : Set.Finite ({a : k | j₀.base (m_pt a) ∈ (U_bar : Set D)ᶜ} \ {0}) :=
      (hCompl_fin.preimage (hj₀_inj.comp hm_inj).injOn).sdiff
    let S_bad : Finset k := hS_fin.toFinset
    let Δ₀ : P := ∏ a ∈ S_bad, (Polynomial.X - Polynomial.C a)
    have hΔ₀ : Polynomial.eval 0 Δ₀ ≠ 0 := by
      rw [Polynomial.eval_prod, Finset.prod_ne_zero_iff]
      intro a ha
      have ha_mem : a ∈ {a : k | j₀.base (m_pt a) ∈ (U_bar : Set D)ᶜ} \ {0} :=
        hS_fin.mem_toFinset.mp ha
      have ha_ne : a ≠ 0 := ha_mem.2
      rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, zero_sub]
      exact neg_ne_zero.mpr ha_ne

    let R₀ := Localization.Away Δ₀
    let x₀ : R₀ := algebraMap P R₀ Polynomial.X
    let j_chart := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R₀)) ≫ j₀
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R₀))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization Δ₀
    have _ : AlgebraicGeometry.IsOpenImmersion j_chart := inferInstance

    have hs_m0 : j₀.base (m_pt 0) = s_bar.base pt_k := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0)) ≫
        j₀).base pt_k = s_bar.base pt_k
      rw [hs_j₀]
    have hs_range : Set.range s_bar.base = {s_bar.base pt_k} := by
      ext z; constructor
      · rintro ⟨pt, rfl⟩; rw [hSpecUnique pt pt_k]; rfl
      · rintro rfl; exact ⟨pt_k, rfl⟩

    have hj_compl : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀)),
        j_chart.base q ∈ U_bar ↔ j_chart.base q ∉ Set.range s_bar.base := by
      intro q
      constructor
      · intro hqU ⟨pt, hpt⟩
        rw [← hpt] at hqU
        exact hs_not_U pt hqU
      · intro hq_not_s
        let p := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R₀))).base q
        have hjp : j_chart.base q = j₀.base p := rfl
        have hΔ_not_p : Δ₀ ∉ (p : PrimeSpectrum P).asIdeal := by
          intro hmem
          have hmem_q : algebraMap P R₀ Δ₀ ∈ (q : PrimeSpectrum R₀).asIdeal := hmem
          exact (q : PrimeSpectrum R₀).isPrime.ne_top
            ((q : PrimeSpectrum R₀).asIdeal.eq_top_of_isUnit_mem hmem_q
              (IsLocalization.Away.algebraMap_isUnit Δ₀))
        rcases hSpecClass p with hp_eq | ⟨b, hp_eq⟩
        · rw [hjp, hp_eq]
          exact hη_in_U
        · by_cases hb0 : b = 0
          · subst hb0
            exfalso
            apply hq_not_s
            rw [hjp, hp_eq, hs_m0, hs_range, Set.mem_singleton_iff]
          · rw [hjp, hp_eq]
            by_contra hnotU
            have hb_bad : b ∈ S_bad := hS_fin.mem_toFinset.mpr ⟨hnotU, hb0⟩
            have hdvd : Polynomial.X - Polynomial.C b ∣ Δ₀ := Finset.dvd_prod_of_mem _ hb_bad
            apply hΔ_not_p
            rw [hp_eq, hm_ideal b, Ideal.mem_span_singleton]
            exact hdvd

    have hΔ₀_unit : IsUnit ((Polynomial.evalRingHom 0) Δ₀) := isUnit_iff_ne_zero.mpr hΔ₀
    let eval₀_loc : R₀ →+* k :=
      IsLocalization.Away.lift Δ₀ (g := Polynomial.evalRingHom 0) hΔ₀_unit
    have heval₀_comp : eval₀_loc.comp (algebraMap P R₀) = Polynomial.evalRingHom 0 :=
      RingHom.ext fun f => IsLocalization.Away.lift_eq (S := R₀) Δ₀ hΔ₀_unit f
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom eval₀_loc)
    have hs₀_chart : s₀ ≫ j_chart = s_bar := by
      dsimp [s₀, j_chart]
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        heval₀_comp, hs_j₀]

    refine ⟨Δ₀, hΔ₀, hj_compl, ?_⟩
    intro B B_op α loc ε hLocB hε_comp hε_ker
    have hε_α : ε.comp α.hom = eval₀_loc := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ₀)
      rw [RingHom.comp_assoc, hε_comp, heval₀_comp]
    have hε_surj : Function.Surjective ε := fun c =>
      ⟨α.hom (algebraMap P R₀ (Polynomial.C c)), by
        have h1 := RingHom.congr_fun hε_comp (Polynomial.C c)
        simpa using h1⟩
    have hε_max : (RingHom.ker ε).IsMaximal := RingHom.ker_isMaximal_of_surjective ε hε_surj
    have hj_chart_inj : Function.Injective j_chart.base := j_chart.isOpenEmbedding.injective

    refine ⟨?_, ?_⟩
    · let _ : Algebra ↑B ↑B_op := loc.hom.toAlgebra
      have hrange_loc : Set.range (AlgebraicGeometry.Spec.map loc).base =
          (PrimeSpectrum.basicOpen (α.hom x₀) : Set (PrimeSpectrum ↑B)) :=
        @PrimeSpectrum.localization_away_comap_range ↑B _ ↑B_op _ _ (α.hom x₀) hLocB
      ext p
      let p' : PrimeSpectrum ↑B := p
      have hmem_loc : p ∈ Set.range (AlgebraicGeometry.Spec.map loc).base ↔
          α.hom x₀ ∉ p'.asIdeal := by
        change p' ∈ Set.range (AlgebraicGeometry.Spec.map loc).base ↔ _
        rw [hrange_loc]
        rfl
      rw [hmem_loc]
      change α.hom x₀ ∉ p'.asIdeal ↔ j_chart.base ((AlgebraicGeometry.Spec.map α).base p) ∈ U_bar
      rw [hj_compl ((AlgebraicGeometry.Spec.map α).base p)]
      refine not_congr ⟨fun hx_mem => ?_, fun hs_mem => ?_⟩
      · have hker_le : RingHom.ker ε ≤ p'.asIdeal := by
          rw [hε_ker, Ideal.span_singleton_le_iff_mem]
          exact hx_mem
        have hker_eq : RingHom.ker ε = p'.asIdeal := hε_max.eq_of_le p'.isPrime.ne_top hker_le
        have hq_eq : (AlgebraicGeometry.Spec.map α).base p = s₀.base pt_k := by
          apply PrimeSpectrum.ext
          change Ideal.comap α.hom p'.asIdeal = Ideal.comap eval₀_loc pt_k.asIdeal
          rw [← hker_eq, hBotPrime pt_k, ← RingHom.ker_eq_comap_bot, RingHom.comap_ker, hε_α]
        rw [hs_range, Set.mem_singleton_iff, hq_eq, ← hs₀_chart]
        rfl
      · rw [hs_range, Set.mem_singleton_iff, ← hs₀_chart] at hs_mem
        have hq_eq : (AlgebraicGeometry.Spec.map α).base p = s₀.base pt_k :=
          hj_chart_inj hs_mem
        have hid_eq : Ideal.comap α.hom p'.asIdeal = RingHom.ker eval₀_loc := by
          change (((AlgebraicGeometry.Spec.map α).base p : PrimeSpectrum R₀)).asIdeal = _
          rw [hq_eq]
          change Ideal.comap eval₀_loc pt_k.asIdeal = _
          rw [hBotPrime pt_k, RingHom.ker_eq_comap_bot]
        have hx₀_ker : x₀ ∈ RingHom.ker eval₀_loc := by
          rw [RingHom.mem_ker]
          have h1 := RingHom.congr_fun heval₀_comp Polynomial.X
          rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X] at h1
          exact h1
        rw [← hid_eq] at hx₀_ker
        exact hx₀_ker
    · let g_B := AlgebraicGeometry.Spec.map α ≫ j_chart
      let Q := CategoryTheory.Limits.pullback g_B s_bar
      let f₁ := CategoryTheory.Limits.pullback.fst g_B s_bar
      let f₂ := CategoryTheory.Limits.pullback.snd g_B s_bar
      let ε_hom : B ⟶ CommRingCat.of k := CommRingCat.ofHom ε
      have hσ_comm : AlgebraicGeometry.Spec.map ε_hom ≫ g_B =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ≫ s_bar := by
        rw [Category.id_comp]
        dsimp [g_B]
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hαε : α ≫ ε_hom = CommRingCat.ofHom eval₀_loc :=
          CommRingCat.hom_ext hε_α
        rw [hαε]
        exact hs₀_chart
      let σ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Q :=
        CategoryTheory.Limits.pullback.lift (AlgebraicGeometry.Spec.map ε_hom)
          (𝟙 _) hσ_comm
      refine ⟨⟨σ, ?_, CategoryTheory.Limits.pullback.lift_snd _ _ _⟩⟩
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
        symm
        have hmono_eq : f₁ ≫ AlgebraicGeometry.Spec.map α = f₂ ≫ s₀ := by
          apply (CategoryTheory.cancel_mono j_chart).mp
          calc
            (f₁ ≫ AlgebraicGeometry.Spec.map α) ≫ j_chart = f₁ ≫ g_B := Category.assoc _ _ _
            _ = f₂ ≫ s_bar := CategoryTheory.Limits.pullback.condition
            _ = f₂ ≫ (s₀ ≫ j_chart) := by rw [hs₀_chart]
            _ = (f₂ ≫ s₀) ≫ j_chart := (Category.assoc _ _ _).symm
        let adj := AlgebraicGeometry.ΓSpec.adjunction
        apply (adj.homEquiv Q (Opposite.op B)).symm.injective
        let φ₁_op := (adj.homEquiv Q (Opposite.op B)).symm f₁
        let φ₂_op := (adj.homEquiv Q (Opposite.op (CommRingCat.of k))).symm f₂
        have hnat₁ : (adj.homEquiv Q (Opposite.op (CommRingCat.of R₀))).symm
            (f₁ ≫ AlgebraicGeometry.Spec.map α) = φ₁_op ≫ α.op := by
          simpa [φ₁_op] using (adj.homEquiv_naturality_right_symm f₁ α.op)
        have hnat₂ : (adj.homEquiv Q (Opposite.op (CommRingCat.of R₀))).symm
            (f₂ ≫ s₀) = φ₂_op ≫ (CommRingCat.ofHom eval₀_loc).op := by
          simpa [φ₂_op, s₀] using
            (adj.homEquiv_naturality_right_symm f₂ (CommRingCat.ofHom eval₀_loc).op)
        have hnat₃ : (adj.homEquiv Q (Opposite.op B)).symm
            (f₂ ≫ AlgebraicGeometry.Spec.map ε_hom) =
            φ₂_op ≫ ε_hom.op := by
          simpa [φ₂_op] using (adj.homEquiv_naturality_right_symm f₂ ε_hom.op)
        rw [hnat₃]
        change φ₁_op = φ₂_op ≫ ε_hom.op
        have hφ_R₀ : α ≫ φ₁_op.unop = CommRingCat.ofHom eval₀_loc ≫ φ₂_op.unop := by
          have h_op : φ₁_op ≫ α.op = φ₂_op ≫ (CommRingCat.ofHom eval₀_loc).op := by
            rw [← hnat₁, ← hnat₂, hmono_eq]
          exact Quiver.Hom.op_inj h_op
        apply Quiver.Hom.unop_inj
        apply CommRingCat.hom_ext
        refine RingHom.ext fun b => ?_
        let r_b : R₀ := algebraMap P R₀ (Polynomial.C (ε b))
        have hb_ker : b - α.hom r_b ∈ RingHom.ker ε := by
          rw [RingHom.mem_ker, map_sub]
          have h1 := RingHom.congr_fun hε_comp (Polynomial.C (ε b))
          rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_evalRingHom,
            Polynomial.eval_C] at h1
          dsimp [r_b]
          rw [h1, sub_self]
        rw [hε_ker, Ideal.mem_span_singleton] at hb_ker
        obtain ⟨w, hw⟩ := hb_ker
        have hb_eq : b = α.hom r_b + α.hom x₀ * w := eq_add_of_sub_eq' hw
        have hx₀_zero : φ₁_op.unop.hom (α.hom x₀) = 0 := by
          have h1 : (α ≫ φ₁_op.unop).hom x₀ = (CommRingCat.ofHom eval₀_loc ≫ φ₂_op.unop).hom x₀ :=
            congrArg (fun f => f.hom x₀) hφ_R₀
          have hev0 : eval₀_loc x₀ = 0 := by
            have h2 := RingHom.congr_fun heval₀_comp Polynomial.X
            rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X] at h2
            exact h2
          change φ₁_op.unop.hom (α.hom x₀) = φ₂_op.unop.hom (eval₀_loc x₀) at h1
          rw [hev0, map_zero] at h1
          exact h1
        have hrb_eq : φ₁_op.unop.hom (α.hom r_b) = φ₂_op.unop.hom (ε b) := by
          have h1 : (α ≫ φ₁_op.unop).hom r_b = (CommRingCat.ofHom eval₀_loc ≫ φ₂_op.unop).hom r_b :=
            congrArg (fun f => f.hom r_b) hφ_R₀
          have hevb : eval₀_loc r_b = ε b := by
            have h2 := RingHom.congr_fun heval₀_comp (Polynomial.C (ε b))
            rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C] at h2
            exact h2
          change φ₁_op.unop.hom (α.hom r_b) = φ₂_op.unop.hom (eval₀_loc r_b) at h1
          rwa [hevb] at h1
        have hgoal : φ₁_op.unop.hom b = φ₂_op.unop.hom (ε b) := by
          nth_rw 1 [hb_eq]
          rw [map_add, map_mul, hx₀_zero, zero_mul, add_zero, hrb_eq]
        exact hgoal
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, Category.comp_id,
          Category.id_comp]

  obtain ⟨Δ₀, hΔ₀, hj_chart_compl, hClean_iso⟩ := h_pillar2
  let P := Polynomial k
  let Ω := AlgebraicClosure (FractionRing P)
  let R₀ := Localization.Away Δ₀
  let x₀ : R₀ := algebraMap P R₀ Polynomial.X
  let j_chart := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R₀)) ≫ j₀
  have _ : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P R₀))) :=
    AlgebraicGeometry.IsOpenImmersion.of_isLocalization Δ₀
  have hj_chart_open : AlgebraicGeometry.IsOpenImmersion j_chart := inferInstance
  have hR₀_et : (algebraMap P R₀).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway Δ₀)
  have hΔ₀_unit : IsUnit ((Polynomial.evalRingHom 0) Δ₀) := isUnit_iff_ne_zero.mpr hΔ₀
  let eval₀_loc : R₀ →+* k := IsLocalization.Away.lift Δ₀ hΔ₀_unit
  have heval₀_comp : eval₀_loc.comp (algebraMap P R₀) = Polynomial.evalRingHom 0 :=
    RingHom.ext fun f => IsLocalization.Away.lift_eq (S := R₀) Δ₀ hΔ₀_unit f
  have hs₀_chart : AlgebraicGeometry.Spec.map (CommRingCat.ofHom eval₀_loc) ≫ j_chart = s_bar := by
    dsimp [j_chart]
    rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      heval₀_comp, hs_j₀]

  have hBotPrime : ∀ p : PrimeSpectrum k, p.asIdeal = ⊥ := fun p => by
    refine Ideal.ext fun x => ⟨fun hx => ?_, fun hx => ?_⟩
    · rw [Ideal.mem_bot]
      by_contra hx0
      exact p.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr
        (mul_inv_cancel₀ hx0 ▸ p.asIdeal.mul_mem_right x⁻¹ hx))
    · rw [Ideal.mem_bot.mp hx]
      exact p.asIdeal.zero_mem

  
  have h_pillar3 :
      ∀ (E₀ : Type u) [CommRing E₀]
        (f₀ : Polynomial k →+* E₀) (_ : f₀.Etale)
        (q₀ : Ideal E₀) [q₀.IsPrime]
        (_ : Ideal.comap f₀ q₀ = RingHom.ker (Polynomial.evalRingHom 0)),
        ((∃ ε₀ : E₀ →+* k, ε₀.comp f₀ = Polynomial.evalRingHom 0 ∧ RingHom.ker ε₀ = q₀) ∧
          (∀ ε₁ ε₂ : E₀ →+* k,
            ε₁.comp f₀ = Polynomial.evalRingHom 0 → RingHom.ker ε₁ = q₀ →
            ε₂.comp f₀ = Polynomial.evalRingHom 0 → RingHom.ker ε₂ = q₀ → ε₁ = ε₂)) ∧
        (∀ (ε₀ : E₀ →+* k),
          ε₀.comp f₀ = Polynomial.evalRingHom 0 → RingHom.ker ε₀ = q₀ →
          ∃ g : E₀, ε₀ g ≠ 0 ∧ IsDomain (Localization.Away g) ∧
            ∀ (ε_E : Localization.Away g →+* k),
              ε_E.comp (algebraMap E₀ (Localization.Away g)) = ε₀ →
              RingHom.ker ε_E =
                Ideal.span {algebraMap E₀ (Localization.Away g) (f₀ Polynomial.X)}) ∧
        (∀ [IsDomain E₀] (ψ₀ : Polynomial k →+* E₀),
          ψ₀.Etale →
          Ideal.comap ψ₀ q₀ = RingHom.ker (Polynomial.evalRingHom 0) →
          ∃ b s : E₀, b ∉ q₀ ∧ s ∉ q₀ ∧ s * ψ₀ Polynomial.X = b * f₀ Polynomial.X) := by
    intro E₀ _ f₀ hf₀ q₀ _ hq₀
    classical
    have hm0_span : RingHom.ker (Polynomial.evalRingHom (0 : k)) = Ideal.span {Polynomial.X} := by
      ext p
      rw [RingHom.mem_ker, Polynomial.coe_evalRingHom, ← Polynomial.IsRoot.def,
        ← Polynomial.dvd_iff_isRoot, Ideal.mem_span_singleton]
      simp
    have hm0_max : (RingHom.ker (Polynomial.evalRingHom (0 : k))).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective (Polynomial.evalRingHom (0 : k)) fun c =>
        ⟨Polynomial.C c, by rw [Polynomial.coe_evalRingHom, Polynomial.eval_C]⟩

    have hEqZeroLoc : ∀ {A : Type u} [CommRing A] (M : Submonoid A) (S : Type u)
        [CommRing S] [Algebra A S] [IsLocalization M S] (a : A),
        algebraMap A S a = 0 ↔ ∃ t : M, t.1 * a = 0 := by
      intro A _ M S _ _ _ a
      rw [← map_zero (algebraMap A S), IsLocalization.eq_iff_exists M S]
      simp only [mul_zero]

    have hEtaleStalk : ∀ (R : Type u) [CommRing R] (f : P →+* R), f.Etale →
        IsNoetherianRing R ∧
        (∀ (r : P) (x : R), r ≠ 0 → f r * x = 0 → x = 0) ∧
        (∀ (q : Ideal R) [q.IsPrime],
          let p := Ideal.comap f q
          Ideal.map (Localization.localRingHom p q f rfl)
            (IsLocalRing.maximalIdeal (Localization.AtPrime p)) =
            IsLocalRing.maximalIdeal (Localization.AtPrime q)) := by
      intro R _ f hf_et
      let _ : Algebra P R := f.toAlgebra
      have _ : Algebra.Etale P R := RingHom.etale_algebraMap.mp hf_et
      have _ : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing P R
      have _ : Module.IsTorsionFree P R := Module.Flat.isTorsionFree
      refine ⟨inferInstance, fun r x hr hrx => ?_, fun q _ => ?_⟩
      · have hsmul : r • x = 0 := hrx
        exact (smul_eq_zero.mp hsmul).resolve_left hr
      · intro p
        let R_p := Localization.AtPrime p
        let R_q := Localization.AtPrime q
        let φ : R_p →+* R_q := Localization.localRingHom p q (algebraMap P R) rfl
        let _ : Algebra R_p R_q := φ.toAlgebra
        have _ : IsScalarTower P R_p R_q := IsScalarTower.of_algebraMap_eq fun x => by
          change algebraMap P R_q x = φ (algebraMap P R_p x)
          rw [Localization.localRingHom_to_map]
          exact IsScalarTower.algebraMap_apply P R R_q x
        have _ : Algebra.FormallyUnramified P R_q := Algebra.FormallyUnramified.comp P R R_q
        have _ : Algebra.FormallyUnramified R_p R_q :=
          Algebra.FormallyUnramified.localization_base p.primeCompl
        have _ : Algebra.EssFiniteType P R := inferInstance
        have _ : Algebra.EssFiniteType P R_q := Algebra.EssFiniteType.comp P R R_q
        have _ : Algebra.EssFiniteType R_p R_q := Algebra.EssFiniteType.of_comp P R_p R_q
        have _ : IsLocalHom (algebraMap R_p R_q) := Localization.isLocalHom_localRingHom p q _ rfl
        exact Algebra.FormallyUnramified.map_maximalIdeal

    refine ⟨?_, ?_, ?_⟩
    · refine ⟨?_, ?_⟩
      · let _ : Algebra P E₀ := f₀.toAlgebra
        have _ : Algebra.Etale P E₀ := RingHom.etale_algebraMap.mp hf₀
        let _ : Algebra P k := (Polynomial.evalRingHom (0 : k)).toAlgebra
        let Q₀ := TensorProduct P k E₀
        have _ : Algebra.Etale k Q₀ := Algebra.Etale.baseChange P E₀ k
        obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinModAi⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod k Q₀).mp inferInstance
        let _ : Finite I := hFinI
        let _ : ∀ i, Field (Ai i) := hFieldAi
        let _ : ∀ i, Algebra k (Ai i) := hAlgAi
        have _ : ∀ i, Module.Finite k (Ai i) := fun i => (hFinModAi i).1
        have _ : Module.Finite k Q₀ := Module.Finite.equiv e_prod.symm.toLinearEquiv
        have hInt_Q₀ : Algebra.IsIntegral k Q₀ := Algebra.IsIntegral.of_finite k Q₀
        let K_quot := E₀ ⧸ q₀
        have _ : IsDomain K_quot := Ideal.Quotient.isDomain q₀
        let φ_k : k →+* K_quot := (Ideal.Quotient.mk q₀).comp (f₀.comp Polynomial.C)
        let _ : Algebra k K_quot := φ_k.toAlgebra
        have _ : IsScalarTower P k K_quot := IsScalarTower.of_algebraMap_eq fun p => by
          have hroot : p - Polynomial.C (Polynomial.eval 0 p) ∈
              RingHom.ker (Polynomial.evalRingHom (0 : k)) := by
            rw [RingHom.mem_ker, map_sub, Polynomial.coe_evalRingHom, Polynomial.eval_C, sub_self]
          rw [← hq₀] at hroot
          have hmem : f₀ p - f₀ (Polynomial.C (Polynomial.eval 0 p)) ∈ q₀ := by
            rw [← map_sub]; exact hroot
          exact Ideal.Quotient.eq.mpr hmem
        let g_alg : E₀ →ₐ[P] K_quot :=
          { Ideal.Quotient.mk q₀ with commutes' := fun _ => rfl }
        let Ψ_alg : Q₀ →ₐ[k] K_quot :=
          Algebra.TensorProduct.lift (Algebra.ofId k K_quot) g_alg (fun _ _ => Commute.all _ _)
        have _ : Algebra.IsIntegral k K_quot := ⟨fun y => by
          obtain ⟨e, rfl⟩ := Ideal.Quotient.mk_surjective y
          let z : Q₀ := (1 : k) ⊗ₜ[P] e
          obtain ⟨M, hM_monic, hM_eval⟩ := hInt_Q₀.isIntegral z
          refine ⟨M, hM_monic, ?_⟩
          have hΨ_alg : Ψ_alg.toRingHom.comp (algebraMap k Q₀) = φ_k :=
            RingHom.ext fun c => Ψ_alg.commutes c
          have hΨ_z : Ψ_alg z = Ideal.Quotient.mk q₀ e := by
            change (Algebra.TensorProduct.lift (Algebra.ofId k K_quot) g_alg _) (1 ⊗ₜ[P] e) = _
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl
          have hmap := congrArg Ψ_alg.toRingHom hM_eval
          rw [Polynomial.hom_eval₂, hΨ_alg, map_zero] at hmap
          change Polynomial.eval₂ φ_k (Ψ_alg z) M = 0 at hmap
          rwa [hΨ_z] at hmap⟩
        have hbij : Function.Bijective φ_k :=
          @IsAlgClosed.algebraMap_bijective_of_isIntegral k K_quot _ _ _ _ φ_k.toAlgebra inferInstance
        let e_k : k ≃+* K_quot := RingEquiv.ofBijective φ_k hbij
        let ε₀ : E₀ →+* k := e_k.symm.toRingHom.comp (Ideal.Quotient.mk q₀)
        refine ⟨ε₀, ?_, ?_⟩
        · apply Polynomial.ringHom_ext'
          · refine RingHom.ext fun c => ?_
            change e_k.symm (e_k c) = Polynomial.evalRingHom 0 (Polynomial.C c)
            rw [e_k.symm_apply_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
          · have hx_q₀ : f₀ Polynomial.X ∈ q₀ := by
              change Polynomial.X ∈ Ideal.comap f₀ q₀
              rw [hq₀, hm0_span]
              exact Ideal.subset_span rfl
            change e_k.symm (Ideal.Quotient.mk q₀ (f₀ Polynomial.X)) =
              Polynomial.evalRingHom 0 Polynomial.X
            rw [(Ideal.Quotient.eq_zero_iff_mem).mpr hx_q₀, map_zero, Polynomial.coe_evalRingHom,
              Polynomial.eval_X]
        · ext x
          rw [RingHom.mem_ker]
          change e_k.symm (Ideal.Quotient.mk q₀ x) = 0 ↔ x ∈ q₀
          rw [map_eq_zero_iff e_k.symm e_k.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
      · intro ε₁ ε₂ h₁_f h₁_k h₂_f h₂_k
        refine RingHom.ext fun x => ?_
        have hx_ker : x - f₀ (Polynomial.C (ε₁ x)) ∈ RingHom.ker ε₁ := by
          rw [RingHom.mem_ker, map_sub]
          have h1 := RingHom.congr_fun h₁_f (Polynomial.C (ε₁ x))
          rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C] at h1
          rw [h1, sub_self]
        rw [h₁_k, ← h₂_k, RingHom.mem_ker, map_sub] at hx_ker
        have h2 := RingHom.congr_fun h₂_f (Polynomial.C (ε₁ x))
        rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C] at h2
        rw [h2] at hx_ker
        exact (sub_eq_zero.mp hx_ker).symm

    · intro ε₀ hε₀_f hε₀_ker
      obtain ⟨hNoeth_E₀, hTF_E₀, hMapMax_E₀⟩ := hEtaleStalk E₀ f₀ hf₀
      have hStalkDomAndPrimes : ∀ (q : Ideal E₀) [q.IsPrime],
          IsDomain (Localization.AtPrime q) ∧
          ∀ (Q_loc : Ideal (Localization.AtPrime q)), Q_loc.IsPrime →
            Q_loc = ⊥ ∨ Q_loc = IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
        intro q _
        let p := Ideal.comap f₀ q
        let R_p := Localization.AtPrime p
        let R_q := Localization.AtPrime q
        have _ : IsNoetherianRing R_q := IsLocalization.isNoetherianRing q.primeCompl R_q hNoeth_E₀
        have hmax_map := hMapMax_E₀ q
        have hmax_p : Ideal.map (algebraMap P R_p) p = IsLocalRing.maximalIdeal R_p :=
          IsLocalization.AtPrime.map_eq_maximalIdeal p R_p
        by_cases hp_bot : p = ⊥
        · have hmap_p_bot : Ideal.map (algebraMap P R_p) p = ⊥ :=
            (congrArg (Ideal.map (algebraMap P R_p)) hp_bot).trans Ideal.map_bot
          have hmax_Rq_bot : IsLocalRing.maximalIdeal R_q = ⊥ := by
            rw [← hmax_map, ← hmax_p, hmap_p_bot, Ideal.map_bot]
          have hUnit_Rq : ∀ z : R_q, z ≠ 0 → IsUnit z := fun z hz => by
            apply IsLocalRing.notMem_maximalIdeal.mp
            rw [hmax_Rq_bot, Ideal.mem_bot]
            exact hz
          have _ : NoZeroDivisors R_q := ⟨fun {a b} hab => by
            by_cases ha : a = 0
            · exact Or.inl ha
            · exact Or.inr ((hUnit_Rq a ha).mul_right_eq_zero.mp hab)⟩
          have hDom_Rq : IsDomain R_q := NoZeroDivisors.to_isDomain R_q
          refine ⟨hDom_Rq, fun Q_loc hQ_pr => ?_⟩
          by_cases hQ_bot : Q_loc = ⊥
          · exact Or.inl hQ_bot
          · exfalso
            obtain ⟨z, hz_mem, hz_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQ_bot
            exact hQ_pr.ne_top (Q_loc.eq_top_of_isUnit_mem hz_mem (hUnit_Rq z hz_ne))
        · let π_P : P := Submodule.IsPrincipal.generator p
          have hp_span : p = Ideal.span {π_P} :=
            (Submodule.IsPrincipal.span_singleton_generator p).symm
          have hπP_ne : π_P ≠ 0 := by
            intro h0; apply hp_bot; rw [hp_span, h0, Ideal.span_singleton_eq_bot]
          let π_q : R_q := algebraMap E₀ R_q (f₀ π_P)
          have hmap_p_span : Ideal.map (algebraMap P R_p) p =
              Ideal.span {algebraMap P R_p π_P} := by
            rw [(congrArg (Ideal.map (algebraMap P R_p)) hp_span), Ideal.map_span,
              Set.image_singleton]
          have hmax_Rq : IsLocalRing.maximalIdeal R_q = Ideal.span {π_q} := by
            rw [← hmax_map, ← hmax_p, hmap_p_span, Ideal.map_span, Set.image_singleton,
              Localization.localRingHom_to_map]
          have hπq_reg : ∀ z : R_q, π_q * z = 0 → z = 0 := by
            intro z hz
            obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.surj q.primeCompl z
            have hz_eq : π_q * z * algebraMap E₀ R_q s.1 = algebraMap E₀ R_q (f₀ π_P * x) := by
              dsimp [π_q]
              rw [mul_assoc, hxs, ← map_mul]
            rw [hz, zero_mul] at hz_eq
            obtain ⟨t, ht⟩ := (hEqZeroLoc q.primeCompl R_q _).mp hz_eq.symm
            have htx0 : t.1 * x = 0 := by
              apply hTF_E₀ π_P (t.1 * x) hπP_ne
              calc
                f₀ π_P * (t.1 * x) = t.1 * (f₀ π_P * x) := by ring
                _ = 0 := ht
            have hzs : z * algebraMap E₀ R_q (t.1 * s.1) = 0 := by
              calc
                z * algebraMap E₀ R_q (t.1 * s.1) =
                    algebraMap E₀ R_q t.1 * (z * algebraMap E₀ R_q s.1) := by rw [map_mul]; ring
                _ = algebraMap E₀ R_q (t.1 * x) := by rw [hxs, ← map_mul]
                _ = 0 := by rw [htx0, map_zero]
            have hts_unit : IsUnit (algebraMap E₀ R_q (t.1 * s.1)) :=
              IsLocalization.map_units R_q (⟨t.1 * s.1, q.primeCompl.mul_mem t.2 s.2⟩ : q.primeCompl)
            exact (hts_unit.mul_left_eq_zero).mp hzs
          have hπq_pow_ne : ∀ n : ℕ, π_q ^ n ≠ 0 := by
            intro n
            induction n with
            | zero => exact one_ne_zero
            | succ n ih => intro h0; rw [pow_succ'] at h0; exact ih (hπq_reg _ h0)
          have hKrull := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R_q)
            (IsLocalRing.maximalIdeal.isMaximal R_q).ne_top
          have hVal_Rq : ∀ z : R_q, z ≠ 0 → ∃ (n : ℕ) (u : R_qˣ), z = ↑u * π_q ^ n := by
            intro z hz
            have hnot : ¬ ∀ n : ℕ, z ∈ IsLocalRing.maximalIdeal R_q ^ (n + 1) := by
              intro hall
              apply hz
              rw [← Ideal.mem_bot, ← hKrull, Ideal.mem_iInf]
              intro n
              cases n with
              | zero => simp
              | succ n => exact hall n
            push Not at hnot
            let n := Nat.find hnot
            have hn_not : z ∉ IsLocalRing.maximalIdeal R_q ^ (n + 1) := Nat.find_spec hnot
            have hn_mem : z ∈ IsLocalRing.maximalIdeal R_q ^ n := by
              cases h_eq : n with
              | zero => simp
              | succ k =>
                have hk_lt : k < Nat.find hnot := by omega
                exact of_not_not (Nat.find_min hnot hk_lt)
            rw [hmax_Rq, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hn_mem
            obtain ⟨u₀, hu₀⟩ := hn_mem
            have hu₀_unit : IsUnit u₀ := by
              apply IsLocalRing.notMem_maximalIdeal.mp
              intro hu_mem
              rw [hmax_Rq, Ideal.mem_span_singleton] at hu_mem
              obtain ⟨w, rfl⟩ := hu_mem
              apply hn_not
              rw [hmax_Rq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
              exact ⟨w, by rw [hu₀]; ring⟩
            exact ⟨n, hu₀_unit.unit, by rw [hu₀, mul_comm]; rfl⟩
          have _ : NoZeroDivisors R_q := ⟨fun {a b} hab => by
            by_contra h_none
            push Not at h_none
            obtain ⟨n₁, u₁, rfl⟩ := hVal_Rq a h_none.1
            obtain ⟨n₂, u₂, rfl⟩ := hVal_Rq b h_none.2
            have hrearr : ↑(u₁ * u₂) * π_q ^ (n₁ + n₂) = 0 := by
              calc
                ↑(u₁ * u₂) * π_q ^ (n₁ + n₂) = (↑u₁ * π_q ^ n₁) * (↑u₂ * π_q ^ n₂) := by
                  rw [Units.val_mul, pow_add]; ring
                _ = 0 := hab
            exact hπq_pow_ne (n₁ + n₂) ((u₁ * u₂).isUnit.mul_right_eq_zero.mp hrearr)⟩
          have hDom_Rq : IsDomain R_q := NoZeroDivisors.to_isDomain R_q
          refine ⟨hDom_Rq, fun Q_loc hQ_pr => ?_⟩
          by_cases hQ_bot : Q_loc = ⊥
          · exact Or.inl hQ_bot
          · right
            obtain ⟨z, hz_mem, hz_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQ_bot
            obtain ⟨n, u, rfl⟩ := hVal_Rq z hz_ne
            have hpow_mem : π_q ^ n ∈ Q_loc := by
              have h1 := Q_loc.mul_mem_left (↑u⁻¹ : R_q) hz_mem
              rwa [← mul_assoc, Units.inv_mul, one_mul] at h1
            have hπ_mem : π_q ∈ Q_loc := hQ_pr.mem_of_pow_mem n hpow_mem
            apply le_antisymm (IsLocalRing.le_maximalIdeal hQ_pr.ne_top)
            rw [hmax_Rq, Ideal.span_singleton_le_iff_mem]
            exact hπ_mem

      let P_min : ∀ (q : Ideal E₀) [q.IsPrime], Ideal E₀ :=
        fun q _ => RingHom.ker (algebraMap E₀ (Localization.AtPrime q))
      have hPrimesBelow : ∀ (q : Ideal E₀) [q.IsPrime],
          (P_min q).IsPrime ∧ P_min q ≤ q ∧
          ∀ (r : Ideal E₀), r.IsPrime → r ≤ q → r = P_min q ∨ r = q := by
        intro q _
        have _ : IsDomain (Localization.AtPrime q) := (hStalkDomAndPrimes q).1
        have hp_pr : (P_min q).IsPrime := RingHom.ker_isPrime _
        have hp_le : P_min q ≤ q := by
          intro x hx
          obtain ⟨t, ht⟩ := (hEqZeroLoc q.primeCompl (Localization.AtPrime q) x).mp hx
          exact (‹q.IsPrime›.mem_or_mem (ht ▸ q.zero_mem)).resolve_left t.2
        refine ⟨hp_pr, hp_le, fun r hr_pr hr_le => ?_⟩
        let Q_loc : Ideal (Localization.AtPrime q) :=
          Ideal.map (algebraMap E₀ (Localization.AtPrime q)) r
        have hdisj : Disjoint (q.primeCompl : Set E₀) (r : Set E₀) :=
          Set.disjoint_left.mpr fun _ hs hr_mem => hs (hr_le hr_mem)
        have hcomap_Q : Ideal.under E₀ Q_loc = r :=
          IsLocalization.under_map_of_isPrime_disjoint q.primeCompl (Localization.AtPrime q) hr_pr
            hdisj
        have hQ_pr : Q_loc.IsPrime :=
          (IsLocalization.isPrime_iff_isPrime_disjoint q.primeCompl
            (Localization.AtPrime q) Q_loc).mpr ⟨hcomap_Q.symm ▸ hr_pr, hcomap_Q.symm ▸ hdisj⟩
        rcases (hStalkDomAndPrimes q).2 Q_loc hQ_pr with hbot | hmax
        · left
          rw [← hcomap_Q, hbot]
          rfl
        · right
          rw [← hcomap_Q, hmax]
          exact IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime q) q

      have hPmin_mem : ∀ (q : Ideal E₀) [q.IsPrime], P_min q ∈ minimalPrimes E₀ := by
        intro q _
        obtain ⟨hp_pr, hp_le, hbelow⟩ := hPrimesBelow q
        refine ⟨⟨hp_pr, bot_le⟩, fun r ⟨hr_pr, _⟩ hr_le => ?_⟩
        rcases hbelow r hr_pr (hr_le.trans hp_le) with rfl | rfl
        · exact le_rfl
        · exact hp_le

      have hReduced_E₀ : ∀ x : E₀, IsNilpotent x → x = 0 := by
        rintro x ⟨n, hxn⟩
        by_contra hx0
        let ann : Ideal E₀ :=
          { carrier := {t : E₀ | t * x = 0}
            add_mem' := fun {a b} ha hb => by
              show (a + b) * x = 0; rw [add_mul, ha, hb, add_zero]
            zero_mem' := zero_mul x
            smul_mem' := fun c {a} ha => by
              show (c • a) * x = 0; rw [smul_eq_mul, mul_assoc, ha, mul_zero] }
        have hann_ne : ann ≠ ⊤ := by
          intro htop
          have h1 : (1 : E₀) ∈ ann := htop ▸ Submodule.mem_top
          change 1 * x = 0 at h1
          exact hx0 (one_mul x ▸ h1)
        obtain ⟨M, hM_max, hann_le⟩ := Ideal.exists_le_maximal ann hann_ne
        have _ : M.IsPrime := hM_max.isPrime
        have _ : IsDomain (Localization.AtPrime M) := (hStalkDomAndPrimes M).1
        have hloc_pow : (algebraMap E₀ (Localization.AtPrime M) x) ^ n = 0 := by
          rw [← map_pow, hxn, map_zero]
        have hloc0 : algebraMap E₀ (Localization.AtPrime M) x = 0 :=
          eq_zero_of_pow_eq_zero hloc_pow
        obtain ⟨t, ht⟩ := (hEqZeroLoc M.primeCompl (Localization.AtPrime M) x).mp hloc0
        exact t.2 (hann_le ht)

      let p₀ : Ideal E₀ := P_min q₀
      have hp₀_min : p₀ ∈ minimalPrimes E₀ := hPmin_mem q₀
      have hp₀_pr : p₀.IsPrime := (hPrimesBelow q₀).1
      have hp₀_le_q₀ : p₀ ≤ q₀ := (hPrimesBelow q₀).2.1
      have hp₀_comap : Ideal.comap f₀ p₀ = ⊥ := by
        by_contra hne
        let π₀ : P := Submodule.IsPrincipal.generator (Ideal.comap f₀ p₀)
        have hspan : Ideal.comap f₀ p₀ = Ideal.span {π₀} :=
          (Submodule.IsPrincipal.span_singleton_generator _).symm
        have hπ₀_ne : π₀ ≠ 0 := by
          intro h0; apply hne; rw [hspan, h0, Ideal.span_singleton_eq_bot]
        have hmem_p₀ : f₀ π₀ ∈ p₀ := by
          change π₀ ∈ Ideal.comap f₀ p₀; rw [hspan]; exact Ideal.subset_span rfl
        obtain ⟨t, ht⟩ := (hEqZeroLoc q₀.primeCompl (Localization.AtPrime q₀) (f₀ π₀)).mp hmem_p₀
        have ht0 : t.1 = 0 := hTF_E₀ π₀ t.1 hπ₀_ne (by rw [mul_comm]; exact ht)
        exact t.2 (ht0 ▸ q₀.zero_mem)

      have hMinFin : Set.Finite (minimalPrimes E₀ \ {p₀}) :=
        (@minimalPrimes.finite_of_isNoetherianRing E₀ _ hNoeth_E₀).sdiff
      let F_min : Finset (Ideal E₀) := hMinFin.toFinset
      have hex_sep : ∀ r ∈ F_min, ∃ g_r : E₀, g_r ∈ r ∧ g_r ∉ q₀ := by
        intro r hr
        obtain ⟨hr_min, hr_ne⟩ := hMinFin.mem_toFinset.mp hr
        by_contra hsub
        push Not at hsub
        rcases (hPrimesBelow q₀).2.2 r hr_min.1.1 hsub with rfl | rfl
        · exact hr_ne rfl
        · exact hr_ne (Set.mem_singleton_iff.mpr
            (le_antisymm (hr_min.2 ⟨hp₀_pr, bot_le⟩ hp₀_le_q₀) hp₀_le_q₀))
      choose g_fn hg_fn using hex_sep
      let g₁ : E₀ := ∏ r ∈ F_min.attach, g_fn r.1 r.2
      have hg₁_not_q₀ : g₁ ∉ q₀ := by
        change g₁ ∈ q₀.primeCompl
        exact Submonoid.prod_mem q₀.primeCompl fun r _ => (hg_fn r.1 r.2).2
      have hg₁_kill_p₀ : ∀ b : E₀, b ∈ p₀ → g₁ * b = 0 := by
        intro b hb
        have hmem_nil : g₁ * b ∈ nilradical E₀ := by
          rw [nilradical_eq_sInf, Ideal.mem_sInf]
          intro q hq_pr
          have _ : q.IsPrime := hq_pr
          have hmin_q : P_min q ∈ minimalPrimes E₀ := hPmin_mem q
          have hle_q : P_min q ≤ q := (hPrimesBelow q).2.1
          apply hle_q
          by_cases heq : P_min q = p₀
          · rw [heq]; exact p₀.mul_mem_left g₁ hb
          · have hmemF : P_min q ∈ F_min := hMinFin.mem_toFinset.mpr ⟨hmin_q, heq⟩
            have hdvd : g_fn (P_min q) hmemF ∣ g₁ :=
              Finset.dvd_prod_of_mem _ (Finset.mem_attach _ ⟨P_min q, hmemF⟩)
            obtain ⟨c, hc⟩ := hdvd
            rw [hc, mul_assoc]
            exact (P_min q).mul_mem_right _ (hg_fn (P_min q) hmemF).1
        exact hReduced_E₀ (g₁ * b) (mem_nilradical.mp hmem_nil)

      let E₁ := Localization.Away g₁
      have hker_E₁ : ∀ b : E₀, algebraMap E₀ E₁ b = 0 ↔ b ∈ p₀ := by
        intro b
        rw [hEqZeroLoc (Submonoid.powers g₁) E₁ b]
        constructor
        · rintro ⟨⟨_, m, rfl⟩, hm⟩
          have hmem : g₁ ^ m * b ∈ p₀ := hm ▸ p₀.zero_mem
          have hg₁_not_p₀ : g₁ ∉ p₀ := fun h => hg₁_not_q₀ (hp₀_le_q₀ h)
          exact (hp₀_pr.mem_or_mem hmem).resolve_left fun hpow =>
            hg₁_not_p₀ (hp₀_pr.mem_of_pow_mem m hpow)
        · intro hb
          exact ⟨⟨g₁, Submonoid.mem_powers g₁⟩, hg₁_kill_p₀ b hb⟩

      have _ : IsDomain E₁ := by
        have _ : Nontrivial E₁ := ⟨⟨0, 1, fun h01 =>
          hp₀_pr.ne_top ((Ideal.eq_top_iff_one p₀).mpr
            ((hker_E₁ 1).mp (by rw [map_one]; exact h01.symm)))⟩⟩
        have _ : NoZeroDivisors E₁ := ⟨fun {z₁ z₂} hz => by
          obtain ⟨⟨a₁, s₁⟩, h₁⟩ := IsLocalization.surj (Submonoid.powers g₁) z₁
          obtain ⟨⟨a₂, s₂⟩, h₂⟩ := IsLocalization.surj (Submonoid.powers g₁) z₂
          have hprod : algebraMap E₀ E₁ (a₁ * a₂) = 0 := by
            calc
              algebraMap E₀ E₁ (a₁ * a₂) =
                  (z₁ * z₂) * (algebraMap E₀ E₁ s₁.1 * algebraMap E₀ E₁ s₂.1) := by
                rw [map_mul, ← h₁, ← h₂]; ring
              _ = 0 := by rw [hz, zero_mul]
          rcases hp₀_pr.mem_or_mem ((hker_E₁ _).mp hprod) with ha₁ | ha₂
          · left
            have h0 : z₁ * algebraMap E₀ E₁ s₁.1 = 0 := h₁.trans ((hker_E₁ a₁).mpr ha₁)
            exact (IsLocalization.map_units E₁ s₁).mul_left_eq_zero.mp h0
          · right
            have h0 : z₂ * algebraMap E₀ E₁ s₂.1 = 0 := h₂.trans ((hker_E₁ a₂).mpr ha₂)
            exact (IsLocalization.map_units E₁ s₂).mul_left_eq_zero.mp h0⟩
        exact NoZeroDivisors.to_isDomain E₁

      have _ : IsNoetherianRing E₁ :=
        IsLocalization.isNoetherianRing (Submonoid.powers g₁) E₁ hNoeth_E₀
      have hMaxOfNeBot_E₁ : ∀ (Q : Ideal E₁), Q.IsPrime → Q ≠ ⊥ → Q.IsMaximal := by
        intro Q hQ_pr hQ_ne
        obtain ⟨M, hM_max, hQM⟩ := Ideal.exists_le_maximal Q hQ_pr.ne_top
        have _ : M.IsPrime := hM_max.isPrime
        let q_Q := Ideal.under E₀ Q
        let q_M := Ideal.under E₀ M
        have _ : q_Q.IsPrime := hQ_pr.comap _
        have _ : q_M.IsPrime := ‹M.IsPrime›.comap _
        have hp₀_le_qQ : p₀ ≤ q_Q := by
          intro b hb
          change algebraMap E₀ E₁ b ∈ Q
          rw [(hker_E₁ b).mpr hb]
          exact Q.zero_mem
        have hqQ_ne_p₀ : q_Q ≠ p₀ := by
          intro heq
          apply hQ_ne
          rw [Submodule.eq_bot_iff]
          intro z hz
          obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj (Submonoid.powers g₁) z
          have ha_qQ : a ∈ q_Q := by
            change algebraMap E₀ E₁ a ∈ Q
            rw [← has]
            exact Q.mul_mem_right _ hz
          rw [heq] at ha_qQ
          have hzs : z * algebraMap E₀ E₁ s.1 = 0 := has.trans ((hker_E₁ a).mpr ha_qQ)
          exact (IsLocalization.map_units E₁ s).mul_left_eq_zero.mp hzs
        have hp₀_eq_minM : P_min q_M = p₀ := by
          rcases (hPrimesBelow q_M).2.2 p₀ hp₀_pr (hp₀_le_qQ.trans (Ideal.comap_mono hQM)) with
            heq | heq
          · exact heq.symm
          · exfalso
            exact hqQ_ne_p₀ (le_antisymm (heq ▸ Ideal.comap_mono hQM) hp₀_le_qQ)
        have hqQ_eq_qM : q_Q = q_M := by
          rcases (hPrimesBelow q_M).2.2 q_Q inferInstance (Ideal.comap_mono hQM) with heq | heq
          · exfalso; exact hqQ_ne_p₀ (heq.trans hp₀_eq_minM)
          · exact heq
        have hQM_eq : Q = M := by
          rw [← IsLocalization.map_under (Submonoid.powers g₁) E₁ Q,
            ← IsLocalization.map_under (Submonoid.powers g₁) E₁ M]
          exact congrArg _ hqQ_eq_qM
        rwa [hQM_eq]

      have hε₀_g₁ : ε₀ g₁ ≠ 0 := fun h0 => hg₁_not_q₀ (hε₀_ker ▸ RingHom.mem_ker.mpr h0)
      have hg₁_unit_k : IsUnit (ε₀ g₁) := isUnit_iff_ne_zero.mpr hε₀_g₁
      let ε₁ : E₁ →+* k := IsLocalization.Away.lift g₁ hg₁_unit_k
      have hε₁_comp : ε₁.comp (algebraMap E₀ E₁) = ε₀ :=
        RingHom.ext fun b => IsLocalization.Away.lift_eq (S := E₁) g₁ hg₁_unit_k b
      let M₁ : Ideal E₁ := RingHom.ker ε₁
      let x₁ : E₁ := algebraMap E₀ E₁ (f₀ Polynomial.X)
      have hx₁_ne : x₁ ≠ 0 := by
        intro hx0
        have hmem : f₀ Polynomial.X ∈ p₀ := (hker_E₁ _).mp hx0
        have hX_bot : Polynomial.X ∈ (⊥ : Ideal P) := by
          rw [← hp₀_comap]; exact hmem
        exact Polynomial.X_ne_zero (Ideal.mem_bot.mp hX_bot)

      let Q_x := E₁ ⧸ Ideal.span {x₁}
      have _ : IsNoetherianRing Q_x := Ideal.Quotient.isNoetherianRing (Ideal.span {x₁})
      let mk_x : E₁ →+* Q_x := Ideal.Quotient.mk (Ideal.span {x₁})
      let toMinQx : {Q : Ideal E₁ // Q.IsPrime ∧ x₁ ∈ Q} → Ideal Q_x :=
        fun Q => Ideal.map mk_x Q.1
      have htoMinQx_mem : ∀ Q : {Q : Ideal E₁ // Q.IsPrime ∧ x₁ ∈ Q},
          toMinQx Q ∈ minimalPrimes Q_x := by
        intro ⟨Q, hQ_pr, hx₁_Q⟩
        have hker_le : RingHom.ker mk_x ≤ Q := by
          rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]; exact hx₁_Q
        have hcomap_Q : Ideal.comap mk_x (Ideal.map mk_x Q) = Q := by
          rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
            ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hker_le]
        have hmap_pr : (Ideal.map mk_x Q).IsPrime :=
          Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_le
        refine ⟨⟨hmap_pr, bot_le⟩, fun P' ⟨hP'_pr, _⟩ hP'_le => ?_⟩
        let Q' := Ideal.comap mk_x P'
        have hQ'_pr : Q'.IsPrime := hP'_pr.comap mk_x
        have hx₁_Q' : x₁ ∈ Q' := by
          change mk_x x₁ ∈ P'
          have h0 : mk_x x₁ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [h0]; exact P'.zero_mem
        have hQ'_ne : Q' ≠ ⊥ := fun hbot => hx₁_ne (Ideal.mem_bot.mp (hbot ▸ hx₁_Q'))
        have hQ'_max : Q'.IsMaximal := hMaxOfNeBot_E₁ Q' hQ'_pr hQ'_ne
        have hQ'_le_Q : Q' ≤ Q := hcomap_Q ▸ Ideal.comap_mono hP'_le
        have hQ'_eq : Q' = Q := hQ'_max.eq_of_le hQ_pr.ne_top hQ'_le_Q
        rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective P']
        exact le_of_eq (congrArg (Ideal.map mk_x) hQ'_eq.symm)
      have htoMinQx_inj : Function.Injective toMinQx := by
        rintro ⟨Q₁, hQ₁_pr, hx₁_Q₁⟩ ⟨Q₂, hQ₂_pr, hx₁_Q₂⟩ heq
        apply Subtype.ext
        have hk₁ : RingHom.ker mk_x ≤ Q₁ := by
          rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]; exact hx₁_Q₁
        have hk₂ : RingHom.ker mk_x ≤ Q₂ := by
          rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]; exact hx₁_Q₂
        have hc₁ : Ideal.comap mk_x (toMinQx ⟨Q₁, hQ₁_pr, hx₁_Q₁⟩) = Q₁ := by
          dsimp [toMinQx]
          rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
            ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hk₁]
        have hc₂ : Ideal.comap mk_x (toMinQx ⟨Q₂, hQ₂_pr, hx₁_Q₂⟩) = Q₂ := by
          dsimp [toMinQx]
          rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
            ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hk₂]
        exact hc₁.symm.trans ((congrArg (Ideal.comap mk_x) heq).trans hc₂)
      have hFinSubtype : Finite {Q : Ideal E₁ // Q.IsPrime ∧ x₁ ∈ Q} := by
        have _ : Finite ↥(minimalPrimes Q_x) :=
          (@minimalPrimes.finite_of_isNoetherianRing Q_x _ inferInstance).to_subtype
        exact Finite.of_injective (fun Q => (⟨toMinQx Q, htoMinQx_mem Q⟩ : ↥(minimalPrimes Q_x)))
          fun Q₁ Q₂ h => htoMinQx_inj (congrArg Subtype.val h)
      have hSx_fin : Set.Finite {Q : Ideal E₁ | Q.IsPrime ∧ x₁ ∈ Q ∧ Q ≠ M₁} := by
        refine Set.Finite.subset (Set.finite_range
          (Subtype.val : {Q : Ideal E₁ // Q.IsPrime ∧ x₁ ∈ Q} → Ideal E₁)) ?_
        rintro Q ⟨hpr, hx, _⟩
        exact ⟨⟨Q, hpr, hx⟩, rfl⟩

      let F_x : Finset (Ideal E₁) := hSx_fin.toFinset
      have hM₁_pr : M₁.IsPrime := RingHom.ker_isPrime ε₁
      have hex_hx : ∀ Q ∈ F_x, ∃ h_Q : E₁, h_Q ∈ Q ∧ h_Q ∉ M₁ := by
        intro Q hQ
        obtain ⟨hQ_pr, hx_Q, hQ_ne⟩ := hSx_fin.mem_toFinset.mp hQ
        have hQ_ne_bot : Q ≠ ⊥ := fun hbot => hx₁_ne (Ideal.mem_bot.mp (hbot ▸ hx_Q))
        have hQ_max : Q.IsMaximal := hMaxOfNeBot_E₁ Q hQ_pr hQ_ne_bot
        by_contra hsub
        push Not at hsub
        exact hQ_ne (hQ_max.eq_of_le hM₁_pr.ne_top hsub)
      choose h_fn hh_fn using hex_hx
      let h_prod : E₁ := ∏ Q ∈ F_x.attach, h_fn Q.1 Q.2
      have hh_not_M₁ : h_prod ∉ M₁ := by
        change h_prod ∈ M₁.primeCompl
        exact Submonoid.prod_mem M₁.primeCompl fun Q _ => (hh_fn Q.1 Q.2).2
      obtain ⟨⟨g₂, _, m₂, rfl⟩, hg₂_eq⟩ := IsLocalization.surj (Submonoid.powers g₁) h_prod
      have hε₀_g₂ : ε₀ g₂ ≠ 0 := by
        have hc2 := RingHom.congr_fun hε₁_comp g₂
        have hc1 := RingHom.congr_fun hε₁_comp g₁
        simp only [RingHom.comp_apply] at hc1 hc2
        have h1 : ε₀ g₂ = ε₁ h_prod * (ε₀ g₁) ^ m₂ := by
          rw [← hc2, ← hg₂_eq, map_mul, map_pow, map_pow, hc1]
        rw [h1]
        exact mul_ne_zero (fun h0 => hh_not_M₁ h0) (pow_ne_zero m₂ hε₀_g₁)

      let g : E₀ := g₁ * g₂
      have hε₀_g : ε₀ g ≠ 0 := by rw [map_mul]; exact mul_ne_zero hε₀_g₁ hε₀_g₂
      have hg_not_q₀ : g ∉ q₀ := fun h => hε₀_g (RingHom.mem_ker.mp (hε₀_ker.symm ▸ h))
      let E := Localization.Away g
      have hker_E : ∀ b : E₀, algebraMap E₀ E b = 0 ↔ b ∈ p₀ := by
        intro b
        rw [hEqZeroLoc (Submonoid.powers g) E b]
        constructor
        · rintro ⟨⟨_, m, rfl⟩, hm⟩
          have hmem : g ^ m * b ∈ p₀ := hm ▸ p₀.zero_mem
          have hg_not_p₀ : g ∉ p₀ := fun h => hg_not_q₀ (hp₀_le_q₀ h)
          exact (hp₀_pr.mem_or_mem hmem).resolve_left fun hpow =>
            hg_not_p₀ (hp₀_pr.mem_of_pow_mem m hpow)
        · intro hb
          exact ⟨⟨g, Submonoid.mem_powers g⟩, by
            show (g₁ * g₂) * b = 0
            calc
              (g₁ * g₂) * b = g₂ * (g₁ * b) := by ring
              _ = 0 := by rw [hg₁_kill_p₀ b hb, mul_zero]⟩

      have hDom_E : IsDomain E := by
        have _ : Nontrivial E := ⟨⟨0, 1, fun h01 =>
          hp₀_pr.ne_top ((Ideal.eq_top_iff_one p₀).mpr
            ((hker_E 1).mp (by rw [map_one]; exact h01.symm)))⟩⟩
        have _ : NoZeroDivisors E := ⟨fun {z₁ z₂} hz => by
          obtain ⟨⟨a₁, s₁⟩, h₁⟩ := IsLocalization.surj (Submonoid.powers g) z₁
          obtain ⟨⟨a₂, s₂⟩, h₂⟩ := IsLocalization.surj (Submonoid.powers g) z₂
          have hprod : algebraMap E₀ E (a₁ * a₂) = 0 := by
            calc
              algebraMap E₀ E (a₁ * a₂) =
                  (z₁ * z₂) * (algebraMap E₀ E s₁.1 * algebraMap E₀ E s₂.1) := by
                rw [map_mul, ← h₁, ← h₂]; ring
              _ = 0 := by rw [hz, zero_mul]
          rcases hp₀_pr.mem_or_mem ((hker_E _).mp hprod) with ha₁ | ha₂
          · left
            have h0 : z₁ * algebraMap E₀ E s₁.1 = 0 := h₁.trans ((hker_E a₁).mpr ha₁)
            exact (IsLocalization.map_units E s₁).mul_left_eq_zero.mp h0
          · right
            have h0 : z₂ * algebraMap E₀ E s₂.1 = 0 := h₂.trans ((hker_E a₂).mpr ha₂)
            exact (IsLocalization.map_units E s₂).mul_left_eq_zero.mp h0⟩
        exact NoZeroDivisors.to_isDomain E

      refine ⟨g, hε₀_g, hDom_E, fun ε_E hεE_comp => ?_⟩
      let M_E : Ideal E := RingHom.ker ε_E
      let x_E : E := algebraMap E₀ E (f₀ Polynomial.X)
      have hεE_f : ε_E.comp ((algebraMap E₀ E).comp f₀) = Polynomial.evalRingHom 0 := by
        rw [← RingHom.comp_assoc, hεE_comp, hε₀_f]
      have hxE_mem : x_E ∈ M_E := by
        rw [RingHom.mem_ker]
        have h1 := RingHom.congr_fun hεE_f Polynomial.X
        rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_evalRingHom,
          Polynomial.eval_X] at h1
        exact h1

      have hUniqPrime_E : ∀ (P' : Ideal E), P'.IsPrime → x_E ∈ P' → P' = M_E := by
        intro P' hP'_pr hx_P'
        let q' := Ideal.under E₀ P'
        have hq'_pr : q'.IsPrime := hP'_pr.comap _
        have hg_not_q' : g ∉ q' := fun hg_mem =>
          hP'_pr.ne_top (P'.eq_top_of_isUnit_mem hg_mem (IsLocalization.Away.algebraMap_isUnit g))
        have hg₁_not_q' : g₁ ∉ q' := fun hg₁_mem => hg_not_q' (q'.mul_mem_right g₂ hg₁_mem)
        have hg₂_not_q' : g₂ ∉ q' := fun hg₂_mem => hg_not_q' (q'.mul_mem_left g₁ hg₂_mem)
        have hdisj₁ : Disjoint (Submonoid.powers g₁ : Set E₀) (q' : Set E₀) := by
          rw [Set.disjoint_left]
          rintro _ ⟨m, rfl⟩ hm
          exact hg₁_not_q' (hq'_pr.mem_of_pow_mem m hm)
        let Q₁ : Ideal E₁ := Ideal.map (algebraMap E₀ E₁) q'
        have hcomap_Q₁ : Ideal.under E₀ Q₁ = q' :=
          IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g₁) E₁ hq'_pr hdisj₁
        have hQ₁_pr : Q₁.IsPrime :=
          (IsLocalization.isPrime_iff_isPrime_disjoint (Submonoid.powers g₁) E₁ Q₁).mpr
            ⟨hcomap_Q₁.symm ▸ hq'_pr, hcomap_Q₁.symm ▸ hdisj₁⟩
        have hx₁_Q₁ : x₁ ∈ Q₁ := Ideal.mem_map_of_mem _ hx_P'
        have hQ₁_eq_M₁ : Q₁ = M₁ := by
          by_contra hne
          have hmemF : Q₁ ∈ F_x := hSx_fin.mem_toFinset.mpr ⟨hQ₁_pr, hx₁_Q₁, hne⟩
          have hdvd : h_fn Q₁ hmemF ∣ h_prod :=
            Finset.dvd_prod_of_mem _ (Finset.mem_attach _ ⟨Q₁, hmemF⟩)
          obtain ⟨c, hc⟩ := hdvd
          have hh_Q₁ : h_prod ∈ Q₁ := hc ▸ Q₁.mul_mem_right c (hh_fn Q₁ hmemF).1
          have hg₂_Q₁ : algebraMap E₀ E₁ g₂ ∈ Q₁ := by
            rw [← hg₂_eq]
            exact Q₁.mul_mem_right _ hh_Q₁
          have hg₂_q' : g₂ ∈ q' := by rw [← hcomap_Q₁]; exact hg₂_Q₁
          exact hg₂_not_q' hg₂_q'
        have hq'_eq : q' = Ideal.under E₀ M_E := by
          rw [← hcomap_Q₁, hQ₁_eq_M₁]
          ext b
          change ε₁ (algebraMap E₀ E₁ b) = 0 ↔ ε_E (algebraMap E₀ E b) = 0
          have h1 := RingHom.congr_fun hε₁_comp b
          have h2 := RingHom.congr_fun hεE_comp b
          simp only [RingHom.comp_apply] at h1 h2
          rw [h1, h2]
        rw [← IsLocalization.map_under (Submonoid.powers g) E P',
          ← IsLocalization.map_under (Submonoid.powers g) E M_E]
        exact congrArg _ hq'_eq

      apply le_antisymm _ ((Ideal.span_singleton_le_iff_mem M_E).mpr hxE_mem)
      intro z hz
      let J : Ideal E :=
        { carrier := {s : E | s * z ∈ Ideal.span {x_E}}
          add_mem' := fun {a b} ha hb => by
            show (a + b) * z ∈ Ideal.span {x_E}; rw [add_mul]; exact Ideal.add_mem _ ha hb
          zero_mem' := by
            show 0 * z ∈ Ideal.span {x_E}; rw [zero_mul]; exact Ideal.zero_mem _
          smul_mem' := fun c {a} ha => by
            show (c • a) * z ∈ Ideal.span {x_E}
            rw [smul_eq_mul, mul_assoc]; exact Ideal.mul_mem_left _ c ha }
      have hxE_J : x_E ∈ J := Ideal.mem_span_singleton.mpr ⟨z, rfl⟩
      by_contra hz_not
      have hJ_ne_top : J ≠ ⊤ := by
        intro htop
        have h1 : (1 : E) ∈ J := htop ▸ Submodule.mem_top
        change 1 * z ∈ Ideal.span {x_E} at h1
        rw [one_mul] at h1
        exact hz_not h1
      obtain ⟨P', hP'_max, hJP'⟩ := Ideal.exists_le_maximal J hJ_ne_top
      have hP'_eq : P' = M_E := hUniqPrime_E P' hP'_max.isPrime (hJP' hxE_J)
      have hJ_le_ME : J ≤ M_E := hP'_eq ▸ hJP'
      have _ : M_E.IsPrime := RingHom.ker_isPrime ε_E
      let f_E : P →+* E := (algebraMap E₀ E).comp f₀
      have hfE_et : f_E.Etale := by
        have hloc_et : (algebraMap E₀ E).Etale :=
          RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway g)
        exact RingHom.Etale.stableUnderComposition _ _ hf₀ hloc_et
      have hcomap_fE : Ideal.comap f_E M_E = RingHom.ker (Polynomial.evalRingHom (0 : k)) := by
        have hle : RingHom.ker (Polynomial.evalRingHom (0 : k)) ≤ Ideal.comap f_E M_E := by
          rw [← hεE_f]
          intro p hp
          exact hp
        exact (hm0_max.eq_of_le (‹M_E.IsPrime›.comap f_E).ne_top hle).symm
      let p_E := Ideal.comap f_E M_E
      let V_E := Localization.AtPrime M_E
      have hmax_VE := (hEtaleStalk E f_E hfE_et).2.2 M_E
      have hmax_pE : Ideal.map (algebraMap P (Localization.AtPrime p_E)) p_E =
          IsLocalRing.maximalIdeal (Localization.AtPrime p_E) :=
        IsLocalization.AtPrime.map_eq_maximalIdeal p_E (Localization.AtPrime p_E)
      have hpE_map_span : Ideal.map (algebraMap P (Localization.AtPrime p_E)) p_E =
          Ideal.span {algebraMap P (Localization.AtPrime p_E) Polynomial.X} := by
        rw [congrArg (Ideal.map (algebraMap P (Localization.AtPrime p_E)))
          (hcomap_fE.trans hm0_span), Ideal.map_span, Set.image_singleton]
      have hmax_VE_span : IsLocalRing.maximalIdeal V_E = Ideal.span {algebraMap E V_E x_E} := by
        rw [← hmax_VE, ← hmax_pE, hpE_map_span, Ideal.map_span, Set.image_singleton,
          Localization.localRingHom_to_map]
        rfl
      have hz_VE : algebraMap E V_E z ∈ IsLocalRing.maximalIdeal V_E :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff V_E M_E z).mpr hz
      rw [hmax_VE_span, Ideal.mem_span_singleton] at hz_VE
      obtain ⟨q_v, hqv⟩ := hz_VE
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M_E.primeCompl q_v
      have hmul_VE : algebraMap E V_E (s.1 * z) = algebraMap E V_E (b * x_E) := by
        calc
          algebraMap E V_E (s.1 * z) = algebraMap E V_E s.1 * (algebraMap E V_E x_E * q_v) := by
            rw [map_mul, hqv]
          _ = algebraMap E V_E x_E * (q_v * algebraMap E V_E s.1) := by ring
          _ = algebraMap E V_E (b * x_E) := by rw [hbs, map_mul, mul_comm]
      obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists M_E.primeCompl V_E).mp hmul_VE
      have hts_J : t.1 * s.1 ∈ J := by
        change (t.1 * s.1) * z ∈ Ideal.span {x_E}
        have h1 : (t.1 * s.1) * z = (t.1 * b) * x_E := by
          calc
            (t.1 * s.1) * z = t.1 * (s.1 * z) := by ring
            _ = t.1 * (b * x_E) := ht
            _ = (t.1 * b) * x_E := by ring
        rw [h1, Ideal.mem_span_singleton]
        exact ⟨t.1 * b, mul_comm _ _⟩
      exact (M_E.primeCompl.mul_mem t.2 s.2) (hJ_le_ME hts_J)

    · intro hDomE₀ ψ₀ hψ₀_et hψ₀_q₀
      let V₀ := Localization.AtPrime q₀
      have hle_nzd : q₀.primeCompl ≤ nonZeroDivisors E₀ := fun s hs =>
        mem_nonZeroDivisors_iff_right.mpr fun x hxs =>
          (mul_eq_zero.mp hxs).resolve_right fun hs0 => hs (hs0 ▸ q₀.zero_mem)
      have _ : IsDomain V₀ := IsLocalization.isDomain_of_le_nonZeroDivisors V₀ hle_nzd
      have hinj_V₀ : Function.Injective (algebraMap E₀ V₀) :=
        IsLocalization.injective V₀ hle_nzd
      have hMaxUnif : ∀ (f : P →+* E₀), f.Etale →
          Ideal.comap f q₀ = RingHom.ker (Polynomial.evalRingHom 0) →
          algebraMap E₀ V₀ (f Polynomial.X) ≠ 0 ∧
          IsLocalRing.maximalIdeal V₀ = Ideal.span {algebraMap E₀ V₀ (f Polynomial.X)} := by
        intro f hf hcom
        obtain ⟨_, hTF, hMapMax⟩ := hEtaleStalk E₀ f hf
        have hfX_ne : f Polynomial.X ≠ 0 := fun h0 =>
          one_ne_zero (hTF Polynomial.X 1 Polynomial.X_ne_zero (by rw [h0, zero_mul]))
        have hϖ_ne : algebraMap E₀ V₀ (f Polynomial.X) ≠ 0 := fun h0 =>
          hfX_ne (hinj_V₀ (h0.trans (map_zero _).symm))
        let p_f := Ideal.comap f q₀
        have hmax_pf : Ideal.map (algebraMap P (Localization.AtPrime p_f)) p_f =
            IsLocalRing.maximalIdeal (Localization.AtPrime p_f) :=
          IsLocalization.AtPrime.map_eq_maximalIdeal p_f (Localization.AtPrime p_f)
        have hpf_map_span : Ideal.map (algebraMap P (Localization.AtPrime p_f)) p_f =
            Ideal.span {algebraMap P (Localization.AtPrime p_f) Polynomial.X} := by
          rw [congrArg (Ideal.map (algebraMap P (Localization.AtPrime p_f)))
            (hcom.trans hm0_span), Ideal.map_span, Set.image_singleton]
        have hspan : IsLocalRing.maximalIdeal V₀ = Ideal.span {algebraMap E₀ V₀ (f Polynomial.X)} := by
          rw [← hMapMax q₀, ← hmax_pf, hpf_map_span, Ideal.map_span, Set.image_singleton,
            Localization.localRingHom_to_map]
        exact ⟨hϖ_ne, hspan⟩
      obtain ⟨hϖf_ne, hspan_f⟩ := hMaxUnif f₀ hf₀ hq₀
      obtain ⟨hϖψ_ne, hspan_ψ⟩ := hMaxUnif ψ₀ hψ₀_et hψ₀_q₀
      let ϖ_f : V₀ := algebraMap E₀ V₀ (f₀ Polynomial.X)
      let ϖ_ψ : V₀ := algebraMap E₀ V₀ (ψ₀ Polynomial.X)
      have hspan_eq : Ideal.span {ϖ_ψ} = Ideal.span {ϖ_f} := hspan_ψ.symm.trans hspan_f
      have h1 : ϖ_ψ ∈ Ideal.span {ϖ_f} := hspan_eq ▸ Ideal.subset_span rfl
      have h2 : ϖ_f ∈ Ideal.span {ϖ_ψ} := hspan_eq.symm ▸ Ideal.subset_span rfl
      rw [Ideal.mem_span_singleton] at h1 h2
      obtain ⟨q₁, hq₁⟩ := h1
      obtain ⟨q₂, hq₂⟩ := h2
      have hq_unit : q₁ * q₂ = 1 := by
        apply mul_left_cancel₀ hϖf_ne
        calc
          ϖ_f * (q₁ * q₂) = (ϖ_f * q₁) * q₂ := by ring
          _ = ϖ_ψ * q₂ := by rw [← hq₁]
          _ = ϖ_f * 1 := by rw [← hq₂, mul_one]
      have hq₁_isUnit : IsUnit q₁ := IsUnit.of_mul_eq_one q₂ hq_unit
      have hq₁_not_max : q₁ ∉ IsLocalRing.maximalIdeal V₀ :=
        IsLocalRing.notMem_maximalIdeal.mpr hq₁_isUnit
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj q₀.primeCompl q₁
      have hb_not_q₀ : b ∉ q₀ := by
        intro hb_mem
        apply hq₁_not_max
        have hb_max : algebraMap E₀ V₀ b ∈ IsLocalRing.maximalIdeal V₀ :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff V₀ q₀ b).mpr hb_mem
        have hq₁_eq : q₁ = algebraMap E₀ V₀ b * IsLocalization.mk' V₀ 1 s := by
          apply (IsLocalization.map_units V₀ s).mul_left_inj.mp
          calc
            q₁ * algebraMap E₀ V₀ s.1 = algebraMap E₀ V₀ b := hbs
            _ = algebraMap E₀ V₀ b * (IsLocalization.mk' V₀ 1 s * algebraMap E₀ V₀ s.1) := by
              rw [IsLocalization.mk'_spec, map_one, mul_one]
            _ = (algebraMap E₀ V₀ b * IsLocalization.mk' V₀ 1 s) * algebraMap E₀ V₀ s.1 := by ring
        rw [hq₁_eq]
        exact (IsLocalRing.maximalIdeal V₀).mul_mem_right _ hb_max
      refine ⟨b, s.1, hb_not_q₀, s.2, hinj_V₀ ?_⟩
      calc
        algebraMap E₀ V₀ (s.1 * ψ₀ Polynomial.X) = algebraMap E₀ V₀ s.1 * ϖ_ψ := map_mul _ _ _
        _ = ϖ_f * (q₁ * algebraMap E₀ V₀ s.1) := by rw [hq₁]; ring
        _ = algebraMap E₀ V₀ (b * f₀ Polynomial.X) := by rw [hbs, map_mul, mul_comm]

  
  have hLift_alg : ∀ (A₀ E : Type u) [CommRing A₀] [CommRing E]
      (φ_A : A₀ →+* R_bar) (w : A₀ →+* E) (ε_E : E →+* k),
      w.Etale → ε_E.comp w = π_cl.comp φ_A →
      ∃ ι_E : E →+* R_bar, ι_E.comp w = φ_A ∧ π_cl.comp ι_E = ε_E := by
    intro A₀ E _ _ φ_A w ε_E hw_et hε_w
    have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom w)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hw_et
    have hcomm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_E) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom w) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hε_w]
    obtain ⟨g_tilde, hg1, hg2⟩ :=
      hLift_Rbar (AlgebraicGeometry.Spec.map (CommRingCat.ofHom w))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_E)) hcomm
    let ι_E : E →+* R_bar := (AlgebraicGeometry.Spec.preimage g_tilde).hom
    have hι_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_E) = g_tilde :=
      AlgebraicGeometry.Spec.map_preimage g_tilde
    refine ⟨ι_E, ?_, ?_⟩
    · suffices h : CommRingCat.ofHom (ι_E.comp w) = CommRingCat.ofHom φ_A from
        congrArg CommRingCat.Hom.hom h
      apply AlgebraicGeometry.Spec.map_injective
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hι_map, hg1]
    · suffices h : CommRingCat.ofHom (π_cl.comp ι_E) = CommRingCat.ofHom ε_E from
        congrArg CommRingCat.Hom.hom h
      apply AlgebraicGeometry.Spec.map_injective
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hι_map, hg2]

  have hShrink : ∀ (E₀ : Type u) [CommRing E₀]
      (α₀ : R₀ →+* E₀) (ε₀ : E₀ →+* k),
      α₀.Etale →
      ε₀.comp (α₀.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 →
      ∃ g : E₀, ε₀ g ≠ 0 ∧ IsDomain (Localization.Away g) ∧
        ∀ (ε_E : Localization.Away g →+* k),
          ε_E.comp (algebraMap E₀ (Localization.Away g)) = ε₀ →
          RingHom.ker ε_E =
            Ideal.span {algebraMap E₀ (Localization.Away g) (α₀ x₀)} := by
    intro E₀ _ α₀ ε₀ hα₀_et hε₀_comp
    let f₀ : P →+* E₀ := α₀.comp (algebraMap P R₀)
    have hf₀_et : f₀.Etale := RingHom.Etale.stableUnderComposition _ _ hR₀_et hα₀_et
    let q₀ : Ideal E₀ := RingHom.ker ε₀
    have _ : q₀.IsPrime := RingHom.ker_isPrime ε₀
    have hq₀ : Ideal.comap f₀ q₀ = RingHom.ker (Polynomial.evalRingHom 0) := by
      dsimp [q₀]
      rw [RingHom.comap_ker, hε₀_comp]
    exact (h_pillar3 E₀ f₀ hf₀_et q₀ hq₀).2.1 ε₀ hε₀_comp rfl

  
  have h_pillar4 :
      ∃ (R_s : Type u) (_ : CommRing R_s) (_ : IsDomain R_s) (_ : IsLocalRing R_s)
        (_ : HenselianLocalRing R_s) (_ : IsDiscreteValuationRing R_s)
        (K_s : Type u) (_ : Field K_s)
        (p_Rs : P →+* R_s)
        (ι_RK : R_s →+* K_s)
        (ι_Rbar : R_s →+* R_bar)
        (ι_KΩ : K_s →+* Ω)
        (t_s : R_s)
        (p_Rs_loc : R₀ →+* R_s)
        (p_Ks_loc : Localization.Away x₀ →+* K_s)
        (𝒥 : Type u) (_ : CategoryTheory.SmallCategory 𝒥) (_ : CategoryTheory.IsFiltered 𝒥)
        (B_st B_open : 𝒥 ⥤ CommRingCat.{u})
        (α_st : (CategoryTheory.Functor.const 𝒥).obj (CommRingCat.of R₀) ⟶ B_st)
        (α_op : (CategoryTheory.Functor.const 𝒥).obj (CommRingCat.of (Localization.Away x₀)) ⟶
          B_open)
        (loc_st : B_st ⟶ B_open)
        (ε_st : ∀ j : 𝒥, ↑(B_st.obj j) →+* k)
        (c_st : CategoryTheory.Limits.Cocone B_st) (_ : CategoryTheory.Limits.IsColimit c_st)
        (e_Rs : c_st.pt ≅ CommRingCat.of R_s)
        (c_op : CategoryTheory.Limits.Cocone B_open) (_ : CategoryTheory.Limits.IsColimit c_op)
        (e_Ks : c_op.pt ≅ CommRingCat.of K_s),
        (p_Rs Polynomial.X = t_s ∧
          ι_Rbar.comp p_Rs = p_R ∧
          ι_Rbar t_s = t_bar ∧
          t_s ≠ 0 ∧
          IsLocalRing.maximalIdeal R_s = Ideal.span {t_s} ∧
          RingHom.ker (π_cl.comp ι_Rbar) = IsLocalRing.maximalIdeal R_s ∧
          (π_cl.comp ι_Rbar).comp (p_Rs.comp Polynomial.C) = RingHom.id k ∧
          @IsLocalization.Away R_s _ t_s K_s _ ι_RK.toAlgebra ∧
          φ_R_Ω.comp ι_Rbar = ι_KΩ.comp ι_RK ∧
          p_Rs_loc.comp (algebraMap P R₀) = p_Rs ∧
          p_Ks_loc.comp (algebraMap R₀ (Localization.Away x₀)) = ι_RK.comp p_Rs_loc) ∧
        ((∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂), (B_st.map θ).hom.Etale) ∧
          ∀ j : 𝒥,
            (α_st.app j).hom.Etale ∧
            (loc_st.app j).hom.Etale ∧
            @IsLocalization.Away ↑(B_st.obj j) _ ((α_st.app j).hom x₀) ↑(B_open.obj j) _
              (loc_st.app j).hom.toAlgebra ∧
            (ε_st j).comp ((α_st.app j).hom.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 ∧
            RingHom.ker (ε_st j) = Ideal.span {(α_st.app j).hom x₀} ∧
            CommRingCat.ofHom (algebraMap R₀ (Localization.Away x₀)) ≫ α_op.app j =
              α_st.app j ≫ loc_st.app j ∧
            (α_st.app j) ≫ (c_st.ι.app j) ≫ e_Rs.hom = CommRingCat.ofHom p_Rs_loc ∧
            (α_op.app j) ≫ (c_op.ι.app j) ≫ e_Ks.hom = CommRingCat.ofHom p_Ks_loc ∧
            (c_st.ι.app j) ≫ e_Rs.hom ≫ CommRingCat.ofHom ι_RK =
              (loc_st.app j) ≫ (c_op.ι.app j) ≫ e_Ks.hom ∧
            (π_cl.comp ι_Rbar).comp ((c_st.ι.app j) ≫ e_Rs.hom).hom = ε_st j) ∧
        (∀ (E : Type u) [CommRing E] [IsDomain E]
            (α_E : R₀ →+* E) (ε_E : E →+* k),
          α_E.Etale →
          ε_E.comp (α_E.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 →
          RingHom.ker ε_E = Ideal.span {α_E x₀} →
          ∃ (j₀ : 𝒥) (e_E : E ≃+* ↑(B_st.obj j₀)),
            (α_st.app j₀).hom = e_E.toRingHom.comp α_E ∧
            (ε_st j₀).comp e_E.toRingHom = ε_E) := by
    classical
    rcases hRbar_props with ⟨hpR_X, hπ_pR, hφ_pR, hφ_inj, _⟩

    have hπ_surj : Function.Surjective π_cl := fun c =>
      ⟨p_R (Polynomial.C c), by
        have h1 := RingHom.congr_fun hπ_pR (Polynomial.C c)
        rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C] at h1
        exact h1⟩
    have hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective π_cl hπ_surj)

    have hP_Ω_inj : Function.Injective (algebraMap P Ω) := by
      have h1 : ⇑(algebraMap P Ω) =
          ⇑(algebraMap (FractionRing P) Ω) ∘ ⇑(algebraMap P (FractionRing P)) := by
        ext f
        exact IsScalarTower.algebraMap_apply P (FractionRing P) Ω f
      rw [h1]
      exact (RingHom.injective (algebraMap (FractionRing P) Ω)).comp
        (IsFractionRing.injective P (FractionRing P))

    have ht_bar_ne : t_bar ≠ 0 := by
      intro h0
      have h1 := RingHom.congr_fun hφ_pR Polynomial.X
      rw [RingHom.comp_apply, hpR_X, h0, map_zero] at h1
      exact Polynomial.X_ne_zero (hP_Ω_inj (h1.symm.trans (map_zero _).symm))

    have hpR_Δ_unit : IsUnit (p_R Δ₀) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      rw [← hπ_ker, RingHom.mem_ker]
      have h1 := RingHom.congr_fun hπ_pR Δ₀
      rw [RingHom.comp_apply, Polynomial.coe_evalRingHom] at h1
      rw [h1]
      exact hΔ₀

    let p_R_loc : R₀ →+* R_bar := IsLocalization.Away.lift Δ₀ hpR_Δ_unit
    have hpR_loc_comp : p_R_loc.comp (algebraMap P R₀) = p_R :=
      RingHom.ext fun f => IsLocalization.Away.lift_eq (S := R₀) Δ₀ hpR_Δ_unit f
    have hpR_loc_x₀ : p_R_loc x₀ = t_bar := by
      dsimp [x₀]
      rw [← RingHom.comp_apply, hpR_loc_comp, hpR_X]
    have hpR_loc_inj : Function.Injective p_R_loc := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      obtain ⟨⟨f, s⟩, hfs⟩ := IsLocalization.surj (Submonoid.powers Δ₀) r
      have hpf0 : p_R f = 0 := by
        have h1 := congrArg p_R_loc hfs
        rw [map_mul, hr, zero_mul, ← RingHom.comp_apply, hpR_loc_comp] at h1
        exact h1.symm
      have hf0 : f = 0 := by
        apply hP_Ω_inj
        have h1 := RingHom.congr_fun hφ_pR f
        rw [RingHom.comp_apply, hpf0, map_zero] at h1
        exact h1.symm.trans (map_zero _).symm
      have hrs0 : r * algebraMap P R₀ s.1 = 0 := by rw [hfs, hf0, map_zero]
      exact (IsLocalization.map_units R₀ s).mul_left_eq_zero.mp hrs0

    have hπ_pR_loc : π_cl.comp p_R_loc = eval₀_loc := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ₀)
      rw [RingHom.comp_assoc, hpR_loc_comp, hπ_pR, heval₀_comp]

    let _ : Algebra R₀ R_bar := p_R_loc.toAlgebra

    have hValDecomp : ∀ (E : Type u) [CommRing E] [IsDomain E]
        (α_E : R₀ →+* E) (ε_E : E →+* k),
        α_E.Etale →
        ε_E.comp (α_E.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 →
        RingHom.ker ε_E = Ideal.span {α_E x₀} →
        (∀ e : E, e ≠ 0 →
          ∃ (n : ℕ) (b s : E), ε_E b ≠ 0 ∧ ε_E s ≠ 0 ∧ s * e = b * (α_E x₀) ^ n) ∧
        (∀ ι_E : E →+* R_bar,
          ι_E.comp α_E = p_R_loc → π_cl.comp ι_E = ε_E → Function.Injective ι_E) := by
      intro E _ _ α_E ε_E hα_et hε_comp hε_ker
      have hVal : ∀ e : E, e ≠ 0 →
          ∃ (n : ℕ) (b s : E), ε_E b ≠ 0 ∧ ε_E s ≠ 0 ∧ s * e = b * (α_E x₀) ^ n := by
        intro e he_ne
        let f_E : P →+* E := α_E.comp (algebraMap P R₀)
        have hfE_et : f_E.Etale := RingHom.Etale.stableUnderComposition _ _ hR₀_et hα_et
        let _ : Algebra P E := f_E.toAlgebra
        have _ : Algebra.Etale P E := RingHom.etale_algebraMap.mp hfE_et
        have hNoeth_E : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing P E
        let M_E : Ideal E := RingHom.ker ε_E
        have _ : M_E.IsPrime := RingHom.ker_isPrime ε_E
        let V_E := Localization.AtPrime M_E
        have hle_nzd : M_E.primeCompl ≤ nonZeroDivisors E := fun s hs =>
          mem_nonZeroDivisors_iff_right.mpr fun x hxs =>
            (mul_eq_zero.mp hxs).resolve_right fun hs0 => hs (hs0 ▸ M_E.zero_mem)
        have _ : IsDomain V_E := IsLocalization.isDomain_of_le_nonZeroDivisors V_E hle_nzd
        have hinj_VE : Function.Injective (algebraMap E V_E) :=
          IsLocalization.injective V_E hle_nzd
        have _ : IsNoetherianRing V_E := IsLocalization.isNoetherianRing M_E.primeCompl V_E hNoeth_E
        let ϖ_E : V_E := algebraMap E V_E (α_E x₀)
        have hmax_VE : IsLocalRing.maximalIdeal V_E = Ideal.span {ϖ_E} := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal M_E V_E,
            congrArg (Ideal.map (algebraMap E V_E)) hε_ker, Ideal.map_span, Set.image_singleton]
        have he_VE : algebraMap E V_E e ≠ 0 := fun h0 =>
          he_ne (hinj_VE (h0.trans (map_zero _).symm))
        have hKrull := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal V_E)
          (IsLocalRing.maximalIdeal.isMaximal V_E).ne_top
        have hnot : ¬ ∀ n : ℕ, algebraMap E V_E e ∈ IsLocalRing.maximalIdeal V_E ^ (n + 1) := by
          intro hall
          apply he_VE
          rw [← Ideal.mem_bot, ← hKrull, Ideal.mem_iInf]
          intro n
          cases n with
          | zero => simp
          | succ n => exact hall n
        push Not at hnot
        let n := Nat.find hnot
        have hn_not : algebraMap E V_E e ∉ IsLocalRing.maximalIdeal V_E ^ (n + 1) :=
          Nat.find_spec hnot
        have hn_mem : algebraMap E V_E e ∈ IsLocalRing.maximalIdeal V_E ^ n := by
          cases h_eq : n with
          | zero => simp
          | succ k =>
            have hk_lt : k < Nat.find hnot := by omega
            exact of_not_not (Nat.find_min hnot hk_lt)
        rw [hmax_VE, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hn_mem
        obtain ⟨u₀, hu₀⟩ := hn_mem
        have hu₀_not_max : u₀ ∉ IsLocalRing.maximalIdeal V_E := by
          intro hu_mem
          rw [hmax_VE, Ideal.mem_span_singleton] at hu_mem
          obtain ⟨w, rfl⟩ := hu_mem
          apply hn_not
          rw [hmax_VE, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          exact ⟨w, by rw [hu₀]; ring⟩
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M_E.primeCompl u₀
        have hb_not_ME : b ∉ M_E := by
          intro hb_mem
          apply hu₀_not_max
          have hb_max : algebraMap E V_E b ∈ IsLocalRing.maximalIdeal V_E :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff V_E M_E b).mpr hb_mem
          have hu₀_eq : u₀ = algebraMap E V_E b * IsLocalization.mk' V_E 1 s := by
            apply (IsLocalization.map_units V_E s).mul_left_inj.mp
            calc
              u₀ * algebraMap E V_E s.1 = algebraMap E V_E b := hbs
              _ = algebraMap E V_E b * (IsLocalization.mk' V_E 1 s * algebraMap E V_E s.1) := by
                rw [IsLocalization.mk'_spec, map_one, mul_one]
              _ = (algebraMap E V_E b * IsLocalization.mk' V_E 1 s) * algebraMap E V_E s.1 := by ring
          rw [hu₀_eq]
          exact (IsLocalRing.maximalIdeal V_E).mul_mem_right _ hb_max
        refine ⟨n, b, s.1, hb_not_ME, s.2, hinj_VE ?_⟩
        calc
          algebraMap E V_E (s.1 * e) = algebraMap E V_E s.1 * (ϖ_E ^ n * u₀) := by
            rw [map_mul, hu₀]
          _ = (u₀ * algebraMap E V_E s.1) * ϖ_E ^ n := by ring
          _ = algebraMap E V_E (b * (α_E x₀) ^ n) := by rw [hbs, map_mul, map_pow]
      refine ⟨hVal, fun ι_E hι_α hπ_ι => ?_⟩
      rw [injective_iff_map_eq_zero]
      intro e he0
      by_contra he_ne
      obtain ⟨n, b, s, hb_ne, _, hse⟩ := hVal e he_ne
      have hmap := congrArg ι_E hse
      have hι_x₀ : ι_E (α_E x₀) = t_bar := by
        have h1 := RingHom.congr_fun hι_α x₀
        rw [RingHom.comp_apply, hpR_loc_x₀] at h1
        exact h1
      rw [map_mul, he0, mul_zero, map_mul, map_pow, hι_x₀] at hmap
      have hιb_ne : ι_E b ≠ 0 := by
        intro hb0
        have h1 := RingHom.congr_fun hπ_ι b
        rw [RingHom.comp_apply, hb0, map_zero] at h1
        exact hb_ne h1.symm
      exact mul_ne_zero hιb_ne (pow_ne_zero n ht_bar_ne) hmap.symm

    let IsClean : Subalgebra R₀ R_bar → Prop := fun A =>
      (algebraMap R₀ ↥A).Etale ∧
      RingHom.ker (π_cl.comp A.val.toRingHom) = Ideal.span {algebraMap R₀ ↥A x₀}
    let 𝒥 : Type u := {A : Subalgebra R₀ R_bar // IsClean A}
    let _ : CategoryTheory.SmallCategory 𝒥 := Preorder.smallCategory 𝒥

    have hEmbedToStage : ∀ (E : Type u) [CommRing E] [IsDomain E]
        (α_E : R₀ →+* E) (ε_E : E →+* k) (ι_E : E →+* R_bar),
        α_E.Etale →
        ε_E.comp (α_E.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 →
        RingHom.ker ε_E = Ideal.span {α_E x₀} →
        ι_E.comp α_E = p_R_loc →
        π_cl.comp ι_E = ε_E →
        ∃ (j₀ : 𝒥) (e_E : E ≃+* ↥j₀.1),
          (algebraMap R₀ ↥j₀.1) = e_E.toRingHom.comp α_E ∧
          (π_cl.comp j₀.1.val.toRingHom).comp e_E.toRingHom = ε_E ∧
          j₀.1.val.toRingHom.comp e_E.toRingHom = ι_E := by
      intro E _ _ α_E ε_E ι_E hα_et hε_comp hε_ker hι_α hπ_ι
      have hinj := (hValDecomp E α_E ε_E hα_et hε_comp hε_ker).2 ι_E hι_α hπ_ι
      let _ : Algebra R₀ E := α_E.toAlgebra
      let ι_alg : E →ₐ[R₀] R_bar :=
        { ι_E with commutes' := fun r => RingHom.congr_fun hι_α r }
      let A₀ : Subalgebra R₀ R_bar := ι_alg.range
      let e_alg : E ≃ₐ[R₀] ↥A₀ := AlgEquiv.ofInjective ι_alg hinj
      let e_E : E ≃+* ↥A₀ := e_alg.toRingEquiv
      have he_val : A₀.val.toRingHom.comp e_E.toRingHom = ι_E := rfl
      have he_α : algebraMap R₀ ↥A₀ = e_E.toRingHom.comp α_E :=
        RingHom.ext fun r => (e_alg.commutes r).symm
      have he_ε : (π_cl.comp A₀.val.toRingHom).comp e_E.toRingHom = ε_E := by
        rw [RingHom.comp_assoc, he_val, hπ_ι]
      have hA₀_et : (algebraMap R₀ ↥A₀).Etale := by
        rw [he_α]
        exact RingHom.Etale.stableUnderComposition _ _ hα_et
          (RingHom.Etale.of_bijective e_E.bijective)
      have hA₀_ker : RingHom.ker (π_cl.comp A₀.val.toRingHom) =
          Ideal.span {algebraMap R₀ ↥A₀ x₀} := by
        ext z
        obtain ⟨y, rfl⟩ := e_E.surjective z
        change (π_cl.comp A₀.val.toRingHom) (e_E.toRingHom y) = 0 ↔ _
        have h1 : (π_cl.comp A₀.val.toRingHom) (e_E.toRingHom y) = ε_E y :=
          RingHom.congr_fun he_ε y
        rw [h1, ← RingHom.mem_ker, hε_ker, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
        constructor
        · rintro ⟨w, rfl⟩
          exact ⟨e_E w, by rw [he_α, RingHom.comp_apply]; exact map_mul e_E (α_E x₀) w⟩
        · rintro ⟨w, hw⟩
          refine ⟨e_E.symm w, e_E.injective ?_⟩
          rw [map_mul]
          have hx_eq : e_E (α_E x₀) = algebraMap R₀ ↥A₀ x₀ := by
            rw [he_α]; rfl
          rw [hx_eq, e_E.apply_symm_apply]
          exact hw
      exact ⟨⟨A₀, hA₀_et, hA₀_ker⟩, e_E, he_α, he_ε, he_val⟩

    have hR₀_dom : IsDomain R₀ := by
      have hΔ_ne : Δ₀ ≠ 0 := fun h0 => hΔ₀ (by rw [h0, Polynomial.eval_zero])
      have hle : Submonoid.powers Δ₀ ≤ nonZeroDivisors P := by
        rintro _ ⟨m, rfl⟩
        exact mem_nonZeroDivisors_iff_right.mpr fun f hf =>
          (mul_eq_zero.mp hf).resolve_right (pow_ne_zero m hΔ_ne)
      exact IsLocalization.isDomain_of_le_nonZeroDivisors R₀ hle
    have heval₀_ker : RingHom.ker eval₀_loc = Ideal.span {x₀} := by
      ext r
      obtain ⟨⟨f, _, m, rfl⟩, hfr⟩ := IsLocalization.surj (Submonoid.powers Δ₀) r
      have hu_Δ : IsUnit (algebraMap P R₀ (Δ₀ ^ m)) :=
        IsLocalization.map_units R₀ (⟨Δ₀ ^ m, m, rfl⟩ : Submonoid.powers Δ₀)
      constructor
      · intro hr0
        rw [RingHom.mem_ker] at hr0
        have hf0 : Polynomial.eval 0 f = 0 := by
          have h1 := congrArg eval₀_loc hfr
          rw [map_mul, hr0, zero_mul, ← RingHom.comp_apply, heval₀_comp,
            Polynomial.coe_evalRingHom] at h1
          exact h1.symm
        obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hf0
        rw [Ideal.mem_span_singleton]
        let u_inv : R₀ˣ := hu_Δ.unit
        have hu_inv : (u_inv : R₀) = algebraMap P R₀ (Δ₀ ^ m) := rfl
        refine ⟨algebraMap P R₀ q_pol * ↑u_inv⁻¹, ?_⟩
        apply hu_Δ.mul_left_inj.mp
        calc
          r * algebraMap P R₀ (Δ₀ ^ m) = algebraMap P R₀ f := hfr
          _ = x₀ * algebraMap P R₀ q_pol := by
            rw [hq_pol, Polynomial.C_0, sub_zero, map_mul]
          _ = x₀ * algebraMap P R₀ q_pol * (↑u_inv⁻¹ * ↑u_inv) := by
            rw [Units.inv_mul, mul_one]
          _ = x₀ * (algebraMap P R₀ q_pol * ↑u_inv⁻¹) * algebraMap P R₀ (Δ₀ ^ m) := by
            rw [← hu_inv]; ring
      · rw [Ideal.mem_span_singleton, RingHom.mem_ker]
        rintro ⟨w, rfl⟩
        rw [map_mul]
        have hx0 : eval₀_loc x₀ = 0 := by
          have h1 := RingHom.congr_fun heval₀_comp Polynomial.X
          rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X] at h1
          exact h1
        rw [hx0, zero_mul]

    obtain ⟨j_bot, e_bot, he_bot_α, _, he_bot_val⟩ :=
      @hEmbedToStage R₀ _ hR₀_dom (RingHom.id R₀) eval₀_loc p_R_loc
        (RingHom.Etale.of_bijective Function.bijective_id)
        (by rwa [RingHom.id_comp])
        (by simpa [x₀] using heval₀_ker)
        (RingHom.comp_id p_R_loc) hπ_pR_loc

    have hUnivStage : ∀ (E : Type u) [CommRing E] [IsDomain E]
        (α_E : R₀ →+* E) (ε_E : E →+* k),
        α_E.Etale →
        ε_E.comp (α_E.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 →
        RingHom.ker ε_E = Ideal.span {α_E x₀} →
        ∃ (j₀ : 𝒥) (e_E : E ≃+* ↥j₀.1),
          algebraMap R₀ ↥j₀.1 = e_E.toRingHom.comp α_E ∧
          (π_cl.comp j₀.1.val.toRingHom).comp e_E.toRingHom = ε_E := by
      intro E _ _ α_E ε_E hα_et hε_comp hε_ker
      have hε_α : ε_E.comp α_E = π_cl.comp p_R_loc := by
        rw [hπ_pR_loc]
        apply IsLocalization.ringHom_ext (Submonoid.powers Δ₀)
        rw [RingHom.comp_assoc, hε_comp, heval₀_comp]
      obtain ⟨ι_E, hι_α, hπ_ι⟩ := hLift_alg R₀ E p_R_loc α_E ε_E hα_et hε_α
      obtain ⟨j₀, e_E, h1, h2, _⟩ :=
        hEmbedToStage E α_E ε_E ι_E hα_et hε_comp hε_ker hι_α hπ_ι
      exact ⟨j₀, e_E, h1, h2⟩

    have hIsFiltered_𝒥 : CategoryTheory.IsFiltered 𝒥 := by
      refine @CategoryTheory.IsFiltered.mk 𝒥 _
        { cocone_objs := fun j₁ j₂ => ?_
          cocone_maps := fun {j₁ j₂} f g => ⟨j₂, 𝟙 j₂, Subsingleton.elim _ _⟩ }
        ⟨j_bot⟩
      have : Algebra.Etale R₀ ↥j₁.1 := RingHom.etale_algebraMap.mp j₁.2.1
      have : Algebra.Etale R₀ ↥j₂.1 := RingHom.etale_algebraMap.mp j₂.2.1
      let T := TensorProduct R₀ ↥j₁.1 ↥j₂.1
      have : Algebra.Etale ↥j₁.1 T := Algebra.Etale.baseChange R₀ ↥j₂.1 ↥j₁.1
      have hAlgEt_T : Algebra.Etale R₀ T := Algebra.Etale.comp R₀ ↥j₁.1 T
      have hT_et := RingHom.etale_algebraMap.mpr hAlgEt_T
      let μ : T →ₐ[R₀] R_bar :=
        Algebra.TensorProduct.lift j₁.1.val j₂.1.val (fun _ _ => Commute.all _ _)
      let ε_T : T →+* k := π_cl.comp μ.toRingHom
      have hεT_comp : ε_T.comp ((algebraMap R₀ T).comp (algebraMap P R₀)) =
          Polynomial.evalRingHom 0 := by
        refine RingHom.ext fun f => ?_
        have h1 := μ.commutes (algebraMap P R₀ f)
        have h2 := RingHom.congr_fun hpR_loc_comp f
        have h3 := RingHom.congr_fun hπ_pR f
        simp only [ε_T, RingHom.comp_apply] at h2 h3 ⊢
        exact (congrArg π_cl h1).trans ((congrArg π_cl h2).trans h3)
      obtain ⟨g, hεT_g, hDom_ET, hKer_ET⟩ := hShrink T (algebraMap R₀ T) ε_T hT_et hεT_comp
      let E_T := Localization.Away g
      have hμg_unit : IsUnit (μ.toRingHom g) := by
        apply IsLocalRing.notMem_maximalIdeal.mp
        rw [← hπ_ker, RingHom.mem_ker]
        exact hεT_g
      have hg_unit_k : IsUnit (ε_T g) := isUnit_iff_ne_zero.mpr hεT_g
      let μ_g : E_T →+* R_bar := IsLocalization.Away.lift g hμg_unit
      let ε_ET : E_T →+* k := IsLocalization.Away.lift g hg_unit_k
      have hμg_comp : μ_g.comp (algebraMap T E_T) = μ.toRingHom :=
        RingHom.ext fun t => IsLocalization.Away.lift_eq (S := E_T) g hμg_unit t
      have hεET_comp : ε_ET.comp (algebraMap T E_T) = ε_T :=
        RingHom.ext fun t => IsLocalization.Away.lift_eq (S := E_T) g hg_unit_k t
      have hπ_μg : π_cl.comp μ_g = ε_ET := by
        apply IsLocalization.ringHom_ext (Submonoid.powers g)
        rw [RingHom.comp_assoc, hμg_comp, hεET_comp]
      let α_ET : R₀ →+* E_T := (algebraMap T E_T).comp (algebraMap R₀ T)
      have hαET_et : α_ET.Etale :=
        RingHom.Etale.stableUnderComposition _ _ hT_et
          (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway g))
      have hεET_base : ε_ET.comp (α_ET.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 := by
        dsimp [α_ET]
        rw [← RingHom.comp_assoc, ← RingHom.comp_assoc, hεET_comp, RingHom.comp_assoc, hεT_comp]
      have hμg_α : μ_g.comp α_ET = p_R_loc := by
        dsimp [α_ET]
        rw [← RingHom.comp_assoc, hμg_comp]
        exact RingHom.ext fun r => μ.commutes r
      obtain ⟨j₃, _, _, _, hj₃_val⟩ :=
        @hEmbedToStage E_T _ hDom_ET α_ET ε_ET μ_g hαET_et hεET_base
          (hKer_ET ε_ET hεET_comp) hμg_α hπ_μg
      have hle₁ : j₁ ≤ j₃ := by
        intro x hx
        have hx_eq : μ_g (algebraMap T E_T ((⟨x, hx⟩ : ↥j₁.1) ⊗ₜ[R₀] (1 : ↥j₂.1))) = x := by
          have h1 := RingHom.congr_fun hμg_comp ((⟨x, hx⟩ : ↥j₁.1) ⊗ₜ[R₀] (1 : ↥j₂.1))
          rw [RingHom.comp_apply] at h1
          rw [h1]
          change (Algebra.TensorProduct.lift j₁.1.val j₂.1.val _) ((⟨x, hx⟩ : ↥j₁.1) ⊗ₜ[R₀] (1 : ↥j₂.1)) = x
          rw [Algebra.TensorProduct.lift_tmul]
          exact mul_one x
        rw [← hj₃_val] at hx_eq
        rw [← hx_eq]
        exact SetLike.coe_mem _
      have hle₂ : j₂ ≤ j₃ := by
        intro x hx
        have hx_eq : μ_g (algebraMap T E_T ((1 : ↥j₁.1) ⊗ₜ[R₀] (⟨x, hx⟩ : ↥j₂.1))) = x := by
          have h1 := RingHom.congr_fun hμg_comp ((1 : ↥j₁.1) ⊗ₜ[R₀] (⟨x, hx⟩ : ↥j₂.1))
          rw [RingHom.comp_apply] at h1
          rw [h1]
          change (Algebra.TensorProduct.lift j₁.1.val j₂.1.val _) ((1 : ↥j₁.1) ⊗ₜ[R₀] (⟨x, hx⟩ : ↥j₂.1)) = x
          rw [Algebra.TensorProduct.lift_tmul]
          exact one_mul x
        rw [← hj₃_val] at hx_eq
        rw [← hx_eq]
        exact SetLike.coe_mem _
      exact ⟨j₃, homOfLE hle₁, homOfLE hle₂, trivial⟩
    have : CategoryTheory.IsFiltered 𝒥 := hIsFiltered_𝒥

    have hInvStage : ∀ (j : 𝒥) (a : ↥j.1), π_cl a.1 ≠ 0 →
        ∃ (j' : 𝒥) (y : R_bar), y ∈ j'.1 ∧ a.1 * y = 1 := by
      intro j a ha_ne
      let E_a := Localization.Away a
      have ha_ne0 : a ≠ 0 := fun h0 => ha_ne (by rw [h0]; exact map_zero π_cl)
      have hle_a : Submonoid.powers a ≤ nonZeroDivisors ↥j.1 := by
        rintro _ ⟨m, rfl⟩
        exact mem_nonZeroDivisors_iff_right.mpr fun b hb =>
          (mul_eq_zero.mp hb).resolve_right (pow_ne_zero m ha_ne0)
      have hDom_Ea : IsDomain E_a := IsLocalization.isDomain_of_le_nonZeroDivisors E_a hle_a
      have ha_unit_Rbar : IsUnit (j.1.val.toRingHom a) := by
        apply IsLocalRing.notMem_maximalIdeal.mp
        rw [← hπ_ker, RingHom.mem_ker]
        exact ha_ne
      have ha_unit_k : IsUnit ((π_cl.comp j.1.val.toRingHom) a) := isUnit_iff_ne_zero.mpr ha_ne
      let μ_a : E_a →+* R_bar := IsLocalization.Away.lift a ha_unit_Rbar
      let ε_a : E_a →+* k := IsLocalization.Away.lift a ha_unit_k
      have hμa_comp : μ_a.comp (algebraMap ↥j.1 E_a) = j.1.val.toRingHom :=
        RingHom.ext fun b => IsLocalization.Away.lift_eq (S := E_a) a ha_unit_Rbar b
      have hεa_comp : ε_a.comp (algebraMap ↥j.1 E_a) = π_cl.comp j.1.val.toRingHom :=
        RingHom.ext fun b => IsLocalization.Away.lift_eq (S := E_a) a ha_unit_k b
      have hπ_μa : π_cl.comp μ_a = ε_a := by
        apply IsLocalization.ringHom_ext (Submonoid.powers a)
        rw [RingHom.comp_assoc, hμa_comp, hεa_comp]
      let α_Ea : R₀ →+* E_a := (algebraMap ↥j.1 E_a).comp (algebraMap R₀ ↥j.1)
      have hloc_a_et :=
        (RingHom.etale_algebraMap (R := ↥j.1) (S := E_a)).mpr
          (Algebra.Etale.of_isLocalizationAway a)
      have hαEa_et :=
        RingHom.Etale.stableUnderComposition _ _ j.2.1 hloc_a_et
      have hεj_base : (π_cl.comp j.1.val.toRingHom).comp
          ((algebraMap R₀ ↥j.1).comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 := by
        have hj_alg : j.1.val.toRingHom.comp (algebraMap R₀ ↥j.1) = p_R_loc :=
          RingHom.ext fun r => j.1.val.commutes r
        refine RingHom.ext fun f => ?_
        have h1 := RingHom.congr_fun hj_alg (algebraMap P R₀ f)
        have h2 := RingHom.congr_fun hpR_loc_comp f
        have h3 := RingHom.congr_fun hπ_pR f
        simp only [RingHom.comp_apply] at h1 h2 h3 ⊢
        rw [h1, h2, h3]
      have hεa_base : ε_a.comp (α_Ea.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 := by
        dsimp [α_Ea]
        rw [← RingHom.comp_assoc, ← RingHom.comp_assoc, hεa_comp, RingHom.comp_assoc, hεj_base]
      have hμa_α : μ_a.comp α_Ea = p_R_loc := by
        dsimp [α_Ea]
        rw [← RingHom.comp_assoc, hμa_comp]
        exact RingHom.ext fun r => j.1.val.commutes r
      have hεa_ker : RingHom.ker ε_a = Ideal.span {α_Ea x₀} := by
        ext z
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers a) z
        have hs_unit_Ea : IsUnit (algebraMap ↥j.1 E_a s.1) := IsLocalization.map_units E_a s
        constructor
        · intro hz0
          rw [RingHom.mem_ker] at hz0
          have hb_ker : b ∈ RingHom.ker (π_cl.comp j.1.val.toRingHom) := by
            rw [RingHom.mem_ker, ← hεa_comp, RingHom.comp_apply, ← hbs, map_mul, hz0, zero_mul]
          rw [j.2.2, Ideal.mem_span_singleton] at hb_ker
          obtain ⟨w, rfl⟩ := hb_ker
          rw [Ideal.mem_span_singleton]
          let u_s : E_aˣ := hs_unit_Ea.unit
          have hu_s : (u_s : E_a) = algebraMap ↥j.1 E_a s.1 := rfl
          refine ⟨algebraMap ↥j.1 E_a w * ↑u_s⁻¹, ?_⟩
          apply hs_unit_Ea.mul_left_inj.mp
          calc
            z * algebraMap ↥j.1 E_a s.1 =
                algebraMap ↥j.1 E_a (algebraMap R₀ ↥j.1 x₀ * w) := hbs
            _ = α_Ea x₀ * (algebraMap ↥j.1 E_a w * ↑u_s⁻¹) * algebraMap ↥j.1 E_a s.1 := by
              dsimp [α_Ea]; rw [map_mul, ← hu_s]
              calc
                algebraMap ↥j.1 E_a (algebraMap R₀ ↥j.1 x₀) * algebraMap ↥j.1 E_a w =
                    algebraMap ↥j.1 E_a (algebraMap R₀ ↥j.1 x₀) * algebraMap ↥j.1 E_a w *
                      (↑u_s⁻¹ * ↑u_s) := by rw [Units.inv_mul, mul_one]
                _ = algebraMap ↥j.1 E_a (algebraMap R₀ ↥j.1 x₀) *
                      (algebraMap ↥j.1 E_a w * ↑u_s⁻¹) * ↑u_s := by ring
        · rw [Ideal.mem_span_singleton, RingHom.mem_ker]
          rintro ⟨w, rfl⟩
          rw [map_mul]
          have hx0 : ε_a (α_Ea x₀) = 0 := by
            have h1 := RingHom.congr_fun hεa_base Polynomial.X
            rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X] at h1
            exact h1
          rw [hx0, zero_mul]
      obtain ⟨j', _, _, _, hj'_val⟩ :=
        @hEmbedToStage E_a _ hDom_Ea α_Ea ε_a μ_a hαEa_et hεa_base hεa_ker hμa_α hπ_μa
      let inv_a : E_a := IsLocalization.Away.invSelf a
      refine ⟨j', μ_a inv_a, ?_, ?_⟩
      · rw [← hj'_val]
        exact SetLike.coe_mem _
      · have hmul : algebraMap ↥j.1 E_a a * inv_a = 1 := IsLocalization.Away.mul_invSelf a
        have hmap := congrArg μ_a hmul
        rw [map_mul, map_one, ← RingHom.comp_apply, hμa_comp] at hmap
        exact hmap

    let R_s_sub : Subring R_bar :=
      { carrier := {x : R_bar | ∃ j : 𝒥, x ∈ j.1}
        mul_mem' := fun {a b} ⟨j₁, ha⟩ ⟨j₂, hb⟩ =>
          let jm := CategoryTheory.IsFiltered.max j₁ j₂
          have h₁ : j₁.1 ≤ jm.1 := leOfHom (CategoryTheory.IsFiltered.leftToMax j₁ j₂)
          have h₂ : j₂.1 ≤ jm.1 := leOfHom (CategoryTheory.IsFiltered.rightToMax j₁ j₂)
          ⟨jm, jm.1.mul_mem (h₁ ha) (h₂ hb)⟩
        one_mem' := ⟨j_bot, j_bot.1.one_mem⟩
        add_mem' := fun {a b} ⟨j₁, ha⟩ ⟨j₂, hb⟩ =>
          let jm := CategoryTheory.IsFiltered.max j₁ j₂
          have h₁ : j₁.1 ≤ jm.1 := leOfHom (CategoryTheory.IsFiltered.leftToMax j₁ j₂)
          have h₂ : j₂.1 ≤ jm.1 := leOfHom (CategoryTheory.IsFiltered.rightToMax j₁ j₂)
          ⟨jm, jm.1.add_mem (h₁ ha) (h₂ hb)⟩
        zero_mem' := ⟨j_bot, j_bot.1.zero_mem⟩
        neg_mem' := fun {a} ⟨j, ha⟩ => ⟨j, j.1.neg_mem ha⟩ }

    let R_s := ↥R_s_sub
    let ι_Rbar : R_s →+* R_bar := R_s_sub.subtype
    have hι_Rbar_inj : Function.Injective ι_Rbar := Subtype.val_injective
    let incl_st : ∀ j : 𝒥, ↥j.1 →+* R_s := fun j =>
      { toFun := fun a => ⟨a.1, j, a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let p_Rs_loc : R₀ →+* R_s := (incl_st j_bot).comp (algebraMap R₀ ↥j_bot.1)
    have hι_pRs_loc : ι_Rbar.comp p_Rs_loc = p_R_loc :=
      RingHom.ext fun r => j_bot.1.val.commutes r
    let p_Rs : P →+* R_s := p_Rs_loc.comp (algebraMap P R₀)
    have hι_pRs : ι_Rbar.comp p_Rs = p_R := by
      dsimp [p_Rs]
      rw [← RingHom.comp_assoc, hι_pRs_loc, hpR_loc_comp]
    let t_s : R_s := p_Rs Polynomial.X
    have hι_ts : ι_Rbar t_s = t_bar := by
      dsimp [t_s]
      rw [← RingHom.comp_apply, hι_pRs, hpR_X]
    have hts_ne : t_s ≠ 0 := fun h0 => ht_bar_ne (hι_ts ▸ congrArg ι_Rbar h0)
    let π_s : R_s →+* k := π_cl.comp ι_Rbar
    have hπs_surj : Function.Surjective π_s := fun c =>
      ⟨p_Rs (Polynomial.C c), by
        have h1 := RingHom.congr_fun hπ_pR (Polynomial.C c)
        rw [← hι_pRs, ← RingHom.comp_assoc] at h1
        rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C] at h1
        exact h1⟩

    have hUnit_Rs : ∀ x : R_s, IsUnit x ↔ π_s x ≠ 0 := by
      intro x
      constructor
      · intro hx h0
        exact (hx.map π_s).ne_zero h0
      · intro hne
        obtain ⟨j, hxj⟩ := x.2
        obtain ⟨j', y, hy_j', hxy⟩ := hInvStage j ⟨x.1, hxj⟩ hne
        exact IsUnit.of_mul_eq_one ⟨y, j', hy_j'⟩ (Subtype.ext hxy)

    have hLocRing_Rs : IsLocalRing R_s := IsLocalRing.of_nonunits_add fun a b ha hb => by
      rw [mem_nonunits_iff, hUnit_Rs, not_not] at ha hb ⊢
      rw [map_add, ha, hb, add_zero]
    have : IsLocalRing R_s := hLocRing_Rs
    have hπs_ker : RingHom.ker π_s = IsLocalRing.maximalIdeal R_s :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective π_s hπs_surj)

    have hVal_Rs : ∀ x : R_s, x ≠ 0 → ∃ (n : ℕ) (u : R_sˣ), x = ↑u * t_s ^ n := by
      intro x hx_ne
      obtain ⟨j, hxj⟩ := x.2
      have hεj_base : (π_cl.comp j.1.val.toRingHom).comp
          ((algebraMap R₀ ↥j.1).comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 := by
        refine RingHom.ext fun f => ?_
        have h1 : j.1.val (algebraMap R₀ ↥j.1 (algebraMap P R₀ f)) = p_R_loc (algebraMap P R₀ f) :=
          j.1.val.commutes _
        have h2 := RingHom.congr_fun hpR_loc_comp f
        have h3 := RingHom.congr_fun hπ_pR f
        simp only [RingHom.comp_apply] at h2 h3 ⊢
        exact (congrArg π_cl h1).trans ((congrArg π_cl h2).trans h3)
      have hxj_ne : (⟨x.1, hxj⟩ : ↥j.1) ≠ 0 := fun h0 =>
        hx_ne (Subtype.ext (congrArg Subtype.val h0 : x.1 = 0))
      obtain ⟨n, b, s, hb_ne, hs_ne, hse⟩ :=
        (hValDecomp ↥j.1 (algebraMap R₀ ↥j.1) (π_cl.comp j.1.val.toRingHom)
          j.2.1 hεj_base j.2.2).1 ⟨x.1, hxj⟩ hxj_ne
      have hub : IsUnit (incl_st j b) := (hUnit_Rs _).mpr hb_ne
      have hus : IsUnit (incl_st j s) := (hUnit_Rs _).mpr hs_ne
      let u : R_sˣ := hub.unit * hus.unit⁻¹
      refine ⟨n, u, ?_⟩
      apply hus.mul_right_inj.mp
      have hincl_x₀ : incl_st j (algebraMap R₀ ↥j.1 x₀) = t_s := by
        apply hι_Rbar_inj
        rw [hι_ts]
        change j.1.val (algebraMap R₀ ↥j.1 x₀) = t_bar
        rw [j.1.val.commutes]
        exact hpR_loc_x₀
      have hmap := congrArg (incl_st j) hse
      rw [map_mul, map_mul, map_pow, hincl_x₀] at hmap
      have h_eq_x : incl_st j ⟨x.1, hxj⟩ = x := rfl
      rw [h_eq_x] at hmap
      have hs_inv : incl_st j s * ↑hus.unit⁻¹ = 1 := Units.mul_inv hus.unit
      have hu_val : (↑u : R_s) = incl_st j b * ↑hus.unit⁻¹ := rfl
      calc
        incl_st j s * x = 1 * (incl_st j b * t_s ^ n) := by rw [one_mul, hmap]
        _ = (incl_st j s * ↑hus.unit⁻¹) * (incl_st j b * t_s ^ n) := by rw [hs_inv]
        _ = incl_st j s * (↑u * t_s ^ n) := by rw [hu_val]; ring

    have hts_mem_max : t_s ∈ IsLocalRing.maximalIdeal R_s := by
      rw [← hπs_ker, RingHom.mem_ker]
      change π_cl (ι_Rbar t_s) = 0
      rw [hι_ts, ← hpR_X, ← RingHom.comp_apply, hπ_pR, Polynomial.coe_evalRingHom, Polynomial.eval_X]

    have hmax_Rs : IsLocalRing.maximalIdeal R_s = Ideal.span {t_s} := by
      apply le_antisymm _ ((Ideal.span_singleton_le_iff_mem _).mpr hts_mem_max)
      intro x hx
      by_cases hx0 : x = 0
      · rw [hx0]; exact Ideal.zero_mem _
      · obtain ⟨n, u, rfl⟩ := hVal_Rs x hx0
        cases n with
        | zero =>
          rw [pow_zero, mul_one] at hx
          exact False.elim (IsLocalRing.notMem_maximalIdeal.mpr u.isUnit hx)
        | succ k =>
          rw [pow_succ, ← mul_assoc, Ideal.mem_span_singleton]
          exact ⟨↑u * t_s ^ k, mul_comm _ _⟩

    have hPIR_Rs : IsPrincipalIdealRing R_s := ⟨fun I => by
      by_cases hI : I = ⊥
      · rw [hI]; exact ⟨⟨0, by simp⟩⟩
      · obtain ⟨x₀_I, hx₀_mem, hx₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
        obtain ⟨n_x, u_x, hux⟩ := hVal_Rs x₀_I hx₀_ne
        have hex_n : ∃ n : ℕ, t_s ^ n ∈ I := ⟨n_x, by
          have h1 := I.mul_mem_left (↑u_x⁻¹ : R_s) hx₀_mem
          rwa [hux, ← mul_assoc, Units.inv_mul, one_mul] at h1⟩
        let n₀ := Nat.find hex_n
        have hn₀_mem : t_s ^ n₀ ∈ I := Nat.find_spec hex_n
        refine ⟨⟨t_s ^ n₀, ?_⟩⟩
        change I = Ideal.span {t_s ^ n₀}
        apply le_antisymm _ ((Ideal.span_singleton_le_iff_mem I).mpr hn₀_mem)
        intro z hz
        by_cases hz0 : z = 0
        · rw [hz0]; exact Ideal.zero_mem _
        · obtain ⟨m, v, rfl⟩ := hVal_Rs z hz0
          have hpow_I : t_s ^ m ∈ I := by
            have h1 := I.mul_mem_left (↑v⁻¹ : R_s) hz
            rwa [← mul_assoc, Units.inv_mul, one_mul] at h1
          have hle_m : n₀ ≤ m := Nat.find_min' hex_n hpow_I
          rw [Ideal.mem_span_singleton]
          refine ⟨↑v * t_s ^ (m - n₀), ?_⟩
          calc
            ↑v * t_s ^ m = ↑v * (t_s ^ (m - n₀) * t_s ^ n₀) := by
              rw [← pow_add, Nat.sub_add_cancel hle_m]
            _ = t_s ^ n₀ * (↑v * t_s ^ (m - n₀)) := by ring⟩
    have : IsPrincipalIdealRing R_s := hPIR_Rs

    have hmax_Rs_ne_bot : IsLocalRing.maximalIdeal R_s ≠ ⊥ := by
      intro hbot
      exact hts_ne (Ideal.mem_bot.mp (hbot ▸ hts_mem_max))
    have hDVR_Rs : IsDiscreteValuationRing R_s := IsDiscreteValuationRing.mk hmax_Rs_ne_bot
    have : IsDiscreteValuationRing R_s := hDVR_Rs

    have hFinStage : ∀ S : Finset R_s, ∃ j : 𝒥, ∀ x ∈ S, x.1 ∈ j.1 := by
      intro S
      induction S using Finset.induction_on with
      | empty => exact ⟨j_bot, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert x S _ ih =>
        obtain ⟨j₁, hj₁⟩ := x.2
        obtain ⟨j₂, hj₂⟩ := ih
        let jm := CategoryTheory.IsFiltered.max j₁ j₂
        have h₁ : j₁.1 ≤ jm.1 := leOfHom (CategoryTheory.IsFiltered.leftToMax j₁ j₂)
        have h₂ : j₂.1 ≤ jm.1 := leOfHom (CategoryTheory.IsFiltered.rightToMax j₁ j₂)
        refine ⟨jm, fun y hy => ?_⟩
        rcases Finset.mem_insert.mp hy with rfl | hyS
        · exact h₁ hj₁
        · exact h₂ (hj₂ y hyS)

    have hHens_Rs : HenselianLocalRing R_s := HenselianLocalRing.mk fun f hf a₀ ha₀ hderiv => by
      let S_coeff : Finset R_s := insert a₀ ((Finset.range (f.natDegree + 1)).image f.coeff)
      obtain ⟨j, hj⟩ := hFinStage S_coeff
      have ha₀_j : a₀.1 ∈ j.1 := hj a₀ (Finset.mem_insert_self _ _)
      have hcoeff_j : ∀ d : ℕ, (f.coeff d).1 ∈ j.1 := by
        intro d
        by_cases hd : d < f.natDegree + 1
        · exact hj (f.coeff d) (Finset.mem_insert_of_mem
            (Finset.mem_image.mpr ⟨d, Finset.mem_range.mpr hd, rfl⟩))
        · have hgt : f.natDegree < d := by omega
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt hgt]
          exact j.1.zero_mem
      let N := f.natDegree
      let F : Polynomial ↥j.1 :=
        ∑ d ∈ Finset.range (N + 1), Polynomial.monomial d ⟨(f.coeff d).1, hcoeff_j d⟩
      have hF_coeff : ∀ d : ℕ, F.coeff d = ⟨(f.coeff d).1, hcoeff_j d⟩ := by
        intro d
        dsimp [F]
        rw [Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_monomial]
        by_cases hd : d < N + 1
        · rw [Finset.sum_eq_single d]
          · simp
          · intro b _ hb; exact if_neg hb
          · intro hnot; exact False.elim (hnot (Finset.mem_range.mpr hd))
        · rw [Finset.sum_eq_zero]
          · have hgt : f.natDegree < d := by omega
            have hc0 : (f.coeff d).1 = 0 :=
              congrArg Subtype.val (Polynomial.coeff_eq_zero_of_natDegree_lt hgt)
            exact (Subtype.ext hc0).symm
          · intro b hb
            have hne : b ≠ d := by have := Finset.mem_range.mp hb; omega
            exact if_neg hne
      have hF_map : F.map (incl_st j) = f := by
        ext d
        rw [Polynomial.coeff_map, hF_coeff d]
        rfl
      have hF_monic : F.Monic := by
        apply Polynomial.monic_of_natDegree_le_of_coeff_eq_one N
        · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
          intro d hd
          rw [hF_coeff d]
          have hc0 : (f.coeff d).1 = 0 :=
            congrArg Subtype.val (Polynomial.coeff_eq_zero_of_natDegree_lt hd)
          exact Subtype.ext hc0
        · rw [hF_coeff N]
          have hc1 : (f.coeff N).1 = 1 := congrArg Subtype.val hf.leadingCoeff
          exact Subtype.ext hc1
      let a_tilde : ↥j.1 := ⟨a₀.1, ha₀_j⟩
      let ε_j : ↥j.1 →+* k := π_cl.comp j.1.val.toRingHom
      have hεj_incl : π_s.comp (incl_st j) = ε_j := rfl
      have hF_eval0 : ε_j (Polynomial.eval a_tilde F) = 0 := by
        have h1 : incl_st j (Polynomial.eval a_tilde F) = Polynomial.eval a₀ f := by
          rw [← hF_map, Polynomial.eval_map]
          have h2 := Polynomial.hom_eval₂ F (RingHom.id ↥j.1) (incl_st j) a_tilde
          rw [RingHom.comp_id] at h2
          exact h2
        rw [← hεj_incl, RingHom.comp_apply, h1, ← RingHom.mem_ker, hπs_ker]
        exact ha₀
      have hF_deriv_ne : ε_j (Polynomial.eval a_tilde (Polynomial.derivative F)) ≠ 0 := by
        have h1 : incl_st j (Polynomial.eval a_tilde (Polynomial.derivative F)) =
            Polynomial.eval a₀ (Polynomial.derivative f) := by
          rw [← hF_map, Polynomial.derivative_map, Polynomial.eval_map]
          have h2 := Polynomial.hom_eval₂ (Polynomial.derivative F) (RingHom.id ↥j.1)
            (incl_st j) a_tilde
          rw [RingHom.comp_id] at h2
          exact h2
        rw [← hεj_incl, RingHom.comp_apply, h1]
        exact (hUnit_Rs _).mp hderiv
      let P_et : StandardEtalePair ↥j.1 :=
        StandardEtalePair.mk F hF_monic (Polynomial.derivative F) ⟨1, 0, 1, by simp⟩
      let E₀_et := P_et.Ring
      have : Algebra.Etale ↥j.1 E₀_et := inferInstance
      have : Algebra.Etale R₀ ↥j.1 := RingHom.etale_algebraMap.mp j.2.1
      let _ : Algebra R₀ E₀_et := ((algebraMap ↥j.1 E₀_et).comp (algebraMap R₀ ↥j.1)).toAlgebra
      have _ : IsScalarTower R₀ ↥j.1 E₀_et := IsScalarTower.of_algebraMap_eq' rfl
      have hAlgEt_E0 : Algebra.Etale R₀ E₀_et := Algebra.Etale.comp R₀ ↥j.1 E₀_et
      have hα₀_et := RingHom.etale_algebraMap.mpr hAlgEt_E0
      let _ : Algebra ↥j.1 k := ε_j.toAlgebra
      have hHasMap_k : P_et.HasMap (ε_j a_tilde) := by
        refine ⟨?_, ?_⟩
        · change Polynomial.eval₂ ε_j (ε_j a_tilde) F = 0
          have h1 := Polynomial.hom_eval₂ F (RingHom.id ↥j.1) ε_j a_tilde
          rw [RingHom.comp_id] at h1
          exact h1.symm.trans hF_eval0
        · change IsUnit (Polynomial.eval₂ ε_j (ε_j a_tilde) (Polynomial.derivative F))
          have h1 := Polynomial.hom_eval₂ (Polynomial.derivative F) (RingHom.id ↥j.1) ε_j a_tilde
          rw [RingHom.comp_id] at h1
          rw [← h1]
          exact isUnit_iff_ne_zero.mpr hF_deriv_ne
      let lift_k : E₀_et →ₐ[↥j.1] k := P_et.lift (ε_j a_tilde) hHasMap_k
      let ε₀_et : E₀_et →+* k := lift_k.toRingHom
      have hε₀_j : ε₀_et.comp (algebraMap ↥j.1 E₀_et) = ε_j :=
        RingHom.ext fun b => lift_k.commutes b
      have hε₀_base : ε₀_et.comp ((algebraMap R₀ E₀_et).comp (algebraMap P R₀)) =
          Polynomial.evalRingHom 0 := by
        refine RingHom.ext fun p => ?_
        have h1 := RingHom.congr_fun hε₀_j (algebraMap R₀ ↥j.1 (algebraMap P R₀ p))
        have h2 : j.1.val (algebraMap R₀ ↥j.1 (algebraMap P R₀ p)) = p_R_loc (algebraMap P R₀ p) :=
          j.1.val.commutes _
        have h3 := RingHom.congr_fun hpR_loc_comp p
        have h4 := RingHom.congr_fun hπ_pR p
        simp only [RingHom.comp_apply] at h1 h3 h4 ⊢
        exact h1.trans ((congrArg π_cl h2).trans ((congrArg π_cl h3).trans h4))
      obtain ⟨g_sh, hε₀_gsh, hDom_Esh, hKer_Esh⟩ :=
        hShrink E₀_et (algebraMap R₀ E₀_et) ε₀_et hα₀_et hε₀_base
      let E_sh := Localization.Away g_sh
      have hgsh_unit_k : IsUnit (ε₀_et g_sh) := isUnit_iff_ne_zero.mpr hε₀_gsh
      let ε_Esh : E_sh →+* k := IsLocalization.Away.lift g_sh hgsh_unit_k
      have hεEsh_comp : ε_Esh.comp (algebraMap E₀_et E_sh) = ε₀_et :=
        RingHom.ext fun z => IsLocalization.Away.lift_eq (S := E_sh) g_sh hgsh_unit_k z
      let w_sh : ↥j.1 →+* E_sh := (algebraMap E₀_et E_sh).comp (algebraMap ↥j.1 E₀_et)
      have hw_sh_et :=
        RingHom.Etale.stableUnderComposition (algebraMap ↥j.1 E₀_et) (algebraMap E₀_et E_sh)
          ((RingHom.etale_algebraMap (R := ↥j.1) (S := E₀_et)).mpr
            (inferInstance : Algebra.Etale ↥j.1 E₀_et))
          ((RingHom.etale_algebraMap (R := E₀_et) (S := E_sh)).mpr
            (Algebra.Etale.of_isLocalizationAway g_sh))
      have hεEsh_w : ε_Esh.comp w_sh = π_cl.comp j.1.val.toRingHom := by
        dsimp [w_sh]
        rw [← RingHom.comp_assoc, hεEsh_comp, hε₀_j]
        rfl
      obtain ⟨ι_Esh, hι_w, hπ_ιEsh⟩ :=
        hLift_alg ↥j.1 E_sh j.1.val.toRingHom w_sh ε_Esh hw_sh_et hεEsh_w
      let α_Esh : R₀ →+* E_sh := w_sh.comp (algebraMap R₀ ↥j.1)
      have hαEsh_et : α_Esh.Etale := RingHom.Etale.stableUnderComposition _ _ j.2.1 hw_sh_et
      have hεEsh_base : ε_Esh.comp (α_Esh.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 := by
        have hα_eq : α_Esh = (algebraMap E₀_et E_sh).comp (algebraMap R₀ E₀_et) := rfl
        rw [hα_eq, ← RingHom.comp_assoc, ← RingHom.comp_assoc, hεEsh_comp,
          RingHom.comp_assoc, hε₀_base]
      have hι_αEsh : ι_Esh.comp α_Esh = p_R_loc := by
        dsimp [α_Esh]
        rw [← RingHom.comp_assoc, hι_w]
        exact RingHom.ext fun r => j.1.val.commutes r
      obtain ⟨j_sh, _, _, _, hjsh_val⟩ :=
        @hEmbedToStage E_sh _ hDom_Esh α_Esh ε_Esh ι_Esh hαEsh_et hεEsh_base
          (hKer_Esh ε_Esh hεEsh_comp) hι_αEsh hπ_ιEsh
      let y_sh : E_sh := algebraMap E₀_et E_sh P_et.X
      have hy_mem : ι_Esh y_sh ∈ j_sh.1 := by
        rw [← hjsh_val]
        exact SetLike.coe_mem _
      let a : R_s := ⟨ι_Esh y_sh, j_sh, hy_mem⟩
      refine ⟨a, ?_, ?_⟩
      · rw [Polynomial.IsRoot.def]
        apply hι_Rbar_inj
        rw [map_zero]
        have hroot_X : Polynomial.eval₂ (algebraMap ↥j.1 E₀_et) P_et.X F = 0 := P_et.hasMap_X.1
        have hmap1 := congrArg (ι_Esh.comp (algebraMap E₀_et E_sh)) hroot_X
        have hcomp_j : (ι_Esh.comp (algebraMap E₀_et E_sh)).comp (algebraMap ↥j.1 E₀_et) =
            ι_Rbar.comp (incl_st j) := by
          rw [RingHom.comp_assoc, hι_w]
          rfl
        rw [Polynomial.hom_eval₂, hcomp_j, map_zero] at hmap1
        have heval_eq : ι_Rbar (Polynomial.eval a f) =
            Polynomial.eval₂ (ι_Rbar.comp (incl_st j)) (ι_Rbar a) F := by
          rw [← hF_map, Polynomial.eval_map,
            Polynomial.hom_eval₂ F (incl_st j) ι_Rbar a]
        rw [heval_eq]
        exact hmap1
      · rw [← hπs_ker, RingHom.mem_ker, map_sub]
        have hπa : π_s a = ε_j a_tilde := by
          change π_cl (ι_Esh y_sh) = _
          have h1 := RingHom.congr_fun hπ_ιEsh y_sh
          have h2 := RingHom.congr_fun hεEsh_comp P_et.X
          simp only [RingHom.comp_apply] at h1 h2
          rw [h1, h2]
          exact P_et.lift_X (ε_j a_tilde) hHasMap_k
        have hπa0 : π_s a₀ = ε_j a_tilde := rfl
        rw [hπa, hπa0, sub_self]
    have : HenselianLocalRing R_s := hHens_Rs

    let K_s := Localization.Away t_s
    let ι_RK : R_s →+* K_s := algebraMap R_s K_s
    have hle_ts : Submonoid.powers t_s ≤ nonZeroDivisors R_s := by
      rintro _ ⟨m, rfl⟩
      exact mem_nonZeroDivisors_iff_right.mpr fun b hb =>
        (mul_eq_zero.mp hb).resolve_right (pow_ne_zero m hts_ne)
    have _ : IsDomain K_s := IsLocalization.isDomain_of_le_nonZeroDivisors K_s hle_ts
    have hIsField_Ks : IsField K_s :=
      { exists_pair_ne := ⟨0, 1, zero_ne_one⟩
        mul_comm := mul_comm
        mul_inv_cancel := fun {z} hz => by
          obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj (Submonoid.powers t_s) z
          have hr_ne : r ≠ 0 := by
            intro hr0
            rw [hr0, map_zero] at hrs
            exact hz ((IsLocalization.map_units K_s s).mul_left_eq_zero.mp hrs)
          obtain ⟨n, u, rfl⟩ := hVal_Rs r hr_ne
          have hu_K : IsUnit (ι_RK ↑u) := u.isUnit.map ι_RK
          have hts_K : IsUnit (ι_RK t_s ^ n) := (IsLocalization.Away.algebraMap_isUnit t_s).pow n
          have hs_K : IsUnit (ι_RK s.1) := IsLocalization.map_units K_s s
          have hz_unit : IsUnit z := by
            have hprod_unit : IsUnit (z * ι_RK s.1) := by
              rw [hrs, map_mul, map_pow]
              exact hu_K.mul hts_K
            obtain ⟨v, hv⟩ := hs_K
            have h1 : z = (z * ι_RK s.1) * ↑v⁻¹ := by
              rw [mul_assoc, ← hv, Units.mul_inv, mul_one]
            rw [h1]
            exact hprod_unit.mul v⁻¹.isUnit
          obtain ⟨w, rfl⟩ := hz_unit
          exact ⟨↑w⁻¹, Units.mul_inv w⟩ }
    let _ : Field K_s := hIsField_Ks.toField

    have hLoc_Ks : @IsLocalization.Away R_s _ t_s K_s _ ι_RK.toAlgebra := by
      convert (inferInstance : IsLocalization.Away t_s K_s)
      exact Algebra.algebra_ext _ _ fun _ => rfl

    have hts_unit_Ω : IsUnit ((φ_R_Ω.comp ι_Rbar) t_s) := by
      apply isUnit_iff_ne_zero.mpr
      rw [RingHom.comp_apply, hι_ts]
      exact fun h0 => ht_bar_ne (hφ_inj (h0.trans (map_zero _).symm))
    let ι_KΩ : K_s →+* Ω := IsLocalization.Away.lift t_s hts_unit_Ω
    have hφ_ιKΩ : φ_R_Ω.comp ι_Rbar = ι_KΩ.comp ι_RK :=
      (RingHom.ext fun x => IsLocalization.Away.lift_eq (S := K_s) t_s hts_unit_Ω x).symm

    have hx₀_ts : p_Rs_loc x₀ = t_s := rfl
    have hx₀_unit_Ks : IsUnit ((ι_RK.comp p_Rs_loc) x₀) := by
      rw [RingHom.comp_apply, hx₀_ts]
      exact IsLocalization.Away.algebraMap_isUnit t_s
    let p_Ks_loc : Localization.Away x₀ →+* K_s := IsLocalization.Away.lift x₀ hx₀_unit_Ks
    have hpKs_loc_comp : p_Ks_loc.comp (algebraMap R₀ (Localization.Away x₀)) =
        ι_RK.comp p_Rs_loc :=
      RingHom.ext fun r => IsLocalization.Away.lift_eq (S := Localization.Away x₀) x₀ hx₀_unit_Ks r

    let x_st : ∀ j : 𝒥, ↥j.1 := fun j => algebraMap R₀ ↥j.1 x₀
    let B_st : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of ↥j.1
        map := fun {j₁ j₂} θ => CommRingCat.ofHom (Subalgebra.inclusion (leOfHom θ)).toRingHom
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }

    have hx_st_map : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂),
        (B_st.map θ).hom (x_st j₁) = x_st j₂ := fun θ =>
      (Subalgebra.inclusion (leOfHom θ)).commutes x₀

    have hx_st_unit_map : ∀ {j₁ j₂ : 𝒥} (θ : j₁ ⟶ j₂),
        IsUnit (((algebraMap ↥j₂.1 (Localization.Away (x_st j₂))).comp (B_st.map θ).hom) (x_st j₁)) := by
      intro j₁ j₂ θ
      rw [RingHom.comp_apply, hx_st_map θ]
      exact IsLocalization.Away.algebraMap_isUnit (x_st j₂)

    let B_open : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of (Localization.Away (x_st j))
        map := fun {j₁ j₂} θ =>
          CommRingCat.ofHom (IsLocalization.Away.lift (x_st j₁) (hx_st_unit_map θ))
        map_id := fun j => by
          suffices h : IsLocalization.Away.lift (x_st j) (hx_st_unit_map (𝟙 j)) =
              RingHom.id (Localization.Away (x_st j)) from
            CommRingCat.hom_ext h
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_st j))
          refine RingHom.ext fun a => ?_
          have h1 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j))
            (x_st j) (hx_st_unit_map (𝟙 j)) a
          exact h1
        map_comp := fun {j₁ j₂ j₃} θ₁ θ₂ => by
          suffices h : IsLocalization.Away.lift (x_st j₁) (hx_st_unit_map (θ₁ ≫ θ₂)) =
              (IsLocalization.Away.lift (x_st j₂) (hx_st_unit_map θ₂)).comp
                (IsLocalization.Away.lift (x_st j₁) (hx_st_unit_map θ₁)) from
            CommRingCat.hom_ext h
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_st j₁))
          refine RingHom.ext fun a => ?_
          have h1 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₁))
            (x_st j₁) (hx_st_unit_map (θ₁ ≫ θ₂)) a
          have h2 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₁))
            (x_st j₁) (hx_st_unit_map θ₁) a
          have h3 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₂))
            (x_st j₂) (hx_st_unit_map θ₂) ((B_st.map θ₁).hom a)
          simp only [RingHom.comp_apply] at h1 h2 h3 ⊢
          rw [h1, h2]
          exact h3.symm }

    let α_st : (CategoryTheory.Functor.const 𝒥).obj (CommRingCat.of R₀) ⟶ B_st :=
      { app := fun j => CommRingCat.ofHom (algebraMap R₀ ↥j.1)
        naturality := fun _ _ θ => by
          apply CommRingCat.hom_ext
          exact RingHom.ext fun r => ((Subalgebra.inclusion (leOfHom θ)).commutes r).symm }

    let loc_st : B_st ⟶ B_open :=
      { app := fun j => CommRingCat.ofHom (algebraMap ↥j.1 (Localization.Away (x_st j)))
        naturality := fun {j₁ j₂} θ => by
          apply CommRingCat.hom_ext
          refine RingHom.ext fun a => ?_
          exact (IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₁))
            (x_st j₁) (hx_st_unit_map θ) a).symm }

    have hx₀_unit_Bop : ∀ j : 𝒥,
        IsUnit (((algebraMap ↥j.1 (Localization.Away (x_st j))).comp (algebraMap R₀ ↥j.1)) x₀) :=
      fun j => IsLocalization.Away.algebraMap_isUnit (x_st j)

    let α_op : (CategoryTheory.Functor.const 𝒥).obj (CommRingCat.of (Localization.Away x₀)) ⟶
        B_open :=
      { app := fun j => CommRingCat.ofHom (IsLocalization.Away.lift x₀ (hx₀_unit_Bop j))
        naturality := fun {j₁ j₂} θ => by
          dsimp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map]
          rw [CategoryTheory.Category.id_comp]
          suffices h : IsLocalization.Away.lift x₀ (hx₀_unit_Bop j₂) =
              (IsLocalization.Away.lift (x_st j₁) (hx_st_unit_map θ)).comp
                (IsLocalization.Away.lift x₀ (hx₀_unit_Bop j₁)) from
            CommRingCat.hom_ext h
          apply IsLocalization.ringHom_ext (Submonoid.powers x₀)
          refine RingHom.ext fun r => ?_
          have h1 := IsLocalization.Away.lift_eq (S := Localization.Away x₀) x₀ (hx₀_unit_Bop j₂) r
          have h2 := IsLocalization.Away.lift_eq (S := Localization.Away x₀) x₀ (hx₀_unit_Bop j₁) r
          have h3 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₁))
            (x_st j₁) (hx_st_unit_map θ) (algebraMap R₀ ↥j₁.1 r)
          simp only [RingHom.comp_apply] at h1 h2 h3 ⊢
          rw [h1, h2, h3]
          exact congrArg (algebraMap ↥j₂.1 _) ((Subalgebra.inclusion (leOfHom θ)).commutes r).symm }

    let ε_st : ∀ j : 𝒥, ↑(B_st.obj j) →+* k := fun j => π_cl.comp j.1.val.toRingHom

    let c_st : CategoryTheory.Limits.Cocone B_st :=
      { pt := CommRingCat.of R_s
        ι :=
          { app := fun j => CommRingCat.ofHom (incl_st j)
            naturality := fun _ _ _ => rfl } }
    let e_Rs : c_st.pt ≅ CommRingCat.of R_s := CategoryTheory.Iso.refl _

    have hc_st : CategoryTheory.Limits.IsColimit c_st :=
      { desc := fun s => CommRingCat.ofHom
          { toFun := fun x => (s.ι.app (Classical.choose x.2)).hom ⟨x.1, Classical.choose_spec x.2⟩
            map_one' := map_one (s.ι.app (Classical.choose R_s_sub.one_mem)).hom
            map_mul' := fun x y => by
              let jx := Classical.choose x.2
              let jy := Classical.choose y.2
              let jxy := Classical.choose (R_s_sub.mul_mem x.2 y.2)
              let jm := CategoryTheory.IsFiltered.max (CategoryTheory.IsFiltered.max jx jy) jxy
              have h_align : ∀ (j₁ j₂ : 𝒥) (a₁ : ↥j₁.1) (a₂ : ↥j₂.1), a₁.1 = a₂.1 →
                  (s.ι.app j₁).hom a₁ = (s.ι.app j₂).hom a₂ := by
                intro j₁ j₂ a₁ a₂ heq
                let j₃ := CategoryTheory.IsFiltered.max j₁ j₂
                let θ₁ : j₁ ⟶ j₃ := CategoryTheory.IsFiltered.leftToMax j₁ j₂
                let θ₂ : j₂ ⟶ j₃ := CategoryTheory.IsFiltered.rightToMax j₁ j₂
                have hw1 := s.w θ₁
                have hw2 := s.w θ₂
                have hm : (B_st.map θ₁).hom a₁ = (B_st.map θ₂).hom a₂ := Subtype.ext heq
                calc
                  (s.ι.app j₁).hom a₁ = (B_st.map θ₁ ≫ s.ι.app j₃).hom a₁ :=
                    congrArg (fun f => f.hom a₁) hw1.symm
                  _ = (s.ι.app j₃).hom ((B_st.map θ₁).hom a₁) := rfl
                  _ = (s.ι.app j₃).hom ((B_st.map θ₂).hom a₂) := congrArg _ hm
                  _ = (B_st.map θ₂ ≫ s.ι.app j₃).hom a₂ := rfl
                  _ = (s.ι.app j₂).hom a₂ := congrArg (fun f => f.hom a₂) hw2
              have hx_jm : x.1 ∈ jm.1 :=
                leOfHom (CategoryTheory.IsFiltered.leftToMax jx jy ≫
                  CategoryTheory.IsFiltered.leftToMax _ jxy) (Classical.choose_spec x.2)
              have hy_jm : y.1 ∈ jm.1 :=
                leOfHom (CategoryTheory.IsFiltered.rightToMax jx jy ≫
                  CategoryTheory.IsFiltered.leftToMax _ jxy) (Classical.choose_spec y.2)
              rw [h_align jxy jm _ ⟨x.1 * y.1, jm.1.mul_mem hx_jm hy_jm⟩ rfl,
                h_align jx jm _ ⟨x.1, hx_jm⟩ rfl,
                h_align jy jm _ ⟨y.1, hy_jm⟩ rfl, ← map_mul]
              rfl
            map_zero' := map_zero (s.ι.app (Classical.choose R_s_sub.zero_mem)).hom
            map_add' := fun x y => by
              let jx := Classical.choose x.2
              let jy := Classical.choose y.2
              let jxy := Classical.choose (R_s_sub.add_mem x.2 y.2)
              let jm := CategoryTheory.IsFiltered.max (CategoryTheory.IsFiltered.max jx jy) jxy
              have h_align : ∀ (j₁ j₂ : 𝒥) (a₁ : ↥j₁.1) (a₂ : ↥j₂.1), a₁.1 = a₂.1 →
                  (s.ι.app j₁).hom a₁ = (s.ι.app j₂).hom a₂ := by
                intro j₁ j₂ a₁ a₂ heq
                let j₃ := CategoryTheory.IsFiltered.max j₁ j₂
                let θ₁ : j₁ ⟶ j₃ := CategoryTheory.IsFiltered.leftToMax j₁ j₂
                let θ₂ : j₂ ⟶ j₃ := CategoryTheory.IsFiltered.rightToMax j₁ j₂
                have hw1 := s.w θ₁
                have hw2 := s.w θ₂
                have hm : (B_st.map θ₁).hom a₁ = (B_st.map θ₂).hom a₂ := Subtype.ext heq
                calc
                  (s.ι.app j₁).hom a₁ = (B_st.map θ₁ ≫ s.ι.app j₃).hom a₁ :=
                    congrArg (fun f => f.hom a₁) hw1.symm
                  _ = (s.ι.app j₃).hom ((B_st.map θ₁).hom a₁) := rfl
                  _ = (s.ι.app j₃).hom ((B_st.map θ₂).hom a₂) := congrArg _ hm
                  _ = (B_st.map θ₂ ≫ s.ι.app j₃).hom a₂ := rfl
                  _ = (s.ι.app j₂).hom a₂ := congrArg (fun f => f.hom a₂) hw2
              have hx_jm : x.1 ∈ jm.1 :=
                leOfHom (CategoryTheory.IsFiltered.leftToMax jx jy ≫
                  CategoryTheory.IsFiltered.leftToMax _ jxy) (Classical.choose_spec x.2)
              have hy_jm : y.1 ∈ jm.1 :=
                leOfHom (CategoryTheory.IsFiltered.rightToMax jx jy ≫
                  CategoryTheory.IsFiltered.leftToMax _ jxy) (Classical.choose_spec y.2)
              rw [h_align jxy jm _ ⟨x.1 + y.1, jm.1.add_mem hx_jm hy_jm⟩ rfl,
                h_align jx jm _ ⟨x.1, hx_jm⟩ rfl,
                h_align jy jm _ ⟨y.1, hy_jm⟩ rfl, ← map_add]
              rfl }
        fac := fun s j => by
          apply CommRingCat.hom_ext
          refine RingHom.ext fun a => ?_
          let j' := Classical.choose (incl_st j a).2
          let jm := CategoryTheory.IsFiltered.max j' j
          let θ₁ : j' ⟶ jm := CategoryTheory.IsFiltered.leftToMax j' j
          let θ₂ : j ⟶ jm := CategoryTheory.IsFiltered.rightToMax j' j
          let a' : ↥j'.1 := ⟨a.1, Classical.choose_spec (incl_st j a).2⟩
          have hm : (B_st.map θ₁).hom a' = (B_st.map θ₂).hom a := rfl
          calc
            (s.ι.app j').hom a' = (B_st.map θ₁ ≫ s.ι.app jm).hom a' :=
              congrArg (fun f => f.hom a') (s.w θ₁).symm
            _ = (s.ι.app jm).hom ((B_st.map θ₁).hom a') := rfl
            _ = (s.ι.app jm).hom ((B_st.map θ₂).hom a) := congrArg _ hm
            _ = (B_st.map θ₂ ≫ s.ι.app jm).hom a := rfl
            _ = (s.ι.app j).hom a := congrArg (fun f => f.hom a) (s.w θ₂)
        uniq := fun s m hm => by
          apply CommRingCat.hom_ext
          refine RingHom.ext fun x => ?_
          let j := Classical.choose x.2
          have hx : incl_st j ⟨x.1, Classical.choose_spec x.2⟩ = x := rfl
          have h1 := congrArg (fun f => f.hom ⟨x.1, Classical.choose_spec x.2⟩) (hm j)
          exact (congrArg m.hom hx.symm).trans h1 }

    have hx_st_ts : ∀ j : 𝒥, incl_st j (x_st j) = t_s := by
      intro j
      apply hι_Rbar_inj
      rw [hι_ts]
      change j.1.val (algebraMap R₀ ↥j.1 x₀) = t_bar
      rw [j.1.val.commutes]
      exact hpR_loc_x₀

    have hx_st_unit_Ks : ∀ j : 𝒥, IsUnit ((ι_RK.comp (incl_st j)) (x_st j)) := by
      intro j
      rw [RingHom.comp_apply, hx_st_ts j]
      exact IsLocalization.Away.algebraMap_isUnit t_s

    let ι_op : ∀ j : 𝒥, Localization.Away (x_st j) →+* K_s :=
      fun j => IsLocalization.Away.lift (x_st j) (hx_st_unit_Ks j)

    let c_op : CategoryTheory.Limits.Cocone B_open :=
      { pt := CommRingCat.of K_s
        ι :=
          { app := fun j => CommRingCat.ofHom (ι_op j)
            naturality := fun {j₁ j₂} θ => by
              dsimp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map]
              rw [CategoryTheory.Category.comp_id]
              suffices h : (ι_op j₂).comp
                  (IsLocalization.Away.lift (x_st j₁) (hx_st_unit_map θ)) = ι_op j₁ from
                CommRingCat.hom_ext h
              apply IsLocalization.ringHom_ext (Submonoid.powers (x_st j₁))
              refine RingHom.ext fun a => ?_
              have h1 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₁))
                (x_st j₁) (hx_st_unit_map θ) a
              have h2 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₂))
                (x_st j₂) (hx_st_unit_Ks j₂) ((B_st.map θ).hom a)
              have h3 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j₁))
                (x_st j₁) (hx_st_unit_Ks j₁) a
              simp only [RingHom.comp_apply] at h1 h2 h3 ⊢
              rw [h1, h2, h3]
              rfl } }
    let e_Ks : c_op.pt ≅ CommRingCat.of K_s := CategoryTheory.Iso.refl _

    have hts_unit_cocone : ∀ s : CategoryTheory.Limits.Cocone B_open,
        IsUnit ((hc_st.desc { pt := s.pt, ι := loc_st ≫ s.ι }).hom t_s) := fun s => by
      let s₀ : CategoryTheory.Limits.Cocone B_st := { pt := s.pt, ι := loc_st ≫ s.ι }
      have hfac := hc_st.fac s₀ j_bot
      have h1 : (hc_st.desc s₀).hom (incl_st j_bot (x_st j_bot)) =
          (s.ι.app j_bot).hom (algebraMap ↥j_bot.1 (Localization.Away (x_st j_bot))
            (x_st j_bot)) :=
        congrArg (fun g => g.hom (x_st j_bot)) hfac
      rw [hx_st_ts j_bot] at h1
      change IsUnit ((hc_st.desc s₀).hom t_s)
      rw [h1]
      exact (IsLocalization.Away.algebraMap_isUnit (x_st j_bot)).map (s.ι.app j_bot).hom

    let desc_op_hom : ∀ s : CategoryTheory.Limits.Cocone B_open, K_s →+* ↑s.pt :=
      fun s => IsLocalization.Away.lift t_s (hts_unit_cocone s)

    have hc_op : CategoryTheory.Limits.IsColimit c_op :=
      { desc := fun s => CommRingCat.ofHom (desc_op_hom s)
        fac := fun s j => by
          let s₀ : CategoryTheory.Limits.Cocone B_st := { pt := s.pt, ι := loc_st ≫ s.ι }
          suffices h : (desc_op_hom s).comp (ι_op j) = (s.ι.app j).hom from
            CommRingCat.hom_ext h
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_st j))
          refine RingHom.ext fun a => ?_
          have h1 := IsLocalization.Away.lift_eq (S := Localization.Away (x_st j))
            (x_st j) (hx_st_unit_Ks j) a
          have h2 := IsLocalization.Away.lift_eq (S := K_s) t_s (hts_unit_cocone s) (incl_st j a)
          simp only [RingHom.comp_apply] at h1 h2 ⊢
          rw [h1]
          change desc_op_hom s (algebraMap R_s K_s (incl_st j a)) = _
          rw [h2]
          exact congrArg (fun g => g.hom a) (hc_st.fac s₀ j)
        uniq := fun s m hm => by
          let s₀ : CategoryTheory.Limits.Cocone B_st := { pt := s.pt, ι := loc_st ≫ s.ι }
          suffices h : m.hom = desc_op_hom s from CommRingCat.hom_ext h
          apply IsLocalization.ringHom_ext (Submonoid.powers t_s)
          have hm_s₀ : ∀ j : 𝒥, c_st.ι.app j ≫ (CommRingCat.ofHom ι_RK ≫ m) = s₀.ι.app j := by
            intro j
            rw [← Category.assoc]
            have hloc : c_st.ι.app j ≫ CommRingCat.ofHom ι_RK = loc_st.app j ≫ c_op.ι.app j := by
              apply CommRingCat.hom_ext
              exact RingHom.ext fun a =>
                (IsLocalization.Away.lift_eq (S := Localization.Away (x_st j))
                  (x_st j) (hx_st_unit_Ks j) a).symm
            rw [hloc, Category.assoc, hm j]
            rfl
          have huniq := hc_st.uniq s₀ (CommRingCat.ofHom ι_RK ≫ m) hm_s₀
          refine RingHom.ext fun x => ?_
          have h1 : m.hom (ι_RK x) = (hc_st.desc s₀).hom x :=
            congrArg (fun g => g.hom x) huniq
          have h2 := IsLocalization.Away.lift_eq (S := K_s) t_s (hts_unit_cocone s) x
          exact h1.trans h2.symm }

    refine ⟨R_s, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      K_s, inferInstance, p_Rs, ι_RK, ι_Rbar, ι_KΩ, t_s, p_Rs_loc, p_Ks_loc,
      𝒥, inferInstance, inferInstance, B_st, B_open, α_st, α_op, loc_st, ε_st,
      c_st, hc_st, e_Rs, c_op, hc_op, e_Ks, ?_, ?_, hUnivStage⟩
    · refine ⟨rfl, hι_pRs, hι_ts, hts_ne, hmax_Rs, hπs_ker, ?_, hLoc_Ks, hφ_ιKΩ, rfl, hpKs_loc_comp⟩
      refine RingHom.ext fun c => ?_
      have h1 := RingHom.congr_fun hπ_pR (Polynomial.C c)
      rw [← hι_pRs, ← RingHom.comp_assoc] at h1
      rw [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C] at h1
      exact h1
    · refine ⟨?_, fun j => ?_⟩
      · intro j₁ j₂ θ
        let f₁ := AlgebraicGeometry.Spec.map (B_st.map θ)
