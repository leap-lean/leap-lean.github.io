      ((AlgebraicGeometry.Scheme.Etale.forget U).map u_et).left
    have hf_u_et : AlgebraicGeometry.Etale f_u := hu_et
    obtain ⟨z₀, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y'₀ pt_Ω hy'₀
    have _ : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.snd f_u y_E) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_u y_E) hf_u_et
    obtain ⟨σ_Y, hσ_Y⟩ := hNullSec (CategoryTheory.Limits.pullback.snd f_u y_E) z₀
    let y_Y : S_Ω ⟶ ((AlgebraicGeometry.Scheme.Etale.forget U).obj Y_et).left :=
      σ_Y ≫ CategoryTheory.Limits.pullback.fst f_u y_E
    have hy_Y : y_Y ≫ f_u = y_E :=
      (CategoryTheory.Category.assoc σ_Y
        (CategoryTheory.Limits.pullback.fst f_u y_E) f_u).trans
        ((congrArg (σ_Y ≫ ·)
          (CategoryTheory.Limits.pullback.condition (f := f_u) (g := y_E))).trans
          ((CategoryTheory.Category.assoc σ_Y
            (CategoryTheory.Limits.pullback.snd f_u y_E) y_E).symm.trans
            ((congrArg (· ≫ y_E) hσ_Y).trans (CategoryTheory.Category.id_comp y_E))))
    have hu_arr' : R₁.arrows u_et ∧ R₂.arrows u_et := hu_arr
    obtain ⟨c₁, hc₁⟩ := hu_arr'.1
