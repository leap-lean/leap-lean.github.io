  have hInjVanish : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h₀ : Y₁ ⟶ Y₂)
      (𝒥 : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective 𝒥] (m : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h₀ (m + 1) 𝒥) := by
    intro Y₁ Y₂ h₀ 𝒥 _ m
