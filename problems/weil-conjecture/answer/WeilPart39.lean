  let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  have hSpecFieldUnique : ∀ (K : Type u) [Field K]
      (p q : ↥(AlgebraicGeometry.Spec (CommRingCat.of K))), p = q := by
    intro K _ p q
    have hbot : ∀ r : PrimeSpectrum K, r.asIdeal = ⊥ := by
      intro r
      rw [Submodule.eq_bot_iff]
      intro x hx
      by_contra hx0
      exact r.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem r.asIdeal hx (IsUnit.mk0 x hx0))
    exact PrimeSpectrum.ext ((hbot p).trans (hbot q).symm)

  
  have hLiftSpec : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Z : AlgebraicGeometry.Scheme.{u})
      (q : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      [AlgebraicGeometry.Etale q] (z₀ : ↥Z),
      ∃ s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z,
        s₀ ≫ q = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    intro Ω _ _ Z q _ z₀
    obtain ⟨V, hV_aff, hz₀V, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Z.Opens)) (x := z₀) trivial
    let R_obj : CommRingCat.{u} := Z.presheaf.obj (Opposite.op V)
    let j_V : AlgebraicGeometry.Spec R_obj ⟶ Z := hV_aff.isoSpec.inv ≫ V.ι
    have _ : AlgebraicGeometry.Etale j_V := inferInstance
    have _ : AlgebraicGeometry.Etale (j_V ≫ q) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) j_V q
        inferInstance inferInstance
    let φ_cat : CommRingCat.of Ω ⟶ R_obj := AlgebraicGeometry.Spec.preimage (j_V ≫ q)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_cat = j_V ≫ q :=
      AlgebraicGeometry.Spec.map_preimage (j_V ≫ q)
    have hEt_φ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_cat) := by
      rwa [hSpec_φ]
    have hRingEt : φ_cat.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_φ
    let _ : Algebra Ω ↑R_obj := φ_cat.hom.toAlgebra
    have _ : Algebra.Etale Ω ↑R_obj := hRingEt
    let p₀ : PrimeSpectrum ↑R_obj := hV_aff.isoSpec.hom.base ⟨z₀, hz₀V⟩
    let Loc := Localization.AtPrime p₀.asIdeal
    have hBij : Function.Bijective (algebraMap Ω Loc) :=
      Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing Ω Loc
    let e_loc : Ω ≃+* Loc := RingEquiv.ofBijective (algebraMap Ω Loc) hBij
    let α : ↑R_obj →+* Ω := e_loc.symm.toRingHom.comp (algebraMap (↑R_obj) Loc)
    have hφα : φ_cat ≫ CommRingCat.ofHom α = 𝟙 (CommRingCat.of Ω) := by
      ext c
      change e_loc.symm (algebraMap (↑R_obj) Loc (algebraMap Ω (↑R_obj) c)) = c
      rw [← IsScalarTower.algebraMap_apply Ω (↑R_obj) Loc c]
      exact e_loc.symm_apply_apply c
    refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ j_V, ?_⟩
    rw [Category.assoc, ← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp, hφα,
      AlgebraicGeometry.Spec.map_id]

  
  let mkGeomFiber : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      CategoryTheory.Functor W.Etale (Type u) :=
    fun W Ω _ w =>
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget W
      { obj := fun E => { e : S_Ω ⟶ (Fgt.obj E).left // e ≫ (Fgt.obj E).hom = w }
        map := fun {E₁ E₂} u => TypeCat.ofHom fun e =>
          ⟨e.1 ≫ (Fgt.map u).left, by rw [Category.assoc, (Fgt.map u).w, e.2]⟩
        map_id := fun E => by
          ext e
          exact Category.comp_id e.1
        map_comp := fun u v => by
          ext e
          exact Category.assoc e.1 _ _ }

  have hGeomPointEx : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W),
      ∃ (Φ : CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology)
