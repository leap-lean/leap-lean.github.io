        exact IsUnramifiedAt.of_liesOver_of_ne_bot R p P hCompl (fun hne => False.elim (hne hp))
      · obtain ⟨P, _, hP_prime, hOver⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (R := B) (S := B_raw) p (⊥ : Ideal B_raw)
            (by rw [hbot_under]; exact bot_le)
        have : P.IsPrime := hP_prime
        have : P.LiesOver p := ⟨hOver.symm⟩
        have : Algebra.IsUnramifiedAt R P := hAllUnram_raw P
        have hCompl : P.primeCompl ≤ nonZeroDivisors B_raw := by
          intro x hx
          rw [mem_nonZeroDivisors_iff_ne_zero]
          rintro rfl
          exact hx P.zero_mem
        have hP_ne : p ≠ ⊥ → P ≠ ⊥ := by
          intro _ hP0
          rw [hP0, hbot_under] at hOver
          exact hp hOver.symm
        exact IsUnramifiedAt.of_liesOver_of_ne_bot R p P hCompl hP_ne
    exact hEtaleOfProj R B

  have hPadicUnitLift : ∀ (M : ∀ r : ℕ, (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ),
      (∀ r : ℕ,
        ((M (r + 1)).val).map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          (M r).val) →
      ∃ g : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ,
        ∀ r : ℕ, (g.val).map (PadicInt.toZModPow (r + 1)) = (M r).val := by
    intro M hCompat
    have hScalarLift : ∀ (a : ∀ r : ℕ, ZMod (ℓ ^ (r + 1))),
        (∀ r : ℕ,
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))) (a (r + 1)) =
            a r) →
        ∃ z : PadicInt ℓ, ∀ r : ℕ, PadicInt.toZModPow (r + 1) z = a r := by
      intro a ha
      let a₀_seq : ∀ k : ℕ, ZMod (ℓ ^ k) := fun k =>
        match k with
        | 0 => 0
        | r + 1 => a r
      have ha_step : ∀ (r₁ d : ℕ) (hle : r₁ + 1 ≤ (r₁ + d) + 1),
          ZMod.castHom (pow_dvd_pow ℓ hle) (ZMod (ℓ ^ (r₁ + 1))) (a (r₁ + d)) = a r₁ := by
        intro r₁ d
        induction d with
        | zero =>
          intro hle
          change ZMod.castHom (pow_dvd_pow ℓ hle) (ZMod (ℓ ^ (r₁ + 1))) (a r₁) = a r₁
          rw [ZMod.castHom_self, RingHom.id_apply]
        | succ d ih =>
          intro hle
          have hle' : r₁ + 1 ≤ (r₁ + d) + 1 := by omega
          have hstep : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ ((r₁ + d) + 1)))
              (ZMod (ℓ ^ ((r₁ + d) + 1))) (a (r₁ + (d + 1))) = a (r₁ + d) := ha (r₁ + d)
          rw [← ih hle', ← hstep, ← RingHom.comp_apply, ZMod.castHom_comp]
      have ha₀_compat : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
          ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁)) (a₀_seq k₂) = a₀_seq k₁ := by
        intro k₁ k₂ hk
        cases k₁ with
        | zero =>
          have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
          exact Subsingleton.elim _ _
        | succ r₁ =>
          cases k₂ with
          | zero => omega
          | succ m_idx =>
            obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_succ_le_succ hk)
            exact ha_step r₁ d hk
      let f_hom : ∀ k : ℕ, Polynomial ℤ →+* ZMod (ℓ ^ k) :=
        fun k => Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ k))) (a₀_seq k)
      have hf_compat : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
          (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (f_hom k₂) = f_hom k₁ := by
        intro k₁ k₂ hk
        apply Polynomial.ringHom_ext'
        · exact RingHom.ext_int _ _
        · simp [f_hom, ha₀_compat k₁ k₂ hk]
      refine ⟨PadicInt.lift hf_compat Polynomial.X, fun r => ?_⟩
      have hspec := RingHom.congr_fun (PadicInt.lift_spec hf_compat (r + 1)) Polynomial.X
      simpa [f_hom, a₀_seq] using hspec
    have hInvCompat : ∀ r : ℕ,
        (((M (r + 1))⁻¹).val).map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
          ((M r)⁻¹).val := by
      intro r
      let φ : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 2))) →+*
          Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) :=
        RingHom.mapMatrix
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1))))
      have hM : φ (M (r + 1)).val = (M r).val := hCompat r
      have hmul : φ ((M (r + 1))⁻¹).val * (M r).val = 1 := by
        rw [← hM, ← map_mul, Units.inv_mul, map_one]
      calc (((M (r + 1))⁻¹).val).map _ = φ ((M (r + 1))⁻¹).val := rfl
        _ = φ ((M (r + 1))⁻¹).val * ((M r).val * ((M r)⁻¹).val) := by
            rw [Units.mul_inv, Matrix.mul_one]
        _ = (φ ((M (r + 1))⁻¹).val * (M r).val) * ((M r)⁻¹).val := (Matrix.mul_assoc _ _ _).symm
        _ = ((M r)⁻¹).val := by rw [hmul, Matrix.one_mul]
    let A : Matrix (Fin N) (Fin N) (PadicInt ℓ) :=
      Matrix.of fun i j =>
        Classical.choose (hScalarLift (fun r => (M r).val i j)
          (fun r => congrArg (fun X => X i j) (hCompat r)))
    have hA : ∀ r : ℕ, A.map (PadicInt.toZModPow (r + 1)) = (M r).val := by
      intro r
      ext i j
      exact Classical.choose_spec (hScalarLift (fun t => (M t).val i j)
        (fun t => congrArg (fun X => X i j) (hCompat t))) r
    let B : Matrix (Fin N) (Fin N) (PadicInt ℓ) :=
      Matrix.of fun i j =>
        Classical.choose (hScalarLift (fun r => ((M r)⁻¹).val i j)
          (fun r => congrArg (fun X => X i j) (hInvCompat r)))
    have hB : ∀ r : ℕ, B.map (PadicInt.toZModPow (r + 1)) = ((M r)⁻¹).val := by
      intro r
      ext i j
      exact Classical.choose_spec (hScalarLift (fun t => ((M t)⁻¹).val i j)
        (fun t => congrArg (fun X => X i j) (hInvCompat t))) r
    have hAB : A * B = 1 := by
      ext i j
      apply PadicInt.ext_of_toZModPow.mp
      intro n
      cases n with
      | zero =>
        have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
        exact Subsingleton.elim _ _
      | succ r =>
        let ψ : Matrix (Fin N) (Fin N) (PadicInt ℓ) →+*
            Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) :=
          RingHom.mapMatrix (PadicInt.toZModPow (p := ℓ) (r + 1))
        have h1 : ψ (A * B) = ψ 1 := by
          rw [map_mul, map_one]
          change A.map _ * B.map _ = 1
          rw [hA r, hB r, Units.mul_inv]
        exact congrArg (fun X => X i j) h1
    have hBA : B * A = 1 := by
      ext i j
      apply PadicInt.ext_of_toZModPow.mp
      intro n
      cases n with
      | zero =>
        have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
        exact Subsingleton.elim _ _
      | succ r =>
        let ψ : Matrix (Fin N) (Fin N) (PadicInt ℓ) →+*
            Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) :=
          RingHom.mapMatrix (PadicInt.toZModPow (p := ℓ) (r + 1))
        have h1 : ψ (B * A) = ψ 1 := by
          rw [map_mul, map_one]
          change B.map _ * A.map _ = 1
          rw [hB r, hA r, Units.inv_mul]
        exact congrArg (fun X => X i j) h1
    exact ⟨⟨A, B, hAB, hBA⟩, hA⟩

  have hFrobCosetGeom : ∀ (R₀ B : Type u) [CommRing R₀] [CommRing B] [IsDomain B]
      [Algebra F R₀] [Algebra F B] [Algebra R₀ B] [IsScalarTower F R₀ B]
      (Q_u Q_P : Ideal B), Q_u.IsMaximal → Q_P.IsMaximal →
      ∀ (q d : ℕ) (σ_u σ_P : B ≃ₐ[R₀] B),
        (∀ b : B, σ_u.symm b - b ^ q ∈ Q_u) →
        (∀ b : B, σ_P.symm b - b ^ (q ^ d) ∈ Q_P) →
        ∀ x : B, IsIntegral F x → (σ_P * (σ_u ^ d)⁻¹) x = x := by
    intro R₀ B _ _ _ _ _ _ _ Q_u Q_P hQu hQP q d σ_u σ_P hCong_u hCong_P x hx
    have hIntZero : ∀ (Q : Ideal B), Q ≠ ⊤ → ∀ z : B, IsIntegral F z → z ∈ Q → z = 0 := by
      intro Q hQne z hz hzQ
      by_contra hz0
      let p : Polynomial F := minpoly F z
      have hp_irr : Irreducible p := minpoly.irreducible hz
      have hp_mon : p.Monic := minpoly.monic hz
      have hc0 : p.coeff 0 ≠ 0 := by
        intro hc0_eq
        obtain ⟨r, hr⟩ := Polynomial.X_dvd_iff.mpr hc0_eq
        have hr_unit : IsUnit r := by
          rcases hp_irr.isUnit_or_isUnit hr with hX_unit | hr_u
          · exact False.elim (Polynomial.not_isUnit_X hX_unit)
          · exact hr_u
        have hp_eq_X : p = Polynomial.X :=
          (Polynomial.eq_of_monic_of_associated Polynomial.monic_X hp_mon
            ⟨hr_unit.unit, by simpa using hr.symm⟩).symm
        have hz_eval : Polynomial.aeval z p = 0 := minpoly.aeval F z
        rw [hp_eq_X, Polynomial.aeval_X] at hz_eval
        exact hz0 hz_eval
      have hdiv := congrArg (Polynomial.aeval z) (Polynomial.X_mul_divX_add p)
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, minpoly.aeval F z] at hdiv
      have hunit : IsUnit z := by
        refine isUnit_iff_exists_inv.mpr
          ⟨Polynomial.aeval z p.divX * algebraMap F B (-(p.coeff 0)⁻¹), ?_⟩
        have h1 : algebraMap F B (p.coeff 0) * algebraMap F B (-(p.coeff 0)⁻¹) = -1 := by
          rw [← map_mul, mul_neg, mul_inv_cancel₀ hc0, map_neg, map_one]
        have h2 := congrArg (· * algebraMap F B (-(p.coeff 0)⁻¹)) hdiv
        simp only [add_mul, zero_mul] at h2
        rw [h1] at h2
        linear_combination h2
      exact hQne (Ideal.eq_top_of_isUnit_mem Q hzQ hunit)
    have hxu : σ_u.symm x = x ^ q := by
      have hint : IsIntegral F (σ_u.symm x - x ^ q) :=
        IsIntegral.sub (IsIntegral.map (σ_u.symm.restrictScalars F).toAlgHom hx) (hx.pow q)
      exact sub_eq_zero.mp (hIntZero Q_u hQu.ne_top _ hint (hCong_u x))
    have hxP : σ_P.symm x = x ^ (q ^ d) := by
      have hint : IsIntegral F (σ_P.symm x - x ^ (q ^ d)) :=
        IsIntegral.sub (IsIntegral.map (σ_P.symm.restrictScalars F).toAlgHom hx) (hx.pow (q ^ d))
      exact sub_eq_zero.mp (hIntZero Q_P hQP.ne_top _ hint (hCong_P x))
    have hpow_u : ∀ k : ℕ, ((σ_u ^ k)⁻¹) x = x ^ (q ^ k) := by
      intro k
      induction k with
      | zero =>
        rw [pow_zero, inv_one, AlgEquiv.one_apply, pow_zero, pow_one]
      | succ k ih =>
        rw [pow_succ, mul_inv_rev, AlgEquiv.mul_apply, ih]
        change σ_u.symm (x ^ (q ^ k)) = x ^ (q ^ (k + 1))
        rw [map_pow, hxu, ← pow_mul, ← pow_succ']
    rw [AlgEquiv.mul_apply, hpow_u d, ← hxP, σ_P.apply_symm_apply]

  have hConstFieldGeomLift (R₀ K B₁ L₁ B₂ L₂ : Type u)
      [CommRing R₀] [Field K]
      [Algebra (Polynomial F) R₀] [Algebra F K] [Algebra (Polynomial F) K] [Algebra R₀ K]
      [IsScalarTower F (Polynomial F) K] [IsFractionRing (Polynomial F) K] [IsFractionRing R₀ K]
      [CommRing B₁] [IsDomain B₁] [Field L₁]
      [Algebra F B₁] [Algebra (Polynomial F) B₁] [Algebra R₀ B₁]
      [Algebra F L₁] [Algebra (Polynomial F) L₁] [Algebra K L₁] [Algebra B₁ L₁] [Algebra R₀ L₁]
      [IsScalarTower F (Polynomial F) B₁] [IsScalarTower (Polynomial F) R₀ B₁]
      [IsScalarTower F K L₁] [IsScalarTower (Polynomial F) K L₁]
      [IsScalarTower (Polynomial F) B₁ L₁] [IsScalarTower R₀ B₁ L₁] [IsScalarTower R₀ K L₁]
      [IsFractionRing B₁ L₁] [IsIntegralClosure B₁ R₀ L₁] [FiniteDimensional K L₁] [IsGalois K L₁]
      [CommRing B₂] [IsDomain B₂] [Field L₂]
      [Algebra F B₂] [Algebra (Polynomial F) B₂] [Algebra R₀ B₂]
      [Algebra F L₂] [Algebra (Polynomial F) L₂] [Algebra K L₂] [Algebra B₂ L₂] [Algebra R₀ L₂]
      [IsScalarTower F (Polynomial F) B₂] [IsScalarTower (Polynomial F) R₀ B₂]
      [IsScalarTower F K L₂] [IsScalarTower (Polynomial F) K L₂]
      [IsScalarTower (Polynomial F) B₂ L₂] [IsScalarTower R₀ B₂ L₂] [IsScalarTower R₀ K L₂]
      [IsFractionRing B₂ L₂] [IsIntegralClosure B₂ R₀ L₂] [FiniteDimensional K L₂] [IsGalois K L₂]
      (ι_B : B₁ →ₐ[R₀] B₂) (hι_inj : Function.Injective ι_B)
      (σ : B₁ ≃ₐ[R₀] B₁) (hσ_geom : ∀ x : B₁, IsIntegral F x → σ x = x) :
      ∃ τ : B₂ ≃ₐ[R₀] B₂,
        (∀ x : B₂, IsIntegral F x → τ x = x) ∧
        (∀ b : B₁, τ (ι_B b) = ι_B (σ b)) := by
    have : IsScalarTower F (Polynomial F) L₁ := IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply F K L₁, IsScalarTower.algebraMap_apply F (Polynomial F) K,
        ← IsScalarTower.algebraMap_apply (Polynomial F) K L₁]
    have : IsScalarTower F (Polynomial F) L₂ := IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply F K L₂, IsScalarTower.algebraMap_apply F (Polynomial F) K,
        ← IsScalarTower.algebraMap_apply (Polynomial F) K L₂]
    have : IsScalarTower F B₁ L₁ := IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply F (Polynomial F) L₁,
        IsScalarTower.algebraMap_apply (Polynomial F) B₁ L₁,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) B₁]
    have : IsScalarTower F B₂ L₂ := IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply F (Polynomial F) L₂,
        IsScalarTower.algebraMap_apply (Polynomial F) B₂ L₂,
        ← IsScalarTower.algebraMap_apply F (Polynomial F) B₂]
    let f_B₁L₂ : B₁ →+* L₂ := (algebraMap B₂ L₂).comp ι_B.toRingHom
    have hf_inj : Function.Injective f_B₁L₂ := (IsFractionRing.injective B₂ L₂).comp hι_inj
    have hUnit : ∀ y : nonZeroDivisors B₁, IsUnit (f_B₁L₂ y) := fun y =>
      IsUnit.mk0 _ fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hf_inj (h0.trans (map_zero f_B₁L₂).symm))
    let φ_L : L₁ →+* L₂ := IsLocalization.lift (M := nonZeroDivisors B₁) hUnit
    have hφ_B : ∀ b : B₁, φ_L (algebraMap B₁ L₁ b) = algebraMap B₂ L₂ (ι_B b) :=
      fun b => IsLocalization.lift_eq hUnit b
    have hφ_K : φ_L.comp (algebraMap K L₁) = algebraMap K L₂ := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial F))
      apply RingHom.ext
      intro p
      simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial F) K L₁,
        ← IsScalarTower.algebraMap_apply (Polynomial F) K L₂,
        IsScalarTower.algebraMap_apply (Polynomial F) B₁ L₁, hφ_B,
        IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₁, AlgHom.commutes,
        ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B₂,
        ← IsScalarTower.algebraMap_apply (Polynomial F) B₂ L₂]
    let ι_L : L₁ →ₐ[K] L₂ := { φ_L with commutes' := fun c => RingHom.congr_fun hφ_K c }
    have hιL_inj : Function.Injective ι_L := ι_L.toRingHom.injective
    let _ : Algebra L₁ L₂ := ι_L.toRingHom.toAlgebra
    have : IsScalarTower K L₁ L₂ := IsScalarTower.of_algebraMap_eq fun c => (ι_L.commutes c).symm
    have : IsScalarTower F L₁ L₂ := IsScalarTower.of_algebraMap_eq fun c => by
      rw [IsScalarTower.algebraMap_apply F K L₂, IsScalarTower.algebraMap_apply K L₁ L₂,
        ← IsScalarTower.algebraMap_apply F K L₁]
    have : FiniteDimensional L₁ L₂ := Module.Finite.of_restrictScalars_finite K L₁ L₂
    have : IsGalois L₁ L₂ := IsGalois.tower_top_of_isGalois K L₁ L₂
    let k₁_if : IntermediateField F L₁ := algebraicClosure F L₁
    let k₂_if : IntermediateField F L₂ := algebraicClosure F L₂
    let k₁ := ↥k₁_if
    let k₂ := ↥k₂_if
    have hk₁_mem : ∀ z : L₁, z ∈ k₁_if ↔ IsIntegral F z :=
      fun _ => mem_algebraicClosure_iff.trans isAlgebraic_iff_isIntegral
    have hk₂_mem : ∀ z : L₂, z ∈ k₂_if ↔ IsIntegral F z :=
      fun _ => mem_algebraicClosure_iff.trans isAlgebraic_iff_isIntegral
    have : Algebra.IsIntegral F k₂ := by
      refine ⟨fun c => ?_⟩
      rw [← isIntegral_algHom_iff k₂_if.val Subtype.val_injective]
      exact (hk₂_mem c.1).mp c.2
    have hX_not_alg : ¬ IsAlgebraic k₂ (algebraMap (Polynomial F) L₂ Polynomial.X) := by
      intro hAlg
      have hInt_k₂ : IsIntegral k₂ (algebraMap (Polynomial F) L₂ Polynomial.X) :=
        isAlgebraic_iff_isIntegral.mp hAlg
      have hInt_F : IsIntegral F (algebraMap (Polynomial F) L₂ Polynomial.X) :=
        isIntegral_trans _ hInt_k₂
      have hPL₂_inj : Function.Injective (algebraMap (Polynomial F) L₂) := by
        intro p₁ p₂ hp
        apply IsFractionRing.injective (Polynomial F) K
        apply (algebraMap K L₂).injective
        rwa [← IsScalarTower.algebraMap_apply (Polynomial F) K L₂,
          ← IsScalarTower.algebraMap_apply (Polynomial F) K L₂]
      have hInt_X : IsIntegral F (Polynomial.X : Polynomial F) :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom F (Polynomial F) L₂) hPL₂_inj).mp hInt_F
      obtain ⟨p, hp_mon, hp_eval⟩ := hInt_X
      rw [Polynomial.algebraMap_eq, Polynomial.eval₂_C_X] at hp_eval
      exact hp_mon.ne_zero hp_eval
    have : Finite k₂ := by
      let b_F := Module.Basis.ofVectorSpace F k₂
      have hLI_K : LinearIndependent K (fun i => ((b_F i) : L₂)) := by
        rw [linearIndependent_iff']
        intro s g hsum i₀ hi₀
        by_contra hgi₀
        obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors (Polynomial F)) s g
        have hd_ne : (d : Polynomial F) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
        let P : ∀ i, i ∈ s → Polynomial F := fun i hi => Classical.choose (hd i hi)
        have hP_spec : ∀ (i) (hi : i ∈ s),
            algebraMap (Polynomial F) K (P i hi) = algebraMap (Polynomial F) K d * g i := by
          intro i hi
          dsimp [P]
          rw [Classical.choose_spec (hd i hi), Algebra.smul_def]
        let P_tot : _ → Polynomial F := fun i => if hi : i ∈ s then P i hi else 0
        have hP_tot : ∀ i ∈ s, algebraMap (Polynomial F) K (P_tot i) =
            algebraMap (Polynomial F) K d * g i := by
          intro i hi
          dsimp [P_tot]
          rw [dite_cond_eq_true (eq_true hi), hP_spec i hi]
        have hPi₀_ne : P_tot i₀ ≠ 0 := by
          intro h0
          have heq := hP_tot i₀ hi₀
          rw [h0, map_zero] at heq
          have hdK_ne : algebraMap (Polynomial F) K d ≠ 0 :=
            fun h => hd_ne (IsFractionRing.injective (Polynomial F) K (h.trans (map_zero _).symm))
          exact mul_ne_zero hdK_ne hgi₀ heq.symm
        have hsum_P : ∑ i ∈ s, algebraMap (Polynomial F) L₂ (P_tot i) * ((b_F i) : L₂) = 0 := by
          have hmul := congrArg (fun z : L₂ => algebraMap (Polynomial F) L₂ d * z) hsum
          simp only [mul_zero, Finset.mul_sum] at hmul
          rw [← hmul]
          refine Finset.sum_congr rfl fun i hi => ?_
          rw [IsScalarTower.algebraMap_apply (Polynomial F) K L₂, hP_tot i hi, map_mul,
            ← IsScalarTower.algebraMap_apply (Polynomial F) K L₂, mul_assoc, Algebra.smul_def]
        let D : ℕ := (s.sup fun i => (P_tot i).natDegree) + 1
        let Q : Polynomial k₂ :=
          ∑ m_deg ∈ Finset.range D,
            Polynomial.C (∑ i ∈ s, (P_tot i).coeff m_deg • b_F i) * Polynomial.X ^ m_deg
        have hQ_ne : Q ≠ 0 := by
          intro hQ0
