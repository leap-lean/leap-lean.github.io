  · have hπs_pRs_loc : (π_cl.comp ι_Rbar).comp p_Rs_loc = eval₀_loc := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ₀)
      rw [RingHom.comp_assoc, hpRs_loc_comp, RingHom.comp_assoc, hι_pRs, hRbar_props.2.1,
