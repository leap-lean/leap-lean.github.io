    have hRange_f : Set.range f_loc.base = Set.range U₀.ι.base := by
      have h1 : Set.range f_loc.base = j_aff.base '' Set.range ι_loc.base := by
        change Set.range (j_aff.base ∘ ι_loc.base) = _
