    have hγOfSeq : ∀ (s : ∀ t : ℕ, Γ_abs t),
        (∀ t : ℕ, Compat_abs t (s (t + 1)) (s t)) →
        ∀ (t : ℕ) (v : H_abs (t + 1)),
          trans_abs t ((γOfSeq s (t + 1)).val v) = (γOfSeq s t).val (trans_abs t v) :=
      fun s hs t v => hCompat_ρ t (s (t + 1)) (s t) (hs t) v
    let matLift : ∀ r : ℕ, Γ_abs r → (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ :=
      fun r σ => mat_abs (γOfSeq (seqOf r σ)) (hγOfSeq (seqOf r σ) (hSeqOf_compat r σ))
    let ρ_mat_abs : ∀ r : ℕ, Γ_abs r →* (Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ :=
      fun r =>
        let π_r := (RingHom.mapMatrix (PadicInt.toZModPow (r + 1))).toMonoidHom
        { toFun := fun σ => Units.map π_r (matLift r σ)
          map_one' := by
            apply Units.ext
            have hγ1 : ∀ (t : ℕ) (v : H_abs (t + 1)),
                trans_abs t (((1 : ∀ k : ℕ, (AddMonoid.End (H_abs k))ˣ) (t + 1)).val v) =
                ((1 : ∀ k : ℕ, (AddMonoid.End (H_abs k))ˣ) t).val (trans_abs t v) :=
              fun _ _ => rfl
            have hat : γOfSeq (seqOf r 1) r = (1 : ∀ k : ℕ, (AddMonoid.End (H_abs k))ˣ) r := by
              dsimp [γOfSeq]
              rw [hSeqOf_at r 1, map_one]
            have hmod := hM_mod _ _ (hγOfSeq (seqOf r 1) (hSeqOf_compat r 1)) hγ1 r hat
            change ((matLift r 1).val).map (PadicInt.toZModPow (r + 1)) =
              (1 : Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))
            rw [hmod, hM_one hγ1]
            exact (RingHom.mapMatrix (PadicInt.toZModPow (r + 1))).map_one
          map_mul' := fun σ₁ σ₂ => by
            apply Units.ext
            let γ₁ := γOfSeq (seqOf r σ₁)
            let γ₂ := γOfSeq (seqOf r σ₂)
            let h₁ := hγOfSeq (seqOf r σ₁) (hSeqOf_compat r σ₁)
            let h₂ := hγOfSeq (seqOf r σ₂) (hSeqOf_compat r σ₂)
            have h₁₂ : ∀ (t : ℕ) (v : H_abs (t + 1)),
                trans_abs t (((γ₁ * γ₂) (t + 1)).val v) =
                  ((γ₁ * γ₂) t).val (trans_abs t v) := by
              intro t v
              change trans_abs t ((γ₁ (t + 1)).val ((γ₂ (t + 1)).val v)) =
                (γ₁ t).val ((γ₂ t).val (trans_abs t v))
              rw [h₁ t ((γ₂ (t + 1)).val v), h₂ t v]
            have hat : γOfSeq (seqOf r (σ₁ * σ₂)) r = (γ₁ * γ₂) r := by
              dsimp [γOfSeq, γ₁, γ₂]
              rw [hSeqOf_at r (σ₁ * σ₂), hSeqOf_at r σ₁, hSeqOf_at r σ₂, map_mul]
            have hmod := hM_mod _ _
              (hγOfSeq (seqOf r (σ₁ * σ₂)) (hSeqOf_compat r (σ₁ * σ₂))) h₁₂ r hat
            change ((matLift r (σ₁ * σ₂)).val).map (PadicInt.toZModPow (r + 1)) =
              ((matLift r σ₁).val).map (PadicInt.toZModPow (r + 1)) *
                ((matLift r σ₂).val).map (PadicInt.toZModPow (r + 1))
            rw [hmod, hM_mul γ₁ γ₂ h₁ h₂ h₁₂]
            exact (RingHom.mapMatrix (PadicInt.toZModPow (r + 1))).map_mul _ _ }
    have hSeq_eq : ∀ (s : ∀ t : ℕ, Γ_abs t) (hs : ∀ t : ℕ, Compat_abs t (s (t + 1)) (s t))
        (r : ℕ),
        (ρ_mat_abs r (s r)).val =
          ((mat_abs (γOfSeq s) (hγOfSeq s hs)).val).map (PadicInt.toZModPow (r + 1)) := by
      intro s hs r
      have hat : γOfSeq (seqOf r (s r)) r = γOfSeq s r := by
        dsimp [γOfSeq]
        rw [hSeqOf_at r (s r)]
      exact hM_mod _ _ (hγOfSeq (seqOf r (s r)) (hSeqOf_compat r (s r))) (hγOfSeq s hs) r hat
    refine ⟨ρ_mat_abs, ?_, hSeq_eq, ?_⟩
    · intro r τ σ hcomp
      have hc := hSeqOf_compat (r + 1) τ r
      rw [hSeqOf_at (r + 1) τ] at hc
      have hseq_eq : seqOf (r + 1) τ r = σ := hCompat_uniq r τ (seqOf (r + 1) τ r) σ hc hcomp
      have hat : γOfSeq (seqOf (r + 1) τ) r = γOfSeq (seqOf r σ) r := by
        dsimp [γOfSeq]
        rw [hseq_eq, hSeqOf_at r σ]
      have hmod := hM_mod _ _
        (hγOfSeq (seqOf (r + 1) τ) (hSeqOf_compat (r + 1) τ))
        (hγOfSeq (seqOf r σ) (hSeqOf_compat r σ)) r hat
      change (((matLift (r + 1) τ).val).map (PadicInt.toZModPow (r + 2))).map
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
        ((matLift r σ).val).map (PadicInt.toZModPow (r + 1))
      rw [← hmod]
      ext i j
      simp only [Matrix.map_apply]
      have hcast := PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2) (Nat.le_succ (r + 1)) (p := ℓ)
      exact RingHom.congr_fun hcast ((matLift (r + 1) τ).val i j)
    · intro r τ_raw
      obtain ⟨hα_int, hβ_int⟩ :=
        hM_inter (γOfSeq (seqOf r τ_raw)) (hγOfSeq (seqOf r τ_raw) (hSeqOf_compat r τ_raw)) r
      have hγ_r : (γOfSeq (seqOf r τ_raw) r).val = (ρ_abs r τ_raw).val := by
        dsimp [γOfSeq]
        rw [hSeqOf_at r τ_raw]
      exact ⟨fun v => (hα_int v).trans (congrFun (congrArg DFunLike.coe hγ_r) (α_abs r v)),
        fun w =>
          (congrArg (β_abs r) (congrFun (congrArg DFunLike.coe hγ_r.symm) w)).trans (hβ_int w)⟩

  have hCompat_uniq_raw : ∀ (r : ℕ),
      letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
      letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
      ∀ (τ : T_raw.B_raw (r + 1) ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw (r + 1))
        (σ₁ σ₂ : T_raw.B_raw r ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r),
        (∀ b : T_raw.B_raw r, τ (T_raw.ι_Braw r b) = T_raw.ι_Braw r (σ₁ b)) →
        (∀ b : T_raw.B_raw r, τ (T_raw.ι_Braw r b) = T_raw.ι_Braw r (σ₂ b)) →
        σ₁ = σ₂ := by
    intro r τ σ₁ σ₂ h₁ h₂
    letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
    letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
    ext b
    exact (T_raw.hι_raw r).1 ((h₁ b).symm.trans (h₂ b))

  have hCompat_ρ_raw : ∀ (r : ℕ),
      letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
      letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
      ∀ (τ : T_raw.B_raw (r + 1) ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw (r + 1))
        (σ : T_raw.B_raw r ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r),
        (∀ b : T_raw.B_raw r, τ (T_raw.ι_Braw r b) = T_raw.ι_Braw r (σ b)) →
        ∀ v : weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 2)) (2 * m + 1),
          weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1)
            ((T_raw.ρ_raw (r + 1) τ).val v) =
          (T_raw.ρ_raw r σ).val
            (weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1) v) := by
    intro r τ σ hcomp v
    letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
    letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
    obtain ⟨_, hRes_r⟩ := T_raw.hι_raw r
    obtain ⟨σ', hσ'_alg, hσ'_ρ⟩ := hRes_r τ
    rw [hCompat_uniq_raw r τ σ' σ hσ'_alg hcomp] at hσ'_ρ
    exact hσ'_ρ v

  have hUp_raw_ex : ∀ (t : ℕ),
      letI := T_raw.hCR t; letI := T_raw.hCR (t + 1)
      letI := T_raw.hAR_B t; letI := T_raw.hAR_B (t + 1)
      ∀ σ : T_raw.B_raw t ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw t,
        ∃ τ : T_raw.B_raw (t + 1) ≃ₐ[Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw (t + 1),
          ∀ b : T_raw.B_raw t, τ (T_raw.ι_Braw t b) = T_raw.ι_Braw t (σ b) := by
    intro t σ
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    letI : IsDomain R₀ := hDom_R₀
    letI : Algebra R₀ (RatFunc F) := instAlg_R₀_RF
    letI : IsFractionRing R₀ (RatFunc F) := hFrac_R₀_RF
    letI := T_raw.hCR t; letI := T_raw.hDom t; letI := T_raw.hFld t
    letI := T_raw.hAP_B t; letI := T_raw.hAR_B t
    letI := T_raw.hAP_L t; letI := T_raw.hARF_L t; letI := T_raw.hABL t; letI := T_raw.hARL t
    letI := T_raw.hST2 t; letI := T_raw.hST4 t; letI := T_raw.hST5 t; letI := T_raw.hST6 t
    letI := T_raw.hFin_B t; letI := T_raw.hEt_B t; letI := T_raw.hFrac t; letI := T_raw.hIntCl t
    letI := T_raw.hFD_L t; letI := T_raw.hGal_L t
    letI : IsScalarTower R₀ (RatFunc F) (T_raw.L_raw t) :=
      hST_R₀_RF (T_raw.B_raw t) (T_raw.L_raw t)
    letI := T_raw.hCR (t + 1); letI := T_raw.hDom (t + 1); letI := T_raw.hFld (t + 1)
    letI := T_raw.hAP_B (t + 1); letI := T_raw.hAR_B (t + 1)
    letI := T_raw.hAP_L (t + 1); letI := T_raw.hARF_L (t + 1)
    letI := T_raw.hABL (t + 1); letI := T_raw.hARL (t + 1)
    letI := T_raw.hST2 (t + 1); letI := T_raw.hST4 (t + 1)
    letI := T_raw.hST5 (t + 1); letI := T_raw.hST6 (t + 1)
    letI := T_raw.hFin_B (t + 1); letI := T_raw.hEt_B (t + 1)
    letI := T_raw.hFrac (t + 1); letI := T_raw.hIntCl (t + 1)
    letI := T_raw.hFD_L (t + 1); letI := T_raw.hGal_L (t + 1)
    letI : IsScalarTower R₀ (RatFunc F) (T_raw.L_raw (t + 1)) :=
      hST_R₀_RF (T_raw.B_raw (t + 1)) (T_raw.L_raw (t + 1))
    exact (hGalLift R₀ (RatFunc F) (T_raw.B_raw t) (T_raw.L_raw t)
      (T_raw.B_raw (t + 1)) (T_raw.L_raw (t + 1)) (T_raw.ι_Braw t) (T_raw.hι_raw t).1).1 σ

  obtain ⟨ρ_mat_raw, hρ_mat_compat, hρ_mat_seq, hρ_mat_inter⟩ :=
    @hAbsTower
      (fun r => weilEtaleTorsionH (weilGeomScheme F Z_u₀) (ℓ ^ (r + 1)) (2 * m + 1))
      inferInstance
      (fun r => weilEtaleTorsionTransition (weilGeomScheme F Z_u₀) ℓ (r + 1) (2 * m + 1))
      (fun r => letI := T_raw.hCR r; letI := T_raw.hAR_B r
        T_raw.B_raw r ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r)
      (fun r => letI := T_raw.hCR r; letI := T_raw.hAR_B r; AlgEquiv.aut)
      (fun r τ σ =>
        letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
        letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
        ∀ b : T_raw.B_raw r, τ (T_raw.ι_Braw r b) = T_raw.ι_Braw r (σ b))
      hCompat_uniq_raw
      T_raw.ρ_raw
      (fun r τ =>
        let ⟨σ, hσ, _⟩ := (T_raw.hι_raw r).2 τ
        ⟨σ, hσ⟩)
      hUp_raw_ex
      hCompat_ρ_raw
      α_lat β_lat matOfAut hMat_one hMat_mul hMat_mod hMat_inter

  have hQu_mat : ∃ (Q_u : ∀ r : ℕ, letI := T_raw.hCR r; Ideal (T_raw.B_raw r))
      (σ_u : ∀ r : ℕ, letI := T_raw.hCR r; letI := T_raw.hAR_B r
        T_raw.B_raw r ≃ₐ[Localization.Away
          (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r),
      ∀ r : ℕ,
        letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
        letI := T_raw.hAP_B r; letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
        (Q_u r).IsMaximal ∧
        Ideal.comap (algebraMap (Polynomial F) (T_raw.B_raw r)) (Q_u r) =
          Ideal.span {Polynomial.X - Polynomial.C a₀} ∧
        Ideal.comap (T_raw.ι_Braw r).toRingHom (Q_u (r + 1)) = Q_u r ∧
        (∀ b : T_raw.B_raw r, (σ_u r).symm b - b ^ Nat.card F ∈ Q_u r) ∧
        (ρ_mat_raw r (σ_u r)).val = (F_V_u.val).map (PadicInt.toZModPow (r + 1)) := by
    obtain ⟨Q_u_raw, σ_u_raw, hQu_raw_spec⟩ := T_raw.hQ_u_raw
    have hσu_compat : ∀ t : ℕ,
        letI := T_raw.hCR t; letI := T_raw.hCR (t + 1)
        letI := T_raw.hAR_B t; letI := T_raw.hAR_B (t + 1)
        ∀ b : T_raw.B_raw t, σ_u_raw (t + 1) (T_raw.ι_Braw t b) = T_raw.ι_Braw t (σ_u_raw t b) :=
      fun t => (hQu_raw_spec t).2.2.2.1
    have hMat_σu :
        matOfAut (fun t => T_raw.ρ_raw t (σ_u_raw t))
          (fun t v => hCompat_ρ_raw t (σ_u_raw (t + 1)) (σ_u_raw t) (hσu_compat t) v) = F_V_u := by
      apply hMat_frob_u
      intro r v
      exact (hQu_raw_spec r).2.2.2.2.2 (M_Zu_mid.frobTorsion (r + 1))
        (M_Zu_mid.hfrobTorsion (r + 1)) v
    refine ⟨Q_u_raw, σ_u_raw, fun r => ?_⟩
    obtain ⟨hMax, hComapP, hComapι, _, hFrobCong, _⟩ := hQu_raw_spec r
    refine ⟨hMax, hComapP, hComapι, hFrobCong, ?_⟩
    rw [hρ_mat_seq σ_u_raw hσu_compat r, hMat_σu]

  obtain ⟨U_V_mat, hQP_mat, hFVmat_trace⟩ :
      ∃ U_V_mat : ∀ (d : ℕ) (P_poly : Polynomial F),
          IsGoodAffineCurveClosedPointPoly S_aff d P_poly →
            (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ,
        (∀ (d : ℕ) (P_poly : Polynomial F)
          (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
          ∃ (Q_P : ∀ r : ℕ, letI := T_raw.hCR r; Ideal (T_raw.B_raw r))
            (σ_P : ∀ r : ℕ, letI := T_raw.hCR r; letI := T_raw.hAR_B r
              T_raw.B_raw r ≃ₐ[Localization.Away
                (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))] T_raw.B_raw r),
            ∀ r : ℕ,
              letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
              letI := T_raw.hAP_B r; letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
              (Q_P r).IsMaximal ∧
              Ideal.comap (algebraMap (Polynomial F) (T_raw.B_raw r)) (Q_P r) =
                Ideal.span {P_poly} ∧
              Ideal.comap (T_raw.ι_Braw r).toRingHom (Q_P (r + 1)) = Q_P r ∧
              (∀ b : T_raw.B_raw r, (σ_P r).symm b - b ^ (Nat.card F ^ d) ∈ Q_P r) ∧
              (ρ_mat_raw r (σ_P r)).val =
                ((U_V_mat d P_poly hP).val).map (PadicInt.toZModPow (r + 1))) ∧
        (∀ (d : ℕ) (P_poly : Polynomial F)
          (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
          1 ≤ d →
          let _ : Fact (Irreducible P_poly) := ⟨hP.2.1⟩
          ∀ (hFin_P : Finite (AdjoinRoot P_poly)),
            let _ : Finite (AdjoinRoot P_poly) := hFin_P
            ∀ (M_ZP_mid : WeilEllAdicCohomologyModel (AdjoinRoot P_poly)
                (weilTransvTriClosedPointFiber F f₀ j_aff P_poly) ℓ (2 * m + 1))
              (k : ℕ),
              1 ≤ k →
              LinearMap.trace (Padic ℓ) M_ZP_mid.V (M_ZP_mid.frob ^ k) =
                Matrix.trace ((((U_V_mat d P_poly hP).val).map
                  (algebraMap (PadicInt ℓ) (Padic ℓ))) ^ k)) := by
    choose Q_P_raw σ_P_raw hQP_raw_spec using T_raw.hQ_P_raw
    have hσP_compat : ∀ (d : ℕ) (P_poly : Polynomial F)
        (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly) (t : ℕ),
        letI := T_raw.hCR t; letI := T_raw.hCR (t + 1)
        letI := T_raw.hAR_B t; letI := T_raw.hAR_B (t + 1)
        ∀ b : T_raw.B_raw t,
          σ_P_raw d P_poly hP (t + 1) (T_raw.ι_Braw t b) =
            T_raw.ι_Braw t (σ_P_raw d P_poly hP t b) :=
      fun d P_poly hP t => ((hQP_raw_spec d P_poly hP).1 t).2.2.2.1
    let U_V_mat : ∀ (d : ℕ) (P_poly : Polynomial F),
        IsGoodAffineCurveClosedPointPoly S_aff d P_poly → (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ :=
      fun d P_poly hP =>
        matOfAut (fun t => T_raw.ρ_raw t (σ_P_raw d P_poly hP t))
          (fun t v => hCompat_ρ_raw t (σ_P_raw d P_poly hP (t + 1))
            (σ_P_raw d P_poly hP t) (hσP_compat d P_poly hP t) v)
    refine ⟨U_V_mat, ?_, ?_⟩
    · intro d P_poly hP
      refine ⟨Q_P_raw d P_poly hP, σ_P_raw d P_poly hP, fun r => ?_⟩
      obtain ⟨hMax, hComapP, hComapι, _, hFrobCong⟩ := (hQP_raw_spec d P_poly hP).1 r
      exact ⟨hMax, hComapP, hComapι, hFrobCong,
        hρ_mat_seq (σ_P_raw d P_poly hP) (hσP_compat d P_poly hP) r⟩
    · intro d P_poly hP hd hFact_P hFin_P hFin_P' M_ZP_mid k hk
      letI : Fact (Irreducible P_poly) := hFact_P
      letI : Finite (AdjoinRoot P_poly) := hFin_P'
      obtain ⟨ψ_P, hψ_trans, hψ_frob⟩ := (hQP_raw_spec d P_poly hP).2 hd hFin_P
      exact hMat_trace (AdjoinRoot P_poly) (weilTransvTriClosedPointFiber F f₀ j_aff P_poly)
        M_ZP_mid (fun t => T_raw.ρ_raw t (σ_P_raw d P_poly hP t))
        (fun t v => hCompat_ρ_raw t (σ_P_raw d P_poly hP (t + 1))
          (σ_P_raw d P_poly hP t) (hσP_compat d P_poly hP t) v)
        ψ_P hψ_trans
        (fun r v => hψ_frob r (M_ZP_mid.frobTorsion (r + 1)) (M_ZP_mid.hfrobTorsion (r + 1)) v)
        k hk

  
  obtain ⟨B_V, L_V, hCR, hDom, hFld, hAF_B, hAP_B, hAR_B,
    hAF_L, hAP_L, hARF_L, hABL, hARL, hST1, hST2, hST3, hST4, hST5, hST6,
    hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L,
    ρ_V, ι_BV, j_BV, G_V,
    hρ_inj, hG_surj, hG_closed, hG_mem, hG_lift_raw,
    hFVu_norm, hFVmat_coset, hι_compat, hj_BV_spec, hQ_u, hQ_P⟩ :=
    weil_mid_dev_closed_faithful_galois_ring_tower_quotient
      F m Z_tilde f₀ Z_u₀ j_aff S_aff U₀ a₀ ha₀ e_U ℓ N hℓ
      T_raw F_V_u U_V_mat ρ_mat_raw hρ_mat_compat hQu_mat hQP_mat

  have hGV_sp : ∀ g ∈ G_V,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J_V := by
    intro g hg
    let ι := algebraMap (PadicInt ℓ) (Padic ℓ)
    have hι_inj : Function.Injective ι := IsFractionRing.injective (PadicInt ℓ) (Padic ℓ)
    obtain ⟨s, hs⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors (PadicInt ℓ))
      (Finset.univ : Finset (Fin N × Fin N)) (fun p => J_V p.1 p.2)
    have hs_ne : (s : PadicInt ℓ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
    have hιs_ne : ι s ≠ 0 := fun h0 => hs_ne (hι_inj (h0.trans (map_zero ι).symm))
    let J_int : Matrix (Fin N) (Fin N) (PadicInt ℓ) :=
      Matrix.of fun i j => Classical.choose (hs (i, j) (Finset.mem_univ (i, j)))
    have hJ_int : ∀ i j : Fin N, ι (J_int i j) = ι s * J_V i j := by
      intro i j
      have h := Classical.choose_spec (hs (i, j) (Finset.mem_univ (i, j)))
      dsimp [J_int]
      simpa [Algebra.smul_def, ι] using h
    have hJ_map : J_int.map ι = (ι s) • J_V := by
      ext i j
      simp [hJ_int i j]
    have hMat_iff : ∀ M : Matrix (Fin N) (Fin N) (PadicInt ℓ),
        (M.map ι).transpose * J_V * (M.map ι) = J_V ↔ M.transpose * J_int * M = J_int := by
      intro M
      have hmap_lhs : (M.transpose * J_int * M).map ι =
          (ι s) • ((M.map ι).transpose * J_V * (M.map ι)) := by
        have h1 : (M.transpose * J_int * M).map ι =
            (M.transpose).map ι * J_int.map ι * M.map ι := by
          simp only [← RingHom.mapMatrix_apply, map_mul]
        rw [h1, ← Matrix.transpose_map, hJ_map, Matrix.mul_smul, Matrix.smul_mul]
      constructor
      · intro hM
        have h2 : (M.transpose * J_int * M).map ι = J_int.map ι := by
          rw [hmap_lhs, hM, hJ_map]
        ext i j
        exact hι_inj (congrArg (fun A => A i j) h2)
      · intro hM
        have h2 : (ι s) • ((M.map ι).transpose * J_V * (M.map ι)) = (ι s) • J_V := by
          rw [← hmap_lhs, hM, hJ_map]
        ext i j
        exact mul_left_cancel₀ hιs_ne (congrArg (fun A => A i j) h2)
    rw [hMat_iff]
    ext i j
    rw [← PadicInt.ext_of_toZModPow]
    intro n
    cases n with
    | zero =>
      have : Subsingleton (ZMod (ℓ ^ 0)) := by rw [pow_zero]; infer_instance
      exact Subsingleton.elim _ _
    | succ r =>
      obtain ⟨τ, hτ_compat, hτ_geom, hτ_mod⟩ := hG_lift_raw g hg r
      let h_r := matOfAut (fun t => T_raw.ρ_raw t (τ t))
        (fun t v => hCompat_ρ_raw t (τ (t + 1)) (τ t) (hτ_compat t) v)
      have hh_sp : ((h_r.val).map ι).transpose * J_V * ((h_r.val).map ι) = J_V := by
        apply hMat_sp
        intro t θ_mid θ_top hθ_mid hθ_top a b a' b' ha hb
        exact T_raw.hCup_geom t (τ t) (hτ_geom t) θ_mid θ_top hθ_mid hθ_top a b a' b' ha hb
      have hh_mod : (h_r.val).map (PadicInt.toZModPow (r + 1)) =
          (g.val).map (PadicInt.toZModPow (r + 1)) :=
        (hρ_mat_seq τ hτ_compat r).symm.trans hτ_mod
      have hh_int : h_r.val.transpose * J_int * h_r.val = J_int := (hMat_iff h_r.val).mp hh_sp
      let φ_r : Matrix (Fin N) (Fin N) (PadicInt ℓ) →+*
          Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))) :=
        RingHom.mapMatrix (PadicInt.toZModPow (p := ℓ) (r + 1))
      have hmod_eq : φ_r (g.val.transpose * J_int * g.val) = φ_r J_int := by
        have hg_mod : φ_r g.val = φ_r h_r.val := hh_mod.symm
        have hgt_mod : φ_r g.val.transpose = φ_r h_r.val.transpose := by
          ext a b
          exact congrArg (fun M => M b a) hh_mod.symm
        rw [map_mul, map_mul, hgt_mod, hg_mod, ← map_mul, ← map_mul, hh_int]
      exact congrArg (fun A => A i j) hmod_eq

  have hFVmat_sim : ∀ (d : ℕ) (P_poly : Polynomial F)
      (hP : IsGoodAffineCurveClosedPointPoly S_aff d P_poly),
      (((U_V_mat d P_poly hP).val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
        (((U_V_mat d P_poly hP).val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) =
          ((Nat.card F : Padic ℓ) ^ ((2 * m + 1) * d)) • J_V := by
