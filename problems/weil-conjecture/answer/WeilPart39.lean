          let lift_pb : S_Ω ⟶ CategoryTheory.Limits.pullback h₁ h₂ :=
            CategoryTheory.Limits.pullback.lift X.val.1 Y.val.1 (X.val.2.trans Y.val.2.symm)
          let e_pb : fib.obj E_pb :=
            ⟨lift_pb, by
              change lift_pb ≫ (CategoryTheory.Limits.pullback.fst h₁ h₂ ≫ h₁) = w
              rw [← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, X.val.2]⟩
          let Z : fib.Elements := CategoryTheory.Functor.elementsMk fib E_pb e_pb
