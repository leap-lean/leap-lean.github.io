    have hSheetsOfPullback : ∀ {Y V_Y : AlgebraicGeometry.Scheme.{u}}
        (q_Y : V_Y ⟶ V₀) (ι_Y : V_Y ⟶ Y) (h : Y ⟶ D₀)
