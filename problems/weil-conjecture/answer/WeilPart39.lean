  · 
    intro E₀ _ _ hE₀_L₀
    letI : Algebra R₀ ↥E₀ := ((algebraMap K ↥E₀).comp (algebraMap R₀ K)).toAlgebra
    let B₀ := ↥(integralClosure R₀ ↥E₀)
    intro hFin_B₀ hEt_B₀
    let b₀ : B₀ := algebraMap R₀ B₀ g₀
    let C'₀ := Localization.Away b₀
    obtain ⟨hDom_C'₀, instAlg_R'_C'₀, instAlg_C'₀_E₀,
      hST_R₀_R'_C'₀, hFin_R'_C'₀, hEt_R'_C'₀, hEt_R₀_C'₀,
      hST_R'_K_E₀, hST_R'_C'₀_E₀, hFrac_C'₀_E₀, hIntCl_C'₀⟩ :=
      hAwayBaseChange (↥E₀) hFin_B₀ hEt_B₀
    have : IsDomain C'₀ := hDom_C'₀
    refine ⟨hDom_C'₀, instAlg_R'_C'₀, instAlg_C'₀_E₀, ?_⟩
    letI : Algebra R' C'₀ := instAlg_R'_C'₀
    letI : Algebra C'₀ ↥E₀ := instAlg_C'₀_E₀
    letI : Algebra R' K := φ_g₀.toAlgebra
    letI : Algebra R' ↥E₀ := ((algebraMap K ↥E₀).comp φ_g₀).toAlgebra
    have : IsFractionRing C'₀ ↥E₀ := hFrac_C'₀_E₀
    let f_ring : C'₀ →+* ↥L₀ :=
      (IntermediateField.inclusion hE₀_L₀).toRingHom.comp (algebraMap C'₀ ↥E₀)
    have h_f_comp :
        (IntermediateField.inclusion hE₀_L₀).toRingHom.comp (algebraMap R' ↥E₀) =
          algebraMap R' ↥L₀ := by
      apply RingHom.ext
      intro r
      exact (IntermediateField.inclusion hE₀_L₀).commutes (φ_g₀ r)
    have h_int_C'₀ : ∀ y : C'₀, f_ring y ∈ integralClosure R' ↥L₀ := by
      intro y
      have hy_int : _root_.IsIntegral R' (algebraMap C'₀ ↥E₀ y) :=
        (@IsIntegralClosure.isIntegral_iff C'₀ R' ↥E₀ _ _ _ _ _ hIntCl_C'₀ _).mpr ⟨y, rfl⟩
      obtain ⟨P, hP_mon, hP_eval⟩ := hy_int
      refine ⟨P, hP_mon, ?_⟩
      change Polynomial.eval₂ (algebraMap R' ↥L₀)
        ((IntermediateField.inclusion hE₀_L₀).toRingHom (algebraMap C'₀ ↥E₀ y)) P = 0
      rw [← h_f_comp, ← Polynomial.hom_eval₂, hP_eval, map_zero]
    let ι_C'₀ : C'₀ →ₐ[R'] C_gal :=
      { toFun := fun y => ⟨f_ring y, h_int_C'₀ y⟩
        map_one' := Subtype.ext (map_one f_ring)
        map_mul' := fun x y => Subtype.ext (map_mul f_ring x y)
        map_zero' := Subtype.ext (map_zero f_ring)
        map_add' := fun x y => Subtype.ext (map_add f_ring x y)
        commutes' := fun r => Subtype.ext (by
          change IntermediateField.inclusion hE₀_L₀ (algebraMap C'₀ ↥E₀ (algebraMap R' C'₀ r)) =
            algebraMap K ↥L₀ (φ_g₀ r)
          rw [← @IsScalarTower.algebraMap_apply R' C'₀ ↥E₀ _ _ _ _ _ _ hST_R'_C'₀_E₀ r]
