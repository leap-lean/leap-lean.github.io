            AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ j_chart ∧
          ε₀.comp α₀ = eval₀_loc ∧
          ε₀.comp β₀ = (AlgebraicGeometry.Spec.preimage s_Bk).hom) := by
    have hSpecUnique : ∀ p₁ p₂ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)), p₁ = p₂ :=
      fun p₁ p₂ => PrimeSpectrum.ext ((hBotPrime p₁).trans (hBotPrime p₂).symm)
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eval₀_loc)
    refine ⟨?_, ?_⟩
    · intro W w₀ pt_k hw₀
      let W_sch := ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W).left
      let f_W := ((AlgebraicGeometry.Scheme.Etale.forget D_bar.left).obj W).hom
      have _ : AlgebraicGeometry.Etale f_W := W.prop
      let W_chart := CategoryTheory.Limits.pullback f_W j_chart
      let fst := CategoryTheory.Limits.pullback.fst f_W j_chart
      let snd := CategoryTheory.Limits.pullback.snd f_W j_chart
      have _ : AlgebraicGeometry.IsOpenImmersion fst := inferInstance
      have _ : AlgebraicGeometry.Etale fst := inferInstance
      have _ : AlgebraicGeometry.Etale snd := inferInstance
      let p₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀)) := s₀.base pt_k
      have hcomm_pt : f_W.base w₀ = j_chart.base p₀ := by
        rw [hw₀, ← hs₀_chart]
        rfl
      obtain ⟨w₁, hw₁_fst, hw₁_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₀ p₀ hcomm_pt
      obtain ⟨U_W, hAff, hw₁_mem, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w₁) (U := ⊤) trivial
      let R_obj := W_chart.presheaf.obj (Opposite.op U_W)
      have hmem_range : w₁ ∈ Set.range hAff.fromSpec.base := by
        rw [hAff.range_fromSpec]
        exact hw₁_mem
      obtain ⟨q₀, hq₀⟩ := hmem_range
      let v₀ : AlgebraicGeometry.Spec (CommRingCat.of ↑R_obj) ⟶ W_sch := hAff.fromSpec ≫ fst
      have _ : AlgebraicGeometry.Etale v₀ := inferInstance
      let snd_aff : AlgebraicGeometry.Spec (CommRingCat.of ↑R_obj) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R₀) := hAff.fromSpec ≫ snd
      have hsnd_et : AlgebraicGeometry.Etale snd_aff := inferInstance
      let α₀ : R₀ →+* ↑R_obj := (AlgebraicGeometry.Spec.preimage snd_aff).hom
      have hα₀_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) = snd_aff :=
        AlgebraicGeometry.Spec.map_preimage snd_aff
      have hα₀_et : α₀.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hα₀_map.symm ▸ hsnd_et)
      refine ⟨↑R_obj, inferInstance, α₀, q₀, v₀, hα₀_et, inferInstance, ?_, ?_, ?_⟩
      · change (hAff.fromSpec ≫ fst) ≫ f_W = _
        rw [Category.assoc, CategoryTheory.Limits.pullback.condition, hα₀_map]
        exact (Category.assoc _ _ _).symm
      · change (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)).base q₀ :
            PrimeSpectrum R₀)).asIdeal = RingHom.ker eval₀_loc
        rw [hα₀_map]
        change ((snd.base (hAff.fromSpec.base q₀) : PrimeSpectrum R₀)).asIdeal = _
        rw [hq₀, hw₁_snd]
        change Ideal.comap eval₀_loc pt_k.asIdeal = _
        rw [hBotPrime pt_k, RingHom.ker_eq_comap_bot]
      · change fst.base (hAff.fromSpec.base q₀) = w₀
