          apply AddCommGrpCat.ext
          intro s₂
          change (θ_V W₁) (ev_W W₁ ((𝒥_V.obj.map (Opposite.op f_et)).hom s₂)) =
            (C_V.obj.map (Opposite.op f_et)).hom ((θ_V W₂) (ev_W W₂ s₂))
          rw [hθ_nat f_et (ev_W W₂ s₂)]
          congr 1
          ext w₁
          let h₁ := (Fgt_V.obj W₁).hom
          let h₂ := (Fgt_V.obj W₂).hom
