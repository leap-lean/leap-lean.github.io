      let p₁ : W_B ⟶ W := CategoryTheory.Limits.pullback.fst w π₀
      let p₂ : W_B ⟶ V₀ := CategoryTheory.Limits.pullback.snd w π₀
      have hp₂_et : AlgebraicGeometry.Etale p₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback w π₀) hw_et
      obtain ⟨q_pb, _, hq_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hz
      have hPull_comp : WeilIsEtaleSheafPullback (p₁ ≫ w) 𝒢₀
          ((CategoryTheory.constantSheaf W_B.smallEtaleTopology AddCommGrpCat.{u}).obj A_y) :=
