              ((x (f_w w) (hf_w w)).hom m) (y_w w) := h1
          exact (congrArg (t'.hom m) (hy_w w)).symm.trans h1'
      let ℒ_sh : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} := ⟨ℒ_pre, hSh_ℒ⟩
      let P_const : CategoryTheory.Functor (V.Etale)ᵒᵖ AddCommGrpCat.{u} :=
        (CategoryTheory.Functor.const (V.Etale)ᵒᵖ).obj A
      let θ_A : P_const ⟶ ℒ_pre :=
        { app := fun _ => AddCommGrpCat.ofHom LocallyConstant.constAddMonoidHom
          naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
      let adj_sh := CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}
      let C_V' : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} :=
        (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj P_const
      let φ_A : C_V' ⟶ ℒ_sh := (adj_sh.homEquiv P_const ℒ_sh).symm θ_A
      let η_sh : P_const ⟶ C_V'.obj := adj_sh.unit.app P_const
      have hη_φ : η_sh ≫ φ_A.hom = θ_A := by
        have h1 := adj_sh.homEquiv_unit P_const ℒ_sh φ_A
        have h2 : adj_sh.homEquiv P_const ℒ_sh φ_A = θ_A :=
          (adj_sh.homEquiv P_const ℒ_sh).apply_symm_apply θ_A
        exact h1.symm.trans h2
      let E_ℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      have hEmptyElemEq : ∀ (W' : V.Etale), IsEmpty ↥W'.left →
          ∀ s₁ s₂ : ↑(C_V'.obj.obj (Opposite.op W')), s₁ = s₂ := by
        intro W' hEmp s₁ s₂
        let mkZ : ↑(C_V'.obj.obj (Opposite.op W')) → (E_ℤ ⟶ C_V'.obj.obj (Opposite.op W')) := fun s =>
          AddCommGrpCat.ofHom
            { toFun := fun n => n.down • s
              map_zero' := zero_zsmul s
              map_add' := fun n₁ n₂ => add_zsmul s n₁.down n₂.down }
        have hhom : mkZ s₁ = mkZ s₂ := hEmptyHomEq V C_V' W' hEmp (mkZ s₁) (mkZ s₂)
        simpa [mkZ, one_zsmul] using congrArg (fun u : E_ℤ ⟶ _ => u.hom (ULift.up 1)) hhom
      let mkOpenObj : ∀ (Y : V.Etale) (U_o : Y.left.Opens), V.Etale := fun Y U_o =>
        have : AlgebraicGeometry.Etale Y.hom := Y.prop
        CategoryTheory.MorphismProperty.Over.mk ⊤ (U_o.ι ≫ Y.hom) inferInstance
      let mkOpenHom : ∀ (Y : V.Etale) (U_o : Y.left.Opens), mkOpenObj Y U_o ⟶ Y := fun Y U_o =>
        CategoryTheory.MorphismProperty.Over.homMk U_o.ι rfl trivial
      have hOpenHomEtale : ∀ (Y : V.Etale) (U_o : Y.left.Opens),
          AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget V).map (mkOpenHom Y U_o)).left := by
        intro Y U_o
        change AlgebraicGeometry.Etale U_o.ι
        infer_instance
      let ψ_sub : ∀ (Y : V.Etale) (g : LocallyConstant ↥Y.left ↥A),
