    have hPb_tot : WeilIsEtaleSheafPullback (π₀ ≫ e_U.hom) 𝒢
        ((CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A_η) :=
      (hPbPkg.2.2.1 π₀ e_U.hom 𝒢 𝒢₀ _).1 hPb_eU hPb_π₀_const
    exact ⟨E₀, hFD₀, hGal₀, hFin₀, hEt₀, A_η, hFin_Aη, hPb_tot⟩

  
  have hPushTower : ∀ (E_sub E_big : IntermediateField K (AlgebraicClosure K))
      (hle : E_sub ≤ E_big) (𝒢 : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
      (A : AddCommGrpCat.{u}),
      (letI : Algebra R₀ ↥E_sub := ((algebraMap K ↥E_sub).comp (algebraMap R₀ K)).toAlgebra
       let B_sub := ↥(integralClosure R₀ ↥E_sub)
       let π_sub : AlgebraicGeometry.Spec (CommRingCat.of B_sub) ⟶ U :=
         AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_sub)) ≫ e_U.hom
       WeilIsEtaleSheafPullback π_sub 𝒢
         ((CategoryTheory.constantSheaf
           (AlgebraicGeometry.Spec (CommRingCat.of B_sub)).smallEtaleTopology
           AddCommGrpCat.{u}).obj A)) →
      (letI : Algebra R₀ ↥E_big := ((algebraMap K ↥E_big).comp (algebraMap R₀ K)).toAlgebra
       let B_big := ↥(integralClosure R₀ ↥E_big)
       let π_big : AlgebraicGeometry.Spec (CommRingCat.of B_big) ⟶ U :=
         AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_big)) ≫ e_U.hom
       WeilIsEtaleSheafPullback π_big 𝒢
         ((CategoryTheory.constantSheaf
           (AlgebraicGeometry.Spec (CommRingCat.of B_big)).smallEtaleTopology
           AddCommGrpCat.{u}).obj A)) := by
    intro E_sub E_big hle 𝒢 A hPull_sub
    dsimp only
    let _ : Algebra R₀ ↥E_sub := ((algebraMap K ↥E_sub).comp (algebraMap R₀ K)).toAlgebra
    let _ : Algebra R₀ ↥E_big := ((algebraMap K ↥E_big).comp (algebraMap R₀ K)).toAlgebra
    let B_sub := ↥(integralClosure R₀ ↥E_sub)
    let B_big := ↥(integralClosure R₀ ↥E_big)
    let incl : ↥E_sub →ₐ[K] ↥E_big := IntermediateField.inclusion hle
    have hincl_R₀ : incl.toRingHom.comp (algebraMap R₀ ↥E_sub) = algebraMap R₀ ↥E_big :=
      RingHom.ext fun r => incl.commutes (algebraMap R₀ K r)
    let ι_B : B_sub →+* B_big :=
      { toFun := fun b => ⟨incl b.1, hMapInt incl.toRingHom hincl_R₀ b.1 b.2⟩
        map_one' := Subtype.ext (map_one incl)
        map_mul' := fun x y => Subtype.ext (map_mul incl x.1 y.1)
        map_zero' := Subtype.ext (map_zero incl)
        map_add' := fun x y => Subtype.ext (map_add incl x.1 y.1) }
    let q_B : AlgebraicGeometry.Spec (CommRingCat.of B_big) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_sub) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
    let π_sub : AlgebraicGeometry.Spec (CommRingCat.of B_sub) ⟶ U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_sub)) ≫ e_U.hom
    let π_big : AlgebraicGeometry.Spec (CommRingCat.of B_big) ⟶ U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B_big)) ≫ e_U.hom
    have hq_comp : q_B ≫ π_sub = π_big := by
      dsimp [q_B, π_sub, π_big]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have h_hom : CommRingCat.ofHom (algebraMap R₀ B_sub) ≫ CommRingCat.ofHom ι_B =
          CommRingCat.ofHom (algebraMap R₀ B_big) := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        exact Subtype.ext (incl.commutes (algebraMap R₀ K r))
      rw [h_hom]
    have hPull_sub' : WeilIsEtaleSheafPullback π_sub 𝒢
        ((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of B_sub)).smallEtaleTopology
          AddCommGrpCat.{u}).obj A) := hPull_sub
    change WeilIsEtaleSheafPullback π_big 𝒢
      ((CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of B_big)).smallEtaleTopology
        AddCommGrpCat.{u}).obj A)
    rw [← hq_comp]
    exact (hPbPkg.2.2.1 q_B π_sub 𝒢 _ _).1 hPull_sub' (hPbPkg.2.2.2.1 q_B A)

  induction k with
  | zero =>
    exact ⟨L_prev, inferInstance, inferInstance, le_refl L_prev, hPrev_up.1, hPrev_up.2,
      fun i => Fin.elim0 i⟩
  | succ k ih =>
    obtain ⟨E₁, hFD₁, hGal₁, hPrev_le₁, hFin₁, hEt₁, hFam₁⟩ :=
      ih (fun j => ℱ j.castSucc) (fun j x => hLC j.castSucc x)
    obtain ⟨E₂, hFD₂, hGal₂, hFin₂, hEt₂, A_last, hFin_last, hPull_last⟩ :=
      hSingleSheaf (ℱ (Fin.last k)) (hLC (Fin.last k))
    let _ : FiniteDimensional K ↥E₁ := hFD₁
    let _ : IsGalois K ↥E₁ := hGal₁
    let _ : FiniteDimensional K ↥E₂ := hFD₂
    let _ : IsGalois K ↥E₂ := hGal₂
    let E := E₁ ⊔ E₂
    have hFD_E : FiniteDimensional K ↥E := IntermediateField.finiteDimensional_sup E₁ E₂
    have hGal_E : IsGalois K ↥E := inferInstance
    obtain ⟨hFin_E, hEt_E⟩ := hCompositum E₁ E₂ ⟨hFin₁, hEt₁⟩ ⟨hFin₂, hEt₂⟩
    refine ⟨E, hFD_E, hGal_E, hPrev_le₁.trans le_sup_left, hFin_E, hEt_E, fun i => ?_⟩
    rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
    · obtain ⟨A_j, hFin_j, hPull_j⟩ := hFam₁ j
      exact ⟨A_j, hFin_j, hPushTower E₁ E le_sup_left (ℱ j.castSucc) A_j hPull_j⟩
    · exact ⟨A_last, hFin_last, hPushTower E₂ E le_sup_right (ℱ (Fin.last k)) A_last hPull_last⟩

theorem weil_mid_dev_raw_galois_torsor_sheaf_triv_system (R₀ : Type u) [CommRing R₀] [IsDomain R₀]
    (K : Type u) [Field K] [Algebra R₀ K] [IsFractionRing R₀ K]
    (U : AlgebraicGeometry.Scheme.{u})
    (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U)
    (B L : ℕ → Type u)
    [∀ r, CommRing (B r)] [∀ r, IsDomain (B r)] [∀ r, Field (L r)]
    [∀ r, Algebra R₀ (B r)] [∀ r, Algebra K (L r)]
    [∀ r, Algebra (B r) (L r)] [∀ r, Algebra R₀ (L r)]
    [∀ r, IsScalarTower R₀ K (L r)] [∀ r, IsScalarTower R₀ (B r) (L r)]
    [∀ r, Module.Finite R₀ (B r)] [∀ r, Algebra.Etale R₀ (B r)]
    [∀ r, IsFractionRing (B r) (L r)] [∀ r, IsIntegralClosure (B r) R₀ (L r)]
    [∀ r, FiniteDimensional K (L r)] [∀ r, IsGalois K (L r)]
    (ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1))
    (hπ_et : ∀ r : ℕ,
      AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom))
    (hι_inj : ∀ r : ℕ, Function.Injective (ι_B r))
    (hι_res : ∀ (r : ℕ) (τ : B (r + 1) ≃ₐ[R₀] B (r + 1)),
      ∃ σ : B r ≃ₐ[R₀] B r, ∀ b : B r, τ (ι_B r b) = ι_B r (σ b))
    (ℛ : ℕ → CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
    (π_ℛ : ∀ r : ℕ, Quiver.Hom (ℛ (r + 1)) (ℛ r))
    (hConst : ∀ r : ℕ,
      let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
      let π_r : V_r ⟶ U :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      ∃ A_r : AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback π_r (ℛ r)
          ((CategoryTheory.constantSheaf V_r.smallEtaleTopology AddCommGrpCat.{u}).obj A_r))
    (H : ℕ → Type u) [∀ r, AddCommGroup (H r)]
    (trans_H : ∀ r : ℕ, H (r + 1) →+ H r)
    (eval_V : ∀ r : ℕ,
      letI := hπ_et r
      let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      ↑((ℛ r).obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk π_r))) ≃+ H r)
    (heval_trans : ∀ r : ℕ,
      letI := hπ_et r
      letI := hπ_et (r + 1)
      let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      let π_succ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1)))) ≫ e_U.hom
      let E_r : U.Etale := AlgebraicGeometry.Scheme.Etale.mk π_r
      let E_succ : U.Etale := AlgebraicGeometry.Scheme.Etale.mk π_succ
      ∀ (u_ι : Quiver.Hom E_succ E_r),
        ((AlgebraicGeometry.Scheme.Etale.forget U).map u_ι).left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom) →
        ∀ (s_up : ↑((ℛ (r + 1)).obj.obj (Opposite.op E_succ)))
          (s_dn : ↑((ℛ r).obj.obj (Opposite.op E_r))),
          eval_V r s_dn = trans_H r (eval_V (r + 1) s_up) →
          ((π_ℛ r).hom.app (Opposite.op E_succ)).hom s_up =
            ((ℛ r).obj.map (Opposite.op u_ι)).hom s_dn) :
    ∃ (ρ : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (AddMonoid.End (H r))ˣ)
      (triv : ∀ (r : ℕ) (W : U.Etale),
        let π_r :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom π_r
        ↑((ℛ r).obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_r (H r)),
      (∀ (r : ℕ) (σ : B r ≃ₐ[R₀] B r),
        letI := hπ_et r
        let π_r :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
        let E_r : U.Etale := AlgebraicGeometry.Scheme.Etale.mk π_r
        ∀ (u_σ : Quiver.Hom E_r E_r),
          ((AlgebraicGeometry.Scheme.Etale.forget U).map u_σ).left =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) →
          ∀ s : ↑((ℛ r).obj.obj (Opposite.op E_r)),
            (ρ r σ).val (eval_V r (((ℛ r).obj.map (Opposite.op u_σ)).hom s)) =
              eval_V r s) ∧
      (∀ (r : ℕ) (τ : B (r + 1) ≃ₐ[R₀] B (r + 1)) (σ : B r ≃ₐ[R₀] B r),
        (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) →
        ∀ v : H (r + 1),
          trans_H r ((ρ (r + 1) τ).val v) = (ρ r σ).val (trans_H r v)) ∧
      (∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_r : Quiver.Hom V_r U := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) e_U.hom
        let π_succ : Quiver.Hom
            (AlgebraicGeometry.Spec (CommRingCat.of (B (r + 1)))) U :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B (r + 1)))))
            e_U.hom
        (∀ {W₁ W₂ : U.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r
                (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U).map u).left →
            CategoryTheory.CategoryStruct.comp u_r
                (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑((ℛ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv r W₁ (((ℛ r).obj.map (Opposite.op u)) s) y₁ =
                triv r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          let W_succ := CategoryTheory.Limits.pullback h_W π_succ
          Function.Injective (triv r W) ∧
          Set.range (triv r W) =
            { f | ∀ (σ : B r ≃ₐ[R₀] B r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ
                  (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = (ρ r σ).val (f y) } ∧
          ∀ (s_up : ↑((ℛ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι
                (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_succ →
            CategoryTheory.CategoryStruct.comp m_ι
                (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_succ)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)) →
            ∀ (y_up : ↥W_succ),
              triv r W (((π_ℛ r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) =
                trans_H r (triv (r + 1) W s_up y_up)) :=
by
  classical
  let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}

  
  have hMem : ∀ (X₀ : AlgebraicGeometry.Scheme.{u}) (W : X₀.Etale) (R_sieve : CategoryTheory.Sieve W),
      R_sieve ∈ X₀.smallEtaleTopology W ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget X₀).obj W).left,
          ∃ (Y : X₀.Etale) (f : Y ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget X₀).obj Y).left),
            R_sieve.arrows f ∧
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget X₀).map f).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget X₀).map f).left.base y = x := by
    intro X₀ W R_sieve
    have hEqTop : X₀.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_Et P_Et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_Et) (Q := P_Et) X₀ (le_refl P_Et)
    exact (iff_of_eq (congrFun (congrArg (fun J : CategoryTheory.GrothendieckTopology X₀.Etale =>
      fun R => R ∈ J W) hEqTop) R_sieve)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_Et) (Q := P_Et) W R_sieve)

  have hEmptyHomEq : ∀ (X₀ : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
      (W' : X₀.Etale),
      IsEmpty ↥W'.left →
      ∀ {E : AddCommGrpCat.{u}} (u₁ u₂ : E ⟶ G.obj.obj (Opposite.op W')), u₁ = u₂ := by
    intro X₀ G W' hEmp E u₁ u₂
    have hBotCov : CategoryTheory.Sieve.ofArrows (fun i : PEmpty.{u + 1} => i.elim)
        (fun i : PEmpty.{u + 1} => i.elim) ∈ X₀.smallEtaleTopology W' := by
      rw [hMem]
      intro x
      exact hEmp.elim x
    exact G.property.hom_ext_ofArrows _ hBotCov (fun i => i.elim)

  
  have hPart1 : ∀ (S L_r : Type u) [CommRing S] [IsDomain S] [Field L_r]
      [Algebra R₀ S] [Algebra K L_r] [Algebra S L_r] [Algebra R₀ L_r]
      [IsScalarTower R₀ K L_r] [IsScalarTower R₀ S L_r]
      [Module.Finite R₀ S] [Algebra.Etale R₀ S]
      [IsFractionRing S L_r] [IsIntegralClosure S R₀ L_r]
      [FiniteDimensional K L_r] [IsGalois K L_r]
      (hπ_et_s : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S)) ≫ e_U.hom))
      (ℱ : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
      (A : AddCommGrpCat.{u})
      (hPull : WeilIsEtaleSheafPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S)) ≫ e_U.hom)
        ℱ
        ((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of S)).smallEtaleTopology AddCommGrpCat.{u}).obj A))
      (H_s : Type u) [AddCommGroup H_s]
      (ev : letI := hπ_et_s
        ↑(ℱ.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S)) ≫ e_U.hom)))) ≃+ H_s),
      let V := AlgebraicGeometry.Spec (CommRingCat.of S)
      let π : V ⟶ U := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S)) ≫ e_U.hom
      let j_π := weilEtalePostcomp π hπ_et_s
      (∃ Φ : ∀ Y : V.Etale,
          ↑(ℱ.obj.obj (Opposite.op (j_π.obj Y))) ≃+ LocallyConstant ↥Y.left H_s,
        (∀ {Y₁ Y₂ : V.Etale} (f : Y₁ ⟶ Y₂) (u_f : j_π.obj Y₁ ⟶ j_π.obj Y₂),
          u_f.left = f.left →
          ∀ (s : ↑(ℱ.obj.obj (Opposite.op (j_π.obj Y₂)))) (y₁ : ↥Y₁.left),
            Φ Y₁ ((ℱ.obj.map (Opposite.op u_f)).hom s) y₁ =
              Φ Y₂ s (f.left.base y₁)) ∧
        (letI := hπ_et_s
         let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
         ∀ (u_id : j_π.obj T_V ⟶ AlgebraicGeometry.Scheme.Etale.mk π),
           u_id.left = 𝟙 V →
           ∀ (s : ↑(ℱ.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk π)))) (x : ↥V),
             Φ T_V ((ℱ.obj.map (Opposite.op u_id)).hom s) x = ev s)) ∧
      ((∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : W ⟶ U),
          let W_V := CategoryTheory.Limits.pullback h_W π
          (AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π) ∧
            AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π)) ∧
          (∀ σ : S ≃ₐ[R₀] S, ∃! m_σ : W_V ⟶ W_V,
            m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π =
              CategoryTheory.Limits.pullback.fst h_W π ∧
            m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π =
              CategoryTheory.Limits.pullback.snd h_W π ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
          let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
          ∃ δ : (S ≃ₐ[R₀] S) → (Y ⟶ Y_V),
            (∀ σ : S ≃ₐ[R₀] S,
              δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y ∧
              δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
                g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
              AlgebraicGeometry.Etale (δ σ)) ∧
            (⋃ σ : S ≃ₐ[R₀] S, Set.range (δ σ).base) = Set.univ)) := by
    intro S L_r _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hπ_et_s ℱ A hPull H_s _ ev
    have _ : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S)) ≫ e_U.hom) := hπ_et_s
    let V := AlgebraicGeometry.Spec (CommRingCat.of S)
    let π : V ⟶ U := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S)) ≫ e_U.hom
    let C_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj A

    have hConstEquiv : ∃ θ_V : ∀ Y : V.Etale,
        ↑(C_V.obj.obj (Opposite.op Y)) ≃+ LocallyConstant ↥Y.left ↥A,
        ∀ {Y₁ Y₂ : V.Etale} (f : Y₁ ⟶ Y₂) (s : ↑(C_V.obj.obj (Opposite.op Y₂))),
          θ_V Y₁ ((C_V.obj.map (Opposite.op f)).hom s) = (θ_V Y₂ s).comap f.left.base.hom := by
      let ℒ_pre : CategoryTheory.Functor (V.Etale)ᵒᵖ AddCommGrpCat.{u} :=
        { obj := fun opY => AddCommGrpCat.of (LocallyConstant ↥opY.unop.left ↥A)
          map := fun f => AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom f.unop.left.base.hom)
          map_id := fun _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
          map_comp := fun _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
      have hSh_ℒ : CategoryTheory.Presheaf.IsSheaf V.smallEtaleTopology ℒ_pre := by
        intro M W S_cov hScov x hx
        have hOverlap : ∀ {Y₁ Y₂ : V.Etale} (f₁ : Y₁ ⟶ W) (hf₁ : S_cov.arrows f₁)
            (f₂ : Y₂ ⟶ W) (hf₂ : S_cov.arrows f₂) (y₁ : ↥Y₁.left) (y₂ : ↥Y₂.left),
            f₁.left.base y₁ = f₂.left.base y₂ →
            ∀ m : ↥M, ((x f₁ hf₁).hom m) y₁ = ((x f₂ hf₂).hom m) y₂ := by
          intro Y₁ Y₂ f₁ hf₁ f₂ hf₂ y₁ y₂ hy_eq m
          have : AlgebraicGeometry.Etale W.hom := W.prop
          have : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
          have : AlgebraicGeometry.Etale Y₂.hom := Y₂.prop
          have _ : AlgebraicGeometry.Etale (f₁.left ≫ W.hom) := by
            rw [CategoryTheory.MorphismProperty.Over.w f₁]; exact Y₁.prop
          have _ : AlgebraicGeometry.Etale (f₂.left ≫ W.hom) := by
            rw [CategoryTheory.MorphismProperty.Over.w f₂]; exact Y₂.prop
          have : AlgebraicGeometry.Etale f₁.left := AlgebraicGeometry.Etale.of_comp f₁.left W.hom
          have : AlgebraicGeometry.Etale f₂.left := AlgebraicGeometry.Etale.of_comp f₂.left W.hom
          let p₁ := CategoryTheory.Limits.pullback.fst f₁.left f₂.left
          let p₂ := CategoryTheory.Limits.pullback.snd f₁.left f₂.left
          have : AlgebraicGeometry.Etale p₁ := inferInstance
          let Z : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (p₁ ≫ Y₁.hom)
          let g₁ : Z ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
          have hw₂ : p₂ ≫ Y₂.hom = p₁ ≫ Y₁.hom := by
            rw [← CategoryTheory.MorphismProperty.Over.w f₁,
              ← CategoryTheory.MorphismProperty.Over.w f₂,
              ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition]
          let g₂ : Z ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ hw₂ trivial
          have hg_eq : g₁ ≫ f₁ = g₂ ≫ f₂ :=
            CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
          have hcompat := hx g₁ g₂ hf₁ hf₂ hg_eq
          obtain ⟨z, hz₁, hz₂⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
          have heval := congrArg (fun u : M ⟶ ℒ_pre.obj (Opposite.op Z) => (u.hom m) z) hcompat
          have heval' : ((x f₁ hf₁).hom m) (p₁.base z) = ((x f₂ hf₂).hom m) (p₂.base z) := heval
          exact (congrArg ((x f₁ hf₁).hom m) hz₁).symm.trans
            (heval'.trans (congrArg ((x f₂ hf₂).hom m) hz₂))
        choose Y_w f_w y_w hf_w het_w hy_w using (hMem V W S_cov).mp hScov
        let g_fun : ↥M → ↥W.left → ↥A := fun m w => ((x (f_w w) (hf_w w)).hom m) (y_w w)
        have hg_arrow : ∀ {Y : V.Etale} (f : Y ⟶ W) (hf : S_cov.arrows f) (y : ↥Y.left) (m : ↥M),
            g_fun m (f.left.base y) = ((x f hf).hom m) y := by
          intro Y f hf y m
          exact hOverlap (f_w (f.left.base y)) (hf_w (f.left.base y)) f hf
            (y_w (f.left.base y)) y (hy_w (f.left.base y)) m
        have hg_lc : ∀ m : ↥M, IsLocallyConstant (g_fun m) := by
          intro m s
          have hset : g_fun m ⁻¹' s =
              ⋃ w : ↥W.left, (f_w w).left.base '' (((x (f_w w) (hf_w w)).hom m) ⁻¹' s) := by
            ext z
            simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
            constructor
            · intro hz
              exact ⟨z, y_w z, hz, hy_w z⟩
            · rintro ⟨w, y, hy, rfl⟩
