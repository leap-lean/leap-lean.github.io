            (pf_U.obj ℛ_U))
          (Θ_U : CategoryTheory.Iso (pf_U.obj ℛ_U)
            (weilEtaleHigherDirectImage U_bar.ι 0 ℛ_U)),
          WeilIsSingDevAlgBCConstPush f_bar U_bar.ι (f_bar ∣_ U_bar) (f_bar ⁻¹ᵁ U_bar).ι
            (AlgebraicGeometry.isPullback_morphismRestrict f_bar U_bar).w.symm A_r q γ_bar ∧
