by
  classical
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out

  
  obtain ⟨a₀, ha₀, e_U, hu₀_eq, heU_eq⟩ :
      ∃ (a₀ : F) (_ : a₀ ∉ S_aff)
        (e_U : CategoryTheory.Iso
          (AlgebraicGeometry.Spec (CommRingCat.of
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)))))
          U₀.toScheme),
        u₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀)) ≫ j_aff ∧
        e_U.hom ≫ U₀.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F)
            (Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))))) ≫
            j_aff := by
    let D₀ := weilProjectiveSpaceOver F 1
    let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
    let R₀ := Localization.Away Δ_aff
    have hBasic : { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal } =
        (PrimeSpectrum.basicOpen Δ_aff : Set (PrimeSpectrum (Polynomial F))) := by
      ext p
      let p_spec : PrimeSpectrum (Polynomial F) := p
      change (∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p_spec.asIdeal) ↔
        Δ_aff ∉ p_spec.asIdeal
      have haux : ∀ S : Finset F,
          (∀ a ∈ S, Polynomial.X - Polynomial.C a ∉ p_spec.asIdeal) ↔
            (∏ s ∈ S, (Polynomial.X - Polynomial.C s)) ∉ p_spec.asIdeal := by
        intro S
        induction S using Finset.induction_on with
        | empty =>
          simp [p_spec.isPrime.one_notMem]
        | @insert b S hb ih =>
          rw [Finset.prod_insert hb]
          constructor
          · intro h hbS
            rcases p_spec.isPrime.mem_or_mem hbS with h1 | h2
            · exact h b (Finset.mem_insert_self b S) h1
            · exact (ih.mp (fun a ha => h a (Finset.mem_insert_of_mem ha))) h2
          · intro h a ha hmem
            rcases Finset.mem_insert.mp ha with rfl | haS
            · exact h (Ideal.mul_mem_right _ p_spec.asIdeal hmem)
            · exact ih.mpr (fun hprod => h (Ideal.mul_mem_left p_spec.asIdeal _ hprod)) a haS hmem
      exact haux S_aff
