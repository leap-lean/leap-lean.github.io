      have hσ₀_symm : ((AlgEquiv.mapIntegralClosure σ₀_R').symm b).1 = σ₀.symm b.1 := by
        apply σ₀.injective
        have h1 : σ₀ ((AlgEquiv.mapIntegralClosure σ₀_R').symm b).1 =
