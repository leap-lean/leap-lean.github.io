  have hm_ι_surj : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
      Function.Surjective (m_ι_can r W).base := by
    intro r W
    have h := ((hRelTors (B_V r) (L_V r) (B_V (r + 1)) (L_V (r + 1))
      (ι_BV r) (hι_BV r).1).2 W (m_ι_can r W)
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)).1.2
    exact (m_ι_can r W).surjective

