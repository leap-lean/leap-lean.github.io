    rw [CategoryTheory.Abelian.Ext.comp_assoc a' (CategoryTheory.Abelian.Ext.mk₀ ε) _
        (Nat.add_zero i) (Nat.zero_add j) h_ijk,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ε) (CategoryTheory.Abelian.Ext.mk₀ η)
        (b'.comp (CategoryTheory.Abelian.Ext.mk₀ ε) (Nat.add_zero j)) (Nat.zero_add j),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hεη, CategoryTheory.Abelian.Ext.mk₀_id_comp,
