  have hPushConst : WeilIsConstructibleModPrimeSheaf ℓ
      (AlgebraicGeometry.Spec (CommRingCat.of k_bar))
      (weilEtaleHigherDirectImage S_over.hom i 𝒥_bar) :=
    weil_etale_proper_constructible_pushforward k_bar ℓ hℓ_k hPBC hP1
      S_over B_pt f₀ hProp_geom 𝒥_bar hConst_Jbar i
  exact h_extract_s5 k_bar S_over 𝒥_bar ℓ i hPushConst

theorem weil_curve_open_iso_cokernel_geom_h1_subsingleton (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (ℱ₁ ℱ₂ : CategoryTheory.Sheaf (weilProjectiveSpaceOver F 1).left.smallEtaleTopology
      AddCommGrpCat.{u})
    (φ : Quiver.Hom ℱ₁ ℱ₂)
    (hφ_U₀ : ∀ W : (weilProjectiveSpaceOver F 1).left.Etale,
      Set.range ((AlgebraicGeometry.Scheme.Etale.forget (weilProjectiveSpaceOver F 1).left).obj W).hom.base ⊆
        (U₀ : Set (weilProjectiveSpaceOver F 1).left) →
      Function.Bijective (φ.hom.app (Opposite.op W))) :
    let Y₀ := weilProjectiveSpaceOver F 1
    let pr_Y : Quiver.Hom (weilGeomScheme F Y₀) Y₀.left :=
      CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    ∀ (hCont_pr : (weilEtaleSitePullback pr_Y).IsContinuous
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
      (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
        hCont_pr).IsRightAdjoint),
      Subsingleton
        (((@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
            Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
            hCont_pr hAdj_pr).obj (CategoryTheory.Limits.cokernel φ)).H 1) :=
by
  classical
  intro Y₀ pr_Y hCont_pr hAdj_pr

  
  have hPart1 :
      ∃ (m : ℕ)
        (s_bar : Fin m → Quiver.Hom
          (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F)))
          (weilGeomScheme F Y₀)),
        (∀ i : Fin m, AlgebraicGeometry.IsClosedImmersion (s_bar i)) ∧
        (((TopologicalSpace.Opens.map pr_Y.base).obj U₀ : Set (weilGeomScheme F Y₀))ᶜ =
          ⋃ i : Fin m, Set.range (s_bar i).base) := by
    clear ℱ₁ ℱ₂ φ hφ_U₀ hCont_pr hAdj_pr
    let _ : AlgebraicGeometry.IsOpenImmersion j_aff := hj_open
    let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
    let k := AlgebraicClosure F
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let g_ext : S_k ⟶ S_F := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k))
    let e_S : Fin S_aff.card ≃ ↥S_aff := S_aff.equivFin.symm
    let m : ℕ := S_aff.card + 1
    let s_F : Fin m → (S_F ⟶ Y₀.left) :=
      Fin.cases s_inf (fun j =>
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (e_S j).1)) ≫ j_aff)
    have hs_F_sec : ∀ i : Fin m, s_F i ≫ Y₀.hom = 𝟙 S_F := by
      refine Fin.cases ?_ (fun j => ?_)
      · exact hsinf_sec
      · dsimp [s_F]
        rw [Category.assoc, hj_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hid : (Polynomial.evalRingHom (e_S j).1).comp Polynomial.C = RingHom.id F := by
          ext c
          exact Polynomial.eval_C
        rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have hBotPrime : ∀ (L : Type u) [Field L], (⊥ : Ideal L).IsPrime := fun L _ =>
      ⟨fun htop => one_ne_zero (α := L) ((Ideal.mem_bot (R := L)).mp (htop ▸ Submodule.mem_top)),
        fun {x y} hxy => by
          rw [Ideal.mem_bot] at hxy ⊢
          rw [Ideal.mem_bot]
          exact mul_eq_zero.mp hxy⟩
    have hSpec_bot : ∀ {L : Type u} [Field L] (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of L))),
        pt.asIdeal = ⊥ := by
      intro L _ pt
      by_contra hne
      obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (IsUnit.mk0 x hx0))
    have hBaseCompl : (U₀ : Set Y₀.left)ᶜ = ⋃ i : Fin m, Set.range (s_F i).base := by
      ext y
      simp only [Set.mem_compl_iff, SetLike.mem_coe, Set.mem_iUnion, Set.mem_range]
      constructor
      · intro hyU
        by_cases hy_aff : y ∈ Set.range j_aff.base
        · rcases hy_aff with ⟨p, rfl⟩
          have hp_not : ¬ ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal := by
            intro hgood
            apply hyU
            change j_aff.base p ∈ (U₀ : Set Y₀.left)
            rw [hU₀_eq]
            exact ⟨p, hgood, rfl⟩
          push Not at hp_not
          rcases hp_not with ⟨a, ha, hmem⟩
          let j : Fin S_aff.card := e_S.symm ⟨a, ha⟩
          have hj_val : (e_S j).1 = a := congrArg Subtype.val (e_S.apply_symm_apply ⟨a, ha⟩)
          have hmax : (Ideal.span ({Polynomial.X - Polynomial.C a} : Set (Polynomial F))).IsMaximal :=
            PrincipalIdealRing.isMaximal_of_irreducible (Polynomial.irreducible_X_sub_C a)
          have hle : Ideal.span ({Polynomial.X - Polynomial.C a} : Set (Polynomial F)) ≤ p.asIdeal :=
            Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem)
          have heq_id : Ideal.span ({Polynomial.X - Polynomial.C a} : Set (Polynomial F)) = p.asIdeal :=
            hmax.eq_of_le p.isPrime.ne_top hle
          let pt₀ : ↥S_F := ⟨⊥, hBotPrime F⟩
          refine ⟨Fin.succ j, pt₀, ?_⟩
          dsimp [s_F]
          change j_aff.base ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.evalRingHom (e_S j).1))).base pt₀) = j_aff.base p
          congr 1
          apply PrimeSpectrum.ext
          change Ideal.comap (Polynomial.evalRingHom (e_S j).1) pt₀.asIdeal = p.asIdeal
          rw [hSpec_bot pt₀, ← RingHom.ker_eq_comap_bot, hj_val, Polynomial.ker_evalRingHom, heq_id]
        · have hy_inf : y ∈ Set.range s_inf.base := by
            rw [← hsinf_compl]
            exact hy_aff
          rcases hy_inf with ⟨pt₀, hpt₀⟩
          exact ⟨0, pt₀, hpt₀⟩
      · rintro ⟨i, pt₀, rfl⟩
        refine Fin.cases ?_ (fun j => ?_) i
        · intro hyU
          change (s_F 0).base pt₀ ∈ (U₀ : Set Y₀.left) at hyU
          dsimp [s_F] at hyU
          rw [hU₀_eq] at hyU
          rcases hyU with ⟨p, _, hp_eq⟩
          have hmem_inf : s_inf.base pt₀ ∈ (Set.range j_aff.base)ᶜ := by
            rw [hsinf_compl]
            exact ⟨pt₀, rfl⟩
          exact hmem_inf ⟨p, hp_eq⟩
        · intro hyU
          change (s_F (Fin.succ j)).base pt₀ ∈ (U₀ : Set Y₀.left) at hyU
          dsimp [s_F] at hyU
          rw [hU₀_eq] at hyU
          rcases hyU with ⟨p, hp_good, hp_eq⟩
          have hp_eq' : p = (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.evalRingHom (e_S j).1))).base pt₀ :=
            j_aff.isOpenEmbedding.injective hp_eq
          have hnot_mem := hp_good (e_S j).1 (e_S j).2
          rw [hp_eq'] at hnot_mem
          apply hnot_mem
          change Polynomial.X - Polynomial.C (e_S j).1 ∈
            Ideal.comap (Polynomial.evalRingHom (e_S j).1) pt₀.asIdeal
          rw [hSpec_bot pt₀, ← RingHom.ker_eq_comap_bot, Polynomial.ker_evalRingHom]
          exact Ideal.mem_span_singleton_self _
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F) :=
      MvPolynomial.gradedAlgebra
    have hSep_Y₀ : AlgebraicGeometry.IsSeparated Y₀.hom := by
      dsimp [Y₀, weilProjectiveSpaceOver]
      exact AlgebraicGeometry.IsSeparated.instCompScheme _ _
    let p_snd : weilGeomScheme F Y₀ ⟶ S_k := CategoryTheory.Limits.pullback.snd Y₀.hom g_ext
    have hpb_base : CategoryTheory.IsPullback pr_Y p_snd Y₀.hom g_ext :=
      CategoryTheory.IsPullback.of_hasPullback Y₀.hom g_ext
    let _ : AlgebraicGeometry.IsSeparated p_snd :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_base hSep_Y₀
    let s_bar : Fin m → (S_k ⟶ weilGeomScheme F Y₀) := fun i =>
      CategoryTheory.Limits.pullback.lift (g_ext ≫ s_F i) (𝟙 S_k)
        (by rw [Category.assoc, hs_F_sec i, Category.comp_id, Category.id_comp])
    have hs_bar_fst : ∀ i : Fin m, s_bar i ≫ pr_Y = g_ext ≫ s_F i := fun i =>
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hs_bar_snd : ∀ i : Fin m, s_bar i ≫ p_snd = 𝟙 S_k := fun i =>
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hs_bar_cl : ∀ i : Fin m, AlgebraicGeometry.IsClosedImmersion (s_bar i) := by
      intro i
      let _ : AlgebraicGeometry.IsClosedImmersion (s_bar i ≫ p_snd) := by
        rw [hs_bar_snd i]
        infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp (s_bar i) p_snd
    have hpb_sec : ∀ i : Fin m, CategoryTheory.IsPullback (s_bar i) g_ext pr_Y (s_F i) := by
      intro i
      have hrect : CategoryTheory.IsPullback
          (s_bar i ≫ p_snd) g_ext g_ext (s_F i ≫ (Y₀.hom : Y₀.left ⟶ S_F)) := by
        rw [hs_bar_snd i, hs_F_sec i]
        exact CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.comp_id]⟩
      exact CategoryTheory.IsPullback.of_right hrect (hs_bar_fst i) hpb_base.flip
    refine ⟨m, s_bar, hs_bar_cl, ?_⟩
    ext y_bar
    simp only [Set.mem_compl_iff, SetLike.mem_coe, TopologicalSpace.Opens.map_coe, Set.mem_preimage,
      Set.mem_iUnion, Set.mem_range]
    have hmem_compl : pr_Y.base y_bar ∉ U₀ ↔
        ∃ i : Fin m, ∃ pt₀ : ↥S_F, (s_F i).base pt₀ = pr_Y.base y_bar := by
      have h1 := Set.ext_iff.mp hBaseCompl (pr_Y.base y_bar)
      simpa only [Set.mem_compl_iff, SetLike.mem_coe, Set.mem_iUnion, Set.mem_range] using h1
    rw [hmem_compl]
    constructor
    · rintro ⟨i, pt₀, hpt₀⟩
      let pt_k : ↥S_k := ⟨⊥, hBotPrime k⟩
      have hpt_eq : g_ext.base pt_k = pt₀ := by
        apply PrimeSpectrum.ext
        rw [hSpec_bot (g_ext.base pt_k), hSpec_bot pt₀]
      have hfib : pr_Y.base y_bar = (s_F i).base (g_ext.base pt_k) := by
        rw [hpt_eq, hpt₀]
      obtain ⟨w, hw_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y_bar (g_ext.base pt_k) hfib
      let iso_i := (hpb_sec i).isoPullback
      refine ⟨i, iso_i.inv.base w, ?_⟩
      have hiso_fst : iso_i.inv ≫ s_bar i = CategoryTheory.Limits.pullback.fst pr_Y (s_F i) := by
        rw [← CategoryTheory.IsPullback.isoPullback_hom_fst (hpb_sec i), ← Category.assoc,
          iso_i.inv_hom_id, Category.id_comp]
      calc (s_bar i).base (iso_i.inv.base w)
          = (iso_i.inv ≫ s_bar i).base w := rfl
        _ = (CategoryTheory.Limits.pullback.fst pr_Y (s_F i)).base w := by rw [hiso_fst]
        _ = y_bar := hw_fst
    · rintro ⟨i, z_k, rfl⟩
      refine ⟨i, g_ext.base z_k, ?_⟩
      calc (s_F i).base (g_ext.base z_k)
          = (g_ext ≫ s_F i).base z_k := rfl
        _ = (s_bar i ≫ pr_Y).base z_k := by rw [hs_bar_fst i]
        _ = pr_Y.base ((s_bar i).base z_k) := rfl

  
  have hPart2 :
      ∀ (X Y : AlgebraicGeometry.Scheme.{u})
        (f : Quiver.Hom X Y)
        (U : Y.Opens)
        (𝒢₁ 𝒢₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (ψ : Quiver.Hom 𝒢₁ 𝒢₂),
        (∀ W : Y.Etale,
          Set.range ((AlgebraicGeometry.Scheme.Etale.forget Y).obj W).hom.base ⊆ (U : Set Y) →
          Function.Bijective (ψ.hom.app (Opposite.op W))) →
        ∀ (hCont_f : (weilEtaleSitePullback f).IsContinuous
            Y.smallEtaleTopology X.smallEtaleTopology)
          (hAdj_f : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback f) AddCommGrpCat.{u} _
            Y.smallEtaleTopology X.smallEtaleTopology hCont_f).IsRightAdjoint)
          (W_X : X.Etale),
          Set.range ((AlgebraicGeometry.Scheme.Etale.forget X).obj W_X).hom.base ⊆
            ((TopologicalSpace.Opens.map f.base).obj U : Set X) →
          Subsingleton ↑((((@CategoryTheory.Functor.sheafPullback _ _ _ _
              (weilEtaleSitePullback f) AddCommGrpCat.{u} _
              Y.smallEtaleTopology X.smallEtaleTopology
              hCont_f hAdj_f).obj (CategoryTheory.Limits.cokernel ψ)).obj).obj (Opposite.op W_X)) := by
    clear S_aff j_aff hj_open hj_hom s_inf hsinf_sec hsinf_compl U₀ hU₀_eq
      ℱ₁ ℱ₂ φ hφ_U₀ Y₀ pr_Y hCont_pr hAdj_pr hPart1
    intro X Y f U ℱ₁ ℱ₂ φ hφ_U hCont_f hAdj_f W_X hWX
    let _ := hCont_f
    let _ := hAdj_f
    let FgtY := AlgebraicGeometry.Scheme.Etale.forget Y
    let FgtX := AlgebraicGeometry.Scheme.Etale.forget X
    let 𝒬₀ := CategoryTheory.Limits.cokernel φ
    let π_𝒬 : ℱ₂ ⟶ 𝒬₀ := CategoryTheory.Limits.cokernel.π φ
    have hOpensRange : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (O : Z.Opens),
        Set.range O.ι.base = (O : Set Z) := by
      intro Z O
      change (O.ι.opensRange : Set Z) = (O : Set Z)
      rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    have hSheafEqZero : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
        (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        {E : Z.Etale} (S : CategoryTheory.Sieve E),
        S ∈ Z.smallEtaleTopology E →
        ∀ (s : ↑(𝒢.obj.obj (Opposite.op E))),
          (∀ ⦃E' : Z.Etale⦄ (u : E' ⟶ E), S.arrows u → (𝒢.obj.map u.op).hom s = 0) →
          s = 0 := by
      intro Z 𝒢 E S hS s hs0
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      have hSh := 𝒢.property Aℤ
      let α_s : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E) :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • s
            map_zero' := zero_zsmul s
            map_add' := fun m n => add_zsmul s m.down n.down }
      let fam0 : CategoryTheory.Presieve.FamilyOfElements
          (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) S.arrows :=
        fun E' _ _ => (0 : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E'))
      have hcompat0 : fam0.Compatible := by
        intro Y₁ Y₂ Z' g₁ g₂ f₁ f₂ _ _ _
        change (0 : Aℤ ⟶ _) ≫ 𝒢.obj.map g₁.op = (0 : Aℤ ⟶ _) ≫ 𝒢.obj.map g₂.op
        rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
      have hamalg_s : fam0.IsAmalgamation α_s := by
        intro E' u hu
        change α_s ≫ 𝒢.obj.map u.op = 0
        ext ⟨n⟩
        change (𝒢.obj.map u.op).hom (n • s) = 0
        rw [map_zsmul, hs0 u hu, zsmul_zero]
      have hamalg_0 : fam0.IsAmalgamation (0 : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E)) := by
        intro E' u _
        change (0 : Aℤ ⟶ _) ≫ 𝒢.obj.map u.op = 0
        exact CategoryTheory.Limits.zero_comp
      have hα0 : α_s = 0 := (hSh S hS fam0 hcompat0).unique hamalg_s hamalg_0
      have h1 : α_s.hom (ULift.up 1) = (0 : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E)).hom (ULift.up 1) :=
        congrArg (fun m : Aℤ ⟶ 𝒢.obj.obj (Opposite.op E) => m.hom (ULift.up 1)) hα0
      change (1 : ℤ) • s = 0 at h1
      simpa only [one_zsmul] using h1
    have h𝒬₀_U : ∀ (W : Y.Etale),
        Set.range (FgtY.obj W).hom.base ⊆ (U : Set Y) →
        ∀ s : ↑(𝒬₀.obj.obj (Opposite.op W)), s = 0 := by
      intro W hW s
      have hls : CategoryTheory.Presheaf.IsLocallySurjective Y.smallEtaleTopology π_𝒬.hom :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (φ := π_𝒬)).mpr inferInstance
      let R := CategoryTheory.Presheaf.imageSieve π_𝒬.hom s
      have hR : R ∈ Y.smallEtaleTopology W :=
        CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem s
      refine hSheafEqZero 𝒬₀ R hR s (fun W' u hu => ?_)
      rcases hu with ⟨t, ht⟩
      have hW' : Set.range (FgtY.obj W').hom.base ⊆ (U : Set Y) := by
        rintro _ ⟨z, rfl⟩
        apply hW
        refine ⟨(FgtY.map u).left.base z, ?_⟩
        calc (FgtY.obj W).hom.base ((FgtY.map u).left.base z)
            = ((FgtY.map u).left ≫ (FgtY.obj W).hom).base z := rfl
          _ = (FgtY.obj W').hom.base z := by rw [(FgtY.map u).w]
      obtain ⟨r, rfl⟩ := (hφ_U W' hW').2 t
      have hcond : (φ ≫ π_𝒬).hom.app (Opposite.op W') = 0 := by
        rw [CategoryTheory.Limits.cokernel.condition φ]
        rfl
      calc (𝒬₀.obj.map u.op).hom s
          = (π_𝒬.hom.app (Opposite.op W')).hom ((φ.hom.app (Opposite.op W')).hom r) := ht.symm
        _ = ((φ ≫ π_𝒬).hom.app (Opposite.op W')).hom r := rfl
        _ = 0 := by rw [hcond]; rfl
    let U_X : X.Opens := (TopologicalSpace.Opens.map f.base).obj U
    let B_f : Y.Etale ⥤ X.Etale := weilEtaleSitePullback f
    let R_f := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_f AddCommGrpCat.{u} _ Y.smallEtaleTopology X.smallEtaleTopology hCont_f
    let L_f := @CategoryTheory.Functor.sheafPullback _ _ _ _
      B_f AddCommGrpCat.{u} _ Y.smallEtaleTopology X.smallEtaleTopology hCont_f hAdj_f
    let adj_f := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      B_f AddCommGrpCat.{u} _ Y.smallEtaleTopology X.smallEtaleTopology hCont_f hAdj_f
    let 𝒬_X := L_f.obj 𝒬₀
    let resObj : X.Etale → X.Etale := fun E =>
      let h_E := (FgtX.obj E).hom
      have : AlgebraicGeometry.Etale h_E := E.prop
      AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.Limits.pullback.fst h_E U_X.ι ≫ h_E)
    let ρ : ∀ E : X.Etale, resObj E ⟶ E := fun E =>
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.fst (FgtX.obj E).hom U_X.ι) rfl trivial
    let resMap : ∀ {E₁ E₂ : X.Etale}, (E₁ ⟶ E₂) → (resObj E₁ ⟶ resObj E₂) := fun {E₁ E₂} v =>
      let h₁ := (FgtX.obj E₁).hom
      let h₂ := (FgtX.obj E₂).hom
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h₁ U_X.ι ≫ (FgtX.map v).left)
          (CategoryTheory.Limits.pullback.snd h₁ U_X.ι)
          ((Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.fst h₁ U_X.ι ≫ ·) (FgtX.map v).w).trans
              CategoryTheory.Limits.pullback.condition)))
        ((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
          (congrArg (CategoryTheory.Limits.pullback.fst h₁ U_X.ι ≫ ·) (FgtX.map v).w))
        trivial
    have hρ_nat : ∀ {E₁ E₂ : X.Etale} (v : E₁ ⟶ E₂), resMap v ≫ ρ E₂ = ρ E₁ ≫ v := by
      intro E₁ E₂ v
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    let A_out : ∀ E : X.Etale, AddSubgroup ↑(𝒬_X.obj.obj (Opposite.op E)) :=
      fun E => AddMonoidHom.ker (𝒬_X.obj.map (ρ E).op).hom
    have hA_map : ∀ {E₁ E₂ : X.Etale} (v : E₁ ⟶ E₂) {s : ↑(𝒬_X.obj.obj (Opposite.op E₂))},
        s ∈ A_out E₂ → (𝒬_X.obj.map v.op).hom s ∈ A_out E₁ := by
      intro E₁ E₂ v s hs
      change (𝒬_X.obj.map (ρ E₁).op).hom ((𝒬_X.obj.map v.op).hom s) = 0
      have hcomp : 𝒬_X.obj.map v.op ≫ 𝒬_X.obj.map (ρ E₁).op =
          𝒬_X.obj.map (ρ E₂).op ≫ 𝒬_X.obj.map (resMap v).op := by
        rw [← 𝒬_X.obj.map_comp, ← 𝒬_X.obj.map_comp, ← op_comp, ← op_comp, hρ_nat v]
      have hval := congrArg (fun m => m.hom s) hcomp
      dsimp at hval
      rw [hval]
      have hs0 : (𝒬_X.obj.map (ρ E₂).op).hom s = 0 := hs
      rw [hs0, map_zero]
    let P_out : X.Etaleᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun opE => AddCommGrpCat.of ↥(A_out opE.unop)
        map := fun {opE₂ opE₁} v => AddCommGrpCat.ofHom
          { toFun := fun x => ⟨(𝒬_X.obj.map v).hom x.1, hA_map v.unop x.2⟩
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun x y => Subtype.ext (map_add _ x.1 y.1) }
        map_id := fun opE => AddCommGrpCat.ext fun x => Subtype.ext <|
          congrArg (fun m => m.hom x.1) (𝒬_X.obj.map_id opE)
        map_comp := fun {opE₃ opE₂ opE₁} u v => AddCommGrpCat.ext fun x => Subtype.ext <|
          congrArg (fun m => m.hom x.1) (𝒬_X.obj.map_comp u v) }
    let ι_pre : P_out ⟶ 𝒬_X.obj :=
      { app := fun opE => AddCommGrpCat.ofHom (A_out opE.unop).subtype
        naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology P_out := by
      intro A E S hS fam hcompat
      let fam_Q : CategoryTheory.Presieve.FamilyOfElements
          (𝒬_X.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op A)) S.arrows :=
        fun E' u hu => fam u hu ≫ ι_pre.app (Opposite.op E')
      have hcompat_Q : fam_Q.Compatible := by
        intro Y₁ Y₂ Z' g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        have hc := hcompat g₁ g₂ h₁ h₂ hcomm
        change (fam f₁ h₁ ≫ P_out.map g₁.op) = (fam f₂ h₂ ≫ P_out.map g₂.op) at hc
        change (fam f₁ h₁ ≫ ι_pre.app (Opposite.op Y₁)) ≫ 𝒬_X.obj.map g₁.op =
          (fam f₂ h₂ ≫ ι_pre.app (Opposite.op Y₂)) ≫ 𝒬_X.obj.map g₂.op
        rw [Category.assoc, Category.assoc, ← ι_pre.naturality g₁.op, ← ι_pre.naturality g₂.op,
          ← Category.assoc, ← Category.assoc, hc]
      obtain ⟨g, hg_amalg, hg_uniq⟩ := 𝒬_X.property A S hS fam_Q hcompat_Q
      have hg_mem : ∀ a : ↑A, g.hom a ∈ A_out E := by
        intro a
        change (𝒬_X.obj.map (ρ E).op).hom (g.hom a) = 0
        let S' := CategoryTheory.Sieve.pullback (ρ E) S
        have hS' : S' ∈ X.smallEtaleTopology (resObj E) :=
          X.smallEtaleTopology.pullback_stable (ρ E) hS
        refine hSheafEqZero 𝒬_X S' hS' ((𝒬_X.obj.map (ρ E).op).hom (g.hom a)) (fun Z w hw => ?_)
        have hwS : S.arrows (w ≫ ρ E) := hw
        have hZw : (𝒬_X.obj.map (w ≫ ρ E).op).hom (g.hom a) = ((fam (w ≫ ρ E) hwS).hom a).1 :=
          congrArg (fun m => m.hom a) (hg_amalg (w ≫ ρ E) hwS)
        have hZ_ker : (𝒬_X.obj.map (ρ Z).op).hom ((fam (w ≫ ρ E) hwS).hom a).1 = 0 :=
          ((fam (w ≫ ρ E) hwS).hom a).2
        let σ_Z : Z ⟶ resObj Z :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift (𝟙 (FgtX.obj Z).left)
              ((FgtX.map w).left ≫ CategoryTheory.Limits.pullback.snd (FgtX.obj E).hom U_X.ι)
              ((Category.id_comp _).trans
                (((FgtX.map w).w).symm.trans
                  ((congrArg ((FgtX.map w).left ≫ ·)
                    CategoryTheory.Limits.pullback.condition).trans
                    (Category.assoc _ _ _).symm))))
            ((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans (Category.id_comp _))
            trivial
        have hσ_id : σ_Z ≫ ρ Z = 𝟙 Z := by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _
        calc (𝒬_X.obj.map w.op).hom ((𝒬_X.obj.map (ρ E).op).hom (g.hom a))
            = (𝒬_X.obj.map (w ≫ ρ E).op).hom (g.hom a) := by
              rw [op_comp, 𝒬_X.obj.map_comp]; rfl
          _ = ((fam (w ≫ ρ E) hwS).hom a).1 := hZw
          _ = (𝒬_X.obj.map (𝟙 Z).op).hom ((fam (w ≫ ρ E) hwS).hom a).1 := by
              rw [op_id, 𝒬_X.obj.map_id]; rfl
          _ = (𝒬_X.obj.map (σ_Z ≫ ρ Z).op).hom ((fam (w ≫ ρ E) hwS).hom a).1 := by
              rw [hσ_id]
          _ = (𝒬_X.obj.map σ_Z.op).hom
                ((𝒬_X.obj.map (ρ Z).op).hom ((fam (w ≫ ρ E) hwS).hom a).1) := by
              rw [op_comp, 𝒬_X.obj.map_comp]; rfl
          _ = (𝒬_X.obj.map σ_Z.op).hom 0 := by rw [hZ_ker]
          _ = 0 := map_zero _
      let g_out : A ⟶ P_out.obj (Opposite.op E) :=
        AddCommGrpCat.ofHom
          { toFun := fun a => ⟨g.hom a, hg_mem a⟩
            map_zero' := Subtype.ext (map_zero g.hom)
            map_add' := fun a b => Subtype.ext (map_add g.hom a b) }
      refine ⟨g_out, fun E' u hu => ?_, fun t ht => ?_⟩
      · apply AddCommGrpCat.ext
        intro a
        exact Subtype.ext (congrArg (fun m => m.hom a) (hg_amalg u hu))
      · have ht_Q : fam_Q.IsAmalgamation (t ≫ ι_pre.app (Opposite.op E)) := by
          intro E' u hu
          change (t ≫ ι_pre.app (Opposite.op E)) ≫ 𝒬_X.obj.map u.op =
            fam u hu ≫ ι_pre.app (Opposite.op E')
          rw [Category.assoc, ← ι_pre.naturality u.op, ← Category.assoc]
          exact congrArg (· ≫ ι_pre.app (Opposite.op E')) (ht u hu)
        have heq_Q := hg_uniq (t ≫ ι_pre.app (Opposite.op E)) ht_Q
        apply AddCommGrpCat.ext
        intro a
        exact Subtype.ext (congrArg (fun m => m.hom a) heq_Q)
    let 𝒬_out : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_out, hP_sheaf⟩
    let ι_out : 𝒬_out ⟶ 𝒬_X := ⟨ι_pre⟩
    let η₀ : 𝒬₀ ⟶ R_f.obj 𝒬_X := adj_f.unit.app 𝒬₀
    have hη₀_mem : ∀ (W : Y.Etale) (s₀ : ↑(𝒬₀.obj.obj (Opposite.op W))),
        (η₀.hom.app (Opposite.op W)).hom s₀ ∈ A_out (B_f.obj W) := by
      intro W s₀
      let h_W := (FgtY.obj W).hom
      have : AlgebraicGeometry.Etale h_W := W.prop
      let W_U : Y.Etale :=
        AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.Limits.pullback.fst h_W U.ι ≫ h_W)
      let ρ_W : W_U ⟶ W := CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.fst h_W U.ι) rfl trivial
      have hWU_range : Set.range (FgtY.obj W_U).hom.base ⊆ (U : Set Y) := by
        rw [← hOpensRange U]
        rintro _ ⟨z, rfl⟩
        have hcomm : CategoryTheory.Limits.pullback.fst h_W U.ι ≫ h_W =
            CategoryTheory.Limits.pullback.snd h_W U.ι ≫ U.ι :=
          CategoryTheory.Limits.pullback.condition
        change (CategoryTheory.Limits.pullback.fst h_W U.ι ≫ h_W).base z ∈ Set.range U.ι.base
        rw [hcomm]
        exact ⟨(CategoryTheory.Limits.pullback.snd h_W U.ι).base z, rfl⟩
      have hρW_zero : (𝒬₀.obj.map ρ_W.op).hom s₀ = 0 :=
        h𝒬₀_U W_U hWU_range _
      let E := B_f.obj W
      let P := (FgtX.obj (resObj E)).left
      let q₁ : P ⟶ (FgtX.obj E).left := CategoryTheory.Limits.pullback.fst (FgtX.obj E).hom U_X.ι
      let q₂ : P ⟶ U_X.toScheme := CategoryTheory.Limits.pullback.snd (FgtX.obj E).hom U_X.ι
      have hq_comm : q₁ ≫ (FgtX.obj E).hom = q₂ ≫ U_X.ι :=
        CategoryTheory.Limits.pullback.condition
      let p₁ : (FgtX.obj E).left ⟶ (FgtY.obj W).left :=
        CategoryTheory.Limits.pullback.fst h_W f
      have hp_comm : p₁ ≫ h_W = (FgtX.obj E).hom ≫ f :=
        CategoryTheory.Limits.pullback.condition
      have hP_to_Y : Set.range (q₁ ≫ p₁ ≫ h_W).base ⊆ Set.range U.ι.base := by
        rw [hOpensRange U]
        rintro _ ⟨z, rfl⟩
        have h1 : q₁ ≫ p₁ ≫ h_W = q₂ ≫ U_X.ι ≫ f := by
          rw [hp_comm, ← Category.assoc, hq_comm, Category.assoc]
        change (q₁ ≫ p₁ ≫ h_W).base z ∈ (U : Set Y)
        rw [h1]
        have hz_mem : U_X.ι.base (q₂.base z) ∈ (U_X : Set X) := by
          rw [← hOpensRange U_X]
          exact ⟨q₂.base z, rfl⟩
        exact hz_mem
      let u_Y : P ⟶ U.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U.ι (q₁ ≫ p₁ ≫ h_W) hP_to_Y
      have hu_Y : u_Y ≫ U.ι = q₁ ≫ p₁ ≫ h_W :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι (q₁ ≫ p₁ ≫ h_W) hP_to_Y
      let m_Y : P ⟶ (FgtY.obj W_U).left :=
        CategoryTheory.Limits.pullback.lift (q₁ ≫ p₁) u_Y (by rw [Category.assoc, hu_Y])
      let τ_W : resObj E ⟶ B_f.obj W_U :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift m_Y (q₁ ≫ (FgtX.obj E).hom)
            ((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
              ((Category.assoc _ _ _).trans
                ((congrArg (q₁ ≫ ·) hp_comm).trans (Category.assoc _ _ _).symm))))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          trivial
      have hτ_comm : τ_W ≫ B_f.map ρ_W = ρ E := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.lift m_Y (q₁ ≫ (FgtX.obj E).hom) _ ≫ ·)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
        · exact (Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.lift m_Y (q₁ ≫ (FgtX.obj E).hom) _ ≫ ·)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              ((CategoryTheory.Limits.pullback.lift_snd_assoc _ _ _ _).trans
                (Category.comp_id _)))
      have hnat_η : ((η₀.hom.app (Opposite.op W_U)).hom ((𝒬₀.obj.map ρ_W.op).hom s₀)) =
          ((R_f.obj 𝒬_X).obj.map ρ_W.op).hom ((η₀.hom.app (Opposite.op W)).hom s₀) :=
        congrArg (fun m => m.hom s₀) (η₀.hom.naturality ρ_W.op)
      have hRHS_eq : ((R_f.obj 𝒬_X).obj.map ρ_W.op).hom ((η₀.hom.app (Opposite.op W)).hom s₀) = 0 := by
        rw [← hnat_η, hρW_zero, map_zero]
      change (𝒬_X.obj.map (ρ E).op).hom ((η₀.hom.app (Opposite.op W)).hom s₀) = 0
      rw [← hτ_comm, op_comp, 𝒬_X.obj.map_comp]
      exact (congrArg (𝒬_X.obj.map τ_W.op).hom hRHS_eq).trans (map_zero _)
    let η_tilde : 𝒬₀ ⟶ R_f.obj 𝒬_out :=
      { hom :=
          { app := fun opW => AddCommGrpCat.ofHom
              { toFun := fun s₀ => ⟨(η₀.hom.app opW).hom s₀, hη₀_mem opW.unop s₀⟩
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun x y => Subtype.ext (map_add _ x y) }
            naturality := fun {opW₁ opW₂} u => AddCommGrpCat.ext fun s₀ => Subtype.ext <|
              congrArg (fun m => m.hom s₀) (η₀.hom.naturality u) } }
    have hη_fac : η_tilde ≫ R_f.map ι_out = η₀ := by
      apply CategoryTheory.Sheaf.hom_ext
      ext opW s₀
      rfl
    let r_ret : 𝒬_X ⟶ 𝒬_out := (adj_f.homEquiv 𝒬₀ 𝒬_out).symm η_tilde
    have hr_id : r_ret ≫ ι_out = 𝟙 𝒬_X := by
      apply (adj_f.homEquiv 𝒬₀ 𝒬_X).injective
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, hη_fac,
        CategoryTheory.Adjunction.homEquiv_unit, R_f.map_id]
      exact (Category.comp_id _).symm
    have hWX_lift_range : Set.range (FgtX.obj W_X).hom.base ⊆ Set.range U_X.ι.base := by
      rwa [hOpensRange U_X]
    let g_WX : (FgtX.obj W_X).left ⟶ U_X.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_X.ι (FgtX.obj W_X).hom hWX_lift_range
    have hg_WX : g_WX ≫ U_X.ι = (FgtX.obj W_X).hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_X.ι (FgtX.obj W_X).hom hWX_lift_range
    let σ_WX : W_X ⟶ resObj W_X :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.lift (𝟙 (FgtX.obj W_X).left) g_WX
          ((Category.id_comp _).trans hg_WX.symm))
        ((CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans (Category.id_comp _))
        trivial
    have hσWX_id : σ_WX ≫ ρ W_X = 𝟙 W_X := by
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    refine ⟨fun s₁ s₂ => ?_⟩
    have hzero : ∀ z : ↑(𝒬_X.obj.obj (Opposite.op W_X)), z = 0 := by
      intro z
      have hz_id : ((r_ret ≫ ι_out).hom.app (Opposite.op W_X)).hom z = z := by
        rw [hr_id]
        rfl
      have hz_mem : z ∈ A_out W_X := by
        rw [← hz_id]
        exact ((r_ret.hom.app (Opposite.op W_X)).hom z).2
      have hz_ker : (𝒬_X.obj.map (ρ W_X).op).hom z = 0 := hz_mem
      calc z = (𝒬_X.obj.map (𝟙 W_X).op).hom z := by
            rw [op_id, 𝒬_X.obj.map_id]; rfl
        _ = (𝒬_X.obj.map (σ_WX ≫ ρ W_X).op).hom z := by rw [hσWX_id]
        _ = (𝒬_X.obj.map σ_WX.op).hom ((𝒬_X.obj.map (ρ W_X).op).hom z) := by
            rw [op_comp, 𝒬_X.obj.map_comp]; rfl
        _ = (𝒬_X.obj.map σ_WX.op).hom 0 := by rw [hz_ker]
        _ = 0 := map_zero _
    exact (hzero s₁).trans (hzero s₂).symm

  
  have hPart3 :
      ∀ (k : Type u) [Field k] [IsAlgClosed k]
        (D : AlgebraicGeometry.Scheme.{u})
        (m : ℕ)
        (s : Fin m → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) D),
        (∀ i : Fin m, AlgebraicGeometry.IsClosedImmersion (s i)) →
        ∀ (U : D.Opens),
          (U : Set D)ᶜ ⊆ ⋃ i : Fin m, Set.range (s i).base →
          ∀ (𝒢 : CategoryTheory.Sheaf D.smallEtaleTopology AddCommGrpCat.{u}),
            (∀ W : D.Etale,
              Set.range ((AlgebraicGeometry.Scheme.Etale.forget D).obj W).hom.base ⊆ (U : Set D) →
              Subsingleton ↑(𝒢.obj.obj (Opposite.op W))) →
            Subsingleton (𝒢.H 1) := by
    clear S_aff j_aff hj_open hj_hom s_inf hsinf_sec hsinf_compl U₀ hU₀_eq
      ℱ₁ ℱ₂ φ hφ_U₀ Y₀ pr_Y hCont_pr hAdj_pr hPart1 hPart2
    intro k _ _ D m s hs U hU_compl 𝒢 h𝒢_U
    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget D
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    have hBotPrime : (⊥ : Ideal k).IsPrime :=
      ⟨fun htop => one_ne_zero (α := k) ((Ideal.mem_bot (R := k)).mp (htop ▸ Submodule.mem_top)),
        fun {x y} hxy => by
          rw [Ideal.mem_bot] at hxy ⊢
          rw [Ideal.mem_bot]
          exact mul_eq_zero.mp hxy⟩
    let pt_k : ↥S_k := ⟨⊥, hBotPrime⟩
    have hSpec_bot : ∀ (pt : ↥S_k), pt.asIdeal = ⊥ := by
      intro pt
      by_contra hne
      obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (IsUnit.mk0 x hx0))
    have hSk_eq : ∀ (pt : ↥S_k), pt = pt_k := by
      intro pt
      apply PrimeSpectrum.ext
      exact hSpec_bot pt
    have hOpensRange : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (O : Z.Opens),
        Set.range O.ι.base = (O : Set Z) := by
      intro Z O
      change (O.ι.opensRange : Set Z) = (O : Set Z)
      rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    let hZmulHom : ∀ {G : AddCommGrpCat.{u}} (g : ↑G), Aℤ ⟶ G := fun g =>
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • g
          map_zero' := zero_zsmul g
          map_add' := fun a b => add_zsmul g a.down b.down }
    have hEqOfZmul : ∀ {G : AddCommGrpCat.{u}} {g₁ g₂ : ↑G},
        hZmulHom g₁ = hZmulHom g₂ → g₁ = g₂ := by
      intro G g₁ g₂ h
      have h1 : (hZmulHom g₁).hom (ULift.up 1) = (hZmulHom g₂).hom (ULift.up 1) :=
        congrArg (fun m => m.hom (ULift.up 1)) h
      change (1 : ℤ) • g₁ = (1 : ℤ) • g₂ at h1
      simpa only [one_zsmul] using h1
    have hPiExt : ∀ {Idx : Type u} {M : AddCommGrpCat.{u}}
        (a b : ↑(CategoryTheory.Limits.piObj (fun _ : Idx => M))),
        (∀ idx : Idx,
          (CategoryTheory.Limits.Pi.π (fun _ : Idx => M) idx).hom a =
            (CategoryTheory.Limits.Pi.π (fun _ : Idx => M) idx).hom b) →
        a = b := by
      intro Idx M a b hcoord
      apply hEqOfZmul
      apply CategoryTheory.Limits.Pi.hom_ext
      intro idx
      apply AddCommGrpCat.ext
      rintro ⟨n⟩
      change (CategoryTheory.Limits.Pi.π (fun _ : Idx => M) idx).hom (n • a) =
        (CategoryTheory.Limits.Pi.π (fun _ : Idx => M) idx).hom (n • b)
      rw [map_zsmul, map_zsmul, hcoord idx]
    have hSheafEqZero : ∀ (ℱ : CategoryTheory.Sheaf D.smallEtaleTopology AddCommGrpCat.{u})
        {E : D.Etale} (R : CategoryTheory.Sieve E),
        R ∈ D.smallEtaleTopology E →
        ∀ (g : ↑(ℱ.obj.obj (Opposite.op E))),
          (∀ ⦃E' : D.Etale⦄ (u : E' ⟶ E), R.arrows u → (ℱ.obj.map u.op).hom g = 0) →
