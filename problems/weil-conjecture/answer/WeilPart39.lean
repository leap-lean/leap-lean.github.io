      have hu_val : (↑u_unit : R_s) = ι_j₀ b * ↑hs_unit.unit⁻¹ := rfl
      calc
        ι_j₀ s * φ_lift (ψ_Bk Polynomial.X) = 1 * (ι_j₀ b * t_s) := by rw [one_mul, hmap]
        _ = (ι_j₀ s * ↑hs_unit.unit⁻¹) * (ι_j₀ b * t_s) := by rw [hsinv]
