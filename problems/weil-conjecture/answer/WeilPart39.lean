    let σ_top_R'' : ↥L_top ≃ₐ[R''] ↥L_top :=
      { σ_top.toRingEquiv with commutes' := fun r => σ_top.commutes (φ_g₁ r) }
    let τ_R'' : C_top ≃ₐ[R''] C_top := AlgEquiv.mapIntegralClosure σ_top_R''
    let τ_top : C_top ≃ₐ[R₀] C_top :=
      { τ_R''.toRingEquiv with commutes' := fun r => τ_R''.commutes (algebraMap R₀ R'' r) }
    have hτ_top_symm : ∀ z : C_top, (τ_top.symm z).1 = σ_top.symm z.1 := by
      intro z
      apply σ_top.injective
      have h1 : σ_top (τ_top.symm z).1 = (τ_R'' (τ_top.symm z)).1 := rfl
      rw [h1]
      have h2 : τ_R'' (τ_top.symm z) = z := τ_R''.apply_symm_apply z
      rw [h2, σ_top.apply_symm_apply]
    refine ⟨C_top, inferInstance, inferInstance, alg_R₀_Ctop, hEt_Ctop,
      j_C, j_gal, τ_top, σ₀, ?_, ?_, hImp_E₀⟩
    · intro c
      apply Subtype.ext
      rw [hτ_top_symm]
      change σ_top.symm (ι₁ (φ_C c)) = ι₁ (φ_C c)
      rw [hσ_top₁_symm]
      have hc : σ'.symm (φ_C c) = φ_C c :=
        σ'.injective ((σ'.apply_symm_apply _).trans (hFix_C c).symm)
