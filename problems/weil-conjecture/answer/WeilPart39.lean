        intro c
        exact h_top (Algebra.mem_top (x := c))
      · obtain ⟨k₁, hk₁⟩ := hg₀_dvd
        let v_inv : R'' := algebraMap R₀ R'' k₁ * IsLocalization.Away.invSelf g₁
        have hv_mul : algebraMap R₀ R'' g₀ * v_inv = 1 := by
          dsimp [v_inv]
          rw [← mul_assoc, ← map_mul, ← hk₁, IsLocalization.Away.mul_invSelf g₁]
        have hUnit_g₀ : IsUnit (algebraMap R₀ R'' g₀) :=
          ⟨⟨algebraMap R₀ R'' g₀, v_inv, hv_mul,
            mul_comm (algebraMap R₀ R'' g₀) v_inv ▸ hv_mul⟩, rfl⟩
        let ι_loc : R' →+* R'' := IsLocalization.Away.lift g₀ hUnit_g₀
        have hφ_comp : φ_g₁.comp ι_loc = φ_g₀ := by
          apply IsLocalization.ringHom_ext (Submonoid.powers g₀)
          apply RingHom.ext
          intro r
          simp only [RingHom.comp_apply]
          dsimp [ι_loc]
          rw [IsLocalization.Away.lift_eq (S := R') g₀ hUnit_g₀ r]
          have h1 := RingHom.congr_fun hφ_g₁ r
          have h0 := RingHom.congr_fun hφ_g₀ r
          exact h1.trans h0.symm
        have h_alg_comp :
            ι₀.toRingHom.comp (algebraMap R' ↥L₀) = (algebraMap R'' ↥L_top).comp ι_loc := by
          apply RingHom.ext
          intro r
          change ι₀ (algebraMap K ↥L₀ (φ_g₀ r)) = algebraMap K ↥L_top (φ_g₁ (ι_loc r))
          rw [ι₀.commutes (φ_g₀ r), ← hφ_comp, RingHom.comp_apply]
        intro b
        obtain ⟨P, hP_mon, hP_eval⟩ := b.2
        refine ⟨P.map ι_loc, hP_mon.map ι_loc, ?_⟩
        rw [Polynomial.eval₂_map, ← h_alg_comp]
        change Polynomial.eval₂ (ι₀.toRingHom.comp (algebraMap R' ↥L₀)) (ι₀.toRingHom b.1) P = 0
        rw [← Polynomial.hom_eval₂, hP_eval, map_zero]
    obtain ⟨d_C, hd_C_ne, hd_mem⟩ := hClear
    obtain ⟨δ_top, hδ_ne, hδ_et⟩ := hSpread L_top
    let g₁ : R₀ := g₀ * δ_top * d_C
    have hg₁_ne : g₁ ≠ 0 := mul_ne_zero (mul_ne_zero hg₀_ne hδ_ne) hd_C_ne
    have h_dvd_δ : δ_top ∣ g₁ := ⟨g₀ * d_C, by dsimp [g₁]; ring⟩
    have h_dvd_g₀ : g₀ ∣ g₁ := ⟨δ_top * d_C, by dsimp [g₁]; ring⟩
    have h_dvd_d : d_C ∣ g₁ := ⟨g₀ * δ_top, by dsimp [g₁]; ring⟩
    have hg₁_K_ne : algebraMap R₀ K g₁ ≠ 0 := fun h =>
      hg₁_ne (IsFractionRing.injective R₀ K (h.trans (map_zero _).symm))
    let R'' := Localization.Away g₁
    have hUnit_g₁_K : IsUnit (algebraMap R₀ K g₁) := IsUnit.mk0 _ hg₁_K_ne
    let φ_g₁ : R'' →+* K := IsLocalization.Away.lift g₁ hUnit_g₁_K
    have hφ_g₁ : φ_g₁.comp (algebraMap R₀ R'') = algebraMap R₀ K := by
      apply RingHom.ext
      intro r
      exact IsLocalization.Away.lift_eq (S := R'') g₁ hUnit_g₁_K r
    letI : Algebra R'' ↥L_top := ((algebraMap K ↥L_top).comp φ_g₁).toAlgebra
    let C_top := ↥(integralClosure R'' ↥L_top)
    let alg_R₀_Ctop : Algebra R₀ C_top :=
      ((algebraMap R'' C_top).comp (algebraMap R₀ R'')).toAlgebra
    letI : Algebra R₀ C_top := alg_R₀_Ctop
    have : IsScalarTower R₀ R'' C_top := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale R'' C_top := (hδ_et g₁ hg₁_ne h_dvd_δ φ_g₁ hφ_g₁).2
    have : Algebra.Etale R₀ R'' := Algebra.Etale.of_isLocalizationAway g₁
    have hEt_Ctop : Algebra.Etale R₀ C_top := Algebra.Etale.comp R₀ R'' C_top
    obtain ⟨h_mem_C, h_mem_gal⟩ := hd_mem g₁ hg₁_ne h_dvd_g₀ h_dvd_d φ_g₁ hφ_g₁
    let f_jC : C →+* ↥L_top := ι₁.toRingHom.comp φ_C.toRingHom
    let j_C : C →ₐ[R₀] C_top :=
      { toFun := fun c => ⟨f_jC c, h_mem_C c⟩
        map_one' := Subtype.ext (map_one f_jC)
        map_mul' := fun x y => Subtype.ext (map_mul f_jC x y)
        map_zero' := Subtype.ext (map_zero f_jC)
        map_add' := fun x y => Subtype.ext (map_add f_jC x y)
        commutes' := fun r => Subtype.ext (by
