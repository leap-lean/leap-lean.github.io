      have : AlgebraicGeometry.IsClosedImmersion iZ := hCl_iZ
      have : AlgebraicGeometry.IsIntegral Z := hInt_Z
      let U_Z : Z.Opens := (TopologicalSpace.Opens.map (iZ ≫ g).base).obj U₀
