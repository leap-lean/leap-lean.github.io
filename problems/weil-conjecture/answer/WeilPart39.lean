            CategoryTheory.MorphismProperty.Over.homMk
              (CategoryTheory.Limits.pullback.snd h₁ h₂)
              CategoryTheory.Limits.pullback.condition.symm trivial
          refine ⟨Z,
            CategoryTheory.Functor.Elements.homMk (F := fib) (x := Z) (y := X) π₁
              (Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)),
            CategoryTheory.Functor.Elements.homMk (F := fib) (x := Z) (y := Y) π₂
              (Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)),
            trivial⟩
        cone_maps := fun {X Y} f g => by
          let E₁ := X.obj
          let E₂ := Y.obj
          let h₁ : (Fgt.obj E₁).left ⟶ W := (Fgt.obj E₁).hom
          let h₂ : (Fgt.obj E₂).left ⟶ W := (Fgt.obj E₂).hom
          let _ : AlgebraicGeometry.Etale h₁ := E₁.prop
          let _ : AlgebraicGeometry.Etale h₂ := E₂.prop
          let u : (Fgt.obj E₁).left ⟶ (Fgt.obj E₂).left := (Fgt.map f.hom).left
          let v : (Fgt.obj E₁).left ⟶ (Fgt.obj E₂).left := (Fgt.map g.hom).left
          have hu_w : u ≫ h₂ = h₁ := (Fgt.map f.hom).w
          have hv_w : v ≫ h₂ = h₁ := (Fgt.map g.hom).w
          let pair_uv : (Fgt.obj E₁).left ⟶ CategoryTheory.Limits.pullback h₂ h₂ :=
            CategoryTheory.Limits.pullback.lift u v (hu_w.trans hv_w.symm)
          let δ_h₂ : (Fgt.obj E₂).left ⟶ CategoryTheory.Limits.pullback h₂ h₂ :=
            CategoryTheory.Limits.pullback.diagonal h₂
          have _ : AlgebraicGeometry.IsOpenImmersion δ_h₂ :=
            AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal h₂
          let w_eq := CategoryTheory.Limits.pullback.fst pair_uv δ_h₂
          have _ : AlgebraicGeometry.IsOpenImmersion w_eq := inferInstance
          have _ : AlgebraicGeometry.Etale w_eq := inferInstance
          have hEt_eq : AlgebraicGeometry.Etale (w_eq ≫ h₁) :=
            CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
              inferInstance inferInstance
          let E_eq : W.Etale := @AlgebraicGeometry.Scheme.Etale.mk W _ (w_eq ≫ h₁) hEt_eq
          have hf_val : X.val.1 ≫ u = Y.val.1 := congrArg Subtype.val f.2
          have hg_val : X.val.1 ≫ v = Y.val.1 := congrArg Subtype.val g.2
          have hcomm_eq : X.val.1 ≫ pair_uv = Y.val.1 ≫ δ_h₂ := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hf_val,
                Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id]
            · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hg_val,
                Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id]
          let lift_eq : S_Ω ⟶ CategoryTheory.Limits.pullback pair_uv δ_h₂ :=
            CategoryTheory.Limits.pullback.lift X.val.1 Y.val.1 hcomm_eq
          let e_eq : fib.obj E_eq :=
            ⟨lift_eq, by
              change lift_eq ≫ (w_eq ≫ h₁) = w
