              · rw [Category.assoc, hp_fst, Category.assoc, hδ_fst, Category.comp_id, hf_eq]
              · rw [Category.assoc, hp_snd, Category.assoc, hδ_snd, Category.comp_id, hg_eq]
            let e_eq : fib.obj E_eq :=
              ⟨CategoryTheory.Limits.pullback.lift X.val.1 Y.val.1 hpair_eq,
                (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans X.val.2⟩
            let m_eq : E_eq ⟶ X.obj :=
              CategoryTheory.MorphismProperty.Over.homMk w_eq rfl trivial
            have hw_uv : w_eq ≫ u = w_eq ≫ v := by
              have hcond : w_eq ≫ pair_uv = CategoryTheory.Limits.pullback.snd pair_uv δ_h₂ ≫ δ_h₂ :=
                CategoryTheory.Limits.pullback.condition
              have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst h₂ h₂) hcond
              have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd h₂ h₂) hcond
              change (w_eq ≫ pair_uv) ≫ _ = (CategoryTheory.Limits.pullback.snd pair_uv δ_h₂ ≫ δ_h₂) ≫ _ at h1 h2
              rw [Category.assoc, hp_fst, Category.assoc, hδ_fst, Category.comp_id] at h1
              rw [Category.assoc, hp_snd, Category.assoc, hδ_snd, Category.comp_id] at h2
              exact h1.trans h2.symm
            refine ⟨CategoryTheory.Functor.elementsMk fib E_eq e_eq,
              ⟨m_eq, Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)⟩, ?_⟩
            apply CategoryTheory.Functor.Elements.Hom.ext
            refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
            exact hw_uv }
      exact CategoryTheory.IsCofiltered.mk
    have hFibInit : ∀ σ : S_k ⟶ D, CategoryTheory.InitiallySmall.{u} (fibOf σ).Elements := by
      intro σ
      let fib := fibOf σ
      let _ := hFibCof σ
      let ι_aff : D.AffineEtale ⥤ D.Etale := AlgebraicGeometry.Scheme.AffineEtale.Spec D
      let eq_sm := CategoryTheory.equivSmallModel.{u} D.AffineEtale
      let Idx : Type u := Σ m : CategoryTheory.SmallModel.{u} D.AffineEtale,
        fib.obj (ι_aff.obj (eq_sm.inverse.obj m))
      let g_idx : Idx → fib.Elements := fun p =>
        CategoryTheory.Functor.elementsMk fib (ι_aff.obj (eq_sm.inverse.obj p.1)) p.2
      have hDomIdx : ∀ d : fib.Elements, ∃ p : Idx, Nonempty (g_idx p ⟶ d) := by
        intro d
        let E := d.obj
        let e := d.val
        let V_E : AlgebraicGeometry.Scheme.{u} := (Fgt.obj E).left
        let h_E : V_E ⟶ D := (Fgt.obj E).hom
        have : AlgebraicGeometry.Etale h_E := E.prop
        let e_hom : S_k ⟶ V_E := e.1
        obtain ⟨V, hV_aff, hxV, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : V_E.Opens))
            (x := e_hom.base pt_k) trivial
        let R_obj := V_E.presheaf.obj (Opposite.op V)
        let j_V : AlgebraicGeometry.Spec R_obj ⟶ V_E := hV_aff.isoSpec.inv ≫ V.ι
        have he_range : Set.range e_hom.base ⊆ Set.range j_V.base := by
          rintro _ ⟨pt, rfl⟩
          rw [hSk_eq pt]
          refine ⟨hV_aff.isoSpec.hom.base ⟨e_hom.base pt_k, hxV⟩, ?_⟩
          change (hV_aff.isoSpec.hom ≫ j_V).base ⟨e_hom.base pt_k, hxV⟩ = e_hom.base pt_k
          have hfrom : hV_aff.isoSpec.hom ≫ j_V = V.ι :=
            (Category.assoc hV_aff.isoSpec.hom hV_aff.isoSpec.inv V.ι).symm.trans
              ((congrArg (· ≫ V.ι) hV_aff.isoSpec.hom_inv_id).trans (Category.id_comp V.ι))
          rw [hfrom]
          rfl
        let e_V : S_k ⟶ AlgebraicGeometry.Spec R_obj :=
          AlgebraicGeometry.IsOpenImmersion.lift j_V e_hom he_range
        have he_V : e_V ≫ j_V = e_hom :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac j_V e_hom he_range
        let A₀ : D.AffineEtale :=
          AlgebraicGeometry.Scheme.AffineEtale.mk (j_V ≫ h_E)
        let m₀ : CategoryTheory.SmallModel.{u} D.AffineEtale := eq_sm.functor.obj A₀
        let iso_A : A₀ ≅ eq_sm.inverse.obj m₀ := eq_sm.unitIso.app A₀
        let u_AE : ι_aff.obj A₀ ⟶ E :=
          CategoryTheory.MorphismProperty.Over.homMk j_V rfl trivial
        let e_A₀ : fib.obj (ι_aff.obj A₀) :=
          ⟨e_V, (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ h_E) he_V).trans e.2)⟩
        let e_m₀ : fib.obj (ι_aff.obj (eq_sm.inverse.obj m₀)) :=
          (fib.map (ι_aff.map iso_A.hom)) e_A₀
        let mor_E : ι_aff.obj (eq_sm.inverse.obj m₀) ⟶ E :=
          ι_aff.map iso_A.inv ≫ u_AE
        refine ⟨⟨m₀, e_m₀⟩, ⟨⟨mor_E, ?_⟩⟩⟩
        change (fib.map (ι_aff.map iso_A.inv ≫ u_AE)) ((fib.map (ι_aff.map iso_A.hom)) e_A₀) = e
        have hcomp_id : (ι_aff.map iso_A.hom) ≫ (ι_aff.map iso_A.inv ≫ u_AE) = u_AE := by
          rw [← Category.assoc, ← ι_aff.map_comp, iso_A.hom_inv_id, ι_aff.map_id, Category.id_comp]
        have hmap_comp := congrArg (fun m => m e_A₀)
          (fib.map_comp (ι_aff.map iso_A.hom) (ι_aff.map iso_A.inv ≫ u_AE))
        dsimp at hmap_comp
        rw [← hmap_comp, hcomp_id]
        exact Subtype.ext he_V
      let _ : CategoryTheory.SmallCategory Idx :=
        { Hom := fun p₁ p₂ => g_idx p₁ ⟶ g_idx p₂
          id := fun p => 𝟙 (g_idx p)
          comp := fun f g => f ≫ g
          id_comp := fun f => Category.id_comp f
          comp_id := fun f => Category.comp_id f
          assoc := fun f g h => Category.assoc f g h }
      let F_init : Idx ⥤ fib.Elements :=
        { obj := g_idx
          map := fun f => f
          map_id := fun _ => rfl
          map_comp := fun _ _ => rfl }
      have hF_init : F_init.Initial := by
        refine ⟨fun d => ?_⟩
        obtain ⟨p₀, ⟨u₀⟩⟩ := hDomIdx d
        let _ : Nonempty (CategoryTheory.CostructuredArrow F_init d) :=
          ⟨CategoryTheory.CostructuredArrow.mk (Y := p₀) u₀⟩
        let _ : CategoryTheory.IsCofilteredOrEmpty (CategoryTheory.CostructuredArrow F_init d) :=
          { cone_objs := fun A₁ A₂ => by
              let j₀ := CategoryTheory.IsCofiltered.min (F_init.obj A₁.left) (F_init.obj A₂.left)
              let w₁ : j₀ ⟶ F_init.obj A₁.left := CategoryTheory.IsCofiltered.minToLeft _ _
              let w₂ : j₀ ⟶ F_init.obj A₂.left := CategoryTheory.IsCofiltered.minToRight _ _
              let j₁ := CategoryTheory.IsCofiltered.eq (w₁ ≫ A₁.hom) (w₂ ≫ A₂.hom)
              let eq_m : j₁ ⟶ j₀ := CategoryTheory.IsCofiltered.eqHom (w₁ ≫ A₁.hom) (w₂ ≫ A₂.hom)
              have heq_m : eq_m ≫ w₁ ≫ A₁.hom = eq_m ≫ w₂ ≫ A₂.hom := by
                simpa only [Category.assoc] using
                  CategoryTheory.IsCofiltered.eq_condition (w₁ ≫ A₁.hom) (w₂ ≫ A₂.hom)
              obtain ⟨p₁, ⟨q₁⟩⟩ := hDomIdx j₁
              let a₁ : p₁ ⟶ A₁.left := (q₁ ≫ eq_m ≫ w₁ : g_idx p₁ ⟶ g_idx A₁.left)
              let a₂ : p₁ ⟶ A₂.left := (q₁ ≫ eq_m ≫ w₂ : g_idx p₁ ⟶ g_idx A₂.left)
              let A₀ := CategoryTheory.CostructuredArrow.mk (Y := p₁)
                (F_init.map a₁ ≫ A₁.hom)
              refine ⟨A₀, CategoryTheory.CostructuredArrow.homMk a₁ rfl,
                CategoryTheory.CostructuredArrow.homMk a₂ ?_, trivial⟩
              change (q₁ ≫ eq_m ≫ w₂) ≫ A₂.hom = (q₁ ≫ eq_m ≫ w₁) ≫ A₁.hom
              simp only [Category.assoc, heq_m]
            cone_maps := fun {A₁ A₂} f g => by
              let j₁ := CategoryTheory.IsCofiltered.eq (F_init.map f.left) (F_init.map g.left)
              let eq_m : j₁ ⟶ F_init.obj A₁.left :=
                CategoryTheory.IsCofiltered.eqHom (F_init.map f.left) (F_init.map g.left)
              have heq_m : eq_m ≫ F_init.map f.left = eq_m ≫ F_init.map g.left :=
                CategoryTheory.IsCofiltered.eq_condition _ _
              obtain ⟨p₁, ⟨q₁⟩⟩ := hDomIdx j₁
              let h_s : p₁ ⟶ A₁.left := (q₁ ≫ eq_m : g_idx p₁ ⟶ g_idx A₁.left)
              let A₀ := CategoryTheory.CostructuredArrow.mk (Y := p₁)
                (F_init.map h_s ≫ A₁.hom)
              refine ⟨A₀, CategoryTheory.CostructuredArrow.homMk h_s rfl, ?_⟩
              ext
              change (q₁ ≫ eq_m) ≫ F_init.map f.left = (q₁ ≫ eq_m) ≫ F_init.map g.left
              rw [Category.assoc, Category.assoc, heq_m] }
        let _ : CategoryTheory.IsCofiltered (CategoryTheory.CostructuredArrow F_init d) :=
          CategoryTheory.IsCofiltered.mk
        exact CategoryTheory.IsCofiltered.isConnected (CategoryTheory.CostructuredArrow F_init d)
      exact ⟨⟨Idx, inferInstance, F_init, hF_init⟩⟩
    have hFibJoint : ∀ (σ : S_k ⟶ D) {E : D.Etale},
        ∀ R ∈ D.smallEtaleTopology E, ∀ x : (fibOf σ).obj E,
          ∃ (Y : D.Etale) (u : Y ⟶ E) (_ : R.arrows u) (y : (fibOf σ).obj Y),
            ((fibOf σ).map u) y = x := by
      intro σ E R hR e
      have hR_cov : ∀ x : ↥(Fgt.obj E).left,
          ∃ (Y : D.Etale) (u : Y ⟶ E) (y : ↥(Fgt.obj Y).left),
            R.arrows u ∧ AlgebraicGeometry.Etale (Fgt.map u).left ∧
            (Fgt.map u).left.base y = x := by
        have hR1 : R ∈ Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) D E := hR
        rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology D
          (le_rfl : (@AlgebraicGeometry.Etale) ≤ (@AlgebraicGeometry.Etale))] at hR1
        exact (Scheme.mem_toGrothendieck_smallPretopology E R).mp hR1
      obtain ⟨Y, u, y₀, huR, hEt_u, hy₀⟩ := hR_cov (e.1.base pt_k)
      let _ : AlgebraicGeometry.Etale (Fgt.map u).left := hEt_u
      let P_pb := CategoryTheory.Limits.pullback (Fgt.map u).left e.1
      let q_pb : P_pb ⟶ S_k := CategoryTheory.Limits.pullback.snd (Fgt.map u).left e.1
      obtain ⟨p₀, _, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ pt_k hy₀
      obtain ⟨s₀, hs₀_id, _⟩ := hLiftSpec P_pb q_pb p₀
      let e_Y : (fibOf σ).obj Y :=
        ⟨s₀ ≫ CategoryTheory.Limits.pullback.fst (Fgt.map u).left e.1, by
          have hw_u : (Fgt.map u).left ≫ (Fgt.obj E).hom = (Fgt.obj Y).hom := (Fgt.map u).w
          have hcond_u : CategoryTheory.Limits.pullback.fst (Fgt.map u).left e.1 ≫ (Fgt.map u).left =
              q_pb ≫ e.1 := CategoryTheory.Limits.pullback.condition
          rw [Category.assoc, ← hw_u, ← Category.assoc (CategoryTheory.Limits.pullback.fst _ _),
            hcond_u, Category.assoc, ← Category.assoc s₀, hs₀_id, Category.id_comp, e.2]⟩
      refine ⟨Y, u, huR, e_Y, Subtype.ext ?_⟩
      change (s₀ ≫ CategoryTheory.Limits.pullback.fst (Fgt.map u).left e.1) ≫ (Fgt.map u).left = e.1
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc,
        hs₀_id, Category.id_comp]
    let ptOf : (S_k ⟶ D) → CategoryTheory.GrothendieckTopology.Point.{u} D.smallEtaleTopology :=
      fun σ => CategoryTheory.GrothendieckTopology.Point.mk (fibOf σ) (hFibCof σ) (hFibInit σ)
        (@hFibJoint σ)
    have hShrinkSingleton : ∀ (σ : S_k ⟶ D) [AlgebraicGeometry.IsClosedImmersion σ]
        (E : D.Etale) (e₀ : (fibOf σ).obj E),
        ∃ (E_iso : D.Etale) (u_iso : E_iso ⟶ E) (e_hat : (fibOf σ).obj E_iso),
          ((fibOf σ).map u_iso) e_hat = e₀ ∧
          ∀ (e' : (fibOf σ).obj E_iso), e' = e_hat := by
      intro σ _ E e₀
      let V_E : AlgebraicGeometry.Scheme.{u} := (Fgt.obj E).left
      let h_E : V_E ⟶ D := (Fgt.obj E).hom
      have : AlgebraicGeometry.Etale h_E := E.prop
      let F_E := CategoryTheory.Limits.pullback h_E σ
      let fst_E : F_E ⟶ V_E := CategoryTheory.Limits.pullback.fst h_E σ
      let q_E : F_E ⟶ S_k := CategoryTheory.Limits.pullback.snd h_E σ
      have hpb_FE : CategoryTheory.IsPullback fst_E q_E h_E σ :=
        CategoryTheory.IsPullback.of_hasPullback h_E σ
      let _ : AlgebraicGeometry.IsClosedImmersion fst_E :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_FE.flip inferInstance
      let σ₀ : S_k ⟶ F_E :=
        CategoryTheory.Limits.pullback.lift e₀.1 (𝟙 S_k) ((Category.id_comp σ).symm ▸ e₀.2)
      have hσ₀_fst : σ₀ ≫ fst_E = e₀.1 := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hσ₀_snd : σ₀ ≫ q_E = 𝟙 S_k := CategoryTheory.Limits.pullback.lift_snd _ _ _
      let δ_q : F_E ⟶ CategoryTheory.Limits.pullback q_E q_E :=
        CategoryTheory.Limits.pullback.diagonal q_E
      have : AlgebraicGeometry.IsOpenImmersion δ_q :=
        AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal q_E
      let g_sec : F_E ⟶ CategoryTheory.Limits.pullback q_E q_E :=
        CategoryTheory.Limits.pullback.lift (𝟙 F_E) (q_E ≫ σ₀)
          (by rw [Category.id_comp, Category.assoc, hσ₀_snd, Category.comp_id])
      have hg_fst : g_sec ≫ CategoryTheory.Limits.pullback.fst q_E q_E = 𝟙 F_E :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hg_snd : g_sec ≫ CategoryTheory.Limits.pullback.snd q_E q_E = q_E ≫ σ₀ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hδ_fst : δ_q ≫ CategoryTheory.Limits.pullback.fst q_E q_E = 𝟙 F_E :=
        CategoryTheory.Limits.pullback.diagonal_fst q_E
      have hδ_snd : δ_q ≫ CategoryTheory.Limits.pullback.snd q_E q_E = 𝟙 F_E :=
        CategoryTheory.Limits.pullback.diagonal_snd q_E
      have hcomm_σ₀ : σ₀ ≫ g_sec = σ₀ ≫ δ_q := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, hg_fst, Category.assoc, hδ_fst]
        · rw [Category.assoc, hg_snd, Category.assoc, hδ_snd, Category.comp_id,
            ← Category.assoc, hσ₀_snd, Category.id_comp]
      have hpb_σ₀ : CategoryTheory.IsPullback σ₀ σ₀ g_sec δ_q := by
        refine CategoryTheory.IsPullback.of_isLimit (CategoryTheory.Limits.PullbackCone.IsLimit.mk
          hcomm_σ₀
          (fun c => c.fst ≫ q_E)
          (fun c => by
            have hc1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst q_E q_E) c.condition
            have hc2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd q_E q_E) c.condition
            change (c.fst ≫ g_sec) ≫ _ = (c.snd ≫ δ_q) ≫ _ at hc1 hc2
            rw [Category.assoc, hg_fst, Category.assoc, hδ_fst, Category.comp_id,
              Category.comp_id] at hc1
            rw [Category.assoc, hg_snd, Category.assoc, hδ_snd, Category.comp_id] at hc2
            rw [Category.assoc, hc2, ← hc1])
          (fun c => by
            have hc2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd q_E q_E) c.condition
            change (c.fst ≫ g_sec) ≫ _ = (c.snd ≫ δ_q) ≫ _ at hc2
            rw [Category.assoc, hg_snd, Category.assoc, hδ_snd, Category.comp_id] at hc2
            rw [Category.assoc, hc2])
          (fun c m hm₁ _ => by
            have hm₁' : m ≫ σ₀ = c.fst := hm₁
            calc m = m ≫ 𝟙 S_k := (Category.comp_id m).symm
              _ = m ≫ (σ₀ ≫ q_E) := by rw [hσ₀_snd]
              _ = (m ≫ σ₀) ≫ q_E := (Category.assoc _ _ _).symm
              _ = c.fst ≫ q_E := by rw [hm₁']))
      let _ : AlgebraicGeometry.IsOpenImmersion σ₀ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_σ₀.flip inferInstance
      have hC_closed : IsClosed ((Set.range σ₀.base)ᶜ : Set ↥F_E) :=
        σ₀.isOpenEmbedding.isOpen_range.isClosed_compl
      let K_other : Set ↥V_E := fst_E.base '' ((Set.range σ₀.base)ᶜ)
      have hK_closed : IsClosed K_other := fst_E.isClosedEmbedding.isClosedMap _ hC_closed
      let U_iso : V_E.Opens := ⟨K_otherᶜ, hK_closed.isOpen_compl⟩
      let E_iso : D.Etale := AlgebraicGeometry.Scheme.Etale.mk (U_iso.ι ≫ h_E)
      let u_iso : E_iso ⟶ E := CategoryTheory.MorphismProperty.Over.homMk U_iso.ι rfl trivial
      have he₀_range : Set.range e₀.1.base ⊆ Set.range U_iso.ι.base := by
        rw [hOpensRange U_iso]
        rintro _ ⟨pt, rfl⟩
        change e₀.1.base pt ∉ K_other
        rintro ⟨w, hw_not, hw_eq⟩
        have hw_eq' : fst_E.base w = fst_E.base (σ₀.base pt) := by
          rw [hw_eq, ← hσ₀_fst]
          rfl
        have hw_σ : w = σ₀.base pt := fst_E.isClosedEmbedding.injective hw_eq'
        exact hw_not ⟨pt, hw_σ.symm⟩
      let e_hat_hom : S_k ⟶ U_iso.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι e₀.1 he₀_range
      have he_hat_fac : e_hat_hom ≫ U_iso.ι = e₀.1 :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι e₀.1 he₀_range
      let e_hat : (fibOf σ).obj E_iso :=
        ⟨e_hat_hom, (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ h_E) he_hat_fac).trans e₀.2)⟩
      refine ⟨E_iso, u_iso, e_hat, Subtype.ext he_hat_fac, fun e' => Subtype.ext ?_⟩
      let e'_hom : S_k ⟶ U_iso.toScheme := e'.1
      have he'_σ : (e'_hom ≫ U_iso.ι) ≫ h_E = σ := (Category.assoc _ _ _).trans e'.2
      let σ' : S_k ⟶ F_E :=
        CategoryTheory.Limits.pullback.lift (e'_hom ≫ U_iso.ι) (𝟙 S_k)
          ((Category.id_comp σ).symm ▸ he'_σ)
      have hσ'_fst : σ' ≫ fst_E = e'_hom ≫ U_iso.ι := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hσ'_snd : σ' ≫ q_E = 𝟙 S_k := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hσ'_range : Set.range σ'.base ⊆ Set.range σ₀.base := by
        rintro _ ⟨pt, rfl⟩
        by_contra hnot
        have hmem_K : fst_E.base (σ'.base pt) ∈ K_other := ⟨σ'.base pt, hnot, rfl⟩
        have hmem_U : U_iso.ι.base (e'_hom.base pt) ∈ (U_iso : Set ↥V_E) := by
          rw [← hOpensRange U_iso]
          exact ⟨e'_hom.base pt, rfl⟩
        have heq_pt : fst_E.base (σ'.base pt) = U_iso.ι.base (e'_hom.base pt) := by
          change (σ' ≫ fst_E).base pt = (e'_hom ≫ U_iso.ι).base pt
          rw [hσ'_fst]
        rw [heq_pt] at hmem_K
        exact hmem_U hmem_K
      let l_eq : S_k ⟶ S_k := AlgebraicGeometry.IsOpenImmersion.lift σ₀ σ' hσ'_range
      have hl_fac : l_eq ≫ σ₀ = σ' := AlgebraicGeometry.IsOpenImmersion.lift_fac σ₀ σ' hσ'_range
      have hl_id : l_eq = 𝟙 S_k := by
        calc l_eq = l_eq ≫ 𝟙 S_k := (Category.comp_id _).symm
          _ = l_eq ≫ (σ₀ ≫ q_E) := by rw [hσ₀_snd]
          _ = (l_eq ≫ σ₀) ≫ q_E := (Category.assoc _ _ _).symm
          _ = σ' ≫ q_E := by rw [hl_fac]
          _ = 𝟙 S_k := hσ'_snd
      have hσ'_eq : σ' = σ₀ := by rw [← hl_fac, hl_id, Category.id_comp]
      have he'_comp : e'_hom ≫ U_iso.ι = e_hat_hom ≫ U_iso.ι := by
        rw [← hσ'_fst, hσ'_eq, hσ₀_fst, he_hat_fac]
      exact (cancel_mono U_iso.ι).mp he'_comp
    suffices hInd : ∀ (n : ℕ)
        (t : Fin n → (S_k ⟶ D))
        (ht : ∀ i : Fin n, AlgebraicGeometry.IsClosedImmersion (t i))
        (O : D.Opens)
        (hO : (O : Set D)ᶜ ⊆ ⋃ i : Fin n, Set.range (t i).base)
        (ℱ : CategoryTheory.Sheaf D.smallEtaleTopology AddCommGrpCat.{u})
        (hℱ : ∀ W : D.Etale, Set.range (Fgt.obj W).hom.base ⊆ (O : Set D) →
          Subsingleton ↑(ℱ.obj.obj (Opposite.op W))),
        Subsingleton (ℱ.H 1) from
      hInd m s hs U hU_compl 𝒢 h𝒢_U
    intro n
    induction n with
    | zero =>
      intro t _ O hO ℱ hℱ
      have hO_univ : (O : Set D) = Set.univ := by
        rw [← Set.compl_empty_iff, ← Set.subset_empty_iff]
        refine hO.trans ?_
        rintro _ ⟨_, ⟨i, rfl⟩, _⟩
        exact Fin.elim0 i
      have hid_zero : 𝟙 ℱ = (0 : ℱ ⟶ ℱ) := by
        apply CategoryTheory.Sheaf.hom_ext
        ext opW x
        have hSubW : Subsingleton ↑(ℱ.obj.obj opW) := by
          apply hℱ opW.unop
          rw [hO_univ]
          exact Set.subset_univ _
        exact @Subsingleton.elim _ hSubW _ _
      refine ⟨fun c₁ c₂ => ?_⟩
      have hc0 : ∀ c : ℱ.H 1, c = 0 := by
        intro c
        have hmap_id : CategoryTheory.Sheaf.H.map (𝟙 ℱ) 1 c = c := by
          change c.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 ℱ)) (Nat.add_zero 1) = c
          exact CategoryTheory.Abelian.Ext.comp_mk₀_id c
        have hmap_zero : CategoryTheory.Sheaf.H.map (0 : ℱ ⟶ ℱ) 1 c = 0 := by
          change c.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : ℱ ⟶ ℱ)) (Nat.add_zero 1) = 0
          rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        rw [← hmap_id, hid_zero, hmap_zero]
      exact (hc0 c₁).trans (hc0 c₂).symm
    | succ n' ih =>
      intro t ht O hO ℱ hℱ
      let σ : S_k ⟶ D := t 0
      let _ : AlgebraicGeometry.IsClosedImmersion σ := ht 0
      let t' : Fin n' → (S_k ⟶ D) := fun j => t (Fin.succ j)
      have ht' : ∀ j : Fin n', AlgebraicGeometry.IsClosedImmersion (t' j) :=
        fun j => ht (Fin.succ j)
      let Φ_σ := ptOf σ
      let Sky := Φ_σ.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let adj_σ := Φ_σ.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
      let M_σ : AddCommGrpCat.{u} := Φ_σ.sheafFiber.obj ℱ
      let 𝒮_σ := Sky.obj M_σ
      let η_σ : ℱ ⟶ 𝒮_σ := adj_σ.unit.app ℱ
      let 𝒦 := CategoryTheory.Limits.kernel η_σ
      let ι_𝒦 : 𝒦 ⟶ ℱ := CategoryTheory.Limits.kernel.ι η_σ
      have hLiftPt : ∀ (E : D.Etale) (y : ↥(Fgt.obj E).left),
          (Fgt.obj E).hom.base y ∈ Set.range σ.base →
          ∃ (e₀ : Φ_σ.fiber.obj E), e₀.1.base pt_k = y := by
        intro E y hy_mem
        rcases hy_mem with ⟨pt, hy_eq⟩
        rw [hSk_eq pt] at hy_eq
        let h_E := (Fgt.obj E).hom
        have : AlgebraicGeometry.Etale h_E := E.prop
        let F_E := CategoryTheory.Limits.pullback h_E σ
        let q_E : F_E ⟶ S_k := CategoryTheory.Limits.pullback.snd h_E σ
        obtain ⟨w₀, hw₀_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y pt_k hy_eq.symm
        obtain ⟨s₀, hs₀_id, hs₀_pt⟩ := hLiftSpec F_E q_E w₀
        refine ⟨⟨s₀ ≫ CategoryTheory.Limits.pullback.fst h_E σ, by
            rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc,
              hs₀_id, Category.id_comp]⟩, ?_⟩
        change (CategoryTheory.Limits.pullback.fst h_E σ).base (s₀.base pt_k) = y
        rw [hs₀_pt, hw₀_fst]
      have hUnitProj : ∀ (E : D.Etale) (e : Φ_σ.fiber.obj E),
          η_σ.hom.app (Opposite.op E) ≫ CategoryTheory.Limits.Pi.π (fun _ => M_σ) e =
            Φ_σ.toPresheafFiber E e ℱ.obj := by
        intro E e
        let ff := CategoryTheory.fullyFaithfulSheafToPresheaf D.smallEtaleTopology AddCommGrpCat.{u}
        let id_M : Φ_σ.presheafFiber.obj ℱ.obj ⟶ M_σ := 𝟙 M_σ
        have hη_eq : (adj_σ.homEquiv ℱ M_σ) (𝟙 M_σ) = η_σ := by
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          exact CategoryTheory.Functor.map_id Sky M_σ ▸ Category.comp_id _
        have hmk : (adj_σ.homEquiv ℱ M_σ) (𝟙 M_σ) =
            (@CategoryTheory.Functor.FullyFaithful.homEquiv _ _ _ _ _ ff ℱ 𝒮_σ).symm
              (Φ_σ.skyscraperPresheafHomEquiv id_M) := by
          dsimp [adj_σ, CategoryTheory.GrothendieckTopology.Point.skyscraperSheafAdjunction]
          simp only [CategoryTheory.Adjunction.mkOfHomEquiv_homEquiv]
          rfl
        have hhom_eq : η_σ.hom = Φ_σ.skyscraperPresheafHomEquiv id_M :=
          (congrArg (@CategoryTheory.Functor.FullyFaithful.homEquiv _ _ _ _ _ ff ℱ 𝒮_σ)
            (hη_eq.symm.trans hmk)).trans (Equiv.apply_symm_apply _ _)
        let f_fan : ∀ x : Φ_σ.fiber.obj E, ℱ.obj.obj (Opposite.op E) ⟶ M_σ :=
          fun x => Φ_σ.toPresheafFiber E x ℱ.obj ≫ id_M
        have happ_eq : η_σ.hom.app (Opposite.op E) = CategoryTheory.Limits.Pi.lift f_fan :=
          congrArg (fun nt => nt.app (Opposite.op E)) hhom_eq
        exact (congrArg (· ≫ CategoryTheory.Limits.Pi.π (fun _ => M_σ) e) happ_eq).trans
          ((CategoryTheory.Limits.limit.lift_π (CategoryTheory.Limits.Fan.mk _ f_fan) ⟨e⟩).trans
            (Category.comp_id (Φ_σ.toPresheafFiber E e ℱ.obj)))
      have hls_η : CategoryTheory.Presheaf.IsLocallySurjective D.smallEtaleTopology η_σ.hom := by
        refine ⟨fun {E} z => ?_⟩
        refine hMemEtaleTop (CategoryTheory.Presheaf.imageSieve η_σ.hom z) (fun y => ?_)
        by_cases hy_σ : (Fgt.obj E).hom.base y ∈ Set.range σ.base
        · obtain ⟨e₀, he₀_y⟩ := hLiftPt E y hy_σ
          let m₀ : ↑M_σ := (CategoryTheory.Limits.Pi.π (fun _ => M_σ) e₀).hom z
          obtain ⟨E₁, e₁, g₁, hg₁_eq⟩ :=
            Φ_σ.toPresheafFiber_jointly_surjective (P := ℱ.obj) m₀
          let X₀ : Φ_σ.fiber.Elements := CategoryTheory.Functor.elementsMk Φ_σ.fiber E e₀
          let X₁ : Φ_σ.fiber.Elements := CategoryTheory.Functor.elementsMk Φ_σ.fiber E₁ e₁
          let _ : CategoryTheory.IsCofiltered Φ_σ.fiber.Elements := hFibCof σ
          let X₂ : Φ_σ.fiber.Elements := CategoryTheory.IsCofiltered.min X₀ X₁
          let v₀ : X₂ ⟶ X₀ := CategoryTheory.IsCofiltered.minToLeft X₀ X₁
          let v₁ : X₂ ⟶ X₁ := CategoryTheory.IsCofiltered.minToRight X₀ X₁
          obtain ⟨E₃, w_iso, e₃, he₃_map, he₃_uniq⟩ := hShrinkSingleton σ X₂.obj X₂.val
          let u_tot : E₃ ⟶ E := w_iso ≫ v₀.hom
          let g₃ : ↑(ℱ.obj.obj (Opposite.op E₃)) := (ℱ.obj.map (w_iso ≫ v₁.hom).op).hom g₁
          have hu_tot_e₃ : (Φ_σ.fiber.map u_tot) e₃ = e₀ := by
            have h1 := congrArg (fun m => m e₃) (Φ_σ.fiber.map_comp w_iso v₀.hom)
            dsimp at h1
            rw [h1, he₃_map]
            exact v₀.map_val
          have hv₁_e₃ : (Φ_σ.fiber.map (w_iso ≫ v₁.hom)) e₃ = e₁ := by
            have h1 := congrArg (fun m => m e₃) (Φ_σ.fiber.map_comp w_iso v₁.hom)
            dsimp at h1
            rw [h1, he₃_map]
            exact v₁.map_val
          refine ⟨E₃, u_tot, e₃.1.base pt_k, ⟨g₃, ?_⟩, ?_⟩
          · apply hPiExt
            intro idx
            rw [he₃_uniq idx]
            have hlhs : (CategoryTheory.Limits.Pi.π (fun _ => M_σ) e₃).hom
                ((η_σ.hom.app (Opposite.op E₃)).hom g₃) = m₀ := by
              change (η_σ.hom.app (Opposite.op E₃) ≫
                CategoryTheory.Limits.Pi.π (fun _ => M_σ) e₃).hom g₃ = m₀
              rw [hUnitProj E₃ e₃]
              change (ℱ.obj.map (w_iso ≫ v₁.hom).op ≫ Φ_σ.toPresheafFiber E₃ e₃ ℱ.obj).hom g₁ = m₀
              rw [Φ_σ.toPresheafFiber_w (w_iso ≫ v₁.hom) e₃ ℱ.obj, hv₁_e₃]
              exact hg₁_eq
            have hrhs : (CategoryTheory.Limits.Pi.π (fun _ => M_σ) e₃).hom
                ((𝒮_σ.obj.map u_tot.op).hom z) = m₀ := by
              have hsky_map : (Φ_σ.skyscraperPresheafFunctor.obj M_σ).map u_tot.op =
                  CategoryTheory.Limits.Pi.map' (Φ_σ.fiber.map u_tot) (fun _ => 𝟙 M_σ) :=
                Φ_σ.skyscraperPresheafFunctor_obj_map M_σ u_tot.op
              have hpi_comp : CategoryTheory.Limits.Pi.map' (Φ_σ.fiber.map u_tot) (fun _ => 𝟙 M_σ) ≫
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_σ.fiber.obj E₃ => M_σ) e₃ =
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_σ.fiber.obj E => M_σ) e₀ := by
                dsimp [CategoryTheory.Limits.Pi.map']
                simp only [CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
                  CategoryTheory.Limits.Fan.mk_π_app, Category.comp_id]
                exact congrArg (CategoryTheory.Limits.Pi.π (fun _ => M_σ)) hu_tot_e₃
              have hsky_comp : 𝒮_σ.obj.map u_tot.op ≫
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_σ.fiber.obj E₃ => M_σ) e₃ =
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_σ.fiber.obj E => M_σ) e₀ :=
                (congrArg (· ≫ CategoryTheory.Limits.Pi.π (fun _ => M_σ) e₃) hsky_map).trans hpi_comp
              exact congrArg (fun m => m.hom z) hsky_comp
            exact hlhs.trans hrhs.symm
          · have heq_hom : e₃.1 ≫ (Fgt.map u_tot).left = e₀.1 := congrArg Subtype.val hu_tot_e₃
            calc (Fgt.map u_tot).left.base (e₃.1.base pt_k)
                = (e₃.1 ≫ (Fgt.map u_tot).left).base pt_k := rfl
              _ = e₀.1.base pt_k := by rw [heq_hom]
              _ = y := he₀_y
        · let V_E : AlgebraicGeometry.Scheme.{u} := (Fgt.obj E).left
          let h_E : V_E ⟶ D := (Fgt.obj E).hom
          have : AlgebraicGeometry.Etale h_E := E.prop
          let W_0 : V_E.Opens := ⟨h_E.base ⁻¹' (Set.range σ.base)ᶜ,
            σ.isClosedEmbedding.isClosed_range.isOpen_compl.preimage h_E.continuous⟩
          let E_0 : D.Etale := AlgebraicGeometry.Scheme.Etale.mk (W_0.ι ≫ h_E)
          let u_0 : E_0 ⟶ E := CategoryTheory.MorphismProperty.Over.homMk W_0.ι rfl trivial
          have hEmpty : IsEmpty (Φ_σ.fiber.obj E_0) :=
            ⟨fun e => by
              let e_hom : S_k ⟶ W_0.toScheme := e.1
              have he2 : (e_hom ≫ W_0.ι) ≫ h_E = σ := (Category.assoc _ _ _).trans e.2
              have hmem_W : W_0.ι.base (e_hom.base pt_k) ∈ (W_0 : Set ↥V_E) := by
                rw [← hOpensRange W_0]
                exact ⟨e_hom.base pt_k, rfl⟩
              have hnot_σ : h_E.base (W_0.ι.base (e_hom.base pt_k)) ∉ Set.range σ.base := hmem_W
              apply hnot_σ
              refine ⟨pt_k, ?_⟩
              calc σ.base pt_k = ((e_hom ≫ W_0.ι) ≫ h_E).base pt_k := by rw [he2]
                _ = h_E.base (W_0.ι.base (e_hom.base pt_k)) := rfl⟩
          refine ⟨E_0, u_0, ⟨y, hy_σ⟩, ⟨0, ?_⟩, rfl⟩
          rw [map_zero]
          apply hPiExt
          intro idx
          exact IsEmpty.elim hEmpty idx
      let _ : Epi η_σ :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (φ := η_σ)).mp hls_η
      let S_exc := CategoryTheory.ShortComplex.mk ι_𝒦 η_σ
        (CategoryTheory.Limits.kernel.condition η_σ)
      have hEx_exc : S_exc.Exact :=
        CategoryTheory.ShortComplex.exact_of_f_is_kernel S_exc
          (CategoryTheory.Limits.kernelIsKernel η_σ)
      have hSES_exc : S_exc.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hEx_exc inferInstance inferInstance
      let J_rest : Finset (Fin n') :=
        Finset.univ.filter (fun j : Fin n' => σ.base pt_k ∉ Set.range (t' j).base)
      let K_rest : Set ↥D := ⋃ j ∈ J_rest, Set.range (t' j).base
      have hK_rest_closed : IsClosed K_rest :=
        J_rest.finite_toSet.isClosed_biUnion (fun j _ => (t' j).isClosedEmbedding.isClosed_range)
      let O_next : D.Opens := O ⊔ ⟨K_restᶜ, hK_rest_closed.isOpen_compl⟩
      have hO_next_compl : (O_next : Set D)ᶜ ⊆ ⋃ j : Fin n', Set.range (t' j).base := by
        intro d hd
        have hd_not : ¬ (d ∈ (O : Set D) ∨ d ∈ K_restᶜ) := hd
        push Not at hd_not
        have hd_K : d ∈ K_rest := not_not.mp hd_not.2
        simp only [K_rest, Set.mem_iUnion] at hd_K ⊢
        rcases hd_K with ⟨j, _, hdj⟩
        exact ⟨j, hdj⟩
      have hO_next_away : ∀ d : ↥D, d ∈ (O_next : Set D) → d ∉ Set.range σ.base → d ∈ (O : Set D) := by
        intro d hd_next hd_not_σ
        rcases hd_next with hd_O | hd_not_K
        · exact hd_O
        · by_contra hd_not_O
          have hd_union := hO hd_not_O
          simp only [Set.mem_iUnion] at hd_union
          rcases hd_union with ⟨i, hdi⟩
          refine Fin.cases (fun h0 => hd_not_σ h0) (fun j hj => ?_) i hdi
          rcases hj with ⟨pt, rfl⟩
          have hσ_not_tj : σ.base pt_k ∉ Set.range (t' j).base := by
            rintro ⟨pt', hpt'⟩
            rw [hSk_eq pt'] at hpt'
            rw [hSk_eq pt] at hd_not_σ
            exact hd_not_σ ⟨pt_k, hpt'.symm⟩
          have hj_mem : j ∈ J_rest := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hσ_not_tj⟩
          have hd_in_K : (t' j).base pt ∈ K_rest :=
            Set.mem_biUnion hj_mem ⟨pt, rfl⟩
          exact hd_not_K hd_in_K
      have h𝒦_vanish : ∀ W : D.Etale, Set.range (Fgt.obj W).hom.base ⊆ (O_next : Set D) →
          Subsingleton ↑(𝒦.obj.obj (Opposite.op W)) := by
        intro W hW_range
        let _ : CategoryTheory.Limits.PreservesLimits
            (CategoryTheory.sheafToPresheaf D.smallEtaleTopology AddCommGrpCat.{u}) :=
          (CategoryTheory.sheafificationAdjunction D.smallEtaleTopology
            AddCommGrpCat.{u}).rightAdjoint_preservesLimits
        let _ : Mono ι_𝒦.hom := inferInstanceAs (Mono ((CategoryTheory.sheafToPresheaf
          D.smallEtaleTopology AddCommGrpCat.{u}).map ι_𝒦))
        have hMono_app : Mono (ι_𝒦.hom.app (Opposite.op W)) :=
          ((CategoryTheory.evaluation D.Etaleᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op W)).map_mono
            ι_𝒦.hom
        have hInj_ι : Function.Injective (ι_𝒦.hom.app (Opposite.op W)).hom :=
          (AddCommGrpCat.mono_iff_injective _).mp hMono_app
        refine ⟨fun s₁ s₂ => ?_⟩
        have hs_zero : ∀ s₀ : ↑(𝒦.obj.obj (Opposite.op W)), s₀ = 0 := by
          intro s₀
          apply hInj_ι
          rw [map_zero]
          let g : ↑(ℱ.obj.obj (Opposite.op W)) := (ι_𝒦.hom.app (Opposite.op W)).hom s₀
          have hη_g : (η_σ.hom.app (Opposite.op W)).hom g = 0 := by
            change ((ι_𝒦 ≫ η_σ).hom.app (Opposite.op W)).hom s₀ = 0
            rw [CategoryTheory.Limits.kernel.condition η_σ]
            rfl
          let R_g : CategoryTheory.Sieve W :=
            { arrows := fun W' u => (ℱ.obj.map u.op).hom g = 0
              downward_closed := fun {W' W''} {u} hu v => by
                rw [op_comp, ℱ.obj.map_comp]
                change (ℱ.obj.map v.op).hom ((ℱ.obj.map u.op).hom g) = 0
                rw [hu, map_zero] }
          have hRg_mem : R_g ∈ D.smallEtaleTopology W := by
            refine hMemEtaleTop R_g (fun y => ?_)
            by_cases hy_σ : (Fgt.obj W).hom.base y ∈ Set.range σ.base
            · obtain ⟨e₀, he₀_y⟩ := hLiftPt W y hy_σ
              have hstalk0 : (Φ_σ.toPresheafFiber W e₀ ℱ.obj).hom g =
                  (Φ_σ.toPresheafFiber W e₀ ℱ.obj).hom 0 := by
                rw [map_zero, ← hUnitProj W e₀]
                have hη_g' : (η_σ.hom.app (Opposite.op W)).hom g =
                    (0 : ↑(CategoryTheory.Limits.piObj (fun _ : Φ_σ.fiber.obj W => M_σ))) := hη_g
                exact (congrArg (CategoryTheory.Limits.Pi.π (fun _ => M_σ) e₀).hom hη_g').trans
                  (map_zero _)
              obtain ⟨W', u, e', he'_map, hu_g⟩ :=
                (Φ_σ.toPresheafFiber_eq_iff' W e₀ g 0).mp hstalk0
              rw [map_zero] at hu_g
              refine ⟨W', u, e'.1.base pt_k, hu_g, ?_⟩
              have heq_hom : e'.1 ≫ (Fgt.map u).left = e₀.1 := congrArg Subtype.val he'_map
              calc (Fgt.map u).left.base (e'.1.base pt_k)
                  = (e'.1 ≫ (Fgt.map u).left).base pt_k := rfl
                _ = e₀.1.base pt_k := by rw [heq_hom]
                _ = y := he₀_y
            · let V_W : AlgebraicGeometry.Scheme.{u} := (Fgt.obj W).left
              let h_W : V_W ⟶ D := (Fgt.obj W).hom
              have : AlgebraicGeometry.Etale h_W := W.prop
              let O_y : V_W.Opens := ⟨h_W.base ⁻¹' (Set.range σ.base)ᶜ,
                σ.isClosedEmbedding.isClosed_range.isOpen_compl.preimage h_W.continuous⟩
              let W_y : D.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_y.ι ≫ h_W)
              let u_y : W_y ⟶ W := CategoryTheory.MorphismProperty.Over.homMk O_y.ι rfl trivial
              have hWy_O : Set.range (Fgt.obj W_y).hom.base ⊆ (O : Set D) := by
                rintro _ ⟨z, rfl⟩
                have hz_Oy : O_y.ι.base z ∈ (O_y : Set ↥V_W) := by
                  rw [← hOpensRange O_y]
                  exact ⟨z, rfl⟩
                have hz_next : h_W.base (O_y.ι.base z) ∈ (O_next : Set D) :=
                  hW_range ⟨O_y.ι.base z, rfl⟩
                exact hO_next_away _ hz_next hz_Oy
              have hSub_Wy : Subsingleton ↑(ℱ.obj.obj (Opposite.op W_y)) := hℱ W_y hWy_O
              refine ⟨W_y, u_y, ⟨y, hy_σ⟩, @Subsingleton.elim _ hSub_Wy _ _, rfl⟩
          exact hSheafEqZero ℱ R_g hRg_mem g (fun W' u hu => hu)
        exact (hs_zero s₁).trans (hs_zero s₂).symm
      have hSub_𝒦 : Subsingleton (𝒦.H 1) := ih t' ht' O_next hO_next_compl 𝒦 h𝒦_vanish
      have hSub_𝒮 : Subsingleton (𝒮_σ.H 1) := hSkyH1 Φ_σ M_σ
      let Fℤ := (CategoryTheory.constantSheaf D.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      refine ⟨fun c₁ c₂ => ?_⟩
      have hc_zero : ∀ c : ℱ.H 1, c = 0 := by
        intro c
        have hc_𝒮 : c.comp (CategoryTheory.Abelian.Ext.mk₀ η_σ) (Nat.add_zero 1) = 0 :=
          @Subsingleton.elim _ hSub_𝒮 _ _
        obtain ⟨c₀, hc₀⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSES_exc c hc_𝒮
        have hc₀_zero : c₀ = 0 := @Subsingleton.elim _ hSub_𝒦 _ _
        rw [← hc₀, hc₀_zero, CategoryTheory.Abelian.Ext.zero_comp]
      exact (hc_zero c₁).trans (hc_zero c₂).symm

  
  obtain ⟨m, s_bar, hs_bar, hCompl⟩ := hPart1
  exact hPart3 (AlgebraicClosure F) (weilGeomScheme F Y₀) m s_bar hs_bar
    ((TopologicalSpace.Opens.map pr_Y.base).obj U₀) hCompl.subset
    ((@CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
        Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
        hCont_pr hAdj_pr).obj (CategoryTheory.Limits.cokernel φ))
    (fun W_X hW_X => hPart2 (weilGeomScheme F Y₀) Y₀.left pr_Y U₀ ℱ₁ ℱ₂ φ hφ_U₀
      hCont_pr hAdj_pr W_X hW_X)

theorem weil_transv_konig_padic_tower_surjection (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H₁ H₂ : ℕ → Type u) [∀ r, AddCommGroup (H₁ r)] [∀ r, AddCommGroup (H₂ r)]
    (τ₁ : ∀ r : ℕ, H₁ (r + 1) →+ H₁ r)
    (τ₂ : ∀ r : ℕ, H₂ (r + 1) →+ H₂ r)
    (f₁ : ∀ r : ℕ, H₁ r →+ H₁ r)
    (f₂ : ∀ r : ℕ, H₂ r →+ H₂ r)
    (q : ∀ r : ℕ, H₁ r →+ H₂ r)
    (sys₁ : AddSubgroup (∀ r : ℕ, H₁ r))
    (sys₂ : AddSubgroup (∀ r : ℕ, H₂ r))
    (V₁ V₂ : Type u) [AddCommGroup V₁] [Module (Padic ℓ) V₁]
    [AddCommGroup V₂] [Module (Padic ℓ) V₂]
    (frob₁ : V₁ →ₗ[Padic ℓ] V₁)
    (frob₂ : V₂ →ₗ[Padic ℓ] V₂)
    (equiv₁ : TensorProduct ℤ ℚ ↥sys₁ ≃+ V₁)
    (equiv₂ : TensorProduct ℤ ℚ ↥sys₂ ≃+ V₂)
    (hTors₁ : ∀ (r : ℕ) (w : H₁ r), (ℓ ^ (r + 1)) • w = 0)
    (hTors₂ : ∀ (r : ℕ) (w : H₂ r), (ℓ ^ (r + 1)) • w = 0)
    (hFin₁ : ∀ r : ℕ, Finite (H₁ r))
    (hq_surj : ∀ r : ℕ, Function.Surjective (q r))
    (hq_τ : ∀ (r : ℕ) (x : H₁ (r + 1)), q r (τ₁ r x) = τ₂ r (q (r + 1) x))
    (hq_f : ∀ (r : ℕ) (x : H₁ r), q r (f₁ r x) = f₂ r (q r x))
    (hf₁_τ : ∀ (r : ℕ) (x : H₁ (r + 1)), τ₁ r (f₁ (r + 1) x) = f₁ r (τ₁ r x))
    (hsys₁ : ∀ x : (∀ r : ℕ, H₁ r), x ∈ sys₁ ↔ ∀ r : ℕ, τ₁ r (x (r + 1)) = x r)
    (hsys₂ : ∀ y : (∀ r : ℕ, H₂ r), y ∈ sys₂ ↔ ∀ r : ℕ, τ₂ r (y (r + 1)) = y r)
    (hsmul₁ : ∀ (z : PadicInt ℓ) (x y : ↥sys₁),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
        equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))
    (hsmul₂ : ∀ (z : PadicInt ℓ) (x y : ↥sys₂),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
        equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x))
    (hfrob₁ : ∀ (x y : ↥sys₁),
      (∀ r : ℕ, y.1 r = f₁ r (x.1 r)) →
        frob₁ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y))
    (hfrob₂ : ∀ (x y : ↥sys₂),
      (∀ r : ℕ, y.1 r = f₂ r (x.1 r)) →
        frob₂ (equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y)) :
    ∃ π : V₁ →ₗ[Padic ℓ] V₂,
      Function.Surjective π ∧
      ∀ v : V₁, π (frob₁ v) = frob₂ (π v) :=
by
  let _ := hTors₂
  have hPrime : Nat.Prime ℓ := Fact.out
  let q_sys : ↥sys₁ →+ ↥sys₂ :=
    { toFun := fun x => ⟨fun r => q r (x.1 r), (hsys₂ _).mpr fun r => by
        rw [← hq_τ r (x.1 (r + 1)), (hsys₁ x.1).mp x.2 r]⟩
      map_zero' := Subtype.ext (funext fun r => map_zero (q r))
      map_add' := fun x y => Subtype.ext (funext fun r => map_add (q r) (x.1 r) (y.1 r)) }
  have hq_sys_surj : Function.Surjective q_sys := by
    intro y
    let K_fib : ℕ → Type u := fun r => { x_r : H₁ r // q r x_r = y.1 r }
    let step : ∀ r : ℕ, K_fib (r + 1) → K_fib r := fun r x_succ =>
      ⟨τ₁ r x_succ.1, by rw [hq_τ r x_succ.1, x_succ.2, (hsys₂ y.1).mp y.2 r]⟩
    let iter : ∀ (b a : ℕ), a ≤ b → K_fib b → K_fib a :=
      Nat.rec
        (fun a h x => Eq.mp (congrArg K_fib (Nat.eq_zero_of_le_zero h).symm) x)
        (fun b' rec_b' a h x =>
          if h' : a ≤ b' then rec_b' a h' (step b' x)
          else Eq.mp (congrArg K_fib (by omega : b' + 1 = a)) x)
    have h_iter_id : ∀ (a : ℕ) (ha : a ≤ a) (x : K_fib a), iter a a ha x = x := by
      intro a ha x
      cases a with
      | zero => rfl
      | succ a' =>
        change (if h' : a' + 1 ≤ a' then iter a' (a' + 1) h' (step a' x) else x) = x
        have hnot : ¬ (a' + 1 ≤ a') := Nat.not_succ_le_self a'
        simp only [hnot, ↓reduceDIte]
    have h_iter_comp : ∀ (c a b : ℕ) (hab : a ≤ b) (hbc : b ≤ c) (x : K_fib c),
        iter c a (le_trans hab hbc) x = iter b a hab (iter c b hbc x) := by
      intro c
      induction c with
      | zero =>
        intro a b hab hbc x
        have hb : b = 0 := Nat.eq_zero_of_le_zero hbc
        subst hb
        have ha : a = 0 := Nat.eq_zero_of_le_zero hab
        subst ha
        rfl
      | succ c' ih =>
        intro a b hab hbc x
        by_cases hbc' : b ≤ c'
        · have hac' : a ≤ c' := le_trans hab hbc'
          change (if h' : a ≤ c' then iter c' a h' (step c' x) else _) =
            iter b a hab (if h' : b ≤ c' then iter c' b h' (step c' x) else _)
          simp only [hac', hbc', ↓reduceDIte]
          exact ih a b hab hbc' (step c' x)
        · have hb_eq : b = c' + 1 := by omega
          subst hb_eq
          rw [h_iter_id (c' + 1) hbc x]
    let F_inv : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      { obj := fun n => K_fib (Opposite.unop n)
        map := fun {n₁ n₂} f => TypeCat.ofHom (iter (Opposite.unop n₁) (Opposite.unop n₂) (CategoryTheory.leOfHom f.unop))
        map_id := fun n =>
          congrArg TypeCat.ofHom (funext fun x => h_iter_id (Opposite.unop n) _ x)
        map_comp := fun {n₁ n₂ n₃} f g =>
          congrArg TypeCat.ofHom (funext fun x =>
            h_iter_comp (Opposite.unop n₁) (Opposite.unop n₃) (Opposite.unop n₂)
              (CategoryTheory.leOfHom g.unop) (CategoryTheory.leOfHom f.unop) x) }
    have : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := fun j => by
      have := hFin₁ (Opposite.unop j)
      exact Subtype.finite
    have : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := fun j => by
      obtain ⟨x_j, hx_j⟩ := hq_surj (Opposite.unop j) (y.1 (Opposite.unop j))
      exact ⟨⟨x_j, hx_j⟩⟩
    obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system F_inv
    refine ⟨⟨fun r => (sec (Opposite.op r)).1, (hsys₁ _).mpr fun r => ?_⟩, ?_⟩
    · have hstep := hsec (CategoryTheory.homOfLE (Nat.le_succ r)).op
      have h1 : (F_inv.map (CategoryTheory.homOfLE (Nat.le_succ r)).op) (sec (Opposite.op (r + 1))) =
          step r (sec (Opposite.op (r + 1))) := by
        change (if h' : r ≤ r then iter r r h' (step r (sec (Opposite.op (r + 1)))) else _) = _
        have hrr : r ≤ r := le_refl r
        simp only [hrr, ↓reduceDIte]
        exact h_iter_id r hrr _
      rw [h1] at hstep
      exact congrArg Subtype.val hstep
    · apply Subtype.ext
      ext r
      exact (sec (Opposite.op r)).2

  let Q_rat : TensorProduct ℤ ℚ ↥sys₁ →ₗ[ℤ] TensorProduct ℤ ℚ ↥sys₂ :=
    LinearMap.lTensor ℚ q_sys.toIntLinearMap
  have hQ_surj : Function.Surjective Q_rat :=
    LinearMap.lTensor_surjective ℚ hq_sys_surj
  let π₀ : V₁ →+ V₂ :=
    equiv₂.toAddMonoidHom.comp (Q_rat.toAddMonoidHom.comp equiv₁.symm.toAddMonoidHom)
  have hπ₀_surj : Function.Surjective π₀ :=
    equiv₂.surjective.comp (hQ_surj.comp equiv₁.symm.surjective)
  have hπ₀_tmul : ∀ (a : ℚ) (x : ↥sys₁),
      π₀ (equiv₁ (TensorProduct.tmul ℤ a x)) = equiv₂ (TensorProduct.tmul ℤ a (q_sys x)) := by
    intro a x
    change equiv₂ (Q_rat (equiv₁.symm (equiv₁ (TensorProduct.tmul ℤ a x)))) = _
    rw [AddEquiv.symm_apply_apply]
    exact congrArg equiv₂ (LinearMap.lTensor_tmul ℚ q_sys.toIntLinearMap a x)

  have hRatSmul : ∀ {S W : Type u} [AddCommGroup S] [AddCommGroup W] [Module (Padic ℓ) W]
      (E : TensorProduct ℤ ℚ S ≃+ W) (a : ℚ) (s : S),
      E (TensorProduct.tmul ℤ a s) = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
    intro S W _ _ _ E a s
    let m : ℤ := a.num
    let d : ℕ := a.den
    have hd_pos : 0 < d := a.pos
    have hd_ne_K : (d : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
    have hda : (d : ℚ) * a = (m : ℚ) := by
      dsimp [d, m]
      rw [mul_comm]
      exact Rat.mul_den_eq_num a
    have h_tens : d • (TensorProduct.tmul ℤ a s) = m • (TensorProduct.tmul ℤ (1 : ℚ) s) := by
      calc d • (TensorProduct.tmul ℤ a s)
          = (d : ℤ) • (TensorProduct.tmul ℤ a s) := (natCast_zsmul _ _).symm
        _ = TensorProduct.tmul ℤ ((d : ℤ) • a) s := (TensorProduct.smul_tmul' (d : ℤ) a s).symm
        _ = TensorProduct.tmul ℤ ((d : ℚ) * a) s := by rw [zsmul_eq_mul, Int.cast_natCast]
        _ = TensorProduct.tmul ℤ (m • (1 : ℚ)) s := by rw [hda, zsmul_eq_mul, mul_one]
        _ = m • TensorProduct.tmul ℤ (1 : ℚ) s := TensorProduct.smul_tmul' m (1 : ℚ) s
    have hE_eq : d • E (TensorProduct.tmul ℤ a s) = m • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
      rw [← map_nsmul, ← map_zsmul, h_tens]
    have hK_lhs : d • E (TensorProduct.tmul ℤ a s) = (d : Padic ℓ) • E (TensorProduct.tmul ℤ a s) :=
      (Nat.cast_smul_eq_nsmul (Padic ℓ) d _).symm
    have hK_rhs : m • E (TensorProduct.tmul ℤ (1 : ℚ) s) =
        (d : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) := by
      rw [← Int.cast_smul_eq_zsmul (Padic ℓ) m, ← mul_smul]
      congr 1
      have hda_K := congrArg (Rat.cast : ℚ → Padic ℓ) hda
      push_cast at hda_K
      exact hda_K.symm
    rw [hK_lhs, hK_rhs] at hE_eq
    calc E (TensorProduct.tmul ℤ a s)
        = ((d : Padic ℓ)⁻¹ * (d : Padic ℓ)) • E (TensorProduct.tmul ℤ a s) := by
            rw [inv_mul_cancel₀ hd_ne_K, one_smul]
      _ = (d : Padic ℓ)⁻¹ • ((d : Padic ℓ) • E (TensorProduct.tmul ℤ a s)) :=
            mul_smul _ _ _
      _ = (d : Padic ℓ)⁻¹ • ((d : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s))) := by
            rw [hE_eq]
      _ = ((d : Padic ℓ)⁻¹ * (d : Padic ℓ)) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) :=
            (mul_smul _ _ _).symm
      _ = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
            rw [inv_mul_cancel₀ hd_ne_K, one_smul]

  have hMod_nsmul : ∀ {A : Type u} [AddCommGroup A] {N : ℕ} (w : A),
      N • w = 0 → ∀ k : ℕ, (k % N) • w = k • w := by
    intro A _ N w hNw k
    conv_rhs => rw [← Nat.div_add_mod k N]
    rw [add_nsmul, mul_comm N (k / N), mul_nsmul', hNw, smul_zero, zero_add]

  have hz_mem₁ : ∀ (z : PadicInt ℓ) (x : ↥sys₁),
      (fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r) ∈ sys₁ := by
    intro z x
    rw [hsys₁]
    intro r
    rw [map_nsmul, (hsys₁ x.1).mp x.2 r]
    have hcast : PadicInt.toZModPow (r + 1) z =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          (PadicInt.toZModPow (r + 2) z) :=
      (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2)
        (Nat.le_succ (r + 1))) z).symm
    have hcast_val : (PadicInt.toZModPow (r + 1) z).val =
        (PadicInt.toZModPow (r + 2) z).val % (ℓ ^ (r + 1)) := by
      rw [hcast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
    rw [hcast_val, hMod_nsmul (x.1 r) (hTors₁ r (x.1 r))]

  have hπ₀_smul : ∀ (c : Padic ℓ) (v : V₁), π₀ (c • v) = c • π₀ v := by
    intro c v
    have h_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h_gt1
    have hnorm_le : ‖(ℓ : Padic ℓ) ^ k * c‖ ≤ 1 := by
      rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by positivity) k
      rw [inv_mul_le_iff₀ hpos, mul_one]
      exact le_of_lt hk
    let z : PadicInt ℓ := ⟨(ℓ : Padic ℓ) ^ k * c, hnorm_le⟩
    have hz_coe : (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * c := rfl
    have hℓk_ne_K : ((ℓ : Padic ℓ) ^ k) ≠ 0 := pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
    let t : TensorProduct ℤ ℚ ↥sys₁ := equiv₁.symm v
    have hv_eq : v = equiv₁ t := (equiv₁.apply_symm_apply v).symm
    rw [hv_eq]
    refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
      (fun w => π₀ (c • equiv₁ w) = c • π₀ (equiv₁ w)) t ?_ ?_
    · intro a x
      let zx : ↥sys₁ := ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, hz_mem₁ z x⟩
      let q' : ℚ := a * ((ℓ : ℚ) ^ k)⁻¹
      have hq'_z : (q' : Padic ℓ) * (z : Padic ℓ) = c * (a : Padic ℓ) := by
        dsimp [q']
        push_cast
        rw [hz_coe]
        calc (a : Padic ℓ) * ((ℓ : Padic ℓ) ^ k)⁻¹ * ((ℓ : Padic ℓ) ^ k * c)
            = (a : Padic ℓ) * (((ℓ : Padic ℓ) ^ k)⁻¹ * (ℓ : Padic ℓ) ^ k) * c := by ring
          _ = c * (a : Padic ℓ) := by rw [inv_mul_cancel₀ hℓk_ne_K, mul_one, mul_comm]
      have h1 : c • equiv₁ (TensorProduct.tmul ℤ a x) = equiv₁ (TensorProduct.tmul ℤ q' zx) := by
        rw [hRatSmul equiv₁ q' zx,
          hsmul₁ z x zx (fun _ => rfl), ← mul_smul, hq'_z, mul_smul,
          ← hRatSmul equiv₁ a x]
      have h2 : c • equiv₂ (TensorProduct.tmul ℤ a (q_sys x)) =
          equiv₂ (TensorProduct.tmul ℤ q' (q_sys zx)) := by
        have hq_zx : ∀ r : ℕ, (q_sys zx).1 r = (PadicInt.toZModPow (r + 1) z).val • (q_sys x).1 r :=
          fun r => map_nsmul (q r) _ (x.1 r)
        rw [hRatSmul equiv₂ q' (q_sys zx),
          hsmul₂ z (q_sys x) (q_sys zx) hq_zx, ← mul_smul, hq'_z, mul_smul,
          ← hRatSmul equiv₂ a (q_sys x)]
      rw [h1, hπ₀_tmul, hπ₀_tmul, h2]
    · intro w₁ w₂ ih₁ ih₂
      rw [map_add, smul_add, map_add, ih₁, ih₂, map_add, smul_add]

  let π : V₁ →ₗ[Padic ℓ] V₂ :=
    { toFun := π₀
      map_add' := π₀.map_add
      map_smul' := hπ₀_smul }

  refine ⟨π, hπ₀_surj, fun v => ?_⟩
  let t : TensorProduct ℤ ℚ ↥sys₁ := equiv₁.symm v
  have hv_eq : v = equiv₁ t := (equiv₁.apply_symm_apply v).symm
  rw [hv_eq]
  refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
    (fun w => π (frob₁ (equiv₁ w)) = frob₂ (π (equiv₁ w))) t ?_ ?_
  · intro a x
    let y₁ : ↥sys₁ := ⟨fun r => f₁ r (x.1 r), (hsys₁ _).mpr fun r => by
      rw [hf₁_τ r (x.1 (r + 1)), (hsys₁ x.1).mp x.2 r]⟩
    have hq_y₁ : ∀ r : ℕ, (q_sys y₁).1 r = f₂ r ((q_sys x).1 r) :=
      fun r => hq_f r (x.1 r)
    rw [hRatSmul equiv₁ a x, map_smul, map_smul, map_smul, map_smul]
    congr 1
    change π₀ (frob₁ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))) =
      frob₂ (π₀ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)))
    rw [hfrob₁ x y₁ (fun _ => rfl), hπ₀_tmul, hπ₀_tmul, hfrob₂ (q_sys x) (q_sys y₁) hq_y₁]
  · intro w₁ w₂ ih₁ ih₂
    rw [map_add, map_add, map_add, ih₁, ih₂, map_add, map_add]

theorem weil_transv_sheaf_model_builder_and_frob_naturality (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    let pr_Y : Quiver.Hom (weilGeomScheme F Y₀) Y₀.left :=
      CategoryTheory.Limits.pullback.fst Y₀.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    (∀ (i : ℕ)
        (ℳ₀ : ℕ → CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u})
        (τ₀ : ∀ r : ℕ, Quiver.Hom (ℳ₀ (r + 1)) (ℳ₀ r))
        (ι_bock : ∀ r : ℕ, Quiver.Hom (ℳ₀ r) (ℳ₀ (r + 1)))
        (ρ_bock : ∀ r : ℕ, Quiver.Hom (ℳ₀ (r + 1)) (ℳ₀ 0)),
      (∀ r : ℕ, (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (ℳ₀ r) = 0) →
      (∀ r : ℕ,
        ∃ h0 : CategoryTheory.CategoryStruct.comp (ι_bock r) (ρ_bock r) = 0,
          (CategoryTheory.ShortComplex.mk (ι_bock r) (ρ_bock r) h0).ShortExact) →
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (ι_bock r) (τ₀ r) =
          ℓ • CategoryTheory.CategoryStruct.id (ℳ₀ r)) →
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (τ₀ r) (ι_bock r) =
          CategoryTheory.CategoryStruct.comp (ι_bock (r + 1)) (τ₀ (r + 1))) →
      ρ_bock 0 = τ₀ 0 →
      (∀ r : ℕ,
        ρ_bock (r + 1) = CategoryTheory.CategoryStruct.comp (τ₀ (r + 1)) (ρ_bock r)) →
      (∀ (hCont_pr : (weilEtaleSitePullback pr_Y).IsContinuous
            Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
          (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
            Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
            hCont_pr).IsRightAdjoint),
        Finite
          (((@CategoryTheory.Functor.sheafPullback _ _ _ _
              (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
              Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
              hCont_pr hAdj_pr).obj (ℳ₀ 0)).H i)) →
      ∃ (M : WeilTransvTriSheafCohomologyModel F Y₀ ℓ i ℳ₀ τ₀),
        (∀ r : ℕ, Finite ((M.ℳ_bar r).H i)) ∧
        ((∀ (hCont_pr : (weilEtaleSitePullback pr_Y).IsContinuous
              Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
            (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
              (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
              Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
              hCont_pr).IsRightAdjoint),
          Subsingleton
