            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_cl.comp ι_Rbar)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_Rs_loc)) ≫ j_chart :=
          (Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((π_cl.comp ι_Rbar).comp p_Rs_loc)) ≫
              j_chart := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = s_bar := by rw [hπs_pRs_loc, hs₀_chart]
    have hKs_range : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs).base ⊆
        (U_bar : Set D_bar.left) := by
      rintro _ ⟨q_K, rfl⟩
      let q₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_RK.comp p_Rs_loc))).base q_K
      have h_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs).base q_K =
          j_chart.base q₀ := by
        have hmor : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) ≫ g_Rs =
