    obtain ⟨iso_ℋ⟩ :=
      weil_dedekind_locConst_global_const_of_basicOpen_const
        B₀ hDomShrink_B₀ b₀ hb₀_ne ℋ hLC_B₀ A_η hOpen_ℋ
    have hPb_π₀_const : WeilIsEtaleSheafPullback π₀ 𝒢₀
        ((CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}).obj A_η) :=
