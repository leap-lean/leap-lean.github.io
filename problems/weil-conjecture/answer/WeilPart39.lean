                ((CategoryTheory.Category.assoc g_σ ι_Y fst_Yg).trans
                  ((congrArg (g_σ ≫ ·) hι_fst).trans
                    ((congrArg (· ≫ (π_fib ≫ y_Y)) hσ_left).trans
                      ((CategoryTheory.Category.assoc _ π_fib y_Y).symm.trans
                        (congrArg (· ≫ y_Y) hT'_cond))))))
          exact hL_proj.trans hR_proj.symm
        · 
          have h_any_snd : ∀ m : Quiver.Hom T'_fib ((weilEtaleSitePullback h_fib).obj W_Y),
              (m.left ≫ CategoryTheory.Limits.pullback.fst W_Y.hom h_fib) ≫
                CategoryTheory.Limits.pullback.snd Y.hom g₀ =
              T'_fib.hom ≫ h_fib := by
            intro m
            have hcond : CategoryTheory.Limits.pullback.fst W_Y.hom h_fib ≫
                CategoryTheory.Limits.pullback.snd Y.hom g₀ =
                CategoryTheory.Limits.pullback.snd W_Y.hom h_fib ≫ h_fib :=
              CategoryTheory.Limits.pullback.condition
            exact (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (m.left ≫ ·) hcond).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ h_fib) (CategoryTheory.MorphismProperty.Over.w m))))
          exact (h_any_snd m_lhs).trans (h_any_snd m_rhs).symm
      · 
        exact (CategoryTheory.MorphismProperty.Over.w m_lhs).trans
          (CategoryTheory.MorphismProperty.Over.w m_rhs).symm

    
    
    let lhs_val := weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q z
    let rhs_val :=
      (CategoryTheory.Abelian.Ext.mk₀ π_M).postcomp
        (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero q)
        (((CategoryTheory.Abelian.Ext.mk₀
            (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
          (pb_fib.obj F_X₀) (Nat.zero_add q)) c')
    have h_lhs_η : η_Ω (((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib)).hom lhs_val) =
        (ℛ_fib.obj.map (Opposite.op u_yY)).hom
          ((γ.hom.app (Opposite.op Y)).hom (η_unit q Y c)) := by
      have h_tnat := hTermNat S_fib hT_fib_Ω hT_fib σ_fib F_fib q z
      exact (congrArg η_Ω h_tnat).trans (hz.trans hNat_γ)
    have h_rhs_η : η_Ω (((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib)).hom rhs_val) =
        (ℛ_fib.obj.map (Opposite.op u_yY)).hom
          ((γ.hom.app (Opposite.op Y)).hom (η_unit q Y c)) := by
      have h1 := h_ext_factor V_Y (B_πfib.map u_yY) (e_fun.inv.app Y)
      have h2 := h_ext_factor T_fib σ_fib l_Y
      have h_inner_eq :
          ((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib)).hom rhs_val =
          ((F_fib.cohomologyPresheaf q).map (Opposite.op (B_πfib.map u_yY))).hom
            ((α_pre.app (Opposite.op (B_ypt.obj Y))).hom step_c) := by
        rw [h_α_app]
        exact h2.trans ((congrArg (fun m =>
          ((CategoryTheory.Abelian.Ext.mk₀
              (weilPolyP1CohomologyRepPullHom h_fib W_Y T'_fib m)).comp c'
            (Nat.zero_add q)).comp (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero q))
          h_mor_eq.symm).trans h1.symm)
      exact (congrArg η_Ω h_inner_eq).trans h_eval_lhs.symm
    have h_eq_on_T' :
        ((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib)).hom lhs_val =
        ((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib)).hom rhs_val :=
      hSpecUnitInj P_fib (h_lhs_η.trans h_rhs_η.symm)
    let τ_fib : Quiver.Hom T_fib T'_fib := hT_fib_Ω.from T_fib
    have hτσ : τ_fib ≫ σ_fib = CategoryTheory.CategoryStruct.id T_fib :=
      hT_fib.hom_ext _ _
    have h_retract_map :
        (F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib) ≫
          (F_fib.cohomologyPresheaf q).map (Opposite.op τ_fib) =
        CategoryTheory.CategoryStruct.id
          ((F_fib.cohomologyPresheaf q).obj (Opposite.op T_fib)) :=
      ((F_fib.cohomologyPresheaf q).map_comp (Opposite.op σ_fib) (Opposite.op τ_fib)).symm.trans
        ((congrArg (fun m => (F_fib.cohomologyPresheaf q).map (Opposite.op m)) hτσ).trans
          ((congrArg (F_fib.cohomologyPresheaf q).map CategoryTheory.op_id).trans
            ((F_fib.cohomologyPresheaf q).map_id _)))
    have h_cancel_σ : ∀ x y : ↑((F_fib.cohomologyPresheaf q).obj (Opposite.op T_fib)),
        ((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib)).hom x =
          ((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib)).hom y →
        x = y := by
      intro x y hxy
      have h1 : (((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib) ≫
          (F_fib.cohomologyPresheaf q).map (Opposite.op τ_fib)).hom) x =
        (((F_fib.cohomologyPresheaf q).map (Opposite.op σ_fib) ≫
          (F_fib.cohomologyPresheaf q).map (Opposite.op τ_fib)).hom) y :=
        congrArg ((F_fib.cohomologyPresheaf q).map (Opposite.op τ_fib)).hom hxy
      exact (CategoryTheory.ConcreteCategory.congr_hom h_retract_map x).symm.trans
        (h1.trans (CategoryTheory.ConcreteCategory.congr_hom h_retract_map y))
    exact h_cancel_σ lhs_val rhs_val h_eq_on_T'

theorem weil_mid_dev_raw_fib_pullback_intertwine_of_endomorphism {X₀ S_fib : AlgebraicGeometry.Scheme.{u}}
    (h_fib : S_fib ⟶ X₀)
    (Φ : S_fib ⟶ S_fib)
    (_hΦ : Φ ≫ h_fib = h_fib)
    (d_fib : WeilEtaleSitePullbackData S_fib X₀ h_fib)
    (m₀ q : ℕ)
    (W : X₀.Etale)
    (l₀ l₁ : Quiver.Hom (weilEtaleIdTerminal.{u} S_fib)
      ((weilEtaleSitePullback h_fib).obj W))
    (c : ↑((CategoryTheory.Sheaf.cohomologyPresheaf
      (weilEtaleTorsionSheaf X₀ m₀) q).obj (Opposite.op W)))
    (z₀ z₁ : weilEtaleTorsionH S_fib m₀ q)
    (p_Φ : weilEtaleTorsionH S_fib m₀ q →+ weilEtaleTorsionH S_fib m₀ q) :
    letI := d_fib.hCont
    letI := d_fib.hAdj
    letI := d_fib.hAdd_pb
    letI := d_fib.hLim_pb
    letI := d_fib.hColim_pb
    let T_fib := weilEtaleIdTerminal.{u} S_fib
    let hT_fib := weilEtaleIdTerminalIsTerminal.{u} S_fib
    let hT_X₀ := weilEtaleIdTerminalIsTerminal.{u} X₀
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let F_X₀ := weilEtaleTorsionSheaf X₀ m₀
    let F_fib := weilEtaleTorsionSheaf S_fib m₀
    let pb_fib := (weilEtaleSitePullback h_fib).sheafPullback
      AddCommGrpCat.{u} X₀.smallEtaleTopology S_fib.smallEtaleTopology
    let Ψ_pull : Quiver.Hom T_fib ((weilEtaleSitePullback h_fib).obj W) →
        ↑((CategoryTheory.Sheaf.cohomologyPresheaf F_X₀ q).obj (Opposite.op W)) →+
          ↑((CategoryTheory.Sheaf.cohomologyPresheaf F_fib q).obj (Opposite.op T_fib)) :=
      fun l =>
        ((CategoryTheory.Abelian.Ext.mk₀
            (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
          (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero q)).comp
          (((CategoryTheory.Abelian.Ext.mk₀
              (weilPolyP1CohomologyRepPullHom h_fib W T_fib l)).precomp
            (pb_fib.obj F_X₀) (Nat.zero_add q)).comp
            (pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W) F_X₀ q))
    WeilIsTorsionEtalePullback Φ m₀ q p_Φ →
    ((AlgebraicGeometry.Scheme.Etale.forget S_fib).map l₀).left ≫
        CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj W).hom h_fib =
      Φ ≫ ((AlgebraicGeometry.Scheme.Etale.forget S_fib).map l₁).left ≫
        CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj W).hom h_fib →
    weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q z₀ = Ψ_pull l₀ c →
    weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q z₁ = Ψ_pull l₁ c →
    p_Φ z₁ = z₀ :=
by
  intro T_fib hT_fib hT_X₀ AM F_X₀ F_fib pb_fib Ψ_pull hp_Φ hl_rel hz₀ hz₁
  have := d_fib.hCont
  have := d_fib.hAdj
  have := d_fib.hAdd_pb
  have := d_fib.hLim_pb
  have := d_fib.hColim_pb

  
  have hExtCompNatIso :
      ∀ {C_ab D_ab E_ab : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} C_ab] [CategoryTheory.Abelian C_ab]
        [CategoryTheory.HasExt.{u} C_ab] [CategoryTheory.EnoughInjectives C_ab]
        [CategoryTheory.Category.{u + 1, u + 1} D_ab] [CategoryTheory.Abelian D_ab]
        [CategoryTheory.HasExt.{u} D_ab]
        [CategoryTheory.Category.{u + 1, u + 1} E_ab] [CategoryTheory.Abelian E_ab]
        [CategoryTheory.HasExt.{u} E_ab]
        (F : CategoryTheory.Functor C_ab D_ab)
        [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
        [CategoryTheory.Limits.PreservesFiniteColimits F]
        (G : CategoryTheory.Functor D_ab E_ab)
        [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        (H : CategoryTheory.Functor C_ab E_ab)
        [H.Additive] [CategoryTheory.Limits.PreservesFiniteLimits H]
        [CategoryTheory.Limits.PreservesFiniteColimits H]
        (η : CategoryTheory.Iso (F.comp G) H) (n : ℕ) (X Y : C_ab)
        (x : CategoryTheory.Abelian.Ext.{u} X Y n),
        (G.mapExtAddHom (F.obj X) (F.obj Y) n) ((F.mapExtAddHom X Y n) x) =
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
            (((H.mapExtAddHom X Y n) x).comp
              (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero n))
            (Nat.zero_add n) := by
    intro C_ab D_ab E_ab _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ H _ _ _ η
    have hNat : ∀ (n : ℕ) (A B : C_ab) (e : CategoryTheory.Abelian.Ext.{u} A B n),
        (CategoryTheory.Abelian.Ext.mapExactFunctor G
            (CategoryTheory.Abelian.Ext.mapExactFunctor F e)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero n) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app A)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor H e) (Nat.zero_add n) := by
      intro n
      induction n with
      | zero =>
        intro A B e
        let f : A ⟶ B := CategoryTheory.Abelian.Ext.addEquiv₀ e
        have hf : e = CategoryTheory.Abelian.Ext.mk₀ f :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply e).symm
        rw [hf,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ F f,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ G (F.map f),
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ H f,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        exact congrArg CategoryTheory.Abelian.Ext.mk₀ (η.hom.naturality f)
      | succ k ih =>
        intro A B e
        let I : C_ab := CategoryTheory.Injective.under B
        let ι : B ⟶ I := CategoryTheory.Injective.ι B
        let Q : C_ab := CategoryTheory.Limits.cokernel ι
        let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
        let S_c : CategoryTheory.ShortComplex C_ab :=
          CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
        have hEx : S_c.Exact :=
          CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_c
            (CategoryTheory.Limits.cokernelIsCokernel ι)
        have hS : S_c.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk' hEx
            (inferInstance : CategoryTheory.Mono ι)
            (inferInstance : CategoryTheory.Epi π)
        have hZero : e.comp (CategoryTheory.Abelian.Ext.mk₀ S_c.f) (Nat.add_zero (k + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, hz⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS e hZero (rfl : k + 1 = k + 1)
        have hS_F : (S_c.map F).ShortExact := hS.map_of_exact F
        have hS_FG : ((S_c.map F).map G).ShortExact := hS_F.map_of_exact G
        have hS_H : (S_c.map H).ShortExact := hS.map_of_exact H
        let τ : (S_c.map F).map G ⟶ S_c.map H := S_c.mapNatTrans η.hom
        have hExtNat :
            hS_FG.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero 1) =
              (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Q)).comp hS_H.extClass (Nat.zero_add 1) :=
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_FG hS_H τ
        rw [← hz,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp F z hS.extClass rfl,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp G _ hS_F.extClass rfl,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hS_F,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp H z hS.extClass rfl,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass H hS,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ hS_FG.extClass
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) rfl,
          hExtNat,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Q)) hS_H.extClass rfl,
          ih A Q z,
          CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app A))
            (CategoryTheory.Abelian.Ext.mapExactFunctor H z) hS_H.extClass
            (Nat.zero_add k) rfl (congrArg (· + 1) (Nat.zero_add k))]
    intro n X Y x
    rw [CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Functor.mapExtAddHom_apply]
    let u := CategoryTheory.Abelian.Ext.mapExactFunctor G
      (CategoryTheory.Abelian.Ext.mapExactFunctor F x)
    have hid : CategoryTheory.CategoryStruct.id (G.obj (F.obj Y)) =
        η.hom.app Y ≫ η.inv.app Y := (η.hom_inv_id_app Y).symm
    calc
      u = u.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id _))
            (Nat.add_zero n) := (CategoryTheory.Abelian.Ext.comp_mk₀_id u).symm
      _ = u.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y ≫ η.inv.app Y))
            (Nat.add_zero n) := by rw [hid]
      _ = u.comp ((CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero 0))
            (Nat.add_zero n) := by rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = (u.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero n)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero n) :=
          (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero u
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y))
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero n)).symm
      _ = ((CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor H x) (Nat.zero_add n)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero n) := by
          rw [hNat n X Y x]
      _ = (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
            ((CategoryTheory.Abelian.Ext.mapExactFunctor H x).comp
              (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero n))
            (Nat.zero_add n) :=
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X))
            (CategoryTheory.Abelian.Ext.mapExactFunctor H x)
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.zero_add n)

  
  have hRepRight :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
        {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (α : Quiver.Hom (weilPolyP1CohomologyRepSheaf Z V) G₁)
        (φ : Quiver.Hom G₁ G₂),
        weilPolyP1CohomologyRepHomEquiv Z V G₂ (α ≫ φ) =
          (φ.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V G₁ α) := by
    intro Z V G₁ G₂ α φ
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let P_V := CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
    let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    have h1 : adj_sh.homEquiv P_V G₂ (α ≫ φ) =
        adj_sh.homEquiv P_V G₁ α ≫ φ.hom :=
      adj_sh.homEquiv_naturality_right α φ
    have h2 : adj_fr.homEquiv (CategoryTheory.yoneda.obj V) G₂.obj
        (adj_sh.homEquiv P_V G₁ α ≫ φ.hom) =
        adj_fr.homEquiv (CategoryTheory.yoneda.obj V) G₁.obj (adj_sh.homEquiv P_V G₁ α) ≫
          ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale)
            AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})).map φ.hom :=
      adj_fr.homEquiv_naturality_right (adj_sh.homEquiv P_V G₁ α) φ.hom
    change CategoryTheory.yonedaEquiv
      (adj_fr.homEquiv (CategoryTheory.yoneda.obj V) G₂.obj (adj_sh.homEquiv P_V G₂ (α ≫ φ))) = _
    rw [h1, h2, CategoryTheory.yonedaEquiv_comp]
    rfl

  
  have hRepInvAndPull :
      ∀ (S : AlgebraicGeometry.Scheme.{u}),
        let T := weilEtaleIdTerminal.{u} S
        let hT := weilEtaleIdTerminalIsTerminal.{u} S
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        let C_S := CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
        let R_T := weilPolyP1CohomologyRepSheaf S T
        let r_S := weilPolyP1CohomologyRepToConst S T hT
        (∃ β_S : Quiver.Hom (C_S.obj Aℤ) R_T,
          r_S ≫ β_S = CategoryTheory.CategoryStruct.id R_T ∧
          β_S ≫ r_S = CategoryTheory.CategoryStruct.id (C_S.obj Aℤ)) ∧
        (∀ (Φ_S : S ⟶ S)
          [hc_Φ : (weilEtaleSitePullback Φ_S).IsContinuous
            S.smallEtaleTopology S.smallEtaleTopology]
          [hr_Φ : ((weilEtaleSitePullback Φ_S).sheafPushforwardContinuous
            AddCommGrpCat.{u} S.smallEtaleTopology S.smallEtaleTopology).IsRightAdjoint],
          let pb_Φ := (weilEtaleSitePullback Φ_S).sheafPullback
            AddCommGrpCat.{u} S.smallEtaleTopology S.smallEtaleTopology
          ∃ u_Φ : Quiver.Hom T ((weilEtaleSitePullback Φ_S).obj T),
            ((AlgebraicGeometry.Scheme.Etale.forget S).map u_Φ).left ≫
                CategoryTheory.Limits.pullback.fst
                  ((AlgebraicGeometry.Scheme.Etale.forget S).obj T).hom Φ_S = Φ_S ∧
            ∀ (β_S : Quiver.Hom (C_S.obj Aℤ) R_T)
              (ιℤ : Quiver.Hom (C_S.obj Aℤ) (pb_Φ.obj (C_S.obj Aℤ))),
              r_S ≫ β_S = CategoryTheory.CategoryStruct.id R_T →
              weilEtaleConstPullbackHom Φ_S hT hT Aℤ ≫ ιℤ =
                CategoryTheory.CategoryStruct.id (pb_Φ.obj (C_S.obj Aℤ)) →
              r_S ≫ ιℤ ≫ pb_Φ.map β_S = weilPolyP1CohomologyRepPullHom Φ_S T T u_Φ) := by
    intro S T hT Aℤ C_S R_T r_S
    let J := S.smallEtaleTopology
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let evℤ : ∀ M : AddCommGrpCat.{u}, (Aℤ ⟶ M) ≃ ↑M := fun M =>
      { toFun := fun f => f.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun x y => add_zsmul m x.down y.down }
        left_inv := fun f => AddCommGrpCat.ext fun z => by
          change z.down • f.hom (ULift.up (1 : ℤ)) = f.hom z
          have hz_eq : z.down • (ULift.up (1 : ℤ) : Aℤ) = z :=
            ULift.ext _ _ (mul_one z.down)
          exact (map_zsmul f.hom z.down (ULift.up (1 : ℤ))).symm.trans (congrArg f.hom hz_eq)
        right_inv := fun m => one_zsmul m }
    have hr_S_val : weilPolyP1CohomologyRepHomEquiv S T (C_S.obj Aℤ) r_S =
        (adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
      (weilPolyP1CohomologyRepHomEquiv S T (C_S.obj Aℤ)).apply_symm_apply _
    have hPrecompEquiv : ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u})
