                      (CategoryTheory.Category.assoc (c_τ₀ ≫ d_δ) p_fst₁ p_snd₂).symm)))))
      · exact hsnd_eq

    have hα_unit : adj_yU.unit.app ℱ ≫ pf_yU.map α_comp = u_comp :=
      (adj_yU.homEquiv_unit ℱ ℋ α_comp).symm.trans
        ((adj_yU.homEquiv ℱ ℋ).apply_symm_apply u_comp)
    have h_sec_eq :
        ((adj_yU.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_yU.obj ℱ).obj.map (Opposite.op u_y)) ≫
          α_comp.hom.app (Opposite.op T_Ω) =
        ((adj_π.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_π.obj ℱ).obj.map (Opposite.op δ_π)) ≫
          (adj_yV.unit.app (pb_π.obj ℱ)).hom.app (Opposite.op T_V) ≫
          ℋ.obj.map (Opposite.op τ₀) := by
      let m_yU := (adj_yU.unit.app ℱ).hom.app (Opposite.op E_π)
      let m_uy := (pb_yU.obj ℱ).obj.map (Opposite.op u_y)
      let m_α_E := α_comp.hom.app (Opposite.op (B_yU.obj E_π))
      let m_α_T := α_comp.hom.app (Opposite.op T_Ω)
      let m_H_uy := ℋ.obj.map (Opposite.op u_y)
      let m_π := (adj_π.unit.app ℱ).hom.app (Opposite.op E_π)
      let m_δ := (pb_π.obj ℱ).obj.map (Opposite.op δ_π)
      let m_yV_E := (adj_yV.unit.app (pb_π.obj ℱ)).hom.app (Opposite.op (B_π.obj E_π))
      let m_yV_T := (adj_yV.unit.app (pb_π.obj ℱ)).hom.app (Opposite.op T_V)
      let m_epf := (e_pf.hom.app ℋ).hom.app (Opposite.op E_π)
      let m_H_eb := ℋ.obj.map (e_B.inv.app E_π).op
      let m_H_δ := ℋ.obj.map (Opposite.op (B_yV.map δ_π))
      let m_H_τ₀ := ℋ.obj.map (Opposite.op τ₀)
      have happ : (m_yU ≫ m_α_E) ≫ m_H_uy = (m_π ≫ m_yV_E ≫ m_epf) ≫ m_H_uy :=
        congrArg (fun τ => τ.hom.app (Opposite.op E_π) ≫ m_H_uy) hα_unit
      have hnat_α : m_α_E ≫ m_H_uy = m_uy ≫ m_α_T :=
        (α_comp.hom.naturality (Opposite.op u_y)).symm
      have he_pf_app : m_epf = m_H_eb :=
        CategoryTheory.Functor.sheafPushforwardContinuousComp'_hom_app_hom_app
          e_B AddCommGrpCat.{u} J_U J_V J_Ω ℋ (Opposite.op E_π)
      have hmap_sec : m_H_eb ≫ m_H_uy = m_H_δ ≫ m_H_τ₀ :=
        (ℋ.obj.map_comp (e_B.inv.app E_π).op (Opposite.op u_y)).symm.trans
          ((congrArg (fun k => ℋ.obj.map (Opposite.op k)) hu_sec).trans
            (ℋ.obj.map_comp (Opposite.op (B_yV.map δ_π)) (Opposite.op τ₀)))
      have hnat_yV : m_yV_E ≫ m_H_δ = m_δ ≫ m_yV_T :=
        ((adj_yV.unit.app (pb_π.obj ℱ)).hom.naturality (Opposite.op δ_π)).symm
      have step1 : (m_yU ≫ m_uy) ≫ m_α_T = (m_yU ≫ m_α_E) ≫ m_H_uy :=
        (CategoryTheory.Category.assoc m_yU m_uy m_α_T).trans
          ((congrArg (m_yU ≫ ·) hnat_α.symm).trans
            (CategoryTheory.Category.assoc m_yU m_α_E m_H_uy).symm)
      have step2 : (m_π ≫ m_yV_E ≫ m_epf) ≫ m_H_uy =
          m_π ≫ m_yV_E ≫ (m_H_eb ≫ m_H_uy) :=
        (CategoryTheory.Category.assoc m_π (m_yV_E ≫ m_epf) m_H_uy).trans
          (congrArg (m_π ≫ ·)
            ((CategoryTheory.Category.assoc m_yV_E m_epf m_H_uy).trans
              (congrArg (m_yV_E ≫ ·) (congrArg (· ≫ m_H_uy) he_pf_app))))
      have step3 : m_π ≫ m_yV_E ≫ (m_H_eb ≫ m_H_uy) =
          (m_π ≫ m_δ) ≫ m_yV_T ≫ m_H_τ₀ :=
        (congrArg (m_π ≫ m_yV_E ≫ ·) hmap_sec).trans
          ((congrArg (m_π ≫ ·)
            ((CategoryTheory.Category.assoc m_yV_E m_H_δ m_H_τ₀).symm.trans
              ((congrArg (· ≫ m_H_τ₀) hnat_yV).trans
                (CategoryTheory.Category.assoc m_δ m_yV_T m_H_τ₀)))).trans
            (CategoryTheory.Category.assoc m_π m_δ (m_yV_T ≫ m_H_τ₀)).symm)
      exact step1.trans (happ.trans (step2.trans step3))

    let iso_α := @CategoryTheory.asIso _ _ _ _ α_comp hIso_α
    let ev_TΩ := (CategoryTheory.sheafSections J_Ω AddCommGrpCat.{u}).obj (Opposite.op T_Ω)
    have hIso_α_TΩ : CategoryTheory.IsIso (α_comp.hom.app (Opposite.op T_Ω)) :=
      show CategoryTheory.IsIso (ev_TΩ.mapIso iso_α).hom from inferInstance
    have hIso_τ₀_iso_map : CategoryTheory.IsIso (ℋ.obj.map (Opposite.op iso_τ₀.hom)) :=
      show CategoryTheory.IsIso (ℋ.obj.mapIso iso_τ₀.op).hom from inferInstance
    have hIso_τ₀_map : CategoryTheory.IsIso (ℋ.obj.map (Opposite.op τ₀)) :=
      Eq.mp (congrArg (fun f => CategoryTheory.IsIso (ℋ.obj.map (Opposite.op f)))
        hτ₀_eq_iso.symm) hIso_τ₀_iso_map
    have hIso_tail : CategoryTheory.IsIso
        ((adj_yV.unit.app (pb_π.obj ℱ)).hom.app (Opposite.op T_V) ≫
          ℋ.obj.map (Opposite.op τ₀)) :=
      @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_mid hIso_τ₀_map
    have hIso_rhs_tot : CategoryTheory.IsIso
        (((adj_π.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_π.obj ℱ).obj.map (Opposite.op δ_π)) ≫
          (adj_yV.unit.app (pb_π.obj ℱ)).hom.app (Opposite.op T_V) ≫
          ℋ.obj.map (Opposite.op τ₀)) :=
      @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_slice hIso_tail
    have hIso_lhs_tot : CategoryTheory.IsIso
        (((adj_yU.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_yU.obj ℱ).obj.map (Opposite.op u_y)) ≫
          α_comp.hom.app (Opposite.op T_Ω)) :=
      Eq.mp (congrArg CategoryTheory.IsIso h_sec_eq.symm) hIso_rhs_tot
    have hIso_target : CategoryTheory.IsIso
        ((adj_yU.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_yU.obj ℱ).obj.map (Opposite.op u_y)) :=
      @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
        ((adj_yU.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_yU.obj ℱ).obj.map (Opposite.op u_y))
        (α_comp.hom.app (Opposite.op T_Ω)) hIso_α_TΩ hIso_lhs_tot
    have hBij_target : Function.Bijective
        (((adj_yU.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_yU.obj ℱ).obj.map (Opposite.op u_y)).hom) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mp hIso_target
    have hHom_eq :
        ((pb_yU.obj ℱ).obj.map (Opposite.op u_y)).hom.comp
          (((adj_yU.unit.app ℱ).hom.app (Opposite.op E_π)).hom) =
        ((adj_yU.unit.app ℱ).hom.app (Opposite.op E_π) ≫
          (pb_yU.obj ℱ).obj.map (Opposite.op u_y)).hom :=
      AddMonoidHom.ext fun _ => rfl
    exact Eq.mp (congrArg (fun f : _ →+ _ => Function.Bijective ⇑f) hHom_eq.symm) hBij_target

theorem weil_mid_dev_raw_fib_local_presheaf_lift_and_pullback_eq (sys : WeilEtaleSitePullbackSys.{u})
    {X₀ U S_fib : AlgebraicGeometry.Scheme.{u}}
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (g₀ : X₀ ⟶ U)
    (y_pt : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U)
    (π_fib : S_fib ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (h_fib : S_fib ⟶ X₀)
    (h_sq : h_fib ≫ g₀ = π_fib ≫ y_pt)
    (m₀ : ℕ) :
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := weilEtaleIdTerminal.{u} S_Ω
    let T_fib := weilEtaleIdTerminal.{u} S_fib
    let hT_fib := weilEtaleIdTerminalIsTerminal.{u} S_fib
    let hT_X₀ := weilEtaleIdTerminalIsTerminal.{u} X₀
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let F_X₀ := weilEtaleTorsionSheaf X₀ m₀
    let F_fib := weilEtaleTorsionSheaf S_fib m₀
    let P_pre : ℕ → CategoryTheory.Functor (Opposite U.Etale) AddCommGrpCat.{u} :=
      fun q => CategoryTheory.Functor.comp (weilEtaleSitePullback g₀).op
        (CategoryTheory.Sheaf.cohomologyPresheaf F_X₀ q)
    let ℛ_U : ℕ → CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u} :=
      fun q => weilEtaleHigherDirectImage g₀ q F_X₀
    let η_unit : ∀ (q : ℕ) (Y : U.Etale),
        ↑((P_pre q).obj (Opposite.op Y)) →+ ↑((ℛ_U q).obj.obj (Opposite.op Y)) :=
      fun q Y =>
        (((CategoryTheory.sheafificationAdjunction U.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app (P_pre q)).app (Opposite.op Y)).hom
    (∀ q : ℕ,
      Function.Bijective (weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q)) ∧
    (∀ (E_U : U.Etale)
        (y_E : S_Ω ⟶ ((AlgebraicGeometry.Scheme.Etale.forget U).obj E_U).left)
        (q₁ q₂ : ℕ)
        (s₁ : ↑((ℛ_U q₁).obj.obj (Opposite.op E_U)))
        (s₂ : ↑((ℛ_U q₂).obj.obj (Opposite.op E_U))),
      ∃ (Y : U.Etale) (u : Quiver.Hom Y E_U)
        (y_Y : S_Ω ⟶ ((AlgebraicGeometry.Scheme.Etale.forget U).obj Y).left)
        (c₁ : ↑((P_pre q₁).obj (Opposite.op Y)))
        (c₂ : ↑((P_pre q₂).obj (Opposite.op Y))),
        y_Y ≫ ((AlgebraicGeometry.Scheme.Etale.forget U).map u).left = y_E ∧
        η_unit q₁ Y c₁ = ((ℛ_U q₁).obj.map (Opposite.op u)).hom s₁ ∧
        η_unit q₂ Y c₂ = ((ℛ_U q₂).obj.map (Opposite.op u)).hom s₂) ∧
    (∀ (E_U : U.Etale)
        (y_E : S_Ω ⟶ ((AlgebraicGeometry.Scheme.Etale.forget U).obj E_U).left)
        (_hy_E : y_E ≫ ((AlgebraicGeometry.Scheme.Etale.forget U).obj E_U).hom = y_pt)
        (u_yE : Quiver.Hom T_Ω ((weilEtaleSitePullback y_pt).obj E_U))
        (_hu_yE : ((AlgebraicGeometry.Scheme.Etale.forget S_Ω).map u_yE).left ≫
          CategoryTheory.Limits.pullback.fst
            ((AlgebraicGeometry.Scheme.Etale.forget U).obj E_U).hom y_pt = y_E)
        (Y : U.Etale) (u : Quiver.Hom Y E_U)
        (y_Y : S_Ω ⟶ ((AlgebraicGeometry.Scheme.Etale.forget U).obj Y).left)
        (_hy_Y : y_Y ≫ ((AlgebraicGeometry.Scheme.Etale.forget U).map u).left = y_E)
        (l_Y : Quiver.Hom T_fib
          ((weilEtaleSitePullback h_fib).obj ((weilEtaleSitePullback g₀).obj Y))),
      let W_Y := (weilEtaleSitePullback g₀).obj Y
      let ι_Y := ((AlgebraicGeometry.Scheme.Etale.forget S_fib).map l_Y).left ≫
        CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget X₀).obj W_Y).hom h_fib
      (ι_Y ≫ CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget U).obj Y).hom g₀ = π_fib ≫ y_Y ∧
        ι_Y ≫ CategoryTheory.Limits.pullback.snd
          ((AlgebraicGeometry.Scheme.Etale.forget U).obj Y).hom g₀ = h_fib) →
      ∀ (q : ℕ)
        (hT_fib_Ω : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback π_fib).obj T_Ω))
        {γ},
        (letI := (sys y_pt).hCont
         letI := (sys h_fib).hCont
         letI := (sys h_fib).hAdj
         letI := (sys h_fib).hAdd_pb
         letI := (sys h_fib).hLim_pb
         letI := (sys h_fib).hColim_pb
         WeilIsSingDevAlgBCConstPush g₀ y_pt π_fib h_fib h_sq AM q γ) →
        ∀ (s : ↑((ℛ_U q).obj.obj (Opposite.op E_U)))
          (c : ↑((P_pre q).obj (Opposite.op Y)))
          (_hc : η_unit q Y c = ((ℛ_U q).obj.map (Opposite.op u)).hom s)
          (z : weilEtaleTorsionH S_fib m₀ q),
          (letI := (sys y_pt).hCont
           weilOuterTrFibEdgeHom π_fib T_Ω hT_fib_Ω F_fib q z =
             ((weilEtaleHigherDirectImage π_fib q F_fib).obj.map (Opposite.op u_yE)).hom
               ((γ.hom.app (Opposite.op E_U)).hom s)) →
          letI := (sys h_fib).hCont
          letI := (sys h_fib).hAdj
          letI := (sys h_fib).hAdd_pb
          letI := (sys h_fib).hLim_pb
          letI := (sys h_fib).hColim_pb
          let pb_fib := (weilEtaleSitePullback h_fib).sheafPullback
            AddCommGrpCat.{u} X₀.smallEtaleTopology S_fib.smallEtaleTopology
          weilPolyP1CohomologyTermToPresheaf S_fib T_fib hT_fib F_fib q z =
            (CategoryTheory.Abelian.Ext.mk₀
                (weilEtaleConstPullbackHom h_fib hT_fib hT_X₀ AM)).postcomp
              (weilPolyP1CohomologyRepSheaf S_fib T_fib) (Nat.add_zero q)
              (((CategoryTheory.Abelian.Ext.mk₀
                  (weilPolyP1CohomologyRepPullHom h_fib W_Y T_fib l_Y)).precomp
                (pb_fib.obj F_X₀) (Nat.zero_add q))
                ((pb_fib.mapExtAddHom (weilPolyP1CohomologyRepSheaf X₀ W_Y) F_X₀ q) c))) :=
by
  intro S_Ω T_Ω T_fib hT_fib hT_X₀ AM F_X₀ F_fib P_pre ℛ_U η_unit
  have _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  
  
  let repMap : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : Z.Etale},
      Quiver.Hom V₁ V₂ →
      Quiver.Hom (weilPolyP1CohomologyRepSheaf Z V₁) (weilPolyP1CohomologyRepSheaf Z V₂) :=
    fun Z {_ _} v =>
      (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v) AddCommGrpCat.free)

  have hRepNatRight : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
      {G G' : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ : Quiver.Hom (weilPolyP1CohomologyRepSheaf Z V) G)
      (φ : Quiver.Hom G G'),
      weilPolyP1CohomologyRepHomEquiv Z V G' (ψ ≫ φ) =
        (φ.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V G ψ) := by
    intro Z V G G' ψ φ
    let adj1 := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let adj2 := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let P_V := CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
    have h1 : adj1.homEquiv P_V G' (ψ ≫ φ) = adj1.homEquiv P_V G ψ ≫ φ.hom :=
      adj1.homEquiv_naturality_right ψ φ
    have h2 : adj2.homEquiv (CategoryTheory.yoneda.obj V) G'.obj (adj1.homEquiv P_V G ψ ≫ φ.hom) =
        adj2.homEquiv (CategoryTheory.yoneda.obj V) G.obj (adj1.homEquiv P_V G ψ) ≫
          CategoryTheory.Functor.whiskerRight φ.hom (CategoryTheory.forget AddCommGrpCat.{u}) :=
      adj2.homEquiv_naturality_right (adj1.homEquiv P_V G ψ) φ.hom
    exact congrArg CategoryTheory.yonedaEquiv
      ((congrArg (adj2.homEquiv (CategoryTheory.yoneda.obj V) G'.obj) h1).trans h2)

  have hRepNatLeft : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : Z.Etale}
      (v : Quiver.Hom V₁ V₂)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (ψ : Quiver.Hom (weilPolyP1CohomologyRepSheaf Z V₂) G),
      weilPolyP1CohomologyRepHomEquiv Z V₁ G (repMap Z v ≫ ψ) =
        (G.obj.map (Opposite.op v)).hom (weilPolyP1CohomologyRepHomEquiv Z V₂ G ψ) := by
    intro Z V₁ V₂ v G ψ
    let adj1 := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let adj2 := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let fv := CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v) AddCommGrpCat.free
    have h1 : adj1.homEquiv _ G (repMap Z v ≫ ψ) = fv ≫ adj1.homEquiv _ G ψ :=
      adj1.homEquiv_naturality_left fv ψ
    have h2 : adj2.homEquiv (CategoryTheory.yoneda.obj V₁) G.obj (fv ≫ adj1.homEquiv _ G ψ) =
        CategoryTheory.yoneda.map v ≫
          adj2.homEquiv (CategoryTheory.yoneda.obj V₂) G.obj (adj1.homEquiv _ G ψ) :=
      adj2.homEquiv_naturality_left (CategoryTheory.yoneda.map v) (adj1.homEquiv _ G ψ)
    exact (congrArg CategoryTheory.yonedaEquiv
      ((congrArg (adj2.homEquiv (CategoryTheory.yoneda.obj V₁) G.obj) h1).trans h2)).trans
      (CategoryTheory.yonedaEquiv_naturality
        (adj2.homEquiv (CategoryTheory.yoneda.obj V₂) G.obj (adj1.homEquiv _ G ψ)) v).symm

  have hRepPullComp : ∀ {W_top Y₀ : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom W_top Y₀)
      [_hc_g : (weilEtaleSitePullback g).IsContinuous Y₀.smallEtaleTopology W_top.smallEtaleTopology]
      [_hr_g : ((weilEtaleSitePullback g).sheafPushforwardContinuous
        AddCommGrpCat.{u} Y₀.smallEtaleTopology W_top.smallEtaleTopology).IsRightAdjoint]
      (U_Y : Y₀.Etale) {V₁ V₂ : W_top.Etale}
      (v : Quiver.Hom V₁ V₂)
      (u₀ : Quiver.Hom V₂ ((weilEtaleSitePullback g).obj U_Y)),
      repMap W_top v ≫ weilPolyP1CohomologyRepPullHom g U_Y V₂ u₀ =
        weilPolyP1CohomologyRepPullHom g U_Y V₁ (v ≫ u₀) := by
    intro W_top Y₀ g _hc_g _hr_g U_Y V₁ V₂ v u₀
    let R_Y := weilPolyP1CohomologyRepSheaf Y₀ U_Y
    let pb_g := (weilEtaleSitePullback g).sheafPullback
      AddCommGrpCat.{u} Y₀.smallEtaleTopology W_top.smallEtaleTopology
    let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous
      AddCommGrpCat.{u} Y₀.smallEtaleTopology W_top.smallEtaleTopology
    let ι_Y := weilPolyP1CohomologyRepHomEquiv Y₀ U_Y R_Y (CategoryTheory.CategoryStruct.id R_Y)
    let s_pull := ((adj_g.unit.app R_Y).hom.app (Opposite.op U_Y)).hom ι_Y
    apply (weilPolyP1CohomologyRepHomEquiv W_top V₁ (pb_g.obj R_Y)).injective
    rw [hRepNatLeft]
    change ((pb_g.obj R_Y).obj.map (Opposite.op v)).hom
        ((weilPolyP1CohomologyRepHomEquiv W_top V₂ (pb_g.obj R_Y))
          ((weilPolyP1CohomologyRepHomEquiv W_top V₂ (pb_g.obj R_Y)).symm
            (((pb_g.obj R_Y).obj.map (Opposite.op u₀)).hom s_pull))) =
      (weilPolyP1CohomologyRepHomEquiv W_top V₁ (pb_g.obj R_Y))
        ((weilPolyP1CohomologyRepHomEquiv W_top V₁ (pb_g.obj R_Y)).symm
          (((pb_g.obj R_Y).obj.map (Opposite.op (v ≫ u₀))).hom s_pull))
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    have hcomp : (pb_g.obj R_Y).obj.map (Opposite.op u₀) ≫ (pb_g.obj R_Y).obj.map (Opposite.op v) =
        (pb_g.obj R_Y).obj.map (Opposite.op (v ≫ u₀)) :=
      ((pb_g.obj R_Y).obj.map_comp (Opposite.op u₀) (Opposite.op v)).symm
    exact CategoryTheory.ConcreteCategory.congr_hom hcomp s_pull

  have hTermBij : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (T : Z.Etale)
      (hT : CategoryTheory.Limits.IsTerminal T)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Function.Bijective (weilPolyP1CohomologyTermToPresheaf Z T hT F q) := by
    intro Z T hT F q
    let J := Z.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let R_T := weilPolyP1CohomologyRepSheaf Z T
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let α_T := weilPolyP1CohomologyRepToConst Z T hT
    let ι_T : ↑(R_T.obj.obj (Opposite.op T)) :=
      weilPolyP1CohomologyRepHomEquiv Z T R_T (CategoryTheory.CategoryStruct.id R_T)
    let g_ι : Aℤ ⟶ R_T.obj.obj (Opposite.op T) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • ι_T
          map_zero' := zero_zsmul ι_T
          map_add' := fun a b => add_zsmul ι_T a.down b.down }
    let β_T : Fℤ ⟶ R_T := (adj_c.homEquiv Aℤ R_T).symm g_ι
    have hβ_unit : (β_T.hom.app (Opposite.op T)).hom ((adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ))) =
        ι_T := by
      have h_eq : adj_c.homEquiv Aℤ R_T β_T = g_ι := Equiv.apply_symm_apply _ g_ι
      have h_u : adj_c.homEquiv Aℤ R_T β_T =
          adj_c.unit.app Aℤ ≫ β_T.hom.app (Opposite.op T) :=
        adj_c.homEquiv_unit Aℤ R_T β_T
      have h_ev := CategoryTheory.ConcreteCategory.congr_hom (h_u.symm.trans h_eq) (ULift.up (1 : ℤ))
      exact h_ev.trans (one_zsmul ι_T)
    have hαβ : α_T ≫ β_T = CategoryTheory.CategoryStruct.id R_T := by
      apply (weilPolyP1CohomologyRepHomEquiv Z T R_T).injective
      rw [hRepNatRight]
      have hα_ev : weilPolyP1CohomologyRepHomEquiv Z T Fℤ α_T =
          (adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
        Equiv.apply_symm_apply _ _
      rw [hα_ev, hβ_unit]
    have hβα : β_T ≫ α_T = CategoryTheory.CategoryStruct.id Fℤ := by
      apply (adj_c.homEquiv Aℤ Fℤ).injective
      apply AddCommGrpCat.ext
      intro n
      have hn : n = n.down • ULift.up (1 : ℤ) :=
        ULift.ext _ _ (mul_one n.down).symm
      rw [hn, map_zsmul, map_zsmul]
      congr 1
      have hL : (adj_c.homEquiv Aℤ Fℤ (β_T ≫ α_T)).hom (ULift.up (1 : ℤ)) =
          (α_T.hom.app (Opposite.op T)).hom
            ((β_T.hom.app (Opposite.op T)).hom ((adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)))) := by
        have h_u : adj_c.homEquiv Aℤ Fℤ (β_T ≫ α_T) =
            adj_c.unit.app Aℤ ≫ (β_T ≫ α_T).hom.app (Opposite.op T) :=
          adj_c.homEquiv_unit Aℤ Fℤ (β_T ≫ α_T)
        exact CategoryTheory.ConcreteCategory.congr_hom h_u (ULift.up (1 : ℤ))
      have hR : (adj_c.homEquiv Aℤ Fℤ (CategoryTheory.CategoryStruct.id Fℤ)).hom (ULift.up (1 : ℤ)) =
          (adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)) := by
        have h_u : adj_c.homEquiv Aℤ Fℤ (CategoryTheory.CategoryStruct.id Fℤ) =
            adj_c.unit.app Aℤ ≫ (CategoryTheory.CategoryStruct.id Fℤ).hom.app (Opposite.op T) :=
          adj_c.homEquiv_unit Aℤ Fℤ (CategoryTheory.CategoryStruct.id Fℤ)
        exact CategoryTheory.ConcreteCategory.congr_hom
          (h_u.trans (CategoryTheory.Category.comp_id _)) (ULift.up (1 : ℤ))
      have hα_ι : (α_T.hom.app (Opposite.op T)).hom ι_T =
          (adj_c.unit.app Aℤ).hom (ULift.up (1 : ℤ)) := by
        have h1 := (hRepNatRight Z T (CategoryTheory.CategoryStruct.id R_T) α_T).symm
        rw [CategoryTheory.Category.id_comp] at h1
        exact h1.trans (Equiv.apply_symm_apply _ _)
      exact hL.trans ((congrArg (α_T.hom.app (Opposite.op T)).hom hβ_unit).trans
        (hα_ι.trans hR.symm))
    let inv_fn : ↑((CategoryTheory.Sheaf.cohomologyPresheaf F q).obj (Opposite.op T)) → F.H q :=
      fun w => ((CategoryTheory.Abelian.Ext.mk₀ β_T).precomp F (Nat.zero_add q)) w
    refine Function.bijective_iff_has_inverse.mpr ⟨inv_fn, ?_, ?_⟩
    · intro z
      change (CategoryTheory.Abelian.Ext.mk₀ β_T).comp
        ((CategoryTheory.Abelian.Ext.mk₀ α_T).comp z (Nat.zero_add q)) (Nat.zero_add q) = z
      exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc β_T α_T z).trans
        ((congrArg (fun m => (CategoryTheory.Abelian.Ext.mk₀ m).comp z (Nat.zero_add q)) hβα).trans
          (CategoryTheory.Abelian.Ext.mk₀_id_comp z))
    · intro w
      change (CategoryTheory.Abelian.Ext.mk₀ α_T).comp
        ((CategoryTheory.Abelian.Ext.mk₀ β_T).comp w (Nat.zero_add q)) (Nat.zero_add q) = w
      exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc α_T β_T w).trans
        ((congrArg (fun m => (CategoryTheory.Abelian.Ext.mk₀ m).comp w (Nat.zero_add q)) hαβ).trans
          (CategoryTheory.Abelian.Ext.mk₀_id_comp w))

  have hTermNat : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {T₁ T₂ : Z.Etale}
      (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (τ : Quiver.Hom T₁ T₂)
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ) (z : F.H q),
      ((F.cohomologyPresheaf q).map (Opposite.op τ)).hom
        (weilPolyP1CohomologyTermToPresheaf Z T₂ hT₂ F q z) =
        weilPolyP1CohomologyTermToPresheaf Z T₁ hT₁ F q z := by
    intro Z T₁ T₂ hT₁ hT₂ τ F q z
    let J := Z.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let adj_c1 := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₁
    let adj_c2 := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₂
    let η_const := (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ)
    have h_u1 : adj_c1.unit.app Aℤ = η_const.app (Opposite.op T₁) := by
      change (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₁).unit.app Aℤ ≫
        η_const.app (Opposite.op T₁) = _
      rw [CategoryTheory.constantPresheafAdj_unit_app]
      exact CategoryTheory.Category.id_comp (η_const.app (Opposite.op T₁))
    have h_u2 : adj_c2.unit.app Aℤ = η_const.app (Opposite.op T₂) := by
      change (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₂).unit.app Aℤ ≫
        η_const.app (Opposite.op T₂) = _
      rw [CategoryTheory.constantPresheafAdj_unit_app]
      exact CategoryTheory.Category.id_comp (η_const.app (Opposite.op T₂))
    have h_nat : η_const.app (Opposite.op T₁) =
        η_const.app (Opposite.op T₂) ≫ Fℤ.obj.map (Opposite.op τ) := by
      have hn := η_const.naturality (Opposite.op τ)
      exact (CategoryTheory.Category.id_comp (η_const.app (Opposite.op T₁))).symm.trans hn
    have h_rep_eq : repMap Z τ ≫ weilPolyP1CohomologyRepToConst Z T₂ hT₂ =
        weilPolyP1CohomologyRepToConst Z T₁ hT₁ := by
      apply (weilPolyP1CohomologyRepHomEquiv Z T₁ Fℤ).injective
      rw [hRepNatLeft]
      have hev1 : weilPolyP1CohomologyRepHomEquiv Z T₁ Fℤ (weilPolyP1CohomologyRepToConst Z T₁ hT₁) =
          (adj_c1.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
        Equiv.apply_symm_apply _ _
      have hev2 : weilPolyP1CohomologyRepHomEquiv Z T₂ Fℤ (weilPolyP1CohomologyRepToConst Z T₂ hT₂) =
          (adj_c2.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
        Equiv.apply_symm_apply _ _
      rw [hev1, hev2, h_u1, h_u2]
      exact (CategoryTheory.ConcreteCategory.congr_hom h_nat (ULift.up (1 : ℤ))).symm
    have hmap : (F.cohomologyPresheaf q).map (Opposite.op τ) =
        ((CategoryTheory.Abelian.extFunctor q).map (Opposite.op (repMap Z τ))).app F := rfl
    have happ := CategoryTheory.ConcreteCategory.congr_hom
      (hmap.trans (CategoryTheory.Abelian.extFunctor_map_app q (Opposite.op (repMap Z τ)) F))
      (weilPolyP1CohomologyTermToPresheaf Z T₂ hT₂ F q z)
    refine happ.trans ?_
    change (CategoryTheory.Abelian.Ext.mk₀ (repMap Z τ)).comp
        ((CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1CohomologyRepToConst Z T₂ hT₂)).comp z
          (Nat.zero_add q))
        (Nat.zero_add q) =
      (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1CohomologyRepToConst Z T₁ hT₁)).comp z
        (Nat.zero_add q)
    exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc
      (repMap Z τ) (weilPolyP1CohomologyRepToConst Z T₂ hT₂) z).trans
      (congrArg (fun m => (CategoryTheory.Abelian.Ext.mk₀ m).comp z (Nat.zero_add q)) h_rep_eq)

  
  
  
  have hNullSec : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (g : Z ⟶ S_Ω)
      [AlgebraicGeometry.LocallyOfFiniteType g] (z₀ : ↥Z),
      ∃ σ : S_Ω ⟶ Z, σ ≫ g = 𝟙 S_Ω := by
    intro Z g _ z₀
    obtain ⟨V₀, hV₀, hz₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Z.Opens))
        (x := z₀) trivial
    let B_c : CommRingCat.{u} := Z.presheaf.obj (Opposite.op V₀)
    let B : Type u := ↑B_c
    let p₀ : PrimeSpectrum B := hV₀.primeIdealOf ⟨z₀, hz₀⟩
    have _ : Nontrivial B :=
      ⟨⟨0, 1, fun h01 =>
        p₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (h01 ▸ p₀.asIdeal.zero_mem))⟩⟩
    let f_aff : AlgebraicGeometry.Spec B_c ⟶ S_Ω := hV₀.fromSpec ≫ g
    have _ : AlgebraicGeometry.LocallyOfFiniteType f_aff := inferInstance
    let φ : CommRingCat.of Ω ⟶ B_c := AlgebraicGeometry.Spec.preimage f_aff
    have hφ_map : AlgebraicGeometry.Spec.map φ = f_aff :=
      AlgebraicGeometry.Spec.map_preimage f_aff
    have hφ_ft : RingHom.FiniteType φ.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (hφ_map.symm ▸ inferInstance)
    letI : Algebra Ω B := φ.hom.toAlgebra
    have hAlg_ft : Algebra.FiniteType Ω B := RingHom.finiteType_algebraMap.mp hφ_ft
    obtain ⟨n, ψ, hψ⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := Ω) (S := B)).mp hAlg_ft
    obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal B
    have _ : (Ideal.comap ψ.toRingHom 𝔪).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective ψ.toRingHom hψ
    obtain ⟨x, hx⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton
        (I := Ideal.comap ψ.toRingHom 𝔪)).mp inferInstance
    have h_eval_eq : ∀ P Q : MvPolynomial (Fin n) Ω,
        ψ P = ψ Q → MvPolynomial.aeval x P = MvPolynomial.aeval x Q := by
      intro P Q hPQ
      have hmem : P - Q ∈ Ideal.comap ψ.toRingHom 𝔪 := by
        change ψ (P - Q) ∈ 𝔪
        rw [map_sub, hPQ, sub_self]
        exact 𝔪.zero_mem
      rw [hx, MvPolynomial.mem_vanishingIdeal_iff] at hmem
      have h0 := hmem x (Set.mem_singleton x)
      rw [map_sub] at h0
      exact sub_eq_zero.mp h0
    let r := Function.surjInv hψ
    have hr : ∀ b : B, ψ (r b) = b := Function.surjInv_eq hψ
    let ev_B : B →+* Ω :=
      { toFun := fun b => MvPolynomial.aeval x (r b)
        map_one' :=
          (h_eval_eq (r 1) 1 ((hr 1).trans (map_one ψ).symm)).trans (map_one _)
        map_mul' := fun a b =>
          (h_eval_eq (r (a * b)) (r a * r b)
            ((hr (a * b)).trans ((congrArg₂ (· * ·) (hr a).symm (hr b).symm).trans
              (map_mul ψ (r a) (r b)).symm))).trans
            (map_mul (MvPolynomial.aeval x) (r a) (r b))
        map_zero' :=
          (h_eval_eq (r 0) 0 ((hr 0).trans (map_zero ψ).symm)).trans (map_zero _)
        map_add' := fun a b =>
          (h_eval_eq (r (a + b)) (r a + r b)
            ((hr (a + b)).trans ((congrArg₂ (· + ·) (hr a).symm (hr b).symm).trans
              (map_add ψ (r a) (r b)).symm))).trans
            (map_add (MvPolynomial.aeval x) (r a) (r b)) }
    have h_retract : φ ≫ CommRingCat.ofHom ev_B = 𝟙 (CommRingCat.of Ω) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change MvPolynomial.aeval x (r (φ.hom c)) = c
      exact (h_eval_eq (r (φ.hom c)) (MvPolynomial.C c)
        ((hr (φ.hom c)).trans (ψ.commutes c).symm)).trans (MvPolynomial.aeval_C x c)
    refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_B) ≫ hV₀.fromSpec, ?_⟩
    exact (CategoryTheory.Category.assoc _ _ _).trans
      ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_B) ≫ ·) hφ_map.symm).trans
        (((AlgebraicGeometry.Spec.map_comp φ (CommRingCat.ofHom ev_B)).symm).trans
          ((congrArg AlgebraicGeometry.Spec.map h_retract).trans
            (AlgebraicGeometry.Spec.map_id _))))

  
  
  
  have hSpecUnitInj : ∀ (P : CategoryTheory.Functor (Opposite S_Ω.Etale) AddCommGrpCat.{u}),
      Function.Injective
        ((((CategoryTheory.sheafificationAdjunction S_Ω.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P).app (Opposite.op T_Ω)).hom) := by
    intro P x₁ x₂ h_eq
    let J_Ω := S_Ω.smallEtaleTopology
    let adj_Ω := CategoryTheory.sheafificationAdjunction J_Ω AddCommGrpCat.{u}
    let η_P : P ⟶ ((CategoryTheory.presheafToSheaf J_Ω AddCommGrpCat.{u}).obj P).obj :=
      adj_Ω.unit.app P
    have hW : J_Ω.W η_P := J_Ω.W_adj_unit_app adj_Ω P
    have hinj : CategoryTheory.Presheaf.IsLocallyInjective J_Ω η_P :=
      ((J_Ω.W_iff_isLocallyBijective η_P).mp hW).1
    let R_eq : CategoryTheory.Sieve T_Ω :=
      CategoryTheory.Presheaf.equalizerSieve x₁ x₂
    have h_eq_id : (((CategoryTheory.presheafToSheaf J_Ω AddCommGrpCat.{u}).obj P).obj.map
        (Opposite.op (CategoryTheory.CategoryStruct.id T_Ω))).hom
        ((η_P.app (Opposite.op T_Ω)).hom x₁) =
      (((CategoryTheory.presheafToSheaf J_Ω AddCommGrpCat.{u}).obj P).obj.map
        (Opposite.op (CategoryTheory.CategoryStruct.id T_Ω))).hom
        ((η_P.app (Opposite.op T_Ω)).hom x₂) :=
      congrArg _ h_eq
    have h_top_eq : CategoryTheory.Presheaf.equalizerSieve
        ((η_P.app (Opposite.op T_Ω)).hom x₁)
        ((η_P.app (Opposite.op T_Ω)).hom x₂) = ⊤ :=
      CategoryTheory.Sieve.id_mem_iff_eq_top.mp h_eq_id
    have hR_mem : R_eq ∈ J_Ω T_Ω :=
      (CategoryTheory.Presheaf.isLocallyInjective_iff_equalizerSieve_mem_imp J_Ω η_P).mp
        hinj x₁ x₂ (h_top_eq.symm ▸ J_Ω.top_mem T_Ω)
    have hTop_eq : S_Ω.smallEtaleTopology = S_Ω.smallEtalePretopology.toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S_Ω (le_refl (@AlgebraicGeometry.Etale))
    have hR_pre : R_eq ∈ S_Ω.smallEtalePretopology.toGrothendieck T_Ω :=
      Eq.mp (congrArg (fun K : CategoryTheory.GrothendieckTopology S_Ω.Etale => R_eq ∈ K T_Ω)
        hTop_eq) hR_mem
    let pt_Ω : ↥S_Ω := default
    obtain ⟨V, f, v₀, hf_arr, _, _⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology T_Ω R_eq).mp hR_pre pt_Ω
    have _ : AlgebraicGeometry.Etale V.hom := V.prop
    obtain ⟨σ_V, hσ_V⟩ := hNullSec V.hom v₀
    let s_V : Quiver.Hom T_Ω V :=
      CategoryTheory.MorphismProperty.Over.homMk σ_V hσ_V trivial
    have hs_id : s_V ≫ f = CategoryTheory.CategoryStruct.id T_Ω :=
      (weilEtaleIdTerminalIsTerminal.{u} S_Ω).hom_ext _ _
    have hid_arr : R_eq.arrows (CategoryTheory.CategoryStruct.id T_Ω) :=
      hs_id ▸ R_eq.downward_closed hf_arr s_V
    have hmap_eq : (P.map (Opposite.op (CategoryTheory.CategoryStruct.id T_Ω))).hom x₁ =
        (P.map (Opposite.op (CategoryTheory.CategoryStruct.id T_Ω))).hom x₂ := hid_arr
    have hid_map : P.map (Opposite.op (CategoryTheory.CategoryStruct.id T_Ω)) =
        CategoryTheory.CategoryStruct.id (P.obj (Opposite.op T_Ω)) :=
      (congrArg P.map CategoryTheory.op_id).trans (P.map_id _)
    exact (CategoryTheory.ConcreteCategory.congr_hom hid_map x₁).symm.trans
      (hmap_eq.trans (CategoryTheory.ConcreteCategory.congr_hom hid_map x₂))

  
  
  
  refine ⟨fun q => hTermBij S_fib T_fib hT_fib F_fib q, ?_, ?_⟩

  
  · intro E_U y_E q₁ q₂ s₁ s₂
    let J_U := U.smallEtaleTopology
    let adj_U := CategoryTheory.sheafificationAdjunction J_U AddCommGrpCat.{u}
    let η₁ : P_pre q₁ ⟶ (ℛ_U q₁).obj := adj_U.unit.app (P_pre q₁)
    let η₂ : P_pre q₂ ⟶ (ℛ_U q₂).obj := adj_U.unit.app (P_pre q₂)
