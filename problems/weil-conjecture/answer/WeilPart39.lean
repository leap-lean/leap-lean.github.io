          CategoryTheory.Limits.pullback h₂ (π_Braw r) :=
        CategoryTheory.Limits.pullback.map h₁ (π_Braw r) h₂ (π_Braw r)
          u_left (𝟙 _) (𝟙 U₀.toScheme)
          (by rw [CategoryTheory.Category.comp_id, hu_w])
