      have : IsScalarTower K ↥E₀ ↥L₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
      have : IsScalarTower R₀ ↥E₀ ↥L₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
      refine weil_dedekind_galois_inertia_trivial_implies_unramified
        R₀ K ↥E₀ ↥L₁ p (hNotField p hp)
