    refine hnat_u.trans (congrArg ((pb_gt.obj F).obj.map (Opposite.op u)).hom
      (h_unit_app.trans (congrArg ((adj_gt.unit.app F).hom.app (Opposite.op U_Y)).hom ?_)))
    exact (hRepNatRight Y U_Y (𝟙 R_Y) ψ).symm.trans
      (congrArg (weilPolyP1CohomologyRepHomEquiv Y U_Y F) (CategoryTheory.Category.id_comp ψ))

  have hDeg0 : ∀ (𝒢 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) {β₀},
