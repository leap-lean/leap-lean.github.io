        let fst_V_prY := CategoryTheory.Limits.pullback.fst ((Fgt Y₀).obj V).hom pr_Y
        let fst_Ybar_g' := CategoryTheory.Limits.pullback.fst ((Fgt Y_bar).obj (B_prY.obj V)).hom g'
        let fst_Ybar_gstd := CategoryTheory.Limits.pullback.fst
          ((Fgt Y_bar).obj (B_prY.obj V)).hom g_std
        let fst_prX_e := CategoryTheory.Limits.pullback.fst
          ((Fgt X_std).obj (B_prX.obj W₀)).hom e_X.hom
        let fst_diag_e := CategoryTheory.Limits.pullback.fst
          ((Fgt X_std).obj (B_diag_std.obj V)).hom e_X.hom
        let fst_gstd_e := CategoryTheory.Limits.pullback.fst
