          rw [← hi₁₂, CategoryTheory.op_comp, C_V'.obj.map_comp, AddCommGrpCat.hom_comp,
            AddMonoidHom.comp_apply, hψ_spec Y (g₁ + g₂) (p.1 + p.2)]
          have hn := congrArg (fun u : A ⟶ _ => u.hom (p.1 + p.2)) (η_sh.naturality i₁₂.op)
