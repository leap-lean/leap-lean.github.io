        have hq₁_fst : ((Fgt X').map q₁).left ≫ fst_W₀_prX' = fst_prX_e ≫ fst_W₀_prX :=
          hCompCongrHomFst e_X.hom pr_X pr_X' he_pr W₀
        have hq₂_fst : ((Fgt X').map q₂).left ≫ fst_prX_e =
            fst_diag_e ≫ ((Fgt X_std).map (e_B2_std.inv.app V)).left :=
          hMapFst e_X.hom (e_B2_std.inv.app V)
        have hq₃_fst : ((Fgt X').map q₃).left ≫ fst_diag_e =
            fst_gstd_e ≫ ((Fgt X_std).map (e_B1_std.hom.app V)).left :=
          hMapFst e_X.hom (e_B1_std.hom.app V)
        have hstd_fst : ((Fgt X_std).map (e_B1_std.hom.app V)).left ≫
            (((Fgt X_std).map (e_B2_std.inv.app V)).left ≫ (fst_W₀_prX ≫ fst_V_g₀)) =
            fst_Ybar_gstd ≫ fst_V_prY :=
          (congrArg (((Fgt X_std).map (e_B1_std.hom.app V)).left ≫ ·)
            (hCompCongrInvFst pr_X g₀ (g_std ≫ pr_Y) hg_std.symm V)).trans
            (hPullCompInvFst g_std pr_Y V)
        have hq₄_fst : ((Fgt X').map q₄).left ≫ (fst_gstd_e ≫ fst_Ybar_gstd) = fst_Ybar_g' :=
          hCompCongrInvFst e_X.hom g_std g' he_g (B_prY.obj V)
        let r₄ := ((Fgt X').map q₄).left
        let r₃ := ((Fgt X').map q₃).left
        let r₂ := ((Fgt X').map q₂).left
        let r₁ := ((Fgt X').map q₁).left
        let s₁ := ((Fgt X_std).map (e_B1_std.hom.app V)).left
        let s₂ := ((Fgt X_std).map (e_B2_std.inv.app V)).left
        have hR_fst : (k_R ≫ fst_W₀_prX') ≫ fst_V_g₀ = fst_Ybar_g' ≫ fst_V_prY :=
