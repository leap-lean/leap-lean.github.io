                _ = (w_eq ≫ pair_uv) ≫ CategoryTheory.Limits.pullback.fst h₂ h₂ :=
                    (Category.assoc _ _ _).symm
                _ = (CategoryTheory.Limits.pullback.snd pair_uv δ_h₂ ≫ δ_h₂) ≫
