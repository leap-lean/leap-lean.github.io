      have hEpi_g₂ : CategoryTheory.Epi g₂ := hEx₃_S'.epi_f hg₃_zero
      let d_bot := CategoryTheory.Limits.cokernel.desc g₁ g₂ h₂_S'
      have : CategoryTheory.Mono d_bot := hEx₂_S'.mono_cokernelDesc
      have : CategoryTheory.Epi d_bot := inferInstance
