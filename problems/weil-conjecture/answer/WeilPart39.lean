    intro q_ind
    induction q_ind with
    | zero =>
      intro ℱ_ind β_ind hβ_ind
      exact hDeg0 ℱ_ind hβ_ind
    | succ m ih =>
      intro ℱ_ind β_ind hβ_ind
      classical
      let pb_j := (weilEtaleSitePullback j).sheafPullback AddCommGrpCat.{u}
        S.smallEtaleTopology S'.smallEtaleTopology
      let pb_j' := (weilEtaleSitePullback j').sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology X'.smallEtaleTopology
