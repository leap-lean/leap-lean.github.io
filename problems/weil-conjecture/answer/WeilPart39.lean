      intro x hx
      have hxU : x ∈ (U₀ : Set D₀.left) := hu₀_mem hx
      rw [hU₀_eq] at hxU
      rcases hxU with ⟨p, _, rfl⟩
      exact ⟨p, rfl⟩
    let u_aff : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_aff u₀ hu₀_range_j
    have hu_aff_fac : u_aff ≫ j_aff = u₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_aff u₀ hu₀_range_j
    let φ_aff : CommRingCat.of (Polynomial F) ⟶ CommRingCat.of F :=
      AlgebraicGeometry.Spec.preimage u_aff
    have hφ_map : AlgebraicGeometry.Spec.map φ_aff = u_aff :=
      AlgebraicGeometry.Spec.map_preimage u_aff
    have hC_φ : CommRingCat.ofHom Polynomial.C ≫ φ_aff = 𝟙 (CommRingCat.of F) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, hφ_map, ← hj_hom,
        ← CategoryTheory.Category.assoc, hu_aff_fac, hu₀_sec]
    let a₀ : F := φ_aff.hom Polynomial.X
    have hφ_eq : φ_aff = CommRingCat.ofHom (Polynomial.evalRingHom a₀) := by
      apply CommRingCat.hom_ext
      apply Polynomial.ringHom_ext'
      · ext c
        have hc := congrArg (fun g : CommRingCat.of F ⟶ CommRingCat.of F => g.hom c) hC_φ
        simpa using hc
      · change φ_aff.hom Polynomial.X = (Polynomial.evalRingHom a₀) Polynomial.X
        simp [a₀]
    have hu₀_eq : u₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀)) ≫ j_aff := by
      rw [← hu_aff_fac, ← hφ_map, hφ_eq]
    have ha₀ : a₀ ∉ S_aff := by
      intro ha₀_in
      obtain ⟨pt₀⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := inferInstance
      let q₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a₀))).base pt₀
      have hmemU : j_aff.base q₀ ∈ (U₀ : Set D₀.left) := by
        apply hu₀_mem
        refine ⟨pt₀, ?_⟩
        rw [hu₀_eq]
        rfl
      rw [hU₀_eq] at hmemU
      rcases hmemU with ⟨p, hp, hp_eq⟩
      have hq₀_eq : p = q₀ := hj_open.base_open.injective hp_eq
      rw [hq₀_eq] at hp
      apply hp a₀ ha₀_in
      change (Polynomial.evalRingHom a₀) (Polynomial.X - Polynomial.C a₀) ∈ pt₀.asIdeal
      have hev : (Polynomial.evalRingHom a₀) (Polynomial.X - Polynomial.C a₀) = 0 := by simp
      rw [hev]
      exact pt₀.asIdeal.zero_mem
    let ι_loc : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))
    have _ : AlgebraicGeometry.IsOpenImmersion ι_loc :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization Δ_aff
    let f_loc : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ D₀.left := ι_loc ≫ j_aff
    have _ : AlgebraicGeometry.IsOpenImmersion f_loc :=
      AlgebraicGeometry.IsOpenImmersion.comp ι_loc j_aff
    have hRange_loc : Set.range ι_loc.base =
