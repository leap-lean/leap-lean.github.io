        rw [CategoryTheory.Adjunction.comp_unit_app]
        exact CategoryTheory.Category.id_comp _
      exact congrArg (fun φ => φ.hom a) (hθ_app.trans hadj_unit.symm)

  
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂), P_Et.HasPullbacksAlong h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
