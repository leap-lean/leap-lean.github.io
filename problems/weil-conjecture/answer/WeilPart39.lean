      let g_lc : LocallyConstant ↥W_raw (H_u r) :=
        LocallyConstant.map (α_lat r) (LocallyConstant.comap (m_j_can r W).base.hom f)
      have hg_mem : g_lc ∈ Set.range (triv_R r W) := by
        rw [((hTriv_R_spec r).2 W).2.1]
        intro τ_raw m_τ hmτ_fst hmτ_snd y_raw
        obtain ⟨σ, hcomp⟩ := (hj_BV r).2.2 τ_raw
        have hsymm_comm : CommRingCat.ofHom σ.symm.toRingHom ≫
            CommRingCat.ofHom (j_BV r).toRingHom =
            CommRingCat.ofHom (j_BV r).toRingHom ≫
              CommRingCat.ofHom τ_raw.symm.toRingHom := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro b
          apply τ_raw.injective
          change τ_raw (j_BV r (σ.symm b)) = τ_raw (τ_raw.symm (j_BV r b))
          rw [hcomp (σ.symm b), σ.apply_symm_apply, τ_raw.apply_symm_apply]
        have hp_deck : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_raw.symm.toRingHom) ≫ p_j r =
            p_j r ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) := by
          dsimp only [p_j]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hsymm_comm]
        have hσ_π : AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ≫ π_BV r =
            π_BV r := by
          dsimp only [π_BV]
          rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have hcomm : CommRingCat.ofHom (algebraMap R₀ (B_V r)) ≫
              CommRingCat.ofHom σ.symm.toRingHom =
              CommRingCat.ofHom (algebraMap R₀ (B_V r)) :=
            CommRingCat.hom_ext (RingHom.ext fun z => σ.symm.commutes z)
          rw [hcomm]
        have hm_σ_cond : CategoryTheory.Limits.pullback.fst h_W (π_BV r) ≫ h_W =
            (CategoryTheory.Limits.pullback.snd h_W (π_BV r) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) ≫ π_BV r := by
          rw [CategoryTheory.Category.assoc, hσ_π, CategoryTheory.Limits.pullback.condition]
        let m_σ : W_V ⟶ W_V :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_W (π_BV r))
            (CategoryTheory.Limits.pullback.snd h_W (π_BV r) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))
            hm_σ_cond
        have hmτ_snd' : m_τ ≫ CategoryTheory.Limits.pullback.snd h_W (π_Braw r) =
            CategoryTheory.Limits.pullback.snd h_W (π_Braw r) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_raw.symm.toRingHom) := hmτ_snd
        have hm_comm : m_τ ≫ m_j_can r W = m_j_can r W ≫ m_σ := by
