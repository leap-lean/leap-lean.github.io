      rw [h1, hRange_loc, ← hBasic, ← hU₀_eq, AlgebraicGeometry.Scheme.Opens.range_ι]
    let e_U : AlgebraicGeometry.Spec (CommRingCat.of R₀) ≅ U₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq f_loc U₀.ι hRange_f
    have heU_eq : e_U.hom ≫ U₀.ι = ι_loc ≫ j_aff :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac f_loc U₀.ι hRange_f
    exact ⟨a₀, ha₀, e_U, hu₀_eq, heU_eq⟩

  
