        have hcomp : f₁ ≫ f₂ = AlgebraicGeometry.Spec.map (α_st.app j₂) := by
          dsimp [f₁, f₂]
          have hnat : α_st.app j₁ ≫ B_st.map θ = α_st.app j₂ := by
            simpa only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
              CategoryTheory.Category.id_comp] using (α_st.naturality θ).symm
          rw [← AlgebraicGeometry.Spec.map_comp, hnat]
        have hf₂_et : AlgebraicGeometry.Etale f₂ :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr j₁.2.1
        have hcomp_et : AlgebraicGeometry.Etale (f₁ ≫ f₂) := by
          rw [hcomp]
          exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
            j₂.2.1
        have hf₁_et : AlgebraicGeometry.Etale f₁ :=
          CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
            f₁ f₂ hf₂_et hcomp_et
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          hf₁_et
      · have hLoc_j : @IsLocalization.Away ↑(B_st.obj j) _ ((α_st.app j).hom x₀) ↑(B_open.obj j) _
            (loc_st.app j).hom.toAlgebra := by
          convert (inferInstance : IsLocalization.Away (x_st j) (Localization.Away (x_st j)))
          exact Algebra.algebra_ext _ _ fun _ => rfl
        have hεj_base : (ε_st j).comp ((α_st.app j).hom.comp (algebraMap P R₀)) =
            Polynomial.evalRingHom 0 := by
          refine RingHom.ext fun f => ?_
          have h1 : j.1.val (algebraMap R₀ ↥j.1 (algebraMap P R₀ f)) =
              p_R_loc (algebraMap P R₀ f) := j.1.val.commutes _
          have h2 := RingHom.congr_fun hpR_loc_comp f
          have h3 := RingHom.congr_fun hπ_pR f
          simp only [ε_st, α_st, RingHom.comp_apply] at h2 h3 ⊢
          exact (congrArg π_cl h1).trans ((congrArg π_cl h2).trans h3)
        refine ⟨j.2.1,
          (RingHom.etale_algebraMap (R := ↥j.1) (S := Localization.Away (x_st j))).mpr
            (Algebra.Etale.of_isLocalizationAway (x_st j)),
          hLoc_j, hεj_base, j.2.2, ?_, ?_, ?_, ?_, rfl⟩
        · apply CommRingCat.hom_ext
          refine RingHom.ext fun r => ?_
          exact IsLocalization.Away.lift_eq (S := Localization.Away x₀) x₀ (hx₀_unit_Bop j) r
        · apply CommRingCat.hom_ext
          refine RingHom.ext fun r => ?_
          apply hι_Rbar_inj
          change j.1.val (algebraMap R₀ ↥j.1 r) = j_bot.1.val (algebraMap R₀ ↥j_bot.1 r)
          rw [j.1.val.commutes, j_bot.1.val.commutes]
        · suffices h : (ι_op j).comp (IsLocalization.Away.lift x₀ (hx₀_unit_Bop j)) = p_Ks_loc from
