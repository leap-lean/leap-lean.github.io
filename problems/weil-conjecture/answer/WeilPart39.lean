      let γ_E₀ : ↥E₀ ≃ₐ[K] ↥E₀ := AlgEquiv.restrictNormal γ ↥E₀
      let y : ↥E₀ := γ_E₀.symm x
      have hγ_y : γ (incl y) = incl x := by
        change γ (algebraMap ↥E₀ ↥L₁ y) = incl x
        rw [← AlgEquiv.restrictNormal_commutes γ ↥E₀ y]
        change incl (γ_E₀ (γ_E₀.symm x)) = incl x
        rw [γ_E₀.apply_symm_apply]
      have h_app := hConj_E₀ y
