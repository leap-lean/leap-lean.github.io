    exact (CategoryTheory.IsPullback.of_bot hpb_outer hg_std_fst.symm hpb_Y).flip

  let B_g_std := weilEtaleSitePullback g_std
  let B_prX := weilEtaleSitePullback pr_X
  let B_diag_std := weilEtaleSitePullback (CategoryTheory.CategoryStruct.comp g_std pr_Y)
