        CategoryTheory.MorphismProperty.Over.homMk (𝟙 V) (CategoryTheory.Category.id_comp π) trivial
      let u_id_inv : AlgebraicGeometry.Scheme.Etale.mk π ⟶ j_π.obj T_V :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 V)
          ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.id_comp π).symm) trivial
      let e_id : ↑(ℱ.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk π))) ≃+
          ↑(ℱ.obj.obj (Opposite.op (j_π.obj T_V))) :=
        { toFun := (ℱ.obj.map u_id_can.op).hom
          invFun := (ℱ.obj.map u_id_inv.op).hom
          left_inv := fun s => by
            have hc : u_id_inv ≫ u_id_can = 𝟙 _ :=
              CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
            exact ((ℱ.obj.map_comp u_id_can.op u_id_inv.op) |>
              fun h => congrArg (fun u => u.hom s) h).symm.trans
              ((congrArg (fun m => (ℱ.obj.map m.op).hom s) hc).trans
                (congrArg (fun u => u.hom s) (ℱ.obj.map_id _)))
          right_inv := fun s => by
            have hc : u_id_can ≫ u_id_inv = 𝟙 _ :=
              CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
            exact ((ℱ.obj.map_comp u_id_inv.op u_id_can.op) |>
              fun h => congrArg (fun u => u.hom s) h).symm.trans
              ((congrArg (fun m => (ℱ.obj.map m.op).hom s) hc).trans
                (congrArg (fun u => u.hom s) (ℱ.obj.map_id _)))
          map_add' := map_add _ }
      let β : ↥A ≃+ H_s := e_const.symm.trans ((Ψ₀ T_V).symm.trans (e_id.symm.trans ev))
      let map_β : ∀ Y : V.Etale, LocallyConstant ↥Y.left ↥A ≃+ LocallyConstant ↥Y.left H_s := fun Y =>
        { toFun := LocallyConstant.mapAddMonoidHom β.toAddMonoidHom
          invFun := LocallyConstant.mapAddMonoidHom β.symm.toAddMonoidHom
          left_inv := fun g => LocallyConstant.ext fun y => β.symm_apply_apply (g y)
          right_inv := fun g => LocallyConstant.ext fun y => β.apply_symm_apply (g y)
          map_add' := map_add _ }
      refine ⟨fun Y => (Ψ₀ Y).trans (map_β Y), ?_, ?_⟩
      · intro Y₁ Y₂ f u_f hu_f s y₁
        have hu_eq : u_f = j_π.map f := CategoryTheory.MorphismProperty.Over.Hom.ext hu_f
        have hs : (ℱ.obj.map (Opposite.op u_f)).hom s = (ℱ.obj.map (Opposite.op (j_π.map f))).hom s :=
          congrArg (fun m => (ℱ.obj.map (Opposite.op m)).hom s) hu_eq
        exact (congrArg (fun t => β ((Ψ₀ Y₁ t) y₁)) hs).trans
          (congrArg (fun g : LocallyConstant _ _ => β (g y₁)) (hΨ₀_nat f s))
      · intro _ u_id hu_id s x
        have hu_eq : u_id = u_id_can := CategoryTheory.MorphismProperty.Over.Hom.ext hu_id
        have hs : (ℱ.obj.map (Opposite.op u_id)).hom s = e_id s :=
          congrArg (fun m => (ℱ.obj.map (Opposite.op m)).hom s) hu_eq
        have h1 : β ((Ψ₀ T_V ((ℱ.obj.map (Opposite.op u_id)).hom s)) x) =
            β ((Ψ₀ T_V (e_id s)) x) :=
          congrArg (fun t => β ((Ψ₀ T_V t) x)) hs
        have h2 : β ((Ψ₀ T_V (e_id s)) x) = β (e_const (Ψ₀ T_V (e_id s))) :=
          congrArg β (hV_const (Ψ₀ T_V (e_id s)) x)
        have h3 : β (e_const (Ψ₀ T_V (e_id s))) = ev s :=
          (congrArg (fun a => ev (e_id.symm ((Ψ₀ T_V).symm a)))
            (e_const.symm_apply_apply _)).trans
            ((congrArg (fun t => ev (e_id.symm t)) ((Ψ₀ T_V).symm_apply_apply _)).trans
              (congrArg ev (e_id.symm_apply_apply s)))
        exact h1.trans (h2.trans h3)

    
    have hTorsor_s :
        (∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : W ⟶ U),
          let W_V := CategoryTheory.Limits.pullback h_W π
          (AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π) ∧
            AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π)) ∧
          (∀ σ : S ≃ₐ[R₀] S, ∃! m_σ : W_V ⟶ W_V,
            m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π =
              CategoryTheory.Limits.pullback.fst h_W π ∧
            m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π =
              CategoryTheory.Limits.pullback.snd h_W π ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V),
          let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π) π
          ∃ δ : (S ≃ₐ[R₀] S) → (Y ⟶ Y_V),
            (∀ σ : S ≃ₐ[R₀] S,
              δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y ∧
              δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π =
                g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
              AlgebraicGeometry.Etale (δ σ)) ∧
            (⋃ σ : S ≃ₐ[R₀] S, Set.range (δ σ).base) = Set.univ) := by
      have hInj_RS : Function.Injective (algebraMap R₀ S) := by
        intro x y hxy
        have h1 := congrArg (algebraMap S L_r) hxy
        rw [← IsScalarTower.algebraMap_apply R₀ S L_r,
          ← IsScalarTower.algebraMap_apply R₀ S L_r,
          IsScalarTower.algebraMap_apply R₀ K L_r,
          IsScalarTower.algebraMap_apply R₀ K L_r] at h1
        exact IsFractionRing.injective R₀ K ((RingHom.injective (algebraMap K L_r)) h1)
      have hπ_surj : AlgebraicGeometry.Surjective π := by
        have hSpec_surj : AlgebraicGeometry.Surjective
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S))) := by
          refine ⟨fun p => ?_⟩
          let _ : p.asIdeal.IsPrime := p.isPrime
          have hle : Ideal.under R₀ (⊥ : Ideal S) ≤ p.asIdeal := by
            intro r hr
            change algebraMap R₀ S r ∈ (⊥ : Ideal S) at hr
            rw [Ideal.mem_bot] at hr
            rw [hInj_RS (hr.trans (map_zero _).symm)]
            exact p.asIdeal.zero_mem
          obtain ⟨Q, _, hQp, hQ_under⟩ :=
            Ideal.exists_ideal_over_prime_of_isIntegral p.asIdeal (⊥ : Ideal S) hle
          exact ⟨⟨Q, hQp⟩, PrimeSpectrum.ext hQ_under⟩
        have _ := hSpec_surj
        infer_instance
      let α_hom : (S ≃ₐ[R₀] S) → (V ⟶ V) :=
        fun σ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)
      have hα_π : ∀ σ : S ≃ₐ[R₀] S, α_hom σ ≫ π = π := by
        intro σ
        dsimp [α_hom, π]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply congrArg AlgebraicGeometry.Spec.map
        exact CommRingCat.hom_ext σ.symm.toAlgHom.comp_algebraMap
      let toGal : (S ≃ₐ[R₀] S) → Gal(L_r/K) :=
        fun σ => IsFractionRing.fieldEquivOfAlgEquiv K L_r L_r σ
      let e_IC : S ≃ₐ[R₀] ↥(integralClosure R₀ L_r) :=
        IsIntegralClosure.equiv R₀ S L_r ↥(integralClosure R₀ L_r)
      let fromGal : Gal(L_r/K) → (S ≃ₐ[R₀] S) := fun g =>
        (e_IC.trans (g.restrictScalars R₀).mapIntegralClosure).trans e_IC.symm
      have hfromGal_spec : ∀ (g : Gal(L_r/K)) (b : S),
          algebraMap S L_r (fromGal g b) = g (algebraMap S L_r b) := by
        intro g b
        have h1 := IsIntegralClosure.algebraMap_equiv R₀ S L_r ↥(integralClosure R₀ L_r) (fromGal g b)
        have h2 : e_IC (fromGal g b) = (g.restrictScalars R₀).mapIntegralClosure (e_IC b) := by
          dsimp [fromGal]
          exact e_IC.apply_symm_apply _
        have h3 := congrArg (algebraMap ↥(integralClosure R₀ L_r) L_r) h2
        have h4 := IsIntegralClosure.algebraMap_equiv R₀ S L_r ↥(integralClosure R₀ L_r) b
        exact h1.symm.trans (h3.trans (congrArg g h4))
      have hBij_gal : Function.Bijective toGal := by
        refine ⟨fun σ₁ σ₂ h => ?_, fun g => ⟨fromGal g, ?_⟩⟩
        · ext b
          apply IsFractionRing.injective S L_r
          have h1 := (IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L_r L_r σ₁ b).symm
          have h2 := IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L_r L_r σ₂ b
          exact h1.trans ((congrArg (fun f : Gal(L_r/K) => f (algebraMap S L_r b)) h).trans h2)
        · apply AlgEquiv.ext
          have hring : (toGal (fromGal g)).toRingHom = g.toRingHom := by
            apply IsLocalization.ringHom_ext (nonZeroDivisors S)
            ext b
            change toGal (fromGal g) (algebraMap S L_r b) = g (algebraMap S L_r b)
            rw [IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L_r L_r (fromGal g) b,
              hfromGal_spec g b]
          exact fun x => RingHom.congr_fun hring x
      let m_gal := Module.finrank K L_r
      have hcard_gal : Nat.card (S ≃ₐ[R₀] S) = m_gal :=
        (Nat.card_congr (Equiv.ofBijective toGal hBij_gal)).trans
          (IsGalois.card_aut_eq_finrank K L_r)
      have _ : Finite (S ≃ₐ[R₀] S) := Finite.of_injective toGal hBij_gal.1
      let equiv_Γ : Fin m_gal ≃ (S ≃ₐ[R₀] S) :=
        (Finite.equivFinOfCardEq hcard_gal).symm
      let T_SS := TensorProduct R₀ S S
      let μ_alg : (S ≃ₐ[R₀] S) → (T_SS →ₐ[S] S) :=
        fun σ => Algebra.TensorProduct.lift (AlgHom.id S S) σ.symm.toAlgHom (fun _ _ => Commute.all _ _)
      have hμ_tmul : ∀ (σ : S ≃ₐ[R₀] S) (x y : S), μ_alg σ (x ⊗ₜ[R₀] y) = x * σ.symm y := by
        intro σ x y
        dsimp [μ_alg]
        rw [Algebra.TensorProduct.lift_tmul]
        rfl
      have hIdem_ex : ∀ σ : S ≃ₐ[R₀] S,
          ∃ e_σ : T_SS,
            e_σ * e_σ = e_σ ∧
            (∀ z : T_SS, z * e_σ = (μ_alg σ z ⊗ₜ[R₀] (1 : S)) * e_σ) ∧
            (∀ τ : S ≃ₐ[R₀] S, μ_alg τ e_σ = if σ = τ then 1 else 0) := by
        intro σ
        have hμ_surj : Function.Surjective (μ_alg σ) := fun s =>
          ⟨s ⊗ₜ[R₀] 1, by rw [hμ_tmul, map_one, mul_one]⟩
        obtain ⟨f_σ, hf_idem, hf_ker⟩ : ∃ f_σ : T_SS,
            IsIdempotentElem f_σ ∧ RingHom.ker (μ_alg σ).toRingHom = Ideal.span {f_σ} := by
          let algTS : Algebra T_SS S := (μ_alg σ).toRingHom.toAlgebra
          let _ : Algebra T_SS S := algTS
          have _ : IsScalarTower S T_SS S := IsScalarTower.of_algebraMap_eq fun s => by
            change s = μ_alg σ (s ⊗ₜ[R₀] 1)
            rw [hμ_tmul, map_one, mul_one]
          have _ : Algebra.Etale S T_SS := Algebra.Etale.baseChange R₀ S S
          have _ : Algebra.Etale T_SS S := Algebra.Etale.of_restrictScalars S T_SS S
          have hIdemKer : IsIdempotentElem (RingHom.ker (algebraMap T_SS S)) :=
            (Algebra.FormallyEtale.iff_of_surjective (R := T_SS) (S := S) hμ_surj).mp inferInstance
          have hFGKer : (RingHom.ker (μ_alg σ).toRingHom).FG :=
            Algebra.FinitePresentation.ker_fG_of_surjective (μ_alg σ) hμ_surj
          exact (Ideal.isIdempotentElem_iff_of_fg _ hFGKer).mp hIdemKer
        let e_σ : T_SS := 1 - f_σ
        have he_idem : e_σ * e_σ = e_σ := (hf_idem.one_sub).eq
        have hfe_zero : f_σ * e_σ = 0 := by
          dsimp [e_σ]
          rw [mul_sub, mul_one, hf_idem.eq, sub_self]
        have hf_mem : f_σ ∈ RingHom.ker (μ_alg σ).toRingHom := by
          rw [hf_ker]; exact Ideal.subset_span rfl
        have hμ_σ_e : μ_alg σ e_σ = 1 := by
          dsimp [e_σ]
          rw [map_sub, map_one, show μ_alg σ f_σ = 0 from hf_mem, sub_zero]
        have habsorb : ∀ z : T_SS, z * e_σ = (μ_alg σ z ⊗ₜ[R₀] (1 : S)) * e_σ := by
          intro z
          have hw_ker : z - (μ_alg σ z ⊗ₜ[R₀] (1 : S)) ∈ RingHom.ker (μ_alg σ).toRingHom := by
            change μ_alg σ (z - (μ_alg σ z ⊗ₜ[R₀] (1 : S))) = 0
            rw [map_sub, hμ_tmul, map_one, mul_one, sub_self]
          rw [hf_ker, Ideal.mem_span_singleton] at hw_ker
          obtain ⟨q, hq⟩ := hw_ker
          have hsub_zero : (z - (μ_alg σ z ⊗ₜ[R₀] (1 : S))) * e_σ = 0 := by
            rw [hq, mul_comm f_σ q, mul_assoc, hfe_zero, mul_zero]
          rwa [sub_mul, sub_eq_zero] at hsub_zero
        refine ⟨e_σ, he_idem, habsorb, fun τ => ?_⟩
        split_ifs with hστ
        · subst hστ; exact hμ_σ_e
        · have hex_ne : ∃ b : S, σ.symm b ≠ τ.symm b := by
            by_contra hall
            rw [not_exists_not] at hall
            exact hστ (AlgEquiv.symm_bijective.injective (AlgEquiv.ext hall))
          obtain ⟨b, hb⟩ := hex_ne
          let z₀ : T_SS := (1 : S) ⊗ₜ[R₀] b
          have heq := congrArg (μ_alg τ) (habsorb z₀)
          rw [map_mul, map_mul] at heq
          have hz₀_τ : μ_alg τ z₀ = τ.symm b := by dsimp [z₀]; rw [hμ_tmul, one_mul]
          have hz₀_σ : μ_alg τ (μ_alg σ z₀ ⊗ₜ[R₀] (1 : S)) = σ.symm b := by
            dsimp [z₀]; rw [hμ_tmul, hμ_tmul, one_mul, map_one, mul_one]
          rw [hz₀_τ, hz₀_σ] at heq
          have hmul0 : (τ.symm b - σ.symm b) * μ_alg τ e_σ = 0 := by
            rw [sub_mul, heq, sub_self]
          exact (mul_eq_zero.mp hmul0).resolve_left (sub_ne_zero.mpr hb.symm)
      choose e_of he_idem he_absorb he_eval using hIdem_ex
      let e_i : Fin m_gal → T_SS := fun i => e_of (equiv_Γ i)
      have hSum_e : (∑ i : Fin m_gal, e_i i) = 1 := by
        have _ : Module.Flat R₀ S := Algebra.Smooth.flat R₀ S
        have _ : Module.Flat R₀ K := IsLocalization.flat K (nonZeroDivisors R₀)
        have _ : Module.Flat R₀ L_r := Module.Flat.trans R₀ K L_r
        let ι_SL : S →ₗ[R₀] L_r := (IsScalarTower.toAlgHom R₀ S L_r).toLinearMap
        have hinj_SL : Function.Injective ι_SL := IsFractionRing.injective S L_r
        have hinj_RL : Function.Injective (TensorProduct.map ι_SL ι_SL) :=
          TensorProduct.map_injective_of_flat_flat ι_SL ι_SL hinj_SL hinj_SL
        have hK_comm_RL : (Algebra.TensorProduct.includeLeftRingHom : L_r →+* TensorProduct R₀ L_r L_r).comp
              (algebraMap K L_r) =
            (Algebra.TensorProduct.includeRight : L_r →ₐ[R₀] TensorProduct R₀ L_r L_r).toRingHom.comp
              (algebraMap K L_r) := by
          apply IsLocalization.ringHom_ext (nonZeroDivisors R₀)
          ext r
          change (algebraMap K L_r (algebraMap R₀ K r)) ⊗ₜ[R₀] (1 : L_r) =
            (1 : L_r) ⊗ₜ[R₀] (algebraMap K L_r (algebraMap R₀ K r))
          rw [← IsScalarTower.algebraMap_apply R₀ K L_r,
            Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
        let q_alg : TensorProduct R₀ L_r L_r →ₐ[R₀] TensorProduct K L_r L_r :=
          Algebra.TensorProduct.lift
            ((Algebra.TensorProduct.includeLeft : L_r →ₐ[K] TensorProduct K L_r L_r).restrictScalars R₀)
            ((Algebra.TensorProduct.includeRight : L_r →ₐ[K] TensorProduct K L_r L_r).restrictScalars R₀)
            (fun _ _ => Commute.all _ _)
        let q_RL_KL : TensorProduct R₀ L_r L_r →+* TensorProduct K L_r L_r := q_alg.toRingHom
        let s_KL_RL : TensorProduct K L_r L_r →ₗ[K] TensorProduct R₀ L_r L_r :=
          TensorProduct.lift
            { toFun := fun x =>
                { toFun := fun y => x ⊗ₜ[R₀] y
                  map_add' := fun y₁ y₂ => TensorProduct.tmul_add x y₁ y₂
                  map_smul' := fun k y => by
                    change x ⊗ₜ[R₀] (k • y) = k • (x ⊗ₜ[R₀] y)
                    rw [Algebra.smul_def, TensorProduct.smul_tmul', Algebra.smul_def]
                    have hk := RingHom.congr_fun hK_comm_RL k
                    change algebraMap K L_r k ⊗ₜ[R₀] (1 : L_r) =
                      (1 : L_r) ⊗ₜ[R₀] algebraMap K L_r k at hk
                    have hm := congrArg (· * (x ⊗ₜ[R₀] y)) hk
                    simpa [Algebra.TensorProduct.tmul_mul_tmul] using hm.symm }
              map_add' := fun x₁ x₂ => LinearMap.ext fun y => TensorProduct.add_tmul x₁ x₂ y
              map_smul' := fun k x => LinearMap.ext fun y => by
                change (k • x) ⊗ₜ[R₀] y = k • (x ⊗ₜ[R₀] y)
                exact (TensorProduct.smul_tmul' k x y).symm }
        have hlin_inv : (s_KL_RL.restrictScalars R₀).comp q_alg.toLinearMap = LinearMap.id := by
          apply TensorProduct.ext'
          intro x y
          dsimp [s_KL_RL, q_alg]
          rw [mul_one, one_mul]
        have hs_left_inv : ∀ z : TensorProduct R₀ L_r L_r, s_KL_RL (q_RL_KL z) = z :=
          fun z => LinearMap.congr_fun hlin_inv z
        let φ_alg : T_SS →ₐ[R₀] TensorProduct K L_r L_r :=
          q_alg.comp (Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom R₀ S L_r) (IsScalarTower.toAlgHom R₀ S L_r))
        let φ_SS_KL : T_SS →+* TensorProduct K L_r L_r := φ_alg.toRingHom
        have hinj_SS_KL : Function.Injective φ_SS_KL := by
          intro a b hab
          apply hinj_RL
          exact (hs_left_inv _).symm.trans ((congrArg s_KL_RL hab).trans (hs_left_inv _))
        let μ_KL : Fin m_gal → (TensorProduct K L_r L_r →ₗ[L_r] L_r) := fun j =>
          (Algebra.TensorProduct.lift (AlgHom.id L_r L_r) (toGal (equiv_Γ j)).symm.toAlgHom
            (fun _ _ => Commute.all _ _)).toLinearMap
        have hμ_φ : ∀ (j : Fin m_gal) (z : T_SS),
            μ_KL j (φ_SS_KL z) = algebraMap S L_r (μ_alg (equiv_Γ j) z) := by
          intro j
          have hlin_μ : ((μ_KL j).restrictScalars R₀).comp φ_alg.toLinearMap =
              (IsScalarTower.toAlgHom R₀ S L_r).toLinearMap.comp
                ((μ_alg (equiv_Γ j)).restrictScalars R₀).toLinearMap := by
            apply TensorProduct.ext'
            intro x y
            change μ_KL j (φ_SS_KL (x ⊗ₜ[R₀] y)) = algebraMap S L_r (μ_alg (equiv_Γ j) (x ⊗ₜ[R₀] y))
            have hphi_tmul : φ_SS_KL (x ⊗ₜ[R₀] y) = algebraMap S L_r x ⊗ₜ[K] algebraMap S L_r y := by
              dsimp [φ_SS_KL, φ_alg, q_alg]
              rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.lift_tmul]
              change (algebraMap S L_r x ⊗ₜ[K] (1 : L_r)) * ((1 : L_r) ⊗ₜ[K] algebraMap S L_r y) = _
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            rw [hphi_tmul, hμ_tmul]
            dsimp [μ_KL]
            have hsymm : toGal (equiv_Γ j).symm = (toGal (equiv_Γ j)).symm := by
              apply AlgEquiv.ext; intro w
              apply (toGal (equiv_Γ j)).injective
              rw [AlgEquiv.apply_symm_apply]
              have hcomp : (toGal (equiv_Γ j)).toRingHom.comp (toGal (equiv_Γ j).symm).toRingHom =
                  RingHom.id L_r := by
                apply IsLocalization.ringHom_ext (nonZeroDivisors S)
                ext b
                change toGal (equiv_Γ j) (toGal (equiv_Γ j).symm (algebraMap S L_r b)) =
                  algebraMap S L_r b
                rw [IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L_r L_r (equiv_Γ j).symm b,
                  IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L_r L_r (equiv_Γ j),
                  AlgEquiv.apply_symm_apply]
              exact RingHom.congr_fun hcomp w
            rw [← hsymm, IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L_r L_r (equiv_Γ j).symm y,
              map_mul]
          exact fun z => LinearMap.congr_fun hlin_μ z
        let span_L : (Fin m_gal → L_r) →ₗ[L_r] TensorProduct K L_r L_r :=
          { toFun := fun v => ∑ i : Fin m_gal, v i • φ_SS_KL (e_i i)
            map_add' := fun v w => by
              simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
            map_smul' := fun c v => by
              simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, mul_smul] }
        have hspan_eval : ∀ (v : Fin m_gal → L_r) (j : Fin m_gal), μ_KL j (span_L v) = v j := by
          intro v j
          dsimp [span_L]
          rw [map_sum]
          have hterm : ∀ i : Fin m_gal,
              μ_KL j (v i • φ_SS_KL (e_i i)) = if i = j then v i else 0 := by
            intro i
            rw [map_smul, hμ_φ j (e_i i), he_eval (equiv_Γ i) (equiv_Γ j)]
            by_cases hij : i = j
            · subst hij; simp
            · have hne : equiv_Γ i ≠ equiv_Γ j := fun h => hij (equiv_Γ.injective h)
              simp [hne, hij]
          simp_rw [hterm]
          simp
        have hspan_inj : Function.Injective span_L := fun v w hvw => by
          ext j
          rw [← hspan_eval v j, ← hspan_eval w j, hvw]
        have hfin_eq : Module.finrank L_r (Fin m_gal → L_r) =
            Module.finrank L_r (TensorProduct K L_r L_r) := by
          rw [Module.finrank_fin_fun L_r,
            @Module.finrank_tensorProduct L_r K L_r L_r, Module.finrank_self L_r, one_mul]
        have hspan_surj : Function.Surjective span_L :=
          (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin_eq).mp hspan_inj
        obtain ⟨v₁, hv₁⟩ := hspan_surj 1
        have hv₁_eq : v₁ = fun _ => 1 := by
          ext j
          have h1 := hspan_eval v₁ j
          rw [hv₁] at h1
          have hμ1 : μ_KL j 1 = 1 := map_one (Algebra.TensorProduct.lift (AlgHom.id L_r L_r)
            (toGal (equiv_Γ j)).symm.toAlgHom (fun _ _ => Commute.all _ _))
          exact h1.symm.trans hμ1
        apply hinj_SS_KL
        rw [map_sum, map_one, ← hv₁, hv₁_eq]
        simp [span_L]
      have hPrimeCover : ∀ P : PrimeSpectrum T_SS,
          ∃ σ : S ≃ₐ[R₀] S,
            PrimeSpectrum.comap (μ_alg σ).toRingHom
              (PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom P) = P := by
        intro P
        have hnot : (∑ i : Fin m_gal, e_i i) ∉ P.asIdeal := by
          rw [hSum_e]; exact P.isPrime.one_notMem
        obtain ⟨i, _, hi_not⟩ : ∃ i ∈ Finset.univ, e_i i ∉ P.asIdeal := by
          by_contra hall
          rw [not_exists] at hall
          exact hnot (Ideal.sum_mem P.asIdeal fun j hj => not_not.mp fun hnj => hall j ⟨hj, hnj⟩)
        refine ⟨equiv_Γ i, PrimeSpectrum.ext ?_⟩
        ext z
        change (μ_alg (equiv_Γ i) z ⊗ₜ[R₀] (1 : S)) ∈ P.asIdeal ↔ z ∈ P.asIdeal
        have habs := he_absorb (equiv_Γ i) z
        constructor
        · intro hmem
          have hmul : z * e_i i ∈ P.asIdeal := by
            dsimp [e_i]; rw [habs]; exact Ideal.mul_mem_right _ P.asIdeal hmem
          exact (P.isPrime.mem_or_mem hmul).resolve_right hi_not
        · intro hmem
          have hmul : (μ_alg (equiv_Γ i) z ⊗ₜ[R₀] (1 : S)) * e_i i ∈ P.asIdeal := by
            dsimp [e_i]; rw [← habs]; exact Ideal.mul_mem_right _ P.asIdeal hmem
          exact (P.isPrime.mem_or_mem hmul).resolve_right hi_not
      refine ⟨fun W h_W => ?_, fun Y g_Y => ?_⟩
      · have hpb_W := (CategoryTheory.IsPullback.of_hasPullback h_W π).flip
        have het_fst : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W hπ_et_s
        have hsurj_fst : AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W hπ_surj
        refine ⟨⟨het_fst, hsurj_fst⟩, fun σ => ?_⟩
        refine ⟨CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst h_W π)
            (CategoryTheory.Limits.pullback.snd h_W π ≫ α_hom σ)
            (by rw [CategoryTheory.Category.assoc, hα_π σ, CategoryTheory.Limits.pullback.condition]),
          ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _,
            CategoryTheory.Limits.pullback.lift_snd _ _ _⟩,
          fun m_σ ⟨hm₁, hm₂⟩ => CategoryTheory.Limits.pullback.hom_ext
            (hm₁.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
            (hm₂.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)⟩
      · let δ : (S ≃ₐ[R₀] S) → (Y ⟶ CategoryTheory.Limits.pullback (g_Y ≫ π) π) := fun σ =>
          CategoryTheory.Limits.pullback.lift (𝟙 Y) (g_Y ≫ α_hom σ)
            (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hα_π σ])
        refine ⟨δ, fun σ => ?_, ?_⟩
        · have hfst : δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π = 𝟙 Y :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hsnd : δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π = g_Y ≫ α_hom σ :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hpb_Y := (CategoryTheory.IsPullback.of_hasPullback (g_Y ≫ π) π).flip
          have : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π) :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Y hπ_et_s
          have _ : AlgebraicGeometry.Etale
              (δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π) := by
            rw [hfst]; infer_instance
          have het_δ : AlgebraicGeometry.Etale (δ σ) :=
            AlgebraicGeometry.Etale.of_comp (δ σ) (CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π)
          exact ⟨hfst, hsnd, het_δ⟩
        · let π₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ S))
          let P_VV := CategoryTheory.Limits.pullback π π
          let fst_VV := CategoryTheory.Limits.pullback.fst π π
          let snd_VV := CategoryTheory.Limits.pullback.snd π π
          let Δ_σ : (S ≃ₐ[R₀] S) → (V ⟶ P_VV) := fun σ =>
            CategoryTheory.Limits.pullback.lift (𝟙 V) (α_hom σ)
              (by rw [CategoryTheory.Category.id_comp, hα_π σ])
          have hCover_PVV : ∀ w : ↥P_VV, ∃ (σ : S ≃ₐ[R₀] S) (v : ↥V), (Δ_σ σ).base v = w := by
            intro w
            let P₀ := CategoryTheory.Limits.pullback π₀ π₀
            have hcond₀ : fst_VV ≫ π₀ = snd_VV ≫ π₀ := by
              have hc := CategoryTheory.Limits.pullback.condition (f := π) (g := π)
              dsimp [π] at hc
              rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc] at hc
              exact (cancel_mono e_U.hom).mp hc
            let toP₀ : P_VV ⟶ P₀ := CategoryTheory.Limits.pullback.lift fst_VV snd_VV hcond₀
            let fromP₀ : P₀ ⟶ P_VV := CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst π₀ π₀)
              (CategoryTheory.Limits.pullback.snd π₀ π₀)
              (by
                dsimp [π]
                rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.condition])
            have hto_from : toP₀ ≫ fromP₀ = 𝟙 P_VV := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · dsimp [toP₀, fromP₀]
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
              · dsimp [toP₀, fromP₀]
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
            let iso_Spec := AlgebraicGeometry.pullbackSpecIso R₀ S S
            let P_pt : PrimeSpectrum T_SS := (toP₀ ≫ iso_Spec.hom).base w
            obtain ⟨σ, hP_eq⟩ := hPrimeCover P_pt
            let v : ↥V := PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom P_pt
            refine ⟨σ, v, ?_⟩
            have hv_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_alg σ).toRingHom)).base v =
                P_pt := hP_eq
            have hmor_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_alg σ).toRingHom) ≫
                iso_Spec.inv ≫ fromP₀ = Δ_σ σ := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
                dsimp [iso_Spec, π₀]
                rw [AlgebraicGeometry.pullbackSpecIso_inv_fst,
                  ← AlgebraicGeometry.Spec.map_comp]
                refine (congrArg AlgebraicGeometry.Spec.map ?_).trans
                  (AlgebraicGeometry.Spec.map_id (CommRingCat.of S))
                apply CommRingCat.hom_ext; ext b
                change μ_alg σ (b ⊗ₜ[R₀] 1) = b
                rw [hμ_tmul, map_one, mul_one]
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
                dsimp [iso_Spec, π₀]
                rw [AlgebraicGeometry.pullbackSpecIso_inv_snd,
                  ← AlgebraicGeometry.Spec.map_comp]
                apply congrArg AlgebraicGeometry.Spec.map
                apply CommRingCat.hom_ext; ext b
                change μ_alg σ (1 ⊗ₜ[R₀] b) = σ.symm b
                rw [hμ_tmul, one_mul]
            calc (Δ_σ σ).base v
                = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_alg σ).toRingHom) ≫
                    iso_Spec.inv ≫ fromP₀).base v := congrArg (fun m => m.base v) hmor_eq.symm
              _ = fromP₀.base (iso_Spec.inv.base
                    ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_alg σ).toRingHom)).base v)) := rfl
              _ = fromP₀.base (iso_Spec.inv.base P_pt) := by rw [hv_spec]
              _ = (toP₀ ≫ iso_Spec.hom ≫ iso_Spec.inv ≫ fromP₀).base w := rfl
              _ = w := by
                  rw [iso_Spec.hom_inv_id_assoc, hto_from]
                  rfl
          let fst_Y := CategoryTheory.Limits.pullback.fst (g_Y ≫ π) π
          let snd_Y := CategoryTheory.Limits.pullback.snd (g_Y ≫ π) π
          let q_Y : CategoryTheory.Limits.pullback (g_Y ≫ π) π ⟶ P_VV :=
            CategoryTheory.Limits.pullback.lift (fst_Y ≫ g_Y) snd_Y
              (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
          have hpb_right : CategoryTheory.IsPullback q_Y fst_Y fst_VV g_Y := by
            have houter : CategoryTheory.IsPullback (q_Y ≫ snd_VV) fst_Y π (g_Y ≫ π) := by
              have hs : q_Y ≫ snd_VV = snd_Y := CategoryTheory.Limits.pullback.lift_snd _ _ _
              rw [hs]
              exact (CategoryTheory.IsPullback.of_hasPullback (g_Y ≫ π) π).flip
            exact CategoryTheory.IsPullback.of_right houter
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.IsPullback.of_hasPullback π π).flip
          ext z
          simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
          obtain ⟨σ, v, hv⟩ := hCover_PVV (q_Y.base z)
          have hpb_δ : CategoryTheory.IsPullback (δ σ) g_Y q_Y (Δ_σ σ) := by
            have houter_δ : CategoryTheory.IsPullback (δ σ ≫ fst_Y) g_Y g_Y (Δ_σ σ ≫ fst_VV) := by
              have hf₁ : δ σ ≫ fst_Y = 𝟙 Y := CategoryTheory.Limits.pullback.lift_fst _ _ _
              have hf₂ : Δ_σ σ ≫ fst_VV = 𝟙 V := CategoryTheory.Limits.pullback.lift_fst _ _ _
              rw [hf₁, hf₂]
              exact CategoryTheory.IsPullback.of_horiz_isIso
                ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
            have hcomm_δ : δ σ ≫ q_Y = g_Y ≫ Δ_σ σ := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · dsimp [δ, q_Y, Δ_σ, fst_Y, fst_VV]
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
              · dsimp [δ, q_Y, Δ_σ, snd_Y, snd_VV]
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd]
            exact CategoryTheory.IsPullback.of_right houter_δ hcomm_δ hpb_right.flip
          obtain ⟨y, hy, _⟩ :=
            AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_δ z v hv.symm
          exact ⟨σ, y, hy⟩
    exact ⟨hSliceEquiv, hTorsor_s⟩

  
  have hCombined : ∀ r : ℕ,
      let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
      let π_r : V_r ⟶ U :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      let j_r := weilEtalePostcomp π_r (hπ_et r)
      (∃ Φ_r : ∀ Y : V_r.Etale,
          ↑((ℛ r).obj.obj (Opposite.op (j_r.obj Y))) ≃+ LocallyConstant ↥Y.left (H r),
        (∀ {Y₁ Y₂ : V_r.Etale} (f : Y₁ ⟶ Y₂) (u_f : j_r.obj Y₁ ⟶ j_r.obj Y₂),
          u_f.left = f.left →
          ∀ (s : ↑((ℛ r).obj.obj (Opposite.op (j_r.obj Y₂)))) (y₁ : ↥Y₁.left),
            Φ_r Y₁ (((ℛ r).obj.map (Opposite.op u_f)).hom s) y₁ =
              Φ_r Y₂ s (f.left.base y₁)) ∧
        (letI := hπ_et r
         let T_V : V_r.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V_r)
         ∀ (u_id : j_r.obj T_V ⟶ AlgebraicGeometry.Scheme.Etale.mk π_r),
           u_id.left = 𝟙 V_r →
           ∀ (s : ↑((ℛ r).obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk π_r)))) (x : ↥V_r),
             Φ_r T_V (((ℛ r).obj.map (Opposite.op u_id)).hom s) x = eval_V r s)) ∧
      ((∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : W ⟶ U),
          let W_V := CategoryTheory.Limits.pullback h_W π_r
          (AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π_r) ∧
            AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π_r)) ∧
          (∀ σ : B r ≃ₐ[R₀] B r, ∃! m_σ : W_V ⟶ W_V,
            m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π_r =
              CategoryTheory.Limits.pullback.fst h_W π_r ∧
            m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π_r =
              CategoryTheory.Limits.pullback.snd h_W π_r ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom))) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V_r),
          let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π_r) π_r
          ∃ δ : (B r ≃ₐ[R₀] B r) → (Y ⟶ Y_V),
            (∀ σ : B r ≃ₐ[R₀] B r,
              δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r) π_r = 𝟙 Y ∧
              δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r) π_r =
                g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
              AlgebraicGeometry.Etale (δ σ)) ∧
            (⋃ σ : B r ≃ₐ[R₀] B r, Set.range (δ σ).base) = Set.univ)) := by
    intro r
    obtain ⟨A_r, hPull_r⟩ := hConst r
    exact hPart1 (B r) (L r) (hπ_et r) (ℛ r) A_r hPull_r (H r) (eval_V r)

  have hTorsor : ∀ r : ℕ,
      let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
      let π_r := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (h_W : W ⟶ U),
        let W_V := CategoryTheory.Limits.pullback h_W π_r
        (AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h_W π_r) ∧
          AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.fst h_W π_r)) ∧
        (∀ σ : B r ≃ₐ[R₀] B r, ∃! m_σ : W_V ⟶ W_V,
          m_σ ≫ CategoryTheory.Limits.pullback.fst h_W π_r =
            CategoryTheory.Limits.pullback.fst h_W π_r ∧
          m_σ ≫ CategoryTheory.Limits.pullback.snd h_W π_r =
            CategoryTheory.Limits.pullback.snd h_W π_r ≫
