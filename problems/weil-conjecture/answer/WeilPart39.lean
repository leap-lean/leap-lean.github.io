      CategoryTheory.Limits.pullback h_W (π_BV (r + 1)) ⟶
        CategoryTheory.Limits.pullback h_W (π_BV r) :=
    fun r W =>
      let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst h_W (π_BV (r + 1)))
        (CategoryTheory.Limits.pullback.snd h_W (π_BV (r + 1)) ≫ p_ι r)
