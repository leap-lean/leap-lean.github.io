theorem weil_mid_dev_raw_cup_torsion_pullback_comm (m₀ i j k : ℕ) (h_ijk : i + j = k) :
    ∃ cup_tors : ∀ S : AlgebraicGeometry.Scheme.{u},
        weilEtaleTorsionH S m₀ i →+ weilEtaleTorsionH S m₀ j →+ weilEtaleTorsionH S m₀ k,
      (∀ (S : AlgebraicGeometry.Scheme.{u})
          (θ_i : weilEtaleModuleH S m₀ i →+ weilEtaleTorsionH S m₀ i)
          (θ_j : weilEtaleModuleH S m₀ j →+ weilEtaleTorsionH S m₀ j)
          (θ_k : weilEtaleModuleH S m₀ k →+ weilEtaleTorsionH S m₀ k),
        WeilIsModuleToTorsionComparison S m₀ i θ_i →
        WeilIsModuleToTorsionComparison S m₀ j θ_j →
        WeilIsModuleToTorsionComparison S m₀ k θ_k →
        ∀ (a : weilEtaleModuleH S m₀ i) (b : weilEtaleModuleH S m₀ j),
          cup_tors S (θ_i a) (θ_j b) = θ_k (CategoryTheory.Abelian.Ext.comp a b h_ijk)) ∧
      (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
          (p_i : weilEtaleTorsionH S₂ m₀ i →+ weilEtaleTorsionH S₁ m₀ i)
          (p_j : weilEtaleTorsionH S₂ m₀ j →+ weilEtaleTorsionH S₁ m₀ j)
          (p_k : weilEtaleTorsionH S₂ m₀ k →+ weilEtaleTorsionH S₁ m₀ k),
        WeilIsTorsionEtalePullback h m₀ i p_i →
        WeilIsTorsionEtalePullback h m₀ j p_j →
        WeilIsTorsionEtalePullback h m₀ k p_k →
        ∀ (x : weilEtaleTorsionH S₂ m₀ i) (y : weilEtaleTorsionH S₂ m₀ j),
          p_k (cup_tors S₂ x y) = cup_tors S₁ (p_i x) (p_j y)) :=
by
  have hExtConjComp :
      ∀ {C_ab D_ab : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} C_ab] [CategoryTheory.Abelian C_ab]
        [CategoryTheory.HasExt.{u} C_ab]
        [CategoryTheory.Category.{u + 1, u + 1} D_ab] [CategoryTheory.Abelian D_ab]
        [CategoryTheory.HasExt.{u} D_ab]
        (F_ex : CategoryTheory.Functor C_ab D_ab)
        [F_ex.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F_ex]
        [CategoryTheory.Limits.PreservesFiniteColimits F_ex]
        {X₀ : C_ab} {M : D_ab}
        (η : M ⟶ F_ex.obj X₀) (ε : F_ex.obj X₀ ⟶ M),
        ε ≫ η = 𝟙 (F_ex.obj X₀) →
        ∀ (α : CategoryTheory.Abelian.Ext.{u} X₀ X₀ i)
          (β : CategoryTheory.Abelian.Ext.{u} X₀ X₀ j),
          let pull : ∀ q : ℕ, CategoryTheory.Abelian.Ext.{u} X₀ X₀ q →
              CategoryTheory.Abelian.Ext.{u} M M q :=
            fun q x => (CategoryTheory.Abelian.Ext.mk₀ η).comp
              (((F_ex.mapExtAddHom X₀ X₀ q) x).comp (CategoryTheory.Abelian.Ext.mk₀ ε)
                (Nat.add_zero q)) (Nat.zero_add q)
          (pull i α).comp (pull j β) h_ijk = pull k (α.comp β h_ijk) := by
    intro C_ab D_ab _ _ _ _ _ _ F_ex _ _ _ X₀ M η ε hεη α β pull
    dsimp only [pull]
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp]
    let a' := CategoryTheory.Abelian.Ext.mapExactFunctor F_ex α
    let b' := CategoryTheory.Abelian.Ext.mapExactFunctor F_ex β
    change ((CategoryTheory.Abelian.Ext.mk₀ η).comp
        (a'.comp (CategoryTheory.Abelian.Ext.mk₀ ε) (Nat.add_zero i)) (Nat.zero_add i)).comp
        ((CategoryTheory.Abelian.Ext.mk₀ η).comp
          (b'.comp (CategoryTheory.Abelian.Ext.mk₀ ε) (Nat.add_zero j)) (Nat.zero_add j)) h_ijk =
      (CategoryTheory.Abelian.Ext.mk₀ η).comp
        ((a'.comp b' h_ijk).comp (CategoryTheory.Abelian.Ext.mk₀ ε) (Nat.add_zero k))
        (Nat.zero_add k)
