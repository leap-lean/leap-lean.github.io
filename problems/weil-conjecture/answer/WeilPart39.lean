    let _ : FiniteDimensional K ↥E₀ := hFD₀
    let _ : IsGalois K ↥E₀ := hGal₀
    let _ : Algebra R₀ ↥E₀ := ((algebraMap K ↥E₀).comp (algebraMap R₀ K)).toAlgebra
    have : IsScalarTower R₀ K ↥E₀ := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let B₀ := ↥(integralClosure R₀ ↥E₀)

    have hEt_B₀ : Module.Finite R₀ B₀ ∧ Algebra.Etale R₀ B₀ := by
      refine hTracePkg.2 hNotField @hFinRes ↥E₀ (fun p hp P hP hP_comap => ?_)
      let _ : Finite (R₀ ⧸ p) := @hFinRes p hp
      let x_p : ↥U₀ := (⟨p, inferInstance⟩ : PrimeSpectrum R₀)
      obtain ⟨W_p, w_p, A_p, hw_p_et, ⟨z_p, hz_p⟩, _, hPull_wp⟩ := hLC_U₀ x_p
      let _ : AlgebraicGeometry.Etale w_p := hw_p_et
      obtain ⟨R_D, j_D, hj_open, ⟨q_D, hq_D⟩, _⟩ :=
        AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
          (X := W_p) (U := ⊤) (x := z_p) trivial
      have : AlgebraicGeometry.Etale j_D := inferInstance
      have h_et_comp : AlgebraicGeometry.Etale (j_D ≫ w_p) := inferInstance
      let φ_D : CommRingCat.of R₀ ⟶ R_D := AlgebraicGeometry.Spec.preimage (j_D ≫ w_p)
      have hφ_map : AlgebraicGeometry.Spec.map φ_D = j_D ≫ w_p :=
        AlgebraicGeometry.Spec.map_preimage (j_D ≫ w_p)
      have hφ_et : RingHom.Etale φ_D.hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hφ_map.symm ▸ h_et_comp)
      let D_p : Type u := ↑R_D
      let _ : Algebra R₀ D_p := φ_D.hom.toAlgebra
      have : Algebra.Etale R₀ D_p := RingHom.etale_algebraMap.mp hφ_et
      have hq_base : (AlgebraicGeometry.Spec.map φ_D).base q_D = x_p := by
        rw [hφ_map]
        change w_p.base (j_D.base q_D) = x_p
        rw [hq_D, hz_p]
      have hq_comap : Ideal.comap (algebraMap R₀ D_p) q_D.asIdeal = p :=
        congrArg PrimeSpectrum.asIdeal hq_base
      have : q_D.asIdeal.IsPrime := q_D.isPrime
      obtain ⟨s₀, _, hDomC, hPrimeQC, hComapQC⟩ := hDVRPkg.1 D_p q_D.asIdeal
      let C_p := Localization.Away s₀
      let Q_C := Ideal.map (algebraMap D_p C_p) q_D.asIdeal
      let _ : IsDomain C_p := hDomC
      let _ : Q_C.IsPrime := hPrimeQC
      have : Algebra.Etale D_p C_p := Algebra.Etale.of_isLocalizationAway s₀
      have : Algebra.Etale R₀ C_p := Algebra.Etale.comp R₀ D_p C_p
      have hQC_over : Ideal.comap (algebraMap R₀ C_p) Q_C = p := by
        rw [IsScalarTower.algebraMap_eq R₀ D_p C_p, ← Ideal.comap_comap, hComapQC, hq_comap]
      let h_Cp_mor : AlgebraicGeometry.Spec (CommRingCat.of C_p) ⟶ W_p :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D_p C_p)) ≫ j_D
      have hSpec_Cp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C_p)) =
          h_Cp_mor ≫ w_p := by
        dsimp [h_Cp_mor]
        rw [CategoryTheory.Category.assoc, ← hφ_map, ← AlgebraicGeometry.Spec.map_comp]
        apply congrArg AlgebraicGeometry.Spec.map
        apply CommRingCat.hom_ext
        exact IsScalarTower.algebraMap_eq R₀ D_p C_p
      have hPull_Cp : WeilIsEtaleSheafPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C_p))) 𝒢₀
          ((CategoryTheory.constantSheaf
            (AlgebraicGeometry.Spec (CommRingCat.of C_p)).smallEtaleTopology
            AddCommGrpCat.{u}).obj A_p) := by
        rw [hSpec_Cp]
        exact (hPbPkg.2.2.1 h_Cp_mor w_p 𝒢₀ _ _).1 hPull_wp (hPbPkg.2.2.2.1 h_Cp_mor A_p)
