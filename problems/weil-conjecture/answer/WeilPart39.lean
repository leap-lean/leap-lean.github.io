              hmσ_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, hmσ_snd,
              ← CategoryTheory.Category.assoc (m_can W),
              CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc m_τ,
              CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hp_deck]
        have hm_pt : m_σ.base ((m_can W).base y) = (m_can W).base (m_τ.base y) :=
          (congrArg (fun k : W₂ ⟶ W₁ => k.base y) hm_τ_m).symm
        change f₁_fun (m_σ.base ((m_can W).base y)) =
          ((ρ_V r σ).val).mulVec (f₁_fun ((m_can W).base y))
        rw [hm_pt, hf₁_comp (m_τ.base y), hf₁_comp y]
        exact hF_equiv W s₂ τ σ hτ_lift m_τ
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) y
      obtain ⟨s₁, hs₁⟩ := hf₁_mem
      refine ⟨s₁, fun y₂ => ?_⟩
      rw [hs₁]
      exact hf₁_comp y₂
    let Φ_fun : ∀ W : U₀.toScheme.Etale,
        ↑(ℱ₂.obj.obj (Opposite.op W)) → ↑((𝒱₀ r).obj.obj (Opposite.op W)) :=
      fun W s₂ => Classical.choose (hPointwise W s₂)
    have hΦ_spec : ∀ (W : U₀.toScheme.Etale) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W)))
        (y₂ : ↥(CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π₂)),
        triv r W (Φ_fun W s₂) ((m_can W).base y₂) = F_φ W s₂ y₂ :=
      fun W s₂ => Classical.choose_spec (hPointwise W s₂)
    let Φ_app : ∀ W_op : (U₀.toScheme.Etale)ᵒᵖ,
        ℱ₂.obj.obj W_op ⟶ (𝒱₀ r).obj.obj W_op :=
      fun W_op =>
        let W := Opposite.unop W_op
        have _ : AlgebraicGeometry.Surjective (m_can W) := (hm_props W).1.2
        have hSurj_W : Function.Surjective (m_can W).base := (m_can W).surjective
        have hInj_W : Function.Injective (triv r W) := ((hTriv_base r).2.2 W).1
        AddCommGrpCat.ofHom
          { toFun := Φ_fun W
            map_zero' := by
              apply hInj_W
              ext x i
              obtain ⟨y₂, rfl⟩ := hSurj_W x
              rw [hΦ_spec W 0 y₂, map_zero, map_zero, LocallyConstant.zero_apply,
                LocallyConstant.zero_apply]
            map_add' := fun a b => by
              apply hInj_W
              ext x i
              obtain ⟨y₂, rfl⟩ := hSurj_W x
              rw [hΦ_spec W (a + b) y₂, map_add, map_add, LocallyConstant.add_apply,
                LocallyConstant.add_apply, Pi.add_apply, Pi.add_apply,
                hΦ_spec W a y₂, hΦ_spec W b y₂] }
    have hΦ_nat : ∀ ⦃X Y : (U₀.toScheme.Etale)ᵒᵖ⦄ (f : X ⟶ Y),
        ℱ₂.obj.map f ≫ Φ_app Y = Φ_app X ≫ (𝒱₀ r).obj.map f := by
      intro X Y f
      let W₂_et := Opposite.unop X
      let W₁_et := Opposite.unop Y
      let u : W₁_et ⟶ W₂_et := f.unop
      have hf_eq : f = Opposite.op u := rfl
      rw [hf_eq]
      apply AddCommGrpCat.ext
      intro s₂
      have _ : AlgebraicGeometry.Surjective (m_can W₁_et) := (hm_props W₁_et).1.2
      have hSurj_1 : Function.Surjective (m_can W₁_et).base := (m_can W₁_et).surjective
      have hInj_1 : Function.Injective (triv r W₁_et) := ((hTriv_base r).2.2 W₁_et).1
      apply hInj_1
      ext x₁ i
      obtain ⟨y₁, rfl⟩ := hSurj_1 x₁
      let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁_et).hom
      let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂_et).hom
      let u_left := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left
      have hu_w : u_left ≫ h₂ = h₁ :=
        ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).w
      let u_1 : CategoryTheory.Limits.pullback h₁ (π_BV r) ⟶
          CategoryTheory.Limits.pullback h₂ (π_BV r) :=
        CategoryTheory.Limits.pullback.map h₁ (π_BV r) h₂ (π_BV r)
          u_left (𝟙 _) (𝟙 U₀.toScheme)
          (by rw [CategoryTheory.Category.comp_id, hu_w])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      let u_2 : CategoryTheory.Limits.pullback h₁ π₂ ⟶
          CategoryTheory.Limits.pullback h₂ π₂ :=
        CategoryTheory.Limits.pullback.map h₁ π₂ h₂ π₂
          u_left (𝟙 _) (𝟙 U₀.toScheme)
          (by rw [CategoryTheory.Category.comp_id, hu_w])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have hu_1_fst : u_1 ≫ CategoryTheory.Limits.pullback.fst h₂ (π_BV r) =
          CategoryTheory.Limits.pullback.fst h₁ (π_BV r) ≫ u_left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu_1_snd : u_1 ≫ CategoryTheory.Limits.pullback.snd h₂ (π_BV r) =
          CategoryTheory.Limits.pullback.snd h₁ (π_BV r) :=
        (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id _)
      have hu_2_fst : u_2 ≫ CategoryTheory.Limits.pullback.fst h₂ π₂ =
          CategoryTheory.Limits.pullback.fst h₁ π₂ ≫ u_left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hu_2_snd : u_2 ≫ CategoryTheory.Limits.pullback.snd h₂ π₂ =
          CategoryTheory.Limits.pullback.snd h₁ π₂ :=
        (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id _)
      have hm_comm : m_can W₁_et ≫ u_1 = u_2 ≫ m_can W₂_et := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hu_1_fst, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, hu_2_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            hu_1_snd, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, hu_2_snd]
      have hm_pt : u_1.base ((m_can W₁_et).base y₁) = (m_can W₂_et).base (u_2.base y₁) :=
        congrArg (fun k => k.base y₁) hm_comm
      change triv r W₁_et (Φ_fun W₁_et ((ℱ₂.obj.map (Opposite.op u)) s₂))
          ((m_can W₁_et).base y₁) i =
        triv r W₁_et (((𝒱₀ r).obj.map (Opposite.op u)) (Φ_fun W₂_et s₂))
          ((m_can W₁_et).base y₁) i
      rw [hΦ_spec W₁_et _ y₁,
        hF_nat u u_2 hu_2_fst hu_2_snd s₂ y₁,
        (hTriv_base r).2.1 u u_1 hu_1_fst hu_1_snd (Φ_fun W₂_et s₂) ((m_can W₁_et).base y₁),
        hm_pt, hΦ_spec W₂_et s₂ (u_2.base y₁)]
    refine ⟨{ hom := { app := Φ_app, naturality := hΦ_nat } }, ?_⟩
    intro W h_W W₁ W₂ s₂ m_hom hm_fst hm_snd y₂
    have hm_eq : m_hom = m_can W := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact hm_fst.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact hm_snd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    rw [hm_eq]
    exact hΦ_spec W s₂ y₂

  
  let castHom_r : ∀ r : ℕ, ZMod (ℓ ^ (r + 2)) →+* ZMod (ℓ ^ (r + 1)) :=
    fun r => ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
  let castVec_r : ∀ r : ℕ,
      (Fin N → ZMod (ℓ ^ (r + 2))) →+ (Fin N → ZMod (ℓ ^ (r + 1))) :=
    fun r =>
      { toFun := fun v i => castHom_r r (v i)
        map_zero' := by ext i; exact map_zero (castHom_r r)
        map_add' := fun u v => by ext i; exact map_add (castHom_r r) (u i) (v i) }
  have hEx_τ : ∀ r : ℕ,
      ∃ τ_r : Quiver.Hom (𝒱₀ (r + 1)) (𝒱₀ r),
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W (π_BV r)
          let W_succ := CategoryTheory.Limits.pullback h_W (π_BV (r + 1))
          ∀ (s_up : ↑((𝒱₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            m_ι ≫ CategoryTheory.Limits.pullback.fst h_W (π_BV r) =
              CategoryTheory.Limits.pullback.fst h_W (π_BV (r + 1)) →
            m_ι ≫ CategoryTheory.Limits.pullback.snd h_W (π_BV r) =
              CategoryTheory.Limits.pullback.snd h_W (π_BV (r + 1)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_BV r).toRingHom) →
            ∀ (y_up : ↥W_succ),
              triv r W ((τ_r.hom.app (Opposite.op W)) s_up) (m_ι.base y_up) =
                castVec_r r (triv (r + 1) W s_up y_up) := by
    intro r
    refine hQuotDescent r (B_V (r + 1)) (L_V (r + 1)) (ι_BV r) (hι_BV r).1 (𝒱₀ (r + 1))
      (fun W => (LocallyConstant.mapAddMonoidHom (castVec_r r)).comp (triv (r + 1) W))
      ?_ ?_
    · intro W₁ W₂ u h₁ h₂ W₁_2 W₂_2 u₂ hu_fst hu_snd s₂ y₁
      exact congrArg (castVec_r r) ((hTriv_base (r + 1)).2.1 u u₂ hu_fst hu_snd s₂ y₁)
    · intro W h_W W₂ s₂ τ σ hcomp m_τ hm_fst hm_snd y
      have hf_mem : triv (r + 1) W s₂ ∈ Set.range (triv (r + 1) W) := ⟨s₂, rfl⟩
      rw [((hTriv_base (r + 1)).2.2 W).2] at hf_mem
      have hf_eq := hf_mem τ m_τ hm_fst hm_snd y
      obtain ⟨σ', hσ'_alg, hσ'_mat⟩ := (hι_BV r).2 τ
      have hσ'_eq : σ' = σ := by
        ext b
        exact (hι_BV r).1 ((hσ'_alg b).symm.trans (hcomp b))
      rw [hσ'_eq] at hσ'_mat
      ext i
      change castHom_r r (triv (r + 1) W s₂ (m_τ.base y) i) =
        ((ρ_V r σ).val).mulVec (castVec_r r (triv (r + 1) W s₂ y)) i
      rw [hf_eq, RingHom.map_mulVec]
      change (((ρ_V (r + 1) τ).val).map (castHom_r r)).mulVec
          (castVec_r r (triv (r + 1) W s₂ y)) i = _
      rw [hσ'_mat]
  choose τ_𝒱 hτ_𝒱_spec using hEx_τ

  
  have hEx_β : ∀ r : ℕ,
      ∃ β_r : Quiver.Hom (ℛ r) (𝒱₀ r),
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_V := CategoryTheory.Limits.pullback h_W (π_BV r)
          let W_raw := CategoryTheory.Limits.pullback h_W (π_Braw r)
          ∀ (t : ↑((ℛ r).obj.obj (Opposite.op W)))
