    let ι := algebraMap (PadicInt ℓ) (Padic ℓ)
    let F_Q := (F_V_u.val).map ι
    have hFQ_pow : ∀ k : ℕ,
        (F_Q ^ k).transpose * J_V * (F_Q ^ k) =
          ((Nat.card F : Padic ℓ) ^ ((2 * m + 1) * k)) • J_V := by
      intro k
      induction k with
      | zero =>
        rw [pow_zero, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one, Nat.mul_zero,
          pow_zero, one_smul]
      | succ k ih =>
        calc (F_Q ^ (k + 1)).transpose * J_V * (F_Q ^ (k + 1))
            = ((F_Q ^ k).transpose * F_Q.transpose) * J_V * (F_Q * F_Q ^ k) := by
                rw [pow_succ', Matrix.transpose_mul]
          _ = (F_Q ^ k).transpose * (F_Q.transpose * J_V * F_Q) * (F_Q ^ k) := by
                simp only [Matrix.mul_assoc]
          _ = ((Nat.card F : Padic ℓ) ^ (2 * m + 1)) • ((F_Q ^ k).transpose * J_V * (F_Q ^ k)) := by
                rw [hFVu_sim, Matrix.mul_smul, Matrix.smul_mul]
          _ = ((Nat.card F : Padic ℓ) ^ ((2 * m + 1) * (k + 1))) • J_V := by
                rw [ih, smul_smul, ← pow_add]
                congr 2
                ring
    obtain ⟨g_P, hg_P, hCoset⟩ := hFVmat_coset d P_poly hP
    let G_P := (g_P.val).map ι
    have hmap_coset : ((U_V_mat d P_poly hP).val).map ι = G_P * (F_Q ^ d) := by
      rw [hCoset]
      change RingHom.mapMatrix ι (g_P.val * F_V_u.val ^ d) = _
      rw [map_mul, map_pow]
      rfl
    calc (((U_V_mat d P_poly hP).val).map ι).transpose * J_V *
          (((U_V_mat d P_poly hP).val).map ι)
        = ((F_Q ^ d).transpose * G_P.transpose) * J_V * (G_P * F_Q ^ d) := by
            rw [hmap_coset, Matrix.transpose_mul]
      _ = (F_Q ^ d).transpose * (G_P.transpose * J_V * G_P) * (F_Q ^ d) := by
            simp only [Matrix.mul_assoc]
      _ = ((Nat.card F : Padic ℓ) ^ ((2 * m + 1) * d)) • J_V := by
            rw [hGV_sp g_P hg_P, hFQ_pow d]

  
