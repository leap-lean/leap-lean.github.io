      let c₁₂ := CategoryTheory.Limits.cokernel.mapIso f₁ g₁
        (CategoryTheory.asIso α₁) (CategoryTheory.asIso α₂) h_sq1
      have hc₁₂_hom : c₁₂.hom = CategoryTheory.Limits.cokernel.map f₁ g₁ α₁ α₂ h_sq1 :=
        CategoryTheory.Limits.cokernel.mapIso_hom f₁ g₁
