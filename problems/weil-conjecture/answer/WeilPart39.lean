    have hEt_B : Algebra.Etale R₀ B_V :=
      hEtaleSubext R₀ K B_V L_V B_raw L_raw j_BV hj_inj
    let π_gal : (L_raw ≃ₐ[K] L_raw) →* (L_V ≃ₐ[K] L_V) := AlgEquiv.restrictNormalHom L_V
    have hπ_surj : Function.Surjective π_gal := AlgEquiv.restrictNormalHom_surjective L_raw
    have hker_eq : π_gal.ker = K_L := by
      ext τ_L
      rw [MonoidHom.mem_ker]
      have hfix : K_L = E_int.fixingSubgroup :=
        (IntermediateField.fixingSubgroup_fixedField K_L).symm
      rw [hfix, IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro h1 x hx
        have hc := AlgEquiv.restrictNormal_commutes τ_L L_V (⟨x, hx⟩ : L_V)
        change τ_L x = x
        have h2 : (π_gal τ_L) ⟨x, hx⟩ = ⟨x, hx⟩ := by rw [h1]; rfl
        have h3 : (algebraMap L_V L_raw) ((π_gal τ_L) ⟨x, hx⟩) = x := congrArg Subtype.val h2
        exact hc.symm.trans h3
      · intro hfix_τ
        apply AlgEquiv.ext
        intro x
        have hc := AlgEquiv.restrictNormal_commutes τ_L L_V x
        have hx : τ_L x.1 = x.1 := hfix_τ x.1 x.2
        exact hιLV_inj (hc.trans hx)
    let e_gal := QuotientGroup.quotientKerEquivOfSurjective π_gal hπ_surj
    let ρ_quot : ((L_raw ≃ₐ[K] L_raw) ⧸ π_gal.ker) →* Γ :=
      QuotientGroup.lift π_gal.ker ρ_L (fun g hg => by rwa [hker_eq] at hg)
    have hρ_quot_inj : Function.Injective ρ_quot := by
      rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro q hq
      induction q using QuotientGroup.induction_on with
      | H g =>
        rw [MonoidHom.mem_ker] at hq
        have hg_ker : g ∈ K_L := hq
        rw [← hker_eq] at hg_ker
        exact (QuotientGroup.eq_one_iff g).mpr hg_ker
    let res_BV := galRestrict R₀ K L_V B_V
    let ρ_V : (B_V ≃ₐ[R₀] B_V) →* Γ :=
      (ρ_quot.comp e_gal.symm.toMonoidHom).comp res_BV.symm.toMonoidHom
    have hρ_inj : Function.Injective ρ_V :=
      (hρ_quot_inj.comp e_gal.symm.injective).comp res_BV.symm.injective
    have hDesc : ∀ τ_raw : B_raw ≃ₐ[R₀] B_raw,
        ∃ σ : B_V ≃ₐ[R₀] B_V,
          (∀ b : B_V, τ_raw (j_BV b) = j_BV (σ b)) ∧
          ρ_V σ = ρ_raw τ_raw := by
      intro τ_raw
      let τ_L : L_raw ≃ₐ[K] L_raw := res_raw.symm τ_raw
      let σ : B_V ≃ₐ[R₀] B_V := res_BV (π_gal τ_L)
      refine ⟨σ, ?_, ?_⟩
      · intro b
        apply IsFractionRing.injective B_raw L_raw
        have h1 := algebraMap_galRestrict_apply R₀ τ_L (j_BV b)
        have hτ_eq : res_raw τ_L = τ_raw := res_raw.apply_symm_apply τ_raw
        rw [hτ_eq] at h1
        rw [h1, hj_BV_spec b]
        have hc := AlgEquiv.restrictNormal_commutes τ_L L_V (algebraMap B_V L_V b)
        change τ_L (algebraMap L_V L_raw (algebraMap B_V L_V b)) = _
        rw [← hc]
        change ι_LV ((π_gal τ_L) (algebraMap B_V L_V b)) = _
        have h2 := algebraMap_galRestrict_apply R₀ (π_gal τ_L) b
        rw [← h2]
        exact (hj_BV_spec (σ b)).symm
      · change ρ_quot (e_gal.symm (res_BV.symm (res_BV (π_gal τ_L)))) = ρ_raw τ_raw
        rw [res_BV.symm_apply_apply]
        have he : e_gal (QuotientGroup.mk τ_L) = π_gal τ_L := rfl
        rw [← he, e_gal.symm_apply_apply]
        change ρ_L τ_L = ρ_raw τ_raw
        exact congrArg ρ_raw (res_raw.apply_symm_apply τ_raw)
    have hRange : ∀ y : B_raw,
        y ∈ Set.range j_BV ↔ ∀ τ : B_raw ≃ₐ[R₀] B_raw, ρ_raw τ = 1 → τ y = y := by
      intro y
      constructor
      · rintro ⟨b, rfl⟩ τ hτ1
        obtain ⟨σ, hσ_comm, hσ_ρ⟩ := hDesc τ
        rw [hτ1] at hσ_ρ
        have hσ1 : σ = 1 := hρ_inj (hσ_ρ.trans (map_one ρ_V).symm)
        rw [hσ_comm b, hσ1, AlgEquiv.one_apply]
      · intro hy_fix
        let y_L : L_raw := algebraMap B_raw L_raw y
        have hy_mem : y_L ∈ E_int := by
          rw [IntermediateField.mem_fixedField_iff]
          intro τ_L hτ_L
          have h1 : ρ_raw (res_raw τ_L) = 1 := hτ_L
          have h2 := hy_fix (res_raw τ_L) h1
          have h3 := algebraMap_galRestrict_apply R₀ τ_L y
          rw [h2] at h3
          exact h3.symm
        let z : L_V := ⟨y_L, hy_mem⟩
        have hyL_int : IsIntegral R₀ y_L :=
          IsIntegral.map (IsScalarTower.toAlgHom R₀ B_raw L_raw)
            (IsIntegralClosure.isIntegral R₀ L_raw y)
        have hz_int : IsIntegral R₀ z :=
          (isIntegral_algHom_iff ι_LV_R₀ hιLV_inj).mp hyL_int
        let b : B_V := ⟨z, hz_int⟩
        refine ⟨b, IsFractionRing.injective B_raw L_raw ?_⟩
        rw [hj_BV_spec b]
        rfl
    have hLift : ∀ σ : B_V ≃ₐ[R₀] B_V,
        ∃ τ_raw : B_raw ≃ₐ[R₀] B_raw,
          ∀ b : B_V, τ_raw (j_BV b) = j_BV (σ b) := by
      intro σ
      obtain ⟨τ_L, hτ_L⟩ := hπ_surj (res_BV.symm σ)
      let τ_raw : B_raw ≃ₐ[R₀] B_raw := res_raw τ_L
      refine ⟨τ_raw, fun b => ?_⟩
      apply IsFractionRing.injective B_raw L_raw
      rw [algebraMap_galRestrict_apply R₀ τ_L (j_BV b), hj_BV_spec b]
      have hc := AlgEquiv.restrictNormal_commutes τ_L L_V (algebraMap B_V L_V b)
      change τ_L (algebraMap L_V L_raw (algebraMap B_V L_V b)) = _
      rw [← hc]
      change ι_LV ((π_gal τ_L) (algebraMap B_V L_V b)) = _
      rw [hτ_L]
      have h2 := algebraMap_galRestrict_apply R₀ (res_BV.symm σ) b
      rw [res_BV.apply_symm_apply] at h2
      rw [← h2]
      exact (hj_BV_spec (σ b)).symm
    exact ⟨B_V, L_V, hCR, hDom, hFld, hAF_B, hAP_B, hAR_B, hAF_L, hAP_L, hARF_L, hABL, hARL,
      hST1, hST2, hST3, hST4, hST5, hST6, hST_RKL, hFin_B, hEt_B, hFrac, hIntCl, hFD_L, hGal_L,
      ρ_V, j_BV, hρ_inj, hj_inj, hRange, hDesc, hLift⟩

  have hSeqEx : ∀ (r : ℕ) (Γ' : ℕ → Type u)
      (Compat' : ∀ t : ℕ, Γ' (t + 1) → Γ' t → Prop)
      (down' : ∀ t : ℕ, Γ' (t + 1) → Γ' t)
      (up' : ∀ t : ℕ, Γ' t → Γ' (t + 1)),
      (∀ t τ, Compat' t τ (down' t τ)) →
      (∀ t σ, Compat' t (up' t σ) σ) →
      ∀ g₀ : Γ' r, ∃ s : ∀ t : ℕ, Γ' t,
        s r = g₀ ∧ ∀ t : ℕ, Compat' t (s (t + 1)) (s t) := by
    intro r
    induction r with
    | zero =>
      intro Γ' Compat' _ up' _ hup g₀
      let s : ∀ t : ℕ, Γ' t := fun t => Nat.rec g₀ (fun k prev => up' k prev) t
      exact ⟨s, rfl, fun t => hup t (s t)⟩
    | succ r ih =>
      intro Γ' Compat' down' up' hdown hup g₀
      obtain ⟨s_tail, hs_r, hs_compat⟩ :=
        ih (fun t => Γ' (t + 1)) (fun t => Compat' (t + 1))
          (fun t => down' (t + 1)) (fun t => up' (t + 1))
          (fun t => hdown (t + 1)) (fun t => hup (t + 1)) g₀
      let s : ∀ t : ℕ, Γ' t := fun t =>
        match t with
        | 0 => down' 0 (s_tail 0)
        | k + 1 => s_tail k
      refine ⟨s, hs_r, fun t => ?_⟩
      cases t with
      | zero => exact hdown 0 (s_tail 0)
      | succ k => exact hs_compat k

  let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)
  let R₀ := Localization.Away Δ_aff
  let K := RatFunc F
  have hΔ_mon : Δ_aff.Monic :=
    Polynomial.monic_prod_of_monic S_aff _ fun s _ => Polynomial.monic_X_sub_C s
  have hΔ_ne : Δ_aff ≠ 0 := hΔ_mon.ne_zero
  have hSub_nzd : Submonoid.powers Δ_aff ≤ nonZeroDivisors (Polynomial F) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hΔ_ne)
  have hDom_R₀ : IsDomain R₀ := IsLocalization.isDomain_localization hSub_nzd
  have hDed_R₀ : IsDedekindDomain R₀ :=
    IsLocalization.isDedekindDomain (Polynomial F) hSub_nzd R₀
  have hΔ_K_ne : algebraMap (Polynomial F) K Δ_aff ≠ 0 :=
    fun h0 => hΔ_ne (IsFractionRing.injective (Polynomial F) K (h0.trans (map_zero _).symm))
  let φ_R₀K : R₀ →+* K := IsLocalization.Away.lift Δ_aff (IsUnit.mk0 _ hΔ_K_ne)
  let _ : Algebra R₀ K := φ_R₀K.toAlgebra
  have hST_PRK : IsScalarTower (Polynomial F) R₀ K :=
    IsScalarTower.of_algebraMap_eq fun p =>
      (IsLocalization.Away.lift_eq Δ_aff (IsUnit.mk0 _ hΔ_K_ne) p).symm
  have hFrac_RK : IsFractionRing R₀ K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers Δ_aff) R₀ K
  have hST_raw_RKL : ∀ r : ℕ,
      letI := T_raw.hFld r; letI := T_raw.hARF_L r; letI := T_raw.hARL r
      IsScalarTower R₀ K (T_raw.L_raw r) := by
    intro r
    let _ := T_raw.hCR r; let _ := T_raw.hFld r
    let _ := T_raw.hAP_B r; let _ := T_raw.hAR_B r
    let _ := T_raw.hAP_L r; let _ := T_raw.hARF_L r
    let _ := T_raw.hABL r; let _ := T_raw.hARL r
    let _ := T_raw.hST2 r; let _ := T_raw.hST4 r
    let _ := T_raw.hST5 r; let _ := T_raw.hST6 r
    refine IsScalarTower.of_algebraMap_eq' ?_
    apply IsLocalization.ringHom_ext (Submonoid.powers Δ_aff)
    apply RingHom.ext
    intro p
    simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ K,
      ← IsScalarTower.algebraMap_apply (Polynomial F) K (T_raw.L_raw r),
      IsScalarTower.algebraMap_apply R₀ (T_raw.B_raw r) (T_raw.L_raw r),
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (T_raw.B_raw r),
      ← IsScalarTower.algebraMap_apply (Polynomial F) (T_raw.B_raw r) (T_raw.L_raw r)]
  have hST_FRB_of : ∀ (B : Type u) [CommRing B] [Algebra F B] [Algebra (Polynomial F) B]
      [Algebra R₀ B] [IsScalarTower F (Polynomial F) B] [IsScalarTower (Polynomial F) R₀ B],
      IsScalarTower F R₀ B := by
    intro B _ _ _ _ _ _
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) R₀,
      ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ B,
      ← IsScalarTower.algebraMap_apply F (Polynomial F) B]
  have hLevel : ∀ r : ℕ, _ := fun r => by
    letI := T_raw.hCR r; letI := T_raw.hDom r; letI := T_raw.hFld r
    letI := T_raw.hAF_B r; letI := T_raw.hAP_B r; letI := T_raw.hAR_B r
    letI := T_raw.hAF_L r; letI := T_raw.hAP_L r; letI := T_raw.hARF_L r
    letI := T_raw.hABL r; letI := T_raw.hARL r
    letI := T_raw.hST1 r; letI := T_raw.hST2 r; letI := T_raw.hST3 r
    letI := T_raw.hST4 r; letI := T_raw.hST5 r; letI := T_raw.hST6 r
    letI := hST_raw_RKL r
    letI := T_raw.hFin_B r; letI := T_raw.hEt_B r
    letI := T_raw.hFrac r; letI := T_raw.hIntCl r
    letI := T_raw.hFD_L r; letI := T_raw.hGal_L r
    exact hGaloisQuotLevel R₀ K
      ((Matrix (Fin N) (Fin N) (ZMod (ℓ ^ (r + 1))))ˣ)
      (T_raw.B_raw r) (T_raw.L_raw r) (ρ_mat_raw r)
  choose B_V L_V hCR hDom hFld hAF_B hAP_B hAR_B hAF_L hAP_L hARF_L hABL hARL
    hST1 hST2 hST3 hST4 hST5 hST6 hST_RKL hFin_B hEt_B hFrac hIntCl hFD_L hGal_L
    ρ_V j_BV hLevel_spec using hLevel
  have hρ_inj : ∀ r : ℕ, Function.Injective (ρ_V r) := fun r => (hLevel_spec r).1
  have hj_inj : ∀ r : ℕ, Function.Injective (j_BV r) := fun r => (hLevel_spec r).2.1
  have hj_range : ∀ (r : ℕ) (y : T_raw.B_raw r),
      letI := hCR r; letI := T_raw.hCR r; letI := hAR_B r; letI := T_raw.hAR_B r
      y ∈ Set.range (j_BV r) ↔
        ∀ τ : T_raw.B_raw r ≃ₐ[R₀] T_raw.B_raw r, ρ_mat_raw r τ = 1 → τ y = y :=
    fun r => (hLevel_spec r).2.2.1
  have hj_desc : ∀ (r : ℕ),
      letI := hCR r; letI := T_raw.hCR r; letI := hAR_B r; letI := T_raw.hAR_B r
      ∀ τ_raw : T_raw.B_raw r ≃ₐ[R₀] T_raw.B_raw r,
        ∃ σ : B_V r ≃ₐ[R₀] B_V r,
          (∀ b : B_V r, τ_raw (j_BV r b) = j_BV r (σ b)) ∧
          ρ_V r σ = ρ_mat_raw r τ_raw :=
    fun r => (hLevel_spec r).2.2.2.1
  have hj_lift : ∀ (r : ℕ),
      letI := hCR r; letI := T_raw.hCR r; letI := hAR_B r; letI := T_raw.hAR_B r
      ∀ σ : B_V r ≃ₐ[R₀] B_V r,
        ∃ τ_raw : T_raw.B_raw r ≃ₐ[R₀] T_raw.B_raw r,
          ∀ b : B_V r, τ_raw (j_BV r b) = j_BV r (σ b) :=
    fun r => (hLevel_spec r).2.2.2.2
  have hι_mem_range : ∀ (r : ℕ) (b : B_V r),
      letI := hCR r; letI := hCR (r + 1)
      letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
      letI := hAR_B r; letI := hAR_B (r + 1)
      letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
      T_raw.ι_Braw r (j_BV r b) ∈ (j_BV (r + 1)).range := by
    intro r b
    let _ := hCR r; let _ := hCR (r + 1)
    let _ := T_raw.hCR r; let _ := T_raw.hCR (r + 1)
    let _ := hAR_B r; let _ := hAR_B (r + 1)
    let _ := T_raw.hAR_B r; let _ := T_raw.hAR_B (r + 1)
    change T_raw.ι_Braw r (j_BV r b) ∈ Set.range (j_BV (r + 1))
    rw [hj_range (r + 1)]
    intro τ hτ1
    obtain ⟨σ_raw, hσ_raw_comm, _⟩ := (T_raw.hι_raw r).2 τ
    have hρ_σ : ρ_mat_raw r σ_raw = 1 := by
      apply Units.ext
      rw [← hρ_mat_compat r τ σ_raw hσ_raw_comm, hτ1, Units.val_one, Units.val_one]
      exact Matrix.map_one _ (map_zero _) (map_one _)
    have hfix_b : σ_raw (j_BV r b) = j_BV r b :=
      (hj_range r (j_BV r b)).mp ⟨b, rfl⟩ σ_raw hρ_σ
    rw [hσ_raw_comm, hfix_b]
  let ι_BV : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      B_V r →ₐ[R₀] B_V (r + 1) := fun r => by
    letI := hCR r; letI := hCR (r + 1)
    letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
    letI := hAR_B r; letI := hAR_B (r + 1)
    letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
    let e_j := AlgEquiv.ofInjective (j_BV (r + 1)) (hj_inj (r + 1))
    exact e_j.symm.toAlgHom.comp
      (((T_raw.ι_Braw r).comp (j_BV r)).codRestrict (j_BV (r + 1)).range (hι_mem_range r))
  have hj_ι_comm : ∀ (r : ℕ) (b : B_V r),
      letI := hCR r; letI := hCR (r + 1)
      letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
      letI := hAR_B r; letI := hAR_B (r + 1)
      letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
      T_raw.ι_Braw r (j_BV r b) = j_BV (r + 1) (ι_BV r b) := by
    intro r b
    let _ := hCR r; let _ := hCR (r + 1)
    let _ := T_raw.hCR r; let _ := T_raw.hCR (r + 1)
    let _ := hAR_B r; let _ := hAR_B (r + 1)
    let _ := T_raw.hAR_B r; let _ := T_raw.hAR_B (r + 1)
    let e_j := AlgEquiv.ofInjective (j_BV (r + 1)) (hj_inj (r + 1))
    let z_sub : ↥(j_BV (r + 1)).range :=
      (((T_raw.ι_Braw r).comp (j_BV r)).codRestrict (j_BV (r + 1)).range (hι_mem_range r)) b
    have h1 : j_BV (r + 1) (ι_BV r b) = (e_j (e_j.symm z_sub)).1 := rfl
    rw [h1, e_j.apply_symm_apply]
    rfl
  have hι_compat : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1); letI := hAR_B r; letI := hAR_B (r + 1)
      Function.Injective (ι_BV r) ∧
      ∀ τ : B_V (r + 1) ≃ₐ[R₀] B_V (r + 1),
        ∃ σ : B_V r ≃ₐ[R₀] B_V r,
          (∀ b : B_V r, τ (ι_BV r b) = ι_BV r (σ b)) ∧
          ((ρ_V (r + 1) τ).val).map
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))) =
            (ρ_V r σ).val := by
    intro r
    let _ := hCR r; let _ := hCR (r + 1)
    let _ := T_raw.hCR r; let _ := T_raw.hCR (r + 1)
    let _ := hAR_B r; let _ := hAR_B (r + 1)
    let _ := T_raw.hAR_B r; let _ := T_raw.hAR_B (r + 1)
    refine ⟨?_, ?_⟩
    · intro b₁ b₂ hb
      apply hj_inj r
      apply (T_raw.hι_raw r).1
      rw [hj_ι_comm r b₁, hj_ι_comm r b₂, hb]
    · intro τ
      obtain ⟨τ_raw, hτ_raw_comm⟩ := hj_lift (r + 1) τ
      obtain ⟨τ_desc, hτ_desc_comm, hτ_desc_ρ⟩ := hj_desc (r + 1) τ_raw
      have hτ_eq : τ_desc = τ := by
        ext x
        apply hj_inj (r + 1)
        rw [← hτ_desc_comm x, hτ_raw_comm x]
      rw [hτ_eq] at hτ_desc_ρ
      obtain ⟨σ_raw, hσ_raw_comm, _⟩ := (T_raw.hι_raw r).2 τ_raw
      obtain ⟨σ, hσ_comm, hσ_ρ⟩ := hj_desc r σ_raw
      refine ⟨σ, fun b => ?_, ?_⟩
      · apply hj_inj (r + 1)
        rw [← hτ_raw_comm (ι_BV r b), ← hj_ι_comm r b, hσ_raw_comm, hσ_comm b, hj_ι_comm r (σ b)]
      · rw [hτ_desc_ρ, hσ_ρ]
        exact hρ_mat_compat r τ_raw σ_raw hσ_raw_comm
  have hj_BV_spec : ∀ r : ℕ,
      letI := hCR r; letI := hCR (r + 1)
      letI := T_raw.hCR r; letI := T_raw.hCR (r + 1)
      letI := hAR_B r; letI := hAR_B (r + 1)
      letI := T_raw.hAR_B r; letI := T_raw.hAR_B (r + 1)
      Function.Injective (j_BV r) ∧
      (∀ b : B_V r, T_raw.ι_Braw r (j_BV r b) = j_BV (r + 1) (ι_BV r b)) ∧
      ∀ τ_raw : T_raw.B_raw r ≃ₐ[R₀] T_raw.B_raw r,
        ∃ σ : B_V r ≃ₐ[R₀] B_V r,
          (∀ b : B_V r, τ_raw (j_BV r b) = j_BV r (σ b)) ∧
          (ρ_V r σ).val = (ρ_mat_raw r τ_raw).val := by
    intro r
    let _ := hCR r; let _ := hCR (r + 1)
    let _ := T_raw.hCR r; let _ := T_raw.hCR (r + 1)
    let _ := hAR_B r; let _ := hAR_B (r + 1)
    let _ := T_raw.hAR_B r; let _ := T_raw.hAR_B (r + 1)
    refine ⟨hj_inj r, hj_ι_comm r, fun τ_raw => ?_⟩
    obtain ⟨σ, hσ_comm, hσ_ρ⟩ := hj_desc r τ_raw
    exact ⟨σ, hσ_comm, congrArg Units.val hσ_ρ⟩
  have hQ_pullback : ∀ (P_gen : Polynomial F) (M_exp : ℕ)
      (U_mat : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
