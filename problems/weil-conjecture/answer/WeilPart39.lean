      intro x
      let a := (g : LocallyConstant ↥E.left ↥A_η) x
      let O_a : E.left.Opens := ⟨(g : LocallyConstant ↥E.left ↥A_η) ⁻¹' {a},
        (g : LocallyConstant ↥E.left ↥A_η).isLocallyConstant {a}⟩
