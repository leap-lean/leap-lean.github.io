    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have hSpec_f : P_et (AlgebraicGeometry.Spec.map f) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
    have hSpec_g : P_et (AlgebraicGeometry.Spec.map g) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg
    have hSpec_fg : P_et (AlgebraicGeometry.Spec.map (f ≫ g)) := by
      rw [AlgebraicGeometry.Spec.map_comp]
      exact P_et.comp_mem _ _ hSpec_g hSpec_f
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hSpec_fg

  
  have hSingleDescent : ∀ (E₀ : CommRingCat.{u}) (φ₀ : B_open.obj j₁ ⟶ E₀)
      (_ : φ₀.hom.Etale) (F_inf₀ : CommRingCat.{u})
      (ψ₀ : CategoryTheory.Limits.pushout φ₀ (c_op.ι.app j₁) ⟶ F_inf₀)
      (_ : ψ₀.hom.Etale),
      ∃ (j₀ : 𝒥) (θ₀ : j₁ ⟶ j₀) (Q₀ : CommRingCat.{u})
        (f₀ : B_open.obj j₀ ⟶ Q₀) (_ : f₀.hom.Etale)
        (lam₀ : E₀ ⟶ Q₀) (g_inf₀ : Q₀ ⟶ F_inf₀),
        φ₀ ≫ lam₀ = B_open.map θ₀ ≫ f₀ ∧
        CategoryTheory.Limits.pushout.inl φ₀ (c_op.ι.app j₁) ≫ ψ₀ = lam₀ ≫ g_inf₀ ∧
        c_op.ι.app j₀ ≫ CategoryTheory.Limits.pushout.inr φ₀ (c_op.ι.app j₁) ≫ ψ₀ =
          f₀ ≫ g_inf₀ ∧
        ∀ (W : CommRingCat.{u})
          (leg₁ : CategoryTheory.Limits.pushout φ₀ (c_op.ι.app j₁) ⟶ W)
          (leg₂ : Q₀ ⟶ W),
          CategoryTheory.Limits.pushout.inl φ₀ (c_op.ι.app j₁) ≫ leg₁ = lam₀ ≫ leg₂ →
          c_op.ι.app j₀ ≫ CategoryTheory.Limits.pushout.inr φ₀ (c_op.ι.app j₁) ≫ leg₁ =
            f₀ ≫ leg₂ →
          ∃ ν : F_inf₀ ⟶ W, ψ₀ ≫ ν = leg₁ := by
    intro E₀ φ₀ hφ₀_et F_inf₀ ψ₀ hψ₀_et
    let Fgt₁ : CategoryTheory.Under j₁ ⥤ 𝒥 := CategoryTheory.Under.forget j₁
    have : Fgt₁.Final := CategoryTheory.Under.final_forget j₁
    let c₁ : CategoryTheory.Limits.Cocone (Fgt₁ ⋙ B_open) := c_op.whisker Fgt₁
    let hc₁ : CategoryTheory.Limits.IsColimit c₁ :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv Fgt₁ c_op).symm hc_op
    let ω_init : CategoryTheory.Under j₁ := CategoryTheory.Under.mk (𝟙 j₁)
    let ι_init : ∀ ω : CategoryTheory.Under j₁, ω_init ⟶ ω :=
      fun ω => CategoryTheory.Under.homMk ω.hom (CategoryTheory.Category.id_comp ω.hom)
    let D : CategoryTheory.Under j₁ ⥤ CommRingCat.{u} :=
      { obj := fun ω => CategoryTheory.Limits.pushout φ₀ (B_open.map ω.hom)
        map := fun {ω_a ω_b} τ =>
          CategoryTheory.Limits.pushout.desc
            (CategoryTheory.Limits.pushout.inl φ₀ (B_open.map ω_b.hom))
            (B_open.map τ.right ≫ CategoryTheory.Limits.pushout.inr φ₀ (B_open.map ω_b.hom))
            (by
              rw [CategoryTheory.Limits.pushout.condition,
                ← CategoryTheory.Under.w τ, B_open.map_comp, CategoryTheory.Category.assoc])
        map_id := fun ω => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Limits.pushout.inr_desc, CategoryTheory.Category.comp_id]
            change B_open.map (𝟙 ω.right) ≫ _ = _
            rw [B_open.map_id, CategoryTheory.Category.id_comp]
        map_comp := fun {ω_a ω_b ω_c} τ₁ τ₂ => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Limits.pushout.inl_desc]
          · rw [CategoryTheory.Limits.pushout.inr_desc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pushout.inr_desc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pushout.inr_desc, ← CategoryTheory.Category.assoc,
              ← B_open.map_comp]
            rfl }
    let inl_inf := CategoryTheory.Limits.pushout.inl φ₀ (c_op.ι.app j₁)
    let inr_inf := CategoryTheory.Limits.pushout.inr φ₀ (c_op.ι.app j₁)
    let c_D : CategoryTheory.Limits.Cocone D :=
      { pt := CategoryTheory.Limits.pushout φ₀ (c_op.ι.app j₁)
        ι :=
          { app := fun ω =>
              CategoryTheory.Limits.pushout.desc inl_inf (c_op.ι.app ω.right ≫ inr_inf)
                (by
                  dsimp [inl_inf, inr_inf]
                  rw [CategoryTheory.Limits.pushout.condition,
                    ← c_op.w ω.hom, CategoryTheory.Category.assoc])
            naturality := fun ω_a ω_b τ => by
              dsimp
              rw [CategoryTheory.Category.comp_id]
              apply CategoryTheory.Limits.pushout.hom_ext
              · rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inl_desc,
                  CategoryTheory.Limits.pushout.inl_desc, CategoryTheory.Limits.pushout.inl_desc]
              · rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
                  CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
                  CategoryTheory.Limits.pushout.inr_desc, ← CategoryTheory.Category.assoc,
                  c_op.w τ.right] } }
    let mkCoc₁ : ∀ s : CategoryTheory.Limits.Cocone D,
        CategoryTheory.Limits.Cocone (Fgt₁ ⋙ B_open) := fun s =>
      { pt := s.pt
        ι :=
          { app := fun ω =>
              CategoryTheory.Limits.pushout.inr φ₀ (B_open.map ω.hom) ≫ s.ι.app ω
            naturality := fun ω_a ω_b τ => by
              dsimp [Fgt₁]
              rw [CategoryTheory.Category.comp_id]
              have hw := congrArg
                (CategoryTheory.Limits.pushout.inr φ₀ (B_open.map ω_a.hom) ≫ ·) (s.w τ)
              dsimp [D] at hw
              rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
                CategoryTheory.Category.assoc] at hw
              exact hw } }
    have hInlConst : ∀ (s : CategoryTheory.Limits.Cocone D) (ω : CategoryTheory.Under j₁),
        CategoryTheory.Limits.pushout.inl φ₀ (B_open.map ω.hom) ≫ s.ι.app ω =
          CategoryTheory.Limits.pushout.inl φ₀ (B_open.map ω_init.hom) ≫ s.ι.app ω_init := by
      intro s ω
      have hw := congrArg
        (CategoryTheory.Limits.pushout.inl φ₀ (B_open.map ω_init.hom) ≫ ·) (s.w (ι_init ω))
      dsimp [D] at hw
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inl_desc] at hw
      exact hw
    have hDescCompat : ∀ s : CategoryTheory.Limits.Cocone D,
        φ₀ ≫ (CategoryTheory.Limits.pushout.inl φ₀ (B_open.map ω_init.hom) ≫ s.ι.app ω_init) =
          c_op.ι.app j₁ ≫ hc₁.desc (mkCoc₁ s) := by
      intro s
      have hfac : c_op.ι.app j₁ ≫ hc₁.desc (mkCoc₁ s) =
          CategoryTheory.Limits.pushout.inr φ₀ (B_open.map ω_init.hom) ≫ s.ι.app ω_init :=
        hc₁.fac (mkCoc₁ s) ω_init
      rw [hfac, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.condition]
      change (B_open.map (𝟙 j₁) ≫ _) ≫ _ = _
      rw [B_open.map_id, CategoryTheory.Category.id_comp]
    let hc_D : CategoryTheory.Limits.IsColimit c_D :=
      { desc := fun s =>
          CategoryTheory.Limits.pushout.desc
            (CategoryTheory.Limits.pushout.inl φ₀ (B_open.map ω_init.hom) ≫ s.ι.app ω_init)
            (hc₁.desc (mkCoc₁ s))
            (hDescCompat s)
        fac := fun s ω => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · dsimp [c_D, inl_inf]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inl_desc,
              CategoryTheory.Limits.pushout.inl_desc, hInlConst s ω]
          · dsimp [c_D, inr_inf]
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc]
            exact hc₁.fac (mkCoc₁ s) ω
        uniq := fun s m hm => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc]
            have hm0 := congrArg
              (CategoryTheory.Limits.pushout.inl φ₀ (B_open.map ω_init.hom) ≫ ·) (hm ω_init)
            dsimp [c_D, inl_inf] at hm0
            rwa [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inl_desc] at hm0
          · rw [CategoryTheory.Limits.pushout.inr_desc]
            apply hc₁.hom_ext
            intro ω
            rw [hc₁.fac (mkCoc₁ s) ω]
            have hmω := congrArg
              (CategoryTheory.Limits.pushout.inr φ₀ (B_open.map ω.hom) ≫ ·) (hm ω)
            dsimp [c_D, inr_inf, c₁, mkCoc₁, Fgt₁] at hmω ⊢
            rwa [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
              CategoryTheory.Category.assoc] at hmω }
    obtain ⟨ω₀, n₀, J₀, g_inf₀, hp₀_et, hpush⟩ :=
      (hEtDesc.1 (CategoryTheory.Under j₁) D c_D hc_D).1 F_inf₀ ψ₀ hψ₀_et
    let Q₀ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin n₀) ↑(D.obj ω₀) ⧸ J₀)
    let p₀ : D.obj ω₀ ⟶ Q₀ := CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)
    let j₀ : 𝒥 := ω₀.right
    let θ₀ : j₁ ⟶ j₀ := ω₀.hom
    let inl₀ := CategoryTheory.Limits.pushout.inl φ₀ (B_open.map θ₀)
    let inr₀ := CategoryTheory.Limits.pushout.inr φ₀ (B_open.map θ₀)
    let f₀ : B_open.obj j₀ ⟶ Q₀ := inr₀ ≫ p₀
    let lam₀ : E₀ ⟶ Q₀ := inl₀ ≫ p₀
    have hf₀_et : f₀.hom.Etale :=
      hCompEtale inr₀ p₀ (hPushInrEtale φ₀ (B_open.map θ₀) hφ₀_et) hp₀_et
    refine ⟨j₀, θ₀, Q₀, f₀, hf₀_et, lam₀, g_inf₀, ?_, ?_, ?_, ?_⟩
    · dsimp [lam₀, f₀, inl₀, inr₀]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.condition,
        CategoryTheory.Category.assoc]
    · calc
        CategoryTheory.Limits.pushout.inl φ₀ (c_op.ι.app j₁) ≫ ψ₀
          = (inl₀ ≫ c_D.ι.app ω₀) ≫ ψ₀ := by
              dsimp [c_D, inl_inf, inl₀, θ₀]
              rw [CategoryTheory.Limits.pushout.inl_desc]
        _ = inl₀ ≫ (c_D.ι.app ω₀ ≫ ψ₀) := CategoryTheory.Category.assoc _ _ _
        _ = inl₀ ≫ (p₀ ≫ g_inf₀) := congrArg (inl₀ ≫ ·) hpush.w
        _ = lam₀ ≫ g_inf₀ := (CategoryTheory.Category.assoc _ _ _).symm
    · calc
        c_op.ι.app j₀ ≫ CategoryTheory.Limits.pushout.inr φ₀ (c_op.ι.app j₁) ≫ ψ₀
          = (c_op.ι.app ω₀.right ≫ inr_inf) ≫ ψ₀ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (inr₀ ≫ c_D.ι.app ω₀) ≫ ψ₀ := by
              dsimp [c_D, inr_inf, inr₀, θ₀]
              rw [CategoryTheory.Limits.pushout.inr_desc]
        _ = inr₀ ≫ (c_D.ι.app ω₀ ≫ ψ₀) := CategoryTheory.Category.assoc _ _ _
        _ = inr₀ ≫ (p₀ ≫ g_inf₀) := congrArg (inr₀ ≫ ·) hpush.w
        _ = f₀ ≫ g_inf₀ := (CategoryTheory.Category.assoc _ _ _).symm
    · intro W leg₁ leg₂ h1 h2
      have hw : c_D.ι.app ω₀ ≫ leg₁ = p₀ ≫ leg₂ := by
        apply CategoryTheory.Limits.pushout.hom_ext
        · dsimp [c_D, inl_inf]
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inl_desc]
          exact h1.trans (CategoryTheory.Category.assoc _ _ _)
        · dsimp [c_D, inr_inf]
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pushout.inr_desc,
            CategoryTheory.Category.assoc]
          exact h2.trans (CategoryTheory.Category.assoc _ _ _)
      exact ⟨hpush.desc leg₁ leg₂ hw, hpush.inl_desc leg₁ leg₂ hw⟩

  
  have hSurjDescent : ∀ (j₀ : 𝒥) (N : ℕ) (Q : Fin N → CommRingCat.{u})
      (f₀ : ∀ k : Fin N, B_open.obj j₀ ⟶ Q k)
      (_ : ∀ k : Fin N, (f₀ k).hom.Etale),
      (∀ x : ↥(AlgebraicGeometry.Spec c_op.pt),
        ∃ (k : Fin N) (z : ↥(AlgebraicGeometry.Spec (Q k))),
          (AlgebraicGeometry.Spec.map (f₀ k)).base z =
            (AlgebraicGeometry.Spec.map (c_op.ι.app j₀)).base x) →
      ∃ (j_F : 𝒥) (τ : j₀ ⟶ j_F),
        ∀ (j₂ : 𝒥) (θ' : j_F ⟶ j₂) (x : ↥(AlgebraicGeometry.Spec (B_open.obj j₂))),
          ∃ (k : Fin N)
            (y : ↥(AlgebraicGeometry.Spec
              (CategoryTheory.Limits.pushout
                (CategoryTheory.Limits.pushout.inr (f₀ k) (B_open.map τ))
                (B_open.map θ')))),
            (AlgebraicGeometry.Spec.map
              (CategoryTheory.Limits.pushout.inr
                (CategoryTheory.Limits.pushout.inr (f₀ k) (B_open.map τ))
                (B_open.map θ'))).base y = x := by
    intro j₀ N Q f₀ hf₀_et h_colim_cov
    classical
    let U_cov : Set (PrimeSpectrum ↑(B_open.obj j₀)) :=
      ⋃ k : Fin N, Set.range (AlgebraicGeometry.Spec.map (f₀ k)).base
    have hU_open : IsOpen U_cov := by
      refine isOpen_iUnion fun k => ?_
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f₀ k)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          (hf₀_et k)
      exact (AlgebraicGeometry.Scheme.Hom.isOpenMap (AlgebraicGeometry.Spec.map (f₀ k))).isOpen_range
    have hU_compact : IsCompact U_cov :=
      isCompact_iUnion fun k =>
        isCompact_range (AlgebraicGeometry.Spec.map (f₀ k)).base.hom.continuous
    let Idx_B := {a : ↑(B_open.obj j₀) //
      (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum ↑(B_open.obj j₀))) ⊆ U_cov}
    have hU_sub_basis : U_cov ⊆
        ⋃ b : Idx_B, (PrimeSpectrum.basicOpen b.1 : Set (PrimeSpectrum ↑(B_open.obj j₀))) := by
      intro z hz
      obtain ⟨V, ⟨⟨a, rfl⟩, hzV, hVU⟩⟩ :=
        (PrimeSpectrum.isTopologicalBasis_basic_opens (R := ↑(B_open.obj j₀))).exists_subset_of_mem_open
          hz hU_open
      exact Set.mem_iUnion.mpr ⟨⟨a, hVU⟩, hzV⟩
    obtain ⟨S₀, hS₀_sub⟩ := hU_compact.elim_finite_subcover
      (fun b : Idx_B => (PrimeSpectrum.basicOpen b.1 : Set (PrimeSpectrum ↑(B_open.obj j₀))))
      (fun b => (PrimeSpectrum.basicOpen b.1).isOpen) hU_sub_basis
    let ι_j₀ : B_open.obj j₀ ⟶ c_op.pt := c_op.ι.app j₀
    have hSup_top :
        (⨆ b : ↥S₀, PrimeSpectrum.basicOpen (ι_j₀.hom b.1.1)) = ⊤ := by
      refine eq_top_iff.mpr fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ?_
      obtain ⟨k, z, hkz⟩ := h_colim_cov x
      have hxU : (AlgebraicGeometry.Spec.map ι_j₀).base x ∈ U_cov :=
        Set.mem_iUnion.mpr ⟨k, z, hkz⟩
      obtain ⟨b, hb_mem, hxb⟩ := Set.mem_iUnion₂.mp (hS₀_sub hxU)
      refine ⟨⟨b, hb_mem⟩, ?_⟩
      change ι_j₀.hom b.1 ∉ x.asIdeal
      exact hxb
    have hSpan_top :
        Ideal.span (Set.range fun b : ↥S₀ => ι_j₀.hom b.1.1) = ⊤ :=
      (PrimeSpectrum.iSup_basicOpen_eq_top_iff).mp hSup_top
    have h1_mem : (1 : ↑c_op.pt) ∈
        Ideal.span (Set.range fun b : ↥S₀ => ι_j₀.hom b.1.1) := by
      rw [hSpan_top]
      trivial
    obtain ⟨c_coeff, hc_coeff⟩ := (Submodule.mem_span_range_iff_exists_fun ↑c_op.pt).mp h1_mem
    let Fgt₀ : CategoryTheory.Under j₀ ⥤ 𝒥 := CategoryTheory.Under.forget j₀
    have : Fgt₀.Final := CategoryTheory.Under.final_forget j₀
    let c₀ := c_op.whisker Fgt₀
    let hc₀ : CategoryTheory.Limits.IsColimit c₀ :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv Fgt₀ c_op).symm hc_op
    let hc₀_type := CategoryTheory.Limits.isColimitOfPreserves
      (CategoryTheory.forget CommRingCat.{u}) hc₀
    choose ω_b y_b hy_b using fun b : ↥S₀ =>
      CategoryTheory.Limits.Types.jointly_surjective
        (Fgt₀ ⋙ B_open ⋙ CategoryTheory.forget CommRingCat.{u}) hc₀_type (c_coeff b)
    let O_b : Finset (CategoryTheory.Under j₀) := Finset.univ.image ω_b
    let ω₁ : CategoryTheory.Under j₀ := CategoryTheory.IsFiltered.sup O_b ∅
    let σ_b : ∀ b : ↥S₀, ω_b b ⟶ ω₁ := fun b =>
      CategoryTheory.IsFiltered.toSup O_b ∅ (Finset.mem_image_of_mem ω_b (Finset.mem_univ b))
    let w₁ : ∀ b : ↥S₀, ↑(B_open.obj ω₁.right) := fun b =>
      (B_open.map (σ_b b).right).hom (y_b b)
    let ι_ω₁ : B_open.obj ω₁.right ⟶ c_op.pt := c_op.ι.app ω₁.right
    have hw₁ : ∀ b : ↥S₀, ι_ω₁.hom (w₁ b) = c_coeff b := by
      intro b
      have hw := congrArg (fun m : B_open.obj (ω_b b).right ⟶ c_op.pt => m.hom (y_b b))
        (c_op.w (σ_b b).right)
      exact hw.trans (hy_b b)
    let lhs : ↑(B_open.obj ω₁.right) :=
      ∑ b : ↥S₀, w₁ b * (B_open.map ω₁.hom).hom b.1.1
    have hlhs_colim : (c_op.ι.app ω₁.right).hom lhs = (c_op.ι.app ω₁.right).hom 1 := by
      change ι_ω₁.hom lhs = ι_ω₁.hom 1
      rw [map_one]
      dsimp [lhs]
      rw [map_sum]
      have hterm : ∀ b : ↥S₀,
          ι_ω₁.hom (w₁ b * (B_open.map ω₁.hom).hom b.1.1) =
            c_coeff b * ι_j₀.hom b.1.1 := by
        intro b
        rw [map_mul, hw₁ b]
        have hb_eq := congrArg (fun m : B_open.obj j₀ ⟶ c_op.pt => m.hom b.1.1) (c_op.w ω₁.hom)
        exact congrArg (c_coeff b * ·) hb_eq
      rw [Finset.sum_congr rfl (fun b _ => hterm b)]
      exact hc_coeff
    let hc_op_type := CategoryTheory.Limits.isColimitOfPreserves
      (CategoryTheory.forget CommRingCat.{u}) hc_op
    obtain ⟨j_F, θ₂, hθ₂_eq⟩ :=
      (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hc_op_type lhs 1).mp hlhs_colim
    have hθ₂_eq' : (B_open.map θ₂).hom lhs = (B_open.map θ₂).hom 1 := hθ₂_eq
    let τ : j₀ ⟶ j_F := ω₁.hom ≫ θ₂
    let w_F : ↥S₀ → ↑(B_open.obj j_F) := fun b => (B_open.map θ₂).hom (w₁ b)
    have hBezout_F : ∑ b : ↥S₀, w_F b * (B_open.map τ).hom b.1.1 = 1 := by
      have h1 : (B_open.map θ₂).hom lhs = 1 := hθ₂_eq'.trans (map_one (B_open.map θ₂).hom)
      dsimp [lhs] at h1
      rw [map_sum] at h1
      refine (Finset.sum_congr rfl (fun b _ => ?_)).trans h1
      rw [map_mul]
      dsimp [w_F, τ]
      rw [B_open.map_comp]
      rfl
    refine ⟨j_F, τ, fun j₂ θ' x => ?_⟩
    have hBezout_j₂ :
        ∑ b : ↥S₀, (B_open.map θ').hom (w_F b) * (B_open.map (τ ≫ θ')).hom b.1.1 = 1 := by
      have h2 := congrArg (B_open.map θ').hom hBezout_F
      rw [map_sum, map_one] at h2
      refine (Finset.sum_congr rfl (fun b _ => ?_)).trans h2
      rw [map_mul, B_open.map_comp]
      rfl
    have hex_b : ∃ b : ↥S₀, (B_open.map (τ ≫ θ')).hom b.1.1 ∉ x.asIdeal := by
      by_contra h_all
      have h_mem_all : ∀ b : ↥S₀, (B_open.map (τ ≫ θ')).hom b.1.1 ∈ x.asIdeal := fun b =>
        by_contra fun hb_out => h_all ⟨b, hb_out⟩
      have hsum_mem :
