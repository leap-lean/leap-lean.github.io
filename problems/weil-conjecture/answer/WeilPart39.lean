          congrArg (fun f => ev_hom f m y_x) (hk (Opposite.op w_x))
        exact (congrArg (ev_hom k m) hspec.2.2.symm).trans hk_wx
    let ℒ_A : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let P_const := (CategoryTheory.Functor.const (Opposite V.Etale)).obj A_η
    let θ_A : P_const ⟶ P_A :=
      { app := fun E =>
