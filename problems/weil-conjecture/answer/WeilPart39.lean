      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext V_op
      rcases V_op with ⟨V⟩
      let W₀ : X₀.Etale := B_g₀.obj V
      let q₁ : (B_of e_X.hom).obj (B_prX.obj W₀) ⟶ B_prX'.obj W₀ :=
        (e_Bp pr_X' pr_X e_X.hom he_pr).hom.app W₀
      let q₂ : (B_of e_X.hom).obj (B_diag_std.obj V) ⟶ (B_of e_X.hom).obj (B_prX.obj W₀) :=
        (B_of e_X.hom).map (e_B2_std.inv.app V)
      let q₃ : (B_of e_X.hom).obj (B_g_std.obj (B_prY.obj V)) ⟶
