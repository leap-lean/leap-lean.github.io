      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway g)
    have hαE_et : α_E.Etale := RingHom.Etale.stableUnderComposition _ _ hα₀_et hloc_g_et
    have hεE_base : ε_E.comp (α_E.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 := by
      dsimp only [α_E]
      rw [← RingHom.comp_assoc, ← RingHom.comp_assoc, hεE_comp, RingHom.comp_assoc, hε₀_base]

