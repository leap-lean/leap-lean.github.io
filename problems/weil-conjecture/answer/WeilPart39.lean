      hSecInj_X hSecSurj_X hSecSurj_Y 𝒢 (U_fam idx) E₀ U₀ u_Y p_U hu_Y_comm hp_U hp_U_Y

  let e_X : CategoryTheory.Iso X' X_bar :=
