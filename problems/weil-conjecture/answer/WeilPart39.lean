      (he_hom : e.hom ≫ p₂ = p₁) (he_inv : e.inv ≫ p₁ = p₂),
      ψ_over p₁ p₂ e.hom he_hom ≫
        ((pf_of e.hom).map (ψ_over p₂ p₁ e.inv he_inv) ≫
          ((ε₁ Z₁ Z₂ e).hom.app ((L_of p₂).obj 𝒢) :
            (pf_of e.hom).obj ((pf_of e.inv).obj ((L_of p₂).obj 𝒢)) ⟶ (L_of p₂).obj 𝒢)) =
      𝟙 ((L_of p₂).obj 𝒢) := by
    intro Z₁ Z₂ p₁ p₂ e he_hom he_inv
    have := CategoryTheory.Functor.isContinuous_id Z₂.smallEtaleTopology
    let G₁ := (L_of p₁).obj 𝒢
    let G₂ := (L_of p₂).obj 𝒢
    let ψ_pos : G₂ ⟶ (pf_of e.hom).obj G₁ := ψ_over p₁ p₂ e.hom he_hom
    let ψ_neg : G₁ ⟶ (pf_of e.inv).obj G₂ := ψ_over p₂ p₁ e.inv he_inv
    let ε_hom : (pf_of e.hom).obj ((pf_of e.inv).obj G₂) ⟶ G₂ := (ε₁ Z₁ Z₂ e).hom.app G₂
    let c_mid : (pf_of p₂).obj G₂ ⟶ (pf_of p₂).obj G₂ :=
      (δ_p p₂ p₁ e.inv he_inv).inv.app G₂ ≫
        ((δ_p p₁ p₂ e.hom he_hom).inv.app ((pf_of e.inv).obj G₂) ≫
          (pf_of p₂).map ε_hom)
    have hc_mid : c_mid = 𝟙 ((pf_of p₂).obj G₂) := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W_op
      rcases W_op with ⟨W⟩
      let V₁ : Z₁.Etale := (B_of p₁).obj W
      let V₂ : Z₂.Etale := (B_of p₂).obj W
      let m₁ : (B_of e.inv).obj V₁ ⟶ V₂ := (e_Bp p₂ p₁ e.inv he_inv).hom.app W
      let m₂ : (B_of e.inv).obj ((B_of e.hom).obj V₂) ⟶ (B_of e.inv).obj V₁ :=
        (B_of e.inv).map ((e_Bp p₁ p₂ e.hom he_hom).hom.app W)
      let m₃ : V₂ ⟶ (B_of e.inv).obj ((B_of e.hom).obj V₂) :=
        (i_comp Z₁ Z₂ e).inv.app V₂
      have hm : m₃ ≫ (m₂ ≫ m₁) = 𝟙 V₂ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        have hm₁ : ((Fgt Z₂).map m₁).left ≫
            CategoryTheory.Limits.pullback.fst ((Fgt X₀).obj W).hom p₂ =
            CategoryTheory.Limits.pullback.fst ((Fgt Z₁).obj V₁).hom e.inv ≫
              CategoryTheory.Limits.pullback.fst ((Fgt X₀).obj W).hom p₁ :=
          hCompCongrHomFst e.inv p₁ p₂ he_inv W
        have hm₂_step : ((Fgt Z₂).map m₂).left ≫
            CategoryTheory.Limits.pullback.fst ((Fgt Z₁).obj V₁).hom e.inv =
            CategoryTheory.Limits.pullback.fst ((Fgt Z₁).obj ((B_of e.hom).obj V₂)).hom e.inv ≫
              ((Fgt Z₁).map ((e_Bp p₁ p₂ e.hom he_hom).hom.app W)).left :=
          hMapFst e.inv ((e_Bp p₁ p₂ e.hom he_hom).hom.app W)
        have hα_pos : ((Fgt Z₁).map ((e_Bp p₁ p₂ e.hom he_hom).hom.app W)).left ≫
            CategoryTheory.Limits.pullback.fst ((Fgt X₀).obj W).hom p₁ =
            CategoryTheory.Limits.pullback.fst ((Fgt Z₂).obj V₂).hom e.hom ≫
              CategoryTheory.Limits.pullback.fst ((Fgt X₀).obj W).hom p₂ :=
          hCompCongrHomFst e.hom p₂ p₁ he_hom W
        have hm₃_fst : ((Fgt Z₂).map m₃).left ≫
            (CategoryTheory.Limits.pullback.fst ((Fgt Z₁).obj ((B_of e.hom).obj V₂)).hom e.inv ≫
              CategoryTheory.Limits.pullback.fst ((Fgt Z₂).obj V₂).hom e.hom) =
            𝟙 ((Fgt Z₂).obj V₂).left :=
          (CategoryTheory.Category.assoc
            ((Fgt Z₂).map (idPullCompObj Z₂ V₂).inv).left
            ((Fgt Z₂).map ((compCongrIso e.inv e.hom (𝟙 Z₂) e.inv_hom_id).inv.app V₂)).left
            _).trans
            ((congrArg (((Fgt Z₂).map (idPullCompObj Z₂ V₂).inv).left ≫ ·)
              (hCompCongrInvFst e.inv e.hom (𝟙 Z₂) e.inv_hom_id V₂)).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _))
        let f₃ := ((Fgt Z₂).map m₃).left
        let f₂ := ((Fgt Z₂).map m₂).left
        let f₁ := ((Fgt Z₂).map m₁).left
        let fst_p₂ := CategoryTheory.Limits.pullback.fst ((Fgt X₀).obj W).hom p₂
        let fst_p₁ := CategoryTheory.Limits.pullback.fst ((Fgt X₀).obj W).hom p₁
        let fst_e_inv := CategoryTheory.Limits.pullback.fst ((Fgt Z₁).obj V₁).hom e.inv
        let fst_e_inv2 := CategoryTheory.Limits.pullback.fst
          ((Fgt Z₁).obj ((B_of e.hom).obj V₂)).hom e.inv
        let fst_e_hom := CategoryTheory.Limits.pullback.fst ((Fgt Z₂).obj V₂).hom e.hom
        let α_left := ((Fgt Z₁).map ((e_Bp p₁ p₂ e.hom he_hom).hom.app W)).left
        have hTot_fst : (f₃ ≫ (f₂ ≫ f₁)) ≫ fst_p₂ =
            𝟙 ((Fgt Z₂).obj V₂).left ≫ fst_p₂ :=
          (CategoryTheory.Category.assoc f₃ (f₂ ≫ f₁) fst_p₂).trans <|
          (congrArg (f₃ ≫ ·) (CategoryTheory.Category.assoc f₂ f₁ fst_p₂)).trans <|
          (congrArg (fun x => f₃ ≫ (f₂ ≫ x)) hm₁).trans <|
          (congrArg (f₃ ≫ ·) (CategoryTheory.Category.assoc f₂ fst_e_inv fst_p₁).symm).trans <|
          (congrArg (fun x => f₃ ≫ (x ≫ fst_p₁)) hm₂_step).trans <|
          (congrArg (f₃ ≫ ·) (CategoryTheory.Category.assoc fst_e_inv2 α_left fst_p₁)).trans <|
          (congrArg (fun x => f₃ ≫ (fst_e_inv2 ≫ x)) hα_pos).trans <|
          (congrArg (f₃ ≫ ·)
            (CategoryTheory.Category.assoc fst_e_inv2 fst_e_hom fst_p₂).symm).trans <|
          (CategoryTheory.Category.assoc f₃ (fst_e_inv2 ≫ fst_e_hom) fst_p₂).symm.trans <|
          congrArg (· ≫ fst_p₂) hm₃_fst
        exact CategoryTheory.Limits.pullback.hom_ext hTot_fst
          ((hEtaleW (m₃ ≫ (m₂ ≫ m₁))).trans (hEtaleW (𝟙 V₂)).symm)
      change (((δ_p p₂ p₁ e.inv he_inv).inv.app G₂).hom.app (Opposite.op W)) ≫
          ((((δ_p p₁ p₂ e.hom he_hom).inv.app ((pf_of e.inv).obj G₂)).hom.app (Opposite.op W)) ≫
            (((pf_of p₂).map ε_hom).hom.app (Opposite.op W))) =
        𝟙 (G₂.obj.obj (Opposite.op V₂))
      rw [CategoryTheory.Functor.sheafPushforwardContinuousComp'_inv_app_hom_app,
        CategoryTheory.Functor.sheafPushforwardContinuousComp'_inv_app_hom_app,
        CategoryTheory.Functor.sheafPushforwardContinuous_map_hom_app]
      have hε_app : ε_hom.hom.app (Opposite.op V₂) = G₂.obj.map (Opposite.op m₃) :=
        CategoryTheory.Functor.sheafPushforwardContinuousComp'_hom_app_hom_app
          (i_comp Z₁ Z₂ e) AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology Z₂.smallEtaleTopology G₂ (Opposite.op V₂)
      rw [hε_app]
      change G₂.obj.map (Opposite.op m₁) ≫
          (G₂.obj.map (Opposite.op m₂) ≫ G₂.obj.map (Opposite.op m₃)) =
        𝟙 (G₂.obj.obj (Opposite.op V₂))
      rw [← G₂.obj.map_comp, ← G₂.obj.map_comp]
      exact (congrArg (fun k => G₂.obj.map (Opposite.op k)) hm).trans
        (G₂.obj.map_id (Opposite.op V₂))
    apply ((adj_of p₂).homEquiv 𝒢 G₂).injective
    have hRHS : ((adj_of p₂).homEquiv 𝒢 G₂) (𝟙 G₂) = (adj_of p₂).unit.app 𝒢 :=
      (CategoryTheory.Adjunction.homEquiv_unit (adj_of p₂) 𝒢 G₂ (𝟙 G₂)).trans
        ((congrArg ((adj_of p₂).unit.app 𝒢 ≫ ·) ((pf_of p₂).map_id G₂)).trans
          (CategoryTheory.Category.comp_id _))
    have hnat : (δ_p p₁ p₂ e.hom he_hom).inv.app G₁ ≫
        (pf_of p₂).map ((pf_of e.hom).map ψ_neg) =
        (pf_of p₁).map ψ_neg ≫
          (δ_p p₁ p₂ e.hom he_hom).inv.app ((pf_of e.inv).obj G₂) :=
      ((δ_p p₁ p₂ e.hom he_hom).inv.naturality ψ_neg).symm
    have hLHS : ((adj_of p₂).homEquiv 𝒢 G₂) (ψ_pos ≫ ((pf_of e.hom).map ψ_neg ≫ ε_hom)) =
        (adj_of p₂).unit.app 𝒢 ≫ c_mid :=
      (CategoryTheory.Adjunction.homEquiv_naturality_right (adj_of p₂) ψ_pos
        ((pf_of e.hom).map ψ_neg ≫ ε_hom)).trans <|
      (congrArg (· ≫ (pf_of p₂).map ((pf_of e.hom).map ψ_neg ≫ ε_hom))
        (((adj_of p₂).homEquiv 𝒢 ((pf_of e.hom).obj G₁)).apply_symm_apply _)).trans <|
      (congrArg (((adj_of p₁).unit.app 𝒢 ≫ (δ_p p₁ p₂ e.hom he_hom).inv.app G₁) ≫ ·)
        ((pf_of p₂).map_comp ((pf_of e.hom).map ψ_neg) ε_hom)).trans <|
      (CategoryTheory.Category.assoc ((adj_of p₁).unit.app 𝒢)
        ((δ_p p₁ p₂ e.hom he_hom).inv.app G₁) _).trans <|
      (congrArg ((adj_of p₁).unit.app 𝒢 ≫ ·)
        (CategoryTheory.Category.assoc ((δ_p p₁ p₂ e.hom he_hom).inv.app G₁)
          ((pf_of p₂).map ((pf_of e.hom).map ψ_neg)) ((pf_of p₂).map ε_hom)).symm).trans <|
      (congrArg (fun x => (adj_of p₁).unit.app 𝒢 ≫ (x ≫ (pf_of p₂).map ε_hom)) hnat).trans <|
      (congrArg ((adj_of p₁).unit.app 𝒢 ≫ ·)
        (CategoryTheory.Category.assoc ((pf_of p₁).map ψ_neg) _ _)).trans <|
      (CategoryTheory.Category.assoc ((adj_of p₁).unit.app 𝒢)
        ((pf_of p₁).map ψ_neg) _).symm.trans <|
      (congrArg (· ≫ ((δ_p p₁ p₂ e.hom he_hom).inv.app ((pf_of e.inv).obj G₂) ≫
        (pf_of p₂).map ε_hom)) (hψ_unit p₂ p₁ e.inv he_inv)).trans <|
      CategoryTheory.Category.assoc ((adj_of p₂).unit.app 𝒢)
        ((δ_p p₂ p₁ e.inv he_inv).inv.app G₂) _
    exact hLHS.trans ((congrArg ((adj_of p₂).unit.app 𝒢 ≫ ·) hc_mid).trans
      ((CategoryTheory.Category.comp_id _).trans hRHS.symm))

  have he_inv_pr : e_X.inv ≫ pr_X' = pr_X := by
    rw [← he_pr, ← CategoryTheory.Category.assoc, e_X.inv_hom_id,
      CategoryTheory.Category.id_comp]

  let G_std := L_prX.obj 𝒢
  let G' := L_prX'.obj 𝒢
  let P_pos := pf_of e_X.hom
  let P_neg := pf_of e_X.inv
  let u : G_std ⟶ P_pos.obj G' := ψ_over pr_X' pr_X e_X.hom he_pr
  let ψ_inv : G' ⟶ P_neg.obj G_std := ψ_over pr_X pr_X' e_X.inv he_inv_pr
  let v : P_pos.obj G' ⟶ P_pos.obj (P_neg.obj G_std) := P_pos.map ψ_inv
  let e₁_hom : P_pos.obj (P_neg.obj G_std) ⟶ G_std := (ε₁ X' X_std e_X).hom.app G_std
  let e₁_inv : G_std ⟶ P_pos.obj (P_neg.obj G_std) := (ε₁ X' X_std e_X).inv.app G_std
  let w : P_neg.obj G_std ⟶ G' := P_neg.map u ≫ (ε₁ X_std X' e_X.symm).hom.app G'

  have h₁ : u ≫ (v ≫ e₁_hom) = 𝟙 G_std :=
    hRightInv pr_X' pr_X e_X he_pr he_inv_pr

  have hIso_u : CategoryTheory.IsIso u := by
    have := CategoryTheory.Functor.isContinuous_id X_std.smallEtaleTopology
    have he_id : e₁_hom ≫ e₁_inv = 𝟙 (P_pos.obj (P_neg.obj G_std)) :=
      (ε₁ X' X_std e_X).hom_inv_id_app G_std
    have huv : u ≫ v = e₁_inv :=
      (CategoryTheory.Category.comp_id (u ≫ v)).symm.trans <|
      (congrArg ((u ≫ v) ≫ ·) he_id.symm).trans <|
      (CategoryTheory.Category.assoc (u ≫ v) e₁_hom e₁_inv).symm.trans <|
      (congrArg (· ≫ e₁_inv) ((CategoryTheory.Category.assoc u v e₁_hom).symm.trans h₁)).trans <|
      CategoryTheory.Category.id_comp e₁_inv
    have hLeft_v : (e₁_hom ≫ u) ≫ v = 𝟙 (P_pos.obj (P_neg.obj G_std)) :=
      (CategoryTheory.Category.assoc e₁_hom u v).trans
        ((congrArg (e₁_hom ≫ ·) huv).trans he_id)
    have hRight_v : v ≫ P_pos.map w = 𝟙 (P_pos.obj G') :=
      (P_pos.map_comp ψ_inv w).symm.trans
        ((congrArg P_pos.map (hRightInv pr_X pr_X' e_X.symm he_inv_pr he_pr)).trans
          (P_pos.map_id G'))
    have hEq_inv : e₁_hom ≫ u = P_pos.map w :=
      (CategoryTheory.Category.comp_id (e₁_hom ≫ u)).symm.trans <|
      (congrArg ((e₁_hom ≫ u) ≫ ·) hRight_v.symm).trans <|
      (CategoryTheory.Category.assoc (e₁_hom ≫ u) v (P_pos.map w)).symm.trans <|
      (congrArg (· ≫ P_pos.map w) hLeft_v).trans <|
      CategoryTheory.Category.id_comp (P_pos.map w)
