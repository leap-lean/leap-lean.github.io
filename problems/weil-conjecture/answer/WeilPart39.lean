  have hRepPullEval : ∀ {W_top Y : AlgebraicGeometry.Scheme.{u}} (g_top : W_top ⟶ Y)
      (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (U_Y : Y.Etale) (U_W : W_top.Etale)
      (u : U_W ⟶ (weilEtaleSitePullback g_top).obj U_Y)
      (ψ : weilPolyP1CohomologyRepSheaf Y U_Y ⟶ F),
