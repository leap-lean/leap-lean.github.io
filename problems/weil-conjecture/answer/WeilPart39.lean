            have h2 : w_eq ≫ v = CategoryTheory.Limits.pullback.snd pair_uv δ_h₂ := by
              calc w_eq ≫ v = w_eq ≫ pair_uv ≫ CategoryTheory.Limits.pullback.snd h₂ h₂ := by
                    rw [CategoryTheory.Limits.pullback.lift_snd]
                _ = (w_eq ≫ pair_uv) ≫ CategoryTheory.Limits.pullback.snd h₂ h₂ :=
                    (Category.assoc _ _ _).symm
                _ = (CategoryTheory.Limits.pullback.snd pair_uv δ_h₂ ≫ δ_h₂) ≫
                      CategoryTheory.Limits.pullback.snd h₂ h₂ := by
                    rw [CategoryTheory.Limits.pullback.condition]
                _ = CategoryTheory.Limits.pullback.snd pair_uv δ_h₂ := by
                    rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                      Category.comp_id]
            exact h1.trans h2.symm
          refine ⟨Z, m_el, ?_⟩
          apply CategoryTheory.Functor.Elements.hom_ext
          apply Fgt.map_injective
          exact CategoryTheory.Over.OverMorphism.ext hw_uv }
    have hNonempty : Nonempty fib.Elements :=
      ⟨CategoryTheory.Functor.elementsMk fib
        (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W)) ⟨w, Category.comp_id w⟩⟩
    let _ : CategoryTheory.IsCofilteredOrEmpty fib.Elements := hCofOrEmpty
    let hCof : CategoryTheory.IsCofiltered fib.Elements :=
      { toIsCofilteredOrEmpty := hCofOrEmpty, nonempty := hNonempty }
    let _ : CategoryTheory.IsCofiltered fib.Elements := hCof

    
    let ι_aff : W.AffineEtale ⥤ W.Etale := AlgebraicGeometry.Scheme.AffineEtale.Spec W
    let eq_sm := CategoryTheory.equivSmallModel.{u} W.AffineEtale
    let Idx : Type u :=
      Sigma fun m : CategoryTheory.SmallModel.{u} W.AffineEtale =>
        fib.obj (ι_aff.obj (eq_sm.inverse.obj m))
    let g_idx : Idx → fib.Elements := fun p =>
      CategoryTheory.Functor.elementsMk fib (ι_aff.obj (eq_sm.inverse.obj p.1)) p.2
    have hDomIdx : ∀ d : fib.Elements, ∃ p : Idx, Nonempty (g_idx p ⟶ d) := by
      intro d
      let E := d.obj
      let e := d.val
      let V_E := (Fgt.obj E).left
      let h_E : V_E ⟶ W := (Fgt.obj E).hom
      let _ : AlgebraicGeometry.Etale h_E := E.prop
      obtain ⟨V, hV_aff, hyV, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := (⊤ : V_E.Opens)) (x := e.1.base pt_Ω) trivial
      let R_obj : CommRingCat.{u} := V_E.presheaf.obj (Opposite.op V)
      let j_V : AlgebraicGeometry.Spec R_obj ⟶ V_E := hV_aff.isoSpec.inv ≫ V.ι
      have _ : AlgebraicGeometry.IsOpenImmersion j_V := inferInstance
      have _ : AlgebraicGeometry.Etale j_V := inferInstance
      have hrange : Set.range e.1.base ⊆ Set.range j_V.base := by
        rintro _ ⟨pt, rfl⟩
        rw [hSpecFieldUnique Ω pt pt_Ω]
        refine ⟨hV_aff.isoSpec.hom.base ⟨e.1.base pt_Ω, hyV⟩, ?_⟩
        change V.ι.base (hV_aff.isoSpec.inv.base (hV_aff.isoSpec.hom.base ⟨e.1.base pt_Ω, hyV⟩)) =
          e.1.base pt_Ω
        have h_inv_hom :
            hV_aff.isoSpec.inv.base (hV_aff.isoSpec.hom.base ⟨e.1.base pt_Ω, hyV⟩) =
              ⟨e.1.base pt_Ω, hyV⟩ := by
          change (hV_aff.isoSpec.hom ≫ hV_aff.isoSpec.inv).base ⟨e.1.base pt_Ω, hyV⟩ = _
          rw [hV_aff.isoSpec.hom_inv_id]
          rfl
        rw [h_inv_hom]
        rfl
      let e_V : S_Ω ⟶ AlgebraicGeometry.Spec R_obj :=
        AlgebraicGeometry.IsOpenImmersion.lift j_V e.1 hrange
      have he_V : e_V ≫ j_V = e.1 :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j_V e.1 hrange
      have hEt_jV : AlgebraicGeometry.Etale (j_V ≫ h_E) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) j_V h_E
          inferInstance inferInstance
      let A₀ : W.AffineEtale :=
        @AlgebraicGeometry.Scheme.AffineEtale.mk W R_obj (j_V ≫ h_E) hEt_jV
      let e_A₀ : fib.obj (ι_aff.obj A₀) :=
        ⟨e_V, by
          change e_V ≫ (j_V ≫ h_E) = w
          rw [← Category.assoc, he_V, e.2]⟩
      let j_mor : ι_aff.obj A₀ ⟶ E :=
        CategoryTheory.MorphismProperty.Over.homMk j_V rfl trivial
      let m₀ : CategoryTheory.SmallModel.{u} W.AffineEtale := eq_sm.functor.obj A₀
      let u_hom : ι_aff.obj A₀ ⟶ ι_aff.obj (eq_sm.inverse.obj m₀) :=
        ι_aff.map (eq_sm.unitIso.app A₀).hom
      let u_inv : ι_aff.obj (eq_sm.inverse.obj m₀) ⟶ ι_aff.obj A₀ :=
        ι_aff.map (eq_sm.unitIso.app A₀).inv
      let e_m₀ : fib.obj (ι_aff.obj (eq_sm.inverse.obj m₀)) := (fib.map u_hom) e_A₀
      let p : Idx := ⟨m₀, e_m₀⟩
      have hmap_p : (fib.map (u_inv ≫ j_mor)) e_m₀ = e := by
        have h1 : (fib.map u_inv) e_m₀ = e_A₀ := by
          dsimp [e_m₀]
          have hcomp := congrArg (fun φ => φ e_A₀) (fib.map_comp u_hom u_inv)
          dsimp at hcomp
          rw [← hcomp]
          have hid : u_hom ≫ u_inv = 𝟙 (ι_aff.obj A₀) := by
            change ι_aff.map ((eq_sm.unitIso.app A₀).hom) ≫
                ι_aff.map ((eq_sm.unitIso.app A₀).inv) = 𝟙 (ι_aff.obj A₀)
            rw [← ι_aff.map_comp, (eq_sm.unitIso.app A₀).hom_inv_id, ι_aff.map_id]
            rfl
          rw [hid, fib.map_id]
          rfl
        have hcomp2 := congrArg (fun φ => φ e_m₀) (fib.map_comp u_inv j_mor)
        dsimp at hcomp2
        rw [hcomp2, h1]
        exact Subtype.ext he_V
      exact ⟨p, ⟨CategoryTheory.Functor.Elements.homMk (F := fib) (x := g_idx p) (y := d)
        (u_inv ≫ j_mor) hmap_p⟩⟩

    let instCatIdx : CategoryTheory.SmallCategory Idx :=
      { Hom := fun p₁ p₂ => g_idx p₁ ⟶ g_idx p₂
        id := fun p => 𝟙 (g_idx p)
        comp := fun f g => @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ f g
        id_comp := fun f => @Category.id_comp fib.Elements _ _ _ f
        comp_id := fun f => @Category.comp_id fib.Elements _ _ _ f
        assoc := fun f g l => @Category.assoc fib.Elements _ _ _ _ _ f g l }
    let _ : CategoryTheory.SmallCategory Idx := instCatIdx
    let F_init : Idx ⥤ fib.Elements :=
      { obj := g_idx
        map := fun f => f
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    have hCofIdx : CategoryTheory.IsCofilteredOrEmpty Idx :=
      { cone_objs := fun p₁ p₂ => by
          obtain ⟨c₀, π₁, π₂, _⟩ :=
            CategoryTheory.IsCofilteredOrEmpty.cone_objs (g_idx p₁) (g_idx p₂)
          obtain ⟨p, ⟨k⟩⟩ := hDomIdx c₀
          exact ⟨p, @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k π₁,
            @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k π₂, trivial⟩
        cone_maps := fun {p₁ p₂} f g => by
          obtain ⟨c₀, m, hm⟩ :=
            @CategoryTheory.IsCofilteredOrEmpty.cone_maps _ _ _ (g_idx p₁) (g_idx p₂) f g
          obtain ⟨p, ⟨k⟩⟩ := hDomIdx c₀
          refine ⟨p, @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k m, ?_⟩
          change @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _
              (@CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k m) f =
            @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _
              (@CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k m) g
          rw [Category.assoc, hm, Category.assoc] }
    let _ : CategoryTheory.IsCofilteredOrEmpty Idx := hCofIdx
    have hInitF : F_init.Initial := by
      rw [CategoryTheory.Functor.initial_iff_of_isCofiltered F_init]
      refine ⟨hDomIdx, ?_⟩
      intro d p s s'
      obtain ⟨c₀, m, hm⟩ :=
        @CategoryTheory.IsCofilteredOrEmpty.cone_maps _ _ _ (g_idx p) d s s'
      obtain ⟨p', ⟨k⟩⟩ := hDomIdx c₀
      refine ⟨p', @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k m, ?_⟩
      change @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _
          (@CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k m) s =
        @CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _
          (@CategoryTheory.CategoryStruct.comp fib.Elements _ _ _ _ k m) s'
      rw [Category.assoc, hm, Category.assoc]
    have hInitSmall : CategoryTheory.InitiallySmall.{u} fib.Elements :=
      ⟨Idx, instCatIdx, F_init, hInitF⟩

    
    have hJoint : ∀ {E : W.Etale}, ∀ R ∈ W.smallEtaleTopology E, ∀ x : fib.obj E,
        ∃ Y u, ∃ (_ : R.arrows u), ∃ y : fib.obj Y, (fib.map u) y = x := by
      intro E R hR e
      obtain ⟨Y, u, y₀, huR, hEt_u, hy₀_eq⟩ :=
        (hMem W E R).mp hR (e.1.base pt_Ω)
      let _ : AlgebraicGeometry.Etale ((Fgt.map u).left) := hEt_u
      obtain ⟨z₀, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ pt_Ω hy₀_eq
      let Z_pb := CategoryTheory.Limits.pullback ((Fgt.map u).left) e.1
      let q_snd : Z_pb ⟶ S_Ω := CategoryTheory.Limits.pullback.snd ((Fgt.map u).left) e.1
      have _ : AlgebraicGeometry.Etale q_snd := inferInstance
      obtain ⟨s₀, hs₀⟩ := hLiftSpec Ω Z_pb q_snd z₀
      let e_Y_hom : S_Ω ⟶ (Fgt.obj Y).left :=
        s₀ ≫ CategoryTheory.Limits.pullback.fst ((Fgt.map u).left) e.1
      have he_Y_u : e_Y_hom ≫ (Fgt.map u).left = e.1 := by
        dsimp [e_Y_hom]
        rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc,
          hs₀, Category.id_comp]
      let e_Y : fib.obj Y :=
        ⟨e_Y_hom, by rw [← (Fgt.map u).w, ← Category.assoc, he_Y_u, e.2]⟩
      exact ⟨Y, u, huR, e_Y, Subtype.ext he_Y_u⟩

    let _ : CategoryTheory.InitiallySmall.{u} fib.Elements := hInitSmall
    exact ⟨CategoryTheory.GrothendieckTopology.Point.mk fib hCof hInitSmall hJoint,
      fun _ => Equiv.refl _, fun _ _ => rfl⟩

  
  have hMonoMap : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}}
      (f : ℱ₁ ⟶ ℱ₂) [CategoryTheory.Mono f],
      CategoryTheory.Mono (pb.map f) := by
    intro ℱ₁ ℱ₂ f _
    let B := weilEtaleSitePullback h
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget X₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget X₂
    let ℋ₁ := pb.obj ℱ₁
    let ℋ₂ := pb.obj ℱ₂
    let ψ : ℋ₁ ⟶ ℋ₂ := pb.map f

    
    have hStalkInj : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (w₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X₁)
        (Φ₁ : CategoryTheory.GrothendieckTopology.Point.{u} X₁.smallEtaleTopology)
        (θ₁ : ∀ E₁ : X₁.Etale, Φ₁.fiber.obj E₁ ≃ (mkGeomFiber X₁ Ω w₁).obj E₁),
        (∀ {E₁ E₁' : X₁.Etale} (u : E₁ ⟶ E₁') (z : Φ₁.fiber.obj E₁),
          θ₁ E₁' ((Φ₁.fiber.map u) z) = ((mkGeomFiber X₁ Ω w₁).map u) (θ₁ E₁ z)) →
        Function.Injective (Φ₁.sheafFiber.map ψ).hom := by
      intro Ω _ _ w₁ Φ₁ θ₁ hθ₁
      obtain ⟨Φ₂, θ₂, hθ₂⟩ := hGeomPointEx X₂ Ω (w₁ ≫ h)
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let fib₁ := mkGeomFiber X₁ Ω w₁
      let fib₂ := mkGeomFiber X₂ Ω (w₁ ≫ h)
      let e_base : ∀ E₂ : X₂.Etale, fib₁.obj (B.obj E₂) ≃ fib₂.obj E₂ := fun E₂ =>
        { toFun := fun z =>
            let h_E₂ : (Fgt₂.obj E₂).left ⟶ X₂ := (Fgt₂.obj E₂).hom
            let z_hom : S_Ω ⟶ CategoryTheory.Limits.pullback h_E₂ h := z.1
            have hz : z_hom ≫ CategoryTheory.Limits.pullback.snd h_E₂ h = w₁ := z.2
            ⟨z_hom ≫ CategoryTheory.Limits.pullback.fst h_E₂ h, by
              change (z_hom ≫ CategoryTheory.Limits.pullback.fst h_E₂ h) ≫ h_E₂ = w₁ ≫ h
              rw [Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc, hz]⟩
          invFun := fun z₂ =>
            let h_E₂ : (Fgt₂.obj E₂).left ⟶ X₂ := (Fgt₂.obj E₂).hom
            let z₂_hom : S_Ω ⟶ (Fgt₂.obj E₂).left := z₂.1
            have hz₂ : z₂_hom ≫ h_E₂ = w₁ ≫ h := z₂.2
            ⟨CategoryTheory.Limits.pullback.lift z₂_hom w₁ hz₂,
              CategoryTheory.Limits.pullback.lift_snd z₂_hom w₁ hz₂⟩
          left_inv := fun z => by
            apply Subtype.ext
            let h_E₂ : (Fgt₂.obj E₂).left ⟶ X₂ := (Fgt₂.obj E₂).hom
            let z_hom : S_Ω ⟶ CategoryTheory.Limits.pullback h_E₂ h := z.1
            have hz : z_hom ≫ CategoryTheory.Limits.pullback.snd h_E₂ h = w₁ := z.2
            change CategoryTheory.Limits.pullback.lift
                (z_hom ≫ CategoryTheory.Limits.pullback.fst h_E₂ h) w₁ _ = z_hom
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
            · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans hz.symm
          right_inv := fun z₂ => by
            apply Subtype.ext
            let h_E₂ : (Fgt₂.obj E₂).left ⟶ X₂ := (Fgt₂.obj E₂).hom
            let z₂_hom : S_Ω ⟶ (Fgt₂.obj E₂).left := z₂.1
            have hz₂ : z₂_hom ≫ h_E₂ = w₁ ≫ h := z₂.2
            exact CategoryTheory.Limits.pullback.lift_fst z₂_hom w₁ hz₂ }
      let e : ∀ E₂ : X₂.Etale, Φ₁.fiber.obj (B.obj E₂) ≃ Φ₂.fiber.obj E₂ := fun E₂ =>
        (θ₁ (B.obj E₂)).trans ((e_base E₂).trans (θ₂ E₂).symm)
      have he_nat : ∀ {E₂ E₂' : X₂.Etale} (u : E₂ ⟶ E₂') (z : Φ₁.fiber.obj (B.obj E₂)),
          e E₂' ((Φ₁.fiber.map (B.map u)) z) = (Φ₂.fiber.map u) (e E₂ z) := by
        intro E₂ E₂' u z
        apply (θ₂ E₂').injective
        have hl : θ₂ E₂' (e E₂' ((Φ₁.fiber.map (B.map u)) z)) =
            e_base E₂' ((fib₁.map (B.map u)) (θ₁ (B.obj E₂) z)) := by
          dsimp [e]
          rw [(θ₂ E₂').apply_symm_apply, hθ₁ (B.map u) z]
        have hr : θ₂ E₂' ((Φ₂.fiber.map u) (e E₂ z)) =
            (fib₂.map u) (e_base E₂ (θ₁ (B.obj E₂) z)) := by
          rw [hθ₂ u (e E₂ z)]
          dsimp [e]
          rw [(θ₂ E₂).apply_symm_apply]
        rw [hl, hr]
        apply Subtype.ext
        let z₀ := θ₁ (B.obj E₂) z
        let h_E₂ : (Fgt₂.obj E₂).left ⟶ X₂ := (Fgt₂.obj E₂).hom
        let h_E₂' : (Fgt₂.obj E₂').left ⟶ X₂ := (Fgt₂.obj E₂').hom
        let u_left : (Fgt₂.obj E₂).left ⟶ (Fgt₂.obj E₂').left := (Fgt₂.map u).left
        let z₀_hom : S_Ω ⟶ CategoryTheory.Limits.pullback h_E₂ h := z₀.1
        have hcomm_u : (CategoryTheory.Limits.pullback.fst h_E₂ h ≫ u_left) ≫ h_E₂' =
            CategoryTheory.Limits.pullback.snd h_E₂ h ≫ h :=
          (Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst h_E₂ h)) ((Fgt₂.map u).w)).trans
              CategoryTheory.Limits.pullback.condition)
        have hBu : ((Fgt₁.map (B.map u)).left :
            CategoryTheory.Limits.pullback h_E₂ h ⟶ CategoryTheory.Limits.pullback h_E₂' h) =
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst h_E₂ h ≫ u_left)
              (CategoryTheory.Limits.pullback.snd h_E₂ h) hcomm_u := rfl
        let bu_hom : CategoryTheory.Limits.pullback h_E₂ h ⟶
            CategoryTheory.Limits.pullback h_E₂' h := (Fgt₁.map (B.map u)).left
        change (z₀_hom ≫ bu_hom) ≫ CategoryTheory.Limits.pullback.fst h_E₂' h =
          (z₀_hom ≫ CategoryTheory.Limits.pullback.fst h_E₂ h) ≫ u_left
        rw [show bu_hom = _ from hBu, Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, Category.assoc]

      
      let Sky₁ := Φ₁.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let Sky₂ := Φ₂.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
      let ξ_app : ∀ (M : AddCommGrpCat.{u}) (E₂ : X₂.Etale),
          ((pf.obj (Sky₁.obj M)).obj).obj (Opposite.op E₂) ≅
            ((Sky₂.obj M).obj).obj (Opposite.op E₂) :=
        fun M E₂ => CategoryTheory.Limits.Pi.reindex (e E₂) (fun _ : Φ₂.fiber.obj E₂ => M)
      have hξ_presheaf_nat : ∀ (M : AddCommGrpCat.{u}) {X Y : (X₂.Etale)ᵒᵖ} (v : X ⟶ Y),
          ((pf.obj (Sky₁.obj M)).obj.map v) ≫ (ξ_app M Y.unop).hom =
            (ξ_app M X.unop).hom ≫ ((Sky₂.obj M).obj.map v) := by
        intro M X Y v
        let E₂' := X.unop
        let E₂ := Y.unop
        let u : E₂ ⟶ E₂' := v.unop
        change (CategoryTheory.Limits.Pi.map'
              (CategoryTheory.ConcreteCategory.hom (Φ₁.fiber.map (B.map u))) fun _ => 𝟙 M) ≫
            (CategoryTheory.Limits.Pi.reindex (e E₂) (fun _ : Φ₂.fiber.obj E₂ => M)).hom =
          (CategoryTheory.Limits.Pi.reindex (e E₂') (fun _ : Φ₂.fiber.obj E₂' => M)).hom ≫
            (CategoryTheory.Limits.Pi.map'
              (CategoryTheory.ConcreteCategory.hom (Φ₂.fiber.map u)) fun _ => 𝟙 M)
        apply CategoryTheory.Limits.Pi.hom_ext
        intro c
        let z : Φ₁.fiber.obj (B.obj E₂) := (e E₂).symm c
        have hc_eq : c = e E₂ z := ((e E₂).apply_symm_apply c).symm
        rw [hc_eq, Category.assoc, CategoryTheory.Limits.Pi.reindex_hom_π]
        dsimp only [Function.comp_def]
        rw [CategoryTheory.Limits.Pi.map'_comp_π, Category.comp_id,
          Category.assoc, CategoryTheory.Limits.Pi.map'_comp_π, Category.comp_id]
        have h_idx : (Φ₂.fiber.map u) (e E₂ z) = e E₂' ((Φ₁.fiber.map (B.map u)) z) :=
          (he_nat u z).symm
        rw [h_idx, CategoryTheory.Limits.Pi.reindex_hom_π]
        rfl
      let Ξ_pre : ∀ M : AddCommGrpCat.{u},
          (pf.obj (Sky₁.obj M)).obj ≅ (Sky₂.obj M).obj :=
        fun M => CategoryTheory.NatIso.ofComponents (fun X => ξ_app M X.unop)
          (fun v => hξ_presheaf_nat M v)
      let Ξ_obj : ∀ M : AddCommGrpCat.{u}, pf.obj (Sky₁.obj M) ≅ Sky₂.obj M :=
        fun M =>
          { hom := ⟨(Ξ_pre M).hom⟩
            inv := ⟨(Ξ_pre M).inv⟩
            hom_inv_id := CategoryTheory.Sheaf.hom_ext (Ξ_pre M).hom_inv_id
            inv_hom_id := CategoryTheory.Sheaf.hom_ext (Ξ_pre M).inv_hom_id }
      have hΞ_nat : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (g : M₁ ⟶ M₂),
          pf.map (Sky₁.map g) ≫ (Ξ_obj M₂).hom = (Ξ_obj M₁).hom ≫ Sky₂.map g := by
        intro M₁ M₂ g
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext X
        let E₂ := X.unop
        change (CategoryTheory.Limits.Pi.map fun _ : Φ₁.fiber.obj (B.obj E₂) => g) ≫
            (CategoryTheory.Limits.Pi.reindex (e E₂) (fun _ : Φ₂.fiber.obj E₂ => M₂)).hom =
          (CategoryTheory.Limits.Pi.reindex (e E₂) (fun _ : Φ₂.fiber.obj E₂ => M₁)).hom ≫
            (CategoryTheory.Limits.Pi.map fun _ : Φ₂.fiber.obj E₂ => g)
        apply CategoryTheory.Limits.Pi.hom_ext
        intro c
        let z : Φ₁.fiber.obj (B.obj E₂) := (e E₂).symm c
        have hc_eq : c = e E₂ z := ((e E₂).apply_symm_apply c).symm
        rw [hc_eq, Category.assoc, CategoryTheory.Limits.Pi.reindex_hom_π]
        dsimp only [Function.comp_def]
        rw [CategoryTheory.Limits.Pi.map_π, Category.assoc, CategoryTheory.Limits.Pi.map_π,
          ← Category.assoc, CategoryTheory.Limits.Pi.reindex_hom_π]
        rfl
      let Ξ : Sky₁ ⋙ pf ≅ Sky₂ :=
        CategoryTheory.NatIso.ofComponents Ξ_obj (fun g => hΞ_nat g)

      let adj₁ := Φ₁.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
      let adj₂ := Φ₂.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
      let adj_comp : pb ⋙ Φ₁.sheafFiber ⊣ Sky₂ :=
        CategoryTheory.Adjunction.ofNatIsoRight (adj.comp adj₁) Ξ
      let Θ : pb ⋙ Φ₁.sheafFiber ≅ Φ₂.sheafFiber :=
        CategoryTheory.Adjunction.leftAdjointUniq adj_comp adj₂
      have _ : CategoryTheory.Limits.PreservesFiniteLimits
          (Φ₂.sheafFiber (A := AddCommGrpCat.{u})) := inferInstance
      have _ : CategoryTheory.Mono (Φ₂.sheafFiber.map f) := Φ₂.sheafFiber.map_mono f
      have hInj₂ : Function.Injective (Φ₂.sheafFiber.map f).hom :=
        (AddCommGrpCat.mono_iff_injective (Φ₂.sheafFiber.map f)).mp inferInstance
      have hNatΘ : Φ₁.sheafFiber.map ψ ≫ Θ.hom.app ℱ₂ =
          Θ.hom.app ℱ₁ ≫ Φ₂.sheafFiber.map f := Θ.hom.naturality f
      intro a₁ a₂ ha
      have ha' : ((Φ₁.sheafFiber.map ψ ≫ Θ.hom.app ℱ₂).hom) a₁ =
          ((Φ₁.sheafFiber.map ψ ≫ Θ.hom.app ℱ₂).hom) a₂ :=
        congrArg (Θ.hom.app ℱ₂).hom ha
      rw [hNatΘ] at ha'
      have hb : (Θ.hom.app ℱ₁).hom a₁ = (Θ.hom.app ℱ₁).hom a₂ := hInj₂ ha'
      have h_inv₁ := congrArg (Θ.inv.app ℱ₁).hom hb
      change ((Θ.hom.app ℱ₁ ≫ Θ.inv.app ℱ₁).hom) a₁ =
        ((Θ.hom.app ℱ₁ ≫ Θ.inv.app ℱ₁).hom) a₂ at h_inv₁
      rwa [Θ.hom_inv_id_app ℱ₁] at h_inv₁

    
    have hSheafEqZero : ∀ (E : X₁.Etale) (s : ↑(ℋ₁.obj.obj (Opposite.op E)))
        (R : CategoryTheory.Sieve E),
        R ∈ X₁.smallEtaleTopology E →
        (∀ ⦃Y : X₁.Etale⦄ (u : Y ⟶ E), R.arrows u → (ℋ₁.obj.map (Opposite.op u)).hom s = 0) →
        s = 0 := by
      intro E s R hR hvan
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let α_s : Aℤ ⟶ ℋ₁.obj.obj (Opposite.op E) :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • s
            map_zero' := zero_zsmul s
            map_add' := fun x y => add_zsmul s x.down y.down }
      have hsep := (ℋ₁.property Aℤ).isSeparated R hR
      have hα0 : α_s = 0 := by
        apply hsep.ext
        intro Y u hu
        change α_s ≫ ℋ₁.obj.map (Opposite.op u) = 0 ≫ ℋ₁.obj.map (Opposite.op u)
        rw [CategoryTheory.Limits.zero_comp]
        ext n
        change (ℋ₁.obj.map (Opposite.op u)).hom (n.down • s) = 0
        rw [map_zsmul, hvan u hu, zsmul_zero]
      have h1 := congrArg (fun g : Aℤ ⟶ ℋ₁.obj.obj (Opposite.op E) => g.hom (ULift.up 1)) hα0
      simpa only [α_s, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
        one_zsmul, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] using h1

    
    have hSecZero : ∀ (E : X₁.Etale) (s : ↑(ℋ₁.obj.obj (Opposite.op E))),
        (ψ.hom.app (Opposite.op E)).hom s = 0 → s = 0 := by
      intro E s hs0
      let R_s : CategoryTheory.Sieve E :=
        { arrows := fun Y u => (ℋ₁.obj.map u.op).hom s = 0
          downward_closed := fun {Y Z} {u} hu v => by
            rw [op_comp, ℋ₁.obj.map_comp]
            change (ℋ₁.obj.map v.op).hom ((ℋ₁.obj.map u.op).hom s) = 0
            rw [hu, map_zero] }
      have hR_mem : R_s ∈ X₁.smallEtaleTopology E := by
        rw [hMem X₁ E R_s]
        intro y
        let V_E := (Fgt₁.obj E).left
        let h_E : V_E ⟶ X₁ := (Fgt₁.obj E).hom
        let _ : AlgebraicGeometry.Etale h_E := E.prop
        let κ := V_E.residueField y
        let Ω := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let pt_Ω : ↥S_Ω := IsLocalRing.closedPoint Ω
        let e_y : S_Ω ⟶ V_E :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)) ≫
            V_E.fromSpecResidueField y
        let w_y : S_Ω ⟶ X₁ := e_y ≫ h_E
        have hey_pt : e_y.base pt_Ω = y :=
          V_E.fromSpecResidueField_apply y
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω))).base pt_Ω)
        obtain ⟨Φ₁, θ₁, hθ₁⟩ := hGeomPointEx X₁ Ω w_y
        let x_fib : (mkGeomFiber X₁ Ω w_y).obj E := ⟨e_y, rfl⟩
        let x_E : Φ₁.fiber.obj E := (θ₁ E).symm x_fib
        have hnat_stalk := Φ₁.toPresheafFiber_naturality_apply ψ.hom E x_E s
        change (Φ₁.sheafFiber.map ψ).hom ((Φ₁.toPresheafFiber E x_E ℋ₁.obj).hom s) =
          (Φ₁.toPresheafFiber E x_E ℋ₂.obj).hom ((ψ.hom.app (Opposite.op E)).hom s) at hnat_stalk
        rw [hs0, map_zero] at hnat_stalk
        have hInj_y := hStalkInj Ω w_y Φ₁ θ₁ hθ₁
        have hstalk0 : (Φ₁.toPresheafFiber E x_E ℋ₁.obj).hom s =
            (Φ₁.toPresheafFiber E x_E ℋ₁.obj).hom 0 := by
          rw [map_zero]
          exact hInj_y (hnat_stalk.trans (map_zero _).symm)
        obtain ⟨Y, u, z_Y, hz_map, hs_eq⟩ :=
          (Φ₁.toPresheafFiber_eq_iff' E x_E s 0).mp hstalk0
        rw [map_zero] at hs_eq
        have _ : AlgebraicGeometry.Etale ((Fgt₁.obj Y).hom) := Y.prop
        have _ : AlgebraicGeometry.Etale ((Fgt₁.map u).left ≫ h_E) := by
          rwa [(Fgt₁.map u).w]
        have hEt_u : AlgebraicGeometry.Etale ((Fgt₁.map u).left) :=
          AlgebraicGeometry.Etale.of_comp ((Fgt₁.map u).left) h_E
        have hz_hom : (θ₁ Y z_Y).1 ≫ (Fgt₁.map u).left = e_y := by
          have h_eq : θ₁ E ((Φ₁.fiber.map u) z_Y) = x_fib := by
            rw [hz_map]
            exact (θ₁ E).apply_symm_apply x_fib
          rw [hθ₁ u z_Y] at h_eq
          exact congrArg Subtype.val h_eq
        refine ⟨Y, u, (θ₁ Y z_Y).1.base pt_Ω, hs_eq, hEt_u, ?_⟩
        calc ((Fgt₁.map u).left).base ((θ₁ Y z_Y).1.base pt_Ω)
            = ((θ₁ Y z_Y).1 ≫ (Fgt₁.map u).left).base pt_Ω := rfl
          _ = e_y.base pt_Ω := by rw [hz_hom]
          _ = y := hey_pt
      exact hSheafEqZero E s R_s hR_mem (fun Y u hu => hu)

    
    refine ⟨fun {𝒦} α β hαβ => ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    ext X t
    let E := X.unop
    have h_app : ((α ≫ ψ).hom.app (Opposite.op E)).hom t =
        ((β ≫ ψ).hom.app (Opposite.op E)).hom t := by
      rw [hαβ]
    have h_diff : (ψ.hom.app (Opposite.op E)).hom
        ((α.hom.app (Opposite.op E)).hom t - (β.hom.app (Opposite.op E)).hom t) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact h_app
    exact sub_eq_zero.mp (hSecZero E _ h_diff)

  
  rw [CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono]
  intro S hS
  have hExact_S : (S.map pb).Exact :=
    ((CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi pb).mp
      hColim S hS).1
  let _ : CategoryTheory.Mono S.f := hS.mono_f
  exact ⟨hExact_S, hMonoMap S.f⟩

theorem weil_zero_ext_subsheaf_gluing_and_local_shortExact (D₀ : AlgebraicGeometry.Scheme.{u}) :
    (∀ (U₀ : D₀.Opens) (V : AlgebraicGeometry.Scheme.{u}) (ι : V ⟶ D₀)
        [AlgebraicGeometry.Etale ι]
        (Γ : Type u) (v_aut : Γ → (V ⟶ V)) (hv_aut : ∀ σ : Γ, v_aut σ ≫ ι = ι)
        (A : Type) [AddCommGroup A] (M_act : Γ → (A →+ A)),
      ∃ (𝒥 : CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u})
        (triv_! : ∀ W : D₀.Etale,
          let W_V := CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom ι
          ↑(𝒥.obj.obj (Opposite.op W)) →+ LocallyConstant ↥W_V A),
        (∀ {W₁ W₂ : D₀.Etale} (u : W₁ ⟶ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W₂).hom
          let W₁_V := CategoryTheory.Limits.pullback h₁ ι
          let W₂_V := CategoryTheory.Limits.pullback h₂ ι
          ∀ (u_V : W₁_V ⟶ W₂_V),
            u_V ≫ CategoryTheory.Limits.pullback.fst h₂ ι =
              CategoryTheory.Limits.pullback.fst h₁ ι ≫
                ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left →
            u_V ≫ CategoryTheory.Limits.pullback.snd h₂ ι =
              CategoryTheory.Limits.pullback.snd h₁ ι →
            ∀ (s : ↑(𝒥.obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_V),
              triv_! W₁ ((𝒥.obj.map (Opposite.op u)) s) y₁ =
                triv_! W₂ s (u_V.base y₁)) ∧
        (∀ W : D₀.Etale,
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom
          let W_V := CategoryTheory.Limits.pullback h_W ι
          Function.Injective (triv_! W) ∧
          Set.range (triv_! W) =
            { f |
              (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).left.Opens,
                ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
                ∀ y : ↥W_V,
                  (CategoryTheory.Limits.pullback.fst h_W ι).base y ∈ W₀ → f y = 0) ∧
              (∀ (σ : Γ) (m_σ : W_V ⟶ W_V),
                m_σ ≫ CategoryTheory.Limits.pullback.fst h_W ι =
                  CategoryTheory.Limits.pullback.fst h_W ι →
                m_σ ≫ CategoryTheory.Limits.pullback.snd h_W ι =
                  CategoryTheory.Limits.pullback.snd h_W ι ≫ v_aut σ →
                ∀ y : ↥W_V, f (m_σ.base y) = M_act σ (f y)) })) ∧
    (∀ (ℱ₁ ℱ₂ ℱ₃ : CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u})
        (f : ℱ₁ ⟶ ℱ₂) (g : ℱ₂ ⟶ ℱ₃) (h0 : f ≫ g = 0),
      (∀ W : D₀.Etale, Function.Injective (f.hom.app (Opposite.op W))) →
      (∀ (W : D₀.Etale) (s₂ : ↑(ℱ₂.obj.obj (Opposite.op W))),
        (g.hom.app (Opposite.op W)) s₂ = 0 →
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).left,
          ∃ (U : D₀.Etale) (u : U ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget D₀).obj U).left)
            (s₁ : ↑(ℱ₁.obj.obj (Opposite.op U))),
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left.base y = x ∧
            (f.hom.app (Opposite.op U)) s₁ = (ℱ₂.obj.map (Opposite.op u)) s₂) →
      (∀ (W : D₀.Etale) (s₃ : ↑(ℱ₃.obj.obj (Opposite.op W)))
          (x : ↥((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).left),
        ∃ (U : D₀.Etale) (u : U ⟶ W)
          (y : ↥((AlgebraicGeometry.Scheme.Etale.forget D₀).obj U).left)
          (s₂ : ↑(ℱ₂.obj.obj (Opposite.op U))),
          AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left ∧
          ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left.base y = x ∧
          (g.hom.app (Opposite.op U)) s₂ = (ℱ₃.obj.map (Opposite.op u)) s₃) →
      (CategoryTheory.ShortComplex.mk f g h0).ShortExact) :=
by
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hMem : ∀ (W : D₀.Etale) (R : CategoryTheory.Sieve W),
      R ∈ D₀.smallEtaleTopology W ↔
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).left,
          ∃ (Y : D₀.Etale) (f : Y ⟶ W)
            (y : ↥((AlgebraicGeometry.Scheme.Etale.forget D₀).obj Y).left),
            R.arrows f ∧
            AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget D₀).map f).left ∧
            ((AlgebraicGeometry.Scheme.Etale.forget D₀).map f).left.base y = x := by
    intro W R
    have heq : D₀.smallGrothendieckTopology P_et =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology D₀
        (le_refl P_et)
    have h1 : R ∈ D₀.smallEtaleTopology W ↔
        R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck W :=
      iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology D₀.Etale => R ∈ J W) heq)
    exact h1.trans
      (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology P_et P_et D₀ _ _ _ _ _ W R)
  refine ⟨?_, ?_⟩
  · 
    intro U₀ V ι _ Γ v_aut hv_aut A _ M_act
    classical
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget D₀
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let m_can : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h : X ⟶ D₀) (σ : Γ),
        CategoryTheory.Limits.pullback h ι ⟶ CategoryTheory.Limits.pullback h ι :=
      fun {X} h σ =>
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst h ι)
          (CategoryTheory.Limits.pullback.snd h ι ≫ v_aut σ)
          (by rw [CategoryTheory.Category.assoc, hv_aut σ, CategoryTheory.Limits.pullback.condition])
    have hm_can_eq : ∀ {X : AlgebraicGeometry.Scheme.{u}} (h : X ⟶ D₀) (σ : Γ)
        (m : CategoryTheory.Limits.pullback h ι ⟶ CategoryTheory.Limits.pullback h ι),
        m ≫ CategoryTheory.Limits.pullback.fst h ι = CategoryTheory.Limits.pullback.fst h ι →
        m ≫ CategoryTheory.Limits.pullback.snd h ι =
          CategoryTheory.Limits.pullback.snd h ι ≫ v_aut σ →
        m = m_can h σ := by
      intro X h σ m hfst hsnd
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [hfst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [hsnd, CategoryTheory.Limits.pullback.lift_snd]
    let u_can : ∀ {W₁ W₂ : D₀.Etale} (u : W₁ ⟶ W₂),
        CategoryTheory.Limits.pullback (Fgt.obj W₁).hom ι ⟶
          CategoryTheory.Limits.pullback (Fgt.obj W₂).hom ι :=
      fun {W₁ W₂} u =>
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom ι ≫ (Fgt.map u).left)
          (CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom ι)
          (by rw [CategoryTheory.Category.assoc, (Fgt.map u).w,
                CategoryTheory.Limits.pullback.condition])
    have hu_can_fst : ∀ {W₁ W₂ : D₀.Etale} (u : W₁ ⟶ W₂),
        u_can u ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj W₂).hom ι =
          CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom ι ≫ (Fgt.map u).left :=
      fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hu_can_snd : ∀ {W₁ W₂ : D₀.Etale} (u : W₁ ⟶ W₂),
        u_can u ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj W₂).hom ι =
          CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom ι :=
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hu_can_eq : ∀ {W₁ W₂ : D₀.Etale} (u : W₁ ⟶ W₂)
        (u_V : CategoryTheory.Limits.pullback (Fgt.obj W₁).hom ι ⟶
          CategoryTheory.Limits.pullback (Fgt.obj W₂).hom ι),
        u_V ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj W₂).hom ι =
          CategoryTheory.Limits.pullback.fst (Fgt.obj W₁).hom ι ≫ (Fgt.map u).left →
        u_V ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj W₂).hom ι =
          CategoryTheory.Limits.pullback.snd (Fgt.obj W₁).hom ι →
        u_V = u_can u := by
      intro W₁ W₂ u u_V hfst hsnd
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [hfst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [hsnd, CategoryTheory.Limits.pullback.lift_snd]
    have hu_can_id : ∀ W : D₀.Etale, u_can (𝟙 W) = 𝟙 _ := by
      intro W
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
        have hid : (Fgt.map (𝟙 W)).left = 𝟙 _ := by rw [Fgt.map_id]; rfl
        rw [hid, CategoryTheory.Category.comp_id]
      · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
    have hu_can_comp : ∀ {W₁ W₂ W₃ : D₀.Etale} (u₁ : W₁ ⟶ W₂) (u₂ : W₂ ⟶ W₃),
        u_can (u₁ ≫ u₂) = u_can u₁ ≫ u_can u₂ := by
      intro W₁ W₂ W₃ u₁ u₂
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
        have hcomp : (Fgt.map (u₁ ≫ u₂)).left = (Fgt.map u₁).left ≫ (Fgt.map u₂).left := by
          rw [Fgt.map_comp]; rfl
        rw [hcomp]
      · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
    have hm_u_comm : ∀ {W₁ W₂ : D₀.Etale} (u : W₁ ⟶ W₂) (σ : Γ),
        m_can (Fgt.obj W₁).hom σ ≫ u_can u = u_can u ≫ m_can (Fgt.obj W₂).hom σ := by
      intro W₁ W₂ u σ
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd]

    let S_! : ∀ W : D₀.Etale,
        AddSubgroup (LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι) A) :=
      fun W =>
        let h_W := (Fgt.obj W).hom
        let W_V := CategoryTheory.Limits.pullback h_W ι
        { carrier := { f |
            (∃ W₀ : (Fgt.obj W).left.Opens,
              ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
              ∀ y : ↥W_V, (CategoryTheory.Limits.pullback.fst h_W ι).base y ∈ W₀ → f y = 0) ∧
            (∀ (σ : Γ) (y : ↥W_V), f ((m_can h_W σ).base y) = M_act σ (f y)) }
          zero_mem' := by
            refine ⟨⟨⊤, sup_top_eq _, fun y _ => LocallyConstant.zero_apply y⟩, fun σ y => ?_⟩
            rw [LocallyConstant.zero_apply, LocallyConstant.zero_apply, map_zero]
          add_mem' := by
            rintro f₁ f₂ ⟨⟨W₀₁, hcov₁, hvan₁⟩, heq₁⟩ ⟨⟨W₀₂, hcov₂, hvan₂⟩, heq₂⟩
            refine ⟨⟨W₀₁ ⊓ W₀₂, ?_, ?_⟩, fun σ y => ?_⟩
            · rw [sup_inf_left, hcov₁, hcov₂, top_inf_eq]
            · intro y hy
              rw [LocallyConstant.add_apply, hvan₁ y hy.1, hvan₂ y hy.2, add_zero]
            · rw [LocallyConstant.add_apply, LocallyConstant.add_apply, heq₁ σ y, heq₂ σ y, map_add]
          neg_mem' := by
            rintro f ⟨⟨W₀, hcov, hvan⟩, heq⟩
            refine ⟨⟨W₀, hcov, ?_⟩, fun σ y => ?_⟩
            · intro y hy
              rw [LocallyConstant.neg_apply, hvan y hy, neg_zero]
            · rw [LocallyConstant.neg_apply, LocallyConstant.neg_apply, heq σ y, map_neg] }

    let res_hom : ∀ {W₁ W₂ : D₀.Etale} (u : W₁ ⟶ W₂), ↥(S_! W₂) →+ ↥(S_! W₁) :=
      fun {W₁ W₂} u =>
        { toFun := fun s =>
            ⟨s.1.comap (u_can u).base.hom, ⟨by
              rcases s.2.1 with ⟨W₂₀, hcov₂, hvan₂⟩
              let u_left := (Fgt.map u).left
              let W₁₀ : (Fgt.obj W₁).left.Opens := (TopologicalSpace.Opens.map u_left.base).obj W₂₀
              refine ⟨W₁₀, ?_, ?_⟩
              · rw [eq_top_iff]
                intro x _
                have hx₂ : u_left.base x ∈
                    ((TopologicalSpace.Opens.map (Fgt.obj W₂).hom.base).obj U₀) ⊔ W₂₀ := by
                  rw [hcov₂]
                  trivial
                rcases hx₂ with hxU | hxW
                · left
                  change (Fgt.obj W₁).hom.base x ∈ U₀
                  have hw : u_left ≫ (Fgt.obj W₂).hom = (Fgt.obj W₁).hom := (Fgt.map u).w
                  rw [← hw, AlgebraicGeometry.Scheme.Hom.comp_apply]
                  exact hxU
                · right
                  exact hxW
              · intro y₁ hy₁
                change s.1 ((u_can u).base y₁) = 0
                apply hvan₂ ((u_can u).base y₁)
                have hfst := congrArg (fun k => k.base y₁) (hu_can_fst u)
                rw [AlgebraicGeometry.Scheme.Hom.comp_apply,
                  AlgebraicGeometry.Scheme.Hom.comp_apply] at hfst
                rw [hfst]
                exact hy₁,
            fun σ y₁ => by
              change s.1 ((u_can u).base ((m_can (Fgt.obj W₁).hom σ).base y₁)) =
                M_act σ (s.1 ((u_can u).base y₁))
              have hpt : (u_can u).base ((m_can (Fgt.obj W₁).hom σ).base y₁) =
                  (m_can (Fgt.obj W₂).hom σ).base ((u_can u).base y₁) := by
                rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hm_u_comm u σ,
                  AlgebraicGeometry.Scheme.Hom.comp_apply]
              rw [hpt]
              exact s.2.2 σ ((u_can u).base y₁)⟩⟩
          map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
          map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }

    let 𝒥_pre : (D₀.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun W_op => AddCommGrpCat.of ↥(S_! W_op.unop)
        map := fun f_op => AddCommGrpCat.ofHom (res_hom f_op.unop)
        map_id := fun W_op => by
          apply AddCommGrpCat.ext
          intro s
          apply Subtype.ext
          apply LocallyConstant.ext
          intro y
          change s.1 ((u_can (𝟙 W_op.unop)).base y) = s.1 y
          rw [hu_can_id]
          rfl
        map_comp := fun f g => by
          apply AddCommGrpCat.ext
          intro s
          apply Subtype.ext
          apply LocallyConstant.ext
          intro y
          change s.1 ((u_can (g.unop ≫ f.unop)).base y) =
            s.1 ((u_can f.unop).base ((u_can g.unop).base y))
          rw [hu_can_comp, AlgebraicGeometry.Scheme.Hom.comp_apply] }

    have hu_et : ∀ {Y₁ Y₂ : D₀.Etale} (u : Y₁ ⟶ Y₂), AlgebraicGeometry.Etale (Fgt.map u).left := by
      intro Y₁ Y₂ u
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (Fgt.map u).left (Fgt.obj Y₂).hom Y₂.prop (by rw [(Fgt.map u).w]; exact Y₁.prop)
    have hu_pb : ∀ {Y₁ Y₂ : D₀.Etale} (u : Y₁ ⟶ Y₂),
        CategoryTheory.IsPullback (u_can u)
          (CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι)
          (CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι)
          (Fgt.map u).left := by
      intro Y₁ Y₂ u
      have hOuter : CategoryTheory.IsPullback
          (u_can u ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₂).hom ι)
          (CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι)
          ι ((Fgt.map u).left ≫ (Fgt.obj Y₂).hom) := by
        rw [CategoryTheory.Limits.pullback.lift_snd, (Fgt.map u).w]
        exact (CategoryTheory.IsPullback.of_hasPullback (Fgt.obj Y₁).hom ι).flip
      exact CategoryTheory.IsPullback.of_right hOuter
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback (Fgt.obj Y₂).hom ι).flip
    have hu_can_et : ∀ {Y₁ Y₂ : D₀.Etale} (u : Y₁ ⟶ Y₂), AlgebraicGeometry.Etale (u_can u) :=
      fun u => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hu_pb u).flip (hu_et u)

    have hSheaf : CategoryTheory.Presheaf.IsSheaf D₀.smallEtaleTopology 𝒥_pre := by
      intro M W R_sieve hR x hx
      let h_W := (Fgt.obj W).hom
      let W_V := CategoryTheory.Limits.pullback h_W ι
      have hCov_base : ∀ p : ↥(Fgt.obj W).left,
          ∃ (Y : D₀.Etale) (f : Y ⟶ W) (_ : R_sieve.arrows f) (q : ↥(Fgt.obj Y).left),
            (Fgt.map f).left.base q = p := by
        intro p
        obtain ⟨Y, f, q, hf_arr, _, hfq⟩ := (hMem W R_sieve).mp hR p
        exact ⟨Y, f, hf_arr, q, hfq⟩
      let Y_p : ↥(Fgt.obj W).left → D₀.Etale := fun p => Classical.choose (hCov_base p)
      let f_p : ∀ p : ↥(Fgt.obj W).left, Y_p p ⟶ W :=
        fun p => Classical.choose (Classical.choose_spec (hCov_base p))
      have hf_p : ∀ p : ↥(Fgt.obj W).left, R_sieve.arrows (f_p p) :=
        fun p => Classical.choose (Classical.choose_spec (Classical.choose_spec (hCov_base p)))
      let q_p : ∀ p : ↥(Fgt.obj W).left, ↥(Fgt.obj (Y_p p)).left :=
        fun p => Classical.choose
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov_base p))))
      have hq_p : ∀ p : ↥(Fgt.obj W).left, (Fgt.map (f_p p)).left.base (q_p p) = p :=
        fun p => Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov_base p))))
      have hLift_pt : ∀ {Y : D₀.Etale} (u : Y ⟶ W) (z : ↥W_V) (y : ↥(Fgt.obj Y).left),
          (Fgt.map u).left.base y = (CategoryTheory.Limits.pullback.fst h_W ι).base z →
          ∃ w : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y).hom ι),
            (u_can u).base w = z ∧
            (CategoryTheory.Limits.pullback.fst (Fgt.obj Y).hom ι).base w = y := by
        intro Y u z y hy
        obtain ⟨pt, hpt_fst, hpt_snd⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
        refine ⟨((hu_pb u).isoPullback.inv).base pt, ?_, ?_⟩
        · have h1 := congrArg (fun k => k.base pt) (hu_pb u).isoPullback_inv_fst
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at h1
          exact h1.trans hpt_fst
        · have h2 := congrArg (fun k => k.base pt) (hu_pb u).isoPullback_inv_snd
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at h2
          exact h2.trans hpt_snd
      have hOverlap : ∀ (m : ↥M) {Y₁ Y₂ : D₀.Etale} (f₁ : Y₁ ⟶ W) (f₂ : Y₂ ⟶ W)
          (hf₁ : R_sieve.arrows f₁) (hf₂ : R_sieve.arrows f₂)
          (w₁ : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y₁).hom ι))
          (w₂ : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y₂).hom ι)),
          (u_can f₁).base w₁ = (u_can f₂).base w₂ →
          ((x f₁ hf₁).hom m).1 w₁ = ((x f₂ hf₂).hom m).1 w₂ := by
        intro m Y₁ Y₂ f₁ f₂ hf₁ hf₂ w₁ w₂ hw_eq
        let u₁_left := (Fgt.map f₁).left
        let u₂_left := (Fgt.map f₂).left
        let P₁₂ := CategoryTheory.Limits.pullback u₁_left u₂_left
        let p₁ := CategoryTheory.Limits.pullback.fst u₁_left u₂_left
        let p₂ := CategoryTheory.Limits.pullback.snd u₁_left u₂_left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁_left u₂_left).flip (hu_et f₂)
        have hp₁Y₁_et : AlgebraicGeometry.Etale (p₁ ≫ (Fgt.obj Y₁).hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ (Fgt.obj Y₁).hom hp₁_et Y₁.prop
        let Z₁₂ : D₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (p₁ ≫ (Fgt.obj Y₁).hom)
        have hp₂_w : p₂ ≫ (Fgt.obj Y₂).hom = (Fgt.obj Z₁₂).hom := by
          change p₂ ≫ (Fgt.obj Y₂).hom = p₁ ≫ (Fgt.obj Y₁).hom
          rw [← (Fgt.map f₂).w, ← CategoryTheory.Category.assoc,
            ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
            (Fgt.map f₁).w]
        let p1_et : Z₁₂ ⟶ Y₁ :=
          (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful D₀).preimage
            (CategoryTheory.Over.homMk p₁ rfl)
        let p2_et : Z₁₂ ⟶ Y₂ :=
          (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful D₀).preimage
            (CategoryTheory.Over.homMk p₂ hp₂_w)
        have hp1_et_left : (Fgt.map p1_et).left = p₁ :=
          congrArg CategoryTheory.Over.Hom.left
            ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful D₀).map_preimage _)
        have hp2_et_left : (Fgt.map p2_et).left = p₂ :=
          congrArg CategoryTheory.Over.Hom.left
            ((AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful D₀).map_preimage _)
        have hp_comm : p1_et ≫ f₁ = p2_et ≫ f₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful D₀).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          change (Fgt.map (p1_et ≫ f₁)).left = (Fgt.map (p2_et ≫ f₂)).left
          rw [Fgt.map_comp, Fgt.map_comp]
          change (Fgt.map p1_et).left ≫ u₁_left = (Fgt.map p2_et).left ≫ u₂_left
          rw [hp1_et_left, hp2_et_left]
          exact CategoryTheory.Limits.pullback.condition
        let Q := CategoryTheory.Limits.pullback (u_can f₁) (u_can f₂)
        let q₁ := CategoryTheory.Limits.pullback.fst (u_can f₁) (u_can f₂)
        let q₂ := CategoryTheory.Limits.pullback.snd (u_can f₁) (u_can f₂)
        obtain ⟨q, hq₁, hq₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₁ w₂ hw_eq
        have hψ_U_cond : (q₁ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι) ≫ u₁_left =
            (q₂ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι) ≫ u₂_left := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            ← hu_can_fst f₁, ← hu_can_fst f₂,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition]
        let ψ_U : Q ⟶ P₁₂ :=
          CategoryTheory.Limits.pullback.lift
            (q₁ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι)
            (q₂ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι)
            hψ_U_cond
        have hψU_fst : ψ_U ≫ p₁ = q₁ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₁).hom ι :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hψU_snd : ψ_U ≫ p₂ = q₂ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Y₂).hom ι :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hψ_cond : ψ_U ≫ (Fgt.obj Z₁₂).hom =
            (q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι) ≫ ι := by
          change ψ_U ≫ (p₁ ≫ (Fgt.obj Y₁).hom) = _
          rw [← CategoryTheory.Category.assoc, hψU_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc]
        let ψ : Q ⟶ CategoryTheory.Limits.pullback (Fgt.obj Z₁₂).hom ι :=
          CategoryTheory.Limits.pullback.lift ψ_U
            (q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι) hψ_cond
        have hψ_fst : ψ ≫ CategoryTheory.Limits.pullback.fst (Fgt.obj Z₁₂).hom ι = ψ_U :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hψ_snd : ψ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Z₁₂).hom ι =
            q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hψ_p₁ : ψ ≫ u_can p1_et = q₁ := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hu_can_fst p1_et,
              ← CategoryTheory.Category.assoc, hψ_fst, hp1_et_left]
            exact hψU_fst
          · rw [CategoryTheory.Category.assoc, hu_can_snd p1_et, hψ_snd]
        have hψ_p₂ : ψ ≫ u_can p2_et = q₂ := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hu_can_fst p2_et,
              ← CategoryTheory.Category.assoc, hψ_fst, hp2_et_left]
            exact hψU_snd
          · rw [CategoryTheory.Category.assoc, hu_can_snd p2_et, hψ_snd]
            calc q₁ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₁).hom ι
                = q₁ ≫ u_can f₁ ≫ CategoryTheory.Limits.pullback.snd h_W ι := by
                    rw [hu_can_snd f₁]
              _ = (q₁ ≫ u_can f₁) ≫ CategoryTheory.Limits.pullback.snd h_W ι :=
                    (CategoryTheory.Category.assoc _ _ _).symm
              _ = (q₂ ≫ u_can f₂) ≫ CategoryTheory.Limits.pullback.snd h_W ι := by
                    rw [CategoryTheory.Limits.pullback.condition]
              _ = q₂ ≫ CategoryTheory.Limits.pullback.snd (Fgt.obj Y₂).hom ι := by
                    rw [CategoryTheory.Category.assoc, hu_can_snd f₂]
        have hcompat :
            (x f₁ hf₁ ≫ 𝒥_pre.map (Opposite.op p1_et) : M ⟶ 𝒥_pre.obj (Opposite.op Z₁₂)) =
              x f₂ hf₂ ≫ 𝒥_pre.map (Opposite.op p2_et) :=
          hx p1_et p2_et hf₁ hf₂ hp_comm
        have hval := congrArg (fun k : M ⟶ 𝒥_pre.obj (Opposite.op Z₁₂) => (k.hom m).1 (ψ.base q))
          hcompat
        change ((x f₁ hf₁).hom m).1 ((u_can p1_et).base (ψ.base q)) =
          ((x f₂ hf₂).hom m).1 ((u_can p2_et).base (ψ.base q)) at hval
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← AlgebraicGeometry.Scheme.Hom.comp_apply,
          hψ_p₁, hψ_p₂, hq₁, hq₂] at hval
        exact hval
      let p_z : ↥W_V → ↥(Fgt.obj W).left :=
        fun z => (CategoryTheory.Limits.pullback.fst h_W ι).base z
      let Y_z : ↥W_V → D₀.Etale := fun z => Y_p (p_z z)
      let f_z : ∀ z : ↥W_V, Y_z z ⟶ W := fun z => f_p (p_z z)
      have hf_z : ∀ z : ↥W_V, R_sieve.arrows (f_z z) := fun z => hf_p (p_z z)
      let w_z : ∀ z : ↥W_V, ↥(CategoryTheory.Limits.pullback (Fgt.obj (Y_z z)).hom ι) :=
        fun z => Classical.choose (hLift_pt (f_z z) z (q_p (p_z z)) (hq_p (p_z z)))
      have hw_z : ∀ z : ↥W_V, (u_can (f_z z)).base (w_z z) = z :=
        fun z => (Classical.choose_spec (hLift_pt (f_z z) z (q_p (p_z z)) (hq_p (p_z z)))).1
      let f_m : ↥M → ↥W_V → A :=
        fun m z => ((x (f_z z) (hf_z z)).hom m).1 (w_z z)
      have hf_m_eval : ∀ (m : ↥M) {Y : D₀.Etale} (f : Y ⟶ W) (hf : R_sieve.arrows f)
          (w : ↥(CategoryTheory.Limits.pullback (Fgt.obj Y).hom ι)),
          f_m m ((u_can f).base w) = ((x f hf).hom m).1 w := by
        intro m Y f hf w
        exact hOverlap m (f_z ((u_can f).base w)) f (hf_z _) hf (w_z _) w (hw_z _)
      have hf_m_lc : ∀ m : ↥M, IsLocallyConstant (f_m m) := by
        intro m S_set
        have hpre : f_m m ⁻¹' S_set =
            ⋃ z : ↥W_V, (u_can (f_z z)).base '' (((x (f_z z) (hf_z z)).hom m).1 ⁻¹' S_set) := by
          ext z₀
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
          constructor
          · intro hz₀
            exact ⟨z₀, w_z z₀, hz₀, hw_z z₀⟩
          · rintro ⟨z, w, hw_mem, rfl⟩
            rwa [hf_m_eval m (f_z z) (hf_z z) w]
        rw [hpre]
        refine isOpen_iUnion fun z => ?_
        have : AlgebraicGeometry.Etale (u_can (f_z z)) := hu_can_et (f_z z)
        exact (u_can (f_z z)).isOpenMap _ (((x (f_z z) (hf_z z)).hom m).1.isLocallyConstant S_set)
      have hf_m_mem : ∀ m : ↥M, ⟨f_m m, hf_m_lc m⟩ ∈ S_! W := by
        intro m
        refine ⟨?_, ?_⟩
        · let W₀_p : ∀ p : ↥(Fgt.obj W).left, (Fgt.obj (Y_p p)).left.Opens :=
            fun p => Classical.choose ((x (f_p p) (hf_p p)).hom m).2.1
          have hcov_p : ∀ p : ↥(Fgt.obj W).left,
              ((TopologicalSpace.Opens.map (Fgt.obj (Y_p p)).hom.base).obj U₀) ⊔ W₀_p p = ⊤ :=
            fun p => (Classical.choose_spec ((x (f_p p) (hf_p p)).hom m).2.1).1
          have hvan_p : ∀ (p : ↥(Fgt.obj W).left)
              (y : ↥(CategoryTheory.Limits.pullback (Fgt.obj (Y_p p)).hom ι)),
              (CategoryTheory.Limits.pullback.fst (Fgt.obj (Y_p p)).hom ι).base y ∈ W₀_p p →
              ((x (f_p p) (hf_p p)).hom m).1 y = 0 :=
            fun p => (Classical.choose_spec ((x (f_p p) (hf_p p)).hom m).2.1).2
          let O_p : ↥(Fgt.obj W).left → (Fgt.obj W).left.Opens := fun p =>
            have : AlgebraicGeometry.Etale (Fgt.map (f_p p)).left := hu_et (f_p p)
            ⟨(Fgt.map (f_p p)).left.base '' (W₀_p p : Set ↥(Fgt.obj (Y_p p)).left),
              ((Fgt.map (f_p p)).left).isOpenMap _ (W₀_p p).isOpen⟩
          let W₀ : (Fgt.obj W).left.Opens := ⨆ p : ↥(Fgt.obj W).left, O_p p
          refine ⟨W₀, ?_, ?_⟩
          · rw [eq_top_iff]
            intro p _
            have hq_mem : q_p p ∈
                ((TopologicalSpace.Opens.map (Fgt.obj (Y_p p)).hom.base).obj U₀) ⊔ W₀_p p := by
              rw [hcov_p p]
              trivial
            rcases hq_mem with hqU | hqW
            · left
              change h_W.base p ∈ U₀
              have hw : (Fgt.map (f_p p)).left ≫ h_W = (Fgt.obj (Y_p p)).hom := (Fgt.map (f_p p)).w
              rw [← hq_p p, ← AlgebraicGeometry.Scheme.Hom.comp_apply, hw]
              exact hqU
            · right
              exact TopologicalSpace.Opens.mem_iSup.mpr ⟨p, ⟨q_p p, hqW, hq_p p⟩⟩
          · intro z hz
            obtain ⟨p, hp⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
            rcases hp with ⟨w_p, hw_p_mem, hw_p_eq⟩
            obtain ⟨z_p, hz_p_u, hz_p_fst⟩ := hLift_pt (f_p p) z w_p hw_p_eq
            change f_m m z = 0
            rw [← hz_p_u, hf_m_eval m (f_p p) (hf_p p) z_p]
            apply hvan_p p z_p
            rw [hz_p_fst]
            exact hw_p_mem
        · intro σ z
          change f_m m ((m_can h_W σ).base z) = M_act σ (f_m m z)
          conv_lhs => rw [← hw_z z]
          have hpt : (m_can h_W σ).base ((u_can (f_z z)).base (w_z z)) =
              (u_can (f_z z)).base ((m_can (Fgt.obj (Y_z z)).hom σ).base (w_z z)) := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← hm_u_comm (f_z z) σ,
              AlgebraicGeometry.Scheme.Hom.comp_apply]
          rw [hpt, hf_m_eval m (f_z z) (hf_z z)]
          exact ((x (f_z z) (hf_z z)).hom m).2.2 σ (w_z z)
      let t_hom : M ⟶ 𝒥_pre.obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := fun m => ⟨⟨f_m m, hf_m_lc m⟩, hf_m_mem m⟩
            map_zero' := by
              apply Subtype.ext
              apply LocallyConstant.ext
              intro z
              change ((x (f_z z) (hf_z z)).hom 0).1 (w_z z) = 0
              rw [map_zero]
              rfl
            map_add' := fun m₁ m₂ => by
              apply Subtype.ext
              apply LocallyConstant.ext
              intro z
              change ((x (f_z z) (hf_z z)).hom (m₁ + m₂)).1 (w_z z) =
                f_m m₁ z + f_m m₂ z
              rw [map_add]
              rfl }
      refine ⟨t_hom, ?_, ?_⟩
      · intro Y f hf
        apply AddCommGrpCat.ext
        intro m
        apply Subtype.ext
        apply LocallyConstant.ext
        intro w
        exact hf_m_eval m f hf w
      · intro y_hom hy
        apply AddCommGrpCat.ext
        intro m
        apply Subtype.ext
        apply LocallyConstant.ext
        intro z
        have hy_z := hy (f_z z) (hf_z z)
        have hval := congrArg (fun k : M ⟶ 𝒥_pre.obj (Opposite.op (Y_z z)) => (k.hom m).1 (w_z z))
          hy_z
        change (y_hom.hom m).1 ((u_can (f_z z)).base (w_z z)) = f_m m z at hval
        rwa [hw_z z] at hval

    let 𝒥 : CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u} := ⟨𝒥_pre, hSheaf⟩
    let triv_! : ∀ W : D₀.Etale,
        ↑(𝒥.obj.obj (Opposite.op W)) →+
          LocallyConstant ↥(CategoryTheory.Limits.pullback (Fgt.obj W).hom ι) A :=
      fun W => (S_! W).subtype
    refine ⟨𝒥, triv_!, ?_, ?_⟩
    · intro W₁ W₂ u h₁ h₂ W₁_V W₂_V u_V hfst hsnd s y₁
      have hu_eq : u_V = u_can u := hu_can_eq u u_V hfst hsnd
      rw [hu_eq]
      rfl
    · intro W h_W W_V
      refine ⟨Subtype.val_injective, ?_⟩
      ext f
      change f ∈ Set.range (Subtype.val : ↥(S_! W) → _) ↔ _
      rw [Subtype.range_coe_subtype]
      constructor
      · rintro ⟨hcol, heq⟩
        refine ⟨hcol, fun σ m_σ hfst hsnd y => ?_⟩
        rw [hm_can_eq h_W σ m_σ hfst hsnd]
        exact heq σ y
      · rintro ⟨hcol, heq⟩
        refine ⟨hcol, fun σ y => ?_⟩
        exact heq σ (m_can h_W σ)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) y
  · 
    intro ℱ₁ ℱ₂ ℱ₃ f g h0 hf_inj h_ker hg_surj
    let J := D₀.smallEtaleTopology
    have hMono : CategoryTheory.Mono f := by
      refine ⟨fun {𝒢} α₁ α₂ hα => ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W_op
      let W : D₀.Etale := Opposite.unop W_op
      change α₁.hom.app (Opposite.op W) = α₂.hom.app (Opposite.op W)
      apply AddCommGrpCat.ext
      intro z
      apply hf_inj W
      have hval := congrArg (fun k : 𝒢 ⟶ ℱ₂ => (k.hom.app (Opposite.op W)) z) hα
      exact hval
    have hLocSurj : CategoryTheory.Sheaf.IsLocallySurjective g := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {W} s₃ => ?_
      rw [hMem W _]
      intro x
      obtain ⟨U, u, y, s₂, hu_et, hy, hs₂⟩ := hg_surj W s₃ x
      refine ⟨U, u, y, ?_, hu_et, hy⟩
      rw [CategoryTheory.Presheaf.imageSieve_apply]
      exact ⟨s₂, hs₂⟩
    have hEpi : CategoryTheory.Epi g := by
      have := hLocSurj
      exact CategoryTheory.Sheaf.epi_of_isLocallySurjective g
    have hExact : (CategoryTheory.ShortComplex.mk f g h0).Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
      change CategoryTheory.Limits.kernel.ι g ≫ CategoryTheory.Limits.cokernel.π f = 0
      let 𝒞 := CategoryTheory.Limits.cokernel f
      let π_f : ℱ₂ ⟶ 𝒞 := CategoryTheory.Limits.cokernel.π f
      let ι_g : CategoryTheory.Limits.kernel g ⟶ ℱ₂ := CategoryTheory.Limits.kernel.ι g
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W_op
      let W : D₀.Etale := Opposite.unop W_op
      change (ι_g ≫ π_f).hom.app (Opposite.op W) =
        (0 : CategoryTheory.Limits.kernel g ⟶ 𝒞).hom.app (Opposite.op W)
      apply AddCommGrpCat.ext
      intro z
      let s₂ : ↑(ℱ₂.obj.obj (Opposite.op W)) := (ι_g.hom.app (Opposite.op W)) z
      have hs₂_ker : (g.hom.app (Opposite.op W)) s₂ = 0 := by
        have hk := congrArg (fun k : CategoryTheory.Limits.kernel g ⟶ ℱ₃ => (k.hom.app (Opposite.op W)) z)
          (CategoryTheory.Limits.kernel.condition g)
        exact hk
      let R : CategoryTheory.Sieve W :=
        { arrows := fun {Y} u => (𝒞.obj.map (Opposite.op u)) ((π_f.hom.app (Opposite.op W)) s₂) = 0
          downward_closed := by
            intro Y Z u hu v
            change (𝒞.obj.map (Opposite.op u ≫ Opposite.op v))
              ((π_f.hom.app (Opposite.op W)) s₂) = 0
            rw [𝒞.obj.map_comp]
            change (𝒞.obj.map (Opposite.op v))
              ((𝒞.obj.map (Opposite.op u)) ((π_f.hom.app (Opposite.op W)) s₂)) = 0
            rw [hu, map_zero] }
      have hR : R ∈ J W := by
        rw [hMem W R]
        intro x
        obtain ⟨U, u, y, s₁, hu_et, hy, hs₁⟩ := h_ker W s₂ hs₂_ker x
        refine ⟨U, u, y, ?_, hu_et, hy⟩
        change (𝒞.obj.map (Opposite.op u)) ((π_f.hom.app (Opposite.op W)) s₂) = 0
        have hnat := congrArg (fun φ => φ s₂) (π_f.hom.naturality (Opposite.op u))
        change (π_f.hom.app (Opposite.op U)) ((ℱ₂.obj.map (Opposite.op u)) s₂) =
          (𝒞.obj.map (Opposite.op u)) ((π_f.hom.app (Opposite.op W)) s₂) at hnat
        rw [← hnat, ← hs₁]
        have hc := congrArg (fun k : ℱ₁ ⟶ 𝒞 => (k.hom.app (Opposite.op U)) s₁)
          (CategoryTheory.Limits.cokernel.condition f)
        exact hc
      have hzero : (π_f.hom.app (Opposite.op W)) s₂ = 0 := by
        refine CategoryTheory.Presheaf.IsSheaf.isSeparated 𝒞.property W R hR
          ((π_f.hom.app (Opposite.op W)) s₂) 0 ?_
        intro Y u hu
        exact hu.trans (map_zero _).symm
      exact hzero
    exact CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi

theorem weil_curve_zero_ext_sheaf_and_dir_inclusion (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (ℓ N : ℕ) [Fact (Nat.Prime ℓ)] (hN : 1 ≤ N)
    (H_geom : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (A_u : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (A_mat : ∀ (d : ℕ) (P : Polynomial F),
      IsGoodAffineCurveClosedPointPoly S_aff d P → Matrix (Fin N) (Fin N) (PadicInt ℓ))
    (ℰ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℰ : ∀ r : ℕ, Quiver.Hom (ℰ₀ (r + 1)) (ℰ₀ r))
    (hSh : WeilCurveRepSheafTower.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat ℰ₀ τ_ℰ) :
    let D₀ := (weilProjectiveSpaceOver F 1).left
    ∃ (𝒥₀ : ℕ → CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u})
      (τ_𝒥 : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ r))
      (ι_bock : ∀ r : ℕ, Quiver.Hom (𝒥₀ r) (𝒥₀ (r + 1)))
      (ρ_bock : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ 0))
      (ι_ext : ∀ r : ℕ, Quiver.Hom (𝒥₀ r) (weilEtaleHigherDirectImage U₀.ι 0 (ℰ₀ r))),
      WeilCurveZeroExtSystem.{u} F S_aff j_aff U₀ u₀ ℓ N H_geom A_u A_mat 𝒥₀ τ_𝒥 ∧
      (∀ r : ℕ, (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (𝒥₀ r) = 0) ∧
      (∀ r : ℕ,
        (ℓ ^ (r + 1)) •
          CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage U₀.ι 0 (ℰ₀ r)) = 0) ∧
      (∀ r : ℕ,
        ∃ h0 : CategoryTheory.CategoryStruct.comp (ι_bock r) (ρ_bock r) = 0,
          (CategoryTheory.ShortComplex.mk (ι_bock r) (ρ_bock r) h0).ShortExact) ∧
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (ι_bock r) (τ_𝒥 r) =
          ℓ • CategoryTheory.CategoryStruct.id (𝒥₀ r)) ∧
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (τ_𝒥 r) (ι_bock r) =
          CategoryTheory.CategoryStruct.comp (ι_bock (r + 1)) (τ_𝒥 (r + 1))) ∧
      ρ_bock 0 = τ_𝒥 0 ∧
      (∀ r : ℕ,
        ρ_bock (r + 1) = CategoryTheory.CategoryStruct.comp (τ_𝒥 (r + 1)) (ρ_bock r)) ∧
      (∀ r : ℕ, CategoryTheory.Mono (ι_ext r)) ∧
      (∀ r : ℕ,
        CategoryTheory.CategoryStruct.comp (τ_𝒥 r) (ι_ext r) =
          CategoryTheory.CategoryStruct.comp (ι_ext (r + 1))
            (weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℰ r))) ∧
      (∀ (r : ℕ) (W : D₀.Etale),
        Set.range ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom.base ⊆
          (U₀ : Set D₀) →
        Function.Bijective ((ι_ext r).hom.app (Opposite.op W))) :=
by
  classical
  intro D₀
  have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  let lcPrecomp : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {α : Type}
      (φ : X ⟶ Y) (g : LocallyConstant ↥Y α), LocallyConstant ↥X α :=
    fun φ g => ⟨fun x => g (φ.base x),
      fun t => φ.base.hom.continuous.isOpen_preimage _ (g.isLocallyConstant t)⟩
  let lcPostcomp : ∀ {X : Type u} [TopologicalSpace X] {α β : Type}
      (k : α → β) (g : LocallyConstant X α), LocallyConstant X β :=
    fun k g => ⟨fun x => k (g x), fun t => g.isLocallyConstant (k ⁻¹' t)⟩
  have lcPrecomp_apply : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {α : Type}
      (φ : X ⟶ Y) (g : LocallyConstant ↥Y α) (x : ↥X),
      lcPrecomp φ g x = g (φ.base x) := fun _ _ _ => rfl
  have lcPostcomp_apply : ∀ {X : Type u} [TopologicalSpace X] {α β : Type}
      (k : α → β) (g : LocallyConstant X α) (x : X),
      lcPostcomp k g x = k (g x) := fun _ _ _ => rfl
  have hLC_nsmul_apply : ∀ {X : Type u} [TopologicalSpace X] {α : Type} [AddCommMonoid α]
      (k : ℕ) (g : LocallyConstant X α) (x : X),
      (k • g) x = k • (g x) := by
    intro X _ α _ k g x
    induction k with
    | zero =>
      rw [zero_smul, zero_smul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, LocallyConstant.add_apply, ih]
  have hNsmul_sheaf : ∀ {C : Type (u + 1)} [CategoryTheory.LargeCategory C]
      {J : CategoryTheory.GrothendieckTopology C}
      (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (k : ℕ) (X : Cᵒᵖ) (s : ↑(ℱ.obj.obj X)),
      (((k • CategoryTheory.CategoryStruct.id ℱ).hom.app X) s) = k • s := by
    intro C _ J ℱ k X s
    induction k with
    | zero =>
      rw [zero_smul, zero_smul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, ← ih]
      rfl
  let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
  rcases hSh with ⟨a₀, ha₀, B, L_fld,
    hCR, hDom, hFld,
    hAF_B, hAP_B, hAR_B,
    hAF_L, hAP_L, hARF_L,
    hABL, hARL,
    hST_FPB, hST_PRB, hST_FKL, hST_PKL, hST_PBL, hST_RBL,
    hFin_B, hEt_B, hFrac_B, hIntCl_B, hFD_L, hGal_L,
    τ_rep, ι_B, e_U,
    hu₀_eq, heU_eq, hSurjG, hImG, hCompat_B, hQu, hQP,
    triv, hTriv⟩
  let _ : ∀ r, CommRing (B r) := hCR
  have _ : ∀ r, IsDomain (B r) := hDom
  let _ : ∀ r, Field (L_fld r) := hFld
  let _ : ∀ r, Algebra F (B r) := hAF_B
  let _ : ∀ r, Algebra (Polynomial F) (B r) := hAP_B
  let _ : ∀ r, Algebra R₀ (B r) := hAR_B
  let _ : ∀ r, Algebra F (L_fld r) := hAF_L
  let _ : ∀ r, Algebra (Polynomial F) (L_fld r) := hAP_L
  let _ : ∀ r, Algebra (RatFunc F) (L_fld r) := hARF_L
  let _ : ∀ r, Algebra (B r) (L_fld r) := hABL
  let _ : ∀ r, Algebra R₀ (L_fld r) := hARL
  have _ : ∀ r, IsScalarTower F (Polynomial F) (B r) := hST_FPB
  have _ : ∀ r, IsScalarTower (Polynomial F) R₀ (B r) := hST_PRB
  have _ : ∀ r, IsScalarTower F (RatFunc F) (L_fld r) := hST_FKL
  have _ : ∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r) := hST_PKL
  have _ : ∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r) := hST_PBL
  have _ : ∀ r, IsScalarTower R₀ (B r) (L_fld r) := hST_RBL
  have _ : ∀ r, Module.Finite R₀ (B r) := hFin_B
  have _ : ∀ r, Algebra.Etale R₀ (B r) := hEt_B
  have _ : ∀ r, IsFractionRing (B r) (L_fld r) := hFrac_B
  have _ : ∀ r, IsIntegralClosure (B r) R₀ (L_fld r) := hIntCl_B
  have _ : ∀ r, FiniteDimensional (RatFunc F) (L_fld r) := hFD_L
  have _ : ∀ r, IsGalois (RatFunc F) (L_fld r) := hGal_L
  obtain ⟨hAlgIdemp, hR₀Pkg, hRelPkg⟩ := weil_etale_galois_domain_idempotents_and_aut_lift.{u}
  obtain ⟨hDom_R₀, instAlg_R₀K, hFrac_R₀K, hST_R₀KL_gen⟩ := hR₀Pkg F S_aff
  have _ : IsDomain R₀ := hDom_R₀
  let _ : Algebra R₀ (RatFunc F) := instAlg_R₀K
  have _ : IsFractionRing R₀ (RatFunc F) := hFrac_R₀K
  have _ : ∀ r, IsScalarTower R₀ (RatFunc F) (L_fld r) := fun r => hST_R₀KL_gen (B r) (L_fld r)
  let V_r : ℕ → AlgebraicGeometry.Scheme.{u} :=
    fun r => AlgebraicGeometry.Spec (CommRingCat.of (B r))
  let π_r : ∀ r : ℕ, V_r r ⟶ U₀.toScheme :=
    fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r))) ≫ e_U.hom
  let ι_r : ∀ r : ℕ, V_r r ⟶ D₀ := fun r => π_r r ≫ U₀.ι
  let p_ι : ∀ r : ℕ, V_r (r + 1) ⟶ V_r r :=
    fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_B r).toRingHom)
  have hp_ι_π : ∀ r : ℕ, p_ι r ≫ π_r r = π_r (r + 1) := by
    intro r
    dsimp only [p_ι, π_r]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomm : CommRingCat.ofHom (algebraMap R₀ (B r)) ≫
        CommRingCat.ofHom (ι_B r).toRingHom =
        CommRingCat.ofHom (algebraMap R₀ (B (r + 1))) :=
      CommRingCat.hom_ext (RingHom.ext fun x => (ι_B r).commutes x)
    rw [hcomm]
  have hp_ι_ι : ∀ r : ℕ, p_ι r ≫ ι_r r = ι_r (r + 1) := by
    intro r
    dsimp only [ι_r]
    rw [← CategoryTheory.Category.assoc, hp_ι_π r]
  have hTorsPkg : ∀ r : ℕ,
      (AlgebraicGeometry.Etale (π_r r) ∧ AlgebraicGeometry.Surjective (π_r r)) ∧
      (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V_r r),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π_r r) (π_r r)
        ∃ δ : (B r ≃ₐ[R₀] B r) → (Y ⟶ Y_V),
          (∀ σ : B r ≃ₐ[R₀] B r,
            δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r r) (π_r r) = 𝟙 Y ∧
            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r r) (π_r r) =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ σ) ∧
            IsOpen (Set.range (δ σ).base)) ∧
          (∀ σ₁ σ₂ : B r ≃ₐ[R₀] B r, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
          (⋃ σ : B r ≃ₐ[R₀] B r, Set.range (δ σ).base) = Set.univ ∧
          (∀ (σ τ : B r ≃ₐ[R₀] B r) (m_τ : Y_V ⟶ Y_V),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r r) (π_r r) =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r r) (π_r r) →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r r) (π_r r) =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r r) (π_r r) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
            δ σ ≫ m_τ = δ (τ * σ))) := by
    intro r
    obtain ⟨hInj_r, m_r, equiv_r, e_r, hIdemp_r, hOrth_r, hSum_r, hEval_r, hAbsorb_r⟩ :=
      hAlgIdemp R₀ (B r) (RatFunc F) (L_fld r)
    obtain ⟨hEtSurj_r, _, hSheets_r⟩ :=
      weil_scheme_galois_torsor_clopen_sheets.{u} R₀ (B r) hInj_r m_r equiv_r e_r
        hIdemp_r hOrth_r hSum_r hEval_r hAbsorb_r U₀.toScheme e_U
    exact ⟨hEtSurj_r, hSheets_r⟩
  have hπ_et : ∀ r : ℕ, AlgebraicGeometry.Etale (π_r r) := fun r => (hTorsPkg r).1.1
  have hπ_surj : ∀ r : ℕ, AlgebraicGeometry.Surjective (π_r r) := fun r => (hTorsPkg r).1.2
  have hSheets := fun r : ℕ => (hTorsPkg r).2
  have hι_et : ∀ r : ℕ, AlgebraicGeometry.Etale (ι_r r) := by
    intro r
    have _ : AlgebraicGeometry.Etale (π_r r) := hπ_et r
    dsimp only [ι_r]
    infer_instance
  have hp_ι_surj : ∀ r : ℕ, AlgebraicGeometry.Surjective (p_ι r) := by
    intro r
    obtain ⟨_, hRelAlg⟩ :=
      hRelPkg R₀ (RatFunc F) (B r) (L_fld r) (B (r + 1)) (L_fld (r + 1)) (ι_B r)
        (hCompat_B r).1
    let _ : Algebra (B r) (B (r + 1)) := (ι_B r).toRingHom.toAlgebra
    let _ : Algebra (B r) (L_fld (r + 1)) :=
      ((algebraMap (B (r + 1)) (L_fld (r + 1))).comp (ι_B r).toRingHom).toAlgebra
    obtain ⟨hST_BB, hFin_BB, hEt_BB, hIntCl_BB, instL_rel, hST_BLL, hFD_LL, hGal_LL⟩ := hRelAlg
    have _ : IsScalarTower (B r) (B (r + 1)) (L_fld (r + 1)) := hST_BB
    have _ : Module.Finite (B r) (B (r + 1)) := hFin_BB
    have _ : Algebra.Etale (B r) (B (r + 1)) := hEt_BB
    have _ : IsIntegralClosure (B (r + 1)) (B r) (L_fld (r + 1)) := hIntCl_BB
    let _ : Algebra (L_fld r) (L_fld (r + 1)) := instL_rel
    have _ : IsScalarTower (B r) (L_fld r) (L_fld (r + 1)) := hST_BLL
    have _ : FiniteDimensional (L_fld r) (L_fld (r + 1)) := hFD_LL
    have _ : IsGalois (L_fld r) (L_fld (r + 1)) := hGal_LL
    obtain ⟨hInj_rel, m_rel, equiv_rel, e_rel_idemp, hIdemp_rel, hOrth_rel, hSum_rel,
        hEval_rel, hAbsorb_rel⟩ :=
      hAlgIdemp (B r) (B (r + 1)) (L_fld r) (L_fld (r + 1))
    obtain ⟨⟨_, hSurj_rel⟩, _, _⟩ :=
