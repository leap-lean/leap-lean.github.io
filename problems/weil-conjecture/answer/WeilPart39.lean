        · intro t' ht'
          apply AddCommGrpCat.ext; intro m; apply LocallyConstant.ext; intro w
          have h1 := congrArg (fun u : M ⟶ ℒ_pre.obj (Opposite.op (Y_w w)) => (u.hom m) (y_w w))
