  have hh_fib_fst : h_fib ≫ X₀_ι = pr_Zpt ≫ ι_Zpt := hPb_open.lift_fst _ _ _
  have hh_fib_snd : h_fib ≫ g₀ = π_fib ≫ y_pt := hPb_open.lift_snd _ _ _
  have hPb_outer : CategoryTheory.IsPullback (h_fib ≫ X₀_ι) π_fib f₀.left (y_pt ≫ U₀.ι) := by
