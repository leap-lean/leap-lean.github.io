  have hf_bar_snd : f_bar.left ≫ D_bar.hom = Z_bar.hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_Z_k' : CategoryTheory.IsPullback pr_Z (f_bar.left ≫ D_bar.hom)
