      (CategoryTheory.Category.assoc v e₁_hom u).trans
        ((congrArg (v ≫ ·) hEq_inv).trans hRight_v)
    exact ⟨⟨v ≫ e₁_hom, h₁, h₂⟩⟩

  let e_Bg : CategoryTheory.Iso (CategoryTheory.Functor.comp B_g_std (B_of e_X.hom)) B_g' :=
    compCongrIso e_X.hom g_std g' he_g

  let δ_g' : CategoryTheory.Iso (CategoryTheory.Functor.comp P_pos pf_g_std) pf_g' :=
    CategoryTheory.Functor.sheafPushforwardContinuousComp' e_Bg AddCommGrpCat.{u}
      Y_bar.smallEtaleTopology X_std.smallEtaleTopology X'.smallEtaleTopology

  have hbc₀_eq : bc₀ = bc₀_std ≫ (pf_g_std.map u ≫ δ_g'.hom.app G') := by
    let δ_pX := δ_p pr_X' pr_X e_X.hom he_pr
    have hTail : e_pf2.hom.app G' ≫ e_pf1.inv.app G' =
        pf_g₀.map (δ_pX.inv.app G') ≫
          (e_pf2_std.hom.app (P_pos.obj G') ≫
            (e_pf1_std.inv.app (P_pos.obj G') ≫
