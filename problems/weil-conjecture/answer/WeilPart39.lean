      hAff_Bk B_k e_Bk s_Bk hs_Bk
    let _ : CommRing E₀ := hCR_E₀
    have hε₀_base : ε₀.comp (α₀.comp (algebraMap P R₀)) = Polynomial.evalRingHom 0 := by
      rw [← RingHom.comp_assoc, hε₀_α, heval₀_comp]
    obtain ⟨g, hε₀_g, hDom_E, hKer_E⟩ := hShrink E₀ α₀ ε₀ hα₀_et hε₀_base
    let E := Localization.Away g
    have _ : IsDomain E := hDom_E
    have hg_unit : IsUnit (ε₀ g) := isUnit_iff_ne_zero.mpr hε₀_g
    let ε_E : E →+* k := IsLocalization.Away.lift g hg_unit
    have hεE_comp : ε_E.comp (algebraMap E₀ E) = ε₀ :=
      RingHom.ext fun e => IsLocalization.Away.lift_eq (S := E) g hg_unit e
