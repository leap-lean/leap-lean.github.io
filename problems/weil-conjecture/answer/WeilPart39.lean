            s₁ = s₂ := by
        intro Y I X_cov f_cov hcov s₁ s₂ heq
        let mkZ : ↑(C_V'.obj.obj (Opposite.op Y)) → (E_ℤ ⟶ C_V'.obj.obj (Opposite.op Y)) := fun s =>
          AddCommGrpCat.ofHom
            { toFun := fun n => n.down • s
              map_zero' := zero_zsmul s
              map_add' := fun n₁ n₂ => add_zsmul s n₁.down n₂.down }
        have hhom : mkZ s₁ = mkZ s₂ := by
          refine C_V'.property.hom_ext_ofArrows f_cov hcov fun i => ?_
          apply AddCommGrpCat.ext; intro n
          change (C_V'.obj.map (f_cov i).op).hom (n.down • s₁) =
            (C_V'.obj.map (f_cov i).op).hom (n.down • s₂)
          rw [map_zsmul, map_zsmul, heq i]
        simpa [mkZ, one_zsmul] using congrArg (fun u : E_ℤ ⟶ _ => u.hom (ULift.up 1)) hhom
      have hψ_zero : ∀ Y : V.Etale, ψ_elem Y 0 = 0 := by
        intro Y
        let U_a : ↥A → Y.left.Opens := fun a => ⟨(0 : LocallyConstant ↥Y.left ↥A) ⁻¹' {a},
