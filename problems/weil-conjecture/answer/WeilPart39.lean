    have hΞ_nat : (Ξ₁.hom.hom.app (Opposite.op Y₁)).hom
          ((𝒢₀.obj.map (Opposite.op (j_π₁.map f))).hom
            ((𝒢₀.obj.map (Opposite.op (ι_inv Y₂))).hom s)) =
        (C₁.obj.map (Opposite.op f)).hom
          ((Ξ₁.hom.hom.app (Opposite.op Y₂)).hom
            ((𝒢₀.obj.map (Opposite.op (ι_inv Y₂))).hom s)) :=
      congrArg (fun φ => φ.hom ((𝒢₀.obj.map (Opposite.op (ι_inv Y₂))).hom s))
        (Ξ₁.hom.hom.naturality (Opposite.op f))
    have hR : e_θ₁ Y₁ ((Ψ₁ Y₂ s).comap f.left.base.hom) =
        (C₁.obj.map (Opposite.op f)).hom
          ((Ξ₁.hom.hom.app (Opposite.op Y₂)).hom
            ((𝒢₀.obj.map (Opposite.op (ι_inv Y₂))).hom s)) :=
      (hθ₁_nat f (Ψ₁ Y₂ s)).symm.trans
        (congrArg (C₁.obj.map (Opposite.op f)).hom ((e_θ₁ Y₂).apply_symm_apply _))
    exact hL1.trans ((congrArg (Ξ₁.hom.hom.app (Opposite.op Y₁)).hom hL2).trans
      (hΞ_nat.trans hR.symm))

  let T₀ : V₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V₀)
  let T₁ : V₁.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V₁)
  let E'₁ : V₀.Etale := j_q.obj T₁
  let e_Ψ₁_T₁ : ↑(ℋ₀.obj.obj (Opposite.op E'₁)) ≃+ LocallyConstant ↥V₁ ↥A_η :=
    AddEquiv.ofBijective (Ψ₁ T₁) (hΨ₁_bij T₁)
  let α₁ : A_η ⟶ ℋ₀.obj.obj (Opposite.op E'₁) :=
    AddCommGrpCat.ofHom
      (e_Ψ₁_T₁.symm.toAddMonoidHom.comp (LocallyConstant.constAddMonoidHom (X := ↥V₁) (Y := ↥A_η)))

  let d_mor : (S₁ ≃ₐ[S₀] S₁) → (V₁ ⟶ V₁) :=
    fun τ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom)
  have hd_q : ∀ τ : S₁ ≃ₐ[S₀] S₁, d_mor τ ≫ q = q := fun τ =>
    (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
      (congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext (RingHom.ext τ.symm.commutes)))

  have hDeck_ℋ₀ : ∀ (τ : S₁ ≃ₐ[S₀] S₁) (w_τ : E'₁ ⟶ E'₁),
      w_τ.left = d_mor τ →
      ∀ s : ↑(ℋ₀.obj.obj (Opposite.op E'₁)),
        (ℋ₀.obj.map (Opposite.op w_τ)).hom s = s := by
    intro τ w_τ hw_τ s
    have : AlgebraicGeometry.Etale π₁ := hπ₁_et
    let E₁ : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk π₁
    have hE'₁_hom : (𝟙 V₁ ≫ q) ≫ π₀ = π₁ :=
      (congrArg (· ≫ π₀) (CategoryTheory.Category.id_comp q)).trans hq_π₀
    let κ_hom : j_π₀.obj E'₁ ⟶ E₁ :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 V₁)
        ((CategoryTheory.Category.id_comp π₁).trans hE'₁_hom.symm) trivial
    let κ_inv : E₁ ⟶ j_π₀.obj E'₁ :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 V₁)
        ((CategoryTheory.Category.id_comp _).trans hE'₁_hom) trivial
    have hd_π₁ : d_mor τ ≫ π₁ = π₁ :=
      (congrArg (d_mor τ ≫ ·) hq_π₀.symm).trans
        ((CategoryTheory.Category.assoc (d_mor τ) q π₀).symm.trans
          ((congrArg (· ≫ π₀) (hd_q τ)).trans hq_π₀))
    let u_τ : E₁ ⟶ E₁ :=
      CategoryTheory.MorphismProperty.Over.homMk (d_mor τ) hd_π₁ trivial
    have hκ_comm : κ_hom ≫ u_τ = j_π₀.map w_τ ≫ κ_hom :=
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.id_comp (d_mor τ)).trans
          ((CategoryTheory.Category.comp_id w_τ.left).trans hw_τ).symm)
    have hκ_id : κ_hom ≫ κ_inv = 𝟙 _ :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
    let s₁ : ↑(𝒢₀.obj.obj (Opposite.op E₁)) := (𝒢₀.obj.map (Opposite.op κ_inv)).hom s
    have hs_eq : (𝒢₀.obj.map (Opposite.op κ_hom)).hom s₁ = s :=
      congrArg (fun φ => φ.hom s)
        ((𝒢₀.obj.map_comp (Opposite.op κ_inv) (Opposite.op κ_hom)).symm.trans
          ((congrArg (fun m => 𝒢₀.obj.map (Opposite.op m)) hκ_id).trans (𝒢₀.obj.map_id _)))
    have hmap_comm : 𝒢₀.obj.map (Opposite.op u_τ) ≫ 𝒢₀.obj.map (Opposite.op κ_hom) =
        𝒢₀.obj.map (Opposite.op κ_hom) ≫ 𝒢₀.obj.map (Opposite.op (j_π₀.map w_τ)) :=
      (𝒢₀.obj.map_comp _ _).symm.trans
        ((congrArg (fun m => 𝒢₀.obj.map (Opposite.op m)) hκ_comm).trans
          (𝒢₀.obj.map_comp _ _))
    have h1 : (𝒢₀.obj.map (Opposite.op (j_π₀.map w_τ))).hom
          ((𝒢₀.obj.map (Opposite.op κ_hom)).hom s₁) =
        (𝒢₀.obj.map (Opposite.op κ_hom)).hom ((𝒢₀.obj.map (Opposite.op u_τ)).hom s₁) :=
      (congrArg (fun φ => φ.hom s₁) hmap_comm).symm
    exact (congrArg (ℋ₀.obj.map (Opposite.op w_τ)).hom hs_eq.symm).trans
      (h1.trans ((congrArg (𝒢₀.obj.map (Opposite.op κ_hom)).hom (hDeckTriv τ u_τ rfl s₁)).trans
        hs_eq))

  let q_mor : E'₁ ⟶ T₀ :=
    CategoryTheory.MorphismProperty.Over.homMk q
      ((CategoryTheory.Category.comp_id q).trans (CategoryTheory.Category.id_comp q).symm) trivial
  let X_cov : Unit → V₀.Etale := fun _ => E'₁
  let f_cov : ∀ i : Unit, X_cov i ⟶ T₀ := fun _ => q_mor
  have hCov_T₀ : CategoryTheory.Sieve.ofArrows X_cov f_cov ∈ V₀.smallEtaleTopology T₀ := by
    apply (hMem V₀ T₀ _).mpr
    intro x
    have : AlgebraicGeometry.Surjective q := hq_surj
    obtain ⟨y, hy⟩ := q.surjective x
    exact ⟨E'₁, q_mor, y, CategoryTheory.Sieve.ofArrows_mk X_cov f_cov (), hq_et, hy⟩
  let x_fam : ∀ i : Unit, A_η ⟶ ℋ₀.obj.obj (Opposite.op (X_cov i)) := fun _ => α₁
  have hCompat_T₀ : ∀ ⦃W' : V₀.Etale⦄ ⦃i₁ i₂ : Unit⦄ (b₁ : W' ⟶ X_cov i₁) (b₂ : W' ⟶ X_cov i₂),
      b₁ ≫ f_cov i₁ = b₂ ≫ f_cov i₂ →
      x_fam i₁ ≫ ℋ₀.obj.map b₁.op = x_fam i₂ ≫ ℋ₀.obj.map b₂.op := by
    intro W' i₁ i₂ b₁ b₂ hbq_et
    have hbq : b₁.left ≫ q = b₂.left ≫ q := congrArg (fun m => m.left) hbq_et
    obtain ⟨δ, hδ_props, hδ_univ⟩ := hSheets W'.left b₁.left
    let z_lift : W'.left ⟶ CategoryTheory.Limits.pullback (b₁.left ≫ q) q :=
      CategoryTheory.Limits.pullback.lift (𝟙 W'.left) b₂.left
        ((CategoryTheory.Category.id_comp (b₁.left ≫ q)).trans hbq)
    let P_τ : (S₁ ≃ₐ[S₀] S₁) → AlgebraicGeometry.Scheme.{u} :=
      fun τ => CategoryTheory.Limits.pullback z_lift (δ τ)
    let p1_τ : ∀ τ, P_τ τ ⟶ W'.left := fun τ => CategoryTheory.Limits.pullback.fst z_lift (δ τ)
    let p2_τ : ∀ τ, P_τ τ ⟶ W'.left := fun τ => CategoryTheory.Limits.pullback.snd z_lift (δ τ)
    have hp1_et : ∀ τ, P_Et (p1_τ τ) := fun τ =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback z_lift (δ τ)).flip (hδ_props τ).2.2
    have hp1_eq_p2 : ∀ τ, p1_τ τ = p2_τ τ := by
      intro τ
      have hcond := congrArg
        (· ≫ CategoryTheory.Limits.pullback.fst (b₁.left ≫ q) q)
        (CategoryTheory.Limits.pullback.condition (f := z_lift) (g := δ τ))
      have hL : (p1_τ τ ≫ z_lift) ≫ CategoryTheory.Limits.pullback.fst (b₁.left ≫ q) q = p1_τ τ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (p1_τ τ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            (CategoryTheory.Category.comp_id _))
      have hR : (p2_τ τ ≫ δ τ) ≫ CategoryTheory.Limits.pullback.fst (b₁.left ≫ q) q = p2_τ τ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (p2_τ τ ≫ ·) (hδ_props τ).1).trans
            (CategoryTheory.Category.comp_id _))
      exact hL.symm.trans (hcond.trans hR)
    have hp1_deck : ∀ τ, p1_τ τ ≫ b₂.left = p1_τ τ ≫ (b₁.left ≫ d_mor τ) := by
      intro τ
      have hcond := congrArg
        (· ≫ CategoryTheory.Limits.pullback.snd (b₁.left ≫ q) q)
        (CategoryTheory.Limits.pullback.condition (f := z_lift) (g := δ τ))
      have hL : (p1_τ τ ≫ z_lift) ≫ CategoryTheory.Limits.pullback.snd (b₁.left ≫ q) q =
          p1_τ τ ≫ b₂.left :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (p1_τ τ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      have hR : (p2_τ τ ≫ δ τ) ≫ CategoryTheory.Limits.pullback.snd (b₁.left ≫ q) q =
          p1_τ τ ≫ (b₁.left ≫ d_mor τ) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (p2_τ τ ≫ ·) (hδ_props τ).2.1).trans
            (congrArg (· ≫ (b₁.left ≫ d_mor τ)) (hp1_eq_p2 τ).symm))
      exact hL.symm.trans (hcond.trans hR)
    let Z_τ : (S₁ ≃ₐ[S₀] S₁) → V₀.Etale := fun τ =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ (p1_τ τ ≫ W'.hom)
        (CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem _ _ (hp1_et τ) W'.prop)
    let g_τ : ∀ τ, Z_τ τ ⟶ W' :=
      fun τ => CategoryTheory.MorphismProperty.Over.homMk (p1_τ τ) rfl trivial
    let w_τ : ∀ τ, E'₁ ⟶ E'₁ := fun τ =>
      CategoryTheory.MorphismProperty.Over.homMk (d_mor τ)
        ((congrArg (d_mor τ ≫ ·) (CategoryTheory.Category.id_comp q)).trans
          ((hd_q τ).trans (CategoryTheory.Category.id_comp q).symm))
        trivial
    have hgb_eq : ∀ τ, g_τ τ ≫ b₂ = (g_τ τ ≫ b₁) ≫ w_τ τ := fun τ =>
      CategoryTheory.MorphismProperty.Over.Hom.ext
        ((hp1_deck τ).trans (CategoryTheory.Category.assoc _ _ _).symm)
    have hCov_W' : CategoryTheory.Sieve.ofArrows Z_τ g_τ ∈ V₀.smallEtaleTopology W' := by
      apply (hMem V₀ W' _).mpr
      intro x
      have hx_univ : z_lift.base x ∈ ⋃ τ : S₁ ≃ₐ[S₀] S₁, Set.range (δ τ).base :=
        hδ_univ.symm ▸ Set.mem_univ _
      obtain ⟨τ, x', hx'⟩ := Set.mem_iUnion.mp hx_univ
      obtain ⟨p, hp_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x x' hx'.symm
      exact ⟨Z_τ τ, g_τ τ, p, CategoryTheory.Sieve.ofArrows_mk Z_τ g_τ τ, hp1_et τ, hp_fst⟩
    apply ℋ₀.property.hom_ext_ofArrows g_τ hCov_W'
    intro τ
    apply AddCommGrpCat.ext
    intro a
    have h_inv_a : (ℋ₀.obj.map (Opposite.op (w_τ τ))).hom (α₁.hom a) = α₁.hom a :=
      hDeck_ℋ₀ τ (w_τ τ) rfl (α₁.hom a)
    have h1 : ℋ₀.obj.map (Opposite.op b₂) ≫ ℋ₀.obj.map (Opposite.op (g_τ τ)) =
        ℋ₀.obj.map (Opposite.op (w_τ τ)) ≫
          (ℋ₀.obj.map (Opposite.op b₁) ≫ ℋ₀.obj.map (Opposite.op (g_τ τ))) :=
      (ℋ₀.obj.map_comp _ _).symm.trans
        ((congrArg (fun m => ℋ₀.obj.map (Opposite.op m)) (hgb_eq τ)).trans
          ((ℋ₀.obj.map_comp _ _).trans
            (congrArg (ℋ₀.obj.map (Opposite.op (w_τ τ)) ≫ ·) (ℋ₀.obj.map_comp _ _))))
    exact ((congrArg (fun φ => φ.hom (α₁.hom a)) h1).trans
      (congrArg (fun t => (ℋ₀.obj.map (Opposite.op (g_τ τ))).hom
        ((ℋ₀.obj.map (Opposite.op b₁)).hom t)) h_inv_a)).symm

  let α₀ : A_η ⟶ ℋ₀.obj.obj (Opposite.op T₀) :=
    ℋ₀.property.amalgamateOfArrows f_cov hCov_T₀ x_fam hCompat_T₀
  have hα₀_q : α₀ ≫ ℋ₀.obj.map (Opposite.op q_mor) = α₁ :=
    ℋ₀.property.amalgamateOfArrows_map f_cov hCov_T₀ x_fam hCompat_T₀ ()
  have hα₀_const : ∀ a : ↥A_η,
      Ψ₁ T₁ ((ℋ₀.obj.map (Opposite.op q_mor)).hom (α₀.hom a)) = LocallyConstant.const _ a := by
    intro a
    have h1 : (ℋ₀.obj.map (Opposite.op q_mor)).hom (α₀.hom a) = α₁.hom a :=
      congrArg (fun φ => φ.hom a) hα₀_q
    exact (congrArg (Ψ₁ T₁) h1).trans (e_Ψ₁_T₁.apply_symm_apply (LocallyConstant.const ↥V₁ a))

  
  let adj₀ := CategoryTheory.constantSheafAdj V₀.smallEtaleTopology AddCommGrpCat.{u} hT₀
  let Φ₀ : C₀ ⟶ ℋ₀ := (adj₀.homEquiv A_η ℋ₀).symm α₀
  have hΦ₀_unit : adj₀.unit.app A_η ≫ Φ₀.hom.app (Opposite.op T₀) = α₀ :=
    (adj₀.homEquiv_unit A_η ℋ₀ Φ₀).symm.trans ((adj₀.homEquiv A_η ℋ₀).apply_symm_apply α₀)
  have hΦ₀_T₀ : ∀ a : ↥A_η,
      (Φ₀.hom.app (Opposite.op T₀)).hom (θ₀ T₀ (LocallyConstant.const _ a)) = α₀.hom a :=
    fun a => (congrArg (Φ₀.hom.app (Opposite.op T₀)).hom (hθ₀_unit a)).trans
      (congrArg (fun φ => φ.hom a) hΦ₀_unit)
  have hΦ₀_nat : ∀ {W₁ W₂ : V₀.Etale} (u : W₁ ⟶ W₂) (s : ↥(C₀.obj.obj (Opposite.op W₂))),
      (Φ₀.hom.app (Opposite.op W₁)).hom ((C₀.obj.map (Opposite.op u)).hom s) =
        (ℋ₀.obj.map (Opposite.op u)).hom ((Φ₀.hom.app (Opposite.op W₂)).hom s) :=
    fun u s => congrArg (fun φ : C₀.obj.obj _ ⟶ ℋ₀.obj.obj _ => φ.hom s)
      (Φ₀.hom.naturality (Opposite.op u))

  let F_op : ∀ Y : V₁.Etale, LocallyConstant ↥Y.left ↥A_η → LocallyConstant ↥Y.left ↥A_η :=
    fun Y g => Ψ₁ Y ((Φ₀.hom.app (Opposite.op (j_q.obj Y))).hom (θ₀ (j_q.obj Y) g))

  have hF_nat : ∀ {Y₁ Y₂ : V₁.Etale} (f : Y₁ ⟶ Y₂) (g : LocallyConstant ↥Y₂.left ↥A_η),
      F_op Y₁ (g.comap f.left.base.hom) = (F_op Y₂ g).comap f.left.base.hom := by
    intro Y₁ Y₂ f g
    have h1 : θ₀ (j_q.obj Y₁) (g.comap f.left.base.hom) =
        (C₀.obj.map (Opposite.op (j_q.map f))).hom (θ₀ (j_q.obj Y₂) g) :=
      (hθ₀_nat (j_q.map f) g).symm
    have h2 : (Φ₀.hom.app (Opposite.op (j_q.obj Y₁))).hom
          ((C₀.obj.map (Opposite.op (j_q.map f))).hom (θ₀ (j_q.obj Y₂) g)) =
        (ℋ₀.obj.map (Opposite.op (j_q.map f))).hom
          ((Φ₀.hom.app (Opposite.op (j_q.obj Y₂))).hom (θ₀ (j_q.obj Y₂) g)) :=
      hΦ₀_nat (j_q.map f) (θ₀ (j_q.obj Y₂) g)
    exact (congrArg (fun t => Ψ₁ Y₁ ((Φ₀.hom.app (Opposite.op (j_q.obj Y₁))).hom t)) h1).trans
      ((congrArg (Ψ₁ Y₁) h2).trans (hΨ₁_nat f _))

  have hF_T₁_const : ∀ a : ↥A_η,
      F_op T₁ (LocallyConstant.const _ a) = LocallyConstant.const _ a := by
    intro a
    have hcomap : (LocallyConstant.const ↥T₀.left a).comap q_mor.left.base.hom =
        LocallyConstant.const ↥T₁.left a :=
      LocallyConstant.ext fun _ => rfl
    have h1 : θ₀ E'₁ (LocallyConstant.const ↥T₁.left a) =
        (C₀.obj.map (Opposite.op q_mor)).hom (θ₀ T₀ (LocallyConstant.const ↥T₀.left a)) :=
      (congrArg (θ₀ E'₁) hcomap.symm).trans (hθ₀_nat q_mor (LocallyConstant.const ↥T₀.left a)).symm
    have h2 : (Φ₀.hom.app (Opposite.op E'₁)).hom
          ((C₀.obj.map (Opposite.op q_mor)).hom (θ₀ T₀ (LocallyConstant.const ↥T₀.left a))) =
        (ℋ₀.obj.map (Opposite.op q_mor)).hom
          ((Φ₀.hom.app (Opposite.op T₀)).hom (θ₀ T₀ (LocallyConstant.const ↥T₀.left a))) :=
      hΦ₀_nat q_mor (θ₀ T₀ (LocallyConstant.const ↥T₀.left a))
    exact (congrArg (fun t => Ψ₁ T₁ ((Φ₀.hom.app (Opposite.op E'₁)).hom t)) h1).trans
      ((congrArg (Ψ₁ T₁) (h2.trans (congrArg (ℋ₀.obj.map (Opposite.op q_mor)).hom (hΦ₀_T₀ a)))).trans
        (hα₀_const a))

  have hF_const : ∀ (Y : V₁.Etale) (a : ↥A_η),
      F_op Y (LocallyConstant.const _ a) = LocallyConstant.const _ a := by
    intro Y a
    let p_Y : Y ⟶ T₁ :=
      CategoryTheory.MorphismProperty.Over.homMk Y.hom (CategoryTheory.Category.comp_id Y.hom)
        trivial
    have hcomap : (LocallyConstant.const ↥T₁.left a).comap p_Y.left.base.hom =
        LocallyConstant.const ↥Y.left a :=
      LocallyConstant.ext fun _ => rfl
    exact (congrArg (F_op Y) hcomap.symm).trans
      ((hF_nat p_Y (LocallyConstant.const ↥T₁.left a)).trans
        ((congrArg (fun h => h.comap p_Y.left.base.hom) (hF_T₁_const a)).trans hcomap))

  have hF_id : ∀ (Y : V₁.Etale) (g : LocallyConstant ↥Y.left ↥A_η), F_op Y g = g := by
    intro Y g
    apply LocallyConstant.ext
    intro y
    let a : ↥A_η := g y
    let U_y : Y.left.Opens := ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
    have hYU_et : P_Et (U_y.ι ≫ Y.hom) :=
      CategoryTheory.MorphismProperty.IsStableUnderComposition.comp_mem _ _ inferInstance Y.prop
    let Y_U : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (U_y.ι ≫ Y.hom) hYU_et
    let i_U : Y_U ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk U_y.ι rfl trivial
    have hg_U : g.comap i_U.left.base.hom = LocallyConstant.const ↥Y_U.left a :=
      LocallyConstant.ext fun z => z.2
    have hFU : (F_op Y g).comap i_U.left.base.hom = LocallyConstant.const ↥Y_U.left a :=
      (hF_nat i_U g).symm.trans ((congrArg (F_op Y_U) hg_U).trans (hF_const Y_U a))
    exact congrArg (fun h : LocallyConstant ↥Y_U.left ↥A_η => h ⟨y, rfl⟩) hFU

  have hΦ₀_jq_bij : ∀ Y : V₁.Etale,
      Function.Bijective ((Φ₀.hom.app (Opposite.op (j_q.obj Y))).hom) := by
    intro Y
    refine ⟨?_, ?_⟩
    · intro s₁ s₂ hs
      obtain ⟨g₁, rfl⟩ := (hθ₀_bij (j_q.obj Y)).2 s₁
      obtain ⟨g₂, rfl⟩ := (hθ₀_bij (j_q.obj Y)).2 s₂
      have hfg : F_op Y g₁ = F_op Y g₂ := congrArg (Ψ₁ Y) hs
      exact congrArg (θ₀ (j_q.obj Y)) ((hF_id Y g₁).symm.trans (hfg.trans (hF_id Y g₂)))
    · intro t
      refine ⟨θ₀ (j_q.obj Y) (Ψ₁ Y t), ?_⟩
      exact (hΨ₁_bij Y).1 (hF_id Y (Ψ₁ Y t))

  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let zHom : ∀ {M : AddCommGrpCat.{u}} (m : ↥M), Aℤ ⟶ M :=
    fun {M} m => AddCommGrpCat.ofHom
      { toFun := fun n => n.down • m
        map_zero' := zero_zsmul m
        map_add' := fun x y => add_zsmul m x.down y.down }
  have hzHom_comp : ∀ {M N : AddCommGrpCat.{u}} (m : ↥M) (φ : M ⟶ N),
      zHom m ≫ φ = zHom (φ.hom m) :=
    fun m φ => AddCommGrpCat.ext fun n => map_zsmul φ.hom n.down m

  have hCovPull : ∀ W : V₀.Etale,
      ∃ (Y_W : V₁.Etale) (p_W : j_q.obj Y_W ⟶ W),
        CategoryTheory.Sieve.ofArrows (fun _ : Unit => j_q.obj Y_W) (fun _ => p_W) ∈
          V₀.smallEtaleTopology W := by
    intro W
    let p₁ := CategoryTheory.Limits.pullback.fst W.hom q
    let p₂ := CategoryTheory.Limits.pullback.snd W.hom q
    have hpb := CategoryTheory.IsPullback.of_hasPullback W.hom q
    have hp₂_et : P_Et p₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb W.prop
    have hp₁_et : P_Et p₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hq_et
    let Y_W : V₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ p₂ hp₂_et
    let p_W : j_q.obj Y_W ⟶ W :=
      CategoryTheory.MorphismProperty.Over.homMk p₁
        CategoryTheory.Limits.pullback.condition trivial
    refine ⟨Y_W, p_W, (hMem V₀ W _).mpr ?_⟩
    intro x
    have : AlgebraicGeometry.Surjective q := hq_surj
    obtain ⟨v₁, hv₁⟩ := q.surjective (W.hom.base x)
    obtain ⟨w₁, hw₁, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x v₁ hv₁.symm
    exact ⟨j_q.obj Y_W, p_W, w₁, CategoryTheory.Sieve.ofArrows_mk _ _ (), hp₁_et, hw₁⟩

  have hΦ₀_inj : ∀ W : V₀.Etale, Function.Injective ((Φ₀.hom.app (Opposite.op W)).hom) := by
    intro W s₁ s₂ hs
    obtain ⟨Y_W, p_W, hCov_W⟩ := hCovPull W
    have hp_eq : (C₀.obj.map (Opposite.op p_W)).hom s₁ = (C₀.obj.map (Opposite.op p_W)).hom s₂ :=
      (hΦ₀_jq_bij Y_W).1
        ((hΦ₀_nat p_W s₁).trans
          ((congrArg (ℋ₀.obj.map (Opposite.op p_W)).hom hs).trans (hΦ₀_nat p_W s₂).symm))
    have hz_eq : zHom s₁ = zHom s₂ :=
      C₀.property.hom_ext_ofArrows (fun _ : Unit => p_W) hCov_W fun _ =>
        (hzHom_comp s₁ (C₀.obj.map (Opposite.op p_W))).trans
          ((congrArg zHom hp_eq).trans (hzHom_comp s₂ (C₀.obj.map (Opposite.op p_W))).symm)
    exact (one_zsmul s₁).symm.trans
      ((congrArg (fun φ : Aℤ ⟶ _ => φ.hom (ULift.up 1)) hz_eq).trans (one_zsmul s₂))

  have hΦ₀_surj : ∀ W : V₀.Etale, Function.Surjective ((Φ₀.hom.app (Opposite.op W)).hom) := by
    intro W t
    obtain ⟨Y_W, p_W, hCov_W⟩ := hCovPull W
    obtain ⟨s₁, hs₁⟩ := (hΦ₀_jq_bij Y_W).2 ((ℋ₀.obj.map (Opposite.op p_W)).hom t)
    let f_W : ∀ _ : Unit, j_q.obj Y_W ⟶ W := fun _ => p_W
    let s_fam : ∀ _ : Unit, Aℤ ⟶ C₀.obj.obj (Opposite.op (j_q.obj Y_W)) := fun _ => zHom s₁
    have hCompat_W : ∀ ⦃Z : V₀.Etale⦄ ⦃i₁ i₂ : Unit⦄ (c₁ : Z ⟶ j_q.obj Y_W) (c₂ : Z ⟶ j_q.obj Y_W),
        c₁ ≫ f_W i₁ = c₂ ≫ f_W i₂ →
        s_fam i₁ ≫ C₀.obj.map c₁.op = s_fam i₂ ≫ C₀.obj.map c₂.op := by
      intro Z i₁ i₂ c₁ c₂ hc_eq
      have hc₁_φ : (Φ₀.hom.app (Opposite.op Z)).hom ((C₀.obj.map c₁.op).hom s₁) =
          (ℋ₀.obj.map (c₁ ≫ p_W).op).hom t :=
        (hΦ₀_nat c₁ s₁).trans
          ((congrArg (ℋ₀.obj.map c₁.op).hom hs₁).trans
            (congrArg (fun φ => φ.hom t) (ℋ₀.obj.map_comp p_W.op c₁.op).symm))
      have hc₂_φ : (Φ₀.hom.app (Opposite.op Z)).hom ((C₀.obj.map c₂.op).hom s₁) =
          (ℋ₀.obj.map (c₂ ≫ p_W).op).hom t :=
        (hΦ₀_nat c₂ s₁).trans
          ((congrArg (ℋ₀.obj.map c₂.op).hom hs₁).trans
            (congrArg (fun φ => φ.hom t) (ℋ₀.obj.map_comp p_W.op c₂.op).symm))
      have hc_s₁ : (C₀.obj.map c₁.op).hom s₁ = (C₀.obj.map c₂.op).hom s₁ :=
        hΦ₀_inj Z (hc₁_φ.trans
          ((congrArg (fun m => (ℋ₀.obj.map (Opposite.op m)).hom t) hc_eq).trans hc₂_φ.symm))
      exact (hzHom_comp s₁ (C₀.obj.map c₁.op)).trans
        ((congrArg zHom hc_s₁).trans (hzHom_comp s₁ (C₀.obj.map c₂.op)).symm)
    let g_s : Aℤ ⟶ C₀.obj.obj (Opposite.op W) :=
      C₀.property.amalgamateOfArrows f_W hCov_W s_fam hCompat_W
    let s : ↥(C₀.obj.obj (Opposite.op W)) := g_s.hom (ULift.up 1)
    have hgs_map : g_s ≫ C₀.obj.map p_W.op = zHom s₁ :=
      C₀.property.amalgamateOfArrows_map f_W hCov_W s_fam hCompat_W ()
    have hs_res : (C₀.obj.map p_W.op).hom s = s₁ :=
      (congrArg (fun φ : Aℤ ⟶ _ => φ.hom (ULift.up 1)) hgs_map).trans (one_zsmul s₁)
    have hφ_res : (ℋ₀.obj.map p_W.op).hom ((Φ₀.hom.app (Opposite.op W)).hom s) =
        (ℋ₀.obj.map p_W.op).hom t :=
      (hΦ₀_nat p_W s).symm.trans
        ((congrArg (Φ₀.hom.app (Opposite.op (j_q.obj Y_W))).hom hs_res).trans hs₁)
    have hz_t : zHom ((Φ₀.hom.app (Opposite.op W)).hom s) = zHom t :=
      ℋ₀.property.hom_ext_ofArrows f_W hCov_W fun _ =>
        (hzHom_comp ((Φ₀.hom.app (Opposite.op W)).hom s) (ℋ₀.obj.map p_W.op)).trans
          ((congrArg zHom hφ_res).trans (hzHom_comp t (ℋ₀.obj.map p_W.op)).symm)
    exact ⟨s, (one_zsmul _).symm.trans
      ((congrArg (fun φ : Aℤ ⟶ _ => φ.hom (ULift.up 1)) hz_t).trans (one_zsmul t))⟩

  have : ∀ X_op : Opposite V₀.Etale, CategoryTheory.IsIso (Φ₀.hom.app X_op) :=
    fun X_op => (CategoryTheory.ConcreteCategory.isIso_iff_bijective (Φ₀.hom.app X_op)).mpr
      ⟨hΦ₀_inj X_op.unop, hΦ₀_surj X_op.unop⟩
  have : CategoryTheory.IsIso Φ₀.hom := CategoryTheory.NatIso.isIso_of_isIso_app Φ₀.hom
  let iso_C₀_ℋ₀ : C₀ ≅ ℋ₀ :=
    (CategoryTheory.fullyFaithfulSheafToPresheaf V₀.smallEtaleTopology
      AddCommGrpCat.{u}).preimageIso (CategoryTheory.asIso Φ₀.hom)

  exact ⟨hCont₀, hAdj₀, ⟨e_π₀.app 𝒢₀ ≪≫ iso_C₀_ℋ₀.symm⟩⟩

theorem weil_etale_galois_generic_monodromy_kernel_descent (R₀ K : Type u)
    [CommRing R₀] [IsDomain R₀] [Field K] [Algebra R₀ K] [IsFractionRing R₀ K]
    (hSpread : ∀ (L : IntermediateField K (AlgebraicClosure K))
      [FiniteDimensional K ↥L] [IsGalois K ↥L],
      ∃ δ_L : R₀, δ_L ≠ 0 ∧
        ∀ (g : R₀), g ≠ 0 → δ_L ∣ g →
          ∀ (φ_g : Localization.Away g →+* K),
            φ_g.comp (algebraMap R₀ (Localization.Away g)) = algebraMap R₀ K →
            letI : Algebra (Localization.Away g) ↥L :=
              ((algebraMap K ↥L).comp φ_g).toAlgebra
            Module.Finite (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L) ∧
            Algebra.Etale (Localization.Away g) ↥(integralClosure (Localization.Away g) ↥L))
    (𝒢₀ : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of R₀)).smallEtaleTopology AddCommGrpCat.{u})
    (W_η : AlgebraicGeometry.Scheme.{u})
    (w_η : W_η ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀))
    (A_η : AddCommGrpCat.{u})
    (hw_et : AlgebraicGeometry.Etale w_η)
    (hW_ne : Nonempty ↥W_η)
    (hFin_A : Finite ↥A_η)
    (hPull_η : WeilIsEtaleSheafPullback w_η 𝒢₀
      ((CategoryTheory.constantSheaf W_η.smallEtaleTopology AddCommGrpCat.{u}).obj A_η)) :
    ∃ (g₀ : R₀) (_ : g₀ ≠ 0)
      (E₀ : IntermediateField K (AlgebraicClosure K))
      (_ : FiniteDimensional K ↥E₀) (_ : IsGalois K ↥E₀),
      (∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra R₀ C] [Algebra.Etale R₀ C]
          [Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of C))]
          (A_C : AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C))) 𝒢₀
          ((CategoryTheory.constantSheaf
            (AlgebraicGeometry.Spec (CommRingCat.of C)).smallEtaleTopology
            AddCommGrpCat.{u}).obj A_C) →
        ∀ (L₁ : IntermediateField K (AlgebraicClosure K))
          [FiniteDimensional K ↥L₁] [IsGalois K ↥L₁] (hle : E₀ ≤ L₁),
          letI : Algebra R₀ ↥L₁ :=
            ((algebraMap K ↥L₁).comp (algebraMap R₀ K)).toAlgebra
          ∀ (φ_C : C →ₐ[R₀] ↥L₁) (σ' : ↥L₁ ≃ₐ[K] ↥L₁),
            (∀ c : C, σ' (φ_C c) = φ_C c) →
            ∀ x : ↥E₀,
              σ' (IntermediateField.inclusion hle x) = IntermediateField.inclusion hle x) ∧
      (letI : Algebra R₀ ↥E₀ :=
         ((algebraMap K ↥E₀).comp (algebraMap R₀ K)).toAlgebra
       let B₀ := ↥(integralClosure R₀ ↥E₀)
       Module.Finite R₀ B₀ →
       Algebra.Etale R₀ B₀ →
       let b₀ : B₀ := algebraMap R₀ B₀ g₀
       let V'₀ := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away b₀))
       WeilIsEtaleSheafPullback
         (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ (Localization.Away b₀))) ≫
           AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)))
         𝒢₀
         ((CategoryTheory.constantSheaf V'₀.smallEtaleTopology AddCommGrpCat.{u}).obj A_η)) :=
by
  let _ := hFin_A
  have hTorsBridge :
      ∀ (S₀ S₁ : Type u) [CommRing S₀] [IsDomain S₀] [CommRing S₁] [IsDomain S₁]
        [Algebra S₀ S₁] [Module.Finite S₀ S₁] [Algebra.Etale S₀ S₁]
        (K₀ L₀' : Type u) [Field K₀] [Field L₀']
        [Algebra S₀ K₀] [IsFractionRing S₀ K₀]
        [Algebra S₁ L₀'] [IsFractionRing S₁ L₀']
        [Algebra K₀ L₀'] [Algebra S₀ L₀']
        [IsScalarTower S₀ K₀ L₀'] [IsScalarTower S₀ S₁ L₀']
        [IsIntegralClosure S₁ S₀ L₀'] [FiniteDimensional K₀ L₀'] [IsGalois K₀ L₀'],
        let V₀ := AlgebraicGeometry.Spec (CommRingCat.of S₀)
        let V₁ := AlgebraicGeometry.Spec (CommRingCat.of S₁)
        let q : V₁ ⟶ V₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S₁))
        AlgebraicGeometry.Etale q ∧
        AlgebraicGeometry.Surjective q ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V₁),
          let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ q) q
          ∃ δ : (S₁ ≃ₐ[S₀] S₁) → (Y ⟶ Y_V),
            (∀ τ : S₁ ≃ₐ[S₀] S₁,
              δ τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ q) q = 𝟙 Y ∧
              δ τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ q) q =
                g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) ∧
              AlgebraicGeometry.Etale (δ τ)) ∧
            (⋃ τ : S₁ ≃ₐ[S₀] S₁, Set.range (δ τ).base) = Set.univ) := by
    clear! R₀ K
    intro S₀ S₁ _ _ _ _ _ _ _ K₀ L₀' _ _ _ _ _ _ _ _ _ _ _ _ _ V₀ V₁ q
    obtain ⟨hInj, m, equiv_Γ, e, hIdemp, hOrth, hSum, hEval, hAbsorb⟩ :=
      weil_etale_galois_domain_idempotents_and_aut_lift.1 S₀ S₁ K₀ L₀'
    let π_raw : V₁ ⟶ V₀ := q ≫ (CategoryTheory.Iso.refl V₀).hom
    have hq_id : π_raw = q := CategoryTheory.Category.comp_id q
    obtain ⟨⟨hq_et_raw, hq_surj_raw⟩, _, hSheets_raw⟩ :=
      weil_scheme_galois_torsor_clopen_sheets S₀ S₁ hInj m equiv_Γ e
        hIdemp hOrth hSum hEval hAbsorb V₀ (CategoryTheory.Iso.refl V₀)
    refine ⟨hq_id ▸ hq_et_raw, hq_id ▸ hq_surj_raw, fun Y g_Y => ?_⟩
    obtain ⟨δ_raw, hδ_props, _, hδ_univ, _⟩ := hSheets_raw Y g_Y
    let e_pb : CategoryTheory.Limits.pullback (g_Y ≫ π_raw) π_raw ≅
        CategoryTheory.Limits.pullback (g_Y ≫ q) q :=
      CategoryTheory.Limits.pullback.congrHom (congrArg (g_Y ≫ ·) hq_id) hq_id
    refine ⟨fun τ => δ_raw τ ≫ e_pb.hom, fun τ => ⟨?_, ?_, ?_⟩, ?_⟩
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id,
        (hδ_props τ).1]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id,
        (hδ_props τ).2.1]
    · have : AlgebraicGeometry.Etale (δ_raw τ) := (hδ_props τ).2.2.1
      exact inferInstance
    · apply Set.eq_univ_of_forall
      intro z
      have hz₀ : e_pb.inv.base z ∈ (⋃ τ, Set.range (δ_raw τ).base) := by
        rw [hδ_univ]
        trivial
      rw [Set.mem_iUnion] at hz₀ ⊢
      obtain ⟨τ, y, hy⟩ := hz₀
      refine ⟨τ, y, ?_⟩
      change e_pb.hom.base ((δ_raw τ).base y) = z
      rw [hy]
      change (e_pb.inv ≫ e_pb.hom).base z = z
      rw [e_pb.inv_hom_id]
      rfl

  let U₀ := AlgebraicGeometry.Spec (CommRingCat.of R₀)
  
  obtain ⟨z₀⟩ := hW_ne
  obtain ⟨R_B, j_B, hj_open, ⟨q_B, _⟩, _⟩ :=
    AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
      (X := W_η) (U := ⊤) (x := z₀) trivial
  have : AlgebraicGeometry.IsOpenImmersion j_B := hj_open
  have : AlgebraicGeometry.Etale w_η := hw_et
  have h_et_jBw : AlgebraicGeometry.Etale (j_B ≫ w_η) := inferInstance
  let φ_B : CommRingCat.of R₀ ⟶ R_B := AlgebraicGeometry.Spec.preimage (j_B ≫ w_η)
  have hφ_B_map : AlgebraicGeometry.Spec.map φ_B = j_B ≫ w_η :=
    AlgebraicGeometry.Spec.map_preimage (j_B ≫ w_η)
  have hφ_B_et : RingHom.Etale φ_B.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      (hφ_B_map.symm ▸ h_et_jBw)
  let B_η : Type u := ↑R_B
  let _ : Algebra R₀ B_η := φ_B.hom.toAlgebra
  have : Algebra.Etale R₀ B_η := RingHom.etale_algebraMap.mp hφ_B_et
  have : Module.Flat R₀ B_η := Algebra.Smooth.flat R₀ B_η
  have : Nontrivial B_η :=
    ⟨⟨1, 0, fun h10 =>
      q_B.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ (h10 ▸ q_B.asIdeal.zero_mem) isUnit_one)⟩⟩

  obtain ⟨f₁, hf₁_ne, C₁, hCR_C₁, hDom_C₁, hAlg_R₁_C₁, N, hFin_C₁, hInt_C₁, hEt_C₁,
    hSurj_C₁, hSplit⟩ :=
    weil_commAlg_domain_etale_product_splitting R₀ 1 (fun _ => B_η)
  let _ : CommRing C₁ := hCR_C₁
  let _ : IsDomain C₁ := hDom_C₁
  let _ : Algebra (Localization.Away f₁) C₁ := hAlg_R₁_C₁
  have : Module.Finite (Localization.Away f₁) C₁ := hFin_C₁
  have : Algebra.IsIntegral (Localization.Away f₁) C₁ := hInt_C₁
  have : Algebra.Etale (Localization.Away f₁) C₁ := hEt_C₁
  let _ : Algebra R₀ C₁ :=
    RingHom.toAlgebra ((algebraMap (Localization.Away f₁) C₁).comp
      (algebraMap R₀ (Localization.Away f₁)))
  obtain ⟨Ψ⟩ := hSplit 0

  have hle_nzd_f₁ : Submonoid.powers f₁ ≤ nonZeroDivisors R₀ :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hf₁_ne)
  have : IsDomain (Localization.Away f₁) :=
    IsLocalization.isDomain_localization hle_nzd_f₁
  have hInj_R₀_R₁ : Function.Injective (algebraMap R₀ (Localization.Away f₁)) :=
    IsLocalization.injective (Localization.Away f₁) hle_nzd_f₁
  have hInj_R₁_C₁ : Function.Injective (algebraMap (Localization.Away f₁) C₁) := by
    have hbot_prime : (⊥ : Ideal (Localization.Away f₁)).IsPrime :=
      ⟨bot_ne_top, fun {a b} hab => by
        rw [Ideal.mem_bot] at hab ⊢
        exact mul_eq_zero.mp hab⟩
    obtain ⟨P₀, hP₀⟩ := hSurj_C₁ ⟨⊥, hbot_prime⟩
    intro x y hxy
    have hsub : algebraMap (Localization.Away f₁) C₁ (x - y) = 0 := by
      rw [map_sub, hxy, sub_self]
    have hmem : x - y ∈ Ideal.comap (algebraMap (Localization.Away f₁) C₁) P₀.asIdeal := by
      change algebraMap (Localization.Away f₁) C₁ (x - y) ∈ P₀.asIdeal
      rw [hsub]
      exact P₀.asIdeal.zero_mem
    have hcomap_bot : Ideal.comap (algebraMap (Localization.Away f₁) C₁) P₀.asIdeal = ⊥ :=
      congrArg PrimeSpectrum.asIdeal hP₀
    rw [hcomap_bot, Ideal.mem_bot] at hmem
    exact sub_eq_zero.mp hmem
  have hInj_R₀_C₁ : Function.Injective (algebraMap R₀ C₁) := hInj_R₁_C₁.comp hInj_R₀_R₁
  have hNontriv_ten : Nontrivial (TensorProduct R₀ C₁ B_η) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_right R₀ C₁ B_η hInj_R₀_C₁
  have hN0_pos : 0 < N 0 := by
    rcases Nat.eq_zero_or_pos (N 0) with h0 | hpos
    · exfalso
      have h10 : (1 : TensorProduct R₀ C₁ B_η) = 0 := by
        apply Ψ.injective
        funext i
        exact Fin.elim0 (h0 ▸ i)
      exact one_ne_zero h10
    · exact hpos

  let θ₀ : B_η →ₐ[R₀] C₁ :=
    { toFun := fun b => Ψ (TensorProduct.tmul R₀ 1 b) ⟨0, hN0_pos⟩
      map_one' := by
        change Ψ (1 : TensorProduct R₀ C₁ B_η) ⟨0, hN0_pos⟩ = 1
        rw [map_one]
        rfl
      map_mul' := fun x y => by
        have hmul : TensorProduct.tmul R₀ (1 : C₁) (x * y) =
            TensorProduct.tmul R₀ 1 x * TensorProduct.tmul R₀ 1 y := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        rw [hmul, map_mul]
        rfl
      map_zero' := by
        rw [TensorProduct.tmul_zero, map_zero]
        rfl
      map_add' := fun x y => by
        rw [TensorProduct.tmul_add, map_add]
        rfl
      commutes' := fun r => by
        have htmul : TensorProduct.tmul R₀ (1 : C₁) (algebraMap R₀ B_η r) =
            algebraMap C₁ (TensorProduct R₀ C₁ B_η) (algebraMap R₀ C₁ r) := by
          rw [Algebra.algebraMap_eq_smul_one (A := B_η), TensorProduct.tmul_smul,
            TensorProduct.smul_tmul', ← Algebra.algebraMap_eq_smul_one (A := C₁)]
          rfl
        rw [htmul, Ψ.commutes]
        rfl }

  obtain ⟨g₀, hg₀_ne, L₀, hFD₀, hGal₀, φ_g₀, hφ_g₀, hDom_R', hFrac_R',
    hFin_Cgal, hEt_R'_Cgal, hEt_R₀_Cgal, hFrac_Cgal, ⟨j_C₁⟩⟩ :=
    weil_commAlg_etale_domain_galois_closure_spread R₀ K hSpread f₁ hf₁_ne C₁ hSurj_C₁
  let _ : FiniteDimensional K ↥L₀ := hFD₀
  let _ : IsGalois K ↥L₀ := hGal₀
  let R' := Localization.Away g₀
  let _ : Algebra R' K := φ_g₀.toAlgebra
  let _ : Algebra R' ↥L₀ := ((algebraMap K ↥L₀).comp φ_g₀).toAlgebra
  let C_gal := ↥(integralClosure R' ↥L₀)
  let _ : Algebra R₀ C_gal := ((algebraMap R' C_gal).comp (algebraMap R₀ R')).toAlgebra
  have : IsDomain R' := hDom_R'
  have : IsFractionRing R' K := hFrac_R'
  have : Module.Finite R' C_gal := hFin_Cgal
  have : Algebra.Etale R' C_gal := hEt_R'_Cgal
  have : Algebra.Etale R₀ C_gal := hEt_R₀_Cgal
  have : IsFractionRing C_gal ↥L₀ := hFrac_Cgal

  let V_gal := AlgebraicGeometry.Spec (CommRingCat.of C_gal)
  let π_gal : V_gal ⟶ U₀ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C_gal))
  let ψ_B_gal : B_η →ₐ[R₀] C_gal := j_C₁.comp θ₀
  let f_gal_W : V_gal ⟶ W_η :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B_gal.toRingHom) ≫ j_B
  have hf_gal_comp : f_gal_W ≫ w_η = π_gal := by
    dsimp [f_gal_W, π_gal]
    rw [CategoryTheory.Category.assoc, ← hφ_B_map, ← AlgebraicGeometry.Spec.map_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    exact ψ_B_gal.commutes r
  have hPbPkg := weil_etale_pullback_exact_and_pseudofunctor 0
  have hPull_gal : WeilIsEtaleSheafPullback π_gal 𝒢₀
      ((CategoryTheory.constantSheaf V_gal.smallEtaleTopology AddCommGrpCat.{u}).obj A_η) := by
    rw [← hf_gal_comp]
    exact (hPbPkg.2.2.1 f_gal_W w_η 𝒢₀ _ _).1 hPull_η (hPbPkg.2.2.2.1 f_gal_W A_η)

  
  have hπ_gal_et : AlgebraicGeometry.Etale π_gal :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  let _ : AlgebraicGeometry.Etale π_gal := hπ_gal_et
  let E_gal : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk π_gal

  let mkR'Equiv : (↥L₀ ≃ₐ[K] ↥L₀) → (↥L₀ ≃ₐ[R'] ↥L₀) :=
    fun σ => { σ.toRingEquiv with commutes' := fun r => σ.commutes (φ_g₀ r) }
  let τ_gal : (↥L₀ ≃ₐ[K] ↥L₀) → (C_gal ≃ₐ[R'] C_gal) :=
    fun σ => AlgEquiv.mapIntegralClosure (mkR'Equiv σ)
  have hτ_symm_val : ∀ (σ : ↥L₀ ≃ₐ[K] ↥L₀) (b : C_gal),
      ((τ_gal σ).symm b).1 = σ.symm b.1 := by
    intro σ b
    apply σ.injective
    rw [σ.apply_symm_apply]
    change (AlgEquiv.mapIntegralClosure (mkR'Equiv σ) ((τ_gal σ).symm b)).1 = b.1
    rw [(τ_gal σ).apply_symm_apply]
  have hτ_symm_comm : ∀ (σ : ↥L₀ ≃ₐ[K] ↥L₀),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal σ).symm.toRingHom) ≫ π_gal = π_gal := by
    intro σ
    dsimp [π_gal]
    rw [← AlgebraicGeometry.Spec.map_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    exact (τ_gal σ).symm.commutes (algebraMap R₀ R' r)
  let u_deck : (↥L₀ ≃ₐ[K] ↥L₀) → (E_gal ⟶ E_gal) :=
    fun σ => CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal σ).symm.toRingHom))
      (hτ_symm_comm σ)

  have hu_one : u_deck 1 = 𝟙 E_gal := by
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal 1).symm.toRingHom) = 𝟙 V_gal
    have h_id : CommRingCat.ofHom (τ_gal 1).symm.toRingHom = 𝟙 (CommRingCat.of C_gal) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      exact Subtype.ext (hτ_symm_val 1 b)
    rw [h_id, AlgebraicGeometry.Spec.map_id]
  have hu_mul : ∀ σ₁ σ₂ : ↥L₀ ≃ₐ[K] ↥L₀, u_deck (σ₁ * σ₂) = u_deck σ₂ ≫ u_deck σ₁ := by
    intro σ₁ σ₂
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal (σ₁ * σ₂)).symm.toRingHom) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal σ₂).symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal σ₁).symm.toRingHom)
    rw [← AlgebraicGeometry.Spec.map_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro b
    apply Subtype.ext
    change ((τ_gal (σ₁ * σ₂)).symm b).1 = ((τ_gal σ₂).symm ((τ_gal σ₁).symm b)).1
    rw [hτ_symm_val, hτ_symm_val, hτ_symm_val]
    rfl

  let α_act : (↥L₀ ≃ₐ[K] ↥L₀) →
      (↑(𝒢₀.obj.obj (Opposite.op E_gal)) →+ ↑(𝒢₀.obj.obj (Opposite.op E_gal))) :=
    fun σ => (𝒢₀.obj.map (Opposite.op (u_deck σ))).hom
  have hα_one : ∀ s, α_act 1 s = s := fun s => by
    have h1 : 𝒢₀.obj.map (Opposite.op (u_deck 1)) = 𝟙 _ :=
      (congrArg (fun f => 𝒢₀.obj.map (Opposite.op f)) hu_one).trans
        (𝒢₀.obj.map_id (Opposite.op E_gal))
    exact congrArg (fun φ => φ.hom s) h1
  have hα_mul : ∀ (σ₁ σ₂ : ↥L₀ ≃ₐ[K] ↥L₀) (s),
      α_act (σ₁ * σ₂) s = α_act σ₂ (α_act σ₁ s) := fun σ₁ σ₂ s => by
    have h1 : 𝒢₀.obj.map (Opposite.op (u_deck (σ₁ * σ₂))) =
        𝒢₀.obj.map (Opposite.op (u_deck σ₁)) ≫ 𝒢₀.obj.map (Opposite.op (u_deck σ₂)) :=
      (congrArg (fun f => 𝒢₀.obj.map (Opposite.op f)) (hu_mul σ₁ σ₂)).trans
        (𝒢₀.obj.map_comp (Opposite.op (u_deck σ₁)) (Opposite.op (u_deck σ₂)))
    exact congrArg (fun φ => φ.hom s) h1

  let H_ker : Subgroup (↥L₀ ≃ₐ[K] ↥L₀) :=
    { carrier := { σ | ∀ s, α_act σ s = s }
      one_mem' := hα_one
      mul_mem' := fun {σ₁ σ₂} h₁ h₂ s => by rw [hα_mul, h₁, h₂]
      inv_mem' := fun {σ} h s => by
        have h1 : α_act (σ⁻¹ * σ) s = s := by rw [inv_mul_cancel, hα_one]
        rw [hα_mul, h (α_act σ⁻¹ s)] at h1
        exact h1 }
  have hH_norm : H_ker.Normal :=
    { conj_mem := fun n hn g s => by
        rw [hα_mul, hα_mul, hn (α_act g s), ← hα_mul, mul_inv_cancel, hα_one] }
  have : H_ker.Normal := hH_norm

  let F₀ : IntermediateField K ↥L₀ := IntermediateField.fixedField H_ker
  have : IsGalois K ↥F₀ := IsGalois.of_fixedField_normal_subgroup H_ker
  let E₀ : IntermediateField K (AlgebraicClosure K) := F₀.map L₀.val
  let e_FE : ↥F₀ ≃ₐ[K] ↥E₀ := F₀.equivMap L₀.val
  have hFD_E₀ : FiniteDimensional K ↥E₀ := LinearEquiv.finiteDimensional e_FE.toLinearEquiv
  have hGal_E₀ : IsGalois K ↥E₀ := IsGalois.of_algEquiv e_FE
  let _ : FiniteDimensional K ↥E₀ := hFD_E₀
  let _ : IsGalois K ↥E₀ := hGal_E₀
  have hE₀_L₀ : E₀ ≤ L₀ := by
    rintro _ ⟨y, _, rfl⟩
    exact y.2
  have hGal_iff : ∀ σ : ↥L₀ ≃ₐ[K] ↥L₀,
      (∀ x : ↥E₀,
        σ (IntermediateField.inclusion hE₀_L₀ x) = IntermediateField.inclusion hE₀_L₀ x) ↔
      σ ∈ H_ker := by
    intro σ
    have hfix_eq : F₀.fixingSubgroup = H_ker := IntermediateField.fixingSubgroup_fixedField H_ker
    rw [← hfix_eq, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h z hz
      let x : ↥E₀ := e_FE ⟨z, hz⟩
      have hx_incl : IntermediateField.inclusion hE₀_L₀ x = z := by
        apply Subtype.ext
        exact IntermediateField.coe_equivMap_apply F₀ L₀.val ⟨z, hz⟩
      simpa [hx_incl] using h x
    · intro h x
      let y : ↥F₀ := e_FE.symm x
      have hy_eq : e_FE y = x := e_FE.apply_symm_apply x
      have hx_incl : IntermediateField.inclusion hE₀_L₀ x = y.1 := by
        rw [← hy_eq]
        apply Subtype.ext
        exact IntermediateField.coe_equivMap_apply F₀ L₀.val y
      rw [hx_incl]
      exact h y.1 y.2

  
  have hCompPkg := weil_commAlg_galois_compositum_and_away_integralClosure
    R₀ K hSpread g₀ hg₀_ne φ_g₀ hφ_g₀ L₀

  refine ⟨g₀, hg₀_ne, E₀, hFD_E₀, hGal_E₀, ?_, ?_⟩
  · 
    intro C _ _ _ _ _ A_C hPull_C L₁ _ _ hle φ_C σ' hFix_C
    obtain ⟨C_top, hCR_top, hDom_top, hAlg_top, hEt_top, j_C, j_gal, τ_top, σ₀,
      hEq_C, hEq_gal, hImp_E₀⟩ :=
      hCompPkg.1 C L₁ E₀ hE₀_L₀ hle φ_C σ' hFix_C
    let _ : CommRing C_top := hCR_top
    let _ : IsDomain C_top := hDom_top
    let _ : Algebra R₀ C_top := hAlg_top
    have : Algebra.Etale R₀ C_top := hEt_top

    let π_C := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C))
    let π_top := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ C_top))
    have hπ_C_et : AlgebraicGeometry.Etale π_C :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    have hπ_top_et : AlgebraicGeometry.Etale π_top :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    let _ : AlgebraicGeometry.Etale π_C := hπ_C_et
    let _ : AlgebraicGeometry.Etale π_top := hπ_top_et
    let E_C : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk π_C
    let E_top : U₀.Etale := AlgebraicGeometry.Scheme.Etale.mk π_top

    have hq_C_comm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_C.toRingHom) ≫ π_C = π_top := by
      dsimp [π_C, π_top]
      rw [← AlgebraicGeometry.Spec.map_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply CommRingCat.hom_ext
      exact RingHom.ext j_C.commutes
    have hq_gal_comm :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_gal.toRingHom) ≫ π_gal = π_top := by
      dsimp [π_gal, π_top]
      rw [← AlgebraicGeometry.Spec.map_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply CommRingCat.hom_ext
      exact RingHom.ext j_gal.commutes
    have hv_top_comm :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_top.symm.toRingHom) ≫ π_top = π_top := by
      dsimp [π_top]
      rw [← AlgebraicGeometry.Spec.map_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply CommRingCat.hom_ext
      exact RingHom.ext τ_top.symm.commutes

    let q_C : E_top ⟶ E_C :=
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_C.toRingHom)) hq_C_comm
    let q_gal : E_top ⟶ E_gal :=
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_gal.toRingHom)) hq_gal_comm
    let v_top : E_top ⟶ E_top :=
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_top.symm.toRingHom)) hv_top_comm

    have hBij_C : Function.Bijective ((𝒢₀.obj.map (Opposite.op q_C)).hom) :=
      weil_etale_domain_hom_constant_pullback_bijective R₀ 𝒢₀ C C_top
        hπ_C_et hπ_top_et A_C hPull_C j_C q_C rfl
    have hBij_gal : Function.Bijective ((𝒢₀.obj.map (Opposite.op q_gal)).hom) :=
      weil_etale_domain_hom_constant_pullback_bijective R₀ 𝒢₀ C_gal C_top
        hπ_gal_et hπ_top_et A_η hPull_gal j_gal q_gal rfl

    have hv_qC : v_top ≫ q_C = q_C := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_top.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_C.toRingHom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_C.toRingHom)
      rw [← AlgebraicGeometry.Spec.map_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply CommRingCat.hom_ext
      exact RingHom.ext hEq_C
    have hv_top_triv : ∀ t : ↑(𝒢₀.obj.obj (Opposite.op E_top)),
        (𝒢₀.obj.map (Opposite.op v_top)).hom t = t := by
      intro t
      obtain ⟨s, rfl⟩ := hBij_C.2 t
      have h1 : 𝒢₀.obj.map (Opposite.op q_C) ≫ 𝒢₀.obj.map (Opposite.op v_top) =
          𝒢₀.obj.map (Opposite.op q_C) :=
        (𝒢₀.obj.map_comp (Opposite.op q_C) (Opposite.op v_top)).symm.trans
          (congrArg (fun f => 𝒢₀.obj.map (Opposite.op f)) hv_qC)
      exact congrArg (fun φ => φ.hom s) h1

    have hv_qgal : v_top ≫ q_gal = q_gal ≫ u_deck σ₀ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_top.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_gal.toRingHom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_gal.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal σ₀).symm.toRingHom)
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply CommRingCat.hom_ext
      exact RingHom.ext hEq_gal
    have hσ₀_ker : σ₀ ∈ H_ker := by
      intro s
      apply hBij_gal.1
      have h1 : 𝒢₀.obj.map (Opposite.op (u_deck σ₀)) ≫ 𝒢₀.obj.map (Opposite.op q_gal) =
          𝒢₀.obj.map (Opposite.op q_gal) ≫ 𝒢₀.obj.map (Opposite.op v_top) :=
        ((𝒢₀.obj.map_comp (Opposite.op (u_deck σ₀)) (Opposite.op q_gal)).symm.trans
          (congrArg (fun f => 𝒢₀.obj.map (Opposite.op f)) hv_qgal.symm)).trans
          (𝒢₀.obj.map_comp (Opposite.op q_gal) (Opposite.op v_top))
      exact (congrArg (fun φ => φ.hom s) h1).trans
        (hv_top_triv ((𝒢₀.obj.map (Opposite.op q_gal)).hom s))

    exact hImp_E₀ ((hGal_iff σ₀).mpr hσ₀_ker)
  · 
    dsimp only
    let _ : Algebra R₀ ↥E₀ := ((algebraMap K ↥E₀).comp (algebraMap R₀ K)).toAlgebra
    let B₀ := ↥(integralClosure R₀ ↥E₀)
    intro hFin_B₀ hEt_B₀
    let b₀ : B₀ := algebraMap R₀ B₀ g₀
    let C'₀ := Localization.Away b₀
    let V'₀ := AlgebraicGeometry.Spec (CommRingCat.of C'₀)

    obtain ⟨hDom_C'₀, instAlg_R'_C'₀, instAlg_C'₀_E₀, hFin_R'_C'₀, hEt_R'_C'₀,
      hEt_R₀_C'₀, hST_R'_K_E₀, hST_R'_C'₀_E₀, hFrac_C'₀_E₀, hIntCl_C'₀,
      ι_C'₀, hι_inj, hι_R₀, hLift_τ⟩ :=
      hCompPkg.2 E₀ hE₀_L₀ hFin_B₀ hEt_B₀
    have : IsDomain C'₀ := hDom_C'₀
    let _ : Algebra R' C'₀ := instAlg_R'_C'₀
    let _ : Algebra C'₀ ↥E₀ := instAlg_C'₀_E₀
    let _ : Algebra R' ↥E₀ := ((algebraMap K ↥E₀).comp φ_g₀).toAlgebra
    have : Module.Finite R' C'₀ := hFin_R'_C'₀
    have : Algebra.Etale R' C'₀ := hEt_R'_C'₀
    have : Algebra.Etale R₀ C'₀ := hEt_R₀_C'₀
    have : IsScalarTower R' K ↥E₀ := hST_R'_K_E₀
    have : IsScalarTower R' C'₀ ↥E₀ := hST_R'_C'₀_E₀
    have : IsFractionRing C'₀ ↥E₀ := hFrac_C'₀_E₀
    have : IsIntegralClosure C'₀ R' ↥E₀ := hIntCl_C'₀
    have : IsScalarTower R' K ↥L₀ := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have : IsIntegralClosure C_gal R' ↥L₀ := integralClosure.isIntegralClosure R' ↥L₀

    have hGalIdemp := weil_etale_galois_domain_idempotents_and_aut_lift
    obtain ⟨_, hRelGalois⟩ := hGalIdemp.2.2 R' K C'₀ ↥E₀ C_gal ↥L₀ ι_C'₀ hι_inj
    let _ : Algebra C'₀ C_gal := ι_C'₀.toRingHom.toAlgebra
    let _ : Algebra C'₀ ↥L₀ := ((algebraMap C_gal ↥L₀).comp ι_C'₀.toRingHom).toAlgebra
    obtain ⟨hST_C'₀_Cgal_L₀, hFin_rel, hEt_rel, hIntCl_rel,
      instAlg_E₀_L₀, hST_C'₀_E₀_L₀, hFD_rel, hGal_rel⟩ := hRelGalois
    let _ : Algebra ↥E₀ ↥L₀ := instAlg_E₀_L₀
    have : IsScalarTower C'₀ C_gal ↥L₀ := hST_C'₀_Cgal_L₀
    have : Module.Finite C'₀ C_gal := hFin_rel
    have : Algebra.Etale C'₀ C_gal := hEt_rel
    have : IsIntegralClosure C_gal C'₀ ↥L₀ := hIntCl_rel
    have : IsScalarTower C'₀ ↥E₀ ↥L₀ := hST_C'₀_E₀_L₀
    have : FiniteDimensional ↥E₀ ↥L₀ := hFD_rel
    have : IsGalois ↥E₀ ↥L₀ := hGal_rel
    have : IsScalarTower R₀ C'₀ C_gal :=
      IsScalarTower.mk fun (r : R₀) (y : C'₀) (z : C_gal) => by
        have hry : r • y = algebraMap R₀ C'₀ r * y :=
          (inferInstance : Algebra R₀ C'₀).smul_def' r y
        rw [hry, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, map_mul]
        have hr : algebraMap C'₀ C_gal (algebraMap R₀ C'₀ r) = algebraMap R₀ C_gal r :=
          RingHom.congr_fun hι_R₀ r
        rw [hr, mul_assoc]

    obtain ⟨hq_et, hq_surj, hSheets⟩ := hTorsBridge C'₀ C_gal ↥E₀ ↥L₀

    have hπ₀_et : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := R₀) (S := C'₀) (algebraMap R₀ C'₀))) := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      exact RingHom.etale_algebraMap.mpr hEt_R₀_C'₀

    have hDeckTriv : ∀ (τ : C_gal ≃ₐ[C'₀] C_gal) (u_τ : E_gal ⟶ E_gal),
        ((AlgebraicGeometry.Scheme.Etale.forget U₀).map u_τ).left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
        ∀ s : ↑(𝒢₀.obj.obj (Opposite.op E_gal)),
          (𝒢₀.obj.map (Opposite.op u_τ)).hom s = s := by
      intro τ u_τ hu_τ s
      obtain ⟨σ, hσ_fix, hτ_eq⟩ := hLift_τ τ
      have hσ_mem : σ ∈ H_ker := (hGal_iff σ).mp hσ_fix
      have hu_eq : u_τ = u_deck σ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        change ((AlgebraicGeometry.Scheme.Etale.forget U₀).map u_τ).left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_gal σ).symm.toRingHom)
        rw [hu_τ, hτ_eq]
      exact (congrArg (fun f => (𝒢₀.obj.map (Opposite.op f)).hom s) hu_eq).trans (hσ_mem s)

    have hPull_C'₀ : WeilIsEtaleSheafPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := R₀) (S := C'₀) (algebraMap R₀ C'₀))) 𝒢₀
        ((CategoryTheory.constantSheaf V'₀.smallEtaleTopology AddCommGrpCat.{u}).obj A_η) :=
      weil_etale_torsor_trivial_deck_constant_descent R₀ 𝒢₀ C'₀ C_gal
        hπ₀_et hπ_gal_et hq_et hq_surj hSheets A_η hPull_gal hDeckTriv

    have hSpec_comp :
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := B₀) (S := C'₀) (algebraMap B₀ C'₀)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B₀)) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (R := R₀) (S := C'₀) (algebraMap R₀ C'₀)) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      apply congrArg AlgebraicGeometry.Spec.map
      apply CommRingCat.hom_ext
      exact (IsScalarTower.algebraMap_eq R₀ B₀ C'₀).symm
    exact hSpec_comp.symm ▸ hPull_C'₀

theorem weil_dedekind_locConst_global_const_of_basicOpen_const (B : Type u)
    [CommRing B] [IsDomain B]
    (hDomShrink : ∀ (D : Type u) [CommRing D] [Algebra B D] [Algebra.Etale B D]
      (Q : Ideal D) [Q.IsPrime],
      ∃ s₀ : D, s₀ ∉ Q ∧
        IsDomain (Localization.Away s₀) ∧
        (Ideal.map (algebraMap D (Localization.Away s₀)) Q).IsPrime ∧
        Ideal.comap (algebraMap D (Localization.Away s₀))
