        letI := (sys (f_bar ⁻¹ᵁ U_bar).ι).hAdd_pb
        letI := (sys (f_bar ⁻¹ᵁ U_bar).ι).hLim_pb
        letI := (sys (f_bar ⁻¹ᵁ U_bar).ι).hColim_pb
        let pf_U := (weilEtaleSitePullback U_bar.ι).sheafPushforwardContinuous
          AddCommGrpCat.{u} D_bar.smallEtaleTopology U_bar.toScheme.smallEtaleTopology
        let A_r := AddCommGrpCat.uliftFunctor.{u, 0}.obj
