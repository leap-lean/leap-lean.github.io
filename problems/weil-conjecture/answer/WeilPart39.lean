      conv_lhs => rw [← CategoryTheory.Category.id_comp φ]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right adj_sh (𝟙 R_E) φ,
        CategoryTheory.Adjunction.homEquiv_naturality_right adj_fr _ _,
        CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
        CategoryTheory.NatTrans.comp_app, CategoryTheory.ConcreteCategory.comp_apply]
      rfl

