        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply s).symm
      have h_lhs : (α_push.hom.app (Opposite.op W)).hom
          ((e_S.hom.hom.app (Opposite.op W)).hom
            (((adj_sh_S.unit.app P_src).app (Opposite.op W)).hom s)) =
          ((pb_j'.obj 𝒢).obj.map (Opposite.op (e_fun.inv.app W))).hom
            (((adj_j'.unit.app 𝒢).hom.app (Opposite.op (B_f.obj W))).hom
