      have h1 : σ (τ.symm b).1 =
          IsFractionRing.fieldEquivOfAlgEquiv ↥E₀ ↥L₀ ↥L₀ τ' (algebraMap C_gal ↥L₀ (τ'.symm b)) := rfl
      rw [h1, IsFractionRing.fieldEquivOfAlgEquiv_algebraMap ↥E₀ ↥L₀ ↥L₀ τ' (τ'.symm b),
        τ'.apply_symm_apply]
