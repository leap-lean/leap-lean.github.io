        fun Y g =>
          let U_a : ↥A → Y.left.Opens := fun a => ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
          let Z_a : ↥A → V.Etale := fun a => mkOpenObj Y (U_a a)
          let k_a : ∀ a : ↥A, Z_a a ⟶ Y := fun a => mkOpenHom Y (U_a a)
          have hk_cov : CategoryTheory.Sieve.ofArrows Z_a k_a ∈ V.smallEtaleTopology Y := by
            rw [hMem]
            intro y
            exact ⟨Z_a (g y), k_a (g y), (⟨y, rfl⟩ : ↥(U_a (g y)).toScheme),
              CategoryTheory.Sieve.ofArrows_mk Z_a k_a (g y), hOpenHomEtale Y (U_a (g y)), rfl⟩
          let c_a : ∀ a : ↥A, E_ℤ ⟶ C_V'.obj.obj (Opposite.op (Z_a a)) := fun a =>
            AddCommGrpCat.ofHom
              { toFun := fun n => n.down • (η_sh.app (Opposite.op (Z_a a))).hom a
                map_zero' := zero_zsmul _
                map_add' := fun n₁ n₂ => add_zsmul _ n₁.down n₂.down }
          have h_ov : ∀ ⦃W' : V.Etale⦄ ⦃a₁ a₂ : ↥A⦄ (b₁ : W' ⟶ Z_a a₁) (b₂ : W' ⟶ Z_a a₂),
              b₁ ≫ k_a a₁ = b₂ ≫ k_a a₂ →
              c_a a₁ ≫ C_V'.obj.map b₁.op = c_a a₂ ≫ C_V'.obj.map b₂.op := by
            intro W' a₁ a₂ b₁ b₂ hb
            by_cases ha : a₁ = a₂
