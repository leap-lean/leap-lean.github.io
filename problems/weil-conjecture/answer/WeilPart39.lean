          (T_raw.ρ_raw r τ_raw).val (α_lat r (f ((m_j_can r W).base y_raw)))
        rw [hm_pt, hf_eq]
        exact (hαβ_equivar r τ_raw σ hcomp).1 (f ((m_j_can r W).base y_raw))
      obtain ⟨t, ht⟩ := hg_mem
      refine ⟨t, fun y_raw => ?_⟩
      rw [ht]
      rfl
    let α_fun : ∀ W : U₀.toScheme.Etale,
        ↑((𝒱₀ r).obj.obj (Opposite.op W)) → ↑((ℛ r).obj.obj (Opposite.op W)) :=
      fun W s => Classical.choose (hPointwise_α W s)
    have hα_spec : ∀ (W : U₀.toScheme.Etale) (s : ↑((𝒱₀ r).obj.obj (Opposite.op W)))
