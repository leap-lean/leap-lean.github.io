        let V : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g_U π₀
        let p : V ⟶ U.toScheme := CategoryTheory.Limits.pullback.fst g_U π₀
        let q_V : V ⟶ V₀ := CategoryTheory.Limits.pullback.snd g_U π₀
        have hFin_p : AlgebraicGeometry.IsFinite p := inferInstance
