    intro W Ω _ _ w
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget W
    let fib := mkGeomFiber W Ω w
    let pt_Ω : ↥S_Ω := IsLocalRing.closedPoint Ω

    
    have hCofOrEmpty : CategoryTheory.IsCofilteredOrEmpty fib.Elements :=
      { cone_objs := fun X Y => by
          let E₁ := X.obj
          let E₂ := Y.obj
          let h₁ : (Fgt.obj E₁).left ⟶ W := (Fgt.obj E₁).hom
          let h₂ : (Fgt.obj E₂).left ⟶ W := (Fgt.obj E₂).hom
          let _ : AlgebraicGeometry.Etale h₁ := E₁.prop
          let _ : AlgebraicGeometry.Etale h₂ := E₂.prop
          have hEt_fst : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst h₁ h₂) :=
            inferInstance
          have hEt_comp : AlgebraicGeometry.Etale
              (CategoryTheory.Limits.pullback.fst h₁ h₂ ≫ h₁) :=
            CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
              hEt_fst inferInstance
