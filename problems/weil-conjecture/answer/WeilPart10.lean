          (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
              (s_k : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
                AlgebraicGeometry.Spec (CommRingCat.of B_k))
