        exact ⟨fun h => hInj (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩
      have hBotMem : p_bot ∈ τ.base ⁻¹' Set.range ι.base := by
        rw [← hp_bot_eq]; exact hGenMem
      have hDense : p ∈ closure ({p_bot} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B))) := by
        change p ∈ closure ({p_bot} : Set (PrimeSpectrum B))
        rw [PrimeSpectrum.closure_singleton]
        change (⊥ : Ideal B) ≤ p.asIdeal
        exact bot_le
      exact (closure_minimal (Set.singleton_subset_iff.mpr hBotMem) hClPre) hDense
    exact hRedLift E _ C_B ι τ hSub

  have hSepSec : ∀ (C S : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ S) [AlgebraicGeometry.IsSeparated g]
      (τ : S ⟶ C),
      τ ≫ g = 𝟙 S →
      AlgebraicGeometry.IsClosedImmersion τ ∧
