        · exact (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_src hPB_tgt).symm
        · rw [hsnd_eq]
          exact (CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_src hPB_tgt).symm
      rw [hΦ_eq_iso]
      infer_instance

    change ∃ (π_φ : P_S ⟶ P_R), CategoryTheory.IsPullback π_φ p_S p_R f_φ
    refine ⟨π_φ, ?_⟩
    refine (CategoryTheory.IsPullback.of_hasPullback p_R f_φ).of_iso
