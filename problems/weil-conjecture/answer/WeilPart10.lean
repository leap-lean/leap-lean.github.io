  · intro U₀ V₀ hU₀ hV₀ hV₀_le K _ _ φ_B
    let A₀ := ↑(S.presheaf.obj (Opposite.op U₀))
    let B₀ := ↑(C.presheaf.obj (Opposite.op V₀))
    letI : Algebra A₀ B₀ := (g.appLE U₀ V₀ hV₀_le).hom.toAlgebra
    let φ_A : A₀ →+* K := φ_B.comp (g.appLE U₀ V₀ hV₀_le).hom
    letI : Algebra A₀ K := φ_A.toAlgebra
    let ev_K : B₀ →ₐ[A₀] K := ⟨φ_B, fun _ => rfl⟩
    let B_K := TensorProduct A₀ K B₀
    let Φ_K : B_K →+* K :=
      (Algebra.TensorProduct.lift (AlgHom.id K K) ev_K (fun _ _ => mul_comm _ _)).toRingHom
    let q_K : Ideal B_K := RingHom.ker Φ_K
    let p_K : PrimeSpectrum B_K := ⟨q_K, RingHom.ker_isPrime Φ_K⟩
    let f_AK : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ K))
    let f_AB : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀))
    let p_K_mor : AlgebraicGeometry.Spec (CommRingCat.of B_K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K B_K))
    let p_B_mor : AlgebraicGeometry.Spec (CommRingCat.of B_K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
    have hi_fst : (AlgebraicGeometry.pullbackSpecIso A₀ K B₀).inv ≫
        CategoryTheory.Limits.pullback.fst f_AK f_AB = p_K_mor :=
      AlgebraicGeometry.pullbackSpecIso_inv_fst' A₀ K B₀
    have hi_snd : (AlgebraicGeometry.pullbackSpecIso A₀ K B₀).inv ≫
        CategoryTheory.Limits.pullback.snd f_AK f_AB = p_B_mor :=
      AlgebraicGeometry.pullbackSpecIso_inv_snd A₀ K B₀
    have hSq_aff : p_K_mor ≫ f_AK = p_B_mor ≫ f_AB := by
      rw [← hi_fst, ← hi_snd, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
