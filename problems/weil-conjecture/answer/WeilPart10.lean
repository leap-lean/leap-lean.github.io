  · intro A B _ _ _ _ _ S_gen hΩ z hz
    have hNat : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module A M₁]
        [AddCommGroup M₂] [Module A M₂] (g : M₁ →ₗ[A] M₂) (b : B)
        (w : TensorProduct A B M₁),
        LinearMap.lTensor B g (LinearMap.rTensor M₁ (LinearMap.mulLeft A b) w) =
          LinearMap.rTensor M₂ (LinearMap.mulLeft A b) (LinearMap.lTensor B g w) := by
      intro M₁ M₂ _ _ _ _ g b w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul x m => simp
      | add w₁ w₂ ih₁ ih₂ => simp [map_add, ih₁, ih₂]
    have hPrime : ∀ (P : Ideal A), P.IsPrime →
        ∀ w : TensorProduct A B (A ⧸ P),
          (∀ b ∈ S_gen, LinearMap.rTensor (A ⧸ P) (LinearMap.mulLeft A b) w = 0) → w = 0 := by
      intro P hP w hw
      let p : PrimeSpectrum A := ⟨P, hP⟩
      let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
      letI : Algebra A Ω :=
        ((algebraMap p.asIdeal.ResidueField Ω).comp
          (algebraMap A p.asIdeal.ResidueField)).toAlgebra
      let f_Ω : A →ₗ[A] Ω := Algebra.linearMap A Ω
      have hP_ker : P = LinearMap.ker f_Ω := by
        ext a
        rw [LinearMap.mem_ker]
        change a ∈ p.asIdeal ↔
          (algebraMap p.asIdeal.ResidueField Ω) ((algebraMap A p.asIdeal.ResidueField) a) = 0
        rw [map_eq_zero_iff _ (RingHom.injective (algebraMap p.asIdeal.ResidueField Ω)),
          Ideal.algebraMap_residueField_eq_zero]
      let ι_P : (A ⧸ P) →ₗ[A] Ω := P.liftQ f_Ω (le_of_eq hP_ker)
      have hι_inj : Function.Injective ι_P := by
        intro x y hxy
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective P x
        obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective P y
        apply (Submodule.Quotient.eq P).mpr
        rw [hP_ker, LinearMap.mem_ker, map_sub, sub_eq_zero]
        exact hxy
