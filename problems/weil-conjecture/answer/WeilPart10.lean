          letI : IsDomain ↑(E_sm.presheaf.obj (Opposite.op W)) :=
            (hAffChartProps W hW hW_ne).1
          letI : IsDomain (Localization.AtPrime p.asIdeal) :=
            IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p.asIdeal)
          IsDiscreteValuationRing (Localization.AtPrime p.asIdeal) := by
        intro W hW hW_ne p hp_ne
        letI : IsDomain ↑(E_sm.presheaf.obj (Opposite.op W)) := (hAffChartProps W hW hW_ne).1
        letI : IsDomain (Localization.AtPrime p.asIdeal) :=
          IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p.asIdeal)
        let P := hW.fromSpec.base p
        have hP_cov : P ∈ ⋃ i : Fin (m_et + 1), (U_et i : Set E_sm) := by
          rw [hCov_et]; exact Set.mem_univ P
        obtain ⟨i, hPi⟩ := Set.mem_iUnion.mp hP_cov
        rw [← (hAff_et i).range_fromSpec] at hPi
        obtain ⟨p_i_pt, hp_i_eq⟩ := hPi
