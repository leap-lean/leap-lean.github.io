    have hClosedIrred_FΩ : ∀ i : Fin c, IsClosed (F_Ω i) ∧ IsIrreducible (F_Ω i) := by
      intro i
      have _ : AlgebraicGeometry.IsClosedImmersion (ι_ℰ i) := (hℰ_props i).2.2.1
      have _ : AlgebraicGeometry.IsClosedImmersion (ι_Ω i) := inferInstance
      have _ : AlgebraicGeometry.IsIntegral
