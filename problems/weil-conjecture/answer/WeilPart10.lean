        rw [Ideal.map_pow, hMapA]
      have hMap1 : Ideal.map (algebraMap A S) (m_A ^ (j + 1)) = m_S ^ (j + 1) := by
        rw [Ideal.map_pow, hMapA]
      let e₂ := tensorQuotIdealEquiv A S (m_A ^ (j + 2)) (m_S ^ (j + 2)) hMap2
      let e₁ := tensorQuotIdealEquiv A S (m_A ^ (j + 1)) (m_S ^ (j + 1)) hMap1
      have hComm : e₁.toLinearMap.comp (LinearMap.baseChange S π_A) = π_S.comp e₂.toLinearMap := by
        apply LinearMap.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | tmul s q =>
