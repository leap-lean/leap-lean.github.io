        · obtain ⟨hPrev1, hPrev2⟩ := hPrev_k i hlt
          have h_map_eq : ∀ {Ω : Type u} [Field Ω]
              (s_n : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
                AlgebraicGeometry.Spec (CommRingCat.of B_next)),
              s_n ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ_kn.comp ψ₂_k).comp ψ₁₂)) =
                (s_n ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_kn)) ≫
