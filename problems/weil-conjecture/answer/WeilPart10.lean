    exact hiff.mp hEt
  haveI : Algebra.FormallyEtale B'_12 D := by
    let r_W := AlgebraicGeometry.Scheme.Hom.resLE (𝟙 X') V'₁₂ W hW₁₂
    have hrW_comp : r_W ≫ V'₁₂.ι = W.ι :=
      (@AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ _ (𝟙 X') V'₁₂ W hW₁₂).trans
        (CategoryTheory.Category.comp_id W.ι)
    haveI : AlgebraicGeometry.IsOpenImmersion (r_W ≫ V'₁₂.ι) := by
      rw [hrW_comp]; infer_instance
    haveI : AlgebraicGeometry.IsOpenImmersion r_W :=
      AlgebraicGeometry.IsOpenImmersion.of_comp r_W V'₁₂.ι
    have hSpec_β : AlgebraicGeometry.Spec.map β_D =
        hAffW.isoSpec.inv ≫ r_W ≫ hAffV'₁₂.isoSpec.hom := by
      have hcomm : hAffW.isoSpec.hom ≫ AlgebraicGeometry.Spec.map β_D =
          r_W ≫ hAffV'₁₂.isoSpec.hom := by
        rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
          AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
        exact AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE (𝟙 X') V'₁₂ W hW₁₂
      calc AlgebraicGeometry.Spec.map β_D
          = (hAffW.isoSpec.inv ≫ hAffW.isoSpec.hom) ≫ AlgebraicGeometry.Spec.map β_D := by
            rw [hAffW.isoSpec.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = hAffW.isoSpec.inv ≫ (hAffW.isoSpec.hom ≫ AlgebraicGeometry.Spec.map β_D) :=
            CategoryTheory.Category.assoc _ _ _
        _ = hAffW.isoSpec.inv ≫ r_W ≫ hAffV'₁₂.isoSpec.hom := by rw [hcomm]
    have hOpen_β : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map β_D) := by
