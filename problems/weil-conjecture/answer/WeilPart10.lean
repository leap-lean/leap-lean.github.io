    refine ⟨hpP_max, hDiv_tP, fun b_tilde => ?_⟩
    obtain ⟨q_P, hq_P⟩ := hGenRP (KaehlerDifferential.D Ω R_P (algebraMap A R_P b_tilde))
    rw [hω₀_eq, smul_smul] at hq_P
    obtain ⟨⟨u_b, v_b⟩, huv_eq⟩ := IsLocalization.surj p_P.asIdeal.primeCompl (q_P * r₀_inv)
    have hRel_RP : algebraMap A R_P v_b.1 •
        KaehlerDifferential.D Ω R_P (algebraMap A R_P b_tilde) =
        algebraMap A R_P u_b • KaehlerDifferential.D Ω R_P (algebraMap A R_P t_P) := by
