            TensorProduct.tmul A b (1 : Ω) * LinearMap.lTensor B ι_P u_w := by
        intro b u_w
        induction u_w using TensorProduct.induction_on with
        | zero => simp
        | tmul x y => simp [Algebra.TensorProduct.tmul_mul_tmul]
        | add u₁ u₂ ih₁ ih₂ => simp [map_add, mul_add, ih₁, ih₂]
      apply hl_inj
      rw [map_zero]
      apply hΩ p (LinearMap.lTensor B ι_P w)
      intro b hb
      rw [← h_mul_compat b w, hw b hb, map_zero]
    let S_ideals : Set (Ideal A) :=
      {I : Ideal A | ∀ w : TensorProduct A B ↥I,
        (∀ b ∈ S_gen, LinearMap.rTensor ↥I (LinearMap.mulLeft A b) w = 0) → w = 0}
    have h_bot_all : ∀ w : TensorProduct A B ↥(⊥ : Ideal A), w = 0 := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => rfl
      | tmul x m =>
        have hm : m = 0 := Subtype.ext ((Submodule.mem_bot A).mp m.2)
        rw [hm, TensorProduct.tmul_zero]
      | add w₁ w₂ ih₁ ih₂ => rw [ih₁, ih₂, add_zero]
    have h_bot : (⊥ : Ideal A) ∈ S_ideals := fun w _ => h_bot_all w
    obtain ⟨I_max, hI_mem, hI_max⟩ :=
      set_has_maximal_iff_noetherian.mpr ‹IsNoetherianRing A› S_ideals ⟨⊥, h_bot⟩
    have hI_top : I_max = ⊤ := by
      by_contra h_ne_top
      have h_one_not_mem : (1 : A) ∉ I_max := by
        intro h1
        exact h_ne_top (eq_top_iff.mpr fun a _ => by simpa using Ideal.mul_mem_left I_max a h1)
      have : Nontrivial (A ⧸ I_max) :=
        ⟨⟨Submodule.Quotient.mk 1, 0, fun h10 =>
          h_one_not_mem ((Submodule.Quotient.mk_eq_zero I_max).mp h10)⟩⟩
      obtain ⟨P, hP_ass⟩ := associatedPrimes.nonempty A (A ⧸ I_max)
      change IsAssociatedPrime P (A ⧸ I_max) at hP_ass
      rw [isAssociatedPrime_iff] at hP_ass
      obtain ⟨hP_prime, x_bar, hP_colon⟩ := hP_ass
      obtain ⟨x₀, hx₀_mk⟩ := Submodule.Quotient.mk_surjective I_max x_bar
      have hx₀_not_mem : x₀ ∉ I_max := by
        intro hx₀
        have hx_zero : x_bar = 0 := by
          rw [← hx₀_mk]
          exact (Submodule.Quotient.mk_eq_zero I_max).mpr hx₀
        have h1_mem_P : (1 : A) ∈ P := by
          rw [hP_colon, Submodule.mem_colon_singleton, hx_zero, smul_zero]
          exact Submodule.zero_mem _
        exact hP_prime.ne_top
          (eq_top_iff.mpr fun a _ => by simpa using Ideal.mul_mem_left P a h1_mem_P)
      let J : Ideal A := I_max ⊔ Ideal.span ({x₀} : Set A)
      have hJ_lt : I_max < J := by
        refine lt_of_le_of_ne le_sup_left fun h_eq => hx₀_not_mem ?_
        rw [h_eq]
        exact Submodule.mem_sup_right (Ideal.subset_span (Set.mem_singleton x₀))
      let inc : ↥I_max →ₗ[A] ↥J := Submodule.inclusion le_sup_left
      let g₀ : A →ₗ[A] (A ⧸ I_max) := LinearMap.toSpanSingleton A (A ⧸ I_max) x_bar
      have hP_ker_g₀ : P = LinearMap.ker g₀ := by
        ext a
        rw [hP_colon, Submodule.mem_colon_singleton, LinearMap.mem_ker,
          LinearMap.toSpanSingleton_apply, Submodule.mem_bot]
      let f : (A ⧸ P) →ₗ[A] (A ⧸ I_max) := P.liftQ g₀ (le_of_eq hP_ker_g₀)
      have hf_inj : Function.Injective f := by
        intro x y hxy
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective P x
        obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective P y
        apply (Submodule.Quotient.eq P).mpr
        rw [hP_ker_g₀, LinearMap.mem_ker, map_sub, sub_eq_zero]
        exact hxy
      let q_J : ↥J →ₗ[A] (A ⧸ I_max) := I_max.mkQ.comp J.subtype
      have hq_range : ∀ y : ↥J, q_J y ∈ LinearMap.range f := by
        intro y
        rcases Submodule.mem_sup.mp y.2 with ⟨i_el, hi_el, s_el, hs_el, his_eq⟩
        rcases Ideal.mem_span_singleton.mp hs_el with ⟨a, rfl⟩
        refine ⟨P.mkQ a, ?_⟩
        have hq_val : q_J y = a • x_bar := by
          change Submodule.Quotient.mk y.1 = a • x_bar
          rw [← his_eq, Submodule.Quotient.mk_add,
            (Submodule.Quotient.mk_eq_zero I_max).mpr hi_el, zero_add, mul_comm x₀ a,
            ← smul_eq_mul, Submodule.Quotient.mk_smul, hx₀_mk]
        rw [hq_val]
        exact Submodule.liftQ_apply P g₀ a
      let π : ↥J →ₗ[A] (A ⧸ P) :=
        (LinearEquiv.ofInjective f hf_inj).symm.toLinearMap.comp
          (q_J.codRestrict (LinearMap.range f) hq_range)
      have hf_π : ∀ y : ↥J, f (π y) = q_J y := by
        intro y
        change ((LinearEquiv.ofInjective f hf_inj)
          ((LinearEquiv.ofInjective f hf_inj).symm ⟨q_J y, hq_range y⟩)).1 = q_J y
        rw [LinearEquiv.apply_symm_apply]
      have h_exact : Function.Exact inc π := by
        intro y
        constructor
        · intro hπy
          have hqy : q_J y = 0 := by rw [← hf_π y, hπy, map_zero]
          have hy_mem : y.1 ∈ I_max :=
            (Submodule.Quotient.mk_eq_zero I_max).mp hqy
          exact ⟨⟨y.1, hy_mem⟩, Subtype.ext rfl⟩
        · rintro ⟨x, rfl⟩
          apply hf_inj
          rw [map_zero, hf_π]
          exact (Submodule.Quotient.mk_eq_zero I_max).mpr x.2
      have h_exact_B : Function.Exact (LinearMap.lTensor B inc) (LinearMap.lTensor B π) :=
        Module.Flat.lTensor_exact B h_exact
      have h_inj_B : Function.Injective (LinearMap.lTensor B inc) :=
        Module.Flat.lTensor_preserves_injective_linearMap inc
          (Submodule.inclusion_injective le_sup_left)
      have hJ_mem : J ∈ S_ideals := by
        intro w hw
        have hπw : LinearMap.lTensor B π w = 0 := by
          apply hPrime P hP_prime
          intro b hb
          rw [← hNat π b w, hw b hb, map_zero]
        obtain ⟨w₀, rfl⟩ := (h_exact_B w).mp hπw
        have hw₀ : w₀ = 0 := by
          apply hI_mem w₀
          intro b hb
          apply h_inj_B
          rw [map_zero, hNat inc b w₀]
          exact hw b hb
        rw [hw₀, map_zero]
      exact hI_max J hJ_mem hJ_lt
    have hTop_mem : (⊤ : Ideal A) ∈ S_ideals := hI_top ▸ hI_mem
    let w_top : TensorProduct A B ↥(⊤ : Ideal A) :=
      z ⊗ₜ[A] (⟨1, Submodule.mem_top⟩ : ↥(⊤ : Ideal A))
    have hw_top_zero : w_top = 0 := by
      apply hTop_mem w_top
      intro b hb
      simp [w_top, hz b hb]
    let eval_top : TensorProduct A B ↥(⊤ : Ideal A) →ₗ[A] B :=
      (TensorProduct.rid A B).toLinearMap.comp (LinearMap.lTensor B (⊤ : Ideal A).subtype)
    have h_eval_w : eval_top w_top = z := by
      simp [eval_top, w_top]
    rw [← h_eval_w, hw_top_zero, map_zero]

theorem weil_scheme_smooth_curve_open_and_geomFiber_bridge (S C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ) :
    (∀ j : Fin n, IsClosed (Set.range (τ j).base)) ∧
    (∀ (W : C.Opens) (x : C),
      x ∈ W →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g) →
      ∃ (U₀ : S.Opens) (V₀ : C.Opens)
        (_ : AlgebraicGeometry.IsAffineOpen U₀)
        (_ : AlgebraicGeometry.IsAffineOpen V₀)
        (hV₀_le : V₀ ≤ (TopologicalSpace.Opens.map g.base).obj U₀)
        (k₀ : ℕ)
        (π₀ : MvPolynomial (Fin (k₀ + 1)) ↑(S.presheaf.obj (Opposite.op U₀)) →+*
          ↑(C.presheaf.obj (Opposite.op V₀)))
        (F₀ : Fin k₀ → MvPolynomial (Fin (k₀ + 1)) ↑(S.presheaf.obj (Opposite.op U₀))),
        x ∈ V₀ ∧
        V₀ ≤ W ∧
        π₀.comp MvPolynomial.C = (g.appLE U₀ V₀ hV₀_le).hom ∧
        Function.Surjective π₀ ∧
        RingHom.ker π₀ = Ideal.span (Set.range F₀) ∧
        IsUnit (Matrix.det ((Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
          π₀ (MvPolynomial.pderiv i (F₀ j))).submatrix (0 : Fin (k₀ + 1)).succAbove id))) ∧
    (∀ (U₀ : S.Opens) (V₀ : C.Opens),
      AlgebraicGeometry.IsAffineOpen U₀ →
      AlgebraicGeometry.IsAffineOpen V₀ →
      ∀ (hV₀_le : V₀ ≤ (TopologicalSpace.Opens.map g.base).obj U₀)
        (K : Type u) [Field K] [IsAlgClosed K]
        (φ_B : ↑(C.presheaf.obj (Opposite.op V₀)) →+* K),
        let A₀ := ↑(S.presheaf.obj (Opposite.op U₀))
        let B₀ := ↑(C.presheaf.obj (Opposite.op V₀))
        letI : Algebra A₀ B₀ := (g.appLE U₀ V₀ hV₀_le).hom.toAlgebra
        letI : Algebra A₀ K := (φ_B.comp (g.appLE U₀ V₀ hV₀_le).hom).toAlgebra
        let ev_K : B₀ →ₐ[A₀] K := ⟨φ_B, fun _ => rfl⟩
        let q_K : Ideal (TensorProduct A₀ K B₀) :=
          RingHom.ker (Algebra.TensorProduct.lift
            (AlgHom.id K K) ev_K (fun _ _ => mul_comm _ _)).toRingHom
        (∃ h_K : TensorProduct A₀ K B₀,
          h_K ∉ q_K ∧
          Algebra.IsStandardSmoothOfRelativeDimension 1 K (Localization.Away h_K)) ∨
        (∃ (A' : Type u) (instRingA' : CommRing A'),
          letI : CommRing A' := instRingA'
          ∃ (instAlgKA' : Algebra K A'),
            letI : Algebra K A' := instAlgKA'
            ∃ (u₀ : PrimeSpectrum A')
              (φ₁ : TensorProduct A₀ K B₀ →ₐ[K] A')
              (φ₂ : (MvPolynomial (Fin 2) K ⧸
                Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) *
                  (MvPolynomial.X 1 : MvPolynomial (Fin 2) K)}) →ₐ[K] A'),
              RingHom.Etale φ₁.toRingHom ∧
              RingHom.Etale φ₂.toRingHom ∧
              Ideal.comap φ₁.toRingHom u₀.asIdeal = q_K ∧
              ∀ i : Fin 2,
                φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K)) ∈
                  u₀.asIdeal)) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro j
    haveI : AlgebraicGeometry.IsProper g := hStab.2.2.1
    have hSec : τ j ≫ g = 𝟙 S := hStab.2.2.2.2.2.1 j
    haveI : AlgebraicGeometry.IsClosedImmersion (τ j ≫ g) := by
      rw [hSec]; infer_instance
    haveI : AlgebraicGeometry.IsClosedImmersion (τ j) :=
      AlgebraicGeometry.IsClosedImmersion.of_comp (τ j) g
    exact (τ j).isClosedEmbedding.isClosed_range
  · intro W x hxW hSm
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at hSm
    obtain ⟨U₀, hU₀, V_W, hV_W, hx_VW, e_VW, hStd_VW⟩ := hSm ⟨x, hxW⟩
    let V₀ : C.Opens := W.ι.opensFunctor.obj V_W
    have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hV_W.image_of_isOpenImmersion W.ι
    have hxV₀ : x ∈ V₀ := ⟨⟨x, hxW⟩, hx_VW, rfl⟩
    have hV₀_W : V₀ ≤ W := by
      rintro _ ⟨y, _, rfl⟩
      exact y.2
    have hV₀_le : V₀ ≤ (TopologicalSpace.Opens.map g.base).obj U₀ := by
      rintro _ ⟨y, hy, rfl⟩
      exact e_VW hy
    have hVW_V₀ : V_W ≤ (TopologicalSpace.Opens.map W.ι.base).obj V₀ :=
      fun y hy => ⟨y, hy, rfl⟩
    have hAppEq : (g.appLE U₀ V₀ hV₀_le).hom = ((W.ι ≫ g).appLE U₀ V_W e_VW).hom := by
      have hcomp := W.ι.appLE_comp_appLE g U₀ V₀ V_W hV₀_le hVW_V₀
      have hι : W.ι.appLE V₀ V_W hVW_V₀ = 𝟙 (C.presheaf.obj (Opposite.op V₀)) := by
        rw [AlgebraicGeometry.Scheme.Opens.ι_appLE, ← C.presheaf.map_id]
        exact congr_arg C.presheaf.map (Subsingleton.elim _ _)
      ext a
      have h1 := congr_arg (fun φ : C.presheaf.obj (Opposite.op V₀) ⟶
        C.presheaf.obj (Opposite.op V₀) => φ.hom ((g.appLE U₀ V₀ hV₀_le).hom a)) hι
      have h2 := congr_arg (fun φ => φ.hom a) hcomp
      exact h1.symm.trans h2
    let A₀ := ↑(S.presheaf.obj (Opposite.op U₀))
    let B₀ := ↑(C.presheaf.obj (Opposite.op V₀))
    have hStd_B₀ : RingHom.IsStandardSmoothOfRelativeDimension 1 (g.appLE U₀ V₀ hV₀_le).hom := by
      rwa [hAppEq]
    letI : Algebra A₀ B₀ := (g.appLE U₀ V₀ hV₀_le).hom.toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 A₀ B₀ := hStd_B₀.toAlgebra
    obtain ⟨ι, σ, hFinσ, hFinι, P, hdim⟩ :=
      Algebra.IsStandardSmoothOfRelativeDimension.out (n := 1) (R := A₀) (S := B₀)
    classical
    letI : Fintype σ := @Fintype.ofFinite σ hFinσ
    letI : Fintype ι := @Fintype.ofFinite ι hFinι
    let k₀ : ℕ := Fintype.card σ
    have hCard_ι : Fintype.card ι = k₀ + 1 := by
      have hd : Nat.card ι - Nat.card σ = 1 := hdim
      rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card] at hd
      omega
    let e_σ : Fin k₀ ≃ σ := (Fintype.equivFin σ).symm
    let S_im : Finset ι := Finset.univ.image P.map
    have hCard_im : S_im.card = k₀ := by
      rw [Finset.card_image_of_injective _ P.map_inj, Finset.card_univ]
    have hCard_sdiff : (Finset.univ \ S_im).card = 1 := by
      rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, hCard_ι, hCard_im]
      omega
    obtain ⟨i₀, hi₀_eq⟩ := Finset.card_eq_one.mp hCard_sdiff
    have hi₀ : ∀ s : σ, P.map s ≠ i₀ := by
      intro s hs
      have hmem : i₀ ∈ Finset.univ \ S_im := by
        rw [hi₀_eq]
        exact Finset.mem_singleton_self i₀
      rw [Finset.mem_sdiff] at hmem
      exact hmem.2 (Finset.mem_image.mpr ⟨s, Finset.mem_univ s, hs⟩)
    let f_ι : Fin (k₀ + 1) → ι := Fin.cases i₀ (fun r : Fin k₀ => P.map (e_σ r))
    have hf_inj : Function.Injective f_ι := by
      intro a b
      refine Fin.cases ?_ (fun r₁ => ?_) a
      · refine Fin.cases ?_ (fun r₂ => ?_) b
        · intro _; rfl
        · intro h
          simp only [f_ι, Fin.cases_zero, Fin.cases_succ] at h
          exact False.elim (hi₀ (e_σ r₂) h.symm)
      · refine Fin.cases ?_ (fun r₂ => ?_) b
        · intro h
          simp only [f_ι, Fin.cases_zero, Fin.cases_succ] at h
          exact False.elim (hi₀ (e_σ r₁) h)
        · intro h
          simp only [f_ι, Fin.cases_succ] at h
          exact congr_arg Fin.succ (e_σ.injective (P.map_inj h))
    have hf_bij : Function.Bijective f_ι :=
      (Fintype.bijective_iff_injective_and_card f_ι).mpr
        ⟨hf_inj, by rw [Fintype.card_fin, hCard_ι]⟩
    let e_ι : Fin (k₀ + 1) ≃ ι := Equiv.ofBijective f_ι hf_bij
    let P' : Algebra.SubmersivePresentation A₀ B₀ (Fin (k₀ + 1)) (Fin k₀) :=
      P.reindex e_ι e_σ
    have hP'_map : ∀ r : Fin k₀, P'.map r = (0 : Fin (k₀ + 1)).succAbove r := by
      intro r
      change (P.toPreSubmersivePresentation.reindex e_ι e_σ).map r = _
      rw [Algebra.PreSubmersivePresentation.reindex_map]
      simp only [Function.comp_apply, Fin.succAbove_zero]
      have he : e_ι r.succ = P.map (e_σ r) := by
        change f_ι r.succ = P.map (e_σ r)
        simp [f_ι]
      rw [← he, e_ι.symm_apply_apply]
    let π₀ : MvPolynomial (Fin (k₀ + 1)) A₀ →+* B₀ := (MvPolynomial.aeval P'.val).toRingHom
    let F₀ : Fin k₀ → MvPolynomial (Fin (k₀ + 1)) A₀ := P'.relation
    have hAlgMap : algebraMap P'.Ring B₀ = π₀ := RingHom.ext P'.algebraMap_apply
    refine ⟨U₀, V₀, hU₀, hV₀, hV₀_le, k₀, π₀, F₀, hxV₀, hV₀_W, ?_, ?_, ?_, ?_⟩
    · ext a
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C, π₀]
      rfl
    · exact P'.aeval_val_surjective
    · change RingHom.ker π₀ = Ideal.span (Set.range P'.relation)
      rw [← hAlgMap]
      exact P'.span_range_relation_eq_ker.symm
    · have hMat : ((Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
