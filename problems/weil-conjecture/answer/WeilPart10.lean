    have hq₀ : q_Q x₀ = 0 := congr_fun hvec_zero 1
    have hx₁_IQ : x₁ ∈ I_Q := Ideal.Quotient.eq_zero_iff_mem.mp hq₁
    have hx₀_IQ : x₀ ∈ I_Q := Ideal.Quotient.eq_zero_iff_mem.mp hq₀
    apply le_antisymm hIQ_le
    change IsLocalRing.maximalIdeal S ≤ I_Q
    rw [← hSpan, Ideal.span_le]
    rintro x (rfl | rfl)
    · exact hx₀_IQ
    · exact hx₁_IQ
  
  have h_s4 : ∀ (κ₀ K₀ O R S : Type u) [Field κ₀] [Field K₀]
      [CommRing O] [IsLocalRing O] [Algebra κ₀ O]
      [CommRing R] [IsLocalRing R] [Algebra K₀ R]
      [CommRing S] [IsLocalRing S]
      [Algebra O S] [IsLocalHom (algebraMap O S)] [Module.Flat O S]
      [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S],
      FiniteDimensional κ₀ (IsLocalRing.ResidueField O) →
      Function.Bijective (algebraMap K₀ (IsLocalRing.ResidueField R)) →
      Ideal.map (algebraMap O S) (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal S →
      Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S →
      (∀ m : ℕ, FiniteDimensional K₀ (R ⧸ (IsLocalRing.maximalIdeal R) ^ (m + 1))) →
      ∀ d : ℕ,
        Module.finrank κ₀ (O ⧸ (IsLocalRing.maximalIdeal O) ^ (d + 1)) =
        Module.finrank κ₀ (IsLocalRing.ResidueField O) *
          Module.finrank K₀ (R ⧸ (IsLocalRing.maximalIdeal R) ^ (d + 1)) := by
    intro κ K O R S _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hFinE hBijR hMapO hMapR hFinR
    let mkResMod : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (j : ℕ),
        Module (IsLocalRing.ResidueField B)
          ↥(LinearMap.ker (Submodule.factor
            (Ideal.pow_le_pow_right (Nat.le_succ (j + 1)) :
              (IsLocalRing.maximalIdeal B) ^ (j + 2) ≤ (IsLocalRing.maximalIdeal B) ^ (j + 1)))) :=
      fun B _ _ j =>
        let m_B := IsLocalRing.maximalIdeal B
        let π_B : (B ⧸ m_B ^ (j + 2)) →ₗ[B] (B ⧸ m_B ^ (j + 1)) :=
          Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ (j + 1)))
        let K_B := LinearMap.ker π_B
        have hmB_ann : ∀ b ∈ m_B, Module.toAddMonoidEnd B ↥K_B b = 0 := by
          intro b hb
          ext ⟨x, hx⟩
          change b • x = 0
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
          have hr : r ∈ m_B ^ (j + 1) := by
            rw [LinearMap.mem_ker] at hx
            exact Ideal.Quotient.eq_zero_iff_mem.mp hx
          change Ideal.Quotient.mk (m_B ^ (j + 2)) (b * r) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem, pow_succ']
          exact Ideal.mul_mem_mul hb hr
        let ρ_B : IsLocalRing.ResidueField B →+* AddMonoid.End ↥K_B :=
          Ideal.Quotient.lift m_B (Module.toAddMonoidEnd B ↥K_B) hmB_ann
        { smul := fun c x => ρ_B c x
          one_smul := fun x => by change ρ_B 1 x = x; rw [map_one]; rfl
          mul_smul := fun c d x => by change ρ_B (c * d) x = ρ_B c (ρ_B d x); rw [map_mul]; rfl
          smul_zero := fun c => map_zero (ρ_B c)
          smul_add := fun c x y => map_add (ρ_B c) x y
          add_smul := fun c d x => by change ρ_B (c + d) x = ρ_B c x + ρ_B d x; rw [map_add]; rfl
          zero_smul := fun x => by change ρ_B 0 x = 0; rw [map_zero]; rfl }
    have mkResTower : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (j : ℕ),
