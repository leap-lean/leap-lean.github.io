    have hOpen_α : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map α_R') := by
      rw [hSpec_α]; infer_instance
    haveI : Algebra.Etale R' A'_12 := RingHom.Etale.toAlgebra (hOpenToEtale α_R' hOpen_α)
