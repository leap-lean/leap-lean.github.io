    intro Ω _ s σ hσ_fst hσ_snd
    have hCl_σ : AlgebraicGeometry.IsClosedImmersion σ := by
      have : AlgebraicGeometry.IsClosedImmersion (σ ≫ CategoryTheory.Limits.pullback.snd g s) := by
