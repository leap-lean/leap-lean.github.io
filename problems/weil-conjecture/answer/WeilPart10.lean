        have : FiniteDimensional κ ↥(LinearMap.ker π_O_κ) := Module.Finite.equiv e_kerO
        have hπO_range : LinearMap.range π_O_κ = ⊤ := by
          rw [LinearMap.range_eq_top]
          intro y
          obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective (m_O ^ (d + 1)) y
          exact ⟨Submodule.Quotient.mk a, rfl⟩
        obtain ⟨sec, hsec⟩ := LinearMap.exists_rightInverse_of_surjective π_O_κ hπO_range
        let split_fwd : (O ⧸ m_O ^ (d + 2)) →ₗ[κ]
            ↥(LinearMap.ker π_O_κ) × (O ⧸ m_O ^ (d + 1)) :=
          { toFun := fun x =>
              ⟨⟨x - sec (π_O_κ x), by
                  rw [LinearMap.mem_ker, map_sub]
                  have h_id : π_O_κ (sec (π_O_κ x)) = π_O_κ x :=
                    LinearMap.congr_fun hsec (π_O_κ x)
                  rw [h_id, sub_self]⟩,
                π_O_κ x⟩
            map_add' := fun x y => by ext <;> simp [sub_add_sub_comm]
            map_smul' := fun c x => by ext <;> simp [smul_sub] }
        let split_bwd : (↥(LinearMap.ker π_O_κ) × (O ⧸ m_O ^ (d + 1))) →ₗ[κ]
            (O ⧸ m_O ^ (d + 2)) :=
          { toFun := fun p => p.1.1 + sec p.2
            map_add' := fun p q => by simp [add_add_add_comm]
            map_smul' := fun c p => by simp [smul_add] }
        let e_split : (O ⧸ m_O ^ (d + 2)) ≃ₗ[κ]
            ↥(LinearMap.ker π_O_κ) × (O ⧸ m_O ^ (d + 1)) :=
          LinearEquiv.ofLinearMap split_fwd split_bwd
            (by
              apply LinearMap.ext
              rintro ⟨⟨k, hk⟩, y⟩
              have hk0 : π_O_κ k = 0 := hk
              have hy : π_O_κ (sec y) = y := LinearMap.congr_fun hsec y
              ext
              · simp [split_fwd, split_bwd, hk0, hy]
              · simp [split_fwd, split_bwd, hk0, hy])
            (by
              apply LinearMap.ext
              intro x
              simp [split_fwd, split_bwd])
        have hFD_next : FiniteDimensional κ (O ⧸ m_O ^ (d + 2)) :=
          Module.Finite.equiv e_split.symm
        refine ⟨hFD_next, ?_⟩
        rw [LinearEquiv.finrank_eq e_split, Module.finrank_prod, ← LinearEquiv.finrank_eq e_kerO,
          hEq_ker, hEq_d, hAddR, mul_add, add_comm]
    exact fun d => (hInd d).2
  
