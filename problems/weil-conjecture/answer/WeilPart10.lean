            (Algebra.TensorProduct.includeRight
              (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j₂.1 : Set K))) (B := M₁))).commutes a)
      have h_incM₂_comm : f_M ≫ inc_M₂ = (mkAlpha M₁).app j₂ :=
        CommRingCat.Hom.ext (RingHom.ext fun a =>
          (Algebra.TensorProduct.includeRight
            (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j₂.1 : Set K))) (B := M₁)).commutes a)
      have h_vu₂_colim : comp_vu₂_M ≫ (mkC M₁).ι.app j₂ = inc_M₂ ≫ (mkC M₁).ι.app j₂ := by
        refine CommRingCat.Hom.ext (RingHom.ext fun m => ?_)
        have h1 := hLiftColim j₂ v₂_cat f_B (fun _ => rfl) hv₂_comm e_bar.symm.toAlgHom hv₂_eq
