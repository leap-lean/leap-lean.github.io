    have _ : AlgebraicGeometry.IsClosedImmersion ι_Ω_i := inferInstance
    have _ : AlgebraicGeometry.IsIntegral E_sch := hIntE
    have _ : AlgebraicGeometry.IsIntegral
        (CategoryTheory.Limits.pullback (ι_ℰ i)
          (CategoryTheory.Limits.pullback.fst g_B s_B)) := hInt_iΩ
    obtain ⟨e_red, he_red⟩ :=
      hUniqueRed ιE ι_Ω_i hClE inferInstance inferInstance inferInstance hRangeE
    have hP1_iΩ : ∃ isoP1 :
          CategoryTheory.Limits.pullback (ι_ℰ i)
            (CategoryTheory.Limits.pullback.fst g_B s_B) ≅
