import WeilPart09
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_domain_adjoin_spreadOut_standardSmooth_localization (B₀ K_bar : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
    [Field K_bar] [Algebra B₀ K_bar]
    (_hInj₀ : Function.Injective (algebraMap B₀ K_bar))
    (R : Type u) [CommRing R] [Algebra B₀ R] [Algebra.FinitePresentation B₀ R] :
    (∀ (f : TensorProduct B₀ K_bar R),
      RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap K_bar (Localization.Away f)) →
      ∃ (S_f : Finset K_bar)
        (f_S : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) R),
        (Algebra.TensorProduct.map
          (Algebra.adjoin B₀ (↑S_f : Set K_bar)).val
          (AlgHom.id B₀ R)) f_S = f ∧
        ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω]
          [Algebra ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) Ω]
          [IsScalarTower B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) Ω],
          let φ_SΩ : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) R →+*
              TensorProduct B₀ Ω R :=
            (Algebra.TensorProduct.map
              (IsScalarTower.toAlgHom B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) Ω)
              (AlgHom.id B₀ R)).toRingHom
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap Ω (Localization.Away (φ_SΩ f_S)))) ∧
    (∀ (S₁ : Finset K_bar)
       (U : TopologicalSpace.Opens
         (PrimeSpectrum (TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₁ : Set K_bar)) R))),
      (∀ q_bar : PrimeSpectrum (TensorProduct B₀ K_bar R),
        PrimeSpectrum.comap
          (Algebra.TensorProduct.map
            (Algebra.adjoin B₀ (↑S₁ : Set K_bar)).val
            (AlgHom.id B₀ R)).toRingHom q_bar ∈ U) →
      ∃ (S₂ : Finset K_bar) (hSub : S₁ ⊆ S₂),
        ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω]
          [Algebra ↥(Algebra.adjoin B₀ (↑S₂ : Set K_bar)) Ω]
          [IsScalarTower B₀ ↥(Algebra.adjoin B₀ (↑S₂ : Set K_bar)) Ω]
          (q_Ω : PrimeSpectrum (TensorProduct B₀ Ω R)),
          let inc₁₂ : ↥(Algebra.adjoin B₀ (↑S₁ : Set K_bar)) →ₐ[B₀]
              ↥(Algebra.adjoin B₀ (↑S₂ : Set K_bar)) :=
            Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))
          let ψ₁_Ω : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₁ : Set K_bar)) R →+*
              TensorProduct B₀ Ω R :=
            (Algebra.TensorProduct.map
              ((IsScalarTower.toAlgHom B₀ ↥(Algebra.adjoin B₀ (↑S₂ : Set K_bar)) Ω).comp inc₁₂)
              (AlgHom.id B₀ R)).toRingHom
          PrimeSpectrum.comap ψ₁_Ω q_Ω ∈ U) :=
by
  suffices hMain :
      ∀ (K : Type u) [CommRing K] [Algebra B₀ K],
        (∀ (f : TensorProduct B₀ K R),
          RingHom.IsStandardSmoothOfRelativeDimension 1 (algebraMap K (Localization.Away f)) →
          ∃ (S_f : Finset K)
            (f_S : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K)) R),
            (Algebra.TensorProduct.map
              (Algebra.adjoin B₀ (↑S_f : Set K)).val
              (AlgHom.id B₀ R)) f_S = f ∧
            ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω]
              [Algebra ↥(Algebra.adjoin B₀ (↑S_f : Set K)) Ω]
              [IsScalarTower B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K)) Ω],
              let φ_SΩ : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K)) R →+*
                  TensorProduct B₀ Ω R :=
                (Algebra.TensorProduct.map
                  (IsScalarTower.toAlgHom B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K)) Ω)
                  (AlgHom.id B₀ R)).toRingHom
              RingHom.IsStandardSmoothOfRelativeDimension 1
                (algebraMap Ω (Localization.Away (φ_SΩ f_S)))) ∧
        (∀ (S₁ : Finset K)
           (U : TopologicalSpace.Opens
             (PrimeSpectrum (TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) R))),
          (∀ q_bar : PrimeSpectrum (TensorProduct B₀ K R),
            PrimeSpectrum.comap
              (Algebra.TensorProduct.map
                (Algebra.adjoin B₀ (↑S₁ : Set K)).val
                (AlgHom.id B₀ R)).toRingHom q_bar ∈ U) →
          ∃ (S₂ : Finset K) (hSub : S₁ ⊆ S₂),
            ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω]
              [Algebra ↥(Algebra.adjoin B₀ (↑S₂ : Set K)) Ω]
              [IsScalarTower B₀ ↥(Algebra.adjoin B₀ (↑S₂ : Set K)) Ω]
              (q_Ω : PrimeSpectrum (TensorProduct B₀ Ω R)),
              let inc₁₂ : ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) →ₐ[B₀]
                  ↥(Algebra.adjoin B₀ (↑S₂ : Set K)) :=
                Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))
              let ψ₁_Ω : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) R →+*
                  TensorProduct B₀ Ω R :=
                (Algebra.TensorProduct.map
                  ((IsScalarTower.toAlgHom B₀ ↥(Algebra.adjoin B₀ (↑S₂ : Set K)) Ω).comp inc₁₂)
                  (AlgHom.id B₀ R)).toRingHom
              PrimeSpectrum.comap ψ₁_Ω q_Ω ∈ U) by
    exact hMain K_bar
  clear! K_bar
  intro K _ _
  letI : DecidableEq K := Classical.decEq K

  
  have hValToAlg : ∀ (A_sub : Subalgebra B₀ K),
      IsScalarTower.toAlgHom B₀ ↥A_sub K = A_sub.val :=
    fun _ => AlgHom.ext (fun _ => rfl)

  have hToAlgHom : ∀ {A_sub : Subalgebra B₀ K} {Ω : Type u} [CommRing Ω] [Algebra B₀ Ω]
      (ψ : ↥A_sub →ₐ[B₀] Ω),
      letI : Algebra ↥A_sub Ω := ψ.toRingHom.toAlgebra
      haveI : IsScalarTower B₀ ↥A_sub Ω :=
        IsScalarTower.of_algebraMap_eq (fun b => (ψ.commutes b).symm)
      @IsScalarTower.toAlgHom B₀ ↥A_sub Ω _ _ _ _ _ _ _ = ψ := by
    intro A_sub Ω _ _ ψ
    letI : Algebra ↥A_sub Ω := ψ.toRingHom.toAlgebra
    ext x
    exact congrFun (congrArg DFunLike.coe (RingHom.algebraMap_toAlgebra ψ.toRingHom)) x

  
  have hLift : ∀ (x : TensorProduct B₀ K R),
      ∃ (S₀ : Finset K) (x₀ : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₀ : Set K)) R),
        (Algebra.TensorProduct.map
          (Algebra.adjoin B₀ (↑S₀ : Set K)).val
          (AlgHom.id B₀ R)) x₀ = x := by
    intro x
    refine TensorProduct.inductionOn
      (motive := fun x =>
        ∃ (S₀ : Finset K) (x₀ : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₀ : Set K)) R),
          (Algebra.TensorProduct.map
            (Algebra.adjoin B₀ (↑S₀ : Set K)).val
            (AlgHom.id B₀ R)) x₀ = x)
      x ?_ ?_
    · intro k r
      exact ⟨{k},
        TensorProduct.tmul B₀
          (⟨k, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_singleton_self k))⟩ :
            ↥(Algebra.adjoin B₀ (↑({k} : Finset K) : Set K))) r,
        Algebra.TensorProduct.map_tmul _ _ _ _⟩
    · rintro y z ⟨S_y, y₀, hy₀⟩ ⟨S_z, z₀, hz₀⟩
      let inc_y : ↥(Algebra.adjoin B₀ (↑S_y : Set K)) →ₐ[B₀]
          ↥(Algebra.adjoin B₀ (↑(S_y ∪ S_z) : Set K)) :=
        Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr Finset.subset_union_left))
      let inc_z : ↥(Algebra.adjoin B₀ (↑S_z : Set K)) →ₐ[B₀]
          ↥(Algebra.adjoin B₀ (↑(S_y ∪ S_z) : Set K)) :=
        Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr Finset.subset_union_right))
      refine ⟨S_y ∪ S_z,
        Algebra.TensorProduct.map inc_y (AlgHom.id B₀ R) y₀ +
          Algebra.TensorProduct.map inc_z (AlgHom.id B₀ R) z₀, ?_⟩
      rw [map_add, ← AlgHom.comp_apply, ← AlgHom.comp_apply,
        ← Algebra.TensorProduct.map_comp, ← Algebra.TensorProduct.map_comp,
        AlgHom.comp_id,
        Subalgebra.val_comp_inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr Finset.subset_union_left)),
        Subalgebra.val_comp_inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr Finset.subset_union_right)),
        hy₀, hz₀]

  
  have hAwayFP : ∀ (A_base : Type u) [CommRing A_base] [Algebra B₀ A_base]
      (f_base : TensorProduct B₀ A_base R),
      Algebra.FinitePresentation A_base (Localization.Away f_base) := by
    intro A_base _ _ f_base
    exact Algebra.FinitePresentation.trans A_base
      (TensorProduct B₀ A_base R) (Localization.Away f_base)

  have hAwayBaseChange : ∀ (A_base : Type u) [CommRing A_base] [Algebra B₀ A_base]
      (f_base : TensorProduct B₀ A_base R)
      (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω] [Algebra A_base Ω] [IsScalarTower B₀ A_base Ω],
      let φ_Ω : TensorProduct B₀ A_base R →+* TensorProduct B₀ Ω R :=
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A_base Ω) (AlgHom.id B₀ R)).toRingHom
      Nonempty (TensorProduct A_base Ω (Localization.Away f_base) ≃ₐ[Ω]
        Localization.Away (φ_Ω f_base)) := by
    intro A_base _ _ f_base Ω _ _ _ _
    let D_base := TensorProduct B₀ A_base R
    let D_Ω := TensorProduct B₀ Ω R
    let φ_Ω : D_base →+* D_Ω :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A_base Ω) (AlgHom.id B₀ R)).toRingHom
    let L_base := Localization.Away f_base
    let L_Ω := Localization.Away (φ_Ω f_base)
    have hAlgD_base : ∀ a : A_base, algebraMap A_base D_base a = a ⊗ₜ[B₀] (1 : R) :=
      fun _ => rfl
    have hAlgD_Ω : ∀ ω : Ω, algebraMap Ω D_Ω ω = ω ⊗ₜ[B₀] (1 : R) :=
      fun _ => rfl
    haveI : IsScalarTower A_base Ω L_Ω :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        rw [IsScalarTower.algebraMap_apply A_base D_Ω L_Ω a,
          IsScalarTower.algebraMap_apply Ω D_Ω L_Ω]
        rfl)
    
    let g_ring : D_base →+* L_Ω := (algebraMap D_Ω L_Ω).comp φ_Ω
    have hg_unit : IsUnit (g_ring f_base) := IsLocalization.Away.algebraMap_isUnit (φ_Ω f_base)
    let ψ_ring : L_base →+* L_Ω := IsLocalization.Away.lift f_base hg_unit
    have hψ_eq : ∀ x : D_base, ψ_ring (algebraMap D_base L_base x) = algebraMap D_Ω L_Ω (φ_Ω x) :=
      fun x => IsLocalization.Away.lift_eq f_base hg_unit x
    let ψ_alg : L_base →ₐ[A_base] L_Ω :=
      { ψ_ring with
        commutes' := fun a => by
          change ψ_ring (algebraMap A_base L_base a) = algebraMap A_base L_Ω a
          rw [IsScalarTower.algebraMap_apply A_base D_base L_base a, hAlgD_base, hψ_eq,
            IsScalarTower.algebraMap_apply A_base D_Ω L_Ω a]
          rfl }
    let Φ : TensorProduct A_base Ω L_base →ₐ[Ω] L_Ω :=
      Algebra.TensorProduct.lift (Algebra.ofId Ω L_Ω) ψ_alg (fun _ _ => Commute.all _ _)
    
    let TP := TensorProduct A_base Ω L_base
    haveI : IsScalarTower B₀ Ω TP :=
      ⟨fun b ω z => by
        refine TensorProduct.inductionOn
          (motive := fun z => (b • ω) • z = b • (ω • z)) z ?_ ?_
        · intro ω' l
          change ((b • ω) • ω') ⊗ₜ[A_base] l = (b • (ω • ω')) ⊗ₜ[A_base] l
          rw [smul_assoc]
        · intro x y ihx ihy
          simp only [smul_add, ihx, ihy]⟩
    let g_R : R →ₐ[B₀] TP :=
      { toRingHom :=
          (Algebra.TensorProduct.includeRight (R := A_base) (A := Ω) (B := L_base)).toRingHom.comp
            ((algebraMap D_base L_base).comp
              (Algebra.TensorProduct.includeRight (R := B₀) (A := A_base) (B := R)).toRingHom)
        commutes' := fun b => by
          change (Algebra.TensorProduct.includeRight (R := A_base) (A := Ω) (B := L_base))
              (algebraMap D_base L_base
                ((Algebra.TensorProduct.includeRight (R := B₀) (A := A_base) (B := R))
                  (algebraMap B₀ R b))) =
            algebraMap B₀ TP b
          rw [(Algebra.TensorProduct.includeRight (R := B₀) (A := A_base) (B := R)).commutes b,
            Algebra.TensorProduct.algebraMap_apply, ← hAlgD_base,
            ← IsScalarTower.algebraMap_apply A_base D_base L_base,
            (Algebra.TensorProduct.includeRight (R := A_base) (A := Ω) (B := L_base)).commutes,
            Algebra.TensorProduct.algebraMap_apply, ← IsScalarTower.algebraMap_apply B₀ A_base Ω]
          rfl }
    let η_D : D_Ω →ₐ[Ω] TP :=
      Algebra.TensorProduct.lift (Algebra.ofId Ω TP) g_R (fun _ _ => Commute.all _ _)
    have hη_φ : ∀ x : D_base,
        η_D (φ_Ω x) = (1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base x := by
      intro x
      refine TensorProduct.inductionOn
        (motive := fun x => η_D (φ_Ω x) = (1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base x)
        x ?_ ?_
      · intro a r
        change η_D (algebraMap A_base Ω a ⊗ₜ[B₀] r) =
          (1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base (a ⊗ₜ[B₀] r)
        rw [Algebra.TensorProduct.lift_tmul]
        change (algebraMap A_base Ω a ⊗ₜ[A_base] (1 : L_base)) *
            ((1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base ((1 : A_base) ⊗ₜ[B₀] r)) =
          (1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base (a ⊗ₜ[B₀] r)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
          Algebra.algebraMap_eq_smul_one a, TensorProduct.smul_tmul,
          Algebra.smul_def, IsScalarTower.algebraMap_apply A_base D_base L_base a,
          hAlgD_base, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · intro y z ihy ihz
        rw [map_add, map_add, ihy, ihz, map_add, TensorProduct.tmul_add]
    have hη_unit : IsUnit (η_D.toRingHom (φ_Ω f_base)) := by
      change IsUnit (η_D (φ_Ω f_base))
      rw [hη_φ f_base]
      exact (IsLocalization.Away.algebraMap_isUnit f_base).map
        (Algebra.TensorProduct.includeRight (R := A_base) (A := Ω) (B := L_base)).toRingHom
    let Ψ_ring : L_Ω →+* TP := IsLocalization.Away.lift (φ_Ω f_base) hη_unit
    have hΨ_eq : ∀ y : D_Ω, Ψ_ring (algebraMap D_Ω L_Ω y) = η_D y :=
      fun y => IsLocalization.Away.lift_eq (φ_Ω f_base) hη_unit y
    let Ψ : L_Ω →ₐ[Ω] TP :=
      { Ψ_ring with
        commutes' := fun ω => by
          change Ψ_ring (algebraMap Ω L_Ω ω) = algebraMap Ω TP ω
          rw [IsScalarTower.algebraMap_apply Ω D_Ω L_Ω ω, hAlgD_Ω, hΨ_eq]
          exact η_D.commutes ω }
    have hΦΨ : Φ.comp Ψ = AlgHom.id Ω L_Ω := by
      apply AlgHom.coe_ringHom_injective
      refine IsLocalization.ringHom_ext (Submonoid.powers (φ_Ω f_base)) ?_
      refine RingHom.ext fun y => ?_
      change Φ (Ψ (algebraMap D_Ω L_Ω y)) = algebraMap D_Ω L_Ω y
      rw [show Ψ (algebraMap D_Ω L_Ω y) = η_D y from hΨ_eq y]
      refine TensorProduct.inductionOn
        (motive := fun y => Φ (η_D y) = algebraMap D_Ω L_Ω y)
        y ?_ ?_
      · intro ω r
        rw [Algebra.TensorProduct.lift_tmul, map_mul]
        change Φ (ω ⊗ₜ[A_base] (1 : L_base)) *
            Φ ((1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base ((1 : A_base) ⊗ₜ[B₀] r)) =
          algebraMap D_Ω L_Ω (ω ⊗ₜ[B₀] r)
        rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul,
          Algebra.ofId_apply, map_one, mul_one, map_one, one_mul]
        change algebraMap Ω L_Ω ω *
            ψ_ring (algebraMap D_base L_base ((1 : A_base) ⊗ₜ[B₀] r)) =
          algebraMap D_Ω L_Ω (ω ⊗ₜ[B₀] r)
        rw [hψ_eq, IsScalarTower.algebraMap_apply Ω D_Ω L_Ω ω,
          hAlgD_Ω, ← map_mul]
        congr 1
        change (ω ⊗ₜ[B₀] (1 : R)) *
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A_base Ω) (AlgHom.id B₀ R))
              ((1 : A_base) ⊗ₜ[B₀] r) = ω ⊗ₜ[B₀] r
        rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · intro u v ihu ihv
        rw [map_add, map_add, map_add, ihu, ihv]
    have hΨΦ : Ψ.comp Φ = AlgHom.id Ω TP := by
      apply Algebra.TensorProduct.ext
      · ext
      · apply AlgHom.coe_ringHom_injective
        refine IsLocalization.ringHom_ext (Submonoid.powers f_base) ?_
        refine RingHom.ext fun x => ?_
        change Ψ (Φ ((1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base x)) =
          (1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base x
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        change Ψ (ψ_ring (algebraMap D_base L_base x)) =
          (1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base x
        rw [hψ_eq]
        change Ψ_ring (algebraMap D_Ω L_Ω (φ_Ω x)) =
          (1 : Ω) ⊗ₜ[A_base] algebraMap D_base L_base x
        rw [hΨ_eq, hη_φ]
    exact ⟨AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ⟩

  
  have hColimEngine :
      ∀ (S₁ : Finset K),
        (∀ (M₁ B₁ : Type u) [CommRing M₁] [CommRing B₁]
           [Algebra ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) M₁]
           [Algebra ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) B₁]
           [Algebra.FinitePresentation ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) M₁]
           [Algebra.FinitePresentation ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) B₁],
          Nonempty (TensorProduct ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) K M₁ ≃ₐ[K]
            TensorProduct ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) K B₁) →
          ∃ (S₂ : Finset K) (hSub : S₁ ⊆ S₂),
            ∀ (Ω : Type u) [CommRing Ω]
              [Algebra ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) Ω]
              [Algebra ↥(Algebra.adjoin B₀ (↑S₂ : Set K)) Ω],
              (∀ x : ↥(Algebra.adjoin B₀ (↑S₁ : Set K)),
                algebraMap ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) Ω x =
                algebraMap ↥(Algebra.adjoin B₀ (↑S₂ : Set K)) Ω
                  (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub)) x)) →
              Nonempty (TensorProduct ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) Ω M₁ ≃ₐ[Ω]
                TensorProduct ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) Ω B₁)) ∧
        (∀ (δ : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) R),
          (Algebra.TensorProduct.map (Algebra.adjoin B₀ (↑S₁ : Set K)).val (AlgHom.id B₀ R)) δ = 0 →
          ∃ (S₂ : Finset K) (hSub : S₁ ⊆ S₂),
            (Algebra.TensorProduct.map
              (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub)))
              (AlgHom.id B₀ R)) δ = 0) := by
    intro S₁
    let A₁ := ↥(Algebra.adjoin B₀ (↑S₁ : Set K))
    let J : Type u := {S : Finset K // S₁ ⊆ S}
    letI : SemilatticeSup J :=
      { (inferInstance : PartialOrder J) with
        sup := fun j₁ j₂ => ⟨j₁.1 ∪ j₂.1, j₁.2.trans Finset.subset_union_left⟩
        le_sup_left := fun _ _ => Finset.subset_union_left
        le_sup_right := fun _ _ => Finset.subset_union_right
        sup_le := fun _ _ _ h₁ h₂ => Finset.union_subset h₁ h₂ }
    let j₀ : J := ⟨S₁, Finset.Subset.refl S₁⟩
    haveI : Nonempty J := ⟨j₀⟩
    haveI : CategoryTheory.IsFiltered J :=
      CategoryTheory.isFiltered_of_semilatticeSup_nonempty J
    haveI : Limits.PreservesFilteredColimits (CategoryTheory.forget CommRingCat.{u}) :=
      CommRingCat.FilteredColimits.forget_preservesFilteredColimits
    let algJ : ∀ j : J, Algebra A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) :=
      fun j => (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr j.2))).toRingHom.toAlgebra
    letI : ∀ j : J, Algebra A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) := algJ
    let incA₁ : ∀ {j₁ j₂ : J}, j₁ ≤ j₂ →
        ↥(Algebra.adjoin B₀ (↑j₁.1 : Set K)) →ₐ[A₁] ↥(Algebra.adjoin B₀ (↑j₂.1 : Set K)) :=
      fun {j₁ j₂} h =>
        { (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h))).toRingHom with
          commutes' := fun a =>
            Subalgebra.inclusion_inclusion
              (Algebra.adjoin_mono (Finset.coe_subset.mpr j₁.2))
              (Algebra.adjoin_mono (Finset.coe_subset.mpr h)) a }
    let valA₁ : ∀ j : J, ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) →ₐ[A₁] K :=
      fun j =>
        { (Algebra.adjoin B₀ (↑j.1 : Set K)).val.toRingHom with
          commutes' := fun a =>
            AlgHom.congr_fun
              (Subalgebra.val_comp_inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr j.2))) a }
    let F_base : J ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of ↥(Algebra.adjoin B₀ (↑j.1 : Set K))
        map := fun {j₁ j₂} f =>
          CommRingCat.ofHom
            (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom f)))).toRingHom
        map_id := fun _ => CommRingCat.Hom.ext (RingHom.ext fun _ => rfl)
        map_comp := fun {j₁ j₂ j₃} f g =>
          CommRingCat.Hom.ext (RingHom.ext fun x =>
            (Subalgebra.inclusion_inclusion
              (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom f)))
              (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom g))) x).symm) }
    let c_base : Limits.Cocone F_base :=
      { pt := CommRingCat.of K
        ι :=
          { app := fun j => CommRingCat.ofHom (Algebra.adjoin B₀ (↑j.1 : Set K)).val.toRingHom
            naturality := fun {j₁ j₂} f => by
              simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
              exact CommRingCat.Hom.ext (RingHom.ext fun x =>
                AlgHom.congr_fun
                  (Subalgebra.val_comp_inclusion
                    (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom f)))) x) } }
    have hc_base_nonempty : Nonempty (Limits.IsColimit c_base) := by
      have hc_types : Limits.IsColimit ((CategoryTheory.forget CommRingCat.{u}).mapCocone c_base) := by
        refine Limits.Types.FilteredColimit.isColimitOf'
          (F_base ⋙ CategoryTheory.forget CommRingCat.{u})
          ((CategoryTheory.forget CommRingCat.{u}).mapCocone c_base) ?_ ?_
        · intro x
          exact ⟨⟨S₁ ∪ {x}, Finset.subset_union_left⟩,
            ⟨x, Algebra.subset_adjoin
              (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_singleton_self x)))⟩,
            rfl⟩
        · intro j x y hxy
          refine ⟨j, 𝟙 j, ?_⟩
          rw [Subtype.ext hxy]
      haveI : Limits.ReflectsColimit F_base (CategoryTheory.forget CommRingCat.{u}) :=
        Limits.reflectsColimit_of_reflectsIsomorphisms F_base (CategoryTheory.forget CommRingCat.{u})
      exact ⟨Limits.isColimitOfReflects (CategoryTheory.forget CommRingCat.{u}) hc_types⟩
    obtain ⟨hc_base⟩ := hc_base_nonempty

    let mkF : ∀ (N : Type u) [CommRing N] [Algebra A₁ N], J ⥤ CommRingCat.{u} :=
      fun N _ _ =>
        { obj := fun j => CommRingCat.of (TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) N)
          map := fun {j₁ j₂} f =>
            CommRingCat.ofHom
              (Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ N)).toRingHom
          map_id := fun j => by
            refine CommRingCat.Hom.ext (RingHom.ext fun z => ?_)
            have h_id : incA₁ (le_refl j) = AlgHom.id A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) :=
              AlgHom.ext (fun _ => rfl)
            change (Algebra.TensorProduct.map (incA₁ (le_refl j)) (AlgHom.id A₁ N)) z = z
            rw [h_id, Algebra.TensorProduct.map_id, AlgHom.id_apply]
          map_comp := fun {j₁ j₂ j₃} f g => by
            refine CommRingCat.Hom.ext (RingHom.ext fun z => ?_)
            have h_comp : (incA₁ (leOfHom g)).comp (incA₁ (leOfHom f)) =
                incA₁ ((leOfHom f).trans (leOfHom g)) :=
              AlgHom.ext (fun x =>
                Subalgebra.inclusion_inclusion
                  (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom f)))
                  (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom g))) x)
            change (Algebra.TensorProduct.map (incA₁ ((leOfHom f).trans (leOfHom g)))
                (AlgHom.id A₁ N)) z =
              (Algebra.TensorProduct.map (incA₁ (leOfHom g)) (AlgHom.id A₁ N))
                ((Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ N)) z)
            rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, AlgHom.comp_id, h_comp] }

    let mkAlpha : ∀ (N : Type u) [CommRing N] [Algebra A₁ N],
        (Functor.const J).obj (CommRingCat.of A₁) ⟶ mkF N :=
      fun N _ _ =>
        { app := fun j =>
            CommRingCat.ofHom (algebraMap A₁ (TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) N))
          naturality := fun {j₁ j₂} f => by
            simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp]
            exact CommRingCat.Hom.ext (RingHom.ext fun a =>
              ((Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ N)).commutes a).symm) }

    let mkC : ∀ (N : Type u) [CommRing N] [Algebra A₁ N], Limits.Cocone (mkF N) :=
      fun N _ _ =>
        { pt := CommRingCat.of (TensorProduct A₁ K N)
          ι :=
            { app := fun j =>
                CommRingCat.ofHom
                  (Algebra.TensorProduct.map (valA₁ j) (AlgHom.id A₁ N)).toRingHom
              naturality := fun {j₁ j₂} f => by
                simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
                refine CommRingCat.Hom.ext (RingHom.ext fun z => ?_)
                have h_val : (valA₁ j₂).comp (incA₁ (leOfHom f)) = valA₁ j₁ :=
                  AlgHom.ext (fun x =>
                    AlgHom.congr_fun
                      (Subalgebra.val_comp_inclusion
                        (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom f)))) x)
                change (Algebra.TensorProduct.map (valA₁ j₂) (AlgHom.id A₁ N))
                    ((Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ N)) z) =
                  (Algebra.TensorProduct.map (valA₁ j₁) (AlgHom.id A₁ N)) z
                rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, AlgHom.comp_id, h_val] } }

    have hIsColim : ∀ (N : Type u) [CommRing N] [Algebra A₁ N],
        Nonempty (Limits.IsColimit (mkC N)) := by
      intro N _ _
      let mkLeftCocone : Limits.Cocone (mkF N) → Limits.Cocone F_base := fun s =>
        { pt := s.pt
          ι :=
            { app := fun j =>
                CommRingCat.ofHom
                  (Algebra.TensorProduct.includeLeftRingHom
                    (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j.1 : Set K))) (B := N)) ≫ s.ι.app j
              naturality := fun {j₁ j₂} f => by
                simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
                rw [← Category.assoc, ← s.w f, ← Category.assoc]
                congr 1 } }
      have hExDesc : ∀ s : Limits.Cocone (mkF N),
          ∃ f : TensorProduct A₁ K N →+* ↥s.pt,
            ∀ (k : K) (n : N),
              f (k ⊗ₜ[A₁] n) =
                (show ↥s.pt from (hc_base.desc (mkLeftCocone s)).hom k) *
                  (show ↥s.pt from (s.ι.app j₀).hom
                    ((1 : ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) ⊗ₜ[A₁] n)) := by
        intro s
        let s_left := mkLeftCocone s
        let φ_K : K →+* ↥s.pt := (hc_base.desc s_left).hom
        let φ_N : N →+* ↥s.pt :=
          (s.ι.app j₀).hom.comp
            (Algebra.TensorProduct.includeRight
              (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) (B := N)).toRingHom
        letI : Algebra K ↥s.pt := φ_K.toAlgebra
        let φ_N_alg : N →ₐ[A₁] ↥s.pt :=
          { φ_N with
            commutes' := fun a => by
              change (s.ι.app j₀).hom
                  ((1 : ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) ⊗ₜ[A₁] algebraMap A₁ N a) =
                φ_K (algebraMap A₁ K a)
              have h_fac := CommRingCat.Hom.ext_iff.mp (hc_base.fac s_left j₀)
              have ha_K : φ_K (algebraMap A₁ K a) =
                  (s.ι.app j₀).hom ((a : ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) ⊗ₜ[A₁] (1 : N)) :=
                congrFun (congrArg DFunLike.coe h_fac) a
              rw [ha_K]
              congr 1
              exact ((Algebra.TensorProduct.includeRight
                (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) (B := N)).commutes a).trans
                (Algebra.TensorProduct.algebraMap_apply a) }
        refine ⟨(Algebra.TensorProduct.lift (Algebra.ofId K ↥s.pt) φ_N_alg
          (fun _ _ => Commute.all _ _)).toRingHom, fun k n => ?_⟩
        exact Algebra.TensorProduct.lift_tmul (Algebra.ofId K ↥s.pt) φ_N_alg
          (fun _ _ => Commute.all _ _) k n
      choose descHom hDescTmul using hExDesc
      refine ⟨{
        desc := fun s => CommRingCat.ofHom (descHom s)
        fac := fun s j => by
          let s_left := mkLeftCocone s
          let φ_K : K →+* ↥s.pt := (hc_base.desc s_left).hom
          let φ_N : N →+* ↥s.pt :=
            (s.ι.app j₀).hom.comp
              (Algebra.TensorProduct.includeRight
                (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) (B := N)).toRingHom
          refine CommRingCat.Hom.ext (RingHom.ext fun z => ?_)
          refine TensorProduct.inductionOn
            (motive := fun z => descHom s (((mkC N).ι.app j).hom z) = (s.ι.app j).hom z)
            z ?_ ?_
          · intro b n
            have h_left : φ_K b.1 = (s.ι.app j).hom (b ⊗ₜ[A₁] (1 : N)) :=
              congrFun (congrArg DFunLike.coe
                (CommRingCat.Hom.ext_iff.mp (hc_base.fac s_left j))) b
            have h_right : φ_N n =
                (s.ι.app j).hom ((1 : ↥(Algebra.adjoin B₀ (↑j.1 : Set K))) ⊗ₜ[A₁] n) :=
              (congrFun (congrArg DFunLike.coe
                (CommRingCat.Hom.ext_iff.mp (s.w (homOfLE j.2))))
                ((1 : ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) ⊗ₜ[A₁] n)).symm
            change descHom s (b.1 ⊗ₜ[A₁] n) = (s.ι.app j).hom (b ⊗ₜ[A₁] n)
            rw [hDescTmul s b.1 n]
            change φ_K b.1 * φ_N n = (s.ι.app j).hom (b ⊗ₜ[A₁] n)
            rw [h_left, h_right, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          · intro x y ihx ihy
            rw [map_add, map_add, map_add, ihx, ihy]
        uniq := fun s m hm => by
          let s_left := mkLeftCocone s
          let φ_K : K →+* ↥s.pt := (hc_base.desc s_left).hom
          let φ_N : N →+* ↥s.pt :=
            (s.ι.app j₀).hom.comp
              (Algebra.TensorProduct.includeRight
                (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) (B := N)).toRingHom
          have hm_left :
              CommRingCat.ofHom
                (Algebra.TensorProduct.includeLeftRingHom (R := A₁) (A := K) (B := N)) ≫ m =
              hc_base.desc s_left := by
            refine hc_base.uniq s_left _ (fun j => ?_)
            have h_comm :
                c_base.ι.app j ≫
                  CommRingCat.ofHom
                    (Algebra.TensorProduct.includeLeftRingHom (R := A₁) (A := K) (B := N)) =
                CommRingCat.ofHom
                    (Algebra.TensorProduct.includeLeftRingHom
                      (R := A₁) (A := ↥(Algebra.adjoin B₀ (↑j.1 : Set K))) (B := N)) ≫
                  (mkC N).ι.app j :=
              CommRingCat.Hom.ext (RingHom.ext fun _ => rfl)
            rw [← Category.assoc, h_comm, Category.assoc, hm j]
          refine CommRingCat.Hom.ext (RingHom.ext fun z => ?_)
          refine TensorProduct.inductionOn
            (motive := fun z => m.hom z = descHom s z)
            z ?_ ?_
          · intro k n
            have hk : m.hom (k ⊗ₜ[A₁] (1 : N)) = φ_K k :=
              congrFun (congrArg DFunLike.coe (CommRingCat.Hom.ext_iff.mp hm_left)) k
            have hn : m.hom ((1 : K) ⊗ₜ[A₁] n) = φ_N n :=
              congrFun (congrArg DFunLike.coe (CommRingCat.Hom.ext_iff.mp (hm j₀)))
                ((1 : ↥(Algebra.adjoin B₀ (↑j₀.1 : Set K))) ⊗ₜ[A₁] n)
            have h_split : (k ⊗ₜ[A₁] n : TensorProduct A₁ K N) =
                (k ⊗ₜ[A₁] (1 : N)) * ((1 : K) ⊗ₜ[A₁] n) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            rw [hDescTmul s k n]
            change m.hom (k ⊗ₜ[A₁] n) = φ_K k * φ_N n
            rw [h_split, map_mul, hk, hn]
          · intro x y ihx ihy
            rw [map_add, map_add, ihx, ihy] }⟩

    refine ⟨?_, ?_⟩
    · 
      intro M₁ B₁ _ _ _ _ _ _ ⟨e_bar⟩
      obtain ⟨hc_M⟩ := hIsColim M₁
      obtain ⟨hc_B⟩ := hIsColim B₁
      let f_M : CommRingCat.of A₁ ⟶ CommRingCat.of M₁ := CommRingCat.ofHom (algebraMap A₁ M₁)
      let f_B : CommRingCat.of A₁ ⟶ CommRingCat.of B₁ := CommRingCat.ofHom (algebraMap A₁ B₁)
      have hFP_M : f_M.hom.FinitePresentation := RingHom.finitePresentation_algebraMap.mpr inferInstance
      have hFP_B : f_B.hom.FinitePresentation := RingHom.finitePresentation_algebraMap.mpr inferInstance
      have hEFT_M : f_M.hom.EssFiniteType := (RingHom.FiniteType.of_finitePresentation hFP_M).essFiniteType
      have hEFT_B : f_B.hom.EssFiniteType := (RingHom.FiniteType.of_finitePresentation hFP_B).essFiniteType

      
      let liftAt : ∀ (j : J) {P Q : Type u} [CommRing P] [CommRing Q] [Algebra A₁ P] [Algebra A₁ Q]
          (w : CommRingCat.of P ⟶ (mkF Q).obj j)
          (f_P : CommRingCat.of A₁ ⟶ CommRingCat.of P),
          (∀ a : A₁, f_P.hom a = algebraMap A₁ P a) →
          f_P ≫ w = (mkAlpha Q).app j →
          TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) P →ₐ[↥(Algebra.adjoin B₀ (↑j.1 : Set K))]
            TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) Q :=
        fun j {P Q} _ _ _ _ w f_P hf_P hw =>
          let w_alg : P →ₐ[A₁] TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) Q :=
            { w.hom with
              commutes' := fun a => by
                have h := congrFun (congrArg DFunLike.coe (CommRingCat.Hom.ext_iff.mp hw)) a
                change w.hom (algebraMap A₁ P a) = algebraMap A₁ _ a
                rw [← hf_P a]
                exact h }
          Algebra.TensorProduct.lift
            (Algebra.TensorProduct.includeLeft
              (R := A₁) (S := ↥(Algebra.adjoin B₀ (↑j.1 : Set K)))
              (A := ↥(Algebra.adjoin B₀ (↑j.1 : Set K))) (B := Q))
            w_alg (fun _ _ => Commute.all _ _)

      have hLiftNat : ∀ {j₁ j₂ : J} (f : j₁ ⟶ j₂)
          {P Q : Type u} [CommRing P] [CommRing Q] [Algebra A₁ P] [Algebra A₁ Q]
          (w₁ : CommRingCat.of P ⟶ (mkF Q).obj j₁)
          (f_P : CommRingCat.of A₁ ⟶ CommRingCat.of P)
          (hf_P : ∀ a : A₁, f_P.hom a = algebraMap A₁ P a)
          (hw₁ : f_P ≫ w₁ = (mkAlpha Q).app j₁)
          (hw₂ : f_P ≫ (w₁ ≫ (mkF Q).map f) = (mkAlpha Q).app j₂)
          (z : TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j₁.1 : Set K)) P),
          (Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ Q))
            (liftAt j₁ w₁ f_P hf_P hw₁ z) =
          liftAt j₂ (w₁ ≫ (mkF Q).map f) f_P hf_P hw₂
            ((Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ P)) z) := by
        intro j₁ j₂ f P Q _ _ _ _ w₁ f_P hf_P hw₁ hw₂ z
        refine TensorProduct.inductionOn
          (motive := fun z =>
            (Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ Q))
              (liftAt j₁ w₁ f_P hf_P hw₁ z) =
            liftAt j₂ (w₁ ≫ (mkF Q).map f) f_P hf_P hw₂
              ((Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ P)) z))
          z ?_ ?_
        · intro b p
          rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
          change (Algebra.TensorProduct.map (incA₁ (leOfHom f)) (AlgHom.id A₁ Q))
              ((b ⊗ₜ[A₁] (1 : Q)) * w₁.hom p) =
            (incA₁ (leOfHom f) b ⊗ₜ[A₁] (1 : Q)) * ((w₁ ≫ (mkF Q).map f).hom p)
          rw [map_mul, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
          rfl
        · intro x y ihx ihy
          rw [map_add, map_add, ihx, ihy, map_add, map_add]

      have hLiftColim : ∀ (j : J)
          {P Q : Type u} [CommRing P] [CommRing Q] [Algebra A₁ P] [Algebra A₁ Q]
          (w : CommRingCat.of P ⟶ (mkF Q).obj j)
          (f_P : CommRingCat.of A₁ ⟶ CommRingCat.of P)
          (hf_P : ∀ a : A₁, f_P.hom a = algebraMap A₁ P a)
          (hw : f_P ≫ w = (mkAlpha Q).app j)
          (e : TensorProduct A₁ K P →ₐ[K] TensorProduct A₁ K Q)
          (hw_colim : w ≫ (mkC Q).ι.app j =
            CommRingCat.ofHom
              ((e.restrictScalars A₁).comp
                (Algebra.TensorProduct.includeRight (R := A₁) (A := K) (B := P))).toRingHom)
          (z : TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j.1 : Set K)) P),
          (Algebra.TensorProduct.map (valA₁ j) (AlgHom.id A₁ Q))
            (liftAt j w f_P hf_P hw z) =
          e ((Algebra.TensorProduct.map (valA₁ j) (AlgHom.id A₁ P)) z) := by
        intro j P Q _ _ _ _ w f_P hf_P hw e hw_colim z
        refine TensorProduct.inductionOn
          (motive := fun z =>
            (Algebra.TensorProduct.map (valA₁ j) (AlgHom.id A₁ Q))
              (liftAt j w f_P hf_P hw z) =
            e ((Algebra.TensorProduct.map (valA₁ j) (AlgHom.id A₁ P)) z))
          z ?_ ?_
        · intro b p
          have hp :
              (Algebra.TensorProduct.map (valA₁ j) (AlgHom.id A₁ Q)) (w.hom p) =
              e ((1 : K) ⊗ₜ[A₁] p) :=
            congrFun (congrArg DFunLike.coe (CommRingCat.Hom.ext_iff.mp hw_colim)) p
          change (Algebra.TensorProduct.map (valA₁ j) (AlgHom.id A₁ Q))
              ((b ⊗ₜ[A₁] (1 : Q)) * w.hom p) =
            e (valA₁ j b ⊗ₜ[A₁] p)
          rw [map_mul, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hp]
          change algebraMap K (TensorProduct A₁ K Q) (valA₁ j b) * e ((1 : K) ⊗ₜ[A₁] p) =
            e (valA₁ j b ⊗ₜ[A₁] p)
          rw [← e.commutes (valA₁ j b), ← map_mul]
          congr 1
          change (valA₁ j b ⊗ₜ[A₁] (1 : P)) * ((1 : K) ⊗ₜ[A₁] p) = valA₁ j b ⊗ₜ[A₁] p
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        · intro x y ihx ihy
          rw [map_add, map_add, ihx, ihy, map_add, map_add]

      
      let g_fwd : CommRingCat.of M₁ ⟶ (mkC B₁).pt :=
        CommRingCat.ofHom
          ((e_bar.toAlgHom.restrictScalars A₁).comp
            (Algebra.TensorProduct.includeRight (R := A₁) (A := K) (B := M₁))).toRingHom
      have hg_fwd_comm : ∀ i : J, f_M ≫ g_fwd = (mkAlpha B₁).app i ≫ (mkC B₁).ι.app i := by
        intro i
        refine CommRingCat.Hom.ext (RingHom.ext fun a => ?_)
        have h1 : g_fwd.hom (algebraMap A₁ M₁ a) = algebraMap A₁ (TensorProduct A₁ K B₁) a :=
          ((e_bar.toAlgHom.restrictScalars A₁).comp
            (Algebra.TensorProduct.includeRight (R := A₁) (A := K) (B := M₁))).commutes a
        have h2 : ((mkC B₁).ι.app i).hom (algebraMap A₁ _ a) =
            algebraMap A₁ (TensorProduct A₁ K B₁) a :=
          (Algebra.TensorProduct.map (valA₁ i) (AlgHom.id A₁ B₁)).commutes a
        exact h1.trans h2.symm
      obtain ⟨j_a, u_a_cat, hu_a_comm, hu_a_eq⟩ :=
        RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          (CommRingCat.of A₁) (mkF B₁) (mkAlpha B₁) f_M (mkC B₁) hc_B hFP_M g_fwd hg_fwd_comm

      
      let g_inv : CommRingCat.of B₁ ⟶ (mkC M₁).pt :=
        CommRingCat.ofHom
          ((e_bar.symm.toAlgHom.restrictScalars A₁).comp
            (Algebra.TensorProduct.includeRight (R := A₁) (A := K) (B := B₁))).toRingHom
      have hg_inv_comm : ∀ i : J, f_B ≫ g_inv = (mkAlpha M₁).app i ≫ (mkC M₁).ι.app i := by
        intro i
        refine CommRingCat.Hom.ext (RingHom.ext fun a => ?_)
        have h1 : g_inv.hom (algebraMap A₁ B₁ a) = algebraMap A₁ (TensorProduct A₁ K M₁) a :=
          ((e_bar.symm.toAlgHom.restrictScalars A₁).comp
            (Algebra.TensorProduct.includeRight (R := A₁) (A := K) (B := B₁))).commutes a
        have h2 : ((mkC M₁).ι.app i).hom (algebraMap A₁ _ a) =
            algebraMap A₁ (TensorProduct A₁ K M₁) a :=
          (Algebra.TensorProduct.map (valA₁ i) (AlgHom.id A₁ M₁)).commutes a
        exact h1.trans h2.symm
      obtain ⟨j_b, v_b_cat, hv_b_comm, hv_b_eq⟩ :=
        RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          (CommRingCat.of A₁) (mkF M₁) (mkAlpha M₁) f_B (mkC M₁) hc_M hFP_B g_inv hg_inv_comm

      
      let j₂ : J := j_a ⊔ j_b
      let u₂_cat : CommRingCat.of M₁ ⟶ (mkF B₁).obj j₂ :=
        u_a_cat ≫ (mkF B₁).map (homOfLE le_sup_left)
      let v₂_cat : CommRingCat.of B₁ ⟶ (mkF M₁).obj j₂ :=
        v_b_cat ≫ (mkF M₁).map (homOfLE le_sup_right)
      have hu₂_comm : f_M ≫ u₂_cat = (mkAlpha B₁).app j₂ := by
        rw [← Category.assoc, hu_a_comm, ← (mkAlpha B₁).naturality]
        simp
      have hv₂_comm : f_B ≫ v₂_cat = (mkAlpha M₁).app j₂ := by
        rw [← Category.assoc, hv_b_comm, ← (mkAlpha M₁).naturality]
        simp
      have hu₂_eq : u₂_cat ≫ (mkC B₁).ι.app j₂ = g_fwd := by
        rw [Category.assoc, (mkC B₁).w, ← hu_a_eq]
      have hv₂_eq : v₂_cat ≫ (mkC M₁).ι.app j₂ = g_inv := by
