          L₂ (Localization.mk P 1) = G P := by
        intro P
        have h1_coe : (1 : Submonoid.powers (X_N ν * X_N ν')).1 = 1 := rfl
        calc L₂ (Localization.mk P 1)
            = L₂ (IsLocalization.mk' _ P 1) := by rw [Localization.mk_eq_mk']
          _ = 1 * L₂ (IsLocalization.mk' _ P 1) := (one_mul _).symm
          _ = L₂ (algebraMap _ _ (1 : Submonoid.powers (X_N ν * X_N ν')).1) *
                L₂ (IsLocalization.mk' _ P 1) := by rw [h1_coe, map_one, map_one]
          _ = L₂ (algebraMap _ _ (1 : Submonoid.powers (X_N ν * X_N ν')).1 *
                IsLocalization.mk' _ P 1) := (map_mul _ _ _).symm
