      exact Ideal.mul_mem_mul hm hy
    let δ_A : Derivation Ω A N :=
      { toFun := fun x => Submodule.Quotient.mk ⟨x - algebraMap Ω A (ev_P x), hsub_mem_P x⟩
        map_add' := fun x y => by
          rw [← Submodule.Quotient.mk_add, Submodule.Quotient.eq, hmem_Ssq]
          change (x + y - algebraMap Ω A (ev_P (x + y))) -
            ((x - algebraMap Ω A (ev_P x)) + (y - algebraMap Ω A (ev_P y))) ∈ p_P.asIdeal ^ 2
          have h0 : (x + y - algebraMap Ω A (ev_P (x + y))) -
              ((x - algebraMap Ω A (ev_P x)) + (y - algebraMap Ω A (ev_P y))) = 0 := by
            simp only [map_add]; ring
          rw [h0]; exact (p_P.asIdeal ^ 2).zero_mem
        map_smul' := fun c x => by
          rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq, hmem_Ssq]
          change (c • x - algebraMap Ω A (ev_P (c • x))) -
            c • (x - algebraMap Ω A (ev_P x)) ∈ p_P.asIdeal ^ 2
          have h0 : (c • x - algebraMap Ω A (ev_P (c • x))) -
              c • (x - algebraMap Ω A (ev_P x)) = 0 := by
            simp only [Algebra.smul_def, map_mul, hevP_c]; ring
          rw [h0]; exact (p_P.asIdeal ^ 2).zero_mem
        map_one_eq_zero' := by
          change Submodule.Quotient.mk (p := S_sq) ⟨1 - algebraMap Ω A (ev_P 1), hsub_mem_P 1⟩ = (0 : N)
          rw [Submodule.Quotient.mk_eq_zero, hmem_Ssq]
          change 1 - algebraMap Ω A (ev_P 1) ∈ p_P.asIdeal ^ 2
          rw [map_one, map_one, sub_self]
          exact (p_P.asIdeal ^ 2).zero_mem
        leibniz' := fun x y => by
          change Submodule.Quotient.mk (p := S_sq) ⟨x * y - algebraMap Ω A (ev_P (x * y)), hsub_mem_P (x * y)⟩ =
            x • Submodule.Quotient.mk (p := S_sq) ⟨y - algebraMap Ω A (ev_P y), hsub_mem_P y⟩ +
            y • Submodule.Quotient.mk (p := S_sq) ⟨x - algebraMap Ω A (ev_P x), hsub_mem_P x⟩
          rw [← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_smul,
            ← Submodule.Quotient.mk_add, Submodule.Quotient.eq, hmem_Ssq]
