      let u_i := e_iΩ.inv.base w₁
      refine ⟨hInt_iΩ, ⟨(ι_Ω i).base u_i, ⟨u_i, rfl⟩, ?_⟩⟩
      intro j hji ⟨u_j, hu_j⟩
      obtain ⟨hTop_j, _⟩ := hCompGrid j
      have hz_i_mem : (CategoryTheory.Limits.pullback.fst (ι_ℰ i)
