        rw [h_comp]
      have hPb_k_gen : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst p_k s_k_gen ≫
            CategoryTheory.Limits.pullback.fst (p_ℰ₁ i_k) f₁_k)
