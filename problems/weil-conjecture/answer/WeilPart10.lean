                rw [map_add, map_add]; exact (p_P.asIdeal ^ 2).add_mem hu hv
              · intro s u _ hu
                rw [LinearMap.map_smul, smul_eq_mul, map_mul]
                exact Ideal.mul_mem_left _ _ hu
            intro y hy
            refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
            · exact hRangeSq
            · rw [map_zero]; exact (p_P.asIdeal ^ 2).zero_mem
            · intro u v _ _ hu hv
              rw [map_add]; exact (p_P.asIdeal ^ 2).add_mem hu hv
            · intro s u _ hu
              rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ hu
          
          have hbt_px : b_t ∈ p_x.asIdeal := by
            rw [hp_x_mem_iff, ← hbt_eq]
            exact Ideal.mul_mem_left _ _ ht_mem
          have hbt_max : algebraMap B_a (Localization.AtPrime p_x.asIdeal) b_t ∈
              Ideal.map (algebraMap B_a (Localization.AtPrime p_x.asIdeal))
                (Ideal.span (Set.range (ψ_log a))) := by
            rw [hMapMax]
            exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
              (Localization.AtPrime p_x.asIdeal) p_x.asIdeal b_t).mpr hbt_px
          let I_ψ := Ideal.span (Set.range (ψ_log a))
          let L_px := Localization.AtPrime p_x.asIdeal
          let J_loc : Ideal L_px :=
            { carrier := {z : L_px | ∃ s ∈ p_x.asIdeal.primeCompl, ∃ i ∈ I_ψ,
                z * algebraMap B_a L_px s = algebraMap B_a L_px i}
              add_mem' := by
                rintro z₁ z₂ ⟨s₁', hs₁', i₁, hi₁, h₁⟩ ⟨s₂', hs₂', i₂, hi₂, h₂⟩
                refine ⟨s₁' * s₂', p_x.asIdeal.primeCompl.mul_mem hs₁' hs₂',
                  s₂' * i₁ + s₁' * i₂,
                  I_ψ.add_mem (I_ψ.mul_mem_left _ hi₁) (I_ψ.mul_mem_left _ hi₂), ?_⟩
                simp only [map_mul, map_add]
                calc (z₁ + z₂) * (algebraMap B_a L_px s₁' * algebraMap B_a L_px s₂')
                    = (z₁ * algebraMap B_a L_px s₁') * algebraMap B_a L_px s₂' +
                        (z₂ * algebraMap B_a L_px s₂') * algebraMap B_a L_px s₁' := by ring
                  _ = algebraMap B_a L_px i₁ * algebraMap B_a L_px s₂' +
                        algebraMap B_a L_px i₂ * algebraMap B_a L_px s₁' := by rw [h₁, h₂]
                  _ = algebraMap B_a L_px s₂' * algebraMap B_a L_px i₁ +
                        algebraMap B_a L_px s₁' * algebraMap B_a L_px i₂ := by ring
              zero_mem' := ⟨1, p_x.asIdeal.primeCompl.one_mem, 0, I_ψ.zero_mem, by simp⟩
              smul_mem' := by
                rintro c z₁ ⟨s₁', hs₁', i₁, hi₁, h₁⟩
                obtain ⟨⟨r, s₂'⟩, hc⟩ := IsLocalization.surj p_x.asIdeal.primeCompl c
                refine ⟨(s₂' : B_a) * s₁', p_x.asIdeal.primeCompl.mul_mem s₂'.2 hs₁',
                  r * i₁, I_ψ.mul_mem_left _ hi₁, ?_⟩
                simp only [smul_eq_mul, map_mul]
                calc c * z₁ * (algebraMap B_a L_px (s₂' : B_a) * algebraMap B_a L_px s₁')
                    = (c * algebraMap B_a L_px (s₂' : B_a)) *
                        (z₁ * algebraMap B_a L_px s₁') := by ring
                  _ = algebraMap B_a L_px r * algebraMap B_a L_px i₁ := by rw [hc, h₁] }
          have hJ_le : Ideal.map (algebraMap B_a L_px) I_ψ ≤ J_loc := by
            rw [Ideal.map_le_iff_le_comap]
            intro i hi
            exact ⟨1, p_x.asIdeal.primeCompl.one_mem, i, hi, by simp⟩
          obtain ⟨s_d, hs_d, i_d, hi_d, h_eq_d⟩ := hJ_le hbt_max
          have h_eq_d' : algebraMap B_a L_px (b_t * s_d) = algebraMap B_a L_px i_d := by
            simpa [map_mul] using h_eq_d
          obtain ⟨t_d, ht_d⟩ := IsLocalization.exists_of_eq (M := p_x.asIdeal.primeCompl) h_eq_d'
          have h_in_Iψ : ((t_d : B_a) * s_d) * b_t ∈ I_ψ := by
            have ht_d' : ((t_d : B_a) * s_d) * b_t = (t_d : B_a) * i_d := by
              linear_combination ht_d
            rw [ht_d']
            exact I_ψ.mul_mem_left _ hi_d
          have h_nu_sq := hAllSq (((t_d : B_a) * s_d) * b_t) h_in_Iψ
          rw [map_mul, ← hbt_eq, ← mul_assoc] at h_nu_sq
          have hcoeff_not : ((ν α).app (M.V a)).hom ((t_d : B_a) * s_d) *
              (((ν α).app (M.V a)).hom b_sm) ^ k_sm ∉ p_P.asIdeal := by
            intro hmem_c
            rcases p_P.isPrime.mem_or_mem hmem_c with hts_in | hbsm_in
            · exact (p_x.asIdeal.primeCompl.mul_mem t_d.2 hs_d) ((hp_x_mem_iff _).mpr hts_in)
            · exact hbsm_not_px ((hp_x_mem_iff _).mpr (p_P.isPrime.mem_of_pow_mem k_sm hbsm_in))
