  have hAwayMaxSq : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (r : R) (loc_R : R →+* S)
      (_ : @IsLocalization.Away R _ r S _ loc_R.toAlgebra)
      (p : Ideal R) (_ : p.IsMaximal) (q : Ideal S) (_ : q.IsMaximal)
      (hComap : Ideal.comap loc_R q = p)
      (y : R),
      (loc_R y ∈ q ↔ y ∈ p) ∧ (loc_R y ∈ q ^ 2 ↔ y ∈ p ^ 2) := by
    intro R S _ _ r loc_R hLoc p hpMax q _hqMax hComap y
    letI : Algebra R S := loc_R.toAlgebra
    haveI : IsLocalization.Away r S := hLoc
    have h1 : loc_R y ∈ q ↔ y ∈ p := by
      rw [← hComap, Ideal.mem_comap]
    refine ⟨h1, ⟨fun hy_sq => ?_, fun hy_sq => ?_⟩⟩
    · have hMapEq : Ideal.map (algebraMap R S) p = q := by
        have h := IsLocalization.map_under (Submonoid.powers r) S q
        change Ideal.map (algebraMap R S) (Ideal.comap loc_R q) = q at h
        rwa [hComap] at h
      have hSqMap : q ^ 2 = Ideal.map (algebraMap R S) (p ^ 2) := by
        rw [← hMapEq, Ideal.map_pow]
      rw [hSqMap] at hy_sq
      have hr_not_p : r ∉ p := by
        intro hrp
        rw [← hComap, Ideal.mem_comap] at hrp
        obtain ⟨u_r, hu_r⟩ := IsLocalization.Away.algebraMap_isUnit r (S := S)
        have h1_in_q : (1 : S) ∈ q := by
          have hmul := q.mul_mem_right (u_r⁻¹ : Sˣ).val (show (u_r : S) ∈ q by rwa [hu_r])
          simpa using hmul
        exact _hqMax.ne_top (q.eq_top_of_isUnit_mem h1_in_q isUnit_one)
      have hClear : ∀ z ∈ Ideal.map (algebraMap R S) (p ^ 2),
          ∃ (m : ℕ) (i : R), i ∈ p ^ 2 ∧ z * loc_R r ^ m = loc_R i := by
        intro z hz
        induction hz using Submodule.span_induction with
        | mem w hw =>
          rcases hw with ⟨i, hi, rfl⟩
          exact ⟨0, i, hi, by simp; rfl⟩
        | zero => exact ⟨0, 0, (p ^ 2).zero_mem, by simp⟩
        | add w₁ w₂ _ _ ih₁ ih₂ =>
          obtain ⟨m₁, i₁, hi₁, h₁_eq⟩ := ih₁
          obtain ⟨m₂, i₂, hi₂, h₂_eq⟩ := ih₂
          refine ⟨m₁ + m₂, i₁ * r ^ m₂ + i₂ * r ^ m₁,
            (p ^ 2).add_mem ((p ^ 2).mul_mem_right _ hi₁) ((p ^ 2).mul_mem_right _ hi₂), ?_⟩
          calc (w₁ + w₂) * loc_R r ^ (m₁ + m₂)
              = (w₁ * loc_R r ^ m₁) * loc_R r ^ m₂ +
                  (w₂ * loc_R r ^ m₂) * loc_R r ^ m₁ := by ring
            _ = loc_R (i₁ * r ^ m₂ + i₂ * r ^ m₁) := by
                rw [h₁_eq, h₂_eq]; simp [map_add, map_mul, map_pow]
        | smul s_b w _ ih =>
          obtain ⟨m₁, i₁, hi₁, h₁_eq⟩ := ih
          obtain ⟨m₂, b_s, hb_s⟩ := IsLocalization.Away.surj r s_b (S := S)
          change s_b * loc_R r ^ m₂ = loc_R b_s at hb_s
          refine ⟨m₂ + m₁, b_s * i₁, (p ^ 2).mul_mem_left _ hi₁, ?_⟩
          calc (s_b • w) * loc_R r ^ (m₂ + m₁)
              = (s_b * loc_R r ^ m₂) * (w * loc_R r ^ m₁) := by
                change (s_b * w) * loc_R r ^ (m₂ + m₁) = _; ring
            _ = loc_R (b_s * i₁) := by rw [hb_s, h₁_eq, map_mul]
      obtain ⟨m₁, i, hi_mem, hi_eq⟩ := hClear (loc_R y) hy_sq
      have hloc_eq : algebraMap R S (y * r ^ m₁) = algebraMap R S i := by
        change loc_R (y * r ^ m₁) = loc_R i
        rw [map_mul, map_pow, hi_eq]
      obtain ⟨⟨_, k₁, rfl⟩, hk₁_eq⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers r) S).mp hloc_eq
      have hry_sq : r ^ (k₁ + m₁) * y ∈ p ^ 2 := by
        have hmul_eq : r ^ (k₁ + m₁) * y = r ^ k₁ * i := by
          calc r ^ (k₁ + m₁) * y = r ^ k₁ * (y * r ^ m₁) := by ring
            _ = r ^ k₁ * i := hk₁_eq
        rw [hmul_eq]
        exact (p ^ 2).mul_mem_left _ hi_mem
      have hr_pow_not : r ^ (k₁ + m₁) ∉ p :=
        fun hmem => hr_not_p (hpMax.isPrime.mem_of_pow_mem (k₁ + m₁) hmem)
      let s_u := r ^ (k₁ + m₁)
      have htop : p ⊔ Ideal.span ({s_u} : Set R) = ⊤ := by
        by_contra hne_top
        have heq : p = p ⊔ Ideal.span ({s_u} : Set R) := hpMax.eq_of_le hne_top le_sup_left
        exact hr_pow_not (heq.symm ▸ Ideal.mem_sup_right (Ideal.mem_span_singleton_self s_u))
      have h1_sup : (1 : R) ∈ p ⊔ Ideal.span ({s_u} : Set R) := htop ▸ trivial
      rcases Submodule.mem_sup.mp h1_sup with ⟨m_p, hm_p, s', hs', hms⟩
      rcases Ideal.mem_span_singleton.mp hs' with ⟨t_u, rfl⟩
      have hy_id : y = m_p * m_p * y + (2 * m_p * t_u + s_u * t_u ^ 2) * (s_u * y) := by
        calc y = (1 : R) ^ 2 * y := by ring
          _ = (m_p + s_u * t_u) ^ 2 * y := by rw [hms]
          _ = m_p * m_p * y + (2 * m_p * t_u + s_u * t_u ^ 2) * (s_u * y) := by ring
      rw [hy_id]
      apply Ideal.add_mem
      · rw [pow_two]; exact Ideal.mul_mem_right y _ (Ideal.mul_mem_mul hm_p hm_p)
      · exact Ideal.mul_mem_left _ _ hry_sq
    · have hle_p : p ≤ Ideal.comap loc_R q := le_of_eq hComap.symm
      have hmap_sq : Ideal.map loc_R (p ^ 2) ≤ q ^ 2 := by
        rw [Ideal.map_pow]
        exact pow_le_pow_left' (Ideal.map_le_iff_le_comap.mpr hle_p) 2
      exact hmap_sq (Ideal.mem_map_of_mem loc_R hy_sq)

