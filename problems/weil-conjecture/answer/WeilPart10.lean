  have hTransportGeomStable : ∀ {C₁ C₂ S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (g₁ : C₁ ⟶ S₁) (τ₁ : Fin n → (S₁ ⟶ C₁))
      (g₂ : C₂ ⟶ S₂) (τ₂ : Fin n → (S₂ ⟶ C₂))
      (ιC : C₂ ⟶ C₁) (f : S₂ ⟶ S₁)
      (hPb : CategoryTheory.IsPullback ιC g₂ g₁ f)
      (hSec₁ : ∀ j : Fin n, τ₁ j ≫ g₁ = 𝟙 S₁)
      (hSec₂ : ∀ j : Fin n, τ₂ j ≫ g₂ = 𝟙 S₂)
      (hτ : ∀ j : Fin n, τ₂ j ≫ ιC = f ≫ τ₁ j)
      (Ω : Type u) [Field Ω]
      (s₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S₂),
      HasSpreadGeomStableFiber g₂ n τ₂ Ω s₂ ↔
        HasSpreadGeomStableFiber g₁ n τ₁ Ω (s₂ ≫ f) := by
    intro C₁ C₂ S₁ S₂ g₁ τ₁ g₂ τ₂ ιC f hPb hSec₁ hSec₂ hτ Ω _ s₂
    let hPbFib : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g₂ s₂ ≫ ιC)
        (CategoryTheory.Limits.pullback.snd g₂ s₂)
        g₁ (s₂ ≫ f) :=
      (CategoryTheory.IsPullback.of_hasPullback g₂ s₂).paste_horiz hPb
    let e : CategoryTheory.Limits.pullback g₂ s₂ ≅
        CategoryTheory.Limits.pullback g₁ (s₂ ≫ f) :=
      hPbFib.isoPullback
    have he_fst : e.hom ≫ CategoryTheory.Limits.pullback.fst g₁ (s₂ ≫ f) =
        CategoryTheory.Limits.pullback.fst g₂ s₂ ≫ ιC :=
      hPbFib.isoPullback_hom_fst
    have he_snd : e.hom ≫ CategoryTheory.Limits.pullback.snd g₁ (s₂ ≫ f) =
        CategoryTheory.Limits.pullback.snd g₂ s₂ :=
      hPbFib.isoPullback_hom_snd
    have he_inv_snd : e.inv ≫ CategoryTheory.Limits.pullback.snd g₂ s₂ =
        CategoryTheory.Limits.pullback.snd g₁ (s₂ ≫ f) := by
      rw [← he_snd, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    have hM : ∀ (j : Fin n) (q' : ↥(CategoryTheory.Limits.pullback g₂ s₂)),
        (CategoryTheory.Limits.pullback.fst g₂ s₂).base q' ∈ Set.range (τ₂ j).base ↔
          (CategoryTheory.Limits.pullback.fst g₁ (s₂ ≫ f)).base (e.hom.base q') ∈
            Set.range (τ₁ j).base := by
      intro j q'
      have hPbSec : CategoryTheory.IsPullback f (τ₂ j) (τ₁ j) ιC := by
        refine CategoryTheory.IsPullback.of_bot ?_ (hτ j).symm hPb
        rw [hSec₂ j, hSec₁ j]
        exact CategoryTheory.IsPullback.of_vert_isIso
          ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
      have h_pt : (CategoryTheory.Limits.pullback.fst g₁ (s₂ ≫ f)).base (e.hom.base q') =
          ιC.base ((CategoryTheory.Limits.pullback.fst g₂ s₂).base q') := by
        change (e.hom ≫ CategoryTheory.Limits.pullback.fst g₁ (s₂ ≫ f)).base q' =
          (CategoryTheory.Limits.pullback.fst g₂ s₂ ≫ ιC).base q'
        rw [he_fst]
      rw [h_pt]
      constructor
      · rintro ⟨b', hb'⟩
        refine ⟨f.base b', ?_⟩
        calc
          (τ₁ j).base (f.base b') = (f ≫ τ₁ j).base b' := rfl
          _ = (τ₂ j ≫ ιC).base b' := by rw [hτ j]
          _ = ιC.base ((CategoryTheory.Limits.pullback.fst g₂ s₂).base q') := by simp [hb']
      · rintro ⟨b, hb⟩
        obtain ⟨b', _hb'1, hb'2⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPbSec b
            ((CategoryTheory.Limits.pullback.fst g₂ s₂).base q') hb
        exact ⟨b', hb'2⟩
    constructor
    · exact hTransportIso _ _ _ _ e he_snd hM
    · refine hTransportIso _ _ _ _ e.symm he_inv_snd ?_
      intro j q
      have hq := hM j (e.inv.base q)
      have he_app : e.hom.base (e.inv.base q) = q := by
        change (e.inv ≫ e.hom).base q = q
        rw [e.inv_hom_id]
        rfl
      rw [he_app] at hq
      exact hq.symm

