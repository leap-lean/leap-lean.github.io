      haveI : Algebra.FormallyUnramified B_tilde B_tilde₁_α :=
        Algebra.FormallyUnramified.of_isLocalization (Submonoid.powers (((ν α).app V).hom g₁))
      haveI : Algebra.FormallyUnramified B_tilde₁_α D := hUnram_1_D
      haveI : Algebra.EssFiniteType B_tilde B_tilde₁_α :=
        Algebra.EssFiniteType.of_isLocalization B_tilde₁_α (Submonoid.powers (((ν α).app V).hom g₁))
      haveI : Algebra.FiniteType B_tilde₁_α D := hFT_1_D
      haveI : Algebra.EssFiniteType B_tilde₁_α D := Algebra.EssFiniteType.of_finiteType B_tilde₁_α D
      exact ⟨Module.Flat.trans B_tilde B_tilde₁_α D,
        Algebra.FormallyUnramified.comp B_tilde B_tilde₁_α D,
        Algebra.EssFiniteType.comp B_tilde B_tilde₁_α D⟩
    rcases hExh_pair α q_1 hq1_comap_py1 with h0 | h1
    · 
      obtain ⟨hα0, hq0⟩ := Sigma.mk.inj_iff.mp h0
      cases hα0
