    · change p₂ ≫ 𝟙 _ = CategoryTheory.inv Φ ≫ p_S
      rw [CategoryTheory.Category.comp_id,
        ← CategoryTheory.Limits.pullback.lift_snd π_φ p_S hComm,
        CategoryTheory.IsIso.inv_hom_id_assoc]
    · change p_R ≫ 𝟙 _ = 𝟙 _ ≫ p_R
      rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    · change f_φ ≫ 𝟙 _ = 𝟙 _ ≫ f_φ
      rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]

  · 
    intro Ω _ _
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) Ω
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P_Ω : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
    let p_Ω : P_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
