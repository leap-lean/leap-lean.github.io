      intro i
      obtain ⟨hTop_i, hFull_i⟩ := hCompGrid i
      obtain ⟨hInt_1_all, _⟩ := hAll_ℰ₁_intP1 i i.2
      have h_pair : AlgebraicGeometry.IsIntegral
