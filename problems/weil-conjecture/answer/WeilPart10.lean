      exact g.2 hmul
    have hD₀_mem : D₀ ∈ Q_x.primeCompl := hD₀_bar
    refine ⟨IsLocalization.mk' R_loc N₀ ⟨D₀, hD₀_mem⟩, ?_⟩
    obtain ⟨uP, huP⟩ := IsLocalization.map_units P ⟨map_κ D₀, hD₀_bar⟩
    have h_eq_mul : ψ_loc (IsLocalization.mk' R_loc N₀ ⟨D₀, hD₀_mem⟩) * φ_P (map_κ D₀) =
