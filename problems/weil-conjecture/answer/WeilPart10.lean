                (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial)) := by
            rw [hAffU'₁₂.isoSpec.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = hAffU'₁₂.isoSpec.inv ≫ (hAffU'₁₂.isoSpec.hom ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial))) :=
            CategoryTheory.Category.assoc _ _ _
        _ = hAffU'₁₂.isoSpec.inv ≫ r_U ≫ hAffTop.isoSpec.hom := by rw [hcomm]
    haveI : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial))) := by
      rw [hSpec_id]; infer_instance
    have hSpec_α : AlgebraicGeometry.Spec.map α_R' =
        AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial)) ≫
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv :=
