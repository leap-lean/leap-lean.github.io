        rw [h1, CategoryTheory.Limits.pullback.lift_fst]
        exact AlgebraicGeometry.Proj.map_preimage_basicOpen f_gr hf_irrel (MvPolynomial.X a)
      let iso_S : Q_pre.toScheme ≅
          AlgebraicGeometry.Spec
            (CommRingCat.of (HomogeneousLocalization.Away 𝒜_S (f_gr (MvPolynomial.X a)))) :=
        P_S.isoOfEq hQ_eq ≪≫
          AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_S (f_gr (MvPolynomial.X a))
            (f_gr.map_mem (hX_R a)) zero_lt_one
      let iso_R : (D_R a).toScheme ≅
          AlgebraicGeometry.Spec
            (CommRingCat.of (HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a))) :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_R (MvPolynomial.X a) (hX_R a) zero_lt_one
      have hisoS_ι : iso_S.inv ≫ Q_pre.ι = j_S a := by
