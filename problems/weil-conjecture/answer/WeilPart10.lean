            (Finset.coe_subset.mpr (show u.1 ⊆ v.1 from leOfHom g)))).toRingHom
      map_id := fun _ => by apply CommRingCat.hom_ext; ext x; rfl
      map_comp := fun _ _ => by apply CommRingCat.hom_ext; ext x; rfl }
  let c_K₂ : CategoryTheory.Limits.Cocone F_K₂ :=
    { pt := CommRingCat.of K
      ι :=
        { app := fun u => CommRingCat.ofHom (Algebra.adjoin B₀ (↑u.1 : Set K)).val.toRingHom
          naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext x; rfl } }
  obtain ⟨hc_K₂⟩ := hAdjoinColim S₂
  have h_nat_B₀ : ∀ {u v : J₂} (g : u ⟶ v) (b₀ : B₀),
      (F_K₂.map g).hom (algebraMap B₀ ↑(F_K₂.obj u) b₀) = algebraMap B₀ ↑(F_K₂.obj v) b₀ :=
    fun _ _ => Subtype.ext rfl
  have h_pt_B₀ : ∀ (u : J₂) (b₀ : B₀),
      (c_K₂.ι.app u).hom (algebraMap B₀ ↑(F_K₂.obj u) b₀) = algebraMap B₀ K b₀ :=
    fun _ _ => rfl
  let mapK₂ : ∀ {u v : J₂}, (u ⟶ v) → (↑(F_K₂.obj u) →ₐ[B₀] ↑(F_K₂.obj v)) :=
    fun {u v} g => { toRingHom := (F_K₂.map g).hom, commutes' := h_nat_B₀ g }
  let ιK₂ : ∀ u : J₂, ↑(F_K₂.obj u) →ₐ[B₀] K :=
    fun u => { toRingHom := (c_K₂.ι.app u).hom, commutes' := h_pt_B₀ u }
  let F_D₂ : CategoryTheory.Functor J₂ CommRingCat.{u} :=
    { obj := fun u => CommRingCat.of (TensorProduct B₀ ↑(F_K₂.obj u) R)
      map := fun g => CommRingCat.ofHom (Algebra.TensorProduct.map (mapK₂ g) (AlgHom.id B₀ R)).toRingHom
      map_id := fun u => by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro z
        refine TensorProduct.inductionOn z ?_
          (fun _ _ hx hy => by simp only [CommRingCat.hom_ofHom, CommRingCat.hom_id, map_add] at hx hy ⊢; rw [hx, hy])
        intro x m; change (F_K₂.map (𝟙 u)).hom x ⊗ₜ[B₀] m = x ⊗ₜ[B₀] m; rw [F_K₂.map_id]; rfl
      map_comp := fun g₁ g₂ => by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro z
        refine TensorProduct.inductionOn z ?_
          (fun _ _ hx hy => by simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, map_add] at hx hy ⊢; rw [hx, hy])
        intro x m; change (F_K₂.map (g₁ ≫ g₂)).hom x ⊗ₜ[B₀] m = (F_K₂.map g₂).hom ((F_K₂.map g₁).hom x) ⊗ₜ[B₀] m; rw [F_K₂.map_comp]; rfl }
  let c_D₂ : CategoryTheory.Limits.Cocone F_D₂ :=
    { pt := CommRingCat.of (TensorProduct B₀ K R)
      ι :=
        { app := fun u => CommRingCat.ofHom (Algebra.TensorProduct.map (ιK₂ u) (AlgHom.id B₀ R)).toRingHom
          naturality := fun u v g => by
            apply CommRingCat.hom_ext; apply RingHom.ext; intro z
            refine TensorProduct.inductionOn z ?_
              (fun _ _ hx hy => by simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, map_add] at hx hy ⊢; rw [hx, hy])
            intro x m
            have hc_x : ιK₂ v ((F_K₂.map g).hom x) = ιK₂ u x :=
              congrArg (fun q => q.hom x) (c_K₂.w g)
            change ιK₂ v ((F_K₂.map g).hom x) ⊗ₜ[B₀] m = ιK₂ u x ⊗ₜ[B₀] m
            rw [hc_x] } }
  obtain ⟨hc_D₂⟩ := hPushout B₀ F_K₂ c_K₂ hc_K₂ h_nat_B₀ h_pt_B₀ R
  have hNoeth_FD₂ : ∀ u : J₂, IsNoetherianRing ↑(F_D₂.obj u) := by
    intro u
    let Au := ↥(Algebra.adjoin B₀ (↑u.1 : Set K))
    haveI : Algebra.FiniteType B₀ Au := Algebra.FiniteType.adjoin_of_finite u.1.finite_toSet
    haveI : IsNoetherianRing Au := Algebra.FiniteType.isNoetherianRing B₀ Au
    haveI : Algebra.FiniteType Au (TensorProduct B₀ Au R) := inferInstance
    exact Algebra.FiniteType.isNoetherianRing Au (TensorProduct B₀ Au R)
  obtain ⟨u_r, hEt_r_alg⟩ := hNoethEtale J₂ F_D₂ hNoeth_FD₂ c_D₂ hc_D₂ 𝒟'₂ hEt_DK_𝒟₂

  
  let S_r : Finset K := u_r.1
  have hSub₂_r : S₂ ⊆ S_r := u_r.2
  let A_r_sub : Subalgebra B₀ K := Algebra.adjoin B₀ (↑S_r : Set K)
  let A_r := ↥A_r_sub
  let inc₂_r : A₂ →ₐ[B₀] A_r := Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub₂_r))
  letI : Algebra A₂ A_r := inc₂_r.toRingHom.toAlgebra
  haveI : IsScalarTower B₀ A₂ A_r := IsScalarTower.of_algebraMap_eq (fun b => (inc₂_r.commutes b).symm)
  have hToAlg_2r : IsScalarTower.toAlgHom B₀ A₂ A_r = inc₂_r := by
    ext x
    rfl
  let 𝒟'_r := TensorProduct A₂ A_r 𝒟'₂
  let D_r := TensorProduct B₀ A_r R
  have hEt_φDr := (hCancelEt A₂ A_r 𝒟'₂ φ_D₂).mp (by
    rw [hToAlg_2r]
    exact hEt_r_alg)
  obtain ⟨φ_node_r, hEt_node_r, hφ_node_r_C⟩ := hNodeBC A₂ A_r 𝒟'₂ φ_node₂ hEt_node₂ hAlg₂
  obtain ⟨O_r, hO_r_mem, hO_r_spec⟩ := hOpenLift A_r 𝒟'_r _
    (fun a_r => by
      change (Algebra.TensorProduct.map (AlgHom.id A₂ A_r) φ_D₂)
        ((Algebra.TensorProduct.cancelBaseChange B₀ A₂ A_r A_r R).symm (a_r ⊗ₜ[B₀] (1 : R))) =
        a_r ⊗ₜ[A₂] (1 : 𝒟'₂)
      rw [Algebra.TensorProduct.cancelBaseChange_symm_tmul, Algebra.TensorProduct.map_tmul]
      change a_r ⊗ₜ[A₂] φ_D₂ (1 : D₂) = _
      rw [map_one])
    hEt_φDr

  refine ⟨S_r, O_r, ?_, ?_⟩
  · 
    intro q'
    let ψ_r : A_r →ₐ[A₂] K :=
      { toRingHom := A_r_sub.val.toRingHom
        commutes' := fun _ => rfl }
    let ι_r_raw := e₂.toRingHom.comp (Algebra.TensorProduct.map ψ_r (AlgHom.id A₂ 𝒟'₂)).toRingHom
    let ι_r : @RingHom 𝒟'_r D'
        (inferInstance : CommRing 𝒟'_r).toCommSemiring.toSemiring.toNonAssocSemiring
        (inferInstance : CommRing D').toCommSemiring.toSemiring.toNonAssocSemiring :=
      { toFun := ι_r_raw
        map_one' := map_one ι_r_raw
        map_mul' := map_mul ι_r_raw
        map_zero' := map_zero ι_r_raw
        map_add' := map_add ι_r_raw }
    let π_r : D_r →+* TensorProduct B₀ K R :=
      (Algebra.TensorProduct.map A_r_sub.val (AlgHom.id B₀ R)).toRingHom
    have h_comm_r : ι_r.comp
        ((Algebra.TensorProduct.map (AlgHom.id A₂ A_r) φ_D₂).toRingHom.comp
          (Algebra.TensorProduct.cancelBaseChange B₀ A₂ A_r A_r R).symm.toRingHom) =
        φ_D.comp π_r := by
      apply RingHom.ext
      intro z
      refine TensorProduct.inductionOn z ?_ (fun _ _ hx hy => by rw [map_add, map_add, hx, hy])
      intro a_r r₀
      change e₂ ((Algebra.TensorProduct.map ψ_r (AlgHom.id A₂ 𝒟'₂))
        ((Algebra.TensorProduct.map (AlgHom.id A₂ A_r) φ_D₂)
          ((Algebra.TensorProduct.cancelBaseChange B₀ A₂ A_r A_r R).symm (a_r ⊗ₜ[B₀] r₀)))) =
        φ_D (a_r.1 ⊗ₜ[B₀] r₀)
      rw [Algebra.TensorProduct.cancelBaseChange_symm_tmul, Algebra.TensorProduct.map_tmul,
        Algebra.TensorProduct.map_tmul]
      have h_rhs := RingHom.congr_fun he₂ (a_r.1 ⊗ₜ[B₀] r₀)
      rw [← h_rhs]
      change e₂ ((a_r.1 : K) ⊗ₜ[A₂] φ_D₂ ((1 : A₂) ⊗ₜ[B₀] r₀)) =
        e₂ ((Algebra.TensorProduct.map (AlgHom.id A₂ K) φ_D₂)
          ((Algebra.TensorProduct.cancelBaseChange B₀ A₂ K K R).symm (a_r.1 ⊗ₜ[B₀] r₀)))
      rw [Algebra.TensorProduct.cancelBaseChange_symm_tmul, Algebra.TensorProduct.map_tmul]
      rfl
    change ((PrimeSpectrum.comap π_r) ∘ (PrimeSpectrum.comap φ_D)) q' ∈ O_r
    rw [← PrimeSpectrum.comap_comp, ← h_comm_r, PrimeSpectrum.comap_comp]
    exact hO_r_mem (PrimeSpectrum.comap ι_r q')
  · 
    have hSpecAll : ∀ (M_r : Type u) [CommRing M_r] [Algebra A_r M_r]
        (φ_node_M : (MvPolynomial (Fin 2) A_r ⧸ I_node A_r) →+* M_r),
        φ_node_M.Etale →
        (∀ a_r : A_r, algebraMap A_r M_r a_r = φ_node_M (Ideal.Quotient.mk _ (MvPolynomial.C a_r))) →
        (∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω] [Algebra A_r Ω] [IsScalarTower B₀ A_r Ω],
          ∃ (φ_D_Ω : TensorProduct B₀ Ω R →+* TensorProduct A_r Ω M_r),
            φ_D_Ω.Etale ∧
            (∀ ω : Ω, φ_D_Ω (algebraMap Ω (TensorProduct B₀ Ω R) ω) = ω ⊗ₜ[A_r] (1 : M_r)) ∧
            ∀ q_Ω : PrimeSpectrum (TensorProduct B₀ Ω R),
              PrimeSpectrum.comap
                (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A_r Ω) (AlgHom.id B₀ R)).toRingHom
                q_Ω ∈ O_r →
              q_Ω ∈ Set.range (PrimeSpectrum.comap φ_D_Ω)) →
        ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω] [Algebra A_r Ω] [IsScalarTower B₀ A_r Ω],
          ∃ (𝒟'_Ω : Type u) (_ : CommRing 𝒟'_Ω)
            (φ_D_Ω : TensorProduct B₀ Ω R →+* 𝒟'_Ω)
            (φ_node_Ω : (MvPolynomial (Fin 2) Ω ⧸ I_node Ω) →+* 𝒟'_Ω),
            φ_D_Ω.Etale ∧
            φ_node_Ω.Etale ∧
            φ_D_Ω.comp (algebraMap Ω (TensorProduct B₀ Ω R)) =
              φ_node_Ω.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
            ∀ q_Ω : PrimeSpectrum (TensorProduct B₀ Ω R),
              PrimeSpectrum.comap
                (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A_r Ω) (AlgHom.id B₀ R)).toRingHom
                q_Ω ∈ O_r →
              q_Ω ∈ Set.range (PrimeSpectrum.comap φ_D_Ω) := by
      intro M_r _ _ φ_node_M hEt_M hAlg_M hSpec_M Ω _ _ _ _
      obtain ⟨φ_D_Ω, hEt_D_Ω, hω_D_Ω, hLift_Ω⟩ := hSpec_M Ω
      obtain ⟨φ_node_Ω, hEt_node_Ω, hω_node_Ω⟩ := hNodeBC A_r Ω M_r φ_node_M hEt_M hAlg_M
      refine ⟨TensorProduct A_r Ω M_r, inferInstance, φ_D_Ω, φ_node_Ω, hEt_D_Ω, hEt_node_Ω, ?_, hLift_Ω⟩
      apply RingHom.ext
      intro ω
      change φ_D_Ω (algebraMap Ω (TensorProduct B₀ Ω R) ω) =
        φ_node_Ω (Ideal.Quotient.mk _ (MvPolynomial.C ω))
      rw [hω_D_Ω ω, hω_node_Ω ω]
    exact hSpecAll 𝒟'_r φ_node_r hEt_node_r (fun a_r => hφ_node_r_C a_r) hO_r_spec

theorem weil_algClosed_affine_cover_imp_smoothOrNodal_and_smooth (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (N : ℕ) (D : Fin N → Type u)
    [∀ α : Fin N, CommRing (D α)]
    [∀ α : Fin N, Algebra Ω (D α)]
    [∀ α : Fin N, Algebra.FiniteType Ω (D α)]
    (j_D : ∀ α : Fin N, AlgebraicGeometry.Spec (CommRingCat.of (D α)) ⟶ Y) :
    (∀ α : Fin N, AlgebraicGeometry.IsOpenImmersion (j_D α)) →
    (∀ α : Fin N,
      j_D α ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω (D α)))) →
    (⋃ α : Fin N, Set.range (j_D α).base) = Set.univ →
    ((∀ α : Fin N,
        ∃ (m : ℕ) (f : Fin m → D α),
          (∀ μ : Fin m,
            RingHom.IsStandardSmoothOfRelativeDimension 1
              (algebraMap Ω (Localization.Away (f μ)))) ∧
          (⋃ μ : Fin m, (PrimeSpectrum.basicOpen (f μ) : Set (PrimeSpectrum (D α)))) =
            Set.univ) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 p_Y) ∧
    ((∀ (A : Type u) [CommRing A] [Algebra Ω A] [Algebra.FiniteType Ω A] [IsReduced A]
        (q : PrimeSpectrum A),
        q.asIdeal.IsMaximal →
        (let L := Localization.AtPrime q.asIdeal
         let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
         Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2) →
        ∃ g : A, g ∉ q.asIdeal ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap Ω (Localization.Away g))) →
      (∀ α : Fin N,
        ∃ (m : ℕ) (f : Fin m → D α)
          (s : ℕ) (𝒟' : Fin s → Type u) (_ : ∀ ν : Fin s, CommRing (𝒟' ν))
          (φ_D : ∀ ν : Fin s, D α →+* 𝒟' ν)
          (φ_node : ∀ ν : Fin s,
            (MvPolynomial (Fin 2) Ω ⧸
              Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
                Set (MvPolynomial (Fin 2) Ω))) →+* 𝒟' ν),
          (∀ μ : Fin m,
            RingHom.IsStandardSmoothOfRelativeDimension 1
              (algebraMap Ω (Localization.Away (f μ)))) ∧
          (∀ ν : Fin s, (φ_D ν).Etale) ∧
          (∀ ν : Fin s, (φ_node ν).Etale) ∧
          (∀ ν : Fin s,
            (φ_D ν).comp (algebraMap Ω (D α)) =
              (φ_node ν).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
          (⋃ μ : Fin m, (PrimeSpectrum.basicOpen (f μ) : Set (PrimeSpectrum (D α)))) ∪
            (⋃ ν : Fin s, Set.range (PrimeSpectrum.comap (φ_D ν))) = Set.univ) →
      ∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) :=
by
  intro hj_open hj_comm hj_cov
  haveI : ∀ α : Fin N, AlgebraicGeometry.IsOpenImmersion (j_D α) := hj_open
  have hLocalSm1 : AlgebraicGeometry.IsZariskiLocalAtSource
      (@AlgebraicGeometry.SmoothOfRelativeDimension 1) :=
    AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)
      (Q := fun {R S} [CommRing R] [CommRing S] =>
        RingHom.Locally (fun {R S} [CommRing R] [CommRing S] =>
          RingHom.IsStandardSmoothOfRelativeDimension 1))
  have hRespOpenSm1 :
      CategoryTheory.MorphismProperty.RespectsLeft
        (@AlgebraicGeometry.SmoothOfRelativeDimension 1)
        @AlgebraicGeometry.IsOpenImmersion :=
    AlgebraicGeometry.IsZariskiLocalAtSource.respectsLeft_isOpenImmersion

  
  
  
  have hS1_away : ∀ (α : Fin N) (g : D α) (q : PrimeSpectrum (D α)),
      g ∉ q.asIdeal →
      RingHom.IsStandardSmoothOfRelativeDimension 1
        (algebraMap Ω (Localization.Away g)) →
      ∃ V : Y.Opens, (j_D α).base q ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_Y) := by
    intro α g q hg_q hg_sm
    let ι_g : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (D α)) :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (D α) (Localization.Away g)))
    have : AlgebraicGeometry.IsOpenImmersion ι_g :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
    let g_map : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶ Y :=
      ι_g ≫ j_D α
    have : AlgebraicGeometry.IsOpenImmersion g_map := inferInstance
    let V : Y.Opens := g_map.opensRange
    have hq_mem : (j_D α).base q ∈ V := by
      have hq_basic : q ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum (D α))) := hg_q
      rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away g) g] at hq_basic
      obtain ⟨q_g, hq_g⟩ := hq_basic
      refine ⟨q_g, ?_⟩
      change (j_D α).base (PrimeSpectrum.comap (algebraMap (D α) (Localization.Away g)) q_g) =
        (j_D α).base q
      rw [hq_g]
    have hg_comm : g_map ≫ p_Y =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap Ω (Localization.Away g))) := by
      change (ι_g ≫ j_D α) ≫ p_Y = _
      rw [CategoryTheory.Category.assoc, hj_comm α, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq Ω (D α) (Localization.Away g)]
    have hSm_spec : AlgebraicGeometry.SmoothOfRelativeDimension 1 (g_map ≫ p_Y) := by
      rw [hg_comm]
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr
        (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ hg_sm)
    have hSm_V : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_Y) := by
      have h_inv_g : g_map.isoOpensRange.inv ≫ g_map = V.ι := by
        calc
          g_map.isoOpensRange.inv ≫ g_map
              = g_map.isoOpensRange.inv ≫ (g_map.isoOpensRange.hom ≫ V.ι) :=
                congrArg (g_map.isoOpensRange.inv ≫ ·)
                  (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι g_map).symm
          _ = (g_map.isoOpensRange.inv ≫ g_map.isoOpensRange.hom) ≫ V.ι :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = 𝟙 _ ≫ V.ι := by rw [g_map.isoOpensRange.inv_hom_id]
          _ = V.ι := CategoryTheory.Category.id_comp V.ι
      rw [← h_inv_g, CategoryTheory.Category.assoc]
      exact hRespOpenSm1.precomp g_map.isoOpensRange.inv inferInstance (g_map ≫ p_Y) hSm_spec
    exact ⟨V, hq_mem, hSm_V⟩

  have hS1_nodal : ∀ (α : Fin N) (q : PrimeSpectrum (D α))
      (B : Type u) [CommRing B] (q' : PrimeSpectrum B)
      (φ_D : D α →+* B)
      (φ_node : (MvPolynomial (Fin 2) Ω ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
          Set (MvPolynomial (Fin 2) Ω))) →+* B),
      φ_D.Etale →
      φ_node.Etale →
      PrimeSpectrum.comap φ_D q' = q →
      (∀ i : Fin 2, φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q'.asIdeal) →
      φ_D.comp (algebraMap Ω (D α)) =
        φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) →
      HasSpreadSmoothOrNodalAt p_Y ((j_D α).base q) := by
    intro α q B _ q' φ_D φ_node hEtD hEtNode hComap hAll hComm
    right
    let e_D : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (D α)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_D)
    let e₂ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) Ω ⧸
            Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
              Set (MvPolynomial (Fin 2) Ω)))) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_node)
    haveI : AlgebraicGeometry.Etale e_D :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEtD
    haveI : AlgebraicGeometry.Etale e₂ :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEtNode
    refine ⟨AlgebraicGeometry.Spec (CommRingCat.of B), q', e_D ≫ j_D α, e₂,
      inferInstance, inferInstance, ?_, ?_, ?_⟩
    · change (j_D α).base (PrimeSpectrum.comap φ_D q') = (j_D α).base q
      rw [hComap]
    · intro i
      exact hAll i
    · rw [CategoryTheory.Category.assoc, hj_comm α, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hComm, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp]

  
  
  
  have hEtaleNilZero : ∀ (R S K : Type u) [CommRing R] [CommRing S] [Algebra R S]
      [Algebra.Etale R S] [Field K] [Algebra R K] (x : S),
      IsNilpotent x → (x ⊗ₜ[R] (1 : K) : TensorProduct R S K) = 0 := by
    clear! N Y
    intro R S K _ _ _ _ _ _ x hx
    haveI : _root_.IsReduced (TensorProduct R K S) :=
      Algebra.FormallyUnramified.isReduced_of_field K (TensorProduct R K S)
    have hx_KS : ((1 : K) ⊗ₜ[R] x : TensorProduct R K S) = 0 := by
      have hnil : IsNilpotent ((1 : K) ⊗ₜ[R] x : TensorProduct R K S) := by
        change IsNilpotent (Algebra.TensorProduct.includeRight (R := R) (A := K) (B := S) x)
        exact hx.map (Algebra.TensorProduct.includeRight (R := R) (A := K) (B := S)).toRingHom
      exact hnil.eq_zero
    simpa using congrArg (TensorProduct.comm R K S) hx_KS

  have hS2_red : ∀ (A_D : Type u) [CommRing A_D] [Algebra Ω A_D]
      (m : ℕ) (f : Fin m → A_D)
      (s : ℕ) (𝒟' : Fin s → Type u) (_ : ∀ ν : Fin s, CommRing (𝒟' ν))
      (φ_D : ∀ ν : Fin s, A_D →+* 𝒟' ν)
      (φ_node : ∀ ν : Fin s,
        (MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
            Set (MvPolynomial (Fin 2) Ω))) →+* 𝒟' ν),
      (∀ μ : Fin m,
        RingHom.IsStandardSmoothOfRelativeDimension 1
          (algebraMap Ω (Localization.Away (f μ)))) →
      (∀ ν : Fin s, (φ_D ν).Etale) →
      (∀ ν : Fin s, (φ_node ν).Etale) →
      (⋃ μ : Fin m, (PrimeSpectrum.basicOpen (f μ) : Set (PrimeSpectrum A_D))) ∪
        (⋃ ν : Fin s, Set.range (PrimeSpectrum.comap (φ_D ν))) = Set.univ →
      _root_.IsReduced A_D := by
    clear! N Y
    intro A_D _ _ m f s 𝒟' instCR_𝒟' φ_D φ_node hf_sm hEtD hEtNode hCov
    letI : ∀ ν : Fin s, CommRing (𝒟' ν) := instCR_𝒟'
    
    have hRedAway : ∀ μ : Fin m, _root_.IsReduced (Localization.Away (f μ)) := by
      intro μ
      obtain ⟨g_et, _, hg_et⟩ := (hf_sm μ).exists_etale_mvPolynomial
      let P₁ := MvPolynomial (Fin 1) Ω
      let S := Localization.Away (f μ)
      letI : Algebra P₁ S := g_et.toAlgebra
      haveI : Algebra.Etale P₁ S := hg_et.toAlgebra
      let K₁ := FractionRing P₁
      have hInj₁ : Function.Injective (Algebra.linearMap P₁ K₁) :=
        IsFractionRing.injective P₁ K₁
      have hInjT : Function.Injective (LinearMap.lTensor S (Algebra.linearMap P₁ K₁)) :=
        Module.Flat.lTensor_preserves_injective_linearMap (Algebra.linearMap P₁ K₁) hInj₁
      refine ⟨fun x hx => ?_⟩
      have h1 : LinearMap.lTensor S (Algebra.linearMap P₁ K₁) (x ⊗ₜ[P₁] (1 : P₁)) = 0 := by
        change (x ⊗ₜ[P₁] (algebraMap P₁ K₁ 1) : TensorProduct P₁ S K₁) = 0
        rw [map_one]
        exact hEtaleNilZero P₁ S K₁ x hx
      have h2 : (x ⊗ₜ[P₁] (1 : P₁) : TensorProduct P₁ S P₁) = 0 :=
        hInjT (h1.trans (map_zero _).symm)
      simpa using congrArg (TensorProduct.rid P₁ S) h2
    
    let J_node : Ideal (MvPolynomial (Fin 2) Ω) :=
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))
    let R_node := MvPolynomial (Fin 2) Ω ⧸ J_node
    let K₀ := FractionRing (Polynomial Ω)
    let K₁ := FractionRing (MvPolynomial (Fin 1) Ω)
    let π₀_raw : MvPolynomial (Fin 2) Ω →ₐ[Ω] Polynomial Ω :=
      MvPolynomial.aeval ![Polynomial.X, 0]
    let π₁_mv : MvPolynomial (Fin 2) Ω →ₐ[Ω] MvPolynomial (Fin 1) Ω :=
      MvPolynomial.aeval ![0, MvPolynomial.X 0]
    have hKer₀ : J_node ≤ RingHom.ker π₀_raw.toRingHom := by
      refine Ideal.span_le.mpr ?_
      intro p hp
      rw [Set.mem_singleton_iff.mp hp]
      change π₀_raw (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      simp [π₀_raw]
    have hKer₁ : J_node ≤ RingHom.ker π₁_mv.toRingHom := by
      refine Ideal.span_le.mpr ?_
      intro p hp
      rw [Set.mem_singleton_iff.mp hp]
      change π₁_mv (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      simp [π₁_mv]
    let κ₀ : R_node →+* K₀ :=
      (algebraMap (Polynomial Ω) K₀).comp (Ideal.Quotient.lift J_node π₀_raw.toRingHom hKer₀)
    let κ₁ : R_node →+* K₁ :=
      (algebraMap (MvPolynomial (Fin 1) Ω) K₁).comp
        (Ideal.Quotient.lift J_node π₁_mv.toRingHom hKer₁)
    have hNodeInj : ∀ r : R_node, κ₀ r = 0 → κ₁ r = 0 → r = 0 := by
      intro r hr₀ hr₁
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
      have hF₀ : π₀_raw F = 0 := by
        apply IsFractionRing.injective (Polynomial Ω) K₀
        rw [map_zero]
        exact hr₀
      have hF₁_mv : π₁_mv F = 0 := by
        apply IsFractionRing.injective (MvPolynomial (Fin 1) Ω) K₁
        rw [map_zero]
        exact hr₁
      let π₁_poly : MvPolynomial (Fin 2) Ω →ₐ[Ω] Polynomial Ω :=
        MvPolynomial.aeval ![0, Polynomial.X]
      have h_comp_poly :
          (MvPolynomial.aeval (fun _ : Fin 1 => (Polynomial.X : Polynomial Ω))).comp π₁_mv =
            π₁_poly := by
        apply MvPolynomial.algHom_ext
        intro i
        fin_cases i <;> simp [π₁_mv, π₁_poly]
      have hF₁ : π₁_poly F = 0 := by
        rw [← h_comp_poly]
        simp [hF₁_mv]
      have hCoeff₀ : ∀ a : ℕ, F.coeff (Finsupp.single 0 a) = 0 := by
        intro a
        have h0 : Polynomial.coeff (π₀_raw F) a = 0 := by rw [hF₀, Polynomial.coeff_zero]
        rw [MvPolynomial.as_sum F, map_sum, Polynomial.finsetSum_coeff] at h0
        have hterm : ∀ d ∈ F.support,
            Polynomial.coeff (π₀_raw (MvPolynomial.monomial d (F.coeff d))) a =
              if d = Finsupp.single 0 a then F.coeff d else 0 := by
          intro d _
          rw [MvPolynomial.aeval_monomial, Polynomial.algebraMap_eq, Finsupp.prod_pow]
          simp only [Fin.prod_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
          by_cases hd1 : d 1 = 0
          · rw [hd1, pow_zero, mul_one, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            by_cases hd0 : d 0 = a
            · have hdeq : d = Finsupp.single 0 a := by
                ext j; fin_cases j <;> simp [hd0, hd1]
              simp [hdeq]
            · have hdne : d ≠ Finsupp.single 0 a := by
                intro h; apply hd0; simpa using congrArg (fun g : Fin 2 →₀ ℕ => g 0) h
              have hne_a : a ≠ d 0 := Ne.symm hd0
              simp [hne_a, hdne]
          · rw [zero_pow hd1, mul_zero, mul_zero, Polynomial.coeff_zero]
            have hdne : d ≠ Finsupp.single 0 a := by
              intro h; apply hd1; simpa using congrArg (fun g : Fin 2 →₀ ℕ => g 1) h
            simp [hdne]
        rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq'] at h0
        by_contra hne
        have hmem : Finsupp.single 0 a ∈ F.support := MvPolynomial.mem_support_iff.mpr hne
        simp [hmem] at h0
        exact hne h0
      have hCoeff₁ : ∀ b : ℕ, F.coeff (Finsupp.single 1 b) = 0 := by
        intro b
        have h0 : Polynomial.coeff (π₁_poly F) b = 0 := by rw [hF₁, Polynomial.coeff_zero]
        rw [MvPolynomial.as_sum F, map_sum, Polynomial.finsetSum_coeff] at h0
        have hterm : ∀ d ∈ F.support,
            Polynomial.coeff (π₁_poly (MvPolynomial.monomial d (F.coeff d))) b =
              if d = Finsupp.single 1 b then F.coeff d else 0 := by
          intro d _
          rw [MvPolynomial.aeval_monomial, Polynomial.algebraMap_eq, Finsupp.prod_pow]
          simp only [Fin.prod_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
          by_cases hd0 : d 0 = 0
          · rw [hd0, pow_zero, one_mul, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            by_cases hd1 : d 1 = b
            · have hdeq : d = Finsupp.single 1 b := by
                ext j; fin_cases j <;> simp [hd0, hd1]
              simp [hdeq]
            · have hdne : d ≠ Finsupp.single 1 b := by
                intro h; apply hd1; simpa using congrArg (fun g : Fin 2 →₀ ℕ => g 1) h
              have hne_b : b ≠ d 1 := Ne.symm hd1
              simp [hne_b, hdne]
          · rw [zero_pow hd0, zero_mul, mul_zero, Polynomial.coeff_zero]
            have hdne : d ≠ Finsupp.single 1 b := by
              intro h; apply hd0; simpa using congrArg (fun g : Fin 2 →₀ ℕ => g 0) h
            simp [hdne]
        rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq'] at h0
        by_contra hne
        have hmem : Finsupp.single 1 b ∈ F.support := MvPolynomial.mem_support_iff.mpr hne
        simp [hmem] at h0
        exact hne h0
      have hF_mem : F ∈ J_node := by
        rw [MvPolynomial.as_sum F]
        refine Submodule.sum_mem J_node ?_
        intro d hd
        have hne : F.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hd0 : d 0 ≠ 0 := by
          intro h0
          have hdeq : d = Finsupp.single 1 (d 1) := by
            ext j; fin_cases j <;> simp [h0]
          exact hne (hdeq ▸ hCoeff₁ (d 1))
        have hd1 : d 1 ≠ 0 := by
          intro h1
          have hdeq : d = Finsupp.single 0 (d 0) := by
            ext j; fin_cases j <;> simp [h1]
          exact hne (hdeq ▸ hCoeff₀ (d 0))
        obtain ⟨k₀, hk₀⟩ := Nat.exists_eq_succ_of_ne_zero hd0
        obtain ⟨k₁, hk₁⟩ := Nat.exists_eq_succ_of_ne_zero hd1
        rw [MvPolynomial.monomial_eq, Finsupp.prod_pow, Fin.prod_univ_two, hk₀, hk₁]
        have h_eq :
            MvPolynomial.C (F.coeff d) *
              (MvPolynomial.X (0 : Fin 2) ^ (k₀ + 1) * MvPolynomial.X (1 : Fin 2) ^ (k₁ + 1)) =
            (MvPolynomial.C (F.coeff d) *
              MvPolynomial.X (0 : Fin 2) ^ k₀ * MvPolynomial.X (1 : Fin 2) ^ k₁) *
              (MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) := by
          ring
        rw [h_eq]
        exact Ideal.mul_mem_left J_node _ (Ideal.subset_span rfl)
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hF_mem
    letI : Algebra R_node K₀ := κ₀.toAlgebra
    letI : Algebra R_node K₁ := κ₁.toAlgebra
    let lam_node : R_node →ₗ[R_node] K₀ × K₁ :=
      LinearMap.prod (Algebra.linearMap R_node K₀) (Algebra.linearMap R_node K₁)
    have hInj_lam : Function.Injective lam_node := by
      intro r₁ r₂ h
      have hsub : lam_node (r₁ - r₂) = 0 := by rw [map_sub, h, sub_self]
      have h0 : κ₀ (r₁ - r₂) = 0 := congrArg Prod.fst hsub
      have h1 : κ₁ (r₁ - r₂) = 0 := congrArg Prod.snd hsub
      exact sub_eq_zero.mp (hNodeInj (r₁ - r₂) h0 h1)
    have hRedRoof : ∀ ν : Fin s, _root_.IsReduced (𝒟' ν) := by
      intro ν
      let S := 𝒟' ν
      letI : Algebra R_node S := (φ_node ν).toAlgebra
      haveI : Algebra.Etale R_node S := (hEtNode ν).toAlgebra
      have hInjT : Function.Injective (LinearMap.lTensor S lam_node) :=
        Module.Flat.lTensor_preserves_injective_linearMap lam_node hInj_lam
      refine ⟨fun x hx => ?_⟩
      let z : TensorProduct R_node S (K₀ × K₁) :=
        LinearMap.lTensor S lam_node (x ⊗ₜ[R_node] (1 : R_node))
      have hz_prod : TensorProduct.prodRight R_node R_node S K₀ K₁ z = 0 := by
        apply Prod.ext
        · change (x ⊗ₜ[R_node] (κ₀ 1) : TensorProduct R_node S K₀) = 0
          rw [map_one]
          exact hEtaleNilZero R_node S K₀ x hx
        · change (x ⊗ₜ[R_node] (κ₁ 1) : TensorProduct R_node S K₁) = 0
          rw [map_one]
          exact hEtaleNilZero R_node S K₁ x hx
      have hz_zero : z = 0 :=
        (TensorProduct.prodRight R_node R_node S K₀ K₁).injective
          (hz_prod.trans (map_zero _).symm)
      have hx_tp : (x ⊗ₜ[R_node] (1 : R_node) : TensorProduct R_node S R_node) = 0 :=
        hInjT (hz_zero.trans (map_zero _).symm)
      simpa using congrArg (TensorProduct.rid R_node S) hx_tp
    
    refine ⟨fun x hx => ?_⟩
    let Ann_x : Ideal A_D :=
      { carrier := {r : A_D | r * x = 0}
        add_mem' := fun {a b} ha hb => by
          change (a + b) * x = 0
          rw [add_mul, ha, hb, add_zero]
        zero_mem' := zero_mul x
        smul_mem' := fun c {a} ha => by
          change (c * a) * x = 0
          rw [mul_assoc, ha, mul_zero] }
    have hAnn_top : Ann_x = ⊤ := by
      by_contra hNeTop
      obtain ⟨𝔪, hMax, hAnn_le⟩ := Ideal.exists_le_maximal Ann_x hNeTop
      let p : PrimeSpectrum A_D := ⟨𝔪, hMax.isPrime⟩
      have hp_univ : p ∈
          (⋃ μ : Fin m, (PrimeSpectrum.basicOpen (f μ) : Set (PrimeSpectrum A_D))) ∪
            (⋃ ν : Fin s, Set.range (PrimeSpectrum.comap (φ_D ν))) := by
        rw [hCov]; trivial
      rcases hp_univ with hp_sm | hp_rf
      · obtain ⟨μ, hf_not_mem⟩ := Set.mem_iUnion.mp hp_sm
        haveI : _root_.IsReduced (Localization.Away (f μ)) := hRedAway μ
        have hx_loc : algebraMap A_D (Localization.Away (f μ)) x = 0 :=
          (hx.map (algebraMap A_D (Localization.Away (f μ)))).eq_zero
        obtain ⟨⟨_, k, rfl⟩, hk_mul⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (f μ))
            (Localization.Away (f μ)) x).mp hx_loc
        have hpow_mem : (f μ) ^ k ∈ p.asIdeal := hAnn_le hk_mul
        exact hf_not_mem (p.isPrime.mem_of_pow_mem k hpow_mem)
      · obtain ⟨ν, p', hp'⟩ := Set.mem_iUnion.mp hp_rf
        haveI : _root_.IsReduced (𝒟' ν) := hRedRoof ν
        have hx_rf : φ_D ν x = 0 := (hx.map (φ_D ν)).eq_zero
        have hFlat_φD : (φ_D ν).Flat := by
          letI : Algebra A_D (𝒟' ν) := (φ_D ν).toAlgebra
          haveI : Algebra.Etale A_D (𝒟' ν) := (hEtD ν).toAlgebra
          exact (RingHom.flat_algebraMap_iff (R := A_D) (S := 𝒟' ν)).mpr inferInstance
        have hQP : p.asIdeal = Ideal.comap (φ_D ν) p'.asIdeal :=
          congrArg PrimeSpectrum.asIdeal hp'.symm
        let L_D := Localization.AtPrime p.asIdeal
        let L' := Localization.AtPrime p'.asIdeal
        let ψ_loc : L_D →+* L' :=
          Localization.localRingHom p.asIdeal p'.asIdeal (φ_D ν) hQP
        have hFlat_loc : ψ_loc.Flat :=
          RingHom.Flat.localRingHom hFlat_φD p'.asIdeal p.asIdeal hQP
        letI : Algebra L_D L' := ψ_loc.toAlgebra
        haveI : Module.Flat L_D L' :=
          (RingHom.flat_algebraMap_iff (R := L_D) (S := L')).mpr hFlat_loc
        haveI : IsLocalHom (algebraMap L_D L') :=
          Localization.isLocalHom_localRingHom p.asIdeal p'.asIdeal (φ_D ν) hQP
        haveI : Module.FaithfullyFlat L_D L' :=
          Module.FaithfullyFlat.of_flat_of_isLocalHom
        have hInj_loc : Function.Injective (algebraMap L_D L') :=
          FaithfulSMul.algebraMap_injective L_D L'
        have h_map_zero : algebraMap L_D L' (algebraMap A_D L_D x) = 0 := by
          change ψ_loc (algebraMap A_D L_D x) = 0
          rw [Localization.localRingHom_to_map, hx_rf, map_zero]
        have hx_LD : algebraMap A_D L_D x = 0 :=
          hInj_loc (h_map_zero.trans (map_zero _).symm)
        obtain ⟨⟨s₀, hs₀⟩, hs₀_mul⟩ :=
          (IsLocalization.map_eq_zero_iff p.asIdeal.primeCompl L_D x).mp hx_LD
        exact hs₀ (hAnn_le hs₀_mul)
    have h1_mem : (1 : A_D) ∈ Ann_x := by rw [hAnn_top]; trivial
    simpa [Ann_x] using h1_mem

  
  
  
  have hExistsEvB : ∀ (B : Type u) [CommRing B] [Algebra Ω B] [Algebra.FiniteType Ω B]
      (q' : PrimeSpectrum B) (x₀ : B),
      x₀ ∉ q'.asIdeal →
      ∃ ev_B : B →ₐ[Ω] Ω,
        q'.asIdeal ≤ RingHom.ker ev_B.toRingHom ∧ ev_B x₀ ≠ 0 := by
    clear! N Y hEtaleNilZero hS2_red
    intro B _ _ hFT_B q' x₀ hi₀
    let B' := Localization.Away x₀
    have : Algebra.FinitePresentation B B' := IsLocalization.Away.finitePresentation x₀
    have hFT_B' : Algebra.FiniteType Ω B' := Algebra.FiniteType.trans hFT_B inferInstance
    have hDisj : Disjoint (Submonoid.powers x₀ : Set B) (q'.asIdeal : Set B) := by
      refine Set.disjoint_left.mpr ?_
      rintro _ ⟨k, rfl⟩ hpow
      exact hi₀ (q'.isPrime.mem_of_pow_mem k hpow)
    let P' : Ideal B' := Ideal.map (algebraMap B B') q'.asIdeal
    have hP'_prime : P'.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers x₀) B' q'.asIdeal q'.isPrime hDisj
    obtain ⟨𝔪', h𝔪'_max, hP'_le⟩ := Ideal.exists_le_maximal P' hP'_prime.ne_top
    obtain ⟨n_poly, π_poly, hSurj_π⟩ :=
      Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_B'
    let M_poly : Ideal (MvPolynomial (Fin n_poly) Ω) :=
      Ideal.comap π_poly.toRingHom 𝔪'
    have hM_max : M_poly.IsMaximal :=
      Ideal.comap_isMaximal_of_surjective π_poly.toRingHom hSurj_π
    obtain ⟨pt, hM_eq⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := M_poly)).mp hM_max
    have hKer_le : RingHom.ker π_poly ≤ RingHom.ker (MvPolynomial.aeval pt).toRingHom := by
      intro p hp
      have hp_M : p ∈ M_poly := by
        change π_poly p ∈ 𝔪'
        have hp0 : π_poly p = 0 := hp
        rw [hp0]
        exact 𝔪'.zero_mem
      rw [hM_eq, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hp_M
      exact hp_M
    let ev_B' : B' →ₐ[Ω] Ω :=
      (Ideal.Quotient.liftₐ (RingHom.ker π_poly) (MvPolynomial.aeval pt) hKer_le).comp
        (Ideal.quotientKerAlgEquivOfSurjective hSurj_π).symm.toAlgHom
    have hev_π : ∀ p : MvPolynomial (Fin n_poly) Ω,
        ev_B' (π_poly p) = MvPolynomial.aeval pt p := by
      intro p
      change Ideal.Quotient.liftₐ (RingHom.ker π_poly) (MvPolynomial.aeval pt) hKer_le
        ((Ideal.quotientKerAlgEquivOfSurjective hSurj_π).symm (π_poly p)) = _
      rw [Ideal.quotientKerAlgEquivOfSurjective_symm_apply]
      rfl
    have hKer_evB' : RingHom.ker ev_B'.toRingHom = 𝔪' := by
      ext b
      obtain ⟨p, rfl⟩ := hSurj_π b
      change ev_B' (π_poly p) = 0 ↔ π_poly p ∈ 𝔪'
      rw [hev_π p, ← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← hM_eq]
      rfl
    let ev_B : B →ₐ[Ω] Ω := ev_B'.comp (IsScalarTower.toAlgHom Ω B B')
    refine ⟨ev_B, ?_, ?_⟩
    · intro b hb
      have hb' : algebraMap B B' b ∈ 𝔪' :=
        hP'_le (Ideal.mem_map_of_mem (algebraMap B B') hb)
      rw [← hKer_evB'] at hb'
      exact hb'
    · change ev_B' (algebraMap B B' x₀) ≠ 0
      exact ((IsLocalization.Away.algebraMap_isUnit x₀).map ev_B'.toRingHom).ne_zero

  have hS3_offNode : ∀ (A_D : Type u) [CommRing A_D] [Algebra Ω A_D] [Algebra.FiniteType Ω A_D]
      (q : PrimeSpectrum A_D)
      (B : Type u) [CommRing B] (q' : PrimeSpectrum B)
      (φ_D : A_D →+* B)
      (φ_node : (MvPolynomial (Fin 2) Ω ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
          Set (MvPolynomial (Fin 2) Ω))) →+* B)
      (i₀ : Fin 2),
      φ_D.Etale →
      φ_node.Etale →
      PrimeSpectrum.comap φ_D q' = q →
      φ_D.comp (algebraMap Ω A_D) =
        φ_node.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) →
      φ_node (Ideal.Quotient.mk _ (MvPolynomial.X i₀)) ∉ q'.asIdeal →
      ∃ 𝔪 : PrimeSpectrum A_D,
        𝔪.asIdeal.IsMaximal ∧
        q.asIdeal ≤ 𝔪.asIdeal ∧
        (let L := Localization.AtPrime 𝔪.asIdeal
         let 𝔪_L : Ideal L := IsLocalRing.maximalIdeal L
         Module.finrank Ω (L ⧸ 𝔪_L ^ 2) = 2) := by
    clear! N Y hEtaleNilZero hS2_red
    intro A_D _ _ _ q B _ q' φ_D φ_node i₀ hEtD hEtNode hComap hComm hi₀
    let I_rel : Ideal (MvPolynomial (Fin 2) Ω) :=
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))
    let R_node := MvPolynomial (Fin 2) Ω ⧸ I_rel
    let xbar : Fin 2 → R_node := fun j => Ideal.Quotient.mk I_rel (MvPolynomial.X j)
    let x₀ : B := φ_node (xbar i₀)
    
    letI : Algebra Ω B := (φ_D.comp (algebraMap Ω A_D)).toAlgebra
    have hFT_B : Algebra.FiniteType Ω B := by
      letI : Algebra A_D B := φ_D.toAlgebra
      have : IsScalarTower Ω A_D B := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.Etale A_D B := hEtD.toAlgebra
      exact Algebra.FiniteType.trans ‹Algebra.FiniteType Ω A_D› inferInstance
    obtain ⟨ev_B, hq'_le_evB, hx₀_ne⟩ := hExistsEvB B q' x₀ hi₀
    let φ_D_alg : A_D →ₐ[Ω] B :=
      { φ_D with commutes' := fun _ => rfl }
    let ev_D : A_D →ₐ[Ω] Ω := ev_B.comp φ_D_alg
    let φ_node_alg : R_node →ₐ[Ω] B :=
      { φ_node with
        commutes' := fun a => (RingHom.congr_fun hComm a).symm }
    let ev_node : R_node →ₐ[Ω] Ω := ev_B.comp φ_node_alg
    let 𝔪_D : Ideal A_D := RingHom.ker ev_D.toRingHom
    have hSurj_evD : Function.Surjective ev_D.toRingHom := by
      intro a
      exact ⟨algebraMap Ω A_D a, ev_D.commutes a⟩
    have h𝔪_max : 𝔪_D.IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ev_D.toRingHom hSurj_evD
    let 𝔪 : PrimeSpectrum A_D := ⟨𝔪_D, h𝔪_max.isPrime⟩
    have hq_le_𝔪 : q.asIdeal ≤ 𝔪.asIdeal := by
      intro d hd
      have hd_q' : φ_D d ∈ q'.asIdeal := by
        rw [← hComap] at hd
        exact hd
      exact hq'_le_evB hd_q'
    let c : Ω := ev_node (xbar i₀)
    have hc : c ≠ 0 := hx₀_ne
    have hAlgSelf : ∀ a : Ω, algebraMap Ω Ω a = a := fun _ => rfl
    
    let L := Localization.AtPrime 𝔪.asIdeal
    let 𝔪_L : Ideal L := IsLocalRing.maximalIdeal L
    have hMap_𝔪 : Ideal.map (algebraMap A_D L) 𝔪_D = 𝔪_L :=
      Localization.AtPrime.map_eq_maximalIdeal
    let to_QL : A_D →ₐ[Ω] (L ⧸ 𝔪_L ^ 2) :=
      (Ideal.Quotient.mkₐ Ω (𝔪_L ^ 2)).comp (IsScalarTower.toAlgHom Ω A_D L)
    have hKer_toQL : 𝔪_D ^ 2 ≤ RingHom.ker to_QL := by
      intro d hd
      change Ideal.Quotient.mk (𝔪_L ^ 2) (algebraMap A_D L d) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hMap_𝔪, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem (algebraMap A_D L) hd
    let fwd_loc : (A_D ⧸ 𝔪_D ^ 2) →ₐ[Ω] (L ⧸ 𝔪_L ^ 2) :=
      Ideal.Quotient.liftₐ (𝔪_D ^ 2) to_QL hKer_toQL
    let mk_D2 : A_D →+* (A_D ⧸ 𝔪_D ^ 2) := Ideal.Quotient.mk (𝔪_D ^ 2)
    have hUnit_D2 : ∀ y : 𝔪.asIdeal.primeCompl, IsUnit (mk_D2 y.1) := by
      intro y
      have hy_ne : ev_D y.1 ≠ 0 := y.2
      let r : A_D := algebraMap Ω A_D (ev_D y.1)⁻¹
      have h_mem : 1 - r * y.1 ∈ 𝔪_D := by
        change ev_D (1 - r * y.1) = 0
        rw [map_sub, map_one, map_mul, ev_D.commutes, hAlgSelf, inv_mul_cancel₀ hy_ne, sub_self]
      have h_sq : mk_D2 ((1 - r * y.1) ^ 2) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow h_mem 2)
      have h_mul1 : mk_D2 y.1 * mk_D2 (r * (2 - r * y.1)) = 1 := by
        rw [← map_mul]
        have h_id : y.1 * (r * (2 - r * y.1)) = 1 - (1 - r * y.1) ^ 2 := by ring
        rw [h_id, map_sub, map_one, h_sq, sub_zero]
      exact ⟨⟨mk_D2 y.1, mk_D2 (r * (2 - r * y.1)), h_mul1,
        by rw [mul_comm]; exact h_mul1⟩, rfl⟩
    let lift_L_ring : L →+* (A_D ⧸ 𝔪_D ^ 2) := IsLocalization.lift hUnit_D2
    let lift_L : L →ₐ[Ω] (A_D ⧸ 𝔪_D ^ 2) :=
      { lift_L_ring with
        commutes' := fun a => by
          change IsLocalization.lift hUnit_D2 (algebraMap Ω L a) = algebraMap Ω (A_D ⧸ 𝔪_D ^ 2) a
          rw [IsScalarTower.algebraMap_apply Ω A_D L a, IsLocalization.lift_eq]
          rfl }
    have hKer_liftL : 𝔪_L ^ 2 ≤ RingHom.ker lift_L := by
      rw [← hMap_𝔪, ← Ideal.map_pow, Ideal.map_le_iff_le_comap]
      intro d hd
      change IsLocalization.lift hUnit_D2 (algebraMap A_D L d) = 0
      rw [IsLocalization.lift_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hd
    let inv_loc : (L ⧸ 𝔪_L ^ 2) →ₐ[Ω] (A_D ⧸ 𝔪_D ^ 2) :=
      Ideal.Quotient.liftₐ (𝔪_L ^ 2) lift_L hKer_liftL
    have h_inv_fwd_loc : inv_loc.comp fwd_loc = AlgHom.id Ω (A_D ⧸ 𝔪_D ^ 2) := by
      apply Ideal.Quotient.algHom_ext
      ext d
      change IsLocalization.lift hUnit_D2 (algebraMap A_D L d) = mk_D2 d
      exact IsLocalization.lift_eq hUnit_D2 d
    have h_fwd_inv_loc : fwd_loc.comp inv_loc = AlgHom.id Ω (L ⧸ 𝔪_L ^ 2) := by
      apply Ideal.Quotient.algHom_ext
      have h_ring : ((fwd_loc.comp inv_loc).comp (Ideal.Quotient.mkₐ Ω (𝔪_L ^ 2))).toRingHom =
          (Ideal.Quotient.mkₐ Ω (𝔪_L ^ 2)).toRingHom := by
        refine IsLocalization.ringHom_ext 𝔪.asIdeal.primeCompl ?_
        ext d
        change fwd_loc (IsLocalization.lift hUnit_D2 (algebraMap A_D L d)) =
          Ideal.Quotient.mk (𝔪_L ^ 2) (algebraMap A_D L d)
        rw [IsLocalization.lift_eq]
        rfl
      exact AlgHom.ext fun z => RingHom.congr_fun h_ring z
    let e_loc : (A_D ⧸ 𝔪_D ^ 2) ≃ₐ[Ω] (L ⧸ 𝔪_L ^ 2) :=
      AlgEquiv.ofAlgHom fwd_loc inv_loc h_fwd_inv_loc h_inv_fwd_loc
    
    have hEtaleJetEquiv : ∀ (R S : Type u) [CommRing R] [Algebra Ω R] [CommRing S] [Algebra Ω S]
        (ψ : R →ₐ[Ω] S) (ev_S : S →ₐ[Ω] Ω),
        ψ.toRingHom.Etale →
        Nonempty ((R ⧸ (RingHom.ker (ev_S.comp ψ).toRingHom) ^ 2) ≃ₐ[Ω]
          (S ⧸ (RingHom.ker ev_S.toRingHom) ^ 2)) := by
      clear! A_D B I_rel
      clear i₀ hExistsEvB
      have hSqMono : ∀ {A : Type u} [CommRing A] {I J : Ideal A},
          I ≤ J → I ^ 2 ≤ J ^ 2 := by
        intro A _ I J hIJ z hz
        rw [pow_two] at hz ⊢
        exact Submodule.mul_induction_on hz
          (fun a ha b hb => Ideal.mul_mem_mul (hIJ ha) (hIJ hb))
          (fun _ _ ha hb => add_mem ha hb)
      intro R S _ _ _ _ ψ ev_S hEtψ
      let ev_R : R →ₐ[Ω] Ω := ev_S.comp ψ
      let 𝔪_S : Ideal S := RingHom.ker ev_S.toRingHom
      let 𝔪_R : Ideal R := RingHom.ker ev_R.toRingHom
      let Q_R := R ⧸ 𝔪_R ^ 2
      let Q_S := S ⧸ 𝔪_S ^ 2
      have h_map_𝔪 : Ideal.map ψ.toRingHom (𝔪_R ^ 2) ≤ 𝔪_S ^ 2 := by
        rw [Ideal.map_pow]
        exact hSqMono (Ideal.map_le_iff_le_comap.mpr fun _ hr => hr)
      have hKer_fwd : 𝔪_R ^ 2 ≤ RingHom.ker ((Ideal.Quotient.mkₐ Ω (𝔪_S ^ 2)).comp ψ) := by
        intro r hr
        change Ideal.Quotient.mk (𝔪_S ^ 2) (ψ r) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (h_map_𝔪 (Ideal.mem_map_of_mem ψ.toRingHom hr))
      let fwd : Q_R →ₐ[Ω] Q_S :=
        Ideal.Quotient.liftₐ (𝔪_R ^ 2) ((Ideal.Quotient.mkₐ Ω (𝔪_S ^ 2)).comp ψ) hKer_fwd
      let I_R : Ideal Q_R := Ideal.map (Ideal.Quotient.mk (𝔪_R ^ 2)) 𝔪_R
      have hIR_sq : I_R ^ 2 = ⊥ := by
        rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
        intro r hr
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
      have hNil_IR : IsNilpotent I_R := ⟨2, hIR_sq⟩
      let bar_ev_R : Q_R →+* Ω :=
        Ideal.Quotient.lift (𝔪_R ^ 2) ev_R.toRingHom
          (Ideal.pow_le_self (by norm_num : (2 : ℕ) ≠ 0))
      have h_bar_IR : I_R ≤ RingHom.ker bar_ev_R := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        exact hr
      let res_QR : (Q_R ⧸ I_R) →+* Ω := Ideal.Quotient.lift I_R bar_ev_R h_bar_IR
      letI : Algebra R S := ψ.toRingHom.toAlgebra
      haveI : Algebra.Etale R S := hEtψ.toAlgebra
      let g : S →ₐ[R] (Q_R ⧸ I_R) :=
        { ((algebraMap Ω (Q_R ⧸ I_R)).comp ev_S.toRingHom) with
          commutes' := fun r => by
            change algebraMap Ω (Q_R ⧸ I_R) (ev_R r) =
              Ideal.Quotient.mk I_R (Ideal.Quotient.mk (𝔪_R ^ 2) r)
            symm
            rw [IsScalarTower.algebraMap_apply Ω R (Q_R ⧸ I_R) (ev_R r)]
            change Ideal.Quotient.mk I_R (Ideal.Quotient.mk (𝔪_R ^ 2) r) =
              Ideal.Quotient.mk I_R (Ideal.Quotient.mk (𝔪_R ^ 2) (algebraMap Ω R (ev_R r)))
            rw [Ideal.Quotient.eq]
            rw [← map_sub]
            refine Ideal.mem_map_of_mem (Ideal.Quotient.mk (𝔪_R ^ 2)) ?_
            change ev_R (r - algebraMap Ω R (ev_R r)) = 0
            rw [map_sub, ev_R.commutes, hAlgSelf, sub_self] }
      obtain ⟨gtilde, hgtilde⟩ := Algebra.FormallySmooth.exists_lift I_R hNil_IR g
      have h_bar_gtilde : ∀ s : S, bar_ev_R (gtilde s) = ev_S s := by
        intro s
        have h1 := congrArg res_QR (AlgHom.congr_fun hgtilde s)
        change res_QR (Ideal.Quotient.mk I_R (gtilde s)) =
          res_QR (algebraMap Ω (Q_R ⧸ I_R) (ev_S s)) at h1
        have h2 : res_QR (algebraMap Ω (Q_R ⧸ I_R) (ev_S s)) = ev_S s := by
          rw [IsScalarTower.algebraMap_apply Ω R (Q_R ⧸ I_R) (ev_S s)]
          change ev_R (algebraMap Ω R (ev_S s)) = ev_S s
          rw [ev_R.commutes, hAlgSelf]
        exact h1.trans h2
      have hKer_bar_R : RingHom.ker bar_ev_R ≤ I_R := by
        intro q_r hqr
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q_r
        exact Ideal.mem_map_of_mem (Ideal.Quotient.mk (𝔪_R ^ 2)) hqr
      have h_gtilde_𝔪 : Ideal.map gtilde.toRingHom 𝔪_S ≤ I_R := by
        rw [Ideal.map_le_iff_le_comap]
        intro s hs
        apply hKer_bar_R
        change bar_ev_R (gtilde s) = 0
        rw [h_bar_gtilde s]
        exact hs
      have h_gtilde_sq : 𝔪_S ^ 2 ≤ RingHom.ker gtilde.toRingHom := by
        rw [← Ideal.map_eq_bot_iff_le_ker, Ideal.map_pow, ← le_bot_iff, ← hIR_sq]
        exact hSqMono h_gtilde_𝔪
      let gtilde_Ω : S →ₐ[Ω] Q_R :=
        { gtilde.toRingHom with
          commutes' := fun a => by
            change gtilde (algebraMap Ω S a) = algebraMap Ω Q_R a
            have h_alg : algebraMap Ω S a = ψ (algebraMap Ω R a) := (ψ.commutes a).symm
            rw [h_alg]
            exact (gtilde.commutes (algebraMap Ω R a)).trans
              (IsScalarTower.algebraMap_apply Ω R Q_R a).symm }
      let inv : Q_S →ₐ[Ω] Q_R :=
        Ideal.Quotient.liftₐ (𝔪_S ^ 2) gtilde_Ω h_gtilde_sq
      have h_inv_fwd : inv.comp fwd = AlgHom.id Ω Q_R := by
        apply Ideal.Quotient.algHom_ext
        ext r
        exact gtilde.commutes r
      have h_fwd_inv : fwd.comp inv = AlgHom.id Ω Q_S := by
        let bar_ev_S : Q_S →+* Ω :=
          Ideal.Quotient.lift (𝔪_S ^ 2) ev_S.toRingHom
            (Ideal.pow_le_self (by norm_num : (2 : ℕ) ≠ 0))
        have hKS_sq : (RingHom.ker bar_ev_S) ^ 2 = ⊥ := by
          have hle : RingHom.ker bar_ev_S ≤ Ideal.map (Ideal.Quotient.mk (𝔪_S ^ 2)) 𝔪_S := by
            intro q_s hqs
            obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective q_s
            exact Ideal.mem_map_of_mem (Ideal.Quotient.mk (𝔪_S ^ 2)) hqs
          have hsq_le : (RingHom.ker bar_ev_S) ^ 2 ≤
              (Ideal.map (Ideal.Quotient.mk (𝔪_S ^ 2)) 𝔪_S) ^ 2 := hSqMono hle
          have hmap_sq : (Ideal.map (Ideal.Quotient.mk (𝔪_S ^ 2)) 𝔪_S) ^ 2 = ⊥ := by
            rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
            intro s hs
            exact Ideal.Quotient.eq_zero_iff_mem.mpr hs
          exact le_bot_iff.mp (hmap_sq ▸ hsq_le)
        have hNil_S : IsNilpotent (RingHom.ker bar_ev_S) := ⟨2, hKS_sq⟩
        letI : Algebra R Q_S := ((Ideal.Quotient.mk (𝔪_S ^ 2)).comp ψ.toRingHom).toAlgebra
        let u₁ : S →ₐ[R] Q_S :=
          { Ideal.Quotient.mk (𝔪_S ^ 2) with commutes' := fun _ => rfl }
        let u₂ : S →ₐ[R] Q_S :=
          { (fwd.toRingHom.comp gtilde.toRingHom) with
            commutes' := fun r => by
              change fwd (gtilde (ψ r)) = Ideal.Quotient.mk (𝔪_S ^ 2) (ψ r)
              have hgt_r : gtilde (ψ r) = Ideal.Quotient.mk (𝔪_R ^ 2) r := gtilde.commutes r
              rw [hgt_r]
              rfl }
        have h_bar_fwd : ∀ q_r : Q_R, bar_ev_S (fwd q_r) = bar_ev_R q_r := by
          intro q_r
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q_r
          rfl
        have hu_eq : u₁ = u₂ := by
          refine Algebra.FormallyUnramified.ext' bar_ev_S hNil_S u₁ u₂ ?_
          intro s
          change ev_S s = bar_ev_S (fwd (gtilde s))
          rw [h_bar_fwd (gtilde s), h_bar_gtilde s]
        apply Ideal.Quotient.algHom_ext
        ext s
        exact (AlgHom.congr_fun hu_eq s).symm
      exact ⟨AlgEquiv.ofAlgHom fwd inv h_fwd_inv h_inv_fwd⟩
    obtain ⟨e_DB⟩ := hEtaleJetEquiv A_D B φ_D_alg ev_B hEtD
    obtain ⟨e_nodeB⟩ := hEtaleJetEquiv R_node B φ_node_alg ev_B hEtNode
    let I_node : Ideal R_node := RingHom.ker ev_node.toRingHom
    let Θ : (L ⧸ 𝔪_L ^ 2) ≃ₐ[Ω] (R_node ⧸ I_node ^ 2) :=
      e_loc.symm.trans (e_DB.trans e_nodeB.symm)
    
    let Q := R_node ⧸ I_node ^ 2
    let q_node : R_node →+* Q := Ideal.Quotient.mk (I_node ^ 2)
    let t : Q := q_node (xbar i₀ - algebraMap Ω R_node c)
    have ht_mem : xbar i₀ - algebraMap Ω R_node c ∈ I_node := by
      change ev_node (xbar i₀ - algebraMap Ω R_node c) = 0
      rw [map_sub, ev_node.commutes, hAlgSelf, sub_self]
    have ht_sq : t ^ 2 = 0 := by
      change q_node ((xbar i₀ - algebraMap Ω R_node c) ^ 2) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow ht_mem 2)
    have hq_i₀ : q_node (xbar i₀) = algebraMap Ω Q c + t := by
      change q_node (xbar i₀) = q_node (algebraMap Ω R_node c) + q_node (xbar i₀ - algebraMap Ω R_node c)
      rw [← map_add, add_sub_cancel]
    have hxbar_mul : ∀ j : Fin 2, j ≠ i₀ → xbar i₀ * xbar j = 0 := by
      intro j hj
      fin_cases i₀ <;> fin_cases j
      · exact False.elim (hj rfl)
      · change Ideal.Quotient.mk I_rel (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      · rw [mul_comm]
        change Ideal.Quotient.mk I_rel (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      · exact False.elim (hj rfl)
    have hq_other : ∀ j : Fin 2, j ≠ i₀ → q_node (xbar j) = 0 := by
      intro j hj
      have hmul_zero : (algebraMap Ω Q c + t) * q_node (xbar j) = 0 := by
        rw [← hq_i₀, ← map_mul, hxbar_mul j hj, map_zero]
      let u_inv : Q := algebraMap Ω Q c⁻¹ - algebraMap Ω Q (c⁻¹ ^ 2) * t
      have hu_mul : u_inv * (algebraMap Ω Q c + t) = 1 := by
        have hc1 : algebraMap Ω Q c⁻¹ * algebraMap Ω Q c = 1 := by
          rw [← map_mul, inv_mul_cancel₀ hc, map_one]
        have hc_pow : c⁻¹ ^ 2 * c = c⁻¹ := by
          rw [pow_two, mul_assoc, inv_mul_cancel₀ hc, mul_one]
        have hc2 : algebraMap Ω Q (c⁻¹ ^ 2) * algebraMap Ω Q c = algebraMap Ω Q c⁻¹ := by
          rw [← map_mul, hc_pow]
        calc
          (algebraMap Ω Q c⁻¹ - algebraMap Ω Q (c⁻¹ ^ 2) * t) * (algebraMap Ω Q c + t)
              = (algebraMap Ω Q c⁻¹ * algebraMap Ω Q c) +
                  (algebraMap Ω Q c⁻¹ - (algebraMap Ω Q (c⁻¹ ^ 2) * algebraMap Ω Q c)) * t -
                  algebraMap Ω Q (c⁻¹ ^ 2) * t ^ 2 := by ring
          _ = 1 + (algebraMap Ω Q c⁻¹ - algebraMap Ω Q c⁻¹) * t -
                algebraMap Ω Q (c⁻¹ ^ 2) * 0 := by rw [hc1, hc2, ht_sq]
          _ = 1 := by ring
      calc
        q_node (xbar j) = 1 * q_node (xbar j) := (one_mul _).symm
        _ = (u_inv * (algebraMap Ω Q c + t)) * q_node (xbar j) := by rw [hu_mul]
        _ = u_inv * ((algebraMap Ω Q c + t) * q_node (xbar j)) := by rw [mul_assoc]
        _ = 0 := by rw [hmul_zero, mul_zero]
    let F : (Fin 2 → Ω) →ₗ[Ω] Q :=
      (LinearMap.proj (R := Ω) (φ := fun _ : Fin 2 => Ω) 0).smulRight (1 : Q) +
        (LinearMap.proj (R := Ω) (φ := fun _ : Fin 2 => Ω) 1).smulRight t
    have hF_apply : ∀ v : Fin 2 → Ω, F v = v 0 • (1 : Q) + v 1 • t := fun _ => rfl
    have hF_surj : Function.Surjective F := by
      intro y
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [MvPolynomial.as_sum P, map_sum, map_sum]
      refine Submodule.sum_mem (LinearMap.range F) ?_
      intro d _
      refine MvPolynomial.induction_on_monomial
        (motive := fun P₀ => q_node (Ideal.Quotient.mk I_rel P₀) ∈ LinearMap.range F)
        ?_ ?_ d (P.coeff d)
      · intro a
        refine ⟨![a, 0], ?_⟩
        rw [hF_apply]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, zero_smul, add_zero]
        rw [Algebra.smul_def, mul_one, ← MvPolynomial.algebraMap_eq]
        rfl
      · intro P₀ j h₀
        obtain ⟨v, hv⟩ := h₀
        change q_node (Ideal.Quotient.mk I_rel P₀ * xbar j) ∈ LinearMap.range F
        rw [map_mul, ← hv, hF_apply]
        by_cases hj : j = i₀
        · subst hj
          rw [hq_i₀]
          refine ⟨![v 0 * c, v 0 + v 1 * c], ?_⟩
          rw [hF_apply]
          simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Algebra.smul_def,
            map_mul, map_add]
          calc
            (algebraMap Ω Q (v 0) * algebraMap Ω Q c) * 1 +
                (algebraMap Ω Q (v 0) + algebraMap Ω Q (v 1) * algebraMap Ω Q c) * t
                = (algebraMap Ω Q (v 0) * 1 + algebraMap Ω Q (v 1) * t) *
                    (algebraMap Ω Q c + t) - algebraMap Ω Q (v 1) * t ^ 2 := by
                  ring
            _ = (algebraMap Ω Q (v 0) * 1 + algebraMap Ω Q (v 1) * t) *
                  (algebraMap Ω Q c + t) := by rw [ht_sq, mul_zero, sub_zero]
        · rw [hq_other j hj, mul_zero]
          exact ⟨0, map_zero F⟩
    
    let T := TrivSqZeroExt Ω Ω
    let w : Fin 2 → T :=
      fun j => if j = i₀ then TrivSqZeroExt.inl c + TrivSqZeroExt.inr (1 : Ω) else 0
    have hw_mul : w 0 * w 1 = 0 := by
      fin_cases i₀ <;> simp [w]
    let Ψ_raw : MvPolynomial (Fin 2) Ω →ₐ[Ω] T := MvPolynomial.aeval w
    have hKer_Ψraw : I_rel ≤ RingHom.ker Ψ_raw := by
      refine Ideal.span_le.mpr ?_
      intro p hp
      rw [Set.mem_singleton_iff.mp hp]
      change Ψ_raw (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X, hw_mul]
    let Ψ_node : R_node →ₐ[Ω] T := Ideal.Quotient.liftₐ I_rel Ψ_raw hKer_Ψraw
    have h_fst_Ψ : (TrivSqZeroExt.fstHom Ω Ω Ω).comp Ψ_node = ev_node := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro j
      change (Ψ_raw (MvPolynomial.X j)).fst = ev_node (xbar j)
      rw [MvPolynomial.aeval_X]
      by_cases hj : j = i₀
      · subst hj
        simp only [w, ↓reduceIte]
        exact add_zero c
      · simp only [w, hj, ↓reduceIte, TrivSqZeroExt.fst_zero]
        symm
        have h0 : c * ev_node (xbar j) = 0 := by
          change ev_node (xbar i₀) * ev_node (xbar j) = 0
          rw [← map_mul, hxbar_mul j hj, map_zero]
        rcases mul_eq_zero.mp h0 with hc0 | hxj
        · exact False.elim (hc hc0)
        · exact hxj
    have hKer_Ψnode : I_node ^ 2 ≤ RingHom.ker Ψ_node := by
      rw [pow_two]
      intro z hz
      refine Submodule.mul_induction_on hz ?_ ?_
      · intro r₁ hr₁ r₂ hr₂
        have hf₁ : (Ψ_node r₁).fst = 0 := by
          have h1 := AlgHom.congr_fun h_fst_Ψ r₁
          simpa using h1.trans hr₁
        have hf₂ : (Ψ_node r₂).fst = 0 := by
          have h2 := AlgHom.congr_fun h_fst_Ψ r₂
          simpa using h2.trans hr₂
        have heq₁ : Ψ_node r₁ = TrivSqZeroExt.inr (Ψ_node r₁).snd := by
          ext <;> simp [hf₁]
        have heq₂ : Ψ_node r₂ = TrivSqZeroExt.inr (Ψ_node r₂).snd := by
          ext <;> simp [hf₂]
        change Ψ_node (r₁ * r₂) = 0
        rw [map_mul, heq₁, heq₂, TrivSqZeroExt.inr_mul_inr]
      · intro a b ha hb
        change Ψ_node (a + b) = 0
        rw [map_add, ha, hb, add_zero]
    let Ψ_bar : Q →ₐ[Ω] T := Ideal.Quotient.liftₐ (I_node ^ 2) Ψ_node hKer_Ψnode
    have hΨ_t : Ψ_bar t = TrivSqZeroExt.inr (1 : Ω) := by
      change Ψ_node (xbar i₀ - algebraMap Ω R_node c) = TrivSqZeroExt.inr (1 : Ω)
      rw [map_sub, Ψ_node.commutes c]
      change Ψ_raw (MvPolynomial.X i₀) - algebraMap Ω T c = TrivSqZeroExt.inr (1 : Ω)
      rw [MvPolynomial.aeval_X]
      simp only [w, ↓reduceIte]
      apply TrivSqZeroExt.ext
      · change (c + 0) - c = 0
        ring
      · change (0 + (1 : Ω)) - 0 = 1
        ring
    have hF_inj : Function.Injective F := by
      intro v₁ v₂ hv
      have hΨ := congrArg Ψ_bar hv
      have h_eval : ∀ v : Fin 2 → Ω,
          (Ψ_bar (F v)).fst = v 0 ∧ (Ψ_bar (F v)).snd = v 1 := by
        intro v
        rw [hF_apply, map_add, map_smul, map_smul, map_one, hΨ_t]
        refine ⟨?_, ?_⟩
        · change v 0 * 1 + v 1 * 0 = v 0
          ring
        · change v 0 * 0 + v 1 * 1 = v 1
          ring
      funext j
      fin_cases j
      · change v₁ 0 = v₂ 0
        rw [← (h_eval v₁).1, ← (h_eval v₂).1, hΨ]
      · change v₁ 1 = v₂ 1
        rw [← (h_eval v₁).2, ← (h_eval v₂).2, hΨ]
    let e_fin2 : (Fin 2 → Ω) ≃ₗ[Ω] Q := LinearEquiv.ofBijective F ⟨hF_inj, hF_surj⟩
    refine ⟨𝔪, h𝔪_max, hq_le_𝔪, ?_⟩
    dsimp only
    rw [Θ.toLinearEquiv.finrank_eq, e_fin2.symm.finrank_eq, Module.finrank_fin_fun Ω]

  
  
  
  refine ⟨?_, ?_⟩
  · 
    intro hSmCov
    have hPointSm : ∀ y : Y, ∃ V : Y.Opens, y ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_Y) := by
      intro y
      have hy_univ : y ∈ ⋃ α : Fin N, Set.range (j_D α).base := by
        rw [hj_cov]; trivial
      obtain ⟨α, q, hq_y⟩ := Set.mem_iUnion.mp hy_univ
      obtain ⟨m, f, hf_sm, hf_cov⟩ := hSmCov α
      have hq_univ : q ∈ ⋃ μ : Fin m,
          (PrimeSpectrum.basicOpen (f μ) : Set (PrimeSpectrum (D α))) := by
        rw [hf_cov]; trivial
      obtain ⟨μ, hq_μ⟩ := Set.mem_iUnion.mp hq_univ
      obtain ⟨V, hq_V, hSm_V⟩ := hS1_away α (f μ) q hq_μ (hf_sm μ)
      rw [hq_y] at hq_V
      exact ⟨V, hq_V, hSm_V⟩
    choose V_y hy_Vy hSm_Vy using hPointSm
    have hTop : (⨆ y : Y, V_y y) = ⊤ :=
      top_unique fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hy_Vy y⟩
    exact (AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_iSup_eq_top
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) V_y hTop).mpr hSm_Vy
  · 
    intro hArtinSmooth hCover y
    have hy_univ : y ∈ ⋃ α : Fin N, Set.range (j_D α).base := by
      rw [hj_cov]; trivial
    obtain ⟨α, q, hq_y⟩ := Set.mem_iUnion.mp hy_univ
    obtain ⟨m, f, s, 𝒟', instCR_𝒟', φ_D, φ_node, hf_sm, hEtD, hEtNode, hComm, hCov_α⟩ :=
      hCover α
    letI : ∀ ν : Fin s, CommRing (𝒟' ν) := instCR_𝒟'
    have : _root_.IsReduced (D α) :=
      hS2_red (D α) m f s 𝒟' instCR_𝒟' φ_D φ_node hf_sm hEtD hEtNode hCov_α
    have hq_univ : q ∈
        (⋃ μ : Fin m, (PrimeSpectrum.basicOpen (f μ) : Set (PrimeSpectrum (D α)))) ∪
          (⋃ ν : Fin s, Set.range (PrimeSpectrum.comap (φ_D ν))) := by
      rw [hCov_α]; trivial
    rcases hq_univ with hq_sm | hq_rf
    · obtain ⟨μ, hq_μ⟩ := Set.mem_iUnion.mp hq_sm
      obtain ⟨V, hq_V, hSm_V⟩ := hS1_away α (f μ) q hq_μ (hf_sm μ)
      rw [hq_y] at hq_V
      exact Or.inl ⟨V, hq_V, hSm_V⟩
    · obtain ⟨ν, q', hq'⟩ := Set.mem_iUnion.mp hq_rf
      by_cases hAll : ∀ i : Fin 2, φ_node ν (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q'.asIdeal
      · rw [← hq_y]
        exact hS1_nodal α q (𝒟' ν) q' (φ_D ν) (φ_node ν)
          (hEtD ν) (hEtNode ν) hq' hAll (hComm ν)
      · obtain ⟨i₀, hi₀⟩ := not_forall.mp hAll
        obtain ⟨𝔪, hMax, hq_le_𝔪, hFinrank2⟩ :=
          hS3_offNode (D α) q (𝒟' ν) q' (φ_D ν) (φ_node ν) i₀
            (hEtD ν) (hEtNode ν) hq' (hComm ν) hi₀
        obtain ⟨g, hg_not_𝔪, hg_sm⟩ := hArtinSmooth (D α) 𝔪 hMax hFinrank2
        have hg_not_q : g ∉ q.asIdeal := fun hg => hg_not_𝔪 (hq_le_𝔪 hg)
        obtain ⟨V, hq_V, hSm_V⟩ := hS1_away α g q hg_not_q hg_sm
        rw [hq_y] at hq_V
        exact Or.inl ⟨V, hq_V, hSm_V⟩

theorem weil_domain_spreadOut_hasSpreadSmoothOrNodal_and_smooth (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
    (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
    (ι₀ : B₀ →+* K_bar) (_hInj₀ : Function.Injective ι₀)
    (X₀ : AlgebraicGeometry.Scheme.{u})
    (p₀ : X₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀)) :
    AlgebraicGeometry.IsProper p₀ →
    AlgebraicGeometry.LocallyOfFinitePresentation p₀ →
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
        (AlgebraicGeometry.IsReduced Y ∧
         ∀ (D : Type u) [CommRing D] [Algebra Ω D]
           (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
           AlgebraicGeometry.IsOpenImmersion j_D →
           j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
           ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
             let L := Localization.AtPrime q.asIdeal
             let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
             Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
               (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3))) →
    (∀ y : ↥(CategoryTheory.Limits.pullback p₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))),
      HasSpreadSmoothOrNodalAt
        (CategoryTheory.Limits.pullback.snd p₀
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))) y) →
    ∃ (B₁ : Type u) (_ : CommRing B₁) (_ : IsDomain B₁)
      (ψ₀₁ : B₀ →+* B₁) (ι₁ : B₁ →+* K_bar),
      RingHom.FiniteType ψ₀₁ ∧
      ι₁.comp ψ₀₁ = ι₀ ∧
      Function.Injective ι₁ ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B₁))
          (y : ↥(CategoryTheory.Limits.pullback p₀
            (s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁)))),
        HasSpreadSmoothOrNodalAt
          (CategoryTheory.Limits.pullback.snd p₀
            (s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁))) y) ∧
      (AlgebraicGeometry.SmoothOfRelativeDimension 1
          (CategoryTheory.Limits.pullback.snd p₀
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))) →
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B₁)),
          AlgebraicGeometry.SmoothOfRelativeDimension 1
            (CategoryTheory.Limits.pullback.snd p₀
              (s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁)))) :=
by
  intro hProp hLFP _hArtinNodal hSmNodGen

  have hComapBasic : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (g : R →+* S) (f : R) (q : PrimeSpectrum S),
      PrimeSpectrum.comap g q ∈ PrimeSpectrum.basicOpen f ↔
        q ∈ (PrimeSpectrum.basicOpen (g f) : Set (PrimeSpectrum S)) :=
    fun _ _ _ => Iff.rfl

  have hMemPreimageOpen : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y]
      {g : X → Y} (hg : Continuous g) (O : TopologicalSpace.Opens Y) (x : X),
      x ∈ (⟨g ⁻¹' O.1, O.2.preimage hg⟩ : TopologicalSpace.Opens X) ↔ g x ∈ O :=
    fun _ _ _ => Iff.rfl

  let _ : Algebra B₀ K_bar := ι₀.toAlgebra
  have h_algMap_ι₀ : algebraMap B₀ K_bar = ι₀ := rfl
  have hInjAlg₀ : Function.Injective (algebraMap B₀ K_bar) := by
    rwa [h_algMap_ι₀]
  let _ : DecidableEq K_bar := Classical.decEq K_bar

  have hToAlgHom : ∀ {A_sub : Subalgebra B₀ K_bar} {Ω : Type u} [CommRing Ω] [Algebra B₀ Ω]
      (ψ : ↥A_sub →ₐ[B₀] Ω),
      let _ : Algebra ↥A_sub Ω := ψ.toRingHom.toAlgebra
      have _ : IsScalarTower B₀ ↥A_sub Ω :=
        IsScalarTower.of_algebraMap_eq (fun b => (ψ.commutes b).symm)
      @IsScalarTower.toAlgHom B₀ ↥A_sub Ω _ _ _ _ _ _ _ = ψ := by
    intro A_sub Ω _ _ ψ
    let _ : Algebra ↥A_sub Ω := ψ.toRingHom.toAlgebra
    ext x
    exact congrFun (congrArg DFunLike.coe (RingHom.algebraMap_toAlgebra ψ.toRingHom)) x

  have hSubalgIncComp : ∀ {A : Type u} [CommRing A] [Algebra B₀ A]
      {A₁ A₂ A₃ : Subalgebra B₀ A} (h₁₂ : A₁ ≤ A₂) (h₂₃ : A₂ ≤ A₃),
      (Subalgebra.inclusion h₂₃).comp (Subalgebra.inclusion h₁₂) =
      Subalgebra.inclusion (h₁₂.trans h₂₃) :=
    fun h₁₂ h₂₃ => AlgHom.ext (fun x => Subalgebra.inclusion_inclusion h₁₂ h₂₃ x)

  have _ : AlgebraicGeometry.IsProper p₀ := hProp
  have hQC : AlgebraicGeometry.QuasiCompact p₀ := inferInstance
  obtain ⟨N, R₀, instCR_R₀, instAlg_R₀, hFP_R₀, hPullbackCov, hExtract⟩ :=
    weil_fp_affine_chart_cover_and_generic_smoothOrNodal_extract B₀ X₀ p₀ hQC hLFP
  let _ : ∀ α : Fin N, CommRing (R₀ α) := instCR_R₀
  let _ : ∀ α : Fin N, Algebra B₀ (R₀ α) := instAlg_R₀
  have _ : ∀ α : Fin N, Algebra.FinitePresentation B₀ (R₀ α) := hFP_R₀

  have hExtractK := hExtract K_bar
  dsimp only at hExtractK
  rw [h_algMap_ι₀] at hExtractK

  let incAlg : ∀ {S S' : Finset K_bar}, S ⊆ S' →
      ↥(Algebra.adjoin B₀ (↑S : Set K_bar)) →ₐ[B₀] ↥(Algebra.adjoin B₀ (↑S' : Set K_bar)) :=
    fun {_ _} h => Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h))

  have hIncVal : ∀ {S S' : Finset K_bar} (h : S ⊆ S'),
      (Algebra.adjoin B₀ (↑S' : Set K_bar)).val.comp (incAlg h) =
      (Algebra.adjoin B₀ (↑S : Set K_bar)).val :=
    fun h => Subalgebra.val_comp_inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h))

  have hIncComp : ∀ {S₁ S₂ S₃ : Finset K_bar} (h₁₂ : S₁ ⊆ S₂) (h₂₃ : S₂ ⊆ S₃),
      (incAlg h₂₃).comp (incAlg h₁₂) = incAlg (h₁₂.trans h₂₃) :=
    fun h₁₂ h₂₃ =>
      hSubalgIncComp (Algebra.adjoin_mono (Finset.coe_subset.mpr h₁₂))
        (Algebra.adjoin_mono (Finset.coe_subset.mpr h₂₃))

  let mapTP : ∀ (α : Fin N) {S S' : Finset K_bar}, S ⊆ S' →
      TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S : Set K_bar)) (R₀ α) →ₐ[B₀]
        TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S' : Set K_bar)) (R₀ α) :=
    fun α {_ _} h => Algebra.TensorProduct.map (incAlg h) (AlgHom.id B₀ (R₀ α))

  have hMapTP_val : ∀ (α : Fin N) {S S' : Finset K_bar} (h : S ⊆ S'),
      (Algebra.TensorProduct.map (Algebra.adjoin B₀ (↑S' : Set K_bar)).val
        (AlgHom.id B₀ (R₀ α))).comp (mapTP α h) =
      Algebra.TensorProduct.map (Algebra.adjoin B₀ (↑S : Set K_bar)).val
        (AlgHom.id B₀ (R₀ α)) := by
    intro α S S' h
    dsimp only [mapTP]
    rw [← Algebra.TensorProduct.map_comp, AlgHom.comp_id, hIncVal h]

  have hMapTP_hom : ∀ (α : Fin N) {S S' : Finset K_bar} (h : S ⊆ S')
      {Ω : Type u} [CommRing Ω] [Algebra B₀ Ω]
      (φ' : ↥(Algebra.adjoin B₀ (↑S' : Set K_bar)) →ₐ[B₀] Ω),
      (Algebra.TensorProduct.map φ' (AlgHom.id B₀ (R₀ α))).comp (mapTP α h) =
      Algebra.TensorProduct.map (φ'.comp (incAlg h)) (AlgHom.id B₀ (R₀ α)) := by
    intro α S S' h Ω _ _ φ'
    dsimp only [mapTP]
    rw [← Algebra.TensorProduct.map_comp, AlgHom.comp_id]

  
  choose m f s D' instCR_D' φ_D φ_node hf_sm hφD_et hφnode_et hφ_comm hGenCov using
    hExtractK.1 hSmNodGen
  let _ : ∀ (α : Fin N) (ν : Fin (s α)), CommRing (D' α ν) := instCR_D'

  have hSmDesc : ∀ (α : Fin N) (μ : Fin (m α)),
      ∃ (S_f : Finset K_bar)
        (f_S : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) (R₀ α)),
        (Algebra.TensorProduct.map
          (Algebra.adjoin B₀ (↑S_f : Set K_bar)).val
          (AlgHom.id B₀ (R₀ α))) f_S = f α μ ∧
        ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω]
          [Algebra ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) Ω]
          [IsScalarTower B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) Ω],
          let φ_SΩ : TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) (R₀ α) →+*
              TensorProduct B₀ Ω (R₀ α) :=
            (Algebra.TensorProduct.map
              (IsScalarTower.toAlgHom B₀ ↥(Algebra.adjoin B₀ (↑S_f : Set K_bar)) Ω)
              (AlgHom.id B₀ (R₀ α))).toRingHom
          RingHom.IsStandardSmoothOfRelativeDimension 1
            (algebraMap Ω (Localization.Away (φ_SΩ f_S))) :=
    fun α μ =>
      (weil_domain_adjoin_spreadOut_standardSmooth_localization B₀ K_bar hInjAlg₀ (R₀ α)).1
        (f α μ) (hf_sm α μ)
  choose S_sm f_sm hf_sm_lift hf_sm_spec using hSmDesc

  have hRfDesc : ∀ (α : Fin N) (ν : Fin (s α)),
      ∃ (S_r : Finset K_bar)
        (O_r : TopologicalSpace.Opens
          (PrimeSpectrum (TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S_r : Set K_bar)) (R₀ α)))),
        (∀ q' : PrimeSpectrum (D' α ν),
          PrimeSpectrum.comap
            (Algebra.TensorProduct.map
              (Algebra.adjoin B₀ (↑S_r : Set K_bar)).val
              (AlgHom.id B₀ (R₀ α))).toRingHom
            (PrimeSpectrum.comap (φ_D α ν) q') ∈ O_r) ∧
        (∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω]
           [Algebra ↥(Algebra.adjoin B₀ (↑S_r : Set K_bar)) Ω]
           [IsScalarTower B₀ ↥(Algebra.adjoin B₀ (↑S_r : Set K_bar)) Ω],
          ∃ (𝒟'_Ω : Type u) (_ : CommRing 𝒟'_Ω)
            (φ_D_Ω : TensorProduct B₀ Ω (R₀ α) →+* 𝒟'_Ω)
            (φ_node_Ω : (MvPolynomial (Fin 2) Ω ⧸
              Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* 𝒟'_Ω),
            φ_D_Ω.Etale ∧
            φ_node_Ω.Etale ∧
            φ_D_Ω.comp (algebraMap Ω (TensorProduct B₀ Ω (R₀ α))) =
              φ_node_Ω.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
            ∀ q_Ω : PrimeSpectrum (TensorProduct B₀ Ω (R₀ α)),
              PrimeSpectrum.comap
                (Algebra.TensorProduct.map
                  (IsScalarTower.toAlgHom B₀ ↥(Algebra.adjoin B₀ (↑S_r : Set K_bar)) Ω)
                  (AlgHom.id B₀ (R₀ α))).toRingHom q_Ω ∈ O_r →
              q_Ω ∈ Set.range (PrimeSpectrum.comap φ_D_Ω)) :=
    fun α ν =>
      weil_domain_adjoin_spreadOut_etale_nodal_roof B₀ K_bar hInjAlg₀ (R₀ α)
        (D' α ν) (φ_D α ν) (φ_node α ν) (hφD_et α ν) (hφnode_et α ν) (hφ_comm α ν)
  choose S_rf O_rf hO_rf_gen hO_rf_spec using hRfDesc

  have hExS₁_nod : ∃ S₁_nod : Finset K_bar,
      (∀ (α : Fin N) (μ : Fin (m α)), S_sm α μ ⊆ S₁_nod) ∧
      (∀ (α : Fin N) (ν : Fin (s α)), S_rf α ν ⊆ S₁_nod) := by
    refine ⟨Finset.univ.biUnion fun α : Fin N =>
        (Finset.univ.biUnion fun μ : Fin (m α) => S_sm α μ) ∪
        (Finset.univ.biUnion fun ν : Fin (s α) => S_rf α ν), ?_, ?_⟩
    · intro α μ x hx
      exact Finset.mem_biUnion.mpr ⟨α, Finset.mem_univ α,
        Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ μ, hx⟩)⟩
    · intro α ν x hx
      exact Finset.mem_biUnion.mpr ⟨α, Finset.mem_univ α,
        Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, hx⟩)⟩
  obtain ⟨S₁_nod, hSub_sm, hSub_rf⟩ := hExS₁_nod

  let f₁ : ∀ (α : Fin N), Fin (m α) →
      TensorProduct B₀ ↥(Algebra.adjoin B₀ (↑S₁_nod : Set K_bar)) (R₀ α) :=
