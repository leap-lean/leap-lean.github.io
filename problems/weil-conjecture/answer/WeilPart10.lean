    have htotal : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
        p'.appLE ⊤ W (fun _ _ => trivial) =
        α_R' ≫ p'.appLE U'₁₂ V'₁₂ hV'₁₂ ≫ β_D := by
      dsimp only [α_R', β_D]
      rw [CategoryTheory.Category.assoc, hchain]
