          let b₀ := algebraMap Ω A (ev_P y)
          change (x * y - algebraMap Ω A (ev_P (x * y))) -
            (x * (y - b₀) + y * (x - a₀)) ∈ p_P.asIdeal ^ 2
          have hmul_ab : algebraMap Ω A (ev_P (x * y)) = a₀ * b₀ := by
            rw [map_mul, map_mul]
          have hid : (x * y - algebraMap Ω A (ev_P (x * y))) -
              (x * (y - b₀) + y * (x - a₀)) = -((x - a₀) * (y - b₀)) := by
            rw [hmul_ab]; ring
          rw [hid, pow_two]
          exact Submodule.neg_mem _ (Ideal.mul_mem_mul (hsub_mem_P x) (hsub_mem_P y)) }
