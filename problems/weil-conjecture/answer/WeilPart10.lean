    · ext a
      dsimp only [ι, π]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.rename_C]
      rw [MvPolynomial.eval₂Hom_C]
      have h_π₀ := RingHom.congr_fun hπ₀_C a
      simp only [RingHom.comp_apply] at h_π₀
      rw [h_π₀]
      rfl
    · intro i
      dsimp only [ι, π]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.rename_X]
      rw [MvPolynomial.eval₂Hom_X', Fin.snoc_castSucc]
  have hπ_ι : ∀ G : P₀, π (ι G) = algebraMap B₀ B (π₀ G) :=
    fun G => RingHom.congr_fun hπ_ι_hom G
  have hπ_last : π X_last = u_B := by
    dsimp only [π, X_last]
    rw [MvPolynomial.eval₂Hom_X', Fin.snoc_last]
  have hπ_surj : Function.Surjective π := by
    intro b
    obtain ⟨m, b₀, hb⟩ := IsLocalization.Away.surj h_B b
    obtain ⟨G₀, rfl⟩ := hπ₀_surj b₀
    refine ⟨ι G₀ * X_last ^ m, ?_⟩
    rw [map_mul, map_pow, hπ_ι G₀, hπ_last, ← hb]
    calc (b * algebraMap B₀ B h_B ^ m) * u_B ^ m
        = b * (algebraMap B₀ B h_B * u_B) ^ m := by ring
      _ = b * 1 ^ m := by rw [hu_B]
      _ = b := by simp
  have hK_le_ker : K_id ≤ RingHom.ker π := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    refine Fin.lastCases ?_ ?_ j
    · dsimp [F]
      rw [Fin.snoc_last, map_sub, map_mul, map_one, hπ_ι s_P, hπ_last]
      change algebraMap B₀ B h_B * u_B - 1 = 0
      rw [hu_B, sub_self]
    · intro r
      dsimp [F]
      rw [Fin.snoc_castSucc, hπ_ι (F₀ r), RingHom.mem_ker.mp (hF₀_mem r), map_zero]
  have hJ₀_in_K : ∀ G ∈ J₀, ι G ∈ K_id := by
    intro G hG
    have hmem := Ideal.mem_map_of_mem ι hG
    rw [Ideal.map_span] at hmem
    refine Ideal.span_mono ?_ hmem
    rintro _ ⟨_, ⟨r, rfl⟩, rfl⟩
    exact ⟨r.castSucc, Fin.snoc_castSucc _ _ r⟩
  have hUnitRel : s_tilde * X_last - 1 ∈ K_id :=
    Ideal.subset_span ⟨Fin.last k₀, Fin.snoc_last _ _⟩
  have hPowRel : ∀ m : ℕ, s_tilde ^ m * X_last ^ m - 1 ∈ K_id := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      have h_eq : s_tilde ^ (m + 1) * X_last ^ (m + 1) - 1 =
          (s_tilde * X_last) * (s_tilde ^ m * X_last ^ m - 1) + (s_tilde * X_last - 1) := by
        ring
      rw [h_eq]
      exact K_id.add_mem (Ideal.mul_mem_left K_id _ ih) hUnitRel
  have hElim : ∀ H : P_ext, ∃ (d : ℕ) (G_star : P₀), s_tilde ^ d * H - ι G_star ∈ K_id := by
    intro H
    induction H using MvPolynomial.induction_on with
    | C a =>
      refine ⟨0, MvPolynomial.C a, ?_⟩
      dsimp only [ι]
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.rename_C]
      simp
    | add p q hp hq =>
      obtain ⟨dp, Gp, hpK⟩ := hp
      obtain ⟨dq, Gq, hqK⟩ := hq
      refine ⟨dp + dq, s_P ^ dq * Gp + s_P ^ dp * Gq, ?_⟩
      have hι_add : ι (s_P ^ dq * Gp + s_P ^ dp * Gq) =
          s_tilde ^ dq * ι Gp + s_tilde ^ dp * ι Gq := by
        simp [s_tilde, map_add, map_mul, map_pow]
      have h_eq : s_tilde ^ (dp + dq) * (p + q) - ι (s_P ^ dq * Gp + s_P ^ dp * Gq) =
          s_tilde ^ dq * (s_tilde ^ dp * p - ι Gp) +
            s_tilde ^ dp * (s_tilde ^ dq * q - ι Gq) := by
        rw [hι_add, pow_add]; ring
      rw [h_eq]
      exact K_id.add_mem (Ideal.mul_mem_left K_id _ hpK) (Ideal.mul_mem_left K_id _ hqK)
    | mul_X p i hp =>
      obtain ⟨dp, Gp, hpK⟩ := hp
      refine Fin.lastCases ?_ ?_ i
      · refine ⟨dp + 1, Gp, ?_⟩
        change s_tilde ^ (dp + 1) * (p * X_last) - ι Gp ∈ K_id
        have h_eq : s_tilde ^ (dp + 1) * (p * X_last) - ι Gp =
            (s_tilde ^ dp * p) * (s_tilde * X_last - 1) + (s_tilde ^ dp * p - ι Gp) := by
          rw [pow_succ]; ring
        rw [h_eq]
        exact K_id.add_mem (Ideal.mul_mem_left K_id _ hUnitRel) hpK
      · intro j
        refine ⟨dp, Gp * MvPolynomial.X j, ?_⟩
        have hι_mul : ι (Gp * MvPolynomial.X j) = ι Gp * MvPolynomial.X j.castSucc := by
          dsimp only [ι]
          rw [map_mul, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.rename_X]
        have h_eq : s_tilde ^ dp * (p * MvPolynomial.X j.castSucc) -
            ι (Gp * MvPolynomial.X j) =
            (s_tilde ^ dp * p - ι Gp) * MvPolynomial.X j.castSucc := by
          rw [hι_mul]; ring
        rw [h_eq]
        exact Ideal.mul_mem_right _ K_id hpK
  have hπ_ker : RingHom.ker π = K_id := by
    apply le_antisymm _ hK_le_ker
    intro H hH
    rw [RingHom.mem_ker] at hH
    obtain ⟨d, G_star, hRed⟩ := hElim H
    have hRed_ker : π (s_tilde ^ d * H - ι G_star) = 0 :=
      RingHom.mem_ker.mp (hK_le_ker hRed)
    have hG_loc_zero : algebraMap B₀ B (π₀ G_star) = 0 := by
      rw [map_sub, map_mul, hH, mul_zero, zero_sub, neg_eq_zero, hπ_ι G_star] at hRed_ker
      exact hRed_ker
    obtain ⟨⟨_, ⟨N, rfl⟩⟩, hN_zero⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers h_B) B (π₀ G_star)).mp hG_loc_zero
    have hInI₀ : s_P ^ N * G_star ∈ I₀ := by
      rw [RingHom.mem_ker, map_mul, map_pow]
      exact hN_zero
    have hInJ₀ : s_P ^ (N + 1) * G_star ∈ J₀ := by
      have h1 := hs_P_mul (s_P ^ N * G_star) hInI₀
      have h_eq : s_P ^ (N + 1) * G_star = s_P * (s_P ^ N * G_star) := by
        rw [pow_succ']; ring
      rwa [h_eq]
    have hιInK : s_tilde ^ (N + 1) * ι G_star ∈ K_id := by
      have h1 := hJ₀_in_K (s_P ^ (N + 1) * G_star) hInJ₀
      simpa [s_tilde, map_mul, map_pow] using h1
    let M := d + (N + 1)
    have hsMH : s_tilde ^ M * H ∈ K_id := by
      have h_eq : s_tilde ^ M * H =
          s_tilde ^ (N + 1) * (s_tilde ^ d * H - ι G_star) +
            s_tilde ^ (N + 1) * ι G_star := by
        dsimp [M]; rw [pow_add]; ring
      rw [h_eq]
      exact K_id.add_mem (Ideal.mul_mem_left K_id _ hRed) hιInK
    have hH_eq : H = (s_tilde ^ M * H) * X_last ^ M -
        H * (s_tilde ^ M * X_last ^ M - 1) := by
      ring
    rw [hH_eq]
    exact K_id.sub_mem (Ideal.mul_mem_right _ K_id hsMH)
      (Ideal.mul_mem_left K_id _ (hPowRel M))
  exact ⟨π, F, hπ_C, hπ_surj, hπ_ker⟩

theorem weil_nodal_krull_dimension_flat_nakayama_lci_presentation (A₀ B₀ κ : Type u) [CommRing A₀] [IsNoetherianRing A₀]
    [CommRing B₀] [Algebra A₀ B₀] [Module.Flat A₀ B₀]
    [Field κ] [Algebra A₀ κ]
    (k₀ : ℕ) (hk₀ : 1 ≤ k₀)
    (π₀ : MvPolynomial (Fin (k₀ + 1)) A₀ →+* B₀)
    (hπ₀_C : π₀.comp MvPolynomial.C = algebraMap A₀ B₀)
    (hπ₀_surj : Function.Surjective π₀)
    (q_x : PrimeSpectrum B₀)
    (p₀ : PrimeSpectrum A₀)
    (hp₀ : p₀.asIdeal = Ideal.comap (algebraMap A₀ B₀) q_x.asIdeal)
    (hκ_ker : RingHom.ker (algebraMap A₀ κ) = p₀.asIdeal)
    (hκ_frac : ∀ c : κ, ∃ a s : A₀, s ∉ p₀.asIdeal ∧ c * algebraMap A₀ κ s = algebraMap A₀ κ a)
    (q_bar : PrimeSpectrum (TensorProduct A₀ κ B₀))
    (hq_bar_comap : Ideal.comap (Algebra.TensorProduct.includeRight.toRingHom :
      B₀ →+* TensorProduct A₀ κ B₀) q_bar.asIdeal = q_x.asIdeal)
    (hq_bar_max : q_bar.asIdeal.IsMaximal)
    (hSep : Algebra.IsSeparable κ
      (IsLocalRing.ResidueField (Localization.AtPrime q_bar.asIdeal)))
    (hFinDim : FiniteDimensional κ
      (IsLocalRing.ResidueField (Localization.AtPrime q_bar.asIdeal)))
    (hArtDim : ∀ d : ℕ,
      Module.finrank κ
        (Localization.AtPrime q_bar.asIdeal ⧸
          (IsLocalRing.maximalIdeal (Localization.AtPrime q_bar.asIdeal)) ^ (d + 1)) =
      Module.finrank κ
        (IsLocalRing.ResidueField (Localization.AtPrime q_bar.asIdeal)) * (1 + 2 * d)) :
    ∃ h_B : B₀,
      h_B ∉ q_x.asIdeal ∧
      ∀ (B : Type u) [CommRing B] [Algebra B₀ B] [IsLocalization.Away h_B B],
        ∃ (π : MvPolynomial (Fin ((k₀ + 1) + 1)) A₀ →+* B)
          (F : Fin (k₀ + 1) → MvPolynomial (Fin ((k₀ + 1) + 1)) A₀),
          π.comp MvPolynomial.C = (algebraMap B₀ B).comp (algebraMap A₀ B₀) ∧
          Function.Surjective π ∧
          RingHom.ker π = Ideal.span (Set.range F) :=
by
  classical
  have hm_ex : ∃ m : ℕ, k₀ = m + 1 := ⟨k₀ - 1, by omega⟩
  obtain ⟨m, rfl⟩ := hm_ex
  let B_κ := TensorProduct A₀ κ B₀
  let P_κ := MvPolynomial (Fin ((m + 1) + 1)) κ
  let π_κ : P_κ →ₐ[κ] B_κ :=
    MvPolynomial.aeval (fun i => Algebra.TensorProduct.includeRight (π₀ (MvPolynomial.X i)))
  let I_κ : Ideal P_κ := RingHom.ker π_κ.toRingHom
  let Q_bar : Ideal P_κ := Ideal.comap π_κ.toRingHom q_bar.asIdeal
  haveI : Q_bar.IsPrime := Ideal.IsPrime.comap π_κ.toRingHom
  let P := Localization.AtPrime Q_bar
  obtain ⟨hπ_κ_surj, hLiftBase⟩ :=
    weil_flat_noetherian_fiber_generators_nakayama_lci_chart
      A₀ B₀ κ (m + 1) π₀ hπ₀_C hπ₀_surj q_x p₀ hp₀ hκ_ker hκ_frac q_bar hq_bar_comap
  let O_x := Localization.AtPrime q_bar.asIdeal
  let m_x := IsLocalRing.maximalIdeal O_x
  let E := IsLocalRing.ResidueField O_x
  let P_E := MvPolynomial (Fin (m + 2)) E
  let M_U : Ideal P_E := Ideal.span (Set.range (MvPolynomial.X : Fin (m + 2) → P_E))
  let ε : P_κ →ₐ[κ] E :=
    (IsScalarTower.toAlgHom κ O_x E).comp ((IsScalarTower.toAlgHom κ B_κ O_x).comp π_κ)
  let sh : P_κ →ₐ[κ] P_E :=
    MvPolynomial.aeval (fun i => MvPolynomial.C (ε (MvPolynomial.X i)) + MvPolynomial.X i)
  obtain ⟨hT_MU, hEquiv_d, hKrull_P⟩ :=
    weil_separable_residue_mvPoly_taylor_truncation_equiv
      κ B_κ (m + 2) π_κ hπ_κ_surj q_bar hq_bar_max hSep
  let T : Set P_E := sh '' (I_κ : Set P_κ)
  have hT_sub : T ⊆ (M_U : Set P_E) := by
    rintro _ ⟨f, hf, rfl⟩
    exact hT_MU f hf
  have hFinPos : 0 < Module.finrank κ E := Module.finrank_pos
  have hDim_E : ∀ d : ℕ,
      Module.finrank E (P_E ⧸ (Ideal.span T ⊔ M_U ^ (d + 1))) = 1 + 2 * d := by
    intro d
    obtain ⟨e_d⟩ := hEquiv_d d
    let Q_Ed := P_E ⧸ (Ideal.span T ⊔ M_U ^ (d + 1))
    haveI : IsScalarTower κ E Q_Ed := IsScalarTower.of_algebraMap_eq fun c => by
      change Ideal.Quotient.mk _ (algebraMap κ P_E c) =
        Ideal.Quotient.mk _ (algebraMap E P_E (algebraMap κ E c))
      rw [IsScalarTower.algebraMap_apply κ E P_E]
    have h_mul : Module.finrank κ E * Module.finrank E Q_Ed = Module.finrank κ Q_Ed :=
      Module.finrank_mul_finrank κ E Q_Ed
    have h_eq_κ : Module.finrank κ Q_Ed = Module.finrank κ E * (1 + 2 * d) := by
      rw [← e_d.toLinearEquiv.finrank_eq]
      exact hArtDim d
    exact Nat.eq_of_mul_eq_mul_left hFinPos (h_mul.trans h_eq_κ)
  have hDim_1 : Module.finrank E (P_E ⧸ (Ideal.span T ⊔ M_U ^ 2)) = 3 := by
    simpa using hDim_E 1
  obtain ⟨g, Ξ, hg_mem, hSpan_d1, hΞ_compat⟩ :=
    weil_mvPoly_linear_elimination_nilpotent_fixedPoint_equiv E m T hT_sub hDim_1
  obtain ⟨hPlanarDim, hPlanarQuad⟩ :=
    weil_planar_truncation_finrank_and_quadratic_principal_ideal E
  let P_2 := MvPolynomial (Fin 2) E
  let M_Z : Ideal P_2 := Ideal.span (Set.range (MvPolynomial.X : Fin 2 → P_2))
  have hRange_g_le : Ideal.span (Set.range g) ≤ Ideal.span T := by
    rw [Ideal.span_le]
    rintro _ ⟨r, rfl⟩
    exact Ideal.subset_span (hg_mem r)
  have hEx_nod : ∃ g_nod ∈ T, g_nod ∉ Ideal.span (Set.range g) ⊔ M_U ^ 3 := by
    by_contra hAll
    let J_d2 : Ideal P_E := Ideal.span (Set.range g) ⊔ M_U ^ 3
    have hSub : T ⊆ (J_d2 : Set P_E) := fun x hx => by
      by_contra hxnot
      exact hAll ⟨x, hx, hxnot⟩
    have hIdEq : Ideal.span T ⊔ M_U ^ 3 = J_d2 := by
      apply le_antisymm
      · exact sup_le (Ideal.span_le.mpr hSub) le_sup_right
      · exact sup_le_sup_right hRange_g_le _
    have h5 : Module.finrank E (P_E ⧸ (Ideal.span T ⊔ M_U ^ 3)) = 5 := by
      simpa using hDim_E 2
    have h6 : Module.finrank E (P_E ⧸ J_d2) = 6 := by
      rw [(Ξ 2).toLinearEquiv.finrank_eq]
      simpa using (hPlanarDim 2).2
    rw [hIdEq, h6] at h5
    omega
  obtain ⟨g_nod, hg_nod_T, hg_nod_not⟩ := hEx_nod
  choose f_lin hf_lin_mem hf_lin_sh using fun r : Fin m => hg_mem r
  have ⟨f_nod, hf_nod_mem, hf_nod_sh⟩ := hg_nod_T
  let f_bar : Fin (m + 1) → P_κ := Fin.snoc f_lin f_nod
  have hf_bar_mem : ∀ r : Fin (m + 1), f_bar r ∈ I_κ := by
    intro r
    refine Fin.lastCases ?_ ?_ r
    · dsimp [f_bar]; rw [Fin.snoc_last]; exact hf_nod_mem
    · intro i
      dsimp [f_bar]; rw [Fin.snoc_castSucc]; exact hf_lin_mem i
  have hS_sub : Set.range f_bar ⊆ (I_κ : Set P_κ) := by
    rintro _ ⟨r, rfl⟩
    exact hf_bar_mem r
  have hSh_range : sh '' Set.range f_bar = insert g_nod (Set.range g) := by
    ext p
    simp only [Set.mem_image, Set.mem_range, Set.mem_insert_iff]
    constructor
    · rintro ⟨_, ⟨r, rfl⟩, rfl⟩
      refine Fin.lastCases ?_ ?_ r
      · left; simp [f_bar, hf_nod_sh]
      · intro i; right; refine ⟨i, ?_⟩; simp [f_bar, hf_lin_sh i]
    · rintro (rfl | ⟨i, rfl⟩)
      · refine ⟨f_nod, ⟨Fin.last m, by simp [f_bar]⟩, hf_nod_sh⟩
      · refine ⟨f_lin i, ⟨i.castSucc, by simp [f_bar]⟩, hf_lin_sh i⟩
  have hSpan_fbar :
      Ideal.span (sh '' Set.range f_bar) =
        Ideal.span (Set.range g) ⊔ Ideal.span ({g_nod} : Set P_E) := by
    rw [hSh_range, Ideal.span_insert, sup_comm]
  have hTrunc_all :
      ∀ d : ℕ, Ideal.span T ≤ Ideal.span (sh '' Set.range f_bar) ⊔ M_U ^ (d + 1) := by
    intro d
    rw [hSpan_fbar]
    rcases d with _ | _ | d'
    · simp only [Nat.zero_add, pow_one]
      exact le_trans (Ideal.span_le.mpr hT_sub) le_sup_right
    · change Ideal.span T ≤ (Ideal.span (Set.range g) ⊔ Ideal.span {g_nod}) ⊔ M_U ^ 2
      refine le_trans hSpan_d1 ?_
      exact sup_le_sup_right le_sup_left _
    · set d := d' + 2
      have hd : 2 ≤ d := Nat.le_add_left 2 d'
      have h1d : 1 ≤ d := by omega
      let I_gd : Ideal P_E := Ideal.span (Set.range g) ⊔ M_U ^ (d + 1)
      let π_gd : P_E →ₐ[E] P_E ⧸ I_gd := Ideal.Quotient.mkₐ E I_gd
      let ψ_d : P_E →ₐ[E] P_2 ⧸ M_Z ^ (d + 1) := (Ξ d).toAlgHom.comp π_gd
      have hψ_surj : Function.Surjective ψ_d :=
        (Ξ d).surjective.comp Ideal.Quotient.mk_surjective
      have hψ_ker : RingHom.ker ψ_d.toRingHom = I_gd := by
        ext x
        simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          ψ_d, AlgHom.comp_apply, AlgEquiv.coe_algHom]
        rw [map_eq_zero_iff (Ξ d) (Ξ d).injective]
        change Ideal.Quotient.mk I_gd x = 0 ↔ x ∈ I_gd
        exact Ideal.Quotient.eq_zero_iff_mem
      let K_d : Ideal (P_2 ⧸ M_Z ^ (d + 1)) := Ideal.map ψ_d.toRingHom (Ideal.span T)
      let ψ_bar : P_E →ₐ[E] (P_2 ⧸ M_Z ^ (d + 1)) ⧸ K_d :=
        (Ideal.Quotient.mkₐ E K_d).comp ψ_d
      have hψ_bar_surj : Function.Surjective ψ_bar :=
        Ideal.Quotient.mk_surjective.comp hψ_surj
      have hψ_bar_ker : RingHom.ker ψ_bar.toRingHom = Ideal.span T ⊔ M_U ^ (d + 1) := by
        have hcomap : RingHom.ker ψ_bar.toRingHom = Ideal.comap ψ_d.toRingHom K_d := by
          ext x
          simp only [RingHom.mem_ker, Ideal.mem_comap, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, ψ_bar, AlgHom.comp_apply]
          change Ideal.Quotient.mk K_d (ψ_d x) = 0 ↔ ψ_d.toRingHom x ∈ K_d
          exact Ideal.Quotient.eq_zero_iff_mem
        rw [hcomap, Ideal.comap_map_of_surjective' ψ_d.toRingHom hψ_surj, hψ_ker]
        change Ideal.span T ⊔ (Ideal.span (Set.range g) ⊔ M_U ^ (d + 1)) =
          Ideal.span T ⊔ M_U ^ (d + 1)
        rw [← sup_assoc, sup_eq_left.mpr hRange_g_le]
      let e_Kd : (P_E ⧸ RingHom.ker ψ_bar.toRingHom) ≃ₐ[E] ((P_2 ⧸ M_Z ^ (d + 1)) ⧸ K_d) :=
        Ideal.quotientKerAlgEquivOfSurjective hψ_bar_surj
      have hKd_finrank :
          Module.finrank E ((P_2 ⧸ M_Z ^ (d + 1)) ⧸ K_d) = 1 + 2 * d := by
        rw [← e_Kd.toLinearEquiv.finrank_eq, hψ_bar_ker]
        exact hDim_E d
      obtain ⟨q, hq_mk⟩ := Ideal.Quotient.mk_surjective (ψ_d g_nod)
      have hq_in_Kd : Ideal.Quotient.mk (M_Z ^ (d + 1)) q ∈ K_d := by
        rw [hq_mk]
        exact Ideal.mem_map_of_mem ψ_d.toRingHom (Ideal.subset_span hg_nod_T)
      have hq_mem_2 : q ∈ M_Z ^ 2 := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        have hfac :
            Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h1d))
              (Ideal.Quotient.mk (M_Z ^ (d + 1)) q) =
            Ideal.Quotient.mk (M_Z ^ 2) q := rfl
        rw [← hfac, hq_mk]
        change Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h1d))
            (Ξ d (Ideal.Quotient.mk I_gd g_nod)) = 0
        rw [hΞ_compat 1 d h1d g_nod]
        have hgnod_1 :
            Ideal.Quotient.mk (Ideal.span (Set.range g) ⊔ M_U ^ 2) g_nod = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (hSpan_d1 (Ideal.subset_span hg_nod_T))
        rw [hgnod_1, map_zero]
      have hq_not_3 : q ∉ M_Z ^ 3 := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        intro hq3
        have hfac :
            Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ hd))
              (Ideal.Quotient.mk (M_Z ^ (d + 1)) q) =
            Ideal.Quotient.mk (M_Z ^ 3) q := rfl
        rw [← hfac, hq_mk] at hq3
        change Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ hd))
            (Ξ d (Ideal.Quotient.mk I_gd g_nod)) = 0 at hq3
        rw [hΞ_compat 2 d hd g_nod, map_eq_zero_iff (Ξ 2) (Ξ 2).injective,
          Ideal.Quotient.eq_zero_iff_mem] at hq3
        exact hg_nod_not hq3
      have hKd_eq : K_d = Ideal.span {Ideal.Quotient.mk (M_Z ^ (d + 1)) q} :=
        hPlanarQuad d hd K_d q hKd_finrank hq_mem_2 hq_not_3 hq_in_Kd
      have hMap_eq :
          Ideal.map ψ_d.toRingHom (Ideal.span T) =
            Ideal.map ψ_d.toRingHom (Ideal.span ({g_nod} : Set P_E)) := by
        change K_d = _
        rw [hKd_eq, hq_mk, Ideal.map_span, Set.image_singleton]
        rfl
      have hComap_eq := congr_arg (Ideal.comap ψ_d.toRingHom) hMap_eq
      rw [Ideal.comap_map_of_surjective' ψ_d.toRingHom hψ_surj,
        Ideal.comap_map_of_surjective' ψ_d.toRingHom hψ_surj, hψ_ker] at hComap_eq
      have hRearr :
          Ideal.span ({g_nod} : Set P_E) ⊔ I_gd =
            (Ideal.span (Set.range g) ⊔ Ideal.span ({g_nod} : Set P_E)) ⊔ M_U ^ (d + 1) := by
        change Ideal.span ({g_nod} : Set P_E) ⊔ (Ideal.span (Set.range g) ⊔ M_U ^ (d + 1)) = _
        ac_rfl
      calc Ideal.span T
          ≤ Ideal.span T ⊔ I_gd := le_sup_left
        _ = Ideal.span ({g_nod} : Set P_E) ⊔ I_gd := hComap_eq
        _ = (Ideal.span (Set.range g) ⊔ Ideal.span ({g_nod} : Set P_E)) ⊔ M_U ^ (d + 1) := hRearr
  have hMap_P :
      Ideal.map (algebraMap P_κ P) I_κ =
        Ideal.map (algebraMap P_κ P) (Ideal.span (Set.range f_bar)) :=
    hKrull_P (Set.range f_bar) hS_sub hTrunc_all
  exact hLiftBase f_bar hf_bar_mem hMap_P

theorem weil_stable_curve_local_lci_marked_chart_at_point (S : AlgebraicGeometry.Scheme.{u})
    (hSepS : S.IsSeparated)
    (hNoethS : ∀ U : S.Opens, AlgebraicGeometry.IsAffineOpen U →
      IsNoetherianRing ↑(S.presheaf.obj (Opposite.op U)))
    (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (hZeroAnn : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A]
      [CommRing B] [Algebra A B] [Module.Flat A B] (S_gen : Set B),
      (∀ (p : PrimeSpectrum A),
        let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
        letI : Algebra A Ω :=
          ((algebraMap p.asIdeal.ResidueField Ω).comp
            (algebraMap A p.asIdeal.ResidueField)).toAlgebra
        ∀ z : TensorProduct A B Ω,
          (∀ b ∈ S_gen, TensorProduct.tmul A b (1 : Ω) * z = 0) → z = 0) →
      ∀ z : B, (∀ b ∈ S_gen, b * z = 0) → z = 0)
    (x : C) :
    ∃ (U : S.Opens) (V : C.Opens) (k : ℕ)
      (π : MvPolynomial (Fin (k + 1)) ↑(S.presheaf.obj (Opposite.op U)) →+*
        ↑(C.presheaf.obj (Opposite.op V)))
      (F : Fin k → MvPolynomial (Fin (k + 1)) ↑(S.presheaf.obj (Opposite.op U)))
      (tag : Option (Fin n))
      (t : ↑(C.presheaf.obj (Opposite.op V))),
      x ∈ V ∧ IsLocalLogCanonicalChart g n τ U V k π F tag t :=
by
  classical
  have _ := hSepS
  have : AlgebraicGeometry.Flat g := hStab.2.1
  have : AlgebraicGeometry.LocallyOfFinitePresentation g := hStab.2.2.2.1
  have hSec : ∀ j : Fin n, τ j ≫ g = 𝟙 S := hStab.2.2.2.2.2.1
  have hDisj : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ i).base) (Set.range (τ j).base) := hStab.2.2.2.2.2.2.1
  have hMarkSm : ∀ (j : Fin n) (b : S), ∃ V : C.Opens,
      (τ j).base b ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g) :=
    hStab.2.2.2.2.2.2.2.1
  obtain ⟨hCl, hSmChart, hGeomDichot⟩ :=
    weil_scheme_smooth_curve_open_and_geomFiber_bridge S C g n τ hStab
  have hSmOpenSub : ∀ {V_sm W : C.Opens} (hW : W ≤ V_sm),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g) := by
    intro V_sm W hW hSmV
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g) := hSmV
    have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        (C.homOfLE hW ≫ (V_sm.ι ≫ g)) :=
      AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 (C.homOfLE hW) (V_sm.ι ≫ g)
    have hEq : C.homOfLE hW ≫ (V_sm.ι ≫ g) = W.ι ≫ g := by
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
    rwa [Nat.zero_add, hEq] at hSm01
  by_cases hMark : ∃ j₀ : Fin n, x ∈ Set.range (τ j₀).base
  · 
    obtain ⟨j₀, b₀, hb₀_eq⟩ := hMark
    have hgx : g.base x = b₀ := by
      rw [← hb₀_eq]
      have h_comp := congr_arg (fun φ : S ⟶ S => φ.base b₀) (hSec j₀)
      simpa using h_comp
    obtain ⟨V_sm, hτb₀_Vsm, hSmV_sm⟩ := hMarkSm j₀ b₀
    have hxV_sm : x ∈ V_sm := hb₀_eq ▸ hτb₀_Vsm
    let Z_other : Set C := ⋃ j ∈ Finset.univ.erase j₀, Set.range (τ j).base
    have hZ_other_cl : IsClosed Z_other :=
      (Finset.univ.erase j₀).finite_toSet.isClosed_biUnion (fun j _ => hCl j)
    let W : C.Opens := V_sm ⊓ ⟨Z_otherᶜ, hZ_other_cl.isOpen_compl⟩
    have hxW : x ∈ W := by
      refine ⟨hxV_sm, ?_⟩
      intro hxZ
      rw [Set.mem_iUnion₂] at hxZ
      obtain ⟨j, hj, hxj⟩ := hxZ
      have hne : j ≠ j₀ := (Finset.mem_erase.mp hj).1
      exact Set.disjoint_left.mp (hDisj hne) hxj ⟨b₀, hb₀_eq⟩
    have hSmW : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g) :=
      hSmOpenSub inf_le_left hSmV_sm
    obtain ⟨U₀, V₀, hU₀, hV₀, hV₀_le, k₀, π₀, F₀,
        hxV₀, hV₀_W, hπ₀_C, hπ₀_surj, hπ₀_ker, hMinor₀⟩ :=
      hSmChart W x hxW hSmW
    let U_inter : S.Opens := U₀ ⊓ (TopologicalSpace.Opens.map (τ j₀).base).obj V₀
    have hb₀_U₀ : b₀ ∈ U₀ := hgx ▸ hV₀_le hxV₀
    have hb₀_τV₀ : b₀ ∈ (TopologicalSpace.Opens.map (τ j₀).base).obj V₀ := by
      change (τ j₀).base b₀ ∈ V₀
      rwa [hb₀_eq]
    have hb₀_inter : b₀ ∈ U_inter := ⟨hb₀_U₀, hb₀_τV₀⟩
    obtain ⟨s₀, hs₀_le, hb₀_U₁⟩ :=
      hU₀.exists_basicOpen_le (⟨b₀, hb₀_inter⟩ : ↥U_inter) hb₀_U₀
    let U₁ : S.Opens := S.basicOpen s₀
    have hU₁ : AlgebraicGeometry.IsAffineOpen U₁ := hU₀.basicOpen s₀
    have hU₁_U₀ : U₁ ≤ U₀ := S.basicOpen_le s₀
    have hU₁_τV₀ : U₁ ≤ (TopologicalSpace.Opens.map (τ j₀).base).obj V₀ :=
      hs₀_le.trans inf_le_right
    let s₀_B : ↑(C.presheaf.obj (Opposite.op V₀)) := (g.appLE U₀ V₀ hV₀_le).hom s₀
    let V₁ : C.Opens := C.basicOpen s₀_B
    have hV₁ : AlgebraicGeometry.IsAffineOpen V₁ := hV₀.basicOpen s₀_B
    have hV₁_eq : V₁ = V₀ ⊓ (TopologicalSpace.Opens.map g.base).obj U₁ :=
      C.basicOpen_appLE g V₀ U₀ hV₀_le s₀
    have hxV₁ : x ∈ V₁ := by
      rw [hV₁_eq]
      refine ⟨hxV₀, ?_⟩
      change g.base x ∈ U₁
      rw [hgx]
      exact hb₀_U₁
    have hV₁_V₀ : V₁ ≤ V₀ := C.basicOpen_le s₀_B
    have hV₁_le : V₁ ≤ (TopologicalSpace.Opens.map g.base).obj U₁ := by
      rw [hV₁_eq]; exact inf_le_right
    have hU₁_sec : U₁ ≤ (TopologicalSpace.Opens.map (τ j₀).base).obj V₁ := by
      intro y hy
      change (τ j₀).base y ∈ V₁
      rw [hV₁_eq]
      refine ⟨hU₁_τV₀ hy, ?_⟩
      change g.base ((τ j₀).base y) ∈ U₁
      have hgy : g.base ((τ j₀).base y) = y := by
        have h_comp := congr_arg (fun φ : S ⟶ S => φ.base y) (hSec j₀)
        simpa using h_comp
      rwa [hgy]
    let A₀ := ↑(S.presheaf.obj (Opposite.op U₀))
    let B₀ := ↑(C.presheaf.obj (Opposite.op V₀))
    let A := ↑(S.presheaf.obj (Opposite.op U₁))
    let B₁ := ↑(C.presheaf.obj (Opposite.op V₁))
    have : IsNoetherianRing A := hNoethS U₁ hU₁
    have : IsLocalization.Away s₀ A := hU₀.isLocalization_basicOpen s₀
    have : IsLocalization.Away s₀_B B₁ := hV₀.isLocalization_basicOpen s₀_B
    let g₁_hom : A →+* B₁ := (g.appLE U₁ V₁ hV₁_le).hom
    let _ : Algebra A B₁ := g₁_hom.toAlgebra
    have : Module.Flat A B₁ := by
      have hfl : g₁_hom.Flat := g.flat_appLE hU₁ hV₁ hV₁_le
      exact hfl
    have hRes_S_eq : algebraMap A₀ A = (S.presheaf.map (CategoryTheory.homOfLE hU₁_U₀).op).hom := rfl
    have hRes_C_eq : algebraMap B₀ B₁ = (C.presheaf.map (CategoryTheory.homOfLE hV₁_V₀).op).hom := rfl
    have hg_comm : g₁_hom.comp (algebraMap A₀ A) =
        (algebraMap B₀ B₁).comp (g.appLE U₀ V₀ hV₀_le).hom := by
      rw [hRes_S_eq, hRes_C_eq]
      have h1 := g.map_appLE hV₁_le (CategoryTheory.homOfLE hU₁_U₀).op
      have h2 := g.appLE_map hV₀_le (CategoryTheory.homOfLE hV₁_V₀).op
      exact congr_arg CommRingCat.Hom.hom (h1.trans h2.symm)
    let σ : B₁ →+* A := ((τ j₀).appLE V₁ U₁ hU₁_sec).hom
    have h_id_appLE : ∀ (φ : S ⟶ S) (hφ : φ = 𝟙 S)
        (e : U₁ ≤ (TopologicalSpace.Opens.map φ.base).obj U₁),
        (φ.appLE U₁ U₁ e).hom = RingHom.id A := by
      intro φ hφ e
      subst hφ
      have he : e = (le_rfl : U₁ ≤ U₁) := Subsingleton.elim _ _
      rw [he]
      change ((𝟙 (S.presheaf.obj (Opposite.op U₁))) ≫
        S.presheaf.map (𝟙 (Opposite.op U₁))).hom = RingHom.id A
      rw [S.presheaf.map_id, CategoryTheory.Category.comp_id]
      rfl
    have hσ_id : σ.comp (algebraMap A B₁) = RingHom.id A := by
      change ((τ j₀).appLE V₁ U₁ hU₁_sec).hom.comp (g.appLE U₁ V₁ hV₁_le).hom = RingHom.id A
      have hcomp := (τ j₀).appLE_comp_appLE g U₁ V₁ U₁ hV₁_le hU₁_sec
      have hcomp_hom : ((τ j₀).appLE V₁ U₁ hU₁_sec).hom.comp (g.appLE U₁ V₁ hV₁_le).hom =
          ((τ j₀ ≫ g).appLE U₁ U₁ _).hom :=
        congr_arg CommRingCat.Hom.hom hcomp
      rw [hcomp_hom]
      exact h_id_appLE (τ j₀ ≫ g) (hSec j₀) _
    let π₁ : MvPolynomial (Fin (k₀ + 1)) A →+* B₁ :=
      MvPolynomial.eval₂Hom g₁_hom (fun i => algebraMap B₀ B₁ (π₀ (MvPolynomial.X i)))
    let F₁ : Fin k₀ → MvPolynomial (Fin (k₀ + 1)) A :=
      fun j => MvPolynomial.map (algebraMap A₀ A) (F₀ j)
    have hπ₁_C : π₁.comp MvPolynomial.C = algebraMap A B₁ := by
      ext a
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, π₁]
      rfl
    have hπ₁_map : ∀ P : MvPolynomial (Fin (k₀ + 1)) A₀,
        π₁ (MvPolynomial.map (algebraMap A₀ A) P) = algebraMap B₀ B₁ (π₀ P) := by
      intro P
      change (π₁.comp (MvPolynomial.map (algebraMap A₀ A))) P =
        ((algebraMap B₀ B₁).comp π₀) P
      congr 1
      apply MvPolynomial.ringHom_ext'
      · ext a₀
        simp only [RingHom.comp_apply, MvPolynomial.map_C,
          MvPolynomial.eval₂Hom_C, π₁]
        have h_a₀ := RingHom.congr_fun hg_comm a₀
        have h_π₀ := RingHom.congr_fun hπ₀_C a₀
        simp only [RingHom.comp_apply] at h_a₀ h_π₀
        rw [h_a₀, h_π₀]
      · intro i
        simp [π₁]
    let u_s : A := IsLocalization.Away.invSelf (S := A) s₀
    have hu_s : algebraMap A₀ A s₀ * u_s = 1 := IsLocalization.Away.mul_invSelf s₀
    have hs₀_B_eq : g₁_hom (algebraMap A₀ A s₀) = algebraMap B₀ B₁ s₀_B := by
      have h := RingHom.congr_fun hg_comm s₀
      simpa [s₀_B] using h
    have hu_sB : algebraMap B₀ B₁ s₀_B * g₁_hom u_s = 1 := by
      rw [← hs₀_B_eq, ← map_mul, hu_s, map_one]
    have hπ₁_surj : Function.Surjective π₁ := by
      intro b₁
      obtain ⟨m, b₀', hb₁⟩ := IsLocalization.Away.surj s₀_B b₁
      obtain ⟨P₀, rfl⟩ := hπ₀_surj b₀'
      refine ⟨MvPolynomial.C (u_s ^ m) * MvPolynomial.map (algebraMap A₀ A) P₀, ?_⟩
      rw [map_mul, MvPolynomial.eval₂Hom_C, hπ₁_map, ← hb₁, map_pow]
      calc g₁_hom u_s ^ m * (b₁ * algebraMap B₀ B₁ s₀_B ^ m)
          = b₁ * (algebraMap B₀ B₁ s₀_B * g₁_hom u_s) ^ m := by ring
        _ = b₁ * 1 ^ m := by rw [hu_sB]
        _ = b₁ := by simp
    have hClearDenom : ∀ P₁ : MvPolynomial (Fin (k₀ + 1)) A,
        ∃ (m : ℕ) (P₀ : MvPolynomial (Fin (k₀ + 1)) A₀),
          MvPolynomial.C (algebraMap A₀ A s₀ ^ m) * P₁ =
            MvPolynomial.map (algebraMap A₀ A) P₀ := by
      intro P₁
      induction P₁ using MvPolynomial.induction_on' with
      | monomial d a =>
        obtain ⟨m, a₀, ha⟩ := IsLocalization.Away.surj s₀ a
        refine ⟨m, MvPolynomial.monomial d a₀, ?_⟩
        rw [MvPolynomial.C_mul_monomial, MvPolynomial.map_monomial, mul_comm, ha]
      | add p q hp hq =>
        obtain ⟨mp, p₀, hp₀⟩ := hp
        obtain ⟨mq, q₀, hq₀⟩ := hq
        refine ⟨mp + mq, MvPolynomial.C (s₀ ^ mq) * p₀ + MvPolynomial.C (s₀ ^ mp) * q₀, ?_⟩
        rw [map_add, map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_C, ← hp₀, ← hq₀]
        simp only [pow_add, MvPolynomial.C_mul, map_pow]
        ring
    have hπ₁_ker : RingHom.ker π₁ = Ideal.span (Set.range F₁) := by
      apply le_antisymm
      · intro P₁ hP₁
        rw [RingHom.mem_ker] at hP₁
        obtain ⟨m, P₀, hP₀_eq⟩ := hClearDenom P₁
        have hπ₀_zero : algebraMap B₀ B₁ (π₀ P₀) = 0 := by
          rw [← hπ₁_map, ← hP₀_eq, map_mul, hP₁, mul_zero]
        have hSubZero :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers s₀_B) B₁ (π₀ P₀)).mp hπ₀_zero
        obtain ⟨⟨_, ⟨N, rfl⟩⟩, hN_zero⟩ := hSubZero
        have hInKer₀ : MvPolynomial.C (s₀ ^ N) * P₀ ∈ RingHom.ker π₀ := by
          rw [RingHom.mem_ker, map_mul]
          have hC : π₀ (MvPolynomial.C (s₀ ^ N)) = s₀_B ^ N := by
            rw [map_pow]
            have h := RingHom.congr_fun hπ₀_C s₀
            simpa [s₀_B] using congr_arg (· ^ N) h
          rw [hC]
          exact hN_zero
        rw [hπ₀_ker] at hInKer₀
        have hMapped : MvPolynomial.map (algebraMap A₀ A) (MvPolynomial.C (s₀ ^ N) * P₀) ∈
            Ideal.span (Set.range F₁) := by
          have hmem := Ideal.mem_map_of_mem (MvPolynomial.map (algebraMap A₀ A)) hInKer₀
          rw [Ideal.map_span] at hmem
          refine Ideal.span_mono ?_ hmem
          rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
          exact ⟨j, rfl⟩
        have hMapped_eq : MvPolynomial.map (algebraMap A₀ A) (MvPolynomial.C (s₀ ^ N) * P₀) =
            MvPolynomial.C (algebraMap A₀ A s₀ ^ (N + m)) * P₁ := by
          rw [map_mul, MvPolynomial.map_C, map_pow, ← hP₀_eq,
            pow_add, MvPolynomial.C_mul, mul_assoc]
        rw [hMapped_eq] at hMapped
        have hMulUnit := Ideal.mul_mem_left (Ideal.span (Set.range F₁))
          (MvPolynomial.C (u_s ^ (N + m))) hMapped
        have hCancel : MvPolynomial.C (u_s ^ (N + m)) *
            (MvPolynomial.C (algebraMap A₀ A s₀ ^ (N + m)) * P₁) = P₁ := by
          rw [← mul_assoc, ← MvPolynomial.C_mul, ← mul_pow, mul_comm u_s, hu_s,
            one_pow, MvPolynomial.C_1, one_mul]
        rwa [hCancel] at hMulUnit
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        change π₁ (MvPolynomial.map (algebraMap A₀ A) (F₀ j)) = 0
        rw [hπ₁_map]
        have hj : F₀ j ∈ RingHom.ker π₀ := by
          rw [hπ₀_ker]; exact Ideal.subset_span ⟨j, rfl⟩
        rw [RingHom.mem_ker.mp hj, map_zero]
    have hMinor₁ : IsUnit (Matrix.det ((Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
        π₁ (MvPolynomial.pderiv i (F₁ j))).submatrix (0 : Fin (k₀ + 1)).succAbove id)) := by
      let M₀ : Matrix (Fin k₀) (Fin k₀) B₀ :=
        (Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
          π₀ (MvPolynomial.pderiv i (F₀ j))).submatrix (0 : Fin (k₀ + 1)).succAbove id
      have hMatEq : ((Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
          π₁ (MvPolynomial.pderiv i (F₁ j))).submatrix (0 : Fin (k₀ + 1)).succAbove id) =
          (algebraMap B₀ B₁).mapMatrix M₀ := by
        ext i j
        simp only [Matrix.submatrix_apply, Matrix.of_apply, id_eq, RingHom.mapMatrix_apply,
          Matrix.map_apply, F₁, MvPolynomial.pderiv_map, hπ₁_map, M₀]
      rw [hMatEq, ← RingHom.map_det]
      exact hMinor₀.map (algebraMap B₀ B₁)
    obtain ⟨h, hσh, hLocChart⟩ :=
      weil_marked_smooth_retraction_lci_chart_algebra A B₁ σ hσ_id k₀ π₁ F₁
        hπ₁_C hπ₁_surj hπ₁_ker hMinor₁ hZeroAnn
    let V : C.Opens := C.basicOpen h
    have hV : AlgebraicGeometry.IsAffineOpen V := hV₁.basicOpen h
    have hV_V₁ : V ≤ V₁ := C.basicOpen_le h
    have hV_le : V ≤ (TopologicalSpace.Opens.map g.base).obj U₁ := hV_V₁.trans hV₁_le
    have hU₁_sec_V : U₁ ≤ (TopologicalSpace.Opens.map (τ j₀).base).obj V := by
      have hBasic := S.basicOpen_appLE (τ j₀) U₁ V₁ hU₁_sec h
      change S.basicOpen (σ h) = U₁ ⊓ (TopologicalSpace.Opens.map (τ j₀).base).obj V at hBasic
      rw [hσh, AlgebraicGeometry.Scheme.basicOpen_one] at hBasic
      exact fun y hy => ((SetLike.ext_iff.mp hBasic y).mp hy).2
    have hxV : x ∈ V := by
      have hb₀_in : (τ j₀).base b₀ ∈ V := hU₁_sec_V hb₀_U₁
      rwa [hb₀_eq] at hb₀_in
    let B := ↑(C.presheaf.obj (Opposite.op V))
    have : IsLocalization.Away h B := hV₁.isLocalization_basicOpen h
    let σ_B : B →+* A := ((τ j₀).appLE V U₁ hU₁_sec_V).hom
    have hσB_comp : σ_B.comp (algebraMap B₁ B) = σ := by
