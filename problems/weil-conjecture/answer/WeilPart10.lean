  haveI : Algebra.FormallyUnramified R' A'_12 := by
    let topS' : S'.Opens := ⊤
    have hAffTop : AlgebraicGeometry.IsAffineOpen topS' := AlgebraicGeometry.isAffineOpen_top S'
    let r_U := AlgebraicGeometry.Scheme.Hom.resLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial)
    have hrU_comp : r_U ≫ topS'.ι = U'₁₂.ι :=
      (@AlgebraicGeometry.Scheme.Hom.resLE_comp_ι _ _ (𝟙 S') topS' U'₁₂ (fun _ _ => trivial)).trans
        (CategoryTheory.Category.comp_id U'₁₂.ι)
    haveI : AlgebraicGeometry.IsOpenImmersion (r_U ≫ topS'.ι) := by
      rw [hrU_comp]; infer_instance
    haveI : AlgebraicGeometry.IsOpenImmersion r_U :=
      AlgebraicGeometry.IsOpenImmersion.of_comp r_U topS'.ι
    have hSpec_id : AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial)) =
        hAffU'₁₂.isoSpec.inv ≫ r_U ≫ hAffTop.isoSpec.hom := by
      have hcomm : hAffU'₁₂.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial)) =
          r_U ≫ hAffTop.isoSpec.hom := by
        rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
          AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
        exact AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial)
      calc AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') topS' U'₁₂ (fun _ _ => trivial))
          = (hAffU'₁₂.isoSpec.inv ≫ hAffU'₁₂.isoSpec.hom) ≫
