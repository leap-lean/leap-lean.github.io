    have heinv : e.inv ≫ q₁ = q₂ := by
      rw [← heq, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    have hPb : CategoryTheory.IsPullback e.inv q₂ q₁
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [heinv, CategoryTheory.Category.comp_id]⟩
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb hSm₁

