        hBot.lift_fst _ _ _
      let u₁_Ω := (hCompGrid (inc a).1).1.lift (s₁_Ω ≫ s₁_a) pt_Ω
        (by rw [CategoryTheory.Category.assoc, hs₁_a, hpt_fst])
      let u₂_Ω := (hCompGrid (inc a).2).1.lift (s₁_Ω ≫ s₂_a) pt_Ω
        (by rw [CategoryTheory.Category.assoc, hs₂_a, hpt_fst])
      have hu₁_snd : u₁_Ω ≫ ι_Ω (inc a).1 = pt_Ω := (hCompGrid (inc a).1).1.lift_snd _ _ _
      have hu₂_snd : u₂_Ω ≫ ι_Ω (inc a).2 = pt_Ω := (hCompGrid (inc a).2).1.lift_snd _ _ _
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, inferInstance⟩
      refine ⟨pt_Ω.base pt₀, ?_, ?_⟩
      · refine ⟨u₁_Ω.base pt₀, ?_⟩
        change (u₁_Ω ≫ ι_Ω (inc a).1).base pt₀ = pt_Ω.base pt₀
        rw [hu₁_snd]
      · refine ⟨u₂_Ω.base pt₀, ?_⟩
        change (u₂_Ω ≫ ι_Ω (inc a).2).base pt₀ = pt_Ω.base pt₀
        rw [hu₂_snd]

    obtain ⟨hConn_YΩ, hPair_FΩ, hIrredComp_YΩ⟩ :=
      hTopoComp c m hc F_Ω inc hClosedIrred_FΩ hCov_FΩ
