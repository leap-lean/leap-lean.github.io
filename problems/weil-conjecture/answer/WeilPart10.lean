    haveI : AlgebraicGeometry.IsOpenImmersion ι_KB :=
      CategoryTheory.MorphismProperty.of_isPullback hp_top hV₀.isOpenImmersion_fromSpec
    rcases (hStab.2.2.2.2.2.2.2.2 K s_K).2.1 (ι_KB.base p_K) with
      ⟨W_K, hyW_K, hSmW_K⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hXi, hComm⟩
    · left
      let W' : (AlgebraicGeometry.Spec (CommRingCat.of B_K)).Opens :=
        (TopologicalSpace.Opens.map ι_KB.base).obj W_K
      have hp_W' : p_K ∈ W' := hyW_K
      obtain ⟨_, ⟨f_K, rfl⟩, hf_mem, hf_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hp_W'
      have hf_not_q : f_K ∉ q_K := hf_mem
      let S_loc : Type u := Localization.Away f_K
      let j_loc : AlgebraicGeometry.Spec (CommRingCat.of S_loc) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B_K) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_K S_loc))
      haveI : AlgebraicGeometry.IsOpenImmersion j_loc :=
        AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway
          (R := CommRingCat.of B_K) f_K
      have hj_range : Set.range (j_loc ≫ ι_KB).base ⊆ Set.range W_K.ι.base := by
        rintro _ ⟨z, rfl⟩
        have hz_j : j_loc.base z ∈ PrimeSpectrum.basicOpen f_K := by
          have hrange := PrimeSpectrum.localization_away_comap_range S_loc f_K
          have hbase : j_loc.base z = PrimeSpectrum.comap (algebraMap B_K S_loc) z := by
            change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_K S_loc))).base z = _
            rw [AlgebraicGeometry.Spec.map_base]
            rfl
          have hmem : PrimeSpectrum.comap (algebraMap B_K S_loc) z ∈
              Set.range (PrimeSpectrum.comap (algebraMap B_K S_loc)) := ⟨z, rfl⟩
          rw [hrange, ← hbase] at hmem
          exact hmem
        have hz_W_K : ι_KB.base (j_loc.base z) ∈ W_K := hf_le hz_j
        exact ⟨⟨ι_KB.base (j_loc.base z), hz_W_K⟩, rfl⟩
      haveI : AlgebraicGeometry.IsOpenImmersion (j_loc ≫ ι_KB) :=
        CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance inferInstance
      let u_W : AlgebraicGeometry.Spec (CommRingCat.of S_loc) ⟶ W_K.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift W_K.ι (j_loc ≫ ι_KB) hj_range
      haveI : AlgebraicGeometry.IsOpenImmersion u_W :=
        AlgebraicGeometry.IsOpenImmersion.instLift W_K.ι (j_loc ≫ ι_KB) hj_range
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1
          (W_K.ι ≫ CategoryTheory.Limits.pullback.snd g s_K) := hSmW_K
      have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          (u_W ≫ (W_K.ι ≫ CategoryTheory.Limits.pullback.snd g s_K)) :=
        AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 u_W
          (W_K.ι ≫ CategoryTheory.Limits.pullback.snd g s_K)
      have hu_eq : u_W ≫ (W_K.ι ≫ CategoryTheory.Limits.pullback.snd g s_K) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K S_loc)) := by
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.IsOpenImmersion.lift_fac,
          CategoryTheory.Category.assoc, hι_snd]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_K S_loc)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K B_K)) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← IsScalarTower.algebraMap_eq K B_K S_loc]
      rw [Nat.zero_add, hu_eq] at hSm_comp
      have hLocSm : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension 1)
          (algebraMap K S_loc) :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hSm_comp
      obtain ⟨s, hs_span, hs_sm⟩ :=
        (RingHom.locally_iff_isLocalization
          RingHom.isStandardSmoothOfRelativeDimension_respectsIso (algebraMap K S_loc)).mp hLocSm
      have hf_ne : Φ_K f_K ≠ 0 := fun h0 => hf_not_q (RingHom.mem_ker.mpr h0)
      let Φ_loc : S_loc →+* K := IsLocalization.Away.lift f_K hf_ne.isUnit
      have ht_ex : ∃ t ∈ s, Φ_loc t ≠ 0 := by
        by_contra hall
        have hle : Ideal.span (s : Set S_loc) ≤ RingHom.ker Φ_loc := by
          rw [Ideal.span_le]
          intro t ht
          rw [SetLike.mem_coe, RingHom.mem_ker]
          by_contra hne
          exact hall ⟨t, ht, hne⟩
        rw [hs_span] at hle
        have h1 : (1 : S_loc) ∈ RingHom.ker Φ_loc := hle trivial
        exact (one_ne_zero : (1 : K) ≠ 0) ((map_one Φ_loc).symm.trans (RingHom.mem_ker.mp h1))
      obtain ⟨t, ht_s, ht_ne⟩ := ht_ex
      obtain ⟨m, g_K, ht_eq⟩ := IsLocalization.Away.surj f_K t
      have hg_ne : Φ_K g_K ≠ 0 := by
        have h1 : Φ_loc (algebraMap B_K S_loc g_K) = Φ_K g_K :=
          IsLocalization.Away.lift_eq f_K hf_ne.isUnit g_K
        rw [← h1, ← ht_eq, map_mul, map_pow,
          IsLocalization.Away.lift_eq f_K hf_ne.isUnit f_K]
        exact mul_ne_zero ht_ne (pow_ne_zero m hf_ne)
      let h_K : B_K := f_K * g_K
      have hh_not_q : h_K ∉ q_K := by
        intro hmem
        exact mul_ne_zero hf_ne hg_ne (by simpa [h_K, map_mul] using RingHom.mem_ker.mp hmem)
      have hAssoc : Associated (algebraMap B_K S_loc g_K) t := by
        let u_f : S_locˣ :=
          ((IsLocalization.Away.algebraMap_isUnit (S := S_loc) f_K).pow m).unit
        refine ⟨u_f⁻¹, ?_⟩
        calc algebraMap B_K S_loc g_K * ↑(u_f⁻¹)
            = (t * ↑u_f) * ↑(u_f⁻¹) := by rw [← ht_eq]; rfl
          _ = t * (↑u_f * ↑(u_f⁻¹)) := by ring
          _ = t := by rw [Units.mul_inv, mul_one]
      let T : Type u := Localization.Away t
      have hSm_T_hom : RingHom.IsStandardSmoothOfRelativeDimension 1
          ((algebraMap S_loc T).comp (algebraMap K S_loc)) :=
        hs_sm t ht_s T
      rw [← IsScalarTower.algebraMap_eq K S_loc T] at hSm_T_hom
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 K T :=
        (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mp hSm_T_hom
      haveI : IsLocalization.Away h_K T :=
        IsLocalization.Away.mul_of_associated f_K g_K t hAssoc
      let e_loc : T ≃ₐ[B_K] Localization.Away h_K :=
        IsLocalization.algEquiv (Submonoid.powers h_K) T (Localization.Away h_K)
      have hSm_loc : Algebra.IsStandardSmoothOfRelativeDimension 1 K (Localization.Away h_K) :=
        Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 (e_loc.restrictScalars K)
      exact ⟨h_K, hh_not_q, hSm_loc⟩
    · right
      let R_node := MvPolynomial (Fin 2) K ⧸
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) *
          (MvPolynomial.X 1 : MvPolynomial (Fin 2) K)}
      let U'_open : U'.Opens := (TopologicalSpace.Opens.map e₁.base).obj ι_KB.opensRange
      have hu₀_open : u₀ ∈ U'_open := by
        change e₁.base u₀ ∈ Set.range ι_KB.base
        rw [hu₀]
        exact ⟨p_K, rfl⟩
      obtain ⟨W', hW', hu₀_W', hW'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_open
      let R' : CommRingCat.{u} := U'.presheaf.obj (Opposite.op W')
      let A' : Type u := ↑R'
      let u'₀ : PrimeSpectrum A' := hW'.primeIdealOf ⟨u₀, hu₀_W'⟩
      have hu'₀_base : hW'.fromSpec.base u'₀ = u₀ :=
        hW'.fromSpec_primeIdealOf ⟨u₀, hu₀_W'⟩
      have hRange₁ : Set.range (hW'.fromSpec ≫ e₁).base ⊆ Set.range ι_KB.base := by
        rintro _ ⟨z, rfl⟩
        have hz_W' : hW'.fromSpec.base z ∈ W' := by
          rw [← SetLike.mem_coe, ← hW'.range_fromSpec]
          exact ⟨z, rfl⟩
        exact hW'_sub hz_W'
      let g₁ : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_K) :=
        AlgebraicGeometry.IsOpenImmersion.lift ι_KB (hW'.fromSpec ≫ e₁) hRange₁
      have hg₁_fac : g₁ ≫ ι_KB = hW'.fromSpec ≫ e₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_KB (hW'.fromSpec ≫ e₁) hRange₁
      let g₂ : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_node) :=
        hW'.fromSpec ≫ e₂
      haveI : AlgebraicGeometry.IsOpenImmersion hW'.fromSpec := hW'.isOpenImmersion_fromSpec
      haveI : AlgebraicGeometry.Etale e₁ := hEt₁
      haveI : AlgebraicGeometry.Etale e₂ := hEt₂
      have hEt_comp₁ : AlgebraicGeometry.Etale (g₁ ≫ ι_KB) := by
        rw [hg₁_fac]
        infer_instance
      have hEt_g₁ : AlgebraicGeometry.Etale g₁ :=
        CategoryTheory.MorphismProperty.of_postcomp
          (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
          g₁ ι_KB inferInstance hEt_comp₁
      have hEt_g₂ : AlgebraicGeometry.Etale g₂ := inferInstance
      let ψ₁_cat : CommRingCat.of B_K ⟶ R' := AlgebraicGeometry.Spec.preimage g₁
      let ψ₂_cat : CommRingCat.of R_node ⟶ R' := AlgebraicGeometry.Spec.preimage g₂
      let ψ₁ : B_K →+* A' := ψ₁_cat.hom
      let ψ₂ : R_node →+* A' := ψ₂_cat.hom
      let instAlgKA' : Algebra K A' := (ψ₁.comp (algebraMap K B_K)).toAlgebra
      letI : Algebra K A' := instAlgKA'
      have hAlgNode : algebraMap K R_node =
          (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) *
            (MvPolynomial.X 1 : MvPolynomial (Fin 2) K)})).comp MvPolynomial.C := rfl
      have hψ_K : ψ₂.comp (algebraMap K R_node) = ψ₁.comp (algebraMap K B_K) := by
        have hSpecEq :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K R_node) ≫ ψ₂_cat) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K B_K) ≫ ψ₁_cat) := by
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            AlgebraicGeometry.Spec.map_preimage g₁, AlgebraicGeometry.Spec.map_preimage g₂]
          change (hW'.fromSpec ≫ e₂) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K R_node)) =
            g₁ ≫ p_K_mor
          rw [hAlgNode, CategoryTheory.Category.assoc, ← hComm, ← CategoryTheory.Category.assoc,
            ← hg₁_fac, CategoryTheory.Category.assoc, hι_snd]
        exact congr_arg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_inj.mp hSpecEq)
      let φ₁ : B_K →ₐ[K] A' := ⟨ψ₁, fun _ => rfl⟩
      let φ₂ : R_node →ₐ[K] A' := ⟨ψ₂, fun c => RingHom.congr_fun hψ_K c⟩
      have hEt_φ₁ : RingHom.Etale φ₁.toRingHom := by
        rw [← AlgebraicGeometry.Spec.map_preimage g₁] at hEt_g₁
        exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hEt_g₁
      have hEt_φ₂ : RingHom.Etale φ₂.toRingHom := by
        rw [← AlgebraicGeometry.Spec.map_preimage g₂] at hEt_g₂
        exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hEt_g₂
      have hComap₁ : Ideal.comap φ₁.toRingHom u'₀.asIdeal = q_K := by
        have hg₁_pt : g₁.base u'₀ = p_K := by
          apply ι_KB.isOpenEmbedding.injective
          change (g₁ ≫ ι_KB).base u'₀ = ι_KB.base p_K
          rw [hg₁_fac]
          change e₁.base (hW'.fromSpec.base u'₀) = ι_KB.base p_K
          rw [hu'₀_base, hu₀]
        have hpre₁ : PrimeSpectrum.comap ψ₁ u'₀ = g₁.base u'₀ := by
          conv_rhs => rw [← AlgebraicGeometry.Spec.map_preimage g₁]
          rw [AlgebraicGeometry.Spec.map_base]
          rfl
        exact congr_arg PrimeSpectrum.asIdeal (hpre₁.trans hg₁_pt)
      have hX_mem : ∀ i : Fin 2,
          φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K)) ∈ u'₀.asIdeal := by
        intro i
        have hpre₂ : PrimeSpectrum.comap ψ₂ u'₀ = e₂.base u₀ := by
          have h1 : PrimeSpectrum.comap ψ₂ u'₀ = g₂.base u'₀ := by
            conv_rhs => rw [← AlgebraicGeometry.Spec.map_preimage g₂]
            rw [AlgebraicGeometry.Spec.map_base]
            rfl
          rw [h1]
          change e₂.base (hW'.fromSpec.base u'₀) = e₂.base u₀
          rw [hu'₀_base]
        change Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K) ∈
          (PrimeSpectrum.comap ψ₂ u'₀).asIdeal
        rw [hpre₂]
        exact hXi i
      exact ⟨A', inferInstance, instAlgKA', u'₀, φ₁, φ₂, hEt_φ₁, hEt_φ₂, hComap₁, hX_mem⟩

theorem weil_marked_smooth_retraction_lci_chart_algebra (A B₁ : Type u) [CommRing A] [IsNoetherianRing A]
    [CommRing B₁] [Algebra A B₁] [Module.Flat A B₁]
    (σ : B₁ →+* A)
    (hσ : σ.comp (algebraMap A B₁) = RingHom.id A)
    (k₀ : ℕ)
    (π₁ : MvPolynomial (Fin (k₀ + 1)) A →+* B₁)
    (F₁ : Fin k₀ → MvPolynomial (Fin (k₀ + 1)) A)
    (hπ₁_C : π₁.comp MvPolynomial.C = algebraMap A B₁)
    (hπ₁_surj : Function.Surjective π₁)
    (hπ₁_ker : RingHom.ker π₁ = Ideal.span (Set.range F₁))
    (hMinor₁ : IsUnit (Matrix.det ((Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
      π₁ (MvPolynomial.pderiv i (F₁ j))).submatrix (0 : Fin (k₀ + 1)).succAbove id)))
    (hZeroAnn : ∀ (A' B' : Type u) [CommRing A'] [IsNoetherianRing A']
      [CommRing B'] [Algebra A' B'] [Module.Flat A' B'] (S_gen : Set B'),
      (∀ (p : PrimeSpectrum A'),
        let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
        letI : Algebra A' Ω :=
          ((algebraMap p.asIdeal.ResidueField Ω).comp
            (algebraMap A' p.asIdeal.ResidueField)).toAlgebra
        ∀ z : TensorProduct A' B' Ω,
          (∀ b ∈ S_gen, TensorProduct.tmul A' b (1 : Ω) * z = 0) → z = 0) →
      ∀ z : B', (∀ b ∈ S_gen, b * z = 0) → z = 0) :
    ∃ h : B₁,
      σ h = 1 ∧
      ∀ (B : Type u) [CommRing B] [Algebra B₁ B] [IsLocalization.Away h B]
        (σ_B : B →+* A),
        σ_B.comp (algebraMap B₁ B) = σ →
        ∃ (π : MvPolynomial (Fin ((k₀ + 1) + 1)) A →+* B)
          (F : Fin (k₀ + 1) → MvPolynomial (Fin ((k₀ + 1) + 1)) A)
          (t : B),
          π.comp MvPolynomial.C = (algebraMap B₁ B).comp (algebraMap A B₁) ∧
          Function.Surjective π ∧
          RingHom.ker π = Ideal.span (Set.range F) ∧
          RingHom.ker σ_B = Ideal.span {t} ∧
          (∀ b : B, b * t = 0 → b = 0) ∧
          IsUnit (Matrix.det ((Matrix.of fun (i : Fin ((k₀ + 1) + 1)) (j : Fin (k₀ + 1)) =>
            π (MvPolynomial.pderiv i (F j))).submatrix (0 : Fin ((k₀ + 1) + 1)).succAbove id)) :=
by
  have _ := hZeroAnn
  have hσ_alg : ∀ a : A, σ (algebraMap A B₁ a) = a := fun a =>
    by simpa using RingHom.congr_fun hσ a
  have hπ₁_C_apply : ∀ a : A, π₁ (MvPolynomial.C a) = algebraMap A B₁ a := fun a =>
    by simpa using RingHom.congr_fun hπ₁_C a
  
  let c : Fin (k₀ + 1) → A := fun i => σ (π₁ (MvPolynomial.X i))
  let S_pos : MvPolynomial (Fin (k₀ + 1)) A →+* MvPolynomial (Fin (k₀ + 1)) A :=
    MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i + MvPolynomial.C (c i))
  let S_neg : MvPolynomial (Fin (k₀ + 1)) A →+* MvPolynomial (Fin (k₀ + 1)) A :=
    MvPolynomial.eval₂Hom MvPolynomial.C (fun i => MvPolynomial.X i - MvPolynomial.C (c i))
  have hS_pos_neg : S_pos.comp S_neg = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext'
    · ext a; simp [S_pos, S_neg]
    · intro i; simp [S_pos, S_neg]
  have hS_neg_pos : S_neg.comp S_pos = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext'
    · ext a; simp [S_pos, S_neg]
    · intro i; simp [S_pos, S_neg]
  have hS_pn_apply : ∀ P, S_pos (S_neg P) = P := fun P =>
    by simpa using RingHom.congr_fun hS_pos_neg P
  have hS_np_apply : ∀ P, S_neg (S_pos P) = P := fun P =>
    by simpa using RingHom.congr_fun hS_neg_pos P
  let π'₁ : MvPolynomial (Fin (k₀ + 1)) A →+* B₁ := π₁.comp S_neg
  let F'₁ : Fin k₀ → MvPolynomial (Fin (k₀ + 1)) A := fun j => S_pos (F₁ j)
  let y : Fin (k₀ + 1) → B₁ := fun i => π'₁ (MvPolynomial.X i)
  have hπ'₁_C_apply : ∀ a : A, π'₁ (MvPolynomial.C a) = algebraMap A B₁ a := by
    intro a
    change π₁ (S_neg (MvPolynomial.C a)) = algebraMap A B₁ a
    rw [MvPolynomial.eval₂Hom_C]
    exact hπ₁_C_apply a
  have hπ'₁_S_pos : ∀ P, π'₁ (S_pos P) = π₁ P := by
    intro P
    change π₁ (S_neg (S_pos P)) = π₁ P
    rw [hS_np_apply]
  have hπ'₁_surj : Function.Surjective π'₁ := by
    intro b₁
    obtain ⟨P, rfl⟩ := hπ₁_surj b₁
    exact ⟨S_pos P, hπ'₁_S_pos P⟩
  have hπ'₁_ker : RingHom.ker π'₁ = Ideal.span (Set.range F'₁) := by
    apply le_antisymm
    · intro P hP
      rw [RingHom.mem_ker] at hP
      have hSn : S_neg P ∈ RingHom.ker π₁ := hP
      rw [hπ₁_ker] at hSn
      have hMap := Ideal.mem_map_of_mem S_pos hSn
      rw [hS_pn_apply, Ideal.map_span] at hMap
      refine Ideal.span_mono ?_ hMap
      rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      exact ⟨j, rfl⟩
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      change π'₁ (S_pos (F₁ j)) = 0
      rw [hπ'₁_S_pos]
      have hj : F₁ j ∈ RingHom.ker π₁ := by
        rw [hπ₁_ker]
        exact Ideal.subset_span ⟨j, rfl⟩
      exact hj
  have hσ_y : ∀ i : Fin (k₀ + 1), σ (y i) = 0 := by
    intro i
    change σ (π₁ (S_neg (MvPolynomial.X i))) = 0
    simp only [S_neg, MvPolynomial.eval₂Hom_X', map_sub, hπ₁_C_apply, hσ_alg, c, sub_self]
  have hpderiv_S_pos : ∀ (i : Fin (k₀ + 1)) (P : MvPolynomial (Fin (k₀ + 1)) A),
      MvPolynomial.pderiv i (S_pos P) = S_pos (MvPolynomial.pderiv i P) := by
    intro i P
    induction P using MvPolynomial.induction_on with
    | C a =>
      simp [S_pos]
    | add p q hp hq =>
      rw [map_add, map_add, hp, hq, map_add, map_add]
    | mul_X p m hp =>
      rw [map_mul, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hp]
      congr 2
      have hX : S_pos (MvPolynomial.X m) = MvPolynomial.X m + MvPolynomial.C (c m) :=
        MvPolynomial.eval₂Hom_X' _ _ m
      rw [hX, map_add, MvPolynomial.pderiv_C, add_zero]
      by_cases hmi : m = i
      · subst hmi
        rw [MvPolynomial.pderiv_X_self, map_one]
      · rw [MvPolynomial.pderiv_X_of_ne hmi, map_zero]
  let M₁ : Matrix (Fin k₀) (Fin k₀) B₁ :=
    (Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
      π'₁ (MvPolynomial.pderiv i (F'₁ j))).submatrix (0 : Fin (k₀ + 1)).succAbove id
  have hMinor'₁ : IsUnit (Matrix.det M₁) := by
    have hEq : M₁ = (Matrix.of fun (i : Fin (k₀ + 1)) (j : Fin k₀) =>
        π₁ (MvPolynomial.pderiv i (F₁ j))).submatrix (0 : Fin (k₀ + 1)).succAbove id := by
      ext r j
      simp only [M₁, Matrix.submatrix_apply, Matrix.of_apply, id_eq, F'₁, hpderiv_S_pos, hπ'₁_S_pos]
    rwa [hEq]
  have hσ_π'₁ : ∀ P : MvPolynomial (Fin (k₀ + 1)) A,
      σ (π'₁ P) = MvPolynomial.constantCoeff P := by
    intro P
    change (σ.comp π'₁) P = MvPolynomial.constantCoeff P
    congr 1
    apply MvPolynomial.ringHom_ext'
    · ext a
      simp [hπ'₁_C_apply, hσ_alg]
    · intro i
      simp [y, hσ_y]
