        change (Algebra.TensorProduct.map (valA₁ j₂) (AlgHom.id A₁ M₁))
            (v₂_tilde (u₂_tilde ((1 : _) ⊗ₜ[A₁] m))) = (1 : K) ⊗ₜ[A₁] m
        rw [h1, h2, Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
        exact e_bar.symm_apply_apply ((1 : K) ⊗ₜ[A₁] m)
      obtain ⟨j₃, h₂₃_a, h₂₃_b, h_eq_j₃⟩ :=
        RingHom.EssFiniteType.exists_comp_map_eq_of_isColimit
