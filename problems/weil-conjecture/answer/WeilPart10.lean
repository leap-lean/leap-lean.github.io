  let β₀ : A₀ ⟶ CommRingCat.of K :=
    CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom
  let π₀ : Spec A₀ ⟶ B₂.left := μ₀ ≫ U₀.ι
  let p₀ := Limits.pullback.snd f₂.left π₀
  obtain ⟨h_base, σ₀, ι'_K, hh_base, hBasic_U₂_0, hProp_p₀, hLFP_p₀,
    hSec_p₀, hσ₀_fst, hPb'_K, hσ'_K⟩ :=
    hStep1 k B₂ X₂ U₂ hU₂ f₂ hFib₂.2.1.1 n σ hFib₂.2.2.1
      K₀ η₀ hFuncK₀ K C_K p_K ι_K σ_K hSecK hPbK hσK F₀ π₀ hμ₀_K
  obtain ⟨J, instSmallJ, instFiltJ, B_diag, α_diag, ι_colim, hColim, hα_comp, hUnpack⟩ :=
    hStep2 k K V F₀ hF₀ h_base hh_base
  let _ : SmallCategory J := instSmallJ
  have _ : IsFiltered J := instFiltJ
  obtain ⟨i_star, e_star, s_C, he_snd, hsC_fst, hsC_snd, hsC_hom⟩ :=
    hIsoDesc A₀ (CommRingCat.of K) β₀ J B_diag α_diag ι_colim hColim hα_comp
      n C₀ (Limits.pullback f₂.left π₀) g₀ p₀ τ₀ σ₀
      hProp₀ hLFP₀ hSec₀ hProp_p₀ hLFP_p₀ hSec_p₀
      C_K p_K σ_K ι₀_K ι'_K hSecK hPb₀ hσ₀ hPb'_K hσ'_K
  obtain ⟨F_V, hSub, h_V, φ_away, hFV, hh_V, hle_basic, hLoc, hα_ring⟩ :=
    hUnpack i_star
  let A_V : CommRingCat.{u} := CommRingCat.of ↥(Algebra.adjoin k (↑F_V : Set K))
  let inc_V : ↥(Algebra.adjoin k (↑F₀ : Set K)) →+* ↥(Algebra.adjoin k (↑F_V : Set K)) :=
    (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))).toRingHom
  let ρ_V : Spec A_V ⟶ Spec A₀ := Spec.map (CommRingCat.ofHom inc_V)
  have hα_spec_eq : Spec.map (α_diag.app i_star) = Spec.map φ_away ≫ ρ_V := by
    rw [hα_ring, Spec.map_comp]
  refine ⟨F_V, hSub, h_V, hFV, hh_V, ?_, ?_⟩
  · exact fun q hq => hBasic_U₂_0 (hle_basic hq)
  · exact hStep5 k B₂ X₂ f₂ n σ A₀ A_V (B_diag.obj i_star) π₀ ρ_V h_V φ_away hLoc
      C₀ g₀ τ₀ σ₀ hσ₀_fst
      (fun j => Limits.pullback.lift (ρ_V ≫ τ₀ j) (𝟙 _)
        (by rw [Category.assoc, hSec₀ j, Category.comp_id, Category.id_comp]))
      (fun j => Limits.pullback.lift_fst _ _ _)
      (fun j => Limits.pullback.lift_snd _ _ _)
      (Spec.map (α_diag.app i_star)) hα_spec_eq e_star s_C he_snd hsC_fst hsC_snd hsC_hom

theorem weil_projectiveOverField_pullback (k : Type u) [Field k]
    {B C B₁ C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
    (f : C ⟶ B) (ψ : B₁ ⟶ B) (f₁ : C₁ ⟶ B₁) (ψ_C : C₁ ⟶ C)
    (hPb : CategoryTheory.IsPullback ψ_C.left f₁.left f.left ψ.left)
    (hProjB : IsProjectiveOverField k B)
    (hProjC : IsProjectiveOverField k C)
    (hProjB₁ : IsProjectiveOverField k B₁) :
    IsProjectiveOverField k C₁ :=
by
  obtain ⟨N_C, ι_C, hCl_C⟩ := hProjC
  obtain ⟨N₂, ι₁, hCl₁⟩ := hProjB₁
  
  have hPart1 :
      ∃ (j : C₁.left ⟶ CategoryTheory.Limits.pullback
          (weilProjectiveSpaceOver k N_C).hom (weilProjectiveSpaceOver k N₂).hom),
        AlgebraicGeometry.IsClosedImmersion j ∧
        j ≫ CategoryTheory.Limits.pullback.fst
            (weilProjectiveSpaceOver k N_C).hom (weilProjectiveSpaceOver k N₂).hom ≫
          (weilProjectiveSpaceOver k N_C).hom = C₁.hom := by
    obtain ⟨N_B, ι_B, hCl_B⟩ := hProjB
    let P_B := weilProjectiveSpaceOver k N_B
    let P_C := weilProjectiveSpaceOver k N_C
    let P₁ := weilProjectiveSpaceOver k N₂
    have hSepPB_left : P_B.left.IsSeparated := by
      let 𝒜_B := MvPolynomial.homogeneousSubmodule (Fin (N_B + 1)) k
      let _ : GradedAlgebra 𝒜_B := MvPolynomial.gradedAlgebra
      change (AlgebraicGeometry.Proj 𝒜_B).IsSeparated
      infer_instance
    have hSepPB_hom : AlgebraicGeometry.IsSeparated P_B.hom := by
      have _ := hSepPB_left
      infer_instance
    have hSepB_hom : AlgebraicGeometry.IsSeparated B.hom := by
      have _ := hCl_B
      have _ := hSepPB_hom
      rw [← CategoryTheory.Over.w ι_B]
      infer_instance
    have _ := hSepB_hom
    let δ : C₁.left ⟶ CategoryTheory.Limits.pullback C.hom B₁.hom :=
      hPb.isoPullback.hom ≫
        CategoryTheory.Limits.pullback.mapDesc f.left ψ.left B.hom ≫
        (CategoryTheory.Limits.pullback.congrHom
          (CategoryTheory.Over.w f) (CategoryTheory.Over.w ψ)).hom
    have hCl_δ : AlgebraicGeometry.IsClosedImmersion δ := by
      dsimp only [δ]
      infer_instance
    have hδ_fst : δ ≫ CategoryTheory.Limits.pullback.fst C.hom B₁.hom = ψ_C.left := by
      dsimp only [δ]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.congrHom_hom,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id,
        CategoryTheory.Limits.pullback.mapDesc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.comp_id, hPb.isoPullback_hom_fst]
    let m₁ : CategoryTheory.Limits.pullback C.hom B₁.hom ⟶
        CategoryTheory.Limits.pullback P_C.hom B₁.hom :=
      CategoryTheory.Limits.pullback.map C.hom B₁.hom P_C.hom B₁.hom
        ι_C.left (𝟙 B₁.left) (𝟙 _)
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Over.w ι_C])
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hm₁_fst : m₁ ≫ CategoryTheory.Limits.pullback.fst P_C.hom B₁.hom =
        CategoryTheory.Limits.pullback.fst C.hom B₁.hom ≫ ι_C.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm₁_snd : m₁ ≫ CategoryTheory.Limits.pullback.snd P_C.hom B₁.hom =
        CategoryTheory.Limits.pullback.snd C.hom B₁.hom := by
      erw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have hPb_m₁ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst C.hom B₁.hom) m₁
        ι_C.left (CategoryTheory.Limits.pullback.fst P_C.hom B₁.hom) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hm₁_fst.symm
        (CategoryTheory.IsPullback.of_hasPullback P_C.hom B₁.hom)
      have h0 := CategoryTheory.IsPullback.of_hasPullback C.hom B₁.hom
      rwa [hm₁_snd, CategoryTheory.Over.w ι_C]
    have hCl_m₁ : AlgebraicGeometry.IsClosedImmersion m₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_m₁ hCl_C
    let m₂ : CategoryTheory.Limits.pullback P_C.hom B₁.hom ⟶
        CategoryTheory.Limits.pullback P_C.hom P₁.hom :=
      CategoryTheory.Limits.pullback.map P_C.hom B₁.hom P_C.hom P₁.hom
        (𝟙 P_C.left) ι₁.left (𝟙 _)
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Over.w ι₁])
    have hm₂_fst : m₂ ≫ CategoryTheory.Limits.pullback.fst P_C.hom P₁.hom =
        CategoryTheory.Limits.pullback.fst P_C.hom B₁.hom := by
      erw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
    have hm₂_snd : m₂ ≫ CategoryTheory.Limits.pullback.snd P_C.hom P₁.hom =
        CategoryTheory.Limits.pullback.snd P_C.hom B₁.hom ≫ ι₁.left :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_m₂ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd P_C.hom B₁.hom) m₂
        ι₁.left (CategoryTheory.Limits.pullback.snd P_C.hom P₁.hom) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hm₂_snd.symm
        (CategoryTheory.IsPullback.of_hasPullback P_C.hom P₁.hom).flip
      have h0 := (CategoryTheory.IsPullback.of_hasPullback P_C.hom B₁.hom).flip
      rwa [hm₂_fst, CategoryTheory.Over.w ι₁]
    have hCl_m₂ : AlgebraicGeometry.IsClosedImmersion m₂ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_m₂ hCl₁
    let j := δ ≫ m₁ ≫ m₂
    have hCl_j : AlgebraicGeometry.IsClosedImmersion j := by
      have _ := hCl_δ
      have _ := hCl_m₁
      have _ := hCl_m₂
      dsimp only [j]
      infer_instance
    refine ⟨j, hCl_j, ?_⟩
    calc j ≫ CategoryTheory.Limits.pullback.fst P_C.hom P₁.hom ≫ P_C.hom
        = δ ≫ m₁ ≫ (m₂ ≫ CategoryTheory.Limits.pullback.fst P_C.hom P₁.hom) ≫ P_C.hom := by
            simp only [j, CategoryTheory.Category.assoc]
      _ = δ ≫ (m₁ ≫ CategoryTheory.Limits.pullback.fst P_C.hom B₁.hom) ≫ P_C.hom := by
            rw [hm₂_fst]; simp only [CategoryTheory.Category.assoc]
      _ = (δ ≫ CategoryTheory.Limits.pullback.fst C.hom B₁.hom) ≫ (ι_C.left ≫ P_C.hom) := by
            rw [hm₁_fst]
            simp only [CategoryTheory.Category.assoc]
      _ = ψ_C.left ≫ C.hom := by
            rw [hδ_fst, CategoryTheory.Over.w ι_C]
      _ = C₁.hom := CategoryTheory.Over.w ψ_C
  
  have hHomLoc : ∀ M : ℕ,
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k)) ∧
      ∀ (i₀ : Fin (M + 1)),
        HomogeneousLocalization.Away.isLocalizationElem
          (𝒜 := 𝒜) (MvPolynomial.isHomogeneous_X k i₀) (MvPolynomial.isHomogeneous_X k i₀) = 1 ∧
        Subring.closure
          (Set.range ((HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X i₀))).comp (algebraMap k ↥(𝒜 0))) ∪
            Set.range (fun a : Fin (M + 1) =>
              HomogeneousLocalization.Away.isLocalizationElem
                (𝒜 := 𝒜) (MvPolynomial.isHomogeneous_X k i₀) (MvPolynomial.isHomogeneous_X k a))) = ⊤ := by
    intro M
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    change (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k)) ∧
      ∀ (i₀ : Fin (M + 1)),
        HomogeneousLocalization.Away.isLocalizationElem
          (𝒜 := 𝒜) (MvPolynomial.isHomogeneous_X k i₀) (MvPolynomial.isHomogeneous_X k i₀) = 1 ∧
        Subring.closure
          (Set.range ((HomogeneousLocalization.fromZeroRingHom 𝒜
              (Submonoid.powers (MvPolynomial.X i₀))).comp (algebraMap k ↥(𝒜 0))) ∪
            Set.range (fun a : Fin (M + 1) =>
              HomogeneousLocalization.Away.isLocalizationElem
                (𝒜 := 𝒜) (MvPolynomial.isHomogeneous_X k i₀) (MvPolynomial.isHomogeneous_X k a))) = ⊤
    refine ⟨?_, ?_⟩
    · rw [HomogeneousIdeal.toIdeal_irrelevant_le]
      intro d hd P hP
      have hP_hom : P.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d P).mp hP
      rw [MvPolynomial.as_sum P]
      refine Ideal.sum_mem _ fun m hm => ?_
      have hm_ne : P.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      have hdeg : ∑ a ∈ m.support, m a = d := by
        simpa [MvPolynomial.IsHomogeneous, Finsupp.weight_apply, Finsupp.sum] using hP_hom hm_ne
      have hex : ∃ a₀ : Fin (M + 1), m a₀ ≠ 0 := by
        by_contra hall
        have hm_zero : m = 0 := Finsupp.ext fun a => Classical.not_not.mp (not_exists.mp hall a)
        subst hm_zero
        simp at hdeg
        omega
      obtain ⟨a₀, ha₀⟩ := hex
      have hle : Finsupp.single a₀ 1 ≤ m := by
        intro a
        by_cases h : a₀ = a
        · subst h; simp; omega
        · simp [h]
      have hm_split : (m - Finsupp.single a₀ 1) + Finsupp.single a₀ 1 = m :=
        tsub_add_cancel_of_le hle
      have hmon_eq : (MvPolynomial.monomial m) (P.coeff m) =
          (MvPolynomial.monomial (m - Finsupp.single a₀ 1)) (P.coeff m) * MvPolynomial.X a₀ := by
        rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, hm_split, mul_one]
      rw [hmon_eq]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a₀, rfl⟩)
    · intro i₀
      let hx₀ : MvPolynomial.X i₀ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k i₀
      let S₀ := Submonoid.powers (MvPolynomial.X i₀ : MvPolynomial (Fin (M + 1)) k)
      let c₀ : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S₀).comp (algebraMap k ↥(𝒜 0))
      let r : Fin (M + 1) → HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
        fun a => HomogeneousLocalization.Away.isLocalizationElem
          (𝒜 := 𝒜) hx₀ (MvPolynomial.isHomogeneous_X k a)
      have hr_val : ∀ a : Fin (M + 1),
          (r a).val = Localization.mk (MvPolynomial.X a)
            ⟨MvPolynomial.X i₀, Submonoid.mem_powers _⟩ := by
        intro a
        simp [r, HomogeneousLocalization.Away.isLocalizationElem]
      have hc₀_val : ∀ c : k,
          (c₀ c).val = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        simp [c₀, HomogeneousLocalization.fromZeroRingHom]
        rfl
      refine ⟨?_, ?_⟩
      · rw [HomogeneousLocalization.ext_iff_val, hr_val i₀, HomogeneousLocalization.val_one]
        exact Localization.mk_self ⟨MvPolynomial.X i₀, Submonoid.mem_powers _⟩
      · rw [eq_top_iff]
        intro w _
        let S_gen : Set (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀)) :=
          Set.range c₀ ∪ Set.range r
        change w ∈ Subring.closure S_gen
        obtain ⟨d, P, hP, rfl⟩ :=
          HomogeneousLocalization.Away.mk_surjective 𝒜 hx₀ w
        have hP_hom : P.IsHomogeneous d := by
          have hP' : P ∈ 𝒜 d := by simpa using hP
          exact (MvPolynomial.mem_homogeneousSubmodule d P).mp hP'
        let w' : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀) :=
          ∑ m ∈ P.support, c₀ (P.coeff m) * ∏ a ∈ m.support, (r a) ^ (m a)
        have hw'_mem : w' ∈ Subring.closure S_gen := by
          refine Subring.sum_mem _ fun m _ => Subring.mul_mem _ ?_ ?_
          · exact Subring.subset_closure (Or.inl ⟨P.coeff m, rfl⟩)
          · refine Subring.prod_mem _ fun a _ => Subring.pow_mem _ ?_ _
            exact Subring.subset_closure (Or.inr ⟨a, rfl⟩)
        suffices hw_eq : w' = HomogeneousLocalization.Away.mk 𝒜 hx₀ d P hP by
          rwa [← hw_eq]
        rw [HomogeneousLocalization.ext_iff_val]
        let ι_val := algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀))
          (Localization S₀)
        have hι_apply : ∀ y, ι_val y = y.val := HomogeneousLocalization.algebraMap_apply
        have hmk_pow : ∀ (u : MvPolynomial (Fin (M + 1)) k) (s : S₀) (n : ℕ),
            (Localization.mk u s) ^ n = Localization.mk (u ^ n) (s ^ n) := by
          intro u s n
          induction n with
          | zero => simp [Localization.mk_one]
          | succ n ih => rw [pow_succ, pow_succ, pow_succ, ih, Localization.mk_mul]
        have hmk_prod' : ∀ (F : Finset (Fin (M + 1)))
            (f_u : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k) (f_s : Fin (M + 1) → S₀),
            (∏ a ∈ F, Localization.mk (f_u a) (f_s a)) =
              Localization.mk (∏ a ∈ F, f_u a) (∏ a ∈ F, f_s a) := by
          intro F f_u f_s
          classical
          induction F using Finset.induction_on with
          | empty => simp [Localization.mk_one]
          | @insert a F ha ih =>
            rw [Finset.prod_insert ha, Finset.prod_insert ha, Finset.prod_insert ha,
              ih, Localization.mk_mul]
        let s_d : S₀ := ⟨(MvPolynomial.X i₀) ^ d, Submonoid.pow_mem _ (Submonoid.mem_powers _) d⟩
        have hmk_sum : ∀ (F : Finset (Fin (M + 1) →₀ ℕ))
            (f_u : (Fin (M + 1) →₀ ℕ) → MvPolynomial (Fin (M + 1)) k),
            (∑ m ∈ F, Localization.mk (f_u m) s_d) =
              Localization.mk (∑ m ∈ F, f_u m) s_d := by
          intro F f_u
          classical
          induction F using Finset.induction_on with
          | empty => simp [Localization.mk_zero]
          | @insert m F hm ih =>
            rw [Finset.sum_insert hm, Finset.sum_insert hm, ih, Localization.add_mk_self]
        calc w'.val
            = ι_val w' := (hι_apply w').symm
          _ = ∑ m ∈ P.support, ι_val (c₀ (P.coeff m)) * ∏ a ∈ m.support, (ι_val (r a)) ^ (m a) := by
              simp only [w', map_sum, map_mul, map_prod, map_pow]
          _ = ∑ m ∈ P.support,
                Localization.mk ((MvPolynomial.monomial m) (P.coeff m)) s_d := by
              refine Finset.sum_congr rfl fun m hm => ?_
              rw [hι_apply, hc₀_val]
              have hprod_eq : (∏ a ∈ m.support, (ι_val (r a)) ^ (m a)) =
                  Localization.mk (∏ a ∈ m.support, MvPolynomial.X a ^ m a) s_d := by
                have h1 : (∏ a ∈ m.support, (ι_val (r a)) ^ (m a)) =
                    ∏ a ∈ m.support, Localization.mk (MvPolynomial.X a ^ m a)
                      (⟨MvPolynomial.X i₀, Submonoid.mem_powers _⟩ ^ m a : S₀) := by
                  refine Finset.prod_congr rfl fun a _ => ?_
                  rw [hι_apply, hr_val, hmk_pow]
                rw [h1, hmk_prod']
                have hdeg : ∑ a ∈ m.support, m a = d := by
                  simpa [MvPolynomial.IsHomogeneous, Finsupp.weight_apply, Finsupp.sum] using
                    hP_hom (MvPolynomial.mem_support_iff.mp hm)
                have hs_eq : (∏ a ∈ m.support,
                    (⟨MvPolynomial.X i₀, Submonoid.mem_powers _⟩ ^ m a : S₀)) = s_d := by
                  apply Subtype.ext
                  simp only [Submonoid.coe_finsetProd, SubmonoidClass.coe_pow, s_d]
                  rw [Finset.prod_pow_eq_pow_sum, hdeg]
                rw [hs_eq]
              rw [hprod_eq, Localization.mk_mul]
              have h_one_sd : (1 : S₀) * s_d = s_d := one_mul s_d
              have hmon : MvPolynomial.C (P.coeff m) * (∏ a ∈ m.support, MvPolynomial.X a ^ m a) =
                  (MvPolynomial.monomial m) (P.coeff m) := by
                rw [MvPolynomial.monomial_eq]
                rfl
              rw [h_one_sd, hmon]
          _ = Localization.mk (∑ m ∈ P.support, (MvPolynomial.monomial m) (P.coeff m)) s_d :=
              hmk_sum P.support _
          _ = Localization.mk P s_d := by rw [← MvPolynomial.as_sum P]
          _ = (HomogeneousLocalization.Away.mk 𝒜 hx₀ d P hP).val :=
              (HomogeneousLocalization.Away.val_mk 𝒜 d hx₀ P hP).symm
  
  let N₁ := N_C
  let N := (N₁ + 1) * (N₂ + 1) - 1
  have hSegre :
      ∃ (σ : CategoryTheory.Limits.pullback
          (weilProjectiveSpaceOver k N₁).hom (weilProjectiveSpaceOver k N₂).hom ⟶
          (weilProjectiveSpaceOver k N).left),
        AlgebraicGeometry.IsClosedImmersion σ ∧
        σ ≫ (weilProjectiveSpaceOver k N).hom =
          CategoryTheory.Limits.pullback.fst
            (weilProjectiveSpaceOver k N₁).hom (weilProjectiveSpaceOver k N₂).hom ≫
          (weilProjectiveSpaceOver k N₁).hom := by
    have h_card : N + 1 = (N₁ + 1) * (N₂ + 1) :=
      Nat.sub_add_cancel (Nat.mul_pos (Nat.succ_pos N₁) (Nat.succ_pos N₂))
    let e : Fin (N + 1) ≃ Fin (N₁ + 1) × Fin (N₂ + 1) :=
      (finProdFinEquiv.trans (Fin.castOrderIso h_card).toEquiv).symm
    let _ : ∀ (M : ℕ),
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) :=
      fun _ => MvPolynomial.gradedAlgebra
    let _ : ∀ {M : ℕ} (S : Submonoid (MvPolynomial (Fin (M + 1)) k)),
        Algebra k (HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) S) :=
      fun {M} S =>
        ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k) S).comp
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0))).toAlgebra
    let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) k
    let 𝒜₂ := MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) k
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let P₁ := weilProjectiveSpaceOver k N₁
    let P₂ := weilProjectiveSpaceOver k N₂
    let P_N := weilProjectiveSpaceOver k N
    let X₁ (i : Fin (N₁ + 1)) : MvPolynomial (Fin (N₁ + 1)) k := MvPolynomial.X i
    let X₂ (j : Fin (N₂ + 1)) : MvPolynomial (Fin (N₂ + 1)) k := MvPolynomial.X j
    let X_N (ν : Fin (N + 1)) : MvPolynomial (Fin (N + 1)) k := MvPolynomial.X ν
    let hX₁ : ∀ i : Fin (N₁ + 1), X₁ i ∈ 𝒜₁ 1 := MvPolynomial.isHomogeneous_X k
    let hX₂ : ∀ j : Fin (N₂ + 1), X₂ j ∈ 𝒜₂ 1 := MvPolynomial.isHomogeneous_X k
    let hX_N : ∀ ν : Fin (N + 1), X_N ν ∈ 𝒜_N 1 := MvPolynomial.isHomogeneous_X k
    let A (i : Fin (N₁ + 1)) := HomogeneousLocalization.Away 𝒜₁ (X₁ i)
    let B (j : Fin (N₂ + 1)) := HomogeneousLocalization.Away 𝒜₂ (X₂ j)
    let C (ν : Fin (N + 1)) := HomogeneousLocalization.Away 𝒜_N (X_N ν)
    let u₁ (i : Fin (N₁ + 1)) : AlgebraicGeometry.Spec (CommRingCat.of (A i)) ⟶ P₁.left :=
      AlgebraicGeometry.Proj.awayι 𝒜₁ (X₁ i) (hX₁ i) zero_lt_one
    let v₂ (j : Fin (N₂ + 1)) : AlgebraicGeometry.Spec (CommRingCat.of (B j)) ⟶ P₂.left :=
      AlgebraicGeometry.Proj.awayι 𝒜₂ (X₂ j) (hX₂ j) zero_lt_one
    let w_N (ν : Fin (N + 1)) : AlgebraicGeometry.Spec (CommRingCat.of (C ν)) ⟶ P_N.left :=
      AlgebraicGeometry.Proj.awayι 𝒜_N (X_N ν) (hX_N ν) zero_lt_one
    let 𝒰₁ : P₁.left.OpenCover :=
      (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan 𝒜₁
        X₁ hX₁ (fun _ => zero_lt_one) (hHomLoc N₁).1).openCover
    let 𝒰₂ : P₂.left.OpenCover :=
      (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan 𝒜₂
        X₂ hX₂ (fun _ => zero_lt_one) (hHomLoc N₂).1).openCover
    let 𝒰_N : P_N.left.OpenCover :=
      (AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan 𝒜_N
        X_N hX_N (fun _ => zero_lt_one) (hHomLoc N).1).openCover
    let 𝒰₁₂ := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight 𝒰₁ 𝒰₂ P₁.hom P₂.hom
    have hu_hom : ∀ i : Fin (N₁ + 1),
        u₁ i ≫ P₁.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (A i))) := by
      intro i
      change AlgebraicGeometry.Proj.awayι 𝒜₁ (X₁ i) (hX₁ i) zero_lt_one ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₁ 0)))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
        CommRingCat.ofHom_comp]
    have hv_hom : ∀ j : Fin (N₂ + 1),
        v₂ j ≫ P₂.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (B j))) := by
      intro j
      change AlgebraicGeometry.Proj.awayι 𝒜₂ (X₂ j) (hX₂ j) zero_lt_one ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜₂ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₂ 0)))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
        CommRingCat.ofHom_comp]
    have hw_hom : ∀ ν : Fin (N + 1),
        w_N ν ≫ P_N.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (C ν))) := by
      intro ν
      change AlgebraicGeometry.Proj.awayι 𝒜_N (X_N ν) (hX_N ν) zero_lt_one ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
        CommRingCat.ofHom_comp]
    let θ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        CategoryTheory.Limits.pullback (u₁ ij.1 ≫ P₁.hom) (v₂ ij.2 ≫ P₂.hom) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k (A ij.1) (B ij.2))) :=
      CategoryTheory.Limits.pullback.congrHom (hu_hom ij.1) (hv_hom ij.2) ≪≫
        AlgebraicGeometry.pullbackSpecIso k (A ij.1) (B ij.2)
    have hθ_fst : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        (θ ij).hom ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
          CategoryTheory.Limits.pullback.fst (u₁ ij.1 ≫ P₁.hom) (v₂ ij.2 ≫ P₂.hom) := by
      intro ij
      dsimp only [θ, CategoryTheory.Iso.trans_hom]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst,
        CategoryTheory.Limits.pullback.congrHom_hom, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.comp_id]
    have hθ_snd : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        (θ ij).hom ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
              B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))) =
          CategoryTheory.Limits.pullback.snd (u₁ ij.1 ≫ P₁.hom) (v₂ ij.2 ≫ P₂.hom) := by
      intro ij
      dsimp only [θ, CategoryTheory.Iso.trans_hom]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_snd,
        CategoryTheory.Limits.pullback.congrHom_hom, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.comp_id]
    let g_poly (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        MvPolynomial (Fin (N + 1)) k →+* TensorProduct k (A ij.1) (B ij.2) :=
      MvPolynomial.eval₂Hom (algebraMap k (TensorProduct k (A ij.1) (B ij.2)))
        (fun μ => (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ (e μ).1)) ⊗ₜ[k]
          (HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ (e μ).2)))
    have hg_one : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        g_poly ij (X_N (e.symm ij)) = 1 := by
      intro ij
      simp only [g_poly, X_N, MvPolynomial.eval₂Hom_X', Equiv.apply_symm_apply]
      have h1 : HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ ij.1) = 1 :=
        ((hHomLoc N₁).2 ij.1).1
      have h2 : HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ ij.2) = 1 :=
        ((hHomLoc N₂).2 ij.2).1
      rw [h1, h2, ← Algebra.TensorProduct.one_def]
    have hg_unit : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1),
        IsUnit (g_poly ij (X_N (e.symm ij))) := by
      intro ij
      rw [hg_one ij]
      exact isUnit_one
    let L_loc (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        Localization.Away (X_N (e.symm ij)) →+* TensorProduct k (A ij.1) (B ij.2) :=
      IsLocalization.Away.lift (X_N (e.symm ij)) (hg_unit ij)
    let φ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) :
        C (e.symm ij) →+* TensorProduct k (A ij.1) (B ij.2) :=
      (L_loc ij).comp (algebraMap (C (e.symm ij)) (Localization.Away (X_N (e.symm ij))))
    have hL_mk : ∀ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) (P : MvPolynomial (Fin (N + 1)) k)
        (s : Submonoid.powers (X_N (e.symm ij))),
        L_loc ij (Localization.mk P s) = g_poly ij P := by
      intro ij P s
      obtain ⟨n, hn⟩ := s.2
      have hgs : g_poly ij s.1 = 1 := by
        rw [← hn, map_pow, hg_one ij, one_pow]
      calc L_loc ij (Localization.mk P s)
          = L_loc ij (IsLocalization.mk' (Localization.Away (X_N (e.symm ij))) P s) := by
              rw [Localization.mk_eq_mk']
        _ = 1 * L_loc ij (IsLocalization.mk' _ P s) := (one_mul _).symm
        _ = g_poly ij s.1 * L_loc ij (IsLocalization.mk' _ P s) := by rw [hgs]
        _ = L_loc ij (algebraMap _ _ s.1) * L_loc ij (IsLocalization.mk' _ P s) := by
              rw [IsLocalization.Away.lift_eq]
        _ = L_loc ij (algebraMap _ _ s.1 * IsLocalization.mk' _ P s) := (map_mul _ _ _).symm
        _ = L_loc ij (algebraMap _ _ P) := by rw [IsLocalization.mk'_spec']
        _ = g_poly ij P := IsLocalization.Away.lift_eq _ _ _
    have hφ_alg : ∀ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) (c : k),
        φ ij (algebraMap k (C (e.symm ij)) c) =
          algebraMap k (TensorProduct k (A ij.1) (B ij.2)) c := by
      intro ij c
      change L_loc ij (HomogeneousLocalization.val (algebraMap k (C (e.symm ij)) c)) = _
      have hval : HomogeneousLocalization.val (algebraMap k (C (e.symm ij)) c) =
          Localization.mk (MvPolynomial.C c) 1 := rfl
      rw [hval, hL_mk, MvPolynomial.eval₂Hom_C]
    have hφ_ratio : ∀ (ij : Fin (N₁ + 1) × Fin (N₂ + 1)) (μ : Fin (N + 1)),
        φ ij (HomogeneousLocalization.Away.isLocalizationElem (hX_N (e.symm ij)) (hX_N μ)) =
          (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ (e μ).1)) ⊗ₜ[k]
            (HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ (e μ).2)) := by
      intro ij μ
      change L_loc ij (HomogeneousLocalization.val
        (HomogeneousLocalization.Away.isLocalizationElem (hX_N (e.symm ij)) (hX_N μ))) = _
      have hval : HomogeneousLocalization.val
          (HomogeneousLocalization.Away.isLocalizationElem (hX_N (e.symm ij)) (hX_N μ)) =
          Localization.mk (X_N μ) ⟨X_N (e.symm ij), Submonoid.mem_powers _⟩ := by
        simp [HomogeneousLocalization.Away.isLocalizationElem]
      rw [hval, hL_mk]
      simp only [g_poly, X_N, MvPolynomial.eval₂Hom_X']
    have hφ_surj : ∀ ij : Fin (N₁ + 1) × Fin (N₂ + 1), Function.Surjective (φ ij) := by
      intro ij
      let R_rng := (φ ij).range
      have h_left : ∀ w : A ij.1, Algebra.TensorProduct.includeLeftRingHom w ∈ R_rng := by
        let S_L : Subring (A ij.1) := R_rng.comap Algebra.TensorProduct.includeLeftRingHom
        suffices htop : (⊤ : Subring (A ij.1)) ≤ S_L from fun w => htop (Subring.mem_top w)
        rw [← ((hHomLoc N₁).2 ij.1).2, Subring.closure_le]
        rintro _ (⟨c, rfl⟩ | ⟨a, rfl⟩)
        · change Algebra.TensorProduct.includeLeftRingHom (algebraMap k (A ij.1) c) ∈ R_rng
          have h_inc : Algebra.TensorProduct.includeLeftRingHom (algebraMap k (A ij.1) c) =
              algebraMap k (TensorProduct k (A ij.1) (B ij.2)) c :=
            (Algebra.TensorProduct.includeLeft : A ij.1 →ₐ[k]
              TensorProduct k (A ij.1) (B ij.2)).commutes c
          rw [h_inc]
          exact ⟨algebraMap k _ c, hφ_alg ij c⟩
        · refine ⟨HomogeneousLocalization.Away.isLocalizationElem
            (hX_N (e.symm ij)) (hX_N (e.symm (a, ij.2))), ?_⟩
          rw [hφ_ratio]
          simp only [Equiv.apply_symm_apply]
          have h2 : HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ ij.2) = 1 :=
            ((hHomLoc N₂).2 ij.2).1
          rw [h2]
          rfl
      have h_right : ∀ z : B ij.2, Algebra.TensorProduct.includeRight z ∈ R_rng := by
        let S_R : Subring (B ij.2) := R_rng.comap
          (Algebra.TensorProduct.includeRight : B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))
        suffices htop : (⊤ : Subring (B ij.2)) ≤ S_R from fun z => htop (Subring.mem_top z)
        rw [← ((hHomLoc N₂).2 ij.2).2, Subring.closure_le]
        rintro _ (⟨c, rfl⟩ | ⟨b, rfl⟩)
        · change Algebra.TensorProduct.includeRight (algebraMap k (B ij.2) c) ∈ R_rng
          rw [Algebra.TensorProduct.includeRight.commutes c]
          exact ⟨algebraMap k _ c, hφ_alg ij c⟩
        · refine ⟨HomogeneousLocalization.Away.isLocalizationElem
            (hX_N (e.symm ij)) (hX_N (e.symm (ij.1, b))), ?_⟩
          rw [hφ_ratio]
          simp only [Equiv.apply_symm_apply]
          have h1 : HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ ij.1) = 1 :=
            ((hHomLoc N₁).2 ij.1).1
          rw [h1]
          rfl
      intro t
      refine TensorProduct.inductionOn (motive := fun t => t ∈ R_rng) t
        ?_ (fun _ _ hx hy => R_rng.add_mem hx hy)
      intro w z
      have hmul : w ⊗ₜ[k] z =
          Algebra.TensorProduct.includeLeftRingHom w * Algebra.TensorProduct.includeRight z := by
        simp [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.tmul_mul_tmul]
      rw [hmul]
      exact R_rng.mul_mem (h_left w) (h_right z)
    have h_away_mul : ∀ {M : ℕ} (i i' a : Fin (M + 1)),
        let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
        let hX_M : ∀ b : Fin (M + 1), MvPolynomial.X b ∈ 𝒜_M 1 := MvPolynomial.isHomogeneous_X k
        HomogeneousLocalization.awayMap 𝒜_M (hX_M i') rfl
            (HomogeneousLocalization.Away.isLocalizationElem (hX_M i) (hX_M a)) *
          HomogeneousLocalization.awayMap 𝒜_M (hX_M i) (mul_comm _ _)
            (HomogeneousLocalization.Away.isLocalizationElem (hX_M i') (hX_M i)) =
          HomogeneousLocalization.awayMap 𝒜_M (hX_M i) (mul_comm _ _)
            (HomogeneousLocalization.Away.isLocalizationElem (hX_M i') (hX_M a)) := by
      intro M i i' a 𝒜_M hX_M
      rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_mul]
      simp only [HomogeneousLocalization.Away.isLocalizationElem,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk, pow_one]
      rw [Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, Submonoid.coe_mul, one_mul]
      ring
    have h𝒰₁₂_fst : ∀ ij : 𝒰₁₂.I₀,
        𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom =
          CategoryTheory.Limits.pullback.fst (u₁ ij.1 ≫ P₁.hom) (v₂ ij.2 ≫ P₂.hom) ≫ u₁ ij.1 := by
      intro ij
      erw [AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f,
        CategoryTheory.Limits.pullback.lift_fst]
      rfl
    have h𝒰₁₂_snd : ∀ ij : 𝒰₁₂.I₀,
        𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom =
          CategoryTheory.Limits.pullback.snd (u₁ ij.1 ≫ P₁.hom) (v₂ ij.2 ≫ P₂.hom) ≫ v₂ ij.2 := by
      intro ij
      erw [AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f,
        CategoryTheory.Limits.pullback.lift_snd]
      rfl
    let σ_loc (ij : 𝒰₁₂.I₀) : 𝒰₁₂.X ij ⟶ P_N.left :=
      (θ ij).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij)) ≫ w_N (e.symm ij)
    have h_glue : ∀ (ij i'j' : 𝒰₁₂.I₀),
        CategoryTheory.Limits.pullback.fst (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ≫ σ_loc ij =
          CategoryTheory.Limits.pullback.snd (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ≫ σ_loc i'j' := by
      intro ij i'j'
      let i : Fin (N₁ + 1) := ij.1; let j : Fin (N₂ + 1) := ij.2
      let i' : Fin (N₁ + 1) := i'j'.1; let j' : Fin (N₂ + 1) := i'j'.2
      let ν : Fin (N + 1) := e.symm ij; let ν' : Fin (N + 1) := e.symm i'j'
      let A₂ := HomogeneousLocalization.Away 𝒜₁ (X₁ i * X₁ i')
      let B₂ := HomogeneousLocalization.Away 𝒜₂ (X₂ j * X₂ j')
      let C₂ := HomogeneousLocalization.Away 𝒜_N (X_N ν * X_N ν')
      let awayL₁ : A i →ₐ[k] A₂ :=
        { toRingHom := HomogeneousLocalization.awayMap 𝒜₁ (hX₁ i') rfl
          commutes' := fun c => HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜₁ (hX₁ i') rfl
            (algebraMap k ↥(𝒜₁ 0) c) }
      let awayR₁ : A i' →ₐ[k] A₂ :=
        { toRingHom := HomogeneousLocalization.awayMap 𝒜₁ (hX₁ i) (mul_comm _ _)
          commutes' := fun c => HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜₁ (hX₁ i)
            (mul_comm _ _) (algebraMap k ↥(𝒜₁ 0) c) }
      let awayL₂ : B j →ₐ[k] B₂ :=
        { toRingHom := HomogeneousLocalization.awayMap 𝒜₂ (hX₂ j') rfl
          commutes' := fun c => HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜₂ (hX₂ j') rfl
            (algebraMap k ↥(𝒜₂ 0) c) }
      let awayR₂ : B j' →ₐ[k] B₂ :=
        { toRingHom := HomogeneousLocalization.awayMap 𝒜₂ (hX₂ j) (mul_comm _ _)
          commutes' := fun c => HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜₂ (hX₂ j)
            (mul_comm _ _) (algebraMap k ↥(𝒜₂ 0) c) }
      let awayL_N : C ν →+* C₂ := HomogeneousLocalization.awayMap 𝒜_N (hX_N ν') rfl
      let awayR_N : C ν' →+* C₂ := HomogeneousLocalization.awayMap 𝒜_N (hX_N ν) (mul_comm _ _)
      let τ_L : TensorProduct k (A i) (B j) →+* TensorProduct k A₂ B₂ :=
        (Algebra.TensorProduct.map awayL₁ awayL₂).toRingHom
      let τ_R : TensorProduct k (A i') (B j') →+* TensorProduct k A₂ B₂ :=
        (Algebra.TensorProduct.map awayR₁ awayR₂).toRingHom
      let G : MvPolynomial (Fin (N + 1)) k →+* TensorProduct k A₂ B₂ := τ_L.comp (g_poly ij)
      have hG_ν : G (X_N ν) = 1 := by
        dsimp only [G, ν, RingHom.comp_apply]
        rw [hg_one ij, map_one]
      let u := G (X_N ν')
      let u_inv : TensorProduct k A₂ B₂ :=
        awayR₁ (HomogeneousLocalization.Away.isLocalizationElem (hX₁ i') (hX₁ i)) ⊗ₜ[k]
          awayR₂ (HomogeneousLocalization.Away.isLocalizationElem (hX₂ j') (hX₂ j))
      have hu_mul : u * u_inv = 1 := by
        have he_ν' : e ν' = (i', j') := e.apply_symm_apply i'j'
        have hu_eq : u =
            awayL₁ (HomogeneousLocalization.Away.isLocalizationElem (hX₁ i) (hX₁ i')) ⊗ₜ[k]
              awayL₂ (HomogeneousLocalization.Away.isLocalizationElem (hX₂ j) (hX₂ j')) := by
          dsimp only [u, G, τ_L, g_poly, X_N]
          rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', he_ν']
          rfl
        rw [hu_eq, Algebra.TensorProduct.tmul_mul_tmul]
        have hA : awayL₁ (HomogeneousLocalization.Away.isLocalizationElem (hX₁ i) (hX₁ i')) *
            awayR₁ (HomogeneousLocalization.Away.isLocalizationElem (hX₁ i') (hX₁ i)) = 1 := by
          change HomogeneousLocalization.awayMap 𝒜₁ (hX₁ i') rfl _ *
            HomogeneousLocalization.awayMap 𝒜₁ (hX₁ i) (mul_comm _ _) _ = 1
          rw [h_away_mul i i' i', ((hHomLoc N₁).2 i').1, map_one]
        have hB : awayL₂ (HomogeneousLocalization.Away.isLocalizationElem (hX₂ j) (hX₂ j')) *
            awayR₂ (HomogeneousLocalization.Away.isLocalizationElem (hX₂ j') (hX₂ j)) = 1 := by
          change HomogeneousLocalization.awayMap 𝒜₂ (hX₂ j') rfl _ *
            HomogeneousLocalization.awayMap 𝒜₂ (hX₂ j) (mul_comm _ _) _ = 1
          rw [h_away_mul j j' j', ((hHomLoc N₂).2 j').1, map_one]
        rw [hA, hB, ← Algebra.TensorProduct.one_def]
      have hG_prod : G (X_N ν * X_N ν') = u := by
        rw [map_mul, hG_ν, one_mul]
      have hG_unit : IsUnit (G (X_N ν * X_N ν')) := by
        rw [hG_prod]
        exact isUnit_iff_exists_inv.mpr ⟨u_inv, hu_mul⟩
      let L₂ : Localization.Away (X_N ν * X_N ν') →+*
          TensorProduct k A₂ B₂ :=
