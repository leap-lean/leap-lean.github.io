    have hLocLift : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
        (hW_ne : Nonempty ↥W) (φ_W : E_sm.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F)
        (hSpecW : AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec = η_F)
        (p : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W))),
        ∃ θ : Localization.AtPrime p.asIdeal →+* F,
          Function.Injective θ ∧
          (∀ r : ↑(E_sm.presheaf.obj (Opposite.op W)),
            θ (algebraMap _ (Localization.AtPrime p.asIdeal) r) = φ_W.hom r) ∧
          (∀ f : F, f ∈ θ.range ↔
            ∃ a s : ↑(E_sm.presheaf.obj (Opposite.op W)),
              s ∉ p.asIdeal ∧ φ_W.hom s * f = φ_W.hom a) := by
      intro W hW hW_ne φ_W hSpecW p
      have hPropsW := hAffChartProps W hW hW_ne
      letI : IsDomain ↑(E_sm.presheaf.obj (Opposite.op W)) := hPropsW.1
      have hinjW : Function.Injective φ_W.hom := (hPropsW.2.2.2 φ_W hSpecW).2.1
      have hUnit : ∀ s : p.asIdeal.primeCompl, IsUnit (φ_W.hom s.1) := by
        intro s
        have hs_ne : (s : ↑(E_sm.presheaf.obj (Opposite.op W))) ≠ 0 :=
          fun h0 => s.2 (h0 ▸ p.asIdeal.zero_mem)
        exact Ne.isUnit fun h => hs_ne (hinjW (h.trans (map_zero _).symm))
      let θ : Localization.AtPrime p.asIdeal →+* F :=
        IsLocalization.lift (M := p.asIdeal.primeCompl) (S := Localization.AtPrime p.asIdeal) hUnit
      have hθ_alg : ∀ r : ↑(E_sm.presheaf.obj (Opposite.op W)),
          θ (algebraMap _ (Localization.AtPrime p.asIdeal) r) = φ_W.hom r :=
        IsLocalization.lift_eq hUnit
      have hθ_inj : Function.Injective θ := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro z hz
        rw [Ideal.mem_bot]
        obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj p.asIdeal.primeCompl z
        have hφa : φ_W.hom a = 0 := by
          have := congrArg θ hzs
          rw [map_mul, (hz : θ z = 0), zero_mul, hθ_alg] at this
          exact this.symm
        have ha0 : a = 0 := hinjW (hφa.trans (map_zero _).symm)
        rw [ha0, map_zero] at hzs
        have hs_unit : IsUnit (algebraMap _ (Localization.AtPrime p.asIdeal) s.1) :=
          IsLocalization.map_units (Localization.AtPrime p.asIdeal) s
        exact (hs_unit.mul_left_eq_zero).mp hzs
      have hθ_range : ∀ f : F, f ∈ θ.range ↔
          ∃ a s : ↑(E_sm.presheaf.obj (Opposite.op W)),
            s ∉ p.asIdeal ∧ φ_W.hom s * f = φ_W.hom a := by
        intro f
        constructor
        · rintro ⟨z, rfl⟩
          obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj p.asIdeal.primeCompl z
          refine ⟨a, s.1, s.2, ?_⟩
          have := congrArg θ hzs
          rw [map_mul, hθ_alg, hθ_alg, mul_comm] at this
          exact this
        · rintro ⟨a, s, hs, hsf⟩
          let s_sub : p.asIdeal.primeCompl := ⟨s, hs⟩
          refine ⟨IsLocalization.mk' (Localization.AtPrime p.asIdeal) a s_sub, ?_⟩
          have hφs_ne : φ_W.hom s ≠ 0 :=
            fun h0 => hs ((hinjW (h0.trans (map_zero _).symm)) ▸ p.asIdeal.zero_mem)
          apply mul_left_cancel₀ hφs_ne
          change φ_W.hom s_sub.1 * _ = _
          rw [hsf, ← hθ_alg s_sub.1, ← map_mul, mul_comm, IsLocalization.mk'_spec, hθ_alg]
      exact ⟨θ, hθ_inj, hθ_alg, hθ_range⟩
    have hSubringEq : ∀ (W₁ W₂ : E_sm.Opens)
        (hW₁ : AlgebraicGeometry.IsAffineOpen W₁) (hW₂ : AlgebraicGeometry.IsAffineOpen W₂)
        (hNe₁ : Nonempty ↥W₁) (hNe₂ : Nonempty ↥W₂)
        (φ₁ : E_sm.presheaf.obj (Opposite.op W₁) ⟶ CommRingCat.of F)
        (φ₂ : E_sm.presheaf.obj (Opposite.op W₂) ⟶ CommRingCat.of F)
        (hSpec₁ : AlgebraicGeometry.Spec.map φ₁ ≫ hW₁.fromSpec = η_F)
        (hSpec₂ : AlgebraicGeometry.Spec.map φ₂ ≫ hW₂.fromSpec = η_F)
        (p₁ : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W₁)))
        (p₂ : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W₂))),
        hW₁.fromSpec.base p₁ = hW₂.fromSpec.base p₂ →
        ∀ f : F,
          (∃ a s : ↑(E_sm.presheaf.obj (Opposite.op W₁)),
            s ∉ p₁.asIdeal ∧ φ₁.hom s * f = φ₁.hom a) ↔
          (∃ a s : ↑(E_sm.presheaf.obj (Opposite.op W₂)),
            s ∉ p₂.asIdeal ∧ φ₂.hom s * f = φ₂.hom a) := by
      have hHalf : ∀ (W₁ W₂ : E_sm.Opens)
          (hW₁ : AlgebraicGeometry.IsAffineOpen W₁) (hW₂ : AlgebraicGeometry.IsAffineOpen W₂)
          (hNe₁ : Nonempty ↥W₁) (hNe₂ : Nonempty ↥W₂)
          (φ₁ : E_sm.presheaf.obj (Opposite.op W₁) ⟶ CommRingCat.of F)
          (φ₂ : E_sm.presheaf.obj (Opposite.op W₂) ⟶ CommRingCat.of F)
          (hSpec₁ : AlgebraicGeometry.Spec.map φ₁ ≫ hW₁.fromSpec = η_F)
          (hSpec₂ : AlgebraicGeometry.Spec.map φ₂ ≫ hW₂.fromSpec = η_F)
          (p₁ : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W₁)))
          (p₂ : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W₂))),
          hW₁.fromSpec.base p₁ = hW₂.fromSpec.base p₂ →
          ∀ f : F,
            (∃ a s : ↑(E_sm.presheaf.obj (Opposite.op W₁)),
              s ∉ p₁.asIdeal ∧ φ₁.hom s * f = φ₁.hom a) →
            (∃ a s : ↑(E_sm.presheaf.obj (Opposite.op W₂)),
              s ∉ p₂.asIdeal ∧ φ₂.hom s * f = φ₂.hom a) := by
        intro W₁ W₂ hW₁ hW₂ _ _ φ₁ φ₂ hSpec₁ hSpec₂ p₁ p₂ hp_eq f ⟨a₁, s₁, hs₁, hsf₁⟩
        let P := hW₁.fromSpec.base p₁
        have hP_W₁ : P ∈ W₁ := by
          change P ∈ (W₁ : Set E_sm)
          rw [← hW₁.range_fromSpec]
          exact ⟨p₁, rfl⟩
        have hP_W₂ : P ∈ W₂ := by
          change hW₁.fromSpec.base p₁ ∈ (W₂ : Set E_sm)
          rw [hp_eq, ← hW₂.range_fromSpec]
          exact ⟨p₂, rfl⟩
        obtain ⟨g₂, hB_le₁, hP_B⟩ := hW₂.exists_basicOpen_le ⟨P, hP_W₁⟩ hP_W₂
        let B₂ := E_sm.basicOpen g₂
        have hB_le₂ : B₂ ≤ W₂ := E_sm.basicOpen_le g₂
        have hAffB : AlgebraicGeometry.IsAffineOpen B₂ := hW₂.basicOpen g₂
        have hNeB : Nonempty ↥B₂ := ⟨⟨P, hP_B⟩⟩
        obtain ⟨φ_B, _, hSpecB⟩ := hFunc B₂ hAffB hNeB
        have hP_rangeB : P ∈ Set.range hAffB.fromSpec.base := by
          rw [hAffB.range_fromSpec]
          exact hP_B
        obtain ⟨q_B_pt, hq_B⟩ := hP_rangeB
        let q_B : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op B₂)) := q_B_pt
        let ρ₁ := E_sm.presheaf.map (CategoryTheory.homOfLE hB_le₁).op
        let ρ₂ := E_sm.presheaf.map (CategoryTheory.homOfLE hB_le₂).op
        have hmap₁ : AlgebraicGeometry.Spec.map ρ₁ ≫ hW₁.fromSpec = hAffB.fromSpec :=
          hW₁.map_fromSpec hAffB (CategoryTheory.homOfLE hB_le₁).op
        have hmap₂ : AlgebraicGeometry.Spec.map ρ₂ ≫ hW₂.fromSpec = hAffB.fromSpec :=
          hW₂.map_fromSpec hAffB (CategoryTheory.homOfLE hB_le₂).op
        have hφ₁_eq : ρ₁ ≫ φ_B = φ₁ := by
          apply AlgebraicGeometry.Spec.map_injective
          apply (CategoryTheory.cancel_mono hW₁.fromSpec).mp
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hmap₁, hSpecB, hSpec₁]
        have hφ₂_eq : ρ₂ ≫ φ_B = φ₂ := by
          apply AlgebraicGeometry.Spec.map_injective
          apply (CategoryTheory.cancel_mono hW₂.fromSpec).mp
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hmap₂, hSpecB, hSpec₂]
        have hq_to_p₁ : (AlgebraicGeometry.Spec.map ρ₁).base q_B = p₁ :=
          hW₁.fromSpec.isOpenEmbedding.injective ((congrArg (fun h => h.base q_B) hmap₁).trans hq_B)
        have hq_to_p₂ : (AlgebraicGeometry.Spec.map ρ₂).base q_B = p₂ :=
          hW₂.fromSpec.isOpenEmbedding.injective
            ((congrArg (fun h => h.base q_B) hmap₂).trans (hq_B.trans hp_eq))
        have hcomap₁ : q_B.asIdeal.comap ρ₁.hom = p₁.asIdeal :=
          congrArg PrimeSpectrum.asIdeal hq_to_p₁
        have hcomap₂ : q_B.asIdeal.comap ρ₂.hom = p₂.asIdeal :=
          congrArg PrimeSpectrum.asIdeal hq_to_p₂
        have hg₂_not_p₂ : g₂ ∉ p₂.asIdeal := by
          have hpre := hW₂.fromSpec_preimage_basicOpen g₂
          have hp₂_mem : p₂ ∈ (TopologicalSpace.Opens.map hW₂.fromSpec.base).obj B₂ := by
            change hW₂.fromSpec.base p₂ ∈ B₂
            rwa [← hp_eq]
          rw [hpre] at hp₂_mem
          exact hp₂_mem
        letI alg₂B : Algebra ↑(E_sm.presheaf.obj (Opposite.op W₂))
            ↑(E_sm.presheaf.obj (Opposite.op B₂)) := ρ₂.hom.toAlgebra
        have hLocAway : IsLocalization.Away g₂ ↑(E_sm.presheaf.obj (Opposite.op B₂)) :=
          hW₂.isLocalization_basicOpen g₂
        obtain ⟨m, u₂, hu₂_eq⟩ := IsLocalization.Away.surj g₂ (ρ₁.hom s₁)
        obtain ⟨n, v₂, hv₂_eq⟩ := IsLocalization.Away.surj g₂ (ρ₁.hom a₁)
        have hu₂_not_p₂ : u₂ ∉ p₂.asIdeal := by
          rw [← hcomap₂, Ideal.mem_comap]
          change algebraMap ↑(E_sm.presheaf.obj (Opposite.op W₂))
            ↑(E_sm.presheaf.obj (Opposite.op B₂)) u₂ ∉ q_B.asIdeal
          rw [← hu₂_eq]
          refine q_B.isPrime.mul_notMem ?_ ?_
          · rw [← Ideal.mem_comap, hcomap₁]
            exact hs₁
          · rw [← map_pow (algebraMap _ _)]
            change ρ₂.hom (g₂ ^ m) ∉ q_B.asIdeal
            rw [← Ideal.mem_comap, hcomap₂]
            exact fun hpow => hg₂_not_p₂ (p₂.isPrime.mem_of_pow_mem m hpow)
        refine ⟨v₂ * g₂ ^ m, u₂ * g₂ ^ n, ?_, ?_⟩
        · exact p₂.isPrime.mul_notMem hu₂_not_p₂
            (fun hpow => hg₂_not_p₂ (p₂.isPrime.mem_of_pow_mem n hpow))
        · have hρ₁_φ : ∀ x, φ_B.hom (ρ₁.hom x) = φ₁.hom x :=
            fun x => congrArg (fun k => CommRingCat.Hom.hom k x) hφ₁_eq
          have hρ₂_φ : ∀ x, φ_B.hom (ρ₂.hom x) = φ₂.hom x :=
            fun x => congrArg (fun k => CommRingCat.Hom.hom k x) hφ₂_eq
          calc φ₂.hom (u₂ * g₂ ^ n) * f
              = φ_B.hom (ρ₂.hom u₂ * ρ₂.hom g₂ ^ n) * f := by
                rw [← hρ₂_φ, map_mul, map_pow]
            _ = φ_B.hom (ρ₁.hom s₁ * ρ₂.hom g₂ ^ m * ρ₂.hom g₂ ^ n) * f := by
                change φ_B.hom (algebraMap _ _ u₂ * algebraMap _ _ g₂ ^ n) * f = _
                rw [← hu₂_eq]; rfl
            _ = (φ₁.hom s₁ * f) * (φ_B.hom (ρ₂.hom g₂ ^ m) * φ_B.hom (ρ₂.hom g₂ ^ n)) := by
                rw [map_mul, map_mul, hρ₁_φ]; ring
            _ = φ_B.hom (ρ₁.hom a₁ * ρ₂.hom g₂ ^ n * ρ₂.hom g₂ ^ m) := by
                rw [hsf₁, ← hρ₁_φ a₁, map_mul, map_mul]; ring
            _ = φ_B.hom (ρ₂.hom v₂ * ρ₂.hom g₂ ^ m) := by
                change _ = φ_B.hom (algebraMap _ _ v₂ * algebraMap _ _ g₂ ^ m)
                rw [← hv₂_eq]; rfl
            _ = φ₂.hom (v₂ * g₂ ^ m) := by rw [← map_pow, ← map_mul, hρ₂_φ]
      intro W₁ W₂ hW₁ hW₂ hNe₁ hNe₂ φ₁ φ₂ hSpec₁ hSpec₂ p₁ p₂ hp_eq f
      exact ⟨hHalf W₁ W₂ hW₁ hW₂ hNe₁ hNe₂ φ₁ φ₂ hSpec₁ hSpec₂ p₁ p₂ hp_eq f,
        hHalf W₂ W₁ hW₂ hW₁ hNe₂ hNe₁ φ₂ φ₁ hSpec₂ hSpec₁ p₂ p₁ hp_eq.symm f⟩
    have hbot_prime : ∀ (A : Type u) [CommRing A] [IsDomain A], (⊥ : Ideal A).IsPrime :=
      fun A _ _ => ⟨bot_ne_top, fun {a b} hab => by
        simpa only [Ideal.mem_bot] using mul_eq_zero.mp (Ideal.mem_bot.mp hab)⟩
    have hDVR_not_field : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A],
        ¬IsField A := by
      intro A _ _ _ hFA
      obtain ⟨x, hx_m, hx_ne⟩ :=
        Submodule.exists_mem_ne_zero_of_ne_bot (IsDiscreteValuationRing.not_a_field A)
      obtain ⟨y, hy⟩ := hFA.mul_inv_cancel hx_ne
      exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨y, hy⟩)) hx_m
    have hPrimeChar : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
        (hW_ne : Nonempty ↥W) (p : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W))),
        letI : IsDomain ↑(E_sm.presheaf.obj (Opposite.op W)) :=
          (hAffChartProps W hW hW_ne).1
        letI : IsDomain (Localization.AtPrime p.asIdeal) :=
          IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p.asIdeal)
        (IsClosed ({hW.fromSpec.base p} : Set E_sm) ↔ p.asIdeal ≠ ⊥) ∧
        (p.asIdeal ≠ ⊥ →
          p.asIdeal.IsMaximal ∧
          IsDiscreteValuationRing (Localization.AtPrime p.asIdeal)) := by
      have hDVR_of_ne_bot : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
          (hW_ne : Nonempty ↥W) (p : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W))),
