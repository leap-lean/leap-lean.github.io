      have hjS_eq : j_S a ≫ p_S =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_S
              (Submonoid.powers (f_gr (MvPolynomial.X a)))).comp (algebraMap S ↥(𝒜_S 0)))) := by
        dsimp only [j_S, p_S, weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
