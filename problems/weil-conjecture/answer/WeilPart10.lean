          rw [hψ_smul_s a', LinearMap.smul_apply, smul_eq_mul, hψ'_vec_s a' (Pi.single r₀ u_inv),
            Finset.sum_eq_single r₀]
          · simp only [Pi.single_eq_same]
            calc fst_V (t_mark a) * (u_inv * (-1) ^ (r₀ : ℕ) *
                  Matrix.det (J'.submatrix r₀.succAbove id))
                = fst_V (t_mark a) * (u_inv * ((-1 : B') ^ (r₀ : ℕ) *
                    Matrix.det (J'.submatrix r₀.succAbove id))) := by ring
              _ = fst_V (t_mark a) * 1 := by rw [hu_inv]
              _ = fst_V (t_mark a) := mul_one _
          · intro i _ hi
            simp only [Pi.single_eq_of_ne hi, zero_mul]
          · intro hr₀
            exact absurd (Finset.mem_univ r₀) hr₀
      rw [hSpanEq]
      exact IsLocalization.AtPrime.map_eq_maximalIdeal p.asIdeal (Localization.AtPrime p.asIdeal)
  · 
    intro a' A' _ u₀ e₁ e₂ he₁ he₂ hu₀_X hComm
    let a := eIdx a'
    let V := M.V a
    let V' := M_s.V a'
    let k := k_lci a
    let π := π_lci a
    let F := F_lci a
    let B' : Type u := ↑(C_s.presheaf.obj (Opposite.op V'))
    let fst_V : ↑(C.presheaf.obj (Opposite.op V)) →+* B' :=
      (fst.appLE V V' (le_of_eq (hV_s a'))).hom
    let φ₁ : B' →+* A' :=
      (V'.topIso.inv ≫ e₁.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom
    let R_node : Type u := MvPolynomial (Fin 2) Ω ⧸
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))
    let φ₂ : R_node →+* A' := (AlgebraicGeometry.Spec.preimage e₂).hom
    letI : Algebra Ω B' :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        snd.appLE ⊤ V' (fun _ _ => trivial)).hom).toAlgebra
    letI : Algebra Ω A' := (φ₁.comp (algebraMap Ω B')).toAlgebra
    let J' : Matrix (Fin (k + 1)) (Fin k) B' :=
      Matrix.of fun i j => fst_V (π (MvPolynomial.pderiv i (F j)))
    let q' : (Fin (k + 1) → B') →ₗ[B'] KaehlerDifferential Ω B' :=
      LinearMap.lsum B' (fun _ : Fin (k + 1) => B') B' fun r =>
        LinearMap.toSpanSingleton B' (KaehlerDifferential Ω B')
          (KaehlerDifferential.D Ω B' (fst_V (π (MvPolynomial.X r))))
    obtain ⟨_, _, _, _, _, _, hTagNone, hTagSome⟩ := hCharts a
    have hEt_φ₁ : RingHom.Etale φ₁ := (hGeom.2.2.2.2.2.1 C_s V' (hAff_s a') A' e₁ he₁).1
    obtain ⟨hEt_φ₂, hFlat_φ₂⟩ := hGeom.2.2.2.2.2.2.1 R_node A' e₂ he₂
    have hx_u₀ : ∀ i : Fin 2, φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ u₀.asIdeal := by
      intro i
      have he₂ := congrArg (fun (f : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_node)) => f.base u₀)
        (AlgebraicGeometry.Spec.map_preimage e₂)
      have hApp : (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e₂)).base u₀ =
          PrimeSpectrum.comap φ₂ u₀ :=
        AlgebraicGeometry.Spec.map_apply (AlgebraicGeometry.Spec.preimage e₂) u₀
      have hIdeal : (e₂.base u₀).asIdeal = Ideal.comap φ₂ u₀.asIdeal :=
        congrArg PrimeSpectrum.asIdeal (he₂.symm.trans hApp)
      have hMem := hu₀_X i
      rwa [hIdeal] at hMem
    have hAlg_comm : φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap Ω A' := by
      let f_lhs := e₁ ≫ V'.ι ≫ snd
      let c_node : CommRingCat.of Ω ⟶ CommRingCat.of R_node :=
        CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
      have hPreEq : AlgebraicGeometry.Spec.preimage f_lhs =
          c_node ≫ AlgebraicGeometry.Spec.preimage e₂ := by
        have hComm' : f_lhs = e₂ ≫ AlgebraicGeometry.Spec.map c_node := hComm
        rw [hComm', AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
      have hNat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (AlgebraicGeometry.Spec.preimage f_lhs)
      rw [AlgebraicGeometry.Spec.map_preimage] at hNat
      have hPreLhs : AlgebraicGeometry.Spec.preimage f_lhs =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            f_lhs.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom := by
        calc AlgebraicGeometry.Spec.preimage f_lhs
            = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
                  AlgebraicGeometry.Spec.preimage f_lhs) := by
                rw [CategoryTheory.Iso.inv_hom_id_assoc]
          _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                f_lhs.appTop ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom := by
                rw [← hNat]
      have hf_app : f_lhs.appTop =
          snd.appLE ⊤ V' (fun _ _ => trivial) ≫ V'.topIso.inv ≫ e₁.appTop := by
        change (e₁ ≫ V'.ι ≫ snd).appTop = _
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.Hom.comp_appTop]
        have h1 : snd.appTop ≫ V'.ι.appTop =
            snd.appLE ⊤ V' (fun _ _ => trivial) ≫ V'.topIso.inv := by
          have ha : snd.appTop = snd.appLE ⊤ ⊤ (fun _ _ => trivial) :=
            AlgebraicGeometry.Scheme.Hom.app_eq_appLE snd
          have hb : V'.ι.appTop = V'.ι.appLE ⊤ ⊤ (fun _ _ => trivial) :=
            AlgebraicGeometry.Scheme.Hom.app_eq_appLE V'.ι
          have h2 : (⊤ : V'.toScheme.Opens) ≤ (TopologicalSpace.Opens.map V'.ι.base).obj V' :=
            fun z _ => z.2
          have hc : snd.appLE ⊤ ⊤ (fun _ _ => trivial) ≫
              V'.ι.appLE ⊤ ⊤ (fun _ _ => trivial) =
              (V'.ι ≫ snd).appLE ⊤ ⊤ (fun _ _ => trivial) :=
            AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
          have hd : snd.appLE ⊤ V' (fun _ _ => trivial) ≫ V'.ι.appLE V' ⊤ h2 =
              (V'.ι ≫ snd).appLE ⊤ ⊤ (fun _ _ => trivial) :=
            AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
          have hTop : V'.ι.appLE V' ⊤ h2 = V'.topIso.inv := by
            rw [AlgebraicGeometry.Scheme.Opens.ι_appLE,
              AlgebraicGeometry.Scheme.Opens.topIso_inv]
            congr 1
          rw [ha, hb, hc, ← hd, hTop]
        rw [← CategoryTheory.Category.assoc, h1, CategoryTheory.Category.assoc]
      rw [hf_app] at hPreLhs
      exact congrArg CommRingCat.Hom.hom (hPreEq.symm.trans hPreLhs)
    let q_1A : (Fin (k + 1) → A') →ₗ[A'] KaehlerDifferential Ω A' :=
      LinearMap.lsum A' (fun _ : Fin (k + 1) => A') A' fun r =>
        LinearMap.toSpanSingleton A' (KaehlerDifferential Ω A')
          (KaehlerDifferential.D Ω A' (φ₁ (fst_V (π (MvPolynomial.X r)))))
    have hExact_1A : Function.Surjective q_1A ∧
        LinearMap.ker q_1A = LinearMap.range (J'.map φ₁).mulVecLin := by
      let _ : Algebra B' A' := φ₁.toAlgebra
      have _ : IsScalarTower Ω B' A' := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale B' A' := hEt_φ₁
      have _ : Algebra.FormallyEtale B' A' := Algebra.Etale.formallyEtale
      exact (hAlg.2.1 Ω B' Ω A' (Or.inl ⟨inferInstance, inferInstance⟩)).2 k
        (fun r => fst_V (π (MvPolynomial.X r))) J' (hSurj_s a') (hKer_s a')
    let x₀ : A' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
    let x₁ : A' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
    let J_node : Matrix (Fin 2) (Fin 1) A' :=
      Matrix.of fun (i : Fin 2) (_ : Fin 1) => Fin.cases x₁ (fun _ => x₀) i
    let q_node : (Fin 2 → A') →ₗ[A'] KaehlerDifferential Ω A' :=
      LinearMap.lsum A' (fun _ : Fin 2 => A') A' fun r =>
        LinearMap.toSpanSingleton A' (KaehlerDifferential Ω A')
          (KaehlerDifferential.D Ω A' (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X r))))
    have hNodal := hAlg.2.2.2.2.1 Ω A' φ₂ hFlat_φ₂
    have hInj_node : Function.Injective J_node.mulVecLin := hNodal.1
    obtain ⟨hSurj_node, hKer_node⟩ := hNodal.2 hAlg_comm hEt_φ₂
    obtain ⟨_, ψ₁, ψ₂, u_node, hψ₁, hψ₂, hψ_node_eq⟩ :=
      hCramer A' (KaehlerDifferential Ω A') k 1
        (J'.map φ₁) q_1A J_node q_node hExact_1A.1 hExact_1A.2
        hSurj_node hKer_node hInj_node
    have hDet_node0 : Matrix.det (J_node.submatrix (0 : Fin 2).succAbove id) = x₀ := by
      rw [Matrix.det_fin_one]
      rfl
    have hDet_node1 : Matrix.det (J_node.submatrix (1 : Fin 2).succAbove id) = x₁ := by
      rw [Matrix.det_fin_one]
      rfl
    have hψ₂_eval : ∀ w : Fin 2 → A', ψ₂ (q_node w) = w 0 * x₀ - w 1 * x₁ := by
      intro w
      rw [hψ₂ w, Fin.sum_univ_two, hDet_node0, hDet_node1]
      simp only [Fin.val_zero, pow_zero, Fin.val_one, pow_one]
      ring
    cases htg : tag a with
    | some j₀ =>
      
      obtain ⟨_, _, _, r₀, hUnit_r₀⟩ := hTagSome j₀ htg
      let J_B : Matrix (Fin (k + 1)) (Fin k) ↑(C.presheaf.obj (Opposite.op V)) :=
        Matrix.of fun i j_col => π (MvPolynomial.pderiv i (F j_col))
      have hUnit_A' : IsUnit ((-1 : A') ^ (r₀ : ℕ) *
          Matrix.det ((J'.map φ₁).submatrix r₀.succAbove id)) := by
        have hDet_eq : (φ₁.comp fst_V) (Matrix.det (J_B.submatrix r₀.succAbove id)) =
            Matrix.det ((J'.map φ₁).submatrix r₀.succAbove id) :=
          RingHom.map_det (φ₁.comp fst_V) (J_B.submatrix r₀.succAbove id)
        refine (IsUnit.pow (r₀ : ℕ) isUnit_one.neg).mul ?_
        rw [← hDet_eq]
        exact hUnit_r₀.map (φ₁.comp fst_V)
      have hψ₁_r₀ : ψ₁ (q_1A (Pi.single r₀ 1)) =
          (-1 : A') ^ (r₀ : ℕ) * Matrix.det ((J'.map φ₁).submatrix r₀.succAbove id) := by
        rw [hψ₁ (Pi.single r₀ 1), Finset.sum_eq_single r₀]
        · simp only [Pi.single_eq_same, one_mul]
        · intro i _ hi
          simp only [Pi.single_eq_of_ne hi, zero_mul]
        · intro hr₀
          exact absurd (Finset.mem_univ r₀) hr₀
      obtain ⟨w, hw⟩ := hSurj_node (q_1A (Pi.single r₀ 1))
      have hInIdeal : ψ₁ (q_1A (Pi.single r₀ 1)) ∈ u₀.asIdeal := by
        rw [← hw, hψ_node_eq, LinearMap.smul_apply, smul_eq_mul, hψ₂_eval w]
        exact u₀.asIdeal.mul_mem_left u_node.val
          (u₀.asIdeal.sub_mem (u₀.asIdeal.mul_mem_left (w 0) (hx_u₀ 0))
            (u₀.asIdeal.mul_mem_left (w 1) (hx_u₀ 1)))
      rw [hψ₁_r₀] at hInIdeal
      exact False.elim (u₀.isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem u₀.asIdeal hInIdeal hUnit_A'))
    | none =>
      have ht_one : t_mark (eIdx a') = 1 := (hTagNone htg).2
      have hψ_log_eq : ψ_log_s a' = ψ'_s a' := by
        rw [hψ_smul_s a', ht_one, map_one, one_smul]
      refine ⟨ψ₁, 1, u₀.isPrime.one_notMem, ?_, ?_⟩
      · intro b
        rw [hψ_log_eq]
        have h1 := hExtendD φ₁ rfl
          (fun r => fst_V (π (MvPolynomial.X r)))
          (hSurj_s a') (ψ'_s a') ψ₁ (1 : A') ?_ b
        · simpa only [one_mul] using h1
        · intro r
          rw [one_mul]
          have hq1_r : q_1A (Pi.single r 1) =
              KaehlerDifferential.D Ω A' (φ₁ (fst_V (π (MvPolynomial.X r)))) :=
            (hLsum_single (fun i =>
              KaehlerDifferential.D Ω A' (φ₁ (fst_V (π (MvPolynomial.X i))))) r (1 : A')).trans
              (one_smul A' _)
          have hq'_r : q' (Pi.single r 1) =
              KaehlerDifferential.D Ω B' (fst_V (π (MvPolynomial.X r))) :=
            (hLsum_single (fun i =>
              KaehlerDifferential.D Ω B' (fst_V (π (MvPolynomial.X i)))) r (1 : B')).trans
              (one_smul B' _)
          have hDet_φ₁ : φ₁ (Matrix.det (J'.submatrix r.succAbove id)) =
              Matrix.det ((J'.map φ₁).submatrix r.succAbove id) :=
            RingHom.map_det φ₁ (J'.submatrix r.succAbove id)
          rw [← hq1_r, ← hq'_r, hψ₁ (Pi.single r 1), hψ'_vec_s a' (Pi.single r 1),
            Finset.sum_eq_single r, Finset.sum_eq_single r]
          · simp only [Pi.single_eq_same, one_mul, map_mul, map_pow, map_neg, map_one]
            congr 1
            exact hDet_φ₁.symm
          · intro i _ hi
            simp only [Pi.single_eq_of_ne hi, zero_mul]
          · intro hr
            exact absurd (Finset.mem_univ r) hr
          · intro i _ hi
            simp only [Pi.single_eq_of_ne hi, zero_mul]
          · intro hr
            exact absurd (Finset.mem_univ r) hr
      · intro i
        refine Fin.cases ?_ ?_ i
        · 
          let v₀ : Fin 2 → A' := Pi.single 0 1
          have hq0 : q_node v₀ = KaehlerDifferential.D Ω A' x₀ :=
            (hLsum_single (fun s_idx =>
              KaehlerDifferential.D Ω A' (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X s_idx))))
              (0 : Fin 2) (1 : A')).trans (one_smul A' _)
          have hVal0 : ψ₁ (KaehlerDifferential.D Ω A' x₀) = u_node.val * x₀ := by
            have hp00 : v₀ 0 = 1 := by
              change (Pi.single 0 1 : Fin 2 → A') 0 = 1
              rw [Pi.single_eq_same]
            have hp01 : v₀ 1 = 0 := by
              change (Pi.single 0 1 : Fin 2 → A') 1 = 0
              rw [Pi.single_eq_of_ne (show (1 : Fin 2) ≠ 0 by decide)]
            rw [← hq0, hψ_node_eq, LinearMap.smul_apply, smul_eq_mul,
              hψ₂_eval v₀, hp00, hp01]
            ring
          refine ⟨Units.map (algebraMap A' (Localization.Away (1 : A'))).toMonoidHom u_node, ?_⟩
          change algebraMap A' (Localization.Away (1 : A')) (ψ₁ (KaehlerDifferential.D Ω A' x₀)) =
            algebraMap A' (Localization.Away (1 : A')) u_node.val *
              algebraMap A' (Localization.Away (1 : A')) x₀
          rw [hVal0, map_mul]
        · 
          intro j_sub
          have hj0 : j_sub = 0 := Subsingleton.elim _ _
          subst hj0
          let v₁ : Fin 2 → A' := Pi.single 1 1
          have hq1 : q_node v₁ = KaehlerDifferential.D Ω A' x₁ :=
            (hLsum_single (fun s_idx =>
              KaehlerDifferential.D Ω A' (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X s_idx))))
              (1 : Fin 2) (1 : A')).trans (one_smul A' _)
          have hVal1 : ψ₁ (KaehlerDifferential.D Ω A' x₁) = (-u_node).val * x₁ := by
            have hp10 : v₁ 0 = 0 := by
              change (Pi.single 1 1 : Fin 2 → A') 0 = 0
              rw [Pi.single_eq_of_ne (show (0 : Fin 2) ≠ 1 by decide)]
            have hp11 : v₁ 1 = 1 := by
              change (Pi.single 1 1 : Fin 2 → A') 1 = 1
              rw [Pi.single_eq_same]
            rw [← hq1, hψ_node_eq, LinearMap.smul_apply, smul_eq_mul,
              hψ₂_eval v₁, hp10, hp11, Units.val_neg]
            ring
          refine ⟨Units.map (algebraMap A' (Localization.Away (1 : A'))).toMonoidHom (-u_node), ?_⟩
          change algebraMap A' (Localization.Away (1 : A')) (ψ₁ (KaehlerDifferential.D Ω A' x₁)) =
            algebraMap A' (Localization.Away (1 : A')) (-u_node).val *
              algebraMap A' (Localization.Away (1 : A')) x₁
          rw [hVal1, map_mul]

theorem weil_log_canonical_atlas_gluing_and_geomFiber (S : AlgebraicGeometry.Scheme.{u})
    (hSepS : S.IsSeparated)
    (hNoethS : ∀ U : S.Opens, AlgebraicGeometry.IsAffineOpen U →
      IsNoetherianRing ↑(S.presheaf.obj (Opposite.op U)))
    (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (m : ℕ)
    (U_base : Fin m → S.Opens)
    (V_cov : Fin m → C.Opens)
    (k_lci : Fin m → ℕ)
    (π_lci : ∀ a : Fin m,
      MvPolynomial (Fin (k_lci a + 1)) ↑(S.presheaf.obj (Opposite.op (U_base a))) →+*
        ↑(C.presheaf.obj (Opposite.op (V_cov a))))
    (F_lci : ∀ a : Fin m,
      Fin (k_lci a) → MvPolynomial (Fin (k_lci a + 1)) ↑(S.presheaf.obj (Opposite.op (U_base a))))
    (tag : Fin m → Option (Fin n))
    (t_mark : ∀ a : Fin m, ↑(C.presheaf.obj (Opposite.op (V_cov a))))
    (hCov : (⋃ a : Fin m, (V_cov a : Set C)) = Set.univ)
    (hCharts : ∀ a : Fin m,
      IsLocalLogCanonicalChart g n τ (U_base a) (V_cov a) (k_lci a)
        (π_lci a) (F_lci a) (tag a) (t_mark a))
    (hPullback : ∀ (S' : AlgebraicGeometry.Scheme.{u}) (f_S : S' ⟶ S),
      ∃ τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g f_S),
        (∀ j : Fin n,
          τ' j ≫ CategoryTheory.Limits.pullback.fst g f_S = f_S ≫ τ j ∧
          τ' j ≫ CategoryTheory.Limits.pullback.snd g f_S = 𝟙 S' ∧
          Set.range (τ' j).base =
            (CategoryTheory.Limits.pullback.fst g f_S).base ⁻¹' Set.range (τ j).base) ∧
        IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g f_S) n τ')
    (hCramer : ∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k₁ k₂ : ℕ)
      (J₁ : Matrix (Fin (k₁ + 1)) (Fin k₁) B)
      (q₁ : (Fin (k₁ + 1) → B) →ₗ[B] Ω_mod)
      (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) B)
      (q₂ : (Fin (k₂ + 1) → B) →ₗ[B] Ω_mod),
      Function.Surjective q₁ →
      LinearMap.ker q₁ = LinearMap.range J₁.mulVecLin →
      Function.Surjective q₂ →
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin →
      Function.Injective J₂.mulVecLin →
      Function.Injective J₁.mulVecLin ∧
      ∃ (ψ₁ ψ₂ : Ω_mod →ₗ[B] B) (u : Bˣ),
        (∀ v : Fin (k₁ + 1) → B,
          ψ₁ (q₁ v) = ∑ r : Fin (k₁ + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id)) ∧
        (∀ w : Fin (k₂ + 1) → B,
          ψ₂ (q₂ w) = ∑ s : Fin (k₂ + 1),
            w s * (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) ∧
        ψ₁ = u.val • ψ₂)
    (hZeroAnn : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A]
      [CommRing B] [Algebra A B] [Module.Flat A B] (S_gen : Set B),
      (∀ (p : PrimeSpectrum A),
        let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
        letI : Algebra A Ω :=
          ((algebraMap p.asIdeal.ResidueField Ω).comp
            (algebraMap A p.asIdeal.ResidueField)).toAlgebra
        ∀ z : TensorProduct A B Ω,
          (∀ b ∈ S_gen, TensorProduct.tmul A b (1 : Ω) * z = 0) → z = 0) →
      ∀ z : B, (∀ b ∈ S_gen, b * z = 0) → z = 0) :
    ∃ M : WeilLineBundle C,
      IsRelativeLogCanonicalAtlas g n τ M ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
        (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
        WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
        ∃ τ_s : Fin n →
            (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g s),
          IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g s) n τ_s ∧
          IsGeometricFiberLogCanonical (CategoryTheory.Limits.pullback.snd g s) n τ_s M_s :=
by
  have hAlg : HasWeilLciKaehlerAndNodalAlgebra.{u} :=
    weil_lci_kaehler_presentation_and_nodal_injectivity.{u}
  have hGeom : HasWeilSeparatedAffineAndFiberPushout.{u} :=
    weil_separated_affine_inter_and_fiber_pushout.{u}
  obtain ⟨M, hAtlas⟩ :=
    weil_log_canonical_atlas_gluing_from_local_charts S hSepS hNoethS C g n τ hStab
      m U_base V_cov k_lci π_lci F_lci tag t_mark hCov hCharts hPullback hCramer hZeroAnn
      hAlg hGeom
  exact ⟨M, hAtlas,
    weil_geomFiber_log_canonical_of_relative_atlas S hSepS C g n τ hStab M hAtlas
      hPullback hCramer hAlg hGeom⟩

theorem weil_mvPolynomial_quotient_kaehler_exact_and_etale_transport (R₀ : Type u) :
    HasWeilIsoKaehlerTransport R₀ :=
by
  have h_vec_sum : ∀ {R : Type u} [CommRing R] {m : ℕ} (v : Fin m → R),
      (∑ r : Fin m, v r • Pi.single r (1 : R)) = v := by
    intro R _ m v
    ext i
    rw [Finset.sum_apply, Finset.sum_eq_single i]
    · simp
    · intro r _ hri
      simp [Pi.single_apply, hri, Ne.symm hri]
    · intro hi
      exact (hi (Finset.mem_univ i)).elim
  have h_mulVec_sum : ∀ {R : Type u} [CommRing R] {m n : ℕ}
      (J : Matrix (Fin m) (Fin n) R) (w : Fin n → R),
      J.mulVecLin w = ∑ j : Fin n, w j • (fun r : Fin m => J r j) := by
    intro R _ m n J w
    ext r
    rw [Finset.sum_apply]
    change (∑ j : Fin n, J r j * w j) = ∑ j : Fin n, (w j • fun i : Fin m => J i j) r
    exact Finset.sum_congr rfl fun j _ => mul_comm (J r j) (w j)
  have h_mulVec_col : ∀ {R : Type u} [CommRing R] {m n : ℕ}
      (J : Matrix (Fin m) (Fin n) R) (j : Fin n),
      (fun r : Fin m => J r j) = J.mulVecLin (Pi.single j 1) := by
    intro R _ m n J j
    ext r
    change J r j = ∑ c : Fin n, J r c * (Pi.single j (1 : R) : Fin n → R) c
    rw [Finset.sum_eq_single j]
    · simp
    · intro c _ hcj
      simp [Pi.single_apply, hcj, Ne.symm hcj]
    · intro hj
      exact (hj (Finset.mem_univ j)).elim
  have hTrans : ∀ (S T M N : Type u) [CommRing S] [CommRing T] [Algebra S T]
      [AddCommGroup M] [Module S M] [AddCommGroup N] [Module T N]
      (e : TensorProduct S T M ≃ₗ[T] N),
      (∀ (k : ℕ) (m_vec : Fin (k + 1) → M) (n_vec : Fin (k + 1) → N)
          (J : Matrix (Fin (k + 1)) (Fin k) S),
        (∀ r : Fin (k + 1), e (1 ⊗ₜ[S] m_vec r) = n_vec r) →
        Function.Surjective (Fintype.linearCombination S m_vec) →
        LinearMap.ker (Fintype.linearCombination S m_vec) = LinearMap.range J.mulVecLin →
        Function.Surjective (Fintype.linearCombination T n_vec) ∧
          LinearMap.ker (Fintype.linearCombination T n_vec) =
            LinearMap.range (J.map (algebraMap S T)).mulVecLin) ∧
      (∀ (ψ : M →ₗ[S] S),
        ∃ (ψ_T : N →ₗ[T] T),
          ∀ m : M, ψ_T (e (1 ⊗ₜ[S] m)) = algebraMap S T (ψ m)) := by
    intro S T M N _ _ _ _ _ _ _ e
    refine ⟨?_, ?_⟩
    · intro k m_vec n_vec J he hSurj_S hKer_S
      let q_S : (Fin (k + 1) → S) →ₗ[S] M := Fintype.linearCombination S m_vec
      let q_T : (Fin (k + 1) → T) →ₗ[T] N := Fintype.linearCombination T n_vec
      let J_T : Matrix (Fin (k + 1)) (Fin k) T := J.map (algebraMap S T)
      have hSurj_T : Function.Surjective q_T := by
        have hRange : ∀ z : TensorProduct S T M, e z ∈ LinearMap.range q_T := by
          intro z
          induction z using TensorProduct.induction_on with
          | zero =>
            rw [map_zero]
            exact Submodule.zero_mem _
          | tmul t m =>
            obtain ⟨v, hv⟩ := hSurj_S m
            have hm : m = ∑ r : Fin (k + 1), v r • m_vec r := by
              rw [← hv, Fintype.linearCombination_apply]
            have htm : t ⊗ₜ[S] m =
                ∑ r : Fin (k + 1), (t * algebraMap S T (v r)) • (1 ⊗ₜ[S] m_vec r) := by
              rw [hm, TensorProduct.tmul_sum]
              refine Finset.sum_congr rfl fun r _ => ?_
              calc t ⊗ₜ[S] (v r • m_vec r)
                  = (v r • t) ⊗ₜ[S] m_vec r := (TensorProduct.smul_tmul (v r) t (m_vec r)).symm
                _ = ((t * algebraMap S T (v r)) • (1 : T)) ⊗ₜ[S] m_vec r := by
                      rw [Algebra.smul_def, smul_eq_mul, mul_one, mul_comm]
                _ = (t * algebraMap S T (v r)) • (1 ⊗ₜ[S] m_vec r) :=
                      (TensorProduct.smul_tmul' (t * algebraMap S T (v r)) (1 : T) (m_vec r)).symm
            refine ⟨fun r => t * algebraMap S T (v r), ?_⟩
            change q_T (fun r => t * algebraMap S T (v r)) = e (t ⊗ₜ[S] m)
            rw [htm, map_sum, Fintype.linearCombination_apply]
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [LinearEquiv.map_smul, he r]
          | add x y hx hy =>
            rw [map_add]
            exact Submodule.add_mem _ hx hy
        intro ω
        have hmem := hRange (e.symm ω)
        rwa [e.apply_symm_apply] at hmem
      refine ⟨hSurj_T, le_antisymm ?_ ?_⟩
      · let P_T : Submodule T (Fin (k + 1) → T) := LinearMap.range J_T.mulVecLin
        let Q_T := (Fin (k + 1) → T) ⧸ P_T
        let mkQ_T : (Fin (k + 1) → T) →ₗ[T] Q_T := P_T.mkQ
        let φ_ST : (Fin (k + 1) → S) →ₗ[S] (Fin (k + 1) → T) :=
          { toFun := fun v r => algebraMap S T (v r)
            map_add' := fun u v => by ext r; exact map_add (algebraMap S T) (u r) (v r)
            map_smul' := fun s v => by
              ext r
              simp [Algebra.smul_def] }
        let ι_ST : (Fin (k + 1) → S) →ₗ[S] Q_T := (mkQ_T.restrictScalars S).comp φ_ST
        have h_ker_le : LinearMap.ker q_S ≤ LinearMap.ker ι_ST := by
          intro v hv
          rw [hKer_S] at hv
          obtain ⟨u, rfl⟩ := hv
          rw [LinearMap.mem_ker]
          have hφ : φ_ST (J.mulVecLin u) = J_T.mulVecLin (fun j => algebraMap S T (u j)) := by
            ext r
            change algebraMap S T (∑ j : Fin k, J r j * u j) =
              ∑ j : Fin k, J_T r j * algebraMap S T (u j)
            rw [map_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            exact map_mul (algebraMap S T) (J r j) (u j)
          change mkQ_T (φ_ST (J.mulVecLin u)) = 0
          rw [hφ, ← LinearMap.mem_ker, Submodule.ker_mkQ]
          exact ⟨fun j => algebraMap S T (u j), rfl⟩
        let L_S : M →ₗ[S] Q_T :=
          (Submodule.liftQ (LinearMap.ker q_S) ι_ST h_ker_le).comp
            (q_S.quotKerEquivOfSurjective hSurj_S).symm.toLinearMap
        have hLS_apply : ∀ v : Fin (k + 1) → S, L_S (q_S v) = ι_ST v := by
          intro v
          change (Submodule.liftQ (LinearMap.ker q_S) ι_ST h_ker_le)
            ((q_S.quotKerEquivOfSurjective hSurj_S).symm (q_S v)) = ι_ST v
          rw [LinearMap.quotKerEquivOfSurjective_symm_apply, Submodule.liftQ_apply]
        have hLS_vec : ∀ r : Fin (k + 1), L_S (m_vec r) = mkQ_T (Pi.single r 1) := by
          intro r
          have hq : q_S (Pi.single r 1) = m_vec r := by
            change (Fintype.linearCombination S m_vec) (Pi.single r 1) = m_vec r
            rw [Fintype.linearCombination_apply_single, one_smul]
          have hφ_single : φ_ST (Pi.single r 1) = Pi.single r 1 := by
            ext i
            change algebraMap S T ((Pi.single r (1 : S) : Fin (k + 1) → S) i) =
              (Pi.single r (1 : T) : Fin (k + 1) → T) i
            by_cases hir : i = r
            · subst hir; simp
            · simp [Pi.single_apply, hir, Ne.symm hir]
          rw [← hq, hLS_apply]
          change mkQ_T (φ_ST (Pi.single r 1)) = mkQ_T (Pi.single r 1)
          rw [hφ_single]
        let L_T : N →ₗ[T] Q_T :=
          (LinearMap.liftBaseChange T L_S).comp e.symm.toLinearMap
        have hLT_vec : ∀ r : Fin (k + 1), L_T (n_vec r) = mkQ_T (Pi.single r 1) := by
          intro r
          change (LinearMap.liftBaseChange T L_S) (e.symm (n_vec r)) = mkQ_T (Pi.single r 1)
          rw [← he r, e.symm_apply_apply, LinearMap.liftBaseChange_one_tmul, hLS_vec r]
        intro w hw
        rw [LinearMap.mem_ker] at hw
        have h0 : L_T (q_T w) = 0 := by rw [hw, map_zero]
        have hexp : L_T (q_T w) = mkQ_T w := by
          change L_T ((Fintype.linearCombination T n_vec) w) = mkQ_T w
          rw [Fintype.linearCombination_apply, map_sum]
          calc ∑ r : Fin (k + 1), L_T (w r • n_vec r)
              = ∑ r : Fin (k + 1), w r • mkQ_T (Pi.single r 1) := by
                  refine Finset.sum_congr rfl fun r _ => ?_
                  rw [LinearMap.map_smul, hLT_vec r]
            _ = mkQ_T (∑ r : Fin (k + 1), w r • Pi.single r 1) := by
                  rw [map_sum]
                  exact Finset.sum_congr rfl fun r _ => (LinearMap.map_smul mkQ_T (w r) _).symm
            _ = mkQ_T w := by rw [h_vec_sum]
        rw [hexp] at h0
        change w ∈ P_T
        rwa [← Submodule.ker_mkQ P_T, LinearMap.mem_ker]
      · rintro _ ⟨w, rfl⟩
        rw [LinearMap.mem_ker]
        have hcol : ∀ j : Fin k, q_T (fun r => J_T r j) = 0 := by
          intro j
          have hj_ker : (fun r => J r j) ∈ LinearMap.ker q_S := by
            rw [hKer_S, h_mulVec_col J j]
            exact ⟨Pi.single j 1, rfl⟩
          rw [LinearMap.mem_ker] at hj_ker
          have hsum_S : ∑ r : Fin (k + 1), J r j • m_vec r = 0 := by
            rw [← Fintype.linearCombination_apply S m_vec (fun r => J r j)]
            exact hj_ker
          have htm : (1 : T) ⊗ₜ[S] (∑ r : Fin (k + 1), J r j • m_vec r) =
              ∑ r : Fin (k + 1), J_T r j • (1 ⊗ₜ[S] m_vec r) := by
            rw [TensorProduct.tmul_sum]
            refine Finset.sum_congr rfl fun r _ => ?_
            calc (1 : T) ⊗ₜ[S] (J r j • m_vec r)
                = (J r j • (1 : T)) ⊗ₜ[S] m_vec r := (TensorProduct.smul_tmul (J r j) 1 (m_vec r)).symm
              _ = (J_T r j • (1 : T)) ⊗ₜ[S] m_vec r := by
                    simp only [Algebra.smul_def, smul_eq_mul, RingHom.id_apply]
                    rfl
              _ = J_T r j • (1 ⊗ₜ[S] m_vec r) :=
                    (TensorProduct.smul_tmul' (J_T r j) (1 : T) (m_vec r)).symm
          have he0 : e ((1 : T) ⊗ₜ[S] (∑ r : Fin (k + 1), J r j • m_vec r)) = 0 := by
            rw [hsum_S, TensorProduct.tmul_zero, map_zero]
          rw [htm, map_sum] at he0
          change (Fintype.linearCombination T n_vec) (fun r => J_T r j) = 0
          rw [Fintype.linearCombination_apply]
          rw [← he0]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [LinearEquiv.map_smul, he r]
        rw [h_mulVec_sum J_T w, map_sum]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [LinearMap.map_smul, hcol j, smul_zero]
    · intro ψ
      let l₀ : M →ₗ[S] T := (Algebra.linearMap S T).comp ψ
      refine ⟨(LinearMap.liftBaseChange T l₀).comp e.symm.toLinearMap, ?_⟩
      intro m
      change (LinearMap.liftBaseChange T l₀) (e.symm (e (1 ⊗ₜ[S] m))) = algebraMap S T (ψ m)
      rw [e.symm_apply_apply, LinearMap.liftBaseChange_one_tmul]
      rfl
  refine ⟨?_, ?_, ?_⟩
  · intro A B _ _ _ k π F hC hSurj hKer
    let q_B : (Fin (k + 1) → B) →ₗ[B] KaehlerDifferential A B :=
      Fintype.linearCombination B fun r : Fin (k + 1) =>
        KaehlerDifferential.D A B (π (MvPolynomial.X r))
    let J_B : Matrix (Fin (k + 1)) (Fin k) B :=
      Matrix.of fun (i : Fin (k + 1)) (j : Fin k) => π (MvPolynomial.pderiv i (F j))
    have hC_app : ∀ a : A, π (MvPolynomial.C a) = algebraMap A B a :=
      fun a => RingHom.congr_fun hC a
    have hChain : ∀ P : MvPolynomial (Fin (k + 1)) A,
        KaehlerDifferential.D A B (π P) = q_B (fun r => π (MvPolynomial.pderiv r P)) := by
      intro P
      rw [show q_B (fun r => π (MvPolynomial.pderiv r P)) =
        ∑ r : Fin (k + 1),
          π (MvPolynomial.pderiv r P) • KaehlerDifferential.D A B (π (MvPolynomial.X r)) from
        Fintype.linearCombination_apply B _ _]
      induction P using MvPolynomial.induction_on with
      | C a =>
        rw [hC_app a, (KaehlerDifferential.D A B).map_algebraMap]
        symm
        refine Finset.sum_eq_zero fun r _ => ?_
        rw [MvPolynomial.pderiv_C, map_zero, zero_smul]
      | add P Q hP hQ =>
        rw [map_add, map_add, hP, hQ, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [map_add, map_add, add_smul]
      | mul_X P s hP =>
        rw [map_mul, (KaehlerDifferential.D A B).leibniz]
        have hRHS :
            (∑ r : Fin (k + 1),
              π (MvPolynomial.pderiv r (P * MvPolynomial.X s)) •
                KaehlerDifferential.D A B (π (MvPolynomial.X r))) =
            (∑ r : Fin (k + 1),
              (π P * π (MvPolynomial.pderiv r (MvPolynomial.X s))) •
                KaehlerDifferential.D A B (π (MvPolynomial.X r))) +
            (∑ r : Fin (k + 1),
              (π (MvPolynomial.X s) * π (MvPolynomial.pderiv r P)) •
                KaehlerDifferential.D A B (π (MvPolynomial.X r))) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [(MvPolynomial.pderiv r).leibniz P (MvPolynomial.X s)]
          simp only [smul_eq_mul, map_add, map_mul, add_smul]
        rw [hRHS]
        congr 1
        · symm
          rw [Finset.sum_eq_single s]
          · rw [MvPolynomial.pderiv_X_self, map_one, mul_one]
          · intro r _ hrs
            rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hrs), map_zero, mul_zero, zero_smul]
          · intro hs
            exact (hs (Finset.mem_univ s)).elim
        · rw [hP, Finset.smul_sum]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [mul_smul]
    have hSurj_q : Function.Surjective q_B := by
      rw [← LinearMap.range_eq_top, eq_top_iff, ← KaehlerDifferential.span_range_derivation A B,
        Submodule.span_le]
      rintro _ ⟨b, rfl⟩
      obtain ⟨P, rfl⟩ := hSurj b
      exact ⟨fun r => π (MvPolynomial.pderiv r P), (hChain P).symm⟩
    refine ⟨hSurj_q, le_antisymm ?_ ?_⟩
    · let N_J : Submodule B (Fin (k + 1) → B) := LinearMap.range J_B.mulVecLin
      let Q_B := (Fin (k + 1) → B) ⧸ N_J
      let mkQ : (Fin (k + 1) → B) →ₗ[B] Q_B := N_J.mkQ
      let δ_tilde : MvPolynomial (Fin (k + 1)) A → Q_B :=
        fun P => mkQ (fun r => π (MvPolynomial.pderiv r P))
      have hδ_add : ∀ P₁ P₂, δ_tilde (P₁ + P₂) = δ_tilde P₁ + δ_tilde P₂ := by
        intro P₁ P₂
        have hv : (fun r => π (MvPolynomial.pderiv r (P₁ + P₂))) =
            (fun r => π (MvPolynomial.pderiv r P₁)) + (fun r => π (MvPolynomial.pderiv r P₂)) := by
          ext r; simp
        change mkQ _ = mkQ _ + mkQ _
        rw [hv, map_add]
      have hδ_sub : ∀ P₁ P₂, δ_tilde (P₁ - P₂) = δ_tilde P₁ - δ_tilde P₂ := by
        intro P₁ P₂
        have hv : (fun r => π (MvPolynomial.pderiv r (P₁ - P₂))) =
            (fun r => π (MvPolynomial.pderiv r P₁)) - (fun r => π (MvPolynomial.pderiv r P₂)) := by
          ext r; simp
        change mkQ _ = mkQ _ - mkQ _
        rw [hv, map_sub]
      have hδ_C : ∀ a : A, δ_tilde (MvPolynomial.C a) = 0 := by
        intro a
        have hv : (fun r : Fin (k + 1) => π (MvPolynomial.pderiv r (MvPolynomial.C a))) = 0 := by
          ext r; simp
        change mkQ _ = 0
        rw [hv, map_zero]
      have hδ_mul : ∀ P₁ P₂, δ_tilde (P₁ * P₂) = π P₁ • δ_tilde P₂ + π P₂ • δ_tilde P₁ := by
        intro P₁ P₂
        have hv : (fun r => π (MvPolynomial.pderiv r (P₁ * P₂))) =
            π P₁ • (fun r => π (MvPolynomial.pderiv r P₂)) +
              π P₂ • (fun r => π (MvPolynomial.pderiv r P₁)) := by
          ext r
          rw [(MvPolynomial.pderiv r).leibniz P₁ P₂]
          simp [smul_eq_mul]
        change mkQ _ = π P₁ • mkQ _ + π P₂ • mkQ _
        rw [hv, map_add, LinearMap.map_smul, LinearMap.map_smul]
      have h_vanish : ∀ {G : MvPolynomial (Fin (k + 1)) A},
          G ∈ Ideal.span (Set.range F) → δ_tilde G = 0 := by
        intro G hG
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hG
        · rintro _ ⟨j, rfl⟩
          change mkQ (fun r => J_B r j) = 0
          rw [h_mulVec_col J_B j, ← LinearMap.mem_ker, Submodule.ker_mkQ]
          exact ⟨Pi.single j 1, rfl⟩
        · rw [← MvPolynomial.C_0]
          exact hδ_C 0
        · intro x y _ _ hx hy
          rw [hδ_add, hx, hy, add_zero]
        · intro H x hx ih
          have hπx : π x = 0 := RingHom.mem_ker.mp (hKer.symm ▸ hx)
          change δ_tilde (H * x) = 0
          rw [hδ_mul, ih, hπx, smul_zero, zero_smul, add_zero]
      let sec : B → MvPolynomial (Fin (k + 1)) A := Function.surjInv hSurj
      have hsec : ∀ b : B, π (sec b) = b := Function.surjInv_eq hSurj
      let d₀ : B → Q_B := fun b => δ_tilde (sec b)
      have h_wd : ∀ P : MvPolynomial (Fin (k + 1)) A, d₀ (π P) = δ_tilde P := by
        intro P
        have hdiff : sec (π P) - P ∈ Ideal.span (Set.range F) := by
          rw [← hKer, RingHom.mem_ker, map_sub, hsec (π P), sub_self]
        exact sub_eq_zero.mp (by rw [← hδ_sub]; exact h_vanish hdiff)
      let d_lin : B →ₗ[A] Q_B :=
        { toFun := d₀
          map_add' := fun b₁ b₂ => by
            conv_lhs => rw [← hsec b₁, ← hsec b₂, ← map_add]
            rw [h_wd, hδ_add]
          map_smul' := fun a b => by
            have hab : a • b = π (MvPolynomial.C a * sec b) := by
              rw [Algebra.smul_def, map_mul, hC_app a, hsec b]
            rw [RingHom.id_apply, hab, h_wd, hδ_mul, hδ_C, smul_zero, add_zero, hC_app a]
            exact algebraMap_smul B a (d₀ b) }
      let δ_B : Derivation A B Q_B :=
        Derivation.mk' d_lin fun b₁ b₂ => by
          change d₀ (b₁ * b₂) = b₁ • d₀ b₂ + b₂ • d₀ b₁
          conv_lhs => rw [← hsec b₁, ← hsec b₂, ← map_mul]
          rw [h_wd, hδ_mul, hsec b₁, hsec b₂]
      let L : KaehlerDifferential A B →ₗ[B] Q_B := δ_B.liftKaehlerDifferential
      have hL_X : ∀ r : Fin (k + 1),
          L (KaehlerDifferential.D A B (π (MvPolynomial.X r))) = mkQ (Pi.single r 1) := by
        intro r
        rw [Derivation.liftKaehlerDifferential_comp_D]
        change d₀ (π (MvPolynomial.X r)) = mkQ (Pi.single r 1)
        rw [h_wd]
        change mkQ (fun i => π (MvPolynomial.pderiv i (MvPolynomial.X r))) = mkQ (Pi.single r 1)
        congr 1
        ext i
        by_cases hir : i = r
        · subst hir
          simp [MvPolynomial.pderiv_X_self]
        · rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hir), map_zero]
          simp [Pi.single_apply, hir, Ne.symm hir]
      intro v hv
      rw [LinearMap.mem_ker] at hv
      have hL0 : L (q_B v) = 0 := by rw [hv, map_zero]
      have hexp : L (q_B v) = mkQ v := by
        change L ((Fintype.linearCombination B _) v) = mkQ v
        rw [Fintype.linearCombination_apply, map_sum]
        calc ∑ r : Fin (k + 1),
              L (v r • KaehlerDifferential.D A B (π (MvPolynomial.X r)))
            = ∑ r : Fin (k + 1), v r • mkQ (Pi.single r 1) := by
                refine Finset.sum_congr rfl fun r _ => ?_
                rw [LinearMap.map_smul, hL_X r]
          _ = mkQ (∑ r : Fin (k + 1), v r • Pi.single r 1) := by
                rw [map_sum]
                exact Finset.sum_congr rfl fun r _ => (LinearMap.map_smul mkQ (v r) _).symm
          _ = mkQ v := by rw [h_vec_sum]
      rw [hexp] at hL0
      change v ∈ N_J
      rwa [← Submodule.ker_mkQ N_J, LinearMap.mem_ker]
    · rintro _ ⟨w, rfl⟩
      rw [LinearMap.mem_ker]
      have hcol : ∀ j : Fin k, q_B (fun r => J_B r j) = 0 := by
        intro j
        have hFj : π (F j) = 0 := by
          rw [← RingHom.mem_ker, hKer]
          exact Ideal.subset_span ⟨j, rfl⟩
        have hc := hChain (F j)
        rw [hFj, map_zero] at hc
        exact hc.symm
      rw [h_mulVec_sum J_B w, map_sum]
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [LinearMap.map_smul, hcol j, smul_zero]
  · intro A A' B B' _ _ _ _ _ _ _ _ _ _ _ _
    let e_push : TensorProduct B B' (KaehlerDifferential A B) ≃ₗ[B'] KaehlerDifferential A' B' :=
      KaehlerDifferential.tensorKaehlerEquiv A A' B B'
    have he_push : ∀ b : B,
        e_push (1 ⊗ₜ[B] KaehlerDifferential.D A B b) =
          KaehlerDifferential.D A' B' (algebraMap B B' b) := by
      intro b
      simpa [e_push] using KaehlerDifferential.tensorKaehlerEquiv_tmul_D A A' B B' (1 : B') b
    have hP := hTrans B B' (KaehlerDifferential A B) (KaehlerDifferential A' B') e_push
    refine ⟨?_, ?_⟩
    · intro k x J
      exact hP.1 k (fun r => KaehlerDifferential.D A B (x r))
        (fun r => KaehlerDifferential.D A' B' (algebraMap B B' (x r))) J (fun r => he_push (x r))
    · intro ψ
      obtain ⟨ψ', hψ'⟩ := hP.2 ψ
      refine ⟨ψ', fun b => ?_⟩
      rw [← he_push b]
      exact hψ' (KaehlerDifferential.D A B b)
  · intro R' A' B' D _ _ _ _ _ _ _ _ _ _ _ _ _
    let μ : KaehlerDifferential R' D →ₗ[D] KaehlerDifferential A' D :=
      KaehlerDifferential.map R' A' D D
    have hμ_surj : Function.Surjective μ := KaehlerDifferential.map_surjective R' A' D
    have hμ_inj : Function.Injective μ := by
      rw [← LinearMap.ker_eq_bot,
        (KaehlerDifferential.exact_mapBaseChange_map R' A' D).linearMap_ker_eq,
        ← le_bot_iff]
      rintro _ ⟨z, rfl⟩
      rw [Submodule.mem_bot]
      haveI : Subsingleton (KaehlerDifferential R' A') :=
        Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
      have hz0 : z = 0 := by
        induction z using TensorProduct.induction_on with
        | zero => rfl
        | tmul d ω =>
          rw [Subsingleton.elim ω 0, TensorProduct.tmul_zero]
        | add x y hx hy => rw [hx, hy, add_zero]
      rw [hz0, map_zero]
    let e_unram : KaehlerDifferential R' D ≃ₗ[D] KaehlerDifferential A' D :=
      LinearEquiv.ofBijective μ ⟨hμ_inj, hμ_surj⟩
    have he_unram_symm : ∀ d : D,
        e_unram.symm (KaehlerDifferential.D A' D d) = KaehlerDifferential.D R' D d := by
      intro d
      apply e_unram.injective
      rw [e_unram.apply_symm_apply]
      symm
      change μ (KaehlerDifferential.D R' D d) = KaehlerDifferential.D A' D d
      simpa [μ] using KaehlerDifferential.map_D R' A' D D d
    let e_et : TensorProduct B' D (KaehlerDifferential A' B') ≃ₗ[D] KaehlerDifferential A' D :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A' B' D
    let e_tot : TensorProduct B' D (KaehlerDifferential A' B') ≃ₗ[D] KaehlerDifferential R' D :=
      e_et.trans e_unram.symm
    have he_tot : ∀ b' : B',
        e_tot (1 ⊗ₜ[B'] KaehlerDifferential.D A' B' b') =
          KaehlerDifferential.D R' D (algebraMap B' D b') := by
      intro b'
      have het : e_et (1 ⊗ₜ[B'] KaehlerDifferential.D A' B' b') =
          KaehlerDifferential.D A' D (algebraMap B' D b') := by
        apply e_et.symm.injective
        rw [e_et.symm_apply_apply]
        exact (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap A' B' D b').symm
      change e_unram.symm (e_et (1 ⊗ₜ[B'] KaehlerDifferential.D A' B' b')) = _
      rw [het, he_unram_symm]
    have hE := hTrans B' D (KaehlerDifferential A' B') (KaehlerDifferential R' D) e_tot
    refine ⟨?_, ?_⟩
    · intro k x J
      exact hE.1 k (fun r => KaehlerDifferential.D A' B' (x r))
        (fun r => KaehlerDifferential.D R' D (algebraMap B' D (x r))) J (fun r => he_tot (x r))
    · intro ψ'
      obtain ⟨ψ_D, hψ_D⟩ := hE.2 ψ'
      refine ⟨ψ_D, fun b' => ?_⟩
      rw [← he_tot b']
      exact hψ_D (KaehlerDifferential.D A' B' b')

theorem weil_pulledBack_chart_cramer_injective_and_log_functional (R : Type u) [CommRing R] [IsNoetherianRing R] (n : ℕ)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (U : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens)
    (V : C.Opens) (k : ℕ)
    (π : MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)) →+*
      ↑(C.presheaf.obj (Opposite.op V)))
    (F : Fin k → MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)))
    (tag : Option (Fin n))
    (t : ↑(C.presheaf.obj (Opposite.op V)))
    (hChart : IsLocalLogCanonicalChart g n τ U V k π F tag t)
    (R' : Type u) [CommRing R'] [IsNoetherianRing R'] (ρ : R →+* R')
    (X' : AlgebraicGeometry.Scheme.{u})
    (p' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R'))
    (f_C : X' ⟶ C)
    (hPb : CategoryTheory.IsPullback f_C p' g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)))
    (W : X'.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W)
    (hW_le : W ≤ (TopologicalSpace.Opens.map f_C.base).obj V)
    (hPullback : ∀ (S S' C_0 : AlgebraicGeometry.Scheme.{u})
      (f_S : S' ⟶ S) (g_0 : C_0 ⟶ S) (τ_0 : Fin n → (S ⟶ C_0)),
      IsGeometricStablePointedCurve g_0 n τ_0 →
      ∃ τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g_0 f_S),
        (∀ j : Fin n,
          τ' j ≫ CategoryTheory.Limits.pullback.fst g_0 f_S = f_S ≫ τ_0 j ∧
          τ' j ≫ CategoryTheory.Limits.pullback.snd g_0 f_S = 𝟙 S' ∧
          Set.range (τ' j).base =
            (CategoryTheory.Limits.pullback.fst g_0 f_S).base ⁻¹' Set.range (τ_0 j).base) ∧
        IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g_0 f_S) n τ')
    (hCramer : ∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k₁ k₂ : ℕ)
      (J₁ : Matrix (Fin (k₁ + 1)) (Fin k₁) B)
      (q₁ : (Fin (k₁ + 1) → B) →ₗ[B] Ω_mod)
      (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) B)
      (q₂ : (Fin (k₂ + 1) → B) →ₗ[B] Ω_mod),
      Function.Surjective q₁ →
      LinearMap.ker q₁ = LinearMap.range J₁.mulVecLin →
      Function.Surjective q₂ →
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin →
      Function.Injective J₂.mulVecLin →
      Function.Injective J₁.mulVecLin ∧
      ∃ (ψ₁ ψ₂ : Ω_mod →ₗ[B] B) (u : Bˣ),
        (∀ v : Fin (k₁ + 1) → B,
          ψ₁ (q₁ v) = ∑ r : Fin (k₁ + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id)) ∧
        (∀ w : Fin (k₂ + 1) → B,
          ψ₂ (q₂ w) = ∑ s : Fin (k₂ + 1),
            w s * (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) ∧
        ψ₁ = u.val • ψ₂)
    (hZeroAnn : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A]
      [CommRing B] [Algebra A B] [Module.Flat A B] (S_gen : Set B),
      (∀ (p : PrimeSpectrum A),
        let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
        letI : Algebra A Ω :=
          ((algebraMap p.asIdeal.ResidueField Ω).comp
            (algebraMap A p.asIdeal.ResidueField)).toAlgebra
        ∀ z : TensorProduct A B Ω,
          (∀ b ∈ S_gen, TensorProduct.tmul A b (1 : Ω) * z = 0) → z = 0) →
      ∀ z : B, (∀ b ∈ S_gen, b * z = 0) → z = 0)
    (hKaehler : HasWeilIsoKaehlerTransport R) :
    let D := ↑(X'.presheaf.obj (Opposite.op W))
    letI : Algebra R' D :=
      ((p'.appLE ⊤ W (fun _ _ => trivial)).hom.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom).toAlgebra
    let J_D : Matrix (Fin (k + 1)) (Fin k) D :=
      Matrix.of fun (i : Fin (k + 1)) (j : Fin k) =>
        (f_C.appLE V W hW_le).hom (π (MvPolynomial.pderiv i (F j)))
    let q_D : (Fin (k + 1) → D) →ₗ[D] KaehlerDifferential R' D :=
      Fintype.linearCombination D fun r : Fin (k + 1) =>
        KaehlerDifferential.D R' D ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r)))
    Function.Surjective q_D ∧
    LinearMap.ker q_D = LinearMap.range J_D.mulVecLin ∧
    Function.Injective J_D.mulVecLin ∧
    (∀ z : D, z * (f_C.appLE V W hW_le).hom t = 0 → z = 0) ∧
    ∃ δ_log : D → D, IsPulledBackChartLogFunctional p' f_C U V k π F t W hW_le δ_log :=
by
  let _ := @hPullback
  
  have hSpecPre : ∀ {R₀ : Type u} [CommRing R₀] {X : AlgebraicGeometry.Scheme.{u}}
      (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀))
      {O_W : X.Opens} (hAffO : AlgebraicGeometry.IsAffineOpen O_W),
      (AlgebraicGeometry.Spec.preimage (hAffO.fromSpec ≫ f)).hom =
        (f.appLE ⊤ O_W (fun _ _ => trivial)).hom.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv.hom := by
    intro R₀ _ X f O_W hAffO
    let D_obj := X.presheaf.obj (Opposite.op O_W)
    let φ := AlgebraicGeometry.Spec.preimage (hAffO.fromSpec ≫ f)
    have hmap : AlgebraicGeometry.Spec.map φ = hAffO.fromSpec ≫ f :=
      AlgebraicGeometry.Spec.map_preimage _
    have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality φ
    have hφ_eq : φ = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        (AlgebraicGeometry.Spec.map φ).appTop) ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso D_obj).hom := by
      have hc := congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso D_obj).hom) hnat
      dsimp only [D_obj] at hc ⊢
      rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.comp_id] at hc
      exact hc
    have happ_top : (hAffO.fromSpec ≫ f).appTop =
        f.appTop ≫ hAffO.fromSpec.appTop := AlgebraicGeometry.Scheme.Hom.comp_appTop _ _
    have hfrom_appTop : hAffO.fromSpec.appTop =
        X.presheaf.map (CategoryTheory.homOfLE (le_top : O_W ≤ ⊤)).op ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso D_obj).inv := by
      let T_pre : (AlgebraicGeometry.Spec D_obj).Opens :=
        (TopologicalSpace.Opens.map hAffO.fromSpec.base).obj ⊤
      have hle_pre : (⊤ : (AlgebraicGeometry.Spec D_obj).Opens) ≤ T_pre := fun _ _ => trivial
      change hAffO.fromSpec.app ⊤ ≫
        (AlgebraicGeometry.Spec D_obj).presheaf.map (CategoryTheory.homOfLE hle_pre).op = _
      rw [hAffO.fromSpec_app_of_le ⊤ le_top, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
      have hid : (CategoryTheory.homOfLE (le_top : T_pre ≤ ⊤)).op ≫
          (CategoryTheory.homOfLE hle_pre).op =
          𝟙 (Opposite.op (⊤ : (AlgebraicGeometry.Spec D_obj).Opens)) :=
        Subsingleton.elim _ _
      rw [hid, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
    have htotal : φ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
        f.appLE ⊤ O_W (fun _ _ => trivial) := by
      rw [hφ_eq, hmap, happ_top, hfrom_appTop]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.comp_id]
      rfl
    ext r
    exact ConcreteCategory.congr_hom htotal r
  have happLE_congr : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X ⟶ Y} (h : f₁ = f₂)
      (O_Y : Y.Opens) (O_X : X.Opens)
      (e₁ : O_X ≤ (TopologicalSpace.Opens.map f₁.base).obj O_Y)
      (e₂ : O_X ≤ (TopologicalSpace.Opens.map f₂.base).obj O_Y),
      f₁.appLE O_Y O_X e₁ = f₂.appLE O_Y O_X e₂ := by
    intro X Y f₁ f₂ h; subst h; intro O_Y O_X e₁ e₂; rfl
  
  have h_s2_part1 : ∀ (A₀ A₀' B₀ B₀' D₀ : Type u)
      [CommRing A₀] [CommRing A₀'] [CommRing B₀] [CommRing B₀'] [CommRing D₀]
      [Algebra A₀ A₀'] [Algebra A₀ B₀] [Algebra A₀ B₀'] [Algebra A₀' B₀'] [Algebra B₀ B₀']
      [IsScalarTower A₀ A₀' B₀'] [IsScalarTower A₀ B₀ B₀'] [Algebra.IsPushout A₀ A₀' B₀ B₀']
      (res_BD : B₀' →+* D₀), res_BD.Flat →
      ∀ (σ : B₀ →+* A₀), σ.comp (algebraMap A₀ B₀) = RingHom.id A₀ →
      ∀ (t₀ : B₀), RingHom.ker σ = Ideal.span {t₀} →
      (∀ b : B₀, b * t₀ = 0 → b = 0) →
      ∀ (z : D₀), z * res_BD (algebraMap B₀ B₀' t₀) = 0 → z = 0 := by
    intro A₀ A₀' B₀ B₀' D₀ _ _ _ _ _ _ _ _ _ _ _ _ _ res_BD hFlat σ hσ_sec t₀ hker ht_nzd z hz
    have ht_cancel : ∀ b₁ b₂ : B₀, b₁ * t₀ = b₂ * t₀ → b₁ = b₂ := by
      intro b₁ b₂ h
      exact sub_eq_zero.mp (ht_nzd (b₁ - b₂) (by rw [sub_mul, h, sub_self]))
    have hdiv_ex : ∀ b : B₀, ∃ q : B₀, q * t₀ = b - algebraMap A₀ B₀ (σ b) := by
      intro b
      have hmem : b - algebraMap A₀ B₀ (σ b) ∈ Ideal.span ({t₀} : Set B₀) := by
        rw [← hker, RingHom.mem_ker, map_sub, ← RingHom.comp_apply, hσ_sec, RingHom.id_apply, sub_self]
      exact Ideal.mem_span_singleton'.mp hmem
    choose q_fun hq_spec using hdiv_ex
    let Q_B : B₀ →ₗ[A₀] B₀ :=
      { toFun := q_fun
        map_add' := fun b₁ b₂ => by
          apply ht_cancel
          rw [add_mul, hq_spec, hq_spec, hq_spec, map_add, map_add]
          ring
        map_smul' := fun a b => by
          apply ht_cancel
          simp only [RingHom.id_apply, Algebra.smul_def]
          have hσ_ab : σ (algebraMap A₀ B₀ a * b) = a * σ b := by
            rw [map_mul, ← RingHom.comp_apply, hσ_sec, RingHom.id_apply]
          rw [mul_assoc, hq_spec, hq_spec, hσ_ab, map_mul]
          ring }
    let μ_B : B₀ →ₗ[A₀] B₀ :=
      { toFun := fun b => b * t₀
        map_add' := fun b₁ b₂ => add_mul b₁ b₂ t₀
        map_smul' := fun a b => by simp only [RingHom.id_apply, Algebra.smul_def, mul_assoc] }
    have hQ_μ : ∀ b : B₀, Q_B (μ_B b) = b := by
      intro b
      apply ht_cancel
      have hσ_bt : σ (b * t₀) = 0 := by
        rw [← RingHom.mem_ker, hker]
        exact Ideal.mem_span_singleton'.mpr ⟨b, rfl⟩
      change q_fun (b * t₀) * t₀ = b * t₀
      rw [hq_spec, hσ_bt, map_zero, sub_zero]
    let e_push : TensorProduct A₀ A₀' B₀ ≃ₐ[A₀'] B₀' := Algebra.IsPushout.equiv A₀ A₀' B₀ B₀'
    have he_one_t : e_push (TensorProduct.tmul A₀ (1 : A₀') t₀) = algebraMap B₀ B₀' t₀ := by
      rw [Algebra.IsPushout.equiv_tmul, map_one, one_mul]
    let t_B' : B₀' := algebraMap B₀ B₀' t₀
    let f_lhs : TensorProduct A₀ A₀' B₀ →ₗ[A₀] B₀' :=
      (e_push.toAlgHom.toLinearMap.restrictScalars A₀).comp
        ((LinearMap.lTensor A₀' μ_B).restrictScalars A₀)
    let f_rhs : TensorProduct A₀ A₀' B₀ →ₗ[A₀] B₀' :=
      { toFun := fun u => e_push u * t_B'
        map_add' := fun x y => by rw [map_add, add_mul]
        map_smul' := fun a u => by
          simp only [RingHom.id_apply]
          have hsm : e_push (a • u) = a • e_push u := by
            rw [← IsScalarTower.algebraMap_smul A₀' a u, map_smul e_push,
              IsScalarTower.algebraMap_smul A₀' a (e_push u)]
          rw [hsm, Algebra.smul_def, Algebra.smul_def, mul_assoc] }
    have h_lin_eq : f_lhs = f_rhs := by
      apply TensorProduct.ext'
      intro a' b
      change e_push (TensorProduct.tmul A₀ a' (b * t₀)) = e_push (TensorProduct.tmul A₀ a' b) * t_B'
      have hmul : TensorProduct.tmul A₀ a' (b * t₀) =
          TensorProduct.tmul A₀ a' b * TensorProduct.tmul A₀ (1 : A₀') t₀ := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      rw [hmul, map_mul, he_one_t]
    have h_intertwine : ∀ u : TensorProduct A₀ A₀' B₀,
        e_push ((LinearMap.lTensor A₀' μ_B) u) = e_push u * t_B' :=
      fun u => LinearMap.congr_fun h_lin_eq u
    have hInj_B' : ∀ b' : B₀', b' * t_B' = 0 → b' = 0 := by
      intro b' hb'
      let u := e_push.symm b'
      have hu_eq : e_push u = b' := e_push.apply_symm_apply b'
      have hl_zero : (LinearMap.lTensor A₀' μ_B) u = 0 := by
        apply e_push.injective
        rw [h_intertwine, hu_eq, hb', map_zero]
      have hQ_lTensor : (LinearMap.lTensor A₀' Q_B) ((LinearMap.lTensor A₀' μ_B) u) = u := by
        change ((LinearMap.lTensor A₀' Q_B).comp (LinearMap.lTensor A₀' μ_B)) u = u
        rw [← LinearMap.lTensor_comp]
        have hcomp : Q_B.comp μ_B = LinearMap.id := LinearMap.ext hQ_μ
        rw [hcomp, LinearMap.lTensor_id, LinearMap.id_apply]
      rw [← hu_eq, ← hQ_lTensor, hl_zero, map_zero, map_zero]
    let _ : Algebra B₀' D₀ := res_BD.toAlgebra
    have hFlat_mod : Module.Flat B₀' D₀ := RingHom.flat_algebraMap_iff.mp hFlat
    let μ_B'_lin : B₀' →ₗ[B₀'] B₀' :=
      { toFun := fun b' => b' * t_B'
        map_add' := fun x y => add_mul x y t_B'
        map_smul' := fun c x => by simp only [RingHom.id_apply, smul_eq_mul, mul_assoc] }
    have hμ_inj : Function.Injective μ_B'_lin := by
      intro x y hxy
      change x * t_B' = y * t_B' at hxy
      exact sub_eq_zero.mp (hInj_B' (x - y) (by rw [sub_mul, hxy, sub_self]))
    have hl_inj := @Module.Flat.lTensor_preserves_injective_linearMap B₀' D₀ B₀' B₀' _ _ _ _ _ _ _ hFlat_mod μ_B'_lin hμ_inj
    have hz_tmul : (TensorProduct.tmul B₀' z (1 : B₀') : TensorProduct B₀' D₀ B₀') = 0 := by
      apply hl_inj
      rw [map_zero]
      change TensorProduct.tmul B₀' z ((1 : B₀') * t_B') = 0
      have hsmul : ((1 : B₀') * t_B') = t_B' • (1 : B₀') := by simp [smul_eq_mul]
      rw [hsmul, ← TensorProduct.smul_tmul]
      have htz : (t_B' • z : D₀) = 0 := by
        change res_BD t_B' * z = 0
        rw [mul_comm]
        exact hz
      rw [htz, TensorProduct.zero_tmul]
    have hrid := congrArg (Algebra.TensorProduct.rid B₀' D₀ D₀) hz_tmul
    simpa using hrid
  
  have h_s3_part1 : ∀ (Ω : Type u) [Field Ω] (S₀ : Type u) [CommRing S₀] [Algebra Ω S₀] [Nontrivial S₀]
      (Γ₀ : Type u) [CommRing Γ₀]
      (φ₀ : Γ₀ →+* S₀), RingHom.IsStandardSmoothOfRelativeDimension 1 φ₀ →
      ∀ (e_src : Ω ≃+* Γ₀), φ₀.comp e_src.toRingHom = algebraMap Ω S₀ →
      ∃ (k₂ : ℕ) (x₂ : Fin (k₂ + 1) → S₀) (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) S₀),
        let q₂ : (Fin (k₂ + 1) → S₀) →ₗ[S₀] KaehlerDifferential Ω S₀ :=
          Fintype.linearCombination S₀ fun s : Fin (k₂ + 1) => KaehlerDifferential.D Ω S₀ (x₂ s)
        Function.Surjective q₂ ∧
        LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin ∧
        Function.Injective J₂.mulVecLin ∧
        IsUnit (Matrix.det (J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id)) := by
    intro Ω _ S₀ _ _ _ Γ₀ _ φ₀ hStd₀ e_src he_comm
    classical
    let _ : Algebra Γ₀ S₀ := φ₀.toAlgebra
    have hStdAlg : Algebra.IsStandardSmoothOfRelativeDimension 1 Γ₀ S₀ := hStd₀
    obtain ⟨ι, σ, hFin_σ, hFin_ι, P, hdim⟩ := hStdAlg.out
    let _ : Fintype σ := Fintype.ofFinite σ
    let _ : Fintype ι := Fintype.ofFinite ι
    have hle_card : Nat.card σ ≤ Nat.card ι := by
      rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
      exact Fintype.card_le_of_injective P.map P.map_inj
    let k₂ : ℕ := Nat.card σ
    have hdim_eq : Nat.card ι - k₂ = 1 := hdim
    have hcard_ι : Nat.card ι = k₂ + 1 := by omega
    let f_eq : Fin k₂ ≃ σ := (Finite.equivFinOfCardEq (rfl : Nat.card σ = k₂)).symm
    have h_not_surj : ¬ Function.Surjective P.map := by
      intro hsurj
      have hbij : Function.Bijective P.map := ⟨P.map_inj, hsurj⟩
      have hcard_eq : Nat.card σ = Nat.card ι := Nat.card_congr (Equiv.ofBijective P.map hbij)
      omega
    obtain ⟨i₀, hi₀⟩ : ∃ i₀ : ι, i₀ ∉ Set.range P.map := by
      by_contra hall
      push Not at hall
      exact h_not_surj hall
    let e_fun : Fin (k₂ + 1) → ι := Fin.cases i₀ (fun j => P.map (f_eq j))
    have he_inj : Function.Injective e_fun := by
      intro a b hab
      cases a using Fin.cases with
      | zero =>
        cases b using Fin.cases with
        | zero => rfl
        | succ j => exfalso; exact hi₀ ⟨f_eq j, hab.symm⟩
      | succ i =>
        cases b using Fin.cases with
        | zero => exfalso; exact hi₀ ⟨f_eq i, hab⟩
        | succ j => exact congrArg Fin.succ (f_eq.injective (P.map_inj hab))
    have he_bij : Function.Bijective e_fun :=
      (Fintype.bijective_iff_injective_and_card e_fun).mpr
        ⟨he_inj, by rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, hcard_ι]⟩
    let e_eq : Fin (k₂ + 1) ≃ ι := Equiv.ofBijective e_fun he_bij
    let P' : Algebra.SubmersivePresentation Γ₀ S₀ (Fin (k₂ + 1)) (Fin k₂) := P.reindex e_eq f_eq
    have hP'_map : ∀ j : Fin k₂, P'.map j = (0 : Fin (k₂ + 1)).succAbove j := by
      intro j
      rw [Fin.succAbove_zero]
      apply e_eq.injective
      change e_eq (P'.map j) = e_fun j.succ
      exact e_eq.apply_symm_apply _
    let map_to : MvPolynomial (Fin (k₂ + 1)) Ω →+* P'.Ring :=
      MvPolynomial.map e_src.toRingHom
    let map_inv : P'.Ring →+* MvPolynomial (Fin (k₂ + 1)) Ω :=
      MvPolynomial.map e_src.symm.toRingHom
    have h_to_inv : ∀ p : P'.Ring, map_to (map_inv p) = p := by
      intro p
      change MvPolynomial.map e_src.toRingHom (MvPolynomial.map e_src.symm.toRingHom p) = p
      rw [MvPolynomial.map_map]
      have hid : e_src.toRingHom.comp e_src.symm.toRingHom = RingHom.id Γ₀ := by
        ext x; exact e_src.apply_symm_apply x
      rw [hid, MvPolynomial.map_id]
    have h_inv_to : ∀ p : MvPolynomial (Fin (k₂ + 1)) Ω, map_inv (map_to p) = p := by
      intro p
      change MvPolynomial.map e_src.symm.toRingHom (MvPolynomial.map e_src.toRingHom p) = p
      rw [MvPolynomial.map_map]
      have hid : e_src.symm.toRingHom.comp e_src.toRingHom = RingHom.id Ω := by
        ext x; exact e_src.symm_apply_apply x
      rw [hid, MvPolynomial.map_id]
    let π_Γ : P'.Ring →+* S₀ := algebraMap P'.Ring S₀
    let π₂ : MvPolynomial (Fin (k₂ + 1)) Ω →+* S₀ := π_Γ.comp map_to
    let F₂ : Fin k₂ → MvPolynomial (Fin (k₂ + 1)) Ω := fun j => map_inv (P'.relation j)
    have hπ₂_C : π₂.comp MvPolynomial.C = algebraMap Ω S₀ := by
      ext c
      change algebraMap P'.Ring S₀ (MvPolynomial.map e_src.toRingHom (MvPolynomial.C c)) = algebraMap Ω S₀ c
      rw [MvPolynomial.map_C]
      have hC_alg : (MvPolynomial.C (e_src.toRingHom c) : P'.Ring) =
          algebraMap Γ₀ P'.Ring (e_src.toRingHom c) := rfl
      rw [hC_alg, ← IsScalarTower.algebraMap_apply Γ₀ P'.Ring S₀]
      exact RingHom.congr_fun he_comm c
    have hπ₂_surj : Function.Surjective π₂ :=
      P'.algebraMap_surjective.comp (MvPolynomial.map_surjective _ e_src.surjective)
    have hπ₂_ker : RingHom.ker π₂ = Ideal.span (Set.range F₂) := by
      have hP'_ker : RingHom.ker π_Γ = Ideal.span (Set.range P'.relation) :=
        P'.span_range_relation_eq_ker.symm
      ext p
      rw [RingHom.mem_ker]
      change π_Γ (map_to p) = 0 ↔ p ∈ Ideal.span (Set.range F₂)
      rw [← RingHom.mem_ker, hP'_ker]
      constructor
      · intro hp
        have hp' : map_inv (map_to p) ∈ Ideal.map map_inv (Ideal.span (Set.range P'.relation)) :=
          Ideal.mem_map_of_mem map_inv hp
        rw [h_inv_to, Ideal.map_span, ← Set.range_comp] at hp'
        exact hp'
      · intro hp
        have hp' : map_to p ∈ Ideal.map map_to (Ideal.span (Set.range F₂)) :=
          Ideal.mem_map_of_mem map_to hp
        rw [Ideal.map_span, ← Set.range_comp] at hp'
        have hrange : (map_to ∘ F₂) = P'.relation :=
          funext fun j => h_to_inv (P'.relation j)
        rwa [hrange] at hp'
    obtain ⟨hq₂_surj, hq₂_ker⟩ := hKaehler.1 Ω S₀ k₂ π₂ F₂ hπ₂_C hπ₂_surj hπ₂_ker
    let x₂ : Fin (k₂ + 1) → S₀ := fun s => π₂ (MvPolynomial.X s)
    let J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) S₀ :=
      Matrix.of fun (i : Fin (k₂ + 1)) (j : Fin k₂) => π₂ (MvPolynomial.pderiv i (F₂ j))
    have hM₀_eq : J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id = π_Γ.mapMatrix P'.jacobiMatrix := by
      ext i j
      simp only [Matrix.submatrix_apply, id_eq, Matrix.of_apply, RingHom.mapMatrix_apply,
        Matrix.map_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply, J₂]
      rw [← hP'_map i]
      change π_Γ (map_to (MvPolynomial.pderiv (P'.map i) (map_inv (P'.relation j)))) =
        π_Γ (MvPolynomial.pderiv (P'.map i) (P'.relation j))
      rw [← MvPolynomial.pderiv_map, h_to_inv]
    have hUnit_M₀ : IsUnit (Matrix.det (J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id)) := by
      rw [hM₀_eq, ← RingHom.map_det]
      have hjac : π_Γ P'.jacobiMatrix.det = P'.jacobian :=
        (Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det P'.toPreSubmersivePresentation).symm
      rw [hjac]
      exact P'.jacobian_isUnit
    have hInj_J₂ : Function.Injective J₂.mulVecLin := by
      intro w₁ w₂ hw_eq
      have hw_zero : J₂.mulVec (w₁ - w₂) = 0 := by
        change J₂.mulVecLin (w₁ - w₂) = 0
        rw [map_sub, hw_eq, sub_self]
      let M₀ := J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id
      have hM₀_zero : M₀.mulVec (w₁ - w₂) = 0 := by
        ext i
        simp only [Matrix.mulVec, dotProduct, Matrix.submatrix_apply, id_eq, Pi.zero_apply, M₀]
        exact congrFun hw_zero ((0 : Fin (k₂ + 1)).succAbove i)
      obtain ⟨u_det, hu_det⟩ := hUnit_M₀
      ext c
      have hadj := congrFun (congrArg M₀.adjugate.mulVec hM₀_zero) c
      rw [Matrix.mulVec_zero, Pi.zero_apply, Matrix.mulVec_mulVec, Matrix.adjugate_mul] at hadj
      simp only [Matrix.mulVec, dotProduct, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul,
        mul_ite, mul_one, mul_zero, ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte] at hadj
      have hdet_mul : u_det.val * (w₁ - w₂) c = 0 := by
        have h1 : M₀.det * (w₁ - w₂) c = 0 := hadj
        rwa [← hu_det] at h1
      have hdiff_zero : (w₁ - w₂) c = 0 := by
        calc (w₁ - w₂) c
            = (u_det⁻¹.val * u_det.val) * (w₁ - w₂) c := by rw [Units.inv_mul, one_mul]
          _ = u_det⁻¹.val * (u_det.val * (w₁ - w₂) c) := by ring
          _ = 0 := by rw [hdet_mul, mul_zero]
      exact sub_eq_zero.mp hdiff_zero
    exact ⟨k₂, x₂, J₂, hq₂_surj, hq₂_ker, hInj_J₂, hUnit_M₀⟩
  
  have h_s3_part2 : ∀ (Ω : Type u) [Field Ω] (A'' : Type u) [CommRing A''] [Algebra Ω A'']
      (φ₂ : (MvPolynomial (Fin 2) Ω ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* A''),
      φ₂.Etale →
      φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap Ω A'' →
      let u₀ := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
      let u₁ := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      let J_node : Matrix (Fin 2) (Fin 1) A'' := Matrix.of fun i _ => if i = 0 then u₁ else u₀
      let q_node : (Fin 2 → A'') →ₗ[A''] KaehlerDifferential Ω A'' :=
        Fintype.linearCombination A'' fun i : Fin 2 =>
          KaehlerDifferential.D Ω A'' (if i = 0 then u₀ else u₁)
      Function.Surjective q_node ∧
      LinearMap.ker q_node = LinearMap.range J_node.mulVecLin ∧
      Function.Injective J_node.mulVecLin ∧
      (∀ a : A'', u₀ * a = 0 → u₁ * a = 0 → a = 0) := by
    intro Ω _ A'' _ _ φ₂ hEt₂ hComm₂ u₀ u₁ J_node q_node
    let P₂ := MvPolynomial (Fin 2) Ω
    let I_node : Ideal P₂ := Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set P₂)
    let R_node := P₂ ⧸ I_node
    let π_node : P₂ →+* R_node := Ideal.Quotient.mk I_node
    let F_node : Fin 1 → P₂ := fun _ => MvPolynomial.X 0 * MvPolynomial.X 1
    have hπ_C : π_node.comp MvPolynomial.C = algebraMap Ω R_node := rfl
    have hπ_surj : Function.Surjective π_node := Ideal.Quotient.mk_surjective
    have hπ_ker : RingHom.ker π_node = Ideal.span (Set.range F_node) := by
      rw [Ideal.mk_ker]
      apply congrArg Ideal.span
      ext p; simp [F_node]
    obtain ⟨hqR_surj, hqR_ker⟩ := hKaehler.1 Ω R_node 1 π_node F_node hπ_C hπ_surj hπ_ker
    let _ : Algebra R_node A'' := φ₂.toAlgebra
    have _ : IsScalarTower Ω R_node A'' :=
      ⟨fun c r a => by
        change φ₂ (c • r) * a = c • (φ₂ r * a)
        have hcr : c • r = algebraMap Ω R_node c * r := Algebra.smul_def c r
        rw [hcr, map_mul, Algebra.smul_def, mul_assoc]
        congr 1
        exact RingHom.congr_fun hComm₂ c⟩
    have _ : Algebra.Etale R_node A'' := RingHom.Etale.toAlgebra hEt₂
    have _ : Algebra.FormallyEtale R_node A'' := inferInstance
    have _ : Algebra.FormallyUnramified Ω Ω := inferInstance
    obtain ⟨hqA_surj, hqA_ker⟩ :=
      (hKaehler.2.2 Ω Ω R_node A'').1 1 (fun r => π_node (MvPolynomial.X r))
        (Matrix.of fun (i : Fin 2) (j : Fin 1) => π_node (MvPolynomial.pderiv i (F_node j)))
        hqR_surj hqR_ker
    have hq_eq : (Fintype.linearCombination A'' fun r : Fin 2 =>
        KaehlerDifferential.D Ω A'' (algebraMap R_node A'' (π_node (MvPolynomial.X r)))) = q_node := by
      congr 1; ext i; fin_cases i <;> rfl
    have hJ_eq : (Matrix.of fun (i : Fin 2) (j : Fin 1) =>
        π_node (MvPolynomial.pderiv i (F_node j))).map (algebraMap R_node A'') = J_node := by
      ext i j
      dsimp only [J_node, F_node]
      fin_cases j
      fin_cases i
      · simp only [Matrix.map_apply, Matrix.of_apply, Fin.zero_eta, Fin.isValue, ↓reduceIte]
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self,
          MvPolynomial.pderiv_X_of_ne (by decide : (1 : Fin 2) ≠ 0)]
        simp [u₁, π_node, I_node]; rfl
      · simp only [Matrix.map_apply, Matrix.of_apply, Fin.mk_one, Fin.isValue, one_ne_zero, ↓reduceIte]
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self,
          MvPolynomial.pderiv_X_of_ne (by decide : (0 : Fin 2) ≠ 1)]
        simp [u₀, π_node, I_node]; rfl
    rw [hq_eq] at hqA_surj hqA_ker
    rw [hJ_eq] at hqA_ker
    let e01 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
    have hX01_mon : (MvPolynomial.X 0 * MvPolynomial.X 1 : P₂) = MvPolynomial.monomial e01 1 := by
      rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, mul_one]
    have h_mem_Inode : ∀ p : P₂, p ∈ I_node ↔ ∀ m : Fin 2 →₀ ℕ, (m 0 = 0 ∨ m 1 = 0) → p.coeff m = 0 := by
      intro p
      constructor
      · intro hp m hm
        rw [Ideal.mem_span_singleton'] at hp
        obtain ⟨q, rfl⟩ := hp
        rw [hX01_mon, MvPolynomial.coeff_mul_monomial', mul_one]
        split_ifs with hle
        · exfalso
          rcases hm with hm0 | hm1
          · have h0 := hle (0 : Fin 2); simp [e01] at h0; omega
          · have h1 := hle (1 : Fin 2); simp [e01] at h1; omega
        · rfl
      · intro hcoeff
        rw [p.as_sum]
        refine Ideal.sum_mem I_node fun m hm => ?_
        have hne : p.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
        have hm0 : m 0 ≠ 0 := fun h0 => hne (hcoeff m (Or.inl h0))
        have hm1 : m 1 ≠ 0 := fun h1 => hne (hcoeff m (Or.inr h1))
        have hle : e01 ≤ m := by
          intro i; fin_cases i <;> (simp [e01]; omega)
        have hm_eq : m - e01 + e01 = m := tsub_add_cancel_of_le hle
        have hmon_eq : MvPolynomial.monomial m (p.coeff m) =
            MvPolynomial.monomial (m - e01) (p.coeff m) * (MvPolynomial.X 0 * MvPolynomial.X 1) := by
          rw [hX01_mon, MvPolynomial.monomial_mul_monomial, mul_one, hm_eq]
        rw [hmon_eq]
        exact Ideal.mem_span_singleton'.mpr ⟨_, rfl⟩
    have hRnode_ann : ∀ c : R_node, π_node (MvPolynomial.X 0) * c = 0 →
        π_node (MvPolynomial.X 1) * c = 0 → c = 0 := by
      intro c hc0 hc1
      obtain ⟨p, rfl⟩ := hπ_surj c
      rw [← map_mul, ← RingHom.mem_ker, Ideal.mk_ker] at hc0 hc1
      have hp_mem : p ∈ I_node := by
        rw [h_mem_Inode]
        intro m hm
        rcases hm with hm0 | hm1
        · have h1 := (h_mem_Inode (MvPolynomial.X 1 * p)).mp hc1 (Finsupp.single 1 1 + m)
            (Or.inl (by simp [hm0]))
          rwa [MvPolynomial.coeff_X_mul] at h1
        · have h0 := (h_mem_Inode (MvPolynomial.X 0 * p)).mp hc0 (Finsupp.single 0 1 + m)
            (Or.inr (by simp [hm1]))
          rwa [MvPolynomial.coeff_X_mul] at h0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hp_mem
    let xbar0 : R_node := π_node (MvPolynomial.X 0)
    let xbar1 : R_node := π_node (MvPolynomial.X 1)
    let μ_node : R_node →ₗ[R_node] R_node × R_node :=
      { toFun := fun c => (xbar1 * c, xbar0 * c)
        map_add' := fun a b => by ext <;> simp [mul_add]
        map_smul' := fun r a => by ext <;> simp [smul_eq_mul] <;> ring }
    have hμ_node_inj : Function.Injective μ_node := by
      intro a b hab
      have h1 : xbar1 * (a - b) = 0 := by
        have := congrArg Prod.fst hab; dsimp [μ_node] at this; linear_combination this
      have h0 : xbar0 * (a - b) = 0 := by
        have := congrArg Prod.snd hab; dsimp [μ_node] at this; linear_combination this
      exact sub_eq_zero.mp (hRnode_ann (a - b) h0 h1)
    have _ : Module.Flat R_node A'' := Algebra.Smooth.flat R_node A''
    have hl_inj := @Module.Flat.lTensor_preserves_injective_linearMap R_node A'' R_node (R_node × R_node)
      _ _ _ _ _ _ _ inferInstance μ_node hμ_node_inj
    have hA''_ann : ∀ a : A'', u₀ * a = 0 → u₁ * a = 0 → a = 0 := by
      intro a ha0 ha1
      have h_tmul : (TensorProduct.tmul R_node a (1 : R_node) : TensorProduct R_node A'' R_node) = 0 := by
        apply hl_inj
        rw [map_zero]
        change TensorProduct.tmul R_node a (xbar1 * 1, xbar0 * 1) = 0
        have hprod : (xbar1 * 1, xbar0 * 1) =
            xbar1 • ((1 : R_node), (0 : R_node)) + xbar0 • ((0 : R_node), (1 : R_node)) := by
          ext <;> simp
        rw [hprod, TensorProduct.tmul_add,
          ← TensorProduct.smul_tmul xbar1 a ((1 : R_node), (0 : R_node)),
          ← TensorProduct.smul_tmul xbar0 a ((0 : R_node), (1 : R_node))]
        have hs1 : (xbar1 • a : A'') = 0 := ha1
        have hs0 : (xbar0 • a : A'') = 0 := ha0
        rw [hs1, hs0, TensorProduct.zero_tmul, TensorProduct.zero_tmul, add_zero]
      have hrid := congrArg (Algebra.TensorProduct.rid R_node A'' A'') h_tmul
      simp only [Algebra.TensorProduct.rid_tmul, map_zero] at hrid
      rw [one_smul R_node a] at hrid
      exact hrid
    have hJnode_inj : Function.Injective J_node.mulVecLin := by
      intro w₁ w₂ hw
      have h0 := congrFun hw 0
      have h1 := congrFun hw 1
      simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Finset.univ_unique,
        Fin.default_eq_zero, Fin.isValue, Finset.sum_singleton, Matrix.of_apply, ↓reduceIte,
        one_ne_zero, J_node] at h0 h1
      have hd1 : u₁ * (w₁ 0 - w₂ 0) = 0 := by linear_combination h0
      have hd0 : u₀ * (w₁ 0 - w₂ 0) = 0 := by linear_combination h1
      have hw0 : w₁ 0 = w₂ 0 := sub_eq_zero.mp (hA''_ann (w₁ 0 - w₂ 0) hd0 hd1)
      ext j; fin_cases j; exact hw0
    exact ⟨hqA_surj, hqA_ker, hJnode_inj, hA''_ann⟩
  
  have h_s3_part3 : ∀ (D_Ω A'' : Type u) [CommRing D_Ω] [CommRing A'']
      (φ₁ : D_Ω →+* A''), φ₁.Flat →
      ∀ (P : Ideal D_Ω) [P.IsPrime] (Q : Ideal A'') [Q.IsPrime],
        P = Ideal.comap φ₁ Q →
        ∀ (z : D_Ω), φ₁ z = 0 → algebraMap D_Ω (Localization.AtPrime P) z = 0 := by
    intro D_Ω A'' _ _ φ₁ hFlat₁ P _ Q _ hPQ z hz
    let f_loc : Localization.AtPrime P →+* Localization.AtPrime Q :=
      Localization.localRingHom P Q φ₁ hPQ
    have hFlat_loc : f_loc.Flat := RingHom.Flat.localRingHom hFlat₁ Q P hPQ
    have _ : IsLocalHom f_loc := Localization.isLocalHom_localRingHom P Q φ₁ hPQ
    let _ : Algebra (Localization.AtPrime P) (Localization.AtPrime Q) := f_loc.toAlgebra
    have _ : Module.Flat (Localization.AtPrime P) (Localization.AtPrime Q) :=
      RingHom.flat_algebraMap_iff.mp hFlat_loc
    have _ : IsLocalHom (algebraMap (Localization.AtPrime P) (Localization.AtPrime Q)) := ‹IsLocalHom f_loc›
    have _ : Module.FaithfullyFlat (Localization.AtPrime P) (Localization.AtPrime Q) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hinj : Function.Injective f_loc :=
      FaithfulSMul.algebraMap_injective (Localization.AtPrime P) (Localization.AtPrime Q)
    apply hinj
    rw [map_zero, Localization.localRingHom_to_map P Q φ₁ hPQ z, hz, map_zero]
  
  have h_s4 : ∀ (Ω : Type u) [Field Ω]
      (C_Ω : AlgebraicGeometry.Scheme.{u})
      (p_Ω : C_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)),
      (∀ y : ↥C_Ω,
        (∃ V_sm : C_Ω.Opens,
          y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Ω)) ∨
        (∃ (U_et : AlgebraicGeometry.Scheme.{u}) (u₀ : U_et)
            (e₁ : U_et ⟶ C_Ω)
            (e₂ : U_et ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
          e₁ ≫ p_Ω =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) →
      ∀ (D_Ω : Type u) [CommRing D_Ω] [Algebra Ω D_Ω]
        (ι_Ω : AlgebraicGeometry.Spec (CommRingCat.of D_Ω) ⟶ C_Ω)
        [AlgebraicGeometry.IsOpenImmersion ι_Ω],
        ι_Ω ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D_Ω)) →
        ∀ (x_Ω : Fin (k + 1) → D_Ω) (J_Ω : Matrix (Fin (k + 1)) (Fin k) D_Ω),
          Function.Surjective
            (Fintype.linearCombination D_Ω fun r : Fin (k + 1) => KaehlerDifferential.D Ω D_Ω (x_Ω r)) →
          LinearMap.ker
            (Fintype.linearCombination D_Ω fun r : Fin (k + 1) => KaehlerDifferential.D Ω D_Ω (x_Ω r)) =
            LinearMap.range J_Ω.mulVecLin →
          ∀ (z : D_Ω),
            (∀ r : Fin (k + 1), (-1) ^ (r : ℕ) * Matrix.det (J_Ω.submatrix r.succAbove id) * z = 0) →
            z = 0 := by
    intro Ω _ C_Ω p_Ω hDichot D_Ω _ _ ι_Ω _ hι_p x_Ω J_Ω hqΩ_surj hqΩ_ker z hz_ann
    have hetale_comp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g₀ : Y ⟶ Z),
        AlgebraicGeometry.Etale f → AlgebraicGeometry.Etale g₀ → AlgebraicGeometry.Etale (f ≫ g₀) := by
      intro X Y Z f g₀ hf hg₀
      rw [AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero] at hf hg₀ ⊢
      have hcomp := @AlgebraicGeometry.smoothOfRelativeDimension_comp 0 0 X Y f Z g₀ hf hg₀
      simpa using hcomp
    by_contra hz_ne
    let Δ_Ω : Fin (k + 1) → D_Ω := fun r =>
      (-1) ^ (r : ℕ) * Matrix.det (J_Ω.submatrix r.succAbove id)
    let I_ann : Ideal D_Ω := Submodule.colon ⊥ {z}
    have h_mem_ann : ∀ a : D_Ω, a ∈ I_ann ↔ a * z = 0 := by
      intro a; rw [Submodule.mem_colon_singleton]; simp [smul_eq_mul]
    have hI_ne_top : I_ann ≠ ⊤ := by
      intro htop
      have h1 : (1 : D_Ω) ∈ I_ann := htop ▸ Submodule.mem_top
      rw [h_mem_ann, one_mul] at h1
      exact hz_ne h1
    obtain ⟨𝔪, hMax, hI_le⟩ := Ideal.exists_le_maximal I_ann hI_ne_top
    have _ : 𝔪.IsPrime := hMax.isPrime
    have hz_loc : algebraMap D_Ω (Localization.AtPrime 𝔪) z ≠ 0 := by
      intro hzero
      rw [IsLocalization.map_eq_zero_iff 𝔪.primeCompl] at hzero
      obtain ⟨s, hs⟩ := hzero
      exact s.2 (hI_le ((h_mem_ann s.1).mpr hs))
    let q_y : ↥(AlgebraicGeometry.Spec (CommRingCat.of D_Ω)) := ⟨𝔪, inferInstance⟩
    let y : ↥C_Ω := ι_Ω.base q_y
    rcases hDichot y with ⟨V_sm, hy_sm, hSm_V⟩ | ⟨U_et, u₀, e₁, e₂, hEt₁, hEt₂, he₁_y, _, he_comm⟩
    · 
      let W_sm : (AlgebraicGeometry.Spec (CommRingCat.of D_Ω)).Opens :=
        (TopologicalSpace.Opens.map ι_Ω.base).obj V_sm
      have hq_W : q_y ∈ W_sm := hy_sm
      have hPb_sm := AlgebraicGeometry.isPullback_morphismRestrict ι_Ω V_sm
      have _ : AlgebraicGeometry.IsOpenImmersion (ι_Ω ∣_ V_sm) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_sm.flip inferInstance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 (ι_Ω ∣_ V_sm) := inferInstance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Ω) := hSm_V
      have hSm_comp := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 (ι_Ω ∣_ V_sm) (V_sm.ι ≫ p_Ω)
      let f_sm : W_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
        W_sm.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D_Ω))
      have hf_sm_eq : (ι_Ω ∣_ V_sm) ≫ (V_sm.ι ≫ p_Ω) = f_sm := by
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, hι_p]
      rw [Nat.zero_add, hf_sm_eq] at hSm_comp
      obtain ⟨U₀, _, V₀, hAffV₀, hq_V₀, e₀, hStd₀⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f_sm).mp hSm_comp ⟨q_y, hq_W⟩
      have hU₀_top : U₀ = ⊤ := by
        have hpt : f_sm.base ⟨q_y, hq_W⟩ ∈ U₀ := e₀ hq_V₀
        ext p
        simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hp : p = f_sm.base ⟨q_y, hq_W⟩ := Subsingleton.elim _ _
        rw [hp]; exact hpt
      subst hU₀_top
      let S₀ := ↑(W_sm.toScheme.presheaf.obj (Opposite.op V₀))
      let P₀_pt : PrimeSpectrum S₀ := hAffV₀.primeIdealOf ⟨⟨q_y, hq_W⟩, hq_V₀⟩
      have _ : Nontrivial S₀ := ⟨⟨0, 1, fun h01 => P₀_pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ P₀_pt.asIdeal.zero_mem (h01 ▸ isUnit_one))⟩⟩
      let g₀ : AlgebraicGeometry.Spec (CommRingCat.of S₀) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of D_Ω) := hAffV₀.fromSpec ≫ W_sm.ι
      have _ : AlgebraicGeometry.IsOpenImmersion g₀ := inferInstance
      have hEt_g₀ : AlgebraicGeometry.Etale g₀ :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero g₀).mpr inferInstance
      have hFlat_g₀ : AlgebraicGeometry.Flat g₀ := inferInstance
      let res_0 : D_Ω →+* S₀ := (AlgebraicGeometry.Spec.preimage g₀).hom
      have hmap_g₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_0) = g₀ :=
        AlgebraicGeometry.Spec.map_preimage g₀
      have hEt_res0 : res_0.Etale := by
        have hg₀' : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_0)) :=
          hmap_g₀.symm ▸ hEt_g₀
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hg₀'
      have hFlat_res0 : res_0.Flat := by
        have hg₀' : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_0)) :=
          hmap_g₀.symm ▸ hFlat_g₀
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp hg₀'
      have hcomap_P₀ : 𝔪 = Ideal.comap res_0 P₀_pt.asIdeal := by
        have hbase : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_0)).base P₀_pt = q_y := by
          rw [hmap_g₀]
          change W_sm.ι.base (hAffV₀.fromSpec.base P₀_pt) = q_y
          rw [hAffV₀.fromSpec_primeIdealOf]; rfl
        exact (congrArg PrimeSpectrum.asIdeal hbase).symm
      let _ : Algebra Ω S₀ := (res_0.comp (algebraMap Ω D_Ω)).toAlgebra
      let _ : Algebra D_Ω S₀ := res_0.toAlgebra
      have _ : IsScalarTower Ω D_Ω S₀ := IsScalarTower.of_algebraMap_eq' rfl
      let e_src : Ω ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.obj (Opposite.op ⊤)) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm.commRingCatIsoToRingEquiv
      have he_comm : (f_sm.appLE ⊤ V₀ e₀).hom.comp e_src.toRingHom = algebraMap Ω S₀ := by
        have hpre := hSpecPre f_sm hAffV₀
        have hg₀_comp : hAffV₀.fromSpec ≫ f_sm =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res_0.comp (algebraMap Ω D_Ω))) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hmap_g₀]
          dsimp [f_sm, g₀]
          rw [CategoryTheory.Category.assoc]
        rw [hg₀_comp, AlgebraicGeometry.Spec.preimage_map] at hpre
        exact hpre.symm
      have _ : Algebra.Etale D_Ω S₀ := RingHom.Etale.toAlgebra hEt_res0
      have _ : Algebra.FormallyEtale D_Ω S₀ := inferInstance
      have _ : Algebra.FormallyUnramified Ω Ω := inferInstance
      obtain ⟨hq1_surj, hq1_ker⟩ :=
        (hKaehler.2.2 Ω Ω D_Ω S₀).1 k x_Ω J_Ω hqΩ_surj hqΩ_ker
      obtain ⟨k₂, x₂, J₂, hq₂_surj, hq₂_ker, hInj_J₂, hUnit_J₂⟩ :=
        h_s3_part1 Ω S₀ _ (f_sm.appLE ⊤ V₀ e₀).hom hStd₀ e_src he_comm
      let q₁_S₀ := Fintype.linearCombination S₀ fun r : Fin (k + 1) =>
        KaehlerDifferential.D Ω S₀ (algebraMap D_Ω S₀ (x_Ω r))
      let q₂_S₀ := Fintype.linearCombination S₀ fun s : Fin (k₂ + 1) =>
        KaehlerDifferential.D Ω S₀ (x₂ s)
      obtain ⟨_, ψ₁, ψ₂, u_cr, hψ₁, hψ₂, hψ_eq⟩ :=
        hCramer S₀ (KaehlerDifferential Ω S₀) k k₂ (J_Ω.map (algebraMap D_Ω S₀)) q₁_S₀ J₂ q₂_S₀
          hq1_surj hq1_ker hq₂_surj hq₂_ker hInj_J₂
      classical
      let w₀ : Fin (k₂ + 1) → S₀ := Pi.single 0 1
      obtain ⟨v, hv⟩ := hq1_surj (q₂_S₀ w₀)
      have h_eval := congrArg (fun f : KaehlerDifferential Ω S₀ →ₗ[S₀] S₀ => f (q₂_S₀ w₀)) hψ_eq
      simp only [LinearMap.smul_apply, smul_eq_mul] at h_eval
      rw [← hv, hψ₁ v, hv, hψ₂ w₀] at h_eval
      have hsum_w₀ : (∑ s : Fin (k₂ + 1),
          w₀ s * (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) =
          Matrix.det (J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id) := by
        rw [Finset.sum_eq_single (0 : Fin (k₂ + 1))]
        · simp [w₀]
        · intro s _ hs; simp [w₀, Pi.single_eq_of_ne hs]
        · intro h0; exact (h0 (Finset.mem_univ 0)).elim
      rw [hsum_w₀] at h_eval
      obtain ⟨u_det, hu_det⟩ := hUnit_J₂
      have h_unit_z : (u_cr.val * u_det.val) * res_0 z = 0 := by
        rw [hu_det, ← h_eval, Finset.sum_mul]
        refine Finset.sum_eq_zero fun r _ => ?_
        have hdet_map : (-1) ^ (r : ℕ) * Matrix.det ((J_Ω.map (algebraMap D_Ω S₀)).submatrix r.succAbove id) =
            res_0 (Δ_Ω r) := by
          simp only [Δ_Ω, map_mul, map_pow, map_neg, map_one]
          congr 1
          change ((J_Ω.map res_0).submatrix r.succAbove id).det = res_0 (J_Ω.submatrix r.succAbove id).det
          have hsub : (J_Ω.map res_0).submatrix r.succAbove id =
              res_0.mapMatrix (J_Ω.submatrix r.succAbove id) := by ext i j; rfl
          rw [hsub, RingHom.map_det]
        calc v r * (-1) ^ (r : ℕ) * Matrix.det ((J_Ω.map (algebraMap D_Ω S₀)).submatrix r.succAbove id) * res_0 z
            = v r * ((-1) ^ (r : ℕ) * Matrix.det ((J_Ω.map (algebraMap D_Ω S₀)).submatrix r.succAbove id) * res_0 z) := by ring
          _ = v r * (res_0 (Δ_Ω r) * res_0 z) := by rw [hdet_map]
          _ = v r * res_0 (Δ_Ω r * z) := by rw [← map_mul]
          _ = 0 := by rw [hz_ann r, map_zero, mul_zero]
      have hres_z : res_0 z = 0 := by
        calc res_0 z
            = (u_det⁻¹.val * u_cr⁻¹.val) * ((u_cr.val * u_det.val) * res_0 z) := by
                calc res_0 z
                    = (u_det⁻¹.val * u_det.val) * ((u_cr⁻¹.val * u_cr.val) * res_0 z) := by
                        rw [Units.inv_mul, Units.inv_mul, one_mul, one_mul]
                  _ = (u_det⁻¹.val * u_cr⁻¹.val) * ((u_cr.val * u_det.val) * res_0 z) := by ring
          _ = 0 := by rw [h_unit_z, mul_zero]
      exact hz_loc (@h_s3_part3 D_Ω S₀ _ _ res_0 hFlat_res0 𝔪 _ P₀_pt.asIdeal P₀_pt.isPrime hcomap_P₀ z hres_z)
    · 
      let O_Ω : C_Ω.Opens := ι_Ω.opensRange
      let U_pre : U_et.Opens := (TopologicalSpace.Opens.map e₁.base).obj O_Ω
      have hu₀_pre : u₀ ∈ U_pre := by
        change e₁.base u₀ ∈ Set.range ι_Ω.base
        rw [he₁_y]; exact ⟨q_y, rfl⟩
      obtain ⟨U₁, hAffU₁, hu₀_U₁, hU₁_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_pre
      have hU₁_le : U₁ ≤ U_pre := hU₁_sub
      let A'' := ↑(U_et.presheaf.obj (Opposite.op U₁))
      let Q_pt : PrimeSpectrum A'' := hAffU₁.primeIdealOf ⟨u₀, hu₀_U₁⟩
      let iso_O : O_Ω.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of D_Ω) :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq O_Ω.ι ι_Ω Subtype.range_coe
      have hiso_O_ι : iso_O.hom ≫ ι_Ω = O_Ω.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac O_Ω.ι ι_Ω Subtype.range_coe
      let f₁_aff : AlgebraicGeometry.Spec (CommRingCat.of A'') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of D_Ω) :=
        hAffU₁.isoSpec.inv ≫ U_et.homOfLE hU₁_le ≫ (e₁ ∣_ O_Ω) ≫ iso_O.hom
      have hEt_res_e₁ : AlgebraicGeometry.Etale (e₁ ∣_ O_Ω) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict e₁ O_Ω).flip hEt₁
      have hEt_iso_inv : AlgebraicGeometry.Etale (hAffU₁.isoSpec.inv) :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero _).mpr inferInstance
      have hEt_homOfLE : AlgebraicGeometry.Etale (U_et.homOfLE hU₁_le) :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero _).mpr inferInstance
      have hEt_iso_O : AlgebraicGeometry.Etale iso_O.hom :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero _).mpr inferInstance
      have hEt_f₁ : AlgebraicGeometry.Etale f₁_aff :=
        hetale_comp _ _ hEt_iso_inv
          (hetale_comp _ _ hEt_homOfLE (hetale_comp _ _ hEt_res_e₁ hEt_iso_O))
      have _ : AlgebraicGeometry.Flat (e₁ ∣_ O_Ω) := inferInstance
      have hFlat_f₁ : AlgebraicGeometry.Flat f₁_aff := inferInstance
      have hf₁_ι : f₁_aff ≫ ι_Ω = hAffU₁.fromSpec ≫ e₁ := by
        calc (hAffU₁.isoSpec.inv ≫ U_et.homOfLE hU₁_le ≫ (e₁ ∣_ O_Ω) ≫ iso_O.hom) ≫ ι_Ω
            = hAffU₁.isoSpec.inv ≫ U_et.homOfLE hU₁_le ≫ (e₁ ∣_ O_Ω) ≫ (iso_O.hom ≫ ι_Ω) := by
                simp only [CategoryTheory.Category.assoc]
          _ = hAffU₁.isoSpec.inv ≫ U_et.homOfLE hU₁_le ≫ ((e₁ ∣_ O_Ω) ≫ O_Ω.ι) := by
                rw [hiso_O_ι]
          _ = hAffU₁.isoSpec.inv ≫ (U_et.homOfLE hU₁_le ≫ U_pre.ι) ≫ e₁ := by
                rw [AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
          _ = (hAffU₁.isoSpec.inv ≫ U₁.ι) ≫ e₁ := by
                rw [U_et.homOfLE_ι, CategoryTheory.Category.assoc]
          _ = hAffU₁.fromSpec ≫ e₁ := rfl
      let φ₁ : D_Ω →+* A'' := (AlgebraicGeometry.Spec.preimage f₁_aff).hom
      have hmap_f₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = f₁_aff :=
        AlgebraicGeometry.Spec.map_preimage f₁_aff
      have hEt_φ₁ : φ₁.Etale := by
        have hf₁' : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) :=
          hmap_f₁.symm ▸ hEt_f₁
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hf₁'
      have hFlat_φ₁ : φ₁.Flat := by
        have hf₁' : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) :=
          hmap_f₁.symm ▸ hFlat_f₁
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp hf₁'
      have hcomap_Q : 𝔪 = Ideal.comap φ₁ Q_pt.asIdeal := by
        have hbase : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)).base Q_pt = q_y := by
          rw [hmap_f₁]
          apply ι_Ω.isOpenEmbedding.injective
          change (f₁_aff ≫ ι_Ω).base Q_pt = y
          rw [hf₁_ι]
          change e₁.base (hAffU₁.fromSpec.base Q_pt) = y
          rw [hAffU₁.fromSpec_primeIdealOf]
          exact he₁_y
        exact (congrArg PrimeSpectrum.asIdeal hbase).symm
      let R_node := MvPolynomial (Fin 2) Ω ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))
      let f₂_aff : AlgebraicGeometry.Spec (CommRingCat.of A'') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R_node) := hAffU₁.fromSpec ≫ e₂
      have hEt_fromSpec : AlgebraicGeometry.Etale hAffU₁.fromSpec :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero _).mpr inferInstance
      have hEt_f₂ : AlgebraicGeometry.Etale f₂_aff := hetale_comp _ _ hEt_fromSpec hEt₂
      let φ₂ : R_node →+* A'' := (AlgebraicGeometry.Spec.preimage f₂_aff).hom
      have hmap_f₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) = f₂_aff :=
        AlgebraicGeometry.Spec.map_preimage f₂_aff
      have hEt_φ₂ : φ₂.Etale := by
        have hf₂' : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂)) :=
          hmap_f₂.symm ▸ hEt_f₂
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hf₂'
      let _ : Algebra Ω A'' := (φ₁.comp (algebraMap Ω D_Ω)).toAlgebra
      let _ : Algebra D_Ω A'' := φ₁.toAlgebra
      have _ : IsScalarTower Ω D_Ω A'' := IsScalarTower.of_algebraMap_eq' rfl
      have hφ₂_comm : φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap Ω A'' := by
        have hc1 : CommRingCat.ofHom (φ₂.comp ((Ideal.Quotient.mk
            (Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω)))).comp
            MvPolynomial.C)) =
            CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) ≫ CommRingCat.ofHom φ₂ := rfl
        have hc2 : CommRingCat.ofHom (φ₁.comp (algebraMap Ω D_Ω)) =
            CommRingCat.ofHom (algebraMap Ω D_Ω) ≫ CommRingCat.ofHom φ₁ := rfl
        have hspec : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.comp (algebraMap Ω D_Ω))) := by
          rw [hc1, AlgebraicGeometry.Spec.map_comp, hmap_f₂,
            hc2, AlgebraicGeometry.Spec.map_comp, hmap_f₁]
          dsimp only [f₂_aff]
          rw [CategoryTheory.Category.assoc, ← he_comm, ← CategoryTheory.Category.assoc,
            ← hf₁_ι, CategoryTheory.Category.assoc, hι_p]
        have hinj := AlgebraicGeometry.Spec.map_injective hspec
        ext c
        exact ConcreteCategory.congr_hom hinj c
      have _ : Algebra.Etale D_Ω A'' := RingHom.Etale.toAlgebra hEt_φ₁
      have _ : Algebra.FormallyEtale D_Ω A'' := inferInstance
      have _ : Algebra.FormallyUnramified Ω Ω := inferInstance
      obtain ⟨hq1_surj, hq1_ker⟩ :=
        (hKaehler.2.2 Ω Ω D_Ω A'').1 k x_Ω J_Ω hqΩ_surj hqΩ_ker
      obtain ⟨hqn_surj, hqn_ker, hJn_inj, hA''_ann⟩ := h_s3_part2 Ω A'' φ₂ hEt_φ₂ hφ₂_comm
      let u₀_el := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
      let u₁_el := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      let J_node : Matrix (Fin 2) (Fin 1) A'' := Matrix.of fun i _ => if i = 0 then u₁_el else u₀_el
      let q_node : (Fin 2 → A'') →ₗ[A''] KaehlerDifferential Ω A'' :=
        Fintype.linearCombination A'' fun i : Fin 2 =>
          KaehlerDifferential.D Ω A'' (if i = 0 then u₀_el else u₁_el)
      let q₁_A'' := Fintype.linearCombination A'' fun r : Fin (k + 1) =>
        KaehlerDifferential.D Ω A'' (algebraMap D_Ω A'' (x_Ω r))
      obtain ⟨_, ψ₁, ψ₂, u_cr, hψ₁, hψ₂, hψ_eq⟩ :=
        hCramer A'' (KaehlerDifferential Ω A'') k 1 (J_Ω.map (algebraMap D_Ω A'')) q₁_A''
          J_node q_node hq1_surj hq1_ker hqn_surj hqn_ker hJn_inj
      have hdet_map : ∀ r : Fin (k + 1),
          (-1) ^ (r : ℕ) * Matrix.det ((J_Ω.map (algebraMap D_Ω A'')).submatrix r.succAbove id) =
            φ₁ (Δ_Ω r) := by
        intro r
