        let π_O_κ : (O ⧸ m_O ^ (d + 2)) →ₗ[κ] (O ⧸ m_O ^ (d + 1)) := π_O.restrictScalars κ
        let e_kerO : ↥(LinearMap.ker π_O) ≃ₗ[κ] ↥(LinearMap.ker π_O_κ) :=
          { toFun := fun x => ⟨x.1, x.2⟩
            invFun := fun x => ⟨x.1, x.2⟩
