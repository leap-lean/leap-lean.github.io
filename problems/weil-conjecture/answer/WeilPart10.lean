        letI : IsDomain ↑(E_sm.presheaf.obj (Opposite.op (U_et i))) :=
          (hAffChartProps (U_et i) (hAff_et i) (hNe_et i)).1
        letI : IsDomain (Localization.AtPrime p_i.asIdeal) :=
          IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors p_i.asIdeal)
        let e_i_rng : Localization.AtPrime p_i.asIdeal ≃+* ↥θ_i.range :=
          RingEquiv.ofBijective θ_i.rangeRestrict
            ⟨fun a b h => hθi_inj (congrArg Subtype.val h), θ_i.rangeRestrict_surjective⟩
        let e_W_rng : Localization.AtPrime p.asIdeal ≃+* ↥θ_W.range :=
          RingEquiv.ofBijective θ_W.rangeRestrict
            ⟨fun a b h => hθW_inj (congrArg Subtype.val h), θ_W.rangeRestrict_surjective⟩
        let e_loc : Localization.AtPrime p_i.asIdeal ≃+* Localization.AtPrime p.asIdeal :=
          e_i_rng.trans ((RingEquiv.subringCongr hRngEq.symm).trans e_W_rng.symm)
        have hp_i_ne : p_i.asIdeal ≠ ⊥ := by
          intro hbot_i
          obtain ⟨x, hx_p, hx_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp_ne
          have hφx_ne : φ_W.hom x ≠ 0 :=
            fun h0 => hx_ne (((hAffChartProps W hW hW_ne).2.2.2 φ_W hSpecW).2.1
              (h0.trans (map_zero _).symm))
          have hinv_in_i : (φ_W.hom x)⁻¹ ∈ θ_i.range := by
            rw [hθi_rng]
            letI : Algebra ↑(E_sm.presheaf.obj (Opposite.op (U_et i))) F := (φ_et i).hom.toAlgebra
            letI : IsFractionRing ↑(E_sm.presheaf.obj (Opposite.op (U_et i))) F := hFrac_et i
            obtain ⟨a, b, hb_nzd, hab⟩ := IsFractionRing.div_surjective
              (A := ↑(E_sm.presheaf.obj (Opposite.op (U_et i)))) (φ_W.hom x)⁻¹
            have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
            refine ⟨a, b, ?_, ?_⟩
            · rw [hbot_i, Ideal.mem_bot]; exact hb_ne
            · have hφb_ne : (φ_et i).hom b ≠ 0 :=
                fun h0 => hb_ne (((hAffChartProps (U_et i) (hAff_et i) (hNe_et i)).2.2.2
                  (φ_et i) (hSpec_et i)).2.1 (h0.trans (map_zero _).symm))
              change (φ_et i).hom a / (φ_et i).hom b = (φ_W.hom x)⁻¹ at hab
              rw [← hab, mul_div_cancel₀ _ hφb_ne]
          rw [← hRngEq] at hinv_in_i
          obtain ⟨z_inv, hz_inv⟩ := hinv_in_i
          have hprod1 : θ_W (algebraMap _ _ x * z_inv) = θ_W 1 := by
            rw [map_mul, hθW_alg, hz_inv, mul_inv_cancel₀ hφx_ne, map_one]
          have hunit_x : IsUnit (algebraMap _ (Localization.AtPrime p.asIdeal) x) :=
            isUnit_iff_exists_inv.mpr ⟨z_inv, hθW_inj hprod1⟩
          exact (IsLocalRing.notMem_maximalIdeal.mpr hunit_x)
            ((IsLocalization.AtPrime.to_map_mem_maximal_iff _ p.asIdeal x).mpr hx_p)
        have _ : IsDiscreteValuationRing (Localization.AtPrime p_i.asIdeal) :=
          ((hChartEtDVR i).2 p_i.asIdeal hp_i_ne).2.1
        exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e_loc
      have hMax_of_ne_bot : ∀ (W : E_sm.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
          (hW_ne : Nonempty ↥W) (p : PrimeSpectrum ↑(E_sm.presheaf.obj (Opposite.op W))),
          p.asIdeal ≠ ⊥ → p.asIdeal.IsMaximal := by
        intro W hW hW_ne p hp_ne
        obtain ⟨𝔪, h𝔪_max, hp_le_𝔪⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
        have h𝔪_ne : 𝔪 ≠ ⊥ := fun h0 => hp_ne (le_bot_iff.mp (h0 ▸ hp_le_𝔪))
        have _ : 𝔪.IsPrime := h𝔪_max.isPrime
        letI : IsDomain ↑(E_sm.presheaf.obj (Opposite.op W)) := (hAffChartProps W hW hW_ne).1
        have hNoethW : IsNoetherianRing ↑(E_sm.presheaf.obj (Opposite.op W)) :=
          (hAffChartProps W hW hW_ne).2.1
        let B := Localization.AtPrime 𝔪
        have _ : IsNoetherianRing B := IsLocalization.isNoetherianRing 𝔪.primeCompl B hNoethW
        letI : IsDomain B :=
