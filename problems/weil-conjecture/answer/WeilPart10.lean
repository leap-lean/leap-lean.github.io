          (CategoryTheory.Iso.refl _) e_S.toCommRingCatIso ?_ ?_ ?_ ?_
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro r
          exact heR_C r
        · rfl
        · apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            change e_S (Polynomial.map φ (Polynomial.C r)) =
              HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a) (e_R (Polynomial.C r))
            rw [Polynomial.map_C, heS_C (φ r), heR_C r]
            apply HomogeneousLocalization.val_injective
              (Submonoid.powers (f_gr (MvPolynomial.X a)))
            rw [hval_fromZero S _ _, halg0 S (φ r)]
            change Localization.mk (MvPolynomial.C (φ r)) 1 =
              (HomogeneousLocalization.map f_gr _
                (HomogeneousLocalization.mk _)).val
            rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
            congr 1
            · change MvPolynomial.C (φ r) = MvPolynomial.map φ ((algebraMap R ↥(𝒜_R 0) r : ↥(𝒜_R 0)).1)
              rw [halg0 R r, MvPolynomial.map_C]
            · apply Subtype.ext
              exact (map_one f_gr.toRingHom).symm
          · change e_S (Polynomial.map φ Polynomial.X) =
              HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a) (e_R Polynomial.X)
            rw [Polynomial.map_X, heS_X, heR_X]
            apply HomogeneousLocalization.val_injective
              (Submonoid.powers (f_gr (MvPolynomial.X a)))
            rw [HomogeneousLocalization.Away.val_mk]
            change Localization.mk (MvPolynomial.X (1 - a)) _ =
