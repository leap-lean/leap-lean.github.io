      have h₂₃_sub : h₂₃_a = h₂₃_b := Subsingleton.elim _ _
      subst h₂₃_sub

      let u₃_cat : CommRingCat.of M₁ ⟶ (mkF B₁).obj j₃ := u₂_cat ≫ (mkF B₁).map h₂₃_a
      let v₃_cat : CommRingCat.of B₁ ⟶ (mkF M₁).obj j₃ := v₂_cat ≫ (mkF M₁).map h₂₃_a
      have hu₃_comm : f_M ≫ u₃_cat = (mkAlpha B₁).app j₃ := by
        rw [← Category.assoc, hu₂_comm, ← (mkAlpha B₁).naturality]; simp
      have hv₃_comm : f_B ≫ v₃_cat = (mkAlpha M₁).app j₃ := by
        rw [← Category.assoc, hv₂_comm, ← (mkAlpha M₁).naturality]; simp
      have hu₃_eq : u₃_cat ≫ (mkC B₁).ι.app j₃ = g_fwd := by
