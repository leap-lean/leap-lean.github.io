    exact ⟨hConn_YΩ, hSmNod_YΩ, fun i => (hIntAndExcl i).1, hPair_FΩ, hIrredComp_YΩ⟩

  · 
    intro i
    dsimp only
    intro hNotP1_Bgen Ω _ _ s_B E_sch ιE hClE hIntE hRangeE hP1_Esch
    let s_B_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
    have hs_B_gen_eq : s_B_gen ≫ f₁_B = s₁_gen := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
