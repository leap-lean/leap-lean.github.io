        _ = z * (φ_P (MvPolynomial.C u) * φ_P g.1) := by ring
    calc ψ_loc (IsLocalization.mk' R_loc N₀ ⟨D₀, hD₀_mem⟩)
        = (ψ_loc (IsLocalization.mk' R_loc N₀ ⟨D₀, hD₀_mem⟩) * uP.val) * (↑uP⁻¹ : P) := by
            rw [mul_assoc, Units.mul_inv, mul_one]
      _ = (z * uP.val) * (↑uP⁻¹ : P) := by
            rw [huP]
            exact congr_arg (· * (↑uP⁻¹ : P)) h_eq_mul
      _ = z := by rw [mul_assoc, Units.mul_inv, mul_one]
  let K_loc : Ideal R_loc := Ideal.map φ_loc K₀
