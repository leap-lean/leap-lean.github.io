      obtain ⟨a_num, b_den, ha_not, hb_not, hab_eq⟩ := hUnitDesc y_rat hy_in_R hy_inv_R
      refine ⟨a_num, b_den, ha_not, hb_not, ?_⟩
      have hy_mul : y_rat * φ_a.hom t_P =
          Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P)) :=
        div_mul_cancel₀ _ hφtP_ne
      calc φ_a.hom b_den * Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P))
          = (φ_a.hom b_den * y_rat) * φ_a.hom t_P := by rw [← hy_mul, mul_assoc]
        _ = φ_a.hom a_num * φ_a.hom t_P := by rw [hab_eq]
    · 
      have hx_not_node : (ν α).base P ∉ Set.range z_node := by
        rw [← hτ_eq]
        exact (hMark j q).2
      exact (hSmoothCase hx_not_node).2 ⟨j, q, hτ_eq⟩

theorem weil_algClosed_smooth_curve_local_dvr_and_kaehler (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (E_sm : AlgebraicGeometry.Scheme.{u})
    (p_sm : E_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (hInt : AlgebraicGeometry.IsIntegral E_sm)
    (hProp : AlgebraicGeometry.IsProper p_sm)
    (hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_sm)
    (F : Type u) [Field F] [Algebra Ω F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ E_sm)
    (hη_comm : η_F ≫ p_sm = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω F)))
    (hFunc : IsSchemeFunctionField E_sm F η_F) :
    ∃ (ord : E_sm → F → WithTop ℤ) (x_sep : F) (K_div : E_sm → ℤ),
      IsSmoothCurveLocalValuationPackage Ω E_sm p_sm F η_F ord x_sep K_div :=
by
  
  have hs4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra Ω R]
      [Algebra R F] [IsScalarTower Ω R F] [IsFractionRing R F]
      (ψ : Polynomial Ω →ₐ[Ω] R), ψ.toRingHom.Etale →
      let t_ψ : F := algebraMap R F (ψ Polynomial.X)
      (Transcendental Ω t_ψ ∧ KaehlerDifferential.D Ω F t_ψ ≠ 0) ∧
      (∀ f : F, KaehlerDifferential.D Ω F f ≠ 0 →
        Transcendental Ω f ∧
        let Lf := IntermediateField.adjoin Ω ({f} : Set F)
        FiniteDimensional ↥Lf F ∧ Algebra.IsSeparable ↥Lf F) ∧
      (∃ der_ψ : Derivation Ω F F,
        der_ψ t_ψ = 1 ∧
        (∀ r : R, der_ψ (algebraMap R F r) ∈ Set.range (algebraMap R F)) ∧
        (∀ g : F, KaehlerDifferential.D Ω F g = der_ψ g • KaehlerDifferential.D Ω F t_ψ)) ∧
      (∀ (q : Ideal R) [q.IsPrime], q ≠ ⊥ →
        q.IsMaximal ∧
        IsDiscreteValuationRing (Localization.AtPrime q) ∧
        (∀ r : R, ∃ c : Ω, r - algebraMap Ω R c ∈ q) ∧
        ∃ c_q : Ω, ψ (Polynomial.X - Polynomial.C c_q) ∈ q ∧
          ψ (Polynomial.X - Polynomial.C c_q) ∉ q ^ 2) := by
    intro R _ _ _ _ _ _ ψ hEt t_ψ
    let P := Polynomial Ω
    let _ : Algebra P R := ψ.toRingHom.toAlgebra
    have hTowerΩPR : IsScalarTower Ω P R := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      change algebraMap Ω R c = ψ (Polynomial.C c)
      rw [← Polynomial.algebraMap_eq, ψ.commutes]
    let φ_PF : P →+* F := (algebraMap R F).comp ψ.toRingHom
    let _ : Algebra P F := φ_PF.toAlgebra
    have hTowerPRF : IsScalarTower P R F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hTowerΩPF : IsScalarTower Ω P F := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      change algebraMap Ω F c = algebraMap R F (ψ (Polynomial.C c))
      rw [← Polynomial.algebraMap_eq, ψ.commutes, ← IsScalarTower.algebraMap_apply Ω R F]
    have hEtAlg : Algebra.Etale P R := (RingHom.etale_algebraMap (R := P) (S := R)).mp hEt
    have hFlatPR : Module.Flat P R := inferInstance
    have hinj_ψ : Function.Injective ψ := by
      intro p₁ p₂ hp
      by_contra hne
      have hp_sub : p₁ - p₂ ≠ 0 := sub_ne_zero.mpr hne
      have hmul_inj : Function.Injective (LinearMap.mulLeft P (p₁ - p₂)) :=
        mul_right_injective₀ hp_sub
      have hlTensor_inj := Module.Flat.lTensor_preserves_injective_linearMap
        (M := R) (LinearMap.mulLeft P (p₁ - p₂)) hmul_inj
      have hzero : (LinearMap.mulLeft P (p₁ - p₂)).lTensor R ((1 : R) ⊗ₜ[P] (1 : P)) = 0 := by
        rw [LinearMap.lTensor_tmul]
        change (1 : R) ⊗ₜ[P] ((p₁ - p₂) • (1 : P)) = 0
        rw [← TensorProduct.smul_tmul]
        have hsmul : (p₁ - p₂) • (1 : R) = 0 := by
          change ψ (p₁ - p₂) * 1 = 0
          rw [mul_one, map_sub, hp, sub_self]
        rw [hsmul, TensorProduct.zero_tmul]
      have hone_zero : (1 : R) ⊗ₜ[P] (1 : P) = 0 :=
        hlTensor_inj (hzero.trans (map_zero _).symm)
      have h1 : (1 : R) = 0 := by
        have := congrArg (TensorProduct.AlgebraTensorModule.rid P R R) hone_zero
        simp at this
      exact one_ne_zero h1
    have hinj_RF : Function.Injective (algebraMap R F) := IsFractionRing.injective R F
    have haeval_eq : Polynomial.aeval t_ψ = (IsScalarTower.toAlgHom Ω R F).comp ψ := by
      ext
      simp [t_ψ]
    have hTrans_t : Transcendental Ω t_ψ := by
      rintro ⟨p, hp_ne, h_ev⟩
      apply hp_ne
      apply hinj_ψ
      apply hinj_RF
      have h1 : (Polynomial.aeval t_ψ) p = 0 := h_ev
      rw [haeval_eq] at h1
      simpa using h1
    have hmon_eq : ∀ (n : ℕ) (a : Ω),
        Polynomial.monomial n a = Polynomial.C a * Polynomial.X ^ n := by
      intro n a
      ext k
      simp [Polynomial.coeff_monomial, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs with h1 h2 <;> simp_all
    have hFT_ΩP : Algebra.FiniteType Ω P := by
      refine ⟨⟨{Polynomial.X}, ?_⟩⟩
      rw [eq_top_iff]
      intro p _
      refine Polynomial.induction_on' p
        (fun p₁ p₂ hp₁ hp₂ => Subalgebra.add_mem _ hp₁ hp₂) fun n a => ?_
      rw [hmon_eq]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a)
        (Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) n)
    have hFT_PR : Algebra.FiniteType P R := inferInstance
    have hFT_ΩR : Algebra.FiniteType Ω R := Algebra.FiniteType.trans hFT_ΩP hFT_PR
    have hNoethR : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing Ω R
    have hEss_ΩR : Algebra.EssFiniteType Ω R := Algebra.EssFiniteType.of_finiteType Ω R
    have hEss_RF : Algebra.EssFiniteType R F :=
      Algebra.EssFiniteType.of_isLocalization F (nonZeroDivisors R)
    have hEss_ΩF : Algebra.EssFiniteType Ω F := Algebra.EssFiniteType.comp Ω R F
    have hFE_PR : Algebra.FormallyEtale P R := Algebra.Etale.formallyEtale
    have hFE_RF : Algebra.FormallyEtale R F :=
      Algebra.FormallyEtale.of_isLocalization (nonZeroDivisors R)
    have hFE_PF : Algebra.FormallyEtale P F := Algebra.FormallyEtale.comp P R F
    have hbR : IsBaseChange R (KaehlerDifferential.map Ω Ω P R) :=
      KaehlerDifferential.isBaseChange_of_formallyEtale Ω P R
    have hbF : IsBaseChange F (KaehlerDifferential.map Ω Ω P F) :=
      KaehlerDifferential.isBaseChange_of_formallyEtale Ω P F
    let e_R : Ω[R⁄Ω] ≃ₗ[R] R :=
      hbR.equiv.symm.trans
        (((KaehlerDifferential.polynomialEquiv Ω).baseChange P R _ _).trans
          (TensorProduct.AlgebraTensorModule.rid P R R))
    let e_F : Ω[F⁄Ω] ≃ₗ[F] F :=
      hbF.equiv.symm.trans
        (((KaehlerDifferential.polynomialEquiv Ω).baseChange P F _ _).trans
          (TensorProduct.AlgebraTensorModule.rid P F F))
    have heR_t : e_R (KaehlerDifferential.D Ω R (ψ Polynomial.X)) = 1 := by
      have hmap : KaehlerDifferential.D Ω R (ψ Polynomial.X) =
          KaehlerDifferential.map Ω Ω P R (KaehlerDifferential.D Ω P Polynomial.X) := by
        symm
        exact KaehlerDifferential.map_D Ω Ω P R Polynomial.X
      rw [hmap]
      dsimp [e_R]
      rw [hbR.equiv_symm_apply]
      simp only [LinearEquiv.baseChange_tmul, TensorProduct.AlgebraTensorModule.rid_tmul]
      change (KaehlerDifferential.polynomialEquiv Ω)
        (KaehlerDifferential.D Ω (Polynomial Ω) Polynomial.X) • (1 : R) = 1
      rw [KaehlerDifferential.polynomialEquiv_D, Polynomial.derivative_X, one_smul]
    have heF_t : e_F (KaehlerDifferential.D Ω F t_ψ) = 1 := by
      have hmap : KaehlerDifferential.D Ω F t_ψ =
          KaehlerDifferential.map Ω Ω P F (KaehlerDifferential.D Ω P Polynomial.X) := by
        symm
        exact KaehlerDifferential.map_D Ω Ω P F Polynomial.X
      rw [hmap]
      dsimp [e_F]
      rw [hbF.equiv_symm_apply]
      simp only [LinearEquiv.baseChange_tmul, TensorProduct.AlgebraTensorModule.rid_tmul]
      change (KaehlerDifferential.polynomialEquiv Ω)
        (KaehlerDifferential.D Ω (Polynomial Ω) Polynomial.X) • (1 : F) = 1
      rw [KaehlerDifferential.polynomialEquiv_D, Polynomial.derivative_X, one_smul]
    have hDt_ne : KaehlerDifferential.D Ω F t_ψ ≠ 0 := by
      intro h0
      have := congrArg e_F h0
      rw [heF_t, map_zero] at this
      exact one_ne_zero this
    let der_R : Derivation Ω R R := e_R.toLinearMap.compDer (KaehlerDifferential.D Ω R)
    let der_ψ : Derivation Ω F F := e_F.toLinearMap.compDer (KaehlerDifferential.D Ω F)
    have hder_t : der_ψ t_ψ = 1 := heF_t
    have hD_eq : ∀ g : F, KaehlerDifferential.D Ω F g = der_ψ g • KaehlerDifferential.D Ω F t_ψ := by
      intro g
      apply e_F.injective
      rw [map_smul, heF_t, smul_eq_mul, mul_one]
      rfl
    have hder_range : ∀ r : R, der_ψ (algebraMap R F r) ∈ Set.range (algebraMap R F) := by
      let δ₁ : Derivation Ω R F := (Algebra.linearMap R F).compDer der_R
      let δ₂ : Derivation Ω R F := der_ψ.compAlgebraMap R
      have hδ_P : ∀ p : P, δ₁ (ψ p) = δ₂ (ψ p) := by
        intro p
        refine Polynomial.induction_on' p (fun p₁ p₂ hp₁ hp₂ => by simp [hp₁, hp₂]) fun n a => ?_
        rw [hmon_eq, map_mul, map_pow]
        have hδ₁_X : δ₁ (ψ Polynomial.X) = 1 := by
          change algebraMap R F (e_R (KaehlerDifferential.D Ω R (ψ Polynomial.X))) = 1
          rw [heR_t, map_one]
        have hδ₂_X : δ₂ (ψ Polynomial.X) = 1 := hder_t
        have hC_smul : ψ (Polynomial.C a) * ψ Polynomial.X ^ n = a • (ψ Polynomial.X ^ n) := by
          rw [← Polynomial.algebraMap_eq, ψ.commutes, Algebra.smul_def]
        rw [hC_smul, δ₁.map_smul, δ₂.map_smul, δ₁.leibniz_pow, δ₂.leibniz_pow, hδ₁_X, hδ₂_X]
      let δ_diff : Derivation P R F :=
        { toLinearMap :=
            { toFun := fun r => δ₁ r - δ₂ r
              map_add' := fun x y => by simp [sub_add_sub_comm]
              map_smul' := fun p r => by
                change δ₁ (ψ p * r) - δ₂ (ψ p * r) = algebraMap P F p * (δ₁ r - δ₂ r)
                rw [δ₁.leibniz, δ₂.leibniz, hδ_P p]
                change (ψ p • δ₁ r + r • δ₂ (ψ p)) - (ψ p • δ₂ r + r • δ₂ (ψ p)) =
                  algebraMap R F (ψ p) * (δ₁ r - δ₂ r)
                simp only [Algebra.smul_def]
                ring }
          map_one_eq_zero' := by simp
          leibniz' := fun x y => by
            change δ₁ (x * y) - δ₂ (x * y) = x • (δ₁ y - δ₂ y) + y • (δ₁ x - δ₂ x)
            rw [δ₁.leibniz, δ₂.leibniz]
            simp only [Algebra.smul_def]
            ring }
      have hSub_RP : Subsingleton Ω[R⁄P] := inferInstance
      have hδ_zero : ∀ r : R, δ_diff r = 0 := by
        intro r
        rw [← δ_diff.liftKaehlerDifferential_comp_D]
        have h0 : KaehlerDifferential.D P R r = 0 := Subsingleton.elim _ _
        rw [h0, map_zero]
      intro r
      exact ⟨der_R r, sub_eq_zero.mp (hδ_zero r)⟩
    have hKaehlerSep : ∀ f : F, KaehlerDifferential.D Ω F f ≠ 0 →
        Transcendental Ω f ∧
        let Lf := IntermediateField.adjoin Ω ({f} : Set F)
        FiniteDimensional ↥Lf F ∧ Algebra.IsSeparable ↥Lf F := by
      intro f hf
      have hTrans_f : Transcendental Ω f := by
        by_contra hNotTrans
        have hAlg_f : IsAlgebraic Ω f := by
          simpa [Transcendental] using hNotTrans
        have hInt_f : IsIntegral Ω f := isAlgebraic_iff_isIntegral.mp hAlg_f
        let K_f := IntermediateField.adjoin Ω ({f} : Set F)
        have hFin_Kf : FiniteDimensional Ω ↥K_f :=
          IntermediateField.finiteDimensional_adjoin (by rintro _ rfl; exact hInt_f)
        have hInt_Kf : Algebra.IsIntegral Ω ↥K_f := Algebra.IsIntegral.of_finite Ω ↥K_f
        have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := ↥K_f)
        obtain ⟨c, hc⟩ := hbij.2 ⟨f, IntermediateField.mem_adjoin_simple_self Ω f⟩
        have hf_eq : f = algebraMap Ω F c := (congrArg Subtype.val hc).symm
        rw [hf_eq, Derivation.map_algebraMap] at hf
        exact hf rfl
      refine ⟨hTrans_f, ?_⟩
      intro Lf
      have hEss_LfF : Algebra.EssFiniteType ↥Lf F := Algebra.EssFiniteType.of_comp Ω ↥Lf F
      have hderf_ne : der_ψ f ≠ 0 := by
        intro h0
        apply hf
        rw [hD_eq f, h0, zero_smul]
      have hCompat : LinearMap.CompatibleSMul F Ω[F⁄↥Lf] Ω ↥Lf :=
        { map_smul := fun f_l c x => by
            have hcx : c • x = (algebraMap Ω ↥Lf c) • x := by
              rw [Algebra.smul_def, Algebra.smul_def, ← IsScalarTower.algebraMap_apply Ω ↥Lf F]
            rw [hcx, f_l.map_smul,
              ← IsScalarTower.algebraMap_smul F (algebraMap Ω ↥Lf c) (f_l x),
              ← IsScalarTower.algebraMap_apply Ω ↥Lf F,
              IsScalarTower.algebraMap_smul F c (f_l x)] }
      let d_rel : Derivation Ω F Ω[F⁄↥Lf] := (KaehlerDifferential.D ↥Lf F).restrictScalars Ω
      have hd_rel_f : d_rel f = 0 := by
        have hf_mem : f ∈ Lf := IntermediateField.mem_adjoin_simple_self Ω f
        change KaehlerDifferential.D ↥Lf F (algebraMap ↥Lf F ⟨f, hf_mem⟩) = 0
        exact Derivation.map_algebraMap _ _
      have hd_rel_all : ∀ y : F, KaehlerDifferential.D ↥Lf F y = 0 := by
        intro y
        have hy_D : KaehlerDifferential.D Ω F y = (der_ψ y * (der_ψ f)⁻¹) • KaehlerDifferential.D Ω F f := by
          rw [hD_eq y, hD_eq f, smul_smul, mul_assoc, inv_mul_cancel₀ hderf_ne, mul_one]
        have := congrArg d_rel.liftKaehlerDifferential hy_D
        rw [Derivation.liftKaehlerDifferential_comp_D, map_smul,
          Derivation.liftKaehlerDifferential_comp_D, hd_rel_f, smul_zero] at this
        exact this
      have hSub_Lf : Subsingleton Ω[F⁄↥Lf] := by
        have hle_bot : (⊤ : Submodule F Ω[F⁄↥Lf]) ≤ ⊥ := by
          rw [← KaehlerDifferential.span_range_derivation ↥Lf F, Submodule.span_le]
          rintro _ ⟨y, rfl⟩
          simp only [SetLike.mem_coe, Submodule.mem_bot]
          exact hd_rel_all y
        refine ⟨fun a b => ?_⟩
        have ha : a = 0 := by simpa only [Submodule.mem_bot] using hle_bot (Submodule.mem_top : a ∈ ⊤)
        have hb : b = 0 := by simpa only [Submodule.mem_bot] using hle_bot (Submodule.mem_top : b ∈ ⊤)
        exact ha.trans hb.symm
      have hUnram : Algebra.FormallyUnramified ↥Lf F :=
        (Algebra.formallyUnramified_iff ↥Lf F).mpr hSub_Lf
      have hSep : Algebra.IsSeparable ↥Lf F := Algebra.FormallyUnramified.isSeparable ↥Lf F
      obtain ⟨s_R, hs_R⟩ := hFT_ΩR
      classical
      let S_F : Finset F := s_R.image (algebraMap R F)
      have hFin_adj : FiniteDimensional ↥Lf ↥(IntermediateField.adjoin ↥Lf (↑S_F : Set F)) :=
        IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsSeparable.isIntegral ↥Lf x
      have hAdj_top : IntermediateField.adjoin ↥Lf (↑S_F : Set F) = ⊤ := by
        rw [eq_top_iff]
        intro z _
        obtain ⟨a, b, hb_nzd, rfl⟩ := IsFractionRing.div_surjective (A := R) z
        let K_sub := IntermediateField.adjoin ↥Lf (↑S_F : Set F)
        have hR_in_K : ∀ r : R, algebraMap R F r ∈ K_sub := by
          intro r
          have hr : r ∈ Algebra.adjoin Ω (↑s_R : Set R) := by rw [hs_R]; trivial
          refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hr
          · intro x hx
            exact IntermediateField.subset_adjoin ↥Lf (↑S_F : Set F)
              (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx))
          · intro c
            rw [← IsScalarTower.algebraMap_apply Ω R F, IsScalarTower.algebraMap_apply Ω ↥Lf F]
            exact K_sub.algebraMap_mem _
          · intro x y _ _ hx hy
            rw [map_add]
            exact K_sub.add_mem hx hy
          · intro x y _ _ hx hy
            rw [map_mul]
            exact K_sub.mul_mem hx hy
        exact K_sub.div_mem (hR_in_K a) (hR_in_K b)
      have hFin_F : FiniteDimensional ↥Lf F := by
        rw [hAdj_top] at hFin_adj
        exact Module.Finite.equiv IntermediateField.topEquiv.toLinearEquiv
      exact ⟨hFin_F, hSep⟩
    have hDVR_claim : ∀ (q : Ideal R) [q.IsPrime], q ≠ ⊥ →
        q.IsMaximal ∧
        IsDiscreteValuationRing (Localization.AtPrime q) ∧
        (∀ r : R, ∃ c : Ω, r - algebraMap Ω R c ∈ q) ∧
        ∃ c_q : Ω, ψ (Polynomial.X - Polynomial.C c_q) ∈ q ∧
          ψ (Polynomial.X - Polynomial.C c_q) ∉ q ^ 2 := by
      intro q _ hq_ne_bot
      let L₀ := IntermediateField.adjoin Ω ({t_ψ} : Set F)
      obtain ⟨_, hFinL₀, hSepL₀⟩ := hKaehlerSep t_ψ hDt_ne
      let p₀ : Ideal P := q.comap ψ.toRingHom
      have hp₀_prime : p₀.IsPrime := Ideal.IsPrime.comap ψ.toRingHom
      have hp₀_ne_bot : p₀ ≠ ⊥ := by
        obtain ⟨r, hr_q, hr_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq_ne_bot
        let y : F := algebraMap R F r
        have hy_ne : y ≠ 0 := fun h => hr_ne (hinj_RF (h.trans (map_zero _).symm))
        have hy_int : IsIntegral ↥L₀ y := Algebra.IsSeparable.isIntegral ↥L₀ y
        obtain ⟨Q₀, hQ₀_monic, hQ₀_eval⟩ := hy_int
        have h_coeff : ∀ i ≤ Q₀.natDegree, ∃ a b : P, b ≠ 0 ∧
            algebraMap ↥L₀ F (Q₀.coeff i) * φ_PF b = φ_PF a := by
          intro i _
          obtain ⟨a, b, h_ab⟩ :=
            (IntermediateField.mem_adjoin_simple_iff Ω _).mp (Q₀.coeff i).2
          by_cases hb0 : Polynomial.aeval t_ψ b = 0
          · rw [hb0, div_zero] at h_ab
            refine ⟨0, 1, one_ne_zero, ?_⟩
            change ((Q₀.coeff i : F)) * φ_PF 1 = φ_PF 0
            rw [h_ab, map_zero, zero_mul]
          · have hb_ne : b ≠ 0 := fun h => hb0 (by rw [h, map_zero])
            refine ⟨a, b, hb_ne, ?_⟩
            change ((Q₀.coeff i : F)) * φ_PF b = φ_PF a
            have ha : φ_PF a = Polynomial.aeval t_ψ a := by rw [haeval_eq]; rfl
            have hb : φ_PF b = Polynomial.aeval t_ψ b := by rw [haeval_eq]; rfl
            rw [ha, hb, h_ab, div_mul_cancel₀ _ hb0]
        choose a_P b_P hb_P h_abP using fun i : Fin (Q₀.natDegree + 1) =>
          h_coeff i.1 (Nat.lt_succ_iff.mp i.2)
        let B_prod : P := ∏ i : Fin (Q₀.natDegree + 1), b_P i
        have hB_ne : B_prod ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hb_P i
        let c_P : Fin (Q₀.natDegree + 1) → P := fun i =>
          a_P i * ∏ j ∈ Finset.univ.erase i, b_P j
        let Q : Polynomial P := ∑ i : Fin (Q₀.natDegree + 1), Polynomial.monomial i.1 (c_P i)
        have hQ_lead : Q.coeff Q₀.natDegree = c_P ⟨Q₀.natDegree, Nat.lt_succ_self _⟩ := by
          simp only [Q, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
          rw [Finset.sum_eq_single ⟨Q₀.natDegree, Nat.lt_succ_self _⟩]
          · simp
          · intro j _ hj
            have hj_ne : j.1 ≠ Q₀.natDegree := fun h => hj (Fin.ext h)
            simp [hj_ne]
          · intro h; exact absurd (Finset.mem_univ _) h
        have hQ_ne : Q ≠ 0 := by
          intro hQ0
          have hlead0 := congrArg (fun p => p.coeff Q₀.natDegree) hQ0
          rw [hQ_lead, Polynomial.coeff_zero] at hlead0
          let i_top : Fin (Q₀.natDegree + 1) := ⟨Q₀.natDegree, Nat.lt_succ_self _⟩
          have hmon : Q₀.coeff Q₀.natDegree = 1 := hQ₀_monic.coeff_natDegree
          have htop_eq := h_abP i_top
          change algebraMap ↥L₀ F (Q₀.coeff Q₀.natDegree) * φ_PF (b_P i_top) = φ_PF (a_P i_top) at htop_eq
          rw [hmon, map_one, one_mul] at htop_eq
          have hinj_PF : Function.Injective φ_PF := hinj_RF.comp hinj_ψ
          have ha_eq_b : a_P i_top = b_P i_top := hinj_PF htop_eq.symm
          have hc_eq_B : c_P i_top = B_prod := by
            dsimp [c_P, B_prod]
            rw [ha_eq_b, Finset.mul_prod_erase _ _ (Finset.mem_univ i_top)]
          rw [hc_eq_B] at hlead0
          exact hB_ne hlead0
        have hQ_eval : Polynomial.aeval y Q = 0 := by
          dsimp [Q]
          rw [map_sum]
          have h_term : ∀ i : Fin (Q₀.natDegree + 1),
              Polynomial.aeval y (Polynomial.monomial i.1 (c_P i)) =
                φ_PF B_prod * (algebraMap ↥L₀ F (Q₀.coeff i.1) * y ^ i.1) := by
            intro i
            rw [Polynomial.aeval_monomial]
            dsimp [c_P]
            have hB_split : B_prod = b_P i * ∏ j ∈ Finset.univ.erase i, b_P j :=
              (Finset.mul_prod_erase _ _ (Finset.mem_univ i)).symm
            rw [hB_split, map_mul, map_mul]
            change φ_PF (a_P i) * φ_PF (∏ j ∈ Finset.univ.erase i, b_P j) * y ^ i.1 =
              (φ_PF (b_P i) * φ_PF (∏ j ∈ Finset.univ.erase i, b_P j)) *
                (algebraMap ↥L₀ F (Q₀.coeff i.1) * y ^ i.1)
            rw [← h_abP i]
            ring
          simp_rw [h_term, ← Finset.mul_sum]
          have hsum0 : (∑ i : Fin (Q₀.natDegree + 1),
              algebraMap ↥L₀ F (Q₀.coeff i.1) * y ^ i.1) = 0 := by
            rw [Fin.sum_univ_eq_sum_range (fun k => algebraMap ↥L₀ F (Q₀.coeff k) * y ^ k)
              (Q₀.natDegree + 1)]
            simpa [Polynomial.eval₂_eq_sum_range] using hQ₀_eval
          rw [hsum0, mul_zero]
        let k := Q.natTrailingDegree
        have h_dvd : Polynomial.X ^ k ∣ Q := by
          rw [Polynomial.X_pow_dvd_iff]
          intro j hj
          exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree hj
        obtain ⟨Q₁, hQ_eq⟩ := h_dvd
        have hQ₁_0 : Q₁.coeff 0 = Q.trailingCoeff := by
          calc Q₁.coeff 0
              = (Polynomial.X ^ k * Q₁).coeff (0 + k) := (Polynomial.coeff_X_pow_mul Q₁ k 0).symm
            _ = Q.coeff k := by rw [← hQ_eq, zero_add]
            _ = Q.trailingCoeff := rfl
        have hQ₁_0_ne : Q₁.coeff 0 ≠ 0 := by
          rw [hQ₁_0]
          exact Polynomial.trailingCoeff_nonzero_iff_nonzero.mpr hQ_ne
        rw [hQ_eq, map_mul, map_pow, Polynomial.aeval_X] at hQ_eval
        have hQ₁_evalF : Polynomial.aeval y Q₁ = 0 :=
          (mul_eq_zero.mp hQ_eval).resolve_left (pow_ne_zero k hy_ne)
        have hQ₁_evalR : Polynomial.eval₂ ψ.toRingHom r Q₁ = 0 := by
          apply hinj_RF
          rw [map_zero]
          have : algebraMap R F (Polynomial.eval₂ ψ.toRingHom r Q₁) = Polynomial.aeval y Q₁ := by
            rw [Polynomial.hom_eval₂]
            rfl
          rw [this, hQ₁_evalF]
        have h_mod_q := congrArg (Ideal.Quotient.mk q) hQ₁_evalR
        rw [map_zero, Polynomial.hom_eval₂, Ideal.Quotient.eq_zero_iff_mem.mpr hr_q,
          Polynomial.eval₂_at_zero] at h_mod_q
        change Ideal.Quotient.mk q (ψ (Q₁.coeff 0)) = 0 at h_mod_q
        have h_in_q : ψ (Q₁.coeff 0) ∈ q := Ideal.Quotient.eq_zero_iff_mem.mp h_mod_q
        have h_in_p₀ : Q₁.coeff 0 ∈ p₀ := h_in_q
        intro hp0_bot
        rw [hp0_bot, Ideal.mem_bot] at h_in_p₀
        exact hQ₁_0_ne h_in_p₀
      have hp₀_max : p₀.IsMaximal := hp₀_prime.isMaximal hp₀_ne_bot
      obtain ⟨g_p, hg_p⟩ := IsPrincipalIdealRing.principal p₀
      have hg_ne : g_p ≠ 0 := by
        intro hg0
        apply hp₀_ne_bot
        rw [hg_p, Submodule.span_singleton_eq_bot.mpr hg0]
      have hg_deg_ne : g_p.degree ≠ 0 := by
        intro hdeg0
        have hc_eq := Polynomial.eq_C_of_degree_eq_zero hdeg0
        let c := g_p.coeff 0
        have hc_ne : c ≠ 0 := fun hc0 => hg_ne (by rw [hc_eq]; simp [c, hc0])
        have hunit : IsUnit (g_p : P) := by
          rw [hc_eq]
          exact IsUnit.map Polynomial.C hc_ne.isUnit
        apply hp₀_max.ne_top
        rw [hg_p, Ideal.submodule_span_eq, Ideal.span_singleton_eq_top.mpr hunit]
      obtain ⟨c_q, hc_root⟩ := IsAlgClosed.exists_root g_p hg_deg_ne
