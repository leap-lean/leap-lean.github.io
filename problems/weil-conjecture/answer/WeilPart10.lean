      obtain ⟨hFl_V, hUn_V, hEFT_V⟩ := hTransBr _ ψ_br₁ hFT_1 hFlat_1 hUnram_1
      have hComp_V : ψ_br_V.comp (((ν α).app V).hom) =
          (Ideal.Quotient.mk
