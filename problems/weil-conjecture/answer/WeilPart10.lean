          (Polynomial.C (c_err j) * Polynomial.X ^ (n + 1) +
            ∑ r : Fin k, Polynomial.C (M₀ r j) * (Polynomial.C (δ r) * Polynomial.X ^ (n + 1))) := by
        simp only [sub_mul, Finset.sum_sub_distrib]
        ring
      rw [hTotal_eq, hT4_eq, add_zero]
      exact dvd_add (dvd_add hT1 hT2) hT3
