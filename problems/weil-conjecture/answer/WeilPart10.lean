      change iSup U = ⊤ at hU_top
      intro w hNotUniv
      have hw_top : w ∈ (⊤ : P_Ω.Opens) := trivial
      rw [← hU_top, TopologicalSpace.Opens.mem_iSup] at hw_top
      obtain ⟨a, hwa⟩ := hw_top
      have hwa_range : w ∈ Set.range (ι a).base := by rwa [hι_range a]
      obtain ⟨q, hq⟩ := hwa_range
      have hq_ne_bot : q.asIdeal ≠ ⊥ := by
        intro hq_bot
        have hUa_sub : (U a : Set ↥P_Ω) ⊆ closure ({w} : Set ↥P_Ω) := by
          rw [← hι_range a]
          rintro _ ⟨q', rfl⟩
          have hq'_cl : q' ∈ closure ({q} : Set ↥(AlgebraicGeometry.Spec
              (CommRingCat.of (Polynomial Ω)))) := by
