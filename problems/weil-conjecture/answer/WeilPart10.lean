    let U : Fin 2 → P_Ω.Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)
    obtain ⟨hU_top, hU_iso⟩ := hChart Ω
    choose iso_chart hiso_inv _ using hU_iso
    let ι : Fin 2 → (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω)) ⟶ P_Ω) :=
      fun a => (iso_chart a).inv ≫ (U a).ι
    have hOpen_ι : ∀ a : Fin 2, AlgebraicGeometry.IsOpenImmersion (ι a) :=
      fun a => inferInstance
    have hι_hom : ∀ a : Fin 2,
        ι a ≫ p_Ω =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.C : Ω →+* Polynomial Ω)) := by
      intro a
      dsimp only [ι]
      rw [CategoryTheory.Category.assoc]
      exact hiso_inv a
    have hι_range : ∀ a : Fin 2, Set.range (ι a).base = (U a : Set ↥P_Ω) := by
      intro a
