theorem weil_algClosed_nodal_curve_normalization_and_log_bundle (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (M : WeilLineBundle C)
    (hLog : IsGeometricFiberLogCanonical g n τ M) :
    ∃ (c δ : ℕ)
      (E_set : Fin (c + 1) → Set C)
      (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
      (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
      (F : Fin (c + 1) → Type u)
      (instFieldF : ∀ α : Fin (c + 1), Field (F α))
      (instAlgF : ∀ α : Fin (c + 1), Algebra Ω (F α))
      (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
      (z_node : Fin δ → C)
      (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
      (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r)),
      letI := instFieldF
      letI := instAlgF
      IsNodalCurveLogNormalizationPackage g n τ M c δ E_set E_norm p_norm ν F η_F
        z_node α₀ P₀ α₁ P₁ :=
by
  obtain ⟨c, δ, E_set, E_norm, p_norm, ν, F, instFieldF, instAlgF, η_F,
      z_node, pt_C, pt_E, hPreNorm⟩ :=
    weil_algClosed_stable_curve_nodes_components_and_normalization Ω C g n τ hStab
      (fun A _ _ _ _ K _ _ _ =>
        weil_algClosed_finiteType_domain_integralClosure_finite Ω A K)
      (fun A _ _ _ _ _ hDimA p _ hp =>
        weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one Ω 1 A hDimA p hp)
  letI : ∀ α : Fin (c + 1), Field (F α) := instFieldF
  letI : ∀ α : Fin (c + 1), Algebra Ω (F α) := instAlgF
  obtain ⟨α₀, P₀, α₁, P₁, hBranch⟩ :=
    weil_algClosed_nodal_etale_branch_pinching_and_cotangent Ω C g n τ hStab
      c δ E_set E_norm p_norm ν F η_F z_node pt_C pt_E hPreNorm
  rcases hPreNorm with ⟨⟨_hSepC, _hRedC⟩, hComp, hNorm,
      ⟨hz_inj, hz_closed_nsm, hSmCompl, hInterSub, hMark⟩,
      hProdInj, hPtC, hPtE, hSmLoc, hSmCot, hGenLoc, hNormDVR⟩
  rcases hBranch with ⟨hClImm, hNodeFib, hPinch, hNodeCot, hBrDVR⟩
  obtain ⟨hAff, ψ_log, hOv, hSmMark, hEtNode⟩ := hLog
  
  have hProp_g : AlgebraicGeometry.IsProper g := hStab.2.2.1
  have _ : AlgebraicGeometry.IsSeparated g := inferInstance
  have hAff_ov : ∀ a b : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a ⊓ M.V b) := by
    intro a b
    have _ : AlgebraicGeometry.IsAffine (M.V a).toScheme := hAff a
    have _ : AlgebraicGeometry.IsAffineHom ((M.V a).ι ≫ g) :=
      AlgebraicGeometry.isAffineHom_of_isAffine ((M.V a).ι ≫ g)
    have _ : AlgebraicGeometry.IsAffineHom (M.V a).ι :=
      AlgebraicGeometry.IsAffineHom.of_comp (M.V a).ι g
    have hpre : AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map (M.V a).ι.base).obj (M.V b)) :=
      (hAff b).preimage (M.V a).ι
    have himg : AlgebraicGeometry.IsAffineOpen
        ((M.V a).ι ''ᵁ ((TopologicalSpace.Opens.map (M.V a).ι.base).obj (M.V b))) :=
      hpre.image_of_isOpenImmersion (M.V a).ι
    convert himg using 1
    ext x
    exact ⟨fun ⟨hxA, hxB⟩ => ⟨⟨x, hxA⟩, hxB, rfl⟩,
      fun ⟨y, hyB, hyx⟩ => ⟨hyx ▸ y.2, hyx ▸ hyB⟩⟩
  have hAffHom_ν : ∀ α : Fin (c + 1), AlgebraicGeometry.IsAffineHom (ν α) := by
    intro α
    have _ : AlgebraicGeometry.IsFinite (ν α) := (hNorm α).2.2.2.1
    infer_instance
  have hAffW : ∀ (α : Fin (c + 1)) (a : Fin M.m),
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)) := by
    intro α a
    have _ := hAffHom_ν α
    exact (hAff a).preimage (ν α)
  have hAffW_ov : ∀ (α : Fin (c + 1)) (a b : Fin M.m),
      AlgebraicGeometry.IsAffineOpen
        ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a ⊓ M.V b)) := by
    intro α a b
    have _ := hAffHom_ν α
    exact (hAff_ov a b).preimage (ν α)
  
  have hPhiUnique : ∀ (α : Fin (c + 1)) (W : (E_norm α).Opens)
      (hW : AlgebraicGeometry.IsAffineOpen W)
      (φ₁ φ₂ : (E_norm α).presheaf.obj (Opposite.op W) ⟶ CommRingCat.of (F α)),
      AlgebraicGeometry.Spec.map φ₁ ≫ hW.fromSpec = η_F α →
      AlgebraicGeometry.Spec.map φ₂ ≫ hW.fromSpec = η_F α →
      φ₁ = φ₂ := by
    intro α W hW φ₁ φ₂ h₁ h₂
    exact AlgebraicGeometry.Spec.map_injective ((cancel_mono hW.fromSpec).mp (h₁.trans h₂.symm))
  have hMakeLift : ∀ (S T : Type u) [CommRing S] [Field T] [Algebra Ω S] [Algebra Ω T]
      (θ : S →+* T),
      (∀ c : Ω, θ (algebraMap Ω S c) = algebraMap Ω T c) →
      (letI : Algebra S T := θ.toAlgebra
       letI : (RingHom.ker θ).IsPrime := RingHom.ker_isPrime θ
       IsLocalization (RingHom.ker θ).primeCompl T) →
      ∀ (ψ : KaehlerDifferential Ω S →ₗ[S] S),
        ∃ L : KaehlerDifferential Ω T →ₗ[T] T,
          ∀ x : S, L (KaehlerDifferential.D Ω T (θ x)) = θ (ψ (KaehlerDifferential.D Ω S x)) := by
    intro S T _ _ _ _ θ hAlgEq hLoc ψ
    letI : Algebra S T := θ.toAlgebra
    letI : (RingHom.ker θ).IsPrime := RingHom.ker_isPrime θ
    haveI : IsScalarTower Ω S T := IsScalarTower.of_algebraMap_eq fun c => (hAlgEq c).symm
    haveI : IsLocalization (RingHom.ker θ).primeCompl T := hLoc
    let f₀ : KaehlerDifferential Ω S →ₗ[S] T :=
      { toFun := fun ω => θ (ψ ω)
        map_add' := fun x y => by simp [map_add]
        map_smul' := fun s x => by
          simp only [LinearMap.map_smul, RingHom.id_apply]
          change θ (s * ψ x) = θ s * θ (ψ x)
          exact map_mul θ s (ψ x) }
    have hUnit : ∀ x : ↥(RingHom.ker θ).primeCompl,
        IsUnit ((algebraMap S (Module.End S T)) ↑x) := by
      rintro ⟨s, hs⟩
      have hs_ne : θ s ≠ 0 := hs
      refine isUnit_iff_exists.mpr ⟨LinearMap.mulLeft S (θ s)⁻¹, ?_, ?_⟩
      · ext y
        change θ s * ((θ s)⁻¹ * y) = y
        rw [← mul_assoc, mul_inv_cancel₀ hs_ne, one_mul]
      · ext y
        change (θ s)⁻¹ * (θ s * y) = y
        rw [← mul_assoc, inv_mul_cancel₀ hs_ne, one_mul]
    haveI : IsLocalizedModule (RingHom.ker θ).primeCompl (KaehlerDifferential.map Ω Ω S T) :=
      KaehlerDifferential.isLocalizedModule_map Ω S T (RingHom.ker θ).primeCompl
    let L_S : KaehlerDifferential Ω T →ₗ[S] T :=
      IsLocalizedModule.lift (RingHom.ker θ).primeCompl (KaehlerDifferential.map Ω Ω S T) f₀ hUnit
    refine ⟨{
      toFun := L_S
      map_add' := L_S.map_add
      map_smul' := fun z ω => by
        simp only [RingHom.id_apply, smul_eq_mul]
        obtain ⟨⟨b, s⟩, hzs⟩ := IsLocalization.surj (RingHom.ker θ).primeCompl z
        have hs_ne : θ (s : S) ≠ 0 := s.2
        apply mul_left_cancel₀ hs_ne
        have h1 : θ (s : S) * L_S (z • ω) = L_S ((s : S) • (z • ω)) :=
          (L_S.map_smul (s : S) (z • ω)).symm
        rw [h1]
        have h2 : (s : S) • (z • ω) = (b : S) • ω := by
          change (algebraMap S T (s : S)) • (z • ω) = (algebraMap S T b) • ω
          rw [smul_smul, mul_comm, hzs]
        rw [h2, L_S.map_smul]
        change θ b * L_S ω = θ (s : S) * (z * L_S ω)
        have hzs' : θ b = z * θ (s : S) := hzs.symm
        rw [hzs']
        ring }, fun x => ?_⟩
    change L_S (KaehlerDifferential.D Ω T (algebraMap S T x)) = f₀ (KaehlerDifferential.D Ω S x)
    rw [← KaehlerDifferential.map_D Ω Ω S T x]
    exact IsLocalizedModule.lift_apply (RingHom.ker θ).primeCompl
      (KaehlerDifferential.map Ω Ω S T) f₀ hUnit (KaehlerDifferential.D Ω S x)
  have hLiftUnique : ∀ (S T : Type u) [CommRing S] [Field T] [Algebra Ω T]
      (θ : S →+* T),
      (letI : Algebra S T := θ.toAlgebra
       letI : (RingHom.ker θ).IsPrime := RingHom.ker_isPrime θ
       IsLocalization (RingHom.ker θ).primeCompl T) →
      ∀ (L₁ L₂ : KaehlerDifferential Ω T →ₗ[T] T),
        (∀ x : S, L₁ (KaehlerDifferential.D Ω T (θ x)) = L₂ (KaehlerDifferential.D Ω T (θ x))) →
        ∀ ω : KaehlerDifferential Ω T, L₁ ω = L₂ ω := by
    intro S T _ _ _ θ hLoc L₁ L₂ hEqD ω
    letI : Algebra S T := θ.toAlgebra
    letI : (RingHom.ker θ).IsPrime := RingHom.ker_isPrime θ
    haveI : IsLocalization (RingHom.ker θ).primeCompl T := hLoc
    have hOnD : ∀ z : T, L₁ (KaehlerDifferential.D Ω T z) = L₂ (KaehlerDifferential.D Ω T z) := by
      intro z
      obtain ⟨⟨b, s⟩, hzs⟩ := IsLocalization.surj (RingHom.ker θ).primeCompl z
      have hs_ne : θ (s : S) ≠ 0 := s.2
      have hzs' : z * θ (s : S) = θ b := hzs
      have hleib : KaehlerDifferential.D Ω T (θ b) =
          z • KaehlerDifferential.D Ω T (θ (s : S)) +
            θ (s : S) • KaehlerDifferential.D Ω T z := by
        rw [← hzs', Derivation.leibniz]
      have h₁ := congrArg L₁ hleib
      have h₂ := congrArg L₂ hleib
      simp only [map_add, LinearMap.map_smul, smul_eq_mul] at h₁ h₂
      rw [hEqD b, hEqD (s : S)] at h₁
      apply mul_left_cancel₀ hs_ne
      linear_combination h₂ - h₁
    have hmem : ω ∈ (⊤ : Submodule T (KaehlerDifferential Ω T)) := Submodule.mem_top
    rw [← KaehlerDifferential.span_range_derivation Ω T] at hmem
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hmem
    · rintro _ ⟨z, rfl⟩
      exact hOnD z
    · simp
    · intro u v _ _ hu hv
      simp [hu, hv]
    · intro z u _ hu
      simp [hu]
  
  have hExΨ : ∀ (α : Fin (c + 1)) (a : Fin M.m)
      (ha : Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))),
      ∃ Ψ : KaehlerDifferential Ω (F α) →ₗ[F α] F α,
        ∀ (φ_a : (E_norm α).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a))) ⟶
              CommRingCat.of (F α)),
          AlgebraicGeometry.Spec.map φ_a ≫ (hAffW α a).fromSpec = η_F α →
          ∀ x : ↑(C.presheaf.obj (Opposite.op (M.V a))),
            letI : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                g.appLE ⊤ (M.V a) (fun _ _ => trivial)).hom).toAlgebra
            Ψ (KaehlerDifferential.D Ω (F α) (φ_a.hom (((ν α).app (M.V a)).hom x))) =
              φ_a.hom (((ν α).app (M.V a)).hom (ψ_log a (KaehlerDifferential.D Ω _ x))) := by
    intro α a ha
    obtain ⟨φ₀, _hFrac₀, hSpec₀⟩ :=
      (hNorm α).2.2.2.2.2.2.2.2 _ (hAffW α a) ha
    letI : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ (M.V a) (fun _ _ => trivial)).hom).toAlgebra
    obtain ⟨hLoc₀, hAlg₀⟩ := hGenLoc (M.V a) (hAff a) α (hAffW α a) ha φ₀ hSpec₀
    obtain ⟨Ψ, hΨ⟩ := hMakeLift ↑(C.presheaf.obj (Opposite.op (M.V a))) (F α)
      (φ₀.hom.comp (((ν α).app (M.V a)).hom)) hAlg₀ hLoc₀ (ψ_log a)
    refine ⟨Ψ, fun φ_a hSpec_a x => ?_⟩
    have hEqPhi : φ_a = φ₀ := hPhiUnique α _ (hAffW α a) φ_a φ₀ hSpec_a hSpec₀
    subst hEqPhi
    exact hΨ x
  choose Ψ_log hΨ_log using hExΨ
  
  refine ⟨c, δ, E_set, E_norm, p_norm, ν, F, instFieldF, instAlgF, η_F,
    z_node, α₀, P₀, α₁, P₁, ?_⟩
  refine ⟨hComp, hNorm, hClImm,
    ⟨hz_inj, fun r => ⟨(hz_closed_nsm r).1, hNodeFib r⟩, hSmCompl, hInterSub, hMark⟩,
    hProdInj, hAff, hAffW, hAffW_ov, pt_C, pt_E, ?_, hPtE, ?_, ?_, ?_, Ψ_log, ?_, ?_⟩
  · 
    intro x hx
    exact ⟨(hPtC x hx).1, (hPtC x hx).2.1,
      fun a p_x h_in hp_x => (hPtC x hx).2.2 (M.V a) (hAff a) p_x h_in hp_x⟩
  · 
    intro a s_tilde hAgree
    exact hPinch (M.V a) (hAff a) s_tilde hAgree
  · 
    intro a p_x α p_P b
    exact hSmCot (M.V a) (hAff a) (fun β => hAffW β a) p_x α p_P b
  · 
    intro a p_x r p₀ p₁ b₀ b₁ hp_x hp₀ hp₁ hb₀_0 hb₀_0s hb₀_1s hb₁_0s hb₁_1 hb₁_1s
    exact hNodeCot (M.V a) (hAff a) (fun β => hAffW β a) p_x r p₀ p₁ b₀ b₁
      hp_x hp₀ hp₁ hb₀_0 hb₀_0s hb₀_1s hb₁_0s hb₁_1 hb₁_1s
  · 
    intro α a b ha hb φ_ab hSpec_ab ω
    have hab : Nonempty ↥((TopologicalSpace.Opens.map (ν α).base).obj (M.V a ⊓ M.V b)) := by
      obtain ⟨m₀, hm₀⟩ := Ideal.exists_maximal (F α)
      let q₀ : PrimeSpectrum (F α) := ⟨m₀, hm₀.isPrime⟩
      let p₀ := (AlgebraicGeometry.Spec.map φ_ab).base q₀
      have hp₀ : p₀ ∈ (⊤ : (AlgebraicGeometry.Spec _).Opens) := trivial
      rw [← (hAffW_ov α a b).fromSpec_preimage_self] at hp₀
      exact ⟨⟨(hAffW_ov α a b).fromSpec.base p₀, hp₀⟩⟩
    letI algA : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a))) :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ (M.V a) (fun _ _ => trivial)).hom).toAlgebra
    letI algB : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V b))) :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ (M.V b) (fun _ _ => trivial)).hom).toAlgebra
    letI algAB : Algebra Ω ↑(C.presheaf.obj (Opposite.op (M.V a ⊓ M.V b))) :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ (M.V a ⊓ M.V b) (fun _ _ => trivial)).hom).toAlgebra
    obtain ⟨ψ_ov, hψ_ov_a, hψ_ov_b⟩ := hOv a b
    obtain ⟨hLoc_ab, hAlg_ab⟩ :=
      hGenLoc (M.V a ⊓ M.V b) (hAff_ov a b) α (hAffW_ov α a b) hab φ_ab hSpec_ab
    obtain ⟨Ψ_ov, hΨ_ov⟩ :=
      hMakeLift ↑(C.presheaf.obj (Opposite.op (M.V a ⊓ M.V b))) (F α)
        (φ_ab.hom.comp (((ν α).app (M.V a ⊓ M.V b)).hom)) hAlg_ab hLoc_ab ψ_ov
    
    let hle_a : ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a ⊓ M.V b)) ≤
        ((TopologicalSpace.Opens.map (ν α).base).obj (M.V a)) :=
