    let V_S : Fin 2 → P_S.Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_S (f_gr (MvPolynomial.X a))
    have hVS_top : iSup V_S = ⊤ := by
      have hUS_top := AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_S MvPolynomial.X (hDehom S).1
      have hEq : V_S = fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_S (MvPolynomial.X a) := by
