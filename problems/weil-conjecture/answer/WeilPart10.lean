      let ψ_br_V := ψ_br₀.comp (res_W1 α)
      obtain ⟨hFl_V, hUn_V, hEFT_V⟩ := hTransBr _ ψ_br₀ hFT_0 hFlat_0 hUnram_0
      have hComp_V : ψ_br_V.comp (((ν α).app V).hom) =
          (Ideal.Quotient.mk
            (Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))})).comp φ₁_V := by
        ext b
