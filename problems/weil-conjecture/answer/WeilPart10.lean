      exact hMutInv g₂ g₁ (U₂ b) (M₂.V b) (k₂ b) (π₂ b) (F₂ b) (t₂ b)
        (U₁ a) (M₁.V a) (k₁ a) (π₁ a) (F₁ a) (t₁ a) ρ φ.symm hSymm.1
        (β R' ρ φ b a).val (α R' ρ φ a b).val h_ba
        (hP₂.1 b a).2 (hP₁.1 a b).2
  · intro R' R'' _ _ _ _ ρ' ρ'' ψ _ u' u'' C₁' C₂' C₁'' C₂''
      φ' φ'' w₁ w₂ h_over' h_sec' h_over'' h_sec'' hw₁_fst hw₁_snd hw₂_fst _ hw_φ a b h_w
    let fst₁' := CategoryTheory.Limits.pullback.fst g₁ u'
    let snd₁' := CategoryTheory.Limits.pullback.snd g₁ u'
    let fst₂' := CategoryTheory.Limits.pullback.fst g₂ u'
    let fst₁'' := CategoryTheory.Limits.pullback.fst g₁ u''
    let snd₁'' := CategoryTheory.Limits.pullback.snd g₁ u''
    let fst₂'' := CategoryTheory.Limits.pullback.fst g₂ u''
    let W' : C₁'.Opens := (TopologicalSpace.Opens.map fst₁'.base).obj (M₁.V a) ⊓
      (TopologicalSpace.Opens.map (φ'.hom ≫ fst₂').base).obj (M₂.V b)
    let W'' : C₁''.Opens := (TopologicalSpace.Opens.map fst₁''.base).obj (M₁.V a) ⊓
      (TopologicalSpace.Opens.map (φ''.hom ≫ fst₂'').base).obj (M₂.V b)
    obtain ⟨_, δ'₁, δ'₂, hδ'₁, hδ'₂, hEq'⟩ := (hα_props R' ρ' φ' h_over' h_sec').1 a b
    obtain ⟨_, δ''₁, δ''₂, hδ''₁, hδ''₂, hEq''⟩ := (hα_props R'' ρ'' φ'' h_over'' h_sec'').1 a b
    have hw₁_B : w₁ ≫ (φ'.hom ≫ fst₂') = φ''.hom ≫ fst₂'' := by
      rw [← CategoryTheory.Category.assoc, hw_φ, CategoryTheory.Category.assoc, hw₂_fst]
    have hNat₁ := hNat (U₁ a) (M₁.V a) (k₁ a) (π₁ a) (F₁ a) (t₁ a) ψ
      snd₁' fst₁' snd₁'' fst₁'' w₁ hw₁_fst hw₁_snd W' inf_le_left W'' inf_le_left h_w
      δ'₁ δ''₁ hδ'₁ hδ''₁
    have hNat₂ := hNat (U₂ b) (M₂.V b) (k₂ b) (π₂ b) (F₂ b) (t₂ b) ψ
      snd₁' (φ'.hom ≫ fst₂') snd₁'' (φ''.hom ≫ fst₂'') w₁ hw₁_B hw₁_snd
      W' inf_le_right W'' inf_le_right h_w δ'₂ δ''₂ hδ'₂ hδ''₂
    let f_w : ↑(C₁'.presheaf.obj (Opposite.op W')) →+* ↑(C₁''.presheaf.obj (Opposite.op W'')) :=
      (w₁.appLE W' W'' h_w).hom
    let α'_W'' := (C₁''.presheaf.map (CategoryTheory.homOfLE h_w).op).hom
      ((w₁.app W').hom (α R' ρ' φ' a b).val)
    have hα'_eq : f_w (α R' ρ' φ' a b).val = α'_W'' := rfl
    have hGen : ∀ s : Fin (k₂ b + 1),
        δ''₂ (((φ''.hom ≫ fst₂'').appLE (M₂.V b) W'' inf_le_right).hom (π₂ b (MvPolynomial.X s))) *
          ((α R'' ρ'' φ'' a b).val - α'_W'') = 0 := by
      intro s
      let y_s : ↑(C₁'.presheaf.obj (Opposite.op W')) :=
        ((φ'.hom ≫ fst₂').appLE (M₂.V b) W' inf_le_right).hom (π₂ b (MvPolynomial.X s))
      let x_s : ↑(C₁''.presheaf.obj (Opposite.op W'')) :=
        ((φ''.hom ≫ fst₂'').appLE (M₂.V b) W'' inf_le_right).hom (π₂ b (MvPolynomial.X s))
      have hyx : f_w y_s = x_s := by
        have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE w₁ (φ'.hom ≫ fst₂')
          (M₂.V b) W' W'' inf_le_right h_w
        exact ConcreteCategory.congr_hom
          (hcomp.trans (happLE_congr hw₁_B (M₂.V b) W'' _ inf_le_right))
          (π₂ b (MvPolynomial.X s))
      have hRel : δ''₁ x_s = α'_W'' * δ''₂ x_s := by
        calc δ''₁ x_s
            = δ''₁ (f_w y_s) := by rw [hyx]
          _ = f_w (δ'₁ y_s) := hNat₁ y_s
          _ = f_w ((α R' ρ' φ' a b).val * δ'₂ y_s) := by rw [hEq']
          _ = α'_W'' * f_w (δ'₂ y_s) := by rw [f_w.map_mul, hα'_eq]
          _ = α'_W'' * δ''₂ x_s := by rw [← hNat₂ y_s, hyx]
      have hEq''_s := hEq'' x_s
      rw [hRel] at hEq''_s
      calc δ''₂ x_s * ((α R'' ρ'' φ'' a b).val - α'_W'')
          = (α R'' ρ'' φ'' a b).val * δ''₂ x_s - α'_W'' * δ''₂ x_s := by ring
        _ = 0 := sub_eq_zero.mpr hEq''_s.symm
    let _ : Algebra R'' ↑(C₁''.presheaf.obj (Opposite.op W'')) :=
      ((snd₁''.appLE ⊤ W'' (fun _ _ => trivial)).hom.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R'')).inv.hom).toAlgebra
    obtain ⟨ψ''₂, hψ''₂_D, _, hψ''₂_span, hψ''₂_ann⟩ := hδ''₂
    have hZero : (α R'' ρ'' φ'' a b).val - α'_W'' = 0 := by
      apply hψ''₂_ann
      intro d''
      obtain ⟨v, hv⟩ := hψ''₂_span (KaehlerDifferential.D R'' _ d'')
      rw [hψ''₂_D d'', hv, map_sum, Finset.sum_mul]
      refine Finset.sum_eq_zero fun s _ => ?_
      rw [LinearMap.map_smul, smul_eq_mul, ← hψ''₂_D, mul_assoc, hGen s, mul_zero]
    exact sub_eq_zero.mp hZero

theorem weil_stable_curve_log_canonical_bundle_and_functoriality : (∀ (S : AlgebraicGeometry.Scheme.{u}),
      CompactSpace ↥S →
      S.IsSeparated →
      (∀ U : S.Opens, AlgebraicGeometry.IsAffineOpen U →
        IsNoetherianRing ↑(S.presheaf.obj (Opposite.op U))) →
      ∀ (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C)),
        IsGeometricStablePointedCurve g n τ →
        ∃ M : WeilLineBundle C,
          (∀ a : Fin M.m, AlgebraicGeometry.IsAffineOpen (M.V a)) ∧
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
            (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
            (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
            WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
            ∃ τ_s : Fin n →
                (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g s),
              IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g s) n τ_s ∧
              IsGeometricFiberLogCanonical (CategoryTheory.Limits.pullback.snd g s) n τ_s M_s) ∧
    (∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (n : ℕ)
      (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
      (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
      (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂)),
      IsGeometricStablePointedCurve g₁ n τ₁ →
      IsGeometricStablePointedCurve g₂ n τ₂ →
      ∃ (M₁ : WeilLineBundle C₁) (M₂ : WeilLineBundle C₂),
        (∀ a : Fin M₁.m, AlgebraicGeometry.IsAffineOpen (M₁.V a)) ∧
        (∀ b : Fin M₂.m, AlgebraicGeometry.IsAffineOpen (M₂.V b)) ∧
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
          (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g₁ s)),
          WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g₁ s) M₁ M_s →
          ∃ τ_s : Fin n →
              (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g₁ s),
            IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g₁ s) n τ_s ∧
            IsGeometricFiberLogCanonical (CategoryTheory.Limits.pullback.snd g₁ s) n τ_s M_s) ∧
        (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
          (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g₂ s)),
          WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g₂ s) M₂ M_s →
          ∃ τ_s : Fin n →
              (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g₂ s),
            IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g₂ s) n τ_s ∧
            IsGeometricFiberLogCanonical (CategoryTheory.Limits.pullback.snd g₂ s) n τ_s M_s) ∧
        HasPointedCurveIsoCocycle g₁ τ₁ g₂ τ₂ M₁ M₂) :=
by
  obtain ⟨hCramer, hZeroAnn⟩ := weil_lci_cramer_blockShear_and_flat_zeroAnnihilator.{u}
  have hBuild : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CompactSpace ↥S →
      S.IsSeparated →
      (∀ U : S.Opens, AlgebraicGeometry.IsAffineOpen U →
        IsNoetherianRing ↑(S.presheaf.obj (Opposite.op U))) →
      ∀ (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C)),
        IsGeometricStablePointedCurve g n τ →
        ∃ M : WeilLineBundle C,
          IsRelativeLogCanonicalAtlas g n τ M ∧
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
            (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
            (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
            WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
            ∃ τ_s : Fin n →
                (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g s),
              IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g s) n τ_s ∧
              IsGeometricFiberLogCanonical (CategoryTheory.Limits.pullback.snd g s) n τ_s M_s := by
    intro S hCompS hSepS hNoethS C g n τ hStab
    classical
    have _ : CompactSpace ↥S := hCompS
    have _ : AlgebraicGeometry.IsProper g := hStab.2.2.1
    have _ : CompactSpace ↥C :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g
    choose U_x V_x k_x π_x F_x tag_x t_x hx_mem hChart_x using
      fun x : C =>
        weil_stable_curve_local_lci_marked_chart_at_point S hSepS hNoethS C g n τ hStab hZeroAnn x
    obtain ⟨s, hs_cov⟩ := isCompact_univ.elim_finite_subcover
      (fun x : C => (V_x x : Set C)) (fun x => (V_x x).isOpen)
      (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_mem x⟩)
    let e : Fin s.card ≃ ↥s := s.equivFin.symm
    have hCov : (⋃ a : Fin s.card, (V_x (e a).1 : Set C)) = Set.univ := by
      apply Set.eq_univ_of_univ_subset
      intro x hx
      have hx' := hs_cov hx
      rw [Set.mem_iUnion₂] at hx'
      obtain ⟨y, hy, hxy⟩ := hx'
      rw [Set.mem_iUnion]
      refine ⟨e.symm ⟨y, hy⟩, ?_⟩
      simpa using hxy
    exact weil_log_canonical_atlas_gluing_and_geomFiber S hSepS hNoethS C g n τ hStab
      s.card (fun a => U_x (e a).1) (fun a => V_x (e a).1) (fun a => k_x (e a).1)
      (fun a => π_x (e a).1) (fun a => F_x (e a).1) (fun a => tag_x (e a).1)
      (fun a => t_x (e a).1) hCov (fun a => hChart_x (e a).1)
      (fun S' f_S => weil_isGeometricStablePointedCurve_pullback S S' C f_S g n τ hStab)
      hCramer hZeroAnn
  refine ⟨?_, ?_⟩
  · intro S hCompS hSepS hNoethS C g n τ hStab
    obtain ⟨M, hAtlas, hFib⟩ := hBuild S hCompS hSepS hNoethS C g n τ hStab
    exact ⟨M, hAtlas.1, hFib⟩
  · intro R _ _ n C₁ C₂ g₁ τ₁ g₂ τ₂ hStab₁ hStab₂
    let S_R : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R)
    have hCompSR : CompactSpace ↥S_R := inferInstance
    have hSepSR : S_R.IsSeparated := inferInstance
    have hNoethSR : ∀ U : S_R.Opens, AlgebraicGeometry.IsAffineOpen U →
        IsNoetherianRing ↑(S_R.presheaf.obj (Opposite.op U)) := by
      intro U hU
      exact (inferInstance : AlgebraicGeometry.IsLocallyNoetherian S_R).component_noetherian ⟨U, hU⟩
    obtain ⟨M₁, hAtlas₁, hFib₁⟩ := hBuild S_R hCompSR hSepSR hNoethSR C₁ g₁ n τ₁ hStab₁
    obtain ⟨M₂, hAtlas₂, hFib₂⟩ := hBuild S_R hCompSR hSepSR hNoethSR C₂ g₂ n τ₂ hStab₂
    have hCocycle : HasPointedCurveIsoCocycle g₁ τ₁ g₂ τ₂ M₁ M₂ :=
      weil_pointed_curve_iso_cocycle_of_log_canonical_atlas R n C₁ C₂ g₁ τ₁ g₂ τ₂
        hStab₁ hStab₂ M₁ M₂ hAtlas₁ hAtlas₂
        (fun S S' C f_S g τ hStab =>
          weil_isGeometricStablePointedCurve_pullback S S' C f_S g n τ hStab)
        hCramer hZeroAnn
    exact ⟨M₁, M₂, hAtlas₁.1, hAtlas₂.1, hFib₁, hFib₂, hCocycle⟩

theorem weil_algClosed_stable_curve_nodes_components_and_normalization (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (hFinIntClosure : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra Ω A] [Algebra.FiniteType Ω A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K))
    (hSmHt1 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
      [Algebra Ω A] [Algebra.FiniteType Ω A],
      ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) →
      ∀ (p : Ideal A) [p.IsPrime],
      p.height ≤ 1 →
      ∃ f : A, f ∉ p ∧ Algebra.IsStandardSmoothOfRelativeDimension 1 Ω (Localization.Away f)) :
    ∃ (c δ : ℕ)
      (E_set : Fin (c + 1) → Set C)
      (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
      (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
      (F : Fin (c + 1) → Type u)
      (instFieldF : ∀ α : Fin (c + 1), Field (F α))
      (instAlgF : ∀ α : Fin (c + 1), Algebra Ω (F α))
      (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
      (z_node : Fin δ → C)
      (pt_C : ∀ (x : C), IsClosed ({x} : Set C) →
        (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
      (pt_E : ∀ (α : Fin (c + 1)) (P : E_norm α), IsClosed ({P} : Set (E_norm α)) →
        (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_norm α)),
      letI := instFieldF
      letI := instAlgF
      IsNodalCurvePreNormalizationData Ω C g n τ c δ E_set E_norm p_norm ν F η_F
        z_node pt_C pt_E :=
by
  
  have weil_algClosed_quotient_maximal_bijective :
      ∀ (B : Type u) [CommRing B] [Algebra Ω B] [Algebra.FiniteType Ω B]
        (m : Ideal B) [m.IsMaximal],
        Function.Bijective (algebraMap Ω (B ⧸ m)) := by
    clear C g n τ hStab hFinIntClosure hSmHt1
    intro B _ _ _ m _
    let K := B ⧸ m
    let _ : Field K := Ideal.Quotient.field m
    have hFT : Algebra.FiniteType Ω K :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω m) Ideal.Quotient.mk_surjective
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg Ω K
    have hs0 : s = 0 := by
      rcases s with _ | s
      · rfl
      · exfalso
        let x₀ : MvPolynomial (Fin (s + 1)) Ω := MvPolynomial.X 0
        have hx₀_ne : x₀ ≠ 0 := MvPolynomial.X_ne_zero 0
        have hgx₀_ne : g x₀ ≠ 0 := fun h => hx₀_ne (hg_inj (h.trans (map_zero g).symm))
        obtain ⟨P, hP_monic, hP_eval⟩ := hg_int (g x₀)⁻¹
        let d := P.natDegree
        have hmul : (g x₀) ^ d * Polynomial.eval₂ g.toRingHom (g x₀)⁻¹ P = 0 := by
          rw [hP_eval, mul_zero]
        rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum] at hmul
        change ∑ i ∈ Finset.range (d + 1),
            (g x₀) ^ d * (g.toRingHom (P.coeff i) * ((g x₀)⁻¹) ^ i) = 0 at hmul
        have hsplit : ∑ i ∈ Finset.range (d + 1),
            (g x₀) ^ d * (g.toRingHom (P.coeff i) * ((g x₀)⁻¹) ^ i) =
            (∑ i ∈ Finset.range d, g.toRingHom (P.coeff i) * (g x₀) ^ (d - i)) + 1 := by
          rw [Finset.sum_range_succ]
          congr 1
          · refine Finset.sum_congr rfl fun i hi => ?_
            have hi_le : i ≤ d := Nat.le_of_lt (Finset.mem_range.mp hi)
            have hpow : (g x₀) ^ d * ((g x₀)⁻¹) ^ i = (g x₀) ^ (d - i) := by
              have hd_eq : d = (d - i) + i := (Nat.sub_add_cancel hi_le).symm
              conv_lhs => rw [hd_eq, pow_add]
              rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hgx₀_ne, one_pow, mul_one]
            calc (g x₀) ^ d * (g.toRingHom (P.coeff i) * ((g x₀)⁻¹) ^ i)
                = g.toRingHom (P.coeff i) * ((g x₀) ^ d * ((g x₀)⁻¹) ^ i) := by ring
              _ = g.toRingHom (P.coeff i) * (g x₀) ^ (d - i) := by rw [hpow]
          · have hlead : P.coeff d = 1 := hP_monic.coeff_natDegree
            rw [hlead, map_one, one_mul, ← mul_pow, mul_inv_cancel₀ hgx₀_ne, one_pow]
        rw [hsplit] at hmul
        have hdiv : ∑ i ∈ Finset.range d, P.coeff i * x₀ ^ (d - i) =
            x₀ * ∑ i ∈ Finset.range d, P.coeff i * x₀ ^ (d - 1 - i) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_lt : i < d := Finset.mem_range.mp hi
          have hd_sub : d - i = (d - 1 - i) + 1 := by omega
          rw [hd_sub, pow_succ]
          ring
        have h_in_poly : x₀ * (∑ i ∈ Finset.range d, P.coeff i * x₀ ^ (d - 1 - i)) + 1 = 0 := by
          apply hg_inj
          change g.toRingHom (x₀ * (∑ i ∈ Finset.range d, P.coeff i * x₀ ^ (d - 1 - i)) + 1) =
            g.toRingHom 0
          rw [map_zero, map_add, map_one, ← hdiv, map_sum]
          simp only [map_mul, map_pow]
          exact hmul
        have h_const := congrArg MvPolynomial.constantCoeff h_in_poly
        simp only [map_add, map_mul, map_one, map_zero, x₀, MvPolynomial.constantCoeff_X,
          zero_mul, zero_add] at h_const
        exact one_ne_zero h_const
    subst hs0
    have hIntΩ : Algebra.IsIntegral Ω K := by
      constructor
      intro z
      obtain ⟨P, hP_monic, hP_eval⟩ := hg_int z
      let cc : MvPolynomial (Fin 0) Ω →+* Ω := @MvPolynomial.constantCoeff Ω (Fin 0) _
      refine ⟨P.map cc, hP_monic.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have hrh : (algebraMap Ω K).comp cc = g.toRingHom := by
        ext a
        · simp [cc]
        · exact Fin.elim0 a
      rw [hrh]
      exact hP_eval
    exact @IsAlgClosed.algebraMap_bijective_of_isIntegral Ω K _ _ _ _ _ hIntΩ
  
  have weil_algClosed_proper_closedPoint_section_and_uniqueness :
      ∀ (X : AlgebraicGeometry.Scheme.{u})
        (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.IsProper p],
        (∀ (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
            (p_x : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op V))),
          IsClosed ({hV.fromSpec.base p_x} : Set X) ↔ p_x.asIdeal.IsMaximal) ∧
        ∃ (pt : ∀ (x : X), IsClosed ({x} : Set X) →
            (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X)),
          ∀ (x : X) (hx : IsClosed ({x} : Set X)),
            pt x hx ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
            (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), (pt x hx).base q = x) ∧
            (∀ s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X,
              s ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) →
              (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), s.base q = x) →
              s = pt x hx) ∧
            ∀ (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
              (p_x : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op V)))
              (h_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
                (TopologicalSpace.Opens.map (pt x hx).base).obj V),
              hV.fromSpec.base p_x = x →
              RingHom.ker (weilPointEvalRingHom (pt x hx) V h_in) = p_x.asIdeal := by
    clear C g n τ hStab hFinIntClosure hSmHt1
    intro X p _
    have hTopAff : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) :=
      AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of Ω))
    have hTopFrom : hTopAff.fromSpec =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top, AlgebraicGeometry.Scheme.isoSpec_Spec]
      rfl
    have hChartAlg : ∀ (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V),
        let c_V : Ω →+* ↑(X.presheaf.obj (Opposite.op V)) :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p.appLE ⊤ V le_top).hom
        letI : Algebra Ω ↑(X.presheaf.obj (Opposite.op V)) := c_V.toAlgebra
        Algebra.FiniteType Ω ↑(X.presheaf.obj (Opposite.op V)) := by
      intro V hV
      let c_V : Ω →+* ↑(X.presheaf.obj (Opposite.op V)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p.appLE ⊤ V le_top).hom
      let _ : Algebra Ω ↑(X.presheaf.obj (Opposite.op V)) := c_V.toAlgebra
      have hFT_app : (p.appLE ⊤ V le_top).hom.FiniteType :=
        p.finiteType_appLE hTopAff hV le_top
      have hSurj_inv : Function.Surjective
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm.commRingCatIsoToRingEquiv.surjective
      exact hFT_app.comp (RingHom.FiniteType.of_surjective _ hSurj_inv)
    have hUniqueSpecΩ : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        q = (⊥ : PrimeSpectrum Ω) := by
      intro q
      apply PrimeSpectrum.ext
      ext x
      change x ∈ q.asIdeal ↔ x ∈ (⊥ : Ideal Ω)
      rw [Ideal.mem_bot]
      constructor
      · intro hx
        by_contra hne
        exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hx (IsUnit.mk0 x hne))
      · rintro rfl
        exact q.asIdeal.zero_mem
    have hBuildSec : ∀ (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
        (p_x : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op V))),
        p_x.asIdeal.IsMaximal →
        ∃ s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X,
          s₀ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
          ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
            s₀.base q = hV.fromSpec.base p_x := by
      intro V hV p_x hp_max
      let B := ↑(X.presheaf.obj (Opposite.op V))
      let c_V : Ω →+* B :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p.appLE ⊤ V le_top).hom
      let _ : Algebra Ω B := c_V.toAlgebra
      have _ : Algebra.FiniteType Ω B := hChartAlg V hV
      have hBij : Function.Bijective (algebraMap Ω (B ⧸ p_x.asIdeal)) :=
        weil_algClosed_quotient_maximal_bijective B p_x.asIdeal
      let e_Ω : Ω ≃+* (B ⧸ p_x.asIdeal) := RingEquiv.ofBijective _ hBij
      let ev : B →+* Ω := e_Ω.symm.toRingHom.comp (Ideal.Quotient.mk p_x.asIdeal)
      have hev_comp : ev.comp c_V = RingHom.id Ω := by
        ext a
        exact e_Ω.symm_apply_apply a
      have hev_ker : RingHom.ker ev = p_x.asIdeal := by
        ext b
        simp only [RingHom.mem_ker, ev, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, RingEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
      let s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ hV.fromSpec
      refine ⟨s₀, ?_, ?_⟩
      · have hcomm : AlgebraicGeometry.Spec.map (p.appLE ⊤ V le_top) ≫ hTopAff.fromSpec =
            hV.fromSpec ≫ p :=
          AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p hTopAff hV le_top
        calc s₀ ≫ p
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ (hV.fromSpec ≫ p) :=
              CategoryTheory.Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫
                AlgebraicGeometry.Spec.map (p.appLE ⊤ V le_top) ≫
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv := by
              rw [← hcomm, hTopFrom]
          _ = AlgebraicGeometry.Spec.map
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                  p.appLE ⊤ V le_top ≫ CommRingCat.ofHom ev) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
                CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev.comp c_V)) := rfl
          _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of Ω)) := by
              rw [hev_comp]; rfl
          _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
              AlgebraicGeometry.Spec.map_id _
      · intro q
        rw [hUniqueSpecΩ q]
        change hV.fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev)).base (⊥ : PrimeSpectrum Ω)) =
          hV.fromSpec.base p_x
        congr 1
        apply PrimeSpectrum.ext
        ext b
        change ev b ∈ (⊥ : Ideal Ω) ↔ b ∈ p_x.asIdeal
        rw [Ideal.mem_bot, ← RingHom.mem_ker, hev_ker]
    have hPart1 : ∀ (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
        (p_x : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op V))),
        IsClosed ({hV.fromSpec.base p_x} : Set X) ↔ p_x.asIdeal.IsMaximal := by
      intro V hV p_x
      constructor
      · intro hcl
        have hinj : Function.Injective hV.fromSpec.base :=
          hV.fromSpec.isOpenEmbedding.injective
        have hcl_pre : IsClosed (hV.fromSpec.base ⁻¹' ({hV.fromSpec.base p_x} : Set X)) :=
          hcl.preimage hV.fromSpec.continuous
        have hpre : hV.fromSpec.base ⁻¹' ({hV.fromSpec.base p_x} : Set X) =
            ({p_x} : Set ↥(AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op V)))) := by
          ext q
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          exact hinj.eq_iff
        rw [hpre] at hcl_pre
        exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_x).mp hcl_pre
      · intro hp_max
        obtain ⟨s₀, hs₀_p, hs₀_pt⟩ := hBuildSec V hV p_x hp_max
        have _ : AlgebraicGeometry.IsProper (s₀ ≫ p) := by
          rw [hs₀_p]; infer_instance
        have _ : AlgebraicGeometry.IsProper s₀ :=
          AlgebraicGeometry.IsProper.of_comp s₀ p
        have hcl_range : IsClosed (Set.range s₀.base) := by
          rw [← Set.image_univ]
          exact s₀.isClosedMap Set.univ isClosed_univ
        have hrange_eq : Set.range s₀.base = {hV.fromSpec.base p_x} := by
          ext y
          simp only [Set.mem_range, Set.mem_singleton_iff]
          exact ⟨fun ⟨q, hq⟩ => hq ▸ hs₀_pt q,
            fun hy => ⟨(⊥ : PrimeSpectrum Ω), hy ▸ hs₀_pt (⊥ : PrimeSpectrum Ω)⟩⟩
        rwa [← hrange_eq]
    have hLiftOnChart : ∀ (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
        (p_x : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op V)))
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X),
        s ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) →
        (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), s.base q = hV.fromSpec.base p_x) →
        ∃ φ_s : X.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of Ω,
          AlgebraicGeometry.Spec.map φ_s ≫ hV.fromSpec = s ∧
          RingHom.ker φ_s.hom = p_x.asIdeal ∧
          φ_s.hom.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p.appLE ⊤ V (fun _ _ => trivial)).hom) = RingHom.id Ω := by
      intro V hV p_x s hs_p hs_pt
      have hsub : Set.range s.base ⊆ Set.range hV.fromSpec.base := by
        rintro _ ⟨q, rfl⟩
        exact ⟨p_x, (hs_pt q).symm⟩
      let u := AlgebraicGeometry.IsOpenImmersion.lift hV.fromSpec s hsub
      have hu : u ≫ hV.fromSpec = s :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hV.fromSpec s hsub
      let φ_s := AlgebraicGeometry.Spec.preimage u
      have hφ : AlgebraicGeometry.Spec.map φ_s ≫ hV.fromSpec = s := by
        rw [AlgebraicGeometry.Spec.map_preimage]; exact hu
      refine ⟨φ_s, hφ, ?_, ?_⟩
      · have hbase : hV.fromSpec.base
            ((AlgebraicGeometry.Spec.map φ_s).base (⊥ : PrimeSpectrum Ω)) =
            hV.fromSpec.base p_x := by
          calc hV.fromSpec.base ((AlgebraicGeometry.Spec.map φ_s).base (⊥ : PrimeSpectrum Ω))
              = (AlgebraicGeometry.Spec.map φ_s ≫ hV.fromSpec).base (⊥ : PrimeSpectrum Ω) := rfl
            _ = s.base (⊥ : PrimeSpectrum Ω) := by rw [hφ]
            _ = hV.fromSpec.base p_x := hs_pt (⊥ : PrimeSpectrum Ω)
        have hp_eq : (AlgebraicGeometry.Spec.map φ_s).base (⊥ : PrimeSpectrum Ω) = p_x :=
          hV.fromSpec.isOpenEmbedding.injective hbase
        ext b
        rw [RingHom.mem_ker, ← Ideal.mem_bot]
        change b ∈ ((AlgebraicGeometry.Spec.map φ_s).base (⊥ : PrimeSpectrum Ω)).asIdeal ↔
          b ∈ p_x.asIdeal
        rw [hp_eq]
      · have hcomm : AlgebraicGeometry.Spec.map (p.appLE ⊤ V (fun _ _ => trivial)) ≫
            hTopAff.fromSpec = hV.fromSpec ≫ p :=
          AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p hTopAff hV (fun _ _ => trivial)
        have hSpecEq : AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              p.appLE ⊤ V (fun _ _ => trivial) ≫ φ_s) =
            AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of Ω)) := by
          calc AlgebraicGeometry.Spec.map
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                  p.appLE ⊤ V (fun _ _ => trivial) ≫ φ_s)
              = AlgebraicGeometry.Spec.map φ_s ≫
                  (AlgebraicGeometry.Spec.map (p.appLE ⊤ V (fun _ _ => trivial)) ≫
                    hTopAff.fromSpec) := by
                rw [hTopFrom, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
                  CategoryTheory.Category.assoc]
            _ = (AlgebraicGeometry.Spec.map φ_s ≫ hV.fromSpec) ≫ p := by
                rw [hcomm, CategoryTheory.Category.assoc]
            _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
                rw [hφ, hs_p]
            _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of Ω)) :=
                (AlgebraicGeometry.Spec.map_id _).symm
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpecEq)
    refine ⟨hPart1, ?_⟩
    have hExPt : ∀ (x : X), IsClosed ({x} : Set X) →
        ∃ s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X,
          s₀ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
          ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), s₀.base q = x := by
      intro x hx
      obtain ⟨V₀, hV₀, hx_V₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
      have hx_range : x ∈ Set.range hV₀.fromSpec.base := by
        rw [hV₀.range_fromSpec]; exact hx_V₀
      obtain ⟨p₀, hp₀⟩ := hx_range
      have hp₀_max : p₀.asIdeal.IsMaximal := (hPart1 V₀ hV₀ p₀).mp (hp₀.symm ▸ hx)
      obtain ⟨s₀, hs₀_p, hs₀_pt⟩ := hBuildSec V₀ hV₀ p₀ hp₀_max
      exact ⟨s₀, hs₀_p, fun q => (hs₀_pt q).trans hp₀⟩
    choose pt hpt using hExPt
    refine ⟨pt, fun x hx => ⟨(hpt x hx).1, (hpt x hx).2, ?_, ?_⟩⟩
    · intro s hs_p hs_pt
      obtain ⟨V₀, hV₀, hx_V₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
      have hx_range : x ∈ Set.range hV₀.fromSpec.base := by
        rw [hV₀.range_fromSpec]; exact hx_V₀
      obtain ⟨p₀, hp₀⟩ := hx_range
      have hp₀_max : p₀.asIdeal.IsMaximal := (hPart1 V₀ hV₀ p₀).mp (hp₀.symm ▸ hx)
      obtain ⟨φ_s, hφ_s, hker_s, hcomp_s⟩ :=
        hLiftOnChart V₀ hV₀ p₀ s hs_p (fun q => (hs_pt q).trans hp₀.symm)
      obtain ⟨φ_pt, hφ_pt, hker_pt, hcomp_pt⟩ :=
        hLiftOnChart V₀ hV₀ p₀ (pt x hx) (hpt x hx).1
          (fun q => ((hpt x hx).2 q).trans hp₀.symm)
      have hφ_eq : φ_s = φ_pt := by
        ext b
        let B := ↑(X.presheaf.obj (Opposite.op V₀))
        let c_V : Ω →+* B :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            p.appLE ⊤ V₀ le_top).hom
        let _ : Algebra Ω B := c_V.toAlgebra
        have _ : Algebra.FiniteType Ω B := hChartAlg V₀ hV₀
        have hBij : Function.Bijective (algebraMap Ω (B ⧸ p₀.asIdeal)) :=
          weil_algClosed_quotient_maximal_bijective B p₀.asIdeal
        obtain ⟨a, ha⟩ := hBij.2 (Ideal.Quotient.mk p₀.asIdeal b)
        have hsub_mem : b - c_V a ∈ p₀.asIdeal := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
          exact ha.symm
        have hs_sub : φ_s.hom (b - c_V a) = 0 := by
          rw [← RingHom.mem_ker, hker_s]; exact hsub_mem
        have hpt_sub : φ_pt.hom (b - c_V a) = 0 := by
          rw [← RingHom.mem_ker, hker_pt]; exact hsub_mem
        have hs_c : φ_s.hom (c_V a) = a := RingHom.congr_fun hcomp_s a
        have hpt_c : φ_pt.hom (c_V a) = a := RingHom.congr_fun hcomp_pt a
        rw [map_sub, sub_eq_zero, hs_c] at hs_sub
        rw [map_sub, sub_eq_zero, hpt_c] at hpt_sub
        exact hs_sub.trans hpt_sub.symm
      rw [← hφ_s, ← hφ_pt, hφ_eq]
    · intro V hV p_x h_in hp_x
      obtain ⟨φ_pt, hφ_pt, hker_pt, _⟩ :=
        hLiftOnChart V hV p_x (pt x hx) (hpt x hx).1
          (fun q => ((hpt x hx).2 q).trans hp_x.symm)
      have hcomm : AlgebraicGeometry.Spec.map ((pt x hx).appLE V ⊤ h_in) ≫ hV.fromSpec =
          hTopAff.fromSpec ≫ pt x hx :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (pt x hx) hV hTopAff h_in
      have hSpecEval : AlgebraicGeometry.Spec.map
          ((pt x hx).appLE V ⊤ h_in ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom) ≫ hV.fromSpec =
          AlgebraicGeometry.Spec.map φ_pt ≫ hV.fromSpec := by
        calc AlgebraicGeometry.Spec.map
              ((pt x hx).appLE V ⊤ h_in ≫
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom) ≫ hV.fromSpec
            = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
                (AlgebraicGeometry.Spec.map ((pt x hx).appLE V ⊤ h_in) ≫ hV.fromSpec) := by
              rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
                AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv) ≫
                pt x hx := by
              rw [hcomm, hTopFrom, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom) ≫ pt x hx := by
              rw [← AlgebraicGeometry.Spec.map_comp]
          _ = pt x hx := by
              rw [CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id,
                CategoryTheory.Category.id_comp]
          _ = AlgebraicGeometry.Spec.map φ_pt ≫ hV.fromSpec := hφ_pt.symm
      have hEvalEq : (pt x hx).appLE V ⊤ h_in ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom = φ_pt :=
        AlgebraicGeometry.Spec.map_injective ((cancel_mono hV.fromSpec).mp hSpecEval)
      change RingHom.ker ((pt x hx).appLE V ⊤ h_in ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom = p_x.asIdeal
      rw [hEvalEq, hker_pt]
  
  have weil_algClosed_etale_nodal_roof_closed_and_not_smooth :
      ∀ (C : AlgebraicGeometry.Scheme.{u})
        (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.IsProper g]
        (y : C)
        (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ C)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})))
        (hEt₁ : AlgebraicGeometry.Etale e₁)
        (hEt₂ : AlgebraicGeometry.Etale e₂)
        (hu₀ : e₁.base u₀ = y)
        (hm₀_in : ∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal)
        (hcomm : e₁ ≫ g = e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))),
        IsClosed ({y} : Set C) ∧
        ¬∃ V : C.Opens, y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ g) := by
    clear C g n τ hStab hFinIntClosure hSmHt1
      weil_algClosed_quotient_maximal_bijective
      weil_algClosed_proper_closedPoint_section_and_uniqueness
    intro C g _ y U' u₀ e₁ e₂ hEt₁ hEt₂ hu₀ hm₀_in hcomm
    haveI : AlgebraicGeometry.Etale e₁ := hEt₁
    haveI : AlgebraicGeometry.Etale e₂ := hEt₂
    let P₂ := MvPolynomial (Fin 2) Ω
    let cc₂ : P₂ →+* Ω := @MvPolynomial.constantCoeff Ω (Fin 2) _
    let I₀ : Ideal P₂ := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let R₀ := P₂ ⧸ I₀
    let xbar : Fin 2 → R₀ := fun i => Ideal.Quotient.mk I₀ (MvPolynomial.X i)
    let m₀ : Ideal R₀ := Ideal.span {xbar 0, xbar 1}
    have hcc_X : ∀ i : Fin 2, cc₂ (MvPolynomial.X i) = 0 := fun i =>
      MvPolynomial.constantCoeff_X (R := Ω) i
    have hcc_C : ∀ c : Ω, cc₂ (MvPolynomial.C c) = c := fun c =>
      MvPolynomial.constantCoeff_C (σ := Fin 2) c
    have hI₀_ker : I₀ ≤ RingHom.ker cc₂ := by
      rw [Ideal.span_le]
      rintro _ ⟨rfl⟩
      change cc₂ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      rw [map_mul, hcc_X 0, zero_mul]
    let ev₀ : R₀ →+* Ω := Ideal.Quotient.lift I₀ cc₂ hI₀_ker
    have hev₀_mk : ∀ F : P₂, ev₀ (Ideal.Quotient.mk I₀ F) = cc₂ F := fun _ => rfl
    have hev₀_C : ∀ c : Ω, ev₀ (algebraMap Ω R₀ c) = c := fun c => hcc_C c
    have hDecompR₀ : ∀ r : R₀, r - algebraMap Ω R₀ (ev₀ r) ∈ m₀ := by
      intro r
      refine Quotient.inductionOn' r fun F => ?_
      rw [show (Quotient.mk'' F : R₀) = Ideal.Quotient.mk I₀ F from rfl, hev₀_mk]
      change Ideal.Quotient.mk I₀ F - Ideal.Quotient.mk I₀ (MvPolynomial.C (cc₂ F)) ∈ m₀
      rw [← map_sub]
      induction F using MvPolynomial.induction_on with
      | C a => rw [hcc_C, sub_self, map_zero]; exact m₀.zero_mem
      | add p q hp hq =>
        have heq : Ideal.Quotient.mk I₀ (p + q - MvPolynomial.C (cc₂ (p + q))) =
            Ideal.Quotient.mk I₀ (p - MvPolynomial.C (cc₂ p)) +
              Ideal.Quotient.mk I₀ (q - MvPolynomial.C (cc₂ q)) := by
          simp only [map_add, map_sub]; ring
        rw [heq]
        exact m₀.add_mem hp hq
      | mul_X p i _ =>
        have hcc_mul : cc₂ (p * MvPolynomial.X i) = 0 := by
          rw [map_mul, hcc_X i, mul_zero]
        rw [hcc_mul, map_zero, sub_zero, map_mul]
        apply Ideal.mul_mem_left
        fin_cases i
        · exact Ideal.subset_span (by simp [xbar])
        · exact Ideal.subset_span (by simp [xbar])
    have hsmul_R₀ : ∀ (c : Ω) (r : R₀), c • r = algebraMap Ω R₀ c * r := by
      intro c r
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
      change Ideal.Quotient.mk I₀ (c • F) = Ideal.Quotient.mk I₀ (MvPolynomial.C c) * _
      rw [Algebra.smul_def, map_mul]
      rfl
    let modR₀V : Module R₀ (Fin 2 → Ω) := Module.compHom (Fin 2 → Ω) ev₀
    have hScalarR₀V : @IsScalarTower Ω R₀ (Fin 2 → Ω) _ modR₀V.toSMul _ :=
      ⟨fun c r v => by
        ext k
        change ev₀ (c • r) * v k = c * (ev₀ r * v k)
        rw [hsmul_R₀, map_mul, hev₀_C, mul_assoc]⟩
    have hExDeriv : ∃ L_R₀ : @LinearMap R₀ R₀ _ _ (RingHom.id R₀)
        (KaehlerDifferential Ω R₀) (Fin 2 → Ω) _ _ _ modR₀V,
        ∀ j k : Fin 2, L_R₀ (KaehlerDifferential.D Ω R₀ (xbar j)) k =
          if k = j then 1 else 0 := by
      letI : Module R₀ (Fin 2 → Ω) := modR₀V
      haveI : IsScalarTower Ω R₀ (Fin 2 → Ω) := hScalarR₀V
      let d_lin : P₂ →ₗ[Ω] (Fin 2 → Ω) :=
        { toFun := fun F k => cc₂ (MvPolynomial.pderiv k F)
          map_add' := fun F G => by
            ext k
            change cc₂ (MvPolynomial.pderiv k (F + G)) =
              cc₂ (MvPolynomial.pderiv k F) + cc₂ (MvPolynomial.pderiv k G)
            rw [Derivation.map_add, map_add]
          map_smul' := fun c F => by
            ext k
            change cc₂ (MvPolynomial.pderiv k (c • F)) = c * cc₂ (MvPolynomial.pderiv k F)
            rw [Derivation.map_smul, Algebra.smul_def, map_mul]
            change cc₂ (MvPolynomial.C c) * cc₂ (MvPolynomial.pderiv k F) = _
            rw [hcc_C] }
      have hd_vanish : I₀.restrictScalars Ω ≤ LinearMap.ker d_lin := by
        intro h hh
        change h ∈ I₀ at hh
        rw [Ideal.mem_span_singleton] at hh
        obtain ⟨Q, rfl⟩ := hh
        ext k
        change cc₂ (MvPolynomial.pderiv k (MvPolynomial.X 0 * MvPolynomial.X 1 * Q)) = 0
        rw [Derivation.leibniz, Derivation.leibniz]
        simp only [smul_eq_mul, map_add, map_mul, hcc_X, mul_zero, zero_mul, add_zero]
      let d_quot : R₀ →ₗ[Ω] (Fin 2 → Ω) := Submodule.liftQ (I₀.restrictScalars Ω) d_lin hd_vanish
      have hd_mk : ∀ F : P₂, d_quot (Ideal.Quotient.mk I₀ F) = d_lin F := fun F =>
        Submodule.liftQ_apply (I₀.restrictScalars Ω) d_lin F
      let δ_R₀ : Derivation Ω R₀ (Fin 2 → Ω) :=
        { toLinearMap := d_quot
          map_one_eq_zero' := by
            change d_quot (Ideal.Quotient.mk I₀ 1) = 0
            rw [hd_mk]
            ext k
            change cc₂ (MvPolynomial.pderiv k 1) = 0
            rw [Derivation.map_one_eq_zero, map_zero]
          leibniz' := fun r s => by
            obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
            obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective s
            rw [← map_mul, hd_mk, hd_mk, hd_mk]
            ext k
            change cc₂ (MvPolynomial.pderiv k (F * G)) =
              ev₀ (Ideal.Quotient.mk I₀ F) * cc₂ (MvPolynomial.pderiv k G) +
              ev₀ (Ideal.Quotient.mk I₀ G) * cc₂ (MvPolynomial.pderiv k F)
            rw [hev₀_mk, hev₀_mk, Derivation.leibniz]
            simp only [smul_eq_mul, map_add, map_mul] }
      refine ⟨(KaehlerDifferential.linearMapEquivDerivation Ω R₀).symm δ_R₀, fun j k => ?_⟩
      rw [KaehlerDifferential.linearMapEquivDerivation_symm_apply,
        Derivation.liftKaehlerDifferential_comp_D]
      change d_quot (Ideal.Quotient.mk I₀ (MvPolynomial.X j)) k = if k = j then 1 else 0
      rw [hd_mk]
      change cc₂ (MvPolynomial.pderiv k (MvPolynomial.X j)) = if k = j then 1 else 0
      rw [MvPolynomial.pderiv_X]
      fin_cases j <;> fin_cases k <;> simp
    have hRoofFromOpenSpec : ∀ (A_cat : CommRingCat.{u})
        (ι_A : AlgebraicGeometry.Spec A_cat ⟶ C)
        [AlgebraicGeometry.IsOpenImmersion ι_A]
        (p_y : PrimeSpectrum ↑A_cat),
        ι_A.base p_y = y →
        ∃ (V_U : U'.Opens) (hVU : AlgebraicGeometry.IsAffineOpen V_U)
          (q₀ : PrimeSpectrum ↑(U'.presheaf.obj (Opposite.op V_U)))
          (φ₀ : ↑A_cat →+* ↑(U'.presheaf.obj (Opposite.op V_U)))
          (ψ₀ : R₀ →+* ↑(U'.presheaf.obj (Opposite.op V_U)))
          (ev_q : ↑(U'.presheaf.obj (Opposite.op V_U)) →+* Ω),
          let c_A : Ω →+* ↑A_cat := (AlgebraicGeometry.Spec.preimage (ι_A ≫ g)).hom
          hVU.fromSpec.base q₀ = u₀ ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ι_A = hVU.fromSpec ≫ e₁ ∧
          RingHom.Etale φ₀ ∧
          RingHom.Etale ψ₀ ∧
          φ₀.comp c_A = ψ₀.comp (algebraMap Ω R₀) ∧
          RingHom.ker ev_q = q₀.asIdeal ∧
          ev_q.comp ψ₀ = ev₀ := by
      intro A_cat ι_A _ p_y hpy
      let W_open : U'.Opens := (TopologicalSpace.Opens.map e₁.base).obj ι_A.opensRange
      have hu₀_W : u₀ ∈ W_open := by
        change e₁.base u₀ ∈ Set.range ι_A.base
        rw [hu₀]
        exact ⟨p_y, hpy⟩
      obtain ⟨V_U, hVU, hu₀_VU, hSub_set⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := u₀) hu₀_W
      have hu₀_range : u₀ ∈ Set.range hVU.fromSpec.base := by
        rw [hVU.range_fromSpec]; exact hu₀_VU
      obtain ⟨q₀, hq₀⟩ := hu₀_range
      let B' : Type u := ↑(U'.presheaf.obj (Opposite.op V_U))
      have hRangeLift : Set.range (hVU.fromSpec ≫ e₁).base ⊆ Set.range ι_A.base := by
        rintro _ ⟨z, rfl⟩
        have hz_VU : hVU.fromSpec.base z ∈ (V_U : Set U') := by
          rw [← hVU.range_fromSpec]
          exact ⟨z, rfl⟩
        exact hSub_set hz_VU
      let u₁ := AlgebraicGeometry.IsOpenImmersion.lift ι_A (hVU.fromSpec ≫ e₁) hRangeLift
      have hu₁_fac : u₁ ≫ ι_A = hVU.fromSpec ≫ e₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_A (hVU.fromSpec ≫ e₁) hRangeLift
      let φ₀_cat := AlgebraicGeometry.Spec.preimage u₁
      let φ₀ : ↑A_cat →+* B' := φ₀_cat.hom
      have hSpec_φ₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) = u₁ :=
        AlgebraicGeometry.Spec.map_preimage u₁
      have hFac_φ₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ι_A =
          hVU.fromSpec ≫ e₁ := by
        rw [hSpec_φ₀, hu₁_fac]
      have hEt_comp₁ : AlgebraicGeometry.Etale (hVU.fromSpec ≫ e₁) := inferInstance
      have hEt_spec₁ : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) := by
        rw [← hFac_φ₀] at hEt_comp₁
        exact CategoryTheory.MorphismProperty.of_postcomp
          @AlgebraicGeometry.Etale _ ι_A (inferInstance : AlgebraicGeometry.Etale ι_A) hEt_comp₁
      have hEt_φ₀ : RingHom.Etale φ₀ :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hEt_spec₁
      let ψ₀_cat := AlgebraicGeometry.Spec.preimage (hVU.fromSpec ≫ e₂)
      let ψ₀ : R₀ →+* B' := ψ₀_cat.hom
      have hSpec_ψ₀ : AlgebraicGeometry.Spec.map ψ₀_cat = hVU.fromSpec ≫ e₂ :=
        AlgebraicGeometry.Spec.map_preimage _
      have hEt_comp₂ : AlgebraicGeometry.Etale (hVU.fromSpec ≫ e₂) := inferInstance
      have hEt_ψ₀ : RingHom.Etale ψ₀ := by
        rw [← hSpec_ψ₀] at hEt_comp₂
        exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hEt_comp₂
      let c_A : Ω →+* ↑A_cat := (AlgebraicGeometry.Spec.preimage (ι_A ≫ g)).hom
      have hCompatΩ : φ₀.comp c_A = ψ₀.comp (algebraMap Ω R₀) := by
        have hSpecEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₀.comp c_A)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp (algebraMap Ω R₀))) := by
          calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₀.comp c_A))
              = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
                  AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (ι_A ≫ g)) := by
                rw [← AlgebraicGeometry.Spec.map_comp]
                rfl
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ ι_A) ≫ g := by
                rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc]
            _ = hVU.fromSpec ≫ (e₁ ≫ g) := by rw [hFac_φ₀, CategoryTheory.Category.assoc]
            _ = (hVU.fromSpec ≫ e₂) ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
                rw [hcomm, CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp (algebraMap Ω R₀))) := by
                rw [← hSpec_ψ₀, ← AlgebraicGeometry.Spec.map_comp]
                rfl
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpecEq)
      have hm₀_le : m₀ ≤ Ideal.comap ψ₀ q₀.asIdeal := by
        rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · have h0 := hm₀_in 0
          rw [← hq₀] at h0
          change Ideal.Quotient.mk I₀ (MvPolynomial.X 0) ∈
            ((hVU.fromSpec ≫ e₂).base q₀).asIdeal at h0
          rw [← hSpec_ψ₀] at h0
          exact h0
        · have h1 := hm₀_in 1
          rw [← hq₀] at h1
          change Ideal.Quotient.mk I₀ (MvPolynomial.X 1) ∈
            ((hVU.fromSpec ≫ e₂).base q₀).asIdeal at h1
          rw [← hSpec_ψ₀] at h1
          exact h1
      letI : Algebra R₀ B' := ψ₀.toAlgebra
      haveI : Algebra.Etale R₀ B' := hEt_ψ₀
      letI : Algebra Ω B' := (ψ₀.comp (algebraMap Ω R₀)).toAlgebra
      haveI : IsScalarTower Ω R₀ B' :=
        ⟨fun c r b => by
          change ψ₀ (c • r) * b = ψ₀ (algebraMap Ω R₀ c) * (ψ₀ r * b)
          rw [hsmul_R₀, map_mul, mul_assoc]⟩
      have hFT_R₀ : Algebra.FiniteType Ω R₀ :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω I₀) Ideal.Quotient.mk_surjective
      have hFT_R₀B' : Algebra.FiniteType R₀ B' := inferInstance
      haveI : Algebra.FiniteType Ω B' := Algebra.FiniteType.trans hFT_R₀ hFT_R₀B'
      let J_B' : Ideal B' := Ideal.map ψ₀ m₀
      let D := B' ⧸ J_B'
      let π_D : B' →+* D := Ideal.Quotient.mk J_B'
      have hπ_surj : Function.Surjective π_D := Ideal.Quotient.mk_surjective
      haveI : Algebra.FiniteType Ω D :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω J_B') Ideal.Quotient.mk_surjective
      have hπψ_eq : ∀ r : R₀, π_D (ψ₀ r) = algebraMap Ω D (ev₀ r) := by
        intro r
        have hmem : ψ₀ (r - algebraMap Ω R₀ (ev₀ r)) ∈ J_B' :=
          Ideal.mem_map_of_mem ψ₀ (hDecompR₀ r)
        have hzero : π_D (ψ₀ r - ψ₀ (algebraMap Ω R₀ (ev₀ r))) = 0 := by
          rw [← map_sub]
          exact (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
        rw [map_sub, sub_eq_zero] at hzero
        exact hzero
      haveI : Algebra.FormallyUnramified Ω D := by
        suffices h_zero : ∀ ω : KaehlerDifferential Ω D, ω = 0 from
          ⟨⟨fun ω₁ ω₂ => (h_zero ω₁).trans (h_zero ω₂).symm⟩⟩
        intro ω
        let mB' : Module B' (KaehlerDifferential Ω D) :=
          Module.compHom (KaehlerDifferential Ω D) π_D
        let mR₀ : Module R₀ (KaehlerDifferential Ω D) :=
          Module.compHom (KaehlerDifferential Ω D) (π_D.comp ψ₀)
        letI : Module B' (KaehlerDifferential Ω D) := mB'
        letI : Module R₀ (KaehlerDifferential Ω D) := mR₀
        have hTow : @IsScalarTower R₀ B' (KaehlerDifferential Ω D) _ mB'.toSMul mR₀.toSMul :=
          ⟨fun r b m => by
            change π_D (ψ₀ r * b) • m = π_D (ψ₀ r) • (π_D b • m)
            rw [map_mul, mul_smul]⟩
        let d_B : Derivation R₀ B' (KaehlerDifferential Ω D) :=
          { toFun := fun b => KaehlerDifferential.D Ω D (π_D b)
            map_add' := fun a b => by rw [map_add, map_add]
            map_smul' := fun r b => by
              change KaehlerDifferential.D Ω D (π_D (ψ₀ r * b)) =
                π_D (ψ₀ r) • KaehlerDifferential.D Ω D (π_D b)
              have hd_alg : KaehlerDifferential.D Ω D (algebraMap Ω D (ev₀ r)) = 0 := by
                rw [Algebra.algebraMap_eq_smul_one, Derivation.map_smul,
                  Derivation.map_one_eq_zero, smul_zero]
              rw [map_mul, hπψ_eq r, Derivation.leibniz, hd_alg, smul_zero, add_zero]
            map_one_eq_zero' := by
              change KaehlerDifferential.D Ω D (π_D 1) = 0
              rw [map_one, Derivation.map_one_eq_zero]
            leibniz' := fun a b => by
              change KaehlerDifferential.D Ω D (π_D (a * b)) =
                π_D a • KaehlerDifferential.D Ω D (π_D b) +
                π_D b • KaehlerDifferential.D Ω D (π_D a)
              rw [map_mul, Derivation.leibniz] }
        have hSubBR₀ : Subsingleton (KaehlerDifferential R₀ B') :=
          Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
        let equiv_RB := @KaehlerDifferential.linearMapEquivDerivation R₀ B' _ _ _
          (KaehlerDifferential Ω D) _ mR₀ mB' hTow
        let L_B := equiv_RB.symm d_B
        have hd_zero : ∀ d : D, KaehlerDifferential.D Ω D d = 0 := by
          intro d
          obtain ⟨b, rfl⟩ := hπ_surj d
          have hsymm : L_B =
              @Derivation.liftKaehlerDifferential R₀ B' _ _ _
                (KaehlerDifferential Ω D) _ mR₀ mB' hTow d_B :=
            @KaehlerDifferential.linearMapEquivDerivation_symm_apply R₀ B' _ _ _
              (KaehlerDifferential Ω D) _ mR₀ mB' hTow d_B
          have hcomp : (@Derivation.liftKaehlerDifferential R₀ B' _ _ _
              (KaehlerDifferential Ω D) _ mR₀ mB' hTow d_B)
              (KaehlerDifferential.D R₀ B' b) = d_B b :=
            @Derivation.liftKaehlerDifferential_comp_D R₀ B' _ _ _
              (KaehlerDifferential Ω D) _ mR₀ mB' hTow d_B b
          change d_B b = 0
          rw [← hcomp, ← hsymm, hSubBR₀.elim (KaehlerDifferential.D R₀ B' b) 0, map_zero]
        have hmem : ω ∈ (⊤ : Submodule D (KaehlerDifferential Ω D)) := Submodule.mem_top
        rw [← KaehlerDifferential.span_range_derivation Ω D] at hmem
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hmem
        · rintro _ ⟨d, rfl⟩; exact hd_zero d
        · rfl
        · intro u v _ _ hu hv; rw [hu, hv, add_zero]
        · intro d u _ hu; rw [hu, smul_zero]
      have hJB'_le : J_B' ≤ q₀.asIdeal := Ideal.map_le_iff_le_comap.mpr hm₀_le
      let P_bar : Ideal D := Ideal.map π_D q₀.asIdeal
      have hker_le_q₀ : RingHom.ker π_D ≤ q₀.asIdeal := by
        rw [Ideal.mk_ker]; exact hJB'_le
      have hcomap_Pbar : Ideal.comap π_D P_bar = q₀.asIdeal := by
        rw [Ideal.comap_map_of_surjective π_D hπ_surj]
        exact sup_eq_left.mpr hker_le_q₀
      haveI : P_bar.IsPrime := by
        refine ⟨?_, ?_⟩
        · intro htop
          apply q₀.isPrime.ne_top
          rw [← hcomap_Pbar, htop]
          rfl
        · intro x z hxz
          obtain ⟨a, rfl⟩ := hπ_surj x
          obtain ⟨b, rfl⟩ := hπ_surj z
          have hab : a * b ∈ q₀.asIdeal := by
            rw [← hcomap_Pbar, Ideal.mem_comap, map_mul]
            exact hxz
          rcases q₀.isPrime.mem_or_mem hab with ha | hb
          · exact Or.inl (Ideal.mem_map_of_mem π_D ha)
          · exact Or.inr (Ideal.mem_map_of_mem π_D hb)
      let L_bar := Localization.AtPrime P_bar
      haveI : Algebra.FormallyUnramified Ω L_bar := Algebra.FormallyUnramified.comp Ω D L_bar
      haveI : Algebra.EssFiniteType Ω D := inferInstance
      haveI : Algebra.EssFiniteType D L_bar := inferInstance
      haveI : Algebra.EssFiniteType Ω L_bar := Algebra.EssFiniteType.comp Ω D L_bar
      have hBijL : Function.Bijective (algebraMap Ω L_bar) :=
        Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing Ω L_bar
      let e_L : Ω ≃+* L_bar := RingEquiv.ofBijective _ hBijL
      let ev_q : B' →+* Ω := e_L.symm.toRingHom.comp ((algebraMap D L_bar).comp π_D)
      have hMaxBot : IsLocalRing.maximalIdeal L_bar = ⊥ := by
        ext z
        rw [Ideal.mem_bot]
        constructor
        · intro hz
          by_contra hne
          obtain ⟨c, hc⟩ := hBijL.2 z
          have hc_ne : c ≠ 0 := fun h0 => hne (by rw [← hc, h0, map_zero])
          have hunit : IsUnit z := by
            rw [← hc]
            exact (IsUnit.mk0 c hc_ne).map (algebraMap Ω L_bar)
          exact (IsLocalRing.notMem_maximalIdeal.mpr hunit) hz
        · rintro rfl
          exact (IsLocalRing.maximalIdeal L_bar).zero_mem
      have hker_evq : RingHom.ker ev_q = q₀.asIdeal := by
        ext b
        change e_L.symm (algebraMap D L_bar (π_D b)) = 0 ↔ b ∈ q₀.asIdeal
        rw [RingEquiv.map_eq_zero_iff, ← Ideal.mem_bot, ← hMaxBot,
          IsLocalization.AtPrime.to_map_mem_maximal_iff L_bar P_bar (π_D b),
          ← Ideal.mem_comap, hcomap_Pbar]
      have hevq_ψ₀ : ev_q.comp ψ₀ = ev₀ := by
        apply RingHom.ext
        intro r
        change e_L.symm (algebraMap D L_bar (π_D (ψ₀ r))) = ev₀ r
        rw [hπψ_eq r, ← IsScalarTower.algebraMap_apply Ω D L_bar (ev₀ r)]
        exact e_L.symm_apply_apply (ev₀ r)
      exact ⟨V_U, hVU, q₀, φ₀, ψ₀, ev_q, hq₀, hFac_φ₀, hEt_φ₀, hEt_ψ₀, hCompatΩ, hker_evq, hevq_ψ₀⟩
    have hClosed_y : IsClosed ({y} : Set C) := by
      obtain ⟨W_C, hWC, hy_WC, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
      have hy_range : y ∈ Set.range hWC.fromSpec.base := by
        rw [hWC.range_fromSpec]; exact hy_WC
      obtain ⟨p_y, hpy⟩ := hy_range
      obtain ⟨V_U, hVU, q₀, φ₀, ψ₀, ev_q, hq₀, hFac_φ₀, _, _, hCompatΩ, hker_evq, hevq_ψ₀⟩ :=
        hRoofFromOpenSpec (C.presheaf.obj (Opposite.op W_C)) hWC.fromSpec p_y hpy
      let ev_A : ↑(C.presheaf.obj (Opposite.op W_C)) →+* Ω := ev_q.comp φ₀
      let c_A := (AlgebraicGeometry.Spec.preimage (hWC.fromSpec ≫ g)).hom
      have hevA_comp : ev_A.comp c_A = RingHom.id Ω := by
        change (ev_q.comp φ₀).comp c_A = RingHom.id Ω
        rw [RingHom.comp_assoc, hCompatΩ, ← RingHom.comp_assoc, hevq_ψ₀]
        ext c
        exact hev₀_C c
      let s_y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_A) ≫ hWC.fromSpec
      have hsy_g : s_y ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
        calc s_y ≫ g
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_A) ≫
                AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (hWC.fromSpec ≫ g)) := by
              rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Spec.map_preimage]
