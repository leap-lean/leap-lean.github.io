          isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom := by
      refine hTransP1 _ _ e_red ?_ hP1_Esch
      rw [← CategoryTheory.Category.assoc, he_red]
    have hP1_1Ω : ∃ isoP1 : CategoryTheory.Limits.pullback (p_ℰ₁ i) (s_B ≫ f₁_B) ≅
          (weilProjectiveSpaceOver Ω 1).left,
        CategoryTheory.Limits.pullback.snd (p_ℰ₁ i) (s_B ≫ f₁_B) =
          isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom :=
      hTransP1 _ _ e_Ω (hFull_Ω.isoPullback_hom_snd) hP1_iΩ
    have hNo := hNonP1_1_Ω hNotP1_1gen Ω s_B
    dsimp only at hNo
    rw [hf₁B_eq] at hNo
    exact hNo hP1_1Ω

theorem weil_projLine_commRing_baseChange_proper_and_points : (∀ (R : Type u) [CommRing R],
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R 1).hom ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (weilProjectiveSpaceOver R 1).hom) ∧
    (∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S),
      ∃ (π_φ : (weilProjectiveSpaceOver S 1).left ⟶ (weilProjectiveSpaceOver R 1).left),
        CategoryTheory.IsPullback π_φ (weilProjectiveSpaceOver S 1).hom
          (weilProjectiveSpaceOver R 1).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))) ∧
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (∃ (σ₀ σ₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver Ω 1).left),
        σ₀ ≫ (weilProjectiveSpaceOver Ω 1).hom = 𝟙 _ ∧
        σ₁ ≫ (weilProjectiveSpaceOver Ω 1).hom = 𝟙 _ ∧
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), σ₀.base pt ≠ σ₁.base pt)) ∧
      (∀ w : ↥(weilProjectiveSpaceOver Ω 1).left,
        closure ({w} : Set ↥(weilProjectiveSpaceOver Ω 1).left) ≠ Set.univ →
        ∃ (σ_w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver Ω 1).left),
          σ_w ≫ (weilProjectiveSpaceOver Ω 1).hom = 𝟙 _ ∧
          ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), σ_w.base pt = w)) :=
by
  have halg0 : ∀ (R : Type u) [CommRing R] (r : R),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) R
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      ((algebraMap R ↥(𝒜 0) r : ↥(𝒜 0)) : MvPolynomial (Fin 2) R) = MvPolynomial.C r := by
    intro R _ r 𝒜
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    rw [Algebra.algebraMap_eq_smul_one]
    change r • (1 : MvPolynomial (Fin 2) R) = MvPolynomial.C r
    rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]

  have hval_fromZero : ∀ (R : Type u) [CommRing R]
      (S_sub : Submonoid (MvPolynomial (Fin 2) R))
      (z : ↥(MvPolynomial.homogeneousSubmodule (Fin 2) R 0)),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) R
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S_sub z).val = Localization.mk z.1 1 := by
    intro R _ S_sub z 𝒜
    rfl

  have hDehom : ∀ (R : Type u) [CommRing R],
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) R
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let hX : ∀ b : Fin 2, (MvPolynomial.X b : MvPolynomial (Fin 2) R) ∈ 𝒜 1 :=
        fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R b)
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) R)) ∧
        ∀ (a : Fin 2) (x : MvPolynomial (Fin 2) R) (hx_mem : x ∈ 𝒜 1),
          x = MvPolynomial.X a →
          ∃ (e : Polynomial R ≃+* HomogeneousLocalization.Away 𝒜 x),
            (∀ r : R, e (Polynomial.C r) =
              HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x)
                (algebraMap R ↥(𝒜 0) r)) ∧
            e Polynomial.X =
              HomogeneousLocalization.Away.mk 𝒜 hx_mem 1
                (MvPolynomial.X (1 - a)) (hX (1 - a)) := by
    intro R _ 𝒜 hX
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    constructor
    · intro p hp
      have hp0 : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hcoeff0 : p.coeff 0 = 0 := by
        classical
        have hdecomp := DirectSum.sum_support_decompose 𝒜 p
        rw [← hdecomp, MvPolynomial.coeff_sum]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = 0
        · subst hi
          rw [← GradedRing.proj_apply, hp0]
          simp
        · have hmem : ((DirectSum.decompose 𝒜 p i : ↥(𝒜 i)) : MvPolynomial (Fin 2) R) ∈ 𝒜 i :=
            (DirectSum.decompose 𝒜 p i).2
          have hhom : ((DirectSum.decompose 𝒜 p i : ↥(𝒜 i)) :
              MvPolynomial (Fin 2) R).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem
          by_contra hne
          have hdeg := hhom hne
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg
          exact hi hdeg.symm
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro hm0
        rw [hm0] at hm
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      by_contra hAll
      apply hm_ne
      ext j
      by_contra hj_ne
      exact hAll ⟨j, Set.mem_univ j, hj_ne⟩
    · intro a x hx_mem hx
      subst hx
      let b : Fin 2 := 1 - a
      have hba : b ≠ a := by fin_cases a <;> decide
      have hfin2 : ∀ j : Fin 2, j ≠ a ↔ j = b := by
        intro j
        fin_cases a <;> fin_cases j <;> decide
      let X_a : MvPolynomial (Fin 2) R := MvPolynomial.X a
      let S_a : Submonoid (MvPolynomial (Fin 2) R) := Submonoid.powers X_a
      let ι_a : R →+* HomogeneousLocalization.Away 𝒜 X_a :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a).comp (algebraMap R ↥(𝒜 0))
      let u_a : HomogeneousLocalization.Away 𝒜 X_a :=
        HomogeneousLocalization.Away.mk 𝒜 hx_mem 1 (MvPolynomial.X b) (hX b)
      let α : Polynomial R →+* HomogeneousLocalization.Away 𝒜 X_a :=
        Polynomial.eval₂RingHom ι_a u_a
      let w : Fin 2 → Polynomial R := fun j => if j = a then 1 else Polynomial.X
      let dehom : MvPolynomial (Fin 2) R →+* Polynomial R :=
        MvPolynomial.eval₂Hom Polynomial.C w
      have hy_one : ∀ y : S_a, dehom y.1 = 1 := by
        rintro ⟨_, n, rfl⟩
        simp [dehom, X_a, w]
      have hy_unit : ∀ y : S_a, IsUnit (dehom y.1) := by
        intro y
        rw [hy_one y]
        exact isUnit_one
      let β_loc : Localization S_a →+* Polynomial R := IsLocalization.lift hy_unit
      have hβ_mk : ∀ (p : MvPolynomial (Fin 2) R) (y : S_a),
          β_loc (Localization.mk p y) = dehom p := by
        intro p y
        rw [Localization.mk_eq_mk']
        exact (IsLocalization.lift_mk'_spec hy_unit p (dehom p) y).mpr
          (by rw [hy_one y, one_mul])
      let valHom : HomogeneousLocalization.Away 𝒜 X_a →+* Localization S_a :=
        algebraMap (HomogeneousLocalization 𝒜 S_a) (Localization S_a)
      have hvalHom : ∀ z : HomogeneousLocalization.Away 𝒜 X_a, valHom z = z.val :=
        fun z => HomogeneousLocalization.algebraMap_apply z
      let β : HomogeneousLocalization.Away 𝒜 X_a →+* Polynomial R :=
        β_loc.comp valHom
      have hLeft_hom : β.comp α = RingHom.id (Polynomial R) := by
        apply Polynomial.ringHom_ext'
        · ext r
          simp only [RingHom.comp_apply, RingHom.id_apply, α, β,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hvalHom, ι_a]
          rw [hval_fromZero R S_a (algebraMap R ↥(𝒜 0) r), halg0 R r,
            hβ_mk (MvPolynomial.C r) 1]
          simp [dehom]
        · simp only [RingHom.comp_apply, RingHom.id_apply, α, β,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hvalHom, u_a,
            HomogeneousLocalization.Away.val_mk]
          rw [hβ_mk (MvPolynomial.X b) _]
          simp [dehom, w, hba]
      have hLeft : Function.LeftInverse β α := fun q =>
        RingHom.congr_fun hLeft_hom q
      have hRight : Function.RightInverse β α := by
        intro z
        rcases subsingleton_or_nontrivial R with hSub | hNontriv
        · apply HomogeneousLocalization.val_injective S_a
          exact Subsingleton.elim _ _
        · let ψ : MvPolynomial (Fin 2) R →+* Localization S_a :=
            valHom.comp (α.comp dehom)
          let s₁ : S_a := ⟨X_a, Submonoid.mem_powers X_a⟩
          have hψ_C : ∀ r : R, ψ (MvPolynomial.C r) = Localization.mk (MvPolynomial.C r) 1 := by
            intro r
            simp only [ψ, RingHom.comp_apply, dehom, MvPolynomial.eval₂Hom_C, α,
              Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hvalHom, ι_a]
            rw [hval_fromZero R S_a (algebraMap R ↥(𝒜 0) r), halg0 R r]
          have hψ_X : ∀ j : Fin 2, ψ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) s₁ := by
            intro j
            by_cases hja : j = a
            · subst hja
              simp only [ψ, RingHom.comp_apply, dehom, MvPolynomial.eval₂Hom_X', w, ↓reduceIte,
                map_one]
              exact (Localization.mk_self s₁).symm
            · have hjb : j = b := (hfin2 j).mp hja
              subst hjb
              simp only [ψ, RingHom.comp_apply, dehom, MvPolynomial.eval₂Hom_X', w,
                if_neg hba, α, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hvalHom, u_a,
                HomogeneousLocalization.Away.val_mk]
              congr 1
              exact Subtype.ext (pow_one X_a)
          have hmk_sum : ∀ {ι : Type} (s : Finset ι) (f : ι → MvPolynomial (Fin 2) R) (y : S_a),
