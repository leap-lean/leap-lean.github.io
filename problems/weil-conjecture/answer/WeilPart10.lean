              rw [map_mul, MvPolynomial.map_C, hF₁]
        _ = MvPolynomial.C u * f := by
              dsimp [u]; rw [map_mul, MvPolynomial.C_mul]; ring
    have hD₀_map : map_κ D₀ = MvPolynomial.C u * g.1 := by
      calc map_κ (MvPolynomial.C s₁ * G₁)
          = MvPolynomial.C (algebraMap A₀ κ s₁) * (MvPolynomial.C (algebraMap A₀ κ s₂) * g.1) := by
              rw [map_mul, MvPolynomial.map_C, hG₁]
        _ = MvPolynomial.C u * g.1 := by
              dsimp [u]; rw [map_mul, MvPolynomial.C_mul]; ring
    have hD₀_bar : map_κ D₀ ∈ Q_bar.primeCompl := by
      change map_κ D₀ ∉ Q_bar
      intro hmem
      have hmul := Ideal.mul_mem_left Q_bar (MvPolynomial.C u⁻¹) hmem
      rw [hD₀_map, ← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hu_ne,
