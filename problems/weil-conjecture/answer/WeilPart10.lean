      haveI : IsScalarTower B₀ A₁ ↥(Algebra.adjoin B₀ (↑j_k.1 : Set K)) :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      have hCancelJ : ∀ z : D₁,
