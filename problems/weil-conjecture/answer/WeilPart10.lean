    have hSub : Set.range τ.base ⊆ Set.range ι.base := by
      rintro _ ⟨p, rfl⟩
      have hClPre : IsClosed (τ.base ⁻¹' Set.range ι.base) :=
        ((AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι).isClosed_range).preimage
          τ.continuous
      let p_bot : PrimeSpectrum B := ⟨⊥, inferInstance⟩
      have hp_bot_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)).base
