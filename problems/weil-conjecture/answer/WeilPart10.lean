          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
      rcases (hStab.2.2.2.2.2.2.2.2 Ω s₀).2.1 y with ⟨V_P, hy_VP, hSmP⟩ | hNod
      · exfalso
        let j : V_P.toScheme ⟶ C := V_P.ι ≫ fst
        haveI : AlgebraicGeometry.IsOpenImmersion j := inferInstance
        let V_sm : C.Opens := j.opensRange
        have hz_mem : z ∈ V_sm := by
          rw [AlgebraicGeometry.Scheme.Hom.mem_opensRange]
          refine ⟨⟨y, hy_VP⟩, ?_⟩
