        have hs₁w_not : s₁ * w_den ∉ p_P.asIdeal :=
          fun h => (p_P.isPrime.mem_or_mem h).elim hs₁_not hw_not_pP
        refine ⟨q₁, s₁ * w_den, hq₁_not, hs₁w_not, ?_⟩
        calc φ_a.hom (s₁ * w_den) * Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P))
            = φ_a.hom s₁ * (φ_a.hom w_den *
                Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P))) := by
              rw [map_mul, mul_assoc]
          _ = φ_a.hom (s₁ * r₁) := by rw [hw_Ψ, ← map_mul]
          _ = φ_a.hom q₁ * φ_a.hom t_P := by rw [hs₁r₁, map_mul]
    
    refine ⟨fun ⟨hx_not_node, hUnmarked⟩ => (hSmoothCase hx_not_node).1 hUnmarked, ?_⟩
    rintro (⟨r, hr⟩ | ⟨j, q, hτ_eq⟩)
    · 
      obtain ⟨A', instRingA', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hComm_g,
          i_br, K_br, instFieldK, instAlgΩK, instAlgFK, instTowerK, π_br, R_br,
          hCompat, hLocK, _hAllInR, hInvOut,
          ⟨w, w_inv, u_diff, u_inv, hw_R, hwinv_R, hww, hud_R, huinv_R, huu, htP_xbr, hDtP_xbr⟩,
          hUnitDesc⟩ :=
        hBrDVR (M.V a) (hAff a) α (hAffW α a) ha φ_a hSpec_a
          p_P t_P hP_closed ht_mem ht_not_sq r hr.symm
      letI : CommRing A' := instRingA'
      letI : Field K_br := instFieldK
      letI : Algebra Ω K_br := instAlgΩK
      letI : Algebra (F α) K_br := instAlgFK
      haveI : IsScalarTower Ω (F α) K_br := instTowerK
      let φ₁ : B_a →+* A' :=
        ((M.V a).topIso.inv ≫ e₁.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom
      let φ₂ : (MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
            Set (MvPolynomial (Fin 2) Ω))) →+* A' :=
        (AlgebraicGeometry.Spec.preimage e₂).hom
      let x_br : A' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i_br))
      letI : Algebra Ω A' := (φ₁.comp (algebraMap Ω B_a)).toAlgebra
      obtain ⟨ψ'_A, h_s, hhs_not, hψ'_compat, hξ_all⟩ :=
        hEtNode a A' u₀ e₁ e₂ hEt₁ hEt₂ hu₀ hComm_g
      obtain ⟨ξ, hξ_eq⟩ := hξ_all i_br
      obtain ⟨hLoc_a, hAlg_a⟩ := hGenLoc (M.V a) (hAff a) α (hAffW α a) ha φ_a hSpec_a
      
      obtain ⟨hs_inv, hsinv_R, hhs_mul⟩ := hInvOut h_s hhs_not
      have hhs_unit : IsUnit (π_br h_s) := isUnit_iff_exists_inv.mpr ⟨hs_inv, hhs_mul⟩
      let π_hs : Localization.Away h_s →+* K_br := IsLocalization.Away.lift h_s hhs_unit
      have hπ_hs_in_R : ∀ q : Localization.Away h_s, π_hs q ∈ R_br := by
        intro q
        obtain ⟨⟨a', ⟨_, m, rfl⟩⟩, hqm⟩ := IsLocalization.surj (Submonoid.powers h_s) q
        have hqm_K := congrArg π_hs hqm
        simp only [π_hs, map_mul, map_pow, IsLocalization.Away.lift_eq] at hqm_K
        have hq_eq : π_hs q = π_br a' * hs_inv ^ m := by
          calc π_hs q = π_hs q * (π_br h_s * hs_inv) ^ m := by rw [hhs_mul, one_pow, mul_one]
            _ = (π_hs q * (π_br h_s) ^ m) * hs_inv ^ m := by rw [mul_pow]; ring
            _ = π_br a' * hs_inv ^ m := by rw [hqm_K]
        rw [hq_eq]
        exact R_br.mul_mem (_hAllInR a') (R_br.pow_mem hsinv_R m)
      let z_ξ : K_br := π_hs ξ.val
      let z_ξ_inv : K_br := π_hs (↑ξ⁻¹ : Localization.Away h_s)
      have hz_ξ_R : z_ξ ∈ R_br := hπ_hs_in_R ξ.val
      have hz_ξ_inv_R : z_ξ_inv ∈ R_br := hπ_hs_in_R (↑ξ⁻¹)
      have hz_ξ_mul : z_ξ * z_ξ_inv = 1 := by
        change π_hs ξ.val * π_hs (↑ξ⁻¹) = 1
        rw [← map_mul, Units.mul_inv, map_one]
      have hπ_ψ'_xbr : π_br (ψ'_A (KaehlerDifferential.D Ω A' x_br)) = z_ξ * π_br x_br := by
        have h := congrArg π_hs hξ_eq
        simpa only [π_hs, z_ξ, map_mul, IsLocalization.Away.lift_eq] using h
      
      have hAlgΩ_A' : ∀ c : Ω, π_br (algebraMap Ω A' c) = algebraMap Ω K_br c := by
        intro c
        change π_br (φ₁ (algebraMap Ω B_a c)) = algebraMap Ω K_br c
        have hAlg_a_c : φ_a.hom (((ν α).app (M.V a)).hom (algebraMap Ω B_a c)) =
            algebraMap Ω (F α) c := hAlg_a c
        rw [hCompat (algebraMap Ω B_a c), hAlg_a_c, IsScalarTower.algebraMap_apply Ω (F α) K_br c]
      obtain ⟨Ψ_K, hΨ_K⟩ := hMakeLift A' K_br π_br hAlgΩ_A' hLocK ψ'_A
      
      have hAgree_FK : ∀ z : F α,
          Ψ_K (KaehlerDifferential.D Ω K_br (algebraMap (F α) K_br z)) =
            algebraMap (F α) K_br (Ψ_log α a ha (KaehlerDifferential.D Ω (F α) z)) := by
        have hAgree_B : ∀ b : B_a,
            Ψ_K (KaehlerDifferential.D Ω K_br
              (algebraMap (F α) K_br (φ_a.hom (((ν α).app (M.V a)).hom b)))) =
              algebraMap (F α) K_br
                (Ψ_log α a ha (KaehlerDifferential.D Ω (F α)
                  (φ_a.hom (((ν α).app (M.V a)).hom b)))) := by
          intro b
          rw [← hCompat b, hΨ_K (φ₁ b), hψ'_compat b, hCompat _,
            hΨ_log α a ha φ_a hSpec_a b]
        intro z
        let θ_a : B_a →+* F α := φ_a.hom.comp (((ν α).app (M.V a)).hom)
        letI : Algebra B_a (F α) := θ_a.toAlgebra
        letI : (RingHom.ker θ_a).IsPrime := RingHom.ker_isPrime θ_a
        haveI : IsLocalization (RingHom.ker θ_a).primeCompl (F α) := hLoc_a
        obtain ⟨⟨b, s⟩, hzs⟩ := IsLocalization.surj (RingHom.ker θ_a).primeCompl z
        have hs_ne : θ_a (s : B_a) ≠ 0 := s.2
        have hs_K_ne : algebraMap (F α) K_br (θ_a (s : B_a)) ≠ 0 :=
          fun h0 => hs_ne ((RingHom.injective (algebraMap (F α) K_br))
            (h0.trans (map_zero _).symm))
        have hzs_F : z * θ_a (s : B_a) = θ_a b := hzs
        have hzs_K : algebraMap (F α) K_br z * algebraMap (F α) K_br (θ_a (s : B_a)) =
            algebraMap (F α) K_br (θ_a b) := by
          rw [← map_mul, hzs_F]
        have hd_F := congrArg (fun u => algebraMap (F α) K_br
          (Ψ_log α a ha (KaehlerDifferential.D Ω (F α) u))) hzs_F
        rw [Derivation.leibniz, map_add, LinearMap.map_smul, LinearMap.map_smul,
          smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul] at hd_F
        have hd_K := congrArg (fun u => Ψ_K (KaehlerDifferential.D Ω K_br u)) hzs_K
        rw [Derivation.leibniz, map_add, LinearMap.map_smul, LinearMap.map_smul,
          smul_eq_mul, smul_eq_mul] at hd_K
        dsimp only [θ_a, RingHom.comp_apply] at hd_F hd_K
        rw [hAgree_B b, hAgree_B (s : B_a)] at hd_K
        apply mul_left_cancel₀ hs_K_ne
        linear_combination hd_K - hd_F
      
      have htP_ne : t_P ≠ 0 := fun h0 => ht_not_sq (h0 ▸ (p_P.asIdeal ^ 2).zero_mem)
      have hφtP_ne : φ_a.hom t_P ≠ 0 :=
        fun h0 => htP_ne (hInj_φa (h0.trans (map_zero _).symm))
      have hVal_K : algebraMap (F α) K_br
          (Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P))) =
          (u_diff * z_ξ * w_inv) * algebraMap (F α) K_br (φ_a.hom t_P) := by
        rw [← hAgree_FK (φ_a.hom t_P), hDtP_xbr, LinearMap.map_smul, smul_eq_mul,
          hΨ_K x_br, hπ_ψ'_xbr, htP_xbr]
        have hw_xbr : w_inv * (w * π_br x_br) = π_br x_br := by
          rw [← mul_assoc, mul_comm w_inv w, hww, one_mul]
        calc u_diff * (z_ξ * π_br x_br)
            = u_diff * (z_ξ * (w_inv * (w * π_br x_br))) := by rw [hw_xbr]
          _ = (u_diff * z_ξ * w_inv) * (w * π_br x_br) := by ring
      let y_rat : F α := Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P)) / φ_a.hom t_P
      have hy_K : algebraMap (F α) K_br y_rat = u_diff * z_ξ * w_inv := by
        have hφtP_K_ne : algebraMap (F α) K_br (φ_a.hom t_P) ≠ 0 :=
          fun h0 => hφtP_ne ((RingHom.injective (algebraMap (F α) K_br))
            (h0.trans (map_zero _).symm))
        apply mul_right_cancel₀ hφtP_K_ne
        have hy_mul : y_rat * φ_a.hom t_P =
            Ψ_log α a ha (KaehlerDifferential.D Ω (F α) (φ_a.hom t_P)) :=
          div_mul_cancel₀ _ hφtP_ne
        rw [← map_mul, hy_mul, hVal_K]
      have hy_in_R : algebraMap (F α) K_br y_rat ∈ R_br := by
        rw [hy_K]
        exact R_br.mul_mem (R_br.mul_mem hud_R hz_ξ_R) hwinv_R
      have hy_inv_R : ∃ y_inv : K_br, y_inv ∈ R_br ∧ algebraMap (F α) K_br y_rat * y_inv = 1 := by
        refine ⟨w * z_ξ_inv * u_inv, R_br.mul_mem (R_br.mul_mem hw_R hz_ξ_inv_R) huinv_R, ?_⟩
        rw [hy_K]
        calc (u_diff * z_ξ * w_inv) * (w * z_ξ_inv * u_inv)
            = u_diff * (z_ξ * ((w_inv * w) * z_ξ_inv)) * u_inv := by ring
          _ = u_diff * (z_ξ * z_ξ_inv) * u_inv := by rw [mul_comm w_inv w, hww, one_mul]
          _ = u_diff * u_inv := by rw [hz_ξ_mul, mul_one]
