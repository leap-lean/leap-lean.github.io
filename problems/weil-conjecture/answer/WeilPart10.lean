      rw [← CategoryTheory.cancel_epi iso_VS.inv]
      have hjS_ι : iso_VS.inv ≫ (V_S a).ι = j_S a :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_S
          (f_gr (MvPolynomial.X a)) (f_gr.map_mem (hX_R a)) zero_lt_one
      rw [← CategoryTheory.Category.assoc iso_VS.inv, ← CategoryTheory.Category.assoc iso_VS.inv,
        hjS_ι]
      have hmap_a : j_S a ≫ π_φ =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
          j_R a :=
        AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one (MvPolynomial.X a) (hX_R a)
      rw [← CategoryTheory.Category.assoc (j_S a) π_φ, hmap_a, CategoryTheory.Category.assoc,
        (hSpecPB a).w, CategoryTheory.Category.assoc]

    let Q := CategoryTheory.Limits.pullback p_R f_φ
    let p₁ := CategoryTheory.Limits.pullback.fst p_R f_φ
    let p₂ := CategoryTheory.Limits.pullback.snd p_R f_φ
    let Φ : P_S ⟶ Q := CategoryTheory.Limits.pullback.lift π_φ p_S hComm
    let D_R : Fin 2 → P_R.Opens :=
      fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_R (MvPolynomial.X a)
    have hDR_top : iSup D_R = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_R MvPolynomial.X (hDehom R).1
    let W : Fin 2 → Q.Opens :=
      fun a => (TopologicalSpace.Opens.map p₁.base).obj (D_R a)
    have hW_top : iSup W = ⊤ := by
      apply le_antisymm le_top
      intro q _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hq : p₁.base q ∈ (⊤ : P_R.Opens) := trivial
