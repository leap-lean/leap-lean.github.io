      have hα_mem : α ∈ S₀ := by
        have hcoeff_in : ∀ i ∈ Finset.range d₀,
            ∃ a : R₀, algebraMap R₀ E₀ a = algebraMap R₀ E₀ b₀ * P_α₀.coeff i := by
          intro i hi
          exact hb₀_mult (P_α₀.coeff i) (Finset.mem_image_of_mem _ hi)
        let a_fn : ℕ → R₀ := fun i =>
          if hi : i ∈ Finset.range d₀ then Classical.choose (hcoeff_in i hi) else 0
        let Q_α : Polynomial R₀ :=
          Polynomial.X ^ d₀ +
            ∑ i ∈ Finset.range d₀, Polynomial.C (a_fn i * (b₀ : R₀) ^ (d₀ - 1 - i)) * Polynomial.X ^ i
        have hQ_monic : Q_α.Monic := by
          apply Polynomial.monic_X_pow_add
          apply (Polynomial.degree_sum_le _ _).trans_lt
          apply (Finset.sup_lt_iff (WithBot.bot_lt_coe d₀)).mpr
          intro i hi
          have hi_lt : i < d₀ := Finset.mem_range.mp hi
          calc (Polynomial.C (a_fn i * (b₀ : R₀) ^ (d₀ - 1 - i)) * Polynomial.X ^ i).degree
              ≤ (Polynomial.C (a_fn i * (b₀ : R₀) ^ (d₀ - 1 - i))).degree +
                  (Polynomial.X ^ i : Polynomial R₀).degree := Polynomial.degree_mul_le _ _
            _ ≤ 0 + (i : WithBot ℕ) := add_le_add Polynomial.degree_C_le (by simp)
            _ < (d₀ : WithBot ℕ) := by simp [hi_lt]
        refine ⟨Q_α, hQ_monic, ?_⟩
        change Polynomial.aeval α Q_α = 0
        rw [show Q_α = Polynomial.X ^ d₀ +
            ∑ i ∈ Finset.range d₀, Polynomial.C (a_fn i * (b₀ : R₀) ^ (d₀ - 1 - i)) * Polynomial.X ^ i from rfl,
          map_add, map_pow, Polynomial.aeval_X, map_sum]
        simp only [Polynomial.aeval_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
        have hsum_eq :
            (∑ i ∈ Finset.range d₀,
              algebraMap R₀ E (a_fn i * (b₀ : R₀) ^ (d₀ - 1 - i)) * α ^ i) =
            (algebraMap R₀ E b₀) ^ d₀ *
              (∑ i ∈ Finset.range d₀, algebraMap E₀ E (P_α₀.coeff i) * α₀ ^ i) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_lt : i < d₀ := Finset.mem_range.mp hi
          have ha_i : algebraMap R₀ E₀ (a_fn i) = algebraMap R₀ E₀ b₀ * P_α₀.coeff i := by
            simp only [a_fn, hi, ↓reduceDIte]
            exact Classical.choose_spec (hcoeff_in i hi)
          dsimp [α]
          rw [map_mul, map_pow, IsScalarTower.algebraMap_apply R₀ E₀ E (a_fn i), ha_i,
            map_mul, ← IsScalarTower.algebraMap_apply R₀ E₀ E b₀, mul_pow]
          have hexp : (algebraMap R₀ E b₀) * (algebraMap R₀ E b₀) ^ (d₀ - 1 - i) *
              (algebraMap R₀ E b₀) ^ i = (algebraMap R₀ E b₀) ^ d₀ := by
            rw [← pow_succ', ← pow_add]
            congr 1; omega
          calc algebraMap R₀ E b₀ * algebraMap E₀ E (P_α₀.coeff i) *
                (algebraMap R₀ E b₀) ^ (d₀ - 1 - i) * ((algebraMap R₀ E b₀) ^ i * α₀ ^ i)
              = ((algebraMap R₀ E b₀) * (algebraMap R₀ E b₀) ^ (d₀ - 1 - i) *
                  (algebraMap R₀ E b₀) ^ i) * (algebraMap E₀ E (P_α₀.coeff i) * α₀ ^ i) := by ring
            _ = (algebraMap R₀ E b₀) ^ d₀ * (algebraMap E₀ E (P_α₀.coeff i) * α₀ ^ i) := by
                rw [hexp]
        rw [hsum_eq]
        have hα_pow : α ^ d₀ = (algebraMap R₀ E b₀) ^ d₀ * α₀ ^ d₀ := mul_pow _ _ _
        rw [hα_pow, ← mul_add]
        have hmin_eval : α₀ ^ d₀ + ∑ i ∈ Finset.range d₀, algebraMap E₀ E (P_α₀.coeff i) * α₀ ^ i =
            Polynomial.aeval α₀ P_α₀ := by
          rw [Polynomial.aeval_eq_sum_range' (Nat.lt_succ_self d₀), Finset.sum_range_succ, add_comm]
          simp only [d₀]
          rw [show P_α₀.coeff P_α₀.natDegree = 1 from hP_α₀_monic.leadingCoeff, one_smul]
          congr 1
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Algebra.smul_def]
        rw [hmin_eval, minpoly.aeval E₀ α₀, mul_zero]
      have hα_prim : IntermediateField.adjoin E₀ ({α} : Set E) = ⊤ := by
        rw [eq_top_iff, ← hα₀_prim]
        apply IntermediateField.adjoin_le_iff.mpr
        intro x hx
        rw [Set.mem_singleton_iff.mp hx]
        have hα_in : α ∈ IntermediateField.adjoin E₀ ({α} : Set E) :=
          IntermediateField.subset_adjoin E₀ ({α} : Set E) (Set.mem_singleton α)
        have hb_inv_in : algebraMap E₀ E (algebraMap R₀ E₀ b₀)⁻¹ ∈
            IntermediateField.adjoin E₀ ({α} : Set E) :=
          (IntermediateField.adjoin E₀ ({α} : Set E)).algebraMap_mem _
        have hprod : algebraMap E₀ E (algebraMap R₀ E₀ b₀)⁻¹ * α = α₀ := by
          dsimp [α]
          rw [IsScalarTower.algebraMap_apply R₀ E₀ E b₀, ← mul_assoc, ← map_mul,
            inv_mul_cancel₀ hb₀_E₀_ne, map_one, one_mul]
        rw [← hprod]
        exact (IntermediateField.adjoin E₀ ({α} : Set E)).mul_mem hb_inv_in hα_in
      let P₀ : Polynomial E₀ := minpoly E₀ α
      have hα_int_E₀ : IsIntegral E₀ α := Algebra.IsIntegral.isIntegral α
      have hP₀_monic : P₀.Monic := minpoly.monic hα_int_E₀
      have hP₀_pos : 0 < P₀.natDegree := minpoly.natDegree_pos hα_int_E₀
      have hP₀_sep : P₀.Separable := Algebra.IsSeparable.isSeparable E₀ α
      obtain ⟨Q₂, Q₁, hBez₀⟩ := hP₀_sep
      have haeval_surj : Function.Surjective (Polynomial.aeval α : Polynomial E₀ →ₐ[E₀] E) := by
        let A_α : Subalgebra E₀ E := Algebra.adjoin E₀ ({α} : Set E)
        have hA_le_IC : A_α ≤ integralClosure E₀ E :=
          Algebra.adjoin_le (Set.singleton_subset_iff.mpr hα_int_E₀)
        have _ : Algebra.IsIntegral E₀ ↥A_α :=
          ⟨fun u => by
            obtain ⟨P_u, hPu_monic, hPu_eval⟩ := hA_le_IC u.2
            refine ⟨P_u, hPu_monic, Subtype.ext ?_⟩
            have h1 := Polynomial.hom_eval₂ P_u (algebraMap E₀ ↥A_α) A_α.val.toRingHom u
            change A_α.val.toRingHom (Polynomial.eval₂ (algebraMap E₀ ↥A_α) u P_u) = 0
            rw [h1]
            exact hPu_eval⟩
        have hField_A : IsField ↥A_α :=
          (Algebra.IsIntegral.isField_iff_isField (R := E₀) (S := ↥A_α)
            (algebraMap E₀ ↥A_α).injective).mp (Field.toIsField E₀)
        let F_α : IntermediateField E₀ E :=
          { A_α with
            inv_mem' := fun x hx => by
              by_cases hx0 : x = 0
              · rw [hx0, inv_zero]; exact A_α.zero_mem
              · have hux : (⟨x, hx⟩ : ↥A_α) ≠ 0 := fun h => hx0 (congrArg Subtype.val h)
                obtain ⟨v, hv⟩ := hField_A.mul_inv_cancel hux
                have hxv : x * v.1 = 1 := congrArg Subtype.val hv
                have hinv_eq : x⁻¹ = v.1 := inv_eq_of_mul_eq_one_right hxv
                rw [hinv_eq]; exact v.2 }
        have hF_top : F_α = ⊤ := eq_top_iff.mpr (by
          rw [← hα_prim]
          exact IntermediateField.adjoin_le_iff.mpr
            (Set.singleton_subset_iff.mpr (Algebra.subset_adjoin (Set.mem_singleton α))))
        intro x
        have hx : x ∈ Algebra.adjoin E₀ ({α} : Set E) := by
          change x ∈ F_α
          rw [hF_top]; trivial
        rwa [Algebra.adjoin_singleton_eq_range_aeval] at hx
      obtain ⟨G_S₀, hG_S₀⟩ := Module.Finite.fg_top (R := R₀) (M := ↥S₀)
      let t_gen := G_S₀.card
      let e_gen : Fin t_gen ≃ ↥G_S₀ := G_S₀.equivFin.symm
      let s_gen : Fin t_gen → ↥S₀ := fun ℓ => (e_gen ℓ).1
      have hH_ex : ∀ ℓ : Fin t_gen, ∃ H : Polynomial E₀, Polynomial.aeval α H = (s_gen ℓ).1 :=
        fun ℓ => haeval_surj (s_gen ℓ).1
      let H_gen : Fin t_gen → Polynomial E₀ := fun ℓ => Classical.choose (hH_ex ℓ)
      have hH_spec : ∀ ℓ : Fin t_gen, Polynomial.aeval α (H_gen ℓ) = (s_gen ℓ).1 :=
        fun ℓ => Classical.choose_spec (hH_ex ℓ)
      let P_set : Finset (Polynomial E₀) := {P₀, Q₁, Q₂} ∪ Finset.univ.image H_gen
      let C_all : Finset E₀ := P_set.biUnion (fun p => p.support.image p.coeff)
      obtain ⟨r_nzd, hr_mult⟩ :=
        IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors R₀) C_all
      let rs : R₀ := r_nzd.1
      have hrs_ne : rs ≠ 0 := nonZeroDivisors.ne_zero r_nzd.2
      let U_et : Z.left.Opens := Z.left.basicOpen rs
      have hU_et_le : U_et ≤ U₀ := Z.left.basicOpen_le rs
      have hAff_et : AlgebraicGeometry.IsAffineOpen U_et := hAffU₀.basicOpen rs
      have hU_et_ne : Nonempty ↥U_et := by
        let ptR₀ : ↥(AlgebraicGeometry.Spec (Z.left.presheaf.obj (Opposite.op U₀))) :=
          (⊥ : PrimeSpectrum R₀)
        have hbot_in : hAffU₀.fromSpec.base ptR₀ ∈ U_et := by
          change ptR₀ ∈ (TopologicalSpace.Opens.map hAffU₀.fromSpec.base).obj (Z.left.basicOpen rs)
          rw [hAffU₀.fromSpec_preimage_basicOpen rs]
          change rs ∉ (⊥ : Ideal R₀)
          rwa [Ideal.mem_bot]
        exact ⟨⟨_, hbot_in⟩⟩
      have hSurj_res : AlgebraicGeometry.Surjective (ν.left ∣_ U_et) := by
        constructor
        rintro ⟨z, hz⟩
        obtain ⟨y, rfl⟩ := hSurjν.surj z
        refine ⟨⟨y, hz⟩, ?_⟩
        apply Subtype.ext
        change ((ν.left ∣_ U_et) ≫ U_et.ι).base ⟨y, hz⟩ = _
        rw [AlgebraicGeometry.morphismRestrict_ι]
        rfl
      refine ⟨U_et, hU_et_ne, inferInstance, ?_, hSurj_res⟩
      obtain ⟨φ_s, hFrac_s, hφ_s_spec⟩ := hFuncE₀ U_et hAff_et hU_et_ne
      obtain ⟨_, _, _, iso_W_et, hν₀_app_et, _⟩ :=
        hChart U_et hAff_et hU_et_ne φ_s hFrac_s hφ_s_spec
      let R_s := ↑(Z.left.presheaf.obj (Opposite.op U_et))
      have _ : IsDomain R_s := @AlgebraicGeometry.IsIntegral.component_integral Z.left hIntZ U_et hU_et_ne
      let res_s := Z.left.presheaf.map (CategoryTheory.homOfLE hU_et_le).op
      let _ : Algebra R₀ R_s := res_s.hom.toAlgebra
      have _ : IsLocalization.Away rs R_s := hAffU₀.isLocalization_basicOpen rs
      let _ : Algebra R_s E₀ := φ_s.hom.toAlgebra
      have _ : IsFractionRing R_s E₀ := hFrac_s
      let _ : Algebra R_s E := ((algebraMap E₀ E).comp φ_s.hom).toAlgebra
      have _ : IsScalarTower R_s E₀ E := IsScalarTower.of_algebraMap_eq' rfl
      have hres_φ : res_s ≫ φ_s = φ₀ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [← cancel_mono hAffU₀.fromSpec, AlgebraicGeometry.Spec.map_comp, Category.assoc]
        dsimp [res_s]
        rw [hAffU₀.map_fromSpec hAff_et (CategoryTheory.homOfLE hU_et_le).op,
          hφ_s_spec, hφ₀_spec]
      have _ : IsScalarTower R₀ R_s E₀ :=
        IsScalarTower.of_algebraMap_eq (fun a => by
          change φ₀.hom a = φ_s.hom (res_s.hom a)
          rw [← hres_φ]; rfl)
      have _ : IsScalarTower R₀ R_s E :=
        IsScalarTower.of_algebraMap_eq (fun a => by
          rw [IsScalarTower.algebraMap_apply R₀ E₀ E, IsScalarTower.algebraMap_apply R₀ R_s E₀,
            ← IsScalarTower.algebraMap_apply R_s E₀ E])
      have hφ_s_inj : Function.Injective (algebraMap R_s E₀) := IsFractionRing.injective R_s E₀
      have hr_unit : IsUnit (algebraMap R₀ R_s rs) :=
        IsLocalization.Away.algebraMap_isUnit rs
      have h_lift_poly : ∀ p ∈ P_set, ∃ p_s : Polynomial R_s,
          p_s.map (algebraMap R_s E₀) = p := by
        intro p hp
        have hcoeff : ∀ n : ℕ, ∃ c_s : R_s, algebraMap R_s E₀ c_s = p.coeff n := by
          intro n
          by_cases hn : n ∈ p.support
          · have hc_mem : p.coeff n ∈ C_all :=
              Finset.mem_biUnion.mpr ⟨p, hp, Finset.mem_image_of_mem _ hn⟩
            obtain ⟨a_n, ha_n⟩ := hr_mult (p.coeff n) hc_mem
            refine ⟨algebraMap R₀ R_s a_n * ↑hr_unit.unit⁻¹, ?_⟩
            rw [map_mul, ← IsScalarTower.algebraMap_apply R₀ R_s E₀, ha_n]
            change (algebraMap R₀ E₀ rs * p.coeff n) *
              algebraMap R_s E₀ ↑hr_unit.unit⁻¹ = p.coeff n
            rw [mul_comm (algebraMap R₀ E₀ rs), mul_assoc,
              IsScalarTower.algebraMap_apply R₀ R_s E₀ rs, ← map_mul,
              show algebraMap R₀ R_s rs * ↑hr_unit.unit⁻¹ = 1 from hr_unit.mul_val_inv,
              map_one, mul_one]
          · rw [Polynomial.notMem_support_iff.mp hn]
            exact ⟨0, map_zero _⟩
        refine ⟨∑ n ∈ p.support, Polynomial.monomial n (Classical.choose (hcoeff n)), ?_⟩
        rw [Polynomial.map_sum]
        conv_rhs => rw [p.as_sum_support]
        refine Finset.sum_congr rfl fun n _ => ?_
        rw [Polynomial.map_monomial, Classical.choose_spec (hcoeff n)]
      obtain ⟨P_s, hP_s_map⟩ := h_lift_poly P₀ (by simp [P_set])
      obtain ⟨Q₁_s, hQ₁_s_map⟩ := h_lift_poly Q₁ (by simp [P_set])
      obtain ⟨Q₂_s, hQ₂_s_map⟩ := h_lift_poly Q₂ (by simp [P_set])
      have hH_lift : ∀ ℓ : Fin t_gen, ∃ H_s : Polynomial R_s,
          H_s.map (algebraMap R_s E₀) = H_gen ℓ :=
        fun ℓ => h_lift_poly (H_gen ℓ) (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ ℓ)))
      let H_s : Fin t_gen → Polynomial R_s := fun ℓ => Classical.choose (hH_lift ℓ)
      have hH_s_map : ∀ ℓ : Fin t_gen, (H_s ℓ).map (algebraMap R_s E₀) = H_gen ℓ :=
        fun ℓ => Classical.choose_spec (hH_lift ℓ)
      have hP_s_deg : P_s.natDegree = P₀.natDegree := by
        rw [← hP_s_map, Polynomial.natDegree_map_eq_of_injective hφ_s_inj]
      have hP_s_monic : P_s.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff, hP_s_deg]
        apply hφ_s_inj
        rw [map_one, ← Polynomial.coeff_map, hP_s_map]
        exact hP₀_monic.leadingCoeff
      have hP_s_ne_one : P_s ≠ 1 := by
        intro h1
        have : P_s.natDegree = 0 := by rw [h1, Polynomial.natDegree_one]
        omega
      have hBez_s : P_s.derivative * Q₁_s + P_s * Q₂_s = (1 : Polynomial R_s) ^ 1 := by
        apply Polynomial.map_injective (algebraMap R_s E₀) hφ_s_inj
        simp only [Polynomial.map_add, Polynomial.map_mul,
          hP_s_map, hQ₁_s_map, hQ₂_s_map, pow_one, Polynomial.map_one]
        rw [← Polynomial.derivative_map, hP_s_map, mul_comm P₀.derivative, mul_comm P₀, add_comm]
        exact hBez₀
      let P_et : StandardEtalePair R_s :=
        StandardEtalePair.mk P_s hP_s_monic 1 ⟨Q₁_s, Q₂_s, 1, hBez_s⟩
      have _ : Algebra.Etale R_s P_et.Ring := inferInstance
      have hRoot_map : P_et.HasMap (AdjoinRoot.root P_s) := by
        refine ⟨?_, ?_⟩
        · change Polynomial.aeval (AdjoinRoot.root P_s) P_s = 0
          rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
        · change IsUnit (Polynomial.aeval (AdjoinRoot.root P_s) (1 : Polynomial R_s))
          simp
      let φ_to_adj : P_et.Ring →ₐ[R_s] AdjoinRoot P_s :=
        P_et.homEquiv.symm ⟨AdjoinRoot.root P_s, hRoot_map⟩
      have hPet_X_root : Polynomial.aeval P_et.X P_s = 0 := P_et.hasMap_X.1
      let φ_from_adj : AdjoinRoot P_s →ₐ[R_s] P_et.Ring :=
        AdjoinRoot.liftAlgHom P_s (Algebra.ofId R_s P_et.Ring) P_et.X hPet_X_root
      have hφ_to_X : φ_to_adj P_et.X = AdjoinRoot.root P_s := by
        have := P_et.homEquiv.apply_symm_apply ⟨AdjoinRoot.root P_s, hRoot_map⟩
        exact (StandardEtalePair.homEquiv_apply_coe P_et φ_to_adj).symm.trans (congrArg Subtype.val this)
      let e_Pet_adj : P_et.Ring ≃ₐ[R_s] AdjoinRoot P_s :=
        AlgEquiv.ofAlgHom φ_to_adj φ_from_adj
          (by
            apply AdjoinRoot.algHom_ext
            simp only [AlgHom.comp_apply, AlgHom.id_apply, φ_from_adj]
            rw [AdjoinRoot.liftAlgHom_root P_s (Algebra.ofId R_s P_et.Ring) P_et.X hPet_X_root]
            exact hφ_to_X)
          (P_et.homEquiv.injective (Subtype.ext (by
            rw [StandardEtalePair.homEquiv_apply_coe, StandardEtalePair.homEquiv_apply_coe]
            simp only [AlgHom.comp_apply, AlgHom.id_apply, hφ_to_X, φ_from_adj]
            exact AdjoinRoot.liftAlgHom_root P_s (Algebra.ofId R_s P_et.Ring) P_et.X hPet_X_root)))
      let S_s := integralClosure R_s E
      let α_s : ↥S_s := ⟨α, hα_mem.tower_top⟩
      have hα_s_root : Polynomial.aeval α_s P_s = 0 := by
        apply Subtype.ext
        change S_s.val (Polynomial.aeval α_s P_s) = 0
        rw [← Polynomial.aeval_algHom_apply S_s.val α_s P_s]
        change Polynomial.aeval α P_s = 0
        rw [Polynomial.aeval_def, IsScalarTower.algebraMap_eq R_s E₀ E, ← Polynomial.eval₂_map,
          hP_s_map, ← Polynomial.aeval_def]
        exact minpoly.aeval E₀ α
      let ψ_adj : AdjoinRoot P_s →ₐ[R_s] ↥S_s :=
        AdjoinRoot.liftAlgHom P_s (Algebra.ofId R_s ↥S_s) α_s hα_s_root
      have hψ_adj_mk : ∀ F : Polynomial R_s, (ψ_adj (AdjoinRoot.mk P_s F)).1 = Polynomial.aeval α F := by
        have hψ_root : ψ_adj (AdjoinRoot.root P_s) = α_s :=
          AdjoinRoot.liftAlgHom_root P_s (Algebra.ofId R_s ↥S_s) α_s hα_s_root
        intro F
        have h1 : ψ_adj (AdjoinRoot.mk P_s F) = Polynomial.aeval α_s F := by
          refine Polynomial.induction_on' F
            (fun p q hp hq => by rw [map_add, map_add, map_add, hp, hq])
            (fun n r => ?_)
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_mul, map_pow,
            AdjoinRoot.mk_C, ← AdjoinRoot.algebraMap_eq, AdjoinRoot.mk_X, map_pow,
            AlgHom.commutes, hψ_root,
            Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
        rw [h1]
        change S_s.val (Polynomial.aeval α_s F) = Polynomial.aeval α F
        exact (Polynomial.aeval_algHom_apply S_s.val α_s F).symm
      have hψ_inj : Function.Injective ψ_adj := by
        change Function.Injective ψ_adj.toRingHom
        rw [RingHom.injective_iff_ker_eq_bot ψ_adj.toRingHom, eq_bot_iff]
        intro z hz
        obtain ⟨F, rfl⟩ := AdjoinRoot.mk_surjective z
        let R_rem : Polynomial R_s := F %ₘ P_s
        have hdiv := Polynomial.modByMonic_add_div F P_s
        have hmk_eq : AdjoinRoot.mk P_s F = AdjoinRoot.mk P_s R_rem := by
          rw [← hdiv, map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
        rw [hmk_eq] at hz ⊢
        have heval0 : Polynomial.aeval α R_rem = 0 := by
          rw [← hψ_adj_mk R_rem]
          exact congrArg Subtype.val hz
        have heval_E₀ : Polynomial.aeval α (R_rem.map (algebraMap R_s E₀)) = 0 := by
          rw [Polynomial.aeval_def, Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq R_s E₀ E,
            ← Polynomial.aeval_def, heval0]
        have hdvd : P₀ ∣ R_rem.map (algebraMap R_s E₀) := minpoly.dvd E₀ α heval_E₀
        have hR_zero : R_rem = 0 := by
          by_contra hR_ne
          have hmap_ne : R_rem.map (algebraMap R_s E₀) ≠ 0 := by
            intro h0
            exact hR_ne (Polynomial.map_injective _ hφ_s_inj (h0.trans (Polynomial.map_zero _).symm))
          have hdeg_le := Polynomial.natDegree_le_of_dvd hdvd hmap_ne
