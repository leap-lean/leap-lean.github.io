    let s_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ S := f_AK ≫ hU₀.fromSpec
    haveI : AlgebraicGeometry.IsOpenImmersion hU₀.fromSpec := hU₀.isOpenImmersion_fromSpec
