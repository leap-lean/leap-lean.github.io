      apply congrArg CommRingCat.ofHom
      apply RingHom.ext
      intro r
      change e_a.symm (HomogeneousLocalization.fromZeroRingHom 𝒜 _ (algebraMap R ↥(𝒜 0) r)) =
        Polynomial.C r
      rw [← he_C r, e_a.symm_apply_apply]
    refine ⟨iso_a, hinv, ?_⟩
    rw [← hinv, iso_a.hom_inv_id_assoc]

