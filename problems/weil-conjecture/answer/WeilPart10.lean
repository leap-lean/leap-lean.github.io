      have hx_top : x ∈ (⊤ : P_S.Opens) := trivial
      rw [← hVS_top, TopologicalSpace.Opens.mem_iSup] at hx_top
      obtain ⟨a, hxa⟩ := hx_top
      refine ⟨V_S a, hxa, ?_⟩
      let iso_VS := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_S
