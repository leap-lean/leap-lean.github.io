        rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · change MvPolynomial.constantCoeff (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) Ω) = 0
          simp
        · change MvPolynomial.constantCoeff (MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) Ω) = 0
          simp
      let ev_quot : ((MvPolynomial (Fin 2) Ω ⧸ I₀) ⧸ m₀) →+* Ω :=
        Ideal.Quotient.lift m₀ ev_R₀ (fun _ hr => hm₀_le hr)
      have hLeft : Function.LeftInverse ev_quot g_end := fun c => by
        change MvPolynomial.constantCoeff (MvPolynomial.C c : MvPolynomial (Fin 2) Ω) = c
        simp
      refine ⟨hLeft.injective, fun y => ?_⟩
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      have h_ind : ∀ Q : MvPolynomial (Fin 2) Ω,
          Ideal.Quotient.mk m₀ (Ideal.Quotient.mk I₀ Q) = g_end (ev₀ Q) := by
        intro Q
        induction Q using MvPolynomial.induction_on with
        | C c =>
          have hc : ev₀ (MvPolynomial.C c) = c := by
            change MvPolynomial.constantCoeff (MvPolynomial.C c : MvPolynomial (Fin 2) Ω) = c
            simp
          rw [hc]
          rfl
        | add p q hp hq => simp only [map_add, hp, hq]
        | mul_X p i _ =>
          have hev : ev₀ (p * MvPolynomial.X i) = 0 := by
            change MvPolynomial.constantCoeff (p * MvPolynomial.X i) = 0
            simp
          have hXi_mem : Ideal.Quotient.mk I₀ (MvPolynomial.X i) ∈ m₀ := by
            fin_cases i
            · exact Ideal.subset_span (Set.mem_insert Xbar₀ {Xbar₁})
            · exact Ideal.subset_span (Set.mem_insert_of_mem Xbar₀ rfl)
          have hpXi_mem : Ideal.Quotient.mk I₀ (p * MvPolynomial.X i) ∈ m₀ := by
            rw [map_mul]
            exact m₀.mul_mem_left _ hXi_mem
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr hpXi_mem).trans
            ((map_zero g_end).symm.trans (congrArg g_end hev.symm))
      exact ⟨ev₀ P, (h_ind P).symm⟩

    let y₀_raw : A_raw := ψ_raw Xbar₀
    let y₁_raw : A_raw := ψ_raw Xbar₁
    let J_raw : Ideal A_raw := Ideal.span {y₀_raw, y₁_raw}
    have hMap_raw : Ideal.map ψ_raw m₀ = J_raw := by
      dsimp [m₀, J_raw, y₀_raw, y₁_raw]
      rw [Ideal.map_span, Set.image_pair]
    let Q_raw : Type u := A_raw ⧸ J_raw
    let π_Q : A_raw →+* Q_raw := Ideal.Quotient.mk J_raw
    let qMap_raw : ((MvPolynomial (Fin 2) Ω ⧸ I₀) ⧸ m₀) →+* Q_raw :=
      Ideal.quotientMap J_raw ψ_raw (hMap_raw ▸ Ideal.le_comap_map)
    let f_Q : Ω →+* Q_raw := π_Q.comp (ψ_raw.comp c_R₀)
    have hf_Q_et : f_Q.Etale := by
      have h_eq : f_Q = qMap_raw.comp g_end := by
        ext c
        rfl
      rw [h_eq]
      exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hBij_gnd)
        (hQuotEt_gen (MvPolynomial (Fin 2) Ω ⧸ I₀) A_raw ψ_raw m₀ J_raw hMap_raw hEt_ψraw)
    have hJraw_le_uA : J_raw ≤ u_A.asIdeal := by
      rw [Ideal.span_le]
      rintro _ (rfl | rfl)
      · exact hNode_raw 0
      · exact hNode_raw 1
    let q_raw : Ideal Q_raw := Ideal.map π_Q u_A.asIdeal
    haveI hqraw_prime : q_raw.IsPrime := (hQuotPrime J_raw u_A.asIdeal hJraw_le_uA).1
    have hComap_qraw : Ideal.comap π_Q q_raw = u_A.asIdeal :=
      (hQuotPrime J_raw u_A.asIdeal hJraw_le_uA).2
    obtain ⟨u_fib, hu_fib_not, hBij_away_Q⟩ := hEtaleFieldLoc Q_raw f_Q hf_Q_et q_raw
    obtain ⟨h_fib, hh_fib_mk⟩ := Ideal.Quotient.mk_surjective u_fib
    have hh_fib_not : h_fib ∉ u_A.asIdeal := by
      rw [← hComap_qraw, Ideal.mem_comap]
      rwa [hh_fib_mk]
    let A'_0 : Type u := Localization.Away h_fib
    let loc_0 : A_raw →+* A'_0 := algebraMap A_raw A'_0
    let φ₀ : B →+* A'_0 := loc_0.comp φ_raw
    let ψ₀ := loc_0.comp ψ_raw
    have hDisj_hfib : Disjoint (Submonoid.powers h_fib : Set A_raw) u_A.asIdeal := by
      rw [Set.disjoint_left]
      rintro _ ⟨m, rfl⟩ hm
      exact hh_fib_not (u_A.isPrime.mem_of_pow_mem m hm)
    let u₀ : PrimeSpectrum A'_0 :=
      ⟨Ideal.map loc_0 u_A.asIdeal,
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h_fib) A'_0
          u_A.asIdeal u_A.isPrime hDisj_hfib⟩
    have hComap_loc0 : Ideal.comap loc_0 u₀.asIdeal = u_A.asIdeal :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h_fib) A'_0
        u_A.isPrime hDisj_hfib
    have hEt_loc0 : loc_0.Etale :=
      (RingHom.etale_algebraMap (R := A_raw) (S := A'_0)).mpr (Algebra.Etale.of_isLocalizationAway h_fib)
    have hEt_φ₀ : φ₀.Etale := RingHom.Etale.stableUnderComposition _ _ hEt_φraw hEt_loc0
    have hEt_ψ₀ : ψ₀.Etale := RingHom.Etale.stableUnderComposition _ _ hEt_ψraw hEt_loc0
    have hCompat_0 : φ₀.comp c_V = ψ₀.comp c_R₀ := by
      ext c
      change loc_0 ((φ_raw.comp c_V) c) = loc_0 ((ψ_raw.comp c_R₀) c)
      rw [hCompat_raw]
    have hComap_φ₀ : Ideal.comap φ₀ u₀.asIdeal = p_z.asIdeal := by
      rw [← Ideal.comap_comap, hComap_loc0, hComap_raw]
    have hNode_0 : ∀ i : Fin 2, ψ₀ (Ideal.Quotient.mk I₀ (MvPolynomial.X i)) ∈ u₀.asIdeal :=
      fun i => Ideal.mem_map_of_mem loc_0 (hNode_raw i)
    let J₀ : Ideal A'_0 := Ideal.span {ψ₀ Xbar₀, ψ₀ Xbar₁}
    have hMap_J₀ : Ideal.map loc_0 J_raw = J₀ := by
      dsimp [J_raw, J₀, ψ₀, y₀_raw, y₁_raw]
      rw [Ideal.map_span, Set.image_pair]
    have hJ₀_le_u₀ : J₀ ≤ u₀.asIdeal := by
      rw [← hMap_J₀]
      exact Ideal.map_mono hJraw_le_uA
    let Q₀ : Type u := A'_0 ⧸ J₀
    let π_Q₀ : A'_0 →+* Q₀ := Ideal.Quotient.mk J₀
    let lam_Q : Q_raw →+* Q₀ := Ideal.quotientMap J₀ loc_0 (hMap_J₀ ▸ Ideal.le_comap_map)
    have hLoc_Q₀ : @IsLocalization.Away Q_raw _ u_fib Q₀ _ lam_Q.toAlgebra := by
      letI : Algebra Q_raw Q₀ := lam_Q.toAlgebra
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, ⟨k, rfl⟩⟩
        change IsUnit (lam_Q (u_fib ^ k))
        rw [map_pow, ← hh_fib_mk]
        exact ((IsLocalization.Away.algebraMap_isUnit h_fib (S := A'_0)).map π_Q₀).pow k
      · intro zbar
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective zbar
        obtain ⟨⟨a, _, ⟨k, rfl⟩⟩, hza⟩ := IsLocalization.surj (Submonoid.powers h_fib) z
        refine ⟨⟨π_Q a, ⟨u_fib ^ k, k, rfl⟩⟩, ?_⟩
        change π_Q₀ z * lam_Q (u_fib ^ k) = lam_Q (π_Q a)
        rw [← hh_fib_mk, ← map_pow]
        change π_Q₀ z * π_Q₀ (loc_0 (h_fib ^ k)) = π_Q₀ (loc_0 a)
        rw [← map_mul, hza]
      · intro x₁ x₂ hEq
        obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective x₁
        obtain ⟨a₂, rfl⟩ := Ideal.Quotient.mk_surjective x₂
        have hmem : loc_0 (a₁ - a₂) ∈ J₀ := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
          exact sub_eq_zero.mpr hEq
        obtain ⟨r₀, r₁, hr⟩ := Submodule.mem_span_pair.mp hmem
        obtain ⟨⟨b₀, _, ⟨k₀, rfl⟩⟩, hb₀⟩ := IsLocalization.surj (Submonoid.powers h_fib) r₀
        obtain ⟨⟨b₁, _, ⟨k₁, rfl⟩⟩, hb₁⟩ := IsLocalization.surj (Submonoid.powers h_fib) r₁
        have hloc_eq : loc_0 (h_fib ^ (k₀ + k₁) * (a₁ - a₂)) =
            loc_0 (h_fib ^ k₁ * b₀ * y₀_raw + h_fib ^ k₀ * b₁ * y₁_raw) := by
          calc
            loc_0 (h_fib ^ (k₀ + k₁) * (a₁ - a₂))
                = loc_0 (h_fib ^ k₀) * loc_0 (h_fib ^ k₁) * loc_0 (a₁ - a₂) := by
                  rw [map_mul, pow_add, map_mul]
            _ = loc_0 (h_fib ^ k₀) * loc_0 (h_fib ^ k₁) *
                  (r₀ * loc_0 y₀_raw + r₁ * loc_0 y₁_raw) := by
                  rw [← hr]
                  simp [smul_eq_mul, ψ₀, y₀_raw, y₁_raw]
            _ = loc_0 (h_fib ^ k₁) * (r₀ * loc_0 (h_fib ^ k₀)) * loc_0 y₀_raw +
                  loc_0 (h_fib ^ k₀) * (r₁ * loc_0 (h_fib ^ k₁)) * loc_0 y₁_raw := by ring
            _ = loc_0 (h_fib ^ k₁ * b₀ * y₀_raw + h_fib ^ k₀ * b₁ * y₁_raw) := by
                  rw [hb₀, hb₁]
                  simp only [loc_0, map_add, map_mul]
        obtain ⟨⟨_, ⟨m, rfl⟩⟩, hm_eq⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers h_fib) A'_0).mp hloc_eq
        have hInJraw : h_fib ^ (m + k₀ + k₁) * (a₁ - a₂) ∈ J_raw := by
          have hmul_eq : h_fib ^ (m + k₀ + k₁) * (a₁ - a₂) =
              (h_fib ^ m * h_fib ^ k₁ * b₀) * y₀_raw +
                (h_fib ^ m * h_fib ^ k₀ * b₁) * y₁_raw := by
            calc
              h_fib ^ (m + k₀ + k₁) * (a₁ - a₂)
                  = h_fib ^ m * (h_fib ^ (k₀ + k₁) * (a₁ - a₂)) := by
                    rw [Nat.add_assoc, pow_add, mul_assoc]
              _ = h_fib ^ m * (h_fib ^ k₁ * b₀ * y₀_raw + h_fib ^ k₀ * b₁ * y₁_raw) := hm_eq
              _ = (h_fib ^ m * h_fib ^ k₁ * b₀) * y₀_raw +
                    (h_fib ^ m * h_fib ^ k₀ * b₁) * y₁_raw := by ring
          rw [hmul_eq]
          exact Submodule.mem_span_pair.mpr
            ⟨h_fib ^ m * h_fib ^ k₁ * b₀, h_fib ^ m * h_fib ^ k₀ * b₁, by simp [smul_eq_mul]⟩
        refine ⟨⟨u_fib ^ (m + k₀ + k₁), m + k₀ + k₁, rfl⟩, ?_⟩
        change u_fib ^ (m + k₀ + k₁) * Ideal.Quotient.mk J_raw a₁ =
          u_fib ^ (m + k₀ + k₁) * Ideal.Quotient.mk J_raw a₂
        apply sub_eq_zero.mp
        rw [← hh_fib_mk]
        change π_Q h_fib ^ (m + k₀ + k₁) * π_Q a₁ - π_Q h_fib ^ (m + k₀ + k₁) * π_Q a₂ = 0
        rw [← map_pow, ← map_mul, ← map_mul, ← map_sub, ← mul_sub]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hInJraw
    have hBij_Q₀ : Function.Bijective ((Ideal.Quotient.mk J₀).comp (ψ₀.comp c_R₀)) := by
      have h := hBij_away_Q Q₀ lam_Q hLoc_Q₀
      have h_eq : lam_Q.comp f_Q = (Ideal.Quotient.mk J₀).comp (ψ₀.comp c_R₀) := by
        ext c
        rfl
      rwa [h_eq] at h
    have hMax_J₀ : J₀.IsMaximal :=
      Ideal.Quotient.maximal_of_isField J₀
        (MulEquiv.isField (Field.toIsField Ω) (RingEquiv.ofBijective _ hBij_Q₀).symm.toMulEquiv)
    have hJ₀_eq_u₀ : J₀ = u₀.asIdeal := hMax_J₀.eq_of_le u₀.isPrime.ne_top hJ₀_le_u₀
    have hBij_u₀ : Function.Bijective ((Ideal.Quotient.mk u₀.asIdeal).comp (ψ₀.comp c_R₀)) := by
      rwa [← hJ₀_eq_u₀]
    refine ⟨A'_0, inferInstance, u₀, φ₀, ψ₀,
      hEt_φ₀, hEt_ψ₀, hCompat_0, hComap_φ₀, hNode_0, ?_⟩
    intro w hw_not
    let A'₁ : Type u := Localization.Away w
    let loc_B : A'_0 →+* A'₁ := algebraMap A'_0 A'₁
    have hDisj_w : Disjoint (Submonoid.powers w : Set A'_0) u₀.asIdeal := by
      rw [Set.disjoint_left]
      rintro _ ⟨m, rfl⟩ hm
      exact hw_not (u₀.isPrime.mem_of_pow_mem m hm)
    let u₁ : PrimeSpectrum A'₁ :=
      ⟨Ideal.map loc_B u₀.asIdeal,
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers w) A'₁
          u₀.asIdeal u₀.isPrime hDisj_w⟩
    have hComap_locB : Ideal.comap loc_B u₁.asIdeal = u₀.asIdeal :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers w) A'₁
        u₀.isPrime hDisj_w
    have hSpan_u₁ : Ideal.span {loc_B (ψ₀ Xbar₀), loc_B (ψ₀ Xbar₁)} = u₁.asIdeal := by
      have hmap_span : Ideal.map loc_B J₀ = Ideal.span {loc_B (ψ₀ Xbar₀), loc_B (ψ₀ Xbar₁)} := by
        dsimp [J₀]
        rw [Ideal.map_span, Set.image_pair]
      rw [← hmap_span, hJ₀_eq_u₀]
    have hCompat_1 : (loc_B.comp φ₀).comp c_V = (loc_B.comp ψ₀).comp c_R₀ := by
      ext c
      change loc_B ((φ₀.comp c_V) c) = loc_B ((ψ₀.comp c_R₀) c)
      rw [hCompat_0]
    refine ⟨u₁, hComap_locB, hSpan_u₁, ?_⟩
    rw [hCompat_1]
    let θ₁ : Ω →+* (A'₁ ⧸ u₁.asIdeal) :=
      (Ideal.Quotient.mk u₁.asIdeal).comp ((loc_B.comp ψ₀).comp c_R₀)
    haveI : Nontrivial (A'₁ ⧸ u₁.asIdeal) := Ideal.Quotient.nontrivial_iff.mpr u₁.isPrime.ne_top
    refine ⟨θ₁.injective, fun ybar => ?_⟩
    obtain ⟨z_el, rfl⟩ := Ideal.Quotient.mk_surjective ybar
    obtain ⟨⟨a, _, ⟨k, rfl⟩⟩, hza⟩ := IsLocalization.surj (Submonoid.powers w) z_el
    obtain ⟨c_a, hc_a⟩ := hBij_u₀.2 (Ideal.Quotient.mk u₀.asIdeal a)
    obtain ⟨c_w, hc_w⟩ := hBij_u₀.2 (Ideal.Quotient.mk u₀.asIdeal (w ^ k))
    have hc_w_ne : c_w ≠ 0 := by
      intro hc0
      subst hc0
      have h0 : Ideal.Quotient.mk u₀.asIdeal (w ^ k) = 0 := by
        rw [← hc_w, map_zero]
      exact hw_not (u₀.isPrime.mem_of_pow_mem k (Ideal.Quotient.eq_zero_iff_mem.mp h0))
    have hmk_a : Ideal.Quotient.mk u₁.asIdeal (loc_B a) = θ₁ c_a := by
      apply sub_eq_zero.mp
      have hdiff_u₀ : a - (ψ₀.comp c_R₀) c_a ∈ u₀.asIdeal := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
        exact sub_eq_zero.mpr hc_a.symm
      change Ideal.Quotient.mk u₁.asIdeal (loc_B a) -
        Ideal.Quotient.mk u₁.asIdeal (loc_B ((ψ₀.comp c_R₀) c_a)) = 0
      rw [← map_sub, ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem loc_B hdiff_u₀)
    have hmk_w : Ideal.Quotient.mk u₁.asIdeal (loc_B (w ^ k)) = θ₁ c_w := by
      apply sub_eq_zero.mp
      have hdiff_u₀ : w ^ k - (ψ₀.comp c_R₀) c_w ∈ u₀.asIdeal := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
        exact sub_eq_zero.mpr hc_w.symm
      change Ideal.Quotient.mk u₁.asIdeal (loc_B (w ^ k)) -
        Ideal.Quotient.mk u₁.asIdeal (loc_B ((ψ₀.comp c_R₀) c_w)) = 0
      rw [← map_sub, ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem loc_B hdiff_u₀)
    refine ⟨c_a * c_w⁻¹, ?_⟩
    have hmul_eq : Ideal.Quotient.mk u₁.asIdeal z_el * θ₁ c_w = θ₁ c_a := by
      rw [← hmk_w, ← hmk_a, ← map_mul, hza]
    calc
      θ₁ (c_a * c_w⁻¹) = θ₁ c_a * θ₁ c_w⁻¹ := map_mul θ₁ c_a c_w⁻¹
      _ = (Ideal.Quotient.mk u₁.asIdeal z_el * θ₁ c_w) * θ₁ c_w⁻¹ := by rw [hmul_eq]
      _ = Ideal.Quotient.mk u₁.asIdeal z_el * θ₁ (c_w * c_w⁻¹) := by
            rw [mul_assoc, ← map_mul]
      _ = Ideal.Quotient.mk u₁.asIdeal z_el := by
            rw [mul_inv_cancel₀ hc_w_ne, map_one, mul_one]

  
  
  
  have hStage3 :
      ∀ (B A'_0 : Type u) [CommRing B] [CommRing A'_0]
        (φ₀ : B →+* A'_0), φ₀.Etale →
        ∀ (p_z : PrimeSpectrum B) (u₀ : PrimeSpectrum A'_0),
          Ideal.comap φ₀ u₀.asIdeal = p_z.asIdeal →
          ∀ (h : A'_0), h ∉ u₀.asIdeal →
            ∀ (g₀ : B), g₀ ∉ p_z.asIdeal →
              ∃ (f_sub : B), f_sub ∉ p_z.asIdeal ∧
                ∀ (B₁ : Type u) [CommRing B₁] (res_V1 : B →+* B₁),
                  @IsLocalization.Away B _ (g₀ * f_sub) B₁ _ res_V1.toAlgebra →
                  ∃ (φ₁ : B₁ →+* Localization.Away (h * φ₀ (g₀ * f_sub))),
                    φ₁.Etale ∧
                    Function.Surjective (PrimeSpectrum.comap φ₁) ∧
                    φ₁.comp res_V1 =
                      (algebraMap A'_0 (Localization.Away (h * φ₀ (g₀ * f_sub)))).comp φ₀ := by
    intro B A'_0 _ _ φ₀ hEt_φ₀ p_z u₀ hComap_φ₀ h hh g₀ hg₀
    have hChevalley : ∃ f_sub : B, f_sub ∉ p_z.asIdeal ∧
        (PrimeSpectrum.basicOpen f_sub : Set (PrimeSpectrum B)) ⊆
          (PrimeSpectrum.comap φ₀ '' (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum A'_0))) ∩
            (PrimeSpectrum.basicOpen g₀ : Set (PrimeSpectrum B)) := by
      letI : Algebra B A'_0 := φ₀.toAlgebra
      haveI : Algebra.Etale B A'_0 := RingHom.etale_algebraMap.mpr hEt_φ₀
      haveI : Algebra.HasGoingDown B A'_0 := Algebra.HasGoingDown.of_flat
      have hOpenMap : IsOpenMap (PrimeSpectrum.comap φ₀) :=
        PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
      let U_inter : Set (PrimeSpectrum B) :=
        (PrimeSpectrum.comap φ₀ '' (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum A'_0))) ∩
          (PrimeSpectrum.basicOpen g₀ : Set (PrimeSpectrum B))
      have hOpen_inter : IsOpen U_inter :=
        (hOpenMap _ (PrimeSpectrum.basicOpen h).isOpen).inter (PrimeSpectrum.basicOpen g₀).isOpen
      have hpz_mem : p_z ∈ U_inter :=
        ⟨⟨u₀, hh, PrimeSpectrum.ext hComap_φ₀⟩, hg₀⟩
      obtain ⟨v, ⟨f_sub, rfl⟩, hpz_f, hf_sub_inter⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpz_mem hOpen_inter
      exact ⟨f_sub, hpz_f, hf_sub_inter⟩
    obtain ⟨f_sub, hf_sub_not, hf_sub_inter⟩ := hChevalley
    refine ⟨f_sub, hf_sub_not, ?_⟩
    intro B₁ _ res_V1 hLoc_B₁
    let g₁ : B := g₀ * f_sub
    let w : A'_0 := h * φ₀ g₁
    let A'₁ : Type u := Localization.Away w
    let loc_B : A'_0 →+* A'₁ := algebraMap A'_0 A'₁
    have hg₁_unit : IsUnit ((loc_B.comp φ₀) g₁) := by
      obtain ⟨u_hw, hu_hw⟩ := IsLocalization.Away.algebraMap_isUnit w (S := A'₁)
      refine isUnit_iff_exists_inv.mpr ⟨loc_B h * (u_hw⁻¹ : A'₁ˣ).val, ?_⟩
      have hmap_mul : loc_B h * loc_B (φ₀ g₁) = (u_hw : A'₁) := by
        rw [← map_mul]
        exact hu_hw.symm
      calc
        (loc_B.comp φ₀) g₁ * (loc_B h * (u_hw⁻¹ : A'₁ˣ).val)
            = (loc_B h * loc_B (φ₀ g₁)) * (u_hw⁻¹ : A'₁ˣ).val := by
              change loc_B (φ₀ g₁) * (loc_B h * (u_hw⁻¹ : A'₁ˣ).val) = _
              ring
        _ = (u_hw : A'₁) * (u_hw⁻¹ : A'₁ˣ).val := by rw [hmap_mul]
        _ = 1 := Units.mul_inv u_hw
    letI : Algebra B B₁ := res_V1.toAlgebra
    haveI : IsLocalization.Away g₁ B₁ := hLoc_B₁
    let φ₁ : B₁ →+* A'₁ := IsLocalization.Away.lift (S := B₁) g₁ hg₁_unit
    have hφ₁_comm : φ₁.comp res_V1 = loc_B.comp φ₀ := by
      ext b
      exact IsLocalization.Away.lift_eq (S := B₁) g₁ hg₁_unit b
    have hEt_locB : loc_B.Etale :=
      (RingHom.etale_algebraMap (R := A'_0) (S := A'₁)).mpr (Algebra.Etale.of_isLocalizationAway w)
    have hEt_locB_φ₀ : (loc_B.comp φ₀).Etale :=
      RingHom.Etale.stableUnderComposition _ _ hEt_φ₀ hEt_locB
    have hEt_resV1 : res_V1.Etale :=
      (RingHom.etale_algebraMap (R := B) (S := B₁)).mpr (Algebra.Etale.of_isLocalizationAway g₁)
    have hEt_φ₁ : φ₁.Etale := by
      have h1 : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_V1)) :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_resV1
      have h2 : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_V1)) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ₁_comm]
        exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_locB_φ₀
      exact AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp
        (CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_V1)) h1 h2)
    have hSurj_φ₁ : Function.Surjective (PrimeSpectrum.comap φ₁) := by
      intro q₁
      let q₀ : PrimeSpectrum B := PrimeSpectrum.comap res_V1 q₁
      have hg₁_not_q₀ : g₁ ∉ q₀.asIdeal := by
        intro hg1_in
        have hUnit : IsUnit (res_V1 g₁) := IsLocalization.Away.algebraMap_isUnit g₁
        exact q₁.isPrime.ne_top (q₁.asIdeal.eq_top_of_isUnit_mem hg1_in hUnit)
      have hfs_not_q₀ : f_sub ∉ q₀.asIdeal := fun hfs =>
        hg₁_not_q₀ (q₀.asIdeal.mul_mem_left g₀ hfs)
      obtain ⟨w₀, hw₀_h, hw₀_comap⟩ := (hf_sub_inter hfs_not_q₀).1
      have hComap_w₀ : Ideal.comap φ₀ w₀.asIdeal = q₀.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hw₀_comap
      have hw_not_w₀ : w ∉ w₀.asIdeal := by
        intro hm
        rcases w₀.isPrime.mem_or_mem hm with hh_in | hg1_in
        · exact hw₀_h hh_in
        · exact hg₁_not_q₀ (hComap_w₀ ▸ hg1_in)
      have hDisj_w₀ : Disjoint (Submonoid.powers w : Set A'_0) w₀.asIdeal := by
        rw [Set.disjoint_left]
        rintro _ ⟨m, rfl⟩ hm
        exact hw_not_w₀ (w₀.isPrime.mem_of_pow_mem m hm)
      let w₁ : PrimeSpectrum A'₁ :=
        ⟨Ideal.map loc_B w₀.asIdeal,
          IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers w) A'₁
            w₀.asIdeal w₀.isPrime hDisj_w₀⟩
      have hComap_w₁ : Ideal.comap loc_B w₁.asIdeal = w₀.asIdeal :=
        IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers w) A'₁
          w₀.isPrime hDisj_w₀
      refine ⟨w₁, ?_⟩
      apply PrimeSpectrum.localization_comap_injective B₁ (Submonoid.powers g₁)
      apply PrimeSpectrum.ext
      change Ideal.comap (φ₁.comp res_V1) w₁.asIdeal = q₀.asIdeal
      rw [hφ₁_comm, ← Ideal.comap_comap, hComap_w₁, hComap_w₀]
    exact ⟨φ₁, hEt_φ₁, hSurj_φ₁, hφ₁_comm⟩

  
  
  
  obtain ⟨A_raw, instRingA_raw, u_A, φ_raw, ψ_raw,
    hEt_φraw, hEt_ψraw, hCompat_raw, hComap_raw, hNode_raw⟩ := hStage1
  letI : CommRing A_raw := instRingA_raw
  obtain ⟨A'_0, instRingA'₀, u₀, φ₀, ψ₀,
    hEt_φ₀, hEt_ψ₀, hCompat_0, hComap_φ₀, hNode_0, hAway_u₁⟩ :=
    hStage2 ↑(C.presheaf.obj (Opposite.op V)) A_raw
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ V (fun _ _ => trivial)).hom)
      p_z u_A φ_raw ψ_raw hEt_φraw hEt_ψraw hCompat_raw hComap_raw hNode_raw
  letI : CommRing A'_0 := instRingA'₀

  refine ⟨A'_0, instRingA'₀, u₀, φ₀, ψ₀,
    hEt_φ₀, hEt_ψ₀, hCompat_0, hComap_φ₀, hNode_0, ?_⟩
  intro h hh g₀ hg₀
  obtain ⟨f_sub, hf_sub_not, hMakePhi1⟩ :=
    hStage3 ↑(C.presheaf.obj (Opposite.op V)) A'_0 φ₀ hEt_φ₀ p_z u₀ hComap_φ₀ h hh g₀ hg₀
  have hg₁_not : g₀ * f_sub ∉ p_z.asIdeal := fun hm =>
    (p_z.isPrime.mem_or_mem hm).elim hg₀ hf_sub_not
  have hBasic_le : C.basicOpen (g₀ * f_sub) ≤ C.basicOpen g₀ := by
    rw [C.basicOpen_mul]
    exact inf_le_left
  refine ⟨g₀ * f_sub, hg₁_not, hBasic_le, ?_⟩
  dsimp only

  have hφ₀_g₁_not : φ₀ (g₀ * f_sub) ∉ u₀.asIdeal := by
    change g₀ * f_sub ∉ Ideal.comap φ₀ u₀.asIdeal
    rwa [hComap_φ₀]
  have hw_not : h * φ₀ (g₀ * f_sub) ∉ u₀.asIdeal := fun hm =>
    (u₀.isPrime.mem_or_mem hm).elim hh hφ₀_g₁_not

  obtain ⟨u₁, hComap_locB, hSpan_u₁, hBij_u₁⟩ := hAway_u₁ (h * φ₀ (g₀ * f_sub)) hw_not
  obtain ⟨φ₁, hEt_φ₁, hSurj_φ₁, hφ₁_comm⟩ :=
    hMakePhi1 ↑(C.presheaf.obj (Opposite.op (C.basicOpen (g₀ * f_sub))))
      (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le (g₀ * f_sub))).op).hom
      (hV.isLocalization_basicOpen (g₀ * f_sub))

  let loc_B : A'_0 →+* Localization.Away (h * φ₀ (g₀ * f_sub)) :=
    algebraMap A'_0 (Localization.Away (h * φ₀ (g₀ * f_sub)))
  have hEt_locB : loc_B.Etale :=
    (RingHom.etale_algebraMap (R := A'_0)
      (S := Localization.Away (h * φ₀ (g₀ * f_sub)))).mpr
      (Algebra.Etale.of_isLocalizationAway (h * φ₀ (g₀ * f_sub)))
  have hEt_locB_φ₀ : (loc_B.comp φ₀).Etale :=
    RingHom.Etale.stableUnderComposition _ _ hEt_φ₀ hEt_locB
  have hEt_locB_ψ₀ : (loc_B.comp ψ₀).Etale :=
    RingHom.Etale.stableUnderComposition _ _ hEt_ψ₀ hEt_locB

  let e₁ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * φ₀ (g₀ * f_sub)))) ⟶
      V.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp φ₀)) ≫ hV.isoSpec.inv
  let e₂ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * φ₀ (g₀ * f_sub)))) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
            Set (MvPolynomial (Fin 2) Ω)))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp ψ₀))

  have hEt_e₂ : AlgebraicGeometry.Etale e₂ :=
    AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_locB_ψ₀
  haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp φ₀))) :=
    AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hEt_locB_φ₀
  have hEt_e₁ : AlgebraicGeometry.Etale e₁ :=
    show AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp φ₀)) ≫ hV.isoSpec.inv) from
      inferInstance
  have hNode_e₂ : ∀ i : Fin 2,
      Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₁).asIdeal := by
    intro i
    change Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ Ideal.comap (loc_B.comp ψ₀) u₁.asIdeal
    rw [← Ideal.comap_comap, hComap_locB]
    exact hNode_0 i
  have he₂_pre : (AlgebraicGeometry.Spec.preimage e₂).hom = loc_B.comp ψ₀ := by
    dsimp [e₂]
    rw [AlgebraicGeometry.Spec.preimage_map]
    rfl
  have he₁_app : (V.topIso.inv ≫ e₁.appTop ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso
        (CommRingCat.of (Localization.Away (h * φ₀ (g₀ * f_sub))))).hom).hom =
      loc_B.comp φ₀ := by
    let f_mor : C.presheaf.obj (Opposite.op V) ⟶
        CommRingCat.of (Localization.Away (h * φ₀ (g₀ * f_sub))) :=
      CommRingCat.ofHom (loc_B.comp φ₀)
    have happ : e₁.appTop = hV.isoSpec.inv.appTop ≫ (AlgebraicGeometry.Spec.map f_mor).appTop :=
      AlgebraicGeometry.Scheme.Hom.comp_appTop _ _
    have hinv : V.topIso.inv ≫ hV.isoSpec.inv.appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso (C.presheaf.obj (Opposite.op V))).inv := by
      have h1 : (AlgebraicGeometry.Scheme.ΓSpecIso (C.presheaf.obj (Opposite.op V))).inv ≫
          hV.isoSpec.hom.appTop = V.topIso.inv := by
        rw [hV.isoSpec_hom_appTop, CategoryTheory.Iso.inv_hom_id_assoc]
      rw [← h1, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
        CategoryTheory.Iso.inv_hom_id, AlgebraicGeometry.Scheme.Hom.id_appTop,
        CategoryTheory.Category.comp_id]
    rw [happ, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc V.topIso.inv hV.isoSpec.inv.appTop, hinv,
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality, CategoryTheory.Iso.inv_hom_id_assoc]
    rfl
  have hComm_e : e₁ ≫ V.ι ≫ g =
      e₂ ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
    have hCompat_1 :
        (loc_B.comp φ₀).comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ V (fun _ _ => trivial)).hom) =
        (loc_B.comp ψ₀).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) := by
      ext c
      change loc_B ((φ₀.comp _) c) = loc_B ((ψ₀.comp _) c)
      rw [hCompat_0]
    dsimp [e₁, e₂]
    calc
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp φ₀)) ≫ hV.isoSpec.inv) ≫
          V.ι ≫ g
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp φ₀)) ≫
              (hV.isoSpec.inv ≫ V.ι) ≫ g := by
            simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp φ₀)) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                  g.appLE ⊤ V (fun _ _ => trivial)).hom)) := by
          rw [hV.isoSpec_inv_ι, hFromSpec_g]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              ((loc_B.comp φ₀).comp
                (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                  g.appLE ⊤ V (fun _ _ => trivial)).hom))) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              ((loc_B.comp ψ₀).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
          rw [hCompat_1]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_B.comp ψ₀)) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]

  exact ⟨u₁, e₁, e₂, φ₁, hEt_e₁, hEt_e₂, hNode_e₂, hComm_e, he₁_app, he₂_pre,
    hComap_locB, hSpan_u₁, hBij_u₁, hEt_φ₁, hSurj_φ₁, hφ₁_comm⟩

theorem weil_nodal_etale_tensor_splitting_and_pinching_algebra (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (c : ℕ)
    (B₁ A'₁ : Type u) [CommRing B₁] [CommRing A'₁]
    (B_tilde : Fin (c + 1) → Type u) [∀ α : Fin (c + 1), CommRing (B_tilde α)]
    (c_B : Ω →+* B₁)
    (φ₁ : B₁ →+* A'₁)
    (ψ₁ : (MvPolynomial (Fin 2) Ω ⧸
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* A'₁)
    (ι : ∀ α : Fin (c + 1), B₁ →+* B_tilde α)
    (p_z : Ideal B₁) [p_z.IsPrime]
    (u₁ : Ideal A'₁) [u₁.IsPrime]
    (s : B₁)
    (hEtφ₁ : φ₁.Etale)
    (hEtψ₁ : ψ₁.Etale)
    (hSurj : Function.Surjective (PrimeSpectrum.comap φ₁))
    (hCompat : φ₁.comp c_B = ψ₁.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))
    (hComap_u₁ : Ideal.comap φ₁ u₁ = p_z)
    (hSpan_u₁ : Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0)),
      ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))} = u₁)
    (hBij_u₁ : Function.Bijective ((Ideal.Quotient.mk u₁).comp (φ₁.comp c_B)))
    (hDom₀ : IsDomain (A'₁ ⧸ Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))}))
    (hIC₀ : IsIntegrallyClosed (A'₁ ⧸ Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))}))
    (hDom₁ : IsDomain (A'₁ ⧸ Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))}))
    (hIC₁ : IsIntegrallyClosed (A'₁ ⧸ Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))}))
    (hNeBot₀ : Ideal.comap
      ((Ideal.Quotient.mk (Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))})).comp φ₁) ⊥ ≠
      p_z)
    (hNeBot₁ : Ideal.comap
      ((Ideal.Quotient.mk (Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))})).comp φ₁) ⊥ ≠
      p_z)
    (hs_mem : s ∈ p_z)
    (hs_nzd : s ∈ nonZeroDivisors B₁)
    (hs_ne₀ : Ideal.Quotient.mk (Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))})
      (φ₁ s) ≠ 0)
    (hs_ne₁ : Ideal.Quotient.mk (Ideal.span {ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))})
      (φ₁ s) ≠ 0)
    (hs_reg_tilde : ∀ (α : Fin (c + 1)) (y : B_tilde α), ι α s * y = 0 → y = 0)
    (hFin_ι : ∀ α : Fin (c + 1), (ι α).Finite)
    (hProdInj : ∀ b₁ b₂ : B₁, (∀ α : Fin (c + 1), ι α b₁ = ι α b₂) → b₁ = b₂)
    (hSubOrDom : ∀ α : Fin (c + 1), Subsingleton (B_tilde α) ∨ IsDomain (B_tilde α))
    (hNotIso : ¬∃ (α_star : Fin (c + 1)) (e_star : B₁),
      e_star ∉ p_z ∧
      (∀ β : Fin (c + 1), β ≠ α_star → ι β e_star = 0) ∧
      (∀ y : B_tilde α_star, ∃ (k : ℕ) (b : B₁), (ι α_star e_star) ^ k * y = ι α_star b))
    (hSmLoc : ∀ (q : Ideal B₁) [q.IsPrime], q ≠ p_z →
      ∃ (α : Fin (c + 1)) (b_sm : B₁),
        b_sm ∉ q ∧
        (∀ β : Fin (c + 1), β ≠ α → ι β b_sm = 0) ∧
        (∀ b : B₁, ι α b = 0 → ∃ k : ℕ, b_sm ^ k * b = 0) ∧
        (∀ y : B_tilde α, ∃ (k : ℕ) (b : B₁), (ι α b_sm) ^ k * y = ι α b)) :
    let x₀ : A'₁ := ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
    let x₁ : A'₁ := ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
    let D₀ := A'₁ ⧸ Ideal.span {x₁}
    let D₁ := A'₁ ⧸ Ideal.span {x₀}
    let π₀ : A'₁ →+* D₀ := Ideal.Quotient.mk (Ideal.span {x₁})
    let π₁ : A'₁ →+* D₁ := Ideal.Quotient.mk (Ideal.span {x₀})
    ∃ (α₀ α₁ : Fin (c + 1))
      (p₀ : PrimeSpectrum (B_tilde α₀))
      (p₁ : PrimeSpectrum (B_tilde α₁))
      (ψ_br₀ : B_tilde α₀ →+* D₀)
      (ψ_br₁ : B_tilde α₁ →+* D₁),
      p₀.asIdeal.IsMaximal ∧
      p₁.asIdeal.IsMaximal ∧
      Ideal.comap (ι α₀) p₀.asIdeal = p_z ∧
      Ideal.comap (ι α₁) p₁.asIdeal = p_z ∧
      Ideal.comap ψ_br₀ (Ideal.map π₀ u₁) = p₀.asIdeal ∧
      Ideal.comap ψ_br₁ (Ideal.map π₁ u₁) = p₁.asIdeal ∧
      ψ_br₀.comp (ι α₀) = π₀.comp φ₁ ∧
      ψ_br₁.comp (ι α₁) = π₁.comp φ₁ ∧
      Function.Injective ψ_br₀ ∧
      Function.Injective ψ_br₁ ∧
      ψ_br₀.FiniteType ∧
      ψ_br₁.FiniteType ∧
      @Module.Flat (B_tilde α₀) D₀ _ _ ψ_br₀.toAlgebra.toModule ∧
      @Algebra.FormallyUnramified (B_tilde α₀) D₀ _ _ ψ_br₀.toAlgebra ∧
      @Module.Flat (B_tilde α₁) D₁ _ _ ψ_br₁.toAlgebra.toModule ∧
      @Algebra.FormallyUnramified (B_tilde α₁) D₁ _ _ ψ_br₁.toAlgebra ∧
      (⟨α₀, p₀⟩ : Σ α : Fin (c + 1), PrimeSpectrum (B_tilde α)) ≠ ⟨α₁, p₁⟩ ∧
      (∀ (α : Fin (c + 1)) (q_P : PrimeSpectrum (B_tilde α)),
        Ideal.comap (ι α) q_P.asIdeal = p_z →
        (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde β)) = ⟨α₀, p₀⟩ ∨
          (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde β)) = ⟨α₁, p₁⟩) ∧
      (∀ (s_tilde : ∀ α : Fin (c + 1), B_tilde α) (c_val : Ω),
        s_tilde α₀ - ι α₀ (c_B c_val) ∈ p₀.asIdeal →
        s_tilde α₁ - ι α₁ (c_B c_val) ∈ p₁.asIdeal →
        ∃ b : B₁, ∀ α : Fin (c + 1), ι α b = s_tilde α) :=
by
  
  have hStep1 :
      let x₀ : A'₁ := ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
      let x₁ : A'₁ := ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      let D₀ := A'₁ ⧸ Ideal.span {x₁}
      let D₁ := A'₁ ⧸ Ideal.span {x₀}
      let π₀ : A'₁ →+* D₀ := Ideal.Quotient.mk (Ideal.span {x₁})
      let π₁ : A'₁ →+* D₁ := Ideal.Quotient.mk (Ideal.span {x₀})
      Function.Injective (RingHom.prod π₀ π₁) ∧
      ∃ (ev₀ : D₀ →+* Ω) (ev₁ : D₁ →+* Ω),
        RingHom.ker ev₀ = Ideal.map π₀ u₁ ∧
        (Ideal.map π₀ u₁).IsMaximal ∧
        RingHom.ker ev₁ = Ideal.map π₁ u₁ ∧
        (Ideal.map π₁ u₁).IsMaximal ∧
        ev₀.comp π₀ = ev₁.comp π₁ ∧
        RingHom.ker (ev₀.comp π₀) = u₁ ∧
        (∀ d : Ω, ev₀ (π₀ (φ₁ (c_B d))) = d) ∧
        (∀ (d₀ : D₀) (d₁ : D₁), ev₀ d₀ = ev₁ d₁ ↔ ∃ a' : A'₁, π₀ a' = d₀ ∧ π₁ a' = d₁) := by
    intro x₀ x₁ D₀ D₁ π₀ π₁
    have hFlatInf : ∀ (R₁ B : Type u) [CommRing R₁] [CommRing B]
        (ψ : R₁ →+* B) (_ : ψ.Etale) (r₀ r₁ : R₁),
        (Ideal.span ({r₁} : Set R₁) : Ideal R₁) ⊓ Ideal.span ({r₀} : Set R₁) = ⊥ →
        (Ideal.span ({ψ r₁} : Set B) : Ideal B) ⊓ Ideal.span ({ψ r₀} : Set B) = ⊥ := by
      intro R₁ B _ _ ψ hEt r₀ r₁ hInf
      letI : Algebra R₁ B := ψ.toAlgebra
      haveI : Algebra.Etale R₁ B := (RingHom.etale_algebraMap (R := R₁) (S := B)).mp hEt
      haveI : Module.Flat R₁ B := inferInstance
      let J₁ : Ideal R₁ := Ideal.span ({r₁} : Set R₁)
      let J₀ : Ideal R₁ := Ideal.span ({r₀} : Set R₁)
      let δ : R₁ →ₗ[R₁] (R₁ ⧸ J₁) × (R₁ ⧸ J₀) :=
        LinearMap.prod (Submodule.mkQ J₁) (Submodule.mkQ J₀)
      have hδ_inj : Function.Injective δ := by
        rw [← LinearMap.ker_eq_bot]
        ext x
        rw [LinearMap.mem_ker]
        change (Submodule.mkQ J₁ x, Submodule.mkQ J₀ x) = (0, 0) ↔ x ∈ (⊥ : Ideal R₁)
        rw [Prod.mk.injEq, Submodule.mkQ_apply, Submodule.mkQ_apply,
          Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_eq_zero,
          ← Submodule.mem_inf, hInf]
      have hl_inj : Function.Injective (LinearMap.lTensor B δ) :=
        Module.Flat.lTensor_preserves_injective_linearMap δ hδ_inj
      rw [eq_bot_iff]
      intro b hb
      rw [Submodule.mem_bot]
      rw [Submodule.mem_inf, Ideal.mem_span_singleton, Ideal.mem_span_singleton] at hb
      rcases hb with ⟨⟨c₁, rfl⟩, ⟨c₀, hbc₀⟩⟩
      have hm₁ : ψ r₁ * c₁ ∈ J₁ • (⊤ : Submodule R₁ B) := by
        change r₁ • c₁ ∈ J₁ • (⊤ : Submodule R₁ B)
        exact Submodule.smul_mem_smul (Ideal.subset_span rfl) trivial
      have hm₀ : ψ r₁ * c₁ ∈ J₀ • (⊤ : Submodule R₁ B) := by
        rw [hbc₀]
        change r₀ • c₀ ∈ J₀ • (⊤ : Submodule R₁ B)
        exact Submodule.smul_mem_smul (Ideal.subset_span rfl) trivial
      let q₁ := TensorProduct.tensorQuotEquivQuotSMul B J₁
      let q₀ := TensorProduct.tensorQuotEquivQuotSMul B J₀
      let pR := TensorProduct.prodRight R₁ R₁ B (R₁ ⧸ J₁) (R₁ ⧸ J₀)
      have hq₁ : q₁ ((ψ r₁ * c₁) ⊗ₜ[R₁] Submodule.Quotient.mk (1 : R₁)) = 0 := by
        change Submodule.Quotient.mk ((1 : R₁) • (ψ r₁ * c₁)) = 0
        rw [one_smul, Submodule.Quotient.mk_eq_zero]
        exact hm₁
      have hq₀ : q₀ ((ψ r₁ * c₁) ⊗ₜ[R₁] Submodule.Quotient.mk (1 : R₁)) = 0 := by
        change Submodule.Quotient.mk ((1 : R₁) • (ψ r₁ * c₁)) = 0
        rw [one_smul, Submodule.Quotient.mk_eq_zero]
        exact hm₀
      have ht₁ : (ψ r₁ * c₁) ⊗ₜ[R₁] Submodule.Quotient.mk (1 : R₁) =
          (0 : TensorProduct R₁ B (R₁ ⧸ J₁)) :=
        q₁.injective (hq₁.trans (map_zero q₁).symm)
      have ht₀ : (ψ r₁ * c₁) ⊗ₜ[R₁] Submodule.Quotient.mk (1 : R₁) =
          (0 : TensorProduct R₁ B (R₁ ⧸ J₀)) :=
        q₀.injective (hq₀.trans (map_zero q₀).symm)
      have hpR : pR (LinearMap.lTensor B δ ((ψ r₁ * c₁) ⊗ₜ[R₁] (1 : R₁))) = (0, 0) := by
        rw [LinearMap.lTensor_tmul]
        change ((ψ r₁ * c₁) ⊗ₜ[R₁] Submodule.Quotient.mk (1 : R₁),
          (ψ r₁ * c₁) ⊗ₜ[R₁] Submodule.Quotient.mk (1 : R₁)) = (0, 0)
        rw [ht₁, ht₀]
      have hl0 : LinearMap.lTensor B δ ((ψ r₁ * c₁) ⊗ₜ[R₁] (1 : R₁)) = 0 :=
        pR.injective (hpR.trans (map_zero pR).symm)
      have htmul0 : (ψ r₁ * c₁) ⊗ₜ[R₁] (1 : R₁) = (0 : TensorProduct R₁ B R₁) :=
        hl_inj (hl0.trans (map_zero _).symm)
      have hrid := congrArg (TensorProduct.rid R₁ B) htmul0
      simpa using hrid
    have hR₀Inf : ∀ (k₀ : Type u) [CommRing k₀],
        let I₀ : Ideal (MvPolynomial (Fin 2) k₀) :=
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
        (Ideal.span ({Ideal.Quotient.mk I₀ (MvPolynomial.X 1)} : Set _) : Ideal _) ⊓
          Ideal.span ({Ideal.Quotient.mk I₀ (MvPolynomial.X 0)} : Set _) = ⊥ := by
      intro k₀ _ I₀
      rw [eq_bot_iff]
      intro r hr
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [Submodule.mem_inf, Ideal.mem_span_singleton, Ideal.mem_span_singleton] at hr
      rcases hr with ⟨⟨q₁_bar, hq₁⟩, ⟨q₀_bar, hq₀⟩⟩
      obtain ⟨A₁, rfl⟩ := Ideal.Quotient.mk_surjective q₁_bar
      obtain ⟨A₀, rfl⟩ := Ideal.Quotient.mk_surjective q₀_bar
      rw [← map_mul, Ideal.Quotient.eq, Ideal.mem_span_singleton] at hq₁ hq₀
      rcases hq₁ with ⟨D₁_p, hD₁⟩
      rcases hq₀ with ⟨D₀_p, hD₀⟩
      let Q₁ : MvPolynomial (Fin 2) k₀ := A₁ + MvPolynomial.X 0 * D₁_p
      let Q₀ : MvPolynomial (Fin 2) k₀ := A₀ + MvPolynomial.X 1 * D₀_p
      have hPQ₁ : P = Q₁ * MvPolynomial.X 1 := by
        rw [sub_eq_iff_eq_add.mp hD₁]
        dsimp only [Q₁]
        rw [add_mul, mul_comm (MvPolynomial.X 1) A₁,
          mul_assoc (MvPolynomial.X 0) D₁_p (MvPolynomial.X 1),
          mul_comm D₁_p (MvPolynomial.X 1),
          ← mul_assoc (MvPolynomial.X 0) (MvPolynomial.X 1) D₁_p, add_comm]
      have hPQ₀ : P = Q₀ * MvPolynomial.X 0 := by
        rw [sub_eq_iff_eq_add.mp hD₀]
        dsimp only [Q₀]
        rw [add_mul, mul_comm (MvPolynomial.X 0) A₀,
          mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1),
          mul_assoc (MvPolynomial.X 1) D₀_p (MvPolynomial.X 0),
          mul_comm D₀_p (MvPolynomial.X 0),
          ← mul_assoc (MvPolynomial.X 1) (MvPolynomial.X 0) D₀_p, add_comm]
      let Φ₁ : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
        MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin 2 => if i = 0 then 0 else Polynomial.X)
      have hΦX₀ : Φ₁ (MvPolynomial.X 0) = 0 := by
        change MvPolynomial.eval₂Hom Polynomial.C _ (MvPolynomial.X 0) = 0
        rw [MvPolynomial.eval₂Hom_X']
        simp
      have hΦX₁ : Φ₁ (MvPolynomial.X 1) = Polynomial.X := by
        change MvPolynomial.eval₂Hom Polynomial.C _ (MvPolynomial.X 1) = Polynomial.X
        rw [MvPolynomial.eval₂Hom_X']
        simp
      have hΦ_eq : Φ₁ Q₁ * Polynomial.X = 0 := by
        have h := congrArg Φ₁ (hPQ₁.symm.trans hPQ₀)
        rw [map_mul, map_mul, hΦX₁, hΦX₀, mul_zero] at h
        exact h
      have hΦQ₁ : Φ₁ Q₁ = 0 := by
        ext n
        rw [← Polynomial.coeff_mul_X, hΦ_eq, Polynomial.coeff_zero, Polynomial.coeff_zero]
      let σ : MvPolynomial (Fin 2) k₀ →+* MvPolynomial (Fin 2) k₀ :=
        (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)).comp Φ₁
      let mkX₀ := Ideal.Quotient.mk (Ideal.span ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 2) k₀)))
      have hmk_σ : mkX₀.comp σ = mkX₀ := by
        apply MvPolynomial.ringHom_ext'
        · ext d
          change mkX₀ (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1)
            (MvPolynomial.eval₂Hom Polynomial.C _ (MvPolynomial.C d))) = mkX₀ (MvPolynomial.C d)
          rw [MvPolynomial.eval₂Hom_C, Polynomial.eval₂_C]
        · intro i
          by_cases hi : i = 0
          · subst hi
            change mkX₀ (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) (Φ₁ (MvPolynomial.X 0))) =
              mkX₀ (MvPolynomial.X 0)
            rw [hΦX₀, Polynomial.eval₂_zero, map_zero]
            symm
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          · have hi1 : i = 1 := by omega
            subst hi1
            change mkX₀ (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) (Φ₁ (MvPolynomial.X 1))) =
              mkX₀ (MvPolynomial.X 1)
            rw [hΦX₁, Polynomial.eval₂_X]
      have hmkQ₁ : mkX₀ Q₁ = 0 := by
        have h := DFunLike.congr_fun hmk_σ Q₁
        change mkX₀ ((Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)) (Φ₁ Q₁)) =
          mkX₀ Q₁ at h
        rw [hΦQ₁, map_zero, map_zero] at h
        exact h.symm
      have hQ₁_mem : Q₁ ∈ Ideal.span ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 2) k₀)) :=
        Ideal.Quotient.eq_zero_iff_mem.mp hmkQ₁
      rw [Ideal.mem_span_singleton] at hQ₁_mem
      rcases hQ₁_mem with ⟨H, hH⟩
      rw [Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
      refine Ideal.mem_span_singleton.mpr ⟨H, ?_⟩
      rw [hPQ₁, hH, mul_assoc (MvPolynomial.X 0) H (MvPolynomial.X 1),
        mul_comm H (MvPolynomial.X 1), ← mul_assoc]
    have hxInf : (Ideal.span ({x₁} : Set A'₁) : Ideal A'₁) ⊓ Ideal.span ({x₀} : Set A'₁) = ⊥ :=
      hFlatInf _ A'₁ ψ₁ hEtψ₁ _ _ (hR₀Inf Ω)
    have hCRT_abs : ∀ (y₀ y₁ : A'₁),
        (Ideal.span ({y₁} : Set A'₁) : Ideal A'₁) ⊓ Ideal.span ({y₀} : Set A'₁) = ⊥ →
        Ideal.span ({y₀, y₁} : Set A'₁) = u₁ →
        let Q₀ := A'₁ ⧸ Ideal.span ({y₁} : Set A'₁)
        let Q₁ := A'₁ ⧸ Ideal.span ({y₀} : Set A'₁)
        let q₀ : A'₁ →+* Q₀ := Ideal.Quotient.mk (Ideal.span ({y₁} : Set A'₁))
        let q₁ : A'₁ →+* Q₁ := Ideal.Quotient.mk (Ideal.span ({y₀} : Set A'₁))
        Function.Injective (RingHom.prod q₀ q₁) ∧
        ∃ (ev₀ : Q₀ →+* Ω) (ev₁ : Q₁ →+* Ω),
          RingHom.ker ev₀ = Ideal.map q₀ u₁ ∧
          (Ideal.map q₀ u₁).IsMaximal ∧
          RingHom.ker ev₁ = Ideal.map q₁ u₁ ∧
          (Ideal.map q₁ u₁).IsMaximal ∧
          ev₀.comp q₀ = ev₁.comp q₁ ∧
          RingHom.ker (ev₀.comp q₀) = u₁ ∧
          (∀ d : Ω, ev₀ (q₀ (φ₁ (c_B d))) = d) ∧
          (∀ (d₀ : Q₀) (d₁ : Q₁), ev₀ d₀ = ev₁ d₁ ↔ ∃ a' : A'₁, q₀ a' = d₀ ∧ q₁ a' = d₁) := by
      intro y₀ y₁ hyInf hySpan Q₀ Q₁ q₀ q₁
      have hInj_q : Function.Injective (RingHom.prod q₀ q₁) := by
        intro a₁ a₂ ha
        have h0 : q₀ (a₁ - a₂) = 0 := by rw [map_sub, sub_eq_zero]; exact congrArg Prod.fst ha
        have h1 : q₁ (a₁ - a₂) = 0 := by rw [map_sub, sub_eq_zero]; exact congrArg Prod.snd ha
        have hmem : a₁ - a₂ ∈ (Ideal.span ({y₁} : Set A'₁) : Ideal A'₁) ⊓ Ideal.span ({y₀} : Set A'₁) :=
          ⟨Ideal.Quotient.eq_zero_iff_mem.mp h0, Ideal.Quotient.eq_zero_iff_mem.mp h1⟩
        rw [hyInf, Submodule.mem_bot] at hmem
        exact sub_eq_zero.mp hmem
      let c_A : Ω →+* A'₁ := φ₁.comp c_B
      let e_u₁ : Ω ≃+* (A'₁ ⧸ u₁) := RingEquiv.ofBijective ((Ideal.Quotient.mk u₁).comp c_A) hBij_u₁
      let ev_u₁ : A'₁ →+* Ω := e_u₁.symm.toRingHom.comp (Ideal.Quotient.mk u₁)
      have hev_u₁_c : ∀ d : Ω, ev_u₁ (c_A d) = d := fun d => e_u₁.symm_apply_apply d
      have hker_ev_u₁ : RingHom.ker ev_u₁ = u₁ := by
        ext a
        simp only [RingHom.mem_ker, ev_u₁, RingHom.comp_apply]
        constructor
        · intro h
          have h' : Ideal.Quotient.mk u₁ a = 0 :=
            e_u₁.symm.injective (h.trans (map_zero _).symm)
          exact Ideal.Quotient.eq_zero_iff_mem.mp h'
        · intro ha
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
      have hy₀_u₁ : y₀ ∈ u₁ := hySpan ▸ Ideal.subset_span (Set.mem_insert _ _)
      have hy₁_u₁ : y₁ ∈ u₁ := hySpan ▸ Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      have hle₁ : ∀ a ∈ Ideal.span ({y₁} : Set A'₁), ev_u₁ a = 0 := fun a ha => by
        rw [← RingHom.mem_ker, hker_ev_u₁]
        exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy₁_u₁) ha
      have hle₀ : ∀ a ∈ Ideal.span ({y₀} : Set A'₁), ev_u₁ a = 0 := fun a ha => by
        rw [← RingHom.mem_ker, hker_ev_u₁]
        exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy₀_u₁) ha
      let ev₀ : Q₀ →+* Ω := Ideal.Quotient.lift (Ideal.span ({y₁} : Set A'₁)) ev_u₁ hle₁
      let ev₁ : Q₁ →+* Ω := Ideal.Quotient.lift (Ideal.span ({y₀} : Set A'₁)) ev_u₁ hle₀
      have hev₀_q₀ : ∀ a : A'₁, ev₀ (q₀ a) = ev_u₁ a :=
        fun a => Ideal.Quotient.lift_mk (Ideal.span ({y₁} : Set A'₁)) ev_u₁ hle₁
      have hev₁_q₁ : ∀ a : A'₁, ev₁ (q₁ a) = ev_u₁ a :=
        fun a => Ideal.Quotient.lift_mk (Ideal.span ({y₀} : Set A'₁)) ev_u₁ hle₀
      have hcomp₀ : ev₀.comp q₀ = ev_u₁ := RingHom.ext hev₀_q₀
      have hcomp₁ : ev₁.comp q₁ = ev_u₁ := RingHom.ext hev₁_q₁
      have hker_ev₀ : RingHom.ker ev₀ = Ideal.map q₀ u₁ := by
        apply le_antisymm
        · intro d hd
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective d
          rw [RingHom.mem_ker] at hd
          have ha : a ∈ u₁ := by
            rw [← hker_ev_u₁, RingHom.mem_ker, ← hev₀_q₀ a]
            exact hd
          exact Ideal.mem_map_of_mem q₀ ha
        · rw [Ideal.map_le_iff_le_comap]
          intro a ha
          rw [Ideal.mem_comap, RingHom.mem_ker, hev₀_q₀ a, ← RingHom.mem_ker, hker_ev_u₁]
          exact ha
      have hker_ev₁ : RingHom.ker ev₁ = Ideal.map q₁ u₁ := by
        apply le_antisymm
        · intro d hd
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective d
          rw [RingHom.mem_ker] at hd
          have ha : a ∈ u₁ := by
            rw [← hker_ev_u₁, RingHom.mem_ker, ← hev₁_q₁ a]
            exact hd
          exact Ideal.mem_map_of_mem q₁ ha
        · rw [Ideal.map_le_iff_le_comap]
          intro a ha
          rw [Ideal.mem_comap, RingHom.mem_ker, hev₁_q₁ a, ← RingHom.mem_ker, hker_ev_u₁]
          exact ha
      have hm₀ : (Ideal.map q₀ u₁).IsMaximal := by
        rw [← hker_ev₀]
        exact RingHom.ker_isMaximal_of_surjective ev₀
          fun d => ⟨q₀ (c_A d), (hev₀_q₀ (c_A d)).trans (hev_u₁_c d)⟩
      have hm₁ : (Ideal.map q₁ u₁).IsMaximal := by
        rw [← hker_ev₁]
        exact RingHom.ker_isMaximal_of_surjective ev₁
          fun d => ⟨q₁ (c_A d), (hev₁_q₁ (c_A d)).trans (hev_u₁_c d)⟩
      have hCRT_pair : ∀ (d₀ : Q₀) (d₁ : Q₁),
          ev₀ d₀ = ev₁ d₁ ↔ ∃ a' : A'₁, q₀ a' = d₀ ∧ q₁ a' = d₁ := by
        intro d₀ d₁
        constructor
        · intro heq
          obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective d₀
          obtain ⟨a₁, rfl⟩ := Ideal.Quotient.mk_surjective d₁
          have heq' : ev_u₁ a₀ = ev_u₁ a₁ :=
            (hev₀_q₀ a₀).symm.trans (heq.trans (hev₁_q₁ a₁))
          have hsub : a₀ - a₁ ∈ Ideal.span ({y₀, y₁} : Set A'₁) := by
            rw [hySpan, ← hker_ev_u₁, RingHom.mem_ker, map_sub, sub_eq_zero]
            exact heq'
          rw [Ideal.mem_span_pair] at hsub
          rcases hsub with ⟨r₀, r₁, hr⟩
          refine ⟨a₀ - r₁ * y₁, ?_, ?_⟩
          · have hy₁0 : q₀ y₁ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            rw [map_sub, map_mul, hy₁0, mul_zero, sub_zero]
          · have ha' : a₀ - r₁ * y₁ = a₁ + r₀ * y₀ := by
              have h1 : a₀ = r₀ * y₀ + r₁ * y₁ + a₁ := sub_eq_iff_eq_add.mp hr.symm
              calc a₀ - r₁ * y₁ = (r₀ * y₀ + r₁ * y₁ + a₁) - r₁ * y₁ := by rw [← h1]
                _ = a₁ + r₀ * y₀ := by ring
            rw [ha']
            have hy₀0 : q₁ y₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            rw [map_add, map_mul, hy₀0, mul_zero, add_zero]
        · rintro ⟨a', rfl, rfl⟩
          exact (hev₀_q₀ a').trans (hev₁_q₁ a').symm
      exact ⟨hInj_q, ev₀, ev₁, hker_ev₀, hm₀, hker_ev₁, hm₁,
        hcomp₀.trans hcomp₁.symm, hcomp₀.symm ▸ hker_ev_u₁,
        fun d => (hev₀_q₀ (c_A d)).trans (hev_u₁_c d), hCRT_pair⟩
    exact hCRT_abs x₀ x₁ hxInf hSpan_u₁

  
  have hStep2 :
      (∀ (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (θ : B₁ →+* D),
        Ideal.comap θ ⊥ ≠ p_z →
        ∃ (α : Fin (c + 1)) (ψ_br : B_tilde α →+* D),
          IsDomain (B_tilde α) ∧ ψ_br.comp (ι α) = θ) ∧
      (∀ y : (∀ α : Fin (c + 1), B_tilde α),
        ∃ (m : ℕ) (b : B₁), (RingHom.pi ι s) ^ m * y = RingHom.pi ι b) ∧
      ¬Function.Bijective (RingHom.pi ι) := by
    refine ⟨?_, ?_, ?_⟩
    · intro D _ _ _ θ hq_ne
      let q : Ideal B₁ := Ideal.comap θ ⊥
      haveI : q.IsPrime := Ideal.comap_isPrime θ ⊥
      obtain ⟨α, b_sm, hbsm_not_q, _, h_ker, h_surj⟩ := hSmLoc q hq_ne
      have hθ_ne : θ b_sm ≠ 0 := fun h0 =>
        hbsm_not_q (show b_sm ∈ Ideal.comap θ ⊥ by rw [Ideal.mem_comap, Submodule.mem_bot]; exact h0)
      have hDom_α : IsDomain (B_tilde α) := by
        rcases hSubOrDom α with hSub | hDom
        · exfalso
          have h10 : ι α 1 = 0 := @Subsingleton.elim _ hSub _ _
          obtain ⟨k, hk⟩ := h_ker 1 h10
          rw [mul_one] at hk
          have hpow : (θ b_sm) ^ k = 0 := by rw [← map_pow, hk, map_zero]
          exact hθ_ne (eq_zero_of_pow_eq_zero hpow)
        · exact hDom
      let K := FractionRing D
      let j_D : D →+* K := algebraMap D K
      have hinj_jD : Function.Injective j_D := IsFractionRing.injective D K
      let u_sm : K := j_D (θ b_sm)
      have hu_ne : u_sm ≠ 0 := fun h0 => hθ_ne (hinj_jD (h0.trans (map_zero _).symm))
      choose k_fn b_fn h_fn using h_surj
      let f₀ : B_tilde α → K := fun y => j_D (θ (b_fn y)) / u_sm ^ (k_fn y)
      have hf₀_spec : ∀ (y : B_tilde α) (m : ℕ) (a : B₁),
          (ι α b_sm) ^ m * y = ι α a → u_sm ^ m * f₀ y = j_D (θ a) := by
        intro y m a hma
        have hdiff : ι α (b_sm ^ m * b_fn y - b_sm ^ (k_fn y) * a) = 0 := by
          simp only [map_sub, map_mul, map_pow, ← h_fn y, ← hma]
          ring
        obtain ⟨n, hn⟩ := h_ker _ hdiff
        have hK_eq : u_sm ^ n * (u_sm ^ m * j_D (θ (b_fn y)) - u_sm ^ (k_fn y) * j_D (θ a)) = 0 := by
          have h := congrArg (j_D.comp θ) hn
          simpa only [RingHom.comp_apply, map_mul, map_sub, map_pow, map_zero, u_sm] using h
        have hsub0 : u_sm ^ m * j_D (θ (b_fn y)) - u_sm ^ (k_fn y) * j_D (θ a) = 0 :=
          (mul_eq_zero.mp hK_eq).resolve_left (pow_ne_zero n hu_ne)
        have hmul_eq : u_sm ^ m * j_D (θ (b_fn y)) = u_sm ^ (k_fn y) * j_D (θ a) :=
          sub_eq_zero.mp hsub0
        have hdiv : u_sm ^ (k_fn y) * f₀ y = j_D (θ (b_fn y)) :=
          mul_div_cancel₀ _ (pow_ne_zero (k_fn y) hu_ne)
        apply mul_left_cancel₀ (pow_ne_zero (k_fn y) hu_ne)
        calc u_sm ^ (k_fn y) * (u_sm ^ m * f₀ y)
            = u_sm ^ m * (u_sm ^ (k_fn y) * f₀ y) := by ring
          _ = u_sm ^ m * j_D (θ (b_fn y)) := by rw [hdiv]
          _ = u_sm ^ (k_fn y) * j_D (θ a) := hmul_eq
      have hf₀_ι : ∀ b : B₁, f₀ (ι α b) = j_D (θ b) := by
        intro b
        have h := hf₀_spec (ι α b) 0 b (by simp)
        simpa using h
      let f_K : B_tilde α →+* K :=
        { toFun := f₀
          map_one' := by rw [← map_one (ι α), hf₀_ι 1, map_one, map_one]
          map_zero' := by rw [← map_zero (ι α), hf₀_ι 0, map_zero, map_zero]
          map_add' := fun y₁ y₂ => by
            have hadd : (ι α b_sm) ^ (k_fn y₁ + k_fn y₂) * (y₁ + y₂) =
                ι α (b_sm ^ (k_fn y₂) * b_fn y₁ + b_sm ^ (k_fn y₁) * b_fn y₂) := by
              calc (ι α b_sm) ^ (k_fn y₁ + k_fn y₂) * (y₁ + y₂)
                  = (ι α b_sm) ^ (k_fn y₂) * ((ι α b_sm) ^ (k_fn y₁) * y₁) +
                      (ι α b_sm) ^ (k_fn y₁) * ((ι α b_sm) ^ (k_fn y₂) * y₂) := by
                    rw [pow_add]; ring
                _ = ι α (b_sm ^ (k_fn y₂) * b_fn y₁ + b_sm ^ (k_fn y₁) * b_fn y₂) := by
                    rw [h_fn y₁, h_fn y₂]; simp [map_add, map_mul, map_pow]
            have h := hf₀_spec (y₁ + y₂) (k_fn y₁ + k_fn y₂) _ hadd
            have h₁ := hf₀_spec y₁ (k_fn y₁) (b_fn y₁) (h_fn y₁)
            have h₂ := hf₀_spec y₂ (k_fn y₂) (b_fn y₂) (h_fn y₂)
            apply mul_left_cancel₀ (pow_ne_zero (k_fn y₁ + k_fn y₂) hu_ne)
            calc u_sm ^ (k_fn y₁ + k_fn y₂) * f₀ (y₁ + y₂)
                = j_D (θ (b_sm ^ (k_fn y₂) * b_fn y₁ + b_sm ^ (k_fn y₁) * b_fn y₂)) := h
              _ = u_sm ^ (k_fn y₂) * j_D (θ (b_fn y₁)) + u_sm ^ (k_fn y₁) * j_D (θ (b_fn y₂)) := by
                  simp [map_add, map_mul, map_pow, u_sm]
              _ = u_sm ^ (k_fn y₂) * (u_sm ^ (k_fn y₁) * f₀ y₁) +
                    u_sm ^ (k_fn y₁) * (u_sm ^ (k_fn y₂) * f₀ y₂) := by rw [← h₁, ← h₂]
              _ = u_sm ^ (k_fn y₁ + k_fn y₂) * (f₀ y₁ + f₀ y₂) := by rw [pow_add]; ring
          map_mul' := fun y₁ y₂ => by
            have hmul : (ι α b_sm) ^ (k_fn y₁ + k_fn y₂) * (y₁ * y₂) =
                ι α (b_fn y₁ * b_fn y₂) := by
              calc (ι α b_sm) ^ (k_fn y₁ + k_fn y₂) * (y₁ * y₂)
                  = ((ι α b_sm) ^ (k_fn y₁) * y₁) * ((ι α b_sm) ^ (k_fn y₂) * y₂) := by
                    rw [pow_add]; ring
                _ = ι α (b_fn y₁ * b_fn y₂) := by rw [h_fn y₁, h_fn y₂, map_mul]
            have h := hf₀_spec (y₁ * y₂) (k_fn y₁ + k_fn y₂) _ hmul
            have h₁ := hf₀_spec y₁ (k_fn y₁) (b_fn y₁) (h_fn y₁)
            have h₂ := hf₀_spec y₂ (k_fn y₂) (b_fn y₂) (h_fn y₂)
            apply mul_left_cancel₀ (pow_ne_zero (k_fn y₁ + k_fn y₂) hu_ne)
            calc u_sm ^ (k_fn y₁ + k_fn y₂) * f₀ (y₁ * y₂)
                = j_D (θ (b_fn y₁ * b_fn y₂)) := h
              _ = j_D (θ (b_fn y₁)) * j_D (θ (b_fn y₂)) := by simp [map_mul]
              _ = (u_sm ^ (k_fn y₁) * f₀ y₁) * (u_sm ^ (k_fn y₂) * f₀ y₂) := by rw [← h₁, ← h₂]
              _ = u_sm ^ (k_fn y₁ + k_fn y₂) * (f₀ y₁ * f₀ y₂) := by rw [pow_add]; ring }
      have hf_K_comp : f_K.comp (ι α) = j_D.comp θ := RingHom.ext hf₀_ι
      have hf_K_int : ∀ y : B_tilde α, ∃ d : D, j_D d = f_K y := by
        intro y
        obtain ⟨P, hP_monic, hP_eval⟩ := (hFin_ι α).to_isIntegral y
        have hint : IsIntegral D (f_K y) := by
          refine ⟨P.map θ, hP_monic.map θ, ?_⟩
          rw [Polynomial.eval₂_map, ← hf_K_comp, ← Polynomial.hom_eval₂, hP_eval, map_zero]
        exact (IsIntegrallyClosed.isIntegral_iff (R := D) (K := K)).mp hint
      choose ψ_fn hψ_fn using hf_K_int
      let ψ_br : B_tilde α →+* D :=
        { toFun := ψ_fn
          map_one' := hinj_jD (by rw [hψ_fn, map_one, map_one])
          map_zero' := hinj_jD (by rw [hψ_fn, map_zero, map_zero])
          map_add' := fun x y => hinj_jD (by rw [hψ_fn, map_add, map_add, hψ_fn, hψ_fn])
          map_mul' := fun x y => hinj_jD (by rw [hψ_fn, map_mul, map_mul, hψ_fn, hψ_fn]) }
      refine ⟨α, ψ_br, hDom_α, RingHom.ext fun b => hinj_jD ?_⟩
      change j_D (ψ_fn (ι α b)) = j_D (θ b)
      rw [hψ_fn]
      exact hf₀_ι b
    · intro y
      let ι_all : B₁ →+* (∀ α : Fin (c + 1), B_tilde α) := RingHom.pi ι
      let J_y : Ideal B₁ :=
        { carrier := {f : B₁ | ∃ b : B₁, ι_all f * y = ι_all b}
          zero_mem' := ⟨0, by simp⟩
          add_mem' := fun ⟨b₁, h₁⟩ ⟨b₂, h₂⟩ =>
            ⟨b₁ + b₂, by rw [map_add, add_mul, h₁, h₂, map_add]⟩
          smul_mem' := fun d f ⟨b, hb⟩ =>
            ⟨d * b, by simp only [smul_eq_mul, map_mul, mul_assoc, hb]⟩ }
      by_contra hNoPow
      push Not at hNoPow
      have hNoPow' : ∀ m : ℕ, s ^ m ∉ J_y := fun m ⟨b, hb⟩ =>
        hNoPow m b (by simpa [ι_all, map_pow] using hb)
      let S_s := Localization.Away s
      let loc_s : B₁ →+* S_s := algebraMap B₁ S_s
      have hMapNeTop : Ideal.map loc_s J_y ≠ ⊤ := by
        intro htop
        have h1 : (1 : S_s) ∈ Ideal.map loc_s J_y := htop ▸ trivial
        have hClearMap : ∀ z ∈ Ideal.map loc_s J_y,
            ∃ (m : ℕ) (j : B₁), j ∈ J_y ∧ z * loc_s s ^ m = loc_s j := by
          intro z hz
          induction hz using Submodule.span_induction with
          | mem w hw =>
            rcases hw with ⟨j, hj, rfl⟩
            exact ⟨0, j, hj, by simp⟩
          | zero => exact ⟨0, 0, J_y.zero_mem, by simp⟩
          | add w₁ w₂ _ _ ih₁ ih₂ =>
            rcases ih₁ with ⟨m₁, j₁, hj₁, h₁⟩
            rcases ih₂ with ⟨m₂, j₂, hj₂, h₂⟩
            refine ⟨m₁ + m₂, s ^ m₂ * j₁ + s ^ m₁ * j₂,
              J_y.add_mem (J_y.mul_mem_left _ hj₁) (J_y.mul_mem_left _ hj₂), ?_⟩
            calc (w₁ + w₂) * loc_s s ^ (m₁ + m₂)
                = loc_s s ^ m₂ * (w₁ * loc_s s ^ m₁) + loc_s s ^ m₁ * (w₂ * loc_s s ^ m₂) := by
                  rw [pow_add]; ring
              _ = loc_s (s ^ m₂ * j₁ + s ^ m₁ * j₂) := by
                  rw [h₁, h₂]; simp [map_add, map_mul, map_pow]
          | smul c_s w _ ih =>
            rcases ih with ⟨m₁, j₁, hj₁, h₁⟩
            obtain ⟨m₂, a_s, ha_s⟩ := IsLocalization.Away.surj s c_s (S := S_s)
            change c_s * loc_s s ^ m₂ = loc_s a_s at ha_s
            refine ⟨m₂ + m₁, a_s * j₁, J_y.mul_mem_left _ hj₁, ?_⟩
            calc (c_s • w) * loc_s s ^ (m₂ + m₁)
                = (c_s * loc_s s ^ m₂) * (w * loc_s s ^ m₁) := by
                  change (c_s * w) * loc_s s ^ (m₂ + m₁) = _
                  rw [pow_add]; ring
              _ = loc_s (a_s * j₁) := by rw [ha_s, h₁, map_mul]
        obtain ⟨m₁, j, hj, hj_eq⟩ := hClearMap 1 h1
        have hloc_eq : algebraMap B₁ S_s (s ^ m₁) = algebraMap B₁ S_s j := by
          change loc_s (s ^ m₁) = loc_s j
          rw [map_pow, ← one_mul (loc_s s ^ m₁), hj_eq]
        obtain ⟨⟨_, m₂, rfl⟩, hm₂⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers s) S_s).mp hloc_eq
        have hpow_in : s ^ (m₂ + m₁) ∈ J_y := by
          have heq : s ^ (m₂ + m₁) = s ^ m₂ * j := by
            calc s ^ (m₂ + m₁) = s ^ m₂ * s ^ m₁ := pow_add s m₂ m₁
              _ = s ^ m₂ * j := hm₂
          rw [heq]
          exact J_y.mul_mem_left _ hj
        exact hNoPow' (m₂ + m₁) hpow_in
      obtain ⟨M_max, hM_max, hle_M⟩ := (Ideal.map loc_s J_y).exists_le_maximal hMapNeTop
      let q : Ideal B₁ := Ideal.comap loc_s M_max
      haveI : q.IsPrime := Ideal.comap_isPrime loc_s M_max
      have hJy_le_q : J_y ≤ q := Ideal.map_le_iff_le_comap.mp hle_M
      have hs_not_q : s ∉ q := by
        intro hsq
        obtain ⟨u_s, hu_s⟩ := IsLocalization.Away.algebraMap_isUnit s (S := S_s)
        have hu_mem : (u_s : S_s) ∈ M_max := by rwa [hu_s]
        exact hM_max.ne_top (M_max.eq_top_of_isUnit_mem hu_mem u_s.isUnit)
      have hq_ne_pz : q ≠ p_z := fun heq => hs_not_q (heq ▸ hs_mem)
      obtain ⟨α, b_sm, hbsm_not_q, hbsm_other, _, hbsm_surj⟩ := hSmLoc q hq_ne_pz
      obtain ⟨k, b₀, hkb₀⟩ := hbsm_surj (y α)
      have hbsm_in_Jy : b_sm ^ (k + 1) ∈ J_y := by
        refine ⟨b_sm * b₀, ?_⟩
        funext β
        simp only [Pi.mul_apply, ι_all, RingHom.pi_apply]
        by_cases hβ : β = α
        · subst hβ
          calc ι β (b_sm ^ (k + 1)) * y β
              = ι β b_sm * ((ι β b_sm) ^ k * y β) := by rw [pow_succ', map_mul, map_pow, mul_assoc]
            _ = ι β (b_sm * b₀) := by rw [hkb₀, ← map_mul]
        · rw [map_pow, hbsm_other β hβ, zero_pow (Nat.succ_ne_zero k), zero_mul,
            map_mul, hbsm_other β hβ, zero_mul]
      exact hbsm_not_q (‹q.IsPrime›.mem_of_pow_mem (k + 1) (hJy_le_q hbsm_in_Jy))
    · intro hBij
      classical
      let e_π := RingEquiv.ofBijective (RingHom.pi ι) hBij
      let δ : Fin (c + 1) → (∀ β : Fin (c + 1), B_tilde β) :=
        fun α β => if β = α then 1 else 0
      have hsum_δ : (∑ α : Fin (c + 1), δ α) = 1 := by
        funext β
        simp [δ, Finset.sum_apply]
      have hsum_e : (∑ α : Fin (c + 1), e_π.symm (δ α)) = 1 := by
        rw [← map_sum, hsum_δ, map_one]
      have hex_not_pz : ∃ α_star : Fin (c + 1), e_π.symm (δ α_star) ∉ p_z := by
        by_contra hall
        push Not at hall
        have h1_in : (1 : B₁) ∈ p_z := by
          rw [← hsum_e]
          exact p_z.sum_mem fun α _ => hall α
        exact ‹p_z.IsPrime›.one_notMem h1_in
      rcases hex_not_pz with ⟨α_star, hnot_pz⟩
      apply hNotIso
      refine ⟨α_star, e_π.symm (δ α_star), hnot_pz, ?_, ?_⟩
      · intro β hβ
        have h : ι β (e_π.symm (δ α_star)) = δ α_star β :=
          congrFun (e_π.apply_symm_apply (δ α_star)) β
        dsimp only [δ] at h
        rw [if_neg hβ] at h
        exact h
      · intro y₀
        refine ⟨0, e_π.symm (Function.update 0 α_star y₀), ?_⟩
        have h : ι α_star (e_π.symm (Function.update 0 α_star y₀)) =
            (Function.update (0 : ∀ β, B_tilde β) α_star y₀) α_star :=
          congrFun (e_π.apply_symm_apply (Function.update 0 α_star y₀)) α_star
        rw [Function.update_self] at h
        simpa using h.symm

  
  have hStep3 : ∀ (B_all P_prod : Type u) [CommRing B_all] [CommRing P_prod]
      (ι_a : B₁ →+* B_all)
      (f_left : B_all →+* P_prod)
      (f_right : A'₁ →+* P_prod)
      (ev_l ev_r : P_prod →+* Ω),
      Function.Injective ι_a →
      ¬Function.Bijective ι_a →
      (∀ y : B_all, ι_a s * y = 0 → y = 0) →
      (∀ y : B_all, ∃ (m : ℕ) (b : B₁), (ι_a s) ^ m * y = ι_a b) →
      Function.Injective f_right →
      f_left.comp ι_a = f_right.comp φ₁ →
      (∀ z : P_prod, ev_l z = ev_r z ↔ ∃ a' : A'₁, f_right a' = z) →
      (∀ d : Ω, ev_l (f_right (φ₁ (c_B d))) = d ∧ ev_r (f_right (φ₁ (c_B d))) = d) →
      letI : Algebra B₁ B_all := ι_a.toAlgebra
      letI : Algebra B₁ A'₁ := φ₁.toAlgebra
      (∃ (Φ : TensorProduct B₁ B_all A'₁ →+* P_prod),
        (∀ (y : B_all) (a' : A'₁), Φ (y ⊗ₜ[B₁] a') = f_left y * f_right a') ∧
        Function.Bijective Φ) ∧
      (∀ y : B_all, ev_l (f_left y) = ev_r (f_left y) →
        (∃ a' : A'₁, f_right a' = f_left y ∧
          (y ⊗ₜ[B₁] (1 : A'₁) : TensorProduct B₁ B_all A'₁) = (1 : B_all) ⊗ₜ[B₁] a') ∧
        (∃ b : B₁, ι_a b = y)) := by
    intro B_all P_prod _ _ ι_a f_left f_right ev_l ev_r
      hInj_ιa hNotBij_ιa hs_reg_a hs_clear_a hInj_fr hComm_B hCRT_z hEv_d
    letI : Algebra B₁ B_all := ι_a.toAlgebra
    letI : Algebra B₁ A'₁ := φ₁.toAlgebra
    letI : Algebra B₁ P_prod := (f_right.comp φ₁).toAlgebra
    haveI : Algebra.Etale B₁ A'₁ := (RingHom.etale_algebraMap (R := B₁) (S := A'₁)).mp hEtφ₁
    haveI : Module.Flat B₁ A'₁ := inferInstance
    haveI : Module.FaithfullyFlat B₁ A'₁ := Module.FaithfullyFlat.of_comap_surjective hSurj
    let f_left_alg : B_all →ₐ[B₁] P_prod :=
      { f_left with commutes' := fun b => DFunLike.congr_fun hComm_B b }
    let f_right_alg : A'₁ →ₐ[B₁] P_prod :=
      { f_right with commutes' := fun _ => rfl }
    let Φ : TensorProduct B₁ B_all A'₁ →+* P_prod :=
      (Algebra.TensorProduct.productMap f_left_alg f_right_alg).toRingHom
    have hΦ_tmul : ∀ (y : B_all) (a' : A'₁), Φ (y ⊗ₜ[B₁] a') = f_left y * f_right a' :=
      fun y a' => Algebra.TensorProduct.productMap_apply_tmul f_left_alg f_right_alg y a'
    let μ_s : B_all →ₗ[B₁] B_all :=
      { toFun := fun y => ι_a s * y
        map_add' := fun x y => mul_add (ι_a s) x y
        map_smul' := fun b y => by
          change ι_a s * (ι_a b * y) = ι_a b * (ι_a s * y)
          ring }
    have hμ_inj : Function.Injective μ_s := by
      intro y₁ y₂ hy
      have h0 : ι_a s * (y₁ - y₂) = 0 := by rw [mul_sub]; exact sub_eq_zero.mpr hy
      exact sub_eq_zero.mp (hs_reg_a (y₁ - y₂) h0)
    have hr_inj : Function.Injective (LinearMap.rTensor A'₁ μ_s) :=
      Module.Flat.rTensor_preserves_injective_linearMap μ_s hμ_inj
    have hr_eq : ∀ w : TensorProduct B₁ B_all A'₁,
        LinearMap.rTensor A'₁ μ_s w = ((1 : B_all) ⊗ₜ[B₁] φ₁ s) * w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul y a' =>
        rw [LinearMap.rTensor_tmul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        change (s • y) ⊗ₜ[B₁] a' = y ⊗ₜ[B₁] (s • a')
        exact TensorProduct.smul_tmul s y a'
      | add w₁ w₂ ih₁ ih₂ => rw [map_add, mul_add, ih₁, ih₂]
    have hs_tensor_reg : ∀ (N : ℕ) (w : TensorProduct B₁ B_all A'₁),
        ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ N * w = 0 → w = 0 := by
      intro N
      induction N with
      | zero => intro w hw; simpa using hw
      | succ N ih =>
        intro w hw
        rw [pow_succ, mul_assoc] at hw
        have hw' : ((1 : B_all) ⊗ₜ[B₁] φ₁ s) * w = 0 := ih _ hw
        rw [← hr_eq] at hw'
        exact hr_inj (hw'.trans (map_zero _).symm)
    have h1_pow : ∀ n : ℕ,
        ((1 : B_all) ⊗ₜ[B₁] φ₁ s : TensorProduct B₁ B_all A'₁) ^ n =
          (1 : B_all) ⊗ₜ[B₁] ((φ₁ s) ^ n) := by
      intro n
      induction n with
      | zero => simp; rfl
      | succ n ih =>
        rw [pow_succ, ih, Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← pow_succ]
    have hTensorClear : ∀ w : TensorProduct B₁ B_all A'₁,
        ∃ (N : ℕ) (z : A'₁), ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ N * w = (1 : B_all) ⊗ₜ[B₁] z := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, by simp⟩
      | tmul y a' =>
        obtain ⟨m, b, hmb⟩ := hs_clear_a y
        refine ⟨m, φ₁ b * a', ?_⟩
        rw [h1_pow m, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        have hsm₁ : y ⊗ₜ[B₁] ((φ₁ s) ^ m * a') = ((s ^ m) • y) ⊗ₜ[B₁] a' := by
          rw [← map_pow]
          change y ⊗ₜ[B₁] ((s ^ m) • a') = ((s ^ m) • y) ⊗ₜ[B₁] a'
          exact (TensorProduct.smul_tmul (s ^ m) y a').symm
        rw [hsm₁]
        have hsm₂ : ((s ^ m) • y) = b • (1 : B_all) := by
          change ι_a (s ^ m) * y = ι_a b * 1
          rw [map_pow, mul_one, hmb]
        rw [hsm₂, TensorProduct.smul_tmul]
        rfl
      | add w₁ w₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨N₁, z₁, h₁⟩
        rcases ih₂ with ⟨N₂, z₂, h₂⟩
        refine ⟨N₁ + N₂, (φ₁ s) ^ N₂ * z₁ + (φ₁ s) ^ N₁ * z₂, ?_⟩
        have t₁ : ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ (N₁ + N₂) * w₁ =
            (1 : B_all) ⊗ₜ[B₁] ((φ₁ s) ^ N₂ * z₁) := by
          calc ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ (N₁ + N₂) * w₁
              = ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ N₂ * (((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ N₁ * w₁) := by
                rw [pow_add]; ring
            _ = ((1 : B_all) ⊗ₜ[B₁] ((φ₁ s) ^ N₂)) * ((1 : B_all) ⊗ₜ[B₁] z₁) := by
                rw [h₁, h1_pow]
            _ = (1 : B_all) ⊗ₜ[B₁] ((φ₁ s) ^ N₂ * z₁) := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        have t₂ : ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ (N₁ + N₂) * w₂ =
            (1 : B_all) ⊗ₜ[B₁] ((φ₁ s) ^ N₁ * z₂) := by
          calc ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ (N₁ + N₂) * w₂
              = ((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ N₁ * (((1 : B_all) ⊗ₜ[B₁] φ₁ s) ^ N₂ * w₂) := by
                rw [pow_add]; ring
            _ = ((1 : B_all) ⊗ₜ[B₁] ((φ₁ s) ^ N₁)) * ((1 : B_all) ⊗ₜ[B₁] z₂) := by
                rw [h₂, h1_pow]
            _ = (1 : B_all) ⊗ₜ[B₁] ((φ₁ s) ^ N₁ * z₂) := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        rw [mul_add, t₁, t₂, ← TensorProduct.tmul_add]
    have hInj_Φ : Function.Injective Φ := by
      intro w₁ w₂ hw
      have hw0 : Φ (w₁ - w₂) = 0 := by rw [map_sub, sub_eq_zero]; exact hw
      obtain ⟨N, z, hz⟩ := hTensorClear (w₁ - w₂)
      have hfrz : f_right z = 0 := by
        have h := congrArg Φ hz
        rw [map_mul, hw0, mul_zero, hΦ_tmul, map_one, one_mul] at h
        exact h.symm
      have hz0 : z = 0 := hInj_fr (hfrz.trans (map_zero _).symm)
      rw [hz0, TensorProduct.tmul_zero] at hz
      exact sub_eq_zero.mp (hs_tensor_reg N (w₁ - w₂) hz)
    have hCond : ∀ (y : B_all) (a' : A'₁),
        (y ⊗ₜ[B₁] (1 : A'₁) : TensorProduct B₁ B_all A'₁) = (1 : B_all) ⊗ₜ[B₁] a' →
        ∃ b : B₁, ι_a b = y := by
      intro y a' hya'
      let L : Submodule B₁ B_all := LinearMap.range (Algebra.linearMap B₁ B_all)
      have h1L : (1 : B_all) ∈ L := ⟨1, map_one ι_a⟩
      let g_y : B₁ →ₗ[B₁] (B_all ⧸ L) :=
        (Submodule.mkQ L).comp (LinearMap.toSpanSingleton B₁ B_all y)
      let J_y : Ideal B₁ := LinearMap.ker g_y
      let g_bar : (B₁ ⧸ J_y) →ₗ[B₁] (B_all ⧸ L) := Submodule.liftQ J_y g_y (le_refl _)
      have hg_bar_inj : Function.Injective g_bar := by
        rw [← LinearMap.ker_eq_bot, eq_bot_iff]
        intro q hq
        obtain ⟨f, rfl⟩ := Submodule.Quotient.mk_surjective J_y q
        rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
        exact hq
      have hl_inj : Function.Injective (LinearMap.lTensor A'₁ g_bar) :=
        Module.Flat.lTensor_preserves_injective_linearMap g_bar hg_bar_inj
      have hcomm_eq : ((1 : A'₁) ⊗ₜ[B₁] y : TensorProduct B₁ A'₁ B_all) = a' ⊗ₜ[B₁] (1 : B_all) :=
        congrArg (TensorProduct.comm B₁ B_all A'₁) hya'
      have hmkQ_eq : ((1 : A'₁) ⊗ₜ[B₁] Submodule.mkQ L y : TensorProduct B₁ A'₁ (B_all ⧸ L)) = 0 := by
        have h := congrArg (LinearMap.lTensor A'₁ (Submodule.mkQ L)) hcomm_eq
        rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul] at h
        have h1_0 : Submodule.mkQ L (1 : B_all) = 0 :=
          (Submodule.Quotient.mk_eq_zero L).mpr h1L
        rw [h1_0, TensorProduct.tmul_zero] at h
        exact h
      have hl_zero : LinearMap.lTensor A'₁ g_bar
          ((1 : A'₁) ⊗ₜ[B₁] Submodule.Quotient.mk (1 : B₁)) = 0 := by
        rw [LinearMap.lTensor_tmul]
        change (1 : A'₁) ⊗ₜ[B₁] Submodule.mkQ L ((1 : B₁) • y) = 0
        rwa [one_smul]
      have ht_zero : ((1 : A'₁) ⊗ₜ[B₁] Submodule.Quotient.mk (1 : B₁) :
          TensorProduct B₁ A'₁ (B₁ ⧸ J_y)) = 0 :=
        hl_inj (hl_zero.trans (map_zero _).symm)
      have hq_zero := congrArg (TensorProduct.tensorQuotEquivQuotSMul A'₁ J_y) ht_zero
      rw [map_zero] at hq_zero
      change (Submodule.Quotient.mk ((1 : B₁) • (1 : A'₁)) :
        A'₁ ⧸ (J_y • (⊤ : Submodule B₁ A'₁))) = 0 at hq_zero
      rw [one_smul, Submodule.Quotient.mk_eq_zero] at hq_zero
      have hsmul_le : J_y • (⊤ : Submodule B₁ A'₁) ≤
          (Ideal.map φ₁ J_y).restrictScalars B₁ := by
        rw [Submodule.smul_le]
        intro r hr x _
        change φ₁ r * x ∈ Ideal.map φ₁ J_y
        exact Ideal.mul_mem_right x _ (Ideal.mem_map_of_mem φ₁ hr)
      have h1_map : φ₁ 1 ∈ Ideal.map φ₁ J_y := by rw [map_one]; exact hsmul_le hq_zero
      have h1_comap : (1 : B₁) ∈ Ideal.comap (algebraMap B₁ A'₁)
          (Ideal.map (algebraMap B₁ A'₁) J_y) := h1_map
      rw [Ideal.comap_map_eq_self_of_faithfullyFlat J_y] at h1_comap
      have hg1 : Submodule.mkQ L ((1 : B₁) • y) = 0 := h1_comap
      rw [one_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hg1
      rcases hg1 with ⟨b, hb⟩
      exact ⟨b, hb⟩
    have hDesc_y : ∀ y : B_all, ev_l (f_left y) = ev_r (f_left y) →
        (∃ a' : A'₁, f_right a' = f_left y ∧
          (y ⊗ₜ[B₁] (1 : A'₁) : TensorProduct B₁ B_all A'₁) = (1 : B_all) ⊗ₜ[B₁] a') ∧
        (∃ b : B₁, ι_a b = y) := by
      intro y hev
      obtain ⟨a', ha'⟩ := (hCRT_z (f_left y)).mp hev
      have hΦ_eq : Φ (y ⊗ₜ[B₁] (1 : A'₁)) = Φ ((1 : B_all) ⊗ₜ[B₁] a') := by
        rw [hΦ_tmul, hΦ_tmul, map_one, map_one, mul_one, one_mul, ha']
      have htmul_eq := hInj_Φ hΦ_eq
      exact ⟨⟨a', ha', htmul_eq⟩, hCond y a' htmul_eq⟩
    have hSurj_Φ : Function.Surjective Φ := by
      have hex_e : ∃ e : B_all, ev_l (f_left e) ≠ ev_r (f_left e) := by
        by_contra hall
        push Not at hall
        exact hNotBij_ιa ⟨hInj_ιa, fun y => (hDesc_y y (hall y)).2⟩
      rcases hex_e with ⟨e, he_ne⟩
      let d_ne : Ω := ev_l (f_left e) - ev_r (f_left e)
      have hd_ne : d_ne ≠ 0 := sub_ne_zero.mpr he_ne
      intro z
      let μ : Ω := (ev_l z - ev_r z) * d_ne⁻¹
      let w₁ : TensorProduct B₁ B_all A'₁ := e ⊗ₜ[B₁] φ₁ (c_B μ)
      have hev_diff : ev_l (z - Φ w₁) = ev_r (z - Φ w₁) := by
        obtain ⟨hd_l, hd_r⟩ := hEv_d μ
        have hw₁_eq : Φ w₁ = f_left e * f_right (φ₁ (c_B μ)) := hΦ_tmul e (φ₁ (c_B μ))
        have hdiff_zero : ev_l (z - Φ w₁) - ev_r (z - Φ w₁) = 0 := by
          rw [hw₁_eq]
          simp only [map_sub, map_mul, hd_l, hd_r]
          calc (ev_l z - ev_l (f_left e) * μ) - (ev_r z - ev_r (f_left e) * μ)
              = (ev_l z - ev_r z) - d_ne * ((ev_l z - ev_r z) * d_ne⁻¹) := by
                dsimp only [d_ne, μ]; ring
            _ = (ev_l z - ev_r z) - (ev_l z - ev_r z) * (d_ne * d_ne⁻¹) := by ring
            _ = 0 := by rw [mul_inv_cancel₀ hd_ne, mul_one, sub_self]
        exact sub_eq_zero.mp hdiff_zero
      obtain ⟨a', ha'⟩ := (hCRT_z (z - Φ w₁)).mp hev_diff
      refine ⟨w₁ + (1 : B_all) ⊗ₜ[B₁] a', ?_⟩
      rw [map_add, hΦ_tmul (1 : B_all) a', map_one, one_mul, ha', add_sub_cancel]
    exact ⟨⟨Φ, hΦ_tmul, hInj_Φ, hSurj_Φ⟩, hDesc_y⟩

  
  have hStep4 : ∀ (D₀ D₁ : Type u) [CommRing D₀] [CommRing D₁] [IsDomain D₀] [IsDomain D₁]
      (π₀ : A'₁ →+* D₀) (_ : Function.Surjective π₀)
      (π₁ : A'₁ →+* D₁) (_ : Function.Surjective π₁)
      (α₀ α₁ : Fin (c + 1)) (_ : IsDomain (B_tilde α₀)) (_ : IsDomain (B_tilde α₁))
      (ψ_br₀ : B_tilde α₀ →+* D₀) (ψ_br₁ : B_tilde α₁ →+* D₁),
      ψ_br₀.comp (ι α₀) = π₀.comp φ₁ →
      ψ_br₁.comp (ι α₁) = π₁.comp φ₁ →
      ∀ (Φ : letI : Algebra B₁ (∀ α : Fin (c + 1), B_tilde α) := (RingHom.pi ι).toAlgebra
             letI : Algebra B₁ A'₁ := φ₁.toAlgebra
             TensorProduct B₁ (∀ α : Fin (c + 1), B_tilde α) A'₁ →+* D₀ × D₁),
      (letI : Algebra B₁ (∀ α : Fin (c + 1), B_tilde α) := (RingHom.pi ι).toAlgebra
       letI : Algebra B₁ A'₁ := φ₁.toAlgebra
       ∀ y : (∀ α : Fin (c + 1), B_tilde α),
         Φ (y ⊗ₜ[B₁] (1 : A'₁)) = (ψ_br₀ (y α₀), ψ_br₁ (y α₁))) →
      Function.Bijective Φ →
      Function.Injective ψ_br₀ ∧
      Function.Injective ψ_br₁ ∧
      ψ_br₀.FiniteType ∧
      ψ_br₁.FiniteType ∧
      @Module.Flat (B_tilde α₀) D₀ _ _ ψ_br₀.toAlgebra.toModule ∧
      @Algebra.FormallyUnramified (B_tilde α₀) D₀ _ _ ψ_br₀.toAlgebra ∧
      @Module.Flat (B_tilde α₁) D₁ _ _ ψ_br₁.toAlgebra.toModule ∧
      @Algebra.FormallyUnramified (B_tilde α₁) D₁ _ _ ψ_br₁.toAlgebra := by
    intro D₀ D₁ _ _ _ _ π₀ hSurj₀ π₁ hSurj₁ α₀ α₁ hDom_α₀ hDom_α₁ ψ_br₀ ψ_br₁
      hComp₀ hComp₁ Φ hΦ_left hBij_Φ
    letI : Algebra B₁ (∀ α : Fin (c + 1), B_tilde α) := (RingHom.pi ι).toAlgebra
    letI : Algebra B₁ A'₁ := φ₁.toAlgebra
    haveI : Algebra.Etale B₁ A'₁ := (RingHom.etale_algebraMap (R := B₁) (S := A'₁)).mp hEtφ₁
    have hFT_φ₁ : φ₁.FiniteType := RingHom.finiteType_algebraMap.mpr inferInstance
    haveI : Algebra.Etale (∀ α : Fin (c + 1), B_tilde α)
        (TensorProduct B₁ (∀ α : Fin (c + 1), B_tilde α) A'₁) :=
      Algebra.Etale.baseChange B₁ A'₁ (∀ α : Fin (c + 1), B_tilde α)
    have hEt_incL : (algebraMap (∀ α : Fin (c + 1), B_tilde α)
        (TensorProduct B₁ (∀ α : Fin (c + 1), B_tilde α) A'₁)).Etale :=
      (RingHom.etale_algebraMap (R := ∀ α : Fin (c + 1), B_tilde α)
        (S := TensorProduct B₁ (∀ α : Fin (c + 1), B_tilde α) A'₁)).mpr inferInstance
    have hEt_Φinc : (Φ.comp (algebraMap (∀ α : Fin (c + 1), B_tilde α)
        (TensorProduct B₁ (∀ α : Fin (c + 1), B_tilde α) A'₁))).Etale :=
      RingHom.Etale.stableUnderComposition _ _ hEt_incL (RingHom.Etale.of_bijective hBij_Φ)
    have hEt_fst : (RingHom.fst D₀ D₁).Etale := by
      letI : Algebra (D₀ × D₁) D₀ := (RingHom.fst D₀ D₁).toAlgebra
      haveI : IsLocalization.Away ((1 : D₀), (0 : D₁)) D₀ :=
        { map_units := by
            rintro ⟨_, n, rfl⟩
            change IsUnit ((RingHom.fst D₀ D₁) (((1 : D₀), (0 : D₁)) ^ n))
            simp
          surj := fun z => ⟨((z, 0), 1), by simp; rfl⟩
          exists_of_eq := fun {x y} hxy =>
            ⟨⟨(1, 0), 1, pow_one _⟩, by
              ext
              · change 1 * x.1 = 1 * y.1
                rw [one_mul, one_mul]
                exact hxy
              · simp⟩ }
      haveI : Algebra.Etale (D₀ × D₁) D₀ := Algebra.Etale.of_isLocalizationAway ((1 : D₀), (0 : D₁))
      exact (RingHom.etale_algebraMap (R := D₀ × D₁) (S := D₀)).mpr inferInstance
    have hEt_snd : (RingHom.snd D₀ D₁).Etale := by
      letI : Algebra (D₀ × D₁) D₁ := (RingHom.snd D₀ D₁).toAlgebra
      haveI : IsLocalization.Away ((0 : D₀), (1 : D₁)) D₁ :=
        { map_units := by
            rintro ⟨_, n, rfl⟩
            change IsUnit ((RingHom.snd D₀ D₁) (((0 : D₀), (1 : D₁)) ^ n))
            simp
          surj := fun z => ⟨((0, z), 1), by simp; rfl⟩
          exists_of_eq := fun {x y} hxy =>
            ⟨⟨(0, 1), 1, pow_one _⟩, by
              ext
              · simp
              · change 1 * x.2 = 1 * y.2
                rw [one_mul, one_mul]
                exact hxy⟩ }
      haveI : Algebra.Etale (D₀ × D₁) D₁ := Algebra.Etale.of_isLocalizationAway ((0 : D₀), (1 : D₁))
      exact (RingHom.etale_algebraMap (R := D₀ × D₁) (S := D₁)).mpr inferInstance
    have hFactor : ∀ (α : Fin (c + 1)) (_ : IsDomain (B_tilde α))
        (D : Type u) [CommRing D] [IsDomain D]
        (π : A'₁ →+* D) (_ : Function.Surjective π)
        (ψ_br : B_tilde α →+* D) (_ : ψ_br.comp (ι α) = π.comp φ₁)
        (proj_D : D₀ × D₁ →+* D) (_ : proj_D.Etale)
        (_ : ∀ y : (∀ β : Fin (c + 1), B_tilde β), proj_D (Φ (y ⊗ₜ[B₁] (1 : A'₁))) = ψ_br (y α)),
        Function.Injective ψ_br ∧
        ψ_br.FiniteType ∧
        @Module.Flat (B_tilde α) D _ _ ψ_br.toAlgebra.toModule ∧
        @Algebra.FormallyUnramified (B_tilde α) D _ _ ψ_br.toAlgebra := by
      intro α hDomα D _ _ π hSurj_π ψ_br hComp_br proj_D hEt_proj hProj_Φ
      haveI : IsDomain (B_tilde α) := hDomα
      have hCompEq : ψ_br.comp (Pi.evalRingHom B_tilde α) =
          proj_D.comp (Φ.comp (algebraMap (∀ β : Fin (c + 1), B_tilde β)
            (TensorProduct B₁ (∀ β : Fin (c + 1), B_tilde β) A'₁))) :=
        RingHom.ext fun y => (hProj_Φ y).symm
      have hEt_comp : (ψ_br.comp (Pi.evalRingHom B_tilde α)).Etale := by
        rw [hCompEq]
        exact RingHom.Etale.stableUnderComposition _ _ hEt_Φinc hEt_proj
      classical
      let δ_α : ∀ β : Fin (c + 1), B_tilde β := fun β => if β = α then 1 else 0
      letI : Algebra (∀ β : Fin (c + 1), B_tilde β) (B_tilde α) :=
        (Pi.evalRingHom B_tilde α).toAlgebra
      letI : Algebra (∀ β : Fin (c + 1), B_tilde β) D :=
        (ψ_br.comp (Pi.evalRingHom B_tilde α)).toAlgebra
      letI : Algebra (B_tilde α) D := ψ_br.toAlgebra
      haveI : IsScalarTower (∀ β : Fin (c + 1), B_tilde β) (B_tilde α) D :=
        IsScalarTower.of_algebraMap_eq' rfl
      haveI : Algebra.Etale (∀ β : Fin (c + 1), B_tilde β) D :=
        (RingHom.etale_algebraMap (R := ∀ β : Fin (c + 1), B_tilde β) (S := D)).mp hEt_comp
      haveI : Module.Flat (∀ β : Fin (c + 1), B_tilde β) D := inferInstance
      haveI : Algebra.FormallyUnramified (∀ β : Fin (c + 1), B_tilde β) D := inferInstance
      haveI : IsLocalization (Submonoid.powers δ_α) (B_tilde α) :=
        { map_units := by
            rintro ⟨_, n, rfl⟩
            change IsUnit ((δ_α ^ n) α)
            rw [Pi.pow_apply]
            simp [δ_α]
          surj := fun z =>
            ⟨(Function.update 0 α z, 1), by
              change z * ((1 : Submonoid.powers δ_α) : ∀ β, B_tilde β) α =
                (Function.update (0 : ∀ β, B_tilde β) α z) α
              simp⟩
          exists_of_eq := fun {x y} hxy =>
            ⟨⟨δ_α, 1, pow_one _⟩, by
              funext β
              change δ_α β * x β = δ_α β * y β
              by_cases hβ : β = α
              · subst hβ
                have hxy' : x β = y β := hxy
                simp [δ_α, hxy']
              · simp [δ_α, hβ]⟩ }
      have hFlat_D : @Module.Flat (B_tilde α) D _ _ ψ_br.toAlgebra.toModule :=
        (Module.flat_iff_of_isLocalization (R := ∀ β : Fin (c + 1), B_tilde β)
          (S := B_tilde α) (Submonoid.powers δ_α) D).mpr inferInstance
      have hUnram_D : @Algebra.FormallyUnramified (B_tilde α) D _ _ ψ_br.toAlgebra :=
        Algebra.FormallyUnramified.localization_base (Submonoid.powers δ_α)
      have hInj_D : Function.Injective ψ_br := by
        haveI : Module.Flat (B_tilde α) D := hFlat_D
        intro r₁ r₂ hr
        by_contra hne
        have hr0 : ψ_br (r₁ - r₂) = 0 := by rw [map_sub, sub_eq_zero]; exact hr
        have hnzd : r₁ - r₂ ∈ nonZeroDivisors (B_tilde α) :=
          mem_nonZeroDivisors_of_ne_zero (sub_ne_zero.mpr hne)
        have hreg : IsSMulRegular D (r₁ - r₂) :=
          Module.Flat.isSMulRegular_of_nonZeroDivisors hnzd
        have hsm : (r₁ - r₂) • (1 : D) = (r₁ - r₂) • (0 : D) := by
          change ψ_br (r₁ - r₂) * 1 = ψ_br (r₁ - r₂) * 0
          rw [hr0, zero_mul, zero_mul]
        exact one_ne_zero (hreg hsm)
      have hFT_D : ψ_br.FiniteType := by
        have hπ : π.FiniteType := RingHom.FiniteType.of_surjective π hSurj_π
        have hπφ : (π.comp φ₁).FiniteType := RingHom.FiniteType.comp hπ hFT_φ₁
        rw [← hComp_br] at hπφ
        exact RingHom.FiniteType.of_comp_finiteType hπφ
      exact ⟨hInj_D, hFT_D, hFlat_D, hUnram_D⟩
    obtain ⟨hInj₀, hFT₀, hFlat₀, hUnram₀⟩ := hFactor α₀ hDom_α₀ D₀ π₀ hSurj₀
      ψ_br₀ hComp₀ (RingHom.fst D₀ D₁) hEt_fst (fun y => congrArg Prod.fst (hΦ_left y))
    obtain ⟨hInj₁, hFT₁, hFlat₁, hUnram₁⟩ := hFactor α₁ hDom_α₁ D₁ π₁ hSurj₁
      ψ_br₁ hComp₁ (RingHom.snd D₀ D₁) hEt_snd (fun y => congrArg Prod.snd (hΦ_left y))
    exact ⟨hInj₀, hInj₁, hFT₀, hFT₁, hFlat₀, hUnram₀, hFlat₁, hUnram₁⟩

  
  have hStep5 : ∀ (ev_B : B₁ →+* Ω),
      RingHom.ker ev_B = p_z →
      (∀ d : Ω, ev_B (c_B d) = d) →
      (∀ (α : Fin (c + 1)) (q_P : PrimeSpectrum (B_tilde α)),
        Ideal.comap (ι α) q_P.asIdeal = p_z →
        q_P.asIdeal.IsMaximal ∧
        ∃ (ev_P : B_tilde α →+* Ω),
          RingHom.ker ev_P = q_P.asIdeal ∧ ev_P.comp (ι α) = ev_B) ∧
      (∀ (α₀ α₁ : Fin (c + 1))
        (p₀ : PrimeSpectrum (B_tilde α₀)) (p₁ : PrimeSpectrum (B_tilde α₁)),
        p₀.asIdeal.IsMaximal → p₁.asIdeal.IsMaximal →
        ∀ (α : Fin (c + 1)) (q_P : PrimeSpectrum (B_tilde α)),
          (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde β)) ≠ ⟨α₀, p₀⟩ →
          (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde β)) ≠ ⟨α₁, p₁⟩ →
          ∃ s_tilde : (∀ β : Fin (c + 1), B_tilde β),
            s_tilde α ∉ q_P.asIdeal ∧
            s_tilde α₀ ∈ p₀.asIdeal ∧
            s_tilde α₁ ∈ p₁.asIdeal) := by
    intro ev_B hker_evB hevB_c
    have hp_z_max : p_z.IsMaximal := by
      rw [← hker_evB]
      exact RingHom.ker_isMaximal_of_surjective ev_B fun d => ⟨c_B d, hevB_c d⟩
    refine ⟨?_, ?_⟩
    · intro α q_P hq_comap
      have hq_max : q_P.asIdeal.IsMaximal :=
        Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (ι α) (hFin_ι α).to_isIntegral
          q_P.asIdeal (hq_comap.symm ▸ hp_z_max)
      let K_P := B_tilde α ⧸ q_P.asIdeal
      haveI : IsDomain K_P := Ideal.Quotient.isDomain q_P.asIdeal
      let f_P : Ω →+* K_P := (Ideal.Quotient.mk q_P.asIdeal).comp ((ι α).comp c_B)
      have hf_P_ev : f_P.comp ev_B = (Ideal.Quotient.mk q_P.asIdeal).comp (ι α) := by
        ext b
        simp only [f_P, RingHom.comp_apply]
        apply Ideal.Quotient.eq.mpr
        rw [← map_sub]
        change c_B (ev_B b) - b ∈ Ideal.comap (ι α) q_P.asIdeal
        rw [hq_comap, ← hker_evB, RingHom.mem_ker, map_sub, hevB_c, sub_self]
      have hf_P_int : f_P.IsIntegral := by
        intro y_bar
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
        obtain ⟨P, hP_monic, hP_eval⟩ := (hFin_ι α).to_isIntegral y
        refine ⟨P.map ev_B, hP_monic.map ev_B, ?_⟩
        rw [Polynomial.eval₂_map, hf_P_ev, ← Polynomial.hom_eval₂, hP_eval, map_zero]
      have hBij_fP : Function.Bijective f_P :=
        IsAlgClosed.ringHom_bijective_of_isIntegral f_P hf_P_int
      let e_P := RingEquiv.ofBijective f_P hBij_fP
      let ev_P : B_tilde α →+* Ω := e_P.symm.toRingHom.comp (Ideal.Quotient.mk q_P.asIdeal)
      have hker_P : RingHom.ker ev_P = q_P.asIdeal := by
        ext y
        simp only [RingHom.mem_ker, ev_P, RingHom.comp_apply]
        constructor
        · intro h
          have h' : Ideal.Quotient.mk q_P.asIdeal y = 0 :=
            e_P.symm.injective (h.trans (map_zero _).symm)
          exact Ideal.Quotient.eq_zero_iff_mem.mp h'
        · intro hy
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hy, map_zero]
      have hcomp_P : ev_P.comp (ι α) = ev_B := by
        ext b
        apply e_P.injective
        change e_P (e_P.symm (Ideal.Quotient.mk q_P.asIdeal (ι α b))) = f_P (ev_B b)
        rw [e_P.apply_symm_apply]
        exact (DFunLike.congr_fun hf_P_ev b).symm
      exact ⟨hq_max, ev_P, hker_P, hcomp_P⟩
    · intro α₀ α₁ p₀ p₁ hp₀_max hp₁_max α q_P hne₀ hne₁
      have hOneSep : ∀ (α' : Fin (c + 1)) (p' : PrimeSpectrum (B_tilde α')),
          p'.asIdeal.IsMaximal →
          (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde β)) ≠ ⟨α', p'⟩ →
          ∃ s' : (∀ β : Fin (c + 1), B_tilde β),
            s' α ∉ q_P.asIdeal ∧ s' α' ∈ p'.asIdeal := by
        intro α' p' hp'_max hne
        classical
        by_cases hα : α = α'
        · subst hα
          have hp_ne : p' ≠ q_P := fun heq => hne (heq ▸ rfl)
          have hnot_le : ¬(p'.asIdeal ≤ q_P.asIdeal) := fun hle =>
            hp_ne (PrimeSpectrum.ext (hp'_max.eq_of_le q_P.isPrime.ne_top hle))
          obtain ⟨y, hy_in, hy_not⟩ := SetLike.not_le_iff_exists.mp hnot_le
          refine ⟨Function.update 0 α y, ?_, ?_⟩
          · simpa using hy_not
          · simpa using hy_in
        · refine ⟨Function.update 0 α 1, ?_, ?_⟩
          · simpa using q_P.isPrime.one_notMem
          · simp [Function.update_of_ne (Ne.symm hα), p'.asIdeal.zero_mem]
      obtain ⟨s₀, hs₀_not, hs₀_in⟩ := hOneSep α₀ p₀ hp₀_max hne₀
      obtain ⟨s₁, hs₁_not, hs₁_in⟩ := hOneSep α₁ p₁ hp₁_max hne₁
      exact ⟨s₀ * s₁, q_P.isPrime.mul_notMem hs₀_not hs₁_not,
        Ideal.mul_mem_right _ _ hs₀_in, Ideal.mul_mem_left _ _ hs₁_in⟩

  
  have hAssemble : ∀ (D₀ D₁ : Type u) [CommRing D₀] [CommRing D₁]
      [IsDomain D₀] [IsIntegrallyClosed D₀] [IsDomain D₁] [IsIntegrallyClosed D₁]
      (π₀ : A'₁ →+* D₀) (_ : Function.Surjective π₀)
      (π₁ : A'₁ →+* D₁) (_ : Function.Surjective π₁),
      Ideal.comap (π₀.comp φ₁) ⊥ ≠ p_z →
      Ideal.comap (π₁.comp φ₁) ⊥ ≠ p_z →
      Function.Injective (RingHom.prod π₀ π₁) →
      ∀ (ev₀ : D₀ →+* Ω) (ev₁ : D₁ →+* Ω),
        RingHom.ker ev₀ = Ideal.map π₀ u₁ →
        (Ideal.map π₀ u₁).IsMaximal →
        RingHom.ker ev₁ = Ideal.map π₁ u₁ →
        (Ideal.map π₁ u₁).IsMaximal →
        ev₀.comp π₀ = ev₁.comp π₁ →
        RingHom.ker (ev₀.comp π₀) = u₁ →
        (∀ d : Ω, ev₀ (π₀ (φ₁ (c_B d))) = d) →
        (∀ (d₀ : D₀) (d₁ : D₁), ev₀ d₀ = ev₁ d₁ ↔ ∃ a' : A'₁, π₀ a' = d₀ ∧ π₁ a' = d₁) →
        ∃ (α₀ α₁ : Fin (c + 1))
          (p₀ : PrimeSpectrum (B_tilde α₀))
          (p₁ : PrimeSpectrum (B_tilde α₁))
          (ψ_br₀ : B_tilde α₀ →+* D₀)
          (ψ_br₁ : B_tilde α₁ →+* D₁),
          p₀.asIdeal.IsMaximal ∧
          p₁.asIdeal.IsMaximal ∧
          Ideal.comap (ι α₀) p₀.asIdeal = p_z ∧
          Ideal.comap (ι α₁) p₁.asIdeal = p_z ∧
          Ideal.comap ψ_br₀ (Ideal.map π₀ u₁) = p₀.asIdeal ∧
          Ideal.comap ψ_br₁ (Ideal.map π₁ u₁) = p₁.asIdeal ∧
          ψ_br₀.comp (ι α₀) = π₀.comp φ₁ ∧
          ψ_br₁.comp (ι α₁) = π₁.comp φ₁ ∧
          Function.Injective ψ_br₀ ∧
          Function.Injective ψ_br₁ ∧
          ψ_br₀.FiniteType ∧
          ψ_br₁.FiniteType ∧
          @Module.Flat (B_tilde α₀) D₀ _ _ ψ_br₀.toAlgebra.toModule ∧
          @Algebra.FormallyUnramified (B_tilde α₀) D₀ _ _ ψ_br₀.toAlgebra ∧
          @Module.Flat (B_tilde α₁) D₁ _ _ ψ_br₁.toAlgebra.toModule ∧
          @Algebra.FormallyUnramified (B_tilde α₁) D₁ _ _ ψ_br₁.toAlgebra ∧
          (⟨α₀, p₀⟩ : Σ α : Fin (c + 1), PrimeSpectrum (B_tilde α)) ≠ ⟨α₁, p₁⟩ ∧
          (∀ (α : Fin (c + 1)) (q_P : PrimeSpectrum (B_tilde α)),
            Ideal.comap (ι α) q_P.asIdeal = p_z →
            (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde β)) = ⟨α₀, p₀⟩ ∨
              (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde β)) = ⟨α₁, p₁⟩) ∧
          (∀ (s_tilde : ∀ α : Fin (c + 1), B_tilde α) (c_val : Ω),
            s_tilde α₀ - ι α₀ (c_B c_val) ∈ p₀.asIdeal →
            s_tilde α₁ - ι α₁ (c_B c_val) ∈ p₁.asIdeal →
            ∃ b : B₁, ∀ α : Fin (c + 1), ι α b = s_tilde α) := by
    intro D₀ D₁ _ _ _ _ _ _ π₀ hSurj₀ π₁ hSurj₁ hNe₀ hNe₁ hInj_right
      ev₀ ev₁ hker_ev₀ hm₀ hker_ev₁ hm₁ hev_eq_π hker_ev_u₁ hev_c hCRT_pair
    obtain ⟨hBranchLift, hs_clear, hNotBij_ι⟩ := hStep2
    obtain ⟨α₀, ψ_br₀, hDom_α₀, hComp₀⟩ := hBranchLift D₀ (π₀.comp φ₁) hNe₀
    obtain ⟨α₁, ψ_br₁, hDom_α₁, hComp₁⟩ := hBranchLift D₁ (π₁.comp φ₁) hNe₁
    let ι_all : B₁ →+* (∀ α : Fin (c + 1), B_tilde α) := RingHom.pi ι
    let f_left : (∀ α : Fin (c + 1), B_tilde α) →+* D₀ × D₁ :=
      RingHom.prod (ψ_br₀.comp (Pi.evalRingHom B_tilde α₀)) (ψ_br₁.comp (Pi.evalRingHom B_tilde α₁))
    let f_right : A'₁ →+* D₀ × D₁ := RingHom.prod π₀ π₁
    let ev_left : D₀ × D₁ →+* Ω := ev₀.comp (RingHom.fst D₀ D₁)
    let ev_right : D₀ × D₁ →+* Ω := ev₁.comp (RingHom.snd D₀ D₁)
    have hInj_ι : Function.Injective ι_all := fun b₁ b₂ h =>
      hProdInj b₁ b₂ fun α => congrFun h α
    have hs_reg_all : ∀ y : (∀ α : Fin (c + 1), B_tilde α), ι_all s * y = 0 → y = 0 := by
      intro y hy
      funext α
      exact hs_reg_tilde α (y α) (congrFun hy α)
    have hComm_B : f_left.comp ι_all = f_right.comp φ₁ := by
      ext b <;>
      · simp only [f_left, f_right, ι_all, RingHom.comp_apply, RingHom.prod_apply,
          Pi.evalRingHom_apply, RingHom.pi_apply]
        first
        | exact DFunLike.congr_fun hComp₀ b
        | exact DFunLike.congr_fun hComp₁ b
    have hCRT_prod : ∀ z : D₀ × D₁, ev_left z = ev_right z ↔ ∃ a' : A'₁, f_right a' = z := by
      rintro ⟨d₀, d₁⟩
      rw [show ev_left (d₀, d₁) = ev₀ d₀ from rfl, show ev_right (d₀, d₁) = ev₁ d₁ from rfl,
        hCRT_pair d₀ d₁]
      exact ⟨fun ⟨a', h₀, h₁⟩ => ⟨a', Prod.ext h₀ h₁⟩,
        fun ⟨a', h⟩ => ⟨a', congrArg Prod.fst h, congrArg Prod.snd h⟩⟩
    have hev₁_c : ∀ d : Ω, ev₁ (π₁ (φ₁ (c_B d))) = d := by
      intro d
      have h := DFunLike.congr_fun hev_eq_π (φ₁ (c_B d))
      exact h.symm.trans (hev_c d)
    have hEv_const : ∀ d : Ω,
        ev_left (f_right (φ₁ (c_B d))) = d ∧ ev_right (f_right (φ₁ (c_B d))) = d :=
      fun d => ⟨hev_c d, hev₁_c d⟩
    obtain ⟨⟨Φ, hΦ_tmul, hBij_Φ⟩, hDesc⟩ := hStep3
      (∀ α : Fin (c + 1), B_tilde α) (D₀ × D₁) ι_all f_left f_right ev_left ev_right
      hInj_ι hNotBij_ι hs_reg_all hs_clear hInj_right hComm_B hCRT_prod hEv_const
    obtain ⟨hInj₀, hInj₁, hFT₀, hFT₁, hFlat₀, hUnram₀, hFlat₁, hUnram₁⟩ := hStep4
      D₀ D₁ π₀ hSurj₀ π₁ hSurj₁ α₀ α₁ hDom_α₀ hDom_α₁ ψ_br₀ ψ_br₁ hComp₀ hComp₁ Φ
      (fun y => by rw [hΦ_tmul, map_one, mul_one]; rfl) hBij_Φ
    let ev_B : B₁ →+* Ω := (ev₀.comp π₀).comp φ₁
    have hker_evB : RingHom.ker ev_B = p_z := by
      rw [RingHom.ker_eq_comap_bot, ← Ideal.comap_comap, ← RingHom.ker_eq_comap_bot,
        hker_ev_u₁, hComap_u₁]
    obtain ⟨hPrimeEval, hTwoSep⟩ := hStep5 ev_B hker_evB hev_c
    haveI : (Ideal.map π₀ u₁).IsPrime := hm₀.isPrime
    haveI : (Ideal.map π₁ u₁).IsPrime := hm₁.isPrime
    let p₀ : PrimeSpectrum (B_tilde α₀) := ⟨Ideal.comap ψ_br₀ (Ideal.map π₀ u₁), Ideal.comap_isPrime _ _⟩
    let p₁ : PrimeSpectrum (B_tilde α₁) := ⟨Ideal.comap ψ_br₁ (Ideal.map π₁ u₁), Ideal.comap_isPrime _ _⟩
    have hp₀_ker : p₀.asIdeal = RingHom.ker (ev₀.comp ψ_br₀) := by
      change Ideal.comap ψ_br₀ (Ideal.map π₀ u₁) = Ideal.comap ψ_br₀ (RingHom.ker ev₀)
      rw [hker_ev₀]
    have hp₁_ker : p₁.asIdeal = RingHom.ker (ev₁.comp ψ_br₁) := by
      change Ideal.comap ψ_br₁ (Ideal.map π₁ u₁) = Ideal.comap ψ_br₁ (RingHom.ker ev₁)
      rw [hker_ev₁]
    have hComap_ι₀ : Ideal.comap (ι α₀) p₀.asIdeal = p_z := by
      rw [hp₀_ker, RingHom.ker_eq_comap_bot, Ideal.comap_comap, RingHom.comp_assoc,
        hComp₀, ← RingHom.comp_assoc, ← RingHom.ker_eq_comap_bot]
      exact hker_evB
    have hComap_ι₁ : Ideal.comap (ι α₁) p₁.asIdeal = p_z := by
      rw [hp₁_ker, RingHom.ker_eq_comap_bot, Ideal.comap_comap, RingHom.comp_assoc,
        hComp₁, ← RingHom.comp_assoc, ← hev_eq_π, ← RingHom.ker_eq_comap_bot]
      exact hker_evB
    have hp₀_max : p₀.asIdeal.IsMaximal := (hPrimeEval α₀ p₀ hComap_ι₀).1
    have hp₁_max : p₁.asIdeal.IsMaximal := (hPrimeEval α₁ p₁ hComap_ι₁).1
    letI : Algebra B₁ (∀ α : Fin (c + 1), B_tilde α) := ι_all.toAlgebra
    letI : Algebra B₁ A'₁ := φ₁.toAlgebra
    have hNePairGen : ∀ (β₀ β₁ : Fin (c + 1))
        (q₀ : PrimeSpectrum (B_tilde β₀)) (q₁ : PrimeSpectrum (B_tilde β₁))
        (g₀ : B_tilde β₀ →+* D₀) (g₁ : B_tilde β₁ →+* D₁),
        q₀.asIdeal = RingHom.ker (ev₀.comp g₀) →
        q₁.asIdeal = RingHom.ker (ev₁.comp g₁) →
        g₀.comp (ι β₀) = π₀.comp φ₁ →
        g₁.comp (ι β₁) = π₁.comp φ₁ →
        (∀ (y : ∀ α : Fin (c + 1), B_tilde α) (a' : A'₁),
          Φ (y ⊗ₜ[B₁] a') = (g₀ (y β₀) * π₀ a', g₁ (y β₁) * π₁ a')) →
        (⟨β₀, q₀⟩ : Σ α : Fin (c + 1), PrimeSpectrum (B_tilde α)) ≠ ⟨β₁, q₁⟩ := by
      intro β₀ β₁ q₀ q₁ g₀ g₁ hq₀ hq₁ hg₀ hg₁ hΦ_gen hEq
      obtain ⟨rfl, hq_heq⟩ := Sigma.mk.inj_iff.mp hEq
      cases eq_of_heq hq_heq
      have hev_y : ∀ y : (∀ α : Fin (c + 1), B_tilde α), ev₀ (g₀ (y β₀)) = ev₁ (g₁ (y β₀)) := by
        intro y
        let d : Ω := ev₀ (g₀ (y β₀))
        have hmem₀ : y β₀ - ι β₀ (c_B d) ∈ q₀.asIdeal := by
          rw [hq₀, RingHom.mem_ker, RingHom.comp_apply, map_sub, map_sub]
          have hc₀ : ev₀ (g₀ (ι β₀ (c_B d))) = d := by
            have h := DFunLike.congr_fun hg₀ (c_B d)
            simp only [RingHom.comp_apply] at h
            rw [h]
            exact hev_c d
          rw [hc₀]
          exact sub_self d
        rw [hq₁, RingHom.mem_ker, RingHom.comp_apply, map_sub, map_sub] at hmem₀
        have hc₁ : ev₁ (g₁ (ι β₀ (c_B d))) = d := by
          have h := DFunLike.congr_fun hg₁ (c_B d)
          simp only [RingHom.comp_apply] at h
          rw [h]
          exact hev₁_c d
        rw [hc₁] at hmem₀
        exact (sub_eq_zero.mp hmem₀).symm
      have hev_all : ∀ w : TensorProduct B₁ (∀ α : Fin (c + 1), B_tilde α) A'₁,
          ev₀ (Φ w).1 = ev₁ (Φ w).2 := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul y a' =>
