      apply PrimeSpectrum.ext
      ext a
      simp only [x₀_K, Ideal.mem_bot]
      refine ⟨fun ha => ?_, fun h => h.symm ▸ x.asIdeal.zero_mem⟩
      by_contra ha_ne
      exact x.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ ha (Ne.isUnit ha_ne))

    have hSecEach : ∀ ℓ : Fin r,
        ∃ (R_ℓ : CommRingCat.{u}) (f_ℓ : AlgebraicGeometry.Spec R_ℓ ⟶ E₀)
          (q_ℓ : CommRingCat.of B₀ ⟶ R_ℓ) (h_ℓ : R_ℓ ⟶ CommRingCat.of K_bar)
          (j_ℓ : J) (h'_ℓ : R_ℓ ⟶ R_diag.obj j_ℓ),
          AlgebraicGeometry.Spec.map q_ℓ = f_ℓ ≫ p₀ ∧
          AlgebraicGeometry.Spec.map h_ℓ ≫ f_ℓ = ξ ℓ ≫ fst_gen ∧
          q_ℓ ≫ h'_ℓ = α_B₀.app j_ℓ ∧
          h_ℓ = h'_ℓ ≫ ι_colim.app j_ℓ := by
      intro ℓ
      let e_ℓ : ↥E₀ := (ξ ℓ ≫ fst_gen).base x₀_K
      obtain ⟨R_ℓ, f_ℓ, hf_ℓ_open, he_ℓ_mem, _⟩ :=
        @AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset E₀ e_ℓ ⊤ trivial
      have _ : AlgebraicGeometry.IsOpenImmersion f_ℓ := hf_ℓ_open
      have hRange_ℓ : Set.range (ξ ℓ ≫ fst_gen).base ⊆ Set.range f_ℓ.base := by
        rintro _ ⟨x, rfl⟩
        rw [hx₀_uniq x]
        exact he_ℓ_mem
      let φ_ℓ := AlgebraicGeometry.IsOpenImmersion.lift f_ℓ (ξ ℓ ≫ fst_gen) hRange_ℓ
      let h_ℓ : R_ℓ ⟶ CommRingCat.of K_bar := AlgebraicGeometry.Spec.preimage φ_ℓ
      have hh_ℓ_spec : AlgebraicGeometry.Spec.map h_ℓ ≫ f_ℓ = ξ ℓ ≫ fst_gen := by
        rw [AlgebraicGeometry.Spec.map_preimage]
        exact AlgebraicGeometry.IsOpenImmersion.lift_fac f_ℓ (ξ ℓ ≫ fst_gen) hRange_ℓ
      let q_ℓ : CommRingCat.of B₀ ⟶ R_ℓ := AlgebraicGeometry.Spec.preimage (f_ℓ ≫ p₀)
      have hq_ℓ_spec : AlgebraicGeometry.Spec.map q_ℓ = f_ℓ ≫ p₀ :=
        AlgebraicGeometry.Spec.map_preimage _
      have hFP_qℓ : q_ℓ.hom.FinitePresentation := by
        have hLFP_qℓ : AlgebraicGeometry.LocallyOfFinitePresentation
            (AlgebraicGeometry.Spec.map q_ℓ) := by
          rw [hq_ℓ_spec]
          infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hLFP_qℓ
      have hq_h_comm : ∀ j : J, q_ℓ ≫ h_ℓ = α_B₀.app j ≫ c_K.ι.app j := by
        intro j
        change q_ℓ ≫ h_ℓ = α_B₀.app j ≫ ι_colim.app j
        rw [hα_comm j]
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, hq_ℓ_spec, ← CategoryTheory.Category.assoc,
          hh_ℓ_spec, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← CategoryTheory.Category.assoc, hξ ℓ, CategoryTheory.Category.id_comp]
      obtain ⟨j_ℓ, h'_ℓ, hq_h', hh'_eq⟩ :=
        @RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          J _ _ (CommRingCat.of B₀) R_diag α_B₀ R_ℓ q_ℓ c_K hc_K _ hFP_qℓ h_ℓ hq_h_comm
      exact ⟨R_ℓ, f_ℓ, q_ℓ, h_ℓ, j_ℓ, h'_ℓ, hq_ℓ_spec, hh_ℓ_spec, hq_h', hh'_eq⟩

    choose R_ℓ f_ℓ q_ℓ h_ℓ j_ℓ h'_ℓ hq_ℓ_spec hh_ℓ_spec hq_h' hh'_eq using hSecEach

    have hMerge : ∀ k : ℕ, k ≤ r →
        ∃ (i_k : J) (_ : j₂ ⟶ i_k) (_ : j_pt ⟶ i_k),
          ∀ (ℓ : Fin r), ℓ.1 < k → Nonempty (j_ℓ ℓ ⟶ i_k) := by
      intro k
      induction k with
      | zero =>
        intro _
        refine ⟨CategoryTheory.IsFiltered.max j₂ j_pt,
          CategoryTheory.IsFiltered.leftToMax j₂ j_pt,
          CategoryTheory.IsFiltered.rightToMax j₂ j_pt, ?_⟩
        intro ℓ hlt
        exact False.elim (Nat.not_lt_zero ℓ.1 hlt)
      | succ k ih =>
        intro hk
        obtain ⟨i_prev, u₂_prev, upt_prev, hPrev⟩ := ih (Nat.le_of_succ_le hk)
        let ℓ_k : Fin r := ⟨k, hk⟩
        let i_next : J := CategoryTheory.IsFiltered.max i_prev (j_ℓ ℓ_k)
        let w_left : i_prev ⟶ i_next := CategoryTheory.IsFiltered.leftToMax i_prev (j_ℓ ℓ_k)
        let w_right : j_ℓ ℓ_k ⟶ i_next := CategoryTheory.IsFiltered.rightToMax i_prev (j_ℓ ℓ_k)
        refine ⟨i_next, u₂_prev ≫ w_left, upt_prev ≫ w_left, ?_⟩
        intro ℓ hlt
        rcases Nat.lt_succ_iff_lt_or_eq.mp hlt with hlt' | heq
        · obtain ⟨u_prev⟩ := hPrev ℓ hlt'
          exact ⟨u_prev ≫ w_left⟩
        · have hℓ_eq : ℓ = ℓ_k := Fin.ext heq
          subst hℓ_eq
          exact ⟨w_right⟩

    obtain ⟨i₄, u₂₄, u_pt₄, hAll_uℓ⟩ := hMerge r le_rfl
    let u_ℓ₄ : ∀ ℓ : Fin r, j_ℓ ℓ ⟶ i₄ := fun ℓ => Classical.choice (hAll_uℓ ℓ ℓ.2)

    let E₂ := CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂))
    let E₄ := CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))
    let p₄ := CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))
    let fst₄ := CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))
    let L₂ := CategoryTheory.Limits.pullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂))
    let L₄ := CategoryTheory.Limits.pullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))
    let snd_L₄ := CategoryTheory.Limits.pullback.snd f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))

    have hMap₂₄ : AlgebraicGeometry.Spec.map (R_diag.map u₂₄) ≫
        AlgebraicGeometry.Spec.map (α_B₀.app j₂) =
        AlgebraicGeometry.Spec.map (α_B₀.app i₄) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      have hnat := α_B₀.naturality u₂₄
      simp only [CategoryTheory.Functor.const_obj_obj,
        CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
      rw [← hnat]

    let ρ₂₄ : E₄ ⟶ E₂ :=
      CategoryTheory.Limits.pullback.lift fst₄
        (p₄ ≫ AlgebraicGeometry.Spec.map (R_diag.map u₂₄))
        (by rw [CategoryTheory.Category.assoc, hMap₂₄, CategoryTheory.Limits.pullback.condition])

    have hPb_E₂₄ : CategoryTheory.IsPullback ρ₂₄ p₄
        (CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)))
        (AlgebraicGeometry.Spec.map (R_diag.map u₂₄)) := by
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)))
      rw [CategoryTheory.Limits.pullback.lift_fst, hMap₂₄]
      exact CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))

    let π_L₂₄ : L₄ ⟶ L₂ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄)))
        (snd_L₄ ≫ AlgebraicGeometry.Spec.map (R_diag.map u₂₄))
        (by rw [CategoryTheory.Category.assoc, hMap₂₄, CategoryTheory.Limits.pullback.condition])

    have hPb_L₂₄ : CategoryTheory.IsPullback π_L₂₄ snd_L₄
        (CategoryTheory.Limits.pullback.snd f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)))
        (AlgebraicGeometry.Spec.map (R_diag.map u₂₄)) := by
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app j₂)))
      rw [CategoryTheory.Limits.pullback.lift_fst, hMap₂₄]
      exact CategoryTheory.IsPullback.of_hasPullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))

    
    have hEx_j₄ : ∃ (j₄ : L₄ ⟶ E₄),
        j₄ ≫ ρ₂₄ = π_L₂₄ ≫ j_open ∧ j₄ ≫ p₄ = snd_L₄ :=
      ⟨hPb_E₂₄.lift (π_L₂₄ ≫ j_open) snd_L₄
        (by rw [CategoryTheory.Category.assoc, hj₂_snd, CategoryTheory.Limits.pullback.lift_snd]),
       hPb_E₂₄.lift_fst _ _ _, hPb_E₂₄.lift_snd _ _ _⟩
    obtain ⟨j₄, hj₄_ρ, hj₄_snd⟩ := hEx_j₄

    have hPb_j₄ : CategoryTheory.IsPullback π_L₂₄ j₄ j_open ρ₂₄ := by
      refine CategoryTheory.IsPullback.of_bot ?_ hj₄_ρ.symm hPb_E₂₄
      rwa [hj₄_snd, hj₂_snd]

    have hj₄_open : AlgebraicGeometry.IsOpenImmersion j₄ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_j₄ hj₂_open

    let pt₄ : AlgebraicGeometry.Spec (R_diag.obj i₄) ⟶ L₄ :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map (g'_pt ≫ R_diag.map u_pt₄)) (𝟙 _)
        (by
          rw [CategoryTheory.Category.id_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CategoryTheory.Category.assoc, hg'_pt_comm]
          have hnat := α_B₀.naturality u_pt₄
          simp only [CategoryTheory.Functor.const_obj_obj,
            CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
          rw [← hnat])

    let ξ₄ : Fin r → (AlgebraicGeometry.Spec (R_diag.obj i₄) ⟶ E₄) := fun ℓ =>
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map (h'_ℓ ℓ ≫ R_diag.map (u_ℓ₄ ℓ)) ≫ f_ℓ ℓ) (𝟙 _)
        (by
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            ← hq_ℓ_spec ℓ, ← AlgebraicGeometry.Spec.map_comp,
            ← CategoryTheory.Category.assoc, hq_h' ℓ]
          have hnat := α_B₀.naturality (u_ℓ₄ ℓ)
          simp only [CategoryTheory.Functor.const_obj_obj,
            CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
          rw [← hnat])

    have hξ₄_snd : ∀ ℓ : Fin r, ξ₄ ℓ ≫ p₄ = 𝟙 _ :=
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

    refine ⟨i₄, j₄, pt₄, ξ₄, hj₄_open, hj₄_snd, ?_,
      CategoryTheory.Limits.pullback.lift_snd _ _ _, hξ₄_snd, ?_⟩
    · rintro _ ⟨x, rfl⟩
      have hc : ρ₂₄ ≫ CategoryTheory.Limits.pullback.fst p₀
            (AlgebraicGeometry.Spec.map (α_B₀.app j₂)) = fst₄ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      change fst₄.base (j₄.base x) ∈ U₀
      rw [← hc]
      change ((j₄ ≫ ρ₂₄) ≫ CategoryTheory.Limits.pullback.fst p₀
        (AlgebraicGeometry.Spec.map (α_B₀.app j₂))).base x ∈ U₀
      rw [hj₄_ρ]
      exact hj₂_sub ⟨π_L₂₄.base x, rfl⟩
    · intro π_gen hπ_fst hπ_snd y hy_not_W
      have hRange_j₄ : Set.range j₄.base = ρ₂₄.base ⁻¹' (Set.range j_open.base) := by
        ext z
        constructor
        · rintro ⟨x, rfl⟩
          change (j₄ ≫ ρ₂₄).base x ∈ Set.range j_open.base
          rw [hj₄_ρ]
          exact ⟨π_L₂₄.base x, rfl⟩
        · rintro ⟨w, hw⟩
          obtain ⟨x, _, hx⟩ :=
            AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_j₄ w z hw
          exact ⟨x, hx⟩
      have hπ₂_pre : (π_gen ≫ ρ₂₄).base ⁻¹' (Set.range j_open.base) = Set.range j_W.base := by
        refine hj₂_pre (π_gen ≫ ρ₂₄) ?_ ?_
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hπ_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, hπ_snd, CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp]
          have hnat := ι_colim.naturality u₂₄
          simp only [CategoryTheory.Functor.const_obj_obj,
            CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
          rw [hnat]
      have hy_not_jW : y ∈ (Set.range j_W.base)ᶜ := by
        rw [← hπ₂_pre]
        intro hy_in
        apply hy_not_W
        rw [hRange_j₄]
        exact hy_in
      obtain ⟨ℓ, z, rfl⟩ := Set.mem_iUnion.mp (hCompl hy_not_jW)
      have hξ_comm : ξ ℓ ≫ π_gen = AlgebraicGeometry.Spec.map (ι_colim.app i₄) ≫ ξ₄ ℓ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hπ_fst, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          have hnat := ι_colim.naturality (u_ℓ₄ ℓ)
          simp only [CategoryTheory.Functor.const_obj_obj,
            CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
          rw [hnat, ← hh'_eq ℓ, hh_ℓ_spec ℓ]
        · rw [CategoryTheory.Category.assoc, hπ_snd, ← CategoryTheory.Category.assoc,
            hξ ℓ, CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            hξ₄_snd ℓ, CategoryTheory.Category.comp_id]
      refine Set.mem_iUnion.mpr ⟨ℓ, (AlgebraicGeometry.Spec.map (ι_colim.app i₄)).base z, ?_⟩
      change (AlgebraicGeometry.Spec.map (ι_colim.app i₄) ≫ ξ₄ ℓ).base z = (ξ ℓ ≫ π_gen).base z
      rw [hξ_comm]

  obtain ⟨i₄, j₄, pt₄, ξ₄, hj₄_open, hj₄_snd, hj₄_sub, hpt₄_snd, hξ₄_snd, hCompl₄_gen⟩ := hStep3

  
  
  
  have hStep4 :
      ∃ (i₅ : J),
        ∀ (Ω : Type u) [Field Ω] (φ : (R_diag.obj i₅) →+* Ω)
          (A_Ω : Type u) [CommRing A_Ω]
          (α_Ω : Ω →+* A_Ω) (ψ_Ω : A₀ →+* A_Ω),
          CategoryTheory.IsPullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp (α_B₀.app i₅).hom))) →
          let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp (α_B₀.app i₅).hom))
          let E_Ω := CategoryTheory.Limits.pullback p₀ s₀
          let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s₀
          let fst_Ω := CategoryTheory.Limits.pullback.fst p₀ s₀
          ∃ (j_Ω : AlgebraicGeometry.Spec (CommRingCat.of A_Ω) ⟶ E_Ω)
            (pt_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
              AlgebraicGeometry.Spec (CommRingCat.of A_Ω))
            (ξ_Ω : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_Ω)),
            AlgebraicGeometry.IsOpenImmersion j_Ω ∧
            j_Ω ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω) ∧
            Set.range j_Ω.base ⊆ ((TopologicalSpace.Opens.map fst_Ω.base).obj U₀ : Set ↥E_Ω) ∧
            pt_Ω ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω) = 𝟙 _ ∧
            (∀ ℓ : Fin r, ξ_Ω ℓ ≫ p_Ω = 𝟙 _) ∧
            (Set.range j_Ω.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ_Ω ℓ).base := by
    obtain ⟨hc_Spec⟩ := hLimSpec
    let c_K := CategoryTheory.Limits.Cocone.mk (CommRingCat.of K_bar) ι_colim
    let S_diag : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} := R_diag.op ⋙ AlgebraicGeometry.Scheme.Spec
    let c_Spec : CategoryTheory.Limits.Cone S_diag :=
      AlgebraicGeometry.Scheme.Spec.mapCone c_K.op
    let s_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)
    let E_gen := CategoryTheory.Limits.pullback p₀ s_gen
    let p_gen := CategoryTheory.Limits.pullback.snd p₀ s_gen
    let fst_gen := CategoryTheory.Limits.pullback.fst p₀ s_gen
    let f_α₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)

    let E_diag : Jᵒᵖ ⥤ AlgebraicGeometry.Scheme.{u} :=
      { obj := fun i =>
          CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop))
        map := fun {i₁ i₂} f =>
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop)))
            (CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop)) ≫
              AlgebraicGeometry.Spec.map (R_diag.map f.unop))
            (by
              rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
              have hnat := α_B₀.naturality f.unop
              simp only [CategoryTheory.Functor.const_obj_obj,
                CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
              rw [← hnat, CategoryTheory.Limits.pullback.condition])
        map_id := by
          intro i
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
              (CategoryTheory.Category.id_comp _).symm
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
            change _ ≫ AlgebraicGeometry.Spec.map (R_diag.map (𝟙 i.unop)) = _
            rw [R_diag.map_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
        map_comp := by
          intro i₁ i₂ i₃ f g
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
            change _ ≫ AlgebraicGeometry.Spec.map (R_diag.map (g.unop ≫ f.unop)) = _
            rw [R_diag.map_comp, AlgebraicGeometry.Spec.map_comp] }

    let p_nat : E_diag ⟶ S_diag :=
      { app := fun i =>
          CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop))
        naturality := fun _ _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _ }

    let c_E : CategoryTheory.Limits.Cone E_diag :=
      { pt := E_gen
        π :=
          { app := fun i =>
              CategoryTheory.Limits.pullback.lift fst_gen
                (p_gen ≫ AlgebraicGeometry.Spec.map (ι_colim.app i.unop))
                (by
                  rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                    hα_comm i.unop]
                  exact CategoryTheory.Limits.pullback.condition)
            naturality := by
              intro i₁ i₂ f
              apply CategoryTheory.Limits.pullback.hom_ext
              · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
                  CategoryTheory.Category.id_comp, E_diag]
                rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
              · simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
                  CategoryTheory.Category.id_comp, E_diag]
                rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
                  ← AlgebraicGeometry.Spec.map_comp (R_diag.map f.unop) (ι_colim.app i₁.unop)]
                have hnat := ι_colim.naturality f.unop
                simp only [CategoryTheory.Functor.const_obj_obj,
                  CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.comp_id] at hnat
                rw [hnat] } }

    have hPb_E_cone : ∀ i : Jᵒᵖ,
        CategoryTheory.IsPullback (c_E.π.app i) p_gen (p_nat.app i) (c_Spec.π.app i) := by
      intro i
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop)))
      have h1 : c_E.π.app i ≫
          CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i.unop)) =
          fst_gen :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h2 : c_Spec.π.app i ≫ AlgebraicGeometry.Spec.map (α_B₀.app i.unop) = s_gen := by
        change AlgebraicGeometry.Spec.map (ι_colim.app i.unop) ≫
          AlgebraicGeometry.Spec.map (α_B₀.app i.unop) = s_gen
        rw [← AlgebraicGeometry.Spec.map_comp, hα_comm i.unop]
      rw [h1, h2]
      exact CategoryTheory.IsPullback.of_hasPullback p₀ s_gen

    have _ : CategoryTheory.IsConnected Jᵒᵖ := CategoryTheory.IsCofiltered.isConnected Jᵒᵖ
    have hExLimE : Nonempty (CategoryTheory.Limits.IsLimit c_E) :=
      ⟨CategoryTheory.Limits.isLimitOfIsPullbackOfIsConnected
        p_nat c_E c_Spec
        { hom := p_gen
          w := fun _ => (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm }
        hPb_E_cone hc_Spec⟩
    obtain ⟨hc_E⟩ := hExLimE

    have hAff_E_map : ∀ {i₁ i₂ : Jᵒᵖ} (f : i₁ ⟶ i₂), AlgebraicGeometry.IsAffineHom (E_diag.map f) := by
      intro i₁ i₂ f
      have hPb_f : CategoryTheory.IsPullback (E_diag.map f) (p_nat.app i₁) (p_nat.app i₂)
          (S_diag.map f) := by
        refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          (CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop)))
        have h1 : E_diag.map f ≫
            CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop)) =
            CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop)) :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h2 : S_diag.map f ≫ AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop) =
            AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop) := by
          change AlgebraicGeometry.Spec.map (R_diag.map f.unop) ≫
            AlgebraicGeometry.Spec.map (α_B₀.app i₂.unop) = _
          rw [← AlgebraicGeometry.Spec.map_comp]
          have hnat := α_B₀.naturality f.unop
          simp only [CategoryTheory.Functor.const_obj_obj,
            CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
          rw [← hnat]
        rw [h1, h2]
        exact CategoryTheory.IsPullback.of_hasPullback p₀
          (AlgebraicGeometry.Spec.map (α_B₀.app i₁.unop))
      have hAffS : AlgebraicGeometry.IsAffineHom (S_diag.map f) := by
        change AlgebraicGeometry.IsAffineHom (AlgebraicGeometry.Spec.map (R_diag.map f.unop))
        exact AlgebraicGeometry.isAffineHom_of_isAffine _
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_f.flip hAffS

    let E₄ := E_diag.obj (Opposite.op i₄)
    let p₄ := CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))
    let fst₄ := CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))
    let L₄ := CategoryTheory.Limits.pullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))
    let snd_L₄ := CategoryTheory.Limits.pullback.snd f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄))

    have hNoeth_E₄ : TopologicalSpace.NoetherianSpace ↥E₄ := by
      have _ : IsNoetherianRing (R_diag.obj i₄) := (hProps i₄).2.1
      have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (R_diag.obj i₄)) :=
        inferInstance
      have _ : CompactSpace ↥(AlgebraicGeometry.Spec (R_diag.obj i₄)) := inferInstance
      have _ : AlgebraicGeometry.IsProper p₄ := inferInstance
      have _ : AlgebraicGeometry.LocallyOfFinitePresentation p₄ := inferInstance
      have _ : AlgebraicGeometry.IsLocallyNoetherian E₄ :=
        AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p₄
      have _ : CompactSpace ↥E₄ :=
        AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p₄
      have _ : AlgebraicGeometry.IsNoetherian E₄ := AlgebraicGeometry.IsNoetherian.mk
      exact AlgebraicGeometry.IsNoetherian.noetherianSpace

    have _ : AlgebraicGeometry.IsProper p₄ := inferInstance
    have _ : AlgebraicGeometry.IsSeparated p₄ := inferInstance
    have _ : AlgebraicGeometry.IsOpenImmersion j₄ := hj₄_open

    have hClosed_ξ₄ : ∀ ℓ : Fin r, IsClosed (Set.range (ξ₄ ℓ).base) := by
      intro ℓ
      have hcomp_cl : AlgebraicGeometry.IsClosedImmersion (ξ₄ ℓ ≫ p₄) := by
        rw [hξ₄_snd ℓ]
        infer_instance
      have hcl : AlgebraicGeometry.IsClosedImmersion (ξ₄ ℓ) :=
        @AlgebraicGeometry.IsClosedImmersion.of_comp _ _ _ (ξ₄ ℓ) p₄ hcomp_cl inferInstance
      exact hcl.isClosedEmbedding.isClosed_range

    let F₄ : Set ↥E₄ := ⋃ ℓ : Fin r, Set.range (ξ₄ ℓ).base
    have hClosed_F₄ : IsClosed F₄ := isClosed_iUnion_of_finite hClosed_ξ₄
    let O_sec : E₄.Opens := ⟨F₄ᶜ, hClosed_F₄.isOpen_compl⟩
    let W₄ : E₄.Opens := j₄.opensRange

    have hEqW₄_gen :
        (TopologicalSpace.Opens.map (c_E.π.app (Opposite.op i₄)).base).obj (W₄ ⊔ O_sec) =
          (TopologicalSpace.Opens.map (c_E.π.app (Opposite.op i₄)).base).obj W₄ := by
      apply TopologicalSpace.Opens.ext
      ext (y : ↥E_gen)
      change ((c_E.π.app (Opposite.op i₄)).base y ∈ Set.range j₄.base ∨
          (c_E.π.app (Opposite.op i₄)).base y ∈ F₄ᶜ) ↔
        (c_E.π.app (Opposite.op i₄)).base y ∈ Set.range j₄.base
      refine ⟨?_, Or.inl⟩
      rintro (h_in | h_not_F)
      · exact h_in
      · by_contra h_not_W
        exact h_not_F (hCompl₄_gen (c_E.π.app (Opposite.op i₄))
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) h_not_W)

    obtain ⟨i₅_op, f₄₅, hEqW₅⟩ :=
      @AlgebraicGeometry.exists_map_preimage_eq_map_preimage Jᵒᵖ _ E_diag c_E hc_E _
        (@hAff_E_map) (Opposite.op i₄) (W₄ ⊔ O_sec) W₄
        (@TopologicalSpace.NoetherianSpace.isCompact _ _ hNoeth_E₄ _)
        (@TopologicalSpace.NoetherianSpace.isCompact _ _ hNoeth_E₄ _)
        hEqW₄_gen

    let i₅ : J := i₅_op.unop
    let g₄₅ : i₄ ⟶ i₅ := f₄₅.unop
    let ρ₄₅ : E_diag.obj i₅_op ⟶ E₄ := E_diag.map f₄₅

    have hCompl₅ : ∀ z : ↥(E_diag.obj i₅_op),
        ρ₄₅.base z ∉ Set.range j₄.base → ρ₄₅.base z ∈ F₄ := by
      intro z hz_not
      by_contra hz_not_F
      have hz_in : z ∈ ((TopologicalSpace.Opens.map ρ₄₅.base).obj (W₄ ⊔ O_sec) :
          Set ↥(E_diag.obj i₅_op)) := Or.inr hz_not_F
      rw [hEqW₅] at hz_in
      exact hz_not hz_in

    refine ⟨i₅, ?_⟩
    intro Ω _ φ A_Ω _ α_Ω ψ_Ω hPb_Ω
    dsimp only
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp (α_B₀.app i₅).hom))
    let E_Ω := CategoryTheory.Limits.pullback p₀ s₀
    let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s₀
    let fst_Ω := CategoryTheory.Limits.pullback.fst p₀ s₀
    let s₅ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (R_diag.obj i₅) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
    let s₄ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (R_diag.obj i₄) :=
      s₅ ≫ AlgebraicGeometry.Spec.map (R_diag.map g₄₅)

    have hs₅_eq : s₅ ≫ AlgebraicGeometry.Spec.map (α_B₀.app i₅) = s₀ := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
        AlgebraicGeometry.Spec.map (α_B₀.app i₅) = _
      rw [← AlgebraicGeometry.Spec.map_comp]
      rfl

    have hs₄_eq : s₄ ≫ AlgebraicGeometry.Spec.map (α_B₀.app i₄) = s₀ := by
      change s₅ ≫ AlgebraicGeometry.Spec.map (R_diag.map g₄₅) ≫
        AlgebraicGeometry.Spec.map (α_B₀.app i₄) = s₀
      rw [← AlgebraicGeometry.Spec.map_comp]
      have hnat := α_B₀.naturality g₄₅
      simp only [CategoryTheory.Functor.const_obj_obj,
        CategoryTheory.Functor.const_obj_map, CategoryTheory.Category.id_comp] at hnat
      rw [← hnat, hs₅_eq]

    let π_E5 : E_Ω ⟶ E_diag.obj i₅_op :=
      CategoryTheory.Limits.pullback.lift fst_Ω (p_Ω ≫ s₅)
        (by rw [CategoryTheory.Category.assoc, hs₅_eq, CategoryTheory.Limits.pullback.condition])

    let π_E4 : E_Ω ⟶ E₄ := π_E5 ≫ ρ₄₅

    have hπ_E4_fst : π_E4 ≫ fst₄ = fst_Ω := by
      change (π_E5 ≫ E_diag.map f₄₅) ≫ fst₄ = fst_Ω
      rw [CategoryTheory.Category.assoc]
      have hc : E_diag.map f₄₅ ≫ fst₄ =
          CategoryTheory.Limits.pullback.fst p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₅)) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hc]
      exact CategoryTheory.Limits.pullback.lift_fst _ _ _

    have hπ_E4_snd : π_E4 ≫ p₄ = p_Ω ≫ s₄ := by
      change (π_E5 ≫ E_diag.map f₄₅) ≫ p₄ = p_Ω ≫ s₅ ≫ AlgebraicGeometry.Spec.map (R_diag.map g₄₅)
      rw [CategoryTheory.Category.assoc]
      have hc : E_diag.map f₄₅ ≫ p₄ =
          p_nat.app i₅_op ≫ AlgebraicGeometry.Spec.map (R_diag.map g₄₅) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      rw [hc, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc]

    have hPb_E4 : CategoryTheory.IsPullback π_E4 p_Ω p₄ s₄ := by
      refine CategoryTheory.IsPullback.of_right ?_ hπ_E4_snd
        (CategoryTheory.IsPullback.of_hasPullback p₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄)))
      rw [hπ_E4_fst, hs₄_eq]
      exact CategoryTheory.IsPullback.of_hasPullback p₀ s₀

    let π_L4 : AlgebraicGeometry.Spec (CommRingCat.of A_Ω) ⟶ L₄ :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω) ≫ s₄)
        (by rw [CategoryTheory.Category.assoc, hs₄_eq, hPb_Ω.w])

    have hPb_L4 : CategoryTheory.IsPullback π_L4
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω)) snd_L₄ s₄ := by
      refine CategoryTheory.IsPullback.of_right ?_ (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback f_α₀ (AlgebraicGeometry.Spec.map (α_B₀.app i₄)))
      rw [CategoryTheory.Limits.pullback.lift_fst, hs₄_eq]
      exact hPb_Ω

    
    have hEx_jΩ : ∃ (j_Ω : AlgebraicGeometry.Spec (CommRingCat.of A_Ω) ⟶ E_Ω),
        j_Ω ≫ π_E4 = π_L4 ≫ j₄ ∧ j_Ω ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω) :=
      ⟨hPb_E4.lift (π_L4 ≫ j₄) (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω))
        (by rw [CategoryTheory.Category.assoc, hj₄_snd, CategoryTheory.Limits.pullback.lift_snd]),
       hPb_E4.lift_fst _ _ _, hPb_E4.lift_snd _ _ _⟩
    obtain ⟨j_Ω, hj_Ω_π, hj_Ω_p⟩ := hEx_jΩ

    have hPb_jΩ : CategoryTheory.IsPullback π_L4 j_Ω j₄ π_E4 := by
      refine CategoryTheory.IsPullback.of_bot ?_ hj_Ω_π.symm hPb_E4
      rwa [hj_Ω_p, hj₄_snd]

    have hj_Ω_open : AlgebraicGeometry.IsOpenImmersion j_Ω :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_jΩ hj₄_open

    have hj_Ω_sub : Set.range j_Ω.base ⊆
        ((TopologicalSpace.Opens.map fst_Ω.base).obj U₀ : Set ↥E_Ω) := by
      rintro _ ⟨x, rfl⟩
      change (j_Ω ≫ fst_Ω).base x ∈ U₀
      rw [← hπ_E4_fst, ← CategoryTheory.Category.assoc, hj_Ω_π]
      exact hj₄_sub ⟨π_L4.base x, rfl⟩

    have hEx_ptΩ : ∃ (pt_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_Ω)),
        pt_Ω ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_Ω) = 𝟙 _ :=
      ⟨hPb_L4.lift (s₄ ≫ pt₄) (𝟙 _)
        (by rw [CategoryTheory.Category.assoc, hpt₄_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]),
       hPb_L4.lift_snd _ _ _⟩
    obtain ⟨pt_Ω, hpt_Ω_p⟩ := hEx_ptΩ

    have hEx_ξΩ : ∀ ℓ : Fin r,
        ∃ (ξ_ℓ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_Ω),
          ξ_ℓ ≫ π_E4 = s₄ ≫ ξ₄ ℓ ∧ ξ_ℓ ≫ p_Ω = 𝟙 _ := fun ℓ =>
      ⟨hPb_E4.lift (s₄ ≫ ξ₄ ℓ) (𝟙 _)
        (by rw [CategoryTheory.Category.assoc, hξ₄_snd ℓ,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]),
       hPb_E4.lift_fst _ _ _, hPb_E4.lift_snd _ _ _⟩
    choose ξ_Ω hξ_Ω_π hξ_Ω_p using hEx_ξΩ

    have hPb_ξΩ : ∀ ℓ : Fin r, CategoryTheory.IsPullback s₄ (ξ_Ω ℓ) (ξ₄ ℓ) π_E4 := by
      intro ℓ
      refine CategoryTheory.IsPullback.of_bot ?_ (hξ_Ω_π ℓ).symm hPb_E4
      rw [hξ_Ω_p ℓ, hξ₄_snd ℓ]
      exact CategoryTheory.IsPullback.of_vert_isIso
        ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩

    refine ⟨j_Ω, pt_Ω, ξ_Ω, hj_Ω_open, hj_Ω_p, hj_Ω_sub, hpt_Ω_p, hξ_Ω_p, ?_⟩
    intro y hy_not_jΩ
    have hy_not_j₄ : ρ₄₅.base (π_E5.base y) ∉ Set.range j₄.base := by
      rintro ⟨w, hw⟩
      have hw' : j₄.base w = π_E4.base y := hw
      obtain ⟨x, _, hx⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_jΩ w y hw'
      exact hy_not_jΩ ⟨x, hx⟩
    obtain ⟨ℓ, u, hu⟩ := Set.mem_iUnion.mp (hCompl₅ (π_E5.base y) hy_not_j₄)
    have hu' : (ξ₄ ℓ).base u = π_E4.base y := hu
    obtain ⟨t, _, ht⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback (hPb_ξΩ ℓ) u y hu'
    exact Set.mem_iUnion.mpr ⟨ℓ, t, ht⟩

  obtain ⟨i₅, hFib₅⟩ := hStep4
  exact ⟨↥(R_diag.obj i₅), inferInstance, (hProps i₅).1, (α_B₀.app i₅).hom, (ι_colim.app i₅).hom,
    (hProps i₅).2.2.1, congrArg CommRingCat.Hom.hom (hα_comm i₅), (hProps i₅).2.2.2, hFib₅⟩

theorem weil_algClosed_dense_away_chart_integral_and_sqZero_not_p1 : (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (E : AlgebraicGeometry.Scheme.{u})
        (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.IsProper p_E]
        [AlgebraicGeometry.LocallyOfFiniteType p_E]
        (Q : Type u) [CommRing Q] [IsDomain Q]
        (α_Q : Ω →+* Q) (g : Q)
        (α_W : Ω →+* Localization.Away g)
        (j_W : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶ E)
        (pt_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)))
        (r : ℕ)
        (ξ : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E)),
      AlgebraicGeometry.IsReduced E →
      (∀ (D : Type u) [CommRing D] [Algebra Ω D]
          (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ E),
        AlgebraicGeometry.IsOpenImmersion j_D →
        j_D ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
        ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
          let L := Localization.AtPrime q.asIdeal
          let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
          Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
            (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
             Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
             ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)) →
      (∀ c : Ω, α_W c = Localization.mk (α_Q c) 1) →
      AlgebraicGeometry.IsOpenImmersion j_W →
      j_W ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) →
      pt_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) = 𝟙 _ →
      (∀ ℓ : Fin r, ξ ℓ ≫ p_E = 𝟙 _) →
      (Set.range j_W.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ ℓ).base →
      AlgebraicGeometry.IsIntegral E ∧
      ∃ (U : E.Opens) (_hAff : AlgebraicGeometry.IsAffineOpen U) (_hNe : Nonempty ↥U)
        (α_U : Ω →+* ↑(E.presheaf.obj (Opposite.op U)))
        (e_Q : FractionRing ↑(E.presheaf.obj (Opposite.op U)) ≃+* FractionRing Q),
        U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) = U.ι ≫ p_E ∧
        ∀ c : Ω, e_Q (algebraMap _ _ (α_U c)) = Localization.mk (α_Q c) 1) ∧
    (∀ (Ω : Type u) [Field Ω]
        (E : AlgebraicGeometry.Scheme.{u})
        (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        (D : Type u) [CommRing D]
        (α_D : Ω →+* D)
        (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ E)
        (Θ : D →+* TrivSqZeroExt Ω (Ω × Ω)),
      AlgebraicGeometry.IsOpenImmersion j_D →
      j_D ≫ p_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_D) →
      Θ.comp α_D = TrivSqZeroExt.inlHom Ω (Ω × Ω) →
      Function.Surjective Θ →
      ¬ ∃ isoP1 : E ≅ (weilProjectiveSpaceOver Ω 1).left,
          p_E = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) :=
by
  constructor
  · intro Ω _ _ E p_E _ _ Q _ _ α_Q g α_W j_W pt_W r ξ hRed hArtin hα_W hj_W_open hj_W_p _hpt_W hξ hCompl
    have : AlgebraicGeometry.IsReduced E := hRed
    have : AlgebraicGeometry.IsOpenImmersion j_W := hj_W_open
    
    let ev_W : Localization.Away g →+* Ω := (AlgebraicGeometry.Spec.preimage pt_W).hom
    have h10_ne : (1 : Localization.Away g) ≠ 0 := by
      intro h10
      have hev : (1 : Ω) = 0 := by
        have h := congrArg ev_W h10
        rwa [map_one, map_zero] at h
      exact one_ne_zero hev
    have : Nontrivial (Localization.Away g) := ⟨⟨1, 0, h10_ne⟩⟩
    have hg : g ≠ 0 := by
      intro hg0
      subst hg0
      have hu : IsUnit (algebraMap Q (Localization.Away (0 : Q)) 0) :=
        IsLocalization.Away.algebraMap_isUnit (0 : Q)
      rw [map_zero] at hu
      exact not_isUnit_zero hu
    
    have hLe_nzd : Submonoid.powers g ≤ nonZeroDivisors Q := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hg)
    have : IsDomain (Localization.Away g) :=
      IsLocalization.isDomain_localization hLe_nzd
    have hIrredSpace_W : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))) :=
      inferInstance
    have hIrred_W : IsIrreducible (Set.range j_W.base) := by
      rw [← Set.image_univ]
      exact hIrredSpace_W.isIrreducible_univ.image j_W.base j_W.base.hom.continuous.continuousOn
    
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, inferInstance⟩
    have hUnique_pt₀ : ∀ z : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), z = pt₀ := by
      intro z
      apply PrimeSpectrum.ext
      apply Ideal.ext
      intro c
      simp only [pt₀, Ideal.mem_bot]
      constructor
