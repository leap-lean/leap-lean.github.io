      have _ : AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ₁ i_k) := (hℰ₁ i_k).2.1
      let f₁_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁_k)
      let X_k := CategoryTheory.Limits.pullback (p_ℰ₁ i_k) f₁_k
      let p_k := CategoryTheory.Limits.pullback.snd (p_ℰ₁ i_k) f₁_k
