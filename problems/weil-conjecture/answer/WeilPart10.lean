    induction k with
    | zero =>
      intro _
      refine ⟨B₂, instCR₂, instDom₂, RingHom.id B₂, ι₂,
        RingHom.FiniteType.id B₂, RingHom.comp_id ι₂, hInj₂, ?_⟩
      intro i hi
      exact False.elim (Nat.not_lt_zero i.1 hi)
    | succ k ih =>
      intro hk
      obtain ⟨B_k, instCR_k, instDom_k, ψ₂_k, ι_k, hFT_k, hComp_k, hInj_k, hPrev_k⟩ :=
        ih (Nat.le_of_succ_le hk)
