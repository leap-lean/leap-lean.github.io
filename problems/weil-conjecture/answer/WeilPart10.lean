theorem weil_algClosed_nodal_chart_shrunk_affine_etale_roof (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (V : C.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
    (p_z : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op V)))
    (hz_nsm : ¬∃ V_sm : C.Opens,
