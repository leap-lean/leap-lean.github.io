    have hAnn_I : ∀ (m : A), m ∈ p_P.asIdeal → ∀ (v : N), m • v = 0 := by
      intro m hm v
      obtain ⟨⟨y, hy⟩, rfl⟩ := Submodule.Quotient.mk_surjective S_sq v
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, hmem_Ssq]
