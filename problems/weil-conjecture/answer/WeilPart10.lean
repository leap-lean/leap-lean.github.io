    obtain ⟨L_P, hLP_tP⟩ := hEx_LP
    obtain ⟨r₀, hr₀_eq⟩ := hGenRP (KaehlerDifferential.D Ω R_P (algebraMap A R_P t_P))
    have hr₀_not_max : r₀ ∉ IsLocalRing.maximalIdeal R_P := by
