    let f_end : Module.End Q (Fin 2 → Q) := Θ.symm.toLinearMap.comp (Submodule.mkQ N_Q)
    have hf_surj : Function.Surjective f_end :=
      Θ.symm.surjective.comp (Submodule.mkQ_surjective N_Q)
    have hf_inj : Function.Injective f_end :=
      Module.End.injective_of_surjective_fin hf_surj
    have hf_vec : f_end ![q_Q x₁, q_Q x₀] = 0 := by
      change Θ.symm (Submodule.mkQ N_Q ![q_Q x₁, q_Q x₀]) = 0
      have hmk : Submodule.mkQ N_Q ![q_Q x₁, q_Q x₀] = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
