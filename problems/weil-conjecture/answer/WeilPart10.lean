      refine ⟨B_next, instCR_n, instDom_n, ψ_kn.comp ψ₂_k, ι_n,
        hFT_kn.comp hFT_k, ?_, hInj_n, ?_⟩
      · rw [← RingHom.comp_assoc, hComp_kn, hComp_k]
      · intro i hi
