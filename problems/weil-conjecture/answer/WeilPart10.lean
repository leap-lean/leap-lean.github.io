        rw [CategoryTheory.Category.assoc, P_S.isoOfEq_inv_ι hQ_eq]
        exact AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_S
          (f_gr (MvPolynomial.X a)) (f_gr.map_mem (hX_R a)) zero_lt_one
      have hisoR_ι : iso_R.inv ≫ (D_R a).ι = j_R a :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_R (MvPolynomial.X a) (hX_R a) zero_lt_one
      have htop_comm :
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
            iso_R.symm.hom =
          iso_S.symm.hom ≫ ((Φ ∣_ W a) ≫ (p₁ ∣_ D_R a)) := by
        rw [← CategoryTheory.cancel_mono (D_R a).ι]
        calc
          (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
              iso_R.inv) ≫ (D_R a).ι
            = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
                j_R a := by
                rw [CategoryTheory.Category.assoc, hisoR_ι]
          _ = j_S a ≫ π_φ :=
                (AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one
                  (MvPolynomial.X a) (hX_R a)).symm
          _ = iso_S.inv ≫ Q_pre.ι ≫ π_φ := by
                rw [← hisoS_ι, CategoryTheory.Category.assoc]
          _ = iso_S.inv ≫ Q_pre.ι ≫ Φ ≫ p₁ := by
                rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = iso_S.inv ≫ (Φ ∣_ W a) ≫ (W a).ι ≫ p₁ := by
                rw [AlgebraicGeometry.morphismRestrict_ι_assoc Φ (W a)]
          _ = (iso_S.inv ≫ ((Φ ∣_ W a) ≫ (p₁ ∣_ D_R a))) ≫ (D_R a).ι := by
                rw [← AlgebraicGeometry.morphismRestrict_ι p₁ (D_R a)]
                simp only [CategoryTheory.Category.assoc]
      have hPB_src : CategoryTheory.IsPullback
          ((Φ ∣_ W a) ≫ (p₁ ∣_ D_R a))
          (Q_pre.ι ≫ p_S)
          ((D_R a).ι ≫ p_R)
          f_φ := by
        refine (hSpecPB a).of_iso iso_S.symm iso_R.symm
