    have hz_zero : z = 0 := hinj_lTensor (e_P.injective (hz_img.trans (map_zero e_P).symm))
    have hm_quot : e_M z = 0 := by rw [hz_zero, map_zero]
    change (TensorProduct.quotTensorEquivQuotSMul (↥M₀) I_A)
      ((Ideal.Quotient.mk I_A 1) ⊗ₜ[A₀] m) = 0 at hm_quot
    rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul,
      Submodule.Quotient.mk_eq_zero] at hm_quot
    exact hSmul_le_mul m hm_quot
  
  let Q_x : Ideal P₀ := Ideal.comap map_κ Q_bar
  have : Q_x.IsPrime := Ideal.IsPrime.comap map_κ
  let R_loc := Localization.AtPrime Q_x
  let φ_loc : P₀ →+* R_loc := algebraMap P₀ R_loc
  let φ_P : P_κ →+* P := algebraMap P_κ P
  have hSub_map : Q_x.primeCompl ≤ Submonoid.comap map_κ Q_bar.primeCompl := fun _ hx => hx
  let ψ_loc : R_loc →+* P := IsLocalization.map P map_κ hSub_map
  have hψ_comp : ψ_loc.comp φ_loc = φ_P.comp map_κ := IsLocalization.map_comp hSub_map
  have hPolyClear : ∀ f : P_κ,
      ∃ (s : A₀) (F : P₀), s ∉ p₀.asIdeal ∧ map_κ F = MvPolynomial.C (algebraMap A₀ κ s) * f := by
    intro f
    induction f using MvPolynomial.induction_on' with
    | monomial d c =>
      obtain ⟨a, s, hs, hcs⟩ := hκ_frac c
      refine ⟨s, MvPolynomial.monomial d a, hs, ?_⟩
      change MvPolynomial.map (algebraMap A₀ κ) (MvPolynomial.monomial d a) = _
      rw [MvPolynomial.map_monomial, MvPolynomial.C_mul_monomial, mul_comm, hcs]
    | add p q hp hq =>
      obtain ⟨sp, Fp, hsp, hep⟩ := hp
      obtain ⟨sq, Fq, hsq, heq⟩ := hq
      refine ⟨sp * sq, MvPolynomial.C sq * Fp + MvPolynomial.C sp * Fq,
        p₀.asIdeal.primeCompl.mul_mem hsp hsq, ?_⟩
      calc map_κ (MvPolynomial.C sq * Fp + MvPolynomial.C sp * Fq)
          = MvPolynomial.C (algebraMap A₀ κ sq) * map_κ Fp +
              MvPolynomial.C (algebraMap A₀ κ sp) * map_κ Fq := by
              rw [map_add, map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_C]
        _ = MvPolynomial.C (algebraMap A₀ κ sq) * (MvPolynomial.C (algebraMap A₀ κ sp) * p) +
              MvPolynomial.C (algebraMap A₀ κ sp) * (MvPolynomial.C (algebraMap A₀ κ sq) * q) := by
              rw [hep, heq]
        _ = MvPolynomial.C (algebraMap A₀ κ (sp * sq)) * (p + q) := by
              rw [map_mul, MvPolynomial.C_mul]; ring
  have hψ_surj : Function.Surjective ψ_loc := by
    intro z
    obtain ⟨⟨f, g⟩, hzg⟩ := IsLocalization.surj Q_bar.primeCompl z
    obtain ⟨s₁, F₁, hs₁, hF₁⟩ := hPolyClear f
    obtain ⟨s₂, G₁, hs₂, hG₁⟩ := hPolyClear g.1
    let N₀ : P₀ := MvPolynomial.C s₂ * F₁
