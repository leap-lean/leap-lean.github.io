        ext y
        simp only [Set.mem_univ, iff_true]
        have hy_top : y ∈ (⊤ : P_Ω.Opens) := trivial
        rw [← hU_top, TopologicalSpace.Opens.mem_iSup] at hy_top
        obtain ⟨j, hyj⟩ := hy_top
        have hj_or : j = a ∨ j = 1 - a := by
          fin_cases a <;> fin_cases j <;> decide
        rcases hj_or with rfl | rfl
        · exact hUa_sub hyj
        · exact hUb_sub hyj

      have : q.asIdeal.IsPrime := q.isPrime
      have hq_max : q.asIdeal.IsMaximal := IsPrime.to_maximal_ideal hq_ne_bot
      let g : Polynomial Ω := Submodule.IsPrincipal.generator q.asIdeal
      have hg_span : Ideal.span ({g} : Set (Polynomial Ω)) = q.asIdeal :=
        Submodule.IsPrincipal.span_singleton_generator q.asIdeal
      have hg_not_unit : ¬ IsUnit g := fun hu =>
        hq_max.ne_top (by rw [← hg_span, Ideal.span_singleton_eq_top.mpr hu])
      have hg_deg : g.degree ≠ 0 :=
        mt Polynomial.isUnit_iff_degree_eq_zero.mpr hg_not_unit
      obtain ⟨α, hα⟩ := IsAlgClosed.exists_root g hg_deg
      let ev_α : Polynomial Ω →+* Ω := Polynomial.evalRingHom α
      have hq_le : q.asIdeal ≤ RingHom.ker ev_α := by
        rw [← hg_span, Ideal.span_le, Set.singleton_subset_iff]
        exact hα
      have hq_ker : q.asIdeal = RingHom.ker ev_α :=
        hq_max.eq_of_le (RingHom.ker_isPrime ev_α).ne_top hq_le
      refine ⟨σ_sec a α, hσ_hom a α, ?_⟩
      intro pt
      have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_α)).base pt = q := by
        apply PrimeSpectrum.ext
        ext f
        change ev_α f ∈ pt.asIdeal ↔ f ∈ q.asIdeal
        rw [hpt_bot pt, Ideal.mem_bot, hq_ker, RingHom.mem_ker]
      change (ι a).base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_α)).base pt) = w
      rw [hpt_eq, hq]

theorem weil_domain_adjoin_proper_iso_and_empty_descent (B : Type u) [CommRing B] (K_bar : Type u) [Field K_bar] (ι_B : B →+* K_bar) :
    ∃ (R_of : Finset K_bar → Subring K_bar)
      (ψ_of : ∀ S : Finset K_bar, B →+* ↥(R_of S)),
      (∀ {S₁ S₂ : Finset K_bar}, S₁ ⊆ S₂ → R_of S₁ ≤ R_of S₂) ∧
      (∀ S : Finset K_bar, (R_of S).subtype.comp (ψ_of S) = ι_B) ∧
      (∀ S : Finset K_bar, RingHom.FiniteType (ψ_of S)) ∧
      (∀ (X : AlgebraicGeometry.Scheme.{u})
          (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
          [AlgebraicGeometry.LocallyOfFiniteType f]
          (S₀ : Finset K_bar)
          (ξ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ X),
        ξ ≫ f = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B) →
        ∃ (S₁ : Finset K_bar) (ξ_S : AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₁)) ⟶ X),
          S₀ ⊆ S₁ ∧
          ξ_S ≫ f = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁)) ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (R_of S₁).subtype) ≫ ξ_S = ξ) ∧
      (∀ (X Y : AlgebraicGeometry.Scheme.{u})
          (f_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
          (f_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
          [AlgebraicGeometry.IsProper f_X] [AlgebraicGeometry.LocallyOfFinitePresentation f_X]
          [AlgebraicGeometry.IsProper f_Y] [AlgebraicGeometry.LocallyOfFinitePresentation f_Y]
          (S₀ : Finset K_bar)
          (e_K : CategoryTheory.Limits.pullback f_X
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)) ≅
            CategoryTheory.Limits.pullback f_Y
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B))),
        e_K.hom ≫ CategoryTheory.Limits.pullback.snd f_Y
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)) =
          CategoryTheory.Limits.pullback.snd f_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)) →
        ∃ (S₁ : Finset K_bar)
          (e_S : CategoryTheory.Limits.pullback f_X
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁))) ≅
            CategoryTheory.Limits.pullback f_Y
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁)))),
          S₀ ⊆ S₁ ∧
          e_S.hom ≫ CategoryTheory.Limits.pullback.snd f_Y
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁))) =
            CategoryTheory.Limits.pullback.snd f_X
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁)))) ∧
      (∀ (S₀ : Finset K_bar)
          (Z : AlgebraicGeometry.Scheme.{u})
          (q : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₀)))
          [AlgebraicGeometry.QuasiCompact q],
        IsEmpty ↥(CategoryTheory.Limits.pullback q
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (R_of S₀).subtype))) →
        ∃ (S₁ : Finset K_bar) (hSub : R_of S₀ ≤ R_of S₁),
          S₀ ⊆ S₁ ∧
          IsEmpty ↥(CategoryTheory.Limits.pullback q
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion hSub))))) :=
by
  
  have hAdj :
      ∃ (homToSpecToRing : ∀ {Z : Scheme.{u}} {R : CommRingCat.{u}}, (Z ⟶ Spec R) → (R ⟶ Γ(Z, ⊤)))
        (homToSpecFromRing : ∀ {Z : Scheme.{u}} {R : CommRingCat.{u}}, (R ⟶ Γ(Z, ⊤)) → (Z ⟶ Spec R)),
        (∀ {Z : Scheme.{u}} {R : CommRingCat.{u}} (m : Z ⟶ Spec R),
          homToSpecFromRing (homToSpecToRing m) = m) ∧
        (∀ {Z : Scheme.{u}} {R : CommRingCat.{u}} (φ : R ⟶ Γ(Z, ⊤)),
          homToSpecToRing (homToSpecFromRing φ) = φ) ∧
        (∀ {Z : Scheme.{u}} {R R' : CommRingCat.{u}} (m : Z ⟶ Spec R) (φ : R' ⟶ R),
          homToSpecToRing (m ≫ Spec.map φ) = φ ≫ homToSpecToRing m) ∧
        (∀ {Z' Z : Scheme.{u}} {R : CommRingCat.{u}} (h : Z' ⟶ Z) (m : Z ⟶ Spec R),
          homToSpecToRing (h ≫ m) = homToSpecToRing m ≫ h.appTop) := by
    refine ⟨fun m => ((ΓSpec.adjunction.homEquiv _ (Opposite.op _)).symm m).unop,
      fun φ => (ΓSpec.adjunction.homEquiv _ (Opposite.op _)) φ.op,
      fun m => (ΓSpec.adjunction.homEquiv _ (Opposite.op _)).apply_symm_apply m,
      fun φ => Quiver.Hom.op_inj ((ΓSpec.adjunction.homEquiv _ (Opposite.op _)).symm_apply_apply φ.op),
      fun m φ => congrArg Quiver.Hom.unop (ΓSpec.adjunction.homEquiv_naturality_right_symm m φ.op),
      fun h m => congrArg Quiver.Hom.unop (ΓSpec.adjunction.homEquiv_naturality_left_symm h m)⟩
  obtain ⟨homToSpecToRing, homToSpecFromRing, homToSpec_from_to, homToSpec_to_from,
    homToSpecToRing_comp_specMap, homToSpecToRing_precomp⟩ := hAdj

  
  have hHomDesc :
      ∀ {I : Type u} [SmallCategory I] [IsCofiltered I]
        (D : I ⥤ Scheme.{u}) {R : CommRingCat.{u}}
        (t : D ⟶ (Functor.const I).obj (Spec R))
        {W : Scheme.{u}} (f : W ⟶ Spec R)
        (c : Limits.Cone D) (_hc : Limits.IsLimit c)
        [∀ i : I, CompactSpace ↥(D.obj i)]
        [∀ i : I, QuasiSeparatedSpace ↥(D.obj i)]
        [∀ {i j : I} (u : i ⟶ j), IsAffineHom (D.map u)]
        [LocallyOfFinitePresentation f]
        (φ : c.pt ⟶ W),
        (∀ i : I, φ ≫ f = c.π.app i ≫ t.app i) →
        ∃ (i : I) (φ_i : D.obj i ⟶ W), φ_i ≫ f = t.app i ∧ c.π.app i ≫ φ_i = φ := by
    intro I _ _ D R t X f c hc _ _ _ _ φ hφ
    let t_i : ∀ i : I, D.obj i ⟶ Spec R := fun i => t.app i
    have ht_nat : ∀ {i j : I} (g : i ⟶ j), D.map g ≫ t_i j = t_i i := by
      intro i j g
      have h := t.naturality g
      simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id] at h
      exact h

    have hAffMapOpens : ∀ (i₀ : I) (W : (D.obj i₀).Opens) {u v : Over i₀} (g : u ⟶ v),
        IsAffineHom ((opensDiagram D i₀ W).map g) := by
      intro i₀ W u v g
      let U_u : (D.obj u.left).Opens := D.map u.hom ⁻¹ᵁ W
      let U_v : (D.obj v.left).Opens := D.map v.hom ⁻¹ᵁ W
      let m_g : U_u.toScheme ⟶ U_v.toScheme := (opensDiagram D i₀ W).map g
      have hPb : IsPullback U_u.ι m_g (D.map g.left) U_v.ι :=
        (IsOpenImmersion.isPullback m_g U_u.ι U_v.ι (D.map g.left)
          (by simp [m_g, U_u, U_v])
          (by
            ext x
            simp only [SetLike.mem_coe, Scheme.Opens.opensRange_ι]
            change (D.map g.left ≫ D.map v.hom).base x ∈ W ↔ (D.map u.hom).base x ∈ W
            rw [← D.map_comp, Over.w g])).flip
      exact MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb inferInstance

    have hExV : ∀ x : ↥c.pt, ∃ V : X.Opens, IsAffineOpen V ∧ φ.base x ∈ V := by
      intro x
      obtain ⟨V, hAffV, hxV, _⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X))
          (show φ.base x ∈ (⊤ : X.Opens) from trivial)
      exact ⟨V, hAffV, hxV⟩
    choose V_x hAffVx hxVx using hExV

    have hExU : ∀ x : ↥c.pt, ∃ U : c.pt.Opens, IsAffineOpen U ∧ x ∈ U ∧ U ≤ φ ⁻¹ᵁ V_x x := by
      intro x
      exact (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens c.pt)) (hxVx x)
    choose U_x hAffUx hxUx hUx_le using hExU

    have hCovU : TopologicalSpace.IsOpenCover U_x :=
      eq_top_iff.mpr fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxUx x⟩

    obtain ⟨i₀, s, W₀, hCovW₀, hW₀⟩ :=
      Scheme.exists_isOpenCover_and_isAffine D c hc U_x hCovU hAffUx

    let ι_open : ∀ (W : (D.obj i₀).Opens) (u : Over i₀),
        (opensDiagram D i₀ W).obj u ⟶ D.obj u.left :=
      fun W u => (D.map u.hom ⁻¹ᵁ W).ι
    let ι_cone : ∀ (W : (D.obj i₀).Opens),
        (opensCone D c i₀ W).pt ⟶ c.pt :=
      fun W => (c.π.app i₀ ⁻¹ᵁ W).ι

    have hOpenImm_ι : ∀ (W : (D.obj i₀).Opens) (u : Over i₀),
        IsOpenImmersion (ι_open W u) := by
      intro W u
      change IsOpenImmersion (D.map u.hom ⁻¹ᵁ W).ι
      infer_instance

    have hMono_ι : ∀ (W : (D.obj i₀).Opens) (u : Over i₀),
        Mono (ι_open W u) := by
      intro W u
      change Mono (D.map u.hom ⁻¹ᵁ W).ι
      infer_instance

    have hι_open_nat : ∀ (W : (D.obj i₀).Opens) {u v : Over i₀} (g : u ⟶ v),
        (opensDiagram D i₀ W).map g ≫ ι_open W v = ι_open W u ≫ D.map g.left := by
      intro W u v g
      simp [ι_open, opensDiagram]

    have hι_cone_nat : ∀ (W : (D.obj i₀).Opens) (u : Over i₀),
        (opensCone D c i₀ W).π.app u ≫ ι_open W u = ι_cone W ≫ c.π.app u.left := by
      intro W u
      exact Scheme.Hom.resLE_comp_ι _ _

    have hPerChart : ∀ a : ↥s,
        ∃ (u_a : Over i₀) (ψ_a : (opensDiagram D i₀ (W₀ a)).obj u_a ⟶ X),
          ψ_a ≫ f = ι_open (W₀ a) u_a ≫ t_i u_a.left ∧
          (opensCone D c i₀ (W₀ a)).π.app u_a ≫ ψ_a = ι_cone (W₀ a) ≫ φ := by
      intro a
      let W_a := W₀ a
      have hAffWa : IsAffineOpen W_a := (hW₀ a).1
      let V_a := V_x a.1
      have hAffVa : IsAffineOpen V_a := hAffVx a.1
      have hLe_ca : c.π.app i₀ ⁻¹ᵁ W_a ≤ φ ⁻¹ᵁ V_a := by
        rw [← (hW₀ a).2]
        exact hUx_le a.1
      let D_a := opensDiagram D i₀ W_a
      let c_a := opensCone D c i₀ W_a
      let hc_a := isLimitOpensCone D c hc i₀ W_a
      have hAffMap_a : ∀ {u v : Over i₀} (g : u ⟶ v), IsAffineHom (D_a.map g) :=
        fun g => hAffMapOpens i₀ W_a g
      have hAffObj_a : ∀ u : Over i₀, IsAffine (D_a.obj u) :=
        fun u => hAffWa.preimage (D.map u.hom)
      have hComp_a : ∀ u : Over i₀, CompactSpace ↥(D_a.obj u) := by
        intro u; have := hAffObj_a u; infer_instance
      have hQS_a : ∀ u : Over i₀, QuasiSeparatedSpace ↥(D_a.obj u) := by
        intro u; have := hAffObj_a u; infer_instance
      obtain ⟨hColim_a⟩ :=
        @nonempty_isColimit_Γ_mapCocone (Over i₀) _ D_a c_a hc_a _ (@hAffMap_a) hComp_a hQS_a

      let S_a : CommRingCat.{u} := X.presheaf.obj (Opposite.op V_a)
      let f_a : R ⟶ S_a := Spec.preimage (hAffVa.fromSpec ≫ f)
      have hf_a_map : Spec.map f_a = hAffVa.fromSpec ≫ f := Spec.map_preimage _
      have hf_a_lfp : LocallyOfFinitePresentation (Spec.map f_a) := by
        rw [hf_a_map]
        infer_instance
      have hf_a_fp : f_a.hom.FinitePresentation :=
        (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mp hf_a_lfp

      let φ_loc : c_a.pt ⟶ Spec S_a :=
        IsOpenImmersion.lift hAffVa.fromSpec (ι_cone W_a ≫ φ) (by
          rw [hAffVa.range_fromSpec]
          rintro _ ⟨y, rfl⟩
          exact hLe_ca y.2)
      have hφ_loc : φ_loc ≫ hAffVa.fromSpec = ι_cone W_a ≫ φ :=
        IsOpenImmersion.lift_fac _ _ _

      let F_a : (Over i₀)ᵒᵖ ⥤ CommRingCat.{u} := D_a.op ⋙ Scheme.Γ
      let α_app : ∀ u : Over i₀, R ⟶ Γ(D_a.obj u, ⊤) :=
        fun u => homToSpecToRing (ι_open W_a u ≫ t_i u.left)
      let α_a : (Functor.const (Over i₀)ᵒᵖ).obj R ⟶ F_a :=
        { app := fun u_op => α_app u_op.unop
          naturality := by
            intro u_op v_op g_op
            change 𝟙 R ≫ α_app v_op.unop = α_app u_op.unop ≫ (D_a.map g_op.unop).appTop
            rw [Category.id_comp]
            dsimp only [α_app]
            rw [← homToSpecToRing_precomp]
            congr 1
            calc
              ι_open W_a v_op.unop ≫ t_i v_op.unop.left
                = ι_open W_a v_op.unop ≫ D.map g_op.unop.left ≫ t_i u_op.unop.left := by
                    rw [ht_nat g_op.unop.left]
              _ = (D_a.map g_op.unop ≫ ι_open W_a u_op.unop) ≫ t_i u_op.unop.left := by
                    rw [← Category.assoc, hι_open_nat W_a g_op.unop]
              _ = D_a.map g_op.unop ≫ ι_open W_a u_op.unop ≫ t_i u_op.unop.left := by
                    rw [Category.assoc] }

      let g_ring : S_a ⟶ (Scheme.Γ.mapCocone c_a.op).pt := homToSpecToRing φ_loc
      have hCompat : ∀ u_op : (Over i₀)ᵒᵖ,
          f_a ≫ g_ring = α_a.app u_op ≫ (Scheme.Γ.mapCocone c_a.op).ι.app u_op := by
        intro u_op
        change f_a ≫ homToSpecToRing φ_loc = α_app u_op.unop ≫ (c_a.π.app u_op.unop).appTop
        dsimp only [α_app]
        rw [← homToSpecToRing_comp_specMap, ← homToSpecToRing_precomp]
        congr 1
        calc
          φ_loc ≫ Spec.map f_a
            = (φ_loc ≫ hAffVa.fromSpec) ≫ f := by rw [hf_a_map, Category.assoc]
          _ = ι_cone W_a ≫ (φ ≫ f) := by rw [hφ_loc, Category.assoc]
          _ = (ι_cone W_a ≫ c.π.app u_op.unop.left) ≫ t_i u_op.unop.left := by
                rw [hφ u_op.unop.left, Category.assoc]
          _ = (c_a.π.app u_op.unop ≫ ι_open W_a u_op.unop) ≫ t_i u_op.unop.left := by
                rw [hι_cone_nat W_a u_op.unop]
          _ = c_a.π.app u_op.unop ≫ ι_open W_a u_op.unop ≫ t_i u_op.unop.left := by
                rw [Category.assoc]

      obtain ⟨u_op, q_a, hfq, hgq⟩ :=
        RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          R F_a α_a f_a (Scheme.Γ.mapCocone c_a.op) hColim_a hf_a_fp g_ring hCompat

      let u_a : Over i₀ := u_op.unop
      let q_a' : S_a ⟶ Γ(D_a.obj u_a, ⊤) := q_a
      let q_sch : D_a.obj u_a ⟶ Spec S_a := homToSpecFromRing q_a'
      have hq_to : homToSpecToRing q_sch = q_a' := homToSpec_to_from q_a'
      let ψ_a : D_a.obj u_a ⟶ X := q_sch ≫ hAffVa.fromSpec
      refine ⟨u_a, ψ_a, ?_, ?_⟩
      · have h1 : homToSpecToRing (q_sch ≫ Spec.map f_a) =
            homToSpecToRing (ι_open W_a u_a ≫ t_i u_a.left) := by
          rw [homToSpecToRing_comp_specMap, hq_to]
          exact hfq
        have h2 : q_sch ≫ Spec.map f_a = ι_open W_a u_a ≫ t_i u_a.left := by
          rw [← homToSpec_from_to (q_sch ≫ Spec.map f_a), h1, homToSpec_from_to]
        dsimp only [ψ_a]
        rw [Category.assoc, ← hf_a_map, h2]
      · have h1 : homToSpecToRing (c_a.π.app u_a ≫ q_sch) = homToSpecToRing φ_loc := by
          rw [homToSpecToRing_precomp, hq_to]
          exact hgq.symm
        have h2 : c_a.π.app u_a ≫ q_sch = φ_loc := by
          rw [← homToSpec_from_to (c_a.π.app u_a ≫ q_sch), h1, homToSpec_from_to]
        dsimp only [ψ_a]
        rw [← Category.assoc, h2, hφ_loc]

    choose u_chart ψ_chart hψ_f hψ_c using hPerChart

    let _ : DecidableEq (Over i₀) := Classical.decEq _
    let _ : ∀ x y : Over i₀, DecidableEq (x ⟶ y) := fun _ _ => Classical.decEq _
    let O₁ : Finset (Over i₀) := Finset.univ.image u_chart
    let u₁ : Over i₀ := IsCofiltered.inf O₁ ∅
    let lam₁ : ∀ a : ↥s, u₁ ⟶ u_chart a :=
      fun a => IsCofiltered.infTo O₁ ∅ (Finset.mem_image_of_mem u_chart (Finset.mem_univ a))
    let ψ₁ : ∀ a : ↥s, (opensDiagram D i₀ (W₀ a)).obj u₁ ⟶ X :=
      fun a => (opensDiagram D i₀ (W₀ a)).map (lam₁ a) ≫ ψ_chart a

    have hψ₁_f : ∀ a : ↥s, ψ₁ a ≫ f = ι_open (W₀ a) u₁ ≫ t_i u₁.left := by
      intro a
      dsimp only [ψ₁]
      rw [Category.assoc, hψ_f a, ← Category.assoc, hι_open_nat (W₀ a) (lam₁ a),
        Category.assoc, ht_nat (lam₁ a).left]

    have hψ₁_c : ∀ a : ↥s,
        (opensCone D c i₀ (W₀ a)).π.app u₁ ≫ ψ₁ a = ι_cone (W₀ a) ≫ φ := by
      intro a
      dsimp only [ψ₁]
      rw [← Category.assoc, (opensCone D c i₀ (W₀ a)).w (lam₁ a), hψ_c a]

    let inc_L : ∀ (a b : ↥s) (u : Over i₀),
        (opensDiagram D i₀ (W₀ a ⊓ W₀ b)).obj u ⟶ (opensDiagram D i₀ (W₀ a)).obj u :=
      fun a b u => (D.obj u.left).homOfLE (fun _ hx => hx.1)
    let inc_R : ∀ (a b : ↥s) (u : Over i₀),
        (opensDiagram D i₀ (W₀ a ⊓ W₀ b)).obj u ⟶ (opensDiagram D i₀ (W₀ b)).obj u :=
      fun a b u => (D.obj u.left).homOfLE (fun _ hx => hx.2)

    have hPairEq : ∀ p : ↥s × ↥s,
        ∃ (v_p : Over i₀) (μ_p : v_p ⟶ u₁),
          (opensDiagram D i₀ (W₀ p.1 ⊓ W₀ p.2)).map μ_p ≫ inc_L p.1 p.2 u₁ ≫ ψ₁ p.1 =
          (opensDiagram D i₀ (W₀ p.1 ⊓ W₀ p.2)).map μ_p ≫ inc_R p.1 p.2 u₁ ≫ ψ₁ p.2 := by
      intro p
      let W_ab := W₀ p.1 ⊓ W₀ p.2
      let D_ab := opensDiagram D i₀ W_ab
      let c_ab := opensCone D c i₀ W_ab
      let hc_ab := isLimitOpensCone D c hc i₀ W_ab
      have hAffMap_ab : ∀ {u v : Over i₀} (g : u ⟶ v), IsAffineHom (D_ab.map g) :=
        fun g => hAffMapOpens i₀ W_ab g
      have hComp_ab : ∀ u : Over i₀, CompactSpace ↥(D_ab.obj u) :=
        fun u => isCompact_iff_compactSpace.mp <|
          (((hW₀ p.1).1.preimage (D.map u.hom)).isCompact).inter_of_isOpen
            (((hW₀ p.2).1.preimage (D.map u.hom)).isCompact)
            (D.map u.hom ⁻¹ᵁ W₀ p.1).isOpen (D.map u.hom ⁻¹ᵁ W₀ p.2).isOpen
      let t_ab : D_ab ⟶ (Functor.const (Over i₀)).obj (Spec R) :=
        { app := fun u => ι_open W_ab u ≫ t_i u.left
          naturality := by
            intro u v g
            dsimp only [Functor.const_obj_obj, Functor.const_obj_map]
            rw [Category.comp_id, ← Category.assoc, hι_open_nat W_ab g,
              Category.assoc, ht_nat g.left] }
      let mor_L : D_ab.obj u₁ ⟶ X := inc_L p.1 p.2 u₁ ≫ ψ₁ p.1
      let mor_R : D_ab.obj u₁ ⟶ X := inc_R p.1 p.2 u₁ ≫ ψ₁ p.2
      have hinc_L_ι : inc_L p.1 p.2 u₁ ≫ ι_open (W₀ p.1) u₁ = ι_open W_ab u₁ :=
        Scheme.homOfLE_ι _ _
      have hinc_R_ι : inc_R p.1 p.2 u₁ ≫ ι_open (W₀ p.2) u₁ = ι_open W_ab u₁ :=
        Scheme.homOfLE_ι _ _
      have hL_f : t_ab.app u₁ = mor_L ≫ f := by
        change ι_open W_ab u₁ ≫ t_i u₁.left = (inc_L p.1 p.2 u₁ ≫ ψ₁ p.1) ≫ f
        rw [Category.assoc, hψ₁_f p.1, ← Category.assoc, hinc_L_ι]
      have hR_f : t_ab.app u₁ = mor_R ≫ f := by
        change ι_open W_ab u₁ ≫ t_i u₁.left = (inc_R p.1 p.2 u₁ ≫ ψ₁ p.2) ≫ f
        rw [Category.assoc, hψ₁_f p.2, ← Category.assoc, hinc_R_ι]
      have hLR_c : c_ab.π.app u₁ ≫ mor_L = c_ab.π.app u₁ ≫ mor_R := by
        let c_inc_L : c_ab.pt ⟶ (opensCone D c i₀ (W₀ p.1)).pt :=
          c.pt.homOfLE (fun _ hx => hx.1)
        let c_inc_R : c_ab.pt ⟶ (opensCone D c i₀ (W₀ p.2)).pt :=
          c.pt.homOfLE (fun _ hx => hx.2)
        have hcomm_L : c_ab.π.app u₁ ≫ inc_L p.1 p.2 u₁ =
            c_inc_L ≫ (opensCone D c i₀ (W₀ p.1)).π.app u₁ := by
          have := hMono_ι (W₀ p.1) u₁
          rw [← cancel_mono (ι_open (W₀ p.1) u₁), Category.assoc, hinc_L_ι,
            hι_cone_nat W_ab u₁, Category.assoc, hι_cone_nat (W₀ p.1) u₁, ← Category.assoc]
          congr 1
          exact (Scheme.homOfLE_ι _ _).symm
        have hcomm_R : c_ab.π.app u₁ ≫ inc_R p.1 p.2 u₁ =
            c_inc_R ≫ (opensCone D c i₀ (W₀ p.2)).π.app u₁ := by
          have := hMono_ι (W₀ p.2) u₁
          rw [← cancel_mono (ι_open (W₀ p.2) u₁), Category.assoc, hinc_R_ι,
            hι_cone_nat W_ab u₁, Category.assoc, hι_cone_nat (W₀ p.2) u₁, ← Category.assoc]
          congr 1
          exact (Scheme.homOfLE_ι _ _).symm
        have hc_L_ι : c_inc_L ≫ ι_cone (W₀ p.1) = ι_cone W_ab := Scheme.homOfLE_ι _ _
        have hc_R_ι : c_inc_R ≫ ι_cone (W₀ p.2) = ι_cone W_ab := Scheme.homOfLE_ι _ _
        calc
          c_ab.π.app u₁ ≫ mor_L
            = (c_ab.π.app u₁ ≫ inc_L p.1 p.2 u₁) ≫ ψ₁ p.1 := by
                dsimp only [mor_L]; rw [Category.assoc]
          _ = c_inc_L ≫ ι_cone (W₀ p.1) ≫ φ := by
                rw [hcomm_L, Category.assoc, hψ₁_c p.1]
          _ = ι_cone W_ab ≫ φ := by
                rw [← Category.assoc, hc_L_ι]
          _ = c_inc_R ≫ ι_cone (W₀ p.2) ≫ φ := by
                rw [← Category.assoc, hc_R_ι]
          _ = (c_ab.π.app u₁ ≫ inc_R p.1 p.2 u₁) ≫ ψ₁ p.2 := by
                rw [← hψ₁_c p.2, ← Category.assoc, hcomm_R]
          _ = c_ab.π.app u₁ ≫ mor_R := by
                dsimp only [mor_R]; rw [Category.assoc]
      exact @Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType
        (Over i₀) _ (Spec R) X D_ab t_ab f c_ab hc_ab hComp_ab inferInstance _ (@hAffMap_ab)
        u₁ mor_L mor_R hL_f hR_f hLR_c

    choose v_pair μ_pair hμ_pair using hPairEq

    let O₂ : Finset (Over i₀) := insert u₁ (Finset.univ.image v_pair)
    have hu₁_O₂ : u₁ ∈ O₂ := Finset.mem_insert_self u₁ _
    have hv_O₂ : ∀ p : ↥s × ↥s, v_pair p ∈ O₂ :=
      fun p => Finset.mem_insert_of_mem (Finset.mem_image_of_mem v_pair (Finset.mem_univ p))
    let H₂ : Finset ((X : Over i₀) ×' (Y : Over i₀) ×' (_ : X ∈ O₂) ×' (_ : Y ∈ O₂) ×' (X ⟶ Y)) :=
      Finset.univ.image (fun p : ↥s × ↥s => ⟨v_pair p, ⟨u₁, ⟨hv_O₂ p, ⟨hu₁_O₂, μ_pair p⟩⟩⟩⟩)
    let u_star : Over i₀ := IsCofiltered.inf O₂ H₂
    let m_star : u_star ⟶ u₁ := IsCofiltered.infTo O₂ H₂ hu₁_O₂
    have hm_star_fac : ∀ p : ↥s × ↥s,
        IsCofiltered.infTo O₂ H₂ (hv_O₂ p) ≫ μ_pair p = m_star :=
      fun p => IsCofiltered.infTo_commutes O₂ H₂ (hv_O₂ p) hu₁_O₂
        (Finset.mem_image_of_mem _ (Finset.mem_univ p))

    let i_star : I := u_star.left
    let W_star : ↥s → (D.obj i_star).Opens := fun a => D.map u_star.hom ⁻¹ᵁ W₀ a
    have hCovW_star : TopologicalSpace.IsOpenCover W_star := by
      apply eq_top_iff.mpr
      intro y _
      have hy₀ : (D.map u_star.hom).base y ∈ (⨆ a : ↥s, W₀ a) := by
        rw [hCovW₀]; trivial
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hy₀
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩

    let 𝒰 : (D.obj i_star).OpenCover := (D.obj i_star).openCoverOfIsOpenCover W_star hCovW_star
    let ψ_star : ∀ a : 𝒰.I₀, 𝒰.X a ⟶ X :=
      fun a => (opensDiagram D i₀ (W₀ a)).map m_star ≫ ψ₁ a

    have hGlueCompat : ∀ a b : 𝒰.I₀,
        Limits.pullback.fst (𝒰.f a) (𝒰.f b) ≫ ψ_star a =
        Limits.pullback.snd (𝒰.f a) (𝒰.f b) ≫ ψ_star b := by
      intro a b
      let a₀ : ↥s := a
      let b₀ : ↥s := b
      let W_ab := W₀ a₀ ⊓ W₀ b₀
      have := hOpenImm_ι W_ab u_star
      let l_ab : Limits.pullback (𝒰.f a) (𝒰.f b) ⟶ (opensDiagram D i₀ W_ab).obj u_star :=
        IsOpenImmersion.lift (ι_open W_ab u_star)
          (Limits.pullback.fst (𝒰.f a) (𝒰.f b) ≫ 𝒰.f a) (by
            change Set.range (Limits.pullback.fst (𝒰.f a) (𝒰.f b) ≫ 𝒰.f a).base ⊆
              Set.range (D.map u_star.hom ⁻¹ᵁ W_ab).ι.base
            rw [Scheme.Opens.range_ι]
            rintro _ ⟨z, rfl⟩
            refine ⟨((Limits.pullback.fst (𝒰.f a) (𝒰.f b)).base z).2, ?_⟩
            have hz_eq : (Limits.pullback.fst (𝒰.f a) (𝒰.f b) ≫ 𝒰.f a).base z =
                (Limits.pullback.snd (𝒰.f a) (𝒰.f b) ≫ 𝒰.f b).base z := by
              rw [Limits.pullback.condition]
            rw [hz_eq]
            exact ((Limits.pullback.snd (𝒰.f a) (𝒰.f b)).base z).2)
      have hl_fac : l_ab ≫ ι_open W_ab u_star = Limits.pullback.fst (𝒰.f a) (𝒰.f b) ≫ 𝒰.f a :=
        IsOpenImmersion.lift_fac _ _ _
      have hL_ι : ∀ u : Over i₀, inc_L a₀ b₀ u ≫ ι_open (W₀ a₀) u = ι_open W_ab u :=
        fun _ => Scheme.homOfLE_ι _ _
      have hR_ι : ∀ u : Over i₀, inc_R a₀ b₀ u ≫ ι_open (W₀ b₀) u = ι_open W_ab u :=
        fun _ => Scheme.homOfLE_ι _ _
      let p_fst : Limits.pullback (𝒰.f a) (𝒰.f b) ⟶ (opensDiagram D i₀ (W₀ a₀)).obj u_star :=
        Limits.pullback.fst (𝒰.f a) (𝒰.f b)
      let p_snd : Limits.pullback (𝒰.f a) (𝒰.f b) ⟶ (opensDiagram D i₀ (W₀ b₀)).obj u_star :=
        Limits.pullback.snd (𝒰.f a) (𝒰.f b)
      have hl_fst : l_ab ≫ inc_L a₀ b₀ u_star = p_fst := by
        have := hMono_ι (W₀ a₀) u_star
        rw [← cancel_mono (ι_open (W₀ a₀) u_star), Category.assoc, hL_ι u_star]
        exact hl_fac
      have hl_snd : l_ab ≫ inc_R a₀ b₀ u_star = p_snd := by
        have := hMono_ι (W₀ b₀) u_star
        rw [← cancel_mono (ι_open (W₀ b₀) u_star), Category.assoc, hR_ι u_star]
        exact hl_fac.trans Limits.pullback.condition
      have hcomm_L : inc_L a₀ b₀ u_star ≫ (opensDiagram D i₀ (W₀ a₀)).map m_star =
          (opensDiagram D i₀ W_ab).map m_star ≫ inc_L a₀ b₀ u₁ := by
        have := hMono_ι (W₀ a₀) u₁
        rw [← cancel_mono (ι_open (W₀ a₀) u₁), Category.assoc, hι_open_nat (W₀ a₀) m_star,
          ← Category.assoc, hL_ι u_star, Category.assoc, hL_ι u₁,
          hι_open_nat W_ab m_star]
      have hcomm_R : inc_R a₀ b₀ u_star ≫ (opensDiagram D i₀ (W₀ b₀)).map m_star =
          (opensDiagram D i₀ W_ab).map m_star ≫ inc_R a₀ b₀ u₁ := by
        have := hMono_ι (W₀ b₀) u₁
        rw [← cancel_mono (ι_open (W₀ b₀) u₁), Category.assoc, hι_open_nat (W₀ b₀) m_star,
          ← Category.assoc, hR_ι u_star, Category.assoc, hR_ι u₁,
          hι_open_nat W_ab m_star]
      have hEq_star :
          (opensDiagram D i₀ W_ab).map m_star ≫ inc_L a₀ b₀ u₁ ≫ ψ₁ a₀ =
          (opensDiagram D i₀ W_ab).map m_star ≫ inc_R a₀ b₀ u₁ ≫ ψ₁ b₀ := by
        rw [← hm_star_fac (a₀, b₀), Functor.map_comp, Category.assoc, Category.assoc]
        exact congrArg (fun k => (opensDiagram D i₀ W_ab).map _ ≫ k) (hμ_pair (a₀, b₀))
      change p_fst ≫ ((opensDiagram D i₀ (W₀ a₀)).map m_star ≫ ψ₁ a₀) =
        p_snd ≫ ((opensDiagram D i₀ (W₀ b₀)).map m_star ≫ ψ₁ b₀)
      calc
        p_fst ≫ ((opensDiagram D i₀ (W₀ a₀)).map m_star ≫ ψ₁ a₀)
          = l_ab ≫ (inc_L a₀ b₀ u_star ≫ (opensDiagram D i₀ (W₀ a₀)).map m_star) ≫ ψ₁ a₀ := by
              rw [← hl_fst, Category.assoc, Category.assoc]
        _ = l_ab ≫ (opensDiagram D i₀ W_ab).map m_star ≫ inc_L a₀ b₀ u₁ ≫ ψ₁ a₀ := by
              rw [hcomm_L, Category.assoc]
        _ = l_ab ≫ (opensDiagram D i₀ W_ab).map m_star ≫ inc_R a₀ b₀ u₁ ≫ ψ₁ b₀ := by
              rw [hEq_star]
        _ = l_ab ≫ (inc_R a₀ b₀ u_star ≫ (opensDiagram D i₀ (W₀ b₀)).map m_star) ≫ ψ₁ b₀ := by
              rw [← Category.assoc ((opensDiagram D i₀ W_ab).map m_star), ← hcomm_R]
        _ = p_snd ≫ ((opensDiagram D i₀ (W₀ b₀)).map m_star ≫ ψ₁ b₀) := by
              rw [← Category.assoc l_ab, ← Category.assoc l_ab, hl_snd, Category.assoc]

    let φ_star : D.obj i_star ⟶ X := 𝒰.glueMorphisms ψ_star hGlueCompat
    refine ⟨i_star, φ_star, ?_, ?_⟩
    · apply 𝒰.hom_ext
      intro a
      let a₀ : ↥s := a
      rw [← Category.assoc, 𝒰.ι_glueMorphisms]
      change ((opensDiagram D i₀ (W₀ a₀)).map m_star ≫ ψ₁ a₀) ≫ f =
        ι_open (W₀ a₀) u_star ≫ t_i i_star
      rw [Category.assoc, hψ₁_f a₀, ← Category.assoc, hι_open_nat (W₀ a₀) m_star,
        Category.assoc, ht_nat m_star.left]
    · let W_c : ↥s → c.pt.Opens := fun a => c.π.app i₀ ⁻¹ᵁ W₀ a
      have hCovW_c : TopologicalSpace.IsOpenCover W_c := by
        apply eq_top_iff.mpr
        intro x _
        have hx₀ : (c.π.app i₀).base x ∈ (⨆ a : ↥s, W₀ a) := by
          rw [hCovW₀]; trivial
        obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx₀
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
      let 𝒰_c : c.pt.OpenCover := c.pt.openCoverOfIsOpenCover W_c hCovW_c
      apply 𝒰_c.hom_ext
      intro a
      let a₀ : ↥s := a
      let a_star : 𝒰.I₀ := a₀
      have hglue_a : ι_open (W₀ a₀) u_star ≫ φ_star =
          (opensDiagram D i₀ (W₀ a₀)).map m_star ≫ ψ₁ a₀ :=
        𝒰.ι_glueMorphisms ψ_star hGlueCompat a_star
      change ι_cone (W₀ a₀) ≫ (c.π.app i_star ≫ φ_star) = ι_cone (W₀ a₀) ≫ φ
      rw [← Category.assoc, ← hι_cone_nat (W₀ a₀) u_star, Category.assoc, hglue_a,
        ← Category.assoc, (opensCone D c i₀ (W₀ a₀)).w m_star, hψ₁_c a₀]

  
  have hS1 : ∃ (R_of : Finset K_bar → Subring K_bar)
      (ψ_of : ∀ S : Finset K_bar, B →+* ↥(R_of S)),
      (∀ {S₁ S₂ : Finset K_bar}, S₁ ⊆ S₂ → R_of S₁ ≤ R_of S₂) ∧
      (∀ S : Finset K_bar, (R_of S).subtype.comp (ψ_of S) = ι_B) ∧
      (∀ (S : Finset K_bar) (x : K_bar), x ∈ S → x ∈ R_of S) ∧
      (∀ S : Finset K_bar, RingHom.FiniteType (ψ_of S)) ∧
      (∀ (X : Scheme.{u})
          (f : X ⟶ Spec (CommRingCat.of B))
          [LocallyOfFiniteType f]
          (S₀ : Finset K_bar)
          (ξ : Spec (CommRingCat.of K_bar) ⟶ X),
        ξ ≫ f = Spec.map (CommRingCat.ofHom ι_B) →
        ∃ (S₁ : Finset K_bar) (ξ_S : Spec (CommRingCat.of ↥(R_of S₁)) ⟶ X),
          S₀ ⊆ S₁ ∧
          ξ_S ≫ f = Spec.map (CommRingCat.ofHom (ψ_of S₁)) ∧
          Spec.map (CommRingCat.ofHom (R_of S₁).subtype) ≫ ξ_S = ξ) := by
    let R_of : Finset K_bar → Subring K_bar :=
      fun S => Subring.closure (Set.range ι_B ∪ (↑S : Set K_bar))
    let ψ_of : ∀ S : Finset K_bar, B →+* ↥(R_of S) :=
      fun S => ι_B.codRestrict (R_of S) (fun b => Subring.subset_closure (Or.inl ⟨b, rfl⟩))
    have hMono : ∀ {S₁ S₂ : Finset K_bar}, S₁ ⊆ S₂ → R_of S₁ ≤ R_of S₂ := by
      intro S₁ S₂ h
      exact Subring.closure_mono (Set.union_subset_union_right _ (Finset.coe_subset.mpr h))
    have hComp : ∀ S : Finset K_bar, (R_of S).subtype.comp (ψ_of S) = ι_B :=
      fun _ => RingHom.ext fun _ => rfl
    have hMem : ∀ (S : Finset K_bar) (x : K_bar), x ∈ S → x ∈ R_of S :=
      fun S x hx => Subring.subset_closure (Or.inr (Finset.mem_coe.mpr hx))
    have hFT : ∀ S : Finset K_bar, RingHom.FiniteType (ψ_of S) := by
      intro S
      let _ : DecidableEq K_bar := Classical.decEq K_bar
      let _ : Algebra B ↥(R_of S) := (ψ_of S).toAlgebra
      refine @Algebra.FiniteType.mk B ↥(R_of S) _ _ (ψ_of S).toAlgebra ?_
      let G_S : Finset ↥(R_of S) := S.attach.image (fun x => ⟨x.1, hMem S x.1 x.2⟩)
      let A_sub : Subalgebra B ↥(R_of S) := Algebra.adjoin B (↑G_S : Set ↥(R_of S))
      have hEqTop : A_sub = ⊤ := by
        rw [eq_top_iff]
        have hLe : R_of S ≤ A_sub.toSubring.map (R_of S).subtype := by
          refine Subring.closure_le.mpr ?_
          rintro y (⟨b, rfl⟩ | hyS)
          · exact ⟨algebraMap B ↥(R_of S) b, A_sub.algebraMap_mem b, rfl⟩
          · have hy_mem : y ∈ S := Finset.mem_coe.mp hyS
            let g : ↥(R_of S) := ⟨y, hMem S y hy_mem⟩
            have hg_G : g ∈ G_S :=
              Finset.mem_image.mpr ⟨⟨y, hy_mem⟩, Finset.mem_attach _ _, rfl⟩
            exact ⟨g, Algebra.subset_adjoin (Finset.mem_coe.mpr hg_G), rfl⟩
        intro z _
        obtain ⟨w, hw, hw_eq⟩ := hLe z.2
        have hwz : w = z := Subtype.ext hw_eq
        rwa [← hwz]
      rw [← hEqTop]
      exact Subalgebra.fg_adjoin_finset G_S
    have hSecDesc : ∀ (X : Scheme.{u})
        (f : X ⟶ Spec (CommRingCat.of B))
        [LocallyOfFiniteType f]
        (S₀ : Finset K_bar)
        (ξ : Spec (CommRingCat.of K_bar) ⟶ X),
        ξ ≫ f = Spec.map (CommRingCat.ofHom ι_B) →
        ∃ (S₁ : Finset K_bar) (ξ_S : Spec (CommRingCat.of ↥(R_of S₁)) ⟶ X),
          S₀ ⊆ S₁ ∧
          ξ_S ≫ f = Spec.map (CommRingCat.ofHom (ψ_of S₁)) ∧
          Spec.map (CommRingCat.ofHom (R_of S₁).subtype) ≫ ξ_S = ξ := by
      intro X f _ S₀ ξ hξf
      let pt₀ : ↥(Spec (CommRingCat.of K_bar)) := ⟨⊥, inferInstance⟩
      obtain ⟨V, hAffV_mem, hptV, _⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X))
          (show ξ.base pt₀ ∈ (⊤ : X.Opens) from trivial)
      have hAffV : IsAffineOpen V := hAffV_mem
      let ξ_aff : Spec (CommRingCat.of K_bar) ⟶ Spec (X.presheaf.obj (Opposite.op V)) :=
        IsOpenImmersion.lift hAffV.fromSpec ξ (by
          rw [hAffV.range_fromSpec]
          rintro _ ⟨pt, rfl⟩
          have hpt : pt = pt₀ := Subsingleton.elim pt pt₀
          rw [hpt]
          exact hptV)
      have hξ_aff : ξ_aff ≫ hAffV.fromSpec = ξ := IsOpenImmersion.lift_fac _ _ _
      let A_V := X.presheaf.obj (Opposite.op V)
      let φ_hom : A_V ⟶ CommRingCat.of K_bar := Spec.preimage ξ_aff
      let f_V_hom : CommRingCat.of B ⟶ A_V := Spec.preimage (hAffV.fromSpec ≫ f)
      have hφ_map : Spec.map φ_hom = ξ_aff := Spec.map_preimage _
      have hfV_map : Spec.map f_V_hom = hAffV.fromSpec ≫ f := Spec.map_preimage _
      have h_comp_ι : φ_hom.hom.comp f_V_hom.hom = ι_B := by
        have hSpecEq : Spec.map (f_V_hom ≫ φ_hom) = Spec.map (CommRingCat.ofHom ι_B) := by
          rw [Spec.map_comp, hφ_map, hfV_map, ← Category.assoc, hξ_aff, hξf]
        exact congrArg CommRingCat.Hom.hom (Spec.map_injective hSpecEq)
      have hfV_lft : LocallyOfFiniteType (Spec.map f_V_hom) := by
        rw [hfV_map]
        infer_instance
      have hfV_ft : f_V_hom.hom.FiniteType :=
        (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hfV_lft
      let _ : Algebra B ↑A_V := f_V_hom.hom.toAlgebra
      obtain ⟨G, hG⟩ : (⊤ : Subalgebra B ↑A_V).FG := hfV_ft.out
      let _ : DecidableEq K_bar := Classical.decEq K_bar
      let S₁ : Finset K_bar := S₀ ∪ G.image φ_hom.hom
      have hS₀_S₁ : S₀ ⊆ S₁ := Finset.subset_union_left
      have hφ_mem : ∀ u : ↑A_V, φ_hom.hom u ∈ R_of S₁ := by
        intro u
        have hu_top : u ∈ Algebra.adjoin B (↑G : Set ↑A_V) := by
          rw [hG]; trivial
        exact Algebra.adjoin_induction
          (fun g hg => hMem S₁ (φ_hom.hom g)
            (Finset.mem_union_right _ (Finset.mem_image_of_mem φ_hom.hom (Finset.mem_coe.mp hg))))
          (fun b => by
            change φ_hom.hom (f_V_hom.hom b) ∈ R_of S₁
            have hb : φ_hom.hom (f_V_hom.hom b) = ι_B b := RingHom.congr_fun h_comp_ι b
            rw [hb]
            exact (ψ_of S₁ b).2)
          (fun _ _ _ _ hx hy => by rw [map_add]; exact add_mem hx hy)
          (fun _ _ _ _ hx hy => by rw [map_mul]; exact mul_mem hx hy) hu_top
      let φ_S : ↑A_V →+* ↥(R_of S₁) := φ_hom.hom.codRestrict (R_of S₁) hφ_mem
      let ξ_S : Spec (CommRingCat.of ↥(R_of S₁)) ⟶ X :=
        Spec.map (CommRingCat.ofHom φ_S) ≫ hAffV.fromSpec
      refine ⟨S₁, ξ_S, hS₀_S₁, ?_, ?_⟩
      · have hHomEq : f_V_hom ≫ CommRingCat.ofHom φ_S = CommRingCat.ofHom (ψ_of S₁) := by
          ext b
          exact RingHom.congr_fun h_comp_ι b
        dsimp only [ξ_S]
        rw [Category.assoc, ← hfV_map, ← Spec.map_comp, hHomEq]
      · have hHomEq : CommRingCat.ofHom φ_S ≫ CommRingCat.ofHom (R_of S₁).subtype = φ_hom := by
          ext u
          rfl
        dsimp only [ξ_S]
        rw [← Category.assoc, ← Spec.map_comp, hHomEq, hφ_map, hξ_aff]
    exact ⟨R_of, ψ_of, @hMono, hComp, hMem, hFT, hSecDesc⟩

  obtain ⟨R_of, ψ_of, hMono, hComp, hMem, hFT, hSecDesc⟩ := hS1

  
  let _ : DecidableEq K_bar := Classical.decEq K_bar
  let SubIdx (S₀ : Finset K_bar) : Type u := (ULiftHom.{u} {S : Finset K_bar // S₀ ⊆ S})ᵒᵖ

  have hSubIdx_hom_eq : ∀ {S₀ : Finset K_bar} {i j : SubIdx S₀} (u v : i ⟶ j), u = v :=
    fun u v => Quiver.Hom.unop_inj (ULift.ext u.unop v.unop (Subsingleton.elim _ _))

  have hIsFilteredJ : ∀ S₀ : Finset K_bar,
      IsFiltered (ULiftHom.{u} {S : Finset K_bar // S₀ ⊆ S}) := by
    intro S₀
    refine
      { cocone_objs := fun a b => by
          let a' := ULiftHom.objDown a
          let b' := ULiftHom.objDown b
          let c' : {S : Finset K_bar // S₀ ⊆ S} :=
            ⟨a'.1 ∪ b'.1, a'.2.trans Finset.subset_union_left⟩
          exact ⟨ULiftHom.objUp c',
            ULift.up (homOfLE (show a'.1 ⊆ c'.1 from Finset.subset_union_left)),
            ULift.up (homOfLE (show b'.1 ⊆ c'.1 from Finset.subset_union_right)),
            trivial⟩
        cocone_maps := fun {a b} f g =>
          ⟨b, 𝟙 b, by
            have hfg : f = g := ULift.ext f g (Subsingleton.elim _ _)
            rw [hfg]⟩
        nonempty := ⟨ULiftHom.objUp ⟨S₀, Finset.Subset.refl S₀⟩⟩ }

  have hIsCofilteredI : ∀ S₀ : Finset K_bar, IsCofiltered (SubIdx S₀) := by
    intro S₀
    have := hIsFilteredJ S₀
    exact isCofiltered_op_of_isFiltered _

  let S_of : ∀ {S₀ : Finset K_bar}, SubIdx S₀ → Finset K_bar :=
    fun i => (ULiftHom.objDown i.unop).1
  have hS₀_of : ∀ {S₀ : Finset K_bar} (i : SubIdx S₀), S₀ ⊆ S_of i :=
    fun i => (ULiftHom.objDown i.unop).2
  have hSub_hom : ∀ {S₀ : Finset K_bar} {i j : SubIdx S₀} (u : i ⟶ j), S_of j ⊆ S_of i :=
    fun u => leOfHom u.unop.down

  let baseObj : ∀ {S₀ : Finset K_bar}, SubIdx S₀ → Scheme.{u} :=
    fun i => Spec (CommRingCat.of ↥(R_of (S_of i)))
  let baseMap : ∀ {S₀ : Finset K_bar} {i j : SubIdx S₀}, (i ⟶ j) → (baseObj i ⟶ baseObj j) :=
    fun u => Spec.map (CommRingCat.ofHom (Subring.inclusion (hMono (hSub_hom u))))
  let baseπ : ∀ {S₀ : Finset K_bar} (i : SubIdx S₀),
      Spec (CommRingCat.of K_bar) ⟶ baseObj i :=
    fun i => Spec.map (CommRingCat.ofHom (R_of (S_of i)).subtype)

  have hBaseMap_id : ∀ {S₀ : Finset K_bar} (i : SubIdx S₀), baseMap (𝟙 i) = 𝟙 (baseObj i) := by
    intro S₀ i
    dsimp only [baseMap, baseObj]
    have hEq : CommRingCat.ofHom (Subring.inclusion (hMono (hSub_hom (𝟙 i)))) =
        𝟙 (CommRingCat.of ↥(R_of (S_of i))) := by
      ext x; rfl
    rw [hEq, Spec.map_id]

  have hBaseMap_comp : ∀ {S₀ : Finset K_bar} {i j k : SubIdx S₀} (u : i ⟶ j) (v : j ⟶ k),
      baseMap (u ≫ v) = baseMap u ≫ baseMap v := by
    intro S₀ i j k u v
    dsimp only [baseMap]
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

  have hBaseπ_map : ∀ {S₀ : Finset K_bar} {i j : SubIdx S₀} (u : i ⟶ j),
      baseπ i ≫ baseMap u = baseπ j := by
    intro S₀ i j u
    dsimp only [baseπ, baseMap]
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

  have hBaseUniv : ∀ (S₀ : Finset K_bar) (Z_pt : Scheme.{u})
      (m : ∀ i : SubIdx S₀, Z_pt ⟶ baseObj i),
      (∀ {i j : SubIdx S₀} (u : i ⟶ j), m i ≫ baseMap u = m j) →
      ∃! (m_K : Z_pt ⟶ Spec (CommRingCat.of K_bar)),
        ∀ i : SubIdx S₀, m_K ≫ baseπ i = m i := by
    intro S₀ Z_pt m hm
    let R_Z : CommRingCat.{u} := Γ(Z_pt, ⊤)
    let α : ∀ i : SubIdx S₀, CommRingCat.of ↥(R_of (S_of i)) ⟶ R_Z :=
      fun i => homToSpecToRing (m i)
    have hα_compat : ∀ {i j : SubIdx S₀} (u : i ⟶ j) (y : K_bar) (hy : y ∈ R_of (S_of j)),
        (α i).hom ⟨y, hMono (hSub_hom u) hy⟩ = (α j).hom ⟨y, hy⟩ := by
      intro i j u y hy
      have hEq : CommRingCat.ofHom (Subring.inclusion (hMono (hSub_hom u))) ≫ α i = α j := by
        dsimp only [α]
        rw [← homToSpecToRing_comp_specMap, hm u]
      exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hEq) ⟨y, hy⟩
    let mkIdx : ∀ (S : Finset K_bar), S₀ ⊆ S → SubIdx S₀ :=
      fun S hS => Opposite.op (ULiftHom.objUp ⟨S, hS⟩)
    let idxX : K_bar → SubIdx S₀ :=
      fun x => mkIdx (insert x S₀) (Finset.subset_insert x S₀)
    have hx_mem : ∀ x : K_bar, x ∈ R_of (S_of (idxX x)) :=
      fun x => hMem (insert x S₀) x (Finset.mem_insert_self x S₀)
    let φ_fun : K_bar → ↑R_Z := fun x => (α (idxX x)).hom ⟨x, hx_mem x⟩
    have hIndep : ∀ (i : SubIdx S₀) (x : K_bar) (hx : x ∈ R_of (S_of i)),
        (α i).hom ⟨x, hx⟩ = φ_fun x := by
      intro i x hx
      let i_cup : SubIdx S₀ :=
        mkIdx (S_of i ∪ S_of (idxX x)) ((hS₀_of i).trans Finset.subset_union_left)
      let u₁ : i_cup ⟶ i :=
        Quiver.Hom.op (ULift.up (homOfLE (show S_of i ⊆ S_of i_cup from Finset.subset_union_left)))
      let u₂ : i_cup ⟶ idxX x :=
        Quiver.Hom.op (ULift.up (homOfLE (show S_of (idxX x) ⊆ S_of i_cup from Finset.subset_union_right)))
      exact (hα_compat u₁ x hx).symm.trans (hα_compat u₂ x (hx_mem x))
    let i_bot : SubIdx S₀ := mkIdx S₀ (Finset.Subset.refl S₀)
    let φ_K : K_bar →+* ↑R_Z :=
      { toFun := φ_fun
        map_zero' := by
          rw [← hIndep i_bot 0 (R_of (S_of i_bot)).zero_mem]
          exact map_zero (α i_bot).hom
        map_one' := by
          rw [← hIndep i_bot 1 (R_of (S_of i_bot)).one_mem]
          exact map_one (α i_bot).hom
        map_add' := fun x y => by
          let S_xy : Finset K_bar := insert x (insert y S₀)
          let i_xy : SubIdx S₀ := mkIdx S_xy
            ((Finset.subset_insert y S₀).trans (Finset.subset_insert x _))
          have hx' : x ∈ R_of (S_of i_xy) := hMem S_xy x (Finset.mem_insert_self x _)
          have hy' : y ∈ R_of (S_of i_xy) :=
            hMem S_xy y (Finset.mem_insert_of_mem (Finset.mem_insert_self y S₀))
          rw [← hIndep i_xy x hx', ← hIndep i_xy y hy',
            ← hIndep i_xy (x + y) (add_mem hx' hy')]
          exact map_add (α i_xy).hom ⟨x, hx'⟩ ⟨y, hy'⟩
        map_mul' := fun x y => by
          let S_xy : Finset K_bar := insert x (insert y S₀)
          let i_xy : SubIdx S₀ := mkIdx S_xy
            ((Finset.subset_insert y S₀).trans (Finset.subset_insert x _))
          have hx' : x ∈ R_of (S_of i_xy) := hMem S_xy x (Finset.mem_insert_self x _)
          have hy' : y ∈ R_of (S_of i_xy) :=
            hMem S_xy y (Finset.mem_insert_of_mem (Finset.mem_insert_self y S₀))
          rw [← hIndep i_xy x hx', ← hIndep i_xy y hy',
            ← hIndep i_xy (x * y) (mul_mem hx' hy')]
          exact map_mul (α i_xy).hom ⟨x, hx'⟩ ⟨y, hy'⟩ }
    let m_K : Z_pt ⟶ Spec (CommRingCat.of K_bar) := homToSpecFromRing (CommRingCat.ofHom φ_K)
    refine ⟨m_K, ?_, ?_⟩
    · intro i
      have hRingEq : homToSpecToRing (m_K ≫ baseπ i) = homToSpecToRing (m i) := by
        rw [homToSpecToRing_comp_specMap]
        dsimp only [m_K]
        rw [homToSpec_to_from]
        ext z
        exact (hIndep i z.1 z.2).symm
      rw [← homToSpec_from_to (m_K ≫ baseπ i), hRingEq, homToSpec_from_to]
    · intro m'_K hm'_K
      have hRingEq : homToSpecToRing m'_K = CommRingCat.ofHom φ_K := by
        ext x
        have h_ix : CommRingCat.ofHom (R_of (S_of (idxX x))).subtype ≫ homToSpecToRing m'_K =
            α (idxX x) := by
          rw [← homToSpecToRing_comp_specMap, hm'_K (idxX x)]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom h_ix) ⟨x, hx_mem x⟩
      rw [← homToSpec_from_to m'_K, hRingEq]

  let pbDiag : ∀ (S₀ : Finset K_bar) {A₀ : CommRingCat.{u}} {W : Scheme.{u}}
      (g : W ⟶ Spec A₀) (f_base : ∀ i : SubIdx S₀, baseObj i ⟶ Spec A₀),
      (∀ {i j : SubIdx S₀} (u : i ⟶ j), baseMap u ≫ f_base j = f_base i) →
      (SubIdx S₀ ⥤ Scheme.{u}) :=
    fun S₀ {A₀} {W} g f_base hf_map =>
      { obj := fun i => Limits.pullback g (f_base i)
        map := fun {i j} u => Limits.pullback.lift
          (Limits.pullback.fst g (f_base i))
          (Limits.pullback.snd g (f_base i) ≫ baseMap u)
          (by rw [Category.assoc, hf_map u, Limits.pullback.condition])
        map_id := by
          intro i
          apply Limits.pullback.hom_ext
          · simp only [Limits.pullback.lift_fst, Category.id_comp]
          · simp only [Limits.pullback.lift_snd, hBaseMap_id, Category.comp_id, Category.id_comp]
        map_comp := by
          intro i j k u v
          apply Limits.pullback.hom_ext
          · simp only [Category.assoc, Limits.pullback.lift_fst]
          · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
              hBaseMap_comp] }

  let pbCone : ∀ (S₀ : Finset K_bar) {A₀ : CommRingCat.{u}} {W : Scheme.{u}}
      (g : W ⟶ Spec A₀) (f_base : ∀ i : SubIdx S₀, baseObj i ⟶ Spec A₀)
      (s_gen : Spec (CommRingCat.of K_bar) ⟶ Spec A₀)
      (hf_map : ∀ {i j : SubIdx S₀} (u : i ⟶ j), baseMap u ≫ f_base j = f_base i),
      (∀ i : SubIdx S₀, baseπ i ≫ f_base i = s_gen) →
      Limits.Cone (pbDiag S₀ g f_base hf_map) :=
    fun S₀ {A₀} {W} g f_base s_gen hf_map hf_π =>
      { pt := Limits.pullback g s_gen
        π :=
          { app := fun i => Limits.pullback.lift
              (Limits.pullback.fst g s_gen)
              (Limits.pullback.snd g s_gen ≫ baseπ i)
              (by rw [Category.assoc, hf_π i, Limits.pullback.condition])
            naturality := by
              intro i j u
              dsimp only [pbDiag, Functor.const_obj_obj, Functor.const_obj_map]
              rw [Category.id_comp]
              apply Limits.pullback.hom_ext
              · simp only [Category.assoc, Limits.pullback.lift_fst]
              · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
                  hBaseπ_map u] } }

  have hPullbackLimit : ∀ (S₀ : Finset K_bar)
      {A₀ : CommRingCat.{u}} {W : Scheme.{u}} (g : W ⟶ Spec A₀)
      (f_base : ∀ i : SubIdx S₀, baseObj i ⟶ Spec A₀)
      (s_gen : Spec (CommRingCat.of K_bar) ⟶ Spec A₀)
      (hf_map : ∀ {i j : SubIdx S₀} (u : i ⟶ j), baseMap u ≫ f_base j = f_base i)
      (hf_π : ∀ i : SubIdx S₀, baseπ i ≫ f_base i = s_gen),
      Nonempty (Limits.IsLimit (pbCone S₀ g f_base s_gen hf_map hf_π)) ∧
      (∀ {i j : SubIdx S₀} (u : i ⟶ j),
        IsAffineHom ((pbDiag S₀ g f_base hf_map).map u)) := by
    intro S₀ A₀ W g f_base s_gen hf_map hf_π
    let D := pbDiag S₀ g f_base hf_map
    let c := pbCone S₀ g f_base s_gen hf_map hf_π
    let i_bot : SubIdx S₀ := Opposite.op (ULiftHom.objUp ⟨S₀, Finset.Subset.refl S₀⟩)
    let u_bot : ∀ i : SubIdx S₀, i ⟶ i_bot :=
      fun i => Quiver.Hom.op (ULift.up (homOfLE (hS₀_of i)))
    have hm_s_compat : ∀ (s : Limits.Cone D) {i j : SubIdx S₀} (u : i ⟶ j),
        (s.π.app i ≫ Limits.pullback.snd g (f_base i)) ≫ baseMap u =
        s.π.app j ≫ Limits.pullback.snd g (f_base j) := by
      intro s i j u
      have hw := congrArg (· ≫ Limits.pullback.snd g (f_base j)) (s.w u)
      dsimp only [D, pbDiag] at hw
      rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc] at hw
      exact hw
    have hLim : Limits.IsLimit c :=
      { lift := fun s =>
          Limits.pullback.lift
            (s.π.app i_bot ≫ Limits.pullback.fst g (f_base i_bot))
            (Classical.choose (hBaseUniv S₀ s.pt
              (fun i => s.π.app i ≫ Limits.pullback.snd g (f_base i)) (hm_s_compat s)))
            (by
              have hmK := (Classical.choose_spec (hBaseUniv S₀ s.pt
                (fun i => s.π.app i ≫ Limits.pullback.snd g (f_base i)) (hm_s_compat s))).1 i_bot
              rw [Category.assoc, Limits.pullback.condition, ← Category.assoc,
                ← hf_π i_bot, ← Category.assoc, hmK])
        fac := by
          intro s i
          have hmK := (Classical.choose_spec (hBaseUniv S₀ s.pt
            (fun k => s.π.app k ≫ Limits.pullback.snd g (f_base k)) (hm_s_compat s))).1 i
          have hFstEq : s.π.app i_bot ≫ Limits.pullback.fst g (f_base i_bot) =
              s.π.app i ≫ Limits.pullback.fst g (f_base i) := by
            rw [← s.w (u_bot i), Category.assoc]
            dsimp only [D, pbDiag]
            rw [Limits.pullback.lift_fst]
          dsimp only [c, pbCone, D, pbDiag]
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst, hFstEq]
          · rw [Category.assoc, Limits.pullback.lift_snd,
              ← Category.assoc, Limits.pullback.lift_snd, hmK]
        uniq := by
          intro s ℓ hℓ
          have hUniq := (Classical.choose_spec (hBaseUniv S₀ s.pt
            (fun k => s.π.app k ≫ Limits.pullback.snd g (f_base k)) (hm_s_compat s))).2
          apply Limits.pullback.hom_ext
          · rw [Limits.pullback.lift_fst]
            have h_bot := congrArg (· ≫ Limits.pullback.fst g (f_base i_bot)) (hℓ i_bot)
            dsimp only [c, pbCone, D, pbDiag] at h_bot
            rw [Category.assoc, Limits.pullback.lift_fst] at h_bot
            exact h_bot
          · rw [Limits.pullback.lift_snd]
            refine hUniq (ℓ ≫ Limits.pullback.snd g s_gen) fun i => ?_
            have h_i := congrArg (· ≫ Limits.pullback.snd g (f_base i)) (hℓ i)
            dsimp only [c, pbCone, D, pbDiag] at h_i
            rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc] at h_i
            exact h_i }
    refine ⟨⟨hLim⟩, ?_⟩
    intro i j u
    have hPb : IsPullback (D.map u)
        (Limits.pullback.snd g (f_base i))
        (Limits.pullback.snd g (f_base j))
        (baseMap u) := by
      refine IsPullback.of_right ?_ ?_ (IsPullback.of_hasPullback g (f_base j))
      · dsimp only [D, pbDiag]
        rw [Limits.pullback.lift_fst, hf_map u]
        exact IsPullback.of_hasPullback g (f_base i)
      · dsimp only [D, pbDiag]
        exact Limits.pullback.lift_snd _ _ _
    exact MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip inferInstance

  
  refine ⟨R_of, ψ_of, @hMono, hComp, hFT, hSecDesc, ?_, ?_⟩
  · 
    intro X Y f_X f_Y _ _ _ _ S₀ e_K he_K
    have : IsCofiltered (SubIdx S₀) := hIsCofilteredI S₀
    let f_base : ∀ i : SubIdx S₀, baseObj i ⟶ Spec (CommRingCat.of B) :=
      fun i => Spec.map (CommRingCat.ofHom (ψ_of (S_of i)))
    let s_gen : Spec (CommRingCat.of K_bar) ⟶ Spec (CommRingCat.of B) :=
      Spec.map (CommRingCat.ofHom ι_B)
    have hf_map : ∀ {i j : SubIdx S₀} (u : i ⟶ j), baseMap u ≫ f_base j = f_base i := by
      intro i j u
      dsimp only [baseMap, f_base]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      apply congrArg Spec.map
      apply congrArg CommRingCat.ofHom
      ext b
      exact (RingHom.congr_fun (hComp (S_of j)) b).trans (RingHom.congr_fun (hComp (S_of i)) b).symm
    have hf_π : ∀ i : SubIdx S₀, baseπ i ≫ f_base i = s_gen := by
      intro i
      dsimp only [baseπ, f_base, s_gen]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hComp (S_of i)]

    let D_X := pbDiag S₀ f_X f_base (@hf_map)
    let c_X := pbCone S₀ f_X f_base s_gen (@hf_map) hf_π
    obtain ⟨⟨hc_X⟩, hAff_X⟩ := hPullbackLimit S₀ f_X f_base s_gen (@hf_map) hf_π

    let D_Y := pbDiag S₀ f_Y f_base (@hf_map)
    let c_Y := pbCone S₀ f_Y f_base s_gen (@hf_map) hf_π
    obtain ⟨⟨hc_Y⟩, hAff_Y⟩ := hPullbackLimit S₀ f_Y f_base s_gen (@hf_map) hf_π

    have hComp_X : ∀ i : SubIdx S₀, CompactSpace ↥(D_X.obj i) :=
      fun i => (quasiCompact_iff_compactSpace (Limits.pullback.snd f_X (f_base i))).mp inferInstance
    have hQS_X : ∀ i : SubIdx S₀, QuasiSeparatedSpace ↥(D_X.obj i) :=
      fun i => (quasiSeparated_iff_quasiSeparatedSpace (Limits.pullback.snd f_X (f_base i))).mp inferInstance
    have hComp_Y : ∀ i : SubIdx S₀, CompactSpace ↥(D_Y.obj i) :=
      fun i => (quasiCompact_iff_compactSpace (Limits.pullback.snd f_Y (f_base i))).mp inferInstance
    have hQS_Y : ∀ i : SubIdx S₀, QuasiSeparatedSpace ↥(D_Y.obj i) :=
      fun i => (quasiSeparated_iff_quasiSeparatedSpace (Limits.pullback.snd f_Y (f_base i))).mp inferInstance

    let t_X : D_X ⟶ (Functor.const (SubIdx S₀)).obj (Spec (CommRingCat.of B)) :=
      { app := fun i => Limits.pullback.snd f_X (f_base i) ≫ f_base i
        naturality := by
          intro i j u
          dsimp only [D_X, pbDiag, Functor.const_obj_obj, Functor.const_obj_map]
          rw [Category.comp_id, ← Category.assoc, Limits.pullback.lift_snd,
            Category.assoc, hf_map u] }
    let t_Y : D_Y ⟶ (Functor.const (SubIdx S₀)).obj (Spec (CommRingCat.of B)) :=
      { app := fun i => Limits.pullback.snd f_Y (f_base i) ≫ f_base i
        naturality := by
          intro i j u
          dsimp only [D_Y, pbDiag, Functor.const_obj_obj, Functor.const_obj_map]
          rw [Category.comp_id, ← Category.assoc, Limits.pullback.lift_snd,
            Category.assoc, hf_map u] }

    have he_K_inv : e_K.inv ≫ Limits.pullback.snd f_X s_gen = Limits.pullback.snd f_Y s_gen := by
      rw [← he_K, e_K.inv_hom_id_assoc]

    obtain ⟨u₁, φ₁, hφ₁_f, hφ₁_c⟩ :=
      @hHomDesc (SubIdx S₀) _ _ D_X _ t_X Y f_Y c_X hc_X hComp_X hQS_X (@hAff_X) _
        (e_K.hom ≫ Limits.pullback.fst f_Y s_gen) (by
          intro i
          dsimp only [c_X, pbCone, t_X]
          rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, he_K,
            ← Category.assoc, Limits.pullback.lift_snd, Category.assoc, hf_π i])

    obtain ⟨u₂, ψ₂, hψ₂_f, hψ₂_c⟩ :=
      @hHomDesc (SubIdx S₀) _ _ D_Y _ t_Y X f_X c_Y hc_Y hComp_Y hQS_Y (@hAff_Y) _
        (e_K.inv ≫ Limits.pullback.fst f_X s_gen) (by
          intro i
          dsimp only [c_Y, pbCone, t_Y]
          rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, he_K_inv,
            ← Category.assoc, Limits.pullback.lift_snd, Category.assoc, hf_π i])

    let u₃ : SubIdx S₀ := IsCofiltered.min u₁ u₂
    let v₁ : u₃ ⟶ u₁ := IsCofiltered.minToLeft u₁ u₂
    let v₂ : u₃ ⟶ u₂ := IsCofiltered.minToRight u₁ u₂

    let Φ : ∀ {u : SubIdx S₀}, (u ⟶ u₃) → (D_X.obj u ⟶ D_Y.obj u) :=
      fun {u} w => Limits.pullback.lift
        (D_X.map (w ≫ v₁) ≫ φ₁)
        (Limits.pullback.snd f_X (f_base u))
        (by
          rw [Category.assoc, hφ₁_f]
          have h := t_X.naturality (w ≫ v₁)
          simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id] at h
          exact h)

    let Ψ : ∀ {u : SubIdx S₀}, (u ⟶ u₃) → (D_Y.obj u ⟶ D_X.obj u) :=
      fun {u} w => Limits.pullback.lift
        (D_Y.map (w ≫ v₂) ≫ ψ₂)
        (Limits.pullback.snd f_Y (f_base u))
        (by
          rw [Category.assoc, hψ₂_f]
          have h := t_Y.naturality (w ≫ v₂)
          simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id] at h
          exact h)

    have hΦ_map : ∀ {u : SubIdx S₀} (w : u ⟶ u₃),
        Φ w ≫ D_Y.map w = D_X.map w ≫ Φ (𝟙 u₃) := by
      intro u w
      apply Limits.pullback.hom_ext
      · calc
          (Φ w ≫ D_Y.map w) ≫ Limits.pullback.fst f_Y (f_base u₃)
            = Φ w ≫ (D_Y.map w ≫ Limits.pullback.fst f_Y (f_base u₃)) := by rw [Category.assoc]
          _ = Φ w ≫ Limits.pullback.fst f_Y (f_base u) := by
                dsimp only [D_Y, pbDiag]; rw [Limits.pullback.lift_fst]
          _ = D_X.map (w ≫ v₁) ≫ φ₁ := Limits.pullback.lift_fst _ _ _
          _ = D_X.map w ≫ D_X.map (𝟙 u₃ ≫ v₁) ≫ φ₁ := by
                rw [Category.id_comp, D_X.map_comp, Category.assoc]
          _ = D_X.map w ≫ (Φ (𝟙 u₃) ≫ Limits.pullback.fst f_Y (f_base u₃)) := by
                dsimp only [Φ]; rw [Limits.pullback.lift_fst]
          _ = (D_X.map w ≫ Φ (𝟙 u₃)) ≫ Limits.pullback.fst f_Y (f_base u₃) := by
                rw [← Category.assoc]
      · calc
          (Φ w ≫ D_Y.map w) ≫ Limits.pullback.snd f_Y (f_base u₃)
            = Φ w ≫ (D_Y.map w ≫ Limits.pullback.snd f_Y (f_base u₃)) := by rw [Category.assoc]
          _ = (Φ w ≫ Limits.pullback.snd f_Y (f_base u)) ≫ baseMap w := by
                dsimp only [D_Y, pbDiag]; rw [Limits.pullback.lift_snd, Category.assoc]
          _ = Limits.pullback.snd f_X (f_base u) ≫ baseMap w := by
                dsimp only [Φ]; rw [Limits.pullback.lift_snd]
          _ = D_X.map w ≫ Limits.pullback.snd f_X (f_base u₃) := by
                dsimp only [D_X, pbDiag]; rw [Limits.pullback.lift_snd]
          _ = D_X.map w ≫ (Φ (𝟙 u₃) ≫ Limits.pullback.snd f_Y (f_base u₃)) := by
                have hs : Φ (𝟙 u₃) ≫ Limits.pullback.snd f_Y (f_base u₃) =
                    Limits.pullback.snd f_X (f_base u₃) := Limits.pullback.lift_snd _ _ _
                rw [hs]
          _ = (D_X.map w ≫ Φ (𝟙 u₃)) ≫ Limits.pullback.snd f_Y (f_base u₃) := by
                rw [← Category.assoc]

    have hΨ_map : ∀ {u : SubIdx S₀} (w : u ⟶ u₃),
        Ψ w ≫ D_X.map w = D_Y.map w ≫ Ψ (𝟙 u₃) := by
      intro u w
      apply Limits.pullback.hom_ext
      · calc
          (Ψ w ≫ D_X.map w) ≫ Limits.pullback.fst f_X (f_base u₃)
            = Ψ w ≫ (D_X.map w ≫ Limits.pullback.fst f_X (f_base u₃)) := by rw [Category.assoc]
          _ = Ψ w ≫ Limits.pullback.fst f_X (f_base u) := by
                dsimp only [D_X, pbDiag]; rw [Limits.pullback.lift_fst]
          _ = D_Y.map (w ≫ v₂) ≫ ψ₂ := Limits.pullback.lift_fst _ _ _
          _ = D_Y.map w ≫ D_Y.map (𝟙 u₃ ≫ v₂) ≫ ψ₂ := by
                rw [Category.id_comp, D_Y.map_comp, Category.assoc]
          _ = D_Y.map w ≫ (Ψ (𝟙 u₃) ≫ Limits.pullback.fst f_X (f_base u₃)) := by
                dsimp only [Ψ]; rw [Limits.pullback.lift_fst]
          _ = (D_Y.map w ≫ Ψ (𝟙 u₃)) ≫ Limits.pullback.fst f_X (f_base u₃) := by
                rw [← Category.assoc]
      · calc
          (Ψ w ≫ D_X.map w) ≫ Limits.pullback.snd f_X (f_base u₃)
            = Ψ w ≫ (D_X.map w ≫ Limits.pullback.snd f_X (f_base u₃)) := by rw [Category.assoc]
          _ = (Ψ w ≫ Limits.pullback.snd f_X (f_base u)) ≫ baseMap w := by
                dsimp only [D_X, pbDiag]; rw [Limits.pullback.lift_snd, Category.assoc]
          _ = Limits.pullback.snd f_Y (f_base u) ≫ baseMap w := by
                dsimp only [Ψ]; rw [Limits.pullback.lift_snd]
          _ = D_Y.map w ≫ Limits.pullback.snd f_Y (f_base u₃) := by
                dsimp only [D_Y, pbDiag]; rw [Limits.pullback.lift_snd]
          _ = D_Y.map w ≫ (Ψ (𝟙 u₃) ≫ Limits.pullback.snd f_X (f_base u₃)) := by
                have hs : Ψ (𝟙 u₃) ≫ Limits.pullback.snd f_X (f_base u₃) =
                    Limits.pullback.snd f_Y (f_base u₃) := Limits.pullback.lift_snd _ _ _
                rw [hs]
          _ = (D_Y.map w ≫ Ψ (𝟙 u₃)) ≫ Limits.pullback.snd f_X (f_base u₃) := by
                rw [← Category.assoc]

    have hΦ_cone : ∀ {u : SubIdx S₀} (w : u ⟶ u₃),
        c_X.π.app u ≫ Φ w = e_K.hom ≫ c_Y.π.app u := by
      intro u w
      apply Limits.pullback.hom_ext
      · rw [Category.assoc]
        have h1 : Φ w ≫ Limits.pullback.fst f_Y (f_base u) = D_X.map (w ≫ v₁) ≫ φ₁ :=
          Limits.pullback.lift_fst _ _ _
        have h2 : c_Y.π.app u ≫ Limits.pullback.fst f_Y (f_base u) =
            Limits.pullback.fst f_Y s_gen := Limits.pullback.lift_fst _ _ _
        rw [h1, ← Category.assoc, c_X.w (w ≫ v₁), hφ₁_c, Category.assoc, h2]
      · rw [Category.assoc]
        have h1 : Φ w ≫ Limits.pullback.snd f_Y (f_base u) =
            Limits.pullback.snd f_X (f_base u) := Limits.pullback.lift_snd _ _ _
        have h2 : c_X.π.app u ≫ Limits.pullback.snd f_X (f_base u) =
            Limits.pullback.snd f_X s_gen ≫ baseπ u := Limits.pullback.lift_snd _ _ _
        have h3 : c_Y.π.app u ≫ Limits.pullback.snd f_Y (f_base u) =
            Limits.pullback.snd f_Y s_gen ≫ baseπ u := Limits.pullback.lift_snd _ _ _
        rw [h1, h2, Category.assoc, h3, ← Category.assoc, he_K]

    have hΨ_cone : ∀ {u : SubIdx S₀} (w : u ⟶ u₃),
        c_Y.π.app u ≫ Ψ w = e_K.inv ≫ c_X.π.app u := by
      intro u w
      apply Limits.pullback.hom_ext
      · rw [Category.assoc]
        have h1 : Ψ w ≫ Limits.pullback.fst f_X (f_base u) = D_Y.map (w ≫ v₂) ≫ ψ₂ :=
          Limits.pullback.lift_fst _ _ _
        have h2 : c_X.π.app u ≫ Limits.pullback.fst f_X (f_base u) =
            Limits.pullback.fst f_X s_gen := Limits.pullback.lift_fst _ _ _
        rw [h1, ← Category.assoc, c_Y.w (w ≫ v₂), hψ₂_c, Category.assoc, h2]
      · rw [Category.assoc]
        have h1 : Ψ w ≫ Limits.pullback.snd f_X (f_base u) =
            Limits.pullback.snd f_Y (f_base u) := Limits.pullback.lift_snd _ _ _
        have h2 : c_Y.π.app u ≫ Limits.pullback.snd f_Y (f_base u) =
            Limits.pullback.snd f_Y s_gen ≫ baseπ u := Limits.pullback.lift_snd _ _ _
        have h3 : c_X.π.app u ≫ Limits.pullback.snd f_X (f_base u) =
            Limits.pullback.snd f_X s_gen ≫ baseπ u := Limits.pullback.lift_snd _ _ _
        rw [h1, h2, Category.assoc, h3, ← Category.assoc, he_K_inv]

    obtain ⟨u_X, w_X, hw_X⟩ :=
      @Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType
        (SubIdx S₀) _ _ X D_X t_X f_X c_X hc_X hComp_X inferInstance _ (@hAff_X)
        u₃ ((Φ (𝟙 u₃) ≫ Ψ (𝟙 u₃)) ≫ Limits.pullback.fst f_X (f_base u₃))
        (Limits.pullback.fst f_X (f_base u₃))
        (by
          have hsΨ : Ψ (𝟙 u₃) ≫ Limits.pullback.snd f_X (f_base u₃) =
              Limits.pullback.snd f_Y (f_base u₃) := Limits.pullback.lift_snd _ _ _
          have hsΦ : Φ (𝟙 u₃) ≫ Limits.pullback.snd f_Y (f_base u₃) =
              Limits.pullback.snd f_X (f_base u₃) := Limits.pullback.lift_snd _ _ _
          change Limits.pullback.snd f_X (f_base u₃) ≫ f_base u₃ =
            ((Φ (𝟙 u₃) ≫ Ψ (𝟙 u₃)) ≫ Limits.pullback.fst f_X (f_base u₃)) ≫ f_X
          rw [Category.assoc, Category.assoc, Limits.pullback.condition,
            ← Category.assoc (Ψ (𝟙 u₃)), hsΨ, ← Category.assoc, hsΦ])
        (by dsimp only [t_X]; exact Limits.pullback.condition.symm)
        (by
          rw [← Category.assoc, ← Category.assoc, hΦ_cone (𝟙 u₃),
            Category.assoc e_K.hom, hΨ_cone (𝟙 u₃), ← Category.assoc,
            e_K.hom_inv_id, Category.id_comp])

    obtain ⟨u_Y, w_Y, hw_Y⟩ :=
      @Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType
        (SubIdx S₀) _ _ Y D_Y t_Y f_Y c_Y hc_Y hComp_Y inferInstance _ (@hAff_Y)
        u₃ ((Ψ (𝟙 u₃) ≫ Φ (𝟙 u₃)) ≫ Limits.pullback.fst f_Y (f_base u₃))
        (Limits.pullback.fst f_Y (f_base u₃))
        (by
          have hsΦ : Φ (𝟙 u₃) ≫ Limits.pullback.snd f_Y (f_base u₃) =
              Limits.pullback.snd f_X (f_base u₃) := Limits.pullback.lift_snd _ _ _
          have hsΨ : Ψ (𝟙 u₃) ≫ Limits.pullback.snd f_X (f_base u₃) =
              Limits.pullback.snd f_Y (f_base u₃) := Limits.pullback.lift_snd _ _ _
          change Limits.pullback.snd f_Y (f_base u₃) ≫ f_base u₃ =
            ((Ψ (𝟙 u₃) ≫ Φ (𝟙 u₃)) ≫ Limits.pullback.fst f_Y (f_base u₃)) ≫ f_Y
          rw [Category.assoc, Category.assoc, Limits.pullback.condition,
            ← Category.assoc (Φ (𝟙 u₃)), hsΦ, ← Category.assoc, hsΨ])
        (by dsimp only [t_Y]; exact Limits.pullback.condition.symm)
        (by
          rw [← Category.assoc, ← Category.assoc, hΨ_cone (𝟙 u₃),
            Category.assoc e_K.inv, hΦ_cone (𝟙 u₃), ← Category.assoc,
            e_K.inv_hom_id, Category.id_comp])

    let u_star : SubIdx S₀ := IsCofiltered.min u_X u_Y
    let z_X : u_star ⟶ u_X := IsCofiltered.minToLeft u_X u_Y
    let z_Y : u_star ⟶ u_Y := IsCofiltered.minToRight u_X u_Y
    let w_star : u_star ⟶ u₃ := z_X ≫ w_X
    have hw_star_Y : w_star = z_Y ≫ w_Y := hSubIdx_hom_eq _ _

    refine ⟨S_of u_star,
      { hom := Φ w_star
        inv := Ψ w_star
        hom_inv_id := by
          apply Limits.pullback.hom_ext
          · have h1 : Ψ w_star ≫ Limits.pullback.fst f_X (f_base u_star) =
                D_Y.map w_star ≫ Ψ (𝟙 u₃) ≫ Limits.pullback.fst f_X (f_base u₃) := by
              have ha : Ψ w_star ≫ Limits.pullback.fst f_X (f_base u_star) =
                  D_Y.map (w_star ≫ v₂) ≫ ψ₂ := Limits.pullback.lift_fst _ _ _
              have hb : Ψ (𝟙 u₃) ≫ Limits.pullback.fst f_X (f_base u₃) =
                  D_Y.map (𝟙 u₃ ≫ v₂) ≫ ψ₂ := Limits.pullback.lift_fst _ _ _
              rw [ha, hb, Category.id_comp, D_Y.map_comp, Category.assoc]
            rw [Category.id_comp, Category.assoc, h1, ← Category.assoc, hΦ_map w_star]
            dsimp only [w_star]
            rw [D_X.map_comp, Category.assoc, Category.assoc,
              show Φ (𝟙 u₃) ≫ Ψ (𝟙 u₃) ≫ Limits.pullback.fst f_X (f_base u₃) =
                (Φ (𝟙 u₃) ≫ Ψ (𝟙 u₃)) ≫ Limits.pullback.fst f_X (f_base u₃) from
                (Category.assoc _ _ _).symm,
              hw_X, ← Category.assoc, ← D_X.map_comp]
            dsimp only [D_X, pbDiag]
            rw [Limits.pullback.lift_fst]
          · have hsΨ : Ψ w_star ≫ Limits.pullback.snd f_X (f_base u_star) =
                Limits.pullback.snd f_Y (f_base u_star) := Limits.pullback.lift_snd _ _ _
            have hsΦ : Φ w_star ≫ Limits.pullback.snd f_Y (f_base u_star) =
                Limits.pullback.snd f_X (f_base u_star) := Limits.pullback.lift_snd _ _ _
            rw [Category.assoc, hsΨ, hsΦ, Category.id_comp]
        inv_hom_id := by
          apply Limits.pullback.hom_ext
          · have h1 : Φ w_star ≫ Limits.pullback.fst f_Y (f_base u_star) =
                D_X.map w_star ≫ Φ (𝟙 u₃) ≫ Limits.pullback.fst f_Y (f_base u₃) := by
              have ha : Φ w_star ≫ Limits.pullback.fst f_Y (f_base u_star) =
                  D_X.map (w_star ≫ v₁) ≫ φ₁ := Limits.pullback.lift_fst _ _ _
              have hb : Φ (𝟙 u₃) ≫ Limits.pullback.fst f_Y (f_base u₃) =
                  D_X.map (𝟙 u₃ ≫ v₁) ≫ φ₁ := Limits.pullback.lift_fst _ _ _
              rw [ha, hb, Category.id_comp, D_X.map_comp, Category.assoc]
            rw [Category.id_comp, Category.assoc, h1, ← Category.assoc, hΨ_map w_star, hw_star_Y,
              D_Y.map_comp, Category.assoc, Category.assoc,
              show Ψ (𝟙 u₃) ≫ Φ (𝟙 u₃) ≫ Limits.pullback.fst f_Y (f_base u₃) =
                (Ψ (𝟙 u₃) ≫ Φ (𝟙 u₃)) ≫ Limits.pullback.fst f_Y (f_base u₃) from
                (Category.assoc _ _ _).symm,
              hw_Y, ← Category.assoc, ← D_Y.map_comp]
            dsimp only [D_Y, pbDiag]
            rw [Limits.pullback.lift_fst]
          · have hsΦ : Φ w_star ≫ Limits.pullback.snd f_Y (f_base u_star) =
                Limits.pullback.snd f_X (f_base u_star) := Limits.pullback.lift_snd _ _ _
            have hsΨ : Ψ w_star ≫ Limits.pullback.snd f_X (f_base u_star) =
                Limits.pullback.snd f_Y (f_base u_star) := Limits.pullback.lift_snd _ _ _
            rw [Category.assoc, hsΦ, hsΨ, Category.id_comp] },
      hS₀_of u_star, ?_⟩
    exact Limits.pullback.lift_snd _ _ _

  · 
    intro S₀ Z q _ hEmp
    have : IsCofiltered (SubIdx S₀) := hIsCofilteredI S₀
    let f_base : ∀ i : SubIdx S₀, baseObj i ⟶ Spec (CommRingCat.of ↥(R_of S₀)) :=
      fun i => Spec.map (CommRingCat.ofHom (Subring.inclusion (hMono (hS₀_of i))))
    let s_gen : Spec (CommRingCat.of K_bar) ⟶ Spec (CommRingCat.of ↥(R_of S₀)) :=
      Spec.map (CommRingCat.ofHom (R_of S₀).subtype)
    have hf_map : ∀ {i j : SubIdx S₀} (u : i ⟶ j), baseMap u ≫ f_base j = f_base i := by
      intro i j u
      dsimp only [baseMap, f_base]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    have hf_π : ∀ i : SubIdx S₀, baseπ i ≫ f_base i = s_gen := by
      intro i
      dsimp only [baseπ, f_base, s_gen]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    let D_Z := pbDiag S₀ q f_base (@hf_map)
    let c_Z := pbCone S₀ q f_base s_gen (@hf_map) hf_π
    obtain ⟨⟨hc_Z⟩, hAff_Z⟩ := hPullbackLimit S₀ q f_base s_gen (@hf_map) hf_π
    have hComp_Z : ∀ i : SubIdx S₀, CompactSpace ↥(D_Z.obj i) :=
      fun i => (quasiCompact_iff_compactSpace (Limits.pullback.snd q (f_base i))).mp inferInstance
    by_contra hNoEmpty
    have hNe_Z : ∀ i : SubIdx S₀, Nonempty ↥(D_Z.obj i) := by
      intro i
      refine not_isEmpty_iff.mp fun hEmp_i => hNoEmpty ?_
      exact ⟨S_of i, hMono (hS₀_of i), hS₀_of i, hEmp_i⟩
    have hNe_pt : Nonempty ↥c_Z.pt :=
      @Scheme.nonempty_of_isLimit (SubIdx S₀) _ D_Z c_Z hc_Z _ (@hAff_Z) hNe_Z hComp_Z
    exact (not_nonempty_iff.mpr hEmp) hNe_pt

theorem weil_spreadOut_component_model_threeSpecial_dichotomy (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B]
    (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
    (ι_B : B →+* K_bar) (hInj : Function.Injective ι_B)
    (C_B : AlgebraicGeometry.Scheme.{u})
    (g_B : C_B ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
    (n : ℕ) (hn : 3 ≤ n)
    (τ_B : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ C_B))
    (hProp : AlgebraicGeometry.IsProper g_B)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g_B)
    (hSec : ∀ j : Fin n, τ_B j ≫ g_B = 𝟙 _)
    (c : ℕ) (hc : 1 ≤ c)
    (ℰ : Fin c → AlgebraicGeometry.Scheme.{u})
    (p_ℰ : ∀ i : Fin c, ℰ i ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
    (ι_ℰ : ∀ i : Fin c, ℰ i ⟶ C_B)
    (hComp : ∀ i : Fin c,
      AlgebraicGeometry.IsProper (p_ℰ i) ∧
      AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ i) ∧
      AlgebraicGeometry.IsClosedImmersion (ι_ℰ i) ∧
      ι_ℰ i ≫ g_B = p_ℰ i)
    (hFib : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_B : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of B)),
      let Y_Ω := CategoryTheory.Limits.pullback g_B s_B
      let ι_Ω : ∀ i : Fin c,
          CategoryTheory.Limits.pullback (ι_ℰ i) (CategoryTheory.Limits.pullback.fst g_B s_B) ⟶ Y_Ω :=
        fun i => CategoryTheory.Limits.pullback.snd (ι_ℰ i) (CategoryTheory.Limits.pullback.fst g_B s_B)
      ConnectedSpace ↥Y_Ω ∧
      (∀ y : ↥Y_Ω, HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g_B s_B) y) ∧
      (∀ i : Fin c, AlgebraicGeometry.IsIntegral
        (CategoryTheory.Limits.pullback (ι_ℰ i) (CategoryTheory.Limits.pullback.fst g_B s_B))) ∧
      (_root_.Pairwise fun i₁ i₂ : Fin c =>
        Set.range (ι_Ω i₁).base ≠ Set.range (ι_Ω i₂).base) ∧
      irreducibleComponents ↥Y_Ω = Set.range (fun i : Fin c => Set.range (ι_Ω i).base))
    (hNonP1 : ∀ (i : Fin c),
