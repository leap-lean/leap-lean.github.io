      rw [hmk]
      have hspec := IsLocalization.mk'_spec P (map_κ N₀) ⟨map_κ D₀, hD₀_bar⟩
      change IsLocalization.mk' P (map_κ N₀) ⟨map_κ D₀, hD₀_bar⟩ * φ_P (map_κ D₀) =
        φ_P (map_κ N₀) at hspec
