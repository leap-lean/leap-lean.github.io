        rw [he₁_app]
        rfl
      have hComap_V : Ideal.comap ψ_br_V
          (Ideal.map (Ideal.Quotient.mk
            (Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))})) u₁.asIdeal) =
          p_P.asIdeal := by
        rw [← Ideal.comap_comap, hComap_ψ0, ← hq0', hComap_q1_pP]
      exact ⟨0, weil_nodal_etale_branch_dvr_and_kaehler_unit_algebra
        Ω B A'₁ B_tilde (F α) c_V φ₁_V φ₂ hEt_ψ₁ (((ν α).app V).hom) φ_V.hom hFrac_V
        u₁.asIdeal p_P.asIdeal t_P 0 hAlg_φ hAlg_F hSpan_u₁ hDom₀ hx₀_ne
        ht_mem ht_not_sq hDVR_div ψ_br_V hComp_V (hInj_0.comp hInj_resW) hComap_V
        hFl_V hUn_V hEFT_V⟩
    · 
      obtain ⟨hα1, hq1⟩ := Sigma.mk.inj_iff.mp h1
