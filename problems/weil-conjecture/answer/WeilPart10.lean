    obtain ⟨_, hCompGrid_gen⟩ := hGrid s_B_gen
    let hFull_gen := (hCompGrid_gen i).2
    have hNotP1_1gen : ¬ ∃ isoP1 : CategoryTheory.Limits.pullback (p_ℰ₁ i) s₁_gen ≅
          (weilProjectiveSpaceOver Q_bar 1).left,
        CategoryTheory.Limits.pullback.snd (p_ℰ₁ i) s₁_gen =
          isoP1.hom ≫ (weilProjectiveSpaceOver Q_bar 1).hom := by
      rw [← hs_B_gen_eq]
      intro hP1_1
      exact hNotP1_Bgen
        (hTransP1 _ _ hFull_gen.isoPullback.symm
          (hSymmHom hFull_gen.isoPullback _ _ hFull_gen.isoPullback_hom_snd)
          hP1_1)
    obtain ⟨hInt_1_all, hNonP1_1_Ω⟩ := hAll_ℰ₁_intP1 i i.2
    obtain ⟨_, hCompGrid_Ω⟩ := hGrid s_B
    let hFull_Ω := (hCompGrid_Ω i).2
    let e_Ω := hFull_Ω.isoPullback
    have hf₁B_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₃_B.comp φ₁₃)) = f₁_B := rfl
    have hInt_iΩ : AlgebraicGeometry.IsIntegral
        (CategoryTheory.Limits.pullback (ι_ℰ i)
          (CategoryTheory.Limits.pullback.fst g_B s_B)) := by
      obtain ⟨hI, _⟩ := hInt_1_all Ω s_B
      rw [hf₁B_eq] at hI
