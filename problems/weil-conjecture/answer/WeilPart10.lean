    · have hInter : ((U 0 : Set ↥P_Ω) ∩ (U 1 : Set ↥P_Ω)).Nonempty := by
        let x01 : MvPolynomial (Fin 2) Ω := MvPolynomial.X 0 * MvPolynomial.X 1
        have hx01 : x01 ∈ 𝒜 2 :=
