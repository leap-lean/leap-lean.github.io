    ∃ (A'_0 : Type u) (instRingA'₀ : CommRing A'_0),
      letI : CommRing A'_0 := instRingA'₀
      ∃ (u₀ : PrimeSpectrum A'_0)
        (φ₀ : ↑(C.presheaf.obj (Opposite.op V)) →+* A'_0)
        (ψ₀ : (MvPolynomial (Fin 2) Ω ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
            Set (MvPolynomial (Fin 2) Ω))) →+* A'_0),
        φ₀.Etale ∧
        ψ₀.Etale ∧
        φ₀.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ V (fun _ _ => trivial)).hom) =
          ψ₀.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
        Ideal.comap φ₀ u₀.asIdeal = p_z.asIdeal ∧
        (∀ i : Fin 2, ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ u₀.asIdeal) ∧
