      have hSpan_swap : Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1)),
          φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} = u₁.asIdeal := by
        rw [Set.pair_comm]; exact hSpan_u₁
      exact ⟨1, weil_nodal_etale_branch_dvr_and_kaehler_unit_algebra
        Ω B A'₁ B_tilde (F α) c_V φ₁_V φ₂ hEt_ψ₁ (((ν α).app V).hom) φ_V.hom hFrac_V
        u₁.asIdeal p_P.asIdeal t_P 1 hAlg_φ hAlg_F hSpan_swap hDom₁ hx₁_ne
        ht_mem ht_not_sq hDVR_div ψ_br_V hComp_V (hInj_1.comp hInj_resW) hComap_V
