      Nat.rec ⟨b, by simpa using hbt⟩ (fun m ih =>
        let h_ex := hStepDiv m ih.1 ih.2
        ⟨Classical.choose h_ex,
          hMul_pow_succ m ih.1 (Classical.choose h_ex) ih.2 (Classical.choose_spec h_ex)⟩)
    let q_seq : ℕ → B := fun m => (q_state m).1
    have hq_zero : q_seq 0 = b := rfl
    have hq_step : ∀ m : ℕ, q_seq m = q_seq (m + 1) * t := fun m =>
      Classical.choose_spec (hStepDiv m (q_state m).1 (q_state m).2)
    have hq_pow : ∀ m : ℕ, q_seq m * t ^ m = b := by
      intro m
      induction m with
      | zero => simp [hq_zero]
      | succ m ih =>
        calc q_seq (m + 1) * t ^ (m + 1)
            = (q_seq (m + 1) * t) * t ^ m := by rw [pow_succ']; ring
          _ = q_seq m * t ^ m := by rw [← hq_step m]
          _ = b := ih
    let I_seq : ℕ →o Submodule B B :=
      { toFun := fun m => Ideal.span ({q_seq m} : Set B)
        monotone' := monotone_nat_of_le_succ fun m => by
          rw [Ideal.span_le]
          rintro _ rfl
          rw [SetLike.mem_coe, Ideal.mem_span_singleton]
          exact ⟨t, hq_step m⟩ }
    obtain ⟨m₀, hm₀⟩ := (monotone_stabilizes_iff_noetherian.mpr hNoethModB) I_seq
    have hStab : I_seq m₀ = I_seq (m₀ + 1) := hm₀ (m₀ + 1) (Nat.le_succ m₀)
    have hq_mem_m₀ : q_seq (m₀ + 1) ∈ Ideal.span ({q_seq m₀} : Set B) := by
      change q_seq (m₀ + 1) ∈ I_seq m₀
      rw [hStab]
      exact Ideal.subset_span rfl
    rw [Ideal.mem_span_singleton] at hq_mem_m₀
    obtain ⟨u, hu⟩ := hq_mem_m₀
    calc b
        = q_seq (m₀ + 1) * t ^ (m₀ + 1) := (hq_pow (m₀ + 1)).symm
      _ = (q_seq m₀ * u) * (t ^ m₀ * t) := by rw [hu, pow_succ]
      _ = u * (q_seq m₀ * t ^ m₀) * t := by ring
      _ = u * (b * t) := by rw [hq_pow m₀]; ring
      _ = 0 := by rw [hbt, mul_zero]
  exact ⟨π, F, t, hπ_C, hπ_surj, hπ_ker, hσB_ker, ht_nzd, hMinor⟩

theorem weil_flat_finitelyPresented_smooth_geomFiber_descent (A₀ B₀ K : Type u) [CommRing A₀] [IsNoetherianRing A₀]
    [CommRing B₀] [Algebra A₀ B₀] [Module.Flat A₀ B₀]
    [Field K] [Algebra A₀ K]
    (k₀ : ℕ)
    (π₀ : MvPolynomial (Fin (k₀ + 1)) A₀ →+* B₀)
    (hπ₀_C : π₀.comp MvPolynomial.C = algebraMap A₀ B₀)
    (hπ₀_surj : Function.Surjective π₀)
    (ev_K : B₀ →ₐ[A₀] K)
    (h_K : TensorProduct A₀ K B₀)
    (hh_K : h_K ∉ RingHom.ker (Algebra.TensorProduct.lift (AlgHom.id K K) ev_K
      (fun _ _ => mul_comm _ _)).toRingHom)
    (hSm_K : Algebra.IsStandardSmoothOfRelativeDimension 1 K (Localization.Away h_K)) :
    ∃ h_B : B₀,
      ev_K h_B ≠ 0 ∧
      ∀ (B_loc : Type u) [CommRing B_loc] [Algebra B₀ B_loc] [IsLocalization.Away h_B B_loc],
        RingHom.IsStandardSmoothOfRelativeDimension 1
          ((algebraMap B₀ B_loc).comp (algebraMap A₀ B₀)) :=
by
  
  have mkLiftToKMod : ∀ {R₁ : Type u} [CommRing R₁] [Algebra R₁ K] [SMulCommClass R₁ K K]
      {M₁ W : Type u} [AddCommGroup M₁] [Module R₁ M₁] [AddCommGroup W] [Module K W]
      (θ : M₁ →+ W) (hθ : ∀ (r : R₁) (m : M₁), θ (r • m) = algebraMap R₁ K r • θ m),
      ∃ L : TensorProduct R₁ K M₁ →ₗ[K] W,
        ∀ (c : K) (m : M₁), L (c ⊗ₜ[R₁] m) = c • θ m := by
    intro R₁ _ _ _ M₁ W _ _ _ _ θ hθ
    letI : Module R₁ W := Module.compHom W (algebraMap R₁ K)
    haveI : IsScalarTower R₁ K W :=
      ⟨fun r c w => by
        change (r • c) • w = algebraMap R₁ K r • (c • w)
        rw [Algebra.smul_def, mul_smul]⟩
    haveI : IsScalarTower R₁ K K :=
      ⟨fun r c x => Algebra.smul_mul_assoc r c x⟩
    let B : K →ₗ[K] M₁ →ₗ[R₁] W :=
      { toFun := fun c =>
          { toFun := fun m => c • θ m
            map_add' := fun m₁ m₂ => by rw [map_add, smul_add]
            map_smul' := fun r m => by
              dsimp only [RingHom.id_apply]
              change c • θ (r • m) = algebraMap R₁ K r • (c • θ m)
              rw [hθ r m, smul_smul, smul_smul, mul_comm] }
        map_add' := fun c₁ c₂ => by
          ext m; exact add_smul c₁ c₂ (θ m)
        map_smul' := fun k c => by
          ext m; exact mul_smul k c (θ m) }
    refine ⟨TensorProduct.AlgebraTensorModule.lift B, fun c m => ?_⟩
    exact TensorProduct.AlgebraTensorModule.lift_tmul B c m
  have mkBaseChangeHom : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
      [Algebra R₁ K] [Algebra R₂ K] [SMulCommClass R₁ K K] [SMulCommClass R₂ K K]
      {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R₁ M₁] [AddCommGroup M₂] [Module R₂ M₂]
      (φ : R₁ →+* R₂) (hφ : ∀ r : R₁, algebraMap R₂ K (φ r) = algebraMap R₁ K r)
      (θ : M₁ →+ M₂) (hθ : ∀ (r : R₁) (m : M₁), θ (r • m) = φ r • θ m),
      ∃ L : TensorProduct R₁ K M₁ →ₗ[K] TensorProduct R₂ K M₂,
        ∀ (c : K) (m : M₁), L (c ⊗ₜ[R₁] m) = c ⊗ₜ[R₂] θ m := by
    intro R₁ R₂ _ _ _ _ _ _ M₁ M₂ _ _ _ _ φ hφ θ hθ
    let θ' : M₁ →+ TensorProduct R₂ K M₂ :=
      { toFun := fun m => (1 : K) ⊗ₜ[R₂] θ m
        map_zero' := by simp
        map_add' := fun m₁ m₂ => by rw [map_add, TensorProduct.tmul_add] }
    have hθ' : ∀ (r : R₁) (m : M₁), θ' (r • m) = algebraMap R₁ K r • θ' m := by
      intro r m
      change (1 : K) ⊗ₜ[R₂] θ (r • m) = algebraMap R₁ K r • ((1 : K) ⊗ₜ[R₂] θ m)
      rw [hθ r m, ← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
      congr 1
      change φ r • (1 : K) = algebraMap R₁ K r • (1 : K)
      rw [Algebra.smul_def, mul_one, hφ r, smul_eq_mul, mul_one]
    obtain ⟨L, hL⟩ := mkLiftToKMod θ' hθ'
    refine ⟨L, fun c m => ?_⟩
    rw [hL c m]
    change c • ((1 : K) ⊗ₜ[R₂] θ m) = c ⊗ₜ[R₂] θ m
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]

  
  have h_loc_ker : ∀ (R B P S : Type u) [CommRing R] [CommRing B] [CommRing P] [CommRing S]
      [IsLocalRing S]
      (π : R →+* B) (_ : Function.Surjective π)
      (ev : B →+* K)
      (q : Ideal B) [q.IsPrime] (_ : q = RingHom.ker ev)
      (Q : Ideal R) [Q.IsPrime] (_ : Q = Ideal.comap π q)
      [Algebra R P] [IsLocalization.AtPrime P Q]
      [Algebra B S] [IsLocalization.AtPrime S q]
      (φ_PS : P →+* S) (φ_SK : S →+* K)
      (_ : φ_PS.comp (algebraMap R P) = (algebraMap B S).comp π)
      (_ : φ_SK.comp (algebraMap B S) = ev)
      [Algebra R K] [SMulCommClass R K K]
      (_ : ∀ r : R, algebraMap R K r = ev (π r))
      [Algebra P K] [SMulCommClass P K K]
      (_ : ∀ p : P, algebraMap P K p = φ_SK (φ_PS p)),
      Function.Surjective φ_PS ∧
      IsLocalRing.maximalIdeal S ≤ RingHom.ker φ_SK ∧
      ∃ (hmem : ∀ g : ↥(RingHom.ker π), algebraMap R P g.1 ∈ RingHom.ker φ_PS)
        (β : TensorProduct R K ↥(RingHom.ker π) →ₗ[K] TensorProduct P K ↥(RingHom.ker φ_PS)),
        Function.Surjective β ∧
        (Function.Surjective (ev.comp π) → Function.Injective β) ∧
        ∀ (c : K) (g : ↥(RingHom.ker π)),
          β (c ⊗ₜ[R] g) = c ⊗ₜ[P] ⟨algebraMap R P g.1, hmem g⟩ := by
    intro R B P S _ _ _ _ _ π hπ ev q _ hq Q _ hQ _ _ _ _ φ_PS φ_SK hφ_PS hφ_SK _ _ hRK _ _ hPK
    have hmem_q : ∀ b : B, b ∈ q ↔ ev b = 0 := by
      intro b; rw [hq, RingHom.mem_ker]
    have hmem_Q : ∀ r : R, r ∈ Q ↔ ev (π r) = 0 := by
      intro r; rw [hQ, Ideal.mem_comap, hmem_q]
    have hφ_PS_app : ∀ r : R, φ_PS (algebraMap R P r) = algebraMap B S (π r) :=
      RingHom.congr_fun hφ_PS
    have hφ_SK_app : ∀ b : B, φ_SK (algebraMap B S b) = ev b :=
      RingHom.congr_fun hφ_SK
    have hSurj_PS : Function.Surjective φ_PS := by
      intro y
      obtain ⟨⟨b, s_B⟩, hy⟩ := IsLocalization.surj q.primeCompl y
      obtain ⟨r, rfl⟩ := hπ b
      obtain ⟨s, hs_eq⟩ := hπ s_B.1
      have hs_Q : s ∈ Q.primeCompl := by
        change s ∉ Q
        rw [hmem_Q, hs_eq, ← hmem_q]
        exact s_B.2
      let x : P := IsLocalization.mk' P r ⟨s, hs_Q⟩
      have hx : x * algebraMap R P s = algebraMap R P r :=
        IsLocalization.mk'_spec P r ⟨s, hs_Q⟩
      have hx_S : φ_PS x * algebraMap B S s_B.1 = y * algebraMap B S s_B.1 := by
        have h1 := congr_arg φ_PS hx
        rw [map_mul, hφ_PS_app s, hφ_PS_app r, hs_eq] at h1
        exact h1.trans hy.symm
      obtain ⟨v, hv⟩ := (IsLocalization.map_units S s_B).exists_right_inv
      refine ⟨x, ?_⟩
      calc φ_PS x = φ_PS x * (algebraMap B S s_B.1 * v) := by rw [hv, mul_one]
        _ = (φ_PS x * algebraMap B S s_B.1) * v := by ring
        _ = (y * algebraMap B S s_B.1) * v := by rw [hx_S]
        _ = y * (algebraMap B S s_B.1 * v) := by ring
        _ = y := by rw [hv, mul_one]
    have hMax_S : IsLocalRing.maximalIdeal S ≤ RingHom.ker φ_SK := by
      intro m hm
      rw [RingHom.mem_ker]
      by_contra hm_ne
      obtain ⟨⟨b, s_B⟩, hms⟩ := IsLocalization.surj q.primeCompl m
      have hms_K : φ_SK m * ev s_B.1 = ev b := by
        have h1 := congr_arg φ_SK hms
        rw [map_mul, hφ_SK_app s_B.1, hφ_SK_app b] at h1
        exact h1
      have hs_ne : ev s_B.1 ≠ 0 := (hmem_q s_B.1).not.mp s_B.2
      have hb_ne : ev b ≠ 0 := by
        rw [← hms_K]
        exact mul_ne_zero hm_ne hs_ne
      have hb_compl : b ∈ q.primeCompl := (hmem_q b).not.mpr hb_ne
      obtain ⟨w, hw⟩ := (IsLocalization.map_units S ⟨b, hb_compl⟩).exists_right_inv
      have hm_unit : IsUnit m :=
        isUnit_iff_exists_inv.mpr ⟨algebraMap B S s_B.1 * w, by rw [← mul_assoc, hms, hw]⟩
      exact (IsLocalRing.notMem_maximalIdeal.mpr hm_unit) hm
    let I : Ideal R := RingHom.ker π
    let J : Ideal P := RingHom.ker φ_PS
    have hmem : ∀ g : ↥I, algebraMap R P g.1 ∈ J := by
      intro g
      rw [RingHom.mem_ker, hφ_PS_app g.1, RingHom.mem_ker.mp g.2, map_zero]
    have hClearJ : ∀ j : ↥J, ∃ (s : R) (_ : s ∈ Q.primeCompl) (g₀ : ↥I),
        algebraMap R P s • j = ⟨algebraMap R P g₀.1, hmem g₀⟩ := by
      intro j
      obtain ⟨⟨f, s₁⟩, hj⟩ := IsLocalization.surj Q.primeCompl j.1
      have hπf_zero : algebraMap B S (π f) = 0 := by
        have h1 := congr_arg φ_PS hj
        rw [map_mul, RingHom.mem_ker.mp j.2, zero_mul, hφ_PS_app f] at h1
        exact h1.symm
      obtain ⟨t_B, ht_zero⟩ :=
        (IsLocalization.map_eq_zero_iff q.primeCompl S (π f)).mp hπf_zero
      obtain ⟨t, ht_eq⟩ := hπ t_B.1
      have ht_Q : t ∈ Q.primeCompl := by
        change t ∉ Q
        rw [hmem_Q, ht_eq, ← hmem_q]
        exact t_B.2
      have htf_I : t * f ∈ I := by
        rw [RingHom.mem_ker, map_mul, ht_eq]
        exact ht_zero
      refine ⟨t * s₁.1, Q.primeCompl.mul_mem ht_Q s₁.2, ⟨t * f, htf_I⟩, Subtype.ext ?_⟩
      change algebraMap R P (t * s₁.1) * j.1 = algebraMap R P (t * f)
      calc algebraMap R P (t * s₁.1) * j.1
          = algebraMap R P t * (j.1 * algebraMap R P s₁.1) := by rw [map_mul]; ring
        _ = algebraMap R P t * algebraMap R P f := by rw [hj]
        _ = algebraMap R P (t * f) := by rw [← map_mul]
    let θ_IJ : ↥I →+ ↥J :=
      { toFun := fun g => ⟨algebraMap R P g.1, hmem g⟩
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun g₁ g₂ => Subtype.ext (map_add _ g₁.1 g₂.1) }
    have hθ_IJ : ∀ (r : R) (g : ↥I), θ_IJ (r • g) = algebraMap R P r • θ_IJ g :=
      fun r g => Subtype.ext (map_mul (algebraMap R P) r g.1)
    have hAlg_RP : ∀ r : R, algebraMap P K (algebraMap R P r) = algebraMap R K r := by
      intro r
      rw [hPK, hφ_PS_app, hφ_SK_app, hRK]
    obtain ⟨β, hβ⟩ := mkBaseChangeHom (algebraMap R P) hAlg_RP θ_IJ hθ_IJ
    have hβ_surj : Function.Surjective β := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => exact ⟨0, map_zero β⟩
      | tmul c j =>
        obtain ⟨s, hs, g₀, hsj⟩ := hClearJ j
        have hu_ne : ev (π s) ≠ 0 := (hmem_Q s).not.mp hs
        refine ⟨(c * (ev (π s))⁻¹) ⊗ₜ[R] g₀, ?_⟩
        rw [hβ]
        change (c * (ev (π s))⁻¹) ⊗ₜ[P] ⟨algebraMap R P g₀.1, hmem g₀⟩ = c ⊗ₜ[P] j
        rw [← hsj, ← TensorProduct.smul_tmul]
        congr 1
        rw [Algebra.smul_def, hAlg_RP, hRK]
        calc ev (π s) * (c * (ev (π s))⁻¹)
            = c * (ev (π s) * (ev (π s))⁻¹) := by ring
          _ = c := by rw [mul_inv_cancel₀ hu_ne, mul_one]
      | add x y hx hy =>
        obtain ⟨u₁, rfl⟩ := hx
        obtain ⟨u₂, rfl⟩ := hy
        exact ⟨u₁ + u₂, map_add β u₁ u₂⟩
    have hβ_inj : Function.Surjective (ev.comp π) → Function.Injective β := by
      intro hSurj_RK
      have hCollapse : ∀ w : TensorProduct R K ↥I, ∃ g : ↥I, w = (1 : K) ⊗ₜ[R] g := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => exact ⟨0, (TensorProduct.tmul_zero _ _).symm⟩
        | tmul c g =>
          obtain ⟨r, hr⟩ := hSurj_RK c
          refine ⟨r • g, ?_⟩
          rw [← TensorProduct.smul_tmul]
          congr 1
          rw [Algebra.smul_def, mul_one, hRK]
          exact hr.symm
        | add x y hx hy =>
          obtain ⟨g₁, rfl⟩ := hx
          obtain ⟨g₂, rfl⟩ := hy
          exact ⟨g₁ + g₂, (TensorProduct.tmul_add _ _ _).symm⟩
      rw [injective_iff_map_eq_zero]
      intro w hw
      obtain ⟨g, rfl⟩ := hCollapse w
      let j_g : ↥J := ⟨algebraMap R P g.1, hmem g⟩
      have hβg : (1 : K) ⊗ₜ[P] j_g = 0 := by
        have h1 := hβ 1 g
        change β ((1 : K) ⊗ₜ[R] g) = (1 : K) ⊗ₜ[P] j_g at h1
        exact h1.symm.trans hw
      let lin_PK : P →ₗ[P] K := Algebra.linearMap P K
      have hSurj_PK : Function.Surjective lin_PK := by
        intro c
        obtain ⟨r, hr⟩ := hSurj_RK c
        refine ⟨algebraMap R P r, ?_⟩
        change algebraMap P K (algebraMap R P r) = c
        rw [hAlg_RP, hRK]
        exact hr
      let m_P : Ideal P := LinearMap.ker lin_PK
      let e_q : (P ⧸ m_P) ≃ₗ[P] K := lin_PK.quotKerEquivOfSurjective hSurj_PK
      have he_q_one : e_q.symm.toLinearMap (1 : K) = Ideal.Quotient.mk m_P 1 := by
        change e_q.symm (1 : K) = Ideal.Quotient.mk m_P 1
        apply e_q.injective
        rw [LinearEquiv.apply_symm_apply]
        symm
        change (lin_PK.quotKerEquivOfSurjective hSurj_PK) (Submodule.Quotient.mk 1) = 1
        rw [LinearMap.quotKerEquivOfSurjective_apply_mk]
        exact map_one (algebraMap P K)
      have hq_zero : (Ideal.Quotient.mk m_P 1) ⊗ₜ[P] j_g = 0 := by
        have h1 := congr_arg (LinearMap.rTensor ↥J e_q.symm.toLinearMap) hβg
        rwa [map_zero, LinearMap.rTensor_tmul, he_q_one] at h1
      have hquo_mem : j_g ∈ m_P • (⊤ : Submodule P ↥J) := by
        have h1 := congr_arg (TensorProduct.quotTensorEquivQuotSMul (↥J) m_P) hq_zero
        rwa [map_zero, TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul,
          Submodule.Quotient.mk_eq_zero] at h1
      have hSmulClear : ∀ y : ↥J, y ∈ m_P • (⊤ : Submodule P ↥J) →
          ∃ (u : R) (_ : u ∈ Q.primeCompl) (z : ↥I),
            algebraMap R P u • y = ⟨algebraMap R P z.1, hmem z⟩ ∧
            (1 : K) ⊗ₜ[R] z = 0 := by
        intro y hy_mem
        refine Submodule.smul_induction_on hy_mem ?_ ?_
        · intro m hm j _
          obtain ⟨⟨q₁, s₁⟩, hm_eq⟩ := IsLocalization.surj Q.primeCompl m
          have hq₁_zero : ev (π q₁) = 0 := by
            have hm0 : algebraMap P K m = 0 := LinearMap.mem_ker.mp hm
            have h1 := congr_arg (algebraMap P K) hm_eq
            rw [map_mul, hm0, zero_mul, hAlg_RP, hRK] at h1
            exact h1.symm
          obtain ⟨s₂, hs₂, g₂, hj_eq⟩ := hClearJ j
          refine ⟨s₁.1 * s₂, Q.primeCompl.mul_mem s₁.2 hs₂, q₁ • g₂, ?_, ?_⟩
          · apply Subtype.ext
            have hj_val : algebraMap R P s₂ * j.1 = algebraMap R P g₂.1 :=
              congr_arg Subtype.val hj_eq
            change algebraMap R P (s₁.1 * s₂) * (m * j.1) = algebraMap R P (q₁ * g₂.1)
            calc algebraMap R P (s₁.1 * s₂) * (m * j.1)
                = (m * algebraMap R P s₁.1) * (algebraMap R P s₂ * j.1) := by rw [map_mul]; ring
              _ = algebraMap R P q₁ * algebraMap R P g₂.1 := by rw [hm_eq, hj_val]
              _ = algebraMap R P (q₁ * g₂.1) := by rw [← map_mul]
          · rw [← TensorProduct.smul_tmul]
            have hsmul0 : (q₁ • (1 : K)) = 0 := by
              rw [Algebra.smul_def, mul_one, hRK, hq₁_zero]
            rw [hsmul0, TensorProduct.zero_tmul]
        · intro y₁ y₂ ⟨u₁, hu₁, z₁, hy₁, hz₁⟩ ⟨u₂, hu₂, z₂, hy₂, hz₂⟩
          refine ⟨u₁ * u₂, Q.primeCompl.mul_mem hu₁ hu₂, u₂ • z₁ + u₁ • z₂, ?_, ?_⟩
          · apply Subtype.ext
            have hy₁_val : algebraMap R P u₁ * y₁.1 = algebraMap R P z₁.1 :=
              congr_arg Subtype.val hy₁
            have hy₂_val : algebraMap R P u₂ * y₂.1 = algebraMap R P z₂.1 :=
              congr_arg Subtype.val hy₂
            change algebraMap R P (u₁ * u₂) * (y₁.1 + y₂.1) =
              algebraMap R P (u₂ * z₁.1 + u₁ * z₂.1)
            calc algebraMap R P (u₁ * u₂) * (y₁.1 + y₂.1)
                = algebraMap R P u₂ * (algebraMap R P u₁ * y₁.1) +
                  algebraMap R P u₁ * (algebraMap R P u₂ * y₂.1) := by rw [map_mul]; ring
              _ = algebraMap R P u₂ * algebraMap R P z₁.1 +
                  algebraMap R P u₁ * algebraMap R P z₂.1 := by rw [hy₁_val, hy₂_val]
              _ = algebraMap R P (u₂ * z₁.1 + u₁ * z₂.1) := by rw [map_add, map_mul, map_mul]
          · have hterm : ∀ (r : R) (z : ↥I), (1 : K) ⊗ₜ[R] z = 0 →
                (1 : K) ⊗ₜ[R] (r • z) = 0 := by
              intro r z hz0
              rw [← TensorProduct.smul_tmul]
              have hr1 : r • (1 : K) = algebraMap R K r • (1 : K) := by
                rw [Algebra.smul_def, smul_eq_mul]
              rw [hr1, ← TensorProduct.smul_tmul', hz0, smul_zero]
            rw [TensorProduct.tmul_add, hterm u₂ z₁ hz₁, hterm u₁ z₂ hz₂, add_zero]
      obtain ⟨u, hu, z, huj, hz_zero⟩ := hSmulClear j_g hquo_mem
      have hP_eq : algebraMap R P (u * g.1) = algebraMap R P z.1 := by
        rw [map_mul]
        exact congr_arg Subtype.val huj
      obtain ⟨v, hv_eq⟩ := IsLocalization.exists_of_eq (M := Q.primeCompl) hP_eq
      have hvug_eq : (v.1 * u) • g = v.1 • z := by
        apply Subtype.ext
        change (v.1 * u) * g.1 = v.1 * z.1
        calc (v.1 * u) * g.1 = v.1 * (u * g.1) := by ring
          _ = v.1 * z.1 := hv_eq
      have hvu_compl : v.1 * u ∈ Q.primeCompl := Q.primeCompl.mul_mem v.2 hu
      have hvu_ne : ev (π (v.1 * u)) ≠ 0 := (hmem_Q (v.1 * u)).not.mp hvu_compl
      have h_smul_zero : ev (π (v.1 * u)) • ((1 : K) ⊗ₜ[R] g) = 0 := by
        calc ev (π (v.1 * u)) • ((1 : K) ⊗ₜ[R] g)
            = (ev (π (v.1 * u)) • (1 : K)) ⊗ₜ[R] g := TensorProduct.smul_tmul' _ _ _
          _ = ((v.1 * u) • (1 : K)) ⊗ₜ[R] g := by
              congr 1
              rw [smul_eq_mul, Algebra.smul_def, hRK]
          _ = (1 : K) ⊗ₜ[R] ((v.1 * u) • g) := TensorProduct.smul_tmul _ _ _
          _ = (1 : K) ⊗ₜ[R] (v.1 • z) := by rw [hvug_eq]
          _ = (v.1 • (1 : K)) ⊗ₜ[R] z := (TensorProduct.smul_tmul _ _ _).symm
          _ = (algebraMap R K v.1 • (1 : K)) ⊗ₜ[R] z := by
              congr 1
              rw [Algebra.smul_def, smul_eq_mul]
          _ = algebraMap R K v.1 • ((1 : K) ⊗ₜ[R] z) := (TensorProduct.smul_tmul' _ _ _).symm
          _ = 0 := by rw [hz_zero, smul_zero]
      calc (1 : K) ⊗ₜ[R] g
          = ((ev (π (v.1 * u)))⁻¹ * ev (π (v.1 * u))) • ((1 : K) ⊗ₜ[R] g) := by
            rw [inv_mul_cancel₀ hvu_ne, one_smul]
        _ = (ev (π (v.1 * u)))⁻¹ • (ev (π (v.1 * u)) • ((1 : K) ⊗ₜ[R] g)) :=
            mul_smul _ _ _
        _ = 0 := by rw [h_smul_zero, smul_zero]
    exact ⟨hSurj_PS, hMax_S, hmem, β, hβ_surj, hβ_inj, hβ⟩

  
  have hπ₀_C_app : ∀ a : A₀, π₀ (MvPolynomial.C a) = algebraMap A₀ B₀ a :=
    RingHom.congr_fun hπ₀_C
  let P₀ := MvPolynomial (Fin (k₀ + 1)) A₀
  let P_K := MvPolynomial (Fin (k₀ + 1)) K
  let B_K := TensorProduct A₀ K B₀
  let π₀_alg : P₀ →ₐ[A₀] B₀ := ⟨π₀, hπ₀_C_app⟩
  let π_K : P_K →ₐ[K] B_K :=
    MvPolynomial.aeval (fun i => (1 : K) ⊗ₜ[A₀] π₀ (MvPolynomial.X i))
  let Φ_K : B_K →ₐ[K] K :=
    Algebra.TensorProduct.lift (AlgHom.id K K) ev_K (fun _ _ => mul_comm _ _)
  have hΦ_tmul : ∀ (c : K) (b : B₀), Φ_K (c ⊗ₜ[A₀] b) = c * ev_K b :=
    fun c b => Algebra.TensorProduct.lift_tmul (AlgHom.id K K) ev_K (fun _ _ => mul_comm _ _) c b
  have hπK_map_hom :
      π_K.toRingHom.comp (MvPolynomial.map (algebraMap A₀ K)) =
        Algebra.TensorProduct.includeRight.toRingHom.comp π₀ := by
    apply MvPolynomial.ringHom_ext'
    · ext a
      change π_K ((MvPolynomial.map (algebraMap A₀ K)) (MvPolynomial.C a)) =
        (1 : K) ⊗ₜ[A₀] π₀ (MvPolynomial.C a)
      rw [MvPolynomial.map_C, hπ₀_C_app a]
      have haev : π_K (MvPolynomial.C (algebraMap A₀ K a)) =
          algebraMap K B_K (algebraMap A₀ K a) := MvPolynomial.aeval_C _ _
      rw [haev]
      have h1 : algebraMap K B_K (algebraMap A₀ K a) = (algebraMap A₀ K a) ⊗ₜ[A₀] (1 : B₀) := rfl
      rw [h1]
      calc (algebraMap A₀ K a) ⊗ₜ[A₀] (1 : B₀)
          = (a • (1 : K)) ⊗ₜ[A₀] (1 : B₀) := by rw [Algebra.smul_def, mul_one]
        _ = (1 : K) ⊗ₜ[A₀] (a • (1 : B₀)) := TensorProduct.smul_tmul a (1 : K) (1 : B₀)
        _ = (1 : K) ⊗ₜ[A₀] algebraMap A₀ B₀ a := by rw [Algebra.smul_def, mul_one]
    · intro i
      change π_K ((MvPolynomial.map (algebraMap A₀ K)) (MvPolynomial.X i)) =
        (1 : K) ⊗ₜ[A₀] π₀ (MvPolynomial.X i)
      rw [MvPolynomial.map_X]
      exact MvPolynomial.aeval_X _ i
  have hπK_map : ∀ p : P₀,
      π_K (MvPolynomial.map (algebraMap A₀ K) p) = (1 : K) ⊗ₜ[A₀] π₀ p :=
    RingHom.congr_fun hπK_map_hom
  have hΦπK_map : ∀ p : P₀,
      Φ_K (π_K (MvPolynomial.map (algebraMap A₀ K) p)) = ev_K (π₀ p) := by
    intro p
    rw [hπK_map p, hΦ_tmul, one_mul]
  have hπK_surj : Function.Surjective π_K := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero π_K⟩
    | tmul c b =>
      obtain ⟨p, rfl⟩ := hπ₀_surj b
      refine ⟨MvPolynomial.C c * MvPolynomial.map (algebraMap A₀ K) p, ?_⟩
      have haev : π_K (MvPolynomial.C c) = c ⊗ₜ[A₀] (1 : B₀) := MvPolynomial.aeval_C _ c
      rw [map_mul, haev, hπK_map p, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy =>
      obtain ⟨p₁, rfl⟩ := hx
      obtain ⟨p₂, rfl⟩ := hy
      exact ⟨p₁ + p₂, map_add π_K p₁ p₂⟩
  have hΦπK_surj : Function.Surjective (Φ_K.toRingHom.comp π_K.toRingHom) := by
    intro c
    refine ⟨MvPolynomial.C c, ?_⟩
    rw [RingHom.comp_apply]
    change Φ_K (π_K (MvPolynomial.C c)) = c
    have haev : π_K (MvPolynomial.C c) = c ⊗ₜ[A₀] (1 : B₀) := MvPolynomial.aeval_C _ c
    rw [haev, hΦ_tmul, map_one, mul_one]

  let I₀ : Ideal P₀ := RingHom.ker π₀
  let I_K : Ideal P_K := RingHom.ker π_K.toRingHom
  letI instAlgP₀K : Algebra P₀ K := (ev_K.toRingHom.comp π₀).toAlgebra
  letI instAlgPKK : Algebra P_K K := (Φ_K.toRingHom.comp π_K.toRingHom).toAlgebra
  haveI : SMulCommClass P₀ K K :=
    ⟨fun p c x => by change ev_K (π₀ p) * (c * x) = c * (ev_K (π₀ p) * x); ring⟩
  haveI : SMulCommClass P_K K K :=
    ⟨fun p c x => by change Φ_K (π_K p) * (c * x) = c * (Φ_K (π_K p) * x); ring⟩
  have hmem_IK : ∀ g : ↥I₀, MvPolynomial.map (algebraMap A₀ K) g.1 ∈ I_K := by
    intro g
    rw [RingHom.mem_ker]
    change π_K (MvPolynomial.map (algebraMap A₀ K) g.1) = 0
    rw [hπK_map g.1, RingHom.mem_ker.mp g.2, TensorProduct.tmul_zero]
  let θ_ker : ↥I₀ →+ ↥I_K :=
    { toFun := fun g => ⟨MvPolynomial.map (algebraMap A₀ K) g.1, hmem_IK g⟩
      map_zero' := Subtype.ext (map_zero _)
      map_add' := fun g₁ g₂ => Subtype.ext (map_add _ g₁.1 g₂.1) }
  have hθ_ker : ∀ (p : P₀) (g : ↥I₀),
      θ_ker (p • g) = MvPolynomial.map (algebraMap A₀ K) p • θ_ker g :=
    fun p g => Subtype.ext (map_mul (MvPolynomial.map (algebraMap A₀ K)) p g.1)
  obtain ⟨ψ_ker, hψ_ker⟩ :=
    mkBaseChangeHom (MvPolynomial.map (algebraMap A₀ K)) hΦπK_map θ_ker hθ_ker

  have hψ_ker_inj : Function.Injective ψ_ker := by
    let I₀_A : Submodule A₀ P₀ := I₀.restrictScalars A₀
    let j₀ : ↥I₀_A →ₗ[A₀] P₀ := I₀_A.subtype
    have hex₀ : Function.Exact j₀ π₀_alg.toLinearMap := by
      intro x
      change π₀ x = 0 ↔ x ∈ LinearMap.range j₀
      exact ⟨fun hx => ⟨⟨x, hx⟩, rfl⟩, by rintro ⟨a, rfl⟩; exact a.2⟩
    have hj_inj : Function.Injective (LinearMap.lTensor K j₀) :=
      LinearMap.lTensor_injective_of_exact_of_flat π₀_alg.toLinearMap hπ₀_surj j₀
        Subtype.val_injective hex₀ K
    have hj_ex : Function.Exact (LinearMap.lTensor K j₀) (LinearMap.lTensor K π₀_alg.toLinearMap) :=
      lTensor_exact K hex₀ hπ₀_surj
    let e_mv : TensorProduct A₀ K P₀ ≃ₐ[K] P_K := MvPolynomial.algebraTensorAlgEquiv A₀ K
    have hπK_emv : ∀ z : TensorProduct A₀ K P₀,
        π_K (e_mv z) = LinearMap.lTensor K π₀_alg.toLinearMap z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul c p =>
        change π_K (MvPolynomial.algebraTensorAlgEquiv A₀ K (c ⊗ₜ[A₀] p)) = c ⊗ₜ[A₀] π₀ p
        rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_smul, hπK_map p,
          TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
    have hf₀_mem : ∀ w : TensorProduct A₀ K ↥I₀_A,
        e_mv (LinearMap.lTensor K j₀ w) ∈ I_K := by
      intro w
      rw [RingHom.mem_ker]
      change π_K (e_mv (LinearMap.lTensor K j₀ w)) = 0
      rw [hπK_emv]
      exact hj_ex.apply_apply_eq_zero w
    let f₀ : TensorProduct A₀ K ↥I₀_A →+ ↥I_K :=
      { toFun := fun w => ⟨e_mv (LinearMap.lTensor K j₀ w), hf₀_mem w⟩
        map_zero' := Subtype.ext (by simp)
        map_add' := fun w₁ w₂ => Subtype.ext (by
          change e_mv (LinearMap.lTensor K j₀ (w₁ + w₂)) =
            e_mv (LinearMap.lTensor K j₀ w₁) + e_mv (LinearMap.lTensor K j₀ w₂)
          rw [map_add, map_add]) }
    have hf₀_inj : Function.Injective f₀ := by
      intro w₁ w₂ hw
      exact hj_inj (e_mv.injective (congr_arg Subtype.val hw))
    have hf₀_surj : Function.Surjective f₀ := by
      intro h
      have hz0 : LinearMap.lTensor K π₀_alg.toLinearMap (e_mv.symm h.1) = 0 := by
        rw [← hπK_emv, AlgEquiv.apply_symm_apply]
        exact h.2
      obtain ⟨w, hw⟩ := (hj_ex (e_mv.symm h.1)).mp hz0
      refine ⟨w, Subtype.ext ?_⟩
      change e_mv (LinearMap.lTensor K j₀ w) = h.1
      rw [hw, AlgEquiv.apply_symm_apply]
    let e_ker : TensorProduct A₀ K ↥I₀_A ≃+ ↥I_K :=
      AddEquiv.ofBijective f₀ ⟨hf₀_inj, hf₀_surj⟩
    haveI : SMulCommClass A₀ K K :=
      ⟨fun a c x => by
        rw [Algebra.smul_def, smul_eq_mul, smul_eq_mul, Algebra.smul_def]
        ring⟩
    have hC_alg : ∀ a : A₀, algebraMap P₀ K (MvPolynomial.C a) = algebraMap A₀ K a := by
      intro a
      change ev_K (π₀ (MvPolynomial.C a)) = algebraMap A₀ K a
      rw [hπ₀_C_app a, ev_K.commutes]
    let θ_id : ↥I₀_A →+ ↥I₀ :=
      { toFun := fun g => ⟨g.1, g.2⟩
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hθ_id : ∀ (a : A₀) (g : ↥I₀_A),
        θ_id (a • g) = (MvPolynomial.C a : P₀) • θ_id g := by
      intro a g
      apply Subtype.ext
      change a • g.1 = MvPolynomial.C a * g.1
      rw [Algebra.smul_def]
      rfl
    obtain ⟨τ, hτ⟩ := mkBaseChangeHom (MvPolynomial.C : A₀ →+* P₀) hC_alg θ_id hθ_id
    let θ_back : ↥I_K →+ TensorProduct P₀ K ↥I₀ :=
      τ.toAddMonoidHom.comp e_ker.symm.toAddMonoidHom
    have hθ_back : ∀ (q : P_K) (h : ↥I_K),
        θ_back (q • h) = algebraMap P_K K q • θ_back h := by
      intro q h
      obtain ⟨w, rfl⟩ := e_ker.surjective h
      induction w using TensorProduct.induction_on with
      | zero => simp [θ_back]
      | add w₁ w₂ hw₁ hw₂ =>
        rw [map_add, smul_add, map_add, hw₁, hw₂, map_add, smul_add]
      | tmul d g =>
        obtain ⟨z, rfl⟩ := e_mv.surjective q
        induction z using TensorProduct.induction_on with
        | zero =>
          rw [map_zero, zero_smul, map_zero, map_zero, zero_smul]
        | add z₁ z₂ hz₁ hz₂ =>
          rw [map_add, add_smul, map_add, hz₁, hz₂, map_add, add_smul]
        | tmul k₁ p₀ =>
          have hmul_ker : e_mv (k₁ ⊗ₜ[A₀] p₀) • e_ker (d ⊗ₜ[A₀] g) =
              e_ker ((k₁ * d) ⊗ₜ[A₀] ⟨p₀ * g.1, Ideal.mul_mem_left I₀ p₀ g.2⟩) := by
            apply Subtype.ext
            change (MvPolynomial.algebraTensorAlgEquiv A₀ K (k₁ ⊗ₜ[A₀] p₀)) *
                (MvPolynomial.algebraTensorAlgEquiv A₀ K (d ⊗ₜ[A₀] g.1)) =
              MvPolynomial.algebraTensorAlgEquiv A₀ K ((k₁ * d) ⊗ₜ[A₀] (p₀ * g.1))
            rw [MvPolynomial.algebraTensorAlgEquiv_tmul,
              MvPolynomial.algebraTensorAlgEquiv_tmul,
              MvPolynomial.algebraTensorAlgEquiv_tmul,
              Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
              map_mul, map_mul]
            ring
          change θ_back (e_mv (k₁ ⊗ₜ[A₀] p₀) • e_ker (d ⊗ₜ[A₀] g)) =
            algebraMap P_K K (e_mv (k₁ ⊗ₜ[A₀] p₀)) • θ_back (e_ker (d ⊗ₜ[A₀] g))
          rw [hmul_ker]
          change τ (e_ker.symm (e_ker ((k₁ * d) ⊗ₜ[A₀] ⟨p₀ * g.1, _⟩))) =
            Φ_K (π_K (e_mv (k₁ ⊗ₜ[A₀] p₀))) • τ (e_ker.symm (e_ker (d ⊗ₜ[A₀] g)))
          rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hτ, hτ]
          have hp₀_smul : (⟨p₀ * g.1, Ideal.mul_mem_left I₀ p₀ g.2⟩ : ↥I₀) =
              p₀ • ⟨g.1, g.2⟩ := rfl
          rw [show θ_id ⟨p₀ * g.1, Ideal.mul_mem_left I₀ p₀ g.2⟩ = p₀ • θ_id g from hp₀_smul]
          rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
          congr 1
          have hΦ_emv : Φ_K (π_K (e_mv (k₁ ⊗ₜ[A₀] p₀))) = k₁ * ev_K (π₀ p₀) := by
            change Φ_K (π_K (MvPolynomial.algebraTensorAlgEquiv A₀ K (k₁ ⊗ₜ[A₀] p₀))) =
              k₁ * ev_K (π₀ p₀)
            rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_smul, map_smul, hΦπK_map p₀,
              smul_eq_mul]
          rw [hΦ_emv]
          change ev_K (π₀ p₀) * (k₁ * d) = (k₁ * ev_K (π₀ p₀)) * d
          ring
    obtain ⟨ρ, hρ⟩ := mkLiftToKMod θ_back hθ_back
    have hLeftInv : Function.LeftInverse ρ ψ_ker := by
      intro u
      induction u using TensorProduct.induction_on with
      | zero => simp
      | add u₁ u₂ hu₁ hu₂ => rw [map_add, map_add, hu₁, hu₂]
      | tmul c g =>
        rw [hψ_ker c g, hρ]
        have hg_ker : θ_ker g = e_ker ((1 : K) ⊗ₜ[A₀] ⟨g.1, g.2⟩) := by
          apply Subtype.ext
          change MvPolynomial.map (algebraMap A₀ K) g.1 =
            MvPolynomial.algebraTensorAlgEquiv A₀ K ((1 : K) ⊗ₜ[A₀] g.1)
          rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
        rw [hg_ker]
        change c • τ (e_ker.symm (e_ker ((1 : K) ⊗ₜ[A₀] ⟨g.1, g.2⟩))) = c ⊗ₜ[P₀] g
        rw [AddEquiv.symm_apply_apply, hτ, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rfl
    exact hLeftInv.injective

  
  let q_x : Ideal B₀ := RingHom.ker ev_K.toRingHom
  haveI hqx_prime : q_x.IsPrime := RingHom.ker_isPrime ev_K.toRingHom
  let q_K : Ideal B_K := RingHom.ker Φ_K.toRingHom
  haveI hqK_prime : q_K.IsPrime := RingHom.ker_isPrime Φ_K.toRingHom
  let Q_x : Ideal P₀ := Ideal.comap π₀ q_x
  haveI hQx_prime : Q_x.IsPrime := Ideal.IsPrime.comap π₀
  let Q_K : Ideal P_K := Ideal.comap π_K.toRingHom q_K
  haveI hQK_prime : Q_K.IsPrime := Ideal.IsPrime.comap π_K.toRingHom

  haveI hFP_B₀ : Algebra.FinitePresentation A₀ B₀ :=
    Algebra.FinitePresentation.of_surjective (f := π₀_alg) hπ₀_surj (IsNoetherian.noetherian _)
  haveI hFP_BK : Algebra.FinitePresentation K B_K := inferInstance
  have hFs_K : Algebra.FormallySmooth K (Localization.AtPrime q_K) := by
    haveI : Algebra.IsStandardSmooth K (Localization.Away h_K) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
    haveI : Algebra.FormallySmooth K (Localization.Away h_K) := inferInstance
    have hSub : (PrimeSpectrum.basicOpen h_K : Set (PrimeSpectrum B_K)) ⊆
        Algebra.smoothLocus K B_K :=
      (Algebra.basicOpen_subset_smoothLocus_iff (R := K)).mpr inferInstance
    exact hSub (show (⟨q_K, hqK_prime⟩ : PrimeSpectrum B_K) ∈ PrimeSpectrum.basicOpen h_K from hh_K)

  have h_cotangent_descent : ∀ (P S P'_K S_K : Type u)
      [CommRing P] [CommRing S] [IsLocalRing S]
      [CommRing P'_K] [CommRing S_K] [IsLocalRing S_K]
      [IsNoetherianRing P] [IsNoetherianRing P'_K]
      [Algebra P₀ P] [IsLocalization.AtPrime P Q_x]
      [Algebra A₀ P] [IsScalarTower A₀ P₀ P]
      [Algebra B₀ S] [IsLocalization.AtPrime S q_x]
      [Algebra A₀ S] [IsScalarTower A₀ B₀ S]
      [Algebra P_K P'_K] [IsLocalization.AtPrime P'_K Q_K]
      [Algebra K P'_K] [IsScalarTower K P_K P'_K]
      [Algebra B_K S_K] [IsLocalization.AtPrime S_K q_K]
      [Algebra K S_K] [IsScalarTower K B_K S_K],
      Algebra.FormallySmooth K S_K →
      Algebra.FormallySmooth A₀ S := by
    intro P S P'_K S_K _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hFs_SK
    haveI : Algebra.FormallySmooth P₀ P :=
      Algebra.FormallySmooth.of_isLocalization Q_x.primeCompl
    haveI : Algebra.FormallySmooth A₀ P :=
      Algebra.FormallySmooth.comp A₀ P₀ P
    haveI : Algebra.EssFiniteType P₀ P :=
      Algebra.EssFiniteType.of_isLocalization P Q_x.primeCompl
    haveI : Algebra.EssFiniteType A₀ P :=
      Algebra.EssFiniteType.comp A₀ P₀ P
    haveI : Module.Finite P Ω[P ⁄ A₀] :=
      KaehlerDifferential.finite A₀ P
    letI := instFreeMvPolynomialKaehlerDifferential A₀ (Fin (k₀ + 1))
    haveI : Module.Free P Ω[P ⁄ A₀] :=
      Module.free_of_isLocalizedModule (Rₛ := P) Q_x.primeCompl
        (KaehlerDifferential.map A₀ A₀ P₀ P)

    haveI : Algebra.FormallySmooth P_K P'_K :=
      Algebra.FormallySmooth.of_isLocalization Q_K.primeCompl
    haveI : Algebra.FormallySmooth K P'_K :=
      Algebra.FormallySmooth.comp K P_K P'_K
    haveI : Algebra.EssFiniteType P_K P'_K :=
      Algebra.EssFiniteType.of_isLocalization P'_K Q_K.primeCompl
    haveI : Algebra.EssFiniteType K P'_K :=
      Algebra.EssFiniteType.comp K P_K P'_K
    haveI : Module.Finite P'_K Ω[P'_K ⁄ K] :=
      KaehlerDifferential.finite K P'_K
    letI := instFreeMvPolynomialKaehlerDifferential K (Fin (k₀ + 1))
    haveI : Module.Free P'_K Ω[P'_K ⁄ K] :=
      Module.free_of_isLocalizedModule (Rₛ := P'_K) Q_K.primeCompl
        (KaehlerDifferential.map K K P_K P'_K)
    have hg_PS : ∀ y : ↥Q_x.primeCompl, IsUnit (((algebraMap B₀ S).comp π₀) y.1) :=
      fun y => IsLocalization.map_units S (⟨π₀ y.1, y.2⟩ : ↥q_x.primeCompl)
    let φ_PS : P →+* S := IsLocalization.lift (M := Q_x.primeCompl) hg_PS
    have hφ_PS_comp : φ_PS.comp (algebraMap P₀ P) = (algebraMap B₀ S).comp π₀ :=
      IsLocalization.lift_comp hg_PS
    have hφ_PS_app : ∀ p : P₀, φ_PS (algebraMap P₀ P p) = algebraMap B₀ S (π₀ p) :=
      RingHom.congr_fun hφ_PS_comp

    have hg_SK : ∀ y : ↥q_x.primeCompl, IsUnit (ev_K.toRingHom y.1) :=
      fun y => isUnit_iff_ne_zero.mpr y.2
    let φ_SK : S →+* K := IsLocalization.lift (M := q_x.primeCompl) hg_SK
    have hφ_SK_comp : φ_SK.comp (algebraMap B₀ S) = ev_K.toRingHom :=
      IsLocalization.lift_comp hg_SK
    have hφ_SK_app : ∀ b : B₀, φ_SK (algebraMap B₀ S b) = ev_K b :=
      RingHom.congr_fun hφ_SK_comp

    have hg_PSK : ∀ y : ↥Q_K.primeCompl, IsUnit (((algebraMap B_K S_K).comp π_K.toRingHom) y.1) :=
      fun y => IsLocalization.map_units S_K (⟨π_K y.1, y.2⟩ : ↥q_K.primeCompl)
    let φ_PSK : P'_K →+* S_K := IsLocalization.lift (M := Q_K.primeCompl) hg_PSK
    have hφ_PSK_comp : φ_PSK.comp (algebraMap P_K P'_K) = (algebraMap B_K S_K).comp π_K.toRingHom :=
      IsLocalization.lift_comp hg_PSK
    have hφ_PSK_app : ∀ p : P_K, φ_PSK (algebraMap P_K P'_K p) = algebraMap B_K S_K (π_K p) :=
      RingHom.congr_fun hφ_PSK_comp

    have hg_SKK : ∀ y : ↥q_K.primeCompl, IsUnit (Φ_K.toRingHom y.1) :=
      fun y => isUnit_iff_ne_zero.mpr y.2
    let φ_SKK : S_K →+* K := IsLocalization.lift (M := q_K.primeCompl) hg_SKK
    have hφ_SKK_comp : φ_SKK.comp (algebraMap B_K S_K) = Φ_K.toRingHom :=
      IsLocalization.lift_comp hg_SKK
    have hφ_SKK_app : ∀ b : B_K, φ_SKK (algebraMap B_K S_K b) = Φ_K b :=
      RingHom.congr_fun hφ_SKK_comp

    have hg_PPK : ∀ y : ↥Q_x.primeCompl,
        IsUnit (((algebraMap P_K P'_K).comp (MvPolynomial.map (algebraMap A₀ K))) y.1) := by
      intro y
      have hy_QK : MvPolynomial.map (algebraMap A₀ K) y.1 ∈ Q_K.primeCompl := by
        change Φ_K (π_K (MvPolynomial.map (algebraMap A₀ K) y.1)) ≠ 0
        rw [hΦπK_map y.1]
        exact y.2
      exact IsLocalization.map_units P'_K (⟨MvPolynomial.map (algebraMap A₀ K) y.1, hy_QK⟩ : ↥Q_K.primeCompl)
    let φ_PPK : P →+* P'_K := IsLocalization.lift (M := Q_x.primeCompl) hg_PPK
    have hφ_PPK_comp :
        φ_PPK.comp (algebraMap P₀ P) =
          (algebraMap P_K P'_K).comp (MvPolynomial.map (algebraMap A₀ K)) :=
      IsLocalization.lift_comp hg_PPK
    have hφ_PPK_app : ∀ p : P₀,
        φ_PPK (algebraMap P₀ P p) = algebraMap P_K P'_K (MvPolynomial.map (algebraMap A₀ K) p) :=
      RingHom.congr_fun hφ_PPK_comp

    letI instAlgPS : Algebra P S := φ_PS.toAlgebra
    letI instAlgSK : Algebra S K := φ_SK.toAlgebra
    letI instAlgPK : Algebra P K := (φ_SK.comp φ_PS).toAlgebra
    haveI : IsScalarTower P S K := IsScalarTower.of_algebraMap_eq' rfl
    haveI : SMulCommClass P K K :=
      ⟨fun p c x => by change φ_SK (φ_PS p) * (c * x) = c * (φ_SK (φ_PS p) * x); ring⟩

    letI instAlgPSK : Algebra P'_K S_K := φ_PSK.toAlgebra
    letI instAlgSKK : Algebra S_K K := φ_SKK.toAlgebra
    letI instAlgPK' : Algebra P'_K K := (φ_SKK.comp φ_PSK).toAlgebra
    haveI : IsScalarTower P'_K S_K K := IsScalarTower.of_algebraMap_eq' rfl
    haveI : SMulCommClass P'_K K K :=
      ⟨fun p c x => by change φ_SKK (φ_PSK p) * (c * x) = c * (φ_SKK (φ_PSK p) * x); ring⟩

    haveI : IsScalarTower A₀ P S := by
      apply IsScalarTower.of_algebraMap_eq
      intro a
      change algebraMap A₀ S a = φ_PS (algebraMap A₀ P a)
      have hAP : algebraMap A₀ P a = algebraMap P₀ P (MvPolynomial.C a) :=
        IsScalarTower.algebraMap_apply A₀ P₀ P a
      have hAS : algebraMap A₀ S a = algebraMap B₀ S (algebraMap A₀ B₀ a) :=
        IsScalarTower.algebraMap_apply A₀ B₀ S a
      rw [hAP, hAS, ← hπ₀_C_app a, hφ_PS_app]

    haveI : IsScalarTower K P'_K S_K := by
      apply IsScalarTower.of_algebraMap_eq
      intro c
      change algebraMap K S_K c = φ_PSK (algebraMap K P'_K c)
      have hKP : algebraMap K P'_K c = algebraMap P_K P'_K (MvPolynomial.C c) :=
        IsScalarTower.algebraMap_apply K P_K P'_K c
      have hKS : algebraMap K S_K c = algebraMap B_K S_K (algebraMap K B_K c) :=
        IsScalarTower.algebraMap_apply K B_K S_K c
      rw [hKP, hKS]
      have hπC : π_K (MvPolynomial.C c) = algebraMap K B_K c := MvPolynomial.aeval_C _ c
      rw [← hπC, hφ_PSK_app]

    obtain ⟨hSurj_PS, hMax_S, hmem_J, β₀, hβ₀_surj, _, hβ₀⟩ :=
      h_loc_ker P₀ B₀ P S π₀ hπ₀_surj ev_K.toRingHom q_x rfl Q_x rfl φ_PS φ_SK
        hφ_PS_comp hφ_SK_comp (fun _ => rfl) (fun _ => rfl)
    obtain ⟨hSurj_PSK, hMax_SK, hmem_JK, β_K, _, hβK_inj_fn, hβ_K⟩ :=
      h_loc_ker P_K B_K P'_K S_K π_K.toRingHom hπK_surj Φ_K.toRingHom q_K rfl Q_K rfl φ_PSK φ_SKK
        hφ_PSK_comp hφ_SKK_comp (fun _ => rfl) (fun _ => rfl)
    have hβK_inj : Function.Injective β_K := hβK_inj_fn hΦπK_surj

    have hPPK_K_hom : (φ_SKK.comp φ_PSK).comp φ_PPK = φ_SK.comp φ_PS := by
      apply IsLocalization.ringHom_ext Q_x.primeCompl
      apply RingHom.ext
      intro p
      simp only [RingHom.comp_apply]
      rw [hφ_PPK_app p, hφ_PSK_app _, hφ_SKK_app _, hφ_PS_app p, hφ_SK_app _]
      exact hΦπK_map p
    have hPPK_K : ∀ p : P, algebraMap P'_K K (φ_PPK p) = algebraMap P K p :=
      RingHom.congr_fun hPPK_K_hom

    letI instAlgPPK : Algebra P P'_K := φ_PPK.toAlgebra
    letI instAlgA₀PK' : Algebra A₀ P'_K := ((algebraMap K P'_K).comp (algebraMap A₀ K)).toAlgebra
    haveI : IsScalarTower A₀ K P'_K := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower A₀ P P'_K := by
      apply IsScalarTower.of_algebraMap_eq
      intro a
      change algebraMap K P'_K (algebraMap A₀ K a) = φ_PPK (algebraMap A₀ P a)
      have hAP : algebraMap A₀ P a = algebraMap P₀ P (MvPolynomial.C a) :=
        IsScalarTower.algebraMap_apply A₀ P₀ P a
      have hKPK : algebraMap K P'_K (algebraMap A₀ K a) =
          algebraMap P_K P'_K (MvPolynomial.C (algebraMap A₀ K a)) :=
        IsScalarTower.algebraMap_apply K P_K P'_K (algebraMap A₀ K a)
      rw [hAP, hKPK, hφ_PPK_app, MvPolynomial.map_C]
    haveI : SMulCommClass K P P'_K :=
      ⟨fun c p x => by
        change c • (φ_PPK p * x) = φ_PPK p * (c • x)
        rw [Algebra.smul_def, Algebra.smul_def]
        ring⟩

    let δ_Ω : Ω[P ⁄ A₀] →ₗ[P] Ω[P'_K ⁄ K] := KaehlerDifferential.map A₀ K P P'_K
    let θ_Ω : Ω[P ⁄ A₀] →+ Ω[P'_K ⁄ K] := δ_Ω.toAddMonoidHom
    have hθ_Ω : ∀ (p : P) (ω : Ω[P ⁄ A₀]), θ_Ω (p • ω) = φ_PPK p • θ_Ω ω :=
      fun p ω => δ_Ω.map_smul p ω
    obtain ⟨α_Ω, hα_Ω⟩ := mkBaseChangeHom φ_PPK hPPK_K θ_Ω hθ_Ω

    have hJ_fg : (RingHom.ker (algebraMap P S)).FG := IsNoetherian.noetherian _
    have hJK_fg : (RingHom.ker (algebraMap P'_K S_K)).FG := IsNoetherian.noetherian _

    let L₀ := KaehlerDifferential.cotangentComplexBaseChange A₀ S P K
    let L_K := KaehlerDifferential.cotangentComplexBaseChange K S_K P'_K K

    have hInj_LK : Function.Injective L_K :=
      (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange
        P'_K K hSurj_PSK hJK_fg hMax_SK).mp hFs_SK

    have hCommSq : ∀ u : TensorProduct P₀ K ↥I₀,
        α_Ω (L₀ (β₀ u)) = L_K (β_K (ψ_ker u)) := by
      intro u
      induction u using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | add u₁ u₂ hu₁ hu₂ =>
        simp only [map_add, hu₁, hu₂]
      | tmul c g =>
        rw [hβ₀ c g, hψ_ker c g, hβ_K c _]
        change α_Ω (KaehlerDifferential.cotangentComplexBaseChange A₀ S P K
            (c ⊗ₜ[P] ⟨algebraMap P₀ P g.1, hmem_J g⟩)) =
          KaehlerDifferential.cotangentComplexBaseChange K S_K P'_K K
            (c ⊗ₜ[P'_K] ⟨algebraMap P_K P'_K (MvPolynomial.map (algebraMap A₀ K) g.1), _⟩)
        rw [KaehlerDifferential.cotangentComplexBaseChange_tmul,
          KaehlerDifferential.cotangentComplexBaseChange_tmul]
        simp only [KaehlerDifferential.kerToTensor_apply, map_smul]
        rw [hα_Ω 1 (KaehlerDifferential.D A₀ P (algebraMap P₀ P g.1))]
        congr 1
        change (1 : K) ⊗ₜ[P'_K]
            (KaehlerDifferential.map A₀ K P P'_K
              (KaehlerDifferential.D A₀ P (algebraMap P₀ P g.1))) =
          (1 : K) ⊗ₜ[P'_K]
            KaehlerDifferential.D K P'_K
              (algebraMap P_K P'_K (MvPolynomial.map (algebraMap A₀ K) g.1))
        rw [KaehlerDifferential.map_D]
        congr 1
        change KaehlerDifferential.D K P'_K (φ_PPK (algebraMap P₀ P g.1)) =
          KaehlerDifferential.D K P'_K
            (algebraMap P_K P'_K (MvPolynomial.map (algebraMap A₀ K) g.1))
        rw [hφ_PPK_app g.1]

    have hInj_L₀ : Function.Injective L₀ := by
      rw [injective_iff_map_eq_zero]
      intro v hv
      obtain ⟨u, rfl⟩ := hβ₀_surj v
      have h0 : L_K (β_K (ψ_ker u)) = L_K (β_K (ψ_ker 0)) := by
        rw [← hCommSq u, hv, map_zero, map_zero, map_zero, map_zero]
      have hu0 : u = 0 := hψ_ker_inj (hβK_inj (hInj_LK h0))
      rw [hu0, map_zero]

    exact (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange
      P K hSurj_PS hJ_fg hMax_S).mpr hInj_L₀

  haveI hSmAt_qx : Algebra.IsSmoothAt A₀ q_x :=
    h_cotangent_descent (Localization.AtPrime Q_x) (Localization.AtPrime q_x)
      (Localization.AtPrime Q_K) (Localization.AtPrime q_K) hFs_K

  
  obtain ⟨h_B, hhB_not_mem, hStd_hB⟩ :=
    Algebra.IsSmoothAt.exists_notMem_isStandardSmooth A₀ q_x
  have hev_hB : ev_K h_B ≠ 0 := hhB_not_mem

  
  obtain ⟨ι_s, σ_s, hFinσ, hFinι, ⟨P_sub⟩⟩ := hStd_hB.out
  letI := hFinσ
  letI := hFinι
  let d : ℕ := P_sub.dimension
  let L_B := Localization.Away h_B
  haveI hSm_d_LB : Algebra.IsStandardSmoothOfRelativeDimension d A₀ L_B :=
    P_sub.isStandardSmoothOfRelativeDimension rfl
  let T₁ := TensorProduct A₀ K L_B
  haveI hSm_d_T₁ : Algebra.IsStandardSmoothOfRelativeDimension d K T₁ :=
    Algebra.IsStandardSmoothOfRelativeDimension.baseChange d K

  let f_K : B_K := (1 : K) ⊗ₜ[A₀] h_B
  let T₂ := Localization.Away f_K
  have hfK_unit_T₂ :
      IsUnit (((algebraMap B_K T₂).comp Algebra.TensorProduct.includeRight.toRingHom) h_B) := by
    change IsUnit (algebraMap B_K T₂ f_K)
    exact IsLocalization.Away.algebraMap_isUnit f_K
  let α_LB_ring : L_B →+* T₂ := IsLocalization.Away.lift h_B hfK_unit_T₂
  have hα_LB_comp :
      α_LB_ring.comp (algebraMap B₀ L_B) =
        (algebraMap B_K T₂).comp Algebra.TensorProduct.includeRight.toRingHom :=
    IsLocalization.Away.lift_comp h_B hfK_unit_T₂
  have hα_LB_app : ∀ b : B₀,
      α_LB_ring (algebraMap B₀ L_B b) = algebraMap B_K T₂ ((1 : K) ⊗ₜ[A₀] b) :=
    RingHom.congr_fun hα_LB_comp
  let α_LB_alg : L_B →ₐ[A₀] T₂ :=
    { α_LB_ring with
      commutes' := fun a => by
        change α_LB_ring (algebraMap B₀ L_B (algebraMap A₀ B₀ a)) =
          algebraMap B_K T₂ (algebraMap A₀ B_K a)
        rw [hα_LB_app (algebraMap A₀ B₀ a)]
        change algebraMap B_K T₂ ((1 : K) ⊗ₜ[A₀] algebraMap A₀ B₀ a) =
          algebraMap B_K T₂ ((algebraMap A₀ K a) ⊗ₜ[A₀] (1 : B₀))
        congr 1
        calc (1 : K) ⊗ₜ[A₀] algebraMap A₀ B₀ a
            = (1 : K) ⊗ₜ[A₀] (a • (1 : B₀)) := by rw [Algebra.smul_def, mul_one]
          _ = (a • (1 : K)) ⊗ₜ[A₀] (1 : B₀) := (TensorProduct.smul_tmul a (1 : K) (1 : B₀)).symm
          _ = (algebraMap A₀ K a) ⊗ₜ[A₀] (1 : B₀) := by rw [Algebra.smul_def, mul_one] }
  let α_fib : T₁ →ₐ[K] T₂ :=
    Algebra.TensorProduct.lift (Algebra.ofId K T₂) α_LB_alg (fun _ _ => mul_comm _ _)

  let ι_BK_T₁ : B_K →ₐ[K] T₁ :=
    Algebra.TensorProduct.map (AlgHom.id K K) (IsScalarTower.toAlgHom A₀ B₀ L_B)
  have hfK_unit_T₁ : IsUnit (ι_BK_T₁.toRingHom f_K) := by
    refine isUnit_iff_exists_inv.mpr ⟨(1 : K) ⊗ₜ[A₀] IsLocalization.Away.invSelf (S := L_B) h_B, ?_⟩
    change ι_BK_T₁ ((1 : K) ⊗ₜ[A₀] h_B) *
        ((1 : K) ⊗ₜ[A₀] IsLocalization.Away.invSelf (S := L_B) h_B) = 1
    rw [Algebra.TensorProduct.map_tmul]
    change ((1 : K) ⊗ₜ[A₀] algebraMap B₀ L_B h_B) *
        ((1 : K) ⊗ₜ[A₀] IsLocalization.Away.invSelf (S := L_B) h_B) = 1
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, IsLocalization.Away.mul_invSelf h_B]
    rfl
  let β_fib_ring : T₂ →+* T₁ := IsLocalization.Away.lift f_K hfK_unit_T₁
  have hβ_fib_comp : β_fib_ring.comp (algebraMap B_K T₂) = ι_BK_T₁.toRingHom :=
    IsLocalization.Away.lift_comp f_K hfK_unit_T₁
  have hβ_fib_app : ∀ z : B_K, β_fib_ring (algebraMap B_K T₂ z) = ι_BK_T₁ z :=
    RingHom.congr_fun hβ_fib_comp
  let β_fib : T₂ →ₐ[K] T₁ :=
    { β_fib_ring with
      commutes' := fun c => by
        change β_fib_ring (algebraMap B_K T₂ (algebraMap K B_K c)) = algebraMap K T₁ c
        rw [hβ_fib_app (algebraMap K B_K c)]
        exact ι_BK_T₁.commutes c }

  have hα_fib_lift : ∀ (c : K) (y : L_B),
      α_fib (c ⊗ₜ[A₀] y) = (Algebra.ofId K T₂) c * α_LB_alg y :=
    fun c y => Algebra.TensorProduct.lift_tmul (Algebra.ofId K T₂) α_LB_alg
      (fun _ _ => mul_comm _ _) c y

  have hα_fib_tmul : ∀ b : B₀,
      α_fib ((1 : K) ⊗ₜ[A₀] algebraMap B₀ L_B b) = algebraMap B_K T₂ ((1 : K) ⊗ₜ[A₀] b) := by
    intro b
    rw [hα_fib_lift, map_one, one_mul]
    exact hα_LB_app b

  have hβ_α : β_fib.comp α_fib = AlgHom.id K T₁ := by
    apply Algebra.TensorProduct.ext
    · ext
    · apply AlgHom.coe_ringHom_injective
      apply IsLocalization.ringHom_ext (Submonoid.powers h_B)
      ext b
      simp only [AlgHom.comp_toRingHom, RingHom.comp_apply]
      change β_fib_ring (α_fib ((1 : K) ⊗ₜ[A₀] algebraMap B₀ L_B b)) =
        (1 : K) ⊗ₜ[A₀] algebraMap B₀ L_B b
      rw [hα_fib_tmul b, hβ_fib_app ((1 : K) ⊗ₜ[A₀] b)]
      exact Algebra.TensorProduct.map_tmul _ _ _ _

  have hα_β : α_fib.comp β_fib = AlgHom.id K T₂ := by
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (Submonoid.powers f_K)
    have hcomp_BK : (α_fib.toRingHom.comp β_fib_ring).comp (algebraMap B_K T₂) =
        algebraMap B_K T₂ := by
      rw [RingHom.comp_assoc, hβ_fib_comp]
      change (α_fib.comp ι_BK_T₁).toRingHom = (IsScalarTower.toAlgHom K B_K T₂).toRingHom
      congr 1
      apply Algebra.TensorProduct.ext
      · ext
      · ext b
        change α_fib (ι_BK_T₁ ((1 : K) ⊗ₜ[A₀] b)) = algebraMap B_K T₂ ((1 : K) ⊗ₜ[A₀] b)
        rw [Algebra.TensorProduct.map_tmul]
        exact hα_fib_tmul b
    exact hcomp_BK

  let e_fib : T₁ ≃ₐ[K] T₂ :=
    AlgEquiv.ofAlgHom α_fib β_fib hα_β hβ_α
  have hSm_d_T₂ : Algebra.IsStandardSmoothOfRelativeDimension d K T₂ :=
    @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv d K T₁ _ _ _ T₂ _ _ e_fib hSm_d_T₁

  let g_K : B_K := f_K * h_K
  let T₁₂ := Localization.Away g_K
  have hΦ_gK_ne : Φ_K g_K ≠ 0 := by
    change Φ_K (f_K * h_K) ≠ 0
    rw [map_mul]
    have hΦ_fK : Φ_K f_K = ev_K h_B := by
      rw [hΦ_tmul, one_mul]
    rw [hΦ_fK]
    exact mul_ne_zero hev_hB hh_K
  have hNontriv_T₁₂ : Nontrivial T₁₂ := by
    let φ_T₁₂_K : T₁₂ →+* K :=
      IsLocalization.Away.lift g_K (g := Φ_K.toRingHom) (isUnit_iff_ne_zero.mpr hΦ_gK_ne)
    exact φ_T₁₂_K.domain_nontrivial

  have hCompZero : ∀ (n : ℕ) (A B : Type u) [CommRing A] [CommRing B]
      [Algebra K A] [Algebra A B] [Algebra K B] [IsScalarTower K A B],
      Algebra.IsStandardSmoothOfRelativeDimension n K A →
      Algebra.IsStandardSmoothOfRelativeDimension 0 A B →
      Algebra.IsStandardSmoothOfRelativeDimension n K B := by
    intro n A B _ _ _ _ _ _ hSmKA hSmAB
    have hKA : RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap K A) :=
      (@RingHom.isStandardSmoothOfRelativeDimension_algebraMap n K A _ _ _).mpr hSmKA
    have hAB : RingHom.IsStandardSmoothOfRelativeDimension 0 (algebraMap A B) :=
      (@RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0 A B _ _ _).mpr hSmAB
    have hComp := RingHom.IsStandardSmoothOfRelativeDimension.comp hAB hKA
    rw [Nat.zero_add, ← IsScalarTower.algebraMap_eq K A B] at hComp
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mp hComp

  let T₂' := Localization.Away (algebraMap B_K T₂ h_K)
  have hSm_0_T₂' : Algebra.IsStandardSmoothOfRelativeDimension 0 T₂ T₂' :=
    Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap B_K T₂ h_K)
  have hSm_d_T₂' : Algebra.IsStandardSmoothOfRelativeDimension d K T₂' :=
    hCompZero d T₂ T₂' hSm_d_T₂ hSm_0_T₂'
  haveI : IsLocalization.Away (f_K * h_K) T₂' :=
    IsLocalization.Away.mul' T₂ T₂' f_K h_K
  haveI : IsScalarTower K B_K T₂' :=
    IsScalarTower.of_algebraMap_eq fun c => by
      calc algebraMap K T₂' c
          = algebraMap T₂ T₂' (algebraMap K T₂ c) :=
            IsScalarTower.algebraMap_apply K T₂ T₂' c
        _ = algebraMap T₂ T₂' (algebraMap B_K T₂ (algebraMap K B_K c)) := by
            rw [IsScalarTower.algebraMap_apply K B_K T₂ c]
        _ = algebraMap B_K T₂' (algebraMap K B_K c) :=
            (IsScalarTower.algebraMap_apply B_K T₂ T₂' (algebraMap K B_K c)).symm
  let e_T₂'_T₁₂ : T₂' ≃ₐ[K] T₁₂ :=
    (IsLocalization.algEquiv (Submonoid.powers g_K) T₂' T₁₂).restrictScalars K
  have hSm_d_T₁₂ : Algebra.IsStandardSmoothOfRelativeDimension d K T₁₂ :=
    @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv d K T₂' _ _ _ T₁₂ _ _
      e_T₂'_T₁₂ hSm_d_T₂'

  let L_K_away := Localization.Away h_K
  let L_K_away' := Localization.Away (algebraMap B_K L_K_away f_K)
  have hSm_0_LK' : Algebra.IsStandardSmoothOfRelativeDimension 0 L_K_away L_K_away' :=
    Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap B_K L_K_away f_K)
  have hSm_1_LK' : Algebra.IsStandardSmoothOfRelativeDimension 1 K L_K_away' :=
    hCompZero 1 L_K_away L_K_away' hSm_K hSm_0_LK'
  have hAway_hf : IsLocalization.Away (h_K * f_K) L_K_away' :=
    IsLocalization.Away.mul' L_K_away L_K_away' h_K f_K
  haveI : IsLocalization.Away g_K L_K_away' := by
    change IsLocalization (Submonoid.powers (f_K * h_K)) L_K_away'
    rw [mul_comm f_K h_K]
    exact hAway_hf
  haveI : IsScalarTower K B_K L_K_away' :=
    IsScalarTower.of_algebraMap_eq fun c => by
      calc algebraMap K L_K_away' c
          = algebraMap L_K_away L_K_away' (algebraMap K L_K_away c) :=
            IsScalarTower.algebraMap_apply K L_K_away L_K_away' c
        _ = algebraMap L_K_away L_K_away' (algebraMap B_K L_K_away (algebraMap K B_K c)) := by
            rw [IsScalarTower.algebraMap_apply K B_K L_K_away c]
        _ = algebraMap B_K L_K_away' (algebraMap K B_K c) :=
            (IsScalarTower.algebraMap_apply B_K L_K_away L_K_away' (algebraMap K B_K c)).symm
  let e_LK'_T₁₂ : L_K_away' ≃ₐ[K] T₁₂ :=
    (IsLocalization.algEquiv (Submonoid.powers g_K) L_K_away' T₁₂).restrictScalars K
  have hSm_1_T₁₂ : Algebra.IsStandardSmoothOfRelativeDimension 1 K T₁₂ :=
    @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 K L_K_away' _ _ _ T₁₂ _ _
      e_LK'_T₁₂ hSm_1_LK'

  have hd_eq_one : d = 1 := by
    have hRank_d : Module.rank T₁₂ Ω[T₁₂ ⁄ K] = (d : Cardinal.{u}) :=
      @Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
        K T₁₂ _ _ _ hNontriv_T₁₂ d hSm_d_T₁₂
    have hRank_1 : Module.rank T₁₂ Ω[T₁₂ ⁄ K] = (1 : Cardinal.{u}) :=
      @Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
        K T₁₂ _ _ _ hNontriv_T₁₂ 1 hSm_1_T₁₂
    have hCast : (d : Cardinal.{u}) = ((1 : ℕ) : Cardinal.{u}) := by
      simpa using hRank_d.symm.trans hRank_1
    exact Nat.cast_injective hCast

  refine ⟨h_B, hev_hB, ?_⟩
  intro B_loc _ _ _
  letI : Algebra A₀ B_loc := ((algebraMap B₀ B_loc).comp (algebraMap A₀ B₀)).toAlgebra
  haveI : IsScalarTower A₀ B₀ B_loc := IsScalarTower.of_algebraMap_eq' rfl
  let e_Bloc : L_B ≃ₐ[A₀] B_loc :=
    (IsLocalization.algEquiv (Submonoid.powers h_B) L_B B_loc).restrictScalars A₀
  have hSm_d_Bloc : Algebra.IsStandardSmoothOfRelativeDimension d A₀ B_loc :=
    @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv d A₀ L_B _ _ _ B_loc _ _
      e_Bloc hSm_d_LB
  rw [hd_eq_one] at hSm_d_Bloc
  exact (@RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1 A₀ B_loc _ _ _).mpr hSm_d_Bloc

theorem weil_etale_nodal_roof_residue_separable_and_artinian_dims (κ K B_κ : Type u) [Field κ] [Field K] [IsAlgClosed K]
    [CommRing B_κ] [Algebra κ K] [Algebra κ B_κ] [Algebra.FiniteType κ B_κ]
    (ev_K : B_κ →ₐ[κ] K)
    (A' : Type u) [CommRing A'] [Algebra K A']
    (u₀ : PrimeSpectrum A')
    (φ₁ : TensorProduct κ K B_κ →ₐ[K] A')
    (φ₂ : (MvPolynomial (Fin 2) K ⧸
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K) *
        (MvPolynomial.X 1 : MvPolynomial (Fin 2) K)}) →ₐ[K] A')
    (hEt₁ : RingHom.Etale φ₁.toRingHom)
    (hEt₂ : RingHom.Etale φ₂.toRingHom)
    (hComap₁ : Ideal.comap φ₁.toRingHom u₀.asIdeal =
      RingHom.ker (Algebra.TensorProduct.lift (AlgHom.id K K) ev_K
        (fun _ _ => mul_comm _ _)).toRingHom)
    (hX_mem : ∀ i : Fin 2,
      φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K)) ∈ u₀.asIdeal) :
    let q_bar : Ideal B_κ := RingHom.ker ev_K.toRingHom
    haveI : q_bar.IsPrime := RingHom.ker_isPrime ev_K.toRingHom
    let O_x := Localization.AtPrime q_bar
    let m_x := IsLocalRing.maximalIdeal O_x
    let E := IsLocalRing.ResidueField O_x
    q_bar.IsMaximal ∧
    Algebra.IsSeparable κ E ∧
    FiniteDimensional κ E ∧
    ∀ d : ℕ, Module.finrank κ (O_x ⧸ m_x ^ (d + 1)) = Module.finrank κ E * (1 + 2 * d) :=
by
  classical
  
  let finTwoQuotBaseChange : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      (a₀ a₁ : A),
      TensorProduct A B ((Fin 2 → A) ⧸ Submodule.span A {![a₁, a₀]}) ≃ₗ[B]
        ((Fin 2 → B) ⧸ Submodule.span B {![algebraMap A B a₁, algebraMap A B a₀]}) :=
    fun A B _ _ _ a₀ a₁ => by
      let N_A : Submodule A (Fin 2 → A) := Submodule.span A {![a₁, a₀]}
      let N_B : Submodule B (Fin 2 → B) := Submodule.span B {![algebraMap A B a₁, algebraMap A B a₀]}
      let f_vec : (Fin 2 → A) →ₗ[A] (Fin 2 → B) :=
        { toFun := fun v i => algebraMap A B (v i)
          map_add' := fun u v => by ext i; simp
          map_smul' := fun c v => by ext i; simp [Algebra.smul_def] }
      let f₀ : (Fin 2 → A) →ₗ[A] ((Fin 2 → B) ⧸ N_B) :=
        ((Submodule.mkQ N_B).restrictScalars A).comp f_vec
      have hf₀ : N_A ≤ LinearMap.ker f₀ := by
        rw [Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]
        change Submodule.mkQ N_B (fun i => algebraMap A B (![a₁, a₀] i)) = 0
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        have h_eq : (fun i : Fin 2 => algebraMap A B (![a₁, a₀] i)) =
            ![algebraMap A B a₁, algebraMap A B a₀] := by
          ext i; fin_cases i <;> rfl
        rw [h_eq]
        exact Submodule.subset_span rfl
      let f_quot : ((Fin 2 → A) ⧸ N_A) →ₗ[A] ((Fin 2 → B) ⧸ N_B) :=
        Submodule.liftQ N_A f₀ hf₀
      let fwd_bilin : B →ₗ[A] ((Fin 2 → A) ⧸ N_A) →ₗ[A] ((Fin 2 → B) ⧸ N_B) :=
        { toFun := fun b =>
            { toFun := fun q => b • f_quot q
              map_add' := fun x y => by rw [map_add, smul_add]
              map_smul' := fun c x => by rw [map_smul, RingHom.id_apply, smul_comm] }
          map_add' := fun b₁ b₂ => by
            apply LinearMap.ext; intro q; exact add_smul b₁ b₂ (f_quot q)
          map_smul' := fun c b => by
            apply LinearMap.ext; intro q
            change (c • b) • f_quot q = c • (b • f_quot q)
            exact smul_assoc c b (f_quot q) }
      let fwd : TensorProduct A B ((Fin 2 → A) ⧸ N_A) →ₗ[B] ((Fin 2 → B) ⧸ N_B) :=
        { toFun := TensorProduct.lift fwd_bilin
          map_add' := map_add _
          map_smul' := fun b z => by
            induction z using TensorProduct.induction_on with
            | zero => rw [smul_zero, map_zero, smul_zero]
            | tmul b' q =>
              rw [RingHom.id_apply, TensorProduct.smul_tmul', smul_eq_mul,
                TensorProduct.lift.tmul, TensorProduct.lift.tmul]
              exact mul_smul b b' (f_quot q)
            | add x y hx hy =>
              rw [RingHom.id_apply] at hx hy ⊢
              rw [smul_add, map_add, map_add, smul_add, hx, hy] }
      let e₀ : (Fin 2 → A) ⧸ N_A := Submodule.Quotient.mk ![1, 0]
      let e₁ : (Fin 2 → A) ⧸ N_A := Submodule.Quotient.mk ![0, 1]
      let g₀ : (Fin 2 → B) →ₗ[B] TensorProduct A B ((Fin 2 → A) ⧸ N_A) :=
        { toFun := fun u => u 0 ⊗ₜ[A] e₀ + u 1 ⊗ₜ[A] e₁
          map_add' := fun u v => by simp [TensorProduct.add_tmul, add_add_add_comm]
          map_smul' := fun b u => by simp [Pi.smul_apply, smul_add, TensorProduct.smul_tmul'] }
      have hg₀ : N_B ≤ LinearMap.ker g₀ := by
        rw [Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]
        change algebraMap A B a₁ ⊗ₜ[A] e₀ + algebraMap A B a₀ ⊗ₜ[A] e₁ = 0
        have h₁ : algebraMap A B a₁ ⊗ₜ[A] e₀ = (1 : B) ⊗ₜ[A] (a₁ • e₀) := by
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        have h₂ : algebraMap A B a₀ ⊗ₜ[A] e₁ = (1 : B) ⊗ₜ[A] (a₀ • e₁) := by
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rw [h₁, h₂, ← TensorProduct.tmul_add]
        have h_zero : a₁ • e₀ + a₀ • e₁ = 0 := by
          change Submodule.Quotient.mk (a₁ • (![1, 0] : Fin 2 → A) + a₀ • ![0, 1]) = 0
          rw [Submodule.Quotient.mk_eq_zero]
          have h_vec : a₁ • (![1, 0] : Fin 2 → A) + a₀ • ![0, 1] = ![a₁, a₀] := by
            ext i; fin_cases i <;> simp
          rw [h_vec]
          exact Submodule.subset_span rfl
        rw [h_zero, TensorProduct.tmul_zero]
      let bwd : ((Fin 2 → B) ⧸ N_B) →ₗ[B] TensorProduct A B ((Fin 2 → A) ⧸ N_A) :=
        Submodule.liftQ N_B g₀ hg₀
      exact (LinearEquiv.ofLinearMap bwd fwd
        (by
          apply LinearMap.ext
          intro z
          simp only [LinearMap.comp_apply, LinearMap.id_apply]
          induction z using TensorProduct.induction_on with
          | zero => rw [map_zero, map_zero]
          | tmul b q =>
            obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective N_A q
            have hfwd : fwd (b ⊗ₜ[A] Submodule.Quotient.mk v) =
                b • Submodule.Quotient.mk (f_vec v) := rfl
            rw [hfwd, map_smul]
            have hbwd : bwd (Submodule.Quotient.mk (f_vec v)) =
                algebraMap A B (v 0) ⊗ₜ[A] e₀ + algebraMap A B (v 1) ⊗ₜ[A] e₁ := rfl
            rw [hbwd]
            have hv0 : algebraMap A B (v 0) ⊗ₜ[A] e₀ = (1 : B) ⊗ₜ[A] (v 0 • e₀) := by
              rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
            have hv1 : algebraMap A B (v 1) ⊗ₜ[A] e₁ = (1 : B) ⊗ₜ[A] (v 1 • e₁) := by
              rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
            rw [hv0, hv1, ← TensorProduct.tmul_add, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            congr 1
            change Submodule.Quotient.mk (v 0 • (![1, 0] : Fin 2 → A) + v 1 • ![0, 1]) =
              Submodule.Quotient.mk v
            congr 1
            ext i
            fin_cases i <;> simp
          | add x y hx hy => rw [map_add, map_add, hx, hy])
        (by
          apply LinearMap.ext
          intro w
          simp only [LinearMap.comp_apply, LinearMap.id_apply]
          obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective N_B w
          have hbwd : bwd (Submodule.Quotient.mk u) = u 0 ⊗ₜ[A] e₀ + u 1 ⊗ₜ[A] e₁ := rfl
          rw [hbwd, map_add]
          have hf0 : fwd (u 0 ⊗ₜ[A] e₀) = u 0 • Submodule.Quotient.mk (f_vec ![1, 0]) := rfl
          have hf1 : fwd (u 1 ⊗ₜ[A] e₁) = u 1 • Submodule.Quotient.mk (f_vec ![0, 1]) := rfl
          rw [hf0, hf1, ← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_smul,
            ← Submodule.Quotient.mk_add]
          congr 1
          ext i
          fin_cases i <;> simp [f_vec])).symm
  
  let tensorQuotIdealEquiv : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S]
      (I : Ideal A) (J : Ideal S),
      Ideal.map (algebraMap A S) I = J →
      TensorProduct A S (A ⧸ I) ≃ₗ[S] (S ⧸ J) :=
    fun A S _ _ _ I J hIJ => by
      have hI_le : I ≤ Ideal.comap (algebraMap A S) J := by
        rw [← hIJ]; exact Ideal.le_comap_map
      let f₀ : A →ₗ[A] (S ⧸ J) :=
        { toFun := fun a => Ideal.Quotient.mk J (algebraMap A S a)
          map_add' := fun x y => by simp [map_add]
          map_smul' := fun c x => by
            rw [smul_eq_mul, map_mul, RingHom.id_apply, Algebra.smul_def]
            rfl }
      have hf₀ : I ≤ LinearMap.ker f₀ := by
        intro a ha
        rw [LinearMap.mem_ker]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hI_le ha)
      let f_quot : (A ⧸ I) →ₗ[A] (S ⧸ J) := Submodule.liftQ I f₀ hf₀
      let fwd_bilin : S →ₗ[A] (A ⧸ I) →ₗ[A] (S ⧸ J) :=
        { toFun := fun s =>
            { toFun := fun q => s • f_quot q
              map_add' := fun x y => by rw [map_add, smul_add]
              map_smul' := fun c x => by rw [map_smul, RingHom.id_apply, smul_comm] }
          map_add' := fun s₁ s₂ => by
            apply LinearMap.ext; intro q; exact add_smul s₁ s₂ (f_quot q)
          map_smul' := fun c s => by
            apply LinearMap.ext; intro q
            change (c • s) • f_quot q = c • (s • f_quot q)
            exact smul_assoc c s (f_quot q) }
      let fwd : TensorProduct A S (A ⧸ I) →ₗ[S] (S ⧸ J) :=
        { toFun := TensorProduct.lift fwd_bilin
          map_add' := map_add _
          map_smul' := fun s z => by
            induction z using TensorProduct.induction_on with
            | zero => rw [smul_zero, map_zero, smul_zero]
            | tmul s' q =>
              rw [RingHom.id_apply, TensorProduct.smul_tmul', smul_eq_mul,
                TensorProduct.lift.tmul, TensorProduct.lift.tmul]
              exact mul_smul s s' (f_quot q)
            | add x y hx hy =>
              rw [RingHom.id_apply] at hx hy ⊢
              rw [smul_add, map_add, map_add, smul_add, hx, hy] }
      let g₀ : S →ₗ[S] TensorProduct A S (A ⧸ I) :=
        { toFun := fun s => s ⊗ₜ[A] Ideal.Quotient.mk I 1
          map_add' := fun s₁ s₂ => by simp [TensorProduct.add_tmul]
          map_smul' := fun s₁ s₂ => by simp [TensorProduct.smul_tmul'] }
      have hg₀ : J ≤ LinearMap.ker g₀ := by
        rw [← hIJ, Ideal.map, Submodule.span_le]
        rintro _ ⟨a, ha, rfl⟩
        rw [SetLike.mem_coe, LinearMap.mem_ker]
        change algebraMap A S a ⊗ₜ[A] Ideal.Quotient.mk I 1 = 0
        have h_smul : algebraMap A S a ⊗ₜ[A] Ideal.Quotient.mk I (1 : A) =
            (1 : S) ⊗ₜ[A] (a • Ideal.Quotient.mk I (1 : A)) := by
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rw [h_smul]
        have ha0 : a • Ideal.Quotient.mk I (1 : A) = 0 := by
          change Ideal.Quotient.mk I (a * 1) = 0
          rw [mul_one]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
        rw [ha0, TensorProduct.tmul_zero]
      let bwd : (S ⧸ J) →ₗ[S] TensorProduct A S (A ⧸ I) := Submodule.liftQ J g₀ hg₀
      exact (LinearEquiv.ofLinearMap bwd fwd
        (by
          apply LinearMap.ext
          intro z
          simp only [LinearMap.comp_apply, LinearMap.id_apply]
          induction z using TensorProduct.induction_on with
          | zero => rw [map_zero, map_zero]
          | tmul s q =>
            obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective I q
            have hfwd : fwd (s ⊗ₜ[A] Submodule.Quotient.mk a) =
                s • Ideal.Quotient.mk J (algebraMap A S a) := rfl
            rw [hfwd, map_smul]
            have hbwd : bwd (Ideal.Quotient.mk J (algebraMap A S a)) =
                algebraMap A S a ⊗ₜ[A] Ideal.Quotient.mk I 1 := rfl
            rw [hbwd]
            have h_smul : algebraMap A S a ⊗ₜ[A] Ideal.Quotient.mk I (1 : A) =
                (1 : S) ⊗ₜ[A] Submodule.Quotient.mk a := by
              have h1 : algebraMap A S a = a • (1 : S) := by rw [Algebra.smul_def, mul_one]
              rw [h1, TensorProduct.smul_tmul]
              congr 1
              change Ideal.Quotient.mk I (a * 1) = Submodule.Quotient.mk a
              rw [mul_one]
              rfl
            rw [h_smul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          | add x y hx hy => rw [map_add, map_add, hx, hy])
        (by
          apply LinearMap.ext
          intro w
          simp only [LinearMap.comp_apply, LinearMap.id_apply]
          obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective J w
          have hbwd : bwd (Submodule.Quotient.mk s) = s ⊗ₜ[A] Ideal.Quotient.mk I 1 := rfl
          rw [hbwd]
          change s • Ideal.Quotient.mk J (algebraMap A S 1) = Submodule.Quotient.mk s
          rw [map_one]
          change Ideal.Quotient.mk J (s * 1) = Ideal.Quotient.mk J s
          rw [mul_one])).symm
  
  have h_s2 : ∀ (O S M : Type u) [CommRing O] [IsLocalRing O] [AddCommGroup M] [Module O M]
      [CommRing S] [IsLocalRing S] [Algebra O S] [IsLocalHom (algebraMap O S)]
      (x₀ x₁ : S),
      Ideal.span {x₀, x₁} = IsLocalRing.maximalIdeal S →
      Nonempty (TensorProduct O S M ≃ₗ[S]
        ((Fin 2 → S) ⧸ Submodule.span S {![x₁, x₀]})) →
      Ideal.map (algebraMap O S) (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal S := by
    intro O S M _ _ _ _ _ _ _ _ x₀ x₁ hSpan hPres
    obtain ⟨e_S⟩ := hPres
    let m_O := IsLocalRing.maximalIdeal O
    let E_O := IsLocalRing.ResidueField O
    let m_S := IsLocalRing.maximalIdeal S
    let k_S := IsLocalRing.ResidueField S
    let I_Q : Ideal S := Ideal.map (algebraMap O S) m_O
    have hmO_le : m_O ≤ Ideal.comap (algebraMap O S) m_S := by
      intro y hy
      rw [Ideal.mem_comap]
      by_contra h_not
      have hu : IsUnit (algebraMap O S y) := IsLocalRing.notMem_maximalIdeal.mp h_not
      exact IsLocalRing.notMem_maximalIdeal.mpr (isUnit_of_map_unit (algebraMap O S) y hu) hy
    have hIQ_le : I_Q ≤ m_S := Ideal.map_le_iff_le_comap.mpr hmO_le
    let Q := S ⧸ I_Q
    let q_Q : S →+* Q := Ideal.Quotient.mk I_Q
    have hmO_ker : ∀ y ∈ m_O, (q_Q.comp (algebraMap O S)) y = 0 := by
      intro y hy
      change Ideal.Quotient.mk I_Q (algebraMap O S y) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem (algebraMap O S) hy
    let ι_EQ : E_O →+* Q := Ideal.Quotient.lift m_O (q_Q.comp (algebraMap O S)) hmO_ker
    let π_Qk : Q →+* k_S := Ideal.Quotient.factor hIQ_le
    letI : Algebra E_O Q := ι_EQ.toAlgebra
    letI : Algebra Q k_S := π_Qk.toAlgebra
    have : IsScalarTower O E_O Q := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have : IsScalarTower S Q k_S := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have : IsScalarTower E_O Q k_S :=
      IsScalarTower.of_algebraMap_eq fun e => by
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective e
        rfl
    let M_E := TensorProduct O E_O M
    let e_cancel_EQ : TensorProduct E_O Q M_E ≃ₗ[Q] TensorProduct O Q M :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange O E_O Q Q M
    let e_cancel_SQ : TensorProduct S Q (TensorProduct O S M) ≃ₗ[Q] TensorProduct O Q M :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange O S Q Q M
    let e_S_Q : TensorProduct S Q (TensorProduct O S M) ≃ₗ[Q]
        TensorProduct S Q ((Fin 2 → S) ⧸ Submodule.span S {![x₁, x₀]}) :=
      LinearEquiv.baseChange S Q _ _ e_S
    let e_quot_SQ : TensorProduct S Q ((Fin 2 → S) ⧸ Submodule.span S {![x₁, x₀]}) ≃ₗ[Q]
        ((Fin 2 → Q) ⧸ Submodule.span Q {![q_Q x₁, q_Q x₀]}) :=
      finTwoQuotBaseChange S Q x₀ x₁
    let Ψ_Q : TensorProduct E_O Q M_E ≃ₗ[Q]
        ((Fin 2 → Q) ⧸ Submodule.span Q {![q_Q x₁, q_Q x₀]}) :=
      ((e_cancel_EQ.trans e_cancel_SQ.symm).trans e_S_Q).trans e_quot_SQ
    let e_cancel_Qk : TensorProduct Q k_S (TensorProduct E_O Q M_E) ≃ₗ[k_S]
        TensorProduct E_O k_S M_E :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange E_O Q k_S k_S M_E
    let e_Ψ_k : TensorProduct Q k_S (TensorProduct E_O Q M_E) ≃ₗ[k_S]
        TensorProduct Q k_S ((Fin 2 → Q) ⧸ Submodule.span Q {![q_Q x₁, q_Q x₀]}) :=
      LinearEquiv.baseChange Q k_S _ _ Ψ_Q
    let e_quot_Qk : TensorProduct Q k_S
        ((Fin 2 → Q) ⧸ Submodule.span Q {![q_Q x₁, q_Q x₀]}) ≃ₗ[k_S]
        ((Fin 2 → k_S) ⧸ Submodule.span k_S {![π_Qk (q_Q x₁), π_Qk (q_Q x₀)]}) :=
      finTwoQuotBaseChange Q k_S (q_Q x₀) (q_Q x₁)
    have hx₀_mem : x₀ ∈ m_S := by
      change x₀ ∈ IsLocalRing.maximalIdeal S
      rw [← hSpan]; exact Ideal.subset_span (Set.mem_insert x₀ {x₁})
    have hx₁_mem : x₁ ∈ m_S := by
      change x₁ ∈ IsLocalRing.maximalIdeal S
      rw [← hSpan]; exact Ideal.subset_span (Set.mem_insert_of_mem x₀ rfl)
    have hx₀_k : π_Qk (q_Q x₀) = 0 := by
      change Ideal.Quotient.mk m_S x₀ = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hx₀_mem
    have hx₁_k : π_Qk (q_Q x₁) = 0 := by
      change Ideal.Quotient.mk m_S x₁ = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hx₁_mem
    have hSpanBot : Submodule.span k_S {![π_Qk (q_Q x₁), π_Qk (q_Q x₀)]} = ⊥ := by
      rw [hx₀_k, hx₁_k]
      have h0 : (![(0 : k_S), 0] : Fin 2 → k_S) = 0 := by ext i; fin_cases i <;> rfl
      rw [h0, Submodule.span_zero_singleton]
    let e_bot : ((Fin 2 → k_S) ⧸ Submodule.span k_S {![π_Qk (q_Q x₁), π_Qk (q_Q x₀)]}) ≃ₗ[k_S]
        (Fin 2 → k_S) :=
      Submodule.quotEquivOfEqBot _ hSpanBot
    let Ψ_k : TensorProduct E_O k_S M_E ≃ₗ[k_S] (Fin 2 → k_S) :=
