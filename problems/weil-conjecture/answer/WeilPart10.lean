        have hfX : f (MvPolynomial.X m) = W m := MvPolynomial.eval₂Hom_X' _ _ m
        have hf'X : f' (MvPolynomial.X m) = W' m := MvPolynomial.eval₂Hom_X' _ _ m
        rw [map_mul, map_mul, hfX, hf'X, hd_mul]
        ring
