        hSec hSec_A hFst_A _
        (s_q ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))).mpr hGood_q
      exact hNegB (AlgebraicClosure q.asIdeal.ResidueField) s_q ⟨hFibA.1, hFibA.2.1⟩

theorem weil_valuationSubring_spreadOut_stable_curve (k : Type u) [Field k] [IsAlgClosed k]
    (K : Type u) [Field K] [Algebra k K]
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V)
    (n : ℕ)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hSecK : ∀ j : Fin n, σ_K j ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (C_V : AlgebraicGeometry.Scheme.{u})
    (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_V))
    (ι_gen : C_K ⟶ C_V)
    (hStabV : IsGeometricStablePointedCurve g_V n τ_V)
    (hPbV : CategoryTheory.IsPullback ι_gen p_K g_V
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hσV : ∀ j : Fin n, σ_K j ≫ ι_gen =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_V j)
    (F_init : Finset K)
    (hF_init : ∀ x ∈ F_init, x ∈ V) :
    ∃ (F₀ : Finset K)
      (C₀ : AlgebraicGeometry.Scheme.{u})
      (g₀ : C₀ ⟶ AlgebraicGeometry.Spec
        (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))))
      (τ₀ : Fin n → (AlgebraicGeometry.Spec
        (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))) ⟶ C₀))
      (ι₀_K : C_K ⟶ C₀),
      F_init ⊆ F₀ ∧
      (∀ x ∈ F₀, x ∈ V) ∧
      IsGeometricStablePointedCurve g₀ n τ₀ ∧
      CategoryTheory.IsPullback ι₀_K p_K g₀
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom)) ∧
      (∀ j : Fin n, σ_K j ≫ ι₀_K =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom) ≫ τ₀ j) :=
by
  obtain ⟨hn, hFlatV, hPropV, hLFPV, _hSurjV, hSecV, hDisjV, hSmSecV, hGeomV⟩ := hStabV
  have hQCV : AlgebraicGeometry.QuasiCompact g_V := by
    have := hPropV; infer_instance
  have hSepV : AlgebraicGeometry.IsSeparated g_V := by
    have := hPropV; infer_instance

  have hMemAdjoin : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) →
      ∀ z ∈ Algebra.adjoin k (↑F : Set K), z ∈ V := by
    intro F hFV z hz
    exact Algebra.adjoin_induction
      (fun y hy => hFV y (Finset.mem_coe.mp hy))
      (fun c => hkV c)
      (fun _ _ _ _ hx hy => add_mem hx hy)
      (fun _ _ _ _ hx hy => mul_mem hx hy) hz

  let mk_ι_FV : ∀ (F : Finset K), (∀ x ∈ F, x ∈ V) →
      (↥(Algebra.adjoin k (↑F : Set K)) →+* ↥V) :=
    fun F hFV =>
      (Algebra.adjoin k (↑F : Set K)).val.toRingHom.codRestrict V.toSubring
        (fun z => hMemAdjoin F hFV z.1 z.2)

  have h_ι_FV_comp : ∀ {F F' : Finset K} (hSub : F ⊆ F')
      (ι₁ : ↥(Algebra.adjoin k (↑F : Set K)) →+* ↥V)
      (hι₁ : V.subtype.comp ι₁ = (Algebra.adjoin k (↑F : Set K)).val.toRingHom)
      (ι₂ : ↥(Algebra.adjoin k (↑F' : Set K)) →+* ↥V)
      (hι₂ : V.subtype.comp ι₂ = (Algebra.adjoin k (↑F' : Set K)).val.toRingHom),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))).toRingHom) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁) := by
    intro F F' hSub ι₁ hι₁ ι₂ hι₂
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    ext x
    have h1 := RingHom.congr_fun hι₁ x
    have h2 := RingHom.congr_fun hι₂
      (Subalgebra.inclusion (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub)) x)
    exact h2.trans h1.symm

  have hPullbackPointed : ∀ {C S S' : AlgebraicGeometry.Scheme.{u}}
      (g : C ⟶ S) (τ : Fin n → (S ⟶ C)) (f : S' ⟶ S)
      (hSec : ∀ j : Fin n, τ j ≫ g = 𝟙 S)
      (hDisj : _root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ i).base) (Set.range (τ j).base))
      (hSmSec : ∀ (j : Fin n) (b : S), ∃ W : C.Opens,
        (τ j).base b ∈ W ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g))
      (ι_V : C_V ⟶ C)
      (f_V : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ S')
      (hPb : CategoryTheory.IsPullback ι_V g_V g (f_V ≫ f))
      (hτ_V : ∀ j : Fin n, τ_V j ≫ ι_V = (f_V ≫ f) ≫ τ j),
      let C' := CategoryTheory.Limits.pullback g f
      let g' := CategoryTheory.Limits.pullback.snd g f
      let τ' : Fin n → (S' ⟶ C') := fun j =>
        CategoryTheory.Limits.pullback.lift (f ≫ τ j) (𝟙 S')
          (by rw [CategoryTheory.Category.assoc, hSec j,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      ∃ (ι'_V : C_V ⟶ C'),
        (∀ j : Fin n, τ' j ≫ g' = 𝟙 S') ∧
        (_root_.Pairwise fun i j : Fin n =>
          Disjoint (Set.range (τ' i).base) (Set.range (τ' j).base)) ∧
        (∀ (j : Fin n) (b' : S'), ∃ W' : C'.Opens,
          (τ' j).base b' ∈ W' ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (W'.ι ≫ g')) ∧
        (∀ j : Fin n, τ' j ≫ CategoryTheory.Limits.pullback.fst g f = f ≫ τ j) ∧
        CategoryTheory.IsPullback ι'_V g_V g' f_V ∧
        (∀ j : Fin n, τ_V j ≫ ι'_V = f_V ≫ τ' j) := by
    intro C S S' g τ f hSec hDisj hSmSec ι_V f_V hPb hτ_V C' g' τ'
    let π := CategoryTheory.Limits.pullback.fst g f
    let ι'_V : C_V ⟶ C' :=
      CategoryTheory.Limits.pullback.lift ι_V (g_V ≫ f_V)
        (by rw [CategoryTheory.Category.assoc, hPb.w])
    have hSec' : ∀ j : Fin n, τ' j ≫ g' = 𝟙 S' :=
      fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hFst' : ∀ j : Fin n, τ' j ≫ π = f ≫ τ j :=
      fun j => CategoryTheory.Limits.pullback.lift_fst _ _ _
    refine ⟨ι'_V, hSec', ?_, ?_, hFst', ?_, ?_⟩
    · intro i j hij
      rw [Set.disjoint_iff]
      rintro x ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
      have h_eq : (τ i).base (f.base a) = (τ j).base (f.base b) := by
        calc
          (τ i).base (f.base a) = (f ≫ τ i).base a := rfl
          _ = (τ' i ≫ π).base a := by rw [hFst' i]
          _ = π.base x := by simp [ha]
          _ = (τ' j ≫ π).base b := by simp [hb]
          _ = (f ≫ τ j).base b := by rw [hFst' j]
          _ = (τ j).base (f.base b) := rfl
      exact Set.disjoint_iff.mp (hDisj hij) ⟨⟨f.base a, rfl⟩, ⟨f.base b, h_eq.symm⟩⟩
    · intro j b'
      obtain ⟨W, hW_mem, hW_sm⟩ := hSmSec j (f.base b')
      let W' : C'.Opens := π ⁻¹ᵁ W
      refine ⟨W', ?_, ?_⟩
      · change π.base ((τ' j).base b') ∈ W
        have h_pt : π.base ((τ' j).base b') = (τ j).base (f.base b') := by
          change (τ' j ≫ π).base b' = (f ≫ τ j).base b'
          rw [hFst' j]
        rw [h_pt]
        exact hW_mem
      · let π_W : W'.toScheme ⟶ W.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift W.ι (W'.ι ≫ π) (by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨x, rfl⟩
            exact x.2)
        have hPbW : CategoryTheory.IsPullback π_W W'.ι W.ι π :=
          AlgebraicGeometry.IsOpenImmersion.isPullback π_W W'.ι W.ι π
            (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
            (by ext x; simp [W', π, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
        have hPbComp : CategoryTheory.IsPullback π_W (W'.ι ≫ g') (W.ι ≫ g) f :=
          hPbW.paste_vert (CategoryTheory.IsPullback.of_hasPullback g f)
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbComp hW_sm
    · refine CategoryTheory.IsPullback.of_right ?_ ?_ (CategoryTheory.IsPullback.of_hasPullback g f)
      · change CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.lift ι_V (g_V ≫ f_V) _ ≫
            CategoryTheory.Limits.pullback.fst g f) g_V g (f_V ≫ f)
        rw [CategoryTheory.Limits.pullback.lift_fst]
        exact hPb
      · exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    · intro j
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hτ_V j, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hFst' j]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, hSecV j, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.assoc, hSec' j, CategoryTheory.Category.comp_id]

  have hTransportIso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω]
      (p₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (p₂ : Y₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (M₁ : Fin n → Set ↥Y₁) (M₂ : Fin n → Set ↥Y₂)
      (e : Y₁ ≅ Y₂) (hep : e.hom ≫ p₂ = p₁)
      (hM : ∀ (j : Fin n) (q₁ : ↥Y₁), q₁ ∈ M₁ j ↔ e.hom.base q₁ ∈ M₂ j),
      (ConnectedSpace ↥Y₁ ∧
       (∀ y₁ : ↥Y₁, HasSpreadSmoothOrNodalAt p₁ y₁) ∧
       (∀ (E : Set ↥Y₁) (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Y₁),
         E ∈ irreducibleComponents ↥Y₁ →
         AlgebraicGeometry.IsClosedImmersion ιE →
         AlgebraicGeometry.IsIntegral E_sch →
         Set.range ιE.base = E →
         (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
           ιE ≫ p₁ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
         ∃ q₁ q₂ q₃ : ↥Y₁,
           q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
           q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
           (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y₁),
             (∃ E' ∈ irreducibleComponents ↥Y₁, E' ≠ E ∧ q ∈ E') ∨
             (∃ j : Fin n, q ∈ M₁ j)))) →
      (ConnectedSpace ↥Y₂ ∧
       (∀ y₂ : ↥Y₂, HasSpreadSmoothOrNodalAt p₂ y₂) ∧
       (∀ (E : Set ↥Y₂) (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Y₂),
         E ∈ irreducibleComponents ↥Y₂ →
         AlgebraicGeometry.IsClosedImmersion ιE →
         AlgebraicGeometry.IsIntegral E_sch →
         Set.range ιE.base = E →
         (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
           ιE ≫ p₂ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
         ∃ q₁ q₂ q₃ : ↥Y₂,
           q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
           q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
           (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y₂),
             (∃ E' ∈ irreducibleComponents ↥Y₂, E' ≠ E ∧ q ∈ E') ∨
             (∃ j : Fin n, q ∈ M₂ j)))) := by
    intro Y₁ Y₂ Ω _ p₁ p₂ M₁ M₂ e hep hM ⟨hConn₁, hSmNod₁, hComp₁⟩
    let hTop : ↥Y₁ ≃ₜ ↥Y₂ := TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e)
    have hhTop : ∀ x : ↥Y₁, hTop x = e.hom.base x := fun _ => rfl
    have hhTopSymm : ∀ y : ↥Y₂, hTop.symm y = e.inv.base y := fun _ => rfl
    have heinv_p : e.inv ≫ p₁ = p₂ := by
      rw [← hep, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    refine ⟨?_, ?_, ?_⟩
    · exact hTop.surjective.connectedSpace hTop.continuous
    · intro y₂
      rcases hSmNod₁ (e.inv.base y₂) with ⟨V₁, hy₁, hSm₁⟩ |
          ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hIdeal, hComm⟩
      · left
        let V₂ : Y₂.Opens := e.inv ⁻¹ᵁ V₁
        refine ⟨V₂, hy₁, ?_⟩
        let e_V : V₂.toScheme ⟶ V₁.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift V₁.ι (V₂.ι ≫ e.inv) (by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨x, rfl⟩
            exact x.2)
        have hPbV_iso : CategoryTheory.IsPullback e_V V₂.ι V₁.ι e.inv :=
          AlgebraicGeometry.IsOpenImmersion.isPullback e_V V₂.ι V₁.ι e.inv
            (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
            (by ext x; simp [V₂, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
        have hPbBot : CategoryTheory.IsPullback e.inv p₂ p₁
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) :=
          CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [heinv_p, CategoryTheory.Category.comp_id]⟩
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hPbV_iso.paste_vert hPbBot) hSm₁
      · right
        refine ⟨U', u₀, e₁ ≫ e.hom, e₂, ?_, hEt₂, ?_, hIdeal, ?_⟩
        · infer_instance
        · change e.hom.base (e₁.base u₀) = y₂
          rw [hu₀, ← hhTop, ← hhTopSymm, hTop.apply_symm_apply]
        · rw [CategoryTheory.Category.assoc, hep, hComm]
    · intro E₂ E_sch ιE₂ hE₂ hCl₂ hIntE hRange₂ ⟨isoP1, hisoP1⟩
      let E₁ : Set ↥Y₁ := hTop.symm '' E₂
      let ιE₁ : E_sch ⟶ Y₁ := ιE₂ ≫ e.inv
      have hE₁ : E₁ ∈ irreducibleComponents ↥Y₁ :=
        image_mem_irreducibleComponents_of_isPreirreducible_fiber hTop.symm
          hTop.symm.continuous hTop.symm.isOpenMap
          (fun x => (Set.subsingleton_singleton.preimage hTop.symm.injective).isPreirreducible)
          hTop.symm.surjective hE₂
      have hCl₁ : AlgebraicGeometry.IsClosedImmersion ιE₁ := inferInstance
      have hRange₁ : Set.range ιE₁.base = E₁ := by
        change Set.range (hTop.symm ∘ ιE₂.base) = hTop.symm '' E₂
        rw [Set.range_comp, hRange₂]
      have hisoP1_1 : ιE₁ ≫ p₁ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom := by
        rw [CategoryTheory.Category.assoc, heinv_p, hisoP1]
      obtain ⟨q₁, q₂, q₃, hq12, hq13, hq23, hq1E, hq2E, hq3E, hSpec⟩ :=
        hComp₁ E₁ E_sch ιE₁ hE₁ hCl₁ hIntE hRange₁ ⟨isoP1, hisoP1_1⟩
      refine ⟨hTop q₁, hTop q₂, hTop q₃,
        hTop.injective.ne hq12, hTop.injective.ne hq13, hTop.injective.ne hq23,
        ?_, ?_, ?_, ?_⟩
      · rcases hq1E with ⟨z, hz, rfl⟩; simpa using hz
      · rcases hq2E with ⟨z, hz, rfl⟩; simpa using hz
      · rcases hq3E with ⟨z, hz, rfl⟩; simpa using hz
      · intro q' hq'
        have hq'_ex : ∃ q ∈ ({q₁, q₂, q₃} : Set ↥Y₁), hTop q = q' := by
          rcases hq' with rfl | rfl | rfl
          · exact ⟨q₁, by simp, rfl⟩
          · exact ⟨q₂, by simp, rfl⟩
          · exact ⟨q₃, by simp, rfl⟩
        obtain ⟨q, hq_set, rfl⟩ := hq'_ex
        rcases hSpec q hq_set with ⟨E'₁, hE'₁_mem, hE'₁_ne, hq_E'₁⟩ | ⟨j, hq_M₁⟩
        · left
          refine ⟨hTop '' E'₁,
            image_mem_irreducibleComponents_of_isPreirreducible_fiber hTop
              hTop.continuous hTop.isOpenMap
              (fun y => (Set.subsingleton_singleton.preimage hTop.injective).isPreirreducible)
              hTop.surjective hE'₁_mem,
            ?_, ⟨q, hq_E'₁, rfl⟩⟩
          intro hEq
          apply hE'₁_ne
          calc
            E'₁ = hTop.symm '' (hTop '' E'₁) := by ext z; simp
            _ = E₁ := by rw [hEq]
        · right
          exact ⟨j, (hM j q).mp hq_M₁⟩

  have hTransportGeomStable : ∀ {C C' S S' : AlgebraicGeometry.Scheme.{u}}
      (g : C ⟶ S) (τ : Fin n → (S ⟶ C))
      (g' : C' ⟶ S') (τ' : Fin n → (S' ⟶ C'))
      (ιC : C' ⟶ C) (f : S' ⟶ S)
      (hPb : CategoryTheory.IsPullback ιC g' g f)
      (hSec : ∀ j : Fin n, τ j ≫ g = 𝟙 S)
      (hSec' : ∀ j : Fin n, τ' j ≫ g' = 𝟙 S')
      (hτ : ∀ j : Fin n, τ' j ≫ ιC = f ≫ τ j)
      (Ω : Type u) [Field Ω]
      (s' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S'),
      HasSpreadGeomStableFiber g' n τ' Ω s' ↔
        HasSpreadGeomStableFiber g n τ Ω (s' ≫ f) := by
    intro C C' S S' g τ g' τ' ιC f hPb hSec hSec' hτ Ω _ s'
    let hPbFib : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g' s' ≫ ιC)
        (CategoryTheory.Limits.pullback.snd g' s')
        g (s' ≫ f) :=
      (CategoryTheory.IsPullback.of_hasPullback g' s').paste_horiz hPb
    let e : CategoryTheory.Limits.pullback g' s' ≅
        CategoryTheory.Limits.pullback g (s' ≫ f) :=
      hPbFib.isoPullback
    have he_fst : e.hom ≫ CategoryTheory.Limits.pullback.fst g (s' ≫ f) =
        CategoryTheory.Limits.pullback.fst g' s' ≫ ιC :=
      hPbFib.isoPullback_hom_fst
    have he_snd : e.hom ≫ CategoryTheory.Limits.pullback.snd g (s' ≫ f) =
        CategoryTheory.Limits.pullback.snd g' s' :=
      hPbFib.isoPullback_hom_snd
    have he_inv_snd : e.inv ≫ CategoryTheory.Limits.pullback.snd g' s' =
        CategoryTheory.Limits.pullback.snd g (s' ≫ f) := by
      rw [← he_snd, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    have hM : ∀ (j : Fin n) (q' : ↥(CategoryTheory.Limits.pullback g' s')),
        (CategoryTheory.Limits.pullback.fst g' s').base q' ∈ Set.range (τ' j).base ↔
          (CategoryTheory.Limits.pullback.fst g (s' ≫ f)).base (e.hom.base q') ∈
            Set.range (τ j).base := by
      intro j q'
      have hPbSec : CategoryTheory.IsPullback f (τ' j) (τ j) ιC := by
        refine CategoryTheory.IsPullback.of_bot ?_ (hτ j).symm hPb
        rw [hSec' j, hSec j]
        exact CategoryTheory.IsPullback.of_vert_isIso
          ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
      have h_pt : (CategoryTheory.Limits.pullback.fst g (s' ≫ f)).base (e.hom.base q') =
          ιC.base ((CategoryTheory.Limits.pullback.fst g' s').base q') := by
        change (e.hom ≫ CategoryTheory.Limits.pullback.fst g (s' ≫ f)).base q' =
          (CategoryTheory.Limits.pullback.fst g' s' ≫ ιC).base q'
        rw [he_fst]
      rw [h_pt]
      constructor
      · rintro ⟨b', hb'⟩
        refine ⟨f.base b', ?_⟩
        calc
          (τ j).base (f.base b') = (f ≫ τ j).base b' := rfl
          _ = (τ' j ≫ ιC).base b' := by rw [hτ j]
          _ = ιC.base ((CategoryTheory.Limits.pullback.fst g' s').base q') := by simp [hb']
      · rintro ⟨b, hb⟩
        obtain ⟨b', _hb'1, hb'2⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPbSec b
            ((CategoryTheory.Limits.pullback.fst g' s').base q') hb
        exact ⟨b', hb'2⟩
    constructor
    · exact hTransportIso _ _ _ _ e he_snd hM
    · refine hTransportIso _ _ _ _ e.symm he_inv_snd ?_
      intro j q
      have hq := hM j (e.inv.base q)
      have he_app : e.hom.base (e.inv.base q) = q := by
        change (e.inv ≫ e.hom).base q = q
        rw [e.inv_hom_id]
        rfl
      rw [he_app] at hq
      exact hq.symm

  have hLiftV : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (φ : A →+* B) (p_B : PrimeSpectrum B),
      ∃ (Ω_B : Type u) (_ : Field Ω_B) (_ : IsAlgClosed Ω_B)
        (s_B : AlgebraicGeometry.Spec (CommRingCat.of Ω_B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B))
        (ψ : AlgebraicClosure (PrimeSpectrum.comap φ p_B).asIdeal.ResidueField →+* Ω_B),
        s_B ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((algebraMap (PrimeSpectrum.comap φ p_B).asIdeal.ResidueField
                  (AlgebraicClosure (PrimeSpectrum.comap φ p_B).asIdeal.ResidueField)).comp
                (algebraMap A (PrimeSpectrum.comap φ p_B).asIdeal.ResidueField))) := by
    intro A B _ _ φ p_B
    let p_A := PrimeSpectrum.comap φ p_B
    have hp_A : p_A.asIdeal.IsPrime := p_A.isPrime
    have hp_B : p_B.asIdeal.IsPrime := p_B.isPrime
    let ψ_res : p_A.asIdeal.ResidueField →+* p_B.asIdeal.ResidueField :=
      Ideal.ResidueField.map p_A.asIdeal p_B.asIdeal φ rfl
    let ψ_alg : p_A.asIdeal.ResidueField →+* AlgebraicClosure p_B.asIdeal.ResidueField :=
      (algebraMap p_B.asIdeal.ResidueField (AlgebraicClosure p_B.asIdeal.ResidueField)).comp ψ_res
    let _ : Algebra p_A.asIdeal.ResidueField (AlgebraicClosure p_B.asIdeal.ResidueField) :=
      ψ_alg.toAlgebra
    let ψ_lift : AlgebraicClosure p_A.asIdeal.ResidueField →+*
        AlgebraicClosure p_B.asIdeal.ResidueField :=
      (IsAlgClosed.lift (R := p_A.asIdeal.ResidueField)
        (S := AlgebraicClosure p_A.asIdeal.ResidueField)
        (M := AlgebraicClosure p_B.asIdeal.ResidueField)).toRingHom
    refine ⟨AlgebraicClosure p_B.asIdeal.ResidueField, inferInstance, inferInstance,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap p_B.asIdeal.ResidueField
            (AlgebraicClosure p_B.asIdeal.ResidueField)).comp
          (algebraMap B p_B.asIdeal.ResidueField))),
      ψ_lift, ?_⟩
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    ext r
    change (algebraMap p_B.asIdeal.ResidueField (AlgebraicClosure p_B.asIdeal.ResidueField))
        (algebraMap B p_B.asIdeal.ResidueField (φ r)) =
      (IsAlgClosed.lift (R := p_A.asIdeal.ResidueField)
        (S := AlgebraicClosure p_A.asIdeal.ResidueField)
        (M := AlgebraicClosure p_B.asIdeal.ResidueField))
        (algebraMap p_A.asIdeal.ResidueField (AlgebraicClosure p_A.asIdeal.ResidueField)
          (algebraMap A p_A.asIdeal.ResidueField r))
    rw [(IsAlgClosed.lift (R := p_A.asIdeal.ResidueField)
      (S := AlgebraicClosure p_A.asIdeal.ResidueField)
      (M := AlgebraicClosure p_B.asIdeal.ResidueField)).commutes]
    exact congrArg (algebraMap p_B.asIdeal.ResidueField (AlgebraicClosure p_B.asIdeal.ResidueField))
      (Ideal.ResidueField.map_algebraMap p_A.asIdeal p_B.asIdeal φ rfl r).symm

  have hLiftField : ∀ {A B Ω : Type u} [CommRing A] [CommRing B] [Field Ω] [IsAlgClosed Ω]
      (φ : A →+* B)
      (s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B)),
      ∃ (p₀ : PrimeSpectrum B)
        (ψ : AlgebraicClosure (PrimeSpectrum.comap φ p₀).asIdeal.ResidueField →+* Ω),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((algebraMap (PrimeSpectrum.comap φ p₀).asIdeal.ResidueField
                (AlgebraicClosure (PrimeSpectrum.comap φ p₀).asIdeal.ResidueField)).comp
              (algebraMap A (PrimeSpectrum.comap φ p₀).asIdeal.ResidueField))) =
        s₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) := by
    intro A B Ω _ _ _ _ φ s₀
    let α : B →+* Ω := (AlgebraicGeometry.Spec.preimage s₀).hom
    have hs₀_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) = s₀ :=
      AlgebraicGeometry.Spec.map_preimage s₀
    let p₀ : PrimeSpectrum B := ⟨RingHom.ker α, RingHom.ker_isPrime α⟩
    let p_A : PrimeSpectrum A := PrimeSpectrum.comap φ p₀
    have hp₀ : p₀.asIdeal.IsPrime := p₀.isPrime
    have hp_A : p_A.asIdeal.IsPrime := p_A.isPrime
    let β₀ : p₀.asIdeal.ResidueField →+* Ω :=
      Ideal.ResidueField.lift p₀.asIdeal α le_rfl (fun _ hr => Ne.isUnit hr)
    let ψ₀ : p_A.asIdeal.ResidueField →+* p₀.asIdeal.ResidueField :=
      Ideal.ResidueField.map p_A.asIdeal p₀.asIdeal φ rfl
    let ψ_Ω : p_A.asIdeal.ResidueField →+* Ω := β₀.comp ψ₀
    let _ : Algebra p_A.asIdeal.ResidueField Ω := ψ_Ω.toAlgebra
    let ψ_lift : AlgebraicClosure p_A.asIdeal.ResidueField →+* Ω :=
      (IsAlgClosed.lift (R := p_A.asIdeal.ResidueField)
        (S := AlgebraicClosure p_A.asIdeal.ResidueField)
        (M := Ω)).toRingHom
    refine ⟨p₀, ψ_lift, ?_⟩
    rw [← hs₀_eq, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    ext r
    change (IsAlgClosed.lift (R := p_A.asIdeal.ResidueField)
        (S := AlgebraicClosure p_A.asIdeal.ResidueField)
        (M := Ω))
        (algebraMap p_A.asIdeal.ResidueField (AlgebraicClosure p_A.asIdeal.ResidueField)
          (algebraMap A p_A.asIdeal.ResidueField r)) = α (φ r)
    rw [(IsAlgClosed.lift (R := p_A.asIdeal.ResidueField)
      (S := AlgebraicClosure p_A.asIdeal.ResidueField)
      (M := Ω)).commutes]
    exact (congrArg β₀ (Ideal.ResidueField.map_algebraMap p_A.asIdeal p₀.asIdeal φ rfl r)).trans
      (Ideal.ResidueField.lift_algebraMap p₀.asIdeal α le_rfl (fun _ hr => Ne.isUnit hr) (φ r))

  obtain ⟨F₁, ι₁_FV, C₁, g₁, τ₁, ι₁_V, hSub₀₁, hF₁, hι₁,
      hQC₁, hSep₁, hLFP₁, _hSurj₁, hSec₁, hDisj₁, hSmSec₁, hPb₁, hτ₁⟩ :=
    weil_valuationSubring_spreadOut_pointed_separated_model k K V hkV n hn
      C_V g_V τ_V hQCV hSepV hLFPV hSecV hDisjV hSmSecV F_init hF_init

  obtain ⟨F₂, hSub₁₂, hF₂, hFlat₂, hIntC₂⟩ :=
    weil_valuationSubring_spreadOut_flat_and_integral k K V hkV C_K hIntCK p_K
      C_V g_V hFlatV ι_gen hPbV F₁ hF₁ ι₁_FV hι₁ C₁ g₁ hQC₁ hLFP₁ ι₁_V hPb₁

  let ρ₁₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub₁₂))).toRingHom)
  let C₂ := CategoryTheory.Limits.pullback g₁ ρ₁₂
  let g₂ := CategoryTheory.Limits.pullback.snd g₁ ρ₁₂
  let τ₂ : Fin n → (AlgebraicGeometry.Spec
      (CommRingCat.of ↥(Algebra.adjoin k (↑F₂ : Set K))) ⟶ C₂) :=
    fun j => CategoryTheory.Limits.pullback.lift (ρ₁₂ ≫ τ₁ j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hSec₁ j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let ι₂_FV := mk_ι_FV F₂ hF₂
  have hι₂ : V.subtype.comp ι₂_FV = (Algebra.adjoin k (↑F₂ : Set K)).val.toRingHom := rfl
  have hρ₁₂_V : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV) ≫ ρ₁₂ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁_FV) :=
    h_ι_FV_comp hSub₁₂ ι₁_FV hι₁ ι₂_FV hι₂
  obtain ⟨ι₂_V, hSec₂, hDisj₂, hSmSec₂, _hFst₂, hPb₂, hτ₂⟩ :=
    hPullbackPointed g₁ τ₁ ρ₁₂ hSec₁ hDisj₁ hSmSec₁ ι₁_V
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV))
      (by rwa [hρ₁₂_V]) (by intro j; rw [hρ₁₂_V]; exact hτ₁ j)
  have hQC₂ : AlgebraicGeometry.QuasiCompact g₂ := inferInstance
  have hSep₂ : AlgebraicGeometry.IsSeparated g₂ := inferInstance
  have hLFP₂ : AlgebraicGeometry.LocallyOfFinitePresentation g₂ := inferInstance

  obtain ⟨F₃, hSub₂₃, hF₃, hProp₃⟩ :=
    weil_valuationSubring_spreadOut_proper_of_integral k K V hkV C_V g_V hPropV
      F₂ hF₂ ι₂_FV hι₂ C₂ hIntC₂ g₂ hQC₂ hSep₂ hLFP₂ ι₂_V hPb₂

  let R₃ := ↥(Algebra.adjoin k (↑F₃ : Set K))
  have hNoeth₃ : IsNoetherianRing R₃ :=
    isNoetherianRing_of_fg (Subalgebra.fg_adjoin_finset F₃)
  let ρ₂₃ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub₂₃))).toRingHom)
  let C₃ := CategoryTheory.Limits.pullback g₂ ρ₂₃
  let g₃ := CategoryTheory.Limits.pullback.snd g₂ ρ₂₃
  let τ₃ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R₃) ⟶ C₃) :=
    fun j => CategoryTheory.Limits.pullback.lift (ρ₂₃ ≫ τ₂ j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hSec₂ j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let ι₃_FV := mk_ι_FV F₃ hF₃
  have hι₃ : V.subtype.comp ι₃_FV = (Algebra.adjoin k (↑F₃ : Set K)).val.toRingHom := rfl
  have hρ₂₃_V : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₃_FV) ≫ ρ₂₃ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂_FV) :=
    h_ι_FV_comp hSub₂₃ ι₂_FV hι₂ ι₃_FV hι₃
  obtain ⟨ι₃_V, hSec₃, hDisj₃, hSmSec₃, _hFst₃, hPb₃, hτ₃⟩ :=
    hPullbackPointed g₂ τ₂ ρ₂₃ hSec₂ hDisj₂ hSmSec₂ ι₂_V
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₃_FV))
      (by rwa [hρ₂₃_V]) (by intro j; rw [hρ₂₃_V]; exact hτ₂ j)
  have hFlat₃ : AlgebraicGeometry.Flat g₃ := inferInstance
  have hLFP₃ : AlgebraicGeometry.LocallyOfFinitePresentation g₃ := inferInstance
  have hSurj₃ : AlgebraicGeometry.Surjective g₃ := by
    let j₀ : Fin n := ⟨0, by omega⟩
    refine ⟨fun x => ⟨(τ₃ j₀).base x, ?_⟩⟩
    change (τ₃ j₀ ≫ g₃).base x = x
    rw [hSec₃ j₀]
    rfl

  obtain ⟨hArtinNodal, hAlgClosedIff⟩ := weil_algClosed_artinNodal_and_geomStableFiber_iff
  have hConstrGood :=
    @weil_noetherian_constructible_geomStableFiber_locus R₃ _ hNoeth₃ C₃ g₃ n τ₃ hn
      hFlat₃ hProp₃ hLFP₃ hSurj₃ hSec₃ hDisj₃ hSmSec₃ hArtinNodal
      (fun {C' S'} g' τ' => hAlgClosedIff g' n τ' hn)

  obtain ⟨S_data, hS_data⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hConstrGood.compl

  have hV_not_bad : ∀ p_V : PrimeSpectrum ↥V,
      PrimeSpectrum.comap ι₃_FV p_V ∉ S_data.toSet := by
    intro p_V hp_bad
    rw [hS_data] at hp_bad
    apply hp_bad
    obtain ⟨Ω_V, instFieldΩ_V, instAlgΩ_V, s_V, φ_lift, hs_eq⟩ := hLiftV ι₃_FV p_V
    let _ : Field Ω_V := instFieldΩ_V
    let _ : IsAlgClosed Ω_V := instAlgΩ_V
    have hFibV : HasSpreadGeomStableFiber g_V n τ_V Ω_V s_V := hGeomV Ω_V s_V
    have hFib₃_V : HasSpreadGeomStableFiber g₃ n τ₃ Ω_V
        (s_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₃_FV)) :=
      (hTransportGeomStable g₃ τ₃ g_V τ_V ι₃_V
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₃_FV))
        hPb₃ hSec₃ hSecV hτ₃ Ω_V s_V).mp hFibV
    rw [hs_eq] at hFib₃_V
    exact (hAlgClosedIff g₃ n τ₃ hn hProp₃ hLFP₃ hSec₃ hDisj₃ _ Ω_V φ_lift _).mpr hFib₃_V

  have hClearPieces : ∀ x ∈ S_data,
      ∃ (M : ℕ) (c : Fin x.n → ↥V),
        ∑ i : Fin x.n, c i * ι₃_FV (x.g i) = (ι₃_FV x.f) ^ M := by
    intro x hx
    have hRad : ι₃_FV x.f ∈ (Ideal.span (Set.range (fun i : Fin x.n => ι₃_FV (x.g i)))).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro P ⟨hSpanP, hPrimeP⟩
      by_contra hNotMem
      let p_V : PrimeSpectrum ↥V := ⟨P, hPrimeP⟩
      apply hV_not_bad p_V
      unfold PrimeSpectrum.ConstructibleSetData.toSet PrimeSpectrum.BasicConstructibleSetData.toSet
      rw [Set.mem_iUnion₂]
      refine ⟨x, hx, ?_, ?_⟩
      · intro z hz
        rcases hz with ⟨i, rfl⟩
        exact hSpanP (Ideal.subset_span ⟨i, rfl⟩)
      · simpa [PrimeSpectrum.mem_zeroLocus] using hNotMem
    obtain ⟨M, hM⟩ := Ideal.mem_radical_iff.mp hRad
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hM
    exact ⟨M, c, hc⟩

  choose M_piece c_piece hc_piece using hClearPieces

  let _ : DecidableEq K := Classical.decEq K
  let _ : DecidableEq (PrimeSpectrum.BasicConstructibleSetData R₃) := Classical.decEq _
  let F₀ : Finset K :=
    F₃ ∪ S_data.attach.biUnion (fun x =>
      Finset.univ.image (fun i : Fin x.1.n => (c_piece x.1 x.2 i).1))

  have hSub₃₀ : F₃ ⊆ F₀ := Finset.subset_union_left
  have hSub_init : F_init ⊆ F₀ :=
    hSub₀₁.trans (hSub₁₂.trans (hSub₂₃.trans hSub₃₀))
  have hF₀ : ∀ z ∈ F₀, z ∈ V := by
    intro z hz
    rcases Finset.mem_union.mp hz with hz₃ | hz_c
    · exact hF₃ z hz₃
    · rcases Finset.mem_biUnion.mp hz_c with ⟨x, _, hz_img⟩
      rcases Finset.mem_image.mp hz_img with ⟨i, _, rfl⟩
      exact (c_piece x.1 x.2 i).2

  let R₀ := ↥(Algebra.adjoin k (↑F₀ : Set K))
  let inc₃₀ : R₃ →+* R₀ :=
    (Subalgebra.inclusion (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub₃₀))).toRingHom
  let ρ₃₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₃₀)
  let C₀ := CategoryTheory.Limits.pullback g₃ ρ₃₀
  let g₀ := CategoryTheory.Limits.pullback.snd g₃ ρ₃₀
  let τ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ C₀) :=
    fun j => CategoryTheory.Limits.pullback.lift (ρ₃₀ ≫ τ₃ j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hSec₃ j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let ι₀_FV := mk_ι_FV F₀ hF₀
  have hι₀ : V.subtype.comp ι₀_FV = (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom := rfl
  have hρ₃₀_V : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀_FV) ≫ ρ₃₀ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₃_FV) :=
    h_ι_FV_comp hSub₃₀ ι₃_FV hι₃ ι₀_FV hι₀
  obtain ⟨ι₀_V, hSec₀, hDisj₀, hSmSec₀, hFst₀, hPb₀_V, hτ₀_V⟩ :=
    hPullbackPointed g₃ τ₃ ρ₃₀ hSec₃ hDisj₃ hSmSec₃ ι₃_V
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀_FV))
      (by rwa [hρ₃₀_V]) (by intro j; rw [hρ₃₀_V]; exact hτ₃ j)

  have hR₀_not_bad : ∀ p₀ : PrimeSpectrum R₀, PrimeSpectrum.comap inc₃₀ p₀ ∉ S_data.toSet := by
    intro p₀ hp_bad
    unfold PrimeSpectrum.ConstructibleSetData.toSet PrimeSpectrum.BasicConstructibleSetData.toSet at hp_bad
    rw [Set.mem_iUnion₂] at hp_bad
    obtain ⟨x, hx, hx_zero, hx_not_zero⟩ := hp_bad
    have hc_in_R₀ : ∀ i : Fin x.n, (c_piece x hx i).1 ∈ Algebra.adjoin k (↑F₀ : Set K) := by
      intro i
      apply Algebra.subset_adjoin
      rw [Finset.mem_coe]
      exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr
        ⟨⟨x, hx⟩, Finset.mem_attach _ _, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩)
    let c₀ : Fin x.n → R₀ := fun i => ⟨(c_piece x hx i).1, hc_in_R₀ i⟩
    have hEqR₀ : ∑ i : Fin x.n, c₀ i * inc₃₀ (x.g i) = (inc₃₀ x.f) ^ (M_piece x hx) := by
      apply Subtype.ext
      have hVal := congrArg V.subtype (hc_piece x hx)
      simp only [map_sum, map_mul, map_pow] at hVal
      change (Algebra.adjoin k (↑F₀ : Set K)).val (∑ i : Fin x.n, c₀ i * inc₃₀ (x.g i)) =
        (Algebra.adjoin k (↑F₀ : Set K)).val ((inc₃₀ x.f) ^ (M_piece x hx))
      simp only [map_sum, map_mul, map_pow]
      exact hVal
    have hPowMem : (inc₃₀ x.f) ^ (M_piece x hx) ∈ p₀.asIdeal := by
      rw [← hEqR₀]
      refine Ideal.sum_mem p₀.asIdeal fun i _ => Ideal.mul_mem_left p₀.asIdeal (c₀ i) ?_
      exact hx_zero ⟨i, rfl⟩
    exact hx_not_zero (by simpa [PrimeSpectrum.mem_zeroLocus] using p₀.isPrime.mem_of_pow_mem _ hPowMem)

  have hStab₀ : IsGeometricStablePointedCurve g₀ n τ₀ := by
    have hFlat₀ : AlgebraicGeometry.Flat g₀ := inferInstance
    have hProp₀ : AlgebraicGeometry.IsProper g₀ := inferInstance
    have hLFP₀ : AlgebraicGeometry.LocallyOfFinitePresentation g₀ := inferInstance
    have hSurj₀ : AlgebraicGeometry.Surjective g₀ := inferInstance
    refine ⟨hn, hFlat₀, hProp₀, hLFP₀, hSurj₀, hSec₀, hDisj₀, hSmSec₀, ?_⟩
    intro Ω _ _ s₀
    obtain ⟨p₀, φ₀, hs_comm⟩ := hLiftField inc₃₀ s₀
    have hp₃_not_compl := hR₀_not_bad p₀
    rw [hS_data] at hp₃_not_compl
    have hp₃_good := Set.notMem_compl_iff.mp hp₃_not_compl
    have hFib₃_Ω : HasSpreadGeomStableFiber g₃ n τ₃ Ω (s₀ ≫ ρ₃₀) := by
      rw [← hs_comm]
      exact (hAlgClosedIff g₃ n τ₃ hn hProp₃ hLFP₃ hSec₃ hDisj₃ _ Ω φ₀ _).mp hp₃_good
    exact (hTransportGeomStable g₃ τ₃ g₀ τ₀
      (CategoryTheory.Limits.pullback.fst g₃ ρ₃₀) ρ₃₀
      (CategoryTheory.IsPullback.of_hasPullback g₃ ρ₃₀)
      hSec₃ hSec₀ hFst₀ Ω s₀).mpr hFib₃_Ω

  let ι₀_K : C_K ⟶ C₀ := ι_gen ≫ ι₀_V
  have hSpec_val₀ :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀_FV) =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom) := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι₀]
  have hPb₀_K : CategoryTheory.IsPullback ι₀_K p_K g₀
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom)) := by
    rw [← hSpec_val₀]
    exact hPbV.paste_horiz hPb₀_V
  have hσ₀_K : ∀ j : Fin n, σ_K j ≫ ι₀_K =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom) ≫ τ₀ j := by
    intro j
    rw [← hSpec_val₀, CategoryTheory.Category.assoc, ← hτ₀_V j,
      ← CategoryTheory.Category.assoc, hσV j, CategoryTheory.Category.assoc]

  exact ⟨F₀, C₀, g₀, τ₀, ι₀_K, hSub_init, hF₀, hStab₀, hPb₀_K, hσ₀_K⟩

theorem weil_spreadOut_generic_pointed_iso_on_basicOpen (k : Type u) [Field k] [IsAlgClosed k]
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (hU₂ : Nonempty U₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjX₂ : IsProjectiveOverField k X₂)
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (K₀ : Type u) [Field K₀] [Algebra k K₀]
    (η₀ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ B₂.left)
    (hFuncK₀ : IsSchemeFunctionField B₂.left K₀ η₀)
    (K : Type u) [Field K] [Algebra k K] [Algebra K₀ K] [IsScalarTower k K₀ K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (ι_K : C_K ⟶ X₂.left)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hSecK : ∀ j : Fin n, σ_K j ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)))
    (hPbK : CategoryTheory.IsPullback ι_K p_K f₂.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀))
    (hσK : ∀ j : Fin n, σ_K j ≫ ι_K =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀ ≫ (σ j).left)
    (U₀ : B₂.left.Opens)
    (hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀)
    (hNonemptyU₀ : Nonempty ↥U₀)
    (F₀ : Finset K)
    (hF₀ : ∀ x ∈ F₀, x ∈ V)
    (μ₀ : AlgebraicGeometry.Spec
      (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))) ⟶ U₀.toScheme)
    (hμ₀_K : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom) ≫
        μ₀ ≫ U₀.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀)
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))))
    (τ₀ : Fin n → (AlgebraicGeometry.Spec
      (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))) ⟶ C₀))
    (ι₀_K : C_K ⟶ C₀)
    (hProp₀ : AlgebraicGeometry.IsProper g₀)
    (hLFP₀ : AlgebraicGeometry.LocallyOfFinitePresentation g₀)
    (hSec₀ : ∀ j : Fin n, τ₀ j ≫ g₀ = 𝟙 _)
    (hPb₀ : CategoryTheory.IsPullback ι₀_K p_K g₀
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom)))
    (hσ₀ : ∀ j : Fin n, σ_K j ≫ ι₀_K =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom) ≫ τ₀ j) :
    ∃ (F_V : Finset K)
      (hSub : F₀ ⊆ F_V)
      (h_V : ↥(Algebra.adjoin k (↑F_V : Set K))),
      (∀ x ∈ F_V, x ∈ V) ∧
      h_V ≠ 0 ∧
      let ρ_V := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))).toRingHom)
      let π_V := ρ_V ≫ μ₀ ≫ U₀.ι
      (PrimeSpectrum.basicOpen h_V).1 ⊆
        π_V.base ⁻¹' (U₂ : Set B₂.left) ∧
      IsAffineChartOpenPointedIso k f₂ σ π_V (PrimeSpectrum.basicOpen h_V)
        (CategoryTheory.Limits.pullback.snd g₀ ρ_V)
        (fun j => CategoryTheory.Limits.pullback.lift (ρ_V ≫ τ₀ j) (𝟙 _)
          (by rw [CategoryTheory.Category.assoc, hSec₀ j, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp])) :=
by
  
  have hStep1 :
      ∀ (k' : Type u) [Field k']
        (B₂' X₂' : Over (Spec (CommRingCat.of k')))
        (U₂' : B₂'.left.Opens)
        (_hU₂ : Nonempty U₂')
        (f₂' : X₂' ⟶ B₂')
        (_hProp_f₂ : IsProper f₂'.left)
        (n' : ℕ)
        (σ' : Fin n' → (B₂' ⟶ X₂'))
        (_hSec_f₂ : ∀ j : Fin n', σ' j ≫ f₂' = 𝟙 B₂')
        (K₀' : Type u) [Field K₀'] [Algebra k' K₀']
        (η₀' : Spec (CommRingCat.of K₀') ⟶ B₂'.left)
        (_hFuncK₀ : IsSchemeFunctionField B₂'.left K₀' η₀')
        (K' : Type u) [Field K'] [Algebra k' K'] [Algebra K₀' K']
        (C_K' : Scheme.{u})
        (p_K' : C_K' ⟶ Spec (CommRingCat.of K'))
        (ι_K' : C_K' ⟶ X₂'.left)
        (σ_K' : Fin n' → (Spec (CommRingCat.of K') ⟶ C_K'))
        (_hSecK : ∀ j : Fin n', σ_K' j ≫ p_K' = 𝟙 (Spec (CommRingCat.of K')))
        (_hPbK : IsPullback ι_K' p_K' f₂'.left
          (Spec.map (CommRingCat.ofHom (algebraMap K₀' K')) ≫ η₀'))
        (_hσK : ∀ j : Fin n', σ_K' j ≫ ι_K' =
          Spec.map (CommRingCat.ofHom (algebraMap K₀' K')) ≫ η₀' ≫ (σ' j).left)
        (F₀' : Finset K')
        (π₀' : Spec (CommRingCat.of ↥(Algebra.adjoin k' (↑F₀' : Set K'))) ⟶ B₂'.left)
        (_hπ₀_K : Spec.map (CommRingCat.ofHom (Algebra.adjoin k' (↑F₀' : Set K')).val.toRingHom) ≫ π₀' =
          Spec.map (CommRingCat.ofHom (algebraMap K₀' K')) ≫ η₀'),
        let A₀ := CommRingCat.of ↥(Algebra.adjoin k' (↑F₀' : Set K'))
        let β₀ := CommRingCat.ofHom (Algebra.adjoin k' (↑F₀' : Set K')).val.toRingHom
        let p₀ := Limits.pullback.snd f₂'.left π₀'
        ∃ (h_base : ↥(Algebra.adjoin k' (↑F₀' : Set K')))
          (σ₀ : Fin n' → (Spec A₀ ⟶ Limits.pullback f₂'.left π₀'))
          (ι'_K : C_K' ⟶ Limits.pullback f₂'.left π₀'),
          h_base ≠ 0 ∧
          (PrimeSpectrum.basicOpen h_base).1 ⊆ π₀'.base ⁻¹' (U₂' : Set B₂'.left) ∧
          IsProper p₀ ∧
          LocallyOfFinitePresentation p₀ ∧
          (∀ j : Fin n', σ₀ j ≫ p₀ = 𝟙 (Spec A₀)) ∧
          (∀ j : Fin n', σ₀ j ≫ Limits.pullback.fst f₂'.left π₀' = π₀' ≫ (σ' j).left) ∧
          IsPullback ι'_K p_K' p₀ (Spec.map β₀) ∧
          (∀ j : Fin n', σ_K' j ≫ ι'_K = Spec.map β₀ ≫ σ₀ j) := by
    clear * -
    intro k _ B₂ X₂ U₂ hU₂ f₂ hProp_f₂ n σ hSec_f₂ K₀ _ _ η₀ hFuncK₀ K _ _ _ C_K p_K ι_K σ_K
      hSecK hPbK hσK F₀ π₀ hπ₀_K A₀ β₀ p₀
    obtain ⟨⟨y, hy⟩⟩ := hU₂
    obtain ⟨U', hAffU', hyU', hU'_le⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp (@Scheme.isBasis_affineOpens B₂.left) hy
    obtain ⟨φ', _, hφ'_eta⟩ := hFuncK₀ U' hAffU' ⟨⟨y, hyU'⟩⟩
    let bot_K : Spec (CommRingCat.of K) := Classical.arbitrary (Spec (CommRingCat.of K))
    let p_gen : PrimeSpectrum ↥(Algebra.adjoin k (↑F₀ : Set K)) :=
      (Spec.map β₀).base bot_K
    have hp_gen_U₂ : π₀.base p_gen ∈ U₂ := by
      have h1 : π₀.base p_gen = (Spec.map β₀ ≫ π₀).base bot_K := rfl
      rw [h1, hπ₀_K, ← hφ'_eta]
      have h_mem_range :
          (Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫
            Spec.map φ' ≫ hAffU'.fromSpec).base bot_K ∈ Set.range hAffU'.fromSpec.base :=
        ⟨(Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ Spec.map φ').base bot_K, rfl⟩
      rw [hAffU'.range_fromSpec] at h_mem_range
      exact hU'_le h_mem_range
    let O₀ : TopologicalSpace.Opens (PrimeSpectrum ↥(Algebra.adjoin k (↑F₀ : Set K))) :=
      ⟨π₀.base ⁻¹' (U₂ : Set B₂.left), U₂.isOpen.preimage π₀.base.hom.continuous⟩
    obtain ⟨_, ⟨h_base, rfl⟩, hp_mem, h_le_O₀⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens
        (show p_gen ∈ O₀ from hp_gen_U₂)
    have hh_base : h_base ≠ 0 := by
      intro h0
      rw [h0] at hp_mem
      exact hp_mem (Ideal.zero_mem _)
    have : IsProper f₂.left := hProp_f₂
    have hProp_p₀ : IsProper p₀ := inferInstance
    have : LocallyOfFiniteType p₀ := inferInstance
    have : Algebra.FiniteType k ↥(Algebra.adjoin k (↑F₀ : Set K)) :=
      Algebra.FiniteType.adjoin_of_finite F₀.finite_toSet
    have hNoethR₀ : IsNoetherianRing ↥(Algebra.adjoin k (↑F₀ : Set K)) :=
      Algebra.FiniteType.isNoetherianRing k ↥(Algebra.adjoin k (↑F₀ : Set K))
    have : IsNoetherianRing ↑A₀ := hNoethR₀
    have hLFP_p₀ : LocallyOfFinitePresentation p₀ := by
      refine LocallyOfFinitePresentation.mk (fun {U} hU {W} hW e => ?_)
      have : IsNoetherianRing ↑((Spec A₀).presheaf.obj (Opposite.op U)) :=
        IsLocallyNoetherian.component_noetherian (X := Spec A₀) ⟨U, hU⟩
      have hFT : (p₀.appLE U W e).hom.FiniteType :=
        LocallyOfFiniteType.finiteType_appLE p₀ hU hW e
      exact RingHom.FinitePresentation.of_finiteType.mp hFT
    have hSec_left : ∀ j : Fin n, (σ j).left ≫ f₂.left = 𝟙 B₂.left := by
      intro j
      have := congrArg CommaMorphism.left (hSec_f₂ j)
      simpa using this
    let σ₀ : Fin n → (Spec A₀ ⟶ Limits.pullback f₂.left π₀) :=
      fun j => Limits.pullback.lift (π₀ ≫ (σ j).left) (𝟙 (Spec A₀))
        (by rw [Category.assoc, hSec_left j, Category.comp_id, Category.id_comp])
    have hPbK' : IsPullback ι_K p_K f₂.left (Spec.map β₀ ≫ π₀) := by
      rwa [hπ₀_K]
    let ι'_K : C_K ⟶ Limits.pullback f₂.left π₀ :=
      Limits.pullback.lift ι_K (p_K ≫ Spec.map β₀) (by rw [Category.assoc, hPbK'.w])
    have hPb'_K : IsPullback ι'_K p_K p₀ (Spec.map β₀) :=
      IsPullback.of_right
        (by rw [Limits.pullback.lift_fst]; exact hPbK')
        (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback f₂.left π₀)
    refine ⟨h_base, σ₀, ι'_K, hh_base, h_le_O₀, hProp_p₀, hLFP_p₀, ?_, ?_, hPb'_K, ?_⟩
    · intro j
      exact Limits.pullback.lift_snd _ _ _
    · intro j
      exact Limits.pullback.lift_fst _ _ _
    · intro j
      apply Limits.pullback.hom_ext
      · simp only [ι'_K, σ₀, Category.assoc, Limits.pullback.lift_fst]
        rw [hσK j, ← Category.assoc, ← hπ₀_K, Category.assoc]
      · simp only [ι'_K, σ₀, Category.assoc, Limits.pullback.lift_snd]
        rw [Category.comp_id, ← Category.assoc, hSecK j, Category.id_comp]

  
  have hStep2a :
      ∀ {K' : Type u} [Field K']
        (R : CommRingCat.{u})
        (j : ↑R →+* K') (_hj : Function.Injective j)
        (h : ↑R) (_hh_ne : h ≠ 0),
        let B : CommRingCat.{u} := CommRingCat.of ↥(Subring.closure (Set.range j ∪ {(j h)⁻¹}))
        let φ : R ⟶ B :=
          CommRingCat.ofHom
            { toFun := fun a => ⟨j a, Subring.subset_closure (Or.inl ⟨a, rfl⟩)⟩
              map_one' := Subtype.ext j.map_one
              map_mul' := fun a b => Subtype.ext (j.map_mul a b)
              map_zero' := Subtype.ext j.map_zero
              map_add' := fun a b => Subtype.ext (j.map_add a b) }
        @IsLocalization.Away (↑R) _ h (↑B) _ φ.hom.toAlgebra := by
    clear * -
    intro K _ R j hj h hh_ne B φ
    let _ : Algebra (↑R) (↑B) := φ.hom.toAlgebra
    have hhK : j h ≠ 0 := fun h0 => hh_ne (hj (h0.trans j.map_zero.symm))
    have h_inv_mem : (j h)⁻¹ ∈ Subring.closure (Set.range j ∪ {(j h)⁻¹}) :=
      Subring.subset_closure (Or.inr rfl)
    have h_surj : ∀ x ∈ Subring.closure (Set.range j ∪ {(j h)⁻¹}),
        ∃ (a : ↑R) (m : ℕ), x * (j h) ^ m = j a := by
      intro x hx
      refine Subring.closure_induction
        (p := fun x _ => ∃ (a : ↑R) (m : ℕ), x * (j h) ^ m = j a)
        ?mem ?zero ?one ?add ?neg ?mul hx
      · rintro y (⟨a, rfl⟩ | rfl)
        · exact ⟨a, 0, by rw [pow_zero, mul_one]⟩
        · exact ⟨1, 1, by rw [pow_one, inv_mul_cancel₀ hhK, j.map_one]⟩
      · exact ⟨0, 0, by rw [zero_mul, j.map_zero]⟩
      · exact ⟨1, 0, by rw [pow_zero, mul_one, j.map_one]⟩
      · rintro x₁ x₂ _ _ ⟨a₁, m₁, hm₁⟩ ⟨a₂, m₂, hm₂⟩
        refine ⟨a₁ * h ^ m₂ + a₂ * h ^ m₁, m₁ + m₂, ?_⟩
        rw [j.map_add, j.map_mul, j.map_mul, j.map_pow, j.map_pow,
          add_mul, pow_add (j h) m₁ m₂, ← mul_assoc, hm₁,
          mul_comm ((j h) ^ m₁) ((j h) ^ m₂), ← mul_assoc x₂, hm₂]
      · rintro x₁ _ ⟨a₁, m₁, hm₁⟩
        exact ⟨-a₁, m₁, by rw [j.map_neg, neg_mul, hm₁]⟩
      · rintro x₁ x₂ _ _ ⟨a₁, m₁, hm₁⟩ ⟨a₂, m₂, hm₂⟩
        refine ⟨a₁ * a₂, m₁ + m₂, ?_⟩
        rw [j.map_mul, pow_add (j h) m₁ m₂, mul_assoc x₁ x₂, ← mul_assoc x₂,
          mul_comm x₂ ((j h) ^ m₁), mul_assoc ((j h) ^ m₁), ← mul_assoc x₁, hm₁, hm₂]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, m, rfl⟩
      let u_inv : ↑B := ⟨((j h)⁻¹) ^ m, pow_mem h_inv_mem m⟩
      refine IsUnit.of_mul_eq_one u_inv ?_
      apply Subtype.ext
      change j (h ^ m) * ((j h)⁻¹ ^ m) = 1
      rw [j.map_pow, inv_pow, mul_inv_cancel₀ (pow_ne_zero m hhK)]
    · intro y
      obtain ⟨a, m, hm⟩ := h_surj y.1 y.2
      refine ⟨⟨a, ⟨h ^ m, m, rfl⟩⟩, Subtype.ext ?_⟩
      change y.1 * j (h ^ m) = j a
      rw [j.map_pow]
      exact hm
    · intro a₁ a₂ h_eq
      have h_val : j a₁ = j a₂ := congrArg Subtype.val h_eq
      exact ⟨1, by rw [hj h_val]⟩

  
  have hStep2b :
      ∀ (K' : Type u) [Field K']
        (P : Subring K' → Prop)
        (S₀ : Subring K') (_hS₀ : P S₀)
        (_h_dir : ∀ S₁ S₂ : {S : Subring K' // P S}, ∃ S₃ : {S : Subring K' // P S}, S₁ ≤ S₃ ∧ S₂ ≤ S₃)
        (_h_surj : ∀ z : K', ∃ S : {S : Subring K' // P S}, z ∈ S.1),
        let J₀ : Type u := {S : Subring K' // P S}
        let B_diag : J₀ ⥤ CommRingCat.{u} :=
          { obj := fun S => CommRingCat.of ↥S.1
            map := fun u => CommRingCat.ofHom (Subring.inclusion (leOfHom u))
            map_id := fun _ => by ext x; rfl
            map_comp := fun _ _ => by ext x; rfl }
        let ι_colim : B_diag ⟶ (Functor.const J₀).obj (CommRingCat.of K') :=
          { app := fun S => CommRingCat.ofHom S.1.subtype
            naturality := fun _ _ _ => by ext x; rfl }
        IsFiltered J₀ ∧
        Nonempty (Limits.IsColimit (Limits.Cocone.mk (CommRingCat.of K') ι_colim)) := by
    clear * -
    intro K _ P S₀ hS₀ h_dir h_surj J₀ B_diag ι_colim
    let p_init : J₀ := ⟨S₀, hS₀⟩
    have instFiltJ : IsFiltered J₀ :=
      { cocone_objs := fun p₁ p₂ =>
          let ⟨p₃, h13, h23⟩ := h_dir p₁ p₂
          ⟨p₃, homOfLE h13, homOfLE h23, trivial⟩
        cocone_maps := fun {_ p₂} _ _ => ⟨p₂, 𝟙 p₂, Subsingleton.elim _ _⟩
        nonempty := ⟨p_init⟩ }
    refine ⟨instFiltJ, ?_⟩
    have hExistsDesc : ∀ s : Limits.Cocone B_diag,
        ∃ d : CommRingCat.of K ⟶ s.pt,
          (∀ S : J₀, ι_colim.app S ≫ d = s.ι.app S) ∧
          (∀ m : CommRingCat.of K ⟶ s.pt, (∀ S : J₀, ι_colim.app S ≫ m = s.ι.app S) → m = d) := by
      intro s
      have hCompat : ∀ {S₁ S₂ : J₀} {z : K} (hz₁ : z ∈ S₁.1) (hz₂ : z ∈ S₂.1),
          (s.ι.app S₁).hom ⟨z, hz₁⟩ = (s.ι.app S₂).hom ⟨z, hz₂⟩ := by
        intro S₁ S₂ z hz₁ hz₂
        obtain ⟨S₃, h13, h23⟩ := h_dir S₁ S₂
        have s₁ := congrArg (fun f => f.hom ⟨z, hz₁⟩) (s.w (homOfLE h13))
        have s₂ := congrArg (fun f => f.hom ⟨z, hz₂⟩) (s.w (homOfLE h23))
        exact s₁.symm.trans s₂
      let d_fun : K → s.pt := fun z => (s.ι.app (h_surj z).choose).hom ⟨z, (h_surj z).choose_spec⟩
      have hd_spec : ∀ (S : J₀) (x : ↥S.1), d_fun x.1 = (s.ι.app S).hom x :=
        fun S x => hCompat (h_surj x.1).choose_spec x.2
      have hd_one : d_fun 1 = 1 := by
        have h1 := hd_spec p_init 1
        rw [map_one] at h1
        exact h1
      have hd_zero : d_fun 0 = 0 := by
        have h0 := hd_spec p_init 0
        rw [map_zero] at h0
        exact h0
      have hd_mul : ∀ a b : K, d_fun (a * b) = d_fun a * d_fun b := by
        intro a b
        obtain ⟨m, h1, h2⟩ := h_dir (h_surj a).choose (h_surj b).choose
        have ha_m : a ∈ m.1 := h1 (h_surj a).choose_spec
        have hb_m : b ∈ m.1 := h2 (h_surj b).choose_spec
        have hab := hd_spec m (⟨a, ha_m⟩ * ⟨b, hb_m⟩)
        rw [map_mul, ← hd_spec m ⟨a, ha_m⟩, ← hd_spec m ⟨b, hb_m⟩] at hab
        exact hab
      have hd_add : ∀ a b : K, d_fun (a + b) = d_fun a + d_fun b := by
        intro a b
        obtain ⟨m, h1, h2⟩ := h_dir (h_surj a).choose (h_surj b).choose
        have ha_m : a ∈ m.1 := h1 (h_surj a).choose_spec
        have hb_m : b ∈ m.1 := h2 (h_surj b).choose_spec
        have hab := hd_spec m (⟨a, ha_m⟩ + ⟨b, hb_m⟩)
        rw [map_add, ← hd_spec m ⟨a, ha_m⟩, ← hd_spec m ⟨b, hb_m⟩] at hab
        exact hab
      let d : CommRingCat.of K ⟶ s.pt :=
        CommRingCat.ofHom ⟨⟨⟨d_fun, hd_one⟩, hd_mul⟩, hd_zero, hd_add⟩
      refine ⟨d, fun S => ?_, fun m_hom hm => ?_⟩
      · ext x; exact hd_spec S x
      · ext z
        let S := (h_surj z).choose
        have hz := (h_surj z).choose_spec
        exact (congrArg (fun f => f.hom ⟨z, hz⟩) (hm S)).trans (hd_spec S ⟨z, hz⟩).symm
    exact ⟨{ desc := fun s => (hExistsDesc s).choose
             fac := fun s i => (hExistsDesc s).choose_spec.1 i
             uniq := fun s m hm => (hExistsDesc s).choose_spec.2 m hm }⟩

  
  have hStep2 :
      ∀ (k' : Type u) [Field k']
        (K' : Type u) [Field K'] [Algebra k' K']
        (V' : ValuationSubring K')
        (F₀' : Finset K')
        (_hF₀ : ∀ x ∈ F₀', x ∈ V')
        (h_base : ↥(Algebra.adjoin k' (↑F₀' : Set K')))
        (_hh_base : h_base ≠ 0),
        ∃ (J : Type u) (_ : SmallCategory J) (_ : IsFiltered J)
          (B_diag : J ⥤ CommRingCat.{u})
          (α_diag :
            (Functor.const J).obj
              (CommRingCat.of ↥(Algebra.adjoin k' (↑F₀' : Set K'))) ⟶ B_diag)
          (ι_colim : B_diag ⟶ (Functor.const J).obj (CommRingCat.of K')),
          Nonempty (Limits.IsColimit
            (Limits.Cocone.mk (CommRingCat.of K') ι_colim)) ∧
          (∀ i : J, α_diag.app i ≫ ι_colim.app i =
            CommRingCat.ofHom (Algebra.adjoin k' (↑F₀' : Set K')).val.toRingHom) ∧
          (∀ i : J,
            ∃ (F_V : Finset K') (hSub : F₀' ⊆ F_V)
              (h_V : ↥(Algebra.adjoin k' (↑F_V : Set K')))
              (φ_away :
                CommRingCat.of ↥(Algebra.adjoin k' (↑F_V : Set K')) ⟶ B_diag.obj i),
              (∀ x ∈ F_V, x ∈ V') ∧
              h_V ≠ 0 ∧
              (let R_V := CommRingCat.of ↥(Algebra.adjoin k' (↑F_V : Set K'))
               let inc_V :=
                 (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))).toRingHom
               PrimeSpectrum.basicOpen h_V ≤ PrimeSpectrum.basicOpen (inc_V h_base) ∧
               @IsLocalization.Away (↑R_V) _ (h_V : ↑R_V) (↑(B_diag.obj i)) _ φ_away.hom.toAlgebra ∧
               α_diag.app i = CommRingCat.ofHom inc_V ≫ φ_away)) := by
    clear * - hStep2a hStep2b
    intro k _ K _ _ V F₀ hF₀ h_base hh_base
    let A_sub : Finset K → Subalgebra k K := fun F => Algebra.adjoin k (↑F : Set K)
    let R_sub : Finset K → CommRingCat.{u} := fun F => CommRingCat.of ↥(A_sub F)
    let j_sub : ∀ (F : Finset K), ↑(R_sub F) →+* K := fun F => (A_sub F).val.toRingHom
    let inc : ∀ {F₁ F₂ : Finset K}, F₁ ⊆ F₂ → (↥(A_sub F₁) →+* ↥(A_sub F₂)) :=
      fun h => (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h))).toRingHom
    let B_sub : ∀ (F : Finset K) (h : ↥(A_sub F)), Subring K :=
      fun F h => Subring.closure (Set.range (j_sub F) ∪ {(j_sub F h)⁻¹})
    have h_mem_B_of_A : ∀ (F : Finset K) (h : ↥(A_sub F)) (a : ↥(A_sub F)),
        (a : K) ∈ B_sub F h :=
      fun F h a => Subring.subset_closure (Or.inl ⟨a, rfl⟩)
    have h_inv_mem_B : ∀ (F : Finset K) (h : ↥(A_sub F)), (h : K)⁻¹ ∈ B_sub F h :=
      fun F h => Subring.subset_closure (Or.inr rfl)
    let IsGoodSubring : Subring K → Prop := fun S =>
      (A_sub F₀ : Set K) ⊆ (S : Set K) ∧
      (h_base : K)⁻¹ ∈ S ∧
      ∃ (F : Finset K) (hSub : F₀ ⊆ F) (h : ↥(A_sub F)),
        (∀ x ∈ F, x ∈ V) ∧
        h ≠ 0 ∧
        PrimeSpectrum.basicOpen h ≤ PrimeSpectrum.basicOpen (inc hSub h_base) ∧
        S = B_sub F h
    have h_mk_good : ∀ (F : Finset K) (hSub : F₀ ⊆ F) (h : ↥(A_sub F)),
        (∀ x ∈ F, x ∈ V) → h ≠ 0 →
        PrimeSpectrum.basicOpen h ≤ PrimeSpectrum.basicOpen (inc hSub h_base) →
        (h_base : K)⁻¹ ∈ B_sub F h →
        IsGoodSubring (B_sub F h) := by
      intro F hSub h hFV hne hle hinv
      refine ⟨?_, hinv, F, hSub, h, hFV, hne, hle, rfl⟩
      intro x hx
      exact Subring.subset_closure
        (Or.inl ⟨⟨x, Algebra.adjoin_mono (Finset.coe_subset.mpr hSub) hx⟩, rfl⟩)
    have hS₀_good : IsGoodSubring (B_sub F₀ h_base) :=
      h_mk_good F₀ (Finset.Subset.refl F₀) h_base hF₀ hh_base
        (by
          have h_id : inc (Finset.Subset.refl F₀) h_base = h_base := Subtype.ext rfl
          rw [h_id])
        (h_inv_mem_B F₀ h_base)
    have h_basicOpen_inc : ∀ {F₁ F₂ F₃ : Finset K} (h12 : F₁ ⊆ F₂) (h23 : F₂ ⊆ F₃)
        (a : ↥(A_sub F₁)) (b : ↥(A_sub F₂)),
        PrimeSpectrum.basicOpen b ≤ PrimeSpectrum.basicOpen (inc h12 a) →
        PrimeSpectrum.basicOpen (inc h23 b) ≤ PrimeSpectrum.basicOpen (inc (h12.trans h23) a) := by
      intro F₁ F₂ F₃ h12 h23 a b hle q hq
      have ha' : inc h12 a ∉ (PrimeSpectrum.comap (inc h23) q).asIdeal := hle hq
      have h_comp : inc h23 (inc h12 a) = inc (h12.trans h23) a := Subtype.ext rfl
      change inc (h12.trans h23) a ∉ q.asIdeal
      rw [← h_comp]
      exact ha'
    let J₀ : Type u := {S : Subring K // IsGoodSubring S}
    have h_dir : ∀ p₁ p₂ : J₀, ∃ p₃ : J₀, p₁ ≤ p₃ ∧ p₂ ≤ p₃ := by
      classical
      intro p₁ p₂
      obtain ⟨_, hinv1, F₁, hSub1, h₁, hV1, hne1, hle1, hEq1⟩ := p₁.2
      obtain ⟨_, _, F₂, hSub2, h₂, hV2, hne2, hle2, hEq2⟩ := p₂.2
      let F₃ : Finset K := F₁ ∪ F₂
      have hSub13 : F₁ ⊆ F₃ := Finset.subset_union_left
      have hSub23 : F₂ ⊆ F₃ := Finset.subset_union_right
      have hSub03 : F₀ ⊆ F₃ := hSub1.trans hSub13
      have hV3 : ∀ x ∈ F₃, x ∈ V := by
        intro x hx
        rcases Finset.mem_union.mp hx with h | h
        · exact hV1 x h
        · exact hV2 x h
      let h₃ : ↥(A_sub F₃) := inc hSub13 h₁ * inc hSub23 h₂
      have hK1 : (h₁ : K) ≠ 0 := fun h => hne1 (Subtype.ext h)
      have hK2 : (h₂ : K) ≠ 0 := fun h => hne2 (Subtype.ext h)
      have hne3 : h₃ ≠ 0 := fun h0 => mul_ne_zero hK1 hK2 (congrArg Subtype.val h0)
      have hle13 : PrimeSpectrum.basicOpen h₃ ≤ PrimeSpectrum.basicOpen (inc hSub13 h₁) := by
        change PrimeSpectrum.basicOpen (inc hSub13 h₁ * inc hSub23 h₂) ≤ _
        rw [PrimeSpectrum.basicOpen_mul]
        exact inf_le_left
      have hle03 : PrimeSpectrum.basicOpen h₃ ≤ PrimeSpectrum.basicOpen (inc hSub03 h_base) :=
        le_trans hle13 (h_basicOpen_inc hSub1 hSub13 h_base h₁ hle1)
      have hB13 : p₁.1 ≤ B_sub F₃ h₃ := by
        rw [hEq1, Subring.closure_le]
        rintro x (⟨a, rfl⟩ | rfl)
        · exact h_mem_B_of_A F₃ h₃ (inc hSub13 a)
        · have h_eq : (h₁ : K)⁻¹ = (h₂ : K) * (h₃ : K)⁻¹ := by
            change (h₁ : K)⁻¹ = (h₂ : K) * ((h₁ : K) * (h₂ : K))⁻¹
            rw [mul_inv, mul_comm (h₁ : K)⁻¹, ← mul_assoc, mul_inv_cancel₀ hK2, one_mul]
          change (h₁ : K)⁻¹ ∈ B_sub F₃ h₃
          rw [h_eq]
          exact mul_mem (h_mem_B_of_A F₃ h₃ (inc hSub23 h₂)) (h_inv_mem_B F₃ h₃)
      have hB23 : p₂.1 ≤ B_sub F₃ h₃ := by
        rw [hEq2, Subring.closure_le]
        rintro x (⟨a, rfl⟩ | rfl)
        · exact h_mem_B_of_A F₃ h₃ (inc hSub23 a)
        · have h_eq : (h₂ : K)⁻¹ = (h₁ : K) * (h₃ : K)⁻¹ := by
            change (h₂ : K)⁻¹ = (h₁ : K) * ((h₁ : K) * (h₂ : K))⁻¹
            rw [mul_inv, ← mul_assoc, mul_inv_cancel₀ hK1, one_mul]
          change (h₂ : K)⁻¹ ∈ B_sub F₃ h₃
          rw [h_eq]
          exact mul_mem (h_mem_B_of_A F₃ h₃ (inc hSub13 h₁)) (h_inv_mem_B F₃ h₃)
      exact ⟨⟨B_sub F₃ h₃, h_mk_good F₃ hSub03 h₃ hV3 hne3 hle03 (hB13 hinv1)⟩, hB13, hB23⟩
    have h_surj : ∀ z : K, ∃ S : J₀, z ∈ S.1 := by
      classical
      intro z
      by_cases hz0 : z = 0
      · exact ⟨⟨B_sub F₀ h_base, hS₀_good⟩, hz0 ▸ (B_sub F₀ h_base).zero_mem⟩
      · rcases ValuationSubring.mem_or_inv_mem V z with hzV | hzInvV
        · let F : Finset K := insert z F₀
          have hSub : F₀ ⊆ F := Finset.subset_insert z F₀
          have hFV : ∀ x ∈ F, x ∈ V := by
            intro x hx
            rcases Finset.mem_insert.mp hx with rfl | hx₀
            · exact hzV
            · exact hF₀ x hx₀
          let h : ↥(A_sub F) := inc hSub h_base
          have hh_ne : h ≠ 0 := by
            intro h0
            exact hh_base (Subtype.ext (congrArg (Subtype.val : ↥(A_sub F) → K) h0))
          exact ⟨⟨B_sub F h, h_mk_good F hSub h hFV hh_ne le_rfl (h_inv_mem_B F h)⟩,
            h_mem_B_of_A F h ⟨z, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self z F₀))⟩⟩
        · let F : Finset K := insert z⁻¹ F₀
          have hSub : F₀ ⊆ F := Finset.subset_insert z⁻¹ F₀
          have hFV : ∀ x ∈ F, x ∈ V := by
            intro x hx
            rcases Finset.mem_insert.mp hx with rfl | hx₀
            · exact hzInvV
            · exact hF₀ x hx₀
          let w : ↥(A_sub F) :=
            ⟨z⁻¹, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self z⁻¹ F₀))⟩
          let h : ↥(A_sub F) := w * inc hSub h_base
          have hb_ne : (h_base : K) ≠ 0 := fun hb => hh_base (Subtype.ext hb)
          have hh_K_ne : (h : K) ≠ 0 := mul_ne_zero (inv_ne_zero hz0) hb_ne
          have hh_ne : h ≠ 0 := fun h0 => hh_K_ne (congrArg Subtype.val h0)
          have hle : PrimeSpectrum.basicOpen h ≤ PrimeSpectrum.basicOpen (inc hSub h_base) := by
            change PrimeSpectrum.basicOpen (w * inc hSub h_base) ≤ _
            rw [PrimeSpectrum.basicOpen_mul]
            exact inf_le_right
          have h_hb_inv : (h_base : K)⁻¹ ∈ B_sub F h := by
            have h_eq : (h_base : K)⁻¹ = (w : K) * (h : K)⁻¹ := by
              change (h_base : K)⁻¹ = z⁻¹ * (z⁻¹ * (h_base : K))⁻¹
              rw [mul_inv, inv_inv, ← mul_assoc, inv_mul_cancel₀ hz0, one_mul]
            rw [h_eq]
            exact mul_mem (h_mem_B_of_A F h w) (h_inv_mem_B F h)
          refine ⟨⟨B_sub F h, h_mk_good F hSub h hFV hh_ne hle h_hb_inv⟩, ?_⟩
          have hz_eq : z = (inc hSub h_base : K) * (h : K)⁻¹ := by
            change z = (h_base : K) * (z⁻¹ * (h_base : K))⁻¹
            rw [mul_inv, inv_inv, ← mul_assoc, mul_comm (h_base : K) z, mul_assoc,
              mul_inv_cancel₀ hb_ne, mul_one]
          rw [hz_eq]
          exact mul_mem (h_mem_B_of_A F h (inc hSub h_base)) (h_inv_mem_B F h)
    obtain ⟨instFiltJ, hColim⟩ :=
      hStep2b K IsGoodSubring (B_sub F₀ h_base) hS₀_good h_dir h_surj
    let B_diag : J₀ ⥤ CommRingCat.{u} :=
      { obj := fun S => CommRingCat.of ↥S.1
        map := fun u => CommRingCat.ofHom (Subring.inclusion (leOfHom u))
        map_id := fun _ => by ext x; rfl
        map_comp := fun _ _ => by ext x; rfl }
    let α_diag : (Functor.const J₀).obj (R_sub F₀) ⟶ B_diag :=
      { app := fun S =>
          CommRingCat.ofHom
            { toFun := fun a => ⟨j_sub F₀ a, S.2.1 a.2⟩
              map_one' := Subtype.ext (j_sub F₀).map_one
              map_mul' := fun a b => Subtype.ext ((j_sub F₀).map_mul a b)
              map_zero' := Subtype.ext (j_sub F₀).map_zero
              map_add' := fun a b => Subtype.ext ((j_sub F₀).map_add a b) }
        naturality := fun _ _ _ => by ext x; rfl }
    let ι_colim : B_diag ⟶ (Functor.const J₀).obj (CommRingCat.of K) :=
      { app := fun S => CommRingCat.ofHom S.1.subtype
        naturality := fun _ _ _ => by ext x; rfl }
    refine ⟨J₀, inferInstance, instFiltJ, B_diag, α_diag, ι_colim, hColim, ?_, ?_⟩
    · intro S
      ext x
      rfl
    · rintro ⟨S_val, _, _, F, hSub, h, hFV, hne, hle, rfl⟩
      let φ_away : R_sub F ⟶ CommRingCat.of ↥(B_sub F h) :=
        CommRingCat.ofHom
          { toFun := fun a => ⟨j_sub F a, Subring.subset_closure (Or.inl ⟨a, rfl⟩)⟩
            map_one' := Subtype.ext (j_sub F).map_one
            map_mul' := fun a b => Subtype.ext ((j_sub F).map_mul a b)
            map_zero' := Subtype.ext (j_sub F).map_zero
            map_add' := fun a b => Subtype.ext ((j_sub F).map_add a b) }
      refine ⟨F, hSub, h, φ_away, hFV, hne, hle,
        hStep2a (R_sub F) (j_sub F) Subtype.val_injective h hne, ?_⟩
      ext x
      rfl

  
  have hHomDesc :
      ∀ {I : Type u} [SmallCategory I] [IsCofiltered I]
        (D : I ⥤ Scheme.{u})
        {R : CommRingCat.{u}}
        (t : D ⟶ (Functor.const I).obj (Spec R))
        {X : Scheme.{u}}
        (f : X ⟶ Spec R)
        (c : Limits.Cone D)
        (_hc : Limits.IsLimit c)
        [∀ i : I, CompactSpace ↥(D.obj i)]
        [∀ i : I, QuasiSeparatedSpace ↥(D.obj i)]
        [∀ {i j : I} (u : i ⟶ j), IsAffineHom (D.map u)]
        [LocallyOfFinitePresentation f]
        (φ : c.pt ⟶ X),
        (∀ i : I, φ ≫ f = c.π.app i ≫ t.app i) →
        ∃ (i : I) (φ_i : D.obj i ⟶ X),
          φ_i ≫ f = t.app i ∧ c.π.app i ≫ φ_i = φ := by
    clear * -
    intro I _ _ D R t X f c hc _ _ _ _ φ hφ
    have hPointwise : ∀ x : ↥c.pt,
        ∃ (V : X.Opens) (U : c.pt.Opens),
          IsAffineOpen V ∧ IsAffineOpen U ∧ x ∈ U ∧ U ≤ φ ⁻¹ᵁ V := by
      intro x
      obtain ⟨V, hAffV, hxV, -⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp (@Scheme.isBasis_affineOpens X)
          (show φ.base x ∈ (⊤ : X.Opens) from trivial)
      obtain ⟨U, hAffU, hxU, hUV⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp (@Scheme.isBasis_affineOpens c.pt)
          (show x ∈ φ ⁻¹ᵁ V from hxV)
      exact ⟨V, U, hAffV, hAffU, hxU, hUV⟩
    choose V_x U_x hAffV hAffU hxU hUV using hPointwise
    have hCovU : TopologicalSpace.IsOpenCover U_x := by
      rw [TopologicalSpace.IsOpenCover, eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxU x⟩
    obtain ⟨i₀, s, W₀, hCovW₀, hW₀⟩ :=
      Scheme.exists_isOpenCover_and_isAffine D c hc U_x hCovU hAffU
    let ι_D : ∀ (W : (D.obj i₀).Opens) (u : Over i₀),
        (opensDiagram D i₀ W).obj u ⟶ D.obj u.left :=
      fun W u => (D.map u.hom ⁻¹ᵁ W).ι
    let ι_c : ∀ (W : (D.obj i₀).Opens), (opensCone D c i₀ W).pt ⟶ c.pt :=
      fun W => (c.π.app i₀ ⁻¹ᵁ W).ι
    have h_map_ι_D : ∀ (W : (D.obj i₀).Opens) {u₁ u₂ : Over i₀} (g : u₁ ⟶ u₂),
        (opensDiagram D i₀ W).map g ≫ ι_D W u₂ = ι_D W u₁ ≫ D.map g.left := by
      intro W u₁ u₂ g
      change Scheme.Hom.resLE (D.map g.left) (D.map u₂.hom ⁻¹ᵁ W) (D.map u₁.hom ⁻¹ᵁ W) _ ≫
        (D.map u₂.hom ⁻¹ᵁ W).ι = (D.map u₁.hom ⁻¹ᵁ W).ι ≫ D.map g.left
      exact Scheme.Hom.resLE_comp_ι _ _
    have h_π_ι_c : ∀ (W : (D.obj i₀).Opens) (u : Over i₀),
        (opensCone D c i₀ W).π.app u ≫ ι_D W u = ι_c W ≫ c.π.app u.left := by
      intro W u
      change Scheme.Hom.resLE (c.π.app u.left) (D.map u.hom ⁻¹ᵁ W) (c.π.app i₀ ⁻¹ᵁ W) _ ≫
        (D.map u.hom ⁻¹ᵁ W).ι = (c.π.app i₀ ⁻¹ᵁ W).ι ≫ c.π.app u.left
      exact Scheme.Hom.resLE_comp_ι _ _
    have hChartLift : ∀ a : ↥s,
        ∃ (u : Over i₀)
          (ψ : (opensDiagram D i₀ (W₀ a)).obj u ⟶ X),
          ψ ≫ f = ι_D (W₀ a) u ≫ t.app u.left ∧
          (opensCone D c i₀ (W₀ a)).π.app u ≫ ψ = ι_c (W₀ a) ≫ φ := by
      intro a
      let W_a : (D.obj i₀).Opens := W₀ a
      have hAffWa : IsAffineOpen W_a := (hW₀ a).1
      have hUa_eq : U_x ↑a = c.π.app i₀ ⁻¹ᵁ W_a := (hW₀ a).2
      let V_a : X.Opens := V_x ↑a
      have hAffVa : IsAffineOpen V_a := hAffV ↑a
      let D_a : Over i₀ ⥤ Scheme.{u} := opensDiagram D i₀ W_a
      let c_a : Limits.Cone D_a := opensCone D c i₀ W_a
      let hc_a : Limits.IsLimit c_a := isLimitOpensCone D c hc i₀ W_a
      have hAffDa : ∀ u : Over i₀, IsAffine (D_a.obj u) := by
        intro u
        change IsAffineOpen (D.map u.hom ⁻¹ᵁ W_a)
        exact hAffWa.preimage (D.map u.hom)
      let hc_op : Limits.IsLimit (Scheme.Γ.rightOp.mapCone c_a) :=
        Limits.isLimitOfPreserves Scheme.Γ.rightOp hc_a
      let κ_a := Limits.coconeLeftOpOfCone (Scheme.Γ.rightOp.mapCone c_a)
      let hκ_a : Limits.IsColimit κ_a := Limits.isColimitCoconeLeftOpOfCone _ hc_op
      let S_a : CommRingCat.{u} := X.presheaf.obj (Opposite.op V_a)
      let f_a : R ⟶ S_a := Spec.preimage (hAffVa.fromSpec ≫ f)
      have hSpec_fa : Spec.map f_a = hAffVa.fromSpec ≫ f :=
        Spec.map_preimage (hAffVa.fromSpec ≫ f)
      have hf_a_fp : f_a.hom.FinitePresentation := by
        have : IsOpenImmersion hAffVa.fromSpec := by
          rw [← IsAffineOpen.isoSpec_inv_ι]
          infer_instance
        have hLFP_comp : LocallyOfFinitePresentation (Spec.map f_a) := by
          rw [hSpec_fa]
          infer_instance
        exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mp hLFP_comp
      have hLe_ca : c.π.app i₀ ⁻¹ᵁ W_a ≤ φ ⁻¹ᵁ V_a := by
        rw [← hUa_eq]
        exact hUV ↑a
      let φ_loc : c_a.pt ⟶ Scheme.Spec.obj (Opposite.op S_a) :=
        Scheme.Hom.resLE φ V_a (c.π.app i₀ ⁻¹ᵁ W_a) hLe_ca ≫ hAffVa.isoSpec.hom
      have hφ_loc_fromSpec : φ_loc ≫ hAffVa.fromSpec = ι_c W_a ≫ φ := by
        change (Scheme.Hom.resLE φ V_a (c.π.app i₀ ⁻¹ᵁ W_a) hLe_ca ≫ hAffVa.isoSpec.hom) ≫
          hAffVa.fromSpec = (c.π.app i₀ ⁻¹ᵁ W_a).ι ≫ φ
        rw [Category.assoc, ← IsAffineOpen.isoSpec_inv_ι, Iso.hom_inv_id_assoc,
          Scheme.Hom.resLE_comp_ι]
      let g_op : Scheme.Γ.rightOp.obj c_a.pt ⟶ Opposite.op S_a :=
        (ΓSpec.adjunction.homEquiv c_a.pt (Opposite.op S_a)).symm φ_loc
      let g_a : S_a ⟶ κ_a.pt := g_op.unop
      let t_loc : ∀ u : Over i₀, D_a.obj u ⟶ Scheme.Spec.obj (Opposite.op R) :=
        fun u => ι_D W_a u ≫ t.app u.left
