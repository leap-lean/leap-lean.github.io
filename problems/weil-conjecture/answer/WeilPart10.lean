          have hx_sup : x ∈ J ⊔ m_R ^ (d + 1) := hIsup d hx
          have hmap_mem : q_J x ∈ Ideal.map q_J (J ⊔ m_R ^ (d + 1)) :=
            Ideal.mem_map_of_mem q_J hx_sup
          rwa [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_pow] at hmap_mem
      rw [hKrull, Ideal.mem_bot] at hqx_iInf
      exact Ideal.Quotient.eq_zero_iff_mem.mp hqx_iInf
    exact h_krull P I_P J_P hJ_le_I hJ_le_mP hI_le_sup

theorem weil_mvPoly_linear_elimination_nilpotent_fixedPoint_equiv (E : Type u) [Field E] (m : ℕ)
    (T : Set (MvPolynomial (Fin (m + 2)) E)) :
    let P_E := MvPolynomial (Fin (m + 2)) E
    let M_U : Ideal P_E := Ideal.span (Set.range (MvPolynomial.X : Fin (m + 2) → P_E))
    let P_2 := MvPolynomial (Fin 2) E
    let M_Z : Ideal P_2 := Ideal.span (Set.range (MvPolynomial.X : Fin 2 → P_2))
    T ⊆ (M_U : Set P_E) →
    Module.finrank E (P_E ⧸ (Ideal.span T ⊔ M_U ^ 2)) = 3 →
    ∃ (g : Fin m → P_E)
      (Ξ : ∀ d : ℕ,
        (P_E ⧸ (Ideal.span (Set.range g) ⊔ M_U ^ (d + 1))) ≃ₐ[E] (P_2 ⧸ M_Z ^ (d + 1))),
      (∀ r : Fin m, g r ∈ T) ∧
      Ideal.span T ≤ Ideal.span (Set.range g) ⊔ M_U ^ 2 ∧
      ∀ (d₁ d₂ : ℕ) (h : d₁ ≤ d₂) (f : P_E),
        Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h))
          (Ξ d₂ (Ideal.Quotient.mk (Ideal.span (Set.range g) ⊔ M_U ^ (d₂ + 1)) f)) =
        Ξ d₁ (Ideal.Quotient.mk (Ideal.span (Set.range g) ⊔ M_U ^ (d₁ + 1)) f) :=
by
  dsimp only
  intro hT_sub hDim_1
  classical
  let M_U : Ideal (MvPolynomial (Fin (m + 2)) E) :=
    Ideal.span (Set.range (MvPolynomial.X : Fin (m + 2) → MvPolynomial (Fin (m + 2)) E))
  let M_Z : Ideal (MvPolynomial (Fin 2) E) :=
    Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) E))
  change T ⊆ (M_U : Set (MvPolynomial (Fin (m + 2)) E)) at hT_sub
  change Module.finrank E (MvPolynomial (Fin (m + 2)) E ⧸ (Ideal.span T ⊔ M_U ^ 2)) = 3 at hDim_1

  
  have hX_mul_monomial : ∀ (i : Fin (m + 2)) (s : Fin (m + 2) →₀ ℕ) (c : E),
      (MvPolynomial.X i : MvPolynomial (Fin (m + 2)) E) * MvPolynomial.monomial s c =
        MvPolynomial.monomial (Finsupp.single i 1 + s) c := by
    intro i s c
    have hX : (MvPolynomial.X i : MvPolynomial (Fin (m + 2)) E) =
        MvPolynomial.monomial (Finsupp.single i 1) 1 := by
      ext u
      simp [MvPolynomial.coeff_X, MvPolynomial.coeff_monomial]
    rw [hX, MvPolynomial.monomial_mul_monomial, one_mul]
  have h_monomial_mem : ∀ (k : ℕ) (s : Fin (m + 2) →₀ ℕ) (c : E),
      k ≤ s.degree → (MvPolynomial.monomial s c : MvPolynomial (Fin (m + 2)) E) ∈ M_U ^ k := by
    intro k
    induction k with
    | zero =>
      intro s c _
      rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    | succ k ih =>
      intro s c hk
      have hs_ne : s ≠ 0 := by
        rintro rfl
        simp at hk
      obtain ⟨i₀, hi₀⟩ := Finsupp.support_nonempty_iff.mpr hs_ne
      have hsi₀ : 1 ≤ s i₀ := Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi₀)
      let s' : Fin (m + 2) →₀ ℕ := s - Finsupp.single i₀ 1
      have hs_eq : Finsupp.single i₀ 1 + s' = s := by
        ext j
        simp only [Finsupp.add_apply, s', Finsupp.tsub_apply, Finsupp.single_apply]
        split_ifs with hj
        · subst hj; omega
        · omega
      have hs_deg : s.degree = 1 + s'.degree := by
        rw [← hs_eq, map_add, Finsupp.degree_single]
      have hk' : k ≤ s'.degree := by omega
      have h_prod : (MvPolynomial.monomial s c : MvPolynomial (Fin (m + 2)) E) =
          MvPolynomial.X i₀ * MvPolynomial.monomial s' c := by
        rw [hX_mul_monomial, hs_eq]
      rw [h_prod, pow_succ']
      exact Ideal.mul_mem_mul (Ideal.subset_span ⟨i₀, rfl⟩) (ih s' c hk')
  have h_mem_MU_deg : ∀ f ∈ M_U, ∀ s ∈ f.support, 1 ≤ s.degree := by
    intro f hf
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hf
    · rintro _ ⟨i, rfl⟩ s hs
      have hs_sub : s ∈ ({Finsupp.single i 1} : Finset (Fin (m + 2) →₀ ℕ)) := by
        rwa [MvPolynomial.support_X] at hs
      rw [Finset.mem_singleton.mp hs_sub, Finsupp.degree_single]
    · intro s hs
      simp at hs
    · intro x y _ _ hx hy s hs
      rcases Finset.mem_union.mp (MvPolynomial.support_add hs) with hsx | hsy
      · exact hx s hsx
      · exact hy s hsy
    · intro p x _ hx s hs
      change s ∈ (p * x).support at hs
      obtain ⟨s₁, hs₁, s₂, hs₂, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul p x hs)
      rw [map_add]
      have := hx s₂ hs₂
      omega
  have h_mem_MU_pow_iff : ∀ (k : ℕ) (f : MvPolynomial (Fin (m + 2)) E),
      f ∈ M_U ^ k ↔ ∀ s ∈ f.support, k ≤ s.degree := by
    intro k f
    constructor
    · induction k generalizing f with
      | zero =>
        intro _ s _
        exact Nat.zero_le _
      | succ k ih =>
        rw [pow_succ']
        intro hf
        refine Submodule.mul_induction_on hf ?_ ?_
        · intro x hx y hy s hs
          obtain ⟨s₁, hs₁, s₂, hs₂, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul x y hs)
          rw [map_add]
          have h1 := h_mem_MU_deg x hx s₁ hs₁
          have h2 := ih y hy s₂ hs₂
          omega
        · intro x y hx hy s hs
          rcases Finset.mem_union.mp (MvPolynomial.support_add hs) with hsx | hsy
          · exact hx s hsx
          · exact hy s hsy
    · intro hdeg
      rw [MvPolynomial.as_sum f]
      exact Ideal.sum_mem _ fun s hs => h_monomial_mem k s (f.coeff s) (hdeg s hs)
  have h_mem_MU_iff : ∀ f : MvPolynomial (Fin (m + 2)) E, f ∈ M_U ↔ f.coeff 0 = 0 := by
    intro f
    have h1 := h_mem_MU_pow_iff 1 f
    rw [pow_one] at h1
    rw [h1]
    constructor
    · intro h
      by_contra hc
      have hdeg := h 0 (MvPolynomial.mem_support_iff.mpr hc)
      simp at hdeg
    · intro hc0 s hs
      have hs0 : s ≠ 0 := by
        rintro rfl
        exact MvPolynomial.mem_support_iff.mp hs hc0
      have hdeg0 : s.degree ≠ 0 := by
        rwa [ne_eq, Finsupp.degree_eq_zero_iff]
      omega
  have h_mem_MU2_iff : ∀ f : MvPolynomial (Fin (m + 2)) E,
      f ∈ M_U ^ 2 ↔ f.coeff 0 = 0 ∧ ∀ i : Fin (m + 2), f.coeff (Finsupp.single i 1) = 0 := by
    intro f
    rw [h_mem_MU_pow_iff 2 f]
    constructor
    · intro h
      refine ⟨?_, fun i => ?_⟩
      · by_contra hc
        have hdeg := h 0 (MvPolynomial.mem_support_iff.mpr hc)
        simp at hdeg
      · by_contra hc
        have hdeg := h (Finsupp.single i 1) (MvPolynomial.mem_support_iff.mpr hc)
        rw [Finsupp.degree_single] at hdeg
        omega
    · rintro ⟨hc0, hc1⟩ s hs
      have hs0 : s ≠ 0 := by
        rintro rfl
        exact MvPolynomial.mem_support_iff.mp hs hc0
      obtain ⟨i₀, hi₀⟩ := Finsupp.support_nonempty_iff.mpr hs0
      have hsi₀ : 1 ≤ s i₀ := Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi₀)
      let s' : Fin (m + 2) →₀ ℕ := s - Finsupp.single i₀ 1
      have hs_eq : Finsupp.single i₀ 1 + s' = s := by
        ext j
        simp only [Finsupp.add_apply, s', Finsupp.tsub_apply, Finsupp.single_apply]
        split_ifs with hj
        · subst hj; omega
        · omega
      have hs'_ne : s' ≠ 0 := by
        intro hs'0
        rw [hs'0, add_zero] at hs_eq
        rw [← hs_eq] at hs
        exact MvPolynomial.mem_support_iff.mp hs (hc1 i₀)
      have hs'_deg : 1 ≤ s'.degree := by
        have h_ne : s'.degree ≠ 0 := by rwa [ne_eq, Finsupp.degree_eq_zero_iff]
        omega
      rw [← hs_eq, map_add, Finsupp.degree_single]
      omega

  
  let L₁ : MvPolynomial (Fin (m + 2)) E →ₗ[E] (Fin (m + 2) → E) :=
    LinearMap.pi fun i => MvPolynomial.lcoeff E (Finsupp.single i 1)
  let e₁_raw : MvPolynomial (Fin (m + 2)) E →ₗ[E] E × (Fin (m + 2) → E) :=
    LinearMap.prod (MvPolynomial.lcoeff E 0) L₁
  have h_single_ne_zero : ∀ i : Fin (m + 2), (Finsupp.single i 1 : Fin (m + 2) →₀ ℕ) ≠ 0 := by
    intro i h
    have := congr_arg (fun u => u i) h
    simp at this
  have h_single_inj : ∀ i j : Fin (m + 2),
      (Finsupp.single i 1 : Fin (m + 2) →₀ ℕ) = Finsupp.single j 1 ↔ i = j := by
    intro i j
    refine ⟨fun h => ?_, fun h => h ▸ rfl⟩
    have := congr_arg (fun u => u i) h
    simp [Finsupp.single_apply] at this
    exact this.symm
  have h_surj_e1 : Function.Surjective e₁_raw := by
    rintro ⟨c₀, v⟩
    refine ⟨MvPolynomial.C c₀ + ∑ i : Fin (m + 2), MvPolynomial.C (v i) * MvPolynomial.X i, ?_⟩
    ext
    · simp [e₁_raw, LinearMap.prod_apply, MvPolynomial.coeff_C, MvPolynomial.coeff_X,
        h_single_ne_zero]
    · rename_i j
      have h0j : (0 : Fin (m + 2) →₀ ℕ) ≠ Finsupp.single j 1 := (h_single_ne_zero j).symm
      simp [e₁_raw, LinearMap.prod_apply, L₁, MvPolynomial.coeff_C, h0j,
        MvPolynomial.coeff_X, h_single_inj]
  let V_lin : Submodule E (Fin (m + 2) → E) := Submodule.span E (L₁ '' T)
  have h_spanT_MU : Ideal.span T ≤ M_U := Ideal.span_le.mpr hT_sub
  have h_spanT_L1 : ∀ h ∈ Ideal.span T, L₁ h ∈ V_lin := by
    intro h hh
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hh
    · intro t ht
      exact Submodule.subset_span ⟨t, ht, rfl⟩
    · simp
    · intro x y _ _ hx hy
      rw [map_add]
      exact V_lin.add_mem hx hy
    · intro p x hx_mem hx
      have hx_MU : x ∈ M_U := h_spanT_MU hx_mem
      let p' : MvPolynomial (Fin (m + 2)) E := p - MvPolynomial.C (p.coeff 0)
      have hp'_MU : p' ∈ M_U := by
        rw [h_mem_MU_iff]
        simp [p', MvPolynomial.coeff_C]
      have hp'x_MU2 : p' * x ∈ M_U ^ 2 := by
        rw [pow_two]
        exact Ideal.mul_mem_mul hp'_MU hx_MU
      have hp'x_L1 : L₁ (p' * x) = 0 := by
        ext i
        exact ((h_mem_MU2_iff (p' * x)).mp hp'x_MU2).2 i
      have hpx_eq : p • x = (p.coeff 0) • x + p' * x := by
        rw [smul_eq_mul, Algebra.smul_def, MvPolynomial.algebraMap_eq]
        dsimp only [p']
        ring
      rw [hpx_eq, map_add, map_smul, hp'x_L1, add_zero]
      exact V_lin.smul_mem _ hx
  have h_Vlin_exists : ∀ w ∈ V_lin, ∃ h ∈ Ideal.span T, L₁ h = w := by
    have h_sub : V_lin ≤ Submodule.map L₁ ((Ideal.span T).restrictScalars E) := by
      rw [Submodule.span_le]
      rintro _ ⟨t, ht, rfl⟩
      exact ⟨t, Ideal.subset_span ht, rfl⟩
    intro w hw
    obtain ⟨h, hh, rfl⟩ := h_sub hw
    exact ⟨h, hh, rfl⟩
  let N_sub : Submodule E (E × (Fin (m + 2) → E)) := (⊥ : Submodule E E).prod V_lin
  let ψ_lin : MvPolynomial (Fin (m + 2)) E →ₗ[E] ((E × (Fin (m + 2) → E)) ⧸ N_sub) :=
    N_sub.mkQ.comp e₁_raw
  have h_surj_ψ : Function.Surjective ψ_lin := N_sub.mkQ_surjective.comp h_surj_e1
  let q_T : MvPolynomial (Fin (m + 2)) E →ₗ[E]
      (MvPolynomial (Fin (m + 2)) E ⧸ (Ideal.span T ⊔ M_U ^ 2)) :=
    (Ideal.Quotient.mkₐ E (Ideal.span T ⊔ M_U ^ 2)).toLinearMap
  have h_ker_eq : LinearMap.ker q_T = LinearMap.ker ψ_lin := by
    ext f
    have hq : f ∈ LinearMap.ker q_T ↔ f ∈ Ideal.span T ⊔ M_U ^ 2 := by
      change Ideal.Quotient.mk (Ideal.span T ⊔ M_U ^ 2) f = 0 ↔ _
      exact Ideal.Quotient.eq_zero_iff_mem
    have hψ : f ∈ LinearMap.ker ψ_lin ↔ f.coeff 0 = 0 ∧ L₁ f ∈ V_lin := by
      change Submodule.Quotient.mk (e₁_raw f) = 0 ↔ _
      rw [Submodule.Quotient.mk_eq_zero]
      change (f.coeff 0, L₁ f) ∈ (⊥ : Submodule E E).prod V_lin ↔ _
      rw [Submodule.mem_prod, Submodule.mem_bot]
    rw [hq, hψ]
    constructor
    · intro hf
      rcases Submodule.mem_sup.mp hf with ⟨h, hh, q, hq2, rfl⟩
      have hh0 : h.coeff 0 = 0 := (h_mem_MU_iff h).mp (h_spanT_MU hh)
      have hq_pair := (h_mem_MU2_iff q).mp hq2
      have hqL1 : L₁ q = 0 := funext hq_pair.2
      refine ⟨by simp [hh0, hq_pair.1], ?_⟩
      rw [map_add, hqL1, add_zero]
      exact h_spanT_L1 h hh
    · rintro ⟨hf0, hfL⟩
      obtain ⟨h, hh, hhL⟩ := h_Vlin_exists (L₁ f) hfL
      have hh0 : h.coeff 0 = 0 := (h_mem_MU_iff h).mp (h_spanT_MU hh)
      have h_diff : f - h ∈ M_U ^ 2 := by
        rw [h_mem_MU2_iff]
        refine ⟨by simp [hf0, hh0], fun i => ?_⟩
        have hi : (h.coeff (Finsupp.single i 1)) = (f.coeff (Finsupp.single i 1)) := by
          simpa [L₁] using congr_fun hhL i
        simp [hi]
      rw [show f = h + (f - h) by abel]
      exact Submodule.add_mem_sup hh h_diff
  let e_quot : (MvPolynomial (Fin (m + 2)) E ⧸ (Ideal.span T ⊔ M_U ^ 2)) ≃ₗ[E]
      ((E × (Fin (m + 2) → E)) ⧸ N_sub) :=
    (LinearMap.quotKerEquivOfSurjective q_T Ideal.Quotient.mk_surjective).symm.trans
      ((Submodule.quotEquivOfEq _ _ h_ker_eq).trans
        (LinearMap.quotKerEquivOfSurjective ψ_lin h_surj_ψ))
  have h_quot_dim : Module.finrank E ((E × (Fin (m + 2) → E)) ⧸ N_sub) = 3 := by
    rw [← e_quot.finrank_eq, hDim_1]
  have h_N_dim : Module.finrank E N_sub = m := by
    have h_sum := Submodule.finrank_quotient_add_finrank N_sub
    rw [h_quot_dim, Module.finrank_prod, Module.finrank_self, Module.finrank_fin_fun] at h_sum
    omega
  let e_NV : N_sub ≃ₗ[E] V_lin :=
    { toFun := fun x => ⟨x.1.2, x.2.2⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      invFun := fun y => ⟨(0, y.1), ⟨(Submodule.mem_bot E).mpr rfl, y.2⟩⟩
      left_inv := fun x => by
        ext
        · exact ((Submodule.mem_bot E).mp x.2.1).symm
        · rfl
      right_inv := fun _ => rfl }
  have h_rk_Vlin : Module.finrank E V_lin = m := by
    rw [← e_NV.finrank_eq, h_N_dim]
  obtain ⟨v_raw, hv_raw_mem, hv_raw_span, hv_raw_ind⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq E (L₁ '' T)
  let idx_eq : Fin m ≃ Fin (Module.finrank E ↥(Submodule.span E (L₁ '' T))) :=
    finCongr h_rk_Vlin.symm
  let v : Fin m → (Fin (m + 2) → E) := v_raw ∘ idx_eq
  have hv_mem : ∀ r : Fin m, v r ∈ L₁ '' T := fun r => hv_raw_mem (idx_eq r)
  have hv_span : Submodule.span E (Set.range v) = V_lin := by
    have h_rng : Set.range v = Set.range v_raw := by
      ext w
      simp only [Set.mem_range, v, Function.comp_apply]
      exact ⟨fun ⟨r, hr⟩ => ⟨idx_eq r, hr⟩, fun ⟨k, hk⟩ => ⟨idx_eq.symm k, by simpa using hk⟩⟩
    rw [h_rng]
    exact hv_raw_span
  have hv_ind : LinearIndependent E v := hv_raw_ind.comp idx_eq idx_eq.injective
  choose g hg_mem hg_L1 using hv_mem
  have hSpan_d1 : Ideal.span T ≤ Ideal.span (Set.range g) ⊔ M_U ^ 2 := by
    intro h hh
    have hhL : L₁ h ∈ Submodule.span E (Set.range v) := by
      rw [hv_span]
      exact h_spanT_L1 h hh
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun E).mp hhL
    let p_g : MvPolynomial (Fin (m + 2)) E := ∑ r : Fin m, MvPolynomial.C (c r) * g r
    have hpg_mem : p_g ∈ Ideal.span (Set.range g) :=
      Ideal.sum_mem _ fun r _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨r, rfl⟩)
    have hpg_MU : p_g ∈ M_U :=
      Ideal.sum_mem _ fun r _ => Ideal.mul_mem_left _ _ (hT_sub (hg_mem r))
    have h_diff : h - p_g ∈ M_U ^ 2 := by
      rw [h_mem_MU2_iff]
      refine ⟨?_, fun i => ?_⟩
      · have hh0 : h.coeff 0 = 0 := (h_mem_MU_iff h).mp (h_spanT_MU hh)
        have hpg0 : p_g.coeff 0 = 0 := (h_mem_MU_iff p_g).mp hpg_MU
        simp [hh0, hpg0]
      · have hpg_i : p_g.coeff (Finsupp.single i 1) = h.coeff (Finsupp.single i 1) := by
          have hc_i := congr_fun hc i
          simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, L₁, LinearMap.pi_apply,
            MvPolynomial.lcoeff_apply] at hc_i
          rw [← hc_i]
          simp only [p_g, MvPolynomial.coeff_sum, MvPolynomial.coeff_C_mul]
          refine Finset.sum_congr rfl fun r _ => ?_
          have hr_i : (g r).coeff (Finsupp.single i 1) = v r i := by
            simpa [L₁] using congr_fun (hg_L1 r) i
          rw [hr_i]
        simp [hpg_i]
    rw [show h = p_g + (h - p_g) by abel]
    exact Submodule.add_mem_sup hpg_mem h_diff

  
  let V₁ : Submodule E (Fin (m + 2) → E) := Submodule.span E (Set.range v)
  let b₁ : Module.Basis (Fin m) E V₁ := Module.Basis.span hv_ind
  have hb₁_dim : Module.finrank E V₁ = m := by
    rw [Module.finrank_eq_card_basis b₁, Fintype.card_fin]
  obtain ⟨V₂, hCompl⟩ := Submodule.exists_isCompl V₁
  let e_compl : (V₁ × V₂) ≃ₗ[E] (Fin (m + 2) → E) :=
    Submodule.prodEquivOfIsCompl V₁ V₂ hCompl
  have h_dim₂ : Module.finrank E V₂ = 2 := by
    have h_tot := e_compl.finrank_eq
    rw [Module.finrank_prod, hb₁_dim, Module.finrank_fin_fun] at h_tot
    omega
  let b₂ : Module.Basis (Fin 2) E V₂ := (Module.finBasis E V₂).reindex (finCongr h_dim₂)
  let b : Module.Basis (Fin (m + 2)) E (Fin (m + 2) → E) :=
    ((b₁.prod b₂).map e_compl).reindex finSumFinEquiv
  have hb_cast : ∀ r : Fin m, b (Fin.castAdd 2 r) = v r := by
    intro r
    have h_symm : finSumFinEquiv.symm (Fin.castAdd 2 r) = Sum.inl r := by
      rw [Equiv.symm_apply_eq, finSumFinEquiv_apply_left]
    simp only [b, Module.Basis.reindex_apply, h_symm, Module.Basis.map_apply,
      Module.Basis.prod_apply, LinearMap.coe_inl, Sum.elim_inl, Function.comp_apply,
      e_compl, Submodule.coe_prodEquivOfIsCompl', ZeroMemClass.coe_zero, add_zero, b₁]
    exact congr_arg Subtype.val (Module.Basis.span_apply hv_ind r)
  let liftLin : ((Fin (m + 2) → E) →ₗ[E] (Fin (m + 2) → E)) →
      (MvPolynomial (Fin (m + 2)) E →ₐ[E] MvPolynomial (Fin (m + 2)) E) :=
    fun L => MvPolynomial.aeval fun i : Fin (m + 2) =>
      ∑ k : Fin (m + 2), MvPolynomial.C (L (Pi.single i 1) k) * MvPolynomial.X k
  have liftLin_id : liftLin LinearMap.id = AlgHom.id E (MvPolynomial (Fin (m + 2)) E) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [liftLin, Pi.single_apply]
  have liftLin_comp : ∀ L_a L_b : (Fin (m + 2) → E) →ₗ[E] (Fin (m + 2) → E),
      liftLin (L_a.comp L_b) = (liftLin L_a).comp (liftLin L_b) := by
    intro L_a L_b
    apply MvPolynomial.algHom_ext
    intro i
    let w : Fin (m + 2) → E := L_b (Pi.single i 1)
    have hw_sum : w = ∑ k : Fin (m + 2), w k • Pi.single k (1 : E) := by
      ext j
      simp [Pi.single_apply]
    have hLa_w : ∀ l : Fin (m + 2),
        L_a w l = ∑ k : Fin (m + 2), w k * L_a (Pi.single k 1) l := by
      intro l
      conv_lhs => rw [hw_sum]
      rw [map_sum]
      simp [Finset.sum_apply, smul_eq_mul]
    have h_term : ∀ k : Fin (m + 2),
        (liftLin L_a) (MvPolynomial.C (w k) * MvPolynomial.X k) =
          ∑ l : Fin (m + 2), MvPolynomial.C (w k * L_a (Pi.single k 1) l) * MvPolynomial.X l := by
      intro k
      rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
      dsimp only [liftLin]
      rw [MvPolynomial.aeval_X, Finset.mul_sum]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [← mul_assoc, ← MvPolynomial.C_mul]
    rw [AlgHom.comp_apply]
    have hLb_X : (liftLin L_b) (MvPolynomial.X i) =
        ∑ k : Fin (m + 2), MvPolynomial.C (w k) * MvPolynomial.X k := by
      dsimp only [liftLin, w]
      rw [MvPolynomial.aeval_X]
    have hLaLb_X : (liftLin (L_a.comp L_b)) (MvPolynomial.X i) =
        ∑ l : Fin (m + 2), MvPolynomial.C (L_a w l) * MvPolynomial.X l := by
      dsimp only [liftLin, w, LinearMap.comp_apply]
      rw [MvPolynomial.aeval_X]
    rw [hLaLb_X, hLb_X, map_sum]
    simp_rw [h_term]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [← Finset.sum_mul, ← map_sum, ← hLa_w l]
  have liftLin_MU : ∀ L : (Fin (m + 2) → E) →ₗ[E] (Fin (m + 2) → E),
      Ideal.map (liftLin L).toRingHom M_U ≤ M_U := by
    intro L
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    change liftLin L (MvPolynomial.X i) ∈ M_U
    dsimp only [liftLin]
    rw [MvPolynomial.aeval_X]
    exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  let Φ_hom : MvPolynomial (Fin (m + 2)) E →ₐ[E] MvPolynomial (Fin (m + 2)) E :=
    liftLin b.equivFun.toLinearMap
  let Θ : MvPolynomial (Fin (m + 2)) E →ₐ[E] MvPolynomial (Fin (m + 2)) E :=
    liftLin b.equivFun.symm.toLinearMap
  have hΦΘ : Φ_hom.comp Θ = AlgHom.id E (MvPolynomial (Fin (m + 2)) E) := by
    rw [← liftLin_comp, LinearEquiv.comp_coe, LinearEquiv.symm_trans_self,
      LinearEquiv.refl_toLinearMap, liftLin_id]
  have hΘΦ : Θ.comp Φ_hom = AlgHom.id E (MvPolynomial (Fin (m + 2)) E) := by
    rw [← liftLin_comp, LinearEquiv.comp_coe, LinearEquiv.self_trans_symm,
      LinearEquiv.refl_toLinearMap, liftLin_id]
  let Φ : MvPolynomial (Fin (m + 2)) E ≃ₐ[E] MvPolynomial (Fin (m + 2)) E :=
    AlgEquiv.ofAlgHom Φ_hom Θ hΦΘ hΘΦ
  have hΦ_MU : Ideal.map Φ.toAlgHom.toRingHom M_U = M_U := by
    apply le_antisymm
    · exact liftLin_MU b.equivFun.toLinearMap
    · have h_symm : Ideal.map Θ.toRingHom M_U ≤ M_U := liftLin_MU b.equivFun.symm.toLinearMap
      have h_push := Ideal.map_mono (f := Φ_hom.toRingHom) h_symm
      rw [Ideal.map_map] at h_push
      have h_id : Φ_hom.toRingHom.comp Θ.toRingHom =
          RingHom.id (MvPolynomial (Fin (m + 2)) E) :=
        RingHom.ext fun x => AlgHom.congr_fun hΦΘ x
      rwa [h_id, Ideal.map_id] at h_push
  have hΦ_norm : ∀ r : Fin m, Φ (g r) - MvPolynomial.X (Fin.castAdd 2 r) ∈ M_U ^ 2 := by
    intro r
    let k₀ : Fin (m + 2) := Fin.castAdd 2 r
    have hb_symm : b.equivFun.symm (Pi.single k₀ 1) = b k₀ := by
      rw [Module.Basis.equivFun_symm_apply]
      simp [Pi.single_apply]
    have hΘ_Xk : Θ (MvPolynomial.X k₀) =
        ∑ i : Fin (m + 2), MvPolynomial.C (v r i) * MvPolynomial.X i := by
      dsimp only [Θ, liftLin]
      rw [MvPolynomial.aeval_X]
      simp only [LinearEquiv.coe_coe, hb_symm]
      dsimp only [k₀]
      simp_rw [hb_cast r]
    let δ : MvPolynomial (Fin (m + 2)) E := g r - Θ (MvPolynomial.X k₀)
    have hδ_MU2 : δ ∈ M_U ^ 2 := by
      rw [h_mem_MU2_iff]
      refine ⟨?_, fun j => ?_⟩
      · have hg0 : (g r).coeff 0 = 0 := (h_mem_MU_iff (g r)).mp (hT_sub (hg_mem r))
        have hΘ0 : (Θ (MvPolynomial.X k₀)).coeff 0 = 0 := by
          rw [hΘ_Xk, MvPolynomial.coeff_sum]
          simp [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, h_single_ne_zero]
        simp [δ, hg0, hΘ0]
      · have hΘj : (Θ (MvPolynomial.X k₀)).coeff (Finsupp.single j 1) = v r j := by
          rw [hΘ_Xk, MvPolynomial.coeff_sum]
          simp [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X, h_single_inj]
        have hgj : (g r).coeff (Finsupp.single j 1) = v r j := by
          simpa [L₁] using congr_fun (hg_L1 r) j
        simp [δ, hgj, hΘj]
    have hΦ_δ : Φ δ = Φ (g r) - MvPolynomial.X k₀ := by
      simp only [δ, map_sub]
      congr 1
      exact AlgHom.congr_fun hΦΘ (MvPolynomial.X k₀)
    rw [← hΦ_δ]
    have h_mem_map : Φ.toAlgHom.toRingHom δ ∈ Ideal.map Φ.toAlgHom.toRingHom (M_U ^ 2) :=
      Ideal.mem_map_of_mem _ hδ_MU2
    rwa [Ideal.map_pow, hΦ_MU] at h_mem_map

  
  have h_ideal_pow_mono : ∀ {R : Type u} [CommSemiring R] {I J : Ideal R},
      I ≤ J → ∀ n : ℕ, I ^ n ≤ J ^ n := by
    intro R _ I J hIJ n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, pow_succ]
      exact Submodule.mul_le.mpr fun a ha b hb => Ideal.mul_mem_mul (ih ha) (hIJ hb)
  let h_quad : Fin m → MvPolynomial (Fin (m + 2)) E :=
    fun r => Φ (g r) - MvPolynomial.X (Fin.castAdd 2 r)
  let g_tilde : Fin m → MvPolynomial (Fin (m + 2)) E :=
    fun r => MvPolynomial.X (Fin.castAdd 2 r) + h_quad r
  have hg_tilde_eq : ∀ r : Fin m, g_tilde r = Φ (g r) := fun r => add_sub_cancel _ _
  let ι_poly : MvPolynomial (Fin 2) E →ₐ[E] MvPolynomial (Fin (m + 2)) E :=
    MvPolynomial.rename (Fin.natAdd m)
  have hι_MZ : Ideal.map ι_poly.toRingHom M_Z ≤ M_U := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
    change ι_poly (MvPolynomial.X j) ∈ M_U
    rw [MvPolynomial.rename_X]
    exact Ideal.subset_span ⟨Fin.natAdd m j, rfl⟩
  let J_id : ℕ → Ideal (MvPolynomial (Fin (m + 2)) E) :=
    fun d => Ideal.span (Set.range g_tilde) ⊔ M_U ^ (d + 1)
  let ι_Zd : ∀ d : ℕ, (MvPolynomial (Fin 2) E ⧸ M_Z ^ (d + 1)) →ₐ[E]
      (MvPolynomial (Fin (m + 2)) E ⧸ J_id d) := fun d =>
    Ideal.Quotient.liftₐ (M_Z ^ (d + 1)) ((Ideal.Quotient.mkₐ E (J_id d)).comp ι_poly)
      (fun a ha => by
        have h_map : ι_poly.toRingHom a ∈ Ideal.map ι_poly.toRingHom (M_Z ^ (d + 1)) :=
          Ideal.mem_map_of_mem _ ha
        rw [Ideal.map_pow] at h_map
        have h_in_MU : ι_poly a ∈ M_U ^ (d + 1) := h_ideal_pow_mono hι_MZ (d + 1) h_map
        change Ideal.Quotient.mk (J_id d) (ι_poly a) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Submodule.mem_sup_right h_in_MU))
  have h_surj_Zd : ∀ d : ℕ, Function.Surjective (ι_Zd d) := by
    intro d
    let q_d : MvPolynomial (Fin (m + 2)) E →ₐ[E] (MvPolynomial (Fin (m + 2)) E ⧸ J_id d) :=
      Ideal.Quotient.mkₐ E (J_id d)
    let q_Z : MvPolynomial (Fin 2) E →ₐ[E] (MvPolynomial (Fin 2) E ⧸ M_Z ^ (d + 1)) :=
      Ideal.Quotient.mkₐ E (M_Z ^ (d + 1))
    have h_ind_deg : ∀ (t : ℕ) (f : MvPolynomial (Fin (m + 2)) E),
        (∀ s ∈ f.support, d + 1 - t ≤ s.degree) → q_d f ∈ (ι_Zd d).range := by
      intro t
      induction t with
      | zero =>
        intro f hf
        have hf_MU : f ∈ M_U ^ (d + 1) := (h_mem_MU_pow_iff (d + 1) f).mpr (by simpa using hf)
        have hq0 : q_d f = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Submodule.mem_sup_right hf_MU)
        rw [hq0]
        exact (ι_Zd d).range.zero_mem
      | succ t ih =>
        intro f hf
        rw [MvPolynomial.as_sum f, map_sum]
        refine (ι_Zd d).range.sum_mem fun s hs => ?_
        have hs_deg : d + 1 - (t + 1) ≤ s.degree := hf s hs
        by_cases h_elim : ∃ r : Fin m, s (Fin.castAdd 2 r) ≠ 0
        · obtain ⟨r, hr⟩ := h_elim
          let k₀ : Fin (m + 2) := Fin.castAdd 2 r
          have hsk₀ : 1 ≤ s k₀ := Nat.one_le_iff_ne_zero.mpr hr
          let s' : Fin (m + 2) →₀ ℕ := s - Finsupp.single k₀ 1
          have hs_eq : Finsupp.single k₀ 1 + s' = s := by
            ext i
            simp only [Finsupp.add_apply, s', Finsupp.tsub_apply, Finsupp.single_apply]
            split_ifs with hi
            · subst hi; omega
            · omega
          have hs_deg_eq : s.degree = 1 + s'.degree := by
            rw [← hs_eq, map_add, Finsupp.degree_single]
          have h_mon : (MvPolynomial.monomial s (f.coeff s) : MvPolynomial (Fin (m + 2)) E) =
              MvPolynomial.X k₀ * MvPolynomial.monomial s' (f.coeff s) := by
            rw [hX_mul_monomial, hs_eq]
          have h_gt_zero : q_d (MvPolynomial.X k₀ + h_quad r) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr
              (Submodule.mem_sup_left (Ideal.subset_span ⟨r, rfl⟩))
          have h_Xk : q_d (MvPolynomial.X k₀) = - q_d (h_quad r) :=
            add_eq_zero_iff_eq_neg.mp (by simpa [map_add] using h_gt_zero)
          have h_rep : q_d (MvPolynomial.monomial s (f.coeff s)) =
              q_d (- h_quad r * MvPolynomial.monomial s' (f.coeff s)) := by
            rw [h_mon, map_mul, h_Xk, map_mul, map_neg]
          rw [h_rep]
          apply ih
          intro v hv
          obtain ⟨u, hu, w, hw, rfl⟩ :=
            Finset.mem_add.mp (MvPolynomial.support_mul (- h_quad r) _ hv)
          rw [MvPolynomial.support_neg] at hu
          have hu_deg : 2 ≤ u.degree := (h_mem_MU_pow_iff 2 (h_quad r)).mp (hΦ_norm r) u hu
          have hw_eq : w = s' :=
            Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hw)
          subst hw_eq
          rw [map_add]
          omega
        · push Not at h_elim
          let s₂ : Fin 2 →₀ ℕ := Finsupp.equivFunOnFinite.symm fun j => s (Fin.natAdd m j)
          have hs₂_apply : ∀ j : Fin 2, s₂ j = s (Fin.natAdd m j) := fun j => rfl
          have h_map_s₂ : Finsupp.mapDomain (Fin.natAdd m) s₂ = s := by
            ext k
            refine Fin.addCases (fun r => ?_) (fun j => ?_) k
            · rw [h_elim r]
              apply Finsupp.mapDomain_of_notMem_range
              rintro ⟨j, hj⟩
              have := congr_arg Fin.val hj
              simp at this
              omega
            · rw [Finsupp.mapDomain_apply, Finsupp.sum_fintype]
              · simp [Finsupp.single_apply, (Fin.natAdd_injective 2 m).eq_iff, hs₂_apply]
              · intro a; simp
          have h_ren : ι_poly (MvPolynomial.monomial s₂ (f.coeff s)) =
              MvPolynomial.monomial s (f.coeff s) := by
            simp only [ι_poly, MvPolynomial.rename_monomial, h_map_s₂]
          rw [← h_ren]
          exact ⟨q_Z (MvPolynomial.monomial s₂ (f.coeff s)), rfl⟩
    intro x
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact h_ind_deg (d + 1) f fun s _ => by omega

  
  have h_aeval_MZ_pow : ∀ (u : Fin (m + 2) → MvPolynomial (Fin 2) E),
      (∀ k, u k ∈ M_Z) →
      ∀ s : ℕ, Ideal.map (MvPolynomial.aeval u).toRingHom (M_U ^ s) ≤ M_Z ^ s := by
    intro u hu s
    rw [Ideal.map_pow]
    apply h_ideal_pow_mono _ s
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
    simpa using hu k
  have h_aeval_MZ : ∀ (u : Fin (m + 2) → MvPolynomial (Fin 2) E),
      (∀ k, u k ∈ M_Z) → ∀ p ∈ M_U, MvPolynomial.aeval u p ∈ M_Z := by
    intro u hu p hp
    have hp1 : p ∈ M_U ^ 1 := by rwa [pow_one]
    have h1 : MvPolynomial.aeval u p ∈ M_Z ^ 1 :=
      h_aeval_MZ_pow u hu 1 (Ideal.mem_map_of_mem _ hp1)
    rwa [pow_one] at h1
  let w : ℕ → (Fin (m + 2) → MvPolynomial (Fin 2) E) := fun t =>
    Nat.rec
      (Fin.addCases (fun _ => 0) (fun j => MvPolynomial.X j))
      (fun _ w_prev =>
        Fin.addCases (fun r => - MvPolynomial.aeval w_prev (h_quad r))
          (fun j => MvPolynomial.X j))
      t
  have hw_zero_cast : ∀ r : Fin m, w 0 (Fin.castAdd 2 r) = 0 := fun r => by
    dsimp only [w]
    exact Fin.addCases_left r
  have hw_zero_nat : ∀ j : Fin 2, w 0 (Fin.natAdd m j) = MvPolynomial.X j := fun j => by
    dsimp only [w]
    exact Fin.addCases_right j
  have hw_succ_cast : ∀ (t : ℕ) (r : Fin m),
      w (t + 1) (Fin.castAdd 2 r) = - MvPolynomial.aeval (w t) (h_quad r) := fun t r => by
    dsimp only [w]
    exact Fin.addCases_left r
  have hw_succ_nat : ∀ (t : ℕ) (j : Fin 2),
      w (t + 1) (Fin.natAdd m j) = MvPolynomial.X j := fun t j => by
    dsimp only [w]
    exact Fin.addCases_right j
  have hw_nat_all : ∀ (t : ℕ) (j : Fin 2), w t (Fin.natAdd m j) = MvPolynomial.X j := by
    intro t j
    rcases t with _ | t
    · exact hw_zero_nat j
    · exact hw_succ_nat t j
  have hw_mem : ∀ (t : ℕ) (k : Fin (m + 2)), w t k ∈ M_Z := by
    intro t
    induction t with
    | zero =>
      intro k
      refine Fin.addCases (fun r => ?_) (fun j => ?_) k
      · rw [hw_zero_cast]; exact M_Z.zero_mem
      · rw [hw_zero_nat]
        exact Ideal.subset_span ⟨j, rfl⟩
    | succ t ih =>
      intro k
      refine Fin.addCases (fun r => ?_) (fun j => ?_) k
      · rw [hw_succ_cast]
        apply M_Z.neg_mem
        exact h_aeval_MZ (w t) ih (h_quad r)
          (Ideal.pow_le_self (by decide : 2 ≠ 0) (hΦ_norm r))
      · rw [hw_succ_nat]
        exact Ideal.subset_span ⟨j, rfl⟩
  have h_aeval_sub : ∀ (s : ℕ) (u v : Fin (m + 2) → MvPolynomial (Fin 2) E),
      (∀ k, u k - v k ∈ M_Z ^ s) →
      ∀ p : MvPolynomial (Fin (m + 2)) E,
        MvPolynomial.aeval u p - MvPolynomial.aeval v p ∈ M_Z ^ s := by
    intro s u v huv p
    let π_s : MvPolynomial (Fin 2) E →ₐ[E] (MvPolynomial (Fin 2) E ⧸ M_Z ^ s) :=
      Ideal.Quotient.mkₐ E (M_Z ^ s)
    have h_eq_hom : π_s.comp (MvPolynomial.aeval u) = π_s.comp (MvPolynomial.aeval v) := by
      apply MvPolynomial.algHom_ext
      intro k
      simp only [AlgHom.comp_apply, MvPolynomial.aeval_X]
      change Ideal.Quotient.mk (M_Z ^ s) (u k) = Ideal.Quotient.mk (M_Z ^ s) (v k)
      rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact huv k
    have h_app := AlgHom.congr_fun h_eq_hom p
    simp only [AlgHom.comp_apply] at h_app
    change Ideal.Quotient.mk (M_Z ^ s) _ = Ideal.Quotient.mk (M_Z ^ s) _ at h_app
    rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem] at h_app
    exact h_app
  have h_aeval_quad : ∀ (s : ℕ) (u v : Fin (m + 2) → MvPolynomial (Fin 2) E),
      (∀ k, u k ∈ M_Z) → (∀ k, v k ∈ M_Z) → (∀ k, u k - v k ∈ M_Z ^ s) →
      ∀ H ∈ M_U ^ 2, MvPolynomial.aeval u H - MvPolynomial.aeval v H ∈ M_Z ^ (s + 1) := by
    intro s u v hu hv huv H hH
    rw [pow_two] at hH
    refine Submodule.mul_induction_on hH ?_ ?_
    · intro p hp q hq
      have h_id_alg : MvPolynomial.aeval u (p * q) - MvPolynomial.aeval v (p * q) =
          (MvPolynomial.aeval u p - MvPolynomial.aeval v p) * MvPolynomial.aeval u q +
            MvPolynomial.aeval v p * (MvPolynomial.aeval u q - MvPolynomial.aeval v q) := by
        simp only [map_mul]
        ring
      rw [h_id_alg]
      refine (M_Z ^ (s + 1)).add_mem ?_ ?_
      · rw [pow_succ M_Z s]
        exact Ideal.mul_mem_mul (h_aeval_sub s u v huv p) (h_aeval_MZ u hu q hq)
      · rw [pow_succ' M_Z s]
        exact Ideal.mul_mem_mul (h_aeval_MZ v hv p hp) (h_aeval_sub s u v huv q)
    · intro x y hx hy
      rw [map_add, map_add, show (MvPolynomial.aeval u x + MvPolynomial.aeval u y) -
          (MvPolynomial.aeval v x + MvPolynomial.aeval v y) =
        (MvPolynomial.aeval u x - MvPolynomial.aeval v x) +
          (MvPolynomial.aeval u y - MvPolynomial.aeval v y) by abel]
      exact (M_Z ^ (s + 1)).add_mem hx hy
  have hw_diff : ∀ (t : ℕ) (k : Fin (m + 2)), w (t + 1) k - w t k ∈ M_Z ^ (t + 1) := by
    intro t
    induction t with
    | zero =>
      intro k
      rw [Nat.zero_add, pow_one M_Z]
      exact M_Z.sub_mem (hw_mem 1 k) (hw_mem 0 k)
    | succ t ih =>
      intro k
      refine Fin.addCases (fun r => ?_) (fun j => ?_) k
      · rw [hw_succ_cast (t + 1) r, hw_succ_cast t r,
          show - MvPolynomial.aeval (w (t + 1)) (h_quad r) -
              - MvPolynomial.aeval (w t) (h_quad r) =
            - (MvPolynomial.aeval (w (t + 1)) (h_quad r) -
              MvPolynomial.aeval (w t) (h_quad r)) by abel]
        exact (M_Z ^ (t + 2)).neg_mem
          (h_aeval_quad (t + 1) (w (t + 1)) (w t) (hw_mem (t + 1)) (hw_mem t) ih
            (h_quad r) (hΦ_norm r))
      · rw [hw_succ_nat (t + 1) j, hw_succ_nat t j, sub_self]
        exact (M_Z ^ (t + 2)).zero_mem
  have h_inj_Zd : ∀ d : ℕ, Function.Injective (ι_Zd d) := by
    intro d
    let q_Z : MvPolynomial (Fin 2) E →ₐ[E] (MvPolynomial (Fin 2) E ⧸ M_Z ^ (d + 1)) :=
      Ideal.Quotient.mkₐ E (M_Z ^ (d + 1))
    let ρ_Zd : (MvPolynomial (Fin (m + 2)) E ⧸ J_id d) →ₐ[E]
        (MvPolynomial (Fin 2) E ⧸ M_Z ^ (d + 1)) :=
      Ideal.Quotient.liftₐ (J_id d) (q_Z.comp (MvPolynomial.aeval (w d))) (by
        have h_le : J_id d ≤ RingHom.ker (q_Z.comp (MvPolynomial.aeval (w d))).toRingHom := by
          refine sup_le ?_ ?_
          · rw [Ideal.span_le]
            rintro _ ⟨r, rfl⟩
            change Ideal.Quotient.mk (M_Z ^ (d + 1))
              (MvPolynomial.aeval (w d) (MvPolynomial.X (Fin.castAdd 2 r) + h_quad r)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem, map_add, MvPolynomial.aeval_X]
            have h_eq : w d (Fin.castAdd 2 r) + MvPolynomial.aeval (w d) (h_quad r) =
                - (w (d + 1) (Fin.castAdd 2 r) - w d (Fin.castAdd 2 r)) := by
              rw [hw_succ_cast d r]
              abel
            rw [h_eq]
            exact (M_Z ^ (d + 1)).neg_mem (hw_diff d (Fin.castAdd 2 r))
          · intro f hf
            change Ideal.Quotient.mk (M_Z ^ (d + 1)) (MvPolynomial.aeval (w d) f) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem]
            exact h_aeval_MZ_pow (w d) (hw_mem d) (d + 1) (Ideal.mem_map_of_mem _ hf)
        intro a ha
        exact h_le ha)
    have h_left_inv : ρ_Zd.comp (ι_Zd d) =
        AlgHom.id E (MvPolynomial (Fin 2) E ⧸ M_Z ^ (d + 1)) := by
      have h_comp_qZ : (ρ_Zd.comp (ι_Zd d)).comp q_Z = q_Z := by
        apply MvPolynomial.algHom_ext
        intro j
        change ρ_Zd (ι_Zd d (Ideal.Quotient.mk (M_Z ^ (d + 1)) (MvPolynomial.X j))) =
          q_Z (MvPolynomial.X j)
        change q_Z (MvPolynomial.aeval (w d) (ι_poly (MvPolynomial.X j))) =
          q_Z (MvPolynomial.X j)
        rw [MvPolynomial.rename_X, MvPolynomial.aeval_X, hw_nat_all d j]
      ext y
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact AlgHom.congr_fun h_comp_qZ p
    exact Function.LeftInverse.injective fun y => AlgHom.congr_fun h_left_inv y
  let Ψ : ∀ d : ℕ, (MvPolynomial (Fin 2) E ⧸ M_Z ^ (d + 1)) ≃ₐ[E]
      (MvPolynomial (Fin (m + 2)) E ⧸ J_id d) :=
    fun d => AlgEquiv.ofBijective (ι_Zd d) ⟨h_inj_Zd d, h_surj_Zd d⟩
  have hΨ_mk : ∀ (d : ℕ) (p : MvPolynomial (Fin 2) E),
      Ψ d (Ideal.Quotient.mk (M_Z ^ (d + 1)) p) =
        Ideal.Quotient.mk (J_id d) (ι_poly p) := fun _ _ => rfl

  
  let I_id : ℕ → Ideal (MvPolynomial (Fin (m + 2)) E) :=
    fun d => Ideal.span (Set.range g) ⊔ M_U ^ (d + 1)
  have h_range_gt : Set.range g_tilde = Φ '' Set.range g := by
    ext f
    constructor
    · rintro ⟨r, rfl⟩
      exact ⟨g r, ⟨r, rfl⟩, (hg_tilde_eq r).symm⟩
    · rintro ⟨_, ⟨r, rfl⟩, rfl⟩
      exact ⟨r, hg_tilde_eq r⟩
  have h_map_I : ∀ d : ℕ, Ideal.map Φ.toAlgHom.toRingHom (I_id d) = J_id d := by
    intro d
    simp only [I_id, J_id, Ideal.map_sup, Ideal.map_span, Ideal.map_pow, hΦ_MU]
    congr 2
    ext f
    rw [h_range_gt]
    rfl
  have h_map_J : ∀ d : ℕ, Ideal.map Φ.symm.toAlgHom.toRingHom (J_id d) = I_id d := by
    intro d
    rw [← h_map_I d, Ideal.map_map]
    have h_id : Φ.symm.toAlgHom.toRingHom.comp Φ.toAlgHom.toRingHom =
        RingHom.id (MvPolynomial (Fin (m + 2)) E) :=
      RingHom.ext fun x => Φ.symm_apply_apply x
    rw [h_id, Ideal.map_id]
  let Φ_quot : ∀ d : ℕ, (MvPolynomial (Fin (m + 2)) E ⧸ I_id d) ≃ₐ[E]
      (MvPolynomial (Fin (m + 2)) E ⧸ J_id d) := fun d =>
    let fwd : (MvPolynomial (Fin (m + 2)) E ⧸ I_id d) →ₐ[E]
        (MvPolynomial (Fin (m + 2)) E ⧸ J_id d) :=
      Ideal.Quotient.liftₐ (I_id d) ((Ideal.Quotient.mkₐ E (J_id d)).comp Φ.toAlgHom)
        (fun a ha => by
          have : Φ.toAlgHom.toRingHom a ∈ J_id d := by
            rw [← h_map_I d]
            exact Ideal.mem_map_of_mem _ ha
          exact Ideal.Quotient.eq_zero_iff_mem.mpr this)
    let bwd : (MvPolynomial (Fin (m + 2)) E ⧸ J_id d) →ₐ[E]
        (MvPolynomial (Fin (m + 2)) E ⧸ I_id d) :=
      Ideal.Quotient.liftₐ (J_id d) ((Ideal.Quotient.mkₐ E (I_id d)).comp Φ.symm.toAlgHom)
        (fun a ha => by
          have : Φ.symm.toAlgHom.toRingHom a ∈ I_id d := by
            rw [← h_map_J d]
            exact Ideal.mem_map_of_mem _ ha
          exact Ideal.Quotient.eq_zero_iff_mem.mpr this)
    AlgEquiv.ofAlgHom fwd bwd
      (by
        ext x
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
        change Ideal.Quotient.mk (J_id d) (Φ (Φ.symm f)) = Ideal.Quotient.mk (J_id d) f
        rw [Φ.apply_symm_apply])
      (by
        ext x
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
        change Ideal.Quotient.mk (I_id d) (Φ.symm (Φ f)) = Ideal.Quotient.mk (I_id d) f
        rw [Φ.symm_apply_apply])
  have hΦ_quot_mk : ∀ (d : ℕ) (f : MvPolynomial (Fin (m + 2)) E),
      Φ_quot d (Ideal.Quotient.mk (I_id d) f) =
        Ideal.Quotient.mk (J_id d) (Φ f) := fun _ _ => rfl
  let Ξ : ∀ d : ℕ, (MvPolynomial (Fin (m + 2)) E ⧸ I_id d) ≃ₐ[E]
      (MvPolynomial (Fin 2) E ⧸ M_Z ^ (d + 1)) :=
    fun d => (Φ_quot d).trans (Ψ d).symm
  refine ⟨g, Ξ, hg_mem, hSpan_d1, ?_⟩
  intro d₁ d₂ h_le f
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (Ξ d₂ (Ideal.Quotient.mk (I_id d₂) f))
  have hp_J2 : Ideal.Quotient.mk (J_id d₂) (ι_poly p) = Ideal.Quotient.mk (J_id d₂) (Φ f) := by
    calc Ideal.Quotient.mk (J_id d₂) (ι_poly p)
        = Ψ d₂ (Ideal.Quotient.mk (M_Z ^ (d₂ + 1)) p) := (hΨ_mk d₂ p).symm
      _ = Ψ d₂ ((Ψ d₂).symm (Φ_quot d₂ (Ideal.Quotient.mk (I_id d₂) f))) := by rw [hp]; rfl
      _ = Φ_quot d₂ (Ideal.Quotient.mk (I_id d₂) f) := (Ψ d₂).apply_symm_apply _
      _ = Ideal.Quotient.mk (J_id d₂) (Φ f) := hΦ_quot_mk d₂ f
  have h_le_J : J_id d₂ ≤ J_id d₁ :=
    sup_le_sup_left (Ideal.pow_le_pow_right (Nat.succ_le_succ h_le)) _
  have hp_J1 : Ideal.Quotient.mk (J_id d₁) (ι_poly p) = Ideal.Quotient.mk (J_id d₁) (Φ f) := by
    have h_fac := congr_arg (Ideal.Quotient.factor h_le_J) hp_J2
    simpa only [Ideal.Quotient.factor_mk] using h_fac
  have hp_eq1 : Ideal.Quotient.mk (M_Z ^ (d₁ + 1)) p = Ξ d₁ (Ideal.Quotient.mk (I_id d₁) f) := by
    apply (Ψ d₁).injective
    calc Ψ d₁ (Ideal.Quotient.mk (M_Z ^ (d₁ + 1)) p)
        = Ideal.Quotient.mk (J_id d₁) (ι_poly p) := hΨ_mk d₁ p
      _ = Ideal.Quotient.mk (J_id d₁) (Φ f) := hp_J1
      _ = Φ_quot d₁ (Ideal.Quotient.mk (I_id d₁) f) := (hΦ_quot_mk d₁ f).symm
      _ = Ψ d₁ (Ξ d₁ (Ideal.Quotient.mk (I_id d₁) f)) :=
          ((Ψ d₁).apply_symm_apply _).symm
  rw [← hp, Ideal.Quotient.factor_mk]
  exact hp_eq1

theorem weil_planar_truncation_finrank_and_quadratic_principal_ideal (E : Type u) [Field E] :
    let P_2 := MvPolynomial (Fin 2) E
    let M_Z : Ideal P_2 := Ideal.span (Set.range (MvPolynomial.X : Fin 2 → P_2))
    (∀ d : ℕ, FiniteDimensional E (P_2 ⧸ M_Z ^ (d + 1)) ∧
      Module.finrank E (P_2 ⧸ M_Z ^ (d + 1)) = (d + 1) * (d + 2) / 2) ∧
    (∀ (d : ℕ), 2 ≤ d →
      ∀ (K_d : Ideal (P_2 ⧸ M_Z ^ (d + 1))) (q : P_2),
        Module.finrank E ((P_2 ⧸ M_Z ^ (d + 1)) ⧸ K_d) = 1 + 2 * d →
        q ∈ M_Z ^ 2 →
        q ∉ M_Z ^ 3 →
        Ideal.Quotient.mk (M_Z ^ (d + 1)) q ∈ K_d →
        K_d = Ideal.span {Ideal.Quotient.mk (M_Z ^ (d + 1)) q}) :=
by
  classical
  intro P_2 M_Z
  let s_mk : ℕ → ℕ → (Fin 2 →₀ ℕ) := fun a b => Finsupp.single 0 a + Finsupp.single 1 b
  have hs_mk_0 : ∀ a b : ℕ, s_mk a b 0 = a := by
    intro a b
    simp [s_mk]
  have hs_mk_1 : ∀ a b : ℕ, s_mk a b 1 = b := by
    intro a b
    simp [s_mk]
  have hs_eta : ∀ s : Fin 2 →₀ ℕ, s_mk (s 0) (s 1) = s := by
    intro s
    ext i
    fin_cases i <;> simp [s_mk]
  have hcoeff_add : ∀ (x y : P_2) (s : Fin 2 →₀ ℕ), (x + y).coeff s = x.coeff s + y.coeff s :=
    fun x y s => map_add (MvPolynomial.lcoeff E s) x y
  have hdeg_eq : ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s = s 0 + s 1 := by
    intro s
    rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]
  have hdeg_mk : ∀ a b : ℕ, Finsupp.degree (s_mk a b) = a + b := by
    intro a b
    rw [hdeg_eq, hs_mk_0, hs_mk_1]
  have hmon_eq : ∀ (s : Fin 2 →₀ ℕ) (c : E),
      MvPolynomial.monomial s c =
        MvPolynomial.C c * (MvPolynomial.X 0 : P_2) ^ (s 0) * (MvPolynomial.X 1 : P_2) ^ (s 1) := by
    intro s c
    have hs_eta' : Finsupp.single (0 : Fin 2) (s 0) + Finsupp.single (1 : Fin 2) (s 1) = s :=
      hs_eta s
    rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
      mul_assoc, MvPolynomial.monomial_mul_monomial, one_mul, hs_eta',
      MvPolynomial.C_mul_monomial, mul_one]
  have hMulDeg : ∀ (A B : P_2) (a_deg b_deg : ℕ),
      (∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < a_deg → A.coeff s = 0) →
      (∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < b_deg → B.coeff s = 0) →
      ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < a_deg + b_deg → (A * B).coeff s = 0 := by
    intro A B a_deg b_deg hA hB s hs
    rw [MvPolynomial.coeff_mul]
    apply Finset.sum_eq_zero
    intro x hx
    have hx_eq : x.1 + x.2 = s := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
    have hdeg_sum : Finsupp.degree x.1 + Finsupp.degree x.2 = Finsupp.degree s := by
      rw [← map_add Finsupp.degree, hx_eq]
    have h_or : Finsupp.degree x.1 < a_deg ∨ Finsupp.degree x.2 < b_deg := by omega
    rcases h_or with h1 | h2
    · rw [hA x.1 h1, zero_mul]
    · rw [hB x.2 h2, mul_zero]
  have hMZ_deg1 : ∀ m ∈ M_Z, ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < 1 → m.coeff s = 0 := by
    have hMZ_ker : M_Z ≤ RingHom.ker (MvPolynomial.constantCoeff : P_2 →+* E) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact MvPolynomial.constantCoeff_X E i
    intro m hm s hs
    have hs01 : s 0 + s 1 < 1 := by rwa [← hdeg_eq]
    have hs0 : s 0 = 0 := by omega
    have hs1 : s 1 = 0 := by omega
    have hs_zero : s = 0 := by
      rw [← hs_eta s, hs0, hs1]
      simp [s_mk]
    rw [hs_zero, ← MvPolynomial.constantCoeff_eq]
    exact hMZ_ker hm
  have hMemPow : ∀ (k : ℕ) (f : P_2),
      f ∈ M_Z ^ k ↔ ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < k → f.coeff s = 0 := by
    intro k f
    constructor
    · intro hf
      refine Submodule.pow_induction_on_left' (R := P_2) M_Z
        (fun r s hs => (Nat.not_lt_zero _ hs).elim)
        (fun x y i _ _ ihx ihy s hs => by
          rw [hcoeff_add, ihx s hs, ihy s hs, add_zero])
        (fun m hm i x _ ihx s hs => ?_) hf
      have hs' : Finsupp.degree s < 1 + i := by omega
      exact hMulDeg m x 1 i (hMZ_deg1 m hm) ihx s hs'
    · intro hf
      suffices hsum : (∑ s ∈ f.support, MvPolynomial.monomial s (f.coeff s)) ∈ M_Z ^ k by
        rwa [← MvPolynomial.as_sum f] at hsum
      apply Ideal.sum_mem
      intro s hs
      have hcoeff_ne : f.coeff s ≠ 0 := MvPolynomial.mem_support_iff.mp hs
      have hdeg_ge : k ≤ s 0 + s 1 := by
        rw [← hdeg_eq]
        by_contra hlt
        exact hcoeff_ne (hf s (Nat.lt_of_not_ge hlt))
      have hX0 : (MvPolynomial.X 0 : P_2) ∈ M_Z := Ideal.subset_span ⟨0, rfl⟩
      have hX1 : (MvPolynomial.X 1 : P_2) ∈ M_Z := Ideal.subset_span ⟨1, rfl⟩
      have hpow0 : (MvPolynomial.X 0 : P_2) ^ (s 0) ∈ M_Z ^ (s 0) := Ideal.pow_mem_pow hX0 (s 0)
      have hpow1 : (MvPolynomial.X 1 : P_2) ^ (s 1) ∈ M_Z ^ (s 1) := Ideal.pow_mem_pow hX1 (s 1)
      have hmul01 : (MvPolynomial.X 0 : P_2) ^ (s 0) * (MvPolynomial.X 1 : P_2) ^ (s 1) ∈ M_Z ^ k := by
        apply Ideal.pow_le_pow_right hdeg_ge
        rw [pow_add]
        exact Ideal.mul_mem_mul hpow0 hpow1
      rw [hmon_eq s (f.coeff s), mul_assoc]
      exact Ideal.mul_mem_left _ _ hmul01
  let Δ : ℕ → Finset (ℕ × ℕ) :=
    fun d => (Finset.range (d + 1)).biUnion Finset.HasAntidiagonal.antidiagonal
  have hMemΔ : ∀ (d : ℕ) (p : ℕ × ℕ), p ∈ Δ d ↔ p.1 + p.2 ≤ d := by
    intro d p
    simp only [Δ, Finset.mem_biUnion, Finset.mem_range, Finset.HasAntidiagonal.mem_antidiagonal]
    exact ⟨fun ⟨n, hn, hp⟩ => by omega, fun hp => ⟨p.1 + p.2, by omega, rfl⟩⟩
  have hCardΔ : ∀ d : ℕ, (Δ d).card = (d + 1) * (d + 2) / 2 := by
    intro d
    induction d with
    | zero =>
      change ((Finset.range 1).biUnion Finset.HasAntidiagonal.antidiagonal).card = 1
      rw [Finset.range_one, Finset.singleton_biUnion, Finset.Nat.card_antidiagonal]
    | succ d ih =>
      have h_eq : Δ (d + 1) = Finset.HasAntidiagonal.antidiagonal (d + 1) ∪ Δ d := by
        change (Finset.range ((d + 1) + 1)).biUnion Finset.HasAntidiagonal.antidiagonal = _
        rw [Finset.range_add_one, Finset.biUnion_insert]
      have h_disj : Disjoint (Finset.HasAntidiagonal.antidiagonal (d + 1)) (Δ d) := by
        rw [Finset.disjoint_left]
        intro p hp1 hp2
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp1
        rw [hMemΔ] at hp2
        omega
      rw [h_eq, Finset.card_union_of_disjoint h_disj, Finset.Nat.card_antidiagonal, ih]
      have h_arith : (d + 1 + 1) * (d + 1 + 2) = (d + 1) * (d + 2) + (d + 1 + 1) * 2 := by ring
      rw [h_arith, Nat.add_mul_div_right _ _ (by omega : 0 < 2)]
      omega
  let polyOf_lin : ∀ d : ℕ, (↥(Δ d) → E) →ₗ[E] P_2 := fun d =>
    { toFun := fun c => ∑ p : ↥(Δ d), MvPolynomial.monomial (s_mk p.1.1 p.1.2) (c p)
      map_add' := fun c₁ c₂ => by
        simp only [Pi.add_apply, map_add, Finset.sum_add_distrib]
      map_smul' := fun r c => by
        simp only [Pi.smul_apply, map_smul, RingHom.id_apply, Finset.smul_sum] }
  have hCoeff_polyOf : ∀ (d : ℕ) (c : ↥(Δ d) → E) (q : ↥(Δ d)),
      (polyOf_lin d c).coeff (s_mk q.1.1 q.1.2) = c q := by
    intro d c q
    change (∑ p : ↥(Δ d), MvPolynomial.monomial (s_mk p.1.1 p.1.2) (c p)).coeff
      (s_mk q.1.1 q.1.2) = c q
    rw [MvPolynomial.coeff_sum]
    have h_term : ∀ p : ↥(Δ d),
        (MvPolynomial.monomial (s_mk p.1.1 p.1.2) (c p)).coeff (s_mk q.1.1 q.1.2) =
          if p = q then c p else 0 := by
      intro p
      rw [MvPolynomial.coeff_monomial]
      by_cases hpq : p = q
      · subst hpq; simp
      · have hne : s_mk p.1.1 p.1.2 ≠ s_mk q.1.1 q.1.2 := by
          intro h_eq
          apply hpq
          apply Subtype.ext
          apply Prod.ext
          · have h0 := congr_arg (fun s : Fin 2 →₀ ℕ => s 0) h_eq
            simpa [hs_mk_0] using h0
          · have h1 := congr_arg (fun s : Fin 2 →₀ ℕ => s 1) h_eq
            simpa [hs_mk_1] using h1
        simp [hpq, hne]
    simp_rw [h_term]
    simp
  have hClause1 : ∀ d : ℕ, FiniteDimensional E (P_2 ⧸ M_Z ^ (d + 1)) ∧
      Module.finrank E (P_2 ⧸ M_Z ^ (d + 1)) = (d + 1) * (d + 2) / 2 := by
    intro d
    let Ψ : (↥(Δ d) → E) →ₗ[E] (P_2 ⧸ M_Z ^ (d + 1)) :=
      (Ideal.Quotient.mkₐ E (M_Z ^ (d + 1))).toLinearMap.comp (polyOf_lin d)
    have hΨ_inj : Function.Injective Ψ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro c hc
      rw [LinearMap.mem_ker] at hc
      have hmem : polyOf_lin d c ∈ M_Z ^ (d + 1) :=
        Ideal.Quotient.eq_zero_iff_mem.mp hc
      ext q
      have hq_le : q.1.1 + q.1.2 ≤ d := (hMemΔ d q.1).mp q.2
      have hdeg_lt : Finsupp.degree (s_mk q.1.1 q.1.2) < d + 1 := by
        rw [hdeg_mk]; omega
      have hzero := (hMemPow (d + 1) (polyOf_lin d c)).mp hmem (s_mk q.1.1 q.1.2) hdeg_lt
      rw [hCoeff_polyOf] at hzero
      exact hzero
    have hΨ_surj : Function.Surjective Ψ := by
      intro x
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      let c : ↥(Δ d) → E := fun p => f.coeff (s_mk p.1.1 p.1.2)
      refine ⟨c, ?_⟩
      change Ideal.Quotient.mk (M_Z ^ (d + 1)) (polyOf_lin d c) =
        Ideal.Quotient.mk (M_Z ^ (d + 1)) f
      rw [Ideal.Quotient.eq, hMemPow]
      intro s hs
      have hs_le : s 0 + s 1 ≤ d := by
        rw [hdeg_eq] at hs; omega
      let q_s : ↥(Δ d) := ⟨(s 0, s 1), (hMemΔ d (s 0, s 1)).mpr hs_le⟩
      have hq_eq : s_mk q_s.1.1 q_s.1.2 = s := hs_eta s
      rw [MvPolynomial.coeff_sub, ← hq_eq, hCoeff_polyOf d c q_s]
      exact sub_self _
    let e_trunc : (↥(Δ d) → E) ≃ₗ[E] (P_2 ⧸ M_Z ^ (d + 1)) :=
      LinearEquiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩
    refine ⟨Module.Finite.equiv e_trunc, ?_⟩
    rw [← e_trunc.finrank_eq, Module.finrank_pi E, Fintype.card_coe, hCardΔ d]
  refine ⟨hClause1, ?_⟩
  intro d hd K_d q hFinQuot hq2 hq3 hqK
  obtain ⟨d', rfl⟩ : ∃ d' : ℕ, d = d' + 2 := ⟨d - 2, by omega⟩
  let R_d := P_2 ⧸ M_Z ^ (d' + 3)
  let q_bar : R_d := Ideal.Quotient.mk (M_Z ^ (d' + 3)) q
  let Q_2 : P_2 := MvPolynomial.homogeneousComponent 2 q
  have hQ2_hom : Q_2.IsHomogeneous 2 := MvPolynomial.homogeneousComponent_isHomogeneous 2 q
  have hQ2_deg : ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < 2 → Q_2.coeff s = 0 := by
    intro s hs
    rw [MvPolynomial.coeff_homogeneousComponent]
    have hne : Finsupp.degree s ≠ 2 := by omega
    simp [hne]
  have hQ2_ne : Q_2 ≠ 0 := by
    intro hQ2_zero
    apply hq3
    rw [hMemPow]
    intro s hs
    by_cases hs2 : Finsupp.degree s < 2
    · exact (hMemPow 2 q).mp hq2 s hs2
    · have hs_eq : Finsupp.degree s = 2 := by omega
      have h0 : Q_2.coeff s = 0 := by rw [hQ2_zero]; rfl
      rw [MvPolynomial.coeff_homogeneousComponent] at h0
      simp only [hs_eq, ↓reduceIte] at h0
      exact h0
  have hRem_q : ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < 3 → (q - Q_2).coeff s = 0 := by
    intro s hs
    rw [MvPolynomial.coeff_sub]
    by_cases hs2 : Finsupp.degree s < 2
    · rw [(hMemPow 2 q).mp hq2 s hs2, hQ2_deg s hs2, sub_zero]
    · have hs_eq : Finsupp.degree s = 2 := by omega
      have h_eq : Q_2.coeff s = q.coeff s := by
        rw [MvPolynomial.coeff_homogeneousComponent]
        simp only [hs_eq, ↓reduceIte]
      rw [h_eq, sub_self]
  let μ_q : (↥(Δ d') → E) →ₗ[E] R_d :=
    { toFun := fun c => Ideal.Quotient.mkₐ E (M_Z ^ (d' + 3)) (polyOf_lin d' c * q)
      map_add' := fun c₁ c₂ => by
        rw [map_add, add_mul, map_add]
      map_smul' := fun r c => by
        simp only [map_smul, Algebra.smul_mul_assoc, RingHom.id_apply] }
  have hRange_le_Sq : LinearMap.range μ_q ≤ (Ideal.span {q_bar}).restrictScalars E := by
    rintro _ ⟨c, rfl⟩
    change Ideal.Quotient.mk (M_Z ^ (d' + 3)) (polyOf_lin d' c * q) ∈ Ideal.span {q_bar}
    rw [map_mul, mul_comm]
    exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
  have hμ_inj : Function.Injective μ_q := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro c hc
    rw [LinearMap.mem_ker] at hc
    by_contra hc_ne
    obtain ⟨p₀, hp₀⟩ : ∃ p₀ : ↥(Δ d'), c p₀ ≠ 0 := Function.ne_iff.mp hc_ne
    let H : P_2 := polyOf_lin d' c
    have hH_p₀ : H.coeff (s_mk p₀.1.1 p₀.1.2) ≠ 0 := by
      change (polyOf_lin d' c).coeff (s_mk p₀.1.1 p₀.1.2) ≠ 0
      rwa [hCoeff_polyOf]
    have hH_ne : H.support.Nonempty := ⟨s_mk p₀.1.1 p₀.1.2, MvPolynomial.mem_support_iff.mpr hH_p₀⟩
    have hH_supp_le : ∀ s ∈ H.support, Finsupp.degree s ≤ d' := by
      intro s hs
      by_contra hgt
      have hcoeff_ne : H.coeff s ≠ 0 := MvPolynomial.mem_support_iff.mp hs
      apply hcoeff_ne
      change (∑ p : ↥(Δ d'), MvPolynomial.monomial (s_mk p.1.1 p.1.2) (c p)).coeff s = 0
      rw [MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro p _
      rw [MvPolynomial.coeff_monomial]
      have hne : s_mk p.1.1 p.1.2 ≠ s := by
        intro h_eq
        have hp_le : p.1.1 + p.1.2 ≤ d' := (hMemΔ d' p.1).mp p.2
        have hdeg_s : Finsupp.degree s = p.1.1 + p.1.2 := by
          rw [← h_eq, hdeg_mk]
        omega
      simp [hne]
    let e_min : ℕ := H.support.inf' hH_ne Finsupp.degree
    obtain ⟨s_min, hs_min_mem, hs_min_eq⟩ := Finset.exists_mem_eq_inf' hH_ne Finsupp.degree
    have he_min_le : e_min ≤ d' := by
      change H.support.inf' hH_ne Finsupp.degree ≤ d'
      rw [hs_min_eq]
      exact hH_supp_le s_min hs_min_mem
    let H_min : P_2 := MvPolynomial.homogeneousComponent e_min H
    have hH_min_hom : H_min.IsHomogeneous e_min :=
      MvPolynomial.homogeneousComponent_isHomogeneous e_min H
    have hH_min_deg : ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < e_min → H_min.coeff s = 0 := by
      intro s hs
      rw [MvPolynomial.coeff_homogeneousComponent]
      have hne : Finsupp.degree s ≠ e_min := by omega
      simp [hne]
    have hH_min_ne : H_min ≠ 0 := by
      intro h_zero
      have h0 : H_min.coeff s_min = 0 := by rw [h_zero]; rfl
      rw [MvPolynomial.coeff_homogeneousComponent] at h0
      have hs_min_eq' : Finsupp.degree s_min = e_min := hs_min_eq.symm
      simp only [hs_min_eq', ↓reduceIte] at h0
      exact (MvPolynomial.mem_support_iff.mp hs_min_mem) h0
    have hRem_H : ∀ s : Fin 2 →₀ ℕ, Finsupp.degree s < e_min + 1 → (H - H_min).coeff s = 0 := by
      intro s hs
      rw [MvPolynomial.coeff_sub]
      by_cases hHs : H.coeff s = 0
      · have hHmin_s : H_min.coeff s = 0 := by
          rw [MvPolynomial.coeff_homogeneousComponent]
          split_ifs <;> simp [hHs]
        rw [hHs, hHmin_s, sub_zero]
      · have hs_mem : s ∈ H.support := MvPolynomial.mem_support_iff.mpr hHs
        have hs_ge : e_min ≤ Finsupp.degree s := Finset.inf'_le Finsupp.degree hs_mem
        have hs_eq : Finsupp.degree s = e_min := by omega
        have h_eq : H_min.coeff s = H.coeff s := by
          rw [MvPolynomial.coeff_homogeneousComponent]
          simp only [hs_eq, ↓reduceIte]
        rw [h_eq, sub_self]
    have hProd_ne : H_min * Q_2 ≠ 0 := mul_ne_zero hH_min_ne hQ2_ne
    have hEx_t : ∃ t_star : Fin 2 →₀ ℕ, (H_min * Q_2).coeff t_star ≠ 0 := by
      by_contra hall
      push Not at hall
      apply hProd_ne
      ext s
      simpa using hall s
    obtain ⟨t_star, ht_star_ne⟩ := hEx_t
    have hProd_hom : (H_min * Q_2).IsHomogeneous (e_min + 2) :=
      MvPolynomial.IsHomogeneous.mul hH_min_hom hQ2_hom
    have ht_star_deg : Finsupp.degree t_star = e_min + 2 := by
      have hw : Finsupp.weight 1 t_star = e_min + 2 := hProd_hom ht_star_ne
      have h_dw : Finsupp.degree t_star = Finsupp.weight 1 t_star :=
        DFunLike.congr_fun Finsupp.degree_eq_weight_one t_star
      exact h_dw.trans hw
    have h_decomp : H * q = H_min * Q_2 + H_min * (q - Q_2) + (H - H_min) * q := by ring
    have h_term1 : (H_min * (q - Q_2)).coeff t_star = 0 :=
      hMulDeg H_min (q - Q_2) e_min 3 hH_min_deg hRem_q t_star (by omega)
    have h_term2 : ((H - H_min) * q).coeff t_star = 0 :=
      hMulDeg (H - H_min) q (e_min + 1) 2 hRem_H ((hMemPow 2 q).mp hq2) t_star (by omega)
    have hHq_ne : (H * q).coeff t_star ≠ 0 := by
      rw [h_decomp, hcoeff_add, hcoeff_add, h_term1, h_term2, add_zero, add_zero]
      exact ht_star_ne
    have hHq_mem : H * q ∈ M_Z ^ (d' + 3) :=
      Ideal.Quotient.eq_zero_iff_mem.mp hc
    have hHq_zero : (H * q).coeff t_star = 0 :=
      (hMemPow (d' + 3) (H * q)).mp hHq_mem t_star (by omega)
    exact hHq_ne hHq_zero
  have hSpan_le_Kd : Ideal.span {q_bar} ≤ K_d :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hqK)
  let S_q : Submodule E R_d := (Ideal.span {q_bar}).restrictScalars E
  let S_K : Submodule E R_d := K_d.restrictScalars E
  have hSq_le_SK : S_q ≤ S_K := hSpan_le_Kd
  have hRange_le_SK : LinearMap.range μ_q ≤ S_K := le_trans hRange_le_Sq hSq_le_SK
  have : FiniteDimensional E R_d := (hClause1 (d' + 2)).1
  have hDimRd : Module.finrank E R_d = (d' + 3) * (d' + 4) / 2 := (hClause1 (d' + 2)).2
  have hDimRange : Module.finrank E ↥(LinearMap.range μ_q) = (d' + 1) * (d' + 2) / 2 := by
    rw [LinearMap.finrank_range_of_inj hμ_inj, Module.finrank_pi E, Fintype.card_coe, hCardΔ d']
  have hDimQuotSK : Module.finrank E (R_d ⧸ S_K) = 1 + 2 * (d' + 2) := by
    rw [(Submodule.Quotient.restrictScalarsEquiv E K_d).finrank_eq]
    exact hFinQuot
  have hSumSK := Submodule.finrank_quotient_add_finrank S_K
  rw [hDimQuotSK, hDimRd] at hSumSK
  have hArith2 : (d' + 3) * (d' + 4) = (d' + 1) * (d' + 2) + (1 + 2 * (d' + 2)) * 2 := by ring
  rw [hArith2, Nat.add_mul_div_right _ _ (by omega : 0 < 2)] at hSumSK
  have hFinrankEq : Module.finrank E ↥(LinearMap.range μ_q) = Module.finrank E ↥S_K := by omega
  have hRange_eq_SK : LinearMap.range μ_q = S_K :=
    Submodule.eq_of_le_of_finrank_eq hRange_le_SK hFinrankEq
  apply le_antisymm
  · intro x hx
    have hx_SK : x ∈ S_K := hx
    rw [← hRange_eq_SK] at hx_SK
    exact hRange_le_Sq hx_SK
  · exact hSpan_le_Kd

theorem weil_flat_noetherian_fiber_generators_nakayama_lci_chart (A₀ B₀ κ : Type u)
    [CommRing A₀] [IsNoetherianRing A₀]
    [CommRing B₀] [Algebra A₀ B₀] [Module.Flat A₀ B₀]
    [Field κ] [Algebra A₀ κ]
    (k₀ : ℕ)
    (π₀ : MvPolynomial (Fin (k₀ + 1)) A₀ →+* B₀)
    (hπ₀_C : π₀.comp MvPolynomial.C = algebraMap A₀ B₀)
    (hπ₀_surj : Function.Surjective π₀)
    (q_x : PrimeSpectrum B₀)
    (p₀ : PrimeSpectrum A₀)
    (hp₀ : p₀.asIdeal = Ideal.comap (algebraMap A₀ B₀) q_x.asIdeal)
    (hκ_ker : RingHom.ker (algebraMap A₀ κ) = p₀.asIdeal)
    (hκ_frac : ∀ c : κ, ∃ a s : A₀, s ∉ p₀.asIdeal ∧ c * algebraMap A₀ κ s = algebraMap A₀ κ a)
    (q_bar : PrimeSpectrum (TensorProduct A₀ κ B₀))
    (hq_bar_comap : Ideal.comap (Algebra.TensorProduct.includeRight.toRingHom :
      B₀ →+* TensorProduct A₀ κ B₀) q_bar.asIdeal = q_x.asIdeal) :
    let P_κ := MvPolynomial (Fin (k₀ + 1)) κ
    let π_κ : P_κ →ₐ[κ] TensorProduct A₀ κ B₀ :=
      MvPolynomial.aeval (fun i => Algebra.TensorProduct.includeRight (π₀ (MvPolynomial.X i)))
    let I_κ : Ideal P_κ := RingHom.ker π_κ.toRingHom
    let Q_bar : Ideal P_κ := Ideal.comap π_κ.toRingHom q_bar.asIdeal
    haveI : Q_bar.IsPrime := Ideal.IsPrime.comap π_κ.toRingHom
    let P := Localization.AtPrime Q_bar
    Function.Surjective π_κ ∧
    (∀ f_bar : Fin k₀ → P_κ,
      (∀ r : Fin k₀, f_bar r ∈ I_κ) →
      Ideal.map (algebraMap P_κ P) I_κ = Ideal.map (algebraMap P_κ P) (Ideal.span (Set.range f_bar)) →
      ∃ h_B : B₀,
        h_B ∉ q_x.asIdeal ∧
        ∀ (B : Type u) [CommRing B] [Algebra B₀ B] [IsLocalization.Away h_B B],
          ∃ (π : MvPolynomial (Fin ((k₀ + 1) + 1)) A₀ →+* B)
            (F : Fin (k₀ + 1) → MvPolynomial (Fin ((k₀ + 1) + 1)) A₀),
            π.comp MvPolynomial.C = (algebraMap B₀ B).comp (algebraMap A₀ B₀) ∧
            Function.Surjective π ∧
            RingHom.ker π = Ideal.span (Set.range F)) :=
by
  have _ := hp₀
  let P₀ := MvPolynomial (Fin (k₀ + 1)) A₀
  let P_κ := MvPolynomial (Fin (k₀ + 1)) κ
  let map_κ : P₀ →+* P_κ := MvPolynomial.map (algebraMap A₀ κ)
  let π_κ : P_κ →ₐ[κ] TensorProduct A₀ κ B₀ :=
    MvPolynomial.aeval (fun i => Algebra.TensorProduct.includeRight (π₀ (MvPolynomial.X i)))
  let I₀ : Ideal P₀ := RingHom.ker π₀
  let I_κ : Ideal P_κ := RingHom.ker π_κ.toRingHom
  let Q_bar : Ideal P_κ := Ideal.comap π_κ.toRingHom q_bar.asIdeal
  have : Q_bar.IsPrime := Ideal.IsPrime.comap π_κ.toRingHom
  let P := Localization.AtPrime Q_bar
  change Function.Surjective π_κ ∧
    (∀ f_bar : Fin k₀ → P_κ,
      (∀ r : Fin k₀, f_bar r ∈ I_κ) →
      Ideal.map (algebraMap P_κ P) I_κ = Ideal.map (algebraMap P_κ P) (Ideal.span (Set.range f_bar)) →
      ∃ h_B : B₀,
        h_B ∉ q_x.asIdeal ∧
        ∀ (B : Type u) [CommRing B] [Algebra B₀ B] [IsLocalization.Away h_B B],
          ∃ (π : MvPolynomial (Fin ((k₀ + 1) + 1)) A₀ →+* B)
            (F : Fin (k₀ + 1) → MvPolynomial (Fin ((k₀ + 1) + 1)) A₀),
            π.comp MvPolynomial.C = (algebraMap B₀ B).comp (algebraMap A₀ B₀) ∧
            Function.Surjective π ∧
            RingHom.ker π = Ideal.span (Set.range F))
  
  have hComm_hom : π_κ.toRingHom.comp map_κ =
      (Algebra.TensorProduct.includeRight (R := A₀) (A := κ) (B := B₀)).toRingHom.comp π₀ := by
    apply MvPolynomial.ringHom_ext'
    · ext a
      dsimp only [map_κ, π_κ]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C,
        Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.includeRight_apply,
        Algebra.algebraMap_self, RingHom.id_apply]
      have h_π₀ := RingHom.congr_fun hπ₀_C a
      simp only [RingHom.comp_apply] at h_π₀
      rw [h_π₀, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
        TensorProduct.smul_tmul]
    · intro i
      dsimp only [map_κ, π_κ]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [MvPolynomial.map_X, MvPolynomial.aeval_X]
  have hComm : ∀ G : P₀, π_κ (map_κ G) = Algebra.TensorProduct.includeRight (π₀ G) :=
    fun G => RingHom.congr_fun hComm_hom G
  have hπ_κ_surj : Function.Surjective π_κ := by
    intro z
    refine TensorProduct.inductionOn (motive := fun z => ∃ a, π_κ a = z) z ?_ ?_
    · intro c b
      obtain ⟨G, rfl⟩ := hπ₀_surj b
      refine ⟨MvPolynomial.C c * map_κ G, ?_⟩
      rw [map_mul, MvPolynomial.aeval_C, hComm G,
        Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.includeRight_apply,
        Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    · rintro x y ⟨Hx, hHx⟩ ⟨Hy, hHy⟩
      exact ⟨Hx + Hy, by rw [map_add, hHx, hHy]⟩
  refine ⟨hπ_κ_surj, ?_⟩
  intro f_bar hf_bar_mem hMap_P
  let π₀_alg : P₀ →ₐ[A₀] B₀ :=
    { π₀ with commutes' := fun a => RingHom.congr_fun hπ₀_C a }
  let M₀ : Submodule A₀ P₀ := I₀.restrictScalars A₀
  let ι₀ : ↥M₀ →ₗ[A₀] P₀ := M₀.subtype
  have hinj_ι₀ : Function.Injective ι₀ := Subtype.val_injective
  have hSurj_lin : Function.Surjective π₀_alg.toLinearMap := hπ₀_surj
  have hExact : Function.Exact ι₀ π₀_alg.toLinearMap := by
    intro G
    change π₀ G = 0 ↔ G ∈ Set.range ι₀
    constructor
    · intro hG
      exact ⟨⟨G, hG⟩, rfl⟩
    · rintro ⟨⟨_, hG⟩, rfl⟩
      exact hG
  have hExact_κ : Function.Exact (LinearMap.lTensor κ ι₀) (LinearMap.lTensor κ π₀_alg.toLinearMap) :=
    lTensor_exact κ hExact hSurj_lin
  let e_tensor : TensorProduct A₀ κ P₀ ≃ₐ[κ] P_κ := MvPolynomial.algebraTensorAlgEquiv A₀ κ
  have h_e_comm : ∀ u : TensorProduct A₀ κ P₀,
      π_κ (e_tensor u) = LinearMap.lTensor κ π₀_alg.toLinearMap u := by
    intro u
    refine TensorProduct.inductionOn
      (motive := fun u => π_κ (e_tensor u) = LinearMap.lTensor κ π₀_alg.toLinearMap u)
      u ?_ ?_
    · intro c G
      change π_κ ((MvPolynomial.algebraTensorAlgEquiv A₀ κ) (c ⊗ₜ[A₀] G)) = c ⊗ₜ[A₀] π₀ G
      rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_smul, hComm G,
        Algebra.TensorProduct.includeRight_apply]
      change (c * 1) ⊗ₜ[A₀] π₀ G = c ⊗ₜ[A₀] π₀ G
      rw [mul_one]
    · intro x y hx hy
      rw [map_add, map_add, map_add, hx, hy]
  have hTensorClear : ∀ w : TensorProduct A₀ κ ↥M₀,
      e_tensor (LinearMap.lTensor κ ι₀ w) ∈ Ideal.map map_κ I₀ ∧
      ∃ (s : A₀) (F : P₀), s ∉ p₀.asIdeal ∧ F ∈ I₀ ∧
        map_κ F = MvPolynomial.C (algebraMap A₀ κ s) * e_tensor (LinearMap.lTensor κ ι₀ w) := by
    intro w
    refine TensorProduct.inductionOn
      (motive := fun w =>
        e_tensor (LinearMap.lTensor κ ι₀ w) ∈ Ideal.map map_κ I₀ ∧
        ∃ (s : A₀) (F : P₀), s ∉ p₀.asIdeal ∧ F ∈ I₀ ∧
          map_κ F = MvPolynomial.C (algebraMap A₀ κ s) * e_tensor (LinearMap.lTensor κ ι₀ w))
      w ?_ ?_
    · intro c m
      have hm_eq : e_tensor (LinearMap.lTensor κ ι₀ (c ⊗ₜ[A₀] m)) =
          MvPolynomial.C c * map_κ m.1 := by
        change (MvPolynomial.algebraTensorAlgEquiv A₀ κ) (c ⊗ₜ[A₀] m.1) = _
        rw [MvPolynomial.algebraTensorAlgEquiv_tmul, MvPolynomial.smul_eq_C_mul]
      rw [hm_eq]
      refine ⟨Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem map_κ m.2), ?_⟩
      obtain ⟨a, s, hs, hcs⟩ := hκ_frac c
      refine ⟨s, MvPolynomial.C a * m.1, hs, Ideal.mul_mem_left _ _ m.2, ?_⟩
      calc map_κ (MvPolynomial.C a * m.1)
          = MvPolynomial.C (algebraMap A₀ κ a) * map_κ m.1 := by
              rw [map_mul, MvPolynomial.map_C]
        _ = MvPolynomial.C (c * algebraMap A₀ κ s) * map_κ m.1 := by rw [← hcs]
        _ = MvPolynomial.C (algebraMap A₀ κ s) * (MvPolynomial.C c * map_κ m.1) := by
              rw [MvPolynomial.C_mul]; ring
    · intro w₁ w₂ hw₁ hw₂
      have hadd_eq : e_tensor (LinearMap.lTensor κ ι₀ (w₁ + w₂)) =
          e_tensor (LinearMap.lTensor κ ι₀ w₁) + e_tensor (LinearMap.lTensor κ ι₀ w₂) := by
        rw [map_add, map_add]
      rw [hadd_eq]
      obtain ⟨hmem₁, s₁, F₁, hs₁, hF₁, heq₁⟩ := hw₁
      obtain ⟨hmem₂, s₂, F₂, hs₂, hF₂, heq₂⟩ := hw₂
      refine ⟨Ideal.add_mem _ hmem₁ hmem₂, s₁ * s₂,
        MvPolynomial.C s₂ * F₁ + MvPolynomial.C s₁ * F₂,
        p₀.asIdeal.primeCompl.mul_mem hs₁ hs₂,
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ hF₁) (Ideal.mul_mem_left _ _ hF₂), ?_⟩
      calc map_κ (MvPolynomial.C s₂ * F₁ + MvPolynomial.C s₁ * F₂)
          = MvPolynomial.C (algebraMap A₀ κ s₂) * map_κ F₁ +
              MvPolynomial.C (algebraMap A₀ κ s₁) * map_κ F₂ := by
              rw [map_add, map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_C]
        _ = MvPolynomial.C (algebraMap A₀ κ s₂) *
              (MvPolynomial.C (algebraMap A₀ κ s₁) * e_tensor (LinearMap.lTensor κ ι₀ w₁)) +
            MvPolynomial.C (algebraMap A₀ κ s₁) *
              (MvPolynomial.C (algebraMap A₀ κ s₂) * e_tensor (LinearMap.lTensor κ ι₀ w₂)) := by
              rw [heq₁, heq₂]
        _ = MvPolynomial.C (algebraMap A₀ κ (s₁ * s₂)) *
              (e_tensor (LinearMap.lTensor κ ι₀ w₁) + e_tensor (LinearMap.lTensor κ ι₀ w₂)) := by
              rw [map_mul, MvPolynomial.C_mul]; ring
  have hKerLift : ∀ f : P_κ, f ∈ I_κ →
      f ∈ Ideal.map map_κ I₀ ∧
      ∃ (s : A₀) (F : P₀), s ∉ p₀.asIdeal ∧ F ∈ I₀ ∧
        map_κ F = MvPolynomial.C (algebraMap A₀ κ s) * f := by
    intro f hf
    have hu_ker : LinearMap.lTensor κ π₀_alg.toLinearMap (e_tensor.symm f) = 0 := by
      rw [← h_e_comm, e_tensor.apply_symm_apply]
      exact hf
    obtain ⟨w, hw⟩ := (hExact_κ (e_tensor.symm f)).mp hu_ker
    have hfw : e_tensor (LinearMap.lTensor κ ι₀ w) = f := by
      rw [hw, e_tensor.apply_symm_apply]
    have hTC := hTensorClear w
    rwa [hfw] at hTC
  have hI_κ_eq : I_κ = Ideal.map map_κ I₀ := by
    apply le_antisymm
    · intro f hf
      exact (hKerLift f hf).1
    · rw [Ideal.map_le_iff_le_comap]
      intro G hG
      change π_κ (map_κ G) = 0
      rw [hComm G, RingHom.mem_ker.mp hG, map_zero]
  choose s_r F₀ hs_r hF₀_mem hF₀_eq using fun r : Fin k₀ => (hKerLift (f_bar r) (hf_bar_mem r)).2
  let J₀ : Ideal P₀ := Ideal.span (Set.range F₀)
  have hJI : J₀ ≤ I₀ := by
    rw [Ideal.span_le]
    rintro _ ⟨r, rfl⟩
    exact hF₀_mem r
  have hSpan_eq : Ideal.map map_κ J₀ = Ideal.span (Set.range f_bar) := by
    apply le_antisymm
    · rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨r, rfl⟩, rfl⟩
      rw [SetLike.mem_coe, hF₀_eq r]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨r, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨r, rfl⟩
      rw [SetLike.mem_coe]
      have hsr_ne : algebraMap A₀ κ (s_r r) ≠ 0 := by
        intro h0
        apply hs_r r
        rw [← hκ_ker, RingHom.mem_ker]
        exact h0
      have h_inv : (algebraMap A₀ κ (s_r r))⁻¹ * algebraMap A₀ κ (s_r r) = 1 :=
        inv_mul_cancel₀ hsr_ne
      have hf_eq : f_bar r = MvPolynomial.C (algebraMap A₀ κ (s_r r))⁻¹ * map_κ (F₀ r) := by
        rw [hF₀_eq r, ← mul_assoc, ← MvPolynomial.C_mul, h_inv, MvPolynomial.C_1, one_mul]
      rw [hf_eq]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem map_κ (Ideal.subset_span ⟨r, rfl⟩))
  
  let I_A : Ideal A₀ := p₀.asIdeal
  let K₀ : Ideal P₀ := Ideal.map MvPolynomial.C I_A
  have hInfLe : I₀ ⊓ K₀ ≤ K₀ * I₀ := by
    have hinj_lTensor : Function.Injective (LinearMap.lTensor (A₀ ⧸ I_A) ι₀) :=
