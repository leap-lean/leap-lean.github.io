        rw [map_zero]
        change (1 : K) ⊗ₜ[A₁] δ = 0
        apply (Algebra.TensorProduct.cancelBaseChange B₀ A₁ K K R).injective
        rw [map_zero, hCancelK δ, hδ]
      obtain ⟨j_k, f_k, g_k, h_eq_k⟩ :=
        (Limits.Concrete.isColimit_rep_eq_iff_exists (mkF D₁) hc_D x₀ y₀).mp hδ_colim
      have h_zero_k :
          ((1 : ↥(Algebra.adjoin B₀ (↑j_k.1 : Set K))) ⊗ₜ[A₁] δ :
            TensorProduct A₁ ↥(Algebra.adjoin B₀ (↑j_k.1 : Set K)) D₁) = 0 := by
        have h_lhs : ((mkF D₁).map f_k).hom x₀ =
