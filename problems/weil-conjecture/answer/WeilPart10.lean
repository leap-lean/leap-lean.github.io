      = ψ₁ (KaehlerDifferential.D R' D d) := hψ₁_D d
    _ = ψ_D (KaehlerDifferential.D R' D d) := (hψ_D_eq₁ _).symm
    _ = ρ₁₂_W u₁₂ * ψ₂ (KaehlerDifferential.D R' D d) := hψ_D_eq₂ _
