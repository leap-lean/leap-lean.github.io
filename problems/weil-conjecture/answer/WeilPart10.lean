      CategoryTheory.Limits.pullback.lift (p_B_mor ≫ hV₀.fromSpec) p_K_mor hLiftComm
    have hι_fst : ι_KB ≫ CategoryTheory.Limits.pullback.fst g s_K = p_B_mor ≫ hV₀.fromSpec :=
