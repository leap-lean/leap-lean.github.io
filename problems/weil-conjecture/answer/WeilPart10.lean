    have hp_top : CategoryTheory.IsPullback p_B_mor ι_KB hV₀.fromSpec
        (CategoryTheory.Limits.pullback.fst g s_K) :=
      CategoryTheory.IsPullback.of_bot hp_outer hι_fst.symm
