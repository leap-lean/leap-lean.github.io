            TrivSqZeroExt.map ℓ (TrivSqZeroExt.inr w) =
          TrivSqZeroExt.map (0 : (Ω × Ω) →ₗ[Ω] Ω) (TrivSqZeroExt.inl (Δ Polynomial.X).fst) +
            TrivSqZeroExt.map (0 : (Ω × Ω) →ₗ[Ω] Ω) (TrivSqZeroExt.inr w)
        rw [TrivSqZeroExt.map_inl, TrivSqZeroExt.map_inl,
          TrivSqZeroExt.map_inr, TrivSqZeroExt.map_inr, hℓ_w, LinearMap.zero_apply]
    have hEq_θ : q_ℓ.comp θ_a = q_0.comp θ_a := by
      apply RingHom.ext
      intro z
      obtain ⟨p, rfl⟩ := hΦ_surj z
      exact RingHom.congr_fun hEq_Δ p
    have hEq_Θ_hom : CommRingCat.ofHom (q_ℓ.comp Θ) = CommRingCat.ofHom (q_0.comp Θ) := by
      apply AlgebraicGeometry.Spec.map_injective
      have hSpec_θ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_ℓ) ≫ f_a =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_0) ≫ f_a := by
        rw [← hθ_a_map, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hEq_θ]
      have hSpec_τ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_ℓ) ≫ τ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_0) ≫ τ := by
        rw [← hf_a, ← Category.assoc, hSpec_θ, Category.assoc]
      dsimp only [τ] at hSpec_τ
      have hCancel_iso :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_ℓ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ) ≫ j_D) =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_0) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ) ≫ j_D) := by
        have h1 := hSpec_τ =≫ e_inv
        simpa only [Category.assoc, he_hom_inv, Category.comp_id] using h1
      have hCancel_jD :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_ℓ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_0) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ) := by
        rw [← Category.assoc, ← Category.assoc] at hCancel_iso
        exact (cancel_mono j_D).mp hCancel_iso
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      exact hCancel_jD
    obtain ⟨d₀, hd₀⟩ := hΘ_surj (TrivSqZeroExt.inr u₀)
    have hEval : q_ℓ (Θ d₀) = q_0 (Θ d₀) :=
      congrArg (fun f : CommRingCat.of D ⟶ CommRingCat.of A₁ => f.hom d₀) hEq_Θ_hom
    rw [hd₀] at hEval
    change TrivSqZeroExt.map ℓ (TrivSqZeroExt.inr u₀) =
      TrivSqZeroExt.map (0 : (Ω × Ω) →ₗ[Ω] Ω) (TrivSqZeroExt.inr u₀) at hEval
    rw [TrivSqZeroExt.map_inr, TrivSqZeroExt.map_inr, LinearMap.zero_apply] at hEval
    have hZero : ℓ u₀ = 0 := congrArg TrivSqZeroExt.snd hEval
    exact hu₀ hZero

theorem weil_domain_spreadOut_sqZero_rank_three_jet (B₀ : Type u) [CommRing B₀] [IsDomain B₀]
    (K_bar : Type u) [Field K_bar]
    (ι₀ : B₀ →+* K_bar) (_hInj₀ : Function.Injective ι₀)
    (E₀ : AlgebraicGeometry.Scheme.{u})
    (p₀ : E₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀)) :
    AlgebraicGeometry.LocallyOfFinitePresentation p₀ →
    (let E_gen := CategoryTheory.Limits.pullback p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))
     let p_gen := CategoryTheory.Limits.pullback.snd p₀ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))
     ∃ (V : E_gen.Opens)
       (ev : ↑(E_gen.presheaf.obj (Opposite.op V)) →+* K_bar)
       (α_V : K_bar →+* ↑(E_gen.presheaf.obj (Opposite.op V))),
       AlgebraicGeometry.IsAffineOpen V ∧
       V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) = V.ι ≫ p_gen ∧
       ev.comp α_V = RingHom.id K_bar ∧
       (letI : Algebra K_bar ↑(E_gen.presheaf.obj (Opposite.op V)) := α_V.toAlgebra
        Module.finrank K_bar (↑(E_gen.presheaf.obj (Opposite.op V)) ⧸ (RingHom.ker ev) ^ 2) = 3)) →
    ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
      (ψ : B₀ →+* B) (ι_B : B →+* K_bar),
      RingHom.FiniteType ψ ∧
      ι_B.comp ψ = ι₀ ∧
      Function.Injective ι_B ∧
      ∀ (Ω : Type u) [Field Ω] (φ : B →+* Ω),
        let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp ψ))
        let E_Ω := CategoryTheory.Limits.pullback p₀ s₀
        let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s₀
        ∃ (D_Ω : Type u) (_ : CommRing D_Ω)
          (α_D : Ω →+* D_Ω)
          (j_D : AlgebraicGeometry.Spec (CommRingCat.of D_Ω) ⟶ E_Ω)
          (Θ_Ω : D_Ω →+* TrivSqZeroExt Ω (Ω × Ω)),
          AlgebraicGeometry.IsOpenImmersion j_D ∧
          j_D ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_D) ∧
          Θ_Ω.comp α_D = TrivSqZeroExt.inlHom Ω (Ω × Ω) ∧
          Function.Surjective Θ_Ω :=
by
  
  
  
  have hStage1 : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R]
      (ev : R →+* K) (α : K →+* R),
      ev.comp α = RingHom.id K →
      (letI : Algebra K R := α.toAlgebra
       Module.finrank K (R ⧸ (RingHom.ker ev) ^ 2) = 3) →
      ∃ (Ψ : R →+* TrivSqZeroExt K (K × K)),
        Ψ.comp α = TrivSqZeroExt.inlHom K (K × K) ∧
        Function.Surjective Ψ := by
    intro K _ R _ ev α hev_α hRank
    letI : Algebra K R := α.toAlgebra
    have hev_α_app : ∀ c : K, ev (α c) = c := fun c => RingHom.congr_fun hev_α c
    let I : Ideal R := RingHom.ker ev
    let Q := R ⧸ I ^ 2
    have hRankQ : Module.finrank K Q = 3 := hRank
    haveI : FiniteDimensional K Q := FiniteDimensional.of_finrank_pos (by omega)
    let ev_alg : R →ₐ[K] K :=
      { ev with commutes' := fun c => hev_α_app c }
    have hI2_ker : ∀ z ∈ I ^ 2, ev_alg z = 0 := by
      intro z hz
      exact Ideal.pow_le_self (by decide : 2 ≠ 0) hz
    let ev_bar : Q →ₐ[K] K := Ideal.Quotient.liftₐ (I ^ 2) ev_alg hI2_ker
    let L_ev : Q →ₗ[K] K := ev_bar.toLinearMap
    let π : R →+* Q := Ideal.Quotient.mk (I ^ 2)
    have hL_mk : ∀ r : R, L_ev (π r) = ev r := fun _ => rfl
    have hRange_top : LinearMap.range L_ev = ⊤ := by
      ext c
      simp only [Submodule.mem_top, iff_true, LinearMap.mem_range]
      exact ⟨π (α c), hev_α_app c⟩
    have hRankRange : Module.finrank K (LinearMap.range L_ev) = 1 := by
      rw [hRange_top, finrank_top, Module.finrank_self]
    have hRankKer : Module.finrank K (LinearMap.ker L_ev) = 2 := by
      have hRN := LinearMap.finrank_range_add_finrank_ker L_ev
      omega
    have hRankProd : Module.finrank K (K × K) = 2 := by
      rw [Module.finrank_prod, Module.finrank_self]
    let e₂ : LinearMap.ker L_ev ≃ₗ[K] (K × K) :=
      LinearEquiv.ofFinrankEq (LinearMap.ker L_ev) (K × K) (hRankKer.trans hRankProd.symm)
    let m : R → LinearMap.ker L_ev := fun r =>
      ⟨π (r - α (ev r)), by
        rw [LinearMap.mem_ker, hL_mk, map_sub, hev_α_app, sub_self]⟩
    have hm_zero : m 0 = 0 := by
      apply Subtype.ext
      simp [m]
    have hm_one : m 1 = 0 := by
      apply Subtype.ext
      simp [m]
    have hm_α : ∀ c : K, m (α c) = 0 := by
      intro c
      apply Subtype.ext
      simp [m, hev_α_app]
    have hm_add : ∀ r₁ r₂ : R, m (r₁ + r₂) = m r₁ + m r₂ := by
      intro r₁ r₂
      apply Subtype.ext
      change π ((r₁ + r₂) - α (ev (r₁ + r₂))) = π (r₁ - α (ev r₁)) + π (r₂ - α (ev r₂))
      rw [map_add, map_add, ← map_add π]
      congr 1
      ring
    have hm_mul : ∀ r₁ r₂ : R, m (r₁ * r₂) = ev r₁ • m r₂ + ev r₂ • m r₁ := by
      intro r₁ r₂
      apply Subtype.ext
      change π (r₁ * r₂ - α (ev (r₁ * r₂))) =
        ev r₁ • π (r₂ - α (ev r₂)) + ev r₂ • π (r₁ - α (ev r₁))
      have hd₁ : r₁ - α (ev r₁) ∈ I := by
        rw [RingHom.mem_ker, map_sub, hev_α_app, sub_self]
      have hd₂ : r₂ - α (ev r₂) ∈ I := by
        rw [RingHom.mem_ker, map_sub, hev_α_app, sub_self]
      have hd₁₂ : (r₁ - α (ev r₁)) * (r₂ - α (ev r₂)) ∈ I ^ 2 := by
        rw [sq]
        exact Ideal.mul_mem_mul hd₁ hd₂
      have hπ_d₁₂ : π ((r₁ - α (ev r₁)) * (r₂ - α (ev r₂))) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hd₁₂
      have h_smul : ∀ (c : K) (x : R), c • π x = π (α c * x) := fun _ _ => rfl
      rw [h_smul, h_smul, map_mul ev, map_mul α]
      have h_id : r₁ * r₂ - α (ev r₁) * α (ev r₂) =
          (r₁ - α (ev r₁)) * (r₂ - α (ev r₂)) +
          α (ev r₁) * (r₂ - α (ev r₂)) +
          α (ev r₂) * (r₁ - α (ev r₁)) := by
        ring
      rw [h_id, map_add, map_add, hπ_d₁₂, zero_add]
    let Ψ : R →+* TrivSqZeroExt K (K × K) :=
      { toFun := fun r => TrivSqZeroExt.inl (ev r) + TrivSqZeroExt.inr (e₂ (m r))
        map_one' := by
          rw [map_one, hm_one, map_zero, TrivSqZeroExt.inr_zero, add_zero]
          rfl
        map_mul' := by
          intro r₁ r₂
          apply TrivSqZeroExt.ext
          · simp [TrivSqZeroExt.fst_mul]
          · simp [TrivSqZeroExt.snd_mul, IsCentralScalar.op_smul_eq_smul, hm_mul]
        map_zero' := by
          rw [map_zero, hm_zero, map_zero, TrivSqZeroExt.inr_zero, add_zero]
          rfl
        map_add' := by
          intro r₁ r₂
          apply TrivSqZeroExt.ext
          · simp
          · simp [hm_add] }
    refine ⟨Ψ, ?_, ?_⟩
    · apply RingHom.ext
      intro c
      apply TrivSqZeroExt.ext
      · simp [Ψ, hev_α_app]
      · simp [Ψ, hm_α]
    · intro z
      obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (e₂.symm z.snd).1
      have hev_x : ev x = 0 := by
        rw [← hL_mk]
        change L_ev (Ideal.Quotient.mk (I ^ 2) x) = 0
        rw [hx]
        exact LinearMap.mem_ker.mp (e₂.symm z.snd).2
      refine ⟨α z.fst + x, ?_⟩
      have hev_sum : ev (α z.fst + x) = z.fst := by
        rw [map_add, hev_α_app, hev_x, add_zero]
      have hm_sum : m (α z.fst + x) = e₂.symm z.snd := by
        apply Subtype.ext
        change Ideal.Quotient.mk (I ^ 2) ((α z.fst + x) - α (ev (α z.fst + x))) = (e₂.symm z.snd).1
        rw [hev_sum, add_sub_cancel_left]
        exact hx
      change TrivSqZeroExt.inl (ev (α z.fst + x)) + TrivSqZeroExt.inr (e₂ (m (α z.fst + x))) = z
      rw [hev_sum, hm_sum, e₂.apply_symm_apply, TrivSqZeroExt.inl_fst_add_inr_snd_eq]

  
  
  
  have hStage3 : ∀ (R₀ : Type u) [CommRing R₀] (α₀ : B₀ →+* R₀),
      RingHom.FiniteType α₀ →
      (letI : Algebra B₀ R₀ := α₀.toAlgebra
       letI : Algebra B₀ K_bar := ι₀.toAlgebra
       ∃ (Θ_bar : TensorProduct B₀ R₀ K_bar →+* TrivSqZeroExt K_bar (K_bar × K_bar)),
         Θ_bar.comp Algebra.TensorProduct.includeRight.toRingHom =
           TrivSqZeroExt.inlHom K_bar (K_bar × K_bar) ∧
         Function.Surjective Θ_bar) →
      ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
        (ψ : B₀ →+* B) (ι_B : B →+* K_bar),
        RingHom.FiniteType ψ ∧
        ι_B.comp ψ = ι₀ ∧
        Function.Injective ι_B ∧
        ∀ (Ω : Type u) [CommRing Ω] (φ : B →+* Ω),
          letI : Algebra B₀ R₀ := α₀.toAlgebra
          letI : Algebra B₀ Ω := (φ.comp ψ).toAlgebra
          ∃ (Θ_Ω : TensorProduct B₀ R₀ Ω →+* TrivSqZeroExt Ω (Ω × Ω)),
            Θ_Ω.comp Algebra.TensorProduct.includeRight.toRingHom =
              TrivSqZeroExt.inlHom Ω (Ω × Ω) ∧
            Function.Surjective Θ_Ω := by
    intro R₀ _ α₀ hFT₀ hΘ_ex
    letI : Algebra B₀ R₀ := α₀.toAlgebra
    letI : Algebra B₀ K_bar := ι₀.toAlgebra
    obtain ⟨Θ_bar, hΘ_right, hΘ_surj⟩ := hΘ_ex

    let mapSqZero₂ : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂],
        (R₁ →+* R₂) → (TrivSqZeroExt R₁ (R₁ × R₁) →+* TrivSqZeroExt R₂ (R₂ × R₂)) :=
      fun {R₁ R₂} _ _ f =>
        { toFun := fun z => TrivSqZeroExt.inl (f z.fst) + TrivSqZeroExt.inr (f z.snd.1, f z.snd.2)
          map_one' := by
            apply TrivSqZeroExt.ext
            · simp
            · apply Prod.ext <;> simp
          map_mul' := by
            intro x y
            apply TrivSqZeroExt.ext
            · simp [TrivSqZeroExt.fst_mul]
            · apply Prod.ext
              · simp [TrivSqZeroExt.snd_mul]; ring
              · simp [TrivSqZeroExt.snd_mul]; ring
          map_zero' := by
            apply TrivSqZeroExt.ext
            · simp
            · apply Prod.ext <;> simp
          map_add' := by
            intro x y
            apply TrivSqZeroExt.ext
            · simp
            · apply Prod.ext <;> simp }

    have hMapSqZero₂_inj : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
        {f : R₁ →+* R₂}, Function.Injective f → Function.Injective (mapSqZero₂ f) := by
      intro R₁ R₂ _ _ f hf x y hxy
      apply TrivSqZeroExt.ext
      · apply hf
        have h1 := congrArg TrivSqZeroExt.fst hxy
        simpa [mapSqZero₂] using h1
      · apply Prod.ext
        · apply hf
          have h2 := congrArg (fun z => z.snd.1) hxy
          simpa [mapSqZero₂] using h2
        · apply hf
          have h3 := congrArg (fun z => z.snd.2) hxy
          simpa [mapSqZero₂] using h3

    have hSpecialize : ∀ (B : Type u) [CommRing B] (ψ : B₀ →+* B)
        (θ_B : R₀ →+* TrivSqZeroExt B (B × B))
        (_ : ∀ b : B₀, θ_B (α₀ b) = TrivSqZeroExt.inl (ψ b))
        (N₁ N₂ : ℕ) (r₁ : Fin N₁ → R₀) (lam₁_B : Fin N₁ → B)
        (r₂ : Fin N₂ → R₀) (lam₂_B : Fin N₂ → B),
        (∑ k : Fin N₁, θ_B (r₁ k) * TrivSqZeroExt.inl (lam₁_B k) = TrivSqZeroExt.inr (1, 0)) →
        (∑ k : Fin N₂, θ_B (r₂ k) * TrivSqZeroExt.inl (lam₂_B k) = TrivSqZeroExt.inr (0, 1)) →
        ∀ (Ω : Type u) [CommRing Ω] (φ : B →+* Ω),
          letI : Algebra B₀ Ω := (φ.comp ψ).toAlgebra
          ∃ (Θ_Ω : TensorProduct B₀ R₀ Ω →+* TrivSqZeroExt Ω (Ω × Ω)),
            Θ_Ω.comp Algebra.TensorProduct.includeRight.toRingHom =
              TrivSqZeroExt.inlHom Ω (Ω × Ω) ∧
            Function.Surjective Θ_Ω := by
      intro B _ ψ θ_B hθ_B_α₀ N₁ N₂ r₁ lam₁_B r₂ lam₂_B hSum₁_B hSum₂_B Ω _ φ
      let φ₀ : B₀ →+* Ω := φ.comp ψ
      letI : Algebra B₀ Ω := φ₀.toAlgebra
      let α_D : Ω →+* TensorProduct B₀ R₀ Ω := Algebra.TensorProduct.includeRight.toRingHom
      let f_R : Ω →ₐ[B₀] TrivSqZeroExt Ω (Ω × Ω) :=
        TrivSqZeroExt.inlAlgHom B₀ Ω (Ω × Ω)
      let f_L : R₀ →ₐ[B₀] TrivSqZeroExt Ω (Ω × Ω) :=
        { ((mapSqZero₂ φ).comp θ_B) with
          commutes' := fun b => by
            rw [← f_R.commutes b]
            change mapSqZero₂ φ (θ_B (α₀ b)) = TrivSqZeroExt.inl (φ (ψ b))
            rw [hθ_B_α₀ b]
            apply TrivSqZeroExt.ext
            · simp [mapSqZero₂]
            · apply Prod.ext <;> simp [mapSqZero₂] }
      let Θ_Ω : TensorProduct B₀ R₀ Ω →+* TrivSqZeroExt Ω (Ω × Ω) :=
        (Algebra.TensorProduct.lift f_L f_R (fun _ _ => Commute.all _ _)).toRingHom
      have hΘ_Ω_tmul : ∀ (r : R₀) (ω : Ω),
          Θ_Ω (r ⊗ₜ[B₀] ω) = mapSqZero₂ φ (θ_B r) * TrivSqZeroExt.inl ω := by
        intro r ω
        exact Algebra.TensorProduct.lift_tmul f_L f_R (fun _ _ => Commute.all _ _) r ω
      have hΘ_Ω_α : Θ_Ω.comp α_D = TrivSqZeroExt.inlHom Ω (Ω × Ω) := by
        apply RingHom.ext
        intro ω
        change Θ_Ω ((1 : R₀) ⊗ₜ[B₀] ω) = TrivSqZeroExt.inl ω
        rw [hΘ_Ω_tmul, map_one, map_one, one_mul]
      refine ⟨Θ_Ω, hΘ_Ω_α, ?_⟩
      let e₁_Ω : TensorProduct B₀ R₀ Ω := ∑ k : Fin N₁, r₁ k ⊗ₜ[B₀] φ (lam₁_B k)
      let e₂_Ω : TensorProduct B₀ R₀ Ω := ∑ k : Fin N₂, r₂ k ⊗ₜ[B₀] φ (lam₂_B k)
      have hΘ_e₁ : Θ_Ω e₁_Ω = TrivSqZeroExt.inr (1, 0) := by
        change Θ_Ω (∑ k : Fin N₁, r₁ k ⊗ₜ[B₀] φ (lam₁_B k)) = TrivSqZeroExt.inr (1, 0)
        rw [map_sum Θ_Ω]
        have h_eq : (∑ k : Fin N₁, Θ_Ω (r₁ k ⊗ₜ[B₀] φ (lam₁_B k))) =
            mapSqZero₂ φ (∑ k : Fin N₁, θ_B (r₁ k) * TrivSqZeroExt.inl (lam₁_B k)) := by
          rw [map_sum (mapSqZero₂ φ)]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [hΘ_Ω_tmul, map_mul]
          congr 1
          apply TrivSqZeroExt.ext
          · simp [mapSqZero₂]
          · apply Prod.ext <;> simp [mapSqZero₂]
        rw [h_eq, hSum₁_B]
        apply TrivSqZeroExt.ext
        · simp [mapSqZero₂]
        · apply Prod.ext <;> simp [mapSqZero₂]
      have hΘ_e₂ : Θ_Ω e₂_Ω = TrivSqZeroExt.inr (0, 1) := by
        change Θ_Ω (∑ k : Fin N₂, r₂ k ⊗ₜ[B₀] φ (lam₂_B k)) = TrivSqZeroExt.inr (0, 1)
        rw [map_sum Θ_Ω]
        have h_eq : (∑ k : Fin N₂, Θ_Ω (r₂ k ⊗ₜ[B₀] φ (lam₂_B k))) =
            mapSqZero₂ φ (∑ k : Fin N₂, θ_B (r₂ k) * TrivSqZeroExt.inl (lam₂_B k)) := by
          rw [map_sum (mapSqZero₂ φ)]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [hΘ_Ω_tmul, map_mul]
          congr 1
          apply TrivSqZeroExt.ext
          · simp [mapSqZero₂]
          · apply Prod.ext <;> simp [mapSqZero₂]
        rw [h_eq, hSum₂_B]
        apply TrivSqZeroExt.ext
        · simp [mapSqZero₂]
        · apply Prod.ext <;> simp [mapSqZero₂]
      intro z
      have hΘ_α_app : ∀ ω : Ω, Θ_Ω (α_D ω) = TrivSqZeroExt.inl ω :=
        fun ω => RingHom.congr_fun hΘ_Ω_α ω
      refine ⟨α_D z.fst + α_D z.snd.1 * e₁_Ω + α_D z.snd.2 * e₂_Ω, ?_⟩
      rw [map_add, map_add, map_mul, map_mul, hΘ_α_app, hΘ_α_app, hΘ_α_app,
        hΘ_e₁, hΘ_e₂, TrivSqZeroExt.inl_mul_inr, TrivSqZeroExt.inl_mul_inr]
      apply TrivSqZeroExt.ext
      · simp
      · apply Prod.ext <;> simp

    let θ₀ : R₀ →+* TrivSqZeroExt K_bar (K_bar × K_bar) :=
      Θ_bar.comp Algebra.TensorProduct.includeLeftRingHom
    have hΘ_tmul : ∀ (r : R₀) (c : K_bar),
        Θ_bar (r ⊗ₜ[B₀] c) = θ₀ r * TrivSqZeroExt.inl c := by
      intro r c
      have h_eq : (r ⊗ₜ[B₀] c : TensorProduct B₀ R₀ K_bar) =
          Algebra.TensorProduct.includeLeftRingHom r *
            Algebra.TensorProduct.includeRight.toRingHom c := by
        change r ⊗ₜ[B₀] c = (r ⊗ₜ[B₀] 1) * (1 ⊗ₜ[B₀] c)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [h_eq, map_mul]
      congr 1
      exact RingHom.congr_fun hΘ_right c

    have hθ₀_α₀ : ∀ b : B₀, θ₀ (α₀ b) = TrivSqZeroExt.inl (ι₀ b) := by
      intro b
      change Θ_bar ((α₀ b) ⊗ₜ[B₀] (1 : K_bar)) = TrivSqZeroExt.inl (ι₀ b)
      have hsmul : ((α₀ b) ⊗ₜ[B₀] (1 : K_bar) : TensorProduct B₀ R₀ K_bar) =
          (1 : R₀) ⊗ₜ[B₀] (ι₀ b) := by
        have hL : α₀ b = b • (1 : R₀) := by
          change α₀ b = algebraMap B₀ R₀ b * 1
          exact (mul_one (α₀ b)).symm
        have hR : ι₀ b = b • (1 : K_bar) := by
          change ι₀ b = algebraMap B₀ K_bar b * 1
          exact (mul_one (ι₀ b)).symm
        rw [hL, hR, TensorProduct.smul_tmul]
      rw [hsmul]
      exact RingHom.congr_fun hΘ_right (ι₀ b)

    have hPureDecomp : ∀ t : TensorProduct B₀ R₀ K_bar,
        ∃ (N : ℕ) (r : Fin N → R₀) (lam : Fin N → K_bar),
          t = ∑ k : Fin N, r k ⊗ₜ[B₀] lam k := by
      intro t
      refine TensorProduct.induction_on
        (motive := fun t => ∃ (N : ℕ) (r : Fin N → R₀) (lam : Fin N → K_bar),
          t = ∑ k : Fin N, r k ⊗ₜ[B₀] lam k)
        t ?_ ?_ ?_
      · exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
      · intro x y
        exact ⟨1, fun _ => x, fun _ => y, by simp⟩
      · rintro x y ⟨N₁, r₁, l₁, rfl⟩ ⟨N₂, r₂, l₂, rfl⟩
        refine ⟨N₁ + N₂, Fin.addCases r₁ r₂, Fin.addCases l₁ l₂, ?_⟩
        rw [Fin.sum_univ_add]
        simp [Fin.addCases_left, Fin.addCases_right]

    obtain ⟨t₁, ht₁⟩ := hΘ_surj (TrivSqZeroExt.inr (1, 0))
    obtain ⟨t₂, ht₂⟩ := hΘ_surj (TrivSqZeroExt.inr (0, 1))
    obtain ⟨N₁, r₁, lam₁, rfl⟩ := hPureDecomp t₁
    obtain ⟨N₂, r₂, lam₂, rfl⟩ := hPureDecomp t₂
    have hSum₁_K : ∑ k : Fin N₁, θ₀ (r₁ k) * TrivSqZeroExt.inl (lam₁ k) =
        TrivSqZeroExt.inr (1, 0) := by
      rw [← ht₁, map_sum]
      exact Finset.sum_congr rfl (fun k _ => (hΘ_tmul (r₁ k) (lam₁ k)).symm)
    have hSum₂_K : ∑ k : Fin N₂, θ₀ (r₂ k) * TrivSqZeroExt.inl (lam₂ k) =
        TrivSqZeroExt.inr (0, 1) := by
      rw [← ht₂, map_sum]
      exact Finset.sum_congr rfl (fun k _ => (hΘ_tmul (r₂ k) (lam₂ k)).symm)

    have hFT_alg : Algebra.FiniteType B₀ R₀ := hFT₀
    obtain ⟨G_R, hG_R⟩ := hFT_alg.out
    let S_set : Set K_bar :=
      ((fun g : R₀ => (θ₀ g).fst) '' (↑G_R : Set R₀)) ∪
      ((fun g : R₀ => (θ₀ g).snd.1) '' (↑G_R : Set R₀)) ∪
      ((fun g : R₀ => (θ₀ g).snd.2) '' (↑G_R : Set R₀)) ∪
      Set.range lam₁ ∪ Set.range lam₂
    have hS_fin : S_set.Finite :=
      ((((G_R.finite_toSet.image _).union (G_R.finite_toSet.image _)).union
        (G_R.finite_toSet.image _)).union (Set.finite_range lam₁)).union (Set.finite_range lam₂)

    let A_B : Subalgebra B₀ K_bar := Algebra.adjoin B₀ S_set
    let ψ : B₀ →+* ↥A_B := algebraMap B₀ ↥A_B
    let ι_B : ↥A_B →+* K_bar := A_B.val.toRingHom
    have hFT_B : Algebra.FiniteType B₀ ↥A_B := Algebra.FiniteType.adjoin_of_finite hS_fin
    have hFT_ψ : RingHom.FiniteType ψ := RingHom.finiteType_algebraMap.mpr hFT_B
    have hComp_ψ : ι_B.comp ψ = ι₀ := by
      apply RingHom.ext
      intro b
      rfl
    have hInj_B : Function.Injective ι_B := Subtype.val_injective

    have hCoord_mem : ∀ r : R₀,
        (θ₀ r).fst ∈ A_B ∧ (θ₀ r).snd.1 ∈ A_B ∧ (θ₀ r).snd.2 ∈ A_B := by
      intro r
      have hr_mem : r ∈ Algebra.adjoin B₀ (↑G_R : Set R₀) := by
        rw [hG_R]
        trivial
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hr_mem
      · intro g hg
        refine ⟨Algebra.subset_adjoin ?_, Algebra.subset_adjoin ?_, Algebra.subset_adjoin ?_⟩
        · exact Or.inl (Or.inl (Or.inl (Or.inl ⟨g, hg, rfl⟩)))
        · exact Or.inl (Or.inl (Or.inl (Or.inr ⟨g, hg, rfl⟩)))
        · exact Or.inl (Or.inl (Or.inr ⟨g, hg, rfl⟩))
      · intro b
        change (θ₀ (α₀ b)).fst ∈ A_B ∧ (θ₀ (α₀ b)).snd.1 ∈ A_B ∧ (θ₀ (α₀ b)).snd.2 ∈ A_B
        rw [hθ₀_α₀ b]
        exact ⟨A_B.algebraMap_mem b, A_B.zero_mem, A_B.zero_mem⟩
      · rintro x y _ _ ⟨hxf, hx1, hx2⟩ ⟨hyf, hy1, hy2⟩
        rw [map_add]
        exact ⟨A_B.add_mem hxf hyf, A_B.add_mem hx1 hy1, A_B.add_mem hx2 hy2⟩
      · rintro x y _ _ ⟨hxf, hx1, hx2⟩ ⟨hyf, hy1, hy2⟩
        rw [map_mul]
        refine ⟨A_B.mul_mem hxf hyf, ?_, ?_⟩
        · have hmul1 : ((θ₀ x * θ₀ y).snd).1 =
              (θ₀ x).fst * (θ₀ y).snd.1 + (θ₀ y).fst * (θ₀ x).snd.1 := by
            simp [TrivSqZeroExt.snd_mul]
          rw [hmul1]
          exact A_B.add_mem (A_B.mul_mem hxf hy1) (A_B.mul_mem hyf hx1)
        · have hmul2 : ((θ₀ x * θ₀ y).snd).2 =
              (θ₀ x).fst * (θ₀ y).snd.2 + (θ₀ y).fst * (θ₀ x).snd.2 := by
            simp [TrivSqZeroExt.snd_mul]
          rw [hmul2]
          exact A_B.add_mem (A_B.mul_mem hxf hy2) (A_B.mul_mem hyf hx2)

    let θ_B_fun : R₀ → TrivSqZeroExt ↥A_B (↥A_B × ↥A_B) := fun r =>
      TrivSqZeroExt.inl ⟨(θ₀ r).fst, (hCoord_mem r).1⟩ +
        TrivSqZeroExt.inr (⟨(θ₀ r).snd.1, (hCoord_mem r).2.1⟩, ⟨(θ₀ r).snd.2, (hCoord_mem r).2.2⟩)
    have hθ_B_val : ∀ r : R₀, mapSqZero₂ ι_B (θ_B_fun r) = θ₀ r := by
      intro r
      apply TrivSqZeroExt.ext
      · simp [mapSqZero₂, θ_B_fun, ι_B]
      · apply Prod.ext
        · simp [mapSqZero₂, θ_B_fun, ι_B]
        · simp [mapSqZero₂, θ_B_fun, ι_B]
    have hInj_mapB := hMapSqZero₂_inj hInj_B
    let θ_B : R₀ →+* TrivSqZeroExt ↥A_B (↥A_B × ↥A_B) :=
      { toFun := θ_B_fun
        map_one' := hInj_mapB (by rw [hθ_B_val, map_one, map_one])
        map_mul' := fun x y => hInj_mapB (by rw [hθ_B_val, map_mul, map_mul, hθ_B_val, hθ_B_val])
        map_zero' := hInj_mapB (by rw [hθ_B_val, map_zero, map_zero])
        map_add' := fun x y => hInj_mapB (by rw [hθ_B_val, map_add, map_add, hθ_B_val, hθ_B_val]) }
    have hθ_B_app : ∀ r : R₀, mapSqZero₂ ι_B (θ_B r) = θ₀ r := hθ_B_val

    have hθ_B_α₀ : ∀ b : B₀, θ_B (α₀ b) = TrivSqZeroExt.inl (ψ b) := by
      intro b
      apply hInj_mapB
      rw [hθ_B_app, hθ₀_α₀]
      apply TrivSqZeroExt.ext
      · simp [mapSqZero₂]; rfl
      · apply Prod.ext <;> simp [mapSqZero₂]

    let lam₁_B : Fin N₁ → ↥A_B := fun k =>
      ⟨lam₁ k, Algebra.subset_adjoin (Or.inl (Or.inr ⟨k, rfl⟩))⟩
    let lam₂_B : Fin N₂ → ↥A_B := fun k =>
      ⟨lam₂ k, Algebra.subset_adjoin (Or.inr ⟨k, rfl⟩)⟩

    have hSum₁_B : ∑ k : Fin N₁, θ_B (r₁ k) * TrivSqZeroExt.inl (lam₁_B k) =
        TrivSqZeroExt.inr (1, 0) := by
      apply hInj_mapB
      rw [map_sum (mapSqZero₂ ι_B)]
      have h_lhs : (∑ k : Fin N₁, mapSqZero₂ ι_B (θ_B (r₁ k) * TrivSqZeroExt.inl (lam₁_B k))) =
          ∑ k : Fin N₁, θ₀ (r₁ k) * TrivSqZeroExt.inl (lam₁ k) := by
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_mul, hθ_B_app]
        congr 1
        apply TrivSqZeroExt.ext
        · simp [mapSqZero₂, lam₁_B, ι_B]
        · apply Prod.ext <;> simp [mapSqZero₂]
      have h_rhs : mapSqZero₂ ι_B (TrivSqZeroExt.inr (1, 0)) = TrivSqZeroExt.inr (1, 0) := by
        apply TrivSqZeroExt.ext
        · simp [mapSqZero₂]
        · apply Prod.ext <;> simp [mapSqZero₂]
      rw [h_lhs, h_rhs, hSum₁_K]

    have hSum₂_B : ∑ k : Fin N₂, θ_B (r₂ k) * TrivSqZeroExt.inl (lam₂_B k) =
        TrivSqZeroExt.inr (0, 1) := by
      apply hInj_mapB
      rw [map_sum (mapSqZero₂ ι_B)]
      have h_lhs : (∑ k : Fin N₂, mapSqZero₂ ι_B (θ_B (r₂ k) * TrivSqZeroExt.inl (lam₂_B k))) =
          ∑ k : Fin N₂, θ₀ (r₂ k) * TrivSqZeroExt.inl (lam₂ k) := by
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_mul, hθ_B_app]
        congr 1
        apply TrivSqZeroExt.ext
        · simp [mapSqZero₂, lam₂_B, ι_B]
        · apply Prod.ext <;> simp [mapSqZero₂]
      have h_rhs : mapSqZero₂ ι_B (TrivSqZeroExt.inr (0, 1)) = TrivSqZeroExt.inr (0, 1) := by
        apply TrivSqZeroExt.ext
        · simp [mapSqZero₂]
        · apply Prod.ext <;> simp [mapSqZero₂]
      rw [h_lhs, h_rhs, hSum₂_K]

    exact ⟨↥A_B, inferInstance, inferInstance, ψ, ι_B, hFT_ψ, hComp_ψ, hInj_B,
      hSpecialize ↥A_B ψ θ_B hθ_B_α₀ N₁ N₂ r₁ lam₁_B r₂ lam₂_B hSum₁_B hSum₂_B⟩

  
  
  
  intro hLFP hGen
  dsimp only at hGen
  obtain ⟨V, ev, α_V, hAff_V, hV_comm, hev_α, hRank⟩ := hGen

  let s_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)
  let E_gen := CategoryTheory.Limits.pullback p₀ s_gen
  let p_gen := CategoryTheory.Limits.pullback.snd p₀ s_gen
  let fst_gen := CategoryTheory.Limits.pullback.fst p₀ s_gen

  obtain ⟨Ψ, hΨ_α, hΨ_surj⟩ :=
    hStage1 K_bar (↑(E_gen.presheaf.obj (Opposite.op V))) ev α_V hev_α hRank

  let fst_ring : TrivSqZeroExt K_bar (K_bar × K_bar) →+* K_bar :=
    { toFun := TrivSqZeroExt.fst
      map_one' := TrivSqZeroExt.fst_one
      map_mul' := TrivSqZeroExt.fst_mul
      map_zero' := TrivSqZeroExt.fst_zero
      map_add' := TrivSqZeroExt.fst_add }
  let p_sq : PrimeSpectrum (TrivSqZeroExt K_bar (K_bar × K_bar)) :=
    ⟨RingHom.ker fst_ring, RingHom.ker_isPrime fst_ring⟩

  have hp_sq_uniq : ∀ p : PrimeSpectrum (TrivSqZeroExt K_bar (K_bar × K_bar)), p = p_sq := by
    intro p
    ext z
    change z ∈ p.asIdeal ↔ fst_ring z = 0
    have hinr_mem : (TrivSqZeroExt.inr z.snd : TrivSqZeroExt K_bar (K_bar × K_bar)) ∈ p.asIdeal := by
      have hsq : (TrivSqZeroExt.inr z.snd : TrivSqZeroExt K_bar (K_bar × K_bar)) ^ 2 ∈ p.asIdeal := by
        rw [sq, TrivSqZeroExt.inr_mul_inr]
        exact p.asIdeal.zero_mem
      exact p.isPrime.mem_of_pow_mem 2 hsq
    constructor
    · intro hz
      have hinl_mem : (TrivSqZeroExt.inl z.fst : TrivSqZeroExt K_bar (K_bar × K_bar)) ∈ p.asIdeal := by
        have hsub : z - TrivSqZeroExt.inr z.snd ∈ p.asIdeal := p.asIdeal.sub_mem hz hinr_mem
        have heq : z - TrivSqZeroExt.inr z.snd = TrivSqZeroExt.inl z.fst := by
          apply TrivSqZeroExt.ext <;> simp
        rwa [heq] at hsub
      change z.fst = 0
      by_contra hne
      have h1 : (TrivSqZeroExt.inl z.fst : TrivSqZeroExt K_bar (K_bar × K_bar)) *
          TrivSqZeroExt.inl z.fst⁻¹ = 1 := by
        rw [← TrivSqZeroExt.inl_mul, mul_inv_cancel₀ hne]
        rfl
      have h1_mem : (1 : TrivSqZeroExt K_bar (K_bar × K_bar)) ∈ p.asIdeal := by
        rw [← h1]
        exact p.asIdeal.mul_mem_right _ hinl_mem
      exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1_mem)
    · intro h0
      change z.fst = 0 at h0
      rw [← TrivSqZeroExt.inl_fst_add_inr_snd_eq z, h0, TrivSqZeroExt.inl_zero, zero_add]
      exact hinr_mem

  have hfromSpec_p : hAff_V.fromSpec ≫ p_gen = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) := by
    have h1 := congrArg (fun g => hAff_V.isoSpec.inv ≫ g) hV_comm
    rw [← CategoryTheory.Category.assoc, hAff_V.isoSpec_inv_toSpecΓ,
      CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
      hAff_V.isoSpec_inv_ι] at h1
    exact h1.symm

  let τ_V : AlgebraicGeometry.Spec (CommRingCat.of (TrivSqZeroExt K_bar (K_bar × K_bar))) ⟶ E_gen :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) ≫ hAff_V.fromSpec
  let y_node : ↥E_gen := τ_V.base p_sq
  let x₀ : ↥E₀ := fst_gen.base y_node

  obtain ⟨R_cat, f₀, hf₀_open, hx₀_mem, _⟩ :=
    AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
      (U := (⟨⊤, isOpen_univ⟩ : E₀.Opens)) (x := x₀) trivial
  let _ : AlgebraicGeometry.IsOpenImmersion f₀ := hf₀_open
  let R₀ : Type u := ↑R_cat
  let α₀ : B₀ →+* R₀ := (AlgebraicGeometry.Spec.preimage (f₀ ≫ p₀)).hom
  have hf₀_p₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) = f₀ ≫ p₀ :=
    AlgebraicGeometry.Spec.map_preimage (f₀ ≫ p₀)
  have hFT₀ : RingHom.FiniteType α₀ := by
    have hLFP_comp : AlgebraicGeometry.LocallyOfFinitePresentation (f₀ ≫ p₀) := inferInstance
    have hLFT_comp : AlgebraicGeometry.LocallyOfFiniteType (f₀ ≫ p₀) := inferInstance
    rw [← hf₀_p₀] at hLFT_comp
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_comp

  have hj_pkg : ∀ (Ω : Type u) [CommRing Ω] (φ₀ : B₀ →+* Ω),
      letI : Algebra B₀ R₀ := α₀.toAlgebra
      letI : Algebra B₀ Ω := φ₀.toAlgebra
      let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)
      let E_Ω := CategoryTheory.Limits.pullback p₀ s₀
      let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s₀
      let fst_Ω := CategoryTheory.Limits.pullback.fst p₀ s₀
      ∃ (j_Ω : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ R₀ Ω)) ⟶ E_Ω),
        AlgebraicGeometry.IsOpenImmersion j_Ω ∧
        j_Ω ≫ p_Ω = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ∧
        (∀ y : ↥E_Ω, fst_Ω.base y ∈ Set.range f₀.base → y ∈ Set.range j_Ω.base) := by
    intro Ω _ φ₀
    letI : Algebra B₀ R₀ := α₀.toAlgebra
    letI : Algebra B₀ Ω := φ₀.toAlgebra
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)
    let E_Ω := CategoryTheory.Limits.pullback p₀ s₀
    let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s₀
    let fst_Ω := CategoryTheory.Limits.pullback.fst p₀ s₀
    have hTop : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f₀ fst_Ω)
        (CategoryTheory.Limits.pullback.snd f₀ fst_Ω)
        f₀ fst_Ω :=
      CategoryTheory.IsPullback.of_hasPullback f₀ fst_Ω
    have hBot : CategoryTheory.IsPullback fst_Ω p_Ω p₀ s₀ :=
      CategoryTheory.IsPullback.of_hasPullback p₀ s₀
    have hRect : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f₀ fst_Ω)
        (CategoryTheory.Limits.pullback.snd f₀ fst_Ω ≫ p_Ω)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R₀)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ Ω))) := by
      have hp := hTop.paste_vert hBot
      have halgR : algebraMap B₀ R₀ = α₀ := rfl
      have halgΩ : algebraMap B₀ Ω = φ₀ := rfl
      rw [halgR, halgΩ, hf₀_p₀]
      exact hp
    let iso_tot := hRect.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso B₀ R₀ Ω
    let j_Ω : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ R₀ Ω)) ⟶ E_Ω :=
      iso_tot.inv ≫ CategoryTheory.Limits.pullback.snd f₀ fst_Ω
    refine ⟨j_Ω, inferInstance, ?_, ?_⟩
    · change ((AlgebraicGeometry.pullbackSpecIso B₀ R₀ Ω).inv ≫ hRect.isoPullback.inv ≫
          CategoryTheory.Limits.pullback.snd f₀ fst_Ω) ≫ p_Ω = _
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hRect.isoPullback_inv_snd, AlgebraicGeometry.pullbackSpecIso_inv_snd]
      apply congrArg AlgebraicGeometry.Spec.map
      apply congrArg CommRingCat.ofHom
      apply RingHom.ext
      intro _
      rfl
    · intro y ⟨z₀, hz₀⟩
      obtain ⟨w, _, hw_snd⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hTop z₀ y hz₀
      refine ⟨iso_tot.hom.base w, ?_⟩
      have h_inv_hom : iso_tot.inv.base (iso_tot.hom.base w) = w := by
        change (iso_tot.hom ≫ iso_tot.inv).base w = w
        rw [iso_tot.hom_inv_id]
        rfl
      change (CategoryTheory.Limits.pullback.snd f₀ fst_Ω).base
        (iso_tot.inv.base (iso_tot.hom.base w)) = y
      rw [h_inv_hom, hw_snd]

  have hΘ_bar_ex :
      (letI : Algebra B₀ R₀ := α₀.toAlgebra
       letI : Algebra B₀ K_bar := ι₀.toAlgebra
       ∃ (Θ_bar : TensorProduct B₀ R₀ K_bar →+* TrivSqZeroExt K_bar (K_bar × K_bar)),
         Θ_bar.comp Algebra.TensorProduct.includeRight.toRingHom =
           TrivSqZeroExt.inlHom K_bar (K_bar × K_bar) ∧
         Function.Surjective Θ_bar) := by
    letI : Algebra B₀ R₀ := α₀.toAlgebra
    letI : Algebra B₀ K_bar := ι₀.toAlgebra
    obtain ⟨j_gen, hj_gen_open, hj_gen_p, hj_gen_range⟩ := hj_pkg K_bar ι₀
    let _ : AlgebraicGeometry.IsOpenImmersion j_gen := hj_gen_open
    have hRange_τ : Set.range τ_V.base ⊆ Set.range j_gen.base := by
      rintro _ ⟨p, rfl⟩
      rw [hp_sq_uniq p]
      exact hj_gen_range y_node hx₀_mem
    let f_sq := AlgebraicGeometry.IsOpenImmersion.lift j_gen τ_V hRange_τ
    have hf_sq_fac : f_sq ≫ j_gen = τ_V :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_gen τ_V hRange_τ
    let Θ_bar : TensorProduct B₀ R₀ K_bar →+* TrivSqZeroExt K_bar (K_bar × K_bar) :=
      (AlgebraicGeometry.Spec.preimage f_sq).hom
    have hSpec_Θ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_bar) = f_sq :=
      AlgebraicGeometry.Spec.map_preimage f_sq
    have hΘ_j_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_bar) ≫ j_gen =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ψ) ≫ hAff_V.fromSpec := by
      rw [hSpec_Θ, hf_sq_fac]
    have hΘ_right : Θ_bar.comp Algebra.TensorProduct.includeRight.toRingHom =
        TrivSqZeroExt.inlHom K_bar (K_bar × K_bar) := by
      have hcomp := congrArg (fun g => g ≫ p_gen) hΘ_j_eq
      rw [CategoryTheory.Category.assoc, hj_gen_p,
        CategoryTheory.Category.assoc, hfromSpec_p,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hΨ_α] at hcomp
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hcomp)
    refine ⟨Θ_bar, hΘ_right, ?_⟩
    let incR : K_bar →+* TensorProduct B₀ R₀ K_bar :=
      Algebra.TensorProduct.includeRight.toRingHom
    have hΘ_incR : ∀ c : K_bar, Θ_bar (incR c) = TrivSqZeroExt.inl c :=
      fun c => RingHom.congr_fun hΘ_right c
    let W : Set (K_bar × K_bar) :=
      {v | ∃ x : TensorProduct B₀ R₀ K_bar, Θ_bar x = TrivSqZeroExt.inr v}
    have hW_snd : ∀ x : TensorProduct B₀ R₀ K_bar, (Θ_bar x).snd ∈ W := by
      intro x
      refine ⟨x - incR (Θ_bar x).fst, ?_⟩
      rw [map_sub, hΘ_incR]
      apply TrivSqZeroExt.ext <;> simp
    have hW_sub : ∀ {u v : K_bar × K_bar}, u ∈ W → v ∈ W → u - v ∈ W := by
      rintro u v ⟨x, hx⟩ ⟨y, hy⟩
      refine ⟨x - y, ?_⟩
      rw [map_sub, hx, hy, TrivSqZeroExt.inr_sub]
    have hW_smul : ∀ (c : K_bar) {u : K_bar × K_bar}, u ∈ W → c • u ∈ W := by
      rintro c u ⟨x, hx⟩
      refine ⟨incR c * x, ?_⟩
      rw [map_mul, hΘ_incR, hx, TrivSqZeroExt.inl_mul_inr]
    let mkSqZero₁ : (K_bar × K_bar →ₗ[K_bar] K_bar) →
        (TrivSqZeroExt K_bar (K_bar × K_bar) →+* TrivSqZeroExt K_bar K_bar) :=
      fun L =>
        { toFun := fun z => TrivSqZeroExt.inl z.fst + TrivSqZeroExt.inr (L z.snd)
          map_one' := by apply TrivSqZeroExt.ext <;> simp
          map_mul' := by
            intro x y
            apply TrivSqZeroExt.ext
            · simp [TrivSqZeroExt.fst_mul]
            · simp [TrivSqZeroExt.snd_mul]; ring
          map_zero' := by apply TrivSqZeroExt.ext <;> simp
          map_add' := by
            intro x y
            apply TrivSqZeroExt.ext <;> simp }
    have hBasisW : ((1 : K_bar), (0 : K_bar)) ∈ W ∧ ((0 : K_bar), (1 : K_bar)) ∈ W := by
      by_contra hNotBoth
      have hAnn : ∃ (ℓ : K_bar × K_bar →ₗ[K_bar] K_bar) (v₀ : K_bar × K_bar),
          ℓ v₀ ≠ 0 ∧ ∀ w ∈ W, ℓ w = 0 := by
        by_cases hAllZero : ∀ w ∈ W, w = (0, 0)
        · refine ⟨LinearMap.fst K_bar K_bar K_bar, (1, 0), one_ne_zero, ?_⟩
          intro w hw
          rw [hAllZero w hw]
          rfl
        · have hExNonzero : ∃ w₀ ∈ W, w₀ ≠ (0, 0) := by
            by_contra hNo
            apply hAllZero
            intro w hw
            by_contra hw0
            exact hNo ⟨w, hw, hw0⟩
          obtain ⟨⟨w₁, w₂⟩, hw₀, hw_ne⟩ := hExNonzero
          let ℓ : K_bar × K_bar →ₗ[K_bar] K_bar :=
            w₂ • LinearMap.fst K_bar K_bar K_bar - w₁ • LinearMap.snd K_bar K_bar K_bar
          have hℓ_app : ∀ u : K_bar × K_bar, ℓ u = w₂ * u.1 - w₁ * u.2 := fun _ => rfl
          have hv₀_ex : ∃ v₀ : K_bar × K_bar, ℓ v₀ ≠ 0 := by
            by_cases hw₂ : w₂ = 0
            · have hw₁ : w₁ ≠ 0 := by
                intro hw₁
                exact hw_ne (Prod.ext hw₁ hw₂)
              refine ⟨(0, 1), ?_⟩
              rw [hℓ_app]
              simp [hw₂, hw₁]
            · refine ⟨(1, 0), ?_⟩
              rw [hℓ_app]
              simp [hw₂]
          obtain ⟨v₀, hv₀⟩ := hv₀_ex
          refine ⟨ℓ, v₀, hv₀, ?_⟩
          intro ⟨u₁, u₂⟩ hu
          rw [hℓ_app]
          dsimp only
          by_contra hδ
          set δ := w₂ * u₁ - w₁ * u₂
          have hc₁_mem : δ⁻¹ • (w₂ • (u₁, u₂) - u₂ • (w₁, w₂)) ∈ W :=
            hW_smul δ⁻¹ (hW_sub (hW_smul w₂ hu) (hW_smul u₂ hw₀))
          have hc₂_mem : δ⁻¹ • (u₁ • (w₁, w₂) - w₁ • (u₁, u₂)) ∈ W :=
            hW_smul δ⁻¹ (hW_sub (hW_smul u₁ hw₀) (hW_smul w₁ hu))
          have hc₁_eq : δ⁻¹ • (w₂ • (u₁, u₂) - u₂ • (w₁, w₂)) = ((1 : K_bar), (0 : K_bar)) := by
            apply Prod.ext
            · change δ⁻¹ * (w₂ * u₁ - u₂ * w₁) = 1
              have heq : w₂ * u₁ - u₂ * w₁ = δ := by dsimp [δ]; ring
              rw [heq, inv_mul_cancel₀ hδ]
            · change δ⁻¹ * (w₂ * u₂ - u₂ * w₂) = 0
              ring
          have hc₂_eq : δ⁻¹ • (u₁ • (w₁, w₂) - w₁ • (u₁, u₂)) = ((0 : K_bar), (1 : K_bar)) := by
            apply Prod.ext
            · change δ⁻¹ * (u₁ * w₁ - w₁ * u₁) = 0
              ring
            · change δ⁻¹ * (u₁ * w₂ - w₁ * u₂) = 1
              have heq : u₁ * w₂ - w₁ * u₂ = δ := by dsimp [δ]; ring
              rw [heq, inv_mul_cancel₀ hδ]
          rw [hc₁_eq] at hc₁_mem
          rw [hc₂_eq] at hc₂_mem
          exact hNotBoth ⟨hc₁_mem, hc₂_mem⟩
      obtain ⟨ℓ, v₀, hℓ_ne, hℓ_W⟩ := hAnn
      let q_ℓ : TrivSqZeroExt K_bar (K_bar × K_bar) →+* TrivSqZeroExt K_bar K_bar := mkSqZero₁ ℓ
      let q_0 : TrivSqZeroExt K_bar (K_bar × K_bar) →+* TrivSqZeroExt K_bar K_bar :=
        mkSqZero₁ (0 : K_bar × K_bar →ₗ[K_bar] K_bar)
      have hq_Θ : q_ℓ.comp Θ_bar = q_0.comp Θ_bar := by
        apply RingHom.ext
        intro x
        apply TrivSqZeroExt.ext
        · simp [q_ℓ, q_0, mkSqZero₁]
        · simp [q_ℓ, q_0, mkSqZero₁, hℓ_W (Θ_bar x).snd (hW_snd x)]
      have hSpec_q :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_ℓ) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_bar) ≫ j_gen) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_0) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_bar) ≫ j_gen) := by
        rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hq_Θ]
      rw [hΘ_j_eq, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc] at hSpec_q
      have hSpec_Ψ := (cancel_mono hAff_V.fromSpec).mp hSpec_q
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at hSpec_Ψ
      have hq_Ψ : q_ℓ.comp Ψ = q_0.comp Ψ :=
        congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_Ψ)
      obtain ⟨d₀, hd₀⟩ := hΨ_surj (TrivSqZeroExt.inr v₀)
      have heval := congrArg TrivSqZeroExt.snd (RingHom.congr_fun hq_Ψ d₀)
      change (q_ℓ (Ψ d₀)).snd = (q_0 (Ψ d₀)).snd at heval
      rw [hd₀] at heval
      simp [q_ℓ, q_0, mkSqZero₁] at heval
      exact hℓ_ne heval
    obtain ⟨⟨x₁, hx₁⟩, ⟨x₂, hx₂⟩⟩ := hBasisW
    intro z
    refine ⟨incR z.fst + incR z.snd.1 * x₁ + incR z.snd.2 * x₂, ?_⟩
    rw [map_add, map_add, map_mul, map_mul, hΘ_incR, hΘ_incR, hΘ_incR, hx₁, hx₂,
      TrivSqZeroExt.inl_mul_inr, TrivSqZeroExt.inl_mul_inr]
    apply TrivSqZeroExt.ext
    · simp
    · apply Prod.ext <;> simp

  
  
  
  obtain ⟨B, instCR_B, instDom_B, ψ, ι_B, hFT_ψ, hComp_ψ, hInj_B, hΘ_all⟩ :=
    hStage3 R₀ α₀ hFT₀ hΘ_bar_ex
  letI : CommRing B := instCR_B
  letI : IsDomain B := instDom_B
  refine ⟨B, instCR_B, instDom_B, ψ, ι_B, hFT_ψ, hComp_ψ, hInj_B, ?_⟩
  intro Ω _ φ
  dsimp only
  letI : Algebra B₀ R₀ := α₀.toAlgebra
  letI : Algebra B₀ Ω := (φ.comp ψ).toAlgebra
  obtain ⟨j_Ω, hj_open, hj_p, _⟩ := hj_pkg Ω (φ.comp ψ)
  obtain ⟨Θ_Ω, hΘ_α, hΘ_surj⟩ := hΘ_all Ω φ
  exact ⟨TensorProduct B₀ R₀ Ω, inferInstance,
    Algebra.TensorProduct.includeRight.toRingHom, j_Ω, Θ_Ω,
    hj_open, hj_p, hΘ_α, hΘ_surj⟩

theorem weil_domain_spreadOut_plane_chart_integral_and_nonP1 (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [IsNoetherianRing B₀]
    (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
    (ι₀ : B₀ →+* K_bar) (_hInj₀ : Function.Injective ι₀)
    (E₀ : AlgebraicGeometry.Scheme.{u})
    (p₀ : E₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
    (U₀ : E₀.Opens) :
    AlgebraicGeometry.IsProper p₀ →
    AlgebraicGeometry.LocallyOfFinitePresentation p₀ →
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
        (AlgebraicGeometry.IsReduced Y ∧
         ∀ (D : Type u) [CommRing D] [Algebra Ω D]
           (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
           AlgebraicGeometry.IsOpenImmersion j_D →
           j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
           ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
             let L := Localization.AtPrime q.asIdeal
             let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
             Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
               (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3))) →
    ((∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (E : AlgebraicGeometry.Scheme.{u})
          (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        AlgebraicGeometry.IsIntegral E →
        AlgebraicGeometry.IsProper p_E →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 p_E →
        ∀ (U : E.Opens) (_hAff : AlgebraicGeometry.IsAffineOpen U) (_hNe : Nonempty ↥U)
          (α_U : Ω →+* ↑(E.presheaf.obj (Opposite.op U))),
          U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) = U.ι ≫ p_E →
          ((∃ isoP1 : E ≅ (weilProjectiveSpaceOver Ω 1).left,
              p_E = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) ↔
           ∃ (e_K : FractionRing ↑(E.presheaf.obj (Opposite.op U)) ≃+* FractionRing (Polynomial Ω)),
             ∀ c : Ω, e_K (algebraMap _ _ (α_U c)) =
               algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c))) ∧
     (∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B]
          (K_b : Type u) [Field K_b] [IsAlgClosed K_b]
          (ι_B : B →+* K_b) (_hInj : Function.Injective ι_B)
          (P : Polynomial (Polynomial B)) (_hMon : P.Monic) (_hDeg : 1 ≤ P.natDegree),
        let P_bar : Polynomial (Polynomial K_b) := P.map (Polynomial.mapRingHom ι_B)
        Irreducible P_bar →
        (∃ b₁ : B, b₁ ≠ 0 ∧
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : B →+* Ω),
            φ b₁ ≠ 0 →
            Irreducible (P.map (Polynomial.mapRingHom φ)) ∧
            IsDomain (Polynomial (Polynomial Ω) ⧸
              Ideal.span ({P.map (Polynomial.mapRingHom φ)} : Set (Polynomial (Polynomial Ω))))) ∧
        ((¬ ∃ (e_bar : FractionRing (Polynomial (Polynomial K_b) ⧸
                Ideal.span ({P_bar} : Set (Polynomial (Polynomial K_b)))) ≃+*
                FractionRing (Polynomial K_b)),
              ∀ c : K_b,
                e_bar (Localization.mk
                    (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
                  Localization.mk (Polynomial.C c) 1) →
          ∃ (b₂ : B), b₂ ≠ 0 ∧
            ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : B →+* Ω),
              φ b₂ ≠ 0 →
              let Q_Ω : Type u := Polynomial (Polynomial Ω) ⧸
                Ideal.span ({P.map (Polynomial.mapRingHom φ)} : Set (Polynomial (Polynomial Ω)))
              ¬ ∃ (e_Ω : FractionRing Q_Ω ≃+* FractionRing (Polynomial Ω)),
                  ∀ c : Ω,
                    e_Ω (Localization.mk
                        (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
                      Localization.mk (Polynomial.C c) 1))) →
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B₀))
        (y : ↥(CategoryTheory.Limits.pullback p₀ s₀)),
      HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd p₀ s₀) y) →
    (AlgebraicGeometry.SmoothOfRelativeDimension 1
        (CategoryTheory.Limits.pullback.snd p₀
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))) →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B₀)),
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (CategoryTheory.Limits.pullback.snd p₀ s₀)) →
    AlgebraicGeometry.IsIntegral
      (CategoryTheory.Limits.pullback p₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))) →
    (let E_gen := CategoryTheory.Limits.pullback p₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))
     let p_gen := CategoryTheory.Limits.pullback.snd p₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))
     let fst_gen := CategoryTheory.Limits.pullback.fst p₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀))
     (∃ (P : Polynomial (Polynomial K_bar))
        (g₀ : Polynomial (Polynomial K_bar) ⧸
          Ideal.span ({P} : Set (Polynomial (Polynomial K_bar))))
        (α_W : K_bar →+* Localization.Away g₀)
        (j_W : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀)) ⟶ E_gen)
        (pt_W : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀)))
        (r : ℕ)
        (ξ : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ E_gen)),
        P.Monic ∧
        1 ≤ P.natDegree ∧
        Irreducible P ∧
        (∀ c : K_bar, α_W c = Localization.mk
          (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) ∧
        AlgebraicGeometry.IsOpenImmersion j_W ∧
        j_W ≫ p_gen = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) ∧
        Set.range j_W.base ⊆ ((TopologicalSpace.Opens.map fst_gen.base).obj U₀ : Set E_gen) ∧
        pt_W ≫ j_W ≫ p_gen = 𝟙 _ ∧
        (∀ ℓ : Fin r, ξ ℓ ≫ p_gen = 𝟙 _) ∧
        (Set.range j_W.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ ℓ).base) ∧
     (AlgebraicGeometry.SmoothOfRelativeDimension 1 p_gen ∨
      ∃ (V : E_gen.Opens)
        (ev : ↑(E_gen.presheaf.obj (Opposite.op V)) →+* K_bar)
        (α_V : K_bar →+* ↑(E_gen.presheaf.obj (Opposite.op V))),
        AlgebraicGeometry.IsAffineOpen V ∧
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_V) = V.ι ≫ p_gen ∧
        ev.comp α_V = RingHom.id K_bar ∧
        (letI : Algebra K_bar ↑(E_gen.presheaf.obj (Opposite.op V)) := α_V.toAlgebra
         Module.finrank K_bar
           (↑(E_gen.presheaf.obj (Opposite.op V)) ⧸ (RingHom.ker ev) ^ 2) = 3))) →
    ∃ (B₁ : Type u) (_ : CommRing B₁) (_ : IsDomain B₁)
      (ψ₀₁ : B₀ →+* B₁) (ι₁ : B₁ →+* K_bar),
      RingHom.FiniteType ψ₀₁ ∧
      ι₁.comp ψ₀₁ = ι₀ ∧
      Function.Injective ι₁ ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B₁)),
        let s₀ := s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁)
        AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback p₀ s₀) ∧
        Nonempty ↥((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst p₀ s₀).base).obj U₀)) ∧
      ((¬ ∃ isoP1 : CategoryTheory.Limits.pullback p₀
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) ≅
            (weilProjectiveSpaceOver K_bar 1).left,
          CategoryTheory.Limits.pullback.snd p₀
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)) =
            isoP1.hom ≫ (weilProjectiveSpaceOver K_bar 1).hom) →
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B₁)),
          let s₀ := s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁)
          ¬ ∃ isoP1 : CategoryTheory.Limits.pullback p₀ s₀ ≅
                (weilProjectiveSpaceOver Ω 1).left,
              CategoryTheory.Limits.pullback.snd p₀ s₀ =
                isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) :=
by
  intro hProp hLFP hArtinNodal hP1Poly hSmNodAll hSmImp hIntGen hChartAndDichot
  obtain ⟨⟨P, g₀, α_W, j_W, pt_W, r, ξ,
    hMon, hDeg, hIrred, hα_W, hjW_open, hjW_p, hjW_sub, hptW_p, hξ, hCompl⟩, hDichot⟩ :=
    hChartAndDichot
  let s_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀)
  let E_gen := CategoryTheory.Limits.pullback p₀ s_gen
  let p_gen := CategoryTheory.Limits.pullback.snd p₀ s_gen
  let fst_gen := CategoryTheory.Limits.pullback.fst p₀ s_gen
  have hptW : pt_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) = 𝟙 _ := by
    simpa only [CategoryTheory.Category.assoc, hjW_p] using hptW_p

  have hAdjoinInv : ∀ (B : Type u) [CommRing B] [IsDomain B]
      (ψ : B₀ →+* B) (ι : B →+* K_bar),
      RingHom.FiniteType ψ →
      ι.comp ψ = ι₀ →
      Function.Injective ι →
      ∀ (b : B), b ≠ 0 →
      ∃ (B' : Type u) (_ : CommRing B') (_ : IsDomain B')
        (ψ' : B →+* B') (ι' : B' →+* K_bar),
        RingHom.FiniteType ψ' ∧
        RingHom.FiniteType (ψ'.comp ψ) ∧
        ι'.comp ψ' = ι ∧
        ι'.comp (ψ'.comp ψ) = ι₀ ∧
        Function.Injective ι' ∧
        IsUnit (ψ' b) := by
    intro B _ _ ψ ι hFT hComp hInj b hb
    have hιb : ι b ≠ 0 := fun h0 => hb (hInj (h0.trans (map_zero ι).symm))
    let _ : Algebra B K_bar := ι.toAlgebra
    let A' : Subalgebra B K_bar := Algebra.adjoin B ({(ι b)⁻¹} : Set K_bar)
    let B' : Type u := ↥A'
    let ψ' : B →+* B' := algebraMap B B'
    let ι' : B' →+* K_bar := A'.val.toRingHom
    have hFT' : RingHom.FiniteType ψ' := by
      change Algebra.FiniteType B B'
      exact Algebra.FiniteType.adjoin_of_finite (Set.finite_singleton _)
    have hComp' : ι'.comp ψ' = ι := by
      ext x
      rfl
    have hUnit : IsUnit (ψ' b) :=
      ⟨⟨ψ' b, ⟨(ι b)⁻¹, Algebra.subset_adjoin (Set.mem_singleton _)⟩,
        Subtype.ext (mul_inv_cancel₀ hιb), Subtype.ext (inv_mul_cancel₀ hιb)⟩, rfl⟩
    refine ⟨B', inferInstance, inferInstance, ψ', ι', hFT', hFT'.comp hFT,
      hComp', ?_, Subtype.val_injective, hUnit⟩
    rw [← RingHom.comp_assoc, hComp', hComp]

  have hCompositum : ∀ (B_a : Type u) [CommRing B_a]
      (ψ_a : B₀ →+* B_a) (ι_a : B_a →+* K_bar)
      (B_b : Type u) [CommRing B_b]
      (ψ_b : B₀ →+* B_b) (ι_b : B_b →+* K_bar),
      RingHom.FiniteType ψ_a →
      ι_a.comp ψ_a = ι₀ →
      RingHom.FiniteType ψ_b →
      ι_b.comp ψ_b = ι₀ →
      ∃ (B_ab : Type u) (_ : CommRing B_ab) (_ : IsDomain B_ab)
        (ψ_ab : B₀ →+* B_ab) (ι_ab : B_ab →+* K_bar)
        (j_a : B_a →+* B_ab) (j_b : B_b →+* B_ab),
        RingHom.FiniteType ψ_ab ∧
        ι_ab.comp ψ_ab = ι₀ ∧
        Function.Injective ι_ab ∧
        j_a.comp ψ_a = ψ_ab ∧
        ι_ab.comp j_a = ι_a ∧
        j_b.comp ψ_b = ψ_ab ∧
        ι_ab.comp j_b = ι_b := by
    intro B_a _ ψ_a ι_a B_b _ ψ_b ι_b hFT_a hComp_a hFT_b hComp_b
    let _ : Algebra B₀ K_bar := ι₀.toAlgebra
    let _ : Algebra B₀ B_a := ψ_a.toAlgebra
    let _ : Algebra B₀ B_b := ψ_b.toAlgebra
    have hAlgFT_a : Algebra.FiniteType B₀ B_a := hFT_a
    have hAlgFT_b : Algebra.FiniteType B₀ B_b := hFT_b
    obtain ⟨G_a, hG_a⟩ := hAlgFT_a.out
    obtain ⟨G_b, hG_b⟩ := hAlgFT_b.out
    let S_ab : Set K_bar := ι_a '' (↑G_a : Set B_a) ∪ ι_b '' (↑G_b : Set B_b)
    have hFin_ab : S_ab.Finite :=
      (G_a.finite_toSet.image ι_a).union (G_b.finite_toSet.image ι_b)
    let A_ab : Subalgebra B₀ K_bar := Algebra.adjoin B₀ S_ab
    let B_ab : Type u := ↥A_ab
    let ψ_ab : B₀ →+* B_ab := algebraMap B₀ B_ab
    let ι_ab : B_ab →+* K_bar := A_ab.val.toRingHom
    have hFT_ab : RingHom.FiniteType ψ_ab := by
      change Algebra.FiniteType B₀ B_ab
      exact Algebra.FiniteType.adjoin_of_finite hFin_ab
    have hMem_a : ∀ x : B_a, ι_a x ∈ A_ab := by
      intro x
      have hx : x ∈ (⊤ : Subalgebra B₀ B_a) := Algebra.mem_top
      rw [← hG_a] at hx
      exact Algebra.adjoin_induction
        (fun g hg => Algebra.subset_adjoin (Or.inl ⟨g, hg, rfl⟩))
        (fun r => by
          have hr : ι_a (algebraMap B₀ B_a r) = algebraMap B₀ K_bar r :=
            RingHom.congr_fun hComp_a r
          rw [hr]
          exact A_ab.algebraMap_mem r)
        (fun _ _ _ _ hu hv => by rw [map_add]; exact A_ab.add_mem hu hv)
        (fun _ _ _ _ hu hv => by rw [map_mul]; exact A_ab.mul_mem hu hv)
        hx
    have hMem_b : ∀ x : B_b, ι_b x ∈ A_ab := by
      intro x
      have hx : x ∈ (⊤ : Subalgebra B₀ B_b) := Algebra.mem_top
      rw [← hG_b] at hx
      exact Algebra.adjoin_induction
        (fun g hg => Algebra.subset_adjoin (Or.inr ⟨g, hg, rfl⟩))
        (fun r => by
          have hr : ι_b (algebraMap B₀ B_b r) = algebraMap B₀ K_bar r :=
            RingHom.congr_fun hComp_b r
          rw [hr]
          exact A_ab.algebraMap_mem r)
        (fun _ _ _ _ hu hv => by rw [map_add]; exact A_ab.add_mem hu hv)
        (fun _ _ _ _ hu hv => by rw [map_mul]; exact A_ab.mul_mem hu hv)
        hx
    let j_a : B_a →+* B_ab := ι_a.codRestrict A_ab.toSubring hMem_a
    let j_b : B_b →+* B_ab := ι_b.codRestrict A_ab.toSubring hMem_b
    refine ⟨B_ab, inferInstance, inferInstance, ψ_ab, ι_ab, j_a, j_b,
      hFT_ab, rfl, Subtype.val_injective, ?_, rfl, ?_, rfl⟩
    · ext r
      exact RingHom.congr_fun hComp_a r
    · ext r
      exact RingHom.congr_fun hComp_b r

  have hBivMapComp : ∀ {R₁ R₂ R₃ : Type u} [CommRing R₁] [CommRing R₂] [CommRing R₃]
      (f : R₁ →+* R₂) (g : R₂ →+* R₃) (Q₀ : Polynomial (Polynomial R₁)),
      (Q₀.map (Polynomial.mapRingHom f)).map (Polynomial.mapRingHom g) =
        Q₀.map (Polynomial.mapRingHom (g.comp f)) := by
    intro R₁ R₂ R₃ _ _ _ f g Q₀
    rw [Polynomial.map_map]
    congr 1
    exact RingHom.ext fun q => Polynomial.map_map f g q

  obtain ⟨B_init, instCR_init, instDom_init, ψ_init, ι_init, P_init, G_init, α_init,
    hFT_init, hComp_init, hInj_init, hMon_init, hDeg_init, hP_map_init, hLFP_α_init,
    ⟨ψ_gen, hPb_gen⟩, hUnivPb⟩ :=
    weil_bivariate_quotient_away_lift_and_isPullback
      B₀ K_bar ι₀ _hInj₀ P hMon hDeg g₀ α_W hα_W
  let _ : CommRing B_init := instCR_init
  let _ : IsDomain B_init := instDom_init
  have _ : IsNoetherianRing B_init := by
    let _ : Algebra B₀ B_init := ψ_init.toAlgebra
    have _ : Algebra.FiniteType B₀ B_init := hFT_init
    exact Algebra.FiniteType.isNoetherianRing B₀ B_init

  let A_init : Type u :=
    Localization.Away (Ideal.Quotient.mk (Ideal.span ({P_init} : Set (Polynomial (Polynomial B_init)))) G_init)
  let f_init := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_init)
  let E_init := CategoryTheory.Limits.pullback p₀ f_init
  let p_init := CategoryTheory.Limits.pullback.snd p₀ f_init
  let fst_init := CategoryTheory.Limits.pullback.fst p₀ f_init
  let U_init : E_init.Opens := (TopologicalSpace.Opens.map fst_init.base).obj U₀
  have _ : AlgebraicGeometry.IsProper p_init := inferInstance
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation p_init := inferInstance

  let s_init_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_init)
  have hs_init_gen_eq : s_init_gen ≫ f_init = s_gen := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hComp_init]
  have hPb_init_gen : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst p_init s_init_gen ≫ fst_init)
      (CategoryTheory.Limits.pullback.snd p_init s_init_gen)
      p₀ s_gen := by
    rw [← hs_init_gen_eq]
    exact (CategoryTheory.IsPullback.of_hasPullback p_init s_init_gen).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback p₀ f_init)
  let e_init_gen := hPb_init_gen.isoPullback
  have he_init_gen_fst :
      e_init_gen.hom ≫ fst_gen =
        CategoryTheory.Limits.pullback.fst p_init s_init_gen ≫ fst_init :=
    hPb_init_gen.isoPullback_hom_fst
  have he_init_gen_snd :
      e_init_gen.hom ≫ p_gen =
        CategoryTheory.Limits.pullback.snd p_init s_init_gen :=
    hPb_init_gen.isoPullback_hom_snd
  have he_init_gen_inv_snd :
      e_init_gen.inv ≫ CategoryTheory.Limits.pullback.snd p_init s_init_gen = p_gen := by
    rw [← he_init_gen_snd, ← CategoryTheory.Category.assoc,
      e_init_gen.inv_hom_id, CategoryTheory.Category.id_comp]
  have he_init_gen_inv_fst :
      e_init_gen.inv ≫ (CategoryTheory.Limits.pullback.fst p_init s_init_gen ≫ fst_init) =
        fst_gen := by
    rw [← he_init_gen_fst, ← CategoryTheory.Category.assoc,
      e_init_gen.inv_hom_id, CategoryTheory.Category.id_comp]

  let j_W_init := j_W ≫ e_init_gen.inv
  let ξ_init : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
      CategoryTheory.Limits.pullback p_init s_init_gen) :=
    fun ℓ => ξ ℓ ≫ e_init_gen.inv
  have hjW_init_open : AlgebraicGeometry.IsOpenImmersion j_W_init := by
    have _ := hjW_open
    infer_instance
  have hjW_init_p :
      j_W_init ≫ CategoryTheory.Limits.pullback.snd p_init s_init_gen =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W) := by
    rw [CategoryTheory.Category.assoc, he_init_gen_inv_snd, hjW_p]
  have hjW_init_sub :
      Set.range j_W_init.base ⊆
        ((TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst p_init s_init_gen).base).obj U_init :
          Set ↥(CategoryTheory.Limits.pullback p_init s_init_gen)) := by
    rintro _ ⟨x, rfl⟩
    change ((j_W ≫ e_init_gen.inv) ≫
      (CategoryTheory.Limits.pullback.fst p_init s_init_gen ≫ fst_init)).base x ∈ U₀
    rw [CategoryTheory.Category.assoc, he_init_gen_inv_fst]
    exact hjW_sub ⟨x, rfl⟩
  have hξ_init : ∀ ℓ : Fin r,
      ξ_init ℓ ≫ CategoryTheory.Limits.pullback.snd p_init s_init_gen = 𝟙 _ := by
    intro ℓ
    rw [CategoryTheory.Category.assoc, he_init_gen_inv_snd, hξ ℓ]
  have hCompl_init :
      (Set.range j_W_init.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ_init ℓ).base := by
    intro y hy
    have hy_inv : e_init_gen.inv.base (e_init_gen.hom.base y) = y := by
      change (e_init_gen.hom ≫ e_init_gen.inv).base y = y
      rw [e_init_gen.hom_inv_id]
      rfl
    have hy_gen : e_init_gen.hom.base y ∈ (Set.range j_W.base)ᶜ := by
      rintro ⟨x, hx⟩
      apply hy
      refine ⟨x, ?_⟩
      change e_init_gen.inv.base (j_W.base x) = y
      rw [hx, hy_inv]
    obtain ⟨ℓ, z, hz⟩ := Set.mem_iUnion.mp (hCompl hy_gen)
    refine Set.mem_iUnion.mpr ⟨ℓ, z, ?_⟩
    change e_init_gen.inv.base ((ξ ℓ).base z) = y
    rw [hz, hy_inv]

  obtain ⟨B₂, instCR₂, instDom₂, ψ₁₂, ι₂, hFT₁₂, hComp₁₂, hInj₂, hFibChart⟩ :=
    weil_domain_spreadOut_affine_openImmersion_and_finite_compl
      B_init K_bar ι_init hInj_init E_init p_init U_init
      A_init α_init (Localization.Away g₀) α_W ψ_gen j_W_init pt_W r ξ_init
      inferInstance inferInstance hLFP_α_init hPb_gen
      hjW_init_open hjW_init_p hjW_init_sub hptW hξ_init hCompl_init
  let _ : CommRing B₂ := instCR₂
  let _ : IsDomain B₂ := instDom₂
  let φ₀₂ : B₀ →+* B₂ := ψ₁₂.comp ψ_init
  have hFT₀₂ : RingHom.FiniteType φ₀₂ := hFT₁₂.comp hFT_init
  have hComp₀₂ : ι₂.comp φ₀₂ = ι₀ := by
    rw [← RingHom.comp_assoc, hComp₁₂, hComp_init]
  have _ : IsNoetherianRing B₂ := by
    let _ : Algebra B₀ B₂ := φ₀₂.toAlgebra
    have _ : Algebra.FiniteType B₀ B₂ := hFT₀₂
    exact Algebra.FiniteType.isNoetherianRing B₀ B₂

  let P₂ : Polynomial (Polynomial B₂) := P_init.map (Polynomial.mapRingHom ψ₁₂)
  have hMon₂ : P₂.Monic := hMon_init.map (Polynomial.mapRingHom ψ₁₂)
  have hDeg₂ : 1 ≤ P₂.natDegree := by
    rw [hMon_init.natDegree_map (Polynomial.mapRingHom ψ₁₂)]
    exact hDeg_init
  have hP₂_bar : P₂.map (Polynomial.mapRingHom ι₂) = P := by
    rw [hBivMapComp ψ₁₂ ι₂ P_init, hComp₁₂, hP_map_init]
  have hIrred₂ : Irreducible (P₂.map (Polynomial.mapRingHom ι₂)) := by
    rwa [hP₂_bar]

  obtain ⟨⟨b₁, hb₁_ne, hb₁_dom⟩, _⟩ :=
    hP1Poly.2 B₂ K_bar ι₂ hInj₂ P₂ hMon₂ hDeg₂ hIrred₂
  obtain ⟨B₃, instCR₃, instDom₃, ψ₂₃, ι₃, hFT₂₃, hFT₀₃, hComp₂₃, hComp₀₃, hInj₃, hUnit_b₁⟩ :=
    hAdjoinInv B₂ φ₀₂ ι₂ hFT₀₂ hComp₀₂ hInj₂ b₁ hb₁_ne
  let _ : CommRing B₃ := instCR₃
  let _ : IsDomain B₃ := instDom₃
  let φ₀₃ : B₀ →+* B₃ := ψ₂₃.comp φ₀₂
  have _ : IsNoetherianRing B₃ := by
    let _ : Algebra B₀ B₃ := φ₀₃.toAlgebra
    have _ : Algebra.FiniteType B₀ B₃ := hFT₀₃
    exact Algebra.FiniteType.isNoetherianRing B₀ B₃

  have hB₃_fiber : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (φ₃ : B₃ →+* Ω)
      (s₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B₀))
      (_hs₀ : s₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₃.comp φ₀₃)))
      (P_Ω : Polynomial (Polynomial Ω))
      (_hP_Ω : P_Ω = P_init.map (Polynomial.mapRingHom (φ₃.comp (ψ₂₃.comp ψ₁₂)))),
      AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback p₀ s₀) ∧
      Nonempty ↥((TopologicalSpace.Opens.map
        (CategoryTheory.Limits.pullback.fst p₀ s₀).base).obj U₀) ∧
      ∃ (U_Ω : (CategoryTheory.Limits.pullback p₀ s₀).Opens)
        (_hAff_Ω : AlgebraicGeometry.IsAffineOpen U_Ω)
        (_hNe_Ω : Nonempty ↥U_Ω)
        (α_U_Ω : Ω →+* ↑((CategoryTheory.Limits.pullback p₀ s₀).presheaf.obj (Opposite.op U_Ω)))
        (e_Q_Ω :
          FractionRing ↑((CategoryTheory.Limits.pullback p₀ s₀).presheaf.obj (Opposite.op U_Ω)) ≃+*
            FractionRing (Polynomial (Polynomial Ω) ⧸
              Ideal.span ({P_Ω} : Set (Polynomial (Polynomial Ω))))),
        U_Ω.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U_Ω) =
          U_Ω.ι ≫ CategoryTheory.Limits.pullback.snd p₀ s₀ ∧
        ∀ c : Ω,
          e_Q_Ω (algebraMap _ _ (α_U_Ω c)) =
            Localization.mk (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1 := by
    intro Ω _ _ φ₃ s₀ hs₀ P_Ω hP_Ω
    subst hs₀
    subst hP_Ω
    let φ₂ : B₂ →+* Ω := φ₃.comp ψ₂₃
    let φ_init : B_init →+* Ω := φ₂.comp ψ₁₂
    have hφ_init_eq : φ₃.comp (ψ₂₃.comp ψ₁₂) = φ_init := by
      rw [← RingHom.comp_assoc]
    rw [hφ_init_eq]
    have hφ₀_eq : φ₃.comp φ₀₃ = φ_init.comp ψ_init := by
      change φ₃.comp (ψ₂₃.comp (ψ₁₂.comp ψ_init)) = ((φ₃.comp ψ₂₃).comp ψ₁₂).comp ψ_init
      simp only [RingHom.comp_assoc]
    let s₀_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₃.comp φ₀₃))
    let E_Ω := CategoryTheory.Limits.pullback p₀ s₀_Ω
    let p_Ω := CategoryTheory.Limits.pullback.snd p₀ s₀_Ω
    let fst_Ω := CategoryTheory.Limits.pullback.fst p₀ s₀_Ω
    have _ : AlgebraicGeometry.IsProper p_Ω := inferInstance
    have _ : AlgebraicGeometry.LocallyOfFinitePresentation p_Ω := inferInstance
    have _ : AlgebraicGeometry.LocallyOfFiniteType p_Ω := inferInstance

    have hφ₂_b₁ : φ₂ b₁ ≠ 0 := (hUnit_b₁.map φ₃).ne_zero
    have hP₂_Ω : P₂.map (Polynomial.mapRingHom φ₂) =
        P_init.map (Polynomial.mapRingHom φ_init) :=
      hBivMapComp ψ₁₂ φ₂ P_init
    have hDom_QΩ : IsDomain (Polynomial (Polynomial Ω) ⧸
        Ideal.span ({P_init.map (Polynomial.mapRingHom φ_init)} : Set (Polynomial (Polynomial Ω)))) := by
      rw [← hP₂_Ω]
      exact (hb₁_dom Ω φ₂ hφ₂_b₁).2
    let _ : IsDomain (Polynomial (Polynomial Ω) ⧸
        Ideal.span ({P_init.map (Polynomial.mapRingHom φ_init)} : Set (Polynomial (Polynomial Ω)))) :=
      hDom_QΩ

    obtain ⟨α_W_Ω, ψ_Ω, hα_W_Ω, hPb_Away_Ω⟩ := hUnivPb Ω φ_init
    let g_Ω := Ideal.Quotient.mk
      (Ideal.span ({P_init.map (Polynomial.mapRingHom φ_init)} : Set (Polynomial (Polynomial Ω))))
      (G_init.map (Polynomial.mapRingHom φ_init))
    obtain ⟨j'_Ω, pt_Ω, ξ'_Ω, hj'_open, hj'_p, hj'_sub, hpt_Ω, hξ'_Ω, hCompl'_Ω⟩ :=
      hFibChart Ω φ₂ (Localization.Away g_Ω) α_W_Ω ψ_Ω hPb_Away_Ω

    let s_init_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_init)
    have hs_init_Ω_eq : s_init_Ω ≫ f_init = s₀_Ω := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← hφ₀_eq]
    have hPb_init_Ω : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst p_init s_init_Ω ≫ fst_init)
        (CategoryTheory.Limits.pullback.snd p_init s_init_Ω)
        p₀ s₀_Ω := by
      rw [← hs_init_Ω_eq]
      exact (CategoryTheory.IsPullback.of_hasPullback p_init s_init_Ω).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback p₀ f_init)
    let e_init_Ω := hPb_init_Ω.isoPullback
    have he_Ω_fst :
        e_init_Ω.hom ≫ fst_Ω =
          CategoryTheory.Limits.pullback.fst p_init s_init_Ω ≫ fst_init :=
      hPb_init_Ω.isoPullback_hom_fst
    have he_Ω_snd :
        e_init_Ω.hom ≫ p_Ω =
          CategoryTheory.Limits.pullback.snd p_init s_init_Ω :=
      hPb_init_Ω.isoPullback_hom_snd

    let j_Ω := j'_Ω ≫ e_init_Ω.hom
    let ξ_Ω : Fin r → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_Ω) :=
      fun ℓ => ξ'_Ω ℓ ≫ e_init_Ω.hom
    have hj_Ω_open : AlgebraicGeometry.IsOpenImmersion j_Ω := by
      have _ := hj'_open
      infer_instance
    have hj_Ω_p : j_Ω ≫ p_Ω = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_W_Ω) := by
      rw [CategoryTheory.Category.assoc, he_Ω_snd, hj'_p]
    have hj_Ω_sub : Set.range j_Ω.base ⊆ ((TopologicalSpace.Opens.map fst_Ω.base).obj U₀ : Set ↥E_Ω) := by
      rintro _ ⟨x, rfl⟩
      change ((j'_Ω ≫ e_init_Ω.hom) ≫ fst_Ω).base x ∈ U₀
      rw [CategoryTheory.Category.assoc, he_Ω_fst]
      exact hj'_sub ⟨x, rfl⟩
    have hξ_Ω : ∀ ℓ : Fin r, ξ_Ω ℓ ≫ p_Ω = 𝟙 _ := by
      intro ℓ
      rw [CategoryTheory.Category.assoc, he_Ω_snd, hξ'_Ω ℓ]
    have hCompl_Ω : (Set.range j_Ω.base)ᶜ ⊆ ⋃ ℓ : Fin r, Set.range (ξ_Ω ℓ).base := by
      intro y hy
      have hy_hom : e_init_Ω.hom.base (e_init_Ω.inv.base y) = y := by
        change (e_init_Ω.inv ≫ e_init_Ω.hom).base y = y
        rw [e_init_Ω.inv_hom_id]
        rfl
      have hy' : e_init_Ω.inv.base y ∈ (Set.range j'_Ω.base)ᶜ := by
        rintro ⟨x, hx⟩
        apply hy
        refine ⟨x, ?_⟩
        change e_init_Ω.hom.base (j'_Ω.base x) = y
        rw [hx, hy_hom]
      obtain ⟨ℓ, z, hz⟩ := Set.mem_iUnion.mp (hCompl'_Ω hy')
      refine Set.mem_iUnion.mpr ⟨ℓ, z, ?_⟩
      change e_init_Ω.hom.base ((ξ'_Ω ℓ).base z) = y
      rw [hz, hy_hom]

    have hNe_U₀_Ω : Nonempty ↥((TopologicalSpace.Opens.map fst_Ω.base).obj U₀) := by
      let x₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, inferInstance⟩
      exact ⟨⟨j_Ω.base (pt_Ω.base x₀), hj_Ω_sub ⟨pt_Ω.base x₀, rfl⟩⟩⟩

    obtain ⟨hRed_Ω, hArtin_Ω⟩ := (hArtinNodal Ω E_Ω p_Ω).mp (hSmNodAll Ω s₀_Ω)
    let α_Q_Ω : Ω →+* Polynomial (Polynomial Ω) ⧸
        Ideal.span ({P_init.map (Polynomial.mapRingHom φ_init)} : Set (Polynomial (Polynomial Ω))) :=
      (Ideal.Quotient.mk _).comp (Polynomial.C.comp Polynomial.C)
    obtain ⟨hInt_Ω, U_Ω, hAff_Ω, hNe_Ω, α_U_Ω, e_Q_Ω, hU_Ω_p, he_Q_Ω⟩ :=
      weil_algClosed_dense_away_chart_integral_and_sqZero_not_p1.1
        Ω E_Ω p_Ω _ α_Q_Ω g_Ω α_W_Ω j_Ω pt_Ω r ξ_Ω
        hRed_Ω hArtin_Ω hα_W_Ω hj_Ω_open hj_Ω_p hpt_Ω hξ_Ω hCompl_Ω
    exact ⟨hInt_Ω, hNe_U₀_Ω, U_Ω, hAff_Ω, hNe_Ω, α_U_Ω, e_Q_Ω, hU_Ω_p, he_Q_Ω⟩

  by_cases hP1_gen :
      ∃ isoP1 : E_gen ≅ (weilProjectiveSpaceOver K_bar 1).left,
        p_gen = isoP1.hom ≫ (weilProjectiveSpaceOver K_bar 1).hom
  · refine ⟨B₃, instCR₃, instDom₃, φ₀₃, ι₃, hFT₀₃, hComp₀₃, hInj₃, ?_, ?_⟩
    · intro Ω _ _ s₁
      let φ₁ : B₃ →+* Ω := (AlgebraicGeometry.Spec.preimage s₁).hom
      have hs₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = s₁ :=
        AlgebraicGeometry.Spec.map_preimage s₁
      have hs₀_eq :
          s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀₃) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.comp φ₀₃)) := by
        rw [← hs₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      obtain ⟨hInt_Ω, hNe_U₀_Ω, _⟩ := hB₃_fiber Ω φ₁ _ hs₀_eq _ rfl
      exact ⟨hInt_Ω, hNe_U₀_Ω⟩
    · intro hNotP1_gen
      exact False.elim (hNotP1_gen hP1_gen)
  · rcases hDichot with hSm_gen | hNode_gen
    · let P₃ : Polynomial (Polynomial B₃) := P₂.map (Polynomial.mapRingHom ψ₂₃)
      have hMon₃ : P₃.Monic := hMon₂.map (Polynomial.mapRingHom ψ₂₃)
      have hDeg₃ : 1 ≤ P₃.natDegree := by
        rw [hMon₂.natDegree_map (Polynomial.mapRingHom ψ₂₃)]
        exact hDeg₂
      have hP₃_bar : P₃.map (Polynomial.mapRingHom ι₃) = P := by
        rw [hBivMapComp ψ₂₃ ι₃ P₂, hComp₂₃, hP₂_bar]
      have hIrred₃ : Irreducible (P₃.map (Polynomial.mapRingHom ι₃)) := by
        rwa [hP₃_bar]

      have hs_gen_B₃ : s_gen = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι₃.comp φ₀₃)) := by
        rw [hComp₀₃]
      have hP_gen_B₃ : P = P_init.map (Polynomial.mapRingHom (ι₃.comp (ψ₂₃.comp ψ₁₂))) := by
        have h_comp : ι₃.comp (ψ₂₃.comp ψ₁₂) = ι_init := by
          rw [← RingHom.comp_assoc, hComp₂₃, hComp₁₂]
        rw [h_comp, hP_map_init]
      obtain ⟨_, _, U_gen, hAff_gen, hNe_gen, α_U_gen, e_Q_gen, hU_gen_p, he_Q_gen⟩ :=
        hB₃_fiber K_bar ι₃ s_gen hs_gen_B₃ P hP_gen_B₃

      have hNoEbar :
          ¬ ∃ (e_bar : FractionRing (Polynomial (Polynomial K_bar) ⧸
                  Ideal.span ({P₃.map (Polynomial.mapRingHom ι₃)} :
                    Set (Polynomial (Polynomial K_bar)))) ≃+*
                  FractionRing (Polynomial K_bar)),
                ∀ c : K_bar,
                  e_bar (Localization.mk
                      (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
                    Localization.mk (Polynomial.C c) 1 := by
        rw [hP₃_bar]
        rintro ⟨e_bar, he_bar⟩
        apply hP1_gen
        have _ : AlgebraicGeometry.IsProper p_gen := inferInstance
        refine (hP1Poly.1 K_bar E_gen p_gen hIntGen inferInstance hSm_gen
          U_gen hAff_gen hNe_gen α_U_gen hU_gen_p).mpr ⟨e_Q_gen.trans e_bar, ?_⟩
        intro c
        change e_bar (e_Q_gen (algebraMap _ _ (α_U_gen c))) =
          algebraMap (Polynomial K_bar) (FractionRing (Polynomial K_bar)) (Polynomial.C c)
        rw [he_Q_gen c, he_bar c]
        rfl

      obtain ⟨_, hP1Poly_b₂⟩ := hP1Poly.2 B₃ K_bar ι₃ hInj₃ P₃ hMon₃ hDeg₃ hIrred₃
      obtain ⟨b₂, hb₂_ne, hb₂_nonP1⟩ := hP1Poly_b₂ hNoEbar
      obtain ⟨B₁, instCR₁, instDom₁, ψ₃₁, ι₁, _, hFT₀₁, _, hComp₀₁, hInj₁, hUnit_b₂⟩ :=
        hAdjoinInv B₃ φ₀₃ ι₃ hFT₀₃ hComp₀₃ hInj₃ b₂ hb₂_ne
      let _ : CommRing B₁ := instCR₁
      let _ : IsDomain B₁ := instDom₁
      let ψ₀₁ : B₀ →+* B₁ := ψ₃₁.comp φ₀₃

      refine ⟨B₁, instCR₁, instDom₁, ψ₀₁, ι₁, hFT₀₁, hComp₀₁, hInj₁, ?_, ?_⟩
      · intro Ω _ _ s₁
        let φ₁ : B₁ →+* Ω := (AlgebraicGeometry.Spec.preimage s₁).hom
        have hs₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = s₁ :=
          AlgebraicGeometry.Spec.map_preimage s₁
        have hs₀_eq :
            s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ₁.comp ψ₃₁).comp φ₀₃)) := by
          rw [← hs₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            RingHom.comp_assoc]
        obtain ⟨hInt_Ω, hNe_U₀_Ω, _⟩ := hB₃_fiber Ω (φ₁.comp ψ₃₁) _ hs₀_eq _ rfl
        exact ⟨hInt_Ω, hNe_U₀_Ω⟩
      · intro _ Ω _ _ s₁
        dsimp only
        let φ₁ : B₁ →+* Ω := (AlgebraicGeometry.Spec.preimage s₁).hom
        let φ₃ : B₃ →+* Ω := φ₁.comp ψ₃₁
        have hs₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = s₁ :=
          AlgebraicGeometry.Spec.map_preimage s₁
        let s₀ := s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁)
        have hs₀_eq :
            s₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₃.comp φ₀₃)) := by
          change s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₃₁.comp φ₀₃)) = _
          rw [← hs₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            RingHom.comp_assoc]
        have hP₃_Ω : P₃.map (Polynomial.mapRingHom φ₃) =
            P_init.map (Polynomial.mapRingHom (φ₃.comp (ψ₂₃.comp ψ₁₂))) := by
          change ((P_init.map (Polynomial.mapRingHom ψ₁₂)).map (Polynomial.mapRingHom ψ₂₃)).map
              (Polynomial.mapRingHom φ₃) = _
          rw [hBivMapComp ψ₂₃ φ₃ _, hBivMapComp ψ₁₂ (φ₃.comp ψ₂₃) P_init, RingHom.comp_assoc]
        obtain ⟨hInt_Ω, _, U_Ω, hAff_Ω, hNe_Ω, α_U_Ω, e_Q_Ω, hU_Ω_p, he_Q_Ω⟩ :=
          hB₃_fiber Ω φ₃ s₀ hs₀_eq (P₃.map (Polynomial.mapRingHom φ₃)) hP₃_Ω
        have hφ₃_b₂ : φ₃ b₂ ≠ 0 := (hUnit_b₂.map φ₁).ne_zero
        have hSm_Ω : AlgebraicGeometry.SmoothOfRelativeDimension 1
            (CategoryTheory.Limits.pullback.snd p₀ s₀) :=
          hSmImp hSm_gen Ω s₀
        have _ : AlgebraicGeometry.IsProper (CategoryTheory.Limits.pullback.snd p₀ s₀) :=
          inferInstance
        intro hP1_Ω
        obtain ⟨e_K, he_K⟩ :=
          (hP1Poly.1 Ω (CategoryTheory.Limits.pullback p₀ s₀)
            (CategoryTheory.Limits.pullback.snd p₀ s₀)
            hInt_Ω inferInstance hSm_Ω U_Ω hAff_Ω hNe_Ω α_U_Ω hU_Ω_p).mp hP1_Ω
        refine hb₂_nonP1 Ω φ₃ hφ₃_b₂ ⟨e_Q_Ω.symm.trans e_K, ?_⟩
        intro c
        change e_K (e_Q_Ω.symm (Localization.mk
          (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1)) =
            Localization.mk (Polynomial.C c) 1
        rw [← he_Q_Ω c, RingEquiv.symm_apply_apply, he_K c]
        rfl
    · obtain ⟨B_nod, instCR_nod, instDom_nod, ψ_nod, ι_nod,
          hFT_nod, hComp_nod, _hInj_nod, hSqZero⟩ :=
        weil_domain_spreadOut_sqZero_rank_three_jet
          B₀ K_bar ι₀ _hInj₀ E₀ p₀ hLFP hNode_gen
      let _ : CommRing B_nod := instCR_nod
      let _ : IsDomain B_nod := instDom_nod
      obtain ⟨B₁, instCR₁, instDom₁, ψ₀₁, ι₁, j₃, j_nod,
          hFT₀₁, hComp₀₁, hInj₁, hj₃_comp, _, hj_nod_comp, _⟩ :=
        hCompositum B₃ φ₀₃ ι₃ B_nod ψ_nod ι_nod hFT₀₃ hComp₀₃ hFT_nod hComp_nod
      let _ : CommRing B₁ := instCR₁
      let _ : IsDomain B₁ := instDom₁

      refine ⟨B₁, instCR₁, instDom₁, ψ₀₁, ι₁, hFT₀₁, hComp₀₁, hInj₁, ?_, ?_⟩
      · intro Ω _ _ s₁
        let φ₁ : B₁ →+* Ω := (AlgebraicGeometry.Spec.preimage s₁).hom
        have hs₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = s₁ :=
          AlgebraicGeometry.Spec.map_preimage s₁
        have hs₀_eq :
            s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ₁.comp j₃).comp φ₀₃)) := by
          rw [← hs₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            RingHom.comp_assoc, hj₃_comp]
        obtain ⟨hInt_Ω, hNe_U₀_Ω, _⟩ := hB₃_fiber Ω (φ₁.comp j₃) _ hs₀_eq _ rfl
        exact ⟨hInt_Ω, hNe_U₀_Ω⟩
      · intro _ Ω _ _ s₁
        dsimp only
        let φ₁ : B₁ →+* Ω := (AlgebraicGeometry.Spec.preimage s₁).hom
        have hs₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = s₁ :=
          AlgebraicGeometry.Spec.map_preimage s₁
        have hs₀_nod :
            s₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ₁.comp j_nod).comp ψ_nod)) := by
          rw [← hs₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            RingHom.comp_assoc, hj_nod_comp]
        rw [hs₀_nod]
        obtain ⟨D_Ω, instCR_D, α_D, j_D, Θ_Ω, hjD_open, hjD_p, hΘ_α, hΘ_surj⟩ :=
          hSqZero Ω (φ₁.comp j_nod)
        let _ : CommRing D_Ω := instCR_D
        exact weil_algClosed_dense_away_chart_integral_and_sqZero_not_p1.2
          Ω _ _ D_Ω α_D j_D Θ_Ω hjD_open hjD_p hΘ_α hΘ_surj

theorem weil_domain_smoothOrNodal_component_model_spreadOut (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
    (hFlat : AlgebraicGeometry.Flat g)
    (hProp : AlgebraicGeometry.IsProper g)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (hSurj : AlgebraicGeometry.Surjective g)
    (hArtinNodal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
        (AlgebraicGeometry.IsReduced Y ∧
         ∀ (D : Type u) [CommRing D] [Algebra Ω D]
           (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
           AlgebraicGeometry.IsOpenImmersion j_D →
           j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
           ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
             let L := Localization.AtPrime q.asIdeal
             let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
             Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
               (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)))
    (hP1Poly :
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (E : AlgebraicGeometry.Scheme.{u})
          (p_E : E ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        AlgebraicGeometry.IsIntegral E →
        AlgebraicGeometry.IsProper p_E →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 p_E →
        ∀ (U : E.Opens) (_hAff : AlgebraicGeometry.IsAffineOpen U) (_hNe : Nonempty ↥U)
          (α_U : Ω →+* ↑(E.presheaf.obj (Opposite.op U))),
          U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) = U.ι ≫ p_E →
          ((∃ isoP1 : E ≅ (weilProjectiveSpaceOver Ω 1).left,
              p_E = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) ↔
           ∃ (e_K : FractionRing ↑(E.presheaf.obj (Opposite.op U)) ≃+* FractionRing (Polynomial Ω)),
             ∀ c : Ω, e_K (algebraMap _ _ (α_U c)) =
               algebraMap (Polynomial Ω) (FractionRing (Polynomial Ω)) (Polynomial.C c))) ∧
      (∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B]
          (K_bar : Type u) [Field K_bar] [IsAlgClosed K_bar]
          (ι_B : B →+* K_bar) (_hInj : Function.Injective ι_B)
          (P : Polynomial (Polynomial B)) (_hMon : P.Monic) (_hDeg : 1 ≤ P.natDegree),
        let P_bar : Polynomial (Polynomial K_bar) := P.map (Polynomial.mapRingHom ι_B)
        Irreducible P_bar →
        (∃ b₁ : B, b₁ ≠ 0 ∧
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : B →+* Ω),
            φ b₁ ≠ 0 →
            Irreducible (P.map (Polynomial.mapRingHom φ)) ∧
            IsDomain (Polynomial (Polynomial Ω) ⧸
              Ideal.span ({P.map (Polynomial.mapRingHom φ)} : Set (Polynomial (Polynomial Ω))))) ∧
        ((¬ ∃ (e_bar : FractionRing (Polynomial (Polynomial K_bar) ⧸
                Ideal.span ({P_bar} : Set (Polynomial (Polynomial K_bar)))) ≃+*
                FractionRing (Polynomial K_bar)),
              ∀ c : K_bar,
                e_bar (Localization.mk
                    (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
                  Localization.mk (Polynomial.C c) 1) →
          ∃ (b₂ : B), b₂ ≠ 0 ∧
            ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (φ : B →+* Ω),
              φ b₂ ≠ 0 →
              let Q_Ω : Type u := Polynomial (Polynomial Ω) ⧸
                Ideal.span ({P.map (Polynomial.mapRingHom φ)} : Set (Polynomial (Polynomial Ω)))
              ¬ ∃ (e_Ω : FractionRing Q_Ω ≃+* FractionRing (Polynomial Ω)),
                  ∀ c : Ω,
                    e_Ω (Localization.mk
                        (Ideal.Quotient.mk _ (Polynomial.C (Polynomial.C c))) 1) =
                      Localization.mk (Polynomial.C c) 1))) :
    let s_gen : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure (FractionRing A))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).comp
          (algebraMap A (FractionRing A))))
    ConnectedSpace ↥(CategoryTheory.Limits.pullback g s_gen) →
    (∀ y : ↥(CategoryTheory.Limits.pullback g s_gen),
      HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g s_gen) y) →
    ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
      (ψ : A →+* B) (ι_B : B →+* AlgebraicClosure (FractionRing A))
      (c : ℕ)
      (ℰ : Fin c → AlgebraicGeometry.Scheme.{u})
      (p_ℰ : ∀ i : Fin c, ℰ i ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
      (ι_ℰ : ∀ i : Fin c, ℰ i ⟶ CategoryTheory.Limits.pullback g
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))),
      RingHom.FiniteType ψ ∧
      ι_B.comp ψ = (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))).comp
        (algebraMap A (FractionRing A)) ∧
      Function.Injective ι_B ∧
      1 ≤ c ∧
      (∀ i : Fin c,
        AlgebraicGeometry.IsProper (p_ℰ i) ∧
        AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ i) ∧
        AlgebraicGeometry.IsClosedImmersion (ι_ℰ i) ∧
        ι_ℰ i ≫ CategoryTheory.Limits.pullback.snd g
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) = p_ℰ i) ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s_B : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of B)),
        let g_B := CategoryTheory.Limits.pullback.snd g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
        let Y_Ω := CategoryTheory.Limits.pullback g_B s_B
        let ι_Ω : ∀ i : Fin c,
            CategoryTheory.Limits.pullback (ι_ℰ i) (CategoryTheory.Limits.pullback.fst g_B s_B) ⟶ Y_Ω :=
          fun i => CategoryTheory.Limits.pullback.snd (ι_ℰ i) (CategoryTheory.Limits.pullback.fst g_B s_B)
        ConnectedSpace ↥Y_Ω ∧
        (∀ y : ↥Y_Ω, HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g_B s_B) y) ∧
        (∀ i : Fin c, AlgebraicGeometry.IsIntegral
          (CategoryTheory.Limits.pullback (ι_ℰ i) (CategoryTheory.Limits.pullback.fst g_B s_B))) ∧
        (_root_.Pairwise fun i₁ i₂ : Fin c =>
          Set.range (ι_Ω i₁).base ≠ Set.range (ι_Ω i₂).base) ∧
        irreducibleComponents ↥Y_Ω = Set.range (fun i : Fin c => Set.range (ι_Ω i).base)) ∧
      (∀ (i : Fin c),
        let g_B := CategoryTheory.Limits.pullback.snd g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
        let s_B_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
        let E_gen_i := CategoryTheory.Limits.pullback (ι_ℰ i)
          (CategoryTheory.Limits.pullback.fst g_B s_B_gen)
        let ι_gen_i := CategoryTheory.Limits.pullback.snd (ι_ℰ i)
          (CategoryTheory.Limits.pullback.fst g_B s_B_gen)
        (¬ ∃ isoP1 : E_gen_i ≅
              (weilProjectiveSpaceOver (AlgebraicClosure (FractionRing A)) 1).left,
            ι_gen_i ≫ CategoryTheory.Limits.pullback.snd g_B s_B_gen =
              isoP1.hom ≫ (weilProjectiveSpaceOver (AlgebraicClosure (FractionRing A)) 1).hom) →
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s_B : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
          (E_sch : AlgebraicGeometry.Scheme.{u})
          (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g_B s_B),
          AlgebraicGeometry.IsClosedImmersion ιE →
          AlgebraicGeometry.IsIntegral E_sch →
          Set.range ιE.base = Set.range
            (CategoryTheory.Limits.pullback.snd (ι_ℰ i)
              (CategoryTheory.Limits.pullback.fst g_B s_B)).base →
          ¬ ∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
              ιE ≫ CategoryTheory.Limits.pullback.snd g_B s_B =
                isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) :=
by
  intro s_gen hConnGen hSmNodGen
  have _ := hFlat
  have _ := hSurj
  have _ : AlgebraicGeometry.IsProper g := hProp
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation g := hLFP
  let Q_bar : Type u := AlgebraicClosure (FractionRing A)
  let α_A : A →+* Q_bar :=
    (algebraMap (FractionRing A) Q_bar).comp (algebraMap A (FractionRing A))
  have hInjα : Function.Injective α_A :=
    (RingHom.injective (algebraMap (FractionRing A) Q_bar)).comp
      (IsFractionRing.injective A (FractionRing A))

  have hSymmHom : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}}
      (e : X ≅ Y) (q₁ : X ⟶ Z) (q₂ : Y ⟶ Z),
      e.hom ≫ q₂ = q₁ → e.symm.hom ≫ q₁ = q₂ := by
    intro X Y Z e q₁ q₂ h
    rw [← h, ← CategoryTheory.Category.assoc, e.symm_hom, e.inv_hom_id,
      CategoryTheory.Category.id_comp]

  
  have hTransSmNod : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω]
      (q₁ : Z₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (q₂ : Z₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (e : Z₁ ≅ Z₂),
      e.hom ≫ q₂ = q₁ →
      (∀ z₁ : ↥Z₁, HasSpreadSmoothOrNodalAt q₁ z₁) →
      (∀ z₂ : ↥Z₂, HasSpreadSmoothOrNodalAt q₂ z₂) := by
    intro Z₁ Z₂ Ω _ q₁ q₂ e heq h₁ z₂
    have heinv : e.inv ≫ q₁ = q₂ := by
      rw [← heq, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    rcases h₁ (e.inv.base z₂) with ⟨V₁, hz₁, hSm₁⟩ |
        ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hIdeal, hComm⟩
    · left
      let V₂ : Z₂.Opens := e.inv ⁻¹ᵁ V₁
      refine ⟨V₂, hz₁, ?_⟩
      let e_V : V₂.toScheme ⟶ V₁.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V₁.ι (V₂.ι ≫ e.inv) (by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          exact x.2)
      have hPbV : CategoryTheory.IsPullback e_V V₂.ι V₁.ι e.inv :=
        AlgebraicGeometry.IsOpenImmersion.isPullback e_V V₂.ι V₁.ι e.inv
          (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
          (by ext x; simp [V₂, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
      have hPbBot : CategoryTheory.IsPullback e.inv q₂ q₁
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [heinv, CategoryTheory.Category.comp_id]⟩
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hPbV.paste_vert hPbBot) hSm₁
    · right
      refine ⟨U', u₀, e₁ ≫ e.hom, e₂, inferInstance, hEt₂, ?_, hIdeal, ?_⟩
      · change e.hom.base (e₁.base u₀) = z₂
        rw [hu₀]
        change (e.inv ≫ e.hom).base z₂ = z₂
        rw [e.inv_hom_id]
        rfl
      · rw [CategoryTheory.Category.assoc, heq, hComm]

  have hTransSm : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω]
      (q₁ : Z₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (q₂ : Z₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (e : Z₁ ≅ Z₂),
