      intro A _ _ _ _ _ hMapA j
      let m_A := IsLocalRing.maximalIdeal A
      let k_A := IsLocalRing.ResidueField A
      let m_S := IsLocalRing.maximalIdeal S
      let k_S := IsLocalRing.ResidueField S
      let π_A : (A ⧸ m_A ^ (j + 2)) →ₗ[A] (A ⧸ m_A ^ (j + 1)) :=
        Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ (j + 1)))
      let π_S : (S ⧸ m_S ^ (j + 2)) →ₗ[S] (S ⧸ m_S ^ (j + 1)) :=
        Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ (j + 1)))
