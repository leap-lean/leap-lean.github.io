    let Ψ : U₂.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₁ A₁ B₂)) :=
      hp_spec.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso B₁ A₁ B₂
    let e_cat : CommRingCat.of (TensorProduct B₁ A₁ B₂) ≅ X.presheaf.obj (Opposite.op U₂) :=
      { hom := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct B₁ A₁ B₂))).inv ≫
          Ψ.hom.appTop ≫ U₂.topIso.hom
        inv := U₂.topIso.inv ≫ Ψ.inv.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct B₁ A₁ B₂))).hom
        hom_inv_id := by
          rw [Category.assoc, Category.assoc, ← Category.assoc U₂.topIso.hom, Iso.hom_inv_id,
            Category.id_comp, ← Category.assoc Ψ.hom.appTop, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
            Ψ.inv_hom_id, AlgebraicGeometry.Scheme.Hom.id_appTop, Category.id_comp, Iso.inv_hom_id]
        inv_hom_id := by
          rw [Category.assoc, Category.assoc,
            ← Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso _).hom, Iso.hom_inv_id,
            Category.id_comp, ← Category.assoc Ψ.inv.appTop, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
            Ψ.hom_inv_id, AlgebraicGeometry.Scheme.Hom.id_appTop, Category.id_comp, Iso.inv_hom_id] }
    let e_pre : TensorProduct B₁ A₁ B₂ ≃+* A₂ := e_cat.commRingCatIsoToRingEquiv
    let incR_pre : B₂ →+* TensorProduct B₁ A₁ B₂ :=
      ↑(Algebra.TensorProduct.includeRight (R := B₁) (A := A₁) (B := B₂))
    have hΨ_fst : Ψ.hom ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B₁) (A := A₁) (B := B₂))) =
        X.homOfLE hU ≫ hU₁_aff.isoSpec.hom := by
      dsimp [Ψ]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst, hp_spec.isoPullback_hom_fst]
    have hΨ_snd : Ψ.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_pre) =
        (f ∣_ V₂) ≫ hV₂.isoSpec.hom := by
      dsimp [Ψ, incR_pre]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_snd, hp_spec.isoPullback_hom_snd]
    have hNat_inv : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S),
        φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso S).inv =
          (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ (AlgebraicGeometry.Spec.map φ).appTop := by
      intro R S φ
      rw [← Iso.cancel_iso_hom_left (AlgebraicGeometry.Scheme.ΓSpecIso R),
        ← Iso.cancel_iso_hom_right _ _ (AlgebraicGeometry.Scheme.ΓSpecIso S)]
      simp [AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
    have hLeftCat : CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := B₁) (A := A₁) (B := B₂)) ≫ e_cat.hom =
        X.presheaf.map (CategoryTheory.homOfLE hU).op := by
      have hCancelA₁ : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A₁)).inv ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U₁))).hom = 𝟙 _ :=
        Iso.inv_hom_id _
      dsimp [e_cat]
      rw [← Category.assoc, hNat_inv, Category.assoc,
        ← Category.assoc (AlgebraicGeometry.Spec.map _).appTop,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hΨ_fst,
        AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.IsAffineOpen.isoSpec_hom_appTop hU₁_aff]
      simp only [Category.assoc]
      rw [← Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso _).inv, hCancelA₁,
        Category.id_comp, homOfLE_appTop_eq hU]
    have hRightCat : CommRingCat.ofHom incR_pre ≫ e_cat.hom =
        f.appLE V₂ U₂ (le_refl U₂) := by
      have hCancelB₂ : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B₂)).inv ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op V₂))).hom = 𝟙 _ :=
        Iso.inv_hom_id _
      dsimp [e_cat]
      rw [← Category.assoc, hNat_inv, Category.assoc,
        ← Category.assoc (AlgebraicGeometry.Spec.map _).appTop,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, hΨ_snd,
        AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.IsAffineOpen.isoSpec_hom_appTop hV₂]
      simp only [Category.assoc]
      rw [← Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso _).inv, hCancelB₂,
        Category.id_comp, restrict_appTop_eq_appLE f V₂]
    refine ⟨e_pre, ?_⟩
    intro a₁ b₂
    have htmul : TensorProduct.tmul B₁ a₁ b₂ =
        Algebra.TensorProduct.includeLeftRingHom a₁ * incR_pre b₂ := by
      simp [incR_pre, Algebra.TensorProduct.includeLeftRingHom, Algebra.TensorProduct.includeRight,
        Algebra.TensorProduct.tmul_mul_tmul]
    have hLa : e_pre (Algebra.TensorProduct.includeLeftRingHom a₁) =
        (X.presheaf.map (CategoryTheory.homOfLE hU).op).hom a₁ := by
      change e_cat.hom.hom (Algebra.TensorProduct.includeLeftRingHom a₁) = _
      exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hLeftCat) a₁
    have hRb : e_pre (incR_pre b₂) =
        (f.appLE V₂ U₂ (le_refl U₂)).hom b₂ := by
      change e_cat.hom.hom (incR_pre b₂) = _
      exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hRightCat) b₂
    rw [htmul, map_mul, hLa, hRb]
  exact ⟨hC1, hC2, hC3, hC4, hC5, hC6, hC7, hC8, hC9, hC10⟩

theorem weil_log_canonical_atlas_gluing_from_local_charts (S : AlgebraicGeometry.Scheme.{u})
    (hSepS : S.IsSeparated)
    (hNoethS : ∀ U : S.Opens, AlgebraicGeometry.IsAffineOpen U →
      IsNoetherianRing ↑(S.presheaf.obj (Opposite.op U)))
    (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (m : ℕ)
    (U_base : Fin m → S.Opens)
    (V_cov : Fin m → C.Opens)
    (k_lci : Fin m → ℕ)
    (π_lci : ∀ a : Fin m,
      MvPolynomial (Fin (k_lci a + 1)) ↑(S.presheaf.obj (Opposite.op (U_base a))) →+*
        ↑(C.presheaf.obj (Opposite.op (V_cov a))))
    (F_lci : ∀ a : Fin m,
      Fin (k_lci a) → MvPolynomial (Fin (k_lci a + 1)) ↑(S.presheaf.obj (Opposite.op (U_base a))))
    (tag : Fin m → Option (Fin n))
    (t_mark : ∀ a : Fin m, ↑(C.presheaf.obj (Opposite.op (V_cov a))))
    (hCov : (⋃ a : Fin m, (V_cov a : Set C)) = Set.univ)
    (hCharts : ∀ a : Fin m,
      IsLocalLogCanonicalChart g n τ (U_base a) (V_cov a) (k_lci a)
        (π_lci a) (F_lci a) (tag a) (t_mark a))
    (hPullback : ∀ (S' : AlgebraicGeometry.Scheme.{u}) (f_S : S' ⟶ S),
      ∃ τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g f_S),
        (∀ j : Fin n,
          τ' j ≫ CategoryTheory.Limits.pullback.fst g f_S = f_S ≫ τ j ∧
          τ' j ≫ CategoryTheory.Limits.pullback.snd g f_S = 𝟙 S' ∧
          Set.range (τ' j).base =
            (CategoryTheory.Limits.pullback.fst g f_S).base ⁻¹' Set.range (τ j).base) ∧
        IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g f_S) n τ')
    (hCramer : ∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k₁ k₂ : ℕ)
      (J₁ : Matrix (Fin (k₁ + 1)) (Fin k₁) B)
      (q₁ : (Fin (k₁ + 1) → B) →ₗ[B] Ω_mod)
      (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) B)
      (q₂ : (Fin (k₂ + 1) → B) →ₗ[B] Ω_mod),
      Function.Surjective q₁ →
      LinearMap.ker q₁ = LinearMap.range J₁.mulVecLin →
      Function.Surjective q₂ →
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin →
      Function.Injective J₂.mulVecLin →
      Function.Injective J₁.mulVecLin ∧
      ∃ (ψ₁ ψ₂ : Ω_mod →ₗ[B] B) (u : Bˣ),
        (∀ v : Fin (k₁ + 1) → B,
          ψ₁ (q₁ v) = ∑ r : Fin (k₁ + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id)) ∧
        (∀ w : Fin (k₂ + 1) → B,
          ψ₂ (q₂ w) = ∑ s : Fin (k₂ + 1),
            w s * (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) ∧
        ψ₁ = u.val • ψ₂)
    (hZeroAnn : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A]
      [CommRing B] [Algebra A B] [Module.Flat A B] (S_gen : Set B),
      (∀ (p : PrimeSpectrum A),
        let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
        letI : Algebra A Ω :=
          ((algebraMap p.asIdeal.ResidueField Ω).comp
            (algebraMap A p.asIdeal.ResidueField)).toAlgebra
        ∀ z : TensorProduct A B Ω,
          (∀ b ∈ S_gen, TensorProduct.tmul A b (1 : Ω) * z = 0) → z = 0) →
      ∀ z : B, (∀ b ∈ S_gen, b * z = 0) → z = 0)
    (hAlg : HasWeilLciKaehlerAndNodalAlgebra.{u})
    (hGeom : HasWeilSeparatedAffineAndFiberPushout.{u}) :
    ∃ M : WeilLineBundle C, IsRelativeLogCanonicalAtlas g n τ M :=
by
  let _ := hPullback
  obtain ⟨_hn, hFlat_g, hProp_g, _hLfp_g, _hSurj_g, hSec_g, _hDisj_g, _hSmSec_g, hFib_g⟩ := hStab
  obtain ⟨hAlgLci, hAlgBC, _hAlgDet, hAlgSm, hAlgNode, hAlgFlat⟩ := hAlg
  obtain ⟨hGeomSep, hGeomInter, hGeomRes, hGeomFlat, hGeomEt, _hGeomEtV, _hGeomEtSpec,
    hGeomSm, hGeomPush, hGeomPre⟩ := hGeom
  have hSepC : C.IsSeparated := hGeomSep C S g hProp_g hSepS
  
  have hPresheafHomEq : ∀ (X : AlgebraicGeometry.Scheme.{u}) {U V : X.Opens}
      (w₁ w₂ : Opposite.op U ⟶ Opposite.op V), w₁ = w₂ := by
    intro X U V w₁ w₂
    exact congrArg Quiver.Hom.op (Subsingleton.elim w₁.unop w₂.unop)
  have hPresheafEndId : ∀ (X : AlgebraicGeometry.Scheme.{u}) (U : X.Opens)
      (w : Opposite.op U ⟶ Opposite.op U),
      X.presheaf.map w = 𝟙 (X.presheaf.obj (Opposite.op U)) := by
    intro X U w
    rw [hPresheafHomEq X w (𝟙 (Opposite.op U)), CategoryTheory.Functor.map_id]
  have hFromSpecInj : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hAff : AlgebraicGeometry.IsAffineOpen U),
      Function.Injective hAff.fromSpec.base := by
    intro X U hAff
    have _ := hAff.isOpenImmersion_fromSpec
    exact (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hAff.fromSpec).injective
  have hAppLE_congr_hom : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X ⟶ Y}
      (hf : f₁ = f₂) (U : Y.Opens) (V : X.Opens)
      (e₁ : V ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (e₂ : V ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      f₁.appLE U V e₁ = f₂.appLE U V e₂ := by
    intro X Y f₁ f₂ hf U V e₁ e₂
    subst hf
    rfl
  have hSquareComm : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      {U U' : Y.Opens} {V W : X.Opens} (hU' : U' ≤ U) (hW : W ≤ V)
      (hV_U : V ≤ (TopologicalSpace.Opens.map f.base).obj U)
      (hW_U' : W ≤ (TopologicalSpace.Opens.map f.base).obj U'),
      ((f.appLE U' W hW_U').hom).comp ((Y.presheaf.map (CategoryTheory.homOfLE hU').op).hom) =
        ((X.presheaf.map (CategoryTheory.homOfLE hW).op).hom).comp ((f.appLE U V hV_U).hom) := by
    intro X Y f U U' V W hU' hW hV_U hW_U'
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
    congr 1
    rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
  have hCompBase : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X),
      (f ≫ g).base x = g.base (f.base x) := by
    intro X Y Z f g x
    rw [AlgebraicGeometry.Scheme.Hom.comp_base]
    rfl
  have hIdAppLE : ∀ (X : AlgebraicGeometry.Scheme.{u}) (U : X.Opens)
      (h : U ≤ (TopologicalSpace.Opens.map (𝟙 X : X ⟶ X).base).obj U),
      (𝟙 X : X ⟶ X).appLE U U h = 𝟙 (X.presheaf.obj (Opposite.op U)) := by
    intro X U h
    have hAppId : (𝟙 X : X ⟶ X).app U = 𝟙 (X.presheaf.obj (Opposite.op U)) := by
      simp
      rfl
    have hEq : (𝟙 X : X ⟶ X).appLE U
        ((TopologicalSpace.Opens.map (𝟙 X : X ⟶ X).base).obj U) (le_refl _) =
      𝟙 (X.presheaf.obj (Opposite.op U)) := by
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact hAppId
    exact hEq
  have hSpecMap_top : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂)
      (h : (⊤ : (AlgebraicGeometry.Spec R₂).Opens) ≤
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map φ).base).obj ⊤),
      (AlgebraicGeometry.Spec.map φ).appLE ⊤ ⊤ h = (AlgebraicGeometry.Spec.map φ).appTop := by
    intro R₁ R₂ φ h
    have hEq : (AlgebraicGeometry.Spec.map φ).appLE ⊤
        ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map φ).base).obj ⊤) (le_refl _) =
      (AlgebraicGeometry.Spec.map φ).app ⊤ :=
      (AlgebraicGeometry.Scheme.Hom.app_eq_appLE (AlgebraicGeometry.Spec.map φ)).symm
    exact hEq
  have hMapCofactor : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (ρ : R₁ →+* R₂)
      {k : ℕ} (M : Matrix (Fin (k + 1)) (Fin k) R₁) (r : Fin (k + 1)),
      ρ ((-1) ^ (r : ℕ) * Matrix.det (M.submatrix r.succAbove id)) =
        (-1) ^ (r : ℕ) * Matrix.det ((M.map ρ).submatrix r.succAbove id) := by
    intro R₁ R₂ _ _ ρ k M r
    rw [map_mul, map_pow, map_neg, map_one, RingHom.map_det]
    congr 2
  have hEvalQSingle : ∀ {D Ω_mod : Type u} [CommRing D] [AddCommGroup Ω_mod] [Module D Ω_mod]
      {k : ℕ} (ω : Fin (k + 1) → Ω_mod) (r₀ : Fin (k + 1)),
      (LinearMap.lsum D (fun _ : Fin (k + 1) => D) D fun r =>
        LinearMap.toSpanSingleton D Ω_mod (ω r)) (Pi.single r₀ (1 : D)) = ω r₀ := by
    intro D Ω_mod _ _ _ k ω r₀
    rw [LinearMap.lsum_piSingle, LinearMap.toSpanSingleton_apply, one_smul]
  have hSumPiSingle : ∀ {D : Type u} [CommRing D] {k : ℕ} (c : Fin (k + 1) → D)
      (r₀ : Fin (k + 1)),
      (∑ r : Fin (k + 1), (Pi.single r₀ (1 : D) : Fin (k + 1) → D) r * c r) = c r₀ := by
    intro D _ k c r₀
    rw [Finset.sum_eq_single r₀]
    · simp [Pi.single_eq_same]
    · intro r _ hr
      simp [Pi.single_eq_of_ne hr]
    · intro h
      exact False.elim (h (Finset.mem_univ r₀))
  have hSpanPin : ∀ {D Ω_mod : Type u} [CommRing D] [AddCommGroup Ω_mod] [Module D Ω_mod]
      {k : ℕ} (ω : Fin (k + 1) → Ω_mod),
      Function.Surjective (LinearMap.lsum D (fun _ : Fin (k + 1) => D) D fun r =>
        LinearMap.toSpanSingleton D Ω_mod (ω r)) →
      ∀ (L₁ L₂ : Ω_mod →ₗ[D] D),
        (∀ r : Fin (k + 1), L₁ (ω r) = L₂ (ω r)) → L₁ = L₂ := by
    intro D Ω_mod _ _ _ k ω hSurj L₁ L₂ hEq
    let q : (Fin (k + 1) → D) →ₗ[D] Ω_mod :=
      LinearMap.lsum D (fun _ : Fin (k + 1) => D) D fun r =>
        LinearMap.toSpanSingleton D Ω_mod (ω r)
    ext x
    obtain ⟨v, rfl⟩ := hSurj x
    have hv : v = ∑ r : Fin (k + 1), v r • Pi.single r (1 : D) := by
      ext r
      simp [Finset.sum_apply, Pi.single_apply]
    have hqv : q v = ∑ r : Fin (k + 1), v r • ω r := by
      conv_lhs => rw [hv]
      rw [map_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_smul]
      exact congrArg (v r • ·) (hEvalQSingle ω r)
    rw [hqv, map_sum, map_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [map_smul, map_smul, hEq r]

  
  
  
  have hSubchart : ∀ (U : S.Opens) (hAffU : AlgebraicGeometry.IsAffineOpen U)
      (V : C.Opens) (hAffV : AlgebraicGeometry.IsAffineOpen V)
      (hV_le : V ≤ (TopologicalSpace.Opens.map g.base).obj U)
      (k : ℕ)
      (π : MvPolynomial (Fin (k + 1)) ↑(S.presheaf.obj (Opposite.op U)) →+*
        ↑(C.presheaf.obj (Opposite.op V)))
      (F : Fin k → MvPolynomial (Fin (k + 1)) ↑(S.presheaf.obj (Opposite.op U))),
      π.comp MvPolynomial.C = (g.appLE U V hV_le).hom →
      Function.Surjective π →
      RingHom.ker π = Ideal.span (Set.range F) →
      ∀ (U' : S.Opens) (hAffU' : AlgebraicGeometry.IsAffineOpen U') (hU'_le : U' ≤ U)
        (W : C.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W)
        (hW_le_V : W ≤ V) (hW_le_U' : W ≤ (TopologicalSpace.Opens.map g.base).obj U'),
        let A' := ↑(S.presheaf.obj (Opposite.op U'))
        let D := ↑(C.presheaf.obj (Opposite.op W))
        let res_W : ↑(C.presheaf.obj (Opposite.op V)) →+* D :=
          (C.presheaf.map (CategoryTheory.homOfLE hW_le_V).op).hom
        letI : Algebra A' D := (g.appLE U' W hW_le_U').hom.toAlgebra
        let J_D : Matrix (Fin (k + 1)) (Fin k) D :=
          Matrix.of fun i j => res_W (π (MvPolynomial.pderiv i (F j)))
        let q_D : (Fin (k + 1) → D) →ₗ[D] KaehlerDifferential A' D :=
          LinearMap.lsum D (fun _ : Fin (k + 1) => D) D fun r =>
            LinearMap.toSpanSingleton D (KaehlerDifferential A' D)
              (KaehlerDifferential.D A' D (res_W (π (MvPolynomial.X r))))
        (Function.Surjective q_D ∧ LinearMap.ker q_D = LinearMap.range J_D.mulVecLin) ∧
        (∀ z : D,
          (∀ r : Fin (k + 1),
            (-1) ^ (r : ℕ) * Matrix.det (J_D.submatrix r.succAbove id) * z = 0) → z = 0) ∧
        Function.Injective J_D.mulVecLin := by
    intro U hAffU V hAffV hV_le k π F hπ_C hπ_surj hπ_ker
      U' hAffU' hU'_le W hAffW hW_le_V hW_le_U'
    let A := ↑(S.presheaf.obj (Opposite.op U))
    let B := ↑(C.presheaf.obj (Opposite.op V))
    let A' := ↑(S.presheaf.obj (Opposite.op U'))
    let D := ↑(C.presheaf.obj (Opposite.op W))
    let res_U : A →+* A' := (S.presheaf.map (CategoryTheory.homOfLE hU'_le).op).hom
    let res_W : B →+* D := (C.presheaf.map (CategoryTheory.homOfLE hW_le_V).op).hom
    letI : Algebra A B := (g.appLE U V hV_le).hom.toAlgebra
    letI : Algebra A' D := (g.appLE U' W hW_le_U').hom.toAlgebra
    letI : Algebra A A' := res_U.toAlgebra
    letI : Algebra B D := res_W.toAlgebra
    letI : Algebra A D := (res_W.comp (g.appLE U V hV_le).hom).toAlgebra
    haveI : IsScalarTower A B D := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower A A' D :=
      IsScalarTower.of_algebraMap_eq' (hSquareComm g hU'_le hW_le_V hV_le hW_le_U').symm
    
    let J_B : Matrix (Fin (k + 1)) (Fin k) B :=
      Matrix.of fun i j => π (MvPolynomial.pderiv i (F j))
    obtain ⟨hqB_surj, hqB_ker⟩ := hAlgLci A B k π F hπ_C hπ_surj hπ_ker
    haveI : Algebra.Etale A A' :=
      RingHom.etale_algebraMap.mp (hGeomRes S U U' hAffU hAffU' hU'_le).1
    haveI : Algebra.FormallyEtale A A' := inferInstance
    haveI : Algebra.FormallyUnramified A A' := inferInstance
    haveI : Algebra.Etale B D :=
      RingHom.etale_algebraMap.mp (hGeomRes C V W hAffV hAffW hW_le_V).1
    haveI : Algebra.FormallyEtale B D := inferInstance
    let J_D : Matrix (Fin (k + 1)) (Fin k) D :=
      Matrix.of fun i j => res_W (π (MvPolynomial.pderiv i (F j)))
    let q_D : (Fin (k + 1) → D) →ₗ[D] KaehlerDifferential A' D :=
      LinearMap.lsum D (fun _ : Fin (k + 1) => D) D fun r =>
        LinearMap.toSpanSingleton D (KaehlerDifferential A' D)
          (KaehlerDifferential.D A' D (res_W (π (MvPolynomial.X r))))
    have hJD_eq : J_B.map (algebraMap B D) = J_D := by ext i j; rfl
