              change (1 : MvPolynomial (Fin 2) R) * X_a ^ m 0 * X_a ^ m 1 = X_a ^ n
              rw [one_mul, ← pow_add, hmn]
            conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff p]
