  have hRedLift : ∀ (X Y Z : AlgebraicGeometry.Scheme.{u})
      (f : X ⟶ Z) (g : Y ⟶ Z)
      [AlgebraicGeometry.IsClosedImmersion f] [AlgebraicGeometry.IsReduced Y],
      Set.range g.base ⊆ Set.range f.base →
      ∃ h : Y ⟶ X, h ≫ f = g := by
    intro X Y Z f g _ _ hSub
    let π_Y := CategoryTheory.Limits.pullback.snd f g
    have hSurj : Function.Surjective π_Y.base := by
      intro y
      obtain ⟨x, hx⟩ := hSub ⟨y, rfl⟩
      obtain ⟨p, _, hpY⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f g) x y hx
      exact ⟨p, hpY⟩
    have : CategoryTheory.IsIso π_Y := by
      rw [AlgebraicGeometry.IsClosedImmersion.isIso_iff_ker_eq_bot, eq_bot_iff,
        AlgebraicGeometry.Scheme.IdealSheafData.le_def]
      intro U r hr
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at hr
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, Ideal.mem_bot,
        ← AlgebraicGeometry.basicOpen_eq_bot_iff, eq_bot_iff]
      intro y hy
      obtain ⟨p, rfl⟩ := hSurj y
      have hp : p ∈ (π_Y ⁻¹ᵁ Y.basicOpen r) := hy
      rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen] at hp
      change p ∈ (CategoryTheory.Limits.pullback f g).basicOpen ((π_Y.app U.1).hom r) at hp
      have hr0 : (π_Y.app U.1).hom r = 0 := hr
      rw [hr0, AlgebraicGeometry.Scheme.basicOpen_zero] at hp
      exact hp
    refine ⟨CategoryTheory.inv π_Y ≫ CategoryTheory.Limits.pullback.fst f g, ?_⟩
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      CategoryTheory.IsIso.inv_hom_id_assoc]

  have hRedIso : ∀ (Z₁ Z₂ X : AlgebraicGeometry.Scheme.{u})
      (f₁ : Z₁ ⟶ X) (f₂ : Z₂ ⟶ X)
      [AlgebraicGeometry.IsClosedImmersion f₁] [AlgebraicGeometry.IsClosedImmersion f₂]
      [AlgebraicGeometry.IsReduced Z₁] [AlgebraicGeometry.IsReduced Z₂],
      Set.range f₁.base = Set.range f₂.base →
      ∃ e : Z₁ ≅ Z₂, e.hom ≫ f₂ = f₁ := by
    intro Z₁ Z₂ X f₁ f₂ _ _ _ _ hEq
    obtain ⟨h₁₂, hh₁₂⟩ := hRedLift Z₂ Z₁ X f₂ f₁ (le_of_eq hEq)
    obtain ⟨h₂₁, hh₂₁⟩ := hRedLift Z₁ Z₂ X f₁ f₂ (le_of_eq hEq.symm)
    refine ⟨{ hom := h₁₂, inv := h₂₁, hom_inv_id := ?_, inv_hom_id := ?_ }, hh₁₂⟩
    · rw [← CategoryTheory.cancel_mono f₁, CategoryTheory.Category.assoc, hh₂₁, hh₁₂,
        CategoryTheory.Category.id_comp]
    · rw [← CategoryTheory.cancel_mono f₂, CategoryTheory.Category.assoc, hh₁₂, hh₂₁,
        CategoryTheory.Category.id_comp]

  have hDomSecFacB : ∀ (E : AlgebraicGeometry.Scheme.{u})
      (ι : E ⟶ C_B) (τ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ C_B)
      [AlgebraicGeometry.IsClosedImmersion ι],
