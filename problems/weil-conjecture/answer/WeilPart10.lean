    intro b
    rw [← hρ₁₂_eq b, hψ_D, hψ'_ov, hρ₁₂_eq]
  let res₁ : ↑(C.presheaf.obj (Opposite.op V₁)) →+* B_12 :=
    (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom
  let res₂ : ↑(C.presheaf.obj (Opposite.op V₂)) →+* B_12 :=
