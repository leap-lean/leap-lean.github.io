    have hΦ_iso : CategoryTheory.IsIso Φ := by
      change CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme Φ
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) W hW_top]
      intro a
      change CategoryTheory.IsIso (Φ ∣_ W a)
      let Q_pre : P_S.Opens := (TopologicalSpace.Opens.map Φ.base).obj (W a)
      have hQ_eq : Q_pre = V_S a := by
        have h1 : Q_pre = (TopologicalSpace.Opens.map (Φ ≫ p₁).base).obj (D_R a) := by
