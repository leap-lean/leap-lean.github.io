    infer_instance
  obtain ⟨ψ_ov, hOv₁, hOv₂⟩ := hOv
  obtain ⟨ψ'_ov, hψ'_ov⟩ := (hKaehler.2.1 A_12 A'_12 B_12 B'_12).2 ψ_ov
  obtain ⟨ψ_D, hψ_D⟩ := (hKaehler.2.2 R' A'_12 B'_12 D).2 ψ'_ov
  let ρ₁₂_W : B_12 →+* D := (f_C.appLE V₁₂ W hW₁₂).hom
