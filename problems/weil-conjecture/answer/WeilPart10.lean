      have hPre : ∀ a : Fin 2, IsPreirreducible (U a : Set ↥P_Ω) := by
        intro a
        have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial Ω))) :=
