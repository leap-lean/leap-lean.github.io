      (∀ a : A, algebraMap A 𝒟₁ a = φ₁ (algebraMap A R₁ a)) →
      letI : Algebra R₁ 𝒟₁ := φ₁.toAlgebra
      letI : Algebra R₁ R₂ := ν.toRingHom.toAlgebra
      ∃ (φ₂ : R₂ →+* TensorProduct A B 𝒟₁)
        (e_Ψ : TensorProduct A B 𝒟₁ ≃+* TensorProduct R₁ R₂ 𝒟₁),
        φ₂.Etale ∧
        (∀ b : B, (b ⊗ₜ[A] (1 : 𝒟₁)) = φ₂ (algebraMap B R₂ b)) ∧
        (∀ (b : B) (d₁ : 𝒟₁), e_Ψ (b ⊗ₜ[A] d₁) = (algebraMap B R₂ b) ⊗ₜ[R₁] d₁) := by
    intro A B R₁ R₂ 𝒟₁ _ _ _ _ _ _ _ _ _ _ _ ν Ξ hΞ_tmul φ₁ hEt₁ hAlg₁
    let Φ₁ : R₁ →ₐ[A] 𝒟₁ := { toRingHom := φ₁, commutes' := fun a => (hAlg₁ a).symm }
    let φ₂ : R₂ →+* TensorProduct A B 𝒟₁ :=
      ((Algebra.TensorProduct.map (AlgHom.id A B) Φ₁).toRingHom).comp Ξ.symm.toRingHom
    have hφ₂_B : ∀ b : B, (b ⊗ₜ[A] (1 : 𝒟₁)) = φ₂ (algebraMap B R₂ b) := by
      intro b
      change b ⊗ₜ[A] 1 = (Algebra.TensorProduct.map (AlgHom.id A B) Φ₁) (Ξ.symm (algebraMap B R₂ b))
      rw [Ξ.symm.commutes b, Algebra.TensorProduct.algebraMap_apply,
        Algebra.TensorProduct.map_tmul, map_one]
      rfl
    letI : Algebra R₁ 𝒟₁ := φ₁.toAlgebra
    letI : Algebra R₁ R₂ := ν.toRingHom.toAlgebra
    let incD_hom : 𝒟₁ →+* TensorProduct A B 𝒟₁ :=
      { toFun := fun d₁ => (1 : B) ⊗ₜ[A] d₁
        map_one' := rfl
        map_mul' := fun x y => by rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [TensorProduct.tmul_zero]
        map_add' := fun x y => TensorProduct.tmul_add (1 : B) x y }
    obtain ⟨Ψ_fwd_hom, hΨ_fwd_tmul⟩ := hTensorRingHom (R₀ := R₁) φ₂ incD_hom
      (fun r₁ => by
        have h1 : Ξ ((1 : B) ⊗ₜ[A] r₁) = ν r₁ := by rw [hΞ_tmul, map_one, one_mul]
        have h2 : Ξ.symm (ν r₁) = (1 : B) ⊗ₜ[A] r₁ := by rw [← h1, Ξ.symm_apply_apply]
        change (Algebra.TensorProduct.map (AlgHom.id A B) Φ₁) (Ξ.symm (ν r₁)) = (1 : B) ⊗ₜ[A] (φ₁ r₁)
        rw [h2, Algebra.TensorProduct.map_tmul]
        rfl)
    let incB_hom : B →+* TensorProduct R₁ R₂ 𝒟₁ :=
      { toFun := fun b => (algebraMap B R₂ b) ⊗ₜ[R₁] (1 : 𝒟₁)
        map_one' := by rw [map_one]; rfl
        map_mul' := fun x y => by rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [map_zero, TensorProduct.zero_tmul]
        map_add' := fun x y => by rw [map_add, TensorProduct.add_tmul] }
    let inc𝒟_hom : 𝒟₁ →+* TensorProduct R₁ R₂ 𝒟₁ :=
      { toFun := fun d₁ => (1 : R₂) ⊗ₜ[R₁] d₁
        map_one' := rfl
        map_mul' := fun x y => by rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [TensorProduct.tmul_zero]
        map_add' := fun x y => TensorProduct.tmul_add (1 : R₂) x y }
    obtain ⟨Ψ_inv_hom, hΨ_inv_raw⟩ := hTensorRingHom (R₀ := A) incB_hom inc𝒟_hom
      (fun a => by
        change (algebraMap B R₂ (algebraMap A B a)) ⊗ₜ[R₁] (1 : 𝒟₁) =
          (1 : R₂) ⊗ₜ[R₁] (algebraMap A 𝒟₁ a)
        have hC : algebraMap B R₂ (algebraMap A B a) = algebraMap R₁ R₂ (algebraMap A R₁ a) := by
          have h1 : algebraMap B R₂ (algebraMap A B a) = Ξ ((algebraMap A B a) ⊗ₜ[A] (1 : R₁)) := by
            rw [hΞ_tmul, map_one, mul_one]
          have h2 : ((algebraMap A B a) ⊗ₜ[A] (1 : R₁)) = (1 : B) ⊗ₜ[A] (algebraMap A R₁ a) := by
            rw [Algebra.algebraMap_eq_smul_one (R := A) (A := B),
              Algebra.algebraMap_eq_smul_one (R := A) (A := R₁), TensorProduct.smul_tmul]
          rw [h1, h2, hΞ_tmul, map_one, one_mul]
          rfl
        rw [hC, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        change (1 : R₂) ⊗ₜ[R₁] (φ₁ (algebraMap A R₁ a)) = _
        rw [← hAlg₁ a])
    have hΨ_inv_tmul : ∀ (b : B) (d₁ : 𝒟₁),
        Ψ_inv_hom (b ⊗ₜ[A] d₁) = (algebraMap B R₂ b) ⊗ₜ[R₁] d₁ := by
      intro b d₁
      rw [hΨ_inv_raw]
      change ((algebraMap B R₂ b) ⊗ₜ[R₁] (1 : 𝒟₁)) * ((1 : R₂) ⊗ₜ[R₁] d₁) = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hΨ_fwd_inv : ∀ w : TensorProduct A B 𝒟₁, Ψ_fwd_hom (Ψ_inv_hom w) = w := by
      intro w
      refine TensorProduct.inductionOn w ?_ (fun x y hx hy => by rw [map_add, map_add, hx, hy])
      intro b d₁
      rw [hΨ_inv_tmul, hΨ_fwd_tmul, ← hφ₂_B b]
      change (b ⊗ₜ[A] (1 : 𝒟₁)) * ((1 : B) ⊗ₜ[A] d₁) = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hΨ_inv_fwd : ∀ w : TensorProduct R₁ R₂ 𝒟₁, Ψ_inv_hom (Ψ_fwd_hom w) = w := by
      have h_on_R₂ : ∀ r₂ : R₂, Ψ_inv_hom (φ₂ r₂) = r₂ ⊗ₜ[R₁] (1 : 𝒟₁) := by
        have h_z : ∀ z : TensorProduct A B R₁,
            Ψ_inv_hom ((Algebra.TensorProduct.map (AlgHom.id A B) Φ₁) z) =
              (Ξ z) ⊗ₜ[R₁] (1 : 𝒟₁) := by
          intro z
          refine TensorProduct.inductionOn z ?_
            (fun x y hx hy => by rw [map_add, map_add, map_add, TensorProduct.add_tmul, hx, hy])
          intro b r₁
          change Ψ_inv_hom (b ⊗ₜ[A] φ₁ r₁) = (Ξ (b ⊗ₜ[A] r₁)) ⊗ₜ[R₁] (1 : 𝒟₁)
          rw [hΨ_inv_tmul, hΞ_tmul]
          have h1 : φ₁ r₁ = r₁ • (1 : 𝒟₁) := by rw [Algebra.smul_def, mul_one]; rfl
          rw [h1, ← TensorProduct.smul_tmul, Algebra.smul_def]
          change (ν r₁ * algebraMap B R₂ b) ⊗ₜ[R₁] (1 : 𝒟₁) = _
          rw [mul_comm]
        intro r₂
        simpa [φ₂] using h_z (Ξ.symm r₂)
      intro w
      refine TensorProduct.inductionOn w ?_ (fun x y hx hy => by rw [map_add, map_add, hx, hy])
      intro r₂ d₁
      rw [hΨ_fwd_tmul, map_mul, h_on_R₂ r₂]
      change (r₂ ⊗ₜ[R₁] (1 : 𝒟₁)) * Ψ_inv_hom ((1 : B) ⊗ₜ[A] d₁) = _
      rw [hΨ_inv_tmul, map_one, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    let Ψ_ringEquiv : TensorProduct R₁ R₂ 𝒟₁ ≃+* TensorProduct A B 𝒟₁ :=
      { toFun := Ψ_fwd_hom
        invFun := Ψ_inv_hom
        left_inv := hΨ_inv_fwd
        right_inv := hΨ_fwd_inv
        map_mul' := map_mul Ψ_fwd_hom
        map_add' := map_add Ψ_fwd_hom }
    haveI : Algebra.Etale R₁ 𝒟₁ := RingHom.etale_algebraMap.mp hEt₁
    haveI : Algebra.Etale R₂ (TensorProduct R₁ R₂ 𝒟₁) := inferInstance
    have hEt_inc : (algebraMap R₂ (TensorProduct R₁ R₂ 𝒟₁)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    have h_comp_eq : Ψ_ringEquiv.toRingHom.comp (algebraMap R₂ (TensorProduct R₁ R₂ 𝒟₁)) = φ₂ := by
      apply RingHom.ext
      intro r₂
      change Ψ_fwd_hom (r₂ ⊗ₜ[R₁] (1 : 𝒟₁)) = φ₂ r₂
      rw [hΨ_fwd_tmul, map_one, mul_one]
    have hEt₂ : φ₂.Etale := by
      rw [← h_comp_eq]
      exact RingHom.Etale.respectsIso.left _ Ψ_ringEquiv hEt_inc
    exact ⟨φ₂, Ψ_ringEquiv.symm, hEt₂, hφ₂_B, hΨ_inv_tmul⟩

  have hFinishNode1Abstract : ∀ (A₁ K A_n R₁ R_K B_et D' : Type u)
      [CommRing A₁] [CommRing K] [Algebra A₁ K]
      [CommRing A_n] [CommRing R₁] [Algebra A₁ R₁] [Algebra.FinitePresentation A₁ R₁]
      [CommRing R_K] [Algebra A₁ R_K] [Algebra K R_K] [IsScalarTower A₁ K R_K] [Algebra A_n R_K]
      [CommRing B_et] [Algebra A_n B_et] [Algebra.Etale A_n B_et]
      [CommRing D'] [Algebra R_K D']
      (ν₁ : R₁ →ₐ[A₁] R_K)
      (j_node : A_n →+* R₁)
      (_hj : ν₁.toRingHom.comp j_node = algebraMap A_n R_K)
      (e_node : D' ≃ₐ[R_K] TensorProduct A_n R_K B_et)
      (hBase : ∀ (𝒟₁ : Type u) [CommRing 𝒟₁] [Algebra A₁ 𝒟₁] (φ₁ : R₁ →+* 𝒟₁),
        φ₁.Etale → (∀ a : A₁, algebraMap A₁ 𝒟₁ a = φ₁ (algebraMap A₁ R₁ a)) →
        letI : Algebra R₁ 𝒟₁ := φ₁.toAlgebra
        letI : Algebra R₁ R_K := ν₁.toRingHom.toAlgebra
        ∃ (e_Ψ : TensorProduct A₁ K 𝒟₁ ≃+* TensorProduct R₁ R_K 𝒟₁),
          ∀ (c : K) (d₁ : 𝒟₁), e_Ψ (c ⊗ₜ[A₁] d₁) = (algebraMap K R_K c) ⊗ₜ[R₁] d₁),
      ∃ (𝒟'₁ : Type u) (_ : CommRing 𝒟'₁) (_ : Algebra A₁ 𝒟'₁)
        (φ_node₁ : R₁ →+* 𝒟'₁)
        (e₁ : TensorProduct A₁ K 𝒟'₁ ≃+* D'),
        φ_node₁.Etale ∧
        Algebra.FinitePresentation A₁ 𝒟'₁ ∧
        (∀ a : A₁, algebraMap A₁ 𝒟'₁ a = φ_node₁ (algebraMap A₁ R₁ a)) ∧
        (∀ c : K, e₁ (c ⊗ₜ[A₁] 1) = algebraMap R_K D' (algebraMap K R_K c)) := by
    intro A₁ K A_n R₁ R_K B_et D' _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ν₁ j_node hj e_node hBase
    letI : Algebra A_n R₁ := j_node.toAlgebra
    let 𝒟'₁ : Type u := TensorProduct A_n R₁ B_et
    let φ_node₁ : R₁ →+* 𝒟'₁ := (Algebra.TensorProduct.includeLeft : R₁ →ₐ[A_n] 𝒟'₁).toRingHom
    haveI : Algebra.Etale R₁ 𝒟'₁ := inferInstance
    have hEt₁ : φ_node₁.Etale := RingHom.etale_algebraMap.mpr inferInstance
    have hFP₁ : Algebra.FinitePresentation A₁ 𝒟'₁ := Algebra.FinitePresentation.trans A₁ R₁ 𝒟'₁
    have hAlg₁ : ∀ a : A₁, algebraMap A₁ 𝒟'₁ a = φ_node₁ (algebraMap A₁ R₁ a) := fun a => by
      change (algebraMap A₁ R₁ a) ⊗ₜ[A_n] (1 : B_et) = (algebraMap A₁ R₁ a) ⊗ₜ[A_n] (1 : B_et)
      rfl
    
    have hCancelBridge : ∀ (M₁ : Type u) [CommRing M₁] [Algebra A₁ M₁]
        (φ_M : R₁ →+* M₁) (_hEtM : φ_M.Etale)
        (_hAlgM : ∀ a : A₁, algebraMap A₁ M₁ a = φ_M (algebraMap A₁ R₁ a))
        (e_M : M₁ ≃+* TensorProduct A_n R₁ B_et)
        (_he_M : ∀ r₁ : R₁, e_M (φ_M r₁) = r₁ ⊗ₜ[A_n] (1 : B_et)),
        ∃ (e₁ : TensorProduct A₁ K M₁ ≃+* D'),
          ∀ c : K, e₁ (c ⊗ₜ[A₁] (1 : M₁)) = algebraMap R_K D' (algebraMap K R_K c) := by
      intro M₁ _ _ φ_M hEtM hAlgM e_M he_M
      obtain ⟨e_Ψ₁, he_Ψ₁⟩ := hBase M₁ φ_M hEtM hAlgM
      letI : Algebra R₁ M₁ := φ_M.toAlgebra
      letI : Algebra R₁ R_K := ν₁.toRingHom.toAlgebra
      haveI : IsScalarTower A_n R₁ R_K := IsScalarTower.of_algebraMap_eq' hj.symm
      let e_M_alg : M₁ ≃ₐ[R₁] TensorProduct A_n R₁ B_et :=
        AlgEquiv.ofRingEquiv (f := e_M) he_M
      let e_congr : TensorProduct R₁ R_K M₁ ≃+* TensorProduct R₁ R_K (TensorProduct A_n R₁ B_et) :=
        (Algebra.TensorProduct.congr (AlgEquiv.refl : R_K ≃ₐ[R₁] R_K) e_M_alg).toRingEquiv
      let e_cancel : TensorProduct R₁ R_K (TensorProduct A_n R₁ B_et) ≃+* TensorProduct A_n R_K B_et :=
        (Algebra.TensorProduct.cancelBaseChange A_n R₁ R_K R_K B_et).toRingEquiv
      refine ⟨((e_Ψ₁.trans e_congr).trans e_cancel).trans e_node.symm.toRingEquiv, ?_⟩
      intro c
      change e_node.symm (e_cancel (e_congr (e_Ψ₁ (c ⊗ₜ[A₁] (1 : M₁))))) =
        algebraMap R_K D' (algebraMap K R_K c)
      rw [he_Ψ₁ c (1 : M₁)]
      change e_node.symm (e_cancel ((algebraMap K R_K c) ⊗ₜ[R₁] (e_M (1 : M₁)))) = _
      rw [map_one]
      change e_node.symm ((Algebra.TensorProduct.cancelBaseChange A_n R₁ R_K R_K B_et)
        ((algebraMap K R_K c) ⊗ₜ[R₁] ((1 : R₁) ⊗ₜ[A_n] (1 : B_et)))) = _
      rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul]
      exact e_node.symm.commutes (algebraMap K R_K c)
    obtain ⟨e₁, he₁⟩ := hCancelBridge 𝒟'₁ φ_node₁ hEt₁ hAlg₁ (RingEquiv.refl 𝒟'₁) (fun _ => rfl)
    exact ⟨𝒟'₁, inferInstance, inferInstance, φ_node₁, e₁, hEt₁, hFP₁, hAlg₁, he₁⟩

  let I_node : ∀ (C : Type u) [CommRing C], Ideal (MvPolynomial (Fin 2) C) :=
    fun C _ => Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) C))
  let mkν : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B],
      (MvPolynomial (Fin 2) A ⧸ I_node A) →ₐ[A] (MvPolynomial (Fin 2) B ⧸ I_node B) :=
    fun A B _ _ _ =>
      Ideal.Quotient.liftₐ (I_node A)
        (((Ideal.Quotient.mkₐ B (I_node B)).restrictScalars A).comp
          (MvPolynomial.mapAlgHom (Algebra.ofId A B)))
        (by
          intro p hp
          rw [Ideal.mem_span_singleton] at hp
          obtain ⟨q, rfl⟩ := hp
          change Ideal.Quotient.mk (I_node B)
            (MvPolynomial.map (algebraMap A B) ((MvPolynomial.X 0 * MvPolynomial.X 1) * q)) = 0
          simp only [map_mul, MvPolynomial.map_X]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.mem_span_singleton.mpr ⟨MvPolynomial.map (algebraMap A B) q, rfl⟩))

  have hBaseChange : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      (𝒟'_A : Type u) [CommRing 𝒟'_A] [Algebra A 𝒟'_A]
      (φ_node_A : (MvPolynomial (Fin 2) A ⧸ I_node A) →+* 𝒟'_A),
      φ_node_A.Etale →
      (∀ a : A, algebraMap A 𝒟'_A a = φ_node_A (Ideal.Quotient.mk _ (MvPolynomial.C a))) →
      letI : Algebra (MvPolynomial (Fin 2) A ⧸ I_node A) 𝒟'_A := φ_node_A.toAlgebra
      letI : Algebra (MvPolynomial (Fin 2) A ⧸ I_node A) (MvPolynomial (Fin 2) B ⧸ I_node B) :=
        (mkν A B).toRingHom.toAlgebra
      ∃ (φ_node_B : (MvPolynomial (Fin 2) B ⧸ I_node B) →+* TensorProduct A B 𝒟'_A)
        (e_Ψ : TensorProduct A B 𝒟'_A ≃+*
          TensorProduct (MvPolynomial (Fin 2) A ⧸ I_node A) (MvPolynomial (Fin 2) B ⧸ I_node B) 𝒟'_A),
        φ_node_B.Etale ∧
        (∀ b : B, (b ⊗ₜ[A] (1 : 𝒟'_A)) = φ_node_B (Ideal.Quotient.mk _ (MvPolynomial.C b))) ∧
        (∀ (b : B) (d' : 𝒟'_A), e_Ψ (b ⊗ₜ[A] d') =
          (Ideal.Quotient.mk _ (MvPolynomial.C b)) ⊗ₜ d') := by
    intro A B _ _ _ 𝒟'_A _ _ φ_node_A hEtA hAlgA
    let R_A := MvPolynomial (Fin 2) A ⧸ I_node A
    let R_B := MvPolynomial (Fin 2) B ⧸ I_node B
    let ν_alg : R_A →ₐ[A] R_B := mkν A B
    let Ξ_fwd : TensorProduct A B R_A →ₐ[B] R_B :=
      Algebra.TensorProduct.lift (Algebra.ofId B R_B) ν_alg (fun _ _ => mul_comm _ _)
    have hΞ_fwd_tmul : ∀ (b : B) (r_A : R_A),
        Ξ_fwd (b ⊗ₜ[A] r_A) = algebraMap B R_B b * ν_alg r_A :=
      fun b r_A => Algebra.TensorProduct.lift_tmul _ _ _ b r_A
    let aeval_B : MvPolynomial (Fin 2) B →ₐ[B] TensorProduct A B R_A :=
      MvPolynomial.aeval (R := B) (S₁ := TensorProduct A B R_A)
        (fun i : Fin 2 => (1 : B) ⊗ₜ[A] Ideal.Quotient.mk (I_node A) (MvPolynomial.X i))
    have haeval_ker : ∀ p ∈ I_node B, aeval_B p = 0 := by
      intro p hp
      rw [Ideal.mem_span_singleton] at hp
      obtain ⟨q, rfl⟩ := hp
      rw [map_mul, map_mul]
      have hX0 : aeval_B (MvPolynomial.X 0) = (1 : B) ⊗ₜ[A] Ideal.Quotient.mk (I_node A) (MvPolynomial.X 0) :=
        MvPolynomial.aeval_X _ 0
      have hX1 : aeval_B (MvPolynomial.X 1) = (1 : B) ⊗ₜ[A] Ideal.Quotient.mk (I_node A) (MvPolynomial.X 1) :=
        MvPolynomial.aeval_X _ 1
      rw [hX0, hX1, Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul]
      have h0 : Ideal.Quotient.mk (I_node A) (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [h0, TensorProduct.tmul_zero]
      exact zero_mul (aeval_B q)
    let Ξ_inv : R_B →ₐ[B] TensorProduct A B R_A :=
      Ideal.Quotient.liftₐ (I_node B) aeval_B haeval_ker
    have hΞ_inv_mk : ∀ p : MvPolynomial (Fin 2) B,
        Ξ_inv (Ideal.Quotient.mk (I_node B) p) = aeval_B p := fun _ => rfl
    have hΞ_fwd_inv : ∀ x : R_B, Ξ_fwd (Ξ_inv x) = x := by
      have h_ext : Ξ_fwd.comp Ξ_inv = AlgHom.id B R_B := by
        apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro i
        change Ξ_fwd (Ξ_inv (Ideal.Quotient.mk (I_node B) (MvPolynomial.X i))) =
          Ideal.Quotient.mk (I_node B) (MvPolynomial.X i)
        rw [hΞ_inv_mk, MvPolynomial.aeval_X, hΞ_fwd_tmul, map_one, one_mul]
        change Ideal.Quotient.mk (I_node B) (MvPolynomial.map (algebraMap A B) (MvPolynomial.X i)) = _
        rw [MvPolynomial.map_X]
      exact fun x => AlgHom.congr_fun h_ext x
    have hΞ_inv_fwd : ∀ z : TensorProduct A B R_A, Ξ_inv (Ξ_fwd z) = z := by
      have h_ext : (Ξ_inv.comp Ξ_fwd).restrictScalars A = AlgHom.id A (TensorProduct A B R_A) := by
        apply Algebra.TensorProduct.ext
        · ext b
          change Ξ_inv (Ξ_fwd (b ⊗ₜ[A] 1)) = b ⊗ₜ[A] 1
          rw [hΞ_fwd_tmul, map_one, mul_one]
          exact Ξ_inv.commutes b
        · apply Ideal.Quotient.algHom_ext
          apply MvPolynomial.algHom_ext
          intro i
          change Ξ_inv (Ξ_fwd ((1 : B) ⊗ₜ[A] Ideal.Quotient.mk (I_node A) (MvPolynomial.X i))) =
            (1 : B) ⊗ₜ[A] Ideal.Quotient.mk (I_node A) (MvPolynomial.X i)
          rw [hΞ_fwd_tmul, map_one, one_mul]
          change Ξ_inv (Ideal.Quotient.mk (I_node B)
            (MvPolynomial.map (algebraMap A B) (MvPolynomial.X i))) = _
          rw [MvPolynomial.map_X, hΞ_inv_mk, MvPolynomial.aeval_X]
      exact fun z => AlgHom.congr_fun h_ext z
    let Ξ_equiv : TensorProduct A B R_A ≃ₐ[B] R_B :=
      AlgEquiv.ofAlgHom Ξ_fwd Ξ_inv (AlgHom.ext hΞ_fwd_inv) (AlgHom.ext hΞ_inv_fwd)
    exact hPushEtaleAbstract A B R_A R_B 𝒟'_A ν_alg Ξ_equiv hΞ_fwd_tmul φ_node_A hEtA hAlgA

  have hNodeBC : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      (𝒟'_A : Type u) [CommRing 𝒟'_A] [Algebra A 𝒟'_A]
      (φ_node_A : (MvPolynomial (Fin 2) A ⧸ I_node A) →+* 𝒟'_A),
      φ_node_A.Etale →
      (∀ a : A, algebraMap A 𝒟'_A a = φ_node_A (Ideal.Quotient.mk _ (MvPolynomial.C a))) →
      ∃ (φ_node_B : (MvPolynomial (Fin 2) B ⧸ I_node B) →+* TensorProduct A B 𝒟'_A),
        φ_node_B.Etale ∧
        ∀ b : B, (b ⊗ₜ[A] (1 : 𝒟'_A)) = φ_node_B (Ideal.Quotient.mk _ (MvPolynomial.C b)) := by
    intro A B _ _ _ 𝒟'_A _ _ φ_node_A hEtA hAlgA
    obtain ⟨φ_node_B, _, hEtB, hCB, _⟩ := hBaseChange A B 𝒟'_A φ_node_A hEtA hAlgA
    exact ⟨φ_node_B, hEtB, hCB⟩

  
  have hNodeDesc : ∃ (S₁ : Finset K)
      (𝒟'₁ : Type u) (_ : CommRing 𝒟'₁)
      (_ : Algebra ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) 𝒟'₁)
      (φ_node₁ : (MvPolynomial (Fin 2) ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) ⧸ I_node _) →+* 𝒟'₁)
      (e₁ : TensorProduct ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) K 𝒟'₁ ≃+* D'),
      φ_node₁.Etale ∧
      Algebra.FinitePresentation ↥(Algebra.adjoin B₀ (↑S₁ : Set K)) 𝒟'₁ ∧
      (∀ a : ↥(Algebra.adjoin B₀ (↑S₁ : Set K)),
        algebraMap _ 𝒟'₁ a = φ_node₁ (Ideal.Quotient.mk _ (MvPolynomial.C a))) ∧
      (∀ c : K, e₁ (c ⊗ₜ 1) = φ_node (Ideal.Quotient.mk _ (MvPolynomial.C c))) := by
    have hMemInode : ∀ {C : Type u} [CommRing C] (P : MvPolynomial (Fin 2) C),
        P ∈ I_node C ↔ ∀ e : Fin 2 →₀ ℕ, (e 0 = 0 ∨ e 1 = 0) → P.coeff e = 0 := by
      intro C _ P
      constructor
      · rw [Ideal.mem_span_singleton]
        rintro ⟨H, rfl⟩ e (he0 | he1)
        · rw [mul_assoc, MvPolynomial.coeff_X_mul']
          exact ite_eq_right_iff.mpr fun hmem => False.elim ((Finsupp.mem_support_iff.mp hmem) he0)
        · have hcomm : (MvPolynomial.X 0 * MvPolynomial.X 1) * H =
              MvPolynomial.X 1 * (MvPolynomial.X 0 * H) := by ring
          rw [hcomm, MvPolynomial.coeff_X_mul']
          exact ite_eq_right_iff.mpr fun hmem => False.elim ((Finsupp.mem_support_iff.mp hmem) he1)
      · intro hCoeff
        rw [MvPolynomial.as_sum P]
        refine Ideal.sum_mem (I_node C) fun e _ => ?_
        by_cases he : e 0 = 0 ∨ e 1 = 0
        · rw [hCoeff e he, MvPolynomial.monomial_zero]
          exact Ideal.zero_mem _
        · rw [not_or] at he
          obtain ⟨he0, he1⟩ := he
          let d11 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
          let u : Fin 2 →₀ ℕ := e - d11
          have hu : d11 + u = e := by
            ext i
            fin_cases i <;> simp [d11, u] <;> omega
          have hX : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) C) =
              MvPolynomial.monomial d11 1 := by
            rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul]
          have h_term : MvPolynomial.monomial e (P.coeff e) =
              (MvPolynomial.X 0 * MvPolynomial.X 1) * MvPolynomial.monomial u (P.coeff e) := by
            rw [hX, MvPolynomial.monomial_mul_monomial, one_mul, hu]
          rw [h_term]
          exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
    let R_K := MvPolynomial (Fin 2) K ⧸ I_node K
    letI : Algebra R_K D' := φ_node.toAlgebra
    haveI : Algebra.Etale R_K D' := RingHom.etale_algebraMap.mp hEtNode
    obtain ⟨A_node, B_et, instCR_Bet, instAlg_Bet, hFG_node, hEt_Bet, ⟨e_node⟩⟩ :=
      Algebra.Etale.exists_subalgebra_fg B₀ R_K D'
    letI : CommRing B_et := instCR_Bet
    letI : Algebra ↥A_node B_et := instAlg_Bet
    obtain ⟨G_node, hG_node⟩ := hFG_node
    let P_lift : R_K → MvPolynomial (Fin 2) K := Quotient.out
    have hP_lift : ∀ g : R_K, Ideal.Quotient.mk (I_node K) (P_lift g) = g := Quotient.out_eq
    let S₁ : Finset K :=
      G_node.biUnion (fun g => (P_lift g).support.image (fun e => (P_lift g).coeff e))
    let A₁_sub : Subalgebra B₀ K := Algebra.adjoin B₀ (↑S₁ : Set K)
    let A₁ := ↥A₁_sub
    let R_A₁ := MvPolynomial (Fin 2) A₁ ⧸ I_node A₁
    let ν₁_alg : R_A₁ →ₐ[A₁] R_K := mkν A₁ K
    let ν₁ : R_A₁ →+* R_K := ν₁_alg.toRingHom
    have hν₁_inj : Function.Injective ν₁ := by
      refine (injective_iff_map_eq_zero ν₁).mpr fun x => Quotient.inductionOn' x fun p hp => ?_
      change Ideal.Quotient.mk (I_node K) (MvPolynomial.map A₁_sub.val.toRingHom p) = 0 at hp
      rw [Ideal.Quotient.eq_zero_iff_mem, hMemInode] at hp
      change Ideal.Quotient.mk (I_node A₁) p = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, hMemInode]
      intro e he
      apply Subtype.ext
      have hp_e := hp e he
      rwa [MvPolynomial.coeff_map] at hp_e
    let ν₁_B₀ : R_A₁ →ₐ[B₀] R_K :=
      { toRingHom := ν₁
        commutes' := fun b₀ => by
          change Ideal.Quotient.mk (I_node K)
            (MvPolynomial.map A₁_sub.val.toRingHom (MvPolynomial.C (algebraMap B₀ A₁ b₀))) =
            Ideal.Quotient.mk (I_node K) (MvPolynomial.C (algebraMap B₀ K b₀))
          rw [MvPolynomial.map_C]
          rfl }
    have hAnode_le : A_node ≤ ν₁_B₀.range := by
      rw [← hG_node]
      refine Algebra.adjoin_le fun g hg => ?_
      have hg_fin : g ∈ G_node := Finset.mem_coe.mp hg
      have h_coeff_mem : ∀ e ∈ (P_lift g).support, (P_lift g).coeff e ∈ A₁_sub := by
        intro e he
        apply Algebra.subset_adjoin
        rw [Finset.mem_coe]
        exact Finset.mem_biUnion.mpr ⟨g, hg_fin, Finset.mem_image.mpr ⟨e, he, rfl⟩⟩
      let Q_g : MvPolynomial (Fin 2) A₁ :=
        ∑ e ∈ (P_lift g).support.attach,
          MvPolynomial.monomial e.1 ⟨(P_lift g).coeff e.1, h_coeff_mem e.1 e.2⟩
      refine ⟨Ideal.Quotient.mk (I_node A₁) Q_g, ?_⟩
      change Ideal.Quotient.mk (I_node K) (MvPolynomial.map A₁_sub.val.toRingHom Q_g) = g
      have hmap : MvPolynomial.map A₁_sub.val.toRingHom Q_g = P_lift g := by
        simp only [Q_g, map_sum, MvPolynomial.map_monomial]
        change (∑ e ∈ (P_lift g).support.attach,
          MvPolynomial.monomial e.1 ((P_lift g).coeff e.1)) = P_lift g
        rw [Finset.sum_attach (f := fun e => MvPolynomial.monomial e ((P_lift g).coeff e)),
          ← MvPolynomial.as_sum (P_lift g)]
      rw [hmap, hP_lift g]
    let e_range : R_A₁ ≃+* ↥ν₁.range :=
      RingEquiv.ofBijective ν₁.rangeRestrict ⟨fun x y hxy => hν₁_inj (congrArg Subtype.val hxy),
        ν₁.rangeRestrict_surjective⟩
    let j_node : ↥A_node →+* R_A₁ :=
      e_range.symm.toRingHom.comp (A_node.val.toRingHom.codRestrict ν₁.range (fun z => hAnode_le z.2))
    have hj_node : ν₁.comp j_node = A_node.val.toRingHom := by
      ext z
      have hz : e_range (j_node z) = ⟨z.1, hAnode_le z.2⟩ :=
        e_range.apply_symm_apply ⟨z.1, hAnode_le z.2⟩
      exact congrArg Subtype.val hz
    haveI : Algebra.FinitePresentation A₁ R_A₁ :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton _)
    obtain ⟨𝒟'₁, instCR₁, instAlg₁, φ_node₁, e₁, hEt₁, hFP₁, hAlg₁, he₁⟩ :=
      hFinishNode1Abstract A₁ K ↥A_node R_A₁ R_K B_et D' ν₁_alg j_node hj_node e_node
        (fun 𝒟₁ _ _ φ₁ hEt hAlg => by
          obtain ⟨_, e_Ψ, _, _, he_Ψ⟩ := hBaseChange A₁ K 𝒟₁ φ₁ hEt hAlg
          exact ⟨e_Ψ, he_Ψ⟩)
    exact ⟨S₁, 𝒟'₁, instCR₁, instAlg₁, φ_node₁, e₁, hEt₁, hFP₁, hAlg₁, he₁⟩

  
  
  
  have hCancelEquiv : ∀ (A B : Type u) [CommRing A] [Algebra B₀ A] [CommRing B] [Algebra B₀ B]
      [Algebra A B] [IsScalarTower B₀ A B]
      (𝒟'_A : Type u) [CommRing 𝒟'_A] [Algebra A 𝒟'_A]
      (φ_D_A : TensorProduct B₀ A R →ₐ[A] 𝒟'_A),
      let φ_AB : TensorProduct B₀ A R →+* TensorProduct B₀ B R :=
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A B) (AlgHom.id B₀ R)).toRingHom
      let φ_D_B : TensorProduct B₀ B R →+* TensorProduct A B 𝒟'_A :=
        (Algebra.TensorProduct.map (AlgHom.id A B) φ_D_A).toRingHom.comp
          (Algebra.TensorProduct.cancelBaseChange B₀ A B B R).symm.toRingHom
      letI : Algebra (TensorProduct B₀ A R) 𝒟'_A := φ_D_A.toRingHom.toAlgebra
      letI : Algebra (TensorProduct B₀ A R) (TensorProduct B₀ B R) := φ_AB.toAlgebra
      ∃ (Φ_AB : TensorProduct (TensorProduct B₀ A R) (TensorProduct B₀ B R) 𝒟'_A ≃+*
          TensorProduct A B 𝒟'_A),
        Φ_AB.toRingHom.comp
          (algebraMap (TensorProduct B₀ B R)
            (TensorProduct (TensorProduct B₀ A R) (TensorProduct B₀ B R) 𝒟'_A)) = φ_D_B ∧
        ∀ x : TensorProduct B₀ B R, Φ_AB.symm (φ_D_B x) = x ⊗ₜ (1 : 𝒟'_A) := by
    intro A B _ _ _ _ _ _ 𝒟'_A _ _ φ_D_A φ_AB φ_D_B
    let D_A := TensorProduct B₀ A R
    let D_B := TensorProduct B₀ B R
    letI : Algebra D_A 𝒟'_A := φ_D_A.toRingHom.toAlgebra
    letI : Algebra D_A D_B := φ_AB.toAlgebra
    have hφDB_tmul : ∀ (b : B) (r : R),
        φ_D_B (b ⊗ₜ[B₀] r) = b ⊗ₜ[A] φ_D_A ((1 : A) ⊗ₜ[B₀] r) := by
      intro b r
      change (Algebra.TensorProduct.map (AlgHom.id A B) φ_D_A)
        ((Algebra.TensorProduct.cancelBaseChange B₀ A B B R).symm (b ⊗ₜ[B₀] r)) = _
      rw [Algebra.TensorProduct.cancelBaseChange_symm_tmul, Algebra.TensorProduct.map_tmul]
      rfl
    let inc𝒟_AB : 𝒟'_A →+* TensorProduct A B 𝒟'_A :=
      { toFun := fun d' => (1 : B) ⊗ₜ[A] d'
        map_one' := rfl
        map_mul' := fun x y => by rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [TensorProduct.tmul_zero]
        map_add' := fun x y => TensorProduct.tmul_add (1 : B) x y }
    obtain ⟨Φ_fwd_hom, hΦ_fwd_tmul⟩ := hTensorRingHom (R₀ := D_A) φ_D_B inc𝒟_AB
      (fun x_A => by
        refine TensorProduct.inductionOn x_A ?_
          (fun x y hx hy => by rw [map_add, map_add, map_add, map_add, hx, hy])
        intro a r
        change φ_D_B ((algebraMap A B a) ⊗ₜ[B₀] r) = (1 : B) ⊗ₜ[A] φ_D_A (a ⊗ₜ[B₀] r)
        rw [hφDB_tmul, Algebra.algebraMap_eq_smul_one (R := A) (A := B) a,
          TensorProduct.smul_tmul, ← map_smul φ_D_A a ((1 : A) ⊗ₜ[B₀] r),
          TensorProduct.smul_tmul', smul_eq_mul, mul_one])
    let incB_DB : B →+* TensorProduct D_A D_B 𝒟'_A :=
      { toFun := fun b => (algebraMap B D_B b) ⊗ₜ[D_A] (1 : 𝒟'_A)
        map_one' := by rw [map_one]; rfl
        map_mul' := fun x y => by rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [map_zero, TensorProduct.zero_tmul]
        map_add' := fun x y => by rw [map_add, TensorProduct.add_tmul] }
    let inc𝒟_DB : 𝒟'_A →+* TensorProduct D_A D_B 𝒟'_A :=
      { toFun := fun d' => (1 : D_B) ⊗ₜ[D_A] d'
        map_one' := rfl
        map_mul' := fun x y => by rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [TensorProduct.tmul_zero]
        map_add' := fun x y => TensorProduct.tmul_add (1 : D_B) x y }
    obtain ⟨Φ_inv_hom, hΦ_inv_raw⟩ := hTensorRingHom (R₀ := A) incB_DB inc𝒟_DB
      (fun a => by
        change (algebraMap B D_B (algebraMap A B a)) ⊗ₜ[D_A] (1 : 𝒟'_A) =
          (1 : D_B) ⊗ₜ[D_A] (algebraMap A 𝒟'_A a)
        have h_alg : algebraMap B D_B (algebraMap A B a) = φ_AB (algebraMap A D_A a) := rfl
        rw [h_alg]
        change (algebraMap D_A D_B (algebraMap A D_A a)) ⊗ₜ[D_A] (1 : 𝒟'_A) = _
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        change (1 : D_B) ⊗ₜ[D_A] (φ_D_A (algebraMap A D_A a)) = _
        rw [φ_D_A.commutes a])
    have hΦ_inv_tmul : ∀ (b : B) (d' : 𝒟'_A),
        Φ_inv_hom (b ⊗ₜ[A] d') = (b ⊗ₜ[B₀] (1 : R)) ⊗ₜ[D_A] d' := by
      intro b d'
      rw [hΦ_inv_raw]
      change ((b ⊗ₜ[B₀] (1 : R)) ⊗ₜ[D_A] (1 : 𝒟'_A)) * ((1 : D_B) ⊗ₜ[D_A] d') = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hΦ_fwd_inv : ∀ w : TensorProduct A B 𝒟'_A, Φ_fwd_hom (Φ_inv_hom w) = w := by
      intro w
      refine TensorProduct.inductionOn w ?_ (fun x y hx hy => by rw [map_add, map_add, hx, hy])
      intro b d'
      rw [hΦ_inv_tmul, hΦ_fwd_tmul, hφDB_tmul,
        show ((1 : A) ⊗ₜ[B₀] (1 : R)) = (1 : D_A) from rfl, map_one]
      change (b ⊗ₜ[A] (1 : 𝒟'_A)) * ((1 : B) ⊗ₜ[A] d') = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    have hΦ_inv_fwd : ∀ w : TensorProduct D_A D_B 𝒟'_A, Φ_inv_hom (Φ_fwd_hom w) = w := by
      have h_on_DB : ∀ x_B : D_B, Φ_inv_hom (φ_D_B x_B) = x_B ⊗ₜ[D_A] (1 : 𝒟'_A) := by
        intro x_B
        refine TensorProduct.inductionOn x_B ?_
          (fun x y hx hy => by rw [map_add, map_add, TensorProduct.add_tmul, hx, hy])
        intro b r
        rw [hφDB_tmul, hΦ_inv_tmul]
        have h1 : φ_D_A ((1 : A) ⊗ₜ[B₀] r) = ((1 : A) ⊗ₜ[B₀] r : D_A) • (1 : 𝒟'_A) := by
          rw [Algebra.smul_def, mul_one]; rfl
        rw [h1, ← TensorProduct.smul_tmul, Algebra.smul_def]
        have h_map1 : algebraMap D_A D_B ((1 : A) ⊗ₜ[B₀] r) = (1 : B) ⊗ₜ[B₀] r := by
          change (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A B) (AlgHom.id B₀ R))
            ((1 : A) ⊗ₜ[B₀] r) = _
          rw [Algebra.TensorProduct.map_tmul, map_one]
          rfl
        rw [h_map1, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      intro w
      refine TensorProduct.inductionOn w ?_ (fun x y hx hy => by rw [map_add, map_add, hx, hy])
      intro x_B d'
      rw [hΦ_fwd_tmul, map_mul, h_on_DB x_B]
      change (x_B ⊗ₜ[D_A] (1 : 𝒟'_A)) * Φ_inv_hom ((1 : B) ⊗ₜ[A] d') = _
      rw [hΦ_inv_tmul, show ((1 : B) ⊗ₜ[B₀] (1 : R)) = (1 : D_B) from rfl,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    let Φ_ringEquiv : TensorProduct D_A D_B 𝒟'_A ≃+* TensorProduct A B 𝒟'_A :=
      { toFun := Φ_fwd_hom
        invFun := Φ_inv_hom
        left_inv := hΦ_inv_fwd
        right_inv := hΦ_fwd_inv
        map_mul' := map_mul Φ_fwd_hom
        map_add' := map_add Φ_fwd_hom }
    have h_comp : Φ_ringEquiv.toRingHom.comp (algebraMap D_B (TensorProduct D_A D_B 𝒟'_A)) = φ_D_B := by
      apply RingHom.ext
      intro x
      change Φ_fwd_hom (x ⊗ₜ[D_A] (1 : 𝒟'_A)) = φ_D_B x
      rw [hΦ_fwd_tmul, map_one, mul_one]
    refine ⟨Φ_ringEquiv, h_comp, ?_⟩
    intro x
    have hx : Φ_ringEquiv (x ⊗ₜ[D_A] (1 : 𝒟'_A)) = φ_D_B x := RingHom.congr_fun h_comp x
    rw [← hx, Φ_ringEquiv.symm_apply_apply]

  have hCancelEt : ∀ (A B : Type u) [CommRing A] [Algebra B₀ A] [CommRing B] [Algebra B₀ B]
      [Algebra A B] [IsScalarTower B₀ A B]
      (𝒟'_A : Type u) [CommRing 𝒟'_A] [Algebra A 𝒟'_A]
      (φ_D_A : TensorProduct B₀ A R →ₐ[A] 𝒟'_A),
      let φ_AB : TensorProduct B₀ A R →+* TensorProduct B₀ B R :=
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A B) (AlgHom.id B₀ R)).toRingHom
      letI : Algebra (TensorProduct B₀ A R) 𝒟'_A := φ_D_A.toRingHom.toAlgebra
      letI : Algebra (TensorProduct B₀ A R) (TensorProduct B₀ B R) := φ_AB.toAlgebra
      (Algebra.Etale (TensorProduct B₀ B R)
        (TensorProduct (TensorProduct B₀ A R) (TensorProduct B₀ B R) 𝒟'_A) ↔
       ((Algebra.TensorProduct.map (AlgHom.id A B) φ_D_A).toRingHom.comp
         (Algebra.TensorProduct.cancelBaseChange B₀ A B B R).symm.toRingHom).Etale) := by
    intro A B _ _ _ _ _ _ 𝒟'_A _ _ φ_D_A
    dsimp only
    obtain ⟨Φ_AB, hΦ_comp, _⟩ := hCancelEquiv A B 𝒟'_A φ_D_A
    let D_A := TensorProduct B₀ A R
    let D_B := TensorProduct B₀ B R
    let φ_AB : D_A →+* D_B :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A B) (AlgHom.id B₀ R)).toRingHom
    letI : Algebra D_A 𝒟'_A := φ_D_A.toRingHom.toAlgebra
    letI : Algebra D_A D_B := φ_AB.toAlgebra
    rw [← hΦ_comp]
    constructor
    · intro hEt
      have hEt_inc : (algebraMap D_B (TensorProduct D_A D_B 𝒟'_A)).Etale :=
        RingHom.etale_algebraMap.mpr hEt
      exact RingHom.Etale.respectsIso.left _ Φ_AB hEt_inc
    · intro hEt
      have hEt_inc : (algebraMap D_B (TensorProduct D_A D_B 𝒟'_A)).Etale := by
        have h_inv : Φ_AB.symm.toRingHom.comp
            (Φ_AB.toRingHom.comp (algebraMap D_B (TensorProduct D_A D_B 𝒟'_A))) =
            algebraMap D_B (TensorProduct D_A D_B 𝒟'_A) := by
          apply RingHom.ext
          intro x
          exact Φ_AB.symm_apply_apply _
        rw [← h_inv]
        exact RingHom.Etale.respectsIso.left _ Φ_AB.symm hEt
      exact RingHom.etale_algebraMap.mp hEt_inc

  have hOpenLift : ∀ (A : Type u) [CommRing A] [Algebra B₀ A]
      (𝒟'_A : Type u) [CommRing 𝒟'_A] [Algebra A 𝒟'_A]
      (φ_hom : TensorProduct B₀ A R →+* 𝒟'_A)
      (h_commA : ∀ a : A, φ_hom (algebraMap A (TensorProduct B₀ A R) a) = algebraMap A 𝒟'_A a),
      φ_hom.Etale →
      ∃ (O_A : TopologicalSpace.Opens (PrimeSpectrum (TensorProduct B₀ A R))),
        (∀ p' : PrimeSpectrum 𝒟'_A, PrimeSpectrum.comap φ_hom p' ∈ O_A) ∧
        ∀ (Ω : Type u) [CommRing Ω] [Algebra B₀ Ω] [Algebra A Ω] [IsScalarTower B₀ A Ω],
          ∃ (φ_D_Ω : TensorProduct B₀ Ω R →+* TensorProduct A Ω 𝒟'_A),
            φ_D_Ω.Etale ∧
            (∀ ω : Ω, φ_D_Ω (algebraMap Ω (TensorProduct B₀ Ω R) ω) = ω ⊗ₜ[A] (1 : 𝒟'_A)) ∧
            ∀ q_Ω : PrimeSpectrum (TensorProduct B₀ Ω R),
              PrimeSpectrum.comap
                (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A Ω) (AlgHom.id B₀ R)).toRingHom
                q_Ω ∈ O_A →
              q_Ω ∈ Set.range (PrimeSpectrum.comap φ_D_Ω) := by
    intro A _ _ 𝒟'_A _ _ φ_hom h_commA hEtDA
    let φ_D_A : TensorProduct B₀ A R →ₐ[A] 𝒟'_A :=
      { toRingHom := φ_hom
        commutes' := h_commA }
    let D_A := TensorProduct B₀ A R
    letI : Algebra D_A 𝒟'_A := φ_D_A.toRingHom.toAlgebra
    haveI : Algebra.Etale D_A 𝒟'_A := RingHom.etale_algebraMap.mp hEtDA
    have hOpenRange : IsOpen (Set.range (PrimeSpectrum.comap φ_hom)) := by
      rw [← Set.image_univ]
      exact @PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
        D_A 𝒟'_A _ _ _ inferInstance inferInstance Set.univ isOpen_univ
    let O_A : TopologicalSpace.Opens (PrimeSpectrum D_A) :=
      ⟨Set.range (PrimeSpectrum.comap φ_hom), hOpenRange⟩
    refine ⟨O_A, fun p' => ⟨p', rfl⟩, ?_⟩
    intro Ω _ _ _ _
    obtain ⟨Φ_AΩ, hΦ_comp, hΦ_symm⟩ := hCancelEquiv A Ω 𝒟'_A φ_D_A
    let D_Ω := TensorProduct B₀ Ω R
    let φ_AΩ : D_A →+* D_Ω :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom B₀ A Ω) (AlgHom.id B₀ R)).toRingHom
    letI : Algebra D_A D_Ω := φ_AΩ.toAlgebra
    haveI : Algebra.Etale D_Ω (TensorProduct D_A D_Ω 𝒟'_A) := inferInstance
    let φ_D_Ω : D_Ω →+* TensorProduct A Ω 𝒟'_A :=
      Φ_AΩ.toRingHom.comp (algebraMap D_Ω (TensorProduct D_A D_Ω 𝒟'_A))
    have hEt_Ω : φ_D_Ω.Etale := by
      have hEt_inc : (algebraMap D_Ω (TensorProduct D_A D_Ω 𝒟'_A)).Etale :=
        RingHom.etale_algebraMap.mpr inferInstance
      exact RingHom.Etale.respectsIso.left _ Φ_AΩ hEt_inc
    have hω : ∀ ω : Ω, φ_D_Ω (algebraMap Ω D_Ω ω) = ω ⊗ₜ[A] (1 : 𝒟'_A) := by
      intro ω
      have h_eq := RingHom.congr_fun hΦ_comp (algebraMap Ω D_Ω ω)
      have h_rhs : ((Algebra.TensorProduct.map (AlgHom.id A Ω) φ_D_A).toRingHom.comp
          (Algebra.TensorProduct.cancelBaseChange B₀ A Ω Ω R).symm.toRingHom) (algebraMap Ω D_Ω ω) =
          ω ⊗ₜ[A] (1 : 𝒟'_A) := by
        change (Algebra.TensorProduct.map (AlgHom.id A Ω) φ_D_A)
          ((Algebra.TensorProduct.cancelBaseChange B₀ A Ω Ω R).symm (ω ⊗ₜ[B₀] (1 : R))) = _
        rw [Algebra.TensorProduct.cancelBaseChange_symm_tmul, Algebra.TensorProduct.map_tmul]
        change ω ⊗ₜ[A] φ_D_A (1 : D_A) = _
        rw [map_one]
      exact h_eq.trans h_rhs
    refine ⟨φ_D_Ω, hEt_Ω, hω, ?_⟩
    intro q_Ω hq_mem
    obtain ⟨p', hp'⟩ := hq_mem
    let p_A : PrimeSpectrum D_A := PrimeSpectrum.comap φ_AΩ q_Ω
    haveI : p_A.asIdeal.IsPrime := p_A.isPrime
    haveI : q_Ω.asIdeal.IsPrime := q_Ω.isPrime
    haveI : p'.asIdeal.IsPrime := p'.isPrime
    let k₀ := p_A.asIdeal.ResidueField
    let k₁ := q_Ω.asIdeal.ResidueField
    let k₂ := p'.asIdeal.ResidueField
    let i₁ : k₀ →+* k₁ := Ideal.ResidueField.map p_A.asIdeal q_Ω.asIdeal φ_AΩ rfl
    let i₂ : k₀ →+* k₂ :=
      Ideal.ResidueField.map p_A.asIdeal p'.asIdeal φ_D_A.toRingHom
        (congrArg PrimeSpectrum.asIdeal hp'.symm)
    letI : Algebra k₀ k₁ := i₁.toAlgebra
    letI : Algebra k₀ k₂ := i₂.toAlgebra
    haveI : Nontrivial (TensorProduct k₀ k₁ k₂) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain k₀ k₁ k₂
        (RingHom.injective (algebraMap k₀ k₁)) (RingHom.injective (algebraMap k₀ k₂))
    obtain ⟨𝔪, h𝔪_max⟩ := Ideal.exists_maximal (TensorProduct k₀ k₁ k₂)
    letI : Field (TensorProduct k₀ k₁ k₂ ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    let Q_T : PrimeSpectrum (TensorProduct k₀ k₁ k₂) := ⟨𝔪, h𝔪_max.isPrime⟩
    let inc_k₁ : D_Ω →+* TensorProduct k₀ k₁ k₂ :=
      { toFun := fun x_Ω => (algebraMap D_Ω k₁ x_Ω) ⊗ₜ[k₀] (1 : k₂)
        map_one' := by rw [map_one]; rfl
        map_mul' := fun x y => by rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [map_zero, TensorProduct.zero_tmul]
        map_add' := fun x y => by rw [map_add, TensorProduct.add_tmul] }
    let inc_k₂ : 𝒟'_A →+* TensorProduct k₀ k₁ k₂ :=
      { toFun := fun d' => (1 : k₁) ⊗ₜ[k₀] (algebraMap 𝒟'_A k₂ d')
        map_one' := by rw [map_one]; rfl
        map_mul' := fun x y => by rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        map_zero' := by rw [map_zero, TensorProduct.tmul_zero]
        map_add' := fun x y => by rw [map_add, TensorProduct.tmul_add] }
    obtain ⟨Λ_hom, hΛ_tmul⟩ := hTensorRingHom (R₀ := D_A) inc_k₁ inc_k₂
      (fun x_A => by
        change (algebraMap D_Ω k₁ (φ_AΩ x_A)) ⊗ₜ[k₀] (1 : k₂) =
          (1 : k₁) ⊗ₜ[k₀] (algebraMap 𝒟'_A k₂ (φ_D_A x_A))
        have h1 : algebraMap D_Ω k₁ (φ_AΩ x_A) = i₁ (algebraMap D_A k₀ x_A) :=
          (Ideal.ResidueField.map_algebraMap p_A.asIdeal q_Ω.asIdeal φ_AΩ rfl x_A).symm
        have h2 : algebraMap 𝒟'_A k₂ (φ_D_A x_A) = i₂ (algebraMap D_A k₀ x_A) :=
          (Ideal.ResidueField.map_algebraMap p_A.asIdeal p'.asIdeal φ_D_A.toRingHom
            (congrArg PrimeSpectrum.asIdeal hp'.symm) x_A).symm
        rw [h1, h2]
        change (algebraMap k₀ k₁ (algebraMap D_A k₀ x_A)) ⊗ₜ[k₀] (1 : k₂) =
          (1 : k₁) ⊗ₜ[k₀] (algebraMap k₀ k₂ (algebraMap D_A k₀ x_A))
        rw [Algebra.algebraMap_eq_smul_one (R := k₀) (A := k₁),
          Algebra.algebraMap_eq_smul_one (R := k₀) (A := k₂),
          TensorProduct.smul_tmul])
    let q'_Ω : PrimeSpectrum (TensorProduct A Ω 𝒟'_A) :=
      PrimeSpectrum.comap (Λ_hom.comp Φ_AΩ.symm.toRingHom) Q_T
    refine ⟨q'_Ω, ?_⟩
    apply PrimeSpectrum.ext
    ext x
    let ψ₁ : k₁ →+* (TensorProduct k₀ k₁ k₂ ⧸ 𝔪) :=
      (Ideal.Quotient.mk 𝔪).comp
        (Algebra.TensorProduct.includeLeft : k₁ →ₐ[k₀] TensorProduct k₀ k₁ k₂).toRingHom
    have hψ₁_inj : Function.Injective ψ₁ := RingHom.injective ψ₁
    have hx_eval : (Λ_hom.comp Φ_AΩ.symm.toRingHom) (φ_D_Ω x) = (algebraMap D_Ω k₁ x) ⊗ₜ[k₀] (1 : k₂) := by
      change Λ_hom (Φ_AΩ.symm (Φ_AΩ (x ⊗ₜ[D_A] (1 : 𝒟'_A)))) = _
      rw [Φ_AΩ.symm_apply_apply, hΛ_tmul, map_one, mul_one]
      rfl
    change (Λ_hom.comp Φ_AΩ.symm.toRingHom) (φ_D_Ω x) ∈ 𝔪 ↔ x ∈ q_Ω.asIdeal
    rw [hx_eval, ← Ideal.Quotient.eq_zero_iff_mem]
    change ψ₁ (algebraMap D_Ω k₁ x) = 0 ↔ x ∈ q_Ω.asIdeal
    rw [map_eq_zero_iff ψ₁ hψ₁_inj, Ideal.algebraMap_residueField_eq_zero]

  
  
  
