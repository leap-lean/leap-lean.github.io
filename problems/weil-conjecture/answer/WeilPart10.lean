        CategoryTheory.Limits.pullback.lift u (𝟙 _)
          (by rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp])
      exact isEmptyElim (v.base pt)

  have hTwoSecCompl :
      ∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
        (C_R P_R Z : AlgebraicGeometry.Scheme.{u})
        (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (p_P : P_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (ι_P : P_R ⟶ C_R)
        (ι_Z : Z ⟶ C_R)
        (p₁ p₂ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ P_R)
        [AlgebraicGeometry.IsProper g_R]
        [AlgebraicGeometry.IsProper p_P]
        [AlgebraicGeometry.LocallyOfFinitePresentation p_P]
        [AlgebraicGeometry.IsClosedImmersion ι_P]
        [AlgebraicGeometry.IsClosedImmersion ι_Z],
      ι_P ≫ g_R = p_P →
      p₁ ≫ p_P = 𝟙 _ →
      p₂ ≫ p_P = 𝟙 _ →
      ∃ (W_loc : AlgebraicGeometry.Scheme.{u})
        (q_W : W_loc ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
        AlgebraicGeometry.QuasiCompact q_W ∧
        ∀ (Ω : Type u) [Field Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
          IsEmpty ↥(CategoryTheory.Limits.pullback q_W s) ↔
            ∀ q : ↥(CategoryTheory.Limits.pullback g_R s),
              q ∈ Set.range (CategoryTheory.Limits.pullback.snd ι_P
                    (CategoryTheory.Limits.pullback.fst g_R s)).base →
              q ∈ Set.range (CategoryTheory.Limits.pullback.snd ι_Z
                    (CategoryTheory.Limits.pullback.fst g_R s)).base →
              (CategoryTheory.Limits.pullback.fst g_R s).base q ∈
                Set.range (p₁ ≫ ι_P).base ∪ Set.range (p₂ ≫ ι_P).base := by
    intro R _ _ C_R P_R Z g_R p_P ι_P ι_Z p₁ p₂ _ _ _ _ _ hCompP hp₁ hp₂
    have : AlgebraicGeometry.IsClosedImmersion p₁ := (hSepSec P_R _ p_P p₁ hp₁).1
    have : AlgebraicGeometry.IsClosedImmersion p₂ := (hSepSec P_R _ p_P p₂ hp₂).1
    have hCl₁ : IsClosed (Set.range p₁.base) :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding p₁).isClosed_range
    have hCl₂ : IsClosed (Set.range p₂.base) :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding p₂).isClosed_range
    let U_compl : P_R.Opens := ⟨(Set.range p₁.base ∪ Set.range p₂.base)ᶜ, (hCl₁.union hCl₂).isOpen_compl⟩
    let W_loc := CategoryTheory.Limits.pullback (U_compl.ι ≫ ι_P) ι_Z
    let fst_W := CategoryTheory.Limits.pullback.fst (U_compl.ι ≫ ι_P) ι_Z
    let snd_W := CategoryTheory.Limits.pullback.snd (U_compl.ι ≫ ι_P) ι_Z
    let q_W : W_loc ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) := fst_W ≫ U_compl.ι ≫ p_P
    have : AlgebraicGeometry.IsLocallyNoetherian P_R :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_P
    have : CompactSpace ↥P_R :=
      (AlgebraicGeometry.quasiCompact_iff_compactSpace p_P).mp inferInstance
    have : AlgebraicGeometry.IsNoetherian P_R := AlgebraicGeometry.IsNoetherian.mk
    have hCompU : CompactSpace ↥U_compl.toScheme :=
      isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (U_compl : Set ↥P_R))
    have : AlgebraicGeometry.QuasiCompact (U_compl.ι ≫ p_P) :=
      (AlgebraicGeometry.quasiCompact_iff_compactSpace (U_compl.ι ≫ p_P)).mpr hCompU
    refine ⟨W_loc, q_W, inferInstance, ?_⟩
    intro Ω _ s
    let fst_C := CategoryTheory.Limits.pullback.fst g_R s
    let snd_C := CategoryTheory.Limits.pullback.snd g_R s
    let π_P := CategoryTheory.Limits.pullback.fst ι_P fst_C
    let ι_P_Ω := CategoryTheory.Limits.pullback.snd ι_P fst_C
    let π_Z := CategoryTheory.Limits.pullback.fst ι_Z fst_C
    let ι_Z_Ω := CategoryTheory.Limits.pullback.snd ι_Z fst_C
    constructor
    · intro hEmp q ⟨y_P, hy_P⟩ ⟨y_Z, hy_Z⟩
      by_contra hNotMem
      have hy_in_U : π_P.base y_P ∈ U_compl := by
        intro hInP
        apply hNotMem
        have h_eq : fst_C.base q = ι_P.base (π_P.base y_P) := by
          rw [← hy_P]
          change (ι_P_Ω ≫ fst_C).base y_P = (π_P ≫ ι_P).base y_P
          rw [CategoryTheory.Limits.pullback.condition]
        rw [h_eq]
        rcases hInP with ⟨b, hb⟩ | ⟨b, hb⟩
        · exact Or.inl ⟨b, by rw [← hb]; rfl⟩
        · exact Or.inr ⟨b, by rw [← hb]; rfl⟩
      let U_Ω : (CategoryTheory.Limits.pullback ι_P fst_C).Opens := π_P ⁻¹ᵁ U_compl
      let u_P : ↥U_Ω.toScheme := ⟨y_P, hy_in_U⟩
      have hu_eq : (U_Ω.ι ≫ ι_P_Ω).base u_P = ι_Z_Ω.base y_Z := by
        change ι_P_Ω.base y_P = ι_Z_Ω.base y_Z
        rw [hy_P, hy_Z]
      obtain ⟨x', _, _⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω) u_P y_Z hu_eq
      let α_W : CategoryTheory.Limits.pullback (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ⟶ W_loc :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
            AlgebraicGeometry.Scheme.Hom.resLE π_P U_compl U_Ω le_rfl)
          (CategoryTheory.Limits.pullback.snd (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫ π_Z)
          (by
            calc
              (CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                  AlgebraicGeometry.Scheme.Hom.resLE π_P U_compl U_Ω le_rfl) ≫
                  (U_compl.ι ≫ ι_P)
                = CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    (AlgebraicGeometry.Scheme.Hom.resLE π_P U_compl U_Ω le_rfl ≫ U_compl.ι) ≫ ι_P := by
                    simp only [CategoryTheory.Category.assoc]
              _ = CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    U_Ω.ι ≫ (π_P ≫ ι_P) := by
                    rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
                    simp only [CategoryTheory.Category.assoc]
              _ = (CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    (U_Ω.ι ≫ ι_P_Ω)) ≫ fst_C := by
                    rw [CategoryTheory.Limits.pullback.condition]
                    simp only [ι_P_Ω, CategoryTheory.Category.assoc]
              _ = CategoryTheory.Limits.pullback.snd (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    (ι_Z_Ω ≫ fst_C) := by
                    rw [CategoryTheory.Limits.pullback.condition]
                    simp only [CategoryTheory.Category.assoc]
              _ = (CategoryTheory.Limits.pullback.snd (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫ π_Z) ≫ ι_Z := by
                    rw [← CategoryTheory.Limits.pullback.condition]
                    simp only [π_Z, CategoryTheory.Category.assoc])
      let ν : CategoryTheory.Limits.pullback (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ⟶
          CategoryTheory.Limits.pullback q_W s :=
        CategoryTheory.Limits.pullback.lift α_W
          (CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫ U_Ω.ι ≫ ι_P_Ω ≫ snd_C)
          (by
            calc
              α_W ≫ q_W
                = (α_W ≫ fst_W) ≫ U_compl.ι ≫ p_P := by simp only [q_W, CategoryTheory.Category.assoc]
              _ = CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    (AlgebraicGeometry.Scheme.Hom.resLE π_P U_compl U_Ω le_rfl ≫ U_compl.ι) ≫
                    (ι_P ≫ g_R) := by
                    rw [CategoryTheory.Limits.pullback.lift_fst, ← hCompP]
                    simp only [CategoryTheory.Category.assoc]
              _ = CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    U_Ω.ι ≫ (π_P ≫ ι_P) ≫ g_R := by
                    rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
                    simp only [CategoryTheory.Category.assoc]
              _ = CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    U_Ω.ι ≫ ι_P_Ω ≫ (fst_C ≫ g_R) := by
                    rw [CategoryTheory.Limits.pullback.condition]
                    simp only [ι_P_Ω, CategoryTheory.Category.assoc]
              _ = (CategoryTheory.Limits.pullback.fst (U_Ω.ι ≫ ι_P_Ω) ι_Z_Ω ≫
                    U_Ω.ι ≫ ι_P_Ω ≫ snd_C) ≫ s := by
                    rw [CategoryTheory.Limits.pullback.condition]
                    simp only [snd_C, CategoryTheory.Category.assoc])
      exact isEmptyElim (ν.base x')
    · intro hSub
      refine ⟨fun x => ?_⟩
      let w_W := CategoryTheory.Limits.pullback.fst q_W s
      let s_W := CategoryTheory.Limits.pullback.snd q_W s
      let μ_Y : CategoryTheory.Limits.pullback q_W s ⟶ CategoryTheory.Limits.pullback g_R s :=
        CategoryTheory.Limits.pullback.lift (w_W ≫ fst_W ≫ U_compl.ι ≫ ι_P) s_W
          (by rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                CategoryTheory.Category.assoc, hCompP]
              exact CategoryTheory.Limits.pullback.condition)
      let μ_P : CategoryTheory.Limits.pullback q_W s ⟶ CategoryTheory.Limits.pullback ι_P fst_C :=
        CategoryTheory.Limits.pullback.lift (w_W ≫ fst_W ≫ U_compl.ι) μ_Y
          (by rw [CategoryTheory.Limits.pullback.lift_fst]; simp only [CategoryTheory.Category.assoc])
      let μ_Z : CategoryTheory.Limits.pullback q_W s ⟶ CategoryTheory.Limits.pullback ι_Z fst_C :=
        CategoryTheory.Limits.pullback.lift (w_W ≫ snd_W) μ_Y
          (by rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
                ← CategoryTheory.Limits.pullback.condition (f := U_compl.ι ≫ ι_P) (g := ι_Z)])
      let q := μ_Y.base x
      have hqP : q ∈ Set.range ι_P_Ω.base := ⟨μ_P.base x, by
        change (μ_P ≫ ι_P_Ω).base x = μ_Y.base x
        rw [CategoryTheory.Limits.pullback.lift_snd]⟩
      have hqZ : q ∈ Set.range ι_Z_Ω.base := ⟨μ_Z.base x, by
        change (μ_Z ≫ ι_Z_Ω).base x = μ_Y.base x
        rw [CategoryTheory.Limits.pullback.lift_snd]⟩
      have hMem := hSub q hqP hqZ
      let u₀ : ↥U_compl.toScheme := (w_W ≫ fst_W).base x
      have h_fst_q : fst_C.base q = ι_P.base (U_compl.ι.base u₀) := by
        change (μ_Y ≫ fst_C).base x = ι_P.base (U_compl.ι.base ((w_W ≫ fst_W).base x))
        rw [CategoryTheory.Limits.pullback.lift_fst]
        rfl
      rw [h_fst_q] at hMem
      have hInjP := (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_P).injective
      rcases hMem with ⟨b, hb⟩ | ⟨b, hb⟩
      · exact u₀.2 (Or.inl ⟨b, hInjP hb⟩)
      · exact u₀.2 (Or.inr ⟨b, hInjP hb⟩)

  have hPastePullbackIso : ∀ {C₁ S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (g₁ : C₁ ⟶ S₁) (f₁ : S₂ ⟶ S₁) (f₂ : S₃ ⟶ S₂) (f₁₃ : S₃ ⟶ S₁),
      f₂ ≫ f₁ = f₁₃ →
      ∃ e : CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd g₁ f₁) f₂ ≅
          CategoryTheory.Limits.pullback g₁ f₁₃,
        e.hom ≫ CategoryTheory.Limits.pullback.fst g₁ f₁₃ =
          CategoryTheory.Limits.pullback.fst _ f₂ ≫ CategoryTheory.Limits.pullback.fst g₁ f₁ ∧
        e.hom ≫ CategoryTheory.Limits.pullback.snd g₁ f₁₃ =
          CategoryTheory.Limits.pullback.snd _ f₂ := by
    intro C₁ S₁ S₂ S₃ g₁ f₁ f₂ f₁₃ hf
    have hPb : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd g₁ f₁) f₂ ≫
          CategoryTheory.Limits.pullback.fst g₁ f₁)
        (CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd g₁ f₁) f₂)
        g₁ f₁₃ := by
      rw [← hf]
      exact (CategoryTheory.IsPullback.of_hasPullback _ f₂).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback g₁ f₁)
    exact ⟨hPb.isoPullback, hPb.isoPullback_hom_fst, hPb.isoPullback_hom_snd⟩

  obtain ⟨R_of, ψ_of, hSub_of, hι_comp_ψ, hFT_of, hSecDesc, hIsoDesc, hEmpDesc⟩ :=
    weil_domain_adjoin_proper_iso_and_empty_descent B K_bar ι_B

  let ι_of : ∀ S : Finset K_bar, ↥(R_of S) →+* K_bar :=
    fun S => (R_of S).subtype
  have hInc_comp_ψ : ∀ {S_a S_b : Finset K_bar} (h : R_of S_a ≤ R_of S_b),
      (Subring.inclusion h).comp (ψ_of S_a) = ψ_of S_b := by
    intro S_a S_b h
    ext b
    exact (RingHom.congr_fun (hι_comp_ψ S_a) b).trans (RingHom.congr_fun (hι_comp_ψ S_b) b).symm
  have hι_comp_inc : ∀ {S_a S_b : Finset K_bar} (h : R_of S_a ≤ R_of S_b),
      (ι_of S_b).comp (Subring.inclusion h) = (R_of S_a).subtype :=
    fun _ => RingHom.ext fun _ => rfl
  have hInc_comp_inc : ∀ {S_a S_b S_c : Finset K_bar}
      (h₁ : R_of S_a ≤ R_of S_b) (h₂ : R_of S_b ≤ R_of S_c),
      (Subring.inclusion h₂).comp (Subring.inclusion h₁) = Subring.inclusion (h₁.trans h₂) :=
    fun _ _ => RingHom.ext fun _ => rfl
  have hNoeth_of : ∀ S : Finset K_bar, IsNoetherianRing ↥(R_of S) := by
    intro S
    let _ : Algebra B ↥(R_of S) := (ψ_of S).toAlgebra
    have : Algebra.FiniteType B ↥(R_of S) := hFT_of S
    exact Algebra.FiniteType.isNoetherianRing B ↥(R_of S)

  have hEmpMono : ∀ {A₁ A₂ A₃ : Type u} [CommRing A₁] [CommRing A₂] [CommRing A₃]
      {Z : AlgebraicGeometry.Scheme.{u}}
      (q : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of A₁))
      (f₁₂ : AlgebraicGeometry.Spec (CommRingCat.of A₂) ⟶ AlgebraicGeometry.Spec (CommRingCat.of A₁))
      (f₂₃ : AlgebraicGeometry.Spec (CommRingCat.of A₃) ⟶ AlgebraicGeometry.Spec (CommRingCat.of A₂)),
      IsEmpty ↥(CategoryTheory.Limits.pullback q f₁₂) →
      IsEmpty ↥(CategoryTheory.Limits.pullback q (f₂₃ ≫ f₁₂)) := by
    intro A₁ A₂ A₃ _ _ _ Z q f₁₂ f₂₃ hEmp
    refine ⟨fun z => ?_⟩
    let π := CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst q (f₂₃ ≫ f₁₂))
      (CategoryTheory.Limits.pullback.snd q (f₂₃ ≫ f₁₂) ≫ f₂₃)
      (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
    exact isEmptyElim (π.base z)

  let s_B_gen := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)
  let fst_gen := CategoryTheory.Limits.pullback.fst g_B s_B_gen
  let snd_gen := CategoryTheory.Limits.pullback.snd g_B s_B_gen
  let ι_gen : ∀ i : Fin c,
      CategoryTheory.Limits.pullback (ι_ℰ i) fst_gen ⟶
        CategoryTheory.Limits.pullback g_B s_B_gen :=
    fun i => CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_gen
  let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_bar)) := ⟨⊥, inferInstance⟩

  have : AlgebraicGeometry.IsProper g_B := hProp
  have : AlgebraicGeometry.IsSeparated g_B := inferInstance
  have hCl_ℰ : ∀ i : Fin c, AlgebraicGeometry.IsClosedImmersion (ι_ℰ i) := fun i => (hComp i).2.2.1
  have hProp_ℰ : ∀ i : Fin c, AlgebraicGeometry.IsProper (p_ℰ i) := fun i => (hComp i).1
  have hLFP_ℰ : ∀ i : Fin c, AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ i) :=
    fun i => (hComp i).2.1

  have hRangeSubClosure : ∀ (i : Fin c)
      (e : CategoryTheory.Limits.pullback (ι_ℰ i) fst_gen ≅ P1_obj K_bar)
      (z : ↥(CategoryTheory.Limits.pullback (ι_ℰ i) fst_gen)),
      closure ({e.hom.base z} : Set ↥(P1_obj K_bar)) = Set.univ →
      Set.range (ι_gen i).base ⊆
        closure ({(ι_gen i).base z} : Set ↥(CategoryTheory.Limits.pullback g_B s_B_gen)) := by
    rintro i e z hUniv _ ⟨x, rfl⟩
    have hxz : x ∈ closure ({z} : Set ↥(CategoryTheory.Limits.pullback (ι_ℰ i) fst_gen)) := by
      have hx_im : e.hom.base x ∈ closure ({e.hom.base z} : Set ↥(P1_obj K_bar)) := by
        rw [hUniv]; trivial
      have himg := image_closure_subset_closure_image e.inv.continuous ⟨e.hom.base x, hx_im, rfl⟩
      rw [Set.image_singleton] at himg
      have hxx : e.inv.base (e.hom.base x) = x := by
        change (e.hom ≫ e.inv).base x = x; rw [e.hom_inv_id]; rfl
      have hzz : e.inv.base (e.hom.base z) = z := by
        change (e.hom ≫ e.inv).base z = z; rw [e.hom_inv_id]; rfl
      rwa [hxx, hzz] at himg
    have himg2 := image_closure_subset_closure_image (ι_gen i).continuous ⟨x, hxz, rfl⟩
    rwa [Set.image_singleton] at himg2

  let _ : DecidableEq K_bar := Classical.decEq K_bar

  have hPosConj : HasStableP1 K_bar s_B_gen →
      ∃ (B' : Type u) (_ : CommRing B') (_ : IsDomain B')
        (ψ' : B →+* B') (ι_B' : B' →+* K_bar),
        RingHom.FiniteType ψ' ∧
        ι_B'.comp ψ' = ι_B ∧
        Function.Injective ι_B' ∧
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s_B' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of B')),
          HasStableP1 Ω
            (s_B' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ')) := by
    intro hGoodGen
    let IsP1Gen : Fin c → Prop := fun i =>
      ∃ isoP1 : CategoryTheory.Limits.pullback (ι_ℰ i) fst_gen ≅ P1_obj K_bar,
        ι_gen i ≫ snd_gen = isoP1.hom ≫ P1_hom K_bar
    let _ : DecidablePred IsP1Gen := Classical.decPred IsP1Gen

    have hPerCompPos : ∀ (i : Fin c), IsP1Gen i →
        ∃ (S_i : Finset K_bar),
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
            (S_big : Finset K_bar) (_ : S_i ⊆ S_big)
            (s_big : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
              AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S_big))),
            let s_B := s_big ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S_big))
            let E_Ω_i := Set.range (CategoryTheory.Limits.pullback.snd (ι_ℰ i)
              (CategoryTheory.Limits.pullback.fst g_B s_B)).base
            ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g_B s_B),
              q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
              q₁ ∈ E_Ω_i ∧ q₂ ∈ E_Ω_i ∧ q₃ ∈ E_Ω_i ∧
              ∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g_B s_B)),
                (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B),
                  E' ≠ E_Ω_i ∧ q ∈ E') ∨
                (∃ j : Fin n,
                  (CategoryTheory.Limits.pullback.fst g_B s_B).base q ∈ Set.range (τ_B j).base) := by
      intro i ⟨isoP1, hisoP1⟩
      have hFibK := hFib K_bar s_B_gen
      have hEi_mem : Set.range (ι_gen i).base ∈
          irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B_gen) := by
        rw [hFibK.2.2.2.2]; exact ⟨i, rfl⟩
      have : AlgebraicGeometry.IsClosedImmersion (ι_ℰ i) := hCl_ℰ i
      obtain ⟨q₀, q₁, q₂, hq01, hq02, hq12, hq0E, hq1E, hq2E, hqSpec⟩ :=
        hGoodGen.2.2 (Set.range (ι_gen i).base) _ (ι_gen i)
          hEi_mem inferInstance (hFibK.2.2.1 i) rfl ⟨isoP1, hisoP1⟩
      let q_vec : Fin 3 → ↥(CategoryTheory.Limits.pullback g_B s_B_gen)
        | ⟨0, _⟩ => q₀
        | ⟨1, _⟩ => q₁
        | ⟨_ + 2, _⟩ => q₂
      have hq_ne : ∀ a b : Fin 3, a ≠ b → q_vec a ≠ q_vec b := by
        rintro ⟨_ | _ | _ | a, ha⟩ ⟨_ | _ | _ | b, hb⟩ hab
        · exact False.elim (hab rfl)
        · exact hq01
        · exact hq02
        · omega
        · exact hq01.symm
        · exact False.elim (hab rfl)
        · exact hq12
        · omega
        · exact hq02.symm
        · exact hq12.symm
        · exact False.elim (hab rfl)
        · omega
        · omega
        · omega
        · omega
        · omega
      have hq_inE : ∀ a : Fin 3, q_vec a ∈ Set.range (ι_gen i).base := by
        rintro ⟨_ | _ | _ | a, ha⟩
        · exact hq0E
        · exact hq1E
        · exact hq2E
        · omega
      have hq_sp : ∀ a : Fin 3,
          (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B_gen),
            E' ≠ Set.range (ι_gen i).base ∧ q_vec a ∈ E') ∨
          (∃ j : Fin n, fst_gen.base (q_vec a) ∈ Set.range (τ_B j).base) := by
        rintro ⟨_ | _ | _ | a, ha⟩
        · exact hqSpec q₀ (Or.inl rfl)
        · exact hqSpec q₁ (Or.inr (Or.inl rfl))
        · exact hqSpec q₂ (Or.inr (Or.inr rfl))
        · omega

      have hSpreadPt : ∀ a : Fin 3,
          ∃ (S_a : Finset K_bar)
            (η_a : AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S_a)) ⟶ ℰ i),
            η_a ≫ p_ℰ i = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S_a)) ∧
            (∀ ξ' : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
                CategoryTheory.Limits.pullback g_B s_B_gen,
              ξ' ≫ fst_gen = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S_a)) ≫ η_a ≫ ι_ℰ i →
              ξ' ≫ snd_gen = 𝟙 _ →
              ξ'.base pt_K = q_vec a) ∧
            ((∃ (i' : Fin c) (η'_a : AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S_a)) ⟶ ℰ i'),
                i' ≠ i ∧ η'_a ≫ ι_ℰ i' = η_a ≫ ι_ℰ i) ∨
             (∃ j : Fin n, η_a ≫ ι_ℰ i =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S_a)) ≫ τ_B j)) := by
        intro a
        obtain ⟨z_a, hz_a⟩ := hq_inE a
        rcases hq_sp a with ⟨E', hE'_mem, hE'_ne, hqa_E'⟩ | ⟨j, hqa_sec⟩
        · have hE'_eq := hE'_mem
          rw [hFibK.2.2.2.2] at hE'_eq
          obtain ⟨i', rfl⟩ := hE'_eq
          have hi'_ne : i' ≠ i := fun hEq => hE'_ne (by rw [hEq])
          have hNotUniv :
              closure ({isoP1.hom.base z_a} : Set ↥(P1_obj K_bar)) ≠
                Set.univ := by
            intro hUniv
            have hSubCl := hRangeSubClosure i isoP1 z_a hUniv
            rw [hz_a] at hSubCl
            have hClE' : IsClosed (Set.range (ι_gen i').base) :=
              isClosed_of_mem_irreducibleComponents _ hE'_mem
            have hSubE' : Set.range (ι_gen i).base ⊆ Set.range (ι_gen i').base :=
              hSubCl.trans (closure_minimal (Set.singleton_subset_iff.mpr hqa_E') hClE')
            exact hE'_ne (Set.Subset.antisymm hSubE' (hEi_mem.2 hE'_mem.1 hSubE')).symm
          obtain ⟨σ_w, hσ_w_hom, hσ_w_pt⟩ := (hP1Pts K_bar).2 (isoP1.hom.base z_a) hNotUniv
          let η_K := σ_w ≫ isoP1.inv
          let ξ_a := η_K ≫ ι_gen i
          have hξ_snd : ξ_a ≫ snd_gen = 𝟙 _ := by
            dsimp only [ξ_a, η_K]
            rw [CategoryTheory.Category.assoc (σ_w ≫ isoP1.inv), hisoP1,
              CategoryTheory.Category.assoc, isoP1.inv_hom_id_assoc, hσ_w_hom]
          have hξ_pt : ξ_a.base pt_K = q_vec a := by
            have h1 : (σ_w ≫ isoP1.inv).base pt_K = z_a := by
              change isoP1.inv.base (σ_w.base pt_K) = z_a
              rw [hσ_w_pt pt_K]
              change (isoP1.hom ≫ isoP1.inv).base z_a = z_a
              rw [isoP1.hom_inv_id]; rfl
            change (ι_gen i).base ((σ_w ≫ isoP1.inv).base pt_K) = q_vec a
            rw [h1, hz_a]
          let u_i := η_K ≫ CategoryTheory.Limits.pullback.fst (ι_ℰ i) fst_gen
          have hu_i_comp : u_i ≫ ι_ℰ i = ξ_a ≫ fst_gen := by
            simp only [u_i, ξ_a, ι_gen, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition]
          have : AlgebraicGeometry.IsClosedImmersion (ι_ℰ i') := hCl_ℰ i'
          have hRange_u : Set.range (u_i ≫ ι_ℰ i).base ⊆ Set.range (ι_ℰ i').base := by
            rintro _ ⟨pt, rfl⟩
            obtain ⟨z'_a, hz'_a⟩ := hqa_E'
            refine ⟨(CategoryTheory.Limits.pullback.fst (ι_ℰ i') fst_gen).base z'_a, ?_⟩
            rw [Subsingleton.elim pt pt_K]
            calc
              (ι_ℰ i').base ((CategoryTheory.Limits.pullback.fst (ι_ℰ i') fst_gen).base z'_a)
                = (CategoryTheory.Limits.pullback.fst (ι_ℰ i') fst_gen ≫ ι_ℰ i').base z'_a := rfl
              _ = (ι_gen i' ≫ fst_gen).base z'_a := by
                    rw [CategoryTheory.Limits.pullback.condition]
              _ = fst_gen.base (q_vec a) := by
                    change fst_gen.base ((ι_gen i').base z'_a) = fst_gen.base (q_vec a)
                    rw [hz'_a]
              _ = (ξ_a ≫ fst_gen).base pt_K := by
                    change fst_gen.base (q_vec a) = fst_gen.base (ξ_a.base pt_K)
                    rw [hξ_pt]
              _ = (u_i ≫ ι_ℰ i).base pt_K := by rw [hu_i_comp]
          obtain ⟨u_i', hu_i'⟩ := hRedLift (ℰ i') _ C_B (ι_ℰ i') (u_i ≫ ι_ℰ i) hRange_u
          let P_ii' := CategoryTheory.Limits.pullback (ι_ℰ i) (ι_ℰ i')
          let f_ii' : P_ii' ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
            CategoryTheory.Limits.pullback.fst (ι_ℰ i) (ι_ℰ i') ≫ p_ℰ i
          have : AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ i) := hLFP_ℰ i
          have : AlgebraicGeometry.LocallyOfFiniteType f_ii' := inferInstance
          let u_ii' : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ P_ii' :=
            CategoryTheory.Limits.pullback.lift u_i u_i' hu_i'.symm
          have hu_ii'_f : u_ii' ≫ f_ii' = s_B_gen := by
            dsimp only [u_ii', f_ii']
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← (hComp i).2.2.2, ← CategoryTheory.Category.assoc, hu_i_comp,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              ← CategoryTheory.Category.assoc, hξ_snd, CategoryTheory.Category.id_comp]
          obtain ⟨S_a, u_S, _, hu_S_f, hu_S_K⟩ := hSecDesc P_ii' f_ii' ∅ u_ii' hu_ii'_f
          let η_a := u_S ≫ CategoryTheory.Limits.pullback.fst (ι_ℰ i) (ι_ℰ i')
          let η'_a := u_S ≫ CategoryTheory.Limits.pullback.snd (ι_ℰ i) (ι_ℰ i')
          refine ⟨S_a, η_a, ?_, ?_, Or.inl ⟨i', η'_a, hi'_ne, ?_⟩⟩
          · dsimp only [η_a]
            rw [CategoryTheory.Category.assoc]
            exact hu_S_f
          · intro ξ' hξ'_fst hξ'_snd
            have hξ'_eq : ξ' = ξ_a := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [hξ'_fst, ← hu_i_comp]
                calc
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S_a)) ≫ η_a ≫ ι_ℰ i
                    = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S_a)) ≫ u_S) ≫
                        CategoryTheory.Limits.pullback.fst (ι_ℰ i) (ι_ℰ i') ≫ ι_ℰ i := by
                        simp only [η_a, CategoryTheory.Category.assoc]
                  _ = (u_ii' ≫ CategoryTheory.Limits.pullback.fst (ι_ℰ i) (ι_ℰ i')) ≫ ι_ℰ i := by
                        dsimp only [ι_of]
                        rw [hu_S_K, CategoryTheory.Category.assoc]
                  _ = u_i ≫ ι_ℰ i := by rw [CategoryTheory.Limits.pullback.lift_fst]
              · rw [hξ'_snd, hξ_snd]
            rw [hξ'_eq, hξ_pt]
          · dsimp only [η_a, η'_a]
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
              CategoryTheory.Category.assoc]
        · let σ_gen_j : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
              CategoryTheory.Limits.pullback g_B s_B_gen :=
            CategoryTheory.Limits.pullback.lift (s_B_gen ≫ τ_B j) (𝟙 _)
              (by rw [CategoryTheory.Category.assoc, hSec j, CategoryTheory.Category.comp_id,
                    CategoryTheory.Category.id_comp])
          have hqa_eq : q_vec a = σ_gen_j.base pt_K :=
            (((hSepSec C_B _ g_B (τ_B j) (hSec j)).2 K_bar s_B_gen σ_gen_j
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)).2 (q_vec a)).mp hqa_sec pt_K
          have : AlgebraicGeometry.IsClosedImmersion (ι_ℰ i) := hCl_ℰ i
          have hGenMem : (s_B_gen ≫ τ_B j).base pt_K ∈ Set.range (ι_ℰ i).base := by
            refine ⟨(CategoryTheory.Limits.pullback.fst (ι_ℰ i) fst_gen).base z_a, ?_⟩
            calc
              (ι_ℰ i).base ((CategoryTheory.Limits.pullback.fst (ι_ℰ i) fst_gen).base z_a)
                = (CategoryTheory.Limits.pullback.fst (ι_ℰ i) fst_gen ≫ ι_ℰ i).base z_a := rfl
              _ = (ι_gen i ≫ fst_gen).base z_a := by rw [CategoryTheory.Limits.pullback.condition]
              _ = fst_gen.base (q_vec a) := by
                    change fst_gen.base ((ι_gen i).base z_a) = fst_gen.base (q_vec a)
                    rw [hz_a]
              _ = (σ_gen_j ≫ fst_gen).base pt_K := by
                    change fst_gen.base (q_vec a) = fst_gen.base (σ_gen_j.base pt_K)
                    rw [hqa_eq]
              _ = (s_B_gen ≫ τ_B j).base pt_K := by rw [CategoryTheory.Limits.pullback.lift_fst]
          obtain ⟨τ_E, hτ_E⟩ := hDomSecFacB (ℰ i) (ι_ℰ i) (τ_B j) hGenMem
          let η_a := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of ∅)) ≫ τ_E
          refine ⟨∅, η_a, ?_, ?_, Or.inr ⟨j, ?_⟩⟩
          · dsimp only [η_a]
            rw [CategoryTheory.Category.assoc, ← (hComp i).2.2.2, ← CategoryTheory.Category.assoc τ_E,
              hτ_E, hSec j, CategoryTheory.Category.comp_id]
          · intro ξ' hξ'_fst hξ'_snd
            have hξ'_eq : ξ' = σ_gen_j := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [hξ'_fst, CategoryTheory.Limits.pullback.lift_fst]
                dsimp only [η_a, ι_of, s_B_gen]
                rw [CategoryTheory.Category.assoc, hτ_E, ← CategoryTheory.Category.assoc,
                  ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι_comp_ψ]
              · rw [hξ'_snd, CategoryTheory.Limits.pullback.lift_snd]
            rw [hξ'_eq, hqa_eq]
          · dsimp only [η_a]
            rw [CategoryTheory.Category.assoc, hτ_E]

      choose S_a η_a hη_p hη_pt hη_kind using hSpreadPt
      let S1_i : Finset K_bar := S_a 0 ∪ S_a 1 ∪ S_a 2
      have hSub_a : ∀ a : Fin 3, S_a a ⊆ S1_i := by
        rintro ⟨_ | _ | _ | a, ha⟩
        · exact Finset.subset_union_left.trans Finset.subset_union_left
        · exact Finset.subset_union_right.trans Finset.subset_union_left
        · exact Finset.subset_union_right
        · omega
      let s1_i := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S1_i))
      let g1_i := CategoryTheory.Limits.pullback.snd g_B s1_i
      let fst1_i := CategoryTheory.Limits.pullback.fst g_B s1_i
      let ρ_a : ∀ a : Fin 3,
          AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S1_i)) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of (S_a a))) :=
        fun a => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_of (hSub_a a))))
      have hρ_s1 : ∀ a : Fin 3,
          ρ_a a ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of (S_a a))) = s1_i := by
        intro a
        dsimp only [ρ_a, s1_i]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hInc_comp_ψ]
      obtain ⟨q_tilde, hq_tilde_fst, hq_tilde_sec⟩ :
          ∃ q_tilde : Fin 3 →
              (AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S1_i)) ⟶
                CategoryTheory.Limits.pullback g_B s1_i),
            (∀ a : Fin 3, q_tilde a ≫ fst1_i = ρ_a a ≫ η_a a ≫ ι_ℰ i) ∧
            (∀ a : Fin 3, q_tilde a ≫ g1_i = 𝟙 _) := by
        refine ⟨fun a => CategoryTheory.Limits.pullback.lift (ρ_a a ≫ η_a a ≫ ι_ℰ i) (𝟙 _)
          (by rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, (hComp i).2.2.2,
                hη_p a, hρ_s1 a, CategoryTheory.Category.id_comp]),
          fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _,
          fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _⟩

      let PairIdx := {p : Fin 3 × Fin 3 // p.1 ≠ p.2}
      have hPairEmp : ∀ p : PairIdx,
          ∃ (S_p : Finset K_bar) (hSub_p : R_of S1_i ≤ R_of S_p),
            S1_i ⊆ S_p ∧
            IsEmpty ↥(CategoryTheory.Limits.pullback
              (CategoryTheory.Limits.pullback.snd (q_tilde p.1.1) (q_tilde p.1.2))
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion hSub_p)))) := by
        intro p
        have hDisjPair := hSepDisj _ _ g1_i (q_tilde p.1.1) (q_tilde p.1.2)
          (hq_tilde_sec p.1.1) (hq_tilde_sec p.1.2)
        have : AlgebraicGeometry.IsClosedImmersion
            (CategoryTheory.Limits.pullback.snd (q_tilde p.1.1) (q_tilde p.1.2)) := hDisjPair.1
        let s_K1 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S1_i))
        have hs_K1_eq : s_K1 ≫ s1_i = s_B_gen := by
          dsimp only [s_K1, ι_of, s1_i, s_B_gen]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι_comp_ψ]
        let σ_K_a : ∀ a : Fin 3,
            AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ CategoryTheory.Limits.pullback g1_i s_K1 :=
          fun a => CategoryTheory.Limits.pullback.lift (s_K1 ≫ q_tilde a) (𝟙 _)
            (by rw [CategoryTheory.Category.assoc, hq_tilde_sec a, CategoryTheory.Category.comp_id,
                  CategoryTheory.Category.id_comp])
        let e_K1_hom : CategoryTheory.Limits.pullback g1_i s_K1 ⟶
            CategoryTheory.Limits.pullback g_B s_B_gen :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst g1_i s_K1 ≫ fst1_i)
            (CategoryTheory.Limits.pullback.snd g1_i s_K1)
            (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                  ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                  CategoryTheory.Category.assoc, hs_K1_eq])
        have hσ_pt : ∀ a : Fin 3, (σ_K_a a ≫ e_K1_hom).base pt_K = q_vec a := by
          intro a
          apply hη_pt a (σ_K_a a ≫ e_K1_hom)
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, hq_tilde_fst a,
              ← CategoryTheory.Category.assoc s_K1 (ρ_a a)]
            dsimp only [s_K1, ρ_a, ι_of]
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι_comp_inc]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Limits.pullback.lift_snd]
        have hEmpK : IsEmpty ↥(CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd (q_tilde p.1.1) (q_tilde p.1.2)) s_K1) := by
          refine (hDisjPair.2 K_bar s_K1 (σ_K_a p.1.1) (σ_K_a p.1.2)
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)).mp ?_
          intro pt hEq
          rw [Subsingleton.elim pt pt_K] at hEq
          have hEqY : (σ_K_a p.1.1 ≫ e_K1_hom).base pt_K = (σ_K_a p.1.2 ≫ e_K1_hom).base pt_K :=
            congrArg e_K1_hom.base hEq
          rw [hσ_pt p.1.1, hσ_pt p.1.2] at hEqY
          exact hq_ne p.1.1 p.1.2 p.2 hEqY
        exact hEmpDesc S1_i _ _ hEmpK

      choose S_pair hSub_pair _ hEmp_pair using hPairEmp
      let S_i : Finset K_bar := S1_i ∪ Finset.univ.biUnion S_pair
      refine ⟨S_i, ?_⟩
      intro Ω _ _ S_big hBig s_big s_B E_Ω_i
      have hS1_big : S1_i ⊆ S_big := Finset.subset_union_left.trans hBig
      let s1_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S1_i)) :=
        s_big ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_of hS1_big)))
      have hs1_Ω_eq : s1_Ω ≫ s1_i = s_B := by
        dsimp only [s1_Ω, s1_i, s_B]
        rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hInc_comp_ψ]
      obtain ⟨e_Ω, he_Ω_fst, _⟩ := hPastePullbackIso g_B s1_i s1_Ω s_B hs1_Ω_eq
      let σ_Ω_a : ∀ a : Fin 3,
          AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g1_i s1_Ω :=
        fun a => CategoryTheory.Limits.pullback.lift (s1_Ω ≫ q_tilde a) (𝟙 _)
          (by rw [CategoryTheory.Category.assoc, hq_tilde_sec a, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.id_comp])
      let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, inferInstance⟩
      let q_Ω : Fin 3 → ↥(CategoryTheory.Limits.pullback g_B s_B) :=
        fun a => e_Ω.hom.base ((σ_Ω_a a).base pt_Ω)

      have hq_Ω_ne : ∀ a b : Fin 3, a ≠ b → q_Ω a ≠ q_Ω b := by
        intro a b hab hEq
        have hEq1 : (σ_Ω_a a).base pt_Ω = (σ_Ω_a b).base pt_Ω := by
          calc
            (σ_Ω_a a).base pt_Ω = (e_Ω.hom ≫ e_Ω.inv).base ((σ_Ω_a a).base pt_Ω) := by
                rw [e_Ω.hom_inv_id]; rfl
            _ = e_Ω.inv.base (q_Ω a) := rfl
            _ = e_Ω.inv.base (q_Ω b) := by rw [hEq]
            _ = (e_Ω.hom ≫ e_Ω.inv).base ((σ_Ω_a b).base pt_Ω) := rfl
            _ = (σ_Ω_a b).base pt_Ω := by rw [e_Ω.hom_inv_id]; rfl
        let p : PairIdx := ⟨(a, b), hab⟩
        have hSp_big : S_pair p ⊆ S_big :=
          (Finset.subset_biUnion_of_mem S_pair (Finset.mem_univ p)).trans
            (Finset.subset_union_right.trans hBig)
        have hs1_fac : s1_Ω =
            (s_big ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Subring.inclusion (hSub_of hSp_big)))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_pair p))) := by
          dsimp only [s1_Ω]
          rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, hInc_comp_inc]
        have hEmp_Ω : IsEmpty ↥(CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd (q_tilde a) (q_tilde b)) s1_Ω) := by
          rw [hs1_fac]
          exact hEmpMono _ _ _ (hEmp_pair p)
        have hNe_pt := ((hSepDisj _ _ g1_i (q_tilde a) (q_tilde b)
          (hq_tilde_sec a) (hq_tilde_sec b)).2 Ω s1_Ω (σ_Ω_a a) (σ_Ω_a b)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)).mpr hEmp_Ω
        exact hNe_pt pt_Ω hEq1

      have hσ_fst_Ω : ∀ a : Fin 3,
          (σ_Ω_a a ≫ e_Ω.hom) ≫ CategoryTheory.Limits.pullback.fst g_B s_B =
            s1_Ω ≫ ρ_a a ≫ η_a a ≫ ι_ℰ i := by
        intro a
        rw [CategoryTheory.Category.assoc, he_Ω_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, hq_tilde_fst a]

      have hq_Ω_inE : ∀ a : Fin 3, q_Ω a ∈ E_Ω_i := by
        intro a
        let lift_E : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            CategoryTheory.Limits.pullback (ι_ℰ i) (CategoryTheory.Limits.pullback.fst g_B s_B) :=
          CategoryTheory.Limits.pullback.lift (s1_Ω ≫ ρ_a a ≫ η_a a) (σ_Ω_a a ≫ e_Ω.hom)
            (by rw [hσ_fst_Ω a]; simp only [CategoryTheory.Category.assoc])
        refine ⟨lift_E.base pt_Ω, ?_⟩
        change (lift_E ≫ CategoryTheory.Limits.pullback.snd (ι_ℰ i)
          (CategoryTheory.Limits.pullback.fst g_B s_B)).base pt_Ω = q_Ω a
        rw [CategoryTheory.Limits.pullback.lift_snd]
        rfl

      refine ⟨q_Ω 0, q_Ω 1, q_Ω 2,
        hq_Ω_ne 0 1 (by omega), hq_Ω_ne 0 2 (by omega), hq_Ω_ne 1 2 (by omega),
        hq_Ω_inE 0, hq_Ω_inE 1, hq_Ω_inE 2, ?_⟩
      intro q hq_mem
      have hq_ex : ∃ a : Fin 3, q = q_Ω a := by
        rcases hq_mem with rfl | rfl | rfl
        · exact ⟨0, rfl⟩
        · exact ⟨1, rfl⟩
        · exact ⟨2, rfl⟩
      obtain ⟨a, rfl⟩ := hq_ex
      rcases hη_kind a with ⟨i', η'_a, hi'_ne, hη'_eq⟩ | ⟨j, hη_sec⟩
      · left
        let E'_Ω := Set.range (CategoryTheory.Limits.pullback.snd (ι_ℰ i')
          (CategoryTheory.Limits.pullback.fst g_B s_B)).base
        have hFibΩ := hFib Ω s_B
        have hE'_mem : E'_Ω ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B) := by
          rw [hFibΩ.2.2.2.2]; exact ⟨i', rfl⟩
        have hE'_ne : E'_Ω ≠ E_Ω_i := hFibΩ.2.2.2.1 hi'_ne
        let lift_E' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            CategoryTheory.Limits.pullback (ι_ℰ i') (CategoryTheory.Limits.pullback.fst g_B s_B) :=
          CategoryTheory.Limits.pullback.lift (s1_Ω ≫ ρ_a a ≫ η'_a) (σ_Ω_a a ≫ e_Ω.hom)
            (by rw [hσ_fst_Ω a, ← hη'_eq]; simp only [CategoryTheory.Category.assoc])
        refine ⟨E'_Ω, hE'_mem, hE'_ne, lift_E'.base pt_Ω, ?_⟩
        change (lift_E' ≫ CategoryTheory.Limits.pullback.snd (ι_ℰ i')
          (CategoryTheory.Limits.pullback.fst g_B s_B)).base pt_Ω = q_Ω a
        rw [CategoryTheory.Limits.pullback.lift_snd]
        rfl
      · right
        refine ⟨j, (s_B.base pt_Ω), ?_⟩
        calc
          (τ_B j).base (s_B.base pt_Ω)
            = (s_B ≫ τ_B j).base pt_Ω := rfl
          _ = (s1_Ω ≫ s1_i ≫ τ_B j).base pt_Ω := by rw [← hs1_Ω_eq, CategoryTheory.Category.assoc]
          _ = (s1_Ω ≫ ρ_a a ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of (S_a a))) ≫
                τ_B j)).base pt_Ω := by
                rw [← hρ_s1 a]; simp only [CategoryTheory.Category.assoc]
          _ = (s1_Ω ≫ ρ_a a ≫ η_a a ≫ ι_ℰ i).base pt_Ω := by rw [← hη_sec]
          _ = ((σ_Ω_a a ≫ e_Ω.hom) ≫ CategoryTheory.Limits.pullback.fst g_B s_B).base pt_Ω := by
                rw [hσ_fst_Ω a]
          _ = (CategoryTheory.Limits.pullback.fst g_B s_B).base (q_Ω a) := rfl

    choose S_comp_pos hS_comp_pos using fun (i : {i : Fin c // IsP1Gen i}) => hPerCompPos i.1 i.2
    let f_pos : Fin c → Finset K_bar :=
      fun i => if h : IsP1Gen i then S_comp_pos ⟨i, h⟩ else ∅
    let S_pos : Finset K_bar := Finset.univ.biUnion f_pos
    refine ⟨↥(R_of S_pos), inferInstance, inferInstance, ψ_of S_pos, ι_of S_pos,
      hFT_of S_pos, hι_comp_ψ S_pos, Subtype.val_injective, ?_⟩
    intro Ω _ _ s_B'
    let s_B := s_B' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S_pos))
    have hFibΩ := hFib Ω s_B
    refine ⟨hFibΩ.1, hFibΩ.2.1, ?_⟩
    intro E E_sch ιE hE_mem hClE hIntE hRangeE hisoP1_Ω
    have hE_eq := hE_mem
    rw [hFibΩ.2.2.2.2] at hE_eq
    obtain ⟨i, rfl⟩ := hE_eq
    by_cases hP1_i : IsP1Gen i
    · have hSub_i : S_comp_pos ⟨i, hP1_i⟩ ⊆ S_pos := by
        have h1 : S_comp_pos ⟨i, hP1_i⟩ ⊆ f_pos i := by
          dsimp only [f_pos]
          split_ifs
          rfl
        exact h1.trans (Finset.subset_biUnion_of_mem f_pos (Finset.mem_univ i))
      exact hS_comp_pos ⟨i, hP1_i⟩ Ω S_pos hSub_i s_B'
    · exact False.elim (hNonP1 i hP1_i Ω s_B E_sch ιE hClE hIntE hRangeE hisoP1_Ω)

  refine ⟨hPosConj, ?_⟩
  intro hBadGen
  have hFibK := hFib K_bar s_B_gen
  have hExBad : ∃ (E₀ : Set ↥(CategoryTheory.Limits.pullback g_B s_B_gen))
      (E_sch : AlgebraicGeometry.Scheme.{u})
      (ιE : E_sch ⟶ CategoryTheory.Limits.pullback g_B s_B_gen),
      E₀ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B_gen) ∧
      AlgebraicGeometry.IsClosedImmersion ιE ∧
      AlgebraicGeometry.IsIntegral E_sch ∧
      Set.range ιE.base = E₀ ∧
      (∃ isoP1 : E_sch ≅ P1_obj K_bar,
        ιE ≫ snd_gen = isoP1.hom ≫ P1_hom K_bar) ∧
      ¬ ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g_B s_B_gen),
        q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
        q₁ ∈ E₀ ∧ q₂ ∈ E₀ ∧ q₃ ∈ E₀ ∧
        (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g_B s_B_gen)),
          (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B_gen),
            E' ≠ E₀ ∧ q ∈ E') ∨
          (∃ j : Fin n, fst_gen.base q ∈ Set.range (τ_B j).base)) := by
    by_contra hAllGood
    apply hBadGen
    refine ⟨hFibK.1, hFibK.2.1, ?_⟩
    intro E E_sch ιE hEm hCl hInt hR hiso
    by_contra hNo3
    exact hAllGood ⟨E, E_sch, ιE, hEm, hCl, hInt, hR, hiso, hNo3⟩

  obtain ⟨E₀, E_sch, ιE, hE₀_mem, hClE, hIntE, hRangeE, ⟨isoP1, hisoP1⟩, hNoThree⟩ := hExBad

  have hE₀_eq := hE₀_mem
  rw [hFibK.2.2.2.2] at hE₀_eq
  obtain ⟨i₀, rfl⟩ := hE₀_eq
  have : AlgebraicGeometry.IsClosedImmersion (ι_ℰ i₀) := hCl_ℰ i₀
  have : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback (ι_ℰ i₀) fst_gen) :=
    hFibK.2.2.1 i₀
  have : AlgebraicGeometry.IsIntegral E_sch := hIntE
  obtain ⟨e_sub, he_sub⟩ := hRedIso _ E_sch _ (ι_gen i₀) ιE hRangeE.symm
  obtain ⟨e_gen, he_gen_hom⟩ :
      ∃ e_gen : CategoryTheory.Limits.pullback (ι_ℰ i₀) fst_gen ≅ P1_obj K_bar,
        e_gen.hom ≫ P1_hom K_bar = ι_gen i₀ ≫ snd_gen := by
    refine ⟨e_sub ≪≫ isoP1, ?_⟩
    rw [CategoryTheory.Iso.trans_hom, CategoryTheory.Category.assoc, ← hisoP1,
      ← CategoryTheory.Category.assoc, he_sub]

  let p_PB := P1_hom B
  have : AlgebraicGeometry.IsProper p_PB := (hP1PropLFP B).1
  have : AlgebraicGeometry.LocallyOfFinitePresentation p_PB := (hP1PropLFP B).2
  have : AlgebraicGeometry.IsProper (p_ℰ i₀) := hProp_ℰ i₀
  have : AlgebraicGeometry.LocallyOfFinitePresentation (p_ℰ i₀) := hLFP_ℰ i₀

  obtain ⟨S₁, e_S₁, he_S₁_snd⟩ :
      ∃ (S₁ : Finset K_bar)
        (e_S₁ : CategoryTheory.Limits.pullback p_PB
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁))) ≅
          CategoryTheory.Limits.pullback (p_ℰ i₀)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁)))),
        e_S₁.hom ≫ CategoryTheory.Limits.pullback.snd (p_ℰ i₀) _ =
          CategoryTheory.Limits.pullback.snd p_PB _ := by
    obtain ⟨π_P_gen, hPbP_gen⟩ := hP1BaseChange B K_bar ι_B
    have hPbE_gen : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_gen)
        (ι_gen i₀ ≫ snd_gen) (p_ℰ i₀) s_B_gen := by
      rw [← (hComp i₀).2.2.2]
      exact (CategoryTheory.IsPullback.of_hasPullback (ι_ℰ i₀) fst_gen).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback g_B s_B_gen)
    let e_K_pb := hPbP_gen.isoPullback.symm ≪≫ e_gen.symm ≪≫ hPbE_gen.isoPullback
    have he_K_pb_snd : e_K_pb.hom ≫ CategoryTheory.Limits.pullback.snd (p_ℰ i₀) s_B_gen =
        CategoryTheory.Limits.pullback.snd p_PB s_B_gen := by
      dsimp only [e_K_pb, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hPbE_gen.isoPullback_hom_snd, ← he_gen_hom, e_gen.inv_hom_id_assoc]
      calc
        hPbP_gen.isoPullback.inv ≫ P1_hom K_bar
          = hPbP_gen.isoPullback.inv ≫ hPbP_gen.isoPullback.hom ≫
              CategoryTheory.Limits.pullback.snd p_PB s_B_gen := by
              rw [hPbP_gen.isoPullback_hom_snd]
        _ = CategoryTheory.Limits.pullback.snd p_PB s_B_gen :=
              hPbP_gen.isoPullback.inv_hom_id_assoc _
    obtain ⟨S₁, e_S₁, _, he_S₁_snd⟩ := hIsoDesc _ _ p_PB (p_ℰ i₀) ∅ e_K_pb he_K_pb_snd
    exact ⟨S₁, e_S₁, he_S₁_snd⟩

  let s_S₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₁))
  have he_S₁_inv_snd : e_S₁.inv ≫ CategoryTheory.Limits.pullback.snd p_PB s_S₁ =
      CategoryTheory.Limits.pullback.snd (p_ℰ i₀) s_S₁ := by
    rw [← he_S₁_snd, e_S₁.inv_hom_id_assoc]

  let IsSpecGen : ↥(CategoryTheory.Limits.pullback g_B s_B_gen) → Prop := fun q =>
    q ∈ Set.range (ι_gen i₀).base ∧
      ((∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B_gen),
          E' ≠ Set.range (ι_gen i₀).base ∧ q ∈ E') ∨
       (∃ j : Fin n, fst_gen.base q ∈ Set.range (τ_B j).base))
  obtain ⟨σ₀, σ₁, hσ₀_hom, _, hσ01_ne⟩ := (hP1Pts K_bar).1

  have hLiftSpecPt : ∀ q : ↥(CategoryTheory.Limits.pullback g_B s_B_gen), IsSpecGen q →
      ∃ (γ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ P1_obj K_bar),
        γ ≫ P1_hom K_bar = 𝟙 _ ∧
        (γ ≫ e_gen.inv ≫ ι_gen i₀).base pt_K = q := by
    intro q ⟨⟨z_q, hz_q⟩, hKind⟩
    have hNotUniv :
        closure ({e_gen.hom.base z_q} : Set ↥(P1_obj K_bar)) ≠
          Set.univ := by
      intro hUniv
      have hSubCl := hRangeSubClosure i₀ e_gen z_q hUniv
      rw [hz_q] at hSubCl
      rcases hKind with ⟨E', hE'_mem, hE'_ne, hq_E'⟩ | ⟨j, hq_sec⟩
      · have hClE' : IsClosed E' := isClosed_of_mem_irreducibleComponents _ hE'_mem
        have hSubE' : Set.range (ι_gen i₀).base ⊆ E' :=
          hSubCl.trans (closure_minimal (Set.singleton_subset_iff.mpr hq_E') hClE')
        exact hE'_ne (Set.Subset.antisymm hSubE' (hE₀_mem.2 hE'_mem.1 hSubE')).symm
      · let σ_gen_j : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
            CategoryTheory.Limits.pullback g_B s_B_gen :=
          CategoryTheory.Limits.pullback.lift (s_B_gen ≫ τ_B j) (𝟙 _)
            (by rw [CategoryTheory.Category.assoc, hSec j, CategoryTheory.Category.comp_id,
                  CategoryTheory.Category.id_comp])
        have hSecInfo := (hSepSec C_B _ g_B (τ_B j) (hSec j)).2 K_bar s_B_gen σ_gen_j
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        have : AlgebraicGeometry.IsClosedImmersion σ_gen_j := hSecInfo.1
        have hq_eq : q = σ_gen_j.base pt_K := (hSecInfo.2 q).mp hq_sec pt_K
        have hRange_σ : Set.range σ_gen_j.base = {q} := by
          ext y
          simp only [Set.mem_range, Set.mem_singleton_iff]
          exact ⟨fun ⟨pt, hpt⟩ => by rw [← hpt, Subsingleton.elim pt pt_K, hq_eq],
            fun hy => ⟨pt_K, by rw [hy, hq_eq]⟩⟩
        have hCl_q : IsClosed ({q} : Set ↥(CategoryTheory.Limits.pullback g_B s_B_gen)) := by
          rw [← hRange_σ]
          exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding σ_gen_j).isClosed_range
        have hSubSingle : Set.range (ι_gen i₀).base ⊆ {q} :=
          hSubCl.trans hCl_q.closure_eq.subset
        let y₀ := (ι_gen i₀).base (e_gen.inv.base (σ₀.base pt_K))
        let y₁ := (ι_gen i₀).base (e_gen.inv.base (σ₁.base pt_K))
        have hy₀ : y₀ = q := hSubSingle ⟨_, rfl⟩
        have hy₁ : y₁ = q := hSubSingle ⟨_, rfl⟩
        have hInj_ι := (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (ι_gen i₀)).injective
        have hz_eq := hInj_ι (hy₀.trans hy₁.symm)
        have hEq01 : σ₀.base pt_K = σ₁.base pt_K := by
          calc
            σ₀.base pt_K = (e_gen.inv ≫ e_gen.hom).base (σ₀.base pt_K) := by
                rw [e_gen.inv_hom_id]; rfl
            _ = e_gen.hom.base (e_gen.inv.base (σ₀.base pt_K)) := rfl
            _ = e_gen.hom.base (e_gen.inv.base (σ₁.base pt_K)) := by rw [hz_eq]
            _ = (e_gen.inv ≫ e_gen.hom).base (σ₁.base pt_K) := rfl
            _ = σ₁.base pt_K := by rw [e_gen.inv_hom_id]; rfl
        exact hσ01_ne pt_K hEq01
    obtain ⟨γ, hγ_hom, hγ_pt⟩ := (hP1Pts K_bar).2 (e_gen.hom.base z_q) hNotUniv
    refine ⟨γ, hγ_hom, ?_⟩
    have h1 : (γ ≫ e_gen.inv).base pt_K = z_q := by
      change e_gen.inv.base (γ.base pt_K) = z_q
      rw [hγ_pt pt_K]
      change (e_gen.hom ≫ e_gen.inv).base z_q = z_q
      rw [e_gen.hom_inv_id]; rfl
    change (ι_gen i₀).base ((γ ≫ e_gen.inv).base pt_K) = q
    rw [h1, hz_q]

  have hTwoGamma :
      ∃ (γ₁ γ₂ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ P1_obj K_bar),
        γ₁ ≫ P1_hom K_bar = 𝟙 _ ∧
        γ₂ ≫ P1_hom K_bar = 𝟙 _ ∧
        ∀ q : ↥(CategoryTheory.Limits.pullback g_B s_B_gen), IsSpecGen q →
          q = (γ₁ ≫ e_gen.inv ≫ ι_gen i₀).base pt_K ∨
          q = (γ₂ ≫ e_gen.inv ≫ ι_gen i₀).base pt_K := by
    by_cases hEx1 : ∃ q₁ : ↥(CategoryTheory.Limits.pullback g_B s_B_gen), IsSpecGen q₁
    · obtain ⟨q₁, hq₁⟩ := hEx1
      obtain ⟨γ₁, hγ₁_hom, hγ₁_pt⟩ := hLiftSpecPt q₁ hq₁
      by_cases hEx2 : ∃ q₂ : ↥(CategoryTheory.Limits.pullback g_B s_B_gen),
          IsSpecGen q₂ ∧ q₂ ≠ q₁
      · obtain ⟨q₂, hq₂, hq21⟩ := hEx2
        obtain ⟨γ₂, hγ₂_hom, hγ₂_pt⟩ := hLiftSpecPt q₂ hq₂
        refine ⟨γ₁, γ₂, hγ₁_hom, hγ₂_hom, ?_⟩
        intro q hq
        by_cases hqq1 : q = q₁
        · exact Or.inl (by rw [hγ₁_pt, hqq1])
        · by_cases hqq2 : q = q₂
          · exact Or.inr (by rw [hγ₂_pt, hqq2])
          · exfalso
            apply hNoThree
            refine ⟨q₁, q₂, q, Ne.symm hq21, Ne.symm hqq1, Ne.symm hqq2,
              hq₁.1, hq₂.1, hq.1, ?_⟩
            intro q' hq'_mem
            rcases hq'_mem with rfl | rfl | rfl
            · exact hq₁.2
            · exact hq₂.2
            · exact hq.2
      · refine ⟨γ₁, γ₁, hγ₁_hom, hγ₁_hom, ?_⟩
        intro q hq
        left
        rw [hγ₁_pt]
        by_contra hne
        exact hEx2 ⟨q, hq, hne⟩
    · refine ⟨σ₀, σ₀, hσ₀_hom, hσ₀_hom, ?_⟩
      intro q hq
      exact False.elim (hEx1 ⟨q, hq⟩)

  obtain ⟨γ₁, γ₂, hγ₁_hom, hγ₂_hom, hγ_cov⟩ := hTwoGamma

  let u₁ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ ℰ i₀ :=
    γ₁ ≫ e_gen.inv ≫ CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_gen
  let u₂ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ ℰ i₀ :=
    γ₂ ≫ e_gen.inv ≫ CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_gen
  have hu_hom : ∀ (γ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶ P1_obj K_bar),
      γ ≫ P1_hom K_bar = 𝟙 _ →
      (γ ≫ e_gen.inv ≫ CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_gen) ≫ p_ℰ i₀ = s_B_gen := by
    intro γ hγ
    calc
      (γ ≫ e_gen.inv ≫ CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_gen) ≫ p_ℰ i₀
        = γ ≫ e_gen.inv ≫ (CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_gen ≫ ι_ℰ i₀) ≫ g_B := by
            rw [← (hComp i₀).2.2.2]; simp only [CategoryTheory.Category.assoc]
      _ = γ ≫ e_gen.inv ≫ ι_gen i₀ ≫ (fst_gen ≫ g_B) := by
            rw [CategoryTheory.Limits.pullback.condition]
            simp only [ι_gen, CategoryTheory.Category.assoc]
      _ = γ ≫ e_gen.inv ≫ (ι_gen i₀ ≫ snd_gen) ≫ s_B_gen := by
            rw [CategoryTheory.Limits.pullback.condition]
            simp only [snd_gen, CategoryTheory.Category.assoc]
      _ = (γ ≫ P1_hom K_bar) ≫ s_B_gen := by
            rw [← he_gen_hom, CategoryTheory.Category.assoc, e_gen.inv_hom_id_assoc,
              CategoryTheory.Category.assoc]
      _ = s_B_gen := by rw [hγ, CategoryTheory.Category.id_comp]
  obtain ⟨S₁', u₁_S, hS1_sub', hu₁_S_f, hu₁_S_K⟩ :=
    hSecDesc (ℰ i₀) (p_ℰ i₀) S₁ u₁ (hu_hom γ₁ hγ₁_hom)
  obtain ⟨S₂, u₂_S, hS1'_sub, hu₂_S_f, hu₂_S_K⟩ :=
    hSecDesc (ℰ i₀) (p_ℰ i₀) S₁' u₂ (hu_hom γ₂ hγ₂_hom)
  have hS1_S2 : S₁ ⊆ S₂ := hS1_sub'.trans hS1'_sub

  have : IsNoetherianRing ↥(R_of S₂) := hNoeth_of S₂
  let s₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₂))
  let fst_C₂ := CategoryTheory.Limits.pullback.fst g_B s₂
  let g_R₂ := CategoryTheory.Limits.pullback.snd g_B s₂
  let ι_P := CategoryTheory.Limits.pullback.snd (ι_ℰ i₀) fst_C₂
  let p_P := ι_P ≫ g_R₂
  have hPb_ER₂ : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_C₂) p_P (p_ℰ i₀) s₂ := by
    rw [← (hComp i₀).2.2.2]
    exact (CategoryTheory.IsPullback.of_hasPullback (ι_ℰ i₀) fst_C₂).paste_vert
      (CategoryTheory.IsPullback.of_hasPullback g_B s₂)
  have : AlgebraicGeometry.IsProper p_P :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ER₂ (hProp_ℰ i₀)
  have : AlgebraicGeometry.LocallyOfFinitePresentation p_P :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ER₂ (hLFP_ℰ i₀)

  obtain ⟨p₁_tilde, p₂_tilde, hp₁_sec, hp₂_sec, hp₁_fstK, hp₂_fstK⟩ :
      ∃ (p₁_tilde p₂_tilde : AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂)) ⟶
          CategoryTheory.Limits.pullback (ι_ℰ i₀) fst_C₂),
        p₁_tilde ≫ p_P = 𝟙 _ ∧
        p₂_tilde ≫ p_P = 𝟙 _ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S₂)) ≫ p₁_tilde ≫ ι_P ≫ fst_C₂ =
          u₁ ≫ ι_ℰ i₀ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S₂)) ≫ p₂_tilde ≫ ι_P ≫ fst_C₂ =
          u₂ ≫ ι_ℰ i₀ := by
    let ρ₁'₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₁')) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_of hS1'_sub)))
    let u₁_R₂ := ρ₁'₂ ≫ u₁_S
    let u₂_R₂ := u₂_S
    have hu₁_R₂_f : u₁_R₂ ≫ p_ℰ i₀ = s₂ := by
      dsimp only [u₁_R₂, ρ₁'₂, s₂]
      rw [CategoryTheory.Category.assoc, hu₁_S_f, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hInc_comp_ψ]
    have hu₁_R₂_K : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S₂)) ≫ u₁_R₂ = u₁ := by
      dsimp only [u₁_R₂, ρ₁'₂]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hι_comp_inc]
      exact hu₁_S_K
    let c₁_R₂ := CategoryTheory.Limits.pullback.lift (u₁_R₂ ≫ ι_ℰ i₀) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, (hComp i₀).2.2.2, hu₁_R₂_f,
            CategoryTheory.Category.id_comp])
    let c₂_R₂ := CategoryTheory.Limits.pullback.lift (u₂_R₂ ≫ ι_ℰ i₀) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, (hComp i₀).2.2.2, hu₂_S_f,
            CategoryTheory.Category.id_comp])
    let p₁_t := CategoryTheory.Limits.pullback.lift u₁_R₂ c₁_R₂
      (by rw [CategoryTheory.Limits.pullback.lift_fst])
    let p₂_t := CategoryTheory.Limits.pullback.lift u₂_R₂ c₂_R₂
      (by rw [CategoryTheory.Limits.pullback.lift_fst])
    refine ⟨p₁_t, p₂_t, ?_, ?_, ?_, ?_⟩
    · dsimp only [p_P, p₁_t, c₁_R₂]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd]
    · dsimp only [p_P, p₂_t, c₂_R₂]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd]
    · dsimp only [p₁_t, c₁_R₂, ι_P]
      rw [← CategoryTheory.Category.assoc p₁_t, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc, hu₁_R₂_K]
    · dsimp only [p₂_t, c₂_R₂, ι_P]
      rw [← CategoryTheory.Category.assoc p₂_t, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc, hu₂_S_K]

  let s_K2 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_of S₂))
  have hs_K2_eq : s_K2 ≫ s₂ = s_B_gen := by
    dsimp only [s_K2, ι_of, s₂, s_B_gen]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι_comp_ψ]
  obtain ⟨e_CK2, he_CK2_fst, he_CK2_snd⟩ := hPastePullbackIso g_B s₂ s_K2 s_B_gen hs_K2_eq

  have hInTwoRangeK : ∀ q' : ↥(CategoryTheory.Limits.pullback g_R₂ s_K2),
      IsSpecGen (e_CK2.hom.base q') →
      (CategoryTheory.Limits.pullback.fst g_R₂ s_K2).base q' ∈
        Set.range (p₁_tilde ≫ ι_P).base ∪ Set.range (p₂_tilde ≫ ι_P).base := by
    intro q' hSpec_q'
    let σ_p₁ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
        CategoryTheory.Limits.pullback g_R₂ s_K2 :=
      CategoryTheory.Limits.pullback.lift (s_K2 ≫ p₁_tilde ≫ ι_P) (𝟙 _)
        (by dsimp only [p_P] at hp₁_sec
            rw [CategoryTheory.Category.assoc s_K2, CategoryTheory.Category.assoc p₁_tilde,
              hp₁_sec, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    let σ_p₂ : AlgebraicGeometry.Spec (CommRingCat.of K_bar) ⟶
        CategoryTheory.Limits.pullback g_R₂ s_K2 :=
      CategoryTheory.Limits.pullback.lift (s_K2 ≫ p₂_tilde ≫ ι_P) (𝟙 _)
        (by dsimp only [p_P] at hp₂_sec
            rw [CategoryTheory.Category.assoc s_K2, CategoryTheory.Category.assoc p₂_tilde,
              hp₂_sec, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hσ_p₁_eq : σ_p₁ ≫ e_CK2.hom = γ₁ ≫ e_gen.inv ≫ ι_gen i₀ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, he_CK2_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc s_K2, CategoryTheory.Category.assoc p₁_tilde]
        dsimp only [s_K2]
        rw [hp₁_fstK]
        simp only [u₁, ι_gen, fst_gen, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition]
      · rw [CategoryTheory.Category.assoc, he_CK2_snd, CategoryTheory.Limits.pullback.lift_snd]
        symm
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← he_gen_hom,
          e_gen.inv_hom_id_assoc, hγ₁_hom]
    have hσ_p₂_eq : σ_p₂ ≫ e_CK2.hom = γ₂ ≫ e_gen.inv ≫ ι_gen i₀ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, he_CK2_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc s_K2, CategoryTheory.Category.assoc p₂_tilde]
        dsimp only [s_K2]
        rw [hp₂_fstK]
        simp only [u₂, ι_gen, fst_gen, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition]
      · rw [CategoryTheory.Category.assoc, he_CK2_snd, CategoryTheory.Limits.pullback.lift_snd]
        symm
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← he_gen_hom,
          e_gen.inv_hom_id_assoc, hγ₂_hom]
    rcases hγ_cov (e_CK2.hom.base q') hSpec_q' with h1 | h2
    · rw [← hσ_p₁_eq] at h1
      have hq'1 : q' = σ_p₁.base pt_K := by
        calc
          q' = (e_CK2.hom ≫ e_CK2.inv).base q' := by rw [e_CK2.hom_inv_id]; rfl
          _ = e_CK2.inv.base (e_CK2.hom.base q') := rfl
          _ = e_CK2.inv.base ((σ_p₁ ≫ e_CK2.hom).base pt_K) := by rw [h1]
          _ = (e_CK2.hom ≫ e_CK2.inv).base (σ_p₁.base pt_K) := rfl
          _ = σ_p₁.base pt_K := by rw [e_CK2.hom_inv_id]; rfl
      rw [hq'1]
      exact Or.inl ⟨s_K2.base pt_K, by
        change (s_K2 ≫ p₁_tilde ≫ ι_P).base pt_K =
          (σ_p₁ ≫ CategoryTheory.Limits.pullback.fst g_R₂ s_K2).base pt_K
        rw [CategoryTheory.Limits.pullback.lift_fst]⟩
    · rw [← hσ_p₂_eq] at h2
      have hq'2 : q' = σ_p₂.base pt_K := by
        calc
          q' = (e_CK2.hom ≫ e_CK2.inv).base q' := by rw [e_CK2.hom_inv_id]; rfl
          _ = e_CK2.inv.base (e_CK2.hom.base q') := rfl
          _ = e_CK2.inv.base ((σ_p₂ ≫ e_CK2.hom).base pt_K) := by rw [h2]
          _ = (e_CK2.hom ≫ e_CK2.inv).base (σ_p₂.base pt_K) := rfl
          _ = σ_p₂.base pt_K := by rw [e_CK2.hom_inv_id]; rfl
      rw [hq'2]
      exact Or.inr ⟨s_K2.base pt_K, by
        change (s_K2 ≫ p₂_tilde ≫ ι_P).base pt_K =
          (σ_p₂ ≫ CategoryTheory.Limits.pullback.fst g_R₂ s_K2).base pt_K
        rw [CategoryTheory.Limits.pullback.lift_fst]⟩

  let CompOther := {i' : Fin c // i' ≠ i₀}
  let ι_Z_comp : ∀ i' : CompOther,
      CategoryTheory.Limits.pullback (ι_ℰ i'.1) fst_C₂ ⟶ CategoryTheory.Limits.pullback g_B s₂ :=
    fun i' => CategoryTheory.Limits.pullback.snd (ι_ℰ i'.1) fst_C₂

  obtain ⟨liftCompK, hliftCompK_snd⟩ :
      ∃ liftCompK : ∀ (i : Fin c),
          CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_C₂)
            (CategoryTheory.Limits.pullback.fst g_R₂ s_K2) ⟶
            CategoryTheory.Limits.pullback (ι_ℰ i) fst_gen,
        ∀ (i : Fin c), liftCompK i ≫ ι_gen i =
          CategoryTheory.Limits.pullback.snd
            (CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_C₂)
            (CategoryTheory.Limits.pullback.fst g_R₂ s_K2) ≫ e_CK2.hom := by
    refine ⟨fun i => CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst _ _ ≫
        CategoryTheory.Limits.pullback.fst (ι_ℰ i) fst_C₂)
      (CategoryTheory.Limits.pullback.snd _ _ ≫ e_CK2.hom)
      (by
        calc
          (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_C₂)
              (CategoryTheory.Limits.pullback.fst g_R₂ s_K2) ≫
              CategoryTheory.Limits.pullback.fst (ι_ℰ i) fst_C₂) ≫ ι_ℰ i
            = CategoryTheory.Limits.pullback.fst _ _ ≫
                CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_C₂ ≫ fst_C₂ := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
          _ = CategoryTheory.Limits.pullback.snd _ _ ≫
                (CategoryTheory.Limits.pullback.fst g_R₂ s_K2 ≫ fst_C₂) := by
                rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
                  CategoryTheory.Category.assoc]
          _ = (CategoryTheory.Limits.pullback.snd _ _ ≫ e_CK2.hom) ≫ fst_gen := by
                rw [← he_CK2_fst, CategoryTheory.Category.assoc]),
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _⟩

  have hCompW : ∀ i' : CompOther,
      ∃ (W_c : AlgebraicGeometry.Scheme.{u})
        (q_Wc : W_c ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂)))
        (S_c : Finset K_bar)
        (hSub_c : R_of S₂ ≤ R_of S_c),
        S₂ ⊆ S_c ∧
        IsEmpty ↥(CategoryTheory.Limits.pullback q_Wc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion hSub_c)))) ∧
        ∀ (Ω : Type u) [Field Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂))),
          IsEmpty ↥(CategoryTheory.Limits.pullback q_Wc s) →
          ∀ q : ↥(CategoryTheory.Limits.pullback g_R₂ s),
            q ∈ Set.range (CategoryTheory.Limits.pullback.snd ι_P
                  (CategoryTheory.Limits.pullback.fst g_R₂ s)).base →
            q ∈ Set.range (CategoryTheory.Limits.pullback.snd (ι_Z_comp i')
                  (CategoryTheory.Limits.pullback.fst g_R₂ s)).base →
            (CategoryTheory.Limits.pullback.fst g_R₂ s).base q ∈
              Set.range (p₁_tilde ≫ ι_P).base ∪ Set.range (p₂_tilde ≫ ι_P).base := by
    intro i'
    have : AlgebraicGeometry.IsClosedImmersion (ι_ℰ i'.1) := hCl_ℰ i'.1
    obtain ⟨W_c, q_Wc, hQC_Wc, hIff_Wc⟩ :=
      hTwoSecCompl ↥(R_of S₂) _ _ _ g_R₂ p_P ι_P (ι_Z_comp i') p₁_tilde p₂_tilde
        rfl hp₁_sec hp₂_sec
    have hEmpK_c : IsEmpty ↥(CategoryTheory.Limits.pullback q_Wc s_K2) := by
      refine (hIff_Wc K_bar s_K2).mpr ?_
      intro q' ⟨y_P, hy_P⟩ ⟨y_Z, hy_Z⟩
      apply hInTwoRangeK q'
      refine ⟨?_, Or.inl ?_⟩
      · refine ⟨(liftCompK i₀).base y_P, ?_⟩
        rw [← hy_P]
        change (liftCompK i₀ ≫ ι_gen i₀).base y_P =
          (CategoryTheory.Limits.pullback.snd _ _ ≫ e_CK2.hom).base y_P
        rw [hliftCompK_snd i₀]
      · let E' := Set.range (ι_gen i'.1).base
        have hE'_mem : E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B_gen) := by
          rw [hFibK.2.2.2.2]; exact ⟨i'.1, rfl⟩
        have hE'_ne : E' ≠ Set.range (ι_gen i₀).base := hFibK.2.2.2.1 i'.2
        refine ⟨E', hE'_mem, hE'_ne, (liftCompK i'.1).base y_Z, ?_⟩
        rw [← hy_Z]
        change (liftCompK i'.1 ≫ ι_gen i'.1).base y_Z =
          (CategoryTheory.Limits.pullback.snd _ _ ≫ e_CK2.hom).base y_Z
        rw [hliftCompK_snd i'.1]
    obtain ⟨S_c, hSub_c, hS2_c, hEmp_Sc⟩ := hEmpDesc S₂ W_c q_Wc hEmpK_c
    exact ⟨W_c, q_Wc, S_c, hSub_c, hS2_c, hEmp_Sc, fun Ω _ s hE => (hIff_Wc Ω s).mp hE⟩

  obtain ⟨τ_R₂, hτ_R₂_fst, hτ_R₂_sec⟩ :
      ∃ τ_R₂ : Fin n →
          (AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂)) ⟶
            CategoryTheory.Limits.pullback g_B s₂),
        (∀ j : Fin n, τ_R₂ j ≫ fst_C₂ = s₂ ≫ τ_B j) ∧
        (∀ j : Fin n, τ_R₂ j ≫ g_R₂ = 𝟙 _) := by
    refine ⟨fun j => CategoryTheory.Limits.pullback.lift (s₂ ≫ τ_B j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hSec j, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp]),
      fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _,
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _⟩

  have hSecW : ∀ j : Fin n,
      ∃ (W_s : AlgebraicGeometry.Scheme.{u})
        (q_Ws : W_s ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂)))
        (S_s : Finset K_bar)
        (hSub_s : R_of S₂ ≤ R_of S_s),
        S₂ ⊆ S_s ∧
        IsEmpty ↥(CategoryTheory.Limits.pullback q_Ws
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion hSub_s)))) ∧
        ∀ (Ω : Type u) [Field Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂))),
          IsEmpty ↥(CategoryTheory.Limits.pullback q_Ws s) →
          ∀ q : ↥(CategoryTheory.Limits.pullback g_R₂ s),
            q ∈ Set.range (CategoryTheory.Limits.pullback.snd ι_P
                  (CategoryTheory.Limits.pullback.fst g_R₂ s)).base →
            q ∈ Set.range (CategoryTheory.Limits.pullback.snd (τ_R₂ j)
                  (CategoryTheory.Limits.pullback.fst g_R₂ s)).base →
            (CategoryTheory.Limits.pullback.fst g_R₂ s).base q ∈
              Set.range (p₁_tilde ≫ ι_P).base ∪ Set.range (p₂_tilde ≫ ι_P).base := by
    intro j
    have : AlgebraicGeometry.IsClosedImmersion (τ_R₂ j) :=
      (hSepSec _ _ g_R₂ (τ_R₂ j) (hτ_R₂_sec j)).1
    obtain ⟨W_s, q_Ws, hQC_Ws, hIff_Ws⟩ :=
      hTwoSecCompl ↥(R_of S₂) _ _ _ g_R₂ p_P ι_P (τ_R₂ j) p₁_tilde p₂_tilde
        rfl hp₁_sec hp₂_sec
    have hEmpK_s : IsEmpty ↥(CategoryTheory.Limits.pullback q_Ws s_K2) := by
      refine (hIff_Ws K_bar s_K2).mpr ?_
      intro q' ⟨y_P, hy_P⟩ ⟨y_Z, hy_Z⟩
      apply hInTwoRangeK q'
      refine ⟨?_, Or.inr ⟨j, ?_⟩⟩
      · refine ⟨(liftCompK i₀).base y_P, ?_⟩
        rw [← hy_P]
        change (liftCompK i₀ ≫ ι_gen i₀).base y_P =
          (CategoryTheory.Limits.pullback.snd _ _ ≫ e_CK2.hom).base y_P
        rw [hliftCompK_snd i₀]
      · refine ⟨s₂.base ((CategoryTheory.Limits.pullback.fst (τ_R₂ j) _).base y_Z), ?_⟩
        have hEqHom :
            CategoryTheory.Limits.pullback.fst (τ_R₂ j)
                (CategoryTheory.Limits.pullback.fst g_R₂ s_K2) ≫ s₂ ≫ τ_B j =
              CategoryTheory.Limits.pullback.snd (τ_R₂ j)
                (CategoryTheory.Limits.pullback.fst g_R₂ s_K2) ≫ e_CK2.hom ≫ fst_gen := by
          rw [he_CK2_fst, ← hτ_R₂_fst j, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
        change (CategoryTheory.Limits.pullback.fst (τ_R₂ j) _ ≫ s₂ ≫ τ_B j).base y_Z =
          fst_gen.base (e_CK2.hom.base q')
        rw [hEqHom, ← hy_Z]
        rfl
    obtain ⟨S_s, hSub_s, hS2_s, hEmp_Ss⟩ := hEmpDesc S₂ W_s q_Ws hEmpK_s
    exact ⟨W_s, q_Ws, S_s, hSub_s, hS2_s, hEmp_Ss, fun Ω _ s hE => (hIff_Ws Ω s).mp hE⟩

  choose W_c q_Wc S_c hSub_c _ hEmp_Sc hImp_Wc using hCompW
  choose W_s q_Ws S_s hSub_s _ hEmp_Ss hImp_Ws using hSecW

  let S₃ : Finset K_bar :=
    S₂ ∪ Finset.univ.biUnion S_c ∪ Finset.univ.biUnion S_s
  have hS2_S3 : S₂ ⊆ S₃ := Finset.subset_union_left.trans Finset.subset_union_left
  have hS1_S3 : S₁ ⊆ S₃ := hS1_S2.trans hS2_S3

  refine ⟨↥(R_of S₃), inferInstance, inferInstance, ψ_of S₃, ι_of S₃,
    hFT_of S₃, hι_comp_ψ S₃, Subtype.val_injective, ?_⟩
  intro Ω _ _ s_B' hGood_Ω
  let s_B := s_B' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of S₃))
  let s₂_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₂)) :=
    s_B' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_of hS2_S3)))
  let s₁_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥(R_of S₁)) :=
    s_B' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_of hS1_S3)))
  have hs₂_Ω_eq : s₂_Ω ≫ s₂ = s_B := by
    dsimp only [s₂_Ω, s₂, s_B]
    rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hInc_comp_ψ]
  have hs₁_Ω_eq : s₁_Ω ≫ s_S₁ = s_B := by
    dsimp only [s₁_Ω, s_S₁, s_B]
    rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hInc_comp_ψ]

  let fst_Ω := CategoryTheory.Limits.pullback.fst g_B s_B
  let snd_Ω := CategoryTheory.Limits.pullback.snd g_B s_B
  let ι_Ω_i₀ := CategoryTheory.Limits.pullback.snd (ι_ℰ i₀) fst_Ω
  have hFibΩ := hFib Ω s_B

  have hExIsoP1_Ω :
      ∃ isoP1_Ω : CategoryTheory.Limits.pullback (ι_ℰ i₀) fst_Ω ≅ P1_obj Ω,
        ι_Ω_i₀ ≫ snd_Ω = isoP1_Ω.hom ≫ P1_hom Ω := by
    have hPbE_Ω : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_Ω)
        (ι_Ω_i₀ ≫ snd_Ω) (p_ℰ i₀) s_B := by
      rw [← (hComp i₀).2.2.2]
      exact (CategoryTheory.IsPullback.of_hasPullback (ι_ℰ i₀) fst_Ω).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback g_B s_B)
    let f_to_S₁ : CategoryTheory.Limits.pullback (ι_ℰ i₀) fst_Ω ⟶
        CategoryTheory.Limits.pullback (p_ℰ i₀) s_S₁ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_Ω)
        (ι_Ω_i₀ ≫ snd_Ω ≫ s₁_Ω)
        (by
          calc
            CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_Ω ≫ p_ℰ i₀
              = (CategoryTheory.Limits.pullback.fst (ι_ℰ i₀) fst_Ω ≫ ι_ℰ i₀) ≫ g_B := by
                  rw [← (hComp i₀).2.2.2, CategoryTheory.Category.assoc]
            _ = ι_Ω_i₀ ≫ (fst_Ω ≫ g_B) := by
                  rw [CategoryTheory.Limits.pullback.condition]
                  simp only [ι_Ω_i₀, CategoryTheory.Category.assoc]
            _ = ι_Ω_i₀ ≫ snd_Ω ≫ s_B := by
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = (ι_Ω_i₀ ≫ snd_Ω ≫ s₁_Ω) ≫ s_S₁ := by
                  symm
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hs₁_Ω_eq])
    have hPb_left : CategoryTheory.IsPullback f_to_S₁ (ι_Ω_i₀ ≫ snd_Ω)
        (CategoryTheory.Limits.pullback.snd (p_ℰ i₀) s_S₁) s₁_Ω :=
      CategoryTheory.IsPullback.of_right
        (by rw [CategoryTheory.Limits.pullback.lift_fst, hs₁_Ω_eq]; exact hPbE_Ω)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback (p_ℰ i₀) s_S₁)
    have hPb_iso_S₁ : CategoryTheory.IsPullback e_S₁.inv
        (CategoryTheory.Limits.pullback.snd (p_ℰ i₀) s_S₁)
        (CategoryTheory.Limits.pullback.snd p_PB s_S₁) (𝟙 _) :=
      CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [he_S₁_inv_snd, CategoryTheory.Category.comp_id]⟩
    have hPb_E_PB : CategoryTheory.IsPullback
        ((f_to_S₁ ≫ e_S₁.inv) ≫ CategoryTheory.Limits.pullback.fst p_PB s_S₁)
        (ι_Ω_i₀ ≫ snd_Ω) p_PB s_B := by
      have h1 := hPb_left.paste_horiz hPb_iso_S₁
      rw [CategoryTheory.Category.comp_id] at h1
      have h2 := h1.paste_horiz (CategoryTheory.IsPullback.of_hasPullback p_PB s_S₁)
      rwa [hs₁_Ω_eq] at h2
    let φ_B_Ω : B →+* Ω := (AlgebraicGeometry.Spec.preimage s_B).hom
    have hφ_B_Ω : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B_Ω) = s_B :=
      AlgebraicGeometry.Spec.map_preimage s_B
    obtain ⟨π_P_Ω, hPbP_Ω_raw⟩ := hP1BaseChange B Ω φ_B_Ω
    have hPbP_Ω : CategoryTheory.IsPullback π_P_Ω (P1_hom Ω) p_PB s_B := by
      rwa [hφ_B_Ω] at hPbP_Ω_raw
    refine ⟨hPb_E_PB.isoPullback ≪≫ hPbP_Ω.isoPullback.symm, ?_⟩
    have h1 : hPbP_Ω.isoPullback.inv ≫ P1_hom Ω =
        CategoryTheory.Limits.pullback.snd p_PB s_B := by
      calc
        hPbP_Ω.isoPullback.inv ≫ P1_hom Ω
          = hPbP_Ω.isoPullback.inv ≫ hPbP_Ω.isoPullback.hom ≫
              CategoryTheory.Limits.pullback.snd p_PB s_B := by
              rw [hPbP_Ω.isoPullback_hom_snd]
        _ = CategoryTheory.Limits.pullback.snd p_PB s_B :=
              hPbP_Ω.isoPullback.inv_hom_id_assoc _
    dsimp only [CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom]
    rw [CategoryTheory.Category.assoc, h1, hPb_E_PB.isoPullback_hom_snd]

  have hEΩ_mem : Set.range ι_Ω_i₀.base ∈
      irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B) := by
    rw [hFibΩ.2.2.2.2]; exact ⟨i₀, rfl⟩
  obtain ⟨q₁, q₂, q₃, hq12, hq13, hq23, hq1E, hq2E, hq3E, hSpec_Ω⟩ :=
    hGood_Ω.2.2 (Set.range ι_Ω_i₀.base) _ ι_Ω_i₀ hEΩ_mem inferInstance
      (hFibΩ.2.2.1 i₀) rfl hExIsoP1_Ω

  obtain ⟨e_C2Ω, he_C2Ω_fst, he_C2Ω_snd⟩ := hPastePullbackIso g_B s₂ s₂_Ω s_B hs₂_Ω_eq
  let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, inferInstance⟩
  let β₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g_R₂ s₂_Ω :=
    CategoryTheory.Limits.pullback.lift (s₂_Ω ≫ p₁_tilde ≫ ι_P) (𝟙 _)
      (by dsimp only [p_P] at hp₁_sec
          rw [CategoryTheory.Category.assoc s₂_Ω, CategoryTheory.Category.assoc p₁_tilde,
            hp₁_sec, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let β₂ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g_R₂ s₂_Ω :=
    CategoryTheory.Limits.pullback.lift (s₂_Ω ≫ p₂_tilde ≫ ι_P) (𝟙 _)
      (by dsimp only [p_P] at hp₂_sec
          rw [CategoryTheory.Category.assoc s₂_Ω, CategoryTheory.Category.assoc p₂_tilde,
            hp₂_sec, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  let y₁ : ↥(CategoryTheory.Limits.pullback g_B s_B) := e_C2Ω.hom.base (β₁.base pt_Ω)
  let y₂ : ↥(CategoryTheory.Limits.pullback g_B s_B) := e_C2Ω.hom.base (β₂.base pt_Ω)

  have hinv_C2Ω_fst : e_C2Ω.inv ≫ CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω ≫ fst_C₂ = fst_Ω := by
    calc
      e_C2Ω.inv ≫ CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω ≫ fst_C₂
        = e_C2Ω.inv ≫ e_C2Ω.hom ≫ fst_Ω := by rw [he_C2Ω_fst]
      _ = fst_Ω := e_C2Ω.inv_hom_id_assoc _
  have hinv_C2Ω_snd : e_C2Ω.inv ≫ CategoryTheory.Limits.pullback.snd g_R₂ s₂_Ω = snd_Ω := by
    calc
      e_C2Ω.inv ≫ CategoryTheory.Limits.pullback.snd g_R₂ s₂_Ω
        = e_C2Ω.inv ≫ e_C2Ω.hom ≫ snd_Ω := by rw [he_C2Ω_snd]
      _ = snd_Ω := e_C2Ω.inv_hom_id_assoc _

  have hInP_C2Ω : ∀ (i : Fin c) (q : ↥(CategoryTheory.Limits.pullback g_B s_B)),
      q ∈ Set.range (CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_Ω).base →
      e_C2Ω.inv.base q ∈ Set.range
        (CategoryTheory.Limits.pullback.snd
          (CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_C₂)
          (CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω)).base := by
    intro i q ⟨y_i, hy_i⟩
    let ι_i_Ω := CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_Ω
    let α_C₂ : CategoryTheory.Limits.pullback (ι_ℰ i) fst_Ω ⟶
        CategoryTheory.Limits.pullback g_B s₂ :=
      CategoryTheory.Limits.pullback.lift (ι_i_Ω ≫ fst_Ω) (ι_i_Ω ≫ snd_Ω ≫ s₂_Ω)
        (by
          calc
            (ι_i_Ω ≫ fst_Ω) ≫ g_B
              = ι_i_Ω ≫ snd_Ω ≫ s_B := by
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
            _ = (ι_i_Ω ≫ snd_Ω ≫ s₂_Ω) ≫ s₂ := by
                  symm
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hs₂_Ω_eq])
    let β_Ei : CategoryTheory.Limits.pullback (ι_ℰ i) fst_Ω ⟶
        CategoryTheory.Limits.pullback (ι_ℰ i) fst_C₂ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (ι_ℰ i) fst_Ω) α_C₂
        (by rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.condition])
    let γ_Ei : CategoryTheory.Limits.pullback (ι_ℰ i) fst_Ω ⟶
        CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd (ι_ℰ i) fst_C₂)
          (CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω) :=
      CategoryTheory.Limits.pullback.lift β_Ei (ι_i_Ω ≫ e_C2Ω.inv)
        (by
          rw [CategoryTheory.Limits.pullback.lift_snd]
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hinv_C2Ω_fst]
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition,
              CategoryTheory.Category.assoc ι_i_Ω, ← CategoryTheory.Category.assoc e_C2Ω.inv,
              hinv_C2Ω_snd])
    refine ⟨γ_Ei.base y_i, ?_⟩
    rw [← hy_i]
    change (γ_Ei ≫ CategoryTheory.Limits.pullback.snd _ _).base y_i =
      (ι_i_Ω ≫ e_C2Ω.inv).base y_i
    rw [CategoryTheory.Limits.pullback.lift_snd]

  have hForceTwo : ∀ q : ↥(CategoryTheory.Limits.pullback g_B s_B),
      q ∈ Set.range ι_Ω_i₀.base →
      ((∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_B s_B),
          E' ≠ Set.range ι_Ω_i₀.base ∧ q ∈ E') ∨
       (∃ j : Fin n, fst_Ω.base q ∈ Set.range (τ_B j).base)) →
      q = y₁ ∨ q = y₂ := by
    intro q hq_i₀ hq_sp
    let q' := e_C2Ω.inv.base q
    have hq'_P : q' ∈ Set.range
        (CategoryTheory.Limits.pullback.snd ι_P
          (CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω)).base :=
      hInP_C2Ω i₀ q hq_i₀
    have hq'_two : (CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω).base q' ∈
        Set.range (p₁_tilde ≫ ι_P).base ∪ Set.range (p₂_tilde ≫ ι_P).base := by
      rcases hq_sp with ⟨E', hE'_mem, hE'_ne, hq_E'⟩ | ⟨j, hq_sec⟩
      · have hE'_eq := hE'_mem
        rw [hFibΩ.2.2.2.2] at hE'_eq
        obtain ⟨i', rfl⟩ := hE'_eq
        have hi'_ne : i' ≠ i₀ := fun hEq => hE'_ne (by rw [hEq])
        let idx' : CompOther := ⟨i', hi'_ne⟩
        have hSc_S3 : S_c idx' ⊆ S₃ :=
          (Finset.subset_biUnion_of_mem S_c (Finset.mem_univ idx')).trans
            (Finset.subset_union_right.trans Finset.subset_union_left)
        have hs₂_fac : s₂_Ω =
            (s_B' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Subring.inclusion (hSub_of hSc_S3)))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_c idx'))) := by
          dsimp only [s₂_Ω]
          rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, hInc_comp_inc]
        have hEmp_Ω : IsEmpty ↥(CategoryTheory.Limits.pullback (q_Wc idx') s₂_Ω) := by
          rw [hs₂_fac]
          exact hEmpMono _ _ _ (hEmp_Sc idx')
        exact hImp_Wc idx' Ω s₂_Ω hEmp_Ω q' hq'_P (hInP_C2Ω i' q hq_E')
      · have hSs_S3 : S_s j ⊆ S₃ :=
          (Finset.subset_biUnion_of_mem S_s (Finset.mem_univ j)).trans Finset.subset_union_right
        have hs₂_fac : s₂_Ω =
            (s_B' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Subring.inclusion (hSub_of hSs_S3)))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subring.inclusion (hSub_s j))) := by
          dsimp only [s₂_Ω]
          rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, hInc_comp_inc]
        have hEmp_Ω : IsEmpty ↥(CategoryTheory.Limits.pullback (q_Ws j) s₂_Ω) := by
          rw [hs₂_fac]
          exact hEmpMono _ _ _ (hEmp_Ss j)
        let σ_Ω_j : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            CategoryTheory.Limits.pullback g_B s_B :=
          CategoryTheory.Limits.pullback.lift (s_B ≫ τ_B j) (𝟙 _)
            (by rw [CategoryTheory.Category.assoc, hSec j, CategoryTheory.Category.comp_id,
                  CategoryTheory.Category.id_comp])
        have hq_eq_σ : q = σ_Ω_j.base pt_Ω :=
          (((hSepSec C_B _ g_B (τ_B j) (hSec j)).2 Ω s_B σ_Ω_j
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)).2 q).mp hq_sec pt_Ω
        let lift_j : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            CategoryTheory.Limits.pullback (τ_R₂ j)
              (CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω) :=
          CategoryTheory.Limits.pullback.lift s₂_Ω (σ_Ω_j ≫ e_C2Ω.inv)
            (by
              apply CategoryTheory.Limits.pullback.hom_ext
              · calc
                  (s₂_Ω ≫ τ_R₂ j) ≫ fst_C₂
                    = s₂_Ω ≫ (s₂ ≫ τ_B j) := by
                        rw [CategoryTheory.Category.assoc, hτ_R₂_fst j]
                  _ = s_B ≫ τ_B j := by rw [← CategoryTheory.Category.assoc, hs₂_Ω_eq]
                  _ = σ_Ω_j ≫ fst_Ω := (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
                  _ = σ_Ω_j ≫ (e_C2Ω.inv ≫ CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω ≫ fst_C₂) := by
                        rw [hinv_C2Ω_fst]
                  _ = ((σ_Ω_j ≫ e_C2Ω.inv) ≫ CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω) ≫ fst_C₂ := by
                        simp only [CategoryTheory.Category.assoc]
              · calc
                  (s₂_Ω ≫ τ_R₂ j) ≫ g_R₂
                    = s₂_Ω := by
                        rw [CategoryTheory.Category.assoc, hτ_R₂_sec j,
                          CategoryTheory.Category.comp_id]
                  _ = (σ_Ω_j ≫ snd_Ω) ≫ s₂_Ω := by
                        rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
                  _ = σ_Ω_j ≫ (e_C2Ω.inv ≫ CategoryTheory.Limits.pullback.snd g_R₂ s₂_Ω) ≫ s₂_Ω := by
                        rw [hinv_C2Ω_snd, CategoryTheory.Category.assoc]
                  _ = ((σ_Ω_j ≫ e_C2Ω.inv) ≫ CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω) ≫ g_R₂ := by
                        rw [CategoryTheory.Category.assoc e_C2Ω.inv,
                          ← CategoryTheory.Limits.pullback.condition]
                        simp only [CategoryTheory.Category.assoc])
        have hq'_sec : q' ∈ Set.range
            (CategoryTheory.Limits.pullback.snd (τ_R₂ j)
              (CategoryTheory.Limits.pullback.fst g_R₂ s₂_Ω)).base := by
          refine ⟨lift_j.base pt_Ω, ?_⟩
          change (lift_j ≫ CategoryTheory.Limits.pullback.snd _ _).base pt_Ω = e_C2Ω.inv.base q
          rw [CategoryTheory.Limits.pullback.lift_snd, hq_eq_σ]
          rfl
        exact hImp_Ws j Ω s₂_Ω hEmp_Ω q' hq'_P hq'_sec
    have hq_round : e_C2Ω.hom.base q' = q := by
      change (e_C2Ω.inv ≫ e_C2Ω.hom).base q = q
      rw [e_C2Ω.inv_hom_id]; rfl
    rcases hq'_two with h1 | h2
    · have hq'_eq : q' = β₁.base pt_Ω :=
        (((hSepSec _ _ g_R₂ (p₁_tilde ≫ ι_P)
          (by rw [CategoryTheory.Category.assoc]; exact hp₁_sec)).2 Ω s₂_Ω β₁
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)).2 q').mp h1 pt_Ω
      left
      rw [← hq_round, hq'_eq]
    · have hq'_eq : q' = β₂.base pt_Ω :=
        (((hSepSec _ _ g_R₂ (p₂_tilde ≫ ι_P)
          (by rw [CategoryTheory.Category.assoc]; exact hp₂_sec)).2 Ω s₂_Ω β₂
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)).2 q').mp h2 pt_Ω
      right
      rw [← hq_round, hq'_eq]

  have h1 := hForceTwo q₁ hq1E (hSpec_Ω q₁ (Or.inl rfl))
  have h2 := hForceTwo q₂ hq2E (hSpec_Ω q₂ (Or.inr (Or.inl rfl)))
  have h3 := hForceTwo q₃ hq3E (hSpec_Ω q₃ (Or.inr (Or.inr rfl)))
  rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;> rcases h3 with h3 | h3
  · exact hq12 (h1.trans h2.symm)
  · exact hq12 (h1.trans h2.symm)
  · exact hq13 (h1.trans h3.symm)
  · exact hq23 (h2.trans h3.symm)
  · exact hq23 (h2.trans h3.symm)
  · exact hq13 (h1.trans h3.symm)
  · exact hq12 (h1.trans h2.symm)
  · exact hq12 (h1.trans h2.symm)

theorem weil_noetherian_constructible_geomStableFiber_locus (R : Type u) [CommRing R] [IsNoetherianRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (n : ℕ)
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C))
    (hn : 3 ≤ n)
    (hFlat : AlgebraicGeometry.Flat g)
    (hProp : AlgebraicGeometry.IsProper g)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (hSurj : AlgebraicGeometry.Surjective g)
    (hSec : ∀ j : Fin n, τ j ≫ g = 𝟙 _)
    (hDisj : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ i).base) (Set.range (τ j).base))
    (hSmSec : ∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of R)),
      ∃ W : C.Opens, (τ j).base b ∈ W ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g))
    (hArtinNodal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
        [AlgebraicGeometry.LocallyOfFiniteType p_Y],
      (∀ y : Y, HasSpreadSmoothOrNodalAt p_Y y) ↔
        (AlgebraicGeometry.IsReduced Y ∧
         ∀ (D : Type u) [CommRing D] [Algebra Ω D]
           (j_D : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ Y),
           AlgebraicGeometry.IsOpenImmersion j_D →
           j_D ≫ p_Y = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω D)) →
           ∀ (q : PrimeSpectrum D), q.asIdeal.IsMaximal →
             let L := Localization.AtPrime q.asIdeal
             let 𝔪 : Ideal L := IsLocalRing.maximalIdeal L
             Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 2 ∨
               (Module.finrank Ω (L ⧸ 𝔪 ^ 2) = 3 ∧
                Module.finrank Ω (L ⧸ 𝔪 ^ 3) = 5 ∧
                ∃ u v : L, Ideal.span {u, v} = 𝔪 ∧ u * v ∈ 𝔪 ^ 3)))
    (hAlgClosedIff : ∀ {C' S' : AlgebraicGeometry.Scheme.{u}}
        (g' : C' ⟶ S') (τ' : Fin n → (S' ⟶ C')),
      AlgebraicGeometry.IsProper g' →
      AlgebraicGeometry.LocallyOfFinitePresentation g' →
      (∀ j : Fin n, τ' j ≫ g' = 𝟙 S') →
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ' i).base) (Set.range (τ' j).base)) →
      ∀ (Ω₁ Ω₂ : Type u) [Field Ω₁] [IsAlgClosed Ω₁] [Field Ω₂] [IsAlgClosed Ω₂]
        (φ : Ω₁ →+* Ω₂) (s₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω₁) ⟶ S'),
        HasSpreadGeomStableFiber g' n τ' Ω₁ s₁ ↔
          HasSpreadGeomStableFiber g' n τ' Ω₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ s₁)) :
    Topology.IsConstructible
      {p : PrimeSpectrum R |
        HasSpreadGeomStableFiber g n τ (AlgebraicClosure p.asIdeal.ResidueField)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              ((algebraMap p.asIdeal.ResidueField
                  (AlgebraicClosure p.asIdeal.ResidueField)).comp
                (algebraMap R p.asIdeal.ResidueField))))} :=
by
  let _ := hSmSec
  have hNoethConstr : ∀ (P : PrimeSpectrum R → Prop),
      (∀ (p : PrimeSpectrum R),
        letI : IsDomain (R ⧸ p.asIdeal) := Ideal.Quotient.isDomain p.asIdeal
        let π : R →+* (R ⧸ p.asIdeal) := Ideal.Quotient.mk p.asIdeal
        (P p →
          ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
            (ψ : (R ⧸ p.asIdeal) →+* B)
            (ι_B : B →+* AlgebraicClosure (FractionRing (R ⧸ p.asIdeal))),
            RingHom.FiniteType ψ ∧
            ι_B.comp ψ =
              (algebraMap (FractionRing (R ⧸ p.asIdeal))
                (AlgebraicClosure (FractionRing (R ⧸ p.asIdeal)))).comp
                (algebraMap (R ⧸ p.asIdeal) (FractionRing (R ⧸ p.asIdeal))) ∧
            Function.Injective ι_B ∧
            ∀ q : PrimeSpectrum B, P (PrimeSpectrum.comap (ψ.comp π) q)) ∧
        (¬ P p →
          ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B)
            (ψ : (R ⧸ p.asIdeal) →+* B)
            (ι_B : B →+* AlgebraicClosure (FractionRing (R ⧸ p.asIdeal))),
            RingHom.FiniteType ψ ∧
            ι_B.comp ψ =
              (algebraMap (FractionRing (R ⧸ p.asIdeal))
                (AlgebraicClosure (FractionRing (R ⧸ p.asIdeal)))).comp
                (algebraMap (R ⧸ p.asIdeal) (FractionRing (R ⧸ p.asIdeal))) ∧
            Function.Injective ι_B ∧
            ∀ q : PrimeSpectrum B, ¬ P (PrimeSpectrum.comap (ψ.comp π) q))) →
      Topology.IsConstructible {p : PrimeSpectrum R | P p} := by
    intro P hDom
    have hZeroConstr : ∀ I : Ideal R,
        Topology.IsConstructible (PrimeSpectrum.zeroLocus (I : Set R)) := by
      intro I
      obtain ⟨F, hF⟩ := (IsNoetherian.noetherian I : I.FG)
      have hEq : PrimeSpectrum.zeroLocus (I : Set R) =
          ⋂ f ∈ (F : Set R), (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R))ᶜ := by
        rw [← hF, PrimeSpectrum.zeroLocus_span]
        ext q
        simp only [PrimeSpectrum.mem_zeroLocus, Set.mem_iInter, Set.mem_compl_iff,
          SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, not_not]
        exact ⟨fun h i hi => h (Finset.mem_coe.mpr hi), fun h i hi => h i (Finset.mem_coe.mp hi)⟩
      rw [hEq]
      exact Topology.IsConstructible.biInter F.finite_toSet fun f _ =>
        (PrimeSpectrum.isConstructible_basicOpen (f := f)).compl
    have hChev : ∀ (p : PrimeSpectrum R)
        (B : Type u) [CommRing B] [IsDomain B]
        (ψ : (R ⧸ p.asIdeal) →+* B)
        (ι_B : B →+* AlgebraicClosure (FractionRing (R ⧸ p.asIdeal))),
        RingHom.FiniteType ψ →
        (letI : IsDomain (R ⧸ p.asIdeal) := Ideal.Quotient.isDomain p.asIdeal
         ι_B.comp ψ =
           (algebraMap (FractionRing (R ⧸ p.asIdeal))
             (AlgebraicClosure (FractionRing (R ⧸ p.asIdeal)))).comp
             (algebraMap (R ⧸ p.asIdeal) (FractionRing (R ⧸ p.asIdeal)))) →
        ∃ r : R, r ∉ p.asIdeal ∧
          PrimeSpectrum.zeroLocus (p.asIdeal : Set R) ∩
              (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R)) ⊆
            Set.range (PrimeSpectrum.comap (ψ.comp (Ideal.Quotient.mk p.asIdeal))) := by
      intro p B _ _ ψ ι_B hFT hComp
      let A := R ⧸ p.asIdeal
      let _ : IsDomain A := Ideal.Quotient.isDomain p.asIdeal
      let _ : IsNoetherianRing A := Ideal.Quotient.isNoetherianRing p.asIdeal
      let π : R →+* A := Ideal.Quotient.mk p.asIdeal
      have hInjComp : Function.Injective (ι_B.comp ψ) := by
        rw [hComp]
        exact (RingHom.injective
          (algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A)))).comp
          (IsFractionRing.injective A (FractionRing A))
      have hInjΨ : Function.Injective ψ := Function.Injective.of_comp hInjComp
      have hFP : RingHom.FinitePresentation ψ := RingHom.FinitePresentation.of_finiteType.mp hFT
      have hConstr : Topology.IsConstructible (Set.range (PrimeSpectrum.comap ψ)) :=
        PrimeSpectrum.isConstructible_range_comap hFP
      obtain ⟨S_data, hS_data⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hConstr
      let q_bot_B : PrimeSpectrum B := ⟨⊥, inferInstance⟩
      let q_bot_A : PrimeSpectrum A := ⟨⊥, inferInstance⟩
      have hComapBot : PrimeSpectrum.comap ψ q_bot_B = q_bot_A := by
        apply PrimeSpectrum.ext
        ext a
        change ψ a ∈ (⊥ : Ideal B) ↔ a ∈ (⊥ : Ideal A)
        simp only [Ideal.mem_bot]
        exact ⟨fun h => hInjΨ (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩
      have hMemBot : q_bot_A ∈ S_data.toSet := by
        rw [hS_data]
        exact ⟨q_bot_B, hComapBot⟩
      unfold PrimeSpectrum.ConstructibleSetData.toSet PrimeSpectrum.BasicConstructibleSetData.toSet at hMemBot
      rw [Set.mem_iUnion₂] at hMemBot
      obtain ⟨x, hx, hx_zero, hx_not_zero⟩ := hMemBot
      have hxf_ne : x.f ≠ 0 := by
        intro h0
        apply hx_not_zero
        simp [q_bot_A, h0]
      obtain ⟨r, hr_eq⟩ := Ideal.Quotient.mk_surjective x.f
      have hr_not_mem : r ∉ p.asIdeal := by
        intro hr_mem
        apply hxf_ne
        rw [← hr_eq, Ideal.Quotient.eq_zero_iff_mem]
        exact hr_mem
      refine ⟨r, hr_not_mem, ?_⟩
      rintro p' ⟨hp'_le, hp'_basic⟩
      have hp'_le_ideal : p.asIdeal ≤ p'.asIdeal := hp'_le
      have hp'_not_mem : r ∉ p'.asIdeal := hp'_basic
      let I_A : Ideal A := Ideal.map π p'.asIdeal
      have hKerLe : RingHom.ker π ≤ p'.asIdeal := by
        rw [Ideal.mk_ker]
        exact hp'_le_ideal
      have hComapIA : Ideal.comap π I_A = p'.asIdeal := by
        change Ideal.comap π (Ideal.map π p'.asIdeal) = p'.asIdeal
        rw [Ideal.comap_map_of_surjective π Ideal.Quotient.mk_surjective]
        exact sup_eq_left.mpr hKerLe
      have hPrimeIA : I_A.IsPrime := by
        refine ⟨?_, ?_⟩
        · intro hTop
          have h1 : (1 : R) ∈ Ideal.comap π I_A := by
            rw [hTop]
            trivial
          rw [hComapIA] at h1
          exact p'.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
        · intro a b hab
          obtain ⟨ra, rfl⟩ := Ideal.Quotient.mk_surjective a
          obtain ⟨rb, rfl⟩ := Ideal.Quotient.mk_surjective b
          have hrab : ra * rb ∈ Ideal.comap π I_A := by
            simpa [Ideal.mem_comap, map_mul] using hab
          rw [hComapIA] at hrab
          rcases p'.isPrime.mem_or_mem hrab with ha | hb
          · exact Or.inl (Ideal.mem_map_of_mem π ha)
          · exact Or.inr (Ideal.mem_map_of_mem π hb)
      let q_A : PrimeSpectrum A := ⟨I_A, hPrimeIA⟩
      have hqA_mem : q_A ∈ S_data.toSet := by
        unfold PrimeSpectrum.ConstructibleSetData.toSet PrimeSpectrum.BasicConstructibleSetData.toSet
        rw [Set.mem_iUnion₂]
        refine ⟨x, hx, ?_, ?_⟩
        · intro z hz
          rcases hz with ⟨i, rfl⟩
          have hxg0 : x.g i = 0 := hx_zero ⟨i, rfl⟩
          rw [hxg0]
          exact zero_mem _
        · rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
          change x.f ∉ I_A
          rw [← hr_eq]
          intro hMem
          have hr_in : r ∈ Ideal.comap π I_A := hMem
          rw [hComapIA] at hr_in
          exact hp'_not_mem hr_in
      rw [hS_data] at hqA_mem
      obtain ⟨q_B, hq_B⟩ := hqA_mem
      refine ⟨q_B, ?_⟩
      apply PrimeSpectrum.ext
      ext s
      have hqB_ideal : Ideal.comap ψ q_B.asIdeal = I_A :=
        congrArg PrimeSpectrum.asIdeal hq_B
      calc
        s ∈ (PrimeSpectrum.comap (ψ.comp π) q_B).asIdeal
          ↔ π s ∈ Ideal.comap ψ q_B.asIdeal := Iff.rfl
        _ ↔ π s ∈ I_A := by rw [hqB_ideal]
        _ ↔ s ∈ Ideal.comap π I_A := Iff.rfl
        _ ↔ s ∈ p'.asIdeal := by rw [hComapIA]
    let E : Set (PrimeSpectrum R) := {p : PrimeSpectrum R | P p}
    have hMain : ∀ I : Ideal R, Topology.IsConstructible (E ∩ PrimeSpectrum.zeroLocus (I : Set R)) := by
      intro I₀
      refine WellFounded.induction (inferInstance : IsNoetherian R R).wf I₀
        (C := fun I : Ideal R => Topology.IsConstructible (E ∩ PrimeSpectrum.zeroLocus (I : Set R))) ?_
      intro (I : Ideal R) ih
      by_cases hTop : I = ⊤
      · have hEmpty : E ∩ PrimeSpectrum.zeroLocus (I : Set R) = ∅ := by
          rw [hTop]
          ext q
          simp only [Set.mem_inter_iff, PrimeSpectrum.mem_zeroLocus, Set.mem_empty_iff_false, iff_false,
            not_and]
          intro _ hle
          exact q.isPrime.ne_top
            (Ideal.eq_top_of_isUnit_mem _ (hle (by trivial : (1 : R) ∈ (⊤ : Ideal R))) isUnit_one)
        rw [hEmpty]
        exact Topology.IsConstructible.empty
      · by_cases hRad : I.radical ≤ I
        · by_cases hPrime : I.IsPrime
          · let p : PrimeSpectrum R := ⟨I, hPrime⟩
            by_cases hPp : P p
            · obtain ⟨B, instCR, instDom, ψ, ι_B, hFT, hComp, _, hAllB⟩ := (hDom p).1 hPp
              let _ : CommRing B := instCR
              let _ : IsDomain B := instDom
              obtain ⟨r, hr_not_mem, hr_sub⟩ := hChev p B ψ ι_B hFT hComp
              let I' : Ideal R := I ⊔ Ideal.span {r}
              have hlt' : I' > I := lt_of_le_not_ge le_sup_left (fun hle =>
                hr_not_mem (hle (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton r)))))
              have hSplit :
                  E ∩ PrimeSpectrum.zeroLocus (I : Set R) =
                    (PrimeSpectrum.zeroLocus (I : Set R) ∩
                      (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R))) ∪
                    (E ∩ PrimeSpectrum.zeroLocus (I' : Set R)) := by
                ext q
                constructor
                · rintro ⟨hqE, hqI⟩
                  by_cases hrq : r ∈ q.asIdeal
                  · right
                    refine ⟨hqE, ?_⟩
                    change (I' : Set R) ⊆ (q.asIdeal : Set R)
                    exact sup_le hqI (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hrq))
                  · left
                    exact ⟨hqI, hrq⟩
                · rintro (hqBasic | ⟨hqE, hqI'⟩)
                  · obtain ⟨q_B, rfl⟩ := hr_sub hqBasic
                    exact ⟨hAllB q_B, hqBasic.1⟩
                  · exact ⟨hqE, fun z hz => hqI' (Ideal.mem_sup_left hz)⟩
              rw [hSplit]
              exact ((hZeroConstr I).inter
                (PrimeSpectrum.isConstructible_basicOpen (f := r))).union (ih I' hlt')
            · obtain ⟨B, instCR, instDom, ψ, ι_B, hFT, hComp, _, hNoneB⟩ := (hDom p).2 hPp
              let _ : CommRing B := instCR
              let _ : IsDomain B := instDom
              obtain ⟨r, hr_not_mem, hr_sub⟩ := hChev p B ψ ι_B hFT hComp
              let I' : Ideal R := I ⊔ Ideal.span {r}
              have hlt' : I' > I := lt_of_le_not_ge le_sup_left (fun hle =>
                hr_not_mem (hle (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton r)))))
              have hEq :
                  E ∩ PrimeSpectrum.zeroLocus (I : Set R) =
                    E ∩ PrimeSpectrum.zeroLocus (I' : Set R) := by
                ext q
                constructor
                · rintro ⟨hqE, hqI⟩
                  refine ⟨hqE, ?_⟩
                  by_cases hrq : r ∈ q.asIdeal
                  · change (I' : Set R) ⊆ (q.asIdeal : Set R)
                    exact sup_le hqI (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hrq))
                  · exfalso
                    obtain ⟨q_B, rfl⟩ := hr_sub ⟨hqI, hrq⟩
                    exact hNoneB q_B hqE
                · rintro ⟨hqE, hqI'⟩
                  exact ⟨hqE, fun z hz => hqI' (Ideal.mem_sup_left hz)⟩
              rw [hEq]
              exact ih I' hlt'
          · have hEx : ∃ x y : R, x * y ∈ I ∧ x ∉ I ∧ y ∉ I := by
              by_contra hNo
              apply hPrime
              refine ⟨hTop, fun {x y} hxy => ?_⟩
              by_contra hNotOr
              exact hNo ⟨x, y, hxy, fun hx => hNotOr (Or.inl hx), fun hy => hNotOr (Or.inr hy)⟩
            obtain ⟨x, y, hxy, hx, hy⟩ := hEx
            let I₁ : Ideal R := I ⊔ Ideal.span {x}
            let I₂ : Ideal R := I ⊔ Ideal.span {y}
            have hlt₁ : I₁ > I := lt_of_le_not_ge le_sup_left (fun hle =>
              hx (hle (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton x)))))
            have hlt₂ : I₂ > I := lt_of_le_not_ge le_sup_left (fun hle =>
              hy (hle (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton y)))))
            have hUnion :
                E ∩ PrimeSpectrum.zeroLocus (I : Set R) =
                  (E ∩ PrimeSpectrum.zeroLocus (I₁ : Set R)) ∪
                  (E ∩ PrimeSpectrum.zeroLocus (I₂ : Set R)) := by
              ext q
              constructor
              · rintro ⟨hqE, hqI⟩
                have hxy_q : x * y ∈ q.asIdeal := hqI hxy
                rcases q.isPrime.mem_or_mem hxy_q with hxq | hyq
                · left
                  refine ⟨hqE, ?_⟩
                  change (I₁ : Set R) ⊆ (q.asIdeal : Set R)
                  exact sup_le hqI (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxq))
                · right
                  refine ⟨hqE, ?_⟩
                  change (I₂ : Set R) ⊆ (q.asIdeal : Set R)
                  exact sup_le hqI (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hyq))
              · rintro (⟨hqE, hqI₁⟩ | ⟨hqE, hqI₂⟩)
                · exact ⟨hqE, fun z hz => hqI₁ (Ideal.mem_sup_left hz)⟩
                · exact ⟨hqE, fun z hz => hqI₂ (Ideal.mem_sup_left hz)⟩
            rw [hUnion]
            exact (ih I₁ hlt₁).union (ih I₂ hlt₂)
        · have hltRad : I.radical > I := lt_of_le_not_ge Ideal.le_radical hRad
          rw [← PrimeSpectrum.zeroLocus_radical I]
          exact ih I.radical hltRad
    have hBot := hMain ⊥
    rwa [PrimeSpectrum.zeroLocus_bot, Set.inter_univ] at hBot

  have hTransportIso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} {Ω : Type u} [Field Ω]
      (p₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (p₂ : Y₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (M₁ : Fin n → Set ↥Y₁) (M₂ : Fin n → Set ↥Y₂)
      (e : Y₁ ≅ Y₂) (hep : e.hom ≫ p₂ = p₁)
      (hM : ∀ (j : Fin n) (q₁ : ↥Y₁), q₁ ∈ M₁ j ↔ e.hom.base q₁ ∈ M₂ j),
      (ConnectedSpace ↥Y₁ ∧
       (∀ y₁ : ↥Y₁, HasSpreadSmoothOrNodalAt p₁ y₁) ∧
       (∀ (E : Set ↥Y₁) (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Y₁),
         E ∈ irreducibleComponents ↥Y₁ →
         AlgebraicGeometry.IsClosedImmersion ιE →
         AlgebraicGeometry.IsIntegral E_sch →
         Set.range ιE.base = E →
         (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
           ιE ≫ p₁ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
         ∃ q₁ q₂ q₃ : ↥Y₁,
           q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
           q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
           (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y₁),
             (∃ E' ∈ irreducibleComponents ↥Y₁, E' ≠ E ∧ q ∈ E') ∨
             (∃ j : Fin n, q ∈ M₁ j)))) →
      (ConnectedSpace ↥Y₂ ∧
       (∀ y₂ : ↥Y₂, HasSpreadSmoothOrNodalAt p₂ y₂) ∧
       (∀ (E : Set ↥Y₂) (E_sch : AlgebraicGeometry.Scheme.{u}) (ιE : E_sch ⟶ Y₂),
         E ∈ irreducibleComponents ↥Y₂ →
         AlgebraicGeometry.IsClosedImmersion ιE →
         AlgebraicGeometry.IsIntegral E_sch →
         Set.range ιE.base = E →
         (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left,
           ιE ≫ p₂ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom) →
         ∃ q₁ q₂ q₃ : ↥Y₂,
           q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
           q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
           (∀ q ∈ ({q₁, q₂, q₃} : Set ↥Y₂),
             (∃ E' ∈ irreducibleComponents ↥Y₂, E' ≠ E ∧ q ∈ E') ∨
             (∃ j : Fin n, q ∈ M₂ j)))) := by
    intro Y₁ Y₂ Ω _ p₁ p₂ M₁ M₂ e hep hM ⟨hConn₁, hSmNod₁, hComp₁⟩
    let hTop : ↥Y₁ ≃ₜ ↥Y₂ := TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e)
    have hhTop : ∀ x : ↥Y₁, hTop x = e.hom.base x := fun _ => rfl
    have hhTopSymm : ∀ y : ↥Y₂, hTop.symm y = e.inv.base y := fun _ => rfl
    have heinv_p : e.inv ≫ p₁ = p₂ := by
      rw [← hep, ← CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.id_comp]
    refine ⟨?_, ?_, ?_⟩
    · exact hTop.surjective.connectedSpace hTop.continuous
    · intro y₂
      rcases hSmNod₁ (e.inv.base y₂) with ⟨V₁, hy₁, hSm₁⟩ |
          ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hIdeal, hComm⟩
      · left
        let V₂ : Y₂.Opens := e.inv ⁻¹ᵁ V₁
        refine ⟨V₂, hy₁, ?_⟩
        let e_V : V₂.toScheme ⟶ V₁.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift V₁.ι (V₂.ι ≫ e.inv) (by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨x, rfl⟩
            exact x.2)
        have hPbV_iso : CategoryTheory.IsPullback e_V V₂.ι V₁.ι e.inv :=
          AlgebraicGeometry.IsOpenImmersion.isPullback e_V V₂.ι V₁.ι e.inv
            (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
            (by ext x; simp [V₂, AlgebraicGeometry.Scheme.Opens.opensRange_ι])
        have hPbBot : CategoryTheory.IsPullback e.inv p₂ p₁
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) :=
          CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [heinv_p, CategoryTheory.Category.comp_id]⟩
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (hPbV_iso.paste_vert hPbBot) hSm₁
      · right
        refine ⟨U', u₀, e₁ ≫ e.hom, e₂, ?_, hEt₂, ?_, hIdeal, ?_⟩
        · infer_instance
        · change e.hom.base (e₁.base u₀) = y₂
          rw [hu₀, ← hhTop, ← hhTopSymm, hTop.apply_symm_apply]
        · rw [CategoryTheory.Category.assoc, hep, hComm]
    · intro E₂ E_sch ιE₂ hE₂ hCl₂ hIntE hRange₂ ⟨isoP1, hisoP1⟩
      let E₁ : Set ↥Y₁ := hTop.symm '' E₂
      let ιE₁ : E_sch ⟶ Y₁ := ιE₂ ≫ e.inv
      have hE₁ : E₁ ∈ irreducibleComponents ↥Y₁ :=
        image_mem_irreducibleComponents_of_isPreirreducible_fiber hTop.symm
          hTop.symm.continuous hTop.symm.isOpenMap
          (fun x => (Set.subsingleton_singleton.preimage hTop.symm.injective).isPreirreducible)
          hTop.symm.surjective hE₂
      have hCl₁ : AlgebraicGeometry.IsClosedImmersion ιE₁ := inferInstance
      have hRange₁ : Set.range ιE₁.base = E₁ := by
        change Set.range (hTop.symm ∘ ιE₂.base) = hTop.symm '' E₂
        rw [Set.range_comp, hRange₂]
      have hisoP1_1 : ιE₁ ≫ p₁ = isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom := by
        rw [CategoryTheory.Category.assoc, heinv_p, hisoP1]
      obtain ⟨q₁, q₂, q₃, hq12, hq13, hq23, hq1E, hq2E, hq3E, hSpec⟩ :=
        hComp₁ E₁ E_sch ιE₁ hE₁ hCl₁ hIntE hRange₁ ⟨isoP1, hisoP1_1⟩
      refine ⟨hTop q₁, hTop q₂, hTop q₃,
        hTop.injective.ne hq12, hTop.injective.ne hq13, hTop.injective.ne hq23,
        ?_, ?_, ?_, ?_⟩
      · rcases hq1E with ⟨z, hz, rfl⟩; simpa using hz
      · rcases hq2E with ⟨z, hz, rfl⟩; simpa using hz
      · rcases hq3E with ⟨z, hz, rfl⟩; simpa using hz
      · intro q' hq'
        have hq'_ex : ∃ q ∈ ({q₁, q₂, q₃} : Set ↥Y₁), hTop q = q' := by
          rcases hq' with rfl | rfl | rfl
          · exact ⟨q₁, by simp, rfl⟩
          · exact ⟨q₂, by simp, rfl⟩
          · exact ⟨q₃, by simp, rfl⟩
        obtain ⟨q, hq_set, rfl⟩ := hq'_ex
        rcases hSpec q hq_set with ⟨E'₁, hE'₁_mem, hE'₁_ne, hq_E'₁⟩ | ⟨j, hq_M₁⟩
        · left
          refine ⟨hTop '' E'₁,
