  have hDimB₃_m : topologicalKrullDim B₃.left = (m : WithBot ℕ∞) :=
    hDimB₃.trans (hDimB'₃.trans (hDimB_fin.trans hDimB₂))
  have hη₃_ψ₃ : η₃ ≫ ψ₃.left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ ↥L_sub)) ≫ η₀ := by
    change η₃ ≫ ν.left ≫ π'.left ≫ π_fin.left = _
    rw [← Category.assoc η₃, hη₃_ν, ← Category.assoc ξ_L, hξL_fin, hη_fin_B₂]
  let O_B₃ : Fin M → B₃.left.Opens :=
    fun i => (TopologicalSpace.Opens.map ν.left.base).obj (O_reg i)
  let ev_B₃ : ∀ i : Fin M,
      (O_B₃ i).toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    fun i => (ν.left ∣_ O_reg i) ≫ ev_reg i
  have hη₃_range_O : ∀ i : Fin M, Set.range η₃.base ⊆ Set.range (O_B₃ i).ι.base := by
    rintro i _ ⟨pt, rfl⟩
    have hmem : η₃.base pt ∈ O_B₃ i := by
      change (η₃ ≫ ν.left).base pt ∈ (O_reg i : Set B'₃.left)
      rw [hη₃_ν, ← hξOreg_ι i]
      exact ((ξ_Oreg i).base pt).2
    exact ⟨⟨η₃.base pt, hmem⟩, rfl⟩
  let ξ_B₃ : ∀ i : Fin M,
      AlgebraicGeometry.Spec (CommRingCat.of ↥L_sub) ⟶ (O_B₃ i).toScheme :=
    fun i => AlgebraicGeometry.IsOpenImmersion.lift (O_B₃ i).ι η₃ (hη₃_range_O i)
  have hξB₃_ι : ∀ i : Fin M, ξ_B₃ i ≫ (O_B₃ i).ι = η₃ :=
    fun i => AlgebraicGeometry.IsOpenImmersion.lift_fac (O_B₃ i).ι η₃ (hη₃_range_O i)
  have hξB₃_ev : ∀ i : Fin M, ξ_B₃ i ≫ ev_B₃ i =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.aeval (f_rat i)).toRingHom) := by
    intro i
    have hfac : ξ_B₃ i ≫ (ν.left ∣_ O_reg i) = ξ_Oreg i := by
      rw [← cancel_mono (O_reg i).ι, Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← Category.assoc, hξB₃_ι i, hη₃_ν, hξOreg_ι i]
    dsimp [ev_B₃]
    rw [← Category.assoc, hfac, hξOreg_ev i]
    rfl
  have hVal_B₃ : ∀ (i : Fin M) (W_val : ValuationSubring K),
      (∀ c : k, algebraMap k K c ∈ W_val) →
      algebraMap ↥L_sub K (f_rat i) ∈ W_val →
      ∀ (w : AlgebraicGeometry.Spec (CommRingCat.of ↥W_val) ⟶ B₃.left),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_val.subtype) ≫ w =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_sub K)) ≫ η₃ →
        ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥W_val)), w.base pt ∈ O_B₃ i := by
    intro i W_val hkW hfW w hw_comm pt
    have hw_ν : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_val.subtype) ≫ (w ≫ ν.left) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_sub K)) ≫ ξ_L := by
      rw [← Category.assoc, hw_comm, Category.assoc, hη₃_ν]
    exact hVal_reg i W_val hkW hfW (w ≫ ν.left) hw_ν pt
  have hF_in_rat : ∀ (a : Fin N₀) (x : K), x ∈ F_chart a →
      ∃ i : Fin M, algebraMap ↥L_sub K (f_rat i) = x := by
    intro a x hx
    have hx_all : x ∈ F_all := Finset.mem_biUnion.mpr ⟨a, Finset.mem_univ a, hx⟩
    refine ⟨e_all.symm ⟨x, hx_all⟩, ?_⟩
    change (e_all (e_all.symm ⟨x, hx_all⟩)).1 = x
    rw [e_all.apply_symm_apply]
  obtain ⟨W', μ_chart, hCover, hμ_comm, hμ_dom⟩ :=
    hChevalley B₃ hIntB₃ ψ₃ ↥L_sub η₃ hη₃_hom hη₃_ψ₃ hFuncB₃
      M f_rat O_B₃ ev_B₃ ξ_B₃ hξB₃_ι hξB₃_ev hVal_B₃ hF_in_rat
  exact ⟨B₃, ψ₃, W', μ_chart, hIntB₃, hProjB₃, hDimB₃_m, hNormB₃, hAlt_ψ₃,
    hCover, hμ_comm, hμ_dom⟩

theorem weil_baseChange_stable_curve_and_local_pullback_iso (k : Type u) [Field k]
    (B₂ X₂ B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (ψ₃ : B₃ ⟶ B₂)
    (U₃ W_a : B₃.left.Opens)
    (A₀ A_V : CommRingCat.{u})
    (ρ_V : AlgebraicGeometry.Spec A_V ⟶ AlgebraicGeometry.Spec A₀)
    (π_V : AlgebraicGeometry.Spec A_V ⟶ B₂.left)
    (D_V : (AlgebraicGeometry.Spec A_V).Opens)
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec A₀)
    (τ₀ : Fin n → (AlgebraicGeometry.Spec A₀ ⟶ C₀))
    (hStab₀ : IsGeometricStablePointedCurve g₀ n τ₀)
    (hIsoChart : IsAffineChartOpenPointedIso k f₂ σ π_V D_V
      (CategoryTheory.Limits.pullback.snd g₀ ρ_V)
      (fun j => CategoryTheory.Limits.pullback.lift (ρ_V ≫ τ₀ j) (𝟙 _)
        (by rw [CategoryTheory.Category.assoc, hStab₀.2.2.2.2.2.1 j,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])))
    (μ_a : W_a.toScheme ⟶ AlgebraicGeometry.Spec A_V)
    (hμ_comm : μ_a ≫ π_V = W_a.ι ≫ ψ₃.left)
    (hU₃_in_D : ∀ x : W_a.toScheme, W_a.ι.base x ∈ U₃ → μ_a.base x ∈ D_V) :
    ∃ (C_a : AlgebraicGeometry.Scheme.{u})
      (g_a : C_a ⟶ W_a.toScheme)
      (τ_a : Fin n → (W_a.toScheme ⟶ C_a)),
      IsGeometricStablePointedCurve g_a n τ_a ∧
      HasLocalPointedPullbackIsoOnOpen k f₂ σ ψ₃ U₃ W_a g_a τ_a :=
by
  let C_V : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g₀ ρ_V
  let g_V : C_V ⟶ AlgebraicGeometry.Spec A_V := CategoryTheory.Limits.pullback.snd g₀ ρ_V
  let p₀ : C_V ⟶ C₀ := CategoryTheory.Limits.pullback.fst g₀ ρ_V
  let τ_V : Fin n → (AlgebraicGeometry.Spec A_V ⟶ C_V) :=
    fun j => CategoryTheory.Limits.pullback.lift (ρ_V ≫ τ₀ j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hStab₀.2.2.2.2.2.1 j,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hSec_V : ∀ j : Fin n, τ_V j ≫ g_V = 𝟙 (AlgebraicGeometry.Spec A_V) :=
    fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hτ_V_comm : ∀ j : Fin n, τ_V j ≫ p₀ = ρ_V ≫ τ₀ j :=
    fun j => CategoryTheory.Limits.pullback.lift_fst _ _ _
  let C_a : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g_V μ_a
  let g_a : C_a ⟶ W_a.toScheme := CategoryTheory.Limits.pullback.snd g_V μ_a
  let p_V : C_a ⟶ C_V := CategoryTheory.Limits.pullback.fst g_V μ_a
  let τ_a : Fin n → (W_a.toScheme ⟶ C_a) :=
    fun j => CategoryTheory.Limits.pullback.lift (μ_a ≫ τ_V j) (𝟙 _)
      (by rw [CategoryTheory.Category.assoc, hSec_V j,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hSec_a : ∀ j : Fin n, τ_a j ≫ g_a = 𝟙 W_a.toScheme :=
    fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hτ_a_comm : ∀ j : Fin n, τ_a j ≫ p_V = μ_a ≫ τ_V j :=
    fun j => CategoryTheory.Limits.pullback.lift_fst _ _ _
  let p_tot : C_a ⟶ C₀ := p_V ≫ p₀
  let θ_a : W_a.toScheme ⟶ AlgebraicGeometry.Spec A₀ := μ_a ≫ ρ_V
  have hp_V : CategoryTheory.IsPullback p_V g_a g_V μ_a :=
    CategoryTheory.IsPullback.of_hasPullback g_V μ_a
  have hp₀ : CategoryTheory.IsPullback p₀ g_V g₀ ρ_V :=
    CategoryTheory.IsPullback.of_hasPullback g₀ ρ_V
  have hp_tot : CategoryTheory.IsPullback p_tot g_a g₀ θ_a :=
    hp_V.paste_horiz hp₀
  have hτ_tot_comm : ∀ j : Fin n, τ_a j ≫ p_tot = θ_a ≫ τ₀ j := by
    intro j
    change τ_a j ≫ (p_V ≫ p₀) = (μ_a ≫ ρ_V) ≫ τ₀ j
    rw [← CategoryTheory.Category.assoc, hτ_a_comm j, CategoryTheory.Category.assoc,
      hτ_V_comm j, ← CategoryTheory.Category.assoc]

  refine ⟨C_a, g_a, τ_a, ?_, ?_⟩
  · 
    rcases hStab₀ with ⟨hn, hFlat₀, hProp₀, hLFP₀, hSurj₀, hSec₀, hDisj₀, hSmSec₀, hGeom₀⟩
    have hFlat_a : AlgebraicGeometry.Flat g_a :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Flat) hp_tot hFlat₀
    have hProp_a : AlgebraicGeometry.IsProper g_a :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsProper) hp_tot hProp₀
    have hLFP_a : AlgebraicGeometry.LocallyOfFinitePresentation g_a :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation) hp_tot hLFP₀
    have hSurj_a : AlgebraicGeometry.Surjective g_a :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Surjective) hp_tot hSurj₀
    have hDisj_a : _root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_a i).base) (Set.range (τ_a j).base) := by
      intro i j hij
      rw [Set.disjoint_left]
      rintro z ⟨w₁, rfl⟩ ⟨w₂, hw₂⟩
      have hz_i : p_tot.base ((τ_a i).base w₁) ∈ Set.range (τ₀ i).base := by
        have h1 : p_tot.base ((τ_a i).base w₁) = (τ₀ i).base (θ_a.base w₁) := by
          simpa using congrArg (fun φ => φ.base w₁) (hτ_tot_comm i)
        rw [h1]
        exact ⟨θ_a.base w₁, rfl⟩
      have hz_j : p_tot.base ((τ_a i).base w₁) ∈ Set.range (τ₀ j).base := by
        rw [← hw₂]
        have h1 : p_tot.base ((τ_a j).base w₂) = (τ₀ j).base (θ_a.base w₂) := by
          simpa using congrArg (fun φ => φ.base w₂) (hτ_tot_comm j)
        rw [h1]
        exact ⟨θ_a.base w₂, rfl⟩
      exact Set.disjoint_left.mp (hDisj₀ hij) hz_i hz_j
    have hSmSec_a : ∀ (j : Fin n) (b : W_a.toScheme), ∃ V' : C_a.Opens,
        (τ_a j).base b ∈ V' ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V'.ι ≫ g_a) := by
      intro j b
      obtain ⟨V, hbV, hSmV⟩ := hSmSec₀ j (θ_a.base b)
      refine ⟨p_tot ⁻¹ᵁ V, ?_, ?_⟩
      · change p_tot.base ((τ_a j).base b) ∈ V
        have h1 : p_tot.base ((τ_a j).base b) = (τ₀ j).base (θ_a.base b) := by
          simpa using congrArg (fun φ => φ.base b) (hτ_tot_comm j)
        rw [h1]
        exact hbV
      · have hp_res : CategoryTheory.IsPullback (p_tot ∣_ V) (p_tot ⁻¹ᵁ V).ι V.ι p_tot :=
          AlgebraicGeometry.isPullback_morphismRestrict p_tot V
        exact MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)
          (hp_res.paste_vert hp_tot) hSmV
    have hSecRange : ∀ j : Fin n,
        Set.range (τ_a j).base = p_tot.base ⁻¹' Set.range (τ₀ j).base := by
      intro j
      have h_outer : CategoryTheory.IsPullback θ_a (τ_a j ≫ g_a) (τ₀ j ≫ g₀) θ_a := by
        rw [hSec_a j, hSec₀ j]
        exact CategoryTheory.IsPullback.id_vert θ_a
      have hp_sec : CategoryTheory.IsPullback θ_a (τ_a j) (τ₀ j) p_tot :=
        CategoryTheory.IsPullback.of_bot h_outer (hτ_tot_comm j).symm hp_tot
      let e_sec := hp_sec.isoPullback
      have he_snd : e_sec.hom ≫ CategoryTheory.Limits.pullback.snd (τ₀ j) p_tot = τ_a j :=
        hp_sec.isoPullback_hom_snd
      have hsurj : Function.Surjective e_sec.hom.base := by
        intro y
        refine ⟨(Scheme.homeoOfIso e_sec).symm y, ?_⟩
        have h_app := (Scheme.homeoOfIso e_sec).apply_symm_apply y
        rwa [Scheme.homeoOfIso_apply] at h_app
      have hrange1 : Set.range (τ_a j).base =
          Set.range (CategoryTheory.Limits.pullback.snd (τ₀ j) p_tot).base := by
        rw [← he_snd]
        change Set.range ((CategoryTheory.Limits.pullback.snd (τ₀ j) p_tot).base ∘ e_sec.hom.base) = _
        exact hsurj.range_comp _
      rw [hrange1]
      exact AlgebraicGeometry.Scheme.Pullback.range_snd (τ₀ j) p_tot
    have hIrredHomeo : ∀ {X Z : Type u} [TopologicalSpace X] [TopologicalSpace Z]
        (h : X ≃ₜ Z) {A : Set X},
        A ∈ irreducibleComponents X → h '' A ∈ irreducibleComponents Z := by
      intro X Z _ _ h A hA
      exact image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
        (fun z => Set.Subsingleton.isPreirreducible fun a₁ ha₁ a₂ ha₂ =>
          h.injective (ha₁.trans ha₂.symm))
        h.surjective hA
    refine ⟨hn, hFlat_a, hProp_a, hLFP_a, hSurj_a, hSec_a, hDisj_a, hSmSec_a, ?_⟩
    intro K _ _ s
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ AlgebraicGeometry.Spec A₀ := s ≫ θ_a
    have hp_fib : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g_a s ≫ p_tot)
        (CategoryTheory.Limits.pullback.snd g_a s) g₀ s₀ :=
      (CategoryTheory.IsPullback.of_hasPullback g_a s).paste_horiz hp_tot
    let Φ := hp_fib.isoPullback
    let hΦ := Scheme.homeoOfIso Φ
    have hΦ_fst : Φ.hom ≫ CategoryTheory.Limits.pullback.fst g₀ s₀ =
        CategoryTheory.Limits.pullback.fst g_a s ≫ p_tot :=
      hp_fib.isoPullback_hom_fst
    have hΦ_snd : Φ.hom ≫ CategoryTheory.Limits.pullback.snd g₀ s₀ =
        CategoryTheory.Limits.pullback.snd g_a s :=
      hp_fib.isoPullback_hom_snd
    have hΦ_inv_snd : Φ.inv ≫ CategoryTheory.Limits.pullback.snd g_a s =
        CategoryTheory.Limits.pullback.snd g₀ s₀ := by
      rw [← hΦ_snd, ← CategoryTheory.Category.assoc, Φ.inv_hom_id, CategoryTheory.Category.id_comp]
    rcases hGeom₀ K s₀ with ⟨hConn, hLoc, hP1⟩
    refine ⟨?_, ?_, ?_⟩
    · exact @Function.Surjective.connectedSpace _ _ _ hConn _
        hΦ.symm hΦ.symm.surjective hΦ.symm.continuous
    · intro y'
      rcases hLoc (hΦ y') with ⟨V, hyV, hSmV⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hMax, hRoof⟩
      · let V' : (CategoryTheory.Limits.pullback g_a s).Opens := Φ.hom ⁻¹ᵁ V
        have hyV' : y' ∈ V' := by
          change Φ.hom.base y' ∈ V
          simpa [hΦ, Scheme.homeoOfIso_apply] using hyV
        have hp_res : CategoryTheory.IsPullback (Φ.hom ∣_ V) V'.ι V.ι Φ.hom :=
          AlgebraicGeometry.isPullback_morphismRestrict Φ.hom V
        have : IsIso (Φ.hom ∣_ V) := hp_res.isIso_fst_of_isIso
        have hV'_eq : V'.ι ≫ CategoryTheory.Limits.pullback.snd g_a s =
            (Φ.hom ∣_ V) ≫ (V.ι ≫ CategoryTheory.Limits.pullback.snd g₀ s₀) := by
          rw [← hΦ_snd, ← CategoryTheory.Category.assoc, ← hp_res.w, CategoryTheory.Category.assoc]
        have hp_iso : CategoryTheory.IsPullback (Φ.hom ∣_ V)
            (V'.ι ≫ CategoryTheory.Limits.pullback.snd g_a s)
            (V.ι ≫ CategoryTheory.Limits.pullback.snd g₀ s₀) (𝟙 _) :=
          CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [CategoryTheory.Category.comp_id, hV'_eq]⟩
        exact Or.inl ⟨V', hyV', MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hp_iso hSmV⟩
      · refine Or.inr ⟨U', u₀, e₁ ≫ Φ.inv, e₂, inferInstance, hEt₂, ?_, hMax, ?_⟩
        · have h1 : (e₁ ≫ Φ.inv).base u₀ = Φ.inv.base (e₁.base u₀) := rfl
          rw [h1, hu₀]
          have h2 : hΦ.symm (hΦ y') = y' := hΦ.symm_apply_apply y'
          rwa [Scheme.homeoOfIso_symm, Scheme.homeoOfIso_apply] at h2
        · rw [CategoryTheory.Category.assoc, hΦ_inv_snd, hRoof]
    · intro E' E_sch ιE' hE' hCl' hIntE hRange' ⟨isoP1, hisoP1⟩
      let E : Set ↥(CategoryTheory.Limits.pullback g₀ s₀) := hΦ '' E'
      let ιE : E_sch ⟶ CategoryTheory.Limits.pullback g₀ s₀ := ιE' ≫ Φ.hom
      have hE : E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₀ s₀) :=
        hIrredHomeo hΦ hE'
      have hCl : AlgebraicGeometry.IsClosedImmersion ιE := inferInstance
      have hRange : Set.range ιE.base = E := by
        change Set.range (Φ.hom.base ∘ ιE'.base) = hΦ '' E'
        rw [Set.range_comp, hRange']
        rfl
      have hisoP1₀ : ιE ≫ CategoryTheory.Limits.pullback.snd g₀ s₀ =
          isoP1.hom ≫ (weilProjectiveSpaceOver K 1).hom := by
        rw [CategoryTheory.Category.assoc, hΦ_snd, hisoP1]
      obtain ⟨q₁, q₂, q₃, h12, h13, h23, hq₁E, hq₂E, hq₃E, hSpec⟩ :=
        hP1 E E_sch ιE hE hCl hIntE hRange ⟨isoP1, hisoP1₀⟩
      have hmem_symm : ∀ {q : ↥(CategoryTheory.Limits.pullback g₀ s₀)},
          q ∈ E → hΦ.symm q ∈ E' := by
        rintro q ⟨x, hx, rfl⟩
        simpa using hx
      refine ⟨hΦ.symm q₁, hΦ.symm q₂, hΦ.symm q₃,
        fun h => h12 (hΦ.symm.injective h),
        fun h => h13 (hΦ.symm.injective h),
        fun h => h23 (hΦ.symm.injective h),
        hmem_symm hq₁E, hmem_symm hq₂E, hmem_symm hq₃E, ?_⟩
      intro q' hq'
      have hq_in : hΦ q' ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g₀ s₀)) := by
        rcases hq' with rfl | rfl | rfl <;> simp
      rcases hSpec (hΦ q') hq_in with ⟨E₁, hE₁, hE₁_ne, hqE₁⟩ | ⟨j, hj⟩
      · refine Or.inl ⟨hΦ.symm '' E₁, hIrredHomeo hΦ.symm hE₁, ?_,
          ⟨hΦ q', hqE₁, hΦ.symm_apply_apply q'⟩⟩
        intro h_eq
        apply hE₁_ne
        calc
          E₁ = hΦ '' (hΦ.symm '' E₁) := by
            ext z
            simp
          _ = hΦ '' E' := by rw [h_eq]
          _ = E := rfl
      · refine Or.inr ⟨j, ?_⟩
        rw [hSecRange j]
        change p_tot.base ((CategoryTheory.Limits.pullback.fst g_a s).base q') ∈ Set.range (τ₀ j).base
        have h_fst_eq : (CategoryTheory.Limits.pullback.fst g₀ s₀).base (hΦ q') =
            p_tot.base ((CategoryTheory.Limits.pullback.fst g_a s).base q') := by
          simpa [hΦ, Scheme.homeoOfIso_apply] using congrArg (fun φ => φ.base q') hΦ_fst
        rwa [← h_fst_eq]

  · 
    let V_a : C_a.Opens := (TopologicalSpace.Opens.map (g_a ≫ W_a.ι).base).obj U₃
    let i_W : (W_a ⊓ U₃).toScheme ⟶ W_a.toScheme := B₃.left.homOfLE inf_le_left
    have hi_W_ι : i_W ≫ W_a.ι = (W_a ⊓ U₃).ι :=
      AlgebraicGeometry.Scheme.homOfLE_ι _ inf_le_left
    have h_range_μ : Set.range ⇑(i_W ≫ μ_a) ⊆ Set.range ⇑D_V.ι := by
      rw [D_V.range_ι]
      rintro _ ⟨u, rfl⟩
      apply hU₃_in_D (i_W.base u)
      have h_eq : W_a.ι.base (i_W.base u) = (W_a ⊓ U₃).ι.base u := by
        simpa using congrArg (fun φ => φ.base u) hi_W_ι
      rw [h_eq]
      have hu_mem : (W_a ⊓ U₃).ι.base u ∈ ((W_a ⊓ U₃ : B₃.left.Opens) : Set B₃.left) := by
        rw [← (W_a ⊓ U₃).range_ι]
        exact ⟨u, rfl⟩
      exact hu_mem.2
    let μ_U : (W_a ⊓ U₃).toScheme ⟶ D_V.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift D_V.ι (i_W ≫ μ_a) h_range_μ
    have hμ_U : μ_U ≫ D_V.ι = i_W ≫ μ_a :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac D_V.ι (i_W ≫ μ_a) h_range_μ

    have h_range_gVa : Set.range ⇑(V_a.ι ≫ g_a) ⊆ Set.range ⇑i_W := by
      rintro _ ⟨z, rfl⟩
      change g_a.base (V_a.ι.base z) ∈ (i_W.opensRange : Set W_a.toScheme)
      rw [AlgebraicGeometry.Scheme.opensRange_homOfLE inf_le_left]
      refine ⟨?_, ?_⟩
      · rw [← W_a.range_ι]
        exact ⟨g_a.base (V_a.ι.base z), rfl⟩
      · have hz_mem : V_a.ι.base z ∈ (V_a : Set C_a) := by
          rw [← V_a.range_ι]
          exact ⟨z, rfl⟩
        exact hz_mem
    let g_Va : V_a.toScheme ⟶ (W_a ⊓ U₃).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift i_W (V_a.ι ≫ g_a) h_range_gVa
    have hg_Va : g_Va ≫ i_W = V_a.ι ≫ g_a :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac i_W (V_a.ι ≫ g_a) h_range_gVa
    have h_opens_gVa : g_a ⁻¹ᵁ i_W.opensRange = V_a.ι.opensRange := by
      rw [AlgebraicGeometry.Scheme.opensRange_homOfLE inf_le_left, V_a.opensRange_ι]
      ext c
      change (W_a.ι.base (g_a.base c) ∈ W_a ∧ W_a.ι.base (g_a.base c) ∈ U₃) ↔
        (g_a ≫ W_a.ι).base c ∈ U₃
      have hcW : W_a.ι.base (g_a.base c) ∈ W_a := by
        change W_a.ι.base (g_a.base c) ∈ (W_a : Set B₃.left)
        rw [← W_a.range_ι]
        exact ⟨g_a.base c, rfl⟩
      exact ⟨fun h => h.2, fun h => ⟨hcW, h⟩⟩
    have sq1 : CategoryTheory.IsPullback V_a.ι g_Va g_a i_W :=
      (AlgebraicGeometry.IsOpenImmersion.isPullback g_Va V_a.ι i_W g_a hg_Va.symm h_opens_gVa).flip

    let V_D : C_V.Opens := (TopologicalSpace.Opens.map g_V.base).obj D_V
    let g_VD : V_D.toScheme ⟶ D_V.toScheme := g_V ∣_ D_V
    have sq2 : CategoryTheory.IsPullback V_D.ι g_VD g_V D_V.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict g_V D_V).flip
    have sqA : CategoryTheory.IsPullback (V_a.ι ≫ p_V) g_Va g_V (μ_U ≫ D_V.ι) := by
      have h := sq1.paste_horiz hp_V
      rwa [← hμ_U] at h
    let μ_tilde_V : V_a.toScheme ⟶ V_D.toScheme :=
      sq2.lift (V_a.ι ≫ p_V) (g_Va ≫ μ_U) (by simpa only [CategoryTheory.Category.assoc] using sqA.w)
    have hμV_fst : μ_tilde_V ≫ V_D.ι = V_a.ι ≫ p_V := sq2.lift_fst _ _ _
    have hμV_snd : μ_tilde_V ≫ g_VD = g_Va ≫ μ_U := sq2.lift_snd _ _ _
    have sq3 : CategoryTheory.IsPullback μ_tilde_V g_Va g_VD μ_U := by
      refine CategoryTheory.IsPullback.of_right ?_ hμV_snd sq2
      rwa [hμV_fst]

    rcases hIsoChart with ⟨ι_D, hcomm_D, hOpen_D, hRange_D, hSec_D⟩
    let snd_V := CategoryTheory.Limits.pullback.snd f₂.left π_V
    let fst_V := CategoryTheory.Limits.pullback.fst f₂.left π_V
    let Q_D := snd_V ⁻¹ᵁ D_V
    let q_D : Q_D.toScheme ⟶ D_V.toScheme := snd_V ∣_ D_V
    have sq_QD : CategoryTheory.IsPullback (Q_D.ι ≫ fst_V) q_D f₂.left (D_V.ι ≫ π_V) :=
      ((AlgebraicGeometry.isPullback_morphismRestrict snd_V D_V).flip).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f₂.left π_V)

    let snd_3 := CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left
    let fst_3 := CategoryTheory.Limits.pullback.fst f₂.left ψ₃.left
    let Q_3 := snd_3 ⁻¹ᵁ (W_a ⊓ U₃)
    let q_3 : Q_3.toScheme ⟶ (W_a ⊓ U₃).toScheme := snd_3 ∣_ (W_a ⊓ U₃)
    have sq_Q3 : CategoryTheory.IsPullback (Q_3.ι ≫ fst_3) q_3 f₂.left ((W_a ⊓ U₃).ι ≫ ψ₃.left) :=
      ((AlgebraicGeometry.isPullback_morphismRestrict snd_3 (W_a ⊓ U₃)).flip).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f₂.left ψ₃.left)

    have h_base_comm : (W_a ⊓ U₃).ι ≫ ψ₃.left = μ_U ≫ (D_V.ι ≫ π_V) := by
      rw [← hi_W_ι, CategoryTheory.Category.assoc, ← hμ_comm, ← CategoryTheory.Category.assoc,
        ← hμ_U, CategoryTheory.Category.assoc]
    have sq_Q3' : CategoryTheory.IsPullback (Q_3.ι ≫ fst_3) q_3 f₂.left (μ_U ≫ (D_V.ι ≫ π_V)) := by
      have h := sq_Q3
      rwa [h_base_comm] at h
    let μ_tilde_Q : Q_3.toScheme ⟶ Q_D.toScheme :=
      sq_QD.lift (Q_3.ι ≫ fst_3) (q_3 ≫ μ_U)
        (by simpa only [CategoryTheory.Category.assoc] using sq_Q3'.w)
    have hμQ_fst : μ_tilde_Q ≫ (Q_D.ι ≫ fst_V) = Q_3.ι ≫ fst_3 := sq_QD.lift_fst _ _ _
    have hμQ_snd : μ_tilde_Q ≫ q_D = q_3 ≫ μ_U := sq_QD.lift_snd _ _ _
    have sq4 : CategoryTheory.IsPullback μ_tilde_Q q_3 q_D μ_U := by
      refine CategoryTheory.IsPullback.of_right ?_ hμQ_snd sq_QD
      rwa [hμQ_fst]

    let L_D := CategoryTheory.Limits.pullback.lift ι_D (V_D.ι ≫ g_V) hcomm_D
    have : AlgebraicGeometry.IsOpenImmersion L_D := hOpen_D
    have hLD_fst : L_D ≫ fst_V = ι_D := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hRange_eq_D : Set.range ⇑L_D = Set.range ⇑Q_D.ι := by
      rw [Q_D.range_ι]
      exact hRange_D
    let e_D : V_D.toScheme ≅ Q_D.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq L_D Q_D.ι hRange_eq_D
    have he_D_fac : e_D.hom ≫ Q_D.ι = L_D :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac L_D Q_D.ι hRange_eq_D
    have he_D_q : e_D.hom ≫ q_D = g_VD := by
      rw [← cancel_mono D_V.ι]
      calc
        (e_D.hom ≫ q_D) ≫ D_V.ι
          = e_D.hom ≫ (q_D ≫ D_V.ι) := CategoryTheory.Category.assoc _ _ _
        _ = e_D.hom ≫ (Q_D.ι ≫ snd_V) := by
          rw [AlgebraicGeometry.morphismRestrict_ι snd_V D_V]
        _ = (e_D.hom ≫ Q_D.ι) ≫ snd_V := (CategoryTheory.Category.assoc _ _ _).symm
        _ = L_D ≫ snd_V := by rw [he_D_fac]
        _ = V_D.ι ≫ g_V := CategoryTheory.Limits.pullback.lift_snd _ _ _
        _ = g_VD ≫ D_V.ι := (AlgebraicGeometry.morphismRestrict_ι g_V D_V).symm

    have sq_eD : CategoryTheory.IsPullback e_D.hom g_VD q_D (𝟙 D_V.toScheme) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨by rw [CategoryTheory.Category.comp_id, he_D_q]⟩
    have sq3' : CategoryTheory.IsPullback (μ_tilde_V ≫ e_D.hom) g_Va q_D μ_U := by
      have h := sq3.paste_horiz sq_eD
      rwa [CategoryTheory.Category.comp_id] at h
    let e_a : V_a.toScheme ≅ Q_3.toScheme :=
      CategoryTheory.IsPullback.isoIsPullback Q_D.toScheme (W_a ⊓ U₃).toScheme sq3' sq4
    have he_a_fst : e_a.hom ≫ μ_tilde_Q = μ_tilde_V ≫ e_D.hom :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst Q_D.toScheme (W_a ⊓ U₃).toScheme sq3' sq4
    have he_a_snd : e_a.hom ≫ q_3 = g_Va :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd Q_D.toScheme (W_a ⊓ U₃).toScheme sq3' sq4

    let ι_a : V_a.toScheme ⟶ X₂.left := μ_tilde_V ≫ ι_D
    have hcomm_a : ι_a ≫ f₂.left = V_a.ι ≫ g_a ≫ W_a.ι ≫ ψ₃.left := by
      calc
        (μ_tilde_V ≫ ι_D) ≫ f₂.left
          = μ_tilde_V ≫ (ι_D ≫ f₂.left) := CategoryTheory.Category.assoc _ _ _
        _ = μ_tilde_V ≫ V_D.ι ≫ g_V ≫ π_V := by rw [hcomm_D]
        _ = (μ_tilde_V ≫ V_D.ι) ≫ g_V ≫ π_V := by simp only [CategoryTheory.Category.assoc]
        _ = V_a.ι ≫ (p_V ≫ g_V) ≫ π_V := by
          rw [hμV_fst]
          simp only [CategoryTheory.Category.assoc]
        _ = V_a.ι ≫ g_a ≫ (μ_a ≫ π_V) := by
          rw [hp_V.w]
          simp only [CategoryTheory.Category.assoc]
        _ = V_a.ι ≫ g_a ≫ W_a.ι ≫ ψ₃.left := by rw [hμ_comm]

    let L_a := CategoryTheory.Limits.pullback.lift ι_a (V_a.ι ≫ g_a ≫ W_a.ι) hcomm_a
    have hL_a_eq : L_a = e_a.hom ≫ Q_3.ι := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          L_a ≫ fst_3 = μ_tilde_V ≫ ι_D := CategoryTheory.Limits.pullback.lift_fst _ _ _
          _ = μ_tilde_V ≫ (L_D ≫ fst_V) := by rw [hLD_fst]
          _ = μ_tilde_V ≫ (e_D.hom ≫ Q_D.ι) ≫ fst_V := by rw [he_D_fac]
          _ = (μ_tilde_V ≫ e_D.hom) ≫ (Q_D.ι ≫ fst_V) := by simp only [CategoryTheory.Category.assoc]
          _ = (e_a.hom ≫ μ_tilde_Q) ≫ (Q_D.ι ≫ fst_V) := by rw [he_a_fst]
          _ = e_a.hom ≫ (μ_tilde_Q ≫ (Q_D.ι ≫ fst_V)) := CategoryTheory.Category.assoc _ _ _
          _ = e_a.hom ≫ (Q_3.ι ≫ fst_3) := by rw [hμQ_fst]
          _ = (e_a.hom ≫ Q_3.ι) ≫ fst_3 := (CategoryTheory.Category.assoc _ _ _).symm
      · calc
          L_a ≫ snd_3 = V_a.ι ≫ g_a ≫ W_a.ι := CategoryTheory.Limits.pullback.lift_snd _ _ _
          _ = (V_a.ι ≫ g_a) ≫ W_a.ι := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (g_Va ≫ i_W) ≫ W_a.ι := by rw [hg_Va]
          _ = g_Va ≫ (i_W ≫ W_a.ι) := CategoryTheory.Category.assoc _ _ _
          _ = (e_a.hom ≫ q_3) ≫ (W_a ⊓ U₃).ι := by rw [← he_a_snd, hi_W_ι]
          _ = e_a.hom ≫ (q_3 ≫ (W_a ⊓ U₃).ι) := CategoryTheory.Category.assoc _ _ _
          _ = e_a.hom ≫ (Q_3.ι ≫ snd_3) := by rw [AlgebraicGeometry.morphismRestrict_ι snd_3 (W_a ⊓ U₃)]
          _ = (e_a.hom ≫ Q_3.ι) ≫ snd_3 := (CategoryTheory.Category.assoc _ _ _).symm

    refine ⟨ι_a, hcomm_a, ?_, ?_, ?_⟩
    · change AlgebraicGeometry.IsOpenImmersion L_a
      rw [hL_a_eq]
      exact inferInstance
    · change Set.range L_a.base =
        (CategoryTheory.Limits.pullback.snd f₂.left ψ₃.left).base ⁻¹'
          ((W_a ⊓ U₃ : B₃.left.Opens) : Set B₃.left)
      rw [hL_a_eq]
      have hsurj_ea : Function.Surjective e_a.hom.base := by
        intro y
        refine ⟨(Scheme.homeoOfIso e_a).symm y, ?_⟩
        have h_app := (Scheme.homeoOfIso e_a).apply_symm_apply y
        rwa [Scheme.homeoOfIso_apply] at h_app
      have hrange_ea : Set.range (e_a.hom ≫ Q_3.ι).base = Set.range Q_3.ι.base := by
        change Set.range (Q_3.ι.base ∘ e_a.hom.base) = Set.range Q_3.ι.base
        exact hsurj_ea.range_comp _
      rw [hrange_ea]
      exact Q_3.range_ι
    · intro j
      obtain ⟨s_D, hs_D_ι, hs_D_σ⟩ := hSec_D j
      let s_a : (W_a ⊓ U₃).toScheme ⟶ V_a.toScheme :=
        sq1.lift (i_W ≫ τ_a j) (𝟙 _)
          (by rw [CategoryTheory.Category.assoc, hSec_a j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have hs_a_ι : s_a ≫ V_a.ι = i_W ≫ τ_a j := sq1.lift_fst _ _ _
      have hs_a_μ : s_a ≫ μ_tilde_V = μ_U ≫ s_D := by
        rw [← cancel_mono V_D.ι]
        calc
          (s_a ≫ μ_tilde_V) ≫ V_D.ι
            = s_a ≫ (μ_tilde_V ≫ V_D.ι) := CategoryTheory.Category.assoc _ _ _
          _ = (s_a ≫ V_a.ι) ≫ p_V := by rw [hμV_fst, ← CategoryTheory.Category.assoc]
          _ = i_W ≫ (τ_a j ≫ p_V) := by rw [hs_a_ι, CategoryTheory.Category.assoc]
          _ = (i_W ≫ μ_a) ≫ τ_V j := by rw [hτ_a_comm j, ← CategoryTheory.Category.assoc]
          _ = μ_U ≫ (D_V.ι ≫ τ_V j) := by rw [← hμ_U, CategoryTheory.Category.assoc]
          _ = (μ_U ≫ s_D) ≫ V_D.ι := by rw [← hs_D_ι, ← CategoryTheory.Category.assoc]
      refine ⟨s_a, hs_a_ι, ?_⟩
      calc
        s_a ≫ ι_a
          = (s_a ≫ μ_tilde_V) ≫ ι_D := (CategoryTheory.Category.assoc _ _ _).symm
        _ = μ_U ≫ (s_D ≫ ι_D) := by rw [hs_a_μ, CategoryTheory.Category.assoc]
        _ = (μ_U ≫ D_V.ι) ≫ π_V ≫ (σ j).left := by
          rw [hs_D_σ]
          simp only [CategoryTheory.Category.assoc]
        _ = i_W ≫ (μ_a ≫ π_V) ≫ (σ j).left := by
          rw [hμ_U]
          simp only [CategoryTheory.Category.assoc]
        _ = (i_W ≫ W_a.ι) ≫ ψ₃.left ≫ (σ j).left := by
          rw [hμ_comm]
          simp only [CategoryTheory.Category.assoc]
        _ = (W_a ⊓ U₃).ι ≫ ψ₃.left ≫ (σ j).left := by rw [hi_W_ι]

theorem weil_riemannZariski_spreadOut_normal_base_cover (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (hDimB₂ : topologicalKrullDim B₂.left = (m : WithBot ℕ∞))
    (hU₂ : Nonempty U₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX₂ : AlgebraicGeometry.IsIntegral X₂.left)
    (hProjX₂ : IsProjectiveOverField k X₂)
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (K₀ : Type u) [Field K₀] [Algebra k K₀]
    (η₀ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ B₂.left)
    (hη₀_hom : η₀ ≫ B₂.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K₀)))
    (hFuncK₀ : IsSchemeFunctionField B₂.left K₀ η₀)
    (K : Type u) [Field K] [IsSepClosed K]
    [Algebra k K] [Algebra K₀ K] [IsScalarTower k K₀ K] [IsSepClosure K₀ K]
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (ι_K : C_K ⟶ X₂.left)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hPbK : CategoryTheory.IsPullback ι_K p_K f₂.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀))
    (hσK : ∀ j : Fin n, σ_K j ≫ ι_K =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀ ≫ (σ j).left)
    (hValExt : ∀ (V : ValuationSubring K),
      (∀ c : k, algebraMap k K c ∈ V) →
      ∃ (C_V : AlgebraicGeometry.Scheme.{u})
        (g_V : C_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (τ_V : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_V))
        (ι_gen : C_K ⟶ C_V),
        IsGeometricStablePointedCurve g_V n τ_V ∧
        CategoryTheory.IsPullback ι_gen p_K g_V (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
        (∀ j : Fin n, σ_K j ≫ ι_gen =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_V j)) :
    ∃ (B₃ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U₃ : B₃.left.Opens)
      (ψ₃ : B₃ ⟶ B₂)
      (N : ℕ)
      (W : Fin N → B₃.left.Opens)
      (C_loc : Fin N → AlgebraicGeometry.Scheme.{u})
      (g_loc : ∀ a : Fin N, C_loc a ⟶ (W a).toScheme)
      (τ_loc : ∀ a : Fin N, Fin n → ((W a).toScheme ⟶ C_loc a)),
      AlgebraicGeometry.IsIntegral B₃.left ∧
      IsProjectiveOverField k B₃ ∧
      topologicalKrullDim B₃.left = (m : WithBot ℕ∞) ∧
      (∀ U : B₃.left.Opens, AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
        IsIntegrallyClosed ↑(B₃.left.presheaf.obj (Opposite.op U))) ∧
      Nonempty U₃ ∧
      IsGenFiniteEtaleAlterationOver k ψ₃ ∧
      (U₃ : Set B₃.left) ⊆ ψ₃.left.base ⁻¹' (U₂ : Set B₂.left) ∧
      (⋃ a : Fin N, (W a : Set B₃.left)) = Set.univ ∧
      (∀ a : Fin N, Nonempty ↥(W a)) ∧
      (∀ a : Fin N, IsGeometricStablePointedCurve (g_loc a) n (τ_loc a)) ∧
      (∀ a : Fin N, HasLocalPointedPullbackIsoOnOpen k f₂ σ ψ₃ U₃ (W a) (g_loc a) (τ_loc a)) :=
by
  have hSecK : ∀ j : Fin n, σ_K j ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) := by
    obtain ⟨C_top, g_top, τ_top, ι_top, hStab_top, hPb_top, hσ_top⟩ :=
      hValExt ⊤ (fun _ => trivial)
    let inv_top : K →+* ↥(⊤ : ValuationSubring K) :=
      { toFun := fun x => ⟨x, trivial⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hcomp_top :
        CommRingCat.ofHom inv_top ≫ CommRingCat.ofHom (⊤ : ValuationSubring K).subtype =
          𝟙 (CommRingCat.of K) := by
      rw [← CommRingCat.ofHom_comp]
      rfl
    have hSpec_inv :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (⊤ : ValuationSubring K).subtype) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_top) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      rw [← AlgebraicGeometry.Spec.map_comp, hcomp_top, AlgebraicGeometry.Spec.map_id]
    intro j
    have h1 :
        (σ_K j ≫ p_K) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (⊤ : ValuationSubring K).subtype) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (⊤ : ValuationSubring K).subtype) := by
      rw [CategoryTheory.Category.assoc, ← hPb_top.w, ← CategoryTheory.Category.assoc,
        hσ_top j, CategoryTheory.Category.assoc, hStab_top.2.2.2.2.2.1 j,
        CategoryTheory.Category.comp_id]
    calc
      σ_K j ≫ p_K
        = (σ_K j ≫ p_K) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (⊤ : ValuationSubring K).subtype) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_top)) := by
            rw [hSpec_inv, CategoryTheory.Category.comp_id]
      _ = ((σ_K j ≫ p_K) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (⊤ : ValuationSubring K).subtype)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_top) := by
            simp only [CategoryTheory.Category.assoc]
      _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) := by
            rw [h1, hSpec_inv]

  obtain ⟨hIntCK, hCenter⟩ :=
    weil_valuation_center_and_generic_curve_integral k B₂ U₂ hIntB₂ hProjB₂ hU₂
      X₂ f₂ n σ hFib₂ K₀ η₀ hη₀_hom hFuncK₀ K C_K p_K ι_K hPbK

  let ValIdx : Type u := {V : ValuationSubring K // ∀ c : k, algebraMap k K c ∈ V}
  have hPerVal :
      ∀ v : ValIdx,
        ∃ (U₀ : B₂.left.Opens)
          (F₀ F_V : Finset K)
          (hSub : F₀ ⊆ F_V)
          (h_V : ↥(Algebra.adjoin k (↑F_V : Set K)))
          (μ_FV : AlgebraicGeometry.Spec
            (CommRingCat.of ↥(Algebra.adjoin k (↑F_V : Set K))) ⟶ U₀.toScheme)
          (C₀ : AlgebraicGeometry.Scheme.{u})
          (g₀ : C₀ ⟶ AlgebraicGeometry.Spec
            (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))))
          (τ₀ : Fin n → (AlgebraicGeometry.Spec
            (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))) ⟶ C₀))
          (hStab₀ : IsGeometricStablePointedCurve g₀ n τ₀),
          AlgebraicGeometry.IsAffineOpen U₀ ∧
          Nonempty ↥U₀ ∧
          (∀ x ∈ F_V, x ∈ v.1) ∧
          h_V ≠ 0 ∧
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.adjoin k (↑F_V : Set K)).val.toRingHom) ≫
              μ_FV ≫ U₀.ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀ ∧
          IsAffineChartOpenPointedIso k f₂ σ (μ_FV ≫ U₀.ι) (PrimeSpectrum.basicOpen h_V)
            (CategoryTheory.Limits.pullback.snd g₀
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (Subalgebra.inclusion
                    (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))).toRingHom)))
            (fun j => CategoryTheory.Limits.pullback.lift
              (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom
                    (Subalgebra.inclusion
                      (Algebra.adjoin_mono (Finset.coe_subset.mpr hSub))).toRingHom) ≫ τ₀ j)
              (𝟙 _)
              (by
                rw [CategoryTheory.Category.assoc, hStab₀.2.2.2.2.2.1 j,
                  CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])) := by
    intro v
    obtain ⟨U₀, F_init, μ₀_init, hAffU₀, hNonemptyU₀, hF_init, _hμ₀_hom, hμ₀_K⟩ :=
      hCenter v.1 v.2
    obtain ⟨C_V, g_V, τ_V, ι_gen, hStabV, hPbV, hσV⟩ := hValExt v.1 v.2
    obtain ⟨F₀, C₀, g₀, τ₀, ι₀_K, hSub_init, hF₀_V, hStab₀, hPb₀, hσ₀⟩ :=
      weil_valuationSubring_spreadOut_stable_curve k K v.1 v.2 n C_K hIntCK p_K σ_K hSecK
        C_V g_V τ_V ι_gen hStabV hPbV hσV F_init hF_init
    let ρ_init :
        AlgebraicGeometry.Spec (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥(Algebra.adjoin k (↑F_init : Set K))) :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub_init))).toRingHom)
    have hval_init :
        CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub_init))).toRingHom ≫
          CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom =
        CommRingCat.ofHom (Algebra.adjoin k (↑F_init : Set K)).val.toRingHom := by
      rw [← CommRingCat.ofHom_comp]
      rfl
    have hμ₀_F₀_K :
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom) ≫
            (ρ_init ≫ μ₀_init) ≫ U₀.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀ := by
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc _ ρ_init,
        ← AlgebraicGeometry.Spec.map_comp, hval_init, ← CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc _ μ₀_init, hμ₀_K]
    obtain ⟨F_V, hSub₀, h_V, hFV_mem, hh_V_ne, _hBasic_U₂, hIsoChart⟩ :=
      weil_spreadOut_generic_pointed_iso_on_basicOpen k B₂ U₂ hIntB₂ hProjB₂ hU₂ X₂ hProjX₂
        f₂ n σ hFib₂ K₀ η₀ hFuncK₀ K v.1 C_K p_K ι_K σ_K hSecK hPbK hσK
        U₀ hAffU₀ hNonemptyU₀ F₀ hF₀_V (ρ_init ≫ μ₀_init) hμ₀_F₀_K C₀ g₀ τ₀ ι₀_K
        hStab₀.2.2.1 hStab₀.2.2.2.1 hStab₀.2.2.2.2.2.1 hPb₀ hσ₀
    let ρ_V :
        AlgebraicGeometry.Spec (CommRingCat.of ↥(Algebra.adjoin k (↑F_V : Set K))) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥(Algebra.adjoin k (↑F₀ : Set K))) :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub₀))).toRingHom)
    have hval_V :
        CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (R := k) (Finset.coe_subset.mpr hSub₀))).toRingHom ≫
          CommRingCat.ofHom (Algebra.adjoin k (↑F_V : Set K)).val.toRingHom =
        CommRingCat.ofHom (Algebra.adjoin k (↑F₀ : Set K)).val.toRingHom := by
      rw [← CommRingCat.ofHom_comp]
      rfl
    have hμ_FV_K :
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.adjoin k (↑F_V : Set K)).val.toRingHom) ≫
            (ρ_V ≫ ρ_init ≫ μ₀_init) ≫ U₀.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K)) ≫ η₀ := by
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc _ ρ_V,
        ← AlgebraicGeometry.Spec.map_comp, hval_V, ← CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc _ (ρ_init ≫ μ₀_init), hμ₀_F₀_K]
    refine ⟨U₀, F₀, F_V, hSub₀, h_V, ρ_V ≫ ρ_init ≫ μ₀_init, C₀, g₀, τ₀, hStab₀,
      hAffU₀, hNonemptyU₀, hFV_mem, hh_V_ne, hμ_FV_K, ?_⟩
    simpa only [CategoryTheory.Category.assoc] using hIsoChart

  choose U₀_v F₀_v F_v hSub_v h_v μ_v C₀_v g₀_v τ₀_v hStab₀_v
    hAff_v hNonempty_v hMem_v hh_ne_v hCommK_v hIso_v using hPerVal

  have hTychonoff :
      ∃ (N₀ : ℕ) (v_cov : Fin N₀ → ValIdx),
        ∀ (W_val : ValuationSubring K),
          (∀ c : k, algebraMap k K c ∈ W_val) →
          ∃ a : Fin N₀, ∀ x ∈ F_v (v_cov a), x ∈ W_val := by
    have hClEq : ∀ (x : K) (b : Bool), IsClosed {p : K → Bool | p x = b} :=
      fun x _ => isClosed_eq (continuous_apply x) continuous_const
    let S_RZ : Set (K → Bool) :=
      {p | p 0 = true} ∩
      ({p | p 1 = true} ∩
      ((⋂ (x : K) (y : K),
          ({p | p x = false} ∪ ({p | p y = false} ∪ {p | p (x + y) = true}))) ∩
      ((⋂ (x : K), ({p | p x = false} ∪ {p | p (-x) = true})) ∩
      ((⋂ (x : K) (y : K),
          ({p | p x = false} ∪ ({p | p y = false} ∪ {p | p (x * y) = true}))) ∩
      ((⋂ (x : K), ({p | p x = true} ∪ {p | p x⁻¹ = true})) ∩
       (⋂ (c : k), {p | p (algebraMap k K c) = true}))))))
    have hClosed_RZ : IsClosed S_RZ :=
      (hClEq 0 true).inter <|
        (hClEq 1 true).inter <|
        (isClosed_iInter fun x => isClosed_iInter fun y =>
          (hClEq x false).union ((hClEq y false).union (hClEq (x + y) true))).inter <|
        (isClosed_iInter fun x => (hClEq x false).union (hClEq (-x) true)).inter <|
        (isClosed_iInter fun x => isClosed_iInter fun y =>
          (hClEq x false).union ((hClEq y false).union (hClEq (x * y) true))).inter <|
        (isClosed_iInter fun x => (hClEq x true).union (hClEq x⁻¹ true)).inter <|
        (isClosed_iInter fun c => hClEq (algebraMap k K c) true)
    have hComp_RZ : IsCompact S_RZ := hClosed_RZ.isCompact
    let U_cyl : ValIdx → Set (K → Bool) :=
      fun v => ⋂ x ∈ F_v v, {p : K → Bool | p x = true}
    have hOpen_cyl : ∀ v : ValIdx, IsOpen (U_cyl v) := by
      intro v
      refine (F_v v).finite_toSet.isOpen_biInter fun x _ => ?_
      have h_eq :
          {p : K → Bool | p x = true} = (fun p : K → Bool => p x) ⁻¹' ({true} : Set Bool) := by
        ext p
        simp
      rw [h_eq]
      exact (isOpen_discrete ({true} : Set Bool)).preimage (continuous_apply x)
    have hSub_cyl : S_RZ ⊆ ⋃ v : ValIdx, U_cyl v := by
      intro p hp
      rcases hp with ⟨hp0, hp1, hp_add, hp_neg, hp_mul, hp_inv, hp_k⟩
      let V_p : ValuationSubring K :=
        { carrier := {x : K | p x = true}
          mul_mem' := by
            intro x y hx hy
            rcases Set.mem_iInter₂.mp hp_mul x y with h | h | h
            · change p x = true at hx; change p x = false at h; rw [hx] at h; cases h
            · change p y = true at hy; change p y = false at h; rw [hy] at h; cases h
            · exact h
          one_mem' := hp1
          add_mem' := by
            intro x y hx hy
            rcases Set.mem_iInter₂.mp hp_add x y with h | h | h
            · change p x = true at hx; change p x = false at h; rw [hx] at h; cases h
            · change p y = true at hy; change p y = false at h; rw [hy] at h; cases h
            · exact h
          zero_mem' := hp0
          neg_mem' := by
            intro x hx
            rcases Set.mem_iInter.mp hp_neg x with h | h
            · change p x = true at hx; change p x = false at h; rw [hx] at h; cases h
            · exact h
          mem_or_inv_mem' := fun x => Set.mem_iInter.mp hp_inv x }
      have hk_p : ∀ c : k, algebraMap k K c ∈ V_p :=
        fun c => Set.mem_iInter.mp hp_k c
      refine Set.mem_iUnion.mpr ⟨⟨V_p, hk_p⟩, ?_⟩
      exact Set.mem_iInter₂.mpr (fun x hx => hMem_v ⟨V_p, hk_p⟩ x hx)
    obtain ⟨t, ht⟩ := hComp_RZ.elim_finite_subcover U_cyl hOpen_cyl hSub_cyl
    let e_t : ↥t ≃ Fin t.card := t.equivFin
    refine ⟨t.card, fun a => (e_t.symm a).1, ?_⟩
    intro W_val hkW
    let _ : DecidablePred (· ∈ W_val) := Classical.decPred _
    let p_W : K → Bool := fun x => decide (x ∈ W_val)
    have hp_W : p_W ∈ S_RZ := by
      refine ⟨decide_eq_true W_val.zero_mem, decide_eq_true W_val.one_mem,
        ?_, ?_, ?_, ?_, ?_⟩
      · refine Set.mem_iInter₂.mpr fun x y => ?_
        by_cases hx : x ∈ W_val
        · by_cases hy : y ∈ W_val
          · exact Or.inr (Or.inr (decide_eq_true (add_mem hx hy)))
          · exact Or.inr (Or.inl (decide_eq_false hy))
        · exact Or.inl (decide_eq_false hx)
      · refine Set.mem_iInter.mpr fun x => ?_
        by_cases hx : x ∈ W_val
        · exact Or.inr (decide_eq_true (neg_mem hx))
        · exact Or.inl (decide_eq_false hx)
      · refine Set.mem_iInter₂.mpr fun x y => ?_
        by_cases hx : x ∈ W_val
        · by_cases hy : y ∈ W_val
          · exact Or.inr (Or.inr (decide_eq_true (mul_mem hx hy)))
          · exact Or.inr (Or.inl (decide_eq_false hy))
        · exact Or.inl (decide_eq_false hx)
      · refine Set.mem_iInter.mpr fun x => ?_
        rcases W_val.mem_or_inv_mem x with h | h
        · exact Or.inl (decide_eq_true h)
        · exact Or.inr (decide_eq_true h)
      · exact Set.mem_iInter.mpr fun c => decide_eq_true (hkW c)
    obtain ⟨v, hv_mem⟩ := Set.mem_iUnion.mp (ht hp_W)
    obtain ⟨hv_t, hv_cyl⟩ := Set.mem_iUnion.mp hv_mem
    refine ⟨e_t ⟨v, hv_t⟩, ?_⟩
    intro x hx
    dsimp only at hx
    have h_eq : (e_t.symm (e_t ⟨v, hv_t⟩)).1 = v := by simp
    rw [h_eq] at hx
    exact of_decide_eq_true (Set.mem_iInter₂.mp hv_cyl x hx)

  obtain ⟨N₀, v_cov, hRZCover⟩ := hTychonoff

  obtain ⟨B₃, ψ₃, W', μ_chart, hIntB₃, hProjB₃, hDimB₃, hNormB₃, hψ₃, hCover', hμ_comm', hDom'⟩ :=
    weil_normal_projective_alteration_dominating_finset_charts k m B₂ hIntB₂ hProjB₂ hDimB₂
      K₀ η₀ hη₀_hom hFuncK₀ K N₀
      (fun a => U₀_v (v_cov a))
      (fun a => F_v (v_cov a))
      (fun a => μ_v (v_cov a))
      (fun a => hAff_v (v_cov a))
      (fun a => hNonempty_v (v_cov a))
      (fun a => hCommK_v (v_cov a))
      hRZCover

  let _ : DecidablePred (fun a : Fin N₀ => Nonempty ↥(W' a)) := Classical.decPred _
  let Idx : Type := {a : Fin N₀ // Nonempty ↥(W' a)}
  let N : ℕ := Fintype.card Idx
  let eIdx : Idx ≃ Fin N := Fintype.equivFin Idx
  let idxOf : Fin N → Fin N₀ := fun b => (eIdx.symm b).1
  let W : Fin N → B₃.left.Opens := fun b => W' (idxOf b)

  have hWNonempty : ∀ b : Fin N, Nonempty ↥(W b) := fun b => (eIdx.symm b).2
  have hCover : (⋃ b : Fin N, (W b : Set B₃.left)) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    have hx_univ : x ∈ (⋃ a : Fin N₀, (W' a : Set B₃.left)) := by
      rw [hCover']
      trivial
    obtain ⟨a₀, hx_a₀⟩ := Set.mem_iUnion.mp hx_univ
    have hne_a₀ : Nonempty ↥(W' a₀) := ⟨⟨x, hx_a₀⟩⟩
    refine ⟨eIdx ⟨a₀, hne_a₀⟩, ?_⟩
    change x ∈ (W' (eIdx.symm (eIdx ⟨a₀, hne_a₀⟩)).1 : Set B₃.left)
    simpa using hx_a₀

  let O_loc : ∀ b : Fin N, (W b).toScheme.Opens :=
    fun b => (TopologicalSpace.Opens.map (μ_chart (idxOf b)).base).obj
      (PrimeSpectrum.basicOpen (h_v (v_cov (idxOf b))))
  let U₃_loc : Fin N → B₃.left.Opens :=
    fun b => ⟨(W b).ι.base '' (O_loc b : Set (W b).toScheme),
      (W b).ι.isOpenEmbedding.isOpenMap _ (O_loc b).isOpen⟩
  let U₃ : B₃.left.Opens :=
    (TopologicalSpace.Opens.map ψ₃.left.base).obj U₂ ⊓ Finset.univ.inf U₃_loc

  have hU₃Sub : (U₃ : Set B₃.left) ⊆ ψ₃.left.base ⁻¹' (U₂ : Set B₂.left) :=
    fun _ hx => hx.1

  have hU₃ : Nonempty U₃ := by
    have _ : IrreducibleSpace ↥B₃.left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral B₃.left hIntB₃
    have hOpenNonempty_U₂ :
        ((TopologicalSpace.Opens.map ψ₃.left.base).obj U₂ : Set B₃.left).Nonempty := by
      obtain ⟨⟨u₂, hu₂⟩⟩ := hU₂
      obtain ⟨u₃, rfl⟩ := hψ₃.2.1.surj u₂
      exact ⟨u₃, hu₂⟩
    have hLocNonempty : ∀ b : Fin N, (U₃_loc b : Set B₃.left).Nonempty := by
      intro b
      have hO : Nonempty ↥(O_loc b) :=
        hDom' (idxOf b) (eIdx.symm b).2 (h_v (v_cov (idxOf b))) (hh_ne_v (v_cov (idxOf b)))
      obtain ⟨⟨y, hy⟩⟩ := hO
      exact ⟨(W b).ι.base y, y, hy, rfl⟩
    have hInfNonempty :
        ∀ s : Finset (Fin N), ((s.inf U₃_loc : B₃.left.Opens) : Set B₃.left).Nonempty := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · obtain ⟨x₀⟩ := IrreducibleSpace.toNonempty (X := ↥B₃.left)
        exact ⟨x₀, trivial⟩
      · intro b s' _ ih
        rw [Finset.inf_insert]
        exact nonempty_preirreducible_inter (U₃_loc b).isOpen (s'.inf U₃_loc).isOpen
          (hLocNonempty b) ih
    obtain ⟨x₃, hx₃⟩ :=
      nonempty_preirreducible_inter
        ((TopologicalSpace.Opens.map ψ₃.left.base).obj U₂).isOpen
        (Finset.univ.inf U₃_loc).isOpen
        hOpenNonempty_U₂
        (hInfNonempty Finset.univ)
    exact ⟨⟨x₃, hx₃⟩⟩

  have hLocal :
      ∀ b : Fin N,
        ∃ (C_b : AlgebraicGeometry.Scheme.{u})
          (g_b : C_b ⟶ (W b).toScheme)
          (τ_b : Fin n → ((W b).toScheme ⟶ C_b)),
          IsGeometricStablePointedCurve g_b n τ_b ∧
          HasLocalPointedPullbackIsoOnOpen k f₂ σ ψ₃ U₃ (W b) g_b τ_b := by
    intro b
    let v := v_cov (idxOf b)
    have hU₃_in_D :
        ∀ x : (W b).toScheme,
          (W b).ι.base x ∈ U₃ →
          (μ_chart (idxOf b)).base x ∈ PrimeSpectrum.basicOpen (h_v v) := by
      intro x hx
      have hx_inf : (W b).ι.base x ∈ (Finset.univ.inf U₃_loc : B₃.left.Opens) := hx.2
      have hx_loc : (W b).ι.base x ∈ U₃_loc b :=
        SetLike.le_def.mp (Finset.inf_le (Finset.mem_univ b)) hx_inf
      obtain ⟨y, hy, hyx⟩ := hx_loc
      have h_eq : y = x := (W b).ι.isOpenEmbedding.injective hyx
      rw [← h_eq]
      exact hy
    exact weil_baseChange_stable_curve_and_local_pullback_iso k B₂ X₂ B₃ f₂ n σ ψ₃ U₃ (W b)
      (CommRingCat.of ↥(Algebra.adjoin k (↑(F₀_v v) : Set K)))
      (CommRingCat.of ↥(Algebra.adjoin k (↑(F_v v) : Set K)))
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (Finset.coe_subset.mpr (hSub_v v)))).toRingHom))
      (μ_v v ≫ (U₀_v v).ι)
      (PrimeSpectrum.basicOpen (h_v v))
      (C₀_v v) (g₀_v v) (τ₀_v v) (hStab₀_v v) (hIso_v v)
      (μ_chart (idxOf b))
      (hμ_comm' (idxOf b))
      hU₃_in_D

  choose C_loc g_loc τ_loc hStabLoc hIsoLoc using hLocal

  exact ⟨B₃, U₃, ψ₃, N, W, C_loc, g_loc, τ_loc,
    hIntB₃, hProjB₃, hDimB₃, hNormB₃, hU₃, hψ₃, hU₃Sub, hCover, hWNonempty, hStabLoc, hIsoLoc⟩

theorem weil_isGeometricStablePointedCurve_pullback (S S' C : AlgebraicGeometry.Scheme.{u})
    (f_S : S' ⟶ S) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ) :
    ∃ τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g f_S),
      (∀ j : Fin n,
        τ' j ≫ CategoryTheory.Limits.pullback.fst g f_S = f_S ≫ τ j ∧
        τ' j ≫ CategoryTheory.Limits.pullback.snd g f_S = 𝟙 S' ∧
        Set.range (τ' j).base =
          (CategoryTheory.Limits.pullback.fst g f_S).base ⁻¹' Set.range (τ j).base) ∧
      IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g f_S) n τ' :=
by
  have hcomp_base : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y) (v : Y ⟶ Z) (x : X),
      (u ≫ v).base x = v.base (u.base x) := fun _ _ _ => rfl
  rcases hStab with ⟨hn, hFlat, hProp, hLFP, hSurj, hSec, hDisj, hSmSec, hGeom⟩
  let C' : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g f_S
  let fst : C' ⟶ C := CategoryTheory.Limits.pullback.fst g f_S
  let snd : C' ⟶ S' := CategoryTheory.Limits.pullback.snd g f_S
  have hp : CategoryTheory.IsPullback fst snd g f_S :=
    CategoryTheory.IsPullback.of_hasPullback g f_S
  let τ' : Fin n → (S' ⟶ C') := fun j =>
    CategoryTheory.Limits.pullback.lift (f_S ≫ τ j) (𝟙 S') (by
      rw [CategoryTheory.Category.assoc, hSec j,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hτ'_fst : ∀ j : Fin n, τ' j ≫ fst = f_S ≫ τ j :=
    fun j => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hSec' : ∀ j : Fin n, τ' j ≫ snd = 𝟙 S' :=
    fun j => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hSecRange : ∀ j : Fin n,
      Set.range (τ' j).base = fst.base ⁻¹' Set.range (τ j).base := by
    intro j
    have h_outer : CategoryTheory.IsPullback f_S (τ' j ≫ snd) (τ j ≫ g) f_S := by
      rw [hSec' j, hSec j]
      exact CategoryTheory.IsPullback.of_vert_isIso ⟨by simp⟩
    have hp_sec : CategoryTheory.IsPullback f_S (τ' j) (τ j) fst :=
      (CategoryTheory.IsPullback.paste_vert_iff hp (hτ'_fst j).symm).mp h_outer
    let e_sec : S' ≅ CategoryTheory.Limits.pullback (τ j) fst := hp_sec.isoPullback
    have he_snd : e_sec.hom ≫ CategoryTheory.Limits.pullback.snd (τ j) fst = τ' j :=
      hp_sec.isoPullback_hom_snd
    have hsurj : Function.Surjective e_sec.hom.base := by
      rw [← AlgebraicGeometry.Scheme.coe_homeoOfIso e_sec]
      exact (AlgebraicGeometry.Scheme.homeoOfIso e_sec).surjective
    have h_range_eq : Set.range (τ' j).base =
        Set.range (CategoryTheory.Limits.pullback.snd (τ j) fst).base := by
      rw [← he_snd]
      have h_comp : (⇑(e_sec.hom ≫ CategoryTheory.Limits.pullback.snd (τ j) fst).base : _ → _) =
          ⇑(CategoryTheory.Limits.pullback.snd (τ j) fst).base ∘ ⇑e_sec.hom.base :=
        funext (hcomp_base _ _)
      rw [h_comp, hsurj.range_comp]
    exact h_range_eq.trans (AlgebraicGeometry.Scheme.Pullback.range_snd (τ j) fst)
  have hDisj' : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ' i).base) (Set.range (τ' j).base) := by
    intro i j hij
    rw [hSecRange i, hSecRange j]
    exact Disjoint.preimage _ (hDisj hij)
  have hFlat' : AlgebraicGeometry.Flat snd :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Flat) hp hFlat
  have hProp' : AlgebraicGeometry.IsProper snd :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hp hProp
  have hLFP' : AlgebraicGeometry.LocallyOfFinitePresentation snd :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.LocallyOfFinitePresentation) hp hLFP
  have hSurj' : AlgebraicGeometry.Surjective snd :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Surjective) hp hSurj
  have hSmSec' : ∀ (j : Fin n) (b' : S'), ∃ V' : C'.Opens,
      (τ' j).base b' ∈ V' ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V'.ι ≫ snd) := by
    intro j b'
    obtain ⟨V, hbV, hSmV⟩ := hSmSec j (f_S.base b')
    let V' : C'.Opens := (TopologicalSpace.Opens.map fst.base).obj V
    refine ⟨V', ?_, ?_⟩
    · show fst.base ((τ' j).base b') ∈ V
      rw [← hcomp_base, hτ'_fst j, hcomp_base]
      exact hbV
    · have hp_res : CategoryTheory.IsPullback (fst ∣_ V) V'.ι V.ι fst :=
        AlgebraicGeometry.isPullback_morphismRestrict fst V
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) (hp_res.paste_vert hp) hSmV
  have hIrredHomeo : ∀ {X Z : Type u} [TopologicalSpace X] [TopologicalSpace Z]
      (h : X ≃ₜ Z) {A : Set X},
      A ∈ irreducibleComponents X → h '' A ∈ irreducibleComponents Z := by
    intro X Z _ _ h A hA
    refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
      (fun z => Set.Subsingleton.isPreirreducible fun x₁ hx₁ x₂ hx₂ =>
        h.injective (hx₁.trans hx₂.symm))
      h.surjective hA
  refine ⟨τ', fun j => ⟨hτ'_fst j, hSec' j, hSecRange j⟩,
    ⟨hn, hFlat', hProp', hLFP', hSurj', hSec', hDisj', hSmSec', ?_⟩⟩
  intro K _ _ s'
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ S := s' ≫ f_S
  have hp_fib : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst snd s' ≫ fst)
      (CategoryTheory.Limits.pullback.snd snd s') g s₀ :=
    (CategoryTheory.IsPullback.of_hasPullback snd s').paste_horiz hp
  let Φ : CategoryTheory.Limits.pullback snd s' ≅ CategoryTheory.Limits.pullback g s₀ :=
    hp_fib.isoPullback
  have hΦ_fst : Φ.hom ≫ CategoryTheory.Limits.pullback.fst g s₀ =
      CategoryTheory.Limits.pullback.fst snd s' ≫ fst :=
    hp_fib.isoPullback_hom_fst
  have hΦ_snd : Φ.hom ≫ CategoryTheory.Limits.pullback.snd g s₀ =
      CategoryTheory.Limits.pullback.snd snd s' :=
    hp_fib.isoPullback_hom_snd
  have hΦ_inv_snd : Φ.inv ≫ CategoryTheory.Limits.pullback.snd snd s' =
      CategoryTheory.Limits.pullback.snd g s₀ := by
    rw [← hΦ_snd, ← CategoryTheory.Category.assoc, Φ.inv_hom_id, CategoryTheory.Category.id_comp]
  let hΦ : ↥(CategoryTheory.Limits.pullback snd s') ≃ₜ ↥(CategoryTheory.Limits.pullback g s₀) :=
    AlgebraicGeometry.Scheme.homeoOfIso Φ
  rcases hGeom K s₀ with ⟨hConn, hLoc, hP1⟩
  refine ⟨?_, ?_, ?_⟩
  · have _ : ConnectedSpace ↥(CategoryTheory.Limits.pullback g s₀) := hConn
    exact Function.Surjective.connectedSpace hΦ.symm.surjective hΦ.symm.continuous
  · intro y'
    rcases hLoc (hΦ y') with ⟨V, hyV, hSmV⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hMax, hRoof⟩
    · left
      let V' : (CategoryTheory.Limits.pullback snd s').Opens :=
        (TopologicalSpace.Opens.map Φ.hom.base).obj V
      refine ⟨V', ?_, ?_⟩
      · show Φ.hom.base y' ∈ V
        rwa [← AlgebraicGeometry.Scheme.homeoOfIso_apply Φ y']
      · have hp_res : CategoryTheory.IsPullback (Φ.hom ∣_ V) V'.ι V.ι Φ.hom :=
          AlgebraicGeometry.isPullback_morphismRestrict Φ.hom V
        have _ : CategoryTheory.IsIso (Φ.hom ∣_ V) := hp_res.isIso_fst_of_isIso
        have hp_iso : CategoryTheory.IsPullback (Φ.hom ∣_ V)
            (V'.ι ≫ CategoryTheory.Limits.pullback.snd snd s')
            (V.ι ≫ CategoryTheory.Limits.pullback.snd g s₀)
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K))) := by
          refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
          rw [CategoryTheory.Category.comp_id, ← hΦ_snd, ← CategoryTheory.Category.assoc,
            hp_res.w, CategoryTheory.Category.assoc]
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hp_iso hSmV
    · right
      have _ : AlgebraicGeometry.Etale e₁ := hEt₁
      refine ⟨U', u₀, e₁ ≫ Φ.inv, e₂, inferInstance, hEt₂, ?_, hMax, ?_⟩
      · rw [hcomp_base, hu₀,
          AlgebraicGeometry.Scheme.homeoOfIso_apply Φ y',
          ← hcomp_base, Φ.hom_inv_id]
        rfl
      · rw [CategoryTheory.Category.assoc, hΦ_inv_snd, hRoof]
  · intro E' E_sch ιE' hE' hCl' hIntE hRange' ⟨isoP1, hisoP1⟩
    let E : Set ↥(CategoryTheory.Limits.pullback g s₀) := hΦ '' E'
    let ιE : E_sch ⟶ CategoryTheory.Limits.pullback g s₀ := ιE' ≫ Φ.hom
    have hE : E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀) :=
      hIrredHomeo hΦ hE'
    have _ : AlgebraicGeometry.IsClosedImmersion ιE' := hCl'
    have hCl : AlgebraicGeometry.IsClosedImmersion ιE := inferInstance
    have hRange : Set.range ιE.base = E := by
      have h_comp : (⇑(ιE' ≫ Φ.hom).base : _ → _) = ⇑Φ.hom.base ∘ ⇑ιE'.base :=
        funext (hcomp_base _ _)
      change Set.range (ιE' ≫ Φ.hom).base = hΦ '' E'
      rw [h_comp, Set.range_comp, hRange', AlgebraicGeometry.Scheme.coe_homeoOfIso Φ]
    have hisoP1₀ : ιE ≫ CategoryTheory.Limits.pullback.snd g s₀ =
        isoP1.hom ≫ (weilProjectiveSpaceOver K 1).hom := by
      change (ιE' ≫ Φ.hom) ≫ CategoryTheory.Limits.pullback.snd g s₀ = _
      rw [CategoryTheory.Category.assoc, hΦ_snd, hisoP1]
    obtain ⟨q₁, q₂, q₃, h12, h13, h23, hq₁E, hq₂E, hq₃E, hSpec⟩ :=
      hP1 E E_sch ιE hE hCl hIntE hRange ⟨isoP1, hisoP1₀⟩
    have hmem_symm : ∀ {q : ↥(CategoryTheory.Limits.pullback g s₀)},
        q ∈ E → hΦ.symm q ∈ E' := by
      rintro q ⟨x, hx, rfl⟩
      simpa using hx
    refine ⟨hΦ.symm q₁, hΦ.symm q₂, hΦ.symm q₃,
      fun h => h12 (hΦ.symm.injective h),
      fun h => h13 (hΦ.symm.injective h),
      fun h => h23 (hΦ.symm.injective h),
      hmem_symm hq₁E, hmem_symm hq₂E, hmem_symm hq₃E, ?_⟩
    intro q' hq'
    have hq_mem : hΦ q' ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g s₀)) := by
      rcases hq' with rfl | rfl | rfl <;> simp
    rcases hSpec (hΦ q') hq_mem with ⟨E₁, hE₁, hE₁_ne, hqE₁⟩ | ⟨j, hj⟩
    · left
      refine ⟨hΦ.symm '' E₁, hIrredHomeo hΦ.symm hE₁, ?_, ⟨hΦ q', hqE₁, hΦ.symm_apply_apply q'⟩⟩
      intro h_eq
      apply hE₁_ne
      calc E₁ = (hΦ ∘ hΦ.symm) '' E₁ := by simp
        _ = hΦ '' (hΦ.symm '' E₁) := (Set.image_image hΦ hΦ.symm E₁).symm
        _ = hΦ '' E' := by rw [h_eq]
        _ = E := rfl
    · right
      refine ⟨j, ?_⟩
      rw [hSecRange j]
      show fst.base ((CategoryTheory.Limits.pullback.fst snd s').base q') ∈ Set.range (τ j).base
      rw [← hcomp_base, ← hΦ_fst, hcomp_base,
        ← AlgebraicGeometry.Scheme.homeoOfIso_apply Φ q']
      exact hj

theorem weil_lci_cramer_blockShear_and_flat_zeroAnnihilator : (∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k₁ k₂ : ℕ)
      (J₁ : Matrix (Fin (k₁ + 1)) (Fin k₁) B)
      (q₁ : (Fin (k₁ + 1) → B) →ₗ[B] Ω_mod)
      (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) B)
      (q₂ : (Fin (k₂ + 1) → B) →ₗ[B] Ω_mod),
      Function.Surjective q₁ →
      LinearMap.ker q₁ = LinearMap.range J₁.mulVecLin →
      Function.Surjective q₂ →
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin →
      Function.Injective J₂.mulVecLin →
      Function.Injective J₁.mulVecLin ∧
      ∃ (ψ₁ ψ₂ : Ω_mod →ₗ[B] B) (u : Bˣ),
        (∀ v : Fin (k₁ + 1) → B,
          ψ₁ (q₁ v) = ∑ r : Fin (k₁ + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id)) ∧
        (∀ w : Fin (k₂ + 1) → B,
          ψ₂ (q₂ w) = ∑ s : Fin (k₂ + 1),
            w s * (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) ∧
        ψ₁ = u.val • ψ₂) ∧
    (∀ (A B : Type u) [CommRing A] [IsNoetherianRing A]
      [CommRing B] [Algebra A B] [Module.Flat A B] (S_gen : Set B),
      (∀ (p : PrimeSpectrum A),
        let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
        letI : Algebra A Ω :=
          ((algebraMap p.asIdeal.ResidueField Ω).comp
            (algebraMap A p.asIdeal.ResidueField)).toAlgebra
        ∀ z : TensorProduct A B Ω,
          (∀ b ∈ S_gen, TensorProduct.tmul A b (1 : Ω) * z = 0) → z = 0) →
      ∀ z : B, (∀ b ∈ S_gen, b * z = 0) → z = 0) :=
by
  refine ⟨?_, ?_⟩
  · intro B _ Ω_mod _ _ k₁ k₂ J₁ q₁ J₂ q₂ hq₁_surj hq₁_ker hq₂_surj hq₂_ker hJ₂_inj
    have hDescent : ∀ (k : ℕ) (J : Matrix (Fin (k + 1)) (Fin k) B)
        (q : (Fin (k + 1) → B) →ₗ[B] Ω_mod),
        Function.Surjective q →
        LinearMap.ker q = LinearMap.range J.mulVecLin →
        ∃ ψ : Ω_mod →ₗ[B] B,
          (∀ v : Fin (k + 1) → B,
            ψ (q v) = ∑ r : Fin (k + 1),
              v r * (-1) ^ (r : ℕ) * Matrix.det (J.submatrix r.succAbove id)) ∧
          (∀ v : Fin (k + 1) → B,
            ψ (q v) = Matrix.det (Matrix.of fun (i c : Fin (k + 1)) =>
              Fin.cases (v i) (fun j => J i j) c)) := by
      intro k J q hq_surj hq_ker
      let aug : (Fin (k + 1) → B) → Matrix (Fin (k + 1)) (Fin (k + 1)) B :=
        fun v => Matrix.of fun (i c : Fin (k + 1)) => Fin.cases (v i) (fun j => J i j) c
      have h_aug_det : ∀ v : Fin (k + 1) → B,
          (aug v).det = ∑ r : Fin (k + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J.submatrix r.succAbove id) := by
        intro v
        rw [Matrix.det_succ_column_zero (aug v)]
        refine Finset.sum_congr rfl fun r _ => ?_
        have h_col0 : aug v r 0 = v r := rfl
        have h_sub : (aug v).submatrix r.succAbove Fin.succ = J.submatrix r.succAbove id := by
          ext i' j
          rfl
        rw [h_col0, h_sub, mul_comm ((-1 : B) ^ (r : ℕ)) (v r)]
      let Φ : (Fin (k + 1) → B) →ₗ[B] B :=
        { toFun := fun v => ∑ r : Fin (k + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J.submatrix r.succAbove id)
          map_add' := fun v₁ v₂ => by
            simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
          map_smul' := fun c v => by
            simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
            refine Finset.sum_congr rfl fun r _ => ?_
            ring }
      have hΦ_det : ∀ v : Fin (k + 1) → B, Φ v = (aug v).det :=
        fun v => (h_aug_det v).symm
      have hΦ_col : ∀ j₀ : Fin k, Φ (fun i => J i j₀) = 0 := by
        intro j₀
        rw [hΦ_det]
        have h_eq : ∀ i : Fin (k + 1),
            aug (fun i' => J i' j₀) i 0 = aug (fun i' => J i' j₀) i j₀.succ :=
          fun _ => rfl
        exact Matrix.det_zero_of_column_eq (Fin.succ_ne_zero j₀).symm h_eq
      have h_ker_le : LinearMap.ker q ≤ LinearMap.ker Φ := by
        intro w hw
        rw [hq_ker, LinearMap.mem_range] at hw
        obtain ⟨x, rfl⟩ := hw
        rw [LinearMap.mem_ker]
        have hx_decomp : J.mulVecLin x = ∑ j : Fin k, x j • (fun i => J i j) := by
          ext i
          simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Finset.sum_apply,
            Pi.smul_apply, smul_eq_mul, mul_comm]
        rw [hx_decomp, map_sum]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [map_smul, hΦ_col j, smul_zero]
      let ψ : Ω_mod →ₗ[B] B :=
        ((LinearMap.ker q).liftQ Φ h_ker_le).comp
          (q.quotKerEquivOfSurjective hq_surj).symm.toLinearMap
      have hψ_apply : ∀ v : Fin (k + 1) → B, ψ (q v) = Φ v := by
        intro v
        have h1 : (q.quotKerEquivOfSurjective hq_surj) (Submodule.Quotient.mk v) = q v := rfl
        have h2 : (q.quotKerEquivOfSurjective hq_surj).symm (q v) = Submodule.Quotient.mk v := by
          rw [← h1, LinearEquiv.symm_apply_apply]
        simp [ψ, h2]
      exact ⟨ψ, hψ_apply, fun v => (hψ_apply v).trans (hΦ_det v)⟩
    have hPiSingle : ∀ {n : ℕ} (v : Fin n → B),
        v = ∑ r : Fin n, v r • Pi.single r (1 : B) := by
      intro n v
      ext i
      simp [Finset.sum_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, mul_ite]
    choose a_col ha_col using fun r : Fin (k₁ + 1) => hq₂_surj (q₁ (Pi.single r 1))
    let A₀ : Matrix (Fin (k₂ + 1)) (Fin (k₁ + 1)) B := Matrix.of fun s r => a_col r s
    have hA₀_mulVec : ∀ v : Fin (k₁ + 1) → B,
        A₀.mulVec v = ∑ r : Fin (k₁ + 1), v r • a_col r := by
      intro v
      ext s
      simp [A₀, Matrix.mulVec, dotProduct, Finset.sum_apply, mul_comm]
    have hq₂_A₀ : ∀ v : Fin (k₁ + 1) → B, q₂ (A₀.mulVec v) = q₁ v := by
      intro v
      rw [hA₀_mulVec v, map_sum]
      conv_rhs => rw [hPiSingle v, map_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_smul, map_smul, ha_col r]
    choose b_col hb_col using fun s : Fin (k₂ + 1) => hq₁_surj (q₂ (Pi.single s 1))
    let B₀ : Matrix (Fin (k₁ + 1)) (Fin (k₂ + 1)) B := Matrix.of fun r s => b_col s r
    have hB₀_mulVec : ∀ w : Fin (k₂ + 1) → B,
        B₀.mulVec w = ∑ s : Fin (k₂ + 1), w s • b_col s := by
      intro w
      ext r
      simp [B₀, Matrix.mulVec, dotProduct, Finset.sum_apply, mul_comm]
    have hq₁_B₀ : ∀ w : Fin (k₂ + 1) → B, q₁ (B₀.mulVec w) = q₂ w := by
      intro w
      rw [hB₀_mulVec w, map_sum]
      conv_rhs => rw [hPiSingle w, map_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [map_smul, map_smul, hb_col s]
    let aug₁ : (Fin (k₁ + 1) → B) → Matrix (Fin (k₁ + 1)) (Fin (k₁ + 1)) B :=
      fun v => Matrix.of fun i c => Fin.cases (v i) (fun j => J₁ i j) c
    let aug₂ : (Fin (k₂ + 1) → B) → Matrix (Fin (k₂ + 1)) (Fin (k₂ + 1)) B :=
      fun w => Matrix.of fun i c => Fin.cases (w i) (fun j => J₂ i j) c
    let C₂₂ : Matrix (Fin (k₂ + 1)) (Fin (k₂ + 1)) B := 1 - A₀ * B₀
    let C₁₁ : Matrix (Fin (k₁ + 1)) (Fin (k₁ + 1)) B := 1 - B₀ * A₀
    let P_L : Matrix (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) B :=
      Matrix.fromBlocks 1 0 A₀ 1
    let P_R : Matrix (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) B :=
      Matrix.fromBlocks 1 (-B₀) 0 1
    let P : Matrix (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) B :=
      P_L * P_R
    have hP_blocks : P = Matrix.fromBlocks 1 (-B₀) A₀ C₂₂ := by
      have hC : -(A₀ * B₀) + 1 = C₂₂ := by
        simp [C₂₂, sub_eq_add_neg, add_comm]
      simp [P, P_L, P_R, Matrix.fromBlocks_multiply, hC]
    let P_R_inv : Matrix (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) B :=
      Matrix.fromBlocks 1 B₀ 0 1
    let P_L_inv : Matrix (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) B :=
      Matrix.fromBlocks 1 0 (-A₀) 1
    let P_inv : Matrix (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) (Fin (k₁ + 1) ⊕ Fin (k₂ + 1)) B :=
      P_R_inv * P_L_inv
    have hPinv_blocks : P_inv = Matrix.fromBlocks C₁₁ B₀ (-A₀) 1 := by
      have hC : 1 + -(B₀ * A₀) = C₁₁ := by
        simp [C₁₁, sub_eq_add_neg]
      simp [P_inv, P_R_inv, P_L_inv, Matrix.fromBlocks_multiply, hC]
    have hPR_mul : P_R * P_R_inv = 1 := by
      simp [P_R, P_R_inv, Matrix.fromBlocks_multiply]
    have hPL_mul : P_L * P_L_inv = 1 := by
      simp [P_L, P_L_inv, Matrix.fromBlocks_multiply]
    have hP_Pinv : P * P_inv = 1 := by
      calc P * P_inv = P_L * (P_R * P_R_inv) * P_L_inv := by simp only [P, P_inv, mul_assoc]
        _ = P_L * P_L_inv := by rw [hPR_mul, mul_one]
        _ = 1 := hPL_mul
    have hP_det : P.det = 1 := by
      rw [show P = P_L * P_R from rfl, Matrix.det_mul]
      have hL : P_L.det = 1 := by
        rw [show P_L = Matrix.fromBlocks 1 0 A₀ 1 from rfl, Matrix.det_fromBlocks_zero₁₂]
        simp
      have hR : P_R.det = 1 := by
        rw [show P_R = Matrix.fromBlocks 1 (-B₀) 0 1 from rfl, Matrix.det_fromBlocks_zero₂₁]
        simp
      rw [hL, hR, mul_one]
    have hγ₁_ex : ∀ j₁ : Fin k₁,
        ∃ γ : Fin k₂ → B, J₂.mulVec γ = A₀.mulVec (fun i₁ => J₁ i₁ j₁) := by
      intro j₁
      have hcol : (fun i₁ => J₁ i₁ j₁) = J₁.mulVecLin (Pi.single j₁ 1) := by
        ext i₁
        simp [Matrix.mulVec, dotProduct, Pi.single_apply]
      have hker1 : (fun i₁ => J₁ i₁ j₁) ∈ LinearMap.ker q₁ := by
        rw [hq₁_ker]
        exact ⟨Pi.single j₁ 1, hcol.symm⟩
      have hker2 : A₀.mulVec (fun i₁ => J₁ i₁ j₁) ∈ LinearMap.ker q₂ := by
        rw [LinearMap.mem_ker, hq₂_A₀]
        exact LinearMap.mem_ker.mp hker1
      rw [hq₂_ker, LinearMap.mem_range] at hker2
      exact hker2
    choose γ₁ hγ₁ using hγ₁_ex
    have hγ₂_ex : ∀ i₂ : Fin (k₂ + 1),
