      rw [← Ideal.mem_comap, hComap_π_qD]
      exact hs_not_u0
    obtain ⟨r_inv, hr_inv⟩ :=
      isUnit_iff_exists_inv.mp
        (IsLocalization.map_units R_loc (⟨π s, hπs_not_qD⟩ : q_D.primeCompl))
    refine ⟨j_loc r_inv, ⟨r_inv, rfl⟩, ?_⟩
    change ι_D (π s) * j_loc r_inv = 1
    rw [← hj_loc_eq (π s), ← map_mul, hr_inv, map_one]
  · refine ⟨j_loc w₀, j_loc w₀_inv, j_loc u₀_diff, j_loc u₀_inv,
      ⟨w₀, rfl⟩, ⟨w₀_inv, rfl⟩, ?_, ⟨u₀_diff, rfl⟩, ⟨u₀_inv, rfl⟩, ?_, ht_K_eq, hDiff_tP⟩
    · rw [← map_mul, hw₀_mul, map_one]
    · rw [← map_mul, hu₀_mul, map_one]
  · exact hUnitDesc

theorem weil_algClosed_nodal_etale_branch_pinching_and_cotangent (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (n : ℕ) (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (c δ : ℕ)
    (E_set : Fin (c + 1) → Set C)
    (E_norm : Fin (c + 1) → AlgebraicGeometry.Scheme.{u})
    (p_norm : ∀ α : Fin (c + 1), E_norm α ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
    (ν : ∀ α : Fin (c + 1), E_norm α ⟶ C)
    (F : Fin (c + 1) → Type u)
    [∀ α : Fin (c + 1), Field (F α)]
    [∀ α : Fin (c + 1), Algebra Ω (F α)]
    (η_F : ∀ α : Fin (c + 1), AlgebraicGeometry.Spec (CommRingCat.of (F α)) ⟶ E_norm α)
    (z_node : Fin δ → C)
    (pt_C : ∀ (x : C), IsClosed ({x} : Set C) →
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ C))
    (pt_E : ∀ (α : Fin (c + 1)) (P : E_norm α), IsClosed ({P} : Set (E_norm α)) →
      (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E_norm α))
    (hPreNorm : IsNodalCurvePreNormalizationData Ω C g n τ c δ E_set E_norm p_norm ν F η_F
      z_node pt_C pt_E) :
    ∃ (α₀ : Fin δ → Fin (c + 1)) (P₀ : ∀ r : Fin δ, E_norm (α₀ r))
      (α₁ : Fin δ → Fin (c + 1)) (P₁ : ∀ r : Fin δ, E_norm (α₁ r)),
      HasNodalEtaleBranchAndPinchingData Ω C g c δ E_norm ν F η_F
        z_node pt_E α₀ P₀ α₁ P₁ :=
by
  rcases hPreNorm with ⟨⟨_hSepC, _hRedC⟩, hComp, hNorm,
      ⟨hz_inj, hz_closed_nsm, _hSmCompl, _hInterSub, _hMark⟩,
      hProdInj, hPtC, hPtE, hSmLoc, _hSmCot, hGenLoc, hNormDVR⟩
  
  
  
  have hAffHom_ν : ∀ α : Fin (c + 1), AlgebraicGeometry.IsAffineHom (ν α) := by
    intro α
    haveI : AlgebraicGeometry.IsFinite (ν α) := (hNorm α).2.2.2.1
    infer_instance
  have hAffPre : ∀ (U : C.Opens), AlgebraicGeometry.IsAffineOpen U →
      ∀ α : Fin (c + 1),
        AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj U) := by
    intro U hU α
    haveI := hAffHom_ν α
    exact hU.preimage (ν α)
  have hFinApp : ∀ (U : C.Opens), AlgebraicGeometry.IsAffineOpen U →
      ∀ α : Fin (c + 1), (((ν α).app U).hom).Finite := by
    intro U hU α
    haveI : AlgebraicGeometry.IsFinite (ν α) := (hNorm α).2.2.2.1
    exact AlgebraicGeometry.IsFinite.finite_app (ν α) U hU
  have hFromSpecInj : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hU : AlgebraicGeometry.IsAffineOpen U),
      Function.Injective hU.fromSpec.base := by
    intro X U hU p₁ p₂ hp
    exact hU.fromSpec.isOpenEmbedding.injective hp
  have hFromSpecMem : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hU : AlgebraicGeometry.IsAffineOpen U)
      (p : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U))),
      hU.fromSpec.base p ∈ U := by
    intro X U hU p
    have hp : p ∈ (⊤ : (AlgebraicGeometry.Spec _).Opens) := trivial
    rw [← hU.fromSpec_preimage_self] at hp
    exact hp
  have hPrimeIdealOfFromSpec : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hU : AlgebraicGeometry.IsAffineOpen U)
      (p : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U)))
      (hp : hU.fromSpec.base p ∈ U),
      hU.primeIdealOf ⟨hU.fromSpec.base p, hp⟩ = p := by
    intro X U hU p hp
    apply hFromSpecInj hU
    exact hU.fromSpec_primeIdealOf ⟨hU.fromSpec.base p, hp⟩
  have hMemBasic : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hU : AlgebraicGeometry.IsAffineOpen U)
      (p : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U)))
      (f : ↑(X.presheaf.obj (Opposite.op U))),
      hU.fromSpec.base p ∈ X.basicOpen f ↔ f ∉ p.asIdeal := by
    intro X U hU p f
    change p ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen f ↔ f ∉ p.asIdeal
    rw [hU.fromSpec_preimage_basicOpen f]
    exact PrimeSpectrum.mem_basicOpen f p
  have hLocOpenEq : ∀ {X : AlgebraicGeometry.Scheme.{u}} {W W' : X.Opens}
      (hW : AlgebraicGeometry.IsAffineOpen W)
      (r : ↑(X.presheaf.obj (Opposite.op W)))
      (hEq : W' = X.basicOpen r) (hle : W' ≤ W),
      @IsLocalization.Away ↑(X.presheaf.obj (Opposite.op W)) _ r
        ↑(X.presheaf.obj (Opposite.op W')) _
        ((X.presheaf.map (CategoryTheory.homOfLE hle).op).hom).toAlgebra := by
    intro X W W' hW r hEq hle
    subst hEq
    exact hW.isLocalization_basicOpen r
  have hSubOrDom : ∀ (U : C.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (α : Fin (c + 1)),
      Subsingleton ↑((E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj U))) ∨
      IsDomain ↑((E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj U))) := by
    intro U hU α
    let W : (E_norm α).Opens := (TopologicalSpace.Opens.map (ν α).base).obj U
    by_cases hne : Nonempty ↥W
    · obtain ⟨φ_F, hFrac, _⟩ := (hNorm α).2.2.2.2.2.2.2.2 W (hAffPre U hU α) hne
      letI : Algebra ↑((E_norm α).presheaf.obj (Opposite.op W)) (F α) := φ_F.hom.toAlgebra
      haveI : IsFractionRing ↑((E_norm α).presheaf.obj (Opposite.op W)) (F α) := hFrac
      have hinj : Function.Injective φ_F.hom := IsFractionRing.injective _ (F α)
      right
      haveI : Nontrivial ↑((E_norm α).presheaf.obj (Opposite.op W)) :=
        ⟨⟨0, 1, fun h01 => zero_ne_one ((map_zero φ_F.hom).symm.trans
          ((congrArg φ_F.hom h01).trans (map_one φ_F.hom)))⟩⟩
      haveI : NoZeroDivisors ↑((E_norm α).presheaf.obj (Opposite.op W)) :=
        ⟨fun {a b} hab => by
          have hF : φ_F.hom a * φ_F.hom b = 0 := by
            rw [← map_mul, hab, map_zero]
          rcases mul_eq_zero.mp hF with ha | hb
          · left; exact hinj (ha.trans (map_zero _).symm)
          · right; exact hinj (hb.trans (map_zero _).symm)⟩
      exact IsDomain.mk
    · have hW_bot : W = ⊥ := by
        ext x
        simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
        exact fun hx => hne ⟨x, hx⟩
      left
      change Subsingleton ↑((E_norm α).presheaf.obj (Opposite.op W))
      rw [hW_bot]
      infer_instance
  
  have hEvalConst : ∀ {X : AlgebraicGeometry.Scheme.{u}}
      (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (ι : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X)
      (hSec : ι ≫ p_X = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (U : X.Opens)
      (h_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
        (TopologicalSpace.Opens.map ι.base).obj U)
      (c_val : Ω),
      weilPointEvalRingHom ι U h_in
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p_X.appLE ⊤ U (fun _ _ => trivial)).hom c_val) = c_val := by
    intro X p_X ι hSec U h_in c_val
    have hmid :
        p_X.appLE ⊤ U (fun _ _ => trivial) ≫ ι.appLE U ⊤ h_in = 𝟙 _ := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι p_X ⊤ U ⊤ le_top h_in,
        hSec, AlgebraicGeometry.Scheme.Hom.appLE]
      have hid : CategoryTheory.homOfLE
          (le_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))) ⁻¹ᵁ ⊤) =
          𝟙 ⊤ := Subsingleton.elim _ _
      simp [hid]
    have hcomp :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          (p_X.appLE ⊤ U (fun _ _ => trivial) ≫ ι.appLE U ⊤ h_in)) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom =
        𝟙 (CommRingCat.of Ω) := by
      rw [hmid, CategoryTheory.Category.comp_id, CategoryTheory.Iso.inv_hom_id]
    have hcomp' :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p_X.appLE ⊤ U (fun _ _ => trivial)) ≫
          (ι.appLE U ⊤ h_in ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom) =
        𝟙 (CommRingCat.of Ω) := by
      simpa only [CategoryTheory.Category.assoc] using hcomp
    exact congrArg (fun m => m.hom c_val) hcomp'
  have hEvalConstE : ∀ (α : Fin (c + 1)) (P : E_norm α)
      (hP : IsClosed ({P} : Set (E_norm α)))
      (U : C.Opens)
      (h_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
        (TopologicalSpace.Opens.map (pt_E α P hP).base).obj
          ((TopologicalSpace.Opens.map (ν α).base).obj U))
      (c_val : Ω),
      weilPointEvalRingHom (pt_E α P hP) ((TopologicalSpace.Opens.map (ν α).base).obj U) h_in
        (((ν α).app U).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            g.appLE ⊤ U (fun _ _ => trivial)).hom c_val)) = c_val := by
    intro α P hP U h_in c_val
    have happ : g.appLE ⊤ U (fun _ _ => trivial) ≫ (ν α).app U =
        (p_norm α).appLE ⊤ ((TopologicalSpace.Opens.map (ν α).base).obj U) (fun _ _ => trivial) := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE (ν α) g ⊤ U _ (fun _ _ => trivial) (le_refl _),
        (hNorm α).2.2.2.2.1]
    have hc : (((ν α).app U).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          g.appLE ⊤ U (fun _ _ => trivial)).hom c_val)) =
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          (p_norm α).appLE ⊤ ((TopologicalSpace.Opens.map (ν α).base).obj U)
            (fun _ _ => trivial)).hom c_val) := by
      rw [← happ, ← CategoryTheory.Category.assoc]
      rfl
    rw [hc]
    exact hEvalConst (p_norm α) (pt_E α P hP) (hPtE α P hP).1 _ h_in c_val
  have hBaseNuFromSpec : ∀ (U : C.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (α : Fin (c + 1))
      (hW : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ν α).base).obj U))
      (q : PrimeSpectrum ↑((E_norm α).presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj U)))),
      (ν α).base (hW.fromSpec.base q) =
        hU.fromSpec.base (PrimeSpectrum.comap (((ν α).app U).hom) q) := by
    intro U hU α hW q
    have hcomm : AlgebraicGeometry.Spec.map ((ν α).app U) ≫ hU.fromSpec =
        hW.fromSpec ≫ ν α := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (ν α) hU hW (le_refl _)
    exact (congrArg (fun m : AlgebraicGeometry.Spec _ ⟶ C => m.base q) hcomm).symm

  
  
  
  have hChartNode : ∀ (V : C.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (p_z : PrimeSpectrum ↑(C.presheaf.obj (Opposite.op V)))
      (r : Fin δ),
      hV.fromSpec.base p_z = z_node r →
      ∃ (g₁ : ↑(C.presheaf.obj (Opposite.op V))),
        g₁ ∉ p_z.asIdeal ∧
        (∀ r' : Fin δ, r' ≠ r → z_node r' ∉ C.basicOpen g₁) ∧
        let V₁ : C.Opens := C.basicOpen g₁
        let B₁ := ↑(C.presheaf.obj (Opposite.op V₁))
        let res_V1 : ↑(C.presheaf.obj (Opposite.op V)) →+* B₁ :=
          (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le g₁)).op).hom
        let c_B₁ : Ω →+* B₁ :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            g.appLE ⊤ V₁ (fun _ _ => trivial)).hom)
        ∃ (A'₁ : Type u) (instRingA'₁ : CommRing A'₁),
          letI : CommRing A'₁ := instRingA'₁
          ∃ (u₁ : PrimeSpectrum A'₁)
            (e₁ : AlgebraicGeometry.Spec (CommRingCat.of A'₁) ⟶ V.toScheme)
            (e₂ : AlgebraicGeometry.Spec (CommRingCat.of A'₁) ⟶
              AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) Ω ⧸
                  Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} :
                    Set (MvPolynomial (Fin 2) Ω)))))
            (φ₁ : B₁ →+* A'₁)
            (p_y1 : PrimeSpectrum B₁),
            AlgebraicGeometry.Etale e₁ ∧
            AlgebraicGeometry.Etale e₂ ∧
            (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₁).asIdeal) ∧
            (e₁ ≫ V.ι ≫ g =
              e₂ ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) ∧
            ((V.topIso.inv ≫ e₁.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A'₁)).hom).hom =
              φ₁.comp res_V1) ∧
            (((φ₁.comp res_V1).comp
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                g.appLE ⊤ V (fun _ _ => trivial)).hom)) =
              (AlgebraicGeometry.Spec.preimage e₂).hom.comp
                ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
            φ₁.Etale ∧
            (AlgebraicGeometry.Spec.preimage e₂).hom.Etale ∧
            Ideal.comap res_V1 p_y1.asIdeal = p_z.asIdeal ∧
            p_y1.asIdeal.IsMaximal ∧
            (hV.basicOpen g₁).fromSpec.base p_y1 = z_node r ∧
            Ideal.comap φ₁ u₁.asIdeal = p_y1.asIdeal ∧
            Function.Bijective ((Ideal.Quotient.mk u₁.asIdeal).comp (φ₁.comp c_B₁)) ∧
            let ψ₁ := (AlgebraicGeometry.Spec.preimage e₂).hom
            let x₀ : A'₁ := ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
            let x₁ : A'₁ := ψ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
            let D₀ := A'₁ ⧸ Ideal.span {x₁}
            let D₁ := A'₁ ⧸ Ideal.span {x₀}
            let π₀ : A'₁ →+* D₀ := Ideal.Quotient.mk (Ideal.span {x₁})
            let π₁ : A'₁ →+* D₁ := Ideal.Quotient.mk (Ideal.span {x₀})
            let B_tilde₁ : Fin (c + 1) → Type u := fun α =>
              ↑((E_norm α).presheaf.obj
                (Opposite.op ((TopologicalSpace.Opens.map (ν α).base).obj V₁)))
            let ι₁ : ∀ α : Fin (c + 1), B₁ →+* B_tilde₁ α :=
              fun α => ((ν α).app V₁).hom
            x₀ * x₁ = 0 ∧
            Ideal.span {x₀, x₁} = u₁.asIdeal ∧
            IsDomain D₀ ∧
            IsDomain D₁ ∧
            π₀ x₀ ≠ 0 ∧
            π₁ x₁ ≠ 0 ∧
            ∃ (α'_0 α'_1 : Fin (c + 1))
              (p'_0 : PrimeSpectrum (B_tilde₁ α'_0))
              (p'_1 : PrimeSpectrum (B_tilde₁ α'_1))
              (ψ_br₀ : B_tilde₁ α'_0 →+* D₀)
              (ψ_br₁ : B_tilde₁ α'_1 →+* D₁),
              p'_0.asIdeal.IsMaximal ∧
              p'_1.asIdeal.IsMaximal ∧
              Ideal.comap (ι₁ α'_0) p'_0.asIdeal = p_y1.asIdeal ∧
              Ideal.comap (ι₁ α'_1) p'_1.asIdeal = p_y1.asIdeal ∧
              Ideal.comap ψ_br₀ (Ideal.map π₀ u₁.asIdeal) = p'_0.asIdeal ∧
              Ideal.comap ψ_br₁ (Ideal.map π₁ u₁.asIdeal) = p'_1.asIdeal ∧
              ψ_br₀.comp (ι₁ α'_0) = π₀.comp φ₁ ∧
              ψ_br₁.comp (ι₁ α'_1) = π₁.comp φ₁ ∧
              Function.Injective ψ_br₀ ∧
              Function.Injective ψ_br₁ ∧
              ψ_br₀.FiniteType ∧
              ψ_br₁.FiniteType ∧
              @Module.Flat (B_tilde₁ α'_0) D₀ _ _ ψ_br₀.toAlgebra.toModule ∧
              @Algebra.FormallyUnramified (B_tilde₁ α'_0) D₀ _ _ ψ_br₀.toAlgebra ∧
              @Module.Flat (B_tilde₁ α'_1) D₁ _ _ ψ_br₁.toAlgebra.toModule ∧
              @Algebra.FormallyUnramified (B_tilde₁ α'_1) D₁ _ _ ψ_br₁.toAlgebra ∧
              (⟨α'_0, p'_0⟩ : Σ α : Fin (c + 1), PrimeSpectrum (B_tilde₁ α)) ≠ ⟨α'_1, p'_1⟩ ∧
              (∀ (α : Fin (c + 1)) (q_P : PrimeSpectrum (B_tilde₁ α)),
                Ideal.comap (ι₁ α) q_P.asIdeal = p_y1.asIdeal →
                (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde₁ β)) = ⟨α'_0, p'_0⟩ ∨
                  (⟨α, q_P⟩ : Σ β : Fin (c + 1), PrimeSpectrum (B_tilde₁ β)) = ⟨α'_1, p'_1⟩) ∧
              (∀ (s_tilde : ∀ α : Fin (c + 1), B_tilde₁ α) (c_val : Ω),
                s_tilde α'_0 - ι₁ α'_0 (c_B₁ c_val) ∈ p'_0.asIdeal →
                s_tilde α'_1 - ι₁ α'_1 (c_B₁ c_val) ∈ p'_1.asIdeal →
                ∃ b : B₁, ∀ α : Fin (c + 1), ι₁ α b = s_tilde α) := by
    intro V hV p_z r hp_z_eq
    let B := ↑(C.presheaf.obj (Opposite.op V))
    let c_V : Ω →+* B :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        g.appLE ⊤ V (fun _ _ => trivial)).hom)
    
    have hSepNode : ∀ r' : Fin δ, r' ≠ r →
        ∃ g_r' : B, g_r' ∉ p_z.asIdeal ∧ z_node r' ∉ C.basicOpen g_r' := by
      intro r' hr'
      by_cases h_inV : z_node r' ∈ V
      · let p_r' : PrimeSpectrum B := hV.primeIdealOf ⟨z_node r', h_inV⟩
        have hp_r'_base : hV.fromSpec.base p_r' = z_node r' :=
          hV.fromSpec_primeIdealOf ⟨z_node r', h_inV⟩
        have hp_ne : p_r' ≠ p_z := by
          intro heq
          apply hr'
          apply hz_inj
          rw [← hp_r'_base, ← hp_z_eq, heq]
        have h_top_in : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
            (TopologicalSpace.Opens.map (pt_C (z_node r') (hz_closed_nsm r').1).base).obj V := by
          intro q _
          change (pt_C (z_node r') (hz_closed_nsm r').1).base q ∈ V
          rw [(hPtC (z_node r') (hz_closed_nsm r').1).2.1 q]
          exact h_inV
        have hker_r' : RingHom.ker
            (weilPointEvalRingHom (pt_C (z_node r') (hz_closed_nsm r').1) V h_top_in) =
            p_r'.asIdeal :=
          (hPtC (z_node r') (hz_closed_nsm r').1).2.2 V hV p_r' h_top_in hp_r'_base
        have hsurj_ev : Function.Surjective
            (weilPointEvalRingHom (pt_C (z_node r') (hz_closed_nsm r').1) V h_top_in) :=
          fun c_val => ⟨c_V c_val,
            hEvalConst g (pt_C (z_node r') (hz_closed_nsm r').1)
              (hPtC (z_node r') (hz_closed_nsm r').1).1 V h_top_in c_val⟩
        have hMax_r' : p_r'.asIdeal.IsMaximal := by
          rw [← hker_r']
          exact RingHom.ker_isMaximal_of_surjective _ hsurj_ev
        have h_not_le : ¬(p_r'.asIdeal ≤ p_z.asIdeal) := by
          intro hle
