  let _ : Algebra R' D :=
    ((snd₁'.appLE ⊤ W (fun _ _ => trivial)).hom.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom).toAlgebra
  obtain ⟨hq₁_surj, hq₁_ker, _, ht₁_reg, ⟨δ₁, hδ₁⟩⟩ :=
    hChartPb C₁ g₁ τ₁ hStab₁ U₁ V₁ k₁ π₁ F₁ tag₁ t₁ hChart₁ C₁' snd₁' fst₁' hp₁ W hAffW inf_le_left
  obtain ⟨hq₂_surj, hq₂_ker, hJ₂_inj, _, ⟨δ₂, hδ₂⟩⟩ :=
    hChartPb C₂ g₂ τ₂ hStab₂ U₂ V₂ k₂ π₂ F₂ tag₂ t₂ hChart₂ C₁' snd₁' f₂ hp₂ W hAffW inf_le_right
  obtain ⟨ψ_log₁, hψ₁_D, hψ₁_X, _, _⟩ := id hδ₁
  obtain ⟨ψ_log₂, hψ₂_D, hψ₂_X, _, _⟩ := id hδ₂
  let J₁_D : Matrix (Fin (k₁ + 1)) (Fin k₁) D :=
    Matrix.of fun (i : Fin (k₁ + 1)) (j : Fin k₁) => ρ₁ (π₁ (MvPolynomial.pderiv i (F₁ j)))
  let q₁_D : (Fin (k₁ + 1) → D) →ₗ[D] KaehlerDifferential R' D :=
    Fintype.linearCombination D fun r : Fin (k₁ + 1) =>
      KaehlerDifferential.D R' D (ρ₁ (π₁ (MvPolynomial.X r)))
  let J₂_D : Matrix (Fin (k₂ + 1)) (Fin k₂) D :=
    Matrix.of fun (i : Fin (k₂ + 1)) (j : Fin k₂) => ρ₂ (π₂ (MvPolynomial.pderiv i (F₂ j)))
  let q₂_D : (Fin (k₂ + 1) → D) →ₗ[D] KaehlerDifferential R' D :=
    Fintype.linearCombination D fun s : Fin (k₂ + 1) =>
      KaehlerDifferential.D R' D (ρ₂ (π₂ (MvPolynomial.X s)))
  obtain ⟨_, ψ_a, ψ_b, u_cr, hψ_a, hψ_b, hψ_rel⟩ :=
    hCramer D (KaehlerDifferential R' D) k₁ k₂ J₁_D q₁_D J₂_D q₂_D
      hq₁_surj hq₁_ker hq₂_surj hq₂_ker hJ₂_inj
  have hδ₁_det : ∀ r : Fin (k₁ + 1),
      δ₁ (ρ₁ (π₁ (MvPolynomial.X r))) =
        t₁_D * (-1) ^ (r : ℕ) * Matrix.det (J₁_D.submatrix r.succAbove id) := by
    intro r
    change δ₁ ((fst₁'.appLE V₁ W inf_le_left).hom (π₁ (MvPolynomial.X r))) = _
    rw [hψ₁_X r, map_mul, map_mul, map_pow, map_neg, map_one, RingHom.map_det]
    congr 2
  have hδ₂_det : ∀ s : Fin (k₂ + 1),
      δ₂ (ρ₂ (π₂ (MvPolynomial.X s))) =
        t₂_D * (-1) ^ (s : ℕ) * Matrix.det (J₂_D.submatrix s.succAbove id) := by
    intro s
    change δ₂ ((f₂.appLE V₂ W inf_le_right).hom (π₂ (MvPolynomial.X s))) = _
    rw [hψ₂_X s, map_mul, map_mul, map_pow, map_neg, map_one, RingHom.map_det]
    congr 2
  have hψ₁_pin : ∀ ω : KaehlerDifferential R' D, ψ_log₁ ω = t₁_D * ψ_a ω := by
    intro ω
    obtain ⟨v, rfl⟩ := hq₁_surj ω
    rw [hψ_a v, Finset.mul_sum, Fintype.linearCombination_apply, map_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [LinearMap.map_smul, smul_eq_mul, ← hψ₁_D, hδ₁_det r]
    ring
  have hψ₂_pin : ∀ ω : KaehlerDifferential R' D, ψ_log₂ ω = t₂_D * ψ_b ω := by
    intro ω
    obtain ⟨w, rfl⟩ := hq₂_surj ω
    rw [hψ_b w, Finset.mul_sum, Fintype.linearCombination_apply, map_sum]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [LinearMap.map_smul, smul_eq_mul, ← hψ₂_D, hδ₂_det s]
    ring
  have ht₁_mem : t₁_D ∈ Ideal.span ({t₂_D} : Set D) := by
    rw [← hSpanEq]
    exact Ideal.mem_span_singleton_self _
  have ht₂_mem : t₂_D ∈ Ideal.span ({t₁_D} : Set D) := by
    rw [hSpanEq]
    exact Ideal.mem_span_singleton_self _
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp ht₁_mem
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp ht₂_mem
  have hab_reg : (a * b - 1) * t₁_D = 0 := by
    calc (a * b - 1) * t₁_D
        = (t₁_D * b) * a - t₁_D := by ring
      _ = t₂_D * a - t₁_D := by rw [← hb]
      _ = t₁_D - t₁_D := by rw [← ha]
      _ = 0 := sub_self _
  have hab : a * b = 1 := sub_eq_zero.mp (ht₁_reg (a * b - 1) hab_reg)
  let v_mark : Dˣ := ⟨a, b, hab, by rw [mul_comm, hab]⟩
  have ht_rel : t₁_D = v_mark.val * t₂_D := by
    change t₁_D = a * t₂_D
    rw [ha, mul_comm]
  refine ⟨hAffW, v_mark * u_cr, δ₁, δ₂, hδ₁, hδ₂, ?_⟩
  intro d
  let ω := KaehlerDifferential.D R' D d
  have hψ_a_ω : ψ_a ω = u_cr.val * ψ_b ω := by
    rw [hψ_rel, LinearMap.smul_apply, smul_eq_mul]
  calc δ₁ d
      = ψ_log₁ ω := hψ₁_D d
    _ = t₁_D * ψ_a ω := hψ₁_pin ω
    _ = (v_mark.val * t₂_D) * (u_cr.val * ψ_b ω) := by rw [ht_rel, hψ_a_ω]
    _ = (v_mark * u_cr).val * (t₂_D * ψ_b ω) := by rw [Units.val_mul]; ring
    _ = (v_mark * u_cr).val * ψ_log₂ ω := by rw [← hψ₂_pin ω]
    _ = (v_mark * u_cr).val * δ₂ d := by rw [← hψ₂_D d]

theorem weil_atlas_overlap_pulledBack_log_functional_cocycle (R : Type u) [CommRing R]
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hProp : AlgebraicGeometry.IsProper g)
    (U₁ U₂ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens)
    (V₁ V₂ : C.Opens)
    (hAffU₁ : AlgebraicGeometry.IsAffineOpen U₁)
    (hAffU₂ : AlgebraicGeometry.IsAffineOpen U₂)
    (hAffV₁ : AlgebraicGeometry.IsAffineOpen V₁)
    (hAffV₂ : AlgebraicGeometry.IsAffineOpen V₂)
    (hV₁ : V₁ ≤ (TopologicalSpace.Opens.map g.base).obj U₁)
    (hV₂ : V₂ ≤ (TopologicalSpace.Opens.map g.base).obj U₂)
    (k₁ k₂ : ℕ)
    (π₁ : MvPolynomial (Fin (k₁ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₁)) →+*
      ↑(C.presheaf.obj (Opposite.op V₁)))
    (F₁ : Fin k₁ → MvPolynomial (Fin (k₁ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₁)))
    (t₁ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (π₂ : MvPolynomial (Fin (k₂ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₂)) →+*
      ↑(C.presheaf.obj (Opposite.op V₂)))
    (F₂ : Fin k₂ → MvPolynomial (Fin (k₂ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₂)))
    (t₂ : ↑(C.presheaf.obj (Opposite.op V₂)))
    (u₁₂ : ↑(C.presheaf.obj (Opposite.op (V₁ ⊓ V₂))))
    (hOv :
      let A_12 := ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op (U₁ ⊓ U₂)))
      let B_12 := ↑(C.presheaf.obj (Opposite.op (V₁ ⊓ V₂)))
      let h_12 : V₁ ⊓ V₂ ≤ (TopologicalSpace.Opens.map g.base).obj (U₁ ⊓ U₂) :=
        inf_le_inf hV₁ hV₂
      letI : Algebra A_12 B_12 := (g.appLE (U₁ ⊓ U₂) (V₁ ⊓ V₂) h_12).hom.toAlgebra
      ∃ (ψ_ov : KaehlerDifferential A_12 B_12 →ₗ[B_12] B_12),
        (∀ r : Fin (k₁ + 1),
          ψ_ov (KaehlerDifferential.D A_12 B_12
            ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom
              (π₁ (MvPolynomial.X r)))) =
            (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom
              (t₁ * (-1) ^ (r : ℕ) *
                Matrix.det ((Matrix.of fun (i : Fin (k₁ + 1)) (j : Fin k₁) =>
                  π₁ (MvPolynomial.pderiv i (F₁ j))).submatrix r.succAbove id))) ∧
        (∀ s : Fin (k₂ + 1),
          ψ_ov (KaehlerDifferential.D A_12 B_12
            ((C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₁ ⊓ V₂ ≤ V₂)).op).hom
              (π₂ (MvPolynomial.X s)))) =
            u₁₂ *
              (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₁ ⊓ V₂ ≤ V₂)).op).hom
                (t₂ * (-1) ^ (s : ℕ) *
                  Matrix.det ((Matrix.of fun (i : Fin (k₂ + 1)) (j : Fin k₂) =>
                    π₂ (MvPolynomial.pderiv i (F₂ j))).submatrix s.succAbove id))))
    (R' : Type u) [CommRing R'] (ρ : R →+* R')
    (X' : AlgebraicGeometry.Scheme.{u})
    (p' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R'))
    (f_C : X' ⟶ C)
    (hPb : CategoryTheory.IsPullback f_C p' g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)))
    (W : X'.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W)
    (hW₁ : W ≤ (TopologicalSpace.Opens.map f_C.base).obj V₁)
    (hW₂ : W ≤ (TopologicalSpace.Opens.map f_C.base).obj V₂)
    (δ₁ δ₂ : ↑(X'.presheaf.obj (Opposite.op W)) → ↑(X'.presheaf.obj (Opposite.op W)))
    (hδ₁ : IsPulledBackChartLogFunctional p' f_C U₁ V₁ k₁ π₁ F₁ t₁ W hW₁ δ₁)
    (hδ₂ : IsPulledBackChartLogFunctional p' f_C U₂ V₂ k₂ π₂ F₂ t₂ W hW₂ δ₂)
    (hKaehler : HasWeilIsoKaehlerTransport R) :
    ∀ d : ↑(X'.presheaf.obj (Opposite.op W)),
      δ₁ d = (f_C.appLE (V₁ ⊓ V₂) W (le_inf hW₁ hW₂)).hom u₁₂ * δ₂ d :=
by
  have happLE_congr : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {m₁ m₂ : X ⟶ Y} (hm : m₁ = m₂)
      (U : Y.Opens) (V : X.Opens)
      (e₁ : V ≤ (TopologicalSpace.Opens.map m₁.base).obj U)
      (e₂ : V ≤ (TopologicalSpace.Opens.map m₂.base).obj U),
      m₁.appLE U V e₁ = m₂.appLE U V e₂ := by
    intro X Y m₁ m₂ hm
    subst hm
    intro U V e₁ e₂
    rfl
  let S : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R)
  let S' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R')
  let u_ρ : S' ⟶ S := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
  let U₁₂ : S.Opens := U₁ ⊓ U₂
  let V₁₂ : C.Opens := V₁ ⊓ V₂
  have hAffU₁₂ : AlgebraicGeometry.IsAffineOpen U₁₂ := hAffU₁.inf hAffU₂
  haveI : AlgebraicGeometry.IsProper g := hProp
  have hSepC : C.IsSeparated := by
    have hSepS : S.IsSeparated := inferInstance
    rw [AlgebraicGeometry.Scheme.isSeparated_iff] at hSepS ⊢
    have hTerm : CategoryTheory.Limits.terminal.from C =
        g ≫ CategoryTheory.Limits.terminal.from S :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    rw [hTerm]
    exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hSepS
  haveI : C.IsSeparated := hSepC
  have hAffV₁₂ : AlgebraicGeometry.IsAffineOpen V₁₂ := hAffV₁.inf hAffV₂
  let U'₁₂ : S'.Opens := (TopologicalSpace.Opens.map u_ρ.base).obj U₁₂
  let V'₁₂ : X'.Opens := (TopologicalSpace.Opens.map f_C.base).obj V₁₂
  have hAffHom_u : AlgebraicGeometry.IsAffineHom u_ρ :=
    AlgebraicGeometry.isAffineHom_of_isAffine u_ρ
  haveI : AlgebraicGeometry.IsAffineHom u_ρ := hAffHom_u
  have hAffHom_f : AlgebraicGeometry.IsAffineHom f_C :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hAffHom_u
  haveI : AlgebraicGeometry.IsAffineHom f_C := hAffHom_f
  have hAffU'₁₂ : AlgebraicGeometry.IsAffineOpen U'₁₂ := hAffU₁₂.preimage u_ρ
  have hAffV'₁₂ : AlgebraicGeometry.IsAffineOpen V'₁₂ := hAffV₁₂.preimage f_C
  let h_12 : V₁₂ ≤ (TopologicalSpace.Opens.map g.base).obj U₁₂ := inf_le_inf hV₁ hV₂
  let hW₁₂ : W ≤ V'₁₂ := le_inf hW₁ hW₂
  have hV'₁₂ : V'₁₂ ≤ (TopologicalSpace.Opens.map p'.base).obj U'₁₂ := by
    intro x hx
    have hg : g.base (f_C.base x) ∈ U₁₂ := h_12 hx
    have hcomm_x : g.base (f_C.base x) = u_ρ.base (p'.base x) := by
      have h1 : (f_C ≫ g).base x = (p' ≫ u_ρ).base x := by rw [hPb.w]
      simpa using h1
    rw [hcomm_x] at hg
    exact hg
  let f₁₂ := f_C.resLE V₁₂ V'₁₂ (le_refl _)
  let p'₁₂ := p'.resLE U'₁₂ V'₁₂ hV'₁₂
  let g₁₂ := g.resLE U₁₂ V₁₂ h_12
  let u₁₂_S := u_ρ.resLE U₁₂ U'₁₂ (le_refl _)
  have hp_top_res : CategoryTheory.IsPullback f₁₂ V'₁₂.ι V₁₂.ι f_C := by
    change CategoryTheory.IsPullback (f_C.resLE V₁₂ V'₁₂ (le_refl _)) V'₁₂.ι V₁₂.ι f_C
    rw [AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict]
    exact AlgebraicGeometry.isPullback_morphismRestrict f_C V₁₂
  have hp_bot_res : CategoryTheory.IsPullback u₁₂_S U'₁₂.ι U₁₂.ι u_ρ := by
    change CategoryTheory.IsPullback (u_ρ.resLE U₁₂ U'₁₂ (le_refl _)) U'₁₂.ι U₁₂.ι u_ρ
    rw [AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict]
    exact AlgebraicGeometry.isPullback_morphismRestrict u_ρ U₁₂
  have hp_paste : CategoryTheory.IsPullback f₁₂ (p'₁₂ ≫ U'₁₂.ι) (g₁₂ ≫ U₁₂.ι) u_ρ := by
    have hp₀ := hp_top_res.paste_vert hPb
    rwa [← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι p' hV'₁₂,
      ← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι g h_12] at hp₀
  have h_comm_12 : f₁₂ ≫ g₁₂ = p'₁₂ ≫ u₁₂_S := by
    rw [← cancel_mono U₁₂.ι]
    calc (f₁₂ ≫ g₁₂) ≫ U₁₂.ι
        = f₁₂ ≫ (g₁₂ ≫ U₁₂.ι) := CategoryTheory.Category.assoc _ _ _
      _ = f₁₂ ≫ (V₁₂.ι ≫ g) := by rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      _ = (f₁₂ ≫ V₁₂.ι) ≫ g := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (V'₁₂.ι ≫ f_C) ≫ g := by rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      _ = V'₁₂.ι ≫ (f_C ≫ g) := CategoryTheory.Category.assoc _ _ _
      _ = V'₁₂.ι ≫ (p' ≫ u_ρ) := by rw [hPb.w]
      _ = (V'₁₂.ι ≫ p') ≫ u_ρ := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (p'₁₂ ≫ U'₁₂.ι) ≫ u_ρ := by rw [← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      _ = p'₁₂ ≫ (U'₁₂.ι ≫ u_ρ) := CategoryTheory.Category.assoc _ _ _
      _ = p'₁₂ ≫ (u₁₂_S ≫ U₁₂.ι) := by rw [← AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      _ = (p'₁₂ ≫ u₁₂_S) ≫ U₁₂.ι := (CategoryTheory.Category.assoc _ _ _).symm
  have hp_12 : CategoryTheory.IsPullback f₁₂ p'₁₂ g₁₂ u₁₂_S :=
    (hp_bot_res.paste_vert_iff h_comm_12).mp hp_paste
  have hp_spec : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (f_C.appLE V₁₂ V'₁₂ (le_refl _)))
      (AlgebraicGeometry.Spec.map (p'.appLE U'₁₂ V'₁₂ hV'₁₂))
      (AlgebraicGeometry.Spec.map (g.appLE U₁₂ V₁₂ h_12))
      (AlgebraicGeometry.Spec.map (u_ρ.appLE U₁₂ U'₁₂ (le_refl _))) :=
    hp_12.of_iso hAffV'₁₂.isoSpec hAffV₁₂.isoSpec hAffU'₁₂.isoSpec hAffU₁₂.isoSpec
      (by simp only [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]; rfl)
      (by simp only [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]; rfl)
      (by simp only [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]; rfl)
      (by simp only [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
            AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE]; rfl)
  let _ : CategoryTheory.Limits.ReflectsLimitsOfSize.{0, 0} AlgebraicGeometry.Scheme.Spec.{u} :=
    CategoryTheory.Limits.fullyFaithful_reflectsLimits AlgebraicGeometry.Scheme.Spec.{u}
  have hp_op : CategoryTheory.IsPullback
      (f_C.appLE V₁₂ V'₁₂ (le_refl _)).op
      (p'.appLE U'₁₂ V'₁₂ hV'₁₂).op
      (g.appLE U₁₂ V₁₂ h_12).op
      (u_ρ.appLE U₁₂ U'₁₂ (le_refl _)).op :=
    CategoryTheory.IsPullback.of_map_of_faithful AlgebraicGeometry.Scheme.Spec hp_spec
  have hpush_cat : CategoryTheory.IsPushout
      (u_ρ.appLE U₁₂ U'₁₂ (le_refl _))
      (g.appLE U₁₂ V₁₂ h_12)
      (p'.appLE U'₁₂ V'₁₂ hV'₁₂)
      (f_C.appLE V₁₂ V'₁₂ (le_refl _)) := hp_op.unop
  let A_12 := ↑(S.presheaf.obj (Opposite.op U₁₂))
  let B_12 := ↑(C.presheaf.obj (Opposite.op V₁₂))
  let A'_12 := ↑(S'.presheaf.obj (Opposite.op U'₁₂))
  let B'_12 := ↑(X'.presheaf.obj (Opposite.op V'₁₂))
  letI : Algebra A_12 B_12 := (g.appLE U₁₂ V₁₂ h_12).hom.toAlgebra
  letI : Algebra A_12 A'_12 := (u_ρ.appLE U₁₂ U'₁₂ (le_refl _)).hom.toAlgebra
  letI : Algebra A'_12 B'_12 := (p'.appLE U'₁₂ V'₁₂ hV'₁₂).hom.toAlgebra
  letI : Algebra B_12 B'_12 := (f_C.appLE V₁₂ V'₁₂ (le_refl _)).hom.toAlgebra
  letI : Algebra A_12 B'_12 :=
    ((p'.appLE U'₁₂ V'₁₂ hV'₁₂).hom.comp (u_ρ.appLE U₁₂ U'₁₂ (le_refl _)).hom).toAlgebra
  haveI : IsScalarTower A_12 A'_12 B'_12 := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower A_12 B_12 B'_12 := by
    apply IsScalarTower.of_algebraMap_eq
    intro a
    have h1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE f_C g U₁₂ V₁₂ V'₁₂ h_12 (le_refl _)
    have h2 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE p' u_ρ U₁₂ U'₁₂ V'₁₂ (le_refl _) hV'₁₂
    have h3 : (f_C ≫ g).appLE U₁₂ V'₁₂ (by exact fun x hx => h_12 hx) =
        (p' ≫ u_ρ).appLE U₁₂ V'₁₂ (by exact hV'₁₂) :=
      happLE_congr hPb.w U₁₂ V'₁₂ _ _
    have htotal : g.appLE U₁₂ V₁₂ h_12 ≫ f_C.appLE V₁₂ V'₁₂ (le_refl _) =
        u_ρ.appLE U₁₂ U'₁₂ (le_refl _) ≫ p'.appLE U'₁₂ V'₁₂ hV'₁₂ :=
      h1.trans (h3.trans h2.symm)
    exact (ConcreteCategory.congr_hom htotal a).symm
  haveI : Algebra.IsPushout A_12 A'_12 B_12 B'_12 :=
    CommRingCat.isPushout_iff_isPushout.mp hpush_cat
  let D := ↑(X'.presheaf.obj (Opposite.op W))
  let α_R' : CommRingCat.of R' ⟶ S'.presheaf.obj (Opposite.op U'₁₂) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') ⊤ U'₁₂ (fun _ _ => trivial)
  let β_D : X'.presheaf.obj (Opposite.op V'₁₂) ⟶ X'.presheaf.obj (Opposite.op W) :=
    AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X') V'₁₂ W hW₁₂
  letI : Algebra R' D :=
    ((p'.appLE ⊤ W (fun _ _ => trivial)).hom.comp
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom).toAlgebra
  letI : Algebra R' A'_12 := α_R'.hom.toAlgebra
  letI : Algebra B'_12 D := β_D.hom.toAlgebra
  letI : Algebra A'_12 D := (β_D.hom.comp (p'.appLE U'₁₂ V'₁₂ hV'₁₂).hom).toAlgebra
  haveI : IsScalarTower A'_12 B'_12 D := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower R' A'_12 D := by
    apply IsScalarTower.of_algebraMap_eq
    intro r'
    have hc1 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE p' (𝟙 S') ⊤ U'₁₂ V'₁₂
      (fun _ _ => trivial) hV'₁₂
    have hc2 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE (𝟙 X') (p' ≫ 𝟙 S') ⊤ V'₁₂ W
      (fun _ _ => trivial) hW₁₂
    have hcongr : (𝟙 X' ≫ (p' ≫ 𝟙 S')).appLE ⊤ W (fun _ _ => trivial) =
        p'.appLE ⊤ W (fun _ _ => trivial) :=
      happLE_congr
        ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id p'))
        ⊤ W _ _
    have hchain : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S') ⊤ U'₁₂ (fun _ _ => trivial) ≫
        (p'.appLE U'₁₂ V'₁₂ hV'₁₂ ≫ AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X') V'₁₂ W hW₁₂) =
        p'.appLE ⊤ W (fun _ _ => trivial) := by
