  have hres₂_W : ∀ b₂ : ↑(C.presheaf.obj (Opposite.op V₂)),
      ρ₁₂_W (res₂ b₂) = (f_C.appLE V₂ W hW₂).hom b₂ := by
    intro b₂
    change (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 C) V₂ V₁₂ inf_le_right ≫
      f_C.appLE V₁₂ W hW₁₂).hom b₂ = _
    have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE f_C (𝟙 C) V₂ V₁₂ W inf_le_right hW₁₂
    exact ConcreteCategory.congr_hom
      (hc.trans (happLE_congr (CategoryTheory.Category.comp_id f_C) V₂ W _ hW₂)) b₂
  obtain ⟨ψ₁, hψ₁_D, hψ₁_X, hψ₁_span, _⟩ := hδ₁
  obtain ⟨ψ₂, hψ₂_D, hψ₂_X, hψ₂_span, _⟩ := hδ₂
  have hψ_D_eq₁ : ∀ ω : KaehlerDifferential R' D, ψ_D ω = ψ₁ ω := by
    have hgen₁ : ∀ r : Fin (k₁ + 1),
