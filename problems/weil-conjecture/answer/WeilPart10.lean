theorem weil_pointed_curve_iso_cocycle_of_log_canonical_atlas (R : Type u) [CommRing R] [IsNoetherianRing R] (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂))
    (hStab₁ : IsGeometricStablePointedCurve g₁ n τ₁)
    (hStab₂ : IsGeometricStablePointedCurve g₂ n τ₂)
    (M₁ : WeilLineBundle C₁) (M₂ : WeilLineBundle C₂)
    (hAtlas₁ : IsRelativeLogCanonicalAtlas g₁ n τ₁ M₁)
    (hAtlas₂ : IsRelativeLogCanonicalAtlas g₂ n τ₂ M₂)
    (hPullback : ∀ (S S' C : AlgebraicGeometry.Scheme.{u})
      (f_S : S' ⟶ S) (g : C ⟶ S) (τ : Fin n → (S ⟶ C)),
      IsGeometricStablePointedCurve g n τ →
      ∃ τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g f_S),
        (∀ j : Fin n,
          τ' j ≫ CategoryTheory.Limits.pullback.fst g f_S = f_S ≫ τ j ∧
          τ' j ≫ CategoryTheory.Limits.pullback.snd g f_S = 𝟙 S' ∧
          Set.range (τ' j).base =
            (CategoryTheory.Limits.pullback.fst g f_S).base ⁻¹' Set.range (τ j).base) ∧
        IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g f_S) n τ')
    (hCramer : ∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k₁ k₂ : ℕ)
      (J₁ : Matrix (Fin (k₁ + 1)) (Fin k₁) B)
      (q₁ : (Fin (k₁ + 1) → B) →ₗ[B] Ω_mod)
      (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) B)
      (q₂ : (Fin (k₂ + 1) → B) →ₗ[B] Ω_mod),
      Function.Surjective q₁ →
      LinearMap.ker q₁ = LinearMap.range J₁.mulVecLin →
      Function.Surjective q₂ →
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin →
      Function.Injective J₂.mulVecLin →
      Function.Injective J₁.mulVecLin ∧
      ∃ (ψ₁ ψ₂ : Ω_mod →ₗ[B] B) (u : Bˣ),
        (∀ v : Fin (k₁ + 1) → B,
          ψ₁ (q₁ v) = ∑ r : Fin (k₁ + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id)) ∧
        (∀ w : Fin (k₂ + 1) → B,
          ψ₂ (q₂ w) = ∑ s : Fin (k₂ + 1),
            w s * (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) ∧
        ψ₁ = u.val • ψ₂)
    (hZeroAnn : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A]
      [CommRing B] [Algebra A B] [Module.Flat A B] (S_gen : Set B),
      (∀ (p : PrimeSpectrum A),
        let Ω : Type u := AlgebraicClosure p.asIdeal.ResidueField
        letI : Algebra A Ω :=
          ((algebraMap p.asIdeal.ResidueField Ω).comp
            (algebraMap A p.asIdeal.ResidueField)).toAlgebra
        ∀ z : TensorProduct A B Ω,
          (∀ b ∈ S_gen, TensorProduct.tmul A b (1 : Ω) * z = 0) → z = 0) →
      ∀ z : B, (∀ b ∈ S_gen, b * z = 0) → z = 0) :
    HasPointedCurveIsoCocycle g₁ τ₁ g₂ τ₂ M₁ M₂ :=
by
  have hKaehler : HasWeilIsoKaehlerTransport R :=
    weil_mvPolynomial_quotient_kaehler_exact_and_etale_transport R
  have hLogPb : ∀ (C : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C)),
      IsGeometricStablePointedCurve g n τ →
      ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) (V : C.Opens) (k : ℕ)
        (π : MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)) →+*
          ↑(C.presheaf.obj (Opposite.op V)))
        (F : Fin k → MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)))
        (tag : Option (Fin n)) (t : ↑(C.presheaf.obj (Opposite.op V))),
        IsLocalLogCanonicalChart g n τ U V k π F tag t →
        ∀ (R' : Type u) [CommRing R'] [IsNoetherianRing R'] (ρ : R →+* R')
          (X' : AlgebraicGeometry.Scheme.{u})
          (p' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R'))
          (f_C : X' ⟶ C),
          CategoryTheory.IsPullback f_C p' g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) →
          ∀ (W : X'.Opens), AlgebraicGeometry.IsAffineOpen W →
            ∀ (hW_le : W ≤ (TopologicalSpace.Opens.map f_C.base).obj V),
              ∃ δ_log : ↑(X'.presheaf.obj (Opposite.op W)) → ↑(X'.presheaf.obj (Opposite.op W)),
                IsPulledBackChartLogFunctional p' f_C U V k π F t W hW_le δ_log := by
    intro C g τ hStab U V k π F tag t hChart R' _ _ ρ X' p' f_C hPb W hAffW hW_le
    exact (weil_pulledBack_chart_cramer_injective_and_log_functional R n C g τ hStab
      U V k π F tag t hChart R' ρ X' p' f_C hPb W hAffW hW_le
      hPullback hCramer hZeroAnn hKaehler).2.2.2.2
  have happLE_congr : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X ⟶ Y} (h : f₁ = f₂)
      (U : Y.Opens) (V : X.Opens)
      (e₁ : V ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (e₂ : V ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      f₁.appLE U V e₁ = f₂.appLE U V e₂ := by
    intro X Y f₁ f₂ h
    subst h
    intro U V e₁ e₂
    rfl
  have hid_appLE : ∀ {X : AlgebraicGeometry.Scheme.{u}} (W₁ W₂ : X.Opens) (h : W₂ ≤ W₁)
      (z : ↑(X.presheaf.obj (Opposite.op W₁))),
      (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X) W₁ W₂ h).hom z =
        (X.presheaf.map (CategoryTheory.homOfLE h).op).hom z := by
    intro X W₁ W₂ h z
    rfl
  have hNat : ∀ {C : AlgebraicGeometry.Scheme.{u}}
      (U : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens)
      (V : C.Opens) (k : ℕ)
      (π : MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)) →+*
        ↑(C.presheaf.obj (Opposite.op V)))
      (F : Fin k → MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)))
      (t : ↑(C.presheaf.obj (Opposite.op V)))
      {R' R'' : Type u} [CommRing R'] [CommRing R''] (ψ : R' →+* R'')
      {X' X'' : AlgebraicGeometry.Scheme.{u}}
      (p' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R'))
      (f_C : X' ⟶ C)
      (p'' : X'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R''))
      (f''_C : X'' ⟶ C)
      (w : X'' ⟶ X')
      (hw_C : w ≫ f_C = f''_C)
      (hw_p : w ≫ p' = p'' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
      (W' : X'.Opens) (hW' : W' ≤ (TopologicalSpace.Opens.map f_C.base).obj V)
      (W'' : X''.Opens) (hW'' : W'' ≤ (TopologicalSpace.Opens.map f''_C.base).obj V)
      (h_w : W'' ≤ (TopologicalSpace.Opens.map w.base).obj W')
      (δ' : ↑(X'.presheaf.obj (Opposite.op W')) → ↑(X'.presheaf.obj (Opposite.op W')))
      (δ'' : ↑(X''.presheaf.obj (Opposite.op W'')) → ↑(X''.presheaf.obj (Opposite.op W''))),
      IsPulledBackChartLogFunctional p' f_C U V k π F t W' hW' δ' →
      IsPulledBackChartLogFunctional p'' f''_C U V k π F t W'' hW'' δ'' →
