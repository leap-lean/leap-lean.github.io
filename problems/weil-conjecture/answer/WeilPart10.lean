      let ιG : ∀ u : I, ↑(G.obj u) →ₐ[R₀] C_pt :=
        fun u => { toRingHom := (cG.ι.app u).hom, commutes' := h_pt_eq u }
      let mkGM : ∀ (M : Type u) [CommRing M] [Algebra R₀ M], CategoryTheory.Functor I CommRingCat.{u} :=
        fun M _ _ =>
          { obj := fun u => CommRingCat.of (TensorProduct R₀ ↑(G.obj u) M)
            map := fun g =>
              CommRingCat.ofHom (Algebra.TensorProduct.map (mapG g) (AlgHom.id R₀ M)).toRingHom
            map_id := fun u => by
              apply CommRingCat.hom_ext; apply RingHom.ext; intro z
              refine TensorProduct.inductionOn z ?_
                (fun _ _ hx hy => by simp only [CommRingCat.hom_ofHom, CommRingCat.hom_id, map_add] at hx hy ⊢; rw [hx, hy])
              intro x m; change (G.map (𝟙 u)).hom x ⊗ₜ[R₀] m = x ⊗ₜ[R₀] m; rw [G.map_id]; rfl
            map_comp := fun g₁ g₂ => by
              apply CommRingCat.hom_ext; apply RingHom.ext; intro z
              refine TensorProduct.inductionOn z ?_
                (fun _ _ hx hy => by simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, map_add] at hx hy ⊢; rw [hx, hy])
              intro x m
              change (G.map (g₁ ≫ g₂)).hom x ⊗ₜ[R₀] m = (G.map g₂).hom ((G.map g₁).hom x) ⊗ₜ[R₀] m
              rw [G.map_comp]; rfl }
      let mkCM : ∀ (M : Type u) [CommRing M] [Algebra R₀ M], CategoryTheory.Limits.Cocone (mkGM M) :=
        fun M _ _ =>
          { pt := CommRingCat.of (TensorProduct R₀ C_pt M)
            ι :=
              { app := fun u =>
                  CommRingCat.ofHom (Algebra.TensorProduct.map (ιG u) (AlgHom.id R₀ M)).toRingHom
                naturality := fun u v g => by
                  apply CommRingCat.hom_ext; apply RingHom.ext; intro z
                  refine TensorProduct.inductionOn z ?_
                    (fun _ _ hx hy => by simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, map_add] at hx hy ⊢; rw [hx, hy])
                  intro x m
                  have hc_x : ιG v ((G.map g).hom x) = ιG u x :=
                    congrArg (fun q => q.hom x) (cG.w g)
                  change ιG v ((G.map g).hom x) ⊗ₜ[R₀] m = ιG u x ⊗ₜ[R₀] m
                  rw [hc_x] } }
      let mkαM : ∀ (M : Type u) [CommRing M] [Algebra R₀ M],
          (CategoryTheory.Functor.const I).obj (CommRingCat.of R₀) ⟶ mkGM M :=
        fun M _ _ =>
          { app := fun u =>
              CommRingCat.ofHom
                ((Algebra.TensorProduct.includeRight : M →ₐ[R₀] TensorProduct R₀ ↑(G.obj u) M).toRingHom.comp
                  (algebraMap R₀ M))
            naturality := fun u v g => by
              apply CommRingCat.hom_ext; apply RingHom.ext; intro r₀
              change (1 : ↑(G.obj v)) ⊗ₜ[R₀] (algebraMap R₀ M r₀) =
                ((G.map g).hom 1) ⊗ₜ[R₀] (algebraMap R₀ M r₀)
              rw [map_one] }
      obtain ⟨hcM₁⟩ := hPushout R₀ G cG hcG h_nat_pt h_pt_eq M₁
      obtain ⟨hcM₂⟩ := hPushout R₀ G cG hcG h_nat_pt h_pt_eq M₂
      let f₁ : CommRingCat.of R₀ ⟶ CommRingCat.of M₁ := CommRingCat.ofHom (algebraMap R₀ M₁)
      let f₂ : CommRingCat.of R₀ ⟶ CommRingCat.of M₂ := CommRingCat.ofHom (algebraMap R₀ M₂)
      have hf₁_fp : f₁.hom.FinitePresentation := RingHom.finitePresentation_algebraMap.mpr hFP₁
      have hf₂_fp : f₂.hom.FinitePresentation := RingHom.finitePresentation_algebraMap.mpr hFP₂
      have hf₁_eft : f₁.hom.EssFiniteType := RingHom.essFiniteType_algebraMap.mpr inferInstance
      have hf₂_eft : f₂.hom.EssFiniteType := RingHom.essFiniteType_algebraMap.mpr inferInstance
      let g₁_inf : CommRingCat.of M₁ ⟶ (mkCM M₂).pt :=
        CommRingCat.ofHom (Θ.toAlgHom.toRingHom.comp
          (Algebra.TensorProduct.includeRight : M₁ →ₐ[R₀] TensorProduct R₀ C_pt M₁).toRingHom)
      let g₂_inf : CommRingCat.of M₂ ⟶ (mkCM M₁).pt :=
        CommRingCat.ofHom (Θ.symm.toAlgHom.toRingHom.comp
          (Algebra.TensorProduct.includeRight : M₂ →ₐ[R₀] TensorProduct R₀ C_pt M₂).toRingHom)
      have hg₁_comm : ∀ i : I, f₁ ≫ g₁_inf = (mkαM M₂).app i ≫ (mkCM M₂).ι.app i := by
        intro i
        apply CommRingCat.hom_ext; apply RingHom.ext; intro r₀
        change Θ ((1 : C_pt) ⊗ₜ[R₀] (algebraMap R₀ M₁ r₀)) =
          (ιG i 1) ⊗ₜ[R₀] (algebraMap R₀ M₂ r₀)
        rw [map_one, Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₁),
          Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₂),
          ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul,
          ← Algebra.algebraMap_eq_smul_one (R := R₀) (A := C_pt)]
        exact Θ.commutes (α_pt r₀)
      have hg₂_comm : ∀ i : I, f₂ ≫ g₂_inf = (mkαM M₁).app i ≫ (mkCM M₁).ι.app i := by
        intro i
        apply CommRingCat.hom_ext; apply RingHom.ext; intro r₀
        change Θ.symm ((1 : C_pt) ⊗ₜ[R₀] (algebraMap R₀ M₂ r₀)) =
          (ιG i 1) ⊗ₜ[R₀] (algebraMap R₀ M₁ r₀)
        rw [map_one, Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₂),
          Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₁),
          ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul,
          ← Algebra.algebraMap_eq_smul_one (R := R₀) (A := C_pt)]
        exact Θ.symm.commutes (α_pt r₀)
      obtain ⟨u₁, g'₁, hg'₁_α, hg'₁_fac⟩ :=
        RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          (CommRingCat.of R₀) (mkGM M₂) (mkαM M₂) f₁ (mkCM M₂) hcM₂ hf₁_fp g₁_inf hg₁_comm
      obtain ⟨u₂, g'₂, hg'₂_α, hg'₂_fac⟩ :=
        RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
          (CommRingCat.of R₀) (mkGM M₁) (mkαM M₁) f₂ (mkCM M₁) hcM₁ hf₂_fp g₂_inf hg₂_comm
      let u₀ : I := u₁ ⊔ u₂
      let h₁₀ : u₁ ⟶ u₀ := homOfLE le_sup_left
      let h₂₀ : u₂ ⟶ u₀ := homOfLE le_sup_right
      let p₁₀ : CommRingCat.of M₁ ⟶ (mkGM M₂).obj u₀ := g'₁ ≫ (mkGM M₂).map h₁₀
      let p₂₀ : CommRingCat.of M₂ ⟶ (mkGM M₁).obj u₀ := g'₂ ≫ (mkGM M₁).map h₂₀
      have hp₁₀_α : ∀ (u : I) (hu : u₀ ≤ u) (r₀ : R₀),
          (p₁₀ ≫ (mkGM M₂).map (homOfLE hu)).hom (algebraMap R₀ M₁ r₀) =
            (1 : ↑(G.obj u)) ⊗ₜ[R₀] (algebraMap R₀ M₂ r₀) := by
        intro u hu r₀
        change ((f₁ ≫ g'₁) ≫ (mkGM M₂).map h₁₀ ≫ (mkGM M₂).map (homOfLE hu)).hom r₀ = _
        rw [hg'₁_α, ← (mkGM M₂).map_comp]
        change ((G.map (h₁₀ ≫ homOfLE hu)).hom 1) ⊗ₜ[R₀] (algebraMap R₀ M₂ r₀) = _
        rw [map_one]
      have hp₂₀_α : ∀ (u : I) (hu : u₀ ≤ u) (r₀ : R₀),
          (p₂₀ ≫ (mkGM M₁).map (homOfLE hu)).hom (algebraMap R₀ M₂ r₀) =
            (1 : ↑(G.obj u)) ⊗ₜ[R₀] (algebraMap R₀ M₁ r₀) := by
        intro u hu r₀
        change ((f₂ ≫ g'₂) ≫ (mkGM M₁).map h₂₀ ≫ (mkGM M₁).map (homOfLE hu)).hom r₀ = _
        rw [hg'₂_α, ← (mkGM M₁).map_comp]
        change ((G.map (h₂₀ ≫ homOfLE hu)).hom 1) ⊗ₜ[R₀] (algebraMap R₀ M₁ r₀) = _
        rw [map_one]
      have hp₁₀_fac : p₁₀ ≫ (mkCM M₂).ι.app u₀ = g₁_inf := by
        rw [CategoryTheory.Category.assoc, (mkCM M₂).w, ← hg'₁_fac]
      have hp₂₀_fac : p₂₀ ≫ (mkCM M₁).ι.app u₀ = g₂_inf := by
        rw [CategoryTheory.Category.assoc, (mkCM M₁).w, ← hg'₂_fac]
      let mkExt₁₂ : ∀ (u : I), (u₀ ≤ u) →
          TensorProduct R₀ ↑(G.obj u) M₁ →ₐ[↑(G.obj u)] TensorProduct R₀ ↑(G.obj u) M₂ :=
        fun u hu =>
          Algebra.TensorProduct.lift
            (Algebra.ofId ↑(G.obj u) (TensorProduct R₀ ↑(G.obj u) M₂))
            { toRingHom := (p₁₀ ≫ (mkGM M₂).map (homOfLE hu)).hom
              commutes' := fun r₀ => by
                change (p₁₀ ≫ (mkGM M₂).map (homOfLE hu)).hom (algebraMap R₀ M₁ r₀) =
                  algebraMap R₀ (TensorProduct R₀ ↑(G.obj u) M₂) r₀
                rw [hp₁₀_α u hu r₀, Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₂),
                  ← TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one (R := R₀) (A := ↑(G.obj u))]
                rfl }
            (fun _ _ => mul_comm _ _)
      let mkExt₂₁ : ∀ (u : I), (u₀ ≤ u) →
          TensorProduct R₀ ↑(G.obj u) M₂ →ₐ[↑(G.obj u)] TensorProduct R₀ ↑(G.obj u) M₁ :=
        fun u hu =>
          Algebra.TensorProduct.lift
            (Algebra.ofId ↑(G.obj u) (TensorProduct R₀ ↑(G.obj u) M₁))
            { toRingHom := (p₂₀ ≫ (mkGM M₁).map (homOfLE hu)).hom
              commutes' := fun r₀ => by
                change (p₂₀ ≫ (mkGM M₁).map (homOfLE hu)).hom (algebraMap R₀ M₂ r₀) =
                  algebraMap R₀ (TensorProduct R₀ ↑(G.obj u) M₁) r₀
                rw [hp₂₀_α u hu r₀, Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₁),
                  ← TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one (R := R₀) (A := ↑(G.obj u))]
                rfl }
            (fun _ _ => mul_comm _ _)
      have hExt₁₂_nat : ∀ {u v : I} (hu : u₀ ≤ u) (hv : u₀ ≤ v) (g : u ⟶ v)
          (z : TensorProduct R₀ ↑(G.obj u) M₁),
          ((mkGM M₂).map g).hom (mkExt₁₂ u hu z) = mkExt₁₂ v hv (((mkGM M₁).map g).hom z) := by
        intro u v hu hv g z
        refine TensorProduct.inductionOn z ?_ (fun _ _ hx hy => by rw [map_add, map_add, map_add, map_add, hx, hy])
        intro x m₁
        have h_l1 : mkExt₁₂ u hu (x ⊗ₜ[R₀] m₁) =
            algebraMap ↑(G.obj u) _ x * (p₁₀ ≫ (mkGM M₂).map (homOfLE hu)).hom m₁ :=
          Algebra.TensorProduct.lift_tmul _ _ _ x m₁
        have h_l2 : mkExt₁₂ v hv (((G.map g).hom x) ⊗ₜ[R₀] m₁) =
            algebraMap ↑(G.obj v) _ ((G.map g).hom x) * (p₁₀ ≫ (mkGM M₂).map (homOfLE hv)).hom m₁ :=
          Algebra.TensorProduct.lift_tmul _ _ _ ((G.map g).hom x) m₁
        change ((mkGM M₂).map g).hom (mkExt₁₂ u hu (x ⊗ₜ[R₀] m₁)) =
          mkExt₁₂ v hv (((G.map g).hom x) ⊗ₜ[R₀] m₁)
        rw [h_l1, h_l2, map_mul]
        congr 1
        have h_hom_eq : (homOfLE hu) ≫ g = homOfLE hv := Subsingleton.elim _ _
        change (p₁₀ ≫ (mkGM M₂).map (homOfLE hu) ≫ (mkGM M₂).map g).hom m₁ = _
        rw [← (mkGM M₂).map_comp, h_hom_eq]
      have hExt₂₁_nat : ∀ {u v : I} (hu : u₀ ≤ u) (hv : u₀ ≤ v) (g : u ⟶ v)
          (z : TensorProduct R₀ ↑(G.obj u) M₂),
          ((mkGM M₁).map g).hom (mkExt₂₁ u hu z) = mkExt₂₁ v hv (((mkGM M₂).map g).hom z) := by
        intro u v hu hv g z
        refine TensorProduct.inductionOn z ?_ (fun _ _ hx hy => by rw [map_add, map_add, map_add, map_add, hx, hy])
        intro x m₂
        have h_l1 : mkExt₂₁ u hu (x ⊗ₜ[R₀] m₂) =
            algebraMap ↑(G.obj u) _ x * (p₂₀ ≫ (mkGM M₁).map (homOfLE hu)).hom m₂ :=
          Algebra.TensorProduct.lift_tmul _ _ _ x m₂
        have h_l2 : mkExt₂₁ v hv (((G.map g).hom x) ⊗ₜ[R₀] m₂) =
            algebraMap ↑(G.obj v) _ ((G.map g).hom x) * (p₂₀ ≫ (mkGM M₁).map (homOfLE hv)).hom m₂ :=
          Algebra.TensorProduct.lift_tmul _ _ _ ((G.map g).hom x) m₂
        change ((mkGM M₁).map g).hom (mkExt₂₁ u hu (x ⊗ₜ[R₀] m₂)) =
          mkExt₂₁ v hv (((G.map g).hom x) ⊗ₜ[R₀] m₂)
        rw [h_l1, h_l2, map_mul]
        congr 1
        have h_hom_eq : (homOfLE hu) ≫ g = homOfLE hv := Subsingleton.elim _ _
        change (p₂₀ ≫ (mkGM M₁).map (homOfLE hu) ≫ (mkGM M₁).map g).hom m₂ = _
        rw [← (mkGM M₁).map_comp, h_hom_eq]
      have hExt₁₂_colim : ∀ z : TensorProduct R₀ ↑(G.obj u₀) M₁,
          ((mkCM M₂).ι.app u₀).hom (mkExt₁₂ u₀ le_rfl z) = Θ (((mkCM M₁).ι.app u₀).hom z) := by
        intro z
        refine TensorProduct.inductionOn z ?_ (fun _ _ hx hy => by rw [map_add, map_add, map_add, map_add, hx, hy])
        intro x m₁
        have h_l : mkExt₁₂ u₀ le_rfl (x ⊗ₜ[R₀] m₁) =
            algebraMap ↑(G.obj u₀) _ x * (p₁₀ ≫ (mkGM M₂).map (homOfLE le_rfl)).hom m₁ :=
          Algebra.TensorProduct.lift_tmul _ _ _ x m₁
        have hid : homOfLE (le_rfl : u₀ ≤ u₀) = 𝟙 u₀ := Subsingleton.elim _ _
        rw [h_l, hid, (mkGM M₂).map_id, CategoryTheory.Category.comp_id, map_mul]
        have hm₁ : ((mkCM M₂).ι.app u₀).hom (p₁₀.hom m₁) = Θ ((1 : C_pt) ⊗ₜ[R₀] m₁) :=
          congrArg (fun q => q.hom m₁) hp₁₀_fac
        rw [hm₁]
        change ((ιG u₀ x) ⊗ₜ[R₀] (1 : M₂)) * Θ ((1 : C_pt) ⊗ₜ[R₀] m₁) =
          Θ ((ιG u₀ x) ⊗ₜ[R₀] m₁)
        have hx_alg : ((ιG u₀ x) ⊗ₜ[R₀] m₁) =
            algebraMap C_pt _ (ιG u₀ x) * ((1 : C_pt) ⊗ₜ[R₀] m₁) := by
          change _ = ((ιG u₀ x) ⊗ₜ[R₀] (1 : M₁)) * ((1 : C_pt) ⊗ₜ[R₀] m₁)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hx_alg, map_mul, Θ.commutes]
        rfl
      have hExt₂₁_colim : ∀ z : TensorProduct R₀ ↑(G.obj u₀) M₂,
          ((mkCM M₁).ι.app u₀).hom (mkExt₂₁ u₀ le_rfl z) = Θ.symm (((mkCM M₂).ι.app u₀).hom z) := by
        intro z
        refine TensorProduct.inductionOn z ?_ (fun _ _ hx hy => by rw [map_add, map_add, map_add, map_add, hx, hy])
        intro x m₂
        have h_l : mkExt₂₁ u₀ le_rfl (x ⊗ₜ[R₀] m₂) =
            algebraMap ↑(G.obj u₀) _ x * (p₂₀ ≫ (mkGM M₁).map (homOfLE le_rfl)).hom m₂ :=
          Algebra.TensorProduct.lift_tmul _ _ _ x m₂
        have hid : homOfLE (le_rfl : u₀ ≤ u₀) = 𝟙 u₀ := Subsingleton.elim _ _
        rw [h_l, hid, (mkGM M₁).map_id, CategoryTheory.Category.comp_id, map_mul]
        have hm₂ : ((mkCM M₁).ι.app u₀).hom (p₂₀.hom m₂) = Θ.symm ((1 : C_pt) ⊗ₜ[R₀] m₂) :=
          congrArg (fun q => q.hom m₂) hp₂₀_fac
        rw [hm₂]
        change ((ιG u₀ x) ⊗ₜ[R₀] (1 : M₁)) * Θ.symm ((1 : C_pt) ⊗ₜ[R₀] m₂) =
          Θ.symm ((ιG u₀ x) ⊗ₜ[R₀] m₂)
        have hx_alg : ((ιG u₀ x) ⊗ₜ[R₀] m₂) =
            algebraMap C_pt _ (ιG u₀ x) * ((1 : C_pt) ⊗ₜ[R₀] m₂) := by
          change _ = ((ιG u₀ x) ⊗ₜ[R₀] (1 : M₂)) * ((1 : C_pt) ⊗ₜ[R₀] m₂)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hx_alg, map_mul, Θ.symm.commutes]
        rfl
      let a₁ : CommRingCat.of M₁ ⟶ (mkGM M₁).obj u₀ :=
        CommRingCat.ofHom ((mkExt₂₁ u₀ le_rfl).toRingHom.comp p₁₀.hom)
      let b₁ : CommRingCat.of M₁ ⟶ (mkGM M₁).obj u₀ :=
        CommRingCat.ofHom (Algebra.TensorProduct.includeRight : M₁ →ₐ[R₀] TensorProduct R₀ ↑(G.obj u₀) M₁).toRingHom
      have ha₁_α : f₁ ≫ a₁ = (mkαM M₁).app u₀ := by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro r₀
        change mkExt₂₁ u₀ le_rfl (p₁₀.hom (algebraMap R₀ M₁ r₀)) = (1 : ↑(G.obj u₀)) ⊗ₜ[R₀] (algebraMap R₀ M₁ r₀)
        have hp0 := hp₁₀_α u₀ le_rfl r₀
        have hid : homOfLE (le_rfl : u₀ ≤ u₀) = 𝟙 u₀ := Subsingleton.elim _ _
        rw [hid, (mkGM M₂).map_id, CategoryTheory.Category.comp_id] at hp0
        rw [hp0, Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₂),
          Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₁),
          ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
        exact (mkExt₂₁ u₀ le_rfl).commutes _
      have hb₁_α : f₁ ≫ b₁ = (mkαM M₁).app u₀ := rfl
      have hab₁_colim : a₁ ≫ (mkCM M₁).ι.app u₀ = b₁ ≫ (mkCM M₁).ι.app u₀ := by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro m₁
        have h_a₁ : a₁.hom m₁ = mkExt₂₁ u₀ le_rfl (p₁₀.hom m₁) := rfl
        have h_b₁ : b₁.hom m₁ = (1 : ↑(G.obj u₀)) ⊗ₜ[R₀] m₁ := rfl
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, h_a₁, h_b₁]
        rw [hExt₂₁_colim (p₁₀.hom m₁)]
        have hm₁ : ((mkCM M₂).ι.app u₀).hom (p₁₀.hom m₁) = Θ ((1 : C_pt) ⊗ₜ[R₀] m₁) :=
          congrArg (fun q => q.hom m₁) hp₁₀_fac
        rw [hm₁, Θ.symm_apply_apply]
        change (1 : C_pt) ⊗ₜ[R₀] m₁ = (ιG u₀ 1) ⊗ₜ[R₀] m₁
        rw [map_one]
      obtain ⟨k₁, hk₁_1, hk₁_2, hk₁_eq⟩ :=
        RingHom.EssFiniteType.exists_comp_map_eq_of_isColimit
          (CommRingCat.of R₀) (mkGM M₁) (mkαM M₁) f₁ (mkCM M₁) hcM₁
          hf₁_eft a₁ ha₁_α b₁ hb₁_α hab₁_colim
      let a₂ : CommRingCat.of M₂ ⟶ (mkGM M₂).obj u₀ :=
        CommRingCat.ofHom ((mkExt₁₂ u₀ le_rfl).toRingHom.comp p₂₀.hom)
      let b₂ : CommRingCat.of M₂ ⟶ (mkGM M₂).obj u₀ :=
        CommRingCat.ofHom (Algebra.TensorProduct.includeRight : M₂ →ₐ[R₀] TensorProduct R₀ ↑(G.obj u₀) M₂).toRingHom
      have ha₂_α : f₂ ≫ a₂ = (mkαM M₂).app u₀ := by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro r₀
        change mkExt₁₂ u₀ le_rfl (p₂₀.hom (algebraMap R₀ M₂ r₀)) = (1 : ↑(G.obj u₀)) ⊗ₜ[R₀] (algebraMap R₀ M₂ r₀)
        have hp0 := hp₂₀_α u₀ le_rfl r₀
        have hid : homOfLE (le_rfl : u₀ ≤ u₀) = 𝟙 u₀ := Subsingleton.elim _ _
        rw [hid, (mkGM M₁).map_id, CategoryTheory.Category.comp_id] at hp0
        rw [hp0, Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₁),
          Algebra.algebraMap_eq_smul_one (R := R₀) (A := M₂),
          ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
        exact (mkExt₁₂ u₀ le_rfl).commutes _
      have hb₂_α : f₂ ≫ b₂ = (mkαM M₂).app u₀ := rfl
