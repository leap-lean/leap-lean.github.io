          (by rw [← Algebra.TensorProduct.map_comp, AlgHom.comp_id, h_e4_2, Algebra.TensorProduct.map_id])
      exact ⟨(Algebra.TensorProduct.cancelBaseChange A₁ ↥(Algebra.adjoin B₀ (↑j₄.1 : Set K)) Ω Ω M₁).symm.trans
