        (Field.toIsField κ)
    have hq_max : q_bar.IsMaximal :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient q_bar).mpr hIsField_Qbar
    have : q_bar.IsMaximal := hq_max
    let e_QE : Q_bar ≃+* E := IsLocalization.AtPrime.equivQuotMaximalIdeal q_bar O_x
    have hSurj_BκE : Function.Surjective (IsScalarTower.toAlgHom κ B_κ E) := by
      intro e
      obtain ⟨q, hq⟩ := e_QE.surjective e
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
      refine ⟨b, ?_⟩
      rw [← hq]
      rfl
    have : Algebra.FiniteType κ E :=
      Algebra.FiniteType.of_surjective (IsScalarTower.toAlgHom κ B_κ E) hSurj_BκE
    have hFinDim : FiniteDimensional κ E := Algebra.IsIntegral.finite
    exact ⟨hq_max, hSep, hFinDim⟩
  
  let q_bar : Ideal B_κ := RingHom.ker ev_K.toRingHom
  have : q_bar.IsPrime := RingHom.ker_isPrime ev_K.toRingHom
  let O_x := Localization.AtPrime q_bar
  let m_x := IsLocalRing.maximalIdeal O_x
  let E := IsLocalRing.ResidueField O_x
  let A'_loc := Localization.AtPrime u₀.asIdeal
  let xbar : Fin 2 → A'_loc := fun i =>
    algebraMap A' A'_loc (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K)))
  obtain ⟨hBijA', hSpanA', ⟨e_Ω_right⟩,
    ⟨R, instRingR, instLocR, instAlgKR, ψ₂, hBijR, hLocR, hFlatR, hMapR, hDimR⟩⟩ :=
    h_s1 K A' u₀ φ₂ hEt₂ hX_mem
  obtain ⟨ψ_x, hLocOx, hFlatOx, ⟨e_Ω_left⟩, hSepMax⟩ :=
    h_s3 κ K B_κ ev_K A' u₀ φ₁ hEt₁ hComap₁
  letI : Algebra O_x A'_loc := ψ_x.toAlgebra
  have : IsLocalHom (algebraMap O_x A'_loc) := hLocOx
  have : Module.Flat O_x A'_loc := hFlatOx
  have hMapOx : Ideal.map (algebraMap O_x A'_loc) m_x = IsLocalRing.maximalIdeal A'_loc :=
    h_s2 O_x A'_loc Ω[O_x⁄κ] (xbar 0) (xbar 1) hSpanA' ⟨e_Ω_left.trans e_Ω_right⟩
  obtain ⟨hq_max, hSep, hFinDim⟩ := hSepMax hBijA' hMapOx
  letI : CommRing R := instRingR
  letI : IsLocalRing R := instLocR
  letI : Algebra K R := instAlgKR
  letI : Algebra R A'_loc := ψ₂.toAlgebra
  have : IsLocalHom (algebraMap R A'_loc) := hLocR
  have : Module.Flat R A'_loc := hFlatR
  have hArtEq := h_s4 κ K O_x R A'_loc hFinDim hBijR hMapOx hMapR (fun m => (hDimR m).1)
  refine ⟨hq_max, hSep, hFinDim, fun d => ?_⟩
  rw [hArtEq d, (hDimR d).2]

theorem weil_separable_residue_mvPoly_taylor_truncation_equiv (κ B_κ : Type u)
    [Field κ] [CommRing B_κ] [Algebra κ B_κ]
    (n : ℕ)
    (π_κ : MvPolynomial (Fin n) κ →ₐ[κ] B_κ)
    (hπ_κ_surj : Function.Surjective π_κ)
    (q_bar : PrimeSpectrum B_κ)
    (hq_bar_max : q_bar.asIdeal.IsMaximal)
    (hSep : Algebra.IsSeparable κ (IsLocalRing.ResidueField (Localization.AtPrime q_bar.asIdeal))) :
    let O_x := Localization.AtPrime q_bar.asIdeal
    let m_x := IsLocalRing.maximalIdeal O_x
    let E := IsLocalRing.ResidueField O_x
    let P_κ := MvPolynomial (Fin n) κ
    let I_κ : Ideal P_κ := RingHom.ker π_κ.toRingHom
    let Q_bar : Ideal P_κ := Ideal.comap π_κ.toRingHom q_bar.asIdeal
    haveI : Q_bar.IsPrime := Ideal.IsPrime.comap π_κ.toRingHom
    let P := Localization.AtPrime Q_bar
    let P_E := MvPolynomial (Fin n) E
    let M_U : Ideal P_E := Ideal.span (Set.range (MvPolynomial.X : Fin n → P_E))
    let ε : P_κ →ₐ[κ] E :=
      (IsScalarTower.toAlgHom κ O_x E).comp ((IsScalarTower.toAlgHom κ B_κ O_x).comp π_κ)
    let sh : P_κ →ₐ[κ] P_E :=
      MvPolynomial.aeval (fun i => MvPolynomial.C (ε (MvPolynomial.X i)) + MvPolynomial.X i)
    (∀ f ∈ I_κ, sh f ∈ M_U) ∧
    (∀ d : ℕ,
      Nonempty ((O_x ⧸ m_x ^ (d + 1)) ≃ₐ[κ]
        (P_E ⧸ (Ideal.span (sh '' (I_κ : Set P_κ)) ⊔ M_U ^ (d + 1))))) ∧
    (∀ S : Set P_κ,
      S ⊆ (I_κ : Set P_κ) →
      (∀ d : ℕ, Ideal.span (sh '' (I_κ : Set P_κ)) ≤ Ideal.span (sh '' S) ⊔ M_U ^ (d + 1)) →
      Ideal.map (algebraMap P_κ P) I_κ = Ideal.map (algebraMap P_κ P) (Ideal.span S)) :=
by
  have : q_bar.asIdeal.IsMaximal := hq_bar_max
  have : Algebra.IsSeparable κ (IsLocalRing.ResidueField (Localization.AtPrime q_bar.asIdeal)) := hSep
  let O_x := Localization.AtPrime q_bar.asIdeal
  let m_x := IsLocalRing.maximalIdeal O_x
  let E := IsLocalRing.ResidueField O_x
  let P_κ := MvPolynomial (Fin n) κ
  let I_κ : Ideal P_κ := RingHom.ker π_κ.toRingHom
  let Q_bar : Ideal P_κ := Ideal.comap π_κ.toRingHom q_bar.asIdeal
  have : Q_bar.IsPrime := Ideal.IsPrime.comap π_κ.toRingHom
  let P := Localization.AtPrime Q_bar
  let P_E := MvPolynomial (Fin n) E
  let M_U : Ideal P_E := Ideal.span (Set.range (MvPolynomial.X : Fin n → P_E))
  let ε : P_κ →ₐ[κ] E :=
    (IsScalarTower.toAlgHom κ O_x E).comp ((IsScalarTower.toAlgHom κ B_κ O_x).comp π_κ)
  let sh : P_κ →ₐ[κ] P_E :=
    MvPolynomial.aeval (fun i => MvPolynomial.C (ε (MvPolynomial.X i)) + MvPolynomial.X i)
  change (∀ f ∈ I_κ, sh f ∈ M_U) ∧
    (∀ d : ℕ,
      Nonempty ((O_x ⧸ m_x ^ (d + 1)) ≃ₐ[κ]
        (P_E ⧸ (Ideal.span (sh '' (I_κ : Set P_κ)) ⊔ M_U ^ (d + 1))))) ∧
    (∀ S : Set P_κ,
      S ⊆ (I_κ : Set P_κ) →
      (∀ d : ℕ, Ideal.span (sh '' (I_κ : Set P_κ)) ≤ Ideal.span (sh '' S) ⊔ M_U ^ (d + 1)) →
      Ideal.map (algebraMap P_κ P) I_κ = Ideal.map (algebraMap P_κ P) (Ideal.span S))
  
  have hε_eq : ∀ f : P_κ, ε f = algebraMap B_κ q_bar.asIdeal.ResidueField (π_κ f) := by
    intro f
    exact (IsScalarTower.algebraMap_apply B_κ O_x q_bar.asIdeal.ResidueField (π_κ f)).symm
  have hε_surj : Function.Surjective ε := by
    intro c
    obtain ⟨b, hb⟩ := Ideal.algebraMap_residueField_surjective q_bar.asIdeal c
    obtain ⟨f, rfl⟩ := hπ_κ_surj b
    exact ⟨f, (hε_eq f).trans hb⟩
  have hε_ker : ∀ f : P_κ, ε f = 0 ↔ f ∈ Q_bar := by
    intro f
    rw [hε_eq f, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    rfl
  have hI_le_Q : I_κ ≤ Q_bar := by
    intro f hf
    change π_κ f ∈ q_bar.asIdeal
    have hf0 : π_κ f = 0 := hf
    rw [hf0]
    exact q_bar.asIdeal.zero_mem
  
  
  have h_taylor :
      ∀ (E_res : Type u) [Field E_res] [Algebra κ E_res] [Algebra.IsSeparable κ E_res]
        (Q₀ : Ideal (MvPolynomial (Fin n) κ)) [Q₀.IsPrime]
        (ε₀ : MvPolynomial (Fin n) κ →ₐ[κ] E_res),
        Function.Surjective ε₀ →
        (∀ f : MvPolynomial (Fin n) κ, ε₀ f = 0 ↔ f ∈ Q₀) →
        ∀ (R_loc : Type u) [CommRing R_loc] [Algebra κ R_loc]
          [Algebra (MvPolynomial (Fin n) κ) R_loc]
          [IsScalarTower κ (MvPolynomial (Fin n) κ) R_loc]
          [IsLocalization.AtPrime R_loc Q₀] [IsLocalRing R_loc],
          let M_U₀ : Ideal (MvPolynomial (Fin n) E_res) :=
            Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) E_res))
          let sh₀ : MvPolynomial (Fin n) κ →ₐ[κ] MvPolynomial (Fin n) E_res :=
            MvPolynomial.aeval (fun i => MvPolynomial.C (ε₀ (MvPolynomial.X i)) + MvPolynomial.X i)
          (∀ f : MvPolynomial (Fin n) κ, sh₀ f ∈ M_U₀ ↔ f ∈ Q₀) ∧
          (∀ d : ℕ, ∃ α_d : R_loc →ₐ[κ] (MvPolynomial (Fin n) E_res ⧸ M_U₀ ^ (d + 1)),
            Function.Surjective α_d ∧
            RingHom.ker α_d = (IsLocalRing.maximalIdeal R_loc) ^ (d + 1) ∧
            ∀ f : MvPolynomial (Fin n) κ,
              α_d (algebraMap (MvPolynomial (Fin n) κ) R_loc f) =
                Ideal.Quotient.mk (M_U₀ ^ (d + 1)) (sh₀ f)) := by
    intro E_res _ _ _ Q₀ _ ε₀ hε₀_surj hε₀_ker R_loc _ _ _ _ _ _ M_U₀ sh₀
    let ev_0 : MvPolynomial (Fin n) E_res →ₐ[E_res] E_res := MvPolynomial.aeval (0 : Fin n → E_res)
    let cc_alg : MvPolynomial (Fin n) E_res →ₐ[κ] E_res := ev_0.restrictScalars κ
    have hev0_C : ∀ c : E_res, ev_0 (MvPolynomial.C c) = c := fun c => by simp [ev_0]
    have hev0_X : ∀ i : Fin n, ev_0 (MvPolynomial.X i) = 0 := fun i => by simp [ev_0]
    have hsh_X : ∀ i : Fin n,
        sh₀ (MvPolynomial.X i) = MvPolynomial.C (ε₀ (MvPolynomial.X i)) + MvPolynomial.X i :=
      fun i => MvPolynomial.aeval_X _ i
    have hcc_sh : cc_alg.comp sh₀ = ε₀ := by
      apply MvPolynomial.algHom_ext
      intro i
      change ev_0 (sh₀ (MvPolynomial.X i)) = ε₀ (MvPolynomial.X i)
      rw [hsh_X, map_add, hev0_C, hev0_X, add_zero]
    have hsub_mem_MU : ∀ H : MvPolynomial (Fin n) E_res, H - MvPolynomial.C (ev_0 H) ∈ M_U₀ := by
      intro H
      induction H using MvPolynomial.induction_on with
      | C c =>
        rw [hev0_C, sub_self]
        exact M_U₀.zero_mem
      | add p q hp hq =>
        rw [map_add, map_add]
        convert M_U₀.add_mem hp hq using 1
        ring
      | mul_X p i hp =>
        have h0 : ev_0 (p * MvPolynomial.X i) = 0 := by
          rw [map_mul, hev0_X, mul_zero]
        rw [h0, map_zero, sub_zero]
        exact Ideal.mul_mem_left M_U₀ p (Ideal.subset_span ⟨i, rfl⟩)
    have hMU_le_ker : M_U₀ ≤ RingHom.ker cc_alg.toRingHom := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hev0_X i
    have hcc_zero_iff : ∀ H : MvPolynomial (Fin n) E_res, cc_alg H = 0 ↔ H ∈ M_U₀ := by
      intro H
      constructor
      · intro hH
        have hmem := hsub_mem_MU H
        change ev_0 H = 0 at hH
        rwa [hH, map_zero, sub_zero] at hmem
      · intro hH
        exact hMU_le_ker hH
    have hsh_mem_iff : ∀ f : MvPolynomial (Fin n) κ, sh₀ f ∈ M_U₀ ↔ f ∈ Q₀ := by
      intro f
      rw [← hcc_zero_iff, ← hε₀_ker]
      have hfun := AlgHom.congr_fun hcc_sh f
      exact Iff.of_eq (congrArg (· = 0) hfun)
    refine ⟨hsh_mem_iff, ?_⟩
    let m_R : Ideal R_loc := IsLocalRing.maximalIdeal R_loc
    have hmR_eq : m_R = Ideal.map (algebraMap (MvPolynomial (Fin n) κ) R_loc) Q₀ :=
      (IsLocalization.AtPrime.map_eq_maximalIdeal Q₀ R_loc).symm
    have hFE : Algebra.FormallyEtale κ E_res := Algebra.FormallyEtale.of_isSeparable κ E_res
    have : Algebra.FormallyUnramified κ E_res :=
      (Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mp hFE).1
    have : Algebra.FormallySmooth κ E_res :=
      (Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mp hFE).2
    have hε_units : ∀ y : Q₀.primeCompl, IsUnit (ε₀ y.1) := by
      intro y
      rw [isUnit_iff_ne_zero]
      exact fun h0 => y.2 ((hε₀_ker y.1).mp h0)
    let ε_R : R_loc →ₐ[κ] E_res := IsLocalization.liftAlgHom (M := Q₀.primeCompl) (S := R_loc) hε_units
    have hε_R_eq : ∀ f : MvPolynomial (Fin n) κ,
        ε_R (algebraMap (MvPolynomial (Fin n) κ) R_loc f) = ε₀ f := by
      intro f
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    have hε_R_kill_mR : ∀ z ∈ m_R, ε_R z = 0 := by
      have hle : m_R ≤ RingHom.ker ε_R.toRingHom := by
        rw [hmR_eq, Ideal.map_le_iff_le_comap]
        intro f hf
        change ε_R (algebraMap (MvPolynomial (Fin n) κ) R_loc f) = 0
        rw [hε_R_eq]
        exact (hε₀_ker f).mpr hf
      exact fun z hz => hle hz
    have hε_R_ker_le : RingHom.ker ε_R ≤ m_R := by
      intro z hz
      change ε_R z = 0 at hz
      obtain ⟨⟨r, u⟩, hzu⟩ := IsLocalization.surj Q₀.primeCompl z
      have hr0 : ε₀ r = 0 := by rw [← hε_R_eq, ← hzu, map_mul, hz, zero_mul]
      have hrQ : r ∈ Q₀ := (hε₀_ker r).mp hr0
      obtain ⟨u_inv, hu_inv⟩ := (IsLocalization.map_units R_loc u).exists_right_inv
      have hrmem : algebraMap (MvPolynomial (Fin n) κ) R_loc r ∈ m_R :=
        hmR_eq ▸ Ideal.mem_map_of_mem (algebraMap (MvPolynomial (Fin n) κ) R_loc) hrQ
      have hzmem := Ideal.mul_mem_right u_inv m_R (hzu ▸ hrmem)
      rwa [mul_assoc, hu_inv, mul_one] at hzmem
    intro d
    let Q_Ed := MvPolynomial (Fin n) E_res ⧸ M_U₀ ^ (d + 1)
    let R_d := R_loc ⧸ m_R ^ (d + 1)
    let β_d : MvPolynomial (Fin n) E_res →ₐ[κ] Q_Ed := Ideal.Quotient.mkₐ κ (M_U₀ ^ (d + 1))
    let q_d : R_loc →ₐ[κ] R_d := Ideal.Quotient.mkₐ κ (m_R ^ (d + 1))
    let sh_d : MvPolynomial (Fin n) κ →ₐ[κ] Q_Ed := β_d.comp sh₀
    have hsh_d_units : ∀ y : Q₀.primeCompl, IsUnit (sh_d y.1) := by
      intro y
      let c_y : E_res := ε₀ y.1
      have hc_y : c_y ≠ 0 := fun h0 => y.2 ((hε₀_ker y.1).mp h0)
      let w_y : MvPolynomial (Fin n) E_res := sh₀ y.1 - MvPolynomial.C c_y
      have hw_y_MU : w_y ∈ M_U₀ := by
        rw [← hcc_zero_iff]
        change ev_0 (sh₀ y.1 - MvPolynomial.C c_y) = 0
        have h1 : ev_0 (sh₀ y.1) = c_y := AlgHom.congr_fun hcc_sh y.1
        rw [map_sub, h1, hev0_C, sub_self]
      have hw_nil : IsNilpotent (β_d w_y) :=
        ⟨d + 1, by
          rw [← map_pow]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow hw_y_MU (d + 1))⟩
      have hc_unit : IsUnit (β_d (MvPolynomial.C c_y)) :=
        isUnit_iff_exists_inv.mpr ⟨β_d (MvPolynomial.C c_y⁻¹), by
          rw [← map_mul, ← map_mul, mul_inv_cancel₀ hc_y, map_one, map_one]⟩
      have h_decomp : sh_d y.1 = β_d w_y + β_d (MvPolynomial.C c_y) := by
        change β_d (sh₀ y.1) = _
        rw [← map_add]
        congr 1
        simp [w_y]
      rw [h_decomp]
      exact hw_nil.isUnit_add_right_of_commute hc_unit (Commute.all _ _)
    let α_d : R_loc →ₐ[κ] Q_Ed := IsLocalization.liftAlgHom (M := Q₀.primeCompl) (S := R_loc) hsh_d_units
    have hα_spec : ∀ f : MvPolynomial (Fin n) κ,
        α_d (algebraMap (MvPolynomial (Fin n) κ) R_loc f) =
          Ideal.Quotient.mk (M_U₀ ^ (d + 1)) (sh₀ f) := by
      intro f
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    have hα_kill : ∀ z ∈ m_R ^ (d + 1), α_d z = 0 := by
      have hmap_m : Ideal.map α_d.toRingHom m_R ≤ Ideal.map (Ideal.Quotient.mk (M_U₀ ^ (d + 1))) M_U₀ := by
        rw [hmR_eq, Ideal.map_map, Ideal.map_le_iff_le_comap]
        intro f hf
        rw [Ideal.mem_comap, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hα_spec]
        exact Ideal.mem_map_of_mem _ ((hsh_mem_iff f).mpr hf)
      have hmap_pow : Ideal.map α_d.toRingHom (m_R ^ (d + 1)) ≤ ⊥ := by
        calc Ideal.map α_d.toRingHom (m_R ^ (d + 1))
            = (Ideal.map α_d.toRingHom m_R) ^ (d + 1) := Ideal.map_pow _ _ _
          _ ≤ (Ideal.map (Ideal.Quotient.mk (M_U₀ ^ (d + 1))) M_U₀) ^ (d + 1) :=
              Ideal.pow_right_mono hmap_m (d + 1)
          _ = Ideal.map (Ideal.Quotient.mk (M_U₀ ^ (d + 1))) (M_U₀ ^ (d + 1)) :=
              (Ideal.map_pow _ _ _).symm
          _ = ⊥ := Ideal.map_quotient_self _
      intro z hz
      exact Ideal.mem_bot.mp (hmap_pow (Ideal.mem_map_of_mem α_d.toRingHom hz))
    let Ψ_d : R_d →ₐ[κ] Q_Ed := Ideal.Quotient.liftₐ (m_R ^ (d + 1)) α_d hα_kill
    have hcc_kill : ∀ H ∈ M_U₀ ^ (d + 1), cc_alg H = 0 :=
      fun H hH => (hcc_zero_iff H).mpr (Ideal.pow_le_self (Nat.succ_ne_zero d) hH)
    let cc_d : Q_Ed →ₐ[κ] E_res := Ideal.Quotient.liftₐ (M_U₀ ^ (d + 1)) cc_alg hcc_kill
    have hcc_d_nil : IsNilpotent (RingHom.ker (cc_d : Q_Ed →+* E_res)) := by
      have hle : RingHom.ker (cc_d : Q_Ed →+* E_res) ≤
          Ideal.map (Ideal.Quotient.mk (M_U₀ ^ (d + 1))) M_U₀ := by
        intro x hx
        obtain ⟨H, rfl⟩ := Ideal.Quotient.mk_surjective x
        change cc_alg H = 0 at hx
        exact Ideal.mem_map_of_mem _ ((hcc_zero_iff H).mp hx)
      refine ⟨d + 1, ?_⟩
      rw [Ideal.zero_eq_bot, ← le_bot_iff]
      calc (RingHom.ker (cc_d : Q_Ed →+* E_res)) ^ (d + 1)
          ≤ (Ideal.map (Ideal.Quotient.mk (M_U₀ ^ (d + 1))) M_U₀) ^ (d + 1) :=
            Ideal.pow_right_mono hle (d + 1)
        _ = Ideal.map (Ideal.Quotient.mk (M_U₀ ^ (d + 1))) (M_U₀ ^ (d + 1)) :=
            (Ideal.map_pow _ _ _).symm
        _ = ⊥ := Ideal.map_quotient_self _
    have hεR_kill : ∀ z ∈ m_R ^ (d + 1), ε_R z = 0 :=
      fun z hz => hε_R_kill_mR z (Ideal.pow_le_self (Nat.succ_ne_zero d) hz)
    let π_d0 : R_d →ₐ[κ] E_res := Ideal.Quotient.liftₐ (m_R ^ (d + 1)) ε_R hεR_kill
    have hπ_d0_surj : Function.Surjective π_d0 := by
      intro c
      obtain ⟨f, rfl⟩ := hε₀_surj c
      exact ⟨q_d (algebraMap (MvPolynomial (Fin n) κ) R_loc f), hε_R_eq f⟩
    have hker_πd0_le : RingHom.ker (π_d0 : R_d →+* E_res) ≤
        Ideal.map (Ideal.Quotient.mk (m_R ^ (d + 1))) m_R := by
      intro x hx
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
      change ε_R z = 0 at hx
      exact Ideal.mem_map_of_mem _ (hε_R_ker_le hx)
    have hker_πd0_pow_bot : (RingHom.ker (π_d0 : R_d →+* E_res)) ^ (d + 1) ≤ ⊥ := by
      calc (RingHom.ker (π_d0 : R_d →+* E_res)) ^ (d + 1)
          ≤ (Ideal.map (Ideal.Quotient.mk (m_R ^ (d + 1))) m_R) ^ (d + 1) :=
            Ideal.pow_right_mono hker_πd0_le (d + 1)
        _ = Ideal.map (Ideal.Quotient.mk (m_R ^ (d + 1))) (m_R ^ (d + 1)) :=
            (Ideal.map_pow _ _ _).symm
        _ = ⊥ := Ideal.map_quotient_self _
    have hπ_d0_nil : IsNilpotent (RingHom.ker (π_d0 : R_d →+* E_res)) :=
      ⟨d + 1, by rw [Ideal.zero_eq_bot, le_bot_iff.mp hker_πd0_pow_bot]⟩
    have hcc_Ψ : cc_d.comp Ψ_d = π_d0 := by
      have h_on_R : cc_d.toRingHom.comp α_d.toRingHom = ε_R.toRingHom := by
        apply IsLocalization.ringHom_ext Q₀.primeCompl
        refine RingHom.ext fun f => ?_
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hα_spec, hε_R_eq]
        exact AlgHom.congr_fun hcc_sh f
      ext x
