      have ha0 : algebraMap A₀ κ a = 0 := by
        change a ∈ RingHom.ker (algebraMap A₀ κ)
        rw [hκ_ker]
        exact ha
      rw [MvPolynomial.map_C, ha0, MvPolynomial.C_0, map_zero]
  let I_loc : Ideal R_loc := Ideal.map φ_loc I₀
