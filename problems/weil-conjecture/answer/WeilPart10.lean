  have hOpenToEtale : ∀ {M N : CommRingCat.{u}} (φ : M ⟶ N),
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map φ) →
      φ.hom.Etale := by
    intro M N φ hOpen
    have _ : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map φ) := hOpen
    have hEt : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) := inferInstance
    have hiff : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) ↔ _ :=
