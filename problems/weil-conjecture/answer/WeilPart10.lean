        π₀_alg.toLinearMap hSurj_lin ι₀ hinj_ι₀ hExact (A₀ ⧸ I_A)
    let e_M := TensorProduct.quotTensorEquivQuotSMul (↥M₀) I_A
    let e_P := TensorProduct.quotTensorEquivQuotSMul P₀ I_A
    have hK₀_le_smul : ∀ H ∈ K₀, H ∈ (I_A • (⊤ : Submodule A₀ P₀)) := by
      let L_id : Ideal P₀ :=
        { carrier := {x : P₀ | x ∈ (I_A • (⊤ : Submodule A₀ P₀))}
          zero_mem' := Submodule.zero_mem (I_A • (⊤ : Submodule A₀ P₀))
          add_mem' := fun hx hy => Submodule.add_mem (I_A • (⊤ : Submodule A₀ P₀)) hx hy
          smul_mem' := fun P {x} hx => by
            change P * x ∈ I_A • (⊤ : Submodule A₀ P₀)
            refine Submodule.smul_induction_on hx ?_ ?_
            · intro a ha Q _
              have hmul : P * (a • Q) = a • (P * Q) := mul_smul_comm a P Q
              rw [hmul]
              exact Submodule.smul_mem_smul ha trivial
            · intro x₁ x₂ hx₁ hx₂
              rw [mul_add]
              exact Submodule.add_mem _ hx₁ hx₂ }
      have hK_le_L : K₀ ≤ L_id := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        change MvPolynomial.C a ∈ I_A • (⊤ : Submodule A₀ P₀)
        have hCa : (MvPolynomial.C a : P₀) = a • (1 : P₀) := by
          rw [MvPolynomial.smul_eq_C_mul, mul_one]
        rw [hCa]
        exact Submodule.smul_mem_smul ha trivial
      intro H hH
      exact hK_le_L hH
    have hSmul_le_mul : ∀ m : ↥M₀, m ∈ (I_A • (⊤ : Submodule A₀ ↥M₀)) → m.1 ∈ K₀ * I₀ := by
      intro m hm
      refine Submodule.smul_induction_on hm ?_ ?_
      · intro a ha y _
        change a • y.1 ∈ K₀ * I₀
        rw [MvPolynomial.smul_eq_C_mul]
        exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem MvPolynomial.C ha) y.2
      · intro x₁ x₂ hx₁ hx₂
        exact Ideal.add_mem _ hx₁ hx₂
    intro H ⟨hHI, hHK⟩
    let m : ↥M₀ := ⟨H, hHI⟩
    let z : TensorProduct A₀ (A₀ ⧸ I_A) ↥M₀ := (Ideal.Quotient.mk I_A 1) ⊗ₜ[A₀] m
    have hz_img : e_P (LinearMap.lTensor (A₀ ⧸ I_A) ι₀ z) = 0 := by
      change (TensorProduct.quotTensorEquivQuotSMul P₀ I_A)
        ((Ideal.Quotient.mk I_A 1) ⊗ₜ[A₀] H) = 0
      rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul,
        Submodule.Quotient.mk_eq_zero]
