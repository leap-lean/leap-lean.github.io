      let u₂_tilde := liftAt j₂ u₂_cat f_M (fun _ => rfl) hu₂_comm
      let v₂_tilde := liftAt j₂ v₂_cat f_B (fun _ => rfl) hv₂_comm

      
      let comp_vu₂_M : CommRingCat.of M₁ ⟶ (mkF M₁).obj j₂ :=
