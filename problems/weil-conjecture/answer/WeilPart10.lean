        (Algebra.TensorProduct.map
          (Algebra.adjoin B₀ (↑S₁_nod : Set K_bar)).val
          (AlgHom.id B₀ (R₀ α))).toRingHom q_bar ∈ U₁ α := by
    intro α q_bar
    have hq_univ : q_bar ∈
        (⋃ μ : Fin (m α), (PrimeSpectrum.basicOpen (f α μ) : Set _)) ∪
          (⋃ ν : Fin (s α), Set.range (PrimeSpectrum.comap (φ_D α ν))) := by
      rw [hGenCov α]
      trivial
    rcases hq_univ with hq_sm | hq_rf
    · obtain ⟨μ, hq_μ⟩ := Set.mem_iUnion.mp hq_sm
      refine SetLike.le_def.mp (le_sup_of_le_left (le_iSup (fun μ => PrimeSpectrum.basicOpen (f₁ α μ)) μ)) ?_
      rw [hComapBasic]
