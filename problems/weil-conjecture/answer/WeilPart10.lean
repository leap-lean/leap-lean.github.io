    have hV₀_comm : f_AB ≫ hU₀.fromSpec = hV₀.fromSpec ≫ g :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec g hU₀ hV₀ hV₀_le
    have hLiftComm : (p_B_mor ≫ hV₀.fromSpec) ≫ g = p_K_mor ≫ s_K := by
      rw [CategoryTheory.Category.assoc, ← hV₀_comm, ← CategoryTheory.Category.assoc,
