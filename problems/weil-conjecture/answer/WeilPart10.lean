theorem weil_lci_kaehler_presentation_and_nodal_injectivity : HasWeilLciKaehlerAndNodalAlgebra.{u} :=
by
  have hConj1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      (k : ℕ) (π : MvPolynomial (Fin (k + 1)) A →+* B)
      (F : Fin k → MvPolynomial (Fin (k + 1)) A),
    π.comp MvPolynomial.C = algebraMap A B →
    Function.Surjective π →
    RingHom.ker π = Ideal.span (Set.range F) →
    let J_B : Matrix (Fin (k + 1)) (Fin k) B :=
      Matrix.of fun i j => π (MvPolynomial.pderiv i (F j))
    let q_B : (Fin (k + 1) → B) →ₗ[B] KaehlerDifferential A B :=
      LinearMap.lsum B (fun _ : Fin (k + 1) => B) B fun r =>
        LinearMap.toSpanSingleton B (KaehlerDifferential A B)
          (KaehlerDifferential.D A B (π (MvPolynomial.X r)))
    Function.Surjective q_B ∧
    LinearMap.ker q_B = LinearMap.range J_B.mulVecLin := by
    intro A B _ _ _ k π F hπC hπ_surj hπ_ker J_B q_B
    let P : Type u := MvPolynomial (Fin (k + 1)) A
    letI : Algebra P B := π.toAlgebra
    have hπ_alg : algebraMap P B = π := rfl
    haveI : IsScalarTower A P B := IsScalarTower.of_algebraMap_eq' hπC.symm
    let bP : Module.Basis (Fin (k + 1)) P (KaehlerDifferential A P) :=
      KaehlerDifferential.mvPolynomialBasis A (Fin (k + 1))
    let α : (Fin (k + 1) → B) →ₗ[B] TensorProduct P B (KaehlerDifferential A P) :=
      LinearMap.lsum B (fun _ : Fin (k + 1) => B) B fun r =>
        LinearMap.toSpanSingleton B (TensorProduct P B (KaehlerDifferential A P))
          (TensorProduct.tmul P (1 : B) (bP r))
    have hα_apply : ∀ v : Fin (k + 1) → B,
        α v = ∑ r : Fin (k + 1), v r • TensorProduct.tmul P (1 : B) (bP r) := by
      intro v
      simp only [α, LinearMap.lsum_apply, LinearMap.sum_apply, LinearMap.comp_apply,
        LinearMap.proj_apply, LinearMap.toSpanSingleton_apply]
    have hqB_apply : ∀ v : Fin (k + 1) → B,
        q_B v = ∑ r : Fin (k + 1), v r • KaehlerDifferential.D A B (π (MvPolynomial.X r)) := by
      intro v
      simp only [q_B, LinearMap.lsum_apply, LinearMap.sum_apply, LinearMap.comp_apply,
        LinearMap.proj_apply, LinearMap.toSpanSingleton_apply]
    let β₀ : KaehlerDifferential A P →ₗ[P] (Fin (k + 1) → B) :=
      { toFun := fun ω r => π (bP.repr ω r)
        map_add' := fun ω₁ ω₂ => by
          ext r; simp only [map_add, Finsupp.add_apply, Pi.add_apply]
        map_smul' := fun p ω => by
          ext r
          simp only [map_smul, Finsupp.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply,
            Pi.smul_apply]
          rfl }
    let β : TensorProduct P B (KaehlerDifferential A P) →ₗ[B] (Fin (k + 1) → B) :=
      LinearMap.liftBaseChange B β₀
    have hβα : ∀ v : Fin (k + 1) → B, β (α v) = v := by
      intro v
      rw [hα_apply, map_sum]
      ext s
      simp only [map_smul, β, LinearMap.liftBaseChange_tmul, one_smul, Finset.sum_apply,
        Pi.smul_apply, smul_eq_mul]
      have h_term : ∀ r : Fin (k + 1),
          v r * β₀ (bP r) s = if r = s then v s else 0 := by
        intro r
        change v r * π ((bP.repr (bP r)) s) = if r = s then v s else 0
        rw [Module.Basis.repr_self, Finsupp.single_apply]
        split_ifs with hrs
        · subst hrs; simp
        · simp
      simp_rw [h_term]
      simp
    have hαβ : ∀ z : TensorProduct P B (KaehlerDifferential A P), α (β z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b ω =>
        change α (LinearMap.liftBaseChange B β₀ (TensorProduct.tmul P b ω)) = _
        rw [LinearMap.liftBaseChange_tmul, map_smul]
        have h1 : α (β₀ ω) = TensorProduct.tmul P (1 : B) ω := by
          rw [hα_apply]
          have h_each : ∀ r : Fin (k + 1),
              β₀ ω r • TensorProduct.tmul P (1 : B) (bP r) =
              TensorProduct.tmul P (1 : B) ((bP.repr ω r) • bP r) := by
            intro r
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            have hp : β₀ ω r = (bP.repr ω r) • (1 : B) := by
              change π ((bP.repr ω) r) = π ((bP.repr ω) r) * 1
              exact (mul_one _).symm
            rw [hp, TensorProduct.smul_tmul]
          simp_rw [h_each, ← TensorProduct.tmul_sum, Module.Basis.sum_repr bP ω]
        rw [h1, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      | add z₁ z₂ hz₁ hz₂ => simp only [map_add, hz₁, hz₂]
    have h_mbc_α : ∀ v : Fin (k + 1) → B,
        KaehlerDifferential.mapBaseChange A P B (α v) = q_B v := by
      intro v
      rw [hα_apply, hqB_apply, map_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_smul, KaehlerDifferential.mapBaseChange_tmul, one_smul]
      have hbP : bP r = KaehlerDifferential.D A P (MvPolynomial.X r) :=
        KaehlerDifferential.mvPolynomialBasis_apply A (Fin (k + 1)) r
      rw [hbP, KaehlerDifferential.map_D, hπ_alg]
    have hqB_surj : Function.Surjective q_B := by
      rw [← LinearMap.range_eq_top, eq_top_iff, ← KaehlerDifferential.span_range_derivation A B,
        Submodule.span_le]
      rintro _ ⟨b, rfl⟩
      obtain ⟨f, rfl⟩ := hπ_surj b
      refine ⟨β (TensorProduct.tmul P (1 : B) (KaehlerDifferential.D A P f)), ?_⟩
      rw [← h_mbc_α, hαβ, KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.map_D, hπ_alg]
    refine ⟨hqB_surj, ?_⟩
    ext v
    rw [LinearMap.mem_ker, ← h_mbc_α]
    have h_ex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange A P B hπ_surj (α v)
    rw [h_ex]
    constructor
    · rintro ⟨c, hc⟩
      have hc_top : c ∈ (RingHom.ker (algebraMap P B)).toCotangent.range := by
        rw [Ideal.toCotangent_range]; trivial
      rcases LinearMap.mem_range.mp hc_top with ⟨⟨f, hf⟩, rfl⟩
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hc
      have hv_eq : v = fun r : Fin (k + 1) => π (MvPolynomial.pderiv r f) := by
        have hβc := congrArg β hc
        rw [hβα, LinearMap.liftBaseChange_tmul, one_smul] at hβc
        rw [← hβc]
        ext r
        change π ((bP.repr (KaehlerDifferential.D A P f)) r) = π (MvPolynomial.pderiv r f)
        rw [KaehlerDifferential.mvPolynomialBasis_repr_apply]
      have hf_span : f ∈ Ideal.span (Set.range F) := by
        have hf' : f ∈ RingHom.ker π := hf
        rwa [hπ_ker] at hf'
      have h_ind : ∀ {x : P}, x ∈ Ideal.span (Set.range F) →
          π x = 0 ∧ (fun r : Fin (k + 1) => π (MvPolynomial.pderiv r x)) ∈
            LinearMap.range J_B.mulVecLin := by
        intro x hx
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
        · rintro x ⟨j, rfl⟩
          have hFj_ker : F j ∈ RingHom.ker π := by
            rw [hπ_ker]; exact Ideal.subset_span ⟨j, rfl⟩
          refine ⟨hFj_ker, ⟨Pi.single j 1, ?_⟩⟩
          ext r
          simp [Matrix.mulVecLin_apply, Matrix.mulVec_single_one, J_B]
        · refine ⟨map_zero π, ⟨0, ?_⟩⟩
          ext r; simp
        · intro x₁ x₂ _ _ hx₁ hx₂
          refine ⟨by rw [map_add, hx₁.1, hx₂.1, add_zero], ?_⟩
          have h_add : (fun r : Fin (k + 1) => π (MvPolynomial.pderiv r (x₁ + x₂))) =
              (fun r => π (MvPolynomial.pderiv r x₁)) +
              (fun r => π (MvPolynomial.pderiv r x₂)) := by
            ext r; simp [map_add]
          rw [h_add]
          exact Submodule.add_mem _ hx₁.2 hx₂.2
        · intro a x _ hx
          change π (a * x) = 0 ∧
            (fun r : Fin (k + 1) => π (MvPolynomial.pderiv r (a * x))) ∈
              LinearMap.range J_B.mulVecLin
          refine ⟨by rw [map_mul, hx.1, mul_zero], ?_⟩
          have h_smul : (fun r : Fin (k + 1) => π (MvPolynomial.pderiv r (a * x))) =
              (π a) • (fun r : Fin (k + 1) => π (MvPolynomial.pderiv r x)) := by
            ext r
            rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hx.1, mul_zero, zero_add]
            rfl
          rw [h_smul]
          exact Submodule.smul_mem _ (π a) hx.2
      rw [hv_eq]
      exact (h_ind hf_span).2
    · rintro ⟨w, rfl⟩
      choose c hc using fun j : Fin k => hπ_surj (w j)
      let f : P := ∑ j : Fin k, c j * F j
      have hf_ker : f ∈ RingHom.ker (algebraMap P B) := by
        change f ∈ RingHom.ker π
        rw [hπ_ker]
        exact Submodule.sum_mem _ fun j _ =>
          Ideal.mul_mem_left _ (c j) (Ideal.subset_span ⟨j, rfl⟩)
      refine ⟨(RingHom.ker (algebraMap P B)).toCotangent ⟨f, hf_ker⟩, ?_⟩
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
      apply (Function.LeftInverse.injective hαβ)
      rw [hβα]
      change LinearMap.liftBaseChange B β₀ _ = _
      rw [LinearMap.liftBaseChange_tmul, one_smul]
      ext r
      change π ((bP.repr (KaehlerDifferential.D A P f)) r) = (J_B.mulVecLin w) r
      rw [KaehlerDifferential.mvPolynomialBasis_repr_apply]
      simp only [f, map_sum, MvPolynomial.pderiv_mul, map_add, map_mul, Matrix.mulVecLin_apply,
        Matrix.mulVec, dotProduct, J_B, Matrix.of_apply]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hFj0 : π (F j) = 0 := by
        change F j ∈ RingHom.ker π
        rw [hπ_ker]; exact Ideal.subset_span ⟨j, rfl⟩
      rw [hFj0, mul_zero, zero_add, hc j, mul_comm]

  have hConj2 : ∀ (A B A' D : Type u) [CommRing A] [CommRing B] [CommRing A'] [CommRing D]
      [Algebra A B] [Algebra A' D] [Algebra A A'] [Algebra B D] [Algebra A D]
      [IsScalarTower A B D] [IsScalarTower A A' D],
    (Algebra.FormallyUnramified A A' ∧ Algebra.FormallyEtale B D) ∨
      Algebra.IsPushout A A' B D →
    (∃ e_Ω : TensorProduct B D (KaehlerDifferential A B) ≃ₗ[D] KaehlerDifferential A' D,
      ∀ (d : D) (b : B),
        e_Ω (TensorProduct.tmul B d (KaehlerDifferential.D A B b)) =
          d • KaehlerDifferential.D A' D (algebraMap B D b)) ∧
    ∀ (k : ℕ) (x_B : Fin (k + 1) → B) (J_B : Matrix (Fin (k + 1)) (Fin k) B),
      let q_B : (Fin (k + 1) → B) →ₗ[B] KaehlerDifferential A B :=
        LinearMap.lsum B (fun _ : Fin (k + 1) => B) B fun r =>
          LinearMap.toSpanSingleton B (KaehlerDifferential A B)
            (KaehlerDifferential.D A B (x_B r))
      let J_D : Matrix (Fin (k + 1)) (Fin k) D := J_B.map (algebraMap B D)
      let q_D : (Fin (k + 1) → D) →ₗ[D] KaehlerDifferential A' D :=
        LinearMap.lsum D (fun _ : Fin (k + 1) => D) D fun r =>
          LinearMap.toSpanSingleton D (KaehlerDifferential A' D)
            (KaehlerDifferential.D A' D (algebraMap B D (x_B r)))
      Function.Surjective q_B →
      LinearMap.ker q_B = LinearMap.range J_B.mulVecLin →
      Function.Surjective q_D ∧
      LinearMap.ker q_D = LinearMap.range J_D.mulVecLin := by
    intro A B A' D _ _ _ _ _ _ _ _ _ _ _ hHyp
    have hex_e : ∃ e_Ω : TensorProduct B D (KaehlerDifferential A B) ≃ₗ[D] KaehlerDifferential A' D,
        ∀ (d : D) (b : B),
          e_Ω (TensorProduct.tmul B d (KaehlerDifferential.D A B b)) =
            d • KaehlerDifferential.D A' D (algebraMap B D b) := by
      rcases hHyp with ⟨hUnram, hEt⟩ | hPush
      · haveI : Algebra.FormallyUnramified A A' := hUnram
        haveI : Algebra.FormallyEtale B D := hEt
        let e₁ : TensorProduct B D (KaehlerDifferential A B) ≃ₗ[D] KaehlerDifferential A D :=
          KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A B D
        let m : KaehlerDifferential A D →ₗ[D] KaehlerDifferential A' D :=
          KaehlerDifferential.map A A' D D
        have hm_surj : Function.Surjective m := by
          rw [← LinearMap.range_eq_top, eq_top_iff,
            ← KaehlerDifferential.span_range_derivation A' D, Submodule.span_le]
          rintro _ ⟨x, rfl⟩
          refine ⟨KaehlerDifferential.D A D x, ?_⟩
          simpa [m] using KaehlerDifferential.map_D A A' D D x
        have hm_inj : Function.Injective m := by
          have hz_zero : ∀ z : TensorProduct A' D (KaehlerDifferential A A'), z = 0 := by
            intro z
            induction z using TensorProduct.induction_on with
            | zero => rfl
            | tmul d ω => rw [Subsingleton.elim ω 0, TensorProduct.tmul_zero]
            | add z₁ z₂ hz₁ hz₂ => rw [hz₁, hz₂, add_zero]
          rw [← LinearMap.ker_eq_bot, eq_bot_iff]
          intro x hx
          rw [LinearMap.mem_ker] at hx
          rcases (KaehlerDifferential.exact_mapBaseChange_map A A' D x).mp hx with ⟨z, rfl⟩
          rw [hz_zero z, map_zero]
          rfl
        let e₂ : KaehlerDifferential A D ≃ₗ[D] KaehlerDifferential A' D :=
          LinearEquiv.ofBijective m ⟨hm_inj, hm_surj⟩
        refine ⟨e₁.trans e₂, fun d b => ?_⟩
        change e₂ (e₁ (TensorProduct.tmul B d (KaehlerDifferential.D A B b))) = _
        rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
          KaehlerDifferential.mapBaseChange_tmul, map_smul]
        change d • m ((KaehlerDifferential.map A A B D) ((KaehlerDifferential.D A B) b)) = _
        simp only [m, KaehlerDifferential.map_D]
        rfl
      · haveI : Algebra.IsPushout A A' B D := hPush
        refine ⟨KaehlerDifferential.tensorKaehlerEquiv A A' B D, fun d b => ?_⟩
        exact KaehlerDifferential.tensorKaehlerEquiv_tmul_D A A' B D d b
    refine ⟨hex_e, ?_⟩
    obtain ⟨e_Ω, he_Ω⟩ := hex_e
    intro k x_B J_B q_B J_D q_D hqB_surj hqB_ker
    have hqB_apply : ∀ u : Fin (k + 1) → B,
        q_B u = ∑ r : Fin (k + 1), u r • KaehlerDifferential.D A B (x_B r) := by
      intro u
      simp only [q_B, LinearMap.lsum_apply, LinearMap.sum_apply, LinearMap.comp_apply,
        LinearMap.proj_apply, LinearMap.toSpanSingleton_apply]
    have hqD_apply : ∀ v : Fin (k + 1) → D,
        q_D v = ∑ r : Fin (k + 1),
          v r • KaehlerDifferential.D A' D (algebraMap B D (x_B r)) := by
      intro v
      simp only [q_D, LinearMap.lsum_apply, LinearMap.sum_apply, LinearMap.comp_apply,
        LinearMap.proj_apply, LinearMap.toSpanSingleton_apply]
    have he_q : ∀ (d : D) (u : Fin (k + 1) → B),
        e_Ω (TensorProduct.tmul B d (q_B u)) =
          q_D (fun r => d * algebraMap B D (u r)) := by
      intro d u
      rw [hqB_apply, hqD_apply, TensorProduct.tmul_sum, map_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      have hud : (u r) • d = d * algebraMap B D (u r) := by
        rw [Algebra.smul_def, mul_comm]
      rw [← TensorProduct.smul_tmul (u r) d, he_Ω, hud]
    have hqD_surj : Function.Surjective q_D := by
      intro y
      suffices h_mem : ∀ z : TensorProduct B D (KaehlerDifferential A B),
          e_Ω z ∈ LinearMap.range q_D by
        simpa using h_mem (e_Ω.symm y)
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul d ω =>
        obtain ⟨u, rfl⟩ := hqB_surj ω
        exact ⟨fun r => d * algebraMap B D (u r), (he_q d u).symm⟩
      | add z₁ z₂ hz₁ hz₂ =>
        rw [map_add]
        exact Submodule.add_mem _ hz₁ hz₂
    refine ⟨hqD_surj, le_antisymm ?_ ?_⟩
    · intro v hv
      rw [LinearMap.mem_ker] at hv
      let R_D : Submodule D (Fin (k + 1) → D) := LinearMap.range J_D.mulVecLin
      let Q_D : Type u := (Fin (k + 1) → D) ⧸ R_D
      let α_B : (Fin (k + 1) → B) →ₗ[B] Q_D :=
        { toFun := fun u => R_D.mkQ (fun r => algebraMap B D (u r))
          map_add' := fun u₁ u₂ => by
            have h_eq : (fun r => algebraMap B D ((u₁ + u₂) r)) =
                (fun r => algebraMap B D (u₁ r)) + (fun r => algebraMap B D (u₂ r)) := by
              ext r; simp [map_add]
            rw [h_eq, map_add]
          map_smul' := fun b u => by
            have h_eq : (fun r => algebraMap B D ((b • u) r)) =
                (algebraMap B D b) • (fun r => algebraMap B D (u r)) := by
              ext r; simp [map_mul]
            rw [h_eq, map_smul, RingHom.id_apply, algebraMap_smul] }
      have h_ker_le : LinearMap.ker q_B ≤ LinearMap.ker α_B := by
        rw [hqB_ker]
        rintro _ ⟨w, rfl⟩
        rw [LinearMap.mem_ker]
        change R_D.mkQ (fun r => algebraMap B D ((J_B.mulVecLin w) r)) = 0
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        refine ⟨fun j => algebraMap B D (w j), ?_⟩
        ext r
        simp [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, J_D, map_sum, map_mul]
      let bar_α : KaehlerDifferential A B →ₗ[B] Q_D :=
        (Submodule.liftQ (LinearMap.ker q_B) α_B h_ker_le).comp
          (q_B.quotKerEquivOfSurjective hqB_surj).symm.toLinearMap
      have hbar_α : ∀ u : Fin (k + 1) → B, bar_α (q_B u) = α_B u := by
        intro u
        have hq_symm : (q_B.quotKerEquivOfSurjective hqB_surj).symm (q_B u) =
            (LinearMap.ker q_B).mkQ u := by
          apply (q_B.quotKerEquivOfSurjective hqB_surj).injective
          simp
        simp only [bar_α, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap, hq_symm,
          Submodule.mkQ_apply, Submodule.liftQ_apply]
      let β_D : TensorProduct B D (KaehlerDifferential A B) →ₗ[D] Q_D :=
        LinearMap.liftBaseChange D bar_α
      have he_symm_qD : e_Ω.symm (q_D v) =
          ∑ r : Fin (k + 1), TensorProduct.tmul B (v r) (q_B (Pi.single r 1)) := by
        apply e_Ω.injective
        rw [LinearEquiv.apply_symm_apply, hqD_apply, map_sum]
        refine Finset.sum_congr rfl fun r _ => ?_
        have h_single : q_B (Pi.single r 1) = KaehlerDifferential.D A B (x_B r) := by
          rw [hqB_apply]
          rw [Finset.sum_eq_single r]
          · simp
          · intro s _ hsr; simp [Pi.single_eq_of_ne hsr]
          · intro hr; exact absurd (Finset.mem_univ r) hr
        rw [h_single, he_Ω]
      have hβ_eq : β_D (e_Ω.symm (q_D v)) = R_D.mkQ v := by
        rw [he_symm_qD, map_sum]
        have h_each : ∀ r : Fin (k + 1),
            β_D (TensorProduct.tmul B (v r) (q_B (Pi.single r 1))) =
              R_D.mkQ (v r • Pi.single r 1) := by
          intro r
          simp only [β_D, LinearMap.liftBaseChange_tmul, hbar_α, α_B, LinearMap.coe_mk,
            AddHom.coe_mk, ← map_smul]
          congr 1
          ext s
          by_cases hsr : s = r
          · subst hsr; simp
          · simp [Pi.single_eq_of_ne hsr]
        simp_rw [h_each, ← map_sum]
        congr 1
        ext s
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
        rw [Finset.sum_eq_single s]
        · simp
        · intro r _ hrs; simp [Pi.single_eq_of_ne (Ne.symm hrs)]
        · intro hs; exact absurd (Finset.mem_univ s) hs
      have hmk0 : R_D.mkQ v = 0 := by
        rw [← hβ_eq, hv, map_zero, map_zero]
      rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hmk0
    · rintro _ ⟨w, rfl⟩
      rw [LinearMap.mem_ker]
      have h_col : ∀ j : Fin k, q_D (fun r => J_D r j) = 0 := by
        intro j
        have h_in_ker : (fun r => J_B r j) ∈ LinearMap.ker q_B := by
          rw [hqB_ker]
          refine ⟨Pi.single j 1, ?_⟩
          ext r
          simp [Matrix.mulVecLin_apply, Matrix.mulVec_single_one]
        have h1 := he_q 1 (fun r => J_B r j)
        rw [LinearMap.mem_ker.mp h_in_ker, TensorProduct.tmul_zero, map_zero] at h1
        simpa [J_D] using h1.symm
      have hw_sum : J_D.mulVecLin w = ∑ j : Fin k, w j • (fun r => J_D r j) := by
        ext r
        simp [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, mul_comm]
      rw [hw_sum, map_sum]
      exact Finset.sum_eq_zero fun j _ => by rw [map_smul, h_col j, smul_zero]

  have hConj3 : ∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k : ℕ) (J : Matrix (Fin (k + 1)) (Fin k) B)
      (q : (Fin (k + 1) → B) →ₗ[B] Ω_mod),
    Function.Surjective q →
    LinearMap.ker q = LinearMap.range J.mulVecLin →
    ∃ ψ : Ω_mod →ₗ[B] B,
      ∀ v : Fin (k + 1) → B,
        ψ (q v) = ∑ r : Fin (k + 1),
          v r * (-1) ^ (r : ℕ) * Matrix.det (J.submatrix r.succAbove id) := by
    intro B _ Ω_mod _ _ k J q hq_surj hq_ker
    let Δ : Fin (k + 1) → B :=
      fun r => (-1) ^ (r : ℕ) * Matrix.det (J.submatrix r.succAbove id)
    let Φ : (Fin (k + 1) → B) →ₗ[B] B :=
      LinearMap.lsum B (fun _ : Fin (k + 1) => B) B fun r =>
        LinearMap.toSpanSingleton B B (Δ r)
    have hΦ_apply : ∀ v : Fin (k + 1) → B,
        Φ v = ∑ r : Fin (k + 1),
          v r * (-1) ^ (r : ℕ) * Matrix.det (J.submatrix r.succAbove id) := by
      intro v
      simp only [Φ, LinearMap.lsum_apply, LinearMap.sum_apply, LinearMap.comp_apply,
        LinearMap.proj_apply, LinearMap.toSpanSingleton_apply, smul_eq_mul, Δ, mul_assoc]
    have h_col_zero : ∀ c : Fin k, Φ (fun r => J r c) = 0 := by
      intro c
      let M : Matrix (Fin (k + 1)) (Fin (k + 1)) B :=
        Matrix.of fun r s => Fin.cases (J r c) (fun j => J r j) s
      have hM_det0 : M.det = 0 := by
        apply Matrix.det_zero_of_column_eq (Fin.succ_ne_zero c).symm
        intro r
        simp [M]
      have hM_exp : M.det = Φ (fun r => J r c) := by
        rw [Matrix.det_succ_column_zero, hΦ_apply]
        refine Finset.sum_congr rfl fun r _ => ?_
        have h_sub : M.submatrix r.succAbove Fin.succ = J.submatrix r.succAbove id := by
          ext i j
          simp [M]
        rw [h_sub]
        simp only [M, Matrix.of_apply, Fin.cases_zero]
        ring
      exact hM_exp.symm.trans hM_det0
    have h_ker_le : LinearMap.ker q ≤ LinearMap.ker Φ := by
      rw [hq_ker]
      rintro _ ⟨w, rfl⟩
      rw [LinearMap.mem_ker]
      have hw_sum : J.mulVecLin w = ∑ c : Fin k, w c • (fun r => J r c) := by
        ext r
        simp [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, mul_comm]
      rw [hw_sum, map_sum]
      exact Finset.sum_eq_zero fun c _ => by rw [map_smul, h_col_zero c, smul_zero]
    let ψ : Ω_mod →ₗ[B] B :=
      (Submodule.liftQ (LinearMap.ker q) Φ h_ker_le).comp
        (q.quotKerEquivOfSurjective hq_surj).symm.toLinearMap
    refine ⟨ψ, fun v => ?_⟩
    have hq_symm : (q.quotKerEquivOfSurjective hq_surj).symm (q v) =
        (LinearMap.ker q).mkQ v := by
      apply (q.quotKerEquivOfSurjective hq_surj).injective
      simp
    simp only [ψ, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap, hq_symm,
      Submodule.mkQ_apply, Submodule.liftQ_apply, hΦ_apply]

  have hConj4 : ∀ (R S_sm : Type u) [CommRing R] [CommRing S_sm] [Algebra R S_sm],
    Algebra.IsStandardSmoothOfRelativeDimension 1 R S_sm →
    ∃ (k₂ : ℕ) (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) S_sm)
      (q₂ : (Fin (k₂ + 1) → S_sm) →ₗ[S_sm] KaehlerDifferential R S_sm),
      Function.Surjective q₂ ∧
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin ∧
      Function.Injective J₂.mulVecLin ∧
      IsUnit (Matrix.det (J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id)) := by
    intro R S_sm _ _ _ hSm
    classical
    obtain ⟨ι, σ, hFinσ, hFinι, P, hDim⟩ := hSm.out
    letI : Finite σ := hFinσ
    letI : Finite ι := hFinι
    letI : Fintype σ := Fintype.ofFinite σ
    letI : Fintype ι := Fintype.ofFinite ι
    have hDim' : Fintype.card ι - Fintype.card σ = 1 := by
      change Nat.card ι - Nat.card σ = 1 at hDim
      rwa [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card] at hDim
    let k₂ : ℕ := Fintype.card σ
    have hCard_ι : Fintype.card ι = k₂ + 1 := by
      change Fintype.card ι = Fintype.card σ + 1
      omega
    let s_map : Finset ι := Finset.univ.image P.map
    have hs_card : s_map.card = k₂ := by
      rw [Finset.card_image_of_injective _ P.map_inj, Finset.card_univ]
    have hcompl_card : s_mapᶜ.card = 1 := by
      rw [Finset.card_compl, hCard_ι, hs_card]
      omega
    obtain ⟨i₀, hi₀_eq⟩ := Finset.card_eq_one.mp hcompl_card
    have hi₀_not : ∀ s : σ, P.map s ≠ i₀ := by
      intro s hs
      have h_in_compl : i₀ ∈ s_mapᶜ := by rw [hi₀_eq]; exact Finset.mem_singleton_self i₀
      have h_in_s : i₀ ∈ s_map := Finset.mem_image.mpr ⟨s, Finset.mem_univ s, hs⟩
      exact (Finset.mem_compl.mp h_in_compl) h_in_s
    let f : Fin k₂ ≃ σ := (Fintype.equivFin σ).symm
    let g_ι : Fin (k₂ + 1) → ι := Fin.cases i₀ (fun j : Fin k₂ => P.map (f j))
    have hg_inj : Function.Injective g_ι := by
      intro a b
      refine Fin.cases ?_ ?_ a
      · refine Fin.cases ?_ ?_ b
        · intro _; rfl
        · intro j hj
          simp only [g_ι, Fin.cases_zero, Fin.cases_succ] at hj
          exact absurd hj.symm (hi₀_not (f j))
      · intro i
        refine Fin.cases ?_ ?_ b
        · intro hi
          simp only [g_ι, Fin.cases_zero, Fin.cases_succ] at hi
          exact absurd hi (hi₀_not (f i))
        · intro j hij
          simp only [g_ι, Fin.cases_succ] at hij
          exact congrArg Fin.succ (f.injective (P.map_inj hij))
    have hg_bij : Function.Bijective g_ι := by
      rw [Fintype.bijective_iff_injective_and_card]
      exact ⟨hg_inj, by rw [Fintype.card_fin, hCard_ι]⟩
    let e : Fin (k₂ + 1) ≃ ι := Equiv.ofBijective g_ι hg_bij
    let P' : Algebra.SubmersivePresentation R S_sm (Fin (k₂ + 1)) (Fin k₂) := P.reindex e f
    let π₂ : MvPolynomial (Fin (k₂ + 1)) R →+* S_sm := algebraMap P'.Ring S_sm
    let F₂ : Fin k₂ → MvPolynomial (Fin (k₂ + 1)) R := P'.relation
    have hπ₂C : π₂.comp MvPolynomial.C = algebraMap R S_sm := by
      ext r
      exact (IsScalarTower.algebraMap_apply R P'.Ring S_sm r).symm
    have hπ₂_surj : Function.Surjective π₂ := P'.algebraMap_surjective
    have hπ₂_ker : RingHom.ker π₂ = Ideal.span (Set.range F₂) :=
      P'.span_range_relation_eq_ker.symm
    let J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) S_sm :=
      Matrix.of fun i j => π₂ (MvPolynomial.pderiv i (F₂ j))
    let q₂ : (Fin (k₂ + 1) → S_sm) →ₗ[S_sm] KaehlerDifferential R S_sm :=
      LinearMap.lsum S_sm (fun _ : Fin (k₂ + 1) => S_sm) S_sm fun r =>
        LinearMap.toSpanSingleton S_sm (KaehlerDifferential R S_sm)
          (KaehlerDifferential.D R S_sm (π₂ (MvPolynomial.X r)))
    obtain ⟨hq₂_surj, hq₂_ker⟩ := hConj1 R S_sm k₂ π₂ F₂ hπ₂C hπ₂_surj hπ₂_ker
    have hM₀_eq : J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id =
        π₂.mapMatrix P'.jacobiMatrix := by
      ext i j
      have hmap_i : P'.map i = (0 : Fin (k₂ + 1)).succAbove i := by
        change (P.toPreSubmersivePresentation.reindex e f).map i = _
        rw [Algebra.PreSubmersivePresentation.reindex_map]
        simp only [Function.comp_apply]
        have he_succ : e ((0 : Fin (k₂ + 1)).succAbove i) = P.map (f i) := by
          simp [e, g_ι, Fin.succAbove_zero]
        rw [← he_succ, Equiv.symm_apply_apply]
      simp only [Matrix.submatrix_apply, id_eq, J₂, Matrix.of_apply, RingHom.mapMatrix_apply,
        Matrix.map_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply, hmap_i, F₂]
    have hM₀_unit : IsUnit (Matrix.det (J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id)) := by
      rw [hM₀_eq, ← RingHom.map_det]
      have hjac : π₂ P'.jacobiMatrix.det = P'.jacobian := by
        rw [← P'.jacobian_eq_jacobiMatrix_det]
      rw [hjac]
      exact P'.jacobian_isUnit
    have hJ₂_inj : Function.Injective J₂.mulVecLin := by
      intro w₁ w₂ hw
      let w : Fin k₂ → S_sm := w₁ - w₂
      have hw0 : J₂.mulVec w = 0 := by
        change J₂.mulVecLin (w₁ - w₂) = 0
        rw [map_sub, hw, sub_self]
      let M₀ : Matrix (Fin k₂) (Fin k₂) S_sm := J₂.submatrix (0 : Fin (k₂ + 1)).succAbove id
      have hM₀w : M₀.mulVec w = 0 := by
        ext i
        have hi := congrFun hw0 ((0 : Fin (k₂ + 1)).succAbove i)
        simpa [M₀, Matrix.mulVec, dotProduct] using hi
      have hdet_w : M₀.det • w = 0 := by
        have h_adj : (M₀.adjugate * M₀).mulVec w = 0 := by
          rw [← Matrix.mulVec_mulVec, hM₀w, Matrix.mulVec_zero]
        rw [Matrix.adjugate_mul] at h_adj
        ext i
        have hi := congrFun h_adj i
        have h1 := congrFun (Matrix.one_mulVec w) i
        simp only [Matrix.mulVec, dotProduct, Matrix.smul_apply, smul_eq_mul, mul_assoc,
          ← Finset.mul_sum, Pi.zero_apply] at hi h1
        rw [h1] at hi
        simpa [Pi.smul_apply, smul_eq_mul] using hi
      have hM₀_u : IsUnit M₀.det := hM₀_unit
      obtain ⟨u, hu⟩ := hM₀_u
      have hw_eq0 : w = 0 := by
        have h1 := congrArg ((u⁻¹ : S_smˣ).val • ·) hdet_w
        simp only [smul_smul, ← hu, Units.inv_mul, one_smul, smul_zero] at h1
        exact h1
      exact sub_eq_zero.mp hw_eq0
    exact ⟨k₂, J₂, q₂, hq₂_surj, hq₂_ker, hJ₂_inj, hM₀_unit⟩

  have hConj5 : ∀ (Ω A'' : Type u) [CommRing Ω] [CommRing A'']
      (φ₂ : (MvPolynomial (Fin 2) Ω ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) Ω))) →+* A''),
    RingHom.Flat φ₂ →
    let x₀ : A'' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
    let x₁ : A'' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
    let J_node : Matrix (Fin 2) (Fin 1) A'' :=
      Matrix.of fun (i : Fin 2) (_ : Fin 1) => Fin.cases x₁ (fun _ => x₀) i
    Function.Injective J_node.mulVecLin ∧
    (∀ [Algebra Ω A''],
      φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = algebraMap Ω A'' →
      RingHom.Etale φ₂ →
      let q_node : (Fin 2 → A'') →ₗ[A''] KaehlerDifferential Ω A'' :=
        LinearMap.lsum A'' (fun _ : Fin 2 => A'') A'' fun r =>
          LinearMap.toSpanSingleton A'' (KaehlerDifferential Ω A'')
            (KaehlerDifferential.D Ω A'' (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X r))))
      Function.Surjective q_node ∧
      LinearMap.ker q_node = LinearMap.range J_node.mulVecLin) := by
    intro Ω A'' _ _ φ₂ hFlat x₀ x₁ J_node
    let P₂ : Type u := MvPolynomial (Fin 2) Ω
    let I_node : Ideal P₂ := Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set P₂)
    let R_node : Type u := P₂ ⧸ I_node
    let π_node : P₂ →+* R_node := Ideal.Quotient.mk I_node
    have h_cancel_X : ∀ (i : Fin 2) (a b : P₂),
        MvPolynomial.X i * a = MvPolynomial.X i * b → a = b := by
      intro i a b hab
      ext m
      rw [← MvPolynomial.coeff_X_mul m i a, hab, MvPolynomial.coeff_X_mul m i b]
    have h_Rnode_inj : ∀ c : R_node,
        π_node (MvPolynomial.X 1) * c = 0 →
        π_node (MvPolynomial.X 0) * c = 0 → c = 0 := by
      intro c hc1 hc0
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective c
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hc1 hc0
      obtain ⟨g₁, hg₁⟩ := hc1
      obtain ⟨g₀, hg₀⟩ := hc0
      have hp1 : p = MvPolynomial.X 0 * g₁ := by
        apply h_cancel_X 1
        linear_combination hg₁
      have hp0 : p = MvPolynomial.X 1 * g₀ := by
        apply h_cancel_X 0
        linear_combination hg₀
      let ev₁ : P₂ →+* P₂ :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun i : Fin 2 => if i = 0 then MvPolynomial.X 0 else 0)
      have hev₁_C : ∀ a : Ω, ev₁ (MvPolynomial.C a) = MvPolynomial.C a := by
        intro a
        exact MvPolynomial.eval₂Hom_C _ _ a
      have hev₁_X0 : ev₁ (MvPolynomial.X 0) = MvPolynomial.X 0 := by
        change (MvPolynomial.eval₂Hom MvPolynomial.C
          (fun i : Fin 2 => if i = 0 then MvPolynomial.X 0 else 0)) (MvPolynomial.X 0) = _
        rw [MvPolynomial.eval₂Hom_X']
        simp
      have hev₁_X1 : ev₁ (MvPolynomial.X 1) = 0 := by
        change (MvPolynomial.eval₂Hom MvPolynomial.C
          (fun i : Fin 2 => if i = 0 then MvPolynomial.X 0 else 0)) (MvPolynomial.X 1) = _
        rw [MvPolynomial.eval₂Hom_X']
        simp
      have hev₁_g₁ : ev₁ g₁ = 0 := by
        apply h_cancel_X 0
        have h_eq := congrArg ev₁ (hp1.symm.trans hp0)
        rw [map_mul, map_mul, hev₁_X0, hev₁_X1, zero_mul] at h_eq
        rw [mul_zero]
        exact h_eq
      have h_div : ∀ f : P₂, ∃ q : P₂, f - ev₁ f = MvPolynomial.X 1 * q := by
        intro f
        induction f using MvPolynomial.induction_on with
        | C a =>
          refine ⟨0, ?_⟩
          rw [hev₁_C, sub_self, mul_zero]
        | add f₁ f₂ hf₁ hf₂ =>
          obtain ⟨q₁, hq₁⟩ := hf₁
          obtain ⟨q₂, hq₂⟩ := hf₂
          refine ⟨q₁ + q₂, ?_⟩
          rw [map_add]
          linear_combination hq₁ + hq₂
        | mul_X f' i hf' =>
          obtain ⟨q', hq'⟩ := hf'
          refine Fin.cases ?_ ?_ i
          · refine ⟨q' * MvPolynomial.X 0, ?_⟩
            rw [map_mul, hev₁_X0]
            linear_combination hq' * MvPolynomial.X (0 : Fin 2)
          · intro j
            have hj0 : j = 0 := Subsingleton.elim j 0
            subst hj0
            refine ⟨f', ?_⟩
            change f' * MvPolynomial.X 1 - ev₁ (f' * MvPolynomial.X 1) = MvPolynomial.X 1 * f'
            rw [map_mul, hev₁_X1, mul_zero, sub_zero, mul_comm]
      obtain ⟨q, hq⟩ := h_div g₁
      rw [hev₁_g₁, sub_zero] at hq
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton.mpr ⟨q, by rw [hp1, hq, mul_assoc]⟩
    have hJ_inj : Function.Injective J_node.mulVecLin := by
      letI : Algebra R_node A'' := φ₂.toAlgebra
      haveI : Module.Flat R_node A'' := hFlat
      let μ : R_node →ₗ[R_node] R_node × R_node :=
        (LinearMap.mulLeft R_node (π_node (MvPolynomial.X 1))).prod
          (LinearMap.mulLeft R_node (π_node (MvPolynomial.X 0)))
      have hμ_inj : Function.Injective μ := by
        rw [← LinearMap.ker_eq_bot, eq_bot_iff]
        intro c hc
        rw [LinearMap.mem_ker] at hc
        exact h_Rnode_inj c (congrArg Prod.fst hc) (congrArg Prod.snd hc)
      have hlT_inj : Function.Injective (LinearMap.lTensor A'' μ) :=
        Module.Flat.lTensor_preserves_injective_linearMap μ hμ_inj
      intro w₁ w₂ hw
      let a'' : A'' := w₁ 0 - w₂ 0
      have hw_sub : J_node.mulVec (w₁ - w₂) = 0 := by
        change J_node.mulVecLin (w₁ - w₂) = 0
        rw [map_sub, hw, sub_self]
      have hx₁a : x₁ * a'' = 0 := by
        have h0 := congrFun hw_sub 0
        simpa [J_node, Matrix.mulVec, dotProduct, a''] using h0
      have hcases1 : Fin.cases x₁ (fun _ : Fin 1 => x₀) (1 : Fin 2) = x₀ := by
        change Fin.cases x₁ (fun _ : Fin 1 => x₀) (Fin.succ 0) = x₀
        simp only [Fin.cases_succ]
      have hx₀a : x₀ * a'' = 0 := by
        have h1 := congrFun hw_sub 1
        simpa [J_node, Matrix.mulVec, dotProduct, a'', hcases1] using h1
      have h_tmul0 : TensorProduct.tmul R_node a'' (1 : R_node) = 0 := by
        apply hlT_inj
        rw [map_zero, LinearMap.lTensor_tmul]
        have hμ1 : μ 1 =
            (π_node (MvPolynomial.X 1)) • ((1 : R_node), (0 : R_node)) +
            (π_node (MvPolynomial.X 0)) • ((0 : R_node), (1 : R_node)) := by
          ext <;> simp [μ]
        rw [hμ1, TensorProduct.tmul_add,
          ← TensorProduct.smul_tmul (π_node (MvPolynomial.X 1)) a'',
          ← TensorProduct.smul_tmul (π_node (MvPolynomial.X 0)) a'']
        have hs1 : (π_node (MvPolynomial.X 1)) • a'' = x₁ * a'' := rfl
        have hs0 : (π_node (MvPolynomial.X 0)) • a'' = x₀ * a'' := rfl
        rw [hs1, hs0, hx₁a, hx₀a, TensorProduct.zero_tmul, TensorProduct.zero_tmul, add_zero]
      let m_lid : TensorProduct R_node A'' R_node →ₗ[A''] A'' :=
        LinearMap.liftBaseChange A'' (Algebra.linearMap R_node A'')
      have ha''0 : a'' = 0 := by
        have hm := congrArg m_lid h_tmul0
        simpa [m_lid, LinearMap.liftBaseChange_tmul] using hm
      ext j
      have hj0 : j = 0 := Subsingleton.elim j 0
      subst hj0
      exact sub_eq_zero.mp ha''0
    refine ⟨hJ_inj, ?_⟩
    intro _ hAlgEq hEt q_node
    let F_node : Fin 1 → P₂ := fun _ => MvPolynomial.X 0 * MvPolynomial.X 1
    have hπ_C : π_node.comp MvPolynomial.C = algebraMap Ω R_node := rfl
    have hπ_surj : Function.Surjective π_node := Ideal.Quotient.mk_surjective
    have hπ_ker : RingHom.ker π_node = Ideal.span (Set.range F_node) := by
      rw [Ideal.mk_ker]
      have hrange : Set.range F_node = {MvPolynomial.X 0 * MvPolynomial.X 1} := by
        ext p
        simp [F_node]
      rw [hrange]
    obtain ⟨hqR_surj, hqR_ker⟩ := hConj1 Ω R_node 1 π_node F_node hπ_C hπ_surj hπ_ker
    let J_R : Matrix (Fin 2) (Fin 1) R_node :=
      Matrix.of fun i j => π_node (MvPolynomial.pderiv i (F_node j))
    letI : Algebra R_node A'' := φ₂.toAlgebra
    haveI : IsScalarTower Ω R_node A'' := ⟨fun c r a => by
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
      have h_lhs : (c • π_node p) • a = φ₂ (π_node (c • p)) * a := rfl
      have h_rhs : c • (π_node p • a) = c • (φ₂ (π_node p) * a) := rfl
      rw [h_lhs, h_rhs, Algebra.smul_def c p, Algebra.smul_def c (φ₂ (π_node p) * a),
        map_mul, map_mul, mul_assoc]
      have hc_eq : φ₂ (π_node (algebraMap Ω P₂ c)) = algebraMap Ω A'' c :=
        DFunLike.congr_fun hAlgEq c
      rw [hc_eq]⟩
    have hEt_alg : Algebra.Etale R_node A'' := RingHom.etale_algebraMap.mp hEt
    haveI : Algebra.FormallyEtale R_node A'' := hEt_alg.formallyEtale
    obtain ⟨hq_surj, hq_ker⟩ :=
      (hConj2 Ω R_node Ω A'' (Or.inl ⟨inferInstance, inferInstance⟩)).2
        1 (fun r => π_node (MvPolynomial.X r)) J_R hqR_surj hqR_ker
    have hpderiv0 : MvPolynomial.pderiv (0 : Fin 2)
        (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) Ω) =
        MvPolynomial.X 1 := by
      rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self,
        MvPolynomial.pderiv_X_of_ne (by decide : (1 : Fin 2) ≠ 0)]
      ring
    have hpderiv1 : MvPolynomial.pderiv (1 : Fin 2)
        (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) Ω) =
        MvPolynomial.X 0 := by
      rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self,
        MvPolynomial.pderiv_X_of_ne (by decide : (0 : Fin 2) ≠ 1)]
      ring
    have hJ_map : J_R.map (algebraMap R_node A'') = J_node := by
      ext i j
      have hj0 : j = 0 := Subsingleton.elim j 0
      subst hj0
      refine Fin.cases ?_ ?_ i
      · simp only [Matrix.map_apply, J_R, J_node, Matrix.of_apply, F_node, Fin.cases_zero]
        rw [hpderiv0]
        rfl
      · intro k_i
        have hk0 : k_i = 0 := Subsingleton.elim k_i 0
        subst hk0
        simp only [Matrix.map_apply, J_R, J_node, Matrix.of_apply, F_node, Fin.cases_succ]
        change (algebraMap R_node A'')
          (π_node ((MvPolynomial.pderiv (1 : Fin 2)) (MvPolynomial.X 0 * MvPolynomial.X 1))) = x₀
        rw [hpderiv1]
        rfl
    rw [hJ_map] at hq_ker
    exact ⟨hq_surj, hq_ker⟩

  have hConj6 : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S),
    RingHom.Flat φ →
    (∀ (Q : Ideal S) [Q.IsPrime] (P : Ideal R) [P.IsPrime],
      P = Ideal.comap φ Q →
      ∀ r : R, φ r = 0 → algebraMap R (Localization.AtPrime P) r = 0) ∧
    (∀ t : R, (∀ r : R, r * t = 0 → r = 0) → ∀ s : S, s * φ t = 0 → s = 0) := by
    intro R S _ _ φ hFlat
    refine ⟨?_, ?_⟩
    · intro Q _ P _ hPQ r hφr
      let f_loc : Localization.AtPrime P →+* Localization.AtPrime Q :=
        Localization.localRingHom P Q φ hPQ
      have hf_flat : f_loc.Flat := hFlat.localRingHom Q P hPQ
      have hf_loc : IsLocalHom f_loc := Localization.isLocalHom_localRingHom P Q φ hPQ
      letI : Algebra (Localization.AtPrime P) (Localization.AtPrime Q) := f_loc.toAlgebra
      haveI : Module.Flat (Localization.AtPrime P) (Localization.AtPrime Q) := hf_flat
      haveI : IsLocalHom (algebraMap (Localization.AtPrime P) (Localization.AtPrime Q)) := hf_loc
      haveI : Module.FaithfullyFlat (Localization.AtPrime P) (Localization.AtPrime Q) :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      have hf_ff : f_loc.FaithfullyFlat :=
        RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
      have hinj : Function.Injective f_loc := hf_ff.injective
      apply hinj
      rw [map_zero, Localization.localRingHom_to_map, hφr, map_zero]
    · intro t ht s hs
      letI : Algebra R S := φ.toAlgebra
      haveI : Module.Flat R S := hFlat
      let μ_t : R →ₗ[R] R := LinearMap.mulRight R t
      have hμ_inj : Function.Injective μ_t := by
        intro r₁ r₂ hr
        have h_sub : (r₁ - r₂) * t = 0 := by
          rw [sub_mul]
          exact sub_eq_zero.mpr hr
        exact sub_eq_zero.mp (ht (r₁ - r₂) h_sub)
      have hlT_inj : Function.Injective (LinearMap.lTensor S μ_t) :=
        Module.Flat.lTensor_preserves_injective_linearMap μ_t hμ_inj
      have h_tmul0 : TensorProduct.tmul R s (1 : R) = 0 := by
        apply hlT_inj
        rw [map_zero, LinearMap.lTensor_tmul]
        change TensorProduct.tmul R s (1 * t) = 0
        rw [one_mul]
        have h_eq : TensorProduct.tmul R s t = TensorProduct.tmul R s (t • (1 : R)) := by simp
        rw [h_eq, ← TensorProduct.smul_tmul t s (1 : R)]
        have hts : t • s = s * φ t := by
          change φ t * s = s * φ t
          exact mul_comm _ _
        rw [hts, hs, TensorProduct.zero_tmul]
      let m_lid : TensorProduct R S R →ₗ[S] S :=
        LinearMap.liftBaseChange S (Algebra.linearMap R S)
      have hm := congrArg m_lid h_tmul0
      simpa [m_lid, LinearMap.liftBaseChange_tmul] using hm

  exact ⟨hConj1, hConj2, hConj3, hConj4, hConj5, hConj6⟩

theorem weil_separated_affine_inter_and_fiber_pushout : HasWeilSeparatedAffineAndFiberPushout.{u} :=
by
  have etale_imp_flat : ∀ {R S : Type u} [CommRing R] [CommRing S] {φ : R →+* S},
      RingHom.Etale φ → RingHom.Flat φ := by
    intro R S _ _ φ hEt
    exact ((RingHom.etale_iff_formallyUnramified_and_smooth φ).mp hEt).2.flat
  have congr_appLE : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X ⟶ Y} (h : f₁ = f₂)
      (U : Y.Opens) (V : X.Opens)
      (e₁ : V ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (e₂ : V ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      f₁.appLE U V e₁ = f₂.appLE U V e₂ := by
    intro X Y f₁ f₂ h U V e₁ e₂
    subst h
    rfl
  have presheaf_map_comp₂ : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {A B C : Z.Opens}
      (i₁ : Opposite.op A ⟶ Opposite.op B)
      (i₂ : Opposite.op B ⟶ Opposite.op C)
      (j : Opposite.op A ⟶ Opposite.op C),
      Z.presheaf.map i₁ ≫ Z.presheaf.map i₂ = Z.presheaf.map j :=
    fun Z _ _ _ i₁ i₂ j =>
      (Z.presheaf.map_comp i₁ i₂).symm.trans (congrArg Z.presheaf.map (Subsingleton.elim _ j))
  have presheaf_map_comp₃ : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {A B C D : Z.Opens}
      (i₁ : Opposite.op A ⟶ Opposite.op B)
      (i₂ : Opposite.op B ⟶ Opposite.op C)
      (i₃ : Opposite.op C ⟶ Opposite.op D)
      (j : Opposite.op A ⟶ Opposite.op D),
      Z.presheaf.map i₁ ≫ Z.presheaf.map i₂ ≫ Z.presheaf.map i₃ = Z.presheaf.map j :=
    fun Z _ _ _ _ i₁ i₂ i₃ j =>
      (Z.presheaf.map i₁ ≫= presheaf_map_comp₂ Z i₂ i₃ (i₂ ≫ i₃)).trans
        (presheaf_map_comp₂ Z i₁ (i₂ ≫ i₃) j)
  have restrict_appTop_eq_appLE : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens),
      U.topIso.inv ≫ (f ∣_ U).appTop ≫
        (AlgebraicGeometry.Scheme.Opens.topIso ((TopologicalSpace.Opens.map f.base).obj U)).hom =
        f.appLE U ((TopologicalSpace.Opens.map f.base).obj U) (le_refl _) := by
    intro X Y f U
    let W : X.Opens := (TopologicalSpace.Opens.map f.base).obj U
    refine (U.topIso_inv =≫ ((f ∣_ U).appTop ≫ W.topIso.hom)).trans ?_
    refine (_ ≫= ((AlgebraicGeometry.morphismRestrict_appTop f U =≫ W.topIso.hom).trans
      (_ ≫= W.topIso_hom))).trans ?_
    refine (_ ≫= Category.assoc _ _ _).trans ?_
    refine (AlgebraicGeometry.Scheme.Hom.naturality_assoc f _ _).trans ?_
    exact f.app U ≫= presheaf_map_comp₃ X _ _ _ (CategoryTheory.homOfLE (le_refl W)).op
  have homOfLE_appTop_eq : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : X.Opens} (hU : U₂ ≤ U₁),
      U₁.topIso.inv ≫ (X.homOfLE hU).appTop ≫ U₂.topIso.hom =
        X.presheaf.map (CategoryTheory.homOfLE hU).op := by
    intro X U₁ U₂ hU
    refine (U₁.topIso_inv =≫ ((X.homOfLE hU).appTop ≫ U₂.topIso.hom)).trans ?_
    refine (_ ≫= ((AlgebraicGeometry.Scheme.homOfLE_appTop hU =≫ U₂.topIso.hom).trans
      (_ ≫= U₂.topIso_hom))).trans ?_
    exact presheaf_map_comp₃ X _ _ _ (CategoryTheory.homOfLE hU).op
  have hC1 : ∀ (X Y : AlgebraicGeometry.Scheme.{u}) (g : X ⟶ Y),
      AlgebraicGeometry.IsProper g → Y.IsSeparated → X.IsSeparated := by
    intro X Y g hg hSepY
    have _ : AlgebraicGeometry.IsProper g := hg
    rw [AlgebraicGeometry.Scheme.isSeparated_iff] at hSepY ⊢
    have hTerm : CategoryTheory.Limits.terminal.from X =
        g ≫ CategoryTheory.Limits.terminal.from Y :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    rw [hTerm]
    exact CategoryTheory.MorphismProperty.comp_mem _ g (CategoryTheory.Limits.terminal.from Y)
      inferInstance hSepY
  have hC2 : ∀ (X : AlgebraicGeometry.Scheme.{u}),
      X.IsSeparated →
      ∀ (U₁ U₂ : X.Opens),
        AlgebraicGeometry.IsAffineOpen U₁ →
        AlgebraicGeometry.IsAffineOpen U₂ →
        AlgebraicGeometry.IsAffineOpen (U₁ ⊓ U₂) := by
    intro X hSepX U₁ U₂ hU₁ hU₂
    have _ : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from X) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff X).mp hSepX
    have _ : AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.diagonal (CategoryTheory.Limits.terminal.from X)) :=
      AlgebraicGeometry.IsSeparated.isClosedImmersion_diagonal
    exact AlgebraicGeometry.IsAffineOpen.inf hU₁ hU₂
  have hC3 : ∀ (X : AlgebraicGeometry.Scheme.{u}) (U₁ U₂ : X.Opens),
      AlgebraicGeometry.IsAffineOpen U₁ →
      AlgebraicGeometry.IsAffineOpen U₂ →
      ∀ (h : U₂ ≤ U₁),
        RingHom.Etale (X.presheaf.map (CategoryTheory.homOfLE h).op).hom ∧
        RingHom.Flat (X.presheaf.map (CategoryTheory.homOfLE h).op).hom := by
    intro X U₁ U₂ hU₁ hU₂ h
    have _ : AlgebraicGeometry.Etale (𝟙 X) :=
      AlgebraicGeometry.HasRingHomProperty.of_isOpenImmersion
        (P := @AlgebraicGeometry.Etale) RingHom.Etale.containsIdentities
    have hEt0 : RingHom.Etale (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X) U₁ U₂ h).hom :=
      AlgebraicGeometry.Scheme.Hom.etale_appLE (𝟙 X) hU₁ hU₂ h
    have hId : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X) U₁ U₂ h =
        X.presheaf.map (CategoryTheory.homOfLE h).op := by
      simp only [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.id_app]
      exact Category.id_comp _
    rw [hId] at hEt0
    exact ⟨hEt0, etale_imp_flat hEt0⟩
  have hC4 : ∀ (X Y : AlgebraicGeometry.Scheme.{u}) (g : X ⟶ Y),
      AlgebraicGeometry.Flat g →
      ∀ (U : Y.Opens) (W : X.Opens),
        AlgebraicGeometry.IsAffineOpen U →
        AlgebraicGeometry.IsAffineOpen W →
        ∀ (hW : W ≤ (TopologicalSpace.Opens.map g.base).obj U),
          RingHom.Flat (g.appLE U W hW).hom := by
    intro X Y g hg U W hU hW hWU
    have _ : AlgebraicGeometry.Flat g := hg
    exact AlgebraicGeometry.Scheme.Hom.flat_appLE g hU hW hWU
  have hC5 : ∀ (X Y : AlgebraicGeometry.Scheme.{u}) (g : X ⟶ Y),
      AlgebraicGeometry.Etale g →
      ∀ (U : Y.Opens) (W : X.Opens),
        AlgebraicGeometry.IsAffineOpen U →
        AlgebraicGeometry.IsAffineOpen W →
        ∀ (hW : W ≤ (TopologicalSpace.Opens.map g.base).obj U),
          RingHom.Etale (g.appLE U W hW).hom ∧
          RingHom.Flat (g.appLE U W hW).hom := by
    intro X Y g hg U W hU hW hWU
    have _ : AlgebraicGeometry.Etale g := hg
    have hEt := AlgebraicGeometry.Scheme.Hom.etale_appLE g hU hW hWU
    exact ⟨hEt, etale_imp_flat hEt⟩
  have hC6 : ∀ (X : AlgebraicGeometry.Scheme.{u}) (V : X.Opens),
      AlgebraicGeometry.IsAffineOpen V →
      ∀ (A' : Type u) [CommRing A']
        (e₁ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶ V.toScheme),
        AlgebraicGeometry.Etale e₁ →
        RingHom.Etale ((V.topIso.inv ≫ e₁.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom) ∧
        RingHom.Flat ((V.topIso.inv ≫ e₁.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom) := by
    intro X V hV A' _ e₁ he₁
    have _ : AlgebraicGeometry.IsAffine V.toScheme := hV
    have hEt0 : RingHom.Etale e₁.appTop.hom :=
      (AlgebraicGeometry.HasRingHomProperty.iff_of_isAffine
        (P := @AlgebraicGeometry.Etale) (f := e₁)).mp he₁
    let eL := V.topIso.symm.commRingCatIsoToRingEquiv
    let eR := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).commRingCatIsoToRingEquiv
    have hEt1 : RingHom.Etale (e₁.appTop.hom.comp eL.toRingHom) :=
      RingHom.Etale.respectsIso.2 e₁.appTop.hom eL hEt0
    have hEt2 : RingHom.Etale (eR.toRingHom.comp (e₁.appTop.hom.comp eL.toRingHom)) :=
      RingHom.Etale.respectsIso.1 (e₁.appTop.hom.comp eL.toRingHom) eR hEt1
    have h_eL : eL.toRingHom = V.topIso.inv.hom :=
      CategoryTheory.Iso.commRingCatIsoToRingEquiv_toRingHom V.topIso.symm
    have h_eR : eR.toRingHom =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom.hom :=
      CategoryTheory.Iso.commRingCatIsoToRingEquiv_toRingHom _
    have hComp : (V.topIso.inv ≫ e₁.appTop ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A')).hom).hom =
        eR.toRingHom.comp (e₁.appTop.hom.comp eL.toRingHom) := by
      rw [h_eL, h_eR]
      ext x
      rfl
    rw [hComp]
    exact ⟨hEt2, etale_imp_flat hEt2⟩
  have hC7 : ∀ (R₀ A' : Type u) [CommRing R₀] [CommRing A']
      (e₂ : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R₀)),
      AlgebraicGeometry.Etale e₂ →
      RingHom.Etale (AlgebraicGeometry.Spec.preimage e₂).hom ∧
      RingHom.Flat (AlgebraicGeometry.Spec.preimage e₂).hom := by
    intro R₀ A' _ _ e₂ he₂
    have he₂' : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e₂)) := by
      rwa [AlgebraicGeometry.Spec.map_preimage]
    have hEt : RingHom.Etale (AlgebraicGeometry.Spec.preimage e₂).hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp he₂'
    exact ⟨hEt, etale_imp_flat hEt⟩
  have hC8 : ∀ (Ω : Type u) [Field Ω] (Y : AlgebraicGeometry.Scheme.{u})
      (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (W₀ V_sm : Y.Opens),
      AlgebraicGeometry.IsAffineOpen W₀ →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p) →
      ∀ y : Y, y ∈ W₀ → y ∈ V_sm →
        ∃ (V_std : Y.Opens),
          V_std ≤ W₀ ∧
          y ∈ V_std ∧
          AlgebraicGeometry.IsAffineOpen V_std ∧
          letI : Algebra Ω ↑(Y.presheaf.obj (Opposite.op V_std)) :=
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              p.appLE ⊤ V_std (fun _ _ => trivial)).hom).toAlgebra
          Algebra.IsStandardSmoothOfRelativeDimension 1 Ω ↑(Y.presheaf.obj (Opposite.op V_std)) := by
    intro Ω _ Y p W₀ V_sm hW₀ hSm y hyW₀ hyV
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p) := hSm
    let y' : ↥V_sm.toScheme := ⟨y, hyV⟩
    obtain ⟨U_Ω, _hU_Ω, V₁, hV₁, hy'V₁, e₁, hStd₁⟩ :=
      AlgebraicGeometry.SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension
        (n := 1) (f := V_sm.ι ≫ p) y'
    have hpt : (V_sm.ι ≫ p).base y' ∈ U_Ω := e₁ hy'V₁
    have hU_top : U_Ω = ⊤ :=
      TopologicalSpace.Opens.ext <| Set.eq_univ_of_forall fun q =>
        Subsingleton.elim q ((V_sm.ι ≫ p).base y') ▸ hpt
    subst hU_top
    let V₂ : Y.Opens := (V_sm.ι.opensFunctor).obj V₁
    have hV₂ : AlgebraicGeometry.IsAffineOpen V₂ := hV₁.image_of_isOpenImmersion V_sm.ι
    have hyV₂ : y ∈ V₂ := ⟨y', hy'V₁, rfl⟩
    have eV₂ : V₂ ≤ (TopologicalSpace.Opens.map p.base).obj ⊤ :=
      fun x _ => TopologicalSpace.Opens.mem_top (p.base x)
    have hAppIso : p.appLE ⊤ V₂ eV₂ ≫ (V_sm.ι.appIso V₁).hom =
        (V_sm.ι ≫ p).appLE ⊤ V₁ e₁ := by
      rw [AlgebraicGeometry.Scheme.Hom.appIso_hom' V_sm.ι V₁]
      exact AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V_sm.ι p ⊤ V₂ V₁ eV₂ _
    have hpV₂ : p.appLE ⊤ V₂ eV₂ =
        (V_sm.ι ≫ p).appLE ⊤ V₁ e₁ ≫ (V_sm.ι.appIso V₁).inv := by
      rw [← hAppIso, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    let φ₂ : Ω →+* ↑(Y.presheaf.obj (Opposite.op V₂)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        p.appLE ⊤ V₂ eV₂).hom
    have hStd₂ : RingHom.IsStandardSmoothOfRelativeDimension 1 φ₂ := by
      let eΩ := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm.commRingCatIsoToRingEquiv
      let eV := (V_sm.ι.appIso V₁).symm.commRingCatIsoToRingEquiv
      have h1 : RingHom.IsStandardSmoothOfRelativeDimension 1
          (((V_sm.ι ≫ p).appLE ⊤ V₁ e₁).hom.comp eΩ.toRingHom) :=
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).2 _ eΩ hStd₁
      have h2 : RingHom.IsStandardSmoothOfRelativeDimension 1
          (eV.toRingHom.comp (((V_sm.ι ≫ p).appLE ⊤ V₁ e₁).hom.comp eΩ.toRingHom)) :=
        (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := 1)).1 _ eV h1
      have h_eΩ : eΩ.toRingHom =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom :=
        CategoryTheory.Iso.commRingCatIsoToRingEquiv_toRingHom
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm
      have h_eV : eV.toRingHom = (V_sm.ι.appIso V₁).inv.hom :=
        CategoryTheory.Iso.commRingCatIsoToRingEquiv_toRingHom (V_sm.ι.appIso V₁).symm
      have hφ₂_eq : φ₂ =
          eV.toRingHom.comp (((V_sm.ι ≫ p).appLE ⊤ V₁ e₁).hom.comp eΩ.toRingHom) := by
        dsimp only [φ₂]
        rw [hpV₂, h_eV, h_eΩ]
        ext c
        rfl
      rwa [hφ₂_eq]
    obtain ⟨f, hf_le, hy_std⟩ := hV₂.exists_basicOpen_le (⟨y, hyW₀⟩ : ↥W₀) hyV₂
    let V_std : Y.Opens := Y.basicOpen f
    refine ⟨V_std, hf_le, hy_std, hV₂.basicOpen f, ?_⟩
    letI : Algebra Ω ↑(Y.presheaf.obj (Opposite.op V_std)) :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        p.appLE ⊤ V_std (fun _ _ => trivial)).hom).toAlgebra
    have _ : IsLocalization.Away f ↑(Y.presheaf.obj (Opposite.op V_std)) :=
      hV₂.isLocalization_basicOpen f
    have hStd₃ : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((algebraMap ↑(Y.presheaf.obj (Opposite.op V₂))
          ↑(Y.presheaf.obj (Opposite.op V_std))).comp φ₂) :=
      (RingHom.isStandardSmoothOfRelativeDimension_stableUnderCompositionWithLocalizationAway 1).2
        ↑(Y.presheaf.obj (Opposite.op V_std)) f φ₂ hStd₂
    have hAlgEq : (algebraMap ↑(Y.presheaf.obj (Opposite.op V₂))
          ↑(Y.presheaf.obj (Opposite.op V_std))).comp φ₂ =
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          p.appLE ⊤ V_std (fun _ _ => trivial)).hom) := by
      have hMap : p.appLE ⊤ V₂ eV₂ ≫
          Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le f)).op =
          p.appLE ⊤ V_std (fun _ _ => trivial) :=
        AlgebraicGeometry.Scheme.Hom.appLE_map (U := ⊤) p eV₂
          (CategoryTheory.homOfLE (Y.basicOpen_le f)).op
      change (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le f)).op).hom.comp φ₂ = _
      ext c
      dsimp only [φ₂]
      rw [← hMap]
      rfl
    rw [hAlgEq] at hStd₃
    exact RingHom.IsStandardSmoothOfRelativeDimension.toAlgebra 1 hStd₃
  have hC9 : ∀ (C S : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S)
      (U : S.Opens) (W : C.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      AlgebraicGeometry.IsAffineOpen W →
      ∀ (hWU : W ≤ (TopologicalSpace.Opens.map g.base).obj U)
        (R₀ : Type u) [CommRing R₀]
        [Algebra ↑(S.presheaf.obj (Opposite.op U)) R₀]
        (s : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ S)
        (hs : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R₀)).Opens) ≤
          (TopologicalSpace.Opens.map s.base).obj U),
        (s.appLE U ⊤ hs ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).hom).hom =
          algebraMap ↑(S.presheaf.obj (Opposite.op U)) R₀ →
        let C_R := CategoryTheory.Limits.pullback g s
        let fst := CategoryTheory.Limits.pullback.fst g s
        let snd := CategoryTheory.Limits.pullback.snd g s
        ∀ (W' : C_R.Opens) (hW' : W' = (TopologicalSpace.Opens.map fst.base).obj W),
          let A := ↑(S.presheaf.obj (Opposite.op U))
          let D := ↑(C.presheaf.obj (Opposite.op W))
          let D_R := ↑(C_R.presheaf.obj (Opposite.op W'))
          letI : Algebra A D := (g.appLE U W hWU).hom.toAlgebra
          letI : Algebra R₀ D_R :=
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
              snd.appLE ⊤ W' (fun _ _ => trivial)).hom).toAlgebra
          letI : Algebra D D_R := (fst.appLE W W' (le_of_eq hW')).hom.toAlgebra
          letI : Algebra A D_R :=
            ((fst.appLE W W' (le_of_eq hW')).hom.comp (g.appLE U W hWU).hom).toAlgebra
          AlgebraicGeometry.IsAffineOpen W' ∧
          ∃ (_ : IsScalarTower A D D_R) (_ : IsScalarTower A R₀ D_R),
            Algebra.IsPushout A R₀ D D_R ∧
            ∃ e_push : TensorProduct A D R₀ ≃+* D_R,
              ∀ (d : D) (r₀ : R₀),
                e_push (TensorProduct.tmul A d r₀) =
                  (fst.appLE W W' (le_of_eq hW')).hom d *
                    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
                      snd.appLE ⊤ W' (fun _ _ => trivial)).hom r₀) := by
