                      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
                        CommRingCat.ofHom α_node) ≫
                      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_node)).inv := by
                    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
                _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).appTop ≫
                        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_node)).hom) ≫
                      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_node)).inv := by
                    rw [AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
                _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).appTop := by
                    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                      CategoryTheory.Category.comp_id]
            have hα_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R_node)).Opens) ≤
                (TopologicalSpace.Opens.map
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).base).obj ⊤ :=
              fun _ _ => trivial
            have hU''_comp₂_top : U'' ≤
                (TopologicalSpace.Opens.map
                  (e₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).base).obj ⊤ :=
              fun _ _ => trivial
            have hU''_comp₁_top : U'' ≤
                (TopologicalSpace.Opens.map (e₁ ≫ snd_p).base).obj ⊤ :=
              fun _ _ => trivial
            have hStep1 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).appLE
                ⊤ ⊤ hα_top ≫ e₂.appLE ⊤ U'' hU''_e₂_top =
              (e₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).appLE
                ⊤ U'' hU''_comp₂_top :=
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
                e₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)) ⊤ ⊤ U'' hα_top hU''_e₂_top
            have hStep2 : (e₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).appLE
                ⊤ U'' hU''_comp₂_top =
              (e₁ ≫ snd_p).appLE ⊤ U'' hU''_comp₁_top :=
              hAppLE_congr_hom hComm_node.symm ⊤ U'' hU''_comp₂_top hU''_comp₁_top
            have hStep3 : (e₁ ≫ snd_p).appLE ⊤ U'' hU''_comp₁_top =
                snd_p.appLE ⊤ W_Ω hWΩ_top ≫ e₁.appLE W_Ω U'' hU''_le :=
              (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
                e₁ snd_p ⊤ W_Ω U'' hWΩ_top hU''_le).symm
            calc CommRingCat.ofHom α_node ≫
                  ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_node)).inv ≫
                    e₂.appLE ⊤ U'' hU''_e₂_top)
                = (CommRingCat.ofHom α_node ≫
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_node)).inv) ≫
                    e₂.appLE ⊤ U'' hU''_e₂_top := by
                  rw [CategoryTheory.Category.assoc]
              _ = (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                    ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_node)).appLE ⊤ ⊤ hα_top ≫
                      e₂.appLE ⊤ U'' hU''_e₂_top) := by
                  rw [hNatInv, ← hSpecMap_top (CommRingCat.ofHom α_node) hα_top,
                    CategoryTheory.Category.assoc]
              _ = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                    snd_p.appLE ⊤ W_Ω hWΩ_top) ≫
                    e₁.appLE W_Ω U'' hU''_le := by
                  rw [hStep1, hStep2, hStep3, CategoryTheory.Category.assoc]
          obtain ⟨hJnode_inj, hNodeKaehler⟩ := hAlgNode Ω A'' φ₂ hFlat₂
          obtain ⟨hqnode_surj, hqnode_ker⟩ := hNodeKaehler hφ₂_comp hEt₂_hom
          let x₀ : A'' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
          let x₁ : A'' := φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
          let J_node : Matrix (Fin 2) (Fin 1) A'' :=
            Matrix.of fun (i : Fin 2) (_ : Fin 1) => Fin.cases x₁ (fun _ => x₀) i
          let q_node : (Fin 2 → A'') →ₗ[A''] KaehlerDifferential Ω A'' :=
            LinearMap.lsum A'' (fun _ : Fin 2 => A'') A'' fun r =>
              LinearMap.toSpanSingleton A'' (KaehlerDifferential Ω A'')
                (KaehlerDifferential.D Ω A'' (φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X r))))
          obtain ⟨_hJ₁_node_inj, ψ₁, ψ₂, u_node, hψ₁_eq, hψ₂_eq, hψ₁₂⟩ :=
            hCramer A'' (KaehlerDifferential Ω A'') k 1 J₁_node q₁_node J_node q_node
              hq₁_node_surj hq₁_node_ker hqnode_surj hqnode_ker hJnode_inj
          have hψ₁_ann : ∀ ω : KaehlerDifferential Ω A'', ψ₁ ω * φ₁ z_Ω = 0 := by
            intro ω
            obtain ⟨v_n, rfl⟩ := hq₁_node_surj ω
            rw [hψ₁_eq v_n, Finset.sum_mul]
            apply Finset.sum_eq_zero
            intro r _
            have hMapΔ : φ₁ (Δ_Ω r) =
                (-1) ^ (r : ℕ) * Matrix.det (J₁_node.submatrix r.succAbove id) :=
              hMapCofactor φ₁ J_Ω r
            calc v_n r * (-1) ^ (r : ℕ) * Matrix.det (J₁_node.submatrix r.succAbove id) * φ₁ z_Ω
                = v_n r * ((-1) ^ (r : ℕ) * Matrix.det (J₁_node.submatrix r.succAbove id) *
                    φ₁ z_Ω) := by ring
              _ = v_n r * (φ₁ (Δ_Ω r) * φ₁ z_Ω) := by rw [← hMapΔ]
              _ = v_n r * φ₁ (Δ_Ω r * z_Ω) := by rw [← map_mul]
              _ = 0 := by rw [hΔ_Ω_ann r, map_zero, mul_zero]
          have hx₀_ann : x₀ * φ₁ z_Ω = 0 := by
            have h₀ := hψ₁_ann (q_node (Pi.single 0 (1 : A'')))
            have hψ₂_0 : ψ₂ (q_node (Pi.single 0 (1 : A''))) = x₀ := by
              have h := hψ₂_eq (Pi.single 0 (1 : A''))
              simp only [mul_assoc] at h
              rw [h, hSumPiSingle, Matrix.det_fin_one]
              change (-1) ^ (0 : ℕ) * x₀ = x₀
              simp
            have hψ₁_0 : ψ₁ (q_node (Pi.single 0 (1 : A''))) = u_node.val * x₀ := by
              rw [hψ₁₂]; exact congrArg (u_node.val * ·) hψ₂_0
            rw [hψ₁_0, mul_assoc] at h₀
            exact u_node.isUnit.mul_right_eq_zero.mp h₀
          have hx₁_ann : x₁ * φ₁ z_Ω = 0 := by
            have h₁ := hψ₁_ann (q_node (Pi.single 1 (1 : A'')))
            have hψ₂_1 : ψ₂ (q_node (Pi.single 1 (1 : A''))) = -x₁ := by
              have h := hψ₂_eq (Pi.single 1 (1 : A''))
              simp only [mul_assoc] at h
              rw [h, hSumPiSingle, Matrix.det_fin_one]
              change (-1) ^ (1 : ℕ) * x₁ = -x₁
              simp
            have hψ₁_1 : ψ₁ (q_node (Pi.single 1 (1 : A''))) = u_node.val * (-x₁) := by
              rw [hψ₁₂]; exact congrArg (u_node.val * ·) hψ₂_1
            rw [hψ₁_1, mul_assoc] at h₁
            have hneg := u_node.isUnit.mul_right_eq_zero.mp h₁
            simpa only [neg_mul, neg_eq_zero] using hneg
          have hVecZero : J_node.mulVecLin (fun _ : Fin 1 => φ₁ z_Ω) =
              J_node.mulVecLin 0 := by
            rw [map_zero]
            ext i
            fin_cases i
            · change (∑ _ : Fin 1, x₁ * φ₁ z_Ω) = 0
              simp [hx₁_ann]
            · change (∑ _ : Fin 1, x₀ * φ₁ z_Ω) = 0
              simp [hx₀_ann]
          have hφ₁_z : φ₁ z_Ω = 0 := congrFun (hJnode_inj hVecZero) 0
          haveI : u''_0.asIdeal.IsPrime := u''_0.isPrime
          exact (hAlgFlat D_Ω A'' φ₁ hFlat₁).1 u''_0.asIdeal M_max hIdeal₁ z_Ω hφ₁_z
    
    have hJD_inj : Function.Injective J_D.mulVecLin := by
      intro w₁ w₂ hw₁₂
      have hw_ker : J_D.mulVec (w₁ - w₂) = 0 := by
        change J_D.mulVecLin (w₁ - w₂) = 0
        rw [map_sub, hw₁₂, sub_self]
      have hw_zero : w₁ - w₂ = 0 := by
        ext j
        apply hCofAnn ((w₁ - w₂) j)
        intro r
        let M_r : Matrix (Fin k) (Fin k) D := J_D.submatrix r.succAbove id
        have hMr_zero : M_r.mulVec (w₁ - w₂) = 0 := by
          ext i
          change (∑ c : Fin k, J_D (r.succAbove i) c * (w₁ - w₂) c) = 0
          exact congrFun hw_ker (r.succAbove i)
        have hDetMul : Matrix.det M_r * (w₁ - w₂) j = 0 := by
          calc Matrix.det M_r * (w₁ - w₂) j
              = ((Matrix.det M_r • (1 : Matrix (Fin k) (Fin k) D)).mulVec (w₁ - w₂)) j := by
                simp [Matrix.mulVec, dotProduct, Matrix.one_apply]
            _ = ((M_r.adjugate * M_r).mulVec (w₁ - w₂)) j := by rw [Matrix.adjugate_mul]
            _ = (M_r.adjugate.mulVec (M_r.mulVec (w₁ - w₂))) j := by rw [Matrix.mulVec_mulVec]
            _ = 0 := by rw [hMr_zero, Matrix.mulVec_zero]; rfl
        change (-1) ^ (r : ℕ) * Matrix.det M_r * (w₁ - w₂) j = 0
        rw [mul_assoc, hDetMul, mul_zero]
      exact sub_eq_zero.mp hw_zero
    exact ⟨⟨hqD_surj, hqD_ker⟩, hCofAnn, hJD_inj⟩

  
  
  
  have hMarkNzd : ∀ (a : Fin m) (W : C.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      ∀ (hW : W ≤ V_cov a) (d : ↑(C.presheaf.obj (Opposite.op W))),
        d * (C.presheaf.map (CategoryTheory.homOfLE hW).op).hom (t_mark a) = 0 → d = 0 := by
    intro a W hAffW hW d hd
    obtain ⟨_hAffU, hAffV, _hV_le, _hπC, _hπSurj, _hπKer, hNone, hSome⟩ := hCharts a
    let res_W := (C.presheaf.map (CategoryTheory.homOfLE hW).op).hom
    cases htag : tag a with
    | none =>
      have ht₁ : t_mark a = 1 := (hNone htag).2
      rw [ht₁, map_one, mul_one] at hd
      exact hd
    | some j₀ =>
      have ht_reg := (hSome j₀ htag).2.2.1
      have hFlat_res : RingHom.Flat res_W := (hGeomRes C (V_cov a) W hAffV hAffW hW).2
      exact (hAlgFlat _ _ res_W hFlat_res).2 (t_mark a) ht_reg d hd

  have hDisjUnit : ∀ (a : Fin m) (j₀ : Fin n),
      tag a = some j₀ →
      ∀ (W : C.Opens), AlgebraicGeometry.IsAffineOpen W →
        ∀ (hW : W ≤ V_cov a),
          Disjoint (W : Set C) (Set.range (τ j₀).base) →
          IsUnit ((C.presheaf.map (CategoryTheory.homOfLE hW).op).hom (t_mark a)) := by
    intro a j₀ htag W hAffW hW hDisj
    obtain ⟨hAffU, hAffV, hV_le, _hπC, _hπSurj, _hπKer, _hNone, hSome⟩ := hCharts a
    obtain ⟨_hDisjOther, ⟨hU_sec, hKer_σ⟩, _ht_reg, _hUnitDet⟩ := hSome j₀ htag
    let D := ↑(C.presheaf.obj (Opposite.op W))
    let res_W : ↑(C.presheaf.obj (Opposite.op (V_cov a))) →+* D :=
      (C.presheaf.map (CategoryTheory.homOfLE hW).op).hom
    rw [← Ideal.span_singleton_eq_top]
    by_contra h_ne_top
    obtain ⟨M, hM_max, hSpan_le⟩ := Ideal.exists_le_maximal (Ideal.span {res_W (t_mark a)}) h_ne_top
    haveI : M.IsPrime := hM_max.isPrime
    let P : ↥(AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op W))) := ⟨M, hM_max.isPrime⟩
    let P_V : ↥(AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op (V_cov a)))) :=
      PrimeSpectrum.comap res_W P
    have ht_mem_PV : t_mark a ∈ P_V.asIdeal := by
      change res_W (t_mark a) ∈ M
      exact hSpan_le (Ideal.subset_span rfl)
    let x : C := hAffW.fromSpec.base P
    have hx_W : x ∈ (W : Set C) := by
      rw [← hAffW.range_fromSpec]
      exact ⟨P, rfl⟩
    have hMapSpec := hAffV.map_fromSpec hAffW (CategoryTheory.homOfLE hW).op
    have hx_PV : hAffV.fromSpec.base P_V = x := by
      calc hAffV.fromSpec.base P_V
          = hAffV.fromSpec.base
              ((AlgebraicGeometry.Spec.map
                (C.presheaf.map (CategoryTheory.homOfLE hW).op)).base P) :=
            congrArg hAffV.fromSpec.base
              (AlgebraicGeometry.Spec.map_apply
                (C.presheaf.map (CategoryTheory.homOfLE hW).op) P).symm
        _ = (AlgebraicGeometry.Spec.map (C.presheaf.map (CategoryTheory.homOfLE hW).op) ≫
              hAffV.fromSpec).base P :=
            (hCompBase
              (AlgebraicGeometry.Spec.map (C.presheaf.map (CategoryTheory.homOfLE hW).op))
              hAffV.fromSpec P).symm
        _ = x := congrArg (fun f => f.base P) hMapSpec
    let σ : ↑(C.presheaf.obj (Opposite.op (V_cov a))) →+*
        ↑(S.presheaf.obj (Opposite.op (U_base a))) :=
      ((τ j₀).appLE (V_cov a) (U_base a) hU_sec).hom
    have hσ_split : σ.comp (g.appLE (U_base a) (V_cov a) hV_le).hom = RingHom.id _ := by
      rw [← CommRingCat.hom_comp]
      have hIdLe : U_base a ≤ (TopologicalSpace.Opens.map (𝟙 S : S ⟶ S).base).obj (U_base a) :=
        le_refl (U_base a)
      have hCompCat : g.appLE (U_base a) (V_cov a) hV_le ≫
          (τ j₀).appLE (V_cov a) (U_base a) hU_sec =
            𝟙 (S.presheaf.obj (Opposite.op (U_base a))) := by
        calc g.appLE (U_base a) (V_cov a) hV_le ≫
              (τ j₀).appLE (V_cov a) (U_base a) hU_sec
            = (τ j₀ ≫ g).appLE (U_base a) (U_base a)
                (hU_sec.trans ((TopologicalSpace.Opens.map (τ j₀).base).map
                  (CategoryTheory.homOfLE hV_le)).le) :=
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
          _ = (𝟙 S : S ⟶ S).appLE (U_base a) (U_base a) hIdLe :=
              hAppLE_congr_hom (hSec_g j₀) (U_base a) (U_base a) _ hIdLe
          _ = 𝟙 (S.presheaf.obj (Opposite.op (U_base a))) :=
              hIdAppLE S (U_base a) hIdLe
      rw [hCompCat]
      rfl
    have hσ_surj : Function.Surjective σ := by
      intro u_elem
      exact ⟨(g.appLE (U_base a) (V_cov a) hV_le).hom u_elem,
        congrFun (congrArg DFunLike.coe hσ_split) u_elem⟩
    have hKer_le : RingHom.ker σ ≤ P_V.asIdeal := by
      rw [hKer_σ, Ideal.span_singleton_le_iff_mem]
      exact ht_mem_PV
    haveI : P_V.asIdeal.IsPrime := P_V.isPrime
    let Q_id : Ideal ↑(S.presheaf.obj (Opposite.op (U_base a))) := Ideal.map σ P_V.asIdeal
    have hQ_prime : Q_id.IsPrime := Ideal.map_isPrime_of_surjective hσ_surj hKer_le
    let Q : ↥(AlgebraicGeometry.Spec (S.presheaf.obj (Opposite.op (U_base a)))) :=
      ⟨Q_id, hQ_prime⟩
    have hComap_Q :
        (PrimeSpectrum.comap σ Q :
          ↥(AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op (V_cov a))))) = P_V := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ (Ideal.map σ P_V.asIdeal) = P_V.asIdeal
      rw [Ideal.comap_map_of_surjective' σ hσ_surj P_V.asIdeal, sup_eq_left.mpr hKer_le]
    have hSpec_τ :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (τ j₀) hAffV hAffU hU_sec
    have hPt_τ : x = (τ j₀).base (hAffU.fromSpec.base Q) := by
      calc x
          = hAffV.fromSpec.base P_V := hx_PV.symm
        _ = hAffV.fromSpec.base
              (PrimeSpectrum.comap σ Q :
                ↥(AlgebraicGeometry.Spec (C.presheaf.obj (Opposite.op (V_cov a))))) :=
            congrArg hAffV.fromSpec.base hComap_Q.symm
        _ = hAffV.fromSpec.base
              ((AlgebraicGeometry.Spec.map
                ((τ j₀).appLE (V_cov a) (U_base a) hU_sec)).base Q) :=
            congrArg hAffV.fromSpec.base
              (AlgebraicGeometry.Spec.map_apply
                ((τ j₀).appLE (V_cov a) (U_base a) hU_sec) Q).symm
        _ = (AlgebraicGeometry.Spec.map
              ((τ j₀).appLE (V_cov a) (U_base a) hU_sec) ≫ hAffV.fromSpec).base Q :=
            (hCompBase
              (AlgebraicGeometry.Spec.map ((τ j₀).appLE (V_cov a) (U_base a) hU_sec))
              hAffV.fromSpec Q).symm
        _ = (hAffU.fromSpec ≫ τ j₀).base Q := congrArg (fun f => f.base Q) hSpec_τ
        _ = (τ j₀).base (hAffU.fromSpec.base Q) :=
            hCompBase hAffU.fromSpec (τ j₀) Q
    have hx_range : x ∈ Set.range (τ j₀).base := ⟨hAffU.fromSpec.base Q, hPt_τ.symm⟩
    exact Set.disjoint_left.mp hDisj hx_W hx_range

  have hMarkUnitRatio : ∀ a b : Fin m,
      ∃ v_ab : (↑(C.presheaf.obj (Opposite.op (V_cov a ⊓ V_cov b))))ˣ,
        (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V_cov a ⊓ V_cov b ≤ V_cov a)).op).hom
            (t_mark a) =
          v_ab.val *
            (C.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : V_cov a ⊓ V_cov b ≤ V_cov b)).op).hom
              (t_mark b) := by
    intro a b
    obtain ⟨hAffUa, hAffVa, hVa_le, _hπCa, _hπSurja, _hπKera, hNone_a, hSome_a⟩ := hCharts a
    obtain ⟨hAffUb, hAffVb, hVb_le, _hπCb, _hπSurjb, _hπKerb, hNone_b, hSome_b⟩ := hCharts b
    let U_ab : S.Opens := U_base a ⊓ U_base b
    let V_ab : C.Opens := V_cov a ⊓ V_cov b
    have hAffU_ab : AlgebraicGeometry.IsAffineOpen U_ab :=
      hGeomInter S hSepS (U_base a) (U_base b) hAffUa hAffUb
    have hAffV_ab : AlgebraicGeometry.IsAffineOpen V_ab :=
      hGeomInter C hSepC (V_cov a) (V_cov b) hAffVa hAffVb
    let B_ab := ↑(C.presheaf.obj (Opposite.op V_ab))
    let res₁ : ↑(C.presheaf.obj (Opposite.op (V_cov a))) →+* B_ab :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V_ab ≤ V_cov a)).op).hom
    let res₂ : ↑(C.presheaf.obj (Opposite.op (V_cov b))) →+* B_ab :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_ab ≤ V_cov b)).op).hom
    let t₁_ab : B_ab := res₁ (t_mark a)
    let t₂_ab : B_ab := res₂ (t_mark b)
    suffices hSpanEq : Ideal.span ({t₁_ab} : Set B_ab) = Ideal.span ({t₂_ab} : Set B_ab) by
      have ht₁_mem : t₁_ab ∈ Ideal.span ({t₂_ab} : Set B_ab) := by
        rw [← hSpanEq]; exact Ideal.subset_span rfl
      have ht₂_mem : t₂_ab ∈ Ideal.span ({t₁_ab} : Set B_ab) := by
        rw [hSpanEq]; exact Ideal.subset_span rfl
      obtain ⟨v₁, hv₁⟩ := Ideal.mem_span_singleton.mp ht₁_mem
      obtain ⟨v₂, hv₂⟩ := Ideal.mem_span_singleton.mp ht₂_mem
      have hAnn : (v₁ * v₂ - 1) * t₁_ab = 0 := by
        calc (v₁ * v₂ - 1) * t₁_ab
            = v₁ * (t₁_ab * v₂) - t₁_ab := by ring
          _ = v₁ * t₂_ab - t₁_ab := by rw [← hv₂]
          _ = t₂_ab * v₁ - t₁_ab := by ring
          _ = 0 := by rw [← hv₁, sub_self]
      have hv₁₂ : v₁ * v₂ = 1 :=
        sub_eq_zero.mp (hMarkNzd a V_ab hAffV_ab inf_le_left (v₁ * v₂ - 1) hAnn)
      have hv₂₁ : v₂ * v₁ = 1 := by rw [mul_comm, hv₁₂]
      refine ⟨⟨v₁, v₂, hv₁₂, hv₂₁⟩, ?_⟩
      change t₁_ab = v₁ * t₂_ab
      rw [hv₁, mul_comm]
    
    cases htag_a : tag a with
    | none =>
      have ht₁ : t₁_ab = 1 := by
        change res₁ (t_mark a) = 1
        rw [(hNone_a htag_a).2, map_one]
      cases htag_b : tag b with
      | none =>
        have ht₂ : t₂_ab = 1 := by
          change res₂ (t_mark b) = 1
          rw [(hNone_b htag_b).2, map_one]
        rw [ht₁, ht₂]
      | some j₁ =>
        have hDisj₁ : Disjoint (V_ab : Set C) (Set.range (τ j₁).base) :=
          Disjoint.mono_left (inf_le_left : V_ab ≤ V_cov a) ((hNone_a htag_a).1 j₁)
        have hUnit₂ : IsUnit t₂_ab :=
          hDisjUnit b j₁ htag_b V_ab hAffV_ab inf_le_right hDisj₁
        rw [ht₁, Ideal.span_singleton_one, (Ideal.span_singleton_eq_top.mpr hUnit₂).symm]
    | some j₀ =>
      cases htag_b : tag b with
      | none =>
        have ht₂ : t₂_ab = 1 := by
          change res₂ (t_mark b) = 1
          rw [(hNone_b htag_b).2, map_one]
        have hDisj₀ : Disjoint (V_ab : Set C) (Set.range (τ j₀).base) :=
          Disjoint.mono_left (inf_le_right : V_ab ≤ V_cov b) ((hNone_b htag_b).1 j₀)
        have hUnit₁ : IsUnit t₁_ab :=
          hDisjUnit a j₀ htag_a V_ab hAffV_ab inf_le_left hDisj₀
        rw [ht₂, Ideal.span_singleton_one, Ideal.span_singleton_eq_top.mpr hUnit₁]
      | some j₁ =>
        by_cases hj : j₀ = j₁
        · subst hj
          
          obtain ⟨_hDisj_a, ⟨hUa_sec, hKer_σa⟩, _ht_reg_a, _hDet_a⟩ := hSome_a j₀ htag_a
          obtain ⟨_hDisj_b, ⟨hUb_sec, hKer_σb⟩, _ht_reg_b, _hDet_b⟩ := hSome_b j₀ htag_b
          have hPreimageEq : ∀ (U_c : S.Opens) (V_c : C.Opens),
              V_c ≤ (TopologicalSpace.Opens.map g.base).obj U_c →
              U_c ≤ (TopologicalSpace.Opens.map (τ j₀).base).obj V_c →
              U_c = (TopologicalSpace.Opens.map (τ j₀).base).obj V_c := by
            intro U_c V_c hVc_le hUc_sec
            apply le_antisymm hUc_sec
            intro s_pt hs_pt
            have hτ_mem : (τ j₀).base s_pt ∈ V_c := hs_pt
            have hgτ_mem : g.base ((τ j₀).base s_pt) ∈ U_c := hVc_le hτ_mem
            have hIdPt : g.base ((τ j₀).base s_pt) = s_pt := by
              rw [← hCompBase, hSec_g j₀]
              rfl
            rwa [hIdPt] at hgτ_mem
          have hUa_eq : U_base a = (TopologicalSpace.Opens.map (τ j₀).base).obj (V_cov a) :=
            hPreimageEq (U_base a) (V_cov a) hVa_le hUa_sec
          have hUb_eq : U_base b = (TopologicalSpace.Opens.map (τ j₀).base).obj (V_cov b) :=
            hPreimageEq (U_base b) (V_cov b) hVb_le hUb_sec
          have hUab_eq : U_ab = (TopologicalSpace.Opens.map (τ j₀).base).obj V_ab := by
            ext s_pt
            change s_pt ∈ U_base a ∧ s_pt ∈ U_base b ↔
              (τ j₀).base s_pt ∈ V_cov a ∧ (τ j₀).base s_pt ∈ V_cov b
            rw [hUa_eq, hUb_eq]
            rfl
          let A_ab := ↑(S.presheaf.obj (Opposite.op U_ab))
          let σ_ab : B_ab →+* A_ab := ((τ j₀).appLE V_ab U_ab (le_of_eq hUab_eq)).hom
          
          have hSideKer : ∀ (c : Fin m)
              (hAffUc : AlgebraicGeometry.IsAffineOpen (U_base c))
              (hAffVc : AlgebraicGeometry.IsAffineOpen (V_cov c))
              (hVc_le : V_cov c ≤ (TopologicalSpace.Opens.map g.base).obj (U_base c))
              (hUc_eq : U_base c = (TopologicalSpace.Opens.map (τ j₀).base).obj (V_cov c))
              (hKer_c : RingHom.ker
                (((τ j₀).appLE (V_cov c) (U_base c) (le_of_eq hUc_eq)).hom) =
                  Ideal.span {t_mark c})
              (hV_sub : V_ab ≤ V_cov c) (hU_sub : U_ab ≤ U_base c),
              RingHom.ker σ_ab =
                Ideal.span {(C.presheaf.map (CategoryTheory.homOfLE hV_sub).op).hom (t_mark c)} := by
            intro c hAffUc hAffVc hVc_le hUc_eq hKer_c hV_sub hU_sub
            let B_c := ↑(C.presheaf.obj (Opposite.op (V_cov c)))
            let A_c := ↑(S.presheaf.obj (Opposite.op (U_base c)))
            let σ_c : B_c →+* A_c :=
              ((τ j₀).appLE (V_cov c) (U_base c) (le_of_eq hUc_eq)).hom
            let res_Vc : B_c →+* B_ab :=
              (C.presheaf.map (CategoryTheory.homOfLE hV_sub).op).hom
            let res_Uc : A_c →+* A_ab :=
              (S.presheaf.map (CategoryTheory.homOfLE hU_sub).op).hom
            let g_c : A_c →+* B_c := (g.appLE (U_base c) (V_cov c) hVc_le).hom
            have hσ_comm : σ_ab.comp res_Vc = res_Uc.comp σ_c :=
              hSquareComm (τ j₀) hV_sub hU_sub (le_of_eq hUc_eq) (le_of_eq hUab_eq)
            have hσg_id : σ_c.comp g_c = RingHom.id A_c := by
              rw [← CommRingCat.hom_comp]
              have hIdLe : U_base c ≤
                  (TopologicalSpace.Opens.map (𝟙 S : S ⟶ S).base).obj (U_base c) :=
                le_refl (U_base c)
              have hCompCat : g.appLE (U_base c) (V_cov c) hVc_le ≫
                  (τ j₀).appLE (V_cov c) (U_base c) (le_of_eq hUc_eq) =
                    𝟙 (S.presheaf.obj (Opposite.op (U_base c))) := by
                calc g.appLE (U_base c) (V_cov c) hVc_le ≫
                      (τ j₀).appLE (V_cov c) (U_base c) (le_of_eq hUc_eq)
                    = (τ j₀ ≫ g).appLE (U_base c) (U_base c)
                        ((le_of_eq hUc_eq).trans ((TopologicalSpace.Opens.map (τ j₀).base).map
                          (CategoryTheory.homOfLE hVc_le)).le) :=
                      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
                  _ = (𝟙 S : S ⟶ S).appLE (U_base c) (U_base c) hIdLe :=
                      hAppLE_congr_hom (hSec_g j₀) (U_base c) (U_base c) _ hIdLe
                  _ = 𝟙 (S.presheaf.obj (Opposite.op (U_base c))) :=
                      hIdAppLE S (U_base c) hIdLe
              rw [hCompCat]
              rfl
            apply le_antisymm
            · letI : Algebra B_c A_c := σ_c.toAlgebra
              letI : Algebra B_c B_ab := res_Vc.toAlgebra
              obtain ⟨e_pre, he_pre⟩ :=
                hGeomPre S C (τ j₀) (V_cov c) V_ab (U_base c) U_ab
                  hAffVc hAffV_ab hAffUc hAffU_ab hV_sub hU_sub hUc_eq hUab_eq
              let I_c : Ideal B_ab := Ideal.span {res_Vc (t_mark c)}
              let mkQ : B_ab →+* (B_ab ⧸ I_c) := Ideal.Quotient.mk I_c
              letI : Algebra B_c (B_ab ⧸ I_c) := (mkQ.comp res_Vc).toAlgebra
              have hModEq : ∀ b_c : B_c, mkQ (res_Vc (g_c (σ_c b_c))) = mkQ (res_Vc b_c) := by
                intro b_c
                have hDiffKer : b_c - g_c (σ_c b_c) ∈ RingHom.ker σ_c := by
                  change σ_c (b_c - g_c (σ_c b_c)) = 0
                  rw [map_sub]
                  have hEval : σ_c (g_c (σ_c b_c)) = σ_c b_c :=
                    congrFun (congrArg DFunLike.coe hσg_id) (σ_c b_c)
                  rw [hEval, sub_self]
                rw [hKer_c, Ideal.mem_span_singleton] at hDiffKer
                obtain ⟨q_c, hq_c⟩ := hDiffKer
                have hMemI : res_Vc b_c - res_Vc (g_c (σ_c b_c)) ∈ I_c := by
                  rw [← map_sub, hq_c, map_mul]
                  exact Ideal.mem_span_singleton.mpr ⟨res_Vc q_c, rfl⟩
                have hZeroQ : mkQ (res_Vc b_c - res_Vc (g_c (σ_c b_c))) = 0 :=
                  Ideal.Quotient.eq_zero_iff_mem.mpr hMemI
                rw [map_sub] at hZeroQ
                exact (sub_eq_zero.mp hZeroQ).symm
              let f_bilin : A_c →ₗ[B_c] B_ab →ₗ[B_c] (B_ab ⧸ I_c) :=
                LinearMap.mk₂ B_c (fun a_c y => mkQ (res_Vc (g_c a_c) * y))
                  (fun a₁ a₂ y => by simp only [map_add, add_mul])
                  (fun b_c a_c y => by
                    change mkQ (res_Vc (g_c (σ_c b_c * a_c)) * y) =
                      mkQ (res_Vc b_c) * mkQ (res_Vc (g_c a_c) * y)
                    rw [map_mul g_c, map_mul res_Vc, mul_assoc, map_mul mkQ, hModEq b_c])
                  (fun a_c y₁ y₂ => by simp only [mul_add, map_add])
                  (fun b_c a_c y => by
                    change mkQ (res_Vc (g_c a_c) * (res_Vc b_c * y)) =
                      mkQ (res_Vc b_c) * mkQ (res_Vc (g_c a_c) * y)
                    rw [← mul_assoc, mul_comm (res_Vc (g_c a_c)) (res_Vc b_c),
                      mul_assoc, map_mul])
              let ψ_lift : TensorProduct B_c A_c B_ab →ₗ[B_c] (B_ab ⧸ I_c) :=
                TensorProduct.lift f_bilin
              intro y hy
              have hy_zero : σ_ab y = 0 := hy
              have he_zero : e_pre (TensorProduct.tmul B_c (1 : A_c) y) = e_pre 0 := by
                rw [he_pre, map_one, one_mul, map_zero]
                exact hy_zero
              have hTmul_zero : TensorProduct.tmul B_c (1 : A_c) y = 0 :=
                e_pre.injective he_zero
              have hLift_zero : ψ_lift (TensorProduct.tmul B_c (1 : A_c) y) = 0 := by
                rw [hTmul_zero, map_zero]
              have hLift_eval : ψ_lift (TensorProduct.tmul B_c (1 : A_c) y) = mkQ y := by
                change mkQ (res_Vc (g_c 1) * y) = mkQ y
                rw [map_one, map_one, one_mul]
              rw [hLift_eval] at hLift_zero
              exact Ideal.Quotient.eq_zero_iff_mem.mp hLift_zero
            · rw [Ideal.span_singleton_le_iff_mem]
              change σ_ab (res_Vc (t_mark c)) = 0
              have hCommPt : σ_ab (res_Vc (t_mark c)) = res_Uc (σ_c (t_mark c)) :=
                congrFun (congrArg DFunLike.coe hσ_comm) (t_mark c)
              rw [hCommPt]
              have ht_ker : t_mark c ∈ RingHom.ker σ_c := by
                rw [hKer_c]
                exact Ideal.subset_span rfl
              change res_Uc (σ_c (t_mark c)) = 0
              have hZero_c : σ_c (t_mark c) = 0 := ht_ker
              rw [hZero_c, map_zero]
          have hKer₁ : RingHom.ker σ_ab = Ideal.span {t₁_ab} :=
            hSideKer a hAffUa hAffVa hVa_le hUa_eq hKer_σa inf_le_left inf_le_left
          have hKer₂ : RingHom.ker σ_ab = Ideal.span {t₂_ab} :=
            hSideKer b hAffUb hAffVb hVb_le hUb_eq hKer_σb inf_le_right inf_le_right
          exact hKer₁.symm.trans hKer₂
        · 
          have hDisj_b_j₀ : Disjoint (V_cov b : Set C) (Set.range (τ j₀).base) :=
            (hSome_b j₁ htag_b).1 j₀ hj
          have hDisj_a_j₁ : Disjoint (V_cov a : Set C) (Set.range (τ j₁).base) :=
            (hSome_a j₀ htag_a).1 j₁ (Ne.symm hj)
          have hUnit₁ : IsUnit t₁_ab :=
            hDisjUnit a j₀ htag_a V_ab hAffV_ab inf_le_left
              (Disjoint.mono_left (inf_le_right : V_ab ≤ V_cov b) hDisj_b_j₀)
          have hUnit₂ : IsUnit t₂_ab :=
            hDisjUnit b j₁ htag_b V_ab hAffV_ab inf_le_right
              (Disjoint.mono_left (inf_le_left : V_ab ≤ V_cov a) hDisj_a_j₁)
          rw [Ideal.span_singleton_eq_top.mpr hUnit₁, Ideal.span_singleton_eq_top.mpr hUnit₂]

  
  
  
  have hAffU_chart : ∀ a : Fin m, AlgebraicGeometry.IsAffineOpen (U_base a) :=
    fun a => (hCharts a).1
  have hAffV_chart : ∀ a : Fin m, AlgebraicGeometry.IsAffineOpen (V_cov a) :=
    fun a => (hCharts a).2.1
  have hV_le_chart : ∀ a : Fin m,
      V_cov a ≤ (TopologicalSpace.Opens.map g.base).obj (U_base a) :=
    fun a => (hCharts a).2.2.choose
  have hChartSpec : ∀ a : Fin m,
      (π_lci a).comp MvPolynomial.C = (g.appLE (U_base a) (V_cov a) (hV_le_chart a)).hom ∧
      Function.Surjective (π_lci a) ∧
      RingHom.ker (π_lci a) = Ideal.span (Set.range (F_lci a)) := by
    intro a
    have h := (hCharts a).2.2.choose_spec
    exact ⟨h.1, h.2.1, h.2.2.1⟩

  have hBinaryGluing : ∀ a b : Fin m,
      let A_ab := ↑(S.presheaf.obj (Opposite.op (U_base a ⊓ U_base b)))
      let B_ab := ↑(C.presheaf.obj (Opposite.op (V_cov a ⊓ V_cov b)))
      let h_ab : V_cov a ⊓ V_cov b ≤
          (TopologicalSpace.Opens.map g.base).obj (U_base a ⊓ U_base b) :=
        inf_le_inf (hV_le_chart a) (hV_le_chart b)
      letI : Algebra A_ab B_ab :=
        (g.appLE (U_base a ⊓ U_base b) (V_cov a ⊓ V_cov b) h_ab).hom.toAlgebra
      ∃ (u_ab : B_abˣ) (ψ_ov : KaehlerDifferential A_ab B_ab →ₗ[B_ab] B_ab),
        (∀ r : Fin (k_lci a + 1),
          ψ_ov (KaehlerDifferential.D A_ab B_ab
            ((C.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : V_cov a ⊓ V_cov b ≤ V_cov a)).op).hom
              (π_lci a (MvPolynomial.X r)))) =
            (C.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : V_cov a ⊓ V_cov b ≤ V_cov a)).op).hom
              (t_mark a * (-1) ^ (r : ℕ) *
                Matrix.det ((Matrix.of fun (i : Fin (k_lci a + 1)) (j : Fin (k_lci a)) =>
                  π_lci a (MvPolynomial.pderiv i (F_lci a j))).submatrix r.succAbove id))) ∧
        (∀ s : Fin (k_lci b + 1),
          ψ_ov (KaehlerDifferential.D A_ab B_ab
            ((C.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : V_cov a ⊓ V_cov b ≤ V_cov b)).op).hom
              (π_lci b (MvPolynomial.X s)))) =
            u_ab.val *
              (C.presheaf.map
                (CategoryTheory.homOfLE (inf_le_right : V_cov a ⊓ V_cov b ≤ V_cov b)).op).hom
                (t_mark b * (-1) ^ (s : ℕ) *
                  Matrix.det ((Matrix.of fun (i : Fin (k_lci b + 1)) (j : Fin (k_lci b)) =>
                    π_lci b (MvPolynomial.pderiv i (F_lci b j))).submatrix s.succAbove id))) := by
    intro a b
    let U_ab : S.Opens := U_base a ⊓ U_base b
    let V_ab : C.Opens := V_cov a ⊓ V_cov b
    have hAffU_ab : AlgebraicGeometry.IsAffineOpen U_ab :=
      hGeomInter S hSepS (U_base a) (U_base b) (hAffU_chart a) (hAffU_chart b)
    have hAffV_ab : AlgebraicGeometry.IsAffineOpen V_ab :=
      hGeomInter C hSepC (V_cov a) (V_cov b) (hAffV_chart a) (hAffV_chart b)
    let A_ab := ↑(S.presheaf.obj (Opposite.op U_ab))
    let B_ab := ↑(C.presheaf.obj (Opposite.op V_ab))
    have h_ab : V_ab ≤ (TopologicalSpace.Opens.map g.base).obj U_ab :=
      inf_le_inf (hV_le_chart a) (hV_le_chart b)
    letI : Algebra A_ab B_ab := (g.appLE U_ab V_ab h_ab).hom.toAlgebra
    let res₁ := (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V_ab ≤ V_cov a)).op).hom
    let res₂ := (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_ab ≤ V_cov b)).op).hom
    obtain ⟨hπC_a, hπSurj_a, hπKer_a⟩ := hChartSpec a
    obtain ⟨hπC_b, hπSurj_b, hπKer_b⟩ := hChartSpec b
    obtain ⟨⟨hq₁_surj, hq₁_ker⟩, _hCof₁, _hJ₁_inj⟩ :=
      hSubchart (U_base a) (hAffU_chart a) (V_cov a) (hAffV_chart a) (hV_le_chart a)
        (k_lci a) (π_lci a) (F_lci a) hπC_a hπSurj_a hπKer_a
        U_ab hAffU_ab inf_le_left V_ab hAffV_ab inf_le_left h_ab
    obtain ⟨⟨hq₂_surj, hq₂_ker⟩, _hCof₂, hJ₂_inj⟩ :=
      hSubchart (U_base b) (hAffU_chart b) (V_cov b) (hAffV_chart b) (hV_le_chart b)
        (k_lci b) (π_lci b) (F_lci b) hπC_b hπSurj_b hπKer_b
        U_ab hAffU_ab inf_le_right V_ab hAffV_ab inf_le_right h_ab
    let J₁ : Matrix (Fin (k_lci a + 1)) (Fin (k_lci a)) B_ab :=
      Matrix.of fun i j => res₁ (π_lci a (MvPolynomial.pderiv i (F_lci a j)))
    let q₁ : (Fin (k_lci a + 1) → B_ab) →ₗ[B_ab] KaehlerDifferential A_ab B_ab :=
      LinearMap.lsum B_ab (fun _ : Fin (k_lci a + 1) => B_ab) B_ab fun r =>
        LinearMap.toSpanSingleton B_ab (KaehlerDifferential A_ab B_ab)
          (KaehlerDifferential.D A_ab B_ab (res₁ (π_lci a (MvPolynomial.X r))))
    let J₂ : Matrix (Fin (k_lci b + 1)) (Fin (k_lci b)) B_ab :=
      Matrix.of fun i j => res₂ (π_lci b (MvPolynomial.pderiv i (F_lci b j)))
    let q₂ : (Fin (k_lci b + 1) → B_ab) →ₗ[B_ab] KaehlerDifferential A_ab B_ab :=
      LinearMap.lsum B_ab (fun _ : Fin (k_lci b + 1) => B_ab) B_ab fun s =>
        LinearMap.toSpanSingleton B_ab (KaehlerDifferential A_ab B_ab)
          (KaehlerDifferential.D A_ab B_ab (res₂ (π_lci b (MvPolynomial.X s))))
    obtain ⟨_hJ₁_inj', ψ₁, ψ₂, u'_ab, hψ₁_eq, hψ₂_eq, hψ₁₂⟩ :=
      hCramer B_ab (KaehlerDifferential A_ab B_ab) (k_lci a) (k_lci b) J₁ q₁ J₂ q₂
        hq₁_surj hq₁_ker hq₂_surj hq₂_ker hJ₂_inj
    obtain ⟨v_ab, hv_ab⟩ := hMarkUnitRatio a b
    refine ⟨u'_ab * v_ab, res₁ (t_mark a) • ψ₁, ?_, ?_⟩
    · intro r
      let J_a_raw : Matrix (Fin (k_lci a + 1)) (Fin (k_lci a))
          ↑(C.presheaf.obj (Opposite.op (V_cov a))) :=
        Matrix.of fun i j => π_lci a (MvPolynomial.pderiv i (F_lci a j))
      have hq₁_single : q₁ (Pi.single r (1 : B_ab)) =
          KaehlerDifferential.D A_ab B_ab (res₁ (π_lci a (MvPolynomial.X r))) :=
        hEvalQSingle _ r
      have hψ₁_r : ψ₁ (KaehlerDifferential.D A_ab B_ab (res₁ (π_lci a (MvPolynomial.X r)))) =
          (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id) := by
        rw [← hq₁_single]
        have h := hψ₁_eq (Pi.single r (1 : B_ab))
        simp only [mul_assoc] at h
        rw [h, hSumPiSingle]
      have hMapΔ : res₁ ((-1) ^ (r : ℕ) * Matrix.det (J_a_raw.submatrix r.succAbove id)) =
          (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id) :=
        hMapCofactor res₁ J_a_raw r
      change res₁ (t_mark a) *
          ψ₁ (KaehlerDifferential.D A_ab B_ab (res₁ (π_lci a (MvPolynomial.X r)))) =
        res₁ (t_mark a * (-1) ^ (r : ℕ) * Matrix.det (J_a_raw.submatrix r.succAbove id))
      rw [hψ₁_r, ← hMapΔ, ← map_mul, mul_assoc]
    · intro s
      let J_b_raw : Matrix (Fin (k_lci b + 1)) (Fin (k_lci b))
          ↑(C.presheaf.obj (Opposite.op (V_cov b))) :=
        Matrix.of fun i j => π_lci b (MvPolynomial.pderiv i (F_lci b j))
      have hq₂_single : q₂ (Pi.single s (1 : B_ab)) =
          KaehlerDifferential.D A_ab B_ab (res₂ (π_lci b (MvPolynomial.X s))) :=
        hEvalQSingle _ s
      have hψ₂_s : ψ₂ (KaehlerDifferential.D A_ab B_ab (res₂ (π_lci b (MvPolynomial.X s)))) =
          (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id) := by
        rw [← hq₂_single]
        have h := hψ₂_eq (Pi.single s (1 : B_ab))
        simp only [mul_assoc] at h
        rw [h, hSumPiSingle]
      have hMapΔ : res₂ ((-1) ^ (s : ℕ) * Matrix.det (J_b_raw.submatrix s.succAbove id)) =
          (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id) :=
        hMapCofactor res₂ J_b_raw s
      change res₁ (t_mark a) *
          ψ₁ (KaehlerDifferential.D A_ab B_ab (res₂ (π_lci b (MvPolynomial.X s)))) =
        (u'_ab.val * v_ab.val) *
          res₂ (t_mark b * (-1) ^ (s : ℕ) * Matrix.det (J_b_raw.submatrix s.succAbove id))
      have hψ₁_s : ψ₁ (KaehlerDifferential.D A_ab B_ab (res₂ (π_lci b (MvPolynomial.X s)))) =
          u'_ab.val * ((-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) := by
        rw [hψ₁₂]; exact congrArg (u'_ab.val * ·) hψ₂_s
      rw [hψ₁_s, ← hMapΔ, hv_ab]
      calc (v_ab.val * res₂ (t_mark b)) *
            (u'_ab.val * res₂ ((-1) ^ (s : ℕ) * Matrix.det (J_b_raw.submatrix s.succAbove id)))
          = (u'_ab.val * v_ab.val) *
              (res₂ (t_mark b) *
                res₂ ((-1) ^ (s : ℕ) * Matrix.det (J_b_raw.submatrix s.succAbove id))) := by ring
        _ = (u'_ab.val * v_ab.val) *
              res₂ (t_mark b * (-1) ^ (s : ℕ) * Matrix.det (J_b_raw.submatrix s.succAbove id)) := by
            rw [← map_mul, ← mul_assoc (t_mark b)]

  let u : ∀ a b : Fin m, (↑(C.presheaf.obj (Opposite.op (V_cov a ⊓ V_cov b))))ˣ :=
    fun a b => (hBinaryGluing a b).choose
  let ψ_ov : ∀ a b : Fin m,
      let A_ab := ↑(S.presheaf.obj (Opposite.op (U_base a ⊓ U_base b)))
      let B_ab := ↑(C.presheaf.obj (Opposite.op (V_cov a ⊓ V_cov b)))
      let h_ab : V_cov a ⊓ V_cov b ≤
          (TopologicalSpace.Opens.map g.base).obj (U_base a ⊓ U_base b) :=
        inf_le_inf (hV_le_chart a) (hV_le_chart b)
      letI : Algebra A_ab B_ab :=
        (g.appLE (U_base a ⊓ U_base b) (V_cov a ⊓ V_cov b) h_ab).hom.toAlgebra
      KaehlerDifferential A_ab B_ab →ₗ[B_ab] B_ab :=
    fun a b => (hBinaryGluing a b).choose_spec.choose
  have hψ_ov_spec : ∀ a b : Fin m,
      let A_ab := ↑(S.presheaf.obj (Opposite.op (U_base a ⊓ U_base b)))
      let B_ab := ↑(C.presheaf.obj (Opposite.op (V_cov a ⊓ V_cov b)))
      let h_ab : V_cov a ⊓ V_cov b ≤
          (TopologicalSpace.Opens.map g.base).obj (U_base a ⊓ U_base b) :=
        inf_le_inf (hV_le_chart a) (hV_le_chart b)
      letI : Algebra A_ab B_ab :=
        (g.appLE (U_base a ⊓ U_base b) (V_cov a ⊓ V_cov b) h_ab).hom.toAlgebra
      (∀ r : Fin (k_lci a + 1),
        ψ_ov a b (KaehlerDifferential.D A_ab B_ab
          ((C.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : V_cov a ⊓ V_cov b ≤ V_cov a)).op).hom
            (π_lci a (MvPolynomial.X r)))) =
          (C.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : V_cov a ⊓ V_cov b ≤ V_cov a)).op).hom
            (t_mark a * (-1) ^ (r : ℕ) *
              Matrix.det ((Matrix.of fun (i : Fin (k_lci a + 1)) (j : Fin (k_lci a)) =>
                π_lci a (MvPolynomial.pderiv i (F_lci a j))).submatrix r.succAbove id))) ∧
      (∀ s : Fin (k_lci b + 1),
        ψ_ov a b (KaehlerDifferential.D A_ab B_ab
          ((C.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : V_cov a ⊓ V_cov b ≤ V_cov b)).op).hom
            (π_lci b (MvPolynomial.X s)))) =
          (u a b).val *
            (C.presheaf.map
              (CategoryTheory.homOfLE (inf_le_right : V_cov a ⊓ V_cov b ≤ V_cov b)).op).hom
              (t_mark b * (-1) ^ (s : ℕ) *
                Matrix.det ((Matrix.of fun (i : Fin (k_lci b + 1)) (j : Fin (k_lci b)) =>
                  π_lci b (MvPolynomial.pderiv i (F_lci b j))).submatrix s.succAbove id))) :=
    fun a b => (hBinaryGluing a b).choose_spec.choose_spec

  
  have u_refl : ∀ a : Fin m, (u a a).val = 1 := by
    intro a
    let U_aa : S.Opens := U_base a ⊓ U_base a
    let V_aa : C.Opens := V_cov a ⊓ V_cov a
    have hAffU_aa : AlgebraicGeometry.IsAffineOpen U_aa :=
      hGeomInter S hSepS (U_base a) (U_base a) (hAffU_chart a) (hAffU_chart a)
    have hAffV_aa : AlgebraicGeometry.IsAffineOpen V_aa :=
      hGeomInter C hSepC (V_cov a) (V_cov a) (hAffV_chart a) (hAffV_chart a)
    have h_aa : V_aa ≤ (TopologicalSpace.Opens.map g.base).obj U_aa :=
      inf_le_inf (hV_le_chart a) (hV_le_chart a)
    obtain ⟨hπC_a, hπSurj_a, hπKer_a⟩ := hChartSpec a
    obtain ⟨_hq_aa, hCof_aa, _hJ_aa⟩ :=
      hSubchart (U_base a) (hAffU_chart a) (V_cov a) (hAffV_chart a) (hV_le_chart a)
        (k_lci a) (π_lci a) (F_lci a) hπC_a hπSurj_a hπKer_a
        U_aa hAffU_aa inf_le_left V_aa hAffV_aa inf_le_left h_aa
    let A_aa := ↑(S.presheaf.obj (Opposite.op U_aa))
    let B_aa := ↑(C.presheaf.obj (Opposite.op V_aa))
    letI : Algebra A_aa B_aa := (g.appLE U_aa V_aa h_aa).hom.toAlgebra
    let res_l : ↑(C.presheaf.obj (Opposite.op (V_cov a))) →+* B_aa :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V_aa ≤ V_cov a)).op).hom
    let res_r : ↑(C.presheaf.obj (Opposite.op (V_cov a))) →+* B_aa :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_aa ≤ V_cov a)).op).hom
    have hResEq : res_l = res_r := by
      change (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V_aa ≤ V_cov a)).op).hom =
        (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_aa ≤ V_cov a)).op).hom
      rw [hPresheafHomEq C
        (CategoryTheory.homOfLE (inf_le_left : V_aa ≤ V_cov a)).op
        (CategoryTheory.homOfLE (inf_le_right : V_aa ≤ V_cov a)).op]
    let J_a_raw : Matrix (Fin (k_lci a + 1)) (Fin (k_lci a))
        ↑(C.presheaf.obj (Opposite.op (V_cov a))) :=
      Matrix.of fun i j => π_lci a (MvPolynomial.pderiv i (F_lci a j))
    let J_aa : Matrix (Fin (k_lci a + 1)) (Fin (k_lci a)) B_aa :=
      Matrix.of fun i j => res_l (π_lci a (MvPolynomial.pderiv i (F_lci a j)))
    apply sub_eq_zero.mp
    apply hCof_aa ((u a a).val - 1)
    intro r
    have hLeft := (hψ_ov_spec a a).1 r
    have hRight := (hψ_ov_spec a a).2 r
    change ψ_ov a a (KaehlerDifferential.D A_aa B_aa (res_l (π_lci a (MvPolynomial.X r)))) =
      res_l (t_mark a * (-1) ^ (r : ℕ) * Matrix.det (J_a_raw.submatrix r.succAbove id)) at hLeft
    change ψ_ov a a (KaehlerDifferential.D A_aa B_aa (res_r (π_lci a (MvPolynomial.X r)))) =
      (u a a).val *
        res_r (t_mark a * (-1) ^ (r : ℕ) * Matrix.det (J_a_raw.submatrix r.succAbove id)) at hRight
    rw [← hResEq, hLeft] at hRight
    have hMapΔ : res_l ((-1) ^ (r : ℕ) * Matrix.det (J_a_raw.submatrix r.succAbove id)) =
        (-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id) :=
      hMapCofactor res_l J_a_raw r
    have hProdEq : res_l (t_mark a) *
        ((-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id)) =
      (u a a).val * (res_l (t_mark a) *
        ((-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id))) := by
      have hMul : res_l (t_mark a * (-1) ^ (r : ℕ) *
          Matrix.det (J_a_raw.submatrix r.succAbove id)) =
        res_l (t_mark a) * ((-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id)) := by
        rw [mul_assoc, map_mul, hMapΔ]
      rwa [hMul] at hRight
    have hMarkCancel :
        ((-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id) * ((u a a).val - 1)) *
          res_l (t_mark a) = 0 := by
      calc ((-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id) * ((u a a).val - 1)) *
            res_l (t_mark a)
          = (u a a).val * (res_l (t_mark a) *
              ((-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id))) -
            res_l (t_mark a) *
              ((-1) ^ (r : ℕ) * Matrix.det (J_aa.submatrix r.succAbove id)) := by ring
        _ = 0 := by rw [← hProdEq, sub_self]
    exact hMarkNzd a V_aa hAffV_aa inf_le_left _ hMarkCancel

  
  
  
  have hPullbackFunctional : ∀ {U_pq U_tri : S.Opens} {V_pq V_tri : C.Opens}
      (hAffU_pq : AlgebraicGeometry.IsAffineOpen U_pq)
      (hAffU_tri : AlgebraicGeometry.IsAffineOpen U_tri)
      (hAffV_pq : AlgebraicGeometry.IsAffineOpen V_pq)
      (hAffV_tri : AlgebraicGeometry.IsAffineOpen V_tri)
      (hU_sub : U_tri ≤ U_pq) (hV_sub : V_tri ≤ V_pq)
      (h_pq : V_pq ≤ (TopologicalSpace.Opens.map g.base).obj U_pq)
      (h_tri : V_tri ≤ (TopologicalSpace.Opens.map g.base).obj U_tri),
      let A_pq := ↑(S.presheaf.obj (Opposite.op U_pq))
      let B_pq := ↑(C.presheaf.obj (Opposite.op V_pq))
      let A_tri := ↑(S.presheaf.obj (Opposite.op U_tri))
      let B_tri := ↑(C.presheaf.obj (Opposite.op V_tri))
      letI : Algebra A_pq B_pq := (g.appLE U_pq V_pq h_pq).hom.toAlgebra
      letI : Algebra A_tri B_tri := (g.appLE U_tri V_tri h_tri).hom.toAlgebra
      ∀ (ψ_pq : KaehlerDifferential A_pq B_pq →ₗ[B_pq] B_pq),
        ∃ (Ψ_pq : KaehlerDifferential A_tri B_tri →ₗ[B_tri] B_tri),
          ∀ b_elem : B_pq,
            Ψ_pq (KaehlerDifferential.D A_tri B_tri
              ((C.presheaf.map (CategoryTheory.homOfLE hV_sub).op).hom b_elem)) =
              (C.presheaf.map (CategoryTheory.homOfLE hV_sub).op).hom
                (ψ_pq (KaehlerDifferential.D A_pq B_pq b_elem)) := by
    intro U_pq U_tri V_pq V_tri hAffU_pq hAffU_tri hAffV_pq hAffV_tri
      hU_sub hV_sub h_pq h_tri
    dsimp only
    intro ψ_pq
    let A_pq := ↑(S.presheaf.obj (Opposite.op U_pq))
    let B_pq := ↑(C.presheaf.obj (Opposite.op V_pq))
    let A_tri := ↑(S.presheaf.obj (Opposite.op U_tri))
    let B_tri := ↑(C.presheaf.obj (Opposite.op V_tri))
    let res_U : A_pq →+* A_tri := (S.presheaf.map (CategoryTheory.homOfLE hU_sub).op).hom
    let res_V : B_pq →+* B_tri := (C.presheaf.map (CategoryTheory.homOfLE hV_sub).op).hom
    letI : Algebra A_pq B_pq := (g.appLE U_pq V_pq h_pq).hom.toAlgebra
    letI : Algebra A_tri B_tri := (g.appLE U_tri V_tri h_tri).hom.toAlgebra
    letI : Algebra A_pq A_tri := res_U.toAlgebra
    letI : Algebra B_pq B_tri := res_V.toAlgebra
    letI : Algebra A_pq B_tri := (res_V.comp (g.appLE U_pq V_pq h_pq).hom).toAlgebra
    haveI : IsScalarTower A_pq B_pq B_tri := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower A_pq A_tri B_tri :=
      IsScalarTower.of_algebraMap_eq' (hSquareComm g hU_sub hV_sub h_pq h_tri).symm
    haveI : IsScalarTower B_pq B_tri B_tri := IsScalarTower.right
    haveI : Algebra.Etale A_pq A_tri :=
      RingHom.etale_algebraMap.mp (hGeomRes S U_pq U_tri hAffU_pq hAffU_tri hU_sub).1
    haveI : Algebra.FormallyEtale A_pq A_tri := inferInstance
    haveI : Algebra.FormallyUnramified A_pq A_tri := inferInstance
    haveI : Algebra.Etale B_pq B_tri :=
      RingHom.etale_algebraMap.mp (hGeomRes C V_pq V_tri hAffV_pq hAffV_tri hV_sub).1
    haveI : Algebra.FormallyEtale B_pq B_tri := inferInstance
    obtain ⟨e_Ω, he_Ω⟩ :=
      (hAlgBC A_pq B_pq A_tri B_tri (Or.inl ⟨inferInstance, inferInstance⟩)).1
    let Ψ_pq : KaehlerDifferential A_tri B_tri →ₗ[B_tri] B_tri :=
      (LinearMap.liftBaseChange B_tri ((Algebra.linearMap B_pq B_tri).comp ψ_pq)).comp
        e_Ω.symm.toLinearMap
    refine ⟨Ψ_pq, ?_⟩
    intro b_elem
    have he_symm : e_Ω.symm (KaehlerDifferential.D A_tri B_tri (res_V b_elem)) =
        TensorProduct.tmul B_pq (1 : B_tri) (KaehlerDifferential.D A_pq B_pq b_elem) := by
      apply e_Ω.injective
      rw [LinearEquiv.apply_symm_apply, he_Ω (1 : B_tri) b_elem, one_smul]
      rfl
    change (LinearMap.liftBaseChange B_tri ((Algebra.linearMap B_pq B_tri).comp ψ_pq))
        (e_Ω.symm (KaehlerDifferential.D A_tri B_tri (res_V b_elem))) =
      res_V (ψ_pq (KaehlerDifferential.D A_pq B_pq b_elem))
    rw [he_symm, LinearMap.liftBaseChange_one_tmul]
    rfl

  have u_cocycle : ∀ a b c : Fin m,
      let w₁ : V_cov a ⊓ V_cov b ⊓ V_cov c ⟶ V_cov a ⊓ V_cov b :=
        CategoryTheory.homOfLE inf_le_left
      let w₂ : V_cov a ⊓ V_cov b ⊓ V_cov c ⟶ V_cov b ⊓ V_cov c :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
      let w₃ : V_cov a ⊓ V_cov b ⊓ V_cov c ⟶ V_cov a ⊓ V_cov c :=
        CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
      (C.presheaf.map w₁.op).hom (u a b).val *
        (C.presheaf.map w₂.op).hom (u b c).val =
        (C.presheaf.map w₃.op).hom (u a c).val := by
    intro a b c
    let U_ab : S.Opens := U_base a ⊓ U_base b
    let U_bc : S.Opens := U_base b ⊓ U_base c
    let U_ac : S.Opens := U_base a ⊓ U_base c
    let U_abc : S.Opens := U_base a ⊓ U_base b ⊓ U_base c
    let V_ab : C.Opens := V_cov a ⊓ V_cov b
    let V_bc : C.Opens := V_cov b ⊓ V_cov c
    let V_ac : C.Opens := V_cov a ⊓ V_cov c
    let V_abc : C.Opens := V_cov a ⊓ V_cov b ⊓ V_cov c
    have hAffU_ab : AlgebraicGeometry.IsAffineOpen U_ab :=
      hGeomInter S hSepS (U_base a) (U_base b) (hAffU_chart a) (hAffU_chart b)
    have hAffU_bc : AlgebraicGeometry.IsAffineOpen U_bc :=
      hGeomInter S hSepS (U_base b) (U_base c) (hAffU_chart b) (hAffU_chart c)
    have hAffU_ac : AlgebraicGeometry.IsAffineOpen U_ac :=
      hGeomInter S hSepS (U_base a) (U_base c) (hAffU_chart a) (hAffU_chart c)
    have hAffU_abc : AlgebraicGeometry.IsAffineOpen U_abc :=
      hGeomInter S hSepS U_ab (U_base c) hAffU_ab (hAffU_chart c)
    have hAffV_ab : AlgebraicGeometry.IsAffineOpen V_ab :=
      hGeomInter C hSepC (V_cov a) (V_cov b) (hAffV_chart a) (hAffV_chart b)
    have hAffV_bc : AlgebraicGeometry.IsAffineOpen V_bc :=
      hGeomInter C hSepC (V_cov b) (V_cov c) (hAffV_chart b) (hAffV_chart c)
    have hAffV_ac : AlgebraicGeometry.IsAffineOpen V_ac :=
      hGeomInter C hSepC (V_cov a) (V_cov c) (hAffV_chart a) (hAffV_chart c)
    have hAffV_abc : AlgebraicGeometry.IsAffineOpen V_abc :=
      hGeomInter C hSepC V_ab (V_cov c) hAffV_ab (hAffV_chart c)
    have h_ab : V_ab ≤ (TopologicalSpace.Opens.map g.base).obj U_ab :=
      inf_le_inf (hV_le_chart a) (hV_le_chart b)
    have h_bc : V_bc ≤ (TopologicalSpace.Opens.map g.base).obj U_bc :=
      inf_le_inf (hV_le_chart b) (hV_le_chart c)
    have h_ac : V_ac ≤ (TopologicalSpace.Opens.map g.base).obj U_ac :=
      inf_le_inf (hV_le_chart a) (hV_le_chart c)
    have h_abc : V_abc ≤ (TopologicalSpace.Opens.map g.base).obj U_abc :=
      inf_le_inf h_ab (hV_le_chart c)
    let A_abc := ↑(S.presheaf.obj (Opposite.op U_abc))
    let B_abc := ↑(C.presheaf.obj (Opposite.op V_abc))
    letI : Algebra A_abc B_abc := (g.appLE U_abc V_abc h_abc).hom.toAlgebra
    let w₁ : V_abc ⟶ V_ab := CategoryTheory.homOfLE inf_le_left
    let w₂ : V_abc ⟶ V_bc := CategoryTheory.homOfLE (inf_le_inf inf_le_right (le_refl _))
    let w₃ : V_abc ⟶ V_ac := CategoryTheory.homOfLE (inf_le_inf inf_le_left (le_refl _))
    let res_a : ↑(C.presheaf.obj (Opposite.op (V_cov a))) →+* B_abc :=
      (C.presheaf.map
        (CategoryTheory.homOfLE (le_trans inf_le_left inf_le_left : V_abc ≤ V_cov a)).op).hom
    let res_b : ↑(C.presheaf.obj (Opposite.op (V_cov b))) →+* B_abc :=
      (C.presheaf.map
        (CategoryTheory.homOfLE (le_trans inf_le_left inf_le_right : V_abc ≤ V_cov b)).op).hom
    let res_c : ↑(C.presheaf.obj (Opposite.op (V_cov c))) →+* B_abc :=
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V_abc ≤ V_cov c)).op).hom
    have hResComp : ∀ {V_d V_pq : C.Opens} (h₁ : V_abc ≤ V_pq) (h₂ : V_pq ≤ V_d)
        (h₃ : V_abc ≤ V_d) (x : ↑(C.presheaf.obj (Opposite.op V_d))),
        (C.presheaf.map (CategoryTheory.homOfLE h₁).op).hom
            ((C.presheaf.map (CategoryTheory.homOfLE h₂).op).hom x) =
          (C.presheaf.map (CategoryTheory.homOfLE h₃).op).hom x := by
      intro V_d V_pq h₁ h₂ h₃ x
      change ((C.presheaf.map (CategoryTheory.homOfLE h₂).op ≫
          C.presheaf.map (CategoryTheory.homOfLE h₁).op).hom) x = _
      rw [← C.presheaf.map_comp,
        hPresheafHomEq C
          ((CategoryTheory.homOfLE h₂).op ≫ (CategoryTheory.homOfLE h₁).op)
          (CategoryTheory.homOfLE h₃).op]
    obtain ⟨Ψ_ab, hΨ_ab⟩ :=
      hPullbackFunctional hAffU_ab hAffU_abc hAffV_ab hAffV_abc
        inf_le_left inf_le_left h_ab h_abc (ψ_ov a b)
    obtain ⟨Ψ_bc, hΨ_bc⟩ :=
      hPullbackFunctional hAffU_bc hAffU_abc hAffV_bc hAffV_abc
        (inf_le_inf inf_le_right (le_refl _)) (inf_le_inf inf_le_right (le_refl _))
        h_bc h_abc (ψ_ov b c)
    obtain ⟨Ψ_ac, hΨ_ac⟩ :=
      hPullbackFunctional hAffU_ac hAffU_abc hAffV_ac hAffV_abc
        (inf_le_inf inf_le_left (le_refl _)) (inf_le_inf inf_le_left (le_refl _))
        h_ac h_abc (ψ_ov a c)
    obtain ⟨hπC_a, hπSurj_a, hπKer_a⟩ := hChartSpec a
    obtain ⟨hπC_b, hπSurj_b, hπKer_b⟩ := hChartSpec b
    obtain ⟨hπC_c, hπSurj_c, hπKer_c⟩ := hChartSpec c
    obtain ⟨⟨hq_a_abc_surj, _⟩, _, _⟩ :=
      hSubchart (U_base a) (hAffU_chart a) (V_cov a) (hAffV_chart a) (hV_le_chart a)
        (k_lci a) (π_lci a) (F_lci a) hπC_a hπSurj_a hπKer_a
        U_abc hAffU_abc (le_trans inf_le_left inf_le_left)
        V_abc hAffV_abc (le_trans inf_le_left inf_le_left) h_abc
    obtain ⟨⟨hq_b_abc_surj, _⟩, _, _⟩ :=
      hSubchart (U_base b) (hAffU_chart b) (V_cov b) (hAffV_chart b) (hV_le_chart b)
        (k_lci b) (π_lci b) (F_lci b) hπC_b hπSurj_b hπKer_b
        U_abc hAffU_abc (le_trans inf_le_left inf_le_right)
        V_abc hAffV_abc (le_trans inf_le_left inf_le_right) h_abc
    obtain ⟨_, hCof_c_abc, _⟩ :=
      hSubchart (U_base c) (hAffU_chart c) (V_cov c) (hAffV_chart c) (hV_le_chart c)
        (k_lci c) (π_lci c) (F_lci c) hπC_c hπSurj_c hπKer_c
        U_abc hAffU_abc inf_le_right V_abc hAffV_abc inf_le_right h_abc
    let δ_chart : ∀ d : Fin m, Fin (k_lci d + 1) → ↑(C.presheaf.obj (Opposite.op (V_cov d))) :=
      fun d r =>
        t_mark d * (-1) ^ (r : ℕ) *
          Matrix.det ((Matrix.of fun (i : Fin (k_lci d + 1)) (j : Fin (k_lci d)) =>
            π_lci d (MvPolynomial.pderiv i (F_lci d j))).submatrix r.succAbove id)
    
    have hΨ_ac_eq_ab : Ψ_ac = Ψ_ab := by
      apply hSpanPin
        (fun r : Fin (k_lci a + 1) =>
          KaehlerDifferential.D A_abc B_abc (res_a (π_lci a (MvPolynomial.X r))))
        hq_a_abc_surj
      intro r
      have h₁ : Ψ_ac (KaehlerDifferential.D A_abc B_abc (res_a (π_lci a (MvPolynomial.X r)))) =
          res_a (δ_chart a r) := by
        rw [← hResComp (inf_le_inf inf_le_left (le_refl _)) inf_le_left
          (le_trans inf_le_left inf_le_left) (π_lci a (MvPolynomial.X r)),
          hΨ_ac, (hψ_ov_spec a c).1 r,
          hResComp (inf_le_inf inf_le_left (le_refl _)) inf_le_left
            (le_trans inf_le_left inf_le_left) (δ_chart a r)]
      have h₂ : Ψ_ab (KaehlerDifferential.D A_abc B_abc (res_a (π_lci a (MvPolynomial.X r)))) =
          res_a (δ_chart a r) := by
        rw [← hResComp inf_le_left inf_le_left
          (le_trans inf_le_left inf_le_left) (π_lci a (MvPolynomial.X r)),
          hΨ_ab, (hψ_ov_spec a b).1 r,
          hResComp inf_le_left inf_le_left
            (le_trans inf_le_left inf_le_left) (δ_chart a r)]
      exact h₁.trans h₂.symm
    
    have hΨ_ab_eq_bc : Ψ_ab = ((C.presheaf.map w₁.op).hom (u a b).val) • Ψ_bc := by
      apply hSpanPin
        (fun s : Fin (k_lci b + 1) =>
          KaehlerDifferential.D A_abc B_abc (res_b (π_lci b (MvPolynomial.X s))))
        hq_b_abc_surj
      intro s
      have h₁ : Ψ_ab (KaehlerDifferential.D A_abc B_abc (res_b (π_lci b (MvPolynomial.X s)))) =
          (C.presheaf.map w₁.op).hom (u a b).val * res_b (δ_chart b s) := by
        rw [← hResComp inf_le_left inf_le_right
          (le_trans inf_le_left inf_le_right) (π_lci b (MvPolynomial.X s)),
          hΨ_ab, (hψ_ov_spec a b).2 s, map_mul,
          hResComp inf_le_left inf_le_right
            (le_trans inf_le_left inf_le_right) (δ_chart b s)]
      have h₂ : (((C.presheaf.map w₁.op).hom (u a b).val) • Ψ_bc)
            (KaehlerDifferential.D A_abc B_abc (res_b (π_lci b (MvPolynomial.X s)))) =
          (C.presheaf.map w₁.op).hom (u a b).val * res_b (δ_chart b s) := by
        change (C.presheaf.map w₁.op).hom (u a b).val *
            Ψ_bc (KaehlerDifferential.D A_abc B_abc (res_b (π_lci b (MvPolynomial.X s)))) = _
        rw [← hResComp (inf_le_inf inf_le_right (le_refl _)) inf_le_left
          (le_trans inf_le_left inf_le_right) (π_lci b (MvPolynomial.X s)),
          hΨ_bc, (hψ_ov_spec b c).1 s,
          hResComp (inf_le_inf inf_le_right (le_refl _)) inf_le_left
            (le_trans inf_le_left inf_le_right) (δ_chart b s)]
      exact h₁.trans h₂.symm
    have hΨ_ac_eq_bc : Ψ_ac = ((C.presheaf.map w₁.op).hom (u a b).val) • Ψ_bc :=
      hΨ_ac_eq_ab.trans hΨ_ab_eq_bc
    
    let u₁₂_abc : B_abc := (C.presheaf.map w₁.op).hom (u a b).val
    let u₂₃_abc : B_abc := (C.presheaf.map w₂.op).hom (u b c).val
    let u₁₃_abc : B_abc := (C.presheaf.map w₃.op).hom (u a c).val
    let J_c_raw : Matrix (Fin (k_lci c + 1)) (Fin (k_lci c))
        ↑(C.presheaf.obj (Opposite.op (V_cov c))) :=
      Matrix.of fun i j => π_lci c (MvPolynomial.pderiv i (F_lci c j))
    let J_c_abc : Matrix (Fin (k_lci c + 1)) (Fin (k_lci c)) B_abc :=
      Matrix.of fun i j => res_c (π_lci c (MvPolynomial.pderiv i (F_lci c j)))
    apply sub_eq_zero.mp
    apply hCof_c_abc (u₁₂_abc * u₂₃_abc - u₁₃_abc)
    intro l
    have hEval_ac : Ψ_ac (KaehlerDifferential.D A_abc B_abc (res_c (π_lci c (MvPolynomial.X l)))) =
        u₁₃_abc * res_c (δ_chart c l) := by
      rw [← hResComp (inf_le_inf inf_le_left (le_refl _)) inf_le_right
        inf_le_right (π_lci c (MvPolynomial.X l)),
        hΨ_ac, (hψ_ov_spec a c).2 l, map_mul,
        hResComp (inf_le_inf inf_le_left (le_refl _)) inf_le_right
          inf_le_right (δ_chart c l)]
    have hEval_bc : Ψ_bc (KaehlerDifferential.D A_abc B_abc (res_c (π_lci c (MvPolynomial.X l)))) =
        u₂₃_abc * res_c (δ_chart c l) := by
      rw [← hResComp (inf_le_inf inf_le_right (le_refl _)) inf_le_right
        inf_le_right (π_lci c (MvPolynomial.X l)),
        hΨ_bc, (hψ_ov_spec b c).2 l, map_mul,
        hResComp (inf_le_inf inf_le_right (le_refl _)) inf_le_right
          inf_le_right (δ_chart c l)]
    have hEqAt_l : u₁₃_abc * res_c (δ_chart c l) =
        u₁₂_abc * (u₂₃_abc * res_c (δ_chart c l)) := by
      have hFun := LinearMap.congr_fun hΨ_ac_eq_bc
        (KaehlerDifferential.D A_abc B_abc (res_c (π_lci c (MvPolynomial.X l))))
      change Ψ_ac (KaehlerDifferential.D A_abc B_abc (res_c (π_lci c (MvPolynomial.X l)))) =
        u₁₂_abc * Ψ_bc (KaehlerDifferential.D A_abc B_abc (res_c (π_lci c (MvPolynomial.X l)))) at hFun
      rwa [hEval_ac, hEval_bc] at hFun
    have hMapΔ : res_c ((-1) ^ (l : ℕ) * Matrix.det (J_c_raw.submatrix l.succAbove id)) =
        (-1) ^ (l : ℕ) * Matrix.det (J_c_abc.submatrix l.succAbove id) :=
      hMapCofactor res_c J_c_raw l
    have hResδ : res_c (δ_chart c l) =
        res_c (t_mark c) * ((-1) ^ (l : ℕ) * Matrix.det (J_c_abc.submatrix l.succAbove id)) := by
      change res_c (t_mark c * (-1) ^ (l : ℕ) * Matrix.det (J_c_raw.submatrix l.succAbove id)) = _
      rw [mul_assoc, map_mul, hMapΔ]
    rw [hResδ] at hEqAt_l
    have hMarkCancel :
        ((-1) ^ (l : ℕ) * Matrix.det (J_c_abc.submatrix l.succAbove id) *
          (u₁₂_abc * u₂₃_abc - u₁₃_abc)) * res_c (t_mark c) = 0 := by
      calc ((-1) ^ (l : ℕ) * Matrix.det (J_c_abc.submatrix l.succAbove id) *
            (u₁₂_abc * u₂₃_abc - u₁₃_abc)) * res_c (t_mark c)
          = u₁₂_abc * (u₂₃_abc * (res_c (t_mark c) *
              ((-1) ^ (l : ℕ) * Matrix.det (J_c_abc.submatrix l.succAbove id)))) -
            u₁₃_abc * (res_c (t_mark c) *
              ((-1) ^ (l : ℕ) * Matrix.det (J_c_abc.submatrix l.succAbove id))) := by ring
        _ = 0 := by rw [← hEqAt_l, sub_self]
    exact hMarkNzd c V_abc hAffV_abc inf_le_right _ hMarkCancel

  
  let M : WeilLineBundle C :=
    { m := m
      V := V_cov
      hCov := hCov
      u := u
      u_refl := u_refl
      u_cocycle := u_cocycle }
  refine ⟨M, hAffV_chart, U_base, k_lci, π_lci, F_lci, tag, t_mark, hV_le_chart, hCharts, ?_⟩
  intro a b
  exact ⟨ψ_ov a b, hψ_ov_spec a b⟩

theorem weil_geomFiber_log_canonical_of_relative_atlas (S : AlgebraicGeometry.Scheme.{u})
    (hSepS : S.IsSeparated)
    (C : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S) (n : ℕ) (τ : Fin n → (S ⟶ C))
    (hStab : IsGeometricStablePointedCurve g n τ)
    (M : WeilLineBundle C)
    (hAtlas : IsRelativeLogCanonicalAtlas g n τ M)
    (hPullback : ∀ (S' : AlgebraicGeometry.Scheme.{u}) (f_S : S' ⟶ S),
      ∃ τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g f_S),
        (∀ j : Fin n,
          τ' j ≫ CategoryTheory.Limits.pullback.fst g f_S = f_S ≫ τ j ∧
          τ' j ≫ CategoryTheory.Limits.pullback.snd g f_S = 𝟙 S' ∧
          Set.range (τ' j).base =
            (CategoryTheory.Limits.pullback.fst g f_S).base ⁻¹' Set.range (τ j).base) ∧
        IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g f_S) n τ')
    (hCramer : ∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k₁ k₂ : ℕ)
      (J₁ : Matrix (Fin (k₁ + 1)) (Fin k₁) B)
      (q₁ : (Fin (k₁ + 1) → B) →ₗ[B] Ω_mod)
      (J₂ : Matrix (Fin (k₂ + 1)) (Fin k₂) B)
      (q₂ : (Fin (k₂ + 1) → B) →ₗ[B] Ω_mod),
      Function.Surjective q₁ →
      LinearMap.ker q₁ = LinearMap.range J₁.mulVecLin →
      Function.Surjective q₂ →
      LinearMap.ker q₂ = LinearMap.range J₂.mulVecLin →
      Function.Injective J₂.mulVecLin →
      Function.Injective J₁.mulVecLin ∧
      ∃ (ψ₁ ψ₂ : Ω_mod →ₗ[B] B) (u : Bˣ),
        (∀ v : Fin (k₁ + 1) → B,
          ψ₁ (q₁ v) = ∑ r : Fin (k₁ + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J₁.submatrix r.succAbove id)) ∧
        (∀ w : Fin (k₂ + 1) → B,
          ψ₂ (q₂ w) = ∑ s : Fin (k₂ + 1),
            w s * (-1) ^ (s : ℕ) * Matrix.det (J₂.submatrix s.succAbove id)) ∧
        ψ₁ = u.val • ψ₂)
    (hAlg : HasWeilLciKaehlerAndNodalAlgebra.{u})
    (hGeom : HasWeilSeparatedAffineAndFiberPushout.{u}) :
    ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (M_s : WeilLineBundle (CategoryTheory.Limits.pullback g s)),
      WeilPullbackLineBundle (CategoryTheory.Limits.pullback.fst g s) M M_s →
      ∃ τ_s : Fin n →
          (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ CategoryTheory.Limits.pullback g s),
        IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g s) n τ_s ∧
        IsGeometricFiberLogCanonical (CategoryTheory.Limits.pullback.snd g s) n τ_s M_s :=
by
  intro Ω _ _ s M_s hPb
  classical
  let C_s : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g s
  let fst : C_s ⟶ C := CategoryTheory.Limits.pullback.fst g s
  let snd : C_s ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
    CategoryTheory.Limits.pullback.snd g s
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := default
  have hSubSpecΩ : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
    (inferInstance : Unique ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))).instSubsingleton
  have hPt₀_eq : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), q = pt₀ :=
    fun q => @Subsingleton.elim _ hSubSpecΩ q pt₀
  obtain ⟨τ_s, hτ_s, hStab_s⟩ := hPullback (AlgebraicGeometry.Spec (CommRingCat.of Ω)) s
  obtain ⟨hAffM, U_base, k_lci, π_lci, F_lci, tag, t_mark, hV_le, hCharts, hOvAtlas⟩ := hAtlas
  obtain ⟨eIdx, hV_s, hu_s⟩ := hPb
  refine ⟨τ_s, hStab_s, ?_⟩
  have hAppLE_congr : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : X ⟶ Y} (h : f₁ = f₂)
      (U : Y.Opens) (V : X.Opens)
      (h₁ : V ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (h₂ : V ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      f₁.appLE U V h₁ = f₂.appLE U V h₂ := by
    rintro _ _ _ _ rfl _ _ _ _
    rfl
  have hId_appLE : ∀ {X : AlgebraicGeometry.Scheme.{u}} (U : X.Opens)
      (hU : U ≤ (TopologicalSpace.Opens.map
        (CategoryTheory.CategoryStruct.id X : AlgebraicGeometry.Scheme.Hom X X).base).obj U),
      AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X) U U hU = 𝟙 (X.presheaf.obj (Opposite.op U)) := by
    intro X U hU
    have hEq : AlgebraicGeometry.Scheme.Hom.app (𝟙 X) U =
        AlgebraicGeometry.Scheme.Hom.appLE (𝟙 X) U U hU :=
      AlgebraicGeometry.Scheme.Hom.app_eq_appLE (𝟙 X)
    rw [← hEq]
    exact AlgebraicGeometry.Scheme.Hom.id_app U
  have hPbBase : ∀ y : C_s, g.base (fst.base y) = s.base pt₀ := by
    intro y
    have hCond : g.base (fst.base y) = s.base (snd.base y) :=
      congrArg (fun (f : C_s ⟶ S) => f.base y) CategoryTheory.Limits.pullback.condition
    rw [hPt₀_eq (snd.base y)] at hCond
    exact hCond
  have hEmptySub : ∀ (W' : C_s.Opens), W' = ⊥ →
      Subsingleton ↑(C_s.presheaf.obj (Opposite.op W')) := by
    intro W' hBot
    have hT := C_s.sheaf.isTerminalOfEqEmpty hBot
    let φ : PUnit.{u + 1} →+* ↑(C_s.presheaf.obj (Opposite.op W')) :=
      (hT.from (CommRingCat.of PUnit.{u + 1})).hom
    apply subsingleton_of_zero_eq_one
    have h01 : (0 : PUnit.{u + 1}) = 1 := Subsingleton.elim _ _
    calc (0 : ↑(C_s.presheaf.obj (Opposite.op W')))
        = φ 0 := φ.map_zero.symm
      _ = φ 1 := congrArg φ h01
      _ = 1 := φ.map_one
  have hModSub : ∀ (R₀ : Type u) [CommRing R₀] [Subsingleton R₀]
      (M₀ : Type u) [AddCommGroup M₀] [Module R₀ M₀], Subsingleton M₀ := by
    intro R₀ _ _ M₀ _ _
    refine ⟨fun x y => ?_⟩
    have hx : x = 0 := by
      calc x = (1 : R₀) • x := (one_smul R₀ x).symm
        _ = (0 : R₀) • x := by rw [Subsingleton.elim (1 : R₀) 0]
        _ = 0 := zero_smul R₀ x
    have hy : y = 0 := by
      calc y = (1 : R₀) • y := (one_smul R₀ y).symm
        _ = (0 : R₀) • y := by rw [Subsingleton.elim (1 : R₀) 0]
        _ = 0 := zero_smul R₀ y
    exact hx.trans hy.symm
  have hLsum_apply : ∀ {R₀ : Type u} [CommRing R₀] {M₀ : Type u} [AddCommGroup M₀] [Module R₀ M₀]
      {m₀ : ℕ} (ω : Fin m₀ → M₀) (v : Fin m₀ → R₀),
      (LinearMap.lsum R₀ (fun _ : Fin m₀ => R₀) R₀ fun r =>
        LinearMap.toSpanSingleton R₀ M₀ (ω r)) v =
        ∑ r : Fin m₀, v r • ω r := by
    intro R₀ _ M₀ _ _ m₀ ω v
    simp [LinearMap.lsum_apply]
  have hLsum_single : ∀ {R₀ : Type u} [CommRing R₀] {M₀ : Type u} [AddCommGroup M₀] [Module R₀ M₀]
      {m₀ : ℕ} (ω : Fin m₀ → M₀) (r : Fin m₀) (c : R₀),
      (LinearMap.lsum R₀ (fun _ : Fin m₀ => R₀) R₀ fun i =>
        LinearMap.toSpanSingleton R₀ M₀ (ω i)) (Pi.single r c) = c • ω r := by
    intro R₀ _ M₀ _ _ m₀ ω r c
    rw [hLsum_apply, Finset.sum_eq_single r]
    · simp only [Pi.single_eq_same]
    · intro i _ hi
      simp only [Pi.single_eq_of_ne hi, zero_smul]
    · intro hr
      exact absurd (Finset.mem_univ r) hr
  have hExtendD : ∀ {B₁ B₂ : Type u} [CommRing B₁] [CommRing B₂]
      [Algebra Ω B₁] [Algebra Ω B₂]
      (φ : B₁ →+* B₂)
      (hφ : φ.comp (algebraMap Ω B₁) = algebraMap Ω B₂)
      {k : ℕ} (x₁ : Fin (k + 1) → B₁)
      (hSurj : Function.Surjective
        (LinearMap.lsum B₁ (fun _ : Fin (k + 1) => B₁) B₁ fun r =>
          LinearMap.toSpanSingleton B₁ (KaehlerDifferential Ω B₁)
            (KaehlerDifferential.D Ω B₁ (x₁ r))))
      (ψ₁ : KaehlerDifferential Ω B₁ →ₗ[B₁] B₁)
      (ψ₂ : KaehlerDifferential Ω B₂ →ₗ[B₂] B₂)
      (c : B₂)
      (hGen : ∀ r : Fin (k + 1),
        ψ₂ (KaehlerDifferential.D Ω B₂ (φ (x₁ r))) =
          c * φ (ψ₁ (KaehlerDifferential.D Ω B₁ (x₁ r))))
      (b : B₁),
      ψ₂ (KaehlerDifferential.D Ω B₂ (φ b)) =
        c * φ (ψ₁ (KaehlerDifferential.D Ω B₁ b)) := by
    intro B₁ B₂ _ _ _ _ φ hφ k x₁ hSurj ψ₁ ψ₂ c hGen b
    obtain ⟨v, hv⟩ := hSurj (KaehlerDifferential.D Ω B₁ b)
    let _ : Algebra B₁ B₂ := φ.toAlgebra
    have _ : IsScalarTower Ω B₁ B₂ := IsScalarTower.of_algebraMap_eq' hφ.symm
    have _ : SMulCommClass Ω B₁ B₂ := ⟨fun r a d => by simp [Algebra.smul_def, mul_left_comm]⟩
    have hq : (LinearMap.lsum B₁ (fun _ : Fin (k + 1) => B₁) B₁ fun r =>
        LinearMap.toSpanSingleton B₁ (KaehlerDifferential Ω B₁)
          (KaehlerDifferential.D Ω B₁ (x₁ r))) v =
        ∑ r : Fin (k + 1), v r • KaehlerDifferential.D Ω B₁ (x₁ r) :=
      hLsum_apply _ v
    have hD : KaehlerDifferential.D Ω B₂ (φ b) =
        ∑ r : Fin (k + 1), φ (v r) • KaehlerDifferential.D Ω B₂ (φ (x₁ r)) := by
      change KaehlerDifferential.D Ω B₂ (algebraMap B₁ B₂ b) = _
      rw [← KaehlerDifferential.map_D Ω Ω B₁ B₂ b, ← hv, hq, map_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [LinearMap.map_smulₛₗ, KaehlerDifferential.map_D]
      rfl
    rw [hD, ← hv, hq, map_sum, map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [LinearMap.map_smul, LinearMap.map_smul, smul_eq_mul, smul_eq_mul, map_mul, hGen r]
    ring
  
  have hSingleChart : ∀ a' : Fin M_s.m,
      let a := eIdx a'
      let V := M.V a
      let V' := M_s.V a'
      let k := k_lci a
      let π := π_lci a
      let F := F_lci a
      let t := t_mark a
      let B' : Type u := ↑(C_s.presheaf.obj (Opposite.op V'))
      let fst_V := (fst.appLE V V' (le_of_eq (hV_s a'))).hom
      letI : Algebra Ω B' :=
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          snd.appLE ⊤ V' (fun _ _ => trivial)).hom).toAlgebra
      let J' : Matrix (Fin (k + 1)) (Fin k) B' :=
        Matrix.of fun i j => fst_V (π (MvPolynomial.pderiv i (F j)))
      let q' : (Fin (k + 1) → B') →ₗ[B'] KaehlerDifferential Ω B' :=
        LinearMap.lsum B' (fun _ : Fin (k + 1) => B') B' fun r =>
          LinearMap.toSpanSingleton B' (KaehlerDifferential Ω B')
            (KaehlerDifferential.D Ω B' (fst_V (π (MvPolynomial.X r))))
      AlgebraicGeometry.IsAffineOpen V' ∧
      Function.Surjective q' ∧
      LinearMap.ker q' = LinearMap.range J'.mulVecLin ∧
      ∃ (ψ' ψ_log : KaehlerDifferential Ω B' →ₗ[B'] B'),
        ψ_log = fst_V t • ψ' ∧
        (∀ v : Fin (k + 1) → B',
          ψ' (q' v) = ∑ r : Fin (k + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J'.submatrix r.succAbove id)) ∧
        (∀ r : Fin (k + 1),
          ψ_log (KaehlerDifferential.D Ω B' (fst_V (π (MvPolynomial.X r)))) =
            fst_V (t * (-1) ^ (r : ℕ) *
              Matrix.det ((Matrix.of fun (i : Fin (k + 1)) (j : Fin k) =>
                π (MvPolynomial.pderiv i (F j))).submatrix r.succAbove id))) := by
    intro a'
    dsimp only
    let a := eIdx a'
    let U := U_base a
    let V := M.V a
    let V' := M_s.V a'
    let k := k_lci a
    let π := π_lci a
    let F := F_lci a
    let t := t_mark a
    let B' : Type u := ↑(C_s.presheaf.obj (Opposite.op V'))
    let fst_V : ↑(C.presheaf.obj (Opposite.op V)) →+* B' :=
      (fst.appLE V V' (le_of_eq (hV_s a'))).hom
    letI : Algebra Ω B' :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
        snd.appLE ⊤ V' (fun _ _ => trivial)).hom).toAlgebra
    let J' : Matrix (Fin (k + 1)) (Fin k) B' :=
      Matrix.of fun i j => fst_V (π (MvPolynomial.pderiv i (F j)))
    let q' : (Fin (k + 1) → B') →ₗ[B'] KaehlerDifferential Ω B' :=
      LinearMap.lsum B' (fun _ : Fin (k + 1) => B') B' fun r =>
        LinearMap.toSpanSingleton B' (KaehlerDifferential Ω B')
          (KaehlerDifferential.D Ω B' (fst_V (π (MvPolynomial.X r))))
    obtain ⟨hAffU, hAffV, hV_le_chart, hπ_C, hπ_surj, hπ_ker, _, _⟩ := hCharts a
    by_cases hs_in : s.base pt₀ ∈ U
    · 
      have hs_top : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Opens) ≤
          (TopologicalSpace.Opens.map s.base).obj U :=
        fun q _ => (hPt₀_eq q).symm ▸ hs_in
      let A : Type u := ↑(S.presheaf.obj (Opposite.op U))
      let B : Type u := ↑(C.presheaf.obj (Opposite.op V))
      let _ : Algebra A Ω :=
        ((s.appLE U ⊤ hs_top ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).hom).hom).toAlgebra
