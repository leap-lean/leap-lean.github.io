          (S.presheaf.map (CategoryTheory.homOfLE (le_rfl : U ≤ U)).op).hom a at ha
        have hid_op : (CategoryTheory.homOfLE (le_rfl : U ≤ U)).op = 𝟙 (Opposite.op U) :=
          Subsingleton.elim _ _
        rw [hid_op, CategoryTheory.Functor.map_id] at ha
        exact ha
      intro z hz
      rw [← hres_BD_eq t] at hz
      exact h_s2_part1 A A' B B' D res_BD hFlat_BD σ hσ_sec t hker_σ ht_B_nzd z hz
  
  let Δ_D : Fin (k + 1) → D := fun r =>
    (-1) ^ (r : ℕ) * Matrix.det (J_D.submatrix r.succAbove id)
  have hCofAnn : ∀ z : D, (∀ r : Fin (k + 1), Δ_D r * z = 0) → z = 0 := by
    let S_gen : Set D := Set.range Δ_D
    intro z hz
    have h_mem_S : ∀ b ∈ S_gen, b * z = 0 := by
      rintro b ⟨r, rfl⟩; exact hz r
    refine @hZeroAnn R' D _ _ _ _ hFlat_RD S_gen ?_ z h_mem_S
    intro p Ω
    let _ : Algebra R' Ω :=
      ((algebraMap p.asIdeal.ResidueField Ω).comp
        (algebraMap R' p.asIdeal.ResidueField)).toAlgebra
    intro z_Ω hz_Ω
    let D_Ω := TensorProduct R' D Ω
    let _ : Algebra Ω D_Ω := Algebra.TensorProduct.includeRight.toRingHom.toAlgebra
    have _ : IsScalarTower R' Ω D_Ω :=
      ⟨fun r' c x => by
        change Algebra.TensorProduct.includeRight (r' • c) * x =
          r' • (Algebra.TensorProduct.includeRight c * x)
        have hrc : r' • c = algebraMap R' Ω r' * c := by
          rw [← IsScalarTower.algebraMap_smul p.asIdeal.ResidueField r' c, Algebra.smul_def]
          rfl
        rw [hrc, map_mul, Algebra.TensorProduct.includeRight.commutes,
          Algebra.smul_def, mul_assoc]⟩
    have _ : Algebra.IsPushout R' D Ω D_Ω := inferInstance
    have _ : Algebra.IsPushout R' Ω D D_Ω := Algebra.IsPushout.symm inferInstance
    obtain ⟨hqΩ_surj, hqΩ_ker⟩ :=
      (hKaehler.2.1 R' Ω D D_Ω).1 k (fun r => (f_C.appLE V W hW_le).hom (π (MvPolynomial.X r)))
        J_D hqD_surj hqD_ker
    let s' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' Ω))
    let s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S := s' ≫ u_ρ
    let C_Ω := CategoryTheory.Limits.pullback g s
    let fst_Ω := CategoryTheory.Limits.pullback.fst g s
    let snd_Ω := CategoryTheory.Limits.pullback.snd g s
    have heX_comm : fst_Ω ≫ g = (snd_Ω ≫ s') ≫ u_ρ := by
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.Limits.pullback.condition
    let e_X : C_Ω ⟶ X' := hPb.lift fst_Ω (snd_Ω ≫ s') heX_comm
    have heX_fC : e_X ≫ f_C = fst_Ω := hPb.lift_fst _ _ _
    have heX_p' : e_X ≫ p' = snd_Ω ≫ s' := hPb.lift_snd _ _ _
    have hPb_tot : CategoryTheory.IsPullback (e_X ≫ f_C) snd_Ω g (s' ≫ u_ρ) := by
      rw [heX_fC]
      exact CategoryTheory.IsPullback.of_hasPullback g s
    have hPb_eX : CategoryTheory.IsPullback e_X snd_Ω p' s' :=
      CategoryTheory.IsPullback.of_right hPb_tot heX_p' hPb
    have hFromSpec_p' : hAffW.fromSpec ≫ p' =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' D)) := by
      have hpre := hSpecPre p' hAffW
      have h1 : AlgebraicGeometry.Spec.preimage (hAffW.fromSpec ≫ p') =
          CommRingCat.ofHom (algebraMap R' D) := by
        ext r; exact RingHom.congr_fun hpre r
      rw [← AlgebraicGeometry.Spec.map_preimage (hAffW.fromSpec ≫ p'), h1]
    let π_D : AlgebraicGeometry.Spec (CommRingCat.of D_Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of D) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
    let π_Ω : AlgebraicGeometry.Spec (CommRingCat.of D_Ω) ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)
    have hPb_DΩ : CategoryTheory.IsPullback π_D π_Ω
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' D))) s' := by
      have hp0 := CategoryTheory.IsPullback.of_hasPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' D))) s'
      exact CategoryTheory.IsPullback.of_iso hp0
        (AlgebraicGeometry.pullbackSpecIso R' D Ω)
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by simp [π_D, s', AlgebraicGeometry.pullbackSpecIso_hom_fst])
        (by simp [π_Ω, s', AlgebraicGeometry.pullbackSpecIso_hom_snd])
        (by simp) (by simp)
    have hPb_outer : CategoryTheory.IsPullback π_D π_Ω (hAffW.fromSpec ≫ p') s' := by
      rwa [hFromSpec_p']
    have hι_comm : (π_D ≫ hAffW.fromSpec) ≫ p' = π_Ω ≫ s' := by
      rw [CategoryTheory.Category.assoc]
      exact hPb_outer.w
    let ι_Ω : AlgebraicGeometry.Spec (CommRingCat.of D_Ω) ⟶ C_Ω :=
      hPb_eX.lift (π_D ≫ hAffW.fromSpec) π_Ω hι_comm
    have hι_eX : ι_Ω ≫ e_X = π_D ≫ hAffW.fromSpec := hPb_eX.lift_fst _ _ _
    have hι_snd : ι_Ω ≫ snd_Ω = π_Ω := hPb_eX.lift_snd _ _ _
    have hPb_outer' : CategoryTheory.IsPullback π_D (ι_Ω ≫ snd_Ω) (hAffW.fromSpec ≫ p') s' := by
      rwa [hι_snd]
    have hPb_top : CategoryTheory.IsPullback π_D ι_Ω hAffW.fromSpec e_X :=
      CategoryTheory.IsPullback.of_bot hPb_outer' hι_eX.symm hPb_eX
    have _ : AlgebraicGeometry.IsOpenImmersion ι_Ω :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top inferInstance
    let J_Ω : Matrix (Fin (k + 1)) (Fin k) D_Ω := J_D.map (algebraMap D D_Ω)
    have hz_Ω_ann : ∀ r : Fin (k + 1),
        (-1) ^ (r : ℕ) * Matrix.det (J_Ω.submatrix r.succAbove id) * z_Ω = 0 := by
      intro r
      have hdet_eq : (-1) ^ (r : ℕ) * Matrix.det (J_Ω.submatrix r.succAbove id) =
          TensorProduct.tmul R' (Δ_D r) (1 : Ω) := by
        have hsub : J_Ω.submatrix r.succAbove id =
            (Algebra.TensorProduct.includeLeftRingHom (R := R') (A := D) (B := Ω)).mapMatrix
              (J_D.submatrix r.succAbove id) := by ext i j; rfl
        rw [hsub, ← RingHom.map_det]
        have hmul : (-1 : D_Ω) ^ (r : ℕ) *
            Algebra.TensorProduct.includeLeftRingHom (Matrix.det (J_D.submatrix r.succAbove id)) =
            Algebra.TensorProduct.includeLeftRingHom (Δ_D r) := by
          dsimp only [Δ_D]
          rw [map_mul, map_pow, map_neg, map_one]
        rw [hmul]
        rfl
      rw [hdet_eq]
      exact hz_Ω (Δ_D r) ⟨r, rfl⟩
    exact h_s4 Ω C_Ω snd_Ω (hGeomDichot Ω s) D_Ω ι_Ω hι_snd
      (fun r => algebraMap D D_Ω ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r))))
      J_Ω hqΩ_surj hqΩ_ker z_Ω hz_Ω_ann
  
  have hInj_JD : Function.Injective J_D.mulVecLin := by
    intro w₁ w₂ hw_eq
    have hw_zero : J_D.mulVec (w₁ - w₂) = 0 := by
      change J_D.mulVecLin (w₁ - w₂) = 0
      rw [map_sub, hw_eq, sub_self]
    have h_coord : ∀ c : Fin k, (w₁ - w₂) c = 0 := by
      intro c
      apply hCofAnn
      intro r
      let M_r : Matrix (Fin k) (Fin k) D := J_D.submatrix r.succAbove id
      have hMr_zero : M_r.mulVec (w₁ - w₂) = 0 := by
        ext i
        simp only [Matrix.mulVec, dotProduct, Matrix.submatrix_apply, id_eq, Pi.zero_apply, M_r]
        exact congrFun hw_zero (r.succAbove i)
      have hadj := congrFun (congrArg M_r.adjugate.mulVec hMr_zero) c
      rw [Matrix.mulVec_zero, Pi.zero_apply, Matrix.mulVec_mulVec, Matrix.adjugate_mul] at hadj
      simp only [Matrix.mulVec, dotProduct, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul,
        mul_ite, mul_one, mul_zero, ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte] at hadj
      calc Δ_D r * (w₁ - w₂) c
          = (-1) ^ (r : ℕ) * (Matrix.det M_r * (w₁ - w₂) c) := by dsimp [Δ_D, M_r]; ring
        _ = (-1) ^ (r : ℕ) * 0 := by rw [← hadj]
        _ = 0 := mul_zero _
    ext c
    exact sub_eq_zero.mp (h_coord c)
  obtain ⟨_, ψ₁, _, _, hψ₁, _, _⟩ :=
    hCramer D (KaehlerDifferential R' D) k k J_D q_D J_D q_D hqD_surj hqD_ker hqD_surj hqD_ker hInj_JD
  let t_D : D := (f_C.appLE V W hW_le).hom t
  let ψ_log : KaehlerDifferential R' D →ₗ[D] D := t_D • ψ₁
  let δ_log : D → D := fun d => ψ_log (KaehlerDifferential.D R' D d)
  have hψ_X : ∀ r : Fin (k + 1),
      δ_log ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r))) = t_D * Δ_D r := by
    intro r
    classical
    let v_r : Fin (k + 1) → D := Pi.single r 1
    have hq_single : q_D v_r =
        KaehlerDifferential.D R' D ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r))) := by
      simp [q_D, v_r, Fintype.linearCombination_apply_single]
    change (t_D • ψ₁) (KaehlerDifferential.D R' D ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r)))) =
      t_D * Δ_D r
    rw [LinearMap.smul_apply, smul_eq_mul, ← hq_single, hψ₁]
    congr 1
    rw [Finset.sum_eq_single r]
    · simp [v_r, Δ_D]
    · intro s _ hs; simp [v_r, Pi.single_eq_of_ne hs]
    · intro hr; exact (hr (Finset.mem_univ r)).elim
  refine ⟨hqD_surj, hqD_ker, hInj_JD, ht_nzd, δ_log, ψ_log, fun _ => rfl, ?_, ?_, ?_⟩
  · intro r
    rw [hψ_X r]
    let f_VW := (f_C.appLE V W hW_le).hom
    have hsub_map : J_D.submatrix r.succAbove id =
        f_VW.mapMatrix ((Matrix.of fun (i : Fin (k + 1)) (j : Fin k) =>
          π (MvPolynomial.pderiv i (F j))).submatrix r.succAbove id) := by
      ext i j; rfl
    dsimp only [t_D, Δ_D]
    rw [hsub_map, ← RingHom.map_det]
    change f_VW t * ((-1) ^ (r : ℕ) * f_VW _) = f_VW (t * (-1) ^ (r : ℕ) * _)
    simp only [map_mul, map_pow, map_neg, map_one, mul_assoc]
  · intro ω
    obtain ⟨v, hv⟩ := hqD_surj ω
    have hlin : q_D v = ∑ r : Fin (k + 1),
        v r • KaehlerDifferential.D R' D ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r))) :=
      Fintype.linearCombination_apply D _ v
    exact ⟨v, hv.symm.trans hlin⟩
  · intro z hz
    have hzt : z * t_D = 0 := by
      apply hCofAnn
      intro r
      have h_xr := hz ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r)))
      rw [hψ_X r] at h_xr
      calc Δ_D r * (z * t_D)
          = (t_D * Δ_D r) * z := by ring
        _ = 0 := h_xr
    exact ht_nzd z hzt

theorem weil_pointed_iso_overlap_marking_and_log_unit (R : Type u) [CommRing R] [IsNoetherianRing R] (n : ℕ)
    (C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₁ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₁))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (τ₂ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C₂))
    (hStab₁ : IsGeometricStablePointedCurve g₁ n τ₁)
    (hStab₂ : IsGeometricStablePointedCurve g₂ n τ₂)
    (U₁ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) (V₁ : C₁.Opens) (k₁ : ℕ)
    (π₁ : MvPolynomial (Fin (k₁ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₁)) →+*
      ↑(C₁.presheaf.obj (Opposite.op V₁)))
    (F₁ : Fin k₁ → MvPolynomial (Fin (k₁ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₁)))
    (tag₁ : Option (Fin n)) (t₁ : ↑(C₁.presheaf.obj (Opposite.op V₁)))
    (hChart₁ : IsLocalLogCanonicalChart g₁ n τ₁ U₁ V₁ k₁ π₁ F₁ tag₁ t₁)
    (U₂ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) (V₂ : C₂.Opens) (k₂ : ℕ)
    (π₂ : MvPolynomial (Fin (k₂ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₂)) →+*
      ↑(C₂.presheaf.obj (Opposite.op V₂)))
    (F₂ : Fin k₂ → MvPolynomial (Fin (k₂ + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U₂)))
    (tag₂ : Option (Fin n)) (t₂ : ↑(C₂.presheaf.obj (Opposite.op V₂)))
    (hChart₂ : IsLocalLogCanonicalChart g₂ n τ₂ U₂ V₂ k₂ π₂ F₂ tag₂ t₂)
    (R' : Type u) [CommRing R'] [IsNoetherianRing R'] (ρ : R →+* R')
    (φ : CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) ≅
      CategoryTheory.Limits.pullback g₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)))
    (h_over : φ.hom ≫ CategoryTheory.Limits.pullback.snd g₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) =
      CategoryTheory.Limits.pullback.snd g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)))
    (h_sec : ∀ j : Fin n,
      ∀ s₁ : AlgebraicGeometry.Spec (CommRingCat.of R') ⟶
          CategoryTheory.Limits.pullback g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)),
        s₁ ≫ CategoryTheory.Limits.pullback.fst g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ) ≫ τ₁ j →
        s₁ ≫ CategoryTheory.Limits.pullback.snd g₁ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R')) →
        (s₁ ≫ φ.hom) ≫ CategoryTheory.Limits.pullback.fst g₂ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ) ≫ τ₂ j)
    (hPullback : ∀ (S S' C_0 : AlgebraicGeometry.Scheme.{u})
      (f_S : S' ⟶ S) (g_0 : C_0 ⟶ S) (τ_0 : Fin n → (S ⟶ C_0)),
      IsGeometricStablePointedCurve g_0 n τ_0 →
      ∃ τ' : Fin n → (S' ⟶ CategoryTheory.Limits.pullback g_0 f_S),
        (∀ j : Fin n,
          τ' j ≫ CategoryTheory.Limits.pullback.fst g_0 f_S = f_S ≫ τ_0 j ∧
          τ' j ≫ CategoryTheory.Limits.pullback.snd g_0 f_S = 𝟙 S' ∧
          Set.range (τ' j).base =
            (CategoryTheory.Limits.pullback.fst g_0 f_S).base ⁻¹' Set.range (τ_0 j).base) ∧
        IsGeometricStablePointedCurve (CategoryTheory.Limits.pullback.snd g_0 f_S) n τ')
    (hCramer : ∀ (B : Type u) [CommRing B] (Ω_mod : Type u) [AddCommGroup Ω_mod] [Module B Ω_mod]
      (k_a k_b : ℕ)
      (J_a : Matrix (Fin (k_a + 1)) (Fin k_a) B)
      (q_a : (Fin (k_a + 1) → B) →ₗ[B] Ω_mod)
      (J_b : Matrix (Fin (k_b + 1)) (Fin k_b) B)
      (q_b : (Fin (k_b + 1) → B) →ₗ[B] Ω_mod),
      Function.Surjective q_a →
      LinearMap.ker q_a = LinearMap.range J_a.mulVecLin →
      Function.Surjective q_b →
      LinearMap.ker q_b = LinearMap.range J_b.mulVecLin →
      Function.Injective J_b.mulVecLin →
      Function.Injective J_a.mulVecLin ∧
      ∃ (ψ_a ψ_b : Ω_mod →ₗ[B] B) (u : Bˣ),
        (∀ v : Fin (k_a + 1) → B,
          ψ_a (q_a v) = ∑ r : Fin (k_a + 1),
            v r * (-1) ^ (r : ℕ) * Matrix.det (J_a.submatrix r.succAbove id)) ∧
        (∀ w : Fin (k_b + 1) → B,
          ψ_b (q_b w) = ∑ s : Fin (k_b + 1),
            w s * (-1) ^ (s : ℕ) * Matrix.det (J_b.submatrix s.succAbove id)) ∧
        ψ_a = u.val • ψ_b)
    (hChartPb : ∀ (C : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C)),
      IsGeometricStablePointedCurve g n τ →
      ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) (V : C.Opens) (k : ℕ)
        (π : MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)) →+*
          ↑(C.presheaf.obj (Opposite.op V)))
        (F : Fin k → MvPolynomial (Fin (k + 1)) ↑((AlgebraicGeometry.Spec (CommRingCat.of R)).presheaf.obj (Opposite.op U)))
        (tag : Option (Fin n)) (t : ↑(C.presheaf.obj (Opposite.op V))),
        IsLocalLogCanonicalChart g n τ U V k π F tag t →
        ∀ (X' : AlgebraicGeometry.Scheme.{u})
          (p' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R'))
          (f_C : X' ⟶ C),
          CategoryTheory.IsPullback f_C p' g (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) →
          ∀ (W : X'.Opens), AlgebraicGeometry.IsAffineOpen W →
            ∀ (hW_le : W ≤ (TopologicalSpace.Opens.map f_C.base).obj V),
              let D := ↑(X'.presheaf.obj (Opposite.op W))
              letI : Algebra R' D :=
                ((p'.appLE ⊤ W (fun _ _ => trivial)).hom.comp
                  (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom).toAlgebra
              let J_D : Matrix (Fin (k + 1)) (Fin k) D :=
                Matrix.of fun (i : Fin (k + 1)) (j : Fin k) =>
                  (f_C.appLE V W hW_le).hom (π (MvPolynomial.pderiv i (F j)))
              let q_D : (Fin (k + 1) → D) →ₗ[D] KaehlerDifferential R' D :=
                Fintype.linearCombination D fun r : Fin (k + 1) =>
                  KaehlerDifferential.D R' D ((f_C.appLE V W hW_le).hom (π (MvPolynomial.X r)))
              Function.Surjective q_D ∧
              LinearMap.ker q_D = LinearMap.range J_D.mulVecLin ∧
              Function.Injective J_D.mulVecLin ∧
              (∀ z : D, z * (f_C.appLE V W hW_le).hom t = 0 → z = 0) ∧
              ∃ δ_log : D → D, IsPulledBackChartLogFunctional p' f_C U V k π F t W hW_le δ_log) :
    let u_ρ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
    let C₁' := CategoryTheory.Limits.pullback g₁ u_ρ
    let fst₁' := CategoryTheory.Limits.pullback.fst g₁ u_ρ
    let snd₁' := CategoryTheory.Limits.pullback.snd g₁ u_ρ
    let fst₂' := CategoryTheory.Limits.pullback.fst g₂ u_ρ
    let W : C₁'.Opens := (TopologicalSpace.Opens.map fst₁'.base).obj V₁ ⊓
      (TopologicalSpace.Opens.map (φ.hom ≫ fst₂').base).obj V₂
    AlgebraicGeometry.IsAffineOpen W ∧
    ∃ (u : (↑(C₁'.presheaf.obj (Opposite.op W)))ˣ)
      (δ₁ δ₂ : ↑(C₁'.presheaf.obj (Opposite.op W)) → ↑(C₁'.presheaf.obj (Opposite.op W))),
      IsPulledBackChartLogFunctional snd₁' fst₁' U₁ V₁ k₁ π₁ F₁ t₁ W inf_le_left δ₁ ∧
      IsPulledBackChartLogFunctional snd₁' (φ.hom ≫ fst₂') U₂ V₂ k₂ π₂ F₂ t₂ W inf_le_right δ₂ ∧
      ∀ d : ↑(C₁'.presheaf.obj (Opposite.op W)), δ₁ d = u.val * δ₂ d :=
by
  intro u_ρ C₁' fst₁' snd₁' fst₂' W
  let S := AlgebraicGeometry.Spec (CommRingCat.of R)
  let S' := AlgebraicGeometry.Spec (CommRingCat.of R')
  let snd₂' := CategoryTheory.Limits.pullback.snd g₂ u_ρ
  let f₂ := φ.hom ≫ fst₂'
  let D := ↑(C₁'.presheaf.obj (Opposite.op W))
  have happLE_congr : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} {m₁ m₂ : Y₁ ⟶ Y₂} (hm : m₁ = m₂)
      (O₂ : Y₂.Opens) (O₁ : Y₁.Opens)
      (e₁ : O₁ ≤ (TopologicalSpace.Opens.map m₁.base).obj O₂)
      (e₂ : O₁ ≤ (TopologicalSpace.Opens.map m₂.base).obj O₂),
      m₁.appLE O₂ O₁ e₁ = m₂.appLE O₂ O₁ e₂ := by
    intro Y₁ Y₂ m₁ m₂ hm
    subst hm
    intro O₂ O₁ e₁ e₂
    rfl
  
  have _ : AlgebraicGeometry.IsProper g₁ := hStab₁.2.2.1
